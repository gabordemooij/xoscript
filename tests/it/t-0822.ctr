# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := MariaDB nuovo host: ['localhost'],
	utente: ['xo'],
	password: ['pass123'],
	nome-database: ['xobase'],
	connetti.

>> parametri := db query: ['SELECT ? AS a, ? AS b, ? AS c'].
parametri parametri: (Serie nuovo ; ['1']).
{ parametri recupera: { :row Uscita scrivi: row, stop. }. } catturare: { :e Uscita scrivi: e, stop. }, correre.

>> parametri := db query: ['SELECT ? AS a'].
{ parametri recupera: { :row Uscita scrivi: row, stop. }. } catturare: { :e Uscita scrivi: e, stop. }, correre.

# the right number still works, more parameters are ignored as before
>> parametri := db query: ['SELECT ? AS a, ? AS b'].
parametri parametri: (Serie nuovo ; ['1'] ; ['2']).
parametri recupera: { :row Uscita scrivi: (row a: ['a']), scrivi: (row a: ['b']), stop. }.
parametri parametri: (Serie nuovo ; ['1'] ; ['2'] ; ['3']).
parametri recupera: { :row Uscita scrivi: (row a: ['a']), scrivi: (row a: ['b']), stop. }.
