# meno parametri dei segnaposto devono dare un errore, non leggere oltre i binding
Server init.

>> db := MariaDB nuovo host: ['localhost'],
	utente: ['xo'],
	password: ['pass123'],
	nome-database: ['xobase'],
	connetti.

>> parametri := db query: ['SELECT ? AS a, ? AS b, ? AS c'].
parametri parametri: (Serie nuovo ; ['1']).
{ parametri recupera: { :fila Uscita scrivi: fila, stop. }. } catturare: { :e Uscita scrivi: e, stop. }, correre.

>> parametri := db query: ['SELECT ? AS a'].
{ parametri recupera: { :fila Uscita scrivi: fila, stop. }. } catturare: { :e Uscita scrivi: e, stop. }, correre.

# il numero giusto funziona ancora, i parametri in più vengono ignorati come prima
>> parametri := db query: ['SELECT ? AS a, ? AS b'].
parametri parametri: (Serie nuovo ; ['1'] ; ['2']).
parametri recupera: { :fila Uscita scrivi: (fila a: ['a']), scrivi: (fila a: ['b']), stop. }.
parametri parametri: (Serie nuovo ; ['1'] ; ['2'] ; ['3']).
parametri recupera: { :fila Uscita scrivi: (fila a: ['a']), scrivi: (fila a: ['b']), stop. }.
