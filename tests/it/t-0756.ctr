Uscita scrivi: ['Oggetto di test'], stop.
>> salutatore := Oggetto nuovo.
salutatore on: ['name:'] fare: { :nome
	mio xnome := nome. 
}.
salutatore on: ['saluta'] fare: {
	Uscita scrivi: ['Ciao '] + mio xnome, stop.
}.
salutatore name: ['Sherlock'].
salutatore save-as: ['/tmp/a.bin'].
salutatore save-as: ['/tmp/b.bin'].
Uscita scrivi: ['========== RICARICAMENTO SNAP:'], stop.
>> b := Oggetto load-from: ['/tmp/a.bin'].
>> c := Oggetto load-from: ['/tmp/b.bin'].
b saluta.
b name: ['Watson'], saluta.
c name: ['Moriarty'], saluta.
