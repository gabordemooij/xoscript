Uscita scrivi: ['Test object'], stop.
>> greeter := Oggetto nuovo.
greeter on: ['name:'] fare: { :nome
	mio xname := nome. 
}.
greeter on: ['greet'] fare: {
	Uscita scrivi: ['Hello '] + mio xname, stop.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Uscita scrivi: ['========== RELOADING SNAP:'], stop.
>> b := Oggetto load-from: ['/tmp/a.bin'].
>> c := Oggetto load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
