# database error messages must not be treated as format strings
Server init.

>> db := MariaDB nuovo host: ['localhost'],
	utente: ['xo'],
	password: ['pass123'],
	nome-database: ['xobase'],
	connetti.

>> parametri := db query: ['SELECT %% FROM'].
{ parametri esegui. } catturare: { :e
	Uscita scrivi: ( e contiene: ['%%'] ), stop.
}, correre.
