
Testo on: ['valutare'] fare: {
	>> code := File nuovo: ['/tmp/eval.ctr'].
	code scrivi: (io testo + ['.']).
	Programma uso: ['/tmp/eval.ctr'].
}.

>> map :=
	(Elenco nuovo)
	met: ['Ehi, ciao'] a: ['two'],
	met: (Serie ← ['hello'] ; ['world'] ; (Serie ← 1 ; 2; 9) ; Falso) a: ['uno'],
	met: ( (Elenco nuovo) met: ['mnodo'] a: ['sbagliato'] ) a: ['three'],
	met: (Serie ← ((Elenco nuovo) met: ['tesoro'] a: ['nascosto']) ; 2) a: ['quattro']. 
>> str := map testo.
>> map2 := Nil.
(['map2 := '] + str ) valutare.
Uscita scrivi: map2 ? ['uno'] ? 0.
Uscita scrivi: map2 ? ['uno'] ? 1.
Uscita scrivi: map2 ? ['quattro'] ? 0 ? ['nascosto'].
Uscita scrivi: map2 ? ['uno'] ? 2 ? 2.
