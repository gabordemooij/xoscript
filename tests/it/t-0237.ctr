
Testo on: ['evaluate'] fare: {
	>> code := File nuovo: ['/tmp/eval.ctr'].
	code scrivi: (io testo + ['.']).
	Programma uso: ['/tmp/eval.ctr'].
}.

>> map :=
	(Elenco nuovo)
	met: ['Hi There'] a: ['two'],
	met: (Serie ← ['hello'] ; ['world'] ; (Serie ← 1 ; 2; 9) ; Falso) a: ['one'],
	met: ( (Elenco nuovo) met: ['wrrld'] a: ['misspelled'] ) a: ['three'],
	met: (Serie ← ((Elenco nuovo) met: ['treasure'] a: ['hidden']) ; 2) a: ['four']. 
>> str := map testo.
>> map2 := Nil.
(['map2 := '] + str ) evaluate.
Uscita scrivi: map2 ? ['one'] ? 0.
Uscita scrivi: map2 ? ['one'] ? 1.
Uscita scrivi: map2 ? ['four'] ? 0 ? ['hidden'].
Uscita scrivi: map2 ? ['one'] ? 2 ? 2.
