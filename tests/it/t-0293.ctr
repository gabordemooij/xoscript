
>> city := Serie ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Serie ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature di: city.
>> cities := weather inserimenti ord: { :a :b <- (a confrontare: b). }.
>> temperatures := weather valori ord: { :a :b <- (a confrontare: b) negativo?. }.

Uscita scrivi: (cities aderire: [',']), stop.
Uscita scrivi: (temperatures aderire: [',']), stop.
