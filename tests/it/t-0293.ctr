
>> città := Serie ← ['Londra'] ; ['Parigi'] ; ['Berlino'].
>> temperatura := Serie ← ['15'] ; ['16'] ; ['15'].
>> meteo := temperatura di: città.
>> cittàOrdinate := meteo inserimenti ord: { :a :b <- (a confrontare: b). }.
>> temperatureOrdinate := meteo valori ord: { :a :b <- (a confrontare: b) negativo?. }.

Uscita scrivi: (cittàOrdinate aderire: [',']), stop.
Uscita scrivi: (temperatureOrdinate aderire: [',']), stop.
