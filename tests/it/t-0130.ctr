# uso di FFI con il plugin Server

# collegamento a libc (dipende dalla piattaforma)
>> nomelib := Programma instelling: ['FFITESTLIB'].

# collega le funzioni stdio dal C per operazioni avanzate sui file
Server collega: ( Serie nuovo ;
 nomelib ; ['fopen'] ;
 ( Serie nuovo ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
collega: ( Serie nuovo ;
 Nil ; # significa stessa libreria
 ['fread'] ;
 ( Serie nuovo ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nil ; # significa stesso oggetto (cioè Flusso)
 ['fread']
),
collega: (
 Serie nuovo ;
 Nil ; # significa stessa libreria
 ['fwrite'] ;
 ( Serie nuovo ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nil ; # significa stessa libreria
 ['fwrite']
),
collega: (
 Serie nuovo ;
 Nil ; # significa stessa libreria
 ['rewind'] ;
 ( Serie nuovo ; ['pointer'] ) ;
 ['int'] ;
 Nil ; # significa stessa libreria
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> sentiero := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# apri un file con fopen(path, mode)
>> fd := Stream path: sentiero mode: mode.

# scrivi i byte dal buffer stringa nel file
>> byte-scritti := Stream messaggio: ['fwrite'] argomenti: (Serie nuovo ; str ; 1 ; 6 ; fd ).
Uscita scrivi: byte-scritti, stop.

# riavvolgi il puntatore del file
Stream rewind: fd.

# alloca un buffer
>> buf := Blob nuovo: 20.

# leggi dal file
>> byte-letti := Stream messaggio: ['fread'] argomenti: (Serie nuovo ; buf ; 1 ; 6 ; fd ).
Uscita scrivi: byte-letti, stop.
Uscita scrivi: buf, stop.

# libera la memoria
str  libero.
sentiero libero.
mode libero.
buf  libero.


