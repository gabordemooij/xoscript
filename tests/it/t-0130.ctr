# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Programma instelling: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server collega: ( Serie nuovo ;
 libname ; ['fopen'] ;
 ( Serie nuovo ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
collega: ( Serie nuovo ;
 Nil ; # means same lib
 ['fread'] ;
 ( Serie nuovo ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nil ; # means same object (i.e. Stream)
 ['fread']
),
collega: (
 Serie nuovo ;
 Nil ; # means same lib
 ['fwrite'] ;
 ( Serie nuovo ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nil ; # means same lib
 ['fwrite']
),
collega: (
 Serie nuovo ;
 Nil ; # means same lib
 ['rewind'] ;
 ( Serie nuovo ; ['pointer'] ) ;
 ['int'] ;
 Nil ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> sentiero := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: sentiero mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream messaggio: ['fwrite'] argomenti: (Serie nuovo ; str ; 1 ; 6 ; fd ).
Uscita scrivi: bytes-written, stop.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob nuovo: 20.

# read from file
>> bytes-read := Stream messaggio: ['fread'] argomenti: (Serie nuovo ; buf ; 1 ; 6 ; fd ).
Uscita scrivi: bytes-read, stop.
Uscita scrivi: buf, stop.

# free memory
str  libero.
sentiero libero.
mode libero.
buf  libero.


