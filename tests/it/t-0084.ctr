>> makeAdder := { :x
	>> f := { :y <- (mio x + y). } valore: ['x'] impostato: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i mio q met: (mio f applica: (mio q ? i)) a: i. } 
	valore: ['q'] impostato: array,
	valore: ['f'] impostato: func.
	{ :i mapping applica: i. } × (array contare).
}.

>> a := Serie ← 1; 2; 3.
mapper applica: a e: (makeAdder applica: 100).
Uscita scrivi: (a posizione: 0), stop.
Uscita scrivi: (a ? 1), stop.
Uscita scrivi: (a ? 2), stop.
