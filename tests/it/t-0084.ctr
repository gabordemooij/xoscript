>> creaSommatore := { :x
	>> f := { :y <- (mio x + y). } valore: ['x'] impostato: x. <- f.
}.
>> mappatore := { :vettore :funz
	>> mappatura := { :i mio q met: (mio f applica: (mio q ? i)) a: i. } 
	valore: ['q'] impostato: vettore,
	valore: ['f'] impostato: funz.
	{ :i mappatura applica: i. } × (vettore contare).
}.

>> a := Serie ← 1; 2; 3.
mappatore applica: a e: (creaSommatore applica: 100).
Uscita scrivi: (a posizione: 0), stop.
Uscita scrivi: (a ? 1), stop.
Uscita scrivi: (a ? 2), stop.
