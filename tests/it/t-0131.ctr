
>> a := Serie ← (Serie ← 100 ; 200 ; 300) ; (Serie ← 9 ; 8 ; 7).
Uscita scrivi: ['in 0,1 :'].
Uscita scrivi: a ? 0 ? 1, stop. 
Uscita scrivi: ['in 1,2 :'].
Uscita scrivi: a ? 1 ? 2, stop. 
>> menù := Elenco nuovo.
menù met: (Serie ← ['pizza'] ; ['spaghetti']) a: ['Cucina italiana'].
menù met: (Serie ← ['bifteki'] ; ['souvlaki']) a: ['Cucina greca'].
Uscita scrivi: ['Adoro '] + (menù ? ['Cucina greca'] ? 0) + [' e '] + (menù ? ['Cucina italiana'] ? 1), stop. 
Uscita scrivi: ['ma non nello stesso piatto.'], stop.
