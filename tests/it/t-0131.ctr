
>> a := Serie ← (Serie ← 100 ; 200 ; 300) ; (Serie ← 9 ; 8 ; 7).
Uscita scrivi: ['at 0,1 :'].
Uscita scrivi: a ? 0 ? 1, stop. 
Uscita scrivi: ['at 1,2 :'].
Uscita scrivi: a ? 1 ? 2, stop. 
>> menu := Elenco nuovo.
menu met: (Serie ← ['pizza'] ; ['spaghetti']) a: ['Italian Cuisine'].
menu met: (Serie ← ['bifteki'] ; ['suflaki']) a: ['Greek Cuisine'].
Uscita scrivi: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), stop. 
Uscita scrivi: ['but not on the same plate.'], stop.
