


>> Mazzo := Serie nuovo.
Mazzo on: ['stampa'] fare: {
        >> len := io contare - 1.
        { :i
                >> lung2 := io contare - 1.
                Uscita scrivi: ['lung: '].
                Uscita scrivi: len, stop.
                Uscita scrivi: ['lung2: '].
                Uscita scrivi: lung2, stop.
        } × len.
}.

>> d := Mazzo ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d stampa.
