


>> Deck := Serie nuovo.
Deck on: ['print'] fare: {
        >> len := io contare - 1.
        { :i
                >> len2 := io contare - 1.
                Uscita scrivi: ['len: '].
                Uscita scrivi: len, stop.
                Uscita scrivi: ['len2: '].
                Uscita scrivi: len2, stop.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
