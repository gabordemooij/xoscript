Uscita scrivi: ['Oggetto di test'], stop.
>> a := Oggetto nuovo. 

a on: ['item:'] fare: { :aiutanteoct
	mio aiutanteoct := aiutanteoct. 
}.

a on: ['articolo'] fare: {
	<- mio aiutanteoct.
}.

a item: Oct nuovo.

>> vecchio-indirizzo-aiutanteoct := a articolo prototipo indirizzo-di-memoria.
a save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RICARICAMENTO SNAP:'], stop.

>> b := Oggetto load-from: ['/tmp/a.bin'].

(b articolo prototipo indirizzo-di-memoria = vecchio-indirizzo-aiutanteoct) vero: {
	Uscita scrivi: ['Collegamento all'oggetto ricollegato.'], stop.
}.
