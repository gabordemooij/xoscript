Uscita scrivi: ['Test object'], stop.
>> a := Oggetto nuovo. 

a on: ['item:'] fare: { :octhelper
	mio octhelper := octhelper. 
}.

a on: ['item'] fare: { <- mio octhelper.
}.

a item: Oct nuovo.

>> old-octhelper-address := a item prototipo indirizzo-di-memoria.
a save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RELOADING SNAP:'], stop.

>> b := Oggetto load-from: ['/tmp/a.bin'].

(b item prototipo indirizzo-di-memoria = old-octhelper-address) vero: {
	Uscita scrivi: ['Object link re-attached.'], stop.
}.
