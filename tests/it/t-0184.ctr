

>> memoriaUsata1 := 0.
>> memoriaUsata2 := 0.
>> memoriaUsata3 := 0.
>> memoriaUsata4 := 0.

Programma gcmode: 0.

Numero on: ['addNum:'] fare: { :x
	io inserisci: x.
}.

Numero on: ['subtractNum:'] fare: { :x
	io sottrarre: x.
}.

Numero on: ['multiplyBy:'] fare: { :x
	io moltiplicato-per: x.
}.

Numero on: ['divideBy:'] fare: { :x
	io dividi-per: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 al-potere: 8).  
a := a + (2 al-potere: -1). 
a := a + (49 sqrt).   
a addNum: ((Serie ← 0 ; 1) massimo).          
a addNum: ((Serie ← 2 ; 3) minimo).
Uscita scrivi: a.

Programma spazzare.

memoriaUsata1 := (Programma memoria ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 al-potere: 8).  
a := a + (2 al-potere: -1). 
a := a + (49 sqrt).   
a addNum: ((Serie ← 0 ; 1) massimo).          
a addNum: ((Serie ← 2 ; 3) minimo).
Uscita scrivi: a.

Programma spazzare.
memoriaUsata2 := (Programma memoria ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 al-potere: 8).  
a := a + (2 al-potere: -1). 
a := a + (49 sqrt).   
a addNum: ((Serie ← 0 ; 1) massimo).          
a addNum: ((Serie ← 2 ; 3) minimo).
Uscita scrivi: a.

Programma spazzare.
memoriaUsata3 := (Programma memoria ? 0).



( memoriaUsata1 = memoriaUsata2 e: memoriaUsata1 = memoriaUsata3, e: memoriaUsata2 = memoriaUsata3 ) vero: {
	Uscita scrivi: ['Nessuna perdita di memoria qui'].
}, falso: {
	Uscita scrivi: ['Perdita di memoria...'].
}.
