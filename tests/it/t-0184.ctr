

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programma gcmode: 0.

Numero on: ['addNum:'] fare: { :x
	io inserisci: x.
}.

Numero on: ['subtractNum:'] fare: { :x
	io sottrarre: x.
}.

Numero on: ['multiplyBy:'] fare: { :x
	io moltiplicato-per: x.
}.

Numero on: ['divideBy:'] fare: { :x
	io dividi-per: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 al-potere: 8).  
a := a + (2 al-potere: -1). 
a := a + (49 sqrt).   
a addNum: ((Serie ← 0 ; 1) massimo).          
a addNum: ((Serie ← 2 ; 3) minimo).
Uscita scrivi: a.

Programma spazzare.

usedMemory1 := (Programma memoria ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 al-potere: 8).  
a := a + (2 al-potere: -1). 
a := a + (49 sqrt).   
a addNum: ((Serie ← 0 ; 1) massimo).          
a addNum: ((Serie ← 2 ; 3) minimo).
Uscita scrivi: a.

Programma spazzare.
usedMemory2 := (Programma memoria ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 al-potere: 8).  
a := a + (2 al-potere: -1). 
a := a + (49 sqrt).   
a addNum: ((Serie ← 0 ; 1) massimo).          
a addNum: ((Serie ← 2 ; 3) minimo).
Uscita scrivi: a.

Programma spazzare.
usedMemory3 := (Programma memoria ? 0).



( usedMemory1 = usedMemory2 e: usedMemory1 = usedMemory3, e: usedMemory2 = usedMemory3 ) vero: {
	Uscita scrivi: ['No memory leaks here'].
}, falso: {
	Uscita scrivi: ['Leaking memory...'].
}.
