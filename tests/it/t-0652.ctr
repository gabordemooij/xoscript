# test number -> string -> number
{

	>> x := Numero tra: 0 e: 1000000.
	>> d := Numero tra: 1 e: 7.
	>> e := 10 al-potere: d.

	x dividi-per: e.
	>> y := x testo numero.

	(x = y) falso: {
		Uscita scrivi: x, stop.
		Uscita scrivi: y, stop.
		Programma fine.
	}.

} * 1000.
Uscita scrivi: ['OK'], stop.