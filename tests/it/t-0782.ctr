Uscita scrivi: ['Test object'], stop.
>> cmd := Istruzioni nuovo.
Uscita scrivi: cmd ls /tmp, stop.
>> old-cmd-address := cmd prototipo indirizzo-di-memoria.
cmd save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RELOADING SNAP:'], stop.
>> b := Oggetto load-from: ['/tmp/a.bin'].
(b prototipo indirizzo-di-memoria = old-cmd-address) vero: {
	Uscita scrivi: ['Object link re-attached.'], stop.
}.
Uscita scrivi: b ls, stop.


