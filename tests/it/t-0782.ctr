Uscita scrivi: ['Oggetto di test'], stop.
>> cmd := Istruzioni nuovo.
Uscita scrivi: cmd ls /tmp, stop.
>> vecchio-indirizzo-cmd := cmd prototipo indirizzo-di-memoria.
cmd save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RICARICAMENTO SNAP:'], stop.
>> b := Oggetto load-from: ['/tmp/a.bin'].
(b prototipo indirizzo-di-memoria = vecchio-indirizzo-cmd) vero: {
	Uscita scrivi: ['Collegamento all'oggetto ricollegato.'], stop.
}.
Uscita scrivi: b ls, stop.


