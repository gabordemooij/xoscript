>> numbers := ['1,2,3'] diviso: [','].
Uscita scrivi: ['I got: '] + numbers contare + [' numbers.'],stop.
{ :i Uscita scrivi: ['number #'] + i + [':'] + (numbers posizione: i), stop.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages diviso: [' Or '].
Uscita scrivi: ['We serve'], stop.
{ :i Uscita scrivi: ['->'] + (beverages posizione: i), stop. } × (beverages contare).
Uscita scrivi: (beverages aderire: [',']), stop.
Uscita scrivi: (numbers aderire: ['||']).
