Uscita scrivi: ['Oggetto di test'], stop.
>> a := Oggetto nuovo. 

a on: ['item:'] fare: { :booleano
	mio booleano := booleano. 
}.

a on: ['articolo'] fare: {
	<- mio booleano.
}.

a item: Falso.

Uscita scrivi: a articolo, stop.

>> vecchio-indirizzo-bool := a articolo prototipo indirizzo-di-memoria.
a save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RICARICAMENTO SNAP:'], stop.

>> b := Oggetto load-from: ['/tmp/a.bin'].

(b articolo prototipo indirizzo-di-memoria = vecchio-indirizzo-bool) vero: {
	Uscita scrivi: ['Collegamento all'oggetto ricollegato.'], stop.
}.

Uscita scrivi: b articolo, stop.
