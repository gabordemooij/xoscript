>> z := Oggetto nuovo.
z on: ['value:'] fare: { :v
	mio value := v. <- io.
}.
z on: ['value'] fare: { <- mio value. }.
(z setValue: 1) value: 2.
Uscita scrivi: z value.
>> x := z.
Uscita scrivi: x value.
z := Nil.
Uscita scrivi: z value.
Uscita scrivi: x value.
Uscita scrivi: ['hello'].
Uscita scrivi: 3 + 2.
Uscita scrivi: (3 > 2).
