Uscita scrivi: ['Oggetto di test'], stop.
>> p := Sentiero /tmp.
Uscita scrivi: p, stop.
>> vecchio-indirizzo-p := p prototipo indirizzo-di-memoria.
p save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RICARICAMENTO SNAP:'], stop.
>> b := Oggetto load-from: ['/tmp/a.bin'].
(b prototipo indirizzo-di-memoria = vecchio-indirizzo-p) vero: {
	Uscita scrivi: ['Collegamento all'oggetto ricollegato.'], stop.
}.
Uscita scrivi: b, stop.
