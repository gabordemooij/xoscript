# test del database
# vedi l'esempio server.xo per la configurazione necessaria

Server init.
Uscita scrivi: ['Test del database'], stop.

>> db := MariaDB nuovo host: ['localhost'],
	utente: ['xo'], password: ['pass123'], nome-database: ['xobase'], connetti.

Uscita scrivi: ['Possiamo connetterci? '] + db connesso?, stop.

>> parametri := db query: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parametri: ( Serie nuovo ; ['abc'] ; 12.35 ; 6 ). # query parametrizzate

{  parametri esegui. db commit. } catturare: { :e db rollback.  }, correre.

Uscita scrivi: ['Possiamo inserire? '] + ( parametri insert-id > 0 ), stop.

>> x := 0.
>> parametri :=
db query: ['SELECT * FROM book order by id desc limit 2'], 
recupera: { :fila 
	x inserisci: 1.
	Vero interrompere. # deve pulire, niente 'Commands out of sync'
}.

>> parametri :=
db query: ['SELECT * FROM book order by id desc limit 2'], 
recupera: { :fila
	x inserisci: 1.
	Vero interrompere.
}.

(x > 0) vero: {
	Uscita scrivi: ['Possiamo interrompere a metà di un fetch? '].
}.

Uscita scrivi: Vero, stop.