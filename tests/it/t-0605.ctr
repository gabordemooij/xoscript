>> invoice := Oggetto nuovo.
invoice on: ['correre'] fare: {
        mio numero := 0.
}.

invoice on: ['numero'] fare: {
        mio numero inserisci: 1. <- mio numero copia.
}.

>> year-invoice := invoice nuovo.
year-invoice on: ['start:'] fare: { :anno
	mio numero := anno.
}.

year-invoice start: 202000.
Uscita scrivi: year-invoice numero, stop.
Uscita scrivi: year-invoice numero, stop.
