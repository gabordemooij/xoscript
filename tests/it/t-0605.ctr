>> fattura := Oggetto nuovo.
fattura on: ['correre'] fare: {
        mio numero := 0.
}.

fattura on: ['numero'] fare: {
        mio numero inserisci: 1.
        <- mio numero copia.
}.

>> fattura-annuale := fattura nuovo.
fattura-annuale on: ['start:'] fare: { :anno
	mio numero := anno.
}.

fattura-annuale start: 202000.
Uscita scrivi: fattura-annuale numero, stop.
Uscita scrivi: fattura-annuale numero, stop.
