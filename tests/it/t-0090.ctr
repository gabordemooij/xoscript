Uscita scrivi: ['1,2,3,4,5,6,7,8,9,A,'], stop.
>> Scope := Oggetto nuovo.
Scope on: ['initialize:'] fare: { :x mio property := x. }.
Scope on: ['confirm'] fare: { Uscita scrivi: [',']. }.
Scope on: ['test'] fare: {
	Uscita scrivi: mio property.
	io confirm.
	( 1 = 1 ) vero: { Uscita scrivi: mio property. io confirm. }.
	( 1 = 0 ) falso: { Uscita scrivi: mio property. io confirm. }.
	>> y := 2. { Uscita scrivi: mio property. io confirm. } mentre: { y sottrarre: 1. <- (y > 0). }.
	{ Uscita scrivi: mio property. io confirm. } × 1.
	(Serie ← 1) ogni: {  Uscita scrivi: mio property. io confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Elenco nuovo one: ['item']) ogni: { Uscita scrivi: mio property. io confirm. }.
	{ 1 ÷ 0. } catturare: { Uscita scrivi: mio property. io confirm. }, correre.
	Uscita stop.
}.
>> scope1 := Scope nuovo.
scope1 initialize: ['X'].
scope1 test.
>> function := { 
	mio property := ['Y'].
	Uscita scrivi: mio property.
	io confirm.
	( 1 = 1 ) vero: { Uscita scrivi: mio property. io confirm. }.
	( 1 = 0 ) falso: { Uscita scrivi: mio property. io confirm. }.
	>> y := 2. { Uscita scrivi: mio property. io confirm. } mentre: { y sottrarre: 1. <- (y > 0). }.
	{ Uscita scrivi: mio property. io confirm. } × 1.
	(Serie ← 1) ogni: {  Uscita scrivi: mio property. io confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Elenco nuovo one: ['item']) ogni: { Uscita scrivi: mio property. io confirm. }.
	{ 1 ÷ 0. } catturare: { Uscita scrivi: mio property. io confirm. }, correre.
	Uscita stop.
}.
function on: ['confirm'] fare: { Uscita scrivi: [',']. }.
function applica: 1 e: 2.
