>> V := Oggetto.
V on: ['testo'] fare: {
	Uscita scrivi: ['conversione'], stop.
	<- ['abc'].
}.

Uscita scrivi: ( Programma instelling: ['abc'] ), stop.

# i parametri non devono essere raccolti dal GC
Programma instelling: ([''] + V nuovo) is: ([''] + V nuovo).

Uscita scrivi: ( Programma instelling: ['abc'] ), stop.
