Server init.
>> fmt := Formato nuovo: ['%#3x'].

>> blob := Blob nuovo: 4.
blob bytes: ( 
	Serie nuovo ; 0 ; 1 ; 2 ; 3
).

>> file := File nuovo: ['/tmp/blob'].
file blob: blob.
blob libero.

>> leggere := file blob.
leggere 
da: 0 
lunghezza: 4, 
fare ogni: { :i :b 
	Uscita
	scrivi: (fmt applica-int: b),
	stop.
}.
leggere libero.
