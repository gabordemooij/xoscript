
Server init.
>> ric := Richiesta-HTTP nuovo.
Uscita scrivi: ['HTTP-GET d[]=']  + ( ric get-lista: ['d[]'] ), stop. # GET
Uscita scrivi: ['HTTP-GET f[]=']  + ( ric get-lista: ['f[]'] ), stop. # GET
Uscita scrivi: ['HTTP-POST e[]='] + ( ric post-lista: ['e[]'] ), stop. # GET
Uscita scrivi: ['HTTP-POST c=']   + ( ric post: ['c'] ), stop. # GET
Uscita scrivi: ['HTTP-POST xx=']  + ( ric post: ['xx'] ), stop. # GET
