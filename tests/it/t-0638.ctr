
Server init.
>> rq := Richiesta-HTTP nuovo.
Uscita scrivi: ['HTTP-GET d[]=']  + ( rq get-lista: ['d[]'] ), stop. # GET
Uscita scrivi: ['HTTP-GET f[]=']  + ( rq get-lista: ['f[]'] ), stop. # GET
Uscita scrivi: ['HTTP-POST e[]='] + ( rq post-lista: ['e[]'] ), stop. # GET
Uscita scrivi: ['HTTP-POST c=']   + ( rq post: ['c'] ), stop. # GET
Uscita scrivi: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), stop. # GET
