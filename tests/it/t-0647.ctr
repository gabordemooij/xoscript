Server init.
Uscita scrivi: ['Test dell'ora nel database'], stop.

>> db := MariaDB nuovo host: ['localhost'],
	utente: ['xo'], 
	password: ['pass123'],
	nome-database: ['xobase'],
	connetti.

>> parametri :=
db query: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
recupera: { :fila
