Uscita scrivi: ['Test object'], stop.
>> a := Oggetto nuovo. 

a on: ['item:'] fare: { :dict
	mio dict := dict. 
}.

a on: ['item'] fare: { <- mio dict.
}.

a item: (
Elenco nuovo
	hello: ['world'],
	world: (Elenco nuovo met: ['a'] a: ['b'])).

Uscita scrivi: a item, stop.

>> old-dict-address := a item prototipo indirizzo-di-memoria.
a save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RELOADING SNAP:'], stop.

>> b := Oggetto load-from: ['/tmp/a.bin'].

(b item prototipo indirizzo-di-memoria = old-dict-address) vero: {
	Uscita scrivi: ['Object link re-attached.'], stop.
}.

Uscita scrivi: b item, stop.
