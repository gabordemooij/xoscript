Uscita scrivi: ['Oggetto di test'], stop.
>> a := Oggetto nuovo. 

a on: ['item:'] fare: { :diz
	mio diz := diz. 
}.

a on: ['articolo'] fare: {
	<- mio diz.
}.

a item: (
Elenco nuovo
	hello: ['world'],
	world: (Elenco nuovo met: ['a'] a: ['b'])).

Uscita scrivi: a articolo, stop.

>> vecchio-indirizzo-diz := a articolo prototipo indirizzo-di-memoria.
a save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RICARICAMENTO SNAP:'], stop.

>> b := Oggetto load-from: ['/tmp/a.bin'].

(b articolo prototipo indirizzo-di-memoria = vecchio-indirizzo-diz) vero: {
	Uscita scrivi: ['Collegamento all'oggetto ricollegato.'], stop.
}.

Uscita scrivi: b articolo, stop.
