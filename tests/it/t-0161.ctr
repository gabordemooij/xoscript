Programma gcmode: 0.
Serie on: ['somma'] fare: {
	>> totale := 0.
	io ogni: { :indice :elemento
		totale inserisci: elemento.
	}. <- totale.
}.

>> memoriaUsata1 := 0.
>> memoriaUsata2 := 0.
>> memoriaUsata3 := 0.
>> memoriaUsata4 := 0.



>> f := File nuovo: ['/tmp/test.txt'].
f scrivi: ['Lorem Ipsum'].
f chiudi.
  

f := File nuovo: ['/tmp/test.txt'].
>> scritta := f leggere.
f chiudi.



Programma spazzare.
memoriaUsata1 := (Programma memoria ? 1).



f := File nuovo: ['/tmp/test.txt'].
scritta := f leggere.
f chiudi.

Programma spazzare.
memoriaUsata2 := (Programma memoria ? 1).


f := File nuovo: ['/tmp/test.txt'].
scritta := f leggere.
f chiudi.

Programma spazzare.
memoriaUsata3 := (Programma memoria ? 1).



( memoriaUsata1 = memoriaUsata2 e: memoriaUsata1 = memoriaUsata3, e: memoriaUsata2 = memoriaUsata3 ) vero: {
	Uscita scrivi: ['Nessuna perdita di memoria qui'].
}, falso: {
