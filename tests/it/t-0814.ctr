# formato del cookie di sessione, tipo di contenuto json, solo protocolli web, svg mostrato inline
Server inizializzare.
Programma uso: ['../../../src/xo/it/webtools.xo'].

>> Richiesta-Finta := Oggetto nuovo.
Richiesta-Finta on: ['value:'] fare: { :valore
	mio valore := valore.
}.
Richiesta-Finta on: ['cookie:'] fare: { :nome
	<- mio valore.
}.

>> Sessione-Prova := Sessione-file-temporaneo nuovo.
Sessione-Prova on: ['caricare'] fare: {
	<- Elenco nuovo.
}.
Sessione-Prova on: ['id-di-sessione'] fare: {
	<- mio id.
}.

>> cookies := Serie nuovo
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

cookies ogni: { :i :cookie
	>> richiesta := Richiesta-Finta nuovo.
	richiesta value: cookie.
	>> gestore := Sessione-Prova nuovo.
	>> web := Documento-Web nuovo.
	web richiesta: richiesta.
	web gestore-sessione: gestore.
	web avviare-sessione.
	Uscita scrivi: ( gestore id-di-sessione = cookie ), stop.
}.

>> web := Documento-Web nuovo.
web json: (Elenco nuovo met: ['b'] a: ['a']).
Uscita scrivi: ['\n'], stop.

{ Rete get: ['file:///etc/hostname']. } catturare: { :e
	Uscita scrivi: e, stop.
}, correre.

>> svg := File nuovo: ['/tmp/test0814.svg'].
svg scrivi: ['<svg xmlns="x"></svg>'].
Uscita stop.
Server passaggio: ['test0814.svg'] prefisso: ['/tmp/'].
svg elimina.
