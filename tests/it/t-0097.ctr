
Testo on: ['html'] fare: { <- (
		io
		sostituirlo: ['&'] con: ['&amp;'],
		sostituirlo: ['<'] con: ['&lt;'],
		sostituirlo: ['>'] con: ['&gt;'],
		sostituirlo: ['"'] con: ['&quot;']
	).
}.

>> PennelloHtml := Oggetto nuovo.

PennelloHtml on: ['rispondere:'] fare: { :etichetta
	Uscita scrivi: (['<tag>↵'] tag: etichetta ).
}.

PennelloHtml on: ['rispondere:e:'] fare: { :etichetta :content
	etichetta := ( etichetta da: 0 lunghezza: (etichetta lunghezza - 1) ).
	Uscita scrivi: (['<tag content>↵'] tag: etichetta, content: content).
}.

PennelloHtml on: ['content:'] fare: { :scritta
	Uscita scrivi: scritta html, stop.
}.

PennelloHtml on: ['attr:valore:'] fare: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := PennelloHtml nuovo.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] valore: ['bold']),
		/span
	/body
/html.
		
