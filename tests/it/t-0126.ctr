#Linux
>> Risucchio := Oggetto nuovo.

Risucchio on: ['nuovo'] fare: {
	mio str := [''].
}.

Risucchio on: ['nieuw'] fare: {
	mio str := [''].
}.

Risucchio on: ['rispondere:'] fare: { :blah
		mio str aggiungere: blah.
}.

Risucchio on: ['rispondere:e:'] fare: { :blah :blahah
		mio str aggiungere: (blah da: 0 lunghezza: (blah lunghezza - 1)).
		mio str aggiungere: [' '].
		mio str aggiungere: blahah.
}.

Risucchio on: ['ricava'] fare: {
	>> buffer := mio str.
	mio str := ['']. <- buffer.
}.


Uscita scrivi: (Programma sistema: (Risucchio nuovo echo: ['Ciao, so scrivere sulla console con una API fluida!'], ricava)).


{ File nuovo: ['/tmp/from.txt'], elimina. } catturare: { ['Vuoto']. }, correre.
{ File nuovo: ['/tmp/to.txt'], elimina. } catturare: { ['Vuoto']. }, correre.


File nuovo: ['/tmp/to.txt'], esiste falso: {
	Uscita scrivi: ['Confirmed. Target file does not exist.\
'].
}.
File nuovo: ['/tmp/from.txt'], esiste falso: {
	Uscita scrivi: ['Confirmed. Source file does not exist.\
'].
}.



Programma sistema: (Risucchio nuovo touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], ricava).



Programma sistema: (Risucchio nuovo cp: ['/tmp/from.txt /tmp/to.txt'], ricava).

File nuovo: ['/tmp/to.txt'], esiste vero: {
	Uscita scrivi: ['Confirmed. Target file has been created by shell.\
'].
}.


Uscita scrivi: ['Il contenuto del file è:'] + (File nuovo: ['/tmp/to.txt'], leggere), stop.
