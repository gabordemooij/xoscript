# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := Oggetto nuovo.

Log on: ['say:'] fare: { :str
	Uscita scrivi: str, stop.
}.

>> Item := Oggetto nuovo.

Item on: ['nuovo:'] fare: { :id <- io nuovo id: id.
}.

Item on: ['id:'] fare: { :id
	mio id := id.
}.

Item on: ['id'] fare: { <- mio id. }.


Item on: ['testo'] fare: {
	>> str := ['Item#~no'].
	str ~no: mio id. <- str.
}.


>> Print := Oggetto nuovo.

Print on: ['items'] fare: { 
	
	mio item := Item nuovo: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: mio item
	).
	
	
}.

Print items.