# Questo test verifica che string_fill_in non perda il suo slot (gc'ed) in modalità 4
# riferimento in world.c
>> Registro := Oggetto nuovo.

Registro on: ['say:'] fare: { :str
	Uscita scrivi: str, stop.
}.

>> Articolo := Oggetto nuovo.

Articolo on: ['nuovo:'] fare: { :id
	<- io nuovo id: id.
}.

Articolo on: ['id:'] fare: { :id
	mio id := id.
}.

Articolo on: ['id'] fare: { <- mio id. }.


Articolo on: ['testo'] fare: {
	>> str := ['Item#~no'].
	str ~no: mio id.
	<- str.
}.


>> Print := Oggetto nuovo.

Print on: ['items'] fare: { 
	
	mio articolo := Articolo nuovo: 1.
	
	# qui o segfault o testo sbagliato
	Registro say: (
		['~item printed.'] ~item: mio articolo
	).
	
	
}.

Print items.