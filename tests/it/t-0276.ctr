>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Oggetto nuovo.
⚄ on: ['drawFrom:length:'] fare: { :pool :contare
	
	>> result := [''].
	
	{
		>> index := Numero random % (pool lunghezza).
		result aggiungere: ( pool carattere: (index + 1) ).
		
	} × contare. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? lunghezza.
Uscita scrivi: (['x↵'] x random lunghezza).
Uscita scrivi: (['y↵'] y ?? lunghezza).

