>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Oggetto nuovo.
⚄ on: ['estraiDa:quantità:'] fare: { :urna :contare
	
	>> risultato := [''].
	
	{
		>> indice := Numero casuale % (urna lunghezza).
		risultato aggiungere: ( urna carattere: (indice + 1) ).
		
	} × contare. <- risultato.
}.

>> casuale := ⚄ estraiDa: ?? quantità: ?? lunghezza.
Uscita scrivi: (['x↵'] x casuale lunghezza).
Uscita scrivi: (['y↵'] y ?? lunghezza).

