>> str := ['write:'].
Uscita messaggio: ['scrivi:'] argomenti: (Serie ← ['Hello World']), stop. 

Numero on: ['isbetween:and:'] fare: { :a :b <- ((io ≥ a) e: (io ≤ b)).
}.

str := ['isbetween:and:'].
Uscita scrivi: (3 messaggio: str argomenti: (Serie ← 2 ; 8)), stop.
Uscita scrivi: (3 messaggio: str argomenti: (Serie ← 1 ; 2)), stop.


>> MacchinaDelCaffè := Oggetto nuovo.
MacchinaDelCaffè on: ['makeCoffeeWithSugar:milk:'] fare: { :sugar :milk <- ( ['Ecco a te... caffè con '] + 
			sugar +
			[' cucchiaini di zucchero e '] +
			milk +
			[' gocce di latte.']
	).
}.

>> ordinazione := ['makeCoffeeWithSugar:milk:'].
>> configurazioneCaffè := Serie ← 4 ; 2.
Uscita scrivi: ( MacchinaDelCaffè messaggio: ordinazione argomenti: configurazioneCaffè ), stop.
