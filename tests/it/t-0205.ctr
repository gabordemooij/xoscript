>> str := ['write:'].
Uscita messaggio: ['scrivi:'] argomenti: (Serie ← ['Hello World']), stop. 

Numero on: ['isbetween:and:'] fare: { :a :b <- ((io ≥ a) e: (io ≤ b)).
}.

str := ['isbetween:and:'].
Uscita scrivi: (3 messaggio: str argomenti: (Serie ← 2 ; 8)), stop.
Uscita scrivi: (3 messaggio: str argomenti: (Serie ← 1 ; 2)), stop.


>> CoffeeMachine := Oggetto nuovo.
CoffeeMachine on: ['makeCoffeeWithSugar:milk:'] fare: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Serie ← 4 ; 2.
Uscita scrivi: ( CoffeeMachine messaggio: order argomenti: coffeeConfiguration ), stop.
