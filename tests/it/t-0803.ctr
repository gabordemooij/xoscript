>> canc := conn1 query: ['DELETE FROM book WHERE id > 0'].
{  canc esegui. conn1 commit. } catturare: { :e conn1 rollback.  }, correre.

>> inserimento := conn1 query: ['INSERT INTO book (id) VALUES(null)'].
inserimento esegui.

>> contare := conn1 query: ['SELECT COUNT(*) AS num FROM book'].
contare recupera: { :fila Uscita scrivi: fila num, stop. }.

