

Serie on: ['fixture:'] fare: { :f
	mio impianto := f.
}.

Serie on: ['contare'] fare: { <- mio impianto.
}.

Serie on: ['aantal'] fare: { <- mio impianto.
}.


>> x := Nil.
{

	x := ['hello'] 
	sostituirlo:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] carattere: 2)
			)
		)
	con: (
		(['...hal'] + ['lo']) 
			maiuscolo 
			lowecase 
			maiuscolo 
			compensare: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Serie ← 0 ; 1 ; 4; 9 ; (Serie ← 0 ; 3; 1) ; 4
							) penultimo
						) ? 1
					) + 
					((Serie ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					contare
				)
			)
	).

} × 10.
Uscita scrivi: x, stop.

