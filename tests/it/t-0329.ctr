Uscita scrivi: ((Serie nuovo
	on: ['plaque:'] fare: { :x mio o := x. },
	on: ['plaque']  fare: { <- mio o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Serie ← 1)
	~ (Serie ← 1 ; 2)
	~ (Serie ← 1 ; 2 ; 3)
	~ (Serie ← 1 ; 2 ; 3 ; 4)
	~ (Serie ← 1 ; 2 ; 3 ; 4 ; 5)
) ogni: { :i :el
	{ Uscita scrivi: questo-compito. } × el contare.
	Uscita stop.
}) plaque, stop.


