

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programma gcmode: 0.

>> o := Oggetto nuovo.
>> o2 := Oggetto nuovo.
Uscita scrivi: o nil?, stop.
Uscita scrivi: o genere, stop.
Uscita scrivi: ( o equivale: o ), stop.
Uscita scrivi: ( o equivale: o2 ), stop.
Uscita scrivi: o me-stessa, stop.
Uscita scrivi: ( o fare fatto ), stop.

Programma spazzare.

usedMemory1 := (Programma memoria ? 0).


o := Oggetto nuovo.
o2 := Oggetto nuovo.
Uscita scrivi: o nil?, stop.
Uscita scrivi: o genere, stop.
Uscita scrivi: ( o equivale: o ), stop.
Uscita scrivi: ( o equivale: o2 ), stop.
Uscita scrivi: o me-stessa, stop.
Uscita scrivi: ( o fare fatto ), stop.

Programma spazzare.
usedMemory2 := (Programma memoria ? 0).


o := Oggetto nuovo.
o2 := Oggetto nuovo.
Uscita scrivi: o nil?, stop.
Uscita scrivi: o genere, stop.
Uscita scrivi: ( o equivale: o ), stop.
Uscita scrivi: ( o equivale: o2 ), stop.
Uscita scrivi: o me-stessa, stop.
Uscita scrivi: ( o fare fatto ), stop.

Programma spazzare.
usedMemory3 := (Programma memoria ? 0).



( usedMemory1 = usedMemory2 e: usedMemory1 = usedMemory3, e: usedMemory2 = usedMemory3 ) vero: {
	Uscita scrivi: ['No memory leaks here'].
}, falso: {
	Uscita scrivi: ['Leaking memory...'].
}.
