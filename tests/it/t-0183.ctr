

>> memoriaUsata1 := 0.
>> memoriaUsata2 := 0.
>> memoriaUsata3 := 0.
>> memoriaUsata4 := 0.

Programma gcmode: 0.

>> o := Oggetto nuovo.
>> o2 := Oggetto nuovo.
Uscita scrivi: o nil?, stop.
Uscita scrivi: o genere, stop.
Uscita scrivi: ( o equivale: o ), stop.
Uscita scrivi: ( o equivale: o2 ), stop.
Uscita scrivi: o me-stessa, stop.
Uscita scrivi: ( o fare fatto ), stop.

Programma spazzare.

memoriaUsata1 := (Programma memoria ? 0).


o := Oggetto nuovo.
o2 := Oggetto nuovo.
Uscita scrivi: o nil?, stop.
Uscita scrivi: o genere, stop.
Uscita scrivi: ( o equivale: o ), stop.
Uscita scrivi: ( o equivale: o2 ), stop.
Uscita scrivi: o me-stessa, stop.
Uscita scrivi: ( o fare fatto ), stop.

Programma spazzare.
memoriaUsata2 := (Programma memoria ? 0).


o := Oggetto nuovo.
o2 := Oggetto nuovo.
Uscita scrivi: o nil?, stop.
Uscita scrivi: o genere, stop.
Uscita scrivi: ( o equivale: o ), stop.
Uscita scrivi: ( o equivale: o2 ), stop.
Uscita scrivi: o me-stessa, stop.
Uscita scrivi: ( o fare fatto ), stop.

Programma spazzare.
memoriaUsata3 := (Programma memoria ? 0).



( memoriaUsata1 = memoriaUsata2 e: memoriaUsata1 = memoriaUsata3, e: memoriaUsata2 = memoriaUsata3 ) vero: {
	Uscita scrivi: ['Nessuna perdita di memoria qui'].
}, falso: {
	Uscita scrivi: ['Perdita di memoria...'].
}.
