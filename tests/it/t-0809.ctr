# le barre rovesciate devono sopravvivere alla serializzazione del codice, i testi non devono finire prima
>> valori := Serie nuovo
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

valori ogni: { :i :value
	>> d := Elenco nuovo.
	d met: value a: ['k'].
	>> r := d code oggetto.
	Uscita scrivi: r contare, stop.
	Uscita scrivi: ( (r a: ['k']) = value ), stop.
}.
