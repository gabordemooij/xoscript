['Migliaia e decimali'].

>> x := 100000000.5.
>> y := 100000000.5.

Uscita scrivi: (x + y), stop.

>> x := 10040.07.
>> y := 10305.60.

Uscita scrivi: (x + y), stop.

['Decimale'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Uscita scrivi: (x + y + z), stop.

['Strano ma valido'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Uscita scrivi: (x + y + z), stop.

>> q := 0.1.2.

Uscita scrivi: (q), stop.

>> q := 012.

Uscita scrivi: (q), stop.
