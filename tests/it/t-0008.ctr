>> Greeter := Oggetto nuovo.
Greeter on: ['make'] fare: {
	>> greeter := Oggetto nuovo.
	greeter on: ['name:'] fare: { :nome
		Uscita scrivi: ['setting a name'].
		mio myName := nome.
	}.
	greeter on: ['greet'] fare: {
		Uscita scrivi: ['Hello'].
		Uscita scrivi: mio myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
