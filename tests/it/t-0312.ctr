>> Risucchio := Oggetto nuovo.
Risucchio on: ['nuovo'] fare: {
	mio str := [''].
}.
Risucchio imparare: ['nieuw'] significa: ['nuovo'].
Risucchio on: ['rispondere:'] fare: { :blah
		(mio str ≠ ['']) vero: {
			mio str aggiungere: [' '].
		}.
		mio str aggiungere: blah.
}.
Risucchio on: ['rispondere:e:'] fare: { :blah :blahah
		(mio str ≠ ['']) vero: {
			mio str aggiungere: [' '].
		}.
		(blah lunghezza > 1) vero: {
			mio str aggiungere: (blah da: 0 lunghezza: (blah lunghezza - 1)).
		}, altro: {
			mio str aggiungere: blah.
		}.
		mio str aggiungere: [' '].
		mio str aggiungere: blahah.
}.
Risucchio on: ['ricava'] fare: {
	>> buffer := mio str.
	mio str := ['']. <- buffer.
}.


>> parametri := Risucchio nuovo
	select: ['*'],
	from
		utenti 
	where 
		user_id=: 1.

Uscita scrivi: parametri ricava, stop.
