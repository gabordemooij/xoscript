# Programma shell-escape produce sintassi shell posix canonica
# compatibile con: bash/dash, zsh, ksh

>> c := Programma shell-escape: ['abc'].
Uscita scrivi: c, stop.
Uscita scrivi: ( Programma sistema: ['echo '] + c ), stop.

c := Programma shell-escape: ['a'b'c'].
Uscita scrivi: c, stop.
Uscita scrivi: ( Programma sistema: ['echo '] + c ), stop.

c := Programma shell-escape: ['a\'c'].
Uscita scrivi: c, stop.
Uscita scrivi: ( Programma sistema: ['echo '] + c ), stop.