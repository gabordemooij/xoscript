>> Slurp := Oggetto nuovo.

Slurp on: ['nuovo'] fare: {
	mio str := [''].
}.

Slurp on: ['rispondere:'] fare: { :blah
		(mio str = ['']) vero: {
			mio str aggiungere: blah.
		}, altro: {
			mio str aggiungere: [' '].
			mio str aggiungere: blah.
		}.
}.

Slurp on: ['rispondere:e:'] fare: { :blah :blahah
		(blah lunghezza > 1) vero: {
			mio str aggiungere: (blah da: 0 lunghezza: (blah lunghezza - 1)).
		}, altro: {
			mio str aggiungere: blah.
		}.
		mio str aggiungere: [' '].
		mio str aggiungere: blahah.
}.

Slurp on: ['obtain'] fare: {
	>> buffer := mio str.
	mio str := ['']. <- buffer.
}.


>> x := Slurp nuovo.
x + 3.
Uscita scrivi: (x obtain), stop.
x echo: ['Hello world'].
Uscita scrivi: (x obtain), stop.
x tellme: 123 and: 987.
Uscita scrivi: (x obtain), stop.
