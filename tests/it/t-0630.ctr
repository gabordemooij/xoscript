#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Modello nuovo: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern corrispondenza: subject fai: { :m :x
	Uscita scrivi: m, stop.
	Uscita scrivi: x, stop. <- ['XXX'].
}.
Uscita scrivi: result, stop.