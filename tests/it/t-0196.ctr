
>> animale := Oggetto nuovo. 
 
 animale on: ['name:'] fare: { :n
mio nome := n.
}. 


animale name: ['Diva']. 
 
animale on: ['nome'] fare: { <- nome.
}.

>> gatto := animale nuovo.
 
 gatto name: ['Diva']. 
 
 gatto on: ['nome'] fare: { <- ['vostra altezza reale ']
+ (io nome).
}.

Uscita scrivi: gatto nome.
