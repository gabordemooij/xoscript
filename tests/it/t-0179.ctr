

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programma gcmode: 0.

>> txt := ['Word Salad'].
Uscita scrivi: ( txt copia da: 5 lunghezza: 5 ).
Uscita scrivi: ( txt copia compensare: 5, trim ), stop.

Programma spazzare.

usedMemory1 := (Programma memoria ? 0).


txt := ['Word Salad'].
Uscita scrivi: ( txt copia da: 5 lunghezza: 5 ).
Uscita scrivi: ( txt copia compensare: 5, trim ), stop.

Programma spazzare.
