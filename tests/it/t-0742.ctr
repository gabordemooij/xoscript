Uscita scrivi: ['Oggetto di test'], stop.
>> a := Oggetto nuovo. 

a on: ['item:'] fare: { :aiutantehex
	mio aiutantehex := aiutantehex. 
}.

a on: ['articolo'] fare: {
	<- mio aiutantehex.
}.

a item: Hx nuovo.

>> vecchio-indirizzo-aiutantehex := a articolo prototipo indirizzo-di-memoria.
a save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RICARICAMENTO SNAP:'], stop.

>> b := Oggetto load-from: ['/tmp/a.bin'].

(b articolo prototipo indirizzo-di-memoria = vecchio-indirizzo-aiutantehex) vero: {
	Uscita scrivi: ['Collegamento all'oggetto ricollegato.'], stop.
}.
