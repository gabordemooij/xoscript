Uscita scrivi: ['Test object'], stop.
>> a := Oggetto nuovo. 

a on: ['item:'] fare: { :hexhelper
	mio hexhelper := hexhelper. 
}.

a on: ['item'] fare: { <- mio hexhelper.
}.

a item: Hx nuovo.

>> old-hexhelper-address := a item prototipo indirizzo-di-memoria.
a save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RELOADING SNAP:'], stop.

>> b := Oggetto load-from: ['/tmp/a.bin'].

(b item prototipo indirizzo-di-memoria = old-hexhelper-address) vero: {
	Uscita scrivi: ['Object link re-attached.'], stop.
}.
