>> items := Elenco nuovo.
items met: ['black'] a: ['coffee'], met: ['earl grey'] a: ['tea'].
Uscita scrivi: (items a: ['coffee']), scrivi: (items a: ['tea']).
Uscita scrivi: ['there are'] + items contare + [' items in the array.'].
items met: ['capuccino'] a: ['coffee'].
Uscita scrivi: ['Now my coffee is.. '] + (items a: ['coffee']).
items met: ['aaa'] a: ['1'].
items met: ['bbb'] a: ['2'].
Uscita scrivi: (items a: ['a']).
