>> items := Elenco nuovo.
items met: ['nero'] a: ['coffee'], met: ['earl grey'] a: ['tè'].
Uscita scrivi: (items a: ['coffee']), scrivi: (items a: ['tè']).
Uscita scrivi: ['ci sono'] + items contare + [' elementi nella serie.'].
items met: ['cappuccino'] a: ['coffee'].
Uscita scrivi: ['Ora il mio caffè è.. '] + (items a: ['coffee']).
items met: ['aaa'] a: ['1'].
items met: ['bbb'] a: ['2'].
Uscita scrivi: (items a: ['a']).
