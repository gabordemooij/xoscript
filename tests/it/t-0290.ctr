# test delle operazioni su liste


>> torte := Serie ←
	['apple'] ;
	['bacca'] ;
	['cioccolato'] ;
	['formaggio'].


>> compra := torte sostituire: 1 lunghezza: 2 con: ( Serie ← ['cannella'] ; ['ananas'] ).
Uscita scrivi: (compra aderire: [',']), stop.


>> compra := torte sostituire: 1 lunghezza: 12 con: ( Serie ← ['cannella'] ; ['ananas'] ).
Uscita scrivi: (compra aderire: [',']), stop.


>> compra := torte sostituire: 2 lunghezza: 10 con: ( Serie nuovo ).
Uscita scrivi: (compra aderire: [',']), stop.


>> compra := torte sostituire: 0 lunghezza: 1 con: ( Serie nuovo ).
Uscita scrivi: (compra aderire: [',']), stop.


>> compra := torte sostituire: ['0'] lunghezza: ['1'] con: ['x'].
Uscita scrivi: (compra aderire: [',']), stop.
