# test list operations


>> cakes := Serie ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes sostituire: 1 lunghezza: 2 con: ( Serie ← ['cinnamon'] ; ['pineapple'] ).
Uscita scrivi: (buy aderire: [',']), stop.


>> buy := cakes sostituire: 1 lunghezza: 12 con: ( Serie ← ['cinnamon'] ; ['pineapple'] ).
Uscita scrivi: (buy aderire: [',']), stop.


>> buy := cakes sostituire: 2 lunghezza: 10 con: ( Serie nuovo ).
Uscita scrivi: (buy aderire: [',']), stop.


>> buy := cakes sostituire: 0 lunghezza: 1 con: ( Serie nuovo ).
Uscita scrivi: (buy aderire: [',']), stop.


>> buy := cakes sostituire: ['0'] lunghezza: ['1'] con: ['x'].
Uscita scrivi: (buy aderire: [',']), stop.
