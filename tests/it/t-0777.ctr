#OBSD
>> nomedir := [''].
{ nomedir aggiungere: ['X/']. } * (1024 / 2 - 4).
>> comando := ['mkdir -p /tmp/'] + nomedir.
Programma sistema: comando.
Programma chdir: ['/tmp/'] + nomedir.
>> nomefile := [''].
{ nomefile aggiungere: ['YYYYYYYY']. } * 20.
File nuovo: nomefile, scrivi: ['untesto'].
{ File serie: ['/tmp/'] + nomedir. } * 1000.
Uscita scrivi: ['nessun crash'], stop.

