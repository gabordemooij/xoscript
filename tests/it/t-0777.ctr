#OBSD
>> dirname := [''].
{ dirname aggiungere: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Programma sistema: command.
Programma chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename aggiungere: ['YYYYYYYY']. } * 20.
File nuovo: filename, scrivi: ['sometext'].
{ File serie: ['/tmp/'] + dirname. } * 1000.
Uscita scrivi: ['no crash'], stop.

