>> Animal := Oggetto nuovo.
>> Factory := Oggetto nuovo.

Animal on: ['nuovo'] fare: {
	>> animal := io nuovo.
	animal sound: ['?']. <- animal.
}.

Animal on: ['sound:'] fare: { :s
	mio sound := s.
}.

Animal on: ['sound'] fare: { <- mio sound.
}.

>> Dog := Oggetto nuovo.
>> Cat := Oggetto nuovo.

Dog on: ['nuovo'] fare: { <- Animal nuovo sound: ['woof!'].
}.

Cat on: ['nuovo'] fare: { <- Animal nuovo sound: ['meow!'].
}.

Uscita scrivi: Dog nuovo sound, stop.
Uscita scrivi: Cat nuovo sound, stop.

Factory on: ['mix:and:'] fare: { :beast1 :beast2 <- Animal nuovo sound: (
		( beast1 sound da: 0 lunghezza: 2 ) +
		( beast2 sound da: 2 lunghezza: 5 )
	).
}.

Uscita scrivi: (Factory mix: Dog nuovo and: Cat nuovo) sound, stop.
