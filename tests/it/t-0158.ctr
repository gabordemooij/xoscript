>> x := [' hallo '].

>> y := x maiuscolo.
Uscita scrivi: x, stop.
Uscita scrivi: (x equivale: y), stop.

>> y := x minuscolo.
Uscita scrivi: x, stop.
Uscita scrivi: (x equivale: y), stop.

>> y := x trim.
Uscita scrivi: x, stop.
Uscita scrivi: (x equivale: y), stop.

>> y := x compensare: 1.
Uscita scrivi: x, stop.
Uscita scrivi: (x equivale: y), stop.

>> y := x da: 1 lunghezza: 2.
Uscita scrivi: x, stop.
Uscita scrivi: (x equivale: y), stop.