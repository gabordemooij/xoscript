Booleano on: ['xor:'] fare: { :a :b <- ((a e: b non) o: (a non e: b)).
}.

>> o := Oggetto nuovo.
o on: ['hello'] fare: { ['Empty']. }.
{ o on: 2 fare: 3.} catturare: { :e Uscita scrivi: e, stop. }, correre.
{ o on: ['test'] fare: 3.} catturare: { :e Uscita scrivi: e, stop. }, correre.
{ o on: ['hello'] fare: { ['Empty']. }.} catturare: { :e Uscita scrivi: e, stop. }, correre. 
{ >> z := 4 ÷ 0. } catturare: { :e Uscita scrivi: e, stop. }, correre. 
{ (Vero e: Nil) vero: { Uscita scrivi: ['X'].}. } catturare: { :e Uscita scrivi: e, stop. }, correre. 
{ ([''] xor: 0) vero: { Uscita scrivi: ['X'].}. } catturare: { :e Uscita scrivi: e, stop. }, correre. 
{ (1 < ['2']) vero: { Uscita scrivi: ['OK']. }. } catturare: { :e Uscita scrivi: e, stop. }, correre. 
{ (1 < ['2.0']) vero: { Uscita scrivi: ['OK']. }. } catturare: { :e Uscita scrivi: e, stop. }, correre. 
{ (1 < ['x2.0']) vero: { Uscita scrivi: ['NO!']. }. } catturare: { :e Uscita scrivi: e, stop. }, correre. 
{ Uscita scrivi: (['hello OK there'] da: ['6'] lunghezza: ['2']). } correre. 
