Numero on: ['factorial'] fare: {
	>> total := 1.
	{ :index total moltiplicato-per: (io - (index)). } × io. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Uscita scrivi: a.
>> b := 2 + 3 factorial.
Uscita scrivi: b.
>> c := 3 factorial + 2.
Uscita scrivi: c.
>> d := 2 + (3 factorial).
Uscita scrivi: d.
Uscita scrivi: 2 + 3 factorial + 1.
