Numero on: ['fattoriale'] fare: {
	>> totale := 1.
	{ :indice totale moltiplicato-per: (io - (indice)). } × io. <- totale.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Uscita scrivi: a.
>> b := 2 + 3 fattoriale.
Uscita scrivi: b.
>> c := 3 fattoriale + 2.
Uscita scrivi: c.
>> d := 2 + (3 fattoriale).
Uscita scrivi: d.
Uscita scrivi: 2 + 3 fattoriale + 1.
