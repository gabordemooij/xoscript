# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> sentiero := ['/tmp/dat.csv'].
>> csv := File nuovo: sentiero.
csv scrivi: s.

# accepts CRLF LF CR, varying row length
csv separatore: [';'] virgolette: ['"'] linee: { :line
	Programma spazzare.
	Uscita scrivi: line, stop.
	Programma spazzare.
}.

# unequal lines
s aggiungere: ['\njustone'].
csv scrivi: s.
{
	csv separatore: [';'] virgolette: ['"'] linee: { :line
		Uscita scrivi: line, stop.
	}.
} catturare: { :e 
	Uscita scrivi: e, stop.
}, correre.

# invalid format
s := ['"he"llo";world'].
csv scrivi: s.
{
	csv separatore: [';'] virgolette: ['"'] linee: { :line
		Uscita scrivi: line, stop.
	}.
} catturare: { :e 
	Uscita scrivi: e, stop.
}, correre.
