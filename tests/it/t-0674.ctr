# flusso positivo
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> sentiero := ['/tmp/dat.csv'].
>> csv := File nuovo: sentiero.
csv scrivi: s.

# accetta CRLF LF CR, lunghezza delle righe variabile
csv separatore: [';'] virgolette: ['"'] linee: { :line
	Programma spazzare.
	Uscita scrivi: line, stop.
	Programma spazzare.
}.

# righe disuguali
s aggiungere: ['\njustone'].
csv scrivi: s.
{
	csv separatore: [';'] virgolette: ['"'] linee: { :line
		Uscita scrivi: line, stop.
	}.
} catturare: { :e 
	Uscita scrivi: e, stop.
}, correre.

# formato non valido
s := ['"he"llo";world'].
csv scrivi: s.
{
	csv separatore: [';'] virgolette: ['"'] linee: { :line
		Uscita scrivi: line, stop.
	}.
} catturare: { :e 
	Uscita scrivi: e, stop.
}, correre.
