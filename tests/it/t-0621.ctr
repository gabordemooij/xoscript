>> frasi := Serie nuovo
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> messaggio := ['Phrase: ~decoded base64: ~encoded'].
	
frasi ogni: { :_ :frase 
	>> e := Server base64-codifica: frase.
	>> d := Server base64-decodifica: e.
	Uscita scrivi: (
		messaggio copia ~encoded: e, ~decoded: d
	), stop.
}.
