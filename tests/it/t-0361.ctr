
>> XX := Oggetto nuovo.
>> X := Oggetto nuovo.

XX on: ['QQ'] fare: { <- 1. }.
XX on: ['Q'] fare: { <- 1. }.
XX on: ['QQ:'] fare: { <- 1. }.
XX on: ['QQ:QQ:'] fare: { <- 1. }.

X on: ['QQ'] fare: { <- 1. }.
X on: ['Q'] fare: { <- 1. }.
X on: ['QQ:'] fare: { <- 1. }.
X on: ['QQ:QQ:'] fare: { <- 1. }.

Uscita scrivi: (Programma XX), stop.
Uscita scrivi: (Programma trova: ['XX']), stop.
Uscita scrivi: (Programma trova: ['X']), stop.

Uscita scrivi: (Programma XX: ['QQ']), stop.
Uscita scrivi: (Programma XX: ['Q']), stop.
Uscita scrivi: (Programma XX: ['QQ:']), stop.
Uscita scrivi: (Programma XX: ['QQ:QQ:']), stop.

Uscita scrivi: (Programma X: ['QQ']), stop.
Uscita scrivi: (Programma X: ['Q']), stop.
Uscita scrivi: (Programma X: ['QQ:']), stop.
Uscita scrivi: (Programma X: ['QQ:QQ:']), stop.

Uscita scrivi: (Programma X ['QQ']), stop.
Uscita scrivi: (Programma X ['Q']), stop.
Uscita scrivi: (Programma X ['QQ:']), stop.
Uscita scrivi: (Programma X ['QQ:QQ:']), stop.

Uscita scrivi: (Programma YY), stop.
Uscita scrivi: (Programma trova: ['YY']), stop.
Uscita scrivi: (Programma trova: ['Y']), stop.

Uscita scrivi: (Programma YY: ['QQ']), stop.
Uscita scrivi: (Programma YY: ['Q']), stop.
Uscita scrivi: (Programma YY: ['QQ:']), stop.
Uscita scrivi: (Programma YY: ['QQ:QQ:']), stop.

Uscita scrivi: (Programma Y: ['QQ']), stop.
Uscita scrivi: (Programma Y: ['Q']), stop.
Uscita scrivi: (Programma Y: ['QQ:']), stop.
Uscita scrivi: (Programma Y: ['QQ:QQ:']), stop.

Uscita scrivi: (Programma Y ['QQ']), stop.
Uscita scrivi: (Programma Y ['Q']), stop.
Uscita scrivi: (Programma Y ['QQ:']), stop.
Uscita scrivi: (Programma Y ['QQ:QQ:']), stop.

Uscita scrivi: (Programma X: -1), stop.
Uscita scrivi: (Programma X Nil), stop.

