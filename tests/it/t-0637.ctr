# Impostazione dell'allarme

# termina il programma dopo 1 sec.
Programma tempo-massimo: 1.

Uscita scrivi: ['max 1 sec.'], stop.
Momento aspettare: 2.
Uscita scrivi: ['ci mette troppo.'], stop.

# nota:
# Impostare un allarme è irreversibile,
# un attaccante non può disattivarlo.
# Dopo la prima chiamata, l'allarme è bloccato.
# Inoltre l'allarme è davvero drastico,
# il programma *VERRÀ* fermato dopo
# l'intervallo di tempo indicato, anche se
# è in una lettura bloccante o simile.

# nota:
# L'allarme è pesante, valuta di impostare
# invece dei timeout di base nel webserver.



