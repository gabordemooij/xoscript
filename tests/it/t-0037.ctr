>> a := 3.
>> b := a copia.
a sottrarre: 1.
Uscita scrivi: [' a = '] + a.
Uscita scrivi: [' b = '] + b.
a := 3.
b := a + 4.
Uscita scrivi: [' a = '] + a.
Uscita scrivi: [' b = '] + b.
>> x := 3.
>> y := x copia.
x inserisci: 10.
y sottrarre: 1.
Uscita scrivi: [' x = '] + x.
Uscita scrivi: [' y = '] + y.
>> q := Oggetto nuovo.
q on: ['setProperty:'] fare: { :x
	mio prop := x.
}.
q on: ['getProperty'] fare: { <- mio prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Uscita scrivi: [' p = '] + (p getProperty).
