#Linux
>> clock := Momento nuovo.
clock zona: ['UTC-1'].
clock anno: 1981, mese: 1, giorno: 5,
      ora: 13, minuto: 15, secondo: 13.

Uscita scrivi: clock, stop.
clock zona: ['UTC+0'].

Uscita scrivi: (
	(clock anno crudo) + ['-'] + (clock mese) + ['-'] + (clock giorno) + [' '] +
	(clock ora) + [':'] + (clock minuto) + [':'] + (clock secondo) + [' '] +
	['W'] + (clock settimana) + (clock zona)
), stop.


clock zona: ['UTC-1'].
Uscita scrivi: (
	(clock anno crudo) + ['-'] + (clock mese) + ['-'] + (clock giorno) + [' '] +
	(clock ora) + [':'] + (clock minuto) + [':'] + (clock secondo) + [' '] +
	['W'] + (clock settimana) + (clock zona)
), stop.
