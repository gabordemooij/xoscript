#Linux
>> orologio := Momento nuovo.
orologio zona: ['UTC-1'].
orologio anno: 1981, mese: 1, giorno: 5,
      ora: 13, minuto: 15, secondo: 13.

Uscita scrivi: orologio, stop.
orologio zona: ['UTC+0'].

Uscita scrivi: (
	(orologio anno crudo) + ['-'] + (orologio mese) + ['-'] + (orologio giorno) + [' '] +
	(orologio ora) + [':'] + (orologio minuto) + [':'] + (orologio secondo) + [' '] +
	['W'] + (orologio settimana) + (orologio zona)
), stop.


orologio zona: ['UTC-1'].
Uscita scrivi: (
	(orologio anno crudo) + ['-'] + (orologio mese) + ['-'] + (orologio giorno) + [' '] +
	(orologio ora) + [':'] + (orologio minuto) + [':'] + (orologio secondo) + [' '] +
	['W'] + (orologio settimana) + (orologio zona)
), stop.
