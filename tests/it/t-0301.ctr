


>> vino := Oggetto nuovo.


vino on: ['inTesto'] fare: { <- ['merlot'].
}.

vino on: ['naarTekst'] fare: { <- ['merlot'].
}.


vino on: ['='] fare: { :other wine <- ( io inTesto = other wine ).
}.

vino on: ['=='] fare: { :other wine <- ( io inTesto = other wine ).
}.



vino
	caso: ['cabernet'] fare: { Uscita scrivi: ['è un Cabernet!']. },
	caso: ['syrah']    fare: { Uscita scrivi: ['è un Syrah!'].    },
	caso: ['merlot']   fare: { Uscita scrivi: ['è un Merlot!'].   },
	caso: ['malbec']   fare: { Uscita scrivi: ['è un Malbec!'].   }.

Uscita stop.
