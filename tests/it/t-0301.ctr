


>> wine := Oggetto nuovo.


wine on: ['toString'] fare: { <- ['merlot'].
}.

wine on: ['naarTekst'] fare: { <- ['merlot'].
}.


wine on: ['='] fare: { :other wine <- ( io toString = other wine ).
}.

wine on: ['=='] fare: { :other wine <- ( io toString = other wine ).
}.



wine
	caso: ['cabernet'] fare: { Uscita scrivi: ['it's a Cabernet!']. },
	caso: ['syrah']    fare: { Uscita scrivi: ['it's a Syrah!'].    },
	caso: ['merlot']   fare: { Uscita scrivi: ['it's a Merlot!'].   },
	caso: ['malbec']   fare: { Uscita scrivi: ['it's a Malbec!'].   }.

Uscita stop.
