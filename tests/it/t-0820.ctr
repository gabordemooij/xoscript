# un gruppo che non fa parte della corrispondenza non deve causare crash e deve mantenere i numeri dei gruppi
Server init.
>> mostra := { :criterio :subject
	>> p := Modello nuovo: criterio.
	p corrispondenza: subject fai: { :m :g
		Uscita scrivi: g contare, scrivi: [' '], scrivi: (g aderire: ['|']), stop.
		<- m.
	}.
}.
mostra applica: ['(a)|(b)'] e: ['b'].
mostra applica: ['(a)|(b)'] e: ['a'].
mostra applica: ['(x)?y'] e: ['y'].
mostra applica: ['(x)?(y)(z)?'] e: ['xy'].
