# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Modello nuovo: pattern.
	p corrispondenza: subject fai: { :m :g
		Uscita scrivi: g contare, scrivi: [' '], scrivi: (g aderire: ['|']), stop. <- m.
	}.
}.
show applica: ['(a)|(b)'] e: ['b'].
show applica: ['(a)|(b)'] e: ['a'].
show applica: ['(x)?y'] e: ['y'].
show applica: ['(x)?(y)(z)?'] e: ['xy'].
