#Linux

(File nuovo: ['/tmp/testje']) esiste falso: {
	Programma sistema: ['mkdir /tmp/testje'].	
}.

(File nuovo: ['/tmp/testje/file1']) esiste falso: {
	Programma sistema: ['touch /tmp/testje/file1'].	
}.

(File nuovo: ['/tmp/testje/folder1']) esiste falso: {
	Programma sistema: ['mkdir /tmp/testje/folder1'].	
}.

>> l := File serie: ['/tmp/testje'].

>> q := Serie nuovo.

l ogni: { :k :v v ogni: { :x :y q aggiungere: y. }. }.

>> s := q testo.

(s contiene: ['file1']) vero:   { Uscita scrivi: ['OK'], stop. }.
(s contiene: ['file2']) vero:   { Uscita scrivi: ['XX'], stop. }.
(s contiene: ['folder1']) vero: { Uscita scrivi: ['OK'], stop. }.
