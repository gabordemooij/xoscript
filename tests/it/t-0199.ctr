
Programma gcmode: 4.

>> Animal := Oggetto nuovo.
Animal on: ['make'] fare: {
	>> animal := Oggetto nuovo.
	animal on: ['makeSound'] fare: {
		Uscita scrivi: mio sound.
	}. <- animal.
}.
>> Cat := Oggetto nuovo.
Cat on: ['make'] fare: {
	>> cat := Animal make.
	cat on: ['init'] fare: {
		mio sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
