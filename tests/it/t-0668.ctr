# decodifica da utf16le/be o utf32le/be a utf8
Server init.
>> utf16 := Blob nuovo: 8, bytes: (
	Serie nuovo ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Uscita scrivi: ( utf16 decodifica: ['utf16le'] ), stop.

utf16 libero.
>> utf32 := Blob nuovo: 13, bytes: (
	Serie nuovo ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Uscita scrivi: ( utf32 decodifica: ['utf32be'] ), stop.
utf32 libero.