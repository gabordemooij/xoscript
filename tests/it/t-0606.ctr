>> Punto := Oggetto nuovo.
Punto on: ['x-coordinate:'] fare: { :x mio x := x. }.
Punto on: ['y-coordinate:'] fare: { :y mio y := y. }.
Punto on: ['coordinata-x']  fare: { <- mio x copia. }.
Punto on: ['coordinata-y']  fare: { <- mio y copia. }.

Punto on: ['='] fare: { :altroPunto
	<- ( mio x = altroPunto coordinata-x
		 e: mio y = altroPunto coordinata-y ).
}.

>> molo := Punto nuovo x-coordinate: 5, y-coordinate: 6.
>> municipio := Punto nuovo x-coordinate: 7, y-coordinate: 1.
>> ristorante := Punto nuovo x-coordinate: 5, y-coordinate: 6.

Uscita scrivi: molo = municipio, stop.
Uscita scrivi: molo = ristorante, stop.
