>> Point := Oggetto nuovo.
Point on: ['x-coordinate:'] fare: { :x mio x := x. }.
Point on: ['y-coordinate:'] fare: { :y mio y := y. }.
Point on: ['x-coordinate']  fare: { <- mio x copia. }.
Point on: ['y-coordinate']  fare: { <- mio y copia. }.

Point on: ['='] fare: { :other <- ( mio x = other x-coordinate
		 e: mio y = other y-coordinate ).
}.

>> pier := Point nuovo x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point nuovo x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point nuovo x-coordinate: 5, y-coordinate: 6.

Uscita scrivi: pier = town-hall, stop.
Uscita scrivi: pier = restaurant, stop.
