Server init.

# il codificatore JSON supporta solo UTF-8, niente coppie surrogate

>> dizionari := Serie nuovo ;
	# {"key":"normal"} ASCII normale
	( Elenco nuovo met: ['normale'] a: ['key'] ) ;
	# {"key":"hello world"} carattere di spazio
	( Elenco nuovo met: ['hello world'] a: ['key'] ) ;
	# {"key":"quote: \""} virgolette doppie
	( Elenco nuovo met: ['"'] a: ['key'] ) ;
	# {"key":"backslash: \\"} barra rovesciata
	( Elenco nuovo met: ['backslash: \\'] a: ['key'] ) ;
	# {"key":"slash: /"} barra
	( Elenco nuovo met: ['barra: /'] a: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( Elenco nuovo met: ['backspace: \b'] a: ['key'] ) ;
	# {"key":"formfeed: \f"} escape di form-feed
	( Elenco nuovo met: ['formfeed: \f'] a: ['key'] ) ;
	# {"key":"newline: \n"} a capo
	( Elenco nuovo met: ['newline: \n'] a: ['key'] ) ;
	( Elenco nuovo met: ['newline: ↵'] a: ['key'] ) ;
	( Elenco nuovo met: ['newline: 
	'] a: ['key'] ) ;
	# {"key":"carriage return: \r"} ritorno a capo
	( Elenco nuovo met: ['carriage return: \r'] a: ['key'] ) ;
	# {"key":"tab: \t"} tabulazione
	( Elenco nuovo met: ['tab \t'] a: ['key'] ) ;
	( Elenco nuovo met: ['tab ⇿'] a: ['key'] ) ;
	( Elenco nuovo met: ['tabulazione  '] a: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( Elenco nuovo met: ['NUL \u0000'] a: ['key'] ) ;
	( Elenco nuovo met: ['NUL \0'] a: ['key'] ) ;
	# {"key":"control: \u0001"} carattere di controllo 0x01
	( Elenco nuovo met: ['control: \u0001'] a: ['key'] ) ;
	# {"key":"control: \u001F"} carattere di controllo 0x1F
	( Elenco nuovo met: ['control: \u001F'] a: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, carattere di 2 byte
	( Elenco nuovo met: ['unicode: é'] a: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, carattere di 3 byte
	( Elenco nuovo met: ['unicode: €'] a: ['key'] ) ;
	# {"key":"unicode: 日本語"} più caratteri UTF-8 di 3 byte
	( Elenco nuovo met: ['unicode: 日本語'] a: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, carattere di 4 byte
	( Elenco nuovo met: ['unicode: 😀'] a: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	( Elenco nuovo met: ['unicode: 🧑‍💻'] a: ['key'] ) ;
	# {"key":"combining: é"} accento combinante
	( Elenco nuovo met: ['combining: e\u0301'] a: ['key'] ) ;
	# {"key":"escaped unicode: é"} escape Unicode BMP
	( Elenco nuovo met: ['escaped unicode: \u00e9'] a: ['key'] ) ;
	# {"key":"escaped unicode: €"} escape Unicode BMP
	( Elenco nuovo met: ['escaped unicode: \u20ac'] a: ['key'] ) ;
	# {"key":"escaped unicode: 😀"} coppia surrogata UTF-16
	( Elenco nuovo met: ['escaped unicode: \ud83d\ude00'] a: ['key'] ) ;
	# {"key":""} valore vuoto
	( Elenco nuovo met: [''] a: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} caratteri ASCII speciali
	( Elenco nuovo met: ['@ < > & = % + ? #'] a: ['key'] ) ;
	# {"key":"single quote: '"} apostrofo
	( Elenco nuovo met: ['''] a: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} più escape JSON
	( Elenco nuovo met: ['multiple: \" \\ \n \r \t'] a: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} testo ASCII più lungo
	( Elenco nuovo met: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] a: ['key'] ) ;
	# {"key":" value"} spazio iniziale
	( Elenco nuovo met: [' value'] a: ['key'] ) ;
	# {"key":"value "} spazio finale
	( Elenco nuovo met: ['value '] a: ['key'] ) ;
	# {"key":" \t\n\r "} spazi bianchi
	( Elenco nuovo met: [' \t\n\r '] a: ['key'] )
	.

dizionari ogni: { :_ :d
	>> j := JSON jsonifica: d.
	>> a := JSON jsonifica: (Elenco nuovo met: d key a: ['key']).
	>> b := JSON jsonifica: (Elenco nuovo met: ['value'] a: d key).
	>> e := JSON oggetto: a.
	>> f := JSON oggetto: b.
	((e key = d key e: (f ? d key = ['value'])) o: (e key = ['NUL ?'])) vero: {
		Uscita scrivi: ['OK'], stop.
	}, altro: {
		Uscita scrivi: ['Impossibile codificare/decodificare correttamente: '] + d + j, stop.
		Programma fine.
	}.
}.
