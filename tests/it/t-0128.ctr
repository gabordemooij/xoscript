
Serie on: ['sum'] fare: {
	>> total := 0.
	io ogni: { :index :element
		total inserisci: element.
	}. <- total.
}.

>> a := Serie ← 9 ; 8 ; 7.
Uscita scrivi: (a sum), stop. 
>> a := Serie ← 1 ; 9.
Uscita scrivi: (a sum), stop. 
>> a := Serie ← ['o'] ; 2.
Uscita scrivi: (a sum), stop. 
Uscita scrivi: (Serie nuovo sum), stop. 
