
>> Animale := Oggetto nuovo.
Animale on: ['nuovo'] fare: {
	<- io nuovo init.
}.

Animale on: ['init'] fare: {
	mio verso := ['?'].
	mio zampe  := 4.
}.

>> Cane := Animale nuovo.
Cane on: ['init'] fare: {
	io init.
	mio verso := ['abbaia'].
}.

Animale on: ['testo'] fare: {
	<- mio zampe testo + mio verso.
}.

>> barboncino := Cane nuovo.
Uscita scrivi: barboncino, stop.

