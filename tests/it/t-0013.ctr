
>> Animal := Oggetto nuovo.
Animal on: ['nuovo'] fare: { <- io nuovo init.
}.

Animal on: ['init'] fare: {
	mio sound := ['?'].
	mio legs := 4.
}.

>> Dog := Animal nuovo.
Dog on: ['init'] fare: {
	io init.
	mio sound := ['barks'].
}.

Animal on: ['testo'] fare: { <- mio legs testo + mio sound.
}.

>> poodle := Dog nuovo.
Uscita scrivi: poodle, stop.

