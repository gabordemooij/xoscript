

>> ogg := Oggetto nuovo.

ogg on: ['saluta'] fare: {
	<- ['ehi'].
}.

# deve stampare hi123hi123ok
ogg on: ['incarico'] fare: {
	mio proprietà := 123.
	{
		# prova lega io/mio all'oggetto invece che al blocco
		Uscita scrivi: io saluta.
		Uscita scrivi: mio proprietà.
		1 / 0.
	} catturare: {
		Uscita scrivi: io saluta.
		Uscita scrivi: mio proprietà.
		Uscita scrivi: ['ok'].
	}, prova.
}.

ogg incarico.