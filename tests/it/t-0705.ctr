

>> obj := Oggetto nuovo.

obj on: ['greet'] fare: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj on: ['task'] fare: {
	mio property := 123.
	{
		# try binds self/own to object instead of block
		Uscita scrivi: io greet.
		Uscita scrivi: mio property.
		1 / 0.
	} catturare: {
		Uscita scrivi: io greet.
		Uscita scrivi: mio property.
		Uscita scrivi: ['ok'].
	}, prova.
}.

obj task.