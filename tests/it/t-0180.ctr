Testo on: ['html'] fare: { <- (
		io
		sostituirlo: ['&'] con: ['&amp;'],
		sostituirlo: ['<'] con: ['&lt;'],
		sostituirlo: ['>'] con: ['&gt;'],
		sostituirlo: ['''] con: ['&apos;'],
		sostituirlo: ['"'] con: ['&quot;']
	).
}.

>> memoriaUsata1 := 0.
>> memoriaUsata2 := 0.
>> memoriaUsata3 := 0.
>> memoriaUsata4 := 0.

Programma gcmode: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Uscita scrivi: txt copia html, stop.
Uscita scrivi: txt copia minuscolo, stop.
Uscita scrivi: txt copia maiuscolo, stop.
} correre.

Programma spazzare.

memoriaUsata1 := (Programma memoria ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Uscita scrivi: txt copia html, stop.
Uscita scrivi: txt copia minuscolo, stop.
Uscita scrivi: txt copia maiuscolo, stop.
} correre.

Programma spazzare.
memoriaUsata2 := (Programma memoria ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Uscita scrivi: txt copia html, stop.
Uscita scrivi: txt copia minuscolo, stop.
Uscita scrivi: txt copia maiuscolo, stop.
} correre.

Programma spazzare.
memoriaUsata3 := (Programma memoria ? 0).



( memoriaUsata1 = memoriaUsata2 e: memoriaUsata1 = memoriaUsata3, e: memoriaUsata2 = memoriaUsata3 ) vero: {
	Uscita scrivi: ['Nessuna perdita di memoria qui'].
}, falso: {
	Uscita scrivi: ['Perdita di memoria...'].
}.
