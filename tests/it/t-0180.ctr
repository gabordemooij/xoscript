Testo on: ['html'] fare: { <- (
		io
		sostituirlo: ['&'] con: ['&amp;'],
		sostituirlo: ['<'] con: ['&lt;'],
		sostituirlo: ['>'] con: ['&gt;'],
		sostituirlo: ['''] con: ['&apos;'],
		sostituirlo: ['"'] con: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programma gcmode: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Uscita scrivi: txt copia html, stop.
Uscita scrivi: txt copia minuscolo, stop.
Uscita scrivi: txt copia maiuscolo, stop.
} correre.

Programma spazzare.

usedMemory1 := (Programma memoria ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Uscita scrivi: txt copia html, stop.
Uscita scrivi: txt copia minuscolo, stop.
Uscita scrivi: txt copia maiuscolo, stop.
} correre.

Programma spazzare.
usedMemory2 := (Programma memoria ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Uscita scrivi: txt copia html, stop.
Uscita scrivi: txt copia minuscolo, stop.
Uscita scrivi: txt copia maiuscolo, stop.
} correre.

Programma spazzare.
usedMemory3 := (Programma memoria ? 0).



( usedMemory1 = usedMemory2 e: usedMemory1 = usedMemory3, e: usedMemory2 = usedMemory3 ) vero: {
	Uscita scrivi: ['No memory leaks here'].
}, falso: {
	Uscita scrivi: ['Leaking memory...'].
}.
