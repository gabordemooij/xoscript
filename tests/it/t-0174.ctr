


>> memoriaUsata1 := 0.
>> memoriaUsata2 := 0.
>> memoriaUsata3 := 0.
>> memoriaUsata4 := 0.

Programma gcmode: 0.
>> tavolozza := Nil.
>> colori := Nil.

{
tavolozza := Elenco nuovo.
tavolozza 
	met: ['#F00'] a: ['rosso'],
	met: ['#0F0'] a: ['verde'],
	met: ['#00F'] a: ['blu'].
Uscita scrivi: ['numero di codici RGB nella tavolozza: '] + ( tavolozza contare ), stop.
Uscita scrivi: ['Il codice RGB del verde è: '] + ( tavolozza ? ['verde'] ), stop.
colori := [''].
( tavolozza ogni: { :nome :code
		colori := colori + ( nome + [':'] + code ).
} ).
Uscita scrivi: ['Tutti i colori nella tavolozza: '] + colori, stop.
} correre.
Programma spazzare.
memoriaUsata1 := (Programma memoria ? 0).

{
