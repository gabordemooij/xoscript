


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programma gcmode: 0.
>> palette := Nil.
>> colors := Nil.

{
palette := Elenco nuovo.
palette 
	met: ['#F00'] a: ['red'],
	met: ['#0F0'] a: ['green'],
	met: ['#00F'] a: ['blue'].
Uscita scrivi: ['number of RGB codes in palette: '] + ( palette contare ), stop.
Uscita scrivi: ['RGB code of green is: '] + ( palette ? ['green'] ), stop.
colors := [''].
( palette ogni: { :nome :code
		colors := colors + ( nome + [':'] + code ).
} ).
Uscita scrivi: ['All colors in palette: '] + colors, stop.
} correre.
Programma spazzare.
usedMemory1 := (Programma memoria ? 0).

{
