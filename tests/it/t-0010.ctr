>> Animale := Oggetto nuovo.
Animale on: ['crea'] fare: {
	>> animale := Oggetto nuovo.
	animale on: ['faiVerso'] fare: {
		Uscita scrivi: mio verso.
	}. <- animale.
}.
>> Gatto := Oggetto nuovo.
Gatto on: ['crea'] fare: {
	>> gatto := Animale crea.
	gatto on: ['init'] fare: {
		mio verso := ['meow!'].
	}.
	gatto init. <- gatto.
}.
>> tom := Gatto crea.
tom faiVerso.
