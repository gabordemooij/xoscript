# chiave pubblica (per proteggere API ecc.)
Server init.

# genera le chiavi
>> chiavi := Caveau chiavi-crittografiche.

# chiave privata (segreta)
>> sk := chiavi primo.

# chiave pubblica
>> pk := chiavi scorso.

# firma un messaggio
>> firma := Caveau firma: ['abc'] con: sk.

# controlla il messaggio (ok)
Uscita scrivi: ( 
	Caveau
		verifica: ['abc'] 
		firma: firma 
		con: pk 
), stop.

# controlla il messaggio (fallito)
Uscita scrivi: ( 
	Caveau 
		verifica: ['abd'] 
		firma: firma 
		con: pk 
), stop.