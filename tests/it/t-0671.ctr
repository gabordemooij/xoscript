# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Caveau chiavi-crittografiche.

# private (secret) key
>> sk := keys primo.

# public key
>> pk := keys scorso.

# sign a message
>> sig := Caveau firma: ['abc'] con: sk.

# check message (ok)
Uscita scrivi: ( 
	Caveau
		verifica: ['abc'] 
		firma: sig 
		con: pk 
), stop.

# check message (fail)
Uscita scrivi: ( 
	Caveau 
		verifica: ['abd'] 
		firma: sig 
		con: pk 
), stop.