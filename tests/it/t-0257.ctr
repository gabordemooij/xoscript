
>> Salutatore := Oggetto nuovo.
Salutatore on: ['nuovo'] fare: {
	mio nome := ['?'].
}.
Salutatore on: ['name:'] fare: { :nome
	mio nome := nome.
}.
Salutatore on: ['saluta'] fare: {
	Uscita scrivi: (['hello[you]'] [you]: mio nome).
}.
>> amico := Salutatore nuovo.
amico name: ['1'].
amico saluta.
