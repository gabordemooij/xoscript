Uscita scrivi: ['Oggetto di test'], stop.
>> a := Oggetto nuovo. 

a on: ['item:'] fare: { :usc
	mio usc := usc. 
}.

a on: ['articolo'] fare: {
	<- mio usc.
}.

a on: ['saluta'] fare: {
	Uscita scrivi: ['ciao dall'uscita originale!'], stop.
}.

a item: Uscita.

Uscita scrivi: a articolo, stop.

>> vecchio-indirizzo-usc := a articolo prototipo indirizzo-di-memoria.
a save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RICARICAMENTO SNAP:'], stop.

>> b := Oggetto load-from: ['/tmp/a.bin'].

(b articolo prototipo indirizzo-di-memoria = vecchio-indirizzo-usc) vero: {
	Uscita scrivi: ['Collegamento all'oggetto ricollegato.'], stop.
}.

b articolo scrivi: ['salve dall'uscita caricata!'], stop.
b saluta.
