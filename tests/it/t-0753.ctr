Uscita scrivi: ['Test object'], stop.
>> a := Oggetto nuovo. 

a on: ['item:'] fare: { :fmt
	mio fmt := fmt. 
}.

a on: ['item'] fare: { <- mio fmt.
}.

a item: ( Formato nuovo: ['|%s|'] ).

Uscita scrivi: a item, stop.

>> old-fmt-address := a item prototipo indirizzo-di-memoria.
a save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RELOADING SNAP:'], stop.

>> b := Oggetto load-from: ['/tmp/a.bin'].

(b item prototipo indirizzo-di-memoria = old-fmt-address) vero: {
	Uscita scrivi: ['Object link re-attached.'], stop.
}.

Uscita scrivi: ( b item applica: ['hello'] ), stop.
