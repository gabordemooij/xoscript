Uscita scrivi: ['Oggetto di test'], stop.
>> a := Oggetto nuovo. 

a on: ['item:'] fare: { :fmt
	mio fmt := fmt. 
}.

a on: ['articolo'] fare: {
	<- mio fmt.
}.

a item: ( Formato nuovo: ['|%s|'] ).

Uscita scrivi: a articolo, stop.

>> vecchio-indirizzo-fmt := a articolo prototipo indirizzo-di-memoria.
a save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RICARICAMENTO SNAP:'], stop.

>> b := Oggetto load-from: ['/tmp/a.bin'].

(b articolo prototipo indirizzo-di-memoria = vecchio-indirizzo-fmt) vero: {
	Uscita scrivi: ['Collegamento all'oggetto ricollegato.'], stop.
}.

Uscita scrivi: ( b articolo applica: ['hello'] ), stop.
