

Testo on: ['evaluate'] fare: {
	>> code := File nuovo: ['/tmp/eval.ctr'].
	code scrivi: io testo + ['.'].
	Programma uso: ['/tmp/eval.ctr'].
}.

>> a := (Serie ← (
	(Elenco nuovo)
		met: ['domain'] a: ['mywebsite.com'],
		met: (Serie ←
			((Elenco nuovo)
				met: ['home'] a: ['title'],
				met: ['<html></html>'] a: ['body'],
				met: ['2017-01-01'] a: ['created']
			) ;
			((Elenco nuovo)
				met: ['aboutus(c)'] a: ['title'],
				met: ['<credits>Author Inc.</credits>'] a: ['body']
			)
		) a: ['pages']
	)
) testo.

Uscita scrivi: a genere, stop.
Uscita scrivi: a, stop.

>> b := Nil.
(['b := '] + a) evaluate.
Uscita scrivi: b ? 0 ? ['pages'] ? 1 ? ['body'], stop.

>> c := b ? 0.
>> d := c testo.
Uscita scrivi: d genere, stop.

>> e := Nil.
(['e := '] + d) evaluate.
Uscita scrivi: e ? ['pages'] ? 0, stop.
