

Testo on: ['valutare'] fare: {
	>> code := File nuovo: ['/tmp/eval.ctr'].
	code scrivi: io testo + ['.'].
	Programma uso: ['/tmp/eval.ctr'].
}.

>> a := (Serie ← (
	(Elenco nuovo)
		met: ['dominio'] a: ['mywebsite.com'],
		met: (Serie ←
			((Elenco nuovo)
				met: ['inizio'] a: ['title'],
				met: ['<html></html>'] a: ['body'],
				met: ['2017-01-01'] a: ['creato']
			) ;
			((Elenco nuovo)
				met: ['chisiamo(c)'] a: ['title'],
				met: ['<credits>Author Inc.</credits>'] a: ['body']
			)
		) a: ['pagine']
	)
) testo.

Uscita scrivi: a genere, stop.
Uscita scrivi: a, stop.

>> b := Nil.
(['b := '] + a) valutare.
Uscita scrivi: b ? 0 ? ['pagine'] ? 1 ? ['body'], stop.

>> c := b ? 0.
>> d := c testo.
Uscita scrivi: d genere, stop.

>> e := Nil.
(['e := '] + d) valutare.
Uscita scrivi: e ? ['pagine'] ? 0, stop.
