Numero on: ['fattoriale'] fare: {
	>> totale := 1.
	{ :indice totale moltiplicato-per: (io - indice). } × io. <- totale.
}.

>> memoriaUsata1 := 0.
>> memoriaUsata2 := 0.
>> memoriaUsata3 := 0.
>> memoriaUsata4 := 0.

Programma gcmode: 0.

{
2 esponente fattoriale.
Uscita scrivi: (11 modulo: 3), stop.
Uscita scrivi: (3.4 arrotondato), stop.
Uscita scrivi: (7.1 eccesso), stop.
Uscita scrivi: (7.9 difetto), stop.
}
correre.

Programma spazzare.

memoriaUsata1 := (Programma memoria ? 0).

{
2 esponente fattoriale.
Uscita scrivi: (11 modulo: 3), stop.
Uscita scrivi: (3.4 arrotondato), stop.
Uscita scrivi: (7.1 eccesso), stop.
Uscita scrivi: (7.9 difetto), stop.
}
correre.

Programma spazzare.
memoriaUsata2 := (Programma memoria ? 0).


{
2 esponente fattoriale.
Uscita scrivi: (11 modulo: 3), stop.
Uscita scrivi: (3.4 arrotondato), stop.
Uscita scrivi: (7.1 eccesso), stop.
Uscita scrivi: (7.9 difetto), stop.
} correre.

Programma spazzare.
memoriaUsata3 := (Programma memoria ? 0).



( memoriaUsata1 = memoriaUsata2 e: memoriaUsata1 = memoriaUsata3, e: memoriaUsata2 = memoriaUsata3 ) vero: {
	Uscita scrivi: ['Nessuna perdita di memoria qui'].
}, falso: {
	Uscita scrivi: ['Perdita di memoria...'].
}.
