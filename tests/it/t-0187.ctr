Numero on: ['factorial'] fare: {
	>> total := 1.
	{ :index total moltiplicato-per: (io - index). } × io. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programma gcmode: 0.

{
2 exponent factorial.
Uscita scrivi: (11 modulo: 3), stop.
Uscita scrivi: (3.4 arrotondato), stop.
Uscita scrivi: (7.1 eccesso), stop.
Uscita scrivi: (7.9 difetto), stop.
}
correre.

Programma spazzare.

usedMemory1 := (Programma memoria ? 0).

{
2 exponent factorial.
Uscita scrivi: (11 modulo: 3), stop.
Uscita scrivi: (3.4 arrotondato), stop.
Uscita scrivi: (7.1 eccesso), stop.
Uscita scrivi: (7.9 difetto), stop.
}
correre.

Programma spazzare.
usedMemory2 := (Programma memoria ? 0).


{
2 exponent factorial.
Uscita scrivi: (11 modulo: 3), stop.
Uscita scrivi: (3.4 arrotondato), stop.
Uscita scrivi: (7.1 eccesso), stop.
Uscita scrivi: (7.9 difetto), stop.
} correre.

Programma spazzare.
usedMemory3 := (Programma memoria ? 0).



( usedMemory1 = usedMemory2 e: usedMemory1 = usedMemory3, e: usedMemory2 = usedMemory3 ) vero: {
	Uscita scrivi: ['No memory leaks here'].
}, falso: {
	Uscita scrivi: ['Leaking memory...'].
}.
