>> mappa1 := Elenco nuovo.
>> chiave1 := Serie nuovo.
>> chiave2 := Serie nuovo.

mappa1
	met: ['hello'] a: chiave1,
	met: ['world'] a: chiave2.


Uscita
	scrivi: ['Map #1 contains: '] + (mappa1 a: chiave1),
	scrivi: [' e '] + (mappa1 a: chiave2), stop.

>> ArrayConChiavi := Serie nuovo.
ArrayConChiavi on: ['inTesto'] fare: { <- (io contare) inTesto.
}.

>> map2 := Elenco nuovo.
chiave1 := ArrayConChiavi nuovo.
chiave2 := ArrayConChiavi nuovo.

chiave1 aggiungere: 1.

map2
	met: ['hello'] a: chiave1,
	met: ['world'] a: chiave2.

Uscita
	scrivi: ['Map #2 contains: '] + (map2 a: chiave1),
	scrivi: [' e '] + (map2 a: chiave2), stop.
