>> map1 := Elenco nuovo.
>> key1 := Serie nuovo.
>> key2 := Serie nuovo.

map1
	met: ['hello'] a: key1,
	met: ['world'] a: key2.


Uscita
	scrivi: ['Map #1 contains: '] + (map1 a: key1),
	scrivi: [' and '] + (map1 a: key2), stop.

>> KeyeableArray := Serie nuovo.
KeyeableArray on: ['toString'] fare: { <- (io contare) toString.
}.

>> map2 := Elenco nuovo.
key1 := KeyeableArray nuovo.
key2 := KeyeableArray nuovo.

key1 aggiungere: 1.

map2
	met: ['hello'] a: key1,
	met: ['world'] a: key2.

Uscita
	scrivi: ['Map #2 contains: '] + (map2 a: key1),
	scrivi: [' and '] + (map2 a: key2), stop.
