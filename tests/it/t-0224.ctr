
>> paesi := Serie nuovo
	~ ['Svizzera']
	~ ['Italia']
	~ ['Germania'].

>> cibi := Serie nuovo
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Crauti'].


>> contatore := 0.
cibi di: paesi, ogni: { :key :value
	contatore inserisci: 1.
}.

Uscita scrivi: (['we serve counter dishes'] counter: contatore), stop.

>> contatore := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] caratteri ord: { :v
	contatore inserisci: 0.
}.

Uscita scrivi: (['we sort counter dishes'] counter: contatore), stop.


>> contatore := 0.
{
	{
		contatore inserisci: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Uscita scrivi: (['we calculate counter numbers.'] counter: contatore), stop.

