
>> countries := Serie nuovo
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Serie nuovo
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods di: countries, ogni: { :key :value
	counter inserisci: 1.
}.

Uscita scrivi: (['we serve counter dishes'] counter: counter), stop.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] caratteri ord: { :v
	counter inserisci: 0.
}.

Uscita scrivi: (['we sort counter dishes'] counter: counter), stop.


>> counter := 0.
{
	{
		counter inserisci: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Uscita scrivi: (['we calculate counter numbers.'] counter: counter), stop.

