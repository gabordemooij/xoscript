>> x := Oggetto nuovo.
>> y := Oggetto nuovo.
>> z := x.
Uscita scrivi: (x = z), stop.
Uscita scrivi: (x = y), stop.
Uscita scrivi: (x ≠ y), stop.
Uscita scrivi: (x ≠ z), stop.
>> m := Momento nuovo anno: 2070, mese: 11.
>> n := m copia.
Uscita scrivi: (m = n), stop.
Uscita scrivi: (m ≠ n), stop.
Uscita scrivi: (m equivale: m), stop.
Uscita scrivi: (m equivale: n), stop.
n mese: 12.
Uscita scrivi: (m ≠ n), stop.
Uscita scrivi: (m = n), stop.


