Testo on: ['valutare'] fare: {
	>> code := File nuovo: ['/tmp/eval.ctr'].
	code scrivi: (io testo + ['.']).
	Programma uso: ['/tmp/eval.ctr'].
}.

>> a := Serie ← 1 ; 2 ; 3.
>> b := (a testo).

Uscita scrivi: b, stop. 
(['b := '] + b) valutare.

Uscita scrivi: b ? 2, stop. 

Uscita scrivi: (( Serie ← 1 ; 2 ; 3 )), stop. 

Uscita scrivi: ((Elenco nuovo) met: 1 a: 2), stop. 

>> x := ( (Serie ← 1 ; ( Serie ← 9 ) ; Vero ) ) testo.
Uscita scrivi: x, stop. 
(['x := '] + x) valutare.

Uscita scrivi: x ? 1 ? 0, stop. 

>> y := (Elenco nuovo) met: (Serie ← 1) a: (Serie ← 2).
Uscita scrivi: y, stop. 

(['y := '] + y) testo valutare.

Uscita scrivi: (y a: (Serie ← 2) testo ), stop.

Uscita scrivi: (Serie nuovo), stop. 
Uscita scrivi: (Elenco nuovo), stop. 
