Uscita scrivi: ['Oggetto di test'], stop.
>> a := Oggetto nuovo. 
a on: ['item:'] fare: { :lst
	mio lst := lst. 
}.
a on: ['articolo'] fare: {
	<- mio lst.
}.
a item: (
	Serie nuovo ; 1 ; (
		Serie nuovo ; ['a'] ; (
			Serie nuovo ; ( Momento nuovo: 1 )
		) ; ( Int64 da-testo: ['321'] )
	)
).
Uscita scrivi: a articolo, stop.
>> vecchio-indirizzo-lst := a articolo prototipo indirizzo-di-memoria.
a save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RICARICAMENTO SNAP:'], stop.
>> b := Oggetto load-from: ['/tmp/a.bin'].
(b articolo prototipo indirizzo-di-memoria = vecchio-indirizzo-lst) vero: {
	Uscita scrivi: ['Collegamento all'oggetto ricollegato.'], stop.
}.
Uscita scrivi: ( b articolo ), stop.
