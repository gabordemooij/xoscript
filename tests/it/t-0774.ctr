Uscita scrivi: ['Test object'], stop.
>> a := Oggetto nuovo. 
a on: ['item:'] fare: { :lst
	mio lst := lst. 
}.
a on: ['item'] fare: { <- mio lst.
}.
a item: (
	Serie nuovo ; 1 ; (
		Serie nuovo ; ['a'] ; (
			Serie nuovo ; ( Momento nuovo: 1 )
		) ; ( Int64 da-testo: ['321'] )
	)
).
Uscita scrivi: a item, stop.
>> old-lst-address := a item prototipo indirizzo-di-memoria.
a save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RELOADING SNAP:'], stop.
>> b := Oggetto load-from: ['/tmp/a.bin'].
(b item prototipo indirizzo-di-memoria = old-lst-address) vero: {
	Uscita scrivi: ['Object link re-attached.'], stop.
}.
Uscita scrivi: ( b item ), stop.
