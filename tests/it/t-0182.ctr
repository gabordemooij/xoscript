

>> memoriaUsata1 := 0.
>> memoriaUsata2 := 0.
>> memoriaUsata3 := 0.
>> memoriaUsata4 := 0.

Programma gcmode: 0.

>> txt := ['1.6'].
>> n := txt numero.
>> t := txt booleano.
Uscita scrivi: n, stop.
Uscita scrivi: t, stop.
Uscita scrivi: n genere, stop.
Uscita scrivi: t genere, stop.

Programma spazzare.

memoriaUsata1 := (Programma memoria ? 0).


txt := ['1.6'].
n := txt numero.
t := txt booleano.
Uscita scrivi: n, stop.
Uscita scrivi: t, stop.
Uscita scrivi: n genere, stop.
Uscita scrivi: t genere, stop.

Programma spazzare.
memoriaUsata2 := (Programma memoria ? 0).


txt := ['1.6'].
n := txt numero.
t := txt booleano.
Uscita scrivi: n, stop.
Uscita scrivi: t, stop.
Uscita scrivi: n genere, stop.
Uscita scrivi: t genere, stop.

Programma spazzare.
memoriaUsata3 := (Programma memoria ? 0).



( memoriaUsata1 = memoriaUsata2 e: memoriaUsata1 = memoriaUsata3, e: memoriaUsata2 = memoriaUsata3 ) vero: {
	Uscita scrivi: ['Nessuna perdita di memoria qui'].
}, falso: {
	Uscita scrivi: ['Perdita di memoria...'].
}.
