# test dei buffer PKI/firma 
Server init.

>> lungo := ( Serie nuovo riempire: 1000 con: ['a'] ) aderire: [''].

# firma un messaggio
Uscita scrivi: ( 
	Caveau firma: ['abc'] con: lungo
), stop.

Uscita scrivi: ( 
	Caveau
		verifica: ['abc'] 
		firma: lungo 
		con: lungo
), stop.

Uscita scrivi: (
	Caveau hash-password: lungo verifica: lungo
), stop.
