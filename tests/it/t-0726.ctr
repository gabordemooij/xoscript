# test buffers PKI/Sign 
Server init.

>> long := ( Serie nuovo riempire: 1000 con: ['a'] ) aderire: [''].

# sign a message
Uscita scrivi: ( 
	Caveau firma: ['abc'] con: long
), stop.

Uscita scrivi: ( 
	Caveau
		verifica: ['abc'] 
		firma: long 
		con: long
), stop.

Uscita scrivi: (
	Caveau hash-password: long verifica: long
), stop.
