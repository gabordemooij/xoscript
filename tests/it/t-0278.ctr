>> Da-Fare := Oggetto nuovo.

Da-Fare on: ['nuovo'] fare: {
	mio list := Serie nuovo.
}.

Da-Fare on: ['nieuw'] fare: {
	mio list := Serie nuovo.
}.

Da-Fare on: ['+'] fare: { :incarico
	mio list aggiungere: incarico.
}.

Da-Fare on: ['number of tasks?'] fare: { <-  mio list contare.
}.

>> cose-da-fare := 
	Da-Fare nuovo 
	+ ['preparare la cena'] 
	+ ['pulire la stanza'].
	
Uscita scrivi: ['You have $ tasks to do'] $ cose-da-fare number of tasks?.
