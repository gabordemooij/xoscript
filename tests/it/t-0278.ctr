>> To-Do := Oggetto nuovo.

To-Do on: ['nuovo'] fare: {
	mio list := Serie nuovo.
}.

To-Do on: ['nieuw'] fare: {
	mio list := Serie nuovo.
}.

To-Do on: ['+'] fare: { :task
	mio list aggiungere: task.
}.

To-Do on: ['number of tasks?'] fare: { <-  mio list contare.
}.

>> todos := 
	To-Do nuovo 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Uscita scrivi: ['You have $ tasks to do'] $ todos number of tasks?.
