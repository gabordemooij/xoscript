

>> Matryoshka := Oggetto nuovo.
Matryoshka on: ['double:'] fare: { :secret
	mio secret := secret × 2.
}.
Matryoshka on: ['nuovo:'] fare: { :secret
	>> answer := Nil.
	>> t := (secret > 255).
	Uscita scrivi: (secret + [' | '] + t), stop.
	t vero: {
		answer := secret.
	}, altro: {
		answer := Matryoshka ricorsivo nuovo: (io double: secret).
	}. <- answer.
}.

>> x := Matryoshka nuovo: 2.
