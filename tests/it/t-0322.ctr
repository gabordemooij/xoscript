

>> Matrioska := Oggetto nuovo.
Matrioska on: ['double:'] fare: { :segreto
	mio segreto := segreto × 2.
}.
Matrioska on: ['nuovo:'] fare: { :segreto
	>> responso := Nil.
	>> t := (segreto > 255).
	Uscita scrivi: (segreto + [' | '] + t), stop.
	t vero: {
		responso := segreto.
	}, altro: {
		responso := Matrioska ricorsivo nuovo: (io double: segreto).
	}. <- responso.
}.

>> x := Matrioska nuovo: 2.
