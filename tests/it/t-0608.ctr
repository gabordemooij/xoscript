
>> Size := Oggetto nuovo.
Size on: ['is:'] fare: { :numero
	numero on: ['+'] fare: { :numero
		>> unit := numero qual.
		>> factor := 1.
		
		unit
		caso: ['inch'] fare: { factor := 0.0833. }. <- io + (numero * factor).
	}. <- numero.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Uscita scrivi: plank + edge, stop.
