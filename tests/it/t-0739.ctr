Uscita scrivi: ['Test object'], stop.
>> a := Oggetto nuovo. 

a on: ['item:'] fare: { :binhelper
	mio binhelper := binhelper. 
}.

a on: ['item'] fare: { <- mio binhelper.
}.

a item: Bin nuovo.

>> old-binhelper-address := a item prototipo indirizzo-di-memoria.
a save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RELOADING SNAP:'], stop.

>> b := Oggetto load-from: ['/tmp/a.bin'].

(b item prototipo indirizzo-di-memoria = old-binhelper-address) vero: {
	Uscita scrivi: ['Object link re-attached.'], stop.
}.


