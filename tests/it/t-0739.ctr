Uscita scrivi: ['Oggetto di test'], stop.
>> a := Oggetto nuovo. 

a on: ['item:'] fare: { :aiutantebin
	mio aiutantebin := aiutantebin. 
}.

a on: ['articolo'] fare: {
	<- mio aiutantebin.
}.

a item: Bin nuovo.

>> vecchio-indirizzo-aiutantebin := a articolo prototipo indirizzo-di-memoria.
a save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RICARICAMENTO SNAP:'], stop.

>> b := Oggetto load-from: ['/tmp/a.bin'].

(b articolo prototipo indirizzo-di-memoria = vecchio-indirizzo-aiutantebin) vero: {
	Uscita scrivi: ['Collegamento all'oggetto ricollegato.'], stop.
}.


