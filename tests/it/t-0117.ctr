>> t := Vero.
(t = Vero) vero: { Uscita scrivi: ['T']. }.
(t = Falso) vero: { Uscita scrivi: ['F']. }.
Uscita scrivi: ['|'].
>> t := Falso.
(t = Vero) vero: { Uscita scrivi: ['T']. }.
(t = Falso) vero: { Uscita scrivi: ['F']. }.
Uscita scrivi: ['|'].
>> f := Vero.
(t = Vero e: f = Falso) vero: { Uscita scrivi: ['T']. }.
(t = Falso e: f = Vero) vero: { Uscita scrivi: ['F']. }.
Uscita scrivi: ['|'].
>> n := Nil.
(n nil?) vero: { Uscita scrivi: ['T']. }.
(n nil?) falso: { Uscita scrivi: ['F']. }.
Uscita scrivi: ['|'].
(f Boolean?) vero: { Uscita scrivi: ['T']. }.
(f Boolean?) falso: { Uscita scrivi: ['F']. }.



