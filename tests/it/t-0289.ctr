#Linux
>> SO := Programma sistema: (Istruzioni uname -s), trim.

>> Risucchio := Oggetto nuovo.
Risucchio on: ['nuovo'] fare: {
	mio str := [''].
}.
Risucchio on: ['rispondere:'] fare: { :blah
		(mio str ≠ ['']) vero: {
			mio str aggiungere: [' '].
		}.
		mio str aggiungere: blah.
}.
Risucchio on: ['rispondere:e:'] fare: { :blah :blahah
		(mio str ≠ ['']) vero: {
			mio str aggiungere: [' '].
		}.
		(blah lunghezza > 1) vero: {
			mio str aggiungere: (blah da: 0 lunghezza: (blah lunghezza - 1)).
		}, altro: {
			mio str aggiungere: blah.
		}.
		mio str aggiungere: [' '].
		mio str aggiungere: blahah.
}.
Risucchio on: ['ricava'] fare: {
	>> buffer := mio str.
	mio str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text aggiungere: ['hello'].
} × 1000.


Uscita scrivi: (
	Programma sistema: (
		Risucchio nuovo
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: SO)
		) ricava
).

