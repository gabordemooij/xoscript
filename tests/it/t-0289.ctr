#Linux
>> OS := Programma sistema: (Istruzioni uname -s), trim.

>> Slurp := Oggetto nuovo.
Slurp on: ['nuovo'] fare: {
	mio str := [''].
}.
Slurp on: ['rispondere:'] fare: { :blah
		(mio str ≠ ['']) vero: {
			mio str aggiungere: [' '].
		}.
		mio str aggiungere: blah.
}.
Slurp on: ['rispondere:e:'] fare: { :blah :blahah
		(mio str ≠ ['']) vero: {
			mio str aggiungere: [' '].
		}.
		(blah lunghezza > 1) vero: {
			mio str aggiungere: (blah da: 0 lunghezza: (blah lunghezza - 1)).
		}, altro: {
			mio str aggiungere: blah.
		}.
		mio str aggiungere: [' '].
		mio str aggiungere: blahah.
}.
Slurp on: ['obtain'] fare: {
	>> buffer := mio str.
	mio str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text aggiungere: ['hello'].
} × 1000.


Uscita scrivi: (
	Programma sistema: (
		Slurp nuovo
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

