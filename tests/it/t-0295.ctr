
>> dictionary := (
	Elenco nuovo
		met: ['b'] a: ['a'],
		met: ['a'] a: ['b'],
		met: ['z'] a: ['x'],
		met: ['hello'] a: ['hallo'],
		met: ['human'] a: ['human']
).

>> comparisons := Serie nuovo.
dictionary ogni: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a confrontare: b)
	).
}.

comparisons ord: { :a :b <- ( a confrontare: b ). }.
Uscita scrivi: ( comparisons aderire: ['↵'] ), stop.
comparisons aderire: ['↵'].
