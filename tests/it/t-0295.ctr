
>> dizionario := (
	Elenco nuovo
		met: ['b'] a: ['a'],
		met: ['a'] a: ['b'],
		met: ['z'] a: ['x'],
		met: ['hello'] a: ['hallo'],
		met: ['umano'] a: ['umano']
).

>> confronti := Serie nuovo.
dizionario ogni: { :a :b
	confronti ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a confrontare: b)
	).
}.

confronti ord: { :a :b <- ( a confrontare: b ). }.
Uscita scrivi: ( confronti aderire: ['↵'] ), stop.
confronti aderire: ['↵'].
