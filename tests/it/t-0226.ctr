# Test ASCII variants

# Numbers

Uscita scrivi: (2 !=: 3), stop.
Uscita scrivi: (2 <=: 2), stop.
Uscita scrivi: (2 >=: 2), stop.

# Strings

Uscita scrivi: (['b'] >=: ['a']), stop.
Uscita scrivi: (['b'] !=: ['a']), stop.
Uscita scrivi: (['b'] <=: ['c']), stop.

# Bools

Uscita scrivi: (Vero !=: Falso), stop.

# Objects

Uscita scrivi: (Oggetto nuovo !=: Oggetto nuovo), stop.

# ASCII list symbol <-:

Uscita scrivi: (Serie <<: 1, ; 2 ; 3) contare = 3, stop.

