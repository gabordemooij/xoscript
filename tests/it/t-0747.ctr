Uscita scrivi: ['Test object'], stop.
>> a := Oggetto nuovo. 

a on: ['item:'] fare: { :num
	mio num := num. 
}.

a on: ['item'] fare: { <- mio num.
}.

a item: 123.

Uscita scrivi: a item, stop.

>> old-num-address := a item prototipo indirizzo-di-memoria.
a save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RELOADING SNAP:'], stop.

>> b := Oggetto load-from: ['/tmp/a.bin'].

(b item prototipo indirizzo-di-memoria = old-num-address) vero: {
	Uscita scrivi: ['Object link re-attached.'], stop.
}.

Uscita scrivi: b item, stop.
