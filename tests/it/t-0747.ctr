Uscita scrivi: ['Oggetto di test'], stop.
>> a := Oggetto nuovo. 

a on: ['item:'] fare: { :num
	mio num := num. 
}.

a on: ['articolo'] fare: {
	<- mio num.
}.

a item: 123.

Uscita scrivi: a articolo, stop.

>> vecchio-indirizzo-num := a articolo prototipo indirizzo-di-memoria.
a save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RICARICAMENTO SNAP:'], stop.

>> b := Oggetto load-from: ['/tmp/a.bin'].

(b articolo prototipo indirizzo-di-memoria = vecchio-indirizzo-num) vero: {
	Uscita scrivi: ['Collegamento all'oggetto ricollegato.'], stop.
}.

Uscita scrivi: b articolo, stop.
