#Linux
>> OS := Programma instelling: ['OS'].

>> clock := Momento nuovo.
	
(OS = ['Haiku']) vero: {
	clock zona: ['CET'],
	anno: 2017, mese: 7, giorno: 13,
	ora: 18, minuto: 0, secondo: 0.
}, altro: {
	clock zona: ['Europe/Amsterdam'],
	anno: 2017, mese: 7, giorno: 13,
	ora: 18, minuto: 0, secondo: 0.
}.

clock on: ['tell'] fare: {
	Uscita scrivi: io, stop.
}.


clock inserisci: 2    ora, tell.
clock inserisci: 1    ora, tell.
clock inserisci: 19 minuto, tell.
clock inserisci: 1  minuto, tell.
clock inserisci: 1  minuto, tell.
clock inserisci: 19 secondo, tell.
clock inserisci: 1  secondo, tell.
clock inserisci: 1  secondo, tell.
clock inserisci: 2    anno, tell.
clock inserisci: 1    anno, tell.

(OS = ['Haiku']) vero: {
clock inserisci: 5   mese.
clock zona: ['CEST'], tell.
}, altro: {
	clock inserisci: 5   mese, tell.
}.

clock inserisci: 1   mese, tell.
clock inserisci: 19    giorno, tell.
clock inserisci: 1    ora, tell.
clock inserisci: 120  yard, tell.
