#Linux
>> SO := Programma instelling: ['SO'].

>> orologio := Momento nuovo.
	
(SO = ['Haiku']) vero: {
	orologio zona: ['CET'],
	anno: 2017, mese: 7, giorno: 13,
	ora: 18, minuto: 0, secondo: 0.
}, altro: {
	orologio zona: ['Europe/Amsterdam'],
	anno: 2017, mese: 7, giorno: 13,
	ora: 18, minuto: 0, secondo: 0.
}.

orologio on: ['annuncia'] fare: {
	Uscita scrivi: io, stop.
}.


orologio inserisci: 2    ora, annuncia.
orologio inserisci: 1    ora, annuncia.
orologio inserisci: 19 minuto, annuncia.
orologio inserisci: 1  minuto, annuncia.
orologio inserisci: 1  minuto, annuncia.
orologio inserisci: 19 secondo, annuncia.
orologio inserisci: 1  secondo, annuncia.
orologio inserisci: 1  secondo, annuncia.
orologio inserisci: 2    anno, annuncia.
orologio inserisci: 1    anno, annuncia.

(SO = ['Haiku']) vero: {
orologio inserisci: 5   mese.
orologio zona: ['CEST'], annuncia.
}, altro: {
	orologio inserisci: 5   mese, annuncia.
}.

orologio inserisci: 1   mese, annuncia.
orologio inserisci: 19    giorno, annuncia.
