# test dei qualificatori

Programma spazzare.

>> Frutto := Oggetto nuovo.
Frutto on: ['nuovo'] fare: {
	>> f := io nuovo.
	f apples: 0. <- f.
}.
Frutto on: ['apples:'] fare: { :a mio mele := a. }.
Frutto on: ['mele'] fare: { <- mio mele. }.
Frutto on: ['+'] fare: { :f
	>> n := Frutto nuovo.
	n apples: (f mele + mio mele). <- n.
}.
Numero on: ['mele'] fare: { <- ((Frutto nuovo) apples: io).
}.

Frutto on: ['testo'] fare: { <- mio mele + [' mele '].
}.

>> q := 3 mele + 4 mele.
Uscita scrivi: q, stop.




q := 3 mele + 4 mele.
Uscita scrivi: q, stop.



q := 3 mele + 4 mele.
Uscita scrivi: q, stop.


