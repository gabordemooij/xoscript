# test qualifiers

Programma spazzare.

>> Fruit := Oggetto nuovo.
Fruit on: ['nuovo'] fare: {
	>> f := io nuovo.
	f apples: 0. <- f.
}.
Fruit on: ['apples:'] fare: { :a mio apples := a. }.
Fruit on: ['apples'] fare: { <- mio apples. }.
Fruit on: ['+'] fare: { :f
	>> n := Fruit nuovo.
	n apples: (f apples + mio apples). <- n.
}.
Numero on: ['apples'] fare: { <- ((Fruit nuovo) apples: io).
}.

Fruit on: ['testo'] fare: { <- mio apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Uscita scrivi: q, stop.




q := 3 apples + 4 apples.
Uscita scrivi: q, stop.



q := 3 apples + 4 apples.
Uscita scrivi: q, stop.


