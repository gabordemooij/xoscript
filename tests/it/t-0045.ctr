Programma gcmode: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } catturare: {
		oops inserisci: 1.
	}, correre.
} × 1000.

{
	Uscita scrivi: ['hi there!'].
	questo-compito errore: ['oops'].
	Uscita scrivi: ['hi there!'].
	{ Uscita scrivi: ['dont print this']. } correre.
} catturare: { :e 
	Uscita scrivi: ['got ya!']. 
	Uscita scrivi: e.
}, correre.
