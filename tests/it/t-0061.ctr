>> a := ['hello'].
>> b := ['hello'].
>> z := a.
>> c := Nil.
>> q := Oggetto nuovo.
>> p := q.
(a equivale: a) vero: { Uscita scrivi: ['Y1']. }.
(a equivale: b) vero: { Uscita scrivi: ['Y2']. }.
(a equivale: c) vero: { Uscita scrivi: ['Y3']. }.
(a equivale: z) vero: { Uscita scrivi: ['Y4']. }.
(z equivale: a) vero: { Uscita scrivi: ['Y5']. }.
