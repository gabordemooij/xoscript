

Testo on: ['valutare'] fare: {
	>> code := File nuovo: ['/tmp/eval.ctr'].
	code scrivi: (io testo + ['.']).
	Programma uso: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Serie ← (['Le virgolette '] + Q + [' sono malvagie?']) ; 1.
>> x := q testo.
Uscita scrivi: x, stop.
>> y := Nil.
(['y := '] + x ) valutare.
Uscita scrivi: y ? 0, stop.

q := Elenco met: ['\[''] a: ['\['quote\']'].
x := q testo.
Uscita scrivi: x, stop.
y := Nil.
(['y := '] + x ) valutare.

>> q := (Elenco nuovo) met:['\[''] a:['\['quote\[''].
Uscita scrivi: y ? ['\['quote\']'], stop.
