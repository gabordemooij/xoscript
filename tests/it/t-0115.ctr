{
	{
		questo-compito errore: ['Non fallire.'].
		Vero interrompere.
		Uscita scrivi: ['FALLITO'].
	} catturare: { :x
		(x = ['Non fallire.']) vero: { questo-compito errore: ['Catturato annidato!']. }.
	}, correre.
} catturare: { :e
	Uscita scrivi: e.
}, correre.
