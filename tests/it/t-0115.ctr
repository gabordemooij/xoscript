{
	questo-compito errore: ['Dont fail.'].
	unknown doSomething.
} catturare: {
	Uscita scrivi: ['Caught!'].
}, correre.

{
	questo-compito errore: ['Dont fail.'].
	mio unknown doSomething.
} catturare: {
	Uscita scrivi: ['Caught!'].
}, correre.

{
	questo-compito errore: ['Dont fail.'].
	unknown := 122.
} catturare: {
	Uscita scrivi: ['Caught!'].
}, correre.


{
	questo-compito errore: ['Dont fail.'].
	Vero interrompere.
	Uscita scrivi: ['FAIL'].
} catturare: {
	Uscita scrivi: ['Caught!'].
}, correre.

{
	{
		questo-compito errore: ['Dont fail.'].
		Vero interrompere.
		Uscita scrivi: ['FAIL'].
	} catturare: { :x
		(x = ['Dont fail.']) vero: { questo-compito errore: ['Nested Caught!']. }.
	}, correre.
} catturare: { :e
	Uscita scrivi: e.
}, correre.
