>> a := Serie ← Oggetto ; Vero ; Falso ; Booleano ; 1 ; Numero ; ['Str'] ; Testo ; { ['Empty']. }.
Uscita scrivi: (a contare), stop.
{ :i
	Uscita scrivi: 
	['a '] + 
	((a ? i) genere) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) nil?) o: [''] o: ['NOT']) + 
	[' Nil.'],
	stop.
} × (a contare).
Uscita scrivi: ['but.. Nil is.. '] + ((Nil nil?) o: ['certainly NIL!'] o: ['not NIL??']), stop.