# compliance test

# use international numbers

Uscita scrivi: ['1000 -> '].
Uscita scrivi: 1000, stop. #1000

Uscita scrivi: ['1.5 -> '].
Uscita scrivi: 1.5, stop.  #1.5

Uscita scrivi: ['1001.5 -> '].
Uscita scrivi: 1.5 + 1000, stop. #1001.5

# use 0-indexed arrays
>> x := Serie nuovo ; 1 ; 2 ; 3.
>> y := Serie nuovo ; ['a'] ; ['b'] ; ['c'].

Uscita scrivi: ['1 -> '].
Uscita scrivi: x ? 0, stop. #1

Uscita scrivi: ['1 -> '].
Uscita scrivi: (x a: 0), stop. #1

Uscita scrivi: ['1 -> '].
Uscita scrivi: x primo, stop. #1

Uscita scrivi: ['3 -> '].
Uscita scrivi: x scorso, stop. #3

Uscita scrivi: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Uscita scrivi: (x di: y), stop.

Uscita scrivi: ['1 -> '].
Uscita scrivi: (x da: 0 lunghezza: 1) primo, stop. #1

Uscita scrivi: ['0 -> '].
Uscita scrivi: (x trova: 1), stop. #0

x met: 9 a: 0.

Uscita scrivi: ['9 -> '].
Uscita scrivi: (x a: 0), stop. #9

x anteporre: 8.
Uscita scrivi: ['8 -> '].
Uscita scrivi: (x a: 0), stop. #9


x aggiungere: 10.
Uscita scrivi: ['10 -> '].
Uscita scrivi: (x a: 4), stop. #10








