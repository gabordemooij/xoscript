# una formattazione deve adattarsi al tipo del valore, il tipo può venire da un client
>> prova := { :formattazione :value
	{ Uscita scrivi: ( (Formato nuovo: formattazione) applica: value ), stop. } catturare: { :e Uscita scrivi: e, stop. }, correre.
}.
>> prova-intero := { :formattazione :value
	{ Uscita scrivi: ( (Formato nuovo: formattazione) applica-int: value ), stop. } catturare: { :e Uscita scrivi: e, stop. }, correre.
}.

# va bene
prova applica: ['|%s|'] e: ['text'].
prova applica: ['%06.2f'] e: 5.5.
prova applica: ['100%% %s'] e: ['certo'].
prova-intero applica: ['%03d'] e: 7.
prova-intero applica: ['%x'] e: 255.
prova applica: ['%d'] e: (Int64 nuovo da-testo: ['12']).
prova applica: ['%lld'] e: (Int64 nuovo da-testo: ['12']).
prova applica: ['%.1lf'] e: 5.5.
prova-intero applica: ['%hd'] e: 7.

# non va bene
prova applica: ['%s'] e: 12345.
prova applica: ['%d'] e: 12345.
prova applica: ['%f'] e: ['text'].
prova-intero applica: ['%d'] e: ['text'].
prova-intero applica: ['%s'] e: 5.
prova applica: ['%s %s'] e: ['text'].
prova applica: ['%n'] e: ['text'].
prova applica: ['%*s'] e: ['text'].
prova applica: ['%'] e: ['text'].

# il modificatore di lunghezza non va bene
prova applica: ['%ls'] e: ['text'].
prova applica: ['%Lf'] e: 5.5.
prova-intero applica: ['%ld'] e: 7.
prova-intero applica: ['%lld'] e: 7.
prova applica: ['%Ld'] e: (Int64 nuovo da-testo: ['12']).

# una larghezza che non va bene per printf deve dare un errore, non un crash
prova applica: ['%99999999999s'] e: ['text'].
