>> randomizer := { :a :b
	>> minimo := ( a < b ) o: a o: b.
	>> massimo := ( a > b ) o: a o: b.
	>> x := Nil.
	{
		x := Numero tra: a e: b.
		((x < minimo) o: (x > massimo)) vero: { 
			Uscita scrivi: (['Invalid value!']).
			Programma fine.
		}.
	} 
	× 100. <- x.
}.
