Uscita scrivi: ['Test object'], stop.
>> a := Oggetto nuovo. 

a on: ['item:'] fare: { :nil
	mio nil := nil. 
}.

a on: ['item'] fare: { <- mio nil.
}.

a item: Nil.

Uscita scrivi: a item, stop.

>> old-nil-address := a item prototipo indirizzo-di-memoria.
a save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RELOADING SNAP:'], stop.

>> b := Oggetto load-from: ['/tmp/a.bin'].

(b item prototipo indirizzo-di-memoria = old-nil-address) vero: {
	Uscita scrivi: ['Object link re-attached.'], stop.
}.

Uscita scrivi: b item, stop.
