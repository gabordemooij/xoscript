Uscita scrivi: ['Oggetto di test'], stop.
>> a := Oggetto nuovo. 

a on: ['item:'] fare: { :nil
	mio nil := nil. 
}.

a on: ['articolo'] fare: {
	<- mio nil.
}.

a item: Nil.

Uscita scrivi: a articolo, stop.

>> vecchio-indirizzo-nil := a articolo prototipo indirizzo-di-memoria.
a save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RICARICAMENTO SNAP:'], stop.

>> b := Oggetto load-from: ['/tmp/a.bin'].

(b articolo prototipo indirizzo-di-memoria = vecchio-indirizzo-nil) vero: {
	Uscita scrivi: ['Collegamento all'oggetto ricollegato.'], stop.
}.

Uscita scrivi: b articolo, stop.
