>> HTML := Oggetto nuovo.
HTML on: ['rispondere:'] fare: { :tag 
	Uscita scrivi: (['<tag>'] tag: tag), stop.
}.
HTML on: ['rispondere:e:'] fare: { :tag :html 
	Uscita scrivi: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), stop.
}.
>> html := HTML nuovo.
html body h1: ['header'].

