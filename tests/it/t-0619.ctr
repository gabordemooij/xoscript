>> HTML := Oggetto nuovo.
HTML on: ['rispondere:'] fare: { :etichetta 
	Uscita scrivi: (['<tag>'] tag: etichetta), stop.
}.
HTML on: ['rispondere:e:'] fare: { :etichetta :html 
	Uscita scrivi: (
		['<tag>innerHTML</tag>']
		tag: etichetta - [':'],
		innerHTML: html
	), stop.
}.
>> html := HTML nuovo.
html body h1: ['header'].

