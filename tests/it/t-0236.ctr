>> Slurp := Oggetto nuovo.
Slurp on: ['nuovo'] fare: {
	mio str := [''].
}.


Slurp on: ['rispondere:'] fare: { :blah
		(mio str ≠ ['']) vero: {
			mio str aggiungere: [' '].
		}.
		mio str aggiungere: blah.
}.
Slurp on: ['rispondere:e:'] fare: { :blah :blahah
		(mio str ≠ ['']) vero: {
			mio str aggiungere: [' '].
		}.
		(blah lunghezza > 1) vero: {
			mio str aggiungere: (blah da: 0 lunghezza: (blah lunghezza - 1)).
		}, altro: {
			mio str aggiungere: blah.
		}.
		mio str aggiungere: [' '].
		mio str aggiungere: blahah.
}.
Slurp on: ['obtain'] fare: {
	>> buffer := mio str.
	mio str := ['']. <- buffer.
}.

>> parametri := Slurp nuovo.
parametri select: ['*'], from users where: ['id = 2'].
Uscita scrivi: (parametri obtain), stop.
