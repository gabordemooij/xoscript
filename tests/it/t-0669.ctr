# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Caveau 
	hash-password: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Caveau 
	hash-password: hash verifica: a1.
	# fail 
>> b := Caveau
	hash-password: hash verifica: a2.
	# ok!

Uscita scrivi: a, stop.
Uscita scrivi: b, stop.

