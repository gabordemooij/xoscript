# Hashing delle password
Server init.

# L'utente imposta una password
>> psw := ['pass123'].

# La salvi così
>> hash := Caveau 
	hash-password: psw.

# Poi l'utente accede
# Tentativo 1
>> a1 := ['abcd123'].
# Tentativo 2
>> a2 := ['pass123'].

# Verifica
>> a := Caveau 
	hash-password: hash verifica: a1.
	# fallito 
>> b := Caveau
	hash-password: hash verifica: a2.
	# ok!

Uscita scrivi: a, stop.
Uscita scrivi: b, stop.

