# chiavi e firme del caveau che decodificano troppo lunghe non devono far traboccare lo stack
Server init.

>> chiavi := Caveau chiavi-crittografiche.
>> sk := chiavi primo.
>> pk := chiavi scorso.
>> firma := Caveau firma: ['abc'] con: sk.

# 88 caratteri senza padding decodificano in 66 byte
>> lungo := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 caratteri senza padding decodificano in 33 byte
>> corto := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Caveau firma: ['abc'] con: lungo. } catturare: { :e
	Uscita scrivi: e, stop.
}, correre.

{ Caveau verifica: ['abc'] firma: lungo con: pk. } catturare: { :e
	Uscita scrivi: e, stop.
}, correre.

{ Caveau verifica: ['abc'] firma: firma con: corto. } catturare: { :e
	Uscita scrivi: e, stop.
}, correre.
