# catch-all test (practical)
>> HTML := Testo nuovo.
HTML on: ['encode:'] fare: { :tekst
	io aggiungere: (tekst
	sostituirlo: ['&'] con: ['&amp;'], 
	sostituirlo: ['<'] con: ['&lt;'],
	sostituirlo: ['>'] con: ['&gt;'],
	sostituirlo: ['"'] con: ['&quot;']).
}.
>> blog := HTML nuovo.
blog aggiungere: ['<h1>'],
     encode: ['Koffie & Thee'],
     aggiungere: ['</h1>'].
Uscita scrivi: blog, stop.


>> Roman := Numero nuovo.
Roman on: ['stringy'] fare: {
	>> a := [''].
	{ a aggiungere: ['I']. } × io. <- a.
}.

>> x := Roman nuovo.
x inserisci: 3.
Uscita scrivi: x stringy, stop.

>> Quantum := Booleano nuovo.
Quantum on: ['true?'] fare: { <- ['maybe True']. }.
Uscita scrivi: (Quantum nuovo true?), stop.

>> Nihil := Nil nuovo.
Nihil on: ['testo'] fare: { <- ['Nihil']. }.
Uscita scrivi: (Nihil nuovo), stop.
