# test catch-all (pratico)
>> HTML := Testo nuovo.
HTML on: ['encode:'] fare: { :tekst
	io aggiungere: (tekst
	sostituirlo: ['&'] con: ['&amp;'], 
	sostituirlo: ['<'] con: ['&lt;'],
	sostituirlo: ['>'] con: ['&gt;'],
	sostituirlo: ['"'] con: ['&quot;']).
}.
>> blog := HTML nuovo.
blog aggiungere: ['<h1>'],
     encode: ['Koffie & Thee'],
     aggiungere: ['</h1>'].
Uscita scrivi: blog, stop.


>> Romano := Numero nuovo.
Romano on: ['testuale'] fare: {
	>> a := [''].
	{ a aggiungere: ['I']. } × io. <- a.
}.

>> x := Romano nuovo.
x inserisci: 3.
Uscita scrivi: x testuale, stop.

>> Quantistico := Booleano nuovo.
Quantistico on: ['true?'] fare: { <- ['forse Vero']. }.
Uscita scrivi: (Quantistico nuovo true?), stop.

>> Nihil := Nil nuovo.
Nihil on: ['testo'] fare: { <- ['Nihil']. }.
Uscita scrivi: (Nihil nuovo), stop.
