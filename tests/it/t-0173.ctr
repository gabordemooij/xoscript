

Serie on: ['sum'] fare: {
	>> total := 0.
	io ogni: { :index :element
		total inserisci: element.
	}. <- total.
}.

Serie on: ['product'] fare: {
	>> total := 1.
	io ogni: { :index :element
		total moltiplicato-per: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programma gcmode: 0.

{

>> a := Serie ← ['hello'] ; ['world'] ; Vero ; Nil ; 666.
a := a + ( Serie ← 1 ).
Uscita scrivi: ( ['sum: '] + ( a sum ) ), stop.
Uscita scrivi: ( ['min: '] + ( a minimo ) ), stop.
Uscita scrivi: ( ['max: '] + ( a massimo ) ), stop.
Uscita scrivi: ( ['3rd: '] + ( a ? 2 ) ), stop.
Uscita scrivi: ( ['prd: '] + ( a product ) ), stop.
a ord: { :a :b <- (b - a). }.
a ogni: { :i :e Uscita scrivi: ( i - 0 ), stop. }.

} correre.

Programma spazzare.
usedMemory1 := (Programma memoria ? 0).


{

>> a := Serie ← ['hello'] ; ['world'] ; Vero ; Nil ; 666.
a := a + ( Serie ← 1 ).
Uscita scrivi: ( ['sum: '] + ( a sum ) ), stop.
