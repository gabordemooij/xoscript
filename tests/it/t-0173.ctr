

Serie on: ['somma'] fare: {
	>> totale := 0.
	io ogni: { :indice :elemento
		totale inserisci: elemento.
	}. <- totale.
}.

Serie on: ['prodotto'] fare: {
	>> totale := 1.
	io ogni: { :indice :elemento
		totale moltiplicato-per: elemento.
	}. <- totale.
}.

>> memoriaUsata1 := 0.
>> memoriaUsata2 := 0.
>> memoriaUsata3 := 0.
>> memoriaUsata4 := 0.

Programma gcmode: 0.

{

>> a := Serie ← ['hello'] ; ['world'] ; Vero ; Nil ; 666.
a := a + ( Serie ← 1 ).
Uscita scrivi: ( ['somma: '] + ( a somma ) ), stop.
Uscita scrivi: ( ['min: '] + ( a minimo ) ), stop.
Uscita scrivi: ( ['max: '] + ( a massimo ) ), stop.
Uscita scrivi: ( ['3º: '] + ( a ? 2 ) ), stop.
Uscita scrivi: ( ['prod: '] + ( a prodotto ) ), stop.
a ord: { :a :b <- (b - a). }.
a ogni: { :i :e Uscita scrivi: ( i - 0 ), stop. }.

} correre.

Programma spazzare.
memoriaUsata1 := (Programma memoria ? 0).


{

>> a := Serie ← ['hello'] ; ['world'] ; Vero ; Nil ; 666.
a := a + ( Serie ← 1 ).
Uscita scrivi: ( ['somma: '] + ( a somma ) ), stop.
Uscita scrivi: ( ['min: '] + ( a minimo ) ), stop.
Uscita scrivi: ( ['max: '] + ( a massimo ) ), stop.
Uscita scrivi: ( ['3º: '] + ( a ? 2 ) ), stop.
Uscita scrivi: ( ['prod: '] + ( a prodotto ) ), stop.
a ord: { :a :b <- (b - a). }.
a ogni: { :i :e Uscita scrivi: ( i - 0 ), stop. }.

} correre.



Programma spazzare.
memoriaUsata2 := (Programma memoria ? 0).


{

>> a := Serie ← ['hello'] ; ['world'] ; Vero ; Nil ; 666.
a := a + ( Serie ← 1 ).
Uscita scrivi: ( ['somma: '] + ( a somma ) ), stop.
Uscita scrivi: ( ['min: '] + ( a minimo ) ), stop.
Uscita scrivi: ( ['max: '] + ( a massimo ) ), stop.
Uscita scrivi: ( ['3º: '] + ( a ? 2 ) ), stop.
Uscita scrivi: ( ['prod: '] + ( a prodotto ) ), stop.
a ord: { :a :b <- (b - a). }.
a ogni: { :i :e Uscita scrivi: ( i - 0 ), stop. }.

} correre.



Programma spazzare.
memoriaUsata3 := (Programma memoria ? 0).

( memoriaUsata1 = memoriaUsata2 e: memoriaUsata1 = memoriaUsata3, e: memoriaUsata2 = memoriaUsata3 ) vero: {
	Uscita scrivi: ['Nessuna perdita di memoria qui'].
}, falso: {
	Uscita scrivi: ['Perdita di memoria...'].
}.
