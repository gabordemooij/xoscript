
Uscita scrivi: ['Break for-loop, 0-4.'], stop.
{ :i
	Uscita scrivi: ['iteration #'] + i, stop.
	(i = 4) interrompere.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Uscita scrivi: ['Break while-true loop, 0-4.'], stop.
{
	Uscita scrivi: ['iteration #'] + x, stop.
	x inserisci: 1.
	((x < 5) non) interrompere.
} mentre: xIsLessThan10.

Uscita scrivi: ['Break while-false loop, 5,4.'], stop.
{
	Uscita scrivi: ['iteration #'] + x, stop.
	x sottrarre: 1.
	(x = 3) interrompere.
} mentre: { <- (x > 0). }.

Uscita scrivi: ['Break times loop, 1-4.'], stop.
{ :i
	Uscita scrivi: ['iteration #'] + i, stop.
	(i = 4) interrompere.
} × 5.

Uscita scrivi: ['Break block, dont print line.'], stop.
{ Vero interrompere. Uscita scrivi: ['dont write this!'], stop. } correre.

Uscita scrivi: ['Break block, dont fire catch...'], stop.
{ Vero interrompere. Uscita scrivi: ['dont write this!'], stop. } catturare: { Uscita scrivi: ['Dont catch this!']. }, correre.

Uscita scrivi: ['Test Array each-loop: 0,1'], stop.
(Serie ← 1 ; 2 ; 3) elenco: { :i
	Uscita scrivi: ['iteration #'] + i, stop.
	(i = 1) interrompere.
}.

Uscita scrivi: ['Test Map each-loop: c only'], stop.
>> m := Elenco nuovo.
m met: ['first'] a: ['a'], met: ['second'] a: ['b'], met: ['third'] a: ['c'].
m ogni: { :k :v
	Uscita scrivi: ['iteration'] + v + k, stop.
	Vero interrompere.
}.

