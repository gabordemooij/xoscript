
Uscita scrivi: ['Interrompi ciclo for, 0-4.'], stop.
{ :i
	Uscita scrivi: ['iteration #'] + i, stop.
	(i = 4) interrompere.
} × 10.

>> x := 0.
>> xMinoreDi10 := { <- ( x < 10 ). }.

Uscita scrivi: ['Interrompi ciclo while-true, 0-4.'], stop.
{
	Uscita scrivi: ['iteration #'] + x, stop.
	x inserisci: 1.
	((x < 5) non) interrompere.
} mentre: xMinoreDi10.

Uscita scrivi: ['Interrompi ciclo while-false, 5,4.'], stop.
{
	Uscita scrivi: ['iteration #'] + x, stop.
	x sottrarre: 1.
	(x = 3) interrompere.
} mentre: { <- (x > 0). }.

Uscita scrivi: ['Interrompi ciclo times, 1-4.'], stop.
{ :i
	Uscita scrivi: ['iteration #'] + i, stop.
	(i = 4) interrompere.
} × 5.

Uscita scrivi: ['Interrompi blocco, non stampare la riga.'], stop.
{ Vero interrompere. Uscita scrivi: ['non scrivere questo!'], stop. } correre.

Uscita scrivi: ['Interrompi blocco, non attivare catch...'], stop.
{ Vero interrompere. Uscita scrivi: ['non scrivere questo!'], stop. } catturare: { Uscita scrivi: ['Non catturare questo!']. }, correre.

Uscita scrivi: ['Test ciclo each su Serie: 0,1'], stop.
(Serie ← 1 ; 2 ; 3) elenco: { :i
	Uscita scrivi: ['iteration #'] + i, stop.
	(i = 1) interrompere.
}.

Uscita scrivi: ['Test ciclo each su Elenco: solo c'], stop.
>> m := Elenco nuovo.
m met: ['first'] a: ['a'], met: ['second'] a: ['b'], met: ['terzo'] a: ['c'].
m ogni: { :k :v
	Uscita scrivi: ['iteration'] + v + k, stop.
	Vero interrompere.
}.

