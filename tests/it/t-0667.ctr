# test Program version

# this feature is disabled by default
Uscita scrivi: (
	Programma funzionalità: 
	['RECURSIVE_STRINTPOL']
), stop.


# but if we set the time back
>> today := Momento 
zona: ['CEST'],
da: ['2026-02-15 10:00:00'].
Programma versione: today.

# it will be enabled like it used to be (from now on)
Uscita scrivi: (
	Programma funzionalità: 
	['RECURSIVE_STRINTPOL']
), stop.