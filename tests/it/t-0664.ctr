# recursive interpolation not allowed

Uscita scrivi: 
['recursive string interolation enabled: '] + (
	Programma funzionalità: 
	['RECURSIVE_STRINTPOL']
), stop.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Uscita scrivi: a, stop.


Programma funzionalità: ['RECURSIVE_STRINTPOL'] attivo: Vero.

Uscita scrivi: 
['recursive string interpolation enabled: '] + (
	Programma funzionalità: 
	['RECURSIVE_STRINTPOL']
), stop.

>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Uscita scrivi: a, stop.

Programma funzionalità: ['RECURSIVE_STRINTPOL'] attivo: Falso.

