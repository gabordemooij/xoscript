Uscita scrivi: ['Oggetto di test'], stop.
>> a := Oggetto nuovo. 

a on: ['state:'] fare: { :list
	mio list := list. 
}.

a on: ['stato'] fare: {
	Uscita scrivi: mio list, stop.
}.

a state: ( Serie nuovo ; ['elementoserie'] ; ['articolo2'] ).
a stato.

a save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RICARICAMENTO SNAP:'], stop.
>> b := Oggetto load-from: ['/tmp/a.bin'].
b stato.