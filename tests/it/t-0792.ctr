Server init.

>> DB := MariaDB nuovo host: ['localhost'],
	utente: ['xo'],
	password: ['pass123'],
	nome-database: ['xobase'],
	connetti.
	
>> SQL := ['SELECT "hello" AS "world" '].

# un modo più rapido, ottieni la query da DB:
>> query2 := DB query: SQL.

# ora non devi più impostare DB
query2 recupera: { :fila
	Uscita scrivi: fila world, stop.
}.
