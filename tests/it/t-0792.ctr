Server init.

>> DB := MariaDB nuovo host: ['localhost'],
	utente: ['xo'],
	password: ['pass123'],
	nome-database: ['xobase'],
	connetti.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB query: SQL.

# now you don't have to set DB
query2 recupera: { :row
	Uscita scrivi: row world, stop.
}.
