Uscita scrivi: ['Oggetto di test'], stop.
>> l := Serie nuovo ; 1 ; ( Serie nuovo ; (Momento nuovo: 1) ; (Int64 da-testo: ['321']) ; (Serie nuovo ; 3)).
Uscita scrivi: l, stop.
>> vecchio-indirizzo-lst := l prototipo indirizzo-di-memoria.
l save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RICARICAMENTO SNAP:'], stop.
>> b := Oggetto load-from: ['/tmp/a.bin'].
(b prototipo indirizzo-di-memoria = vecchio-indirizzo-lst) vero: {
	Uscita scrivi: ['Collegamento all'oggetto ricollegato.'], stop.
}.
Uscita scrivi: b, stop.
