Uscita scrivi: ['Test object'], stop.
>> l := Serie nuovo ; 1 ; ( Serie nuovo ; (Momento nuovo: 1) ; (Int64 da-testo: ['321']) ; (Serie nuovo ; 3)).
Uscita scrivi: l, stop.
>> old-lst-address := l prototipo indirizzo-di-memoria.
l save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RELOADING SNAP:'], stop.
>> b := Oggetto load-from: ['/tmp/a.bin'].
(b prototipo indirizzo-di-memoria = old-lst-address) vero: {
	Uscita scrivi: ['Object link re-attached.'], stop.
}.
Uscita scrivi: b, stop.
