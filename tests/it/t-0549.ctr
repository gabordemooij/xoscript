	; 1    ; 0 ; 0 ; 0
).

>> struct := Blob struttura: (
	Serie nuovo 
		; ['int']
		; ['int']
		; ['int']
		; ['int']
		; ['int']
		; ['int']
		; ['int']
		; ['int']
).


>> libname := Programma instelling: ['FFITESTLIB'].

Server collega: (
 Serie nuovo ;
 libname ;
 ['asctime'] ;
 ( Serie nuovo ; ['pointer'] ) ;
 ['pointer'] ;
 ['Time'] ;
 ['asctime:']
).

Uscita scrivi: (Time asctime: a), stop.

