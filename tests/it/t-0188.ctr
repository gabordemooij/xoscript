

>> memoriaUsata1 := 0.
>> memoriaUsata2 := 0.
>> memoriaUsata3 := 0.
>> memoriaUsata4 := 0.

Programma gcmode: 0.

{ :i Uscita scrivi: i. } × 4.
Uscita stop.
{ :i Uscita scrivi: (4 - i). } × 4.
Uscita stop.
( 1 > 2 ) falso: { Uscita scrivi: ['BLOCCO 1'], stop. }.
( 2 > 1 ) vero:  { Uscita scrivi: ['BLOCCO 2'], stop. }.

>> i := 0.
{ Uscita scrivi: i. i inserisci: 1. } mentre: { <- ( i < 3). }.
Uscita stop.

i := 3.
{ Uscita scrivi: i. i := i - 1. } mentre: { <- ( i > 0). }.
Uscita stop.


Programma spazzare.

memoriaUsata1 := (Programma memoria ? 0).


{ :i  Uscita scrivi: i. } × 4.
Uscita stop.
{ :i  Uscita scrivi: (4 - i). } × 4.
Uscita stop.
( 1 > 2 ) falso: { Uscita scrivi: ['BLOCCO 1'], stop. }.
( 2 > 1 ) vero:  { Uscita scrivi: ['BLOCCO 2'], stop. }.

>> i := 0.
{ Uscita scrivi: i. i inserisci: 1. } mentre: { <- ( i < 3). }.
Uscita stop.

i := 3.
{ Uscita scrivi: i. i := i - 1. } mentre: { <- ( i > 0). }.
Uscita stop.



Programma spazzare.
memoriaUsata2 := (Programma memoria ? 0).


{ :i Uscita scrivi: i. } × 4.
Uscita stop.
{ :i Uscita scrivi: (4 - i). } × 4.
Uscita stop.
( 1 > 2 ) falso: { Uscita scrivi: ['BLOCCO 1'], stop. }.
( 2 > 1 ) vero:  { Uscita scrivi: ['BLOCCO 2'], stop. }.

>> i := 0.
{ Uscita scrivi: i. i inserisci: 1. } mentre: { <- ( i < 3). }.
Uscita stop.

i := 3.
{ Uscita scrivi: i. i := i - 1. } mentre: { <- ( i > 0). }.
Uscita stop.

Programma spazzare.
memoriaUsata3 := (Programma memoria ? 0).



( memoriaUsata1 = memoriaUsata2 e: memoriaUsata1 = memoriaUsata3, e: memoriaUsata2 = memoriaUsata3 ) vero: {
	Uscita scrivi: ['Nessuna perdita di memoria qui'].
}, falso: {
	Uscita scrivi: ['Perdita di memoria...'].
}.
