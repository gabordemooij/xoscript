>> Greeter := Oggetto nuovo.
Greeter on: ['make'] fare: {
	>> gr := Oggetto nuovo.
	gr on: ['setName:'] fare: { :aname
		mio nome := aname.
	}.
	gr on: ['greet'] fare: {
		Uscita scrivi: mio nome.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a nuovo.
c setName: ['THREE'].
c greet.
>> d := a nuovo.
d setName: ['FOUR'].
d greet.
c greet.
