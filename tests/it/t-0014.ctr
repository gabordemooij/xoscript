>> Salutatore := Oggetto nuovo.
Salutatore on: ['crea'] fare: {
	>> gr := Oggetto nuovo.
	gr on: ['setName:'] fare: { :unNome
		mio nome := unNome.
	}.
	gr on: ['saluta'] fare: {
		Uscita scrivi: mio nome.
	}. <- gr.
}.
>> a := Salutatore crea.
>> b := Salutatore crea.
a setName: ['UNO'].
b setName: ['DUE'].
a saluta.
b saluta.
>> c := a nuovo.
c setName: ['TRE'].
c saluta.
>> d := a nuovo.
d setName: ['QUATTRO'].
d saluta.
c saluta.
