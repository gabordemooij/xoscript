Programma gcmode: 4.

>> Doubler := Oggetto nuovo.
>> Multiplier := Oggetto nuovo.
Doubler on: ['double:and:'] fare: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier on: ['multiply:and:'] fare: { :x :y <- (x × y).
}.

Uscita scrivi: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), stop.
