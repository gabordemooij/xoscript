Programma gcmode: 4.

>> Duplicatore := Oggetto nuovo.
>> Moltiplicatore := Oggetto nuovo.
Duplicatore on: ['raddoppia:e:'] fare: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Moltiplicatore on: ['moltiplica:e:'] fare: { :x :y <- (x × y).
}.

Uscita scrivi: (
	Duplicatore raddoppia:
		(Duplicatore raddoppia: 
			(Moltiplicatore moltiplica: 2 e: 3)
		e:
			(Moltiplicatore moltiplica: 3 e: 4)
		)
	e:
		(Duplicatore raddoppia: 
			(Moltiplicatore moltiplica: 2 e: 3)
		e:
			(Moltiplicatore moltiplica: 3 e: 4)
		)
), stop.
