

>> g  := Server nuovo.
>> v  := Caveau nuovo.
>> ok := 0.

>> segreti := Serie nuovo ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> parole-segrete := segreti copia.
parole-segrete ogni: { :i :p
	segreti ogni: { :n :s
		{
			>> cifrato := v critta: s chiave: p.
			>> decifrato := v decritta: cifrato chiave: p.
			(decifrato = s) vero: {
				ok inserisci: 1.
			}, altro: {
				Uscita scrivi: ['cifratura/decifratura fallita: '], stop.
				Uscita scrivi: s, stop.
				Uscita scrivi: ['cifrato: '] + cifrato, stop.
				Uscita scrivi: ['decifrato: '] + cifrato, stop.
				Programma fine.
			}.
		} catturare: { :err
			(s = [''] o: p = ['']) vero: {
				ok inserisci: 1.
			}, altro: {
				Uscita scrivi: err, stop.
				Programma fine.
			}.
		}, correre.
	}.
}.

Uscita scrivi: ( ok + [' cifrature della cassaforte testate.'] ), stop.