Server init.

>> DB := MariaDB nuovo host: ['localhost'],
	utente: ['xo'],
	password: ['pass123'],
	nome-database: ['xobase'],
	connetti.
	
>> SQL := ['SELECT "hello" AS "world" '].

# crea la query a mano
>> parametri := Maria-Query nuovo: SQL.

# imposta il database
parametri database: DB.

parametri recupera: { :fila
	Uscita scrivi: fila world, stop.
}.
