Server init.

>> db := MariaDB nuovo host: ['localhost'],
	utente: ['xo'],
	password: ['pass123'],
	nome-database: ['xobase'],
	connetti.

>> canc := db query: ['DELETE FROM book WHERE id > 0'].
{  canc esegui. db commit. } catturare: { :e db rollback.  }, correre.

>> contare := db query: ['SELECT COUNT(*) AS num FROM book'].
contare recupera: { :fila Uscita scrivi: fila num, stop. }.
