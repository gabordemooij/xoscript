>> cantina := { <- (	Elenco nuovo
		met: 2 a: ['merlot'],
		met: 3 a: ['malbec'],
		met: 4 a: ['syrah']
	).
}.

Uscita scrivi: (((cantina correre) - ['niente']) contare), stop.
Uscita scrivi: (((cantina correre) - ['merlot']) contare), stop.
Uscita scrivi: (((cantina correre) - ['malbec']) contare), stop.
Uscita scrivi: (((cantina correre) - ['syrah']) contare), stop.
Uscita scrivi: (((cantina correre) - ['merlot'] - ['malbec']) contare), stop.
Uscita scrivi: (((cantina correre) - ['merlot'] - ['syrah']) contare), stop.
Uscita scrivi: (((cantina correre) - ['malbec'] -['syrah']) contare), stop.
Uscita scrivi: (((cantina correre) - ['malbec'] - ['syrah'] - ['merlot']) contare), stop.

