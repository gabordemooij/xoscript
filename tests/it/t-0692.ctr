Server init.

Uscita scrivi: (
	Modello nuovo: ['^\\w+$'],
	corrispondenza: ['test@example.com'] 
), stop. # 0 match, fails on @ and .

Uscita scrivi: (
	Modello nuovo: ['^[^@]+@[^\.]+\.\\w+$'],
	corrispondenza: ['test@example.com'] 
), stop. # 1 match

Uscita scrivi: (
	Modello nuovo: ['[^@]+@[^\.]+\.\\w+'],
	corrispondenza: ['test@example.com'] 
), stop. # 1 match

Uscita scrivi: (
	Modello nuovo: ['([^@]+)@([^\.]+)\.\\w+'],
	corrispondenza: ['test@example.com'] 
), stop. # 1 match, groups dont matter

Uscita scrivi: (
	Modello nuovo: ['[a-z]'],
	corrispondenza: ['test@example.com'] 
), stop. # 14 matches

Uscita scrivi: (
	Modello nuovo: ['.*'],
	corrispondenza: ['test@example.com'] 
), stop. # 1 match (all)

Uscita scrivi: (
	Modello nuovo: ['(.*)'],
	corrispondenza: ['test@example.com'] 
), stop. # 1 match (all)

Uscita scrivi: (
	Modello nuovo: ['\\s*[^@]+@[^\.]+\.\\w+'],
	corrispondenza: ['test@example.com'] 
), stop. # 1 match, prefix space optional, gets ignored