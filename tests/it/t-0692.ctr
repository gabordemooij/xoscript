Server init.

Uscita scrivi: (
	Modello nuovo: ['^\\w+$'],
	corrispondenza: ['test@example.com'] 
), stop. # 0 corrispondenze, fallisce su @ e .

Uscita scrivi: (
	Modello nuovo: ['^[^@]+@[^\.]+\.\\w+$'],
	corrispondenza: ['test@example.com'] 
), stop. # 1 corrispondenza

Uscita scrivi: (
	Modello nuovo: ['[^@]+@[^\.]+\.\\w+'],
	corrispondenza: ['test@example.com'] 
), stop. # 1 corrispondenza

Uscita scrivi: (
	Modello nuovo: ['([^@]+)@([^\.]+)\.\\w+'],
	corrispondenza: ['test@example.com'] 
), stop. # 1 corrispondenza, i gruppi non contano

Uscita scrivi: (
	Modello nuovo: ['[a-z]'],
	corrispondenza: ['test@example.com'] 
), stop. # 14 corrispondenze

Uscita scrivi: (
	Modello nuovo: ['.*'],
	corrispondenza: ['test@example.com'] 
), stop. # 1 corrispondenza (tutto)

Uscita scrivi: (
	Modello nuovo: ['(.*)'],
	corrispondenza: ['test@example.com'] 
), stop. # 1 corrispondenza (tutto)

Uscita scrivi: (
	Modello nuovo: ['\\s*[^@]+@[^\.]+\.\\w+'],
	corrispondenza: ['test@example.com'] 
), stop. # 1 corrispondenza, spazio iniziale opzionale, viene ignorato