# test di parsing degli URL

Server init.
>> url := URL da: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Uscita scrivi: ['schema = '] + url schema, stop.
Uscita scrivi: ['host = '] + url host, stop.
Uscita scrivi: ['porta = '] + url porta, stop.
Uscita scrivi: ['percorso = '] + url sentiero, stop.
Uscita scrivi: ['interrogazione = '] + url parametri, stop.
Uscita scrivi: ['frammento = '] + url frammento, stop.
