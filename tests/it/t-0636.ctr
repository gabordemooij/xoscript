# test url parsing

Server init.
>> url := URL da: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Uscita scrivi: ['scheme = '] + url schema, stop.
Uscita scrivi: ['host = '] + url host, stop.
Uscita scrivi: ['port = '] + url porta, stop.
Uscita scrivi: ['path = '] + url sentiero, stop.
Uscita scrivi: ['query = '] + url parametri, stop.
Uscita scrivi: ['fragment = '] + url frammento, stop.
