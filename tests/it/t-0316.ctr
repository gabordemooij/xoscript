>> Grandfather := Oggetto nuovo.
Grandfather on: ['greet'] fare: {
	Uscita scrivi: ['Ave!'], stop.
}.
>> Father := Grandfather nuovo.
Father on: ['greet'] fare: {
	Uscita scrivi: ['Hello'], stop.
	io greet.
}.
>> Son := Father nuovo.
Son on: ['greet'] fare: {
	Uscita scrivi: ['Hi'], stop.
	io greet.
}.

Son greet.

>> Roundabout := Oggetto nuovo.
Roundabout on: ['circle:'] fare: { :x
	Uscita scrivi: x, stop.
	(x < 3) vero: { io ricorsivo circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) vero: { Uscita scrivi: x, stop. x inserisci: 1.  increment correre. }. }.
increment correre.