>> Nonno := Oggetto nuovo.
Nonno on: ['saluta'] fare: {
	Uscita scrivi: ['Ave!'], stop.
}.
>> Padre := Nonno nuovo.
Padre on: ['saluta'] fare: {
	Uscita scrivi: ['Hello'], stop.
	io saluta.
}.
>> Figlio := Padre nuovo.
Figlio on: ['saluta'] fare: {
	Uscita scrivi: ['Ehi'], stop.
	io saluta.
}.

Figlio saluta.

>> Rotatoria := Oggetto nuovo.
Rotatoria on: ['circle:'] fare: { :x
	Uscita scrivi: x, stop.
	(x < 3) vero: { io ricorsivo circle: x + 1. }.
}.

Rotatoria circle: 1.

>> x := 1.
>> incrementa := { (x ≤ 3) vero: { Uscita scrivi: x, stop. x inserisci: 1.  incrementa correre. }. }.
incrementa correre.