>> Salutatore := Oggetto nuovo.
Salutatore on: ['crea'] fare: {
	>> salutatore := Oggetto nuovo.
	salutatore on: ['name:'] fare: { :nome
		Uscita scrivi: ['impostazione di un nome'].
		mio mioNome := nome.
	}.
	salutatore on: ['eseguiSaluto'] fare: {
		Uscita scrivi: ['Hello'].
		Uscita scrivi: mio mioNome.
	}.
	salutatore on: ['saluta'] fare: {
		io eseguiSaluto.
	}. <- salutatore.
}.
>> salutatore := Salutatore crea.
salutatore name: ['raggio di sole!'].
salutatore saluta.
