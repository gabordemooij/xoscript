>> items := Elenco nuovo.
items met: ['verde'] a: ['color-1'].
items met: ['arancione'] a: ['color-2'].
items met: ['rosso'] a: ['color-3'].
>> i := 0.
>> s := [''].
items ogni: { :key :colore
	Uscita scrivi: ['color #'] + i + [' è: '] + colore + [' '].
	i inserisci: 1.
}.
Uscita scrivi: i + [' colori!'].
