>> items := Elenco nuovo.
items met: ['green'] a: ['color-1'].
items met: ['orange'] a: ['color-2'].
items met: ['red'] a: ['color-3'].
>> i := 0.
>> s := [''].
items ogni: { :key :color
	Uscita scrivi: ['color #'] + i + [' is: '] + color + [' '].
	i inserisci: 1.
}.
Uscita scrivi: i + [' colors!'].
