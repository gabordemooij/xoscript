>> q := Serie ← 1 ; 2 ; 3.
{ q ? ['1']. } catturare: { Uscita scrivi: ['caught!'], stop. }, correre.
{ q ? Vero. } catturare: { Uscita scrivi: ['caught!'], stop. }, correre.
{ q ? Falso. } catturare: { Uscita scrivi: ['caught!'], stop. }, correre.
{ q ? Nil. } catturare: { Uscita scrivi: ['caught!'], stop. }, correre.
{ q ? (Serie nuovo). } catturare: { Uscita scrivi: ['caught!'], stop. }, correre.
{ q ? (Oggetto nuovo). } catturare: { Uscita scrivi: ['caught!'], stop. }, correre.
{ q ? ({ ['Empty']. }). } catturare: { Uscita scrivi: ['caught!'], stop. }, correre.
Uscita scrivi: ['caught them all'], stop.
