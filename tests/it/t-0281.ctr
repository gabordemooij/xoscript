>> q := Serie ← 1 ; 2 ; 3.
{ q ? ['1']. } catturare: { Uscita scrivi: ['catturato!'], stop. }, correre.
{ q ? Vero. } catturare: { Uscita scrivi: ['catturato!'], stop. }, correre.
{ q ? Falso. } catturare: { Uscita scrivi: ['catturato!'], stop. }, correre.
{ q ? Nil. } catturare: { Uscita scrivi: ['catturato!'], stop. }, correre.
{ q ? (Serie nuovo). } catturare: { Uscita scrivi: ['catturato!'], stop. }, correre.
{ q ? (Oggetto nuovo). } catturare: { Uscita scrivi: ['catturato!'], stop. }, correre.
{ q ? ({ ['Vuoto']. }). } catturare: { Uscita scrivi: ['catturato!'], stop. }, correre.
Uscita scrivi: ['catturati tutti'], stop.
