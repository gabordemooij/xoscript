# test dei metodi catch-all
>> x13 := Oggetto nuovo.
x13 on: ['a'] fare: { :a Uscita scrivi: 0, stop. }.
x13 on: ['a:'] fare: { :a Uscita scrivi: a, stop. <- 5. }.
x13 on: ['a:b:'] fare: { :a :b Uscita scrivi: (a + b), stop. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
