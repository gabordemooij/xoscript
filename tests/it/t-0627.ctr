

# crea un intero a 64 bit per calcoli esatti
>> a := Int64 da-testo: ['123'].

# in testo
Uscita scrivi: a, stop.

# dividi
Uscita scrivi: a / (Int64 da-testo: ['3']), stop.

# moltiplica
Uscita scrivi: a * (Int64 da-testo: ['2']), stop.

# somma
Uscita scrivi: a + (Int64 da-testo: ['1']), stop.

# sottrai
Uscita scrivi: a - (Int64 da-testo: ['2']), stop.

# confronta
Uscita scrivi: ( a =   (Int64 da-testo: ['123'])), stop.
Uscita scrivi: ( a !=: (Int64 da-testo: ['124'])), stop.
Uscita scrivi: ( a <   (Int64 da-testo: ['124'])), stop.
Uscita scrivi: ( a >   (Int64 da-testo: ['122'])), stop.
Uscita scrivi: ( a >=: (Int64 da-testo: ['123'])), stop.
Uscita scrivi: ( a <=: (Int64 da-testo: ['123'])), stop.





	