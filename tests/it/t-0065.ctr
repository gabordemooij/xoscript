Numero on: ['factorial'] fare: {
	>> total := 1.
	{ :index total moltiplicato-per: (io - (index)). } × io. <- total.
}.
>> Printer := Oggetto nuovo.
Printer on: ['print:and:'] fare: { :x :y
	Uscita scrivi: ['a='] + x + [', b='] + y, stop.
}.
>> a := 4.5. >> b := a difetto.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a eccesso.
Printer print: a and: b.
a := 4.5. b := a difetto.
Printer print: a and: b.
a := 4.5. b := a arrotondato.
Printer print: a and: b.
a := 4.2. b := a arrotondato.
Printer print: a and: b.

Uscita scrivi: (9 modulo: 5), stop.
Uscita scrivi: -666 abs, stop.
Uscita scrivi: 49 sqrt, stop.
Uscita scrivi: (2 al-potere: 3), stop.
>> l := (Serie ← 9 ; 6).
Uscita scrivi: l minimo.

