Numero on: ['fattoriale'] fare: {
	>> totale := 1.
	{ :indice totale moltiplicato-per: (io - (indice)). } × io. <- totale.
}.
>> Stampante := Oggetto nuovo.
Stampante on: ['stampa:e:'] fare: { :x :y
	Uscita scrivi: ['a='] + x + [', b='] + y, stop.
}.
>> a := 4.5. >> b := a difetto.
Stampante stampa: a e: b.
a := 4. b := a fattoriale.
Stampante stampa: a e: b.
a := 4.5. b := a eccesso.
Stampante stampa: a e: b.
a := 4.5. b := a difetto.
Stampante stampa: a e: b.
a := 4.5. b := a arrotondato.
Stampante stampa: a e: b.
a := 4.2. b := a arrotondato.
Stampante stampa: a e: b.

Uscita scrivi: (9 modulo: 5), stop.
Uscita scrivi: -666 abs, stop.
Uscita scrivi: 49 sqrt, stop.
Uscita scrivi: (2 al-potere: 3), stop.
>> l := (Serie ← 9 ; 6).
Uscita scrivi: l minimo.

