# test di cast di tipo / conversioni / binding
Programma gcmode: 4.
Server init.

>> contatore := 0.
>> db := MariaDB nuovo host: ['localhost'],
	utente: ['xo'], password: ['pass123'], nome-database: ['xobase'], connetti.

>> FormatoDueCifre := Formato nuovo: ['%02d'].

# Data e ora
{
	>> anno     := Numero tra: 1995 e: 2050, testo.
	>> mese    := FormatoDueCifre applica-int: (Numero tra: 1 e: 12), testo.
	>> giorno      := FormatoDueCifre applica-int: (Numero tra: 1 e: 28), testo.
	>> ora     := FormatoDueCifre applica-int: (Numero tra: 1 e: 23), testo.
	>> minuto   := FormatoDueCifre applica-int: (Numero tra: 1 e: 59), testo.
	>> secondo   := FormatoDueCifre applica-int: (Numero tra: 1 e: 59), testo.
	>> datetime := ['YYYY-MM-DD HH:II:SS'].	
	datetime
		YYYY: anno,
		MM: mese,
		DD: giorno,
		HH: ora,
		II: minuto,
		SS: secondo.
	>> parametri :=
	db query: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: datetime),
	recupera: { :fila
		(fila mydatetime = datetime) falso: {
			questo-compito errore: (
				['Atteso: <expected> ma ottenuto: <observation>']
				<expected>: datetime,
				<observation>: fila mydatetime
			).
		}.
	
	}.
	contatore inserisci: 1.
} * 100.

# Data
{
	>> anno     := Numero tra: 1995 e: 2050, testo.
	>> mese    := FormatoDueCifre applica-int: (Numero tra: 1 e: 12), testo.
	>> giorno      := FormatoDueCifre applica-int: (Numero tra: 1 e: 28), testo.
	>> date     := ['YYYY-MM-DD'].
	date
		YYYY: anno,
		MM: mese,
		DD: giorno.
	>> parametri :=
	db query: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: date),
	recupera: { :fila
		(fila mydate = date) falso: {
			questo-compito errore: (
				['Atteso: <expected> ma ottenuto: <observation>']
				<expected>: date,
				<observation>: fila mydate
			).
		}.
	}.
	contatore inserisci: 1.
} * 100.


# Ora
{
	>> ora     := FormatoDueCifre applica-int: (Numero tra: 1 e: 23), testo.
	>> minuto   := FormatoDueCifre applica-int: (Numero tra: 1 e: 59), testo.
	>> secondo   := FormatoDueCifre applica-int: (Numero tra: 1 e: 59), testo.
	>> tempo := ['HH:II:SS'].
	tempo
		HH: ora,
		II: minuto,
		SS: secondo.
	>> parametri :=
	db query: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: tempo),
	recupera: { :fila
		(fila mytime = tempo) falso: {
			questo-compito errore: (
				['Atteso: <expected> ma ottenuto: <observation>']
				<expected>: datetime,
				<observation>: fila mytime
			).
		}.
	}.
	contatore inserisci: 1.
} * 100.


# Testi (varchar/text)
>> str1 := Serie nuovo riempire: 100000 con: ['x'], aderire: [''].
{
	>> str2 := Caveau token: 40.
	>> parametri :=
	db query: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	recupera: { :fila
		(fila str1 = str1 e: fila str2 = str2) falso: {
			questo-compito errore: (
				['Atteso: <expected> ma ottenuto: <observation>']
				<expected>: datetime,
				<observation>: fila mytime
			).
		}.
	}.
	contatore inserisci: 1.
} * 100.


# Numeri
{
	>> n1  := Numero tra: 1 e: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 da-testo: ['9223372036854775807'] ) -
		( Int64 da-testo: ['99999'] ) +
		( Int64 da-testo: n1 testo )
	).
	>> parametri :=
	db query: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	recupera: { :fila
		(fila n1 = n1) falso: {
			questo-compito errore: (
				['Atteso: <expected> ma ottenuto: <observation>']
				<expected>: n1,
				<observation>: fila n1
			).
		}.
		(fila n2 = n2) falso: {
			questo-compito errore: (
				['Atteso: <expected> ma ottenuto: <observation>']
				<expected>: n1,
				<observation>: fila n2
			).
		}.
		(fila n3 = n2 arrotondato) falso: {
			questo-compito errore: (
				['Atteso: <expected> ma ottenuto: <observation>']
				<expected>: n1,
				<observation>: fila n3
			).
		}.
		(fila big = big) falso: {
			questo-compito errore: (
				['Atteso: <expected> ma ottenuto: <observation>']
				<expected>: big,
				<observation>: fila big
			).
		}.
		
	}.
	contatore inserisci: 1.
} * 100.


Uscita scrivi: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: contatore
), stop.