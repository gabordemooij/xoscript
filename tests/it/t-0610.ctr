
>> Rettangolo := Oggetto nuovo.

Rettangolo on: ['area'] fare: {
	<- mio lunghezza * mio larghezza.
}.

Rettangolo on: ['length:'] fare: { :lunghezza
	mio lunghezza := lunghezza.
}.

Rettangolo on: ['width:'] fare: { :larghezza
	mio larghezza := larghezza.
}.

Rettangolo on: ['nuovo'] fare: {
	# questo non porterà a un ciclo infinito
	>> rettangolo := io nuovo.
	rettangolo length: 0, width: 0.
	<- rettangolo.
}.

>> a := Rettangolo nuovo.
Uscita scrivi: a area, stop. #0

>> b := Rettangolo nuovo length: 2, width: 3.
Uscita scrivi: b area, stop. #6

