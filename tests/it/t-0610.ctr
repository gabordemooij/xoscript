
>> Rectangle := Oggetto nuovo.

Rectangle on: ['area'] fare: { <- mio lunghezza * mio width.
}.

Rectangle on: ['length:'] fare: { :lunghezza
	mio lunghezza := lunghezza.
}.

Rectangle on: ['width:'] fare: { :width
	mio width := width.
}.

Rectangle on: ['nuovo'] fare: {
	# this will not result into an infinite loop
	>> rectangle := io nuovo.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle nuovo.
Uscita scrivi: a area, stop. #0

>> b := Rectangle nuovo length: 2, width: 3.
Uscita scrivi: b area, stop. #6

