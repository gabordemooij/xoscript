# un valore che termina con la prima parte di una virgoletta di apertura deve sopravvivere alla serializzazione
>> valori := Serie nuovo
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

valori ogni: { :i :value
	>> d := Elenco nuovo.
	d met: value a: ['k'].
	d met: ['second'] a: ['j'].
	>> r := d code oggetto.
	Uscita scrivi: r contare, stop.
	Uscita scrivi: ( (r a: ['k']) = value ), stop.
}.
