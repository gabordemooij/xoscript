# line breaks in values must not create extra headers
Server inizializzare.
Programma uso: ['../../../src/xo/it/webtools.xo'].
Programma uso: ['../../../src/xo/it/mailtools.xo'].

>> intestazione := Intestazione-HTTP nuovo chiave: ['Location'] valore: ['/ok\r\nX-Injected: yes'].
Uscita scrivi: intestazione.

>> web := Documento-Web nuovo.
web vai-a: ['/ok\r\nX-Injected: yes'].
Uscita scrivi: ['\n'], stop.

>> mail := Email nuovo.
mail destinatario: (Serie nuovo ; ['a@example.invalid\r\nX-To: yes']).
mail cc: (Serie nuovo ; ['b@example.invalid\r\nX-Cc: yes']).
mail bcc: (Serie nuovo ; ['c@example.invalid\r\nX-Bcc: yes']).
mail mittente: ['d@example.invalid\r\nX-From: yes'] nome: ['site\r\nX-Name: yes'].
mail soggetto: ['hello\r\nX-Subject: yes'].
mail corpo: ['line1\r\nline2'].
Uscita scrivi: mail generare.

>> html := Email-HTML nuovo.
html destinatario: (Serie nuovo ; ['a@example.invalid\r\nX-To: yes']).
html mittente: ['d@example.invalid'] nome: ['site'].
html soggetto: ['hello\r\nX-Subject: yes'].
html corpo: ['body'].
Uscita scrivi: ( html generare contiene: ['\nX-'] ), stop.
Uscita scrivi: ( html generare contiene: ['X-To: yes'] ), stop.
