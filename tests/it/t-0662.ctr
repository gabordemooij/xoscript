>> t := Nil.

# you can control the time zone for
# parsing like this:
Momento zona: ['CET'].
t := Momento da: ['1981-02-03 04:05:06'].
Uscita scrivi: t, stop.

# now using CEST time zone:
Momento zona: ['CEST'].
t := Momento da: ['1981-02-03 04:05:06'].
Uscita scrivi: t, stop.

# error if string cannot be parsed
{ Momento da: ['1900']. } catturare: { Nil. }, correre.
