>> t := Nil.

# puoi controllare il fuso orario per
# il parsing in questo modo:
Momento zona: ['CET'].
t := Momento da: ['1981-02-03 04:05:06'].
Uscita scrivi: t, stop.

# ora con il fuso orario CEST:
Momento zona: ['CEST'].
t := Momento da: ['1981-02-03 04:05:06'].
Uscita scrivi: t, stop.

# errore se il testo non può essere analizzato
{ Momento da: ['1900']. } catturare: { Nil. }, correre.
