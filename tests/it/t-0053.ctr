60 × {
	>> x := (Numero casuale % 6) + 1.
	(x ≤ 6) falso: { Uscita scrivi: ['FALLITO']. }.
	(x ≥0) falso: { Uscita scrivi: ['FALLITO']. }.
	x := (Numero casuale % 3) + 1.
	(x < 3) falso: { Uscita scrivi: ['FALLITO']. }.
	(x>-1) falso: { Uscita scrivi: ['FALLITO']. }.
	x := ((Booleano lancia) numero).
	(x = 0 o: x = 1) falso: { Uscita scrivi: ['FALLITO']. }.
	x := ((Vero lancia) numero).
	(x = 0 o: x = 1) falso: { Uscita scrivi: ['FALLITO']. }.
	x := (Booleano lancia o: ['TESTA'] o: ['CROCE']).
	((x = ['TESTA']) o: (x = ['CROCE'])) falso: { Uscita scrivi: ['FALLITO']. }.
}.
Uscita scrivi: ['FATTO'].

