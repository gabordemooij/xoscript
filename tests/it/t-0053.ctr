60 × {
	>> x := (Numero random % 6) + 1.
	(x ≤ 6) falso: { Uscita scrivi: ['FAIL']. }.
	(x ≥0) falso: { Uscita scrivi: ['FAIL']. }.
	x := (Numero random % 3) + 1.
	(x < 3) falso: { Uscita scrivi: ['FAIL']. }.
	(x>-1) falso: { Uscita scrivi: ['FAIL']. }.
	x := ((Booleano flip) numero).
	(x = 0 o: x = 1) falso: { Uscita scrivi: ['FAIL']. }.
	x := ((Vero flip) numero).
	(x = 0 o: x = 1) falso: { Uscita scrivi: ['FAIL']. }.
	x := (Booleano flip o: ['HEAD'] o: ['TAIL']).
	((x = ['HEAD']) o: (x = ['TAIL'])) falso: { Uscita scrivi: ['FAIL']. }.
}.
Uscita scrivi: ['DONE'].

