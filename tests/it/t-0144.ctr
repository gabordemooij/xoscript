



>> CoffeeGrounds := Oggetto nuovo.
CoffeeGrounds on: ['extract'] fare: { <- ['coffee']. }.

>> CoffeeMachine := Oggetto nuovo.
CoffeeMachine on: ['init'] fare: {
	mio coffeegrounds := CoffeeGrounds nuovo.
}.
CoffeeMachine on: ['nuovo'] fare: { <- CoffeeMachine `new init.
}.

CoffeeMachine on: ['makeTea'] fare: { <- (mio tealeaves extract). }.
CoffeeMachine on: ['makeCoffee'] fare: { <- (mio coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine nuovo.

Uscita scrivi:
	coffeeDream 
	makeCoffee.

Uscita scrivi:
	coffeeDream 
	makeTea.
