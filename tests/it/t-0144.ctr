



>> FondiDiCaffè := Oggetto nuovo.
FondiDiCaffè on: ['estrai'] fare: { <- ['coffee']. }.

>> MacchinaDelCaffè := Oggetto nuovo.
MacchinaDelCaffè on: ['init'] fare: {
	mio fondidicaffè := FondiDiCaffè nuovo.
}.
MacchinaDelCaffè on: ['nuovo'] fare: { <- MacchinaDelCaffè `new init.
}.

MacchinaDelCaffè on: ['faiTè'] fare: { <- (mio fogliedità estrai). }.
MacchinaDelCaffè on: ['faiCaffè'] fare: { <- (mio fondidicaffè estrai). }.

>> sognoDiCaffè := MacchinaDelCaffè nuovo.

Uscita scrivi:
	sognoDiCaffè 
	faiCaffè.

Uscita scrivi:
	sognoDiCaffè 
	faiTè.
