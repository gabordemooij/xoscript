Serie on: ['sum'] fare: {
	>> total := 0.
	io ogni: { :index :element
		total inserisci: element.
	}. <- total.
}.

>> a := Vero.



a on: ['testo'] fare: {
	>> answer := Nil.
	( io = Vero ) vero: {
		answer := ['Yep'].
	}, altro: {
		answer := ['Nope'].
	}. <- answer.
}.

a on: ['numero'] fare: {
	>> answer := Nil.
	( io = Vero ) vero: {
		answer := 10.
	}, altro: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b on: ['testo'] fare: { <- ['Devil'].
}.

b on: ['booleano'] fare: { <- Falso.
}.


Uscita scrivi: a, stop.  
Uscita scrivi: (90 + a), stop. 
Uscita scrivi: b, stop. 
Uscita scrivi: (Vero e: b), stop.

a := Serie ← ['hello'] ; ['world'] ; Vero ; Nil ; 666. 
a := a + ( Serie ← 1 ).
Uscita scrivi: a, stop.
Uscita scrivi: ((Elenco nuovo) met: Nil a: Nil), stop.
Uscita scrivi: a sum, stop. 


{
	a on: ['testo'] fare: { <- Nil. }.
	a := [''] + a.
} catturare: { :error
	Uscita scrivi: ['Error noted: '] + error, stop.
}, correre.



{
	a on: ['numero'] fare: { <- Nil. }.
	a := 3 × a.
} catturare: { :error
	Uscita scrivi: ['Error noted: '] + error, stop.
}, correre.


{
	a on: ['booleano'] fare: { <- Nil. }.
	a := Vero e: a. 
} catturare: { :error
	Uscita scrivi: ['Error noted: '] + error, stop.
}, correre.





{
	a on: ['testo'] fare: { <- Falso. }.
	a := [''] + a.
} catturare: { :error
	Uscita scrivi: ['Error noted: '] + error, stop.
}, correre.



{
	a on: ['numero'] fare: { <- Vero. }.
	a := 3 × a.
} catturare: { :error
	Uscita scrivi: ['Error noted: '] + error, stop.
}, correre.


{
	a on: ['boolean'] fare: { <- 1. }.
	a := Vero e: a.
} catturare: { :error
	Uscita scrivi: ['Error noted: '] + error, stop.
}, correre.





