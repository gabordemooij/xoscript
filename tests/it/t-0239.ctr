Serie on: ['somma'] fare: {
	>> totale := 0.
	io ogni: { :indice :elemento
		totale inserisci: elemento.
	}. <- totale.
}.

>> a := Vero.



a on: ['testo'] fare: {
	>> responso := Nil.
	( io = Vero ) vero: {
		responso := ['Già'].
	}, altro: {
		responso := ['Macché'].
	}. <- responso.
}.

a on: ['numero'] fare: {
	>> responso := Nil.
	( io = Vero ) vero: {
		responso := 10.
	}, altro: {
		responso := 20.
	}. <- responso.
}.

>> b := 666.

b on: ['testo'] fare: { <- ['Diavolo'].
}.

b on: ['booleano'] fare: { <- Falso.
}.


Uscita scrivi: a, stop.  
Uscita scrivi: (90 + a), stop. 
Uscita scrivi: b, stop. 
Uscita scrivi: (Vero e: b), stop.

a := Serie ← ['hello'] ; ['world'] ; Vero ; Nil ; 666. 
a := a + ( Serie ← 1 ).
Uscita scrivi: a, stop.
Uscita scrivi: ((Elenco nuovo) met: Nil a: Nil), stop.
Uscita scrivi: a somma, stop. 


{
	a on: ['testo'] fare: { <- Nil. }.
	a := [''] + a.
} catturare: { :errore
	Uscita scrivi: ['Errore annotato: '] + errore, stop.
}, correre.



{
	a on: ['numero'] fare: { <- Nil. }.
	a := 3 × a.
} catturare: { :errore
	Uscita scrivi: ['Errore annotato: '] + errore, stop.
}, correre.


{
	a on: ['booleano'] fare: { <- Nil. }.
	a := Vero e: a. 
} catturare: { :errore
	Uscita scrivi: ['Errore annotato: '] + errore, stop.
}, correre.





