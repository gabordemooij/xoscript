#test FFI


Server init.

Programma gcmode: 4.

# per questo test devi impostare un percorso a libc (puts)
>> nomelib := Programma instelling: ['FFITESTLIB'].



Server collega: (
 Serie nuovo ;
 nomelib ;
 ['puts'] ;
 ( Serie nuovo ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s libero.

# test con struct

>> a := Blob nuovo: 8.
a bytes: (
	Serie <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> strutt := Blob struttura: (Serie <<: ['int'], ; ['int']).

Server collega: (
	Serie <<: ['@structtest'], ;
	['@structtest'] ;
	(Serie <<: strutt) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Uscita scrivi: ['Test della somma:'] + (ffitest ffisum: a), stop.

strutt strutturalibera.
strutt libero.
a libero.
