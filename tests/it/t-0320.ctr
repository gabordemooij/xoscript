


>> CoffeeMachine := Oggetto nuovo.
CoffeeMachine on: ['order:'] fare: { :id
	>> coffee := ['Americano'].
	( id = 1 ) vero: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) vero: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) vero: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Oggetto nuovo.
SimpleCoffeeMachine on: ['order'] fare: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Uscita scrivi: redCup, stop.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Uscita scrivi: greenCup, stop.
>> yellowCup := CoffeeMachine order: 1.
Uscita scrivi: yellowCup, stop.
>> blueCup := CoffeeMachine order: 0.
Uscita scrivi: blueCup, stop.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Uscita scrivi: blackCup, stop.
blackCup aggiungere: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Uscita scrivi: orangeCup, stop.
