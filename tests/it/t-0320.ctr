


>> MacchinaDelCaffè := Oggetto nuovo.
MacchinaDelCaffè on: ['order:'] fare: { :id
	>> coffee := ['Americano'].
	( id = 1 ) vero: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) vero: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) vero: {
		coffee := ['Caffellatte'].
	}. <- coffee.
}.
>> MacchinaDelCaffèSemplice := Oggetto nuovo.
MacchinaDelCaffèSemplice on: ['ordinazione'] fare: { <- ['Nero']. }.
>> tazzaRossa := MacchinaDelCaffè order: 1.
Uscita scrivi: tazzaRossa, stop.
tazzaRossa := ['Tè']. 
>> tazzaVerde := MacchinaDelCaffè order: 0.
Uscita scrivi: tazzaVerde, stop.
>> tazzaGialla := MacchinaDelCaffè order: 1.
Uscita scrivi: tazzaGialla, stop.
>> tazzaBlu := MacchinaDelCaffè order: 0.
Uscita scrivi: tazzaBlu, stop.
>> tazzaDiPlastica := MacchinaDelCaffèSemplice ordinazione.
tazzaDiPlastica := ['Limonata']. 
>> tazzaNera := MacchinaDelCaffèSemplice ordinazione.
Uscita scrivi: tazzaNera, stop.
tazzaNera aggiungere: [' nooo.... birra. '].
>> tazzaArancione := MacchinaDelCaffèSemplice ordinazione.
Uscita scrivi: tazzaArancione, stop.
