>> ripetitore := Oggetto nuovo.
ripetitore on: ['rispondere:'] fare: { :cosa
	Uscita scrivi: cosa + [' '].
}.
ripetitore on: ['rispondere:e:'] fare: { :cosa :say
	Uscita scrivi: cosa, scrivi: say + [' '].
}.
ripetitore on: ['rispondere:e:e:'] fare: { :cosa :say :ancora
	Uscita scrivi: cosa, scrivi: say, scrivi: ancora.
}.
ripetitore ripeti.
ripetitore everything: ['Io dico.'].
ripetitore and: ['I '] everything: ['faccio.'].
