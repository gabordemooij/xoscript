>> repeater := Oggetto nuovo.
repeater on: ['rispondere:'] fare: { :what
	Uscita scrivi: what + [' '].
}.
repeater on: ['rispondere:e:'] fare: { :what :say
	Uscita scrivi: what, scrivi: say + [' '].
}.
repeater on: ['rispondere:e:e:'] fare: { :what :say :more
	Uscita scrivi: what, scrivi: say, scrivi: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
