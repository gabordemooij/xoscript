

Serie on: ['column:'] fare: { :column
	>> result := Serie nuovo.
	io ogni: { :index :row
		row ogni: { :index :cell
			(index = column) vero: { result aggiungere: cell. }.
		}.
	}. <- result.
}.


>> a := Serie ←
	(Serie ← 1 ; 2 ; 3) ;
	(Serie ← 4 ; 5 ; 6) ;
	(Serie ← 7 ; 8 ; 9).

>> b := a column: 1.
Uscita scrivi: b, stop.

b := a column: 20.
Uscita scrivi: b, stop.

b := a column: -100.
Uscita scrivi: b, stop.
