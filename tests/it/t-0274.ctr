

Serie on: ['column:'] fare: { :colonna
	>> risultato := Serie nuovo.
	io ogni: { :indice :fila
		fila ogni: { :indice :cella
			(indice = colonna) vero: { risultato aggiungere: cella. }.
		}.
	}. <- risultato.
}.


>> a := Serie ←
	(Serie ← 1 ; 2 ; 3) ;
	(Serie ← 4 ; 5 ; 6) ;
	(Serie ← 7 ; 8 ; 9).

>> b := a column: 1.
Uscita scrivi: b, stop.

b := a column: 20.
Uscita scrivi: b, stop.

b := a column: -100.
Uscita scrivi: b, stop.
