Server init.

# scrivi un file di test
>> f := File nuovo: ['/tmp/test.gif'].
f scrivi: ['GIF87a01234567810'].

# servi il file
Server passaggio: ['test.gif'] prefisso: ['/tmp/'].

Uscita stop.

Uscita scrivi: ['Fuori dal contenitore (sicurezza):'], stop.
{ Server passaggio: ['../passwd'] prefisso: ['/tmp/']. }
catturare: { :e Uscita scrivi: e, stop. },
correre.

Uscita scrivi: ['Prefisso non valido:'], stop.
{ Server passaggio: ['test.gif'] prefisso: ['z:\\']. }
catturare: { :e Uscita scrivi: e, stop. },
correre.

Uscita scrivi: ['File inesistente:'], stop.
{ Server passaggio: ['xxx.xxx'] prefisso: ['/tmp/']. }
catturare: { :e Uscita scrivi: e, stop. },
correre.
