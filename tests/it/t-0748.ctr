Uscita scrivi: ['Test object'], stop.
>> a := Oggetto nuovo. 

a on: ['item:'] fare: { :booleano
	mio booleano := booleano. 
}.

a on: ['item'] fare: { <- mio booleano.
}.

a item: Vero.

Uscita scrivi: a item, stop.

>> old-bool-address := a item prototipo indirizzo-di-memoria.
a save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RELOADING SNAP:'], stop.

>> b := Oggetto load-from: ['/tmp/a.bin'].

(b item prototipo indirizzo-di-memoria = old-bool-address) vero: {
	Uscita scrivi: ['Object link re-attached.'], stop.
}.

Uscita scrivi: b item, stop.
