

Programma spazzare.


>> Verdura := Oggetto nuovo.
Verdura on: ['nuovo'] fare: {
	>> v := io nuovo.
	v init. <- v.
}.

Verdura on: ['init'] fare: { mio verdure := 0. }.

Verdura on: ['carrots:'] fare: { :a mio verdure := a. <- Nil. }.
Verdura on: ['carote'] fare: { <- mio verdure. }.
Verdura on: ['+'] fare: { :f
	>> n := Verdura nuovo.
	n carrots: (f carote + mio verdure). <- n.
}.

Verdura on: ['testo'] fare: { <- mio verdure testo.
}.

Numero on: ['carote'] fare: {
	>> x := Verdura nuovo.
	x carrots: io. <- x.
}.

Numero on: ['somma:e:'] fare: { :a :b <- (a + b).
}.

>> q := 0 somma: (3 carote + 2 carote) e: 4 carote.
Uscita scrivi: q, stop.
