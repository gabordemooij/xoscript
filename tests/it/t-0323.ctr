

Programma spazzare.


>> Veggy := Oggetto nuovo.
Veggy on: ['nuovo'] fare: {
	>> v := io nuovo.
	v init. <- v.
}.

Veggy on: ['init'] fare: { mio veggies := 0. }.

Veggy on: ['carrots:'] fare: { :a mio veggies := a. <- Nil. }.
Veggy on: ['carrots'] fare: { <- mio veggies. }.
Veggy on: ['+'] fare: { :f
	>> n := Veggy nuovo.
	n carrots: (f carrots + mio veggies). <- n.
}.

Veggy on: ['testo'] fare: { <- mio veggies testo.
}.

Numero on: ['carrots'] fare: {
	>> x := Veggy nuovo.
	x carrots: io. <- x.
}.

Numero on: ['add:and:'] fare: { :a :b <- (a + b).
}.

>> q := 0 add: (3 carrots + 2 carrots) and: 4 carrots.
Uscita scrivi: q, stop.
