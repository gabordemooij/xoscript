Uscita scrivi: ['Oggetto di test'], stop.
>> a := Oggetto nuovo. 
a on: ['item:'] fare: { :int64
	mio int64 := int64. 
}.
a on: ['articolo'] fare: {
	<- mio int64.
}.
a item: ( Int64 da-testo: ['9999'] ).
Uscita scrivi: a articolo, stop.
>> vecchio-indirizzo-int64 := a articolo prototipo indirizzo-di-memoria.
a save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RICARICAMENTO SNAP:'], stop.
>> b := Oggetto load-from: ['/tmp/a.bin'].
(b articolo prototipo indirizzo-di-memoria = vecchio-indirizzo-int64) vero: {
	Uscita scrivi: ['Collegamento all'oggetto ricollegato.'], stop.
}.
Uscita scrivi: ( b articolo ), stop.
