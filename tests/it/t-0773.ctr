Uscita scrivi: ['Test object'], stop.
>> a := Oggetto nuovo. 
a on: ['item:'] fare: { :int64
	mio int64 := int64. 
}.
a on: ['item'] fare: { <- mio int64.
}.
a item: ( Int64 da-testo: ['9999'] ).
Uscita scrivi: a item, stop.
>> old-int64-address := a item prototipo indirizzo-di-memoria.
a save-as: ['/tmp/a.bin'].
Uscita scrivi: ['========== RELOADING SNAP:'], stop.
>> b := Oggetto load-from: ['/tmp/a.bin'].
(b item prototipo indirizzo-di-memoria = old-int64-address) vero: {
	Uscita scrivi: ['Object link re-attached.'], stop.
}.
Uscita scrivi: ( b item ), stop.
