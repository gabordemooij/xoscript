Uscita scrivi: ['Continua ciclo for, No - prima di 6 e oltre.'], stop.
{ :i
	Uscita scrivi: (i + 1), stop.
	((i + 1) > 4) continua.
	Uscita scrivi: ['-'].
} × 10.

>> x := 0.
>> xMinoreDi10 := { <- ( x < 10 ). }.
Uscita stop.
Uscita scrivi: ['Continua while-true, No --> prima di 5 e oltre.'], stop.
{
	Uscita scrivi: ['iteration #'] + x, stop.
	x inserisci: 1.
	((x < 5) non) continua.
	Uscita scrivi: ['-->'].
} mentre: xMinoreDi10.
Uscita stop.
Uscita scrivi: ['Continua while-false, No - solo prima di 3.'], stop.
{
	Uscita scrivi: ['iteration #'] + x, stop.
	x sottrarre: 1.
	(x = 3) continua.
	Uscita scrivi: ['-'].
} mentre: { <- ( x > 0). }.

Uscita stop.
Uscita scrivi: ['Continua ciclo times, No ||| prima di 3.'], stop.
{ :i
	Uscita scrivi: ['iteration #'] + i, stop.
	(i = 2) continua.
	Uscita scrivi: ['|||'].
} × 5.

Uscita stop.

{ Vero continua. Uscita scrivi: ['non scrivere questo!'], stop. } correre.

{ Vero continua. Uscita scrivi: ['non scrivere questo!'], stop. } catturare: { Uscita scrivi: ['Non catturare questo!']. }, correre.

Uscita scrivi: ['Test ciclo each su Serie: 0, ... ,2'], stop.
(Serie ← 1 ; 2 ; 3) elenco: { :i
	(i = 1) continua.
	Uscita scrivi: ['iteration #'] + (i - 0), stop.
}.

Uscita scrivi: ['Test ciclo each su Elenco: solo c'], stop.
>> m := Elenco nuovo.
m met: ['first'] a: ['a'], met: ['second'] a: ['b'], met: ['terzo'] a: ['c'].
m ogni: { :k :v
	(k ≠ ['c']) continua.
	Uscita scrivi: ['iteration'] + k + v, stop.
}.

