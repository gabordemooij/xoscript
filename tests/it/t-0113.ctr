Uscita scrivi: ['Continue for-loop, No - before 6 and up.'], stop.
{ :i
	Uscita scrivi: (i + 1), stop.
	((i + 1) > 4) continua.
	Uscita scrivi: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Uscita stop.
Uscita scrivi: ['Continue while-true, No --> before 5 and up.'], stop.
{
	Uscita scrivi: ['iteration #'] + x, stop.
	x inserisci: 1.
	((x < 5) non) continua.
	Uscita scrivi: ['-->'].
} mentre: xIsLessThan10.
Uscita stop.
Uscita scrivi: ['Continue while-false, No - before 3 only.'], stop.
{
	Uscita scrivi: ['iteration #'] + x, stop.
	x sottrarre: 1.
	(x = 3) continua.
	Uscita scrivi: ['-'].
} mentre: { <- ( x > 0). }.

Uscita stop.
Uscita scrivi: ['Continue times-loop, No ||| before 3.'], stop.
{ :i
	Uscita scrivi: ['iteration #'] + i, stop.
	(i = 2) continua.
	Uscita scrivi: ['|||'].
} × 5.

Uscita stop.

{ Vero continua. Uscita scrivi: ['dont write this!'], stop. } correre.

{ Vero continua. Uscita scrivi: ['dont write this!'], stop. } catturare: { Uscita scrivi: ['Dont catch this!']. }, correre.

Uscita scrivi: ['Test Array each-loop: 0, ... ,2'], stop.
(Serie ← 1 ; 2 ; 3) elenco: { :i
	(i = 1) continua.
	Uscita scrivi: ['iteration #'] + (i - 0), stop.
}.

Uscita scrivi: ['Test Map each-loop: c only'], stop.
>> m := Elenco nuovo.
m met: ['first'] a: ['a'], met: ['second'] a: ['b'], met: ['third'] a: ['c'].
m ogni: { :k :v
	(k ≠ ['c']) continua.
	Uscita scrivi: ['iteration'] + k + v, stop.
}.

