# test qualifiers

>> $ := Oggetto nuovo.

$ on: ['rispondere:'] fare: { :x
	
	>> operation := x carattere: 0.
	>> valuta := x carattere: 1.
	>> money := x compensare: 2.
	
	>> amount := 0.

	( operation = ['+'] ) vero: {
		( valuta = ['£'] ) vero: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Uscita scrivi: x, stop.


>> Fruit := Oggetto nuovo.

Fruit on: ['nuovo'] fare: {
	>> f := io nuovo.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit on: ['apples:'] fare: { :a mio apples := a. }.
Fruit on: ['oranges:'] fare: { :p mio oranges := p. }.
Fruit on: ['apples'] fare: { <- mio apples. }.
Fruit on: ['oranges'] fare: { <- mio oranges. }.

Fruit on: ['+'] fare: { :f
	
	>> n := Fruit nuovo.
	f inserisci: 1.
	
	n apples: (f apples + mio apples).
	n oranges:  (f oranges  + mio oranges). <- n.
}.

Fruit on: ['testo'] fare: { <- ( mio apples testo + [' apples and '] + mio oranges + [' oranges'] ).
}.

Numero on: ['apples'] fare: { <- ((Fruit nuovo) apples: io).
}.

Numero on: ['apple'] fare: { <- ((Fruit nuovo) apples: io).
}.

Numero on: ['oranges'] fare: { <- ((Fruit nuovo) oranges: io).
}.




Uscita scrivi: (1 apple + 3 oranges + 4 apples), stop.


Testo on: ['twice'] fare: { <- ((io testo) + (io testo)).
}.



Uscita scrivi: ['❤❤❤'] twice.



