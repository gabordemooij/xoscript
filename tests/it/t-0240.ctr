# test dei qualificatori

>> $ := Oggetto nuovo.

$ on: ['rispondere:'] fare: { :x
	
	>> operazione := x carattere: 0.
	>> valuta := x carattere: 1.
	>> soldi := x compensare: 2.
	
	>> importo := 0.

	( operazione = ['+'] ) vero: {
		( valuta = ['£'] ) vero: { importo := 1.28 × soldi. }.
	}. <- importo.
}.



>> x := $ +£20.

Uscita scrivi: x, stop.


>> Frutto := Oggetto nuovo.

Frutto on: ['nuovo'] fare: {
	>> f := io nuovo.
	f apples: 0.
	f oranges: 0. <- f.
}.

Frutto on: ['apples:'] fare: { :a mio mele := a. }.
Frutto on: ['oranges:'] fare: { :p mio arance := p. }.
Frutto on: ['mele'] fare: { <- mio mele. }.
Frutto on: ['arance'] fare: { <- mio arance. }.

Frutto on: ['+'] fare: { :f
	
	>> n := Frutto nuovo.
	f inserisci: 1.
	
	n apples: (f mele + mio mele).
	n oranges:  (f arance  + mio arance). <- n.
}.

Frutto on: ['testo'] fare: { <- ( mio mele testo + [' mele e '] + mio arance + [' arance'] ).
}.

Numero on: ['mele'] fare: { <- ((Frutto nuovo) apples: io).
}.

Numero on: ['apple'] fare: { <- ((Frutto nuovo) apples: io).
}.

Numero on: ['arance'] fare: { <- ((Frutto nuovo) oranges: io).
}.




Uscita scrivi: (1 apple + 3 arance + 4 mele), stop.


Testo on: ['dueVolte'] fare: { <- ((io testo) + (io testo)).
}.



Uscita scrivi: ['❤❤❤'] dueVolte.



