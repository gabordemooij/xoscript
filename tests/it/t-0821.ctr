# una virgoletta che non si chiude mai deve dare un errore, non un ciclo infinito
>> sentiero := ['/tmp/test0821.csv'].
>> file := File nuovo: sentiero.

file scrivi: ['a,b\n"1,2\n'].
{
	file separatore: [','] virgolette: ['"'] linee: { :line
		Uscita scrivi: line, stop.
	}.
} catturare: { :e Uscita scrivi: e, stop. }, correre.

# una virgoletta chiusa funziona ancora
file scrivi: ['a,b\n"1,2",3'].
file separatore: [','] virgolette: ['"'] linee: { :line
	Uscita scrivi: line, stop.
}.
file elimina.
