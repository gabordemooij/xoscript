Server init.
>> f := Formato nuovo: ['%d'].
>> a := Blob nuovo: 4.
a bytes: ( Serie nuovo ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob nuovo: 4.
b bytes: ( Serie nuovo ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a da: 0 lunghezza: 3, ogni: { :i :byte
	Uscita scrivi: ( f applica-int: byte ), stop.
}.
a ^ b.
a da: 0 lunghezza: 3, ogni: { :i :byte
	Uscita scrivi: ( f applica-int: byte ), stop.
}.
a ^ b.
a da: 0 lunghezza: 3, ogni: { :i :byte
	Uscita scrivi: ( f applica-int: byte ), stop.
}.
a libero.
b libero.

{ a ^ Oggetto. } catturare: { :e Uscita scrivi: e, stop. }, correre.
