Numero on: ['roman'] fare: {
	>> numero := io copia.
	>> roman := [''].
	{
		{
			(numero ≥ 1000) vero: {
				roman aggiungere: ['Ⅿ'].
				numero sottrarre: 1000.
			}, interrompere.
		
			(numero ≥ 500) vero: {
				roman aggiungere: ['Ⅾ'].
				numero sottrarre: 500.
			}, interrompere.
		
			(numero ≥ 100) vero: {
				roman aggiungere: ['Ⅽ'].
				numero sottrarre: 100.
			}, interrompere.
		
			(numero ≥ 50) vero: {
				roman aggiungere: ['Ⅼ'].
				numero sottrarre: 50.
			}, interrompere.
		
			(numero ≥ 50) vero: {
				roman aggiungere: ['Ⅼ'].
				numero sottrarre: 50.
			}, interrompere.
		
			(numero ≥ 10) vero: {
				roman aggiungere: ['Ⅹ'].
				numero sottrarre: 10.
			}, interrompere.
			
			(numero ≥ 9) vero: {
				roman aggiungere: ['Ⅸ'].
				numero sottrarre: 9.
			}, interrompere.
			
			(numero ≥ 5) vero: {
				roman aggiungere: ['Ⅴ'].
				numero sottrarre: 5.
			}, interrompere.
			
			(numero ≥ 4) vero: {
				roman aggiungere: ['Ⅳ'].
				numero sottrarre: 4.
			}, interrompere.
			
			(numero ≥ 1) vero: {
				roman aggiungere: ['Ⅰ'].
				numero sottrarre: 1.
			}, interrompere.
		} procedura.
	} mentre: { <- numero > 0. }. <- roman.
}.

Uscita scrivi: 1 roman, stop.
Uscita scrivi: 2 roman, stop.
Uscita scrivi: 4 roman, stop.
Uscita scrivi: 8 roman, stop.
Uscita scrivi: 16 roman, stop.
Uscita scrivi: 32 roman, stop.
Uscita scrivi: 64 roman, stop.
Uscita scrivi: 128 roman, stop.
Uscita scrivi: 256 roman, stop.
Uscita scrivi: 1024 roman, stop.
