Numero on: ['romano'] fare: {
	>> numero := io copia.
	>> romano := [''].
	{
		{
			(numero ≥ 1000) vero: {
				romano aggiungere: ['Ⅿ'].
				numero sottrarre: 1000.
			}, interrompere.
		
			(numero ≥ 500) vero: {
				romano aggiungere: ['Ⅾ'].
				numero sottrarre: 500.
			}, interrompere.
		
			(numero ≥ 100) vero: {
				romano aggiungere: ['Ⅽ'].
				numero sottrarre: 100.
			}, interrompere.
		
			(numero ≥ 50) vero: {
				romano aggiungere: ['Ⅼ'].
				numero sottrarre: 50.
			}, interrompere.
		
			(numero ≥ 50) vero: {
				romano aggiungere: ['Ⅼ'].
				numero sottrarre: 50.
			}, interrompere.
		
			(numero ≥ 10) vero: {
				romano aggiungere: ['Ⅹ'].
				numero sottrarre: 10.
			}, interrompere.
			
			(numero ≥ 9) vero: {
				romano aggiungere: ['Ⅸ'].
				numero sottrarre: 9.
			}, interrompere.
			
			(numero ≥ 5) vero: {
				romano aggiungere: ['Ⅴ'].
				numero sottrarre: 5.
			}, interrompere.
			
			(numero ≥ 4) vero: {
				romano aggiungere: ['Ⅳ'].
				numero sottrarre: 4.
			}, interrompere.
			
			(numero ≥ 1) vero: {
				romano aggiungere: ['Ⅰ'].
				numero sottrarre: 1.
			}, interrompere.
		} procedura.
	} mentre: { <- numero > 0. }. <- romano.
}.

Uscita scrivi: 1 romano, stop.
Uscita scrivi: 2 romano, stop.
Uscita scrivi: 4 romano, stop.
Uscita scrivi: 8 romano, stop.
Uscita scrivi: 16 romano, stop.
Uscita scrivi: 32 romano, stop.
Uscita scrivi: 64 romano, stop.
Uscita scrivi: 128 romano, stop.
Uscita scrivi: 256 romano, stop.
Uscita scrivi: 1024 romano, stop.
