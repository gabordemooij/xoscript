

>> memoriaUsata1 := 0.
>> memoriaUsata2 := 0.
>> memoriaUsata3 := 0.
>> memoriaUsata4 := 0.

Programma gcmode: 0.

>> txt := ['World Salad'].
Uscita scrivi: ['questo testo contiene: '] + ( ( txt diviso: [' '] ) contare ) + [' parole.'], stop.
txt := txt da: 6 lunghezza: 4.
Uscita scrivi: txt, stop.

Programma spazzare.

memoriaUsata1 := (Programma memoria ? 0).


txt := ['World Salad'].
Uscita scrivi: ['questo testo contiene: '] + ( ( txt diviso: [' '] ) contare ) + [' parole.'], stop.
txt := txt da: 6 lunghezza: 4.
Uscita scrivi: txt, stop.

Programma spazzare.
memoriaUsata2 := (Programma memoria ? 0).


txt := ['World Salad'].
Uscita scrivi: ['questo testo contiene: '] + ( ( txt diviso: [' '] ) contare ) + [' parole.'], stop.
txt := txt da: 6 lunghezza: 4.
Uscita scrivi: txt, stop.

Programma spazzare.
memoriaUsata3 := (Programma memoria ? 0).



( memoriaUsata1 = memoriaUsata2 e: memoriaUsata1 = memoriaUsata3, e: memoriaUsata2 = memoriaUsata3 ) vero: {
	Uscita scrivi: ['Nessuna perdita di memoria qui'].
}, falso: {
	Uscita scrivi: ['Perdita di memoria...'].
}.
