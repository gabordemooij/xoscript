
>> Animal := Kipengee mpya.
Animal ikija: ['mpya'] fanya: { <- binafsi mpya init.
}.

Animal ikija: ['init'] fanya: {
	yangu sound := ['?'].
	yangu legs := 4.
}.

>> Dog := Animal mpya.
Dog ikija: ['init'] fanya: {
	binafsi init.
	yangu sound := ['barks'].
}.

Animal ikija: ['maandishi'] fanya: { <- yangu legs maandishi + yangu sound.
}.

>> poodle := Dog mpya.
Towe andika: poodle, mstari-mpya.

