Server init.
>> f := Umbizo mpya: ['%d'].
>> a := Blob mpya: 4.
a bytes: ( Orodha mpya ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob mpya: 4.
b bytes: ( Orodha mpya ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a kutoka: 0 urefu: 3, kila: { :i :byte
	Towe andika: ( f tekeleza-namba-kamili: byte ), mstari-mpya.
}.
a ^ b.
a kutoka: 0 urefu: 3, kila: { :i :byte
	Towe andika: ( f tekeleza-namba-kamili: byte ), mstari-mpya.
}.
a ^ b.
a kutoka: 0 urefu: 3, kila: { :i :byte
	Towe andika: ( f tekeleza-namba-kamili: byte ), mstari-mpya.
}.
a achilia.
b achilia.

{ a ^ Kipengee. } nasa: { :e Towe andika: e, mstari-mpya. }, anza.
