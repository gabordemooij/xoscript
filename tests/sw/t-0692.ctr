Server init.

Towe andika: (
	Ruwaza mpya: ['^\\w+$'],
	linganifu: ['test@example.com'] 
), mstari-mpya. # 0 match, fails on @ and .

Towe andika: (
	Ruwaza mpya: ['^[^@]+@[^\.]+\.\\w+$'],
	linganifu: ['test@example.com'] 
), mstari-mpya. # 1 match

Towe andika: (
	Ruwaza mpya: ['[^@]+@[^\.]+\.\\w+'],
	linganifu: ['test@example.com'] 
), mstari-mpya. # 1 match

Towe andika: (
	Ruwaza mpya: ['([^@]+)@([^\.]+)\.\\w+'],
	linganifu: ['test@example.com'] 
), mstari-mpya. # 1 match, groups dont matter

Towe andika: (
	Ruwaza mpya: ['[a-z]'],
	linganifu: ['test@example.com'] 
), mstari-mpya. # 14 matches

Towe andika: (
	Ruwaza mpya: ['.*'],
	linganifu: ['test@example.com'] 
), mstari-mpya. # 1 match (all)

Towe andika: (
	Ruwaza mpya: ['(.*)'],
	linganifu: ['test@example.com'] 
), mstari-mpya. # 1 match (all)

Towe andika: (
	Ruwaza mpya: ['\\s*[^@]+@[^\.]+\.\\w+'],
	linganifu: ['test@example.com'] 
), mstari-mpya. # 1 match, prefix space optional, gets ignored