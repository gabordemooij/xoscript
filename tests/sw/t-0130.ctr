# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Programu mpangilio: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server kiungo: ( Orodha mpya ;
 libname ; ['fopen'] ;
 ( Orodha mpya ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
kiungo: ( Orodha mpya ;
 Tupu ; # means same lib
 ['fread'] ;
 ( Orodha mpya ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Tupu ; # means same object (i.e. Stream)
 ['fread']
),
kiungo: (
 Orodha mpya ;
 Tupu ; # means same lib
 ['fwrite'] ;
 ( Orodha mpya ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Tupu ; # means same lib
 ['fwrite']
),
kiungo: (
 Orodha mpya ;
 Tupu ; # means same lib
 ['rewind'] ;
 ( Orodha mpya ; ['pointer'] ) ;
 ['int'] ;
 Tupu ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> njia-ya-faili := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: njia-ya-faili mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream ujumbe: ['fwrite'] hoja-zake: (Orodha mpya ; str ; 1 ; 6 ; fd ).
Towe andika: bytes-written, mstari-mpya.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob mpya: 20.

# read from file
>> bytes-read := Stream ujumbe: ['fread'] hoja-zake: (Orodha mpya ; buf ; 1 ; 6 ; fd ).
Towe andika: bytes-read, mstari-mpya.
Towe andika: buf, mstari-mpya.

# free memory
str  achilia.
njia-ya-faili achilia.
mode achilia.
buf  achilia.


