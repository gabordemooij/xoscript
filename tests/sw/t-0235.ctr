>> Slurp := Kipengee mpya.
Slurp ikija: ['mpya'] fanya: {
	yangu str := [''].
}.

Slurp ikija: ['jibu:'] fanya: { :blah
		(yangu str ≠ ['']) kweli: {
			yangu str ongeza-mwishoni: [' '].
		}.
		yangu str ongeza-mwishoni: blah.
}.
Slurp ikija: ['jibu:na:'] fanya: { :blah :blahah
		(yangu str ≠ ['']) kweli: {
			yangu str ongeza-mwishoni: [' '].
		}.
		(blah urefu > 1) kweli: {
			yangu str ongeza-mwishoni: (blah kutoka: 0 urefu: (blah urefu - 1)).
		}, vinginevyo: {
			yangu str ongeza-mwishoni: blah.
		}.
		yangu str ongeza-mwishoni: [' '].
		yangu str ongeza-mwishoni: blahah.
}.
Slurp ikija: ['obtain'] fanya: {
	>> buffer := yangu str.
	yangu str := ['']. <- buffer.
}.

>> s := Slurp mpya.
s hello: ['world'].
Towe andika: ( s obtain ), mstari-mpya.
