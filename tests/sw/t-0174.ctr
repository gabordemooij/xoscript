


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programu usimamizi-wa-kumbukumbu: 0.
>> palette := Tupu.
>> colors := Tupu.

{
palette := Kamusi mpya.
palette 
	weka: ['#F00'] kwenye: ['red'],
	weka: ['#0F0'] kwenye: ['green'],
	weka: ['#00F'] kwenye: ['blue'].
Towe andika: ['number of RGB codes in palette: '] + ( palette hesabu ), mstari-mpya.
Towe andika: ['RGB code of green is: '] + ( palette ? ['green'] ), mstari-mpya.
colors := [''].
( palette kila: { :jina :msimbo
		colors := colors + ( jina + [':'] + msimbo ).
} ).
Towe andika: ['All colors in palette: '] + colors, mstari-mpya.
} anza.
Programu safisha.
usedMemory1 := (Programu kumbukumbu ? 0).

