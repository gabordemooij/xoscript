# test number -> string -> number
{

	>> x := Nambari kati-ya: 0 na: 1000000.
	>> d := Nambari kati-ya: 1 na: 7.
	>> e := 10 kipeo-cha: d.

	x gawanya-kwa: e.
	>> y := x maandishi nambari.

	(x = y) uongo: {
		Towe andika: x, mstari-mpya.
		Towe andika: y, mstari-mpya.
		Programu maliza.
	}.

} * 1000.
Towe andika: ['OK'], mstari-mpya.