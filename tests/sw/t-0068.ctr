>> w := ['A_bottle_of_Whisky and a rare steak.'].
Towe andika: ['=== Basic test, grab the bottle! ==='], mstari-mpya.
Towe andika: ['>']+(w nakala kutoka:2 urefu: 6), mstari-mpya.
Towe andika: ['>']+(w nakala kutoka:8 urefu: -6), mstari-mpya.
Towe andika: ['>']+(w nakala kutoka:2 urefu: 6), mstari-mpya.
