Towe andika: ['Test object'], mstari-mpya.
>> a := Kipengee mpya. 

a ikija: ['item:'] fanya: { :hexhelper
	yangu hexhelper := hexhelper. 
}.

a ikija: ['item'] fanya: { <- yangu hexhelper.
}.

a item: Hx mpya.

>> old-hexhelper-address := a item kielelezo anwani-ya-kumbukumbu.
a save-as: ['/tmp/a.bin'].
Towe andika: ['========== RELOADING SNAP:'], mstari-mpya.

>> b := Kipengee load-from: ['/tmp/a.bin'].

(b item kielelezo anwani-ya-kumbukumbu = old-hexhelper-address) kweli: {
	Towe andika: ['Object link re-attached.'], mstari-mpya.
}.
