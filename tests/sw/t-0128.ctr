
Orodha ikija: ['sum'] fanya: {
	>> total := 0.
	binafsi kila: { :index :element
		total ongeza: element.
	}. <- total.
}.

>> a := Orodha ← 9 ; 8 ; 7.
Towe andika: (a sum), mstari-mpya. 
>> a := Orodha ← 1 ; 9.
Towe andika: (a sum), mstari-mpya. 
>> a := Orodha ← ['o'] ; 2.
Towe andika: (a sum), mstari-mpya. 
Towe andika: (Orodha mpya sum), mstari-mpya. 
