Towe andika: ['Test object'], mstari-mpya.
>> a := Kipengee mpya. 

a ikija: ['item:'] fanya: { :fmt
	yangu fmt := fmt. 
}.

a ikija: ['item'] fanya: { <- yangu fmt.
}.

a item: ( Umbizo mpya: ['|%s|'] ).

Towe andika: a item, mstari-mpya.

>> old-fmt-address := a item kielelezo anwani-ya-kumbukumbu.
a save-as: ['/tmp/a.bin'].
Towe andika: ['========== RELOADING SNAP:'], mstari-mpya.

>> b := Kipengee load-from: ['/tmp/a.bin'].

(b item kielelezo anwani-ya-kumbukumbu = old-fmt-address) kweli: {
	Towe andika: ['Object link re-attached.'], mstari-mpya.
}.

Towe andika: ( b item tekeleza: ['hello'] ), mstari-mpya.
