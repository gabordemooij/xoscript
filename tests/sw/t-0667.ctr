# test Program version

# this feature is disabled by default
Towe andika: (
	Programu kipengele: 
	['RECURSIVE_STRINTPOL']
), mstari-mpya.


# but if we set the time back
>> today := Muda 
kanda-ya-saa: ['CEST'],
kutoka: ['2026-02-15 10:00:00'].
Programu toleo: today.

# it will be enabled like it used to be (from now on)
Towe andika: (
	Programu kipengele: 
	['RECURSIVE_STRINTPOL']
), mstari-mpya.