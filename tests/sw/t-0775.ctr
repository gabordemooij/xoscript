Towe andika: ['Test object'], mstari-mpya.
>> l := Orodha mpya ; 1 ; ( Orodha mpya ; (Muda mpya: 1) ; (Int64 kutoka-maandishi: ['321']) ; (Orodha mpya ; 3)).
Towe andika: l, mstari-mpya.
>> old-lst-address := l kielelezo anwani-ya-kumbukumbu.
l save-as: ['/tmp/a.bin'].
Towe andika: ['========== RELOADING SNAP:'], mstari-mpya.
>> b := Kipengee load-from: ['/tmp/a.bin'].
(b kielelezo anwani-ya-kumbukumbu = old-lst-address) kweli: {
	Towe andika: ['Object link re-attached.'], mstari-mpya.
}.
Towe andika: b, mstari-mpya.
