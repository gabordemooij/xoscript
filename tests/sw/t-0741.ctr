Towe andika: ['Test object'], mstari-mpya.
>> a := Kipengee mpya. 

a ikija: ['item:'] fanya: { :octhelper
	yangu octhelper := octhelper. 
}.

a ikija: ['item'] fanya: { <- yangu octhelper.
}.

a item: Oct mpya.

>> old-octhelper-address := a item kielelezo anwani-ya-kumbukumbu.
a save-as: ['/tmp/a.bin'].
Towe andika: ['========== RELOADING SNAP:'], mstari-mpya.

>> b := Kipengee load-from: ['/tmp/a.bin'].

(b item kielelezo anwani-ya-kumbukumbu = old-octhelper-address) kweli: {
	Towe andika: ['Object link re-attached.'], mstari-mpya.
}.
