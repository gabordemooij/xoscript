

Orodha ikija: ['column:'] fanya: { :column
	>> result := Orodha mpya.
	binafsi kila: { :index :row
		row kila: { :index :cell
			(index = column) kweli: { result ongeza-mwishoni: cell. }.
		}.
	}. <- result.
}.


>> a := Orodha ←
	(Orodha ← 1 ; 2 ; 3) ;
	(Orodha ← 4 ; 5 ; 6) ;
	(Orodha ← 7 ; 8 ; 9).

>> b := a column: 1.
Towe andika: b, mstari-mpya.

b := a column: 20.
Towe andika: b, mstari-mpya.

b := a column: -100.
Towe andika: b, mstari-mpya.
