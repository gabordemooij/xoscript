#Linux
>> OS := Programu mfumo: (Amri uname -s), punguza-nafasi.

>> Slurp := Kipengee mpya.
Slurp ikija: ['mpya'] fanya: {
	yangu str := [''].
}.
Slurp ikija: ['jibu:'] fanya: { :blah
		(yangu str ≠ ['']) kweli: {
			yangu str ongeza-mwishoni: [' '].
		}.
		yangu str ongeza-mwishoni: blah.
}.
Slurp ikija: ['jibu:na:'] fanya: { :blah :blahah
		(yangu str ≠ ['']) kweli: {
			yangu str ongeza-mwishoni: [' '].
		}.
		(blah urefu > 1) kweli: {
			yangu str ongeza-mwishoni: (blah kutoka: 0 urefu: (blah urefu - 1)).
		}, vinginevyo: {
			yangu str ongeza-mwishoni: blah.
		}.
		yangu str ongeza-mwishoni: [' '].
		yangu str ongeza-mwishoni: blahah.
}.
Slurp ikija: ['obtain'] fanya: {
	>> buffer := yangu str.
	yangu str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text ongeza-mwishoni: ['hello'].
} × 1000.


Towe andika: (
	Programu mfumo: (
		Slurp mpya
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

