60 × {
	>> x := (Nambari random % 6) + 1.
	(x ≤ 6) uongo: { Towe andika: ['FAIL']. }.
	(x ≥0) uongo: { Towe andika: ['FAIL']. }.
	x := (Nambari random % 3) + 1.
	(x < 3) uongo: { Towe andika: ['FAIL']. }.
	(x>-1) uongo: { Towe andika: ['FAIL']. }.
	x := ((Buliani flip) nambari).
	(x = 0 au: x = 1) uongo: { Towe andika: ['FAIL']. }.
	x := ((Kweli flip) nambari).
	(x = 0 au: x = 1) uongo: { Towe andika: ['FAIL']. }.
	x := (Buliani flip ama: ['HEAD'] au: ['TAIL']).
	((x = ['HEAD']) au: (x = ['TAIL'])) uongo: { Towe andika: ['FAIL']. }.
}.
Towe andika: ['DONE'].

