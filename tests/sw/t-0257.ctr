
>> Greeter := Kipengee mpya.
Greeter ikija: ['mpya'] fanya: {
	yangu jina := ['?'].
}.
Greeter ikija: ['name:'] fanya: { :jina
	yangu jina := jina.
}.
Greeter ikija: ['greet'] fanya: {
	Towe andika: (['hello[you]'] [you]: yangu jina).
}.
>> friend := Greeter mpya.
friend name: ['1'].
friend greet.
