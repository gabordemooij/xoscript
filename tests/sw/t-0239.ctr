Orodha ikija: ['sum'] fanya: {
	>> total := 0.
	binafsi kila: { :index :element
		total ongeza: element.
	}. <- total.
}.

>> a := Kweli.



a ikija: ['maandishi'] fanya: {
	>> answer := Tupu.
	( binafsi = Kweli ) kweli: {
		answer := ['Yep'].
	}, vinginevyo: {
		answer := ['Nope'].
	}. <- answer.
}.

a ikija: ['nambari'] fanya: {
	>> answer := Tupu.
	( binafsi = Kweli ) kweli: {
		answer := 10.
	}, vinginevyo: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b ikija: ['maandishi'] fanya: { <- ['Devil'].
}.

b ikija: ['buliani'] fanya: { <- Uongo.
}.


Towe andika: a, mstari-mpya.  
Towe andika: (90 + a), mstari-mpya. 
Towe andika: b, mstari-mpya. 
Towe andika: (Kweli na: b), mstari-mpya.

a := Orodha ← ['hello'] ; ['world'] ; Kweli ; Tupu ; 666. 
a := a + ( Orodha ← 1 ).
Towe andika: a, mstari-mpya.
Towe andika: ((Kamusi mpya) weka: Tupu kwenye: Tupu), mstari-mpya.
Towe andika: a sum, mstari-mpya. 


{
	a ikija: ['maandishi'] fanya: { <- Tupu. }.
	a := [''] + a.
} nasa: { :error
	Towe andika: ['Error noted: '] + error, mstari-mpya.
}, anza.



{
	a ikija: ['nambari'] fanya: { <- Tupu. }.
	a := 3 × a.
} nasa: { :error
	Towe andika: ['Error noted: '] + error, mstari-mpya.
}, anza.


{
	a ikija: ['buliani'] fanya: { <- Tupu. }.
	a := Kweli na: a. 
} nasa: { :error
	Towe andika: ['Error noted: '] + error, mstari-mpya.
}, anza.





