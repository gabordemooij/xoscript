Server init.
Towe andika: ['Database time test'], mstari-mpya.

>> db := Maria-DB mpya mwenyeji: ['localhost'],
	jina-la-mtumiaji: ['xo'], 
	nywila: ['pass123'],
	jina-la-hifadhidata: ['xobase'],
	unganika.

>> vigezo-vya-utafutaji :=
db ulizo: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
leta: { :row
	Towe andika: row timetest, mstari-mpya.
}.
