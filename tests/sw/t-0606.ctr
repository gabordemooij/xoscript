>> Point := Kipengee mpya.
Point ikija: ['x-coordinate:'] fanya: { :x yangu x := x. }.
Point ikija: ['y-coordinate:'] fanya: { :y yangu y := y. }.
Point ikija: ['x-coordinate']  fanya: { <- yangu x nakala. }.
Point ikija: ['y-coordinate']  fanya: { <- yangu y nakala. }.

Point ikija: ['='] fanya: { :other <- ( yangu x = other x-coordinate
		 na: yangu y = other y-coordinate ).
}.

>> pier := Point mpya x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point mpya x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point mpya x-coordinate: 5, y-coordinate: 6.

Towe andika: pier = town-hall, mstari-mpya.
Towe andika: pier = restaurant, mstari-mpya.
