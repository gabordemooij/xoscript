Server init.

>> DB := Maria-DB mpya mwenyeji: ['localhost'],
	jina-la-mtumiaji: ['xo'],
	nywila: ['pass123'],
	jina-la-hifadhidata: ['xobase'],
	unganika.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> vigezo-vya-utafutaji := Hoja-ya-Maria mpya: SQL.

# set database
vigezo-vya-utafutaji hifadhidata: DB.

vigezo-vya-utafutaji leta: { :row
	Towe andika: row world, mstari-mpya.
}.
