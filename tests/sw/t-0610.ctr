
>> Rectangle := Kipengee mpya.

Rectangle ikija: ['area'] fanya: { <- yangu urefu * yangu width.
}.

Rectangle ikija: ['length:'] fanya: { :urefu
	yangu urefu := urefu.
}.

Rectangle ikija: ['width:'] fanya: { :width
	yangu width := width.
}.

Rectangle ikija: ['mpya'] fanya: {
	# this will not result into an infinite loop
	>> rectangle := binafsi mpya.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle mpya.
Towe andika: a area, mstari-mpya. #0

>> b := Rectangle mpya length: 2, width: 3.
Towe andika: b area, mstari-mpya. #6

