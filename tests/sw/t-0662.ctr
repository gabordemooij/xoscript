>> t := Tupu.

# you can control the time zone for
# parsing like this:
Muda kanda-ya-saa: ['CET'].
t := Muda kutoka: ['1981-02-03 04:05:06'].
Towe andika: t, mstari-mpya.

# now using CEST time zone:
Muda kanda-ya-saa: ['CEST'].
t := Muda kutoka: ['1981-02-03 04:05:06'].
Towe andika: t, mstari-mpya.

# error if string cannot be parsed
{ Muda kutoka: ['1900']. } nasa: { Tupu. }, anza.
