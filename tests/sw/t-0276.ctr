>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Kipengee mpya.
⚄ ikija: ['drawFrom:length:'] fanya: { :pool :hesabu
	
	>> result := [''].
	
	{
		>> index := Nambari random % (pool urefu).
		result ongeza-mwishoni: ( pool herufi: (index + 1) ).
		
	} × hesabu. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? urefu.
Towe andika: (['x↵'] x random urefu).
Towe andika: (['y↵'] y ?? urefu).

