# test list operations


>> cakes := Orodha ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes badilisha: 1 urefu: 2 kwa: ( Orodha ← ['cinnamon'] ; ['pineapple'] ).
Towe andika: (buy unganisha: [',']), mstari-mpya.


>> buy := cakes badilisha: 1 urefu: 12 kwa: ( Orodha ← ['cinnamon'] ; ['pineapple'] ).
Towe andika: (buy unganisha: [',']), mstari-mpya.


>> buy := cakes badilisha: 2 urefu: 10 kwa: ( Orodha mpya ).
Towe andika: (buy unganisha: [',']), mstari-mpya.


>> buy := cakes badilisha: 0 urefu: 1 kwa: ( Orodha mpya ).
Towe andika: (buy unganisha: [',']), mstari-mpya.


>> buy := cakes badilisha: ['0'] urefu: ['1'] kwa: ['x'].
Towe andika: (buy unganisha: [',']), mstari-mpya.
