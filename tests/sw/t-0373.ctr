# compliance test

# use international numbers

Towe andika: ['1000 -> '].
Towe andika: 1000, mstari-mpya. #1000

Towe andika: ['1.5 -> '].
Towe andika: 1.5, mstari-mpya.  #1.5

Towe andika: ['1001.5 -> '].
Towe andika: 1.5 + 1000, mstari-mpya. #1001.5

# use 0-indexed arrays
>> x := Orodha mpya ; 1 ; 2 ; 3.
>> y := Orodha mpya ; ['a'] ; ['b'] ; ['c'].

Towe andika: ['1 -> '].
Towe andika: x ? 0, mstari-mpya. #1

Towe andika: ['1 -> '].
Towe andika: (x katika: 0), mstari-mpya. #1

Towe andika: ['1 -> '].
Towe andika: x wa-kwanza, mstari-mpya. #1

Towe andika: ['3 -> '].
Towe andika: x wa-mwisho, mstari-mpya. #3

Towe andika: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Towe andika: (x kwa: y), mstari-mpya.

Towe andika: ['1 -> '].
Towe andika: (x kutoka: 0 urefu: 1) wa-kwanza, mstari-mpya. #1

Towe andika: ['0 -> '].
Towe andika: (x tafuta: 1), mstari-mpya. #0

x weka: 9 kwenye: 0.

Towe andika: ['9 -> '].
Towe andika: (x katika: 0), mstari-mpya. #9

x ongeza-mwanzoni: 8.
Towe andika: ['8 -> '].
Towe andika: (x katika: 0), mstari-mpya. #9


x ongeza-mwishoni: 10.
Towe andika: ['10 -> '].
Towe andika: (x katika: 4), mstari-mpya. #10








