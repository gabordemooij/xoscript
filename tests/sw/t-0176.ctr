

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programu usimamizi-wa-kumbukumbu: 0.

>> txt := ['Word Salad'].
Towe andika: ['Text Length: '] + txt urefu, mstari-mpya.
Towe andika: ['Character at 2:'] + ( txt herufi: 2 ), mstari-mpya.
Towe andika: (( txt tafuta: ['S'] ) - 0), mstari-mpya.

Programu safisha.

usedMemory1 := (Programu kumbukumbu ? 0).


