#Linux
>> clock := Muda mpya.
clock kanda-ya-saa: ['UTC-1'].
clock mwaka: 1981, mwezi: 1, siku: 5,
      saa: 13, dakika: 15, sekunde: 13.

Towe andika: clock, mstari-mpya.
clock kanda-ya-saa: ['UTC+0'].

Towe andika: (
	(clock mwaka ghafi) + ['-'] + (clock mwezi) + ['-'] + (clock siku) + [' '] +
	(clock saa) + [':'] + (clock dakika) + [':'] + (clock sekunde) + [' '] +
	['W'] + (clock wiki) + (clock kanda-ya-saa)
), mstari-mpya.


clock kanda-ya-saa: ['UTC-1'].
Towe andika: (
	(clock mwaka ghafi) + ['-'] + (clock mwezi) + ['-'] + (clock siku) + [' '] +
	(clock saa) + [':'] + (clock dakika) + [':'] + (clock sekunde) + [' '] +
	['W'] + (clock wiki) + (clock kanda-ya-saa)
), mstari-mpya.
