


>> wine := Kipengee mpya.


wine ikija: ['toString'] fanya: { <- ['merlot'].
}.

wine ikija: ['naarTekst'] fanya: { <- ['merlot'].
}.


wine ikija: ['='] fanya: { :other wine <- ( binafsi toString = other wine ).
}.

wine ikija: ['=='] fanya: { :other wine <- ( binafsi toString = other wine ).
}.



wine
	ikiwa: ['cabernet'] fanya: { Towe andika: ['it's a Cabernet!']. },
	ikiwa: ['syrah']    fanya: { Towe andika: ['it's a Syrah!'].    },
	ikiwa: ['merlot']   fanya: { Towe andika: ['it's a Merlot!'].   },
	ikiwa: ['malbec']   fanya: { Towe andika: ['it's a Malbec!'].   }.

Towe mstari-mpya.
