>> del := conn1 ulizo: ['DELETE FROM book WHERE id > 0'].
{  del endesha. conn1 thibitisha. } nasa: { :e conn1 rudisha-nyuma.  }, anza.

>> insert := conn1 ulizo: ['INSERT INTO book (id) VALUES(null)'].
insert endesha.

>> hesabu := conn1 ulizo: ['SELECT COUNT(*) AS num FROM book'].
hesabu leta: { :row Towe andika: row num, mstari-mpya. }.

# does not show up
