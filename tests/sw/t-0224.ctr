
>> countries := Orodha mpya
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Orodha mpya
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods kwa: countries, kila: { :key :value
	counter ongeza: 1.
}.

Towe andika: (['we serve counter dishes'] counter: counter), mstari-mpya.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] herufi-zote panga: { :v
	counter ongeza: 0.
}.

Towe andika: (['we sort counter dishes'] counter: counter), mstari-mpya.


>> counter := 0.
{
	{
		counter ongeza: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Towe andika: (['we calculate counter numbers.'] counter: counter), mstari-mpya.

