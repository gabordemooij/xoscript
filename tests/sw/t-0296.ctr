
>> shop := (Kamusi mpya
	weka: ['magazine'] kwenye: ['books'],
	weka: ['computer'] kwenye: ['electronics'],
	weka: ['lipstick'] kwenye: ['cosmetics']
).
Towe andika: (shop ina: ['computer']), mstari-mpya. 
Towe andika: (shop ina: ['sausage']), mstari-mpya. 
Towe andika: (shop ina: ['computers']), mstari-mpya. 
Towe andika: (shop ina: ['compute']), mstari-mpya. 
Towe andika: (shop ina: ['2computer']), mstari-mpya. 
