
Maandishi ikija: ['evaluate'] fanya: {
	>> msimbo := Faili mpya: ['/tmp/eval.ctr'].
	msimbo andika: (binafsi maandishi + ['.']).
	Programu tumia: ['/tmp/eval.ctr'].
}.

>> map :=
	(Kamusi mpya)
	weka: ['Hi There'] kwenye: ['two'],
	weka: (Orodha ← ['hello'] ; ['world'] ; (Orodha ← 1 ; 2; 9) ; Uongo) kwenye: ['one'],
	weka: ( (Kamusi mpya) weka: ['wrrld'] kwenye: ['misspelled'] ) kwenye: ['three'],
	weka: (Orodha ← ((Kamusi mpya) weka: ['treasure'] kwenye: ['hidden']) ; 2) kwenye: ['four']. 
>> str := map maandishi.
>> map2 := Tupu.
(['map2 := '] + str ) evaluate.
Towe andika: map2 ? ['one'] ? 0.
Towe andika: map2 ? ['one'] ? 1.
Towe andika: map2 ? ['four'] ? 0 ? ['hidden'].
Towe andika: map2 ? ['one'] ? 2 ? 2.
