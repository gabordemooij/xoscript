Towe andika: ['Test object'], mstari-mpya.
>> greeter := Kipengee mpya.
greeter ikija: ['name:'] fanya: { :jina
	yangu xname := jina. 
}.
greeter ikija: ['greet'] fanya: {
	Towe andika: ['Hello '] + yangu xname, mstari-mpya.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Towe andika: ['========== RELOADING SNAP:'], mstari-mpya.
>> b := Kipengee load-from: ['/tmp/a.bin'].
>> c := Kipengee load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
