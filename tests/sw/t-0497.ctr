Server init.

# write a test file
>> f := Faili mpya: ['/tmp/test.gif'].
f andika: ['GIF87a01234567810'].

# serve the file
Server pitisha: ['test.gif'] kiambishi: ['/tmp/'].

Towe mstari-mpya.

Towe andika: ['Outside container (security):'], mstari-mpya.
{ Server pitisha: ['../passwd'] kiambishi: ['/tmp/']. }
nasa: { :e Towe andika: e, mstari-mpya. },
anza.

Towe andika: ['Invalid prefix:'], mstari-mpya.
{ Server pitisha: ['test.gif'] kiambishi: ['z:\\']. }
nasa: { :e Towe andika: e, mstari-mpya. },
anza.

Towe andika: ['Non-existant file:'], mstari-mpya.
