# from:length: counts characters and survives very large numbers
>> s := ['ééééééééééééééé'].
Towe andika: (s nakala kutoka: 0 urefu: 20), mstari-mpya.
Towe andika: (s nakala kutoka: 10 urefu: 20), mstari-mpya.
Towe andika: (s nakala kutoka: 14 urefu: 1), mstari-mpya.
Towe andika: (s nakala ruka: 20), mstari-mpya.
Towe andika: ['-'], mstari-mpya.
Towe andika: (['abcdef'] kutoka: 2 urefu: 2), mstari-mpya.
Towe andika: (['abc'] kutoka: 1 urefu: ['9e300'] nambari), mstari-mpya.
Towe andika: (['abc'] kutoka: 1 urefu: ['-9e300'] nambari), mstari-mpya.
Towe andika: (['abc'] kutoka: ['9e300'] nambari urefu: 1), mstari-mpya.
Towe andika: ['-'], mstari-mpya.
Towe andika: (['abc'] kutoka: ['-9e300'] nambari urefu: 2), mstari-mpya.
Towe andika: (['abc'] kutoka: ['nan'] nambari urefu: 2), mstari-mpya.
Towe andika: (['abc'] kutoka: 0 urefu: ['nan'] nambari), mstari-mpya.
Towe andika: ['-'], mstari-mpya.
