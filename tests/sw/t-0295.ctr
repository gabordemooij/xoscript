
>> dictionary := (
	Kamusi mpya
		weka: ['b'] kwenye: ['a'],
		weka: ['a'] kwenye: ['b'],
		weka: ['z'] kwenye: ['x'],
		weka: ['hello'] kwenye: ['hallo'],
		weka: ['human'] kwenye: ['human']
).

>> comparisons := Orodha mpya.
dictionary kila: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a linganisha: b)
	).
}.

comparisons panga: { :a :b <- ( a linganisha: b ). }.
Towe andika: ( comparisons unganisha: ['↵'] ), mstari-mpya.
comparisons unganisha: ['↵'].
