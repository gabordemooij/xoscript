>> a := Orodha ← Kipengee ; Kweli ; Uongo ; Buliani ; 1 ; Nambari ; ['Str'] ; Maandishi ; { ['Empty']. }.
Towe andika: (a hesabu), mstari-mpya.
{ :i
	Towe andika: 
	['a '] + 
	((a ? i) aina) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Tupu?) ama: [''] au: ['NOT']) + 
	[' Nil.'],
	mstari-mpya.
} × (a hesabu).
Towe andika: ['but.. Nil is.. '] + ((Tupu Tupu?) ama: ['certainly NIL!'] au: ['not NIL??']), mstari-mpya.