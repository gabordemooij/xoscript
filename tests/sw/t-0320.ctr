


>> CoffeeMachine := Kipengee mpya.
CoffeeMachine ikija: ['order:'] fanya: { :id
	>> coffee := ['Americano'].
	( id = 1 ) kweli: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) kweli: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) kweli: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Kipengee mpya.
SimpleCoffeeMachine ikija: ['order'] fanya: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Towe andika: redCup, mstari-mpya.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Towe andika: greenCup, mstari-mpya.
>> yellowCup := CoffeeMachine order: 1.
Towe andika: yellowCup, mstari-mpya.
>> blueCup := CoffeeMachine order: 0.
Towe andika: blueCup, mstari-mpya.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Towe andika: blackCup, mstari-mpya.
blackCup ongeza-mwishoni: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Towe andika: orangeCup, mstari-mpya.
