Maandishi ikija: ['html'] fanya: { <- (
		binafsi
		badilisha: ['&'] kwa: ['&amp;'],
		badilisha: ['<'] kwa: ['&lt;'],
		badilisha: ['>'] kwa: ['&gt;'],
		badilisha: ['''] kwa: ['&apos;'],
		badilisha: ['"'] kwa: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programu usimamizi-wa-kumbukumbu: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Towe andika: txt nakala html, mstari-mpya.
Towe andika: txt nakala herufi-ndogo, mstari-mpya.
Towe andika: txt nakala herufi-kubwa, mstari-mpya.
} anza.

Programu safisha.

usedMemory1 := (Programu kumbukumbu ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Towe andika: txt nakala html, mstari-mpya.
Towe andika: txt nakala herufi-ndogo, mstari-mpya.
Towe andika: txt nakala herufi-kubwa, mstari-mpya.
} anza.

Programu safisha.
usedMemory2 := (Programu kumbukumbu ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Towe andika: txt nakala html, mstari-mpya.
Towe andika: txt nakala herufi-ndogo, mstari-mpya.
Towe andika: txt nakala herufi-kubwa, mstari-mpya.
} anza.

Programu safisha.
usedMemory3 := (Programu kumbukumbu ? 0).



( usedMemory1 = usedMemory2 na: usedMemory1 = usedMemory3, na: usedMemory2 = usedMemory3 ) kweli: {
	Towe andika: ['No memory leaks here'].
}, uongo: {
	Towe andika: ['Leaking memory...'].
}.
