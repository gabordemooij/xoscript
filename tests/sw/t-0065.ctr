Nambari ikija: ['factorial'] fanya: {
	>> total := 1.
	{ :index total zidisha-kwa: (binafsi - (index)). } × binafsi. <- total.
}.
>> Printer := Kipengee mpya.
Printer ikija: ['print:and:'] fanya: { :x :y
	Towe andika: ['a='] + x + [', b='] + y, mstari-mpya.
}.
>> a := 4.5. >> b := a kadiria-chini.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a kadiria-juu.
Printer print: a and: b.
a := 4.5. b := a kadiria-chini.
Printer print: a and: b.
a := 4.5. b := a kadiria.
Printer print: a and: b.
a := 4.2. b := a kadiria.
Printer print: a and: b.

Towe andika: (9 baki: 5), mstari-mpya.
Towe andika: -666 thamani-kamili, mstari-mpya.
Towe andika: 49 kipeuo-cha-pili, mstari-mpya.
Towe andika: (2 kipeo-cha: 3), mstari-mpya.
>> l := (Orodha ← 9 ; 6).
Towe andika: l kiwango-cha-chini.

