

>> Matryoshka := Kipengee mpya.
Matryoshka ikija: ['double:'] fanya: { :secret
	yangu secret := secret × 2.
}.
Matryoshka ikija: ['mpya:'] fanya: { :secret
	>> answer := Tupu.
	>> t := (secret > 255).
	Towe andika: (secret + [' | '] + t), mstari-mpya.
	t kweli: {
		answer := secret.
	}, vinginevyo: {
		answer := Matryoshka kujirudia mpya: (binafsi double: secret).
	}. <- answer.
}.

>> x := Matryoshka mpya: 2.
