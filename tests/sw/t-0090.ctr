Towe andika: ['1,2,3,4,5,6,7,8,9,A,'], mstari-mpya.
>> Scope := Kipengee mpya.
Scope ikija: ['initialize:'] fanya: { :x yangu property := x. }.
Scope ikija: ['confirm'] fanya: { Towe andika: [',']. }.
Scope ikija: ['jaribio'] fanya: {
	Towe andika: yangu property.
	binafsi confirm.
	( 1 = 1 ) kweli: { Towe andika: yangu property. binafsi confirm. }.
	( 1 = 0 ) uongo: { Towe andika: yangu property. binafsi confirm. }.
	>> y := 2. { Towe andika: yangu property. binafsi confirm. } wakati-wa: { y toa: 1. <- (y > 0). }.
	{ Towe andika: yangu property. binafsi confirm. } × 1.
	(Orodha ← 1) kila: {  Towe andika: yangu property. binafsi confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Kamusi mpya one: ['item']) kila: { Towe andika: yangu property. binafsi confirm. }.
	{ 1 ÷ 0. } nasa: { Towe andika: yangu property. binafsi confirm. }, anza.
	Towe mstari-mpya.
}.
>> scope1 := Scope mpya.
scope1 initialize: ['X'].
scope1 jaribio.
>> function := { 
	yangu property := ['Y'].
	Towe andika: yangu property.
	binafsi confirm.
	( 1 = 1 ) kweli: { Towe andika: yangu property. binafsi confirm. }.
	( 1 = 0 ) uongo: { Towe andika: yangu property. binafsi confirm. }.
	>> y := 2. { Towe andika: yangu property. binafsi confirm. } wakati-wa: { y toa: 1. <- (y > 0). }.
	{ Towe andika: yangu property. binafsi confirm. } × 1.
	(Orodha ← 1) kila: {  Towe andika: yangu property. binafsi confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Kamusi mpya one: ['item']) kila: { Towe andika: yangu property. binafsi confirm. }.
	{ 1 ÷ 0. } nasa: { Towe andika: yangu property. binafsi confirm. }, anza.
	Towe mstari-mpya.
}.
function ikija: ['confirm'] fanya: { Towe andika: [',']. }.
function tekeleza: 1 na: 2.
