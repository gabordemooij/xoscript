Server init.
>> fmt := Umbizo mpya: ['%#3x'].

>> blob := Blob mpya: 4.
blob bytes: ( 
	Orodha mpya ; 0 ; 1 ; 2 ; 3
).

>> file := Faili mpya: ['/tmp/blob'].
file blob: blob.
blob achilia.

>> soma := file blob.
soma 
kutoka: 0 
urefu: 4, 
fanya kila: { :i :b 
	Towe
	andika: (fmt tekeleza-namba-kamili: b),
	mstari-mpya.
}.
soma achilia.
