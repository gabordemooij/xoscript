
>> XX := Kipengee mpya.
>> X := Kipengee mpya.

XX ikija: ['QQ'] fanya: { <- 1. }.
XX ikija: ['Q'] fanya: { <- 1. }.
XX ikija: ['QQ:'] fanya: { <- 1. }.
XX ikija: ['QQ:QQ:'] fanya: { <- 1. }.

X ikija: ['QQ'] fanya: { <- 1. }.
X ikija: ['Q'] fanya: { <- 1. }.
X ikija: ['QQ:'] fanya: { <- 1. }.
X ikija: ['QQ:QQ:'] fanya: { <- 1. }.

Towe andika: (Programu XX), mstari-mpya.
Towe andika: (Programu tafuta: ['XX']), mstari-mpya.
Towe andika: (Programu tafuta: ['X']), mstari-mpya.

Towe andika: (Programu XX: ['QQ']), mstari-mpya.
Towe andika: (Programu XX: ['Q']), mstari-mpya.
Towe andika: (Programu XX: ['QQ:']), mstari-mpya.
Towe andika: (Programu XX: ['QQ:QQ:']), mstari-mpya.

Towe andika: (Programu X: ['QQ']), mstari-mpya.
Towe andika: (Programu X: ['Q']), mstari-mpya.
Towe andika: (Programu X: ['QQ:']), mstari-mpya.
Towe andika: (Programu X: ['QQ:QQ:']), mstari-mpya.

Towe andika: (Programu X ['QQ']), mstari-mpya.
Towe andika: (Programu X ['Q']), mstari-mpya.
Towe andika: (Programu X ['QQ:']), mstari-mpya.
Towe andika: (Programu X ['QQ:QQ:']), mstari-mpya.

Towe andika: (Programu YY), mstari-mpya.
Towe andika: (Programu tafuta: ['YY']), mstari-mpya.
Towe andika: (Programu tafuta: ['Y']), mstari-mpya.

Towe andika: (Programu YY: ['QQ']), mstari-mpya.
Towe andika: (Programu YY: ['Q']), mstari-mpya.
Towe andika: (Programu YY: ['QQ:']), mstari-mpya.
Towe andika: (Programu YY: ['QQ:QQ:']), mstari-mpya.

Towe andika: (Programu Y: ['QQ']), mstari-mpya.
Towe andika: (Programu Y: ['Q']), mstari-mpya.
Towe andika: (Programu Y: ['QQ:']), mstari-mpya.
Towe andika: (Programu Y: ['QQ:QQ:']), mstari-mpya.

Towe andika: (Programu Y ['QQ']), mstari-mpya.
Towe andika: (Programu Y ['Q']), mstari-mpya.
Towe andika: (Programu Y ['QQ:']), mstari-mpya.
Towe andika: (Programu Y ['QQ:QQ:']), mstari-mpya.

Towe andika: (Programu X: -1), mstari-mpya.
Towe andika: (Programu X Tupu), mstari-mpya.

