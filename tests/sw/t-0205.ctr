>> str := ['write:'].
Towe ujumbe: ['andika:'] hoja-zake: (Orodha ← ['Hello World']), mstari-mpya. 

Nambari ikija: ['isbetween:and:'] fanya: { :a :b <- ((binafsi ≥ a) na: (binafsi ≤ b)).
}.

str := ['isbetween:and:'].
Towe andika: (3 ujumbe: str hoja-zake: (Orodha ← 2 ; 8)), mstari-mpya.
Towe andika: (3 ujumbe: str hoja-zake: (Orodha ← 1 ; 2)), mstari-mpya.


>> CoffeeMachine := Kipengee mpya.
CoffeeMachine ikija: ['makeCoffeeWithSugar:milk:'] fanya: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Orodha ← 4 ; 2.
Towe andika: ( CoffeeMachine ujumbe: order hoja-zake: coffeeConfiguration ), mstari-mpya.
