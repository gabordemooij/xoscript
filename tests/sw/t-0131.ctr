
>> a := Orodha ← (Orodha ← 100 ; 200 ; 300) ; (Orodha ← 9 ; 8 ; 7).
Towe andika: ['at 0,1 :'].
Towe andika: a ? 0 ? 1, mstari-mpya. 
Towe andika: ['at 1,2 :'].
Towe andika: a ? 1 ? 2, mstari-mpya. 
>> menu := Kamusi mpya.
menu weka: (Orodha ← ['pizza'] ; ['spaghetti']) kwenye: ['Italian Cuisine'].
menu weka: (Orodha ← ['bifteki'] ; ['suflaki']) kwenye: ['Greek Cuisine'].
Towe andika: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), mstari-mpya. 
Towe andika: ['but not on the same plate.'], mstari-mpya.
