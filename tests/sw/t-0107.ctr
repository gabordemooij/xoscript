
Towe andika: ['Break for-loop, 0-4.'], mstari-mpya.
{ :i
	Towe andika: ['iteration #'] + i, mstari-mpya.
	(i = 4) vunja.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Towe andika: ['Break while-true loop, 0-4.'], mstari-mpya.
{
	Towe andika: ['iteration #'] + x, mstari-mpya.
	x ongeza: 1.
	((x < 5) kinyume) vunja.
} wakati-wa: xIsLessThan10.

Towe andika: ['Break while-false loop, 5,4.'], mstari-mpya.
{
	Towe andika: ['iteration #'] + x, mstari-mpya.
	x toa: 1.
	(x = 3) vunja.
} wakati-wa: { <- (x > 0). }.

Towe andika: ['Break times loop, 1-4.'], mstari-mpya.
{ :i
	Towe andika: ['iteration #'] + i, mstari-mpya.
	(i = 4) vunja.
} × 5.

Towe andika: ['Break block, dont print line.'], mstari-mpya.
{ Kweli vunja. Towe andika: ['dont write this!'], mstari-mpya. } anza.

Towe andika: ['Break block, dont fire catch...'], mstari-mpya.
{ Kweli vunja. Towe andika: ['dont write this!'], mstari-mpya. } nasa: { Towe andika: ['Dont catch this!']. }, anza.

Towe andika: ['Test Array each-loop: 0,1'], mstari-mpya.
(Orodha ← 1 ; 2 ; 3) geuza: { :i
	Towe andika: ['iteration #'] + i, mstari-mpya.
	(i = 1) vunja.
}.

Towe andika: ['Test Map each-loop: c only'], mstari-mpya.
>> m := Kamusi mpya.
m weka: ['first'] kwenye: ['a'], weka: ['second'] kwenye: ['b'], weka: ['third'] kwenye: ['c'].
m kila: { :k :v
	Towe andika: ['iteration'] + v + k, mstari-mpya.
	Kweli vunja.
}.

