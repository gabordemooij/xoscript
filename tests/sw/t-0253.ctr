#Linux
>> OS := Programu mpangilio: ['OS'].

>> clock := Muda mpya.
	
(OS = ['Haiku']) kweli: {
	clock kanda-ya-saa: ['CET'],
	mwaka: 2017, mwezi: 7, siku: 13,
	saa: 18, dakika: 0, sekunde: 0.
}, vinginevyo: {
	clock kanda-ya-saa: ['Europe/Amsterdam'],
	mwaka: 2017, mwezi: 7, siku: 13,
	saa: 18, dakika: 0, sekunde: 0.
}.

clock ikija: ['tell'] fanya: {
	Towe andika: binafsi, mstari-mpya.
}.


clock ongeza: 2    saa, tell.
clock ongeza: 1    saa, tell.
clock ongeza: 19 dakika, tell.
clock ongeza: 1  dakika, tell.
clock ongeza: 1  dakika, tell.
clock ongeza: 19 sekunde, tell.
clock ongeza: 1  sekunde, tell.
clock ongeza: 1  sekunde, tell.
clock ongeza: 2    mwaka, tell.
clock ongeza: 1    mwaka, tell.

(OS = ['Haiku']) kweli: {
clock ongeza: 5   mwezi.
clock kanda-ya-saa: ['CEST'], tell.
}, vinginevyo: {
	clock ongeza: 5   mwezi, tell.
}.

clock ongeza: 1   mwezi, tell.
clock ongeza: 19    siku, tell.
clock ongeza: 1    saa, tell.
clock ongeza: 120  yard, tell.
