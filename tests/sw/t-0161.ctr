Programu usimamizi-wa-kumbukumbu: 0.
Orodha ikija: ['sum'] fanya: {
	>> total := 0.
	binafsi kila: { :index :element
		total ongeza: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Faili mpya: ['/tmp/test.txt'].
f andika: ['Lorem Ipsum'].
f funga.
  

f := Faili mpya: ['/tmp/test.txt'].
>> text := f soma.
f funga.



Programu safisha.
usedMemory1 := (Programu kumbukumbu ? 1).



f := Faili mpya: ['/tmp/test.txt'].
text := f soma.
f funga.

