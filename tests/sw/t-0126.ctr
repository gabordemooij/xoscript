#Linux
>> Slurp := Kipengee mpya.

Slurp ikija: ['mpya'] fanya: {
	yangu str := [''].
}.

Slurp ikija: ['nieuw'] fanya: {
	yangu str := [''].
}.

Slurp ikija: ['jibu:'] fanya: { :blah
		yangu str ongeza-mwishoni: blah.
}.

Slurp ikija: ['jibu:na:'] fanya: { :blah :blahah
		yangu str ongeza-mwishoni: (blah kutoka: 0 urefu: (blah urefu - 1)).
		yangu str ongeza-mwishoni: [' '].
		yangu str ongeza-mwishoni: blahah.
}.

Slurp ikija: ['obtain'] fanya: {
	>> buffer := yangu str.
	yangu str := ['']. <- buffer.
}.


Towe andika: (Programu mfumo: (Slurp mpya echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Faili mpya: ['/tmp/from.txt'], futa. } nasa: { ['Empty']. }, anza.
{ Faili mpya: ['/tmp/to.txt'], futa. } nasa: { ['Empty']. }, anza.


Faili mpya: ['/tmp/to.txt'], ipo uongo: {
	Towe andika: ['Confirmed. Target file does not exist.\
'].
}.
Faili mpya: ['/tmp/from.txt'], ipo uongo: {
	Towe andika: ['Confirmed. Source file does not exist.\
'].
}.



Programu mfumo: (Slurp mpya touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Programu mfumo: (Slurp mpya cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Faili mpya: ['/tmp/to.txt'], ipo kweli: {
	Towe andika: ['Confirmed. Target file has been created by shell.\
'].
}.


Towe andika: ['Contents of file is:'] + (Faili mpya: ['/tmp/to.txt'], soma), mstari-mpya.
