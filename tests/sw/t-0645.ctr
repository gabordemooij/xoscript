Server init.
Towe andika: ['Database date test'], mstari-mpya.

>> db := Maria-DB mpya mwenyeji: ['localhost'],
	jina-la-mtumiaji: ['xo'], 
	nywila: ['pass123'],
	jina-la-hifadhidata: ['xobase'],
	unganika.

>> vigezo-vya-utafutaji :=
db ulizo: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
leta: { :row
	Towe andika: row datetest, mstari-mpya.
}.
