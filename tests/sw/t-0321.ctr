# test qualifiers

Programu safisha.

>> Fruit := Kipengee mpya.
Fruit ikija: ['mpya'] fanya: {
	>> f := binafsi mpya.
	f apples: 0. <- f.
}.
Fruit ikija: ['apples:'] fanya: { :a yangu apples := a. }.
Fruit ikija: ['apples'] fanya: { <- yangu apples. }.
Fruit ikija: ['+'] fanya: { :f
	>> n := Fruit mpya.
	n apples: (f apples + yangu apples). <- n.
}.
Nambari ikija: ['apples'] fanya: { <- ((Fruit mpya) apples: binafsi).
}.

Fruit ikija: ['maandishi'] fanya: { <- yangu apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Towe andika: q, mstari-mpya.




q := 3 apples + 4 apples.
Towe andika: q, mstari-mpya.



q := 3 apples + 4 apples.
Towe andika: q, mstari-mpya.


