# a quote that never closes must give an error, not an endless loop
>> njia-ya-faili := ['/tmp/test0821.csv'].
>> file := Faili mpya: njia-ya-faili.

file andika: ['a,b\n"1,2\n'].
{
	file kitenganishi: [','] nukuu: ['"'] mistari: { :line
		Towe andika: line, mstari-mpya.
	}.
} nasa: { :e Towe andika: e, mstari-mpya. }, anza.

# a closed quote still works
file andika: ['a,b\n"1,2",3'].
file kitenganishi: [','] nukuu: ['"'] mistari: { :line
	Towe andika: line, mstari-mpya.
}.
file futa.
