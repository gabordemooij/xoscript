>> To-Do := Kipengee mpya.

To-Do ikija: ['mpya'] fanya: {
	yangu list := Orodha mpya.
}.

To-Do ikija: ['nieuw'] fanya: {
	yangu list := Orodha mpya.
}.

To-Do ikija: ['+'] fanya: { :task
	yangu list ongeza-mwishoni: task.
}.

To-Do ikija: ['number of tasks?'] fanya: { <-  yangu list hesabu.
}.

>> todos := 
	To-Do mpya 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Towe andika: ['You have $ tasks to do'] $ todos number of tasks?.
