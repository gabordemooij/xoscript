Nambari ikija: ['factorial'] fanya: {
	>> total := 1.
	{ :index total zidisha-kwa: (binafsi - (index)). } × binafsi. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Towe andika: a.
>> b := 2 + 3 factorial.
Towe andika: b.
>> c := 3 factorial + 2.
Towe andika: c.
>> d := 2 + (3 factorial).
Towe andika: d.
Towe andika: 2 + 3 factorial + 1.
