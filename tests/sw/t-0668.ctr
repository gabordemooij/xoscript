# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob mpya: 8, bytes: (
	Orodha mpya ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Towe andika: ( utf16 simbua: ['utf16le'] ), mstari-mpya.

utf16 achilia.
>> utf32 := Blob mpya: 13, bytes: (
	Orodha mpya ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Towe andika: ( utf32 simbua: ['utf32be'] ), mstari-mpya.
utf32 achilia.