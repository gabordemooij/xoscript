
Programu usimamizi-wa-kumbukumbu: 4.

>> Animal := Kipengee mpya.
Animal ikija: ['make'] fanya: {
	>> animal := Kipengee mpya.
	animal ikija: ['makeSound'] fanya: {
		Towe andika: yangu sound.
	}. <- animal.
}.
>> Cat := Kipengee mpya.
Cat ikija: ['make'] fanya: {
	>> cat := Animal make.
	cat ikija: ['init'] fanya: {
		yangu sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
