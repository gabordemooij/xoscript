

Orodha ikija: ['sum'] fanya: {
	>> total := 0.
	binafsi kila: { :index :element
		total ongeza: element.
	}. <- total.
}.

Orodha ikija: ['product'] fanya: {
	>> total := 1.
	binafsi kila: { :index :element
		total zidisha-kwa: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programu usimamizi-wa-kumbukumbu: 0.

{

>> a := Orodha ← ['hello'] ; ['world'] ; Kweli ; Tupu ; 666.
a := a + ( Orodha ← 1 ).
Towe andika: ( ['sum: '] + ( a sum ) ), mstari-mpya.
Towe andika: ( ['min: '] + ( a kiwango-cha-chini ) ), mstari-mpya.
Towe andika: ( ['max: '] + ( a kiwango-cha-juu ) ), mstari-mpya.
Towe andika: ( ['3rd: '] + ( a ? 2 ) ), mstari-mpya.
Towe andika: ( ['prd: '] + ( a product ) ), mstari-mpya.
a panga: { :a :b <- (b - a). }.
a kila: { :i :e Towe andika: ( i - 0 ), mstari-mpya. }.

} anza.

Programu safisha.
usedMemory1 := (Programu kumbukumbu ? 0).


{

>> a := Orodha ← ['hello'] ; ['world'] ; Kweli ; Tupu ; 666.
a := a + ( Orodha ← 1 ).
Towe andika: ( ['sum: '] + ( a sum ) ), mstari-mpya.
Towe andika: ( ['min: '] + ( a kiwango-cha-chini ) ), mstari-mpya.
Towe andika: ( ['max: '] + ( a kiwango-cha-juu ) ), mstari-mpya.
Towe andika: ( ['3rd: '] + ( a ? 2 ) ), mstari-mpya.
Towe andika: ( ['prd: '] + ( a product ) ), mstari-mpya.
a panga: { :a :b <- (b - a). }.
a kila: { :i :e Towe andika: ( i - 0 ), mstari-mpya. }.

} anza.



Programu safisha.
usedMemory2 := (Programu kumbukumbu ? 0).


{

