#Linux

 >> t := Muda mpya.
 
t kanda-ya-saa: ['Europe/Amsterdam'].
t mwaka: 2020, mwezi: 8, siku: 2, saa: 21, dakika: 2, sekunde: 1.

>> a := t saa.
>> ams := t kanda-ya-saa.

t kanda-ya-saa: ['US/Hawaii'].
>> b := t saa.
>> hw := t kanda-ya-saa.

Towe
andika: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		ama: ['later'] au: ['earlier']
	)
),
mstari-mpya.
 