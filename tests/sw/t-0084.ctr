>> makeAdder := { :x
	>> f := { :y <- (yangu x + y). } weka: ['x'] thamani: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i yangu q weka: (yangu f tekeleza: (yangu q ? i)) kwenye: i. } 
	weka: ['q'] thamani: array,
	weka: ['f'] thamani: func.
	{ :i mapping tekeleza: i. } × (array hesabu).
}.

>> a := Orodha ← 1; 2; 3.
mapper tekeleza: a na: (makeAdder tekeleza: 100).
Towe andika: (a mahali: 0), mstari-mpya.
Towe andika: (a ? 1), mstari-mpya.
Towe andika: (a ? 2), mstari-mpya.
