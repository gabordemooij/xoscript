

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programu usimamizi-wa-kumbukumbu: 0.

Nambari ikija: ['addNum:'] fanya: { :x
	binafsi ongeza: x.
}.

Nambari ikija: ['subtractNum:'] fanya: { :x
	binafsi toa: x.
}.

Nambari ikija: ['multiplyBy:'] fanya: { :x
	binafsi zidisha-kwa: x.
}.

Nambari ikija: ['divideBy:'] fanya: { :x
	binafsi gawanya-kwa: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 kipeo-cha: 8).  
a := a + (2 kipeo-cha: -1). 
a := a + (49 kipeuo-cha-pili).   
a addNum: ((Orodha ← 0 ; 1) kiwango-cha-juu).          
a addNum: ((Orodha ← 2 ; 3) kiwango-cha-chini).
Towe andika: a.

Programu safisha.

usedMemory1 := (Programu kumbukumbu ? 0).


