
Orodha ikija: ['product'] fanya: {
	>> total := 1.
	binafsi kila: { :index :element
		total zidisha-kwa: element.
	}. <- total.
}.

>> a := Orodha ← 1 ; 2 ; 3.
Towe andika: a product, mstari-mpya.
Towe andika: (Orodha ← 2 ; 4 ; 8) product, mstari-mpya. 
Towe andika: (Orodha ← -2 ; 10) product, mstari-mpya. 
Towe andika: (Orodha ← 0.5 ; -2) product, mstari-mpya. 
