
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> msimbo := {
	>> o := (
		Kamusi mpya
		aa: (Orodha ← 1 ; 2),
		bb: (Orodha ← 3 ; 4)
	).
	>> s := o maandishi.
	>> o2 := s kipengee.
	(s  aina = Maandishi aina) kweli: { Towe andika: ['OK1'], mstari-mpya. }.
	(o2 aina = Kamusi aina) kweli: { Towe andika: ['OK2'], mstari-mpya. }.
}.

Programu usimamizi-wa-kumbukumbu: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Programu safisha.
usedMemory1 := (Programu kumbukumbu ? 1).
msimbo anza.
Programu safisha.
usedMemory2 := (Programu kumbukumbu ? 1).
msimbo anza.
Programu safisha.
usedMemory3 := (Programu kumbukumbu ? 1).
msimbo anza.
Programu safisha.
usedMemory4 := (Programu kumbukumbu ? 1).

(usedMemory2 = usedMemory3 = usedMemory4) kweli: { Towe andika: ['OK3'], mstari-mpya. }.
 
