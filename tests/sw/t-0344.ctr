# catch-all test (practical)
>> HTML := Maandishi mpya.
HTML ikija: ['encode:'] fanya: { :tekst
	binafsi ongeza-mwishoni: (tekst
	badilisha: ['&'] kwa: ['&amp;'], 
	badilisha: ['<'] kwa: ['&lt;'],
	badilisha: ['>'] kwa: ['&gt;'],
	badilisha: ['"'] kwa: ['&quot;']).
}.
>> blog := HTML mpya.
blog ongeza-mwishoni: ['<h1>'],
     encode: ['Koffie & Thee'],
     ongeza-mwishoni: ['</h1>'].
Towe andika: blog, mstari-mpya.


>> Roman := Nambari mpya.
Roman ikija: ['stringy'] fanya: {
	>> a := [''].
	{ a ongeza-mwishoni: ['I']. } × binafsi. <- a.
}.

>> x := Roman mpya.
x ongeza: 3.
Towe andika: x stringy, mstari-mpya.

>> Quantum := Buliani mpya.
Quantum ikija: ['true?'] fanya: { <- ['maybe True']. }.
Towe andika: (Quantum mpya true?), mstari-mpya.

>> Nihil := Tupu mpya.
Nihil ikija: ['maandishi'] fanya: { <- ['Nihil']. }.
Towe andika: (Nihil mpya), mstari-mpya.
