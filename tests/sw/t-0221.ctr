>> x := Kipengee mpya.
>> y := Kipengee mpya.
>> z := x.
Towe andika: (x = z), mstari-mpya.
Towe andika: (x = y), mstari-mpya.
Towe andika: (x ≠ y), mstari-mpya.
Towe andika: (x ≠ z), mstari-mpya.
>> m := Muda mpya mwaka: 2070, mwezi: 11.
>> n := m nakala.
Towe andika: (m = n), mstari-mpya.
Towe andika: (m ≠ n), mstari-mpya.
Towe andika: (m sawa: m), mstari-mpya.
Towe andika: (m sawa: n), mstari-mpya.
n mwezi: 12.
Towe andika: (m ≠ n), mstari-mpya.
Towe andika: (m = n), mstari-mpya.


