Nambari ikija: ['roman'] fanya: {
	>> nambari := binafsi nakala.
	>> roman := [''].
	{
		{
			(nambari ≥ 1000) kweli: {
				roman ongeza-mwishoni: ['Ⅿ'].
				nambari toa: 1000.
			}, vunja.
		
			(nambari ≥ 500) kweli: {
				roman ongeza-mwishoni: ['Ⅾ'].
				nambari toa: 500.
			}, vunja.
		
			(nambari ≥ 100) kweli: {
				roman ongeza-mwishoni: ['Ⅽ'].
				nambari toa: 100.
			}, vunja.
		
			(nambari ≥ 50) kweli: {
				roman ongeza-mwishoni: ['Ⅼ'].
				nambari toa: 50.
			}, vunja.
		
			(nambari ≥ 50) kweli: {
				roman ongeza-mwishoni: ['Ⅼ'].
				nambari toa: 50.
			}, vunja.
		
			(nambari ≥ 10) kweli: {
				roman ongeza-mwishoni: ['Ⅹ'].
				nambari toa: 10.
			}, vunja.
			
			(nambari ≥ 9) kweli: {
				roman ongeza-mwishoni: ['Ⅸ'].
				nambari toa: 9.
			}, vunja.
			
			(nambari ≥ 5) kweli: {
				roman ongeza-mwishoni: ['Ⅴ'].
				nambari toa: 5.
			}, vunja.
			
			(nambari ≥ 4) kweli: {
				roman ongeza-mwishoni: ['Ⅳ'].
				nambari toa: 4.
			}, vunja.
			
			(nambari ≥ 1) kweli: {
				roman ongeza-mwishoni: ['Ⅰ'].
				nambari toa: 1.
			}, vunja.
		} utaratibu.
	} wakati-wa: { <- nambari > 0. }. <- roman.
}.

Towe andika: 1 roman, mstari-mpya.
Towe andika: 2 roman, mstari-mpya.
Towe andika: 4 roman, mstari-mpya.
Towe andika: 8 roman, mstari-mpya.
Towe andika: 16 roman, mstari-mpya.
Towe andika: 32 roman, mstari-mpya.
Towe andika: 64 roman, mstari-mpya.
Towe andika: 128 roman, mstari-mpya.
Towe andika: 256 roman, mstari-mpya.
Towe andika: 1024 roman, mstari-mpya.
