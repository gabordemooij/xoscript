
Server init.
>> rq := Ombi-la-HTTP mpya.
Towe andika: ['HTTP-GET d[]=']  + ( rq get-orodha: ['d[]'] ), mstari-mpya. # GET
Towe andika: ['HTTP-GET f[]=']  + ( rq get-orodha: ['f[]'] ), mstari-mpya. # GET
Towe andika: ['HTTP-POST e[]='] + ( rq post-orodha: ['e[]'] ), mstari-mpya. # GET
Towe andika: ['HTTP-POST c=']   + ( rq post: ['c'] ), mstari-mpya. # GET
Towe andika: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), mstari-mpya. # GET
