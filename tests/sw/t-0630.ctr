#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Ruwaza mpya: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern linganifu: subject fanya: { :m :x
	Towe andika: m, mstari-mpya.
	Towe andika: x, mstari-mpya. <- ['XXX'].
}.
Towe andika: result, mstari-mpya.