
>> city := Orodha ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Orodha ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature kwa: city.
>> cities := weather funguo-zote panga: { :a :b <- (a linganisha: b). }.
>> temperatures := weather thamani-zote panga: { :a :b <- (a linganisha: b) hasi?. }.

Towe andika: (cities unganisha: [',']), mstari-mpya.
Towe andika: (temperatures unganisha: [',']), mstari-mpya.
