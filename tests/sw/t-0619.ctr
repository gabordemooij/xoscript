>> HTML := Kipengee mpya.
HTML ikija: ['jibu:'] fanya: { :tag 
	Towe andika: (['<tag>'] tag: tag), mstari-mpya.
}.
HTML ikija: ['jibu:na:'] fanya: { :tag :html 
	Towe andika: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), mstari-mpya.
}.
>> html := HTML mpya.
html body h1: ['header'].

