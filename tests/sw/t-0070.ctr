>> numbers := ['1,2,3'] gawa: [','].
Towe andika: ['I got: '] + numbers hesabu + [' numbers.'],mstari-mpya.
{ :i Towe andika: ['number #'] + i + [':'] + (numbers mahali: i), mstari-mpya.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages gawa: [' Or '].
Towe andika: ['We serve'], mstari-mpya.
{ :i Towe andika: ['->'] + (beverages mahali: i), mstari-mpya. } × (beverages hesabu).
Towe andika: (beverages unganisha: [',']), mstari-mpya.
Towe andika: (numbers unganisha: ['||']).
