# test buffers PKI/Sign 
Server init.

>> long := ( Orodha mpya jaza: 1000 kwa: ['a'] ) unganisha: [''].

# sign a message
Towe andika: ( 
	Kasha tia-sahihi: ['abc'] kwa: long
), mstari-mpya.

Towe andika: ( 
	Kasha
		kagua: ['abc'] 
		sahihi: long 
		kwa: long
), mstari-mpya.

Towe andika: (
	Kasha hashi-ya-nywila: long thibitisha: long
), mstari-mpya.
