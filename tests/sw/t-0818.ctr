# edge cases from a request must give an error or a result, not a crash
Server init.

Towe andika: ['<'] + (['abc'] kutoka: 0 urefu: 0, herufi-kubwa) + ['>'], mstari-mpya.
Towe andika: ['<'] + (['abc'] kutoka: 0 urefu: 0, herufi-ndogo) + ['>'], mstari-mpya.
Towe andika: ['<'] + (['abc'] ruka: 3, herufi-kubwa) + ['>'], mstari-mpya.
Towe andika: [''] herufi-kubwa bytes, mstari-mpya.
Towe andika: ['aB'] herufi-kubwa, mstari-mpya.
Towe andika: ['aB'] herufi-ndogo, mstari-mpya.

Towe andika: (Muda mpya: 0) mwaka, mstari-mpya.
{ Muda mpya: ['9e300'] nambari. } nasa: { :e Towe andika: e, mstari-mpya. }, anza.
{ Muda mpya: ['-9e300'] nambari. } nasa: { :e Towe andika: e, mstari-mpya. }, anza.
{ Muda mpya: ['nan'] nambari. } nasa: { :e Towe andika: e, mstari-mpya. }, anza.
{ Muda mpya: 9000000000000000000. } nasa: { :e Towe andika: e, mstari-mpya. }, anza.
