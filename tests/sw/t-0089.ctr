>> randomizer := { :a :b
	>> kiwango-cha-chini := ( a < b ) ama: a au: b.
	>> kiwango-cha-juu := ( a > b ) ama: a au: b.
	>> x := Tupu.
	{
		x := Nambari kati-ya: a na: b.
		((x < kiwango-cha-chini) au: (x > kiwango-cha-juu)) kweli: { 
			Towe andika: (['Invalid value!']).
			Programu maliza.
		}.
	} 
	× 100. <- x.
}.
randomizer tekeleza: 0 na: 0.
randomizer tekeleza: 1 na: 0.
randomizer tekeleza: 1 na: 1.
randomizer tekeleza: 0 na: 1.
randomizer tekeleza: -1 na: 0.
randomizer tekeleza: -1 na: -1.
randomizer tekeleza: 0 na: -1.
randomizer tekeleza: 100 na: 200.
randomizer tekeleza: 999999999999998 na: 999999999999999.
randomizer tekeleza: 999999999999999 na: 999999999999998.
randomizer tekeleza: 999999999999999 na: 999999999999999.
randomizer tekeleza: -999999999999998 na: -999999999999999.
randomizer tekeleza: -999999999999999 na: -999999999999998.
randomizer tekeleza: -999999999999999 na: -999999999999999.
randomizer tekeleza: 999999999999998 na: -999999999999999.
randomizer tekeleza: 999999999999999 na: -999999999999998.
randomizer tekeleza: 999999999999999 na: -999999999999999.
randomizer tekeleza: -999999999999998 na: 999999999999999.
randomizer tekeleza: -999999999999999 na: 999999999999998.
