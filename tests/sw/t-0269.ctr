#Linux

(Faili mpya: ['/tmp/testje']) ipo uongo: {
	Programu mfumo: ['mkdir /tmp/testje'].	
}.

(Faili mpya: ['/tmp/testje/file1']) ipo uongo: {
	Programu mfumo: ['touch /tmp/testje/file1'].	
}.

(Faili mpya: ['/tmp/testje/folder1']) ipo uongo: {
	Programu mfumo: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Faili orodha: ['/tmp/testje'].

>> q := Orodha mpya.

l kila: { :k :v v kila: { :x :y q ongeza-mwishoni: y. }. }.

>> s := q maandishi.

(s inajumuisha: ['file1']) kweli:   { Towe andika: ['OK'], mstari-mpya. }.
(s inajumuisha: ['file2']) kweli:   { Towe andika: ['XX'], mstari-mpya. }.
(s inajumuisha: ['folder1']) kweli: { Towe andika: ['OK'], mstari-mpya. }.
