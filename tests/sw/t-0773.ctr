Towe andika: ['Test object'], mstari-mpya.
>> a := Kipengee mpya. 
a ikija: ['item:'] fanya: { :int64
	yangu int64 := int64. 
}.
a ikija: ['item'] fanya: { <- yangu int64.
}.
a item: ( Int64 kutoka-maandishi: ['9999'] ).
Towe andika: a item, mstari-mpya.
>> old-int64-address := a item kielelezo anwani-ya-kumbukumbu.
a save-as: ['/tmp/a.bin'].
Towe andika: ['========== RELOADING SNAP:'], mstari-mpya.
>> b := Kipengee load-from: ['/tmp/a.bin'].
(b item kielelezo anwani-ya-kumbukumbu = old-int64-address) kweli: {
	Towe andika: ['Object link re-attached.'], mstari-mpya.
}.
Towe andika: ( b item ), mstari-mpya.
