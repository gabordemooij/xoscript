Server init.

>> db := Maria-DB mpya mwenyeji: ['localhost'],
	jina-la-mtumiaji: ['xo'],
	nywila: ['pass123'],
	jina-la-hifadhidata: ['xobase'],
	unganika.

>> vigezo-vya-utafutaji := db ulizo: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], vigezo: ( Orodha mpya ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  vigezo-vya-utafutaji endesha. db thibitisha. } nasa: { :e db rudisha-nyuma.  }, anza.

Towe andika: ['Can we insert? '] + ( vigezo-vya-utafutaji insert-id > 0 ), mstari-mpya.
