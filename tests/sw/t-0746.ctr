Towe andika: ['Test object'], mstari-mpya.
>> a := Kipengee mpya. 

a ikija: ['item:'] fanya: { :dict
	yangu dict := dict. 
}.

a ikija: ['item'] fanya: { <- yangu dict.
}.

a item: (
Kamusi mpya
	hello: ['world'],
	world: (Kamusi mpya weka: ['a'] kwenye: ['b'])).

Towe andika: a item, mstari-mpya.

>> old-dict-address := a item kielelezo anwani-ya-kumbukumbu.
a save-as: ['/tmp/a.bin'].
Towe andika: ['========== RELOADING SNAP:'], mstari-mpya.

>> b := Kipengee load-from: ['/tmp/a.bin'].

(b item kielelezo anwani-ya-kumbukumbu = old-dict-address) kweli: {
	Towe andika: ['Object link re-attached.'], mstari-mpya.
}.

Towe andika: b item, mstari-mpya.
