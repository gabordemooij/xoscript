

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programu usimamizi-wa-kumbukumbu: 0.

>> a := Orodha ← ['hello'] ; ['world'] ; Kweli ; Tupu ; 666.
a fanya toa-wa-mwisho toa-wa-kwanza ongeza-mwanzoni: ['hi'], ongeza-mwishoni: 999, imekamilika.
Towe andika: ( a unganisha: [','] ), mstari-mpya.

Programu safisha.
usedMemory1 := (Programu kumbukumbu ? 0).


a := Orodha ← ['hello'] ; ['world'] ; Kweli ; Tupu ; 666.
a toa-wa-mwisho. a toa-wa-kwanza. a ongeza-mwanzoni: ['hi'], ongeza-mwishoni: 999.
Towe andika: ( a unganisha: [','] ), mstari-mpya.


Programu safisha.
