['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Towe andika: (x + y), mstari-mpya.

>> x := 10040.07.
>> y := 10305.60.

Towe andika: (x + y), mstari-mpya.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Towe andika: (x + y + z), mstari-mpya.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Towe andika: (x + y + z), mstari-mpya.

>> q := 0.1.2.

Towe andika: (q), mstari-mpya.

>> q := 012.

Towe andika: (q), mstari-mpya.
