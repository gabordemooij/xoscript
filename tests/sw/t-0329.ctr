Towe andika: ((Orodha mpya
	ikija: ['plaque:'] fanya: { :x yangu o := x. },
	ikija: ['plaque']  fanya: { <- yangu o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Orodha ← 1)
	~ (Orodha ← 1 ; 2)
	~ (Orodha ← 1 ; 2 ; 3)
	~ (Orodha ← 1 ; 2 ; 3 ; 4)
	~ (Orodha ← 1 ; 2 ; 3 ; 4 ; 5)
) kila: { :i :el
	{ Towe andika: jukumu-hili. } × el hesabu.
	Towe mstari-mpya.
}) plaque, mstari-mpya.


