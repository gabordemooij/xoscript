# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB mpya mwenyeji: ['localhost'],
	jina-la-mtumiaji: ['xo'],
	nywila: ['pass123'],
	jina-la-hifadhidata: ['xobase'],
	unganika.

>> vigezo-vya-utafutaji := db ulizo: ['SELECT %% FROM'].
{ vigezo-vya-utafutaji endesha. } nasa: { :e
	Towe andika: ( e inajumuisha: ['%%'] ), mstari-mpya.
}, anza.
