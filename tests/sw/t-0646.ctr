Server init.
Towe andika: ['Database datetime test'], mstari-mpya.

>> db := Maria-DB mpya mwenyeji: ['localhost'],
	jina-la-mtumiaji: ['xo'], 
	nywila: ['pass123'],
	jina-la-hifadhidata: ['xobase'],
	unganika.

>> vigezo-vya-utafutaji :=
db ulizo: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
leta: { :row
	Towe andika: row datetimetest, mstari-mpya.
}.
