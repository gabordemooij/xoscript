>> map1 := Kamusi mpya.
>> key1 := Orodha mpya.
>> key2 := Orodha mpya.

map1
	weka: ['hello'] kwenye: key1,
	weka: ['world'] kwenye: key2.


Towe
	andika: ['Map #1 contains: '] + (map1 katika: key1),
	andika: [' and '] + (map1 katika: key2), mstari-mpya.

>> KeyeableArray := Orodha mpya.
KeyeableArray ikija: ['toString'] fanya: { <- (binafsi hesabu) toString.
}.

>> map2 := Kamusi mpya.
key1 := KeyeableArray mpya.
key2 := KeyeableArray mpya.

key1 ongeza-mwishoni: 1.

map2
	weka: ['hello'] kwenye: key1,
	weka: ['world'] kwenye: key2.

Towe
	andika: ['Map #2 contains: '] + (map2 katika: key1),
	andika: [' and '] + (map2 katika: key2), mstari-mpya.
