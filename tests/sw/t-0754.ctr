Towe andika: ['Test object'], mstari-mpya.
>> a := Kipengee mpya. 

a ikija: ['item:'] fanya: { :out
	yangu out := out. 
}.

a ikija: ['item'] fanya: { <- yangu out.
}.

a ikija: ['greet'] fanya: {
	Towe andika: ['hi from original out!'], mstari-mpya.
}.

a item: Towe.

Towe andika: a item, mstari-mpya.

>> old-out-address := a item kielelezo anwani-ya-kumbukumbu.
a save-as: ['/tmp/a.bin'].
Towe andika: ['========== RELOADING SNAP:'], mstari-mpya.

>> b := Kipengee load-from: ['/tmp/a.bin'].

(b item kielelezo anwani-ya-kumbukumbu = old-out-address) kweli: {
	Towe andika: ['Object link re-attached.'], mstari-mpya.
}.

b item andika: ['hello from loaded out!'], mstari-mpya.
b greet.
