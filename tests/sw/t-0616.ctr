Orodha ikija: ['nakala'] fanya: {
	>> nakala := Orodha mpya.
	binafsi kila: { :nambari :section
		nakala ongeza-mwishoni: section kujirudia nakala.
	}. <- nakala.
}.

>> sheep := Orodha mpya ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep nakala.
clones kila: { :nambari :sheep
	sheep ongeza-mwishoni: ['2'].
}.

Towe andika: sheep, mstari-mpya.
Towe andika: clones, mstari-mpya.
