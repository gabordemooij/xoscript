Towe andika: ['Test object'], mstari-mpya.
>> a := Kipengee mpya. 

a ikija: ['item:'] fanya: { :buliani
	yangu buliani := buliani. 
}.

a ikija: ['item'] fanya: { <- yangu buliani.
}.

a item: Uongo.

Towe andika: a item, mstari-mpya.

>> old-bool-address := a item kielelezo anwani-ya-kumbukumbu.
a save-as: ['/tmp/a.bin'].
Towe andika: ['========== RELOADING SNAP:'], mstari-mpya.

>> b := Kipengee load-from: ['/tmp/a.bin'].

(b item kielelezo anwani-ya-kumbukumbu = old-bool-address) kweli: {
	Towe andika: ['Object link re-attached.'], mstari-mpya.
}.

Towe andika: b item, mstari-mpya.
