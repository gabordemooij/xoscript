>> Greeter := Kipengee mpya.
Greeter ikija: ['make'] fanya: {
	>> gr := Kipengee mpya.
	gr ikija: ['setName:'] fanya: { :aname
		yangu jina := aname.
	}.
	gr ikija: ['greet'] fanya: {
		Towe andika: yangu jina.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a mpya.
c setName: ['THREE'].
c greet.
>> d := a mpya.
d setName: ['FOUR'].
d greet.
c greet.
