

Maandishi ikija: ['html'] fanya: { <- (
		binafsi
		badilisha: ['&'] kwa: ['&amp;'],
		badilisha: ['<'] kwa: ['&lt;'],
		badilisha: ['>'] kwa: ['&gt;'],
		badilisha: ['"'] kwa: ['&quot;']
	).
}.


Towe andika: ([' left trimmed '] punguza-nafasi) + [' '] + ( ['and right trimmed'] punguza-nafasi) + ['!'], mstari-mpya.
Towe andika: ['<html>"html & entities"</html>'] html.
