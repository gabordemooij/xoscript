Towe andika: ['Test object'], mstari-mpya.
>> a := Kipengee mpya. 

a ikija: ['item:'] fanya: { :nil
	yangu nil := nil. 
}.

a ikija: ['item'] fanya: { <- yangu nil.
}.

a item: Tupu.

Towe andika: a item, mstari-mpya.

>> old-nil-address := a item kielelezo anwani-ya-kumbukumbu.
a save-as: ['/tmp/a.bin'].
Towe andika: ['========== RELOADING SNAP:'], mstari-mpya.

>> b := Kipengee load-from: ['/tmp/a.bin'].

(b item kielelezo anwani-ya-kumbukumbu = old-nil-address) kweli: {
	Towe andika: ['Object link re-attached.'], mstari-mpya.
}.

Towe andika: b item, mstari-mpya.
