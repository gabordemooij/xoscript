>> a := 3.
>> b := a nakala.
a toa: 1.
Towe andika: [' a = '] + a.
Towe andika: [' b = '] + b.
a := 3.
b := a + 4.
Towe andika: [' a = '] + a.
Towe andika: [' b = '] + b.
>> x := 3.
>> y := x nakala.
x ongeza: 10.
y toa: 1.
Towe andika: [' x = '] + x.
Towe andika: [' y = '] + y.
>> q := Kipengee mpya.
q ikija: ['setProperty:'] fanya: { :x
	yangu prop := x.
}.
q ikija: ['getProperty'] fanya: { <- yangu prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Towe andika: [' p = '] + (p getProperty).
