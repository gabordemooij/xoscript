Towe andika: ['Test object'], mstari-mpya.
>> p := Njia /tmp.
Towe andika: p, mstari-mpya.
>> old-p-address := p kielelezo anwani-ya-kumbukumbu.
p save-as: ['/tmp/a.bin'].
Towe andika: ['========== RELOADING SNAP:'], mstari-mpya.
>> b := Kipengee load-from: ['/tmp/a.bin'].
(b kielelezo anwani-ya-kumbukumbu = old-p-address) kweli: {
	Towe andika: ['Object link re-attached.'], mstari-mpya.
}.
Towe andika: b, mstari-mpya.
