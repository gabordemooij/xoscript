>> invoice := Kipengee mpya.
invoice ikija: ['anza'] fanya: {
        yangu nambari := 0.
}.

invoice ikija: ['nambari'] fanya: {
        yangu nambari ongeza: 1. <- yangu nambari nakala.
}.

>> year-invoice := invoice mpya.
year-invoice ikija: ['start:'] fanya: { :mwaka
	yangu nambari := mwaka.
}.

year-invoice start: 202000.
Towe andika: year-invoice nambari, mstari-mpya.
Towe andika: year-invoice nambari, mstari-mpya.
