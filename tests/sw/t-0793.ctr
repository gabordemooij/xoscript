Server init.

>> DB := Maria-DB mpya mwenyeji: ['localhost'],
	jina-la-mtumiaji: ['xo'],
	nywila: ['pass123'],
	jina-la-hifadhidata: ['xobase'],
	unganika.

{
	DB ulizo:
	['DROP TABLE movies'],
	endesha.
} nasa: { Tupu. }, anza.

DB ulizo:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
endesha.

DB ulizo: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
vigezo: ( Orodha mpya ; ['Halloween'] ),
endesha.

DB ulizo: ['SELECT * FROM movies'],
leta: { :movie
	Towe andika: movie title, mstari-mpya.
}.

