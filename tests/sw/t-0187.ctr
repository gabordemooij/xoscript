Nambari ikija: ['factorial'] fanya: {
	>> total := 1.
	{ :index total zidisha-kwa: (binafsi - index). } × binafsi. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programu usimamizi-wa-kumbukumbu: 0.

{
2 exponent factorial.
Towe andika: (11 baki: 3), mstari-mpya.
Towe andika: (3.4 kadiria), mstari-mpya.
Towe andika: (7.1 kadiria-juu), mstari-mpya.
Towe andika: (7.9 kadiria-chini), mstari-mpya.
}
anza.

Programu safisha.

usedMemory1 := (Programu kumbukumbu ? 0).

