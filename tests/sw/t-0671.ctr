# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Kasha tengeneza-funguo.

# private (secret) key
>> sk := keys wa-kwanza.

# public key
>> pk := keys wa-mwisho.

# sign a message
>> sig := Kasha tia-sahihi: ['abc'] kwa: sk.

# check message (ok)
Towe andika: ( 
	Kasha
		kagua: ['abc'] 
		sahihi: sig 
		kwa: pk 
), mstari-mpya.

# check message (fail)
Towe andika: ( 
	Kasha 
		kagua: ['abd'] 
		sahihi: sig 
		kwa: pk 
), mstari-mpya.