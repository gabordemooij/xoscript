

Maandishi ikija: ['evaluate'] fanya: {
	>> msimbo := Faili mpya: ['/tmp/eval.ctr'].
	msimbo andika: binafsi maandishi + ['.'].
	Programu tumia: ['/tmp/eval.ctr'].
}.

>> a := (Orodha ← (
	(Kamusi mpya)
		weka: ['domain'] kwenye: ['mywebsite.com'],
		weka: (Orodha ←
			((Kamusi mpya)
				weka: ['home'] kwenye: ['title'],
				weka: ['<html></html>'] kwenye: ['body'],
				weka: ['2017-01-01'] kwenye: ['created']
			) ;
			((Kamusi mpya)
				weka: ['aboutus(c)'] kwenye: ['title'],
				weka: ['<credits>Author Inc.</credits>'] kwenye: ['body']
			)
		) kwenye: ['pages']
	)
) maandishi.

Towe andika: a aina, mstari-mpya.
Towe andika: a, mstari-mpya.

>> b := Tupu.
(['b := '] + a) evaluate.
Towe andika: b ? 0 ? ['pages'] ? 1 ? ['body'], mstari-mpya.

>> c := b ? 0.
>> d := c maandishi.
Towe andika: d aina, mstari-mpya.

>> e := Tupu.
(['e := '] + d) evaluate.
Towe andika: e ? ['pages'] ? 0, mstari-mpya.
