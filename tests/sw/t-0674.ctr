# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> njia-ya-faili := ['/tmp/dat.csv'].
>> csv := Faili mpya: njia-ya-faili.
csv andika: s.

# accepts CRLF LF CR, varying row length
csv kitenganishi: [';'] nukuu: ['"'] mistari: { :line
	Programu safisha.
	Towe andika: line, mstari-mpya.
	Programu safisha.
}.

# unequal lines
s ongeza-mwishoni: ['\njustone'].
csv andika: s.
{
	csv kitenganishi: [';'] nukuu: ['"'] mistari: { :line
		Towe andika: line, mstari-mpya.
	}.
} nasa: { :e 
	Towe andika: e, mstari-mpya.
}, anza.

# invalid format
s := ['"he"llo";world'].
csv andika: s.
{
	csv kitenganishi: [';'] nukuu: ['"'] mistari: { :line
		Towe andika: line, mstari-mpya.
	}.
} nasa: { :e 
	Towe andika: e, mstari-mpya.
}, anza.
