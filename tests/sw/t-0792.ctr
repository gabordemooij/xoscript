Server init.

>> DB := Maria-DB mpya mwenyeji: ['localhost'],
	jina-la-mtumiaji: ['xo'],
	nywila: ['pass123'],
	jina-la-hifadhidata: ['xobase'],
	unganika.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB ulizo: SQL.

# now you don't have to set DB
query2 leta: { :row
	Towe andika: row world, mstari-mpya.
}.
