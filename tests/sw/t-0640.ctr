
Server init.
Towe andika: ['Database test'], mstari-mpya.

>> db := Maria-DB mpya mwenyeji: ['localhost'],
	jina-la-mtumiaji: ['xo'], 
	nywila: ['pass123'],
	jina-la-hifadhidata: ['xobase'],
	unganika.

>> vigezo-vya-utafutaji :=
db ulizo: ['SELECT UNHEX('CAFE') AS blobby'],
leta: { :row
	Towe andika: ( row blobby kutoka: 0 urefu: 2 ), mstari-mpya.
	row blobby achilia.
}.
