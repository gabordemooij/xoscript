>> t := Kweli.
(t = Kweli) kweli: { Towe andika: ['T']. }.
(t = Uongo) kweli: { Towe andika: ['F']. }.
Towe andika: ['|'].
>> t := Uongo.
(t = Kweli) kweli: { Towe andika: ['T']. }.
(t = Uongo) kweli: { Towe andika: ['F']. }.
Towe andika: ['|'].
>> f := Kweli.
(t = Kweli na: f = Uongo) kweli: { Towe andika: ['T']. }.
(t = Uongo na: f = Kweli) kweli: { Towe andika: ['F']. }.
Towe andika: ['|'].
>> n := Tupu.
(n Tupu?) kweli: { Towe andika: ['T']. }.
(n Tupu?) uongo: { Towe andika: ['F']. }.
Towe andika: ['|'].
(f Boolean?) kweli: { Towe andika: ['T']. }.
(f Boolean?) uongo: { Towe andika: ['F']. }.



