# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Ruwaza mpya: pattern.
	p linganifu: subject fanya: { :m :g
		Towe andika: g hesabu, andika: [' '], andika: (g unganisha: ['|']), mstari-mpya. <- m.
	}.
}.
show tekeleza: ['(a)|(b)'] na: ['b'].
show tekeleza: ['(a)|(b)'] na: ['a'].
show tekeleza: ['(x)?y'] na: ['y'].
show tekeleza: ['(x)?(y)(z)?'] na: ['xy'].
