Server init.

>> db := Maria-DB mpya mwenyeji: ['localhost'],
	jina-la-mtumiaji: ['xo'],
	nywila: ['pass123'],
	jina-la-hifadhidata: ['xobase'],
	unganika.

>> del := db ulizo: ['DELETE FROM book WHERE id > 0'].
{  del endesha. db thibitisha. } nasa: { :e db rudisha-nyuma.  }, anza.

>> hesabu := db ulizo: ['SELECT COUNT(*) AS num FROM book'].
hesabu leta: { :row Towe andika: row num, mstari-mpya. }.
