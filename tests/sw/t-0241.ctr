

Maandishi ikija: ['evaluate'] fanya: {
	>> msimbo := Faili mpya: ['/tmp/eval.ctr'].
	msimbo andika: (binafsi maandishi + ['.']).
	Programu tumia: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Orodha ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q maandishi.
Towe andika: x, mstari-mpya.
>> y := Tupu.
(['y := '] + x ) evaluate.
Towe andika: y ? 0, mstari-mpya.

q := Kamusi weka: ['\[''] kwenye: ['\['quote\']'].
x := q maandishi.
Towe andika: x, mstari-mpya.
y := Tupu.
(['y := '] + x ) evaluate.

>> q := (Kamusi mpya) weka:['\[''] kwenye:['\['quote\[''].
Towe andika: y ? ['\['quote\']'], mstari-mpya.
