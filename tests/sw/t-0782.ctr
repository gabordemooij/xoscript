Towe andika: ['Test object'], mstari-mpya.
>> cmd := Amri mpya.
Towe andika: cmd ls /tmp, mstari-mpya.
>> old-cmd-address := cmd kielelezo anwani-ya-kumbukumbu.
cmd save-as: ['/tmp/a.bin'].
Towe andika: ['========== RELOADING SNAP:'], mstari-mpya.
>> b := Kipengee load-from: ['/tmp/a.bin'].
(b kielelezo anwani-ya-kumbukumbu = old-cmd-address) kweli: {
	Towe andika: ['Object link re-attached.'], mstari-mpya.
}.
Towe andika: b ls, mstari-mpya.


