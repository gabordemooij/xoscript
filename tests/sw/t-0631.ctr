#ffi test


Server init.

Programu usimamizi-wa-kumbukumbu: 4.

# for this test you need set a path to libc (puts)
>> libname := Programu mpangilio: ['FFITESTLIB'].



Server kiungo: (
 Orodha mpya ;
 libname ;
 ['puts'] ;
 ( Orodha mpya ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s achilia.

# test with struct

>> a := Blob mpya: 8.
a bytes: (
	Orodha <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Orodha <<: ['int'], ; ['int']).

Server kiungo: (
	Orodha <<: ['@structtest'], ;
	['@structtest'] ;
	(Orodha <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Towe andika: ['Sum test:'] + (ffitest ffisum: a), mstari-mpya.

struct achilia-struct.
struct achilia.
a achilia.
