



>> CoffeeGrounds := Kipengee mpya.
CoffeeGrounds ikija: ['extract'] fanya: { <- ['coffee']. }.

>> CoffeeMachine := Kipengee mpya.
CoffeeMachine ikija: ['init'] fanya: {
	yangu coffeegrounds := CoffeeGrounds mpya.
}.
CoffeeMachine ikija: ['mpya'] fanya: { <- CoffeeMachine `new init.
}.

CoffeeMachine ikija: ['makeTea'] fanya: { <- (yangu tealeaves extract). }.
CoffeeMachine ikija: ['makeCoffee'] fanya: { <- (yangu coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine mpya.

Towe andika:
	coffeeDream 
	makeCoffee.

Towe andika:
	coffeeDream 
	makeTea.
