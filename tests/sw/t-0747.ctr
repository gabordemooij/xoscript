Towe andika: ['Test object'], mstari-mpya.
>> a := Kipengee mpya. 

a ikija: ['item:'] fanya: { :num
	yangu num := num. 
}.

a ikija: ['item'] fanya: { <- yangu num.
}.

a item: 123.

Towe andika: a item, mstari-mpya.

>> old-num-address := a item kielelezo anwani-ya-kumbukumbu.
a save-as: ['/tmp/a.bin'].
Towe andika: ['========== RELOADING SNAP:'], mstari-mpya.

>> b := Kipengee load-from: ['/tmp/a.bin'].

(b item kielelezo anwani-ya-kumbukumbu = old-num-address) kweli: {
	Towe andika: ['Object link re-attached.'], mstari-mpya.
}.

Towe andika: b item, mstari-mpya.
