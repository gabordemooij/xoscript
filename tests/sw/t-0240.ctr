# test qualifiers

>> $ := Kipengee mpya.

$ ikija: ['jibu:'] fanya: { :x
	
	>> operation := x herufi: 0.
	>> valuta := x herufi: 1.
	>> money := x ruka: 2.
	
	>> amount := 0.

	( operation = ['+'] ) kweli: {
		( valuta = ['£'] ) kweli: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Towe andika: x, mstari-mpya.


>> Fruit := Kipengee mpya.

Fruit ikija: ['mpya'] fanya: {
	>> f := binafsi mpya.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit ikija: ['apples:'] fanya: { :a yangu apples := a. }.
Fruit ikija: ['oranges:'] fanya: { :p yangu oranges := p. }.
Fruit ikija: ['apples'] fanya: { <- yangu apples. }.
Fruit ikija: ['oranges'] fanya: { <- yangu oranges. }.

Fruit ikija: ['+'] fanya: { :f
	
	>> n := Fruit mpya.
	f ongeza: 1.
	
	n apples: (f apples + yangu apples).
	n oranges:  (f oranges  + yangu oranges). <- n.
}.

Fruit ikija: ['maandishi'] fanya: { <- ( yangu apples maandishi + [' apples and '] + yangu oranges + [' oranges'] ).
}.

Nambari ikija: ['apples'] fanya: { <- ((Fruit mpya) apples: binafsi).
}.

Nambari ikija: ['apple'] fanya: { <- ((Fruit mpya) apples: binafsi).
}.

Nambari ikija: ['oranges'] fanya: { <- ((Fruit mpya) oranges: binafsi).
}.




Towe andika: (1 apple + 3 oranges + 4 apples), mstari-mpya.


Maandishi ikija: ['twice'] fanya: { <- ((binafsi maandishi) + (binafsi maandishi)).
}.



Towe andika: ['❤❤❤'] twice.



