

# create a 64-bit integer for exact calculations
>> a := Int64 kutoka-maandishi: ['123'].

# to string
Towe andika: a, mstari-mpya.

# divide
Towe andika: a / (Int64 kutoka-maandishi: ['3']), mstari-mpya.

# multiply
Towe andika: a * (Int64 kutoka-maandishi: ['2']), mstari-mpya.

# add
Towe andika: a + (Int64 kutoka-maandishi: ['1']), mstari-mpya.

# subtract
Towe andika: a - (Int64 kutoka-maandishi: ['2']), mstari-mpya.

# compare
Towe andika: ( a =   (Int64 kutoka-maandishi: ['123'])), mstari-mpya.
Towe andika: ( a !=: (Int64 kutoka-maandishi: ['124'])), mstari-mpya.
Towe andika: ( a <   (Int64 kutoka-maandishi: ['124'])), mstari-mpya.
Towe andika: ( a >   (Int64 kutoka-maandishi: ['122'])), mstari-mpya.
Towe andika: ( a >=: (Int64 kutoka-maandishi: ['123'])), mstari-mpya.
Towe andika: ( a <=: (Int64 kutoka-maandishi: ['123'])), mstari-mpya.





	