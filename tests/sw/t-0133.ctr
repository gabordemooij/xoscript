


>> Deck := Orodha mpya.
Deck ikija: ['print'] fanya: {
        >> len := binafsi hesabu - 1.
        { :i
                >> len2 := binafsi hesabu - 1.
                Towe andika: ['len: '].
                Towe andika: len, mstari-mpya.
                Towe andika: ['len2: '].
                Towe andika: len2, mstari-mpya.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
