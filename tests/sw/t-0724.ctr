Towe andika: ['Test object'], mstari-mpya.
>> a := Kipengee mpya. 

a ikija: ['item:'] fanya: { :file
	yangu file := file. 
}.

a ikija: ['item'] fanya: { <- yangu file.
}.

>> f := Faili mpya: ['/tmp/aaa.txt'].
a item: f.
Towe andika: a item, mstari-mpya.
a save-as: ['/tmp/a.bin'].
Towe andika: ['========== RELOADING SNAP:'], mstari-mpya.
>> b := Kipengee load-from: ['/tmp/a.bin'].
Towe andika: b item, mstari-mpya.
