>> q := Orodha ← 1 ; 2 ; 3.
{ q ? ['1']. } nasa: { Towe andika: ['caught!'], mstari-mpya. }, anza.
{ q ? Kweli. } nasa: { Towe andika: ['caught!'], mstari-mpya. }, anza.
{ q ? Uongo. } nasa: { Towe andika: ['caught!'], mstari-mpya. }, anza.
{ q ? Tupu. } nasa: { Towe andika: ['caught!'], mstari-mpya. }, anza.
{ q ? (Orodha mpya). } nasa: { Towe andika: ['caught!'], mstari-mpya. }, anza.
{ q ? (Kipengee mpya). } nasa: { Towe andika: ['caught!'], mstari-mpya. }, anza.
{ q ? ({ ['Empty']. }). } nasa: { Towe andika: ['caught!'], mstari-mpya. }, anza.
Towe andika: ['caught them all'], mstari-mpya.
