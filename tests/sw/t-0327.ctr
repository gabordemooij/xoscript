

Orodha ikija: ['fixture:'] fanya: { :f
	yangu fixture := f.
}.

Orodha ikija: ['hesabu'] fanya: { <- yangu fixture.
}.

Orodha ikija: ['aantal'] fanya: { <- yangu fixture.
}.


>> x := Tupu.
{

	x := ['hello'] 
	badilisha:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] herufi: 2)
			)
		)
	kwa: (
		(['...hal'] + ['lo']) 
			herufi-kubwa 
			lowecase 
			herufi-kubwa 
			ruka: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Orodha ← 0 ; 1 ; 4; 9 ; (Orodha ← 0 ; 3; 1) ; 4
							) kabla-ya-mwisho
						) ? 1
					) + 
					((Orodha ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					hesabu
				)
			)
	).

} × 10.
Towe andika: x, mstari-mpya.

