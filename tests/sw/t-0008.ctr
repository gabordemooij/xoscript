>> Greeter := Kipengee mpya.
Greeter ikija: ['make'] fanya: {
	>> greeter := Kipengee mpya.
	greeter ikija: ['name:'] fanya: { :jina
		Towe andika: ['setting a name'].
		yangu myName := jina.
	}.
	greeter ikija: ['greet'] fanya: {
		Towe andika: ['Hello'].
		Towe andika: yangu myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
