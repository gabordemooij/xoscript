# test url parsing

Server init.
>> url := URL kutoka: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Towe andika: ['scheme = '] + url skimu, mstari-mpya.
Towe andika: ['host = '] + url mwenyeji, mstari-mpya.
Towe andika: ['port = '] + url mlango, mstari-mpya.
Towe andika: ['path = '] + url njia-ya-faili, mstari-mpya.
Towe andika: ['query = '] + url vigezo-vya-utafutaji, mstari-mpya.
Towe andika: ['fragment = '] + url kipande, mstari-mpya.
