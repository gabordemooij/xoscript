(Tupu = Tupu) kweli: { Towe andika: ['Nil is Nil!'].}.
(2 > 1) kweli: { Towe andika: ['YES']. }.
(2 > 3) kweli: { Towe andika: ['NO']. }.
(2 > 3) uongo: { Towe andika: ['Nonono..'].}.
Kweli kweli: { Towe andika: ['TRUE is TRUE!']. }.
(Kweli) kweli: { Towe andika: ['TRUE is TRUE!']. }.
Uongo uongo: { Towe andika: ['FALSE is FALSE!']. }.
(Uongo) uongo: { Towe andika: ['FALSE is FALSE!']. }.
