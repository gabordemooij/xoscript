Maandishi ikija: ['evaluate'] fanya: {
	>> msimbo := Faili mpya: ['/tmp/eval.ctr'].
	msimbo andika: (binafsi maandishi + ['.']).
	Programu tumia: ['/tmp/eval.ctr'].
}.

>> a := Orodha ← 1 ; 2 ; 3.
>> b := (a maandishi).

Towe andika: b, mstari-mpya. 
(['b := '] + b) evaluate.

Towe andika: b ? 2, mstari-mpya. 

Towe andika: (( Orodha ← 1 ; 2 ; 3 )), mstari-mpya. 

Towe andika: ((Kamusi mpya) weka: 1 kwenye: 2), mstari-mpya. 

>> x := ( (Orodha ← 1 ; ( Orodha ← 9 ) ; Kweli ) ) maandishi.
Towe andika: x, mstari-mpya. 
(['x := '] + x) evaluate.

Towe andika: x ? 1 ? 0, mstari-mpya. 

>> y := (Kamusi mpya) weka: (Orodha ← 1) kwenye: (Orodha ← 2).
Towe andika: y, mstari-mpya. 

(['y := '] + y) maandishi evaluate.

Towe andika: (y katika: (Orodha ← 2) maandishi ), mstari-mpya.

Towe andika: (Orodha mpya), mstari-mpya. 
Towe andika: (Kamusi mpya), mstari-mpya. 
