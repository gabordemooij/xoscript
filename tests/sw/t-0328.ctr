Programu usimamizi-wa-kumbukumbu: 4.

>> Doubler := Kipengee mpya.
>> Multiplier := Kipengee mpya.
Doubler ikija: ['double:and:'] fanya: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier ikija: ['multiply:and:'] fanya: { :x :y <- (x × y).
}.

Towe andika: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), mstari-mpya.
