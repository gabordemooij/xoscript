>> winery := { <- (	Kamusi mpya
		weka: 2 kwenye: ['merlot'],
		weka: 3 kwenye: ['malbec'],
		weka: 4 kwenye: ['syrah']
	).
}.

Towe andika: (((winery anza) - ['nothing']) hesabu), mstari-mpya.
Towe andika: (((winery anza) - ['merlot']) hesabu), mstari-mpya.
Towe andika: (((winery anza) - ['malbec']) hesabu), mstari-mpya.
Towe andika: (((winery anza) - ['syrah']) hesabu), mstari-mpya.
Towe andika: (((winery anza) - ['merlot'] - ['malbec']) hesabu), mstari-mpya.
Towe andika: (((winery anza) - ['merlot'] - ['syrah']) hesabu), mstari-mpya.
Towe andika: (((winery anza) - ['malbec'] -['syrah']) hesabu), mstari-mpya.
Towe andika: (((winery anza) - ['malbec'] - ['syrah'] - ['merlot']) hesabu), mstari-mpya.

