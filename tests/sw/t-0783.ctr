Towe andika: ['Test object'], mstari-mpya.
>> a := Kipengee mpya. 

a ikija: ['item:'] fanya: { :moment
	yangu moment := moment. 
}.

a ikija: ['item'] fanya: { <- yangu moment.
}.

>> today := Muda mpya kanda-ya-saa: ['CEST'], mwaka: 2026, mwezi: 7.
a item: today.
Towe andika: a item, mstari-mpya.
a save-as: ['/tmp/a.bin'].

