# backslashes must survive code serialization, strings must not end early
>> thamani-zote := Orodha mpya
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

thamani-zote kila: { :i :value
	>> d := Kamusi mpya.
	d weka: value kwenye: ['k'].
	>> r := d msimbo kipengee.
	Towe andika: r hesabu, mstari-mpya.
	Towe andika: ( (r katika: ['k']) = value ), mstari-mpya.
}.
