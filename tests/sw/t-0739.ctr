Towe andika: ['Test object'], mstari-mpya.
>> a := Kipengee mpya. 

a ikija: ['item:'] fanya: { :binhelper
	yangu binhelper := binhelper. 
}.

a ikija: ['item'] fanya: { <- yangu binhelper.
}.

a item: Bin mpya.

>> old-binhelper-address := a item kielelezo anwani-ya-kumbukumbu.
a save-as: ['/tmp/a.bin'].
Towe andika: ['========== RELOADING SNAP:'], mstari-mpya.

>> b := Kipengee load-from: ['/tmp/a.bin'].

(b item kielelezo anwani-ya-kumbukumbu = old-binhelper-address) kweli: {
	Towe andika: ['Object link re-attached.'], mstari-mpya.
}.


