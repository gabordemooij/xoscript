Towe andika: ['Continue for-loop, No - before 6 and up.'], mstari-mpya.
{ :i
	Towe andika: (i + 1), mstari-mpya.
	((i + 1) > 4) endelea.
	Towe andika: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Towe mstari-mpya.
Towe andika: ['Continue while-true, No --> before 5 and up.'], mstari-mpya.
{
	Towe andika: ['iteration #'] + x, mstari-mpya.
	x ongeza: 1.
	((x < 5) kinyume) endelea.
	Towe andika: ['-->'].
} wakati-wa: xIsLessThan10.
Towe mstari-mpya.
Towe andika: ['Continue while-false, No - before 3 only.'], mstari-mpya.
{
	Towe andika: ['iteration #'] + x, mstari-mpya.
	x toa: 1.
	(x = 3) endelea.
	Towe andika: ['-'].
} wakati-wa: { <- ( x > 0). }.

Towe mstari-mpya.
Towe andika: ['Continue times-loop, No ||| before 3.'], mstari-mpya.
{ :i
	Towe andika: ['iteration #'] + i, mstari-mpya.
	(i = 2) endelea.
	Towe andika: ['|||'].
} × 5.

Towe mstari-mpya.

{ Kweli endelea. Towe andika: ['dont write this!'], mstari-mpya. } anza.

{ Kweli endelea. Towe andika: ['dont write this!'], mstari-mpya. } nasa: { Towe andika: ['Dont catch this!']. }, anza.

Towe andika: ['Test Array each-loop: 0, ... ,2'], mstari-mpya.
(Orodha ← 1 ; 2 ; 3) geuza: { :i
	(i = 1) endelea.
	Towe andika: ['iteration #'] + (i - 0), mstari-mpya.
}.

Towe andika: ['Test Map each-loop: c only'], mstari-mpya.
>> m := Kamusi mpya.
m weka: ['first'] kwenye: ['a'], weka: ['second'] kwenye: ['b'], weka: ['third'] kwenye: ['c'].
m kila: { :k :v
	(k ≠ ['c']) endelea.
	Towe andika: ['iteration'] + k + v, mstari-mpya.
}.

