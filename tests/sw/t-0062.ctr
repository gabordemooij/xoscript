Buliani ikija: ['xor:'] fanya: { :a :b <- ((a na: b kinyume) au: (a kinyume na: b)).
}.

>> o := Kipengee mpya.
o ikija: ['hello'] fanya: { ['Empty']. }.
{ o ikija: 2 fanya: 3.} nasa: { :e Towe andika: e, mstari-mpya. }, anza.
{ o ikija: ['jaribio'] fanya: 3.} nasa: { :e Towe andika: e, mstari-mpya. }, anza.
{ o ikija: ['hello'] fanya: { ['Empty']. }.} nasa: { :e Towe andika: e, mstari-mpya. }, anza. 
{ >> z := 4 ÷ 0. } nasa: { :e Towe andika: e, mstari-mpya. }, anza. 
{ (Kweli na: Tupu) kweli: { Towe andika: ['X'].}. } nasa: { :e Towe andika: e, mstari-mpya. }, anza. 
{ ([''] xor: 0) kweli: { Towe andika: ['X'].}. } nasa: { :e Towe andika: e, mstari-mpya. }, anza. 
{ (1 < ['2']) kweli: { Towe andika: ['OK']. }. } nasa: { :e Towe andika: e, mstari-mpya. }, anza. 
{ (1 < ['2.0']) kweli: { Towe andika: ['OK']. }. } nasa: { :e Towe andika: e, mstari-mpya. }, anza. 
{ (1 < ['x2.0']) kweli: { Towe andika: ['NO!']. }. } nasa: { :e Towe andika: e, mstari-mpya. }, anza. 
{ Towe andika: (['hello OK there'] kutoka: ['6'] urefu: ['2']). } anza. 
