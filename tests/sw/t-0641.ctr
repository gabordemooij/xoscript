# Test utf8 sanitizer
Server init.

>> utf8cases := Kamusi mpya
	# ASCII only
	weka: ( Orodha mpya ; 65 ; 65 ; 65 ; 65 ; 0 ) kwenye: ['AAAA'],
	# valid 2 byte sequence
	weka: ( Orodha mpya ; 194 ; 162 ; 0 ) kwenye: ['¢'],
	# Valid 3-byte UTF-8
    weka: ( Orodha mpya ; 226 ; 130 ; 172 ; 0 ) kwenye: ['€'],
	# Valid 4-byte UTF-8
    weka: ( Orodha mpya ; 240 ; 144 ; 141 ; 136 ; 0 ) kwenye: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    weka: ( Orodha mpya ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) kwenye: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    weka: ( Orodha mpya ; 65 ; 193 ; 129 ; 0 ) kwenye: ['A?'],
	# Invalid first byte (0xFF)
    weka: ( Orodha mpya ; 255 ; 0 ) kwenye: ['?'],
	# Incomplete multi-byte sequence at end
    weka: ( Orodha mpya ; 66 ; 226 ; 0 ) kwenye: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    weka: ( Orodha mpya ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) kwenye: ['A€?𐍈B'].
	 
utf8cases kila: { :key :value
	>> blob := Blob mpya: value hesabu, bytes: value.
	>> str := blob maandishi.
	(str = key) kweli: {
		Towe andika: ['OK'], mstari-mpya.
	}, vinginevyo: {
		Towe andika: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, mstari-mpya.
	}.
	blob achilia.
}.
