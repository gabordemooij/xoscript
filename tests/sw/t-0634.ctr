# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Programu shell-escape: ['abc'].
Towe andika: c, mstari-mpya.
Towe andika: ( Programu mfumo: ['echo '] + c ), mstari-mpya.

c := Programu shell-escape: ['a'b'c'].
Towe andika: c, mstari-mpya.
Towe andika: ( Programu mfumo: ['echo '] + c ), mstari-mpya.

c := Programu shell-escape: ['a\'c'].
Towe andika: c, mstari-mpya.
Towe andika: ( Programu mfumo: ['echo '] + c ), mstari-mpya.