# Test ASCII variants

# Numbers

Towe andika: (2 !=: 3), mstari-mpya.
Towe andika: (2 <=: 2), mstari-mpya.
Towe andika: (2 >=: 2), mstari-mpya.

# Strings

Towe andika: (['b'] >=: ['a']), mstari-mpya.
Towe andika: (['b'] !=: ['a']), mstari-mpya.
Towe andika: (['b'] <=: ['c']), mstari-mpya.

# Bools

Towe andika: (Kweli !=: Uongo), mstari-mpya.

# Objects

Towe andika: (Kipengee mpya !=: Kipengee mpya), mstari-mpya.

# ASCII list symbol <-:

Towe andika: (Orodha <<: 1, ; 2 ; 3) hesabu = 3, mstari-mpya.

