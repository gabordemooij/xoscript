Towe andika: ['Test object'], mstari-mpya.
>> a := Kipengee mpya. 
a ikija: ['item:'] fanya: { :lst
	yangu lst := lst. 
}.
a ikija: ['item'] fanya: { <- yangu lst.
}.
a item: (
	Orodha mpya ; 1 ; (
		Orodha mpya ; ['a'] ; (
			Orodha mpya ; ( Muda mpya: 1 )
		) ; ( Int64 kutoka-maandishi: ['321'] )
	)
).
Towe andika: a item, mstari-mpya.
>> old-lst-address := a item kielelezo anwani-ya-kumbukumbu.
a save-as: ['/tmp/a.bin'].
Towe andika: ['========== RELOADING SNAP:'], mstari-mpya.
>> b := Kipengee load-from: ['/tmp/a.bin'].
(b item kielelezo anwani-ya-kumbukumbu = old-lst-address) kweli: {
	Towe andika: ['Object link re-attached.'], mstari-mpya.
}.
Towe andika: ( b item ), mstari-mpya.
