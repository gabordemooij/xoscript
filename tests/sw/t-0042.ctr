>> items := Kamusi mpya.
items weka: ['black'] kwenye: ['coffee'], weka: ['earl grey'] kwenye: ['tea'].
Towe andika: (items katika: ['coffee']), andika: (items katika: ['tea']).
Towe andika: ['there are'] + items hesabu + [' items in the array.'].
items weka: ['capuccino'] kwenye: ['coffee'].
Towe andika: ['Now my coffee is.. '] + (items katika: ['coffee']).
items weka: ['aaa'] kwenye: ['1'].
items weka: ['bbb'] kwenye: ['2'].
Towe andika: (items katika: ['a']).
