>> Grandfather := Kipengee mpya.
Grandfather ikija: ['greet'] fanya: {
	Towe andika: ['Ave!'], mstari-mpya.
}.
>> Father := Grandfather mpya.
Father ikija: ['greet'] fanya: {
	Towe andika: ['Hello'], mstari-mpya.
	binafsi greet.
}.
>> Son := Father mpya.
Son ikija: ['greet'] fanya: {
	Towe andika: ['Hi'], mstari-mpya.
	binafsi greet.
}.

Son greet.

>> Roundabout := Kipengee mpya.
Roundabout ikija: ['circle:'] fanya: { :x
	Towe andika: x, mstari-mpya.
	(x < 3) kweli: { binafsi kujirudia circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) kweli: { Towe andika: x, mstari-mpya. x ongeza: 1.  increment anza. }. }.
increment anza.