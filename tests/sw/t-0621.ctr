>> phrases := Orodha mpya
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases kila: { :_ :phrase 
	>> e := Server base64-simba: phrase.
	>> d := Server base64-simbua: e.
	Towe andika: (
		message nakala ~encoded: e, ~decoded: d
	), mstari-mpya.
}.
