{
	jukumu-hili kosa: ['Dont fail.'].
	unknown doSomething.
} nasa: {
	Towe andika: ['Caught!'].
}, anza.

{
	jukumu-hili kosa: ['Dont fail.'].
	yangu unknown doSomething.
} nasa: {
	Towe andika: ['Caught!'].
}, anza.

{
	jukumu-hili kosa: ['Dont fail.'].
	unknown := 122.
} nasa: {
	Towe andika: ['Caught!'].
}, anza.


{
	jukumu-hili kosa: ['Dont fail.'].
	Kweli vunja.
	Towe andika: ['FAIL'].
} nasa: {
	Towe andika: ['Caught!'].
}, anza.

{
	{
		jukumu-hili kosa: ['Dont fail.'].
		Kweli vunja.
		Towe andika: ['FAIL'].
	} nasa: { :x
		(x = ['Dont fail.']) kweli: { jukumu-hili kosa: ['Nested Caught!']. }.
	}, anza.
} nasa: { :e
	Towe andika: e.
}, anza.
