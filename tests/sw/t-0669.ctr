# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Kasha 
	hashi-ya-nywila: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Kasha 
	hashi-ya-nywila: hash thibitisha: a1.
	# fail 
>> b := Kasha
	hashi-ya-nywila: hash thibitisha: a2.
	# ok!

Towe andika: a, mstari-mpya.
Towe andika: b, mstari-mpya.

