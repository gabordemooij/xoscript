>> x := Muda mpya.
x kanda-ya-saa: ['CEST'],
mwaka:2017,
mwezi:01,
siku:10,
saa: 10,
dakika: 0,
sekunde: 0.

Towe andika: x, mstari-mpya.

Towe andika: x wakati, mstari-mpya.

x ongeza: 1 sekunde.
x ongeza: 2 dakika.
x ongeza: 3 saa.
x ongeza: 4 siku.
x ongeza: 1 mwezi.
x ongeza: 6 mwaka.

Towe andika: x, mstari-mpya.

x toa: 1 sekunde.
x toa: 2 dakika.
x toa: 3 saa.
x toa: 4 siku.
x toa: 1 mwezi.
x toa: 6 mwaka.

Towe andika: x, mstari-mpya.

>> y := x nakala.
>> z := x.

Towe andika: y, mstari-mpya.
Towe andika: z, mstari-mpya.
Towe andika: (x kanda-ya-saa = y kanda-ya-saa), mstari-mpya.
Towe andika: (x wakati = y wakati), mstari-mpya.
Towe andika: (x = z), mstari-mpya.
Towe andika: x siku-ya-mwaka, mstari-mpya.
Towe andika: x siku-ya-wiki, mstari-mpya.
Towe andika: x wiki, mstari-mpya.
