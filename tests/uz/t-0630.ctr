#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Andoza yangi: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern moslik: subject bajar: { :m :x
	Chiqish yozish: m, yangi-qator.
	Chiqish yozish: x, yangi-qator. <- ['XXX'].
}.
Chiqish yozish: result, yangi-qator.