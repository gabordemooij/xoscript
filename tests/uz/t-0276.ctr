>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Obyekt yangi.
⚄ kelganda: ['drawFrom:length:'] bajar: { :pool :soni
	
	>> result := [''].
	
	{
		>> index := Son random % (pool uzunlik).
		result oxiriga-qoʻshish: ( pool belgi: (index + 1) ).
		
	} × soni. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? uzunlik.
Chiqish yozish: (['x↵'] x random uzunlik).
Chiqish yozish: (['y↵'] y ?? uzunlik).

