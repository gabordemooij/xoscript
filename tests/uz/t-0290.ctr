# test list operations


>> cakes := Roʻyxat ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes almashtirish: 1 uzunlik: 2 bunga: ( Roʻyxat ← ['cinnamon'] ; ['pineapple'] ).
Chiqish yozish: (buy birlashtirish: [',']), yangi-qator.


>> buy := cakes almashtirish: 1 uzunlik: 12 bunga: ( Roʻyxat ← ['cinnamon'] ; ['pineapple'] ).
Chiqish yozish: (buy birlashtirish: [',']), yangi-qator.


>> buy := cakes almashtirish: 2 uzunlik: 10 bunga: ( Roʻyxat yangi ).
Chiqish yozish: (buy birlashtirish: [',']), yangi-qator.


>> buy := cakes almashtirish: 0 uzunlik: 1 bunga: ( Roʻyxat yangi ).
Chiqish yozish: (buy birlashtirish: [',']), yangi-qator.


>> buy := cakes almashtirish: ['0'] uzunlik: ['1'] bunga: ['x'].
Chiqish yozish: (buy birlashtirish: [',']), yangi-qator.
