Server init.
Chiqish yozish: ['Database datetime test'], yangi-qator.

>> db := Maria-DB yangi xost: ['localhost'],
	foydalanuvchi-nomi: ['xo'], 
	parol: ['pass123'],
	baza-nomi: ['xobase'],
	ulanish.

>> qidiruv-parametrlari :=
db soʻrov: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
olish: { :row
	Chiqish yozish: row datetimetest, yangi-qator.
}.
