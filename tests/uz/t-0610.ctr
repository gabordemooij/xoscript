
>> Rectangle := Obyekt yangi.

Rectangle kelganda: ['area'] bajar: { <- oʻzining uzunlik * oʻzining width.
}.

Rectangle kelganda: ['length:'] bajar: { :uzunlik
	oʻzining uzunlik := uzunlik.
}.

Rectangle kelganda: ['width:'] bajar: { :width
	oʻzining width := width.
}.

Rectangle kelganda: ['yangi'] bajar: {
	# this will not result into an infinite loop
	>> rectangle := oʻzi yangi.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle yangi.
Chiqish yozish: a area, yangi-qator. #0

>> b := Rectangle yangi length: 2, width: 3.
Chiqish yozish: b area, yangi-qator. #6

