

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Dastur xotira-boshqaruvi: 0.

>> txt := ['Word Salad'].
Chiqish yozish: ['last index of ord = '] + (( txt oxirgi-oʻrin: ['ord'] ) - 0), yangi-qator.
Chiqish yozish: ['index of ord = '] + (( txt topish: ['ord'] ) - 0), yangi-qator.
Chiqish yozish: ['index of ad = '] + (( txt topish: ['ad'] ) - 0), yangi-qator.
Chiqish yozish: ['last index of W = '] + (( txt oxirgi-oʻrin: ['W'] ) - 0), yangi-qator.
Chiqish yozish: ['last index of d = '] + (( txt oxirgi-oʻrin: ['d'] ) - 0), yangi-qator.
Chiqish yozish: ['txt equals Word Salad = '] + ( txt = ['Word Salad'] ), yangi-qator.
Chiqish yozish: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), yangi-qator.
Chiqish yozish: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), yangi-qator.
Chiqish yozish: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), yangi-qator.

Dastur tozalash.

usedMemory1 := (Dastur xotira ? 0).


txt := ['Word Salad'].
Chiqish yozish: ['last index of ord = '] + (( txt oxirgi-oʻrin: ['ord'] ) - 0), yangi-qator.
Chiqish yozish: ['index of ord = '] + (( txt topish: ['ord'] ) - 0), yangi-qator.
Chiqish yozish: ['index of ad = '] + (( txt topish: ['ad'] ) - 0), yangi-qator.
