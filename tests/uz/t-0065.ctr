Son kelganda: ['factorial'] bajar: {
	>> total := 1.
	{ :index total koʻpaytirish: (oʻzi - (index)). } × oʻzi. <- total.
}.
>> Printer := Obyekt yangi.
Printer kelganda: ['print:and:'] bajar: { :x :y
	Chiqish yozish: ['a='] + x + [', b='] + y, yangi-qator.
}.
>> a := 4.5. >> b := a pastga-yaxlitlash.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a yuqoriga-yaxlitlash.
Printer print: a and: b.
a := 4.5. b := a pastga-yaxlitlash.
Printer print: a and: b.
a := 4.5. b := a yaxlitlash.
Printer print: a and: b.
a := 4.2. b := a yaxlitlash.
Printer print: a and: b.

Chiqish yozish: (9 qoldiq: 5), yangi-qator.
Chiqish yozish: -666 mutlaq-qiymat, yangi-qator.
Chiqish yozish: 49 kvadrat-ildiz, yangi-qator.
Chiqish yozish: (2 daraja: 3), yangi-qator.
>> l := (Roʻyxat ← 9 ; 6).
Chiqish yozish: l eng-kichik.

