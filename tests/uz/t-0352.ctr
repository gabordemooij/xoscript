Son kelganda: ['roman'] bajar: {
	>> son := oʻzi nusxa.
	>> roman := [''].
	{
		{
			(son ≥ 1000) rost-boʻlsa: {
				roman oxiriga-qoʻshish: ['Ⅿ'].
				son ayirish: 1000.
			}, uzish.
		
			(son ≥ 500) rost-boʻlsa: {
				roman oxiriga-qoʻshish: ['Ⅾ'].
				son ayirish: 500.
			}, uzish.
		
			(son ≥ 100) rost-boʻlsa: {
				roman oxiriga-qoʻshish: ['Ⅽ'].
				son ayirish: 100.
			}, uzish.
		
			(son ≥ 50) rost-boʻlsa: {
				roman oxiriga-qoʻshish: ['Ⅼ'].
				son ayirish: 50.
			}, uzish.
		
			(son ≥ 50) rost-boʻlsa: {
				roman oxiriga-qoʻshish: ['Ⅼ'].
				son ayirish: 50.
			}, uzish.
		
			(son ≥ 10) rost-boʻlsa: {
				roman oxiriga-qoʻshish: ['Ⅹ'].
				son ayirish: 10.
			}, uzish.
			
			(son ≥ 9) rost-boʻlsa: {
				roman oxiriga-qoʻshish: ['Ⅸ'].
				son ayirish: 9.
			}, uzish.
			
			(son ≥ 5) rost-boʻlsa: {
				roman oxiriga-qoʻshish: ['Ⅴ'].
				son ayirish: 5.
			}, uzish.
			
			(son ≥ 4) rost-boʻlsa: {
				roman oxiriga-qoʻshish: ['Ⅳ'].
				son ayirish: 4.
			}, uzish.
			
			(son ≥ 1) rost-boʻlsa: {
				roman oxiriga-qoʻshish: ['Ⅰ'].
				son ayirish: 1.
			}, uzish.
		} protsedura.
	} hozircha: { <- son > 0. }. <- roman.
}.

Chiqish yozish: 1 roman, yangi-qator.
Chiqish yozish: 2 roman, yangi-qator.
Chiqish yozish: 4 roman, yangi-qator.
Chiqish yozish: 8 roman, yangi-qator.
Chiqish yozish: 16 roman, yangi-qator.
Chiqish yozish: 32 roman, yangi-qator.
Chiqish yozish: 64 roman, yangi-qator.
Chiqish yozish: 128 roman, yangi-qator.
Chiqish yozish: 256 roman, yangi-qator.
Chiqish yozish: 1024 roman, yangi-qator.
