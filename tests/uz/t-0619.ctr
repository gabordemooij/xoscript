>> HTML := Obyekt yangi.
HTML kelganda: ['javob:'] bajar: { :tag 
	Chiqish yozish: (['<tag>'] tag: tag), yangi-qator.
}.
HTML kelganda: ['javob:va:'] bajar: { :tag :html 
	Chiqish yozish: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), yangi-qator.
}.
>> html := HTML yangi.
html body h1: ['header'].

