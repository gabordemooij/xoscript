60 × {
	>> x := (Son random % 6) + 1.
	(x ≤ 6) yolgʻon-boʻlsa: { Chiqish yozish: ['FAIL']. }.
	(x ≥0) yolgʻon-boʻlsa: { Chiqish yozish: ['FAIL']. }.
	x := (Son random % 3) + 1.
	(x < 3) yolgʻon-boʻlsa: { Chiqish yozish: ['FAIL']. }.
	(x>-1) yolgʻon-boʻlsa: { Chiqish yozish: ['FAIL']. }.
	x := ((Mantiqiy flip) son).
	(x = 0 yoki: x = 1) yolgʻon-boʻlsa: { Chiqish yozish: ['FAIL']. }.
	x := ((Rost flip) son).
	(x = 0 yoki: x = 1) yolgʻon-boʻlsa: { Chiqish yozish: ['FAIL']. }.
	x := (Mantiqiy flip bu: ['HEAD'] yoki-u: ['TAIL']).
	((x = ['HEAD']) yoki: (x = ['TAIL'])) yolgʻon-boʻlsa: { Chiqish yozish: ['FAIL']. }.
}.
Chiqish yozish: ['DONE'].

