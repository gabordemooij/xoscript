Server init.

>> db := Maria-DB yangi xost: ['localhost'],
	foydalanuvchi-nomi: ['xo'],
	parol: ['pass123'],
	baza-nomi: ['xobase'],
	ulanish.

>> del := db soʻrov: ['DELETE FROM book WHERE id > 0'].
{  del bajarish. db tasdiqlash. } ushlash: { :e db ortga-qaytarish.  }, ishga-tushirish.

>> soni := db soʻrov: ['SELECT COUNT(*) AS num FROM book'].
soni olish: { :row Chiqish yozish: row num, yangi-qator. }.
