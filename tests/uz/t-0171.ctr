

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Dastur xotira-boshqaruvi: 0.

>> a := Roʻyxat ← ['hello'] ; ['world'] ; Rost ; Hech ; 666.
a zanjir-boshi oxirgisini-olish birinchisini-olish boshiga-qoʻshish: ['hi'], oxiriga-qoʻshish: 999, zanjir-oxiri.
Chiqish yozish: ( a birlashtirish: [','] ), yangi-qator.

Dastur tozalash.
usedMemory1 := (Dastur xotira ? 0).


a := Roʻyxat ← ['hello'] ; ['world'] ; Rost ; Hech ; 666.
a oxirgisini-olish. a birinchisini-olish. a boshiga-qoʻshish: ['hi'], oxiriga-qoʻshish: 999.
Chiqish yozish: ( a birlashtirish: [','] ), yangi-qator.


Dastur tozalash.
usedMemory2 := (Dastur xotira ? 0).


a := Roʻyxat ← ['hello'] ; ['world'] ; Rost ; Hech ; 666.
a zanjir-boshi oxirgisini-olish birinchisini-olish boshiga-qoʻshish: ['hi'], oxiriga-qoʻshish: 999, zanjir-oxiri.
Chiqish yozish: ( a birlashtirish: [','] ), yangi-qator.


Dastur tozalash.
usedMemory3 := (Dastur xotira ? 0).



( usedMemory1 = usedMemory2 va: usedMemory1 = usedMemory3, va: usedMemory2 = usedMemory3 ) rost-boʻlsa: {
	Chiqish yozish: ['No memory leaks here'].
}, yolgʻon-boʻlsa: {
	Chiqish yozish: ['Leaking memory...'].
}.
