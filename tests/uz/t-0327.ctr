

Roʻyxat kelganda: ['fixture:'] bajar: { :f
	oʻzining fixture := f.
}.

Roʻyxat kelganda: ['soni'] bajar: { <- oʻzining fixture.
}.

Roʻyxat kelganda: ['aantal'] bajar: { <- oʻzining fixture.
}.


>> x := Hech.
{

	x := ['hello'] 
	almashtirish:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] belgi: 2)
			)
		)
	bunga: (
		(['...hal'] + ['lo']) 
			bosh-harflar 
			lowecase 
			bosh-harflar 
			surish: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Roʻyxat ← 0 ; 1 ; 4; 9 ; (Roʻyxat ← 0 ; 3; 1) ; 4
							) oxirgidan-oldingi
						) ? 1
					) + 
					((Roʻyxat ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					soni
				)
			)
	).

} × 10.
Chiqish yozish: x, yangi-qator.

