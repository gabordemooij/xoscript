Chiqish yozish: ['Test object'], yangi-qator.
>> greeter := Obyekt yangi.
greeter kelganda: ['name:'] bajar: { :nom
	oʻzining xname := nom. 
}.
greeter kelganda: ['greet'] bajar: {
	Chiqish yozish: ['Hello '] + oʻzining xname, yangi-qator.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Chiqish yozish: ['========== RELOADING SNAP:'], yangi-qator.
>> b := Obyekt load-from: ['/tmp/a.bin'].
>> c := Obyekt load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
