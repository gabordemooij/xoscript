>> t := Hech.

# you can control the time zone for
# parsing like this:
Lahza vaqt-mintaqasi: ['CET'].
t := Lahza manba: ['1981-02-03 04:05:06'].
Chiqish yozish: t, yangi-qator.

# now using CEST time zone:
Lahza vaqt-mintaqasi: ['CEST'].
t := Lahza manba: ['1981-02-03 04:05:06'].
Chiqish yozish: t, yangi-qator.

# error if string cannot be parsed
{ Lahza manba: ['1900']. } ushlash: { Hech. }, ishga-tushirish.
