>> makeAdder := { :x
	>> f := { :y <- (oʻzining x + y). } oʻrnatish: ['x'] qiymat: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i oʻzining q qoʻyish: (oʻzining f qoʻllash: (oʻzining q ? i)) kalit: i. } 
	oʻrnatish: ['q'] qiymat: array,
	oʻrnatish: ['f'] qiymat: func.
	{ :i mapping qoʻllash: i. } × (array soni).
}.

>> a := Roʻyxat ← 1; 2; 3.
mapper qoʻllash: a va: (makeAdder qoʻllash: 100).
Chiqish yozish: (a oʻrin: 0), yangi-qator.
Chiqish yozish: (a ? 1), yangi-qator.
Chiqish yozish: (a ? 2), yangi-qator.
