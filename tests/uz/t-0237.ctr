
Matn kelganda: ['evaluate'] bajar: {
	>> kod := Fayl yangi: ['/tmp/eval.ctr'].
	kod yozish: (oʻzi matn + ['.']).
	Dastur foydalanish: ['/tmp/eval.ctr'].
}.

>> map :=
	(Lugʻat yangi)
	qoʻyish: ['Hi There'] kalit: ['two'],
	qoʻyish: (Roʻyxat ← ['hello'] ; ['world'] ; (Roʻyxat ← 1 ; 2; 9) ; Yolgʻon) kalit: ['one'],
	qoʻyish: ( (Lugʻat yangi) qoʻyish: ['wrrld'] kalit: ['misspelled'] ) kalit: ['three'],
	qoʻyish: (Roʻyxat ← ((Lugʻat yangi) qoʻyish: ['treasure'] kalit: ['hidden']) ; 2) kalit: ['four']. 
>> str := map matn.
>> map2 := Hech.
(['map2 := '] + str ) evaluate.
Chiqish yozish: map2 ? ['one'] ? 0.
Chiqish yozish: map2 ? ['one'] ? 1.
Chiqish yozish: map2 ? ['four'] ? 0 ? ['hidden'].
Chiqish yozish: map2 ? ['one'] ? 2 ? 2.
