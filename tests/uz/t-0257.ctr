
>> Greeter := Obyekt yangi.
Greeter kelganda: ['yangi'] bajar: {
	oʻzining nom := ['?'].
}.
Greeter kelganda: ['name:'] bajar: { :nom
	oʻzining nom := nom.
}.
Greeter kelganda: ['greet'] bajar: {
	Chiqish yozish: (['hello[you]'] [you]: oʻzining nom).
}.
>> friend := Greeter yangi.
friend name: ['1'].
friend greet.
