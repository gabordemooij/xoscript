
Server init.
Chiqish yozish: ['Database test'], yangi-qator.

>> db := Maria-DB yangi xost: ['localhost'],
	foydalanuvchi-nomi: ['xo'], 
	parol: ['pass123'],
	baza-nomi: ['xobase'],
	ulanish.

>> qidiruv-parametrlari :=
db soʻrov: ['SELECT REPEAT('Blah',1000) AS blah'], 
olish: { :row 
	Chiqish yozish: row blah uzunlik, yangi-qator.
}.
