Chiqish yozish: ['Test object'], yangi-qator.
>> a := Obyekt yangi. 

a kelganda: ['item:'] bajar: { :out
	oʻzining out := out. 
}.

a kelganda: ['item'] bajar: { <- oʻzining out.
}.

a kelganda: ['greet'] bajar: {
	Chiqish yozish: ['hi from original out!'], yangi-qator.
}.

a item: Chiqish.

Chiqish yozish: a item, yangi-qator.

>> old-out-address := a item prototip xotira-manzili.
a save-as: ['/tmp/a.bin'].
Chiqish yozish: ['========== RELOADING SNAP:'], yangi-qator.

>> b := Obyekt load-from: ['/tmp/a.bin'].

(b item prototip xotira-manzili = old-out-address) rost-boʻlsa: {
	Chiqish yozish: ['Object link re-attached.'], yangi-qator.
}.

b item yozish: ['hello from loaded out!'], yangi-qator.
b greet.
