# test number -> string -> number
{

	>> x := Son orasida: 0 bilan: 1000000.
	>> d := Son orasida: 1 bilan: 7.
	>> e := 10 daraja: d.

	x boʻlish-songa: e.
	>> y := x matn son.

	(x = y) yolgʻon-boʻlsa: {
		Chiqish yozish: x, yangi-qator.
		Chiqish yozish: y, yangi-qator.
		Dastur tugatish.
	}.

} * 1000.
Chiqish yozish: ['OK'], yangi-qator.