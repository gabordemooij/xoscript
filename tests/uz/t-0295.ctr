
>> dictionary := (
	Lugʻat yangi
		qoʻyish: ['b'] kalit: ['a'],
		qoʻyish: ['a'] kalit: ['b'],
		qoʻyish: ['z'] kalit: ['x'],
		qoʻyish: ['hello'] kalit: ['hallo'],
		qoʻyish: ['human'] kalit: ['human']
).

>> comparisons := Roʻyxat yangi.
dictionary har-bir: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a taqqoslash: b)
	).
}.

comparisons saralash: { :a :b <- ( a taqqoslash: b ). }.
Chiqish yozish: ( comparisons birlashtirish: ['↵'] ), yangi-qator.
comparisons birlashtirish: ['↵'].
