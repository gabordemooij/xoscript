#Linux

(Fayl yangi: ['/tmp/testje']) mavjud yolgʻon-boʻlsa: {
	Dastur tizim: ['mkdir /tmp/testje'].	
}.

(Fayl yangi: ['/tmp/testje/file1']) mavjud yolgʻon-boʻlsa: {
	Dastur tizim: ['touch /tmp/testje/file1'].	
}.

(Fayl yangi: ['/tmp/testje/folder1']) mavjud yolgʻon-boʻlsa: {
	Dastur tizim: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Fayl roʻyxat: ['/tmp/testje'].

>> q := Roʻyxat yangi.

l har-bir: { :k :v v har-bir: { :x :y q oxiriga-qoʻshish: y. }. }.

>> s := q matn.

(s ichida-bor: ['file1']) rost-boʻlsa:   { Chiqish yozish: ['OK'], yangi-qator. }.
(s ichida-bor: ['file2']) rost-boʻlsa:   { Chiqish yozish: ['XX'], yangi-qator. }.
(s ichida-bor: ['folder1']) rost-boʻlsa: { Chiqish yozish: ['OK'], yangi-qator. }.
