Server init.

>> DB := Maria-DB yangi xost: ['localhost'],
	foydalanuvchi-nomi: ['xo'],
	parol: ['pass123'],
	baza-nomi: ['xobase'],
	ulanish.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> qidiruv-parametrlari := Maria-Soʻrov yangi: SQL.

# set database
qidiruv-parametrlari maʼlumotlar-bazasi: DB.

qidiruv-parametrlari olish: { :row
	Chiqish yozish: row world, yangi-qator.
}.
