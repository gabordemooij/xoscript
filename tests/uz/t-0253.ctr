#Linux
>> OS := Dastur sozlama: ['OS'].

>> clock := Lahza yangi.
	
(OS = ['Haiku']) rost-boʻlsa: {
	clock vaqt-mintaqasi: ['CET'],
	yil: 2017, oy: 7, kun: 13,
	soat: 18, daqiqa: 0, soniya: 0.
}, aks-holda: {
	clock vaqt-mintaqasi: ['Europe/Amsterdam'],
	yil: 2017, oy: 7, kun: 13,
	soat: 18, daqiqa: 0, soniya: 0.
}.

clock kelganda: ['tell'] bajar: {
	Chiqish yozish: oʻzi, yangi-qator.
}.


clock qoʻshish: 2    soat, tell.
clock qoʻshish: 1    soat, tell.
clock qoʻshish: 19 daqiqa, tell.
clock qoʻshish: 1  daqiqa, tell.
clock qoʻshish: 1  daqiqa, tell.
clock qoʻshish: 19 soniya, tell.
clock qoʻshish: 1  soniya, tell.
clock qoʻshish: 1  soniya, tell.
clock qoʻshish: 2    yil, tell.
clock qoʻshish: 1    yil, tell.

(OS = ['Haiku']) rost-boʻlsa: {
clock qoʻshish: 5   oy.
clock vaqt-mintaqasi: ['CEST'], tell.
}, aks-holda: {
	clock qoʻshish: 5   oy, tell.
}.

clock qoʻshish: 1   oy, tell.
clock qoʻshish: 19    kun, tell.
clock qoʻshish: 1    soat, tell.
clock qoʻshish: 120  yard, tell.
