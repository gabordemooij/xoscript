# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Andoza yangi: pattern.
	p moslik: subject bajar: { :m :g
		Chiqish yozish: g soni, yozish: [' '], yozish: (g birlashtirish: ['|']), yangi-qator. <- m.
	}.
}.
show qoʻllash: ['(a)|(b)'] va: ['b'].
show qoʻllash: ['(a)|(b)'] va: ['a'].
show qoʻllash: ['(x)?y'] va: ['y'].
show qoʻllash: ['(x)?(y)(z)?'] va: ['xy'].
