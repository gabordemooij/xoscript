#Linux

 >> t := Lahza yangi.
 
t vaqt-mintaqasi: ['Europe/Amsterdam'].
t yil: 2020, oy: 8, kun: 2, soat: 21, daqiqa: 2, soniya: 1.

>> a := t soat.
>> ams := t vaqt-mintaqasi.

t vaqt-mintaqasi: ['US/Hawaii'].
>> b := t soat.
>> hw := t vaqt-mintaqasi.

Chiqish
yozish: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		bu: ['later'] yoki-u: ['earlier']
	)
),
yangi-qator.
 