>> invoice := Obyekt yangi.
invoice kelganda: ['ishga-tushirish'] bajar: {
        oʻzining son := 0.
}.

invoice kelganda: ['son'] bajar: {
        oʻzining son qoʻshish: 1. <- oʻzining son nusxa.
}.

>> year-invoice := invoice yangi.
year-invoice kelganda: ['start:'] bajar: { :yil
	oʻzining son := yil.
}.

year-invoice start: 202000.
Chiqish yozish: year-invoice son, yangi-qator.
Chiqish yozish: year-invoice son, yangi-qator.
