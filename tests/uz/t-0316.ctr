>> Grandfather := Obyekt yangi.
Grandfather kelganda: ['greet'] bajar: {
	Chiqish yozish: ['Ave!'], yangi-qator.
}.
>> Father := Grandfather yangi.
Father kelganda: ['greet'] bajar: {
	Chiqish yozish: ['Hello'], yangi-qator.
	oʻzi greet.
}.
>> Son := Father yangi.
Son kelganda: ['greet'] bajar: {
	Chiqish yozish: ['Hi'], yangi-qator.
	oʻzi greet.
}.

Son greet.

>> Roundabout := Obyekt yangi.
Roundabout kelganda: ['circle:'] bajar: { :x
	Chiqish yozish: x, yangi-qator.
	(x < 3) rost-boʻlsa: { oʻzi rekursiv circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) rost-boʻlsa: { Chiqish yozish: x, yangi-qator. x qoʻshish: 1.  increment ishga-tushirish. }. }.
increment ishga-tushirish.