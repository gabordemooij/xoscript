

# create a 64-bit integer for exact calculations
>> a := Int64 matndan: ['123'].

# to string
Chiqish yozish: a, yangi-qator.

# divide
Chiqish yozish: a / (Int64 matndan: ['3']), yangi-qator.

# multiply
Chiqish yozish: a * (Int64 matndan: ['2']), yangi-qator.

# add
Chiqish yozish: a + (Int64 matndan: ['1']), yangi-qator.

# subtract
Chiqish yozish: a - (Int64 matndan: ['2']), yangi-qator.

# compare
Chiqish yozish: ( a =   (Int64 matndan: ['123'])), yangi-qator.
Chiqish yozish: ( a !=: (Int64 matndan: ['124'])), yangi-qator.
Chiqish yozish: ( a <   (Int64 matndan: ['124'])), yangi-qator.
Chiqish yozish: ( a >   (Int64 matndan: ['122'])), yangi-qator.
Chiqish yozish: ( a >=: (Int64 matndan: ['123'])), yangi-qator.
Chiqish yozish: ( a <=: (Int64 matndan: ['123'])), yangi-qator.





	