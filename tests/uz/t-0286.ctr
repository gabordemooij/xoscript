['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Chiqish yozish: (x + y), yangi-qator.

>> x := 10040.07.
>> y := 10305.60.

Chiqish yozish: (x + y), yangi-qator.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Chiqish yozish: (x + y + z), yangi-qator.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Chiqish yozish: (x + y + z), yangi-qator.

>> q := 0.1.2.

Chiqish yozish: (q), yangi-qator.

>> q := 012.

Chiqish yozish: (q), yangi-qator.
