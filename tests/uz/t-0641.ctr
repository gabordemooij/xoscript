# Test utf8 sanitizer
Server init.

>> utf8cases := Lugʻat yangi
	# ASCII only
	qoʻyish: ( Roʻyxat yangi ; 65 ; 65 ; 65 ; 65 ; 0 ) kalit: ['AAAA'],
	# valid 2 byte sequence
	qoʻyish: ( Roʻyxat yangi ; 194 ; 162 ; 0 ) kalit: ['¢'],
	# Valid 3-byte UTF-8
    qoʻyish: ( Roʻyxat yangi ; 226 ; 130 ; 172 ; 0 ) kalit: ['€'],
	# Valid 4-byte UTF-8
    qoʻyish: ( Roʻyxat yangi ; 240 ; 144 ; 141 ; 136 ; 0 ) kalit: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    qoʻyish: ( Roʻyxat yangi ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) kalit: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    qoʻyish: ( Roʻyxat yangi ; 65 ; 193 ; 129 ; 0 ) kalit: ['A?'],
	# Invalid first byte (0xFF)
    qoʻyish: ( Roʻyxat yangi ; 255 ; 0 ) kalit: ['?'],
	# Incomplete multi-byte sequence at end
    qoʻyish: ( Roʻyxat yangi ; 66 ; 226 ; 0 ) kalit: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    qoʻyish: ( Roʻyxat yangi ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) kalit: ['A€?𐍈B'].
	 
utf8cases har-bir: { :key :value
	>> blob := Blob yangi: value soni, bytes: value.
	>> str := blob matn.
	(str = key) rost-boʻlsa: {
		Chiqish yozish: ['OK'], yangi-qator.
	}, aks-holda: {
		Chiqish yozish: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, yangi-qator.
	}.
	blob boʻshatish.
}.
