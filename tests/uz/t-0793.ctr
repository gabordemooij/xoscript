Server init.

>> DB := Maria-DB yangi xost: ['localhost'],
	foydalanuvchi-nomi: ['xo'],
	parol: ['pass123'],
	baza-nomi: ['xobase'],
	ulanish.

{
	DB soʻrov:
	['DROP TABLE movies'],
	bajarish.
} ushlash: { Hech. }, ishga-tushirish.

DB soʻrov:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
bajarish.

DB soʻrov: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parametrlar: ( Roʻyxat yangi ; ['Halloween'] ),
bajarish.

DB soʻrov: ['SELECT * FROM movies'],
olish: { :movie
	Chiqish yozish: movie title, yangi-qator.
}.

