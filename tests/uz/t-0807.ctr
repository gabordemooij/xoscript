# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB yangi xost: ['localhost'],
	foydalanuvchi-nomi: ['xo'],
	parol: ['pass123'],
	baza-nomi: ['xobase'],
	ulanish.

>> qidiruv-parametrlari := db soʻrov: ['SELECT %% FROM'].
{ qidiruv-parametrlari bajarish. } ushlash: { :e
	Chiqish yozish: ( e ichida-bor: ['%%'] ), yangi-qator.
}, ishga-tushirish.
