>> Point := Obyekt yangi.
Point kelganda: ['x-coordinate:'] bajar: { :x oʻzining x := x. }.
Point kelganda: ['y-coordinate:'] bajar: { :y oʻzining y := y. }.
Point kelganda: ['x-coordinate']  bajar: { <- oʻzining x nusxa. }.
Point kelganda: ['y-coordinate']  bajar: { <- oʻzining y nusxa. }.

Point kelganda: ['='] bajar: { :other <- ( oʻzining x = other x-coordinate
		 va: oʻzining y = other y-coordinate ).
}.

>> pier := Point yangi x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point yangi x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point yangi x-coordinate: 5, y-coordinate: 6.

Chiqish yozish: pier = town-hall, yangi-qator.
Chiqish yozish: pier = restaurant, yangi-qator.
