#Linux
>> clock := Lahza yangi.
clock vaqt-mintaqasi: ['UTC-1'].
clock yil: 1981, oy: 1, kun: 5,
      soat: 13, daqiqa: 15, soniya: 13.

Chiqish yozish: clock, yangi-qator.
clock vaqt-mintaqasi: ['UTC+0'].

Chiqish yozish: (
	(clock yil oddiy) + ['-'] + (clock oy) + ['-'] + (clock kun) + [' '] +
	(clock soat) + [':'] + (clock daqiqa) + [':'] + (clock soniya) + [' '] +
	['W'] + (clock hafta) + (clock vaqt-mintaqasi)
), yangi-qator.


clock vaqt-mintaqasi: ['UTC-1'].
Chiqish yozish: (
	(clock yil oddiy) + ['-'] + (clock oy) + ['-'] + (clock kun) + [' '] +
	(clock soat) + [':'] + (clock daqiqa) + [':'] + (clock soniya) + [' '] +
	['W'] + (clock hafta) + (clock vaqt-mintaqasi)
), yangi-qator.
