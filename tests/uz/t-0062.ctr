Mantiqiy kelganda: ['xor:'] bajar: { :a :b <- ((a va: b teskari) yoki: (a teskari va: b)).
}.

>> o := Obyekt yangi.
o kelganda: ['hello'] bajar: { ['Empty']. }.
{ o kelganda: 2 bajar: 3.} ushlash: { :e Chiqish yozish: e, yangi-qator. }, ishga-tushirish.
{ o kelganda: ['sinov'] bajar: 3.} ushlash: { :e Chiqish yozish: e, yangi-qator. }, ishga-tushirish.
{ o kelganda: ['hello'] bajar: { ['Empty']. }.} ushlash: { :e Chiqish yozish: e, yangi-qator. }, ishga-tushirish. 
{ >> z := 4 ÷ 0. } ushlash: { :e Chiqish yozish: e, yangi-qator. }, ishga-tushirish. 
{ (Rost va: Hech) rost-boʻlsa: { Chiqish yozish: ['X'].}. } ushlash: { :e Chiqish yozish: e, yangi-qator. }, ishga-tushirish. 
{ ([''] xor: 0) rost-boʻlsa: { Chiqish yozish: ['X'].}. } ushlash: { :e Chiqish yozish: e, yangi-qator. }, ishga-tushirish. 
{ (1 < ['2']) rost-boʻlsa: { Chiqish yozish: ['OK']. }. } ushlash: { :e Chiqish yozish: e, yangi-qator. }, ishga-tushirish. 
{ (1 < ['2.0']) rost-boʻlsa: { Chiqish yozish: ['OK']. }. } ushlash: { :e Chiqish yozish: e, yangi-qator. }, ishga-tushirish. 
{ (1 < ['x2.0']) rost-boʻlsa: { Chiqish yozish: ['NO!']. }. } ushlash: { :e Chiqish yozish: e, yangi-qator. }, ishga-tushirish. 
{ Chiqish yozish: (['hello OK there'] boshlab: ['6'] uzunlik: ['2']). } ishga-tushirish. 
