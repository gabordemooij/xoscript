Chiqish yozish: ['Test object'], yangi-qator.
>> a := Obyekt yangi. 

a kelganda: ['state:'] bajar: { :list
	oʻzining list := list. 
}.

a kelganda: ['state'] bajar: {
	Chiqish yozish: oʻzining list, yangi-qator.
}.

a state: ( Roʻyxat yangi ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
Chiqish yozish: ['========== RELOADING SNAP:'], yangi-qator.
>> b := Obyekt load-from: ['/tmp/a.bin'].
b state.