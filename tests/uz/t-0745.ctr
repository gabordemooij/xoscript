Chiqish yozish: ['Test object'], yangi-qator.
>> a := Obyekt yangi. 

a kelganda: ['item:'] bajar: { :dict
	oʻzining dict := dict. 
}.

a kelganda: ['item'] bajar: { <- oʻzining dict.
}.

a item: (
Lugʻat yangi
	hello: ['world']).

>> old-dict-address := a item prototip xotira-manzili.
a save-as: ['/tmp/a.bin'].
Chiqish yozish: ['========== RELOADING SNAP:'], yangi-qator.

>> b := Obyekt load-from: ['/tmp/a.bin'].

(b item prototip xotira-manzili = old-dict-address) rost-boʻlsa: {
	Chiqish yozish: ['Object link re-attached.'], yangi-qator.
}.

Chiqish yozish: b item, yangi-qator.
