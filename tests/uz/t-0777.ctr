#OBSD
>> dirname := [''].
{ dirname oxiriga-qoʻshish: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Dastur tizim: command.
Dastur chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename oxiriga-qoʻshish: ['YYYYYYYY']. } * 20.
Fayl yangi: filename, yozish: ['sometext'].
{ Fayl roʻyxat: ['/tmp/'] + dirname. } * 1000.
Chiqish yozish: ['no crash'], yangi-qator.

