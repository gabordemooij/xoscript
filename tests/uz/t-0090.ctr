Chiqish yozish: ['1,2,3,4,5,6,7,8,9,A,'], yangi-qator.
>> Scope := Obyekt yangi.
Scope kelganda: ['initialize:'] bajar: { :x oʻzining property := x. }.
Scope kelganda: ['confirm'] bajar: { Chiqish yozish: [',']. }.
Scope kelganda: ['sinov'] bajar: {
	Chiqish yozish: oʻzining property.
	oʻzi confirm.
	( 1 = 1 ) rost-boʻlsa: { Chiqish yozish: oʻzining property. oʻzi confirm. }.
	( 1 = 0 ) yolgʻon-boʻlsa: { Chiqish yozish: oʻzining property. oʻzi confirm. }.
	>> y := 2. { Chiqish yozish: oʻzining property. oʻzi confirm. } hozircha: { y ayirish: 1. <- (y > 0). }.
	{ Chiqish yozish: oʻzining property. oʻzi confirm. } × 1.
	(Roʻyxat ← 1) har-bir: {  Chiqish yozish: oʻzining property. oʻzi confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Lugʻat yangi one: ['item']) har-bir: { Chiqish yozish: oʻzining property. oʻzi confirm. }.
	{ 1 ÷ 0. } ushlash: { Chiqish yozish: oʻzining property. oʻzi confirm. }, ishga-tushirish.
	Chiqish yangi-qator.
}.
>> scope1 := Scope yangi.
scope1 initialize: ['X'].
scope1 sinov.
>> function := { 
	oʻzining property := ['Y'].
	Chiqish yozish: oʻzining property.
	oʻzi confirm.
	( 1 = 1 ) rost-boʻlsa: { Chiqish yozish: oʻzining property. oʻzi confirm. }.
	( 1 = 0 ) yolgʻon-boʻlsa: { Chiqish yozish: oʻzining property. oʻzi confirm. }.
	>> y := 2. { Chiqish yozish: oʻzining property. oʻzi confirm. } hozircha: { y ayirish: 1. <- (y > 0). }.
	{ Chiqish yozish: oʻzining property. oʻzi confirm. } × 1.
	(Roʻyxat ← 1) har-bir: {  Chiqish yozish: oʻzining property. oʻzi confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Lugʻat yangi one: ['item']) har-bir: { Chiqish yozish: oʻzining property. oʻzi confirm. }.
	{ 1 ÷ 0. } ushlash: { Chiqish yozish: oʻzining property. oʻzi confirm. }, ishga-tushirish.
	Chiqish yangi-qator.
}.
function kelganda: ['confirm'] bajar: { Chiqish yozish: [',']. }.
function qoʻllash: 1 va: 2.
