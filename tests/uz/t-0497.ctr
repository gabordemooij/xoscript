Server init.

# write a test file
>> f := Fayl yangi: ['/tmp/test.gif'].
f yozish: ['GIF87a01234567810'].

# serve the file
Server oʻtkazish: ['test.gif'] prefiks: ['/tmp/'].

Chiqish yangi-qator.

Chiqish yozish: ['Outside container (security):'], yangi-qator.
{ Server oʻtkazish: ['../passwd'] prefiks: ['/tmp/']. }
ushlash: { :e Chiqish yozish: e, yangi-qator. },
ishga-tushirish.

Chiqish yozish: ['Invalid prefix:'], yangi-qator.
{ Server oʻtkazish: ['test.gif'] prefiks: ['z:\\']. }
ushlash: { :e Chiqish yozish: e, yangi-qator. },
ishga-tushirish.

Chiqish yozish: ['Non-existant file:'], yangi-qator.
{ Server oʻtkazish: ['xxx.xxx'] prefiks: ['/tmp/']. }
ushlash: { :e Chiqish yozish: e, yangi-qator. },
ishga-tushirish.
