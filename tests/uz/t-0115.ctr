{
	shu-vazifa xato: ['Dont fail.'].
	unknown doSomething.
} ushlash: {
	Chiqish yozish: ['Caught!'].
}, ishga-tushirish.

{
	shu-vazifa xato: ['Dont fail.'].
	oʻzining unknown doSomething.
} ushlash: {
	Chiqish yozish: ['Caught!'].
}, ishga-tushirish.

{
	shu-vazifa xato: ['Dont fail.'].
	unknown := 122.
} ushlash: {
	Chiqish yozish: ['Caught!'].
}, ishga-tushirish.


{
	shu-vazifa xato: ['Dont fail.'].
	Rost uzish.
	Chiqish yozish: ['FAIL'].
} ushlash: {
	Chiqish yozish: ['Caught!'].
}, ishga-tushirish.

{
	{
		shu-vazifa xato: ['Dont fail.'].
		Rost uzish.
		Chiqish yozish: ['FAIL'].
	} ushlash: { :x
		(x = ['Dont fail.']) rost-boʻlsa: { shu-vazifa xato: ['Nested Caught!']. }.
	}, ishga-tushirish.
} ushlash: { :e
	Chiqish yozish: e.
}, ishga-tushirish.
