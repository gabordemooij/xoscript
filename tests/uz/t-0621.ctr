>> phrases := Roʻyxat yangi
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases har-bir: { :_ :phrase 
	>> e := Server base64-kodlash: phrase.
	>> d := Server base64-dekodlash: e.
	Chiqish yozish: (
		message nusxa ~encoded: e, ~decoded: d
	), yangi-qator.
}.
