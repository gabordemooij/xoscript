>> Greeter := Obyekt yangi.
Greeter kelganda: ['make'] bajar: {
	>> greeter := Obyekt yangi.
	greeter kelganda: ['name:'] bajar: { :nom
		Chiqish yozish: ['setting a name'].
		oʻzining myName := nom.
	}.
	greeter kelganda: ['greet'] bajar: {
		Chiqish yozish: ['Hello'].
		Chiqish yozish: oʻzining myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
