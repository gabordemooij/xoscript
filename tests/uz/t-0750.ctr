Chiqish yozish: ['Test object'], yangi-qator.
>> a := Obyekt yangi. 

a kelganda: ['item:'] bajar: { :nil
	oʻzining nil := nil. 
}.

a kelganda: ['item'] bajar: { <- oʻzining nil.
}.

a item: Hech.

Chiqish yozish: a item, yangi-qator.

>> old-nil-address := a item prototip xotira-manzili.
a save-as: ['/tmp/a.bin'].
Chiqish yozish: ['========== RELOADING SNAP:'], yangi-qator.

>> b := Obyekt load-from: ['/tmp/a.bin'].

(b item prototip xotira-manzili = old-nil-address) rost-boʻlsa: {
	Chiqish yozish: ['Object link re-attached.'], yangi-qator.
}.

Chiqish yozish: b item, yangi-qator.
