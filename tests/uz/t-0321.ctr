# test qualifiers

Dastur tozalash.

>> Fruit := Obyekt yangi.
Fruit kelganda: ['yangi'] bajar: {
	>> f := oʻzi yangi.
	f apples: 0. <- f.
}.
Fruit kelganda: ['apples:'] bajar: { :a oʻzining apples := a. }.
Fruit kelganda: ['apples'] bajar: { <- oʻzining apples. }.
Fruit kelganda: ['+'] bajar: { :f
	>> n := Fruit yangi.
	n apples: (f apples + oʻzining apples). <- n.
}.
Son kelganda: ['apples'] bajar: { <- ((Fruit yangi) apples: oʻzi).
}.

Fruit kelganda: ['matn'] bajar: { <- oʻzining apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Chiqish yozish: q, yangi-qator.




q := 3 apples + 4 apples.
Chiqish yozish: q, yangi-qator.



q := 3 apples + 4 apples.
Chiqish yozish: q, yangi-qator.


