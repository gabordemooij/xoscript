Dastur xotira-boshqaruvi: 0.
Roʻyxat kelganda: ['sum'] bajar: {
	>> total := 0.
	oʻzi har-bir: { :index :element
		total qoʻshish: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Fayl yangi: ['/tmp/test.txt'].
f yozish: ['Lorem Ipsum'].
f yopish.
  

f := Fayl yangi: ['/tmp/test.txt'].
>> text := f oʻqish.
f yopish.



Dastur tozalash.
usedMemory1 := (Dastur xotira ? 1).



f := Fayl yangi: ['/tmp/test.txt'].
text := f oʻqish.
f yopish.

Dastur tozalash.
usedMemory2 := (Dastur xotira ? 1).


f := Fayl yangi: ['/tmp/test.txt'].
text := f oʻqish.
f yopish.

Dastur tozalash.
usedMemory3 := (Dastur xotira ? 1).



( usedMemory1 = usedMemory2 va: usedMemory1 = usedMemory3, va: usedMemory2 = usedMemory3 ) rost-boʻlsa: {
	Chiqish yozish: ['No memory leaks here'].
}, yolgʻon-boʻlsa: {
	Chiqish yozish: ['Leaking memory...'].
}.
