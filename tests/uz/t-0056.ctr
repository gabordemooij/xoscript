>> z := Obyekt yangi.
z kelganda: ['value:'] bajar: { :v
	oʻzining value := v. <- oʻzi.
}.
z kelganda: ['value'] bajar: { <- oʻzining value. }.
(z setValue: 1) value: 2.
Chiqish yozish: z value.
>> x := z.
Chiqish yozish: x value.
z := Hech.
Chiqish yozish: z value.
Chiqish yozish: x value.
Chiqish yozish: ['hello'].
Chiqish yozish: 3 + 2.
Chiqish yozish: (3 > 2).
