

Roʻyxat kelganda: ['column:'] bajar: { :column
	>> result := Roʻyxat yangi.
	oʻzi har-bir: { :index :row
		row har-bir: { :index :cell
			(index = column) rost-boʻlsa: { result oxiriga-qoʻshish: cell. }.
		}.
	}. <- result.
}.


>> a := Roʻyxat ←
	(Roʻyxat ← 1 ; 2 ; 3) ;
	(Roʻyxat ← 4 ; 5 ; 6) ;
	(Roʻyxat ← 7 ; 8 ; 9).

>> b := a column: 1.
Chiqish yozish: b, yangi-qator.

b := a column: 20.
Chiqish yozish: b, yangi-qator.

b := a column: -100.
Chiqish yozish: b, yangi-qator.
