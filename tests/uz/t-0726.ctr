# test buffers PKI/Sign 
Server init.

>> long := ( Roʻyxat yangi toʻldirish: 1000 qiymat-bilan: ['a'] ) birlashtirish: [''].

# sign a message
Chiqish yozish: ( 
	Seyf imzolash: ['abc'] kalit-bilan: long
), yangi-qator.

Chiqish yozish: ( 
	Seyf
		tekshirish: ['abc'] 
		imzo: long 
		kalit-bilan: long
), yangi-qator.

Chiqish yozish: (
	Seyf parol-xeshi: long tekshirish: long
), yangi-qator.
