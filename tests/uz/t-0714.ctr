>> a := Obyekt yangi. 
a kelganda: ['greet'] bajar: { Chiqish yozish: ['welcome!'], yangi-qator. }.
a kelganda: ['greet2'] bajar: { Chiqish yozish: ['welcome2!'], yangi-qator. }.
a save-as: ['/tmp/a.bin'].

Chiqish yozish: ['========== RELOADING SNAP:'], yangi-qator.
>> b := Obyekt load-from: ['/tmp/a.bin'].
b greet2.