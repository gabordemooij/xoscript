Server init.
>> f := Format yangi: ['%d'].
>> a := Blob yangi: 4.
a bytes: ( Roʻyxat yangi ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob yangi: 4.
b bytes: ( Roʻyxat yangi ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a boshlab: 0 uzunlik: 3, har-bir: { :i :byte
	Chiqish yozish: ( f qoʻllash-butun: byte ), yangi-qator.
}.
a ^ b.
a boshlab: 0 uzunlik: 3, har-bir: { :i :byte
	Chiqish yozish: ( f qoʻllash-butun: byte ), yangi-qator.
}.
a ^ b.
a boshlab: 0 uzunlik: 3, har-bir: { :i :byte
	Chiqish yozish: ( f qoʻllash-butun: byte ), yangi-qator.
}.
a boʻshatish.
b boʻshatish.

{ a ^ Obyekt. } ushlash: { :e Chiqish yozish: e, yangi-qator. }, ishga-tushirish.
