Roʻyxat kelganda: ['nusxa'] bajar: {
	>> nusxa := Roʻyxat yangi.
	oʻzi har-bir: { :son :section
		nusxa oxiriga-qoʻshish: section rekursiv nusxa.
	}. <- nusxa.
}.

>> sheep := Roʻyxat yangi ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep nusxa.
clones har-bir: { :son :sheep
	sheep oxiriga-qoʻshish: ['2'].
}.

Chiqish yozish: sheep, yangi-qator.
Chiqish yozish: clones, yangi-qator.
