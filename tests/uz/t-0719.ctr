Server init.
>> fmt := Format yangi: ['%#3x'].

>> blob := Blob yangi: 4.
blob bytes: ( 
	Roʻyxat yangi ; 0 ; 1 ; 2 ; 3
).

>> file := Fayl yangi: ['/tmp/blob'].
file blob: blob.
blob boʻshatish.

>> oʻqish := file blob.
oʻqish 
boshlab: 0 
uzunlik: 4, 
zanjir-boshi har-bir: { :i :b 
	Chiqish
	yozish: (fmt qoʻllash-butun: b),
	yangi-qator.
}.
oʻqish boʻshatish.
