

Matn kelganda: ['html'] bajar: { <- (
		oʻzi
		almashtirish: ['&'] bunga: ['&amp;'],
		almashtirish: ['<'] bunga: ['&lt;'],
		almashtirish: ['>'] bunga: ['&gt;'],
		almashtirish: ['"'] bunga: ['&quot;']
	).
}.


Chiqish yozish: ([' left trimmed '] qirqish) + [' '] + ( ['and right trimmed'] qirqish) + ['!'], yangi-qator.
Chiqish yozish: ['<html>"html & entities"</html>'] html.
