
Server init.
>> rq := HTTP-Soʻrov yangi.
Chiqish yozish: ['HTTP-GET d[]=']  + ( rq get-roʻyxat: ['d[]'] ), yangi-qator. # GET
Chiqish yozish: ['HTTP-GET f[]=']  + ( rq get-roʻyxat: ['f[]'] ), yangi-qator. # GET
Chiqish yozish: ['HTTP-POST e[]='] + ( rq post-roʻyxat: ['e[]'] ), yangi-qator. # GET
Chiqish yozish: ['HTTP-POST c=']   + ( rq post: ['c'] ), yangi-qator. # GET
Chiqish yozish: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), yangi-qator. # GET
