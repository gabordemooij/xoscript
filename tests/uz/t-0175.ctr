

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> x := 100.

Dastur xotira-boshqaruvi: 0.

{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt oxiriga-qoʻshish: ['!!'].
Chiqish yozish: txt.
} ishga-tushirish.

Dastur tozalash.

usedMemory1 := (Dastur xotira ? 0).


{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt oxiriga-qoʻshish: ['!!'].
Chiqish yozish: txt.
} ishga-tushirish.

Dastur tozalash.
usedMemory2 := (Dastur xotira ? 0).


{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt oxiriga-qoʻshish: ['!!'].
Chiqish yozish: txt.
} ishga-tushirish.

Dastur tozalash.
usedMemory3 := (Dastur xotira ? 0).



( usedMemory1 = usedMemory2 va: usedMemory1 = usedMemory3, va: usedMemory2 = usedMemory3 ) rost-boʻlsa: {
	Chiqish yozish: ['No memory leaks here'].
}, yolgʻon-boʻlsa: {
	Chiqish yozish: ['Leaking memory...'].
}.
