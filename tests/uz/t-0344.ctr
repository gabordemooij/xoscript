# catch-all test (practical)
>> HTML := Matn yangi.
HTML kelganda: ['encode:'] bajar: { :tekst
	oʻzi oxiriga-qoʻshish: (tekst
	almashtirish: ['&'] bunga: ['&amp;'], 
	almashtirish: ['<'] bunga: ['&lt;'],
	almashtirish: ['>'] bunga: ['&gt;'],
	almashtirish: ['"'] bunga: ['&quot;']).
}.
>> blog := HTML yangi.
blog oxiriga-qoʻshish: ['<h1>'],
     encode: ['Koffie & Thee'],
     oxiriga-qoʻshish: ['</h1>'].
Chiqish yozish: blog, yangi-qator.


>> Roman := Son yangi.
Roman kelganda: ['stringy'] bajar: {
	>> a := [''].
	{ a oxiriga-qoʻshish: ['I']. } × oʻzi. <- a.
}.

>> x := Roman yangi.
x qoʻshish: 3.
Chiqish yozish: x stringy, yangi-qator.

>> Quantum := Mantiqiy yangi.
Quantum kelganda: ['true?'] bajar: { <- ['maybe True']. }.
Chiqish yozish: (Quantum yangi true?), yangi-qator.

>> Nihil := Hech yangi.
Nihil kelganda: ['matn'] bajar: { <- ['Nihil']. }.
Chiqish yozish: (Nihil yangi), yangi-qator.
