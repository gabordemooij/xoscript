Chiqish yozish: ['Test object'], yangi-qator.
>> a := Obyekt yangi. 

a kelganda: ['item:'] bajar: { :fmt
	oʻzining fmt := fmt. 
}.

a kelganda: ['item'] bajar: { <- oʻzining fmt.
}.

a item: ( Format yangi: ['|%s|'] ).

Chiqish yozish: a item, yangi-qator.

>> old-fmt-address := a item prototip xotira-manzili.
a save-as: ['/tmp/a.bin'].
Chiqish yozish: ['========== RELOADING SNAP:'], yangi-qator.

>> b := Obyekt load-from: ['/tmp/a.bin'].

(b item prototip xotira-manzili = old-fmt-address) rost-boʻlsa: {
	Chiqish yozish: ['Object link re-attached.'], yangi-qator.
}.

Chiqish yozish: ( b item qoʻllash: ['hello'] ), yangi-qator.
