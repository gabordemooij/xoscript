# compliance test

# use international numbers

Chiqish yozish: ['1000 -> '].
Chiqish yozish: 1000, yangi-qator. #1000

Chiqish yozish: ['1.5 -> '].
Chiqish yozish: 1.5, yangi-qator.  #1.5

Chiqish yozish: ['1001.5 -> '].
Chiqish yozish: 1.5 + 1000, yangi-qator. #1001.5

# use 0-indexed arrays
>> x := Roʻyxat yangi ; 1 ; 2 ; 3.
>> y := Roʻyxat yangi ; ['a'] ; ['b'] ; ['c'].

Chiqish yozish: ['1 -> '].
Chiqish yozish: x ? 0, yangi-qator. #1

Chiqish yozish: ['1 -> '].
Chiqish yozish: (x oʻrnida: 0), yangi-qator. #1

Chiqish yozish: ['1 -> '].
Chiqish yozish: x birinchi, yangi-qator. #1

Chiqish yozish: ['3 -> '].
Chiqish yozish: x oxirgi, yangi-qator. #3

Chiqish yozish: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Chiqish yozish: (x boʻyicha: y), yangi-qator.

Chiqish yozish: ['1 -> '].
Chiqish yozish: (x boshlab: 0 uzunlik: 1) birinchi, yangi-qator. #1

Chiqish yozish: ['0 -> '].
Chiqish yozish: (x topish: 1), yangi-qator. #0

x qoʻyish: 9 kalit: 0.

Chiqish yozish: ['9 -> '].
Chiqish yozish: (x oʻrnida: 0), yangi-qator. #9

x boshiga-qoʻshish: 8.
Chiqish yozish: ['8 -> '].
Chiqish yozish: (x oʻrnida: 0), yangi-qator. #9


x oxiriga-qoʻshish: 10.
Chiqish yozish: ['10 -> '].
Chiqish yozish: (x oʻrnida: 4), yangi-qator. #10








