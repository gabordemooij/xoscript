Son kelganda: ['factorial'] bajar: {
	>> total := 1.
	{ :index total koʻpaytirish: (oʻzi - (index)). } × oʻzi. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Chiqish yozish: a.
>> b := 2 + 3 factorial.
Chiqish yozish: b.
>> c := 3 factorial + 2.
Chiqish yozish: c.
>> d := 2 + (3 factorial).
Chiqish yozish: d.
Chiqish yozish: 2 + 3 factorial + 1.
