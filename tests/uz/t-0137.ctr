(usedMemory1 = usedMemory2 = usedMemory3 = usedMemory4 = usedMemory5) rost-boʻlsa: {
	Chiqish yozish: ['Memory usage remains stable.'], yangi-qator.
}, aks-holda: {
	Chiqish yozish: ['Used memory not stable.'], yangi-qator.
