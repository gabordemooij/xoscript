


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Dastur xotira-boshqaruvi: 0.
>> palette := Hech.
>> colors := Hech.

{
palette := Lugʻat yangi.
palette 
	qoʻyish: ['#F00'] kalit: ['red'],
	qoʻyish: ['#0F0'] kalit: ['green'],
	qoʻyish: ['#00F'] kalit: ['blue'].
Chiqish yozish: ['number of RGB codes in palette: '] + ( palette soni ), yangi-qator.
Chiqish yozish: ['RGB code of green is: '] + ( palette ? ['green'] ), yangi-qator.
colors := [''].
( palette har-bir: { :nom :kod
		colors := colors + ( nom + [':'] + kod ).
} ).
Chiqish yozish: ['All colors in palette: '] + colors, yangi-qator.
} ishga-tushirish.
Dastur tozalash.
usedMemory1 := (Dastur xotira ? 0).

{
palette := Lugʻat yangi.
palette 
	qoʻyish: ['#F00'] kalit: ['red'],
	qoʻyish: ['#0F0'] kalit: ['green'],
	qoʻyish: ['#00F'] kalit: ['blue'].
Chiqish yozish: ['number of RGB codes in palette: '] + ( palette soni ), yangi-qator.
Chiqish yozish: ['RGB code of green is: '] + ( palette ? ['green'] ), yangi-qator.
colors := [''].
( palette har-bir: { :nom :kod
		colors := colors + ( nom + [':'] + kod ).
} ).
Chiqish yozish: ['All colors in palette: '] + colors, yangi-qator.
} ishga-tushirish.
Dastur tozalash.
usedMemory2 := (Dastur xotira ? 0).

{
palette := Lugʻat yangi.
palette 
	qoʻyish: ['#F00'] kalit: ['red'],
	qoʻyish: ['#0F0'] kalit: ['green'],
	qoʻyish: ['#00F'] kalit: ['blue'].
Chiqish yozish: ['number of RGB codes in palette: '] + ( palette soni ), yangi-qator.
Chiqish yozish: ['RGB code of green is: '] + ( palette ? ['green'] ), yangi-qator.
colors := [''].
( palette har-bir: { :nom :kod
		colors := colors + ( nom + [':'] + kod ).
} ).
Chiqish yozish: ['All colors in palette: '] + colors, yangi-qator.
} ishga-tushirish.
Dastur tozalash.
usedMemory3 := (Dastur xotira ? 0).



( usedMemory1 = usedMemory2 va: usedMemory1 = usedMemory3, va: usedMemory2 = usedMemory3 ) rost-boʻlsa: {
	Chiqish yozish: ['No memory leaks here'].
}, yolgʻon-boʻlsa: {
	Chiqish yozish: ['Leaking memory...'].
}.
