>> items := Lugʻat yangi.
items qoʻyish: ['green'] kalit: ['color-1'].
items qoʻyish: ['orange'] kalit: ['color-2'].
items qoʻyish: ['red'] kalit: ['color-3'].
>> i := 0.
>> s := [''].
items har-bir: { :key :color
	Chiqish yozish: ['color #'] + i + [' is: '] + color + [' '].
	i qoʻshish: 1.
}.
Chiqish yozish: i + [' colors!'].
