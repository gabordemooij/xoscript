

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Dastur xotira-boshqaruvi: 0.

>> txt := ['1.6'].
>> n := txt son.
>> t := txt mantiqiy.
Chiqish yozish: n, yangi-qator.
Chiqish yozish: t, yangi-qator.
Chiqish yozish: n tur, yangi-qator.
Chiqish yozish: t tur, yangi-qator.

Dastur tozalash.

usedMemory1 := (Dastur xotira ? 0).


txt := ['1.6'].
n := txt son.
t := txt mantiqiy.
Chiqish yozish: n, yangi-qator.
Chiqish yozish: t, yangi-qator.
Chiqish yozish: n tur, yangi-qator.
Chiqish yozish: t tur, yangi-qator.

Dastur tozalash.
usedMemory2 := (Dastur xotira ? 0).


txt := ['1.6'].
n := txt son.
t := txt mantiqiy.
Chiqish yozish: n, yangi-qator.
Chiqish yozish: t, yangi-qator.
Chiqish yozish: n tur, yangi-qator.
Chiqish yozish: t tur, yangi-qator.

Dastur tozalash.
usedMemory3 := (Dastur xotira ? 0).



( usedMemory1 = usedMemory2 va: usedMemory1 = usedMemory3, va: usedMemory2 = usedMemory3 ) rost-boʻlsa: {
	Chiqish yozish: ['No memory leaks here'].
}, yolgʻon-boʻlsa: {
	Chiqish yozish: ['Leaking memory...'].
}.
