Son kelganda: ['factorial'] bajar: {
	>> total := 1.
	{ :index total koʻpaytirish: (oʻzi - index). } × oʻzi. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Dastur xotira-boshqaruvi: 0.

{
2 exponent factorial.
Chiqish yozish: (11 qoldiq: 3), yangi-qator.
Chiqish yozish: (3.4 yaxlitlash), yangi-qator.
Chiqish yozish: (7.1 yuqoriga-yaxlitlash), yangi-qator.
Chiqish yozish: (7.9 pastga-yaxlitlash), yangi-qator.
}
ishga-tushirish.

Dastur tozalash.

usedMemory1 := (Dastur xotira ? 0).

{
2 exponent factorial.
Chiqish yozish: (11 qoldiq: 3), yangi-qator.
Chiqish yozish: (3.4 yaxlitlash), yangi-qator.
Chiqish yozish: (7.1 yuqoriga-yaxlitlash), yangi-qator.
Chiqish yozish: (7.9 pastga-yaxlitlash), yangi-qator.
}
ishga-tushirish.

Dastur tozalash.
usedMemory2 := (Dastur xotira ? 0).


{
2 exponent factorial.
Chiqish yozish: (11 qoldiq: 3), yangi-qator.
Chiqish yozish: (3.4 yaxlitlash), yangi-qator.
Chiqish yozish: (7.1 yuqoriga-yaxlitlash), yangi-qator.
Chiqish yozish: (7.9 pastga-yaxlitlash), yangi-qator.
} ishga-tushirish.

Dastur tozalash.
usedMemory3 := (Dastur xotira ? 0).



( usedMemory1 = usedMemory2 va: usedMemory1 = usedMemory3, va: usedMemory2 = usedMemory3 ) rost-boʻlsa: {
	Chiqish yozish: ['No memory leaks here'].
}, yolgʻon-boʻlsa: {
	Chiqish yozish: ['Leaking memory...'].
}.
