# backslashes must survive code serialization, strings must not end early
>> qiymatlar := Roʻyxat yangi
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

qiymatlar har-bir: { :i :value
	>> d := Lugʻat yangi.
	d qoʻyish: value kalit: ['k'].
	>> r := d kod obyekt.
	Chiqish yozish: r soni, yangi-qator.
	Chiqish yozish: ( (r oʻrnida: ['k']) = value ), yangi-qator.
}.
