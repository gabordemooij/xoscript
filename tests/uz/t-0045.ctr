Dastur xotira-boshqaruvi: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } ushlash: {
		oops qoʻshish: 1.
	}, ishga-tushirish.
} × 1000.

{
	Chiqish yozish: ['hi there!'].
	shu-vazifa xato: ['oops'].
	Chiqish yozish: ['hi there!'].
	{ Chiqish yozish: ['dont print this']. } ishga-tushirish.
} ushlash: { :e 
	Chiqish yozish: ['got ya!']. 
	Chiqish yozish: e.
}, ishga-tushirish.
