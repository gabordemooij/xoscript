
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> kod := {
	>> o := (
		Lugʻat yangi
		aa: (Roʻyxat ← 1 ; 2),
		bb: (Roʻyxat ← 3 ; 4)
	).
	>> s := o matn.
	>> o2 := s obyekt.
	(s  tur = Matn tur) rost-boʻlsa: { Chiqish yozish: ['OK1'], yangi-qator. }.
	(o2 tur = Lugʻat tur) rost-boʻlsa: { Chiqish yozish: ['OK2'], yangi-qator. }.
}.

Dastur xotira-boshqaruvi: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Dastur tozalash.
usedMemory1 := (Dastur xotira ? 1).
kod ishga-tushirish.
Dastur tozalash.
usedMemory2 := (Dastur xotira ? 1).
kod ishga-tushirish.
Dastur tozalash.
usedMemory3 := (Dastur xotira ? 1).
kod ishga-tushirish.
Dastur tozalash.
usedMemory4 := (Dastur xotira ? 1).

(usedMemory2 = usedMemory3 = usedMemory4) rost-boʻlsa: { Chiqish yozish: ['OK3'], yangi-qator. }.
 
