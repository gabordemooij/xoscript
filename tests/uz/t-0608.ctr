
>> Size := Obyekt yangi.
Size kelganda: ['is:'] bajar: { :son
	son kelganda: ['+'] bajar: { :son
		>> unit := son oʻlchov-birligi.
		>> factor := 1.
		
		unit
		holat: ['inch'] bajar: { factor := 0.0833. }. <- oʻzi + (son * factor).
	}. <- son.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Chiqish yozish: plank + edge, yangi-qator.
