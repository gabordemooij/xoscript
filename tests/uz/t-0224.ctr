
>> countries := Roʻyxat yangi
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Roʻyxat yangi
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods boʻyicha: countries, har-bir: { :key :value
	counter qoʻshish: 1.
}.

Chiqish yozish: (['we serve counter dishes'] counter: counter), yangi-qator.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] belgilar saralash: { :v
	counter qoʻshish: 0.
}.

Chiqish yozish: (['we sort counter dishes'] counter: counter), yangi-qator.


>> counter := 0.
{
	{
		counter qoʻshish: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Chiqish yozish: (['we calculate counter numbers.'] counter: counter), yangi-qator.

