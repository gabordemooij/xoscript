

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Dastur xotira-boshqaruvi: 0.

Son kelganda: ['addNum:'] bajar: { :x
	oʻzi qoʻshish: x.
}.

Son kelganda: ['subtractNum:'] bajar: { :x
	oʻzi ayirish: x.
}.

Son kelganda: ['multiplyBy:'] bajar: { :x
	oʻzi koʻpaytirish: x.
}.

Son kelganda: ['divideBy:'] bajar: { :x
	oʻzi boʻlish-songa: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 daraja: 8).  
a := a + (2 daraja: -1). 
a := a + (49 kvadrat-ildiz).   
a addNum: ((Roʻyxat ← 0 ; 1) eng-katta).          
a addNum: ((Roʻyxat ← 2 ; 3) eng-kichik).
Chiqish yozish: a.

Dastur tozalash.

usedMemory1 := (Dastur xotira ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 daraja: 8).  
a := a + (2 daraja: -1). 
a := a + (49 kvadrat-ildiz).   
a addNum: ((Roʻyxat ← 0 ; 1) eng-katta).          
a addNum: ((Roʻyxat ← 2 ; 3) eng-kichik).
Chiqish yozish: a.

Dastur tozalash.
usedMemory2 := (Dastur xotira ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 daraja: 8).  
a := a + (2 daraja: -1). 
a := a + (49 kvadrat-ildiz).   
a addNum: ((Roʻyxat ← 0 ; 1) eng-katta).          
a addNum: ((Roʻyxat ← 2 ; 3) eng-kichik).
Chiqish yozish: a.

Dastur tozalash.
usedMemory3 := (Dastur xotira ? 0).



( usedMemory1 = usedMemory2 va: usedMemory1 = usedMemory3, va: usedMemory2 = usedMemory3 ) rost-boʻlsa: {
	Chiqish yozish: ['No memory leaks here'].
}, yolgʻon-boʻlsa: {
	Chiqish yozish: ['Leaking memory...'].
}.
