



>> CoffeeGrounds := Obyekt yangi.
CoffeeGrounds kelganda: ['extract'] bajar: { <- ['coffee']. }.

>> CoffeeMachine := Obyekt yangi.
CoffeeMachine kelganda: ['init'] bajar: {
	oʻzining coffeegrounds := CoffeeGrounds yangi.
}.
CoffeeMachine kelganda: ['yangi'] bajar: { <- CoffeeMachine `new init.
}.

CoffeeMachine kelganda: ['makeTea'] bajar: { <- (oʻzining tealeaves extract). }.
CoffeeMachine kelganda: ['makeCoffee'] bajar: { <- (oʻzining coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine yangi.

Chiqish yozish:
	coffeeDream 
	makeCoffee.

Chiqish yozish:
	coffeeDream 
	makeTea.
