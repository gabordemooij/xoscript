# test catch-all methods
>> x13 := Obyekt yangi.
x13 kelganda: ['a'] bajar: { :a Chiqish yozish: 0, yangi-qator. }.
x13 kelganda: ['a:'] bajar: { :a Chiqish yozish: a, yangi-qator. <- 5. }.
x13 kelganda: ['a:b:'] bajar: { :a :b Chiqish yozish: (a + b), yangi-qator. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
