Chiqish yozish: ['Test object'], yangi-qator.
>> cmd := Buyruq yangi.
Chiqish yozish: cmd ls /tmp, yangi-qator.
>> old-cmd-address := cmd prototip xotira-manzili.
cmd save-as: ['/tmp/a.bin'].
Chiqish yozish: ['========== RELOADING SNAP:'], yangi-qator.
>> b := Obyekt load-from: ['/tmp/a.bin'].
(b prototip xotira-manzili = old-cmd-address) rost-boʻlsa: {
	Chiqish yozish: ['Object link re-attached.'], yangi-qator.
}.
Chiqish yozish: b ls, yangi-qator.


