Server init.

Chiqish yozish: (
	Andoza yangi: ['^\\w+$'],
	moslik: ['test@example.com'] 
), yangi-qator. # 0 match, fails on @ and .

Chiqish yozish: (
	Andoza yangi: ['^[^@]+@[^\.]+\.\\w+$'],
	moslik: ['test@example.com'] 
), yangi-qator. # 1 match

Chiqish yozish: (
	Andoza yangi: ['[^@]+@[^\.]+\.\\w+'],
	moslik: ['test@example.com'] 
), yangi-qator. # 1 match

Chiqish yozish: (
	Andoza yangi: ['([^@]+)@([^\.]+)\.\\w+'],
	moslik: ['test@example.com'] 
), yangi-qator. # 1 match, groups dont matter

Chiqish yozish: (
	Andoza yangi: ['[a-z]'],
	moslik: ['test@example.com'] 
), yangi-qator. # 14 matches

Chiqish yozish: (
	Andoza yangi: ['.*'],
	moslik: ['test@example.com'] 
), yangi-qator. # 1 match (all)

Chiqish yozish: (
	Andoza yangi: ['(.*)'],
	moslik: ['test@example.com'] 
), yangi-qator. # 1 match (all)

Chiqish yozish: (
	Andoza yangi: ['\\s*[^@]+@[^\.]+\.\\w+'],
	moslik: ['test@example.com'] 
), yangi-qator. # 1 match, prefix space optional, gets ignored