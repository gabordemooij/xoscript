


>> wine := Obyekt yangi.


wine kelganda: ['toString'] bajar: { <- ['merlot'].
}.

wine kelganda: ['naarTekst'] bajar: { <- ['merlot'].
}.


wine kelganda: ['='] bajar: { :other wine <- ( oʻzi toString = other wine ).
}.

wine kelganda: ['=='] bajar: { :other wine <- ( oʻzi toString = other wine ).
}.



wine
	holat: ['cabernet'] bajar: { Chiqish yozish: ['it's a Cabernet!']. },
	holat: ['syrah']    bajar: { Chiqish yozish: ['it's a Syrah!'].    },
	holat: ['merlot']   bajar: { Chiqish yozish: ['it's a Merlot!'].   },
	holat: ['malbec']   bajar: { Chiqish yozish: ['it's a Malbec!'].   }.

Chiqish yangi-qator.
