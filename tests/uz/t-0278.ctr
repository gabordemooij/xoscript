>> To-Do := Obyekt yangi.

To-Do kelganda: ['yangi'] bajar: {
	oʻzining list := Roʻyxat yangi.
}.

To-Do kelganda: ['nieuw'] bajar: {
	oʻzining list := Roʻyxat yangi.
}.

To-Do kelganda: ['+'] bajar: { :task
	oʻzining list oxiriga-qoʻshish: task.
}.

To-Do kelganda: ['number of tasks?'] bajar: { <-  oʻzining list soni.
}.

>> todos := 
	To-Do yangi 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Chiqish yozish: ['You have $ tasks to do'] $ todos number of tasks?.
