Server init.
Chiqish yozish: ['Database date test'], yangi-qator.

>> db := Maria-DB yangi xost: ['localhost'],
	foydalanuvchi-nomi: ['xo'], 
	parol: ['pass123'],
	baza-nomi: ['xobase'],
	ulanish.

>> qidiruv-parametrlari :=
db soʻrov: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
olish: { :row
	Chiqish yozish: row datetest, yangi-qator.
}.
