

>> kept1 := (Dastur xotira ? 3).
>> sticky1 := (Dastur xotira ? 2).
>> dust1 := (Dastur xotira ? 4).

>> kept2 := (Dastur xotira ? 3).
>> sticky2 := (Dastur xotira ? 2).
