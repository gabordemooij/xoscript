# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Seyf kalitlar-yaratish.

# private (secret) key
>> sk := keys birinchi.

# public key
>> pk := keys oxirgi.

# sign a message
>> sig := Seyf imzolash: ['abc'] kalit-bilan: sk.

# check message (ok)
Chiqish yozish: ( 
	Seyf
		tekshirish: ['abc'] 
		imzo: sig 
		kalit-bilan: pk 
), yangi-qator.

# check message (fail)
Chiqish yozish: ( 
	Seyf 
		tekshirish: ['abd'] 
		imzo: sig 
		kalit-bilan: pk 
), yangi-qator.