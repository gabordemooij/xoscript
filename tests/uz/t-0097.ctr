
Matn kelganda: ['html'] bajar: { <- (
		oʻzi
		almashtirish: ['&'] bunga: ['&amp;'],
		almashtirish: ['<'] bunga: ['&lt;'],
		almashtirish: ['>'] bunga: ['&gt;'],
		almashtirish: ['"'] bunga: ['&quot;']
	).
}.

>> HtmlBrush := Obyekt yangi.

HtmlBrush kelganda: ['javob:'] bajar: { :tag
	Chiqish yozish: (['<tag>↵'] tag: tag ).
}.

HtmlBrush kelganda: ['javob:va:'] bajar: { :tag :content
	tag := ( tag boshlab: 0 uzunlik: (tag uzunlik - 1) ).
	Chiqish yozish: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush kelganda: ['content:'] bajar: { :text
	Chiqish yozish: text html, yangi-qator.
}.

HtmlBrush kelganda: ['attr:value:'] bajar: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush yangi.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
