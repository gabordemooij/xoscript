
{ :i
	Chiqish yozish: ['This is step #'] + ( ( i ) + 1 ), yangi-qator.
} × 6.

{ :i
	Chiqish yozish: ['This is step #'] + ( 3 - ( i ) ), yangi-qator.
} × 6.

{ :i
	Chiqish yozish: ['NEVER!'], yangi-qator.
} × 0.



{ :i
	Chiqish yozish: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), yangi-qator.
} × 11.
