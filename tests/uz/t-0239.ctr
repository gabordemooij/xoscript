Roʻyxat kelganda: ['sum'] bajar: {
	>> total := 0.
	oʻzi har-bir: { :index :element
		total qoʻshish: element.
	}. <- total.
}.

>> a := Rost.



a kelganda: ['matn'] bajar: {
	>> answer := Hech.
	( oʻzi = Rost ) rost-boʻlsa: {
		answer := ['Yep'].
	}, aks-holda: {
		answer := ['Nope'].
	}. <- answer.
}.

a kelganda: ['son'] bajar: {
	>> answer := Hech.
	( oʻzi = Rost ) rost-boʻlsa: {
		answer := 10.
	}, aks-holda: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b kelganda: ['matn'] bajar: { <- ['Devil'].
}.

b kelganda: ['mantiqiy'] bajar: { <- Yolgʻon.
}.


Chiqish yozish: a, yangi-qator.  
Chiqish yozish: (90 + a), yangi-qator. 
Chiqish yozish: b, yangi-qator. 
Chiqish yozish: (Rost va: b), yangi-qator.

a := Roʻyxat ← ['hello'] ; ['world'] ; Rost ; Hech ; 666. 
a := a + ( Roʻyxat ← 1 ).
Chiqish yozish: a, yangi-qator.
Chiqish yozish: ((Lugʻat yangi) qoʻyish: Hech kalit: Hech), yangi-qator.
Chiqish yozish: a sum, yangi-qator. 


{
	a kelganda: ['matn'] bajar: { <- Hech. }.
	a := [''] + a.
} ushlash: { :error
	Chiqish yozish: ['Error noted: '] + error, yangi-qator.
}, ishga-tushirish.



{
	a kelganda: ['son'] bajar: { <- Hech. }.
	a := 3 × a.
} ushlash: { :error
	Chiqish yozish: ['Error noted: '] + error, yangi-qator.
}, ishga-tushirish.


{
	a kelganda: ['mantiqiy'] bajar: { <- Hech. }.
	a := Rost va: a. 
} ushlash: { :error
	Chiqish yozish: ['Error noted: '] + error, yangi-qator.
}, ishga-tushirish.





{
	a kelganda: ['matn'] bajar: { <- Yolgʻon. }.
	a := [''] + a.
} ushlash: { :error
	Chiqish yozish: ['Error noted: '] + error, yangi-qator.
}, ishga-tushirish.



{
	a kelganda: ['son'] bajar: { <- Rost. }.
	a := 3 × a.
} ushlash: { :error
	Chiqish yozish: ['Error noted: '] + error, yangi-qator.
}, ishga-tushirish.


{
	a kelganda: ['boolean'] bajar: { <- 1. }.
	a := Rost va: a.
} ushlash: { :error
	Chiqish yozish: ['Error noted: '] + error, yangi-qator.
}, ishga-tushirish.





{
	a kelganda: ['matn'] bajar: { <- 1. }.
	a := [''] + a.
} ushlash: { :error
	Chiqish yozish: ['Error noted: '] + error, yangi-qator.
}, ishga-tushirish.



{
	a kelganda: ['son'] bajar: { <- ['']. }.
	a := 3 × a.
} ushlash: { :error
	Chiqish yozish: ['Error noted: '] + error, yangi-qator.
}, ishga-tushirish.


{
	a kelganda: ['boolean'] bajar: { <- ['']. }.
	a := Rost va: a.
} ushlash: { :error
	Chiqish yozish: ['Error noted: '] + error, yangi-qator.
}, ishga-tushirish.






{
	a kelganda: ['matn'] bajar: { <- (Lugʻat yangi). }.
	a := [''] + a. 
} ushlash: { :error
	Chiqish yozish: ['Error noted: '] + error, yangi-qator.
}, ishga-tushirish.



{
	a kelganda: ['son'] bajar: { <- (Obyekt yangi). }.
	a := 3 × a. 
} ushlash: { :error
	Chiqish yozish: ['Error noted: '] + error, yangi-qator.
}, ishga-tushirish.


{
	a kelganda: ['boolean'] bajar: { <- (Obyekt yangi). }.
	a := Rost va: a.
} ushlash: { :error
	Chiqish yozish: ['Error noted: '] + error, yangi-qator.
}, ishga-tushirish.

