>> t := Rost.
(t = Rost) rost-boʻlsa: { Chiqish yozish: ['T']. }.
(t = Yolgʻon) rost-boʻlsa: { Chiqish yozish: ['F']. }.
Chiqish yozish: ['|'].
>> t := Yolgʻon.
(t = Rost) rost-boʻlsa: { Chiqish yozish: ['T']. }.
(t = Yolgʻon) rost-boʻlsa: { Chiqish yozish: ['F']. }.
Chiqish yozish: ['|'].
>> f := Rost.
(t = Rost va: f = Yolgʻon) rost-boʻlsa: { Chiqish yozish: ['T']. }.
(t = Yolgʻon va: f = Rost) rost-boʻlsa: { Chiqish yozish: ['F']. }.
Chiqish yozish: ['|'].
>> n := Hech.
(n Hech?) rost-boʻlsa: { Chiqish yozish: ['T']. }.
(n Hech?) yolgʻon-boʻlsa: { Chiqish yozish: ['F']. }.
Chiqish yozish: ['|'].
(f Boolean?) rost-boʻlsa: { Chiqish yozish: ['T']. }.
(f Boolean?) yolgʻon-boʻlsa: { Chiqish yozish: ['F']. }.



