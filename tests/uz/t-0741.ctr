Chiqish yozish: ['Test object'], yangi-qator.
>> a := Obyekt yangi. 

a kelganda: ['item:'] bajar: { :octhelper
	oʻzining octhelper := octhelper. 
}.

a kelganda: ['item'] bajar: { <- oʻzining octhelper.
}.

a item: Oct yangi.

>> old-octhelper-address := a item prototip xotira-manzili.
a save-as: ['/tmp/a.bin'].
Chiqish yozish: ['========== RELOADING SNAP:'], yangi-qator.

>> b := Obyekt load-from: ['/tmp/a.bin'].

(b item prototip xotira-manzili = old-octhelper-address) rost-boʻlsa: {
	Chiqish yozish: ['Object link re-attached.'], yangi-qator.
}.
