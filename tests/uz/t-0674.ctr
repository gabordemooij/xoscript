# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> yoʻl := ['/tmp/dat.csv'].
>> csv := Fayl yangi: yoʻl.
csv yozish: s.

# accepts CRLF LF CR, varying row length
csv ajratuvchi: [';'] qoʻshtirnoq: ['"'] qatorlar: { :line
	Dastur tozalash.
	Chiqish yozish: line, yangi-qator.
	Dastur tozalash.
}.

# unequal lines
s oxiriga-qoʻshish: ['\njustone'].
csv yozish: s.
{
	csv ajratuvchi: [';'] qoʻshtirnoq: ['"'] qatorlar: { :line
		Chiqish yozish: line, yangi-qator.
	}.
} ushlash: { :e 
	Chiqish yozish: e, yangi-qator.
}, ishga-tushirish.

# invalid format
s := ['"he"llo";world'].
csv yozish: s.
{
	csv ajratuvchi: [';'] qoʻshtirnoq: ['"'] qatorlar: { :line
		Chiqish yozish: line, yangi-qator.
	}.
} ushlash: { :e 
	Chiqish yozish: e, yangi-qator.
}, ishga-tushirish.
