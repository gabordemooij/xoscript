Chiqish yozish: ['Test object'], yangi-qator.
>> a := Obyekt yangi. 
a kelganda: ['item:'] bajar: { :lst
	oʻzining lst := lst. 
}.
a kelganda: ['item'] bajar: { <- oʻzining lst.
}.
a item: (
	Roʻyxat yangi ; 1 ; (
		Roʻyxat yangi ; ['a'] ; (
			Roʻyxat yangi ; ( Lahza yangi: 1 )
		) ; ( Int64 matndan: ['321'] )
	)
).
Chiqish yozish: a item, yangi-qator.
>> old-lst-address := a item prototip xotira-manzili.
a save-as: ['/tmp/a.bin'].
Chiqish yozish: ['========== RELOADING SNAP:'], yangi-qator.
>> b := Obyekt load-from: ['/tmp/a.bin'].
(b item prototip xotira-manzili = old-lst-address) rost-boʻlsa: {
	Chiqish yozish: ['Object link re-attached.'], yangi-qator.
}.
Chiqish yozish: ( b item ), yangi-qator.
