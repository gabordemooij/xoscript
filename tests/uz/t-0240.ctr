# test qualifiers

>> $ := Obyekt yangi.

$ kelganda: ['javob:'] bajar: { :x
	
	>> operation := x belgi: 0.
	>> valuta := x belgi: 1.
	>> money := x surish: 2.
	
	>> amount := 0.

	( operation = ['+'] ) rost-boʻlsa: {
		( valuta = ['£'] ) rost-boʻlsa: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Chiqish yozish: x, yangi-qator.


>> Fruit := Obyekt yangi.

Fruit kelganda: ['yangi'] bajar: {
	>> f := oʻzi yangi.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit kelganda: ['apples:'] bajar: { :a oʻzining apples := a. }.
Fruit kelganda: ['oranges:'] bajar: { :p oʻzining oranges := p. }.
Fruit kelganda: ['apples'] bajar: { <- oʻzining apples. }.
Fruit kelganda: ['oranges'] bajar: { <- oʻzining oranges. }.

Fruit kelganda: ['+'] bajar: { :f
	
	>> n := Fruit yangi.
	f qoʻshish: 1.
	
	n apples: (f apples + oʻzining apples).
	n oranges:  (f oranges  + oʻzining oranges). <- n.
}.

Fruit kelganda: ['matn'] bajar: { <- ( oʻzining apples matn + [' apples and '] + oʻzining oranges + [' oranges'] ).
}.

Son kelganda: ['apples'] bajar: { <- ((Fruit yangi) apples: oʻzi).
}.

Son kelganda: ['apple'] bajar: { <- ((Fruit yangi) apples: oʻzi).
}.

Son kelganda: ['oranges'] bajar: { <- ((Fruit yangi) oranges: oʻzi).
}.




Chiqish yozish: (1 apple + 3 oranges + 4 apples), yangi-qator.


Matn kelganda: ['twice'] bajar: { <- ((oʻzi matn) + (oʻzi matn)).
}.



Chiqish yozish: ['❤❤❤'] twice.



