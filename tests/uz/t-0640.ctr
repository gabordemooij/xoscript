
Server init.
Chiqish yozish: ['Database test'], yangi-qator.

>> db := Maria-DB yangi xost: ['localhost'],
	foydalanuvchi-nomi: ['xo'], 
	parol: ['pass123'],
	baza-nomi: ['xobase'],
	ulanish.

>> qidiruv-parametrlari :=
db soʻrov: ['SELECT UNHEX('CAFE') AS blobby'],
olish: { :row
	Chiqish yozish: ( row blobby boshlab: 0 uzunlik: 2 ), yangi-qator.
	row blobby boʻshatish.
}.
