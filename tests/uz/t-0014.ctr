>> Greeter := Obyekt yangi.
Greeter kelganda: ['make'] bajar: {
	>> gr := Obyekt yangi.
	gr kelganda: ['setName:'] bajar: { :aname
		oʻzining nom := aname.
	}.
	gr kelganda: ['greet'] bajar: {
		Chiqish yozish: oʻzining nom.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a yangi.
c setName: ['THREE'].
c greet.
>> d := a yangi.
d setName: ['FOUR'].
d greet.
c greet.
