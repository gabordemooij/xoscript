>> map1 := Lugʻat yangi.
>> key1 := Roʻyxat yangi.
>> key2 := Roʻyxat yangi.

map1
	qoʻyish: ['hello'] kalit: key1,
	qoʻyish: ['world'] kalit: key2.


Chiqish
	yozish: ['Map #1 contains: '] + (map1 oʻrnida: key1),
	yozish: [' and '] + (map1 oʻrnida: key2), yangi-qator.

>> KeyeableArray := Roʻyxat yangi.
KeyeableArray kelganda: ['toString'] bajar: { <- (oʻzi soni) toString.
}.

>> map2 := Lugʻat yangi.
key1 := KeyeableArray yangi.
key2 := KeyeableArray yangi.

key1 oxiriga-qoʻshish: 1.

map2
	qoʻyish: ['hello'] kalit: key1,
	qoʻyish: ['world'] kalit: key2.

Chiqish
	yozish: ['Map #2 contains: '] + (map2 oʻrnida: key1),
	yozish: [' and '] + (map2 oʻrnida: key2), yangi-qator.
