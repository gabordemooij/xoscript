

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Dastur xotira-boshqaruvi: 0.

>> a := -2 mutlaq-qiymat.
a := a atan.
a := a cos.
a := a log.
a := a sin.
a := a tan.


Dastur tozalash.

usedMemory1 := (Dastur xotira ? 0).


a := -2 mutlaq-qiymat.
a := a atan.
a := a cos.
a := a log.
a := a sin.
a := a tan.


Dastur tozalash.
usedMemory2 := (Dastur xotira ? 0).


a := -2 mutlaq-qiymat.
a := a atan.
a := a cos.
a := a log.
a := a sin.
a := a tan.


Dastur tozalash.
usedMemory3 := (Dastur xotira ? 0).



( usedMemory1 = usedMemory2 va: usedMemory1 = usedMemory3, va: usedMemory2 = usedMemory3 ) rost-boʻlsa: {
	Chiqish yozish: ['No memory leaks here'].
}, yolgʻon-boʻlsa: {
	Chiqish yozish: ['Leaking memory...'].
}.
