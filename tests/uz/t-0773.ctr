Chiqish yozish: ['Test object'], yangi-qator.
>> a := Obyekt yangi. 
a kelganda: ['item:'] bajar: { :int64
	oʻzining int64 := int64. 
}.
a kelganda: ['item'] bajar: { <- oʻzining int64.
}.
a item: ( Int64 matndan: ['9999'] ).
Chiqish yozish: a item, yangi-qator.
>> old-int64-address := a item prototip xotira-manzili.
a save-as: ['/tmp/a.bin'].
Chiqish yozish: ['========== RELOADING SNAP:'], yangi-qator.
>> b := Obyekt load-from: ['/tmp/a.bin'].
(b item prototip xotira-manzili = old-int64-address) rost-boʻlsa: {
	Chiqish yozish: ['Object link re-attached.'], yangi-qator.
}.
Chiqish yozish: ( b item ), yangi-qator.
