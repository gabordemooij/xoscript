
Chiqish yozish: ['Break for-loop, 0-4.'], yangi-qator.
{ :i
	Chiqish yozish: ['iteration #'] + i, yangi-qator.
	(i = 4) uzish.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Chiqish yozish: ['Break while-true loop, 0-4.'], yangi-qator.
{
	Chiqish yozish: ['iteration #'] + x, yangi-qator.
	x qoʻshish: 1.
	((x < 5) teskari) uzish.
} hozircha: xIsLessThan10.

Chiqish yozish: ['Break while-false loop, 5,4.'], yangi-qator.
{
	Chiqish yozish: ['iteration #'] + x, yangi-qator.
	x ayirish: 1.
	(x = 3) uzish.
} hozircha: { <- (x > 0). }.

Chiqish yozish: ['Break times loop, 1-4.'], yangi-qator.
{ :i
	Chiqish yozish: ['iteration #'] + i, yangi-qator.
	(i = 4) uzish.
} × 5.

Chiqish yozish: ['Break block, dont print line.'], yangi-qator.
{ Rost uzish. Chiqish yozish: ['dont write this!'], yangi-qator. } ishga-tushirish.

Chiqish yozish: ['Break block, dont fire catch...'], yangi-qator.
{ Rost uzish. Chiqish yozish: ['dont write this!'], yangi-qator. } ushlash: { Chiqish yozish: ['Dont catch this!']. }, ishga-tushirish.

Chiqish yozish: ['Test Array each-loop: 0,1'], yangi-qator.
(Roʻyxat ← 1 ; 2 ; 3) oʻzgartirish: { :i
	Chiqish yozish: ['iteration #'] + i, yangi-qator.
	(i = 1) uzish.
}.

Chiqish yozish: ['Test Map each-loop: c only'], yangi-qator.
>> m := Lugʻat yangi.
m qoʻyish: ['first'] kalit: ['a'], qoʻyish: ['second'] kalit: ['b'], qoʻyish: ['third'] kalit: ['c'].
m har-bir: { :k :v
	Chiqish yozish: ['iteration'] + v + k, yangi-qator.
	Rost uzish.
}.

