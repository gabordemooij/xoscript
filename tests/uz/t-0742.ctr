Chiqish yozish: ['Test object'], yangi-qator.
>> a := Obyekt yangi. 

a kelganda: ['item:'] bajar: { :hexhelper
	oʻzining hexhelper := hexhelper. 
}.

a kelganda: ['item'] bajar: { <- oʻzining hexhelper.
}.

a item: Hx yangi.

>> old-hexhelper-address := a item prototip xotira-manzili.
a save-as: ['/tmp/a.bin'].
Chiqish yozish: ['========== RELOADING SNAP:'], yangi-qator.

>> b := Obyekt load-from: ['/tmp/a.bin'].

(b item prototip xotira-manzili = old-hexhelper-address) rost-boʻlsa: {
	Chiqish yozish: ['Object link re-attached.'], yangi-qator.
}.
