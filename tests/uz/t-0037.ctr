>> a := 3.
>> b := a nusxa.
a ayirish: 1.
Chiqish yozish: [' a = '] + a.
Chiqish yozish: [' b = '] + b.
a := 3.
b := a + 4.
Chiqish yozish: [' a = '] + a.
Chiqish yozish: [' b = '] + b.
>> x := 3.
>> y := x nusxa.
x qoʻshish: 10.
y ayirish: 1.
Chiqish yozish: [' x = '] + x.
Chiqish yozish: [' y = '] + y.
>> q := Obyekt yangi.
q kelganda: ['setProperty:'] bajar: { :x
	oʻzining prop := x.
}.
q kelganda: ['getProperty'] bajar: { <- oʻzining prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Chiqish yozish: [' p = '] + (p getProperty).
