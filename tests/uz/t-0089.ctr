>> randomizer := { :a :b
	>> eng-kichik := ( a < b ) bu: a yoki-u: b.
	>> eng-katta := ( a > b ) bu: a yoki-u: b.
	>> x := Hech.
	{
		x := Son orasida: a bilan: b.
		((x < eng-kichik) yoki: (x > eng-katta)) rost-boʻlsa: { 
			Chiqish yozish: (['Invalid value!']).
			Dastur tugatish.
		}.
	} 
	× 100. <- x.
}.
randomizer qoʻllash: 0 va: 0.
randomizer qoʻllash: 1 va: 0.
randomizer qoʻllash: 1 va: 1.
randomizer qoʻllash: 0 va: 1.
randomizer qoʻllash: -1 va: 0.
randomizer qoʻllash: -1 va: -1.
randomizer qoʻllash: 0 va: -1.
randomizer qoʻllash: 100 va: 200.
randomizer qoʻllash: 999999999999998 va: 999999999999999.
