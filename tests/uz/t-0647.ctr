Server init.
Chiqish yozish: ['Database time test'], yangi-qator.

>> db := Maria-DB yangi xost: ['localhost'],
	foydalanuvchi-nomi: ['xo'], 
	parol: ['pass123'],
	baza-nomi: ['xobase'],
	ulanish.

>> qidiruv-parametrlari :=
db soʻrov: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
olish: { :row
	Chiqish yozish: row timetest, yangi-qator.
}.
