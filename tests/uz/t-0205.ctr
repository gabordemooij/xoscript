>> str := ['write:'].
Chiqish xabar: ['yozish:'] argumentlar: (Roʻyxat ← ['Hello World']), yangi-qator. 

Son kelganda: ['isbetween:and:'] bajar: { :a :b <- ((oʻzi ≥ a) va: (oʻzi ≤ b)).
}.

str := ['isbetween:and:'].
Chiqish yozish: (3 xabar: str argumentlar: (Roʻyxat ← 2 ; 8)), yangi-qator.
Chiqish yozish: (3 xabar: str argumentlar: (Roʻyxat ← 1 ; 2)), yangi-qator.


>> CoffeeMachine := Obyekt yangi.
CoffeeMachine kelganda: ['makeCoffeeWithSugar:milk:'] bajar: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Roʻyxat ← 4 ; 2.
Chiqish yozish: ( CoffeeMachine xabar: order argumentlar: coffeeConfiguration ), yangi-qator.
