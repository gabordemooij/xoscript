Server init.

>> DB := Maria-DB yangi xost: ['localhost'],
	foydalanuvchi-nomi: ['xo'],
	parol: ['pass123'],
	baza-nomi: ['xobase'],
	ulanish.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB soʻrov: SQL.

# now you don't have to set DB
query2 olish: { :row
	Chiqish yozish: row world, yangi-qator.
}.
