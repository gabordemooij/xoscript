# test Program version

# this feature is disabled by default
Chiqish yozish: (
	Dastur imkoniyat: 
	['RECURSIVE_STRINTPOL']
), yangi-qator.


# but if we set the time back
>> today := Lahza 
vaqt-mintaqasi: ['CEST'],
manba: ['2026-02-15 10:00:00'].
Dastur versiya: today.

# it will be enabled like it used to be (from now on)
Chiqish yozish: (
	Dastur imkoniyat: 
	['RECURSIVE_STRINTPOL']
), yangi-qator.