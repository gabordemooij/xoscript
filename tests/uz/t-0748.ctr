Chiqish yozish: ['Test object'], yangi-qator.
>> a := Obyekt yangi. 

a kelganda: ['item:'] bajar: { :mantiqiy
	oʻzining mantiqiy := mantiqiy. 
}.

a kelganda: ['item'] bajar: { <- oʻzining mantiqiy.
}.

a item: Rost.

Chiqish yozish: a item, yangi-qator.

>> old-bool-address := a item prototip xotira-manzili.
a save-as: ['/tmp/a.bin'].
Chiqish yozish: ['========== RELOADING SNAP:'], yangi-qator.

>> b := Obyekt load-from: ['/tmp/a.bin'].

(b item prototip xotira-manzili = old-bool-address) rost-boʻlsa: {
	Chiqish yozish: ['Object link re-attached.'], yangi-qator.
}.

Chiqish yozish: b item, yangi-qator.
