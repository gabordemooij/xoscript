>> items := Lugʻat yangi.
items qoʻyish: ['black'] kalit: ['coffee'], qoʻyish: ['earl grey'] kalit: ['tea'].
Chiqish yozish: (items oʻrnida: ['coffee']), yozish: (items oʻrnida: ['tea']).
Chiqish yozish: ['there are'] + items soni + [' items in the array.'].
items qoʻyish: ['capuccino'] kalit: ['coffee'].
Chiqish yozish: ['Now my coffee is.. '] + (items oʻrnida: ['coffee']).
items qoʻyish: ['aaa'] kalit: ['1'].
items qoʻyish: ['bbb'] kalit: ['2'].
Chiqish yozish: (items oʻrnida: ['a']).
