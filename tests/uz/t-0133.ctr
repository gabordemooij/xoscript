


>> Deck := Roʻyxat yangi.
Deck kelganda: ['print'] bajar: {
        >> len := oʻzi soni - 1.
        { :i
                >> len2 := oʻzi soni - 1.
                Chiqish yozish: ['len: '].
                Chiqish yozish: len, yangi-qator.
                Chiqish yozish: ['len2: '].
                Chiqish yozish: len2, yangi-qator.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
