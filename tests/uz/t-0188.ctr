

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Dastur xotira-boshqaruvi: 0.

{ :i Chiqish yozish: i. } × 4.
Chiqish yangi-qator.
{ :i Chiqish yozish: (4 - i). } × 4.
Chiqish yangi-qator.
( 1 > 2 ) yolgʻon-boʻlsa: { Chiqish yozish: ['BLOCK 1'], yangi-qator. }.
( 2 > 1 ) rost-boʻlsa:  { Chiqish yozish: ['BLOCK 2'], yangi-qator. }.

>> i := 0.
{ Chiqish yozish: i. i qoʻshish: 1. } hozircha: { <- ( i < 3). }.
Chiqish yangi-qator.

i := 3.
{ Chiqish yozish: i. i := i - 1. } hozircha: { <- ( i > 0). }.
Chiqish yangi-qator.


Dastur tozalash.

usedMemory1 := (Dastur xotira ? 0).


{ :i  Chiqish yozish: i. } × 4.
Chiqish yangi-qator.
{ :i  Chiqish yozish: (4 - i). } × 4.
Chiqish yangi-qator.
( 1 > 2 ) yolgʻon-boʻlsa: { Chiqish yozish: ['BLOCK 1'], yangi-qator. }.
( 2 > 1 ) rost-boʻlsa:  { Chiqish yozish: ['BLOCK 2'], yangi-qator. }.

>> i := 0.
{ Chiqish yozish: i. i qoʻshish: 1. } hozircha: { <- ( i < 3). }.
Chiqish yangi-qator.

i := 3.
{ Chiqish yozish: i. i := i - 1. } hozircha: { <- ( i > 0). }.
Chiqish yangi-qator.



Dastur tozalash.
usedMemory2 := (Dastur xotira ? 0).


{ :i Chiqish yozish: i. } × 4.
Chiqish yangi-qator.
{ :i Chiqish yozish: (4 - i). } × 4.
Chiqish yangi-qator.
( 1 > 2 ) yolgʻon-boʻlsa: { Chiqish yozish: ['BLOCK 1'], yangi-qator. }.
( 2 > 1 ) rost-boʻlsa:  { Chiqish yozish: ['BLOCK 2'], yangi-qator. }.

>> i := 0.
{ Chiqish yozish: i. i qoʻshish: 1. } hozircha: { <- ( i < 3). }.
Chiqish yangi-qator.

i := 3.
{ Chiqish yozish: i. i := i - 1. } hozircha: { <- ( i > 0). }.
Chiqish yangi-qator.

Dastur tozalash.
usedMemory3 := (Dastur xotira ? 0).



( usedMemory1 = usedMemory2 va: usedMemory1 = usedMemory3, va: usedMemory2 = usedMemory3 ) rost-boʻlsa: {
	Chiqish yozish: ['No memory leaks here'].
}, yolgʻon-boʻlsa: {
	Chiqish yozish: ['Leaking memory...'].
}.
