


>> CoffeeMachine := Obyekt yangi.
CoffeeMachine kelganda: ['order:'] bajar: { :id
	>> coffee := ['Americano'].
	( id = 1 ) rost-boʻlsa: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) rost-boʻlsa: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) rost-boʻlsa: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Obyekt yangi.
SimpleCoffeeMachine kelganda: ['order'] bajar: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Chiqish yozish: redCup, yangi-qator.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Chiqish yozish: greenCup, yangi-qator.
>> yellowCup := CoffeeMachine order: 1.
Chiqish yozish: yellowCup, yangi-qator.
>> blueCup := CoffeeMachine order: 0.
Chiqish yozish: blueCup, yangi-qator.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Chiqish yozish: blackCup, yangi-qator.
blackCup oxiriga-qoʻshish: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Chiqish yozish: orangeCup, yangi-qator.
