

>> obj := Obyekt yangi.

obj kelganda: ['greet'] bajar: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj kelganda: ['task'] bajar: {
	oʻzining property := 123.
	{
		# try binds self/own to object instead of block
		Chiqish yozish: oʻzi greet.
		Chiqish yozish: oʻzining property.
		1 / 0.
	} ushlash: {
		Chiqish yozish: oʻzi greet.
		Chiqish yozish: oʻzining property.
		Chiqish yozish: ['ok'].
	}, urinish.
}.

obj task.