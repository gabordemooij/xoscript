
>> city := Roʻyxat ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Roʻyxat ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature boʻyicha: city.
>> cities := weather kalitlar saralash: { :a :b <- (a taqqoslash: b). }.
>> temperatures := weather qiymatlar saralash: { :a :b <- (a taqqoslash: b) manfiy?. }.

Chiqish yozish: (cities birlashtirish: [',']), yangi-qator.
Chiqish yozish: (temperatures birlashtirish: [',']), yangi-qator.
