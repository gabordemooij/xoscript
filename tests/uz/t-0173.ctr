

Roʻyxat kelganda: ['sum'] bajar: {
	>> total := 0.
	oʻzi har-bir: { :index :element
		total qoʻshish: element.
	}. <- total.
}.

Roʻyxat kelganda: ['product'] bajar: {
	>> total := 1.
	oʻzi har-bir: { :index :element
		total koʻpaytirish: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Dastur xotira-boshqaruvi: 0.

{

>> a := Roʻyxat ← ['hello'] ; ['world'] ; Rost ; Hech ; 666.
a := a + ( Roʻyxat ← 1 ).
Chiqish yozish: ( ['sum: '] + ( a sum ) ), yangi-qator.
Chiqish yozish: ( ['min: '] + ( a eng-kichik ) ), yangi-qator.
Chiqish yozish: ( ['max: '] + ( a eng-katta ) ), yangi-qator.
Chiqish yozish: ( ['3rd: '] + ( a ? 2 ) ), yangi-qator.
Chiqish yozish: ( ['prd: '] + ( a product ) ), yangi-qator.
a saralash: { :a :b <- (b - a). }.
a har-bir: { :i :e Chiqish yozish: ( i - 0 ), yangi-qator. }.

} ishga-tushirish.

Dastur tozalash.
usedMemory1 := (Dastur xotira ? 0).


{

>> a := Roʻyxat ← ['hello'] ; ['world'] ; Rost ; Hech ; 666.
a := a + ( Roʻyxat ← 1 ).
Chiqish yozish: ( ['sum: '] + ( a sum ) ), yangi-qator.
Chiqish yozish: ( ['min: '] + ( a eng-kichik ) ), yangi-qator.
Chiqish yozish: ( ['max: '] + ( a eng-katta ) ), yangi-qator.
Chiqish yozish: ( ['3rd: '] + ( a ? 2 ) ), yangi-qator.
Chiqish yozish: ( ['prd: '] + ( a product ) ), yangi-qator.
a saralash: { :a :b <- (b - a). }.
a har-bir: { :i :e Chiqish yozish: ( i - 0 ), yangi-qator. }.

} ishga-tushirish.



Dastur tozalash.
usedMemory2 := (Dastur xotira ? 0).


{

>> a := Roʻyxat ← ['hello'] ; ['world'] ; Rost ; Hech ; 666.
a := a + ( Roʻyxat ← 1 ).
Chiqish yozish: ( ['sum: '] + ( a sum ) ), yangi-qator.
Chiqish yozish: ( ['min: '] + ( a eng-kichik ) ), yangi-qator.
Chiqish yozish: ( ['max: '] + ( a eng-katta ) ), yangi-qator.
Chiqish yozish: ( ['3rd: '] + ( a ? 2 ) ), yangi-qator.
Chiqish yozish: ( ['prd: '] + ( a product ) ), yangi-qator.
a saralash: { :a :b <- (b - a). }.
a har-bir: { :i :e Chiqish yozish: ( i - 0 ), yangi-qator. }.

} ishga-tushirish.



Dastur tozalash.
usedMemory3 := (Dastur xotira ? 0).

( usedMemory1 = usedMemory2 va: usedMemory1 = usedMemory3, va: usedMemory2 = usedMemory3 ) rost-boʻlsa: {
	Chiqish yozish: ['No memory leaks here'].
}, yolgʻon-boʻlsa: {
	Chiqish yozish: ['Leaking memory...'].
}.
