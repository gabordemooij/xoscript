# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Seyf 
	parol-xeshi: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Seyf 
	parol-xeshi: hash tekshirish: a1.
	# fail 
>> b := Seyf
	parol-xeshi: hash tekshirish: a2.
	# ok!

Chiqish yozish: a, yangi-qator.
Chiqish yozish: b, yangi-qator.

