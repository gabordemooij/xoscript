

>> Matryoshka := Obyekt yangi.
Matryoshka kelganda: ['double:'] bajar: { :secret
	oʻzining secret := secret × 2.
}.
Matryoshka kelganda: ['yangi:'] bajar: { :secret
	>> answer := Hech.
	>> t := (secret > 255).
	Chiqish yozish: (secret + [' | '] + t), yangi-qator.
	t rost-boʻlsa: {
		answer := secret.
	}, aks-holda: {
		answer := Matryoshka rekursiv yangi: (oʻzi double: secret).
	}. <- answer.
}.

>> x := Matryoshka yangi: 2.
