>> Animal := Obyekt yangi.
Animal kelganda: ['make'] bajar: {
	>> animal := Obyekt yangi.
	animal kelganda: ['makeSound'] bajar: {
		Chiqish yozish: oʻzining sound.
	}. <- animal.
}.
>> Cat := Obyekt yangi.
Cat kelganda: ['make'] bajar: {
	>> cat := Animal make.
	cat kelganda: ['init'] bajar: {
		oʻzining sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
