# test url parsing

Server init.
>> url := URL manba: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Chiqish yozish: ['scheme = '] + url sxema, yangi-qator.
Chiqish yozish: ['host = '] + url xost, yangi-qator.
Chiqish yozish: ['port = '] + url port, yangi-qator.
Chiqish yozish: ['path = '] + url yoʻl, yangi-qator.
Chiqish yozish: ['query = '] + url qidiruv-parametrlari, yangi-qator.
Chiqish yozish: ['fragment = '] + url fragment, yangi-qator.
