

Matn kelganda: ['evaluate'] bajar: {
	>> kod := Fayl yangi: ['/tmp/eval.ctr'].
	kod yozish: (oʻzi matn + ['.']).
	Dastur foydalanish: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Roʻyxat ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q matn.
Chiqish yozish: x, yangi-qator.
>> y := Hech.
(['y := '] + x ) evaluate.
Chiqish yozish: y ? 0, yangi-qator.

q := Lugʻat qoʻyish: ['\[''] kalit: ['\['quote\']'].
x := q matn.
Chiqish yozish: x, yangi-qator.
y := Hech.
(['y := '] + x ) evaluate.

>> q := (Lugʻat yangi) qoʻyish:['\[''] kalit:['\['quote\[''].
Chiqish yozish: y ? ['\['quote\']'], yangi-qator.
