Chiqish yozish: ['Continue for-loop, No - before 6 and up.'], yangi-qator.
{ :i
	Chiqish yozish: (i + 1), yangi-qator.
	((i + 1) > 4) davom.
	Chiqish yozish: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Chiqish yangi-qator.
Chiqish yozish: ['Continue while-true, No --> before 5 and up.'], yangi-qator.
{
	Chiqish yozish: ['iteration #'] + x, yangi-qator.
	x qoʻshish: 1.
	((x < 5) teskari) davom.
	Chiqish yozish: ['-->'].
} hozircha: xIsLessThan10.
Chiqish yangi-qator.
Chiqish yozish: ['Continue while-false, No - before 3 only.'], yangi-qator.
{
	Chiqish yozish: ['iteration #'] + x, yangi-qator.
	x ayirish: 1.
	(x = 3) davom.
	Chiqish yozish: ['-'].
} hozircha: { <- ( x > 0). }.

Chiqish yangi-qator.
Chiqish yozish: ['Continue times-loop, No ||| before 3.'], yangi-qator.
{ :i
	Chiqish yozish: ['iteration #'] + i, yangi-qator.
	(i = 2) davom.
	Chiqish yozish: ['|||'].
} × 5.

Chiqish yangi-qator.

{ Rost davom. Chiqish yozish: ['dont write this!'], yangi-qator. } ishga-tushirish.

{ Rost davom. Chiqish yozish: ['dont write this!'], yangi-qator. } ushlash: { Chiqish yozish: ['Dont catch this!']. }, ishga-tushirish.

Chiqish yozish: ['Test Array each-loop: 0, ... ,2'], yangi-qator.
(Roʻyxat ← 1 ; 2 ; 3) oʻzgartirish: { :i
	(i = 1) davom.
	Chiqish yozish: ['iteration #'] + (i - 0), yangi-qator.
}.

Chiqish yozish: ['Test Map each-loop: c only'], yangi-qator.
>> m := Lugʻat yangi.
m qoʻyish: ['first'] kalit: ['a'], qoʻyish: ['second'] kalit: ['b'], qoʻyish: ['third'] kalit: ['c'].
m har-bir: { :k :v
	(k ≠ ['c']) davom.
	Chiqish yozish: ['iteration'] + k + v, yangi-qator.
}.

