Dastur xotira-boshqaruvi: 4.

>> Doubler := Obyekt yangi.
>> Multiplier := Obyekt yangi.
Doubler kelganda: ['double:and:'] bajar: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier kelganda: ['multiply:and:'] bajar: { :x :y <- (x × y).
}.

Chiqish yozish: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), yangi-qator.
