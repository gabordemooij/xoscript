Utdata skriv: ((Lista ny
	vid: ['plaque:'] gör: { :x egen o := x. },
	vid: ['plaque']  gör: { <- egen o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Lista ← 1)
	~ (Lista ← 1 ; 2)
	~ (Lista ← 1 ; 2 ; 3)
	~ (Lista ← 1 ; 2 ; 3 ; 4)
	~ (Lista ← 1 ; 2 ; 3 ; 4 ; 5)
) varje: { :i :el
	{ Utdata skriv: denna-uppgift. } × el antal.
	Utdata stop.
}) plaque, stop.


