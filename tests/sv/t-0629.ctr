# databastest
# se exemplet server.xo för nödvändig konfiguration

Server init.
Utdata skriv: ['Databastest'], stop.

>> db := Maria-DB ny värd: ['localhost'],
	användarnamn: ['xo'], lösenord: ['pass123'], databasnamn: ['xobase'], anslut.

Utdata skriv: ['Kan vi ansluta? '] + db ansluten?, stop.

>> sökparametrar := db fråga: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parametrar: ( Lista ny ; ['abc'] ; 12.35 ; 6 ). # parametriserade frågor

{  sökparametrar utför. db bekräfta. } fånga: { :e db återställ.  }, starta.

Utdata skriv: ['Kan vi infoga? '] + ( sökparametrar insert-id > 0 ), stop.

>> Obj := Objekt ny.
Obj vid: ['hämta-rader'] gör: {
	egen antal := 0.
	>> sökparametrar :=
	db fråga: ['SELECT * FROM book order by id desc limit 2'], 
	hämta: { :raden 
		egen antal lägg-till: 1.
		Sann avbryt.
	}. # hämtning av rader
	<- egen antal kopiera.
}.

Utdata skriv: ['Kan vi ställa frågor? '] + ( Obj hämta-rader > 0 ), stop.
