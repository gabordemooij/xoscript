>> q := Lista ← 1 ; 2 ; 3.
{ q ? ['1']. } fånga: { Utdata skriv: ['caught!'], stop. }, starta.
{ q ? Sann. } fånga: { Utdata skriv: ['caught!'], stop. }, starta.
{ q ? Falsk. } fånga: { Utdata skriv: ['caught!'], stop. }, starta.
{ q ? Inget. } fånga: { Utdata skriv: ['caught!'], stop. }, starta.
{ q ? (Lista ny). } fånga: { Utdata skriv: ['caught!'], stop. }, starta.
{ q ? (Objekt ny). } fånga: { Utdata skriv: ['caught!'], stop. }, starta.
{ q ? ({ ['Empty']. }). } fånga: { Utdata skriv: ['caught!'], stop. }, starta.
Utdata skriv: ['caught them all'], stop.
