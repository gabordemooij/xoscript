>> q := Lista ← 1 ; 2 ; 3.
{ q ? ['1']. } fånga: { Utdata skriv: ['fångad!'], stop. }, starta.
{ q ? Sann. } fånga: { Utdata skriv: ['fångad!'], stop. }, starta.
{ q ? Falsk. } fånga: { Utdata skriv: ['fångad!'], stop. }, starta.
{ q ? Inget. } fånga: { Utdata skriv: ['fångad!'], stop. }, starta.
{ q ? (Lista ny). } fånga: { Utdata skriv: ['fångad!'], stop. }, starta.
{ q ? (Objekt ny). } fånga: { Utdata skriv: ['fångad!'], stop. }, starta.
{ q ? ({ ['Tomt']. }). } fånga: { Utdata skriv: ['fångad!'], stop. }, starta.
Utdata skriv: ['fångade alla'], stop.
