>> w := ['A_bottle_of_Whisky and a rare steak.'].
Utdata skriv: ['=== Basic test, grab the bottle! ==='], stop.
Utdata skriv: ['>']+(w kopiera från:2 längd: 6), stop.
Utdata skriv: ['>']+(w kopiera från:8 längd: -6), stop.
Utdata skriv: ['>']+(w kopiera från:2 längd: 6), stop.
Utdata skriv: ['>']+(w kopiera från:8 längd: -6), stop.
Utdata skriv: ['=== Take a single char ==='], stop.
Utdata skriv: ['>']+(w kopiera från:7 längd: 1), stop.
Utdata skriv: ['>']+(w kopiera från:7 längd: 1), stop.
Utdata skriv: ['=== The 0 case, empty string ==='], stop.
Utdata skriv: ['>']+(w kopiera från:7 längd: 0), stop.
Utdata skriv: ['>']+(w kopiera från:7 längd: 0), stop.
Utdata skriv: ['=== Edge case, first character only ==='], stop.
Utdata skriv: ['>']+(w kopiera från:0 längd: 1), stop.
Utdata skriv: ['>']+(w kopiera från:0 längd: 1), stop.
Utdata skriv: ['>']+(w kopiera från:1 längd: -1), stop.
Utdata skriv: ['>']+(w kopiera från:1 längd: -1), stop.
Utdata skriv: ['=== Edge case, last character only ==='], stop.
Utdata skriv: ['>']+(w kopiera från:35 längd: 1), stop.
Utdata skriv: ['>']+(w kopiera från:35 längd: 1), stop.
Utdata skriv: ['>']+(w kopiera från:36 längd: -1), stop.
Utdata skriv: ['>']+(w kopiera från:36 längd: -1), stop.
Utdata skriv: ['=== Out of bounds, empty string ==='], stop.
Utdata skriv: ['>']+(w kopiera från:36 längd: 37), stop.
Utdata skriv: ['>']+(w kopiera från:36 längd: 47), stop.
Utdata skriv: ['>']+(w kopiera från:-1 längd: -2), stop.
Utdata skriv: ['>']+(w kopiera från:-2 längd: -1), stop.
Utdata skriv: ['=== Part out of bounds, full string ==='], stop.
Utdata skriv: ['>']+(w kopiera från:-20 längd: 90), stop.
Utdata skriv: ['>']+(w kopiera från:90 längd: -20), stop.
Utdata skriv: ['>']+(w kopiera från:-20 längd: 90), stop.
Utdata skriv: ['>']+(w kopiera från:90 längd: -120), stop.
