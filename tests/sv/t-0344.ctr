# fånga-allt-test (praktiskt)
>> HTML := Text ny.
HTML vid: ['encode:'] gör: { :tekst
	själv lägg-till-sist: (tekst
	ersätt: ['&'] med: ['&amp;'], 
	ersätt: ['<'] med: ['&lt;'],
	ersätt: ['>'] med: ['&gt;'],
	ersätt: ['"'] med: ['&quot;']).
}.
>> blogg := HTML ny.
blogg lägg-till-sist: ['<h1>'],
     encode: ['Koffie & Thee'],
     lägg-till-sist: ['</h1>'].
Utdata skriv: blogg, stop.


>> Romersk := Tal ny.
Romersk vid: ['textig'] gör: {
	>> a := [''].
	{ a lägg-till-sist: ['I']. } × själv. <- a.
}.

>> x := Romersk ny.
x lägg-till: 3.
Utdata skriv: x textig, stop.

>> Kvant := Boolesk ny.
Kvant vid: ['true?'] gör: { <- ['kanske Sann']. }.
Utdata skriv: (Kvant ny true?), stop.

>> Nihil := Inget ny.
Nihil vid: ['text'] gör: { <- ['Nihil']. }.
Utdata skriv: (Nihil ny), stop.
