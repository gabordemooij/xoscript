# catch-all test (practical)
>> HTML := Text ny.
HTML vid: ['encode:'] gör: { :tekst
	själv lägg-till-sist: (tekst
	ersätt: ['&'] med: ['&amp;'], 
	ersätt: ['<'] med: ['&lt;'],
	ersätt: ['>'] med: ['&gt;'],
	ersätt: ['"'] med: ['&quot;']).
}.
>> blog := HTML ny.
blog lägg-till-sist: ['<h1>'],
     encode: ['Koffie & Thee'],
     lägg-till-sist: ['</h1>'].
Utdata skriv: blog, stop.


>> Roman := Tal ny.
Roman vid: ['stringy'] gör: {
	>> a := [''].
	{ a lägg-till-sist: ['I']. } × själv. <- a.
}.

>> x := Roman ny.
x lägg-till: 3.
Utdata skriv: x stringy, stop.

>> Quantum := Boolesk ny.
Quantum vid: ['true?'] gör: { <- ['maybe True']. }.
Utdata skriv: (Quantum ny true?), stop.

>> Nihil := Inget ny.
Nihil vid: ['text'] gör: { <- ['Nihil']. }.
Utdata skriv: (Nihil ny), stop.
