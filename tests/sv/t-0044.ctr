>> list := Lista ny.
list ~ ['hello'].
Utdata skriv: list antal.
list lägg-till-sist: ['world'].
Utdata skriv: list antal.
Utdata skriv: list ta-sista, skriv: list antal.
list lägg-till-sist: ['there'].
Utdata skriv: list antal.
Utdata skriv: (list position: 0), skriv: (list position: 1).
list sätt: ['jul'] vid: 1.
list sätt: ['god'] vid: 0.
Utdata skriv: list antal.
Utdata skriv: (list position: 0), skriv: (list position: 1).
