txt := txt + [' - kan vi använda strängar.. '].
txt := txt + ['utan att läcka '] + x + ['-tals bytes ?'].
txt lägg-till-sist: ['!!'].
Utdata skriv: txt.
} starta.

Program städa.

använtMinne1 := (Program minne ? 0).


{
>> txt := ['hallå '] + ['world'].
