>> Att-Göra := Objekt ny.

Att-Göra vid: ['ny'] gör: {
	egen list := Lista ny.
}.

Att-Göra vid: ['nieuw'] gör: {
	egen list := Lista ny.
}.

Att-Göra vid: ['+'] gör: { :uppgift
	egen list lägg-till-sist: uppgift.
}.

Att-Göra vid: ['number of tasks?'] gör: { <-  egen list antal.
}.

>> attgöra := 
	Att-Göra ny 
	+ ['laga middag'] 
	+ ['städa rummet'].
	
Utdata skriv: ['You have $ tasks to do'] $ attgöra number of tasks?.
