>> To-Do := Objekt ny.

To-Do vid: ['ny'] gör: {
	egen list := Lista ny.
}.

To-Do vid: ['nieuw'] gör: {
	egen list := Lista ny.
}.

To-Do vid: ['+'] gör: { :task
	egen list lägg-till-sist: task.
}.

To-Do vid: ['number of tasks?'] gör: { <-  egen list antal.
}.

>> todos := 
	To-Do ny 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Utdata skriv: ['You have $ tasks to do'] $ todos number of tasks?.
