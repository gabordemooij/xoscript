Utdata skriv: ['Test object'], stop.
>> a := Objekt ny. 

a vid: ['item:'] gör: { :octhelper
	egen octhelper := octhelper. 
}.

a vid: ['item'] gör: { <- egen octhelper.
}.

a item: Oct ny.

>> old-octhelper-address := a item prototyp minnesadress.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== RELOADING SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp minnesadress = old-octhelper-address) sann: {
	Utdata skriv: ['Object link re-attached.'], stop.
}.
