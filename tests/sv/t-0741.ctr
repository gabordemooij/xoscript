Utdata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 

a vid: ['item:'] gör: { :okthjälpare
	egen okthjälpare := okthjälpare. 
}.

a vid: ['artikel'] gör: {
	<- egen okthjälpare.
}.

a item: Oct ny.

>> gammal-okthjälpare-adress := a artikel prototyp minnesadress.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== LADDAR OM SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b artikel prototyp minnesadress = gammal-okthjälpare-adress) sann: {
	Utdata skriv: ['Objektlänk återkopplad.'], stop.
}.
