# rekursiv interpolering är inte tillåten

Utdata skriv: 
['rekursiv stränginterolation aktiverad: '] + (
	Program funktionalitet: 
	['RECURSIVE_STRINTPOL']
), stop.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Utdata skriv: a, stop.


Program funktionalitet: ['RECURSIVE_STRINTPOL'] aktivera: Sann.

Utdata skriv: 
['rekursiv stränginterpolation aktiverad: '] + (
	Program funktionalitet: 
	['RECURSIVE_STRINTPOL']
), stop.

>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Utdata skriv: a, stop.

