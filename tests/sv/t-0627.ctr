

# skapa ett 64-bitars heltal för exakta beräkningar
>> a := Int64 från-text: ['123'].

# till text
Utdata skriv: a, stop.

# dividera
Utdata skriv: a / (Int64 från-text: ['3']), stop.

# multiplicera
Utdata skriv: a * (Int64 från-text: ['2']), stop.

# addera
Utdata skriv: a + (Int64 från-text: ['1']), stop.

# subtrahera
Utdata skriv: a - (Int64 från-text: ['2']), stop.

# jämför
Utdata skriv: ( a =   (Int64 från-text: ['123'])), stop.
Utdata skriv: ( a !=: (Int64 från-text: ['124'])), stop.
Utdata skriv: ( a <   (Int64 från-text: ['124'])), stop.
Utdata skriv: ( a >   (Int64 från-text: ['122'])), stop.
Utdata skriv: ( a >=: (Int64 från-text: ['123'])), stop.
Utdata skriv: ( a <=: (Int64 från-text: ['123'])), stop.





	