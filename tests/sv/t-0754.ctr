Utdata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 

a vid: ['item:'] gör: { :ut
	egen ut := ut. 
}.

a vid: ['artikel'] gör: {
	<- egen ut.
}.

a vid: ['hälsa'] gör: {
	Utdata skriv: ['hej från ursprungliga ut!'], stop.
}.

a item: Utdata.

Utdata skriv: a artikel, stop.

>> gammal-ut-adress := a artikel prototyp minnesadress.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== LADDAR OM SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b artikel prototyp minnesadress = gammal-ut-adress) sann: {
	Utdata skriv: ['Objektlänk återkopplad.'], stop.
}.

b artikel skriv: ['hallå från inläst ut!'], stop.
b hälsa.
