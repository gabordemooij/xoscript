# ett format måste passa värdets typ, typen kan komma från en klient
>> försök := { :formatet :value
	{ Utdata skriv: ( (Format ny: formatet) tillämpa: value ), stop. } fånga: { :e Utdata skriv: e, stop. }, starta.
}.
>> pröva-heltal := { :formatet :value
	{ Utdata skriv: ( (Format ny: formatet) tillämpa-heltal: value ), stop. } fånga: { :e Utdata skriv: e, stop. }, starta.
}.

# passar
försök tillämpa: ['|%s|'] och: ['text'].
försök tillämpa: ['%06.2f'] och: 5.5.
försök tillämpa: ['100%% %s'] och: ['säkert'].
pröva-heltal tillämpa: ['%03d'] och: 7.
pröva-heltal tillämpa: ['%x'] och: 255.
försök tillämpa: ['%d'] och: (Int64 ny från-text: ['12']).
försök tillämpa: ['%lld'] och: (Int64 ny från-text: ['12']).
försök tillämpa: ['%.1lf'] och: 5.5.
pröva-heltal tillämpa: ['%hd'] och: 7.

# passar inte
försök tillämpa: ['%s'] och: 12345.
försök tillämpa: ['%d'] och: 12345.
försök tillämpa: ['%f'] och: ['text'].
pröva-heltal tillämpa: ['%d'] och: ['text'].
pröva-heltal tillämpa: ['%s'] och: 5.
försök tillämpa: ['%s %s'] och: ['text'].
försök tillämpa: ['%n'] och: ['text'].
försök tillämpa: ['%*s'] och: ['text'].
försök tillämpa: ['%'] och: ['text'].

# längdmodifieraren passar inte
försök tillämpa: ['%ls'] och: ['text'].
försök tillämpa: ['%Lf'] och: 5.5.
pröva-heltal tillämpa: ['%ld'] och: 7.
pröva-heltal tillämpa: ['%lld'] och: 7.
försök tillämpa: ['%Ld'] och: (Int64 ny från-text: ['12']).

# en bredd som inte passar printf måste ge ett fel, inte en krasch
försök tillämpa: ['%99999999999s'] och: ['text'].
