# valvnycklar och signaturer som avkodas för långa får inte spränga stacken
Server init.

>> nycklar := Valv generera-nycklar.
>> sk := nycklar första.
>> pk := nycklar sista.
>> sig := Valv signera: ['abc'] med: sk.

# 88 tecken utan utfyllnad avkodas till 66 bytes
>> lång := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 tecken utan utfyllnad avkodas till 33 bytes
>> kort := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Valv signera: ['abc'] med: lång. } fånga: { :e
	Utdata skriv: e, stop.
}, starta.

{ Valv kontrollera: ['abc'] signatur: lång med: pk. } fånga: { :e
	Utdata skriv: e, stop.
}, starta.

{ Valv kontrollera: ['abc'] signatur: sig med: kort. } fånga: { :e
	Utdata skriv: e, stop.
}, starta.
