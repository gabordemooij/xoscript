
Lista vid: ['sum'] gör: {
	>> total := 0.
	själv varje: { :index :element
		total lägg-till: element.
	}. <- total.
}.

>> a := Lista ← 9 ; 8 ; 7.
Utdata skriv: (a sum), stop. 
>> a := Lista ← 1 ; 9.
Utdata skriv: (a sum), stop. 
>> a := Lista ← ['o'] ; 2.
Utdata skriv: (a sum), stop. 
Utdata skriv: (Lista ny sum), stop. 
