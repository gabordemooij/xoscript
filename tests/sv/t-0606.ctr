>> Point := Objekt ny.
Point vid: ['x-coordinate:'] gör: { :x egen x := x. }.
Point vid: ['y-coordinate:'] gör: { :y egen y := y. }.
Point vid: ['x-coordinate']  gör: { <- egen x kopiera. }.
Point vid: ['y-coordinate']  gör: { <- egen y kopiera. }.

Point vid: ['='] gör: { :other <- ( egen x = other x-coordinate
		 och: egen y = other y-coordinate ).
}.

>> pier := Point ny x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point ny x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point ny x-coordinate: 5, y-coordinate: 6.

Utdata skriv: pier = town-hall, stop.
Utdata skriv: pier = restaurant, stop.
