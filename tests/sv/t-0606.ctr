>> Punkt := Objekt ny.
Punkt vid: ['x-coordinate:'] gör: { :x egen x := x. }.
Punkt vid: ['y-coordinate:'] gör: { :y egen y := y. }.
Punkt vid: ['x-koordinat']  gör: { <- egen x kopiera. }.
Punkt vid: ['y-koordinat']  gör: { <- egen y kopiera. }.

Punkt vid: ['='] gör: { :annan
	<- ( egen x = annan x-koordinat
		 och: egen y = annan y-koordinat ).
}.

>> brygga := Punkt ny x-coordinate: 5, y-coordinate: 6.
>> rådhus := Punkt ny x-coordinate: 7, y-coordinate: 1.
>> restaurang := Punkt ny x-coordinate: 5, y-coordinate: 6.

Utdata skriv: brygga = rådhus, stop.
Utdata skriv: brygga = restaurang, stop.
