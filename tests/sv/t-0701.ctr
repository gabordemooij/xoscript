# publik nyckel (för att säkra API:er osv.)
Server init.

# generera nycklar
>> nycklar := Valv generera-nycklar.

# privat (hemlig) nyckel
>> sk := nycklar första.

# publik nyckel
>> pk := nycklar sista.

# signera ett meddelande
>> sig := Valv signera: ['abc'] med: sk.

Utdata skriv: sig längd, stop.