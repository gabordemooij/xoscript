

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program minneshantering: 0.

>> txt := ['1.6'].
>> n := txt tal.
>> t := txt boolesk.
Utdata skriv: n, stop.
Utdata skriv: t, stop.
Utdata skriv: n typ, stop.
Utdata skriv: t typ, stop.

Program städa.

usedMemory1 := (Program minne ? 0).


txt := ['1.6'].
n := txt tal.
t := txt boolesk.
Utdata skriv: n, stop.
Utdata skriv: t, stop.
Utdata skriv: n typ, stop.
Utdata skriv: t typ, stop.

Program städa.
