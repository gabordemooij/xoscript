

>> använtMinne1 := 0.
>> använtMinne2 := 0.
>> använtMinne3 := 0.
>> använtMinne4 := 0.

Program minneshantering: 0.

>> txt := ['1.6'].
>> n := txt tal.
>> t := txt boolesk.
Utdata skriv: n, stop.
Utdata skriv: t, stop.
Utdata skriv: n typ, stop.
Utdata skriv: t typ, stop.

Program städa.

använtMinne1 := (Program minne ? 0).


txt := ['1.6'].
n := txt tal.
t := txt boolesk.
Utdata skriv: n, stop.
Utdata skriv: t, stop.
Utdata skriv: n typ, stop.
Utdata skriv: t typ, stop.

Program städa.
använtMinne2 := (Program minne ? 0).


txt := ['1.6'].
n := txt tal.
t := txt boolesk.
Utdata skriv: n, stop.
Utdata skriv: t, stop.
Utdata skriv: n typ, stop.
Utdata skriv: t typ, stop.

Program städa.
använtMinne3 := (Program minne ? 0).



( använtMinne1 = använtMinne2 och: använtMinne1 = använtMinne3, och: använtMinne2 = använtMinne3 ) sann: {
	Utdata skriv: ['Inga minnesläckor här'].
}, falsk: {
	Utdata skriv: ['Läcker minne...'].
}.
