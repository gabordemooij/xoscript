Program minneshantering: 4.

>> Dubblare := Objekt ny.
>> Multiplikator := Objekt ny.
Dubblare vid: ['dubbla:och:'] gör: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplikator vid: ['multiplicera:och:'] gör: { :x :y <- (x × y).
}.

Utdata skriv: (
	Dubblare dubbla:
		(Dubblare dubbla: 
			(Multiplikator multiplicera: 2 och: 3)
		och:
			(Multiplikator multiplicera: 3 och: 4)
		)
	och:
		(Dubblare dubbla: 
			(Multiplikator multiplicera: 2 och: 3)
		och:
			(Multiplikator multiplicera: 3 och: 4)
		)
), stop.
