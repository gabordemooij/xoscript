Program minneshantering: 4.

>> Doubler := Objekt ny.
>> Multiplier := Objekt ny.
Doubler vid: ['double:and:'] gör: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier vid: ['multiply:and:'] gör: { :x :y <- (x × y).
}.

Utdata skriv: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), stop.
