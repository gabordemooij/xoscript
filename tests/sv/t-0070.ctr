>> numbers := ['1,2,3'] dela: [','].
Utdata skriv: ['I got: '] + numbers antal + [' numbers.'],stop.
{ :i Utdata skriv: ['number #'] + i + [':'] + (numbers position: i), stop.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages dela: [' Or '].
Utdata skriv: ['We serve'], stop.
{ :i Utdata skriv: ['->'] + (beverages position: i), stop. } × (beverages antal).
Utdata skriv: (beverages sammanfoga: [',']), stop.
Utdata skriv: (numbers sammanfoga: ['||']).
