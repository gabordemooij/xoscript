>> talen := ['1,2,3'] dela: [','].
Utdata skriv: ['Jag fick: '] + talen antal + [' tal.'],stop.
{ :i Utdata skriv: ['number #'] + i + [':'] + (talen position: i), stop.} × 3.
>> drycker := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
drycker := drycker dela: [' Or '].
Utdata skriv: ['Vi serverar'], stop.
{ :i Utdata skriv: ['->'] + (drycker position: i), stop. } × (drycker antal).
Utdata skriv: (drycker sammanfoga: [',']), stop.
Utdata skriv: (talen sammanfoga: ['||']).
