

>> obj := Objekt ny.

obj vid: ['hälsa'] gör: {
	<- ['hej'].
}.

# måste skriva ut hi123hi123ok
obj vid: ['uppgift'] gör: {
	egen egenskap := 123.
	{
		# försök binder själv/egen till objektet i stället för blocket
		Utdata skriv: själv hälsa.
		Utdata skriv: egen egenskap.
		1 / 0.
	} fånga: {
		Utdata skriv: själv hälsa.
		Utdata skriv: egen egenskap.
		Utdata skriv: ['ok'].
	}, försök.
}.

obj uppgift.