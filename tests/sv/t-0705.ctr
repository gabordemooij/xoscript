

>> obj := Objekt ny.

obj vid: ['greet'] gör: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj vid: ['task'] gör: {
	egen property := 123.
	{
		# try binds self/own to object instead of block
		Utdata skriv: själv greet.
		Utdata skriv: egen property.
		1 / 0.
	} fånga: {
		Utdata skriv: själv greet.
		Utdata skriv: egen property.
		Utdata skriv: ['ok'].
	}, försök.
}.

obj task.