>> str := ['write:'].
Utdata meddelande: ['skriv:'] argument: (Lista ← ['Hello World']), stop. 

Tal vid: ['isbetween:and:'] gör: { :a :b <- ((själv ≥ a) och: (själv ≤ b)).
}.

str := ['isbetween:and:'].
Utdata skriv: (3 meddelande: str argument: (Lista ← 2 ; 8)), stop.
Utdata skriv: (3 meddelande: str argument: (Lista ← 1 ; 2)), stop.


>> CoffeeMachine := Objekt ny.
CoffeeMachine vid: ['makeCoffeeWithSugar:milk:'] gör: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Lista ← 4 ; 2.
Utdata skriv: ( CoffeeMachine meddelande: order argument: coffeeConfiguration ), stop.
