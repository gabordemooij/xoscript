# test list operations


>> cakes := Lista ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes ersätt: 1 längd: 2 med: ( Lista ← ['cinnamon'] ; ['pineapple'] ).
Utdata skriv: (buy sammanfoga: [',']), stop.


>> buy := cakes ersätt: 1 längd: 12 med: ( Lista ← ['cinnamon'] ; ['pineapple'] ).
Utdata skriv: (buy sammanfoga: [',']), stop.


>> buy := cakes ersätt: 2 längd: 10 med: ( Lista ny ).
Utdata skriv: (buy sammanfoga: [',']), stop.


>> buy := cakes ersätt: 0 längd: 1 med: ( Lista ny ).
Utdata skriv: (buy sammanfoga: [',']), stop.


>> buy := cakes ersätt: ['0'] längd: ['1'] med: ['x'].
Utdata skriv: (buy sammanfoga: [',']), stop.
