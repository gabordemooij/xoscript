# testa listoperationer


>> kakor := Lista ←
	['apple'] ;
	['bär'] ;
	['choklad'] ;
	['ost'].


>> köp := kakor ersätt: 1 längd: 2 med: ( Lista ← ['kanel'] ; ['ananas'] ).
Utdata skriv: (köp sammanfoga: [',']), stop.


>> köp := kakor ersätt: 1 längd: 12 med: ( Lista ← ['kanel'] ; ['ananas'] ).
Utdata skriv: (köp sammanfoga: [',']), stop.


>> köp := kakor ersätt: 2 längd: 10 med: ( Lista ny ).
Utdata skriv: (köp sammanfoga: [',']), stop.


>> köp := kakor ersätt: 0 längd: 1 med: ( Lista ny ).
Utdata skriv: (köp sammanfoga: [',']), stop.


>> köp := kakor ersätt: ['0'] längd: ['1'] med: ['x'].
Utdata skriv: (köp sammanfoga: [',']), stop.
