Server init.
>> f := Format ny: ['%d'].
>> a := Blob ny: 4.
a bytes: ( Lista ny ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob ny: 4.
b bytes: ( Lista ny ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a från: 0 längd: 3, varje: { :i :byte
	Utdata skriv: ( f tillämpa-heltal: byte ), stop.
}.
a ^ b.
a från: 0 längd: 3, varje: { :i :byte
	Utdata skriv: ( f tillämpa-heltal: byte ), stop.
}.
a ^ b.
a från: 0 längd: 3, varje: { :i :byte
	Utdata skriv: ( f tillämpa-heltal: byte ), stop.
}.
a frigör.
b frigör.

{ a ^ Objekt. } fånga: { :e Utdata skriv: e, stop. }, starta.
