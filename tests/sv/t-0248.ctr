

Text vid: ['evaluate'] gör: {
	>> code := Fil ny: ['/tmp/eval.ctr'].
	code skriv: själv text + ['.'].
	Program använd: ['/tmp/eval.ctr'].
}.

>> a := (Lista ← (
	(Ordbok ny)
		sätt: ['domain'] vid: ['mywebsite.com'],
		sätt: (Lista ←
			((Ordbok ny)
				sätt: ['home'] vid: ['title'],
				sätt: ['<html></html>'] vid: ['body'],
				sätt: ['2017-01-01'] vid: ['created']
			) ;
			((Ordbok ny)
				sätt: ['aboutus(c)'] vid: ['title'],
				sätt: ['<credits>Author Inc.</credits>'] vid: ['body']
			)
		) vid: ['pages']
	)
) text.

Utdata skriv: a typ, stop.
Utdata skriv: a, stop.

>> b := Inget.
(['b := '] + a) evaluate.
Utdata skriv: b ? 0 ? ['pages'] ? 1 ? ['body'], stop.

>> c := b ? 0.
>> d := c text.
Utdata skriv: d typ, stop.

>> e := Inget.
(['e := '] + d) evaluate.
Utdata skriv: e ? ['pages'] ? 0, stop.
