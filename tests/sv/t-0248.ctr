

Text vid: ['utvärdera'] gör: {
	>> code := Fil ny: ['/tmp/eval.ctr'].
	code skriv: själv text + ['.'].
	Program använd: ['/tmp/eval.ctr'].
}.

>> a := (Lista ← (
	(Ordbok ny)
		sätt: ['domän'] vid: ['mywebsite.com'],
		sätt: (Lista ←
			((Ordbok ny)
				sätt: ['hem'] vid: ['title'],
				sätt: ['<html></html>'] vid: ['body'],
				sätt: ['2017-01-01'] vid: ['skapad']
			) ;
			((Ordbok ny)
				sätt: ['omoss(c)'] vid: ['title'],
				sätt: ['<credits>Författare AB</credits>'] vid: ['body']
			)
		) vid: ['sidor']
	)
) text.

Utdata skriv: a typ, stop.
Utdata skriv: a, stop.

>> b := Inget.
(['b := '] + a) utvärdera.
Utdata skriv: b ? 0 ? ['sidor'] ? 1 ? ['body'], stop.

>> c := b ? 0.
>> d := c text.
Utdata skriv: d typ, stop.

>> e := Inget.
(['e := '] + d) utvärdera.
Utdata skriv: e ? ['sidor'] ? 0, stop.
