Utdata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 

a vid: ['item:'] gör: { :binhjälpare
	egen binhjälpare := binhjälpare. 
}.

a vid: ['artikel'] gör: {
	<- egen binhjälpare.
}.

a item: Bin ny.

>> gammal-binhjälpare-adress := a artikel prototyp minnesadress.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== LADDAR OM SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b artikel prototyp minnesadress = gammal-binhjälpare-adress) sann: {
	Utdata skriv: ['Objektlänk återkopplad.'], stop.
}.


