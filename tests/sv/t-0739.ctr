Utdata skriv: ['Test object'], stop.
>> a := Objekt ny. 

a vid: ['item:'] gör: { :binhelper
	egen binhelper := binhelper. 
}.

a vid: ['item'] gör: { <- egen binhelper.
}.

a item: Bin ny.

>> old-binhelper-address := a item prototyp minnesadress.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== RELOADING SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp minnesadress = old-binhelper-address) sann: {
	Utdata skriv: ['Object link re-attached.'], stop.
}.


