


>> Kaffemaskin := Objekt ny.
Kaffemaskin vid: ['order:'] gör: { :id
	>> coffee := ['Americano'].
	( id = 1 ) sann: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) sann: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) sann: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> EnkelKaffemaskin := Objekt ny.
EnkelKaffemaskin vid: ['beställning'] gör: { <- ['Svart']. }.
>> rödKopp := Kaffemaskin order: 1.
Utdata skriv: rödKopp, stop.
rödKopp := ['Te']. 
>> grönKopp := Kaffemaskin order: 0.
Utdata skriv: grönKopp, stop.
>> gulKopp := Kaffemaskin order: 1.
Utdata skriv: gulKopp, stop.
>> blåKopp := Kaffemaskin order: 0.
Utdata skriv: blåKopp, stop.
>> plastKopp := EnkelKaffemaskin beställning.
plastKopp := ['Lemonad']. 
>> svartKopp := EnkelKaffemaskin beställning.
Utdata skriv: svartKopp, stop.
svartKopp lägg-till-sist: [' neeej.... öl. '].
>> orangeKopp := EnkelKaffemaskin beställning.
Utdata skriv: orangeKopp, stop.
