


>> CoffeeMachine := Objekt ny.
CoffeeMachine vid: ['order:'] gör: { :id
	>> coffee := ['Americano'].
	( id = 1 ) sann: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) sann: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) sann: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Objekt ny.
SimpleCoffeeMachine vid: ['order'] gör: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Utdata skriv: redCup, stop.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Utdata skriv: greenCup, stop.
>> yellowCup := CoffeeMachine order: 1.
Utdata skriv: yellowCup, stop.
>> blueCup := CoffeeMachine order: 0.
Utdata skriv: blueCup, stop.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Utdata skriv: blackCup, stop.
blackCup lägg-till-sist: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Utdata skriv: orangeCup, stop.
