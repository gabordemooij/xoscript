
>> Rektangel := Objekt ny.

Rektangel vid: ['area'] gör: {
	<- egen längd * egen bredd.
}.

Rektangel vid: ['length:'] gör: { :längd
	egen längd := längd.
}.

Rektangel vid: ['width:'] gör: { :bredd
	egen bredd := bredd.
}.

Rektangel vid: ['ny'] gör: {
	# detta leder inte till en oändlig slinga
	>> rektangel := själv ny.
	rektangel length: 0, width: 0.
	<- rektangel.
}.

>> a := Rektangel ny.
Utdata skriv: a area, stop. #0

>> b := Rektangel ny length: 2, width: 3.
Utdata skriv: b area, stop. #6

