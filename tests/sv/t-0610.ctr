
>> Rectangle := Objekt ny.

Rectangle vid: ['area'] gör: { <- egen längd * egen width.
}.

Rectangle vid: ['length:'] gör: { :längd
	egen längd := längd.
}.

Rectangle vid: ['width:'] gör: { :width
	egen width := width.
}.

Rectangle vid: ['ny'] gör: {
	# this will not result into an infinite loop
	>> rectangle := själv ny.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle ny.
Utdata skriv: a area, stop. #0

>> b := Rectangle ny length: 2, width: 3.
Utdata skriv: b area, stop. #6

