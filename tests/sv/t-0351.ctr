
>> använtMinne1 := 0.
>> använtMinne2 := 0.
>> använtMinne3 := 0.
>> använtMinne4 := 0.

>> code := {
	>> o := (
		Ordbok ny
		aa: (Lista ← 1 ; 2),
		bb: (Lista ← 3 ; 4)
	).
	>> s := o text.
	>> o2 := s objekt.
	(s  typ = Text typ) sann: { Utdata skriv: ['OK1'], stop. }.
	(o2 typ = Ordbok typ) sann: { Utdata skriv: ['OK2'], stop. }.
}.

Program minneshantering: 0.
['Minne 1 blir annorlunda eftersom spårade block läggs till i klump.'].
Program städa.
använtMinne1 := (Program minne ? 1).
code starta.
Program städa.
använtMinne2 := (Program minne ? 1).
code starta.
Program städa.
använtMinne3 := (Program minne ? 1).
code starta.
Program städa.
använtMinne4 := (Program minne ? 1).

(använtMinne2 = använtMinne3 = använtMinne4) sann: { Utdata skriv: ['OK3'], stop. }.
 
