Utdata skriv: ['Test object'], stop.
>> a := Objekt ny. 

a vid: ['state:'] gör: { :list
	egen list := list. 
}.

a vid: ['state'] gör: {
	Utdata skriv: egen list, stop.
}.

a state: ( Lista ny ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== RELOADING SNAP:'], stop.
>> b := Objekt load-from: ['/tmp/a.bin'].
b state.