Utdata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 

a vid: ['state:'] gör: { :list
	egen list := list. 
}.

a vid: ['tillstånd'] gör: {
	Utdata skriv: egen list, stop.
}.

a state: ( Lista ny ; ['listelement'] ; ['element2'] ).
a tillstånd.

a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== LADDAR OM SNAP:'], stop.
>> b := Objekt load-from: ['/tmp/a.bin'].
b tillstånd.