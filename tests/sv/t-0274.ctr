

Lista vid: ['column:'] gör: { :column
	>> result := Lista ny.
	själv varje: { :index :row
		row varje: { :index :cell
			(index = column) sann: { result lägg-till-sist: cell. }.
		}.
	}. <- result.
}.


>> a := Lista ←
	(Lista ← 1 ; 2 ; 3) ;
	(Lista ← 4 ; 5 ; 6) ;
	(Lista ← 7 ; 8 ; 9).

>> b := a column: 1.
Utdata skriv: b, stop.

b := a column: 20.
Utdata skriv: b, stop.

b := a column: -100.
Utdata skriv: b, stop.
