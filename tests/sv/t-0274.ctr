

Lista vid: ['column:'] gör: { :kolumn
	>> resultat := Lista ny.
	själv varje: { :index :raden
		raden varje: { :index :cell
			(index = kolumn) sann: { resultat lägg-till-sist: cell. }.
		}.
	}. <- resultat.
}.


>> a := Lista ←
	(Lista ← 1 ; 2 ; 3) ;
	(Lista ← 4 ; 5 ; 6) ;
	(Lista ← 7 ; 8 ; 9).

>> b := a column: 1.
Utdata skriv: b, stop.

b := a column: 20.
Utdata skriv: b, stop.

b := a column: -100.
Utdata skriv: b, stop.
