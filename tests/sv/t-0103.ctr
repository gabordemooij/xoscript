>> a := Lista ← Objekt ; Sann ; Falsk ; Boolesk ; 1 ; Tal ; ['Str'] ; Text ; { ['Empty']. }.
Utdata skriv: (a antal), stop.
{ :i
	Utdata skriv: 
	['a '] + 
	((a ? i) typ) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Inget?) antingen: [''] eller: ['NOT']) + 
	[' Nil.'],
	stop.
} × (a antal).
Utdata skriv: ['but.. Nil is.. '] + ((Inget Inget?) antingen: ['certainly NIL!'] eller: ['not NIL??']), stop.