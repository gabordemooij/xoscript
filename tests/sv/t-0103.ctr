>> a := Lista ← Objekt ; Sann ; Falsk ; Boolesk ; 1 ; Tal ; ['Str'] ; Text ; { ['Tomt']. }.
Utdata skriv: (a antal), stop.
{ :i
	Utdata skriv: 
	['a '] + 
	((a ? i) typ) +
	([' \‘this\’ '] this: (a ? i))  +
	[' är '] +
	(((a ? i) Inget?) antingen: [''] eller: ['INTE']) + 
	[' Intet.'],
	stop.
} × (a antal).
Utdata skriv: ['men.. Intet är.. '] + ((Inget Inget?) antingen: ['definitivt INTET!'] eller: ['inte INTET??']), stop.