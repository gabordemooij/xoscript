>> t := Sann.
(t = Sann) sann: { Utdata skriv: ['T']. }.
(t = Falsk) sann: { Utdata skriv: ['F']. }.
Utdata skriv: ['|'].
>> t := Falsk.
(t = Sann) sann: { Utdata skriv: ['T']. }.
(t = Falsk) sann: { Utdata skriv: ['F']. }.
Utdata skriv: ['|'].
>> f := Sann.
(t = Sann och: f = Falsk) sann: { Utdata skriv: ['T']. }.
(t = Falsk och: f = Sann) sann: { Utdata skriv: ['F']. }.
Utdata skriv: ['|'].
>> n := Inget.
(n Inget?) sann: { Utdata skriv: ['T']. }.
(n Inget?) falsk: { Utdata skriv: ['F']. }.
Utdata skriv: ['|'].
(f Boolean?) sann: { Utdata skriv: ['T']. }.
(f Boolean?) falsk: { Utdata skriv: ['F']. }.



