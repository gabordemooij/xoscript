
>> använtMinne1 := 0.
>> använtMinne2 := 0.
>> använtMinne3 := 0.
>> använtMinne4 := 0.
>> code := {
	>> a := Lista ny.
	>> b := Lista ny.
	a lägg-till-sist: b.
	b lägg-till-sist: a.
}.
Program minneshantering: 0.
Program städa.
använtMinne1 := (Program minne ? 0).
code starta.
Program städa.
använtMinne2 := (Program minne ? 0).
code starta.
Program städa.
