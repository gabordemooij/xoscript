
>> countries := Lista ny
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Lista ny
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods efter: countries, varje: { :key :value
	counter lägg-till: 1.
}.

Utdata skriv: (['we serve counter dishes'] counter: counter), stop.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] tecken sortera: { :v
	counter lägg-till: 0.
}.

Utdata skriv: (['we sort counter dishes'] counter: counter), stop.


>> counter := 0.
{
	{
		counter lägg-till: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Utdata skriv: (['we calculate counter numbers.'] counter: counter), stop.

