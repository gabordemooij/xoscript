
>> länder := Lista ny
	~ ['Schweiz']
	~ ['Italien']
	~ ['Tyskland'].

>> maträtter := Lista ny
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Surkål'].


>> räknare := 0.
maträtter efter: länder, varje: { :key :value
	räknare lägg-till: 1.
}.

Utdata skriv: (['we serve counter dishes'] counter: räknare), stop.

>> räknare := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] tecken sortera: { :v
	räknare lägg-till: 0.
}.

Utdata skriv: (['we sort counter dishes'] counter: räknare), stop.


>> räknare := 0.
{
	{
		räknare lägg-till: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Utdata skriv: (['we calculate counter numbers.'] counter: räknare), stop.

