Utdata skriv: ['1,2,3,4,5,6,7,8,9,A,'], stop.
>> Scope := Objekt ny.
Scope vid: ['initialize:'] gör: { :x egen property := x. }.
Scope vid: ['confirm'] gör: { Utdata skriv: [',']. }.
Scope vid: ['test'] gör: {
	Utdata skriv: egen property.
	själv confirm.
	( 1 = 1 ) sann: { Utdata skriv: egen property. själv confirm. }.
	( 1 = 0 ) falsk: { Utdata skriv: egen property. själv confirm. }.
	>> y := 2. { Utdata skriv: egen property. själv confirm. } medan: { y subtrahera: 1. <- (y > 0). }.
	{ Utdata skriv: egen property. själv confirm. } × 1.
	(Lista ← 1) varje: {  Utdata skriv: egen property. själv confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Ordbok ny one: ['item']) varje: { Utdata skriv: egen property. själv confirm. }.
	{ 1 ÷ 0. } fånga: { Utdata skriv: egen property. själv confirm. }, starta.
	Utdata stop.
}.
>> scope1 := Scope ny.
scope1 initialize: ['X'].
scope1 test.
>> function := { 
	egen property := ['Y'].
	Utdata skriv: egen property.
	själv confirm.
	( 1 = 1 ) sann: { Utdata skriv: egen property. själv confirm. }.
	( 1 = 0 ) falsk: { Utdata skriv: egen property. själv confirm. }.
	>> y := 2. { Utdata skriv: egen property. själv confirm. } medan: { y subtrahera: 1. <- (y > 0). }.
	{ Utdata skriv: egen property. själv confirm. } × 1.
	(Lista ← 1) varje: {  Utdata skriv: egen property. själv confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Ordbok ny one: ['item']) varje: { Utdata skriv: egen property. själv confirm. }.
	{ 1 ÷ 0. } fånga: { Utdata skriv: egen property. själv confirm. }, starta.
	Utdata stop.
}.
function vid: ['confirm'] gör: { Utdata skriv: [',']. }.
function tillämpa: 1 och: 2.
