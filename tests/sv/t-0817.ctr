# a value ending in the first part of an opening quote must survive serialization
>> värden := Lista ny
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

värden varje: { :i :value
	>> d := Ordbok ny.
	d sätt: value vid: ['k'].
	d sätt: ['second'] vid: ['j'].
	>> r := d code objekt.
	Utdata skriv: r antal, stop.
	Utdata skriv: ( (r vid: ['k']) = value ), stop.
}.
