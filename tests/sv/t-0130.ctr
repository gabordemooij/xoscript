# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Program inställning: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server länka: ( Lista ny ;
 libname ; ['fopen'] ;
 ( Lista ny ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
länka: ( Lista ny ;
 Inget ; # means same lib
 ['fread'] ;
 ( Lista ny ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Inget ; # means same object (i.e. Stream)
 ['fread']
),
länka: (
 Lista ny ;
 Inget ; # means same lib
 ['fwrite'] ;
 ( Lista ny ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Inget ; # means same lib
 ['fwrite']
),
länka: (
 Lista ny ;
 Inget ; # means same lib
 ['rewind'] ;
 ( Lista ny ; ['pointer'] ) ;
 ['int'] ;
 Inget ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> sökväg := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: sökväg mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream meddelande: ['fwrite'] argument: (Lista ny ; str ; 1 ; 6 ; fd ).
Utdata skriv: bytes-written, stop.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob ny: 20.

# read from file
>> bytes-read := Stream meddelande: ['fread'] argument: (Lista ny ; buf ; 1 ; 6 ; fd ).
Utdata skriv: bytes-read, stop.
Utdata skriv: buf, stop.

# free memory
str  frigör.
sökväg frigör.
mode frigör.
buf  frigör.


