# FFI med Server-pluginet

# anslut till libc (plattformsberoende)
>> biblnamn := Program inställning: ['FFITESTLIB'].

# länka stdio-funktioner från C för avancerade filoperationer
Server länka: ( Lista ny ;
 biblnamn ; ['fopen'] ;
 ( Lista ny ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
länka: ( Lista ny ;
 Inget ; # betyder samma bibliotek
 ['fread'] ;
 ( Lista ny ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Inget ; # betyder samma objekt (dvs. Stream)
 ['fread']
),
länka: (
 Lista ny ;
 Inget ; # betyder samma bibliotek
 ['fwrite'] ;
 ( Lista ny ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Inget ; # betyder samma bibliotek
 ['fwrite']
),
länka: (
 Lista ny ;
 Inget ; # betyder samma bibliotek
 ['rewind'] ;
 ( Lista ny ; ['pointer'] ) ;
 ['int'] ;
 Inget ; # betyder samma bibliotek
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> sökväg := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# öppna en fil med fopen(path, mode)
>> fd := Stream path: sökväg mode: mode.

# skriv bytes från bufferten str till filen
>> skrivna-bytes := Stream meddelande: ['fwrite'] argument: (Lista ny ; str ; 1 ; 6 ; fd ).
Utdata skriv: skrivna-bytes, stop.

# spola tillbaka filpekaren
Stream rewind: fd.

# allokera en buffert
>> buf := Blob ny: 20.

# läs från filen
>> lästa-bytes := Stream meddelande: ['fread'] argument: (Lista ny ; buf ; 1 ; 6 ; fd ).
Utdata skriv: lästa-bytes, stop.
Utdata skriv: buf, stop.

# frigör minnet
str  frigör.
sökväg frigör.
mode frigör.
buf  frigör.


