Tal vid: ['factorial'] gör: {
	>> total := 1.
	{ :index total multiplicera-med: (själv - (index)). } × själv. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Utdata skriv: a.
>> b := 2 + 3 factorial.
Utdata skriv: b.
>> c := 3 factorial + 2.
Utdata skriv: c.
>> d := 2 + (3 factorial).
Utdata skriv: d.
Utdata skriv: 2 + 3 factorial + 1.
