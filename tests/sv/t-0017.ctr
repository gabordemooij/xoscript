Tal vid: ['fakultet'] gör: {
	>> totalt := 1.
	{ :index totalt multiplicera-med: (själv - (index)). } × själv. <- totalt.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Utdata skriv: a.
>> b := 2 + 3 fakultet.
Utdata skriv: b.
>> c := 3 fakultet + 2.
Utdata skriv: c.
>> d := 2 + (3 fakultet).
Utdata skriv: d.
Utdata skriv: 2 + 3 fakultet + 1.
