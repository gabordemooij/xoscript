
>> Mått := Objekt ny.
Mått vid: ['is:'] gör: { :tal
	tal vid: ['+'] gör: { :tal
		>> enhet := tal beteckning.
		>> faktor := 1.
		
		enhet
		fall: ['inch'] gör: { faktor := 0.0833. }.

		<- själv + (tal * faktor).
	}.
	<- tal.
}.

# Detta storlekstal kan användas så här:

>> planka := Mått is: 6 foot.
>> kant := Mått is: 50 inch.

# Detta visas som: 10.165
Utdata skriv: planka + kant, stop.
