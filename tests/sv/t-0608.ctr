
>> Size := Objekt ny.
Size vid: ['is:'] gör: { :tal
	tal vid: ['+'] gör: { :tal
		>> unit := tal beteckning.
		>> factor := 1.
		
		unit
		fall: ['inch'] gör: { factor := 0.0833. }. <- själv + (tal * factor).
	}. <- tal.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Utdata skriv: plank + edge, stop.
