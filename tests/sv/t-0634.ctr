# Program shell-escape ger kanonisk posix-skalsyntax
# kompatibel med: bash/dash, zsh, ksh

>> c := Program shell-escape: ['abc'].
Utdata skriv: c, stop.
Utdata skriv: ( Program system: ['echo '] + c ), stop.

c := Program shell-escape: ['a'b'c'].
Utdata skriv: c, stop.
Utdata skriv: ( Program system: ['echo '] + c ), stop.

c := Program shell-escape: ['a\'c'].
Utdata skriv: c, stop.
Utdata skriv: ( Program system: ['echo '] + c ), stop.