Server init.
Utdata skriv: ['Databasdatumtidtest'], stop.

>> db := Maria-DB ny värd: ['localhost'],
	användarnamn: ['xo'], 
	lösenord: ['pass123'],
	databasnamn: ['xobase'],
	anslut.

>> sökparametrar :=
db fråga: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
hämta: { :raden
	Utdata skriv: raden datetimetest, stop.
}.
