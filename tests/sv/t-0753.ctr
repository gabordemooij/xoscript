Utdata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 

a vid: ['item:'] gör: { :fmt
	egen fmt := fmt. 
}.

a vid: ['artikel'] gör: {
	<- egen fmt.
}.

a item: ( Format ny: ['|%s|'] ).

Utdata skriv: a artikel, stop.

>> gammal-fmt-adress := a artikel prototyp minnesadress.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== LADDAR OM SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b artikel prototyp minnesadress = gammal-fmt-adress) sann: {
	Utdata skriv: ['Objektlänk återkopplad.'], stop.
}.

Utdata skriv: ( b artikel tillämpa: ['hello'] ), stop.
