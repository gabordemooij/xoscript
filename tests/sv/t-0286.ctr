['Tusental och decimaler'].

>> x := 100000000.5.
>> y := 100000000.5.

Utdata skriv: (x + y), stop.

>> x := 10040.07.
>> y := 10305.60.

Utdata skriv: (x + y), stop.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Utdata skriv: (x + y + z), stop.

['Konstigt men giltigt'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Utdata skriv: (x + y + z), stop.

>> q := 0.1.2.

Utdata skriv: (q), stop.

>> q := 012.

Utdata skriv: (q), stop.
