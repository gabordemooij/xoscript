
>> dictionary := (
	Ordbok ny
		sätt: ['b'] vid: ['a'],
		sätt: ['a'] vid: ['b'],
		sätt: ['z'] vid: ['x'],
		sätt: ['hello'] vid: ['hallo'],
		sätt: ['human'] vid: ['human']
).

>> comparisons := Lista ny.
dictionary varje: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a jämför: b)
	).
}.

comparisons sortera: { :a :b <- ( a jämför: b ). }.
Utdata skriv: ( comparisons sammanfoga: ['↵'] ), stop.
comparisons sammanfoga: ['↵'].
