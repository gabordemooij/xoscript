
>> ordlista := (
	Ordbok ny
		sätt: ['b'] vid: ['a'],
		sätt: ['a'] vid: ['b'],
		sätt: ['z'] vid: ['x'],
		sätt: ['hello'] vid: ['hallo'],
		sätt: ['människa'] vid: ['människa']
).

>> jämförelser := Lista ny.
ordlista varje: { :a :b
	jämförelser ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a jämför: b)
	).
}.

jämförelser sortera: { :a :b <- ( a jämför: b ). }.
Utdata skriv: ( jämförelser sammanfoga: ['↵'] ), stop.
jämförelser sammanfoga: ['↵'].
