
>> a := Lista ← (Lista ← 100 ; 200 ; 300) ; (Lista ← 9 ; 8 ; 7).
Utdata skriv: ['at 0,1 :'].
Utdata skriv: a ? 0 ? 1, stop. 
Utdata skriv: ['at 1,2 :'].
Utdata skriv: a ? 1 ? 2, stop. 
>> menu := Ordbok ny.
menu sätt: (Lista ← ['pizza'] ; ['spaghetti']) vid: ['Italian Cuisine'].
menu sätt: (Lista ← ['bifteki'] ; ['suflaki']) vid: ['Greek Cuisine'].
Utdata skriv: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), stop. 
Utdata skriv: ['but not on the same plate.'], stop.
