Server init.

>> DB := Maria-DB ny värd: ['localhost'],
	användarnamn: ['xo'],
	lösenord: ['pass123'],
	databasnamn: ['xobase'],
	anslut.

{
	DB fråga:
	['DROP TABLE movies'],
	utför.
} fånga: { Inget. }, starta.

DB fråga:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
utför.

DB fråga: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parametrar: ( Lista ny ; ['Halloween'] ),
utför.

DB fråga: ['SELECT * FROM movies'],
hämta: { :movie
	Utdata skriv: movie title, stop.
}.

