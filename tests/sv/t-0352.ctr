Tal vid: ['romersk'] gör: {
	>> tal := själv kopiera.
	>> romersk := [''].
	{
		{
			(tal ≥ 1000) sann: {
				romersk lägg-till-sist: ['Ⅿ'].
				tal subtrahera: 1000.
			}, avbryt.
		
			(tal ≥ 500) sann: {
				romersk lägg-till-sist: ['Ⅾ'].
				tal subtrahera: 500.
			}, avbryt.
		
			(tal ≥ 100) sann: {
				romersk lägg-till-sist: ['Ⅽ'].
				tal subtrahera: 100.
			}, avbryt.
		
			(tal ≥ 50) sann: {
				romersk lägg-till-sist: ['Ⅼ'].
				tal subtrahera: 50.
			}, avbryt.
		
			(tal ≥ 50) sann: {
				romersk lägg-till-sist: ['Ⅼ'].
				tal subtrahera: 50.
			}, avbryt.
		
			(tal ≥ 10) sann: {
				romersk lägg-till-sist: ['Ⅹ'].
				tal subtrahera: 10.
			}, avbryt.
			
			(tal ≥ 9) sann: {
				romersk lägg-till-sist: ['Ⅸ'].
				tal subtrahera: 9.
			}, avbryt.
			
			(tal ≥ 5) sann: {
				romersk lägg-till-sist: ['Ⅴ'].
				tal subtrahera: 5.
			}, avbryt.
			
			(tal ≥ 4) sann: {
				romersk lägg-till-sist: ['Ⅳ'].
				tal subtrahera: 4.
			}, avbryt.
			
			(tal ≥ 1) sann: {
				romersk lägg-till-sist: ['Ⅰ'].
				tal subtrahera: 1.
			}, avbryt.
		} procedur.
	} medan: { <- tal > 0. }. <- romersk.
}.

Utdata skriv: 1 romersk, stop.
Utdata skriv: 2 romersk, stop.
Utdata skriv: 4 romersk, stop.
Utdata skriv: 8 romersk, stop.
Utdata skriv: 16 romersk, stop.
Utdata skriv: 32 romersk, stop.
Utdata skriv: 64 romersk, stop.
Utdata skriv: 128 romersk, stop.
Utdata skriv: 256 romersk, stop.
Utdata skriv: 1024 romersk, stop.
