Tal vid: ['roman'] gör: {
	>> tal := själv kopiera.
	>> roman := [''].
	{
		{
			(tal ≥ 1000) sann: {
				roman lägg-till-sist: ['Ⅿ'].
				tal subtrahera: 1000.
			}, avbryt.
		
			(tal ≥ 500) sann: {
				roman lägg-till-sist: ['Ⅾ'].
				tal subtrahera: 500.
			}, avbryt.
		
			(tal ≥ 100) sann: {
				roman lägg-till-sist: ['Ⅽ'].
				tal subtrahera: 100.
			}, avbryt.
		
			(tal ≥ 50) sann: {
				roman lägg-till-sist: ['Ⅼ'].
				tal subtrahera: 50.
			}, avbryt.
		
			(tal ≥ 50) sann: {
				roman lägg-till-sist: ['Ⅼ'].
				tal subtrahera: 50.
			}, avbryt.
		
			(tal ≥ 10) sann: {
				roman lägg-till-sist: ['Ⅹ'].
				tal subtrahera: 10.
			}, avbryt.
			
			(tal ≥ 9) sann: {
				roman lägg-till-sist: ['Ⅸ'].
				tal subtrahera: 9.
			}, avbryt.
			
			(tal ≥ 5) sann: {
				roman lägg-till-sist: ['Ⅴ'].
				tal subtrahera: 5.
			}, avbryt.
			
			(tal ≥ 4) sann: {
				roman lägg-till-sist: ['Ⅳ'].
				tal subtrahera: 4.
			}, avbryt.
			
			(tal ≥ 1) sann: {
				roman lägg-till-sist: ['Ⅰ'].
				tal subtrahera: 1.
			}, avbryt.
		} procedur.
	} medan: { <- tal > 0. }. <- roman.
}.

Utdata skriv: 1 roman, stop.
Utdata skriv: 2 roman, stop.
Utdata skriv: 4 roman, stop.
Utdata skriv: 8 roman, stop.
Utdata skriv: 16 roman, stop.
Utdata skriv: 32 roman, stop.
Utdata skriv: 64 roman, stop.
Utdata skriv: 128 roman, stop.
Utdata skriv: 256 roman, stop.
Utdata skriv: 1024 roman, stop.
