# färre parametrar än platshållare måste ge ett fel, inte läsa förbi bindningarna
Server init.

>> db := Maria-DB ny värd: ['localhost'],
	användarnamn: ['xo'],
	lösenord: ['pass123'],
	databasnamn: ['xobase'],
	anslut.

>> sökparametrar := db fråga: ['SELECT ? AS a, ? AS b, ? AS c'].
sökparametrar parametrar: (Lista ny ; ['1']).
{ sökparametrar hämta: { :raden Utdata skriv: raden, stop. }. } fånga: { :e Utdata skriv: e, stop. }, starta.

>> sökparametrar := db fråga: ['SELECT ? AS a'].
{ sökparametrar hämta: { :raden Utdata skriv: raden, stop. }. } fånga: { :e Utdata skriv: e, stop. }, starta.

# rätt antal fungerar fortfarande, fler parametrar ignoreras som tidigare
>> sökparametrar := db fråga: ['SELECT ? AS a, ? AS b'].
sökparametrar parametrar: (Lista ny ; ['1'] ; ['2']).
sökparametrar hämta: { :raden Utdata skriv: (raden vid: ['a']), skriv: (raden vid: ['b']), stop. }.
sökparametrar parametrar: (Lista ny ; ['1'] ; ['2'] ; ['3']).
sökparametrar hämta: { :raden Utdata skriv: (raden vid: ['a']), skriv: (raden vid: ['b']), stop. }.
