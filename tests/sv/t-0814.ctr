# sessionskakans format, json-innehållstyp, endast webbprotokoll, svg visas inline
Server initiera.
Program använd: ['../../../src/xo/sv/webtools.xo'].

>> Falsk-Förfrågan := Objekt ny.
Falsk-Förfrågan vid: ['value:'] gör: { :värde
	egen värde := värde.
}.
Falsk-Förfrågan vid: ['cookie:'] gör: { :namn
	<- egen värde.
}.

>> Testsession := Tillfällig-fil-session ny.
Testsession vid: ['läs-in'] gör: {
	<- Ordbok ny.
}.
Testsession vid: ['sessionsid'] gör: {
	<- egen id.
}.

>> cookies := Lista ny
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

cookies varje: { :i :cookie
	>> begäran := Falsk-Förfrågan ny.
	begäran value: cookie.
	>> hanterare := Testsession ny.
	>> webb := Webbdokument ny.
	webb begäran: begäran.
	webb sessionshanterare: hanterare.
	webb starta-session.
	Utdata skriv: ( hanterare sessionsid = cookie ), stop.
}.

>> webb := Webbdokument ny.
webb json: (Ordbok ny sätt: ['b'] vid: ['a']).
Utdata skriv: ['\n'], stop.

{ Nätverk get: ['file:///etc/hostname']. } fånga: { :e
	Utdata skriv: e, stop.
}, starta.

>> svg := Fil ny: ['/tmp/test0814.svg'].
svg skriv: ['<svg xmlns="x"></svg>'].
Utdata stop.
Server vidarebefordra: ['test0814.svg'] prefix: ['/tmp/'].
svg radera.
