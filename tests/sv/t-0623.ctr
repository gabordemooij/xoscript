

>> g  := Server ny.
>> v  := Valv ny.
>> ok := 0.

>> hemligheter := Lista ny ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> lösenorden := hemligheter kopiera.
lösenorden varje: { :i :p
	hemligheter varje: { :n :s
		{
			>> krypterad := v kryptera: s nyckel: p.
			>> dekrypterad := v dekryptera: krypterad nyckel: p.
			(dekrypterad = s) sann: {
				ok lägg-till: 1.
			}, annars: {
				Utdata skriv: ['kryptering/dekryptering misslyckades: '], stop.
				Utdata skriv: s, stop.
				Utdata skriv: ['krypterat: '] + krypterad, stop.
				Utdata skriv: ['dekrypterat: '] + krypterad, stop.
				Program avsluta.
			}.
		} fånga: { :fl
			(s = [''] eller: p = ['']) sann: {
				ok lägg-till: 1.
			}, annars: {
				Utdata skriv: fl, stop.
				Program avsluta.
			}.
		}, starta.
	}.
}.

Utdata skriv: ( ok + [' valvkrypteringar testade.'] ), stop.