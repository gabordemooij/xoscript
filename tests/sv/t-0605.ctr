>> faktura := Objekt ny.
faktura vid: ['starta'] gör: {
        egen tal := 0.
}.

faktura vid: ['tal'] gör: {
        egen tal lägg-till: 1.
        <- egen tal kopiera.
}.

>> årsfaktura := faktura ny.
årsfaktura vid: ['start:'] gör: { :år
	egen tal := år.
}.

årsfaktura start: 202000.
Utdata skriv: årsfaktura tal, stop.
Utdata skriv: årsfaktura tal, stop.
