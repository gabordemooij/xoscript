>> invoice := Objekt ny.
invoice vid: ['starta'] gör: {
        egen tal := 0.
}.

invoice vid: ['tal'] gör: {
        egen tal lägg-till: 1. <- egen tal kopiera.
}.

>> year-invoice := invoice ny.
year-invoice vid: ['start:'] gör: { :år
	egen tal := år.
}.

year-invoice start: 202000.
Utdata skriv: year-invoice tal, stop.
Utdata skriv: year-invoice tal, stop.
