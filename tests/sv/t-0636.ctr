# testa url-tolkning

Server init.
>> url := URL från: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Utdata skriv: ['schema = '] + url schema, stop.
Utdata skriv: ['värd = '] + url värd, stop.
Utdata skriv: ['port = '] + url port, stop.
Utdata skriv: ['sökväg = '] + url sökväg, stop.
Utdata skriv: ['fråga = '] + url sökparametrar, stop.
Utdata skriv: ['fragment = '] + url fragment, stop.
