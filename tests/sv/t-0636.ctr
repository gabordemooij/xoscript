# test url parsing

Server init.
>> url := URL från: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Utdata skriv: ['scheme = '] + url schema, stop.
Utdata skriv: ['host = '] + url värd, stop.
Utdata skriv: ['port = '] + url port, stop.
Utdata skriv: ['path = '] + url sökväg, stop.
Utdata skriv: ['query = '] + url sökparametrar, stop.
Utdata skriv: ['fragment = '] + url fragment, stop.
