#Linux

 >> t := Moment ny.
 
t zon: ['Europe/Amsterdam'].
t år: 2020, månad: 8, dag: 2, timme: 21, minut: 2, sekund: 1.

>> a := t timme.
>> ams := t zon.

t zon: ['US/Hawaii'].
>> b := t timme.
>> hw := t zon.

Utdata
skriv: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		antingen: ['senare'] eller: ['tidigare']
	)
),
stop.
 