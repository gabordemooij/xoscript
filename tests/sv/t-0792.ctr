Server init.

>> DB := Maria-DB ny värd: ['localhost'],
	användarnamn: ['xo'],
	lösenord: ['pass123'],
	databasnamn: ['xobase'],
	anslut.
	
>> SQL := ['SELECT "hello" AS "world" '].

# ett snabbare sätt, hämta frågan från DB:
>> fråga2 := DB fråga: SQL.

# nu behöver du inte ange DB
fråga2 hämta: { :raden
	Utdata skriv: raden world, stop.
}.
