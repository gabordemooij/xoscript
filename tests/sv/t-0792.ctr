Server init.

>> DB := Maria-DB ny värd: ['localhost'],
	användarnamn: ['xo'],
	lösenord: ['pass123'],
	databasnamn: ['xobase'],
	anslut.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB fråga: SQL.

# now you don't have to set DB
query2 hämta: { :row
	Utdata skriv: row world, stop.
}.
