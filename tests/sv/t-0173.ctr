

Lista vid: ['summa'] gör: {
	>> totalt := 0.
	själv varje: { :index :elementet
		totalt lägg-till: elementet.
	}. <- totalt.
}.

Lista vid: ['produkt'] gör: {
	>> totalt := 1.
	själv varje: { :index :elementet
		totalt multiplicera-med: elementet.
	}. <- totalt.
}.

>> använtMinne1 := 0.
>> använtMinne2 := 0.
>> använtMinne3 := 0.
>> använtMinne4 := 0.

Program minneshantering: 0.

{

>> a := Lista ← ['hello'] ; ['world'] ; Sann ; Inget ; 666.
a := a + ( Lista ← 1 ).
Utdata skriv: ( ['summa: '] + ( a summa ) ), stop.
Utdata skriv: ( ['min: '] + ( a minimum ) ), stop.
Utdata skriv: ( ['max: '] + ( a maximum ) ), stop.
Utdata skriv: ( ['3:e: '] + ( a ? 2 ) ), stop.
Utdata skriv: ( ['prd: '] + ( a produkt ) ), stop.
a sortera: { :a :b <- (b - a). }.
a varje: { :i :e Utdata skriv: ( i - 0 ), stop. }.

} starta.

Program städa.
använtMinne1 := (Program minne ? 0).


{

>> a := Lista ← ['hello'] ; ['world'] ; Sann ; Inget ; 666.
a := a + ( Lista ← 1 ).
Utdata skriv: ( ['summa: '] + ( a summa ) ), stop.
Utdata skriv: ( ['min: '] + ( a minimum ) ), stop.
Utdata skriv: ( ['max: '] + ( a maximum ) ), stop.
Utdata skriv: ( ['3:e: '] + ( a ? 2 ) ), stop.
Utdata skriv: ( ['prd: '] + ( a produkt ) ), stop.
a sortera: { :a :b <- (b - a). }.
a varje: { :i :e Utdata skriv: ( i - 0 ), stop. }.

} starta.



Program städa.
använtMinne2 := (Program minne ? 0).


{

>> a := Lista ← ['hello'] ; ['world'] ; Sann ; Inget ; 666.
a := a + ( Lista ← 1 ).
Utdata skriv: ( ['summa: '] + ( a summa ) ), stop.
Utdata skriv: ( ['min: '] + ( a minimum ) ), stop.
Utdata skriv: ( ['max: '] + ( a maximum ) ), stop.
Utdata skriv: ( ['3:e: '] + ( a ? 2 ) ), stop.
Utdata skriv: ( ['prd: '] + ( a produkt ) ), stop.
a sortera: { :a :b <- (b - a). }.
a varje: { :i :e Utdata skriv: ( i - 0 ), stop. }.

} starta.



Program städa.
använtMinne3 := (Program minne ? 0).

( använtMinne1 = använtMinne2 och: använtMinne1 = använtMinne3, och: använtMinne2 = använtMinne3 ) sann: {
	Utdata skriv: ['Inga minnesläckor här'].
}, falsk: {
	Utdata skriv: ['Läcker minne...'].
}.
