

Lista vid: ['sum'] gör: {
	>> total := 0.
	själv varje: { :index :element
		total lägg-till: element.
	}. <- total.
}.

Lista vid: ['product'] gör: {
	>> total := 1.
	själv varje: { :index :element
		total multiplicera-med: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program minneshantering: 0.

{

>> a := Lista ← ['hello'] ; ['world'] ; Sann ; Inget ; 666.
a := a + ( Lista ← 1 ).
Utdata skriv: ( ['sum: '] + ( a sum ) ), stop.
Utdata skriv: ( ['min: '] + ( a minimum ) ), stop.
Utdata skriv: ( ['max: '] + ( a maximum ) ), stop.
Utdata skriv: ( ['3rd: '] + ( a ? 2 ) ), stop.
Utdata skriv: ( ['prd: '] + ( a product ) ), stop.
a sortera: { :a :b <- (b - a). }.
a varje: { :i :e Utdata skriv: ( i - 0 ), stop. }.

} starta.

Program städa.
usedMemory1 := (Program minne ? 0).


{

>> a := Lista ← ['hello'] ; ['world'] ; Sann ; Inget ; 666.
a := a + ( Lista ← 1 ).
Utdata skriv: ( ['sum: '] + ( a sum ) ), stop.
Utdata skriv: ( ['min: '] + ( a minimum ) ), stop.
Utdata skriv: ( ['max: '] + ( a maximum ) ), stop.
Utdata skriv: ( ['3rd: '] + ( a ? 2 ) ), stop.
Utdata skriv: ( ['prd: '] + ( a product ) ), stop.
a sortera: { :a :b <- (b - a). }.
a varje: { :i :e Utdata skriv: ( i - 0 ), stop. }.

} starta.



Program städa.
usedMemory2 := (Program minne ? 0).


{

>> a := Lista ← ['hello'] ; ['world'] ; Sann ; Inget ; 666.
a := a + ( Lista ← 1 ).
Utdata skriv: ( ['sum: '] + ( a sum ) ), stop.
Utdata skriv: ( ['min: '] + ( a minimum ) ), stop.
Utdata skriv: ( ['max: '] + ( a maximum ) ), stop.
Utdata skriv: ( ['3rd: '] + ( a ? 2 ) ), stop.
Utdata skriv: ( ['prd: '] + ( a product ) ), stop.
a sortera: { :a :b <- (b - a). }.
a varje: { :i :e Utdata skriv: ( i - 0 ), stop. }.

} starta.



Program städa.
usedMemory3 := (Program minne ? 0).

( usedMemory1 = usedMemory2 och: usedMemory1 = usedMemory3, och: usedMemory2 = usedMemory3 ) sann: {
	Utdata skriv: ['No memory leaks here'].
}, falsk: {
	Utdata skriv: ['Leaking memory...'].
}.
