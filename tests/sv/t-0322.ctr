

>> Matryoshka := Objekt ny.
Matryoshka vid: ['double:'] gör: { :secret
	egen secret := secret × 2.
}.
Matryoshka vid: ['ny:'] gör: { :secret
	>> answer := Inget.
	>> t := (secret > 255).
	Utdata skriv: (secret + [' | '] + t), stop.
	t sann: {
		answer := secret.
	}, annars: {
		answer := Matryoshka rekursiv ny: (själv double: secret).
	}. <- answer.
}.

>> x := Matryoshka ny: 2.
