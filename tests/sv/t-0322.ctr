

>> Matrjosjka := Objekt ny.
Matrjosjka vid: ['double:'] gör: { :hemlighet
	egen hemlighet := hemlighet × 2.
}.
Matrjosjka vid: ['ny:'] gör: { :hemlighet
	>> svaret := Inget.
	>> t := (hemlighet > 255).
	Utdata skriv: (hemlighet + [' | '] + t), stop.
	t sann: {
		svaret := hemlighet.
	}, annars: {
		svaret := Matrjosjka rekursiv ny: (själv double: hemlighet).
	}. <- svaret.
}.

>> x := Matrjosjka ny: 2.
