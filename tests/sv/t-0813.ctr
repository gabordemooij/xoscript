# radbrytningar i värden får inte skapa extra huvuden
Server initiera.
Program använd: ['../../../src/xo/sv/webtools.xo'].
Program använd: ['../../../src/xo/sv/mailtools.xo'].

>> huvud := HTTP-Huvud ny nyckel: ['Location'] värde: ['/ok\r\nX-Injected: yes'].
Utdata skriv: huvud.

>> webb := Webbdokument ny.
webb gå-till: ['/ok\r\nX-Injected: yes'].
Utdata skriv: ['\n'], stop.

>> brev := E-post ny.
brev till: (Lista ny ; ['a@example.invalid\r\nX-To: yes']).
brev cc: (Lista ny ; ['b@example.invalid\r\nX-Cc: yes']).
brev bcc: (Lista ny ; ['c@example.invalid\r\nX-Bcc: yes']).
brev avsändare: ['d@example.invalid\r\nX-From: yes'] namn: ['site\r\nX-Name: yes'].
brev ämne: ['hello\r\nX-Subject: yes'].
brev meddelandetext: ['line1\r\nline2'].
Utdata skriv: brev generera.

>> html := HTML-E-post ny.
html till: (Lista ny ; ['a@example.invalid\r\nX-To: yes']).
html avsändare: ['d@example.invalid'] namn: ['webbplats'].
html ämne: ['hello\r\nX-Subject: yes'].
html meddelandetext: ['body'].
Utdata skriv: ( html generera innehåller: ['\nX-'] ), stop.
Utdata skriv: ( html generera innehåller: ['X-To: yes'] ), stop.
