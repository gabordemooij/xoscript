Utdata skriv: ['Continue for-loop, No - before 6 and up.'], stop.
{ :i
	Utdata skriv: (i + 1), stop.
	((i + 1) > 4) fortsätt.
	Utdata skriv: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Utdata stop.
Utdata skriv: ['Continue while-true, No --> before 5 and up.'], stop.
{
	Utdata skriv: ['iteration #'] + x, stop.
	x lägg-till: 1.
	((x < 5) inte) fortsätt.
	Utdata skriv: ['-->'].
} medan: xIsLessThan10.
Utdata stop.
Utdata skriv: ['Continue while-false, No - before 3 only.'], stop.
{
	Utdata skriv: ['iteration #'] + x, stop.
	x subtrahera: 1.
	(x = 3) fortsätt.
	Utdata skriv: ['-'].
} medan: { <- ( x > 0). }.

Utdata stop.
Utdata skriv: ['Continue times-loop, No ||| before 3.'], stop.
{ :i
	Utdata skriv: ['iteration #'] + i, stop.
	(i = 2) fortsätt.
	Utdata skriv: ['|||'].
} × 5.

Utdata stop.

{ Sann fortsätt. Utdata skriv: ['dont write this!'], stop. } starta.

{ Sann fortsätt. Utdata skriv: ['dont write this!'], stop. } fånga: { Utdata skriv: ['Dont catch this!']. }, starta.

Utdata skriv: ['Test Array each-loop: 0, ... ,2'], stop.
(Lista ← 1 ; 2 ; 3) avbilda: { :i
	(i = 1) fortsätt.
	Utdata skriv: ['iteration #'] + (i - 0), stop.
}.

Utdata skriv: ['Test Map each-loop: c only'], stop.
>> m := Ordbok ny.
m sätt: ['first'] vid: ['a'], sätt: ['second'] vid: ['b'], sätt: ['third'] vid: ['c'].
m varje: { :k :v
	(k ≠ ['c']) fortsätt.
	Utdata skriv: ['iteration'] + k + v, stop.
}.

