Utdata skriv: ['Fortsätt for-loop, Nej - före 6 och uppåt.'], stop.
{ :i
	Utdata skriv: (i + 1), stop.
	((i + 1) > 4) fortsätt.
	Utdata skriv: ['-'].
} × 10.

>> x := 0.
>> xÄrMindreÄn10 := { <- ( x < 10 ). }.
Utdata stop.
Utdata skriv: ['Fortsätt while-true, Nej --> före 5 och uppåt.'], stop.
{
	Utdata skriv: ['iteration #'] + x, stop.
	x lägg-till: 1.
	((x < 5) inte) fortsätt.
	Utdata skriv: ['-->'].
} medan: xÄrMindreÄn10.
Utdata stop.
Utdata skriv: ['Fortsätt while-false, Nej - bara före 3.'], stop.
{
	Utdata skriv: ['iteration #'] + x, stop.
	x subtrahera: 1.
	(x = 3) fortsätt.
	Utdata skriv: ['-'].
} medan: { <- ( x > 0). }.

Utdata stop.
Utdata skriv: ['Fortsätt times-loop, Nej ||| före 3.'], stop.
{ :i
	Utdata skriv: ['iteration #'] + i, stop.
	(i = 2) fortsätt.
	Utdata skriv: ['|||'].
} × 5.

Utdata stop.

{ Sann fortsätt. Utdata skriv: ['skriv inte detta!'], stop. } starta.

{ Sann fortsätt. Utdata skriv: ['skriv inte detta!'], stop. } fånga: { Utdata skriv: ['Fånga inte detta!']. }, starta.

Utdata skriv: ['Testa Lista each-loop: 0, ... ,2'], stop.
(Lista ← 1 ; 2 ; 3) avbilda: { :i
	(i = 1) fortsätt.
	Utdata skriv: ['iteration #'] + (i - 0), stop.
}.

Utdata skriv: ['Testa Ordbok each-loop: bara c'], stop.
>> m := Ordbok ny.
m sätt: ['first'] vid: ['a'], sätt: ['second'] vid: ['b'], sätt: ['tredje'] vid: ['c'].
m varje: { :k :v
	(k ≠ ['c']) fortsätt.
	Utdata skriv: ['iteration'] + k + v, stop.
}.

