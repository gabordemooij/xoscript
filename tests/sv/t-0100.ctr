Text vid: ['html'] gör: { <- (
		själv
		ersätt: ['&'] med: ['&amp;'],
		ersätt: ['<'] med: ['&lt;'],
		ersätt: ['>'] med: ['&gt;'],
		ersätt: ['"'] med: ['&quot;']
	).
}.

>> list := Lista ny.

['Verbatim Syntax'] tecken varje: { :tal :letter
	list ; ((['<li>#Number:Letter</li>']) Number: (tal), Letter: letter).
}.

Utdata list.





>> template := ['
<html>
<body>
<p>Hello this is a test!</p>
<p>The string \‘Verbatim Syntax\’ has: 15 code points...</p>
<ul>
[list]
</ul>
</body> 
</html>
'] [list]: (list sammanfoga: ['↵']).

