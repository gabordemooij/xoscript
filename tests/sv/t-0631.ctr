#ffi-test


Server init.

Program minneshantering: 4.

# för detta test måste du ange en sökväg till libc (puts)
>> biblnamn := Program inställning: ['FFITESTLIB'].



Server länka: (
 Lista ny ;
 biblnamn ;
 ['puts'] ;
 ( Lista ny ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s frigör.

# test med struct

>> a := Blob ny: 8.
a bytes: (
	Lista <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> strukt := Blob struct: (Lista <<: ['int'], ; ['int']).

Server länka: (
	Lista <<: ['@structtest'], ;
	['@structtest'] ;
	(Lista <<: strukt) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Utdata skriv: ['Summatest:'] + (ffitest ffisum: a), stop.

strukt frigör-struct.
strukt frigör.
a frigör.
