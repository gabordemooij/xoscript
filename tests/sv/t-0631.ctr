#ffi test


Server init.

Program minneshantering: 4.

# for this test you need set a path to libc (puts)
>> libname := Program inställning: ['FFITESTLIB'].



Server länka: (
 Lista ny ;
 libname ;
 ['puts'] ;
 ( Lista ny ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s frigör.

# test with struct

>> a := Blob ny: 8.
a bytes: (
	Lista <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Lista <<: ['int'], ; ['int']).

Server länka: (
	Lista <<: ['@structtest'], ;
	['@structtest'] ;
	(Lista <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Utdata skriv: ['Sum test:'] + (ffitest ffisum: a), stop.

struct frigör-struct.
struct frigör.
a frigör.
