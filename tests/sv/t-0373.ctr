# kompatibilitetstest

# använd internationella tal

Utdata skriv: ['1000 -> '].
Utdata skriv: 1000, stop. #1000

Utdata skriv: ['1.5 -> '].
Utdata skriv: 1.5, stop.  #1.5

Utdata skriv: ['1001.5 -> '].
Utdata skriv: 1.5 + 1000, stop. #1001.5

# använd 0-indexerade fält
>> x := Lista ny ; 1 ; 2 ; 3.
>> y := Lista ny ; ['a'] ; ['b'] ; ['c'].

Utdata skriv: ['1 -> '].
Utdata skriv: x ? 0, stop. #1

Utdata skriv: ['1 -> '].
Utdata skriv: (x vid: 0), stop. #1

Utdata skriv: ['1 -> '].
Utdata skriv: x första, stop. #1

Utdata skriv: ['3 -> '].
Utdata skriv: x sista, stop. #3

Utdata skriv: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Utdata skriv: (x efter: y), stop.

Utdata skriv: ['1 -> '].
Utdata skriv: (x från: 0 längd: 1) första, stop. #1

Utdata skriv: ['0 -> '].
Utdata skriv: (x hitta: 1), stop. #0

x sätt: 9 vid: 0.

Utdata skriv: ['9 -> '].
Utdata skriv: (x vid: 0), stop. #9

x lägg-till-först: 8.
Utdata skriv: ['8 -> '].
Utdata skriv: (x vid: 0), stop. #9


x lägg-till-sist: 10.
Utdata skriv: ['10 -> '].
Utdata skriv: (x vid: 4), stop. #10








