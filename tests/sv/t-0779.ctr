Utdata skriv: ['Testobjekt'], stop.
>> p := Sökväg /tmp.
Utdata skriv: p, stop.
>> gammal-p-adress := p prototyp minnesadress.
p save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== LADDAR OM SNAP:'], stop.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b prototyp minnesadress = gammal-p-adress) sann: {
	Utdata skriv: ['Objektlänk återkopplad.'], stop.
}.
Utdata skriv: b, stop.
