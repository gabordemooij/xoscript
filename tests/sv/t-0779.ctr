Utdata skriv: ['Test object'], stop.
>> p := Sökväg /tmp.
Utdata skriv: p, stop.
>> old-p-address := p prototyp minnesadress.
p save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== RELOADING SNAP:'], stop.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b prototyp minnesadress = old-p-address) sann: {
	Utdata skriv: ['Object link re-attached.'], stop.
}.
Utdata skriv: b, stop.
