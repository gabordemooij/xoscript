>> map1 := Ordbok ny.
>> key1 := Lista ny.
>> key2 := Lista ny.

map1
	sätt: ['hello'] vid: key1,
	sätt: ['world'] vid: key2.


Utdata
	skriv: ['Map #1 contains: '] + (map1 vid: key1),
	skriv: [' and '] + (map1 vid: key2), stop.

>> KeyeableArray := Lista ny.
KeyeableArray vid: ['toString'] gör: { <- (själv antal) toString.
}.

>> map2 := Ordbok ny.
key1 := KeyeableArray ny.
key2 := KeyeableArray ny.

key1 lägg-till-sist: 1.

map2
	sätt: ['hello'] vid: key1,
	sätt: ['world'] vid: key2.

Utdata
	skriv: ['Map #2 contains: '] + (map2 vid: key1),
	skriv: [' and '] + (map2 vid: key2), stop.
