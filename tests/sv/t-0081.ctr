>> karta1 := Ordbok ny.
>> nyckel1 := Lista ny.
>> nyckel2 := Lista ny.

karta1
	sätt: ['hello'] vid: nyckel1,
	sätt: ['world'] vid: nyckel2.


Utdata
	skriv: ['Map #1 contains: '] + (karta1 vid: nyckel1),
	skriv: [' och '] + (karta1 vid: nyckel2), stop.

>> NyckelbarLista := Lista ny.
NyckelbarLista vid: ['tillText'] gör: { <- (själv antal) tillText.
}.

>> map2 := Ordbok ny.
nyckel1 := NyckelbarLista ny.
nyckel2 := NyckelbarLista ny.

nyckel1 lägg-till-sist: 1.

map2
	sätt: ['hello'] vid: nyckel1,
	sätt: ['world'] vid: nyckel2.

Utdata
	skriv: ['Map #2 contains: '] + (map2 vid: nyckel1),
	skriv: [' och '] + (map2 vid: nyckel2), stop.
