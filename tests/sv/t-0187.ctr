Tal vid: ['fakultet'] gör: {
	>> totalt := 1.
	{ :index totalt multiplicera-med: (själv - index). } × själv. <- totalt.
}.

>> använtMinne1 := 0.
>> använtMinne2 := 0.
>> använtMinne3 := 0.
>> använtMinne4 := 0.

Program minneshantering: 0.

{
2 exponent fakultet.
Utdata skriv: (11 modulo: 3), stop.
Utdata skriv: (3.4 avrunda), stop.
Utdata skriv: (7.1 avrunda-uppåt), stop.
Utdata skriv: (7.9 avrunda-nedåt), stop.
}
starta.

Program städa.

använtMinne1 := (Program minne ? 0).

{
2 exponent fakultet.
Utdata skriv: (11 modulo: 3), stop.
Utdata skriv: (3.4 avrunda), stop.
Utdata skriv: (7.1 avrunda-uppåt), stop.
Utdata skriv: (7.9 avrunda-nedåt), stop.
}
starta.

Program städa.
använtMinne2 := (Program minne ? 0).


{
2 exponent fakultet.
Utdata skriv: (11 modulo: 3), stop.
Utdata skriv: (3.4 avrunda), stop.
Utdata skriv: (7.1 avrunda-uppåt), stop.
Utdata skriv: (7.9 avrunda-nedåt), stop.
} starta.

Program städa.
använtMinne3 := (Program minne ? 0).



( använtMinne1 = använtMinne2 och: använtMinne1 = använtMinne3, och: använtMinne2 = använtMinne3 ) sann: {
	Utdata skriv: ['Inga minnesläckor här'].
}, falsk: {
	Utdata skriv: ['Läcker minne...'].
}.
