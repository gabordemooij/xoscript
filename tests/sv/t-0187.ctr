Tal vid: ['factorial'] gör: {
	>> total := 1.
	{ :index total multiplicera-med: (själv - index). } × själv. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program minneshantering: 0.

{
2 exponent factorial.
Utdata skriv: (11 modulo: 3), stop.
Utdata skriv: (3.4 avrunda), stop.
Utdata skriv: (7.1 avrunda-uppåt), stop.
Utdata skriv: (7.9 avrunda-nedåt), stop.
}
starta.

Program städa.

usedMemory1 := (Program minne ? 0).

{
2 exponent factorial.
Utdata skriv: (11 modulo: 3), stop.
Utdata skriv: (3.4 avrunda), stop.
Utdata skriv: (7.1 avrunda-uppåt), stop.
Utdata skriv: (7.9 avrunda-nedåt), stop.
}
starta.

Program städa.
usedMemory2 := (Program minne ? 0).


{
2 exponent factorial.
Utdata skriv: (11 modulo: 3), stop.
Utdata skriv: (3.4 avrunda), stop.
Utdata skriv: (7.1 avrunda-uppåt), stop.
Utdata skriv: (7.9 avrunda-nedåt), stop.
} starta.

Program städa.
usedMemory3 := (Program minne ? 0).



( usedMemory1 = usedMemory2 och: usedMemory1 = usedMemory3, och: usedMemory2 = usedMemory3 ) sann: {
	Utdata skriv: ['No memory leaks here'].
}, falsk: {
	Utdata skriv: ['Leaking memory...'].
}.
