

>> använtMinne1 := 0.
>> använtMinne2 := 0.
>> använtMinne3 := 0.
>> använtMinne4 := 0.

Program minneshantering: 0.

Tal vid: ['addNum:'] gör: { :x
	själv lägg-till: x.
}.

Tal vid: ['subtractNum:'] gör: { :x
	själv subtrahera: x.
}.

Tal vid: ['multiplyBy:'] gör: { :x
	själv multiplicera-med: x.
}.

Tal vid: ['divideBy:'] gör: { :x
	själv dela-med: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 upphöjt: 8).  
a := a + (2 upphöjt: -1). 
a := a + (49 kvadratrot).   
a addNum: ((Lista ← 0 ; 1) maximum).          
a addNum: ((Lista ← 2 ; 3) minimum).
Utdata skriv: a.

Program städa.

använtMinne1 := (Program minne ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 upphöjt: 8).  
a := a + (2 upphöjt: -1). 
a := a + (49 kvadratrot).   
a addNum: ((Lista ← 0 ; 1) maximum).          
a addNum: ((Lista ← 2 ; 3) minimum).
Utdata skriv: a.

Program städa.
använtMinne2 := (Program minne ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 upphöjt: 8).  
a := a + (2 upphöjt: -1). 
a := a + (49 kvadratrot).   
a addNum: ((Lista ← 0 ; 1) maximum).          
a addNum: ((Lista ← 2 ; 3) minimum).
Utdata skriv: a.

Program städa.
använtMinne3 := (Program minne ? 0).



( använtMinne1 = använtMinne2 och: använtMinne1 = använtMinne3, och: använtMinne2 = använtMinne3 ) sann: {
	Utdata skriv: ['Inga minnesläckor här'].
}, falsk: {
	Utdata skriv: ['Läcker minne...'].
}.
