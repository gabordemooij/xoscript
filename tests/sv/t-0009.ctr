>> Hälsare := Objekt ny.
Hälsare vid: ['skapa'] gör: {
	>> hälsare := Objekt ny.
	hälsare vid: ['name:'] gör: { :namn
		Utdata skriv: ['sätter ett namn'].
		egen mittNamn := namn.
	}.
	hälsare vid: ['utförHälsning'] gör: {
		Utdata skriv: ['Hello'].
		Utdata skriv: egen mittNamn.
	}.
	hälsare vid: ['hälsa'] gör: {
		själv utförHälsning.
	}. <- hälsare.
}.
>> hälsare := Hälsare skapa.
hälsare name: ['solsken!'].
hälsare hälsa.
