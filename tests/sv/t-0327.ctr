

Lista vid: ['fixture:'] gör: { :f
	egen fixture := f.
}.

Lista vid: ['antal'] gör: { <- egen fixture.
}.

Lista vid: ['aantal'] gör: { <- egen fixture.
}.


>> x := Inget.
{

	x := ['hello'] 
	ersätt:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] tecken: 2)
			)
		)
	med: (
		(['...hal'] + ['lo']) 
			versaler 
			lowecase 
			versaler 
			offset: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Lista ← 0 ; 1 ; 4; 9 ; (Lista ← 0 ; 3; 1) ; 4
							) näst-sista
						) ? 1
					) + 
					((Lista ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					antal
				)
			)
	).

} × 10.
Utdata skriv: x, stop.

