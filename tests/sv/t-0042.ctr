>> items := Ordbok ny.
items sätt: ['black'] vid: ['coffee'], sätt: ['earl grey'] vid: ['tea'].
Utdata skriv: (items vid: ['coffee']), skriv: (items vid: ['tea']).
Utdata skriv: ['there are'] + items antal + [' items in the array.'].
items sätt: ['capuccino'] vid: ['coffee'].
Utdata skriv: ['Now my coffee is.. '] + (items vid: ['coffee']).
items sätt: ['aaa'] vid: ['1'].
items sätt: ['bbb'] vid: ['2'].
Utdata skriv: (items vid: ['a']).
