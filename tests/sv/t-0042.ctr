>> items := Ordbok ny.
items sätt: ['svart'] vid: ['coffee'], sätt: ['earl grey'] vid: ['te'].
Utdata skriv: (items vid: ['coffee']), skriv: (items vid: ['te']).
Utdata skriv: ['det finns'] + items antal + [' element i listan.'].
items sätt: ['cappuccino'] vid: ['coffee'].
Utdata skriv: ['Nu är mitt kaffe.. '] + (items vid: ['coffee']).
items sätt: ['aaa'] vid: ['1'].
items sätt: ['bbb'] vid: ['2'].
Utdata skriv: (items vid: ['a']).
