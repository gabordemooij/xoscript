# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Valv generera-nycklar.

# private (secret) key
>> sk := keys första.

# public key
>> pk := keys sista.

# sign a message
>> sig := Valv signera: ['abc'] med: sk.

# check message (ok)
Utdata skriv: ( 
	Valv
		kontrollera: ['abc'] 
		signatur: sig 
		med: pk 
), stop.

# check message (fail)
Utdata skriv: ( 
	Valv 
		kontrollera: ['abd'] 
		signatur: sig 
		med: pk 
), stop.