>> z := Objekt ny.
z vid: ['value:'] gör: { :v
	egen value := v. <- själv.
}.
z vid: ['value'] gör: { <- egen value. }.
(z setValue: 1) value: 2.
Utdata skriv: z value.
>> x := z.
Utdata skriv: x value.
z := Inget.
Utdata skriv: z value.
Utdata skriv: x value.
Utdata skriv: ['hello'].
Utdata skriv: 3 + 2.
Utdata skriv: (3 > 2).
