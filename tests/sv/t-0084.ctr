>> skapaAdderare := { :x
	>> f := { :y <- (egen x + y). } sätt: ['x'] värde: x. <- f.
}.
>> mappare := { :fält :fnk
	>> avbildning := { :i egen q sätt: (egen f tillämpa: (egen q ? i)) vid: i. } 
	sätt: ['q'] värde: fält,
	sätt: ['f'] värde: fnk.
	{ :i avbildning tillämpa: i. } × (fält antal).
}.

>> a := Lista ← 1; 2; 3.
mappare tillämpa: a och: (skapaAdderare tillämpa: 100).
Utdata skriv: (a position: 0), stop.
Utdata skriv: (a ? 1), stop.
Utdata skriv: (a ? 2), stop.
