>> makeAdder := { :x
	>> f := { :y <- (egen x + y). } sätt: ['x'] värde: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i egen q sätt: (egen f tillämpa: (egen q ? i)) vid: i. } 
	sätt: ['q'] värde: array,
	sätt: ['f'] värde: func.
	{ :i mapping tillämpa: i. } × (array antal).
}.

>> a := Lista ← 1; 2; 3.
mapper tillämpa: a och: (makeAdder tillämpa: 100).
Utdata skriv: (a position: 0), stop.
Utdata skriv: (a ? 1), stop.
Utdata skriv: (a ? 2), stop.
