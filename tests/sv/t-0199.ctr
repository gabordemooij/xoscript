
Program minneshantering: 4.

>> Djur := Objekt ny.
Djur vid: ['skapa'] gör: {
	>> djur := Objekt ny.
	djur vid: ['görLäte'] gör: {
		Utdata skriv: egen läte.
	}. <- djur.
}.
>> Katt := Objekt ny.
Katt vid: ['skapa'] gör: {
	>> katt := Djur skapa.
	katt vid: ['init'] gör: {
		egen läte := ['meow!'].
	}.
	katt init. <- katt.
}.
>> tom := Katt skapa.
tom görLäte.
