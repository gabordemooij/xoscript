
Program minneshantering: 4.

>> Animal := Objekt ny.
Animal vid: ['make'] gör: {
	>> animal := Objekt ny.
	animal vid: ['makeSound'] gör: {
		Utdata skriv: egen sound.
	}. <- animal.
}.
>> Cat := Objekt ny.
Cat vid: ['make'] gör: {
	>> cat := Animal make.
	cat vid: ['init'] gör: {
		egen sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
