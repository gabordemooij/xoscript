Lista vid: ['summa'] gör: {
	>> totalt := 0.
	själv varje: { :index :elementet
		totalt lägg-till: elementet.
	}. <- totalt.
}.

>> a := Sann.



a vid: ['text'] gör: {
	>> svaret := Inget.
	( själv = Sann ) sann: {
		svaret := ['Japp'].
	}, annars: {
		svaret := ['Nä'].
	}. <- svaret.
}.

a vid: ['tal'] gör: {
	>> svaret := Inget.
	( själv = Sann ) sann: {
		svaret := 10.
	}, annars: {
		svaret := 20.
	}. <- svaret.
}.

>> b := 666.

b vid: ['text'] gör: { <- ['Djävul'].
}.

b vid: ['boolesk'] gör: { <- Falsk.
}.


Utdata skriv: a, stop.  
Utdata skriv: (90 + a), stop. 
Utdata skriv: b, stop. 
Utdata skriv: (Sann och: b), stop.

a := Lista ← ['hello'] ; ['world'] ; Sann ; Inget ; 666. 
a := a + ( Lista ← 1 ).
Utdata skriv: a, stop.
Utdata skriv: ((Ordbok ny) sätt: Inget vid: Inget), stop.
Utdata skriv: a summa, stop. 


{
	a vid: ['text'] gör: { <- Inget. }.
	a := [''] + a.
} fånga: { :felet
	Utdata skriv: ['Fel noterat: '] + felet, stop.
}, starta.



{
	a vid: ['tal'] gör: { <- Inget. }.
	a := 3 × a.
} fånga: { :felet
	Utdata skriv: ['Fel noterat: '] + felet, stop.
}, starta.


{
	a vid: ['boolesk'] gör: { <- Inget. }.
	a := Sann och: a. 
} fånga: { :felet
	Utdata skriv: ['Fel noterat: '] + felet, stop.
}, starta.





{
	a vid: ['text'] gör: { <- Falsk. }.
	a := [''] + a.
} fånga: { :felet
	Utdata skriv: ['Fel noterat: '] + felet, stop.
}, starta.



{
	a vid: ['tal'] gör: { <- Sann. }.
	a := 3 × a.
} fånga: { :felet
	Utdata skriv: ['Fel noterat: '] + felet, stop.
}, starta.


{
	a vid: ['boolean'] gör: { <- 1. }.
	a := Sann och: a.
} fånga: { :felet
	Utdata skriv: ['Fel noterat: '] + felet, stop.
}, starta.





