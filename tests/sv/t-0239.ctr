Lista vid: ['sum'] gör: {
	>> total := 0.
	själv varje: { :index :element
		total lägg-till: element.
	}. <- total.
}.

>> a := Sann.



a vid: ['text'] gör: {
	>> answer := Inget.
	( själv = Sann ) sann: {
		answer := ['Yep'].
	}, annars: {
		answer := ['Nope'].
	}. <- answer.
}.

a vid: ['tal'] gör: {
	>> answer := Inget.
	( själv = Sann ) sann: {
		answer := 10.
	}, annars: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b vid: ['text'] gör: { <- ['Devil'].
}.

b vid: ['boolesk'] gör: { <- Falsk.
}.


Utdata skriv: a, stop.  
Utdata skriv: (90 + a), stop. 
Utdata skriv: b, stop. 
Utdata skriv: (Sann och: b), stop.

a := Lista ← ['hello'] ; ['world'] ; Sann ; Inget ; 666. 
a := a + ( Lista ← 1 ).
Utdata skriv: a, stop.
Utdata skriv: ((Ordbok ny) sätt: Inget vid: Inget), stop.
Utdata skriv: a sum, stop. 


{
	a vid: ['text'] gör: { <- Inget. }.
	a := [''] + a.
} fånga: { :error
	Utdata skriv: ['Error noted: '] + error, stop.
}, starta.



{
	a vid: ['tal'] gör: { <- Inget. }.
	a := 3 × a.
} fånga: { :error
	Utdata skriv: ['Error noted: '] + error, stop.
}, starta.


{
	a vid: ['boolesk'] gör: { <- Inget. }.
	a := Sann och: a. 
} fånga: { :error
	Utdata skriv: ['Error noted: '] + error, stop.
}, starta.





{
	a vid: ['text'] gör: { <- Falsk. }.
	a := [''] + a.
} fånga: { :error
	Utdata skriv: ['Error noted: '] + error, stop.
}, starta.



{
	a vid: ['tal'] gör: { <- Sann. }.
	a := 3 × a.
} fånga: { :error
	Utdata skriv: ['Error noted: '] + error, stop.
}, starta.


{
	a vid: ['boolean'] gör: { <- 1. }.
	a := Sann och: a.
} fånga: { :error
	Utdata skriv: ['Error noted: '] + error, stop.
}, starta.





{
	a vid: ['text'] gör: { <- 1. }.
