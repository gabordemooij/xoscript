	a := 3 × a.
} fånga: { :felet
	Utdata skriv: ['Fel noterat: '] + felet, stop.
}, starta.


{
	a vid: ['boolean'] gör: { <- ['']. }.
	a := Sann och: a.
} fånga: { :felet
	Utdata skriv: ['Fel noterat: '] + felet, stop.
}, starta.






{
	a vid: ['text'] gör: { <- (Ordbok ny). }.
	a := [''] + a. 
} fånga: { :felet
	Utdata skriv: ['Fel noterat: '] + felet, stop.
}, starta.



