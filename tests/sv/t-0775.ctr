Utdata skriv: ['Test object'], stop.
>> l := Lista ny ; 1 ; ( Lista ny ; (Moment ny: 1) ; (Int64 från-text: ['321']) ; (Lista ny ; 3)).
Utdata skriv: l, stop.
>> old-lst-address := l prototyp minnesadress.
l save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== RELOADING SNAP:'], stop.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b prototyp minnesadress = old-lst-address) sann: {
	Utdata skriv: ['Object link re-attached.'], stop.
}.
Utdata skriv: b, stop.
