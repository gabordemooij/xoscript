Utdata skriv: ['Test object'], stop.
>> a := Objekt ny. 

a vid: ['item:'] gör: { :nil
	egen nil := nil. 
}.

a vid: ['item'] gör: { <- egen nil.
}.

a item: Inget.

Utdata skriv: a item, stop.

>> old-nil-address := a item prototyp minnesadress.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== RELOADING SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp minnesadress = old-nil-address) sann: {
	Utdata skriv: ['Object link re-attached.'], stop.
}.

Utdata skriv: b item, stop.
