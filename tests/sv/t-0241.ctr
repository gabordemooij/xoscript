

Text vid: ['utvärdera'] gör: {
	>> code := Fil ny: ['/tmp/eval.ctr'].
	code skriv: (själv text + ['.']).
	Program använd: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Lista ← (['Citattecken '] + Q + [' är onda?']) ; 1.
>> x := q text.
Utdata skriv: x, stop.
>> y := Inget.
(['y := '] + x ) utvärdera.
Utdata skriv: y ? 0, stop.

q := Ordbok sätt: ['\[''] vid: ['\['quote\']'].
x := q text.
Utdata skriv: x, stop.
y := Inget.
(['y := '] + x ) utvärdera.

>> q := (Ordbok ny) sätt:['\[''] vid:['\['quote\[''].
Utdata skriv: y ? ['\['quote\']'], stop.
