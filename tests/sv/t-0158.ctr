>> x := [' hallo '].

>> y := x versaler.
Utdata skriv: x, stop.
Utdata skriv: (x lika-med: y), stop.

>> y := x gemener.
Utdata skriv: x, stop.
Utdata skriv: (x lika-med: y), stop.

>> y := x trimma.
Utdata skriv: x, stop.
Utdata skriv: (x lika-med: y), stop.

>> y := x offset: 1.
Utdata skriv: x, stop.
Utdata skriv: (x lika-med: y), stop.

>> y := x från: 1 längd: 2.
Utdata skriv: x, stop.
Utdata skriv: (x lika-med: y), stop.