Server init.

>> db := Maria-DB ny värd: ['localhost'],
	användarnamn: ['xo'],
	lösenord: ['pass123'],
	databasnamn: ['xobase'],
	anslut.

>> del := db fråga: ['DELETE FROM book WHERE id > 0'].
{  del utför. db bekräfta. } fånga: { :e db återställ.  }, starta.

>> antal := db fråga: ['SELECT COUNT(*) AS num FROM book'].
antal hämta: { :row Utdata skriv: row num, stop. }.
