#Linux
>> OS := Program inställning: ['OS'].

>> klocka := Moment ny.
	
(OS = ['Haiku']) sann: {
	klocka zon: ['CET'],
	år: 2017, månad: 7, dag: 13,
	timme: 18, minut: 0, sekund: 0.
}, annars: {
	klocka zon: ['Europe/Amsterdam'],
	år: 2017, månad: 7, dag: 13,
	timme: 18, minut: 0, sekund: 0.
}.

klocka vid: ['berätta'] gör: {
	Utdata skriv: själv, stop.
}.


klocka lägg-till: 2    timme, berätta.
klocka lägg-till: 1    timme, berätta.
klocka lägg-till: 19 minut, berätta.
klocka lägg-till: 1  minut, berätta.
klocka lägg-till: 1  minut, berätta.
klocka lägg-till: 19 sekund, berätta.
klocka lägg-till: 1  sekund, berätta.
klocka lägg-till: 1  sekund, berätta.
klocka lägg-till: 2    år, berätta.
klocka lägg-till: 1    år, berätta.

(OS = ['Haiku']) sann: {
klocka lägg-till: 5   månad.
klocka zon: ['CEST'], berätta.
}, annars: {
	klocka lägg-till: 5   månad, berätta.
}.

klocka lägg-till: 1   månad, berätta.
klocka lägg-till: 19    dag, berätta.
klocka lägg-till: 1    timme, berätta.
klocka lägg-till: 120  yard, berätta.
