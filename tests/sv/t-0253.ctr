#Linux
>> OS := Program inställning: ['OS'].

>> clock := Moment ny.
	
(OS = ['Haiku']) sann: {
	clock zon: ['CET'],
	år: 2017, månad: 7, dag: 13,
	timme: 18, minut: 0, sekund: 0.
}, annars: {
	clock zon: ['Europe/Amsterdam'],
	år: 2017, månad: 7, dag: 13,
	timme: 18, minut: 0, sekund: 0.
}.

clock vid: ['tell'] gör: {
	Utdata skriv: själv, stop.
}.


clock lägg-till: 2    timme, tell.
clock lägg-till: 1    timme, tell.
clock lägg-till: 19 minut, tell.
clock lägg-till: 1  minut, tell.
clock lägg-till: 1  minut, tell.
clock lägg-till: 19 sekund, tell.
clock lägg-till: 1  sekund, tell.
clock lägg-till: 1  sekund, tell.
clock lägg-till: 2    år, tell.
clock lägg-till: 1    år, tell.

(OS = ['Haiku']) sann: {
clock lägg-till: 5   månad.
clock zon: ['CEST'], tell.
}, annars: {
	clock lägg-till: 5   månad, tell.
}.

clock lägg-till: 1   månad, tell.
clock lägg-till: 19    dag, tell.
clock lägg-till: 1    timme, tell.
clock lägg-till: 120  yard, tell.
