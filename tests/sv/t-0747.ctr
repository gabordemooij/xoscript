Utdata skriv: ['Test object'], stop.
>> a := Objekt ny. 

a vid: ['item:'] gör: { :num
	egen num := num. 
}.

a vid: ['item'] gör: { <- egen num.
}.

a item: 123.

Utdata skriv: a item, stop.

>> old-num-address := a item prototyp minnesadress.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== RELOADING SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp minnesadress = old-num-address) sann: {
	Utdata skriv: ['Object link re-attached.'], stop.
}.

Utdata skriv: b item, stop.
