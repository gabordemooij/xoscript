Program minneshantering: 0.
Lista vid: ['summa'] gör: {
	>> totalt := 0.
	själv varje: { :index :elementet
		totalt lägg-till: elementet.
	}. <- totalt.
}.

>> använtMinne1 := 0.
>> använtMinne2 := 0.
>> använtMinne3 := 0.
>> använtMinne4 := 0.



>> f := Fil ny: ['/tmp/test.txt'].
f skriv: ['Lorem Ipsum'].
f stäng.
  

f := Fil ny: ['/tmp/test.txt'].
>> texten := f läs.
f stäng.



Program städa.
använtMinne1 := (Program minne ? 1).



f := Fil ny: ['/tmp/test.txt'].
texten := f läs.
f stäng.

Program städa.
använtMinne2 := (Program minne ? 1).


f := Fil ny: ['/tmp/test.txt'].
texten := f läs.
f stäng.

Program städa.
använtMinne3 := (Program minne ? 1).



( använtMinne1 = använtMinne2 och: använtMinne1 = använtMinne3, och: använtMinne2 = använtMinne3 ) sann: {
	Utdata skriv: ['Inga minnesläckor här'].
}, falsk: {
	Utdata skriv: ['Läcker minne...'].
}.
