
Text vid: ['evaluate'] gör: {
	>> code := Fil ny: ['/tmp/eval.ctr'].
	code skriv: (själv text + ['.']).
	Program använd: ['/tmp/eval.ctr'].
}.

>> map :=
	(Ordbok ny)
	sätt: ['Hi There'] vid: ['two'],
	sätt: (Lista ← ['hello'] ; ['world'] ; (Lista ← 1 ; 2; 9) ; Falsk) vid: ['one'],
	sätt: ( (Ordbok ny) sätt: ['wrrld'] vid: ['misspelled'] ) vid: ['three'],
	sätt: (Lista ← ((Ordbok ny) sätt: ['treasure'] vid: ['hidden']) ; 2) vid: ['four']. 
>> str := map text.
>> map2 := Inget.
(['map2 := '] + str ) evaluate.
Utdata skriv: map2 ? ['one'] ? 0.
Utdata skriv: map2 ? ['one'] ? 1.
Utdata skriv: map2 ? ['four'] ? 0 ? ['hidden'].
Utdata skriv: map2 ? ['one'] ? 2 ? 2.
