
Text vid: ['utvärdera'] gör: {
	>> code := Fil ny: ['/tmp/eval.ctr'].
	code skriv: (själv text + ['.']).
	Program använd: ['/tmp/eval.ctr'].
}.

>> map :=
	(Ordbok ny)
	sätt: ['Hej Där'] vid: ['two'],
	sätt: (Lista ← ['hello'] ; ['world'] ; (Lista ← 1 ; 2; 9) ; Falsk) vid: ['ett'],
	sätt: ( (Ordbok ny) sätt: ['vrrlden'] vid: ['felstavat'] ) vid: ['three'],
	sätt: (Lista ← ((Ordbok ny) sätt: ['skatt'] vid: ['gömd']) ; 2) vid: ['fyra']. 
>> str := map text.
>> map2 := Inget.
(['map2 := '] + str ) utvärdera.
Utdata skriv: map2 ? ['ett'] ? 0.
Utdata skriv: map2 ? ['ett'] ? 1.
Utdata skriv: map2 ? ['fyra'] ? 0 ? ['gömd'].
Utdata skriv: map2 ? ['ett'] ? 2 ? 2.
