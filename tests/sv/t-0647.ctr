Server init.
Utdata skriv: ['Database time test'], stop.

>> db := Maria-DB ny värd: ['localhost'],
	användarnamn: ['xo'], 
	lösenord: ['pass123'],
	databasnamn: ['xobase'],
	anslut.

>> sökparametrar :=
db fråga: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
hämta: { :row
	Utdata skriv: row timetest, stop.
}.
