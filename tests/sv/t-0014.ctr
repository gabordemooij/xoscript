>> Hälsare := Objekt ny.
Hälsare vid: ['skapa'] gör: {
	>> hl := Objekt ny.
	hl vid: ['setName:'] gör: { :ettNamn
		egen namn := ettNamn.
	}.
	hl vid: ['hälsa'] gör: {
		Utdata skriv: egen namn.
	}. <- hl.
}.
>> a := Hälsare skapa.
>> b := Hälsare skapa.
a setName: ['ETT'].
b setName: ['TVÅ'].
a hälsa.
b hälsa.
>> c := a ny.
c setName: ['TRE'].
c hälsa.
>> d := a ny.
d setName: ['FYRA'].
d hälsa.
c hälsa.
