>> Greeter := Objekt ny.
Greeter vid: ['make'] gör: {
	>> gr := Objekt ny.
	gr vid: ['setName:'] gör: { :aname
		egen namn := aname.
	}.
	gr vid: ['greet'] gör: {
		Utdata skriv: egen namn.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a ny.
c setName: ['THREE'].
c greet.
>> d := a ny.
d setName: ['FOUR'].
d greet.
c greet.
