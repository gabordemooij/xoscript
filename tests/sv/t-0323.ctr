

Program städa.


>> Veggy := Objekt ny.
Veggy vid: ['ny'] gör: {
	>> v := själv ny.
	v init. <- v.
}.

Veggy vid: ['init'] gör: { egen veggies := 0. }.

Veggy vid: ['carrots:'] gör: { :a egen veggies := a. <- Inget. }.
Veggy vid: ['carrots'] gör: { <- egen veggies. }.
Veggy vid: ['+'] gör: { :f
	>> n := Veggy ny.
	n carrots: (f carrots + egen veggies). <- n.
}.

Veggy vid: ['text'] gör: { <- egen veggies text.
}.

Tal vid: ['carrots'] gör: {
	>> x := Veggy ny.
	x carrots: själv. <- x.
}.

Tal vid: ['add:and:'] gör: { :a :b <- (a + b).
}.

>> q := 0 add: (3 carrots + 2 carrots) and: 4 carrots.
Utdata skriv: q, stop.
