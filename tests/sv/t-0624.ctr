# Detta test kontrollerar att string_fill_in inte förlorar sin plats (gc'ed) i läge 4
# referens i world.c
>> Logg := Objekt ny.

Logg vid: ['say:'] gör: { :str
	Utdata skriv: str, stop.
}.

>> Artikel := Objekt ny.

Artikel vid: ['ny:'] gör: { :id
	<- själv ny id: id.
}.

Artikel vid: ['id:'] gör: { :id
	egen id := id.
}.

Artikel vid: ['id'] gör: { <- egen id. }.


Artikel vid: ['text'] gör: {
	>> str := ['Item#~no'].
	str ~no: egen id.
	<- str.
}.


>> Print := Objekt ny.

Print vid: ['items'] gör: { 
	
	egen artikel := Artikel ny: 1.
	
	# antingen segfault eller fel str här
	Logg say: (
		['~item printed.'] ~item: egen artikel
	).
	
	
}.

Print items.