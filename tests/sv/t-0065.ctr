Tal vid: ['fakultet'] gör: {
	>> totalt := 1.
	{ :index totalt multiplicera-med: (själv - (index)). } × själv. <- totalt.
}.
>> Skrivare := Objekt ny.
Skrivare vid: ['skrivut:och:'] gör: { :x :y
	Utdata skriv: ['a='] + x + [', b='] + y, stop.
}.
>> a := 4.5. >> b := a avrunda-nedåt.
Skrivare skrivut: a och: b.
a := 4. b := a fakultet.
Skrivare skrivut: a och: b.
a := 4.5. b := a avrunda-uppåt.
Skrivare skrivut: a och: b.
a := 4.5. b := a avrunda-nedåt.
Skrivare skrivut: a och: b.
a := 4.5. b := a avrunda.
Skrivare skrivut: a och: b.
a := 4.2. b := a avrunda.
Skrivare skrivut: a och: b.

Utdata skriv: (9 modulo: 5), stop.
Utdata skriv: -666 absolut, stop.
Utdata skriv: 49 kvadratrot, stop.
Utdata skriv: (2 upphöjt: 3), stop.
>> l := (Lista ← 9 ; 6).
Utdata skriv: l minimum.

