# lyckat flöde
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> sökväg := ['/tmp/dat.csv'].
>> csv := Fil ny: sökväg.
csv skriv: s.

# accepterar CRLF LF CR, varierande radlängd
csv avgränsare: [';'] citattecken: ['"'] rader: { :line
	Program städa.
	Utdata skriv: line, stop.
	Program städa.
}.

# olika långa rader
s lägg-till-sist: ['\njustone'].
csv skriv: s.
{
	csv avgränsare: [';'] citattecken: ['"'] rader: { :line
		Utdata skriv: line, stop.
	}.
} fånga: { :e 
	Utdata skriv: e, stop.
}, starta.

# ogiltigt format
s := ['"he"llo";world'].
csv skriv: s.
{
	csv avgränsare: [';'] citattecken: ['"'] rader: { :line
		Utdata skriv: line, stop.
	}.
} fånga: { :e 
	Utdata skriv: e, stop.
}, starta.
