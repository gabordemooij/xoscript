# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> sökväg := ['/tmp/dat.csv'].
>> csv := Fil ny: sökväg.
csv skriv: s.

# accepts CRLF LF CR, varying row length
csv avgränsare: [';'] citattecken: ['"'] rader: { :line
	Program städa.
	Utdata skriv: line, stop.
	Program städa.
}.

# unequal lines
s lägg-till-sist: ['\njustone'].
csv skriv: s.
{
	csv avgränsare: [';'] citattecken: ['"'] rader: { :line
		Utdata skriv: line, stop.
	}.
} fånga: { :e 
	Utdata skriv: e, stop.
}, starta.

# invalid format
s := ['"he"llo";world'].
csv skriv: s.
{
	csv avgränsare: [';'] citattecken: ['"'] rader: { :line
		Utdata skriv: line, stop.
	}.
} fånga: { :e 
	Utdata skriv: e, stop.
}, starta.
