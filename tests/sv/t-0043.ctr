>> upprepare := Objekt ny.
upprepare vid: ['svara:'] gör: { :vad
	Utdata skriv: vad + [' '].
}.
upprepare vid: ['svara:och:'] gör: { :vad :say
	Utdata skriv: vad, skriv: say + [' '].
}.
upprepare vid: ['svara:och:och:'] gör: { :vad :say :mer
	Utdata skriv: vad, skriv: say, skriv: mer.
}.
upprepare upprepa.
upprepare everything: ['Jag säger.'].
upprepare and: ['I '] everything: ['gör.'].
