>> repeater := Objekt ny.
repeater vid: ['svara:'] gör: { :what
	Utdata skriv: what + [' '].
}.
repeater vid: ['svara:och:'] gör: { :what :say
	Utdata skriv: what, skriv: say + [' '].
}.
repeater vid: ['svara:och:och:'] gör: { :what :say :more
	Utdata skriv: what, skriv: say, skriv: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
