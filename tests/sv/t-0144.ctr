



>> CoffeeGrounds := Objekt ny.
CoffeeGrounds vid: ['extract'] gör: { <- ['coffee']. }.

>> CoffeeMachine := Objekt ny.
CoffeeMachine vid: ['init'] gör: {
	egen coffeegrounds := CoffeeGrounds ny.
}.
CoffeeMachine vid: ['ny'] gör: { <- CoffeeMachine `new init.
}.

CoffeeMachine vid: ['makeTea'] gör: { <- (egen tealeaves extract). }.
CoffeeMachine vid: ['makeCoffee'] gör: { <- (egen coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine ny.

Utdata skriv:
	coffeeDream 
	makeCoffee.

Utdata skriv:
	coffeeDream 
	makeTea.
