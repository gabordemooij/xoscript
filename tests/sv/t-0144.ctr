



>> Kaffesump := Objekt ny.
Kaffesump vid: ['extrahera'] gör: { <- ['coffee']. }.

>> Kaffemaskin := Objekt ny.
Kaffemaskin vid: ['init'] gör: {
	egen kaffesump := Kaffesump ny.
}.
Kaffemaskin vid: ['ny'] gör: { <- Kaffemaskin `new init.
}.

Kaffemaskin vid: ['bryggTe'] gör: { <- (egen teblad extrahera). }.
Kaffemaskin vid: ['bryggKaffe'] gör: { <- (egen kaffesump extrahera). }.

>> kaffedröm := Kaffemaskin ny.

Utdata skriv:
	kaffedröm 
	bryggKaffe.

Utdata skriv:
	kaffedröm 
	bryggTe.
