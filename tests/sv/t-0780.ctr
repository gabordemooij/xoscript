Server init.

# JSON-kodaren stöder endast UTF-8, inga surrogatpar

>> ordböcker := Lista ny ;
	# {"key":"normal"} vanlig ASCII
	( Ordbok ny sätt: ['normal'] vid: ['key'] ) ;
	# {"key":"hello world"} mellanslag
	( Ordbok ny sätt: ['hello world'] vid: ['key'] ) ;
	# {"key":"quote: \""} dubbelt citattecken
	( Ordbok ny sätt: ['"'] vid: ['key'] ) ;
	# {"key":"backslash: \\"} omvänt snedstreck
	( Ordbok ny sätt: ['backslash: \\'] vid: ['key'] ) ;
	# {"key":"slash: /"} snedstreck
	( Ordbok ny sätt: ['snedstreck: /'] vid: ['key'] ) ;
	# {"key":"backspace: \b"} backsteg
	( Ordbok ny sätt: ['backspace: \b'] vid: ['key'] ) ;
	# {"key":"formfeed: \f"} sidmatningsescape
	( Ordbok ny sätt: ['formfeed: \f'] vid: ['key'] ) ;
	# {"key":"newline: \n"} radbrytning
	( Ordbok ny sätt: ['newline: \n'] vid: ['key'] ) ;
	( Ordbok ny sätt: ['newline: ↵'] vid: ['key'] ) ;
	( Ordbok ny sätt: ['newline: 
	'] vid: ['key'] ) ;
	# {"key":"carriage return: \r"} vagnretur
	( Ordbok ny sätt: ['carriage return: \r'] vid: ['key'] ) ;
	# {"key":"tab: \t"} tabb
	( Ordbok ny sätt: ['tab \t'] vid: ['key'] ) ;
	( Ordbok ny sätt: ['tab ⇿'] vid: ['key'] ) ;
	( Ordbok ny sätt: ['tabb  '] vid: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( Ordbok ny sätt: ['NUL \u0000'] vid: ['key'] ) ;
	( Ordbok ny sätt: ['NUL \0'] vid: ['key'] ) ;
	# {"key":"control: \u0001"} styrtecken 0x01
	( Ordbok ny sätt: ['control: \u0001'] vid: ['key'] ) ;
	# {"key":"control: \u001F"} styrtecken 0x1F
	( Ordbok ny sätt: ['control: \u001F'] vid: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-bytestecken
	( Ordbok ny sätt: ['unicode: é'] vid: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-bytestecken
	( Ordbok ny sätt: ['unicode: €'] vid: ['key'] ) ;
	# {"key":"unicode: 日本語"} flera 3-byte UTF-8-tecken
	( Ordbok ny sätt: ['unicode: 日本語'] vid: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-bytestecken
	( Ordbok ny sätt: ['unicode: 😀'] vid: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + nollbreddsfogare
	( Ordbok ny sätt: ['unicode: 🧑‍💻'] vid: ['key'] ) ;
	# {"key":"combining: é"} kombinerande accent
	( Ordbok ny sätt: ['combining: e\u0301'] vid: ['key'] ) ;
	# {"key":"escaped unicode: é"} Unicode-escape BMP
	( Ordbok ny sätt: ['escaped unicode: \u00e9'] vid: ['key'] ) ;
	# {"key":"escaped unicode: €"} Unicode-escape BMP
	( Ordbok ny sätt: ['escaped unicode: \u20ac'] vid: ['key'] ) ;
	# {"key":"escaped unicode: 😀"} UTF-16-surrogatpar
	( Ordbok ny sätt: ['escaped unicode: \ud83d\ude00'] vid: ['key'] ) ;
	# {"key":""} tomt värde
	( Ordbok ny sätt: [''] vid: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} speciella ASCII-tecken
	( Ordbok ny sätt: ['@ < > & = % + ? #'] vid: ['key'] ) ;
	# {"key":"single quote: '"} enkelt citattecken
	( Ordbok ny sätt: ['''] vid: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} flera JSON-escapes
	( Ordbok ny sätt: ['multiple: \" \\ \n \r \t'] vid: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} längre ASCII-text
	( Ordbok ny sätt: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] vid: ['key'] ) ;
	# {"key":" value"} inledande mellanslag
	( Ordbok ny sätt: [' värde'] vid: ['key'] ) ;
	# {"key":"value "} avslutande mellanslag
	( Ordbok ny sätt: ['värde '] vid: ['key'] ) ;
	# {"key":" \t\n\r "} blanktecken
	( Ordbok ny sätt: [' \t\n\r '] vid: ['key'] )
	.

ordböcker varje: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (Ordbok ny sätt: d key vid: ['key']).
	>> b := JSON jsonify: (Ordbok ny sätt: ['value'] vid: d key).
	>> e := JSON objekt: a.
	>> f := JSON objekt: b.
	((e key = d key och: (f ? d key = ['value'])) eller: (e key = ['NUL ?'])) sann: {
		Utdata skriv: ['OK'], stop.
	}, annars: {
		Utdata skriv: ['Kan inte koda/avkoda korrekt: '] + d + j, stop.
		Program avsluta.
	}.
}.
