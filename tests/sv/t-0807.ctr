# felmeddelanden från databasen får inte behandlas som formatsträngar
Server init.

>> db := Maria-DB ny värd: ['localhost'],
	användarnamn: ['xo'],
	lösenord: ['pass123'],
	databasnamn: ['xobase'],
	anslut.

>> sökparametrar := db fråga: ['SELECT %% FROM'].
{ sökparametrar utför. } fånga: { :e
	Utdata skriv: ( e innehåller: ['%%'] ), stop.
}, starta.
