


>> Kortlek := Lista ny.
Kortlek vid: ['skrivut'] gör: {
        >> len := själv antal - 1.
        { :i
                >> lgd2 := själv antal - 1.
                Utdata skriv: ['lgd: '].
                Utdata skriv: len, stop.
                Utdata skriv: ['lgd2: '].
                Utdata skriv: lgd2, stop.
        } × len.
}.

>> d := Kortlek ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d skrivut.
