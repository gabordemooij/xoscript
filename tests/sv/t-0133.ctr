


>> Deck := Lista ny.
Deck vid: ['print'] gör: {
        >> len := själv antal - 1.
        { :i
                >> len2 := själv antal - 1.
                Utdata skriv: ['len: '].
                Utdata skriv: len, stop.
                Utdata skriv: ['len2: '].
                Utdata skriv: len2, stop.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
