Utdata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 

a vid: ['item:'] gör: { :hexhjälpare
	egen hexhjälpare := hexhjälpare. 
}.

a vid: ['artikel'] gör: {
	<- egen hexhjälpare.
}.

a item: Hx ny.

>> gammal-hexhjälpare-adress := a artikel prototyp minnesadress.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== LADDAR OM SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b artikel prototyp minnesadress = gammal-hexhjälpare-adress) sann: {
	Utdata skriv: ['Objektlänk återkopplad.'], stop.
}.
