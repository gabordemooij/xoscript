Utdata skriv: ['Test object'], stop.
>> a := Objekt ny. 

a vid: ['item:'] gör: { :hexhelper
	egen hexhelper := hexhelper. 
}.

a vid: ['item'] gör: { <- egen hexhelper.
}.

a item: Hx ny.

>> old-hexhelper-address := a item prototyp minnesadress.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== RELOADING SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp minnesadress = old-hexhelper-address) sann: {
	Utdata skriv: ['Object link re-attached.'], stop.
}.
