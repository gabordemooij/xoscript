>> items := Ordbok ny.
items sätt: ['grön'] vid: ['color-1'].
items sätt: ['orange'] vid: ['color-2'].
items sätt: ['röd'] vid: ['color-3'].
>> i := 0.
>> s := [''].
items varje: { :key :färg
	Utdata skriv: ['color #'] + i + [' är: '] + färg + [' '].
	i lägg-till: 1.
}.
Utdata skriv: i + [' färger!'].
