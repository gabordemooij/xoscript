>> a := 3.
>> b := a kopiera.
a subtrahera: 1.
Utdata skriv: [' a = '] + a.
Utdata skriv: [' b = '] + b.
a := 3.
b := a + 4.
Utdata skriv: [' a = '] + a.
Utdata skriv: [' b = '] + b.
>> x := 3.
>> y := x kopiera.
x lägg-till: 10.
y subtrahera: 1.
Utdata skriv: [' x = '] + x.
Utdata skriv: [' y = '] + y.
>> q := Objekt ny.
q vid: ['setProperty:'] gör: { :x
	egen prop := x.
}.
q vid: ['getProperty'] gör: { <- egen prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Utdata skriv: [' p = '] + (p getProperty).
