60 × {
	>> x := (Tal slump % 6) + 1.
	(x ≤ 6) falsk: { Utdata skriv: ['FEL']. }.
	(x ≥0) falsk: { Utdata skriv: ['FEL']. }.
	x := (Tal slump % 3) + 1.
	(x < 3) falsk: { Utdata skriv: ['FEL']. }.
	(x>-1) falsk: { Utdata skriv: ['FEL']. }.
	x := ((Boolesk singla) tal).
	(x = 0 eller: x = 1) falsk: { Utdata skriv: ['FEL']. }.
	x := ((Sann singla) tal).
	(x = 0 eller: x = 1) falsk: { Utdata skriv: ['FEL']. }.
	x := (Boolesk singla antingen: ['KRONA'] eller: ['KLAVE']).
	((x = ['KRONA']) eller: (x = ['KLAVE'])) falsk: { Utdata skriv: ['FEL']. }.
}.
Utdata skriv: ['KLAR'].

