#OBSD
>> dirname := [''].
{ dirname lägg-till-sist: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Program system: command.
Program chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename lägg-till-sist: ['YYYYYYYY']. } * 20.
Fil ny: filename, skriv: ['sometext'].
{ Fil lista: ['/tmp/'] + dirname. } * 1000.
Utdata skriv: ['no crash'], stop.

