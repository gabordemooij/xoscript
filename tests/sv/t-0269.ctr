#Linux

(Fil ny: ['/tmp/testje']) finns falsk: {
	Program system: ['mkdir /tmp/testje'].	
}.

(Fil ny: ['/tmp/testje/file1']) finns falsk: {
	Program system: ['touch /tmp/testje/file1'].	
}.

(Fil ny: ['/tmp/testje/folder1']) finns falsk: {
	Program system: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Fil lista: ['/tmp/testje'].

>> q := Lista ny.

l varje: { :k :v v varje: { :x :y q lägg-till-sist: y. }. }.

>> s := q text.

(s innehåller: ['file1']) sann:   { Utdata skriv: ['OK'], stop. }.
(s innehåller: ['file2']) sann:   { Utdata skriv: ['XX'], stop. }.
(s innehåller: ['folder1']) sann: { Utdata skriv: ['OK'], stop. }.
