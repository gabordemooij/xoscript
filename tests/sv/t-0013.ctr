
>> Djur := Objekt ny.
Djur vid: ['ny'] gör: {
	<- själv ny init.
}.

Djur vid: ['init'] gör: {
	egen läte := ['?'].
	egen ben  := 4.
}.

>> Hund := Djur ny.
Hund vid: ['init'] gör: {
	själv init.
	egen läte := ['skäller'].
}.

Djur vid: ['text'] gör: {
	<- egen ben text + egen läte.
}.

>> pudel := Hund ny.
Utdata skriv: pudel, stop.

