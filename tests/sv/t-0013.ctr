
>> Animal := Objekt ny.
Animal vid: ['ny'] gör: { <- själv ny init.
}.

Animal vid: ['init'] gör: {
	egen sound := ['?'].
	egen legs := 4.
}.

>> Dog := Animal ny.
Dog vid: ['init'] gör: {
	själv init.
	egen sound := ['barks'].
}.

Animal vid: ['text'] gör: { <- egen legs text + egen sound.
}.

>> poodle := Dog ny.
Utdata skriv: poodle, stop.

