>> x := Objekt ny.
>> y := Objekt ny.
>> z := x.
Utdata skriv: (x = z), stop.
Utdata skriv: (x = y), stop.
Utdata skriv: (x ≠ y), stop.
Utdata skriv: (x ≠ z), stop.
>> m := Moment ny år: 2070, månad: 11.
>> n := m kopiera.
Utdata skriv: (m = n), stop.
Utdata skriv: (m ≠ n), stop.
Utdata skriv: (m lika-med: m), stop.
Utdata skriv: (m lika-med: n), stop.
n månad: 12.
Utdata skriv: (m ≠ n), stop.
Utdata skriv: (m = n), stop.


