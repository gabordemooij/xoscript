#Linux
>> clock := Moment ny.
clock zon: ['UTC-1'].
clock år: 1981, månad: 1, dag: 5,
      timme: 13, minut: 15, sekund: 13.

Utdata skriv: clock, stop.
clock zon: ['UTC+0'].

Utdata skriv: (
	(clock år rå) + ['-'] + (clock månad) + ['-'] + (clock dag) + [' '] +
	(clock timme) + [':'] + (clock minut) + [':'] + (clock sekund) + [' '] +
	['W'] + (clock vecka) + (clock zon)
), stop.


clock zon: ['UTC-1'].
Utdata skriv: (
	(clock år rå) + ['-'] + (clock månad) + ['-'] + (clock dag) + [' '] +
	(clock timme) + [':'] + (clock minut) + [':'] + (clock sekund) + [' '] +
	['W'] + (clock vecka) + (clock zon)
), stop.
