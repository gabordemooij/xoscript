#Linux
>> klocka := Moment ny.
klocka zon: ['UTC-1'].
klocka år: 1981, månad: 1, dag: 5,
      timme: 13, minut: 15, sekund: 13.

Utdata skriv: klocka, stop.
klocka zon: ['UTC+0'].

Utdata skriv: (
	(klocka år rå) + ['-'] + (klocka månad) + ['-'] + (klocka dag) + [' '] +
	(klocka timme) + [':'] + (klocka minut) + [':'] + (klocka sekund) + [' '] +
	['W'] + (klocka vecka) + (klocka zon)
), stop.


klocka zon: ['UTC-1'].
Utdata skriv: (
	(klocka år rå) + ['-'] + (klocka månad) + ['-'] + (klocka dag) + [' '] +
	(klocka timme) + [':'] + (klocka minut) + [':'] + (klocka sekund) + [' '] +
	['W'] + (klocka vecka) + (klocka zon)
), stop.
