Program minneshantering: 0.

>> txt := ['Word Salad'].
Utdata skriv: ['sista index för rds = '] + (( txt sista: ['ord'] ) - 0), stop.
Utdata skriv: ['index för rds = '] + (( txt hitta: ['ord'] ) - 0), stop.
Utdata skriv: ['index för ad = '] + (( txt hitta: ['ad'] ) - 0), stop.
Utdata skriv: ['sista index för W = '] + (( txt sista: ['W'] ) - 0), stop.
Utdata skriv: ['sista index för d = '] + (( txt sista: ['d'] ) - 0), stop.
Utdata skriv: ['txt är lika med Ordsallad = '] + ( txt = ['Word Salad'] ), stop.
Utdata skriv: ['txt är lika med Caesarsallad = '] + ( txt = ['Caesarsallad'] ), stop.
Utdata skriv: ['txt är inte lika med Ordsallad = '] + ( txt ≠ ['Word Salad'] ), stop.
Utdata skriv: ['txt är inte lika med Caesarsallad = '] + ( txt ≠ ['Caesarsallad'] ), stop.

