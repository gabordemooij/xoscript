#Linux
>> använtMinne1 := 0.
>> använtMinne2 := 0.
>> använtMinne3 := 0.
>> använtMinne4 := 0.

Program minneshantering: 0.

{
Moment tid.
Moment vänta: 1.
Utdata skriv: Program argument, stop.
Program argument: 0.
Tal slump.
Utdata skriv: (Program system: ['echo 'Hello'']).
} starta.

Program städa.
använtMinne1 := (Program minne ? 0).

{
Moment tid.
Moment vänta: 1.
Utdata skriv: Program argument, stop.
Program argument: 0.
Tal slump.
Utdata skriv: (Program system: ['echo 'Hello'']).
} starta.

Program städa.
använtMinne2 := (Program minne ? 0).

{
Moment tid.
Moment vänta: 1.
Utdata skriv: Program argument, stop.
Program argument: 0.
Tal slump.
Utdata skriv: (Program system: ['echo 'Hello'']).
} starta.

Program städa.
använtMinne3 := (Program minne ? 0).



( använtMinne1 = använtMinne2 och: använtMinne1 = använtMinne3, och: använtMinne2 = använtMinne3 ) sann: {
	Utdata skriv: ['Inga minnesläckor här'].
}, falsk: {
	Utdata skriv: ['Läcker minne...'].
}.
