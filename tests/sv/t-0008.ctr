>> Greeter := Objekt ny.
Greeter vid: ['make'] gör: {
	>> greeter := Objekt ny.
	greeter vid: ['name:'] gör: { :namn
		Utdata skriv: ['setting a name'].
		egen myName := namn.
	}.
	greeter vid: ['greet'] gör: {
		Utdata skriv: ['Hello'].
		Utdata skriv: egen myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
