#Linux
>> Slurp := Objekt ny.

Slurp vid: ['ny'] gör: {
	egen str := [''].
}.

Slurp vid: ['nieuw'] gör: {
	egen str := [''].
}.

Slurp vid: ['svara:'] gör: { :blah
		egen str lägg-till-sist: blah.
}.

Slurp vid: ['svara:och:'] gör: { :blah :blahah
		egen str lägg-till-sist: (blah från: 0 längd: (blah längd - 1)).
		egen str lägg-till-sist: [' '].
		egen str lägg-till-sist: blahah.
}.

Slurp vid: ['erhåll'] gör: {
	>> buffert := egen str.
	egen str := ['']. <- buffert.
}.


Utdata skriv: (Program system: (Slurp ny echo: ['Hallå, jag kan skriva till konsolen med ett flytande API!'], erhåll)).


{ Fil ny: ['/tmp/from.txt'], radera. } fånga: { ['Tomt']. }, starta.
{ Fil ny: ['/tmp/to.txt'], radera. } fånga: { ['Tomt']. }, starta.


Fil ny: ['/tmp/to.txt'], finns falsk: {
	Utdata skriv: ['Confirmed. Target file does not exist.\
'].
}.
Fil ny: ['/tmp/from.txt'], finns falsk: {
	Utdata skriv: ['Confirmed. Source file does not exist.\
'].
}.



Program system: (Slurp ny touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], erhåll).



Program system: (Slurp ny cp: ['/tmp/from.txt /tmp/to.txt'], erhåll).

Fil ny: ['/tmp/to.txt'], finns sann: {
	Utdata skriv: ['Confirmed. Target file has been created by shell.\
'].
}.


Utdata skriv: ['Filens innehåll är:'] + (Fil ny: ['/tmp/to.txt'], läs), stop.
