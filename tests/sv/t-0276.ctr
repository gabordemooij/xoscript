>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objekt ny.
⚄ vid: ['drawFrom:length:'] gör: { :pool :antal
	
	>> result := [''].
	
	{
		>> index := Tal random % (pool längd).
		result lägg-till-sist: ( pool tecken: (index + 1) ).
		
	} × antal. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? längd.
Utdata skriv: (['x↵'] x random längd).
Utdata skriv: (['y↵'] y ?? längd).

