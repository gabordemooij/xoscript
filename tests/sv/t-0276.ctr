>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objekt ny.
⚄ vid: ['dragFrån:längd:'] gör: { :förråd :antal
	
	>> resultat := [''].
	
	{
		>> index := Tal slump % (förråd längd).
		resultat lägg-till-sist: ( förråd tecken: (index + 1) ).
		
	} × antal. <- resultat.
}.

>> slump := ⚄ dragFrån: ?? längd: ?? längd.
Utdata skriv: (['x↵'] x slump längd).
Utdata skriv: (['y↵'] y ?? längd).

