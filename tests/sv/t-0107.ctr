
Utdata skriv: ['Break for-loop, 0-4.'], stop.
{ :i
	Utdata skriv: ['iteration #'] + i, stop.
	(i = 4) avbryt.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Utdata skriv: ['Break while-true loop, 0-4.'], stop.
{
	Utdata skriv: ['iteration #'] + x, stop.
	x lägg-till: 1.
	((x < 5) inte) avbryt.
} medan: xIsLessThan10.

Utdata skriv: ['Break while-false loop, 5,4.'], stop.
{
	Utdata skriv: ['iteration #'] + x, stop.
	x subtrahera: 1.
	(x = 3) avbryt.
} medan: { <- (x > 0). }.

Utdata skriv: ['Break times loop, 1-4.'], stop.
{ :i
	Utdata skriv: ['iteration #'] + i, stop.
	(i = 4) avbryt.
} × 5.

Utdata skriv: ['Break block, dont print line.'], stop.
{ Sann avbryt. Utdata skriv: ['dont write this!'], stop. } starta.

Utdata skriv: ['Break block, dont fire catch...'], stop.
{ Sann avbryt. Utdata skriv: ['dont write this!'], stop. } fånga: { Utdata skriv: ['Dont catch this!']. }, starta.

Utdata skriv: ['Test Array each-loop: 0,1'], stop.
(Lista ← 1 ; 2 ; 3) avbilda: { :i
	Utdata skriv: ['iteration #'] + i, stop.
	(i = 1) avbryt.
}.

Utdata skriv: ['Test Map each-loop: c only'], stop.
>> m := Ordbok ny.
m sätt: ['first'] vid: ['a'], sätt: ['second'] vid: ['b'], sätt: ['third'] vid: ['c'].
m varje: { :k :v
	Utdata skriv: ['iteration'] + v + k, stop.
	Sann avbryt.
}.

