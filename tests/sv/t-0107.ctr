
Utdata skriv: ['Avbryt for-loop, 0-4.'], stop.
{ :i
	Utdata skriv: ['iteration #'] + i, stop.
	(i = 4) avbryt.
} × 10.

>> x := 0.
>> xÄrMindreÄn10 := { <- ( x < 10 ). }.

Utdata skriv: ['Avbryt while-true-loop, 0-4.'], stop.
{
	Utdata skriv: ['iteration #'] + x, stop.
	x lägg-till: 1.
	((x < 5) inte) avbryt.
} medan: xÄrMindreÄn10.

Utdata skriv: ['Avbryt while-false-loop, 5,4.'], stop.
{
	Utdata skriv: ['iteration #'] + x, stop.
	x subtrahera: 1.
	(x = 3) avbryt.
} medan: { <- (x > 0). }.

Utdata skriv: ['Avbryt times-loop, 1-4.'], stop.
{ :i
	Utdata skriv: ['iteration #'] + i, stop.
	(i = 4) avbryt.
} × 5.

Utdata skriv: ['Avbryt block, skriv inte ut raden.'], stop.
{ Sann avbryt. Utdata skriv: ['skriv inte detta!'], stop. } starta.

Utdata skriv: ['Avbryt block, utlös inte catch...'], stop.
{ Sann avbryt. Utdata skriv: ['skriv inte detta!'], stop. } fånga: { Utdata skriv: ['Fånga inte detta!']. }, starta.

Utdata skriv: ['Testa Lista each-loop: 0,1'], stop.
(Lista ← 1 ; 2 ; 3) avbilda: { :i
	Utdata skriv: ['iteration #'] + i, stop.
	(i = 1) avbryt.
}.

Utdata skriv: ['Testa Ordbok each-loop: bara c'], stop.
>> m := Ordbok ny.
m sätt: ['first'] vid: ['a'], sätt: ['second'] vid: ['b'], sätt: ['tredje'] vid: ['c'].
m varje: { :k :v
	Utdata skriv: ['iteration'] + v + k, stop.
	Sann avbryt.
}.

