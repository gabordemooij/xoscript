# testa beteckningar

>> $ := Objekt ny.

$ vid: ['svara:'] gör: { :x
	
	>> operation := x tecken: 0.
	>> valuta := x tecken: 1.
	>> pengar := x offset: 2.
	
	>> belopp := 0.

	( operation = ['+'] ) sann: {
		( valuta = ['£'] ) sann: { belopp := 1.28 × pengar. }.
	}. <- belopp.
}.



>> x := $ +£20.

Utdata skriv: x, stop.


>> Frukt := Objekt ny.

Frukt vid: ['ny'] gör: {
	>> f := själv ny.
	f apples: 0.
	f oranges: 0. <- f.
}.

Frukt vid: ['apples:'] gör: { :a egen äpplen := a. }.
Frukt vid: ['oranges:'] gör: { :p egen apelsiner := p. }.
Frukt vid: ['äpplen'] gör: { <- egen äpplen. }.
Frukt vid: ['apelsiner'] gör: { <- egen apelsiner. }.

Frukt vid: ['+'] gör: { :f
	
	>> n := Frukt ny.
	f lägg-till: 1.
	
	n apples: (f äpplen + egen äpplen).
	n oranges:  (f apelsiner  + egen apelsiner). <- n.
}.

Frukt vid: ['text'] gör: { <- ( egen äpplen text + [' äpplen och '] + egen apelsiner + [' apelsiner'] ).
}.

Tal vid: ['äpplen'] gör: { <- ((Frukt ny) apples: själv).
}.

Tal vid: ['apple'] gör: { <- ((Frukt ny) apples: själv).
}.

Tal vid: ['apelsiner'] gör: { <- ((Frukt ny) oranges: själv).
}.




Utdata skriv: (1 apple + 3 apelsiner + 4 äpplen), stop.


Text vid: ['dubbelt'] gör: { <- ((själv text) + (själv text)).
}.



Utdata skriv: ['❤❤❤'] dubbelt.



