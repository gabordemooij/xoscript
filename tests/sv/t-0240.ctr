# test qualifiers

>> $ := Objekt ny.

$ vid: ['svara:'] gör: { :x
	
	>> operation := x tecken: 0.
	>> valuta := x tecken: 1.
	>> money := x offset: 2.
	
	>> amount := 0.

	( operation = ['+'] ) sann: {
		( valuta = ['£'] ) sann: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Utdata skriv: x, stop.


>> Fruit := Objekt ny.

Fruit vid: ['ny'] gör: {
	>> f := själv ny.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit vid: ['apples:'] gör: { :a egen apples := a. }.
Fruit vid: ['oranges:'] gör: { :p egen oranges := p. }.
Fruit vid: ['apples'] gör: { <- egen apples. }.
Fruit vid: ['oranges'] gör: { <- egen oranges. }.

Fruit vid: ['+'] gör: { :f
	
	>> n := Fruit ny.
	f lägg-till: 1.
	
	n apples: (f apples + egen apples).
	n oranges:  (f oranges  + egen oranges). <- n.
}.

Fruit vid: ['text'] gör: { <- ( egen apples text + [' apples and '] + egen oranges + [' oranges'] ).
}.

Tal vid: ['apples'] gör: { <- ((Fruit ny) apples: själv).
}.

Tal vid: ['apple'] gör: { <- ((Fruit ny) apples: själv).
}.

Tal vid: ['oranges'] gör: { <- ((Fruit ny) oranges: själv).
}.




Utdata skriv: (1 apple + 3 oranges + 4 apples), stop.


Text vid: ['twice'] gör: { <- ((själv text) + (själv text)).
}.



Utdata skriv: ['❤❤❤'] twice.



