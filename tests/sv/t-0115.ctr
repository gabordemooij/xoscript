{
	denna-uppgift fel: ['Misslyckas inte.'].
	okänd görNågot.
} fånga: {
	Utdata skriv: ['Fångad!'].
}, starta.

{
	denna-uppgift fel: ['Misslyckas inte.'].
	egen okänd görNågot.
} fånga: {
	Utdata skriv: ['Fångad!'].
}, starta.

