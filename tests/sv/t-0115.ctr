{
	{
		denna-uppgift fel: ['Misslyckas inte.'].
		Sann avbryt.
		Utdata skriv: ['FEL'].
	} fånga: { :x
		(x = ['Misslyckas inte.']) sann: { denna-uppgift fel: ['Nästlad fångad!']. }.
	}, starta.
} fånga: { :e
	Utdata skriv: e.
}, starta.
