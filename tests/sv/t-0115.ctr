{
	denna-uppgift fel: ['Dont fail.'].
	unknown doSomething.
} fånga: {
	Utdata skriv: ['Caught!'].
}, starta.

{
	denna-uppgift fel: ['Dont fail.'].
	egen unknown doSomething.
} fånga: {
	Utdata skriv: ['Caught!'].
}, starta.

{
	denna-uppgift fel: ['Dont fail.'].
	unknown := 122.
} fånga: {
	Utdata skriv: ['Caught!'].
}, starta.


{
	denna-uppgift fel: ['Dont fail.'].
	Sann avbryt.
	Utdata skriv: ['FAIL'].
} fånga: {
	Utdata skriv: ['Caught!'].
}, starta.

{
	{
		denna-uppgift fel: ['Dont fail.'].
		Sann avbryt.
		Utdata skriv: ['FAIL'].
	} fånga: { :x
		(x = ['Dont fail.']) sann: { denna-uppgift fel: ['Nested Caught!']. }.
	}, starta.
} fånga: { :e
	Utdata skriv: e.
}, starta.
