

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program minneshantering: 0.

{ :i Utdata skriv: i. } × 4.
Utdata stop.
{ :i Utdata skriv: (4 - i). } × 4.
Utdata stop.
( 1 > 2 ) falsk: { Utdata skriv: ['BLOCK 1'], stop. }.
( 2 > 1 ) sann:  { Utdata skriv: ['BLOCK 2'], stop. }.

>> i := 0.
{ Utdata skriv: i. i lägg-till: 1. } medan: { <- ( i < 3). }.
Utdata stop.

i := 3.
{ Utdata skriv: i. i := i - 1. } medan: { <- ( i > 0). }.
Utdata stop.


Program städa.

usedMemory1 := (Program minne ? 0).


{ :i  Utdata skriv: i. } × 4.
Utdata stop.
{ :i  Utdata skriv: (4 - i). } × 4.
Utdata stop.
( 1 > 2 ) falsk: { Utdata skriv: ['BLOCK 1'], stop. }.
( 2 > 1 ) sann:  { Utdata skriv: ['BLOCK 2'], stop. }.

>> i := 0.
{ Utdata skriv: i. i lägg-till: 1. } medan: { <- ( i < 3). }.
Utdata stop.

i := 3.
{ Utdata skriv: i. i := i - 1. } medan: { <- ( i > 0). }.
Utdata stop.



Program städa.
usedMemory2 := (Program minne ? 0).


{ :i Utdata skriv: i. } × 4.
Utdata stop.
{ :i Utdata skriv: (4 - i). } × 4.
Utdata stop.
( 1 > 2 ) falsk: { Utdata skriv: ['BLOCK 1'], stop. }.
( 2 > 1 ) sann:  { Utdata skriv: ['BLOCK 2'], stop. }.

>> i := 0.
{ Utdata skriv: i. i lägg-till: 1. } medan: { <- ( i < 3). }.
Utdata stop.

i := 3.
{ Utdata skriv: i. i := i - 1. } medan: { <- ( i > 0). }.
Utdata stop.

Program städa.
usedMemory3 := (Program minne ? 0).



( usedMemory1 = usedMemory2 och: usedMemory1 = usedMemory3, och: usedMemory2 = usedMemory3 ) sann: {
	Utdata skriv: ['No memory leaks here'].
}, falsk: {
	Utdata skriv: ['Leaking memory...'].
}.
