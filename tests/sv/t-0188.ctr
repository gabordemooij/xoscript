

>> använtMinne1 := 0.
>> använtMinne2 := 0.
>> använtMinne3 := 0.
>> använtMinne4 := 0.

Program minneshantering: 0.

{ :i Utdata skriv: i. } × 4.
Utdata stop.
{ :i Utdata skriv: (4 - i). } × 4.
Utdata stop.
( 1 > 2 ) falsk: { Utdata skriv: ['BLOCK 1'], stop. }.
( 2 > 1 ) sann:  { Utdata skriv: ['BLOCK 2'], stop. }.

>> i := 0.
{ Utdata skriv: i. i lägg-till: 1. } medan: { <- ( i < 3). }.
Utdata stop.

i := 3.
{ Utdata skriv: i. i := i - 1. } medan: { <- ( i > 0). }.
Utdata stop.


Program städa.

använtMinne1 := (Program minne ? 0).


{ :i  Utdata skriv: i. } × 4.
Utdata stop.
{ :i  Utdata skriv: (4 - i). } × 4.
Utdata stop.
( 1 > 2 ) falsk: { Utdata skriv: ['BLOCK 1'], stop. }.
( 2 > 1 ) sann:  { Utdata skriv: ['BLOCK 2'], stop. }.

>> i := 0.
{ Utdata skriv: i. i lägg-till: 1. } medan: { <- ( i < 3). }.
Utdata stop.

i := 3.
{ Utdata skriv: i. i := i - 1. } medan: { <- ( i > 0). }.
Utdata stop.



Program städa.
använtMinne2 := (Program minne ? 0).


{ :i Utdata skriv: i. } × 4.
Utdata stop.
{ :i Utdata skriv: (4 - i). } × 4.
Utdata stop.
( 1 > 2 ) falsk: { Utdata skriv: ['BLOCK 1'], stop. }.
( 2 > 1 ) sann:  { Utdata skriv: ['BLOCK 2'], stop. }.

>> i := 0.
{ Utdata skriv: i. i lägg-till: 1. } medan: { <- ( i < 3). }.
Utdata stop.

i := 3.
{ Utdata skriv: i. i := i - 1. } medan: { <- ( i > 0). }.
Utdata stop.

Program städa.
använtMinne3 := (Program minne ? 0).



( använtMinne1 = använtMinne2 och: använtMinne1 = använtMinne3, och: använtMinne2 = använtMinne3 ) sann: {
	Utdata skriv: ['Inga minnesläckor här'].
}, falsk: {
	Utdata skriv: ['Läcker minne...'].
}.
