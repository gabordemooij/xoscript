Text vid: ['html'] gör: { <- (
		själv
		ersätt: ['&'] med: ['&amp;'],
		ersätt: ['<'] med: ['&lt;'],
		ersätt: ['>'] med: ['&gt;'],
		ersätt: ['''] med: ['&apos;'],
		ersätt: ['"'] med: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program minneshantering: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Utdata skriv: txt kopiera html, stop.
Utdata skriv: txt kopiera gemener, stop.
Utdata skriv: txt kopiera versaler, stop.
} starta.

Program städa.

usedMemory1 := (Program minne ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Utdata skriv: txt kopiera html, stop.
Utdata skriv: txt kopiera gemener, stop.
Utdata skriv: txt kopiera versaler, stop.
} starta.

Program städa.
usedMemory2 := (Program minne ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Utdata skriv: txt kopiera html, stop.
Utdata skriv: txt kopiera gemener, stop.
Utdata skriv: txt kopiera versaler, stop.
} starta.

Program städa.
usedMemory3 := (Program minne ? 0).



( usedMemory1 = usedMemory2 och: usedMemory1 = usedMemory3, och: usedMemory2 = usedMemory3 ) sann: {
	Utdata skriv: ['No memory leaks here'].
}, falsk: {
	Utdata skriv: ['Leaking memory...'].
}.
