Utdata skriv: ['Test object'], stop.
>> a := Objekt ny. 
a vid: ['item:'] gör: { :int64
	egen int64 := int64. 
}.
a vid: ['item'] gör: { <- egen int64.
}.
a item: ( Int64 från-text: ['9999'] ).
Utdata skriv: a item, stop.
>> old-int64-address := a item prototyp minnesadress.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== RELOADING SNAP:'], stop.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b item prototyp minnesadress = old-int64-address) sann: {
	Utdata skriv: ['Object link re-attached.'], stop.
}.
Utdata skriv: ( b item ), stop.
