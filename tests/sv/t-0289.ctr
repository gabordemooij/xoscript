#Linux
>> OS := Program system: (Kommando uname -s), trimma.

>> Slurp := Objekt ny.
Slurp vid: ['ny'] gör: {
	egen str := [''].
}.
Slurp vid: ['svara:'] gör: { :blah
		(egen str ≠ ['']) sann: {
			egen str lägg-till-sist: [' '].
		}.
		egen str lägg-till-sist: blah.
}.
Slurp vid: ['svara:och:'] gör: { :blah :blahah
		(egen str ≠ ['']) sann: {
			egen str lägg-till-sist: [' '].
		}.
		(blah längd > 1) sann: {
			egen str lägg-till-sist: (blah från: 0 längd: (blah längd - 1)).
		}, annars: {
			egen str lägg-till-sist: blah.
		}.
		egen str lägg-till-sist: [' '].
		egen str lägg-till-sist: blahah.
}.
Slurp vid: ['erhåll'] gör: {
	>> buffert := egen str.
	egen str := ['']. <- buffert.
}.
>> large text := [''].
{
	large text lägg-till-sist: ['hello'].
} × 1000.


Utdata skriv: (
	Program system: (
		Slurp ny
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) erhåll
).

