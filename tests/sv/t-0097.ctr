
Text vid: ['html'] gör: { <- (
		själv
		ersätt: ['&'] med: ['&amp;'],
		ersätt: ['<'] med: ['&lt;'],
		ersätt: ['>'] med: ['&gt;'],
		ersätt: ['"'] med: ['&quot;']
	).
}.

>> HtmlPensel := Objekt ny.

HtmlPensel vid: ['svara:'] gör: { :tagg
	Utdata skriv: (['<tag>↵'] tag: tagg ).
}.

HtmlPensel vid: ['svara:och:'] gör: { :tagg :content
	tagg := ( tagg från: 0 längd: (tagg längd - 1) ).
	Utdata skriv: (['<tag content>↵'] tag: tagg, content: content).
}.

HtmlPensel vid: ['content:'] gör: { :texten
	Utdata skriv: texten html, stop.
}.

HtmlPensel vid: ['attr:värde:'] gör: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlPensel ny.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] värde: ['bold']),
		/span
	/body
/html.
		
