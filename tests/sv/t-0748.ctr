Utdata skriv: ['Test object'], stop.
>> a := Objekt ny. 

a vid: ['item:'] gör: { :boolesk
	egen boolesk := boolesk. 
}.

a vid: ['item'] gör: { <- egen boolesk.
}.

a item: Sann.

Utdata skriv: a item, stop.

>> old-bool-address := a item prototyp minnesadress.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== RELOADING SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp minnesadress = old-bool-address) sann: {
	Utdata skriv: ['Object link re-attached.'], stop.
}.

Utdata skriv: b item, stop.
