>> Slurp := Objekt ny.
Slurp vid: ['ny'] gör: {
	egen str := [''].
}.

Slurp vid: ['svara:'] gör: { :blah
		(egen str ≠ ['']) sann: {
			egen str lägg-till-sist: [' '].
		}.
		egen str lägg-till-sist: blah.
}.
Slurp vid: ['svara:och:'] gör: { :blah :blahah
		(egen str ≠ ['']) sann: {
			egen str lägg-till-sist: [' '].
		}.
		(blah längd > 1) sann: {
			egen str lägg-till-sist: (blah från: 0 längd: (blah längd - 1)).
		}, annars: {
			egen str lägg-till-sist: blah.
		}.
		egen str lägg-till-sist: [' '].
		egen str lägg-till-sist: blahah.
}.
Slurp vid: ['obtain'] gör: {
	>> buffer := egen str.
	egen str := ['']. <- buffer.
}.

>> s := Slurp ny.
s hello: ['world'].
Utdata skriv: ( s obtain ), stop.
