Utdata skriv: ['Test object'], stop.
>> a := Objekt ny. 

a vid: ['item:'] gör: { :moment
	egen moment := moment. 
}.

a vid: ['item'] gör: { <- egen moment.
}.

>> today := Lista ny ; ( Moment ny zon: ['CEST'], år: 2026, månad: 7 ).
a item: today.
Utdata skriv: a item ? 0, stop.
a save-as: ['/tmp/a.bin'].
