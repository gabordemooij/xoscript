# testa typomvandlingar / konverteringar / bindningar
Program minneshantering: 4.
Server init.

>> räknare := 0.
>> db := Maria-DB ny värd: ['localhost'],
	användarnamn: ['xo'], lösenord: ['pass123'], databasnamn: ['xobase'], anslut.

>> TvåsiffrigtFormat := Format ny: ['%02d'].

# Datum och tid
{
	>> år     := Tal mellan: 1995 och: 2050, text.
	>> månad    := TvåsiffrigtFormat tillämpa-heltal: (Tal mellan: 1 och: 12), text.
	>> dag      := TvåsiffrigtFormat tillämpa-heltal: (Tal mellan: 1 och: 28), text.
	>> timme     := TvåsiffrigtFormat tillämpa-heltal: (Tal mellan: 1 och: 23), text.
	>> minut   := TvåsiffrigtFormat tillämpa-heltal: (Tal mellan: 1 och: 59), text.
	>> sekund   := TvåsiffrigtFormat tillämpa-heltal: (Tal mellan: 1 och: 59), text.
	>> datetime := ['YYYY-MM-DD HH:II:SS'].	
	datetime
		YYYY: år,
		MM: månad,
		DD: dag,
		HH: timme,
		II: minut,
		SS: sekund.
	>> sökparametrar :=
	db fråga: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: datetime),
	hämta: { :raden
		(raden mydatetime = datetime) falsk: {
			denna-uppgift fel: (
				['Förväntat: <expected> men fick: <observation>']
				<expected>: datetime,
				<observation>: raden mydatetime
			).
		}.
	
	}.
	räknare lägg-till: 1.
} * 100.

# Datum
{
	>> år     := Tal mellan: 1995 och: 2050, text.
	>> månad    := TvåsiffrigtFormat tillämpa-heltal: (Tal mellan: 1 och: 12), text.
	>> dag      := TvåsiffrigtFormat tillämpa-heltal: (Tal mellan: 1 och: 28), text.
	>> date     := ['YYYY-MM-DD'].
	date
		YYYY: år,
		MM: månad,
		DD: dag.
	>> sökparametrar :=
	db fråga: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: date),
	hämta: { :raden
		(raden mydate = date) falsk: {
			denna-uppgift fel: (
				['Förväntat: <expected> men fick: <observation>']
				<expected>: date,
				<observation>: raden mydate
			).
		}.
	}.
	räknare lägg-till: 1.
} * 100.


# Tid
{
	>> timme     := TvåsiffrigtFormat tillämpa-heltal: (Tal mellan: 1 och: 23), text.
	>> minut   := TvåsiffrigtFormat tillämpa-heltal: (Tal mellan: 1 och: 59), text.
	>> sekund   := TvåsiffrigtFormat tillämpa-heltal: (Tal mellan: 1 och: 59), text.
	>> tid := ['HH:II:SS'].
	tid
		HH: timme,
		II: minut,
		SS: sekund.
	>> sökparametrar :=
	db fråga: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: tid),
	hämta: { :raden
		(raden mytime = tid) falsk: {
			denna-uppgift fel: (
				['Förväntat: <expected> men fick: <observation>']
				<expected>: datetime,
				<observation>: raden mytime
			).
		}.
	}.
	räknare lägg-till: 1.
} * 100.


# Texter (varchar/text)
>> str1 := Lista ny fyll: 100000 med: ['x'], sammanfoga: [''].
{
	>> str2 := Valv token: 40.
	>> sökparametrar :=
	db fråga: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	hämta: { :raden
		(raden str1 = str1 och: raden str2 = str2) falsk: {
			denna-uppgift fel: (
				['Förväntat: <expected> men fick: <observation>']
				<expected>: datetime,
				<observation>: raden mytime
			).
		}.
	}.
	räknare lägg-till: 1.
} * 100.


# Tal
{
	>> n1  := Tal mellan: 1 och: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 från-text: ['9223372036854775807'] ) -
		( Int64 från-text: ['99999'] ) +
		( Int64 från-text: n1 text )
	).
	>> sökparametrar :=
	db fråga: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	hämta: { :raden
		(raden n1 = n1) falsk: {
			denna-uppgift fel: (
				['Förväntat: <expected> men fick: <observation>']
				<expected>: n1,
				<observation>: raden n1
			).
		}.
		(raden n2 = n2) falsk: {
			denna-uppgift fel: (
				['Förväntat: <expected> men fick: <observation>']
				<expected>: n1,
				<observation>: raden n2
			).
		}.
		(raden n3 = n2 avrunda) falsk: {
			denna-uppgift fel: (
				['Förväntat: <expected> men fick: <observation>']
				<expected>: n1,
				<observation>: raden n3
			).
		}.
		(raden big = big) falsk: {
			denna-uppgift fel: (
				['Förväntat: <expected> men fick: <observation>']
				<expected>: big,
				<observation>: raden big
			).
		}.
		
	}.
	räknare lägg-till: 1.
} * 100.


Utdata skriv: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: räknare
), stop.