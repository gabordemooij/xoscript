Server init.

>> DB := Maria-DB ny värd: ['localhost'],
	användarnamn: ['xo'],
	lösenord: ['pass123'],
	databasnamn: ['xobase'],
	anslut.
	
>> SQL := ['SELECT "hello" AS "world" '].

# skapa frågan manuellt
>> sökparametrar := Maria-Fråga ny: SQL.

# ange databas
sökparametrar databas: DB.

sökparametrar hämta: { :raden
	Utdata skriv: raden world, stop.
}.
