Server init.

>> DB := Maria-DB ny värd: ['localhost'],
	användarnamn: ['xo'],
	lösenord: ['pass123'],
	databasnamn: ['xobase'],
	anslut.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> sökparametrar := Maria-Fråga ny: SQL.

# set database
sökparametrar databas: DB.

sökparametrar hämta: { :row
	Utdata skriv: row world, stop.
}.
