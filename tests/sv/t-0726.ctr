# testa buffertar PKI/signering 
Server init.

>> lång := ( Lista ny fyll: 1000 med: ['a'] ) sammanfoga: [''].

# signera ett meddelande
Utdata skriv: ( 
	Valv signera: ['abc'] med: lång
), stop.

Utdata skriv: ( 
	Valv
		kontrollera: ['abc'] 
		signatur: lång 
		med: lång
), stop.

Utdata skriv: (
	Valv lösenordshash: lång verifiera: lång
), stop.
