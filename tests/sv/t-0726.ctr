# test buffers PKI/Sign 
Server init.

>> long := ( Lista ny fyll: 1000 med: ['a'] ) sammanfoga: [''].

# sign a message
Utdata skriv: ( 
	Valv signera: ['abc'] med: long
), stop.

Utdata skriv: ( 
	Valv
		kontrollera: ['abc'] 
		signatur: long 
		med: long
), stop.

Utdata skriv: (
	Valv lösenordshash: long verifiera: long
), stop.
