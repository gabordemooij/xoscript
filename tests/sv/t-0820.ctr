# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Mönster ny: pattern.
	p matcha: subject gör: { :m :g
		Utdata skriv: g antal, skriv: [' '], skriv: (g sammanfoga: ['|']), stop. <- m.
	}.
}.
show tillämpa: ['(a)|(b)'] och: ['b'].
show tillämpa: ['(a)|(b)'] och: ['a'].
show tillämpa: ['(x)?y'] och: ['y'].
show tillämpa: ['(x)?(y)(z)?'] och: ['xy'].
