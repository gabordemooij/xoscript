# en grupp som inte ingår i träffen får inte krascha och måste behålla gruppnumren
Server init.
>> visa := { :mönstret :subject
	>> p := Mönster ny: mönstret.
	p matcha: subject gör: { :m :g
		Utdata skriv: g antal, skriv: [' '], skriv: (g sammanfoga: ['|']), stop.
		<- m.
	}.
}.
visa tillämpa: ['(a)|(b)'] och: ['b'].
visa tillämpa: ['(a)|(b)'] och: ['a'].
visa tillämpa: ['(x)?y'] och: ['y'].
visa tillämpa: ['(x)?(y)(z)?'] och: ['xy'].
