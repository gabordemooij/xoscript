Utdata skriv: ['Testobjekt'], stop.
>> hälsare := Objekt ny.
hälsare vid: ['name:'] gör: { :namn
	egen xnamn := namn. 
}.
hälsare vid: ['hälsa'] gör: {
	Utdata skriv: ['Hallå '] + egen xnamn, stop.
}.
hälsare name: ['Sherlock'].
hälsare save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== LADDAR OM SNAP:'], stop.
>> b := Objekt load-from: ['/tmp/a.bin'].
b hälsa.
b name: ['Watson'], hälsa.
