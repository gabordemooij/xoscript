
>> city := Lista ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Lista ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature efter: city.
>> cities := weather poster sortera: { :a :b <- (a jämför: b). }.
>> temperatures := weather värden sortera: { :a :b <- (a jämför: b) negativ?. }.

Utdata skriv: (cities sammanfoga: [',']), stop.
Utdata skriv: (temperatures sammanfoga: [',']), stop.
