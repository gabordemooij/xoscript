
>> stad := Lista ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperatur := Lista ← ['15'] ; ['16'] ; ['15'].
>> väder := temperatur efter: stad.
>> städer := väder poster sortera: { :a :b <- (a jämför: b). }.
>> temperaturer := väder värden sortera: { :a :b <- (a jämför: b) negativ?. }.

Utdata skriv: (städer sammanfoga: [',']), stop.
Utdata skriv: (temperaturer sammanfoga: [',']), stop.
