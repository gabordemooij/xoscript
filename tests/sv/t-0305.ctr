
Tal lär: ['plus:'] betyder: ['+'].
Tal vid: ['+'] gör: { :x
	>> kurs := 1.
	>> valutatyp := x beteckning.
	(valutatyp = ['euros']) sann: {
		kurs := 2.
	}. <- (själv plus: (x × kurs)).
}.
>> dollar := 3.
>> euros := 2.
dollar kvalificera: ['dollars'].
euros kvalificera: ['euros'].
>> pengar := dollar + euros.
Utdata skriv: pengar, stop.
