
Tal lär: ['plus:'] betyder: ['+'].
Tal vid: ['+'] gör: { :x
	>> rate := 1.
	>> currency := x beteckning.
	(currency = ['euros']) sann: {
		rate := 2.
	}. <- (själv plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars kvalificera: ['dollars'].
euros kvalificera: ['euros'].
>> money := dollars + euros.
Utdata skriv: money, stop.
