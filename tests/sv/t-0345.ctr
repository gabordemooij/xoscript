# testa fånga-allt-metoder
>> x13 := Objekt ny.
x13 vid: ['a'] gör: { :a Utdata skriv: 0, stop. }.
x13 vid: ['a:'] gör: { :a Utdata skriv: a, stop. <- 5. }.
x13 vid: ['a:b:'] gör: { :a :b Utdata skriv: (a + b), stop. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
