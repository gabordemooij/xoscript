Server init.
Utdata skriv: ['Database date test'], stop.

>> db := Maria-DB ny värd: ['localhost'],
	användarnamn: ['xo'], 
	lösenord: ['pass123'],
	databasnamn: ['xobase'],
	anslut.

>> sökparametrar :=
db fråga: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
hämta: { :row
	Utdata skriv: row datetest, stop.
}.
