>> randomizer := { :a :b
	>> minimum := ( a < b ) antingen: a eller: b.
	>> maximum := ( a > b ) antingen: a eller: b.
	>> x := Inget.
	{
		x := Tal mellan: a och: b.
		((x < minimum) eller: (x > maximum)) sann: { 
			Utdata skriv: (['Invalid value!']).
			Program avsluta.
		}.
	} 
	× 100. <- x.
}.
randomizer tillämpa: 0 och: 0.
