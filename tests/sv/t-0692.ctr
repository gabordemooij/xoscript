Server init.

Utdata skriv: (
	Mönster ny: ['^\\w+$'],
	matcha: ['test@example.com'] 
), stop. # 0 träffar, misslyckas på @ och .

Utdata skriv: (
	Mönster ny: ['^[^@]+@[^\.]+\.\\w+$'],
	matcha: ['test@example.com'] 
), stop. # 1 träff

Utdata skriv: (
	Mönster ny: ['[^@]+@[^\.]+\.\\w+'],
	matcha: ['test@example.com'] 
), stop. # 1 träff

Utdata skriv: (
	Mönster ny: ['([^@]+)@([^\.]+)\.\\w+'],
	matcha: ['test@example.com'] 
), stop. # 1 träff, grupper spelar ingen roll

Utdata skriv: (
	Mönster ny: ['[a-z]'],
	matcha: ['test@example.com'] 
), stop. # 14 träffar

Utdata skriv: (
	Mönster ny: ['.*'],
	matcha: ['test@example.com'] 
), stop. # 1 träff (alla)

Utdata skriv: (
	Mönster ny: ['(.*)'],
	matcha: ['test@example.com'] 
), stop. # 1 träff (alla)

Utdata skriv: (
	Mönster ny: ['\\s*[^@]+@[^\.]+\.\\w+'],
	matcha: ['test@example.com'] 
), stop. # 1 träff, inledande mellanslag valfritt, ignoreras