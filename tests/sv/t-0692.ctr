Server init.

Utdata skriv: (
	Mönster ny: ['^\\w+$'],
	matcha: ['test@example.com'] 
), stop. # 0 match, fails on @ and .

Utdata skriv: (
	Mönster ny: ['^[^@]+@[^\.]+\.\\w+$'],
	matcha: ['test@example.com'] 
), stop. # 1 match

Utdata skriv: (
	Mönster ny: ['[^@]+@[^\.]+\.\\w+'],
	matcha: ['test@example.com'] 
), stop. # 1 match

Utdata skriv: (
	Mönster ny: ['([^@]+)@([^\.]+)\.\\w+'],
	matcha: ['test@example.com'] 
), stop. # 1 match, groups dont matter

Utdata skriv: (
	Mönster ny: ['[a-z]'],
	matcha: ['test@example.com'] 
), stop. # 14 matches

Utdata skriv: (
	Mönster ny: ['.*'],
	matcha: ['test@example.com'] 
), stop. # 1 match (all)

Utdata skriv: (
	Mönster ny: ['(.*)'],
	matcha: ['test@example.com'] 
), stop. # 1 match (all)

Utdata skriv: (
	Mönster ny: ['\\s*[^@]+@[^\.]+\.\\w+'],
	matcha: ['test@example.com'] 
), stop. # 1 match, prefix space optional, gets ignored