Server init.

# skriv en testfil
>> f := Fil ny: ['/tmp/test.gif'].
f skriv: ['GIF87a01234567810'].

# servera filen
Server vidarebefordra: ['test.gif'] prefix: ['/tmp/'].

Utdata stop.

Utdata skriv: ['Utanför containern (säkerhet):'], stop.
{ Server vidarebefordra: ['../passwd'] prefix: ['/tmp/']. }
fånga: { :e Utdata skriv: e, stop. },
starta.

Utdata skriv: ['Ogiltigt prefix:'], stop.
{ Server vidarebefordra: ['test.gif'] prefix: ['z:\\']. }
fånga: { :e Utdata skriv: e, stop. },
starta.

Utdata skriv: ['Obefintlig fil:'], stop.
{ Server vidarebefordra: ['xxx.xxx'] prefix: ['/tmp/']. }
fånga: { :e Utdata skriv: e, stop. },
starta.
