>> t := Inget.

# du kan styra tidszonen vid
# tolkning så här:
Moment zon: ['CET'].
t := Moment från: ['1981-02-03 04:05:06'].
Utdata skriv: t, stop.

# nu med tidszonen CEST:
Moment zon: ['CEST'].
t := Moment från: ['1981-02-03 04:05:06'].
Utdata skriv: t, stop.

# fel om texten inte kan tolkas
{ Moment från: ['1900']. } fånga: { Inget. }, starta.
