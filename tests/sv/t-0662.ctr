>> t := Inget.

# you can control the time zone for
# parsing like this:
Moment zon: ['CET'].
t := Moment från: ['1981-02-03 04:05:06'].
Utdata skriv: t, stop.

# now using CEST time zone:
Moment zon: ['CEST'].
t := Moment från: ['1981-02-03 04:05:06'].
Utdata skriv: t, stop.

# error if string cannot be parsed
{ Moment från: ['1900']. } fånga: { Inget. }, starta.
