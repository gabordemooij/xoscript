

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program minneshantering: 0.

>> o := Objekt ny.
>> o2 := Objekt ny.
Utdata skriv: o Inget?, stop.
Utdata skriv: o typ, stop.
Utdata skriv: ( o lika-med: o ), stop.
Utdata skriv: ( o lika-med: o2 ), stop.
Utdata skriv: o jag-själv, stop.
Utdata skriv: ( o gör klar ), stop.

Program städa.

usedMemory1 := (Program minne ? 0).


o := Objekt ny.
o2 := Objekt ny.
Utdata skriv: o Inget?, stop.
Utdata skriv: o typ, stop.
Utdata skriv: ( o lika-med: o ), stop.
Utdata skriv: ( o lika-med: o2 ), stop.
Utdata skriv: o jag-själv, stop.
Utdata skriv: ( o gör klar ), stop.

Program städa.
usedMemory2 := (Program minne ? 0).


o := Objekt ny.
o2 := Objekt ny.
Utdata skriv: o Inget?, stop.
Utdata skriv: o typ, stop.
Utdata skriv: ( o lika-med: o ), stop.
Utdata skriv: ( o lika-med: o2 ), stop.
Utdata skriv: o jag-själv, stop.
Utdata skriv: ( o gör klar ), stop.

Program städa.
usedMemory3 := (Program minne ? 0).



( usedMemory1 = usedMemory2 och: usedMemory1 = usedMemory3, och: usedMemory2 = usedMemory3 ) sann: {
	Utdata skriv: ['No memory leaks here'].
}, falsk: {
	Utdata skriv: ['Leaking memory...'].
}.
