

>> använtMinne1 := 0.
>> använtMinne2 := 0.
>> använtMinne3 := 0.
>> använtMinne4 := 0.

Program minneshantering: 0.

>> o := Objekt ny.
>> o2 := Objekt ny.
Utdata skriv: o Inget?, stop.
Utdata skriv: o typ, stop.
Utdata skriv: ( o lika-med: o ), stop.
Utdata skriv: ( o lika-med: o2 ), stop.
Utdata skriv: o jag-själv, stop.
Utdata skriv: ( o gör klar ), stop.

Program städa.

använtMinne1 := (Program minne ? 0).


o := Objekt ny.
o2 := Objekt ny.
Utdata skriv: o Inget?, stop.
Utdata skriv: o typ, stop.
Utdata skriv: ( o lika-med: o ), stop.
Utdata skriv: ( o lika-med: o2 ), stop.
Utdata skriv: o jag-själv, stop.
Utdata skriv: ( o gör klar ), stop.

Program städa.
använtMinne2 := (Program minne ? 0).


o := Objekt ny.
o2 := Objekt ny.
Utdata skriv: o Inget?, stop.
Utdata skriv: o typ, stop.
Utdata skriv: ( o lika-med: o ), stop.
Utdata skriv: ( o lika-med: o2 ), stop.
Utdata skriv: o jag-själv, stop.
Utdata skriv: ( o gör klar ), stop.

Program städa.
använtMinne3 := (Program minne ? 0).



( använtMinne1 = använtMinne2 och: använtMinne1 = använtMinne3, och: använtMinne2 = använtMinne3 ) sann: {
	Utdata skriv: ['Inga minnesläckor här'].
}, falsk: {
	Utdata skriv: ['Läcker minne...'].
}.
