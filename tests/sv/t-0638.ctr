
Server init.
>> fg := HTTP-Förfrågan ny.
Utdata skriv: ['HTTP-GET d[]=']  + ( fg get-lista: ['d[]'] ), stop. # GET
Utdata skriv: ['HTTP-GET f[]=']  + ( fg get-lista: ['f[]'] ), stop. # GET
Utdata skriv: ['HTTP-POST e[]='] + ( fg post-lista: ['e[]'] ), stop. # GET
Utdata skriv: ['HTTP-POST c=']   + ( fg post: ['c'] ), stop. # GET
Utdata skriv: ['HTTP-POST xx=']  + ( fg post: ['xx'] ), stop. # GET
