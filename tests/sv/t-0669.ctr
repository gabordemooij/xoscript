# Lösenordshashning
Server init.

# Användaren anger ett lösenord
>> lösn := ['pass123'].

# Du lagrar det så här
>> hashen := Valv 
	lösenordshash: lösn.

# Sedan loggar användaren in
# Försök 1
>> a1 := ['abcd123'].
# Försök 2
>> a2 := ['pass123'].

# Verifiera
>> a := Valv 
	lösenordshash: hashen verifiera: a1.
	# misslyckat 
>> b := Valv
	lösenordshash: hashen verifiera: a2.
	# ok!

Utdata skriv: a, stop.
Utdata skriv: b, stop.

