# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Valv 
	lösenordshash: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Valv 
	lösenordshash: hash verifiera: a1.
	# fail 
>> b := Valv
	lösenordshash: hash verifiera: a2.
	# ok!

Utdata skriv: a, stop.
Utdata skriv: b, stop.

