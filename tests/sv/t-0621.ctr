>> phrases := Lista ny
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases varje: { :_ :phrase 
	>> e := Server base64-koda: phrase.
	>> d := Server base64-avkoda: e.
	Utdata skriv: (
		message kopiera ~encoded: e, ~decoded: d
	), stop.
}.
