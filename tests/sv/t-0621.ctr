>> fraser := Lista ny
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> meddelandet := ['Phrase: ~decoded base64: ~encoded'].
	
fraser varje: { :_ :fras 
	>> e := Server base64-koda: fras.
	>> d := Server base64-avkoda: e.
	Utdata skriv: (
		meddelandet kopiera ~encoded: e, ~decoded: d
	), stop.
}.
