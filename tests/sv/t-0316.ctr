>> Grandfather := Objekt ny.
Grandfather vid: ['greet'] gör: {
	Utdata skriv: ['Ave!'], stop.
}.
>> Father := Grandfather ny.
Father vid: ['greet'] gör: {
	Utdata skriv: ['Hello'], stop.
	själv greet.
}.
>> Son := Father ny.
Son vid: ['greet'] gör: {
	Utdata skriv: ['Hi'], stop.
	själv greet.
}.

Son greet.

>> Roundabout := Objekt ny.
Roundabout vid: ['circle:'] gör: { :x
	Utdata skriv: x, stop.
	(x < 3) sann: { själv rekursiv circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) sann: { Utdata skriv: x, stop. x lägg-till: 1.  increment starta. }. }.
increment starta.