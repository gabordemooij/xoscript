


>> vin := Objekt ny.


vin vid: ['tillText'] gör: { <- ['merlot'].
}.

vin vid: ['naarTekst'] gör: { <- ['merlot'].
}.


vin vid: ['='] gör: { :other wine <- ( själv tillText = other wine ).
}.

vin vid: ['=='] gör: { :other wine <- ( själv tillText = other wine ).
}.



vin
	fall: ['cabernet'] gör: { Utdata skriv: ['det är en Cabernet!']. },
	fall: ['syrah']    gör: { Utdata skriv: ['det är en Syrah!'].    },
	fall: ['merlot']   gör: { Utdata skriv: ['det är en Merlot!'].   },
	fall: ['malbec']   gör: { Utdata skriv: ['det är en Malbec!'].   }.

Utdata stop.
