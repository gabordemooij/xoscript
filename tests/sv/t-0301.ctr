


>> wine := Objekt ny.


wine vid: ['toString'] gör: { <- ['merlot'].
}.

wine vid: ['naarTekst'] gör: { <- ['merlot'].
}.


wine vid: ['='] gör: { :other wine <- ( själv toString = other wine ).
}.

wine vid: ['=='] gör: { :other wine <- ( själv toString = other wine ).
}.



wine
	fall: ['cabernet'] gör: { Utdata skriv: ['it's a Cabernet!']. },
	fall: ['syrah']    gör: { Utdata skriv: ['it's a Syrah!'].    },
	fall: ['merlot']   gör: { Utdata skriv: ['it's a Merlot!'].   },
	fall: ['malbec']   gör: { Utdata skriv: ['it's a Malbec!'].   }.

Utdata stop.
