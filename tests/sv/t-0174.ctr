


>> använtMinne1 := 0.
>> använtMinne2 := 0.
>> använtMinne3 := 0.
>> använtMinne4 := 0.

Program minneshantering: 0.
>> palett := Inget.
>> färger := Inget.

{
palett := Ordbok ny.
palett 
	sätt: ['#F00'] vid: ['röd'],
	sätt: ['#0F0'] vid: ['grön'],
	sätt: ['#00F'] vid: ['blå'].
Utdata skriv: ['antal RGB-koder i paletten: '] + ( palett antal ), stop.
Utdata skriv: ['RGB-koden för grön är: '] + ( palett ? ['grön'] ), stop.
färger := [''].
( palett varje: { :namn :code
		färger := färger + ( namn + [':'] + code ).
} ).
Utdata skriv: ['Alla färger i paletten: '] + färger, stop.
} starta.
Program städa.
använtMinne1 := (Program minne ? 0).

{
palett := Ordbok ny.
palett 
	sätt: ['#F00'] vid: ['röd'],
	sätt: ['#0F0'] vid: ['grön'],
	sätt: ['#00F'] vid: ['blå'].
Utdata skriv: ['antal RGB-koder i paletten: '] + ( palett antal ), stop.
Utdata skriv: ['RGB-koden för grön är: '] + ( palett ? ['grön'] ), stop.
färger := [''].
( palett varje: { :namn :code
		färger := färger + ( namn + [':'] + code ).
} ).
Utdata skriv: ['Alla färger i paletten: '] + färger, stop.
} starta.
Program städa.
använtMinne2 := (Program minne ? 0).

{
palett := Ordbok ny.
palett 
	sätt: ['#F00'] vid: ['röd'],
	sätt: ['#0F0'] vid: ['grön'],
	sätt: ['#00F'] vid: ['blå'].
Utdata skriv: ['antal RGB-koder i paletten: '] + ( palett antal ), stop.
Utdata skriv: ['RGB-koden för grön är: '] + ( palett ? ['grön'] ), stop.
färger := [''].
( palett varje: { :namn :code
		färger := färger + ( namn + [':'] + code ).
} ).
Utdata skriv: ['Alla färger i paletten: '] + färger, stop.
} starta.
Program städa.
använtMinne3 := (Program minne ? 0).



( använtMinne1 = använtMinne2 och: använtMinne1 = använtMinne3, och: använtMinne2 = använtMinne3 ) sann: {
	Utdata skriv: ['Inga minnesläckor här'].
}, falsk: {
	Utdata skriv: ['Läcker minne...'].
}.
