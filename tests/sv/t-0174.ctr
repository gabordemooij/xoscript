


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program minneshantering: 0.
>> palette := Inget.
>> colors := Inget.

{
palette := Ordbok ny.
palette 
	sätt: ['#F00'] vid: ['red'],
	sätt: ['#0F0'] vid: ['green'],
	sätt: ['#00F'] vid: ['blue'].
Utdata skriv: ['number of RGB codes in palette: '] + ( palette antal ), stop.
Utdata skriv: ['RGB code of green is: '] + ( palette ? ['green'] ), stop.
colors := [''].
( palette varje: { :namn :code
		colors := colors + ( namn + [':'] + code ).
} ).
Utdata skriv: ['All colors in palette: '] + colors, stop.
} starta.
Program städa.
usedMemory1 := (Program minne ? 0).

{
palette := Ordbok ny.
palette 
	sätt: ['#F00'] vid: ['red'],
	sätt: ['#0F0'] vid: ['green'],
	sätt: ['#00F'] vid: ['blue'].
Utdata skriv: ['number of RGB codes in palette: '] + ( palette antal ), stop.
