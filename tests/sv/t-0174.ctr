colors := [''].
( palette varje: { :namn :code
		colors := colors + ( namn + [':'] + code ).
} ).
Utdata skriv: ['All colors in palette: '] + colors, stop.
} starta.
Program städa.
usedMemory2 := (Program minne ? 0).

{
palette := Ordbok ny.
palette 
	sätt: ['#F00'] vid: ['red'],
	sätt: ['#0F0'] vid: ['green'],
	sätt: ['#00F'] vid: ['blue'].
Utdata skriv: ['number of RGB codes in palette: '] + ( palette antal ), stop.
Utdata skriv: ['RGB code of green is: '] + ( palette ? ['green'] ), stop.
colors := [''].
( palette varje: { :namn :code
		colors := colors + ( namn + [':'] + code ).
} ).
Utdata skriv: ['All colors in palette: '] + colors, stop.
} starta.
Program städa.
usedMemory3 := (Program minne ? 0).



( usedMemory1 = usedMemory2 och: usedMemory1 = usedMemory3, och: usedMemory2 = usedMemory3 ) sann: {
	Utdata skriv: ['No memory leaks here'].
}, falsk: {
	Utdata skriv: ['Leaking memory...'].
}.
