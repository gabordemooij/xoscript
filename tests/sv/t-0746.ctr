Utdata skriv: ['Test object'], stop.
>> a := Objekt ny. 

a vid: ['item:'] gör: { :dict
	egen dict := dict. 
}.

a vid: ['item'] gör: { <- egen dict.
}.

a item: (
Ordbok ny
	hello: ['world'],
	world: (Ordbok ny sätt: ['a'] vid: ['b'])).

Utdata skriv: a item, stop.

>> old-dict-address := a item prototyp minnesadress.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== RELOADING SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp minnesadress = old-dict-address) sann: {
	Utdata skriv: ['Object link re-attached.'], stop.
}.

Utdata skriv: b item, stop.
