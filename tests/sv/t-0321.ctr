# testa beteckningar

Program städa.

>> Frukt := Objekt ny.
Frukt vid: ['ny'] gör: {
	>> f := själv ny.
	f apples: 0. <- f.
}.
Frukt vid: ['apples:'] gör: { :a egen äpplen := a. }.
Frukt vid: ['äpplen'] gör: { <- egen äpplen. }.
Frukt vid: ['+'] gör: { :f
	>> n := Frukt ny.
	n apples: (f äpplen + egen äpplen). <- n.
}.
Tal vid: ['äpplen'] gör: { <- ((Frukt ny) apples: själv).
}.

Frukt vid: ['text'] gör: { <- egen äpplen + [' äpplen '].
}.

>> q := 3 äpplen + 4 äpplen.
Utdata skriv: q, stop.




q := 3 äpplen + 4 äpplen.
Utdata skriv: q, stop.



q := 3 äpplen + 4 äpplen.
Utdata skriv: q, stop.


