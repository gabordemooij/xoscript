# test qualifiers

Program städa.

>> Fruit := Objekt ny.
Fruit vid: ['ny'] gör: {
	>> f := själv ny.
	f apples: 0. <- f.
}.
Fruit vid: ['apples:'] gör: { :a egen apples := a. }.
Fruit vid: ['apples'] gör: { <- egen apples. }.
Fruit vid: ['+'] gör: { :f
	>> n := Fruit ny.
	n apples: (f apples + egen apples). <- n.
}.
Tal vid: ['apples'] gör: { <- ((Fruit ny) apples: själv).
}.

Fruit vid: ['text'] gör: { <- egen apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Utdata skriv: q, stop.




q := 3 apples + 4 apples.
Utdata skriv: q, stop.



q := 3 apples + 4 apples.
Utdata skriv: q, stop.


