>> vingård := { <- (	Ordbok ny
		sätt: 2 vid: ['merlot'],
		sätt: 3 vid: ['malbec'],
		sätt: 4 vid: ['syrah']
	).
}.

Utdata skriv: (((vingård starta) - ['ingenting']) antal), stop.
Utdata skriv: (((vingård starta) - ['merlot']) antal), stop.
Utdata skriv: (((vingård starta) - ['malbec']) antal), stop.
Utdata skriv: (((vingård starta) - ['syrah']) antal), stop.
Utdata skriv: (((vingård starta) - ['merlot'] - ['malbec']) antal), stop.
Utdata skriv: (((vingård starta) - ['merlot'] - ['syrah']) antal), stop.
Utdata skriv: (((vingård starta) - ['malbec'] -['syrah']) antal), stop.
Utdata skriv: (((vingård starta) - ['malbec'] - ['syrah'] - ['merlot']) antal), stop.

