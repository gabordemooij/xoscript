#regex test
Server init.
>> subject := ⌝'<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'⌜.
>> pattern := بېلګه نوی: ⌝'href="([^"]+)" target="([^"]+)"'⌜.
>> result := pattern سمون: subject وکړه: ⎬ :m :x
	وتنه ولیکه: m, نوې-کرښه.
	وتنه ولیکه: x, نوې-کرښه. <- ⌝'XXX'⌜.
⎨.
وتنه ولیکه: result, نوې-کرښه.