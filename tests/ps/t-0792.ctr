Server init.

>> DB := Maria-DB نوی کوربه: ⌝'localhost'⌜,
	کارن-نوم: ⌝'xo'⌜,
	پټنوم: ⌝'pass123'⌜,
	د-ډیټابیس-نوم: ⌝'xobase'⌜,
	ونښله.
	
>> SQL := ⌝'SELECT "hello" AS "world" '⌜.

# a quicker way, get query from DB:
>> query2 := DB پوښتنه: SQL.

# now you don't have to set DB
query2 راوړه: ⎬ :row
	وتنه ولیکه: row world, نوې-کرښه.
⎨.
