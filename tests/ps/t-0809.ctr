# backslashes must survive code serialization, strings must not end early
>> ارزښتونه := لیست نوی
	; ⌝'C:\\new'⌜
	; ⌝'ends with backslash \\'⌜
	; ⌝'\\\\'⌜
	; ⌝'x\\\'] at: 9, put: 1 at: 2).'⌜.

ارزښتونه هر-یو: ⎬ :i :value
	>> d := قاموس نوی.
	d کېږده: value کیلي: ⌝'k'⌜.
	>> r := d کوډ په-څیز.
	وتنه ولیکه: r شمېر, نوې-کرښه.
	وتنه ولیکه: ﴿ ﴿r په: ⌝'k'⌜﴾ = value ﴾, نوې-کرښه.
⎨.
