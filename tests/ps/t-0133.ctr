


>> Deck := لیست نوی.
Deck کله: ⌝'print'⌜ وکړه: ⎬
        >> len := ځان شمېر - 1.
        ⎬ :i
                >> len2 := ځان شمېر - 1.
                وتنه ولیکه: ⌝'len: '⌜.
                وتنه ولیکه: len, نوې-کرښه.
                وتنه ولیکه: ⌝'len2: '⌜.
                وتنه ولیکه: len2, نوې-کرښه.
        ⎨ × len.
⎨.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
