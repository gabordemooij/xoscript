
>> Rectangle := څیز نوی.

Rectangle کله: ⌝'area'⌜ وکړه: ⎬ <- خپل اوږدوالی * خپل width.
⎨.

Rectangle کله: ⌝'length:'⌜ وکړه: ⎬ :اوږدوالی
	خپل اوږدوالی := اوږدوالی.
⎨.

Rectangle کله: ⌝'width:'⌜ وکړه: ⎬ :width
	خپل width := width.
⎨.

Rectangle کله: ⌝'نوی'⌜ وکړه: ⎬
	# this will not result into an infinite loop
	>> rectangle := ځان نوی.
	rectangle length: 0, width: 0. <- rectangle.
⎨.

>> a := Rectangle نوی.
وتنه ولیکه: a area, نوې-کرښه. #0

>> b := Rectangle نوی length: 2, width: 3.
وتنه ولیکه: b area, نوې-کرښه. #6

