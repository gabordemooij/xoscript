# Password hashing
Server init.

# User sets a password
>> passw := ⌝'pass123'⌜.

# You store it like this
>> hash := خزانه 
	د-پټنوم-هش: passw.

# Then, user logs in
# Attempt 1
>> a1 := ⌝'abcd123'⌜.
# Attempt 2
>> a2 := ⌝'pass123'⌜.

# Verify
>> a := خزانه 
	د-پټنوم-هش: hash تایید: a1.
	# fail 
>> b := خزانه
	د-پټنوم-هش: hash تایید: a2.
	# ok!

وتنه ولیکه: a, نوې-کرښه.
وتنه ولیکه: b, نوې-کرښه.

