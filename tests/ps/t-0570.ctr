#Linux

 >> t := شیبه نوی.
 
t وخت-سیمه: ⌝'Europe/Amsterdam'⌜.
t کال: 2020, میاشت: 8, ورځ: 2, ساعت: 21, دقیقه: 2, ثانیه: 1.

>> a := t ساعت.
>> ams := t وخت-سیمه.

t وخت-سیمه: ⌝'US/Hawaii'⌜.
>> b := t ساعت.
>> hw := t وخت-سیمه.

وتنه
ولیکه: ﴿
	⌝'It's diff in zone2 than in zone1'⌜
	zone1: ams,
	zone2: hw,
	diff: ﴿
		﴿b > a﴾
		دا: ⌝'later'⌜ یا-هغه: ⌝'earlier'⌜
	﴾
﴾,
نوې-کرښه.
 