>> Slurp := څیز نوی.

Slurp کله: ⌝'نوی'⌜ وکړه: ⎬
	خپل str := ⌝''⌜.
⎨.

Slurp کله: ⌝'ځواب:'⌜ وکړه: ⎬ :blah
		﴿خپل str = ⌝''⌜﴾ که-رښتیا: ⎬
			خپل str پای-ته-زیات-کړه: blah.
		⎨, که-نه: ⎬
			خپل str پای-ته-زیات-کړه: ⌝' '⌜.
			خپل str پای-ته-زیات-کړه: blah.
		⎨.
⎨.

Slurp کله: ⌝'ځواب:او:'⌜ وکړه: ⎬ :blah :blahah
		﴿blah اوږدوالی > 1﴾ که-رښتیا: ⎬
			خپل str پای-ته-زیات-کړه: ﴿blah پیل: 0 اوږدوالی: ﴿blah اوږدوالی - 1﴾﴾.
		⎨, که-نه: ⎬
			خپل str پای-ته-زیات-کړه: blah.
		⎨.
		خپل str پای-ته-زیات-کړه: ⌝' '⌜.
		خپل str پای-ته-زیات-کړه: blahah.
⎨.

Slurp کله: ⌝'obtain'⌜ وکړه: ⎬
	>> buffer := خپل str.
	خپل str := ⌝''⌜. <- buffer.
⎨.


>> x := Slurp نوی.
x + 3.
وتنه ولیکه: ﴿x obtain﴾, نوې-کرښه.
x echo: ⌝'Hello world'⌜.
وتنه ولیکه: ﴿x obtain﴾, نوې-کرښه.
x tellme: 123 and: 987.
وتنه ولیکه: ﴿x obtain﴾, نوې-کرښه.
