>> Animal := څیز نوی.
Animal کله: ⌝'make'⌜ وکړه: ⎬
	>> animal := څیز نوی.
	animal کله: ⌝'makeSound'⌜ وکړه: ⎬
		وتنه ولیکه: خپل sound.
	⎨. <- animal.
⎨.
>> Cat := څیز نوی.
Cat کله: ⌝'make'⌜ وکړه: ⎬
	>> cat := Animal make.
	cat کله: ⌝'init'⌜ وکړه: ⎬
		خپل sound := ⌝'meow!'⌜.
	⎨.
	cat init. <- cat.
⎨.
>> tom := Cat make.
tom makeSound.
