>> Greeter := څیز نوی.
Greeter کله: ⌝'make'⌜ وکړه: ⎬
	>> gr := څیز نوی.
	gr کله: ⌝'setName:'⌜ وکړه: ⎬ :aname
		خپل نوم := aname.
	⎨.
	gr کله: ⌝'greet'⌜ وکړه: ⎬
		وتنه ولیکه: خپل نوم.
	⎨. <- gr.
⎨.
>> a := Greeter make.
>> b := Greeter make.
a setName: ⌝'ONE'⌜.
b setName: ⌝'TWO'⌜.
a greet.
b greet.
>> c := a نوی.
c setName: ⌝'THREE'⌜.
c greet.
>> d := a نوی.
d setName: ⌝'FOUR'⌜.
d greet.
c greet.
