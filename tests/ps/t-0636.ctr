# test url parsing

Server init.
>> url := URL له: ⌝'https://xoscript.com:1234/a/b/c?test=1#hello'⌜.

وتنه ولیکه: ⌝'scheme = '⌜ + url طرحه, نوې-کرښه.
وتنه ولیکه: ⌝'host = '⌜ + url کوربه, نوې-کرښه.
وتنه ولیکه: ⌝'port = '⌜ + url پورټ, نوې-کرښه.
وتنه ولیکه: ⌝'path = '⌜ + url د-دوتنې-لار, نوې-کرښه.
وتنه ولیکه: ⌝'query = '⌜ + url د-لټون-پارامترونه, نوې-کرښه.
وتنه ولیکه: ⌝'fragment = '⌜ + url ټوټه, نوې-کرښه.
