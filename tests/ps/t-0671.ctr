# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := خزانه کیلي-ګانې-جوړې-کړه.

# private (secret) key
>> sk := keys لومړی.

# public key
>> pk := keys وروستی.

# sign a message
>> sig := خزانه لاسلیک: ⌝'abc'⌜ په-کیلي: sk.

# check message (ok)
وتنه ولیکه: ﴿ 
	خزانه
		وګوره: ⌝'abc'⌜ 
		لاسلیک: sig 
		په-کیلي: pk 
﴾, نوې-کرښه.

# check message (fail)
وتنه ولیکه: ﴿ 
	خزانه 
		وګوره: ⌝'abd'⌜ 
		لاسلیک: sig 
		په-کیلي: pk 
﴾, نوې-کرښه.