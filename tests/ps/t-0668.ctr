# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob نوی: 8, بایټونه: ﴿
	لیست نوی ; شپاړس-اساسه x41 ; شپاړس-اساسه x00 ; شپاړس-اساسه x3D ; شپاړس-اساسه xD8
	         ; شپاړس-اساسه x0A ; شپاړس-اساسه xDE ; شپاړس-اساسه x42 ; شپاړس-اساسه x00
﴾.

وتنه ولیکه: ﴿ utf16 کوډ-خلاصول: ⌝'utf16le'⌜ ﴾, نوې-کرښه.

utf16 ازاد-کړه.
>> utf32 := Blob نوی: 13, بایټونه: ﴿
	لیست نوی ; شپاړس-اساسه x00 ; شپاړس-اساسه x00 ; شپاړس-اساسه x00 ; شپاړس-اساسه x41
	         ; شپاړس-اساسه x00 ; شپاړس-اساسه x01 ; شپاړس-اساسه xF6 ; شپاړس-اساسه x0A
	         ; شپاړس-اساسه x00 ; شپاړس-اساسه x00 ; شپاړس-اساسه x00 ; شپاړس-اساسه x42
	         ; شپاړس-اساسه x00
﴾.

وتنه ولیکه: ﴿ utf32 کوډ-خلاصول: ⌝'utf32be'⌜ ﴾, نوې-کرښه.
utf32 ازاد-کړه.