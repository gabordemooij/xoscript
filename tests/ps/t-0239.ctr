لیست کله: ⌝'sum'⌜ وکړه: ⎬
	>> total := 0.
	ځان هر-یو: ⎬ :index :element
		total جمع: element.
	⎨. <- total.
⎨.

>> a := رښتیا.



a کله: ⌝'په-متن'⌜ وکړه: ⎬
	>> answer := هیڅ.
	﴿ ځان = رښتیا ﴾ که-رښتیا: ⎬
		answer := ⌝'Yep'⌜.
	⎨, که-نه: ⎬
		answer := ⌝'Nope'⌜.
	⎨. <- answer.
⎨.

a کله: ⌝'په-شمیره'⌜ وکړه: ⎬
	>> answer := هیڅ.
	﴿ ځان = رښتیا ﴾ که-رښتیا: ⎬
		answer := 10.
	⎨, که-نه: ⎬
		answer := 20.
	⎨. <- answer.
⎨.

>> b := 666.

b کله: ⌝'په-متن'⌜ وکړه: ⎬ <- ⌝'Devil'⌜.
⎨.

b کله: ⌝'په-بولین'⌜ وکړه: ⎬ <- دروغ.
⎨.


وتنه ولیکه: a, نوې-کرښه.  
وتنه ولیکه: ﴿90 + a﴾, نوې-کرښه. 
وتنه ولیکه: b, نوې-کرښه. 
وتنه ولیکه: ﴿رښتیا او: b﴾, نوې-کرښه.

a := لیست ← ⌝'hello'⌜ ; ⌝'world'⌜ ; رښتیا ; هیڅ ; 666. 
a := a + ﴿ لیست ← 1 ﴾.
وتنه ولیکه: a, نوې-کرښه.
وتنه ولیکه: ﴿﴿قاموس نوی﴾ کېږده: هیڅ کیلي: هیڅ﴾, نوې-کرښه.
وتنه ولیکه: a sum, نوې-کرښه. 


⎬
	a کله: ⌝'په-متن'⌜ وکړه: ⎬ <- هیڅ. ⎨.
	a := ⌝''⌜ + a.
⎨ ونیسه: ⎬ :error
	وتنه ولیکه: ⌝'Error noted: '⌜ + error, نوې-کرښه.
⎨, چلول.



