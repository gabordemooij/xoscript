

لیست کله: ⌝'column:'⌜ وکړه: ⎬ :column
	>> result := لیست نوی.
	ځان هر-یو: ⎬ :index :row
		row هر-یو: ⎬ :index :cell
			﴿index = column﴾ که-رښتیا: ⎬ result پای-ته-زیات-کړه: cell. ⎨.
		⎨.
	⎨. <- result.
⎨.


>> a := لیست ←
	﴿لیست ← 1 ; 2 ; 3﴾ ;
	﴿لیست ← 4 ; 5 ; 6﴾ ;
	﴿لیست ← 7 ; 8 ; 9﴾.

>> b := a column: 1.
وتنه ولیکه: b, نوې-کرښه.

b := a column: 20.
وتنه ولیکه: b, نوې-کرښه.

b := a column: -100.
وتنه ولیکه: b, نوې-کرښه.
