>> phrases := لیست نوی
	~ ⌝'abcd'⌜
	~ ⌝'hello world'⌜
	~ ⌝''⌜
	~ ⌝'@.,;"'⌜
	~ ⌝'this is a much much longer string to be encoded!'⌜.

>> message := ⌝'Phrase: ~decoded base64: ~encoded'⌜.
	
phrases هر-یو: ⎬ :_ :phrase 
	>> e := Server base64-کوډول: phrase.
	>> d := Server base64-کوډ-خلاصول: e.
	وتنه ولیکه: ﴿
		message کاپي ~encoded: e, ~decoded: d
	﴾, نوې-کرښه.
⎨.
