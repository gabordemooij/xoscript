# database test
# see example server.xo for required config

Server init.
وتنه ولیکه: ⌝'Database test'⌜, نوې-کرښه.

>> db := Maria-DB نوی کوربه: ⌝'localhost'⌜,
	کارن-نوم: ⌝'xo'⌜, پټنوم: ⌝'pass123'⌜, د-ډیټابیس-نوم: ⌝'xobase'⌜, ونښله.

وتنه ولیکه: ⌝'Can we connect? '⌜ + db نښتی?, نوې-کرښه.

>> د-لټون-پارامترونه := db پوښتنه: ⌝'
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'⌜, پارامترونه: ﴿ لیست نوی ; ⌝'abc'⌜ ; 12.35 ; 6 ﴾. # parameterized queries

⎬  د-لټون-پارامترونه اجرا-کړه. db تایید-کړه. ⎨ ونیسه: ⎬ :e db بېرته-واړوه.  ⎨, چلول.

وتنه ولیکه: ⌝'Can we insert? '⌜ + ﴿ د-لټون-پارامترونه insert-id > 0 ﴾, نوې-کرښه.

>> x := 0.
>> د-لټون-پارامترونه :=
db پوښتنه: ⌝'SELECT * FROM book order by id desc limit 2'⌜, 
راوړه: ⎬ :row 
	x جمع: 1.
	رښتیا مات-کړه. # must clean up, no 'Commands out of sync'
⎨.

>> د-لټون-پارامترونه :=
db پوښتنه: ⌝'SELECT * FROM book order by id desc limit 2'⌜, 
راوړه: ⎬ :row
	x جمع: 1.
	رښتیا مات-کړه.
⎨.

﴿x > 0﴾ که-رښتیا: ⎬
	وتنه ولیکه: ⌝'Can we break in the middle of a fetch? '⌜.
⎨.

وتنه ولیکه: رښتیا, نوې-کرښه.