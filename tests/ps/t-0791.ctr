Server init.

>> DB := Maria-DB نوی کوربه: ⌝'localhost'⌜,
	کارن-نوم: ⌝'xo'⌜,
	پټنوم: ⌝'pass123'⌜,
	د-ډیټابیس-نوم: ⌝'xobase'⌜,
	ونښله.
	
>> SQL := ⌝'SELECT "hello" AS "world" '⌜.

# manually create query
>> د-لټون-پارامترونه := پوښتنه-Maria نوی: SQL.

# set database
د-لټون-پارامترونه ډیټابیس: DB.

د-لټون-پارامترونه راوړه: ⎬ :row
	وتنه ولیکه: row world, نوې-کرښه.
⎨.
