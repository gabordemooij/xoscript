>> map1 := قاموس نوی.
>> key1 := لیست نوی.
>> key2 := لیست نوی.

map1
	کېږده: ⌝'hello'⌜ کیلي: key1,
	کېږده: ⌝'world'⌜ کیلي: key2.


وتنه
	ولیکه: ⌝'Map #1 contains: '⌜ + ﴿map1 په: key1﴾,
	ولیکه: ⌝' and '⌜ + ﴿map1 په: key2﴾, نوې-کرښه.

>> KeyeableArray := لیست نوی.
KeyeableArray کله: ⌝'toString'⌜ وکړه: ⎬ <- ﴿ځان شمېر﴾ toString.
⎨.

>> map2 := قاموس نوی.
key1 := KeyeableArray نوی.
key2 := KeyeableArray نوی.

key1 پای-ته-زیات-کړه: 1.

map2
	کېږده: ⌝'hello'⌜ کیلي: key1,
	کېږده: ⌝'world'⌜ کیلي: key2.

وتنه
	ولیکه: ⌝'Map #2 contains: '⌜ + ﴿map2 په: key1﴾,
	ولیکه: ⌝' and '⌜ + ﴿map2 په: key2﴾, نوې-کرښه.
