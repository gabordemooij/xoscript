

>> g := Server نوی.
>> v := خزانه نوی.
>> ok := 0.

>> secrets := لیست نوی ; 
	 ⌝'aaa'⌜ ;
	 ⌝''⌜ ; 
	 ⌝'AB'⌜ ;
	 ⌝'abcdefghijklmnopqrstuvwxyz0123456789'⌜ ; 
	 ⌝'!@--+467hdHJKJs__=3hjsakd'⌜ ;
	 ⌝'spaces and	tabs'⌜ ;
	 ⌝'漢字'⌜ ;
	 ⌝'==[abc]=='⌜.
	
>> passwords := secrets کاپي.
passwords هر-یو: ⎬ :i :p
	secrets هر-یو: ⎬ :n :s
		⎬
			>> encrypted := v کوډ-کړه: s کیلي: p.
			>> decrypted := v کوډ-پرانیزه: encrypted کیلي: p.
			﴿decrypted = s﴾ که-رښتیا: ⎬
				ok جمع: 1.
			⎨, که-نه: ⎬
				وتنه ولیکه: ⌝'failed encrypting/decrypting: '⌜, نوې-کرښه.
				وتنه ولیکه: s, نوې-کرښه.
				وتنه ولیکه: ⌝'encrypted: '⌜ + encrypted, نوې-کرښه.
				وتنه ولیکه: ⌝'decrypted: '⌜ + encrypted, نوې-کرښه.
				پروګرام پای.
			⎨.
		⎨ ونیسه: ⎬ :err
			﴿s = ⌝''⌜ یا: p = ⌝''⌜﴾ که-رښتیا: ⎬
				ok جمع: 1.
			⎨, که-نه: ⎬
				وتنه ولیکه: err, نوې-کرښه.
				پروګرام پای.
			⎨.
		⎨, چلول.
	⎨.
⎨.

وتنه ولیکه: ﴿ ok + ⌝' vault encryptions tested.'⌜ ﴾, نوې-کرښه.