Server init.

# JSON encoder only supports UTF-8, no surrogate pairs

>> dicts := لیست نوی ;
	# {"key":"normal"} normal ASCII
	﴿ قاموس نوی کېږده: ⌝'normal'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"hello world"} space character
	﴿ قاموس نوی کېږده: ⌝'hello world'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"quote: \""} double quote
	﴿ قاموس نوی کېږده: ⌝'"'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"backslash: \\"} backslash
	﴿ قاموس نوی کېږده: ⌝'backslash: \\'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"slash: /"} slash
	﴿ قاموس نوی کېږده: ⌝'slash: /'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"backspace: \b"} backspace
	﴿ قاموس نوی کېږده: ⌝'backspace: \b'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"formfeed: \f"} form-feed escape
	﴿ قاموس نوی کېږده: ⌝'formfeed: \f'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"newline: \n"} newline
	﴿ قاموس نوی کېږده: ⌝'newline: \n'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	﴿ قاموس نوی کېږده: ⌝'newline: ↵'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	﴿ قاموس نوی کېږده: ⌝'newline: 
	'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"carriage return: \r"} carriage-return
	﴿ قاموس نوی کېږده: ⌝'carriage return: \r'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"tab: \t"} tab
	﴿ قاموس نوی کېږده: ⌝'tab \t'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	﴿ قاموس نوی کېږده: ⌝'tab ⇿'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	﴿ قاموس نوی کېږده: ⌝'tab  '⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u0000"} NUL
	﴿ قاموس نوی کېږده: ⌝'NUL \u0000'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	﴿ قاموس نوی کېږده: ⌝'NUL \0'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u0001"} control character 0x01
	﴿ قاموس نوی کېږده: ⌝'control: \u0001'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u001F"} control character 0x1F
	﴿ قاموس نوی کېږده: ⌝'control: \u001F'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: é"} UTF-8, 2-byte char
	﴿ قاموس نوی کېږده: ⌝'unicode: é'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: €"} UTF-8, 3-byte char
	﴿ قاموس نوی کېږده: ⌝'unicode: €'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 日本語"} multiple 3-byte UTF-8 chars
	﴿ قاموس نوی کېږده: ⌝'unicode: 日本語'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 😀"} UTF-8, 4-byte char
	﴿ قاموس نوی کېږده: ⌝'unicode: 😀'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	﴿ قاموس نوی کېږده: ⌝'unicode: 🧑‍💻'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"combining: e\u0301"} combining accent
	﴿ قاموس نوی کېږده: ⌝'combining: e\u0301'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: \u00e9"} Unicode escape BMP
	﴿ قاموس نوی کېږده: ⌝'escaped unicode: \u00e9'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: \u20ac"} Unicode escape BMP
	﴿ قاموس نوی کېږده: ⌝'escaped unicode: \u20ac'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: \ud83d\ude00"} UTF-16 surrogate pair
	﴿ قاموس نوی کېږده: ⌝'escaped unicode: \ud83d\ude00'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":""} empty value
	﴿ قاموس نوی کېږده: ⌝''⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"@ < > & = % + ? #"} special ASCII chars
	﴿ قاموس نوی کېږده: ⌝'@ < > & = % + ? #'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"single quote: '"} single quote
	﴿ قاموس نوی کېږده: ⌝'''⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"multiple: \" \\ \n \r \t"} multiple JSON escapes
	﴿ قاموس نوی کېږده: ⌝'multiple: \" \\ \n \r \t'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} longer ASCII-string
	﴿ قاموس نوی کېږده: ⌝'aaaaaaaaaaaaaaaaaaaaaaaaaa'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":" value"} leading space
	﴿ قاموس نوی کېږده: ⌝' value'⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":"value "} trailing space
	﴿ قاموس نوی کېږده: ⌝'value '⌜ کیلي: ⌝'key'⌜ ﴾ ;
	# {"key":" \t\n\r "} whitespace
	﴿ قاموس نوی کېږده: ⌝' \t\n\r '⌜ کیلي: ⌝'key'⌜ ﴾.

dicts هر-یو: ⎬ :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: ﴿قاموس نوی کېږده: d key کیلي: ⌝'key'⌜﴾.
	>> b := JSON jsonify: ﴿قاموس نوی کېږده: ⌝'value'⌜ کیلي: d key﴾.
	>> e := JSON څیز: a.
	>> f := JSON څیز: b.
	﴿﴿e key = d key او: ﴿f ? d key = ⌝'value'⌜﴾﴾ یا: ﴿e key = ⌝'NUL ?'⌜﴾﴾ که-رښتیا: ⎬
		وتنه ولیکه: ⌝'OK'⌜, نوې-کرښه.
	⎨, که-نه: ⎬
		وتنه ولیکه: ⌝'Unable to properly encode/decode: '⌜ + d + j, نوې-کرښه.
		پروګرام پای.
	⎨.
⎨.
