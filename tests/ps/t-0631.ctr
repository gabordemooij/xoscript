#ffi test


Server init.

پروګرام د-حافظې-مدیریت: 4.

# for this test you need set a path to libc (puts)
>> libname := پروګرام تنظیم: ⌝'FFITESTLIB'⌜.



Server تړل: ﴿
 لیست نوی ;
 libname ;
 ⌝'puts'⌜ ;
 ﴿ لیست نوی ; ⌝'pointer'⌜ ﴾ ;
 ⌝'void'⌜ ;
 ⌝'Puts'⌜ ;
 ⌝'str:'⌜
﴾.

>> s := Blob utf8: ⌝'Hello from FFI!\n'⌜.

Puts str: s.
s ازاد-کړه.

# test with struct

>> a := Blob نوی: 8.
a بایټونه: ﴿
	لیست <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
﴾.

>> struct := Blob struct: ﴿لیست <<: ⌝'int'⌜, ; ⌝'int'⌜﴾.

Server تړل: ﴿
	لیست <<: ⌝'@structtest'⌜, ;
	⌝'@structtest'⌜ ;
	﴿لیست <<: struct﴾ ; 
	⌝'int'⌜ ;	
	⌝'ffitest'⌜ ;
	⌝'ffisum:'⌜
﴾.
	
وتنه ولیکه: ⌝'Sum test:'⌜ + ﴿ffitest ffisum: a﴾, نوې-کرښه.

struct ازاد-کړه-struct.
struct ازاد-کړه.
a ازاد-کړه.
