# happy flow
>> s := ⌝'hello;"""world"""\n"of";"c\ns\nv"'⌜.
>> د-دوتنې-لار := ⌝'/tmp/dat.csv'⌜.
>> csv := دوتنه نوی: د-دوتنې-لار.
csv ولیکه: s.

# accepts CRLF LF CR, varying row length
csv بېلوونکی: ⌝';'⌜ نقل-نښه: ⌝'"'⌜ کرښې: ⎬ :line
	پروګرام پاکول.
	وتنه ولیکه: line, نوې-کرښه.
	پروګرام پاکول.
⎨.

# unequal lines
s پای-ته-زیات-کړه: ⌝'\njustone'⌜.
csv ولیکه: s.
⎬
	csv بېلوونکی: ⌝';'⌜ نقل-نښه: ⌝'"'⌜ کرښې: ⎬ :line
		وتنه ولیکه: line, نوې-کرښه.
	⎨.
⎨ ونیسه: ⎬ :e 
	وتنه ولیکه: e, نوې-کرښه.
⎨, چلول.

# invalid format
s := ⌝'"he"llo";world'⌜.
csv ولیکه: s.
⎬
	csv بېلوونکی: ⌝';'⌜ نقل-نښه: ⌝'"'⌜ کرښې: ⎬ :line
		وتنه ولیکه: line, نوې-کرښه.
	⎨.
⎨ ونیسه: ⎬ :e 
	وتنه ولیکه: e, نوې-کرښه.
⎨, چلول.
