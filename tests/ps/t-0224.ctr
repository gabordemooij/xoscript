
>> countries := لیست نوی
	~ ⌝'Switzerland'⌜
	~ ⌝'Italy'⌜
	~ ⌝'Germany'⌜.

>> foods := لیست نوی
	~ ⌝'Rösti'⌜
	~ ⌝'Spaghetti'⌜
	~ ⌝'Sauerkraut'⌜.


>> counter := 0.
foods له-مخې: countries, هر-یو: ⎬ :key :value
	counter جمع: 1.
⎨.

وتنه ولیکه: ﴿⌝'we serve counter dishes'⌜ counter: counter﴾, نوې-کرښه.

>> counter := 42.
⌝'TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'⌜ توري ترتیب: ⎬ :v
	counter جمع: 0.
⎨.

وتنه ولیکه: ﴿⌝'we sort counter dishes'⌜ counter: counter﴾, نوې-کرښه.


>> counter := 0.
⎬
	⎬
		counter جمع: 1.
	⎨ × ﴿3 + 1 + 1 × 0.5﴾.
⎨ × 100.


وتنه ولیکه: ﴿⌝'we calculate counter numbers.'⌜ counter: counter﴾, نوې-کرښه.

