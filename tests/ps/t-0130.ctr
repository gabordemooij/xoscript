# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := پروګرام تنظیم: ⌝'FFITESTLIB'⌜.

# link stdio functions from c for advances file operations
Server تړل: ﴿ لیست نوی ;
 libname ; ⌝'fopen'⌜ ;
 ﴿ لیست نوی ; ⌝'pointer'⌜ ; ⌝'pointer'⌜﴾ ;
 ⌝'pointer'⌜ ;
 ⌝'Stream'⌜ ;
 ⌝'path:mode:'⌜
﴾,
تړل: ﴿ لیست نوی ;
 هیڅ ; # means same lib
 ⌝'fread'⌜ ;
 ﴿ لیست نوی ; ⌝'pointer'⌜ ; ⌝'int'⌜ ; ⌝'int'⌜ ; ⌝'pointer'⌜ ﴾ ;
 ⌝'int'⌜ ;
 هیڅ ; # means same object (i.e. Stream)
 ⌝'fread'⌜
﴾,
تړل: ﴿
 لیست نوی ;
 هیڅ ; # means same lib
 ⌝'fwrite'⌜ ;
 ﴿ لیست نوی ; ⌝'pointer'⌜ ; ⌝'int'⌜ ; ⌝'int'⌜ ; ⌝'pointer'⌜ ﴾ ;
 ⌝'int'⌜ ;
 هیڅ ; # means same lib
 ⌝'fwrite'⌜
﴾,
تړل: ﴿
 لیست نوی ;
 هیڅ ; # means same lib
 ⌝'rewind'⌜ ;
 ﴿ لیست نوی ; ⌝'pointer'⌜ ﴾ ;
 ⌝'int'⌜ ;
 هیڅ ; # means same lib
 ⌝'rewind:'⌜
﴾.

>> str := Blob utf8: ⌝'abc123'⌜.
>> د-دوتنې-لار := Blob utf8: ⌝'/tmp/bla.txt'⌜.
>> mode := Blob utf8: ⌝'w+'⌜.

# open a file with fopen(path, mode)
>> fd := Stream path: د-دوتنې-لار mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream پیغام: ⌝'fwrite'⌜ دلیلونه: ﴿لیست نوی ; str ; 1 ; 6 ; fd ﴾.
وتنه ولیکه: bytes-written, نوې-کرښه.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob نوی: 20.

# read from file
>> bytes-read := Stream پیغام: ⌝'fread'⌜ دلیلونه: ﴿لیست نوی ; buf ; 1 ; 6 ; fd ﴾.
وتنه ولیکه: bytes-read, نوې-کرښه.
وتنه ولیکه: buf, نوې-کرښه.

# free memory
str  ازاد-کړه.
د-دوتنې-لار ازاد-کړه.
mode ازاد-کړه.
buf  ازاد-کړه.


