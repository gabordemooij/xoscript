>> echo := څیز نوی.
echo کله: ⌝'ځواب:'⌜ وکړه: ⎬ :sound
	⎬ وتنه ولیکه: sound. ⎨ × 2.
⎨.
echo ho!. 


echo := څیز نوی.
echo کله: ⌝'ځواب:او:'⌜ وکړه: ⎬ :sound :x
	⎬ وتنه ولیکه: sound. ⎨ × x.
⎨.
echo o 5. 
echo wooo: 3. 


echo := څیز نوی.
echo کله: ⌝'ځواب:او:او:'⌜ وکړه: ⎬ :operation :sound :x
	⎬ وتنه ولیکه: sound. ⎨ × x.
⎨.
echo shout: ⌝'la'⌜ times: 4. 


