String em: ['html'] fazer: { <- (
		isto
		substituir: ['&'] com: ['&amp;'],
		substituir: ['<'] com: ['&lt;'],
		substituir: ['>'] com: ['&gt;'],
		substituir: ['"'] com: ['&quot;']
	).
}.

>> list := Listar novo.

['Verbatim Syntax'] caracteres cada-um: { :número :letter
	list ; ((['<li>#Number:Letter</li>']) Number: (número), Letter: letter).
}.

Saída list.





>> template := ['
<html>
<body>
<p>Hello this is a test!</p>
<p>The string \‘Verbatim Syntax\’ has: 15 code points...</p>
<ul>
[list]
</ul>
</body> 
</html>
'] [list]: (list juntar: ['↵']).

Saída escrever: template.

