# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := Objeto novo.

Log em: ['say:'] fazer: { :str
	Saída escrever: str, stop.
}.

>> Item := Objeto novo.

Item em: ['novo:'] fazer: { :id <- isto novo id: id.
}.

Item em: ['id:'] fazer: { :id
	prop id := id.
}.

Item em: ['id'] fazer: { <- prop id. }.


Item em: ['string'] fazer: {
	>> str := ['Item#~no'].
	str ~no: prop id. <- str.
}.


>> Print := Objeto novo.

Print em: ['items'] fazer: { 
	
	prop item := Item novo: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: prop item
	).
	
	
}.

Print items.