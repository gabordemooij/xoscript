# Este teste verifica se string_fill_in não perde o seu slot (gc'ed) no modo 4
# referência em world.c
>> Registo := Objeto novo.

Registo em: ['say:'] fazer: { :str
	Saída escrever: str, stop.
}.

>> Artigo := Objeto novo.

Artigo em: ['novo:'] fazer: { :id
	<- isto novo id: id.
}.

Artigo em: ['id:'] fazer: { :id
	prop id := id.
}.

Artigo em: ['id'] fazer: { <- prop id. }.


Artigo em: ['string'] fazer: {
	>> str := ['Item#~no'].
	str ~no: prop id.
	<- str.
}.


>> Print := Objeto novo.

Print em: ['items'] fazer: { 
	
	prop artigo := Artigo novo: 1.
	
	# ou segfault ou str errada aqui
	Registo say: (
		['~item printed.'] ~item: prop artigo
	).
	
	
}.

Print items.