

String em: ['avaliar'] fazer: {
	>> code := Arquivo novo: ['/tmp/eval.ctr'].
	code escrever: (isto string + ['.']).
	Programa usar: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Listar ← (['Aspas '] + Q + [' são más?']) ; 1.
>> x := q string.
Saída escrever: x, stop.
>> y := Nulo.
(['y := '] + x ) avaliar.
Saída escrever: y ? 0, stop.

q := Mapa colocar: ['\[''] em: ['\['quote\']'].
x := q string.
Saída escrever: x, stop.
y := Nulo.
(['y := '] + x ) avaliar.

>> q := (Mapa novo) colocar:['\[''] em:['\['quote\[''].
Saída escrever: y ? ['\['quote\']'], stop.
