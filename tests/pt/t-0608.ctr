
>> Size := Objeto novo.
Size em: ['is:'] fazer: { :número
	número em: ['+'] fazer: { :número
		>> unit := número qualificar.
		>> factor := 1.
		
		unit
		caso: ['inch'] fazer: { factor := 0.0833. }. <- isto + (número * factor).
	}. <- número.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Saída escrever: plank + edge, stop.
