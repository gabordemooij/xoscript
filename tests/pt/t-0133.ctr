


>> Baralho := Listar novo.
Baralho em: ['imprimir'] fazer: {
        >> len := isto conta - 1.
        { :i
                >> comp2 := isto conta - 1.
                Saída escrever: ['comp: '].
                Saída escrever: len, stop.
                Saída escrever: ['comp2: '].
                Saída escrever: comp2, stop.
        } × len.
}.

>> d := Baralho ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d imprimir.
