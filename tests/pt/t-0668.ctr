# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob novo: 8, bytes: (
	Listar novo ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Saída escrever: ( utf16 decodificar: ['utf16le'] ), stop.

utf16 livre.
>> utf32 := Blob novo: 13, bytes: (
	Listar novo ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Saída escrever: ( utf32 decodificar: ['utf32be'] ), stop.
utf32 livre.