# chave pública (para proteger APIs, etc.)
Server init.

# gerar chaves
>> chaves := Cofre chaves-criptográficas.

# chave privada (secreta)
>> sk := chaves primeiro.

# chave pública
>> pk := chaves último.

# assinar uma mensagem
>> assin := Cofre assinar: ['abc'] com: sk.

# verificar mensagem (ok)
Saída escrever: ( 
	Cofre
		verificar: ['abc'] 
		assinatura: assin 
		com: pk 
), stop.

# verificar mensagem (falha)
Saída escrever: ( 
	Cofre 
		verificar: ['abd'] 
		assinatura: assin 
		com: pk 
), stop.