# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Cofre chaves-criptográficas.

# private (secret) key
>> sk := keys primeiro.

# public key
>> pk := keys último.

# sign a message
>> sig := Cofre assinar: ['abc'] com: sk.

# check message (ok)
Saída escrever: ( 
	Cofre
		verificar: ['abc'] 
		assinatura: sig 
		com: pk 
), stop.

# check message (fail)
Saída escrever: ( 
	Cofre 
		verificar: ['abd'] 
		assinatura: sig 
		com: pk 
), stop.