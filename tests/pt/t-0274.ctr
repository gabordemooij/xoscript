

Listar em: ['column:'] fazer: { :column
	>> result := Listar novo.
	isto cada-um: { :index :row
		row cada-um: { :index :cell
			(index = column) sim: { result acrescentar: cell. }.
		}.
	}. <- result.
}.


>> a := Listar ←
	(Listar ← 1 ; 2 ; 3) ;
	(Listar ← 4 ; 5 ; 6) ;
	(Listar ← 7 ; 8 ; 9).

>> b := a column: 1.
Saída escrever: b, stop.

b := a column: 20.
Saída escrever: b, stop.

b := a column: -100.
Saída escrever: b, stop.
