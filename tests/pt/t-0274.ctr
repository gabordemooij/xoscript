

Listar em: ['column:'] fazer: { :coluna
	>> resultado := Listar novo.
	isto cada-um: { :índice :fila
		fila cada-um: { :índice :célula
			(índice = coluna) sim: { resultado acrescentar: célula. }.
		}.
	}. <- resultado.
}.


>> a := Listar ←
	(Listar ← 1 ; 2 ; 3) ;
	(Listar ← 4 ; 5 ; 6) ;
	(Listar ← 7 ; 8 ; 9).

>> b := a column: 1.
Saída escrever: b, stop.

b := a column: 20.
Saída escrever: b, stop.

b := a column: -100.
Saída escrever: b, stop.
