>> Animal := Objeto novo.
>> Factory := Objeto novo.

Animal em: ['novo'] fazer: {
	>> animal := isto novo.
	animal sound: ['?']. <- animal.
}.

Animal em: ['sound:'] fazer: { :s
	prop sound := s.
}.

Animal em: ['sound'] fazer: { <- prop sound.
}.

>> Dog := Objeto novo.
>> Cat := Objeto novo.

Dog em: ['novo'] fazer: { <- Animal novo sound: ['woof!'].
}.

Cat em: ['novo'] fazer: { <- Animal novo sound: ['meow!'].
}.

Saída escrever: Dog novo sound, stop.
Saída escrever: Cat novo sound, stop.

Factory em: ['mix:and:'] fazer: { :beast1 :beast2 <- Animal novo sound: (
		( beast1 sound de: 0 comprimento: 2 ) +
		( beast2 sound de: 2 comprimento: 5 )
	).
}.

Saída escrever: (Factory mix: Dog novo and: Cat novo) sound, stop.
