>> Saudador := Objeto novo.
Saudador em: ['fabricar'] fazer: {
	>> saudador := Objeto novo.
	saudador em: ['name:'] fazer: { :nome
		Saída escrever: ['a definir um nome'].
		prop meuNome := nome.
	}.
	saudador em: ['saudar'] fazer: {
		Saída escrever: ['Hello'].
		Saída escrever: prop meuNome.
	}. <- saudador.
}.
>> saudador := Saudador fabricar.
saudador name: ['raio de sol!'].
saudador saudar.
