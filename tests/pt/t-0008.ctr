>> Greeter := Objeto novo.
Greeter em: ['make'] fazer: {
	>> greeter := Objeto novo.
	greeter em: ['name:'] fazer: { :nome
		Saída escrever: ['setting a name'].
		prop myName := nome.
	}.
	greeter em: ['greet'] fazer: {
		Saída escrever: ['Hello'].
		Saída escrever: prop myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
