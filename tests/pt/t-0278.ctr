>> A-Fazer := Objeto novo.

A-Fazer em: ['novo'] fazer: {
	prop list := Listar novo.
}.

A-Fazer em: ['nieuw'] fazer: {
	prop list := Listar novo.
}.

A-Fazer em: ['+'] fazer: { :tarefa
	prop list acrescentar: tarefa.
}.

A-Fazer em: ['number of tasks?'] fazer: { <-  prop list conta.
}.

>> afazeres := 
	A-Fazer novo 
	+ ['fazer o jantar'] 
	+ ['arrumar o quarto'].
	
Saída escrever: ['You have $ tasks to do'] $ afazeres number of tasks?.
