#Linux
>> clock := Momento novo.
clock zona: ['UTC-1'].
clock ano: 1981, mês: 1, dia: 5,
      hora: 13, minuto: 15, segundo: 13.

Saída escrever: clock, stop.
clock zona: ['UTC+0'].

Saída escrever: (
	(clock ano cru) + ['-'] + (clock mês) + ['-'] + (clock dia) + [' '] +
	(clock hora) + [':'] + (clock minuto) + [':'] + (clock segundo) + [' '] +
	['W'] + (clock semana) + (clock zona)
), stop.


clock zona: ['UTC-1'].
Saída escrever: (
	(clock ano cru) + ['-'] + (clock mês) + ['-'] + (clock dia) + [' '] +
	(clock hora) + [':'] + (clock minuto) + [':'] + (clock segundo) + [' '] +
	['W'] + (clock semana) + (clock zona)
), stop.
