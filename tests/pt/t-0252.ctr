#Linux
>> relógio := Momento novo.
relógio zona: ['UTC-1'].
relógio ano: 1981, mês: 1, dia: 5,
      hora: 13, minuto: 15, segundo: 13.

Saída escrever: relógio, stop.
relógio zona: ['UTC+0'].

Saída escrever: (
	(relógio ano cru) + ['-'] + (relógio mês) + ['-'] + (relógio dia) + [' '] +
	(relógio hora) + [':'] + (relógio minuto) + [':'] + (relógio segundo) + [' '] +
	['W'] + (relógio semana) + (relógio zona)
), stop.


relógio zona: ['UTC-1'].
Saída escrever: (
	(relógio ano cru) + ['-'] + (relógio mês) + ['-'] + (relógio dia) + [' '] +
	(relógio hora) + [':'] + (relógio minuto) + [':'] + (relógio segundo) + [' '] +
	['W'] + (relógio semana) + (relógio zona)
), stop.
