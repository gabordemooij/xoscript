#teste de ffi


Server init.

Programa arranjo: 4.

# para este teste é preciso definir um caminho para a libc (puts)
>> nomelib := Programa configurar: ['FFITESTLIB'].



Server ligar: (
 Listar novo ;
 nomelib ;
 ['puts'] ;
 ( Listar novo ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s livre.

# teste com struct

>> a := Blob novo: 8.
a bytes: (
	Listar <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> estrut := Blob estrutura: (Listar <<: ['int'], ; ['int']).

Server ligar: (
	Listar <<: ['@structtest'], ;
	['@structtest'] ;
	(Listar <<: estrut) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Saída escrever: ['Teste de soma:'] + (ffitest ffisum: a), stop.

estrut estruturalivre.
estrut livre.
a livre.
