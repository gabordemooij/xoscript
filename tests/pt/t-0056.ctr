>> z := Objeto novo.
z em: ['value:'] fazer: { :v
	prop value := v. <- isto.
}.
z em: ['value'] fazer: { <- prop value. }.
(z setValue: 1) value: 2.
Saída escrever: z value.
>> x := z.
Saída escrever: x value.
z := Nulo.
Saída escrever: z value.
Saída escrever: x value.
Saída escrever: ['hello'].
Saída escrever: 3 + 2.
Saída escrever: (3 > 2).
