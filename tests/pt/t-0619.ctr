>> HTML := Objeto novo.
HTML em: ['responder:'] fazer: { :tag 
	Saída escrever: (['<tag>'] tag: tag), stop.
}.
HTML em: ['responder:e:'] fazer: { :tag :html 
	Saída escrever: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), stop.
}.
>> html := HTML novo.
html body h1: ['header'].

