>> HTML := Objeto novo.
HTML em: ['responder:'] fazer: { :etiqueta 
	Saída escrever: (['<tag>'] tag: etiqueta), stop.
}.
HTML em: ['responder:e:'] fazer: { :etiqueta :html 
	Saída escrever: (
		['<tag>innerHTML</tag>']
		tag: etiqueta - [':'],
		innerHTML: html
	), stop.
}.
>> html := HTML novo.
html body h1: ['header'].

