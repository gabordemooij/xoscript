
Server init.
Saída escrever: ['Teste da base de dados'], stop.

>> bd := MariaDB novo host: ['localhost'],
	utilizador: ['xo'], 
	palavra-passe: ['pass123'],
	nome-database: ['xobase'],
	conectar.

>> parametros :=
bd consulta: ['SELECT UNHEX('CAFE') AS blobby'],
buscar: { :fila
	Saída escrever: ( fila blobby de: 0 comprimento: 2 ), stop.
	fila blobby livre.
}.
