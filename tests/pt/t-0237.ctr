
String em: ['avaliar'] fazer: {
	>> code := Arquivo novo: ['/tmp/eval.ctr'].
	code escrever: (isto string + ['.']).
	Programa usar: ['/tmp/eval.ctr'].
}.

>> map :=
	(Mapa novo)
	colocar: ['Olá a Todos'] em: ['two'],
	colocar: (Listar ← ['hello'] ; ['world'] ; (Listar ← 1 ; 2; 9) ; Não) em: ['um'],
	colocar: ( (Mapa novo) colocar: ['mnudo'] em: ['mal-escrito'] ) em: ['three'],
	colocar: (Listar ← ((Mapa novo) colocar: ['tesouro'] em: ['escondido']) ; 2) em: ['quatro']. 
>> str := map string.
>> map2 := Nulo.
(['map2 := '] + str ) avaliar.
Saída escrever: map2 ? ['um'] ? 0.
Saída escrever: map2 ? ['um'] ? 1.
Saída escrever: map2 ? ['quatro'] ? 0 ? ['escondido'].
Saída escrever: map2 ? ['um'] ? 2 ? 2.
