# test qualifiers

Programa limpa-a-memória.

>> Fruit := Objeto novo.
Fruit em: ['novo'] fazer: {
	>> f := isto novo.
	f apples: 0. <- f.
}.
Fruit em: ['apples:'] fazer: { :a prop apples := a. }.
Fruit em: ['apples'] fazer: { <- prop apples. }.
Fruit em: ['+'] fazer: { :f
	>> n := Fruit novo.
	n apples: (f apples + prop apples). <- n.
}.
Número em: ['apples'] fazer: { <- ((Fruit novo) apples: isto).
}.

Fruit em: ['string'] fazer: { <- prop apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Saída escrever: q, stop.




q := 3 apples + 4 apples.
Saída escrever: q, stop.



q := 3 apples + 4 apples.
Saída escrever: q, stop.


