# testar qualificadores

Programa limpa-a-memória.

>> Fruta := Objeto novo.
Fruta em: ['novo'] fazer: {
	>> f := isto novo.
	f apples: 0. <- f.
}.
Fruta em: ['apples:'] fazer: { :a prop maçãs := a. }.
Fruta em: ['maçãs'] fazer: { <- prop maçãs. }.
Fruta em: ['+'] fazer: { :f
	>> n := Fruta novo.
	n apples: (f maçãs + prop maçãs). <- n.
}.
Número em: ['maçãs'] fazer: { <- ((Fruta novo) apples: isto).
}.

Fruta em: ['string'] fazer: { <- prop maçãs + [' maçãs '].
}.

>> q := 3 maçãs + 4 maçãs.
Saída escrever: q, stop.




q := 3 maçãs + 4 maçãs.
Saída escrever: q, stop.



q := 3 maçãs + 4 maçãs.
Saída escrever: q, stop.


