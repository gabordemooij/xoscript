>> Saudador := Objeto novo.
Saudador em: ['fabricar'] fazer: {
	>> gr := Objeto novo.
	gr em: ['setName:'] fazer: { :umNome
		prop nome := umNome.
	}.
	gr em: ['saudar'] fazer: {
		Saída escrever: prop nome.
	}. <- gr.
}.
>> a := Saudador fabricar.
>> b := Saudador fabricar.
a setName: ['UM'].
b setName: ['DOIS'].
a saudar.
b saudar.
>> c := a novo.
c setName: ['TRÊS'].
c saudar.
>> d := a novo.
d setName: ['QUATRO'].
d saudar.
c saudar.
