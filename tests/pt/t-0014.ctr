>> Greeter := Objeto novo.
Greeter em: ['make'] fazer: {
	>> gr := Objeto novo.
	gr em: ['setName:'] fazer: { :aname
		prop nome := aname.
	}.
	gr em: ['greet'] fazer: {
		Saída escrever: prop nome.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a novo.
c setName: ['THREE'].
c greet.
>> d := a novo.
d setName: ['FOUR'].
d greet.
c greet.
