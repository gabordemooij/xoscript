>> Ponto := Objeto novo.
Ponto em: ['x-coordinate:'] fazer: { :x prop x := x. }.
Ponto em: ['y-coordinate:'] fazer: { :y prop y := y. }.
Ponto em: ['coordenada-x']  fazer: { <- prop x copiar. }.
Ponto em: ['coordenada-y']  fazer: { <- prop y copiar. }.

Ponto em: ['='] fazer: { :outroPonto
	<- ( prop x = outroPonto coordenada-x
		 e: prop y = outroPonto coordenada-y ).
}.

>> cais := Ponto novo x-coordinate: 5, y-coordinate: 6.
>> câmara-municipal := Ponto novo x-coordinate: 7, y-coordinate: 1.
>> restaurante := Ponto novo x-coordinate: 5, y-coordinate: 6.

Saída escrever: cais = câmara-municipal, stop.
Saída escrever: cais = restaurante, stop.
