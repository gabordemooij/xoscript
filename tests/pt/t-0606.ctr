>> Point := Objeto novo.
Point em: ['x-coordinate:'] fazer: { :x prop x := x. }.
Point em: ['y-coordinate:'] fazer: { :y prop y := y. }.
Point em: ['x-coordinate']  fazer: { <- prop x copiar. }.
Point em: ['y-coordinate']  fazer: { <- prop y copiar. }.

Point em: ['='] fazer: { :other <- ( prop x = other x-coordinate
		 e: prop y = other y-coordinate ).
}.

>> pier := Point novo x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point novo x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point novo x-coordinate: 5, y-coordinate: 6.

Saída escrever: pier = town-hall, stop.
Saída escrever: pier = restaurant, stop.
