{
	>> a := Listar novo.
	a acrescentar: 1.
	a acrescentar: 2.
	Saída escrever: (a juntar: [',']), stop.
	a colocar: 3 em: 2.
	Saída escrever: (a juntar: [',']), stop.
	a colocar: 4 em: 10.
	Saída escrever: (a juntar: [',']), stop.
	a corte-esq.
	a corte-esq.
	a corte-esq.
	Saída escrever: (a juntar: [',']), stop.
	a colocar: 9 em: 0.
	Saída escrever: (a juntar: [',']), stop.
	a colocar: 6 em: -1.
} pegar: { :e
	Saída escrever: ['Uncatched error has occurred.↵'] + e, stop.
}, iniciar.


