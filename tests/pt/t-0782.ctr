Saída escrever: ['Objeto de teste'], stop.
>> cmd := Comando novo.
Saída escrever: cmd ls /tmp, stop.
>> antigo-endereço-cmd := cmd protótipo endereço-de-memória.
cmd save-as: ['/tmp/a.bin'].
Saída escrever: ['========== A RECARREGAR SNAP:'], stop.
>> b := Objeto load-from: ['/tmp/a.bin'].
(b protótipo endereço-de-memória = antigo-endereço-cmd) sim: {
	Saída escrever: ['Ligação do objeto religada.'], stop.
}.
Saída escrever: b ls, stop.


