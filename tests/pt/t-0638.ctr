
Server init.
>> pd := Requisição-HTTP novo.
Saída escrever: ['HTTP-GET d[]=']  + ( pd get-lista: ['d[]'] ), stop. # GET
Saída escrever: ['HTTP-GET f[]=']  + ( pd get-lista: ['f[]'] ), stop. # GET
Saída escrever: ['HTTP-POST e[]='] + ( pd post-lista: ['e[]'] ), stop. # GET
Saída escrever: ['HTTP-POST c=']   + ( pd post: ['c'] ), stop. # GET
Saída escrever: ['HTTP-POST xx=']  + ( pd post: ['xx'] ), stop. # GET
