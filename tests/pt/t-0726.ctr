# testar buffers PKI/Sign 
Server init.

>> longo := ( Listar novo preencha: 1000 elementos-com: ['a'] ) juntar: [''].

# assinar uma mensagem
Saída escrever: ( 
	Cofre assinar: ['abc'] com: longo
), stop.

Saída escrever: ( 
	Cofre
		verificar: ['abc'] 
		assinatura: longo 
		com: longo
), stop.

Saída escrever: (
	Cofre hash-senha: longo verificar: longo
), stop.
