Server init.

>> BD := MariaDB novo host: ['localhost'],
	utilizador: ['xo'],
	palavra-passe: ['pass123'],
	nome-database: ['xobase'],
	conectar.

{
	BD consulta:
	['DROP TABLE movies'],
	executar.
} pegar: { Nulo. }, iniciar.

BD consulta:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
executar.

BD consulta: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parametros: ( Listar novo ; ['Halloween'] ),
executar.

BD consulta: ['SELECT * FROM movies'],
buscar: { :filme
	Saída escrever: filme title, stop.
}.

