Server init.

>> DB := MariaDB novo host: ['localhost'],
	utilizador: ['xo'],
	palavra-passe: ['pass123'],
	nome-database: ['xobase'],
	conectar.

{
	DB consulta:
	['DROP TABLE movies'],
	executar.
} pegar: { Nulo. }, iniciar.

DB consulta:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
executar.

DB consulta: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parametros: ( Listar novo ; ['Halloween'] ),
executar.

DB consulta: ['SELECT * FROM movies'],
buscar: { :movie
	Saída escrever: movie title, stop.
}.

