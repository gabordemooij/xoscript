# mensagens de erro da base de dados não devem ser tratadas como strings de formato
Server init.

>> bd := MariaDB novo host: ['localhost'],
	utilizador: ['xo'],
	palavra-passe: ['pass123'],
	nome-database: ['xobase'],
	conectar.

>> parametros := bd consulta: ['SELECT %% FROM'].
{ parametros executar. } pegar: { :e
	Saída escrever: ( e contem: ['%%'] ), stop.
}, iniciar.
