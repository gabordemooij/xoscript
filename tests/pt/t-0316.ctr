>> Avô := Objeto novo.
Avô em: ['saudar'] fazer: {
	Saída escrever: ['Ave!'], stop.
}.
>> Pai := Avô novo.
Pai em: ['saudar'] fazer: {
	Saída escrever: ['Hello'], stop.
	isto saudar.
}.
>> Filho := Pai novo.
Filho em: ['saudar'] fazer: {
	Saída escrever: ['Viva'], stop.
	isto saudar.
}.

Filho saudar.

>> Rotunda := Objeto novo.
Rotunda em: ['circle:'] fazer: { :x
	Saída escrever: x, stop.
	(x < 3) sim: { isto recursivo circle: x + 1. }.
}.

Rotunda circle: 1.

>> x := 1.
>> incrementar := { (x ≤ 3) sim: { Saída escrever: x, stop. x adicionar: 1.  incrementar iniciar. }. }.
incrementar iniciar.