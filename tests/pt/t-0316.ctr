>> Grandfather := Objeto novo.
Grandfather em: ['greet'] fazer: {
	Saída escrever: ['Ave!'], stop.
}.
>> Father := Grandfather novo.
Father em: ['greet'] fazer: {
	Saída escrever: ['Hello'], stop.
	isto greet.
}.
>> Son := Father novo.
Son em: ['greet'] fazer: {
	Saída escrever: ['Hi'], stop.
	isto greet.
}.

Son greet.

>> Roundabout := Objeto novo.
Roundabout em: ['circle:'] fazer: { :x
	Saída escrever: x, stop.
	(x < 3) sim: { isto recursivo circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) sim: { Saída escrever: x, stop. x adicionar: 1.  increment iniciar. }. }.
increment iniciar.