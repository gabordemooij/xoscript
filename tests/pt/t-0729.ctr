Server init.
>> a := Blob novo: 4.
a bytes: ( Listar novo ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob novo: 4.
b bytes: ( Listar novo ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a ^ b.
{
	a ^ ( Arquivo novo: ['noblob???'] ).
} pegar: { :e Saída escrever: e, stop. }, iniciar.
a livre.
b livre.
