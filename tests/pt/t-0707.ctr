# testar conversões de tipo / conversões / ligações
Programa arranjo: 4.
Server init.

>> contador := 0.
>> bd := MariaDB novo host: ['localhost'],
	utilizador: ['xo'], palavra-passe: ['pass123'], nome-database: ['xobase'], conectar.

>> FormatoDoisDígitos := Formato novo: ['%02d'].

# Data e hora
{
	>> ano     := Número entre: 1995 e: 2050, string.
	>> mês    := FormatoDoisDígitos aplicar-int: (Número entre: 1 e: 12), string.
	>> dia      := FormatoDoisDígitos aplicar-int: (Número entre: 1 e: 28), string.
	>> hora     := FormatoDoisDígitos aplicar-int: (Número entre: 1 e: 23), string.
	>> minuto   := FormatoDoisDígitos aplicar-int: (Número entre: 1 e: 59), string.
	>> segundo   := FormatoDoisDígitos aplicar-int: (Número entre: 1 e: 59), string.
	>> datetime := ['YYYY-MM-DD HH:II:SS'].	
	datetime
		YYYY: ano,
		MM: mês,
		DD: dia,
		HH: hora,
		II: minuto,
		SS: segundo.
	>> parametros :=
	bd consulta: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: datetime),
	buscar: { :fila
		(fila mydatetime = datetime) não: {
			este-bloco-de-código erro: (
				['Esperado: <expected> mas obtido: <observation>']
				<expected>: datetime,
				<observation>: fila mydatetime
			).
		}.
	
	}.
	contador adicionar: 1.
} * 100.

# Data
{
	>> ano     := Número entre: 1995 e: 2050, string.
	>> mês    := FormatoDoisDígitos aplicar-int: (Número entre: 1 e: 12), string.
	>> dia      := FormatoDoisDígitos aplicar-int: (Número entre: 1 e: 28), string.
	>> date     := ['YYYY-MM-DD'].
	date
		YYYY: ano,
		MM: mês,
		DD: dia.
	>> parametros :=
	bd consulta: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: date),
	buscar: { :fila
		(fila mydate = date) não: {
			este-bloco-de-código erro: (
				['Esperado: <expected> mas obtido: <observation>']
				<expected>: date,
				<observation>: fila mydate
			).
		}.
	}.
	contador adicionar: 1.
} * 100.


# Hora
{
	>> hora     := FormatoDoisDígitos aplicar-int: (Número entre: 1 e: 23), string.
	>> minuto   := FormatoDoisDígitos aplicar-int: (Número entre: 1 e: 59), string.
	>> segundo   := FormatoDoisDígitos aplicar-int: (Número entre: 1 e: 59), string.
	>> tempo := ['HH:II:SS'].
	tempo
		HH: hora,
		II: minuto,
		SS: segundo.
	>> parametros :=
	bd consulta: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: tempo),
	buscar: { :fila
		(fila mytime = tempo) não: {
			este-bloco-de-código erro: (
				['Esperado: <expected> mas obtido: <observation>']
				<expected>: datetime,
				<observation>: fila mytime
			).
		}.
	}.
	contador adicionar: 1.
} * 100.


# Strings (varchar/text)
>> str1 := Listar novo preencha: 100000 elementos-com: ['x'], juntar: [''].
{
	>> str2 := Cofre token: 40.
	>> parametros :=
	bd consulta: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	buscar: { :fila
		(fila str1 = str1 e: fila str2 = str2) não: {
			este-bloco-de-código erro: (
				['Esperado: <expected> mas obtido: <observation>']
				<expected>: datetime,
				<observation>: fila mytime
			).
		}.
	}.
	contador adicionar: 1.
} * 100.


# Números
{
	>> n1  := Número entre: 1 e: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 de-string: ['9223372036854775807'] ) -
		( Int64 de-string: ['99999'] ) +
		( Int64 de-string: n1 string )
	).
	>> parametros :=
	bd consulta: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	buscar: { :fila
		(fila n1 = n1) não: {
			este-bloco-de-código erro: (
				['Esperado: <expected> mas obtido: <observation>']
				<expected>: n1,
				<observation>: fila n1
			).
		}.
		(fila n2 = n2) não: {
			este-bloco-de-código erro: (
				['Esperado: <expected> mas obtido: <observation>']
				<expected>: n1,
				<observation>: fila n2
			).
		}.
		(fila n3 = n2 arredondado) não: {
			este-bloco-de-código erro: (
				['Esperado: <expected> mas obtido: <observation>']
				<expected>: n1,
				<observation>: fila n3
			).
		}.
		(fila big = big) não: {
			este-bloco-de-código erro: (
				['Esperado: <expected> mas obtido: <observation>']
				<expected>: big,
				<observation>: fila big
			).
		}.
		
	}.
	contador adicionar: 1.
} * 100.


Saída escrever: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: contador
), stop.