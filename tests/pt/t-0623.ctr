

>> g  := Server novo.
>> v  := Cofre novo.
>> ok := 0.

>> segredos := Listar novo ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> senhas := segredos copiar.
senhas cada-um: { :i :p
	segredos cada-um: { :n :s
		{
			>> cifrado := v encriptar: s chave: p.
			>> decifrado := v desencriptar: cifrado chave: p.
			(decifrado = s) sim: {
				ok adicionar: 1.
			}, senão: {
				Saída escrever: ['falha ao cifrar/decifrar: '], stop.
				Saída escrever: s, stop.
				Saída escrever: ['cifrado: '] + cifrado, stop.
				Saída escrever: ['decifrado: '] + cifrado, stop.
				Programa fim.
			}.
		} pegar: { :err
			(s = [''] ou: p = ['']) sim: {
				ok adicionar: 1.
			}, senão: {
				Saída escrever: err, stop.
				Programa fim.
			}.
		}, iniciar.
	}.
}.

Saída escrever: ( ok + [' cifragens do cofre testadas.'] ), stop.