
>> cidade := Listar ← ['Londres'] ; ['Paris'] ; ['Berlim'].
>> temperatura := Listar ← ['15'] ; ['16'] ; ['15'].
>> clima := temperatura por: cidade.
>> cidades := clima entradas oedenar: { :a :b <- (a comparar: b). }.
>> temperaturas := clima valores oedenar: { :a :b <- (a comparar: b) negativo?. }.

Saída escrever: (cidades juntar: [',']), stop.
Saída escrever: (temperaturas juntar: [',']), stop.
