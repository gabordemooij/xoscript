
>> city := Listar ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Listar ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature por: city.
>> cities := weather entradas oedenar: { :a :b <- (a comparar: b). }.
>> temperatures := weather valores oedenar: { :a :b <- (a comparar: b) negativo?. }.

Saída escrever: (cities juntar: [',']), stop.
Saída escrever: (temperatures juntar: [',']), stop.
