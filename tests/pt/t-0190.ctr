#Linux
>> memóriaUsada1 := 0.
>> memóriaUsada2 := 0.
>> memóriaUsada3 := 0.
>> memóriaUsada4 := 0.

Programa arranjo: 0.

{
Momento tempo.
Momento espere: 1.
Saída escrever: Programa argumentos, stop.
Programa argumento: 0.
Número aleatório.
Saída escrever: (Programa comando-do-sistema: ['echo 'Hello'']).
} iniciar.

Programa limpa-a-memória.
memóriaUsada1 := (Programa memoria ? 0).

{
Momento tempo.
Momento espere: 1.
Saída escrever: Programa argumentos, stop.
Programa argumento: 0.
Número aleatório.
Saída escrever: (Programa comando-do-sistema: ['echo 'Hello'']).
} iniciar.

Programa limpa-a-memória.
memóriaUsada2 := (Programa memoria ? 0).

{
Momento tempo.
Momento espere: 1.
