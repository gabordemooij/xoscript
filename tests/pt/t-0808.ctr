# chaves e assinaturas do cofre que descodificam demasiado longas não devem fazer overflow da stack
Server init.

>> chaves := Cofre chaves-criptográficas.
>> sk := chaves primeiro.
>> pk := chaves último.
>> assin := Cofre assinar: ['abc'] com: sk.

# 88 caracteres sem padding descodificam para 66 bytes
>> longo := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 caracteres sem padding descodificam para 33 bytes
>> curto := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Cofre assinar: ['abc'] com: longo. } pegar: { :e
	Saída escrever: e, stop.
}, iniciar.

{ Cofre verificar: ['abc'] assinatura: longo com: pk. } pegar: { :e
	Saída escrever: e, stop.
}, iniciar.

{ Cofre verificar: ['abc'] assinatura: assin com: curto. } pegar: { :e
	Saída escrever: e, stop.
}, iniciar.
