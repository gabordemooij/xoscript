Server init.

Saída escrever: (
	Padrão novo: ['^\\w+$'],
	corresponder: ['test@example.com'] 
), stop. # 0 match, fails on @ and .

Saída escrever: (
	Padrão novo: ['^[^@]+@[^\.]+\.\\w+$'],
	corresponder: ['test@example.com'] 
), stop. # 1 match

Saída escrever: (
	Padrão novo: ['[^@]+@[^\.]+\.\\w+'],
	corresponder: ['test@example.com'] 
), stop. # 1 match

Saída escrever: (
	Padrão novo: ['([^@]+)@([^\.]+)\.\\w+'],
	corresponder: ['test@example.com'] 
), stop. # 1 match, groups dont matter

Saída escrever: (
	Padrão novo: ['[a-z]'],
	corresponder: ['test@example.com'] 
), stop. # 14 matches

Saída escrever: (
	Padrão novo: ['.*'],
	corresponder: ['test@example.com'] 
), stop. # 1 match (all)

Saída escrever: (
	Padrão novo: ['(.*)'],
	corresponder: ['test@example.com'] 
), stop. # 1 match (all)

Saída escrever: (
	Padrão novo: ['\\s*[^@]+@[^\.]+\.\\w+'],
	corresponder: ['test@example.com'] 
), stop. # 1 match, prefix space optional, gets ignored