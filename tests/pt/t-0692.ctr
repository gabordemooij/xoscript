Server init.

Saída escrever: (
	Padrão novo: ['^\\w+$'],
	corresponder: ['test@example.com'] 
), stop. # 0 correspondências, falha em @ e .

Saída escrever: (
	Padrão novo: ['^[^@]+@[^\.]+\.\\w+$'],
	corresponder: ['test@example.com'] 
), stop. # 1 correspondência

Saída escrever: (
	Padrão novo: ['[^@]+@[^\.]+\.\\w+'],
	corresponder: ['test@example.com'] 
), stop. # 1 correspondência

Saída escrever: (
	Padrão novo: ['([^@]+)@([^\.]+)\.\\w+'],
	corresponder: ['test@example.com'] 
), stop. # 1 correspondência, os grupos não importam

Saída escrever: (
	Padrão novo: ['[a-z]'],
	corresponder: ['test@example.com'] 
), stop. # 14 correspondências

Saída escrever: (
	Padrão novo: ['.*'],
	corresponder: ['test@example.com'] 
), stop. # 1 correspondência (tudo)

Saída escrever: (
	Padrão novo: ['(.*)'],
	corresponder: ['test@example.com'] 
), stop. # 1 correspondência (tudo)

Saída escrever: (
	Padrão novo: ['\\s*[^@]+@[^\.]+\.\\w+'],
	corresponder: ['test@example.com'] 
), stop. # 1 correspondência, espaço prefixo opcional, é ignorado