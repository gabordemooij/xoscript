# menos parâmetros do que marcadores devem dar um erro, não ler além das ligações
Server init.

>> bd := MariaDB novo host: ['localhost'],
	utilizador: ['xo'],
	palavra-passe: ['pass123'],
	nome-database: ['xobase'],
	conectar.

>> parametros := bd consulta: ['SELECT ? AS a, ? AS b, ? AS c'].
parametros parametros: (Listar novo ; ['1']).
{ parametros buscar: { :fila Saída escrever: fila, stop. }. } pegar: { :e Saída escrever: e, stop. }, iniciar.

>> parametros := bd consulta: ['SELECT ? AS a'].
{ parametros buscar: { :fila Saída escrever: fila, stop. }. } pegar: { :e Saída escrever: e, stop. }, iniciar.

# o número certo continua a funcionar, parâmetros a mais são ignorados como antes
>> parametros := bd consulta: ['SELECT ? AS a, ? AS b'].
parametros parametros: (Listar novo ; ['1'] ; ['2']).
parametros buscar: { :fila Saída escrever: (fila em: ['a']), escrever: (fila em: ['b']), stop. }.
parametros parametros: (Listar novo ; ['1'] ; ['2'] ; ['3']).
parametros buscar: { :fila Saída escrever: (fila em: ['a']), escrever: (fila em: ['b']), stop. }.
