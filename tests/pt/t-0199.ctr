
Programa arranjo: 4.

>> Animal := Objeto novo.
Animal em: ['make'] fazer: {
	>> animal := Objeto novo.
	animal em: ['makeSound'] fazer: {
		Saída escrever: prop sound.
	}. <- animal.
}.
>> Cat := Objeto novo.
Cat em: ['make'] fazer: {
	>> cat := Animal make.
	cat em: ['init'] fazer: {
		prop sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
