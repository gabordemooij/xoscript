
Programa arranjo: 4.

>> Animal := Objeto novo.
Animal em: ['fabricar'] fazer: {
	>> animal := Objeto novo.
	animal em: ['fazerSom'] fazer: {
		Saída escrever: prop som.
	}. <- animal.
}.
>> Gato := Objeto novo.
Gato em: ['fabricar'] fazer: {
	>> gato := Animal fabricar.
	gato em: ['init'] fazer: {
		prop som := ['meow!'].
	}.
	gato init. <- gato.
}.
>> tom := Gato fabricar.
tom fazerSom.
