>> items := Mapa novo.
items colocar: ['verde'] em: ['cor-1'].
items colocar: ['laranja'] em: ['cor-2'].
items colocar: ['vermelho'] em: ['cor-3'].
>> i := 0.
>> s := [''].
items cada-um: { :key :cor
	Saída escrever: ['color #'] + i + [' é: '] + cor + [' '].
	i adicionar: 1.
}.
Saída escrever: i + [' cores!'].
