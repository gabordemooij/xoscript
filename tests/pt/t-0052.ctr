>> items := Mapa novo.
items colocar: ['green'] em: ['color-1'].
items colocar: ['orange'] em: ['color-2'].
items colocar: ['red'] em: ['color-3'].
>> i := 0.
>> s := [''].
items cada-um: { :key :color
	Saída escrever: ['color #'] + i + [' is: '] + color + [' '].
	i adicionar: 1.
}.
Saída escrever: i + [' colors!'].
