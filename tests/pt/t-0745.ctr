Saída escrever: ['Test object'], stop.
>> a := Objeto novo. 

a em: ['item:'] fazer: { :dict
	prop dict := dict. 
}.

a em: ['item'] fazer: { <- prop dict.
}.

a item: (
Mapa novo
	hello: ['world']).

>> old-dict-address := a item protótipo endereço-de-memória.
a save-as: ['/tmp/a.bin'].
Saída escrever: ['========== RELOADING SNAP:'], stop.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b item protótipo endereço-de-memória = old-dict-address) sim: {
	Saída escrever: ['Object link re-attached.'], stop.
}.

Saída escrever: b item, stop.
