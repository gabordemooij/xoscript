Saída escrever: ['Objeto de teste'], stop.
>> a := Objeto novo. 

a em: ['item:'] fazer: { :dic
	prop dic := dic. 
}.

a em: ['artigo'] fazer: {
	<- prop dic.
}.

a item: (
Mapa novo
	hello: ['world']).

>> antigo-endereço-dic := a artigo protótipo endereço-de-memória.
a save-as: ['/tmp/a.bin'].
Saída escrever: ['========== A RECARREGAR SNAP:'], stop.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b artigo protótipo endereço-de-memória = antigo-endereço-dic) sim: {
	Saída escrever: ['Ligação do objeto religada.'], stop.
}.

Saída escrever: b artigo, stop.
