# formato do cookie de sessão, tipo de conteúdo json, só protocolos web, svg mostrado inline
Server inicializar.
Programa usar: ['../../../src/xo/pt/webtools.xo'].

>> Pedido-Falso := Objeto novo.
Pedido-Falso em: ['value:'] fazer: { :valor
	prop valor := valor.
}.
Pedido-Falso em: ['cookie:'] fazer: { :nome
	<- prop valor.
}.

>> Sessão-Teste := Sessão-ficheiro-temporário novo.
Sessão-Teste em: ['carregar'] fazer: {
	<- Mapa novo.
}.
Sessão-Teste em: ['id-de-sessão'] fazer: {
	<- prop id.
}.

>> cookies := Listar novo
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

cookies cada-um: { :i :cookie
	>> pedido := Pedido-Falso novo.
	pedido value: cookie.
	>> gestor := Sessão-Teste novo.
	>> web := Documento-Web novo.
	web pedido: pedido.
	web gestor-sessão: gestor.
	web iniciar-sessão.
	Saída escrever: ( gestor id-de-sessão = cookie ), stop.
}.

>> web := Documento-Web novo.
web json: (Mapa novo colocar: ['b'] em: ['a']).
Saída escrever: ['\n'], stop.

{ Rede get: ['file:///etc/hostname']. } pegar: { :e
	Saída escrever: e, stop.
}, iniciar.

>> svg := Arquivo novo: ['/tmp/test0814.svg'].
svg escrever: ['<svg xmlns="x"></svg>'].
Saída stop.
Server passagem: ['test0814.svg'] prefixo: ['/tmp/'].
svg apagar.
