['Milhares e decimais'].

>> x := 100000000.5.
>> y := 100000000.5.

Saída escrever: (x + y), stop.

>> x := 10040.07.
>> y := 10305.60.

Saída escrever: (x + y), stop.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Saída escrever: (x + y + z), stop.

['Estranho mas válido'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Saída escrever: (x + y + z), stop.

>> q := 0.1.2.

Saída escrever: (q), stop.

>> q := 012.

Saída escrever: (q), stop.
