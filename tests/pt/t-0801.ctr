Server init.

>> bd := MariaDB novo host: ['localhost'],
	utilizador: ['xo'],
	palavra-passe: ['pass123'],
	nome-database: ['xobase'],
	conectar.

>> apag := bd consulta: ['DELETE FROM book WHERE id > 0'].
{  apag executar. bd commit. } pegar: { :e bd rollback.  }, iniciar.

>> conta := bd consulta: ['SELECT COUNT(*) AS num FROM book'].
conta buscar: { :fila Saída escrever: fila num, stop. }.
