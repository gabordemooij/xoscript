Server init.

>> db := MariaDB novo host: ['localhost'],
	utilizador: ['xo'],
	palavra-passe: ['pass123'],
	nome-database: ['xobase'],
	conectar.

>> del := db consulta: ['DELETE FROM book WHERE id > 0'].
{  del executar. db commit. } pegar: { :e db rollback.  }, iniciar.

>> conta := db consulta: ['SELECT COUNT(*) AS num FROM book'].
conta buscar: { :row Saída escrever: row num, stop. }.
