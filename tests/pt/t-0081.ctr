>> map1 := Mapa novo.
>> key1 := Listar novo.
>> key2 := Listar novo.

map1
	colocar: ['hello'] em: key1,
	colocar: ['world'] em: key2.


Saída
	escrever: ['Map #1 contains: '] + (map1 em: key1),
	escrever: [' and '] + (map1 em: key2), stop.

>> KeyeableArray := Listar novo.
KeyeableArray em: ['toString'] fazer: { <- (isto conta) toString.
}.

>> map2 := Mapa novo.
key1 := KeyeableArray novo.
key2 := KeyeableArray novo.

key1 acrescentar: 1.

map2
	colocar: ['hello'] em: key1,
	colocar: ['world'] em: key2.

Saída
	escrever: ['Map #2 contains: '] + (map2 em: key1),
	escrever: [' and '] + (map2 em: key2), stop.
