>> mapa1 := Mapa novo.
>> chave1 := Listar novo.
>> chave2 := Listar novo.

mapa1
	colocar: ['hello'] em: chave1,
	colocar: ['world'] em: chave2.


Saída
	escrever: ['Map #1 contains: '] + (mapa1 em: chave1),
	escrever: [' e '] + (mapa1 em: chave2), stop.

>> VetorComChaves := Listar novo.
VetorComChaves em: ['paraTexto'] fazer: { <- (isto conta) paraTexto.
}.

>> map2 := Mapa novo.
chave1 := VetorComChaves novo.
chave2 := VetorComChaves novo.

chave1 acrescentar: 1.

map2
	colocar: ['hello'] em: chave1,
	colocar: ['world'] em: chave2.

Saída
	escrever: ['Map #2 contains: '] + (map2 em: chave1),
	escrever: [' e '] + (map2 em: chave2), stop.
