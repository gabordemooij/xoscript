>> makeAdder := { :x
	>> f := { :y <- (prop x + y). } setar: ['x'] valor: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i prop q colocar: (prop f aplicar: (prop q ? i)) em: i. } 
	setar: ['q'] valor: array,
	setar: ['f'] valor: func.
	{ :i mapping aplicar: i. } × (array conta).
}.

>> a := Listar ← 1; 2; 3.
mapper aplicar: a e: (makeAdder aplicar: 100).
Saída escrever: (a posição: 0), stop.
Saída escrever: (a ? 1), stop.
Saída escrever: (a ? 2), stop.
