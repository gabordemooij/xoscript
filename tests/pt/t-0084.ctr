>> criarSomador := { :x
	>> f := { :y <- (prop x + y). } setar: ['x'] valor: x. <- f.
}.
>> mapeador := { :vetor :func
	>> mapeamento := { :i prop q colocar: (prop f aplicar: (prop q ? i)) em: i. } 
	setar: ['q'] valor: vetor,
	setar: ['f'] valor: func.
	{ :i mapeamento aplicar: i. } × (vetor conta).
}.

>> a := Listar ← 1; 2; 3.
mapeador aplicar: a e: (criarSomador aplicar: 100).
Saída escrever: (a posição: 0), stop.
Saída escrever: (a ? 1), stop.
Saída escrever: (a ? 2), stop.
