
String em: ['html'] fazer: { <- (
		isto
		substituir: ['&'] com: ['&amp;'],
		substituir: ['<'] com: ['&lt;'],
		substituir: ['>'] com: ['&gt;'],
		substituir: ['"'] com: ['&quot;']
	).
}.

>> PincelHtml := Objeto novo.

PincelHtml em: ['responder:'] fazer: { :etiqueta
	Saída escrever: (['<tag>↵'] tag: etiqueta ).
}.

PincelHtml em: ['responder:e:'] fazer: { :etiqueta :content
	etiqueta := ( etiqueta de: 0 comprimento: (etiqueta comprimento - 1) ).
	Saída escrever: (['<tag content>↵'] tag: etiqueta, content: content).
}.

PincelHtml em: ['content:'] fazer: { :texto
	Saída escrever: texto html, stop.
}.

PincelHtml em: ['atr:valor:'] fazer: { :atr :value <- ['attr="value"'] attr: atr, value: value.
}.

>> h := PincelHtml novo.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h atr: ['class'] valor: ['bold']),
		/span
	/body
/html.
		
