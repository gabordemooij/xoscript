>> x := [' hallo '].

>> y := x maiúsculas.
Saída escrever: x, stop.
Saída escrever: (x igual: y), stop.

>> y := x minusculas.
Saída escrever: x, stop.
Saída escrever: (x igual: y), stop.

>> y := x trim.
Saída escrever: x, stop.
Saída escrever: (x igual: y), stop.

>> y := x deslocar: 1.
Saída escrever: x, stop.
Saída escrever: (x igual: y), stop.

>> y := x de: 1 comprimento: 2.
Saída escrever: x, stop.
Saída escrever: (x igual: y), stop.