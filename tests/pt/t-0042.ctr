>> items := Mapa novo.
items colocar: ['preto'] em: ['coffee'], colocar: ['earl grey'] em: ['chá'].
Saída escrever: (items em: ['coffee']), escrever: (items em: ['chá']).
Saída escrever: ['existem'] + items conta + [' itens no vetor.'].
items colocar: ['capuccino'] em: ['coffee'].
Saída escrever: ['Agora o meu café é.. '] + (items em: ['coffee']).
items colocar: ['aaa'] em: ['1'].
items colocar: ['bbb'] em: ['2'].
Saída escrever: (items em: ['a']).
