>> items := Mapa novo.
items colocar: ['black'] em: ['coffee'], colocar: ['earl grey'] em: ['tea'].
Saída escrever: (items em: ['coffee']), escrever: (items em: ['tea']).
Saída escrever: ['there are'] + items conta + [' items in the array.'].
items colocar: ['capuccino'] em: ['coffee'].
Saída escrever: ['Now my coffee is.. '] + (items em: ['coffee']).
items colocar: ['aaa'] em: ['1'].
items colocar: ['bbb'] em: ['2'].
Saída escrever: (items em: ['a']).
