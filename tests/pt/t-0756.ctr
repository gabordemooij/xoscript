Saída escrever: ['Objeto de teste'], stop.
>> saudador := Objeto novo.
saudador em: ['name:'] fazer: { :nome
	prop xnome := nome. 
}.
saudador em: ['saudar'] fazer: {
	Saída escrever: ['Olá '] + prop xnome, stop.
}.
saudador name: ['Sherlock'].
saudador save-as: ['/tmp/a.bin'].
saudador save-as: ['/tmp/b.bin'].
Saída escrever: ['========== A RECARREGAR SNAP:'], stop.
>> b := Objeto load-from: ['/tmp/a.bin'].
>> c := Objeto load-from: ['/tmp/b.bin'].
b saudar.
b name: ['Watson'], saudar.
c name: ['Moriarty'], saudar.
