Server init.

>> lig1 := MariaDB novo host: ['localhost'],
	utilizador: ['xo'],
	palavra-passe: ['pass123'],
	nome-database: ['xobase'],
	conectar.

>> lig2 := MariaDB novo host: ['localhost'],
	utilizador: ['xo'],
	palavra-passe: ['pass123'],
	nome-database: ['xobase'],
	conectar.
#...
>> apag := lig1 consulta: ['DELETE FROM book WHERE id > 0'].
{  apag executar. lig1 commit. } pegar: { :e lig1 rollback.  }, iniciar.

>> inserção := lig1 consulta: ['INSERT INTO book (id) VALUES(null)'].
inserção executar.

>> conta := lig1 consulta: ['SELECT COUNT(*) AS num FROM book'].
conta buscar: { :fila Saída escrever: fila num, stop. }.

# não aparece
# insert não confirmado na ligação 1
>> conta := lig2 consulta: ['SELECT COUNT(*) AS num FROM book'].
conta buscar: { :fila Saída escrever: fila num, stop. }.
