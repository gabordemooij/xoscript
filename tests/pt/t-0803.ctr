Server init.

>> conn1 := MariaDB novo host: ['localhost'],
	utilizador: ['xo'],
	palavra-passe: ['pass123'],
	nome-database: ['xobase'],
	conectar.

>> conn2 := MariaDB novo host: ['localhost'],
	utilizador: ['xo'],
	palavra-passe: ['pass123'],
	nome-database: ['xobase'],
	conectar.
#...
>> del := conn1 consulta: ['DELETE FROM book WHERE id > 0'].
{  del executar. conn1 commit. } pegar: { :e conn1 rollback.  }, iniciar.

>> insert := conn1 consulta: ['INSERT INTO book (id) VALUES(null)'].
insert executar.

>> conta := conn1 consulta: ['SELECT COUNT(*) AS num FROM book'].
conta buscar: { :row Saída escrever: row num, stop. }.

# does not show up
# insert not committed on connection 1
>> conta := conn2 consulta: ['SELECT COUNT(*) AS num FROM book'].
conta buscar: { :row Saída escrever: row num, stop. }.
