Saída escrever: ['Objeto de teste'], stop.
>> a := Objeto novo. 

a em: ['item:'] fazer: { :num
	prop num := num. 
}.

a em: ['artigo'] fazer: {
	<- prop num.
}.

a item: 123.

Saída escrever: a artigo, stop.

>> antigo-endereço-num := a artigo protótipo endereço-de-memória.
a save-as: ['/tmp/a.bin'].
Saída escrever: ['========== A RECARREGAR SNAP:'], stop.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b artigo protótipo endereço-de-memória = antigo-endereço-num) sim: {
	Saída escrever: ['Ligação do objeto religada.'], stop.
}.

Saída escrever: b artigo, stop.
