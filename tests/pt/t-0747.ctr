Saída escrever: ['Test object'], stop.
>> a := Objeto novo. 

a em: ['item:'] fazer: { :num
	prop num := num. 
}.

a em: ['item'] fazer: { <- prop num.
}.

a item: 123.

Saída escrever: a item, stop.

>> old-num-address := a item protótipo endereço-de-memória.
a save-as: ['/tmp/a.bin'].
Saída escrever: ['========== RELOADING SNAP:'], stop.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b item protótipo endereço-de-memória = old-num-address) sim: {
	Saída escrever: ['Object link re-attached.'], stop.
}.

Saída escrever: b item, stop.
