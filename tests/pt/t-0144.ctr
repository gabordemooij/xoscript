



>> BorraDeCafé := Objeto novo.
BorraDeCafé em: ['extrair'] fazer: { <- ['coffee']. }.

>> MáquinaDeCafé := Objeto novo.
MáquinaDeCafé em: ['init'] fazer: {
	prop borradecafé := BorraDeCafé novo.
}.
MáquinaDeCafé em: ['novo'] fazer: { <- MáquinaDeCafé `new init.
}.

MáquinaDeCafé em: ['fazerChá'] fazer: { <- (prop folhasdechá extrair). }.
MáquinaDeCafé em: ['fazerCafé'] fazer: { <- (prop borradecafé extrair). }.

>> sonhoDeCafé := MáquinaDeCafé novo.

Saída escrever:
	sonhoDeCafé 
	fazerCafé.

Saída escrever:
	sonhoDeCafé 
	fazerChá.
