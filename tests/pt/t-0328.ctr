Programa arranjo: 4.

>> Doubler := Objeto novo.
>> Multiplier := Objeto novo.
Doubler em: ['double:and:'] fazer: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier em: ['multiply:and:'] fazer: { :x :y <- (x × y).
}.

Saída escrever: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), stop.
