Programa arranjo: 4.

>> Duplicador := Objeto novo.
>> Multiplicador := Objeto novo.
Duplicador em: ['dobrar:e:'] fazer: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplicador em: ['multiplicar:e:'] fazer: { :x :y <- (x × y).
}.

Saída escrever: (
	Duplicador dobrar:
		(Duplicador dobrar: 
			(Multiplicador multiplicar: 2 e: 3)
		e:
			(Multiplicador multiplicar: 3 e: 4)
		)
	e:
		(Duplicador dobrar: 
			(Multiplicador multiplicar: 2 e: 3)
		e:
			(Multiplicador multiplicar: 3 e: 4)
		)
), stop.
