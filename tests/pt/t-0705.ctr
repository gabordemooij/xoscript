

>> obj := Objeto novo.

obj em: ['saudar'] fazer: {
	<- ['viva'].
}.

# tem de produzir hi123hi123ok
obj em: ['tarefa'] fazer: {
	prop propriedade := 123.
	{
		# tentar liga isto/prop ao objeto em vez do bloco
		Saída escrever: isto saudar.
		Saída escrever: prop propriedade.
		1 / 0.
	} pegar: {
		Saída escrever: isto saudar.
		Saída escrever: prop propriedade.
		Saída escrever: ['ok'].
	}, tentar.
}.

obj tarefa.