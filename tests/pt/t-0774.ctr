Saída escrever: ['Objeto de teste'], stop.
>> a := Objeto novo. 
a em: ['item:'] fazer: { :lst
	prop lst := lst. 
}.
a em: ['artigo'] fazer: {
	<- prop lst.
}.
a item: (
	Listar novo ; 1 ; (
		Listar novo ; ['a'] ; (
			Listar novo ; ( Momento novo: 1 )
		) ; ( Int64 de-string: ['321'] )
	)
).
Saída escrever: a artigo, stop.
>> antigo-endereço-lst := a artigo protótipo endereço-de-memória.
a save-as: ['/tmp/a.bin'].
Saída escrever: ['========== A RECARREGAR SNAP:'], stop.
>> b := Objeto load-from: ['/tmp/a.bin'].
(b artigo protótipo endereço-de-memória = antigo-endereço-lst) sim: {
	Saída escrever: ['Ligação do objeto religada.'], stop.
}.
Saída escrever: ( b artigo ), stop.
