Boleano em: ['xor:'] fazer: { :a :b <- ((a e: b não) ou: (a não e: b)).
}.

>> o := Objeto novo.
o em: ['hello'] fazer: { ['Vazio']. }.
{ o em: 2 fazer: 3.} pegar: { :e Saída escrever: e, stop. }, iniciar.
{ o em: ['teste'] fazer: 3.} pegar: { :e Saída escrever: e, stop. }, iniciar.
{ o em: ['hello'] fazer: { ['Vazio']. }.} pegar: { :e Saída escrever: e, stop. }, iniciar. 
{ >> z := 4 ÷ 0. } pegar: { :e Saída escrever: e, stop. }, iniciar. 
{ (Sim e: Nulo) sim: { Saída escrever: ['X'].}. } pegar: { :e Saída escrever: e, stop. }, iniciar. 
{ ([''] xor: 0) sim: { Saída escrever: ['X'].}. } pegar: { :e Saída escrever: e, stop. }, iniciar. 
{ (1 < ['2']) sim: { Saída escrever: ['OK']. }. } pegar: { :e Saída escrever: e, stop. }, iniciar. 
{ (1 < ['2.0']) sim: { Saída escrever: ['OK']. }. } pegar: { :e Saída escrever: e, stop. }, iniciar. 
{ (1 < ['x2.0']) sim: { Saída escrever: ['NÃO!']. }. } pegar: { :e Saída escrever: e, stop. }, iniciar. 
{ Saída escrever: (['muito OK mesmo'] de: ['6'] comprimento: ['2']). } iniciar. 
