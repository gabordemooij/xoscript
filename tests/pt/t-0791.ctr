Server init.

>> BD := MariaDB novo host: ['localhost'],
	utilizador: ['xo'],
	palavra-passe: ['pass123'],
	nome-database: ['xobase'],
	conectar.
	
>> SQL := ['SELECT "hello" AS "world" '].

# criar a consulta manualmente
>> parametros := Maria-Consulta novo: SQL.

# definir a base de dados
parametros database: BD.

parametros buscar: { :fila
	Saída escrever: fila world, stop.
}.
