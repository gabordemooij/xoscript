# testar análise de url

Server init.
>> url := URL de: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Saída escrever: ['esquema = '] + url esquema, stop.
Saída escrever: ['host = '] + url host, stop.
Saída escrever: ['porta = '] + url porta, stop.
Saída escrever: ['caminho = '] + url caminho, stop.
Saída escrever: ['consulta = '] + url parametros, stop.
Saída escrever: ['fragmento = '] + url fragmento, stop.
