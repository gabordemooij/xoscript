#Linux

 >> t := Momento novo.
 
t zona: ['Europe/Amsterdam'].
t ano: 2020, mês: 8, dia: 2, hora: 21, minuto: 2, segundo: 1.

>> a := t hora.
>> ams := t zona.

t zona: ['US/Hawaii'].
>> b := t hora.
>> hw := t zona.

Saída
escrever: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		outro: ['mais tarde'] ou: ['mais cedo']
	)
),
stop.
 