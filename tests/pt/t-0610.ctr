
>> Retângulo := Objeto novo.

Retângulo em: ['área'] fazer: {
	<- prop comprimento * prop largura.
}.

Retângulo em: ['length:'] fazer: { :comprimento
	prop comprimento := comprimento.
}.

Retângulo em: ['width:'] fazer: { :largura
	prop largura := largura.
}.

Retângulo em: ['novo'] fazer: {
	# isto não resulta num ciclo infinito
	>> retângulo := isto novo.
	retângulo length: 0, width: 0.
	<- retângulo.
}.

>> a := Retângulo novo.
Saída escrever: a área, stop. #0

>> b := Retângulo novo length: 2, width: 3.
Saída escrever: b área, stop. #6

