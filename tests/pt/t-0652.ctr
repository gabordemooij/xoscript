# testar número -> string -> número
{

	>> x := Número entre: 0 e: 1000000.
	>> d := Número entre: 1 e: 7.
	>> e := 10 ao-poder: d.

	x dividir-por: e.
	>> y := x string número.

	(x = y) não: {
		Saída escrever: x, stop.
		Saída escrever: y, stop.
		Programa fim.
	}.

} * 1000.
Saída escrever: ['OK'], stop.