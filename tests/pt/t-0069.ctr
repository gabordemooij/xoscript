

String em: ['html'] fazer: { <- (
		isto
		substituir: ['&'] com: ['&amp;'],
		substituir: ['<'] com: ['&lt;'],
		substituir: ['>'] com: ['&gt;'],
		substituir: ['"'] com: ['&quot;']
	).
}.


Saída escrever: ([' aparado à esquerda '] trim) + [' '] + ( ['e aparado à direita'] trim) + ['!'], stop.
Saída escrever: ['<html>"html & entities"</html>'] html.
