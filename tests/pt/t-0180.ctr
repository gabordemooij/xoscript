String em: ['html'] fazer: { <- (
		isto
		substituir: ['&'] com: ['&amp;'],
		substituir: ['<'] com: ['&lt;'],
		substituir: ['>'] com: ['&gt;'],
		substituir: ['''] com: ['&apos;'],
		substituir: ['"'] com: ['&quot;']
	).
}.

>> memóriaUsada1 := 0.
>> memóriaUsada2 := 0.
>> memóriaUsada3 := 0.
>> memóriaUsada4 := 0.

Programa arranjo: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Saída escrever: txt copiar html, stop.
Saída escrever: txt copiar minusculas, stop.
Saída escrever: txt copiar maiúsculas, stop.
} iniciar.

Programa limpa-a-memória.

memóriaUsada1 := (Programa memoria ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Saída escrever: txt copiar html, stop.
Saída escrever: txt copiar minusculas, stop.
Saída escrever: txt copiar maiúsculas, stop.
} iniciar.

Programa limpa-a-memória.
memóriaUsada2 := (Programa memoria ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Saída escrever: txt copiar html, stop.
Saída escrever: txt copiar minusculas, stop.
Saída escrever: txt copiar maiúsculas, stop.
} iniciar.

Programa limpa-a-memória.
memóriaUsada3 := (Programa memoria ? 0).



( memóriaUsada1 = memóriaUsada2 e: memóriaUsada1 = memóriaUsada3, e: memóriaUsada2 = memóriaUsada3 ) sim: {
	Saída escrever: ['Sem fugas de memória aqui'].
}, não: {
	Saída escrever: ['A perder memória...'].
}.
