
Listar em: ['soma'] fazer: {
	>> total := 0.
	isto cada-um: { :índice :elemento
		total adicionar: elemento.
	}. <- total.
}.

>> a := Listar ← 9 ; 8 ; 7.
Saída escrever: (a soma), stop. 
>> a := Listar ← 1 ; 9.
Saída escrever: (a soma), stop. 
>> a := Listar ← ['o'] ; 2.
Saída escrever: (a soma), stop. 
Saída escrever: (Listar novo soma), stop. 
