
Listar em: ['sum'] fazer: {
	>> total := 0.
	isto cada-um: { :index :element
		total adicionar: element.
	}. <- total.
}.

>> a := Listar ← 9 ; 8 ; 7.
Saída escrever: (a sum), stop. 
>> a := Listar ← 1 ; 9.
Saída escrever: (a sum), stop. 
>> a := Listar ← ['o'] ; 2.
Saída escrever: (a sum), stop. 
Saída escrever: (Listar novo sum), stop. 
