>> t := Sim.
(t = Sim) sim: { Saída escrever: ['T']. }.
(t = Não) sim: { Saída escrever: ['F']. }.
Saída escrever: ['|'].
>> t := Não.
(t = Sim) sim: { Saída escrever: ['T']. }.
(t = Não) sim: { Saída escrever: ['F']. }.
Saída escrever: ['|'].
>> f := Sim.
(t = Sim e: f = Não) sim: { Saída escrever: ['T']. }.
(t = Não e: f = Sim) sim: { Saída escrever: ['F']. }.
Saída escrever: ['|'].
>> n := Nulo.
(n Nulo?) sim: { Saída escrever: ['T']. }.
(n Nulo?) não: { Saída escrever: ['F']. }.
Saída escrever: ['|'].
(f Boolean?) sim: { Saída escrever: ['T']. }.
(f Boolean?) não: { Saída escrever: ['F']. }.



