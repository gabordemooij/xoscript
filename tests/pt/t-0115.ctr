{
	este-bloco-de-código erro: ['Não falhes.'].
	desconhecido fazerAlgo.
} pegar: {
	Saída escrever: ['Apanhado!'].
}, iniciar.

{
	este-bloco-de-código erro: ['Não falhes.'].
	prop desconhecido fazerAlgo.
} pegar: {
	Saída escrever: ['Apanhado!'].
}, iniciar.

{
	este-bloco-de-código erro: ['Não falhes.'].
	desconhecido := 122.
} pegar: {
	Saída escrever: ['Apanhado!'].
}, iniciar.


{
	este-bloco-de-código erro: ['Não falhes.'].
	Sim parar.
	Saída escrever: ['FALHOU'].
} pegar: {
	Saída escrever: ['Apanhado!'].
}, iniciar.

{
	{
		este-bloco-de-código erro: ['Não falhes.'].
		Sim parar.
		Saída escrever: ['FALHOU'].
	} pegar: { :x
		(x = ['Não falhes.']) sim: { este-bloco-de-código erro: ['Apanhado aninhado!']. }.
	}, iniciar.
} pegar: { :e
	Saída escrever: e.
}, iniciar.
