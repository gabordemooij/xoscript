>> a := Listar ← Objeto ; Sim ; Não ; Boleano ; 1 ; Número ; ['Str'] ; String ; { ['Empty']. }.
Saída escrever: (a conta), stop.
{ :i
	Saída escrever: 
	['a '] + 
	((a ? i) tipo) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Nulo?) outro: [''] ou: ['NOT']) + 
	[' Nil.'],
	stop.
} × (a conta).
Saída escrever: ['but.. Nil is.. '] + ((Nulo Nulo?) outro: ['certainly NIL!'] ou: ['not NIL??']), stop.