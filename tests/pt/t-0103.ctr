>> a := Listar ← Objeto ; Sim ; Não ; Boleano ; 1 ; Número ; ['Str'] ; String ; { ['Vazio']. }.
Saída escrever: (a conta), stop.
{ :i
	Saída escrever: 
	['a '] + 
	((a ? i) tipo) +
	([' \‘this\’ '] this: (a ? i))  +
	[' é '] +
	(((a ? i) Nulo?) outro: [''] ou: ['NÃO']) + 
	[' Nulo.'],
	stop.
} × (a conta).
Saída escrever: ['mas.. Nulo é.. '] + ((Nulo Nulo?) outro: ['certamente NULO!'] ou: ['não NULO??']), stop.