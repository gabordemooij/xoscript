Server init.

>> BD := MariaDB novo host: ['localhost'],
	utilizador: ['xo'],
	palavra-passe: ['pass123'],
	nome-database: ['xobase'],
	conectar.
	
>> SQL := ['SELECT "hello" AS "world" '].

# uma forma mais rápida, obter a consulta da BD:
>> consulta2 := BD consulta: SQL.

# agora não é preciso definir a BD
consulta2 buscar: { :fila
	Saída escrever: fila world, stop.
}.
