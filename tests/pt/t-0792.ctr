Server init.

>> DB := MariaDB novo host: ['localhost'],
	utilizador: ['xo'],
	palavra-passe: ['pass123'],
	nome-database: ['xobase'],
	conectar.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB consulta: SQL.

# now you don't have to set DB
query2 buscar: { :row
	Saída escrever: row world, stop.
}.
