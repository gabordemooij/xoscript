# testar métodos catch-all
>> x13 := Objeto novo.
x13 em: ['a'] fazer: { :a Saída escrever: 0, stop. }.
x13 em: ['a:'] fazer: { :a Saída escrever: a, stop. <- 5. }.
x13 em: ['a:b:'] fazer: { :a :b Saída escrever: (a + b), stop. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
