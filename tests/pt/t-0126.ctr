#Linux
>> Sorvedor := Objeto novo.

Sorvedor em: ['novo'] fazer: {
	prop str := [''].
}.

Sorvedor em: ['nieuw'] fazer: {
	prop str := [''].
}.

Sorvedor em: ['responder:'] fazer: { :blah
		prop str acrescentar: blah.
}.

Sorvedor em: ['responder:e:'] fazer: { :blah :blahah
		prop str acrescentar: (blah de: 0 comprimento: (blah comprimento - 1)).
		prop str acrescentar: [' '].
		prop str acrescentar: blahah.
}.

Sorvedor em: ['recolher'] fazer: {
	>> buffer := prop str.
	prop str := ['']. <- buffer.
}.


Saída escrever: (Programa comando-do-sistema: (Sorvedor novo echo: ['Olá, consigo escrever na consola com uma API fluente!'], recolher)).


{ Arquivo novo: ['/tmp/from.txt'], apagar. } pegar: { ['Vazio']. }, iniciar.
{ Arquivo novo: ['/tmp/to.txt'], apagar. } pegar: { ['Vazio']. }, iniciar.


Arquivo novo: ['/tmp/to.txt'], existe não: {
	Saída escrever: ['Confirmed. Target file does not exist.\
'].
}.
Arquivo novo: ['/tmp/from.txt'], existe não: {
	Saída escrever: ['Confirmed. Source file does not exist.\
'].
}.



Programa comando-do-sistema: (Sorvedor novo touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], recolher).



Programa comando-do-sistema: (Sorvedor novo cp: ['/tmp/from.txt /tmp/to.txt'], recolher).

Arquivo novo: ['/tmp/to.txt'], existe sim: {
	Saída escrever: ['Confirmed. Target file has been created by shell.\
'].
}.


Saída escrever: ['O conteúdo do ficheiro é:'] + (Arquivo novo: ['/tmp/to.txt'], ler), stop.
