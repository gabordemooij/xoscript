# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> caminho := ['/tmp/dat.csv'].
>> csv := Arquivo novo: caminho.
csv escrever: s.

# accepts CRLF LF CR, varying row length
csv separador: [';'] quotes: ['"'] linhas: { :line
	Programa limpa-a-memória.
	Saída escrever: line, stop.
	Programa limpa-a-memória.
}.

# unequal lines
s acrescentar: ['\njustone'].
csv escrever: s.
{
	csv separador: [';'] quotes: ['"'] linhas: { :line
		Saída escrever: line, stop.
	}.
} pegar: { :e 
	Saída escrever: e, stop.
}, iniciar.

# invalid format
s := ['"he"llo";world'].
csv escrever: s.
{
	csv separador: [';'] quotes: ['"'] linhas: { :line
		Saída escrever: line, stop.
	}.
} pegar: { :e 
	Saída escrever: e, stop.
}, iniciar.
