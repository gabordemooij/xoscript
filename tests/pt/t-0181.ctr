

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa arranjo: 0.

>> txt := ['World Salad'].
Saída escrever: ['this text contains: '] + ( ( txt dividir: [' '] ) conta ) + [' words.'], stop.
txt := txt de: 6 comprimento: 4.
Saída escrever: txt, stop.

Programa limpa-a-memória.

usedMemory1 := (Programa memoria ? 0).


txt := ['World Salad'].
Saída escrever: ['this text contains: '] + ( ( txt dividir: [' '] ) conta ) + [' words.'], stop.
txt := txt de: 6 comprimento: 4.
