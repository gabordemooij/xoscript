Saída escrever: ['Objeto de teste'], stop.
>> a := Objeto novo. 

a em: ['item:'] fazer: { :fmt
	prop fmt := fmt. 
}.

a em: ['artigo'] fazer: {
	<- prop fmt.
}.

a item: ( Formato novo: ['|%s|'] ).

Saída escrever: a artigo, stop.

>> antigo-endereço-fmt := a artigo protótipo endereço-de-memória.
a save-as: ['/tmp/a.bin'].
Saída escrever: ['========== A RECARREGAR SNAP:'], stop.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b artigo protótipo endereço-de-memória = antigo-endereço-fmt) sim: {
	Saída escrever: ['Ligação do objeto religada.'], stop.
}.

Saída escrever: ( b artigo aplicar: ['hello'] ), stop.
