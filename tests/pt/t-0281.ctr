>> q := Listar ← 1 ; 2 ; 3.
{ q ? ['1']. } pegar: { Saída escrever: ['apanhado!'], stop. }, iniciar.
{ q ? Sim. } pegar: { Saída escrever: ['apanhado!'], stop. }, iniciar.
{ q ? Não. } pegar: { Saída escrever: ['apanhado!'], stop. }, iniciar.
{ q ? Nulo. } pegar: { Saída escrever: ['apanhado!'], stop. }, iniciar.
{ q ? (Listar novo). } pegar: { Saída escrever: ['apanhado!'], stop. }, iniciar.
{ q ? (Objeto novo). } pegar: { Saída escrever: ['apanhado!'], stop. }, iniciar.
{ q ? ({ ['Vazio']. }). } pegar: { Saída escrever: ['apanhado!'], stop. }, iniciar.
Saída escrever: ['apanhei-os todos'], stop.
