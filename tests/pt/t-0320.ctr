


>> CoffeeMachine := Objeto novo.
CoffeeMachine em: ['order:'] fazer: { :id
	>> coffee := ['Americano'].
	( id = 1 ) sim: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) sim: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) sim: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Objeto novo.
SimpleCoffeeMachine em: ['order'] fazer: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Saída escrever: redCup, stop.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Saída escrever: greenCup, stop.
>> yellowCup := CoffeeMachine order: 1.
Saída escrever: yellowCup, stop.
>> blueCup := CoffeeMachine order: 0.
Saída escrever: blueCup, stop.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Saída escrever: blackCup, stop.
blackCup acrescentar: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Saída escrever: orangeCup, stop.
