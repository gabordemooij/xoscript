


>> MáquinaDeCafé := Objeto novo.
MáquinaDeCafé em: ['order:'] fazer: { :id
	>> coffee := ['Americano'].
	( id = 1 ) sim: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) sim: {
		coffee := ['Expresso'].
	}.
	( id = 3 ) sim: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> MáquinaDeCaféSimples := Objeto novo.
MáquinaDeCaféSimples em: ['encomenda'] fazer: { <- ['Preto']. }.
>> chávenaVermelha := MáquinaDeCafé order: 1.
Saída escrever: chávenaVermelha, stop.
chávenaVermelha := ['Chá']. 
>> chávenaVerde := MáquinaDeCafé order: 0.
Saída escrever: chávenaVerde, stop.
>> chávenaAmarela := MáquinaDeCafé order: 1.
Saída escrever: chávenaAmarela, stop.
>> chávenaAzul := MáquinaDeCafé order: 0.
Saída escrever: chávenaAzul, stop.
>> chávenaDePlástico := MáquinaDeCaféSimples encomenda.
chávenaDePlástico := ['Limonada']. 
>> chávenaPreta := MáquinaDeCaféSimples encomenda.
Saída escrever: chávenaPreta, stop.
chávenaPreta acrescentar: [' nããão.... cerveja. '].
>> chávenaLaranja := MáquinaDeCaféSimples encomenda.
Saída escrever: chávenaLaranja, stop.
