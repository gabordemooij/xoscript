# testar qualificadores

>> $ := Objeto novo.

$ em: ['responder:'] fazer: { :x
	
	>> operação := x caracter: 0.
	>> divisa := x caracter: 1.
	>> dinheiro := x deslocar: 2.
	
	>> quantia := 0.

	( operação = ['+'] ) sim: {
		( divisa = ['£'] ) sim: { quantia := 1.28 × dinheiro. }.
	}. <- quantia.
}.



>> x := $ +£20.

Saída escrever: x, stop.


>> Fruta := Objeto novo.

Fruta em: ['novo'] fazer: {
	>> f := isto novo.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruta em: ['apples:'] fazer: { :a prop maçãs := a. }.
Fruta em: ['oranges:'] fazer: { :p prop laranjas := p. }.
Fruta em: ['maçãs'] fazer: { <- prop maçãs. }.
Fruta em: ['laranjas'] fazer: { <- prop laranjas. }.

Fruta em: ['+'] fazer: { :f
	
	>> n := Fruta novo.
	f adicionar: 1.
	
	n apples: (f maçãs + prop maçãs).
	n oranges:  (f laranjas  + prop laranjas). <- n.
}.

Fruta em: ['string'] fazer: { <- ( prop maçãs string + [' maçãs e '] + prop laranjas + [' laranjas'] ).
}.

Número em: ['maçãs'] fazer: { <- ((Fruta novo) apples: isto).
}.

Número em: ['apple'] fazer: { <- ((Fruta novo) apples: isto).
}.

Número em: ['laranjas'] fazer: { <- ((Fruta novo) oranges: isto).
}.




Saída escrever: (1 apple + 3 laranjas + 4 maçãs), stop.


String em: ['duasVezes'] fazer: { <- ((isto string) + (isto string)).
}.



Saída escrever: ['❤❤❤'] duasVezes.



