# test qualifiers

>> $ := Objeto novo.

$ em: ['responder:'] fazer: { :x
	
	>> operation := x caracter: 0.
	>> valuta := x caracter: 1.
	>> money := x deslocar: 2.
	
	>> amount := 0.

	( operation = ['+'] ) sim: {
		( valuta = ['£'] ) sim: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Saída escrever: x, stop.


>> Fruit := Objeto novo.

Fruit em: ['novo'] fazer: {
	>> f := isto novo.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit em: ['apples:'] fazer: { :a prop apples := a. }.
Fruit em: ['oranges:'] fazer: { :p prop oranges := p. }.
Fruit em: ['apples'] fazer: { <- prop apples. }.
Fruit em: ['oranges'] fazer: { <- prop oranges. }.

Fruit em: ['+'] fazer: { :f
	
	>> n := Fruit novo.
	f adicionar: 1.
	
	n apples: (f apples + prop apples).
	n oranges:  (f oranges  + prop oranges). <- n.
}.

Fruit em: ['string'] fazer: { <- ( prop apples string + [' apples and '] + prop oranges + [' oranges'] ).
}.

Número em: ['apples'] fazer: { <- ((Fruit novo) apples: isto).
}.

Número em: ['apple'] fazer: { <- ((Fruit novo) apples: isto).
}.

Número em: ['oranges'] fazer: { <- ((Fruit novo) oranges: isto).
}.




Saída escrever: (1 apple + 3 oranges + 4 apples), stop.


String em: ['twice'] fazer: { <- ((isto string) + (isto string)).
}.



Saída escrever: ['❤❤❤'] twice.



