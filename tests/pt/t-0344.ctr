# teste catch-all (prático)
>> HTML := String novo.
HTML em: ['encode:'] fazer: { :tekst
	isto acrescentar: (tekst
	substituir: ['&'] com: ['&amp;'], 
	substituir: ['<'] com: ['&lt;'],
	substituir: ['>'] com: ['&gt;'],
	substituir: ['"'] com: ['&quot;']).
}.
>> blog := HTML novo.
blog acrescentar: ['<h1>'],
     encode: ['Koffie & Thee'],
     acrescentar: ['</h1>'].
Saída escrever: blog, stop.


>> Romano := Número novo.
Romano em: ['emTexto'] fazer: {
	>> a := [''].
	{ a acrescentar: ['I']. } × isto. <- a.
}.

>> x := Romano novo.
x adicionar: 3.
Saída escrever: x emTexto, stop.

>> Quântico := Boleano novo.
Quântico em: ['true?'] fazer: { <- ['talvez Sim']. }.
Saída escrever: (Quântico novo true?), stop.

>> Nihil := Nulo novo.
Nihil em: ['string'] fazer: { <- ['Nihil']. }.
Saída escrever: (Nihil novo), stop.
