# catch-all test (practical)
>> HTML := String novo.
HTML em: ['encode:'] fazer: { :tekst
	isto acrescentar: (tekst
	substituir: ['&'] com: ['&amp;'], 
	substituir: ['<'] com: ['&lt;'],
	substituir: ['>'] com: ['&gt;'],
	substituir: ['"'] com: ['&quot;']).
}.
>> blog := HTML novo.
blog acrescentar: ['<h1>'],
     encode: ['Koffie & Thee'],
     acrescentar: ['</h1>'].
Saída escrever: blog, stop.


>> Roman := Número novo.
Roman em: ['stringy'] fazer: {
	>> a := [''].
	{ a acrescentar: ['I']. } × isto. <- a.
}.

>> x := Roman novo.
x adicionar: 3.
Saída escrever: x stringy, stop.

>> Quantum := Boleano novo.
Quantum em: ['true?'] fazer: { <- ['maybe True']. }.
Saída escrever: (Quantum novo true?), stop.

>> Nihil := Nulo novo.
Nihil em: ['string'] fazer: { <- ['Nihil']. }.
Saída escrever: (Nihil novo), stop.
