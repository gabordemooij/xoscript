# testar operações de lista


>> bolos := Listar ←
	['apple'] ;
	['baga'] ;
	['chocolate'] ;
	['queijo'].


>> comprar := bolos substituir: 1 comprimento: 2 com: ( Listar ← ['canela'] ; ['ananás'] ).
Saída escrever: (comprar juntar: [',']), stop.


>> comprar := bolos substituir: 1 comprimento: 12 com: ( Listar ← ['canela'] ; ['ananás'] ).
Saída escrever: (comprar juntar: [',']), stop.


>> comprar := bolos substituir: 2 comprimento: 10 com: ( Listar novo ).
Saída escrever: (comprar juntar: [',']), stop.


>> comprar := bolos substituir: 0 comprimento: 1 com: ( Listar novo ).
Saída escrever: (comprar juntar: [',']), stop.


>> comprar := bolos substituir: ['0'] comprimento: ['1'] com: ['x'].
Saída escrever: (comprar juntar: [',']), stop.
