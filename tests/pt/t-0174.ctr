


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa arranjo: 0.
>> palette := Nulo.
>> colors := Nulo.

{
palette := Mapa novo.
palette 
	colocar: ['#F00'] em: ['red'],
	colocar: ['#0F0'] em: ['green'],
	colocar: ['#00F'] em: ['blue'].
Saída escrever: ['number of RGB codes in palette: '] + ( palette conta ), stop.
Saída escrever: ['RGB code of green is: '] + ( palette ? ['green'] ), stop.
colors := [''].
( palette cada-um: { :nome :code
		colors := colors + ( nome + [':'] + code ).
} ).
Saída escrever: ['All colors in palette: '] + colors, stop.
} iniciar.
Programa limpa-a-memória.
usedMemory1 := (Programa memoria ? 0).

