


>> memóriaUsada1 := 0.
>> memóriaUsada2 := 0.
>> memóriaUsada3 := 0.
>> memóriaUsada4 := 0.

Programa arranjo: 0.
>> paleta := Nulo.
>> cores := Nulo.

{
paleta := Mapa novo.
paleta 
	colocar: ['#F00'] em: ['vermelho'],
	colocar: ['#0F0'] em: ['verde'],
	colocar: ['#00F'] em: ['azul'].
Saída escrever: ['número de códigos RGB na paleta: '] + ( paleta conta ), stop.
Saída escrever: ['o código RGB de verde é: '] + ( paleta ? ['verde'] ), stop.
cores := [''].
( paleta cada-um: { :nome :code
		cores := cores + ( nome + [':'] + code ).
} ).
Saída escrever: ['Todas as cores na paleta: '] + cores, stop.
} iniciar.
Programa limpa-a-memória.
memóriaUsada1 := (Programa memoria ? 0).

{
paleta := Mapa novo.
paleta 
	colocar: ['#F00'] em: ['vermelho'],
	colocar: ['#0F0'] em: ['verde'],
	colocar: ['#00F'] em: ['azul'].
Saída escrever: ['número de códigos RGB na paleta: '] + ( paleta conta ), stop.
Saída escrever: ['o código RGB de verde é: '] + ( paleta ? ['verde'] ), stop.
cores := [''].
( paleta cada-um: { :nome :code
		cores := cores + ( nome + [':'] + code ).
} ).
Saída escrever: ['Todas as cores na paleta: '] + cores, stop.
} iniciar.
Programa limpa-a-memória.
memóriaUsada2 := (Programa memoria ? 0).

{
paleta := Mapa novo.
paleta 
	colocar: ['#F00'] em: ['vermelho'],
	colocar: ['#0F0'] em: ['verde'],
	colocar: ['#00F'] em: ['azul'].
Saída escrever: ['número de códigos RGB na paleta: '] + ( paleta conta ), stop.
Saída escrever: ['o código RGB de verde é: '] + ( paleta ? ['verde'] ), stop.
cores := [''].
( paleta cada-um: { :nome :code
		cores := cores + ( nome + [':'] + code ).
} ).
Saída escrever: ['Todas as cores na paleta: '] + cores, stop.
} iniciar.
Programa limpa-a-memória.
memóriaUsada3 := (Programa memoria ? 0).



( memóriaUsada1 = memóriaUsada2 e: memóriaUsada1 = memóriaUsada3, e: memóriaUsada2 = memóriaUsada3 ) sim: {
	Saída escrever: ['Sem fugas de memória aqui'].
}, não: {
	Saída escrever: ['A perder memória...'].
}.
