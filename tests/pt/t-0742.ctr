Saída escrever: ['Test object'], stop.
>> a := Objeto novo. 

a em: ['item:'] fazer: { :hexhelper
	prop hexhelper := hexhelper. 
}.

a em: ['item'] fazer: { <- prop hexhelper.
}.

a item: Hx novo.

>> old-hexhelper-address := a item protótipo endereço-de-memória.
a save-as: ['/tmp/a.bin'].
Saída escrever: ['========== RELOADING SNAP:'], stop.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b item protótipo endereço-de-memória = old-hexhelper-address) sim: {
	Saída escrever: ['Object link re-attached.'], stop.
}.
