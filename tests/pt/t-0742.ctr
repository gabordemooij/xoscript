Saída escrever: ['Objeto de teste'], stop.
>> a := Objeto novo. 

a em: ['item:'] fazer: { :ajudantehex
	prop ajudantehex := ajudantehex. 
}.

a em: ['artigo'] fazer: {
	<- prop ajudantehex.
}.

a item: Hx novo.

>> antigo-endereço-ajudantehex := a artigo protótipo endereço-de-memória.
a save-as: ['/tmp/a.bin'].
Saída escrever: ['========== A RECARREGAR SNAP:'], stop.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b artigo protótipo endereço-de-memória = antigo-endereço-ajudantehex) sim: {
	Saída escrever: ['Ligação do objeto religada.'], stop.
}.
