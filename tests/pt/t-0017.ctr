Número em: ['fatorial'] fazer: {
	>> total := 1.
	{ :índice total multiplicar-por: (isto - (índice)). } × isto. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Saída escrever: a.
>> b := 2 + 3 fatorial.
Saída escrever: b.
>> c := 3 fatorial + 2.
Saída escrever: c.
>> d := 2 + (3 fatorial).
Saída escrever: d.
Saída escrever: 2 + 3 fatorial + 1.
