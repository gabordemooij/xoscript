Saída escrever: ['Objeto de teste'], stop.
>> a := Objeto novo. 

a em: ['item:'] fazer: { :boleano
	prop boleano := boleano. 
}.

a em: ['artigo'] fazer: {
	<- prop boleano.
}.

a item: Não.

Saída escrever: a artigo, stop.

>> antigo-endereço-bool := a artigo protótipo endereço-de-memória.
a save-as: ['/tmp/a.bin'].
Saída escrever: ['========== A RECARREGAR SNAP:'], stop.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b artigo protótipo endereço-de-memória = antigo-endereço-bool) sim: {
	Saída escrever: ['Ligação do objeto religada.'], stop.
}.

Saída escrever: b artigo, stop.
