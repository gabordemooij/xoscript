Saída escrever: ['Test object'], stop.
>> a := Objeto novo. 

a em: ['item:'] fazer: { :binhelper
	prop binhelper := binhelper. 
}.

a em: ['item'] fazer: { <- prop binhelper.
}.

a item: Bin novo.

>> old-binhelper-address := a item protótipo endereço-de-memória.
a save-as: ['/tmp/a.bin'].
Saída escrever: ['========== RELOADING SNAP:'], stop.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b item protótipo endereço-de-memória = old-binhelper-address) sim: {
	Saída escrever: ['Object link re-attached.'], stop.
}.


