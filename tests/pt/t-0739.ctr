Saída escrever: ['Objeto de teste'], stop.
>> a := Objeto novo. 

a em: ['item:'] fazer: { :ajudantebin
	prop ajudantebin := ajudantebin. 
}.

a em: ['artigo'] fazer: {
	<- prop ajudantebin.
}.

a item: Bin novo.

>> antigo-endereço-ajudantebin := a artigo protótipo endereço-de-memória.
a save-as: ['/tmp/a.bin'].
Saída escrever: ['========== A RECARREGAR SNAP:'], stop.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b artigo protótipo endereço-de-memória = antigo-endereço-ajudantebin) sim: {
	Saída escrever: ['Ligação do objeto religada.'], stop.
}.


