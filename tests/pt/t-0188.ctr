

>> memóriaUsada1 := 0.
>> memóriaUsada2 := 0.
>> memóriaUsada3 := 0.
>> memóriaUsada4 := 0.

Programa arranjo: 0.

{ :i Saída escrever: i. } × 4.
Saída stop.
{ :i Saída escrever: (4 - i). } × 4.
Saída stop.
( 1 > 2 ) não: { Saída escrever: ['BLOCO 1'], stop. }.
( 2 > 1 ) sim:  { Saída escrever: ['BLOCO 2'], stop. }.

>> i := 0.
{ Saída escrever: i. i adicionar: 1. } enquanto: { <- ( i < 3). }.
Saída stop.

i := 3.
{ Saída escrever: i. i := i - 1. } enquanto: { <- ( i > 0). }.
Saída stop.


Programa limpa-a-memória.

memóriaUsada1 := (Programa memoria ? 0).


{ :i  Saída escrever: i. } × 4.
Saída stop.
{ :i  Saída escrever: (4 - i). } × 4.
Saída stop.
( 1 > 2 ) não: { Saída escrever: ['BLOCO 1'], stop. }.
( 2 > 1 ) sim:  { Saída escrever: ['BLOCO 2'], stop. }.

>> i := 0.
{ Saída escrever: i. i adicionar: 1. } enquanto: { <- ( i < 3). }.
Saída stop.

i := 3.
{ Saída escrever: i. i := i - 1. } enquanto: { <- ( i > 0). }.
Saída stop.



Programa limpa-a-memória.
memóriaUsada2 := (Programa memoria ? 0).


{ :i Saída escrever: i. } × 4.
Saída stop.
{ :i Saída escrever: (4 - i). } × 4.
Saída stop.
( 1 > 2 ) não: { Saída escrever: ['BLOCO 1'], stop. }.
( 2 > 1 ) sim:  { Saída escrever: ['BLOCO 2'], stop. }.

>> i := 0.
{ Saída escrever: i. i adicionar: 1. } enquanto: { <- ( i < 3). }.
Saída stop.

i := 3.
{ Saída escrever: i. i := i - 1. } enquanto: { <- ( i > 0). }.
Saída stop.

Programa limpa-a-memória.
memóriaUsada3 := (Programa memoria ? 0).



( memóriaUsada1 = memóriaUsada2 e: memóriaUsada1 = memóriaUsada3, e: memóriaUsada2 = memóriaUsada3 ) sim: {
	Saída escrever: ['Sem fugas de memória aqui'].
}, não: {
	Saída escrever: ['A perder memória...'].
}.
