# database test
# see example server.xo for required config

Server init.
Saída escrever: ['Database test'], stop.

>> db := MariaDB novo host: ['localhost'],
	utilizador: ['xo'], palavra-passe: ['pass123'], nome-database: ['xobase'], conectar.

Saída escrever: ['Can we connect? '] + db conectado?, stop.

>> parametros := db consulta: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parametros: ( Listar novo ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  parametros executar. db commit. } pegar: { :e db rollback.  }, iniciar.

Saída escrever: ['Can we insert? '] + ( parametros insert-id > 0 ), stop.

>> Obj := Objeto novo.
Obj em: ['retrieve-rows'] fazer: {
	prop conta := 0.
	>> parametros :=
	db consulta: ['SELECT * FROM book order by id desc limit 2'], 
	buscar: { :row 
		prop conta adicionar: 1.
		Sim parar.
	}. <- prop conta copiar.
}.

Saída escrever: ['Can we query? '] + ( Obj retrieve-rows > 0 ), stop.
