# teste de base de dados
# ver o exemplo server.xo para a configuração necessária

Server init.
Saída escrever: ['Teste da base de dados'], stop.

>> bd := MariaDB novo host: ['localhost'],
	utilizador: ['xo'], palavra-passe: ['pass123'], nome-database: ['xobase'], conectar.

Saída escrever: ['Conseguimos ligar? '] + bd conectado?, stop.

>> parametros := bd consulta: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parametros: ( Listar novo ; ['abc'] ; 12.35 ; 6 ). # consultas parametrizadas

{  parametros executar. bd commit. } pegar: { :e bd rollback.  }, iniciar.

Saída escrever: ['Conseguimos inserir? '] + ( parametros insert-id > 0 ), stop.

>> Obj := Objeto novo.
Obj em: ['obter-filas'] fazer: {
	prop conta := 0.
	>> parametros :=
	bd consulta: ['SELECT * FROM book order by id desc limit 2'], 
	buscar: { :fila 
		prop conta adicionar: 1.
		Sim parar.
	}. # obter linhas
	<- prop conta copiar.
}.

Saída escrever: ['Conseguimos consultar? '] + ( Obj obter-filas > 0 ), stop.
