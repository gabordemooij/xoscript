

>> memóriaUsada1 := 0.
>> memóriaUsada2 := 0.
>> memóriaUsada3 := 0.
>> memóriaUsada4 := 0.

Programa arranjo: 0.

>> o := Objeto novo.
>> o2 := Objeto novo.
Saída escrever: o Nulo?, stop.
Saída escrever: o tipo, stop.
Saída escrever: ( o igual: o ), stop.
Saída escrever: ( o igual: o2 ), stop.
Saída escrever: o em-si, stop.
Saída escrever: ( o fazer pronto ), stop.

Programa limpa-a-memória.

memóriaUsada1 := (Programa memoria ? 0).


o := Objeto novo.
o2 := Objeto novo.
Saída escrever: o Nulo?, stop.
Saída escrever: o tipo, stop.
Saída escrever: ( o igual: o ), stop.
Saída escrever: ( o igual: o2 ), stop.
Saída escrever: o em-si, stop.
Saída escrever: ( o fazer pronto ), stop.

