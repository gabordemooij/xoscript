Programa arranjo: 0.
Listar em: ['sum'] fazer: {
	>> total := 0.
	isto cada-um: { :index :element
		total adicionar: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Arquivo novo: ['/tmp/test.txt'].
f escrever: ['Lorem Ipsum'].
f fechar.
  

f := Arquivo novo: ['/tmp/test.txt'].
>> text := f ler.
f fechar.



Programa limpa-a-memória.
usedMemory1 := (Programa memoria ? 1).



f := Arquivo novo: ['/tmp/test.txt'].
text := f ler.
f fechar.

Programa limpa-a-memória.
usedMemory2 := (Programa memoria ? 1).


f := Arquivo novo: ['/tmp/test.txt'].
text := f ler.
f fechar.

Programa limpa-a-memória.
usedMemory3 := (Programa memoria ? 1).



( usedMemory1 = usedMemory2 e: usedMemory1 = usedMemory3, e: usedMemory2 = usedMemory3 ) sim: {
	Saída escrever: ['No memory leaks here'].
}, não: {
	Saída escrever: ['Leaking memory...'].
}.
