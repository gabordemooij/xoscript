

>> memóriaUsada1 := 0.
>> memóriaUsada2 := 0.
>> memóriaUsada3 := 0.
>> memóriaUsada4 := 0.

Programa arranjo: 0.

Número em: ['addNum:'] fazer: { :x
	isto adicionar: x.
}.

Número em: ['subtractNum:'] fazer: { :x
	isto subtrair: x.
}.

Número em: ['multiplyBy:'] fazer: { :x
	isto multiplicar-por: x.
}.

Número em: ['divideBy:'] fazer: { :x
	isto dividir-por: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 ao-poder: 8).  
a := a + (2 ao-poder: -1). 
a := a + (49 sqrt).   
a addNum: ((Listar ← 0 ; 1) max).          
a addNum: ((Listar ← 2 ; 3) min).
Saída escrever: a.

Programa limpa-a-memória.

memóriaUsada1 := (Programa memoria ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 ao-poder: 8).  
a := a + (2 ao-poder: -1). 
a := a + (49 sqrt).   
a addNum: ((Listar ← 0 ; 1) max).          
a addNum: ((Listar ← 2 ; 3) min).
Saída escrever: a.

Programa limpa-a-memória.
memóriaUsada2 := (Programa memoria ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 ao-poder: 8).  
a := a + (2 ao-poder: -1). 
a := a + (49 sqrt).   
