>> frases := Listar novo
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> mensagem := ['Phrase: ~decoded base64: ~encoded'].
	
frases cada-um: { :_ :frase 
	>> e := Server base64-codificar: frase.
	>> d := Server base64-decodificar: e.
	Saída escrever: (
		mensagem copiar ~encoded: e, ~decoded: d
	), stop.
}.
