# quebras de linha nos valores não devem criar cabeçalhos extra
Server inicializar.
Programa usar: ['../../../src/xo/pt/webtools.xo'].
Programa usar: ['../../../src/xo/pt/mailtools.xo'].

>> cabeçalho := Cabeçalho-HTTP novo chave: ['Location'] valor: ['/ok\r\nX-Injected: yes'].
Saída escrever: cabeçalho.

>> web := Documento-Web novo.
web ir-para: ['/ok\r\nX-Injected: yes'].
Saída escrever: ['\n'], stop.

>> correio := Email novo.
correio destinatário: (Listar novo ; ['a@example.invalid\r\nX-To: yes']).
correio cc: (Listar novo ; ['b@example.invalid\r\nX-Cc: yes']).
correio bcc: (Listar novo ; ['c@example.invalid\r\nX-Bcc: yes']).
correio remetente: ['d@example.invalid\r\nX-From: yes'] nome: ['site\r\nX-Name: yes'].
correio assunto: ['hello\r\nX-Subject: yes'].
correio corpo: ['line1\r\nline2'].
Saída escrever: correio gerar.

>> html := Email-HTML novo.
html destinatário: (Listar novo ; ['a@example.invalid\r\nX-To: yes']).
html remetente: ['d@example.invalid'] nome: ['site'].
html assunto: ['hello\r\nX-Subject: yes'].
html corpo: ['body'].
Saída escrever: ( html gerar contem: ['\nX-'] ), stop.
Saída escrever: ( html gerar contem: ['X-To: yes'] ), stop.
