

String em: ['evaluate'] fazer: {
	>> code := Arquivo novo: ['/tmp/eval.ctr'].
	code escrever: isto string + ['.'].
	Programa usar: ['/tmp/eval.ctr'].
}.

>> a := (Listar ← (
	(Mapa novo)
		colocar: ['domain'] em: ['mywebsite.com'],
		colocar: (Listar ←
			((Mapa novo)
				colocar: ['home'] em: ['title'],
				colocar: ['<html></html>'] em: ['body'],
				colocar: ['2017-01-01'] em: ['created']
			) ;
			((Mapa novo)
				colocar: ['aboutus(c)'] em: ['title'],
				colocar: ['<credits>Author Inc.</credits>'] em: ['body']
			)
		) em: ['pages']
	)
) string.

Saída escrever: a tipo, stop.
Saída escrever: a, stop.

>> b := Nulo.
(['b := '] + a) evaluate.
Saída escrever: b ? 0 ? ['pages'] ? 1 ? ['body'], stop.

>> c := b ? 0.
>> d := c string.
Saída escrever: d tipo, stop.

>> e := Nulo.
(['e := '] + d) evaluate.
Saída escrever: e ? ['pages'] ? 0, stop.
