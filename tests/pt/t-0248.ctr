

String em: ['avaliar'] fazer: {
	>> code := Arquivo novo: ['/tmp/eval.ctr'].
	code escrever: isto string + ['.'].
	Programa usar: ['/tmp/eval.ctr'].
}.

>> a := (Listar ← (
	(Mapa novo)
		colocar: ['domínio'] em: ['mywebsite.com'],
		colocar: (Listar ←
			((Mapa novo)
				colocar: ['início'] em: ['title'],
				colocar: ['<html></html>'] em: ['body'],
				colocar: ['2017-01-01'] em: ['criado']
			) ;
			((Mapa novo)
				colocar: ['sobrenos(c)'] em: ['title'],
				colocar: ['<credits>Author Inc.</credits>'] em: ['body']
			)
		) em: ['páginas']
	)
) string.

Saída escrever: a tipo, stop.
Saída escrever: a, stop.

>> b := Nulo.
(['b := '] + a) avaliar.
Saída escrever: b ? 0 ? ['páginas'] ? 1 ? ['body'], stop.

>> c := b ? 0.
>> d := c string.
Saída escrever: d tipo, stop.

>> e := Nulo.
(['e := '] + d) avaliar.
Saída escrever: e ? ['páginas'] ? 0, stop.
