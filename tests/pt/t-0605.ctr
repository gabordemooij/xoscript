>> fatura := Objeto novo.
fatura em: ['iniciar'] fazer: {
        prop número := 0.
}.

fatura em: ['número'] fazer: {
        prop número adicionar: 1.
        <- prop número copiar.
}.

>> fatura-anual := fatura novo.
fatura-anual em: ['start:'] fazer: { :ano
	prop número := ano.
}.

fatura-anual start: 202000.
Saída escrever: fatura-anual número, stop.
Saída escrever: fatura-anual número, stop.
