
>> Sorvedor := Objeto novo.

Sorvedor em: ['novo'] fazer: {
	prop str := [''].
}.

Sorvedor em: ['responder:'] fazer: { :blah
		(prop str = ['']) sim: {
			prop str acrescentar: blah.
		}, senão: {
			prop str acrescentar: [' '].
			prop str acrescentar: blah.
		}.
}.

Sorvedor em: ['responder:e:'] fazer: { :blah :blahah
		(blah comprimento > 1) sim: {
			prop str acrescentar: (blah de: 0 comprimento: (blah comprimento - 1)).
		}, senão: {
			prop str acrescentar: blah.
		}.
		prop str acrescentar: [' '].
		prop str acrescentar: blahah.
}.

Sorvedor em: ['recolher'] fazer: {
	>> buffer := prop str.
	prop str := ['']. <- buffer.
}.

Saída escrever: ( Programa comando-do-sistema: ( Sorvedor novo echo hello world recolher ) ).
