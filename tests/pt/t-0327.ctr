

Listar em: ['fixture:'] fazer: { :f
	prop acessório := f.
}.

Listar em: ['conta'] fazer: { <- prop acessório.
}.

Listar em: ['aantal'] fazer: { <- prop acessório.
}.


>> x := Nulo.
{

	x := ['hello'] 
	substituir:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] caracter: 2)
			)
		)
	com: (
		(['...hal'] + ['lo']) 
			maiúsculas 
			lowecase 
			maiúsculas 
			deslocar: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Listar ← 0 ; 1 ; 4; 9 ; (Listar ← 0 ; 3; 1) ; 4
							) penúltimo
						) ? 1
					) + 
					((Listar ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					conta
				)
			)
	).

} × 10.
Saída escrever: x, stop.

