Saída escrever: ['Continue for-loop, No - before 6 and up.'], stop.
{ :i
	Saída escrever: (i + 1), stop.
	((i + 1) > 4) continua.
	Saída escrever: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Saída stop.
Saída escrever: ['Continue while-true, No --> before 5 and up.'], stop.
{
	Saída escrever: ['iteration #'] + x, stop.
	x adicionar: 1.
	((x < 5) não) continua.
	Saída escrever: ['-->'].
} enquanto: xIsLessThan10.
Saída stop.
Saída escrever: ['Continue while-false, No - before 3 only.'], stop.
{
	Saída escrever: ['iteration #'] + x, stop.
	x subtrair: 1.
	(x = 3) continua.
	Saída escrever: ['-'].
} enquanto: { <- ( x > 0). }.

Saída stop.
Saída escrever: ['Continue times-loop, No ||| before 3.'], stop.
{ :i
	Saída escrever: ['iteration #'] + i, stop.
	(i = 2) continua.
	Saída escrever: ['|||'].
} × 5.

Saída stop.

{ Sim continua. Saída escrever: ['dont write this!'], stop. } iniciar.

{ Sim continua. Saída escrever: ['dont write this!'], stop. } pegar: { Saída escrever: ['Dont catch this!']. }, iniciar.

Saída escrever: ['Test Array each-loop: 0, ... ,2'], stop.
(Listar ← 1 ; 2 ; 3) mapa: { :i
	(i = 1) continua.
	Saída escrever: ['iteration #'] + (i - 0), stop.
}.

Saída escrever: ['Test Map each-loop: c only'], stop.
>> m := Mapa novo.
m colocar: ['first'] em: ['a'], colocar: ['second'] em: ['b'], colocar: ['third'] em: ['c'].
m cada-um: { :k :v
	(k ≠ ['c']) continua.
	Saída escrever: ['iteration'] + k + v, stop.
}.

