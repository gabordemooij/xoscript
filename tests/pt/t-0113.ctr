Saída escrever: ['Continuar ciclo for, Não - antes de 6 e acima.'], stop.
{ :i
	Saída escrever: (i + 1), stop.
	((i + 1) > 4) continua.
	Saída escrever: ['-'].
} × 10.

>> x := 0.
>> xÉMenorQue10 := { <- ( x < 10 ). }.
Saída stop.
Saída escrever: ['Continuar while-true, Não --> antes de 5 e acima.'], stop.
{
	Saída escrever: ['iteration #'] + x, stop.
	x adicionar: 1.
	((x < 5) não) continua.
	Saída escrever: ['-->'].
} enquanto: xÉMenorQue10.
Saída stop.
Saída escrever: ['Continuar while-false, Não - só antes de 3.'], stop.
{
	Saída escrever: ['iteration #'] + x, stop.
	x subtrair: 1.
	(x = 3) continua.
	Saída escrever: ['-'].
} enquanto: { <- ( x > 0). }.

Saída stop.
Saída escrever: ['Continuar ciclo times, Não ||| antes de 3.'], stop.
{ :i
	Saída escrever: ['iteration #'] + i, stop.
	(i = 2) continua.
	Saída escrever: ['|||'].
} × 5.

Saída stop.

{ Sim continua. Saída escrever: ['não escrever isto!'], stop. } iniciar.

{ Sim continua. Saída escrever: ['não escrever isto!'], stop. } pegar: { Saída escrever: ['Não apanhar isto!']. }, iniciar.

Saída escrever: ['Testar ciclo each do vetor: 0, ... ,2'], stop.
(Listar ← 1 ; 2 ; 3) mapa: { :i
	(i = 1) continua.
	Saída escrever: ['iteration #'] + (i - 0), stop.
}.

Saída escrever: ['Testar ciclo each do Mapa: só c'], stop.
>> m := Mapa novo.
m colocar: ['first'] em: ['a'], colocar: ['second'] em: ['b'], colocar: ['terceiro'] em: ['c'].
m cada-um: { :k :v
	(k ≠ ['c']) continua.
	Saída escrever: ['iteration'] + k + v, stop.
}.

