Listar em: ['copiar'] fazer: {
	>> copiar := Listar novo.
	isto cada-um: { :número :secção
		copiar acrescentar: secção recursivo copiar.
	}.
	<- copiar.
}.

>> ovelha := Listar novo ; ['Dolly'] ; ['Shaun']. 
>> clones := ovelha copiar.
clones cada-um: { :número :ovelha
	ovelha acrescentar: ['2'].
}.

Saída escrever: ovelha, stop.
Saída escrever: clones, stop.
