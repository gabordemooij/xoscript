Listar em: ['copiar'] fazer: {
	>> copiar := Listar novo.
	isto cada-um: { :número :section
		copiar acrescentar: section recursivo copiar.
	}. <- copiar.
}.

>> sheep := Listar novo ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep copiar.
clones cada-um: { :número :sheep
	sheep acrescentar: ['2'].
}.

Saída escrever: sheep, stop.
Saída escrever: clones, stop.
