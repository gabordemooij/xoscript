


>> vinho := Objeto novo.


vinho em: ['paraTexto'] fazer: { <- ['merlot'].
}.

vinho em: ['naarTekst'] fazer: { <- ['merlot'].
}.


vinho em: ['='] fazer: { :other wine <- ( isto paraTexto = other wine ).
}.

vinho em: ['=='] fazer: { :other wine <- ( isto paraTexto = other wine ).
}.



vinho
	caso: ['cabernet'] fazer: { Saída escrever: ['é um Cabernet!']. },
	caso: ['syrah']    fazer: { Saída escrever: ['é um Syrah!'].    },
	caso: ['merlot']   fazer: { Saída escrever: ['é um Merlot!'].   },
	caso: ['malbec']   fazer: { Saída escrever: ['é um Malbec!'].   }.

Saída stop.
