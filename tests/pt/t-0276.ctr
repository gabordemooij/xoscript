>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objeto novo.
⚄ em: ['drawFrom:length:'] fazer: { :pool :conta
	
	>> result := [''].
	
	{
		>> index := Número random % (pool comprimento).
		result acrescentar: ( pool caracter: (index + 1) ).
		
	} × conta. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? comprimento.
Saída escrever: (['x↵'] x random comprimento).
Saída escrever: (['y↵'] y ?? comprimento).

