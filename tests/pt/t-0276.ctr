>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objeto novo.
⚄ em: ['tirarDe:quantidade:'] fazer: { :urna :conta
	
	>> resultado := [''].
	
	{
		>> índice := Número aleatório % (urna comprimento).
		resultado acrescentar: ( urna caracter: (índice + 1) ).
		
	} × conta. <- resultado.
}.

>> aleatório := ⚄ tirarDe: ?? quantidade: ?? comprimento.
Saída escrever: (['x↵'] x aleatório comprimento).
Saída escrever: (['y↵'] y ?? comprimento).

