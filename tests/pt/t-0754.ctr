Saída escrever: ['Objeto de teste'], stop.
>> a := Objeto novo. 

a em: ['item:'] fazer: { :sai
	prop sai := sai. 
}.

a em: ['artigo'] fazer: {
	<- prop sai.
}.

a em: ['saudar'] fazer: {
	Saída escrever: ['viva do out original!'], stop.
}.

a item: Saída.

Saída escrever: a artigo, stop.

>> antigo-endereço-sai := a artigo protótipo endereço-de-memória.
a save-as: ['/tmp/a.bin'].
Saída escrever: ['========== A RECARREGAR SNAP:'], stop.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b artigo protótipo endereço-de-memória = antigo-endereço-sai) sim: {
	Saída escrever: ['Ligação do objeto religada.'], stop.
}.

b artigo escrever: ['olá do out carregado!'], stop.
b saudar.
