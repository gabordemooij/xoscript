>> memóriaUsada4 := 0.

Programa arranjo: 0.

>> txt := ['Word Salad'].
Saída escrever: ['Comprimento do texto: '] + txt comprimento, stop.
Saída escrever: ['Carácter na posição 2:'] + ( txt caracter: 2 ), stop.
Saída escrever: (( txt encontre: ['S'] ) - 0), stop.

Programa limpa-a-memória.

memóriaUsada1 := (Programa memoria ? 0).


txt := ['Word Salad'].
