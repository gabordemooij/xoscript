#Linux
>> SO := Programa configurar: ['SO'].

>> relógio := Momento novo.
	
(SO = ['Haiku']) sim: {
	relógio zona: ['CET'],
	ano: 2017, mês: 7, dia: 13,
	hora: 18, minuto: 0, segundo: 0.
}, senão: {
	relógio zona: ['Europe/Amsterdam'],
	ano: 2017, mês: 7, dia: 13,
	hora: 18, minuto: 0, segundo: 0.
}.

relógio em: ['anunciar'] fazer: {
	Saída escrever: isto, stop.
}.


relógio adicionar: 2    hora, anunciar.
relógio adicionar: 1    hora, anunciar.
relógio adicionar: 19 minuto, anunciar.
relógio adicionar: 1  minuto, anunciar.
relógio adicionar: 1  minuto, anunciar.
relógio adicionar: 19 segundo, anunciar.
relógio adicionar: 1  segundo, anunciar.
relógio adicionar: 1  segundo, anunciar.
relógio adicionar: 2    ano, anunciar.
relógio adicionar: 1    ano, anunciar.

