# umas aspas que nunca fecham devem dar um erro, não um ciclo infinito
>> caminho := ['/tmp/test0821.csv'].
>> file := Arquivo novo: caminho.

file escrever: ['a,b\n"1,2\n'].
{
	file separador: [','] quotes: ['"'] linhas: { :line
		Saída escrever: line, stop.
	}.
} pegar: { :e Saída escrever: e, stop. }, iniciar.

# umas aspas fechadas continuam a funcionar
file escrever: ['a,b\n"1,2",3'].
file separador: [','] quotes: ['"'] linhas: { :line
	Saída escrever: line, stop.
}.
file apagar.
