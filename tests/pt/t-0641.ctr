# Testar o sanitizador utf8
Server init.

>> casosutf8 := Mapa novo
	# Só ASCII
	colocar: ( Listar novo ; 65 ; 65 ; 65 ; 65 ; 0 ) em: ['AAAA'],
	# sequência válida de 2 bytes
	colocar: ( Listar novo ; 194 ; 162 ; 0 ) em: ['¢'],
	# UTF-8 válido de 3 bytes
    colocar: ( Listar novo ; 226 ; 130 ; 172 ; 0 ) em: ['€'],
	# UTF-8 válido de 4 bytes
    colocar: ( Listar novo ; 240 ; 144 ; 141 ; 136 ; 0 ) em: ['𐍈'],
	# Byte de continuação inválido na sequência E2 28 AC -> início seq. 3b + 28 cont. errada + AC byte cont., mas pertence ao mesmo erro
    colocar: ( Listar novo ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) em: ['A?A'],
	# Codificação demasiado longa do ASCII 'A' (deve passar a ?),
    colocar: ( Listar novo ; 65 ; 193 ; 129 ; 0 ) em: ['A?'],
	# Primeiro byte inválido (0xFF)
    colocar: ( Listar novo ; 255 ; 0 ) em: ['?'],
	# Sequência multibyte incompleta no fim
    colocar: ( Listar novo ; 66 ; 226 ; 0 ) em: ['B?'],
    # String vazia
    #put: ( List new ) at: [''],
	# Várias sequências mistas
    colocar: ( Listar novo ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) em: ['A€?𐍈B'].
	 
casosutf8 cada-um: { :key :value
	>> blob := Blob novo: value conta, bytes: value.
	>> str := blob string.
	(str = key) sim: {
		Saída escrever: ['OK'], stop.
	}, senão: {
		Saída escrever: ['O sanitizador UTF8 falhou em: '] + key + [' obteve: '] + str, stop.
	}.
	blob livre.
}.
