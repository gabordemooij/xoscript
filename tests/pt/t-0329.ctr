Saída escrever: ((Listar novo
	em: ['plaque:'] fazer: { :x prop o := x. },
	em: ['placa']  fazer: { <- prop o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Listar ← 1)
	~ (Listar ← 1 ; 2)
	~ (Listar ← 1 ; 2 ; 3)
	~ (Listar ← 1 ; 2 ; 3 ; 4)
	~ (Listar ← 1 ; 2 ; 3 ; 4 ; 5)
) cada-um: { :i :elem
	{ Saída escrever: este-bloco-de-código. } × elem conta.
	Saída stop.
}) placa, stop.


