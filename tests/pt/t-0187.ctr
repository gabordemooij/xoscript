Número em: ['fatorial'] fazer: {
	>> total := 1.
	{ :índice total multiplicar-por: (isto - índice). } × isto. <- total.
}.

>> memóriaUsada1 := 0.
>> memóriaUsada2 := 0.
>> memóriaUsada3 := 0.
>> memóriaUsada4 := 0.

Programa arranjo: 0.

{
2 expoente fatorial.
Saída escrever: (11 módulo: 3), stop.
Saída escrever: (3.4 arredondado), stop.
Saída escrever: (7.1 cima), stop.
Saída escrever: (7.9 baixo), stop.
}
iniciar.

Programa limpa-a-memória.

memóriaUsada1 := (Programa memoria ? 0).

{
2 expoente fatorial.
Saída escrever: (11 módulo: 3), stop.
Saída escrever: (3.4 arredondado), stop.
Saída escrever: (7.1 cima), stop.
Saída escrever: (7.9 baixo), stop.
}
iniciar.

Programa limpa-a-memória.
memóriaUsada2 := (Programa memoria ? 0).


{
2 expoente fatorial.
Saída escrever: (11 módulo: 3), stop.
Saída escrever: (3.4 arredondado), stop.
Saída escrever: (7.1 cima), stop.
Saída escrever: (7.9 baixo), stop.
} iniciar.

Programa limpa-a-memória.
memóriaUsada3 := (Programa memoria ? 0).



( memóriaUsada1 = memóriaUsada2 e: memóriaUsada1 = memóriaUsada3, e: memóriaUsada2 = memóriaUsada3 ) sim: {
	Saída escrever: ['Sem fugas de memória aqui'].
}, não: {
	Saída escrever: ['A perder memória...'].
}.
