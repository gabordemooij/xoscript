Saída escrever: ['Objeto de teste'], stop.
>> a := Objeto novo. 

a em: ['state:'] fazer: { :list
	prop list := list. 
}.

a em: ['estado'] fazer: {
	Saída escrever: prop list, stop.
}.

a state: ( Listar novo ; ['elementolista'] ; ['elemento2'] ).
a estado.

a save-as: ['/tmp/a.bin'].
Saída escrever: ['========== A RECARREGAR SNAP:'], stop.
>> b := Objeto load-from: ['/tmp/a.bin'].
b estado.