Saída escrever: ['1,2,3,4,5,6,7,8,9,A,'], stop.
>> Âmbito := Objeto novo.
Âmbito em: ['initialize:'] fazer: { :x prop propriedade := x. }.
Âmbito em: ['confirmar'] fazer: { Saída escrever: [',']. }.
Âmbito em: ['teste'] fazer: {
	Saída escrever: prop propriedade.
	isto confirmar.
	( 1 = 1 ) sim: { Saída escrever: prop propriedade. isto confirmar. }.
	( 1 = 0 ) não: { Saída escrever: prop propriedade. isto confirmar. }.
	>> y := 2. { Saída escrever: prop propriedade. isto confirmar. } enquanto: { y subtrair: 1. <- (y > 0). }.
	{ Saída escrever: prop propriedade. isto confirmar. } × 1.
	(Listar ← 1) cada-um: {  Saída escrever: prop propriedade. isto confirmar. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo implementar ordenação própria, este teste falha porque o n.º de iterações difere por plataforma
	(Mapa novo one: ['item']) cada-um: { Saída escrever: prop propriedade. isto confirmar. }.
	{ 1 ÷ 0. } pegar: { Saída escrever: prop propriedade. isto confirmar. }, iniciar.
	Saída stop.
}.
>> âmbito1 := Âmbito novo.
âmbito1 initialize: ['X'].
âmbito1 teste.
>> aFunção := { 
	prop propriedade := ['Y'].
	Saída escrever: prop propriedade.
	isto confirmar.
	( 1 = 1 ) sim: { Saída escrever: prop propriedade. isto confirmar. }.
	( 1 = 0 ) não: { Saída escrever: prop propriedade. isto confirmar. }.
	>> y := 2. { Saída escrever: prop propriedade. isto confirmar. } enquanto: { y subtrair: 1. <- (y > 0). }.
	{ Saída escrever: prop propriedade. isto confirmar. } × 1.
	(Listar ← 1) cada-um: {  Saída escrever: prop propriedade. isto confirmar. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Mapa novo one: ['item']) cada-um: { Saída escrever: prop propriedade. isto confirmar. }.
	{ 1 ÷ 0. } pegar: { Saída escrever: prop propriedade. isto confirmar. }, iniciar.
	Saída stop.
}.
aFunção em: ['confirmar'] fazer: { Saída escrever: [',']. }.
aFunção aplicar: 1 e: 2.
