Número em: ['romano'] fazer: {
	>> número := isto copiar.
	>> romano := [''].
	{
		{
			(número ≥ 1000) sim: {
				romano acrescentar: ['Ⅿ'].
				número subtrair: 1000.
			}, parar.
		
			(número ≥ 500) sim: {
				romano acrescentar: ['Ⅾ'].
				número subtrair: 500.
			}, parar.
		
			(número ≥ 100) sim: {
				romano acrescentar: ['Ⅽ'].
				número subtrair: 100.
			}, parar.
		
			(número ≥ 50) sim: {
				romano acrescentar: ['Ⅼ'].
				número subtrair: 50.
			}, parar.
		
			(número ≥ 50) sim: {
				romano acrescentar: ['Ⅼ'].
				número subtrair: 50.
			}, parar.
		
			(número ≥ 10) sim: {
				romano acrescentar: ['Ⅹ'].
				número subtrair: 10.
			}, parar.
			
			(número ≥ 9) sim: {
				romano acrescentar: ['Ⅸ'].
				número subtrair: 9.
			}, parar.
			
			(número ≥ 5) sim: {
				romano acrescentar: ['Ⅴ'].
				número subtrair: 5.
			}, parar.
			
			(número ≥ 4) sim: {
				romano acrescentar: ['Ⅳ'].
				número subtrair: 4.
			}, parar.
			
			(número ≥ 1) sim: {
				romano acrescentar: ['Ⅰ'].
				número subtrair: 1.
			}, parar.
		} procedimento.
	} enquanto: { <- número > 0. }. <- romano.
}.

Saída escrever: 1 romano, stop.
Saída escrever: 2 romano, stop.
Saída escrever: 4 romano, stop.
Saída escrever: 8 romano, stop.
Saída escrever: 16 romano, stop.
Saída escrever: 32 romano, stop.
Saída escrever: 64 romano, stop.
Saída escrever: 128 romano, stop.
Saída escrever: 256 romano, stop.
Saída escrever: 1024 romano, stop.
