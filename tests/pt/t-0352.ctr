Número em: ['roman'] fazer: {
	>> número := isto copiar.
	>> roman := [''].
	{
		{
			(número ≥ 1000) sim: {
				roman acrescentar: ['Ⅿ'].
				número subtrair: 1000.
			}, parar.
		
			(número ≥ 500) sim: {
				roman acrescentar: ['Ⅾ'].
				número subtrair: 500.
			}, parar.
		
			(número ≥ 100) sim: {
				roman acrescentar: ['Ⅽ'].
				número subtrair: 100.
			}, parar.
		
			(número ≥ 50) sim: {
				roman acrescentar: ['Ⅼ'].
				número subtrair: 50.
			}, parar.
		
			(número ≥ 50) sim: {
				roman acrescentar: ['Ⅼ'].
				número subtrair: 50.
			}, parar.
		
			(número ≥ 10) sim: {
				roman acrescentar: ['Ⅹ'].
				número subtrair: 10.
			}, parar.
			
			(número ≥ 9) sim: {
				roman acrescentar: ['Ⅸ'].
				número subtrair: 9.
			}, parar.
			
			(número ≥ 5) sim: {
				roman acrescentar: ['Ⅴ'].
				número subtrair: 5.
			}, parar.
			
			(número ≥ 4) sim: {
				roman acrescentar: ['Ⅳ'].
				número subtrair: 4.
			}, parar.
			
			(número ≥ 1) sim: {
				roman acrescentar: ['Ⅰ'].
				número subtrair: 1.
			}, parar.
		} procedimento.
	} enquanto: { <- número > 0. }. <- roman.
}.

Saída escrever: 1 roman, stop.
Saída escrever: 2 roman, stop.
Saída escrever: 4 roman, stop.
Saída escrever: 8 roman, stop.
Saída escrever: 16 roman, stop.
Saída escrever: 32 roman, stop.
Saída escrever: 64 roman, stop.
Saída escrever: 128 roman, stop.
Saída escrever: 256 roman, stop.
Saída escrever: 1024 roman, stop.
