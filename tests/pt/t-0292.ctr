>> adega := { <- (	Mapa novo
		colocar: 2 em: ['merlot'],
		colocar: 3 em: ['malbec'],
		colocar: 4 em: ['syrah']
	).
}.

Saída escrever: (((adega iniciar) - ['nada']) conta), stop.
Saída escrever: (((adega iniciar) - ['merlot']) conta), stop.
Saída escrever: (((adega iniciar) - ['malbec']) conta), stop.
Saída escrever: (((adega iniciar) - ['syrah']) conta), stop.
Saída escrever: (((adega iniciar) - ['merlot'] - ['malbec']) conta), stop.
Saída escrever: (((adega iniciar) - ['merlot'] - ['syrah']) conta), stop.
Saída escrever: (((adega iniciar) - ['malbec'] -['syrah']) conta), stop.
Saída escrever: (((adega iniciar) - ['malbec'] - ['syrah'] - ['merlot']) conta), stop.

