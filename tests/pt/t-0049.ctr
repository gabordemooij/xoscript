>> f1 := Arquivo novo: ['notafile'].
>> f2 := Arquivo novo: ['/tmp/test.txt'].
(f2 existe) sim: { f2 apagar.}.
Saída escrever: f2 caminho.
f2 escrever: ['Hello!'].
f2 acrescentar: ['Mundo!'].
Saída escrever: f2 ler.
(f2 existe) sim: { Saída escrever: ['!']. }.
(f1 existe) sim: { Saída escrever: ['!']. }.
Saída escrever: f2 tamanho, escrever: f1 tamanho.
f2 apagar. Saída escrever: f2 tamanho.

