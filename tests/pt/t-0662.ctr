>> t := Nulo.

# pode controlar o fuso horário para
# a análise assim:
Momento zona: ['CET'].
t := Momento de: ['1981-02-03 04:05:06'].
Saída escrever: t, stop.

# agora com o fuso horário CEST:
Momento zona: ['CEST'].
t := Momento de: ['1981-02-03 04:05:06'].
Saída escrever: t, stop.

# erro se a string não puder ser analisada
{ Momento de: ['1900']. } pegar: { Nulo. }, iniciar.
