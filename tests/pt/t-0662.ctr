>> t := Nulo.

# you can control the time zone for
# parsing like this:
Momento zona: ['CET'].
t := Momento de: ['1981-02-03 04:05:06'].
Saída escrever: t, stop.

# now using CEST time zone:
Momento zona: ['CEST'].
t := Momento de: ['1981-02-03 04:05:06'].
Saída escrever: t, stop.

# error if string cannot be parsed
{ Momento de: ['1900']. } pegar: { Nulo. }, iniciar.
