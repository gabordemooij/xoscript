>> repetidor := Objeto novo.
repetidor em: ['responder:'] fazer: { :oQue
	Saída escrever: oQue + [' '].
}.
repetidor em: ['responder:e:'] fazer: { :oQue :say
	Saída escrever: oQue, escrever: say + [' '].
}.
repetidor em: ['responder:e:e:'] fazer: { :oQue :say :mais
	Saída escrever: oQue, escrever: say, escrever: mais.
}.
repetidor repetir.
repetidor everything: ['Eu digo.'].
repetidor and: ['I '] everything: ['faço.'].
