
>> dicionário := (
	Mapa novo
		colocar: ['b'] em: ['a'],
		colocar: ['a'] em: ['b'],
		colocar: ['z'] em: ['x'],
		colocar: ['hello'] em: ['hallo'],
		colocar: ['humano'] em: ['humano']
).

>> comparações := Listar novo.
dicionário cada-um: { :a :b
	comparações ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a comparar: b)
	).
}.

comparações oedenar: { :a :b <- ( a comparar: b ). }.
Saída escrever: ( comparações juntar: ['↵'] ), stop.
comparações juntar: ['↵'].
