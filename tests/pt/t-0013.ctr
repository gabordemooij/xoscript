
>> Animal := Objeto novo.
Animal em: ['novo'] fazer: {
	<- isto novo init.
}.

Animal em: ['init'] fazer: {
	prop som := ['?'].
	prop patas  := 4.
}.

>> Cão := Animal novo.
Cão em: ['init'] fazer: {
	isto init.
	prop som := ['ladra'].
}.

Animal em: ['string'] fazer: {
	<- prop patas string + prop som.
}.

>> caniche := Cão novo.
Saída escrever: caniche, stop.

