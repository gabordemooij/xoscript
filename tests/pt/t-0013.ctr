
>> Animal := Objeto novo.
Animal em: ['novo'] fazer: { <- isto novo init.
}.

Animal em: ['init'] fazer: {
	prop sound := ['?'].
	prop legs := 4.
}.

>> Dog := Animal novo.
Dog em: ['init'] fazer: {
	isto init.
	prop sound := ['barks'].
}.

Animal em: ['string'] fazer: { <- prop legs string + prop sound.
}.

>> poodle := Dog novo.
Saída escrever: poodle, stop.

