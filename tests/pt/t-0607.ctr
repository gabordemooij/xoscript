>> Combinação := Listar novo.

Combinação em: ['acrescentar:'] fazer: { :elem
	isto 
	encontre: elem, Nulo? sim: { isto acrescentar: elem. }.
}.

>> tons := Combinação novo.
tons
	acrescentar: ['vermelho'],
	acrescentar: ['verde'],
	acrescentar: ['azul'],
	acrescentar: ['vermelho'].

Saída escrever: tons, stop.
