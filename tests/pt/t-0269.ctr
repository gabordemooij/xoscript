#Linux

(Arquivo novo: ['/tmp/testje']) existe não: {
	Programa comando-do-sistema: ['mkdir /tmp/testje'].	
}.

(Arquivo novo: ['/tmp/testje/file1']) existe não: {
	Programa comando-do-sistema: ['touch /tmp/testje/file1'].	
}.

(Arquivo novo: ['/tmp/testje/folder1']) existe não: {
	Programa comando-do-sistema: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Arquivo lista: ['/tmp/testje'].

>> q := Listar novo.

l cada-um: { :k :v v cada-um: { :x :y q acrescentar: y. }. }.

>> s := q string.

(s contem: ['file1']) sim:   { Saída escrever: ['OK'], stop. }.
(s contem: ['file2']) sim:   { Saída escrever: ['XX'], stop. }.
(s contem: ['folder1']) sim: { Saída escrever: ['OK'], stop. }.
