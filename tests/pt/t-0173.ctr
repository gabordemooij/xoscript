

Listar em: ['soma'] fazer: {
	>> total := 0.
	isto cada-um: { :índice :elemento
		total adicionar: elemento.
	}. <- total.
}.

Listar em: ['produto'] fazer: {
	>> total := 1.
	isto cada-um: { :índice :elemento
		total multiplicar-por: elemento.
	}. <- total.
}.

>> memóriaUsada1 := 0.
>> memóriaUsada2 := 0.
>> memóriaUsada3 := 0.
>> memóriaUsada4 := 0.

Programa arranjo: 0.

{

>> a := Listar ← ['hello'] ; ['world'] ; Sim ; Nulo ; 666.
a := a + ( Listar ← 1 ).
Saída escrever: ( ['soma: '] + ( a soma ) ), stop.
Saída escrever: ( ['mín: '] + ( a min ) ), stop.
Saída escrever: ( ['máx: '] + ( a max ) ), stop.
Saída escrever: ( ['3.º: '] + ( a ? 2 ) ), stop.
Saída escrever: ( ['prod: '] + ( a produto ) ), stop.
a oedenar: { :a :b <- (b - a). }.
a cada-um: { :i :e Saída escrever: ( i - 0 ), stop. }.

} iniciar.

Programa limpa-a-memória.
memóriaUsada1 := (Programa memoria ? 0).


