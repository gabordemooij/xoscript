Saída escrever: ( ['3.º: '] + ( a ? 2 ) ), stop.
Saída escrever: ( ['prod: '] + ( a produto ) ), stop.
a oedenar: { :a :b <- (b - a). }.
a cada-um: { :i :e Saída escrever: ( i - 0 ), stop. }.

