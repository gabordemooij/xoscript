
Saída escrever: ['Interromper ciclo for, 0-4.'], stop.
{ :i
	Saída escrever: ['iteration #'] + i, stop.
	(i = 4) parar.
} × 10.

>> x := 0.
>> xÉMenorQue10 := { <- ( x < 10 ). }.

Saída escrever: ['Interromper ciclo while-true, 0-4.'], stop.
{
	Saída escrever: ['iteration #'] + x, stop.
	x adicionar: 1.
	((x < 5) não) parar.
} enquanto: xÉMenorQue10.

Saída escrever: ['Interromper ciclo while-false, 5,4.'], stop.
{
	Saída escrever: ['iteration #'] + x, stop.
	x subtrair: 1.
	(x = 3) parar.
} enquanto: { <- (x > 0). }.

Saída escrever: ['Interromper ciclo times, 1-4.'], stop.
{ :i
	Saída escrever: ['iteration #'] + i, stop.
	(i = 4) parar.
} × 5.

Saída escrever: ['Interromper bloco, não imprimir linha.'], stop.
{ Sim parar. Saída escrever: ['não escrever isto!'], stop. } iniciar.

Saída escrever: ['Interromper bloco, não disparar catch...'], stop.
{ Sim parar. Saída escrever: ['não escrever isto!'], stop. } pegar: { Saída escrever: ['Não apanhar isto!']. }, iniciar.

Saída escrever: ['Testar ciclo each do vetor: 0,1'], stop.
(Listar ← 1 ; 2 ; 3) mapa: { :i
	Saída escrever: ['iteration #'] + i, stop.
	(i = 1) parar.
}.

Saída escrever: ['Testar ciclo each do Mapa: só c'], stop.
>> m := Mapa novo.
m colocar: ['first'] em: ['a'], colocar: ['second'] em: ['b'], colocar: ['terceiro'] em: ['c'].
m cada-um: { :k :v
	Saída escrever: ['iteration'] + v + k, stop.
	Sim parar.
}.

