>> str := ['write:'].
Saída menssagem: ['escrever:'] argumentos: (Listar ← ['Hello World']), stop. 

Número em: ['isbetween:and:'] fazer: { :a :b <- ((isto ≥ a) e: (isto ≤ b)).
}.

str := ['isbetween:and:'].
Saída escrever: (3 menssagem: str argumentos: (Listar ← 2 ; 8)), stop.
Saída escrever: (3 menssagem: str argumentos: (Listar ← 1 ; 2)), stop.


>> MáquinaDeCafé := Objeto novo.
MáquinaDeCafé em: ['makeCoffeeWithSugar:milk:'] fazer: { :sugar :milk <- ( ['Aqui tem... café com '] + 
			sugar +
			[' colheres de açúcar e '] +
			milk +
			[' gotas de leite.']
	).
}.

>> encomenda := ['makeCoffeeWithSugar:milk:'].
>> configuraçãoCafé := Listar ← 4 ; 2.
Saída escrever: ( MáquinaDeCafé menssagem: encomenda argumentos: configuraçãoCafé ), stop.
