>> str := ['write:'].
Saída menssagem: ['escrever:'] argumentos: (Listar ← ['Hello World']), stop. 

Número em: ['isbetween:and:'] fazer: { :a :b <- ((isto ≥ a) e: (isto ≤ b)).
}.

str := ['isbetween:and:'].
Saída escrever: (3 menssagem: str argumentos: (Listar ← 2 ; 8)), stop.
Saída escrever: (3 menssagem: str argumentos: (Listar ← 1 ; 2)), stop.


>> CoffeeMachine := Objeto novo.
CoffeeMachine em: ['makeCoffeeWithSugar:milk:'] fazer: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Listar ← 4 ; 2.
Saída escrever: ( CoffeeMachine menssagem: order argumentos: coffeeConfiguration ), stop.
