Número em: ['fatorial'] fazer: {
	>> total := 1.
	{ :índice total multiplicar-por: (isto - (índice)). } × isto. <- total.
}.
>> Impressora := Objeto novo.
Impressora em: ['imprimir:e:'] fazer: { :x :y
	Saída escrever: ['a='] + x + [', b='] + y, stop.
}.
>> a := 4.5. >> b := a baixo.
Impressora imprimir: a e: b.
a := 4. b := a fatorial.
