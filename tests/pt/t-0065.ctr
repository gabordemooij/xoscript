Número em: ['factorial'] fazer: {
	>> total := 1.
	{ :index total multiplicar-por: (isto - (index)). } × isto. <- total.
}.
>> Printer := Objeto novo.
Printer em: ['print:and:'] fazer: { :x :y
	Saída escrever: ['a='] + x + [', b='] + y, stop.
}.
>> a := 4.5. >> b := a baixo.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a cima.
Printer print: a and: b.
a := 4.5. b := a baixo.
Printer print: a and: b.
a := 4.5. b := a arredondado.
Printer print: a and: b.
a := 4.2. b := a arredondado.
Printer print: a and: b.

Saída escrever: (9 módulo: 5), stop.
