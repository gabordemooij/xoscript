Listar em: ['soma'] fazer: {
	>> total := 0.
	isto cada-um: { :índice :elemento
		total adicionar: elemento.
	}. <- total.
}.

>> a := Sim.



a em: ['string'] fazer: {
	>> réplica := Nulo.
	( isto = Sim ) sim: {
		réplica := ['Pois'].
	}, senão: {
		réplica := ['Nem pensar'].
	}. <- réplica.
}.

a em: ['número'] fazer: {
	>> réplica := Nulo.
	( isto = Sim ) sim: {
		réplica := 10.
	}, senão: {
		réplica := 20.
	}. <- réplica.
}.

>> b := 666.

b em: ['string'] fazer: { <- ['Diabo'].
}.

b em: ['boleano'] fazer: { <- Não.
}.


Saída escrever: a, stop.  
Saída escrever: (90 + a), stop. 
Saída escrever: b, stop. 
Saída escrever: (Sim e: b), stop.

a := Listar ← ['hello'] ; ['world'] ; Sim ; Nulo ; 666. 
a := a + ( Listar ← 1 ).
Saída escrever: a, stop.
Saída escrever: ((Mapa novo) colocar: Nulo em: Nulo), stop.
Saída escrever: a soma, stop. 


{
	a em: ['string'] fazer: { <- Nulo. }.
	a := [''] + a.
} pegar: { :falha
	Saída escrever: ['Erro registado: '] + falha, stop.
}, iniciar.



