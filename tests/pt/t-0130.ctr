# usar FFI com o plugin Server

# ligar à libc (específico da plataforma)
>> nomelib := Programa configurar: ['FFITESTLIB'].

# ligar funções stdio de C para operações avançadas com ficheiros
Server ligar: ( Listar novo ;
 nomelib ; ['fopen'] ;
 ( Listar novo ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
ligar: ( Listar novo ;
 Nulo ; # significa a mesma biblioteca
 ['fread'] ;
 ( Listar novo ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nulo ; # significa o mesmo objeto (i.e. Fluxo)
 ['fread']
),
ligar: (
 Listar novo ;
 Nulo ; # significa a mesma biblioteca
 ['fwrite'] ;
 ( Listar novo ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nulo ; # significa a mesma biblioteca
 ['fwrite']
),
ligar: (
 Listar novo ;
 Nulo ; # significa a mesma biblioteca
 ['rewind'] ;
 ( Listar novo ; ['pointer'] ) ;
 ['int'] ;
 Nulo ; # significa a mesma biblioteca
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> caminho := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# abrir um ficheiro com fopen(path, mode)
>> fd := Stream path: caminho mode: mode.

# escrever bytes do buffer str para o ficheiro
>> bytes-escritos := Stream menssagem: ['fwrite'] argumentos: (Listar novo ; str ; 1 ; 6 ; fd ).
Saída escrever: bytes-escritos, stop.

# rebobinar o apontador do ficheiro
Stream rewind: fd.

# alocar um buffer
>> buf := Blob novo: 20.

# ler do ficheiro
>> bytes-lidos := Stream menssagem: ['fread'] argumentos: (Listar novo ; buf ; 1 ; 6 ; fd ).
Saída escrever: bytes-lidos, stop.
Saída escrever: buf, stop.

# libertar memória
str  livre.
caminho livre.
mode livre.
buf  livre.


