Saída escrever: ['Test object'], stop.
>> a := Objeto novo. 
a em: ['item:'] fazer: { :int64
	prop int64 := int64. 
}.
a em: ['item'] fazer: { <- prop int64.
}.
a item: ( Int64 de-string: ['9999'] ).
Saída escrever: a item, stop.
>> old-int64-address := a item protótipo endereço-de-memória.
a save-as: ['/tmp/a.bin'].
Saída escrever: ['========== RELOADING SNAP:'], stop.
>> b := Objeto load-from: ['/tmp/a.bin'].
(b item protótipo endereço-de-memória = old-int64-address) sim: {
	Saída escrever: ['Object link re-attached.'], stop.
}.
Saída escrever: ( b item ), stop.
