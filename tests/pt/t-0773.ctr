Saída escrever: ['Objeto de teste'], stop.
>> a := Objeto novo. 
a em: ['item:'] fazer: { :int64
	prop int64 := int64. 
}.
a em: ['artigo'] fazer: {
	<- prop int64.
}.
a item: ( Int64 de-string: ['9999'] ).
Saída escrever: a artigo, stop.
>> antigo-endereço-int64 := a artigo protótipo endereço-de-memória.
a save-as: ['/tmp/a.bin'].
Saída escrever: ['========== A RECARREGAR SNAP:'], stop.
>> b := Objeto load-from: ['/tmp/a.bin'].
(b artigo protótipo endereço-de-memória = antigo-endereço-int64) sim: {
	Saída escrever: ['Ligação do objeto religada.'], stop.
}.
Saída escrever: ( b artigo ), stop.
