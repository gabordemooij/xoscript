>> aleatorizador := { :a :b
	>> min := ( a < b ) outro: a ou: b.
	>> max := ( a > b ) outro: a ou: b.
	>> x := Nulo.
	{
		x := Número entre: a e: b.
		((x < min) ou: (x > max)) sim: { 
			Saída escrever: (['Valor inválido!']).
			Programa fim.
		}.
	} 
	× 100. <- x.
}.
aleatorizador aplicar: 0 e: 0.
aleatorizador aplicar: 1 e: 0.
aleatorizador aplicar: 1 e: 1.
aleatorizador aplicar: 0 e: 1.
aleatorizador aplicar: -1 e: 0.
aleatorizador aplicar: -1 e: -1.
