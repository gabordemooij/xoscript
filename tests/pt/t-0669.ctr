# Hash de palavras-passe
Server init.

# O utilizador define uma palavra-passe
>> senh := ['pass123'].

# Guarda-se assim
>> hash := Cofre 
	hash-senha: senh.

# Depois, o utilizador inicia sessão
# Tentativa 1
>> a1 := ['abcd123'].
# Tentativa 2
>> a2 := ['pass123'].

# Verificar
>> a := Cofre 
	hash-senha: hash verificar: a1.
	# falha 
>> b := Cofre
	hash-senha: hash verificar: a2.
	# ok!

Saída escrever: a, stop.
Saída escrever: b, stop.

