# um formato deve corresponder ao tipo do valor, o tipo pode vir de um cliente
>> tentar := { :oFormato :value
	{ Saída escrever: ( (Formato novo: oFormato) aplicar: value ), stop. } pegar: { :e Saída escrever: e, stop. }, iniciar.
}.
>> tentar-inteiro := { :oFormato :value
	{ Saída escrever: ( (Formato novo: oFormato) aplicar-int: value ), stop. } pegar: { :e Saída escrever: e, stop. }, iniciar.
}.

# cabe
tentar aplicar: ['|%s|'] e: ['text'].
tentar aplicar: ['%06.2f'] e: 5.5.
tentar aplicar: ['100%% %s'] e: ['claro'].
tentar-inteiro aplicar: ['%03d'] e: 7.
tentar-inteiro aplicar: ['%x'] e: 255.
tentar aplicar: ['%d'] e: (Int64 novo de-string: ['12']).
tentar aplicar: ['%lld'] e: (Int64 novo de-string: ['12']).
tentar aplicar: ['%.1lf'] e: 5.5.
tentar-inteiro aplicar: ['%hd'] e: 7.

# não cabe
tentar aplicar: ['%s'] e: 12345.
tentar aplicar: ['%d'] e: 12345.
tentar aplicar: ['%f'] e: ['text'].
tentar-inteiro aplicar: ['%d'] e: ['text'].
tentar-inteiro aplicar: ['%s'] e: 5.
tentar aplicar: ['%s %s'] e: ['text'].
tentar aplicar: ['%n'] e: ['text'].
tentar aplicar: ['%*s'] e: ['text'].
tentar aplicar: ['%'] e: ['text'].

# o modificador de comprimento não cabe
tentar aplicar: ['%ls'] e: ['text'].
tentar aplicar: ['%Lf'] e: 5.5.
tentar-inteiro aplicar: ['%ld'] e: 7.
tentar-inteiro aplicar: ['%lld'] e: 7.
tentar aplicar: ['%Ld'] e: (Int64 novo de-string: ['12']).

# uma largura que não cabe no printf deve dar um erro, não um crash
tentar aplicar: ['%99999999999s'] e: ['text'].
