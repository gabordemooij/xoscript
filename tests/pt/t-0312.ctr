>> Slurp := Objeto novo.
Slurp em: ['novo'] fazer: {
	prop str := [''].
}.
Slurp aprender: ['nieuw'] significa: ['novo'].
Slurp em: ['responder:'] fazer: { :blah
		(prop str ≠ ['']) sim: {
			prop str acrescentar: [' '].
		}.
		prop str acrescentar: blah.
}.
Slurp em: ['responder:e:'] fazer: { :blah :blahah
		(prop str ≠ ['']) sim: {
			prop str acrescentar: [' '].
		}.
		(blah comprimento > 1) sim: {
			prop str acrescentar: (blah de: 0 comprimento: (blah comprimento - 1)).
		}, senão: {
			prop str acrescentar: blah.
		}.
		prop str acrescentar: [' '].
		prop str acrescentar: blahah.
}.
Slurp em: ['obtain'] fazer: {
	>> buffer := prop str.
	prop str := ['']. <- buffer.
}.


>> parametros := Slurp novo
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

Saída escrever: parametros obtain, stop.
