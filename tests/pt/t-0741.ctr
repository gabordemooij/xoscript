Saída escrever: ['Objeto de teste'], stop.
>> a := Objeto novo. 

a em: ['item:'] fazer: { :ajudanteoct
	prop ajudanteoct := ajudanteoct. 
}.

a em: ['artigo'] fazer: {
	<- prop ajudanteoct.
}.

a item: Oct novo.

>> antigo-endereço-ajudanteoct := a artigo protótipo endereço-de-memória.
a save-as: ['/tmp/a.bin'].
Saída escrever: ['========== A RECARREGAR SNAP:'], stop.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b artigo protótipo endereço-de-memória = antigo-endereço-ajudanteoct) sim: {
	Saída escrever: ['Ligação do objeto religada.'], stop.
}.
