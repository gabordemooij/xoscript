
>> países := Listar novo
	~ ['Suíça']
	~ ['Itália']
	~ ['Alemanha'].

>> comidas := Listar novo
	~ ['Rösti']
	~ ['Esparguete']
	~ ['Chucrute'].


>> contador := 0.
comidas por: países, cada-um: { :key :value
	contador adicionar: 1.
}.

Saída escrever: (['we serve counter dishes'] counter: contador), stop.

>> contador := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] caracteres oedenar: { :v
	contador adicionar: 0.
}.

Saída escrever: (['we sort counter dishes'] counter: contador), stop.


>> contador := 0.
{
	{
		contador adicionar: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Saída escrever: (['we calculate counter numbers.'] counter: contador), stop.

