Server init.
Saída escrever: ['Teste de hora da base de dados'], stop.

>> bd := MariaDB novo host: ['localhost'],
	utilizador: ['xo'], 
	palavra-passe: ['pass123'],
	nome-database: ['xobase'],
	conectar.

>> parametros :=
bd consulta: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
buscar: { :fila
	Saída escrever: fila timetest, stop.
}.
