# um grupo que não faz parte da correspondência não deve dar crash e deve manter os números dos grupos
Server init.
>> mostrar := { :exprReg :subject
	>> p := Padrão novo: exprReg.
	p corresponder: subject fazer: { :m :g
		Saída escrever: g conta, escrever: [' '], escrever: (g juntar: ['|']), stop.
		<- m.
	}.
}.
mostrar aplicar: ['(a)|(b)'] e: ['b'].
mostrar aplicar: ['(a)|(b)'] e: ['a'].
mostrar aplicar: ['(x)?y'] e: ['y'].
mostrar aplicar: ['(x)?(y)(z)?'] e: ['xy'].
