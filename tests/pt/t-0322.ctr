

>> Matriosca := Objeto novo.
Matriosca em: ['double:'] fazer: { :segredo
	prop segredo := segredo × 2.
}.
Matriosca em: ['novo:'] fazer: { :segredo
	>> réplica := Nulo.
	>> t := (segredo > 255).
	Saída escrever: (segredo + [' | '] + t), stop.
	t sim: {
		réplica := segredo.
	}, senão: {
		réplica := Matriosca recursivo novo: (isto double: segredo).
	}. <- réplica.
}.

>> x := Matriosca novo: 2.
