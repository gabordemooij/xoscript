

>> Matryoshka := Objeto novo.
Matryoshka em: ['double:'] fazer: { :secret
	prop secret := secret × 2.
}.
Matryoshka em: ['novo:'] fazer: { :secret
	>> answer := Nulo.
	>> t := (secret > 255).
	Saída escrever: (secret + [' | '] + t), stop.
	t sim: {
		answer := secret.
	}, senão: {
		answer := Matryoshka recursivo novo: (isto double: secret).
	}. <- answer.
}.

>> x := Matryoshka novo: 2.
