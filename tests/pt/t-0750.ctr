Saída escrever: ['Objeto de teste'], stop.
>> a := Objeto novo. 

a em: ['item:'] fazer: { :nil
	prop nil := nil. 
}.

a em: ['artigo'] fazer: {
	<- prop nil.
}.

a item: Nulo.

Saída escrever: a artigo, stop.

>> antigo-endereço-nil := a artigo protótipo endereço-de-memória.
a save-as: ['/tmp/a.bin'].
Saída escrever: ['========== A RECARREGAR SNAP:'], stop.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b artigo protótipo endereço-de-memória = antigo-endereço-nil) sim: {
	Saída escrever: ['Ligação do objeto religada.'], stop.
}.

Saída escrever: b artigo, stop.
