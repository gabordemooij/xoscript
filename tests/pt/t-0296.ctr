
>> loja := (Mapa novo
	colocar: ['revista'] em: ['books'],
	colocar: ['computador'] em: ['eletrónica'],
	colocar: ['batom'] em: ['cosmética']
).
Saída escrever: (loja tem: ['computador']), stop. 
Saída escrever: (loja tem: ['salsicha']), stop. 
Saída escrever: (loja tem: ['computadores']), stop. 
Saída escrever: (loja tem: ['computa']), stop. 
Saída escrever: (loja tem: ['2computador']), stop. 
