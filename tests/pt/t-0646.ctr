Server init.
Saída escrever: ['Teste de data e hora da base de dados'], stop.

>> bd := MariaDB novo host: ['localhost'],
	utilizador: ['xo'], 
	palavra-passe: ['pass123'],
	nome-database: ['xobase'],
	conectar.

>> parametros :=
bd consulta: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
buscar: { :fila
	Saída escrever: fila datetimetest, stop.
}.
