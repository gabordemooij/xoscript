>> números := ['1,2,3'] dividir: [','].
Saída escrever: ['Recebi: '] + números conta + [' números.'],stop.
{ :i Saída escrever: ['number #'] + i + [':'] + (números posição: i), stop.} × 3.
>> bebidas := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
bebidas := bebidas dividir: [' Or '].
Saída escrever: ['Servimos'], stop.
{ :i Saída escrever: ['->'] + (bebidas posição: i), stop. } × (bebidas conta).
Saída escrever: (bebidas juntar: [',']), stop.
Saída escrever: (números juntar: ['||']).
