>> numbers := ['1,2,3'] dividir: [','].
Saída escrever: ['I got: '] + numbers conta + [' numbers.'],stop.
{ :i Saída escrever: ['number #'] + i + [':'] + (numbers posição: i), stop.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages dividir: [' Or '].
Saída escrever: ['We serve'], stop.
{ :i Saída escrever: ['->'] + (beverages posição: i), stop. } × (beverages conta).
Saída escrever: (beverages juntar: [',']), stop.
Saída escrever: (numbers juntar: ['||']).
