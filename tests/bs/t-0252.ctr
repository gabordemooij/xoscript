#Linux
>> časovnik := Trenutak novi.
časovnik zona: ['UTC-1'].
časovnik godina: 1981, mjesec: 1, dan: 5,
      sat: 13, minuta: 15, sekunda: 13.

Izlaz piši: časovnik, novi-red.
časovnik zona: ['UTC+0'].

Izlaz piši: (
	(časovnik godina običan) + ['-'] + (časovnik mjesec) + ['-'] + (časovnik dan) + [' '] +
	(časovnik sat) + [':'] + (časovnik minuta) + [':'] + (časovnik sekunda) + [' '] +
	['W'] + (časovnik sedmica) + (časovnik zona)
), novi-red.


časovnik zona: ['UTC-1'].
Izlaz piši: (
	(časovnik godina običan) + ['-'] + (časovnik mjesec) + ['-'] + (časovnik dan) + [' '] +
	(časovnik sat) + [':'] + (časovnik minuta) + [':'] + (časovnik sekunda) + [' '] +
	['W'] + (časovnik sedmica) + (časovnik zona)
), novi-red.
