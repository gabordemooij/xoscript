60 × {
	>> x := (Broj nasumičan % 6) + 1.
	(x ≤ 6) netačno: { Izlaz piši: ['NEUSPJEH']. }.
	(x ≥0) netačno: { Izlaz piši: ['NEUSPJEH']. }.
	x := (Broj nasumičan % 3) + 1.
	(x < 3) netačno: { Izlaz piši: ['NEUSPJEH']. }.
	(x>-1) netačno: { Izlaz piši: ['NEUSPJEH']. }.
	x := ((Logički baciNovčić) broj).
	(x = 0 ili: x = 1) netačno: { Izlaz piši: ['NEUSPJEH']. }.
	x := ((Tačno baciNovčić) broj).
	(x = 0 ili: x = 1) netačno: { Izlaz piši: ['NEUSPJEH']. }.
	x := (Logički baciNovčić ili: ['GLAVA'] ili: ['PISMO']).
	((x = ['GLAVA']) ili: (x = ['PISMO'])) netačno: { Izlaz piši: ['NEUSPJEH']. }.
}.
Izlaz piši: ['GOTOVO'].

