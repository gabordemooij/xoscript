60 × {
	>> x := (Broj random % 6) + 1.
	(x ≤ 6) netačno: { Izlaz piši: ['FAIL']. }.
	(x ≥0) netačno: { Izlaz piši: ['FAIL']. }.
	x := (Broj random % 3) + 1.
	(x < 3) netačno: { Izlaz piši: ['FAIL']. }.
	(x>-1) netačno: { Izlaz piši: ['FAIL']. }.
	x := ((Logički flip) broj).
	(x = 0 ili: x = 1) netačno: { Izlaz piši: ['FAIL']. }.
	x := ((Tačno flip) broj).
	(x = 0 ili: x = 1) netačno: { Izlaz piši: ['FAIL']. }.
	x := (Logički flip ili: ['HEAD'] ili: ['TAIL']).
	((x = ['HEAD']) ili: (x = ['TAIL'])) netačno: { Izlaz piši: ['FAIL']. }.
}.
Izlaz piši: ['DONE'].

