>> a := 3.
>> b := a kopiraj.
a oduzmi: 1.
Izlaz piši: [' a = '] + a.
Izlaz piši: [' b = '] + b.
a := 3.
b := a + 4.
Izlaz piši: [' a = '] + a.
Izlaz piši: [' b = '] + b.
>> x := 3.
>> y := x kopiraj.
x saberi: 10.
y oduzmi: 1.
Izlaz piši: [' x = '] + x.
Izlaz piši: [' y = '] + y.
>> q := Objekat novi.
q na: ['setProperty:'] uradi: { :x
	svoj osobina := x.
}.
q na: ['dajOsobinu'] uradi: { <- svoj osobina.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Izlaz piši: [' p = '] + (p dajOsobinu).
