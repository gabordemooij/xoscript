Program upravljanje-memorijom: 4.

>> Udvostručivač := Objekat novi.
>> Množitelj := Objekat novi.
Udvostručivač na: ['udvostruči:i:'] uradi: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Množitelj na: ['pomnoži:i:'] uradi: { :x :y <- (x × y).
}.

Izlaz piši: (
	Udvostručivač udvostruči:
		(Udvostručivač udvostruči: 
			(Množitelj pomnoži: 2 i: 3)
		i:
			(Množitelj pomnoži: 3 i: 4)
		)
	i:
		(Udvostručivač udvostruči: 
			(Množitelj pomnoži: 2 i: 3)
		i:
			(Množitelj pomnoži: 3 i: 4)
		)
), novi-red.
