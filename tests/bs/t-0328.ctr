Program upravljanje-memorijom: 4.

>> Doubler := Objekat novi.
>> Multiplier := Objekat novi.
Doubler na: ['double:and:'] uradi: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier na: ['multiply:and:'] uradi: { :x :y <- (x × y).
}.

Izlaz piši: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), novi-red.
