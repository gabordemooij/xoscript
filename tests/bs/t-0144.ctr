



>> CoffeeGrounds := Objekat novi.
CoffeeGrounds na: ['extract'] uradi: { <- ['coffee']. }.

>> CoffeeMachine := Objekat novi.
CoffeeMachine na: ['init'] uradi: {
	svoj coffeegrounds := CoffeeGrounds novi.
}.
CoffeeMachine na: ['novi'] uradi: { <- CoffeeMachine `new init.
}.

CoffeeMachine na: ['makeTea'] uradi: { <- (svoj tealeaves extract). }.
CoffeeMachine na: ['makeCoffee'] uradi: { <- (svoj coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine novi.

Izlaz piši:
	coffeeDream 
	makeCoffee.

Izlaz piši:
	coffeeDream 
	makeTea.
