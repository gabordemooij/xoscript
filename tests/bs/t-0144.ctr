



>> TalogKafe := Objekat novi.
TalogKafe na: ['izvuci'] uradi: { <- ['coffee']. }.

>> AparatZaKafu := Objekat novi.
AparatZaKafu na: ['init'] uradi: {
	svoj talogkafe := TalogKafe novi.
}.
AparatZaKafu na: ['novi'] uradi: { <- AparatZaKafu `new init.
}.

AparatZaKafu na: ['napraviČaj'] uradi: { <- (svoj listovičaja izvuci). }.
AparatZaKafu na: ['napraviKafu'] uradi: { <- (svoj talogkafe izvuci). }.

>> sanOKafi := AparatZaKafu novi.

Izlaz piši:
	sanOKafi 
	napraviKafu.

Izlaz piši:
	sanOKafi 
	napraviČaj.
