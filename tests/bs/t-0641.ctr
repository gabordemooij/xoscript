# Test utf8 sanitizera
Server init.

>> utf8slučajevi := Rječnik novi
	# samo ASCII
	stavi: ( Lista novi ; 65 ; 65 ; 65 ; 65 ; 0 ) na: ['AAAA'],
	# ispravna sekvenca od 2 bajta
	stavi: ( Lista novi ; 194 ; 162 ; 0 ) na: ['¢'],
	# Ispravan 3-bajtni UTF-8
    stavi: ( Lista novi ; 226 ; 130 ; 172 ; 0 ) na: ['€'],
	# Ispravan 4-bajtni UTF-8
    stavi: ( Lista novi ; 240 ; 144 ; 141 ; 136 ; 0 ) na: ['𐍈'],
	# Neispravan bajt nastavka u sekvenci E2 28 AC -> početak 3b sekv. + 28 pogr. nast. + AC bajt nast., ali pripada istoj grešci
    stavi: ( Lista novi ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) na: ['A?A'],
	# Predugo kodiranje ASCII 'A' (treba postati ?),
    stavi: ( Lista novi ; 65 ; 193 ; 129 ; 0 ) na: ['A?'],
	# Neispravan prvi bajt (0xFF)
    stavi: ( Lista novi ; 255 ; 0 ) na: ['?'],
	# Nepotpuna višebajtna sekvenca na kraju
    stavi: ( Lista novi ; 66 ; 226 ; 0 ) na: ['B?'],
    # Prazan tekst
    #put: ( List new ) at: [''],
	# Više mješovitih sekvenci
    stavi: ( Lista novi ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) na: ['A€?𐍈B'].
	 
utf8slučajevi svaki: { :key :value
	>> blob := Blob novi: value broj-elemenata, bytes: value.
	>> str := blob tekst.
	(str = key) tačno: {
		Izlaz piši: ['OK'], novi-red.
	}, inače: {
		Izlaz piši: ['UTF8 čistač nije uspio na: '] + key + [' dobijeno: '] + str, novi-red.
	}.
	blob oslobodi.
}.
