Izlaz piši: ['Test object'], novi-red.
>> a := Objekat novi. 

a na: ['item:'] uradi: { :file
	svoj file := file. 
}.

a na: ['item'] uradi: { <- svoj file.
}.

>> f := Datoteka novi: ['/tmp/aaa.txt'].
a item: f.
Izlaz piši: a item, novi-red.
a save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== RELOADING SNAP:'], novi-red.
>> b := Objekat load-from: ['/tmp/a.bin'].
Izlaz piši: b item, novi-red.
