Izlaz piši: ['Testni objekat'], novi-red.
>> a := Objekat novi. 

a na: ['item:'] uradi: { :oktpomoćnik
	svoj oktpomoćnik := oktpomoćnik. 
}.

a na: ['stavka'] uradi: {
	<- svoj oktpomoćnik.
}.

a item: Oct novi.

>> stara-adresa-oktpomoćnika := a stavka prototip memorijska-adresa.
a save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== PONOVNO UČITAVANJE SNIMKA:'], novi-red.

>> b := Objekat load-from: ['/tmp/a.bin'].

(b stavka prototip memorijska-adresa = stara-adresa-oktpomoćnika) tačno: {
	Izlaz piši: ['Veza objekta ponovo povezana.'], novi-red.
}.
