Izlaz piši: ['Test object'], novi-red.
>> a := Objekat novi. 

a na: ['item:'] uradi: { :octhelper
	svoj octhelper := octhelper. 
}.

a na: ['item'] uradi: { <- svoj octhelper.
}.

a item: Oct novi.

>> old-octhelper-address := a item prototip memorijska-adresa.
a save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== RELOADING SNAP:'], novi-red.

>> b := Objekat load-from: ['/tmp/a.bin'].

(b item prototip memorijska-adresa = old-octhelper-address) tačno: {
	Izlaz piši: ['Object link re-attached.'], novi-red.
}.
