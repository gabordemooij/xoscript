
>> a := Lista ← (Lista ← 100 ; 200 ; 300) ; (Lista ← 9 ; 8 ; 7).
Izlaz piši: ['at 0,1 :'].
Izlaz piši: a ? 0 ? 1, novi-red. 
Izlaz piši: ['at 1,2 :'].
Izlaz piši: a ? 1 ? 2, novi-red. 
>> menu := Rječnik novi.
menu stavi: (Lista ← ['pizza'] ; ['spaghetti']) na: ['Italian Cuisine'].
menu stavi: (Lista ← ['bifteki'] ; ['suflaki']) na: ['Greek Cuisine'].
Izlaz piši: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), novi-red. 
Izlaz piši: ['but not on the same plate.'], novi-red.
