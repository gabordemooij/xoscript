Izlaz piši: ['Test object'], novi-red.
>> cmd := Naredba novi.
Izlaz piši: cmd ls /tmp, novi-red.
>> old-cmd-address := cmd prototip memorijska-adresa.
cmd save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== RELOADING SNAP:'], novi-red.
>> b := Objekat load-from: ['/tmp/a.bin'].
(b prototip memorijska-adresa = old-cmd-address) tačno: {
	Izlaz piši: ['Object link re-attached.'], novi-red.
}.
Izlaz piši: b ls, novi-red.


