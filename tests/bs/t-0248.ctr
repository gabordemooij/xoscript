

Tekst na: ['evaluate'] uradi: {
	>> kod := Datoteka novi: ['/tmp/eval.ctr'].
	kod piši: sebe tekst + ['.'].
	Program koristi: ['/tmp/eval.ctr'].
}.

>> a := (Lista ← (
	(Rječnik novi)
		stavi: ['domain'] na: ['mywebsite.com'],
		stavi: (Lista ←
			((Rječnik novi)
				stavi: ['home'] na: ['title'],
				stavi: ['<html></html>'] na: ['body'],
				stavi: ['2017-01-01'] na: ['created']
			) ;
			((Rječnik novi)
				stavi: ['aboutus(c)'] na: ['title'],
				stavi: ['<credits>Author Inc.</credits>'] na: ['body']
			)
		) na: ['pages']
	)
) tekst.

Izlaz piši: a tip, novi-red.
Izlaz piši: a, novi-red.

>> b := Ništa.
(['b := '] + a) evaluate.
Izlaz piši: b ? 0 ? ['pages'] ? 1 ? ['body'], novi-red.

>> c := b ? 0.
>> d := c tekst.
Izlaz piši: d tip, novi-red.

>> e := Ništa.
(['e := '] + d) evaluate.
Izlaz piši: e ? ['pages'] ? 0, novi-red.
