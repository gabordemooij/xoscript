Izlaz piši: ['Testni objekat'], novi-red.
>> l := Lista novi ; 1 ; ( Lista novi ; (Trenutak novi: 1) ; (Int64 iz-teksta: ['321']) ; (Lista novi ; 3)).
Izlaz piši: l, novi-red.
>> stara-adresa-lst := l prototip memorijska-adresa.
l save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== PONOVNO UČITAVANJE SNIMKA:'], novi-red.
>> b := Objekat load-from: ['/tmp/a.bin'].
(b prototip memorijska-adresa = stara-adresa-lst) tačno: {
	Izlaz piši: ['Veza objekta ponovo povezana.'], novi-red.
}.
Izlaz piši: b, novi-red.
