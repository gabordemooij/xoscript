Izlaz piši: ['Test object'], novi-red.
>> l := Lista novi ; 1 ; ( Lista novi ; (Trenutak novi: 1) ; (Int64 iz-teksta: ['321']) ; (Lista novi ; 3)).
Izlaz piši: l, novi-red.
>> old-lst-address := l prototip memorijska-adresa.
l save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== RELOADING SNAP:'], novi-red.
>> b := Objekat load-from: ['/tmp/a.bin'].
(b prototip memorijska-adresa = old-lst-address) tačno: {
	Izlaz piši: ['Object link re-attached.'], novi-red.
}.
Izlaz piši: b, novi-red.
