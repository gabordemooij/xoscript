Server init.

>> BP := Maria-DB novi domaćin: ['localhost'],
	korisnik: ['xo'],
	lozinka: ['pass123'],
	naziv-baze: ['xobase'],
	poveži-se.

{
	BP upit:
	['DROP TABLE movies'],
	izvrši.
} uhvati: { Ništa. }, pokreni.

BP upit:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
izvrši.

BP upit: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parametri: ( Lista novi ; ['Noć vještica'] ),
izvrši.

BP upit: ['SELECT * FROM movies'],
dohvati: { :film
	Izlaz piši: film title, novi-red.
}.

