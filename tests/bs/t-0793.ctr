Server init.

>> DB := Maria-DB novi domaćin: ['localhost'],
	korisnik: ['xo'],
	lozinka: ['pass123'],
	naziv-baze: ['xobase'],
	poveži-se.

{
	DB upit:
	['DROP TABLE movies'],
	izvrši.
} uhvati: { Ništa. }, pokreni.

DB upit:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
izvrši.

DB upit: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parametri: ( Lista novi ; ['Halloween'] ),
izvrši.

DB upit: ['SELECT * FROM movies'],
dohvati: { :movie
	Izlaz piši: movie title, novi-red.
}.

