# catch-all test (practical)
>> HTML := Tekst novi.
HTML na: ['encode:'] uradi: { :tekst
	sebe dodaj-na-kraj: (tekst
	zamijeni: ['&'] sa: ['&amp;'], 
	zamijeni: ['<'] sa: ['&lt;'],
	zamijeni: ['>'] sa: ['&gt;'],
	zamijeni: ['"'] sa: ['&quot;']).
}.
>> blog := HTML novi.
blog dodaj-na-kraj: ['<h1>'],
     encode: ['Koffie & Thee'],
     dodaj-na-kraj: ['</h1>'].
Izlaz piši: blog, novi-red.


>> Roman := Broj novi.
Roman na: ['stringy'] uradi: {
	>> a := [''].
	{ a dodaj-na-kraj: ['I']. } × sebe. <- a.
}.

>> x := Roman novi.
x saberi: 3.
Izlaz piši: x stringy, novi-red.

>> Quantum := Logički novi.
Quantum na: ['true?'] uradi: { <- ['maybe True']. }.
Izlaz piši: (Quantum novi true?), novi-red.

>> Nihil := Ništa novi.
Nihil na: ['tekst'] uradi: { <- ['Nihil']. }.
Izlaz piši: (Nihil novi), novi-red.
