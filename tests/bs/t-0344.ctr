# test hvatanja svih poruka (praktični)
>> HTML := Tekst novi.
HTML na: ['encode:'] uradi: { :ulazniTekst
	sebe dodaj-na-kraj: (ulazniTekst
	zamijeni: ['&'] sa: ['&amp;'], 
	zamijeni: ['<'] sa: ['&lt;'],
	zamijeni: ['>'] sa: ['&gt;'],
	zamijeni: ['"'] sa: ['&quot;']).
}.
>> blog := HTML novi.
blog dodaj-na-kraj: ['<h1>'],
     encode: ['Koffie & Thee'],
     dodaj-na-kraj: ['</h1>'].
Izlaz piši: blog, novi-red.


>> Rimski := Broj novi.
Rimski na: ['tekstualno'] uradi: {
	>> a := [''].
	{ a dodaj-na-kraj: ['I']. } × sebe. <- a.
}.

>> x := Rimski novi.
x saberi: 3.
Izlaz piši: x tekstualno, novi-red.

>> Kvant := Logički novi.
Kvant na: ['true?'] uradi: { <- ['možda Tačno']. }.
Izlaz piši: (Kvant novi true?), novi-red.

>> Nihil := Ništa novi.
Nihil na: ['tekst'] uradi: { <- ['Nihil']. }.
Izlaz piši: (Nihil novi), novi-red.
