>> napraviSabirač := { :x
	>> f := { :y <- (svoj x + y). } postavi: ['x'] vrijednost: x. <- f.
}.
>> preslikavač := { :polje :fn
	>> preslikavanje := { :i svoj q stavi: (svoj f primijeni: (svoj q ? i)) na: i. } 
	postavi: ['q'] vrijednost: polje,
	postavi: ['f'] vrijednost: fn.
	{ :i preslikavanje primijeni: i. } × (polje broj-elemenata).
}.

>> a := Lista ← 1; 2; 3.
preslikavač primijeni: a i: (napraviSabirač primijeni: 100).
Izlaz piši: (a pozicija: 0), novi-red.
Izlaz piši: (a ? 1), novi-red.
Izlaz piši: (a ? 2), novi-red.
