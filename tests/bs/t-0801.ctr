Server init.

>> db := Maria-DB novi domaćin: ['localhost'],
	korisnik: ['xo'],
	lozinka: ['pass123'],
	naziv-baze: ['xobase'],
	poveži-se.

>> del := db upit: ['DELETE FROM book WHERE id > 0'].
{  del izvrši. db potvrdi. } uhvati: { :e db poništi.  }, pokreni.

>> broj-elemenata := db upit: ['SELECT COUNT(*) AS num FROM book'].
broj-elemenata dohvati: { :row Izlaz piši: row num, novi-red. }.
