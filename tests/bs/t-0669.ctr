# Heširanje lozinki
Server init.

# Korisnik postavlja lozinku
>> lzn := ['pass123'].

# Sačuvajte je ovako
>> heš := Sef 
	heš-lozinke: lzn.

# Zatim se korisnik prijavljuje
# Pokušaj 1
>> a1 := ['abcd123'].
# Pokušaj 2
>> a2 := ['pass123'].

# Provjera
>> a := Sef 
	heš-lozinke: heš provjeri: a1.
	# neuspjeh 
>> b := Sef
	heš-lozinke: heš provjeri: a2.
	# ok!

Izlaz piši: a, novi-red.
Izlaz piši: b, novi-red.

