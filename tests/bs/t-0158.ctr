>> x := [' hallo '].

>> y := x velika-slova.
Izlaz piši: x, novi-red.
Izlaz piši: (x jednako: y), novi-red.

>> y := x mala-slova.
Izlaz piši: x, novi-red.
Izlaz piši: (x jednako: y), novi-red.

>> y := x skrati.
Izlaz piši: x, novi-red.
Izlaz piši: (x jednako: y), novi-red.

>> y := x pomak: 1.
Izlaz piši: x, novi-red.
Izlaz piši: (x jednako: y), novi-red.

>> y := x od: 1 dužina: 2.
Izlaz piši: x, novi-red.
Izlaz piši: (x jednako: y), novi-red.