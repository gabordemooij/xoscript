Server init.
>> fmt := Format novi: ['%#3x'].

>> blob := Blob novi: 4.
blob bytes: ( 
	Lista novi ; 0 ; 1 ; 2 ; 3
).

>> file := Datoteka novi: ['/tmp/blob'].
file blob: blob.
blob oslobodi.

>> čitaj := file blob.
čitaj 
od: 0 
dužina: 4, 
radi svaki: { :i :b 
	Izlaz
	piši: (fmt primijeni-cijeli: b),
	novi-red.
}.
čitaj oslobodi.
