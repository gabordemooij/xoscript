>> randomizer := { :a :b
	>> minimum := ( a < b ) ili: a ili: b.
	>> maksimum := ( a > b ) ili: a ili: b.
	>> x := Ništa.
	{
		x := Broj između: a i: b.
		((x < minimum) ili: (x > maksimum)) tačno: { 
			Izlaz piši: (['Invalid value!']).
			Program kraj.
		}.
	} 
	× 100. <- x.
}.
randomizer primijeni: 0 i: 0.
randomizer primijeni: 1 i: 0.
randomizer primijeni: 1 i: 1.
randomizer primijeni: 0 i: 1.
randomizer primijeni: -1 i: 0.
