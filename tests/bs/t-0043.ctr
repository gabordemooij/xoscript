>> ponavljač := Objekat novi.
ponavljač na: ['odgovori:'] uradi: { :šta
	Izlaz piši: šta + [' '].
}.
ponavljač na: ['odgovori:i:'] uradi: { :šta :say
	Izlaz piši: šta, piši: say + [' '].
}.
ponavljač na: ['odgovori:i:i:'] uradi: { :šta :say :više
	Izlaz piši: šta, piši: say, piši: više.
}.
ponavljač ponovi.
ponavljač everything: ['Ja kažem.'].
ponavljač and: ['I '] everything: ['radim.'].
