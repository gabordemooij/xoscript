>> repeater := Objekat novi.
repeater na: ['odgovori:'] uradi: { :what
	Izlaz piši: what + [' '].
}.
repeater na: ['odgovori:i:'] uradi: { :what :say
	Izlaz piši: what, piši: say + [' '].
}.
repeater na: ['odgovori:i:i:'] uradi: { :what :say :more
	Izlaz piši: what, piši: say, piši: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
