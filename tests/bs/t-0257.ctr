
>> Pozdravljač := Objekat novi.
Pozdravljač na: ['novi'] uradi: {
	svoj naziv := ['?'].
}.
Pozdravljač na: ['name:'] uradi: { :naziv
	svoj naziv := naziv.
}.
Pozdravljač na: ['pozdravi'] uradi: {
	Izlaz piši: (['hello[you]'] [you]: svoj naziv).
}.
>> prijatelj := Pozdravljač novi.
prijatelj name: ['1'].
prijatelj pozdravi.
