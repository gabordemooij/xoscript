
Server init.
>> rq := HTTP-Zahtjev novi.
Izlaz piši: ['HTTP-GET d[]=']  + ( rq get-lista: ['d[]'] ), novi-red. # GET
Izlaz piši: ['HTTP-GET f[]=']  + ( rq get-lista: ['f[]'] ), novi-red. # GET
Izlaz piši: ['HTTP-POST e[]='] + ( rq post-lista: ['e[]'] ), novi-red. # GET
Izlaz piši: ['HTTP-POST c=']   + ( rq post: ['c'] ), novi-red. # GET
Izlaz piši: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), novi-red. # GET
