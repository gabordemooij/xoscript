
Server init.
>> zh := HTTP-Zahtjev novi.
Izlaz piši: ['HTTP-GET d[]=']  + ( zh get-lista: ['d[]'] ), novi-red. # GET
Izlaz piši: ['HTTP-GET f[]=']  + ( zh get-lista: ['f[]'] ), novi-red. # GET
Izlaz piši: ['HTTP-POST e[]='] + ( zh post-lista: ['e[]'] ), novi-red. # GET
Izlaz piši: ['HTTP-POST c=']   + ( zh post: ['c'] ), novi-red. # GET
Izlaz piši: ['HTTP-POST xx=']  + ( zh post: ['xx'] ), novi-red. # GET
