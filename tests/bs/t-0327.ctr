

Lista na: ['fixture:'] uradi: { :f
	svoj fiksiraj := f.
}.

Lista na: ['broj-elemenata'] uradi: { <- svoj fiksiraj.
}.

Lista na: ['aantal'] uradi: { <- svoj fiksiraj.
}.


>> x := Ništa.
{

	x := ['hello'] 
	zamijeni:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] znak: 2)
			)
		)
	sa: (
		(['...hal'] + ['lo']) 
			velika-slova 
			lowecase 
			velika-slova 
			pomak: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Lista ← 0 ; 1 ; 4; 9 ; (Lista ← 0 ; 3; 1) ; 4
							) predzadnji
						) ? 1
					) + 
					((Lista ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					broj-elemenata
				)
			)
	).

} × 10.
Izlaz piši: x, novi-red.

