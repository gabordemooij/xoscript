( usedMemory1 = usedMemory2 i: usedMemory1 = usedMemory3, i: usedMemory2 = usedMemory3 ) tačno: {
	Izlaz piši: ['No memory leaks here'].
}, netačno: {
	Izlaz piši: ['Leaking memory...'].
}.
