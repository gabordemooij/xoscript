


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program upravljanje-memorijom: 0.
>> palette := Ništa.
>> colors := Ništa.

{
palette := Rječnik novi.
palette 
	stavi: ['#F00'] na: ['red'],
	stavi: ['#0F0'] na: ['green'],
	stavi: ['#00F'] na: ['blue'].
Izlaz piši: ['number of RGB codes in palette: '] + ( palette broj-elemenata ), novi-red.
Izlaz piši: ['RGB code of green is: '] + ( palette ? ['green'] ), novi-red.
colors := [''].
( palette svaki: { :naziv :kod
		colors := colors + ( naziv + [':'] + kod ).
} ).
Izlaz piši: ['All colors in palette: '] + colors, novi-red.
} pokreni.
Program počisti.
usedMemory1 := (Program memorija ? 0).

