Program upravljanje-memorijom: 0.
>> paleta := Ništa.
>> boje := Ništa.

{
paleta := Rječnik novi.
paleta 
	stavi: ['#F00'] na: ['red'],
	stavi: ['#0F0'] na: ['zelena'],
	stavi: ['#00F'] na: ['plava'].
Izlaz piši: ['broj RGB kodova u paleti: '] + ( paleta broj-elemenata ), novi-red.
Izlaz piši: ['RGB kod zelene je: '] + ( paleta ? ['zelena'] ), novi-red.
boje := [''].
( paleta svaki: { :naziv :kod
		boje := boje + ( naziv + [':'] + kod ).
} ).
Izlaz piši: ['Sve boje u paleti: '] + boje, novi-red.
} pokreni.
Program počisti.
korištenaMemorija1 := (Program memorija ? 0).

