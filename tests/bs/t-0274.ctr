

Lista na: ['column:'] uradi: { :kolona
	>> rezultat := Lista novi.
	sebe svaki: { :indeks :redak
		redak svaki: { :indeks :ćelija
			(indeks = kolona) tačno: { rezultat dodaj-na-kraj: ćelija. }.
		}.
	}. <- rezultat.
}.


>> a := Lista ←
	(Lista ← 1 ; 2 ; 3) ;
	(Lista ← 4 ; 5 ; 6) ;
	(Lista ← 7 ; 8 ; 9).

>> b := a column: 1.
Izlaz piši: b, novi-red.

b := a column: 20.
Izlaz piši: b, novi-red.

b := a column: -100.
Izlaz piši: b, novi-red.
