

Lista na: ['column:'] uradi: { :column
	>> result := Lista novi.
	sebe svaki: { :index :row
		row svaki: { :index :cell
			(index = column) tačno: { result dodaj-na-kraj: cell. }.
		}.
	}. <- result.
}.


>> a := Lista ←
	(Lista ← 1 ; 2 ; 3) ;
	(Lista ← 4 ; 5 ; 6) ;
	(Lista ← 7 ; 8 ; 9).

>> b := a column: 1.
Izlaz piši: b, novi-red.

b := a column: 20.
Izlaz piši: b, novi-red.

b := a column: -100.
Izlaz piši: b, novi-red.
