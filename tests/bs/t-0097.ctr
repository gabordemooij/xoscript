
Tekst na: ['html'] uradi: { <- (
		sebe
		zamijeni: ['&'] sa: ['&amp;'],
		zamijeni: ['<'] sa: ['&lt;'],
		zamijeni: ['>'] sa: ['&gt;'],
		zamijeni: ['"'] sa: ['&quot;']
	).
}.

>> HtmlBrush := Objekat novi.

HtmlBrush na: ['odgovori:'] uradi: { :tag
	Izlaz piši: (['<tag>↵'] tag: tag ).
}.

HtmlBrush na: ['odgovori:i:'] uradi: { :tag :content
	tag := ( tag od: 0 dužina: (tag dužina - 1) ).
	Izlaz piši: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush na: ['content:'] uradi: { :text
	Izlaz piši: text html, novi-red.
}.

HtmlBrush na: ['attr:value:'] uradi: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush novi.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
