
Tekst na: ['html'] uradi: { <- (
		sebe
		zamijeni: ['&'] sa: ['&amp;'],
		zamijeni: ['<'] sa: ['&lt;'],
		zamijeni: ['>'] sa: ['&gt;'],
		zamijeni: ['"'] sa: ['&quot;']
	).
}.

>> HtmlKist := Objekat novi.

HtmlKist na: ['odgovori:'] uradi: { :tag
	Izlaz piši: (['<tag>↵'] tag: tag ).
}.

HtmlKist na: ['odgovori:i:'] uradi: { :tag :content
	tag := ( tag od: 0 dužina: (tag dužina - 1) ).
	Izlaz piši: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlKist na: ['content:'] uradi: { :natpis
	Izlaz piši: natpis html, novi-red.
}.

HtmlKist na: ['atr:vrijednost:'] uradi: { :atr :value <- ['attr="value"'] attr: atr, value: value.
}.

>> h := HtmlKist novi.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h atr: ['class'] vrijednost: ['bold']),
		/span
	/body
/html.
		
