# test qualifiers

Program počisti.

>> Fruit := Objekat novi.
Fruit na: ['novi'] uradi: {
	>> f := sebe novi.
	f apples: 0. <- f.
}.
Fruit na: ['apples:'] uradi: { :a svoj apples := a. }.
Fruit na: ['apples'] uradi: { <- svoj apples. }.
Fruit na: ['+'] uradi: { :f
	>> n := Fruit novi.
	n apples: (f apples + svoj apples). <- n.
}.
Broj na: ['apples'] uradi: { <- ((Fruit novi) apples: sebe).
}.

Fruit na: ['tekst'] uradi: { <- svoj apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Izlaz piši: q, novi-red.




q := 3 apples + 4 apples.
Izlaz piši: q, novi-red.



q := 3 apples + 4 apples.
Izlaz piši: q, novi-red.


