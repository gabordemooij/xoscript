# test odrednica

Program počisti.

>> Voće := Objekat novi.
Voće na: ['novi'] uradi: {
	>> f := sebe novi.
	f apples: 0. <- f.
}.
Voće na: ['apples:'] uradi: { :a svoj jabuke := a. }.
Voće na: ['jabuke'] uradi: { <- svoj jabuke. }.
Voće na: ['+'] uradi: { :f
	>> n := Voće novi.
	n apples: (f jabuke + svoj jabuke). <- n.
}.
Broj na: ['jabuke'] uradi: { <- ((Voće novi) apples: sebe).
}.

Voće na: ['tekst'] uradi: { <- svoj jabuke + [' jabuka '].
}.

>> q := 3 jabuke + 4 jabuke.
Izlaz piši: q, novi-red.




q := 3 jabuke + 4 jabuke.
Izlaz piši: q, novi-red.



q := 3 jabuke + 4 jabuke.
