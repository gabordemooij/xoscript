
Lista na: ['zbir'] uradi: {
	>> ukupno := 0.
	sebe svaki: { :indeks :element
		ukupno saberi: element.
	}. <- ukupno.
}.

>> a := Lista ← 9 ; 8 ; 7.
Izlaz piši: (a zbir), novi-red. 
>> a := Lista ← 1 ; 9.
Izlaz piši: (a zbir), novi-red. 
>> a := Lista ← ['o'] ; 2.
Izlaz piši: (a zbir), novi-red. 
Izlaz piši: (Lista novi zbir), novi-red. 
