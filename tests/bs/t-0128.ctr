
Lista na: ['sum'] uradi: {
	>> total := 0.
	sebe svaki: { :index :element
		total saberi: element.
	}. <- total.
}.

>> a := Lista ← 9 ; 8 ; 7.
Izlaz piši: (a sum), novi-red. 
>> a := Lista ← 1 ; 9.
Izlaz piši: (a sum), novi-red. 
>> a := Lista ← ['o'] ; 2.
Izlaz piši: (a sum), novi-red. 
Izlaz piši: (Lista novi sum), novi-red. 
