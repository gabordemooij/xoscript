Logički na: ['xor:'] uradi: { :a :b <- ((a i: b ne) ili: (a ne i: b)).
}.

>> o := Objekat novi.
o na: ['hello'] uradi: { ['Prazno']. }.
{ o na: 2 uradi: 3.} uhvati: { :e Izlaz piši: e, novi-red. }, pokreni.
{ o na: ['test'] uradi: 3.} uhvati: { :e Izlaz piši: e, novi-red. }, pokreni.
{ o na: ['hello'] uradi: { ['Prazno']. }.} uhvati: { :e Izlaz piši: e, novi-red. }, pokreni. 
{ >> z := 4 ÷ 0. } uhvati: { :e Izlaz piši: e, novi-red. }, pokreni. 
{ (Tačno i: Ništa) tačno: { Izlaz piši: ['X'].}. } uhvati: { :e Izlaz piši: e, novi-red. }, pokreni. 
{ ([''] xor: 0) tačno: { Izlaz piši: ['X'].}. } uhvati: { :e Izlaz piši: e, novi-red. }, pokreni. 
{ (1 < ['2']) tačno: { Izlaz piši: ['OK']. }. } uhvati: { :e Izlaz piši: e, novi-red. }, pokreni. 
{ (1 < ['2.0']) tačno: { Izlaz piši: ['OK']. }. } uhvati: { :e Izlaz piši: e, novi-red. }, pokreni. 
{ (1 < ['x2.0']) tačno: { Izlaz piši: ['NE!']. }. } uhvati: { :e Izlaz piši: e, novi-red. }, pokreni. 
{ Izlaz piši: (['dobro OK onda'] od: ['6'] dužina: ['2']). } pokreni. 
