Izlaz piši: ['1,2,3,4,5,6,7,8,9,A,'], novi-red.
>> Opseg := Objekat novi.
Opseg na: ['initialize:'] uradi: { :x svoj svojstvo := x. }.
Opseg na: ['ovjeri'] uradi: { Izlaz piši: [',']. }.
Opseg na: ['test'] uradi: {
	Izlaz piši: svoj svojstvo.
	sebe ovjeri.
	( 1 = 1 ) tačno: { Izlaz piši: svoj svojstvo. sebe ovjeri. }.
	( 1 = 0 ) netačno: { Izlaz piši: svoj svojstvo. sebe ovjeri. }.
	>> y := 2. { Izlaz piši: svoj svojstvo. sebe ovjeri. } dok: { y oduzmi: 1. <- (y > 0). }.
	{ Izlaz piši: svoj svojstvo. sebe ovjeri. } × 1.
	(Lista ← 1) svaki: {  Izlaz piši: svoj svojstvo. sebe ovjeri. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo implementirati vlastito sortiranje, ovaj test pada jer se broj iteracija razlikuje po platformi
	(Rječnik novi one: ['item']) svaki: { Izlaz piši: svoj svojstvo. sebe ovjeri. }.
	{ 1 ÷ 0. } uhvati: { Izlaz piši: svoj svojstvo. sebe ovjeri. }, pokreni.
	Izlaz novi-red.
}.
>> opseg1 := Opseg novi.
opseg1 initialize: ['X'].
opseg1 test.
>> fja := { 
	svoj svojstvo := ['Y'].
	Izlaz piši: svoj svojstvo.
	sebe ovjeri.
	( 1 = 1 ) tačno: { Izlaz piši: svoj svojstvo. sebe ovjeri. }.
	( 1 = 0 ) netačno: { Izlaz piši: svoj svojstvo. sebe ovjeri. }.
	>> y := 2. { Izlaz piši: svoj svojstvo. sebe ovjeri. } dok: { y oduzmi: 1. <- (y > 0). }.
	{ Izlaz piši: svoj svojstvo. sebe ovjeri. } × 1.
	(Lista ← 1) svaki: {  Izlaz piši: svoj svojstvo. sebe ovjeri. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Rječnik novi one: ['item']) svaki: { Izlaz piši: svoj svojstvo. sebe ovjeri. }.
	{ 1 ÷ 0. } uhvati: { Izlaz piši: svoj svojstvo. sebe ovjeri. }, pokreni.
	Izlaz novi-red.
}.
fja na: ['ovjeri'] uradi: { Izlaz piši: [',']. }.
fja primijeni: 1 i: 2.
