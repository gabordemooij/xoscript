['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Izlaz piši: (x + y), novi-red.

>> x := 10040.07.
>> y := 10305.60.

Izlaz piši: (x + y), novi-red.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Izlaz piši: (x + y + z), novi-red.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Izlaz piši: (x + y + z), novi-red.

>> q := 0.1.2.

Izlaz piši: (q), novi-red.

>> q := 012.

Izlaz piši: (q), novi-red.
