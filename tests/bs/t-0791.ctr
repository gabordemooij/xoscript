Server init.

>> BP := Maria-DB novi domaćin: ['localhost'],
	korisnik: ['xo'],
	lozinka: ['pass123'],
	naziv-baze: ['xobase'],
	poveži-se.
	
>> SQL := ['SELECT "hello" AS "world" '].

# ručno kreiranje upita
>> parametri-pretrage := Maria-Upit novi: SQL.

# postavljanje baze podataka
parametri-pretrage baza-podataka: BP.

parametri-pretrage dohvati: { :redak
	Izlaz piši: redak world, novi-red.
}.
