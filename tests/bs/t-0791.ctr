Server init.

>> DB := Maria-DB novi domaćin: ['localhost'],
	korisnik: ['xo'],
	lozinka: ['pass123'],
	naziv-baze: ['xobase'],
	poveži-se.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> parametri-pretrage := Maria-Upit novi: SQL.

# set database
parametri-pretrage baza-podataka: DB.

parametri-pretrage dohvati: { :row
	Izlaz piši: row world, novi-red.
}.
