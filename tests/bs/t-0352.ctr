Broj na: ['rimski'] uradi: {
	>> broj := sebe kopiraj.
	>> rimski := [''].
	{
		{
			(broj ≥ 1000) tačno: {
				rimski dodaj-na-kraj: ['Ⅿ'].
				broj oduzmi: 1000.
			}, prekini.
		
			(broj ≥ 500) tačno: {
				rimski dodaj-na-kraj: ['Ⅾ'].
				broj oduzmi: 500.
			}, prekini.
		
			(broj ≥ 100) tačno: {
				rimski dodaj-na-kraj: ['Ⅽ'].
				broj oduzmi: 100.
			}, prekini.
		
			(broj ≥ 50) tačno: {
				rimski dodaj-na-kraj: ['Ⅼ'].
				broj oduzmi: 50.
			}, prekini.
		
			(broj ≥ 50) tačno: {
				rimski dodaj-na-kraj: ['Ⅼ'].
				broj oduzmi: 50.
			}, prekini.
		
			(broj ≥ 10) tačno: {
				rimski dodaj-na-kraj: ['Ⅹ'].
				broj oduzmi: 10.
			}, prekini.
			
			(broj ≥ 9) tačno: {
				rimski dodaj-na-kraj: ['Ⅸ'].
				broj oduzmi: 9.
			}, prekini.
			
			(broj ≥ 5) tačno: {
				rimski dodaj-na-kraj: ['Ⅴ'].
				broj oduzmi: 5.
			}, prekini.
			
			(broj ≥ 4) tačno: {
				rimski dodaj-na-kraj: ['Ⅳ'].
				broj oduzmi: 4.
			}, prekini.
			
			(broj ≥ 1) tačno: {
				rimski dodaj-na-kraj: ['Ⅰ'].
				broj oduzmi: 1.
			}, prekini.
		} postupak.
	} dok: { <- broj > 0. }. <- rimski.
}.

Izlaz piši: 1 rimski, novi-red.
Izlaz piši: 2 rimski, novi-red.
Izlaz piši: 4 rimski, novi-red.
Izlaz piši: 8 rimski, novi-red.
Izlaz piši: 16 rimski, novi-red.
Izlaz piši: 32 rimski, novi-red.
Izlaz piši: 64 rimski, novi-red.
Izlaz piši: 128 rimski, novi-red.
Izlaz piši: 256 rimski, novi-red.
Izlaz piši: 1024 rimski, novi-red.
