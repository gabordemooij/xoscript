# test pretvaranja tipova / konverzija / povezivanja
Program upravljanje-memorijom: 4.
Server init.

>> brojač := 0.
>> bp := Maria-DB novi domaćin: ['localhost'],
	korisnik: ['xo'], lozinka: ['pass123'], naziv-baze: ['xobase'], poveži-se.

>> DvocifreniFormat := Format novi: ['%02d'].

# Datum i vrijeme
{
	>> godina     := Broj između: 1995 i: 2050, tekst.
	>> mjesec    := DvocifreniFormat primijeni-cijeli: (Broj između: 1 i: 12), tekst.
	>> dan      := DvocifreniFormat primijeni-cijeli: (Broj između: 1 i: 28), tekst.
	>> sat     := DvocifreniFormat primijeni-cijeli: (Broj između: 1 i: 23), tekst.
	>> minuta   := DvocifreniFormat primijeni-cijeli: (Broj između: 1 i: 59), tekst.
	>> sekunda   := DvocifreniFormat primijeni-cijeli: (Broj između: 1 i: 59), tekst.
	>> datumvrijeme := ['YYYY-MM-DD HH:II:SS'].	
	datumvrijeme
		YYYY: godina,
		MM: mjesec,
		DD: dan,
		HH: sat,
		II: minuta,
		SS: sekunda.
	>> parametri-pretrage :=
	bp upit: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: datumvrijeme),
	dohvati: { :redak
		(redak mydatetime = datumvrijeme) netačno: {
			ovaj-zadatak greška: (
				['Očekivano: <expected>, a dobijeno: <observation>']
				<expected>: datumvrijeme,
				<observation>: redak mydatetime
			).
		}.
	
	}.
	brojač saberi: 1.
} * 100.

# Datum
{
	>> godina     := Broj između: 1995 i: 2050, tekst.
	>> mjesec    := DvocifreniFormat primijeni-cijeli: (Broj između: 1 i: 12), tekst.
	>> dan      := DvocifreniFormat primijeni-cijeli: (Broj između: 1 i: 28), tekst.
	>> datum     := ['YYYY-MM-DD'].
	datum
		YYYY: godina,
		MM: mjesec,
		DD: dan.
	>> parametri-pretrage :=
	bp upit: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: datum),
	dohvati: { :redak
		(redak mydate = datum) netačno: {
			ovaj-zadatak greška: (
				['Očekivano: <expected>, a dobijeno: <observation>']
				<expected>: datum,
				<observation>: redak mydate
			).
		}.
	}.
	brojač saberi: 1.
} * 100.


# Vrijeme
{
	>> sat     := DvocifreniFormat primijeni-cijeli: (Broj između: 1 i: 23), tekst.
	>> minuta   := DvocifreniFormat primijeni-cijeli: (Broj između: 1 i: 59), tekst.
	>> sekunda   := DvocifreniFormat primijeni-cijeli: (Broj između: 1 i: 59), tekst.
	>> vrijeme := ['HH:II:SS'].
	vrijeme
		HH: sat,
		II: minuta,
		SS: sekunda.
	>> parametri-pretrage :=
	bp upit: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: vrijeme),
	dohvati: { :redak
		(redak mytime = vrijeme) netačno: {
			ovaj-zadatak greška: (
				['Očekivano: <expected>, a dobijeno: <observation>']
				<expected>: datumvrijeme,
				<observation>: redak mytime
			).
		}.
	}.
	brojač saberi: 1.
} * 100.


# Tekstovi (varchar/text)
>> str1 := Lista novi popuni: 100000 sa: ['x'], spoji: [''].
{
	>> str2 := Sef token: 40.
	>> parametri-pretrage :=
	bp upit: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	dohvati: { :redak
		(redak str1 = str1 i: redak str2 = str2) netačno: {
			ovaj-zadatak greška: (
				['Očekivano: <expected>, a dobijeno: <observation>']
				<expected>: datumvrijeme,
				<observation>: redak mytime
			).
		}.
	}.
	brojač saberi: 1.
} * 100.


# Brojevi
{
	>> n1  := Broj između: 1 i: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 iz-teksta: ['9223372036854775807'] ) -
		( Int64 iz-teksta: ['99999'] ) +
		( Int64 iz-teksta: n1 tekst )
	).
	>> parametri-pretrage :=
	bp upit: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	dohvati: { :redak
		(redak n1 = n1) netačno: {
			ovaj-zadatak greška: (
				['Očekivano: <expected>, a dobijeno: <observation>']
				<expected>: n1,
				<observation>: redak n1
			).
		}.
		(redak n2 = n2) netačno: {
			ovaj-zadatak greška: (
				['Očekivano: <expected>, a dobijeno: <observation>']
				<expected>: n1,
				<observation>: redak n2
			).
		}.
		(redak n3 = n2 zaokruži) netačno: {
			ovaj-zadatak greška: (
				['Očekivano: <expected>, a dobijeno: <observation>']
				<expected>: n1,
				<observation>: redak n3
			).
		}.
		(redak big = big) netačno: {
			ovaj-zadatak greška: (
				['Očekivano: <expected>, a dobijeno: <observation>']
				<expected>: big,
				<observation>: redak big
			).
		}.
		
	}.
	brojač saberi: 1.
} * 100.


Izlaz piši: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: brojač
), novi-red.