Izlaz piši: ['Test object'], novi-red.
>> a := Objekat novi. 

a na: ['item:'] uradi: { :binhelper
	svoj binhelper := binhelper. 
}.

a na: ['item'] uradi: { <- svoj binhelper.
}.

a item: Bin novi.

>> old-binhelper-address := a item prototip memorijska-adresa.
a save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== RELOADING SNAP:'], novi-red.

>> b := Objekat load-from: ['/tmp/a.bin'].

(b item prototip memorijska-adresa = old-binhelper-address) tačno: {
	Izlaz piši: ['Object link re-attached.'], novi-red.
}.


