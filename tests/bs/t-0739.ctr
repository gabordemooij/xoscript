Izlaz piši: ['Testni objekat'], novi-red.
>> a := Objekat novi. 

a na: ['item:'] uradi: { :binpomoćnik
	svoj binpomoćnik := binpomoćnik. 
}.

a na: ['stavka'] uradi: {
	<- svoj binpomoćnik.
}.

a item: Bin novi.

>> stara-adresa-binpomoćnika := a stavka prototip memorijska-adresa.
a save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== PONOVNO UČITAVANJE SNIMKA:'], novi-red.

>> b := Objekat load-from: ['/tmp/a.bin'].

(b stavka prototip memorijska-adresa = stara-adresa-binpomoćnika) tačno: {
	Izlaz piši: ['Veza objekta ponovo povezana.'], novi-red.
}.


