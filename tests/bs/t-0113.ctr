Izlaz piši: ['Continue for-loop, No - before 6 and up.'], novi-red.
{ :i
	Izlaz piši: (i + 1), novi-red.
	((i + 1) > 4) nastavi.
	Izlaz piši: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Izlaz novi-red.
Izlaz piši: ['Continue while-true, No --> before 5 and up.'], novi-red.
{
	Izlaz piši: ['iteration #'] + x, novi-red.
	x saberi: 1.
	((x < 5) ne) nastavi.
	Izlaz piši: ['-->'].
} dok: xIsLessThan10.
Izlaz novi-red.
Izlaz piši: ['Continue while-false, No - before 3 only.'], novi-red.
{
	Izlaz piši: ['iteration #'] + x, novi-red.
	x oduzmi: 1.
	(x = 3) nastavi.
	Izlaz piši: ['-'].
} dok: { <- ( x > 0). }.

Izlaz novi-red.
Izlaz piši: ['Continue times-loop, No ||| before 3.'], novi-red.
{ :i
	Izlaz piši: ['iteration #'] + i, novi-red.
	(i = 2) nastavi.
	Izlaz piši: ['|||'].
} × 5.

Izlaz novi-red.

{ Tačno nastavi. Izlaz piši: ['dont write this!'], novi-red. } pokreni.

{ Tačno nastavi. Izlaz piši: ['dont write this!'], novi-red. } uhvati: { Izlaz piši: ['Dont catch this!']. }, pokreni.

Izlaz piši: ['Test Array each-loop: 0, ... ,2'], novi-red.
(Lista ← 1 ; 2 ; 3) preslikaj: { :i
	(i = 1) nastavi.
	Izlaz piši: ['iteration #'] + (i - 0), novi-red.
}.

Izlaz piši: ['Test Map each-loop: c only'], novi-red.
>> m := Rječnik novi.
m stavi: ['first'] na: ['a'], stavi: ['second'] na: ['b'], stavi: ['third'] na: ['c'].
m svaki: { :k :v
	(k ≠ ['c']) nastavi.
	Izlaz piši: ['iteration'] + k + v, novi-red.
}.

