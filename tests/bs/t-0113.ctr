Izlaz piši: ['Nastavi for-petlju, Ne - prije 6 i više.'], novi-red.
{ :i
	Izlaz piši: (i + 1), novi-red.
	((i + 1) > 4) nastavi.
	Izlaz piši: ['-'].
} × 10.

>> x := 0.
>> xJeManjiOd10 := { <- ( x < 10 ). }.
Izlaz novi-red.
Izlaz piši: ['Nastavi while-true, Ne --> prije 5 i više.'], novi-red.
{
	Izlaz piši: ['iteration #'] + x, novi-red.
	x saberi: 1.
	((x < 5) ne) nastavi.
	Izlaz piši: ['-->'].
} dok: xJeManjiOd10.
Izlaz novi-red.
Izlaz piši: ['Nastavi while-false, Ne - samo prije 3.'], novi-red.
{
	Izlaz piši: ['iteration #'] + x, novi-red.
	x oduzmi: 1.
	(x = 3) nastavi.
	Izlaz piši: ['-'].
} dok: { <- ( x > 0). }.

Izlaz novi-red.
Izlaz piši: ['Nastavi times-petlju, Ne ||| prije 3.'], novi-red.
{ :i
	Izlaz piši: ['iteration #'] + i, novi-red.
	(i = 2) nastavi.
	Izlaz piši: ['|||'].
} × 5.

Izlaz novi-red.

{ Tačno nastavi. Izlaz piši: ['ne piši ovo!'], novi-red. } pokreni.

{ Tačno nastavi. Izlaz piši: ['ne piši ovo!'], novi-red. } uhvati: { Izlaz piši: ['Ne hvataj ovo!']. }, pokreni.

Izlaz piši: ['Test each-petlje niza: 0, ... ,2'], novi-red.
(Lista ← 1 ; 2 ; 3) preslikaj: { :i
	(i = 1) nastavi.
	Izlaz piši: ['iteration #'] + (i - 0), novi-red.
}.

Izlaz piši: ['Test each-petlje mape: samo c'], novi-red.
>> m := Rječnik novi.
m stavi: ['first'] na: ['a'], stavi: ['second'] na: ['b'], stavi: ['treći'] na: ['c'].
m svaki: { :k :v
	(k ≠ ['c']) nastavi.
	Izlaz piši: ['iteration'] + k + v, novi-red.
}.

