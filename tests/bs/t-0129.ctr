
Lista na: ['product'] uradi: {
	>> total := 1.
	sebe svaki: { :index :element
		total pomnoži-sa: element.
	}. <- total.
}.

>> a := Lista ← 1 ; 2 ; 3.
Izlaz piši: a product, novi-red.
Izlaz piši: (Lista ← 2 ; 4 ; 8) product, novi-red. 
Izlaz piši: (Lista ← -2 ; 10) product, novi-red. 
Izlaz piši: (Lista ← 0.5 ; -2) product, novi-red. 
