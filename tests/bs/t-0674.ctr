# uspješan tok
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> putanja := ['/tmp/dat.csv'].
>> csv := Datoteka novi: putanja.
csv piši: s.

# prihvata CRLF LF CR, različite dužine redova
csv razdjelnik: [';'] navodnik: ['"'] redovi: { :line
	Program počisti.
	Izlaz piši: line, novi-red.
	Program počisti.
}.

# nejednaki redovi
s dodaj-na-kraj: ['\njustone'].
csv piši: s.
{
	csv razdjelnik: [';'] navodnik: ['"'] redovi: { :line
		Izlaz piši: line, novi-red.
	}.
} uhvati: { :e 
	Izlaz piši: e, novi-red.
}, pokreni.

# neispravan format
s := ['"he"llo";world'].
csv piši: s.
{
	csv razdjelnik: [';'] navodnik: ['"'] redovi: { :line
		Izlaz piši: line, novi-red.
	}.
} uhvati: { :e 
	Izlaz piši: e, novi-red.
}, pokreni.
