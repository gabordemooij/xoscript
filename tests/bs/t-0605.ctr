>> faktura := Objekat novi.
faktura na: ['pokreni'] uradi: {
        svoj broj := 0.
}.

faktura na: ['broj'] uradi: {
        svoj broj saberi: 1.
        <- svoj broj kopiraj.
}.

>> godišnja-faktura := faktura novi.
godišnja-faktura na: ['start:'] uradi: { :godina
	svoj broj := godina.
}.

godišnja-faktura start: 202000.
Izlaz piši: godišnja-faktura broj, novi-red.
Izlaz piši: godišnja-faktura broj, novi-red.
