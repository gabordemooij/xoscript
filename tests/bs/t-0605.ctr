>> invoice := Objekat novi.
invoice na: ['pokreni'] uradi: {
        svoj broj := 0.
}.

invoice na: ['broj'] uradi: {
        svoj broj saberi: 1. <- svoj broj kopiraj.
}.

>> year-invoice := invoice novi.
year-invoice na: ['start:'] uradi: { :godina
	svoj broj := godina.
}.

year-invoice start: 202000.
Izlaz piši: year-invoice broj, novi-red.
Izlaz piši: year-invoice broj, novi-red.
