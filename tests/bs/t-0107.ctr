
Izlaz piši: ['Prekid for-petlje, 0-4.'], novi-red.
{ :i
	Izlaz piši: ['iteration #'] + i, novi-red.
	(i = 4) prekini.
} × 10.

>> x := 0.
>> xJeManjiOd10 := { <- ( x < 10 ). }.

Izlaz piši: ['Prekid while-true petlje, 0-4.'], novi-red.
{
	Izlaz piši: ['iteration #'] + x, novi-red.
	x saberi: 1.
	((x < 5) ne) prekini.
} dok: xJeManjiOd10.

Izlaz piši: ['Prekid while-false petlje, 5,4.'], novi-red.
{
	Izlaz piši: ['iteration #'] + x, novi-red.
	x oduzmi: 1.
	(x = 3) prekini.
} dok: { <- (x > 0). }.

Izlaz piši: ['Prekid times petlje, 1-4.'], novi-red.
{ :i
	Izlaz piši: ['iteration #'] + i, novi-red.
	(i = 4) prekini.
} × 5.

Izlaz piši: ['Prekid bloka, ne ispisuj red.'], novi-red.
{ Tačno prekini. Izlaz piši: ['ne piši ovo!'], novi-red. } pokreni.

Izlaz piši: ['Prekid bloka, ne pokreći hvatanje...'], novi-red.
{ Tačno prekini. Izlaz piši: ['ne piši ovo!'], novi-red. } uhvati: { Izlaz piši: ['Ne hvataj ovo!']. }, pokreni.

Izlaz piši: ['Test each-petlje niza: 0,1'], novi-red.
(Lista ← 1 ; 2 ; 3) preslikaj: { :i
	Izlaz piši: ['iteration #'] + i, novi-red.
	(i = 1) prekini.
}.

Izlaz piši: ['Test each-petlje mape: samo c'], novi-red.
>> m := Rječnik novi.
m stavi: ['first'] na: ['a'], stavi: ['second'] na: ['b'], stavi: ['treći'] na: ['c'].
m svaki: { :k :v
	Izlaz piši: ['iteration'] + v + k, novi-red.
	Tačno prekini.
}.

