# format mora odgovarati tipu vrijednosti, tip može doći od klijenta
>> pokušaj := { :oblik :value
	{ Izlaz piši: ( (Format novi: oblik) primijeni: value ), novi-red. } uhvati: { :e Izlaz piši: e, novi-red. }, pokreni.
}.
>> probaj-cijeli := { :oblik :value
	{ Izlaz piši: ( (Format novi: oblik) primijeni-cijeli: value ), novi-red. } uhvati: { :e Izlaz piši: e, novi-red. }, pokreni.
}.

# odgovara
pokušaj primijeni: ['|%s|'] i: ['text'].
pokušaj primijeni: ['%06.2f'] i: 5.5.
pokušaj primijeni: ['100%% %s'] i: ['naravno'].
probaj-cijeli primijeni: ['%03d'] i: 7.
probaj-cijeli primijeni: ['%x'] i: 255.
pokušaj primijeni: ['%d'] i: (Int64 novi iz-teksta: ['12']).
pokušaj primijeni: ['%lld'] i: (Int64 novi iz-teksta: ['12']).
pokušaj primijeni: ['%.1lf'] i: 5.5.
probaj-cijeli primijeni: ['%hd'] i: 7.

# ne odgovara
pokušaj primijeni: ['%s'] i: 12345.
pokušaj primijeni: ['%d'] i: 12345.
pokušaj primijeni: ['%f'] i: ['text'].
probaj-cijeli primijeni: ['%d'] i: ['text'].
probaj-cijeli primijeni: ['%s'] i: 5.
pokušaj primijeni: ['%s %s'] i: ['text'].
pokušaj primijeni: ['%n'] i: ['text'].
pokušaj primijeni: ['%*s'] i: ['text'].
pokušaj primijeni: ['%'] i: ['text'].

# modifikator dužine ne odgovara
pokušaj primijeni: ['%ls'] i: ['text'].
pokušaj primijeni: ['%Lf'] i: 5.5.
probaj-cijeli primijeni: ['%ld'] i: 7.
probaj-cijeli primijeni: ['%lld'] i: 7.
pokušaj primijeni: ['%Ld'] i: (Int64 novi iz-teksta: ['12']).

# širina koja ne odgovara printf-u mora dati grešku, ne pad
pokušaj primijeni: ['%99999999999s'] i: ['text'].
