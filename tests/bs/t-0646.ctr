Server init.
Izlaz piši: ['Database datetime test'], novi-red.

>> db := Maria-DB novi domaćin: ['localhost'],
	korisnik: ['xo'], 
	lozinka: ['pass123'],
	naziv-baze: ['xobase'],
	poveži-se.

>> parametri-pretrage :=
db upit: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
dohvati: { :row
	Izlaz piši: row datetimetest, novi-red.
}.
