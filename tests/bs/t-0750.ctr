Izlaz piši: ['Test object'], novi-red.
>> a := Objekat novi. 

a na: ['item:'] uradi: { :nil
	svoj nil := nil. 
}.

a na: ['item'] uradi: { <- svoj nil.
}.

a item: Ništa.

Izlaz piši: a item, novi-red.

>> old-nil-address := a item prototip memorijska-adresa.
a save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== RELOADING SNAP:'], novi-red.

>> b := Objekat load-from: ['/tmp/a.bin'].

(b item prototip memorijska-adresa = old-nil-address) tačno: {
	Izlaz piši: ['Object link re-attached.'], novi-red.
}.

Izlaz piši: b item, novi-red.
