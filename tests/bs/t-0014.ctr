>> Pozdravljač := Objekat novi.
Pozdravljač na: ['napravi'] uradi: {
	>> pz := Objekat novi.
	pz na: ['setName:'] uradi: { :nekoIme
		svoj naziv := nekoIme.
	}.
	pz na: ['pozdravi'] uradi: {
		Izlaz piši: svoj naziv.
	}. <- pz.
}.
>> a := Pozdravljač napravi.
>> b := Pozdravljač napravi.
a setName: ['JEDAN'].
b setName: ['DVA'].
a pozdravi.
b pozdravi.
>> c := a novi.
c setName: ['TRI'].
c pozdravi.
>> d := a novi.
d setName: ['ČETIRI'].
d pozdravi.
c pozdravi.
