# test parsiranja URL-a

Server init.
>> url := URL iz: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Izlaz piši: ['scheme = '] + url shema, novi-red.
Izlaz piši: ['host = '] + url domaćin, novi-red.
Izlaz piši: ['port = '] + url port, novi-red.
Izlaz piši: ['path = '] + url putanja, novi-red.
Izlaz piši: ['query = '] + url parametri-pretrage, novi-red.
Izlaz piši: ['fragment = '] + url fragment, novi-red.
