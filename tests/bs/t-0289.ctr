#Linux
>> OS := Program sistem: (Naredba uname -s), skrati.

>> Slurp := Objekat novi.
Slurp na: ['novi'] uradi: {
	svoj str := [''].
}.
Slurp na: ['odgovori:'] uradi: { :blah
		(svoj str ≠ ['']) tačno: {
			svoj str dodaj-na-kraj: [' '].
		}.
		svoj str dodaj-na-kraj: blah.
}.
Slurp na: ['odgovori:i:'] uradi: { :blah :blahah
		(svoj str ≠ ['']) tačno: {
			svoj str dodaj-na-kraj: [' '].
		}.
		(blah dužina > 1) tačno: {
			svoj str dodaj-na-kraj: (blah od: 0 dužina: (blah dužina - 1)).
		}, inače: {
			svoj str dodaj-na-kraj: blah.
		}.
		svoj str dodaj-na-kraj: [' '].
		svoj str dodaj-na-kraj: blahah.
}.
Slurp na: ['obtain'] uradi: {
	>> buffer := svoj str.
	svoj str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text dodaj-na-kraj: ['hello'].
} × 1000.


Izlaz piši: (
	Program sistem: (
		Slurp novi
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

