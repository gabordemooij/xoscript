Server init.
Izlaz piši: ['Database date test'], novi-red.

>> db := Maria-DB novi domaćin: ['localhost'],
	korisnik: ['xo'], 
	lozinka: ['pass123'],
	naziv-baze: ['xobase'],
	poveži-se.

>> parametri-pretrage :=
db upit: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
dohvati: { :row
	Izlaz piši: row datetest, novi-red.
}.
