# compliance test

# use international numbers

Izlaz piši: ['1000 -> '].
Izlaz piši: 1000, novi-red. #1000

Izlaz piši: ['1.5 -> '].
Izlaz piši: 1.5, novi-red.  #1.5

Izlaz piši: ['1001.5 -> '].
Izlaz piši: 1.5 + 1000, novi-red. #1001.5

# use 0-indexed arrays
>> x := Lista novi ; 1 ; 2 ; 3.
>> y := Lista novi ; ['a'] ; ['b'] ; ['c'].

Izlaz piši: ['1 -> '].
Izlaz piši: x ? 0, novi-red. #1

Izlaz piši: ['1 -> '].
Izlaz piši: (x na: 0), novi-red. #1

Izlaz piši: ['1 -> '].
Izlaz piši: x prvi, novi-red. #1

Izlaz piši: ['3 -> '].
Izlaz piši: x zadnji, novi-red. #3

Izlaz piši: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Izlaz piši: (x prema: y), novi-red.

Izlaz piši: ['1 -> '].
Izlaz piši: (x od: 0 dužina: 1) prvi, novi-red. #1

Izlaz piši: ['0 -> '].
Izlaz piši: (x pronađi: 1), novi-red. #0

x stavi: 9 na: 0.

Izlaz piši: ['9 -> '].
Izlaz piši: (x na: 0), novi-red. #9

x dodaj-na-početak: 8.
Izlaz piši: ['8 -> '].
Izlaz piši: (x na: 0), novi-red. #9


x dodaj-na-kraj: 10.
Izlaz piši: ['10 -> '].
Izlaz piši: (x na: 4), novi-red. #10








