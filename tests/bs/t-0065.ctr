Broj na: ['factorial'] uradi: {
	>> total := 1.
	{ :index total pomnoži-sa: (sebe - (index)). } × sebe. <- total.
}.
>> Printer := Objekat novi.
Printer na: ['print:and:'] uradi: { :x :y
	Izlaz piši: ['a='] + x + [', b='] + y, novi-red.
}.
>> a := 4.5. >> b := a zaokruži-dolje.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a zaokruži-gore.
Printer print: a and: b.
a := 4.5. b := a zaokruži-dolje.
Printer print: a and: b.
a := 4.5. b := a zaokruži.
Printer print: a and: b.
a := 4.2. b := a zaokruži.
Printer print: a and: b.

Izlaz piši: (9 modulo: 5), novi-red.
Izlaz piši: -666 apsolutna-vrijednost, novi-red.
Izlaz piši: 49 kvadratni-korijen, novi-red.
Izlaz piši: (2 stepen: 3), novi-red.
>> l := (Lista ← 9 ; 6).
Izlaz piši: l minimum.

