Broj na: ['faktorijel'] uradi: {
	>> ukupno := 1.
	{ :indeks ukupno pomnoži-sa: (sebe - (indeks)). } × sebe. <- ukupno.
}.
>> Štampač := Objekat novi.
Štampač na: ['štampaj:i:'] uradi: { :x :y
	Izlaz piši: ['a='] + x + [', b='] + y, novi-red.
}.
>> a := 4.5. >> b := a zaokruži-dolje.
Štampač štampaj: a i: b.
