


>> Deck := Lista novi.
Deck na: ['print'] uradi: {
        >> len := sebe broj-elemenata - 1.
        { :i
                >> len2 := sebe broj-elemenata - 1.
                Izlaz piši: ['len: '].
                Izlaz piši: len, novi-red.
                Izlaz piši: ['len2: '].
                Izlaz piši: len2, novi-red.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
