# Ovaj test provjerava da string_fill_in ne gubi svoj utor (gc'ed) u načinu 4
# referenca u world.c
>> Dnevnik := Objekat novi.

Dnevnik na: ['say:'] uradi: { :str
	Izlaz piši: str, novi-red.
}.

>> Stavka := Objekat novi.

Stavka na: ['novi:'] uradi: { :id
	<- sebe novi id: id.
}.

Stavka na: ['id:'] uradi: { :id
	svoj id := id.
}.

Stavka na: ['id'] uradi: { <- svoj id. }.


Stavka na: ['tekst'] uradi: {
	>> str := ['Item#~no'].
	str ~no: svoj id.
	<- str.
}.


>> Print := Objekat novi.

Print na: ['items'] uradi: { 
	
	svoj stavka := Stavka novi: 1.
	
	# ili segfault ili pogrešan niz ovdje
	Dnevnik say: (
		['~item printed.'] ~item: svoj stavka
	).
	
	
}.

Print items.