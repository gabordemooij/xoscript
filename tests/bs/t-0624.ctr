# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := Objekat novi.

Log na: ['say:'] uradi: { :str
	Izlaz piši: str, novi-red.
}.

>> Item := Objekat novi.

Item na: ['novi:'] uradi: { :id <- sebe novi id: id.
}.

Item na: ['id:'] uradi: { :id
	svoj id := id.
}.

Item na: ['id'] uradi: { <- svoj id. }.


Item na: ['tekst'] uradi: {
	>> str := ['Item#~no'].
	str ~no: svoj id. <- str.
}.


>> Print := Objekat novi.

Print na: ['items'] uradi: { 
	
	svoj item := Item novi: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: svoj item
	).
	
	
}.

Print items.