

# kreiranje 64-bitnog cijelog broja za tačne proračune
>> a := Int64 iz-teksta: ['123'].

# u tekst
Izlaz piši: a, novi-red.

# dijeljenje
Izlaz piši: a / (Int64 iz-teksta: ['3']), novi-red.

# množenje
Izlaz piši: a * (Int64 iz-teksta: ['2']), novi-red.

# sabiranje
Izlaz piši: a + (Int64 iz-teksta: ['1']), novi-red.

# oduzimanje
Izlaz piši: a - (Int64 iz-teksta: ['2']), novi-red.

# poređenje
Izlaz piši: ( a =   (Int64 iz-teksta: ['123'])), novi-red.
Izlaz piši: ( a !=: (Int64 iz-teksta: ['124'])), novi-red.
Izlaz piši: ( a <   (Int64 iz-teksta: ['124'])), novi-red.
Izlaz piši: ( a >   (Int64 iz-teksta: ['122'])), novi-red.
Izlaz piši: ( a >=: (Int64 iz-teksta: ['123'])), novi-red.
Izlaz piši: ( a <=: (Int64 iz-teksta: ['123'])), novi-red.





	