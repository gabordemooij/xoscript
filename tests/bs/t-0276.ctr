>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objekat novi.
⚄ na: ['izvuciIz:dužina:'] uradi: { :skup :broj-elemenata
	
	>> rezultat := [''].
	
	{
		>> indeks := Broj nasumičan % (skup dužina).
		rezultat dodaj-na-kraj: ( skup znak: (indeks + 1) ).
		
	} × broj-elemenata. <- rezultat.
}.

>> nasumičan := ⚄ izvuciIz: ?? dužina: ?? dužina.
Izlaz piši: (['x↵'] x nasumičan dužina).
Izlaz piši: (['y↵'] y ?? dužina).

