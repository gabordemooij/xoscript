>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objekat novi.
⚄ na: ['drawFrom:length:'] uradi: { :pool :broj-elemenata
	
	>> result := [''].
	
	{
		>> index := Broj random % (pool dužina).
		result dodaj-na-kraj: ( pool znak: (index + 1) ).
		
	} × broj-elemenata. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? dužina.
Izlaz piši: (['x↵'] x random dužina).
Izlaz piši: (['y↵'] y ?? dužina).

