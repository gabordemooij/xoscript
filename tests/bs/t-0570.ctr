#Linux

 >> t := Trenutak novi.
 
t zona: ['Europe/Amsterdam'].
t godina: 2020, mjesec: 8, dan: 2, sat: 21, minuta: 2, sekunda: 1.

>> a := t sat.
>> ams := t zona.

t zona: ['US/Hawaii'].
>> b := t sat.
>> hw := t zona.

Izlaz
piši: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		ili: ['kasnije'] ili: ['ranije']
	)
),
novi-red.
 