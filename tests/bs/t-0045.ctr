Program upravljanje-memorijom: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } uhvati: {
		oops saberi: 1.
	}, pokreni.
} × 1000.

{
	Izlaz piši: ['hi there!'].
	ovaj-zadatak greška: ['oops'].
	Izlaz piši: ['hi there!'].
	{ Izlaz piši: ['dont print this']. } pokreni.
} uhvati: { :e 
