>> Pozdravljač := Objekat novi.
Pozdravljač na: ['napravi'] uradi: {
	>> pozdravljač := Objekat novi.
	pozdravljač na: ['name:'] uradi: { :naziv
		Izlaz piši: ['postavljanje imena'].
		svoj mojeIme := naziv.
	}.
	pozdravljač na: ['izvršiPozdrav'] uradi: {
		Izlaz piši: ['Hello'].
		Izlaz piši: svoj mojeIme.
	}.
	pozdravljač na: ['pozdravi'] uradi: {
		sebe izvršiPozdrav.
	}. <- pozdravljač.
}.
>> pozdravljač := Pozdravljač napravi.
pozdravljač name: ['sunce!'].
pozdravljač pozdravi.
