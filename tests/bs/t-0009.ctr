>> Greeter := Objekat novi.
Greeter na: ['make'] uradi: {
	>> greeter := Objekat novi.
	greeter na: ['name:'] uradi: { :naziv
		Izlaz piši: ['setting a name'].
		svoj myName := naziv.
	}.
	greeter na: ['performGreeting'] uradi: {
		Izlaz piši: ['Hello'].
		Izlaz piši: svoj myName.
	}.
	greeter na: ['greet'] uradi: {
		sebe performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
