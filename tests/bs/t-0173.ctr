

Lista na: ['zbir'] uradi: {
	>> ukupno := 0.
	sebe svaki: { :indeks :element
		ukupno saberi: element.
	}. <- ukupno.
}.

Lista na: ['umnožak'] uradi: {
	>> ukupno := 1.
	sebe svaki: { :indeks :element
		ukupno pomnoži-sa: element.
	}. <- ukupno.
}.

>> korištenaMemorija1 := 0.
>> korištenaMemorija2 := 0.
>> korištenaMemorija3 := 0.
>> korištenaMemorija4 := 0.

Program upravljanje-memorijom: 0.

{

>> a := Lista ← ['hello'] ; ['world'] ; Tačno ; Ništa ; 666.
a := a + ( Lista ← 1 ).
Izlaz piši: ( ['zbir: '] + ( a zbir ) ), novi-red.
Izlaz piši: ( ['min: '] + ( a minimum ) ), novi-red.
Izlaz piši: ( ['maks: '] + ( a maksimum ) ), novi-red.
Izlaz piši: ( ['3.: '] + ( a ? 2 ) ), novi-red.
Izlaz piši: ( ['umn: '] + ( a umnožak ) ), novi-red.
a sortiraj: { :a :b <- (b - a). }.
a svaki: { :i :e Izlaz piši: ( i - 0 ), novi-red. }.

} pokreni.

