#Linux
>> Slurp := Objekat novi.

Slurp na: ['novi'] uradi: {
	svoj str := [''].
}.

Slurp na: ['nieuw'] uradi: {
	svoj str := [''].
}.

Slurp na: ['odgovori:'] uradi: { :blah
		svoj str dodaj-na-kraj: blah.
}.

Slurp na: ['odgovori:i:'] uradi: { :blah :blahah
		svoj str dodaj-na-kraj: (blah od: 0 dužina: (blah dužina - 1)).
		svoj str dodaj-na-kraj: [' '].
		svoj str dodaj-na-kraj: blahah.
}.

Slurp na: ['dobij'] uradi: {
	>> bafer := svoj str.
	svoj str := ['']. <- bafer.
}.


Izlaz piši: (Program sistem: (Slurp novi echo: ['Zdravo, mogu pisati na konzolu pomoću fluidnog API-ja!'], dobij)).


{ Datoteka novi: ['/tmp/from.txt'], izbriši. } uhvati: { ['Prazno']. }, pokreni.
{ Datoteka novi: ['/tmp/to.txt'], izbriši. } uhvati: { ['Prazno']. }, pokreni.


Datoteka novi: ['/tmp/to.txt'], postoji netačno: {
	Izlaz piši: ['Confirmed. Target file does not exist.\
'].
}.
Datoteka novi: ['/tmp/from.txt'], postoji netačno: {
	Izlaz piši: ['Confirmed. Source file does not exist.\
'].
}.



Program sistem: (Slurp novi touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], dobij).



Program sistem: (Slurp novi cp: ['/tmp/from.txt /tmp/to.txt'], dobij).

Datoteka novi: ['/tmp/to.txt'], postoji tačno: {
	Izlaz piši: ['Confirmed. Target file has been created by shell.\
'].
}.


Izlaz piši: ['Sadržaj datoteke je:'] + (Datoteka novi: ['/tmp/to.txt'], čitaj), novi-red.
