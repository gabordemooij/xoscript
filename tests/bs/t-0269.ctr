#Linux

(Datoteka novi: ['/tmp/testje']) postoji netačno: {
	Program sistem: ['mkdir /tmp/testje'].	
}.

(Datoteka novi: ['/tmp/testje/file1']) postoji netačno: {
	Program sistem: ['touch /tmp/testje/file1'].	
}.

(Datoteka novi: ['/tmp/testje/folder1']) postoji netačno: {
	Program sistem: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Datoteka lista: ['/tmp/testje'].

>> q := Lista novi.

l svaki: { :k :v v svaki: { :x :y q dodaj-na-kraj: y. }. }.

>> s := q tekst.

(s sadrži: ['file1']) tačno:   { Izlaz piši: ['OK'], novi-red. }.
(s sadrži: ['file2']) tačno:   { Izlaz piši: ['XX'], novi-red. }.
(s sadrži: ['folder1']) tačno: { Izlaz piši: ['OK'], novi-red. }.
