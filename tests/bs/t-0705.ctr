

>> obj := Objekat novi.

obj na: ['greet'] uradi: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj na: ['task'] uradi: {
	svoj property := 123.
	{
		# try binds self/own to object instead of block
		Izlaz piši: sebe greet.
		Izlaz piši: svoj property.
		1 / 0.
	} uhvati: {
		Izlaz piši: sebe greet.
		Izlaz piši: svoj property.
		Izlaz piši: ['ok'].
	}, pokušaj.
}.

obj task.