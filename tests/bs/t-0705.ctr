

>> obj := Objekat novi.

obj na: ['pozdravi'] uradi: {
	<- ['ćao'].
}.

# treba ispisati hi123hi123ok
obj na: ['zadatak'] uradi: {
	svoj svojstvo := 123.
	{
		# try veže sebe/svoj za objekat umjesto za blok
		Izlaz piši: sebe pozdravi.
		Izlaz piši: svoj svojstvo.
		1 / 0.
	} uhvati: {
		Izlaz piši: sebe pozdravi.
		Izlaz piši: svoj svojstvo.
		Izlaz piši: ['ok'].
	}, pokušaj.
}.

obj zadatak.