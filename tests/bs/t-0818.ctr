# edge cases from a request must give an error or a result, not a crash
Server init.

Izlaz piši: ['<'] + (['abc'] od: 0 dužina: 0, velika-slova) + ['>'], novi-red.
Izlaz piši: ['<'] + (['abc'] od: 0 dužina: 0, mala-slova) + ['>'], novi-red.
Izlaz piši: ['<'] + (['abc'] pomak: 3, velika-slova) + ['>'], novi-red.
Izlaz piši: [''] velika-slova bytes, novi-red.
Izlaz piši: ['aB'] velika-slova, novi-red.
Izlaz piši: ['aB'] mala-slova, novi-red.

Izlaz piši: (Trenutak novi: 0) godina, novi-red.
{ Trenutak novi: ['9e300'] broj. } uhvati: { :e Izlaz piši: e, novi-red. }, pokreni.
{ Trenutak novi: ['-9e300'] broj. } uhvati: { :e Izlaz piši: e, novi-red. }, pokreni.
{ Trenutak novi: ['nan'] broj. } uhvati: { :e Izlaz piši: e, novi-red. }, pokreni.
{ Trenutak novi: 9000000000000000000. } uhvati: { :e Izlaz piši: e, novi-red. }, pokreni.
