


>> AparatZaKafu := Objekat novi.
AparatZaKafu na: ['order:'] uradi: { :id
	>> coffee := ['Americano'].
	( id = 1 ) tačno: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) tačno: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) tačno: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> JednostavniAparatZaKafu := Objekat novi.
JednostavniAparatZaKafu na: ['narudžba'] uradi: { <- ['Crna']. }.
>> crvenaŠolja := AparatZaKafu order: 1.
Izlaz piši: crvenaŠolja, novi-red.
crvenaŠolja := ['Čaj']. 
>> zelenaŠolja := AparatZaKafu order: 0.
Izlaz piši: zelenaŠolja, novi-red.
>> žutaŠolja := AparatZaKafu order: 1.
Izlaz piši: žutaŠolja, novi-red.
>> plavaŠolja := AparatZaKafu order: 0.
Izlaz piši: plavaŠolja, novi-red.
>> plastičnaŠolja := JednostavniAparatZaKafu narudžba.
plastičnaŠolja := ['Limunada']. 
>> crnaŠolja := JednostavniAparatZaKafu narudžba.
Izlaz piši: crnaŠolja, novi-red.
crnaŠolja dodaj-na-kraj: [' neee.... pivo. '].
>> narandžastaŠolja := JednostavniAparatZaKafu narudžba.
Izlaz piši: narandžastaŠolja, novi-red.
