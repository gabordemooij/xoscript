Izlaz piši: ['Testni objekat'], novi-red.
>> p := Putanja /tmp.
Izlaz piši: p, novi-red.
>> stara-adresa-p := p prototip memorijska-adresa.
p save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== PONOVNO UČITAVANJE SNIMKA:'], novi-red.
>> b := Objekat load-from: ['/tmp/a.bin'].
(b prototip memorijska-adresa = stara-adresa-p) tačno: {
	Izlaz piši: ['Veza objekta ponovo povezana.'], novi-red.
}.
Izlaz piši: b, novi-red.
