

>> g  := Server novi.
>> v  := Sef novi.
>> ok := 0.

>> tajne := Lista novi ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> lozinke := tajne kopiraj.
lozinke svaki: { :i :p
	tajne svaki: { :n :s
		{
			>> šifrovano := v šifriraj: s ključ: p.
			>> dešifrovano := v dešifriraj: šifrovano ključ: p.
			(dešifrovano = s) tačno: {
				ok saberi: 1.
			}, inače: {
				Izlaz piši: ['šifrovanje/dešifrovanje nije uspjelo: '], novi-red.
				Izlaz piši: s, novi-red.
				Izlaz piši: ['šifrovano: '] + šifrovano, novi-red.
				Izlaz piši: ['dešifrovano: '] + šifrovano, novi-red.
				Program kraj.
			}.
		} uhvati: { :grš
			(s = [''] ili: p = ['']) tačno: {
				ok saberi: 1.
			}, inače: {
				Izlaz piši: grš, novi-red.
				Program kraj.
			}.
		}, pokreni.
	}.
}.

Izlaz piši: ( ok + [' šifrovanja trezorom testirano.'] ), novi-red.