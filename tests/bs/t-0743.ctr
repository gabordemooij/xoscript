>> V := Objekat.
V na: ['tekst'] uradi: {
	Izlaz piši: ['cast'], novi-red.
	<- ['abc'].
}.

Izlaz piši: ( Program postavka: ['abc'] ), novi-red.

# params ne smiju biti pokupljeni od gc-a
Program postavka: ([''] + V novi) vrijednost: ([''] + V novi).

Izlaz piši: ( Program postavka: ['abc'] ), novi-red.
