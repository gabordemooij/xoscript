>> t := Ništa.

# you can control the time zone for
# parsing like this:
Trenutak zona: ['CET'].
t := Trenutak iz: ['1981-02-03 04:05:06'].
Izlaz piši: t, novi-red.

# now using CEST time zone:
Trenutak zona: ['CEST'].
t := Trenutak iz: ['1981-02-03 04:05:06'].
Izlaz piši: t, novi-red.

# error if string cannot be parsed
{ Trenutak iz: ['1900']. } uhvati: { Ništa. }, pokreni.
