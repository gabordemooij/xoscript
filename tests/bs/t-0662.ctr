>> t := Ništa.

# možete kontrolisati vremensku zonu za
# parsiranje ovako:
Trenutak zona: ['CET'].
t := Trenutak iz: ['1981-02-03 04:05:06'].
Izlaz piši: t, novi-red.

# sada s vremenskom zonom CEST:
Trenutak zona: ['CEST'].
t := Trenutak iz: ['1981-02-03 04:05:06'].
Izlaz piši: t, novi-red.

# greška ako se tekst ne može parsirati
{ Trenutak iz: ['1900']. } uhvati: { Ništa. }, pokreni.
