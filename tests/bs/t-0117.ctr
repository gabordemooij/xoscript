>> t := Tačno.
(t = Tačno) tačno: { Izlaz piši: ['T']. }.
(t = Netačno) tačno: { Izlaz piši: ['F']. }.
Izlaz piši: ['|'].
>> t := Netačno.
(t = Tačno) tačno: { Izlaz piši: ['T']. }.
(t = Netačno) tačno: { Izlaz piši: ['F']. }.
Izlaz piši: ['|'].
>> f := Tačno.
(t = Tačno i: f = Netačno) tačno: { Izlaz piši: ['T']. }.
(t = Netačno i: f = Tačno) tačno: { Izlaz piši: ['F']. }.
Izlaz piši: ['|'].
>> n := Ništa.
(n Ništa?) tačno: { Izlaz piši: ['T']. }.
(n Ništa?) netačno: { Izlaz piši: ['F']. }.
Izlaz piši: ['|'].
(f Boolean?) tačno: { Izlaz piši: ['T']. }.
(f Boolean?) netačno: { Izlaz piši: ['F']. }.



