# test odrednica

>> $ := Objekat novi.

$ na: ['odgovori:'] uradi: { :x
	
	>> operacija := x znak: 0.
	>> valuta := x znak: 1.
	>> novac := x pomak: 2.
	
	>> iznos := 0.

	( operacija = ['+'] ) tačno: {
		( valuta = ['£'] ) tačno: { iznos := 1.28 × novac. }.
	}. <- iznos.
}.



>> x := $ +£20.

Izlaz piši: x, novi-red.


>> Voće := Objekat novi.

Voće na: ['novi'] uradi: {
	>> f := sebe novi.
	f apples: 0.
	f oranges: 0. <- f.
}.

Voće na: ['apples:'] uradi: { :a svoj jabuke := a. }.
Voće na: ['oranges:'] uradi: { :p svoj narandže := p. }.
Voće na: ['jabuke'] uradi: { <- svoj jabuke. }.
Voće na: ['narandže'] uradi: { <- svoj narandže. }.

Voće na: ['+'] uradi: { :f
	
	>> n := Voće novi.
	f saberi: 1.
	
	n apples: (f jabuke + svoj jabuke).
	n oranges:  (f narandže  + svoj narandže). <- n.
}.

Voće na: ['tekst'] uradi: { <- ( svoj jabuke tekst + [' jabuka i '] + svoj narandže + [' narandži'] ).
}.

Broj na: ['jabuke'] uradi: { <- ((Voće novi) apples: sebe).
}.

Broj na: ['apple'] uradi: { <- ((Voće novi) apples: sebe).
}.

Broj na: ['narandže'] uradi: { <- ((Voće novi) oranges: sebe).
}.




Izlaz piši: (1 apple + 3 narandže + 4 jabuke), novi-red.


Tekst na: ['dvaput'] uradi: { <- ((sebe tekst) + (sebe tekst)).
}.



Izlaz piši: ['❤❤❤'] dvaput.



