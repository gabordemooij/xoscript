# test qualifiers

>> $ := Objekat novi.

$ na: ['odgovori:'] uradi: { :x
	
	>> operation := x znak: 0.
	>> valuta := x znak: 1.
	>> money := x pomak: 2.
	
	>> amount := 0.

	( operation = ['+'] ) tačno: {
		( valuta = ['£'] ) tačno: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Izlaz piši: x, novi-red.


>> Fruit := Objekat novi.

Fruit na: ['novi'] uradi: {
	>> f := sebe novi.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit na: ['apples:'] uradi: { :a svoj apples := a. }.
Fruit na: ['oranges:'] uradi: { :p svoj oranges := p. }.
Fruit na: ['apples'] uradi: { <- svoj apples. }.
Fruit na: ['oranges'] uradi: { <- svoj oranges. }.

Fruit na: ['+'] uradi: { :f
	
	>> n := Fruit novi.
	f saberi: 1.
	
	n apples: (f apples + svoj apples).
	n oranges:  (f oranges  + svoj oranges). <- n.
}.

Fruit na: ['tekst'] uradi: { <- ( svoj apples tekst + [' apples and '] + svoj oranges + [' oranges'] ).
}.

Broj na: ['apples'] uradi: { <- ((Fruit novi) apples: sebe).
}.

Broj na: ['apple'] uradi: { <- ((Fruit novi) apples: sebe).
}.

Broj na: ['oranges'] uradi: { <- ((Fruit novi) oranges: sebe).
}.




Izlaz piši: (1 apple + 3 oranges + 4 apples), novi-red.


Tekst na: ['twice'] uradi: { <- ((sebe tekst) + (sebe tekst)).
}.



Izlaz piši: ['❤❤❤'] twice.



