#Linux
>> OS := Program postavka: ['OS'].

>> clock := Trenutak novi.
	
(OS = ['Haiku']) tačno: {
	clock zona: ['CET'],
	godina: 2017, mjesec: 7, dan: 13,
	sat: 18, minuta: 0, sekunda: 0.
}, inače: {
	clock zona: ['Europe/Amsterdam'],
	godina: 2017, mjesec: 7, dan: 13,
	sat: 18, minuta: 0, sekunda: 0.
}.

clock na: ['tell'] uradi: {
	Izlaz piši: sebe, novi-red.
}.


clock saberi: 2    sat, tell.
clock saberi: 1    sat, tell.
clock saberi: 19 minuta, tell.
clock saberi: 1  minuta, tell.
clock saberi: 1  minuta, tell.
clock saberi: 19 sekunda, tell.
clock saberi: 1  sekunda, tell.
clock saberi: 1  sekunda, tell.
clock saberi: 2    godina, tell.
clock saberi: 1    godina, tell.

(OS = ['Haiku']) tačno: {
clock saberi: 5   mjesec.
clock zona: ['CEST'], tell.
}, inače: {
	clock saberi: 5   mjesec, tell.
}.

clock saberi: 1   mjesec, tell.
clock saberi: 19    dan, tell.
clock saberi: 1    sat, tell.
clock saberi: 120  yard, tell.
