>> To-Do := Objekat novi.

To-Do na: ['novi'] uradi: {
	svoj list := Lista novi.
}.

To-Do na: ['nieuw'] uradi: {
	svoj list := Lista novi.
}.

To-Do na: ['+'] uradi: { :task
	svoj list dodaj-na-kraj: task.
}.

To-Do na: ['number of tasks?'] uradi: { <-  svoj list broj-elemenata.
}.

>> todos := 
	To-Do novi 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Izlaz piši: ['You have $ tasks to do'] $ todos number of tasks?.
