>> Za-Uraditi := Objekat novi.

Za-Uraditi na: ['novi'] uradi: {
	svoj list := Lista novi.
}.

Za-Uraditi na: ['nieuw'] uradi: {
	svoj list := Lista novi.
}.

Za-Uraditi na: ['+'] uradi: { :zadatak
	svoj list dodaj-na-kraj: zadatak.
}.

Za-Uraditi na: ['number of tasks?'] uradi: { <-  svoj list broj-elemenata.
}.

>> zadaci := 
	Za-Uraditi novi 
	+ ['skuhaj večeru'] 
	+ ['pospremi sobu'].
	
Izlaz piši: ['You have $ tasks to do'] $ zadaci number of tasks?.
