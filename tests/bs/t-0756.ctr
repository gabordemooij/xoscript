Izlaz piši: ['Testni objekat'], novi-red.
>> pozdravljač := Objekat novi.
pozdravljač na: ['name:'] uradi: { :naziv
	svoj xime := naziv. 
}.
pozdravljač na: ['pozdravi'] uradi: {
	Izlaz piši: ['Zdravo '] + svoj xime, novi-red.
}.
pozdravljač name: ['Sherlock'].
pozdravljač save-as: ['/tmp/a.bin'].
pozdravljač save-as: ['/tmp/b.bin'].
Izlaz piši: ['========== PONOVNO UČITAVANJE SNIMKA:'], novi-red.
>> b := Objekat load-from: ['/tmp/a.bin'].
>> c := Objekat load-from: ['/tmp/b.bin'].
b pozdravi.
b name: ['Watson'], pozdravi.
c name: ['Moriarty'], pozdravi.
