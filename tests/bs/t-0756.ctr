Izlaz piši: ['Test object'], novi-red.
>> greeter := Objekat novi.
greeter na: ['name:'] uradi: { :naziv
	svoj xname := naziv. 
}.
greeter na: ['greet'] uradi: {
	Izlaz piši: ['Hello '] + svoj xname, novi-red.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Izlaz piši: ['========== RELOADING SNAP:'], novi-red.
>> b := Objekat load-from: ['/tmp/a.bin'].
>> c := Objekat load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
