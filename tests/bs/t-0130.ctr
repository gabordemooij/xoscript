# korištenje FFI s dodatkom Server

# povezivanje s libc (zavisi od platforme)
>> nazivBiblioteke := Program postavka: ['FFITESTLIB'].

# povezivanje stdio funkcija iz C-a za napredne operacije s datotekama
Server poveži: ( Lista novi ;
 nazivBiblioteke ; ['fopen'] ;
 ( Lista novi ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
poveži: ( Lista novi ;
 Ništa ; # znači ista biblioteka
 ['fread'] ;
 ( Lista novi ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Ništa ; # znači isti objekat (tj. Tok)
 ['fread']
),
poveži: (
 Lista novi ;
 Ništa ; # znači ista biblioteka
 ['fwrite'] ;
 ( Lista novi ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Ništa ; # znači ista biblioteka
 ['fwrite']
),
poveži: (
 Lista novi ;
 Ništa ; # znači ista biblioteka
 ['rewind'] ;
 ( Lista novi ; ['pointer'] ) ;
 ['int'] ;
 Ništa ; # znači ista biblioteka
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> putanja := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# otvaranje datoteke pomoću fopen(path, mode)
>> fd := Stream path: putanja mode: mode.

# upisivanje bajtova iz bafera niz u datoteku
>> upisano-bajtova := Stream poruka: ['fwrite'] argumenti: (Lista novi ; str ; 1 ; 6 ; fd ).
Izlaz piši: upisano-bajtova, novi-red.

# vraćanje pokazivača datoteke na početak
Stream rewind: fd.

# alociranje bafera
>> baf := Blob novi: 20.

# čitanje iz datoteke
>> pročitano-bajtova := Stream poruka: ['fread'] argumenti: (Lista novi ; baf ; 1 ; 6 ; fd ).
Izlaz piši: pročitano-bajtova, novi-red.
Izlaz piši: baf, novi-red.

# oslobađanje memorije
str  oslobodi.
putanja oslobodi.
mode oslobodi.
baf  oslobodi.


