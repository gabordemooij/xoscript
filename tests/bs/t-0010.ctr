>> Animal := Objekat novi.
Animal na: ['make'] uradi: {
	>> animal := Objekat novi.
	animal na: ['makeSound'] uradi: {
		Izlaz piši: svoj sound.
	}. <- animal.
}.
>> Cat := Objekat novi.
Cat na: ['make'] uradi: {
	>> cat := Animal make.
	cat na: ['init'] uradi: {
		svoj sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
