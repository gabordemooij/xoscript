# javni ključ (za zaštitu API-ja itd.)
Server init.

# generisanje ključeva
>> ključevi := Sef generiši-ključeve.

# privatni (tajni) ključ
>> tk := ključevi prvi.

# javni ključ
>> jk := ključevi zadnji.

# potpisivanje poruke
>> potp := Sef potpiši: ['abc'] ključem: tk.

# provjera poruke (ok)
Izlaz piši: ( 
	Sef
		provjeri: ['abc'] 
		potpis: potp 
		ključem: jk 
), novi-red.

# provjera poruke (neuspjeh)
Izlaz piši: ( 
	Sef 
		provjeri: ['abd'] 
		potpis: potp 
		ključem: jk 
), novi-red.