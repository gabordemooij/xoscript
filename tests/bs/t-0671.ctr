# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Sef generiši-ključeve.

# private (secret) key
>> sk := keys prvi.

# public key
>> pk := keys zadnji.

# sign a message
>> sig := Sef potpiši: ['abc'] ključem: sk.

# check message (ok)
Izlaz piši: ( 
	Sef
		provjeri: ['abc'] 
		potpis: sig 
		ključem: pk 
), novi-red.

# check message (fail)
Izlaz piši: ( 
	Sef 
		provjeri: ['abd'] 
		potpis: sig 
		ključem: pk 
), novi-red.