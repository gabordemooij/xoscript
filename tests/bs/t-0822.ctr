# manje parametara nego rezerviranih mjesta mora dati grešku, ne čitati izvan povezivanja
Server init.

>> bp := Maria-DB novi domaćin: ['localhost'],
	korisnik: ['xo'],
	lozinka: ['pass123'],
	naziv-baze: ['xobase'],
	poveži-se.

>> parametri-pretrage := bp upit: ['SELECT ? AS a, ? AS b, ? AS c'].
parametri-pretrage parametri: (Lista novi ; ['1']).
{ parametri-pretrage dohvati: { :redak Izlaz piši: redak, novi-red. }. } uhvati: { :e Izlaz piši: e, novi-red. }, pokreni.

>> parametri-pretrage := bp upit: ['SELECT ? AS a'].
{ parametri-pretrage dohvati: { :redak Izlaz piši: redak, novi-red. }. } uhvati: { :e Izlaz piši: e, novi-red. }, pokreni.

# tačan broj i dalje radi, višak parametara se zanemaruje kao i prije
>> parametri-pretrage := bp upit: ['SELECT ? AS a, ? AS b'].
parametri-pretrage parametri: (Lista novi ; ['1'] ; ['2']).
parametri-pretrage dohvati: { :redak Izlaz piši: (redak na: ['a']), piši: (redak na: ['b']), novi-red. }.
parametri-pretrage parametri: (Lista novi ; ['1'] ; ['2'] ; ['3']).
parametri-pretrage dohvati: { :redak Izlaz piši: (redak na: ['a']), piši: (redak na: ['b']), novi-red. }.
