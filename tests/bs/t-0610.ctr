
>> Pravougaonik := Objekat novi.

Pravougaonik na: ['površina'] uradi: {
	<- svoj dužina * svoj širina.
}.

Pravougaonik na: ['length:'] uradi: { :dužina
	svoj dužina := dužina.
}.

Pravougaonik na: ['width:'] uradi: { :širina
	svoj širina := širina.
}.

Pravougaonik na: ['novi'] uradi: {
	# ovo neće dovesti do beskonačne petlje
	>> pravougaonik := sebe novi.
	pravougaonik length: 0, width: 0.
	<- pravougaonik.
}.

>> a := Pravougaonik novi.
Izlaz piši: a površina, novi-red. #0

>> b := Pravougaonik novi length: 2, width: 3.
Izlaz piši: b površina, novi-red. #6

