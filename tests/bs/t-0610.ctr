
>> Rectangle := Objekat novi.

Rectangle na: ['area'] uradi: { <- svoj dužina * svoj width.
}.

Rectangle na: ['length:'] uradi: { :dužina
	svoj dužina := dužina.
}.

Rectangle na: ['width:'] uradi: { :width
	svoj width := width.
}.

Rectangle na: ['novi'] uradi: {
	# this will not result into an infinite loop
	>> rectangle := sebe novi.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle novi.
Izlaz piši: a area, novi-red. #0

>> b := Rectangle novi length: 2, width: 3.
Izlaz piši: b area, novi-red. #6

