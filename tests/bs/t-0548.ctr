Server init.

>> x := Blob novi: 65 tip: ['char'].
# za ovaj test treba postaviti putanju do libc (puts)
>> nazivBiblioteke := Program postavka: ['FFITESTLIB'].
Server poveži: (
 Lista novi ;
 nazivBiblioteke ;
 ['putchar'] ;
 ( Lista novi ; ['char'] ) ;
 ['void'] ;
 ['Print'] ;
 ['char:']
).
Print char: (x od: 0 dužina: 1), novi-red.
x oslobodi.

