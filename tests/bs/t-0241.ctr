

Tekst na: ['izračunaj'] uradi: {
	>> kod := Datoteka novi: ['/tmp/eval.ctr'].
	kod piši: (sebe tekst + ['.']).
	Program koristi: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Lista ← (['Navodnici '] + Q + [' su zli?']) ; 1.
>> x := q tekst.
Izlaz piši: x, novi-red.
>> y := Ništa.
(['y := '] + x ) izračunaj.
Izlaz piši: y ? 0, novi-red.

q := Rječnik stavi: ['\[''] na: ['\['quote\']'].
x := q tekst.
Izlaz piši: x, novi-red.
y := Ništa.
(['y := '] + x ) izračunaj.

>> q := (Rječnik novi) stavi:['\[''] na:['\['quote\[''].
Izlaz piši: y ? ['\['quote\']'], novi-red.
