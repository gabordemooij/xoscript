# format kolačića sesije, json tip sadržaja, samo web protokoli, svg prikazan u liniji
Server inicijaliziraj.
Program koristi: ['../../../src/xo/bs/webtools.xo'].

>> Lažni-Zahtjev := Objekat novi.
Lažni-Zahtjev na: ['value:'] uradi: { :vrijednost
	svoj vrijednost := vrijednost.
}.
Lažni-Zahtjev na: ['cookie:'] uradi: { :naziv
	<- svoj vrijednost.
}.

>> Test-Sesija := Sesija-privremena-datoteka novi.
Test-Sesija na: ['učitaj'] uradi: {
	<- Rječnik novi.
}.
Test-Sesija na: ['sesija-id'] uradi: {
	<- svoj id.
}.

>> kolačići := Lista novi
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

kolačići svaki: { :i :kolačić
	>> zahtjev := Lažni-Zahtjev novi.
	zahtjev value: kolačić.
	>> upravitelj := Test-Sesija novi.
	>> veb := Web-dokument novi.
	veb zahtjev: zahtjev.
	veb upravitelj-sesija: upravitelj.
	veb pokreni-sesiju.
	Izlaz piši: ( upravitelj sesija-id = kolačić ), novi-red.
}.

>> veb := Web-dokument novi.
veb json: (Rječnik novi stavi: ['b'] na: ['a']).
Izlaz piši: ['\n'], novi-red.

{ Mreža get: ['file:///etc/hostname']. } uhvati: { :e
	Izlaz piši: e, novi-red.
}, pokreni.

>> svg := Datoteka novi: ['/tmp/test0814.svg'].
svg piši: ['<svg xmlns="x"></svg>'].
Izlaz novi-red.
Server proslijedi: ['test0814.svg'] prefiks: ['/tmp/'].
svg izbriši.
