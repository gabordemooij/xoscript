
>> dictionary := (
	Rječnik novi
		stavi: ['b'] na: ['a'],
		stavi: ['a'] na: ['b'],
		stavi: ['z'] na: ['x'],
		stavi: ['hello'] na: ['hallo'],
		stavi: ['human'] na: ['human']
).

>> comparisons := Lista novi.
dictionary svaki: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a uporedi: b)
	).
}.

comparisons sortiraj: { :a :b <- ( a uporedi: b ). }.
Izlaz piši: ( comparisons spoji: ['↵'] ), novi-red.
comparisons spoji: ['↵'].
