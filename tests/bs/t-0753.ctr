Izlaz piši: ['Testni objekat'], novi-red.
>> a := Objekat novi. 

a na: ['item:'] uradi: { :fmt
	svoj fmt := fmt. 
}.

a na: ['stavka'] uradi: {
	<- svoj fmt.
}.

a item: ( Format novi: ['|%s|'] ).

Izlaz piši: a stavka, novi-red.

>> stara-adresa-fmt := a stavka prototip memorijska-adresa.
a save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== PONOVNO UČITAVANJE SNIMKA:'], novi-red.

>> b := Objekat load-from: ['/tmp/a.bin'].

(b stavka prototip memorijska-adresa = stara-adresa-fmt) tačno: {
	Izlaz piši: ['Veza objekta ponovo povezana.'], novi-red.
}.

Izlaz piši: ( b stavka primijeni: ['hello'] ), novi-red.
