# prelomi reda u vrijednostima ne smiju stvarati dodatna zaglavlja
Server inicijaliziraj.
Program koristi: ['../../../src/xo/bs/webtools.xo'].
Program koristi: ['../../../src/xo/bs/mailtools.xo'].

>> zaglavlje := HTTP-Zaglavlje novi ključ: ['Location'] vrijednost: ['/ok\r\nX-Injected: yes'].
Izlaz piši: zaglavlje.

>> veb := Web-dokument novi.
veb idi-na: ['/ok\r\nX-Injected: yes'].
Izlaz piši: ['\n'], novi-red.

>> pošta := Email novi.
pošta prima: (Lista novi ; ['a@example.invalid\r\nX-To: yes']).
pošta cc: (Lista novi ; ['b@example.invalid\r\nX-Cc: yes']).
pošta bcc: (Lista novi ; ['c@example.invalid\r\nX-Bcc: yes']).
pošta pošiljalac: ['d@example.invalid\r\nX-From: yes'] naziv: ['site\r\nX-Name: yes'].
pošta predmet: ['hello\r\nX-Subject: yes'].
pošta tijelo: ['line1\r\nline2'].
Izlaz piši: pošta generiši.

>> html := HTML-Email novi.
html prima: (Lista novi ; ['a@example.invalid\r\nX-To: yes']).
html pošiljalac: ['d@example.invalid'] naziv: ['site'].
html predmet: ['hello\r\nX-Subject: yes'].
html tijelo: ['body'].
Izlaz piši: ( html generiši sadrži: ['\nX-'] ), novi-red.
Izlaz piši: ( html generiši sadrži: ['X-To: yes'] ), novi-red.
