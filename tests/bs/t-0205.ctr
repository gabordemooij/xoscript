>> str := ['write:'].
Izlaz poruka: ['piši:'] argumenti: (Lista ← ['Hello World']), novi-red. 

Broj na: ['isbetween:and:'] uradi: { :a :b <- ((sebe ≥ a) i: (sebe ≤ b)).
}.

str := ['isbetween:and:'].
Izlaz piši: (3 poruka: str argumenti: (Lista ← 2 ; 8)), novi-red.
Izlaz piši: (3 poruka: str argumenti: (Lista ← 1 ; 2)), novi-red.


>> CoffeeMachine := Objekat novi.
CoffeeMachine na: ['makeCoffeeWithSugar:milk:'] uradi: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Lista ← 4 ; 2.
Izlaz piši: ( CoffeeMachine poruka: order argumenti: coffeeConfiguration ), novi-red.
