

>> Matryoshka := Objekat novi.
Matryoshka na: ['double:'] uradi: { :secret
	svoj secret := secret × 2.
}.
Matryoshka na: ['novi:'] uradi: { :secret
	>> answer := Ništa.
	>> t := (secret > 255).
	Izlaz piši: (secret + [' | '] + t), novi-red.
	t tačno: {
		answer := secret.
	}, inače: {
		answer := Matryoshka rekurzivan novi: (sebe double: secret).
	}. <- answer.
}.

>> x := Matryoshka novi: 2.
