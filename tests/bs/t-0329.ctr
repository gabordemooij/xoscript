Izlaz piši: ((Lista novi
	na: ['plaque:'] uradi: { :x svoj o := x. },
	na: ['ploča']  uradi: { <- svoj o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Lista ← 1)
	~ (Lista ← 1 ; 2)
	~ (Lista ← 1 ; 2 ; 3)
	~ (Lista ← 1 ; 2 ; 3 ; 4)
	~ (Lista ← 1 ; 2 ; 3 ; 4 ; 5)
) svaki: { :i :el
	{ Izlaz piši: ovaj-zadatak. } × el broj-elemenata.
	Izlaz novi-red.
}) ploča, novi-red.


