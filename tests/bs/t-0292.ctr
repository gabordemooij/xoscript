>> vinarija := { <- (	Rječnik novi
		stavi: 2 na: ['merlot'],
		stavi: 3 na: ['malbec'],
		stavi: 4 na: ['syrah']
	).
}.

Izlaz piši: (((vinarija pokreni) - ['ništa']) broj-elemenata), novi-red.
Izlaz piši: (((vinarija pokreni) - ['merlot']) broj-elemenata), novi-red.
Izlaz piši: (((vinarija pokreni) - ['malbec']) broj-elemenata), novi-red.
Izlaz piši: (((vinarija pokreni) - ['syrah']) broj-elemenata), novi-red.
Izlaz piši: (((vinarija pokreni) - ['merlot'] - ['malbec']) broj-elemenata), novi-red.
Izlaz piši: (((vinarija pokreni) - ['merlot'] - ['syrah']) broj-elemenata), novi-red.
Izlaz piši: (((vinarija pokreni) - ['malbec'] -['syrah']) broj-elemenata), novi-red.
Izlaz piši: (((vinarija pokreni) - ['malbec'] - ['syrah'] - ['merlot']) broj-elemenata), novi-red.

