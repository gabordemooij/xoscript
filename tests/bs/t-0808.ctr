# ključevi i potpisi sefa koji se dekodiraju predugo ne smiju prepuniti stek
Server init.

>> ključevi := Sef generiši-ključeve.
>> tk := ključevi prvi.
>> jk := ključevi zadnji.
>> potp := Sef potpiši: ['abc'] ključem: tk.

# 88 znakova bez dopune dekodira se u 66 bajtova
>> dugačak := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 znaka bez dopune dekodira se u 33 bajta
>> kratak := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Sef potpiši: ['abc'] ključem: dugačak. } uhvati: { :e
	Izlaz piši: e, novi-red.
}, pokreni.

{ Sef provjeri: ['abc'] potpis: dugačak ključem: jk. } uhvati: { :e
	Izlaz piši: e, novi-red.
}, pokreni.

{ Sef provjeri: ['abc'] potpis: potp ključem: kratak. } uhvati: { :e
	Izlaz piši: e, novi-red.
}, pokreni.
