# test baze podataka
# vidi primjer server.xo za potrebnu konfiguraciju

Server init.
Izlaz piši: ['Test baze podataka'], novi-red.

>> bp := Maria-DB novi domaćin: ['localhost'],
	korisnik: ['xo'], lozinka: ['pass123'], naziv-baze: ['xobase'], poveži-se.

Izlaz piši: ['Možemo li se povezati? '] + bp povezano?, novi-red.

>> parametri-pretrage := bp upit: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parametri: ( Lista novi ; ['abc'] ; 12.35 ; 6 ). # parametrizirani upiti

{  parametri-pretrage izvrši. bp potvrdi. } uhvati: { :e bp poništi.  }, pokreni.

Izlaz piši: ['Možemo li umetnuti? '] + ( parametri-pretrage insert-id > 0 ), novi-red.

>> Obj := Objekat novi.
Obj na: ['dohvati-redove'] uradi: {
	svoj broj-elemenata := 0.
	>> parametri-pretrage :=
	bp upit: ['SELECT * FROM book order by id desc limit 2'], 
	dohvati: { :redak 
		svoj broj-elemenata saberi: 1.
		Tačno prekini.
	}. # dohvatanje redova
	<- svoj broj-elemenata kopiraj.
}.

Izlaz piši: ['Možemo li postaviti upit? '] + ( Obj dohvati-redove > 0 ), novi-red.
