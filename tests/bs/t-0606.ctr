>> Tačka := Objekat novi.
Tačka na: ['x-coordinate:'] uradi: { :x svoj x := x. }.
Tačka na: ['y-coordinate:'] uradi: { :y svoj y := y. }.
Tačka na: ['x-koordinata']  uradi: { <- svoj x kopiraj. }.
Tačka na: ['y-koordinata']  uradi: { <- svoj y kopiraj. }.

Tačka na: ['='] uradi: { :drugi
	<- ( svoj x = drugi x-koordinata
		 i: svoj y = drugi y-koordinata ).
}.

>> mol := Tačka novi x-coordinate: 5, y-coordinate: 6.
>> gradska-vijećnica := Tačka novi x-coordinate: 7, y-coordinate: 1.
>> restoran := Tačka novi x-coordinate: 5, y-coordinate: 6.

Izlaz piši: mol = gradska-vijećnica, novi-red.
Izlaz piši: mol = restoran, novi-red.
