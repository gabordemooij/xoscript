>> Point := Objekat novi.
Point na: ['x-coordinate:'] uradi: { :x svoj x := x. }.
Point na: ['y-coordinate:'] uradi: { :y svoj y := y. }.
Point na: ['x-coordinate']  uradi: { <- svoj x kopiraj. }.
Point na: ['y-coordinate']  uradi: { <- svoj y kopiraj. }.

Point na: ['='] uradi: { :other <- ( svoj x = other x-coordinate
		 i: svoj y = other y-coordinate ).
}.

>> pier := Point novi x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point novi x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point novi x-coordinate: 5, y-coordinate: 6.

Izlaz piši: pier = town-hall, novi-red.
Izlaz piši: pier = restaurant, novi-red.
