
Program upravljanje-memorijom: 4.

>> Životinja := Objekat novi.
Životinja na: ['napravi'] uradi: {
	>> životinja := Objekat novi.
	životinja na: ['napraviZvuk'] uradi: {
		Izlaz piši: svoj zvuk.
	}. <- životinja.
}.
>> Mačka := Objekat novi.
Mačka na: ['napravi'] uradi: {
	>> mačka := Životinja napravi.
	mačka na: ['init'] uradi: {
		svoj zvuk := ['meow!'].
	}.
	mačka init. <- mačka.
}.
>> tom := Mačka napravi.
tom napraviZvuk.
