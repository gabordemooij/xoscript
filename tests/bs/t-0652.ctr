# test number -> string -> number
{

	>> x := Broj između: 0 i: 1000000.
	>> d := Broj između: 1 i: 7.
	>> e := 10 stepen: d.

	x podijeli-sa: e.
	>> y := x tekst broj.

	(x = y) netačno: {
		Izlaz piši: x, novi-red.
		Izlaz piši: y, novi-red.
		Program kraj.
	}.

} * 1000.
Izlaz piši: ['OK'], novi-red.