>> Grandfather := Objekat novi.
Grandfather na: ['greet'] uradi: {
	Izlaz piši: ['Ave!'], novi-red.
}.
>> Father := Grandfather novi.
Father na: ['greet'] uradi: {
	Izlaz piši: ['Hello'], novi-red.
	sebe greet.
}.
>> Son := Father novi.
Son na: ['greet'] uradi: {
	Izlaz piši: ['Hi'], novi-red.
	sebe greet.
}.

Son greet.

>> Roundabout := Objekat novi.
Roundabout na: ['circle:'] uradi: { :x
	Izlaz piši: x, novi-red.
	(x < 3) tačno: { sebe rekurzivan circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) tačno: { Izlaz piši: x, novi-red. x saberi: 1.  increment pokreni. }. }.
increment pokreni.