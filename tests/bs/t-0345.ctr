# test metoda za hvatanje svih poruka
>> x13 := Objekat novi.
x13 na: ['a'] uradi: { :a Izlaz piši: 0, novi-red. }.
x13 na: ['a:'] uradi: { :a Izlaz piši: a, novi-red. <- 5. }.
x13 na: ['a:b:'] uradi: { :a :b Izlaz piši: (a + b), novi-red. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
