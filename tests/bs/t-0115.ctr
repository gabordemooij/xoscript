{
	ovaj-zadatak greška: ['Dont fail.'].
	unknown doSomething.
} uhvati: {
	Izlaz piši: ['Caught!'].
}, pokreni.

{
	ovaj-zadatak greška: ['Dont fail.'].
	svoj unknown doSomething.
} uhvati: {
	Izlaz piši: ['Caught!'].
}, pokreni.

{
	ovaj-zadatak greška: ['Dont fail.'].
	unknown := 122.
} uhvati: {
	Izlaz piši: ['Caught!'].
}, pokreni.


{
	ovaj-zadatak greška: ['Dont fail.'].
	Tačno prekini.
	Izlaz piši: ['FAIL'].
} uhvati: {
	Izlaz piši: ['Caught!'].
}, pokreni.

{
	{
		ovaj-zadatak greška: ['Dont fail.'].
		Tačno prekini.
		Izlaz piši: ['FAIL'].
	} uhvati: { :x
		(x = ['Dont fail.']) tačno: { ovaj-zadatak greška: ['Nested Caught!']. }.
	}, pokreni.
} uhvati: { :e
	Izlaz piši: e.
}, pokreni.
