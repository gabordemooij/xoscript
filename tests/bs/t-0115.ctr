{
	ovaj-zadatak greška: ['Nemoj pasti.'].
	nepoznat uradiNešto.
} uhvati: {
	Izlaz piši: ['Uhvaćeno!'].
}, pokreni.

{
	ovaj-zadatak greška: ['Nemoj pasti.'].
	svoj nepoznat uradiNešto.
} uhvati: {
	Izlaz piši: ['Uhvaćeno!'].
}, pokreni.

{
	ovaj-zadatak greška: ['Nemoj pasti.'].
	nepoznat := 122.
} uhvati: {
	Izlaz piši: ['Uhvaćeno!'].
}, pokreni.


{
	ovaj-zadatak greška: ['Nemoj pasti.'].
	Tačno prekini.
	Izlaz piši: ['NEUSPJEH'].
} uhvati: {
	Izlaz piši: ['Uhvaćeno!'].
}, pokreni.

{
	{
		ovaj-zadatak greška: ['Nemoj pasti.'].
		Tačno prekini.
		Izlaz piši: ['NEUSPJEH'].
	} uhvati: { :x
		(x = ['Nemoj pasti.']) tačno: { ovaj-zadatak greška: ['Ugniježđeno uhvaćeno!']. }.
	}, pokreni.
} uhvati: { :e
	Izlaz piši: e.
}, pokreni.
