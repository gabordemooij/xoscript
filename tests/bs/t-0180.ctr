Tekst na: ['html'] uradi: { <- (
		sebe
		zamijeni: ['&'] sa: ['&amp;'],
		zamijeni: ['<'] sa: ['&lt;'],
		zamijeni: ['>'] sa: ['&gt;'],
		zamijeni: ['''] sa: ['&apos;'],
		zamijeni: ['"'] sa: ['&quot;']
	).
}.

