# vrijednost koja završava prvim dijelom početnog navodnika mora preživjeti serijalizaciju
>> vrijednosti := Lista novi
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

vrijednosti svaki: { :i :value
	>> d := Rječnik novi.
	d stavi: value na: ['k'].
	d stavi: ['second'] na: ['j'].
	>> r := d kod objekat.
	Izlaz piši: r broj-elemenata, novi-red.
	Izlaz piši: ( (r na: ['k']) = value ), novi-red.
}.
