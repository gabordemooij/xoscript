# test buffers PKI/Sign 
Server init.

>> long := ( Lista novi popuni: 1000 sa: ['a'] ) spoji: [''].

# sign a message
Izlaz piši: ( 
	Sef potpiši: ['abc'] ključem: long
), novi-red.

Izlaz piši: ( 
	Sef
		provjeri: ['abc'] 
		potpis: long 
