#ffi test


Server init.

Program upravljanje-memorijom: 4.

# for this test you need set a path to libc (puts)
>> libname := Program postavka: ['FFITESTLIB'].



Server poveži: (
 Lista novi ;
 libname ;
 ['puts'] ;
 ( Lista novi ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s oslobodi.

# test with struct

>> a := Blob novi: 8.
a bytes: (
	Lista <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Lista <<: ['int'], ; ['int']).

Server poveži: (
	Lista <<: ['@structtest'], ;
	['@structtest'] ;
	(Lista <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Izlaz piši: ['Sum test:'] + (ffitest ffisum: a), novi-red.

struct oslobodi-struct.
struct oslobodi.
a oslobodi.
