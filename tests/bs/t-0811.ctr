# od:dužina: broji znakove i podnosi vrlo velike brojeve
>> s := ['ééééééééééééééé'].
Izlaz piši: (s kopiraj od: 0 dužina: 20), novi-red.
Izlaz piši: (s kopiraj od: 10 dužina: 20), novi-red.
Izlaz piši: (s kopiraj od: 14 dužina: 1), novi-red.
Izlaz piši: (s kopiraj pomak: 20), novi-red.
Izlaz piši: ['-'], novi-red.
Izlaz piši: (['abcdef'] od: 2 dužina: 2), novi-red.
Izlaz piši: (['abc'] od: 1 dužina: ['9e300'] broj), novi-red.
Izlaz piši: (['abc'] od: 1 dužina: ['-9e300'] broj), novi-red.
Izlaz piši: (['abc'] od: ['9e300'] broj dužina: 1), novi-red.
Izlaz piši: ['-'], novi-red.
Izlaz piši: (['abc'] od: ['-9e300'] broj dužina: 2), novi-red.
Izlaz piši: (['abc'] od: ['nan'] broj dužina: 2), novi-red.
Izlaz piši: (['abc'] od: 0 dužina: ['nan'] broj), novi-red.
Izlaz piši: ['-'], novi-red.
