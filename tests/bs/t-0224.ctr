
>> countries := Lista novi
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Lista novi
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods prema: countries, svaki: { :key :value
	counter saberi: 1.
}.

Izlaz piši: (['we serve counter dishes'] counter: counter), novi-red.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] znakovi sortiraj: { :v
	counter saberi: 0.
}.

Izlaz piši: (['we sort counter dishes'] counter: counter), novi-red.


>> counter := 0.
{
	{
		counter saberi: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Izlaz piši: (['we calculate counter numbers.'] counter: counter), novi-red.

