# test operacija nad listom


>> kolači := Lista ←
	['apple'] ;
	['bobica'] ;
	['čoko'] ;
	['sir'].


>> kupi := kolači zamijeni: 1 dužina: 2 sa: ( Lista ← ['cimet'] ; ['ananas'] ).
Izlaz piši: (kupi spoji: [',']), novi-red.


>> kupi := kolači zamijeni: 1 dužina: 12 sa: ( Lista ← ['cimet'] ; ['ananas'] ).
Izlaz piši: (kupi spoji: [',']), novi-red.


>> kupi := kolači zamijeni: 2 dužina: 10 sa: ( Lista novi ).
Izlaz piši: (kupi spoji: [',']), novi-red.


>> kupi := kolači zamijeni: 0 dužina: 1 sa: ( Lista novi ).
Izlaz piši: (kupi spoji: [',']), novi-red.


>> kupi := kolači zamijeni: ['0'] dužina: ['1'] sa: ['x'].
Izlaz piši: (kupi spoji: [',']), novi-red.
