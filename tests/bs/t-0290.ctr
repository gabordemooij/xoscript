# test list operations


>> cakes := Lista ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes zamijeni: 1 dužina: 2 sa: ( Lista ← ['cinnamon'] ; ['pineapple'] ).
Izlaz piši: (buy spoji: [',']), novi-red.


>> buy := cakes zamijeni: 1 dužina: 12 sa: ( Lista ← ['cinnamon'] ; ['pineapple'] ).
Izlaz piši: (buy spoji: [',']), novi-red.


>> buy := cakes zamijeni: 2 dužina: 10 sa: ( Lista novi ).
Izlaz piši: (buy spoji: [',']), novi-red.


>> buy := cakes zamijeni: 0 dužina: 1 sa: ( Lista novi ).
Izlaz piši: (buy spoji: [',']), novi-red.


>> buy := cakes zamijeni: ['0'] dužina: ['1'] sa: ['x'].
Izlaz piši: (buy spoji: [',']), novi-red.
