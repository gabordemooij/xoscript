Lista na: ['zbir'] uradi: {
	>> ukupno := 0.
	sebe svaki: { :indeks :element
		ukupno saberi: element.
	}. <- ukupno.
}.

>> a := Tačno.



a na: ['tekst'] uradi: {
	>> odgovor := Ništa.
	( sebe = Tačno ) tačno: {
		odgovor := ['Aha'].
	}, inače: {
		odgovor := ['Ma jok'].
	}. <- odgovor.
}.

a na: ['broj'] uradi: {
	>> odgovor := Ništa.
	( sebe = Tačno ) tačno: {
		odgovor := 10.
	}, inače: {
		odgovor := 20.
	}. <- odgovor.
}.

>> b := 666.

b na: ['tekst'] uradi: { <- ['Đavo'].
}.

b na: ['logički'] uradi: { <- Netačno.
}.


Izlaz piši: a, novi-red.  
Izlaz piši: (90 + a), novi-red. 
Izlaz piši: b, novi-red. 
Izlaz piši: (Tačno i: b), novi-red.

a := Lista ← ['hello'] ; ['world'] ; Tačno ; Ništa ; 666. 
a := a + ( Lista ← 1 ).
Izlaz piši: a, novi-red.
Izlaz piši: ((Rječnik novi) stavi: Ništa na: Ništa), novi-red.
Izlaz piši: a zbir, novi-red. 


{
	a na: ['tekst'] uradi: { <- Ništa. }.
	a := [''] + a.
} uhvati: { :greška
	Izlaz piši: ['Greška zabilježena: '] + greška, novi-red.
}, pokreni.



