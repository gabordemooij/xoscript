Lista na: ['sum'] uradi: {
	>> total := 0.
	sebe svaki: { :index :element
		total saberi: element.
	}. <- total.
}.

>> a := Tačno.



a na: ['tekst'] uradi: {
	>> answer := Ništa.
	( sebe = Tačno ) tačno: {
		answer := ['Yep'].
	}, inače: {
		answer := ['Nope'].
	}. <- answer.
}.

a na: ['broj'] uradi: {
	>> answer := Ništa.
	( sebe = Tačno ) tačno: {
		answer := 10.
	}, inače: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b na: ['tekst'] uradi: { <- ['Devil'].
}.

b na: ['logički'] uradi: { <- Netačno.
}.


Izlaz piši: a, novi-red.  
Izlaz piši: (90 + a), novi-red. 
Izlaz piši: b, novi-red. 
Izlaz piši: (Tačno i: b), novi-red.

a := Lista ← ['hello'] ; ['world'] ; Tačno ; Ništa ; 666. 
a := a + ( Lista ← 1 ).
Izlaz piši: a, novi-red.
Izlaz piši: ((Rječnik novi) stavi: Ništa na: Ništa), novi-red.
Izlaz piši: a sum, novi-red. 


{
	a na: ['tekst'] uradi: { <- Ništa. }.
	a := [''] + a.
} uhvati: { :error
	Izlaz piši: ['Error noted: '] + error, novi-red.
}, pokreni.



{
	a na: ['broj'] uradi: { <- Ništa. }.
	a := 3 × a.
} uhvati: { :error
	Izlaz piši: ['Error noted: '] + error, novi-red.
}, pokreni.


{
	a na: ['logički'] uradi: { <- Ništa. }.
	a := Tačno i: a. 
} uhvati: { :error
	Izlaz piši: ['Error noted: '] + error, novi-red.
}, pokreni.





