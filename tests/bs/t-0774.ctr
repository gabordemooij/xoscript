Izlaz piši: ['Test object'], novi-red.
>> a := Objekat novi. 
a na: ['item:'] uradi: { :lst
	svoj lst := lst. 
}.
a na: ['item'] uradi: { <- svoj lst.
}.
a item: (
	Lista novi ; 1 ; (
		Lista novi ; ['a'] ; (
			Lista novi ; ( Trenutak novi: 1 )
		) ; ( Int64 iz-teksta: ['321'] )
	)
).
Izlaz piši: a item, novi-red.
>> old-lst-address := a item prototip memorijska-adresa.
a save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== RELOADING SNAP:'], novi-red.
>> b := Objekat load-from: ['/tmp/a.bin'].
(b item prototip memorijska-adresa = old-lst-address) tačno: {
	Izlaz piši: ['Object link re-attached.'], novi-red.
}.
Izlaz piši: ( b item ), novi-red.
