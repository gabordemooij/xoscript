Izlaz piši: ['Testni objekat'], novi-red.
>> a := Objekat novi. 
a na: ['item:'] uradi: { :lst
	svoj lst := lst. 
}.
a na: ['stavka'] uradi: {
	<- svoj lst.
}.
a item: (
	Lista novi ; 1 ; (
		Lista novi ; ['a'] ; (
			Lista novi ; ( Trenutak novi: 1 )
		) ; ( Int64 iz-teksta: ['321'] )
	)
).
Izlaz piši: a stavka, novi-red.
>> stara-adresa-lst := a stavka prototip memorijska-adresa.
a save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== PONOVNO UČITAVANJE SNIMKA:'], novi-red.
>> b := Objekat load-from: ['/tmp/a.bin'].
(b stavka prototip memorijska-adresa = stara-adresa-lst) tačno: {
	Izlaz piši: ['Veza objekta ponovo povezana.'], novi-red.
}.
Izlaz piši: ( b stavka ), novi-red.
