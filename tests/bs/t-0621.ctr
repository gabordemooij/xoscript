>> phrases := Lista novi
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases svaki: { :_ :phrase 
	>> e := Server base64-kodiraj: phrase.
	>> d := Server base64-dekodiraj: e.
	Izlaz piši: (
		message kopiraj ~encoded: e, ~decoded: d
	), novi-red.
}.
