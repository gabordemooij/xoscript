>> fraze := Lista novi
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> poruka := ['Phrase: ~decoded base64: ~encoded'].
	
fraze svaki: { :_ :fraza 
	>> e := Server base64-kodiraj: fraza.
	>> d := Server base64-dekodiraj: e.
	Izlaz piši: (
		poruka kopiraj ~encoded: e, ~decoded: d
	), novi-red.
}.
