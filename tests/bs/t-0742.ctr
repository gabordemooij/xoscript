Izlaz piši: ['Testni objekat'], novi-red.
>> a := Objekat novi. 

a na: ['item:'] uradi: { :hekspomoćnik
	svoj hekspomoćnik := hekspomoćnik. 
}.

a na: ['stavka'] uradi: {
	<- svoj hekspomoćnik.
}.

a item: Hx novi.

>> stara-adresa-hekspomoćnika := a stavka prototip memorijska-adresa.
a save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== PONOVNO UČITAVANJE SNIMKA:'], novi-red.

>> b := Objekat load-from: ['/tmp/a.bin'].

(b stavka prototip memorijska-adresa = stara-adresa-hekspomoćnika) tačno: {
	Izlaz piši: ['Veza objekta ponovo povezana.'], novi-red.
}.
