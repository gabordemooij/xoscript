# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Uzorak novi: pattern.
	p podudaranje: subject uradi: { :m :g
		Izlaz piši: g broj-elemenata, piši: [' '], piši: (g spoji: ['|']), novi-red. <- m.
	}.
}.
show primijeni: ['(a)|(b)'] i: ['b'].
show primijeni: ['(a)|(b)'] i: ['a'].
show primijeni: ['(x)?y'] i: ['y'].
show primijeni: ['(x)?(y)(z)?'] i: ['xy'].
