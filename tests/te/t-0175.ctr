

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> x := 100.

ప్రోగ్రామ్ మెమరీ-నిర్వహణ: 0.

{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt చివర-చేర్చు: ['!!'].
అవుట్-పుట్ రాయి: txt.
} నడుపు.

ప్రోగ్రామ్ శుభ్రం.

usedMemory1 := (ప్రోగ్రామ్ మెమరీ ? 0).


{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt చివర-చేర్చు: ['!!'].
అవుట్-పుట్ రాయి: txt.
} నడుపు.

ప్రోగ్రామ్ శుభ్రం.
usedMemory2 := (ప్రోగ్రామ్ మెమరీ ? 0).


{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt చివర-చేర్చు: ['!!'].
అవుట్-పుట్ రాయి: txt.
