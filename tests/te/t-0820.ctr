# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := ప్యాటర్న్ కొత్త: pattern.
	p సరిపోలిక: subject చేయి: { :m :g
		అవుట్-పుట్ రాయి: g లెక్క, రాయి: [' '], రాయి: (g కలుపు: ['|']), కొత్త-పంక్తి. <- m.
	}.
}.
show వర్తింపజేయి: ['(a)|(b)'] మరియు: ['b'].
show వర్తింపజేయి: ['(a)|(b)'] మరియు: ['a'].
show వర్తింపజేయి: ['(x)?y'] మరియు: ['y'].
show వర్తింపజేయి: ['(x)?(y)(z)?'] మరియు: ['xy'].
