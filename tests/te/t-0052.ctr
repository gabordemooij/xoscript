>> items := నిఘంటువు కొత్త.
items ఉంచు: ['green'] కీ: ['color-1'].
items ఉంచు: ['orange'] కీ: ['color-2'].
items ఉంచు: ['red'] కీ: ['color-3'].
>> i := 0.
>> s := [''].
items ప్రతి: { :key :color
	అవుట్-పుట్ రాయి: ['color #'] + i + [' is: '] + color + [' '].
	i కూడు: 1.
}.
అవుట్-పుట్ రాయి: i + [' colors!'].
