# backslashes must survive code serialization, strings must not end early
>> విలువలు := వరుస కొత్త
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

విలువలు ప్రతి: { :i :value
	>> d := నిఘంటువు కొత్త.
	d ఉంచు: value కీ: ['k'].
	>> r := d కోడ్ వస్తువుగా.
	అవుట్-పుట్ రాయి: r లెక్క, కొత్త-పంక్తి.
	అవుట్-పుట్ రాయి: ( (r వద్ద: ['k']) = value ), కొత్త-పంక్తి.
}.
