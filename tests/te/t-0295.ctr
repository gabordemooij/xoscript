
>> dictionary := (
	నిఘంటువు కొత్త
		ఉంచు: ['b'] కీ: ['a'],
		ఉంచు: ['a'] కీ: ['b'],
		ఉంచు: ['z'] కీ: ['x'],
		ఉంచు: ['hello'] కీ: ['hallo'],
		ఉంచు: ['human'] కీ: ['human']
).

>> comparisons := వరుస కొత్త.
dictionary ప్రతి: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a పోల్చు: b)
	).
}.

comparisons క్రమపరచు: { :a :b <- ( a పోల్చు: b ). }.
అవుట్-పుట్ రాయి: ( comparisons కలుపు: ['↵'] ), కొత్త-పంక్తి.
comparisons కలుపు: ['↵'].
