>> randomizer := { :a :b
	>> కనిష్ఠం := ( a < b ) ఇది: a లేకుంటే: b.
	>> గరిష్ఠం := ( a > b ) ఇది: a లేకుంటే: b.
	>> x := శూన్యం.
	{
		x := సంఖ్య మధ్య: a నుండి: b.
		((x < కనిష్ఠం) లేదా: (x > గరిష్ఠం)) నిజమైతే: { 
			అవుట్-పుట్ రాయి: (['Invalid value!']).
			ప్రోగ్రామ్ ముగించు.
		}.
	} 
	× 100. <- x.
}.
