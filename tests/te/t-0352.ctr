సంఖ్య అందినప్పుడు: ['roman'] చేయి: {
	>> సంఖ్యగా := తాను నకలు.
	>> roman := [''].
	{
		{
			(సంఖ్యగా ≥ 1000) నిజమైతే: {
				roman చివర-చేర్చు: ['Ⅿ'].
				సంఖ్యగా తీసివేయి: 1000.
			}, ఆపు.
		
			(సంఖ్యగా ≥ 500) నిజమైతే: {
				roman చివర-చేర్చు: ['Ⅾ'].
				సంఖ్యగా తీసివేయి: 500.
			}, ఆపు.
		
			(సంఖ్యగా ≥ 100) నిజమైతే: {
				roman చివర-చేర్చు: ['Ⅽ'].
				సంఖ్యగా తీసివేయి: 100.
			}, ఆపు.
		
			(సంఖ్యగా ≥ 50) నిజమైతే: {
				roman చివర-చేర్చు: ['Ⅼ'].
				సంఖ్యగా తీసివేయి: 50.
			}, ఆపు.
		
			(సంఖ్యగా ≥ 50) నిజమైతే: {
				roman చివర-చేర్చు: ['Ⅼ'].
				సంఖ్యగా తీసివేయి: 50.
			}, ఆపు.
		
			(సంఖ్యగా ≥ 10) నిజమైతే: {
				roman చివర-చేర్చు: ['Ⅹ'].
				సంఖ్యగా తీసివేయి: 10.
			}, ఆపు.
			
			(సంఖ్యగా ≥ 9) నిజమైతే: {
				roman చివర-చేర్చు: ['Ⅸ'].
				సంఖ్యగా తీసివేయి: 9.
			}, ఆపు.
			
			(సంఖ్యగా ≥ 5) నిజమైతే: {
				roman చివర-చేర్చు: ['Ⅴ'].
				సంఖ్యగా తీసివేయి: 5.
			}, ఆపు.
			
			(సంఖ్యగా ≥ 4) నిజమైతే: {
				roman చివర-చేర్చు: ['Ⅳ'].
				సంఖ్యగా తీసివేయి: 4.
			}, ఆపు.
			
			(సంఖ్యగా ≥ 1) నిజమైతే: {
				roman చివర-చేర్చు: ['Ⅰ'].
				సంఖ్యగా తీసివేయి: 1.
			}, ఆపు.
		} విధానం.
	} వరకు: { <- సంఖ్యగా > 0. }. <- roman.
}.

అవుట్-పుట్ రాయి: 1 roman, కొత్త-పంక్తి.
