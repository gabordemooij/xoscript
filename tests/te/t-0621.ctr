>> phrases := వరుస కొత్త
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases ప్రతి: { :_ :phrase 
	>> e := Server base64-ఎన్-కోడ్: phrase.
	>> d := Server base64-డీకోడ్: e.
	అవుట్-పుట్ రాయి: (
		message నకలు ~encoded: e, ~decoded: d
	), కొత్త-పంక్తి.
}.
