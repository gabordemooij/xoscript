


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

ప్రోగ్రామ్ మెమరీ-నిర్వహణ: 0.
>> palette := శూన్యం.
>> colors := శూన్యం.

{
palette := నిఘంటువు కొత్త.
palette 
	ఉంచు: ['#F00'] కీ: ['red'],
	ఉంచు: ['#0F0'] కీ: ['green'],
	ఉంచు: ['#00F'] కీ: ['blue'].
అవుట్-పుట్ రాయి: ['number of RGB codes in palette: '] + ( palette లెక్క ), కొత్త-పంక్తి.
అవుట్-పుట్ రాయి: ['RGB code of green is: '] + ( palette ? ['green'] ), కొత్త-పంక్తి.
colors := [''].
( palette ప్రతి: { :పేరు :కోడ్
		colors := colors + ( పేరు + [':'] + కోడ్ ).
} ).
అవుట్-పుట్ రాయి: ['All colors in palette: '] + colors, కొత్త-పంక్తి.
} నడుపు.
ప్రోగ్రామ్ శుభ్రం.
usedMemory1 := (ప్రోగ్రామ్ మెమరీ ? 0).

{
palette := నిఘంటువు కొత్త.
palette 
	ఉంచు: ['#F00'] కీ: ['red'],
	ఉంచు: ['#0F0'] కీ: ['green'],
	ఉంచు: ['#00F'] కీ: ['blue'].
