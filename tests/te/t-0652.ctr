# test number -> string -> number
{

	>> x := సంఖ్య మధ్య: 0 నుండి: 1000000.
	>> d := సంఖ్య మధ్య: 1 నుండి: 7.
	>> e := 10 ఘాతం: d.

	x భాగించు: e.
	>> y := x పాఠ్యంగా సంఖ్యగా.

	(x = y) అబద్ధమైతే: {
		అవుట్-పుట్ రాయి: x, కొత్త-పంక్తి.
		అవుట్-పుట్ రాయి: y, కొత్త-పంక్తి.
		ప్రోగ్రామ్ ముగించు.
	}.

} * 1000.
అవుట్-పుట్ రాయి: ['OK'], కొత్త-పంక్తి.