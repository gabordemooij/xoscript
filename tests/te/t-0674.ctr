# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> ఫైల్-మార్గం := ['/tmp/dat.csv'].
>> csv := ఫైల్ కొత్త: ఫైల్-మార్గం.
csv రాయి: s.

# accepts CRLF LF CR, varying row length
csv విభాజకం: [';'] ఉల్లేఖనం: ['"'] పంక్తులు: { :line
	ప్రోగ్రామ్ శుభ్రం.
	అవుట్-పుట్ రాయి: line, కొత్త-పంక్తి.
	ప్రోగ్రామ్ శుభ్రం.
}.

# unequal lines
s చివర-చేర్చు: ['\njustone'].
csv రాయి: s.
{
	csv విభాజకం: [';'] ఉల్లేఖనం: ['"'] పంక్తులు: { :line
		అవుట్-పుట్ రాయి: line, కొత్త-పంక్తి.
	}.
} పట్టుకో: { :e 
	అవుట్-పుట్ రాయి: e, కొత్త-పంక్తి.
}, నడుపు.

# invalid format
s := ['"he"llo";world'].
csv రాయి: s.
{
	csv విభాజకం: [';'] ఉల్లేఖనం: ['"'] పంక్తులు: { :line
		అవుట్-పుట్ రాయి: line, కొత్త-పంక్తి.
	}.
} పట్టుకో: { :e 
	అవుట్-పుట్ రాయి: e, కొత్త-పంక్తి.
}, నడుపు.
