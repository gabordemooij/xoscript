{
	ఈ-పని లోపం: ['Dont fail.'].
	unknown doSomething.
} పట్టుకో: {
	అవుట్-పుట్ రాయి: ['Caught!'].
}, నడుపు.

{
	ఈ-పని లోపం: ['Dont fail.'].
	తన unknown doSomething.
} పట్టుకో: {
	అవుట్-పుట్ రాయి: ['Caught!'].
}, నడుపు.

{
	ఈ-పని లోపం: ['Dont fail.'].
	unknown := 122.
} పట్టుకో: {
	అవుట్-పుట్ రాయి: ['Caught!'].
}, నడుపు.


{
	ఈ-పని లోపం: ['Dont fail.'].
	నిజం ఆపు.
	అవుట్-పుట్ రాయి: ['FAIL'].
} పట్టుకో: {
	అవుట్-పుట్ రాయి: ['Caught!'].
}, నడుపు.

{
	{
		ఈ-పని లోపం: ['Dont fail.'].
		నిజం ఆపు.
		అవుట్-పుట్ రాయి: ['FAIL'].
	} పట్టుకో: { :x
		(x = ['Dont fail.']) నిజమైతే: { ఈ-పని లోపం: ['Nested Caught!']. }.
	}, నడుపు.
} పట్టుకో: { :e
	అవుట్-పుట్ రాయి: e.
}, నడుపు.
