#Linux
>> OS := ప్రోగ్రామ్ వ్యవస్థ: (ఆదేశం uname -s), కత్తిరించు.

>> Slurp := వస్తువు కొత్త.
Slurp అందినప్పుడు: ['కొత్త'] చేయి: {
	తన str := [''].
}.
Slurp అందినప్పుడు: ['జవాబు:'] చేయి: { :blah
		(తన str ≠ ['']) నిజమైతే: {
			తన str చివర-చేర్చు: [' '].
		}.
		తన str చివర-చేర్చు: blah.
}.
Slurp అందినప్పుడు: ['జవాబు:మరియు:'] చేయి: { :blah :blahah
		(తన str ≠ ['']) నిజమైతే: {
			తన str చివర-చేర్చు: [' '].
		}.
		(blah పొడవు > 1) నిజమైతే: {
			తన str చివర-చేర్చు: (blah మొదలు: 0 పొడవు: (blah పొడవు - 1)).
		}, లేకపోతే: {
			తన str చివర-చేర్చు: blah.
		}.
		తన str చివర-చేర్చు: [' '].
		తన str చివర-చేర్చు: blahah.
}.
Slurp అందినప్పుడు: ['obtain'] చేయి: {
	>> buffer := తన str.
	తన str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text చివర-చేర్చు: ['hello'].
} × 1000.


అవుట్-పుట్ రాయి: (
	ప్రోగ్రామ్ వ్యవస్థ: (
		Slurp కొత్త
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

