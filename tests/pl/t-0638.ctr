
Server init.
>> żd := Żądanie-HTTP nowy.
Wyjście pisz: ['HTTP-GET d[]=']  + ( żd get-lista: ['d[]'] ), nowa-linia. # GET
Wyjście pisz: ['HTTP-GET f[]=']  + ( żd get-lista: ['f[]'] ), nowa-linia. # GET
Wyjście pisz: ['HTTP-POST e[]='] + ( żd post-lista: ['e[]'] ), nowa-linia. # GET
Wyjście pisz: ['HTTP-POST c=']   + ( żd post: ['c'] ), nowa-linia. # GET
Wyjście pisz: ['HTTP-POST xx=']  + ( żd post: ['xx'] ), nowa-linia. # GET
