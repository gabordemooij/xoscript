
Server init.
>> rq := Żądanie-HTTP nowy.
Wyjście pisz: ['HTTP-GET d[]=']  + ( rq get-lista: ['d[]'] ), nowa-linia. # GET
Wyjście pisz: ['HTTP-GET f[]=']  + ( rq get-lista: ['f[]'] ), nowa-linia. # GET
Wyjście pisz: ['HTTP-POST e[]='] + ( rq post-lista: ['e[]'] ), nowa-linia. # GET
Wyjście pisz: ['HTTP-POST c=']   + ( rq post: ['c'] ), nowa-linia. # GET
Wyjście pisz: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), nowa-linia. # GET
