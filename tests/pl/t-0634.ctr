# Program shell-escape tworzy kanoniczną składnię powłoki posix
# zgodne z: bash/dash, zsh, ksh

>> c := Program shell-escape: ['abc'].
Wyjście pisz: c, nowa-linia.
Wyjście pisz: ( Program system: ['echo '] + c ), nowa-linia.

c := Program shell-escape: ['a'b'c'].
Wyjście pisz: c, nowa-linia.
Wyjście pisz: ( Program system: ['echo '] + c ), nowa-linia.

c := Program shell-escape: ['a\'c'].
Wyjście pisz: c, nowa-linia.
Wyjście pisz: ( Program system: ['echo '] + c ), nowa-linia.