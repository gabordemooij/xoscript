['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Wyjście pisz: (x + y), nowa-linia.

>> x := 10040.07.
>> y := 10305.60.

Wyjście pisz: (x + y), nowa-linia.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Wyjście pisz: (x + y + z), nowa-linia.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Wyjście pisz: (x + y + z), nowa-linia.

>> q := 0.1.2.

Wyjście pisz: (q), nowa-linia.

>> q := 012.

Wyjście pisz: (q), nowa-linia.
