# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB nowy host: ['localhost'],
	użytkownik: ['xo'],
	hasło: ['pass123'],
	nazwa-bazy: ['xobase'],
	połącz.

>> parametry-wyszukiwania := db zapytanie: ['SELECT %% FROM'].
{ parametry-wyszukiwania wykonaj. } przechwyć: { :e
	Wyjście pisz: ( e zawiera: ['%%'] ), nowa-linia.
}, uruchom.
