Server init.
>> a := Blob nowy: 4.
a bytes: ( Lista nowy ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob nowy: 4.
b bytes: ( Lista nowy ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
# dziedziczony Blob nie dostaje bufora, więc jest bezużyteczny
# przejdzie ctr_accept(), ale ponieważ wskaźnik bufora == null, zwr
>> c := a nowy.
{ 
>> n := a ^ c.
Wyjście pisz: ['xorred:'], nowa-linia. 
Wyjście pisz: n, nowa-linia. 
} przechwyć: { :e Wyjście pisz: e, nowa-linia. }, uruchom.
a zwolnij.
b zwolnij.
