Wyjście pisz: ['Test object'], nowa-linia.
>> greeter := Obiekt nowy.
greeter na: ['name:'] wykonaj: { :nazwa
	własny xname := nazwa. 
}.
greeter na: ['greet'] wykonaj: {
	Wyjście pisz: ['Hello '] + własny xname, nowa-linia.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Wyjście pisz: ['========== RELOADING SNAP:'], nowa-linia.
>> b := Obiekt load-from: ['/tmp/a.bin'].
>> c := Obiekt load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
