Wyjście pisz: ['Obiekt testowy'], nowa-linia.
>> powitacz := Obiekt nowy.
powitacz na: ['name:'] wykonaj: { :nazwa
	własny ximię := nazwa. 
}.
powitacz na: ['przywitaj'] wykonaj: {
	Wyjście pisz: ['Witaj '] + własny ximię, nowa-linia.
}.
powitacz name: ['Sherlock'].
powitacz save-as: ['/tmp/a.bin'].
powitacz save-as: ['/tmp/b.bin'].
Wyjście pisz: ['========== PONOWNE WCZYTYWANIE SNAP:'], nowa-linia.
>> b := Obiekt load-from: ['/tmp/a.bin'].
>> c := Obiekt load-from: ['/tmp/b.bin'].
b przywitaj.
b name: ['Watson'], przywitaj.
c name: ['Moriarty'], przywitaj.
