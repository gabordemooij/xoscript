Wyjście pisz: ['Obiekt testowy'], nowa-linia.
>> a := Obiekt nowy. 

a na: ['item:'] wykonaj: { :pomocnikoct
	własny pomocnikoct := pomocnikoct. 
}.

a na: ['przedmiot'] wykonaj: {
	<- własny pomocnikoct.
}.

a item: Oct nowy.

>> stary-adres-pomocnikoct := a przedmiot prototyp adres-pamięci.
a save-as: ['/tmp/a.bin'].
Wyjście pisz: ['========== PONOWNE WCZYTYWANIE SNAP:'], nowa-linia.

>> b := Obiekt load-from: ['/tmp/a.bin'].

(b przedmiot prototyp adres-pamięci = stary-adres-pomocnikoct) prawda: {
	Wyjście pisz: ['Łącze obiektu ponownie dołączone.'], nowa-linia.
}.
