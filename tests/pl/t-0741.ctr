Wyjście pisz: ['Test object'], nowa-linia.
>> a := Obiekt nowy. 

a na: ['item:'] wykonaj: { :octhelper
	własny octhelper := octhelper. 
}.

a na: ['item'] wykonaj: { <- własny octhelper.
}.

a item: Oct nowy.

>> old-octhelper-address := a item prototyp adres-pamięci.
a save-as: ['/tmp/a.bin'].
Wyjście pisz: ['========== RELOADING SNAP:'], nowa-linia.

>> b := Obiekt load-from: ['/tmp/a.bin'].

(b item prototyp adres-pamięci = old-octhelper-address) prawda: {
	Wyjście pisz: ['Object link re-attached.'], nowa-linia.
}.
