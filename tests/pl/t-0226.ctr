# Test wariantów ASCII

# Liczby

Wyjście pisz: (2 !=: 3), nowa-linia.
Wyjście pisz: (2 <=: 2), nowa-linia.
Wyjście pisz: (2 >=: 2), nowa-linia.

# Teksty

Wyjście pisz: (['b'] >=: ['a']), nowa-linia.
Wyjście pisz: (['b'] !=: ['a']), nowa-linia.
Wyjście pisz: (['b'] <=: ['c']), nowa-linia.

# Wartości logiczne

Wyjście pisz: (Prawda !=: Fałsz), nowa-linia.

# Obiekty

Wyjście pisz: (Obiekt nowy !=: Obiekt nowy), nowa-linia.

# symbol listy w ASCII <-:

Wyjście pisz: (Lista <<: 1, ; 2 ; 3) liczność = 3, nowa-linia.

