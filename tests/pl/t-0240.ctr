# test określeń

>> $ := Obiekt nowy.

$ na: ['odpowiedz:'] wykonaj: { :x
	
	>> operacja := x znak: 0.
	>> znakWaluty := x znak: 1.
	>> pieniądze := x przesunięcie: 2.
	
	>> kwota := 0.

	( operacja = ['+'] ) prawda: {
		( znakWaluty = ['£'] ) prawda: { kwota := 1.28 × pieniądze. }.
	}. <- kwota.
}.



>> x := $ +£20.

Wyjście pisz: x, nowa-linia.


>> Owoc := Obiekt nowy.

Owoc na: ['nowy'] wykonaj: {
	>> f := sam nowy.
	f apples: 0.
	f oranges: 0. <- f.
}.

Owoc na: ['apples:'] wykonaj: { :a własny jabłka := a. }.
Owoc na: ['oranges:'] wykonaj: { :p własny pomarańcze := p. }.
Owoc na: ['jabłka'] wykonaj: { <- własny jabłka. }.
Owoc na: ['pomarańcze'] wykonaj: { <- własny pomarańcze. }.

Owoc na: ['+'] wykonaj: { :f
	
	>> n := Owoc nowy.
	f dodaj: 1.
	
	n apples: (f jabłka + własny jabłka).
	n oranges:  (f pomarańcze  + własny pomarańcze). <- n.
}.

Owoc na: ['tekst'] wykonaj: { <- ( własny jabłka tekst + [' jabłek i '] + własny pomarańcze + [' pomarańczy'] ).
}.

Liczba na: ['jabłka'] wykonaj: { <- ((Owoc nowy) apples: sam).
}.

Liczba na: ['apple'] wykonaj: { <- ((Owoc nowy) apples: sam).
}.

Liczba na: ['pomarańcze'] wykonaj: { <- ((Owoc nowy) oranges: sam).
}.




Wyjście pisz: (1 apple + 3 pomarańcze + 4 jabłka), nowa-linia.


Tekst na: ['dwukrotnie'] wykonaj: { <- ((sam tekst) + (sam tekst)).
}.



Wyjście pisz: ['❤❤❤'] dwukrotnie.



