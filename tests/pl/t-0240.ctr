# test qualifiers

>> $ := Obiekt nowy.

$ na: ['odpowiedz:'] wykonaj: { :x
	
	>> operation := x znak: 0.
	>> valuta := x znak: 1.
	>> money := x przesunięcie: 2.
	
	>> amount := 0.

	( operation = ['+'] ) prawda: {
		( valuta = ['£'] ) prawda: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Wyjście pisz: x, nowa-linia.


>> Fruit := Obiekt nowy.

Fruit na: ['nowy'] wykonaj: {
	>> f := sam nowy.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit na: ['apples:'] wykonaj: { :a własny apples := a. }.
Fruit na: ['oranges:'] wykonaj: { :p własny oranges := p. }.
Fruit na: ['apples'] wykonaj: { <- własny apples. }.
Fruit na: ['oranges'] wykonaj: { <- własny oranges. }.

Fruit na: ['+'] wykonaj: { :f
	
	>> n := Fruit nowy.
	f dodaj: 1.
	
	n apples: (f apples + własny apples).
	n oranges:  (f oranges  + własny oranges). <- n.
}.

Fruit na: ['tekst'] wykonaj: { <- ( własny apples tekst + [' apples and '] + własny oranges + [' oranges'] ).
}.

Liczba na: ['apples'] wykonaj: { <- ((Fruit nowy) apples: sam).
}.

Liczba na: ['apple'] wykonaj: { <- ((Fruit nowy) apples: sam).
}.

Liczba na: ['oranges'] wykonaj: { <- ((Fruit nowy) oranges: sam).
}.




Wyjście pisz: (1 apple + 3 oranges + 4 apples), nowa-linia.


Tekst na: ['twice'] wykonaj: { <- ((sam tekst) + (sam tekst)).
}.



Wyjście pisz: ['❤❤❤'] twice.



