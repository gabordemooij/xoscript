Wyjście pisz: ['Test object'], nowa-linia.
>> a := Obiekt nowy. 
a na: ['item:'] wykonaj: { :int64
	własny int64 := int64. 
}.
a na: ['item'] wykonaj: { <- własny int64.
}.
a item: ( Int64 z-tekstu: ['9999'] ).
Wyjście pisz: a item, nowa-linia.
>> old-int64-address := a item prototyp adres-pamięci.
a save-as: ['/tmp/a.bin'].
Wyjście pisz: ['========== RELOADING SNAP:'], nowa-linia.
>> b := Obiekt load-from: ['/tmp/a.bin'].
(b item prototyp adres-pamięci = old-int64-address) prawda: {
	Wyjście pisz: ['Object link re-attached.'], nowa-linia.
}.
Wyjście pisz: ( b item ), nowa-linia.
