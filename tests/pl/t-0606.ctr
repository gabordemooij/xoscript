>> Point := Obiekt nowy.
Point na: ['x-coordinate:'] wykonaj: { :x własny x := x. }.
Point na: ['y-coordinate:'] wykonaj: { :y własny y := y. }.
Point na: ['x-coordinate']  wykonaj: { <- własny x kopiuj. }.
Point na: ['y-coordinate']  wykonaj: { <- własny y kopiuj. }.

Point na: ['='] wykonaj: { :other <- ( własny x = other x-coordinate
		 i: własny y = other y-coordinate ).
}.

>> pier := Point nowy x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point nowy x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point nowy x-coordinate: 5, y-coordinate: 6.

Wyjście pisz: pier = town-hall, nowa-linia.
Wyjście pisz: pier = restaurant, nowa-linia.
