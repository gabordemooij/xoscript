>> Punkt := Obiekt nowy.
Punkt na: ['x-coordinate:'] wykonaj: { :x własny x := x. }.
Punkt na: ['y-coordinate:'] wykonaj: { :y własny y := y. }.
Punkt na: ['współrzędna-x']  wykonaj: { <- własny x kopiuj. }.
Punkt na: ['współrzędna-y']  wykonaj: { <- własny y kopiuj. }.

Punkt na: ['='] wykonaj: { :inny
	<- ( własny x = inny współrzędna-x
		 i: własny y = inny współrzędna-y ).
}.

>> molo := Punkt nowy x-coordinate: 5, y-coordinate: 6.
>> ratusz := Punkt nowy x-coordinate: 7, y-coordinate: 1.
>> restauracja := Punkt nowy x-coordinate: 5, y-coordinate: 6.

Wyjście pisz: molo = ratusz, nowa-linia.
Wyjście pisz: molo = restauracja, nowa-linia.
