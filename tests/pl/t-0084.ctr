>> stwórzSumator := { :x
	>> f := { :y <- (własny x + y). } ustaw: ['x'] wartość: x. <- f.
}.
>> mapownik := { :tablica :fun
	>> odwzorowanie := { :i własny q umieść: (własny f zastosuj: (własny q ? i)) w: i. } 
	ustaw: ['q'] wartość: tablica,
	ustaw: ['f'] wartość: fun.
	{ :i odwzorowanie zastosuj: i. } × (tablica liczność).
}.

>> a := Lista ← 1; 2; 3.
mapownik zastosuj: a i: (stwórzSumator zastosuj: 100).
Wyjście pisz: (a pozycja: 0), nowa-linia.
Wyjście pisz: (a ? 1), nowa-linia.
Wyjście pisz: (a ? 2), nowa-linia.
