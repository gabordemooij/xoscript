>> makeAdder := { :x
	>> f := { :y <- (własny x + y). } ustaw: ['x'] wartość: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i własny q umieść: (własny f zastosuj: (własny q ? i)) w: i. } 
	ustaw: ['q'] wartość: array,
	ustaw: ['f'] wartość: func.
	{ :i mapping zastosuj: i. } × (array liczność).
}.

>> a := Lista ← 1; 2; 3.
mapper zastosuj: a i: (makeAdder zastosuj: 100).
Wyjście pisz: (a pozycja: 0), nowa-linia.
Wyjście pisz: (a ? 1), nowa-linia.
Wyjście pisz: (a ? 2), nowa-linia.
