>> t := Nic.

# you can control the time zone for
# parsing like this:
Moment strefa: ['CET'].
t := Moment z: ['1981-02-03 04:05:06'].
Wyjście pisz: t, nowa-linia.

# now using CEST time zone:
Moment strefa: ['CEST'].
t := Moment z: ['1981-02-03 04:05:06'].
Wyjście pisz: t, nowa-linia.

# error if string cannot be parsed
{ Moment z: ['1900']. } przechwyć: { Nic. }, uruchom.
