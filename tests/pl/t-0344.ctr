# catch-all test (practical)
>> HTML := Tekst nowy.
HTML na: ['encode:'] wykonaj: { :tekst
	sam dołącz: (tekst
	zamień: ['&'] na: ['&amp;'], 
	zamień: ['<'] na: ['&lt;'],
	zamień: ['>'] na: ['&gt;'],
	zamień: ['"'] na: ['&quot;']).
}.
>> blog := HTML nowy.
blog dołącz: ['<h1>'],
     encode: ['Koffie & Thee'],
     dołącz: ['</h1>'].
Wyjście pisz: blog, nowa-linia.


>> Roman := Liczba nowy.
Roman na: ['stringy'] wykonaj: {
	>> a := [''].
	{ a dołącz: ['I']. } × sam. <- a.
}.

>> x := Roman nowy.
x dodaj: 3.
Wyjście pisz: x stringy, nowa-linia.

>> Quantum := Logiczny nowy.
Quantum na: ['true?'] wykonaj: { <- ['maybe True']. }.
Wyjście pisz: (Quantum nowy true?), nowa-linia.

>> Nihil := Nic nowy.
Nihil na: ['tekst'] wykonaj: { <- ['Nihil']. }.
Wyjście pisz: (Nihil nowy), nowa-linia.
