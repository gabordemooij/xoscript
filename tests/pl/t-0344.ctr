# test obsługi wszystkich wiadomości (praktyczny)
>> HTML := Tekst nowy.
HTML na: ['encode:'] wykonaj: { :tekstHtml
	sam dołącz: (tekstHtml
	zamień: ['&'] na: ['&amp;'], 
	zamień: ['<'] na: ['&lt;'],
	zamień: ['>'] na: ['&gt;'],
	zamień: ['"'] na: ['&quot;']).
}.
>> blog := HTML nowy.
blog dołącz: ['<h1>'],
     encode: ['Koffie & Thee'],
     dołącz: ['</h1>'].
Wyjście pisz: blog, nowa-linia.


>> Rzymska := Liczba nowy.
Rzymska na: ['tekstowo'] wykonaj: {
	>> a := [''].
	{ a dołącz: ['I']. } × sam. <- a.
}.

>> x := Rzymska nowy.
x dodaj: 3.
Wyjście pisz: x tekstowo, nowa-linia.

>> Kwant := Logiczny nowy.
Kwant na: ['true?'] wykonaj: { <- ['może Prawda']. }.
Wyjście pisz: (Kwant nowy true?), nowa-linia.

>> Nihil := Nic nowy.
Nihil na: ['tekst'] wykonaj: { <- ['Nihil']. }.
Wyjście pisz: (Nihil nowy), nowa-linia.
