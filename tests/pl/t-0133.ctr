


>> Deck := Lista nowy.
Deck na: ['print'] wykonaj: {
        >> len := sam liczność - 1.
        { :i
                >> len2 := sam liczność - 1.
                Wyjście pisz: ['len: '].
                Wyjście pisz: len, nowa-linia.
                Wyjście pisz: ['len2: '].
                Wyjście pisz: len2, nowa-linia.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
