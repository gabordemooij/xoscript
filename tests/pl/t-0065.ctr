Liczba na: ['silnia'] wykonaj: {
	>> razem := 1.
	{ :indeks razem pomnóż-przez: (sam - (indeks)). } × sam. <- razem.
}.
>> Drukarka := Obiekt nowy.
Drukarka na: ['drukuj:i:'] wykonaj: { :x :y
	Wyjście pisz: ['a='] + x + [', b='] + y, nowa-linia.
}.
>> a := 4.5. >> b := a podłoga.
Drukarka drukuj: a i: b.
a := 4. b := a silnia.
Drukarka drukuj: a i: b.
a := 4.5. b := a sufit.
Drukarka drukuj: a i: b.
a := 4.5. b := a podłoga.
