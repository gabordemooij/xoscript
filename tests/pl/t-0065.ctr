Liczba na: ['factorial'] wykonaj: {
	>> total := 1.
	{ :index total pomnóż-przez: (sam - (index)). } × sam. <- total.
}.
>> Printer := Obiekt nowy.
Printer na: ['print:and:'] wykonaj: { :x :y
	Wyjście pisz: ['a='] + x + [', b='] + y, nowa-linia.
}.
>> a := 4.5. >> b := a podłoga.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a sufit.
Printer print: a and: b.
a := 4.5. b := a podłoga.
Printer print: a and: b.
a := 4.5. b := a zaokrąglij.
Printer print: a and: b.
a := 4.2. b := a zaokrąglij.
Printer print: a and: b.

