		sam
		zamień: ['&'] na: ['&amp;'],
		zamień: ['<'] na: ['&lt;'],
		zamień: ['>'] na: ['&gt;'],
		zamień: ['''] na: ['&apos;'],
		zamień: ['"'] na: ['&quot;']
