Tekst na: ['html'] wykonaj: { <- (
		sam
		zamień: ['&'] na: ['&amp;'],
		zamień: ['<'] na: ['&lt;'],
		zamień: ['>'] na: ['&gt;'],
		zamień: ['''] na: ['&apos;'],
		zamień: ['"'] na: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program zarządzanie-pamięcią: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Wyjście pisz: txt kopiuj html, nowa-linia.
Wyjście pisz: txt kopiuj małe-litery, nowa-linia.
Wyjście pisz: txt kopiuj duże-litery, nowa-linia.
} uruchom.

Program posprzątaj.

usedMemory1 := (Program pamięć ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Wyjście pisz: txt kopiuj html, nowa-linia.
Wyjście pisz: txt kopiuj małe-litery, nowa-linia.
Wyjście pisz: txt kopiuj duże-litery, nowa-linia.
} uruchom.

Program posprzątaj.
usedMemory2 := (Program pamięć ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Wyjście pisz: txt kopiuj html, nowa-linia.
Wyjście pisz: txt kopiuj małe-litery, nowa-linia.
Wyjście pisz: txt kopiuj duże-litery, nowa-linia.
} uruchom.

Program posprzątaj.
usedMemory3 := (Program pamięć ? 0).



( usedMemory1 = usedMemory2 i: usedMemory1 = usedMemory3, i: usedMemory2 = usedMemory3 ) prawda: {
	Wyjście pisz: ['No memory leaks here'].
}, fałsz: {
	Wyjście pisz: ['Leaking memory...'].
}.
