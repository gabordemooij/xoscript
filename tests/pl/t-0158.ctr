>> x := [' hallo '].

>> y := x duże-litery.
Wyjście pisz: x, nowa-linia.
Wyjście pisz: (x równe: y), nowa-linia.

>> y := x małe-litery.
Wyjście pisz: x, nowa-linia.
Wyjście pisz: (x równe: y), nowa-linia.

>> y := x przytnij.
Wyjście pisz: x, nowa-linia.
Wyjście pisz: (x równe: y), nowa-linia.

>> y := x przesunięcie: 1.
Wyjście pisz: x, nowa-linia.
Wyjście pisz: (x równe: y), nowa-linia.

>> y := x od: 1 długość: 2.
Wyjście pisz: x, nowa-linia.
Wyjście pisz: (x równe: y), nowa-linia.