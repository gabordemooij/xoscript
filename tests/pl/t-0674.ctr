# scenariusz pozytywny
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> ścieżka := ['/tmp/dat.csv'].
>> csv := Plik nowy: ścieżka.
csv pisz: s.

# akceptuje CRLF LF CR, różne długości wierszy
csv separator: [';'] cudzysłów: ['"'] wiersze: { :line
	Program posprzątaj.
	Wyjście pisz: line, nowa-linia.
	Program posprzątaj.
}.

# nierówne wiersze
s dołącz: ['\njustone'].
csv pisz: s.
{
	csv separator: [';'] cudzysłów: ['"'] wiersze: { :line
		Wyjście pisz: line, nowa-linia.
	}.
} przechwyć: { :e 
	Wyjście pisz: e, nowa-linia.
}, uruchom.

# niepoprawny format
s := ['"he"llo";world'].
csv pisz: s.
{
	csv separator: [';'] cudzysłów: ['"'] wiersze: { :line
		Wyjście pisz: line, nowa-linia.
	}.
} przechwyć: { :e 
	Wyjście pisz: e, nowa-linia.
}, uruchom.
