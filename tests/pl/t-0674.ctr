# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> ścieżka := ['/tmp/dat.csv'].
>> csv := Plik nowy: ścieżka.
csv pisz: s.

# accepts CRLF LF CR, varying row length
csv separator: [';'] cudzysłów: ['"'] wiersze: { :line
	Program posprzątaj.
	Wyjście pisz: line, nowa-linia.
	Program posprzątaj.
}.

# unequal lines
s dołącz: ['\njustone'].
csv pisz: s.
{
	csv separator: [';'] cudzysłów: ['"'] wiersze: { :line
		Wyjście pisz: line, nowa-linia.
	}.
} przechwyć: { :e 
	Wyjście pisz: e, nowa-linia.
}, uruchom.

# invalid format
s := ['"he"llo";world'].
csv pisz: s.
{
	csv separator: [';'] cudzysłów: ['"'] wiersze: { :line
		Wyjście pisz: line, nowa-linia.
	}.
} przechwyć: { :e 
	Wyjście pisz: e, nowa-linia.
}, uruchom.
