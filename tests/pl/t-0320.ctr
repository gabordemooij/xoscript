


>> CoffeeMachine := Obiekt nowy.
CoffeeMachine na: ['order:'] wykonaj: { :id
	>> coffee := ['Americano'].
	( id = 1 ) prawda: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) prawda: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) prawda: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Obiekt nowy.
SimpleCoffeeMachine na: ['order'] wykonaj: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Wyjście pisz: redCup, nowa-linia.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Wyjście pisz: greenCup, nowa-linia.
>> yellowCup := CoffeeMachine order: 1.
Wyjście pisz: yellowCup, nowa-linia.
>> blueCup := CoffeeMachine order: 0.
Wyjście pisz: blueCup, nowa-linia.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Wyjście pisz: blackCup, nowa-linia.
blackCup dołącz: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Wyjście pisz: orangeCup, nowa-linia.
