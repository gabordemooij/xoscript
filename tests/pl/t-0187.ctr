Liczba na: ['silnia'] wykonaj: {
	>> razem := 1.
	{ :indeks razem pomnóż-przez: (sam - indeks). } × sam. <- razem.
}.

>> użytaPamięć1 := 0.
>> użytaPamięć2 := 0.
>> użytaPamięć3 := 0.
>> użytaPamięć4 := 0.

Program zarządzanie-pamięcią: 0.

{
2 wykładnik silnia.
Wyjście pisz: (11 modulo: 3), nowa-linia.
Wyjście pisz: (3.4 zaokrąglij), nowa-linia.
Wyjście pisz: (7.1 sufit), nowa-linia.
Wyjście pisz: (7.9 podłoga), nowa-linia.
}
uruchom.

Program posprzątaj.

użytaPamięć1 := (Program pamięć ? 0).

{
