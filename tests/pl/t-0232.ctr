>> Slurp := Obiekt nowy.

Slurp na: ['nowy'] wykonaj: {
	własny str := [''].
}.

Slurp na: ['odpowiedz:'] wykonaj: { :blah
		(własny str = ['']) prawda: {
			własny str dołącz: blah.
		}, inaczej: {
			własny str dołącz: [' '].
			własny str dołącz: blah.
		}.
}.

Slurp na: ['odpowiedz:i:'] wykonaj: { :blah :blahah
		(blah długość > 1) prawda: {
			własny str dołącz: (blah od: 0 długość: (blah długość - 1)).
		}, inaczej: {
			własny str dołącz: blah.
		}.
		własny str dołącz: [' '].
		własny str dołącz: blahah.
}.

Slurp na: ['uzyskaj'] wykonaj: {
	>> bufor := własny str.
	własny str := ['']. <- bufor.
}.


>> x := Slurp nowy.
x + 3.
Wyjście pisz: (x uzyskaj), nowa-linia.
x echo: ['Witaj świecie'].
Wyjście pisz: (x uzyskaj), nowa-linia.
x tellme: 123 and: 987.
Wyjście pisz: (x uzyskaj), nowa-linia.
