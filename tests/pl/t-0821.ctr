# cudzysłów, który nigdy się nie zamyka, musi dać błąd, a nie nieskończoną pętlę
>> ścieżka := ['/tmp/test0821.csv'].
>> file := Plik nowy: ścieżka.

file pisz: ['a,b\n"1,2\n'].
{
	file separator: [','] cudzysłów: ['"'] wiersze: { :line
		Wyjście pisz: line, nowa-linia.
	}.
} przechwyć: { :e Wyjście pisz: e, nowa-linia. }, uruchom.

# zamknięty cudzysłów nadal działa
file pisz: ['a,b\n"1,2",3'].
file separator: [','] cudzysłów: ['"'] wiersze: { :line
	Wyjście pisz: line, nowa-linia.
}.
file usuń.
