#test ffi


Server init.

Program zarządzanie-pamięcią: 4.

# do tego testu musisz ustawić ścieżkę do libc (puts)
>> nazwaBiblioteki := Program ustawienie: ['FFITESTLIB'].



Server powiąż: (
 Lista nowy ;
 nazwaBiblioteki ;
 ['puts'] ;
 ( Lista nowy ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s zwolnij.

# test ze strukturą

>> a := Blob nowy: 8.
a bytes: (
	Lista <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struktura := Blob struct: (Lista <<: ['int'], ; ['int']).

Server powiąż: (
	Lista <<: ['@structtest'], ;
	['@structtest'] ;
	(Lista <<: struktura) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Wyjście pisz: ['Test sumy:'] + (ffitest ffisum: a), nowa-linia.

struktura zwolnij-struct.
struktura zwolnij.
a zwolnij.
