>> z := Obiekt nowy.
z na: ['value:'] wykonaj: { :v
	własny value := v. <- sam.
}.
z na: ['value'] wykonaj: { <- własny value. }.
(z setValue: 1) value: 2.
Wyjście pisz: z value.
>> x := z.
Wyjście pisz: x value.
z := Nic.
Wyjście pisz: z value.
Wyjście pisz: x value.
Wyjście pisz: ['hello'].
Wyjście pisz: 3 + 2.
Wyjście pisz: (3 > 2).
