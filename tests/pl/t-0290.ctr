# test operacji na listach


>> ciasta := Lista ←
	['apple'] ;
	['jagodowe'] ;
	['czekoladowe'] ;
	['serowe'].


>> kup := ciasta zamień: 1 długość: 2 na: ( Lista ← ['cynamonowe'] ; ['ananasowe'] ).
Wyjście pisz: (kup połącz: [',']), nowa-linia.


>> kup := ciasta zamień: 1 długość: 12 na: ( Lista ← ['cynamonowe'] ; ['ananasowe'] ).
Wyjście pisz: (kup połącz: [',']), nowa-linia.


>> kup := ciasta zamień: 2 długość: 10 na: ( Lista nowy ).
Wyjście pisz: (kup połącz: [',']), nowa-linia.


>> kup := ciasta zamień: 0 długość: 1 na: ( Lista nowy ).
Wyjście pisz: (kup połącz: [',']), nowa-linia.


>> kup := ciasta zamień: ['0'] długość: ['1'] na: ['x'].
Wyjście pisz: (kup połącz: [',']), nowa-linia.
