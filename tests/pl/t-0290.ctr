# test list operations


>> cakes := Lista ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes zamień: 1 długość: 2 na: ( Lista ← ['cinnamon'] ; ['pineapple'] ).
Wyjście pisz: (buy połącz: [',']), nowa-linia.


>> buy := cakes zamień: 1 długość: 12 na: ( Lista ← ['cinnamon'] ; ['pineapple'] ).
Wyjście pisz: (buy połącz: [',']), nowa-linia.


>> buy := cakes zamień: 2 długość: 10 na: ( Lista nowy ).
Wyjście pisz: (buy połącz: [',']), nowa-linia.


>> buy := cakes zamień: 0 długość: 1 na: ( Lista nowy ).
Wyjście pisz: (buy połącz: [',']), nowa-linia.


>> buy := cakes zamień: ['0'] długość: ['1'] na: ['x'].
Wyjście pisz: (buy połącz: [',']), nowa-linia.
