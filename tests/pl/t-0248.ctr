

Tekst na: ['oblicz'] wykonaj: {
	>> code := Plik nowy: ['/tmp/eval.ctr'].
	code pisz: sam tekst + ['.'].
	Program użyj: ['/tmp/eval.ctr'].
}.

>> a := (Lista ← (
	(Słownik nowy)
		umieść: ['domena'] w: ['mywebsite.com'],
		umieść: (Lista ←
			((Słownik nowy)
				umieść: ['strona główna'] w: ['title'],
				umieść: ['<html></html>'] w: ['body'],
				umieść: ['2017-01-01'] w: ['utworzono']
			) ;
			((Słownik nowy)
				umieść: ['o nas(c)'] w: ['title'],
				umieść: ['<credits>Author Inc.</credits>'] w: ['body']
			)
		) w: ['strony']
	)
) tekst.

Wyjście pisz: a typ, nowa-linia.
Wyjście pisz: a, nowa-linia.

>> b := Nic.
(['b := '] + a) oblicz.
Wyjście pisz: b ? 0 ? ['strony'] ? 1 ? ['body'], nowa-linia.

>> c := b ? 0.
>> d := c tekst.
Wyjście pisz: d typ, nowa-linia.

>> e := Nic.
(['e := '] + d) oblicz.
Wyjście pisz: e ? ['strony'] ? 0, nowa-linia.
