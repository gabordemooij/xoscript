

Tekst na: ['evaluate'] wykonaj: {
	>> code := Plik nowy: ['/tmp/eval.ctr'].
	code pisz: sam tekst + ['.'].
	Program użyj: ['/tmp/eval.ctr'].
}.

>> a := (Lista ← (
	(Słownik nowy)
		umieść: ['domain'] w: ['mywebsite.com'],
		umieść: (Lista ←
			((Słownik nowy)
				umieść: ['home'] w: ['title'],
				umieść: ['<html></html>'] w: ['body'],
				umieść: ['2017-01-01'] w: ['created']
			) ;
			((Słownik nowy)
				umieść: ['aboutus(c)'] w: ['title'],
				umieść: ['<credits>Author Inc.</credits>'] w: ['body']
			)
		) w: ['pages']
	)
) tekst.

Wyjście pisz: a typ, nowa-linia.
Wyjście pisz: a, nowa-linia.

>> b := Nic.
(['b := '] + a) evaluate.
Wyjście pisz: b ? 0 ? ['pages'] ? 1 ? ['body'], nowa-linia.

>> c := b ? 0.
>> d := c tekst.
Wyjście pisz: d typ, nowa-linia.

>> e := Nic.
(['e := '] + d) evaluate.
Wyjście pisz: e ? ['pages'] ? 0, nowa-linia.
