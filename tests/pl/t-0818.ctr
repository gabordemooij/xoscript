# edge cases from a request must give an error or a result, not a crash
Server init.

Wyjście pisz: ['<'] + (['abc'] od: 0 długość: 0, duże-litery) + ['>'], nowa-linia.
Wyjście pisz: ['<'] + (['abc'] od: 0 długość: 0, małe-litery) + ['>'], nowa-linia.
Wyjście pisz: ['<'] + (['abc'] przesunięcie: 3, duże-litery) + ['>'], nowa-linia.
Wyjście pisz: [''] duże-litery bytes, nowa-linia.
Wyjście pisz: ['aB'] duże-litery, nowa-linia.
Wyjście pisz: ['aB'] małe-litery, nowa-linia.

Wyjście pisz: (Moment nowy: 0) rok, nowa-linia.
{ Moment nowy: ['9e300'] liczba. } przechwyć: { :e Wyjście pisz: e, nowa-linia. }, uruchom.
{ Moment nowy: ['-9e300'] liczba. } przechwyć: { :e Wyjście pisz: e, nowa-linia. }, uruchom.
{ Moment nowy: ['nan'] liczba. } przechwyć: { :e Wyjście pisz: e, nowa-linia. }, uruchom.
{ Moment nowy: 9000000000000000000. } przechwyć: { :e Wyjście pisz: e, nowa-linia. }, uruchom.
