# klucze i podpisy Sejf, które po dekodowaniu są za długie, nie mogą przepełnić stosu
Server init.

>> klucze := Sejf generuj-klucze.
>> kt := klucze pierwszy.
>> kp := klucze ostatni.
>> podp := Sejf podpisz: ['abc'] kluczem: kt.

# 88 znaków bez dopełnienia dekoduje się do 66 bajtów
>> długi := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 znaki bez dopełnienia dekodują się do 33 bajtów
>> krótki := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Sejf podpisz: ['abc'] kluczem: długi. } przechwyć: { :e
	Wyjście pisz: e, nowa-linia.
}, uruchom.

{ Sejf sprawdź: ['abc'] podpis: długi kluczem: kp. } przechwyć: { :e
	Wyjście pisz: e, nowa-linia.
}, uruchom.

{ Sejf sprawdź: ['abc'] podpis: podp kluczem: krótki. } przechwyć: { :e
	Wyjście pisz: e, nowa-linia.
}, uruchom.
