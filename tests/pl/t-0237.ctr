
Tekst na: ['oblicz'] wykonaj: {
	>> code := Plik nowy: ['/tmp/eval.ctr'].
	code pisz: (sam tekst + ['.']).
	Program użyj: ['/tmp/eval.ctr'].
}.

>> map :=
	(Słownik nowy)
	umieść: ['Cześć Wam'] w: ['two'],
	umieść: (Lista ← ['hello'] ; ['world'] ; (Lista ← 1 ; 2; 9) ; Fałsz) w: ['jeden'],
	umieść: ( (Słownik nowy) umieść: ['śfiat'] w: ['literówka'] ) w: ['three'],
	umieść: (Lista ← ((Słownik nowy) umieść: ['skarb'] w: ['ukryty']) ; 2) w: ['cztery']. 
>> str := map tekst.
>> map2 := Nic.
(['map2 := '] + str ) oblicz.
Wyjście pisz: map2 ? ['jeden'] ? 0.
Wyjście pisz: map2 ? ['jeden'] ? 1.
Wyjście pisz: map2 ? ['cztery'] ? 0 ? ['ukryty'].
Wyjście pisz: map2 ? ['jeden'] ? 2 ? 2.
