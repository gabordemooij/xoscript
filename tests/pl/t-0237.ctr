
Tekst na: ['evaluate'] wykonaj: {
	>> code := Plik nowy: ['/tmp/eval.ctr'].
	code pisz: (sam tekst + ['.']).
	Program użyj: ['/tmp/eval.ctr'].
}.

>> map :=
	(Słownik nowy)
	umieść: ['Hi There'] w: ['two'],
	umieść: (Lista ← ['hello'] ; ['world'] ; (Lista ← 1 ; 2; 9) ; Fałsz) w: ['one'],
	umieść: ( (Słownik nowy) umieść: ['wrrld'] w: ['misspelled'] ) w: ['three'],
	umieść: (Lista ← ((Słownik nowy) umieść: ['treasure'] w: ['hidden']) ; 2) w: ['four']. 
>> str := map tekst.
>> map2 := Nic.
(['map2 := '] + str ) evaluate.
Wyjście pisz: map2 ? ['one'] ? 0.
Wyjście pisz: map2 ? ['one'] ? 1.
Wyjście pisz: map2 ? ['four'] ? 0 ? ['hidden'].
Wyjście pisz: map2 ? ['one'] ? 2 ? 2.
