Server init.

Wyjście pisz: (
	Wzorzec nowy: ['^\\w+$'],
	dopasuj: ['test@example.com'] 
), nowa-linia. # 0 match, fails on @ and .

Wyjście pisz: (
	Wzorzec nowy: ['^[^@]+@[^\.]+\.\\w+$'],
	dopasuj: ['test@example.com'] 
), nowa-linia. # 1 match

Wyjście pisz: (
	Wzorzec nowy: ['[^@]+@[^\.]+\.\\w+'],
	dopasuj: ['test@example.com'] 
), nowa-linia. # 1 match

Wyjście pisz: (
	Wzorzec nowy: ['([^@]+)@([^\.]+)\.\\w+'],
	dopasuj: ['test@example.com'] 
), nowa-linia. # 1 match, groups dont matter

Wyjście pisz: (
	Wzorzec nowy: ['[a-z]'],
	dopasuj: ['test@example.com'] 
), nowa-linia. # 14 matches

Wyjście pisz: (
	Wzorzec nowy: ['.*'],
	dopasuj: ['test@example.com'] 
), nowa-linia. # 1 match (all)

Wyjście pisz: (
	Wzorzec nowy: ['(.*)'],
	dopasuj: ['test@example.com'] 
), nowa-linia. # 1 match (all)

Wyjście pisz: (
	Wzorzec nowy: ['\\s*[^@]+@[^\.]+\.\\w+'],
	dopasuj: ['test@example.com'] 
), nowa-linia. # 1 match, prefix space optional, gets ignored