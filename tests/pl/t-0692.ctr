Server init.

Wyjście pisz: (
	Wzorzec nowy: ['^\\w+$'],
	dopasuj: ['test@example.com'] 
), nowa-linia. # 0 dopasowań, nie przechodzi na @ i .

Wyjście pisz: (
	Wzorzec nowy: ['^[^@]+@[^\.]+\.\\w+$'],
	dopasuj: ['test@example.com'] 
), nowa-linia. # 1 dopasowanie

Wyjście pisz: (
	Wzorzec nowy: ['[^@]+@[^\.]+\.\\w+'],
	dopasuj: ['test@example.com'] 
), nowa-linia. # 1 dopasowanie

Wyjście pisz: (
	Wzorzec nowy: ['([^@]+)@([^\.]+)\.\\w+'],
	dopasuj: ['test@example.com'] 
), nowa-linia. # 1 dopasowanie, grupy nie mają znaczenia

Wyjście pisz: (
	Wzorzec nowy: ['[a-z]'],
	dopasuj: ['test@example.com'] 
), nowa-linia. # 14 dopasowań

Wyjście pisz: (
	Wzorzec nowy: ['.*'],
	dopasuj: ['test@example.com'] 
), nowa-linia. # 1 dopasowanie (całość)

Wyjście pisz: (
	Wzorzec nowy: ['(.*)'],
	dopasuj: ['test@example.com'] 
), nowa-linia. # 1 dopasowanie (całość)

Wyjście pisz: (
	Wzorzec nowy: ['\\s*[^@]+@[^\.]+\.\\w+'],
	dopasuj: ['test@example.com'] 
), nowa-linia. # 1 dopasowanie, spacja na początku opcjonalna, jest ignorowana