# test określeń

Program posprzątaj.

>> Owoc := Obiekt nowy.
Owoc na: ['nowy'] wykonaj: {
	>> f := sam nowy.
	f apples: 0. <- f.
}.
Owoc na: ['apples:'] wykonaj: { :a własny jabłka := a. }.
Owoc na: ['jabłka'] wykonaj: { <- własny jabłka. }.
Owoc na: ['+'] wykonaj: { :f
	>> n := Owoc nowy.
	n apples: (f jabłka + własny jabłka). <- n.
}.
Liczba na: ['jabłka'] wykonaj: { <- ((Owoc nowy) apples: sam).
}.

Owoc na: ['tekst'] wykonaj: { <- własny jabłka + [' jabłka '].
}.

>> q := 3 jabłka + 4 jabłka.
Wyjście pisz: q, nowa-linia.




q := 3 jabłka + 4 jabłka.
