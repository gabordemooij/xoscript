# format ciasteczka sesji, typ treści json, tylko protokoły web, svg wyświetlane inline
Server inicjuj.
Program użyj: ['../../../src/xo/pl/webtools.xo'].

>> Fałszywe-Żądanie := Obiekt nowy.
Fałszywe-Żądanie na: ['value:'] wykonaj: { :wartość
	własny wartość := wartość.
}.
Fałszywe-Żądanie na: ['cookie:'] wykonaj: { :nazwa
	<- własny wartość.
}.

>> Testowa-Sesja := Sesja-plik-tymczasowy nowy.
Testowa-Sesja na: ['wczytaj'] wykonaj: {
	<- Słownik nowy.
}.
Testowa-Sesja na: ['identyfikator-sesji'] wykonaj: {
	<- własny id.
}.

>> ciasteczka := Lista nowy
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

ciasteczka każdy: { :i :ciasteczko
	>> żądanie := Fałszywe-Żądanie nowy.
	żądanie value: ciasteczko.
	>> menedżer := Testowa-Sesja nowy.
	>> strona := Dokument-Web nowy.
	strona żądanie: żądanie.
	strona menedżer-sesji: menedżer.
	strona rozpocznij-sesję.
	Wyjście pisz: ( menedżer identyfikator-sesji = ciasteczko ), nowa-linia.
}.

>> strona := Dokument-Web nowy.
strona json: (Słownik nowy umieść: ['b'] w: ['a']).
Wyjście pisz: ['\n'], nowa-linia.

{ Sieć get: ['file:///etc/hostname']. } przechwyć: { :e
	Wyjście pisz: e, nowa-linia.
}, uruchom.

>> svg := Plik nowy: ['/tmp/test0814.svg'].
svg pisz: ['<svg xmlns="x"></svg>'].
Wyjście nowa-linia.
Server przekaż: ['test0814.svg'] prefiks: ['/tmp/'].
svg usuń.
