# klucz publiczny (do zabezpieczania API itp.)
Server init.

# wygeneruj klucze
>> klucze := Sejf generuj-klucze.

# klucz prywatny (tajny)
>> kt := klucze pierwszy.

# klucz publiczny
>> kp := klucze ostatni.

# podpisz wiadomość
>> podp := Sejf podpisz: ['abc'] kluczem: kt.

Wyjście pisz: podp długość, nowa-linia.