Program zarządzanie-pamięcią: 0.

>> txt := ['Word Salad'].
Wyjście pisz: ['ostatni indeks ord = '] + (( txt ostatni: ['ord'] ) - 0), nowa-linia.
Wyjście pisz: ['indeks ord = '] + (( txt znajdź: ['ord'] ) - 0), nowa-linia.
Wyjście pisz: ['indeks ad = '] + (( txt znajdź: ['ad'] ) - 0), nowa-linia.
Wyjście pisz: ['ostatni indeks W = '] + (( txt ostatni: ['W'] ) - 0), nowa-linia.
Wyjście pisz: ['ostatni indeks d = '] + (( txt ostatni: ['d'] ) - 0), nowa-linia.
Wyjście pisz: ['txt równa się Sałatka Słów = '] + ( txt = ['Word Salad'] ), nowa-linia.
Wyjście pisz: ['txt równa się Sałatka Cezara = '] + ( txt = ['Sałatka Cezara'] ), nowa-linia.
Wyjście pisz: ['txt nie równa się Sałatka Słów = '] + ( txt ≠ ['Word Salad'] ), nowa-linia.
Wyjście pisz: ['txt nie równa się Sałatka Cezara = '] + ( txt ≠ ['Sałatka Cezara'] ), nowa-linia.

