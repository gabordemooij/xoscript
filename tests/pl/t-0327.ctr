

Lista na: ['fixture:'] wykonaj: { :f
	własny ustalona := f.
}.

Lista na: ['liczność'] wykonaj: { <- własny ustalona.
}.

Lista na: ['aantal'] wykonaj: { <- własny ustalona.
}.


>> x := Nic.
{

	x := ['hello'] 
	zamień:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] znak: 2)
			)
		)
	na: (
		(['...hal'] + ['lo']) 
			duże-litery 
			lowecase 
			duże-litery 
			przesunięcie: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Lista ← 0 ; 1 ; 4; 9 ; (Lista ← 0 ; 3; 1) ; 4
							) przedostatni
						) ? 1
					) + 
					((Lista ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					liczność
				)
			)
	).

} × 10.
Wyjście pisz: x, nowa-linia.

