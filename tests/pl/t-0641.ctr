# Test utf8 sanitizer
Server init.

>> utf8cases := Słownik nowy
	# ASCII only
	umieść: ( Lista nowy ; 65 ; 65 ; 65 ; 65 ; 0 ) w: ['AAAA'],
	# valid 2 byte sequence
	umieść: ( Lista nowy ; 194 ; 162 ; 0 ) w: ['¢'],
	# Valid 3-byte UTF-8
    umieść: ( Lista nowy ; 226 ; 130 ; 172 ; 0 ) w: ['€'],
	# Valid 4-byte UTF-8
    umieść: ( Lista nowy ; 240 ; 144 ; 141 ; 136 ; 0 ) w: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    umieść: ( Lista nowy ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) w: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    umieść: ( Lista nowy ; 65 ; 193 ; 129 ; 0 ) w: ['A?'],
	# Invalid first byte (0xFF)
    umieść: ( Lista nowy ; 255 ; 0 ) w: ['?'],
	# Incomplete multi-byte sequence at end
    umieść: ( Lista nowy ; 66 ; 226 ; 0 ) w: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    umieść: ( Lista nowy ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) w: ['A€?𐍈B'].
	 
utf8cases każdy: { :key :value
	>> blob := Blob nowy: value liczność, bytes: value.
	>> str := blob tekst.
	(str = key) prawda: {
		Wyjście pisz: ['OK'], nowa-linia.
	}, inaczej: {
		Wyjście pisz: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, nowa-linia.
	}.
	blob zwolnij.
}.
