# Test sanitizera utf8
Server init.

>> przypadkiUtf8 := Słownik nowy
	# tylko ASCII
	umieść: ( Lista nowy ; 65 ; 65 ; 65 ; 65 ; 0 ) w: ['AAAA'],
	# poprawna sekwencja 2-bajtowa
	umieść: ( Lista nowy ; 194 ; 162 ; 0 ) w: ['¢'],
	# Poprawny 3-bajtowy UTF-8
    umieść: ( Lista nowy ; 226 ; 130 ; 172 ; 0 ) w: ['€'],
	# Poprawny 4-bajtowy UTF-8
    umieść: ( Lista nowy ; 240 ; 144 ; 141 ; 136 ; 0 ) w: ['𐍈'],
	# Niepoprawny bajt kontynuacji w sekwencji E2 28 AC -> początek sekwencji 3b + 28 zły bajt kont. + AC bajt kont., ale należy do tego samego błędu
    umieść: ( Lista nowy ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) w: ['A?A'],
	# Zbyt długie kodowanie ASCII 'A' (powinno stać się ?),
    umieść: ( Lista nowy ; 65 ; 193 ; 129 ; 0 ) w: ['A?'],
	# Niepoprawny pierwszy bajt (0xFF)
    umieść: ( Lista nowy ; 255 ; 0 ) w: ['?'],
	# Niekompletna sekwencja wielobajtowa na końcu
    umieść: ( Lista nowy ; 66 ; 226 ; 0 ) w: ['B?'],
    # Pusty tekst
    #put: ( List new ) at: [''],
	# Wiele mieszanych sekwencji
    umieść: ( Lista nowy ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) w: ['A€?𐍈B'].
	 
przypadkiUtf8 każdy: { :key :value
	>> blob := Blob nowy: value liczność, bytes: value.
	>> str := blob tekst.
	(str = key) prawda: {
		Wyjście pisz: ['OK'], nowa-linia.
	}, inaczej: {
		Wyjście pisz: ['Sanityzacja UTF8 nie powiodła się dla: '] + key + [' otrzymano: '] + str, nowa-linia.
	}.
	blob zwolnij.
}.
