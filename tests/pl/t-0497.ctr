Server init.

# zapisz plik testowy
>> f := Plik nowy: ['/tmp/test.gif'].
f pisz: ['GIF87a01234567810'].

# udostępnij plik
Server przekaż: ['test.gif'] prefiks: ['/tmp/'].

Wyjście nowa-linia.

Wyjście pisz: ['Poza kontenerem (bezpieczeństwo):'], nowa-linia.
{ Server przekaż: ['../passwd'] prefiks: ['/tmp/']. }
przechwyć: { :e Wyjście pisz: e, nowa-linia. },
uruchom.

Wyjście pisz: ['Nieprawidłowy prefiks:'], nowa-linia.
{ Server przekaż: ['test.gif'] prefiks: ['z:\\']. }
przechwyć: { :e Wyjście pisz: e, nowa-linia. },
uruchom.

Wyjście pisz: ['Nieistniejący plik:'], nowa-linia.
{ Server przekaż: ['xxx.xxx'] prefiks: ['/tmp/']. }
przechwyć: { :e Wyjście pisz: e, nowa-linia. },
uruchom.
