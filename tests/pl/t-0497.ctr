Server init.

# write a test file
>> f := Plik nowy: ['/tmp/test.gif'].
f pisz: ['GIF87a01234567810'].

# serve the file
Server przekaż: ['test.gif'] prefiks: ['/tmp/'].

Wyjście nowa-linia.

Wyjście pisz: ['Outside container (security):'], nowa-linia.
{ Server przekaż: ['../passwd'] prefiks: ['/tmp/']. }
przechwyć: { :e Wyjście pisz: e, nowa-linia. },
uruchom.

Wyjście pisz: ['Invalid prefix:'], nowa-linia.
{ Server przekaż: ['test.gif'] prefiks: ['z:\\']. }
przechwyć: { :e Wyjście pisz: e, nowa-linia. },
uruchom.

Wyjście pisz: ['Non-existant file:'], nowa-linia.
{ Server przekaż: ['xxx.xxx'] prefiks: ['/tmp/']. }
przechwyć: { :e Wyjście pisz: e, nowa-linia. },
uruchom.
