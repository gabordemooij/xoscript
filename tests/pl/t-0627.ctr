

# utwórz 64-bitową liczbę całkowitą do dokładnych obliczeń
>> a := Int64 z-tekstu: ['123'].

# na tekst
Wyjście pisz: a, nowa-linia.

# dzielenie
Wyjście pisz: a / (Int64 z-tekstu: ['3']), nowa-linia.

# mnożenie
Wyjście pisz: a * (Int64 z-tekstu: ['2']), nowa-linia.

# dodawanie
Wyjście pisz: a + (Int64 z-tekstu: ['1']), nowa-linia.

# odejmowanie
Wyjście pisz: a - (Int64 z-tekstu: ['2']), nowa-linia.

# porównanie
Wyjście pisz: ( a =   (Int64 z-tekstu: ['123'])), nowa-linia.
Wyjście pisz: ( a !=: (Int64 z-tekstu: ['124'])), nowa-linia.
Wyjście pisz: ( a <   (Int64 z-tekstu: ['124'])), nowa-linia.
Wyjście pisz: ( a >   (Int64 z-tekstu: ['122'])), nowa-linia.
Wyjście pisz: ( a >=: (Int64 z-tekstu: ['123'])), nowa-linia.
Wyjście pisz: ( a <=: (Int64 z-tekstu: ['123'])), nowa-linia.





	