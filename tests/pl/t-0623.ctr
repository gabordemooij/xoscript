

>> g  := Server nowy.
>> v  := Sejf nowy.
>> ok := 0.

>> sekrety := Lista nowy ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> hasła := sekrety kopiuj.
hasła każdy: { :i :p
	sekrety każdy: { :n :s
		{
			>> zaszyfrowane := v szyfruj: s klucz: p.
			>> odszyfrowane := v odszyfruj: zaszyfrowane klucz: p.
			(odszyfrowane = s) prawda: {
				ok dodaj: 1.
			}, inaczej: {
				Wyjście pisz: ['błąd szyfrowania/deszyfrowania: '], nowa-linia.
				Wyjście pisz: s, nowa-linia.
				Wyjście pisz: ['zaszyfrowano: '] + zaszyfrowane, nowa-linia.
				Wyjście pisz: ['odszyfrowano: '] + zaszyfrowane, nowa-linia.
				Program koniec.
			}.
		} przechwyć: { :bł
			(s = [''] lub: p = ['']) prawda: {
				ok dodaj: 1.
			}, inaczej: {
				Wyjście pisz: bł, nowa-linia.
				Program koniec.
			}.
		}, uruchom.
	}.
}.

Wyjście pisz: ( ok + [' szyfrowań sejfu przetestowano.'] ), nowa-linia.