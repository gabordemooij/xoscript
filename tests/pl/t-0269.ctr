#Linux

(Plik nowy: ['/tmp/testje']) istnieje fałsz: {
	Program system: ['mkdir /tmp/testje'].	
}.

(Plik nowy: ['/tmp/testje/file1']) istnieje fałsz: {
	Program system: ['touch /tmp/testje/file1'].	
}.

(Plik nowy: ['/tmp/testje/folder1']) istnieje fałsz: {
	Program system: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Plik lista: ['/tmp/testje'].

>> q := Lista nowy.

l każdy: { :k :v v każdy: { :x :y q dołącz: y. }. }.

>> s := q tekst.

(s zawiera: ['file1']) prawda:   { Wyjście pisz: ['OK'], nowa-linia. }.
(s zawiera: ['file2']) prawda:   { Wyjście pisz: ['XX'], nowa-linia. }.
(s zawiera: ['folder1']) prawda: { Wyjście pisz: ['OK'], nowa-linia. }.
