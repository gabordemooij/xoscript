Server init.
Wyjście pisz: ['Database date test'], nowa-linia.

>> db := Maria-DB nowy host: ['localhost'],
	użytkownik: ['xo'], 
	hasło: ['pass123'],
	nazwa-bazy: ['xobase'],
	połącz.

>> parametry-wyszukiwania :=
db zapytanie: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
pobierz: { :row
	Wyjście pisz: row datetest, nowa-linia.
}.
