Wyjście pisz: ['Test object'], nowa-linia.
>> cmd := Polecenie nowy.
Wyjście pisz: cmd ls /tmp, nowa-linia.
>> old-cmd-address := cmd prototyp adres-pamięci.
cmd save-as: ['/tmp/a.bin'].
Wyjście pisz: ['========== RELOADING SNAP:'], nowa-linia.
>> b := Obiekt load-from: ['/tmp/a.bin'].
(b prototyp adres-pamięci = old-cmd-address) prawda: {
	Wyjście pisz: ['Object link re-attached.'], nowa-linia.
}.
Wyjście pisz: b ls, nowa-linia.


