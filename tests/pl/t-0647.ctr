Server init.
Wyjście pisz: ['Database time test'], nowa-linia.

>> db := Maria-DB nowy host: ['localhost'],
	użytkownik: ['xo'], 
	hasło: ['pass123'],
	nazwa-bazy: ['xobase'],
	połącz.

>> parametry-wyszukiwania :=
db zapytanie: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
pobierz: { :row
	Wyjście pisz: row timetest, nowa-linia.
}.
