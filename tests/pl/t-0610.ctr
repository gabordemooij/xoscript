
>> Prostokąt := Obiekt nowy.

Prostokąt na: ['pole'] wykonaj: {
	<- własny długość * własny szerokość.
}.

Prostokąt na: ['length:'] wykonaj: { :długość
	własny długość := długość.
}.

Prostokąt na: ['width:'] wykonaj: { :szerokość
	własny szerokość := szerokość.
}.

Prostokąt na: ['nowy'] wykonaj: {
	# to nie spowoduje nieskończonej pętli
	>> prostokąt := sam nowy.
	prostokąt length: 0, width: 0.
	<- prostokąt.
}.

>> a := Prostokąt nowy.
Wyjście pisz: a pole, nowa-linia. #0

>> b := Prostokąt nowy length: 2, width: 3.
Wyjście pisz: b pole, nowa-linia. #6

