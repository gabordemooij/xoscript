
>> Rectangle := Obiekt nowy.

Rectangle na: ['area'] wykonaj: { <- własny długość * własny width.
}.

Rectangle na: ['length:'] wykonaj: { :długość
	własny długość := długość.
}.

Rectangle na: ['width:'] wykonaj: { :width
	własny width := width.
}.

Rectangle na: ['nowy'] wykonaj: {
	# this will not result into an infinite loop
	>> rectangle := sam nowy.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle nowy.
Wyjście pisz: a area, nowa-linia. #0

>> b := Rectangle nowy length: 2, width: 3.
Wyjście pisz: b area, nowa-linia. #6

