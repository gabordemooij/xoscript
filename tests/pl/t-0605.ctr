>> faktura := Obiekt nowy.
faktura na: ['uruchom'] wykonaj: {
        własny liczba := 0.
}.

faktura na: ['liczba'] wykonaj: {
        własny liczba dodaj: 1.
        <- własny liczba kopiuj.
}.

>> faktura-roczna := faktura nowy.
faktura-roczna na: ['start:'] wykonaj: { :rok
	własny liczba := rok.
}.

faktura-roczna start: 202000.
Wyjście pisz: faktura-roczna liczba, nowa-linia.
Wyjście pisz: faktura-roczna liczba, nowa-linia.
