>> invoice := Obiekt nowy.
invoice na: ['uruchom'] wykonaj: {
        własny liczba := 0.
}.

invoice na: ['liczba'] wykonaj: {
        własny liczba dodaj: 1. <- własny liczba kopiuj.
}.

>> year-invoice := invoice nowy.
year-invoice na: ['start:'] wykonaj: { :rok
	własny liczba := rok.
}.

year-invoice start: 202000.
Wyjście pisz: year-invoice liczba, nowa-linia.
Wyjście pisz: year-invoice liczba, nowa-linia.
