

Lista na: ['suma'] wykonaj: {
	>> razem := 0.
	sam każdy: { :indeks :element
		razem dodaj: element.
	}. <- razem.
}.

Lista na: ['iloczyn'] wykonaj: {
	>> razem := 1.
	sam każdy: { :indeks :element
		razem pomnóż-przez: element.
	}. <- razem.
}.

>> użytaPamięć1 := 0.
>> użytaPamięć2 := 0.
>> użytaPamięć3 := 0.
