Program zarządzanie-pamięcią: 0.

{

>> a := Lista ← ['hello'] ; ['world'] ; Prawda ; Nic ; 666.
a := a + ( Lista ← 1 ).
Wyjście pisz: ( ['suma: '] + ( a suma ) ), nowa-linia.
Wyjście pisz: ( ['min: '] + ( a minimum ) ), nowa-linia.
Wyjście pisz: ( ['max: '] + ( a maksimum ) ), nowa-linia.
Wyjście pisz: ( ['3.: '] + ( a ? 2 ) ), nowa-linia.
Wyjście pisz: ( ['iloczyn: '] + ( a iloczyn ) ), nowa-linia.
a sortuj: { :a :b <- (b - a). }.
a każdy: { :i :e Wyjście pisz: ( i - 0 ), nowa-linia. }.

} uruchom.

