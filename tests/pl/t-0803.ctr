Server init.

>> conn1 := Maria-DB nowy host: ['localhost'],
	użytkownik: ['xo'],
	hasło: ['pass123'],
	nazwa-bazy: ['xobase'],
	połącz.

>> conn2 := Maria-DB nowy host: ['localhost'],
	użytkownik: ['xo'],
	hasło: ['pass123'],
	nazwa-bazy: ['xobase'],
	połącz.
#...
>> del := conn1 zapytanie: ['DELETE FROM book WHERE id > 0'].
{  del wykonaj. conn1 zatwierdź. } przechwyć: { :e conn1 wycofaj.  }, uruchom.

>> insert := conn1 zapytanie: ['INSERT INTO book (id) VALUES(null)'].
insert wykonaj.

>> liczność := conn1 zapytanie: ['SELECT COUNT(*) AS num FROM book'].
liczność pobierz: { :row Wyjście pisz: row num, nowa-linia. }.

# does not show up
# insert not committed on connection 1
>> liczność := conn2 zapytanie: ['SELECT COUNT(*) AS num FROM book'].
liczność pobierz: { :row Wyjście pisz: row num, nowa-linia. }.
