# grupa, która nie jest częścią dopasowania, nie może spowodować awarii i musi zachować numery grup
Server init.
>> pokaż := { :wyrażenie :subject
	>> p := Wzorzec nowy: wyrażenie.
	p dopasuj: subject wykonaj: { :m :g
		Wyjście pisz: g liczność, pisz: [' '], pisz: (g połącz: ['|']), nowa-linia.
		<- m.
	}.
}.
pokaż zastosuj: ['(a)|(b)'] i: ['b'].
pokaż zastosuj: ['(a)|(b)'] i: ['a'].
pokaż zastosuj: ['(x)?y'] i: ['y'].
pokaż zastosuj: ['(x)?(y)(z)?'] i: ['xy'].
