# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Wzorzec nowy: pattern.
	p dopasuj: subject wykonaj: { :m :g
		Wyjście pisz: g liczność, pisz: [' '], pisz: (g połącz: ['|']), nowa-linia. <- m.
	}.
}.
show zastosuj: ['(a)|(b)'] i: ['b'].
show zastosuj: ['(a)|(b)'] i: ['a'].
show zastosuj: ['(x)?y'] i: ['y'].
show zastosuj: ['(x)?(y)(z)?'] i: ['xy'].
