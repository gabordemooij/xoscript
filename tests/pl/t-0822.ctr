# mniej parametrów niż symboli zastępczych musi dać błąd, a nie czytać poza powiązaniami
Server init.

>> bd := Maria-DB nowy host: ['localhost'],
	użytkownik: ['xo'],
	hasło: ['pass123'],
	nazwa-bazy: ['xobase'],
	połącz.

>> parametry-wyszukiwania := bd zapytanie: ['SELECT ? AS a, ? AS b, ? AS c'].
parametry-wyszukiwania parametry: (Lista nowy ; ['1']).
{ parametry-wyszukiwania pobierz: { :rząd Wyjście pisz: rząd, nowa-linia. }. } przechwyć: { :e Wyjście pisz: e, nowa-linia. }, uruchom.

>> parametry-wyszukiwania := bd zapytanie: ['SELECT ? AS a'].
{ parametry-wyszukiwania pobierz: { :rząd Wyjście pisz: rząd, nowa-linia. }. } przechwyć: { :e Wyjście pisz: e, nowa-linia. }, uruchom.

# właściwa liczba nadal działa, nadmiarowe parametry są ignorowane jak wcześniej
>> parametry-wyszukiwania := bd zapytanie: ['SELECT ? AS a, ? AS b'].
parametry-wyszukiwania parametry: (Lista nowy ; ['1'] ; ['2']).
parametry-wyszukiwania pobierz: { :rząd Wyjście pisz: (rząd w: ['a']), pisz: (rząd w: ['b']), nowa-linia. }.
parametry-wyszukiwania parametry: (Lista nowy ; ['1'] ; ['2'] ; ['3']).
parametry-wyszukiwania pobierz: { :rząd Wyjście pisz: (rząd w: ['a']), pisz: (rząd w: ['b']), nowa-linia. }.
