Wyjście pisz: ['Obiekt testowy'], nowa-linia.
>> a := Obiekt nowy. 

a na: ['item:'] wykonaj: { :pomocnikbin
	własny pomocnikbin := pomocnikbin. 
}.

a na: ['przedmiot'] wykonaj: {
	<- własny pomocnikbin.
}.

a item: Bin nowy.

>> stary-adres-pomocnikbin := a przedmiot prototyp adres-pamięci.
a save-as: ['/tmp/a.bin'].
Wyjście pisz: ['========== PONOWNE WCZYTYWANIE SNAP:'], nowa-linia.

>> b := Obiekt load-from: ['/tmp/a.bin'].

(b przedmiot prototyp adres-pamięci = stary-adres-pomocnikbin) prawda: {
	Wyjście pisz: ['Łącze obiektu ponownie dołączone.'], nowa-linia.
}.


