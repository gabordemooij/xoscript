Wyjście pisz: ['Test object'], nowa-linia.
>> a := Obiekt nowy. 

a na: ['item:'] wykonaj: { :binhelper
	własny binhelper := binhelper. 
}.

a na: ['item'] wykonaj: { <- własny binhelper.
}.

a item: Bin nowy.

>> old-binhelper-address := a item prototyp adres-pamięci.
a save-as: ['/tmp/a.bin'].
Wyjście pisz: ['========== RELOADING SNAP:'], nowa-linia.

>> b := Obiekt load-from: ['/tmp/a.bin'].

(b item prototyp adres-pamięci = old-binhelper-address) prawda: {
	Wyjście pisz: ['Object link re-attached.'], nowa-linia.
}.


