#Linux
>> clock := Moment nowy.
clock strefa: ['UTC-1'].
clock rok: 1981, miesiąc: 1, dzień: 5,
      godzina: 13, minuta: 15, sekunda: 13.

Wyjście pisz: clock, nowa-linia.
clock strefa: ['UTC+0'].

Wyjście pisz: (
	(clock rok surowy) + ['-'] + (clock miesiąc) + ['-'] + (clock dzień) + [' '] +
	(clock godzina) + [':'] + (clock minuta) + [':'] + (clock sekunda) + [' '] +
	['W'] + (clock tydzień) + (clock strefa)
), nowa-linia.


clock strefa: ['UTC-1'].
Wyjście pisz: (
	(clock rok surowy) + ['-'] + (clock miesiąc) + ['-'] + (clock dzień) + [' '] +
	(clock godzina) + [':'] + (clock minuta) + [':'] + (clock sekunda) + [' '] +
	['W'] + (clock tydzień) + (clock strefa)
), nowa-linia.
