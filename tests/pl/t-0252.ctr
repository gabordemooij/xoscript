#Linux
>> zegar := Moment nowy.
zegar strefa: ['UTC-1'].
zegar rok: 1981, miesiąc: 1, dzień: 5,
      godzina: 13, minuta: 15, sekunda: 13.

Wyjście pisz: zegar, nowa-linia.
zegar strefa: ['UTC+0'].

Wyjście pisz: (
	(zegar rok surowy) + ['-'] + (zegar miesiąc) + ['-'] + (zegar dzień) + [' '] +
	(zegar godzina) + [':'] + (zegar minuta) + [':'] + (zegar sekunda) + [' '] +
	['W'] + (zegar tydzień) + (zegar strefa)
), nowa-linia.


zegar strefa: ['UTC-1'].
Wyjście pisz: (
	(zegar rok surowy) + ['-'] + (zegar miesiąc) + ['-'] + (zegar dzień) + [' '] +
	(zegar godzina) + [':'] + (zegar minuta) + [':'] + (zegar sekunda) + [' '] +
	['W'] + (zegar tydzień) + (zegar strefa)
), nowa-linia.
