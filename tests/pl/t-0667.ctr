# test Program version

# this feature is disabled by default
Wyjście pisz: (
	Program funkcja: 
	['RECURSIVE_STRINTPOL']
), nowa-linia.


# but if we set the time back
>> today := Moment 
strefa: ['CEST'],
z: ['2026-02-15 10:00:00'].
Program wersja: today.

# it will be enabled like it used to be (from now on)
Wyjście pisz: (
	Program funkcja: 
	['RECURSIVE_STRINTPOL']
), nowa-linia.