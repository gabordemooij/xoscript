# test parsowania url

Server init.
>> url := URL z: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Wyjście pisz: ['schemat = '] + url schemat, nowa-linia.
Wyjście pisz: ['host = '] + url host, nowa-linia.
Wyjście pisz: ['port = '] + url port, nowa-linia.
Wyjście pisz: ['ścieżka = '] + url ścieżka, nowa-linia.
Wyjście pisz: ['zapytanie = '] + url parametry-wyszukiwania, nowa-linia.
Wyjście pisz: ['fragment = '] + url fragment, nowa-linia.
