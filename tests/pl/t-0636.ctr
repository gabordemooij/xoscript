# test url parsing

Server init.
>> url := URL z: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Wyjście pisz: ['scheme = '] + url schemat, nowa-linia.
Wyjście pisz: ['host = '] + url host, nowa-linia.
Wyjście pisz: ['port = '] + url port, nowa-linia.
Wyjście pisz: ['path = '] + url ścieżka, nowa-linia.
Wyjście pisz: ['query = '] + url parametry-wyszukiwania, nowa-linia.
Wyjście pisz: ['fragment = '] + url fragment, nowa-linia.
