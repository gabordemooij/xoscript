{
	to-zadanie błąd: ['Nie zawiedź.'].
	nieznany zróbCoś.
} przechwyć: {
	Wyjście pisz: ['Złapany!'].
}, uruchom.

{
	to-zadanie błąd: ['Nie zawiedź.'].
	własny nieznany zróbCoś.
} przechwyć: {
	Wyjście pisz: ['Złapany!'].
}, uruchom.

{
	to-zadanie błąd: ['Nie zawiedź.'].
	nieznany := 122.
} przechwyć: {
	Wyjście pisz: ['Złapany!'].
}, uruchom.


{
	to-zadanie błąd: ['Nie zawiedź.'].
	Prawda przerwij.
	Wyjście pisz: ['BŁĄD'].
} przechwyć: {
	Wyjście pisz: ['Złapany!'].
}, uruchom.

{
	{
		to-zadanie błąd: ['Nie zawiedź.'].
		Prawda przerwij.
		Wyjście pisz: ['BŁĄD'].
	} przechwyć: { :x
		(x = ['Nie zawiedź.']) prawda: { to-zadanie błąd: ['Zagnieżdżony złapany!']. }.
	}, uruchom.
} przechwyć: { :e
	Wyjście pisz: e.
}, uruchom.
