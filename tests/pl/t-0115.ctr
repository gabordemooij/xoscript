{
	to-zadanie błąd: ['Dont fail.'].
	unknown doSomething.
} przechwyć: {
	Wyjście pisz: ['Caught!'].
}, uruchom.

{
	to-zadanie błąd: ['Dont fail.'].
	własny unknown doSomething.
} przechwyć: {
	Wyjście pisz: ['Caught!'].
}, uruchom.

{
	to-zadanie błąd: ['Dont fail.'].
	unknown := 122.
} przechwyć: {
	Wyjście pisz: ['Caught!'].
}, uruchom.


{
	to-zadanie błąd: ['Dont fail.'].
	Prawda przerwij.
	Wyjście pisz: ['FAIL'].
} przechwyć: {
	Wyjście pisz: ['Caught!'].
}, uruchom.

{
	{
		to-zadanie błąd: ['Dont fail.'].
		Prawda przerwij.
		Wyjście pisz: ['FAIL'].
	} przechwyć: { :x
		(x = ['Dont fail.']) prawda: { to-zadanie błąd: ['Nested Caught!']. }.
	}, uruchom.
} przechwyć: { :e
	Wyjście pisz: e.
}, uruchom.
