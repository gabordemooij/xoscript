Wyjście pisz: ['Test object'], nowa-linia.
>> a := Obiekt nowy. 

a na: ['item:'] wykonaj: { :hexhelper
	własny hexhelper := hexhelper. 
}.

a na: ['item'] wykonaj: { <- własny hexhelper.
}.

a item: Hx nowy.

>> old-hexhelper-address := a item prototyp adres-pamięci.
a save-as: ['/tmp/a.bin'].
Wyjście pisz: ['========== RELOADING SNAP:'], nowa-linia.

>> b := Obiekt load-from: ['/tmp/a.bin'].

(b item prototyp adres-pamięci = old-hexhelper-address) prawda: {
	Wyjście pisz: ['Object link re-attached.'], nowa-linia.
}.
