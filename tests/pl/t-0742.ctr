Wyjście pisz: ['Obiekt testowy'], nowa-linia.
>> a := Obiekt nowy. 

a na: ['item:'] wykonaj: { :pomocnikhex
	własny pomocnikhex := pomocnikhex. 
}.

a na: ['przedmiot'] wykonaj: {
	<- własny pomocnikhex.
}.

a item: Hx nowy.

>> stary-adres-pomocnikhex := a przedmiot prototyp adres-pamięci.
a save-as: ['/tmp/a.bin'].
Wyjście pisz: ['========== PONOWNE WCZYTYWANIE SNAP:'], nowa-linia.

>> b := Obiekt load-from: ['/tmp/a.bin'].

(b przedmiot prototyp adres-pamięci = stary-adres-pomocnikhex) prawda: {
	Wyjście pisz: ['Łącze obiektu ponownie dołączone.'], nowa-linia.
}.
