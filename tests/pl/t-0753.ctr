Wyjście pisz: ['Test object'], nowa-linia.
>> a := Obiekt nowy. 

a na: ['item:'] wykonaj: { :fmt
	własny fmt := fmt. 
}.

a na: ['item'] wykonaj: { <- własny fmt.
}.

a item: ( Format nowy: ['|%s|'] ).

Wyjście pisz: a item, nowa-linia.

>> old-fmt-address := a item prototyp adres-pamięci.
a save-as: ['/tmp/a.bin'].
Wyjście pisz: ['========== RELOADING SNAP:'], nowa-linia.

>> b := Obiekt load-from: ['/tmp/a.bin'].

(b item prototyp adres-pamięci = old-fmt-address) prawda: {
	Wyjście pisz: ['Object link re-attached.'], nowa-linia.
}.

Wyjście pisz: ( b item zastosuj: ['hello'] ), nowa-linia.
