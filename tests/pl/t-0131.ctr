
>> a := Lista ← (Lista ← 100 ; 200 ; 300) ; (Lista ← 9 ; 8 ; 7).
Wyjście pisz: ['at 0,1 :'].
Wyjście pisz: a ? 0 ? 1, nowa-linia. 
Wyjście pisz: ['at 1,2 :'].
Wyjście pisz: a ? 1 ? 2, nowa-linia. 
>> menu := Słownik nowy.
menu umieść: (Lista ← ['pizza'] ; ['spaghetti']) w: ['Italian Cuisine'].
menu umieść: (Lista ← ['bifteki'] ; ['suflaki']) w: ['Greek Cuisine'].
Wyjście pisz: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), nowa-linia. 
Wyjście pisz: ['but not on the same plate.'], nowa-linia.
