# compliance test

# use international numbers

Wyjście pisz: ['1000 -> '].
Wyjście pisz: 1000, nowa-linia. #1000

Wyjście pisz: ['1.5 -> '].
Wyjście pisz: 1.5, nowa-linia.  #1.5

Wyjście pisz: ['1001.5 -> '].
Wyjście pisz: 1.5 + 1000, nowa-linia. #1001.5

# use 0-indexed arrays
>> x := Lista nowy ; 1 ; 2 ; 3.
>> y := Lista nowy ; ['a'] ; ['b'] ; ['c'].

Wyjście pisz: ['1 -> '].
Wyjście pisz: x ? 0, nowa-linia. #1

Wyjście pisz: ['1 -> '].
Wyjście pisz: (x w: 0), nowa-linia. #1

Wyjście pisz: ['1 -> '].
Wyjście pisz: x pierwszy, nowa-linia. #1

Wyjście pisz: ['3 -> '].
Wyjście pisz: x ostatni, nowa-linia. #3

Wyjście pisz: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Wyjście pisz: (x według: y), nowa-linia.

Wyjście pisz: ['1 -> '].
Wyjście pisz: (x od: 0 długość: 1) pierwszy, nowa-linia. #1

Wyjście pisz: ['0 -> '].
Wyjście pisz: (x znajdź: 1), nowa-linia. #0

x umieść: 9 w: 0.

Wyjście pisz: ['9 -> '].
Wyjście pisz: (x w: 0), nowa-linia. #9

x wstaw-na-początek: 8.
Wyjście pisz: ['8 -> '].
Wyjście pisz: (x w: 0), nowa-linia. #9


x dołącz: 10.
Wyjście pisz: ['10 -> '].
Wyjście pisz: (x w: 4), nowa-linia. #10








