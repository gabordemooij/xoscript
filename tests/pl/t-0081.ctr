>> mapa1 := Słownik nowy.
>> klucz1 := Lista nowy.
>> klucz2 := Lista nowy.

mapa1
	umieść: ['hello'] w: klucz1,
	umieść: ['world'] w: klucz2.


Wyjście
	pisz: ['Map #1 contains: '] + (mapa1 w: klucz1),
	pisz: [' i '] + (mapa1 w: klucz2), nowa-linia.

>> TablicaZKluczami := Lista nowy.
TablicaZKluczami na: ['naTekst'] wykonaj: { <- (sam liczność) naTekst.
}.

>> map2 := Słownik nowy.
klucz1 := TablicaZKluczami nowy.
klucz2 := TablicaZKluczami nowy.

klucz1 dołącz: 1.

map2
	umieść: ['hello'] w: klucz1,
	umieść: ['world'] w: klucz2.

Wyjście
	pisz: ['Map #2 contains: '] + (map2 w: klucz1),
	pisz: [' i '] + (map2 w: klucz2), nowa-linia.
