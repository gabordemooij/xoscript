>> map1 := Słownik nowy.
>> key1 := Lista nowy.
>> key2 := Lista nowy.

map1
	umieść: ['hello'] w: key1,
	umieść: ['world'] w: key2.


Wyjście
	pisz: ['Map #1 contains: '] + (map1 w: key1),
	pisz: [' and '] + (map1 w: key2), nowa-linia.

>> KeyeableArray := Lista nowy.
KeyeableArray na: ['toString'] wykonaj: { <- (sam liczność) toString.
}.

>> map2 := Słownik nowy.
key1 := KeyeableArray nowy.
key2 := KeyeableArray nowy.

key1 dołącz: 1.

map2
	umieść: ['hello'] w: key1,
	umieść: ['world'] w: key2.

Wyjście
	pisz: ['Map #2 contains: '] + (map2 w: key1),
	pisz: [' and '] + (map2 w: key2), nowa-linia.
