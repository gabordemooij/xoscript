Logiczny na: ['xor:'] wykonaj: { :a :b <- ((a i: b nie) lub: (a nie i: b)).
}.

>> o := Obiekt nowy.
o na: ['hello'] wykonaj: { ['Empty']. }.
{ o na: 2 wykonaj: 3.} przechwyć: { :e Wyjście pisz: e, nowa-linia. }, uruchom.
{ o na: ['test'] wykonaj: 3.} przechwyć: { :e Wyjście pisz: e, nowa-linia. }, uruchom.
{ o na: ['hello'] wykonaj: { ['Empty']. }.} przechwyć: { :e Wyjście pisz: e, nowa-linia. }, uruchom. 
{ >> z := 4 ÷ 0. } przechwyć: { :e Wyjście pisz: e, nowa-linia. }, uruchom. 
{ (Prawda i: Nic) prawda: { Wyjście pisz: ['X'].}. } przechwyć: { :e Wyjście pisz: e, nowa-linia. }, uruchom. 
{ ([''] xor: 0) prawda: { Wyjście pisz: ['X'].}. } przechwyć: { :e Wyjście pisz: e, nowa-linia. }, uruchom. 
{ (1 < ['2']) prawda: { Wyjście pisz: ['OK']. }. } przechwyć: { :e Wyjście pisz: e, nowa-linia. }, uruchom. 
{ (1 < ['2.0']) prawda: { Wyjście pisz: ['OK']. }. } przechwyć: { :e Wyjście pisz: e, nowa-linia. }, uruchom. 
{ (1 < ['x2.0']) prawda: { Wyjście pisz: ['NO!']. }. } przechwyć: { :e Wyjście pisz: e, nowa-linia. }, uruchom. 
{ Wyjście pisz: (['hello OK there'] od: ['6'] długość: ['2']). } uruchom. 
