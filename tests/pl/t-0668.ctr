# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob nowy: 8, bytes: (
	Lista nowy ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Wyjście pisz: ( utf16 dekoduj: ['utf16le'] ), nowa-linia.

utf16 zwolnij.
>> utf32 := Blob nowy: 13, bytes: (
	Lista nowy ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Wyjście pisz: ( utf32 dekoduj: ['utf32be'] ), nowa-linia.
utf32 zwolnij.