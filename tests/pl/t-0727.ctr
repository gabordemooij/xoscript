Server init.
>> f := Format nowy: ['%d'].
>> a := Blob nowy: 4.
a bytes: ( Lista nowy ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob nowy: 4.
b bytes: ( Lista nowy ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a od: 0 długość: 3, każdy: { :i :byte
	Wyjście pisz: ( f zastosuj-całkowitą: byte ) , nowa-linia.
}.
a ^ b.
a od: 0 długość: 3, każdy: { :i :byte
	Wyjście pisz: ( f zastosuj-całkowitą: byte ) , nowa-linia.
}.
a ^ b.
a od: 0 długość: 3, każdy: { :i :byte
	Wyjście pisz: ( f zastosuj-całkowitą: byte ) , nowa-linia.
}.
a zwolnij.
b zwolnij.

{ a ^ Obiekt. } przechwyć: { :e Wyjście pisz: e, nowa-linia. }, uruchom.
