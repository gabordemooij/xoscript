>> liczby := ['1,2,3'] podziel: [','].
Wyjście pisz: ['Mam: '] + liczby liczność + [' liczby.'],nowa-linia.
{ :i Wyjście pisz: ['number #'] + i + [':'] + (liczby pozycja: i), nowa-linia.} × 3.
>> napoje := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
napoje := napoje podziel: [' Or '].
Wyjście pisz: ['Podajemy'], nowa-linia.
{ :i Wyjście pisz: ['->'] + (napoje pozycja: i), nowa-linia. } × (napoje liczność).
Wyjście pisz: (napoje połącz: [',']), nowa-linia.
Wyjście pisz: (liczby połącz: ['||']).
