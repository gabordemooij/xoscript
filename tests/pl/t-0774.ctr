Wyjście pisz: ['Test object'], nowa-linia.
>> a := Obiekt nowy. 
a na: ['item:'] wykonaj: { :lst
	własny lst := lst. 
}.
a na: ['item'] wykonaj: { <- własny lst.
}.
a item: (
	Lista nowy ; 1 ; (
		Lista nowy ; ['a'] ; (
			Lista nowy ; ( Moment nowy: 1 )
		) ; ( Int64 z-tekstu: ['321'] )
	)
).
Wyjście pisz: a item, nowa-linia.
>> old-lst-address := a item prototyp adres-pamięci.
a save-as: ['/tmp/a.bin'].
Wyjście pisz: ['========== RELOADING SNAP:'], nowa-linia.
>> b := Obiekt load-from: ['/tmp/a.bin'].
(b item prototyp adres-pamięci = old-lst-address) prawda: {
	Wyjście pisz: ['Object link re-attached.'], nowa-linia.
}.
Wyjście pisz: ( b item ), nowa-linia.
