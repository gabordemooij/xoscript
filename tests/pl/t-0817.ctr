# a value ending in the first part of an opening quote must survive serialization
>> wartości := Lista nowy
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

wartości każdy: { :i :value
	>> d := Słownik nowy.
	d umieść: value w: ['k'].
	d umieść: ['second'] w: ['j'].
	>> r := d code obiekt.
	Wyjście pisz: r liczność, nowa-linia.
	Wyjście pisz: ( (r w: ['k']) = value ), nowa-linia.
}.
