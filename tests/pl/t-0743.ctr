>> V := Obiekt.
V na: ['tekst'] wykonaj: {
	Wyjście pisz: ['cast'], nowa-linia. <- ['abc'].
}.

Wyjście pisz: ( Program ustawienie: ['abc'] ), nowa-linia.

# params should not get gc'ed
Program ustawienie: ([''] + V nowy) wartość: ([''] + V nowy).

Wyjście pisz: ( Program ustawienie: ['abc'] ), nowa-linia.
