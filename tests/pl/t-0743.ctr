>> V := Obiekt.
V na: ['tekst'] wykonaj: {
	Wyjście pisz: ['cast'], nowa-linia.
	<- ['abc'].
}.

Wyjście pisz: ( Program ustawienie: ['abc'] ), nowa-linia.

# parametry nie powinny zostać usunięte przez gc
Program ustawienie: ([''] + V nowy) wartość: ([''] + V nowy).

Wyjście pisz: ( Program ustawienie: ['abc'] ), nowa-linia.
