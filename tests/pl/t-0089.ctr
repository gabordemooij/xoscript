>> losownik := { :a :b
	>> minimum := ( a < b ) albo: a albo: b.
	>> maksimum := ( a > b ) albo: a albo: b.
	>> x := Nic.
	{
		x := Liczba między: a a: b.
		((x < minimum) lub: (x > maksimum)) prawda: { 
			Wyjście pisz: (['Nieprawidłowa wartość!']).
			Program koniec.
		}.
	} 
	× 100. <- x.
}.
losownik zastosuj: 0 i: 0.
losownik zastosuj: 1 i: 0.
losownik zastosuj: 1 i: 1.
losownik zastosuj: 0 i: 1.
losownik zastosuj: -1 i: 0.
losownik zastosuj: -1 i: -1.
losownik zastosuj: 0 i: -1.
losownik zastosuj: 100 i: 200.
