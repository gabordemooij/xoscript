>> Slurp := Obiekt nowy.
Slurp na: ['nowy'] wykonaj: {
	własny str := [''].
}.


Slurp na: ['odpowiedz:'] wykonaj: { :blah
		(własny str ≠ ['']) prawda: {
			własny str dołącz: [' '].
		}.
		własny str dołącz: blah.
}.
Slurp na: ['odpowiedz:i:'] wykonaj: { :blah :blahah
		(własny str ≠ ['']) prawda: {
			własny str dołącz: [' '].
		}.
		(blah długość > 1) prawda: {
			własny str dołącz: (blah od: 0 długość: (blah długość - 1)).
		}, inaczej: {
			własny str dołącz: blah.
		}.
		własny str dołącz: [' '].
		własny str dołącz: blahah.
}.
Slurp na: ['obtain'] wykonaj: {
	>> buffer := własny str.
	własny str := ['']. <- buffer.
}.

>> parametry-wyszukiwania := Slurp nowy.
parametry-wyszukiwania select: ['*'], from users where: ['id = 2'].
Wyjście pisz: (parametry-wyszukiwania obtain), nowa-linia.
