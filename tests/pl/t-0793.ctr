Server init.

>> BD := Maria-DB nowy host: ['localhost'],
	użytkownik: ['xo'],
	hasło: ['pass123'],
	nazwa-bazy: ['xobase'],
	połącz.

{
	BD zapytanie:
	['DROP TABLE movies'],
	wykonaj.
} przechwyć: { Nic. }, uruchom.

BD zapytanie:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
wykonaj.

BD zapytanie: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parametry: ( Lista nowy ; ['Halloween'] ),
wykonaj.

BD zapytanie: ['SELECT * FROM movies'],
pobierz: { :film
	Wyjście pisz: film title, nowa-linia.
}.

