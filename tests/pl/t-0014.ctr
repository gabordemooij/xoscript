>> Powitacz := Obiekt nowy.
Powitacz na: ['stwórz'] wykonaj: {
	>> pw := Obiekt nowy.
	pw na: ['setName:'] wykonaj: { :imię
		własny nazwa := imię.
	}.
	pw na: ['przywitaj'] wykonaj: {
		Wyjście pisz: własny nazwa.
	}. <- pw.
}.
>> a := Powitacz stwórz.
>> b := Powitacz stwórz.
a setName: ['JEDEN'].
b setName: ['DWA'].
a przywitaj.
b przywitaj.
>> c := a nowy.
c setName: ['TRZY'].
c przywitaj.
>> d := a nowy.
d setName: ['CZTERY'].
d przywitaj.
c przywitaj.
