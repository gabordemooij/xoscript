>> Greeter := Obiekt nowy.
Greeter na: ['make'] wykonaj: {
	>> gr := Obiekt nowy.
	gr na: ['setName:'] wykonaj: { :aname
		własny nazwa := aname.
	}.
	gr na: ['greet'] wykonaj: {
		Wyjście pisz: własny nazwa.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a nowy.
c setName: ['THREE'].
c greet.
>> d := a nowy.
d setName: ['FOUR'].
d greet.
c greet.
