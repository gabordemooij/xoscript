60 × {
	>> x := (Liczba losowa % 6) + 1.
	(x ≤ 6) fałsz: { Wyjście pisz: ['BŁĄD']. }.
	(x ≥0) fałsz: { Wyjście pisz: ['BŁĄD']. }.
	x := (Liczba losowa % 3) + 1.
	(x < 3) fałsz: { Wyjście pisz: ['BŁĄD']. }.
	(x>-1) fałsz: { Wyjście pisz: ['BŁĄD']. }.
	x := ((Logiczny rzut) liczba).
	(x = 0 lub: x = 1) fałsz: { Wyjście pisz: ['BŁĄD']. }.
	x := ((Prawda rzut) liczba).
	(x = 0 lub: x = 1) fałsz: { Wyjście pisz: ['BŁĄD']. }.
	x := (Logiczny rzut albo: ['ORZEŁ'] albo: ['RESZKA']).
	((x = ['ORZEŁ']) lub: (x = ['RESZKA'])) fałsz: { Wyjście pisz: ['BŁĄD']. }.
}.
Wyjście pisz: ['GOTOWE'].

