60 × {
	>> x := (Liczba random % 6) + 1.
	(x ≤ 6) fałsz: { Wyjście pisz: ['FAIL']. }.
	(x ≥0) fałsz: { Wyjście pisz: ['FAIL']. }.
	x := (Liczba random % 3) + 1.
	(x < 3) fałsz: { Wyjście pisz: ['FAIL']. }.
	(x>-1) fałsz: { Wyjście pisz: ['FAIL']. }.
	x := ((Logiczny flip) liczba).
	(x = 0 lub: x = 1) fałsz: { Wyjście pisz: ['FAIL']. }.
	x := ((Prawda flip) liczba).
	(x = 0 lub: x = 1) fałsz: { Wyjście pisz: ['FAIL']. }.
	x := (Logiczny flip albo: ['HEAD'] albo: ['TAIL']).
	((x = ['HEAD']) lub: (x = ['TAIL'])) fałsz: { Wyjście pisz: ['FAIL']. }.
}.
Wyjście pisz: ['DONE'].

