Program zarządzanie-pamięcią: 4.

>> Doubler := Obiekt nowy.
>> Multiplier := Obiekt nowy.
Doubler na: ['double:and:'] wykonaj: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier na: ['multiply:and:'] wykonaj: { :x :y <- (x × y).
}.

Wyjście pisz: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), nowa-linia.
