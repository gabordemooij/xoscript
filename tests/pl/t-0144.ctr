



>> CoffeeGrounds := Obiekt nowy.
CoffeeGrounds na: ['extract'] wykonaj: { <- ['coffee']. }.

>> CoffeeMachine := Obiekt nowy.
CoffeeMachine na: ['init'] wykonaj: {
	własny coffeegrounds := CoffeeGrounds nowy.
}.
CoffeeMachine na: ['nowy'] wykonaj: { <- CoffeeMachine `new init.
}.

CoffeeMachine na: ['makeTea'] wykonaj: { <- (własny tealeaves extract). }.
CoffeeMachine na: ['makeCoffee'] wykonaj: { <- (własny coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine nowy.

Wyjście pisz:
	coffeeDream 
	makeCoffee.

Wyjście pisz:
	coffeeDream 
	makeTea.
