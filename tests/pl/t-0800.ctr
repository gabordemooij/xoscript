Server init.

>> bd := Maria-DB nowy host: ['localhost'],
	użytkownik: ['xo'],
	hasło: ['pass123'],
	nazwa-bazy: ['xobase'],
	połącz.

>> parametry-wyszukiwania := bd zapytanie: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parametry: ( Lista nowy ; ['abc'] ; 12.35 ; 6 ). # zapytania sparametryzowane

{  parametry-wyszukiwania wykonaj. bd zatwierdź. } przechwyć: { :e bd wycofaj.  }, uruchom.

Wyjście pisz: ['Czy możemy wstawiać? '] + ( parametry-wyszukiwania insert-id > 0 ), nowa-linia.
