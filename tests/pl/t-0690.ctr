# test bazy danych
# wymaganą konfigurację znajdziesz w przykładzie server.xo

Server init.
Wyjście pisz: ['Test bazy danych'], nowa-linia.

>> bd := Maria-DB nowy host: ['localhost'],
	użytkownik: ['xo'], hasło: ['pass123'], nazwa-bazy: ['xobase'], połącz.

Wyjście pisz: ['Czy możemy się połączyć? '] + bd połączono?, nowa-linia.

>> parametry-wyszukiwania := bd zapytanie: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parametry: ( Lista nowy ; ['abc'] ; 12.35 ; 6 ). # zapytania sparametryzowane

{  parametry-wyszukiwania wykonaj. bd zatwierdź. } przechwyć: { :e bd wycofaj.  }, uruchom.

Wyjście pisz: ['Czy możemy wstawiać? '] + ( parametry-wyszukiwania insert-id > 0 ), nowa-linia.

>> x := 0.
>> parametry-wyszukiwania :=
bd zapytanie: ['SELECT * FROM book order by id desc limit 2'], 
pobierz: { :rząd 
	x dodaj: 1.
	Prawda przerwij. # musi posprzątać, bez 'Commands out of sync'
}.

>> parametry-wyszukiwania :=
bd zapytanie: ['SELECT * FROM book order by id desc limit 2'], 
pobierz: { :rząd
	x dodaj: 1.
	Prawda przerwij.
}.

(x > 0) prawda: {
	Wyjście pisz: ['Czy możemy przerwać w trakcie pobierania? '].
}.

Wyjście pisz: Prawda, nowa-linia.