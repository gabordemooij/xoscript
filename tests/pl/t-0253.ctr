#Linux
>> OS := Program ustawienie: ['OS'].

>> clock := Moment nowy.
	
(OS = ['Haiku']) prawda: {
	clock strefa: ['CET'],
	rok: 2017, miesiąc: 7, dzień: 13,
	godzina: 18, minuta: 0, sekunda: 0.
}, inaczej: {
	clock strefa: ['Europe/Amsterdam'],
	rok: 2017, miesiąc: 7, dzień: 13,
	godzina: 18, minuta: 0, sekunda: 0.
}.

clock na: ['tell'] wykonaj: {
	Wyjście pisz: sam, nowa-linia.
}.


clock dodaj: 2    godzina, tell.
clock dodaj: 1    godzina, tell.
clock dodaj: 19 minuta, tell.
clock dodaj: 1  minuta, tell.
clock dodaj: 1  minuta, tell.
clock dodaj: 19 sekunda, tell.
clock dodaj: 1  sekunda, tell.
clock dodaj: 1  sekunda, tell.
clock dodaj: 2    rok, tell.
clock dodaj: 1    rok, tell.

(OS = ['Haiku']) prawda: {
clock dodaj: 5   miesiąc.
clock strefa: ['CEST'], tell.
}, inaczej: {
	clock dodaj: 5   miesiąc, tell.
}.

clock dodaj: 1   miesiąc, tell.
clock dodaj: 19    dzień, tell.
clock dodaj: 1    godzina, tell.
clock dodaj: 120  yard, tell.
