#Linux
>> OS := Program ustawienie: ['OS'].

>> zegar := Moment nowy.
	
(OS = ['Haiku']) prawda: {
	zegar strefa: ['CET'],
	rok: 2017, miesiąc: 7, dzień: 13,
	godzina: 18, minuta: 0, sekunda: 0.
}, inaczej: {
	zegar strefa: ['Europe/Amsterdam'],
	rok: 2017, miesiąc: 7, dzień: 13,
	godzina: 18, minuta: 0, sekunda: 0.
}.

zegar na: ['podaj'] wykonaj: {
	Wyjście pisz: sam, nowa-linia.
}.


zegar dodaj: 2    godzina, podaj.
zegar dodaj: 1    godzina, podaj.
zegar dodaj: 19 minuta, podaj.
zegar dodaj: 1  minuta, podaj.
zegar dodaj: 1  minuta, podaj.
zegar dodaj: 19 sekunda, podaj.
zegar dodaj: 1  sekunda, podaj.
zegar dodaj: 1  sekunda, podaj.
zegar dodaj: 2    rok, podaj.
zegar dodaj: 1    rok, podaj.

(OS = ['Haiku']) prawda: {
zegar dodaj: 5   miesiąc.
zegar strefa: ['CEST'], podaj.
}, inaczej: {
	zegar dodaj: 5   miesiąc, podaj.
}.

