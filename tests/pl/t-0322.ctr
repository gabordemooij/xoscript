

>> Matryoshka := Obiekt nowy.
Matryoshka na: ['double:'] wykonaj: { :secret
	własny secret := secret × 2.
}.
Matryoshka na: ['nowy:'] wykonaj: { :secret
	>> answer := Nic.
	>> t := (secret > 255).
	Wyjście pisz: (secret + [' | '] + t), nowa-linia.
	t prawda: {
		answer := secret.
	}, inaczej: {
		answer := Matryoshka rekurencyjny nowy: (sam double: secret).
	}. <- answer.
}.

>> x := Matryoshka nowy: 2.
