

>> Matrioszka := Obiekt nowy.
Matrioszka na: ['double:'] wykonaj: { :sekret
	własny sekret := sekret × 2.
}.
Matrioszka na: ['nowy:'] wykonaj: { :sekret
	>> werdykt := Nic.
	>> t := (sekret > 255).
	Wyjście pisz: (sekret + [' | '] + t), nowa-linia.
	t prawda: {
		werdykt := sekret.
	}, inaczej: {
		werdykt := Matrioszka rekurencyjny nowy: (sam double: sekret).
	}. <- werdykt.
}.

>> x := Matrioszka nowy: 2.
