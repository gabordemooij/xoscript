Wyjście pisz: ['Obiekt testowy'], nowa-linia.
>> a := Obiekt nowy. 

a na: ['state:'] wykonaj: { :list
	własny list := list. 
}.

a na: ['stan'] wykonaj: {
	Wyjście pisz: własny list, nowa-linia.
}.

a state: ( Lista nowy ; ['elementlisty'] ; ['element2'] ).
a stan.

a save-as: ['/tmp/a.bin'].
Wyjście pisz: ['========== PONOWNE WCZYTYWANIE SNAP:'], nowa-linia.
>> b := Obiekt load-from: ['/tmp/a.bin'].
b stan.