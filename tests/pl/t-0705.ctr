

>> obj := Obiekt nowy.

obj na: ['greet'] wykonaj: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj na: ['task'] wykonaj: {
	własny property := 123.
	{
		# try binds self/own to object instead of block
		Wyjście pisz: sam greet.
		Wyjście pisz: własny property.
		1 / 0.
	} przechwyć: {
		Wyjście pisz: sam greet.
		Wyjście pisz: własny property.
		Wyjście pisz: ['ok'].
	}, spróbuj.
}.

obj task.