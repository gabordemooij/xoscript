

>> ob := Obiekt nowy.

ob na: ['przywitaj'] wykonaj: {
	<- ['cześć'].
}.

# musi wypisać hi123hi123ok
ob na: ['zadanie'] wykonaj: {
	własny właściwość := 123.
	{
		# try wiąże sam/własny z obiektem zamiast z blokiem
		Wyjście pisz: sam przywitaj.
		Wyjście pisz: własny właściwość.
		1 / 0.
	} przechwyć: {
		Wyjście pisz: sam przywitaj.
		Wyjście pisz: własny właściwość.
		Wyjście pisz: ['ok'].
	}, spróbuj.
}.

ob zadanie.