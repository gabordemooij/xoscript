Liczba na: ['roman'] wykonaj: {
	>> liczba := sam kopiuj.
	>> roman := [''].
	{
		{
			(liczba ≥ 1000) prawda: {
				roman dołącz: ['Ⅿ'].
				liczba odejmij: 1000.
			}, przerwij.
		
			(liczba ≥ 500) prawda: {
				roman dołącz: ['Ⅾ'].
				liczba odejmij: 500.
			}, przerwij.
		
			(liczba ≥ 100) prawda: {
				roman dołącz: ['Ⅽ'].
				liczba odejmij: 100.
			}, przerwij.
		
			(liczba ≥ 50) prawda: {
				roman dołącz: ['Ⅼ'].
				liczba odejmij: 50.
			}, przerwij.
		
			(liczba ≥ 50) prawda: {
				roman dołącz: ['Ⅼ'].
				liczba odejmij: 50.
			}, przerwij.
		
			(liczba ≥ 10) prawda: {
				roman dołącz: ['Ⅹ'].
				liczba odejmij: 10.
			}, przerwij.
			
			(liczba ≥ 9) prawda: {
				roman dołącz: ['Ⅸ'].
				liczba odejmij: 9.
			}, przerwij.
			
			(liczba ≥ 5) prawda: {
				roman dołącz: ['Ⅴ'].
				liczba odejmij: 5.
			}, przerwij.
			
			(liczba ≥ 4) prawda: {
				roman dołącz: ['Ⅳ'].
				liczba odejmij: 4.
			}, przerwij.
			
			(liczba ≥ 1) prawda: {
				roman dołącz: ['Ⅰ'].
				liczba odejmij: 1.
			}, przerwij.
		} procedura.
	} dopóki: { <- liczba > 0. }. <- roman.
}.

Wyjście pisz: 1 roman, nowa-linia.
Wyjście pisz: 2 roman, nowa-linia.
Wyjście pisz: 4 roman, nowa-linia.
Wyjście pisz: 8 roman, nowa-linia.
Wyjście pisz: 16 roman, nowa-linia.
Wyjście pisz: 32 roman, nowa-linia.
Wyjście pisz: 64 roman, nowa-linia.
