Liczba na: ['rzymska'] wykonaj: {
	>> liczba := sam kopiuj.
	>> rzymska := [''].
	{
		{
			(liczba ≥ 1000) prawda: {
				rzymska dołącz: ['Ⅿ'].
				liczba odejmij: 1000.
			}, przerwij.
		
			(liczba ≥ 500) prawda: {
				rzymska dołącz: ['Ⅾ'].
				liczba odejmij: 500.
			}, przerwij.
		
			(liczba ≥ 100) prawda: {
				rzymska dołącz: ['Ⅽ'].
				liczba odejmij: 100.
			}, przerwij.
		
			(liczba ≥ 50) prawda: {
				rzymska dołącz: ['Ⅼ'].
				liczba odejmij: 50.
			}, przerwij.
		
			(liczba ≥ 50) prawda: {
				rzymska dołącz: ['Ⅼ'].
				liczba odejmij: 50.
			}, przerwij.
		
			(liczba ≥ 10) prawda: {
				rzymska dołącz: ['Ⅹ'].
				liczba odejmij: 10.
			}, przerwij.
			
			(liczba ≥ 9) prawda: {
				rzymska dołącz: ['Ⅸ'].
				liczba odejmij: 9.
			}, przerwij.
			
			(liczba ≥ 5) prawda: {
				rzymska dołącz: ['Ⅴ'].
				liczba odejmij: 5.
			}, przerwij.
			
			(liczba ≥ 4) prawda: {
				rzymska dołącz: ['Ⅳ'].
				liczba odejmij: 4.
			}, przerwij.
			
			(liczba ≥ 1) prawda: {
				rzymska dołącz: ['Ⅰ'].
				liczba odejmij: 1.
			}, przerwij.
		} procedura.
	} dopóki: { <- liczba > 0. }. <- rzymska.
}.

Wyjście pisz: 1 rzymska, nowa-linia.
Wyjście pisz: 2 rzymska, nowa-linia.
