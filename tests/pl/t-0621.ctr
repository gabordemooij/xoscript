>> phrases := Lista nowy
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases każdy: { :_ :phrase 
	>> e := Server base64-koduj: phrase.
	>> d := Server base64-dekoduj: e.
	Wyjście pisz: (
		message kopiuj ~encoded: e, ~decoded: d
	), nowa-linia.
}.
