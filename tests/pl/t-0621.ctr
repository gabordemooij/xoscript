>> frazy := Lista nowy
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> komunikat := ['Phrase: ~decoded base64: ~encoded'].
	
frazy każdy: { :_ :fraza 
	>> e := Server base64-koduj: fraza.
	>> d := Server base64-dekoduj: e.
	Wyjście pisz: (
		komunikat kopiuj ~encoded: e, ~decoded: d
	), nowa-linia.
}.
