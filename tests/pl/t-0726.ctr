# test buffers PKI/Sign 
Server init.

>> long := ( Lista nowy wypełnij: 1000 wartością: ['a'] ) połącz: [''].

# sign a message
Wyjście pisz: ( 
	Sejf podpisz: ['abc'] kluczem: long
), nowa-linia.

Wyjście pisz: ( 
	Sejf
		sprawdź: ['abc'] 
		podpis: long 
		kluczem: long
), nowa-linia.

Wyjście pisz: (
	Sejf skrót-hasła: long sprawdź: long
), nowa-linia.
