Server init.

>> długi := ( Lista nowy wypełnij: 1000 wartością: ['a'] ) połącz: [''].

# podpisz wiadomość
Wyjście pisz: ( 
	Sejf podpisz: ['abc'] kluczem: długi
), nowa-linia.

Wyjście pisz: ( 
	Sejf
		sprawdź: ['abc'] 
		podpis: długi 
		kluczem: długi
), nowa-linia.

Wyjście pisz: (
	Sejf skrót-hasła: długi sprawdź: długi
), nowa-linia.
