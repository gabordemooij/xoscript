


>> użytaPamięć1 := 0.
>> użytaPamięć2 := 0.
>> użytaPamięć3 := 0.
>> użytaPamięć4 := 0.

Program zarządzanie-pamięcią: 0.
>> paleta := Nic.
>> kolory := Nic.

{
paleta := Słownik nowy.
paleta 
	umieść: ['#F00'] w: ['czerwony'],
	umieść: ['#0F0'] w: ['zielony'],
	umieść: ['#00F'] w: ['niebieski'].
Wyjście pisz: ['liczba kodów RGB w palecie: '] + ( paleta liczność ), nowa-linia.
Wyjście pisz: ['kod RGB zielonego to: '] + ( paleta ? ['zielony'] ), nowa-linia.
kolory := [''].
( paleta każdy: { :nazwa :code
		kolory := kolory + ( nazwa + [':'] + code ).
} ).
Wyjście pisz: ['Wszystkie kolory w palecie: '] + kolory, nowa-linia.
} uruchom.
Program posprzątaj.
użytaPamięć1 := (Program pamięć ? 0).

