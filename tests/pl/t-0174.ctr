


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program zarządzanie-pamięcią: 0.
>> palette := Nic.
>> colors := Nic.

{
palette := Słownik nowy.
palette 
	umieść: ['#F00'] w: ['red'],
	umieść: ['#0F0'] w: ['green'],
	umieść: ['#00F'] w: ['blue'].
Wyjście pisz: ['number of RGB codes in palette: '] + ( palette liczność ), nowa-linia.
Wyjście pisz: ['RGB code of green is: '] + ( palette ? ['green'] ), nowa-linia.
colors := [''].
( palette każdy: { :nazwa :code
		colors := colors + ( nazwa + [':'] + code ).
} ).
Wyjście pisz: ['All colors in palette: '] + colors, nowa-linia.
} uruchom.
Program posprzątaj.
usedMemory1 := (Program pamięć ? 0).

{
palette := Słownik nowy.
palette 
	umieść: ['#F00'] w: ['red'],
	umieść: ['#0F0'] w: ['green'],
	umieść: ['#00F'] w: ['blue'].
