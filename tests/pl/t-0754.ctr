Wyjście pisz: ['Obiekt testowy'], nowa-linia.
>> a := Obiekt nowy. 

a na: ['item:'] wykonaj: { :wyj
	własny wyj := wyj. 
}.

a na: ['przedmiot'] wykonaj: {
	<- własny wyj.
}.

a na: ['przywitaj'] wykonaj: {
	Wyjście pisz: ['cześć z oryginalnego wyjścia!'], nowa-linia.
}.

a item: Wyjście.

Wyjście pisz: a przedmiot, nowa-linia.

>> stary-adres-wyj := a przedmiot prototyp adres-pamięci.
a save-as: ['/tmp/a.bin'].
Wyjście pisz: ['========== PONOWNE WCZYTYWANIE SNAP:'], nowa-linia.

>> b := Obiekt load-from: ['/tmp/a.bin'].

(b przedmiot prototyp adres-pamięci = stary-adres-wyj) prawda: {
	Wyjście pisz: ['Łącze obiektu ponownie dołączone.'], nowa-linia.
}.

b przedmiot pisz: ['witaj z wczytanego wyjścia!'], nowa-linia.
b przywitaj.
