#Linux

 >> t := Moment nowy.
 
t strefa: ['Europe/Amsterdam'].
t rok: 2020, miesiąc: 8, dzień: 2, godzina: 21, minuta: 2, sekunda: 1.

>> a := t godzina.
>> ams := t strefa.

t strefa: ['US/Hawaii'].
>> b := t godzina.
>> hw := t strefa.

Wyjście
pisz: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		albo: ['później'] albo: ['wcześniej']
	)
),
nowa-linia.
 