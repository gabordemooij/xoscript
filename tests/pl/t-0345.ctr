# test catch-all methods
>> x13 := Obiekt nowy.
x13 na: ['a'] wykonaj: { :a Wyjście pisz: 0, nowa-linia. }.
x13 na: ['a:'] wykonaj: { :a Wyjście pisz: a, nowa-linia. <- 5. }.
x13 na: ['a:b:'] wykonaj: { :a :b Wyjście pisz: (a + b), nowa-linia. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
