>> Grandfather := Obiekt nowy.
Grandfather na: ['greet'] wykonaj: {
	Wyjście pisz: ['Ave!'], nowa-linia.
}.
>> Father := Grandfather nowy.
Father na: ['greet'] wykonaj: {
	Wyjście pisz: ['Hello'], nowa-linia.
	sam greet.
}.
>> Son := Father nowy.
Son na: ['greet'] wykonaj: {
	Wyjście pisz: ['Hi'], nowa-linia.
	sam greet.
}.

Son greet.

>> Roundabout := Obiekt nowy.
Roundabout na: ['circle:'] wykonaj: { :x
	Wyjście pisz: x, nowa-linia.
	(x < 3) prawda: { sam rekurencyjny circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) prawda: { Wyjście pisz: x, nowa-linia. x dodaj: 1.  increment uruchom. }. }.
increment uruchom.