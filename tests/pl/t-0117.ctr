>> t := Prawda.
(t = Prawda) prawda: { Wyjście pisz: ['T']. }.
(t = Fałsz) prawda: { Wyjście pisz: ['F']. }.
Wyjście pisz: ['|'].
>> t := Fałsz.
(t = Prawda) prawda: { Wyjście pisz: ['T']. }.
(t = Fałsz) prawda: { Wyjście pisz: ['F']. }.
Wyjście pisz: ['|'].
>> f := Prawda.
(t = Prawda i: f = Fałsz) prawda: { Wyjście pisz: ['T']. }.
(t = Fałsz i: f = Prawda) prawda: { Wyjście pisz: ['F']. }.
Wyjście pisz: ['|'].
>> n := Nic.
(n Nic?) prawda: { Wyjście pisz: ['T']. }.
(n Nic?) fałsz: { Wyjście pisz: ['F']. }.
Wyjście pisz: ['|'].
(f Boolean?) prawda: { Wyjście pisz: ['T']. }.
(f Boolean?) fałsz: { Wyjście pisz: ['F']. }.



