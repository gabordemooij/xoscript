Server init.

>> DB := Maria-DB nowy host: ['localhost'],
	użytkownik: ['xo'],
	hasło: ['pass123'],
	nazwa-bazy: ['xobase'],
	połącz.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB zapytanie: SQL.

# now you don't have to set DB
query2 pobierz: { :row
	Wyjście pisz: row world, nowa-linia.
}.
