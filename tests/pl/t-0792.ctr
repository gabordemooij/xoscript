Server init.

>> BD := Maria-DB nowy host: ['localhost'],
	użytkownik: ['xo'],
	hasło: ['pass123'],
	nazwa-bazy: ['xobase'],
	połącz.
	
>> SQL := ['SELECT "hello" AS "world" '].

# szybszy sposób, pobierz zapytanie z BD:
>> zapytanie2 := BD zapytanie: SQL.

# teraz nie musisz ustawiać BD
zapytanie2 pobierz: { :rząd
	Wyjście pisz: rząd world, nowa-linia.
}.
