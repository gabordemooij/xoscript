>> parametry-wyszukiwania :=
bd zapytanie: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
pobierz: { :rząd
	Wyjście pisz: rząd datetimetest, nowa-linia.
}.
