Server init.
Wyjście pisz: ['Database datetime test'], nowa-linia.

>> db := Maria-DB nowy host: ['localhost'],
	użytkownik: ['xo'], 
	hasło: ['pass123'],
	nazwa-bazy: ['xobase'],
	połącz.

>> parametry-wyszukiwania :=
db zapytanie: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
pobierz: { :row
	Wyjście pisz: row datetimetest, nowa-linia.
}.
