
>> Greeter := Obiekt nowy.
Greeter na: ['nowy'] wykonaj: {
	własny nazwa := ['?'].
}.
Greeter na: ['name:'] wykonaj: { :nazwa
	własny nazwa := nazwa.
}.
Greeter na: ['greet'] wykonaj: {
	Wyjście pisz: (['hello[you]'] [you]: własny nazwa).
}.
>> friend := Greeter nowy.
friend name: ['1'].
friend greet.
