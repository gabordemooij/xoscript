{
	>> a := Lista nowy.
	a dołącz: 1.
	a dołącz: 2.
	Wyjście pisz: (a połącz: [',']), nowa-linia.
	a umieść: 3 w: 2.
	Wyjście pisz: (a połącz: [',']), nowa-linia.
	a umieść: 4 w: 10.
	Wyjście pisz: (a połącz: [',']), nowa-linia.
	a zdejmij-pierwszy.
	a zdejmij-pierwszy.
	a zdejmij-pierwszy.
	Wyjście pisz: (a połącz: [',']), nowa-linia.
	a umieść: 9 w: 0.
	Wyjście pisz: (a połącz: [',']), nowa-linia.
	a umieść: 6 w: -1.
} przechwyć: { :e
	Wyjście pisz: ['Uncatched error has occurred.↵'] + e, nowa-linia.
}, uruchom.


