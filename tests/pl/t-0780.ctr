Server init.

# koder JSON obsługuje tylko UTF-8, bez par zastępczych

>> słowniki := Lista nowy ;
	# {"key":"normal"} zwykłe ASCII
	( Słownik nowy umieść: ['zwykły'] w: ['key'] ) ;
	# {"key":"hello world"} znak spacji
	( Słownik nowy umieść: ['hello world'] w: ['key'] ) ;
	# {"key":"quote: \""} podwójny cudzysłów
	( Słownik nowy umieść: ['"'] w: ['key'] ) ;
	# {"key":"backslash: \\"} ukośnik wsteczny
	( Słownik nowy umieść: ['backslash: \\'] w: ['key'] ) ;
	# {"key":"slash: /"} ukośnik
	( Słownik nowy umieść: ['ukośnik: /'] w: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( Słownik nowy umieść: ['backspace: \b'] w: ['key'] ) ;
	# {"key":"formfeed: \f"} sekwencja form-feed
	( Słownik nowy umieść: ['formfeed: \f'] w: ['key'] ) ;
	# {"key":"newline: \n"} nowa linia
	( Słownik nowy umieść: ['newline: \n'] w: ['key'] ) ;
	( Słownik nowy umieść: ['newline: ↵'] w: ['key'] ) ;
	( Słownik nowy umieść: ['newline: 
	'] w: ['key'] ) ;
	# {"key":"carriage return: \r"} powrót karetki
	( Słownik nowy umieść: ['carriage return: \r'] w: ['key'] ) ;
	# {"key":"tab: \t"} tabulator
	( Słownik nowy umieść: ['tab \t'] w: ['key'] ) ;
	( Słownik nowy umieść: ['tab ⇿'] w: ['key'] ) ;
	( Słownik nowy umieść: ['tabulator  '] w: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( Słownik nowy umieść: ['NUL \u0000'] w: ['key'] ) ;
	( Słownik nowy umieść: ['NUL \0'] w: ['key'] ) ;
	# {"key":"control: \u0001"} znak sterujący 0x01
	( Słownik nowy umieść: ['control: \u0001'] w: ['key'] ) ;
	# {"key":"control: \u001F"} znak sterujący 0x1F
	( Słownik nowy umieść: ['control: \u001F'] w: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, znak 2-bajtowy
	( Słownik nowy umieść: ['unicode: é'] w: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, znak 3-bajtowy
	( Słownik nowy umieść: ['unicode: €'] w: ['key'] ) ;
	# {"key":"unicode: 日本語"} wiele 3-bajtowych znaków UTF-8
	( Słownik nowy umieść: ['unicode: 日本語'] w: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, znak 4-bajtowy
	( Słownik nowy umieść: ['unicode: 😀'] w: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + łącznik zerowej szerokości
	( Słownik nowy umieść: ['unicode: 🧑‍💻'] w: ['key'] ) ;
	# {"key":"combining: é"} akcent łączący
	( Słownik nowy umieść: ['combining: e\u0301'] w: ['key'] ) ;
	# {"key":"escaped unicode: é"} sekwencja Unicode BMP
	( Słownik nowy umieść: ['escaped unicode: \u00e9'] w: ['key'] ) ;
	# {"key":"escaped unicode: €"} sekwencja Unicode BMP
	( Słownik nowy umieść: ['escaped unicode: \u20ac'] w: ['key'] ) ;
	# {"key":"escaped unicode: 😀"} para zastępcza UTF-16
	( Słownik nowy umieść: ['escaped unicode: \ud83d\ude00'] w: ['key'] ) ;
	# {"key":""} pusta wartość
	( Słownik nowy umieść: [''] w: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} specjalne znaki ASCII
	( Słownik nowy umieść: ['@ < > & = % + ? #'] w: ['key'] ) ;
	# {"key":"single quote: '"} pojedynczy cudzysłów
	( Słownik nowy umieść: ['''] w: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} wiele sekwencji JSON
	( Słownik nowy umieść: ['multiple: \" \\ \n \r \t'] w: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} dłuższy tekst ASCII
	( Słownik nowy umieść: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] w: ['key'] ) ;
	# {"key":" value"} spacja na początku
	( Słownik nowy umieść: [' wartość'] w: ['key'] ) ;
	# {"key":"value "} spacja na końcu
	( Słownik nowy umieść: ['wartość '] w: ['key'] ) ;
	# {"key":" \t\n\r "} białe znaki
	( Słownik nowy umieść: [' \t\n\r '] w: ['key'] )
	.

słowniki każdy: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (Słownik nowy umieść: d key w: ['key']).
	>> b := JSON jsonify: (Słownik nowy umieść: ['value'] w: d key).
	>> e := JSON obiekt: a.
	>> f := JSON obiekt: b.
	((e key = d key i: (f ? d key = ['value'])) lub: (e key = ['NUL ?'])) prawda: {
		Wyjście pisz: ['OK'], nowa-linia.
	}, inaczej: {
		Wyjście pisz: ['Nie można poprawnie zakodować/zdekodować: '] + d + j, nowa-linia.
		Program koniec.
	}.
}.
