#Linux
>> OS := Program system: (Polecenie uname -s), przytnij.

>> Slurp := Obiekt nowy.
Slurp na: ['nowy'] wykonaj: {
	własny str := [''].
}.
Slurp na: ['odpowiedz:'] wykonaj: { :blah
		(własny str ≠ ['']) prawda: {
			własny str dołącz: [' '].
		}.
		własny str dołącz: blah.
}.
Slurp na: ['odpowiedz:i:'] wykonaj: { :blah :blahah
		(własny str ≠ ['']) prawda: {
			własny str dołącz: [' '].
		}.
		(blah długość > 1) prawda: {
			własny str dołącz: (blah od: 0 długość: (blah długość - 1)).
		}, inaczej: {
			własny str dołącz: blah.
		}.
		własny str dołącz: [' '].
		własny str dołącz: blahah.
}.
Slurp na: ['uzyskaj'] wykonaj: {
	>> bufor := własny str.
	własny str := ['']. <- bufor.
}.
>> large text := [''].
{
	large text dołącz: ['hello'].
} × 1000.


Wyjście pisz: (
	Program system: (
		Slurp nowy
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) uzyskaj
).

