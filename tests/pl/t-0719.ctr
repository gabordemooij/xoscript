Server init.
>> fmt := Format nowy: ['%#3x'].

>> blob := Blob nowy: 4.
blob bytes: ( 
	Lista nowy ; 0 ; 1 ; 2 ; 3
).

>> file := Plik nowy: ['/tmp/blob'].
file blob: blob.
blob zwolnij.

>> czytaj := file blob.
czytaj 
od: 0 
długość: 4, 
wykonuj każdy: { :i :b 
	Wyjście
	pisz: (fmt zastosuj-całkowitą: b),
	nowa-linia.
}.
czytaj zwolnij.
