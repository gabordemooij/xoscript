Wyjście pisz: ['Test object'], nowa-linia.
>> a := Obiekt nowy. 

a na: ['item:'] wykonaj: { :moment
	własny moment := moment. 
}.

a na: ['item'] wykonaj: { <- własny moment.
}.

>> today := Moment nowy strefa: ['CEST'], rok: 2026, miesiąc: 7.
a item: today.
Wyjście pisz: a item, nowa-linia.
a save-as: ['/tmp/a.bin'].
Wyjście pisz: ['========== RELOADING SNAP:'], nowa-linia.
>> b := Obiekt load-from: ['/tmp/a.bin'].
Wyjście pisz: b item, nowa-linia.
