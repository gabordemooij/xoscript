>> Do-Zrobienia := Obiekt nowy.

Do-Zrobienia na: ['nowy'] wykonaj: {
	własny list := Lista nowy.
}.

Do-Zrobienia na: ['nieuw'] wykonaj: {
	własny list := Lista nowy.
}.

Do-Zrobienia na: ['+'] wykonaj: { :zadanie
	własny list dołącz: zadanie.
}.

Do-Zrobienia na: ['number of tasks?'] wykonaj: { <-  własny list liczność.
}.

>> zadania := 
	Do-Zrobienia nowy 
	+ ['ugotować obiad'] 
	+ ['posprzątać pokój'].
	
Wyjście pisz: ['You have $ tasks to do'] $ zadania number of tasks?.
