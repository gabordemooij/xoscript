>> To-Do := Obiekt nowy.

To-Do na: ['nowy'] wykonaj: {
	własny list := Lista nowy.
}.

To-Do na: ['nieuw'] wykonaj: {
	własny list := Lista nowy.
}.

To-Do na: ['+'] wykonaj: { :task
	własny list dołącz: task.
}.

To-Do na: ['number of tasks?'] wykonaj: { <-  własny list liczność.
}.

>> todos := 
	To-Do nowy 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Wyjście pisz: ['You have $ tasks to do'] $ todos number of tasks?.
