
>> dictionary := (
	Słownik nowy
		umieść: ['b'] w: ['a'],
		umieść: ['a'] w: ['b'],
		umieść: ['z'] w: ['x'],
		umieść: ['hello'] w: ['hallo'],
		umieść: ['human'] w: ['human']
).

>> comparisons := Lista nowy.
dictionary każdy: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a porównaj: b)
	).
}.

comparisons sortuj: { :a :b <- ( a porównaj: b ). }.
Wyjście pisz: ( comparisons połącz: ['↵'] ), nowa-linia.
comparisons połącz: ['↵'].
