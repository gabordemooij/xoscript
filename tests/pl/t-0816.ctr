# a format must fit the type of the value, the type can come from a client
>> spróbuj := { :format :value
	{ Wyjście pisz: ( (Format nowy: format) zastosuj: value ), nowa-linia. } przechwyć: { :e Wyjście pisz: e, nowa-linia. }, uruchom.
}.
>> try-int := { :format :value
	{ Wyjście pisz: ( (Format nowy: format) zastosuj-całkowitą: value ), nowa-linia. } przechwyć: { :e Wyjście pisz: e, nowa-linia. }, uruchom.
}.

# fits
spróbuj zastosuj: ['|%s|'] i: ['text'].
spróbuj zastosuj: ['%06.2f'] i: 5.5.
spróbuj zastosuj: ['100%% %s'] i: ['sure'].
try-int zastosuj: ['%03d'] i: 7.
try-int zastosuj: ['%x'] i: 255.
spróbuj zastosuj: ['%d'] i: (Int64 nowy z-tekstu: ['12']).
spróbuj zastosuj: ['%lld'] i: (Int64 nowy z-tekstu: ['12']).
spróbuj zastosuj: ['%.1lf'] i: 5.5.
try-int zastosuj: ['%hd'] i: 7.

# does not fit
spróbuj zastosuj: ['%s'] i: 12345.
spróbuj zastosuj: ['%d'] i: 12345.
spróbuj zastosuj: ['%f'] i: ['text'].
try-int zastosuj: ['%d'] i: ['text'].
try-int zastosuj: ['%s'] i: 5.
spróbuj zastosuj: ['%s %s'] i: ['text'].
spróbuj zastosuj: ['%n'] i: ['text'].
spróbuj zastosuj: ['%*s'] i: ['text'].
spróbuj zastosuj: ['%'] i: ['text'].

# length modifier does not fit
spróbuj zastosuj: ['%ls'] i: ['text'].
spróbuj zastosuj: ['%Lf'] i: 5.5.
try-int zastosuj: ['%ld'] i: 7.
try-int zastosuj: ['%lld'] i: 7.
spróbuj zastosuj: ['%Ld'] i: (Int64 nowy z-tekstu: ['12']).

# a width that does not fit printf must give an error, not a crash
spróbuj zastosuj: ['%99999999999s'] i: ['text'].
