# format musi pasować do typu wartości, typ może pochodzić od klienta
>> spróbuj := { :wzórFormatu :value
	{ Wyjście pisz: ( (Format nowy: wzórFormatu) zastosuj: value ), nowa-linia. } przechwyć: { :e Wyjście pisz: e, nowa-linia. }, uruchom.
}.
>> spróbuj-całkowitą := { :wzórFormatu :value
	{ Wyjście pisz: ( (Format nowy: wzórFormatu) zastosuj-całkowitą: value ), nowa-linia. } przechwyć: { :e Wyjście pisz: e, nowa-linia. }, uruchom.
}.

# pasuje
spróbuj zastosuj: ['|%s|'] i: ['text'].
spróbuj zastosuj: ['%06.2f'] i: 5.5.
spróbuj zastosuj: ['100%% %s'] i: ['jasne'].
spróbuj-całkowitą zastosuj: ['%03d'] i: 7.
spróbuj-całkowitą zastosuj: ['%x'] i: 255.
spróbuj zastosuj: ['%d'] i: (Int64 nowy z-tekstu: ['12']).
spróbuj zastosuj: ['%lld'] i: (Int64 nowy z-tekstu: ['12']).
spróbuj zastosuj: ['%.1lf'] i: 5.5.
spróbuj-całkowitą zastosuj: ['%hd'] i: 7.

# nie pasuje
spróbuj zastosuj: ['%s'] i: 12345.
spróbuj zastosuj: ['%d'] i: 12345.
spróbuj zastosuj: ['%f'] i: ['text'].
spróbuj-całkowitą zastosuj: ['%d'] i: ['text'].
spróbuj-całkowitą zastosuj: ['%s'] i: 5.
spróbuj zastosuj: ['%s %s'] i: ['text'].
spróbuj zastosuj: ['%n'] i: ['text'].
spróbuj zastosuj: ['%*s'] i: ['text'].
spróbuj zastosuj: ['%'] i: ['text'].

# modyfikator długości nie pasuje
spróbuj zastosuj: ['%ls'] i: ['text'].
spróbuj zastosuj: ['%Lf'] i: 5.5.
spróbuj-całkowitą zastosuj: ['%ld'] i: 7.
spróbuj-całkowitą zastosuj: ['%lld'] i: 7.
spróbuj zastosuj: ['%Ld'] i: (Int64 nowy z-tekstu: ['12']).

# szerokość, która nie pasuje do printf, musi dać błąd, a nie awarię
spróbuj zastosuj: ['%99999999999s'] i: ['text'].
