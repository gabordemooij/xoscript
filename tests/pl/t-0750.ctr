Wyjście pisz: ['Test object'], nowa-linia.
>> a := Obiekt nowy. 

a na: ['item:'] wykonaj: { :nil
	własny nil := nil. 
}.

a na: ['item'] wykonaj: { <- własny nil.
}.

a item: Nic.

