# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Sejf generuj-klucze.

# private (secret) key
>> sk := keys pierwszy.

# public key
>> pk := keys ostatni.

# sign a message
>> sig := Sejf podpisz: ['abc'] kluczem: sk.

# check message (ok)
Wyjście pisz: ( 
	Sejf
		sprawdź: ['abc'] 
		podpis: sig 
		kluczem: pk 
), nowa-linia.

# check message (fail)
Wyjście pisz: ( 
	Sejf 
		sprawdź: ['abd'] 
		podpis: sig 
		kluczem: pk 
), nowa-linia.