# klucz publiczny (do zabezpieczania API itp.)
Server init.

# wygeneruj klucze
>> klucze := Sejf generuj-klucze.

# klucz prywatny (tajny)
>> kt := klucze pierwszy.

# klucz publiczny
>> kp := klucze ostatni.

# podpisz wiadomość
>> podp := Sejf podpisz: ['abc'] kluczem: kt.

# sprawdź wiadomość (ok)
Wyjście pisz: ( 
	Sejf
		sprawdź: ['abc'] 
		podpis: podp 
		kluczem: kp 
), nowa-linia.

# sprawdź wiadomość (nieudane)
Wyjście pisz: ( 
	Sejf 
		sprawdź: ['abd'] 
		podpis: podp 
		kluczem: kp 
), nowa-linia.