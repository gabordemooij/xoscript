Wyjście pisz: ['Kontynuuj pętlę for, Nie - przed 6 i wyżej.'], nowa-linia.
{ :i
	Wyjście pisz: (i + 1), nowa-linia.
	((i + 1) > 4) kontynuuj.
	Wyjście pisz: ['-'].
} × 10.

>> x := 0.
>> xMniejszeNiż10 := { <- ( x < 10 ). }.
Wyjście nowa-linia.
Wyjście pisz: ['Kontynuuj while-true, Nie --> przed 5 i wyżej.'], nowa-linia.
{
	Wyjście pisz: ['iteration #'] + x, nowa-linia.
	x dodaj: 1.
	((x < 5) nie) kontynuuj.
	Wyjście pisz: ['-->'].
} dopóki: xMniejszeNiż10.
Wyjście nowa-linia.
Wyjście pisz: ['Kontynuuj while-false, Nie - tylko przed 3.'], nowa-linia.
{
	Wyjście pisz: ['iteration #'] + x, nowa-linia.
	x odejmij: 1.
	(x = 3) kontynuuj.
	Wyjście pisz: ['-'].
} dopóki: { <- ( x > 0). }.

Wyjście nowa-linia.
Wyjście pisz: ['Kontynuuj pętlę times, Nie ||| przed 3.'], nowa-linia.
{ :i
	Wyjście pisz: ['iteration #'] + i, nowa-linia.
	(i = 2) kontynuuj.
	Wyjście pisz: ['|||'].
} × 5.

Wyjście nowa-linia.

{ Prawda kontynuuj. Wyjście pisz: ['tego nie pisz!'], nowa-linia. } uruchom.

{ Prawda kontynuuj. Wyjście pisz: ['tego nie pisz!'], nowa-linia. } przechwyć: { Wyjście pisz: ['Tego nie łap!']. }, uruchom.

Wyjście pisz: ['Test pętli each tablicy: 0, ... ,2'], nowa-linia.
(Lista ← 1 ; 2 ; 3) odwzoruj: { :i
	(i = 1) kontynuuj.
	Wyjście pisz: ['iteration #'] + (i - 0), nowa-linia.
}.

Wyjście pisz: ['Test pętli each mapy: tylko c'], nowa-linia.
>> m := Słownik nowy.
m umieść: ['first'] w: ['a'], umieść: ['second'] w: ['b'], umieść: ['trzeci'] w: ['c'].
m każdy: { :k :v
	(k ≠ ['c']) kontynuuj.
	Wyjście pisz: ['iteration'] + k + v, nowa-linia.
}.

