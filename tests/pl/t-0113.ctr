Wyjście pisz: ['Continue for-loop, No - before 6 and up.'], nowa-linia.
{ :i
	Wyjście pisz: (i + 1), nowa-linia.
	((i + 1) > 4) kontynuuj.
	Wyjście pisz: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Wyjście nowa-linia.
Wyjście pisz: ['Continue while-true, No --> before 5 and up.'], nowa-linia.
{
	Wyjście pisz: ['iteration #'] + x, nowa-linia.
	x dodaj: 1.
	((x < 5) nie) kontynuuj.
	Wyjście pisz: ['-->'].
} dopóki: xIsLessThan10.
Wyjście nowa-linia.
Wyjście pisz: ['Continue while-false, No - before 3 only.'], nowa-linia.
{
	Wyjście pisz: ['iteration #'] + x, nowa-linia.
	x odejmij: 1.
	(x = 3) kontynuuj.
	Wyjście pisz: ['-'].
} dopóki: { <- ( x > 0). }.

Wyjście nowa-linia.
Wyjście pisz: ['Continue times-loop, No ||| before 3.'], nowa-linia.
{ :i
	Wyjście pisz: ['iteration #'] + i, nowa-linia.
	(i = 2) kontynuuj.
	Wyjście pisz: ['|||'].
} × 5.

Wyjście nowa-linia.

{ Prawda kontynuuj. Wyjście pisz: ['dont write this!'], nowa-linia. } uruchom.

{ Prawda kontynuuj. Wyjście pisz: ['dont write this!'], nowa-linia. } przechwyć: { Wyjście pisz: ['Dont catch this!']. }, uruchom.

Wyjście pisz: ['Test Array each-loop: 0, ... ,2'], nowa-linia.
(Lista ← 1 ; 2 ; 3) odwzoruj: { :i
	(i = 1) kontynuuj.
	Wyjście pisz: ['iteration #'] + (i - 0), nowa-linia.
}.

Wyjście pisz: ['Test Map each-loop: c only'], nowa-linia.
>> m := Słownik nowy.
m umieść: ['first'] w: ['a'], umieść: ['second'] w: ['b'], umieść: ['third'] w: ['c'].
m każdy: { :k :v
	(k ≠ ['c']) kontynuuj.
	Wyjście pisz: ['iteration'] + k + v, nowa-linia.
}.

