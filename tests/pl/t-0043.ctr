>> powtarzacz := Obiekt nowy.
powtarzacz na: ['odpowiedz:'] wykonaj: { :co
	Wyjście pisz: co + [' '].
}.
powtarzacz na: ['odpowiedz:i:'] wykonaj: { :co :say
	Wyjście pisz: co, pisz: say + [' '].
}.
powtarzacz na: ['odpowiedz:i:i:'] wykonaj: { :co :say :więcej
	Wyjście pisz: co, pisz: say, pisz: więcej.
}.
powtarzacz powtórz.
powtarzacz everything: ['Mówię.'].
powtarzacz and: ['I '] everything: ['robię.'].
