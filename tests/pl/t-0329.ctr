Wyjście pisz: ((Lista nowy
	na: ['plaque:'] wykonaj: { :x własny o := x. },
	na: ['plaque']  wykonaj: { <- własny o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Lista ← 1)
	~ (Lista ← 1 ; 2)
	~ (Lista ← 1 ; 2 ; 3)
	~ (Lista ← 1 ; 2 ; 3 ; 4)
	~ (Lista ← 1 ; 2 ; 3 ; 4 ; 5)
) każdy: { :i :el
	{ Wyjście pisz: to-zadanie. } × el liczność.
	Wyjście nowa-linia.
}) plaque, nowa-linia.


