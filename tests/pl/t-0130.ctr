# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Program ustawienie: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server powiąż: ( Lista nowy ;
 libname ; ['fopen'] ;
 ( Lista nowy ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
powiąż: ( Lista nowy ;
 Nic ; # means same lib
 ['fread'] ;
 ( Lista nowy ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nic ; # means same object (i.e. Stream)
 ['fread']
),
powiąż: (
 Lista nowy ;
 Nic ; # means same lib
 ['fwrite'] ;
 ( Lista nowy ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nic ; # means same lib
 ['fwrite']
),
powiąż: (
 Lista nowy ;
 Nic ; # means same lib
 ['rewind'] ;
 ( Lista nowy ; ['pointer'] ) ;
 ['int'] ;
 Nic ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> ścieżka := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: ścieżka mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream wiadomość: ['fwrite'] argumenty: (Lista nowy ; str ; 1 ; 6 ; fd ).
Wyjście pisz: bytes-written, nowa-linia.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob nowy: 20.

# read from file
>> bytes-read := Stream wiadomość: ['fread'] argumenty: (Lista nowy ; buf ; 1 ; 6 ; fd ).
Wyjście pisz: bytes-read, nowa-linia.
Wyjście pisz: buf, nowa-linia.

# free memory
str  zwolnij.
ścieżka zwolnij.
mode zwolnij.
buf  zwolnij.


