# użycie FFI z wtyczką Server

# połączenie z libc (zależne od platformy)
>> nazwaBiblioteki := Program ustawienie: ['FFITESTLIB'].

# powiąż funkcje stdio z C do zaawansowanych operacji na plikach
Server powiąż: ( Lista nowy ;
 nazwaBiblioteki ; ['fopen'] ;
 ( Lista nowy ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
powiąż: ( Lista nowy ;
 Nic ; # oznacza tę samą bibliotekę
 ['fread'] ;
 ( Lista nowy ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nic ; # oznacza ten sam obiekt (tj. Strumień)
 ['fread']
),
powiąż: (
 Lista nowy ;
 Nic ; # oznacza tę samą bibliotekę
 ['fwrite'] ;
 ( Lista nowy ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nic ; # oznacza tę samą bibliotekę
 ['fwrite']
),
powiąż: (
 Lista nowy ;
 Nic ; # oznacza tę samą bibliotekę
 ['rewind'] ;
 ( Lista nowy ; ['pointer'] ) ;
 ['int'] ;
 Nic ; # oznacza tę samą bibliotekę
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> ścieżka := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# otwórz plik przez fopen(path, mode)
>> fd := Stream path: ścieżka mode: mode.

# zapisz bajty z bufora łańcuch do pliku
>> zapisane-bajty := Stream wiadomość: ['fwrite'] argumenty: (Lista nowy ; str ; 1 ; 6 ; fd ).
Wyjście pisz: zapisane-bajty, nowa-linia.

# przewiń wskaźnik pliku na początek
Stream rewind: fd.

# przydziel bufor
>> buf := Blob nowy: 20.

# czytaj z pliku
>> odczytane-bajty := Stream wiadomość: ['fread'] argumenty: (Lista nowy ; buf ; 1 ; 6 ; fd ).
Wyjście pisz: odczytane-bajty, nowa-linia.
Wyjście pisz: buf, nowa-linia.

# zwolnij pamięć
str  zwolnij.
ścieżka zwolnij.
mode zwolnij.
buf  zwolnij.


