Wyjście pisz: ['1,2,3,4,5,6,7,8,9,A,'], nowa-linia.
>> Zakres := Obiekt nowy.
Zakres na: ['initialize:'] wykonaj: { :x własny właściwość := x. }.
Zakres na: ['potwierdź'] wykonaj: { Wyjście pisz: [',']. }.
Zakres na: ['test'] wykonaj: {
	Wyjście pisz: własny właściwość.
	sam potwierdź.
	( 1 = 1 ) prawda: { Wyjście pisz: własny właściwość. sam potwierdź. }.
	( 1 = 0 ) fałsz: { Wyjście pisz: własny właściwość. sam potwierdź. }.
	>> y := 2. { Wyjście pisz: własny właściwość. sam potwierdź. } dopóki: { y odejmij: 1. <- (y > 0). }.
	{ Wyjście pisz: własny właściwość. sam potwierdź. } × 1.
	(Lista ← 1) każdy: {  Wyjście pisz: własny właściwość. sam potwierdź. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo zaimplementować własne sortowanie, ten test nie przechodzi, bo liczba iteracji zależy od platformy
	(Słownik nowy one: ['item']) każdy: { Wyjście pisz: własny właściwość. sam potwierdź. }.
	{ 1 ÷ 0. } przechwyć: { Wyjście pisz: własny właściwość. sam potwierdź. }, uruchom.
	Wyjście nowa-linia.
}.
>> zakres1 := Zakres nowy.
zakres1 initialize: ['X'].
zakres1 test.
>> mojaFunkcja := { 
	własny właściwość := ['Y'].
	Wyjście pisz: własny właściwość.
	sam potwierdź.
	( 1 = 1 ) prawda: { Wyjście pisz: własny właściwość. sam potwierdź. }.
	( 1 = 0 ) fałsz: { Wyjście pisz: własny właściwość. sam potwierdź. }.
	>> y := 2. { Wyjście pisz: własny właściwość. sam potwierdź. } dopóki: { y odejmij: 1. <- (y > 0). }.
	{ Wyjście pisz: własny właściwość. sam potwierdź. } × 1.
	(Lista ← 1) każdy: {  Wyjście pisz: własny właściwość. sam potwierdź. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Słownik nowy one: ['item']) każdy: { Wyjście pisz: własny właściwość. sam potwierdź. }.
	{ 1 ÷ 0. } przechwyć: { Wyjście pisz: własny właściwość. sam potwierdź. }, uruchom.
	Wyjście nowa-linia.
}.
mojaFunkcja na: ['potwierdź'] wykonaj: { Wyjście pisz: [',']. }.
mojaFunkcja zastosuj: 1 i: 2.
