Lista na: ['sum'] wykonaj: {
	>> total := 0.
	sam każdy: { :index :element
		total dodaj: element.
	}. <- total.
}.

>> a := Prawda.



a na: ['tekst'] wykonaj: {
	>> answer := Nic.
	( sam = Prawda ) prawda: {
		answer := ['Yep'].
	}, inaczej: {
		answer := ['Nope'].
	}. <- answer.
}.

a na: ['liczba'] wykonaj: {
	>> answer := Nic.
	( sam = Prawda ) prawda: {
		answer := 10.
	}, inaczej: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b na: ['tekst'] wykonaj: { <- ['Devil'].
}.

b na: ['logiczny'] wykonaj: { <- Fałsz.
}.


Wyjście pisz: a, nowa-linia.  
Wyjście pisz: (90 + a), nowa-linia. 
Wyjście pisz: b, nowa-linia. 
Wyjście pisz: (Prawda i: b), nowa-linia.

a := Lista ← ['hello'] ; ['world'] ; Prawda ; Nic ; 666. 
a := a + ( Lista ← 1 ).
Wyjście pisz: a, nowa-linia.
Wyjście pisz: ((Słownik nowy) umieść: Nic w: Nic), nowa-linia.
Wyjście pisz: a sum, nowa-linia. 


{
	a na: ['tekst'] wykonaj: { <- Nic. }.
	a := [''] + a.
} przechwyć: { :error
	Wyjście pisz: ['Error noted: '] + error, nowa-linia.
}, uruchom.



{
	a na: ['liczba'] wykonaj: { <- Nic. }.
	a := 3 × a.
} przechwyć: { :error
	Wyjście pisz: ['Error noted: '] + error, nowa-linia.
}, uruchom.


{
	a na: ['logiczny'] wykonaj: { <- Nic. }.
	a := Prawda i: a. 
} przechwyć: { :error
	Wyjście pisz: ['Error noted: '] + error, nowa-linia.
}, uruchom.





