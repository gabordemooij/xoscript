Server init.

>> DB := Maria-DB nowy host: ['localhost'],
	użytkownik: ['xo'],
	hasło: ['pass123'],
	nazwa-bazy: ['xobase'],
	połącz.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> parametry-wyszukiwania := Maria-Zapytanie nowy: SQL.

# set database
parametry-wyszukiwania baza-danych: DB.

parametry-wyszukiwania pobierz: { :row
	Wyjście pisz: row world, nowa-linia.
}.
