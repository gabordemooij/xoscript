Server init.

>> BD := Maria-DB nowy host: ['localhost'],
	użytkownik: ['xo'],
	hasło: ['pass123'],
	nazwa-bazy: ['xobase'],
	połącz.
	
>> SQL := ['SELECT "hello" AS "world" '].

# ręcznie utwórz zapytanie
>> parametry-wyszukiwania := Maria-Zapytanie nowy: SQL.

# ustaw bazę danych
parametry-wyszukiwania baza-danych: BD.

parametry-wyszukiwania pobierz: { :rząd
	Wyjście pisz: rząd world, nowa-linia.
}.
