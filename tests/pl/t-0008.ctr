>> Powitacz := Obiekt nowy.
Powitacz na: ['stwórz'] wykonaj: {
	>> powitacz := Obiekt nowy.
	powitacz na: ['name:'] wykonaj: { :nazwa
		Wyjście pisz: ['ustawiam imię'].
		własny mojeImię := nazwa.
	}.
	powitacz na: ['przywitaj'] wykonaj: {
		Wyjście pisz: ['Hello'].
		Wyjście pisz: własny mojeImię.
	}. <- powitacz.
}.
>> powitacz := Powitacz stwórz.
powitacz name: ['słoneczko!'].
powitacz przywitaj.
