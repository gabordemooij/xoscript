>> Greeter := Obiekt nowy.
Greeter na: ['make'] wykonaj: {
	>> greeter := Obiekt nowy.
	greeter na: ['name:'] wykonaj: { :nazwa
		Wyjście pisz: ['setting a name'].
		własny myName := nazwa.
	}.
	greeter na: ['greet'] wykonaj: {
		Wyjście pisz: ['Hello'].
		Wyjście pisz: własny myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
