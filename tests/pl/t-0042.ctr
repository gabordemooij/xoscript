>> items := Słownik nowy.
items umieść: ['black'] w: ['coffee'], umieść: ['earl grey'] w: ['tea'].
Wyjście pisz: (items w: ['coffee']), pisz: (items w: ['tea']).
Wyjście pisz: ['there are'] + items liczność + [' items in the array.'].
items umieść: ['capuccino'] w: ['coffee'].
Wyjście pisz: ['Now my coffee is.. '] + (items w: ['coffee']).
items umieść: ['aaa'] w: ['1'].
items umieść: ['bbb'] w: ['2'].
Wyjście pisz: (items w: ['a']).
