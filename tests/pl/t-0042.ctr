>> items := Słownik nowy.
items umieść: ['czarna'] w: ['coffee'], umieść: ['earl grey'] w: ['herbata'].
Wyjście pisz: (items w: ['coffee']), pisz: (items w: ['herbata']).
Wyjście pisz: ['tablica ma'] + items liczność + [' elementów.'].
items umieść: ['kapuczino'] w: ['coffee'].
Wyjście pisz: ['Teraz moja kawa to.. '] + (items w: ['coffee']).
items umieść: ['aaa'] w: ['1'].
items umieść: ['bbb'] w: ['2'].
Wyjście pisz: (items w: ['a']).
