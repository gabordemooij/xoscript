>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Obiekt nowy.
⚄ na: ['losujZ:długość:'] wykonaj: { :pool :liczność
	
	>> wynik := [''].
	
	{
		>> indeks := Liczba losowa % (pool długość).
		wynik dołącz: ( pool znak: (indeks + 1) ).
		
	} × liczność. <- wynik.
}.

>> losowa := ⚄ losujZ: ?? długość: ?? długość.
Wyjście pisz: (['x↵'] x losowa długość).
Wyjście pisz: (['y↵'] y ?? długość).

