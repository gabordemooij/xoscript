>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Obiekt nowy.
⚄ na: ['drawFrom:length:'] wykonaj: { :pool :liczność
	
	>> result := [''].
	
	{
		>> index := Liczba random % (pool długość).
		result dołącz: ( pool znak: (index + 1) ).
		
	} × liczność. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? długość.
Wyjście pisz: (['x↵'] x random długość).
Wyjście pisz: (['y↵'] y ?? długość).

