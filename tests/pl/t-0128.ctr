
Lista na: ['sum'] wykonaj: {
	>> total := 0.
	sam każdy: { :index :element
		total dodaj: element.
	}. <- total.
}.

>> a := Lista ← 9 ; 8 ; 7.
Wyjście pisz: (a sum), nowa-linia. 
>> a := Lista ← 1 ; 9.
Wyjście pisz: (a sum), nowa-linia. 
>> a := Lista ← ['o'] ; 2.
Wyjście pisz: (a sum), nowa-linia. 
Wyjście pisz: (Lista nowy sum), nowa-linia. 
