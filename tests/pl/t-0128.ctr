
Lista na: ['suma'] wykonaj: {
	>> razem := 0.
	sam każdy: { :indeks :element
		razem dodaj: element.
	}. <- razem.
}.

>> a := Lista ← 9 ; 8 ; 7.
Wyjście pisz: (a suma), nowa-linia. 
>> a := Lista ← 1 ; 9.
Wyjście pisz: (a suma), nowa-linia. 
>> a := Lista ← ['o'] ; 2.
Wyjście pisz: (a suma), nowa-linia. 
Wyjście pisz: (Lista nowy suma), nowa-linia. 
