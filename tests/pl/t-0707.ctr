# test type casts / conversions / bindings
Program zarządzanie-pamięcią: 4.
Server init.

>> counter := 0.
>> db := Maria-DB nowy host: ['localhost'],
	użytkownik: ['xo'], hasło: ['pass123'], nazwa-bazy: ['xobase'], połącz.

>> TwoDigitFormat := Format nowy: ['%02d'].

# Datetime
{
	>> rok := Liczba między: 1995 a: 2050, tekst.
	>> miesiąc := TwoDigitFormat zastosuj-całkowitą: (Liczba między: 1 a: 12), tekst.
	>> dzień := TwoDigitFormat zastosuj-całkowitą: (Liczba między: 1 a: 28), tekst.
	>> godzina := TwoDigitFormat zastosuj-całkowitą: (Liczba między: 1 a: 23), tekst.
	>> minuta := TwoDigitFormat zastosuj-całkowitą: (Liczba między: 1 a: 59), tekst.
	>> sekunda := TwoDigitFormat zastosuj-całkowitą: (Liczba między: 1 a: 59), tekst.
	>> datetime := ['YYYY-MM-DD HH:II:SS'].	
	datetime
		YYYY: rok,
		MM: miesiąc,
		DD: dzień,
		HH: godzina,
		II: minuta,
		SS: sekunda.
	>> parametry-wyszukiwania :=
	db zapytanie: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: datetime),
	pobierz: { :row
		(row mydatetime = datetime) fałsz: {
			to-zadanie błąd: (
				['Expected: <expected> but got: <observation>']
				<expected>: datetime,
				<observation>: row mydatetime
			).
		}.
	
	}.
	counter dodaj: 1.
} * 100.

# Date
{
	>> rok := Liczba między: 1995 a: 2050, tekst.
	>> miesiąc := TwoDigitFormat zastosuj-całkowitą: (Liczba między: 1 a: 12), tekst.
	>> dzień := TwoDigitFormat zastosuj-całkowitą: (Liczba między: 1 a: 28), tekst.
	>> date := ['YYYY-MM-DD'].
	date
		YYYY: rok,
		MM: miesiąc,
		DD: dzień.
	>> parametry-wyszukiwania :=
	db zapytanie: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: date),
	pobierz: { :row
		(row mydate = date) fałsz: {
			to-zadanie błąd: (
				['Expected: <expected> but got: <observation>']
				<expected>: date,
				<observation>: row mydate
			).
		}.
	}.
	counter dodaj: 1.
} * 100.


# Time
{
	>> godzina := TwoDigitFormat zastosuj-całkowitą: (Liczba między: 1 a: 23), tekst.
	>> minuta := TwoDigitFormat zastosuj-całkowitą: (Liczba między: 1 a: 59), tekst.
	>> sekunda := TwoDigitFormat zastosuj-całkowitą: (Liczba między: 1 a: 59), tekst.
	>> czas := ['HH:II:SS'].
	czas
		HH: godzina,
		II: minuta,
		SS: sekunda.
	>> parametry-wyszukiwania :=
	db zapytanie: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: czas),
	pobierz: { :row
		(row mytime = czas) fałsz: {
			to-zadanie błąd: (
				['Expected: <expected> but got: <observation>']
				<expected>: datetime,
				<observation>: row mytime
			).
		}.
	}.
	counter dodaj: 1.
} * 100.


# Strings (varchar/text)
>> str1 := Lista nowy wypełnij: 100000 wartością: ['x'], połącz: [''].
{
	>> str2 := Sejf token: 40.
	>> parametry-wyszukiwania :=
	db zapytanie: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	pobierz: { :row
		(row str1 = str1 i: row str2 = str2) fałsz: {
			to-zadanie błąd: (
				['Expected: <expected> but got: <observation>']
				<expected>: datetime,
				<observation>: row mytime
			).
		}.
	}.
	counter dodaj: 1.
} * 100.


# Numbers
{
	>> n1 := Liczba między: 1 a: 99999.
	>> n2 := n1 / 1000.
	>> big := (
		( Int64 z-tekstu: ['9223372036854775807'] ) -
		( Int64 z-tekstu: ['99999'] ) +
		( Int64 z-tekstu: n1 tekst )
	).
	>> parametry-wyszukiwania :=
	db zapytanie: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	pobierz: { :row
		(row n1 = n1) fałsz: {
			to-zadanie błąd: (
				['Expected: <expected> but got: <observation>']
				<expected>: n1,
				<observation>: row n1
			).
		}.
		(row n2 = n2) fałsz: {
			to-zadanie błąd: (
				['Expected: <expected> but got: <observation>']
				<expected>: n1,
				<observation>: row n2
			).
		}.
		(row n3 = n2 zaokrąglij) fałsz: {
			to-zadanie błąd: (
				['Expected: <expected> but got: <observation>']
				<expected>: n1,
				<observation>: row n3
			).
		}.
		(row big = big) fałsz: {
			to-zadanie błąd: (
				['Expected: <expected> but got: <observation>']
				<expected>: big,
				<observation>: row big
			).
		}.
		
	}.
	counter dodaj: 1.
} * 100.


Wyjście pisz: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: counter
), nowa-linia.