# test rzutowania typów / konwersji / powiązań
Program zarządzanie-pamięcią: 4.
Server init.

>> licznik := 0.
>> bd := Maria-DB nowy host: ['localhost'],
	użytkownik: ['xo'], hasło: ['pass123'], nazwa-bazy: ['xobase'], połącz.

>> FormatDwucyfrowy := Format nowy: ['%02d'].

# Data i czas
{
	>> rok     := Liczba między: 1995 a: 2050, tekst.
	>> miesiąc    := FormatDwucyfrowy zastosuj-całkowitą: (Liczba między: 1 a: 12), tekst.
	>> dzień      := FormatDwucyfrowy zastosuj-całkowitą: (Liczba między: 1 a: 28), tekst.
	>> godzina     := FormatDwucyfrowy zastosuj-całkowitą: (Liczba między: 1 a: 23), tekst.
	>> minuta   := FormatDwucyfrowy zastosuj-całkowitą: (Liczba między: 1 a: 59), tekst.
	>> sekunda   := FormatDwucyfrowy zastosuj-całkowitą: (Liczba między: 1 a: 59), tekst.
	>> dataczas := ['YYYY-MM-DD HH:II:SS'].	
	dataczas
		YYYY: rok,
		MM: miesiąc,
		DD: dzień,
		HH: godzina,
		II: minuta,
		SS: sekunda.
	>> parametry-wyszukiwania :=
	bd zapytanie: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: dataczas),
	pobierz: { :rząd
		(rząd mydatetime = dataczas) fałsz: {
			to-zadanie błąd: (
				['Oczekiwano: <expected>, a otrzymano: <observation>']
				<expected>: dataczas,
				<observation>: rząd mydatetime
			).
		}.
	
	}.
	licznik dodaj: 1.
} * 100.

# Data
{
	>> rok     := Liczba między: 1995 a: 2050, tekst.
	>> miesiąc    := FormatDwucyfrowy zastosuj-całkowitą: (Liczba między: 1 a: 12), tekst.
	>> dzień      := FormatDwucyfrowy zastosuj-całkowitą: (Liczba między: 1 a: 28), tekst.
	>> data     := ['YYYY-MM-DD'].
	data
		YYYY: rok,
		MM: miesiąc,
		DD: dzień.
	>> parametry-wyszukiwania :=
	bd zapytanie: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: data),
	pobierz: { :rząd
		(rząd mydate = data) fałsz: {
			to-zadanie błąd: (
				['Oczekiwano: <expected>, a otrzymano: <observation>']
				<expected>: data,
				<observation>: rząd mydate
			).
		}.
	}.
	licznik dodaj: 1.
} * 100.


# Czas
{
	>> godzina     := FormatDwucyfrowy zastosuj-całkowitą: (Liczba między: 1 a: 23), tekst.
	>> minuta   := FormatDwucyfrowy zastosuj-całkowitą: (Liczba między: 1 a: 59), tekst.
	>> sekunda   := FormatDwucyfrowy zastosuj-całkowitą: (Liczba między: 1 a: 59), tekst.
	>> czas := ['HH:II:SS'].
	czas
		HH: godzina,
		II: minuta,
		SS: sekunda.
	>> parametry-wyszukiwania :=
	bd zapytanie: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: czas),
	pobierz: { :rząd
		(rząd mytime = czas) fałsz: {
			to-zadanie błąd: (
				['Oczekiwano: <expected>, a otrzymano: <observation>']
				<expected>: dataczas,
				<observation>: rząd mytime
			).
		}.
	}.
	licznik dodaj: 1.
} * 100.


# Teksty (varchar/text)
>> str1 := Lista nowy wypełnij: 100000 wartością: ['x'], połącz: [''].
{
	>> str2 := Sejf token: 40.
	>> parametry-wyszukiwania :=
	bd zapytanie: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	pobierz: { :rząd
		(rząd str1 = str1 i: rząd str2 = str2) fałsz: {
			to-zadanie błąd: (
				['Oczekiwano: <expected>, a otrzymano: <observation>']
				<expected>: dataczas,
				<observation>: rząd mytime
			).
		}.
	}.
	licznik dodaj: 1.
} * 100.


# Liczby
{
	>> n1  := Liczba między: 1 a: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 z-tekstu: ['9223372036854775807'] ) -
		( Int64 z-tekstu: ['99999'] ) +
		( Int64 z-tekstu: n1 tekst )
	).
	>> parametry-wyszukiwania :=
	bd zapytanie: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	pobierz: { :rząd
		(rząd n1 = n1) fałsz: {
			to-zadanie błąd: (
				['Oczekiwano: <expected>, a otrzymano: <observation>']
				<expected>: n1,
				<observation>: rząd n1
			).
		}.
		(rząd n2 = n2) fałsz: {
			to-zadanie błąd: (
				['Oczekiwano: <expected>, a otrzymano: <observation>']
				<expected>: n1,
				<observation>: rząd n2
			).
		}.
		(rząd n3 = n2 zaokrąglij) fałsz: {
			to-zadanie błąd: (
				['Oczekiwano: <expected>, a otrzymano: <observation>']
				<expected>: n1,
				<observation>: rząd n3
			).
		}.
		(rząd big = big) fałsz: {
			to-zadanie błąd: (
				['Oczekiwano: <expected>, a otrzymano: <observation>']
				<expected>: big,
				<observation>: rząd big
			).
		}.
		
	}.
	licznik dodaj: 1.
} * 100.


Wyjście pisz: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: licznik
), nowa-linia.