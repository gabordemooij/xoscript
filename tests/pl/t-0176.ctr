

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program zarządzanie-pamięcią: 0.

>> txt := ['Word Salad'].
Wyjście pisz: ['Text Length: '] + txt długość, nowa-linia.
Wyjście pisz: ['Character at 2:'] + ( txt znak: 2 ), nowa-linia.
Wyjście pisz: (( txt znajdź: ['S'] ) - 0), nowa-linia.

Program posprzątaj.

usedMemory1 := (Program pamięć ? 0).


txt := ['Word Salad'].
Wyjście pisz: ['Text Length: '] + txt długość, nowa-linia.
Wyjście pisz: ['Character at 2:'] + ( txt znak: 2 ), nowa-linia.
Wyjście pisz: (( txt znajdź: ['S'] ) - 0), nowa-linia.

Program posprzątaj.
usedMemory2 := (Program pamięć ? 0).


txt := ['Word Salad'].
Wyjście pisz: ['Text Length: '] + txt długość, nowa-linia.
Wyjście pisz: ['Character at 2:'] + ( txt znak: 2 ), nowa-linia.
Wyjście pisz: (( txt znajdź: ['S'] ) - 0), nowa-linia.

Program posprzątaj.
usedMemory3 := (Program pamięć ? 0).



( usedMemory1 = usedMemory2 i: usedMemory1 = usedMemory3, i: usedMemory2 = usedMemory3 ) prawda: {
	Wyjście pisz: ['No memory leaks here'].
}, fałsz: {
	Wyjście pisz: ['Leaking memory...'].
}.
