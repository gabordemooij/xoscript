
Tekst na: ['html'] wykonaj: { <- (
		sam
		zamień: ['&'] na: ['&amp;'],
		zamień: ['<'] na: ['&lt;'],
		zamień: ['>'] na: ['&gt;'],
		zamień: ['"'] na: ['&quot;']
	).
}.

>> HtmlBrush := Obiekt nowy.

HtmlBrush na: ['odpowiedz:'] wykonaj: { :tag
	Wyjście pisz: (['<tag>↵'] tag: tag ).
}.

HtmlBrush na: ['odpowiedz:i:'] wykonaj: { :tag :content
	tag := ( tag od: 0 długość: (tag długość - 1) ).
	Wyjście pisz: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush na: ['content:'] wykonaj: { :text
	Wyjście pisz: text html, nowa-linia.
}.

HtmlBrush na: ['attr:value:'] wykonaj: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush nowy.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
