
Tekst na: ['html'] wykonaj: { <- (
		sam
		zamień: ['&'] na: ['&amp;'],
		zamień: ['<'] na: ['&lt;'],
		zamień: ['>'] na: ['&gt;'],
		zamień: ['"'] na: ['&quot;']
	).
}.

>> PędzelHtml := Obiekt nowy.

PędzelHtml na: ['odpowiedz:'] wykonaj: { :tag
	Wyjście pisz: (['<tag>↵'] tag: tag ).
}.

PędzelHtml na: ['odpowiedz:i:'] wykonaj: { :tag :content
	tag := ( tag od: 0 długość: (tag długość - 1) ).
	Wyjście pisz: (['<tag content>↵'] tag: tag, content: content).
}.

PędzelHtml na: ['content:'] wykonaj: { :napis
	Wyjście pisz: napis html, nowa-linia.
}.

PędzelHtml na: ['atr:wartość:'] wykonaj: { :atr :value <- ['attr="value"'] attr: atr, value: value.
}.

>> h := PędzelHtml nowy.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h atr: ['class'] wartość: ['bold']),
		/span
	/body
/html.
		
