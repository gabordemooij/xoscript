>> Animal := Obiekt nowy.
Animal na: ['make'] wykonaj: {
	>> animal := Obiekt nowy.
	animal na: ['makeSound'] wykonaj: {
		Wyjście pisz: własny sound.
	}. <- animal.
}.
>> Cat := Obiekt nowy.
Cat na: ['make'] wykonaj: {
	>> cat := Animal make.
	cat na: ['init'] wykonaj: {
		własny sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
