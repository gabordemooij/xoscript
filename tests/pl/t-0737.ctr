#test wyrażeń regularnych z dodatnim lookaround
Server init.
>> subject := ['bacabcca'].
>> wyrażenie := Wzorzec nowy: ['(\\w{2})(?=ca)'].
>> wynik  := wyrażenie dopasuj: subject wykonaj: { :m :x
	Wyjście pisz: m, nowa-linia.
	Wyjście pisz: x, nowa-linia.
	<- ['XXX'].
}.
Wyjście pisz: wynik, nowa-linia.
