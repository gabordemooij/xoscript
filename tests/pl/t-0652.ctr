# test liczba -> tekst -> liczba
{

	>> x := Liczba między: 0 a: 1000000.
	>> d := Liczba między: 1 a: 7.
	>> e := 10 potęga: d.

	x podziel-przez: e.
	>> y := x tekst liczba.

	(x = y) fałsz: {
		Wyjście pisz: x, nowa-linia.
		Wyjście pisz: y, nowa-linia.
		Program koniec.
	}.

} * 1000.
Wyjście pisz: ['OK'], nowa-linia.