Liczba na: ['factorial'] wykonaj: {
	>> total := 1.
	{ :index total pomnóż-przez: (sam - (index)). } × sam. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Wyjście pisz: a.
>> b := 2 + 3 factorial.
Wyjście pisz: b.
>> c := 3 factorial + 2.
Wyjście pisz: c.
>> d := 2 + (3 factorial).
Wyjście pisz: d.
Wyjście pisz: 2 + 3 factorial + 1.
