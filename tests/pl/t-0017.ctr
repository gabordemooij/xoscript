Liczba na: ['silnia'] wykonaj: {
	>> razem := 1.
	{ :indeks razem pomnóż-przez: (sam - (indeks)). } × sam. <- razem.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Wyjście pisz: a.
>> b := 2 + 3 silnia.
Wyjście pisz: b.
>> c := 3 silnia + 2.
Wyjście pisz: c.
>> d := 2 + (3 silnia).
Wyjście pisz: d.
Wyjście pisz: 2 + 3 silnia + 1.
