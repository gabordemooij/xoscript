
>> kraje := Lista nowy
	~ ['Szwajcaria']
	~ ['Włochy']
	~ ['Niemcy'].

>> potrawy := Lista nowy
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Kiszona kapusta'].


>> licznik := 0.
potrawy według: kraje, każdy: { :key :value
	licznik dodaj: 1.
}.

Wyjście pisz: (['we serve counter dishes'] counter: licznik), nowa-linia.

>> licznik := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] znaki sortuj: { :v
	licznik dodaj: 0.
}.

Wyjście pisz: (['we sort counter dishes'] counter: licznik), nowa-linia.


>> licznik := 0.
{
	{
		licznik dodaj: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Wyjście pisz: (['we calculate counter numbers.'] counter: licznik), nowa-linia.

