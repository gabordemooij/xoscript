
>> countries := Lista nowy
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Lista nowy
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods według: countries, każdy: { :key :value
	counter dodaj: 1.
}.

Wyjście pisz: (['we serve counter dishes'] counter: counter), nowa-linia.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] znaki sortuj: { :v
	counter dodaj: 0.
}.

Wyjście pisz: (['we sort counter dishes'] counter: counter), nowa-linia.


>> counter := 0.
{
	{
		counter dodaj: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Wyjście pisz: (['we calculate counter numbers.'] counter: counter), nowa-linia.

