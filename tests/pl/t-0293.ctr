
>> city := Lista ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Lista ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature według: city.
>> cities := weather wpisy sortuj: { :a :b <- (a porównaj: b). }.
>> temperatures := weather wartości sortuj: { :a :b <- (a porównaj: b) ujemna?. }.

Wyjście pisz: (cities połącz: [',']), nowa-linia.
Wyjście pisz: (temperatures połącz: [',']), nowa-linia.
