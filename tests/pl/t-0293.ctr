
>> miasto := Lista ← ['Londyn'] ; ['Paryż'] ; ['Berlin'].
>> temperatura := Lista ← ['15'] ; ['16'] ; ['15'].
>> pogoda := temperatura według: miasto.
>> miasta := pogoda wpisy sortuj: { :a :b <- (a porównaj: b). }.
>> temperatury := pogoda wartości sortuj: { :a :b <- (a porównaj: b) ujemna?. }.

Wyjście pisz: (miasta połącz: [',']), nowa-linia.
Wyjście pisz: (temperatury połącz: [',']), nowa-linia.
