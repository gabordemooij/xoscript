
Wyjście pisz: ['Break for-loop, 0-4.'], nowa-linia.
{ :i
	Wyjście pisz: ['iteration #'] + i, nowa-linia.
	(i = 4) przerwij.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Wyjście pisz: ['Break while-true loop, 0-4.'], nowa-linia.
{
	Wyjście pisz: ['iteration #'] + x, nowa-linia.
	x dodaj: 1.
	((x < 5) nie) przerwij.
} dopóki: xIsLessThan10.

Wyjście pisz: ['Break while-false loop, 5,4.'], nowa-linia.
{
	Wyjście pisz: ['iteration #'] + x, nowa-linia.
	x odejmij: 1.
	(x = 3) przerwij.
} dopóki: { <- (x > 0). }.

Wyjście pisz: ['Break times loop, 1-4.'], nowa-linia.
{ :i
	Wyjście pisz: ['iteration #'] + i, nowa-linia.
	(i = 4) przerwij.
} × 5.

Wyjście pisz: ['Break block, dont print line.'], nowa-linia.
{ Prawda przerwij. Wyjście pisz: ['dont write this!'], nowa-linia. } uruchom.

Wyjście pisz: ['Break block, dont fire catch...'], nowa-linia.
{ Prawda przerwij. Wyjście pisz: ['dont write this!'], nowa-linia. } przechwyć: { Wyjście pisz: ['Dont catch this!']. }, uruchom.

Wyjście pisz: ['Test Array each-loop: 0,1'], nowa-linia.
(Lista ← 1 ; 2 ; 3) odwzoruj: { :i
	Wyjście pisz: ['iteration #'] + i, nowa-linia.
	(i = 1) przerwij.
}.

Wyjście pisz: ['Test Map each-loop: c only'], nowa-linia.
>> m := Słownik nowy.
m umieść: ['first'] w: ['a'], umieść: ['second'] w: ['b'], umieść: ['third'] w: ['c'].
m każdy: { :k :v
	Wyjście pisz: ['iteration'] + v + k, nowa-linia.
	Prawda przerwij.
}.

