
Wyjście pisz: ['Przerwanie pętli for, 0-4.'], nowa-linia.
{ :i
	Wyjście pisz: ['iteration #'] + i, nowa-linia.
	(i = 4) przerwij.
} × 10.

>> x := 0.
>> xMniejszeNiż10 := { <- ( x < 10 ). }.

Wyjście pisz: ['Przerwanie pętli while-true, 0-4.'], nowa-linia.
{
	Wyjście pisz: ['iteration #'] + x, nowa-linia.
	x dodaj: 1.
	((x < 5) nie) przerwij.
} dopóki: xMniejszeNiż10.

Wyjście pisz: ['Przerwanie pętli while-false, 5,4.'], nowa-linia.
{
	Wyjście pisz: ['iteration #'] + x, nowa-linia.
	x odejmij: 1.
	(x = 3) przerwij.
} dopóki: { <- (x > 0). }.

Wyjście pisz: ['Przerwanie pętli times, 1-4.'], nowa-linia.
{ :i
	Wyjście pisz: ['iteration #'] + i, nowa-linia.
	(i = 4) przerwij.
} × 5.

Wyjście pisz: ['Przerwanie bloku, nie wypisuj wiersza.'], nowa-linia.
{ Prawda przerwij. Wyjście pisz: ['tego nie pisz!'], nowa-linia. } uruchom.

Wyjście pisz: ['Przerwanie bloku, nie uruchamiaj catch...'], nowa-linia.
{ Prawda przerwij. Wyjście pisz: ['tego nie pisz!'], nowa-linia. } przechwyć: { Wyjście pisz: ['Tego nie łap!']. }, uruchom.

Wyjście pisz: ['Test pętli each tablicy: 0,1'], nowa-linia.
(Lista ← 1 ; 2 ; 3) odwzoruj: { :i
	Wyjście pisz: ['iteration #'] + i, nowa-linia.
	(i = 1) przerwij.
}.

Wyjście pisz: ['Test pętli each mapy: tylko c'], nowa-linia.
>> m := Słownik nowy.
m umieść: ['first'] w: ['a'], umieść: ['second'] w: ['b'], umieść: ['trzeci'] w: ['c'].
m każdy: { :k :v
	Wyjście pisz: ['iteration'] + v + k, nowa-linia.
	Prawda przerwij.
}.

