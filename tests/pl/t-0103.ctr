>> a := Lista ← Obiekt ; Prawda ; Fałsz ; Logiczny ; 1 ; Liczba ; ['Str'] ; Tekst ; { ['Empty']. }.
Wyjście pisz: (a liczność), nowa-linia.
{ :i
	Wyjście pisz: 
	['a '] + 
	((a ? i) typ) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Nic?) albo: [''] albo: ['NOT']) + 
	[' Nil.'],
	nowa-linia.
} × (a liczność).
Wyjście pisz: ['but.. Nil is.. '] + ((Nic Nic?) albo: ['certainly NIL!'] albo: ['not NIL??']), nowa-linia.