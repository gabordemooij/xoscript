>> a := Lista ← Obiekt ; Prawda ; Fałsz ; Logiczny ; 1 ; Liczba ; ['Str'] ; Tekst ; { ['Pusty']. }.
Wyjście pisz: (a liczność), nowa-linia.
{ :i
	Wyjście pisz: 
	['a '] + 
	((a ? i) typ) +
	([' \‘this\’ '] this: (a ? i))  +
	[' jest '] +
	(((a ? i) Nic?) albo: [''] albo: ['wcale nie']) + 
	[' Nic.'],
	nowa-linia.
} × (a liczność).
Wyjście pisz: ['ale.. Nic to.. '] + ((Nic Nic?) albo: ['na pewno NIC!'] albo: ['nie NIC??']), nowa-linia.