# Ten test sprawdza, czy string_fill_in nie traci swojego miejsca (usuniętego przez gc) w trybie 4
# odwołanie w world.c
>> Dziennik := Obiekt nowy.

Dziennik na: ['say:'] wykonaj: { :str
	Wyjście pisz: str, nowa-linia.
}.

>> Przedmiot := Obiekt nowy.

Przedmiot na: ['nowy:'] wykonaj: { :id
	<- sam nowy id: id.
}.

Przedmiot na: ['id:'] wykonaj: { :id
	własny id := id.
}.

Przedmiot na: ['id'] wykonaj: { <- własny id. }.


Przedmiot na: ['tekst'] wykonaj: {
	>> str := ['Item#~no'].
	str ~no: własny id.
	<- str.
}.


>> Print := Obiekt nowy.

Print na: ['items'] wykonaj: { 
	
	własny przedmiot := Przedmiot nowy: 1.
	
	# albo segfault, albo tu błędny łańcuch
	Dziennik say: (
		['~item printed.'] ~item: własny przedmiot
	).
	
	
}.

Print items.