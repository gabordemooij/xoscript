


>> wine := Obiekt nowy.


wine na: ['toString'] wykonaj: { <- ['merlot'].
}.

wine na: ['naarTekst'] wykonaj: { <- ['merlot'].
}.


wine na: ['='] wykonaj: { :other wine <- ( sam toString = other wine ).
}.

wine na: ['=='] wykonaj: { :other wine <- ( sam toString = other wine ).
}.



wine
	przypadek: ['cabernet'] wykonaj: { Wyjście pisz: ['it's a Cabernet!']. },
	przypadek: ['syrah']    wykonaj: { Wyjście pisz: ['it's a Syrah!'].    },
	przypadek: ['merlot']   wykonaj: { Wyjście pisz: ['it's a Merlot!'].   },
	przypadek: ['malbec']   wykonaj: { Wyjście pisz: ['it's a Malbec!'].   }.

Wyjście nowa-linia.
