# Haszowanie haseł
Server init.

# Użytkownik ustawia hasło
>> hsł := ['pass123'].

# Przechowujesz je w ten sposób
>> hasz := Sejf 
	skrót-hasła: hsł.

# Potem użytkownik się loguje
# Próba 1
>> a1 := ['abcd123'].
# Próba 2
>> a2 := ['pass123'].

# Sprawdź
>> a := Sejf 
	skrót-hasła: hasz sprawdź: a1.
	# nieudane 
>> b := Sejf
	skrót-hasła: hasz sprawdź: a2.
	# ok!

Wyjście pisz: a, nowa-linia.
Wyjście pisz: b, nowa-linia.

