# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Sejf 
	skrót-hasła: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Sejf 
	skrót-hasła: hash sprawdź: a1.
	# fail 
>> b := Sejf
	skrót-hasła: hash sprawdź: a2.
	# ok!

Wyjście pisz: a, nowa-linia.
Wyjście pisz: b, nowa-linia.

