
Program zarządzanie-pamięcią: 4.

>> Zwierzę := Obiekt nowy.
Zwierzę na: ['stwórz'] wykonaj: {
	>> zwierzę := Obiekt nowy.
	zwierzę na: ['wydajDźwięk'] wykonaj: {
		Wyjście pisz: własny dźwięk.
	}. <- zwierzę.
}.
>> Kot := Obiekt nowy.
Kot na: ['stwórz'] wykonaj: {
	>> kot := Zwierzę stwórz.
	kot na: ['init'] wykonaj: {
		własny dźwięk := ['meow!'].
	}.
	kot init. <- kot.
}.
>> tom := Kot stwórz.
tom wydajDźwięk.
