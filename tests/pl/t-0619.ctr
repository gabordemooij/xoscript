>> HTML := Obiekt nowy.
HTML na: ['odpowiedz:'] wykonaj: { :tag 
	Wyjście pisz: (['<tag>'] tag: tag), nowa-linia.
}.
HTML na: ['odpowiedz:i:'] wykonaj: { :tag :html 
	Wyjście pisz: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), nowa-linia.
}.
>> html := HTML nowy.
html body h1: ['header'].

