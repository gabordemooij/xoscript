

Lista na: ['column:'] wykonaj: { :column
	>> result := Lista nowy.
	sam każdy: { :index :row
		row każdy: { :index :cell
			(index = column) prawda: { result dołącz: cell. }.
		}.
	}. <- result.
}.


>> a := Lista ←
	(Lista ← 1 ; 2 ; 3) ;
	(Lista ← 4 ; 5 ; 6) ;
	(Lista ← 7 ; 8 ; 9).

>> b := a column: 1.
Wyjście pisz: b, nowa-linia.

b := a column: 20.
Wyjście pisz: b, nowa-linia.

b := a column: -100.
Wyjście pisz: b, nowa-linia.
