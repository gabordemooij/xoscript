

Lista na: ['column:'] wykonaj: { :kolumna
	>> wynik := Lista nowy.
	sam każdy: { :indeks :rząd
		rząd każdy: { :indeks :komórka
			(indeks = kolumna) prawda: { wynik dołącz: komórka. }.
		}.
	}. <- wynik.
}.


>> a := Lista ←
	(Lista ← 1 ; 2 ; 3) ;
	(Lista ← 4 ; 5 ; 6) ;
	(Lista ← 7 ; 8 ; 9).

>> b := a column: 1.
Wyjście pisz: b, nowa-linia.

b := a column: 20.
Wyjście pisz: b, nowa-linia.

b := a column: -100.
Wyjście pisz: b, nowa-linia.
