

Tekst na: ['oblicz'] wykonaj: {
	>> code := Plik nowy: ['/tmp/eval.ctr'].
	code pisz: (sam tekst + ['.']).
	Program użyj: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Lista ← (['Cudzysłowy '] + Q + [' są złe?']) ; 1.
>> x := q tekst.
Wyjście pisz: x, nowa-linia.
>> y := Nic.
(['y := '] + x ) oblicz.
Wyjście pisz: y ? 0, nowa-linia.

q := Słownik umieść: ['\[''] w: ['\['quote\']'].
x := q tekst.
Wyjście pisz: x, nowa-linia.
y := Nic.
(['y := '] + x ) oblicz.

>> q := (Słownik nowy) umieść:['\[''] w:['\['quote\[''].
Wyjście pisz: y ? ['\['quote\']'], nowa-linia.
