

# create a 64-bit integer for exact calculations
>> a := Int64 bivuye-mu-nyandiko: ['123'].

# to string
Ibisohoka andika: a, umurongo-mushya.

# divide
Ibisohoka andika: a / (Int64 bivuye-mu-nyandiko: ['3']), umurongo-mushya.

# multiply
Ibisohoka andika: a * (Int64 bivuye-mu-nyandiko: ['2']), umurongo-mushya.

# add
Ibisohoka andika: a + (Int64 bivuye-mu-nyandiko: ['1']), umurongo-mushya.

# subtract
Ibisohoka andika: a - (Int64 bivuye-mu-nyandiko: ['2']), umurongo-mushya.

# compare
Ibisohoka andika: ( a =   (Int64 bivuye-mu-nyandiko: ['123'])), umurongo-mushya.
Ibisohoka andika: ( a !=: (Int64 bivuye-mu-nyandiko: ['124'])), umurongo-mushya.
Ibisohoka andika: ( a <   (Int64 bivuye-mu-nyandiko: ['124'])), umurongo-mushya.
Ibisohoka andika: ( a >   (Int64 bivuye-mu-nyandiko: ['122'])), umurongo-mushya.
Ibisohoka andika: ( a >=: (Int64 bivuye-mu-nyandiko: ['123'])), umurongo-mushya.
Ibisohoka andika: ( a <=: (Int64 bivuye-mu-nyandiko: ['123'])), umurongo-mushya.





	