Inyandiko bigeze: ['evaluate'] kora: {
	>> kode := Dosiye gishya: ['/tmp/eval.ctr'].
	kode andika: (ubwacyo inyandiko + ['.']).
	Gahunda koresha: ['/tmp/eval.ctr'].
}.

>> a := Urutonde ← 1 ; 2 ; 3.
>> b := (a inyandiko).

Ibisohoka andika: b, umurongo-mushya. 
(['b := '] + b) evaluate.

Ibisohoka andika: b ? 2, umurongo-mushya. 

Ibisohoka andika: (( Urutonde ← 1 ; 2 ; 3 )), umurongo-mushya. 

Ibisohoka andika: ((Inkoranyamagambo gishya) shyira: 1 kuri: 2), umurongo-mushya. 

>> x := ( (Urutonde ← 1 ; ( Urutonde ← 9 ) ; Ukuri ) ) inyandiko.
Ibisohoka andika: x, umurongo-mushya. 
(['x := '] + x) evaluate.

Ibisohoka andika: x ? 1 ? 0, umurongo-mushya. 

>> y := (Inkoranyamagambo gishya) shyira: (Urutonde ← 1) kuri: (Urutonde ← 2).
Ibisohoka andika: y, umurongo-mushya. 

(['y := '] + y) inyandiko evaluate.

Ibisohoka andika: (y ahantu: (Urutonde ← 2) inyandiko ), umurongo-mushya.

Ibisohoka andika: (Urutonde gishya), umurongo-mushya. 
Ibisohoka andika: (Inkoranyamagambo gishya), umurongo-mushya. 
