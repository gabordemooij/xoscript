# compliance test

# use international numbers

Ibisohoka andika: ['1000 -> '].
Ibisohoka andika: 1000, umurongo-mushya. #1000

Ibisohoka andika: ['1.5 -> '].
Ibisohoka andika: 1.5, umurongo-mushya.  #1.5

Ibisohoka andika: ['1001.5 -> '].
Ibisohoka andika: 1.5 + 1000, umurongo-mushya. #1001.5

# use 0-indexed arrays
>> x := Urutonde gishya ; 1 ; 2 ; 3.
>> y := Urutonde gishya ; ['a'] ; ['b'] ; ['c'].

Ibisohoka andika: ['1 -> '].
Ibisohoka andika: x ? 0, umurongo-mushya. #1

Ibisohoka andika: ['1 -> '].
Ibisohoka andika: (x ahantu: 0), umurongo-mushya. #1

Ibisohoka andika: ['1 -> '].
Ibisohoka andika: x icya-mbere, umurongo-mushya. #1

Ibisohoka andika: ['3 -> '].
Ibisohoka andika: x icya-nyuma, umurongo-mushya. #3

Ibisohoka andika: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Ibisohoka andika: (x hakurikijwe: y), umurongo-mushya.

Ibisohoka andika: ['1 -> '].
Ibisohoka andika: (x kuva: 0 uburebure: 1) icya-mbere, umurongo-mushya. #1

Ibisohoka andika: ['0 -> '].
Ibisohoka andika: (x shaka: 1), umurongo-mushya. #0

x shyira: 9 kuri: 0.

Ibisohoka andika: ['9 -> '].
Ibisohoka andika: (x ahantu: 0), umurongo-mushya. #9

x ongera-ku-ntangiriro: 8.
Ibisohoka andika: ['8 -> '].
Ibisohoka andika: (x ahantu: 0), umurongo-mushya. #9


x ongera-ku-mpera: 10.
Ibisohoka andika: ['10 -> '].
Ibisohoka andika: (x ahantu: 4), umurongo-mushya. #10








