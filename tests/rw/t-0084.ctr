>> makeAdder := { :x
	>> f := { :y <- (icyacyo x + y). } shyiraho: ['x'] agaciro: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i icyacyo q shyira: (icyacyo f shyira-kuri: (icyacyo q ? i)) kuri: i. } 
	shyiraho: ['q'] agaciro: array,
	shyiraho: ['f'] agaciro: func.
	{ :i mapping shyira-kuri: i. } × (array umubare-wibintu).
}.

>> a := Urutonde ← 1; 2; 3.
mapper shyira-kuri: a na: (makeAdder shyira-kuri: 100).
Ibisohoka andika: (a umwanya: 0), umurongo-mushya.
Ibisohoka andika: (a ? 1), umurongo-mushya.
Ibisohoka andika: (a ? 2), umurongo-mushya.
