>> x := Ikintu gishya.
>> y := Ikintu gishya.
>> z := x.
Ibisohoka andika: (x = z), umurongo-mushya.
Ibisohoka andika: (x = y), umurongo-mushya.
Ibisohoka andika: (x ≠ y), umurongo-mushya.
Ibisohoka andika: (x ≠ z), umurongo-mushya.
>> m := Akanya gishya umwaka: 2070, ukwezi: 11.
>> n := m koporora.
Ibisohoka andika: (m = n), umurongo-mushya.
Ibisohoka andika: (m ≠ n), umurongo-mushya.
Ibisohoka andika: (m ni-kimwe: m), umurongo-mushya.
Ibisohoka andika: (m ni-kimwe: n), umurongo-mushya.
n ukwezi: 12.
Ibisohoka andika: (m ≠ n), umurongo-mushya.
Ibisohoka andika: (m = n), umurongo-mushya.


