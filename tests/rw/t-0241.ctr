

Inyandiko bigeze: ['evaluate'] kora: {
	>> kode := Dosiye gishya: ['/tmp/eval.ctr'].
	kode andika: (ubwacyo inyandiko + ['.']).
	Gahunda koresha: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Urutonde ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q inyandiko.
Ibisohoka andika: x, umurongo-mushya.
>> y := Ntacyo.
(['y := '] + x ) evaluate.
Ibisohoka andika: y ? 0, umurongo-mushya.

q := Inkoranyamagambo shyira: ['\[''] kuri: ['\['quote\']'].
x := q inyandiko.
Ibisohoka andika: x, umurongo-mushya.
y := Ntacyo.
(['y := '] + x ) evaluate.

>> q := (Inkoranyamagambo gishya) shyira:['\[''] kuri:['\['quote\[''].
Ibisohoka andika: y ? ['\['quote\']'], umurongo-mushya.
