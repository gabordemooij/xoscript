#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Gahunda imicungire-yububiko: 0.

{
Akanya igihe.
Akanya rindira: 1.
Ibisohoka andika: Gahunda umubare-wibyinjizwa, umurongo-mushya.
Gahunda icyinjizwa: 0.
Umubare random.
Ibisohoka andika: (Gahunda sisitemu: ['echo 'Hello'']).
} tangira.

Gahunda sukura.
usedMemory1 := (Gahunda ububiko ? 0).

{
Akanya igihe.
Akanya rindira: 1.
Ibisohoka andika: Gahunda umubare-wibyinjizwa, umurongo-mushya.
Gahunda icyinjizwa: 0.
Umubare random.
Ibisohoka andika: (Gahunda sisitemu: ['echo 'Hello'']).
} tangira.

Gahunda sukura.
usedMemory2 := (Gahunda ububiko ? 0).

{
Akanya igihe.
Akanya rindira: 1.
Ibisohoka andika: Gahunda umubare-wibyinjizwa, umurongo-mushya.
Gahunda icyinjizwa: 0.
Umubare random.
Ibisohoka andika: (Gahunda sisitemu: ['echo 'Hello'']).
} tangira.

Gahunda sukura.
usedMemory3 := (Gahunda ububiko ? 0).



( usedMemory1 = usedMemory2 na: usedMemory1 = usedMemory3, na: usedMemory2 = usedMemory3 ) ukuri: {
	Ibisohoka andika: ['No memory leaks here'].
}, ikinyoma: {
	Ibisohoka andika: ['Leaking memory...'].
}.
