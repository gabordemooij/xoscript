Server init.
>> fmt := Imiterere gishya: ['%#3x'].

>> blob := Blob gishya: 4.
blob bytes: ( 
	Urutonde gishya ; 0 ; 1 ; 2 ; 3
).

>> file := Dosiye gishya: ['/tmp/blob'].
file blob: blob.
blob rekura.

>> soma := file blob.
soma 
kuva: 0 
uburebure: 4, 
kora buri: { :i :b 
	Ibisohoka
	andika: (fmt shyira-kuri-umubare-wuzuye: b),
	umurongo-mushya.
}.
soma rekura.
