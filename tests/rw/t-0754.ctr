Ibisohoka andika: ['Test object'], umurongo-mushya.
>> a := Ikintu gishya. 

a bigeze: ['item:'] kora: { :out
	icyacyo out := out. 
}.

a bigeze: ['item'] kora: { <- icyacyo out.
}.

a bigeze: ['greet'] kora: {
	Ibisohoka andika: ['hi from original out!'], umurongo-mushya.
}.

a item: Ibisohoka.

Ibisohoka andika: a item, umurongo-mushya.

>> old-out-address := a item icyitegererezo aderesi-yububiko.
a save-as: ['/tmp/a.bin'].
Ibisohoka andika: ['========== RELOADING SNAP:'], umurongo-mushya.

>> b := Ikintu load-from: ['/tmp/a.bin'].

(b item icyitegererezo aderesi-yububiko = old-out-address) ukuri: {
	Ibisohoka andika: ['Object link re-attached.'], umurongo-mushya.
}.

b item andika: ['hello from loaded out!'], umurongo-mushya.
b greet.
