>> Grandfather := Ikintu gishya.
Grandfather bigeze: ['greet'] kora: {
	Ibisohoka andika: ['Ave!'], umurongo-mushya.
}.
>> Father := Grandfather gishya.
Father bigeze: ['greet'] kora: {
	Ibisohoka andika: ['Hello'], umurongo-mushya.
	ubwacyo greet.
}.
>> Son := Father gishya.
Son bigeze: ['greet'] kora: {
	Ibisohoka andika: ['Hi'], umurongo-mushya.
	ubwacyo greet.
}.

Son greet.

>> Roundabout := Ikintu gishya.
Roundabout bigeze: ['circle:'] kora: { :x
	Ibisohoka andika: x, umurongo-mushya.
	(x < 3) ukuri: { ubwacyo kwihamagara circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) ukuri: { Ibisohoka andika: x, umurongo-mushya. x ongeraho: 1.  increment tangira. }. }.
increment tangira.