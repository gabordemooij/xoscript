


>> CoffeeMachine := Ikintu gishya.
CoffeeMachine bigeze: ['order:'] kora: { :id
	>> coffee := ['Americano'].
	( id = 1 ) ukuri: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) ukuri: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) ukuri: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Ikintu gishya.
SimpleCoffeeMachine bigeze: ['order'] kora: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Ibisohoka andika: redCup, umurongo-mushya.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Ibisohoka andika: greenCup, umurongo-mushya.
>> yellowCup := CoffeeMachine order: 1.
Ibisohoka andika: yellowCup, umurongo-mushya.
>> blueCup := CoffeeMachine order: 0.
Ibisohoka andika: blueCup, umurongo-mushya.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Ibisohoka andika: blackCup, umurongo-mushya.
blackCup ongera-ku-mpera: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Ibisohoka andika: orangeCup, umurongo-mushya.
