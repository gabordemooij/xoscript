Umubare bigeze: ['factorial'] kora: {
	>> total := 1.
	{ :index total kuba-na: (ubwacyo - (index)). } × ubwacyo. <- total.
}.
>> Printer := Ikintu gishya.
Printer bigeze: ['print:and:'] kora: { :x :y
	Ibisohoka andika: ['a='] + x + [', b='] + y, umurongo-mushya.
}.
>> a := 4.5. >> b := a manura-umubare.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a zamura-umubare.
Printer print: a and: b.
a := 4.5. b := a manura-umubare.
Printer print: a and: b.
a := 4.5. b := a egereza-umubare.
Printer print: a and: b.
a := 4.2. b := a egereza-umubare.
Printer print: a and: b.

Ibisohoka andika: (9 igisigara: 5), umurongo-mushya.
Ibisohoka andika: -666 agaciro-nyako, umurongo-mushya.
Ibisohoka andika: 49 umuzi-kare, umurongo-mushya.
Ibisohoka andika: (2 ipuwasanse: 3), umurongo-mushya.
>> l := (Urutonde ← 9 ; 6).
Ibisohoka andika: l gito-cyane.

