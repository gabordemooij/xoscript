>> x := [' hallo '].

>> y := x inyuguti-nkuru.
Ibisohoka andika: x, umurongo-mushya.
Ibisohoka andika: (x ni-kimwe: y), umurongo-mushya.

>> y := x inyuguti-nto.
Ibisohoka andika: x, umurongo-mushya.
Ibisohoka andika: (x ni-kimwe: y), umurongo-mushya.

>> y := x kata-imyanya.
Ibisohoka andika: x, umurongo-mushya.
Ibisohoka andika: (x ni-kimwe: y), umurongo-mushya.

>> y := x simbuka: 1.
Ibisohoka andika: x, umurongo-mushya.
Ibisohoka andika: (x ni-kimwe: y), umurongo-mushya.

>> y := x kuva: 1 uburebure: 2.
Ibisohoka andika: x, umurongo-mushya.
Ibisohoka andika: (x ni-kimwe: y), umurongo-mushya.