Server init.
Ibisohoka andika: ['Database time test'], umurongo-mushya.

>> db := Maria-DB gishya uwakira: ['localhost'],
	izina-ryukoresha: ['xo'], 
	ijambobanga: ['pass123'],
	izina-ryububikoshingiro: ['xobase'],
	ihuze.

>> ibipimo-byishakisha :=
db ikibazo: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
zana: { :row
	Ibisohoka andika: row timetest, umurongo-mushya.
}.
