['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Ibisohoka andika: (x + y), umurongo-mushya.

>> x := 10040.07.
>> y := 10305.60.

Ibisohoka andika: (x + y), umurongo-mushya.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Ibisohoka andika: (x + y + z), umurongo-mushya.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Ibisohoka andika: (x + y + z), umurongo-mushya.

>> q := 0.1.2.

Ibisohoka andika: (q), umurongo-mushya.

>> q := 012.

Ibisohoka andika: (q), umurongo-mushya.
