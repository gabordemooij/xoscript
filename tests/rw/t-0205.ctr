>> str := ['write:'].
Ibisohoka ubutumwa: ['andika:'] ibyinjizwa: (Urutonde ← ['Hello World']), umurongo-mushya. 

Umubare bigeze: ['isbetween:and:'] kora: { :a :b <- ((ubwacyo ≥ a) na: (ubwacyo ≤ b)).
}.

str := ['isbetween:and:'].
Ibisohoka andika: (3 ubutumwa: str ibyinjizwa: (Urutonde ← 2 ; 8)), umurongo-mushya.
Ibisohoka andika: (3 ubutumwa: str ibyinjizwa: (Urutonde ← 1 ; 2)), umurongo-mushya.


>> CoffeeMachine := Ikintu gishya.
CoffeeMachine bigeze: ['makeCoffeeWithSugar:milk:'] kora: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Urutonde ← 4 ; 2.
Ibisohoka andika: ( CoffeeMachine ubutumwa: order ibyinjizwa: coffeeConfiguration ), umurongo-mushya.
