# test number -> string -> number
{

	>> x := Umubare hagati: 0 na: 1000000.
	>> d := Umubare hagati: 1 na: 7.
	>> e := 10 ipuwasanse: d.

	x gabanya-na: e.
	>> y := x inyandiko umubare.

	(x = y) ikinyoma: {
		Ibisohoka andika: x, umurongo-mushya.
		Ibisohoka andika: y, umurongo-mushya.
		Gahunda soza.
	}.

} * 1000.
Ibisohoka andika: ['OK'], umurongo-mushya.