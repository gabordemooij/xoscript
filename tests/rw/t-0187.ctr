Umubare bigeze: ['factorial'] kora: {
	>> total := 1.
	{ :index total kuba-na: (ubwacyo - index). } × ubwacyo. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Gahunda imicungire-yububiko: 0.

{
2 exponent factorial.
Ibisohoka andika: (11 igisigara: 3), umurongo-mushya.
Ibisohoka andika: (3.4 egereza-umubare), umurongo-mushya.
Ibisohoka andika: (7.1 zamura-umubare), umurongo-mushya.
Ibisohoka andika: (7.9 manura-umubare), umurongo-mushya.
}
tangira.

Gahunda sukura.

usedMemory1 := (Gahunda ububiko ? 0).

{
2 exponent factorial.
Ibisohoka andika: (11 igisigara: 3), umurongo-mushya.
Ibisohoka andika: (3.4 egereza-umubare), umurongo-mushya.
Ibisohoka andika: (7.1 zamura-umubare), umurongo-mushya.
Ibisohoka andika: (7.9 manura-umubare), umurongo-mushya.
}
tangira.

Gahunda sukura.
usedMemory2 := (Gahunda ububiko ? 0).


{
2 exponent factorial.
Ibisohoka andika: (11 igisigara: 3), umurongo-mushya.
Ibisohoka andika: (3.4 egereza-umubare), umurongo-mushya.
Ibisohoka andika: (7.1 zamura-umubare), umurongo-mushya.
Ibisohoka andika: (7.9 manura-umubare), umurongo-mushya.
} tangira.

Gahunda sukura.
usedMemory3 := (Gahunda ububiko ? 0).



( usedMemory1 = usedMemory2 na: usedMemory1 = usedMemory3, na: usedMemory2 = usedMemory3 ) ukuri: {
	Ibisohoka andika: ['No memory leaks here'].
}, ikinyoma: {
	Ibisohoka andika: ['Leaking memory...'].
}.
