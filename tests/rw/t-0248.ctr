

Inyandiko bigeze: ['evaluate'] kora: {
	>> kode := Dosiye gishya: ['/tmp/eval.ctr'].
	kode andika: ubwacyo inyandiko + ['.'].
	Gahunda koresha: ['/tmp/eval.ctr'].
}.

>> a := (Urutonde ← (
	(Inkoranyamagambo gishya)
		shyira: ['domain'] kuri: ['mywebsite.com'],
		shyira: (Urutonde ←
			((Inkoranyamagambo gishya)
				shyira: ['home'] kuri: ['title'],
				shyira: ['<html></html>'] kuri: ['body'],
				shyira: ['2017-01-01'] kuri: ['created']
			) ;
			((Inkoranyamagambo gishya)
				shyira: ['aboutus(c)'] kuri: ['title'],
				shyira: ['<credits>Author Inc.</credits>'] kuri: ['body']
			)
		) kuri: ['pages']
	)
) inyandiko.

Ibisohoka andika: a ubwoko, umurongo-mushya.
Ibisohoka andika: a, umurongo-mushya.

>> b := Ntacyo.
(['b := '] + a) evaluate.
Ibisohoka andika: b ? 0 ? ['pages'] ? 1 ? ['body'], umurongo-mushya.

>> c := b ? 0.
>> d := c inyandiko.
Ibisohoka andika: d ubwoko, umurongo-mushya.

>> e := Ntacyo.
(['e := '] + d) evaluate.
Ibisohoka andika: e ? ['pages'] ? 0, umurongo-mushya.
