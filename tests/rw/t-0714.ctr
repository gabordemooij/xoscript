>> a := Ikintu gishya. 
a bigeze: ['greet'] kora: { Ibisohoka andika: ['welcome!'], umurongo-mushya. }.
a bigeze: ['greet2'] kora: { Ibisohoka andika: ['welcome2!'], umurongo-mushya. }.
a save-as: ['/tmp/a.bin'].

Ibisohoka andika: ['========== RELOADING SNAP:'], umurongo-mushya.
>> b := Ikintu load-from: ['/tmp/a.bin'].
b greet2.