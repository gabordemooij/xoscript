

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Gahunda imicungire-yububiko: 0.

>> txt := ['1.6'].
>> n := txt umubare.
>> t := txt buliyani.
Ibisohoka andika: n, umurongo-mushya.
Ibisohoka andika: t, umurongo-mushya.
Ibisohoka andika: n ubwoko, umurongo-mushya.
Ibisohoka andika: t ubwoko, umurongo-mushya.

Gahunda sukura.

usedMemory1 := (Gahunda ububiko ? 0).


txt := ['1.6'].
n := txt umubare.
t := txt buliyani.
Ibisohoka andika: n, umurongo-mushya.
Ibisohoka andika: t, umurongo-mushya.
Ibisohoka andika: n ubwoko, umurongo-mushya.
Ibisohoka andika: t ubwoko, umurongo-mushya.

Gahunda sukura.
usedMemory2 := (Gahunda ububiko ? 0).


txt := ['1.6'].
n := txt umubare.
t := txt buliyani.
Ibisohoka andika: n, umurongo-mushya.
Ibisohoka andika: t, umurongo-mushya.
