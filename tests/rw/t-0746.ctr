Ibisohoka andika: ['Test object'], umurongo-mushya.
>> a := Ikintu gishya. 

a bigeze: ['item:'] kora: { :dict
	icyacyo dict := dict. 
}.

a bigeze: ['item'] kora: { <- icyacyo dict.
}.

a item: (
Inkoranyamagambo gishya
	hello: ['world'],
	world: (Inkoranyamagambo gishya shyira: ['a'] kuri: ['b'])).

Ibisohoka andika: a item, umurongo-mushya.

>> old-dict-address := a item icyitegererezo aderesi-yububiko.
a save-as: ['/tmp/a.bin'].
Ibisohoka andika: ['========== RELOADING SNAP:'], umurongo-mushya.

>> b := Ikintu load-from: ['/tmp/a.bin'].

(b item icyitegererezo aderesi-yububiko = old-dict-address) ukuri: {
	Ibisohoka andika: ['Object link re-attached.'], umurongo-mushya.
}.

Ibisohoka andika: b item, umurongo-mushya.
