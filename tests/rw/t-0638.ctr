
Server init.
>> rq := Ubusabe-HTTP gishya.
Ibisohoka andika: ['HTTP-GET d[]=']  + ( rq get-urutonde: ['d[]'] ), umurongo-mushya. # GET
Ibisohoka andika: ['HTTP-GET f[]=']  + ( rq get-urutonde: ['f[]'] ), umurongo-mushya. # GET
Ibisohoka andika: ['HTTP-POST e[]='] + ( rq post-urutonde: ['e[]'] ), umurongo-mushya. # GET
Ibisohoka andika: ['HTTP-POST c=']   + ( rq post: ['c'] ), umurongo-mushya. # GET
Ibisohoka andika: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), umurongo-mushya. # GET
