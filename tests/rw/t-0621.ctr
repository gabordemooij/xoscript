>> phrases := Urutonde gishya
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases buri: { :_ :phrase 
	>> e := Server base64-shyira-kode: phrase.
	>> d := Server base64-kuramo-kode: e.
	Ibisohoka andika: (
		message koporora ~encoded: e, ~decoded: d
	), umurongo-mushya.
}.
