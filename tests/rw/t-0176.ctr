

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Gahunda imicungire-yububiko: 0.

>> txt := ['Word Salad'].
Ibisohoka andika: ['Text Length: '] + txt uburebure, umurongo-mushya.
Ibisohoka andika: ['Character at 2:'] + ( txt inyuguti: 2 ), umurongo-mushya.
Ibisohoka andika: (( txt shaka: ['S'] ) - 0), umurongo-mushya.

Gahunda sukura.

usedMemory1 := (Gahunda ububiko ? 0).


txt := ['Word Salad'].
Ibisohoka andika: ['Text Length: '] + txt uburebure, umurongo-mushya.
Ibisohoka andika: ['Character at 2:'] + ( txt inyuguti: 2 ), umurongo-mushya.
Ibisohoka andika: (( txt shaka: ['S'] ) - 0), umurongo-mushya.

Gahunda sukura.
usedMemory2 := (Gahunda ububiko ? 0).


txt := ['Word Salad'].
Ibisohoka andika: ['Text Length: '] + txt uburebure, umurongo-mushya.
Ibisohoka andika: ['Character at 2:'] + ( txt inyuguti: 2 ), umurongo-mushya.
Ibisohoka andika: (( txt shaka: ['S'] ) - 0), umurongo-mushya.

Gahunda sukura.
usedMemory3 := (Gahunda ububiko ? 0).



( usedMemory1 = usedMemory2 na: usedMemory1 = usedMemory3, na: usedMemory2 = usedMemory3 ) ukuri: {
	Ibisohoka andika: ['No memory leaks here'].
}, ikinyoma: {
	Ibisohoka andika: ['Leaking memory...'].
}.
