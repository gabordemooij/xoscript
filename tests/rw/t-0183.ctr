

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Gahunda imicungire-yububiko: 0.

>> o := Ikintu gishya.
>> o2 := Ikintu gishya.
Ibisohoka andika: o Ntacyo?, umurongo-mushya.
Ibisohoka andika: o ubwoko, umurongo-mushya.
Ibisohoka andika: ( o ni-kimwe: o ), umurongo-mushya.
Ibisohoka andika: ( o ni-kimwe: o2 ), umurongo-mushya.
Ibisohoka andika: o njye-ubwanjye, umurongo-mushya.
Ibisohoka andika: ( o kora byakozwe ), umurongo-mushya.

Gahunda sukura.

usedMemory1 := (Gahunda ububiko ? 0).


o := Ikintu gishya.
o2 := Ikintu gishya.
Ibisohoka andika: o Ntacyo?, umurongo-mushya.
Ibisohoka andika: o ubwoko, umurongo-mushya.
Ibisohoka andika: ( o ni-kimwe: o ), umurongo-mushya.
Ibisohoka andika: ( o ni-kimwe: o2 ), umurongo-mushya.
Ibisohoka andika: o njye-ubwanjye, umurongo-mushya.
Ibisohoka andika: ( o kora byakozwe ), umurongo-mushya.

Gahunda sukura.
usedMemory2 := (Gahunda ububiko ? 0).


o := Ikintu gishya.
o2 := Ikintu gishya.
Ibisohoka andika: o Ntacyo?, umurongo-mushya.
Ibisohoka andika: o ubwoko, umurongo-mushya.
Ibisohoka andika: ( o ni-kimwe: o ), umurongo-mushya.
