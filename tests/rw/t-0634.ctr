# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Gahunda shell-escape: ['abc'].
Ibisohoka andika: c, umurongo-mushya.
Ibisohoka andika: ( Gahunda sisitemu: ['echo '] + c ), umurongo-mushya.

c := Gahunda shell-escape: ['a'b'c'].
Ibisohoka andika: c, umurongo-mushya.
Ibisohoka andika: ( Gahunda sisitemu: ['echo '] + c ), umurongo-mushya.

c := Gahunda shell-escape: ['a\'c'].
Ibisohoka andika: c, umurongo-mushya.
Ibisohoka andika: ( Gahunda sisitemu: ['echo '] + c ), umurongo-mushya.