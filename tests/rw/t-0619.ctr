>> HTML := Ikintu gishya.
HTML bigeze: ['subiza:'] kora: { :tag 
	Ibisohoka andika: (['<tag>'] tag: tag), umurongo-mushya.
}.
HTML bigeze: ['subiza:na:'] kora: { :tag :html 
	Ibisohoka andika: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), umurongo-mushya.
}.
>> html := HTML gishya.
html body h1: ['header'].

