60 × {
	>> x := (Umubare random % 6) + 1.
	(x ≤ 6) ikinyoma: { Ibisohoka andika: ['FAIL']. }.
	(x ≥0) ikinyoma: { Ibisohoka andika: ['FAIL']. }.
	x := (Umubare random % 3) + 1.
	(x < 3) ikinyoma: { Ibisohoka andika: ['FAIL']. }.
	(x>-1) ikinyoma: { Ibisohoka andika: ['FAIL']. }.
	x := ((Buliyani flip) umubare).
	(x = 0 cyangwa: x = 1) ikinyoma: { Ibisohoka andika: ['FAIL']. }.
	x := ((Ukuri flip) umubare).
	(x = 0 cyangwa: x = 1) ikinyoma: { Ibisohoka andika: ['FAIL']. }.
	x := (Buliyani flip iki: ['HEAD'] cyangwa-kiriya: ['TAIL']).
	((x = ['HEAD']) cyangwa: (x = ['TAIL'])) ikinyoma: { Ibisohoka andika: ['FAIL']. }.
}.
Ibisohoka andika: ['DONE'].

