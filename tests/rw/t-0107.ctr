
Ibisohoka andika: ['Break for-loop, 0-4.'], umurongo-mushya.
{ :i
	Ibisohoka andika: ['iteration #'] + i, umurongo-mushya.
	(i = 4) hagarika-isubiramo.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Ibisohoka andika: ['Break while-true loop, 0-4.'], umurongo-mushya.
{
	Ibisohoka andika: ['iteration #'] + x, umurongo-mushya.
	x ongeraho: 1.
	((x < 5) ikinyuranyo) hagarika-isubiramo.
} igihe-cyose: xIsLessThan10.

Ibisohoka andika: ['Break while-false loop, 5,4.'], umurongo-mushya.
{
	Ibisohoka andika: ['iteration #'] + x, umurongo-mushya.
	x kuramo: 1.
	(x = 3) hagarika-isubiramo.
} igihe-cyose: { <- (x > 0). }.

Ibisohoka andika: ['Break times loop, 1-4.'], umurongo-mushya.
{ :i
	Ibisohoka andika: ['iteration #'] + i, umurongo-mushya.
	(i = 4) hagarika-isubiramo.
} × 5.

Ibisohoka andika: ['Break block, dont print line.'], umurongo-mushya.
{ Ukuri hagarika-isubiramo. Ibisohoka andika: ['dont write this!'], umurongo-mushya. } tangira.

Ibisohoka andika: ['Break block, dont fire catch...'], umurongo-mushya.
{ Ukuri hagarika-isubiramo. Ibisohoka andika: ['dont write this!'], umurongo-mushya. } fata-ikosa: { Ibisohoka andika: ['Dont catch this!']. }, tangira.

Ibisohoka andika: ['Test Array each-loop: 0,1'], umurongo-mushya.
(Urutonde ← 1 ; 2 ; 3) hindura-buri-kimwe: { :i
	Ibisohoka andika: ['iteration #'] + i, umurongo-mushya.
	(i = 1) hagarika-isubiramo.
}.

Ibisohoka andika: ['Test Map each-loop: c only'], umurongo-mushya.
>> m := Inkoranyamagambo gishya.
m shyira: ['first'] kuri: ['a'], shyira: ['second'] kuri: ['b'], shyira: ['third'] kuri: ['c'].
m buri: { :k :v
	Ibisohoka andika: ['iteration'] + v + k, umurongo-mushya.
	Ukuri hagarika-isubiramo.
}.

