#Linux
>> OS := Gahunda igenamiterere: ['OS'].

>> clock := Akanya gishya.
	
(OS = ['Haiku']) ukuri: {
	clock agace-kigihe: ['CET'],
	umwaka: 2017, ukwezi: 7, umunsi: 13,
	isaha: 18, umunota: 0, isegonda: 0.
}, bitabaye-ibyo: {
	clock agace-kigihe: ['Europe/Amsterdam'],
	umwaka: 2017, ukwezi: 7, umunsi: 13,
	isaha: 18, umunota: 0, isegonda: 0.
}.

clock bigeze: ['tell'] kora: {
	Ibisohoka andika: ubwacyo, umurongo-mushya.
}.


clock ongeraho: 2    isaha, tell.
clock ongeraho: 1    isaha, tell.
clock ongeraho: 19 umunota, tell.
clock ongeraho: 1  umunota, tell.
clock ongeraho: 1  umunota, tell.
clock ongeraho: 19 isegonda, tell.
clock ongeraho: 1  isegonda, tell.
clock ongeraho: 1  isegonda, tell.
clock ongeraho: 2    umwaka, tell.
clock ongeraho: 1    umwaka, tell.

(OS = ['Haiku']) ukuri: {
clock ongeraho: 5   ukwezi.
clock agace-kigihe: ['CEST'], tell.
}, bitabaye-ibyo: {
	clock ongeraho: 5   ukwezi, tell.
}.

clock ongeraho: 1   ukwezi, tell.
clock ongeraho: 19    umunsi, tell.
clock ongeraho: 1    isaha, tell.
clock ongeraho: 120  yard, tell.
