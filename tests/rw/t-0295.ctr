
>> dictionary := (
	Inkoranyamagambo gishya
		shyira: ['b'] kuri: ['a'],
		shyira: ['a'] kuri: ['b'],
		shyira: ['z'] kuri: ['x'],
		shyira: ['hello'] kuri: ['hallo'],
		shyira: ['human'] kuri: ['human']
).

>> comparisons := Urutonde gishya.
dictionary buri: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a gereranya: b)
	).
}.

comparisons tondeka: { :a :b <- ( a gereranya: b ). }.
Ibisohoka andika: ( comparisons huza: ['↵'] ), umurongo-mushya.
comparisons huza: ['↵'].
