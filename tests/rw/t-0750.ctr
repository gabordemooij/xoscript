Ibisohoka andika: ['Test object'], umurongo-mushya.
>> a := Ikintu gishya. 

a bigeze: ['item:'] kora: { :nil
	icyacyo nil := nil. 
}.

a bigeze: ['item'] kora: { <- icyacyo nil.
}.

a item: Ntacyo.

Ibisohoka andika: a item, umurongo-mushya.

>> old-nil-address := a item icyitegererezo aderesi-yububiko.
a save-as: ['/tmp/a.bin'].
Ibisohoka andika: ['========== RELOADING SNAP:'], umurongo-mushya.

>> b := Ikintu load-from: ['/tmp/a.bin'].

(b item icyitegererezo aderesi-yububiko = old-nil-address) ukuri: {
	Ibisohoka andika: ['Object link re-attached.'], umurongo-mushya.
}.

Ibisohoka andika: b item, umurongo-mushya.
