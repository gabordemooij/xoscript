
>> Greeter := Ikintu gishya.
Greeter bigeze: ['gishya'] kora: {
	icyacyo izina := ['?'].
}.
Greeter bigeze: ['name:'] kora: { :izina
	icyacyo izina := izina.
}.
Greeter bigeze: ['greet'] kora: {
	Ibisohoka andika: (['hello[you]'] [you]: icyacyo izina).
}.
>> friend := Greeter gishya.
friend name: ['1'].
friend greet.
