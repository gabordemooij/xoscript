# test qualifiers

Gahunda sukura.

>> Fruit := Ikintu gishya.
Fruit bigeze: ['gishya'] kora: {
	>> f := ubwacyo gishya.
	f apples: 0. <- f.
}.
Fruit bigeze: ['apples:'] kora: { :a icyacyo apples := a. }.
Fruit bigeze: ['apples'] kora: { <- icyacyo apples. }.
Fruit bigeze: ['+'] kora: { :f
	>> n := Fruit gishya.
	n apples: (f apples + icyacyo apples). <- n.
}.
Umubare bigeze: ['apples'] kora: { <- ((Fruit gishya) apples: ubwacyo).
}.

Fruit bigeze: ['inyandiko'] kora: { <- icyacyo apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Ibisohoka andika: q, umurongo-mushya.




q := 3 apples + 4 apples.
Ibisohoka andika: q, umurongo-mushya.



q := 3 apples + 4 apples.
Ibisohoka andika: q, umurongo-mushya.


