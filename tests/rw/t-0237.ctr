
Inyandiko bigeze: ['evaluate'] kora: {
	>> kode := Dosiye gishya: ['/tmp/eval.ctr'].
	kode andika: (ubwacyo inyandiko + ['.']).
	Gahunda koresha: ['/tmp/eval.ctr'].
}.

>> map :=
	(Inkoranyamagambo gishya)
	shyira: ['Hi There'] kuri: ['two'],
	shyira: (Urutonde ← ['hello'] ; ['world'] ; (Urutonde ← 1 ; 2; 9) ; Ikinyoma) kuri: ['one'],
	shyira: ( (Inkoranyamagambo gishya) shyira: ['wrrld'] kuri: ['misspelled'] ) kuri: ['three'],
	shyira: (Urutonde ← ((Inkoranyamagambo gishya) shyira: ['treasure'] kuri: ['hidden']) ; 2) kuri: ['four']. 
>> str := map inyandiko.
>> map2 := Ntacyo.
(['map2 := '] + str ) evaluate.
Ibisohoka andika: map2 ? ['one'] ? 0.
Ibisohoka andika: map2 ? ['one'] ? 1.
Ibisohoka andika: map2 ? ['four'] ? 0 ? ['hidden'].
Ibisohoka andika: map2 ? ['one'] ? 2 ? 2.
