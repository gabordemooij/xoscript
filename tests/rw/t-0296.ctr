
>> shop := (Inkoranyamagambo gishya
	shyira: ['magazine'] kuri: ['books'],
	shyira: ['computer'] kuri: ['electronics'],
	shyira: ['lipstick'] kuri: ['cosmetics']
).
Ibisohoka andika: (shop ifite: ['computer']), umurongo-mushya. 
Ibisohoka andika: (shop ifite: ['sausage']), umurongo-mushya. 
Ibisohoka andika: (shop ifite: ['computers']), umurongo-mushya. 
Ibisohoka andika: (shop ifite: ['compute']), umurongo-mushya. 
Ibisohoka andika: (shop ifite: ['2computer']), umurongo-mushya. 
