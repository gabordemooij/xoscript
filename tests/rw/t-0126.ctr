#Linux
>> Slurp := Ikintu gishya.

Slurp bigeze: ['gishya'] kora: {
	icyacyo str := [''].
}.

Slurp bigeze: ['nieuw'] kora: {
	icyacyo str := [''].
}.

Slurp bigeze: ['subiza:'] kora: { :blah
		icyacyo str ongera-ku-mpera: blah.
}.

Slurp bigeze: ['subiza:na:'] kora: { :blah :blahah
		icyacyo str ongera-ku-mpera: (blah kuva: 0 uburebure: (blah uburebure - 1)).
		icyacyo str ongera-ku-mpera: [' '].
		icyacyo str ongera-ku-mpera: blahah.
}.

Slurp bigeze: ['obtain'] kora: {
	>> buffer := icyacyo str.
	icyacyo str := ['']. <- buffer.
}.


Ibisohoka andika: (Gahunda sisitemu: (Slurp gishya echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Dosiye gishya: ['/tmp/from.txt'], siba. } fata-ikosa: { ['Empty']. }, tangira.
{ Dosiye gishya: ['/tmp/to.txt'], siba. } fata-ikosa: { ['Empty']. }, tangira.


Dosiye gishya: ['/tmp/to.txt'], ibaho ikinyoma: {
	Ibisohoka andika: ['Confirmed. Target file does not exist.\
'].
}.
Dosiye gishya: ['/tmp/from.txt'], ibaho ikinyoma: {
	Ibisohoka andika: ['Confirmed. Source file does not exist.\
'].
}.



Gahunda sisitemu: (Slurp gishya touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Gahunda sisitemu: (Slurp gishya cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Dosiye gishya: ['/tmp/to.txt'], ibaho ukuri: {
	Ibisohoka andika: ['Confirmed. Target file has been created by shell.\
'].
}.


Ibisohoka andika: ['Contents of file is:'] + (Dosiye gishya: ['/tmp/to.txt'], soma), umurongo-mushya.
