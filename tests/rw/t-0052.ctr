>> items := Inkoranyamagambo gishya.
items shyira: ['green'] kuri: ['color-1'].
items shyira: ['orange'] kuri: ['color-2'].
items shyira: ['red'] kuri: ['color-3'].
>> i := 0.
>> s := [''].
items buri: { :key :color
	Ibisohoka andika: ['color #'] + i + [' is: '] + color + [' '].
	i ongeraho: 1.
}.
Ibisohoka andika: i + [' colors!'].
