

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Gahunda imicungire-yububiko: 0.

>> a := Urutonde ← ['hello'] ; ['world'] ; Ukuri ; Ntacyo ; 666.
a kora kuramo-icya-nyuma kuramo-icya-mbere ongera-ku-ntangiriro: ['hi'], ongera-ku-mpera: 999, byakozwe.
Ibisohoka andika: ( a huza: [','] ), umurongo-mushya.

Gahunda sukura.
usedMemory1 := (Gahunda ububiko ? 0).


a := Urutonde ← ['hello'] ; ['world'] ; Ukuri ; Ntacyo ; 666.
a kuramo-icya-nyuma. a kuramo-icya-mbere. a ongera-ku-ntangiriro: ['hi'], ongera-ku-mpera: 999.
Ibisohoka andika: ( a huza: [','] ), umurongo-mushya.


