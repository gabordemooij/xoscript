Umubare bigeze: ['factorial'] kora: {
	>> total := 1.
	{ :index total kuba-na: (ubwacyo - (index)). } × ubwacyo. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Ibisohoka andika: a.
>> b := 2 + 3 factorial.
Ibisohoka andika: b.
>> c := 3 factorial + 2.
Ibisohoka andika: c.
>> d := 2 + (3 factorial).
Ibisohoka andika: d.
Ibisohoka andika: 2 + 3 factorial + 1.
