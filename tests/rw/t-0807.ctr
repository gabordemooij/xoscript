# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB gishya uwakira: ['localhost'],
	izina-ryukoresha: ['xo'],
	ijambobanga: ['pass123'],
	izina-ryububikoshingiro: ['xobase'],
	ihuze.

>> ibipimo-byishakisha := db ikibazo: ['SELECT %% FROM'].
{ ibipimo-byishakisha shyira-mu-bikorwa. } fata-ikosa: { :e
	Ibisohoka andika: ( e ikubiyemo: ['%%'] ), umurongo-mushya.
}, tangira.
