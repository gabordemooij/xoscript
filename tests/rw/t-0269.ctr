#Linux

(Dosiye gishya: ['/tmp/testje']) ibaho ikinyoma: {
	Gahunda sisitemu: ['mkdir /tmp/testje'].	
}.

(Dosiye gishya: ['/tmp/testje/file1']) ibaho ikinyoma: {
	Gahunda sisitemu: ['touch /tmp/testje/file1'].	
}.

(Dosiye gishya: ['/tmp/testje/folder1']) ibaho ikinyoma: {
	Gahunda sisitemu: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Dosiye urutonde: ['/tmp/testje'].

>> q := Urutonde gishya.

l buri: { :k :v v buri: { :x :y q ongera-ku-mpera: y. }. }.

>> s := q inyandiko.

(s ikubiyemo: ['file1']) ukuri:   { Ibisohoka andika: ['OK'], umurongo-mushya. }.
(s ikubiyemo: ['file2']) ukuri:   { Ibisohoka andika: ['XX'], umurongo-mushya. }.
(s ikubiyemo: ['folder1']) ukuri: { Ibisohoka andika: ['OK'], umurongo-mushya. }.
