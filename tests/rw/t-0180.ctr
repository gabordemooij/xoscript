Inyandiko bigeze: ['html'] kora: { <- (
		ubwacyo
		simbuza: ['&'] na: ['&amp;'],
		simbuza: ['<'] na: ['&lt;'],
		simbuza: ['>'] na: ['&gt;'],
		simbuza: ['''] na: ['&apos;'],
		simbuza: ['"'] na: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Gahunda imicungire-yububiko: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Ibisohoka andika: txt koporora html, umurongo-mushya.
Ibisohoka andika: txt koporora inyuguti-nto, umurongo-mushya.
Ibisohoka andika: txt koporora inyuguti-nkuru, umurongo-mushya.
} tangira.

Gahunda sukura.

usedMemory1 := (Gahunda ububiko ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Ibisohoka andika: txt koporora html, umurongo-mushya.
Ibisohoka andika: txt koporora inyuguti-nto, umurongo-mushya.
Ibisohoka andika: txt koporora inyuguti-nkuru, umurongo-mushya.
} tangira.

Gahunda sukura.
usedMemory2 := (Gahunda ububiko ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Ibisohoka andika: txt koporora html, umurongo-mushya.
Ibisohoka andika: txt koporora inyuguti-nto, umurongo-mushya.
Ibisohoka andika: txt koporora inyuguti-nkuru, umurongo-mushya.
} tangira.

Gahunda sukura.
usedMemory3 := (Gahunda ububiko ? 0).



( usedMemory1 = usedMemory2 na: usedMemory1 = usedMemory3, na: usedMemory2 = usedMemory3 ) ukuri: {
	Ibisohoka andika: ['No memory leaks here'].
}, ikinyoma: {
	Ibisohoka andika: ['Leaking memory...'].
}.
