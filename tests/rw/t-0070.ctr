>> numbers := ['1,2,3'] gabanya: [','].
Ibisohoka andika: ['I got: '] + numbers umubare-wibintu + [' numbers.'],umurongo-mushya.
{ :i Ibisohoka andika: ['number #'] + i + [':'] + (numbers umwanya: i), umurongo-mushya.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages gabanya: [' Or '].
Ibisohoka andika: ['We serve'], umurongo-mushya.
{ :i Ibisohoka andika: ['->'] + (beverages umwanya: i), umurongo-mushya. } × (beverages umubare-wibintu).
Ibisohoka andika: (beverages huza: [',']), umurongo-mushya.
Ibisohoka andika: (numbers huza: ['||']).
