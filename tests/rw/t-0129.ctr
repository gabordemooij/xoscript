
Urutonde bigeze: ['product'] kora: {
	>> total := 1.
	ubwacyo buri: { :index :element
		total kuba-na: element.
	}. <- total.
}.

>> a := Urutonde ← 1 ; 2 ; 3.
Ibisohoka andika: a product, umurongo-mushya.
Ibisohoka andika: (Urutonde ← 2 ; 4 ; 8) product, umurongo-mushya. 
Ibisohoka andika: (Urutonde ← -2 ; 10) product, umurongo-mushya. 
Ibisohoka andika: (Urutonde ← 0.5 ; -2) product, umurongo-mushya. 
