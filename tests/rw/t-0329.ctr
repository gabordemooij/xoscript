Ibisohoka andika: ((Urutonde gishya
	bigeze: ['plaque:'] kora: { :x icyacyo o := x. },
	bigeze: ['plaque']  kora: { <- icyacyo o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Urutonde ← 1)
	~ (Urutonde ← 1 ; 2)
	~ (Urutonde ← 1 ; 2 ; 3)
	~ (Urutonde ← 1 ; 2 ; 3 ; 4)
	~ (Urutonde ← 1 ; 2 ; 3 ; 4 ; 5)
) buri: { :i :el
	{ Ibisohoka andika: uyu-murimo. } × el umubare-wibintu.
	Ibisohoka umurongo-mushya.
}) plaque, umurongo-mushya.


