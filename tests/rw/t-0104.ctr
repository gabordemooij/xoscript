
{ :i
	Ibisohoka andika: ['This is step #'] + ( ( i ) + 1 ), umurongo-mushya.
} × 6.

{ :i
	Ibisohoka andika: ['This is step #'] + ( 3 - ( i ) ), umurongo-mushya.
} × 6.

{ :i
	Ibisohoka andika: ['NEVER!'], umurongo-mushya.
} × 0.



{ :i
	Ibisohoka andika: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), umurongo-mushya.
} × 11.
