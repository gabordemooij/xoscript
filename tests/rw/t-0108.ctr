
(7 igiharwe?) ukuri: { Ibisohoka andika: ['7 is an ODD NUMBER'], umurongo-mushya. }, bitabaye-ibyo: { Ibisohoka andika: ['WRONG!']. }.
(4 ikinyabibiri?) ukuri: { Ibisohoka andika: ['4 is an EVEN NUMBER'], umurongo-mushya. }, bitabaye-ibyo: { Ibisohoka andika: ['WRONG!']. }.
(5 ikinyabibiri?) ukuri: { Ibisohoka andika: ['WRONG!']. }, bitabaye-ibyo: { Ibisohoka andika: ['5 is NOT AN EVEN NUMBER'], umurongo-mushya. }.
(6 igiharwe?) ukuri: { Ibisohoka andika: ['WRONG!']. }, bitabaye-ibyo: { Ibisohoka andika: ['6 is NOT AN ODD NUMBER'], umurongo-mushya. }.
