Ibisohoka andika: ['Test object'], umurongo-mushya.
>> l := Urutonde gishya ; 1 ; ( Urutonde gishya ; (Akanya gishya: 1) ; (Int64 bivuye-mu-nyandiko: ['321']) ; (Urutonde gishya ; 3)).
Ibisohoka andika: l, umurongo-mushya.
>> old-lst-address := l icyitegererezo aderesi-yububiko.
l save-as: ['/tmp/a.bin'].
Ibisohoka andika: ['========== RELOADING SNAP:'], umurongo-mushya.
>> b := Ikintu load-from: ['/tmp/a.bin'].
(b icyitegererezo aderesi-yububiko = old-lst-address) ukuri: {
	Ibisohoka andika: ['Object link re-attached.'], umurongo-mushya.
}.
Ibisohoka andika: b, umurongo-mushya.
