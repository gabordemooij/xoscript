Ibisohoka andika: ['Continue for-loop, No - before 6 and up.'], umurongo-mushya.
{ :i
	Ibisohoka andika: (i + 1), umurongo-mushya.
	((i + 1) > 4) komeza.
	Ibisohoka andika: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Ibisohoka umurongo-mushya.
Ibisohoka andika: ['Continue while-true, No --> before 5 and up.'], umurongo-mushya.
{
	Ibisohoka andika: ['iteration #'] + x, umurongo-mushya.
	x ongeraho: 1.
	((x < 5) ikinyuranyo) komeza.
	Ibisohoka andika: ['-->'].
} igihe-cyose: xIsLessThan10.
Ibisohoka umurongo-mushya.
Ibisohoka andika: ['Continue while-false, No - before 3 only.'], umurongo-mushya.
{
	Ibisohoka andika: ['iteration #'] + x, umurongo-mushya.
	x kuramo: 1.
	(x = 3) komeza.
	Ibisohoka andika: ['-'].
} igihe-cyose: { <- ( x > 0). }.

Ibisohoka umurongo-mushya.
Ibisohoka andika: ['Continue times-loop, No ||| before 3.'], umurongo-mushya.
{ :i
	Ibisohoka andika: ['iteration #'] + i, umurongo-mushya.
	(i = 2) komeza.
	Ibisohoka andika: ['|||'].
} × 5.

Ibisohoka umurongo-mushya.

{ Ukuri komeza. Ibisohoka andika: ['dont write this!'], umurongo-mushya. } tangira.

{ Ukuri komeza. Ibisohoka andika: ['dont write this!'], umurongo-mushya. } fata-ikosa: { Ibisohoka andika: ['Dont catch this!']. }, tangira.

Ibisohoka andika: ['Test Array each-loop: 0, ... ,2'], umurongo-mushya.
(Urutonde ← 1 ; 2 ; 3) hindura-buri-kimwe: { :i
	(i = 1) komeza.
	Ibisohoka andika: ['iteration #'] + (i - 0), umurongo-mushya.
}.

Ibisohoka andika: ['Test Map each-loop: c only'], umurongo-mushya.
>> m := Inkoranyamagambo gishya.
m shyira: ['first'] kuri: ['a'], shyira: ['second'] kuri: ['b'], shyira: ['third'] kuri: ['c'].
m buri: { :k :v
	(k ≠ ['c']) komeza.
	Ibisohoka andika: ['iteration'] + k + v, umurongo-mushya.
}.

