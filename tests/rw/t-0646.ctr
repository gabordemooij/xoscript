Server init.
Ibisohoka andika: ['Database datetime test'], umurongo-mushya.

>> db := Maria-DB gishya uwakira: ['localhost'],
	izina-ryukoresha: ['xo'], 
	ijambobanga: ['pass123'],
	izina-ryububikoshingiro: ['xobase'],
	ihuze.

>> ibipimo-byishakisha :=
db ikibazo: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
zana: { :row
	Ibisohoka andika: row datetimetest, umurongo-mushya.
}.
