Ibisohoka andika: ['Test object'], umurongo-mushya.
>> a := Ikintu gishya. 

a bigeze: ['item:'] kora: { :fmt
	icyacyo fmt := fmt. 
}.

a bigeze: ['item'] kora: { <- icyacyo fmt.
}.

a item: ( Imiterere gishya: ['|%s|'] ).

Ibisohoka andika: a item, umurongo-mushya.

>> old-fmt-address := a item icyitegererezo aderesi-yububiko.
a save-as: ['/tmp/a.bin'].
Ibisohoka andika: ['========== RELOADING SNAP:'], umurongo-mushya.

>> b := Ikintu load-from: ['/tmp/a.bin'].

(b item icyitegererezo aderesi-yububiko = old-fmt-address) ukuri: {
	Ibisohoka andika: ['Object link re-attached.'], umurongo-mushya.
}.

Ibisohoka andika: ( b item shyira-kuri: ['hello'] ), umurongo-mushya.
