# backslashes must survive code serialization, strings must not end early
>> indangagaciro := Urutonde gishya
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

indangagaciro buri: { :i :value
	>> d := Inkoranyamagambo gishya.
	d shyira: value kuri: ['k'].
	>> r := d kode ikintu.
	Ibisohoka andika: r umubare-wibintu, umurongo-mushya.
	Ibisohoka andika: ( (r ahantu: ['k']) = value ), umurongo-mushya.
}.
