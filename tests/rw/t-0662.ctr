>> t := Ntacyo.

# you can control the time zone for
# parsing like this:
Akanya agace-kigihe: ['CET'].
t := Akanya inkomoko: ['1981-02-03 04:05:06'].
Ibisohoka andika: t, umurongo-mushya.

# now using CEST time zone:
Akanya agace-kigihe: ['CEST'].
t := Akanya inkomoko: ['1981-02-03 04:05:06'].
Ibisohoka andika: t, umurongo-mushya.

# error if string cannot be parsed
{ Akanya inkomoko: ['1900']. } fata-ikosa: { Ntacyo. }, tangira.
