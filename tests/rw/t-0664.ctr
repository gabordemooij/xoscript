# recursive interpolation not allowed

Ibisohoka andika: 
['recursive string interolation enabled: '] + (
	Gahunda ubushobozi: 
	['RECURSIVE_STRINTPOL']
), umurongo-mushya.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Ibisohoka andika: a, umurongo-mushya.


Gahunda ubushobozi: ['RECURSIVE_STRINTPOL'] fungura: Ukuri.

