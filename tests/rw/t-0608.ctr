
>> Size := Ikintu gishya.
Size bigeze: ['is:'] kora: { :umubare
	umubare bigeze: ['+'] kora: { :umubare
		>> unit := umubare igipimo-cyumubare.
		>> factor := 1.
		
		unit
		niba-ari: ['inch'] kora: { factor := 0.0833. }. <- ubwacyo + (umubare * factor).
	}. <- umubare.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Ibisohoka andika: plank + edge, umurongo-mushya.
