
>> Rectangle := Ikintu gishya.

Rectangle bigeze: ['area'] kora: { <- icyacyo uburebure * icyacyo width.
}.

Rectangle bigeze: ['length:'] kora: { :uburebure
	icyacyo uburebure := uburebure.
}.

Rectangle bigeze: ['width:'] kora: { :width
	icyacyo width := width.
}.

Rectangle bigeze: ['gishya'] kora: {
	# this will not result into an infinite loop
	>> rectangle := ubwacyo gishya.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle gishya.
Ibisohoka andika: a area, umurongo-mushya. #0

>> b := Rectangle gishya length: 2, width: 3.
Ibisohoka andika: b area, umurongo-mushya. #6

