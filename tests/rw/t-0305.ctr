
Umubare iga: ['plus:'] bisobanura: ['+'].
Umubare bigeze: ['+'] kora: { :x
	>> rate := 1.
	>> currency := x igipimo-cyumubare.
	(currency = ['euros']) ukuri: {
		rate := 2.
	}. <- (ubwacyo plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars igipimo: ['dollars'].
euros igipimo: ['euros'].
>> money := dollars + euros.
Ibisohoka andika: money, umurongo-mushya.
