>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Ikintu gishya.
⚄ bigeze: ['drawFrom:length:'] kora: { :pool :umubare-wibintu
	
	>> result := [''].
	
	{
		>> index := Umubare random % (pool uburebure).
		result ongera-ku-mpera: ( pool inyuguti: (index + 1) ).
		
	} × umubare-wibintu. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? uburebure.
Ibisohoka andika: (['x↵'] x random uburebure).
Ibisohoka andika: (['y↵'] y ?? uburebure).

