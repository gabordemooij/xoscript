# test list operations


>> cakes := Urutonde ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes simbuza: 1 uburebure: 2 na: ( Urutonde ← ['cinnamon'] ; ['pineapple'] ).
Ibisohoka andika: (buy huza: [',']), umurongo-mushya.


>> buy := cakes simbuza: 1 uburebure: 12 na: ( Urutonde ← ['cinnamon'] ; ['pineapple'] ).
Ibisohoka andika: (buy huza: [',']), umurongo-mushya.


>> buy := cakes simbuza: 2 uburebure: 10 na: ( Urutonde gishya ).
Ibisohoka andika: (buy huza: [',']), umurongo-mushya.


>> buy := cakes simbuza: 0 uburebure: 1 na: ( Urutonde gishya ).
Ibisohoka andika: (buy huza: [',']), umurongo-mushya.


>> buy := cakes simbuza: ['0'] uburebure: ['1'] na: ['x'].
Ibisohoka andika: (buy huza: [',']), umurongo-mushya.
