Server init.

Ibisohoka andika: (
	Icyitegererezo-cyishakisha gishya: ['^\\w+$'],
	guhura: ['test@example.com'] 
), umurongo-mushya. # 0 match, fails on @ and .

Ibisohoka andika: (
	Icyitegererezo-cyishakisha gishya: ['^[^@]+@[^\.]+\.\\w+$'],
	guhura: ['test@example.com'] 
), umurongo-mushya. # 1 match

Ibisohoka andika: (
	Icyitegererezo-cyishakisha gishya: ['[^@]+@[^\.]+\.\\w+'],
	guhura: ['test@example.com'] 
), umurongo-mushya. # 1 match

Ibisohoka andika: (
	Icyitegererezo-cyishakisha gishya: ['([^@]+)@([^\.]+)\.\\w+'],
	guhura: ['test@example.com'] 
), umurongo-mushya. # 1 match, groups dont matter

Ibisohoka andika: (
	Icyitegererezo-cyishakisha gishya: ['[a-z]'],
	guhura: ['test@example.com'] 
), umurongo-mushya. # 14 matches

Ibisohoka andika: (
	Icyitegererezo-cyishakisha gishya: ['.*'],
	guhura: ['test@example.com'] 
), umurongo-mushya. # 1 match (all)

Ibisohoka andika: (
	Icyitegererezo-cyishakisha gishya: ['(.*)'],
	guhura: ['test@example.com'] 
), umurongo-mushya. # 1 match (all)

Ibisohoka andika: (
	Icyitegererezo-cyishakisha gishya: ['\\s*[^@]+@[^\.]+\.\\w+'],
	guhura: ['test@example.com'] 
), umurongo-mushya. # 1 match, prefix space optional, gets ignored