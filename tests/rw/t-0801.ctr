Server init.

>> db := Maria-DB gishya uwakira: ['localhost'],
	izina-ryukoresha: ['xo'],
	ijambobanga: ['pass123'],
	izina-ryububikoshingiro: ['xobase'],
	ihuze.

>> del := db ikibazo: ['DELETE FROM book WHERE id > 0'].
{  del shyira-mu-bikorwa. db emeza. } fata-ikosa: { :e db subiza-inyuma.  }, tangira.

>> umubare-wibintu := db ikibazo: ['SELECT COUNT(*) AS num FROM book'].
umubare-wibintu zana: { :row Ibisohoka andika: row num, umurongo-mushya. }.
