# test qualifiers

>> $ := Ikintu gishya.

$ bigeze: ['subiza:'] kora: { :x
	
	>> operation := x inyuguti: 0.
	>> valuta := x inyuguti: 1.
	>> money := x simbuka: 2.
	
	>> amount := 0.

	( operation = ['+'] ) ukuri: {
		( valuta = ['£'] ) ukuri: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Ibisohoka andika: x, umurongo-mushya.


>> Fruit := Ikintu gishya.

Fruit bigeze: ['gishya'] kora: {
	>> f := ubwacyo gishya.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit bigeze: ['apples:'] kora: { :a icyacyo apples := a. }.
Fruit bigeze: ['oranges:'] kora: { :p icyacyo oranges := p. }.
Fruit bigeze: ['apples'] kora: { <- icyacyo apples. }.
Fruit bigeze: ['oranges'] kora: { <- icyacyo oranges. }.

Fruit bigeze: ['+'] kora: { :f
	
	>> n := Fruit gishya.
	f ongeraho: 1.
	
	n apples: (f apples + icyacyo apples).
	n oranges:  (f oranges  + icyacyo oranges). <- n.
}.

Fruit bigeze: ['inyandiko'] kora: { <- ( icyacyo apples inyandiko + [' apples and '] + icyacyo oranges + [' oranges'] ).
}.

Umubare bigeze: ['apples'] kora: { <- ((Fruit gishya) apples: ubwacyo).
}.

Umubare bigeze: ['apple'] kora: { <- ((Fruit gishya) apples: ubwacyo).
}.

Umubare bigeze: ['oranges'] kora: { <- ((Fruit gishya) oranges: ubwacyo).
}.




Ibisohoka andika: (1 apple + 3 oranges + 4 apples), umurongo-mushya.


Inyandiko bigeze: ['twice'] kora: { <- ((ubwacyo inyandiko) + (ubwacyo inyandiko)).
}.



Ibisohoka andika: ['❤❤❤'] twice.



