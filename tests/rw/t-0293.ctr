
>> city := Urutonde ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Urutonde ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature hakurikijwe: city.
>> cities := weather imfunguzo tondeka: { :a :b <- (a gereranya: b). }.
>> temperatures := weather indangagaciro tondeka: { :a :b <- (a gereranya: b) munsi-ya-zeru?. }.

Ibisohoka andika: (cities huza: [',']), umurongo-mushya.
Ibisohoka andika: (temperatures huza: [',']), umurongo-mushya.
