Ibisohoka andika: ['Test object'], umurongo-mushya.
>> p := Inzira /tmp.
Ibisohoka andika: p, umurongo-mushya.
>> old-p-address := p icyitegererezo aderesi-yububiko.
p save-as: ['/tmp/a.bin'].
Ibisohoka andika: ['========== RELOADING SNAP:'], umurongo-mushya.
>> b := Ikintu load-from: ['/tmp/a.bin'].
(b icyitegererezo aderesi-yububiko = old-p-address) ukuri: {
	Ibisohoka andika: ['Object link re-attached.'], umurongo-mushya.
}.
Ibisohoka andika: b, umurongo-mushya.
