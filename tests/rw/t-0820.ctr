# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Icyitegererezo-cyishakisha gishya: pattern.
	p guhura: subject kora: { :m :g
		Ibisohoka andika: g umubare-wibintu, andika: [' '], andika: (g huza: ['|']), umurongo-mushya. <- m.
	}.
}.
show shyira-kuri: ['(a)|(b)'] na: ['b'].
show shyira-kuri: ['(a)|(b)'] na: ['a'].
show shyira-kuri: ['(x)?y'] na: ['y'].
show shyira-kuri: ['(x)?(y)(z)?'] na: ['xy'].
