Ibisohoka andika: ['Test object'], umurongo-mushya.
>> a := Ikintu gishya. 

a bigeze: ['item:'] kora: { :octhelper
	icyacyo octhelper := octhelper. 
}.

a bigeze: ['item'] kora: { <- icyacyo octhelper.
}.

a item: Oct gishya.

>> old-octhelper-address := a item icyitegererezo aderesi-yububiko.
a save-as: ['/tmp/a.bin'].
Ibisohoka andika: ['========== RELOADING SNAP:'], umurongo-mushya.

>> b := Ikintu load-from: ['/tmp/a.bin'].

(b item icyitegererezo aderesi-yububiko = old-octhelper-address) ukuri: {
	Ibisohoka andika: ['Object link re-attached.'], umurongo-mushya.
}.
