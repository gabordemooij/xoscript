Ibisohoka andika: ['Test object'], umurongo-mushya.
>> a := Ikintu gishya. 
a bigeze: ['item:'] kora: { :int64
	icyacyo int64 := int64. 
}.
a bigeze: ['item'] kora: { <- icyacyo int64.
}.
a item: ( Int64 bivuye-mu-nyandiko: ['9999'] ).
Ibisohoka andika: a item, umurongo-mushya.
>> old-int64-address := a item icyitegererezo aderesi-yububiko.
a save-as: ['/tmp/a.bin'].
Ibisohoka andika: ['========== RELOADING SNAP:'], umurongo-mushya.
>> b := Ikintu load-from: ['/tmp/a.bin'].
(b item icyitegererezo aderesi-yububiko = old-int64-address) ukuri: {
	Ibisohoka andika: ['Object link re-attached.'], umurongo-mushya.
}.
Ibisohoka andika: ( b item ), umurongo-mushya.
