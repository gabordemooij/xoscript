#Linux

 >> t := Akanya gishya.
 
t agace-kigihe: ['Europe/Amsterdam'].
t umwaka: 2020, ukwezi: 8, umunsi: 2, isaha: 21, umunota: 2, isegonda: 1.

>> a := t isaha.
>> ams := t agace-kigihe.

t agace-kigihe: ['US/Hawaii'].
>> b := t isaha.
>> hw := t agace-kigihe.

Ibisohoka
andika: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		iki: ['later'] cyangwa-kiriya: ['earlier']
	)
),
umurongo-mushya.
 