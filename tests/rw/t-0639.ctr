
Server init.
Ibisohoka andika: ['Database test'], umurongo-mushya.

>> db := Maria-DB gishya uwakira: ['localhost'],
	izina-ryukoresha: ['xo'], 
	ijambobanga: ['pass123'],
	izina-ryububikoshingiro: ['xobase'],
	ihuze.

>> ibipimo-byishakisha :=
db ikibazo: ['SELECT REPEAT('Blah',1000) AS blah'], 
zana: { :row 
	Ibisohoka andika: row blah uburebure, umurongo-mushya.
}.
