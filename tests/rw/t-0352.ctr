Umubare bigeze: ['roman'] kora: {
	>> umubare := ubwacyo koporora.
	>> roman := [''].
	{
		{
			(umubare ≥ 1000) ukuri: {
				roman ongera-ku-mpera: ['Ⅿ'].
				umubare kuramo: 1000.
			}, hagarika-isubiramo.
		
			(umubare ≥ 500) ukuri: {
				roman ongera-ku-mpera: ['Ⅾ'].
				umubare kuramo: 500.
			}, hagarika-isubiramo.
		
			(umubare ≥ 100) ukuri: {
				roman ongera-ku-mpera: ['Ⅽ'].
				umubare kuramo: 100.
			}, hagarika-isubiramo.
		
			(umubare ≥ 50) ukuri: {
				roman ongera-ku-mpera: ['Ⅼ'].
				umubare kuramo: 50.
			}, hagarika-isubiramo.
		
			(umubare ≥ 50) ukuri: {
				roman ongera-ku-mpera: ['Ⅼ'].
				umubare kuramo: 50.
			}, hagarika-isubiramo.
		
			(umubare ≥ 10) ukuri: {
				roman ongera-ku-mpera: ['Ⅹ'].
				umubare kuramo: 10.
			}, hagarika-isubiramo.
			
			(umubare ≥ 9) ukuri: {
				roman ongera-ku-mpera: ['Ⅸ'].
				umubare kuramo: 9.
			}, hagarika-isubiramo.
			
			(umubare ≥ 5) ukuri: {
				roman ongera-ku-mpera: ['Ⅴ'].
				umubare kuramo: 5.
			}, hagarika-isubiramo.
			
			(umubare ≥ 4) ukuri: {
				roman ongera-ku-mpera: ['Ⅳ'].
				umubare kuramo: 4.
			}, hagarika-isubiramo.
			
			(umubare ≥ 1) ukuri: {
				roman ongera-ku-mpera: ['Ⅰ'].
				umubare kuramo: 1.
			}, hagarika-isubiramo.
		} uburyo-bukurikizwa.
	} igihe-cyose: { <- umubare > 0. }. <- roman.
}.

Ibisohoka andika: 1 roman, umurongo-mushya.
Ibisohoka andika: 2 roman, umurongo-mushya.
Ibisohoka andika: 4 roman, umurongo-mushya.
Ibisohoka andika: 8 roman, umurongo-mushya.
Ibisohoka andika: 16 roman, umurongo-mushya.
Ibisohoka andika: 32 roman, umurongo-mushya.
Ibisohoka andika: 64 roman, umurongo-mushya.
Ibisohoka andika: 128 roman, umurongo-mushya.
Ibisohoka andika: 256 roman, umurongo-mushya.
Ibisohoka andika: 1024 roman, umurongo-mushya.
