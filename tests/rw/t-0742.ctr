Ibisohoka andika: ['Test object'], umurongo-mushya.
>> a := Ikintu gishya. 

a bigeze: ['item:'] kora: { :hexhelper
	icyacyo hexhelper := hexhelper. 
}.

a bigeze: ['item'] kora: { <- icyacyo hexhelper.
}.

a item: Hx gishya.

>> old-hexhelper-address := a item icyitegererezo aderesi-yububiko.
a save-as: ['/tmp/a.bin'].
Ibisohoka andika: ['========== RELOADING SNAP:'], umurongo-mushya.

>> b := Ikintu load-from: ['/tmp/a.bin'].

(b item icyitegererezo aderesi-yububiko = old-hexhelper-address) ukuri: {
	Ibisohoka andika: ['Object link re-attached.'], umurongo-mushya.
}.
