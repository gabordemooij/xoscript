>> a := 3.
>> b := a koporora.
a kuramo: 1.
Ibisohoka andika: [' a = '] + a.
Ibisohoka andika: [' b = '] + b.
a := 3.
b := a + 4.
Ibisohoka andika: [' a = '] + a.
Ibisohoka andika: [' b = '] + b.
>> x := 3.
>> y := x koporora.
x ongeraho: 10.
y kuramo: 1.
Ibisohoka andika: [' x = '] + x.
Ibisohoka andika: [' y = '] + y.
>> q := Ikintu gishya.
q bigeze: ['setProperty:'] kora: { :x
	icyacyo prop := x.
}.
q bigeze: ['getProperty'] kora: { <- icyacyo prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Ibisohoka andika: [' p = '] + (p getProperty).
