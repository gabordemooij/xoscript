Server init.
Ibisohoka andika: ['Database date test'], umurongo-mushya.

>> db := Maria-DB gishya uwakira: ['localhost'],
	izina-ryukoresha: ['xo'], 
	ijambobanga: ['pass123'],
	izina-ryububikoshingiro: ['xobase'],
	ihuze.

>> ibipimo-byishakisha :=
db ikibazo: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
zana: { :row
	Ibisohoka andika: row datetest, umurongo-mushya.
}.
