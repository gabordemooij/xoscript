# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob gishya: 8, bytes: (
	Urutonde gishya ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Ibisohoka andika: ( utf16 kuramo-kode: ['utf16le'] ), umurongo-mushya.

utf16 rekura.
>> utf32 := Blob gishya: 13, bytes: (
	Urutonde gishya ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Ibisohoka andika: ( utf32 kuramo-kode: ['utf32be'] ), umurongo-mushya.
utf32 rekura.