Ibisohoka andika: ['Test object'], umurongo-mushya.
>> a := Ikintu gishya. 

a bigeze: ['state:'] kora: { :list
	icyacyo list := list. 
}.

a bigeze: ['state'] kora: {
	Ibisohoka andika: icyacyo list, umurongo-mushya.
}.

a state: ( Urutonde gishya ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
Ibisohoka andika: ['========== RELOADING SNAP:'], umurongo-mushya.
>> b := Ikintu load-from: ['/tmp/a.bin'].
b state.