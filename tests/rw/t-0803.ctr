Server init.

>> conn1 := Maria-DB gishya uwakira: ['localhost'],
	izina-ryukoresha: ['xo'],
	ijambobanga: ['pass123'],
	izina-ryububikoshingiro: ['xobase'],
	ihuze.

>> conn2 := Maria-DB gishya uwakira: ['localhost'],
	izina-ryukoresha: ['xo'],
	ijambobanga: ['pass123'],
	izina-ryububikoshingiro: ['xobase'],
	ihuze.
#...
>> del := conn1 ikibazo: ['DELETE FROM book WHERE id > 0'].
{  del shyira-mu-bikorwa. conn1 emeza. } fata-ikosa: { :e conn1 subiza-inyuma.  }, tangira.

>> insert := conn1 ikibazo: ['INSERT INTO book (id) VALUES(null)'].
insert shyira-mu-bikorwa.

>> umubare-wibintu := conn1 ikibazo: ['SELECT COUNT(*) AS num FROM book'].
umubare-wibintu zana: { :row Ibisohoka andika: row num, umurongo-mushya. }.

# does not show up
# insert not committed on connection 1
>> umubare-wibintu := conn2 ikibazo: ['SELECT COUNT(*) AS num FROM book'].
umubare-wibintu zana: { :row Ibisohoka andika: row num, umurongo-mushya. }.
