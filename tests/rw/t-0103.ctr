>> a := Urutonde ← Ikintu ; Ukuri ; Ikinyoma ; Buliyani ; 1 ; Umubare ; ['Str'] ; Inyandiko ; { ['Empty']. }.
Ibisohoka andika: (a umubare-wibintu), umurongo-mushya.
{ :i
	Ibisohoka andika: 
	['a '] + 
	((a ? i) ubwoko) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Ntacyo?) iki: [''] cyangwa-kiriya: ['NOT']) + 
	[' Nil.'],
	umurongo-mushya.
} × (a umubare-wibintu).
Ibisohoka andika: ['but.. Nil is.. '] + ((Ntacyo Ntacyo?) iki: ['certainly NIL!'] cyangwa-kiriya: ['not NIL??']), umurongo-mushya.