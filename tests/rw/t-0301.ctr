


>> wine := Ikintu gishya.


wine bigeze: ['toString'] kora: { <- ['merlot'].
}.

wine bigeze: ['naarTekst'] kora: { <- ['merlot'].
}.


wine bigeze: ['='] kora: { :other wine <- ( ubwacyo toString = other wine ).
}.

wine bigeze: ['=='] kora: { :other wine <- ( ubwacyo toString = other wine ).
}.



wine
	niba-ari: ['cabernet'] kora: { Ibisohoka andika: ['it's a Cabernet!']. },
	niba-ari: ['syrah']    kora: { Ibisohoka andika: ['it's a Syrah!'].    },
	niba-ari: ['merlot']   kora: { Ibisohoka andika: ['it's a Merlot!'].   },
	niba-ari: ['malbec']   kora: { Ibisohoka andika: ['it's a Malbec!'].   }.

Ibisohoka umurongo-mushya.
