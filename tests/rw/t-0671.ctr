# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Isanduku-yumutekano kora-imfunguzo.

# private (secret) key
>> sk := keys icya-mbere.

# public key
>> pk := keys icya-nyuma.

# sign a message
>> sig := Isanduku-yumutekano sinya: ['abc'] na: sk.

# check message (ok)
Ibisohoka andika: ( 
	Isanduku-yumutekano
		suzuma: ['abc'] 
		umukono: sig 
		na: pk 
), umurongo-mushya.

# check message (fail)
Ibisohoka andika: ( 
	Isanduku-yumutekano 
		suzuma: ['abd'] 
		umukono: sig 
		na: pk 
), umurongo-mushya.