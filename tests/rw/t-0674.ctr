# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> inzira-ya-dosiye := ['/tmp/dat.csv'].
>> csv := Dosiye gishya: inzira-ya-dosiye.
csv andika: s.

# accepts CRLF LF CR, varying row length
csv igitandukanya: [';'] akabago-kamagambo: ['"'] imirongo: { :line
	Gahunda sukura.
	Ibisohoka andika: line, umurongo-mushya.
	Gahunda sukura.
}.

# unequal lines
s ongera-ku-mpera: ['\njustone'].
csv andika: s.
{
	csv igitandukanya: [';'] akabago-kamagambo: ['"'] imirongo: { :line
		Ibisohoka andika: line, umurongo-mushya.
	}.
} fata-ikosa: { :e 
	Ibisohoka andika: e, umurongo-mushya.
}, tangira.

# invalid format
s := ['"he"llo";world'].
csv andika: s.
{
	csv igitandukanya: [';'] akabago-kamagambo: ['"'] imirongo: { :line
		Ibisohoka andika: line, umurongo-mushya.
	}.
} fata-ikosa: { :e 
	Ibisohoka andika: e, umurongo-mushya.
}, tangira.
