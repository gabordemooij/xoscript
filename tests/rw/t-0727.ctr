Server init.
>> f := Imiterere gishya: ['%d'].
>> a := Blob gishya: 4.
a bytes: ( Urutonde gishya ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob gishya: 4.
b bytes: ( Urutonde gishya ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a kuva: 0 uburebure: 3, buri: { :i :byte
	Ibisohoka andika: ( f shyira-kuri-umubare-wuzuye: byte ), umurongo-mushya.
}.
a ^ b.
a kuva: 0 uburebure: 3, buri: { :i :byte
	Ibisohoka andika: ( f shyira-kuri-umubare-wuzuye: byte ), umurongo-mushya.
}.
a ^ b.
a kuva: 0 uburebure: 3, buri: { :i :byte
	Ibisohoka andika: ( f shyira-kuri-umubare-wuzuye: byte ), umurongo-mushya.
}.
a rekura.
b rekura.

{ a ^ Ikintu. } fata-ikosa: { :e Ibisohoka andika: e, umurongo-mushya. }, tangira.
