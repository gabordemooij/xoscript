

Urutonde bigeze: ['sum'] kora: {
	>> total := 0.
	ubwacyo buri: { :index :element
		total ongeraho: element.
	}. <- total.
}.

Urutonde bigeze: ['product'] kora: {
	>> total := 1.
	ubwacyo buri: { :index :element
		total kuba-na: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Gahunda imicungire-yububiko: 0.

{

>> a := Urutonde ← ['hello'] ; ['world'] ; Ukuri ; Ntacyo ; 666.
a := a + ( Urutonde ← 1 ).
Ibisohoka andika: ( ['sum: '] + ( a sum ) ), umurongo-mushya.
Ibisohoka andika: ( ['min: '] + ( a gito-cyane ) ), umurongo-mushya.
Ibisohoka andika: ( ['max: '] + ( a kinini-cyane ) ), umurongo-mushya.
Ibisohoka andika: ( ['3rd: '] + ( a ? 2 ) ), umurongo-mushya.
Ibisohoka andika: ( ['prd: '] + ( a product ) ), umurongo-mushya.
a tondeka: { :a :b <- (b - a). }.
a buri: { :i :e Ibisohoka andika: ( i - 0 ), umurongo-mushya. }.

} tangira.

Gahunda sukura.
usedMemory1 := (Gahunda ububiko ? 0).


{

>> a := Urutonde ← ['hello'] ; ['world'] ; Ukuri ; Ntacyo ; 666.
a := a + ( Urutonde ← 1 ).
Ibisohoka andika: ( ['sum: '] + ( a sum ) ), umurongo-mushya.
Ibisohoka andika: ( ['min: '] + ( a gito-cyane ) ), umurongo-mushya.
Ibisohoka andika: ( ['max: '] + ( a kinini-cyane ) ), umurongo-mushya.
Ibisohoka andika: ( ['3rd: '] + ( a ? 2 ) ), umurongo-mushya.
Ibisohoka andika: ( ['prd: '] + ( a product ) ), umurongo-mushya.
a tondeka: { :a :b <- (b - a). }.
a buri: { :i :e Ibisohoka andika: ( i - 0 ), umurongo-mushya. }.

} tangira.



Gahunda sukura.
usedMemory2 := (Gahunda ububiko ? 0).


{

>> a := Urutonde ← ['hello'] ; ['world'] ; Ukuri ; Ntacyo ; 666.
a := a + ( Urutonde ← 1 ).
Ibisohoka andika: ( ['sum: '] + ( a sum ) ), umurongo-mushya.
Ibisohoka andika: ( ['min: '] + ( a gito-cyane ) ), umurongo-mushya.
Ibisohoka andika: ( ['max: '] + ( a kinini-cyane ) ), umurongo-mushya.
Ibisohoka andika: ( ['3rd: '] + ( a ? 2 ) ), umurongo-mushya.
Ibisohoka andika: ( ['prd: '] + ( a product ) ), umurongo-mushya.
a tondeka: { :a :b <- (b - a). }.
a buri: { :i :e Ibisohoka andika: ( i - 0 ), umurongo-mushya. }.

} tangira.



Gahunda sukura.
usedMemory3 := (Gahunda ububiko ? 0).

( usedMemory1 = usedMemory2 na: usedMemory1 = usedMemory3, na: usedMemory2 = usedMemory3 ) ukuri: {
	Ibisohoka andika: ['No memory leaks here'].
}, ikinyoma: {
	Ibisohoka andika: ['Leaking memory...'].
}.
