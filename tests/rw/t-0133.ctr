


>> Deck := Urutonde gishya.
Deck bigeze: ['print'] kora: {
        >> len := ubwacyo umubare-wibintu - 1.
        { :i
                >> len2 := ubwacyo umubare-wibintu - 1.
                Ibisohoka andika: ['len: '].
                Ibisohoka andika: len, umurongo-mushya.
                Ibisohoka andika: ['len2: '].
                Ibisohoka andika: len2, umurongo-mushya.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
