Ibisohoka andika: ['1,2,3,4,5,6,7,8,9,A,'], umurongo-mushya.
>> Scope := Ikintu gishya.
Scope bigeze: ['initialize:'] kora: { :x icyacyo property := x. }.
Scope bigeze: ['confirm'] kora: { Ibisohoka andika: [',']. }.
Scope bigeze: ['igerageza'] kora: {
	Ibisohoka andika: icyacyo property.
	ubwacyo confirm.
	( 1 = 1 ) ukuri: { Ibisohoka andika: icyacyo property. ubwacyo confirm. }.
	( 1 = 0 ) ikinyoma: { Ibisohoka andika: icyacyo property. ubwacyo confirm. }.
	>> y := 2. { Ibisohoka andika: icyacyo property. ubwacyo confirm. } igihe-cyose: { y kuramo: 1. <- (y > 0). }.
	{ Ibisohoka andika: icyacyo property. ubwacyo confirm. } × 1.
	(Urutonde ← 1) buri: {  Ibisohoka andika: icyacyo property. ubwacyo confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Inkoranyamagambo gishya one: ['item']) buri: { Ibisohoka andika: icyacyo property. ubwacyo confirm. }.
	{ 1 ÷ 0. } fata-ikosa: { Ibisohoka andika: icyacyo property. ubwacyo confirm. }, tangira.
	Ibisohoka umurongo-mushya.
}.
>> scope1 := Scope gishya.
scope1 initialize: ['X'].
scope1 igerageza.
>> function := { 
	icyacyo property := ['Y'].
	Ibisohoka andika: icyacyo property.
	ubwacyo confirm.
	( 1 = 1 ) ukuri: { Ibisohoka andika: icyacyo property. ubwacyo confirm. }.
	( 1 = 0 ) ikinyoma: { Ibisohoka andika: icyacyo property. ubwacyo confirm. }.
	>> y := 2. { Ibisohoka andika: icyacyo property. ubwacyo confirm. } igihe-cyose: { y kuramo: 1. <- (y > 0). }.
	{ Ibisohoka andika: icyacyo property. ubwacyo confirm. } × 1.
	(Urutonde ← 1) buri: {  Ibisohoka andika: icyacyo property. ubwacyo confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Inkoranyamagambo gishya one: ['item']) buri: { Ibisohoka andika: icyacyo property. ubwacyo confirm. }.
	{ 1 ÷ 0. } fata-ikosa: { Ibisohoka andika: icyacyo property. ubwacyo confirm. }, tangira.
	Ibisohoka umurongo-mushya.
}.
function bigeze: ['confirm'] kora: { Ibisohoka andika: [',']. }.
function shyira-kuri: 1 na: 2.
