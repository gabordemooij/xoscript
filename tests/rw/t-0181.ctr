

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Gahunda imicungire-yububiko: 0.

>> txt := ['World Salad'].
Ibisohoka andika: ['this text contains: '] + ( ( txt gabanya: [' '] ) umubare-wibintu ) + [' words.'], umurongo-mushya.
txt := txt kuva: 6 uburebure: 4.
Ibisohoka andika: txt, umurongo-mushya.

Gahunda sukura.

usedMemory1 := (Gahunda ububiko ? 0).


