>> echo := Ikintu gishya.
echo bigeze: ['subiza:'] kora: { :sound
	{ Ibisohoka andika: sound. } × 2.
}.
echo ho!. 


echo := Ikintu gishya.
echo bigeze: ['subiza:na:'] kora: { :sound :x
	{ Ibisohoka andika: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := Ikintu gishya.
echo bigeze: ['subiza:na:na:'] kora: { :operation :sound :x
	{ Ibisohoka andika: sound. } × x.
}.
echo shout: ['la'] times: 4. 


