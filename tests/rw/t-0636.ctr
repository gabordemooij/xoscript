# test url parsing

Server init.
>> url := URL inkomoko: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Ibisohoka andika: ['scheme = '] + url gahunda-ya-aderesi, umurongo-mushya.
Ibisohoka andika: ['host = '] + url uwakira, umurongo-mushya.
Ibisohoka andika: ['port = '] + url icyambu, umurongo-mushya.
Ibisohoka andika: ['path = '] + url inzira-ya-dosiye, umurongo-mushya.
Ibisohoka andika: ['query = '] + url ibipimo-byishakisha, umurongo-mushya.
Ibisohoka andika: ['fragment = '] + url igice, umurongo-mushya.
