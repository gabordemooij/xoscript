# catch-all test (practical)
>> HTML := Inyandiko gishya.
HTML bigeze: ['encode:'] kora: { :tekst
	ubwacyo ongera-ku-mpera: (tekst
	simbuza: ['&'] na: ['&amp;'], 
	simbuza: ['<'] na: ['&lt;'],
	simbuza: ['>'] na: ['&gt;'],
	simbuza: ['"'] na: ['&quot;']).
}.
>> blog := HTML gishya.
blog ongera-ku-mpera: ['<h1>'],
     encode: ['Koffie & Thee'],
     ongera-ku-mpera: ['</h1>'].
Ibisohoka andika: blog, umurongo-mushya.


>> Roman := Umubare gishya.
Roman bigeze: ['stringy'] kora: {
	>> a := [''].
	{ a ongera-ku-mpera: ['I']. } × ubwacyo. <- a.
}.

>> x := Roman gishya.
x ongeraho: 3.
Ibisohoka andika: x stringy, umurongo-mushya.

>> Quantum := Buliyani gishya.
Quantum bigeze: ['true?'] kora: { <- ['maybe True']. }.
Ibisohoka andika: (Quantum gishya true?), umurongo-mushya.

>> Nihil := Ntacyo gishya.
Nihil bigeze: ['inyandiko'] kora: { <- ['Nihil']. }.
Ibisohoka andika: (Nihil gishya), umurongo-mushya.
