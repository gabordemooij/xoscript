>> Point := Ikintu gishya.
Point bigeze: ['x-coordinate:'] kora: { :x icyacyo x := x. }.
Point bigeze: ['y-coordinate:'] kora: { :y icyacyo y := y. }.
Point bigeze: ['x-coordinate']  kora: { <- icyacyo x koporora. }.
Point bigeze: ['y-coordinate']  kora: { <- icyacyo y koporora. }.

Point bigeze: ['='] kora: { :other <- ( icyacyo x = other x-coordinate
		 na: icyacyo y = other y-coordinate ).
}.

>> pier := Point gishya x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point gishya x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point gishya x-coordinate: 5, y-coordinate: 6.

Ibisohoka andika: pier = town-hall, umurongo-mushya.
Ibisohoka andika: pier = restaurant, umurongo-mushya.
