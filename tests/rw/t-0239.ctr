Urutonde bigeze: ['sum'] kora: {
	>> total := 0.
	ubwacyo buri: { :index :element
		total ongeraho: element.
	}. <- total.
}.

>> a := Ukuri.



a bigeze: ['inyandiko'] kora: {
	>> answer := Ntacyo.
	( ubwacyo = Ukuri ) ukuri: {
		answer := ['Yep'].
	}, bitabaye-ibyo: {
		answer := ['Nope'].
	}. <- answer.
}.

a bigeze: ['umubare'] kora: {
	>> answer := Ntacyo.
	( ubwacyo = Ukuri ) ukuri: {
		answer := 10.
	}, bitabaye-ibyo: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b bigeze: ['inyandiko'] kora: { <- ['Devil'].
}.

b bigeze: ['buliyani'] kora: { <- Ikinyoma.
}.


Ibisohoka andika: a, umurongo-mushya.  
Ibisohoka andika: (90 + a), umurongo-mushya. 
Ibisohoka andika: b, umurongo-mushya. 
Ibisohoka andika: (Ukuri na: b), umurongo-mushya.

a := Urutonde ← ['hello'] ; ['world'] ; Ukuri ; Ntacyo ; 666. 
a := a + ( Urutonde ← 1 ).
Ibisohoka andika: a, umurongo-mushya.
Ibisohoka andika: ((Inkoranyamagambo gishya) shyira: Ntacyo kuri: Ntacyo), umurongo-mushya.
Ibisohoka andika: a sum, umurongo-mushya. 


{
	a bigeze: ['inyandiko'] kora: { <- Ntacyo. }.
	a := [''] + a.
} fata-ikosa: { :error
	Ibisohoka andika: ['Error noted: '] + error, umurongo-mushya.
}, tangira.



{
	a bigeze: ['umubare'] kora: { <- Ntacyo. }.
	a := 3 × a.
} fata-ikosa: { :error
	Ibisohoka andika: ['Error noted: '] + error, umurongo-mushya.
}, tangira.


{
	a bigeze: ['buliyani'] kora: { <- Ntacyo. }.
	a := Ukuri na: a. 
} fata-ikosa: { :error
	Ibisohoka andika: ['Error noted: '] + error, umurongo-mushya.
}, tangira.





{
	a bigeze: ['inyandiko'] kora: { <- Ikinyoma. }.
	a := [''] + a.
} fata-ikosa: { :error
	Ibisohoka andika: ['Error noted: '] + error, umurongo-mushya.
}, tangira.



{
	a bigeze: ['umubare'] kora: { <- Ukuri. }.
	a := 3 × a.
} fata-ikosa: { :error
	Ibisohoka andika: ['Error noted: '] + error, umurongo-mushya.
}, tangira.


{
	a bigeze: ['boolean'] kora: { <- 1. }.
	a := Ukuri na: a.
} fata-ikosa: { :error
	Ibisohoka andika: ['Error noted: '] + error, umurongo-mushya.
}, tangira.





