Ibisohoka andika: ['Test object'], umurongo-mushya.
>> a := Ikintu gishya. 

a bigeze: ['item:'] kora: { :moment
	icyacyo moment := moment. 
}.

a bigeze: ['item'] kora: { <- icyacyo moment.
}.

>> today := Urutonde gishya ; ( Akanya gishya agace-kigihe: ['CEST'], umwaka: 2026, ukwezi: 7 ).
a item: today.
Ibisohoka andika: a item ? 0, umurongo-mushya.
a save-as: ['/tmp/a.bin'].
