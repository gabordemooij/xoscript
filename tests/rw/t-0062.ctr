Buliyani bigeze: ['xor:'] kora: { :a :b <- ((a na: b ikinyuranyo) cyangwa: (a ikinyuranyo na: b)).
}.

>> o := Ikintu gishya.
o bigeze: ['hello'] kora: { ['Empty']. }.
{ o bigeze: 2 kora: 3.} fata-ikosa: { :e Ibisohoka andika: e, umurongo-mushya. }, tangira.
{ o bigeze: ['igerageza'] kora: 3.} fata-ikosa: { :e Ibisohoka andika: e, umurongo-mushya. }, tangira.
{ o bigeze: ['hello'] kora: { ['Empty']. }.} fata-ikosa: { :e Ibisohoka andika: e, umurongo-mushya. }, tangira. 
{ >> z := 4 ÷ 0. } fata-ikosa: { :e Ibisohoka andika: e, umurongo-mushya. }, tangira. 
{ (Ukuri na: Ntacyo) ukuri: { Ibisohoka andika: ['X'].}. } fata-ikosa: { :e Ibisohoka andika: e, umurongo-mushya. }, tangira. 
{ ([''] xor: 0) ukuri: { Ibisohoka andika: ['X'].}. } fata-ikosa: { :e Ibisohoka andika: e, umurongo-mushya. }, tangira. 
{ (1 < ['2']) ukuri: { Ibisohoka andika: ['OK']. }. } fata-ikosa: { :e Ibisohoka andika: e, umurongo-mushya. }, tangira. 
{ (1 < ['2.0']) ukuri: { Ibisohoka andika: ['OK']. }. } fata-ikosa: { :e Ibisohoka andika: e, umurongo-mushya. }, tangira. 
{ (1 < ['x2.0']) ukuri: { Ibisohoka andika: ['NO!']. }. } fata-ikosa: { :e Ibisohoka andika: e, umurongo-mushya. }, tangira. 
{ Ibisohoka andika: (['hello OK there'] kuva: ['6'] uburebure: ['2']). } tangira. 
