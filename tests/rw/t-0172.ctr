

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Gahunda imicungire-yububiko: 0.

>> a := Urutonde ← ['hello'] ; ['world'] ; Ukuri ; Ntacyo ; 666.
>> b := a kuva: 2 uburebure: 2.
Ibisohoka andika: ( b huza: ['|'] ), andika: b umubare-wibintu.

Gahunda sukura.
usedMemory1 := (Gahunda ububiko ? 0).


a := Urutonde ← ['hello'] ; ['world'] ; Ukuri ; Ntacyo ; 666.
b := a kuva: 2 uburebure: 2.
Ibisohoka andika: ( b huza: ['|'] ), andika: b umubare-wibintu.


