

Urutonde bigeze: ['fixture:'] kora: { :f
	icyacyo fixture := f.
}.

Urutonde bigeze: ['umubare-wibintu'] kora: { <- icyacyo fixture.
}.

Urutonde bigeze: ['aantal'] kora: { <- icyacyo fixture.
}.


>> x := Ntacyo.
{

	x := ['hello'] 
	simbuza:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] inyuguti: 2)
			)
		)
	na: (
		(['...hal'] + ['lo']) 
			inyuguti-nkuru 
			lowecase 
			inyuguti-nkuru 
			simbuka: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Urutonde ← 0 ; 1 ; 4; 9 ; (Urutonde ← 0 ; 3; 1) ; 4
							) ikibanziriza-icya-nyuma
						) ? 1
					) + 
					((Urutonde ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					umubare-wibintu
				)
			)
	).

} × 10.
Ibisohoka andika: x, umurongo-mushya.

