Urutonde bigeze: ['koporora'] kora: {
	>> koporora := Urutonde gishya.
	ubwacyo buri: { :umubare :section
		koporora ongera-ku-mpera: section kwihamagara koporora.
	}. <- koporora.
}.

>> sheep := Urutonde gishya ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep koporora.
clones buri: { :umubare :sheep
	sheep ongera-ku-mpera: ['2'].
}.

Ibisohoka andika: sheep, umurongo-mushya.
Ibisohoka andika: clones, umurongo-mushya.
