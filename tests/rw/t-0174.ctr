


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Gahunda imicungire-yububiko: 0.
>> palette := Ntacyo.
>> colors := Ntacyo.

{
palette := Inkoranyamagambo gishya.
palette 
	shyira: ['#F00'] kuri: ['red'],
	shyira: ['#0F0'] kuri: ['green'],
	shyira: ['#00F'] kuri: ['blue'].
Ibisohoka andika: ['number of RGB codes in palette: '] + ( palette umubare-wibintu ), umurongo-mushya.
Ibisohoka andika: ['RGB code of green is: '] + ( palette ? ['green'] ), umurongo-mushya.
colors := [''].
( palette buri: { :izina :kode
		colors := colors + ( izina + [':'] + kode ).
} ).
Ibisohoka andika: ['All colors in palette: '] + colors, umurongo-mushya.
} tangira.
Gahunda sukura.
usedMemory1 := (Gahunda ububiko ? 0).

{
palette := Inkoranyamagambo gishya.
palette 
	shyira: ['#F00'] kuri: ['red'],
	shyira: ['#0F0'] kuri: ['green'],
	shyira: ['#00F'] kuri: ['blue'].
Ibisohoka andika: ['number of RGB codes in palette: '] + ( palette umubare-wibintu ), umurongo-mushya.
Ibisohoka andika: ['RGB code of green is: '] + ( palette ? ['green'] ), umurongo-mushya.
colors := [''].
( palette buri: { :izina :kode
		colors := colors + ( izina + [':'] + kode ).
} ).
Ibisohoka andika: ['All colors in palette: '] + colors, umurongo-mushya.
} tangira.
Gahunda sukura.
usedMemory2 := (Gahunda ububiko ? 0).

{
palette := Inkoranyamagambo gishya.
palette 
	shyira: ['#F00'] kuri: ['red'],
	shyira: ['#0F0'] kuri: ['green'],
	shyira: ['#00F'] kuri: ['blue'].
Ibisohoka andika: ['number of RGB codes in palette: '] + ( palette umubare-wibintu ), umurongo-mushya.
Ibisohoka andika: ['RGB code of green is: '] + ( palette ? ['green'] ), umurongo-mushya.
colors := [''].
( palette buri: { :izina :kode
		colors := colors + ( izina + [':'] + kode ).
} ).
Ibisohoka andika: ['All colors in palette: '] + colors, umurongo-mushya.
} tangira.
Gahunda sukura.
usedMemory3 := (Gahunda ububiko ? 0).



( usedMemory1 = usedMemory2 na: usedMemory1 = usedMemory3, na: usedMemory2 = usedMemory3 ) ukuri: {
	Ibisohoka andika: ['No memory leaks here'].
}, ikinyoma: {
	Ibisohoka andika: ['Leaking memory...'].
}.
