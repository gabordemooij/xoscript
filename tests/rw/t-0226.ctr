# Test ASCII variants

# Numbers

Ibisohoka andika: (2 !=: 3), umurongo-mushya.
Ibisohoka andika: (2 <=: 2), umurongo-mushya.
Ibisohoka andika: (2 >=: 2), umurongo-mushya.

# Strings

Ibisohoka andika: (['b'] >=: ['a']), umurongo-mushya.
Ibisohoka andika: (['b'] !=: ['a']), umurongo-mushya.
Ibisohoka andika: (['b'] <=: ['c']), umurongo-mushya.

# Bools

Ibisohoka andika: (Ukuri !=: Ikinyoma), umurongo-mushya.

# Objects

Ibisohoka andika: (Ikintu gishya !=: Ikintu gishya), umurongo-mushya.

# ASCII list symbol <-:

Ibisohoka andika: (Urutonde <<: 1, ; 2 ; 3) umubare-wibintu = 3, umurongo-mushya.

