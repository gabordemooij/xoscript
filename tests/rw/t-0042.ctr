>> items := Inkoranyamagambo gishya.
items shyira: ['black'] kuri: ['coffee'], shyira: ['earl grey'] kuri: ['tea'].
Ibisohoka andika: (items ahantu: ['coffee']), andika: (items ahantu: ['tea']).
Ibisohoka andika: ['there are'] + items umubare-wibintu + [' items in the array.'].
items shyira: ['capuccino'] kuri: ['coffee'].
Ibisohoka andika: ['Now my coffee is.. '] + (items ahantu: ['coffee']).
items shyira: ['aaa'] kuri: ['1'].
items shyira: ['bbb'] kuri: ['2'].
Ibisohoka andika: (items ahantu: ['a']).
