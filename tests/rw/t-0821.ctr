# a quote that never closes must give an error, not an endless loop
>> inzira-ya-dosiye := ['/tmp/test0821.csv'].
>> file := Dosiye gishya: inzira-ya-dosiye.

file andika: ['a,b\n"1,2\n'].
{
	file igitandukanya: [','] akabago-kamagambo: ['"'] imirongo: { :line
		Ibisohoka andika: line, umurongo-mushya.
	}.
} fata-ikosa: { :e Ibisohoka andika: e, umurongo-mushya. }, tangira.

# a closed quote still works
file andika: ['a,b\n"1,2",3'].
file igitandukanya: [','] akabago-kamagambo: ['"'] imirongo: { :line
	Ibisohoka andika: line, umurongo-mushya.
}.
file siba.
