a := a + (2 ipuwasanse: -1). 
a := a + (49 umuzi-kare).   
a addNum: ((Urutonde ← 0 ; 1) kinini-cyane).          
a addNum: ((Urutonde ← 2 ; 3) gito-cyane).
Ibisohoka andika: a.

Gahunda sukura.
usedMemory2 := (Gahunda ububiko ? 0).


