

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Gahunda imicungire-yububiko: 0.

Umubare bigeze: ['addNum:'] kora: { :x
	ubwacyo ongeraho: x.
}.

Umubare bigeze: ['subtractNum:'] kora: { :x
	ubwacyo kuramo: x.
}.

Umubare bigeze: ['multiplyBy:'] kora: { :x
	ubwacyo kuba-na: x.
}.

Umubare bigeze: ['divideBy:'] kora: { :x
	ubwacyo gabanya-na: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 ipuwasanse: 8).  
a := a + (2 ipuwasanse: -1). 
a := a + (49 umuzi-kare).   
a addNum: ((Urutonde ← 0 ; 1) kinini-cyane).          
a addNum: ((Urutonde ← 2 ; 3) gito-cyane).
Ibisohoka andika: a.

Gahunda sukura.

usedMemory1 := (Gahunda ububiko ? 0).


