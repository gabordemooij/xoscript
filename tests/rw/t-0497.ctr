Server init.

# write a test file
>> f := Dosiye gishya: ['/tmp/test.gif'].
f andika: ['GIF87a01234567810'].

# serve the file
Server hererekanya: ['test.gif'] imbanziriza: ['/tmp/'].

Ibisohoka umurongo-mushya.

Ibisohoka andika: ['Outside container (security):'], umurongo-mushya.
{ Server hererekanya: ['../passwd'] imbanziriza: ['/tmp/']. }
fata-ikosa: { :e Ibisohoka andika: e, umurongo-mushya. },
tangira.

Ibisohoka andika: ['Invalid prefix:'], umurongo-mushya.
{ Server hererekanya: ['test.gif'] imbanziriza: ['z:\\']. }
fata-ikosa: { :e Ibisohoka andika: e, umurongo-mushya. },
tangira.

Ibisohoka andika: ['Non-existant file:'], umurongo-mushya.
{ Server hererekanya: ['xxx.xxx'] imbanziriza: ['/tmp/']. }
fata-ikosa: { :e Ibisohoka andika: e, umurongo-mushya. },
tangira.
