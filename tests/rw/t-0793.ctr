Server init.

>> DB := Maria-DB gishya uwakira: ['localhost'],
	izina-ryukoresha: ['xo'],
	ijambobanga: ['pass123'],
	izina-ryububikoshingiro: ['xobase'],
	ihuze.

{
	DB ikibazo:
	['DROP TABLE movies'],
	shyira-mu-bikorwa.
} fata-ikosa: { Ntacyo. }, tangira.

DB ikibazo:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
shyira-mu-bikorwa.

DB ikibazo: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
ibipimo: ( Urutonde gishya ; ['Halloween'] ),
shyira-mu-bikorwa.

DB ikibazo: ['SELECT * FROM movies'],
zana: { :movie
	Ibisohoka andika: movie title, umurongo-mushya.
}.

