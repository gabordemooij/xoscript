Server init.

>> x := Blob gishya: 65 ubwoko: ['char'].
# for this test you need set a path to libc (puts)
>> libname := Gahunda igenamiterere: ['FFITESTLIB'].
Server hambira: (
 Urutonde gishya ;
 libname ;
 ['putchar'] ;
 ( Urutonde gishya ; ['char'] ) ;
 ['void'] ;
 ['Print'] ;
 ['char:']
).
Print char: (x kuva: 0 uburebure: 1), umurongo-mushya.
x rekura.

