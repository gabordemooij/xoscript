

>> obj := Ikintu gishya.

obj bigeze: ['greet'] kora: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj bigeze: ['task'] kora: {
	icyacyo property := 123.
	{
		# try binds self/own to object instead of block
		Ibisohoka andika: ubwacyo greet.
		Ibisohoka andika: icyacyo property.
		1 / 0.
	} fata-ikosa: {
		Ibisohoka andika: ubwacyo greet.
		Ibisohoka andika: icyacyo property.
		Ibisohoka andika: ['ok'].
	}, gerageza.
}.

obj task.