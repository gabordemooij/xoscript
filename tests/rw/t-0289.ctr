#Linux
>> OS := Gahunda sisitemu: (Itegeko uname -s), kata-imyanya.

>> Slurp := Ikintu gishya.
Slurp bigeze: ['gishya'] kora: {
	icyacyo str := [''].
}.
Slurp bigeze: ['subiza:'] kora: { :blah
		(icyacyo str ≠ ['']) ukuri: {
			icyacyo str ongera-ku-mpera: [' '].
		}.
		icyacyo str ongera-ku-mpera: blah.
}.
Slurp bigeze: ['subiza:na:'] kora: { :blah :blahah
		(icyacyo str ≠ ['']) ukuri: {
			icyacyo str ongera-ku-mpera: [' '].
		}.
		(blah uburebure > 1) ukuri: {
			icyacyo str ongera-ku-mpera: (blah kuva: 0 uburebure: (blah uburebure - 1)).
		}, bitabaye-ibyo: {
			icyacyo str ongera-ku-mpera: blah.
		}.
		icyacyo str ongera-ku-mpera: [' '].
		icyacyo str ongera-ku-mpera: blahah.
}.
Slurp bigeze: ['obtain'] kora: {
	>> buffer := icyacyo str.
	icyacyo str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text ongera-ku-mpera: ['hello'].
} × 1000.


Ibisohoka andika: (
	Gahunda sisitemu: (
		Slurp gishya
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

