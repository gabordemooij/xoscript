Gahunda imicungire-yububiko: 0.
Urutonde bigeze: ['sum'] kora: {
	>> total := 0.
	ubwacyo buri: { :index :element
		total ongeraho: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Dosiye gishya: ['/tmp/test.txt'].
f andika: ['Lorem Ipsum'].
f funga-ihuza.
  

f := Dosiye gishya: ['/tmp/test.txt'].
>> text := f soma.
f funga-ihuza.



Gahunda sukura.
usedMemory1 := (Gahunda ububiko ? 1).



f := Dosiye gishya: ['/tmp/test.txt'].
text := f soma.
f funga-ihuza.

Gahunda sukura.
usedMemory2 := (Gahunda ububiko ? 1).


f := Dosiye gishya: ['/tmp/test.txt'].
text := f soma.
f funga-ihuza.

Gahunda sukura.
usedMemory3 := (Gahunda ububiko ? 1).



( usedMemory1 = usedMemory2 na: usedMemory1 = usedMemory3, na: usedMemory2 = usedMemory3 ) ukuri: {
	Ibisohoka andika: ['No memory leaks here'].
}, ikinyoma: {
	Ibisohoka andika: ['Leaking memory...'].
}.
