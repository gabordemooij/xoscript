>> map1 := Inkoranyamagambo gishya.
>> key1 := Urutonde gishya.
>> key2 := Urutonde gishya.

map1
	shyira: ['hello'] kuri: key1,
	shyira: ['world'] kuri: key2.


Ibisohoka
	andika: ['Map #1 contains: '] + (map1 ahantu: key1),
	andika: [' and '] + (map1 ahantu: key2), umurongo-mushya.

>> KeyeableArray := Urutonde gishya.
KeyeableArray bigeze: ['toString'] kora: { <- (ubwacyo umubare-wibintu) toString.
}.

>> map2 := Inkoranyamagambo gishya.
key1 := KeyeableArray gishya.
key2 := KeyeableArray gishya.

key1 ongera-ku-mpera: 1.

map2
	shyira: ['hello'] kuri: key1,
	shyira: ['world'] kuri: key2.

Ibisohoka
	andika: ['Map #2 contains: '] + (map2 ahantu: key1),
	andika: [' and '] + (map2 ahantu: key2), umurongo-mushya.
