>> randomizer := { :a :b
	>> gito-cyane := ( a < b ) iki: a cyangwa-kiriya: b.
	>> kinini-cyane := ( a > b ) iki: a cyangwa-kiriya: b.
	>> x := Ntacyo.
	{
		x := Umubare hagati: a na: b.
		((x < gito-cyane) cyangwa: (x > kinini-cyane)) ukuri: { 
			Ibisohoka andika: (['Invalid value!']).
			Gahunda soza.
		}.
	} 
	× 100. <- x.
}.
randomizer shyira-kuri: 0 na: 0.
randomizer shyira-kuri: 1 na: 0.
