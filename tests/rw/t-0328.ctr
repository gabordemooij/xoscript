Gahunda imicungire-yububiko: 4.

>> Doubler := Ikintu gishya.
>> Multiplier := Ikintu gishya.
Doubler bigeze: ['double:and:'] kora: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier bigeze: ['multiply:and:'] kora: { :x :y <- (x × y).
}.

Ibisohoka andika: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), umurongo-mushya.
