



>> CoffeeGrounds := Ikintu gishya.
CoffeeGrounds bigeze: ['extract'] kora: { <- ['coffee']. }.

>> CoffeeMachine := Ikintu gishya.
CoffeeMachine bigeze: ['init'] kora: {
	icyacyo coffeegrounds := CoffeeGrounds gishya.
}.
CoffeeMachine bigeze: ['gishya'] kora: { <- CoffeeMachine `new init.
}.

CoffeeMachine bigeze: ['makeTea'] kora: { <- (icyacyo tealeaves extract). }.
CoffeeMachine bigeze: ['makeCoffee'] kora: { <- (icyacyo coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine gishya.

Ibisohoka andika:
	coffeeDream 
	makeCoffee.

Ibisohoka andika:
	coffeeDream 
	makeTea.
