#Linux
>> clock := Akanya gishya.
clock agace-kigihe: ['UTC-1'].
clock umwaka: 1981, ukwezi: 1, umunsi: 5,
      isaha: 13, umunota: 15, isegonda: 13.

Ibisohoka andika: clock, umurongo-mushya.
clock agace-kigihe: ['UTC+0'].

Ibisohoka andika: (
	(clock umwaka byoroshye) + ['-'] + (clock ukwezi) + ['-'] + (clock umunsi) + [' '] +
	(clock isaha) + [':'] + (clock umunota) + [':'] + (clock isegonda) + [' '] +
	['W'] + (clock icyumweru) + (clock agace-kigihe)
), umurongo-mushya.


clock agace-kigihe: ['UTC-1'].
Ibisohoka andika: (
	(clock umwaka byoroshye) + ['-'] + (clock ukwezi) + ['-'] + (clock umunsi) + [' '] +
	(clock isaha) + [':'] + (clock umunota) + [':'] + (clock isegonda) + [' '] +
	['W'] + (clock icyumweru) + (clock agace-kigihe)
), umurongo-mushya.
