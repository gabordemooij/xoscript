Ibisohoka andika: ['Test object'], umurongo-mushya.
>> greeter := Ikintu gishya.
greeter bigeze: ['name:'] kora: { :izina
	icyacyo xname := izina. 
}.
greeter bigeze: ['greet'] kora: {
	Ibisohoka andika: ['Hello '] + icyacyo xname, umurongo-mushya.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Ibisohoka andika: ['========== RELOADING SNAP:'], umurongo-mushya.
>> b := Ikintu load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
