Server init.

# returning non-str from match/do should be ok
>> subject := ['abc'].
>> pattern := Icyitegererezo-cyishakisha gishya: ['([ac])'].
>> result := pattern guhura: subject kora: { :m :x
	Ibisohoka andika: m, umurongo-mushya.
	Ibisohoka andika: x, umurongo-mushya. <- Ntacyo.
}.
Ibisohoka andika: result, umurongo-mushya.