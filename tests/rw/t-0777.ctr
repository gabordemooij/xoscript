#OBSD
>> dirname := [''].
{ dirname ongera-ku-mpera: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Gahunda sisitemu: command.
Gahunda chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename ongera-ku-mpera: ['YYYYYYYY']. } * 20.
Dosiye gishya: filename, andika: ['sometext'].
{ Dosiye urutonde: ['/tmp/'] + dirname. } * 1000.
Ibisohoka andika: ['no crash'], umurongo-mushya.

