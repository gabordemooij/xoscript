
Gahunda imicungire-yububiko: 4.

>> Animal := Ikintu gishya.
Animal bigeze: ['make'] kora: {
	>> animal := Ikintu gishya.
	animal bigeze: ['makeSound'] kora: {
		Ibisohoka andika: icyacyo sound.
	}. <- animal.
}.
>> Cat := Ikintu gishya.
Cat bigeze: ['make'] kora: {
	>> cat := Animal make.
	cat bigeze: ['init'] kora: {
		icyacyo sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
