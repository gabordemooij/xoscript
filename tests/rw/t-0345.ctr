# test catch-all methods
>> x13 := Ikintu gishya.
x13 bigeze: ['a'] kora: { :a Ibisohoka andika: 0, umurongo-mushya. }.
x13 bigeze: ['a:'] kora: { :a Ibisohoka andika: a, umurongo-mushya. <- 5. }.
x13 bigeze: ['a:b:'] kora: { :a :b Ibisohoka andika: (a + b), umurongo-mushya. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
