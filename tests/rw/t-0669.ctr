# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Isanduku-yumutekano 
	hash-yijambobanga: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Isanduku-yumutekano 
	hash-yijambobanga: hash genzura: a1.
	# fail 
>> b := Isanduku-yumutekano
	hash-yijambobanga: hash genzura: a2.
	# ok!

Ibisohoka andika: a, umurongo-mushya.
Ibisohoka andika: b, umurongo-mushya.

