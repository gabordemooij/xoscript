>> To-Do := Ikintu gishya.

To-Do bigeze: ['gishya'] kora: {
	icyacyo list := Urutonde gishya.
}.

To-Do bigeze: ['nieuw'] kora: {
	icyacyo list := Urutonde gishya.
}.

To-Do bigeze: ['+'] kora: { :task
	icyacyo list ongera-ku-mpera: task.
}.

To-Do bigeze: ['number of tasks?'] kora: { <-  icyacyo list umubare-wibintu.
}.

>> todos := 
	To-Do gishya 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Ibisohoka andika: ['You have $ tasks to do'] $ todos number of tasks?.
