>> q := Urutonde ← 1 ; 2 ; 3.
{ q ? ['1']. } fata-ikosa: { Ibisohoka andika: ['caught!'], umurongo-mushya. }, tangira.
{ q ? Ukuri. } fata-ikosa: { Ibisohoka andika: ['caught!'], umurongo-mushya. }, tangira.
{ q ? Ikinyoma. } fata-ikosa: { Ibisohoka andika: ['caught!'], umurongo-mushya. }, tangira.
{ q ? Ntacyo. } fata-ikosa: { Ibisohoka andika: ['caught!'], umurongo-mushya. }, tangira.
{ q ? (Urutonde gishya). } fata-ikosa: { Ibisohoka andika: ['caught!'], umurongo-mushya. }, tangira.
{ q ? (Ikintu gishya). } fata-ikosa: { Ibisohoka andika: ['caught!'], umurongo-mushya. }, tangira.
{ q ? ({ ['Empty']. }). } fata-ikosa: { Ibisohoka andika: ['caught!'], umurongo-mushya. }, tangira.
Ibisohoka andika: ['caught them all'], umurongo-mushya.
