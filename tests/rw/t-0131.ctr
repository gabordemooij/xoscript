
>> a := Urutonde ← (Urutonde ← 100 ; 200 ; 300) ; (Urutonde ← 9 ; 8 ; 7).
Ibisohoka andika: ['at 0,1 :'].
Ibisohoka andika: a ? 0 ? 1, umurongo-mushya. 
Ibisohoka andika: ['at 1,2 :'].
Ibisohoka andika: a ? 1 ? 2, umurongo-mushya. 
>> menu := Inkoranyamagambo gishya.
menu shyira: (Urutonde ← ['pizza'] ; ['spaghetti']) kuri: ['Italian Cuisine'].
menu shyira: (Urutonde ← ['bifteki'] ; ['suflaki']) kuri: ['Greek Cuisine'].
Ibisohoka andika: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), umurongo-mushya. 
Ibisohoka andika: ['but not on the same plate.'], umurongo-mushya.
