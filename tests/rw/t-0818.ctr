# edge cases from a request must give an error or a result, not a crash
Server init.

Ibisohoka andika: ['<'] + (['abc'] kuva: 0 uburebure: 0, inyuguti-nkuru) + ['>'], umurongo-mushya.
Ibisohoka andika: ['<'] + (['abc'] kuva: 0 uburebure: 0, inyuguti-nto) + ['>'], umurongo-mushya.
Ibisohoka andika: ['<'] + (['abc'] simbuka: 3, inyuguti-nkuru) + ['>'], umurongo-mushya.
Ibisohoka andika: [''] inyuguti-nkuru bytes, umurongo-mushya.
Ibisohoka andika: ['aB'] inyuguti-nkuru, umurongo-mushya.
Ibisohoka andika: ['aB'] inyuguti-nto, umurongo-mushya.

Ibisohoka andika: (Akanya gishya: 0) umwaka, umurongo-mushya.
{ Akanya gishya: ['9e300'] umubare. } fata-ikosa: { :e Ibisohoka andika: e, umurongo-mushya. }, tangira.
{ Akanya gishya: ['-9e300'] umubare. } fata-ikosa: { :e Ibisohoka andika: e, umurongo-mushya. }, tangira.
{ Akanya gishya: ['nan'] umubare. } fata-ikosa: { :e Ibisohoka andika: e, umurongo-mushya. }, tangira.
{ Akanya gishya: 9000000000000000000. } fata-ikosa: { :e Ibisohoka andika: e, umurongo-mushya. }, tangira.
