
>> countries := Urutonde gishya
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Urutonde gishya
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods hakurikijwe: countries, buri: { :key :value
	counter ongeraho: 1.
}.

Ibisohoka andika: (['we serve counter dishes'] counter: counter), umurongo-mushya.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] inyuguti-zose tondeka: { :v
	counter ongeraho: 0.
}.

Ibisohoka andika: (['we sort counter dishes'] counter: counter), umurongo-mushya.


>> counter := 0.
{
	{
		counter ongeraho: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Ibisohoka andika: (['we calculate counter numbers.'] counter: counter), umurongo-mushya.

