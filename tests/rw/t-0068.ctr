>> w := ['A_bottle_of_Whisky and a rare steak.'].
Ibisohoka andika: ['=== Basic test, grab the bottle! ==='], umurongo-mushya.
Ibisohoka andika: ['>']+(w koporora kuva:2 uburebure: 6), umurongo-mushya.
Ibisohoka andika: ['>']+(w koporora kuva:8 uburebure: -6), umurongo-mushya.
Ibisohoka andika: ['>']+(w koporora kuva:2 uburebure: 6), umurongo-mushya.
Ibisohoka andika: ['>']+(w koporora kuva:8 uburebure: -6), umurongo-mushya.
Ibisohoka andika: ['=== Take a single char ==='], umurongo-mushya.
Ibisohoka andika: ['>']+(w koporora kuva:7 uburebure: 1), umurongo-mushya.
Ibisohoka andika: ['>']+(w koporora kuva:7 uburebure: 1), umurongo-mushya.
Ibisohoka andika: ['=== The 0 case, empty string ==='], umurongo-mushya.
Ibisohoka andika: ['>']+(w koporora kuva:7 uburebure: 0), umurongo-mushya.
Ibisohoka andika: ['>']+(w koporora kuva:7 uburebure: 0), umurongo-mushya.
Ibisohoka andika: ['=== Edge case, first character only ==='], umurongo-mushya.
Ibisohoka andika: ['>']+(w koporora kuva:0 uburebure: 1), umurongo-mushya.
Ibisohoka andika: ['>']+(w koporora kuva:0 uburebure: 1), umurongo-mushya.
Ibisohoka andika: ['>']+(w koporora kuva:1 uburebure: -1), umurongo-mushya.
Ibisohoka andika: ['>']+(w koporora kuva:1 uburebure: -1), umurongo-mushya.
Ibisohoka andika: ['=== Edge case, last character only ==='], umurongo-mushya.
Ibisohoka andika: ['>']+(w koporora kuva:35 uburebure: 1), umurongo-mushya.
Ibisohoka andika: ['>']+(w koporora kuva:35 uburebure: 1), umurongo-mushya.
Ibisohoka andika: ['>']+(w koporora kuva:36 uburebure: -1), umurongo-mushya.
Ibisohoka andika: ['>']+(w koporora kuva:36 uburebure: -1), umurongo-mushya.
Ibisohoka andika: ['=== Out of bounds, empty string ==='], umurongo-mushya.
Ibisohoka andika: ['>']+(w koporora kuva:36 uburebure: 37), umurongo-mushya.
Ibisohoka andika: ['>']+(w koporora kuva:36 uburebure: 47), umurongo-mushya.
Ibisohoka andika: ['>']+(w koporora kuva:-1 uburebure: -2), umurongo-mushya.
Ibisohoka andika: ['>']+(w koporora kuva:-2 uburebure: -1), umurongo-mushya.
Ibisohoka andika: ['=== Part out of bounds, full string ==='], umurongo-mushya.
Ibisohoka andika: ['>']+(w koporora kuva:-20 uburebure: 90), umurongo-mushya.
Ibisohoka andika: ['>']+(w koporora kuva:90 uburebure: -20), umurongo-mushya.
Ibisohoka andika: ['>']+(w koporora kuva:-20 uburebure: 90), umurongo-mushya.
