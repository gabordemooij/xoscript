Ibisohoka andika: ['Test object'], umurongo-mushya.
>> cmd := Itegeko gishya.
Ibisohoka andika: cmd ls /tmp, umurongo-mushya.
>> old-cmd-address := cmd icyitegererezo aderesi-yububiko.
cmd save-as: ['/tmp/a.bin'].
Ibisohoka andika: ['========== RELOADING SNAP:'], umurongo-mushya.
>> b := Ikintu load-from: ['/tmp/a.bin'].
(b icyitegererezo aderesi-yububiko = old-cmd-address) ukuri: {
	Ibisohoka andika: ['Object link re-attached.'], umurongo-mushya.
}.
Ibisohoka andika: b ls, umurongo-mushya.


