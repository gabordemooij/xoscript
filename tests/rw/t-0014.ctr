>> Greeter := Ikintu gishya.
Greeter bigeze: ['make'] kora: {
	>> gr := Ikintu gishya.
	gr bigeze: ['setName:'] kora: { :aname
		icyacyo izina := aname.
	}.
	gr bigeze: ['greet'] kora: {
		Ibisohoka andika: icyacyo izina.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a gishya.
c setName: ['THREE'].
c greet.
>> d := a gishya.
d setName: ['FOUR'].
d greet.
c greet.
