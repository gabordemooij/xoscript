

Urutonde bigeze: ['column:'] kora: { :column
	>> result := Urutonde gishya.
	ubwacyo buri: { :index :row
		row buri: { :index :cell
			(index = column) ukuri: { result ongera-ku-mpera: cell. }.
		}.
	}. <- result.
}.


>> a := Urutonde ←
	(Urutonde ← 1 ; 2 ; 3) ;
	(Urutonde ← 4 ; 5 ; 6) ;
	(Urutonde ← 7 ; 8 ; 9).

>> b := a column: 1.
Ibisohoka andika: b, umurongo-mushya.

b := a column: 20.
Ibisohoka andika: b, umurongo-mushya.

b := a column: -100.
Ibisohoka andika: b, umurongo-mushya.
