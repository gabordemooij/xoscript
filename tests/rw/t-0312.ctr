>> Slurp := Ikintu gishya.
Slurp bigeze: ['gishya'] kora: {
	icyacyo str := [''].
}.
Slurp iga: ['nieuw'] bisobanura: ['gishya'].
Slurp bigeze: ['subiza:'] kora: { :blah
		(icyacyo str ≠ ['']) ukuri: {
			icyacyo str ongera-ku-mpera: [' '].
		}.
		icyacyo str ongera-ku-mpera: blah.
}.
Slurp bigeze: ['subiza:na:'] kora: { :blah :blahah
		(icyacyo str ≠ ['']) ukuri: {
			icyacyo str ongera-ku-mpera: [' '].
		}.
		(blah uburebure > 1) ukuri: {
			icyacyo str ongera-ku-mpera: (blah kuva: 0 uburebure: (blah uburebure - 1)).
		}, bitabaye-ibyo: {
			icyacyo str ongera-ku-mpera: blah.
		}.
		icyacyo str ongera-ku-mpera: [' '].
		icyacyo str ongera-ku-mpera: blahah.
}.
Slurp bigeze: ['obtain'] kora: {
	>> buffer := icyacyo str.
	icyacyo str := ['']. <- buffer.
}.


>> ibipimo-byishakisha := Slurp gishya
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

Ibisohoka andika: ibipimo-byishakisha obtain, umurongo-mushya.
