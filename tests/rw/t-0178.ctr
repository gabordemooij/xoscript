

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Gahunda imicungire-yububiko: 0.

>> txt := ['Word Salad'].
Ibisohoka andika: ['last index of ord = '] + (( txt umwanya-wa-nyuma: ['ord'] ) - 0), umurongo-mushya.
Ibisohoka andika: ['index of ord = '] + (( txt shaka: ['ord'] ) - 0), umurongo-mushya.
Ibisohoka andika: ['index of ad = '] + (( txt shaka: ['ad'] ) - 0), umurongo-mushya.
Ibisohoka andika: ['last index of W = '] + (( txt umwanya-wa-nyuma: ['W'] ) - 0), umurongo-mushya.
Ibisohoka andika: ['last index of d = '] + (( txt umwanya-wa-nyuma: ['d'] ) - 0), umurongo-mushya.
Ibisohoka andika: ['txt equals Word Salad = '] + ( txt = ['Word Salad'] ), umurongo-mushya.
Ibisohoka andika: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), umurongo-mushya.
Ibisohoka andika: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), umurongo-mushya.
Ibisohoka andika: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), umurongo-mushya.

