# test buffers PKI/Sign 
Server init.

>> long := ( Urutonde gishya uzuza: 1000 na: ['a'] ) huza: [''].

# sign a message
Ibisohoka andika: ( 
	Isanduku-yumutekano sinya: ['abc'] na: long
), umurongo-mushya.

Ibisohoka andika: ( 
	Isanduku-yumutekano
		suzuma: ['abc'] 
		umukono: long 
		na: long
), umurongo-mushya.

Ibisohoka andika: (
	Isanduku-yumutekano hash-yijambobanga: long genzura: long
), umurongo-mushya.
