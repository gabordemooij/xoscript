{
	uyu-murimo ikosa: ['Dont fail.'].
	unknown doSomething.
} fata-ikosa: {
	Ibisohoka andika: ['Caught!'].
}, tangira.

{
	uyu-murimo ikosa: ['Dont fail.'].
	icyacyo unknown doSomething.
} fata-ikosa: {
	Ibisohoka andika: ['Caught!'].
}, tangira.

{
	uyu-murimo ikosa: ['Dont fail.'].
	unknown := 122.
} fata-ikosa: {
	Ibisohoka andika: ['Caught!'].
}, tangira.


{
	uyu-murimo ikosa: ['Dont fail.'].
	Ukuri hagarika-isubiramo.
	Ibisohoka andika: ['FAIL'].
} fata-ikosa: {
	Ibisohoka andika: ['Caught!'].
}, tangira.

{
	{
		uyu-murimo ikosa: ['Dont fail.'].
		Ukuri hagarika-isubiramo.
		Ibisohoka andika: ['FAIL'].
	} fata-ikosa: { :x
		(x = ['Dont fail.']) ukuri: { uyu-murimo ikosa: ['Nested Caught!']. }.
	}, tangira.
} fata-ikosa: { :e
	Ibisohoka andika: e.
}, tangira.
