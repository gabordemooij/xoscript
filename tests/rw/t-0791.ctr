Server init.

>> DB := Maria-DB gishya uwakira: ['localhost'],
	izina-ryukoresha: ['xo'],
	ijambobanga: ['pass123'],
	izina-ryububikoshingiro: ['xobase'],
	ihuze.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> ibipimo-byishakisha := Ikibazo-Maria gishya: SQL.

# set database
ibipimo-byishakisha ububikoshingiro: DB.

ibipimo-byishakisha zana: { :row
	Ibisohoka andika: row world, umurongo-mushya.
}.
