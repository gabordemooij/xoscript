>> invoice := Ikintu gishya.
invoice bigeze: ['tangira'] kora: {
        icyacyo umubare := 0.
}.

invoice bigeze: ['umubare'] kora: {
        icyacyo umubare ongeraho: 1. <- icyacyo umubare koporora.
}.

>> year-invoice := invoice gishya.
year-invoice bigeze: ['start:'] kora: { :umwaka
	icyacyo umubare := umwaka.
}.

year-invoice start: 202000.
Ibisohoka andika: year-invoice umubare, umurongo-mushya.
Ibisohoka andika: year-invoice umubare, umurongo-mushya.
