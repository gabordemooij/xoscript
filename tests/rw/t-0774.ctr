Ibisohoka andika: ['Test object'], umurongo-mushya.
>> a := Ikintu gishya. 
a bigeze: ['item:'] kora: { :lst
	icyacyo lst := lst. 
}.
a bigeze: ['item'] kora: { <- icyacyo lst.
}.
a item: (
	Urutonde gishya ; 1 ; (
		Urutonde gishya ; ['a'] ; (
			Urutonde gishya ; ( Akanya gishya: 1 )
		) ; ( Int64 bivuye-mu-nyandiko: ['321'] )
	)
).
Ibisohoka andika: a item, umurongo-mushya.
>> old-lst-address := a item icyitegererezo aderesi-yububiko.
a save-as: ['/tmp/a.bin'].
Ibisohoka andika: ['========== RELOADING SNAP:'], umurongo-mushya.
>> b := Ikintu load-from: ['/tmp/a.bin'].
(b item icyitegererezo aderesi-yububiko = old-lst-address) ukuri: {
	Ibisohoka andika: ['Object link re-attached.'], umurongo-mushya.
}.
Ibisohoka andika: ( b item ), umurongo-mushya.
