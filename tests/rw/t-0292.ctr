>> winery := { <- (	Inkoranyamagambo gishya
		shyira: 2 kuri: ['merlot'],
		shyira: 3 kuri: ['malbec'],
		shyira: 4 kuri: ['syrah']
	).
}.

Ibisohoka andika: (((winery tangira) - ['nothing']) umubare-wibintu), umurongo-mushya.
Ibisohoka andika: (((winery tangira) - ['merlot']) umubare-wibintu), umurongo-mushya.
Ibisohoka andika: (((winery tangira) - ['malbec']) umubare-wibintu), umurongo-mushya.
Ibisohoka andika: (((winery tangira) - ['syrah']) umubare-wibintu), umurongo-mushya.
Ibisohoka andika: (((winery tangira) - ['merlot'] - ['malbec']) umubare-wibintu), umurongo-mushya.
Ibisohoka andika: (((winery tangira) - ['merlot'] - ['syrah']) umubare-wibintu), umurongo-mushya.
Ibisohoka andika: (((winery tangira) - ['malbec'] -['syrah']) umubare-wibintu), umurongo-mushya.
Ibisohoka andika: (((winery tangira) - ['malbec'] - ['syrah'] - ['merlot']) umubare-wibintu), umurongo-mushya.

