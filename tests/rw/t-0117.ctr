>> t := Ukuri.
(t = Ukuri) ukuri: { Ibisohoka andika: ['T']. }.
(t = Ikinyoma) ukuri: { Ibisohoka andika: ['F']. }.
Ibisohoka andika: ['|'].
>> t := Ikinyoma.
(t = Ukuri) ukuri: { Ibisohoka andika: ['T']. }.
(t = Ikinyoma) ukuri: { Ibisohoka andika: ['F']. }.
Ibisohoka andika: ['|'].
>> f := Ukuri.
(t = Ukuri na: f = Ikinyoma) ukuri: { Ibisohoka andika: ['T']. }.
(t = Ikinyoma na: f = Ukuri) ukuri: { Ibisohoka andika: ['F']. }.
Ibisohoka andika: ['|'].
>> n := Ntacyo.
(n Ntacyo?) ukuri: { Ibisohoka andika: ['T']. }.
(n Ntacyo?) ikinyoma: { Ibisohoka andika: ['F']. }.
Ibisohoka andika: ['|'].
(f Boolean?) ukuri: { Ibisohoka andika: ['T']. }.
(f Boolean?) ikinyoma: { Ibisohoka andika: ['F']. }.



