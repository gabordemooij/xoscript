#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Icyitegererezo-cyishakisha gishya: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern guhura: subject kora: { :m :x
	Ibisohoka andika: m, umurongo-mushya.
	Ibisohoka andika: x, umurongo-mushya. <- ['XXX'].
}.
Ibisohoka andika: result, umurongo-mushya.