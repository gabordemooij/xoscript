>> Greeter := Ikintu gishya.
Greeter bigeze: ['make'] kora: {
	>> greeter := Ikintu gishya.
	greeter bigeze: ['name:'] kora: { :izina
		Ibisohoka andika: ['setting a name'].
		icyacyo myName := izina.
	}.
	greeter bigeze: ['greet'] kora: {
		Ibisohoka andika: ['Hello'].
		Ibisohoka andika: icyacyo myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
