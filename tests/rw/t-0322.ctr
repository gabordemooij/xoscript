

>> Matryoshka := Ikintu gishya.
Matryoshka bigeze: ['double:'] kora: { :secret
	icyacyo secret := secret × 2.
}.
Matryoshka bigeze: ['gishya:'] kora: { :secret
	>> answer := Ntacyo.
	>> t := (secret > 255).
	Ibisohoka andika: (secret + [' | '] + t), umurongo-mushya.
	t ukuri: {
		answer := secret.
	}, bitabaye-ibyo: {
		answer := Matryoshka kwihamagara gishya: (ubwacyo double: secret).
	}. <- answer.
}.

>> x := Matryoshka gishya: 2.
