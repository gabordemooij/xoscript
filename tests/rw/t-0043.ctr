>> repeater := Ikintu gishya.
repeater bigeze: ['subiza:'] kora: { :what
	Ibisohoka andika: what + [' '].
}.
repeater bigeze: ['subiza:na:'] kora: { :what :say
	Ibisohoka andika: what, andika: say + [' '].
}.
repeater bigeze: ['subiza:na:na:'] kora: { :what :say :more
	Ibisohoka andika: what, andika: say, andika: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
