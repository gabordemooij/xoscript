# from:length: counts characters and survives very large numbers
>> s := ['ééééééééééééééé'].
Out write: (s copy from: 0 length: 20), stop.
Out write: (s copy from: 10 length: 20), stop.
Out write: (s copy from: 14 length: 1), stop.
Out write: (s copy offset: 20), stop.
Out write: ['-'], stop.
Out write: (['abcdef'] from: 2 length: 2), stop.
Out write: (['abc'] from: 1 length: ['9e300'] number), stop.
Out write: (['abc'] from: 1 length: ['-9e300'] number), stop.
Out write: (['abc'] from: ['9e300'] number length: 1), stop.
Out write: ['-'], stop.
Out write: (['abc'] from: ['-9e300'] number length: 2), stop.
Out write: (['abc'] from: ['nan'] number length: 2), stop.
Out write: (['abc'] from: 0 length: ['nan'] number), stop.
Out write: ['-'], stop.
