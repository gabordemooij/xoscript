Программа хәтер-идарәсе: 4.

>> Doubler := Объект яңа.
>> Multiplier := Объект яңа.
Doubler килгәндә: ['double:and:'] эшлә: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier килгәндә: ['multiply:and:'] эшлә: { :x :y <- (x × y).
}.

Чыгыш яз: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), яңа-юл.
