Тезмә килгәндә: ['sum'] эшлә: {
	>> total := 0.
	үзе һәрбер: { :index :element
		total өстә: element.
	}. <- total.
}.

>> a := Дөрес.



a килгәндә: ['текст'] эшлә: {
	>> answer := Буш.
	( үзе = Дөрес ) дөрес: {
		answer := ['Yep'].
	}, югыйсә: {
		answer := ['Nope'].
	}. <- answer.
}.

a килгәндә: ['сан'] эшлә: {
	>> answer := Буш.
	( үзе = Дөрес ) дөрес: {
		answer := 10.
	}, югыйсә: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b килгәндә: ['текст'] эшлә: { <- ['Devil'].
}.

b килгәндә: ['логик'] эшлә: { <- Ялган.
}.


Чыгыш яз: a, яңа-юл.  
Чыгыш яз: (90 + a), яңа-юл. 
Чыгыш яз: b, яңа-юл. 
Чыгыш яз: (Дөрес һәм: b), яңа-юл.

a := Тезмә ← ['hello'] ; ['world'] ; Дөрес ; Буш ; 666. 
a := a + ( Тезмә ← 1 ).
Чыгыш яз: a, яңа-юл.
Чыгыш яз: ((Сүзлек яңа) куй: Буш ачкыч: Буш), яңа-юл.
Чыгыш яз: a sum, яңа-юл. 


{
	a килгәндә: ['текст'] эшлә: { <- Буш. }.
	a := [''] + a.
} тот: { :error
	Чыгыш яз: ['Error noted: '] + error, яңа-юл.
}, җибәр.



{
	a килгәндә: ['сан'] эшлә: { <- Буш. }.
	a := 3 × a.
} тот: { :error
	Чыгыш яз: ['Error noted: '] + error, яңа-юл.
}, җибәр.


{
	a килгәндә: ['логик'] эшлә: { <- Буш. }.
	a := Дөрес һәм: a. 
} тот: { :error
	Чыгыш яз: ['Error noted: '] + error, яңа-юл.
}, җибәр.





