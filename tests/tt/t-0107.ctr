
Чыгыш яз: ['Break for-loop, 0-4.'], яңа-юл.
{ :i
	Чыгыш яз: ['iteration #'] + i, яңа-юл.
	(i = 4) өз.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Чыгыш яз: ['Break while-true loop, 0-4.'], яңа-юл.
{
	Чыгыш яз: ['iteration #'] + x, яңа-юл.
	x өстә: 1.
	((x < 5) түгел) өз.
} әлегә: xIsLessThan10.

Чыгыш яз: ['Break while-false loop, 5,4.'], яңа-юл.
{
	Чыгыш яз: ['iteration #'] + x, яңа-юл.
	x ал: 1.
	(x = 3) өз.
} әлегә: { <- (x > 0). }.

Чыгыш яз: ['Break times loop, 1-4.'], яңа-юл.
{ :i
	Чыгыш яз: ['iteration #'] + i, яңа-юл.
	(i = 4) өз.
} × 5.

Чыгыш яз: ['Break block, dont print line.'], яңа-юл.
{ Дөрес өз. Чыгыш яз: ['dont write this!'], яңа-юл. } җибәр.

Чыгыш яз: ['Break block, dont fire catch...'], яңа-юл.
{ Дөрес өз. Чыгыш яз: ['dont write this!'], яңа-юл. } тот: { Чыгыш яз: ['Dont catch this!']. }, җибәр.

Чыгыш яз: ['Test Array each-loop: 0,1'], яңа-юл.
(Тезмә ← 1 ; 2 ; 3) үзгәрт: { :i
	Чыгыш яз: ['iteration #'] + i, яңа-юл.
	(i = 1) өз.
}.

Чыгыш яз: ['Test Map each-loop: c only'], яңа-юл.
>> m := Сүзлек яңа.
m куй: ['first'] ачкыч: ['a'], куй: ['second'] ачкыч: ['b'], куй: ['third'] ачкыч: ['c'].
m һәрбер: { :k :v
	Чыгыш яз: ['iteration'] + v + k, яңа-юл.
	Дөрес өз.
}.

