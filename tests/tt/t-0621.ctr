>> phrases := Тезмә яңа
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases һәрбер: { :_ :phrase 
	>> e := Server base64-кодлау: phrase.
	>> d := Server base64-декодлау: e.
	Чыгыш яз: (
		message күчермә ~encoded: e, ~decoded: d
	), яңа-юл.
}.
