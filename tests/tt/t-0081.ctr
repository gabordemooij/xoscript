>> map1 := Сүзлек яңа.
>> key1 := Тезмә яңа.
>> key2 := Тезмә яңа.

map1
	куй: ['hello'] ачкыч: key1,
	куй: ['world'] ачкыч: key2.


Чыгыш
	яз: ['Map #1 contains: '] + (map1 урында: key1),
	яз: [' and '] + (map1 урында: key2), яңа-юл.

>> KeyeableArray := Тезмә яңа.
KeyeableArray килгәндә: ['toString'] эшлә: { <- (үзе саны) toString.
}.

>> map2 := Сүзлек яңа.
key1 := KeyeableArray яңа.
key2 := KeyeableArray яңа.

key1 ахырга-өстә: 1.

map2
	куй: ['hello'] ачкыч: key1,
	куй: ['world'] ачкыч: key2.

Чыгыш
	яз: ['Map #2 contains: '] + (map2 урында: key1),
	яз: [' and '] + (map2 урында: key2), яңа-юл.
