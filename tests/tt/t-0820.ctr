# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Үрнәк яңа: pattern.
	p туры-килү: subject эшлә: { :m :g
		Чыгыш яз: g саны, яз: [' '], яз: (g берләштер: ['|']), яңа-юл. <- m.
	}.
}.
show куллан: ['(a)|(b)'] һәм: ['b'].
show куллан: ['(a)|(b)'] һәм: ['a'].
show куллан: ['(x)?y'] һәм: ['y'].
show куллан: ['(x)?(y)(z)?'] һәм: ['xy'].
