

Тезмә килгәндә: ['fixture:'] эшлә: { :f
	үзенең fixture := f.
}.

Тезмә килгәндә: ['саны'] эшлә: { <- үзенең fixture.
}.

Тезмә килгәндә: ['aantal'] эшлә: { <- үзенең fixture.
}.


>> x := Буш.
{

	x := ['hello'] 
	алыштыр:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] символ: 2)
			)
		)
	белән: (
		(['...hal'] + ['lo']) 
			баш-хәрефләр 
			lowecase 
			баш-хәрефләр 
			күчер: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Тезмә ← 0 ; 1 ; 4; 9 ; (Тезмә ← 0 ; 3; 1) ; 4
							) соңгыдан-алдагы
						) ? 1
					) + 
					((Тезмә ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					саны
				)
			)
	).

} × 10.
Чыгыш яз: x, яңа-юл.

