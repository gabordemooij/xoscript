>> t := Буш.

# you can control the time zone for
# parsing like this:
Мизгел зона: ['CET'].
t := Мизгел чыганак: ['1981-02-03 04:05:06'].
Чыгыш яз: t, яңа-юл.

# now using CEST time zone:
Мизгел зона: ['CEST'].
t := Мизгел чыганак: ['1981-02-03 04:05:06'].
Чыгыш яз: t, яңа-юл.

# error if string cannot be parsed
{ Мизгел чыганак: ['1900']. } тот: { Буш. }, җибәр.
