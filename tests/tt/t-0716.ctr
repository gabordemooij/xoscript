Чыгыш яз: ['Test object'], яңа-юл.
>> a := Объект яңа. 

a килгәндә: ['state:'] эшлә: { :list
	үзенең list := list. 
}.

a килгәндә: ['state'] эшлә: {
	Чыгыш яз: үзенең list, яңа-юл.
}.

a state: ( Тезмә яңа ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
Чыгыш яз: ['========== RELOADING SNAP:'], яңа-юл.
>> b := Объект load-from: ['/tmp/a.bin'].
b state.