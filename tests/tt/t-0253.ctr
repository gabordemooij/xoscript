#Linux
>> OS := Программа көйләү: ['OS'].

>> clock := Мизгел яңа.
	
(OS = ['Haiku']) дөрес: {
	clock зона: ['CET'],
	ел: 2017, ай: 7, көн: 13,
	сәгать: 18, минут: 0, секунд: 0.
}, югыйсә: {
	clock зона: ['Europe/Amsterdam'],
	ел: 2017, ай: 7, көн: 13,
	сәгать: 18, минут: 0, секунд: 0.
}.

clock килгәндә: ['tell'] эшлә: {
	Чыгыш яз: үзе, яңа-юл.
}.


clock өстә: 2    сәгать, tell.
clock өстә: 1    сәгать, tell.
clock өстә: 19 минут, tell.
clock өстә: 1  минут, tell.
clock өстә: 1  минут, tell.
clock өстә: 19 секунд, tell.
clock өстә: 1  секунд, tell.
clock өстә: 1  секунд, tell.
clock өстә: 2    ел, tell.
clock өстә: 1    ел, tell.

(OS = ['Haiku']) дөрес: {
clock өстә: 5   ай.
clock зона: ['CEST'], tell.
}, югыйсә: {
	clock өстә: 5   ай, tell.
}.

clock өстә: 1   ай, tell.
clock өстә: 19    көн, tell.
clock өстә: 1    сәгать, tell.
clock өстә: 120  yard, tell.
