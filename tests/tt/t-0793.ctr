Server init.

>> DB := Maria-DB яңа хост: ['localhost'],
	кулланучы-исеме: ['xo'],
	серсүз: ['pass123'],
	база-исеме: ['xobase'],
	тоташ.

{
	DB сорау:
	['DROP TABLE movies'],
	башкар.
} тот: { Буш. }, җибәр.

DB сорау:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
башкар.

DB сорау: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
параметрлар: ( Тезмә яңа ; ['Halloween'] ),
башкар.

DB сорау: ['SELECT * FROM movies'],
алып-кил: { :movie
	Чыгыш яз: movie title, яңа-юл.
}.

