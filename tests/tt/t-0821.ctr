# a quote that never closes must give an error, not an endless loop
>> юл := ['/tmp/test0821.csv'].
>> file := Файл яңа: юл.

file яз: ['a,b\n"1,2\n'].
{
	file аергыч: [','] куштырнак: ['"'] юллар: { :line
		Чыгыш яз: line, яңа-юл.
	}.
} тот: { :e Чыгыш яз: e, яңа-юл. }, җибәр.

# a closed quote still works
file яз: ['a,b\n"1,2",3'].
file аергыч: [','] куштырнак: ['"'] юллар: { :line
	Чыгыш яз: line, яңа-юл.
}.
file бетер.
