#Linux
>> OS := Программа система: (Боерык uname -s), кыскарту.

>> Slurp := Объект яңа.
Slurp килгәндә: ['яңа'] эшлә: {
	үзенең str := [''].
}.
Slurp килгәндә: ['җавап-бир:'] эшлә: { :blah
		(үзенең str ≠ ['']) дөрес: {
			үзенең str ахырга-өстә: [' '].
		}.
		үзенең str ахырга-өстә: blah.
}.
Slurp килгәндә: ['җавап-бир:һәм:'] эшлә: { :blah :blahah
		(үзенең str ≠ ['']) дөрес: {
			үзенең str ахырга-өстә: [' '].
		}.
		(blah озынлык > 1) дөрес: {
			үзенең str ахырга-өстә: (blah башлап: 0 озынлык: (blah озынлык - 1)).
		}, югыйсә: {
			үзенең str ахырга-өстә: blah.
		}.
		үзенең str ахырга-өстә: [' '].
		үзенең str ахырга-өстә: blahah.
}.
Slurp килгәндә: ['obtain'] эшлә: {
	>> buffer := үзенең str.
	үзенең str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text ахырга-өстә: ['hello'].
} × 1000.


Чыгыш яз: (
	Программа система: (
		Slurp яңа
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

