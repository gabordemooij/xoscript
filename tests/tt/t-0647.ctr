Server init.
Чыгыш яз: ['Database time test'], яңа-юл.

>> db := Maria-DB яңа хост: ['localhost'],
	кулланучы-исеме: ['xo'], 
	серсүз: ['pass123'],
	база-исеме: ['xobase'],
	тоташ.

>> эзләү-параметрлары :=
db сорау: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
алып-кил: { :row
	Чыгыш яз: row timetest, яңа-юл.
}.
