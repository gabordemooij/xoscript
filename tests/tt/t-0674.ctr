# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> юл := ['/tmp/dat.csv'].
>> csv := Файл яңа: юл.
csv яз: s.

# accepts CRLF LF CR, varying row length
csv аергыч: [';'] куштырнак: ['"'] юллар: { :line
	Программа чистарт.
	Чыгыш яз: line, яңа-юл.
	Программа чистарт.
}.

# unequal lines
s ахырга-өстә: ['\njustone'].
csv яз: s.
{
	csv аергыч: [';'] куштырнак: ['"'] юллар: { :line
		Чыгыш яз: line, яңа-юл.
	}.
} тот: { :e 
	Чыгыш яз: e, яңа-юл.
}, җибәр.

# invalid format
s := ['"he"llo";world'].
csv яз: s.
{
	csv аергыч: [';'] куштырнак: ['"'] юллар: { :line
		Чыгыш яз: line, яңа-юл.
	}.
} тот: { :e 
	Чыгыш яз: e, яңа-юл.
}, җибәр.
