# test Program version

# this feature is disabled by default
Чыгыш яз: (
	Программа мөмкинлек: 
	['RECURSIVE_STRINTPOL']
), яңа-юл.


# but if we set the time back
>> today := Мизгел 
зона: ['CEST'],
чыганак: ['2026-02-15 10:00:00'].
Программа версия: today.

# it will be enabled like it used to be (from now on)
Чыгыш яз: (
	Программа мөмкинлек: 
	['RECURSIVE_STRINTPOL']
), яңа-юл.