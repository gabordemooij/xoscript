>> Grandfather := Объект яңа.
Grandfather килгәндә: ['greet'] эшлә: {
	Чыгыш яз: ['Ave!'], яңа-юл.
}.
>> Father := Grandfather яңа.
Father килгәндә: ['greet'] эшлә: {
	Чыгыш яз: ['Hello'], яңа-юл.
	үзе greet.
}.
>> Son := Father яңа.
Son килгәндә: ['greet'] эшлә: {
	Чыгыш яз: ['Hi'], яңа-юл.
	үзе greet.
}.

Son greet.

>> Roundabout := Объект яңа.
Roundabout килгәндә: ['circle:'] эшлә: { :x
	Чыгыш яз: x, яңа-юл.
	(x < 3) дөрес: { үзе рекурсив circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) дөрес: { Чыгыш яз: x, яңа-юл. x өстә: 1.  increment җибәр. }. }.
increment җибәр.