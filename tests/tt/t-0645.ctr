Server init.
Чыгыш яз: ['Database date test'], яңа-юл.

>> db := Maria-DB яңа хост: ['localhost'],
	кулланучы-исеме: ['xo'], 
	серсүз: ['pass123'],
	база-исеме: ['xobase'],
	тоташ.

>> эзләү-параметрлары :=
db сорау: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
алып-кил: { :row
	Чыгыш яз: row datetest, яңа-юл.
}.
