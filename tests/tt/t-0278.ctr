>> To-Do := Объект яңа.

To-Do килгәндә: ['яңа'] эшлә: {
	үзенең list := Тезмә яңа.
}.

To-Do килгәндә: ['nieuw'] эшлә: {
	үзенең list := Тезмә яңа.
}.

To-Do килгәндә: ['+'] эшлә: { :task
	үзенең list ахырга-өстә: task.
}.

To-Do килгәндә: ['number of tasks?'] эшлә: { <-  үзенең list саны.
}.

>> todos := 
	To-Do яңа 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Чыгыш яз: ['You have $ tasks to do'] $ todos number of tasks?.
