Чыгыш яз: ['Test object'], яңа-юл.
>> a := Объект яңа. 

a килгәндә: ['item:'] эшлә: { :dict
	үзенең dict := dict. 
}.

a килгәндә: ['item'] эшлә: { <- үзенең dict.
}.

a item: (
Сүзлек яңа
	hello: ['world']).

>> old-dict-address := a item прототип хәтер-адресы.
a save-as: ['/tmp/a.bin'].
Чыгыш яз: ['========== RELOADING SNAP:'], яңа-юл.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип хәтер-адресы = old-dict-address) дөрес: {
	Чыгыш яз: ['Object link re-attached.'], яңа-юл.
}.

Чыгыш яз: b item, яңа-юл.
