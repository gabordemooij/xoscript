
>> Greeter := Объект яңа.
Greeter килгәндә: ['яңа'] эшлә: {
	үзенең исем := ['?'].
}.
Greeter килгәндә: ['name:'] эшлә: { :исем
	үзенең исем := исем.
}.
Greeter килгәндә: ['greet'] эшлә: {
	Чыгыш яз: (['hello[you]'] [you]: үзенең исем).
}.
>> friend := Greeter яңа.
friend name: ['1'].
friend greet.
