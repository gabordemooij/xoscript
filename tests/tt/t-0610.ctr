
>> Rectangle := Объект яңа.

Rectangle килгәндә: ['area'] эшлә: { <- үзенең озынлык * үзенең width.
}.

Rectangle килгәндә: ['length:'] эшлә: { :озынлык
	үзенең озынлык := озынлык.
}.

Rectangle килгәндә: ['width:'] эшлә: { :width
	үзенең width := width.
}.

Rectangle килгәндә: ['яңа'] эшлә: {
	# this will not result into an infinite loop
	>> rectangle := үзе яңа.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle яңа.
Чыгыш яз: a area, яңа-юл. #0

>> b := Rectangle яңа length: 2, width: 3.
Чыгыш яз: b area, яңа-юл. #6

