>> a := Тезмә ← Объект ; Дөрес ; Ялган ; Логик ; 1 ; Сан ; ['Str'] ; Текст ; { ['Empty']. }.
Чыгыш яз: (a саны), яңа-юл.
{ :i
	Чыгыш яз: 
	['a '] + 
	((a ? i) төр) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Буш?) бу: [''] яки-теге: ['NOT']) + 
	[' Nil.'],
	яңа-юл.
} × (a саны).
Чыгыш яз: ['but.. Nil is.. '] + ((Буш Буш?) бу: ['certainly NIL!'] яки-теге: ['not NIL??']), яңа-юл.