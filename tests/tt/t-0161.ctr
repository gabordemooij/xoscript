Программа хәтер-идарәсе: 0.
Тезмә килгәндә: ['sum'] эшлә: {
	>> total := 0.
	үзе һәрбер: { :index :element
		total өстә: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Файл яңа: ['/tmp/test.txt'].
f яз: ['Lorem Ipsum'].
f яп.
  

f := Файл яңа: ['/tmp/test.txt'].
>> text := f укы.
f яп.



Программа чистарт.
usedMemory1 := (Программа хәтер ? 1).



