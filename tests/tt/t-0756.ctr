Чыгыш яз: ['Test object'], яңа-юл.
>> greeter := Объект яңа.
greeter килгәндә: ['name:'] эшлә: { :исем
	үзенең xname := исем. 
}.
greeter килгәндә: ['greet'] эшлә: {
	Чыгыш яз: ['Hello '] + үзенең xname, яңа-юл.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Чыгыш яз: ['========== RELOADING SNAP:'], яңа-юл.
>> b := Объект load-from: ['/tmp/a.bin'].
>> c := Объект load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
