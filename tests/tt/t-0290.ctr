# test list operations


>> cakes := Тезмә ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes алыштыр: 1 озынлык: 2 белән: ( Тезмә ← ['cinnamon'] ; ['pineapple'] ).
Чыгыш яз: (buy берләштер: [',']), яңа-юл.


>> buy := cakes алыштыр: 1 озынлык: 12 белән: ( Тезмә ← ['cinnamon'] ; ['pineapple'] ).
Чыгыш яз: (buy берләштер: [',']), яңа-юл.


>> buy := cakes алыштыр: 2 озынлык: 10 белән: ( Тезмә яңа ).
Чыгыш яз: (buy берләштер: [',']), яңа-юл.


>> buy := cakes алыштыр: 0 озынлык: 1 белән: ( Тезмә яңа ).
Чыгыш яз: (buy берләштер: [',']), яңа-юл.


>> buy := cakes алыштыр: ['0'] озынлык: ['1'] белән: ['x'].
Чыгыш яз: (buy берләштер: [',']), яңа-юл.
