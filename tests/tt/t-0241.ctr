

Текст килгәндә: ['evaluate'] эшлә: {
	>> код := Файл яңа: ['/tmp/eval.ctr'].
	код яз: (үзе текст + ['.']).
	Программа файдалан: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Тезмә ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q текст.
Чыгыш яз: x, яңа-юл.
>> y := Буш.
(['y := '] + x ) evaluate.
Чыгыш яз: y ? 0, яңа-юл.

q := Сүзлек куй: ['\[''] ачкыч: ['\['quote\']'].
x := q текст.
Чыгыш яз: x, яңа-юл.
y := Буш.
(['y := '] + x ) evaluate.

>> q := (Сүзлек яңа) куй:['\[''] ачкыч:['\['quote\[''].
Чыгыш яз: y ? ['\['quote\']'], яңа-юл.
