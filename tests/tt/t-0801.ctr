Server init.

>> db := Maria-DB яңа хост: ['localhost'],
	кулланучы-исеме: ['xo'],
	серсүз: ['pass123'],
	база-исеме: ['xobase'],
	тоташ.

>> del := db сорау: ['DELETE FROM book WHERE id > 0'].
{  del башкар. db раслау. } тот: { :e db кире-кайтар.  }, җибәр.

>> саны := db сорау: ['SELECT COUNT(*) AS num FROM book'].
саны алып-кил: { :row Чыгыш яз: row num, яңа-юл. }.
