# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Сейф 
	серсүз-хэшы: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Сейф 
	серсүз-хэшы: hash тикшер: a1.
	# fail 
>> b := Сейф
	серсүз-хэшы: hash тикшер: a2.
	# ok!

Чыгыш яз: a, яңа-юл.
Чыгыш яз: b, яңа-юл.

