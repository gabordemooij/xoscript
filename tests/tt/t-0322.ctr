

>> Matryoshka := Объект яңа.
Matryoshka килгәндә: ['double:'] эшлә: { :secret
	үзенең secret := secret × 2.
}.
Matryoshka килгәндә: ['яңа:'] эшлә: { :secret
	>> answer := Буш.
	>> t := (secret > 255).
	Чыгыш яз: (secret + [' | '] + t), яңа-юл.
	t дөрес: {
		answer := secret.
	}, югыйсә: {
		answer := Matryoshka рекурсив яңа: (үзе double: secret).
	}. <- answer.
}.

>> x := Matryoshka яңа: 2.
