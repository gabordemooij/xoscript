
Текст килгәндә: ['evaluate'] эшлә: {
	>> код := Файл яңа: ['/tmp/eval.ctr'].
	код яз: (үзе текст + ['.']).
	Программа файдалан: ['/tmp/eval.ctr'].
}.

>> map :=
	(Сүзлек яңа)
	куй: ['Hi There'] ачкыч: ['two'],
	куй: (Тезмә ← ['hello'] ; ['world'] ; (Тезмә ← 1 ; 2; 9) ; Ялган) ачкыч: ['one'],
	куй: ( (Сүзлек яңа) куй: ['wrrld'] ачкыч: ['misspelled'] ) ачкыч: ['three'],
	куй: (Тезмә ← ((Сүзлек яңа) куй: ['treasure'] ачкыч: ['hidden']) ; 2) ачкыч: ['four']. 
>> str := map текст.
>> map2 := Буш.
(['map2 := '] + str ) evaluate.
Чыгыш яз: map2 ? ['one'] ? 0.
Чыгыш яз: map2 ? ['one'] ? 1.
Чыгыш яз: map2 ? ['four'] ? 0 ? ['hidden'].
Чыгыш яз: map2 ? ['one'] ? 2 ? 2.
