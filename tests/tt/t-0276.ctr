>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Объект яңа.
⚄ килгәндә: ['drawFrom:length:'] эшлә: { :pool :саны
	
	>> result := [''].
	
	{
		>> index := Сан random % (pool озынлык).
		result ахырга-өстә: ( pool символ: (index + 1) ).
		
	} × саны. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? озынлык.
Чыгыш яз: (['x↵'] x random озынлык).
Чыгыш яз: (['y↵'] y ?? озынлык).

