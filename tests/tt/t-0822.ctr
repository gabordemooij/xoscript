# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := Maria-DB яңа хост: ['localhost'],
	кулланучы-исеме: ['xo'],
	серсүз: ['pass123'],
	база-исеме: ['xobase'],
	тоташ.

>> эзләү-параметрлары := db сорау: ['SELECT ? AS a, ? AS b, ? AS c'].
эзләү-параметрлары параметрлар: (Тезмә яңа ; ['1']).
{ эзләү-параметрлары алып-кил: { :row Чыгыш яз: row, яңа-юл. }. } тот: { :e Чыгыш яз: e, яңа-юл. }, җибәр.

>> эзләү-параметрлары := db сорау: ['SELECT ? AS a'].
{ эзләү-параметрлары алып-кил: { :row Чыгыш яз: row, яңа-юл. }. } тот: { :e Чыгыш яз: e, яңа-юл. }, җибәр.

# the right number still works, more parameters are ignored as before
>> эзләү-параметрлары := db сорау: ['SELECT ? AS a, ? AS b'].
эзләү-параметрлары параметрлар: (Тезмә яңа ; ['1'] ; ['2']).
эзләү-параметрлары алып-кил: { :row Чыгыш яз: (row урында: ['a']), яз: (row урында: ['b']), яңа-юл. }.
эзләү-параметрлары параметрлар: (Тезмә яңа ; ['1'] ; ['2'] ; ['3']).
эзләү-параметрлары алып-кил: { :row Чыгыш яз: (row урында: ['a']), яз: (row урында: ['b']), яңа-юл. }.
