Чыгыш яз: ['Test object'], яңа-юл.
>> a := Объект яңа. 

a килгәндә: ['item:'] эшлә: { :out
	үзенең out := out. 
}.

a килгәндә: ['item'] эшлә: { <- үзенең out.
}.

a килгәндә: ['greet'] эшлә: {
	Чыгыш яз: ['hi from original out!'], яңа-юл.
}.

a item: Чыгыш.

Чыгыш яз: a item, яңа-юл.

>> old-out-address := a item прототип хәтер-адресы.
a save-as: ['/tmp/a.bin'].
Чыгыш яз: ['========== RELOADING SNAP:'], яңа-юл.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип хәтер-адресы = old-out-address) дөрес: {
	Чыгыш яз: ['Object link re-attached.'], яңа-юл.
}.

b item яз: ['hello from loaded out!'], яңа-юл.
b greet.
