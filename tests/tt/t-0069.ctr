

Текст килгәндә: ['html'] эшлә: { <- (
		үзе
		алыштыр: ['&'] белән: ['&amp;'],
		алыштыр: ['<'] белән: ['&lt;'],
		алыштыр: ['>'] белән: ['&gt;'],
		алыштыр: ['"'] белән: ['&quot;']
	).
}.


Чыгыш яз: ([' left trimmed '] кыскарту) + [' '] + ( ['and right trimmed'] кыскарту) + ['!'], яңа-юл.
Чыгыш яз: ['<html>"html & entities"</html>'] html.
