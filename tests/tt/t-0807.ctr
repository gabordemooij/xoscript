# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB яңа хост: ['localhost'],
	кулланучы-исеме: ['xo'],
	серсүз: ['pass123'],
	база-исеме: ['xobase'],
	тоташ.

>> эзләү-параметрлары := db сорау: ['SELECT %% FROM'].
{ эзләү-параметрлары башкар. } тот: { :e
	Чыгыш яз: ( e эченә-ала: ['%%'] ), яңа-юл.
}, җибәр.
