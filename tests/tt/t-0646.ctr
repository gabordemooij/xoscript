Server init.
Чыгыш яз: ['Database datetime test'], яңа-юл.

>> db := Maria-DB яңа хост: ['localhost'],
	кулланучы-исеме: ['xo'], 
	серсүз: ['pass123'],
	база-исеме: ['xobase'],
	тоташ.

>> эзләү-параметрлары :=
db сорау: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
алып-кил: { :row
	Чыгыш яз: row datetimetest, яңа-юл.
}.
