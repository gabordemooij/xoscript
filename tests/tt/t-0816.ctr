# a format must fit the type of the value, the type can come from a client
>> тырышу := { :format :value
	{ Чыгыш яз: ( (Формат яңа: format) куллан: value ), яңа-юл. } тот: { :e Чыгыш яз: e, яңа-юл. }, җибәр.
}.
>> try-int := { :format :value
	{ Чыгыш яз: ( (Формат яңа: format) куллан-бөтен: value ), яңа-юл. } тот: { :e Чыгыш яз: e, яңа-юл. }, җибәр.
}.

# fits
тырышу куллан: ['|%s|'] һәм: ['text'].
тырышу куллан: ['%06.2f'] һәм: 5.5.
тырышу куллан: ['100%% %s'] һәм: ['sure'].
try-int куллан: ['%03d'] һәм: 7.
try-int куллан: ['%x'] һәм: 255.
тырышу куллан: ['%d'] һәм: (Int64 яңа тексттан: ['12']).
тырышу куллан: ['%lld'] һәм: (Int64 яңа тексттан: ['12']).
тырышу куллан: ['%.1lf'] һәм: 5.5.
try-int куллан: ['%hd'] һәм: 7.

# does not fit
тырышу куллан: ['%s'] һәм: 12345.
тырышу куллан: ['%d'] һәм: 12345.
тырышу куллан: ['%f'] һәм: ['text'].
try-int куллан: ['%d'] һәм: ['text'].
try-int куллан: ['%s'] һәм: 5.
тырышу куллан: ['%s %s'] һәм: ['text'].
тырышу куллан: ['%n'] һәм: ['text'].
тырышу куллан: ['%*s'] һәм: ['text'].
тырышу куллан: ['%'] һәм: ['text'].

# length modifier does not fit
тырышу куллан: ['%ls'] һәм: ['text'].
тырышу куллан: ['%Lf'] һәм: 5.5.
try-int куллан: ['%ld'] һәм: 7.
try-int куллан: ['%lld'] һәм: 7.
тырышу куллан: ['%Ld'] һәм: (Int64 яңа тексттан: ['12']).

# a width that does not fit printf must give an error, not a crash
тырышу куллан: ['%99999999999s'] һәм: ['text'].
