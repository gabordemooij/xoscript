Server init.

Чыгыш яз: (
	Үрнәк яңа: ['^\\w+$'],
	туры-килү: ['test@example.com'] 
), яңа-юл. # 0 match, fails on @ and .

Чыгыш яз: (
	Үрнәк яңа: ['^[^@]+@[^\.]+\.\\w+$'],
	туры-килү: ['test@example.com'] 
), яңа-юл. # 1 match

Чыгыш яз: (
	Үрнәк яңа: ['[^@]+@[^\.]+\.\\w+'],
	туры-килү: ['test@example.com'] 
), яңа-юл. # 1 match

Чыгыш яз: (
	Үрнәк яңа: ['([^@]+)@([^\.]+)\.\\w+'],
	туры-килү: ['test@example.com'] 
), яңа-юл. # 1 match, groups dont matter

Чыгыш яз: (
	Үрнәк яңа: ['[a-z]'],
	туры-килү: ['test@example.com'] 
), яңа-юл. # 14 matches

Чыгыш яз: (
	Үрнәк яңа: ['.*'],
	туры-килү: ['test@example.com'] 
), яңа-юл. # 1 match (all)

Чыгыш яз: (
	Үрнәк яңа: ['(.*)'],
	туры-килү: ['test@example.com'] 
), яңа-юл. # 1 match (all)

Чыгыш яз: (
	Үрнәк яңа: ['\\s*[^@]+@[^\.]+\.\\w+'],
	туры-килү: ['test@example.com'] 
), яңа-юл. # 1 match, prefix space optional, gets ignored