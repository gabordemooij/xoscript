# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob яңа: 8, bytes: (
	Тезмә яңа ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Чыгыш яз: ( utf16 декодлау: ['utf16le'] ), яңа-юл.

utf16 бушат.
>> utf32 := Blob яңа: 13, bytes: (
	Тезмә яңа ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Чыгыш яз: ( utf32 декодлау: ['utf32be'] ), яңа-юл.
utf32 бушат.