


>> CoffeeMachine := Объект яңа.
CoffeeMachine килгәндә: ['order:'] эшлә: { :id
	>> coffee := ['Americano'].
	( id = 1 ) дөрес: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) дөрес: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) дөрес: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Объект яңа.
SimpleCoffeeMachine килгәндә: ['order'] эшлә: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Чыгыш яз: redCup, яңа-юл.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Чыгыш яз: greenCup, яңа-юл.
>> yellowCup := CoffeeMachine order: 1.
Чыгыш яз: yellowCup, яңа-юл.
>> blueCup := CoffeeMachine order: 0.
Чыгыш яз: blueCup, яңа-юл.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Чыгыш яз: blackCup, яңа-юл.
blackCup ахырга-өстә: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Чыгыш яз: orangeCup, яңа-юл.
