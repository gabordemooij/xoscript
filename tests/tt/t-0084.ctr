>> makeAdder := { :x
	>> f := { :y <- (үзенең x + y). } билгелә: ['x'] кыйммәт: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i үзенең q куй: (үзенең f куллан: (үзенең q ? i)) ачкыч: i. } 
	билгелә: ['q'] кыйммәт: array,
	билгелә: ['f'] кыйммәт: func.
	{ :i mapping куллан: i. } × (array саны).
}.

>> a := Тезмә ← 1; 2; 3.
mapper куллан: a һәм: (makeAdder куллан: 100).
Чыгыш яз: (a урын: 0), яңа-юл.
Чыгыш яз: (a ? 1), яңа-юл.
Чыгыш яз: (a ? 2), яңа-юл.
