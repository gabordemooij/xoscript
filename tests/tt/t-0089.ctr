>> randomizer := { :a :b
	>> минимум := ( a < b ) бу: a яки-теге: b.
	>> максимум := ( a > b ) бу: a яки-теге: b.
	>> x := Буш.
	{
		x := Сан арасында: a һәм: b.
		((x < минимум) яки: (x > максимум)) дөрес: { 
			Чыгыш яз: (['Invalid value!']).
			Программа тәмамла.
		}.
	} 
	× 100. <- x.
}.
