
>> dictionary := (
	Сүзлек яңа
		куй: ['b'] ачкыч: ['a'],
		куй: ['a'] ачкыч: ['b'],
		куй: ['z'] ачкыч: ['x'],
		куй: ['hello'] ачкыч: ['hallo'],
		куй: ['human'] ачкыч: ['human']
).

>> comparisons := Тезмә яңа.
dictionary һәрбер: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a чагыштыр: b)
	).
}.

comparisons тәртипкә-сал: { :a :b <- ( a чагыштыр: b ). }.
Чыгыш яз: ( comparisons берләштер: ['↵'] ), яңа-юл.
comparisons берләштер: ['↵'].
