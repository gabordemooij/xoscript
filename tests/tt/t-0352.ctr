Сан килгәндә: ['roman'] эшлә: {
	>> сан := үзе күчермә.
	>> roman := [''].
	{
		{
			(сан ≥ 1000) дөрес: {
				roman ахырга-өстә: ['Ⅿ'].
				сан ал: 1000.
			}, өз.
		
			(сан ≥ 500) дөрес: {
				roman ахырга-өстә: ['Ⅾ'].
				сан ал: 500.
			}, өз.
		
			(сан ≥ 100) дөрес: {
				roman ахырга-өстә: ['Ⅽ'].
				сан ал: 100.
			}, өз.
		
			(сан ≥ 50) дөрес: {
				roman ахырга-өстә: ['Ⅼ'].
				сан ал: 50.
			}, өз.
		
			(сан ≥ 50) дөрес: {
				roman ахырга-өстә: ['Ⅼ'].
				сан ал: 50.
			}, өз.
		
			(сан ≥ 10) дөрес: {
				roman ахырга-өстә: ['Ⅹ'].
				сан ал: 10.
			}, өз.
			
			(сан ≥ 9) дөрес: {
				roman ахырга-өстә: ['Ⅸ'].
				сан ал: 9.
			}, өз.
			
			(сан ≥ 5) дөрес: {
				roman ахырга-өстә: ['Ⅴ'].
				сан ал: 5.
			}, өз.
			
			(сан ≥ 4) дөрес: {
				roman ахырга-өстә: ['Ⅳ'].
				сан ал: 4.
			}, өз.
			
			(сан ≥ 1) дөрес: {
				roman ахырга-өстә: ['Ⅰ'].
				сан ал: 1.
			}, өз.
		} процедура.
	} әлегә: { <- сан > 0. }. <- roman.
}.

Чыгыш яз: 1 roman, яңа-юл.
Чыгыш яз: 2 roman, яңа-юл.
Чыгыш яз: 4 roman, яңа-юл.
Чыгыш яз: 8 roman, яңа-юл.
Чыгыш яз: 16 roman, яңа-юл.
Чыгыш яз: 32 roman, яңа-юл.
Чыгыш яз: 64 roman, яңа-юл.
Чыгыш яз: 128 roman, яңа-юл.
Чыгыш яз: 256 roman, яңа-юл.
Чыгыш яз: 1024 roman, яңа-юл.
