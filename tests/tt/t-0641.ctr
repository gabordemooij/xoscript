# Test utf8 sanitizer
Server init.

>> utf8cases := Сүзлек яңа
	# ASCII only
	куй: ( Тезмә яңа ; 65 ; 65 ; 65 ; 65 ; 0 ) ачкыч: ['AAAA'],
	# valid 2 byte sequence
	куй: ( Тезмә яңа ; 194 ; 162 ; 0 ) ачкыч: ['¢'],
	# Valid 3-byte UTF-8
    куй: ( Тезмә яңа ; 226 ; 130 ; 172 ; 0 ) ачкыч: ['€'],
	# Valid 4-byte UTF-8
    куй: ( Тезмә яңа ; 240 ; 144 ; 141 ; 136 ; 0 ) ачкыч: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    куй: ( Тезмә яңа ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) ачкыч: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    куй: ( Тезмә яңа ; 65 ; 193 ; 129 ; 0 ) ачкыч: ['A?'],
	# Invalid first byte (0xFF)
    куй: ( Тезмә яңа ; 255 ; 0 ) ачкыч: ['?'],
	# Incomplete multi-byte sequence at end
    куй: ( Тезмә яңа ; 66 ; 226 ; 0 ) ачкыч: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    куй: ( Тезмә яңа ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) ачкыч: ['A€?𐍈B'].
	 
utf8cases һәрбер: { :key :value
	>> blob := Blob яңа: value саны, bytes: value.
	>> str := blob текст.
	(str = key) дөрес: {
		Чыгыш яз: ['OK'], яңа-юл.
	}, югыйсә: {
		Чыгыш яз: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, яңа-юл.
	}.
	blob бушат.
}.
