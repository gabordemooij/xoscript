#Linux
>> clock := Мизгел яңа.
clock зона: ['UTC-1'].
clock ел: 1981, ай: 1, көн: 5,
      сәгать: 13, минут: 15, секунд: 13.

Чыгыш яз: clock, яңа-юл.
clock зона: ['UTC+0'].

Чыгыш яз: (
	(clock ел гади) + ['-'] + (clock ай) + ['-'] + (clock көн) + [' '] +
	(clock сәгать) + [':'] + (clock минут) + [':'] + (clock секунд) + [' '] +
	['W'] + (clock атна) + (clock зона)
), яңа-юл.


clock зона: ['UTC-1'].
Чыгыш яз: (
	(clock ел гади) + ['-'] + (clock ай) + ['-'] + (clock көн) + [' '] +
	(clock сәгать) + [':'] + (clock минут) + [':'] + (clock секунд) + [' '] +
	['W'] + (clock атна) + (clock зона)
), яңа-юл.
