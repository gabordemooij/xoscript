
Текст килгәндә: ['html'] эшлә: { <- (
		үзе
		алыштыр: ['&'] белән: ['&amp;'],
		алыштыр: ['<'] белән: ['&lt;'],
		алыштыр: ['>'] белән: ['&gt;'],
		алыштыр: ['"'] белән: ['&quot;']
	).
}.

>> HtmlBrush := Объект яңа.

HtmlBrush килгәндә: ['җавап-бир:'] эшлә: { :tag
	Чыгыш яз: (['<tag>↵'] tag: tag ).
}.

HtmlBrush килгәндә: ['җавап-бир:һәм:'] эшлә: { :tag :content
	tag := ( tag башлап: 0 озынлык: (tag озынлык - 1) ).
	Чыгыш яз: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush килгәндә: ['content:'] эшлә: { :text
	Чыгыш яз: text html, яңа-юл.
}.

HtmlBrush килгәндә: ['attr:value:'] эшлә: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush яңа.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
