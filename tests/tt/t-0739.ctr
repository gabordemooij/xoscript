Чыгыш яз: ['Test object'], яңа-юл.
>> a := Объект яңа. 

a килгәндә: ['item:'] эшлә: { :binhelper
	үзенең binhelper := binhelper. 
}.

a килгәндә: ['item'] эшлә: { <- үзенең binhelper.
}.

a item: Bin яңа.

>> old-binhelper-address := a item прототип хәтер-адресы.
a save-as: ['/tmp/a.bin'].
Чыгыш яз: ['========== RELOADING SNAP:'], яңа-юл.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип хәтер-адресы = old-binhelper-address) дөрес: {
	Чыгыш яз: ['Object link re-attached.'], яңа-юл.
}.


