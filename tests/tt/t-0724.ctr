Чыгыш яз: ['Test object'], яңа-юл.
>> a := Объект яңа. 

a килгәндә: ['item:'] эшлә: { :file
	үзенең file := file. 
}.

a килгәндә: ['item'] эшлә: { <- үзенең file.
}.

>> f := Файл яңа: ['/tmp/aaa.txt'].
a item: f.
Чыгыш яз: a item, яңа-юл.
a save-as: ['/tmp/a.bin'].
Чыгыш яз: ['========== RELOADING SNAP:'], яңа-юл.
>> b := Объект load-from: ['/tmp/a.bin'].
Чыгыш яз: b item, яңа-юл.
