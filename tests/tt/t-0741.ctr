Чыгыш яз: ['Test object'], яңа-юл.
>> a := Объект яңа. 

a килгәндә: ['item:'] эшлә: { :octhelper
	үзенең octhelper := octhelper. 
}.

a килгәндә: ['item'] эшлә: { <- үзенең octhelper.
}.

a item: Oct яңа.

>> old-octhelper-address := a item прототип хәтер-адресы.
a save-as: ['/tmp/a.bin'].
Чыгыш яз: ['========== RELOADING SNAP:'], яңа-юл.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип хәтер-адресы = old-octhelper-address) дөрес: {
	Чыгыш яз: ['Object link re-attached.'], яңа-юл.
}.
