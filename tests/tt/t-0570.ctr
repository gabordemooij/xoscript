#Linux

 >> t := Мизгел яңа.
 
t зона: ['Europe/Amsterdam'].
t ел: 2020, ай: 8, көн: 2, сәгать: 21, минут: 2, секунд: 1.

>> a := t сәгать.
>> ams := t зона.

t зона: ['US/Hawaii'].
>> b := t сәгать.
>> hw := t зона.

Чыгыш
яз: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		бу: ['later'] яки-теге: ['earlier']
	)
),
яңа-юл.
 