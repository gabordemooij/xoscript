>> winery := { <- (	Сүзлек яңа
		куй: 2 ачкыч: ['merlot'],
		куй: 3 ачкыч: ['malbec'],
		куй: 4 ачкыч: ['syrah']
	).
}.

Чыгыш яз: (((winery җибәр) - ['nothing']) саны), яңа-юл.
