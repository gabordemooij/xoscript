Server init.

>> DB := Maria-DB яңа хост: ['localhost'],
	кулланучы-исеме: ['xo'],
	серсүз: ['pass123'],
	база-исеме: ['xobase'],
	тоташ.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB сорау: SQL.

# now you don't have to set DB
query2 алып-кил: { :row
	Чыгыш яз: row world, яңа-юл.
}.
