Чыгыш яз: ['1,2,3,4,5,6,7,8,9,A,'], яңа-юл.
>> Scope := Объект яңа.
Scope килгәндә: ['initialize:'] эшлә: { :x үзенең property := x. }.
Scope килгәндә: ['confirm'] эшлә: { Чыгыш яз: [',']. }.
Scope килгәндә: ['сынау'] эшлә: {
	Чыгыш яз: үзенең property.
	үзе confirm.
	( 1 = 1 ) дөрес: { Чыгыш яз: үзенең property. үзе confirm. }.
	( 1 = 0 ) ялган: { Чыгыш яз: үзенең property. үзе confirm. }.
	>> y := 2. { Чыгыш яз: үзенең property. үзе confirm. } әлегә: { y ал: 1. <- (y > 0). }.
	{ Чыгыш яз: үзенең property. үзе confirm. } × 1.
	(Тезмә ← 1) һәрбер: {  Чыгыш яз: үзенең property. үзе confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Сүзлек яңа one: ['item']) һәрбер: { Чыгыш яз: үзенең property. үзе confirm. }.
	{ 1 ÷ 0. } тот: { Чыгыш яз: үзенең property. үзе confirm. }, җибәр.
	Чыгыш яңа-юл.
}.
>> scope1 := Scope яңа.
scope1 initialize: ['X'].
scope1 сынау.
>> function := { 
	үзенең property := ['Y'].
	Чыгыш яз: үзенең property.
	үзе confirm.
	( 1 = 1 ) дөрес: { Чыгыш яз: үзенең property. үзе confirm. }.
	( 1 = 0 ) ялган: { Чыгыш яз: үзенең property. үзе confirm. }.
	>> y := 2. { Чыгыш яз: үзенең property. үзе confirm. } әлегә: { y ал: 1. <- (y > 0). }.
	{ Чыгыш яз: үзенең property. үзе confirm. } × 1.
	(Тезмә ← 1) һәрбер: {  Чыгыш яз: үзенең property. үзе confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Сүзлек яңа one: ['item']) һәрбер: { Чыгыш яз: үзенең property. үзе confirm. }.
	{ 1 ÷ 0. } тот: { Чыгыш яз: үзенең property. үзе confirm. }, җибәр.
	Чыгыш яңа-юл.
}.
function килгәндә: ['confirm'] эшлә: { Чыгыш яз: [',']. }.
function куллан: 1 һәм: 2.
