

Тезмә килгәндә: ['column:'] эшлә: { :column
	>> result := Тезмә яңа.
	үзе һәрбер: { :index :row
		row һәрбер: { :index :cell
			(index = column) дөрес: { result ахырга-өстә: cell. }.
		}.
	}. <- result.
}.


>> a := Тезмә ←
	(Тезмә ← 1 ; 2 ; 3) ;
	(Тезмә ← 4 ; 5 ; 6) ;
	(Тезмә ← 7 ; 8 ; 9).

>> b := a column: 1.
Чыгыш яз: b, яңа-юл.

b := a column: 20.
Чыгыш яз: b, яңа-юл.

b := a column: -100.
Чыгыш яз: b, яңа-юл.
