



>> CoffeeGrounds := Объект яңа.
CoffeeGrounds килгәндә: ['extract'] эшлә: { <- ['coffee']. }.

>> CoffeeMachine := Объект яңа.
CoffeeMachine килгәндә: ['init'] эшлә: {
	үзенең coffeegrounds := CoffeeGrounds яңа.
}.
CoffeeMachine килгәндә: ['яңа'] эшлә: { <- CoffeeMachine `new init.
}.

CoffeeMachine килгәндә: ['makeTea'] эшлә: { <- (үзенең tealeaves extract). }.
CoffeeMachine килгәндә: ['makeCoffee'] эшлә: { <- (үзенең coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine яңа.

Чыгыш яз:
	coffeeDream 
	makeCoffee.

Чыгыш яз:
	coffeeDream 
	makeTea.
