60 × {
	>> x := (Сан random % 6) + 1.
	(x ≤ 6) ялган: { Чыгыш яз: ['FAIL']. }.
	(x ≥0) ялган: { Чыгыш яз: ['FAIL']. }.
	x := (Сан random % 3) + 1.
	(x < 3) ялган: { Чыгыш яз: ['FAIL']. }.
	(x>-1) ялган: { Чыгыш яз: ['FAIL']. }.
	x := ((Логик flip) сан).
	(x = 0 яки: x = 1) ялган: { Чыгыш яз: ['FAIL']. }.
	x := ((Дөрес flip) сан).
	(x = 0 яки: x = 1) ялган: { Чыгыш яз: ['FAIL']. }.
	x := (Логик flip бу: ['HEAD'] яки-теге: ['TAIL']).
	((x = ['HEAD']) яки: (x = ['TAIL'])) ялган: { Чыгыш яз: ['FAIL']. }.
}.
Чыгыш яз: ['DONE'].

