# catch-all test (practical)
>> HTML := Текст яңа.
HTML килгәндә: ['encode:'] эшлә: { :tekst
	үзе ахырга-өстә: (tekst
	алыштыр: ['&'] белән: ['&amp;'], 
	алыштыр: ['<'] белән: ['&lt;'],
	алыштыр: ['>'] белән: ['&gt;'],
	алыштыр: ['"'] белән: ['&quot;']).
}.
>> blog := HTML яңа.
blog ахырга-өстә: ['<h1>'],
     encode: ['Koffie & Thee'],
     ахырга-өстә: ['</h1>'].
Чыгыш яз: blog, яңа-юл.


>> Roman := Сан яңа.
Roman килгәндә: ['stringy'] эшлә: {
	>> a := [''].
	{ a ахырга-өстә: ['I']. } × үзе. <- a.
}.

>> x := Roman яңа.
x өстә: 3.
Чыгыш яз: x stringy, яңа-юл.

>> Quantum := Логик яңа.
Quantum килгәндә: ['true?'] эшлә: { <- ['maybe True']. }.
Чыгыш яз: (Quantum яңа true?), яңа-юл.

>> Nihil := Буш яңа.
Nihil килгәндә: ['текст'] эшлә: { <- ['Nihil']. }.
Чыгыш яз: (Nihil яңа), яңа-юл.
