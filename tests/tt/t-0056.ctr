>> z := Объект яңа.
z килгәндә: ['value:'] эшлә: { :v
	үзенең value := v. <- үзе.
}.
z килгәндә: ['value'] эшлә: { <- үзенең value. }.
(z setValue: 1) value: 2.
Чыгыш яз: z value.
>> x := z.
Чыгыш яз: x value.
z := Буш.
Чыгыш яз: z value.
Чыгыш яз: x value.
Чыгыш яз: ['hello'].
Чыгыш яз: 3 + 2.
Чыгыш яз: (3 > 2).
