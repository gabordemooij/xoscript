
Программа хәтер-идарәсе: 4.

>> Animal := Объект яңа.
Animal килгәндә: ['make'] эшлә: {
	>> animal := Объект яңа.
	animal килгәндә: ['makeSound'] эшлә: {
		Чыгыш яз: үзенең sound.
	}. <- animal.
}.
>> Cat := Объект яңа.
Cat килгәндә: ['make'] эшлә: {
	>> cat := Animal make.
	cat килгәндә: ['init'] эшлә: {
		үзенең sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
