>> Greeter := Объект яңа.
Greeter килгәндә: ['make'] эшлә: {
	>> gr := Объект яңа.
	gr килгәндә: ['setName:'] эшлә: { :aname
		үзенең исем := aname.
	}.
	gr килгәндә: ['greet'] эшлә: {
		Чыгыш яз: үзенең исем.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a яңа.
c setName: ['THREE'].
c greet.
>> d := a яңа.
d setName: ['FOUR'].
d greet.
c greet.
