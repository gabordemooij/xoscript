Чыгыш яз: ['Test object'], яңа-юл.
>> a := Объект яңа. 

a килгәндә: ['item:'] эшлә: { :hexhelper
	үзенең hexhelper := hexhelper. 
}.

a килгәндә: ['item'] эшлә: { <- үзенең hexhelper.
}.

a item: Hx яңа.

>> old-hexhelper-address := a item прототип хәтер-адресы.
a save-as: ['/tmp/a.bin'].
Чыгыш яз: ['========== RELOADING SNAP:'], яңа-юл.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип хәтер-адресы = old-hexhelper-address) дөрес: {
	Чыгыш яз: ['Object link re-attached.'], яңа-юл.
}.
