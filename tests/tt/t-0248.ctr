

Текст килгәндә: ['evaluate'] эшлә: {
	>> код := Файл яңа: ['/tmp/eval.ctr'].
	код яз: үзе текст + ['.'].
	Программа файдалан: ['/tmp/eval.ctr'].
}.

>> a := (Тезмә ← (
	(Сүзлек яңа)
		куй: ['domain'] ачкыч: ['mywebsite.com'],
		куй: (Тезмә ←
			((Сүзлек яңа)
				куй: ['home'] ачкыч: ['title'],
				куй: ['<html></html>'] ачкыч: ['body'],
				куй: ['2017-01-01'] ачкыч: ['created']
			) ;
			((Сүзлек яңа)
				куй: ['aboutus(c)'] ачкыч: ['title'],
				куй: ['<credits>Author Inc.</credits>'] ачкыч: ['body']
			)
		) ачкыч: ['pages']
	)
) текст.

Чыгыш яз: a төр, яңа-юл.
Чыгыш яз: a, яңа-юл.

>> b := Буш.
(['b := '] + a) evaluate.
Чыгыш яз: b ? 0 ? ['pages'] ? 1 ? ['body'], яңа-юл.

>> c := b ? 0.
>> d := c текст.
Чыгыш яз: d төр, яңа-юл.

>> e := Буш.
(['e := '] + d) evaluate.
Чыгыш яз: e ? ['pages'] ? 0, яңа-юл.
