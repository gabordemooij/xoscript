Server init.
>> fmt := Формат яңа: ['%#3x'].

>> blob := Blob яңа: 4.
blob bytes: ( 
	Тезмә яңа ; 0 ; 1 ; 2 ; 3
).

>> file := Файл яңа: ['/tmp/blob'].
file blob: blob.
blob бушат.

>> укы := file blob.
укы 
башлап: 0 
озынлык: 4, 
эшлә һәрбер: { :i :b 
	Чыгыш
	яз: (fmt куллан-бөтен: b),
	яңа-юл.
}.
укы бушат.
