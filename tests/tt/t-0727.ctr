Server init.
>> f := Формат яңа: ['%d'].
>> a := Blob яңа: 4.
a bytes: ( Тезмә яңа ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob яңа: 4.
b bytes: ( Тезмә яңа ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a башлап: 0 озынлык: 3, һәрбер: { :i :byte
	Чыгыш яз: ( f куллан-бөтен: byte ), яңа-юл.
}.
a ^ b.
a башлап: 0 озынлык: 3, һәрбер: { :i :byte
	Чыгыш яз: ( f куллан-бөтен: byte ), яңа-юл.
}.
a ^ b.
a башлап: 0 озынлык: 3, һәрбер: { :i :byte
	Чыгыш яз: ( f куллан-бөтен: byte ), яңа-юл.
}.
a бушат.
b бушат.

{ a ^ Объект. } тот: { :e Чыгыш яз: e, яңа-юл. }, җибәр.
