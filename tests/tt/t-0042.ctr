>> items := Сүзлек яңа.
items куй: ['black'] ачкыч: ['coffee'], куй: ['earl grey'] ачкыч: ['tea'].
Чыгыш яз: (items урында: ['coffee']), яз: (items урында: ['tea']).
Чыгыш яз: ['there are'] + items саны + [' items in the array.'].
items куй: ['capuccino'] ачкыч: ['coffee'].
Чыгыш яз: ['Now my coffee is.. '] + (items урында: ['coffee']).
items куй: ['aaa'] ачкыч: ['1'].
items куй: ['bbb'] ачкыч: ['2'].
Чыгыш яз: (items урында: ['a']).
