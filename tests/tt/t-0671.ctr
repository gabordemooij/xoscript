# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Сейф ачкычлар-ясау.

# private (secret) key
>> sk := keys беренче.

# public key
>> pk := keys соңгы.

# sign a message
>> sig := Сейф имза: ['abc'] ачкыч-белән: sk.

# check message (ok)
Чыгыш яз: ( 
	Сейф
		тикшер: ['abc'] 
		имза: sig 
		ачкыч-белән: pk 
), яңа-юл.

# check message (fail)
Чыгыш яз: ( 
	Сейф 
		тикшер: ['abd'] 
		имза: sig 
		ачкыч-белән: pk 
), яңа-юл.