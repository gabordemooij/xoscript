


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Программа хәтер-идарәсе: 0.
>> palette := Буш.
>> colors := Буш.

{
palette := Сүзлек яңа.
palette 
	куй: ['#F00'] ачкыч: ['red'],
	куй: ['#0F0'] ачкыч: ['green'],
	куй: ['#00F'] ачкыч: ['blue'].
Чыгыш яз: ['number of RGB codes in palette: '] + ( palette саны ), яңа-юл.
Чыгыш яз: ['RGB code of green is: '] + ( palette ? ['green'] ), яңа-юл.
colors := [''].
( palette һәрбер: { :исем :код
		colors := colors + ( исем + [':'] + код ).
} ).
Чыгыш яз: ['All colors in palette: '] + colors, яңа-юл.
} җибәр.
Программа чистарт.
usedMemory1 := (Программа хәтер ? 0).

{
palette := Сүзлек яңа.
palette 
	куй: ['#F00'] ачкыч: ['red'],
	куй: ['#0F0'] ачкыч: ['green'],
