# compliance test

# use international numbers

Чыгыш яз: ['1000 -> '].
Чыгыш яз: 1000, яңа-юл. #1000

Чыгыш яз: ['1.5 -> '].
Чыгыш яз: 1.5, яңа-юл.  #1.5

Чыгыш яз: ['1001.5 -> '].
Чыгыш яз: 1.5 + 1000, яңа-юл. #1001.5

# use 0-indexed arrays
>> x := Тезмә яңа ; 1 ; 2 ; 3.
>> y := Тезмә яңа ; ['a'] ; ['b'] ; ['c'].

Чыгыш яз: ['1 -> '].
Чыгыш яз: x ? 0, яңа-юл. #1

Чыгыш яз: ['1 -> '].
Чыгыш яз: (x урында: 0), яңа-юл. #1

Чыгыш яз: ['1 -> '].
Чыгыш яз: x беренче, яңа-юл. #1

Чыгыш яз: ['3 -> '].
Чыгыш яз: x соңгы, яңа-юл. #3

Чыгыш яз: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Чыгыш яз: (x буенча: y), яңа-юл.

Чыгыш яз: ['1 -> '].
Чыгыш яз: (x башлап: 0 озынлык: 1) беренче, яңа-юл. #1

Чыгыш яз: ['0 -> '].
Чыгыш яз: (x табу: 1), яңа-юл. #0

x куй: 9 ачкыч: 0.

Чыгыш яз: ['9 -> '].
Чыгыш яз: (x урында: 0), яңа-юл. #9

x башка-өстә: 8.
Чыгыш яз: ['8 -> '].
Чыгыш яз: (x урында: 0), яңа-юл. #9


x ахырга-өстә: 10.
Чыгыш яз: ['10 -> '].
Чыгыш яз: (x урында: 4), яңа-юл. #10








