>> invoice := Объект яңа.
invoice килгәндә: ['җибәр'] эшлә: {
        үзенең сан := 0.
}.

invoice килгәндә: ['сан'] эшлә: {
        үзенең сан өстә: 1. <- үзенең сан күчермә.
}.

>> year-invoice := invoice яңа.
year-invoice килгәндә: ['start:'] эшлә: { :ел
	үзенең сан := ел.
}.

year-invoice start: 202000.
Чыгыш яз: year-invoice сан, яңа-юл.
Чыгыш яз: year-invoice сан, яңа-юл.
