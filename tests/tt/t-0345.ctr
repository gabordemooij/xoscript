# test catch-all methods
>> x13 := Объект яңа.
x13 килгәндә: ['a'] эшлә: { :a Чыгыш яз: 0, яңа-юл. }.
x13 килгәндә: ['a:'] эшлә: { :a Чыгыш яз: a, яңа-юл. <- 5. }.
x13 килгәндә: ['a:b:'] эшлә: { :a :b Чыгыш яз: (a + b), яңа-юл. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
