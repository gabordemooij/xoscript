

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Программа хәтер-идарәсе: 0.

Сан килгәндә: ['addNum:'] эшлә: { :x
	үзе өстә: x.
}.

Сан килгәндә: ['subtractNum:'] эшлә: { :x
	үзе ал: x.
}.

Сан килгәндә: ['multiplyBy:'] эшлә: { :x
	үзе тапкырла: x.
}.

Сан килгәндә: ['divideBy:'] эшлә: { :x
	үзе бүл-санга: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 дәрәҗә: 8).  
a := a + (2 дәрәҗә: -1). 
a := a + (49 квадрат-тамыр).   
a addNum: ((Тезмә ← 0 ; 1) максимум).          
a addNum: ((Тезмә ← 2 ; 3) минимум).
Чыгыш яз: a.

Программа чистарт.

usedMemory1 := (Программа хәтер ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 дәрәҗә: 8).  
a := a + (2 дәрәҗә: -1). 
a := a + (49 квадрат-тамыр).   
a addNum: ((Тезмә ← 0 ; 1) максимум).          
a addNum: ((Тезмә ← 2 ; 3) минимум).
Чыгыш яз: a.

Программа чистарт.
usedMemory2 := (Программа хәтер ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 дәрәҗә: 8).  
a := a + (2 дәрәҗә: -1). 
a := a + (49 квадрат-тамыр).   
a addNum: ((Тезмә ← 0 ; 1) максимум).          
a addNum: ((Тезмә ← 2 ; 3) минимум).
Чыгыш яз: a.

Программа чистарт.
usedMemory3 := (Программа хәтер ? 0).



( usedMemory1 = usedMemory2 һәм: usedMemory1 = usedMemory3, һәм: usedMemory2 = usedMemory3 ) дөрес: {
	Чыгыш яз: ['No memory leaks here'].
}, ялган: {
	Чыгыш яз: ['Leaking memory...'].
}.
