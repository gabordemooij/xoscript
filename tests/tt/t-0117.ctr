>> t := Дөрес.
(t = Дөрес) дөрес: { Чыгыш яз: ['T']. }.
(t = Ялган) дөрес: { Чыгыш яз: ['F']. }.
Чыгыш яз: ['|'].
>> t := Ялган.
(t = Дөрес) дөрес: { Чыгыш яз: ['T']. }.
(t = Ялган) дөрес: { Чыгыш яз: ['F']. }.
Чыгыш яз: ['|'].
>> f := Дөрес.
(t = Дөрес һәм: f = Ялган) дөрес: { Чыгыш яз: ['T']. }.
(t = Ялган һәм: f = Дөрес) дөрес: { Чыгыш яз: ['F']. }.
Чыгыш яз: ['|'].
>> n := Буш.
(n Буш?) дөрес: { Чыгыш яз: ['T']. }.
(n Буш?) ялган: { Чыгыш яз: ['F']. }.
Чыгыш яз: ['|'].
(f Boolean?) дөрес: { Чыгыш яз: ['T']. }.
(f Boolean?) ялган: { Чыгыш яз: ['F']. }.



