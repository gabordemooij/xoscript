#Linux

(Файл яңа: ['/tmp/testje']) бар ялган: {
	Программа система: ['mkdir /tmp/testje'].	
}.

(Файл яңа: ['/tmp/testje/file1']) бар ялган: {
	Программа система: ['touch /tmp/testje/file1'].	
}.

(Файл яңа: ['/tmp/testje/folder1']) бар ялган: {
	Программа система: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Файл исемлек: ['/tmp/testje'].

>> q := Тезмә яңа.

l һәрбер: { :k :v v һәрбер: { :x :y q ахырга-өстә: y. }. }.

>> s := q текст.

(s эченә-ала: ['file1']) дөрес:   { Чыгыш яз: ['OK'], яңа-юл. }.
(s эченә-ала: ['file2']) дөрес:   { Чыгыш яз: ['XX'], яңа-юл. }.
(s эченә-ала: ['folder1']) дөрес: { Чыгыш яз: ['OK'], яңа-юл. }.
