

>> obj := Объект яңа.

obj килгәндә: ['greet'] эшлә: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj килгәндә: ['task'] эшлә: {
	үзенең property := 123.
	{
		# try binds self/own to object instead of block
		Чыгыш яз: үзе greet.
		Чыгыш яз: үзенең property.
		1 / 0.
	} тот: {
		Чыгыш яз: үзе greet.
		Чыгыш яз: үзенең property.
		Чыгыш яз: ['ok'].
	}, тырышу.
}.

obj task.