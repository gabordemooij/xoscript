Сан килгәндә: ['factorial'] эшлә: {
	>> total := 1.
	{ :index total тапкырла: (үзе - (index)). } × үзе. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Чыгыш яз: a.
>> b := 2 + 3 factorial.
Чыгыш яз: b.
>> c := 3 factorial + 2.
Чыгыш яз: c.
>> d := 2 + (3 factorial).
Чыгыш яз: d.
Чыгыш яз: 2 + 3 factorial + 1.
