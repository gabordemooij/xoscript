Сан килгәндә: ['factorial'] эшлә: {
	>> total := 1.
	{ :index total тапкырла: (үзе - (index)). } × үзе. <- total.
}.
>> Printer := Объект яңа.
Printer килгәндә: ['print:and:'] эшлә: { :x :y
	Чыгыш яз: ['a='] + x + [', b='] + y, яңа-юл.
}.
>> a := 4.5. >> b := a аска-түгәрәкләү.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a өскә-түгәрәкләү.
Printer print: a and: b.
a := 4.5. b := a аска-түгәрәкләү.
Printer print: a and: b.
a := 4.5. b := a түгәрәкләү.
Printer print: a and: b.
a := 4.2. b := a түгәрәкләү.
Printer print: a and: b.

