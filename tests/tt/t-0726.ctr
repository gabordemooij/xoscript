# test buffers PKI/Sign 
Server init.

>> long := ( Тезмә яңа тутыру: 1000 белән: ['a'] ) берләштер: [''].

# sign a message
Чыгыш яз: ( 
	Сейф имза: ['abc'] ачкыч-белән: long
), яңа-юл.

Чыгыш яз: ( 
	Сейф
		тикшер: ['abc'] 
		имза: long 
		ачкыч-белән: long
), яңа-юл.

Чыгыш яз: (
	Сейф серсүз-хэшы: long тикшер: long
), яңа-юл.
