# a value ending in the first part of an opening quote must survive serialization
>> кыйммәтләр := Тезмә яңа
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

кыйммәтләр һәрбер: { :i :value
	>> d := Сүзлек яңа.
	d куй: value ачкыч: ['k'].
	d куй: ['second'] ачкыч: ['j'].
	>> r := d код объект.
	Чыгыш яз: r саны, яңа-юл.
	Чыгыш яз: ( (r урында: ['k']) = value ), яңа-юл.
}.
