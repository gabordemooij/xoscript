Чыгыш яз: ['Continue for-loop, No - before 6 and up.'], яңа-юл.
{ :i
	Чыгыш яз: (i + 1), яңа-юл.
	((i + 1) > 4) дәвам.
	Чыгыш яз: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Чыгыш яңа-юл.
Чыгыш яз: ['Continue while-true, No --> before 5 and up.'], яңа-юл.
{
	Чыгыш яз: ['iteration #'] + x, яңа-юл.
	x өстә: 1.
	((x < 5) түгел) дәвам.
	Чыгыш яз: ['-->'].
} әлегә: xIsLessThan10.
Чыгыш яңа-юл.
Чыгыш яз: ['Continue while-false, No - before 3 only.'], яңа-юл.
{
	Чыгыш яз: ['iteration #'] + x, яңа-юл.
	x ал: 1.
	(x = 3) дәвам.
	Чыгыш яз: ['-'].
} әлегә: { <- ( x > 0). }.

Чыгыш яңа-юл.
Чыгыш яз: ['Continue times-loop, No ||| before 3.'], яңа-юл.
{ :i
	Чыгыш яз: ['iteration #'] + i, яңа-юл.
	(i = 2) дәвам.
	Чыгыш яз: ['|||'].
} × 5.

Чыгыш яңа-юл.

{ Дөрес дәвам. Чыгыш яз: ['dont write this!'], яңа-юл. } җибәр.

{ Дөрес дәвам. Чыгыш яз: ['dont write this!'], яңа-юл. } тот: { Чыгыш яз: ['Dont catch this!']. }, җибәр.

Чыгыш яз: ['Test Array each-loop: 0, ... ,2'], яңа-юл.
(Тезмә ← 1 ; 2 ; 3) үзгәрт: { :i
	(i = 1) дәвам.
	Чыгыш яз: ['iteration #'] + (i - 0), яңа-юл.
}.

Чыгыш яз: ['Test Map each-loop: c only'], яңа-юл.
>> m := Сүзлек яңа.
m куй: ['first'] ачкыч: ['a'], куй: ['second'] ачкыч: ['b'], куй: ['third'] ачкыч: ['c'].
m һәрбер: { :k :v
	(k ≠ ['c']) дәвам.
	Чыгыш яз: ['iteration'] + k + v, яңа-юл.
}.

