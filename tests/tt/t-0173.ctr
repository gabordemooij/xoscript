

Тезмә килгәндә: ['sum'] эшлә: {
	>> total := 0.
	үзе һәрбер: { :index :element
		total өстә: element.
	}. <- total.
}.

Тезмә килгәндә: ['product'] эшлә: {
	>> total := 1.
	үзе һәрбер: { :index :element
		total тапкырла: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Программа хәтер-идарәсе: 0.

{

>> a := Тезмә ← ['hello'] ; ['world'] ; Дөрес ; Буш ; 666.
a := a + ( Тезмә ← 1 ).
Чыгыш яз: ( ['sum: '] + ( a sum ) ), яңа-юл.
Чыгыш яз: ( ['min: '] + ( a минимум ) ), яңа-юл.
Чыгыш яз: ( ['max: '] + ( a максимум ) ), яңа-юл.
Чыгыш яз: ( ['3rd: '] + ( a ? 2 ) ), яңа-юл.
Чыгыш яз: ( ['prd: '] + ( a product ) ), яңа-юл.
a тәртипкә-сал: { :a :b <- (b - a). }.
a һәрбер: { :i :e Чыгыш яз: ( i - 0 ), яңа-юл. }.

} җибәр.

Программа чистарт.
usedMemory1 := (Программа хәтер ? 0).


{

>> a := Тезмә ← ['hello'] ; ['world'] ; Дөрес ; Буш ; 666.
a := a + ( Тезмә ← 1 ).
Чыгыш яз: ( ['sum: '] + ( a sum ) ), яңа-юл.
Чыгыш яз: ( ['min: '] + ( a минимум ) ), яңа-юл.
Чыгыш яз: ( ['max: '] + ( a максимум ) ), яңа-юл.
Чыгыш яз: ( ['3rd: '] + ( a ? 2 ) ), яңа-юл.
Чыгыш яз: ( ['prd: '] + ( a product ) ), яңа-юл.
a тәртипкә-сал: { :a :b <- (b - a). }.
a һәрбер: { :i :e Чыгыш яз: ( i - 0 ), яңа-юл. }.

} җибәр.



Программа чистарт.
usedMemory2 := (Программа хәтер ? 0).


{

>> a := Тезмә ← ['hello'] ; ['world'] ; Дөрес ; Буш ; 666.
a := a + ( Тезмә ← 1 ).
Чыгыш яз: ( ['sum: '] + ( a sum ) ), яңа-юл.
Чыгыш яз: ( ['min: '] + ( a минимум ) ), яңа-юл.
Чыгыш яз: ( ['max: '] + ( a максимум ) ), яңа-юл.
Чыгыш яз: ( ['3rd: '] + ( a ? 2 ) ), яңа-юл.
Чыгыш яз: ( ['prd: '] + ( a product ) ), яңа-юл.
a тәртипкә-сал: { :a :b <- (b - a). }.
a һәрбер: { :i :e Чыгыш яз: ( i - 0 ), яңа-юл. }.

} җибәр.



Программа чистарт.
usedMemory3 := (Программа хәтер ? 0).

( usedMemory1 = usedMemory2 һәм: usedMemory1 = usedMemory3, һәм: usedMemory2 = usedMemory3 ) дөрес: {
	Чыгыш яз: ['No memory leaks here'].
}, ялган: {
	Чыгыш яз: ['Leaking memory...'].
}.
