#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Үрнәк яңа: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern туры-килү: subject эшлә: { :m :x
	Чыгыш яз: m, яңа-юл.
	Чыгыш яз: x, яңа-юл. <- ['XXX'].
}.
Чыгыш яз: result, яңа-юл.