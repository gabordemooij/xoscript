


>> Deck := Тезмә яңа.
Deck килгәндә: ['print'] эшлә: {
        >> len := үзе саны - 1.
        { :i
                >> len2 := үзе саны - 1.
                Чыгыш яз: ['len: '].
                Чыгыш яз: len, яңа-юл.
                Чыгыш яз: ['len2: '].
                Чыгыш яз: len2, яңа-юл.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
