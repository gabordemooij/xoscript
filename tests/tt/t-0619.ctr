>> HTML := Объект яңа.
HTML килгәндә: ['җавап-бир:'] эшлә: { :tag 
	Чыгыш яз: (['<tag>'] tag: tag), яңа-юл.
}.
HTML килгәндә: ['җавап-бир:һәм:'] эшлә: { :tag :html 
	Чыгыш яз: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), яңа-юл.
}.
>> html := HTML яңа.
html body h1: ['header'].

