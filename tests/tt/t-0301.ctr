


>> wine := Объект яңа.


wine килгәндә: ['toString'] эшлә: { <- ['merlot'].
}.

wine килгәндә: ['naarTekst'] эшлә: { <- ['merlot'].
}.


wine килгәндә: ['='] эшлә: { :other wine <- ( үзе toString = other wine ).
}.

wine килгәндә: ['=='] эшлә: { :other wine <- ( үзе toString = other wine ).
}.



wine
	очрак: ['cabernet'] эшлә: { Чыгыш яз: ['it's a Cabernet!']. },
	очрак: ['syrah']    эшлә: { Чыгыш яз: ['it's a Syrah!'].    },
	очрак: ['merlot']   эшлә: { Чыгыш яз: ['it's a Merlot!'].   },
	очрак: ['malbec']   эшлә: { Чыгыш яз: ['it's a Malbec!'].   }.

Чыгыш яңа-юл.
