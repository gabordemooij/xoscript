{
	бу-бирем хата: ['Dont fail.'].
	unknown doSomething.
} тот: {
	Чыгыш яз: ['Caught!'].
}, җибәр.

{
	бу-бирем хата: ['Dont fail.'].
	үзенең unknown doSomething.
} тот: {
	Чыгыш яз: ['Caught!'].
}, җибәр.

{
	бу-бирем хата: ['Dont fail.'].
	unknown := 122.
} тот: {
	Чыгыш яз: ['Caught!'].
}, җибәр.


{
	бу-бирем хата: ['Dont fail.'].
	Дөрес өз.
	Чыгыш яз: ['FAIL'].
} тот: {
	Чыгыш яз: ['Caught!'].
}, җибәр.

{
	{
		бу-бирем хата: ['Dont fail.'].
		Дөрес өз.
		Чыгыш яз: ['FAIL'].
	} тот: { :x
		(x = ['Dont fail.']) дөрес: { бу-бирем хата: ['Nested Caught!']. }.
	}, җибәр.
} тот: { :e
	Чыгыш яз: e.
}, җибәр.
