
Server init.
Чыгыш яз: ['Database test'], яңа-юл.

>> db := Maria-DB яңа хост: ['localhost'],
	кулланучы-исеме: ['xo'], 
	серсүз: ['pass123'],
	база-исеме: ['xobase'],
	тоташ.

>> эзләү-параметрлары :=
db сорау: ['SELECT UNHEX('CAFE') AS blobby'],
алып-кил: { :row
	Чыгыш яз: ( row blobby башлап: 0 озынлык: 2 ), яңа-юл.
	row blobby бушат.
}.
