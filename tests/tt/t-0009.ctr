>> Greeter := Объект яңа.
Greeter килгәндә: ['make'] эшлә: {
	>> greeter := Объект яңа.
	greeter килгәндә: ['name:'] эшлә: { :исем
		Чыгыш яз: ['setting a name'].
		үзенең myName := исем.
	}.
	greeter килгәндә: ['performGreeting'] эшлә: {
		Чыгыш яз: ['Hello'].
		Чыгыш яз: үзенең myName.
	}.
	greeter килгәндә: ['greet'] эшлә: {
		үзе performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
