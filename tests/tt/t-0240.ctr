# test qualifiers

>> $ := Объект яңа.

$ килгәндә: ['җавап-бир:'] эшлә: { :x
	
	>> operation := x символ: 0.
	>> valuta := x символ: 1.
	>> money := x күчер: 2.
	
	>> amount := 0.

	( operation = ['+'] ) дөрес: {
		( valuta = ['£'] ) дөрес: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Чыгыш яз: x, яңа-юл.


>> Fruit := Объект яңа.

Fruit килгәндә: ['яңа'] эшлә: {
	>> f := үзе яңа.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit килгәндә: ['apples:'] эшлә: { :a үзенең apples := a. }.
Fruit килгәндә: ['oranges:'] эшлә: { :p үзенең oranges := p. }.
Fruit килгәндә: ['apples'] эшлә: { <- үзенең apples. }.
Fruit килгәндә: ['oranges'] эшлә: { <- үзенең oranges. }.

Fruit килгәндә: ['+'] эшлә: { :f
	
	>> n := Fruit яңа.
	f өстә: 1.
	
	n apples: (f apples + үзенең apples).
	n oranges:  (f oranges  + үзенең oranges). <- n.
}.

Fruit килгәндә: ['текст'] эшлә: { <- ( үзенең apples текст + [' apples and '] + үзенең oranges + [' oranges'] ).
}.

Сан килгәндә: ['apples'] эшлә: { <- ((Fruit яңа) apples: үзе).
}.

Сан килгәндә: ['apple'] эшлә: { <- ((Fruit яңа) apples: үзе).
}.

Сан килгәндә: ['oranges'] эшлә: { <- ((Fruit яңа) oranges: үзе).
}.




Чыгыш яз: (1 apple + 3 oranges + 4 apples), яңа-юл.


Текст килгәндә: ['twice'] эшлә: { <- ((үзе текст) + (үзе текст)).
}.



Чыгыш яз: ['❤❤❤'] twice.



