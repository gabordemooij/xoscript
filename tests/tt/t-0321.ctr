# test qualifiers

Программа чистарт.

>> Fruit := Объект яңа.
Fruit килгәндә: ['яңа'] эшлә: {
	>> f := үзе яңа.
	f apples: 0. <- f.
}.
Fruit килгәндә: ['apples:'] эшлә: { :a үзенең apples := a. }.
Fruit килгәндә: ['apples'] эшлә: { <- үзенең apples. }.
Fruit килгәндә: ['+'] эшлә: { :f
	>> n := Fruit яңа.
	n apples: (f apples + үзенең apples). <- n.
}.
Сан килгәндә: ['apples'] эшлә: { <- ((Fruit яңа) apples: үзе).
}.

Fruit килгәндә: ['текст'] эшлә: { <- үзенең apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Чыгыш яз: q, яңа-юл.




q := 3 apples + 4 apples.
Чыгыш яз: q, яңа-юл.



q := 3 apples + 4 apples.
Чыгыш яз: q, яңа-юл.


