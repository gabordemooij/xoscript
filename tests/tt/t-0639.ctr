
Server init.
Чыгыш яз: ['Database test'], яңа-юл.

>> db := Maria-DB яңа хост: ['localhost'],
	кулланучы-исеме: ['xo'], 
	серсүз: ['pass123'],
	база-исеме: ['xobase'],
	тоташ.

>> эзләү-параметрлары :=
db сорау: ['SELECT REPEAT('Blah',1000) AS blah'], 
алып-кил: { :row 
	Чыгыш яз: row blah озынлык, яңа-юл.
}.
