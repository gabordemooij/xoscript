Server init.

>> DB := Maria-DB яңа хост: ['localhost'],
	кулланучы-исеме: ['xo'],
	серсүз: ['pass123'],
	база-исеме: ['xobase'],
	тоташ.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> эзләү-параметрлары := Maria-Сорау яңа: SQL.

# set database
эзләү-параметрлары мәгълүмат-базасы: DB.

эзләү-параметрлары алып-кил: { :row
	Чыгыш яз: row world, яңа-юл.
}.
