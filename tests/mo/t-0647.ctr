Server init.
Ieșire scrie: ['Database time test'], rând-nou.

>> db := Maria-DB nou gazdă: ['localhost'],
	utilizator: ['xo'], 
	parolă: ['pass123'],
	nume-bază: ['xobase'],
	conectează.

>> parametri-căutare :=
db interogare: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
preia: { :row
	Ieșire scrie: row timetest, rând-nou.
}.
