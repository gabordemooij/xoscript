>> Animal := Obiect nou.
Animal la: ['creează'] execută: {
	>> animal := Obiect nou.
	animal la: ['scoateSunet'] execută: {
		Ieșire scrie: propriu sunet.
	}. <- animal.
}.
>> Pisică := Obiect nou.
Pisică la: ['creează'] execută: {
	>> pisică := Animal creează.
	pisică la: ['init'] execută: {
		propriu sunet := ['meow!'].
	}.
	pisică init. <- pisică.
}.
>> tom := Pisică creează.
tom scoateSunet.
