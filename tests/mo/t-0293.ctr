
>> city := Listă ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Listă ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature după: city.
>> cities := weather intrări sortează: { :a :b <- (a compară: b). }.
>> temperatures := weather valori sortează: { :a :b <- (a compară: b) negativ?. }.

Ieșire scrie: (cities unește: [',']), rând-nou.
Ieșire scrie: (temperatures unește: [',']), rând-nou.
