
>> oraș := Listă ← ['Londra'] ; ['Paris'] ; ['Berlin'].
>> temperatură := Listă ← ['15'] ; ['16'] ; ['15'].
>> vreme := temperatură după: oraș.
>> orașe := vreme intrări sortează: { :a :b <- (a compară: b). }.
>> temperaturi := vreme valori sortează: { :a :b <- (a compară: b) negativ?. }.

Ieșire scrie: (orașe unește: [',']), rând-nou.
Ieșire scrie: (temperaturi unește: [',']), rând-nou.
