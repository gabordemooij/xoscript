

>> g  := Server nou.
>> v  := Seif nou.
>> ok := 0.

>> secrete := Listă nou ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> parole := secrete copiază.
parole fiecare: { :i :p
	secrete fiecare: { :n :s
		{
			>> criptat := v criptează: s cheie: p.
			>> decriptat := v decriptează: criptat cheie: p.
			(decriptat = s) adevărat: {
				ok adaugă: 1.
			}, altfel: {
				Ieșire scrie: ['criptarea/decriptarea a eșuat: '], rând-nou.
				Ieșire scrie: s, rând-nou.
				Ieșire scrie: ['criptat: '] + criptat, rând-nou.
				Ieșire scrie: ['decriptat: '] + criptat, rând-nou.
				Program sfârșit.
			}.
		} prinde: { :er
			(s = [''] sau: p = ['']) adevărat: {
				ok adaugă: 1.
			}, altfel: {
				Ieșire scrie: er, rând-nou.
				Program sfârșit.
			}.
		}, pornește.
	}.
}.

Ieșire scrie: ( ok + [' criptări de seif testate.'] ), rând-nou.