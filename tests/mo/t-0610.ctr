
>> Rectangle := Obiect nou.

Rectangle la: ['area'] execută: { <- propriu lungime * propriu width.
}.

Rectangle la: ['length:'] execută: { :lungime
	propriu lungime := lungime.
}.

Rectangle la: ['width:'] execută: { :width
	propriu width := width.
}.

Rectangle la: ['nou'] execută: {
	# this will not result into an infinite loop
	>> rectangle := sine nou.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle nou.
Ieșire scrie: a area, rând-nou. #0

>> b := Rectangle nou length: 2, width: 3.
Ieșire scrie: b area, rând-nou. #6

