
>> Dreptunghi := Obiect nou.

Dreptunghi la: ['arie'] execută: {
	<- propriu lungime * propriu lățime.
}.

Dreptunghi la: ['length:'] execută: { :lungime
	propriu lungime := lungime.
}.

Dreptunghi la: ['width:'] execută: { :lățime
	propriu lățime := lățime.
}.

Dreptunghi la: ['nou'] execută: {
	# aceasta nu va duce la o buclă infinită
	>> dreptunghi := sine nou.
	dreptunghi length: 0, width: 0.
	<- dreptunghi.
}.

>> a := Dreptunghi nou.
Ieșire scrie: a arie, rând-nou. #0

>> b := Dreptunghi nou length: 2, width: 3.
Ieșire scrie: b arie, rând-nou. #6

