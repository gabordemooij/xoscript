Număr la: ['roman'] execută: {
	>> număr := sine copiază.
	>> roman := [''].
	{
		{
			(număr ≥ 1000) adevărat: {
				roman adaugă-la-sfârșit: ['Ⅿ'].
				număr scade: 1000.
			}, întrerupe.
		
			(număr ≥ 500) adevărat: {
				roman adaugă-la-sfârșit: ['Ⅾ'].
				număr scade: 500.
			}, întrerupe.
		
			(număr ≥ 100) adevărat: {
				roman adaugă-la-sfârșit: ['Ⅽ'].
				număr scade: 100.
			}, întrerupe.
		
			(număr ≥ 50) adevărat: {
				roman adaugă-la-sfârșit: ['Ⅼ'].
				număr scade: 50.
			}, întrerupe.
		
			(număr ≥ 50) adevărat: {
				roman adaugă-la-sfârșit: ['Ⅼ'].
				număr scade: 50.
			}, întrerupe.
		
			(număr ≥ 10) adevărat: {
				roman adaugă-la-sfârșit: ['Ⅹ'].
				număr scade: 10.
			}, întrerupe.
			
			(număr ≥ 9) adevărat: {
				roman adaugă-la-sfârșit: ['Ⅸ'].
				număr scade: 9.
			}, întrerupe.
			
			(număr ≥ 5) adevărat: {
				roman adaugă-la-sfârșit: ['Ⅴ'].
				număr scade: 5.
			}, întrerupe.
			
			(număr ≥ 4) adevărat: {
				roman adaugă-la-sfârșit: ['Ⅳ'].
				număr scade: 4.
			}, întrerupe.
			
			(număr ≥ 1) adevărat: {
				roman adaugă-la-sfârșit: ['Ⅰ'].
				număr scade: 1.
			}, întrerupe.
		} procedură.
	} cât-timp: { <- număr > 0. }. <- roman.
}.

Ieșire scrie: 1 roman, rând-nou.
Ieșire scrie: 2 roman, rând-nou.
Ieșire scrie: 4 roman, rând-nou.
Ieșire scrie: 8 roman, rând-nou.
Ieșire scrie: 16 roman, rând-nou.
Ieșire scrie: 32 roman, rând-nou.
Ieșire scrie: 64 roman, rând-nou.
Ieșire scrie: 128 roman, rând-nou.
Ieșire scrie: 256 roman, rând-nou.
Ieșire scrie: 1024 roman, rând-nou.
