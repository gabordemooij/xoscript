
Text la: ['evaluate'] execută: {
	>> cod := Fișier nou: ['/tmp/eval.ctr'].
	cod scrie: (sine text + ['.']).
	Program folosește: ['/tmp/eval.ctr'].
}.

>> map :=
	(Dicționar nou)
	pune: ['Hi There'] la: ['two'],
	pune: (Listă ← ['hello'] ; ['world'] ; (Listă ← 1 ; 2; 9) ; Fals) la: ['one'],
	pune: ( (Dicționar nou) pune: ['wrrld'] la: ['misspelled'] ) la: ['three'],
	pune: (Listă ← ((Dicționar nou) pune: ['treasure'] la: ['hidden']) ; 2) la: ['four']. 
>> str := map text.
>> map2 := Nimic.
(['map2 := '] + str ) evaluate.
Ieșire scrie: map2 ? ['one'] ? 0.
Ieșire scrie: map2 ? ['one'] ? 1.
Ieșire scrie: map2 ? ['four'] ? 0 ? ['hidden'].
Ieșire scrie: map2 ? ['one'] ? 2 ? 2.
