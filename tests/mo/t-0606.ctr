>> Punct := Obiect nou.
Punct la: ['x-coordinate:'] execută: { :x propriu x := x. }.
Punct la: ['y-coordinate:'] execută: { :y propriu y := y. }.
Punct la: ['coordonata-x']  execută: { <- propriu x copiază. }.
Punct la: ['coordonata-y']  execută: { <- propriu y copiază. }.

Punct la: ['='] execută: { :altul
	<- ( propriu x = altul coordonata-x
		 și: propriu y = altul coordonata-y ).
}.

>> debarcader := Punct nou x-coordinate: 5, y-coordinate: 6.
>> primărie := Punct nou x-coordinate: 7, y-coordinate: 1.
>> restaurant := Punct nou x-coordinate: 5, y-coordinate: 6.

Ieșire scrie: debarcader = primărie, rând-nou.
Ieșire scrie: debarcader = restaurant, rând-nou.
