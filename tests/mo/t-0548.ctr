Server init.

>> x := Blob nou: 65 tip: ['char'].
# for this test you need set a path to libc (puts)
>> libname := Program setare: ['FFITESTLIB'].
Server leagă: (
 Listă nou ;
 libname ;
 ['putchar'] ;
 ( Listă nou ; ['char'] ) ;
 ['void'] ;
 ['Print'] ;
 ['char:']
).
Print char: (x de-la: 0 lungime: 1), rând-nou.
x eliberează.

