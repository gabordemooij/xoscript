Server init.

>> x := Blob nou: 65 tip: ['char'].
# pentru acest test trebuie să setați o cale către libc (puts)
>> numeBibl := Program setare: ['FFITESTLIB'].
Server leagă: (
 Listă nou ;
 numeBibl ;
 ['putchar'] ;
 ( Listă nou ; ['char'] ) ;
 ['void'] ;
 ['Print'] ;
 ['char:']
).
Print char: (x de-la: 0 lungime: 1), rând-nou.
x eliberează.

