60 × {
	>> x := (Număr random % 6) + 1.
	(x ≤ 6) fals: { Ieșire scrie: ['FAIL']. }.
	(x ≥0) fals: { Ieșire scrie: ['FAIL']. }.
	x := (Număr random % 3) + 1.
	(x < 3) fals: { Ieșire scrie: ['FAIL']. }.
	(x>-1) fals: { Ieșire scrie: ['FAIL']. }.
	x := ((Boolean flip) număr).
	(x = 0 sau: x = 1) fals: { Ieșire scrie: ['FAIL']. }.
	x := ((Adevărat flip) număr).
	(x = 0 sau: x = 1) fals: { Ieșire scrie: ['FAIL']. }.
	x := (Boolean flip sau: ['HEAD'] sau: ['TAIL']).
	((x = ['HEAD']) sau: (x = ['TAIL'])) fals: { Ieșire scrie: ['FAIL']. }.
}.
Ieșire scrie: ['DONE'].

