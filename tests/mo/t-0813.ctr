# salturile de linie din valori nu trebuie să creeze antete suplimentare
Server inițializează.
Program folosește: ['../../../src/xo/mo/webtools.xo'].
Program folosește: ['../../../src/xo/mo/mailtools.xo'].

>> antet := Antet-HTTP nou cheie: ['Location'] valoare: ['/ok\r\nX-Injected: yes'].
Ieșire scrie: antet.

>> web := Document-Web nou.
web mergi-la: ['/ok\r\nX-Injected: yes'].
Ieșire scrie: ['\n'], rând-nou.

>> poștă := Email nou.
poștă către: (Listă nou ; ['a@example.invalid\r\nX-To: yes']).
poștă cc: (Listă nou ; ['b@example.invalid\r\nX-Cc: yes']).
poștă bcc: (Listă nou ; ['c@example.invalid\r\nX-Bcc: yes']).
poștă expeditor: ['d@example.invalid\r\nX-From: yes'] nume: ['site\r\nX-Name: yes'].
poștă subiect: ['hello\r\nX-Subject: yes'].
poștă corp: ['line1\r\nline2'].
Ieșire scrie: poștă generează.

>> html := Email-HTML nou.
html către: (Listă nou ; ['a@example.invalid\r\nX-To: yes']).
html expeditor: ['d@example.invalid'] nume: ['site'].
html subiect: ['hello\r\nX-Subject: yes'].
html corp: ['body'].
Ieșire scrie: ( html generează conține: ['\nX-'] ), rând-nou.
Ieșire scrie: ( html generează conține: ['X-To: yes'] ), rând-nou.
