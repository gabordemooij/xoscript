Text la: ['html'] execută: { <- (
		sine
		înlocuiește: ['&'] cu: ['&amp;'],
		înlocuiește: ['<'] cu: ['&lt;'],
		înlocuiește: ['>'] cu: ['&gt;'],
		înlocuiește: ['''] cu: ['&apos;'],
		înlocuiește: ['"'] cu: ['&quot;']
	).
}.

>> memorieFolosită1 := 0.
>> memorieFolosită2 := 0.
>> memorieFolosită3 := 0.
>> memorieFolosită4 := 0.

Program gestiune-memorie: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Ieșire scrie: txt copiază html, rând-nou.
Ieșire scrie: txt copiază minuscule, rând-nou.
Ieșire scrie: txt copiază majuscule, rând-nou.
} pornește.

Program curăță.

memorieFolosită1 := (Program memorie ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Ieșire scrie: txt copiază html, rând-nou.
Ieșire scrie: txt copiază minuscule, rând-nou.
Ieșire scrie: txt copiază majuscule, rând-nou.
} pornește.

Program curăță.
memorieFolosită2 := (Program memorie ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Ieșire scrie: txt copiază html, rând-nou.
Ieșire scrie: txt copiază minuscule, rând-nou.
Ieșire scrie: txt copiază majuscule, rând-nou.
} pornește.

Program curăță.
memorieFolosită3 := (Program memorie ? 0).



( memorieFolosită1 = memorieFolosită2 și: memorieFolosită1 = memorieFolosită3, și: memorieFolosită2 = memorieFolosită3 ) adevărat: {
	Ieșire scrie: ['Nicio scurgere de memorie aici'].
}, fals: {
	Ieșire scrie: ['Memoria se scurge...'].
}.
