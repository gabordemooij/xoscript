# Acest test verifică dacă string_fill_in nu își pierde locul (gc'ed) în modul 4
# referință în world.c
>> Jurnal := Obiect nou.

Jurnal la: ['say:'] execută: { :str
	Ieșire scrie: str, rând-nou.
}.

>> Articol := Obiect nou.

Articol la: ['nou:'] execută: { :id
	<- sine nou id: id.
}.

Articol la: ['id:'] execută: { :id
	propriu id := id.
}.

Articol la: ['id'] execută: { <- propriu id. }.


Articol la: ['text'] execută: {
	>> str := ['Item#~no'].
	str ~no: propriu id.
	<- str.
}.


>> Print := Obiect nou.

Print la: ['items'] execută: { 
	
	propriu articol := Articol nou: 1.
	
	# fie segfault, fie șir greșit aici
	Jurnal say: (
		['~item printed.'] ~item: propriu articol
	).
	
	
}.

Print items.