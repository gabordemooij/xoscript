# un format trebuie să se potrivească tipului valorii, tipul poate veni de la un client
>> încearcă := { :formatul :value
	{ Ieșire scrie: ( (Format nou: formatul) aplică: value ), rând-nou. } prinde: { :e Ieșire scrie: e, rând-nou. }, pornește.
}.
>> încearcă-întreg := { :formatul :value
	{ Ieșire scrie: ( (Format nou: formatul) aplică-întreg: value ), rând-nou. } prinde: { :e Ieșire scrie: e, rând-nou. }, pornește.
}.

# se potrivește
încearcă aplică: ['|%s|'] și: ['text'].
încearcă aplică: ['%06.2f'] și: 5.5.
încearcă aplică: ['100%% %s'] și: ['sigur'].
încearcă-întreg aplică: ['%03d'] și: 7.
încearcă-întreg aplică: ['%x'] și: 255.
încearcă aplică: ['%d'] și: (Int64 nou din-text: ['12']).
încearcă aplică: ['%lld'] și: (Int64 nou din-text: ['12']).
încearcă aplică: ['%.1lf'] și: 5.5.
încearcă-întreg aplică: ['%hd'] și: 7.

# nu se potrivește
încearcă aplică: ['%s'] și: 12345.
încearcă aplică: ['%d'] și: 12345.
încearcă aplică: ['%f'] și: ['text'].
încearcă-întreg aplică: ['%d'] și: ['text'].
încearcă-întreg aplică: ['%s'] și: 5.
încearcă aplică: ['%s %s'] și: ['text'].
încearcă aplică: ['%n'] și: ['text'].
încearcă aplică: ['%*s'] și: ['text'].
încearcă aplică: ['%'] și: ['text'].

# modificatorul de lungime nu se potrivește
încearcă aplică: ['%ls'] și: ['text'].
încearcă aplică: ['%Lf'] și: 5.5.
încearcă-întreg aplică: ['%ld'] și: 7.
încearcă-întreg aplică: ['%lld'] și: 7.
încearcă aplică: ['%Ld'] și: (Int64 nou din-text: ['12']).

# o lățime care nu încape în printf trebuie să dea o eroare, nu un crash
încearcă aplică: ['%99999999999s'] și: ['text'].
