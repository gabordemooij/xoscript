>> z := Obiect nou.
z la: ['value:'] execută: { :v
	propriu value := v. <- sine.
}.
z la: ['value'] execută: { <- propriu value. }.
(z setValue: 1) value: 2.
Ieșire scrie: z value.
>> x := z.
Ieșire scrie: x value.
z := Nimic.
Ieșire scrie: z value.
Ieșire scrie: x value.
Ieșire scrie: ['hello'].
Ieșire scrie: 3 + 2.
Ieșire scrie: (3 > 2).
