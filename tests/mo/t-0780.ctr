Server init.

# Codificatorul JSON acceptă doar UTF-8, fără perechi surogat

>> dicționare := Listă nou ;
	# {"key":"normal"} ASCII normal
	( Dicționar nou pune: ['normal'] la: ['key'] ) ;
	# {"key":"hello world"} caracter spațiu
	( Dicționar nou pune: ['hello world'] la: ['key'] ) ;
	# {"key":"quote: \""} ghilimele duble
	( Dicționar nou pune: ['"'] la: ['key'] ) ;
	# {"key":"backslash: \\"} backslash
	( Dicționar nou pune: ['backslash: \\'] la: ['key'] ) ;
	# {"key":"slash: /"} slash
	( Dicționar nou pune: ['bară: /'] la: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( Dicționar nou pune: ['backspace: \b'] la: ['key'] ) ;
	# {"key":"formfeed: \f"} escape form-feed
	( Dicționar nou pune: ['formfeed: \f'] la: ['key'] ) ;
	# {"key":"newline: \n"} linie nouă
	( Dicționar nou pune: ['newline: \n'] la: ['key'] ) ;
	( Dicționar nou pune: ['newline: ↵'] la: ['key'] ) ;
	( Dicționar nou pune: ['newline: 
	'] la: ['key'] ) ;
	# {"key":"carriage return: \r"} retur de car
	( Dicționar nou pune: ['carriage return: \r'] la: ['key'] ) ;
	# {"key":"tab: \t"} tab
	( Dicționar nou pune: ['tab \t'] la: ['key'] ) ;
	( Dicționar nou pune: ['tab ⇿'] la: ['key'] ) ;
	( Dicționar nou pune: ['tab  '] la: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( Dicționar nou pune: ['NUL \u0000'] la: ['key'] ) ;
	( Dicționar nou pune: ['NUL \0'] la: ['key'] ) ;
	# {"key":"control: \u0001"} caracter de control 0x01
	( Dicționar nou pune: ['control: \u0001'] la: ['key'] ) ;
	# {"key":"control: \u001F"} caracter de control 0x1F
	( Dicționar nou pune: ['control: \u001F'] la: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, caracter de 2 octeți
	( Dicționar nou pune: ['unicode: é'] la: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, caracter de 3 octeți
	( Dicționar nou pune: ['unicode: €'] la: ['key'] ) ;
	# {"key":"unicode: 日本語"} mai multe caractere UTF-8 de 3 octeți
	( Dicționar nou pune: ['unicode: 日本語'] la: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, caracter de 4 octeți
	( Dicționar nou pune: ['unicode: 😀'] la: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	( Dicționar nou pune: ['unicode: 🧑‍💻'] la: ['key'] ) ;
	# {"key":"combining: é"} accent combinat
	( Dicționar nou pune: ['combining: e\u0301'] la: ['key'] ) ;
	# {"key":"escaped unicode: é"} escape Unicode BMP
	( Dicționar nou pune: ['escaped unicode: \u00e9'] la: ['key'] ) ;
	# {"key":"escaped unicode: €"} escape Unicode BMP
	( Dicționar nou pune: ['escaped unicode: \u20ac'] la: ['key'] ) ;
	# {"key":"escaped unicode: 😀"} pereche surogat UTF-16
	( Dicționar nou pune: ['escaped unicode: \ud83d\ude00'] la: ['key'] ) ;
	# {"key":""} valoare goală
	( Dicționar nou pune: [''] la: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} caractere ASCII speciale
	( Dicționar nou pune: ['@ < > & = % + ? #'] la: ['key'] ) ;
	# {"key":"single quote: '"} ghilimele simple
	( Dicționar nou pune: ['''] la: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} mai multe escape-uri JSON
	( Dicționar nou pune: ['multiple: \" \\ \n \r \t'] la: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} text ASCII mai lung
	( Dicționar nou pune: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] la: ['key'] ) ;
	# {"key":" value"} spațiu la început
	( Dicționar nou pune: [' valoare'] la: ['key'] ) ;
	# {"key":"value "} spațiu la sfârșit
	( Dicționar nou pune: ['valoare '] la: ['key'] ) ;
	# {"key":" \t\n\r "} spații albe
	( Dicționar nou pune: [' \t\n\r '] la: ['key'] )
	.

dicționare fiecare: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (Dicționar nou pune: d key la: ['key']).
	>> b := JSON jsonify: (Dicționar nou pune: ['value'] la: d key).
	>> e := JSON obiect: a.
	>> f := JSON obiect: b.
	((e key = d key și: (f ? d key = ['value'])) sau: (e key = ['NUL ?'])) adevărat: {
		Ieșire scrie: ['OK'], rând-nou.
	}, altfel: {
		Ieșire scrie: ['Nu se poate codifica/decodifica corect: '] + d + j, rând-nou.
		Program sfârșit.
	}.
}.
