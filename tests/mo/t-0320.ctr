


>> AparatDeCafea := Obiect nou.
AparatDeCafea la: ['order:'] execută: { :id
	>> coffee := ['Americano'].
	( id = 1 ) adevărat: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) adevărat: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) adevărat: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> AparatSimpluDeCafea := Obiect nou.
AparatSimpluDeCafea la: ['comanda'] execută: { <- ['Neagră']. }.
>> canăRoșie := AparatDeCafea order: 1.
Ieșire scrie: canăRoșie, rând-nou.
canăRoșie := ['Ceai']. 
>> canăVerde := AparatDeCafea order: 0.
Ieșire scrie: canăVerde, rând-nou.
>> canăGalbenă := AparatDeCafea order: 1.
Ieșire scrie: canăGalbenă, rând-nou.
>> canăAlbastră := AparatDeCafea order: 0.
Ieșire scrie: canăAlbastră, rând-nou.
>> canăDePlastic := AparatSimpluDeCafea comanda.
canăDePlastic := ['Limonadă']. 
>> canăNeagră := AparatSimpluDeCafea comanda.
Ieșire scrie: canăNeagră, rând-nou.
canăNeagră adaugă-la-sfârșit: [' nuuu.... bere. '].
>> canăPortocalie := AparatSimpluDeCafea comanda.
Ieșire scrie: canăPortocalie, rând-nou.
