>> Salutator := Obiect nou.
Salutator la: ['creează'] execută: {
	>> sal := Obiect nou.
	sal la: ['setName:'] execută: { :unNume
		propriu nume := unNume.
	}.
	sal la: ['salută'] execută: {
		Ieșire scrie: propriu nume.
	}. <- sal.
}.
>> a := Salutator creează.
>> b := Salutator creează.
a setName: ['UNU'].
b setName: ['DOI'].
a salută.
b salută.
>> c := a nou.
c setName: ['TREI'].
c salută.
>> d := a nou.
d setName: ['PATRU'].
d salută.
c salută.
