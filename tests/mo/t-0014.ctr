>> Greeter := Obiect nou.
Greeter la: ['make'] execută: {
	>> gr := Obiect nou.
	gr la: ['setName:'] execută: { :aname
		propriu nume := aname.
	}.
	gr la: ['greet'] execută: {
		Ieșire scrie: propriu nume.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a nou.
c setName: ['THREE'].
c greet.
>> d := a nou.
d setName: ['FOUR'].
d greet.
c greet.
