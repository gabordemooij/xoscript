
>> Salutator := Obiect nou.
Salutator la: ['nou'] execută: {
	propriu nume := ['?'].
}.
Salutator la: ['name:'] execută: { :nume
	propriu nume := nume.
}.
Salutator la: ['salută'] execută: {
	Ieșire scrie: (['hello[you]'] [you]: propriu nume).
}.
>> prieten := Salutator nou.
prieten name: ['1'].
prieten salută.
