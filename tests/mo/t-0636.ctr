# test url parsing

Server init.
>> url := URL din: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Ieșire scrie: ['scheme = '] + url schemă, rând-nou.
Ieșire scrie: ['host = '] + url gazdă, rând-nou.
Ieșire scrie: ['port = '] + url port, rând-nou.
Ieșire scrie: ['path = '] + url cale, rând-nou.
Ieșire scrie: ['query = '] + url parametri-căutare, rând-nou.
Ieșire scrie: ['fragment = '] + url fragment, rând-nou.
