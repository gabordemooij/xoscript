Server init.

>> DB := Maria-DB nou gazdă: ['localhost'],
	utilizator: ['xo'],
	parolă: ['pass123'],
	nume-bază: ['xobase'],
	conectează.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> parametri-căutare := Maria-Interogare nou: SQL.

# set database
parametri-căutare bază-de-date: DB.

parametri-căutare preia: { :row
	Ieșire scrie: row world, rând-nou.
}.
