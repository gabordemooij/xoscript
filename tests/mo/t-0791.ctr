Server init.

>> BD := Maria-DB nou gazdă: ['localhost'],
	utilizator: ['xo'],
	parolă: ['pass123'],
	nume-bază: ['xobase'],
	conectează.
	
>> SQL := ['SELECT "hello" AS "world" '].

# creăm interogarea manual
>> parametri-căutare := Maria-Interogare nou: SQL.

# setăm baza de date
parametri-căutare bază-de-date: BD.

parametri-căutare preia: { :rând
	Ieșire scrie: rând world, rând-nou.
}.
