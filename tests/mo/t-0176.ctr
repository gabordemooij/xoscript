>> txt := ['Word Salad'].
Ieșire scrie: ['Text Length: '] + txt lungime, rând-nou.
Ieșire scrie: ['Character at 2:'] + ( txt caracter: 2 ), rând-nou.
Ieșire scrie: (( txt caută: ['S'] ) - 0), rând-nou.

