#Linux
>> OS := Program sistem: (Comandă uname -s), curăță-spații.

>> Slurp := Obiect nou.
Slurp la: ['nou'] execută: {
	propriu str := [''].
}.
Slurp la: ['răspunde:'] execută: { :blah
		(propriu str ≠ ['']) adevărat: {
			propriu str adaugă-la-sfârșit: [' '].
		}.
		propriu str adaugă-la-sfârșit: blah.
}.
Slurp la: ['răspunde:și:'] execută: { :blah :blahah
		(propriu str ≠ ['']) adevărat: {
			propriu str adaugă-la-sfârșit: [' '].
		}.
		(blah lungime > 1) adevărat: {
			propriu str adaugă-la-sfârșit: (blah de-la: 0 lungime: (blah lungime - 1)).
		}, altfel: {
			propriu str adaugă-la-sfârșit: blah.
		}.
		propriu str adaugă-la-sfârșit: [' '].
		propriu str adaugă-la-sfârșit: blahah.
}.
Slurp la: ['obtain'] execută: {
	>> buffer := propriu str.
	propriu str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text adaugă-la-sfârșit: ['hello'].
} × 1000.


Ieșire scrie: (
	Program sistem: (
		Slurp nou
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

