>> numere := ['1,2,3'] împarte: [','].
Ieșire scrie: ['Am primit: '] + numere numără + [' numere.'],rând-nou.
{ :i Ieșire scrie: ['number #'] + i + [':'] + (numere poziție: i), rând-nou.} × 3.
>> băuturi := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
băuturi := băuturi împarte: [' Or '].
Ieșire scrie: ['Servim'], rând-nou.
{ :i Ieșire scrie: ['->'] + (băuturi poziție: i), rând-nou. } × (băuturi numără).
Ieșire scrie: (băuturi unește: [',']), rând-nou.
Ieșire scrie: (numere unește: ['||']).
