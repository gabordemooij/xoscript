

Text la: ['evaluează'] execută: {
	>> cod := Fișier nou: ['/tmp/eval.ctr'].
	cod scrie: (sine text + ['.']).
	Program folosește: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Listă ← (['Ghilimelele '] + Q + [' sunt rele?']) ; 1.
>> x := q text.
Ieșire scrie: x, rând-nou.
>> y := Nimic.
(['y := '] + x ) evaluează.
Ieșire scrie: y ? 0, rând-nou.

q := Dicționar pune: ['\[''] la: ['\['quote\']'].
x := q text.
Ieșire scrie: x, rând-nou.
y := Nimic.
(['y := '] + x ) evaluează.

>> q := (Dicționar nou) pune:['\[''] la:['\['quote\[''].
Ieșire scrie: y ? ['\['quote\']'], rând-nou.
