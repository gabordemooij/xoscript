>> phrases := Listă nou
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases fiecare: { :_ :phrase 
	>> e := Server base64-codifică: phrase.
	>> d := Server base64-decodifică: e.
	Ieșire scrie: (
		message copiază ~encoded: e, ~decoded: d
	), rând-nou.
}.
