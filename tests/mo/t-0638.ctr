
Server init.
>> cr := Cerere-HTTP nou.
Ieșire scrie: ['HTTP-GET d[]=']  + ( cr get-listă: ['d[]'] ), rând-nou. # GET
Ieșire scrie: ['HTTP-GET f[]=']  + ( cr get-listă: ['f[]'] ), rând-nou. # GET
Ieșire scrie: ['HTTP-POST e[]='] + ( cr post-listă: ['e[]'] ), rând-nou. # GET
Ieșire scrie: ['HTTP-POST c=']   + ( cr post: ['c'] ), rând-nou. # GET
Ieșire scrie: ['HTTP-POST xx=']  + ( cr post: ['xx'] ), rând-nou. # GET
