
Ieșire scrie: ['Întrerupe bucla for, 0-4.'], rând-nou.
{ :i
	Ieșire scrie: ['iteration #'] + i, rând-nou.
	(i = 4) întrerupe.
} × 10.

>> x := 0.
>> xEsteMaiMicDecât10 := { <- ( x < 10 ). }.

Ieșire scrie: ['Întrerupe bucla while-true, 0-4.'], rând-nou.
{
	Ieșire scrie: ['iteration #'] + x, rând-nou.
	x adaugă: 1.
	((x < 5) nu) întrerupe.
} cât-timp: xEsteMaiMicDecât10.

Ieșire scrie: ['Întrerupe bucla while-false, 5,4.'], rând-nou.
{
	Ieșire scrie: ['iteration #'] + x, rând-nou.
	x scade: 1.
	(x = 3) întrerupe.
} cât-timp: { <- (x > 0). }.

Ieșire scrie: ['Întrerupe bucla times, 1-4.'], rând-nou.
{ :i
	Ieșire scrie: ['iteration #'] + i, rând-nou.
	(i = 4) întrerupe.
} × 5.

Ieșire scrie: ['Întrerupe blocul, nu afișa rândul.'], rând-nou.
{ Adevărat întrerupe. Ieșire scrie: ['nu scrie asta!'], rând-nou. } pornește.

Ieșire scrie: ['Întrerupe blocul, nu declanșa catch...'], rând-nou.
{ Adevărat întrerupe. Ieșire scrie: ['nu scrie asta!'], rând-nou. } prinde: { Ieșire scrie: ['Nu prinde asta!']. }, pornește.

Ieșire scrie: ['Testează bucla each pe Listă: 0,1'], rând-nou.
(Listă ← 1 ; 2 ; 3) transformă: { :i
	Ieșire scrie: ['iteration #'] + i, rând-nou.
	(i = 1) întrerupe.
}.

Ieșire scrie: ['Testează bucla each pe Dicționar: doar c'], rând-nou.
>> m := Dicționar nou.
m pune: ['first'] la: ['a'], pune: ['second'] la: ['b'], pune: ['al treilea'] la: ['c'].
m fiecare: { :k :v
	Ieșire scrie: ['iteration'] + v + k, rând-nou.
	Adevărat întrerupe.
}.

