
Ieșire scrie: ['Break for-loop, 0-4.'], rând-nou.
{ :i
	Ieșire scrie: ['iteration #'] + i, rând-nou.
	(i = 4) întrerupe.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Ieșire scrie: ['Break while-true loop, 0-4.'], rând-nou.
{
	Ieșire scrie: ['iteration #'] + x, rând-nou.
	x adaugă: 1.
	((x < 5) nu) întrerupe.
} cât-timp: xIsLessThan10.

Ieșire scrie: ['Break while-false loop, 5,4.'], rând-nou.
{
	Ieșire scrie: ['iteration #'] + x, rând-nou.
	x scade: 1.
	(x = 3) întrerupe.
} cât-timp: { <- (x > 0). }.

Ieșire scrie: ['Break times loop, 1-4.'], rând-nou.
{ :i
	Ieșire scrie: ['iteration #'] + i, rând-nou.
	(i = 4) întrerupe.
} × 5.

Ieșire scrie: ['Break block, dont print line.'], rând-nou.
{ Adevărat întrerupe. Ieșire scrie: ['dont write this!'], rând-nou. } pornește.

Ieșire scrie: ['Break block, dont fire catch...'], rând-nou.
{ Adevărat întrerupe. Ieșire scrie: ['dont write this!'], rând-nou. } prinde: { Ieșire scrie: ['Dont catch this!']. }, pornește.

Ieșire scrie: ['Test Array each-loop: 0,1'], rând-nou.
(Listă ← 1 ; 2 ; 3) transformă: { :i
	Ieșire scrie: ['iteration #'] + i, rând-nou.
	(i = 1) întrerupe.
}.

Ieșire scrie: ['Test Map each-loop: c only'], rând-nou.
>> m := Dicționar nou.
m pune: ['first'] la: ['a'], pune: ['second'] la: ['b'], pune: ['third'] la: ['c'].
m fiecare: { :k :v
	Ieșire scrie: ['iteration'] + v + k, rând-nou.
	Adevărat întrerupe.
}.

