>> t := Nimic.

# puteți controla fusul orar pentru
# analiză astfel:
Moment zonă: ['CET'].
t := Moment din: ['1981-02-03 04:05:06'].
Ieșire scrie: t, rând-nou.

# acum folosim fusul orar CEST:
Moment zonă: ['CEST'].
t := Moment din: ['1981-02-03 04:05:06'].
Ieșire scrie: t, rând-nou.

# eroare dacă textul nu poate fi analizat
{ Moment din: ['1900']. } prinde: { Nimic. }, pornește.
