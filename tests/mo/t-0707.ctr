# test conversii de tip / conversii / legări
Program gestiune-memorie: 4.
Server init.

>> contor := 0.
>> bd := Maria-DB nou gazdă: ['localhost'],
	utilizator: ['xo'], parolă: ['pass123'], nume-bază: ['xobase'], conectează.

>> FormatDouăCifre := Format nou: ['%02d'].

# Dată și oră
{
	>> an     := Număr între: 1995 și: 2050, text.
	>> lună    := FormatDouăCifre aplică-întreg: (Număr între: 1 și: 12), text.
	>> zi      := FormatDouăCifre aplică-întreg: (Număr între: 1 și: 28), text.
	>> oră     := FormatDouăCifre aplică-întreg: (Număr între: 1 și: 23), text.
	>> minut   := FormatDouăCifre aplică-întreg: (Număr între: 1 și: 59), text.
	>> secundă   := FormatDouăCifre aplică-întreg: (Număr între: 1 și: 59), text.
	>> datetime := ['YYYY-MM-DD HH:II:SS'].	
	datetime
		YYYY: an,
		MM: lună,
		DD: zi,
		HH: oră,
		II: minut,
		SS: secundă.
	>> parametri-căutare :=
	bd interogare: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: datetime),
	preia: { :rând
		(rând mydatetime = datetime) fals: {
			această-sarcină eroare: (
				['Așteptat: <expected> dar am obținut: <observation>']
				<expected>: datetime,
				<observation>: rând mydatetime
			).
		}.
	
	}.
	contor adaugă: 1.
} * 100.

# Dată
{
	>> an     := Număr între: 1995 și: 2050, text.
	>> lună    := FormatDouăCifre aplică-întreg: (Număr între: 1 și: 12), text.
	>> zi      := FormatDouăCifre aplică-întreg: (Număr între: 1 și: 28), text.
	>> date     := ['YYYY-MM-DD'].
	date
		YYYY: an,
		MM: lună,
		DD: zi.
	>> parametri-căutare :=
	bd interogare: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: date),
	preia: { :rând
		(rând mydate = date) fals: {
			această-sarcină eroare: (
				['Așteptat: <expected> dar am obținut: <observation>']
				<expected>: date,
				<observation>: rând mydate
			).
		}.
	}.
	contor adaugă: 1.
} * 100.


# Oră
{
	>> oră     := FormatDouăCifre aplică-întreg: (Număr între: 1 și: 23), text.
	>> minut   := FormatDouăCifre aplică-întreg: (Număr între: 1 și: 59), text.
	>> secundă   := FormatDouăCifre aplică-întreg: (Număr între: 1 și: 59), text.
	>> timp := ['HH:II:SS'].
	timp
		HH: oră,
		II: minut,
		SS: secundă.
	>> parametri-căutare :=
	bd interogare: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: timp),
	preia: { :rând
		(rând mytime = timp) fals: {
			această-sarcină eroare: (
				['Așteptat: <expected> dar am obținut: <observation>']
				<expected>: datetime,
				<observation>: rând mytime
			).
		}.
	}.
	contor adaugă: 1.
} * 100.


# Texte (varchar/text)
>> str1 := Listă nou umple: 100000 cu: ['x'], unește: [''].
{
	>> str2 := Seif jeton: 40.
	>> parametri-căutare :=
	bd interogare: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	preia: { :rând
		(rând str1 = str1 și: rând str2 = str2) fals: {
			această-sarcină eroare: (
				['Așteptat: <expected> dar am obținut: <observation>']
				<expected>: datetime,
				<observation>: rând mytime
			).
		}.
	}.
	contor adaugă: 1.
} * 100.


# Numere
{
	>> n1  := Număr între: 1 și: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 din-text: ['9223372036854775807'] ) -
		( Int64 din-text: ['99999'] ) +
		( Int64 din-text: n1 text )
	).
	>> parametri-căutare :=
	bd interogare: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	preia: { :rând
		(rând n1 = n1) fals: {
			această-sarcină eroare: (
				['Așteptat: <expected> dar am obținut: <observation>']
				<expected>: n1,
				<observation>: rând n1
			).
		}.
		(rând n2 = n2) fals: {
			această-sarcină eroare: (
				['Așteptat: <expected> dar am obținut: <observation>']
				<expected>: n1,
				<observation>: rând n2
			).
		}.
		(rând n3 = n2 rotunjește) fals: {
			această-sarcină eroare: (
				['Așteptat: <expected> dar am obținut: <observation>']
				<expected>: n1,
				<observation>: rând n3
			).
		}.
		(rând big = big) fals: {
			această-sarcină eroare: (
				['Așteptat: <expected> dar am obținut: <observation>']
				<expected>: big,
				<observation>: rând big
			).
		}.
		
	}.
	contor adaugă: 1.
} * 100.


Ieșire scrie: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: contor
), rând-nou.