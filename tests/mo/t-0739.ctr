Ieșire scrie: ['Obiect de test'], rând-nou.
>> a := Obiect nou. 

a la: ['item:'] execută: { :ajutorbin
	propriu ajutorbin := ajutorbin. 
}.

a la: ['articol'] execută: {
	<- propriu ajutorbin.
}.

a item: Bin nou.

>> vechea-adresă-ajutorbin := a articol prototip adresă-memorie.
a save-as: ['/tmp/a.bin'].
Ieșire scrie: ['========== REÎNCĂRCARE SNAP:'], rând-nou.

>> b := Obiect load-from: ['/tmp/a.bin'].

(b articol prototip adresă-memorie = vechea-adresă-ajutorbin) adevărat: {
	Ieșire scrie: ['Legătura obiectului a fost reatașată.'], rând-nou.
}.


