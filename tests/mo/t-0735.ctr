Server init.
>> a := Blob nou: 4.
a bytes: ( Listă nou ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob nou: 4.
b bytes: ( Listă nou ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
# inherited blob does not get the buffer, so it's useless
# it will pass ctr_accept() but since buffer ptr == null, it will retur
>> c := a nou.
{ 
>> n := a ^ c.
Ieșire scrie: ['xorred:'], rând-nou. 
Ieșire scrie: n, rând-nou. 
} prinde: { :e Ieșire scrie: e, rând-nou. }, pornește.
a eliberează.
b eliberează.
