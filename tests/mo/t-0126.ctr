#Linux
>> Sorbitor := Obiect nou.

Sorbitor la: ['nou'] execută: {
	propriu str := [''].
}.

Sorbitor la: ['nieuw'] execută: {
	propriu str := [''].
}.

Sorbitor la: ['răspunde:'] execută: { :blah
		propriu str adaugă-la-sfârșit: blah.
}.

Sorbitor la: ['răspunde:și:'] execută: { :blah :blahah
		propriu str adaugă-la-sfârșit: (blah de-la: 0 lungime: (blah lungime - 1)).
		propriu str adaugă-la-sfârșit: [' '].
		propriu str adaugă-la-sfârșit: blahah.
}.

Sorbitor la: ['obține'] execută: {
	>> tampon := propriu str.
	propriu str := ['']. <- tampon.
}.


Ieșire scrie: (Program sistem: (Sorbitor nou echo: ['Salut, pot scrie în consolă folosind un API fluent!'], obține)).


{ Fișier nou: ['/tmp/from.txt'], șterge. } prinde: { ['Gol']. }, pornește.
{ Fișier nou: ['/tmp/to.txt'], șterge. } prinde: { ['Gol']. }, pornește.


Fișier nou: ['/tmp/to.txt'], există fals: {
	Ieșire scrie: ['Confirmed. Target file does not exist.\
'].
}.
Fișier nou: ['/tmp/from.txt'], există fals: {
	Ieșire scrie: ['Confirmed. Source file does not exist.\
'].
}.



Program sistem: (Sorbitor nou touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obține).



Program sistem: (Sorbitor nou cp: ['/tmp/from.txt /tmp/to.txt'], obține).

Fișier nou: ['/tmp/to.txt'], există adevărat: {
	Ieșire scrie: ['Confirmed. Target file has been created by shell.\
'].
}.


Ieșire scrie: ['Conținutul fișierului este:'] + (Fișier nou: ['/tmp/to.txt'], citește), rând-nou.
