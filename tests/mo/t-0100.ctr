Text la: ['html'] execută: { <- (
		sine
		înlocuiește: ['&'] cu: ['&amp;'],
		înlocuiește: ['<'] cu: ['&lt;'],
		înlocuiește: ['>'] cu: ['&gt;'],
		înlocuiește: ['"'] cu: ['&quot;']
	).
}.

>> list := Listă nou.

['Verbatim Syntax'] caractere fiecare: { :număr :literă
	list ; ((['<li>#Number:Letter</li>']) Number: (număr), Letter: literă).
}.

Ieșire list.





