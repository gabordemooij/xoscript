Server init.

Ieșire scrie: (
	Șablon nou: ['^\\w+$'],
	potrivire: ['test@example.com'] 
), rând-nou. # 0 match, fails on @ and .

Ieșire scrie: (
	Șablon nou: ['^[^@]+@[^\.]+\.\\w+$'],
	potrivire: ['test@example.com'] 
), rând-nou. # 1 match

Ieșire scrie: (
	Șablon nou: ['[^@]+@[^\.]+\.\\w+'],
	potrivire: ['test@example.com'] 
), rând-nou. # 1 match

Ieșire scrie: (
	Șablon nou: ['([^@]+)@([^\.]+)\.\\w+'],
	potrivire: ['test@example.com'] 
), rând-nou. # 1 match, groups dont matter

Ieșire scrie: (
	Șablon nou: ['[a-z]'],
	potrivire: ['test@example.com'] 
), rând-nou. # 14 matches

Ieșire scrie: (
	Șablon nou: ['.*'],
	potrivire: ['test@example.com'] 
), rând-nou. # 1 match (all)

Ieșire scrie: (
	Șablon nou: ['(.*)'],
	potrivire: ['test@example.com'] 
), rând-nou. # 1 match (all)

Ieșire scrie: (
	Șablon nou: ['\\s*[^@]+@[^\.]+\.\\w+'],
	potrivire: ['test@example.com'] 
), rând-nou. # 1 match, prefix space optional, gets ignored