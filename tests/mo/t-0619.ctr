>> HTML := Obiect nou.
HTML la: ['răspunde:'] execută: { :tag 
	Ieșire scrie: (['<tag>'] tag: tag), rând-nou.
}.
HTML la: ['răspunde:și:'] execută: { :tag :html 
	Ieșire scrie: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), rând-nou.
}.
>> html := HTML nou.
html body h1: ['header'].

