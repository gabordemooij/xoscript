>> items := Dicționar nou.
items pune: ['green'] la: ['color-1'].
items pune: ['orange'] la: ['color-2'].
items pune: ['red'] la: ['color-3'].
>> i := 0.
>> s := [''].
items fiecare: { :key :color
	Ieșire scrie: ['color #'] + i + [' is: '] + color + [' '].
	i adaugă: 1.
}.
Ieșire scrie: i + [' colors!'].
