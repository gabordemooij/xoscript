Server init.
Ieșire scrie: ['Database datetime test'], rând-nou.

>> db := Maria-DB nou gazdă: ['localhost'],
	utilizator: ['xo'], 
	parolă: ['pass123'],
	nume-bază: ['xobase'],
	conectează.

>> parametri-căutare :=
db interogare: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
preia: { :row
	Ieșire scrie: row datetimetest, rând-nou.
}.
