Server init.
Ieșire scrie: ['Test de dată și oră în baza de date'], rând-nou.

>> bd := Maria-DB nou gazdă: ['localhost'],
	utilizator: ['xo'], 
	parolă: ['pass123'],
	nume-bază: ['xobase'],
	conectează.

>> parametri-căutare :=
bd interogare: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
preia: { :rând
	Ieșire scrie: rând datetimetest, rând-nou.
}.
