Ieșire scrie: ['Obiect de test'], rând-nou.
>> a := Obiect nou. 

a la: ['item:'] execută: { :ajutorhex
	propriu ajutorhex := ajutorhex. 
}.

a la: ['articol'] execută: {
	<- propriu ajutorhex.
}.

a item: Hx nou.

>> vechea-adresă-ajutorhex := a articol prototip adresă-memorie.
a save-as: ['/tmp/a.bin'].
Ieșire scrie: ['========== REÎNCĂRCARE SNAP:'], rând-nou.

>> b := Obiect load-from: ['/tmp/a.bin'].

(b articol prototip adresă-memorie = vechea-adresă-ajutorhex) adevărat: {
	Ieșire scrie: ['Legătura obiectului a fost reatașată.'], rând-nou.
}.
