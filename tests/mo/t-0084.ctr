>> creeazăAdunător := { :x
	>> f := { :y <- (propriu x + y). } setează: ['x'] valoare: x. <- f.
}.
>> transformator := { :tablou :funcț
	>> transformare := { :i propriu q pune: (propriu f aplică: (propriu q ? i)) la: i. } 
	setează: ['q'] valoare: tablou,
	setează: ['f'] valoare: funcț.
	{ :i transformare aplică: i. } × (tablou numără).
}.

>> a := Listă ← 1; 2; 3.
transformator aplică: a și: (creeazăAdunător aplică: 100).
Ieșire scrie: (a poziție: 0), rând-nou.
Ieșire scrie: (a ? 1), rând-nou.
Ieșire scrie: (a ? 2), rând-nou.
