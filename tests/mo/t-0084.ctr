>> makeAdder := { :x
	>> f := { :y <- (propriu x + y). } setează: ['x'] valoare: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i propriu q pune: (propriu f aplică: (propriu q ? i)) la: i. } 
	setează: ['q'] valoare: array,
	setează: ['f'] valoare: func.
	{ :i mapping aplică: i. } × (array numără).
}.

>> a := Listă ← 1; 2; 3.
mapper aplică: a și: (makeAdder aplică: 100).
Ieșire scrie: (a poziție: 0), rând-nou.
Ieșire scrie: (a ? 1), rând-nou.
Ieșire scrie: (a ? 2), rând-nou.
