# test calificative

Program curăță.

>> Fruct := Obiect nou.
Fruct la: ['nou'] execută: {
	>> f := sine nou.
	f apples: 0. <- f.
}.
Fruct la: ['apples:'] execută: { :a propriu mere := a. }.
Fruct la: ['mere'] execută: { <- propriu mere. }.
Fruct la: ['+'] execută: { :f
	>> n := Fruct nou.
	n apples: (f mere + propriu mere). <- n.
}.
Număr la: ['mere'] execută: { <- ((Fruct nou) apples: sine).
}.

Fruct la: ['text'] execută: { <- propriu mere + [' mere '].
}.

>> q := 3 mere + 4 mere.
Ieșire scrie: q, rând-nou.




q := 3 mere + 4 mere.
Ieșire scrie: q, rând-nou.



q := 3 mere + 4 mere.
Ieșire scrie: q, rând-nou.


