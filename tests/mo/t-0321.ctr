# test qualifiers

Program curăță.

>> Fruit := Obiect nou.
Fruit la: ['nou'] execută: {
	>> f := sine nou.
	f apples: 0. <- f.
}.
Fruit la: ['apples:'] execută: { :a propriu apples := a. }.
Fruit la: ['apples'] execută: { <- propriu apples. }.
Fruit la: ['+'] execută: { :f
	>> n := Fruit nou.
	n apples: (f apples + propriu apples). <- n.
}.
Număr la: ['apples'] execută: { <- ((Fruit nou) apples: sine).
}.

Fruit la: ['text'] execută: { <- propriu apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Ieșire scrie: q, rând-nou.




q := 3 apples + 4 apples.
Ieșire scrie: q, rând-nou.



q := 3 apples + 4 apples.
Ieșire scrie: q, rând-nou.


