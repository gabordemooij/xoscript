# Test utf8 sanitizer
Server init.

>> utf8cases := Dicționar nou
	# ASCII only
	pune: ( Listă nou ; 65 ; 65 ; 65 ; 65 ; 0 ) la: ['AAAA'],
	# valid 2 byte sequence
	pune: ( Listă nou ; 194 ; 162 ; 0 ) la: ['¢'],
	# Valid 3-byte UTF-8
    pune: ( Listă nou ; 226 ; 130 ; 172 ; 0 ) la: ['€'],
	# Valid 4-byte UTF-8
    pune: ( Listă nou ; 240 ; 144 ; 141 ; 136 ; 0 ) la: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    pune: ( Listă nou ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) la: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    pune: ( Listă nou ; 65 ; 193 ; 129 ; 0 ) la: ['A?'],
	# Invalid first byte (0xFF)
    pune: ( Listă nou ; 255 ; 0 ) la: ['?'],
	# Incomplete multi-byte sequence at end
    pune: ( Listă nou ; 66 ; 226 ; 0 ) la: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    pune: ( Listă nou ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) la: ['A€?𐍈B'].
	 
utf8cases fiecare: { :key :value
	>> blob := Blob nou: value numără, bytes: value.
	>> str := blob text.
	(str = key) adevărat: {
		Ieșire scrie: ['OK'], rând-nou.
	}, altfel: {
		Ieșire scrie: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, rând-nou.
	}.
	blob eliberează.
}.
