>> tabel1 := Dicționar nou.
>> cheie1 := Listă nou.
>> cheie2 := Listă nou.

tabel1
	pune: ['hello'] la: cheie1,
	pune: ['world'] la: cheie2.


Ieșire
	scrie: ['Map #1 contains: '] + (tabel1 la: cheie1),
	scrie: [' și '] + (tabel1 la: cheie2), rând-nou.

>> ListăCuChei := Listă nou.
ListăCuChei la: ['caText'] execută: { <- (sine numără) caText.
}.

>> map2 := Dicționar nou.
cheie1 := ListăCuChei nou.
cheie2 := ListăCuChei nou.

cheie1 adaugă-la-sfârșit: 1.

map2
	pune: ['hello'] la: cheie1,
	pune: ['world'] la: cheie2.

Ieșire
	scrie: ['Map #2 contains: '] + (map2 la: cheie1),
	scrie: [' și '] + (map2 la: cheie2), rând-nou.
