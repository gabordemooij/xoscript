>> map1 := Dicționar nou.
>> key1 := Listă nou.
>> key2 := Listă nou.

map1
	pune: ['hello'] la: key1,
	pune: ['world'] la: key2.


Ieșire
	scrie: ['Map #1 contains: '] + (map1 la: key1),
	scrie: [' and '] + (map1 la: key2), rând-nou.

>> KeyeableArray := Listă nou.
KeyeableArray la: ['toString'] execută: { <- (sine numără) toString.
}.

>> map2 := Dicționar nou.
key1 := KeyeableArray nou.
key2 := KeyeableArray nou.

key1 adaugă-la-sfârșit: 1.

map2
	pune: ['hello'] la: key1,
	pune: ['world'] la: key2.

Ieșire
	scrie: ['Map #2 contains: '] + (map2 la: key1),
	scrie: [' and '] + (map2 la: key2), rând-nou.
