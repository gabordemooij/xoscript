Server init.
>> fmt := Format nou: ['%#3x'].

>> blob := Blob nou: 4.
blob bytes: ( 
	Listă nou ; 0 ; 1 ; 2 ; 3
).

>> file := Fișier nou: ['/tmp/blob'].
file blob: blob.
blob eliberează.

>> citește := file blob.
citește 
de-la: 0 
lungime: 4, 
fă fiecare: { :i :b 
	Ieșire
	scrie: (fmt aplică-întreg: b),
	rând-nou.
}.
citește eliberează.
