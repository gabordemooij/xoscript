# formatul cookie-ului de sesiune, tip de conținut json, doar protocoale web, svg afișat inline
Server inițializează.
Program folosește: ['../../../src/xo/mo/webtools.xo'].

>> Cerere-Falsă := Obiect nou.
Cerere-Falsă la: ['value:'] execută: { :valoare
	propriu valoare := valoare.
}.
Cerere-Falsă la: ['cookie:'] execută: { :nume
	<- propriu valoare.
}.

>> Sesiune-Test := Sesiune-fișier-temporar nou.
Sesiune-Test la: ['încarcă'] execută: {
	<- Dicționar nou.
}.
Sesiune-Test la: ['identificator-sesiune'] execută: {
	<- propriu id.
}.

>> cookie-uri := Listă nou
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

cookie-uri fiecare: { :i :cookie
	>> cerere := Cerere-Falsă nou.
	cerere value: cookie.
	>> manager := Sesiune-Test nou.
	>> web := Document-Web nou.
	web cerere: cerere.
	web manager-sesiune: manager.
	web pornește-sesiune.
	Ieșire scrie: ( manager identificator-sesiune = cookie ), rând-nou.
}.

>> web := Document-Web nou.
web json: (Dicționar nou pune: ['b'] la: ['a']).
Ieșire scrie: ['\n'], rând-nou.

{ Rețea get: ['file:///etc/hostname']. } prinde: { :e
	Ieșire scrie: e, rând-nou.
}, pornește.

>> svg := Fișier nou: ['/tmp/test0814.svg'].
svg scrie: ['<svg xmlns="x"></svg>'].
Ieșire rând-nou.
Server transmite: ['test0814.svg'] prefix: ['/tmp/'].
svg șterge.
