Server init.

>> db := Maria-DB nou gazdă: ['localhost'],
	utilizator: ['xo'],
	parolă: ['pass123'],
	nume-bază: ['xobase'],
	conectează.

>> del := db interogare: ['DELETE FROM book WHERE id > 0'].
{  del execută-interogare. db confirmă. } prinde: { :e db anulează.  }, pornește.

>> numără := db interogare: ['SELECT COUNT(*) AS num FROM book'].
numără preia: { :row Ieșire scrie: row num, rând-nou. }.
