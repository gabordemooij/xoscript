# catch-all test (practical)
>> HTML := Text nou.
HTML la: ['encode:'] execută: { :tekst
	sine adaugă-la-sfârșit: (tekst
	înlocuiește: ['&'] cu: ['&amp;'], 
	înlocuiește: ['<'] cu: ['&lt;'],
	înlocuiește: ['>'] cu: ['&gt;'],
	înlocuiește: ['"'] cu: ['&quot;']).
}.
>> blog := HTML nou.
blog adaugă-la-sfârșit: ['<h1>'],
     encode: ['Koffie & Thee'],
     adaugă-la-sfârșit: ['</h1>'].
Ieșire scrie: blog, rând-nou.


>> Roman := Număr nou.
Roman la: ['stringy'] execută: {
	>> a := [''].
	{ a adaugă-la-sfârșit: ['I']. } × sine. <- a.
}.

>> x := Roman nou.
x adaugă: 3.
Ieșire scrie: x stringy, rând-nou.

>> Quantum := Boolean nou.
Quantum la: ['true?'] execută: { <- ['maybe True']. }.
Ieșire scrie: (Quantum nou true?), rând-nou.

>> Nihil := Nimic nou.
Nihil la: ['text'] execută: { <- ['Nihil']. }.
Ieșire scrie: (Nihil nou), rând-nou.
