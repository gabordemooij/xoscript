


>> memorieFolosită1 := 0.
>> memorieFolosită2 := 0.
>> memorieFolosită3 := 0.
>> memorieFolosită4 := 0.

Program gestiune-memorie: 0.
>> paletă := Nimic.
>> culori := Nimic.

{
paletă := Dicționar nou.
paletă 
	pune: ['#F00'] la: ['roșu'],
	pune: ['#0F0'] la: ['verde'],
	pune: ['#00F'] la: ['albastru'].
Ieșire scrie: ['numărul de coduri RGB din paletă: '] + ( paletă numără ), rând-nou.
Ieșire scrie: ['codul RGB pentru verde este: '] + ( paletă ? ['verde'] ), rând-nou.
culori := [''].
( paletă fiecare: { :nume :cod
		culori := culori + ( nume + [':'] + cod ).
} ).
Ieșire scrie: ['Toate culorile din paletă: '] + culori, rând-nou.
} pornește.
Program curăță.
memorieFolosită1 := (Program memorie ? 0).

{
paletă := Dicționar nou.
paletă 
	pune: ['#F00'] la: ['roșu'],
	pune: ['#0F0'] la: ['verde'],
	pune: ['#00F'] la: ['albastru'].
