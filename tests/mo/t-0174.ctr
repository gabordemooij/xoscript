


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program gestiune-memorie: 0.
>> palette := Nimic.
>> colors := Nimic.

{
palette := Dicționar nou.
palette 
	pune: ['#F00'] la: ['red'],
	pune: ['#0F0'] la: ['green'],
	pune: ['#00F'] la: ['blue'].
Ieșire scrie: ['number of RGB codes in palette: '] + ( palette numără ), rând-nou.
Ieșire scrie: ['RGB code of green is: '] + ( palette ? ['green'] ), rând-nou.
colors := [''].
( palette fiecare: { :nume :cod
		colors := colors + ( nume + [':'] + cod ).
} ).
Ieșire scrie: ['All colors in palette: '] + colors, rând-nou.
} pornește.
Program curăță.
usedMemory1 := (Program memorie ? 0).

{
palette := Dicționar nou.
palette 
	pune: ['#F00'] la: ['red'],
	pune: ['#0F0'] la: ['green'],
	pune: ['#00F'] la: ['blue'].
