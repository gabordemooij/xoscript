Server init.

>> BD := Maria-DB nou gazdă: ['localhost'],
	utilizator: ['xo'],
	parolă: ['pass123'],
	nume-bază: ['xobase'],
	conectează.

{
	BD interogare:
	['DROP TABLE movies'],
	execută-interogare.
} prinde: { Nimic. }, pornește.

BD interogare:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
execută-interogare.

BD interogare: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parametri: ( Listă nou ; ['Halloween'] ),
execută-interogare.

BD interogare: ['SELECT * FROM movies'],
preia: { :film
	Ieșire scrie: film title, rând-nou.
}.

