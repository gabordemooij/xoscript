Program gestiune-memorie: 0.
Listă la: ['sumă'] execută: {
	>> total := 0.
	sine fiecare: { :indice :element
		total adaugă: element.
	}. <- total.
}.

>> memorieFolosită1 := 0.
>> memorieFolosită2 := 0.
>> memorieFolosită3 := 0.
>> memorieFolosită4 := 0.



>> f := Fișier nou: ['/tmp/test.txt'].
f scrie: ['Lorem Ipsum'].
f închide.
  

f := Fișier nou: ['/tmp/test.txt'].
>> textul := f citește.
f închide.



Program curăță.
memorieFolosită1 := (Program memorie ? 1).



f := Fișier nou: ['/tmp/test.txt'].
textul := f citește.
f închide.

Program curăță.
memorieFolosită2 := (Program memorie ? 1).


f := Fișier nou: ['/tmp/test.txt'].
textul := f citește.
f închide.

Program curăță.
memorieFolosită3 := (Program memorie ? 1).



( memorieFolosită1 = memorieFolosită2 și: memorieFolosită1 = memorieFolosită3, și: memorieFolosită2 = memorieFolosită3 ) adevărat: {
	Ieșire scrie: ['Nicio scurgere de memorie aici'].
}, fals: {
	Ieșire scrie: ['Memoria se scurge...'].
}.
