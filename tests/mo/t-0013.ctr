
>> Animal := Obiect nou.
Animal la: ['nou'] execută: {
	<- sine nou init.
}.

Animal la: ['init'] execută: {
	propriu sunet := ['?'].
	propriu picioare  := 4.
}.

>> Câine := Animal nou.
Câine la: ['init'] execută: {
	sine init.
	propriu sunet := ['latră'].
}.

Animal la: ['text'] execută: {
	<- propriu picioare text + propriu sunet.
}.

>> pudel := Câine nou.
Ieșire scrie: pudel, rând-nou.

