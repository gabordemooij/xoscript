# un grup care nu face parte din potrivire nu trebuie să provoace crash și trebuie să păstreze numerele grupurilor
Server init.
>> arată := { :tipar :subject
	>> p := Șablon nou: tipar.
	p potrivire: subject fă: { :m :g
		Ieșire scrie: g numără, scrie: [' '], scrie: (g unește: ['|']), rând-nou.
		<- m.
	}.
}.
arată aplică: ['(a)|(b)'] și: ['b'].
arată aplică: ['(a)|(b)'] și: ['a'].
arată aplică: ['(x)?y'] și: ['y'].
arată aplică: ['(x)?(y)(z)?'] și: ['xy'].
