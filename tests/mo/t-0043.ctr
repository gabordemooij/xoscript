>> repetor := Obiect nou.
repetor la: ['răspunde:'] execută: { :ce
	Ieșire scrie: ce + [' '].
}.
repetor la: ['răspunde:și:'] execută: { :ce :say
	Ieșire scrie: ce, scrie: say + [' '].
}.
repetor la: ['răspunde:și:și:'] execută: { :ce :say :maiMult
	Ieșire scrie: ce, scrie: say, scrie: maiMult.
}.
repetor repetă.
repetor everything: ['Eu spun.'].
repetor and: ['I '] everything: ['fac.'].
