>> txt := ['Word Salad'].
Ieșire scrie: ['last index of ord = '] + (( txt ultimul: ['ord'] ) - 0), rând-nou.
Ieșire scrie: ['index of ord = '] + (( txt caută: ['ord'] ) - 0), rând-nou.
Ieșire scrie: ['index of ad = '] + (( txt caută: ['ad'] ) - 0), rând-nou.
Ieșire scrie: ['last index of W = '] + (( txt ultimul: ['W'] ) - 0), rând-nou.
Ieșire scrie: ['last index of d = '] + (( txt ultimul: ['d'] ) - 0), rând-nou.
Ieșire scrie: ['txt equals Word Salad = '] + ( txt = ['Word Salad'] ), rând-nou.
Ieșire scrie: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), rând-nou.
Ieșire scrie: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), rând-nou.
Ieșire scrie: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), rând-nou.

