
>> countries := Listă nou
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Listă nou
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods după: countries, fiecare: { :key :value
	counter adaugă: 1.
}.

Ieșire scrie: (['we serve counter dishes'] counter: counter), rând-nou.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] caractere sortează: { :v
	counter adaugă: 0.
}.

Ieșire scrie: (['we sort counter dishes'] counter: counter), rând-nou.


>> counter := 0.
{
	{
		counter adaugă: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Ieșire scrie: (['we calculate counter numbers.'] counter: counter), rând-nou.

