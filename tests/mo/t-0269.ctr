#Linux

(Fișier nou: ['/tmp/testje']) există fals: {
	Program sistem: ['mkdir /tmp/testje'].	
}.

(Fișier nou: ['/tmp/testje/file1']) există fals: {
	Program sistem: ['touch /tmp/testje/file1'].	
}.

(Fișier nou: ['/tmp/testje/folder1']) există fals: {
	Program sistem: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Fișier listă: ['/tmp/testje'].

>> q := Listă nou.

l fiecare: { :k :v v fiecare: { :x :y q adaugă-la-sfârșit: y. }. }.

>> s := q text.

(s conține: ['file1']) adevărat:   { Ieșire scrie: ['OK'], rând-nou. }.
(s conține: ['file2']) adevărat:   { Ieșire scrie: ['XX'], rând-nou. }.
(s conține: ['folder1']) adevărat: { Ieșire scrie: ['OK'], rând-nou. }.
