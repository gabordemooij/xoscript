Program gestiune-memorie: 4.

>> Doubler := Obiect nou.
>> Multiplier := Obiect nou.
Doubler la: ['double:and:'] execută: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier la: ['multiply:and:'] execută: { :x :y <- (x × y).
}.

Ieșire scrie: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), rând-nou.
