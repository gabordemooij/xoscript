#Linux

 >> t := Moment nou.
 
t zonă: ['Europe/Amsterdam'].
t an: 2020, lună: 8, zi: 2, oră: 21, minut: 2, secundă: 1.

>> a := t oră.
>> ams := t zonă.

t zonă: ['US/Hawaii'].
>> b := t oră.
>> hw := t zonă.

Ieșire
scrie: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		sau: ['mai târziu'] sau: ['mai devreme']
	)
),
rând-nou.
 