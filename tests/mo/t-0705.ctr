

>> obj := Obiect nou.

obj la: ['greet'] execută: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj la: ['task'] execută: {
	propriu property := 123.
	{
		# try binds self/own to object instead of block
		Ieșire scrie: sine greet.
		Ieșire scrie: propriu property.
		1 / 0.
	} prinde: {
		Ieșire scrie: sine greet.
		Ieșire scrie: propriu property.
		Ieșire scrie: ['ok'].
	}, încearcă.
}.

obj task.