Ieșire scrie: ['Test object'], rând-nou.
>> a := Obiect nou. 
a la: ['item:'] execută: { :int64
	propriu int64 := int64. 
}.
a la: ['item'] execută: { <- propriu int64.
}.
a item: ( Int64 din-text: ['9999'] ).
Ieșire scrie: a item, rând-nou.
>> old-int64-address := a item prototip adresă-memorie.
a save-as: ['/tmp/a.bin'].
Ieșire scrie: ['========== RELOADING SNAP:'], rând-nou.
>> b := Obiect load-from: ['/tmp/a.bin'].
(b item prototip adresă-memorie = old-int64-address) adevărat: {
	Ieșire scrie: ['Object link re-attached.'], rând-nou.
}.
Ieșire scrie: ( b item ), rând-nou.
