


>> vin := Obiect nou.


vin la: ['caText'] execută: { <- ['merlot'].
}.

vin la: ['naarTekst'] execută: { <- ['merlot'].
}.


vin la: ['='] execută: { :other wine <- ( sine caText = other wine ).
}.

vin la: ['=='] execută: { :other wine <- ( sine caText = other wine ).
}.



vin
	caz: ['cabernet'] fă: { Ieșire scrie: ['e un Cabernet!']. },
	caz: ['syrah']    fă: { Ieșire scrie: ['e un Syrah!'].    },
	caz: ['merlot']   fă: { Ieșire scrie: ['e un Merlot!'].   },
	caz: ['malbec']   fă: { Ieșire scrie: ['e un Malbec!'].   }.

Ieșire rând-nou.
