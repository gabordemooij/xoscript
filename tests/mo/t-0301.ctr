


>> wine := Obiect nou.


wine la: ['toString'] execută: { <- ['merlot'].
}.

wine la: ['naarTekst'] execută: { <- ['merlot'].
}.


wine la: ['='] execută: { :other wine <- ( sine toString = other wine ).
}.

wine la: ['=='] execută: { :other wine <- ( sine toString = other wine ).
}.



wine
	caz: ['cabernet'] fă: { Ieșire scrie: ['it's a Cabernet!']. },
	caz: ['syrah']    fă: { Ieșire scrie: ['it's a Syrah!'].    },
	caz: ['merlot']   fă: { Ieșire scrie: ['it's a Merlot!'].   },
	caz: ['malbec']   fă: { Ieșire scrie: ['it's a Malbec!'].   }.

Ieșire rând-nou.
