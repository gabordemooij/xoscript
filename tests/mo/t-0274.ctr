

Listă la: ['column:'] execută: { :column
	>> result := Listă nou.
	sine fiecare: { :index :row
		row fiecare: { :index :cell
			(index = column) adevărat: { result adaugă-la-sfârșit: cell. }.
		}.
	}. <- result.
}.


>> a := Listă ←
	(Listă ← 1 ; 2 ; 3) ;
	(Listă ← 4 ; 5 ; 6) ;
	(Listă ← 7 ; 8 ; 9).

>> b := a column: 1.
Ieșire scrie: b, rând-nou.

b := a column: 20.
Ieșire scrie: b, rând-nou.

b := a column: -100.
Ieșire scrie: b, rând-nou.
