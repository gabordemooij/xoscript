

Listă la: ['column:'] execută: { :coloană
	>> rezultat := Listă nou.
	sine fiecare: { :indice :rând
		rând fiecare: { :indice :celulă
			(indice = coloană) adevărat: { rezultat adaugă-la-sfârșit: celulă. }.
		}.
	}. <- rezultat.
}.


>> a := Listă ←
	(Listă ← 1 ; 2 ; 3) ;
	(Listă ← 4 ; 5 ; 6) ;
	(Listă ← 7 ; 8 ; 9).

>> b := a column: 1.
Ieșire scrie: b, rând-nou.

b := a column: 20.
Ieșire scrie: b, rând-nou.

b := a column: -100.
Ieșire scrie: b, rând-nou.
