>> Greeter := Obiect nou.
Greeter la: ['make'] execută: {
	>> greeter := Obiect nou.
	greeter la: ['name:'] execută: { :nume
		Ieșire scrie: ['setting a name'].
		propriu myName := nume.
	}.
	greeter la: ['performGreeting'] execută: {
		Ieșire scrie: ['Hello'].
		Ieșire scrie: propriu myName.
	}.
	greeter la: ['greet'] execută: {
		sine performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
