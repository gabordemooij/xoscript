Ieșire scrie: ['Test object'], rând-nou.
>> a := Obiect nou. 

a la: ['item:'] execută: { :moment
	propriu moment := moment. 
}.

a la: ['item'] execută: { <- propriu moment.
}.

>> today := Moment nou zonă: ['CEST'], an: 2026, lună: 7.
a item: today.
Ieșire scrie: a item, rând-nou.
a save-as: ['/tmp/a.bin'].
Ieșire scrie: ['========== RELOADING SNAP:'], rând-nou.
>> b := Obiect load-from: ['/tmp/a.bin'].
Ieșire scrie: b item, rând-nou.
