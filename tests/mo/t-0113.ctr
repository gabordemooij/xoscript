Ieșire scrie: ['Continuă bucla for, fără - înainte de 6 și peste.'], rând-nou.
{ :i
	Ieșire scrie: (i + 1), rând-nou.
	((i + 1) > 4) continuă.
	Ieșire scrie: ['-'].
} × 10.

>> x := 0.
>> xEsteMaiMicDecât10 := { <- ( x < 10 ). }.
Ieșire rând-nou.
Ieșire scrie: ['Continuă while-true, fără --> înainte de 5 și peste.'], rând-nou.
{
	Ieșire scrie: ['iteration #'] + x, rând-nou.
	x adaugă: 1.
	((x < 5) nu) continuă.
	Ieșire scrie: ['-->'].
} cât-timp: xEsteMaiMicDecât10.
Ieșire rând-nou.
Ieșire scrie: ['Continuă while-false, fără - doar înainte de 3.'], rând-nou.
{
	Ieșire scrie: ['iteration #'] + x, rând-nou.
	x scade: 1.
	(x = 3) continuă.
	Ieșire scrie: ['-'].
} cât-timp: { <- ( x > 0). }.

Ieșire rând-nou.
Ieșire scrie: ['Continuă bucla times, fără ||| înainte de 3.'], rând-nou.
{ :i
	Ieșire scrie: ['iteration #'] + i, rând-nou.
	(i = 2) continuă.
	Ieșire scrie: ['|||'].
} × 5.

Ieșire rând-nou.

{ Adevărat continuă. Ieșire scrie: ['nu scrie asta!'], rând-nou. } pornește.

{ Adevărat continuă. Ieșire scrie: ['nu scrie asta!'], rând-nou. } prinde: { Ieșire scrie: ['Nu prinde asta!']. }, pornește.

Ieșire scrie: ['Testează bucla each pe Listă: 0, ... ,2'], rând-nou.
(Listă ← 1 ; 2 ; 3) transformă: { :i
	(i = 1) continuă.
	Ieșire scrie: ['iteration #'] + (i - 0), rând-nou.
}.

Ieșire scrie: ['Testează bucla each pe Dicționar: doar c'], rând-nou.
>> m := Dicționar nou.
m pune: ['first'] la: ['a'], pune: ['second'] la: ['b'], pune: ['al treilea'] la: ['c'].
m fiecare: { :k :v
	(k ≠ ['c']) continuă.
	Ieșire scrie: ['iteration'] + k + v, rând-nou.
}.

