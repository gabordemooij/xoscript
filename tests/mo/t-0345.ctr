# test catch-all methods
>> x13 := Obiect nou.
x13 la: ['a'] execută: { :a Ieșire scrie: 0, rând-nou. }.
x13 la: ['a:'] execută: { :a Ieșire scrie: a, rând-nou. <- 5. }.
x13 la: ['a:b:'] execută: { :a :b Ieșire scrie: (a + b), rând-nou. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
