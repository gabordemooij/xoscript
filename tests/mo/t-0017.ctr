Număr la: ['factorial'] execută: {
	>> total := 1.
	{ :index total înmulțește-cu: (sine - (index)). } × sine. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Ieșire scrie: a.
>> b := 2 + 3 factorial.
Ieșire scrie: b.
>> c := 3 factorial + 2.
Ieșire scrie: c.
>> d := 2 + (3 factorial).
Ieșire scrie: d.
Ieșire scrie: 2 + 3 factorial + 1.
