# test operații cu liste


>> prăjituri := Listă ←
	['măr'] ;
	['fructe de pădure'] ;
	['ciocolată'] ;
	['brânză'].


>> cumpără := prăjituri înlocuiește: 1 lungime: 2 cu: ( Listă ← ['scorțișoară'] ; ['ananas'] ).
Ieșire scrie: (cumpără unește: [',']), rând-nou.


>> cumpără := prăjituri înlocuiește: 1 lungime: 12 cu: ( Listă ← ['scorțișoară'] ; ['ananas'] ).
Ieșire scrie: (cumpără unește: [',']), rând-nou.


>> cumpără := prăjituri înlocuiește: 2 lungime: 10 cu: ( Listă nou ).
Ieșire scrie: (cumpără unește: [',']), rând-nou.


>> cumpără := prăjituri înlocuiește: 0 lungime: 1 cu: ( Listă nou ).
Ieșire scrie: (cumpără unește: [',']), rând-nou.


>> cumpără := prăjituri înlocuiește: ['0'] lungime: ['1'] cu: ['x'].
Ieșire scrie: (cumpără unește: [',']), rând-nou.
