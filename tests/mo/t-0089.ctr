>> generatorAleator := { :a :b
	>> minim := ( a < b ) sau: a sau: b.
	>> maxim := ( a > b ) sau: a sau: b.
	>> x := Nimic.
	{
		x := Număr între: a și: b.
		((x < minim) sau: (x > maxim)) adevărat: { 
			Ieșire scrie: (['Valoare invalidă!']).
			Program sfârșit.
		}.
	} 
	× 100. <- x.
}.
