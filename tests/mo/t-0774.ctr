Ieșire scrie: ['Obiect de test'], rând-nou.
>> a := Obiect nou. 
a la: ['item:'] execută: { :lst
	propriu lst := lst. 
}.
a la: ['articol'] execută: {
	<- propriu lst.
}.
a item: (
	Listă nou ; 1 ; (
		Listă nou ; ['a'] ; (
			Listă nou ; ( Moment nou: 1 )
		) ; ( Int64 din-text: ['321'] )
	)
).
Ieșire scrie: a articol, rând-nou.
>> vechea-adresă-lst := a articol prototip adresă-memorie.
a save-as: ['/tmp/a.bin'].
Ieșire scrie: ['========== REÎNCĂRCARE SNAP:'], rând-nou.
>> b := Obiect load-from: ['/tmp/a.bin'].
(b articol prototip adresă-memorie = vechea-adresă-lst) adevărat: {
	Ieșire scrie: ['Legătura obiectului a fost reatașată.'], rând-nou.
}.
Ieșire scrie: ( b articol ), rând-nou.
