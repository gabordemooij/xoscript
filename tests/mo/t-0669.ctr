# Hash-uirea parolelor
Server init.

# Utilizatorul setează o parolă
>> prl := ['pass123'].

# O stocați astfel
>> amprentă := Seif 
	rezumat-parolă: prl.

# Apoi, utilizatorul se autentifică
# Încercarea 1
>> a1 := ['abcd123'].
# Încercarea 2
>> a2 := ['pass123'].

# Verificare
>> a := Seif 
	rezumat-parolă: amprentă verifică: a1.
	# eșec 
>> b := Seif
	rezumat-parolă: amprentă verifică: a2.
	# ok!

Ieșire scrie: a, rând-nou.
Ieșire scrie: b, rând-nou.

