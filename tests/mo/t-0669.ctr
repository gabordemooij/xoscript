# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Seif 
	rezumat-parolă: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Seif 
	rezumat-parolă: hash verifică: a1.
	# fail 
>> b := Seif
	rezumat-parolă: hash verifică: a2.
	# ok!

Ieșire scrie: a, rând-nou.
Ieșire scrie: b, rând-nou.

