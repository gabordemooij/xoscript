# cheie publică (pentru securizarea API-urilor etc.)
Server init.

# generăm chei
>> chei := Seif generează-chei.

# cheie privată (secretă)
>> cs := chei primul.

# cheie publică
>> cp := chei ultimul.

# semnăm un mesaj
>> semn := Seif semnează: ['abc'] cu: cs.

# verificăm mesajul (ok)
Ieșire scrie: ( 
	Seif
		verifică: ['abc'] 
		semnătură: semn 
		cu: cp 
), rând-nou.

# verificăm mesajul (eșec)
Ieșire scrie: ( 
	Seif 
		verifică: ['abd'] 
		semnătură: semn 
		cu: cp 
), rând-nou.