# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Seif generează-chei.

# private (secret) key
>> sk := keys primul.

# public key
>> pk := keys ultimul.

# sign a message
>> sig := Seif semnează: ['abc'] cu: sk.

# check message (ok)
Ieșire scrie: ( 
	Seif
		verifică: ['abc'] 
		semnătură: sig 
		cu: pk 
), rând-nou.

# check message (fail)
Ieșire scrie: ( 
	Seif 
		verifică: ['abd'] 
		semnătură: sig 
		cu: pk 
), rând-nou.