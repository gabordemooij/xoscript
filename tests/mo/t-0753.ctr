Ieșire scrie: ['Obiect de test'], rând-nou.
>> a := Obiect nou. 

a la: ['item:'] execută: { :fmt
	propriu fmt := fmt. 
}.

a la: ['articol'] execută: {
	<- propriu fmt.
}.

a item: ( Format nou: ['|%s|'] ).

Ieșire scrie: a articol, rând-nou.

>> vechea-adresă-fmt := a articol prototip adresă-memorie.
a save-as: ['/tmp/a.bin'].
Ieșire scrie: ['========== REÎNCĂRCARE SNAP:'], rând-nou.

>> b := Obiect load-from: ['/tmp/a.bin'].

(b articol prototip adresă-memorie = vechea-adresă-fmt) adevărat: {
	Ieșire scrie: ['Legătura obiectului a fost reatașată.'], rând-nou.
}.

Ieșire scrie: ( b articol aplică: ['hello'] ), rând-nou.
