Ieșire scrie: ['Test object'], rând-nou.
>> a := Obiect nou. 

a la: ['item:'] execută: { :fmt
	propriu fmt := fmt. 
}.

a la: ['item'] execută: { <- propriu fmt.
}.

a item: ( Format nou: ['|%s|'] ).

Ieșire scrie: a item, rând-nou.

>> old-fmt-address := a item prototip adresă-memorie.
a save-as: ['/tmp/a.bin'].
Ieșire scrie: ['========== RELOADING SNAP:'], rând-nou.

>> b := Obiect load-from: ['/tmp/a.bin'].

(b item prototip adresă-memorie = old-fmt-address) adevărat: {
	Ieșire scrie: ['Object link re-attached.'], rând-nou.
}.

Ieșire scrie: ( b item aplică: ['hello'] ), rând-nou.
