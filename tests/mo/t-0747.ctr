Ieșire scrie: ['Test object'], rând-nou.
>> a := Obiect nou. 

a la: ['item:'] execută: { :num
	propriu num := num. 
}.

a la: ['item'] execută: { <- propriu num.
}.

a item: 123.

Ieșire scrie: a item, rând-nou.

>> old-num-address := a item prototip adresă-memorie.
a save-as: ['/tmp/a.bin'].
Ieșire scrie: ['========== RELOADING SNAP:'], rând-nou.

>> b := Obiect load-from: ['/tmp/a.bin'].

(b item prototip adresă-memorie = old-num-address) adevărat: {
	Ieșire scrie: ['Object link re-attached.'], rând-nou.
}.

Ieșire scrie: b item, rând-nou.
