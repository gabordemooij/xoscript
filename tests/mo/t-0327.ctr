

Listă la: ['fixture:'] execută: { :f
	propriu fixture := f.
}.

Listă la: ['numără'] execută: { <- propriu fixture.
}.

Listă la: ['aantal'] execută: { <- propriu fixture.
}.


>> x := Nimic.
{

	x := ['hello'] 
	înlocuiește:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] caracter: 2)
			)
		)
	cu: (
		(['...hal'] + ['lo']) 
			majuscule 
			lowecase 
			majuscule 
			decalaj: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Listă ← 0 ; 1 ; 4; 9 ; (Listă ← 0 ; 3; 1) ; 4
							) penultimul
						) ? 1
					) + 
					((Listă ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					numără
				)
			)
	).

} × 10.
Ieșire scrie: x, rând-nou.

