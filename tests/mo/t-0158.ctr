>> x := [' hallo '].

>> y := x majuscule.
Ieșire scrie: x, rând-nou.
Ieșire scrie: (x egal-cu: y), rând-nou.

>> y := x minuscule.
Ieșire scrie: x, rând-nou.
Ieșire scrie: (x egal-cu: y), rând-nou.

>> y := x curăță-spații.
Ieșire scrie: x, rând-nou.
Ieșire scrie: (x egal-cu: y), rând-nou.

>> y := x decalaj: 1.
Ieșire scrie: x, rând-nou.
Ieșire scrie: (x egal-cu: y), rând-nou.

>> y := x de-la: 1 lungime: 2.
Ieșire scrie: x, rând-nou.
Ieșire scrie: (x egal-cu: y), rând-nou.