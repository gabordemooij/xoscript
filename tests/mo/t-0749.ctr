Ieșire scrie: ['Test object'], rând-nou.
>> a := Obiect nou. 

a la: ['item:'] execută: { :boolean
	propriu boolean := boolean. 
}.

a la: ['item'] execută: { <- propriu boolean.
}.

a item: Fals.

Ieșire scrie: a item, rând-nou.

>> old-bool-address := a item prototip adresă-memorie.
a save-as: ['/tmp/a.bin'].
Ieșire scrie: ['========== RELOADING SNAP:'], rând-nou.

>> b := Obiect load-from: ['/tmp/a.bin'].

(b item prototip adresă-memorie = old-bool-address) adevărat: {
	Ieșire scrie: ['Object link re-attached.'], rând-nou.
}.

Ieșire scrie: b item, rând-nou.
