

Listă la: ['sum'] execută: {
	>> total := 0.
	sine fiecare: { :index :element
		total adaugă: element.
	}. <- total.
}.

Listă la: ['product'] execută: {
	>> total := 1.
	sine fiecare: { :index :element
		total înmulțește-cu: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program gestiune-memorie: 0.

{

>> a := Listă ← ['hello'] ; ['world'] ; Adevărat ; Nimic ; 666.
a := a + ( Listă ← 1 ).
Ieșire scrie: ( ['sum: '] + ( a sum ) ), rând-nou.
Ieșire scrie: ( ['min: '] + ( a minim ) ), rând-nou.
Ieșire scrie: ( ['max: '] + ( a maxim ) ), rând-nou.
Ieșire scrie: ( ['3rd: '] + ( a ? 2 ) ), rând-nou.
Ieșire scrie: ( ['prd: '] + ( a product ) ), rând-nou.
a sortează: { :a :b <- (b - a). }.
a fiecare: { :i :e Ieșire scrie: ( i - 0 ), rând-nou. }.

} pornește.

Program curăță.
usedMemory1 := (Program memorie ? 0).


{

>> a := Listă ← ['hello'] ; ['world'] ; Adevărat ; Nimic ; 666.
a := a + ( Listă ← 1 ).
Ieșire scrie: ( ['sum: '] + ( a sum ) ), rând-nou.
Ieșire scrie: ( ['min: '] + ( a minim ) ), rând-nou.
Ieșire scrie: ( ['max: '] + ( a maxim ) ), rând-nou.
Ieșire scrie: ( ['3rd: '] + ( a ? 2 ) ), rând-nou.
Ieșire scrie: ( ['prd: '] + ( a product ) ), rând-nou.
a sortează: { :a :b <- (b - a). }.
a fiecare: { :i :e Ieșire scrie: ( i - 0 ), rând-nou. }.

} pornește.



Program curăță.
usedMemory2 := (Program memorie ? 0).


{

>> a := Listă ← ['hello'] ; ['world'] ; Adevărat ; Nimic ; 666.
a := a + ( Listă ← 1 ).
Ieșire scrie: ( ['sum: '] + ( a sum ) ), rând-nou.
Ieșire scrie: ( ['min: '] + ( a minim ) ), rând-nou.
Ieșire scrie: ( ['max: '] + ( a maxim ) ), rând-nou.
Ieșire scrie: ( ['3rd: '] + ( a ? 2 ) ), rând-nou.
Ieșire scrie: ( ['prd: '] + ( a product ) ), rând-nou.
a sortează: { :a :b <- (b - a). }.
a fiecare: { :i :e Ieșire scrie: ( i - 0 ), rând-nou. }.

