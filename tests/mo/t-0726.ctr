# test tampoane PKI/Semnare 
Server init.

>> lung := ( Listă nou umple: 1000 cu: ['a'] ) unește: [''].

# semnăm un mesaj
Ieșire scrie: ( 
	Seif semnează: ['abc'] cu: lung
), rând-nou.

Ieșire scrie: ( 
	Seif
		verifică: ['abc'] 
		semnătură: lung 
		cu: lung
), rând-nou.

Ieșire scrie: (
	Seif rezumat-parolă: lung verifică: lung
), rând-nou.
