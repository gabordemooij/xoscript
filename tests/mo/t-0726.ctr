# test buffers PKI/Sign 
Server init.

>> long := ( Listă nou umple: 1000 cu: ['a'] ) unește: [''].

# sign a message
Ieșire scrie: ( 
	Seif semnează: ['abc'] cu: long
), rând-nou.

Ieșire scrie: ( 
	Seif
		verifică: ['abc'] 
		semnătură: long 
		cu: long
), rând-nou.

Ieșire scrie: (
	Seif rezumat-parolă: long verifică: long
), rând-nou.
