{
	această-sarcină eroare: ['Dont fail.'].
	unknown doSomething.
} prinde: {
	Ieșire scrie: ['Caught!'].
}, pornește.

{
	această-sarcină eroare: ['Dont fail.'].
	propriu unknown doSomething.
} prinde: {
	Ieșire scrie: ['Caught!'].
}, pornește.

{
	această-sarcină eroare: ['Dont fail.'].
	unknown := 122.
} prinde: {
	Ieșire scrie: ['Caught!'].
}, pornește.


{
	această-sarcină eroare: ['Dont fail.'].
	Adevărat întrerupe.
	Ieșire scrie: ['FAIL'].
} prinde: {
	Ieșire scrie: ['Caught!'].
}, pornește.

{
	{
		această-sarcină eroare: ['Dont fail.'].
		Adevărat întrerupe.
		Ieșire scrie: ['FAIL'].
	} prinde: { :x
		(x = ['Dont fail.']) adevărat: { această-sarcină eroare: ['Nested Caught!']. }.
	}, pornește.
} prinde: { :e
	Ieșire scrie: e.
}, pornește.
