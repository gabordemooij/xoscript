Server init.
Ieșire scrie: ['Test de dată în baza de date'], rând-nou.

>> bd := Maria-DB nou gazdă: ['localhost'],
	utilizator: ['xo'], 
	parolă: ['pass123'],
	nume-bază: ['xobase'],
	conectează.

>> parametri-căutare :=
bd interogare: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
preia: { :rând
	Ieșire scrie: rând datetest, rând-nou.
}.
