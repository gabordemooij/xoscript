>> Greeter := Object nieuw.
Greeter bij: ['make'] doen: {
	>> gr := Object nieuw.
	gr bij: ['setName:'] doen: { :aname
		eigen naam := aname.
	}.
	gr bij: ['greet'] doen: {
		Uit schrijf: eigen naam.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a nieuw.
c setName: ['THREE'].
c greet.
>> d := a nieuw.
d setName: ['FOUR'].
d greet.
c greet.
