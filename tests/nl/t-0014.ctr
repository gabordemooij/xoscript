>> Begroeter := Object nieuw.
Begroeter bij: ['maak'] doen: {
	>> gr := Object nieuw.
	gr bij: ['setName:'] doen: { :eenNaam
		eigen naam := eenNaam.
	}.
	gr bij: ['groet'] doen: {
		Uit schrijf: eigen naam.
	}. <- gr.
}.
>> a := Begroeter maak.
>> b := Begroeter maak.
a setName: ['EEN'].
b setName: ['TWEE'].
a groet.
b groet.
>> c := a nieuw.
c setName: ['DRIE'].
c groet.
>> d := a nieuw.
d setName: ['VIER'].
d groet.
c groet.
