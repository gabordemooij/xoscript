

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programma geheugenbeheer: 0.

{ :i Uit schrijf: i. } × 4.
Uit stop.
{ :i Uit schrijf: (4 - i). } × 4.
Uit stop.
( 1 > 2 ) nee: { Uit schrijf: ['BLOCK 1'], stop. }.
( 2 > 1 ) ja:  { Uit schrijf: ['BLOCK 2'], stop. }.

>> i := 0.
{ Uit schrijf: i. i optellen: 1. } zolang: { <- ( i < 3). }.
Uit stop.

i := 3.
{ Uit schrijf: i. i := i - 1. } zolang: { <- ( i > 0). }.
Uit stop.


Programma vegen.

usedMemory1 := (Programma geheugen ? 0).


{ :i  Uit schrijf: i. } × 4.
Uit stop.
{ :i  Uit schrijf: (4 - i). } × 4.
Uit stop.
( 1 > 2 ) nee: { Uit schrijf: ['BLOCK 1'], stop. }.
( 2 > 1 ) ja:  { Uit schrijf: ['BLOCK 2'], stop. }.

>> i := 0.
{ Uit schrijf: i. i optellen: 1. } zolang: { <- ( i < 3). }.
Uit stop.

i := 3.
{ Uit schrijf: i. i := i - 1. } zolang: { <- ( i > 0). }.
Uit stop.



Programma vegen.
usedMemory2 := (Programma geheugen ? 0).


{ :i Uit schrijf: i. } × 4.
Uit stop.
{ :i Uit schrijf: (4 - i). } × 4.
Uit stop.
( 1 > 2 ) nee: { Uit schrijf: ['BLOCK 1'], stop. }.
( 2 > 1 ) ja:  { Uit schrijf: ['BLOCK 2'], stop. }.

>> i := 0.
{ Uit schrijf: i. i optellen: 1. } zolang: { <- ( i < 3). }.
Uit stop.

i := 3.
{ Uit schrijf: i. i := i - 1. } zolang: { <- ( i > 0). }.
Uit stop.

Programma vegen.
usedMemory3 := (Programma geheugen ? 0).



( usedMemory1 = usedMemory2 en: usedMemory1 = usedMemory3, en: usedMemory2 = usedMemory3 ) ja: {
	Uit schrijf: ['No memory leaks here'].
}, nee: {
	Uit schrijf: ['Leaking memory...'].
}.
