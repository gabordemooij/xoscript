

>> gebruiktGeheugen1 := 0.
>> gebruiktGeheugen2 := 0.
>> gebruiktGeheugen3 := 0.
>> gebruiktGeheugen4 := 0.

Programma geheugenbeheer: 0.

{ :i Uit schrijf: i. } × 4.
Uit stop.
{ :i Uit schrijf: (4 - i). } × 4.
Uit stop.
( 1 > 2 ) nee: { Uit schrijf: ['BLOK 1'], stop. }.
( 2 > 1 ) ja:  { Uit schrijf: ['BLOK 2'], stop. }.

>> i := 0.
{ Uit schrijf: i. i optellen: 1. } zolang: { <- ( i < 3). }.
Uit stop.

i := 3.
{ Uit schrijf: i. i := i - 1. } zolang: { <- ( i > 0). }.
Uit stop.


Programma vegen.

gebruiktGeheugen1 := (Programma geheugen ? 0).


{ :i  Uit schrijf: i. } × 4.
Uit stop.
{ :i  Uit schrijf: (4 - i). } × 4.
Uit stop.
( 1 > 2 ) nee: { Uit schrijf: ['BLOK 1'], stop. }.
( 2 > 1 ) ja:  { Uit schrijf: ['BLOK 2'], stop. }.

>> i := 0.
{ Uit schrijf: i. i optellen: 1. } zolang: { <- ( i < 3). }.
Uit stop.

i := 3.
{ Uit schrijf: i. i := i - 1. } zolang: { <- ( i > 0). }.
Uit stop.



Programma vegen.
gebruiktGeheugen2 := (Programma geheugen ? 0).


{ :i Uit schrijf: i. } × 4.
Uit stop.
{ :i Uit schrijf: (4 - i). } × 4.
Uit stop.
( 1 > 2 ) nee: { Uit schrijf: ['BLOK 1'], stop. }.
( 2 > 1 ) ja:  { Uit schrijf: ['BLOK 2'], stop. }.

>> i := 0.
{ Uit schrijf: i. i optellen: 1. } zolang: { <- ( i < 3). }.
Uit stop.

i := 3.
{ Uit schrijf: i. i := i - 1. } zolang: { <- ( i > 0). }.
Uit stop.

Programma vegen.
gebruiktGeheugen3 := (Programma geheugen ? 0).



( gebruiktGeheugen1 = gebruiktGeheugen2 en: gebruiktGeheugen1 = gebruiktGeheugen3, en: gebruiktGeheugen2 = gebruiktGeheugen3 ) ja: {
	Uit schrijf: ['Hier geen geheugenlekken'].
}, nee: {
	Uit schrijf: ['Geheugen lekt...'].
}.
