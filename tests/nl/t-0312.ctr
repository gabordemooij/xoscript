>> Slurp := Object nieuw.
Slurp bij: ['nieuw'] doen: {
	eigen str := [''].
}.
Slurp leer: ['nieuw'] betekent: ['nieuw'].
Slurp bij: ['reactie:'] doen: { :blah
		(eigen str ≠ ['']) ja: {
			eigen str toevoegen: [' '].
		}.
		eigen str toevoegen: blah.
}.
Slurp bij: ['reactie:argument:'] doen: { :blah :blahah
		(eigen str ≠ ['']) ja: {
			eigen str toevoegen: [' '].
		}.
		(blah lengte > 1) ja: {
			eigen str toevoegen: (blah van: 0 lengte: (blah lengte - 1)).
		}, anders: {
			eigen str toevoegen: blah.
		}.
		eigen str toevoegen: [' '].
		eigen str toevoegen: blahah.
}.
Slurp bij: ['verkrijg'] doen: {
	>> buffer := eigen str.
	eigen str := ['']. <- buffer.
}.


>> zoekparameters := Slurp nieuw
	select: ['*'],
	from
		gebruikers 
	where 
		user_id=: 1.

Uit schrijf: zoekparameters verkrijg, stop.
