# test list operations


>> cakes := Reeks ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes vervang: 1 lengte: 2 door: ( Reeks ← ['cinnamon'] ; ['pineapple'] ).
Uit schrijf: (buy samenvoegen: [',']), stop.


>> buy := cakes vervang: 1 lengte: 12 door: ( Reeks ← ['cinnamon'] ; ['pineapple'] ).
Uit schrijf: (buy samenvoegen: [',']), stop.


>> buy := cakes vervang: 2 lengte: 10 door: ( Reeks nieuw ).
Uit schrijf: (buy samenvoegen: [',']), stop.


>> buy := cakes vervang: 0 lengte: 1 door: ( Reeks nieuw ).
Uit schrijf: (buy samenvoegen: [',']), stop.


>> buy := cakes vervang: ['0'] lengte: ['1'] door: ['x'].
Uit schrijf: (buy samenvoegen: [',']), stop.
