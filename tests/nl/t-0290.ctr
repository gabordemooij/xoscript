# test reeksbewerkingen


>> taarten := Reeks ←
	['apple'] ;
	['bes'] ;
	['choco'] ;
	['kaas'].


>> koop := taarten vervang: 1 lengte: 2 door: ( Reeks ← ['kaneel'] ; ['ananas'] ).
Uit schrijf: (koop samenvoegen: [',']), stop.


>> koop := taarten vervang: 1 lengte: 12 door: ( Reeks ← ['kaneel'] ; ['ananas'] ).
Uit schrijf: (koop samenvoegen: [',']), stop.


>> koop := taarten vervang: 2 lengte: 10 door: ( Reeks nieuw ).
Uit schrijf: (koop samenvoegen: [',']), stop.


>> koop := taarten vervang: 0 lengte: 1 door: ( Reeks nieuw ).
Uit schrijf: (koop samenvoegen: [',']), stop.


>> koop := taarten vervang: ['0'] lengte: ['1'] door: ['x'].
Uit schrijf: (koop samenvoegen: [',']), stop.
