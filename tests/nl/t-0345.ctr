# test catch-all methods
>> x13 := Object nieuw.
x13 bij: ['a'] doen: { :a Uit schrijf: 0, stop. }.
x13 bij: ['a:'] doen: { :a Uit schrijf: a, stop. <- 5. }.
x13 bij: ['a:b:'] doen: { :a :b Uit schrijf: (a + b), stop. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
