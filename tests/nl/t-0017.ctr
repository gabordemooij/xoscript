Getal bij: ['factorial'] doen: {
	>> total := 1.
	{ :index total keer: (zelf - (index)). } × zelf. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Uit schrijf: a.
>> b := 2 + 3 factorial.
Uit schrijf: b.
>> c := 3 factorial + 2.
Uit schrijf: c.
>> d := 2 + (3 factorial).
Uit schrijf: d.
Uit schrijf: 2 + 3 factorial + 1.
