Getal bij: ['faculteit'] doen: {
	>> totaal := 1.
	{ :index totaal keer: (zelf - (index)). } × zelf. <- totaal.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Uit schrijf: a.
>> b := 2 + 3 faculteit.
Uit schrijf: b.
>> c := 3 faculteit + 2.
Uit schrijf: c.
>> d := 2 + (3 faculteit).
Uit schrijf: d.
Uit schrijf: 2 + 3 faculteit + 1.
