# databanktest
# zie voorbeeld server.xo voor de vereiste configuratie

Server init.
Uit schrijf: ['Databasetest'], stop.

>> db := Maria-DB nieuw host: ['localhost'],
	gebruikersnaam: ['xo'], wachtwoord: ['pass123'], databanknaam: ['xobase'], verbinden.

Uit schrijf: ['Kunnen we verbinden? '] + db verbinding?, stop.

>> zoekparameters := db query: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parameters: ( Reeks nieuw ; ['abc'] ; 12.35 ; 6 ). # geparametriseerde queries

{  zoekparameters uitvoeren. db bevestigen. } afhandelen: { :e db terugdraaien.  }, start.

Uit schrijf: ['Kunnen we invoegen? '] + ( zoekparameters insert-id > 0 ), stop.

>> x := 0.
>> zoekparameters :=
db query: ['SELECT * FROM book order by id desc limit 2'], 
ophalen: { :rij 
	x optellen: 1.
	Ja afbreken. # moet opruimen, geen 'Commands out of sync'
}.

>> zoekparameters :=
db query: ['SELECT * FROM book order by id desc limit 2'], 
ophalen: { :rij
	x optellen: 1.
	Ja afbreken.
}.

(x > 0) ja: {
	Uit schrijf: ['Kunnen we midden in een fetch onderbreken? '].
}.

Uit schrijf: Ja, stop.