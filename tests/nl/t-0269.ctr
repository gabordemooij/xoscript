#Linux

(Bestand nieuw: ['/tmp/testje']) bestaat nee: {
	Programma opdrachtregel: ['mkdir /tmp/testje'].	
}.

(Bestand nieuw: ['/tmp/testje/file1']) bestaat nee: {
	Programma opdrachtregel: ['touch /tmp/testje/file1'].	
}.

(Bestand nieuw: ['/tmp/testje/folder1']) bestaat nee: {
	Programma opdrachtregel: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Bestand reeks: ['/tmp/testje'].

>> q := Reeks nieuw.

l elk: { :k :v v elk: { :x :y q toevoegen: y. }. }.

>> s := q tekst.

(s bevat: ['file1']) ja:   { Uit schrijf: ['OK'], stop. }.
(s bevat: ['file2']) ja:   { Uit schrijf: ['XX'], stop. }.
(s bevat: ['folder1']) ja: { Uit schrijf: ['OK'], stop. }.
