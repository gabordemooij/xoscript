>> items := Lijst nieuw.
items zet: ['zwart'] bij: ['coffee'], zet: ['earl grey'] bij: ['thee'].
Uit schrijf: (items bij: ['coffee']), schrijf: (items bij: ['thee']).
Uit schrijf: ['er zijn'] + items aantal + [' items in de reeks.'].
items zet: ['capuccino'] bij: ['coffee'].
Uit schrijf: ['Nu is mijn koffie.. '] + (items bij: ['coffee']).
items zet: ['aaa'] bij: ['1'].
items zet: ['bbb'] bij: ['2'].
Uit schrijf: (items bij: ['a']).
