>> x := [' hallo '].

>> y := x hoofdletters.
Uit schrijf: x, stop.
Uit schrijf: (x gelijk: y), stop.

>> y := x kleine-letters.
Uit schrijf: x, stop.
Uit schrijf: (x gelijk: y), stop.

>> y := x kern.
Uit schrijf: x, stop.
Uit schrijf: (x gelijk: y), stop.

>> y := x overslaan: 1.
Uit schrijf: x, stop.
Uit schrijf: (x gelijk: y), stop.

>> y := x van: 1 lengte: 2.
Uit schrijf: x, stop.
Uit schrijf: (x gelijk: y), stop.