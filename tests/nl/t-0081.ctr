>> map1 := Lijst nieuw.
>> key1 := Reeks nieuw.
>> key2 := Reeks nieuw.

map1
	zet: ['hello'] bij: key1,
	zet: ['world'] bij: key2.


Uit
	schrijf: ['Map #1 contains: '] + (map1 bij: key1),
	schrijf: [' and '] + (map1 bij: key2), stop.

>> KeyeableArray := Reeks nieuw.
KeyeableArray bij: ['toString'] doen: { <- (zelf aantal) toString.
}.

>> map2 := Lijst nieuw.
key1 := KeyeableArray nieuw.
key2 := KeyeableArray nieuw.

key1 toevoegen: 1.

map2
	zet: ['hello'] bij: key1,
	zet: ['world'] bij: key2.

Uit
	schrijf: ['Map #2 contains: '] + (map2 bij: key1),
	schrijf: [' and '] + (map2 bij: key2), stop.
