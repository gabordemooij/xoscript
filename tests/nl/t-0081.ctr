>> lijst1 := Lijst nieuw.
>> sleutel1 := Reeks nieuw.
>> sleutel2 := Reeks nieuw.

lijst1
	zet: ['hello'] bij: sleutel1,
	zet: ['world'] bij: sleutel2.


Uit
	schrijf: ['Map #1 contains: '] + (lijst1 bij: sleutel1),
	schrijf: [' en '] + (lijst1 bij: sleutel2), stop.

>> SleutelbareReeks := Reeks nieuw.
SleutelbareReeks bij: ['naarTekst'] doen: { <- (zelf aantal) naarTekst.
}.

>> map2 := Lijst nieuw.
sleutel1 := SleutelbareReeks nieuw.
sleutel2 := SleutelbareReeks nieuw.

sleutel1 toevoegen: 1.

map2
	zet: ['hello'] bij: sleutel1,
	zet: ['world'] bij: sleutel2.

Uit
	schrijf: ['Map #2 contains: '] + (map2 bij: sleutel1),
	schrijf: [' en '] + (map2 bij: sleutel2), stop.
