#Linux
>> klok := Moment nieuw.
klok zone: ['UTC-1'].
klok jaar: 1981, maand: 1, dag: 5,
      uur: 13, minuut: 15, seconde: 13.

Uit schrijf: klok, stop.
klok zone: ['UTC+0'].

Uit schrijf: (
	(klok jaar ruw) + ['-'] + (klok maand) + ['-'] + (klok dag) + [' '] +
	(klok uur) + [':'] + (klok minuut) + [':'] + (klok seconde) + [' '] +
	['W'] + (klok week) + (klok zone)
), stop.


klok zone: ['UTC-1'].
Uit schrijf: (
	(klok jaar ruw) + ['-'] + (klok maand) + ['-'] + (klok dag) + [' '] +
	(klok uur) + [':'] + (klok minuut) + [':'] + (klok seconde) + [' '] +
	['W'] + (klok week) + (klok zone)
), stop.
