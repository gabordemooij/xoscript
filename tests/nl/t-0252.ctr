#Linux
>> clock := Moment nieuw.
clock zone: ['UTC-1'].
clock jaar: 1981, maand: 1, dag: 5,
      uur: 13, minuut: 15, seconde: 13.

Uit schrijf: clock, stop.
clock zone: ['UTC+0'].

Uit schrijf: (
	(clock jaar ruw) + ['-'] + (clock maand) + ['-'] + (clock dag) + [' '] +
	(clock uur) + [':'] + (clock minuut) + [':'] + (clock seconde) + [' '] +
	['W'] + (clock week) + (clock zone)
), stop.


clock zone: ['UTC-1'].
Uit schrijf: (
	(clock jaar ruw) + ['-'] + (clock maand) + ['-'] + (clock dag) + [' '] +
	(clock uur) + [':'] + (clock minuut) + [':'] + (clock seconde) + [' '] +
	['W'] + (clock week) + (clock zone)
), stop.
