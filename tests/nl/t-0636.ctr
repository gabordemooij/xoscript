# test url parsing

Server init.
>> url := URL van: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Uit schrijf: ['scheme = '] + url schema, stop.
Uit schrijf: ['host = '] + url host, stop.
Uit schrijf: ['port = '] + url poort, stop.
Uit schrijf: ['path = '] + url pad, stop.
Uit schrijf: ['query = '] + url zoekparameters, stop.
Uit schrijf: ['fragment = '] + url anker, stop.
