>> factuur := Object nieuw.
factuur bij: ['start'] doen: {
        eigen getal := 0.
}.

factuur bij: ['getal'] doen: {
        eigen getal optellen: 1.
        <- eigen getal kopieer.
}.

>> jaarfactuur := factuur nieuw.
jaarfactuur bij: ['start:'] doen: { :jaar
	eigen getal := jaar.
}.

jaarfactuur start: 202000.
Uit schrijf: jaarfactuur getal, stop.
Uit schrijf: jaarfactuur getal, stop.
