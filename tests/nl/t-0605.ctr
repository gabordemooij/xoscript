>> invoice := Object nieuw.
invoice bij: ['start'] doen: {
        eigen getal := 0.
}.

invoice bij: ['getal'] doen: {
        eigen getal optellen: 1. <- eigen getal kopieer.
}.

>> year-invoice := invoice nieuw.
year-invoice bij: ['start:'] doen: { :jaar
	eigen getal := jaar.
}.

year-invoice start: 202000.
