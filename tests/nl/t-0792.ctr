Server init.

>> DB := Maria-DB nieuw host: ['localhost'],
	gebruikersnaam: ['xo'],
	wachtwoord: ['pass123'],
	databanknaam: ['xobase'],
	verbinden.
	
>> SQL := ['SELECT "hello" AS "world" '].

# een snellere manier, query ophalen uit DB:
>> query2 := DB query: SQL.

# nu hoef je DB niet in te stellen
query2 ophalen: { :rij
	Uit schrijf: rij world, stop.
}.
