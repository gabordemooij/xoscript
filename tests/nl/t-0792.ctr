Server init.

>> DB := Maria-DB nieuw host: ['localhost'],
	gebruikersnaam: ['xo'],
	wachtwoord: ['pass123'],
	databanknaam: ['xobase'],
	verbinden.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB query: SQL.

# now you don't have to set DB
query2 ophalen: { :row
	Uit schrijf: row world, stop.
}.
