Server init.
>> fmt := Format nieuw: ['%#3x'].

>> blob := Blob nieuw: 4.
blob bytes: ( 
	Reeks nieuw ; 0 ; 1 ; 2 ; 3
).

>> file := Bestand nieuw: ['/tmp/blob'].
file blob: blob.
blob vrij.

>> lezen := file blob.
lezen 
van: 0 
lengte: 4, 
doen elk: { :i :b 
	Uit
	schrijf: (fmt toepassen-int: b),
	stop.
}.
lezen vrij.
