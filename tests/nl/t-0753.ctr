Uit schrijf: ['Testobject'], stop.
>> a := Object nieuw. 

a bij: ['item:'] doen: { :fmt
	eigen fmt := fmt. 
}.

a bij: ['onderdeel'] doen: {
	<- eigen fmt.
}.

a item: ( Format nieuw: ['|%s|'] ).

Uit schrijf: a onderdeel, stop.

>> oud-fmt-adres := a onderdeel prototype geheugenadres.
a save-as: ['/tmp/a.bin'].
Uit schrijf: ['========== SNAP HERLADEN:'], stop.

>> b := Object load-from: ['/tmp/a.bin'].

(b onderdeel prototype geheugenadres = oud-fmt-adres) ja: {
	Uit schrijf: ['Objectkoppeling opnieuw verbonden.'], stop.
}.

Uit schrijf: ( b onderdeel toepassen: ['hello'] ), stop.
