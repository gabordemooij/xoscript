



>> Koffiedik := Object nieuw.
Koffiedik bij: ['trek'] doen: { <- ['coffee']. }.

>> Koffiemachine := Object nieuw.
Koffiemachine bij: ['init'] doen: {
	eigen koffiedik := Koffiedik nieuw.
}.
Koffiemachine bij: ['nieuw'] doen: { <- Koffiemachine `new init.
}.

Koffiemachine bij: ['zetThee'] doen: { <- (eigen theeblaadjes trek). }.
Koffiemachine bij: ['zetKoffie'] doen: { <- (eigen koffiedik trek). }.

>> koffiedroom := Koffiemachine nieuw.

Uit schrijf:
	koffiedroom 
	zetKoffie.

Uit schrijf:
	koffiedroom 
	zetThee.
