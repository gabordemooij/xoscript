



>> CoffeeGrounds := Object nieuw.
CoffeeGrounds bij: ['extract'] doen: { <- ['coffee']. }.

>> CoffeeMachine := Object nieuw.
CoffeeMachine bij: ['init'] doen: {
	eigen coffeegrounds := CoffeeGrounds nieuw.
}.
CoffeeMachine bij: ['nieuw'] doen: { <- CoffeeMachine `new init.
}.

CoffeeMachine bij: ['makeTea'] doen: { <- (eigen tealeaves extract). }.
CoffeeMachine bij: ['makeCoffee'] doen: { <- (eigen coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine nieuw.

Uit schrijf:
	coffeeDream 
	makeCoffee.

Uit schrijf:
	coffeeDream 
	makeTea.
