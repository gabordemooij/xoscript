>> zinnen := Reeks nieuw
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> bericht := ['Phrase: ~decoded base64: ~encoded'].
	
zinnen elk: { :_ :zin 
	>> e := Server base64-coderen: zin.
	>> d := Server base64-decoderen: e.
	Uit schrijf: (
		bericht kopieer ~encoded: e, ~decoded: d
	), stop.
}.
