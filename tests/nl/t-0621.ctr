>> phrases := Reeks nieuw
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases elk: { :_ :phrase 
	>> e := Server base64-coderen: phrase.
	>> d := Server base64-decoderen: e.
	Uit schrijf: (
		message kopieer ~encoded: e, ~decoded: d
	), stop.
}.
