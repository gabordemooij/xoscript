# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Programma instelling: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server koppel: ( Reeks nieuw ;
 libname ; ['fopen'] ;
 ( Reeks nieuw ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
koppel: ( Reeks nieuw ;
 Niets ; # means same lib
 ['fread'] ;
 ( Reeks nieuw ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Niets ; # means same object (i.e. Stream)
 ['fread']
),
koppel: (
 Reeks nieuw ;
 Niets ; # means same lib
 ['fwrite'] ;
 ( Reeks nieuw ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Niets ; # means same lib
 ['fwrite']
),
koppel: (
 Reeks nieuw ;
 Niets ; # means same lib
 ['rewind'] ;
 ( Reeks nieuw ; ['pointer'] ) ;
 ['int'] ;
 Niets ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> pad := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: pad mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream bericht: ['fwrite'] argumenten: (Reeks nieuw ; str ; 1 ; 6 ; fd ).
Uit schrijf: bytes-written, stop.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob nieuw: 20.

# read from file
>> bytes-read := Stream bericht: ['fread'] argumenten: (Reeks nieuw ; buf ; 1 ; 6 ; fd ).
Uit schrijf: bytes-read, stop.
Uit schrijf: buf, stop.

# free memory
str  vrij.
pad vrij.
mode vrij.
buf  vrij.


