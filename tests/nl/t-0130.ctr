# FFI gebruiken met de Server-plugin

# verbinden met libc (platformafhankelijk)
>> bibnaam := Programma instelling: ['FFITESTLIB'].

# stdio-functies uit C koppelen voor geavanceerde bestandsbewerkingen
Server koppel: ( Reeks nieuw ;
 bibnaam ; ['fopen'] ;
 ( Reeks nieuw ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
koppel: ( Reeks nieuw ;
 Niets ; # betekent dezelfde bibliotheek
 ['fread'] ;
 ( Reeks nieuw ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Niets ; # betekent hetzelfde object (d.w.z. Stroom)
 ['fread']
),
koppel: (
 Reeks nieuw ;
 Niets ; # betekent dezelfde bibliotheek
 ['fwrite'] ;
 ( Reeks nieuw ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Niets ; # betekent dezelfde bibliotheek
 ['fwrite']
),
koppel: (
 Reeks nieuw ;
 Niets ; # betekent dezelfde bibliotheek
 ['rewind'] ;
 ( Reeks nieuw ; ['pointer'] ) ;
 ['int'] ;
 Niets ; # betekent dezelfde bibliotheek
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> pad := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open een bestand met fopen(path, mode)
>> fd := Stream path: pad mode: mode.

# schrijf bytes uit buffer tekenreeks naar bestand
>> bytes-geschreven := Stream bericht: ['fwrite'] argumenten: (Reeks nieuw ; str ; 1 ; 6 ; fd ).
Uit schrijf: bytes-geschreven, stop.

# bestandswijzer terugzetten
Stream rewind: fd.

# een buffer reserveren
>> buf := Blob nieuw: 20.

# lezen uit bestand
>> bytes-gelezen := Stream bericht: ['fread'] argumenten: (Reeks nieuw ; buf ; 1 ; 6 ; fd ).
Uit schrijf: bytes-gelezen, stop.
Uit schrijf: buf, stop.

# geheugen vrijgeven
str  vrij.
pad vrij.
mode vrij.
buf  vrij.


