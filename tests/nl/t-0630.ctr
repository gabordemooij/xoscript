#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Patroon nieuw: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern overeenkomst: subject doen: { :m :x
	Uit schrijf: m, stop.
	Uit schrijf: x, stop. <- ['XXX'].
}.
Uit schrijf: result, stop.