#regex-test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> patroon := Patroon nieuw: ['href="([^"]+)" target="([^"]+)"'].
>> resultaat  := patroon overeenkomst: subject doen: { :m :x
	Uit schrijf: m, stop.
	Uit schrijf: x, stop.
	<- ['XXX'].
}.
Uit schrijf: resultaat, stop.