>> Slurp := Object nieuw.
Slurp bij: ['nieuw'] doen: {
	eigen str := [''].
}.

Slurp bij: ['reactie:'] doen: { :blah
		(eigen str ≠ ['']) ja: {
			eigen str toevoegen: [' '].
		}.
		eigen str toevoegen: blah.
}.
Slurp bij: ['reactie:argument:'] doen: { :blah :blahah
		(eigen str ≠ ['']) ja: {
			eigen str toevoegen: [' '].
		}.
		(blah lengte > 1) ja: {
			eigen str toevoegen: (blah van: 0 lengte: (blah lengte - 1)).
		}, anders: {
			eigen str toevoegen: blah.
		}.
		eigen str toevoegen: [' '].
		eigen str toevoegen: blahah.
}.
Slurp bij: ['obtain'] doen: {
	>> buffer := eigen str.
	eigen str := ['']. <- buffer.
}.

>> s := Slurp nieuw.
s hello: ['world'].
Uit schrijf: ( s obtain ), stop.
