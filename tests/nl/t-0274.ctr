

Reeks bij: ['column:'] doen: { :kolom
	>> resultaat := Reeks nieuw.
	zelf elk: { :index :rij
		rij elk: { :index :cel
			(index = kolom) ja: { resultaat toevoegen: cel. }.
		}.
	}. <- resultaat.
}.


>> a := Reeks ←
	(Reeks ← 1 ; 2 ; 3) ;
	(Reeks ← 4 ; 5 ; 6) ;
	(Reeks ← 7 ; 8 ; 9).

>> b := a column: 1.
Uit schrijf: b, stop.

b := a column: 20.
Uit schrijf: b, stop.

b := a column: -100.
Uit schrijf: b, stop.
