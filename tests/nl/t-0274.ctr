

Reeks bij: ['column:'] doen: { :column
	>> result := Reeks nieuw.
	zelf elk: { :index :row
		row elk: { :index :cell
			(index = column) ja: { result toevoegen: cell. }.
		}.
	}. <- result.
}.


>> a := Reeks ←
	(Reeks ← 1 ; 2 ; 3) ;
	(Reeks ← 4 ; 5 ; 6) ;
	(Reeks ← 7 ; 8 ; 9).

>> b := a column: 1.
Uit schrijf: b, stop.

b := a column: 20.
Uit schrijf: b, stop.

b := a column: -100.
Uit schrijf: b, stop.
