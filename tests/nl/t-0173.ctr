

Reeks bij: ['som'] doen: {
	>> totaal := 0.
	zelf elk: { :index :element
		totaal optellen: element.
	}. <- totaal.
}.

Reeks bij: ['product'] doen: {
	>> totaal := 1.
	zelf elk: { :index :element
		totaal keer: element.
	}. <- totaal.
}.

>> gebruiktGeheugen1 := 0.
>> gebruiktGeheugen2 := 0.
>> gebruiktGeheugen3 := 0.
>> gebruiktGeheugen4 := 0.

Programma geheugenbeheer: 0.

{

>> a := Reeks ← ['hello'] ; ['world'] ; Ja ; Niets ; 666.
a := a + ( Reeks ← 1 ).
Uit schrijf: ( ['som: '] + ( a som ) ), stop.
Uit schrijf: ( ['min: '] + ( a minimum ) ), stop.
Uit schrijf: ( ['max: '] + ( a maximum ) ), stop.
Uit schrijf: ( ['3e: '] + ( a ? 2 ) ), stop.
Uit schrijf: ( ['prd: '] + ( a product ) ), stop.
a sorteren: { :a :b <- (b - a). }.
a elk: { :i :e Uit schrijf: ( i - 0 ), stop. }.

} start.

Programma vegen.
gebruiktGeheugen1 := (Programma geheugen ? 0).


