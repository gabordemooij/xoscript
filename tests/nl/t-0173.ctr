

Reeks bij: ['sum'] doen: {
	>> total := 0.
	zelf elk: { :index :element
		total optellen: element.
	}. <- total.
}.

Reeks bij: ['product'] doen: {
	>> total := 1.
	zelf elk: { :index :element
		total keer: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programma geheugenbeheer: 0.

{

>> a := Reeks ← ['hello'] ; ['world'] ; Ja ; Niets ; 666.
a := a + ( Reeks ← 1 ).
Uit schrijf: ( ['sum: '] + ( a sum ) ), stop.
Uit schrijf: ( ['min: '] + ( a minimum ) ), stop.
Uit schrijf: ( ['max: '] + ( a maximum ) ), stop.
Uit schrijf: ( ['3rd: '] + ( a ? 2 ) ), stop.
Uit schrijf: ( ['prd: '] + ( a product ) ), stop.
a sorteren: { :a :b <- (b - a). }.
a elk: { :i :e Uit schrijf: ( i - 0 ), stop. }.

} start.

Programma vegen.
usedMemory1 := (Programma geheugen ? 0).


