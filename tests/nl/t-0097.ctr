
Tekst bij: ['html'] doen: { <- (
		zelf
		vervang: ['&'] door: ['&amp;'],
		vervang: ['<'] door: ['&lt;'],
		vervang: ['>'] door: ['&gt;'],
		vervang: ['"'] door: ['&quot;']
	).
}.

>> HtmlPenseel := Object nieuw.

HtmlPenseel bij: ['reactie:'] doen: { :tag
	Uit schrijf: (['<tag>↵'] tag: tag ).
}.

HtmlPenseel bij: ['reactie:argument:'] doen: { :tag :content
	tag := ( tag van: 0 lengte: (tag lengte - 1) ).
	Uit schrijf: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlPenseel bij: ['content:'] doen: { :tekstinhoud
	Uit schrijf: tekstinhoud html, stop.
}.

HtmlPenseel bij: ['attr:waarde:'] doen: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlPenseel nieuw.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] waarde: ['bold']),
		/span
	/body
/html.
		
