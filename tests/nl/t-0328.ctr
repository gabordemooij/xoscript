Programma geheugenbeheer: 4.

>> Doubler := Object nieuw.
>> Multiplier := Object nieuw.
Doubler bij: ['double:and:'] doen: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier bij: ['multiply:and:'] doen: { :x :y <- (x × y).
}.

Uit schrijf: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), stop.
