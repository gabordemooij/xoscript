# session cookie format, json content type, web protocols only, svg shown inline
Server initialiseren.
Programma gebruik: ['../../../src/xo/nl/webtools.xo'].

>> Fake-Request := Object nieuw.
Fake-Request bij: ['value:'] doen: { :waarde
	eigen waarde := waarde.
}.
Fake-Request bij: ['cookie:'] doen: { :naam <- eigen waarde.
}.

>> Test-Session := Tijdelijk-bestand-sessie nieuw.
Test-Session bij: ['laden'] doen: { <- Lijst nieuw.
}.
Test-Session bij: ['session-id'] doen: { <- eigen id.
}.

>> cookies := Reeks nieuw
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

cookies elk: { :i :cookie
	>> verzoek := Fake-Request nieuw.
	verzoek value: cookie.
	>> beheerder := Test-Session nieuw.
	>> web := Webdocument nieuw.
	web verzoek: verzoek.
	web sessiebeheerder: beheerder.
	web sessie-starten.
	Uit schrijf: ( beheerder session-id = cookie ), stop.
}.

>> web := Webdocument nieuw.
web json: (Lijst nieuw zet: ['b'] bij: ['a']).
Uit schrijf: ['\n'], stop.

{ Net get: ['file:///etc/hostname']. } afhandelen: { :e
	Uit schrijf: e, stop.
}, start.

>> svg := Bestand nieuw: ['/tmp/test0814.svg'].
svg schrijf: ['<svg xmlns="x"></svg>'].
Uit stop.
Server doorgave: ['test0814.svg'] prefix: ['/tmp/'].
svg verwijderen.
