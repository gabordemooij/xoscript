# sessiecookie-formaat, json-contenttype, alleen webprotocollen, svg inline getoond
Server initialiseren.
Programma gebruik: ['../../../src/xo/nl/webtools.xo'].

>> Nep-Verzoek := Object nieuw.
Nep-Verzoek bij: ['value:'] doen: { :waarde
	eigen waarde := waarde.
}.
Nep-Verzoek bij: ['cookie:'] doen: { :naam
	<- eigen waarde.
}.

>> Test-Sessie := Tijdelijk-bestand-sessie nieuw.
Test-Sessie bij: ['laden'] doen: {
	<- Lijst nieuw.
}.
Test-Sessie bij: ['sessie-nummer'] doen: {
	<- eigen id.
}.

>> cookies := Reeks nieuw
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

cookies elk: { :i :cookie
	>> verzoek := Nep-Verzoek nieuw.
	verzoek value: cookie.
	>> beheerder := Test-Sessie nieuw.
	>> web := Webdocument nieuw.
	web verzoek: verzoek.
	web sessiebeheerder: beheerder.
	web sessie-starten.
	Uit schrijf: ( beheerder sessie-nummer = cookie ), stop.
}.

>> web := Webdocument nieuw.
web json: (Lijst nieuw zet: ['b'] bij: ['a']).
Uit schrijf: ['\n'], stop.

{ Net get: ['file:///etc/hostname']. } afhandelen: { :e
	Uit schrijf: e, stop.
}, start.

>> svg := Bestand nieuw: ['/tmp/test0814.svg'].
svg schrijf: ['<svg xmlns="x"></svg>'].
Uit stop.
Server doorgave: ['test0814.svg'] prefix: ['/tmp/'].
svg verwijderen.
