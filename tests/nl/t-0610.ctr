
>> Rechthoek := Object nieuw.

Rechthoek bij: ['oppervlakte'] doen: {
	<- eigen lengte * eigen breedte.
}.

Rechthoek bij: ['length:'] doen: { :lengte
	eigen lengte := lengte.
}.

Rechthoek bij: ['width:'] doen: { :breedte
	eigen breedte := breedte.
}.

Rechthoek bij: ['nieuw'] doen: {
	# dit leidt niet tot een oneindige lus
	>> rechthoek := zelf nieuw.
	rechthoek length: 0, width: 0.
	<- rechthoek.
}.

>> a := Rechthoek nieuw.
Uit schrijf: a oppervlakte, stop. #0

>> b := Rechthoek nieuw length: 2, width: 3.
Uit schrijf: b oppervlakte, stop. #6

