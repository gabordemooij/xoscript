
>> Rectangle := Object nieuw.

Rectangle bij: ['area'] doen: { <- eigen lengte * eigen width.
}.

Rectangle bij: ['length:'] doen: { :lengte
	eigen lengte := lengte.
}.

Rectangle bij: ['width:'] doen: { :width
	eigen width := width.
}.

Rectangle bij: ['nieuw'] doen: {
	# this will not result into an infinite loop
	>> rectangle := zelf nieuw.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle nieuw.
Uit schrijf: a area, stop. #0

>> b := Rectangle nieuw length: 2, width: 3.
Uit schrijf: b area, stop. #6

