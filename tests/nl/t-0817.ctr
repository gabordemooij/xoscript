# een waarde die eindigt op het eerste deel van een openingsaanhalingsteken moet serialisatie overleven
>> waarden := Reeks nieuw
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

waarden elk: { :i :value
	>> d := Lijst nieuw.
	d zet: value bij: ['k'].
	d zet: ['second'] bij: ['j'].
	>> r := d code object.
	Uit schrijf: r aantal, stop.
	Uit schrijf: ( (r bij: ['k']) = value ), stop.
}.
