# test qualifiers

>> $ := Object nieuw.

$ bij: ['reactie:'] doen: { :x
	
	>> operation := x letter: 0.
	>> valuta := x letter: 1.
	>> money := x overslaan: 2.
	
	>> amount := 0.

	( operation = ['+'] ) ja: {
		( valuta = ['£'] ) ja: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Uit schrijf: x, stop.


>> Fruit := Object nieuw.

Fruit bij: ['nieuw'] doen: {
	>> f := zelf nieuw.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit bij: ['apples:'] doen: { :a eigen apples := a. }.
Fruit bij: ['oranges:'] doen: { :p eigen oranges := p. }.
Fruit bij: ['apples'] doen: { <- eigen apples. }.
Fruit bij: ['oranges'] doen: { <- eigen oranges. }.

Fruit bij: ['+'] doen: { :f
	
	>> n := Fruit nieuw.
	f optellen: 1.
	
	n apples: (f apples + eigen apples).
	n oranges:  (f oranges  + eigen oranges). <- n.
}.

Fruit bij: ['tekst'] doen: { <- ( eigen apples tekst + [' apples and '] + eigen oranges + [' oranges'] ).
}.

Getal bij: ['apples'] doen: { <- ((Fruit nieuw) apples: zelf).
}.

Getal bij: ['apple'] doen: { <- ((Fruit nieuw) apples: zelf).
}.

Getal bij: ['oranges'] doen: { <- ((Fruit nieuw) oranges: zelf).
}.




Uit schrijf: (1 apple + 3 oranges + 4 apples), stop.


Tekst bij: ['twice'] doen: { <- ((zelf tekst) + (zelf tekst)).
}.



Uit schrijf: ['❤❤❤'] twice.



