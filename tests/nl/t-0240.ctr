# test kwalificeringen

>> $ := Object nieuw.

$ bij: ['reactie:'] doen: { :x
	
	>> bewerking := x letter: 0.
	>> valuta := x letter: 1.
	>> geld := x overslaan: 2.
	
	>> bedrag := 0.

	( bewerking = ['+'] ) ja: {
		( valuta = ['£'] ) ja: { bedrag := 1.28 × geld. }.
	}. <- bedrag.
}.



>> x := $ +£20.

Uit schrijf: x, stop.


>> Fruit := Object nieuw.

Fruit bij: ['nieuw'] doen: {
	>> f := zelf nieuw.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit bij: ['apples:'] doen: { :a eigen appels := a. }.
Fruit bij: ['oranges:'] doen: { :p eigen sinaasappels := p. }.
Fruit bij: ['appels'] doen: { <- eigen appels. }.
Fruit bij: ['sinaasappels'] doen: { <- eigen sinaasappels. }.

Fruit bij: ['+'] doen: { :f
	
	>> n := Fruit nieuw.
	f optellen: 1.
	
	n apples: (f appels + eigen appels).
	n oranges:  (f sinaasappels  + eigen sinaasappels). <- n.
}.

Fruit bij: ['tekst'] doen: { <- ( eigen appels tekst + [' appels en '] + eigen sinaasappels + [' sinaasappels'] ).
}.

Getal bij: ['appels'] doen: { <- ((Fruit nieuw) apples: zelf).
}.

Getal bij: ['apple'] doen: { <- ((Fruit nieuw) apples: zelf).
}.

Getal bij: ['sinaasappels'] doen: { <- ((Fruit nieuw) oranges: zelf).
}.




Uit schrijf: (1 apple + 3 sinaasappels + 4 appels), stop.


Tekst bij: ['tweemaal'] doen: { <- ((zelf tekst) + (zelf tekst)).
}.



Uit schrijf: ['❤❤❤'] tweemaal.



