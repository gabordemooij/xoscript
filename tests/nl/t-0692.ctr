Server init.

Uit schrijf: (
	Patroon nieuw: ['^\\w+$'],
	overeenkomst: ['test@example.com'] 
), stop. # 0 overeenkomsten, faalt op @ en .

Uit schrijf: (
	Patroon nieuw: ['^[^@]+@[^\.]+\.\\w+$'],
	overeenkomst: ['test@example.com'] 
), stop. # 1 overeenkomst

Uit schrijf: (
	Patroon nieuw: ['[^@]+@[^\.]+\.\\w+'],
	overeenkomst: ['test@example.com'] 
), stop. # 1 overeenkomst

Uit schrijf: (
	Patroon nieuw: ['([^@]+)@([^\.]+)\.\\w+'],
	overeenkomst: ['test@example.com'] 
), stop. # 1 overeenkomst, groepen doen er niet toe

Uit schrijf: (
	Patroon nieuw: ['[a-z]'],
	overeenkomst: ['test@example.com'] 
), stop. # 14 overeenkomsten

Uit schrijf: (
	Patroon nieuw: ['.*'],
	overeenkomst: ['test@example.com'] 
), stop. # 1 overeenkomst (alles)

Uit schrijf: (
	Patroon nieuw: ['(.*)'],
	overeenkomst: ['test@example.com'] 
), stop. # 1 overeenkomst (alles)

Uit schrijf: (
	Patroon nieuw: ['\\s*[^@]+@[^\.]+\.\\w+'],
	overeenkomst: ['test@example.com'] 
), stop. # 1 overeenkomst, spatie vooraf optioneel, wordt genegeerd