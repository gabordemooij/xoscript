Server init.

Uit schrijf: (
	Patroon nieuw: ['^\\w+$'],
	overeenkomst: ['test@example.com'] 
), stop. # 0 match, fails on @ and .

Uit schrijf: (
	Patroon nieuw: ['^[^@]+@[^\.]+\.\\w+$'],
	overeenkomst: ['test@example.com'] 
), stop. # 1 match

Uit schrijf: (
	Patroon nieuw: ['[^@]+@[^\.]+\.\\w+'],
	overeenkomst: ['test@example.com'] 
), stop. # 1 match

Uit schrijf: (
	Patroon nieuw: ['([^@]+)@([^\.]+)\.\\w+'],
	overeenkomst: ['test@example.com'] 
), stop. # 1 match, groups dont matter

Uit schrijf: (
	Patroon nieuw: ['[a-z]'],
	overeenkomst: ['test@example.com'] 
), stop. # 14 matches

Uit schrijf: (
	Patroon nieuw: ['.*'],
	overeenkomst: ['test@example.com'] 
), stop. # 1 match (all)

Uit schrijf: (
	Patroon nieuw: ['(.*)'],
	overeenkomst: ['test@example.com'] 
), stop. # 1 match (all)

Uit schrijf: (
	Patroon nieuw: ['\\s*[^@]+@[^\.]+\.\\w+'],
	overeenkomst: ['test@example.com'] 
), stop. # 1 match, prefix space optional, gets ignored