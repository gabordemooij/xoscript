>> Begroeter := Object nieuw.
Begroeter bij: ['maak'] doen: {
	>> begroeter := Object nieuw.
	begroeter bij: ['name:'] doen: { :naam
		Uit schrijf: ['een naam instellen'].
		eigen mijnNaam := naam.
	}.
	begroeter bij: ['groet'] doen: {
		Uit schrijf: ['Hello'].
		Uit schrijf: eigen mijnNaam.
	}. <- begroeter.
}.
>> begroeter := Begroeter maak.
begroeter name: ['zonneschijn!'].
begroeter groet.
