>> Greeter := Object nieuw.
Greeter bij: ['make'] doen: {
	>> greeter := Object nieuw.
	greeter bij: ['name:'] doen: { :naam
		Uit schrijf: ['setting a name'].
		eigen myName := naam.
	}.
	greeter bij: ['greet'] doen: {
		Uit schrijf: ['Hello'].
		Uit schrijf: eigen myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
