
Tekst bij: ['evalueer'] doen: {
	>> code := Bestand nieuw: ['/tmp/eval.ctr'].
	code schrijf: (zelf tekst + ['.']).
	Programma gebruik: ['/tmp/eval.ctr'].
}.

>> map :=
	(Lijst nieuw)
	zet: ['Hoi Daar'] bij: ['two'],
	zet: (Reeks ← ['hello'] ; ['world'] ; (Reeks ← 1 ; 2; 9) ; Nee) bij: ['een'],
	zet: ( (Lijst nieuw) zet: ['wrrld'] bij: ['verkeerd gespeld'] ) bij: ['three'],
	zet: (Reeks ← ((Lijst nieuw) zet: ['schat'] bij: ['verborgen']) ; 2) bij: ['vier']. 
>> str := map tekst.
>> map2 := Niets.
(['map2 := '] + str ) evalueer.
Uit schrijf: map2 ? ['een'] ? 0.
Uit schrijf: map2 ? ['een'] ? 1.
Uit schrijf: map2 ? ['vier'] ? 0 ? ['verborgen'].
Uit schrijf: map2 ? ['een'] ? 2 ? 2.
