Getal bij: ['romeins'] doen: {
	>> getal := zelf kopieer.
	>> romeins := [''].
	{
		{
			(getal ≥ 1000) ja: {
				romeins toevoegen: ['Ⅿ'].
				getal aftrekken: 1000.
			}, afbreken.
		
			(getal ≥ 500) ja: {
				romeins toevoegen: ['Ⅾ'].
				getal aftrekken: 500.
			}, afbreken.
		
			(getal ≥ 100) ja: {
				romeins toevoegen: ['Ⅽ'].
				getal aftrekken: 100.
			}, afbreken.
		
			(getal ≥ 50) ja: {
				romeins toevoegen: ['Ⅼ'].
				getal aftrekken: 50.
			}, afbreken.
		
			(getal ≥ 50) ja: {
				romeins toevoegen: ['Ⅼ'].
				getal aftrekken: 50.
			}, afbreken.
		
			(getal ≥ 10) ja: {
				romeins toevoegen: ['Ⅹ'].
				getal aftrekken: 10.
			}, afbreken.
			
			(getal ≥ 9) ja: {
				romeins toevoegen: ['Ⅸ'].
				getal aftrekken: 9.
			}, afbreken.
			
			(getal ≥ 5) ja: {
				romeins toevoegen: ['Ⅴ'].
				getal aftrekken: 5.
			}, afbreken.
			
			(getal ≥ 4) ja: {
				romeins toevoegen: ['Ⅳ'].
				getal aftrekken: 4.
			}, afbreken.
			
			(getal ≥ 1) ja: {
				romeins toevoegen: ['Ⅰ'].
				getal aftrekken: 1.
			}, afbreken.
		} procedure.
	} zolang: { <- getal > 0. }. <- romeins.
}.

Uit schrijf: 1 romeins, stop.
Uit schrijf: 2 romeins, stop.
Uit schrijf: 4 romeins, stop.
Uit schrijf: 8 romeins, stop.
Uit schrijf: 16 romeins, stop.
Uit schrijf: 32 romeins, stop.
Uit schrijf: 64 romeins, stop.
Uit schrijf: 128 romeins, stop.
Uit schrijf: 256 romeins, stop.
Uit schrijf: 1024 romeins, stop.
