Getal bij: ['roman'] doen: {
	>> getal := zelf kopieer.
	>> roman := [''].
	{
		{
			(getal ≥ 1000) ja: {
				roman toevoegen: ['Ⅿ'].
				getal aftrekken: 1000.
			}, afbreken.
		
			(getal ≥ 500) ja: {
				roman toevoegen: ['Ⅾ'].
				getal aftrekken: 500.
			}, afbreken.
		
			(getal ≥ 100) ja: {
				roman toevoegen: ['Ⅽ'].
				getal aftrekken: 100.
			}, afbreken.
		
			(getal ≥ 50) ja: {
				roman toevoegen: ['Ⅼ'].
				getal aftrekken: 50.
			}, afbreken.
		
			(getal ≥ 50) ja: {
				roman toevoegen: ['Ⅼ'].
				getal aftrekken: 50.
			}, afbreken.
		
			(getal ≥ 10) ja: {
				roman toevoegen: ['Ⅹ'].
				getal aftrekken: 10.
			}, afbreken.
			
			(getal ≥ 9) ja: {
				roman toevoegen: ['Ⅸ'].
				getal aftrekken: 9.
			}, afbreken.
			
			(getal ≥ 5) ja: {
				roman toevoegen: ['Ⅴ'].
				getal aftrekken: 5.
			}, afbreken.
			
			(getal ≥ 4) ja: {
				roman toevoegen: ['Ⅳ'].
				getal aftrekken: 4.
			}, afbreken.
			
			(getal ≥ 1) ja: {
				roman toevoegen: ['Ⅰ'].
				getal aftrekken: 1.
			}, afbreken.
		} procedure.
	} zolang: { <- getal > 0. }. <- roman.
}.

Uit schrijf: 1 roman, stop.
Uit schrijf: 2 roman, stop.
Uit schrijf: 4 roman, stop.
Uit schrijf: 8 roman, stop.
Uit schrijf: 16 roman, stop.
Uit schrijf: 32 roman, stop.
Uit schrijf: 64 roman, stop.
Uit schrijf: 128 roman, stop.
Uit schrijf: 256 roman, stop.
Uit schrijf: 1024 roman, stop.
