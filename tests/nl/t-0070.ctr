>> getallen := ['1,2,3'] opsplitsen: [','].
Uit schrijf: ['Ik heb: '] + getallen aantal + [' getallen.'],stop.
{ :i Uit schrijf: ['number #'] + i + [':'] + (getallen positie: i), stop.} × 3.
>> dranken := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
dranken := dranken opsplitsen: [' Or '].
Uit schrijf: ['Wij serveren'], stop.
{ :i Uit schrijf: ['->'] + (dranken positie: i), stop. } × (dranken aantal).
Uit schrijf: (dranken samenvoegen: [',']), stop.
Uit schrijf: (getallen samenvoegen: ['||']).
