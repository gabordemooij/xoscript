>> numbers := ['1,2,3'] opsplitsen: [','].
Uit schrijf: ['I got: '] + numbers aantal + [' numbers.'],stop.
{ :i Uit schrijf: ['number #'] + i + [':'] + (numbers positie: i), stop.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages opsplitsen: [' Or '].
Uit schrijf: ['We serve'], stop.
{ :i Uit schrijf: ['->'] + (beverages positie: i), stop. } × (beverages aantal).
Uit schrijf: (beverages samenvoegen: [',']), stop.
Uit schrijf: (numbers samenvoegen: ['||']).
