# Deze test controleert of string_fill_in zijn plek niet verliest (door GC opgeruimd) in modus 4
# verwijzing in world.c
>> Logboek := Object nieuw.

Logboek bij: ['say:'] doen: { :str
	Uit schrijf: str, stop.
}.

>> Onderdeel := Object nieuw.

Onderdeel bij: ['nieuw:'] doen: { :id
	<- zelf nieuw id: id.
}.

Onderdeel bij: ['id:'] doen: { :id
	eigen id := id.
}.

Onderdeel bij: ['id'] doen: { <- eigen id. }.


Onderdeel bij: ['tekst'] doen: {
	>> str := ['Item#~no'].
	str ~no: eigen id.
	<- str.
}.


>> Print := Object nieuw.

Print bij: ['items'] doen: { 
	
	eigen onderdeel := Onderdeel nieuw: 1.
	
	# hier een segfault of een verkeerde str
	Logboek say: (
		['~item printed.'] ~item: eigen onderdeel
	).
	
	
}.

Print items.