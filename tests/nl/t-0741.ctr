Uit schrijf: ['Testobject'], stop.
>> a := Object nieuw. 

a bij: ['item:'] doen: { :octhulp
	eigen octhulp := octhulp. 
}.

a bij: ['onderdeel'] doen: {
	<- eigen octhulp.
}.

a item: Oct nieuw.

>> oud-octhulp-adres := a onderdeel prototype geheugenadres.
a save-as: ['/tmp/a.bin'].
Uit schrijf: ['========== SNAP HERLADEN:'], stop.

>> b := Object load-from: ['/tmp/a.bin'].

(b onderdeel prototype geheugenadres = oud-octhulp-adres) ja: {
	Uit schrijf: ['Objectkoppeling opnieuw verbonden.'], stop.
}.
