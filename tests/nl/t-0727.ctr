Server init.
>> f := Format nieuw: ['%d'].
>> a := Blob nieuw: 4.
a bytes: ( Reeks nieuw ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob nieuw: 4.
b bytes: ( Reeks nieuw ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a van: 0 lengte: 3, elk: { :i :byte
	Uit schrijf: ( f toepassen-int: byte ) , stop.
}.
a ^ b.
a van: 0 lengte: 3, elk: { :i :byte
	Uit schrijf: ( f toepassen-int: byte ) , stop.
}.
a ^ b.
a van: 0 lengte: 3, elk: { :i :byte
	Uit schrijf: ( f toepassen-int: byte ) , stop.
}.
a vrij.
b vrij.

{ a ^ Object. } afhandelen: { :e Uit schrijf: e, stop. }, start.
