Uit schrijf: ['Testobject'], stop.
>> p := Bestandslocatie /tmp.
Uit schrijf: p, stop.
>> oud-p-adres := p prototype geheugenadres.
p save-as: ['/tmp/a.bin'].
Uit schrijf: ['========== SNAP HERLADEN:'], stop.
>> b := Object load-from: ['/tmp/a.bin'].
(b prototype geheugenadres = oud-p-adres) ja: {
	Uit schrijf: ['Objectkoppeling opnieuw verbonden.'], stop.
}.
Uit schrijf: b, stop.
