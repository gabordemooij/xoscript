Uit schrijf: ['Test object'], stop.
>> p := Bestandslocatie /tmp.
Uit schrijf: p, stop.
>> old-p-address := p prototype geheugenadres.
p save-as: ['/tmp/a.bin'].
Uit schrijf: ['========== RELOADING SNAP:'], stop.
>> b := Object load-from: ['/tmp/a.bin'].
(b prototype geheugenadres = old-p-address) ja: {
	Uit schrijf: ['Object link re-attached.'], stop.
}.
Uit schrijf: b, stop.
