>> Slurp := Object nieuw.

Slurp bij: ['nieuw'] doen: {
	eigen str := [''].
}.

Slurp bij: ['reactie:'] doen: { :blah
		(eigen str = ['']) ja: {
			eigen str toevoegen: blah.
		}, anders: {
			eigen str toevoegen: [' '].
			eigen str toevoegen: blah.
		}.
}.

Slurp bij: ['reactie:argument:'] doen: { :blah :blahah
		(blah lengte > 1) ja: {
			eigen str toevoegen: (blah van: 0 lengte: (blah lengte - 1)).
		}, anders: {
			eigen str toevoegen: blah.
		}.
		eigen str toevoegen: [' '].
		eigen str toevoegen: blahah.
}.

Slurp bij: ['verkrijg'] doen: {
	>> buffer := eigen str.
	eigen str := ['']. <- buffer.
}.


>> x := Slurp nieuw.
x + 3.
Uit schrijf: (x verkrijg), stop.
x echo: ['Hallo wereld'].
Uit schrijf: (x verkrijg), stop.
x tellme: 123 and: 987.
Uit schrijf: (x verkrijg), stop.
