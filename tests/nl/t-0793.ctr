Server init.

>> DB := Maria-DB nieuw host: ['localhost'],
	gebruikersnaam: ['xo'],
	wachtwoord: ['pass123'],
	databanknaam: ['xobase'],
	verbinden.

{
	DB query:
	['DROP TABLE movies'],
	uitvoeren.
} afhandelen: { Niets. }, start.

DB query:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
uitvoeren.

DB query: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parameters: ( Reeks nieuw ; ['Halloween'] ),
uitvoeren.

DB query: ['SELECT * FROM movies'],
ophalen: { :movie
	Uit schrijf: movie title, stop.
}.

