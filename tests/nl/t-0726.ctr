# test buffers PKI/Sign 
Server init.

>> lang := ( Reeks nieuw vul: 1000 met: ['a'] ) samenvoegen: [''].

# onderteken een bericht
Uit schrijf: ( 
	Kluis onderteken: ['abc'] met: lang
), stop.

Uit schrijf: ( 
	Kluis
		controleer: ['abc'] 
		ondertekening: lang 
		met: lang
), stop.

Uit schrijf: (
	Kluis wachtwoord-hash: lang controleer: lang
), stop.
