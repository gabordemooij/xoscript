# test buffers PKI/Sign 
Server init.

>> long := ( Reeks nieuw vul: 1000 met: ['a'] ) samenvoegen: [''].

# sign a message
Uit schrijf: ( 
	Kluis onderteken: ['abc'] met: long
), stop.

Uit schrijf: ( 
	Kluis
		controleer: ['abc'] 
		ondertekening: long 
		met: long
), stop.

Uit schrijf: (
	Kluis wachtwoord-hash: long controleer: long
), stop.
