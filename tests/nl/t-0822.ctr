# minder parameters dan plaatshouders moet een fout geven, niet voorbij de bindingen lezen
Server init.

>> db := Maria-DB nieuw host: ['localhost'],
	gebruikersnaam: ['xo'],
	wachtwoord: ['pass123'],
	databanknaam: ['xobase'],
	verbinden.

>> zoekparameters := db query: ['SELECT ? AS a, ? AS b, ? AS c'].
zoekparameters parameters: (Reeks nieuw ; ['1']).
{ zoekparameters ophalen: { :rij Uit schrijf: rij, stop. }. } afhandelen: { :e Uit schrijf: e, stop. }, start.

>> zoekparameters := db query: ['SELECT ? AS a'].
{ zoekparameters ophalen: { :rij Uit schrijf: rij, stop. }. } afhandelen: { :e Uit schrijf: e, stop. }, start.

# het juiste aantal werkt nog steeds, meer parameters worden zoals voorheen genegeerd
>> zoekparameters := db query: ['SELECT ? AS a, ? AS b'].
zoekparameters parameters: (Reeks nieuw ; ['1'] ; ['2']).
zoekparameters ophalen: { :rij Uit schrijf: (rij bij: ['a']), schrijf: (rij bij: ['b']), stop. }.
zoekparameters parameters: (Reeks nieuw ; ['1'] ; ['2'] ; ['3']).
zoekparameters ophalen: { :rij Uit schrijf: (rij bij: ['a']), schrijf: (rij bij: ['b']), stop. }.
