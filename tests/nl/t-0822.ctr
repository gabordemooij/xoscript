# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := Maria-DB nieuw host: ['localhost'],
	gebruikersnaam: ['xo'],
	wachtwoord: ['pass123'],
	databanknaam: ['xobase'],
	verbinden.

>> zoekparameters := db query: ['SELECT ? AS a, ? AS b, ? AS c'].
zoekparameters parameters: (Reeks nieuw ; ['1']).
{ zoekparameters ophalen: { :row Uit schrijf: row, stop. }. } afhandelen: { :e Uit schrijf: e, stop. }, start.

>> zoekparameters := db query: ['SELECT ? AS a'].
{ zoekparameters ophalen: { :row Uit schrijf: row, stop. }. } afhandelen: { :e Uit schrijf: e, stop. }, start.

# the right number still works, more parameters are ignored as before
>> zoekparameters := db query: ['SELECT ? AS a, ? AS b'].
zoekparameters parameters: (Reeks nieuw ; ['1'] ; ['2']).
zoekparameters ophalen: { :row Uit schrijf: (row bij: ['a']), schrijf: (row bij: ['b']), stop. }.
zoekparameters parameters: (Reeks nieuw ; ['1'] ; ['2'] ; ['3']).
zoekparameters ophalen: { :row Uit schrijf: (row bij: ['a']), schrijf: (row bij: ['b']), stop. }.
