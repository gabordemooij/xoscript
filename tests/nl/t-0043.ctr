>> herhaler := Object nieuw.
herhaler bij: ['reactie:'] doen: { :wat
	Uit schrijf: wat + [' '].
}.
herhaler bij: ['reactie:argument:'] doen: { :wat :say
	Uit schrijf: wat, schrijf: say + [' '].
}.
herhaler bij: ['reactie:argument:argument:'] doen: { :wat :say :meer
	Uit schrijf: wat, schrijf: say, schrijf: meer.
}.
herhaler herhaal.
herhaler everything: ['Ik zeg.'].
herhaler and: ['I '] everything: ['doe.'].
