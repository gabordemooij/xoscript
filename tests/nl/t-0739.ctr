Uit schrijf: ['Test object'], stop.
>> a := Object nieuw. 

a bij: ['item:'] doen: { :binhelper
	eigen binhelper := binhelper. 
}.

a bij: ['item'] doen: { <- eigen binhelper.
}.

a item: Bin nieuw.

>> old-binhelper-address := a item prototype geheugenadres.
a save-as: ['/tmp/a.bin'].
Uit schrijf: ['========== RELOADING SNAP:'], stop.

>> b := Object load-from: ['/tmp/a.bin'].

(b item prototype geheugenadres = old-binhelper-address) ja: {
	Uit schrijf: ['Object link re-attached.'], stop.
}.


