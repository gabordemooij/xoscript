Uit schrijf: ['Testobject'], stop.
>> a := Object nieuw. 

a bij: ['item:'] doen: { :binhulp
	eigen binhulp := binhulp. 
}.

a bij: ['onderdeel'] doen: {
	<- eigen binhulp.
}.

a item: Bin nieuw.

>> oud-binhulp-adres := a onderdeel prototype geheugenadres.
a save-as: ['/tmp/a.bin'].
Uit schrijf: ['========== SNAP HERLADEN:'], stop.

>> b := Object load-from: ['/tmp/a.bin'].

(b onderdeel prototype geheugenadres = oud-binhulp-adres) ja: {
	Uit schrijf: ['Objectkoppeling opnieuw verbonden.'], stop.
