# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Kluis 
	wachtwoord-hash: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Kluis 
	wachtwoord-hash: hash controleer: a1.
	# fail 
>> b := Kluis
	wachtwoord-hash: hash controleer: a2.
	# ok!

Uit schrijf: a, stop.
Uit schrijf: b, stop.

