# Wachtwoorden hashen
Server init.

# Gebruiker stelt een wachtwoord in
>> wachtw := ['pass123'].

# Je slaat het zo op
>> hashwaarde := Kluis 
	wachtwoord-hash: wachtw.

# Daarna logt de gebruiker in
# Poging 1
>> a1 := ['abcd123'].
# Poging 2
>> a2 := ['pass123'].

# Controleren
>> a := Kluis 
	wachtwoord-hash: hashwaarde controleer: a1.
	# mislukt 
>> b := Kluis
	wachtwoord-hash: hashwaarde controleer: a2.
	# ok!

Uit schrijf: a, stop.
Uit schrijf: b, stop.

