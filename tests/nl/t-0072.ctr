>> echo := Object nieuw.
echo bij: ['reactie:'] doen: { :sound
	{ Uit schrijf: sound. } × 2.
}.
echo ho!. 


echo := Object nieuw.
echo bij: ['reactie:argument:'] doen: { :sound :x
	{ Uit schrijf: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := Object nieuw.
echo bij: ['reactie:argument:argument:'] doen: { :operation :sound :x
	{ Uit schrijf: sound. } × x.
}.
echo shout: ['la'] times: 4. 


