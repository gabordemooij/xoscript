>> echo := Object nieuw.
echo bij: ['reactie:'] doen: { :geluid
	{ Uit schrijf: geluid. } × 2.
}.
echo ho!. 


echo := Object nieuw.
echo bij: ['reactie:argument:'] doen: { :geluid :x
	{ Uit schrijf: geluid. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := Object nieuw.
echo bij: ['reactie:argument:argument:'] doen: { :bewerking :geluid :x
	{ Uit schrijf: geluid. } × x.
}.
echo shout: ['la'] times: 4. 


