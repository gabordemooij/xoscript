

>> Matryoshka := Object nieuw.
Matryoshka bij: ['double:'] doen: { :secret
	eigen secret := secret × 2.
}.
Matryoshka bij: ['nieuw:'] doen: { :secret
	>> answer := Niets.
	>> t := (secret > 255).
	Uit schrijf: (secret + [' | '] + t), stop.
	t ja: {
		answer := secret.
	}, anders: {
		answer := Matryoshka recursief nieuw: (zelf double: secret).
	}. <- answer.
}.

>> x := Matryoshka nieuw: 2.
