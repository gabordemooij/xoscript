

>> Matroesjka := Object nieuw.
Matroesjka bij: ['double:'] doen: { :geheim
	eigen geheim := geheim × 2.
}.
Matroesjka bij: ['nieuw:'] doen: { :geheim
	>> antwoordwaarde := Niets.
	>> t := (geheim > 255).
	Uit schrijf: (geheim + [' | '] + t), stop.
	t ja: {
		antwoordwaarde := geheim.
	}, anders: {
		antwoordwaarde := Matroesjka recursief nieuw: (zelf double: geheim).
	}. <- antwoordwaarde.
}.

>> x := Matroesjka nieuw: 2.
