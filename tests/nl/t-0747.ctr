Uit schrijf: ['Test object'], stop.
>> a := Object nieuw. 

a bij: ['item:'] doen: { :num
	eigen num := num. 
}.

a bij: ['item'] doen: { <- eigen num.
}.

a item: 123.

Uit schrijf: a item, stop.

>> old-num-address := a item prototype geheugenadres.
a save-as: ['/tmp/a.bin'].
Uit schrijf: ['========== RELOADING SNAP:'], stop.

>> b := Object load-from: ['/tmp/a.bin'].

(b item prototype geheugenadres = old-num-address) ja: {
	Uit schrijf: ['Object link re-attached.'], stop.
}.

Uit schrijf: b item, stop.
