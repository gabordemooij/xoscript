Uit schrijf: ((Reeks nieuw
	bij: ['plaque:'] doen: { :x eigen o := x. },
	bij: ['plaque']  doen: { <- eigen o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Reeks ← 1)
	~ (Reeks ← 1 ; 2)
	~ (Reeks ← 1 ; 2 ; 3)
	~ (Reeks ← 1 ; 2 ; 3 ; 4)
	~ (Reeks ← 1 ; 2 ; 3 ; 4 ; 5)
) elk: { :i :el
	{ Uit schrijf: deze-taak. } × el aantal.
	Uit stop.
}) plaque, stop.


