

Tekst bij: ['evaluate'] doen: {
	>> code := Bestand nieuw: ['/tmp/eval.ctr'].
	code schrijf: zelf tekst + ['.'].
	Programma gebruik: ['/tmp/eval.ctr'].
}.

>> a := (Reeks ← (
	(Lijst nieuw)
		zet: ['domain'] bij: ['mywebsite.com'],
		zet: (Reeks ←
			((Lijst nieuw)
				zet: ['home'] bij: ['title'],
				zet: ['<html></html>'] bij: ['body'],
				zet: ['2017-01-01'] bij: ['created']
			) ;
			((Lijst nieuw)
				zet: ['aboutus(c)'] bij: ['title'],
				zet: ['<credits>Author Inc.</credits>'] bij: ['body']
			)
		) bij: ['pages']
	)
) tekst.

Uit schrijf: a type, stop.
Uit schrijf: a, stop.

>> b := Niets.
(['b := '] + a) evaluate.
Uit schrijf: b ? 0 ? ['pages'] ? 1 ? ['body'], stop.

>> c := b ? 0.
>> d := c tekst.
Uit schrijf: d type, stop.

>> e := Niets.
(['e := '] + d) evaluate.
Uit schrijf: e ? ['pages'] ? 0, stop.
