>> z := Object nieuw.
z bij: ['value:'] doen: { :v
	eigen value := v. <- zelf.
}.
z bij: ['value'] doen: { <- eigen value. }.
(z setValue: 1) value: 2.
Uit schrijf: z value.
>> x := z.
Uit schrijf: x value.
z := Niets.
Uit schrijf: z value.
Uit schrijf: x value.
Uit schrijf: ['hello'].
Uit schrijf: 3 + 2.
Uit schrijf: (3 > 2).
