

Tekst bij: ['evalueer'] doen: {
	>> code := Bestand nieuw: ['/tmp/eval.ctr'].
	code schrijf: (zelf tekst + ['.']).
	Programma gebruik: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Reeks ← (['Aanhalingstekens '] + Q + [' zijn slecht?']) ; 1.
>> x := q tekst.
Uit schrijf: x, stop.
>> y := Niets.
(['y := '] + x ) evalueer.
Uit schrijf: y ? 0, stop.

q := Lijst zet: ['\[''] bij: ['\['quote\']'].
x := q tekst.
Uit schrijf: x, stop.
y := Niets.
(['y := '] + x ) evalueer.

>> q := (Lijst nieuw) zet:['\[''] bij:['\['quote\[''].
Uit schrijf: y ? ['\['quote\']'], stop.
