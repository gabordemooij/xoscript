Uit schrijf: ['Testobject'], stop.
>> a := Object nieuw. 
a bij: ['item:'] doen: { :rks
	eigen rks := rks. 
}.
a bij: ['onderdeel'] doen: {
	<- eigen rks.
}.
a item: (
	Reeks nieuw ; 1 ; (
		Reeks nieuw ; ['a'] ; (
			Reeks nieuw ; ( Moment nieuw: 1 )
		) ; ( Int64 van-string: ['321'] )
	)
).
Uit schrijf: a onderdeel, stop.
>> oud-rks-adres := a onderdeel prototype geheugenadres.
a save-as: ['/tmp/a.bin'].
Uit schrijf: ['========== SNAP HERLADEN:'], stop.
>> b := Object load-from: ['/tmp/a.bin'].
(b onderdeel prototype geheugenadres = oud-rks-adres) ja: {
	Uit schrijf: ['Objectkoppeling opnieuw verbonden.'], stop.
}.
Uit schrijf: ( b onderdeel ), stop.
