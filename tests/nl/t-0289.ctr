#Linux
>> OS := Programma opdrachtregel: (Instructie uname -s), kern.

>> Slurp := Object nieuw.
Slurp bij: ['nieuw'] doen: {
	eigen str := [''].
}.
Slurp bij: ['reactie:'] doen: { :blah
		(eigen str ≠ ['']) ja: {
			eigen str toevoegen: [' '].
		}.
		eigen str toevoegen: blah.
}.
Slurp bij: ['reactie:argument:'] doen: { :blah :blahah
		(eigen str ≠ ['']) ja: {
			eigen str toevoegen: [' '].
		}.
		(blah lengte > 1) ja: {
			eigen str toevoegen: (blah van: 0 lengte: (blah lengte - 1)).
		}, anders: {
			eigen str toevoegen: blah.
		}.
		eigen str toevoegen: [' '].
		eigen str toevoegen: blahah.
}.
Slurp bij: ['verkrijg'] doen: {
	>> buffer := eigen str.
	eigen str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text toevoegen: ['hello'].
} × 1000.


Uit schrijf: (
	Programma opdrachtregel: (
		Slurp nieuw
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) verkrijg
).

