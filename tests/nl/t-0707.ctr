# test typeconversies / omzettingen / bindingen
Programma geheugenbeheer: 4.
Server init.

>> teller := 0.
>> db := Maria-DB nieuw host: ['localhost'],
	gebruikersnaam: ['xo'], wachtwoord: ['pass123'], databanknaam: ['xobase'], verbinden.

>> TweeCijferFormaat := Format nieuw: ['%02d'].

# Datum en tijd
{
	>> jaar     := Getal tussen: 1995 en: 2050, tekst.
	>> maand    := TweeCijferFormaat toepassen-int: (Getal tussen: 1 en: 12), tekst.
	>> dag      := TweeCijferFormaat toepassen-int: (Getal tussen: 1 en: 28), tekst.
	>> uur     := TweeCijferFormaat toepassen-int: (Getal tussen: 1 en: 23), tekst.
	>> minuut   := TweeCijferFormaat toepassen-int: (Getal tussen: 1 en: 59), tekst.
	>> seconde   := TweeCijferFormaat toepassen-int: (Getal tussen: 1 en: 59), tekst.
	>> datetime := ['YYYY-MM-DD HH:II:SS'].	
	datetime
		YYYY: jaar,
		MM: maand,
		DD: dag,
		HH: uur,
		II: minuut,
		SS: seconde.
	>> zoekparameters :=
	db query: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: datetime),
	ophalen: { :rij
		(rij mydatetime = datetime) nee: {
			deze-taak fout: (
				['Verwacht: <expected> maar kreeg: <observation>']
				<expected>: datetime,
				<observation>: rij mydatetime
			).
		}.
	
	}.
	teller optellen: 1.
} * 100.

# Datum
{
	>> jaar     := Getal tussen: 1995 en: 2050, tekst.
	>> maand    := TweeCijferFormaat toepassen-int: (Getal tussen: 1 en: 12), tekst.
	>> dag      := TweeCijferFormaat toepassen-int: (Getal tussen: 1 en: 28), tekst.
	>> date     := ['YYYY-MM-DD'].
	date
		YYYY: jaar,
		MM: maand,
		DD: dag.
	>> zoekparameters :=
	db query: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: date),
	ophalen: { :rij
		(rij mydate = date) nee: {
			deze-taak fout: (
				['Verwacht: <expected> maar kreeg: <observation>']
				<expected>: date,
				<observation>: rij mydate
			).
		}.
	}.
	teller optellen: 1.
} * 100.


# Tijd
{
	>> uur     := TweeCijferFormaat toepassen-int: (Getal tussen: 1 en: 23), tekst.
	>> minuut   := TweeCijferFormaat toepassen-int: (Getal tussen: 1 en: 59), tekst.
	>> seconde   := TweeCijferFormaat toepassen-int: (Getal tussen: 1 en: 59), tekst.
	>> tijd := ['HH:II:SS'].
	tijd
		HH: uur,
		II: minuut,
		SS: seconde.
	>> zoekparameters :=
	db query: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: tijd),
	ophalen: { :rij
		(rij mytime = tijd) nee: {
			deze-taak fout: (
				['Verwacht: <expected> maar kreeg: <observation>']
				<expected>: datetime,
				<observation>: rij mytime
			).
		}.
	}.
	teller optellen: 1.
} * 100.


# Teksten (varchar/text)
>> str1 := Reeks nieuw vul: 100000 met: ['x'], samenvoegen: [''].
{
	>> str2 := Kluis token: 40.
	>> zoekparameters :=
	db query: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	ophalen: { :rij
		(rij str1 = str1 en: rij str2 = str2) nee: {
			deze-taak fout: (
				['Verwacht: <expected> maar kreeg: <observation>']
				<expected>: datetime,
				<observation>: rij mytime
			).
		}.
	}.
	teller optellen: 1.
} * 100.


# Getallen
{
	>> n1  := Getal tussen: 1 en: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 van-string: ['9223372036854775807'] ) -
		( Int64 van-string: ['99999'] ) +
		( Int64 van-string: n1 tekst )
	).
	>> zoekparameters :=
	db query: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	ophalen: { :rij
		(rij n1 = n1) nee: {
			deze-taak fout: (
				['Verwacht: <expected> maar kreeg: <observation>']
				<expected>: n1,
				<observation>: rij n1
			).
		}.
		(rij n2 = n2) nee: {
			deze-taak fout: (
				['Verwacht: <expected> maar kreeg: <observation>']
				<expected>: n1,
				<observation>: rij n2
			).
		}.
		(rij n3 = n2 afgerond) nee: {
			deze-taak fout: (
				['Verwacht: <expected> maar kreeg: <observation>']
				<expected>: n1,
				<observation>: rij n3
			).
		}.
		(rij big = big) nee: {
			deze-taak fout: (
				['Verwacht: <expected> maar kreeg: <observation>']
				<expected>: big,
				<observation>: rij big
			).
		}.
		
	}.
	teller optellen: 1.
} * 100.


Uit schrijf: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: teller
), stop.