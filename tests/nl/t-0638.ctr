
Server init.
>> vz := HTTP-Request nieuw.
Uit schrijf: ['HTTP-GET d[]=']  + ( vz get-list: ['d[]'] ), stop. # GET
Uit schrijf: ['HTTP-GET f[]=']  + ( vz get-list: ['f[]'] ), stop. # GET
Uit schrijf: ['HTTP-POST e[]='] + ( vz post-list: ['e[]'] ), stop. # GET
Uit schrijf: ['HTTP-POST c=']   + ( vz post: ['c'] ), stop. # GET
Uit schrijf: ['HTTP-POST xx=']  + ( vz post: ['xx'] ), stop. # GET
