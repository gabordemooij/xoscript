>> Grandfather := Object nieuw.
Grandfather bij: ['greet'] doen: {
	Uit schrijf: ['Ave!'], stop.
}.
>> Father := Grandfather nieuw.
Father bij: ['greet'] doen: {
	Uit schrijf: ['Hello'], stop.
	zelf greet.
}.
>> Son := Father nieuw.
Son bij: ['greet'] doen: {
	Uit schrijf: ['Hi'], stop.
	zelf greet.
}.

Son greet.

>> Roundabout := Object nieuw.
Roundabout bij: ['circle:'] doen: { :x
	Uit schrijf: x, stop.
	(x < 3) ja: { zelf recursief circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) ja: { Uit schrijf: x, stop. x optellen: 1.  increment start. }. }.
increment start.