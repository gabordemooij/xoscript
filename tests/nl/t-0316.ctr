>> Grootvader := Object nieuw.
Grootvader bij: ['groet'] doen: {
	Uit schrijf: ['Ave!'], stop.
}.
>> Vader := Grootvader nieuw.
Vader bij: ['groet'] doen: {
	Uit schrijf: ['Hello'], stop.
	zelf groet.
}.
>> Zoon := Vader nieuw.
Zoon bij: ['groet'] doen: {
	Uit schrijf: ['Hoi'], stop.
	zelf groet.
}.

Zoon groet.

>> Rotonde := Object nieuw.
Rotonde bij: ['circle:'] doen: { :x
	Uit schrijf: x, stop.
	(x < 3) ja: { zelf recursief circle: x + 1. }.
}.

Rotonde circle: 1.

>> x := 1.
>> ophogen := { (x ≤ 3) ja: { Uit schrijf: x, stop. x optellen: 1.  ophogen start. }. }.
ophogen start.