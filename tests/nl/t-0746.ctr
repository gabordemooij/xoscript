Uit schrijf: ['Test object'], stop.
>> a := Object nieuw. 

a bij: ['item:'] doen: { :dict
	eigen dict := dict. 
}.

a bij: ['item'] doen: { <- eigen dict.
}.

a item: (
Lijst nieuw
	hello: ['world'],
	world: (Lijst nieuw zet: ['a'] bij: ['b'])).

Uit schrijf: a item, stop.

>> old-dict-address := a item prototype geheugenadres.
a save-as: ['/tmp/a.bin'].
Uit schrijf: ['========== RELOADING SNAP:'], stop.

>> b := Object load-from: ['/tmp/a.bin'].

(b item prototype geheugenadres = old-dict-address) ja: {
	Uit schrijf: ['Object link re-attached.'], stop.
}.

Uit schrijf: b item, stop.
