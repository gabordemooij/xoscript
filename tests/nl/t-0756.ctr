Uit schrijf: ['Testobject'], stop.
>> begroeter := Object nieuw.
begroeter bij: ['name:'] doen: { :naam
	eigen xnaam := naam. 
}.
begroeter bij: ['groet'] doen: {
	Uit schrijf: ['Hallo '] + eigen xnaam, stop.
}.
begroeter name: ['Sherlock'].
begroeter save-as: ['/tmp/a.bin'].
begroeter save-as: ['/tmp/b.bin'].
Uit schrijf: ['========== SNAP HERLADEN:'], stop.
>> b := Object load-from: ['/tmp/a.bin'].
>> c := Object load-from: ['/tmp/b.bin'].
b groet.
b name: ['Watson'], groet.
c name: ['Moriarty'], groet.
