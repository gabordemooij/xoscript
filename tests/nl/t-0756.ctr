Uit schrijf: ['Test object'], stop.
>> greeter := Object nieuw.
greeter bij: ['name:'] doen: { :naam
	eigen xname := naam. 
}.
greeter bij: ['greet'] doen: {
	Uit schrijf: ['Hello '] + eigen xname, stop.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Uit schrijf: ['========== RELOADING SNAP:'], stop.
>> b := Object load-from: ['/tmp/a.bin'].
>> c := Object load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
