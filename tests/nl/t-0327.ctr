

Reeks bij: ['fixture:'] doen: { :f
	eigen vastgezet := f.
}.

Reeks bij: ['aantal'] doen: { <- eigen vastgezet.
}.

Reeks bij: ['aantal'] doen: { <- eigen vastgezet.
}.


>> x := Niets.
{

	x := ['hello'] 
	vervang:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] letter: 2)
			)
		)
	door: (
		(['...hal'] + ['lo']) 
			hoofdletters 
			lowecase 
			hoofdletters 
			overslaan: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Reeks ← 0 ; 1 ; 4; 9 ; (Reeks ← 0 ; 3; 1) ; 4
							) voorlaatste
						) ? 1
					) + 
					((Reeks ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					aantal
				)
			)
	).

} × 10.
Uit schrijf: x, stop.

