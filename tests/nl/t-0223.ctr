>> x := Moment nieuw.
x zone: ['CEST'],
jaar:2017,
maand:01,
dag:10,
uur: 10,
minuut: 0,
seconde: 0.

Uit schrijf: x, stop.

Uit schrijf: x tijd, stop.

x optellen: 1 seconde.
x optellen: 2 minuut.
x optellen: 3 uur.
x optellen: 4 dag.
x optellen: 1 maand.
x optellen: 6 jaar.

Uit schrijf: x, stop.

x aftrekken: 1 seconde.
x aftrekken: 2 minuut.
x aftrekken: 3 uur.
x aftrekken: 4 dag.
x aftrekken: 1 maand.
x aftrekken: 6 jaar.

Uit schrijf: x, stop.

>> y := x kopieer.
>> z := x.

Uit schrijf: y, stop.
Uit schrijf: z, stop.
Uit schrijf: (x zone = y zone), stop.
Uit schrijf: (x tijd = y tijd), stop.
Uit schrijf: (x = z), stop.
Uit schrijf: x jaardag, stop.
Uit schrijf: x weekdag, stop.
Uit schrijf: x week, stop.
