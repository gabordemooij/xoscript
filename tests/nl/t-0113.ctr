Uit schrijf: ['Continue for-loop, No - before 6 and up.'], stop.
{ :i
	Uit schrijf: (i + 1), stop.
	((i + 1) > 4) doorgaan.
	Uit schrijf: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Uit stop.
Uit schrijf: ['Continue while-true, No --> before 5 and up.'], stop.
{
	Uit schrijf: ['iteration #'] + x, stop.
	x optellen: 1.
	((x < 5) niet) doorgaan.
	Uit schrijf: ['-->'].
} zolang: xIsLessThan10.
Uit stop.
Uit schrijf: ['Continue while-false, No - before 3 only.'], stop.
{
	Uit schrijf: ['iteration #'] + x, stop.
	x aftrekken: 1.
	(x = 3) doorgaan.
	Uit schrijf: ['-'].
} zolang: { <- ( x > 0). }.

Uit stop.
Uit schrijf: ['Continue times-loop, No ||| before 3.'], stop.
{ :i
	Uit schrijf: ['iteration #'] + i, stop.
	(i = 2) doorgaan.
	Uit schrijf: ['|||'].
} × 5.

Uit stop.

{ Ja doorgaan. Uit schrijf: ['dont write this!'], stop. } start.

{ Ja doorgaan. Uit schrijf: ['dont write this!'], stop. } afhandelen: { Uit schrijf: ['Dont catch this!']. }, start.

Uit schrijf: ['Test Array each-loop: 0, ... ,2'], stop.
(Reeks ← 1 ; 2 ; 3) lijst: { :i
	(i = 1) doorgaan.
	Uit schrijf: ['iteration #'] + (i - 0), stop.
}.

Uit schrijf: ['Test Map each-loop: c only'], stop.
>> m := Lijst nieuw.
m zet: ['first'] bij: ['a'], zet: ['second'] bij: ['b'], zet: ['third'] bij: ['c'].
m elk: { :k :v
	(k ≠ ['c']) doorgaan.
	Uit schrijf: ['iteration'] + k + v, stop.
}.

