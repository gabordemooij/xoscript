Uit schrijf: ['Ga door met for-lus, Nee - voor 6 en hoger.'], stop.
{ :i
	Uit schrijf: (i + 1), stop.
	((i + 1) > 4) doorgaan.
	Uit schrijf: ['-'].
} × 10.

>> x := 0.
>> xIsKleinerDan10 := { <- ( x < 10 ). }.
Uit stop.
Uit schrijf: ['Ga door met while-true, Nee --> voor 5 en hoger.'], stop.
{
	Uit schrijf: ['iteration #'] + x, stop.
	x optellen: 1.
	((x < 5) niet) doorgaan.
	Uit schrijf: ['-->'].
} zolang: xIsKleinerDan10.
Uit stop.
Uit schrijf: ['Ga door met while-false, Nee - alleen voor 3.'], stop.
{
	Uit schrijf: ['iteration #'] + x, stop.
	x aftrekken: 1.
	(x = 3) doorgaan.
	Uit schrijf: ['-'].
} zolang: { <- ( x > 0). }.

Uit stop.
Uit schrijf: ['Ga door met keer-lus, Nee ||| voor 3.'], stop.
{ :i
	Uit schrijf: ['iteration #'] + i, stop.
	(i = 2) doorgaan.
	Uit schrijf: ['|||'].
} × 5.

Uit stop.

{ Ja doorgaan. Uit schrijf: ['schrijf dit niet!'], stop. } start.

{ Ja doorgaan. Uit schrijf: ['schrijf dit niet!'], stop. } afhandelen: { Uit schrijf: ['Vang dit niet!']. }, start.

Uit schrijf: ['Test Reeks each-lus: 0, ... ,2'], stop.
(Reeks ← 1 ; 2 ; 3) lijst: { :i
	(i = 1) doorgaan.
	Uit schrijf: ['iteration #'] + (i - 0), stop.
}.

Uit schrijf: ['Test Lijst each-lus: alleen c'], stop.
>> m := Lijst nieuw.
m zet: ['first'] bij: ['a'], zet: ['second'] bij: ['b'], zet: ['derde'] bij: ['c'].
m elk: { :k :v
	(k ≠ ['c']) doorgaan.
	Uit schrijf: ['iteration'] + k + v, stop.
}.

