#Linux

 >> t := Moment nieuw.
 
t zone: ['Europe/Amsterdam'].
t jaar: 2020, maand: 8, dag: 2, uur: 21, minuut: 2, seconde: 1.

>> a := t uur.
>> ams := t zone.

t zone: ['US/Hawaii'].
>> b := t uur.
>> hw := t zone.

Uit
schrijf: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		of: ['later'] of: ['earlier']
	)
),
stop.
 