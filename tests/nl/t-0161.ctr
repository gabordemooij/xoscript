Programma geheugenbeheer: 0.
Reeks bij: ['som'] doen: {
	>> totaal := 0.
	zelf elk: { :index :element
		totaal optellen: element.
	}. <- totaal.
}.

>> gebruiktGeheugen1 := 0.
>> gebruiktGeheugen2 := 0.
>> gebruiktGeheugen3 := 0.
>> gebruiktGeheugen4 := 0.



>> f := Bestand nieuw: ['/tmp/test.txt'].
f schrijf: ['Lorem Ipsum'].
f sluit.
  

f := Bestand nieuw: ['/tmp/test.txt'].
>> tekstinhoud := f lezen.
f sluit.



Programma vegen.
gebruiktGeheugen1 := (Programma geheugen ? 1).



f := Bestand nieuw: ['/tmp/test.txt'].
tekstinhoud := f lezen.
f sluit.

Programma vegen.
gebruiktGeheugen2 := (Programma geheugen ? 1).


f := Bestand nieuw: ['/tmp/test.txt'].
tekstinhoud := f lezen.
f sluit.

Programma vegen.
gebruiktGeheugen3 := (Programma geheugen ? 1).



( gebruiktGeheugen1 = gebruiktGeheugen2 en: gebruiktGeheugen1 = gebruiktGeheugen3, en: gebruiktGeheugen2 = gebruiktGeheugen3 ) ja: {
	Uit schrijf: ['Hier geen geheugenlekken'].
}, nee: {
	Uit schrijf: ['Geheugen lekt...'].
}.
