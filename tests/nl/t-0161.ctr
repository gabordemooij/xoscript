Programma geheugenbeheer: 0.
Reeks bij: ['sum'] doen: {
	>> total := 0.
	zelf elk: { :index :element
		total optellen: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Bestand nieuw: ['/tmp/test.txt'].
f schrijf: ['Lorem Ipsum'].
f sluit.
  

f := Bestand nieuw: ['/tmp/test.txt'].
>> text := f lezen.
f sluit.



Programma vegen.
usedMemory1 := (Programma geheugen ? 1).



f := Bestand nieuw: ['/tmp/test.txt'].
text := f lezen.
f sluit.

Programma vegen.
usedMemory2 := (Programma geheugen ? 1).


f := Bestand nieuw: ['/tmp/test.txt'].
text := f lezen.
f sluit.

Programma vegen.
usedMemory3 := (Programma geheugen ? 1).



( usedMemory1 = usedMemory2 en: usedMemory1 = usedMemory3, en: usedMemory2 = usedMemory3 ) ja: {
	Uit schrijf: ['No memory leaks here'].
}, nee: {
	Uit schrijf: ['Leaking memory...'].
}.
