Uit schrijf: ['Test object'], stop.
>> a := Object nieuw. 

a bij: ['item:'] doen: { :nil
	eigen nil := nil. 
}.

a bij: ['item'] doen: { <- eigen nil.
}.

a item: Niets.

Uit schrijf: a item, stop.

>> old-nil-address := a item prototype geheugenadres.
a save-as: ['/tmp/a.bin'].
Uit schrijf: ['========== RELOADING SNAP:'], stop.

>> b := Object load-from: ['/tmp/a.bin'].

(b item prototype geheugenadres = old-nil-address) ja: {
	Uit schrijf: ['Object link re-attached.'], stop.
}.

Uit schrijf: b item, stop.
