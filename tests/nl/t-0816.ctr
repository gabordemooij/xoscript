# a format must fit the type of the value, the type can come from a client
>> probeer := { :format :value
	{ Uit schrijf: ( (Format nieuw: format) toepassen: value ), stop. } afhandelen: { :e Uit schrijf: e, stop. }, start.
}.
>> try-int := { :format :value
	{ Uit schrijf: ( (Format nieuw: format) toepassen-int: value ), stop. } afhandelen: { :e Uit schrijf: e, stop. }, start.
}.

# fits
probeer toepassen: ['|%s|'] en: ['text'].
probeer toepassen: ['%06.2f'] en: 5.5.
probeer toepassen: ['100%% %s'] en: ['sure'].
try-int toepassen: ['%03d'] en: 7.
try-int toepassen: ['%x'] en: 255.
probeer toepassen: ['%d'] en: (Int64 nieuw van-string: ['12']).
probeer toepassen: ['%lld'] en: (Int64 nieuw van-string: ['12']).
probeer toepassen: ['%.1lf'] en: 5.5.
try-int toepassen: ['%hd'] en: 7.

# does not fit
probeer toepassen: ['%s'] en: 12345.
probeer toepassen: ['%d'] en: 12345.
probeer toepassen: ['%f'] en: ['text'].
try-int toepassen: ['%d'] en: ['text'].
try-int toepassen: ['%s'] en: 5.
probeer toepassen: ['%s %s'] en: ['text'].
probeer toepassen: ['%n'] en: ['text'].
probeer toepassen: ['%*s'] en: ['text'].
probeer toepassen: ['%'] en: ['text'].

# length modifier does not fit
probeer toepassen: ['%ls'] en: ['text'].
probeer toepassen: ['%Lf'] en: 5.5.
try-int toepassen: ['%ld'] en: 7.
try-int toepassen: ['%lld'] en: 7.
probeer toepassen: ['%Ld'] en: (Int64 nieuw van-string: ['12']).

# a width that does not fit printf must give an error, not a crash
probeer toepassen: ['%99999999999s'] en: ['text'].
