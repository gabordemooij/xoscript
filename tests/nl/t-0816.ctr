# een format moet passen bij het type van de waarde, het type kan van een client komen
>> probeer := { :formaat :value
	{ Uit schrijf: ( (Format nieuw: formaat) toepassen: value ), stop. } afhandelen: { :e Uit schrijf: e, stop. }, start.
}.
>> probeer-int := { :formaat :value
	{ Uit schrijf: ( (Format nieuw: formaat) toepassen-int: value ), stop. } afhandelen: { :e Uit schrijf: e, stop. }, start.
}.

# past
probeer toepassen: ['|%s|'] en: ['text'].
probeer toepassen: ['%06.2f'] en: 5.5.
probeer toepassen: ['100%% %s'] en: ['zeker'].
probeer-int toepassen: ['%03d'] en: 7.
probeer-int toepassen: ['%x'] en: 255.
probeer toepassen: ['%d'] en: (Int64 nieuw van-string: ['12']).
probeer toepassen: ['%lld'] en: (Int64 nieuw van-string: ['12']).
probeer toepassen: ['%.1lf'] en: 5.5.
probeer-int toepassen: ['%hd'] en: 7.

# past niet
probeer toepassen: ['%s'] en: 12345.
probeer toepassen: ['%d'] en: 12345.
probeer toepassen: ['%f'] en: ['text'].
probeer-int toepassen: ['%d'] en: ['text'].
probeer-int toepassen: ['%s'] en: 5.
probeer toepassen: ['%s %s'] en: ['text'].
probeer toepassen: ['%n'] en: ['text'].
probeer toepassen: ['%*s'] en: ['text'].
probeer toepassen: ['%'] en: ['text'].

# lengtemodifier past niet
probeer toepassen: ['%ls'] en: ['text'].
probeer toepassen: ['%Lf'] en: 5.5.
probeer-int toepassen: ['%ld'] en: 7.
probeer-int toepassen: ['%lld'] en: 7.
probeer toepassen: ['%Ld'] en: (Int64 nieuw van-string: ['12']).

# een breedte die niet in printf past moet een fout geven, geen crash
probeer toepassen: ['%99999999999s'] en: ['text'].
