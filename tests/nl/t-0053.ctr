60 × {
	>> x := (Getal willekeurig % 6) + 1.
	(x ≤ 6) nee: { Uit schrijf: ['FOUT']. }.
	(x ≥0) nee: { Uit schrijf: ['FOUT']. }.
	x := (Getal willekeurig % 3) + 1.
