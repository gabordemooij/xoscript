Getal bij: ['factorial'] doen: {
	>> total := 1.
	{ :index total keer: (zelf - (index)). } × zelf. <- total.
}.
>> Printer := Object nieuw.
Printer bij: ['print:and:'] doen: { :x :y
	Uit schrijf: ['a='] + x + [', b='] + y, stop.
}.
>> a := 4.5. >> b := a laag.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a hoog.
Printer print: a and: b.
a := 4.5. b := a laag.
Printer print: a and: b.
a := 4.5. b := a afgerond.
Printer print: a and: b.
a := 4.2. b := a afgerond.
Printer print: a and: b.

Uit schrijf: (9 modulo: 5), stop.
Uit schrijf: -666 abs, stop.
Uit schrijf: 49 sqrt, stop.
Uit schrijf: (2 tot-de-macht: 3), stop.
>> l := (Reeks ← 9 ; 6).
Uit schrijf: l minimum.

