Getal bij: ['faculteit'] doen: {
	>> totaal := 1.
	{ :index totaal keer: (zelf - (index)). } × zelf. <- totaal.
}.
>> Printer := Object nieuw.
Printer bij: ['druk-af:en:'] doen: { :x :y
	Uit schrijf: ['a='] + x + [', b='] + y, stop.
}.
>> a := 4.5. >> b := a laag.
Printer druk-af: a en: b.
a := 4. b := a faculteit.
Printer druk-af: a en: b.
a := 4.5. b := a hoog.
Printer druk-af: a en: b.
a := 4.5. b := a laag.
Printer druk-af: a en: b.
a := 4.5. b := a afgerond.
Printer druk-af: a en: b.
a := 4.2. b := a afgerond.
Printer druk-af: a en: b.

Uit schrijf: (9 modulo: 5), stop.
Uit schrijf: -666 abs, stop.
Uit schrijf: 49 sqrt, stop.
Uit schrijf: (2 tot-de-macht: 3), stop.
>> l := (Reeks ← 9 ; 6).
Uit schrijf: l minimum.

