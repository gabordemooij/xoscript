>> Dier := Object nieuw.
>> Fabriek := Object nieuw.

Dier bij: ['nieuw'] doen: {
	>> dier := zelf nieuw.
	dier sound: ['?']. <- dier.
}.

Dier bij: ['sound:'] doen: { :s
	eigen geluid := s.
}.

Dier bij: ['geluid'] doen: { <- eigen geluid.
}.

>> Hond := Object nieuw.
>> Kat := Object nieuw.

Hond bij: ['nieuw'] doen: { <- Dier nieuw sound: ['woof!'].
}.

Kat bij: ['nieuw'] doen: { <- Dier nieuw sound: ['meow!'].
}.

Uit schrijf: Hond nieuw geluid, stop.
Uit schrijf: Kat nieuw geluid, stop.

Fabriek bij: ['meng:met:'] doen: { :beest1 :beest2 <- Dier nieuw sound: (
		( beest1 geluid van: 0 lengte: 2 ) +
		( beest2 geluid van: 2 lengte: 5 )
	).
}.

Uit schrijf: (Fabriek meng: Hond nieuw met: Kat nieuw) geluid, stop.
