>> q := Reeks ← 1 ; 2 ; 3.
{ q ? ['1']. } afhandelen: { Uit schrijf: ['caught!'], stop. }, start.
{ q ? Ja. } afhandelen: { Uit schrijf: ['caught!'], stop. }, start.
{ q ? Nee. } afhandelen: { Uit schrijf: ['caught!'], stop. }, start.
{ q ? Niets. } afhandelen: { Uit schrijf: ['caught!'], stop. }, start.
{ q ? (Reeks nieuw). } afhandelen: { Uit schrijf: ['caught!'], stop. }, start.
{ q ? (Object nieuw). } afhandelen: { Uit schrijf: ['caught!'], stop. }, start.
{ q ? ({ ['Empty']. }). } afhandelen: { Uit schrijf: ['caught!'], stop. }, start.
Uit schrijf: ['caught them all'], stop.
