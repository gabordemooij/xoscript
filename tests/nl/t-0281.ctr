>> q := Reeks ← 1 ; 2 ; 3.
{ q ? ['1']. } afhandelen: { Uit schrijf: ['gevangen!'], stop. }, start.
{ q ? Ja. } afhandelen: { Uit schrijf: ['gevangen!'], stop. }, start.
{ q ? Nee. } afhandelen: { Uit schrijf: ['gevangen!'], stop. }, start.
{ q ? Niets. } afhandelen: { Uit schrijf: ['gevangen!'], stop. }, start.
{ q ? (Reeks nieuw). } afhandelen: { Uit schrijf: ['gevangen!'], stop. }, start.
{ q ? (Object nieuw). } afhandelen: { Uit schrijf: ['gevangen!'], stop. }, start.
{ q ? ({ ['Leeg']. }). } afhandelen: { Uit schrijf: ['gevangen!'], stop. }, start.
Uit schrijf: ['allemaal gevangen'], stop.
