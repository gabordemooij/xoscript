Server init.

# JSON-encoder ondersteunt alleen UTF-8, geen surrogaatparen

>> lijsten := Reeks nieuw ;
	# {"key":"normal"} normale ASCII
	( Lijst nieuw zet: ['normaal'] bij: ['key'] ) ;
	# {"key":"hello world"} spatieteken
	( Lijst nieuw zet: ['hello world'] bij: ['key'] ) ;
	# {"key":"quote: \""} dubbel aanhalingsteken
	( Lijst nieuw zet: ['"'] bij: ['key'] ) ;
	# {"key":"backslash: \\"} backslash
	( Lijst nieuw zet: ['backslash: \\'] bij: ['key'] ) ;
	# {"key":"slash: /"} schuine streep
	( Lijst nieuw zet: ['schuine streep: /'] bij: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( Lijst nieuw zet: ['backspace: \b'] bij: ['key'] ) ;
	# {"key":"formfeed: \f"} form-feed-escape
	( Lijst nieuw zet: ['formfeed: \f'] bij: ['key'] ) ;
	# {"key":"newline: \n"} nieuwe regel
	( Lijst nieuw zet: ['newline: \n'] bij: ['key'] ) ;
	( Lijst nieuw zet: ['newline: ↵'] bij: ['key'] ) ;
	( Lijst nieuw zet: ['newline: 
	'] bij: ['key'] ) ;
	# {"key":"carriage return: \r"} carriage return
	( Lijst nieuw zet: ['carriage return: \r'] bij: ['key'] ) ;
	# {"key":"tab: \t"} tab
	( Lijst nieuw zet: ['tab \t'] bij: ['key'] ) ;
	( Lijst nieuw zet: ['tab ⇿'] bij: ['key'] ) ;
	( Lijst nieuw zet: ['tab  '] bij: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( Lijst nieuw zet: ['NUL \u0000'] bij: ['key'] ) ;
	( Lijst nieuw zet: ['NUL \0'] bij: ['key'] ) ;
	# {"key":"control: \u0001"} stuurteken 0x01
	( Lijst nieuw zet: ['control: \u0001'] bij: ['key'] ) ;
	# {"key":"control: \u001F"} stuurteken 0x1F
	( Lijst nieuw zet: ['control: \u001F'] bij: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, teken van 2 bytes
	( Lijst nieuw zet: ['unicode: é'] bij: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, teken van 3 bytes
	( Lijst nieuw zet: ['unicode: €'] bij: ['key'] ) ;
	# {"key":"unicode: 日本語"} meerdere UTF-8-tekens van 3 bytes
	( Lijst nieuw zet: ['unicode: 日本語'] bij: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, teken van 4 bytes
	( Lijst nieuw zet: ['unicode: 😀'] bij: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	( Lijst nieuw zet: ['unicode: 🧑‍💻'] bij: ['key'] ) ;
	# {"key":"combining: é"} combinerend accent
	( Lijst nieuw zet: ['combining: e\u0301'] bij: ['key'] ) ;
	# {"key":"escaped unicode: é"} Unicode-escape BMP
	( Lijst nieuw zet: ['escaped unicode: \u00e9'] bij: ['key'] ) ;
	# {"key":"escaped unicode: €"} Unicode-escape BMP
	( Lijst nieuw zet: ['escaped unicode: \u20ac'] bij: ['key'] ) ;
	# {"key":"escaped unicode: 😀"} UTF-16-surrogaatpaar
	( Lijst nieuw zet: ['escaped unicode: \ud83d\ude00'] bij: ['key'] ) ;
	# {"key":""} lege waarde
	( Lijst nieuw zet: [''] bij: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} speciale ASCII-tekens
	( Lijst nieuw zet: ['@ < > & = % + ? #'] bij: ['key'] ) ;
	# {"key":"single quote: '"} enkel aanhalingsteken
	( Lijst nieuw zet: ['''] bij: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} meerdere JSON-escapes
	( Lijst nieuw zet: ['multiple: \" \\ \n \r \t'] bij: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} langere ASCII-tekst
	( Lijst nieuw zet: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] bij: ['key'] ) ;
	# {"key":" value"} spatie vooraan
	( Lijst nieuw zet: [' waarde'] bij: ['key'] ) ;
	# {"key":"value "} spatie achteraan
	( Lijst nieuw zet: ['waarde '] bij: ['key'] ) ;
	# {"key":" \t\n\r "} witruimte
	( Lijst nieuw zet: [' \t\n\r '] bij: ['key'] )
	.

lijsten elk: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (Lijst nieuw zet: d key bij: ['key']).
	>> b := JSON jsonify: (Lijst nieuw zet: ['value'] bij: d key).
	>> e := JSON object: a.
	>> f := JSON object: b.
	((e key = d key en: (f ? d key = ['value'])) of: (e key = ['NUL ?'])) ja: {
		Uit schrijf: ['OK'], stop.
	}, anders: {
		Uit schrijf: ['Kan niet goed coderen/decoderen: '] + d + j, stop.
		Programma einde.
	}.
}.
