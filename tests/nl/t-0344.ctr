# catch-all test (practical)
>> HTML := Tekst nieuw.
HTML bij: ['encode:'] doen: { :tekst
	zelf toevoegen: (tekst
	vervang: ['&'] door: ['&amp;'], 
	vervang: ['<'] door: ['&lt;'],
	vervang: ['>'] door: ['&gt;'],
	vervang: ['"'] door: ['&quot;']).
}.
>> blog := HTML nieuw.
blog toevoegen: ['<h1>'],
     encode: ['Koffie & Thee'],
     toevoegen: ['</h1>'].
Uit schrijf: blog, stop.


>> Roman := Getal nieuw.
Roman bij: ['stringy'] doen: {
	>> a := [''].
	{ a toevoegen: ['I']. } × zelf. <- a.
}.

>> x := Roman nieuw.
x optellen: 3.
Uit schrijf: x stringy, stop.

>> Quantum := Boolean nieuw.
Quantum bij: ['true?'] doen: { <- ['maybe True']. }.
Uit schrijf: (Quantum nieuw true?), stop.

>> Nihil := Niets nieuw.
Nihil bij: ['tekst'] doen: { <- ['Nihil']. }.
Uit schrijf: (Nihil nieuw), stop.
