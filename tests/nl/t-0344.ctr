# catch-all-test (praktisch)
>> HTML := Tekst nieuw.
HTML bij: ['encode:'] doen: { :invoertekst
	zelf toevoegen: (invoertekst
	vervang: ['&'] door: ['&amp;'], 
	vervang: ['<'] door: ['&lt;'],
	vervang: ['>'] door: ['&gt;'],
	vervang: ['"'] door: ['&quot;']).
}.
>> blog := HTML nieuw.
blog toevoegen: ['<h1>'],
     encode: ['Koffie & Thee'],
     toevoegen: ['</h1>'].
Uit schrijf: blog, stop.


>> Romeins := Getal nieuw.
Romeins bij: ['tekstachtig'] doen: {
	>> a := [''].
	{ a toevoegen: ['I']. } × zelf. <- a.
}.

>> x := Romeins nieuw.
x optellen: 3.
Uit schrijf: x tekstachtig, stop.

>> Kwantum := Boolean nieuw.
Kwantum bij: ['true?'] doen: { <- ['misschien Ja']. }.
Uit schrijf: (Kwantum nieuw true?), stop.

>> Nihil := Niets nieuw.
Nihil bij: ['tekst'] doen: { <- ['Nihil']. }.
Uit schrijf: (Nihil nieuw), stop.
