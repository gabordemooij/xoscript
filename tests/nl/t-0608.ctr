
>> Size := Object nieuw.
Size bij: ['is:'] doen: { :getal
	getal bij: ['+'] doen: { :getal
		>> unit := getal kwalificering.
		>> factor := 1.
		
		unit
		geval: ['inch'] doen: { factor := 0.0833. }. <- zelf + (getal * factor).
	}. <- getal.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Uit schrijf: plank + edge, stop.
