# Alarm instellen

# beëindigt het programma na 1 sec.
Programma maxtijd: 1.

Uit schrijf: ['max 1 sec.'], stop.
Moment wacht: 2.
Uit schrijf: ['duurt te lang.'], stop.

# let op:
# Een alarm instellen is onomkeerbaar,
# een aanvaller kan het niet uitschakelen.
# Na de eerste aanroep is het alarm vergrendeld.
# Het alarm is ook echt hard,
# het programma *WORDT* gestopt na het
# opgegeven tijdsinterval, zelfs als het
# in een blokkerende leesactie of zoiets zit.

# let op:
# Alarm is zwaar, overweeg in plaats daarvan
# eenvoudige time-outs in de webserver in te stellen.



