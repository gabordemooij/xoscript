>> HTML := Object nieuw.
HTML bij: ['reactie:'] doen: { :tag 
	Uit schrijf: (['<tag>'] tag: tag), stop.
}.
HTML bij: ['reactie:argument:'] doen: { :tag :html 
	Uit schrijf: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), stop.
}.
>> html := HTML nieuw.
html body h1: ['header'].

