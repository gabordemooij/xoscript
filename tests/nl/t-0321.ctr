# test kwalificeringen

Programma vegen.

>> Fruit := Object nieuw.
Fruit bij: ['nieuw'] doen: {
	>> f := zelf nieuw.
	f apples: 0. <- f.
}.
Fruit bij: ['apples:'] doen: { :a eigen appels := a. }.
Fruit bij: ['appels'] doen: { <- eigen appels. }.
Fruit bij: ['+'] doen: { :f
	>> n := Fruit nieuw.
	n apples: (f appels + eigen appels). <- n.
}.
Getal bij: ['appels'] doen: { <- ((Fruit nieuw) apples: zelf).
}.

Fruit bij: ['tekst'] doen: { <- eigen appels + [' appels '].
}.

>> q := 3 appels + 4 appels.
Uit schrijf: q, stop.




q := 3 appels + 4 appels.
Uit schrijf: q, stop.



q := 3 appels + 4 appels.
Uit schrijf: q, stop.


