# test qualifiers

Programma vegen.

>> Fruit := Object nieuw.
Fruit bij: ['nieuw'] doen: {
	>> f := zelf nieuw.
	f apples: 0. <- f.
}.
Fruit bij: ['apples:'] doen: { :a eigen apples := a. }.
Fruit bij: ['apples'] doen: { <- eigen apples. }.
Fruit bij: ['+'] doen: { :f
	>> n := Fruit nieuw.
	n apples: (f apples + eigen apples). <- n.
}.
Getal bij: ['apples'] doen: { <- ((Fruit nieuw) apples: zelf).
}.

Fruit bij: ['tekst'] doen: { <- eigen apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Uit schrijf: q, stop.




q := 3 apples + 4 apples.
Uit schrijf: q, stop.



q := 3 apples + 4 apples.
Uit schrijf: q, stop.


