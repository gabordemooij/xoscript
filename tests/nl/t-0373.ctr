# compliance test

# use international numbers

Uit schrijf: ['1000 -> '].
Uit schrijf: 1000, stop. #1000

Uit schrijf: ['1.5 -> '].
Uit schrijf: 1.5, stop.  #1.5

Uit schrijf: ['1001.5 -> '].
Uit schrijf: 1.5 + 1000, stop. #1001.5

# use 0-indexed arrays
>> x := Reeks nieuw ; 1 ; 2 ; 3.
>> y := Reeks nieuw ; ['a'] ; ['b'] ; ['c'].

Uit schrijf: ['1 -> '].
Uit schrijf: x ? 0, stop. #1

Uit schrijf: ['1 -> '].
Uit schrijf: (x bij: 0), stop. #1

Uit schrijf: ['1 -> '].
Uit schrijf: x eerste, stop. #1

Uit schrijf: ['3 -> '].
Uit schrijf: x laatste, stop. #3

Uit schrijf: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Uit schrijf: (x per: y), stop.

Uit schrijf: ['1 -> '].
Uit schrijf: (x van: 0 lengte: 1) eerste, stop. #1

Uit schrijf: ['0 -> '].
Uit schrijf: (x zoek: 1), stop. #0

x zet: 9 bij: 0.

Uit schrijf: ['9 -> '].
Uit schrijf: (x bij: 0), stop. #9

x invoegen: 8.
Uit schrijf: ['8 -> '].
Uit schrijf: (x bij: 0), stop. #9


x toevoegen: 10.
Uit schrijf: ['10 -> '].
Uit schrijf: (x bij: 4), stop. #10








