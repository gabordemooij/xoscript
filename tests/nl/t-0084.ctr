>> makeAdder := { :x
	>> f := { :y <- (eigen x + y). } gebruik: ['x'] waarde: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i eigen q zet: (eigen f toepassen: (eigen q ? i)) bij: i. } 
	gebruik: ['q'] waarde: array,
	gebruik: ['f'] waarde: func.
	{ :i mapping toepassen: i. } × (array aantal).
}.

>> a := Reeks ← 1; 2; 3.
mapper toepassen: a en: (makeAdder toepassen: 100).
Uit schrijf: (a positie: 0), stop.
Uit schrijf: (a ? 1), stop.
Uit schrijf: (a ? 2), stop.
