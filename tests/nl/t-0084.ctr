>> maakOpteller := { :x
	>> f := { :y <- (eigen x + y). } gebruik: ['x'] waarde: x. <- f.
}.
>> afbeelder := { :array :fn
	>> afbeelding := { :i eigen q zet: (eigen f toepassen: (eigen q ? i)) bij: i. } 
	gebruik: ['q'] waarde: array,
	gebruik: ['f'] waarde: fn.
	{ :i afbeelding toepassen: i. } × (array aantal).
}.

>> a := Reeks ← 1; 2; 3.
afbeelder toepassen: a en: (maakOpteller toepassen: 100).
Uit schrijf: (a positie: 0), stop.
Uit schrijf: (a ? 1), stop.
Uit schrijf: (a ? 2), stop.
