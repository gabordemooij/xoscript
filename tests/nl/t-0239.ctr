Reeks bij: ['som'] doen: {
	>> totaal := 0.
	zelf elk: { :index :element
		totaal optellen: element.
	}. <- totaal.
}.

>> a := Ja.



a bij: ['tekst'] doen: {
	>> antwoordwaarde := Niets.
	( zelf = Ja ) ja: {
		antwoordwaarde := ['Jep'].
	}, anders: {
		antwoordwaarde := ['Nee hoor'].
	}. <- antwoordwaarde.
}.

a bij: ['getal'] doen: {
	>> antwoordwaarde := Niets.
	( zelf = Ja ) ja: {
		antwoordwaarde := 10.
	}, anders: {
		antwoordwaarde := 20.
	}. <- antwoordwaarde.
}.

>> b := 666.

b bij: ['tekst'] doen: { <- ['Duivel'].
}.

b bij: ['bool'] doen: { <- Nee.
}.


Uit schrijf: a, stop.  
Uit schrijf: (90 + a), stop. 
Uit schrijf: b, stop. 
Uit schrijf: (Ja en: b), stop.

a := Reeks ← ['hello'] ; ['world'] ; Ja ; Niets ; 666. 
a := a + ( Reeks ← 1 ).
Uit schrijf: a, stop.
Uit schrijf: ((Lijst nieuw) zet: Niets bij: Niets), stop.
Uit schrijf: a som, stop. 


{
	a bij: ['tekst'] doen: { <- Niets. }.
	a := [''] + a.
} afhandelen: { :fout
	Uit schrijf: ['Fout genoteerd: '] + fout, stop.
}, start.



{
	a bij: ['getal'] doen: { <- Niets. }.
	a := 3 × a.
} afhandelen: { :fout
	Uit schrijf: ['Fout genoteerd: '] + fout, stop.
}, start.


{
	a bij: ['bool'] doen: { <- Niets. }.
	a := Ja en: a. 
} afhandelen: { :fout
	Uit schrijf: ['Fout genoteerd: '] + fout, stop.
}, start.





