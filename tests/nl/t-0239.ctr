Reeks bij: ['sum'] doen: {
	>> total := 0.
	zelf elk: { :index :element
		total optellen: element.
	}. <- total.
}.

>> a := Ja.



a bij: ['tekst'] doen: {
	>> answer := Niets.
	( zelf = Ja ) ja: {
		answer := ['Yep'].
	}, anders: {
		answer := ['Nope'].
	}. <- answer.
}.

a bij: ['getal'] doen: {
	>> answer := Niets.
	( zelf = Ja ) ja: {
		answer := 10.
	}, anders: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b bij: ['tekst'] doen: { <- ['Devil'].
}.

b bij: ['bool'] doen: { <- Nee.
}.


Uit schrijf: a, stop.  
Uit schrijf: (90 + a), stop. 
Uit schrijf: b, stop. 
Uit schrijf: (Ja en: b), stop.

a := Reeks ← ['hello'] ; ['world'] ; Ja ; Niets ; 666. 
a := a + ( Reeks ← 1 ).
Uit schrijf: a, stop.
Uit schrijf: ((Lijst nieuw) zet: Niets bij: Niets), stop.
Uit schrijf: a sum, stop. 


{
	a bij: ['tekst'] doen: { <- Niets. }.
	a := [''] + a.
} afhandelen: { :error
	Uit schrijf: ['Error noted: '] + error, stop.
}, start.



{
	a bij: ['getal'] doen: { <- Niets. }.
	a := 3 × a.
} afhandelen: { :error
	Uit schrijf: ['Error noted: '] + error, stop.
}, start.


