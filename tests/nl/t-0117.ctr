>> t := Ja.
(t = Ja) ja: { Uit schrijf: ['T']. }.
(t = Nee) ja: { Uit schrijf: ['F']. }.
Uit schrijf: ['|'].
>> t := Nee.
(t = Ja) ja: { Uit schrijf: ['T']. }.
(t = Nee) ja: { Uit schrijf: ['F']. }.
Uit schrijf: ['|'].
>> f := Ja.
(t = Ja en: f = Nee) ja: { Uit schrijf: ['T']. }.
(t = Nee en: f = Ja) ja: { Uit schrijf: ['F']. }.
Uit schrijf: ['|'].
>> n := Niets.
(n Niets?) ja: { Uit schrijf: ['T']. }.
(n Niets?) nee: { Uit schrijf: ['F']. }.
Uit schrijf: ['|'].
(f Boolean?) ja: { Uit schrijf: ['T']. }.
(f Boolean?) nee: { Uit schrijf: ['F']. }.



