


>> wijn := Object nieuw.


wijn bij: ['naarTekst'] doen: { <- ['merlot'].
}.

wijn bij: ['naarTekst'] doen: { <- ['merlot'].
}.


wijn bij: ['='] doen: { :other wine <- ( zelf naarTekst = other wine ).
}.

wijn bij: ['=='] doen: { :other wine <- ( zelf naarTekst = other wine ).
}.



wijn
	geval: ['cabernet'] doen: { Uit schrijf: ['het is een Cabernet!']. },
	geval: ['syrah']    doen: { Uit schrijf: ['het is een Syrah!'].    },
	geval: ['merlot']   doen: { Uit schrijf: ['het is een Merlot!'].   },
	geval: ['malbec']   doen: { Uit schrijf: ['het is een Malbec!'].   }.

Uit stop.
