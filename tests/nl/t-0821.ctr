# a quote that never closes must give an error, not an endless loop
>> pad := ['/tmp/test0821.csv'].
>> file := Bestand nieuw: pad.

file schrijf: ['a,b\n"1,2\n'].
{
	file scheidingsteken: [','] aanhalingsteken: ['"'] regels: { :line
		Uit schrijf: line, stop.
	}.
} afhandelen: { :e Uit schrijf: e, stop. }, start.

# a closed quote still works
file schrijf: ['a,b\n"1,2",3'].
file scheidingsteken: [','] aanhalingsteken: ['"'] regels: { :line
	Uit schrijf: line, stop.
}.
file verwijderen.
