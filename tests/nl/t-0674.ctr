# normale flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> pad := ['/tmp/dat.csv'].
>> csv := Bestand nieuw: pad.
csv schrijf: s.

# accepteert CRLF LF CR, wisselende rijlengte
csv scheidingsteken: [';'] aanhalingsteken: ['"'] regels: { :line
	Programma vegen.
	Uit schrijf: line, stop.
	Programma vegen.
}.

# ongelijke regels
s toevoegen: ['\njustone'].
csv schrijf: s.
{
	csv scheidingsteken: [';'] aanhalingsteken: ['"'] regels: { :line
		Uit schrijf: line, stop.
	}.
} afhandelen: { :e 
	Uit schrijf: e, stop.
}, start.

# ongeldig formaat
s := ['"he"llo";world'].
csv schrijf: s.
{
	csv scheidingsteken: [';'] aanhalingsteken: ['"'] regels: { :line
		Uit schrijf: line, stop.
	}.
} afhandelen: { :e 
	Uit schrijf: e, stop.
}, start.
