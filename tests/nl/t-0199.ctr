
Programma geheugenbeheer: 4.

>> Dier := Object nieuw.
Dier bij: ['maak'] doen: {
	>> dier := Object nieuw.
	dier bij: ['maakGeluid'] doen: {
		Uit schrijf: eigen geluid.
	}. <- dier.
}.
>> Kat := Object nieuw.
Kat bij: ['maak'] doen: {
	>> kat := Dier maak.
	kat bij: ['init'] doen: {
		eigen geluid := ['meow!'].
	}.
	kat init. <- kat.
}.
>> tom := Kat maak.
tom maakGeluid.
