
Programma geheugenbeheer: 4.

>> Animal := Object nieuw.
Animal bij: ['make'] doen: {
	>> animal := Object nieuw.
	animal bij: ['makeSound'] doen: {
		Uit schrijf: eigen sound.
	}. <- animal.
}.
>> Cat := Object nieuw.
Cat bij: ['make'] doen: {
	>> cat := Animal make.
	cat bij: ['init'] doen: {
		eigen sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
