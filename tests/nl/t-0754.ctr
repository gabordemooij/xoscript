Uit schrijf: ['Test object'], stop.
>> a := Object nieuw. 

a bij: ['item:'] doen: { :out
	eigen out := out. 
}.

a bij: ['item'] doen: { <- eigen out.
}.

a bij: ['greet'] doen: {
	Uit schrijf: ['hi from original out!'], stop.
}.

a item: Uit.

Uit schrijf: a item, stop.

>> old-out-address := a item prototype geheugenadres.
a save-as: ['/tmp/a.bin'].
Uit schrijf: ['========== RELOADING SNAP:'], stop.

>> b := Object load-from: ['/tmp/a.bin'].

(b item prototype geheugenadres = old-out-address) ja: {
	Uit schrijf: ['Object link re-attached.'], stop.
}.

b item schrijf: ['hello from loaded out!'], stop.
b greet.
