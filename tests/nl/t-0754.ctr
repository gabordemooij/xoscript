Uit schrijf: ['Testobject'], stop.
>> a := Object nieuw. 

a bij: ['item:'] doen: { :uitv
	eigen uitv := uitv. 
}.

a bij: ['onderdeel'] doen: {
	<- eigen uitv.
}.

a bij: ['groet'] doen: {
	Uit schrijf: ['hoi van de originele out!'], stop.
}.

a item: Uit.

Uit schrijf: a onderdeel, stop.

>> oud-uitv-adres := a onderdeel prototype geheugenadres.
a save-as: ['/tmp/a.bin'].
Uit schrijf: ['========== SNAP HERLADEN:'], stop.

>> b := Object load-from: ['/tmp/a.bin'].

(b onderdeel prototype geheugenadres = oud-uitv-adres) ja: {
	Uit schrijf: ['Objectkoppeling opnieuw verbonden.'], stop.
}.

b onderdeel schrijf: ['hallo van de geladen out!'], stop.
b groet.
