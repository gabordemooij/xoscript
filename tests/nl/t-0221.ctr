>> x := Object nieuw.
>> y := Object nieuw.
>> z := x.
Uit schrijf: (x = z), stop.
Uit schrijf: (x = y), stop.
Uit schrijf: (x ≠ y), stop.
Uit schrijf: (x ≠ z), stop.
>> m := Moment nieuw jaar: 2070, maand: 11.
>> n := m kopieer.
Uit schrijf: (m = n), stop.
Uit schrijf: (m ≠ n), stop.
Uit schrijf: (m gelijk: m), stop.
Uit schrijf: (m gelijk: n), stop.
n maand: 12.
Uit schrijf: (m ≠ n), stop.
Uit schrijf: (m = n), stop.


