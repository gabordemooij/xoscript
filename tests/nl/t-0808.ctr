# kluissleutels en handtekeningen die te lang decoderen mogen de stack niet laten overlopen
Server init.

>> sleutels := Kluis crypto-sleutels.
>> gs := sleutels eerste.
>> ps := sleutels laatste.
>> handt := Kluis onderteken: ['abc'] met: gs.

# 88 tekens zonder opvulling decoderen naar 66 bytes
>> lang := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 tekens zonder opvulling decoderen naar 33 bytes
>> kort := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Kluis onderteken: ['abc'] met: lang. } afhandelen: { :e
	Uit schrijf: e, stop.
}, start.

{ Kluis controleer: ['abc'] ondertekening: lang met: ps. } afhandelen: { :e
	Uit schrijf: e, stop.
}, start.

{ Kluis controleer: ['abc'] ondertekening: handt met: kort. } afhandelen: { :e
	Uit schrijf: e, stop.
}, start.
