>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Object nieuw.
⚄ bij: ['drawFrom:length:'] doen: { :pool :aantal
	
	>> result := [''].
	
	{
		>> index := Getal random % (pool lengte).
		result toevoegen: ( pool letter: (index + 1) ).
		
	} × aantal. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? lengte.
Uit schrijf: (['x↵'] x random lengte).
Uit schrijf: (['y↵'] y ?? lengte).

