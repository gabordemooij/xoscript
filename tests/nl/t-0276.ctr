>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Object nieuw.
⚄ bij: ['trekUit:lengte:'] doen: { :voorraad :aantal
	
	>> resultaat := [''].
	
	{
		>> index := Getal willekeurig % (voorraad lengte).
		resultaat toevoegen: ( voorraad letter: (index + 1) ).
		
	} × aantal. <- resultaat.
}.

>> willekeurig := ⚄ trekUit: ?? lengte: ?? lengte.
Uit schrijf: (['x↵'] x willekeurig lengte).
Uit schrijf: (['y↵'] y ?? lengte).

