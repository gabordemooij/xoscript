
>> city := Reeks ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Reeks ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature per: city.
>> cities := weather ingangen sorteren: { :a :b <- (a vergelijk: b). }.
>> temperatures := weather waarden sorteren: { :a :b <- (a vergelijk: b) negatief?. }.

Uit schrijf: (cities samenvoegen: [',']), stop.
Uit schrijf: (temperatures samenvoegen: [',']), stop.
