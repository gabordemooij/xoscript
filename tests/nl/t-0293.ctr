
>> stad := Reeks ← ['Londen'] ; ['Parijs'] ; ['Berlijn'].
>> temperatuur := Reeks ← ['15'] ; ['16'] ; ['15'].
>> weer := temperatuur per: stad.
>> steden := weer ingangen sorteren: { :a :b <- (a vergelijk: b). }.
>> temperaturen := weer waarden sorteren: { :a :b <- (a vergelijk: b) negatief?. }.

Uit schrijf: (steden samenvoegen: [',']), stop.
Uit schrijf: (temperaturen samenvoegen: [',']), stop.
