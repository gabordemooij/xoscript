
Reeks bij: ['sum'] doen: {
	>> total := 0.
	zelf elk: { :index :element
		total optellen: element.
	}. <- total.
}.

>> a := Reeks ← 9 ; 8 ; 7.
Uit schrijf: (a sum), stop. 
>> a := Reeks ← 1 ; 9.
Uit schrijf: (a sum), stop. 
>> a := Reeks ← ['o'] ; 2.
Uit schrijf: (a sum), stop. 
Uit schrijf: (Reeks nieuw sum), stop. 
