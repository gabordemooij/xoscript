
Reeks bij: ['som'] doen: {
	>> totaal := 0.
	zelf elk: { :index :element
		totaal optellen: element.
	}. <- totaal.
}.

>> a := Reeks ← 9 ; 8 ; 7.
Uit schrijf: (a som), stop. 
>> a := Reeks ← 1 ; 9.
Uit schrijf: (a som), stop. 
>> a := Reeks ← ['o'] ; 2.
Uit schrijf: (a som), stop. 
Uit schrijf: (Reeks nieuw som), stop. 
