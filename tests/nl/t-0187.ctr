Getal bij: ['faculteit'] doen: {
	>> totaal := 1.
	{ :index totaal keer: (zelf - index). } × zelf. <- totaal.
}.

>> gebruiktGeheugen1 := 0.
>> gebruiktGeheugen2 := 0.
>> gebruiktGeheugen3 := 0.
>> gebruiktGeheugen4 := 0.

Programma geheugenbeheer: 0.

{
2 exponent faculteit.
Uit schrijf: (11 modulo: 3), stop.
Uit schrijf: (3.4 afgerond), stop.
Uit schrijf: (7.1 hoog), stop.
Uit schrijf: (7.9 laag), stop.
}
start.

Programma vegen.

gebruiktGeheugen1 := (Programma geheugen ? 0).

{
2 exponent faculteit.
Uit schrijf: (11 modulo: 3), stop.
Uit schrijf: (3.4 afgerond), stop.
Uit schrijf: (7.1 hoog), stop.
Uit schrijf: (7.9 laag), stop.
}
start.

Programma vegen.
gebruiktGeheugen2 := (Programma geheugen ? 0).


{
2 exponent faculteit.
Uit schrijf: (11 modulo: 3), stop.
Uit schrijf: (3.4 afgerond), stop.
Uit schrijf: (7.1 hoog), stop.
Uit schrijf: (7.9 laag), stop.
} start.

Programma vegen.
gebruiktGeheugen3 := (Programma geheugen ? 0).



( gebruiktGeheugen1 = gebruiktGeheugen2 en: gebruiktGeheugen1 = gebruiktGeheugen3, en: gebruiktGeheugen2 = gebruiktGeheugen3 ) ja: {
	Uit schrijf: ['Hier geen geheugenlekken'].
}, nee: {
	Uit schrijf: ['Geheugen lekt...'].
}.
