Getal bij: ['factorial'] doen: {
	>> total := 1.
	{ :index total keer: (zelf - index). } × zelf. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programma geheugenbeheer: 0.

{
2 exponent factorial.
Uit schrijf: (11 modulo: 3), stop.
Uit schrijf: (3.4 afgerond), stop.
Uit schrijf: (7.1 hoog), stop.
Uit schrijf: (7.9 laag), stop.
}
start.

Programma vegen.

usedMemory1 := (Programma geheugen ? 0).

{
2 exponent factorial.
Uit schrijf: (11 modulo: 3), stop.
Uit schrijf: (3.4 afgerond), stop.
Uit schrijf: (7.1 hoog), stop.
Uit schrijf: (7.9 laag), stop.
}
start.

Programma vegen.
usedMemory2 := (Programma geheugen ? 0).


{
2 exponent factorial.
Uit schrijf: (11 modulo: 3), stop.
Uit schrijf: (3.4 afgerond), stop.
Uit schrijf: (7.1 hoog), stop.
Uit schrijf: (7.9 laag), stop.
} start.

Programma vegen.
usedMemory3 := (Programma geheugen ? 0).



( usedMemory1 = usedMemory2 en: usedMemory1 = usedMemory3, en: usedMemory2 = usedMemory3 ) ja: {
	Uit schrijf: ['No memory leaks here'].
}, nee: {
	Uit schrijf: ['Leaking memory...'].
}.
