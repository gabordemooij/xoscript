>> Point := Object nieuw.
Point bij: ['x-coordinate:'] doen: { :x eigen x := x. }.
Point bij: ['y-coordinate:'] doen: { :y eigen y := y. }.
Point bij: ['x-coordinate']  doen: { <- eigen x kopieer. }.
Point bij: ['y-coordinate']  doen: { <- eigen y kopieer. }.

Point bij: ['='] doen: { :other <- ( eigen x = other x-coordinate
		 en: eigen y = other y-coordinate ).
}.

>> pier := Point nieuw x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point nieuw x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point nieuw x-coordinate: 5, y-coordinate: 6.

Uit schrijf: pier = town-hall, stop.
Uit schrijf: pier = restaurant, stop.
