>> Punt := Object nieuw.
Punt bij: ['x-coordinate:'] doen: { :x eigen x := x. }.
Punt bij: ['y-coordinate:'] doen: { :y eigen y := y. }.
Punt bij: ['x-coördinaat']  doen: { <- eigen x kopieer. }.
Punt bij: ['y-coördinaat']  doen: { <- eigen y kopieer. }.

Punt bij: ['='] doen: { :ander
	<- ( eigen x = ander x-coördinaat
		 en: eigen y = ander y-coördinaat ).
}.

>> steiger := Punt nieuw x-coordinate: 5, y-coordinate: 6.
>> stadhuis := Punt nieuw x-coordinate: 7, y-coordinate: 1.
>> restaurant := Punt nieuw x-coordinate: 5, y-coordinate: 6.

Uit schrijf: steiger = stadhuis, stop.
Uit schrijf: steiger = restaurant, stop.
