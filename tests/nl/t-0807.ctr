# foutmeldingen van de databank mogen niet als formatteksten behandeld worden
Server init.

>> db := Maria-DB nieuw host: ['localhost'],
	gebruikersnaam: ['xo'],
	wachtwoord: ['pass123'],
	databanknaam: ['xobase'],
	verbinden.

>> zoekparameters := db query: ['SELECT %% FROM'].
{ zoekparameters uitvoeren. } afhandelen: { :e
	Uit schrijf: ( e bevat: ['%%'] ), stop.
}, start.
