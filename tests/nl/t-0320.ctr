


>> CoffeeMachine := Object nieuw.
CoffeeMachine bij: ['order:'] doen: { :id
	>> coffee := ['Americano'].
	( id = 1 ) ja: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) ja: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) ja: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Object nieuw.
SimpleCoffeeMachine bij: ['order'] doen: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Uit schrijf: redCup, stop.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Uit schrijf: greenCup, stop.
>> yellowCup := CoffeeMachine order: 1.
Uit schrijf: yellowCup, stop.
>> blueCup := CoffeeMachine order: 0.
Uit schrijf: blueCup, stop.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Uit schrijf: blackCup, stop.
blackCup toevoegen: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Uit schrijf: orangeCup, stop.
