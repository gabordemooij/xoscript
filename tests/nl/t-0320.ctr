


>> Koffiemachine := Object nieuw.
Koffiemachine bij: ['order:'] doen: { :id
	>> coffee := ['Americano'].
	( id = 1 ) ja: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) ja: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) ja: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> EenvoudigeKoffiemachine := Object nieuw.
EenvoudigeKoffiemachine bij: ['bestelling'] doen: { <- ['Zwart']. }.
>> rodeBeker := Koffiemachine order: 1.
Uit schrijf: rodeBeker, stop.
rodeBeker := ['Thee']. 
>> groeneBeker := Koffiemachine order: 0.
Uit schrijf: groeneBeker, stop.
>> geleBeker := Koffiemachine order: 1.
Uit schrijf: geleBeker, stop.
>> blauweBeker := Koffiemachine order: 0.
Uit schrijf: blauweBeker, stop.
>> plasticBeker := EenvoudigeKoffiemachine bestelling.
plasticBeker := ['Limonade']. 
>> zwarteBeker := EenvoudigeKoffiemachine bestelling.
Uit schrijf: zwarteBeker, stop.
zwarteBeker toevoegen: [' neeee.... bier. '].
>> oranjeBeker := EenvoudigeKoffiemachine bestelling.
Uit schrijf: oranjeBeker, stop.
