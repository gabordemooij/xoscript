
Uit schrijf: ['Onderbreek for-lus, 0-4.'], stop.
{ :i
	Uit schrijf: ['iteration #'] + i, stop.
	(i = 4) afbreken.
} × 10.

>> x := 0.
>> xIsKleinerDan10 := { <- ( x < 10 ). }.

Uit schrijf: ['Onderbreek while-true-lus, 0-4.'], stop.
{
	Uit schrijf: ['iteration #'] + x, stop.
	x optellen: 1.
	((x < 5) niet) afbreken.
} zolang: xIsKleinerDan10.

Uit schrijf: ['Onderbreek while-false-lus, 5,4.'], stop.
{
	Uit schrijf: ['iteration #'] + x, stop.
	x aftrekken: 1.
	(x = 3) afbreken.
} zolang: { <- (x > 0). }.

Uit schrijf: ['Onderbreek keer-lus, 1-4.'], stop.
{ :i
	Uit schrijf: ['iteration #'] + i, stop.
	(i = 4) afbreken.
} × 5.

Uit schrijf: ['Onderbreek blok, print regel niet.'], stop.
{ Ja afbreken. Uit schrijf: ['schrijf dit niet!'], stop. } start.

Uit schrijf: ['Onderbreek blok, activeer catch niet...'], stop.
{ Ja afbreken. Uit schrijf: ['schrijf dit niet!'], stop. } afhandelen: { Uit schrijf: ['Vang dit niet!']. }, start.

Uit schrijf: ['Test Reeks each-lus: 0,1'], stop.
(Reeks ← 1 ; 2 ; 3) lijst: { :i
	Uit schrijf: ['iteration #'] + i, stop.
	(i = 1) afbreken.
}.

Uit schrijf: ['Test Lijst each-lus: alleen c'], stop.
>> m := Lijst nieuw.
m zet: ['first'] bij: ['a'], zet: ['second'] bij: ['b'], zet: ['derde'] bij: ['c'].
m elk: { :k :v
	Uit schrijf: ['iteration'] + v + k, stop.
	Ja afbreken.
}.

