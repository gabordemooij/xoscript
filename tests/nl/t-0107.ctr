
Uit schrijf: ['Break for-loop, 0-4.'], stop.
{ :i
	Uit schrijf: ['iteration #'] + i, stop.
	(i = 4) afbreken.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Uit schrijf: ['Break while-true loop, 0-4.'], stop.
{
	Uit schrijf: ['iteration #'] + x, stop.
	x optellen: 1.
	((x < 5) niet) afbreken.
} zolang: xIsLessThan10.

Uit schrijf: ['Break while-false loop, 5,4.'], stop.
{
	Uit schrijf: ['iteration #'] + x, stop.
	x aftrekken: 1.
	(x = 3) afbreken.
} zolang: { <- (x > 0). }.

Uit schrijf: ['Break times loop, 1-4.'], stop.
{ :i
	Uit schrijf: ['iteration #'] + i, stop.
	(i = 4) afbreken.
} × 5.

Uit schrijf: ['Break block, dont print line.'], stop.
{ Ja afbreken. Uit schrijf: ['dont write this!'], stop. } start.

Uit schrijf: ['Break block, dont fire catch...'], stop.
{ Ja afbreken. Uit schrijf: ['dont write this!'], stop. } afhandelen: { Uit schrijf: ['Dont catch this!']. }, start.

Uit schrijf: ['Test Array each-loop: 0,1'], stop.
(Reeks ← 1 ; 2 ; 3) lijst: { :i
	Uit schrijf: ['iteration #'] + i, stop.
	(i = 1) afbreken.
}.

Uit schrijf: ['Test Map each-loop: c only'], stop.
>> m := Lijst nieuw.
m zet: ['first'] bij: ['a'], zet: ['second'] bij: ['b'], zet: ['third'] bij: ['c'].
m elk: { :k :v
	Uit schrijf: ['iteration'] + v + k, stop.
	Ja afbreken.
}.

