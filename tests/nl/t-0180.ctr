Tekst bij: ['html'] doen: { <- (
		zelf
		vervang: ['&'] door: ['&amp;'],
		vervang: ['<'] door: ['&lt;'],
		vervang: ['>'] door: ['&gt;'],
		vervang: ['''] door: ['&apos;'],
		vervang: ['"'] door: ['&quot;']
	).
}.

>> gebruiktGeheugen1 := 0.
>> gebruiktGeheugen2 := 0.
>> gebruiktGeheugen3 := 0.
>> gebruiktGeheugen4 := 0.

Programma geheugenbeheer: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Uit schrijf: txt kopieer html, stop.
Uit schrijf: txt kopieer kleine-letters, stop.
Uit schrijf: txt kopieer hoofdletters, stop.
} start.

Programma vegen.

gebruiktGeheugen1 := (Programma geheugen ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Uit schrijf: txt kopieer html, stop.
Uit schrijf: txt kopieer kleine-letters, stop.
Uit schrijf: txt kopieer hoofdletters, stop.
} start.

Programma vegen.
gebruiktGeheugen2 := (Programma geheugen ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Uit schrijf: txt kopieer html, stop.
Uit schrijf: txt kopieer kleine-letters, stop.
Uit schrijf: txt kopieer hoofdletters, stop.
} start.

Programma vegen.
gebruiktGeheugen3 := (Programma geheugen ? 0).



( gebruiktGeheugen1 = gebruiktGeheugen2 en: gebruiktGeheugen1 = gebruiktGeheugen3, en: gebruiktGeheugen2 = gebruiktGeheugen3 ) ja: {
	Uit schrijf: ['Hier geen geheugenlekken'].
}, nee: {
	Uit schrijf: ['Geheugen lekt...'].
}.
