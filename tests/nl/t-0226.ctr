# Test ASCII variants

# Numbers

Uit schrijf: (2 !=: 3), stop.
Uit schrijf: (2 <=: 2), stop.
Uit schrijf: (2 >=: 2), stop.

# Strings

Uit schrijf: (['b'] >=: ['a']), stop.
Uit schrijf: (['b'] !=: ['a']), stop.
Uit schrijf: (['b'] <=: ['c']), stop.

# Bools

Uit schrijf: (Ja !=: Nee), stop.

# Objects

Uit schrijf: (Object nieuw !=: Object nieuw), stop.

# ASCII list symbol <-:

Uit schrijf: (Reeks <<: 1, ; 2 ; 3) aantal = 3, stop.

