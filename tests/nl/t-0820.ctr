# een groep die geen deel is van de overeenkomst mag niet crashen en moet de groepnummers behouden
Server init.
>> toon := { :patroon :subject
	>> p := Patroon nieuw: patroon.
	p overeenkomst: subject doen: { :m :g
		Uit schrijf: g aantal, schrijf: [' '], schrijf: (g samenvoegen: ['|']), stop.
		<- m.
	}.
}.
toon toepassen: ['(a)|(b)'] en: ['b'].
toon toepassen: ['(a)|(b)'] en: ['a'].
toon toepassen: ['(x)?y'] en: ['y'].
toon toepassen: ['(x)?(y)(z)?'] en: ['xy'].
