# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Patroon nieuw: pattern.
	p overeenkomst: subject doen: { :m :g
		Uit schrijf: g aantal, schrijf: [' '], schrijf: (g samenvoegen: ['|']), stop. <- m.
	}.
}.
show toepassen: ['(a)|(b)'] en: ['b'].
show toepassen: ['(a)|(b)'] en: ['a'].
show toepassen: ['(x)?y'] en: ['y'].
show toepassen: ['(x)?(y)(z)?'] en: ['xy'].
