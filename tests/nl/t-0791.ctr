Server init.

>> DB := Maria-DB nieuw host: ['localhost'],
	gebruikersnaam: ['xo'],
	wachtwoord: ['pass123'],
	databanknaam: ['xobase'],
	verbinden.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> zoekparameters := Maria-Query nieuw: SQL.

# set database
zoekparameters databank: DB.

zoekparameters ophalen: { :row
	Uit schrijf: row world, stop.
}.
