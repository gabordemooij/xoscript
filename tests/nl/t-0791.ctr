Server init.

>> DB := Maria-DB nieuw host: ['localhost'],
	gebruikersnaam: ['xo'],
	wachtwoord: ['pass123'],
	databanknaam: ['xobase'],
	verbinden.
	
>> SQL := ['SELECT "hello" AS "world" '].

# query handmatig aanmaken
>> zoekparameters := Maria-Query nieuw: SQL.

# databank instellen
zoekparameters databank: DB.

zoekparameters ophalen: { :rij
	Uit schrijf: rij world, stop.
}.
