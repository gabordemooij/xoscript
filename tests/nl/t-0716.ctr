Uit schrijf: ['Test object'], stop.
>> a := Object nieuw. 

a bij: ['state:'] doen: { :list
	eigen list := list. 
}.

a bij: ['state'] doen: {
	Uit schrijf: eigen list, stop.
}.

a state: ( Reeks nieuw ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
Uit schrijf: ['========== RELOADING SNAP:'], stop.
>> b := Object load-from: ['/tmp/a.bin'].
b state.