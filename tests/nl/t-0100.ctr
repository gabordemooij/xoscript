		zelf
		vervang: ['&'] door: ['&amp;'],
		vervang: ['<'] door: ['&lt;'],
		vervang: ['>'] door: ['&gt;'],
		vervang: ['"'] door: ['&quot;']
	).
}.

>> list := Reeks nieuw.

['Verbatim Syntax'] letters elk: { :getal :letter
	list ; ((['<li>#Number:Letter</li>']) Number: (getal), Letter: letter).
}.

Uit list.





