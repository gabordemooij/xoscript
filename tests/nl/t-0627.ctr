

# maak een 64-bits geheel getal voor exacte berekeningen
>> a := Int64 van-string: ['123'].

# naar tekst
Uit schrijf: a, stop.

# delen
Uit schrijf: a / (Int64 van-string: ['3']), stop.

# vermenigvuldigen
Uit schrijf: a * (Int64 van-string: ['2']), stop.

# optellen
Uit schrijf: a + (Int64 van-string: ['1']), stop.

# aftrekken
Uit schrijf: a - (Int64 van-string: ['2']), stop.

# vergelijken
Uit schrijf: ( a =   (Int64 van-string: ['123'])), stop.
Uit schrijf: ( a !=: (Int64 van-string: ['124'])), stop.
Uit schrijf: ( a <   (Int64 van-string: ['124'])), stop.
Uit schrijf: ( a >   (Int64 van-string: ['122'])), stop.
Uit schrijf: ( a >=: (Int64 van-string: ['123'])), stop.
Uit schrijf: ( a <=: (Int64 van-string: ['123'])), stop.





	