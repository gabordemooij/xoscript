

>> g  := Server nieuw.
>> v  := Kluis nieuw.
>> ok := 0.

>> geheimen := Reeks nieuw ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> wachtwoorden := geheimen kopieer.
wachtwoorden elk: { :i :p
	geheimen elk: { :n :s
		{
			>> versleuteld := v versleutel: s sleutel: p.
			>> ontsleuteld := v ontsleutel: versleuteld sleutel: p.
			(ontsleuteld = s) ja: {
				ok optellen: 1.
			}, anders: {
				Uit schrijf: ['versleutelen/ontsleutelen mislukt: '], stop.
				Uit schrijf: s, stop.
				Uit schrijf: ['versleuteld: '] + versleuteld, stop.
				Uit schrijf: ['ontsleuteld: '] + versleuteld, stop.
				Programma einde.
			}.
		} afhandelen: { :ft
			(s = [''] of: p = ['']) ja: {
				ok optellen: 1.
			}, anders: {
				Uit schrijf: ft, stop.
				Programma einde.
			}.
		}, start.
	}.
}.

Uit schrijf: ( ok + [' kluisversleutelingen getest.'] ), stop.