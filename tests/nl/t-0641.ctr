# Test utf8-opschoner
Server init.

>> utf8gevallen := Lijst nieuw
	# alleen ASCII
	zet: ( Reeks nieuw ; 65 ; 65 ; 65 ; 65 ; 0 ) bij: ['AAAA'],
	# geldige reeks van 2 bytes
	zet: ( Reeks nieuw ; 194 ; 162 ; 0 ) bij: ['¢'],
	# Geldige 3-byte UTF-8
    zet: ( Reeks nieuw ; 226 ; 130 ; 172 ; 0 ) bij: ['€'],
	# Geldige 4-byte UTF-8
    zet: ( Reeks nieuw ; 240 ; 144 ; 141 ; 136 ; 0 ) bij: ['𐍈'],
	# Ongeldige vervolgbyte in reeks E2 28 AC -> start 3b-reeks + 28 fout vervolg + AC vervolgbyte, maar hoort bij dezelfde fout
    zet: ( Reeks nieuw ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) bij: ['A?A'],
	# Te lange codering van ASCII 'A' (moet ? worden),
    zet: ( Reeks nieuw ; 65 ; 193 ; 129 ; 0 ) bij: ['A?'],
	# Ongeldige eerste byte (0xFF)
    zet: ( Reeks nieuw ; 255 ; 0 ) bij: ['?'],
	# Onvolledige multibytereeks aan het einde
    zet: ( Reeks nieuw ; 66 ; 226 ; 0 ) bij: ['B?'],
    # Lege tekst
    #put: ( List new ) at: [''],
	# Meerdere gemengde reeksen
    zet: ( Reeks nieuw ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) bij: ['A€?𐍈B'].
	 
utf8gevallen elk: { :key :value
	>> blob := Blob nieuw: value aantal, bytes: value.
	>> str := blob tekst.
	(str = key) ja: {
		Uit schrijf: ['OK'], stop.
	}, anders: {
		Uit schrijf: ['UTF8-opschoner faalde op: '] + key + [' kreeg: '] + str, stop.
	}.
	blob vrij.
}.
