{
	deze-taak fout: ['Niet falen.'].
	onbekend doeIets.
} afhandelen: {
	Uit schrijf: ['Gevangen!'].
}, start.

{
	deze-taak fout: ['Niet falen.'].
	eigen onbekend doeIets.
} afhandelen: {
	Uit schrijf: ['Gevangen!'].
}, start.

{
	deze-taak fout: ['Niet falen.'].
	onbekend := 122.
} afhandelen: {
	Uit schrijf: ['Gevangen!'].
}, start.


{
	deze-taak fout: ['Niet falen.'].
	Ja afbreken.
	Uit schrijf: ['FOUT'].
} afhandelen: {
	Uit schrijf: ['Gevangen!'].
}, start.

{
	{
		deze-taak fout: ['Niet falen.'].
		Ja afbreken.
		Uit schrijf: ['FOUT'].
	} afhandelen: { :x
		(x = ['Niet falen.']) ja: { deze-taak fout: ['Genest Gevangen!']. }.
	}, start.
} afhandelen: { :e
	Uit schrijf: e.
}, start.
