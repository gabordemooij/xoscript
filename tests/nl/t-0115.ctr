{
	deze-taak fout: ['Dont fail.'].
	unknown doSomething.
} afhandelen: {
	Uit schrijf: ['Caught!'].
}, start.

{
	deze-taak fout: ['Dont fail.'].
	eigen unknown doSomething.
} afhandelen: {
	Uit schrijf: ['Caught!'].
}, start.

{
	deze-taak fout: ['Dont fail.'].
	unknown := 122.
} afhandelen: {
	Uit schrijf: ['Caught!'].
}, start.


{
	deze-taak fout: ['Dont fail.'].
	Ja afbreken.
	Uit schrijf: ['FAIL'].
} afhandelen: {
	Uit schrijf: ['Caught!'].
}, start.

{
	{
		deze-taak fout: ['Dont fail.'].
		Ja afbreken.
		Uit schrijf: ['FAIL'].
	} afhandelen: { :x
		(x = ['Dont fail.']) ja: { deze-taak fout: ['Nested Caught!']. }.
	}, start.
} afhandelen: { :e
	Uit schrijf: e.
}, start.
