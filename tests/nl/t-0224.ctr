
>> landen := Reeks nieuw
	~ ['Zwitserland']
	~ ['Italië']
	~ ['Duitsland'].

>> etenswaren := Reeks nieuw
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Zuurkool'].


>> teller := 0.
etenswaren per: landen, elk: { :key :value
	teller optellen: 1.
}.

Uit schrijf: (['we serve counter dishes'] counter: teller), stop.

>> teller := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] letters sorteren: { :v
	teller optellen: 0.
}.

Uit schrijf: (['we sort counter dishes'] counter: teller), stop.


>> teller := 0.
{
	{
		teller optellen: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Uit schrijf: (['we calculate counter numbers.'] counter: teller), stop.

