
>> countries := Reeks nieuw
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Reeks nieuw
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods per: countries, elk: { :key :value
	counter optellen: 1.
}.

Uit schrijf: (['we serve counter dishes'] counter: counter), stop.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] letters sorteren: { :v
	counter optellen: 0.
}.

Uit schrijf: (['we sort counter dishes'] counter: counter), stop.


>> counter := 0.
{
	{
		counter optellen: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Uit schrijf: (['we calculate counter numbers.'] counter: counter), stop.

