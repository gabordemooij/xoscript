>> a := Reeks ← Object ; Ja ; Nee ; Boolean ; 1 ; Getal ; ['Str'] ; Tekst ; { ['Empty']. }.
Uit schrijf: (a aantal), stop.
{ :i
	Uit schrijf: 
	['a '] + 
	((a ? i) type) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Niets?) of: [''] of: ['NOT']) + 
	[' Nil.'],
	stop.
} × (a aantal).
Uit schrijf: ['but.. Nil is.. '] + ((Niets Niets?) of: ['certainly NIL!'] of: ['not NIL??']), stop.