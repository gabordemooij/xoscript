>> V := Object.
V bij: ['tekst'] doen: {
	Uit schrijf: ['cast'], stop.
	<- ['abc'].
}.

Uit schrijf: ( Programma instelling: ['abc'] ), stop.

# parameters mogen niet door GC opgeruimd worden
Programma instelling: ([''] + V nieuw) is: ([''] + V nieuw).

Uit schrijf: ( Programma instelling: ['abc'] ), stop.
