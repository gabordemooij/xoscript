


>> gebruiktGeheugen1 := 0.
>> gebruiktGeheugen2 := 0.
>> gebruiktGeheugen3 := 0.
>> gebruiktGeheugen4 := 0.

Programma geheugenbeheer: 0.
>> palet := Niets.
>> kleuren := Niets.

{
palet := Lijst nieuw.
palet 
	zet: ['#F00'] bij: ['rood'],
	zet: ['#0F0'] bij: ['groen'],
	zet: ['#00F'] bij: ['blauw'].
Uit schrijf: ['aantal RGB-codes in palet: '] + ( palet aantal ), stop.
Uit schrijf: ['RGB-code van groen is: '] + ( palet ? ['groen'] ), stop.
kleuren := [''].
( palet elk: { :naam :code
		kleuren := kleuren + ( naam + [':'] + code ).
} ).
Uit schrijf: ['Alle kleuren in palet: '] + kleuren, stop.
} start.
Programma vegen.
gebruiktGeheugen1 := (Programma geheugen ? 0).

