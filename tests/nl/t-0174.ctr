>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programma geheugenbeheer: 0.
>> palette := Niets.
>> colors := Niets.

{
palette := Lijst nieuw.
palette 
	zet: ['#F00'] bij: ['red'],
	zet: ['#0F0'] bij: ['green'],
	zet: ['#00F'] bij: ['blue'].
Uit schrijf: ['number of RGB codes in palette: '] + ( palette aantal ), stop.
Uit schrijf: ['RGB code of green is: '] + ( palette ? ['green'] ), stop.
colors := [''].
( palette elk: { :naam :code
		colors := colors + ( naam + [':'] + code ).
} ).
Uit schrijf: ['All colors in palette: '] + colors, stop.
} start.
Programma vegen.
usedMemory1 := (Programma geheugen ? 0).

