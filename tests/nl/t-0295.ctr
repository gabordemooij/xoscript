
>> dictionary := (
	Lijst nieuw
		zet: ['b'] bij: ['a'],
		zet: ['a'] bij: ['b'],
		zet: ['z'] bij: ['x'],
		zet: ['hello'] bij: ['hallo'],
		zet: ['human'] bij: ['human']
).

>> comparisons := Reeks nieuw.
dictionary elk: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a vergelijk: b)
	).
}.

comparisons sorteren: { :a :b <- ( a vergelijk: b ). }.
Uit schrijf: ( comparisons samenvoegen: ['↵'] ), stop.
comparisons samenvoegen: ['↵'].
