
>> woordenboek := (
	Lijst nieuw
		zet: ['b'] bij: ['a'],
		zet: ['a'] bij: ['b'],
		zet: ['z'] bij: ['x'],
		zet: ['hello'] bij: ['hallo'],
		zet: ['mens'] bij: ['mens']
).

>> vergelijkingen := Reeks nieuw.
woordenboek elk: { :a :b
	vergelijkingen ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a vergelijk: b)
	).
}.

vergelijkingen sorteren: { :a :b <- ( a vergelijk: b ). }.
Uit schrijf: ( vergelijkingen samenvoegen: ['↵'] ), stop.
vergelijkingen samenvoegen: ['↵'].
