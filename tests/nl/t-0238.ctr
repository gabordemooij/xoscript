Tekst bij: ['evaluate'] doen: {
	>> code := Bestand nieuw: ['/tmp/eval.ctr'].
	code schrijf: (zelf tekst + ['.']).
	Programma gebruik: ['/tmp/eval.ctr'].
}.

>> a := Reeks ← 1 ; 2 ; 3.
>> b := (a tekst).

Uit schrijf: b, stop. 
(['b := '] + b) evaluate.

Uit schrijf: b ? 2, stop. 

Uit schrijf: (( Reeks ← 1 ; 2 ; 3 )), stop. 

Uit schrijf: ((Lijst nieuw) zet: 1 bij: 2), stop. 

>> x := ( (Reeks ← 1 ; ( Reeks ← 9 ) ; Ja ) ) tekst.
Uit schrijf: x, stop. 
(['x := '] + x) evaluate.

Uit schrijf: x ? 1 ? 0, stop. 

>> y := (Lijst nieuw) zet: (Reeks ← 1) bij: (Reeks ← 2).
Uit schrijf: y, stop. 

(['y := '] + y) tekst evaluate.

Uit schrijf: (y bij: (Reeks ← 2) tekst ), stop.

Uit schrijf: (Reeks nieuw), stop. 
Uit schrijf: (Lijst nieuw), stop. 
