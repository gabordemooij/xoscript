

>> obj := Object nieuw.

obj bij: ['groet'] doen: {
	<- ['hoi'].
}.

# moet hi123hi123ok uitvoeren
obj bij: ['taak'] doen: {
	eigen eigenschap := 123.
	{
		# probeer bindt zelf/eigen aan het object in plaats van aan het blok
		Uit schrijf: zelf groet.
		Uit schrijf: eigen eigenschap.
		1 / 0.
	} afhandelen: {
		Uit schrijf: zelf groet.
		Uit schrijf: eigen eigenschap.
		Uit schrijf: ['ok'].
	}, probeer.
}.

obj taak.