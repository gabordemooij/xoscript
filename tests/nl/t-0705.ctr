

>> obj := Object nieuw.

obj bij: ['greet'] doen: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj bij: ['task'] doen: {
	eigen property := 123.
	{
		# try binds self/own to object instead of block
		Uit schrijf: zelf greet.
		Uit schrijf: eigen property.
		1 / 0.
	} afhandelen: {
		Uit schrijf: zelf greet.
		Uit schrijf: eigen property.
		Uit schrijf: ['ok'].
	}, probeer.
}.

obj task.