>> str := ['write:'].
Uit bericht: ['schrijf:'] argumenten: (Reeks ← ['Hello World']), stop. 

Getal bij: ['isbetween:and:'] doen: { :a :b <- ((zelf ≥ a) en: (zelf ≤ b)).
}.

str := ['isbetween:and:'].
Uit schrijf: (3 bericht: str argumenten: (Reeks ← 2 ; 8)), stop.
Uit schrijf: (3 bericht: str argumenten: (Reeks ← 1 ; 2)), stop.


>> CoffeeMachine := Object nieuw.
CoffeeMachine bij: ['makeCoffeeWithSugar:milk:'] doen: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Reeks ← 4 ; 2.
Uit schrijf: ( CoffeeMachine bericht: order argumenten: coffeeConfiguration ), stop.
