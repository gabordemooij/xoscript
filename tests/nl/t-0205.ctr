>> str := ['write:'].
Uit bericht: ['schrijf:'] argumenten: (Reeks ← ['Hello World']), stop. 

Getal bij: ['isbetween:and:'] doen: { :a :b <- ((zelf ≥ a) en: (zelf ≤ b)).
}.

str := ['isbetween:and:'].
Uit schrijf: (3 bericht: str argumenten: (Reeks ← 2 ; 8)), stop.
Uit schrijf: (3 bericht: str argumenten: (Reeks ← 1 ; 2)), stop.


>> Koffiemachine := Object nieuw.
Koffiemachine bij: ['makeCoffeeWithSugar:milk:'] doen: { :sugar :milk <- ( ['Alsjeblieft... koffie met '] + 
			sugar +
			[' lepels suiker en '] +
			milk +
			[' druppels melk.']
	).
}.

>> bestelling := ['makeCoffeeWithSugar:milk:'].
>> koffieConfiguratie := Reeks ← 4 ; 2.
Uit schrijf: ( Koffiemachine bericht: bestelling argumenten: koffieConfiguratie ), stop.
