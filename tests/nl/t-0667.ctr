# test Program version

# this feature is disabled by default
Uit schrijf: (
	Programma functionaliteit: 
	['RECURSIVE_STRINTPOL']
), stop.


# but if we set the time back
>> today := Moment 
zone: ['CEST'],
van: ['2026-02-15 10:00:00'].
Programma versie: today.

# it will be enabled like it used to be (from now on)
Uit schrijf: (
	Programma functionaliteit: 
	['RECURSIVE_STRINTPOL']
), stop.