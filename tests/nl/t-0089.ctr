>> toevalsgenerator := { :a :b
	>> minimum := ( a < b ) of: a of: b.
	>> maximum := ( a > b ) of: a of: b.
	>> x := Niets.
	{
		x := Getal tussen: a en: b.
		((x < minimum) of: (x > maximum)) ja: { 
			Uit schrijf: (['Ongeldige waarde!']).
			Programma einde.
		}.
	} 
	× 100. <- x.
}.
toevalsgenerator toepassen: 0 en: 0.
toevalsgenerator toepassen: 1 en: 0.
toevalsgenerator toepassen: 1 en: 1.
toevalsgenerator toepassen: 0 en: 1.
toevalsgenerator toepassen: -1 en: 0.
