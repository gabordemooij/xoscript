>> randomizer := { :a :b
	>> minimum := ( a < b ) of: a of: b.
	>> maximum := ( a > b ) of: a of: b.
	>> x := Niets.
	{
		x := Getal tussen: a en: b.
		((x < minimum) of: (x > maximum)) ja: { 
			Uit schrijf: (['Invalid value!']).
			Programma einde.
		}.
	} 
	× 100. <- x.
}.
randomizer toepassen: 0 en: 0.
randomizer toepassen: 1 en: 0.
randomizer toepassen: 1 en: 1.
randomizer toepassen: 0 en: 1.
randomizer toepassen: -1 en: 0.
randomizer toepassen: -1 en: -1.
randomizer toepassen: 0 en: -1.
randomizer toepassen: 100 en: 200.
randomizer toepassen: 999999999999998 en: 999999999999999.
randomizer toepassen: 999999999999999 en: 999999999999998.
randomizer toepassen: 999999999999999 en: 999999999999999.
randomizer toepassen: -999999999999998 en: -999999999999999.
randomizer toepassen: -999999999999999 en: -999999999999998.
randomizer toepassen: -999999999999999 en: -999999999999999.
