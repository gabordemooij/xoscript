# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Kluis crypto-sleutels.

# private (secret) key
>> sk := keys eerste.

# public key
>> pk := keys laatste.

# sign a message
>> sig := Kluis onderteken: ['abc'] met: sk.

# check message (ok)
Uit schrijf: ( 
	Kluis
		controleer: ['abc'] 
		ondertekening: sig 
		met: pk 
), stop.

# check message (fail)
Uit schrijf: ( 
	Kluis 
		controleer: ['abd'] 
		ondertekening: sig 
		met: pk 
), stop.