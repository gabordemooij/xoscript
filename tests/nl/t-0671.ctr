# publieke sleutel (om API's enz. te beveiligen)
Server init.

# sleutels genereren
>> sleutels := Kluis crypto-sleutels.

# privésleutel (geheim)
>> gs := sleutels eerste.

# publieke sleutel
>> ps := sleutels laatste.

# onderteken een bericht
>> handt := Kluis onderteken: ['abc'] met: gs.

# controleer bericht (ok)
Uit schrijf: ( 
	Kluis
		controleer: ['abc'] 
		ondertekening: handt 
		met: ps 
), stop.

# controleer bericht (mislukt)
Uit schrijf: ( 
	Kluis 
		controleer: ['abd'] 
		ondertekening: handt 
		met: ps 
), stop.