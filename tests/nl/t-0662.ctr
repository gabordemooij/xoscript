>> t := Niets.

# je kunt de tijdzone bepalen voor
# het ontleden, zo:
Moment zone: ['CET'].
t := Moment van: ['1981-02-03 04:05:06'].
Uit schrijf: t, stop.

# nu met tijdzone CEST:
Moment zone: ['CEST'].
t := Moment van: ['1981-02-03 04:05:06'].
Uit schrijf: t, stop.

# fout als de tekst niet ontleed kan worden
{ Moment van: ['1900']. } afhandelen: { Niets. }, start.
