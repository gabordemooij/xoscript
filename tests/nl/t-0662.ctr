>> t := Niets.

# you can control the time zone for
# parsing like this:
Moment zone: ['CET'].
t := Moment van: ['1981-02-03 04:05:06'].
Uit schrijf: t, stop.

# now using CEST time zone:
Moment zone: ['CEST'].
t := Moment van: ['1981-02-03 04:05:06'].
Uit schrijf: t, stop.

# error if string cannot be parsed
{ Moment van: ['1900']. } afhandelen: { Niets. }, start.
