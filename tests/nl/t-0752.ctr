Uit schrijf: ['Test object'], stop.
>> a := Object nieuw. 

a bij: ['item:'] doen: { :bool
	eigen bool := bool. 
}.

a bij: ['item'] doen: { <- eigen bool.
}.

a item: Boolean.

Uit schrijf: a item, stop.

>> old-bool-address := a item prototype geheugenadres.
a save-as: ['/tmp/a.bin'].
Uit schrijf: ['========== RELOADING SNAP:'], stop.

>> b := Object load-from: ['/tmp/a.bin'].

(b item prototype geheugenadres = old-bool-address) ja: {
	Uit schrijf: ['Object link re-attached.'], stop.
}.

Uit schrijf: b item, stop.
