# edge cases from a request must give an error or a result, not a crash
Server init.

Uit schrijf: ['<'] + (['abc'] van: 0 lengte: 0, hoofdletters) + ['>'], stop.
Uit schrijf: ['<'] + (['abc'] van: 0 lengte: 0, kleine-letters) + ['>'], stop.
Uit schrijf: ['<'] + (['abc'] overslaan: 3, hoofdletters) + ['>'], stop.
Uit schrijf: [''] hoofdletters bytes, stop.
Uit schrijf: ['aB'] hoofdletters, stop.
Uit schrijf: ['aB'] kleine-letters, stop.

Uit schrijf: (Moment nieuw: 0) jaar, stop.
{ Moment nieuw: ['9e300'] getal. } afhandelen: { :e Uit schrijf: e, stop. }, start.
{ Moment nieuw: ['-9e300'] getal. } afhandelen: { :e Uit schrijf: e, stop. }, start.
{ Moment nieuw: ['nan'] getal. } afhandelen: { :e Uit schrijf: e, stop. }, start.
{ Moment nieuw: 9000000000000000000. } afhandelen: { :e Uit schrijf: e, stop. }, start.
