#Linux
>> OS := Programma instelling: ['OS'].

>> clock := Moment nieuw.
	
(OS = ['Haiku']) ja: {
	clock zone: ['CET'],
	jaar: 2017, maand: 7, dag: 13,
	uur: 18, minuut: 0, seconde: 0.
}, anders: {
	clock zone: ['Europe/Amsterdam'],
	jaar: 2017, maand: 7, dag: 13,
	uur: 18, minuut: 0, seconde: 0.
}.

clock bij: ['tell'] doen: {
	Uit schrijf: zelf, stop.
}.


clock optellen: 2    uur, tell.
clock optellen: 1    uur, tell.
clock optellen: 19 minuut, tell.
clock optellen: 1  minuut, tell.
clock optellen: 1  minuut, tell.
clock optellen: 19 seconde, tell.
clock optellen: 1  seconde, tell.
clock optellen: 1  seconde, tell.
clock optellen: 2    jaar, tell.
clock optellen: 1    jaar, tell.

(OS = ['Haiku']) ja: {
clock optellen: 5   maand.
clock zone: ['CEST'], tell.
}, anders: {
	clock optellen: 5   maand, tell.
}.

clock optellen: 1   maand, tell.
clock optellen: 19    dag, tell.
clock optellen: 1    uur, tell.
clock optellen: 120  yard, tell.
