#Linux
>> OS := Programma instelling: ['OS'].

>> klok := Moment nieuw.
	
(OS = ['Haiku']) ja: {
	klok zone: ['CET'],
	jaar: 2017, maand: 7, dag: 13,
	uur: 18, minuut: 0, seconde: 0.
}, anders: {
	klok zone: ['Europe/Amsterdam'],
	jaar: 2017, maand: 7, dag: 13,
	uur: 18, minuut: 0, seconde: 0.
}.

klok bij: ['vertel'] doen: {
	Uit schrijf: zelf, stop.
}.


klok optellen: 2    uur, vertel.
klok optellen: 1    uur, vertel.
klok optellen: 19 minuut, vertel.
klok optellen: 1  minuut, vertel.
klok optellen: 1  minuut, vertel.
klok optellen: 19 seconde, vertel.
klok optellen: 1  seconde, vertel.
klok optellen: 1  seconde, vertel.
klok optellen: 2    jaar, vertel.
klok optellen: 1    jaar, vertel.

