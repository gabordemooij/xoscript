Server init.

លទ្ធផល សរសេរ: (
	លំនាំ ថ្មី: ['^\\w+$'],
	ផ្គូផ្គង: ['test@example.com'] 
), បន្ទាត់ថ្មី. # 0 match, fails on @ and .

លទ្ធផល សរសេរ: (
	លំនាំ ថ្មី: ['^[^@]+@[^\.]+\.\\w+$'],
	ផ្គូផ្គង: ['test@example.com'] 
), បន្ទាត់ថ្មី. # 1 match

លទ្ធផល សរសេរ: (
	លំនាំ ថ្មី: ['[^@]+@[^\.]+\.\\w+'],
	ផ្គូផ្គង: ['test@example.com'] 
), បន្ទាត់ថ្មី. # 1 match

លទ្ធផល សរសេរ: (
	លំនាំ ថ្មី: ['([^@]+)@([^\.]+)\.\\w+'],
	ផ្គូផ្គង: ['test@example.com'] 
), បន្ទាត់ថ្មី. # 1 match, groups dont matter

លទ្ធផល សរសេរ: (
	លំនាំ ថ្មី: ['[a-z]'],
	ផ្គូផ្គង: ['test@example.com'] 
), បន្ទាត់ថ្មី. # 14 matches

លទ្ធផល សរសេរ: (
	លំនាំ ថ្មី: ['.*'],
	ផ្គូផ្គង: ['test@example.com'] 
), បន្ទាត់ថ្មី. # 1 match (all)

លទ្ធផល សរសេរ: (
	លំនាំ ថ្មី: ['(.*)'],
	ផ្គូផ្គង: ['test@example.com'] 
), បន្ទាត់ថ្មី. # 1 match (all)

លទ្ធផល សរសេរ: (
	លំនាំ ថ្មី: ['\\s*[^@]+@[^\.]+\.\\w+'],
	ផ្គូផ្គង: ['test@example.com'] 
), បន្ទាត់ថ្មី. # 1 match, prefix space optional, gets ignored