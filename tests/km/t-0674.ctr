# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> ផ្លូវឯកសារ := ['/tmp/dat.csv'].
>> csv := ឯកសារ ថ្មី: ផ្លូវឯកសារ.
csv សរសេរ: s.

# accepts CRLF LF CR, varying row length
csv សញ្ញាខណ្ឌ: [';'] សញ្ញាសម្រង់: ['"'] បន្ទាត់: { :line
	កម្មវិធី សម្អាត.
	លទ្ធផល សរសេរ: line, បន្ទាត់ថ្មី.
	កម្មវិធី សម្អាត.
}.

# unequal lines
s បន្ថែមខាងចុង: ['\njustone'].
csv សរសេរ: s.
{
	csv សញ្ញាខណ្ឌ: [';'] សញ្ញាសម្រង់: ['"'] បន្ទាត់: { :line
		លទ្ធផល សរសេរ: line, បន្ទាត់ថ្មី.
	}.
} ចាប់: { :e 
	លទ្ធផល សរសេរ: e, បន្ទាត់ថ្មី.
}, ដំណើរការ.

# invalid format
s := ['"he"llo";world'].
csv សរសេរ: s.
{
	csv សញ្ញាខណ្ឌ: [';'] សញ្ញាសម្រង់: ['"'] បន្ទាត់: { :line
		លទ្ធផល សរសេរ: line, បន្ទាត់ថ្មី.
	}.
} ចាប់: { :e 
	លទ្ធផល សរសេរ: e, បន្ទាត់ថ្មី.
}, ដំណើរការ.
