# a format must fit the type of the value, the type can come from a client
>> ព្យាយាម := { :format :value
	{ លទ្ធផល សរសេរ: ( (ទម្រង់ ថ្មី: format) អនុវត្ត: value ), បន្ទាត់ថ្មី. } ចាប់: { :e លទ្ធផល សរសេរ: e, បន្ទាត់ថ្មី. }, ដំណើរការ.
}.
>> try-int := { :format :value
	{ លទ្ធផល សរសេរ: ( (ទម្រង់ ថ្មី: format) អនុវត្តចំនួនគត់: value ), បន្ទាត់ថ្មី. } ចាប់: { :e លទ្ធផល សរសេរ: e, បន្ទាត់ថ្មី. }, ដំណើរការ.
}.

# fits
ព្យាយាម អនុវត្ត: ['|%s|'] និង: ['text'].
ព្យាយាម អនុវត្ត: ['%06.2f'] និង: 5.5.
ព្យាយាម អនុវត្ត: ['100%% %s'] និង: ['sure'].
try-int អនុវត្ត: ['%03d'] និង: 7.
try-int អនុវត្ត: ['%x'] និង: 255.
ព្យាយាម អនុវត្ត: ['%d'] និង: (Int64 ថ្មី ពីអត្ថបទ: ['12']).
ព្យាយាម អនុវត្ត: ['%lld'] និង: (Int64 ថ្មី ពីអត្ថបទ: ['12']).
ព្យាយាម អនុវត្ត: ['%.1lf'] និង: 5.5.
try-int អនុវត្ត: ['%hd'] និង: 7.

# does not fit
ព្យាយាម អនុវត្ត: ['%s'] និង: 12345.
ព្យាយាម អនុវត្ត: ['%d'] និង: 12345.
ព្យាយាម អនុវត្ត: ['%f'] និង: ['text'].
try-int អនុវត្ត: ['%d'] និង: ['text'].
try-int អនុវត្ត: ['%s'] និង: 5.
ព្យាយាម អនុវត្ត: ['%s %s'] និង: ['text'].
ព្យាយាម អនុវត្ត: ['%n'] និង: ['text'].
ព្យាយាម អនុវត្ត: ['%*s'] និង: ['text'].
ព្យាយាម អនុវត្ត: ['%'] និង: ['text'].

# length modifier does not fit
ព្យាយាម អនុវត្ត: ['%ls'] និង: ['text'].
ព្យាយាម អនុវត្ត: ['%Lf'] និង: 5.5.
try-int អនុវត្ត: ['%ld'] និង: 7.
try-int អនុវត្ត: ['%lld'] និង: 7.
ព្យាយាម អនុវត្ត: ['%Ld'] និង: (Int64 ថ្មី ពីអត្ថបទ: ['12']).

# a width that does not fit printf must give an error, not a crash
ព្យាយាម អនុវត្ត: ['%99999999999s'] និង: ['text'].
