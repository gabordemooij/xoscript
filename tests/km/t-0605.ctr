>> invoice := វត្ថុ ថ្មី.
invoice ពេលទទួល: ['ដំណើរការ'] ធ្វើ: {
        ផ្ទាល់ ជាចំនួន := 0.
}.

invoice ពេលទទួល: ['ជាចំនួន'] ធ្វើ: {
        ផ្ទាល់ ជាចំនួន បូក: 1. <- ផ្ទាល់ ជាចំនួន ចម្លង.
}.

>> year-invoice := invoice ថ្មី.
year-invoice ពេលទទួល: ['start:'] ធ្វើ: { :ឆ្នាំ
	ផ្ទាល់ ជាចំនួន := ឆ្នាំ.
}.

year-invoice start: 202000.
លទ្ធផល សរសេរ: year-invoice ជាចំនួន, បន្ទាត់ថ្មី.
លទ្ធផល សរសេរ: year-invoice ជាចំនួន, បន្ទាត់ថ្មី.
