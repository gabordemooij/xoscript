Server init.

>> DB := Maria-DB ថ្មី ម៉ាស៊ីនបង្ហោះ: ['localhost'],
	ឈ្មោះអ្នកប្រើ: ['xo'],
	ពាក្យសម្ងាត់: ['pass123'],
	ឈ្មោះមូលដ្ឋានទិន្នន័យ: ['xobase'],
	ភ្ជាប់ទៅ.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> ប៉ារ៉ាម៉ែត្រស្វែងរក := Maria-សំណួរ ថ្មី: SQL.

# set database
ប៉ារ៉ាម៉ែត្រស្វែងរក មូលដ្ឋានទិន្នន័យ: DB.

ប៉ារ៉ាម៉ែត្រស្វែងរក ទាញយក: { :row
	លទ្ធផល សរសេរ: row world, បន្ទាត់ថ្មី.
}.
