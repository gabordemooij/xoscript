# a quote that never closes must give an error, not an endless loop
>> ផ្លូវឯកសារ := ['/tmp/test0821.csv'].
>> file := ឯកសារ ថ្មី: ផ្លូវឯកសារ.

file សរសេរ: ['a,b\n"1,2\n'].
{
	file សញ្ញាខណ្ឌ: [','] សញ្ញាសម្រង់: ['"'] បន្ទាត់: { :line
		លទ្ធផល សរសេរ: line, បន្ទាត់ថ្មី.
	}.
} ចាប់: { :e លទ្ធផល សរសេរ: e, បន្ទាត់ថ្មី. }, ដំណើរការ.

# a closed quote still works
file សរសេរ: ['a,b\n"1,2",3'].
file សញ្ញាខណ្ឌ: [','] សញ្ញាសម្រង់: ['"'] បន្ទាត់: { :line
	លទ្ធផល សរសេរ: line, បន្ទាត់ថ្មី.
}.
file លុប.
