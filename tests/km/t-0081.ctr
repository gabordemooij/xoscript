>> map1 := វចនានុក្រម ថ្មី.
>> key1 := ស៊េរី ថ្មី.
>> key2 := ស៊េរី ថ្មី.

map1
	ដាក់: ['hello'] សោ: key1,
	ដាក់: ['world'] សោ: key2.


លទ្ធផល
	សរសេរ: ['Map #1 contains: '] + (map1 នៅ: key1),
	សរសេរ: [' and '] + (map1 នៅ: key2), បន្ទាត់ថ្មី.

>> KeyeableArray := ស៊េរី ថ្មី.
KeyeableArray ពេលទទួល: ['toString'] ធ្វើ: { <- (ខ្លួន ចំនួនធាតុ) toString.
}.

>> map2 := វចនានុក្រម ថ្មី.
key1 := KeyeableArray ថ្មី.
key2 := KeyeableArray ថ្មី.

key1 បន្ថែមខាងចុង: 1.

map2
	ដាក់: ['hello'] សោ: key1,
	ដាក់: ['world'] សោ: key2.

លទ្ធផល
	សរសេរ: ['Map #2 contains: '] + (map2 នៅ: key1),
	សរសេរ: [' and '] + (map2 នៅ: key2), បន្ទាត់ថ្មី.
