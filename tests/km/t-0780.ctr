Server init.

# JSON encoder only supports UTF-8, no surrogate pairs

>> dicts := ស៊េរី ថ្មី ;
	# {"key":"normal"} normal ASCII
	( វចនានុក្រម ថ្មី ដាក់: ['normal'] សោ: ['key'] ) ;
	# {"key":"hello world"} space character
	( វចនានុក្រម ថ្មី ដាក់: ['hello world'] សោ: ['key'] ) ;
	# {"key":"quote: \""} double quote
	( វចនានុក្រម ថ្មី ដាក់: ['"'] សោ: ['key'] ) ;
	# {"key":"backslash: \\"} backslash
	( វចនានុក្រម ថ្មី ដាក់: ['backslash: \\'] សោ: ['key'] ) ;
	# {"key":"slash: /"} slash
	( វចនានុក្រម ថ្មី ដាក់: ['slash: /'] សោ: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( វចនានុក្រម ថ្មី ដាក់: ['backspace: \b'] សោ: ['key'] ) ;
	# {"key":"formfeed: \f"} form-feed escape
	( វចនានុក្រម ថ្មី ដាក់: ['formfeed: \f'] សោ: ['key'] ) ;
	# {"key":"newline: \n"} newline
	( វចនានុក្រម ថ្មី ដាក់: ['newline: \n'] សោ: ['key'] ) ;
	( វចនានុក្រម ថ្មី ដាក់: ['newline: ↵'] សោ: ['key'] ) ;
	( វចនានុក្រម ថ្មី ដាក់: ['newline: 
	'] សោ: ['key'] ) ;
	# {"key":"carriage return: \r"} carriage-return
	( វចនានុក្រម ថ្មី ដាក់: ['carriage return: \r'] សោ: ['key'] ) ;
	# {"key":"tab: \t"} tab
	( វចនានុក្រម ថ្មី ដាក់: ['tab \t'] សោ: ['key'] ) ;
	( វចនានុក្រម ថ្មី ដាក់: ['tab ⇿'] សោ: ['key'] ) ;
	( វចនានុក្រម ថ្មី ដាក់: ['tab  '] សោ: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( វចនានុក្រម ថ្មី ដាក់: ['NUL \u0000'] សោ: ['key'] ) ;
	( វចនានុក្រម ថ្មី ដាក់: ['NUL \0'] សោ: ['key'] ) ;
	# {"key":"control: \u0001"} control character 0x01
	( វចនានុក្រម ថ្មី ដាក់: ['control: \u0001'] សោ: ['key'] ) ;
	# {"key":"control: \u001F"} control character 0x1F
	( វចនានុក្រម ថ្មី ដាក់: ['control: \u001F'] សោ: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-byte char
	( វចនានុក្រម ថ្មី ដាក់: ['unicode: é'] សោ: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-byte char
	( វចនានុក្រម ថ្មី ដាក់: ['unicode: €'] សោ: ['key'] ) ;
	# {"key":"unicode: 日本語"} multiple 3-byte UTF-8 chars
	( វចនានុក្រម ថ្មី ដាក់: ['unicode: 日本語'] សោ: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-byte char
	( វចនានុក្រម ថ្មី ដាក់: ['unicode: 😀'] សោ: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	( វចនានុក្រម ថ្មី ដាក់: ['unicode: 🧑‍💻'] សោ: ['key'] ) ;
	# {"key":"combining: e\u0301"} combining accent
	( វចនានុក្រម ថ្មី ដាក់: ['combining: e\u0301'] សោ: ['key'] ) ;
	# {"key":"escaped unicode: \u00e9"} Unicode escape BMP
	( វចនានុក្រម ថ្មី ដាក់: ['escaped unicode: \u00e9'] សោ: ['key'] ) ;
	# {"key":"escaped unicode: \u20ac"} Unicode escape BMP
	( វចនានុក្រម ថ្មី ដាក់: ['escaped unicode: \u20ac'] សោ: ['key'] ) ;
	# {"key":"escaped unicode: \ud83d\ude00"} UTF-16 surrogate pair
	( វចនានុក្រម ថ្មី ដាក់: ['escaped unicode: \ud83d\ude00'] សោ: ['key'] ) ;
	# {"key":""} empty value
	( វចនានុក្រម ថ្មី ដាក់: [''] សោ: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} special ASCII chars
	( វចនានុក្រម ថ្មី ដាក់: ['@ < > & = % + ? #'] សោ: ['key'] ) ;
	# {"key":"single quote: '"} single quote
	( វចនានុក្រម ថ្មី ដាក់: ['''] សោ: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} multiple JSON escapes
	( វចនានុក្រម ថ្មី ដាក់: ['multiple: \" \\ \n \r \t'] សោ: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} longer ASCII-string
	( វចនានុក្រម ថ្មី ដាក់: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] សោ: ['key'] ) ;
	# {"key":" value"} leading space
	( វចនានុក្រម ថ្មី ដាក់: [' value'] សោ: ['key'] ) ;
	# {"key":"value "} trailing space
	( វចនានុក្រម ថ្មី ដាក់: ['value '] សោ: ['key'] ) ;
	# {"key":" \t\n\r "} whitespace
	( វចនានុក្រម ថ្មី ដាក់: [' \t\n\r '] សោ: ['key'] ).

dicts នីមួយៗ: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (វចនានុក្រម ថ្មី ដាក់: d key សោ: ['key']).
	>> b := JSON jsonify: (វចនានុក្រម ថ្មី ដាក់: ['value'] សោ: d key).
	>> e := JSON វត្ថុ: a.
	>> f := JSON វត្ថុ: b.
	((e key = d key និង: (f ? d key = ['value'])) ឬ: (e key = ['NUL ?'])) បើពិត: {
		លទ្ធផល សរសេរ: ['OK'], បន្ទាត់ថ្មី.
	}, បើមិនដូច្នោះ: {
		លទ្ធផល សរសេរ: ['Unable to properly encode/decode: '] + d + j, បន្ទាត់ថ្មី.
		កម្មវិធី បញ្ចប់.
	}.
}.
