
>> countries := ស៊េរី ថ្មី
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := ស៊េរី ថ្មី
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods តាម: countries, នីមួយៗ: { :key :value
	counter បូក: 1.
}.

លទ្ធផល សរសេរ: (['we serve counter dishes'] counter: counter), បន្ទាត់ថ្មី.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] តួអក្សរទាំងអស់ តម្រៀប: { :v
	counter បូក: 0.
}.

លទ្ធផល សរសេរ: (['we sort counter dishes'] counter: counter), បន្ទាត់ថ្មី.


>> counter := 0.
{
	{
		counter បូក: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


លទ្ធផល សរសេរ: (['we calculate counter numbers.'] counter: counter), បន្ទាត់ថ្មី.

