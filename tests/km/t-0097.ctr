
អត្ថបទ ពេលទទួល: ['html'] ធ្វើ: { <- (
		ខ្លួន
		ជំនួស: ['&'] ដោយ: ['&amp;'],
		ជំនួស: ['<'] ដោយ: ['&lt;'],
		ជំនួស: ['>'] ដោយ: ['&gt;'],
		ជំនួស: ['"'] ដោយ: ['&quot;']
	).
}.

>> HtmlBrush := វត្ថុ ថ្មី.

HtmlBrush ពេលទទួល: ['ឆ្លើយតប:'] ធ្វើ: { :tag
	លទ្ធផល សរសេរ: (['<tag>↵'] tag: tag ).
}.

HtmlBrush ពេលទទួល: ['ឆ្លើយតប:និង:'] ធ្វើ: { :tag :content
	tag := ( tag ចាប់ពី: 0 ប្រវែង: (tag ប្រវែង - 1) ).
	លទ្ធផល សរសេរ: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush ពេលទទួល: ['content:'] ធ្វើ: { :text
	លទ្ធផល សរសេរ: text html, បន្ទាត់ថ្មី.
}.

HtmlBrush ពេលទទួល: ['attr:value:'] ធ្វើ: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush ថ្មី.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
