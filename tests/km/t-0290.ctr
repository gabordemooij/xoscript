# test list operations


>> cakes := ស៊េរី ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes ជំនួស: 1 ប្រវែង: 2 ដោយ: ( ស៊េរី ← ['cinnamon'] ; ['pineapple'] ).
លទ្ធផល សរសេរ: (buy ភ្ជាប់: [',']), បន្ទាត់ថ្មី.


>> buy := cakes ជំនួស: 1 ប្រវែង: 12 ដោយ: ( ស៊េរី ← ['cinnamon'] ; ['pineapple'] ).
លទ្ធផល សរសេរ: (buy ភ្ជាប់: [',']), បន្ទាត់ថ្មី.


>> buy := cakes ជំនួស: 2 ប្រវែង: 10 ដោយ: ( ស៊េរី ថ្មី ).
លទ្ធផល សរសេរ: (buy ភ្ជាប់: [',']), បន្ទាត់ថ្មី.


>> buy := cakes ជំនួស: 0 ប្រវែង: 1 ដោយ: ( ស៊េរី ថ្មី ).
លទ្ធផល សរសេរ: (buy ភ្ជាប់: [',']), បន្ទាត់ថ្មី.


>> buy := cakes ជំនួស: ['0'] ប្រវែង: ['1'] ដោយ: ['x'].
លទ្ធផល សរសេរ: (buy ភ្ជាប់: [',']), បន្ទាត់ថ្មី.
