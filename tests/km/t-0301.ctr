


>> wine := វត្ថុ ថ្មី.


wine ពេលទទួល: ['toString'] ធ្វើ: { <- ['merlot'].
}.

wine ពេលទទួល: ['naarTekst'] ធ្វើ: { <- ['merlot'].
}.


wine ពេលទទួល: ['='] ធ្វើ: { :other wine <- ( ខ្លួន toString = other wine ).
}.

wine ពេលទទួល: ['=='] ធ្វើ: { :other wine <- ( ខ្លួន toString = other wine ).
}.



wine
	ករណី: ['cabernet'] ធ្វើ: { លទ្ធផល សរសេរ: ['it's a Cabernet!']. },
	ករណី: ['syrah']    ធ្វើ: { លទ្ធផល សរសេរ: ['it's a Syrah!'].    },
	ករណី: ['merlot']   ធ្វើ: { លទ្ធផល សរសេរ: ['it's a Merlot!'].   },
	ករណី: ['malbec']   ធ្វើ: { លទ្ធផល សរសេរ: ['it's a Malbec!'].   }.

លទ្ធផល បន្ទាត់ថ្មី.
