{
	កិច្ចការនេះ កំហុស: ['Dont fail.'].
	unknown doSomething.
} ចាប់: {
	លទ្ធផល សរសេរ: ['Caught!'].
}, ដំណើរការ.

{
	កិច្ចការនេះ កំហុស: ['Dont fail.'].
	ផ្ទាល់ unknown doSomething.
} ចាប់: {
	លទ្ធផល សរសេរ: ['Caught!'].
}, ដំណើរការ.

{
	កិច្ចការនេះ កំហុស: ['Dont fail.'].
	unknown := 122.
} ចាប់: {
	លទ្ធផល សរសេរ: ['Caught!'].
}, ដំណើរការ.


{
	កិច្ចការនេះ កំហុស: ['Dont fail.'].
	ពិត បំបែក.
	លទ្ធផល សរសេរ: ['FAIL'].
} ចាប់: {
	លទ្ធផល សរសេរ: ['Caught!'].
}, ដំណើរការ.

{
	{
		កិច្ចការនេះ កំហុស: ['Dont fail.'].
		ពិត បំបែក.
		លទ្ធផល សរសេរ: ['FAIL'].
	} ចាប់: { :x
		(x = ['Dont fail.']) បើពិត: { កិច្ចការនេះ កំហុស: ['Nested Caught!']. }.
	}, ដំណើរការ.
} ចាប់: { :e
	លទ្ធផល សរសេរ: e.
}, ដំណើរការ.
