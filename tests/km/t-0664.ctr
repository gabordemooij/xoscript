# recursive interpolation not allowed

លទ្ធផល សរសេរ: 
['recursive string interolation enabled: '] + (
	កម្មវិធី មុខងារ: 
	['RECURSIVE_STRINTPOL']
), បន្ទាត់ថ្មី.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

លទ្ធផល សរសេរ: a, បន្ទាត់ថ្មី.


កម្មវិធី មុខងារ: ['RECURSIVE_STRINTPOL'] បើក: ពិត.

លទ្ធផល សរសេរ: 
['recursive string interpolation enabled: '] + (
	កម្មវិធី មុខងារ: 
	['RECURSIVE_STRINTPOL']
), បន្ទាត់ថ្មី.

>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

លទ្ធផល សរសេរ: a, បន្ទាត់ថ្មី.

កម្មវិធី មុខងារ: ['RECURSIVE_STRINTPOL'] បើក: មិនពិត.

លទ្ធផល សរសេរ: 
['recursive string interpolation enabled: '] + (
	កម្មវិធី មុខងារ: 
	['RECURSIVE_STRINTPOL']
), បន្ទាត់ថ្មី.

>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

លទ្ធផល សរសេរ: a, បន្ទាត់ថ្មី.
