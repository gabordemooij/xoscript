

អត្ថបទ ពេលទទួល: ['evaluate'] ធ្វើ: {
	>> កូដ := ឯកសារ ថ្មី: ['/tmp/eval.ctr'].
	កូដ សរសេរ: (ខ្លួន ជាអត្ថបទ + ['.']).
	កម្មវិធី ប្រើ: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := ស៊េរី ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q ជាអត្ថបទ.
លទ្ធផល សរសេរ: x, បន្ទាត់ថ្មី.
>> y := ទទេ.
(['y := '] + x ) evaluate.
លទ្ធផល សរសេរ: y ? 0, បន្ទាត់ថ្មី.

q := វចនានុក្រម ដាក់: ['\[''] សោ: ['\['quote\']'].
x := q ជាអត្ថបទ.
លទ្ធផល សរសេរ: x, បន្ទាត់ថ្មី.
y := ទទេ.
(['y := '] + x ) evaluate.

>> q := (វចនានុក្រម ថ្មី) ដាក់:['\[''] សោ:['\['quote\[''].
លទ្ធផល សរសេរ: y ? ['\['quote\']'], បន្ទាត់ថ្មី.
