60 × {
	>> x := (ចំនួន random % 6) + 1.
	(x ≤ 6) បើមិនពិត: { លទ្ធផល សរសេរ: ['FAIL']. }.
	(x ≥0) បើមិនពិត: { លទ្ធផល សរសេរ: ['FAIL']. }.
	x := (ចំនួន random % 3) + 1.
	(x < 3) បើមិនពិត: { លទ្ធផល សរសេរ: ['FAIL']. }.
	(x>-1) បើមិនពិត: { លទ្ធផល សរសេរ: ['FAIL']. }.
	x := ((ប៊ូលីន flip) ជាចំនួន).
	(x = 0 ឬ: x = 1) បើមិនពិត: { លទ្ធផល សរសេរ: ['FAIL']. }.
	x := ((ពិត flip) ជាចំនួន).
	(x = 0 ឬ: x = 1) បើមិនពិត: { លទ្ធផល សរសេរ: ['FAIL']. }.
	x := (ប៊ូលីន flip មួយនេះ: ['HEAD'] ឬមួយនោះ: ['TAIL']).
	((x = ['HEAD']) ឬ: (x = ['TAIL'])) បើមិនពិត: { លទ្ធផល សរសេរ: ['FAIL']. }.
}.
លទ្ធផល សរសេរ: ['DONE'].

