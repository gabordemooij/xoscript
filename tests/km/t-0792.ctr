Server init.

>> DB := Maria-DB ថ្មី ម៉ាស៊ីនបង្ហោះ: ['localhost'],
	ឈ្មោះអ្នកប្រើ: ['xo'],
	ពាក្យសម្ងាត់: ['pass123'],
	ឈ្មោះមូលដ្ឋានទិន្នន័យ: ['xobase'],
	ភ្ជាប់ទៅ.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB សំណួរ: SQL.

# now you don't have to set DB
query2 ទាញយក: { :row
	លទ្ធផល សរសេរ: row world, បន្ទាត់ថ្មី.
}.
