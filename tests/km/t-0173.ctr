

ស៊េរី ពេលទទួល: ['sum'] ធ្វើ: {
	>> total := 0.
	ខ្លួន នីមួយៗ: { :index :element
		total បូក: element.
	}. <- total.
}.

ស៊េរី ពេលទទួល: ['product'] ធ្វើ: {
	>> total := 1.
	ខ្លួន នីមួយៗ: { :index :element
		total គុណនឹង: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

កម្មវិធី គ្រប់គ្រងអង្គចងចាំ: 0.

{

>> a := ស៊េរី ← ['hello'] ; ['world'] ; ពិត ; ទទេ ; 666.
a := a + ( ស៊េរី ← 1 ).
លទ្ធផល សរសេរ: ( ['sum: '] + ( a sum ) ), បន្ទាត់ថ្មី.
លទ្ធផល សរសេរ: ( ['min: '] + ( a អប្បបរមា ) ), បន្ទាត់ថ្មី.
លទ្ធផល សរសេរ: ( ['max: '] + ( a អតិបរមា ) ), បន្ទាត់ថ្មី.
លទ្ធផល សរសេរ: ( ['3rd: '] + ( a ? 2 ) ), បន្ទាត់ថ្មី.
លទ្ធផល សរសេរ: ( ['prd: '] + ( a product ) ), បន្ទាត់ថ្មី.
a តម្រៀប: { :a :b <- (b - a). }.
a នីមួយៗ: { :i :e លទ្ធផល សរសេរ: ( i - 0 ), បន្ទាត់ថ្មី. }.

} ដំណើរការ.

កម្មវិធី សម្អាត.
usedMemory1 := (កម្មវិធី អង្គចងចាំ ? 0).


