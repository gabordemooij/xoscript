#OBSD
>> dirname := [''].
{ dirname បន្ថែមខាងចុង: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
កម្មវិធី ប្រព័ន្ធ: command.
កម្មវិធី chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename បន្ថែមខាងចុង: ['YYYYYYYY']. } * 20.
ឯកសារ ថ្មី: filename, សរសេរ: ['sometext'].
{ ឯកសារ បញ្ជី: ['/tmp/'] + dirname. } * 1000.
លទ្ធផល សរសេរ: ['no crash'], បន្ទាត់ថ្មី.

