Server init.

>> db := Maria-DB ថ្មី ម៉ាស៊ីនបង្ហោះ: ['localhost'],
	ឈ្មោះអ្នកប្រើ: ['xo'],
	ពាក្យសម្ងាត់: ['pass123'],
	ឈ្មោះមូលដ្ឋានទិន្នន័យ: ['xobase'],
	ភ្ជាប់ទៅ.

>> del := db សំណួរ: ['DELETE FROM book WHERE id > 0'].
{  del ប្រតិបត្តិ. db បញ្ជាក់. } ចាប់: { :e db ត្រឡប់ក្រោយ.  }, ដំណើរការ.

>> ចំនួនធាតុ := db សំណួរ: ['SELECT COUNT(*) AS num FROM book'].
ចំនួនធាតុ ទាញយក: { :row លទ្ធផល សរសេរ: row num, បន្ទាត់ថ្មី. }.
