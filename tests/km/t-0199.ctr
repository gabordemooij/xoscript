
កម្មវិធី គ្រប់គ្រងអង្គចងចាំ: 4.

>> Animal := វត្ថុ ថ្មី.
Animal ពេលទទួល: ['make'] ធ្វើ: {
	>> animal := វត្ថុ ថ្មី.
	animal ពេលទទួល: ['makeSound'] ធ្វើ: {
		លទ្ធផល សរសេរ: ផ្ទាល់ sound.
	}. <- animal.
}.
>> Cat := វត្ថុ ថ្មី.
Cat ពេលទទួល: ['make'] ធ្វើ: {
	>> cat := Animal make.
	cat ពេលទទួល: ['init'] ធ្វើ: {
		ផ្ទាល់ sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
