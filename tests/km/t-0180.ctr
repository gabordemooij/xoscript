អត្ថបទ ពេលទទួល: ['html'] ធ្វើ: { <- (
		ខ្លួន
		ជំនួស: ['&'] ដោយ: ['&amp;'],
		ជំនួស: ['<'] ដោយ: ['&lt;'],
		ជំនួស: ['>'] ដោយ: ['&gt;'],
		ជំនួស: ['''] ដោយ: ['&apos;'],
		ជំនួស: ['"'] ដោយ: ['&quot;']
	).
}.

