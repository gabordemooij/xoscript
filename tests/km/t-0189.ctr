>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

កម្មវិធី គ្រប់គ្រងអង្គចងចាំ: 0.

>> a := មិនពិត.
>> b := ពិត.
>> c := (a និង: b).
>> d := (a xor: b).
>> e := (a ឬ: b).
>> f := (a ! b).
>> g := a មួយនេះ: ['x'] ឬមួយនោះ: ['y'].
>> h := ['-'] + g.

កម្មវិធី សម្អាត.
usedMemory1 := (កម្មវិធី អង្គចងចាំ ? 0).

>> a := មិនពិត.
>> b := ពិត.
>> c := (a និង: b).
>> d := (a xor: b).
>> e := (a ឬ: b).
>> f := (a ! b).
>> g := a មួយនេះ: ['x'] ឬមួយនោះ: ['y'].
>> h := ['-'] + g.

កម្មវិធី សម្អាត.
usedMemory2 := (កម្មវិធី អង្គចងចាំ ? 0).

>> a := មិនពិត.
>> b := ពិត.
>> c := (a និង: b).
>> d := (a xor: b).
>> e := (a ឬ: b).
>> f := (a ! b).
>> g := a មួយនេះ: ['x'] ឬមួយនោះ: ['y'].
>> h := ['-'] + g.

កម្មវិធី សម្អាត.
usedMemory3 := (កម្មវិធី អង្គចងចាំ ? 0).

( usedMemory1 = usedMemory2 និង: usedMemory1 = usedMemory3, និង: usedMemory2 = usedMemory3 ) បើពិត: {
	លទ្ធផល សរសេរ: ['No memory leaks here'].
}, បើមិនពិត: {
