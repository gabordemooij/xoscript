

ស៊េរី ពេលទទួល: ['fixture:'] ធ្វើ: { :f
	ផ្ទាល់ fixture := f.
}.

ស៊េរី ពេលទទួល: ['ចំនួនធាតុ'] ធ្វើ: { <- ផ្ទាល់ fixture.
}.

ស៊េរី ពេលទទួល: ['aantal'] ធ្វើ: { <- ផ្ទាល់ fixture.
}.


>> x := ទទេ.
{

	x := ['hello'] 
	ជំនួស:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] តួអក្សរ: 2)
			)
		)
	ដោយ: (
		(['...hal'] + ['lo']) 
			អក្សរធំ 
			lowecase 
			អក្សរធំ 
			រំលង: -1 + ( 
				11 - 12 + (
					(
						(
							(
								ស៊េរី ← 0 ; 1 ; 4; 9 ; (ស៊េរី ← 0 ; 3; 1) ; 4
							) មុនចុងក្រោយ
						) ? 1
					) + 
					((ស៊េរី ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					ចំនួនធាតុ
				)
			)
	).

} × 10.
លទ្ធផល សរសេរ: x, បន្ទាត់ថ្មី.

