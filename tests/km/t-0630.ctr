#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := លំនាំ ថ្មី: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern ផ្គូផ្គង: subject ធ្វើ: { :m :x
	លទ្ធផល សរសេរ: m, បន្ទាត់ថ្មី.
	លទ្ធផល សរសេរ: x, បន្ទាត់ថ្មី. <- ['XXX'].
}.
លទ្ធផល សរសេរ: result, បន្ទាត់ថ្មី.