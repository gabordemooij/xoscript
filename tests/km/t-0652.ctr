# test number -> string -> number
{

	>> x := ចំនួន រវាង: 0 ដល់: 1000000.
	>> d := ចំនួន រវាង: 1 ដល់: 7.
	>> e := 10 ស្វ័យគុណ: d.

	x ចែកនឹង: e.
	>> y := x ជាអត្ថបទ ជាចំនួន.

	(x = y) បើមិនពិត: {
		លទ្ធផល សរសេរ: x, បន្ទាត់ថ្មី.
		លទ្ធផល សរសេរ: y, បន្ទាត់ថ្មី.
		កម្មវិធី បញ្ចប់.
	}.

} * 1000.
លទ្ធផល សរសេរ: ['OK'], បន្ទាត់ថ្មី.