# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := លំនាំ ថ្មី: pattern.
	p ផ្គូផ្គង: subject ធ្វើ: { :m :g
		លទ្ធផល សរសេរ: g ចំនួនធាតុ, សរសេរ: [' '], សរសេរ: (g ភ្ជាប់: ['|']), បន្ទាត់ថ្មី. <- m.
	}.
}.
show អនុវត្ត: ['(a)|(b)'] និង: ['b'].
show អនុវត្ត: ['(a)|(b)'] និង: ['a'].
show អនុវត្ត: ['(x)?y'] និង: ['y'].
show អនុវត្ត: ['(x)?(y)(z)?'] និង: ['xy'].
