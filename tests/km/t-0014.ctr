>> Greeter := វត្ថុ ថ្មី.
Greeter ពេលទទួល: ['make'] ធ្វើ: {
	>> gr := វត្ថុ ថ្មី.
	gr ពេលទទួល: ['setName:'] ធ្វើ: { :aname
		ផ្ទាល់ ឈ្មោះ := aname.
	}.
	gr ពេលទទួល: ['greet'] ធ្វើ: {
		លទ្ធផល សរសេរ: ផ្ទាល់ ឈ្មោះ.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a ថ្មី.
c setName: ['THREE'].
c greet.
>> d := a ថ្មី.
d setName: ['FOUR'].
d greet.
c greet.
