
>> dictionary := (
	វចនានុក្រម ថ្មី
		ដាក់: ['b'] សោ: ['a'],
		ដាក់: ['a'] សោ: ['b'],
		ដាក់: ['z'] សោ: ['x'],
		ដាក់: ['hello'] សោ: ['hallo'],
		ដាក់: ['human'] សោ: ['human']
).

>> comparisons := ស៊េរី ថ្មី.
dictionary នីមួយៗ: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a ប្រៀបធៀប: b)
	).
}.

comparisons តម្រៀប: { :a :b <- ( a ប្រៀបធៀប: b ). }.
លទ្ធផល សរសេរ: ( comparisons ភ្ជាប់: ['↵'] ), បន្ទាត់ថ្មី.
comparisons ភ្ជាប់: ['↵'].
