# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob ថ្មី: 8, bytes: (
	ស៊េរី ថ្មី ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

លទ្ធផល សរសេរ: ( utf16 ឌិកូដ: ['utf16le'] ), បន្ទាត់ថ្មី.

utf16 ដោះលែង.
>> utf32 := Blob ថ្មី: 13, bytes: (
	ស៊េរី ថ្មី ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

លទ្ធផល សរសេរ: ( utf32 ឌិកូដ: ['utf32be'] ), បន្ទាត់ថ្មី.
utf32 ដោះលែង.