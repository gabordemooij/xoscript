>> Slurp := វត្ថុ ថ្មី.

Slurp ពេលទទួល: ['ថ្មី'] ធ្វើ: {
	ផ្ទាល់ str := [''].
}.

Slurp ពេលទទួល: ['ឆ្លើយតប:'] ធ្វើ: { :blah
		(ផ្ទាល់ str = ['']) បើពិត: {
			ផ្ទាល់ str បន្ថែមខាងចុង: blah.
		}, បើមិនដូច្នោះ: {
			ផ្ទាល់ str បន្ថែមខាងចុង: [' '].
			ផ្ទាល់ str បន្ថែមខាងចុង: blah.
		}.
}.

Slurp ពេលទទួល: ['ឆ្លើយតប:និង:'] ធ្វើ: { :blah :blahah
		(blah ប្រវែង > 1) បើពិត: {
			ផ្ទាល់ str បន្ថែមខាងចុង: (blah ចាប់ពី: 0 ប្រវែង: (blah ប្រវែង - 1)).
		}, បើមិនដូច្នោះ: {
			ផ្ទាល់ str បន្ថែមខាងចុង: blah.
		}.
		ផ្ទាល់ str បន្ថែមខាងចុង: [' '].
		ផ្ទាល់ str បន្ថែមខាងចុង: blahah.
}.

Slurp ពេលទទួល: ['obtain'] ធ្វើ: {
	>> buffer := ផ្ទាល់ str.
	ផ្ទាល់ str := ['']. <- buffer.
}.


>> x := Slurp ថ្មី.
x + 3.
លទ្ធផល សរសេរ: (x obtain), បន្ទាត់ថ្មី.
x echo: ['Hello world'].
លទ្ធផល សរសេរ: (x obtain), បន្ទាត់ថ្មី.
x tellme: 123 and: 987.
លទ្ធផល សរសេរ: (x obtain), បន្ទាត់ថ្មី.
