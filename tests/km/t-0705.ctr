

>> obj := វត្ថុ ថ្មី.

obj ពេលទទួល: ['greet'] ធ្វើ: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj ពេលទទួល: ['task'] ធ្វើ: {
	ផ្ទាល់ property := 123.
	{
		# try binds self/own to object instead of block
		លទ្ធផល សរសេរ: ខ្លួន greet.
		លទ្ធផល សរសេរ: ផ្ទាល់ property.
		1 / 0.
	} ចាប់: {
		លទ្ធផល សរសេរ: ខ្លួន greet.
		លទ្ធផល សរសេរ: ផ្ទាល់ property.
		លទ្ធផល សរសេរ: ['ok'].
	}, ព្យាយាម.
}.

obj task.