

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> x := 100.

កម្មវិធី គ្រប់គ្រងអង្គចងចាំ: 0.

{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt បន្ថែមខាងចុង: ['!!'].
លទ្ធផល សរសេរ: txt.
} ដំណើរការ.

កម្មវិធី សម្អាត.

usedMemory1 := (កម្មវិធី អង្គចងចាំ ? 0).


{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt បន្ថែមខាងចុង: ['!!'].
លទ្ធផល សរសេរ: txt.
} ដំណើរការ.

កម្មវិធី សម្អាត.
usedMemory2 := (កម្មវិធី អង្គចងចាំ ? 0).


{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt បន្ថែមខាងចុង: ['!!'].
