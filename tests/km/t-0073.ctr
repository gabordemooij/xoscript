
>> blue := ['blue'].
>> colors := ស៊េរី ← ['yellow']; ['green']; blue ; ['red']; ['orange']; ['purple']; ['pink'].
>> palette := colors ចាប់ពី: 2 ប្រវែង: 3.
លទ្ធផល សរសេរ: (palette ភ្ជាប់: [',']), បន្ទាត់ថ្មី. 
blue := ['cyan'].
លទ្ធផល សរសេរ: blue, បន្ទាត់ថ្មី. 
colors ដាក់: ['black'] សោ: 2. 
លទ្ធផល សរសេរ: (colors ភ្ជាប់: [',']), បន្ទាត់ថ្មី. 
