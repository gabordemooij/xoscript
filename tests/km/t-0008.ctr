>> Greeter := វត្ថុ ថ្មី.
Greeter ពេលទទួល: ['make'] ធ្វើ: {
	>> greeter := វត្ថុ ថ្មី.
	greeter ពេលទទួល: ['name:'] ធ្វើ: { :ឈ្មោះ
		លទ្ធផល សរសេរ: ['setting a name'].
		ផ្ទាល់ myName := ឈ្មោះ.
	}.
	greeter ពេលទទួល: ['greet'] ធ្វើ: {
		លទ្ធផល សរសេរ: ['Hello'].
		លទ្ធផល សរសេរ: ផ្ទាល់ myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
