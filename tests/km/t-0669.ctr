# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := ទូដែក 
	ហាសពាក្យសម្ងាត់: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := ទូដែក 
	ហាសពាក្យសម្ងាត់: hash ផ្ទៀងផ្ទាត់: a1.
	# fail 
>> b := ទូដែក
	ហាសពាក្យសម្ងាត់: hash ផ្ទៀងផ្ទាត់: a2.
	# ok!

លទ្ធផល សរសេរ: a, បន្ទាត់ថ្មី.
លទ្ធផល សរសេរ: b, បន្ទាត់ថ្មី.

