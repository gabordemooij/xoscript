Server init.

>> DB := Maria-DB ថ្មី ម៉ាស៊ីនបង្ហោះ: ['localhost'],
	ឈ្មោះអ្នកប្រើ: ['xo'],
	ពាក្យសម្ងាត់: ['pass123'],
	ឈ្មោះមូលដ្ឋានទិន្នន័យ: ['xobase'],
	ភ្ជាប់ទៅ.

{
	DB សំណួរ:
	['DROP TABLE movies'],
	ប្រតិបត្តិ.
} ចាប់: { ទទេ. }, ដំណើរការ.

DB សំណួរ:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
ប្រតិបត្តិ.

DB សំណួរ: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
ប៉ារ៉ាម៉ែត្រ: ( ស៊េរី ថ្មី ; ['Halloween'] ),
ប្រតិបត្តិ.

DB សំណួរ: ['SELECT * FROM movies'],
ទាញយក: { :movie
	លទ្ធផល សរសេរ: movie title, បន្ទាត់ថ្មី.
}.

