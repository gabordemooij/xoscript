

>> Matryoshka := វត្ថុ ថ្មី.
Matryoshka ពេលទទួល: ['double:'] ធ្វើ: { :secret
	ផ្ទាល់ secret := secret × 2.
}.
Matryoshka ពេលទទួល: ['ថ្មី:'] ធ្វើ: { :secret
	>> answer := ទទេ.
	>> t := (secret > 255).
	លទ្ធផល សរសេរ: (secret + [' | '] + t), បន្ទាត់ថ្មី.
	t បើពិត: {
		answer := secret.
	}, បើមិនដូច្នោះ: {
		answer := Matryoshka ហៅខ្លួនឯង ថ្មី: (ខ្លួន double: secret).
	}. <- answer.
}.

>> x := Matryoshka ថ្មី: 2.
