

ស៊េរី ពេលទទួល: ['column:'] ធ្វើ: { :column
	>> result := ស៊េរី ថ្មី.
	ខ្លួន នីមួយៗ: { :index :row
		row នីមួយៗ: { :index :cell
			(index = column) បើពិត: { result បន្ថែមខាងចុង: cell. }.
		}.
	}. <- result.
}.


>> a := ស៊េរី ←
	(ស៊េរី ← 1 ; 2 ; 3) ;
	(ស៊េរី ← 4 ; 5 ; 6) ;
	(ស៊េរី ← 7 ; 8 ; 9).

>> b := a column: 1.
លទ្ធផល សរសេរ: b, បន្ទាត់ថ្មី.

b := a column: 20.
លទ្ធផល សរសេរ: b, បន្ទាត់ថ្មី.

b := a column: -100.
លទ្ធផល សរសេរ: b, បន្ទាត់ថ្មី.
