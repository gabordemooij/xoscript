


>> Deck := ស៊េរី ថ្មី.
Deck ពេលទទួល: ['print'] ធ្វើ: {
        >> len := ខ្លួន ចំនួនធាតុ - 1.
        { :i
                >> len2 := ខ្លួន ចំនួនធាតុ - 1.
                លទ្ធផល សរសេរ: ['len: '].
                លទ្ធផល សរសេរ: len, បន្ទាត់ថ្មី.
                លទ្ធផល សរសេរ: ['len2: '].
                លទ្ធផល សរសេរ: len2, បន្ទាត់ថ្មី.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
