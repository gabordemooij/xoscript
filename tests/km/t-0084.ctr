>> makeAdder := { :x
	>> f := { :y <- (ផ្ទាល់ x + y). } កំណត់: ['x'] តម្លៃ: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i ផ្ទាល់ q ដាក់: (ផ្ទាល់ f អនុវត្ត: (ផ្ទាល់ q ? i)) សោ: i. } 
	កំណត់: ['q'] តម្លៃ: array,
	កំណត់: ['f'] តម្លៃ: func.
	{ :i mapping អនុវត្ត: i. } × (array ចំនួនធាតុ).
}.

>> a := ស៊េរី ← 1; 2; 3.
mapper អនុវត្ត: a និង: (makeAdder អនុវត្ត: 100).
លទ្ធផល សរសេរ: (a ទីតាំង: 0), បន្ទាត់ថ្មី.
លទ្ធផល សរសេរ: (a ? 1), បន្ទាត់ថ្មី.
លទ្ធផល សរសេរ: (a ? 2), បន្ទាត់ថ្មី.
