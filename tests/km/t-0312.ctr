>> Slurp := វត្ថុ ថ្មី.
Slurp ពេលទទួល: ['ថ្មី'] ធ្វើ: {
	ផ្ទាល់ str := [''].
}.
Slurp រៀន: ['nieuw'] មានន័យថា: ['ថ្មី'].
Slurp ពេលទទួល: ['ឆ្លើយតប:'] ធ្វើ: { :blah
		(ផ្ទាល់ str ≠ ['']) បើពិត: {
			ផ្ទាល់ str បន្ថែមខាងចុង: [' '].
		}.
		ផ្ទាល់ str បន្ថែមខាងចុង: blah.
}.
Slurp ពេលទទួល: ['ឆ្លើយតប:និង:'] ធ្វើ: { :blah :blahah
		(ផ្ទាល់ str ≠ ['']) បើពិត: {
			ផ្ទាល់ str បន្ថែមខាងចុង: [' '].
		}.
		(blah ប្រវែង > 1) បើពិត: {
			ផ្ទាល់ str បន្ថែមខាងចុង: (blah ចាប់ពី: 0 ប្រវែង: (blah ប្រវែង - 1)).
		}, បើមិនដូច្នោះ: {
			ផ្ទាល់ str បន្ថែមខាងចុង: blah.
		}.
		ផ្ទាល់ str បន្ថែមខាងចុង: [' '].
		ផ្ទាល់ str បន្ថែមខាងចុង: blahah.
}.
Slurp ពេលទទួល: ['obtain'] ធ្វើ: {
	>> buffer := ផ្ទាល់ str.
	ផ្ទាល់ str := ['']. <- buffer.
}.


>> ប៉ារ៉ាម៉ែត្រស្វែងរក := Slurp ថ្មី
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

លទ្ធផល សរសេរ: ប៉ារ៉ាម៉ែត្រស្វែងរក obtain, បន្ទាត់ថ្មី.
