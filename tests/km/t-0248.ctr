

អត្ថបទ ពេលទទួល: ['evaluate'] ធ្វើ: {
	>> កូដ := ឯកសារ ថ្មី: ['/tmp/eval.ctr'].
	កូដ សរសេរ: ខ្លួន ជាអត្ថបទ + ['.'].
	កម្មវិធី ប្រើ: ['/tmp/eval.ctr'].
}.

>> a := (ស៊េរី ← (
	(វចនានុក្រម ថ្មី)
		ដាក់: ['domain'] សោ: ['mywebsite.com'],
		ដាក់: (ស៊េរី ←
			((វចនានុក្រម ថ្មី)
				ដាក់: ['home'] សោ: ['title'],
				ដាក់: ['<html></html>'] សោ: ['body'],
				ដាក់: ['2017-01-01'] សោ: ['created']
			) ;
			((វចនានុក្រម ថ្មី)
				ដាក់: ['aboutus(c)'] សោ: ['title'],
				ដាក់: ['<credits>Author Inc.</credits>'] សោ: ['body']
			)
		) សោ: ['pages']
	)
) ជាអត្ថបទ.

លទ្ធផល សរសេរ: a ប្រភេទ, បន្ទាត់ថ្មី.
លទ្ធផល សរសេរ: a, បន្ទាត់ថ្មី.

>> b := ទទេ.
(['b := '] + a) evaluate.
លទ្ធផល សរសេរ: b ? 0 ? ['pages'] ? 1 ? ['body'], បន្ទាត់ថ្មី.

>> c := b ? 0.
>> d := c ជាអត្ថបទ.
លទ្ធផល សរសេរ: d ប្រភេទ, បន្ទាត់ថ្មី.

>> e := ទទេ.
(['e := '] + d) evaluate.
លទ្ធផល សរសេរ: e ? ['pages'] ? 0, បន្ទាត់ថ្មី.
