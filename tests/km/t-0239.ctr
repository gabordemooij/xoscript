ស៊េរី ពេលទទួល: ['sum'] ធ្វើ: {
	>> total := 0.
	ខ្លួន នីមួយៗ: { :index :element
		total បូក: element.
	}. <- total.
}.

>> a := ពិត.



a ពេលទទួល: ['ជាអត្ថបទ'] ធ្វើ: {
	>> answer := ទទេ.
	( ខ្លួន = ពិត ) បើពិត: {
		answer := ['Yep'].
	}, បើមិនដូច្នោះ: {
		answer := ['Nope'].
	}. <- answer.
}.

a ពេលទទួល: ['ជាចំនួន'] ធ្វើ: {
	>> answer := ទទេ.
	( ខ្លួន = ពិត ) បើពិត: {
		answer := 10.
	}, បើមិនដូច្នោះ: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b ពេលទទួល: ['ជាអត្ថបទ'] ធ្វើ: { <- ['Devil'].
}.

b ពេលទទួល: ['ជាប៊ូលីន'] ធ្វើ: { <- មិនពិត.
}.


លទ្ធផល សរសេរ: a, បន្ទាត់ថ្មី.  
លទ្ធផល សរសេរ: (90 + a), បន្ទាត់ថ្មី. 
លទ្ធផល សរសេរ: b, បន្ទាត់ថ្មី. 
លទ្ធផល សរសេរ: (ពិត និង: b), បន្ទាត់ថ្មី.

a := ស៊េរី ← ['hello'] ; ['world'] ; ពិត ; ទទេ ; 666. 
a := a + ( ស៊េរី ← 1 ).
លទ្ធផល សរសេរ: a, បន្ទាត់ថ្មី.
លទ្ធផល សរសេរ: ((វចនានុក្រម ថ្មី) ដាក់: ទទេ សោ: ទទេ), បន្ទាត់ថ្មី.
លទ្ធផល សរសេរ: a sum, បន្ទាត់ថ្មី. 


{
	a ពេលទទួល: ['ជាអត្ថបទ'] ធ្វើ: { <- ទទេ. }.
	a := [''] + a.
} ចាប់: { :error
	លទ្ធផល សរសេរ: ['Error noted: '] + error, បន្ទាត់ថ្មី.
}, ដំណើរការ.



{
	a ពេលទទួល: ['ជាចំនួន'] ធ្វើ: { <- ទទេ. }.
	a := 3 × a.
} ចាប់: { :error
	លទ្ធផល សរសេរ: ['Error noted: '] + error, បន្ទាត់ថ្មី.
}, ដំណើរការ.


