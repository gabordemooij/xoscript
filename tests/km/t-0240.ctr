# test qualifiers

>> $ := វត្ថុ ថ្មី.

$ ពេលទទួល: ['ឆ្លើយតប:'] ធ្វើ: { :x
	
	>> operation := x តួអក្សរ: 0.
	>> valuta := x តួអក្សរ: 1.
	>> money := x រំលង: 2.
	
	>> amount := 0.

	( operation = ['+'] ) បើពិត: {
		( valuta = ['£'] ) បើពិត: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

លទ្ធផល សរសេរ: x, បន្ទាត់ថ្មី.


>> Fruit := វត្ថុ ថ្មី.

Fruit ពេលទទួល: ['ថ្មី'] ធ្វើ: {
	>> f := ខ្លួន ថ្មី.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit ពេលទទួល: ['apples:'] ធ្វើ: { :a ផ្ទាល់ apples := a. }.
Fruit ពេលទទួល: ['oranges:'] ធ្វើ: { :p ផ្ទាល់ oranges := p. }.
Fruit ពេលទទួល: ['apples'] ធ្វើ: { <- ផ្ទាល់ apples. }.
Fruit ពេលទទួល: ['oranges'] ធ្វើ: { <- ផ្ទាល់ oranges. }.

Fruit ពេលទទួល: ['+'] ធ្វើ: { :f
	
	>> n := Fruit ថ្មី.
	f បូក: 1.
	
	n apples: (f apples + ផ្ទាល់ apples).
	n oranges:  (f oranges  + ផ្ទាល់ oranges). <- n.
}.

Fruit ពេលទទួល: ['ជាអត្ថបទ'] ធ្វើ: { <- ( ផ្ទាល់ apples ជាអត្ថបទ + [' apples and '] + ផ្ទាល់ oranges + [' oranges'] ).
}.

ចំនួន ពេលទទួល: ['apples'] ធ្វើ: { <- ((Fruit ថ្មី) apples: ខ្លួន).
}.

ចំនួន ពេលទទួល: ['apple'] ធ្វើ: { <- ((Fruit ថ្មី) apples: ខ្លួន).
}.

ចំនួន ពេលទទួល: ['oranges'] ធ្វើ: { <- ((Fruit ថ្មី) oranges: ខ្លួន).
}.




លទ្ធផល សរសេរ: (1 apple + 3 oranges + 4 apples), បន្ទាត់ថ្មី.


អត្ថបទ ពេលទទួល: ['twice'] ធ្វើ: { <- ((ខ្លួន ជាអត្ថបទ) + (ខ្លួន ជាអត្ថបទ)).
}.



លទ្ធផល សរសេរ: ['❤❤❤'] twice.



