>> x := វត្ថុ ថ្មី.
>> y := វត្ថុ ថ្មី.
>> z := x.
លទ្ធផល សរសេរ: (x = z), បន្ទាត់ថ្មី.
លទ្ធផល សរសេរ: (x = y), បន្ទាត់ថ្មី.
លទ្ធផល សរសេរ: (x ≠ y), បន្ទាត់ថ្មី.
លទ្ធផល សរសេរ: (x ≠ z), បន្ទាត់ថ្មី.
>> m := ខណៈ ថ្មី ឆ្នាំ: 2070, ខែ: 11.
>> n := m ចម្លង.
លទ្ធផល សរសេរ: (m = n), បន្ទាត់ថ្មី.
លទ្ធផល សរសេរ: (m ≠ n), បន្ទាត់ថ្មី.
លទ្ធផល សរសេរ: (m តែមួយ: m), បន្ទាត់ថ្មី.
លទ្ធផល សរសេរ: (m តែមួយ: n), បន្ទាត់ថ្មី.
n ខែ: 12.
លទ្ធផល សរសេរ: (m ≠ n), បន្ទាត់ថ្មី.
លទ្ធផល សរសេរ: (m = n), បន្ទាត់ថ្មី.


