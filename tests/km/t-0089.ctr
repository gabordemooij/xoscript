>> randomizer := { :a :b
	>> អប្បបរមា := ( a < b ) មួយនេះ: a ឬមួយនោះ: b.
	>> អតិបរមា := ( a > b ) មួយនេះ: a ឬមួយនោះ: b.
	>> x := ទទេ.
	{
		x := ចំនួន រវាង: a ដល់: b.
		((x < អប្បបរមា) ឬ: (x > អតិបរមា)) បើពិត: { 
			លទ្ធផល សរសេរ: (['Invalid value!']).
			កម្មវិធី បញ្ចប់.
		}.
	} 
	× 100. <- x.
}.
