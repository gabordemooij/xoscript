


>> CoffeeMachine := វត្ថុ ថ្មី.
CoffeeMachine ពេលទទួល: ['order:'] ធ្វើ: { :id
	>> coffee := ['Americano'].
	( id = 1 ) បើពិត: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) បើពិត: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) បើពិត: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := វត្ថុ ថ្មី.
SimpleCoffeeMachine ពេលទទួល: ['order'] ធ្វើ: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
លទ្ធផល សរសេរ: redCup, បន្ទាត់ថ្មី.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
លទ្ធផល សរសេរ: greenCup, បន្ទាត់ថ្មី.
>> yellowCup := CoffeeMachine order: 1.
លទ្ធផល សរសេរ: yellowCup, បន្ទាត់ថ្មី.
>> blueCup := CoffeeMachine order: 0.
លទ្ធផល សរសេរ: blueCup, បន្ទាត់ថ្មី.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
លទ្ធផល សរសេរ: blackCup, បន្ទាត់ថ្មី.
blackCup បន្ថែមខាងចុង: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
លទ្ធផល សរសេរ: orangeCup, បន្ទាត់ថ្មី.
