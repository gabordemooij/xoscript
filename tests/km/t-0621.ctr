>> phrases := ស៊េរី ថ្មី
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases នីមួយៗ: { :_ :phrase 
	>> e := Server base64-អ៊ិនកូដ: phrase.
	>> d := Server base64-ឌិកូដ: e.
	លទ្ធផល សរសេរ: (
		message ចម្លង ~encoded: e, ~decoded: d
	), បន្ទាត់ថ្មី.
}.
