# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Shiri shell-escape: ['abc'].
Fitarwa rubuta: c, sabon-layi.
Fitarwa rubuta: ( Shiri tsarin-aiki: ['echo '] + c ), sabon-layi.

c := Shiri shell-escape: ['a'b'c'].
Fitarwa rubuta: c, sabon-layi.
Fitarwa rubuta: ( Shiri tsarin-aiki: ['echo '] + c ), sabon-layi.

c := Shiri shell-escape: ['a\'c'].
Fitarwa rubuta: c, sabon-layi.
Fitarwa rubuta: ( Shiri tsarin-aiki: ['echo '] + c ), sabon-layi.