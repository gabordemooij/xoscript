Server init.

>> db := Maria-DB sabo mai-masauki: ['localhost'],
	sunan-mai-amfani: ['xo'],
	kalmar-sirri: ['pass123'],
	sunan-rumbun-bayanai: ['xobase'],
	haɗu.

>> del := db tambaya: ['DELETE FROM book WHERE id > 0'].
{  del zartar. db tabbatar. } kama: { :e db mayar-baya.  }, fara.

>> ƙidaya := db tambaya: ['SELECT COUNT(*) AS num FROM book'].
ƙidaya ɗauko: { :row Fitarwa rubuta: row num, sabon-layi. }.
