Server init.

# write a test file
>> f := Fayil sabo: ['/tmp/test.gif'].
f rubuta: ['GIF87a01234567810'].

# serve the file
Server wuce: ['test.gif'] karin-farko: ['/tmp/'].

Fitarwa sabon-layi.

Fitarwa rubuta: ['Outside container (security):'], sabon-layi.
{ Server wuce: ['../passwd'] karin-farko: ['/tmp/']. }
kama: { :e Fitarwa rubuta: e, sabon-layi. },
fara.

Fitarwa rubuta: ['Invalid prefix:'], sabon-layi.
{ Server wuce: ['test.gif'] karin-farko: ['z:\\']. }
kama: { :e Fitarwa rubuta: e, sabon-layi. },
fara.

Fitarwa rubuta: ['Non-existant file:'], sabon-layi.
{ Server wuce: ['xxx.xxx'] karin-farko: ['/tmp/']. }
kama: { :e Fitarwa rubuta: e, sabon-layi. },
fara.
