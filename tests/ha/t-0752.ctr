Fitarwa rubuta: ['Test object'], sabon-layi.
>> a := Abu sabo. 

a idan: ['item:'] yi: { :boolean
	nasa boolean := boolean. 
}.

a idan: ['item'] yi: { <- nasa boolean.
}.

a item: Boolean.

Fitarwa rubuta: a item, sabon-layi.

>> old-bool-address := a item samfuri adireshin-ƙwaƙwalwa.
a save-as: ['/tmp/a.bin'].
Fitarwa rubuta: ['========== RELOADING SNAP:'], sabon-layi.

>> b := Abu load-from: ['/tmp/a.bin'].

(b item samfuri adireshin-ƙwaƙwalwa = old-bool-address) gaskiya: {
	Fitarwa rubuta: ['Object link re-attached.'], sabon-layi.
}.

Fitarwa rubuta: b item, sabon-layi.
