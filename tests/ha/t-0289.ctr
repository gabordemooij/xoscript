#Linux
>> OS := Shiri tsarin-aiki: (Umarni uname -s), datse.

>> Slurp := Abu sabo.
Slurp idan: ['sabo'] yi: {
	nasa str := [''].
}.
Slurp idan: ['amsa:'] yi: { :blah
		(nasa str ≠ ['']) gaskiya: {
			nasa str ƙara-a-ƙarshe: [' '].
		}.
		nasa str ƙara-a-ƙarshe: blah.
}.
Slurp idan: ['amsa:da:'] yi: { :blah :blahah
		(nasa str ≠ ['']) gaskiya: {
			nasa str ƙara-a-ƙarshe: [' '].
		}.
		(blah tsawo > 1) gaskiya: {
			nasa str ƙara-a-ƙarshe: (blah daga: 0 tsawo: (blah tsawo - 1)).
		}, in-ba-haka-ba: {
			nasa str ƙara-a-ƙarshe: blah.
		}.
		nasa str ƙara-a-ƙarshe: [' '].
		nasa str ƙara-a-ƙarshe: blahah.
}.
Slurp idan: ['obtain'] yi: {
	>> buffer := nasa str.
	nasa str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text ƙara-a-ƙarshe: ['hello'].
} × 1000.


Fitarwa rubuta: (
	Shiri tsarin-aiki: (
		Slurp sabo
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

