
>> dictionary := (
	Ƙamus sabo
		sanya: ['b'] a: ['a'],
		sanya: ['a'] a: ['b'],
		sanya: ['z'] a: ['x'],
		sanya: ['hello'] a: ['hallo'],
		sanya: ['human'] a: ['human']
).

>> comparisons := Jeri sabo.
dictionary kowane: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a kwatanta: b)
	).
}.

comparisons jera: { :a :b <- ( a kwatanta: b ). }.
Fitarwa rubuta: ( comparisons haɗa: ['↵'] ), sabon-layi.
comparisons haɗa: ['↵'].
