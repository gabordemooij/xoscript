

Shiri tsaftace.


>> Veggy := Abu sabo.
Veggy idan: ['sabo'] yi: {
	>> v := kai sabo.
	v init. <- v.
}.

Veggy idan: ['init'] yi: { nasa veggies := 0. }.

Veggy idan: ['carrots:'] yi: { :a nasa veggies := a. <- Babu. }.
Veggy idan: ['carrots'] yi: { <- nasa veggies. }.
Veggy idan: ['+'] yi: { :f
	>> n := Veggy sabo.
	n carrots: (f carrots + nasa veggies). <- n.
}.

Veggy idan: ['rubutu'] yi: { <- nasa veggies rubutu.
}.

Lamba idan: ['carrots'] yi: {
	>> x := Veggy sabo.
	x carrots: kai. <- x.
}.

Lamba idan: ['add:and:'] yi: { :a :b <- (a + b).
}.

>> q := 0 add: (3 carrots + 2 carrots) and: 4 carrots.
Fitarwa rubuta: q, sabon-layi.
