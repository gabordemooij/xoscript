>> z := Abu sabo.
z idan: ['value:'] yi: { :v
	nasa value := v. <- kai.
}.
z idan: ['value'] yi: { <- nasa value. }.
(z setValue: 1) value: 2.
Fitarwa rubuta: z value.
>> x := z.
Fitarwa rubuta: x value.
z := Babu.
Fitarwa rubuta: z value.
Fitarwa rubuta: x value.
Fitarwa rubuta: ['hello'].
Fitarwa rubuta: 3 + 2.
Fitarwa rubuta: (3 > 2).
