Fitarwa rubuta: ['Test object'], sabon-layi.
>> a := Abu sabo. 

a idan: ['item:'] yi: { :out
	nasa out := out. 
}.

a idan: ['item'] yi: { <- nasa out.
}.

a idan: ['greet'] yi: {
	Fitarwa rubuta: ['hi from original out!'], sabon-layi.
}.

a item: Fitarwa.

Fitarwa rubuta: a item, sabon-layi.

>> old-out-address := a item samfuri adireshin-ƙwaƙwalwa.
a save-as: ['/tmp/a.bin'].
Fitarwa rubuta: ['========== RELOADING SNAP:'], sabon-layi.

>> b := Abu load-from: ['/tmp/a.bin'].

(b item samfuri adireshin-ƙwaƙwalwa = old-out-address) gaskiya: {
	Fitarwa rubuta: ['Object link re-attached.'], sabon-layi.
}.

b item rubuta: ['hello from loaded out!'], sabon-layi.
b greet.
