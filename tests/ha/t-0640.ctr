>> sigogin-nema :=
db tambaya: ['SELECT UNHEX('CAFE') AS blobby'],
ɗauko: { :row
	Fitarwa rubuta: ( row blobby daga: 0 tsawo: 2 ), sabon-layi.
	row blobby saki.
}.
