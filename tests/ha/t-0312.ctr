>> Slurp := Abu sabo.
Slurp idan: ['sabo'] yi: {
	nasa str := [''].
}.
Slurp koya: ['nieuw'] yana-nufin: ['sabo'].
Slurp idan: ['amsa:'] yi: { :blah
		(nasa str ≠ ['']) gaskiya: {
			nasa str ƙara-a-ƙarshe: [' '].
		}.
		nasa str ƙara-a-ƙarshe: blah.
}.
Slurp idan: ['amsa:da:'] yi: { :blah :blahah
		(nasa str ≠ ['']) gaskiya: {
			nasa str ƙara-a-ƙarshe: [' '].
		}.
		(blah tsawo > 1) gaskiya: {
			nasa str ƙara-a-ƙarshe: (blah daga: 0 tsawo: (blah tsawo - 1)).
		}, in-ba-haka-ba: {
			nasa str ƙara-a-ƙarshe: blah.
		}.
		nasa str ƙara-a-ƙarshe: [' '].
		nasa str ƙara-a-ƙarshe: blahah.
}.
Slurp idan: ['obtain'] yi: {
	>> buffer := nasa str.
	nasa str := ['']. <- buffer.
}.


>> sigogin-nema := Slurp sabo
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

Fitarwa rubuta: sigogin-nema obtain, sabon-layi.
