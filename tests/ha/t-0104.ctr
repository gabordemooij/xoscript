
{ :i
	Fitarwa rubuta: ['This is step #'] + ( ( i ) + 1 ), sabon-layi.
} × 6.

{ :i
	Fitarwa rubuta: ['This is step #'] + ( 3 - ( i ) ), sabon-layi.
} × 6.

{ :i
	Fitarwa rubuta: ['NEVER!'], sabon-layi.
} × 0.



{ :i
	Fitarwa rubuta: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), sabon-layi.
} × 11.
