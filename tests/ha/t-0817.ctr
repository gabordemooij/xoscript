# a value ending in the first part of an opening quote must survive serialization
>> ƙimomi := Jeri sabo
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

ƙimomi kowane: { :i :value
	>> d := Ƙamus sabo.
	d sanya: value a: ['k'].
	d sanya: ['second'] a: ['j'].
	>> r := d lamba-tsari abu.
	Fitarwa rubuta: r ƙidaya, sabon-layi.
	Fitarwa rubuta: ( (r a: ['k']) = value ), sabon-layi.
}.
