Server init.
>> f := Tsari sabo: ['%d'].
>> a := Blob sabo: 4.
a bytes: ( Jeri sabo ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob sabo: 4.
b bytes: ( Jeri sabo ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a daga: 0 tsawo: 3, kowane: { :i :byte
	Fitarwa rubuta: ( f aiwatar-cikakkiyar-lamba: byte ), sabon-layi.
}.
a ^ b.
a daga: 0 tsawo: 3, kowane: { :i :byte
	Fitarwa rubuta: ( f aiwatar-cikakkiyar-lamba: byte ), sabon-layi.
}.
a ^ b.
a daga: 0 tsawo: 3, kowane: { :i :byte
	Fitarwa rubuta: ( f aiwatar-cikakkiyar-lamba: byte ), sabon-layi.
}.
a saki.
b saki.

{ a ^ Abu. } kama: { :e Fitarwa rubuta: e, sabon-layi. }, fara.
