

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Shiri sarrafa-ƙwaƙwalwa: 0.

{ :i Fitarwa rubuta: i. } × 4.
Fitarwa sabon-layi.
{ :i Fitarwa rubuta: (4 - i). } × 4.
Fitarwa sabon-layi.
( 1 > 2 ) ƙarya: { Fitarwa rubuta: ['BLOCK 1'], sabon-layi. }.
( 2 > 1 ) gaskiya:  { Fitarwa rubuta: ['BLOCK 2'], sabon-layi. }.

>> i := 0.
{ Fitarwa rubuta: i. i ƙara: 1. } muddin: { <- ( i < 3). }.
Fitarwa sabon-layi.

i := 3.
{ Fitarwa rubuta: i. i := i - 1. } muddin: { <- ( i > 0). }.
Fitarwa sabon-layi.


Shiri tsaftace.

usedMemory1 := (Shiri ƙwaƙwalwa ? 0).


{ :i  Fitarwa rubuta: i. } × 4.
Fitarwa sabon-layi.
{ :i  Fitarwa rubuta: (4 - i). } × 4.
Fitarwa sabon-layi.
( 1 > 2 ) ƙarya: { Fitarwa rubuta: ['BLOCK 1'], sabon-layi. }.
( 2 > 1 ) gaskiya:  { Fitarwa rubuta: ['BLOCK 2'], sabon-layi. }.

>> i := 0.
{ Fitarwa rubuta: i. i ƙara: 1. } muddin: { <- ( i < 3). }.
Fitarwa sabon-layi.

i := 3.
{ Fitarwa rubuta: i. i := i - 1. } muddin: { <- ( i > 0). }.
Fitarwa sabon-layi.



Shiri tsaftace.
usedMemory2 := (Shiri ƙwaƙwalwa ? 0).


{ :i Fitarwa rubuta: i. } × 4.
Fitarwa sabon-layi.
{ :i Fitarwa rubuta: (4 - i). } × 4.
Fitarwa sabon-layi.
( 1 > 2 ) ƙarya: { Fitarwa rubuta: ['BLOCK 1'], sabon-layi. }.
( 2 > 1 ) gaskiya:  { Fitarwa rubuta: ['BLOCK 2'], sabon-layi. }.

>> i := 0.
{ Fitarwa rubuta: i. i ƙara: 1. } muddin: { <- ( i < 3). }.
Fitarwa sabon-layi.

i := 3.
{ Fitarwa rubuta: i. i := i - 1. } muddin: { <- ( i > 0). }.
Fitarwa sabon-layi.

Shiri tsaftace.
usedMemory3 := (Shiri ƙwaƙwalwa ? 0).



( usedMemory1 = usedMemory2 da: usedMemory1 = usedMemory3, da: usedMemory2 = usedMemory3 ) gaskiya: {
	Fitarwa rubuta: ['No memory leaks here'].
}, ƙarya: {
	Fitarwa rubuta: ['Leaking memory...'].
}.
