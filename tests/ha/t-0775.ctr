Fitarwa rubuta: ['Test object'], sabon-layi.
>> l := Jeri sabo ; 1 ; ( Jeri sabo ; (Lokaci sabo: 1) ; (Int64 daga-rubutu: ['321']) ; (Jeri sabo ; 3)).
Fitarwa rubuta: l, sabon-layi.
>> old-lst-address := l samfuri adireshin-ƙwaƙwalwa.
l save-as: ['/tmp/a.bin'].
Fitarwa rubuta: ['========== RELOADING SNAP:'], sabon-layi.
>> b := Abu load-from: ['/tmp/a.bin'].
(b samfuri adireshin-ƙwaƙwalwa = old-lst-address) gaskiya: {
	Fitarwa rubuta: ['Object link re-attached.'], sabon-layi.
}.
Fitarwa rubuta: b, sabon-layi.
