
Rubutu idan: ['evaluate'] yi: {
	>> lamba-tsari := Fayil sabo: ['/tmp/eval.ctr'].
	lamba-tsari rubuta: (kai rubutu + ['.']).
	Shiri yi-amfani: ['/tmp/eval.ctr'].
}.

>> map :=
	(Ƙamus sabo)
	sanya: ['Hi There'] a: ['two'],
	sanya: (Jeri ← ['hello'] ; ['world'] ; (Jeri ← 1 ; 2; 9) ; Ƙarya) a: ['one'],
	sanya: ( (Ƙamus sabo) sanya: ['wrrld'] a: ['misspelled'] ) a: ['three'],
	sanya: (Jeri ← ((Ƙamus sabo) sanya: ['treasure'] a: ['hidden']) ; 2) a: ['four']. 
>> str := map rubutu.
>> map2 := Babu.
(['map2 := '] + str ) evaluate.
Fitarwa rubuta: map2 ? ['one'] ? 0.
Fitarwa rubuta: map2 ? ['one'] ? 1.
Fitarwa rubuta: map2 ? ['four'] ? 0 ? ['hidden'].
Fitarwa rubuta: map2 ? ['one'] ? 2 ? 2.
