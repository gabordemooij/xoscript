>> winery := { <- (	Ƙamus sabo
		sanya: 2 a: ['merlot'],
		sanya: 3 a: ['malbec'],
		sanya: 4 a: ['syrah']
	).
}.

Fitarwa rubuta: (((winery fara) - ['nothing']) ƙidaya), sabon-layi.
Fitarwa rubuta: (((winery fara) - ['merlot']) ƙidaya), sabon-layi.
Fitarwa rubuta: (((winery fara) - ['malbec']) ƙidaya), sabon-layi.
Fitarwa rubuta: (((winery fara) - ['syrah']) ƙidaya), sabon-layi.
Fitarwa rubuta: (((winery fara) - ['merlot'] - ['malbec']) ƙidaya), sabon-layi.
Fitarwa rubuta: (((winery fara) - ['merlot'] - ['syrah']) ƙidaya), sabon-layi.
Fitarwa rubuta: (((winery fara) - ['malbec'] -['syrah']) ƙidaya), sabon-layi.
Fitarwa rubuta: (((winery fara) - ['malbec'] - ['syrah'] - ['merlot']) ƙidaya), sabon-layi.

