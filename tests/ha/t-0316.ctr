>> Grandfather := Abu sabo.
Grandfather idan: ['greet'] yi: {
	Fitarwa rubuta: ['Ave!'], sabon-layi.
}.
>> Father := Grandfather sabo.
Father idan: ['greet'] yi: {
	Fitarwa rubuta: ['Hello'], sabon-layi.
	kai greet.
}.
>> Son := Father sabo.
Son idan: ['greet'] yi: {
	Fitarwa rubuta: ['Hi'], sabon-layi.
	kai greet.
}.

Son greet.

>> Roundabout := Abu sabo.
Roundabout idan: ['circle:'] yi: { :x
	Fitarwa rubuta: x, sabon-layi.
	(x < 3) gaskiya: { kai maimaita-kai circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) gaskiya: { Fitarwa rubuta: x, sabon-layi. x ƙara: 1.  increment fara. }. }.
increment fara.