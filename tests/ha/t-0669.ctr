# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Asusu 
	hash-kalmar-sirri: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Asusu 
	hash-kalmar-sirri: hash tabbatar: a1.
	# fail 
>> b := Asusu
	hash-kalmar-sirri: hash tabbatar: a2.
	# ok!

Fitarwa rubuta: a, sabon-layi.
Fitarwa rubuta: b, sabon-layi.

