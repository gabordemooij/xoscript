>> map1 := Ƙamus sabo.
>> key1 := Jeri sabo.
>> key2 := Jeri sabo.

map1
	sanya: ['hello'] a: key1,
	sanya: ['world'] a: key2.


Fitarwa
	rubuta: ['Map #1 contains: '] + (map1 a: key1),
	rubuta: [' and '] + (map1 a: key2), sabon-layi.

>> KeyeableArray := Jeri sabo.
KeyeableArray idan: ['toString'] yi: { <- (kai ƙidaya) toString.
}.

>> map2 := Ƙamus sabo.
key1 := KeyeableArray sabo.
key2 := KeyeableArray sabo.

key1 ƙara-a-ƙarshe: 1.

map2
	sanya: ['hello'] a: key1,
	sanya: ['world'] a: key2.

Fitarwa
	rubuta: ['Map #2 contains: '] + (map2 a: key1),
	rubuta: [' and '] + (map2 a: key2), sabon-layi.
