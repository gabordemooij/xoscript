Fitarwa rubuta: ((Jeri sabo
	idan: ['plaque:'] yi: { :x nasa o := x. },
	idan: ['plaque']  yi: { <- nasa o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Jeri ← 1)
	~ (Jeri ← 1 ; 2)
	~ (Jeri ← 1 ; 2 ; 3)
	~ (Jeri ← 1 ; 2 ; 3 ; 4)
	~ (Jeri ← 1 ; 2 ; 3 ; 4 ; 5)
) kowane: { :i :el
	{ Fitarwa rubuta: wannan-aiki. } × el ƙidaya.
	Fitarwa sabon-layi.
}) plaque, sabon-layi.


