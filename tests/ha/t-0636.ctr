# test url parsing

Server init.
>> url := URL daga-tushe: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Fitarwa rubuta: ['scheme = '] + url tsarin-adireshi, sabon-layi.
Fitarwa rubuta: ['host = '] + url mai-masauki, sabon-layi.
Fitarwa rubuta: ['port = '] + url tashar, sabon-layi.
Fitarwa rubuta: ['path = '] + url hanyar-fayil, sabon-layi.
Fitarwa rubuta: ['query = '] + url sigogin-nema, sabon-layi.
Fitarwa rubuta: ['fragment = '] + url guntu, sabon-layi.
