

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Shiri sarrafa-ƙwaƙwalwa: 0.

Lamba idan: ['addNum:'] yi: { :x
	kai ƙara: x.
}.

Lamba idan: ['subtractNum:'] yi: { :x
	kai rage: x.
}.

Lamba idan: ['multiplyBy:'] yi: { :x
	kai ninka-da: x.
}.

Lamba idan: ['divideBy:'] yi: { :x
	kai raba-da: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 ƙarfi: 8).  
a := a + (2 ƙarfi: -1). 
a := a + (49 tushen-murabbaʼi).   
a addNum: ((Jeri ← 0 ; 1) mafi-girma).          
a addNum: ((Jeri ← 2 ; 3) mafi-ƙanƙanta).
Fitarwa rubuta: a.

Shiri tsaftace.

usedMemory1 := (Shiri ƙwaƙwalwa ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 ƙarfi: 8).  
a := a + (2 ƙarfi: -1). 
a := a + (49 tushen-murabbaʼi).   
a addNum: ((Jeri ← 0 ; 1) mafi-girma).          
a addNum: ((Jeri ← 2 ; 3) mafi-ƙanƙanta).
Fitarwa rubuta: a.

Shiri tsaftace.
usedMemory2 := (Shiri ƙwaƙwalwa ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 ƙarfi: 8).  
a := a + (2 ƙarfi: -1). 
a := a + (49 tushen-murabbaʼi).   
a addNum: ((Jeri ← 0 ; 1) mafi-girma).          
a addNum: ((Jeri ← 2 ; 3) mafi-ƙanƙanta).
Fitarwa rubuta: a.

Shiri tsaftace.
usedMemory3 := (Shiri ƙwaƙwalwa ? 0).



( usedMemory1 = usedMemory2 da: usedMemory1 = usedMemory3, da: usedMemory2 = usedMemory3 ) gaskiya: {
	Fitarwa rubuta: ['No memory leaks here'].
}, ƙarya: {
	Fitarwa rubuta: ['Leaking memory...'].
}.
