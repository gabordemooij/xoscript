


>> wine := Abu sabo.


wine idan: ['toString'] yi: { <- ['merlot'].
}.

wine idan: ['naarTekst'] yi: { <- ['merlot'].
}.


wine idan: ['='] yi: { :other wine <- ( kai toString = other wine ).
}.

wine idan: ['=='] yi: { :other wine <- ( kai toString = other wine ).
}.



wine
	yanayi: ['cabernet'] yi: { Fitarwa rubuta: ['it's a Cabernet!']. },
	yanayi: ['syrah']    yi: { Fitarwa rubuta: ['it's a Syrah!'].    },
	yanayi: ['merlot']   yi: { Fitarwa rubuta: ['it's a Merlot!'].   },
	yanayi: ['malbec']   yi: { Fitarwa rubuta: ['it's a Malbec!'].   }.

Fitarwa sabon-layi.
