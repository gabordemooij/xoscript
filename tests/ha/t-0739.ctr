Fitarwa rubuta: ['Test object'], sabon-layi.
>> a := Abu sabo. 

a idan: ['item:'] yi: { :binhelper
	nasa binhelper := binhelper. 
}.

a idan: ['item'] yi: { <- nasa binhelper.
}.

a item: Bin sabo.

>> old-binhelper-address := a item samfuri adireshin-ƙwaƙwalwa.
a save-as: ['/tmp/a.bin'].
Fitarwa rubuta: ['========== RELOADING SNAP:'], sabon-layi.

>> b := Abu load-from: ['/tmp/a.bin'].

(b item samfuri adireshin-ƙwaƙwalwa = old-binhelper-address) gaskiya: {
	Fitarwa rubuta: ['Object link re-attached.'], sabon-layi.
}.


