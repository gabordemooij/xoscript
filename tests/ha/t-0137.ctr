>> usedMemory5 := (Shiri ƙwaƙwalwa ? 0).




(usedMemory1 = usedMemory2 = usedMemory3 = usedMemory4 = usedMemory5) gaskiya: {
	Fitarwa rubuta: ['Memory usage remains stable.'], sabon-layi.
}, in-ba-haka-ba: {
	Fitarwa rubuta: ['Used memory not stable.'], sabon-layi.
	Fitarwa rubuta: usedMemory1, sabon-layi.
	Fitarwa rubuta: usedMemory2, sabon-layi.
	Fitarwa rubuta: usedMemory3, sabon-layi.
