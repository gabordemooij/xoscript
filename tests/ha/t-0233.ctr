
>> Slurp := Abu sabo.

Slurp idan: ['sabo'] yi: {
	nasa str := [''].
}.

Slurp idan: ['amsa:'] yi: { :blah
		(nasa str = ['']) gaskiya: {
			nasa str ƙara-a-ƙarshe: blah.
		}, in-ba-haka-ba: {
			nasa str ƙara-a-ƙarshe: [' '].
			nasa str ƙara-a-ƙarshe: blah.
		}.
}.

Slurp idan: ['amsa:da:'] yi: { :blah :blahah
		(blah tsawo > 1) gaskiya: {
			nasa str ƙara-a-ƙarshe: (blah daga: 0 tsawo: (blah tsawo - 1)).
		}, in-ba-haka-ba: {
			nasa str ƙara-a-ƙarshe: blah.
		}.
		nasa str ƙara-a-ƙarshe: [' '].
		nasa str ƙara-a-ƙarshe: blahah.
}.

Slurp idan: ['obtain'] yi: {
	>> buffer := nasa str.
	nasa str := ['']. <- buffer.
}.

Fitarwa rubuta: ( Shiri tsarin-aiki: ( Slurp sabo echo hello world obtain ) ).
