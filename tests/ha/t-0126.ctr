#Linux
>> Slurp := Abu sabo.

Slurp idan: ['sabo'] yi: {
	nasa str := [''].
}.

Slurp idan: ['nieuw'] yi: {
	nasa str := [''].
}.

Slurp idan: ['amsa:'] yi: { :blah
		nasa str ƙara-a-ƙarshe: blah.
}.

Slurp idan: ['amsa:da:'] yi: { :blah :blahah
		nasa str ƙara-a-ƙarshe: (blah daga: 0 tsawo: (blah tsawo - 1)).
		nasa str ƙara-a-ƙarshe: [' '].
		nasa str ƙara-a-ƙarshe: blahah.
}.

Slurp idan: ['obtain'] yi: {
	>> buffer := nasa str.
	nasa str := ['']. <- buffer.
}.


Fitarwa rubuta: (Shiri tsarin-aiki: (Slurp sabo echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Fayil sabo: ['/tmp/from.txt'], goge. } kama: { ['Empty']. }, fara.
{ Fayil sabo: ['/tmp/to.txt'], goge. } kama: { ['Empty']. }, fara.


Fayil sabo: ['/tmp/to.txt'], akwai ƙarya: {
	Fitarwa rubuta: ['Confirmed. Target file does not exist.\
'].
}.
Fayil sabo: ['/tmp/from.txt'], akwai ƙarya: {
	Fitarwa rubuta: ['Confirmed. Source file does not exist.\
'].
}.



Shiri tsarin-aiki: (Slurp sabo touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Shiri tsarin-aiki: (Slurp sabo cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Fayil sabo: ['/tmp/to.txt'], akwai gaskiya: {
	Fitarwa rubuta: ['Confirmed. Target file has been created by shell.\
'].
}.


Fitarwa rubuta: ['Contents of file is:'] + (Fayil sabo: ['/tmp/to.txt'], karanta), sabon-layi.
