Server init.

>> DB := Maria-DB sabo mai-masauki: ['localhost'],
	sunan-mai-amfani: ['xo'],
	kalmar-sirri: ['pass123'],
	sunan-rumbun-bayanai: ['xobase'],
	haɗu.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB tambaya: SQL.

# now you don't have to set DB
query2 ɗauko: { :row
	Fitarwa rubuta: row world, sabon-layi.
}.
