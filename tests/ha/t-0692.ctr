Server init.

Fitarwa rubuta: (
	Salo sabo: ['^\\w+$'],
	dacewa: ['test@example.com'] 
), sabon-layi. # 0 match, fails on @ and .

Fitarwa rubuta: (
	Salo sabo: ['^[^@]+@[^\.]+\.\\w+$'],
	dacewa: ['test@example.com'] 
), sabon-layi. # 1 match

Fitarwa rubuta: (
	Salo sabo: ['[^@]+@[^\.]+\.\\w+'],
	dacewa: ['test@example.com'] 
), sabon-layi. # 1 match

Fitarwa rubuta: (
	Salo sabo: ['([^@]+)@([^\.]+)\.\\w+'],
	dacewa: ['test@example.com'] 
), sabon-layi. # 1 match, groups dont matter

Fitarwa rubuta: (
	Salo sabo: ['[a-z]'],
	dacewa: ['test@example.com'] 
), sabon-layi. # 14 matches

Fitarwa rubuta: (
	Salo sabo: ['.*'],
	dacewa: ['test@example.com'] 
), sabon-layi. # 1 match (all)

Fitarwa rubuta: (
	Salo sabo: ['(.*)'],
	dacewa: ['test@example.com'] 
), sabon-layi. # 1 match (all)

Fitarwa rubuta: (
	Salo sabo: ['\\s*[^@]+@[^\.]+\.\\w+'],
	dacewa: ['test@example.com'] 
), sabon-layi. # 1 match, prefix space optional, gets ignored