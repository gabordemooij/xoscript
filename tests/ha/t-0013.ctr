
>> Animal := Abu sabo.
Animal idan: ['sabo'] yi: { <- kai sabo init.
}.

Animal idan: ['init'] yi: {
	nasa sound := ['?'].
	nasa legs := 4.
}.

>> Dog := Animal sabo.
Dog idan: ['init'] yi: {
	kai init.
	nasa sound := ['barks'].
}.

Animal idan: ['rubutu'] yi: { <- nasa legs rubutu + nasa sound.
}.

>> poodle := Dog sabo.
Fitarwa rubuta: poodle, sabon-layi.

