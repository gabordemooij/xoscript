['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Fitarwa rubuta: (x + y), sabon-layi.

>> x := 10040.07.
>> y := 10305.60.

Fitarwa rubuta: (x + y), sabon-layi.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Fitarwa rubuta: (x + y + z), sabon-layi.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Fitarwa rubuta: (x + y + z), sabon-layi.

>> q := 0.1.2.

Fitarwa rubuta: (q), sabon-layi.

>> q := 012.

Fitarwa rubuta: (q), sabon-layi.
