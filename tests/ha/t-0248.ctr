

Rubutu idan: ['evaluate'] yi: {
	>> lamba-tsari := Fayil sabo: ['/tmp/eval.ctr'].
	lamba-tsari rubuta: kai rubutu + ['.'].
	Shiri yi-amfani: ['/tmp/eval.ctr'].
}.

>> a := (Jeri ← (
	(Ƙamus sabo)
		sanya: ['domain'] a: ['mywebsite.com'],
		sanya: (Jeri ←
			((Ƙamus sabo)
				sanya: ['home'] a: ['title'],
				sanya: ['<html></html>'] a: ['body'],
				sanya: ['2017-01-01'] a: ['created']
			) ;
			((Ƙamus sabo)
				sanya: ['aboutus(c)'] a: ['title'],
				sanya: ['<credits>Author Inc.</credits>'] a: ['body']
			)
		) a: ['pages']
	)
) rubutu.

Fitarwa rubuta: a nauʼi, sabon-layi.
Fitarwa rubuta: a, sabon-layi.

>> b := Babu.
(['b := '] + a) evaluate.
Fitarwa rubuta: b ? 0 ? ['pages'] ? 1 ? ['body'], sabon-layi.

>> c := b ? 0.
>> d := c rubutu.
Fitarwa rubuta: d nauʼi, sabon-layi.

>> e := Babu.
(['e := '] + d) evaluate.
Fitarwa rubuta: e ? ['pages'] ? 0, sabon-layi.
