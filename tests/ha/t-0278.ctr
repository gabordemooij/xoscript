>> To-Do := Abu sabo.

To-Do idan: ['sabo'] yi: {
	nasa list := Jeri sabo.
}.

To-Do idan: ['nieuw'] yi: {
	nasa list := Jeri sabo.
}.

To-Do idan: ['+'] yi: { :task
	nasa list ƙara-a-ƙarshe: task.
}.

To-Do idan: ['number of tasks?'] yi: { <-  nasa list ƙidaya.
}.

>> todos := 
	To-Do sabo 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Fitarwa rubuta: ['You have $ tasks to do'] $ todos number of tasks?.
