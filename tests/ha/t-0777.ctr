#OBSD
>> dirname := [''].
{ dirname ƙara-a-ƙarshe: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Shiri tsarin-aiki: command.
Shiri chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename ƙara-a-ƙarshe: ['YYYYYYYY']. } * 20.
Fayil sabo: filename, rubuta: ['sometext'].
{ Fayil jeri: ['/tmp/'] + dirname. } * 1000.
Fitarwa rubuta: ['no crash'], sabon-layi.

