# compliance test

# use international numbers

Fitarwa rubuta: ['1000 -> '].
Fitarwa rubuta: 1000, sabon-layi. #1000

Fitarwa rubuta: ['1.5 -> '].
Fitarwa rubuta: 1.5, sabon-layi.  #1.5

Fitarwa rubuta: ['1001.5 -> '].
Fitarwa rubuta: 1.5 + 1000, sabon-layi. #1001.5

# use 0-indexed arrays
>> x := Jeri sabo ; 1 ; 2 ; 3.
>> y := Jeri sabo ; ['a'] ; ['b'] ; ['c'].

Fitarwa rubuta: ['1 -> '].
Fitarwa rubuta: x ? 0, sabon-layi. #1

Fitarwa rubuta: ['1 -> '].
Fitarwa rubuta: (x a: 0), sabon-layi. #1

Fitarwa rubuta: ['1 -> '].
Fitarwa rubuta: x na-farko, sabon-layi. #1

Fitarwa rubuta: ['3 -> '].
Fitarwa rubuta: x na-ƙarshe, sabon-layi. #3

Fitarwa rubuta: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Fitarwa rubuta: (x bisa: y), sabon-layi.

Fitarwa rubuta: ['1 -> '].
Fitarwa rubuta: (x daga: 0 tsawo: 1) na-farko, sabon-layi. #1

Fitarwa rubuta: ['0 -> '].
Fitarwa rubuta: (x samu: 1), sabon-layi. #0

x sanya: 9 a: 0.

Fitarwa rubuta: ['9 -> '].
Fitarwa rubuta: (x a: 0), sabon-layi. #9

x ƙara-a-farko: 8.
Fitarwa rubuta: ['8 -> '].
Fitarwa rubuta: (x a: 0), sabon-layi. #9


x ƙara-a-ƙarshe: 10.
Fitarwa rubuta: ['10 -> '].
Fitarwa rubuta: (x a: 4), sabon-layi. #10








