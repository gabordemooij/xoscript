#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Shiri sarrafa-ƙwaƙwalwa: 0.

{
Lokaci lokaci.
Lokaci jira: 1.
Fitarwa rubuta: Shiri adadin-hujjoji, sabon-layi.
Shiri hujja: 0.
Lamba random.
Fitarwa rubuta: (Shiri tsarin-aiki: ['echo 'Hello'']).
} fara.

Shiri tsaftace.
usedMemory1 := (Shiri ƙwaƙwalwa ? 0).

{
Lokaci lokaci.
Lokaci jira: 1.
Fitarwa rubuta: Shiri adadin-hujjoji, sabon-layi.
Shiri hujja: 0.
Lamba random.
Fitarwa rubuta: (Shiri tsarin-aiki: ['echo 'Hello'']).
} fara.

Shiri tsaftace.
usedMemory2 := (Shiri ƙwaƙwalwa ? 0).

{
Lokaci lokaci.
Lokaci jira: 1.
Fitarwa rubuta: Shiri adadin-hujjoji, sabon-layi.
Shiri hujja: 0.
Lamba random.
Fitarwa rubuta: (Shiri tsarin-aiki: ['echo 'Hello'']).
} fara.

Shiri tsaftace.
usedMemory3 := (Shiri ƙwaƙwalwa ? 0).



( usedMemory1 = usedMemory2 da: usedMemory1 = usedMemory3, da: usedMemory2 = usedMemory3 ) gaskiya: {
	Fitarwa rubuta: ['No memory leaks here'].
}, ƙarya: {
	Fitarwa rubuta: ['Leaking memory...'].
}.
