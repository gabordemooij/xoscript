# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Salo sabo: pattern.
	p dacewa: subject yi: { :m :g
		Fitarwa rubuta: g ƙidaya, rubuta: [' '], rubuta: (g haɗa: ['|']), sabon-layi. <- m.
	}.
}.
show aiwatar: ['(a)|(b)'] da: ['b'].
show aiwatar: ['(a)|(b)'] da: ['a'].
show aiwatar: ['(x)?y'] da: ['y'].
show aiwatar: ['(x)?(y)(z)?'] da: ['xy'].
