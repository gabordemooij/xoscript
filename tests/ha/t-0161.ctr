Shiri sarrafa-ƙwaƙwalwa: 0.
Jeri idan: ['sum'] yi: {
	>> total := 0.
	kai kowane: { :index :element
		total ƙara: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Fayil sabo: ['/tmp/test.txt'].
f rubuta: ['Lorem Ipsum'].
f rufe.
  

f := Fayil sabo: ['/tmp/test.txt'].
>> text := f karanta.
f rufe.



Shiri tsaftace.
usedMemory1 := (Shiri ƙwaƙwalwa ? 1).



f := Fayil sabo: ['/tmp/test.txt'].
text := f karanta.
f rufe.

Shiri tsaftace.
usedMemory2 := (Shiri ƙwaƙwalwa ? 1).


f := Fayil sabo: ['/tmp/test.txt'].
text := f karanta.
f rufe.

Shiri tsaftace.
usedMemory3 := (Shiri ƙwaƙwalwa ? 1).



( usedMemory1 = usedMemory2 da: usedMemory1 = usedMemory3, da: usedMemory2 = usedMemory3 ) gaskiya: {
	Fitarwa rubuta: ['No memory leaks here'].
}, ƙarya: {
	Fitarwa rubuta: ['Leaking memory...'].
}.
