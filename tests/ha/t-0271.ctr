
Shiri sarrafa-ƙwaƙwalwa: 1.
Shiri ƙwaƙwalwa: 16000000.
>> tokens := ['{}↲.:,x() '].
{ :i
	>> lamba-tsari := [''].
	>> x := Lamba tsakanin: 1 da: 10.
	{
		>> y := Lamba tsakanin: 1 da: (tokens tsawo).
		lamba-tsari ƙara-a-ƙarshe: (tokens harafi: y).
	} × x.
	{ Aiki sabo: lamba-tsari. } kama: { ['Empty']. }, fara.

} × 10000.
Fitarwa rubuta: ['OK'], sabon-layi.
