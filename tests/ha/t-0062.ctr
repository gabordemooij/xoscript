Boolean idan: ['xor:'] yi: { :a :b <- ((a da: b akasi) ko: (a akasi da: b)).
}.

>> o := Abu sabo.
o idan: ['hello'] yi: { ['Empty']. }.
{ o idan: 2 yi: 3.} kama: { :e Fitarwa rubuta: e, sabon-layi. }, fara.
{ o idan: ['gwaji'] yi: 3.} kama: { :e Fitarwa rubuta: e, sabon-layi. }, fara.
{ o idan: ['hello'] yi: { ['Empty']. }.} kama: { :e Fitarwa rubuta: e, sabon-layi. }, fara. 
{ >> z := 4 ÷ 0. } kama: { :e Fitarwa rubuta: e, sabon-layi. }, fara. 
{ (Gaskiya da: Babu) gaskiya: { Fitarwa rubuta: ['X'].}. } kama: { :e Fitarwa rubuta: e, sabon-layi. }, fara. 
{ ([''] xor: 0) gaskiya: { Fitarwa rubuta: ['X'].}. } kama: { :e Fitarwa rubuta: e, sabon-layi. }, fara. 
{ (1 < ['2']) gaskiya: { Fitarwa rubuta: ['OK']. }. } kama: { :e Fitarwa rubuta: e, sabon-layi. }, fara. 
{ (1 < ['2.0']) gaskiya: { Fitarwa rubuta: ['OK']. }. } kama: { :e Fitarwa rubuta: e, sabon-layi. }, fara. 
{ (1 < ['x2.0']) gaskiya: { Fitarwa rubuta: ['NO!']. }. } kama: { :e Fitarwa rubuta: e, sabon-layi. }, fara. 
{ Fitarwa rubuta: (['hello OK there'] daga: ['6'] tsawo: ['2']). } fara. 
