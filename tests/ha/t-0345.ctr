# test catch-all methods
>> x13 := Abu sabo.
x13 idan: ['a'] yi: { :a Fitarwa rubuta: 0, sabon-layi. }.
x13 idan: ['a:'] yi: { :a Fitarwa rubuta: a, sabon-layi. <- 5. }.
x13 idan: ['a:b:'] yi: { :a :b Fitarwa rubuta: (a + b), sabon-layi. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
