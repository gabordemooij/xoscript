
Fitarwa rubuta: ['Break for-loop, 0-4.'], sabon-layi.
{ :i
	Fitarwa rubuta: ['iteration #'] + i, sabon-layi.
	(i = 4) katse.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Fitarwa rubuta: ['Break while-true loop, 0-4.'], sabon-layi.
{
	Fitarwa rubuta: ['iteration #'] + x, sabon-layi.
	x ƙara: 1.
	((x < 5) akasi) katse.
} muddin: xIsLessThan10.

Fitarwa rubuta: ['Break while-false loop, 5,4.'], sabon-layi.
{
	Fitarwa rubuta: ['iteration #'] + x, sabon-layi.
	x rage: 1.
	(x = 3) katse.
} muddin: { <- (x > 0). }.

Fitarwa rubuta: ['Break times loop, 1-4.'], sabon-layi.
{ :i
	Fitarwa rubuta: ['iteration #'] + i, sabon-layi.
	(i = 4) katse.
} × 5.

Fitarwa rubuta: ['Break block, dont print line.'], sabon-layi.
{ Gaskiya katse. Fitarwa rubuta: ['dont write this!'], sabon-layi. } fara.

Fitarwa rubuta: ['Break block, dont fire catch...'], sabon-layi.
{ Gaskiya katse. Fitarwa rubuta: ['dont write this!'], sabon-layi. } kama: { Fitarwa rubuta: ['Dont catch this!']. }, fara.

Fitarwa rubuta: ['Test Array each-loop: 0,1'], sabon-layi.
(Jeri ← 1 ; 2 ; 3) canza-kowane: { :i
	Fitarwa rubuta: ['iteration #'] + i, sabon-layi.
	(i = 1) katse.
}.

Fitarwa rubuta: ['Test Map each-loop: c only'], sabon-layi.
>> m := Ƙamus sabo.
m sanya: ['first'] a: ['a'], sanya: ['second'] a: ['b'], sanya: ['third'] a: ['c'].
m kowane: { :k :v
	Fitarwa rubuta: ['iteration'] + v + k, sabon-layi.
	Gaskiya katse.
}.

