Fitarwa rubuta: ['Test object'], sabon-layi.
>> cmd := Umarni sabo.
Fitarwa rubuta: cmd ls /tmp, sabon-layi.
>> old-cmd-address := cmd samfuri adireshin-ƙwaƙwalwa.
cmd save-as: ['/tmp/a.bin'].
Fitarwa rubuta: ['========== RELOADING SNAP:'], sabon-layi.
>> b := Abu load-from: ['/tmp/a.bin'].
(b samfuri adireshin-ƙwaƙwalwa = old-cmd-address) gaskiya: {
	Fitarwa rubuta: ['Object link re-attached.'], sabon-layi.
}.
Fitarwa rubuta: b ls, sabon-layi.


