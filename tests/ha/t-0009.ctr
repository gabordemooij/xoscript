>> Greeter := Abu sabo.
Greeter idan: ['make'] yi: {
	>> greeter := Abu sabo.
	greeter idan: ['name:'] yi: { :suna
		Fitarwa rubuta: ['setting a name'].
		nasa myName := suna.
	}.
	greeter idan: ['performGreeting'] yi: {
		Fitarwa rubuta: ['Hello'].
		Fitarwa rubuta: nasa myName.
	}.
	greeter idan: ['greet'] yi: {
		kai performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
