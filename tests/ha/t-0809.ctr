# backslashes must survive code serialization, strings must not end early
>> ƙimomi := Jeri sabo
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

ƙimomi kowane: { :i :value
	>> d := Ƙamus sabo.
	d sanya: value a: ['k'].
	>> r := d lamba-tsari abu.
	Fitarwa rubuta: r ƙidaya, sabon-layi.
	Fitarwa rubuta: ( (r a: ['k']) = value ), sabon-layi.
}.
