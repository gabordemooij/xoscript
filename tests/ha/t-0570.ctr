#Linux

 >> t := Lokaci sabo.
 
t yanki: ['Europe/Amsterdam'].
t shekara: 2020, wata: 8, rana: 2, awa: 21, minti: 2, daƙiƙa: 1.

>> a := t awa.
>> ams := t yanki.

t yanki: ['US/Hawaii'].
>> b := t awa.
>> hw := t yanki.

Fitarwa
rubuta: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		ko-dai: ['later'] ko: ['earlier']
	)
),
sabon-layi.
 