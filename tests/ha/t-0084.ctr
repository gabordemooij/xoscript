>> makeAdder := { :x
	>> f := { :y <- (nasa x + y). } saita: ['x'] ƙima: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i nasa q sanya: (nasa f aiwatar: (nasa q ? i)) a: i. } 
	saita: ['q'] ƙima: array,
	saita: ['f'] ƙima: func.
	{ :i mapping aiwatar: i. } × (array ƙidaya).
}.

>> a := Jeri ← 1; 2; 3.
mapper aiwatar: a da: (makeAdder aiwatar: 100).
Fitarwa rubuta: (a matsayi: 0), sabon-layi.
Fitarwa rubuta: (a ? 1), sabon-layi.
Fitarwa rubuta: (a ? 2), sabon-layi.
