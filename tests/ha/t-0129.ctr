
Jeri idan: ['product'] yi: {
	>> total := 1.
	kai kowane: { :index :element
		total ninka-da: element.
	}. <- total.
}.

>> a := Jeri ← 1 ; 2 ; 3.
Fitarwa rubuta: a product, sabon-layi.
Fitarwa rubuta: (Jeri ← 2 ; 4 ; 8) product, sabon-layi. 
Fitarwa rubuta: (Jeri ← -2 ; 10) product, sabon-layi. 
Fitarwa rubuta: (Jeri ← 0.5 ; -2) product, sabon-layi. 
