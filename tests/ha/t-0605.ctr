>> invoice := Abu sabo.
invoice idan: ['fara'] yi: {
        nasa lamba := 0.
}.

invoice idan: ['lamba'] yi: {
        nasa lamba ƙara: 1. <- nasa lamba kwafi.
}.

>> year-invoice := invoice sabo.
year-invoice idan: ['start:'] yi: { :shekara
	nasa lamba := shekara.
}.

year-invoice start: 202000.
Fitarwa rubuta: year-invoice lamba, sabon-layi.
Fitarwa rubuta: year-invoice lamba, sabon-layi.
