>> repeater := Abu sabo.
repeater idan: ['amsa:'] yi: { :what
	Fitarwa rubuta: what + [' '].
}.
repeater idan: ['amsa:da:'] yi: { :what :say
	Fitarwa rubuta: what, rubuta: say + [' '].
}.
repeater idan: ['amsa:da:da:'] yi: { :what :say :more
	Fitarwa rubuta: what, rubuta: say, rubuta: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
