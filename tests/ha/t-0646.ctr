Server init.
Fitarwa rubuta: ['Database datetime test'], sabon-layi.

>> db := Maria-DB sabo mai-masauki: ['localhost'],
	sunan-mai-amfani: ['xo'], 
	kalmar-sirri: ['pass123'],
	sunan-rumbun-bayanai: ['xobase'],
	haɗu.

>> sigogin-nema :=
db tambaya: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
ɗauko: { :row
	Fitarwa rubuta: row datetimetest, sabon-layi.
}.
