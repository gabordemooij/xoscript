

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Shiri sarrafa-ƙwaƙwalwa: 0.

{
>> q := ['You should be able'].
q ƙara-a-ƙarshe: ([' to append something to a string']+['!']).
Fitarwa rubuta: q.
} fara.

Shiri tsaftace.
usedMemory1 := (Shiri ƙwaƙwalwa ? 0).


{
>> q := ['You should be able'].
q ƙara-a-ƙarshe: ([' to append something to a string']+['!']).
Fitarwa rubuta: q.
} fara.

Shiri tsaftace.
