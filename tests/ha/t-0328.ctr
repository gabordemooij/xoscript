Shiri sarrafa-ƙwaƙwalwa: 4.

>> Doubler := Abu sabo.
>> Multiplier := Abu sabo.
Doubler idan: ['double:and:'] yi: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier idan: ['multiply:and:'] yi: { :x :y <- (x × y).
}.

Fitarwa rubuta: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), sabon-layi.
