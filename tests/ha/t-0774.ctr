Fitarwa rubuta: ['Test object'], sabon-layi.
>> a := Abu sabo. 
a idan: ['item:'] yi: { :lst
	nasa lst := lst. 
}.
a idan: ['item'] yi: { <- nasa lst.
}.
a item: (
	Jeri sabo ; 1 ; (
		Jeri sabo ; ['a'] ; (
			Jeri sabo ; ( Lokaci sabo: 1 )
		) ; ( Int64 daga-rubutu: ['321'] )
	)
).
Fitarwa rubuta: a item, sabon-layi.
>> old-lst-address := a item samfuri adireshin-ƙwaƙwalwa.
a save-as: ['/tmp/a.bin'].
Fitarwa rubuta: ['========== RELOADING SNAP:'], sabon-layi.
>> b := Abu load-from: ['/tmp/a.bin'].
(b item samfuri adireshin-ƙwaƙwalwa = old-lst-address) gaskiya: {
	Fitarwa rubuta: ['Object link re-attached.'], sabon-layi.
}.
Fitarwa rubuta: ( b item ), sabon-layi.
