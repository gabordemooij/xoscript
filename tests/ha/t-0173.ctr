

Jeri idan: ['sum'] yi: {
	>> total := 0.
	kai kowane: { :index :element
		total ƙara: element.
	}. <- total.
}.

Jeri idan: ['product'] yi: {
	>> total := 1.
	kai kowane: { :index :element
		total ninka-da: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Shiri sarrafa-ƙwaƙwalwa: 0.

{

>> a := Jeri ← ['hello'] ; ['world'] ; Gaskiya ; Babu ; 666.
a := a + ( Jeri ← 1 ).
Fitarwa rubuta: ( ['sum: '] + ( a sum ) ), sabon-layi.
Fitarwa rubuta: ( ['min: '] + ( a mafi-ƙanƙanta ) ), sabon-layi.
Fitarwa rubuta: ( ['max: '] + ( a mafi-girma ) ), sabon-layi.
Fitarwa rubuta: ( ['3rd: '] + ( a ? 2 ) ), sabon-layi.
Fitarwa rubuta: ( ['prd: '] + ( a product ) ), sabon-layi.
a jera: { :a :b <- (b - a). }.
a kowane: { :i :e Fitarwa rubuta: ( i - 0 ), sabon-layi. }.

} fara.

Shiri tsaftace.
usedMemory1 := (Shiri ƙwaƙwalwa ? 0).


{

>> a := Jeri ← ['hello'] ; ['world'] ; Gaskiya ; Babu ; 666.
a := a + ( Jeri ← 1 ).
Fitarwa rubuta: ( ['sum: '] + ( a sum ) ), sabon-layi.
Fitarwa rubuta: ( ['min: '] + ( a mafi-ƙanƙanta ) ), sabon-layi.
Fitarwa rubuta: ( ['max: '] + ( a mafi-girma ) ), sabon-layi.
Fitarwa rubuta: ( ['3rd: '] + ( a ? 2 ) ), sabon-layi.
Fitarwa rubuta: ( ['prd: '] + ( a product ) ), sabon-layi.
a jera: { :a :b <- (b - a). }.
a kowane: { :i :e Fitarwa rubuta: ( i - 0 ), sabon-layi. }.

} fara.



Shiri tsaftace.
usedMemory2 := (Shiri ƙwaƙwalwa ? 0).


{

>> a := Jeri ← ['hello'] ; ['world'] ; Gaskiya ; Babu ; 666.
a := a + ( Jeri ← 1 ).
Fitarwa rubuta: ( ['sum: '] + ( a sum ) ), sabon-layi.
Fitarwa rubuta: ( ['min: '] + ( a mafi-ƙanƙanta ) ), sabon-layi.
Fitarwa rubuta: ( ['max: '] + ( a mafi-girma ) ), sabon-layi.
Fitarwa rubuta: ( ['3rd: '] + ( a ? 2 ) ), sabon-layi.
Fitarwa rubuta: ( ['prd: '] + ( a product ) ), sabon-layi.
a jera: { :a :b <- (b - a). }.
a kowane: { :i :e Fitarwa rubuta: ( i - 0 ), sabon-layi. }.

} fara.



Shiri tsaftace.
usedMemory3 := (Shiri ƙwaƙwalwa ? 0).

( usedMemory1 = usedMemory2 da: usedMemory1 = usedMemory3, da: usedMemory2 = usedMemory3 ) gaskiya: {
	Fitarwa rubuta: ['No memory leaks here'].
}, ƙarya: {
	Fitarwa rubuta: ['Leaking memory...'].
}.
