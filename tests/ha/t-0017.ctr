Lamba idan: ['factorial'] yi: {
	>> total := 1.
	{ :index total ninka-da: (kai - (index)). } × kai. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Fitarwa rubuta: a.
>> b := 2 + 3 factorial.
Fitarwa rubuta: b.
>> c := 3 factorial + 2.
Fitarwa rubuta: c.
>> d := 2 + (3 factorial).
Fitarwa rubuta: d.
Fitarwa rubuta: 2 + 3 factorial + 1.
