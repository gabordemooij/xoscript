>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Abu sabo.
⚄ idan: ['drawFrom:length:'] yi: { :pool :ƙidaya
	
	>> result := [''].
	
	{
		>> index := Lamba random % (pool tsawo).
		result ƙara-a-ƙarshe: ( pool harafi: (index + 1) ).
		
	} × ƙidaya. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? tsawo.
Fitarwa rubuta: (['x↵'] x random tsawo).
Fitarwa rubuta: (['y↵'] y ?? tsawo).

