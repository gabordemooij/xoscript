Fitarwa rubuta: ['Test object'], sabon-layi.
>> a := Abu sabo. 

a idan: ['item:'] yi: { :moment
	nasa moment := moment. 
}.

a idan: ['item'] yi: { <- nasa moment.
}.

>> today := Jeri sabo ; ( Lokaci sabo yanki: ['CEST'], shekara: 2026, wata: 7 ).
a item: today.
Fitarwa rubuta: a item ? 0, sabon-layi.
a save-as: ['/tmp/a.bin'].
