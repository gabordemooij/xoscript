#...
>> del := conn1 tambaya: ['DELETE FROM book WHERE id > 0'].
{  del zartar. conn1 tabbatar. } kama: { :e conn1 mayar-baya.  }, fara.

>> insert := conn1 tambaya: ['INSERT INTO book (id) VALUES(null)'].
insert zartar.

>> ƙidaya := conn1 tambaya: ['SELECT COUNT(*) AS num FROM book'].
ƙidaya ɗauko: { :row Fitarwa rubuta: row num, sabon-layi. }.

# does not show up
# insert not committed on connection 1
>> ƙidaya := conn2 tambaya: ['SELECT COUNT(*) AS num FROM book'].
ƙidaya ɗauko: { :row Fitarwa rubuta: row num, sabon-layi. }.
