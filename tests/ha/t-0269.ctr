#Linux

(Fayil sabo: ['/tmp/testje']) akwai ƙarya: {
	Shiri tsarin-aiki: ['mkdir /tmp/testje'].	
}.

(Fayil sabo: ['/tmp/testje/file1']) akwai ƙarya: {
	Shiri tsarin-aiki: ['touch /tmp/testje/file1'].	
}.

(Fayil sabo: ['/tmp/testje/folder1']) akwai ƙarya: {
	Shiri tsarin-aiki: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Fayil jeri: ['/tmp/testje'].

>> q := Jeri sabo.

l kowane: { :k :v v kowane: { :x :y q ƙara-a-ƙarshe: y. }. }.

>> s := q rubutu.

(s ya-ƙunshi: ['file1']) gaskiya:   { Fitarwa rubuta: ['OK'], sabon-layi. }.
(s ya-ƙunshi: ['file2']) gaskiya:   { Fitarwa rubuta: ['XX'], sabon-layi. }.
(s ya-ƙunshi: ['folder1']) gaskiya: { Fitarwa rubuta: ['OK'], sabon-layi. }.
