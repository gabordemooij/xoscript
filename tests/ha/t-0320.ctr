


>> CoffeeMachine := Abu sabo.
CoffeeMachine idan: ['order:'] yi: { :id
	>> coffee := ['Americano'].
	( id = 1 ) gaskiya: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) gaskiya: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) gaskiya: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Abu sabo.
SimpleCoffeeMachine idan: ['order'] yi: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Fitarwa rubuta: redCup, sabon-layi.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Fitarwa rubuta: greenCup, sabon-layi.
>> yellowCup := CoffeeMachine order: 1.
Fitarwa rubuta: yellowCup, sabon-layi.
>> blueCup := CoffeeMachine order: 0.
Fitarwa rubuta: blueCup, sabon-layi.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Fitarwa rubuta: blackCup, sabon-layi.
blackCup ƙara-a-ƙarshe: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Fitarwa rubuta: orangeCup, sabon-layi.
