Fitarwa rubuta: ['Test object'], sabon-layi.
>> a := Abu sabo. 
a idan: ['item:'] yi: { :int64
	nasa int64 := int64. 
}.
a idan: ['item'] yi: { <- nasa int64.
}.
a item: ( Int64 daga-rubutu: ['9999'] ).
Fitarwa rubuta: a item, sabon-layi.
>> old-int64-address := a item samfuri adireshin-ƙwaƙwalwa.
a save-as: ['/tmp/a.bin'].
Fitarwa rubuta: ['========== RELOADING SNAP:'], sabon-layi.
>> b := Abu load-from: ['/tmp/a.bin'].
(b item samfuri adireshin-ƙwaƙwalwa = old-int64-address) gaskiya: {
	Fitarwa rubuta: ['Object link re-attached.'], sabon-layi.
}.
Fitarwa rubuta: ( b item ), sabon-layi.
