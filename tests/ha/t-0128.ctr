
Jeri idan: ['sum'] yi: {
	>> total := 0.
	kai kowane: { :index :element
		total ƙara: element.
	}. <- total.
}.

>> a := Jeri ← 9 ; 8 ; 7.
Fitarwa rubuta: (a sum), sabon-layi. 
>> a := Jeri ← 1 ; 9.
Fitarwa rubuta: (a sum), sabon-layi. 
>> a := Jeri ← ['o'] ; 2.
Fitarwa rubuta: (a sum), sabon-layi. 
Fitarwa rubuta: (Jeri sabo sum), sabon-layi. 
