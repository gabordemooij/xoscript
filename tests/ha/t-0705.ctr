

>> obj := Abu sabo.

obj idan: ['greet'] yi: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj idan: ['task'] yi: {
	nasa property := 123.
	{
		# try binds self/own to object instead of block
		Fitarwa rubuta: kai greet.
		Fitarwa rubuta: nasa property.
		1 / 0.
	} kama: {
		Fitarwa rubuta: kai greet.
		Fitarwa rubuta: nasa property.
		Fitarwa rubuta: ['ok'].
	}, gwada.
}.

obj task.