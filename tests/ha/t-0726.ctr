# test buffers PKI/Sign 
Server init.

>> long := ( Jeri sabo cika: 1000 da: ['a'] ) haɗa: [''].

# sign a message
Fitarwa rubuta: ( 
	Asusu sa-hannu: ['abc'] da: long
), sabon-layi.

Fitarwa rubuta: ( 
	Asusu
		duba: ['abc'] 
		sa-hannu: long 
		da: long
), sabon-layi.

Fitarwa rubuta: (
	Asusu hash-kalmar-sirri: long tabbatar: long
), sabon-layi.
