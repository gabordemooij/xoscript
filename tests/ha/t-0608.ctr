
>> Size := Abu sabo.
Size idan: ['is:'] yi: { :lamba
	lamba idan: ['+'] yi: { :lamba
		>> unit := lamba maʼaunin-lamba.
		>> factor := 1.
		
		unit
		yanayi: ['inch'] yi: { factor := 0.0833. }. <- kai + (lamba * factor).
	}. <- lamba.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Fitarwa rubuta: plank + edge, sabon-layi.
