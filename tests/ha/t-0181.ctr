

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Shiri sarrafa-ƙwaƙwalwa: 0.

>> txt := ['World Salad'].
Fitarwa rubuta: ['this text contains: '] + ( ( txt tsaga: [' '] ) ƙidaya ) + [' words.'], sabon-layi.
txt := txt daga: 6 tsawo: 4.
Fitarwa rubuta: txt, sabon-layi.

Shiri tsaftace.

usedMemory1 := (Shiri ƙwaƙwalwa ? 0).


