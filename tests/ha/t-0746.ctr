Fitarwa rubuta: ['Test object'], sabon-layi.
>> a := Abu sabo. 

a idan: ['item:'] yi: { :dict
	nasa dict := dict. 
}.

a idan: ['item'] yi: { <- nasa dict.
}.

a item: (
Ƙamus sabo
	hello: ['world'],
	world: (Ƙamus sabo sanya: ['a'] a: ['b'])).

Fitarwa rubuta: a item, sabon-layi.

>> old-dict-address := a item samfuri adireshin-ƙwaƙwalwa.
a save-as: ['/tmp/a.bin'].
Fitarwa rubuta: ['========== RELOADING SNAP:'], sabon-layi.

>> b := Abu load-from: ['/tmp/a.bin'].

(b item samfuri adireshin-ƙwaƙwalwa = old-dict-address) gaskiya: {
	Fitarwa rubuta: ['Object link re-attached.'], sabon-layi.
}.

Fitarwa rubuta: b item, sabon-layi.
