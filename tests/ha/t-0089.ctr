>> randomizer := { :a :b
	>> mafi-ƙanƙanta := ( a < b ) ko-dai: a ko: b.
	>> mafi-girma := ( a > b ) ko-dai: a ko: b.
	>> x := Babu.
	{
		x := Lamba tsakanin: a da: b.
		((x < mafi-ƙanƙanta) ko: (x > mafi-girma)) gaskiya: { 
			Fitarwa rubuta: (['Invalid value!']).
			Shiri ƙare.
		}.
	} 
	× 100. <- x.
}.
