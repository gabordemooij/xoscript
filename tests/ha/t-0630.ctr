#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Salo sabo: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern dacewa: subject yi: { :m :x
	Fitarwa rubuta: m, sabon-layi.
	Fitarwa rubuta: x, sabon-layi. <- ['XXX'].
}.
Fitarwa rubuta: result, sabon-layi.