>> echo := Abu sabo.
echo idan: ['amsa:'] yi: { :sound
	{ Fitarwa rubuta: sound. } × 2.
}.
echo ho!. 


echo := Abu sabo.
echo idan: ['amsa:da:'] yi: { :sound :x
	{ Fitarwa rubuta: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := Abu sabo.
echo idan: ['amsa:da:da:'] yi: { :operation :sound :x
	{ Fitarwa rubuta: sound. } × x.
}.
echo shout: ['la'] times: 4. 


