>> x := Lokaci sabo.
x yanki: ['CEST'],
shekara:2017,
wata:01,
rana:10,
awa: 10,
minti: 0,
daƙiƙa: 0.

Fitarwa rubuta: x, sabon-layi.

Fitarwa rubuta: x lokaci, sabon-layi.

x ƙara: 1 daƙiƙa.
x ƙara: 2 minti.
x ƙara: 3 awa.
x ƙara: 4 rana.
x ƙara: 1 wata.
x ƙara: 6 shekara.

Fitarwa rubuta: x, sabon-layi.

x rage: 1 daƙiƙa.
x rage: 2 minti.
x rage: 3 awa.
x rage: 4 rana.
x rage: 1 wata.
x rage: 6 shekara.

Fitarwa rubuta: x, sabon-layi.

>> y := x kwafi.
>> z := x.

Fitarwa rubuta: y, sabon-layi.
Fitarwa rubuta: z, sabon-layi.
Fitarwa rubuta: (x yanki = y yanki), sabon-layi.
Fitarwa rubuta: (x lokaci = y lokaci), sabon-layi.
Fitarwa rubuta: (x = z), sabon-layi.
Fitarwa rubuta: x ranar-shekara, sabon-layi.
Fitarwa rubuta: x ranar-mako, sabon-layi.
Fitarwa rubuta: x mako, sabon-layi.
