Fitarwa rubuta: ['Test object'], sabon-layi.
>> p := Hanya /tmp.
Fitarwa rubuta: p, sabon-layi.
>> old-p-address := p samfuri adireshin-ƙwaƙwalwa.
p save-as: ['/tmp/a.bin'].
Fitarwa rubuta: ['========== RELOADING SNAP:'], sabon-layi.
>> b := Abu load-from: ['/tmp/a.bin'].
(b samfuri adireshin-ƙwaƙwalwa = old-p-address) gaskiya: {
	Fitarwa rubuta: ['Object link re-attached.'], sabon-layi.
}.
Fitarwa rubuta: b, sabon-layi.
