>> a := 3.
>> b := a kwafi.
a rage: 1.
Fitarwa rubuta: [' a = '] + a.
Fitarwa rubuta: [' b = '] + b.
a := 3.
b := a + 4.
Fitarwa rubuta: [' a = '] + a.
Fitarwa rubuta: [' b = '] + b.
>> x := 3.
>> y := x kwafi.
x ƙara: 10.
y rage: 1.
Fitarwa rubuta: [' x = '] + x.
Fitarwa rubuta: [' y = '] + y.
>> q := Abu sabo.
q idan: ['setProperty:'] yi: { :x
	nasa prop := x.
}.
q idan: ['getProperty'] yi: { <- nasa prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Fitarwa rubuta: [' p = '] + (p getProperty).
