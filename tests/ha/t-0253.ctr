#Linux
>> OS := Shiri saiti: ['OS'].

>> clock := Lokaci sabo.
	
(OS = ['Haiku']) gaskiya: {
	clock yanki: ['CET'],
	shekara: 2017, wata: 7, rana: 13,
	awa: 18, minti: 0, daƙiƙa: 0.
}, in-ba-haka-ba: {
	clock yanki: ['Europe/Amsterdam'],
	shekara: 2017, wata: 7, rana: 13,
	awa: 18, minti: 0, daƙiƙa: 0.
}.

clock idan: ['tell'] yi: {
	Fitarwa rubuta: kai, sabon-layi.
}.


clock ƙara: 2    awa, tell.
clock ƙara: 1    awa, tell.
clock ƙara: 19 minti, tell.
clock ƙara: 1  minti, tell.
clock ƙara: 1  minti, tell.
clock ƙara: 19 daƙiƙa, tell.
clock ƙara: 1  daƙiƙa, tell.
clock ƙara: 1  daƙiƙa, tell.
clock ƙara: 2    shekara, tell.
clock ƙara: 1    shekara, tell.

(OS = ['Haiku']) gaskiya: {
clock ƙara: 5   wata.
clock yanki: ['CEST'], tell.
}, in-ba-haka-ba: {
	clock ƙara: 5   wata, tell.
}.

clock ƙara: 1   wata, tell.
clock ƙara: 19    rana, tell.
