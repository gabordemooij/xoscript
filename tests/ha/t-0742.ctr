Fitarwa rubuta: ['Test object'], sabon-layi.
>> a := Abu sabo. 

a idan: ['item:'] yi: { :hexhelper
	nasa hexhelper := hexhelper. 
}.

a idan: ['item'] yi: { <- nasa hexhelper.
}.

a item: Hx sabo.

>> old-hexhelper-address := a item samfuri adireshin-ƙwaƙwalwa.
a save-as: ['/tmp/a.bin'].
Fitarwa rubuta: ['========== RELOADING SNAP:'], sabon-layi.

>> b := Abu load-from: ['/tmp/a.bin'].

(b item samfuri adireshin-ƙwaƙwalwa = old-hexhelper-address) gaskiya: {
	Fitarwa rubuta: ['Object link re-attached.'], sabon-layi.
}.
