
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> lamba-tsari := {
	>> o := (
		Ƙamus sabo
		aa: (Jeri ← 1 ; 2),
		bb: (Jeri ← 3 ; 4)
	).
	>> s := o rubutu.
	>> o2 := s abu.
	(s  nauʼi = Rubutu nauʼi) gaskiya: { Fitarwa rubuta: ['OK1'], sabon-layi. }.
	(o2 nauʼi = Ƙamus nauʼi) gaskiya: { Fitarwa rubuta: ['OK2'], sabon-layi. }.
}.

Shiri sarrafa-ƙwaƙwalwa: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Shiri tsaftace.
usedMemory1 := (Shiri ƙwaƙwalwa ? 1).
lamba-tsari fara.
Shiri tsaftace.
usedMemory2 := (Shiri ƙwaƙwalwa ? 1).
lamba-tsari fara.
Shiri tsaftace.
usedMemory3 := (Shiri ƙwaƙwalwa ? 1).
lamba-tsari fara.
Shiri tsaftace.
usedMemory4 := (Shiri ƙwaƙwalwa ? 1).

(usedMemory2 = usedMemory3 = usedMemory4) gaskiya: { Fitarwa rubuta: ['OK3'], sabon-layi. }.
 
