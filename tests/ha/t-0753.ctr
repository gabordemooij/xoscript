Fitarwa rubuta: ['Test object'], sabon-layi.
>> a := Abu sabo. 

a idan: ['item:'] yi: { :fmt
	nasa fmt := fmt. 
}.

a idan: ['item'] yi: { <- nasa fmt.
}.

a item: ( Tsari sabo: ['|%s|'] ).

Fitarwa rubuta: a item, sabon-layi.

>> old-fmt-address := a item samfuri adireshin-ƙwaƙwalwa.
a save-as: ['/tmp/a.bin'].
Fitarwa rubuta: ['========== RELOADING SNAP:'], sabon-layi.

>> b := Abu load-from: ['/tmp/a.bin'].

(b item samfuri adireshin-ƙwaƙwalwa = old-fmt-address) gaskiya: {
	Fitarwa rubuta: ['Object link re-attached.'], sabon-layi.
}.

Fitarwa rubuta: ( b item aiwatar: ['hello'] ), sabon-layi.
