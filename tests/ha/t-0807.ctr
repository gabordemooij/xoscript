# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB sabo mai-masauki: ['localhost'],
	sunan-mai-amfani: ['xo'],
	kalmar-sirri: ['pass123'],
	sunan-rumbun-bayanai: ['xobase'],
	haɗu.

>> sigogin-nema := db tambaya: ['SELECT %% FROM'].
{ sigogin-nema zartar. } kama: { :e
	Fitarwa rubuta: ( e ya-ƙunshi: ['%%'] ), sabon-layi.
}, fara.
