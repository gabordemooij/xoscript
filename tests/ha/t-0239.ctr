Jeri idan: ['sum'] yi: {
	>> total := 0.
	kai kowane: { :index :element
		total ƙara: element.
	}. <- total.
}.

>> a := Gaskiya.



a idan: ['rubutu'] yi: {
	>> answer := Babu.
	( kai = Gaskiya ) gaskiya: {
		answer := ['Yep'].
	}, in-ba-haka-ba: {
		answer := ['Nope'].
	}. <- answer.
}.

a idan: ['lamba'] yi: {
	>> answer := Babu.
	( kai = Gaskiya ) gaskiya: {
		answer := 10.
	}, in-ba-haka-ba: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b idan: ['rubutu'] yi: { <- ['Devil'].
}.

b idan: ['boolean'] yi: { <- Ƙarya.
}.


Fitarwa rubuta: a, sabon-layi.  
Fitarwa rubuta: (90 + a), sabon-layi. 
Fitarwa rubuta: b, sabon-layi. 
Fitarwa rubuta: (Gaskiya da: b), sabon-layi.

a := Jeri ← ['hello'] ; ['world'] ; Gaskiya ; Babu ; 666. 
a := a + ( Jeri ← 1 ).
Fitarwa rubuta: a, sabon-layi.
Fitarwa rubuta: ((Ƙamus sabo) sanya: Babu a: Babu), sabon-layi.
Fitarwa rubuta: a sum, sabon-layi. 


{
	a idan: ['rubutu'] yi: { <- Babu. }.
	a := [''] + a.
} kama: { :error
	Fitarwa rubuta: ['Error noted: '] + error, sabon-layi.
}, fara.



{
	a idan: ['lamba'] yi: { <- Babu. }.
	a := 3 × a.
} kama: { :error
	Fitarwa rubuta: ['Error noted: '] + error, sabon-layi.
}, fara.


{
	a idan: ['boolean'] yi: { <- Babu. }.
	a := Gaskiya da: a. 
} kama: { :error
	Fitarwa rubuta: ['Error noted: '] + error, sabon-layi.
}, fara.





