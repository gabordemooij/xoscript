# test number -> string -> number
{

	>> x := Lamba tsakanin: 0 da: 1000000.
	>> d := Lamba tsakanin: 1 da: 7.
	>> e := 10 ƙarfi: d.

	x raba-da: e.
	>> y := x rubutu lamba.

	(x = y) ƙarya: {
		Fitarwa rubuta: x, sabon-layi.
		Fitarwa rubuta: y, sabon-layi.
		Shiri ƙare.
	}.

} * 1000.
Fitarwa rubuta: ['OK'], sabon-layi.