
Rubutu idan: ['html'] yi: { <- (
		kai
		musanya: ['&'] da: ['&amp;'],
		musanya: ['<'] da: ['&lt;'],
		musanya: ['>'] da: ['&gt;'],
		musanya: ['"'] da: ['&quot;']
	).
}.

>> HtmlBrush := Abu sabo.

HtmlBrush idan: ['amsa:'] yi: { :tag
	Fitarwa rubuta: (['<tag>↵'] tag: tag ).
}.

HtmlBrush idan: ['amsa:da:'] yi: { :tag :content
	tag := ( tag daga: 0 tsawo: (tag tsawo - 1) ).
	Fitarwa rubuta: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush idan: ['content:'] yi: { :text
	Fitarwa rubuta: text html, sabon-layi.
}.

HtmlBrush idan: ['attr:value:'] yi: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush sabo.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
