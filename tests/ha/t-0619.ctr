>> HTML := Abu sabo.
HTML idan: ['amsa:'] yi: { :tag 
	Fitarwa rubuta: (['<tag>'] tag: tag), sabon-layi.
}.
HTML idan: ['amsa:da:'] yi: { :tag :html 
	Fitarwa rubuta: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), sabon-layi.
}.
>> html := HTML sabo.
html body h1: ['header'].

