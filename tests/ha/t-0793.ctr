Server init.

>> DB := Maria-DB sabo mai-masauki: ['localhost'],
	sunan-mai-amfani: ['xo'],
	kalmar-sirri: ['pass123'],
	sunan-rumbun-bayanai: ['xobase'],
	haɗu.

{
	DB tambaya:
	['DROP TABLE movies'],
	zartar.
} kama: { Babu. }, fara.

DB tambaya:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
zartar.

DB tambaya: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
sigogi: ( Jeri sabo ; ['Halloween'] ),
zartar.

DB tambaya: ['SELECT * FROM movies'],
ɗauko: { :movie
	Fitarwa rubuta: movie title, sabon-layi.
}.

