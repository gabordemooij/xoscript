# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Asusu ƙirƙiri-maɓallai.

# private (secret) key
>> sk := keys na-farko.

# public key
>> pk := keys na-ƙarshe.

# sign a message
>> sig := Asusu sa-hannu: ['abc'] da: sk.

# check message (ok)
Fitarwa rubuta: ( 
	Asusu
		duba: ['abc'] 
		sa-hannu: sig 
		da: pk 
), sabon-layi.

# check message (fail)
Fitarwa rubuta: ( 
	Asusu 
		duba: ['abd'] 
		sa-hannu: sig 
		da: pk 
), sabon-layi.