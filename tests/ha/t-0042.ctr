>> items := Ƙamus sabo.
items sanya: ['black'] a: ['coffee'], sanya: ['earl grey'] a: ['tea'].
Fitarwa rubuta: (items a: ['coffee']), rubuta: (items a: ['tea']).
Fitarwa rubuta: ['there are'] + items ƙidaya + [' items in the array.'].
items sanya: ['capuccino'] a: ['coffee'].
Fitarwa rubuta: ['Now my coffee is.. '] + (items a: ['coffee']).
items sanya: ['aaa'] a: ['1'].
items sanya: ['bbb'] a: ['2'].
Fitarwa rubuta: (items a: ['a']).
