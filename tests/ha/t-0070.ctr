>> numbers := ['1,2,3'] tsaga: [','].
Fitarwa rubuta: ['I got: '] + numbers ƙidaya + [' numbers.'],sabon-layi.
{ :i Fitarwa rubuta: ['number #'] + i + [':'] + (numbers matsayi: i), sabon-layi.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages tsaga: [' Or '].
Fitarwa rubuta: ['We serve'], sabon-layi.
{ :i Fitarwa rubuta: ['->'] + (beverages matsayi: i), sabon-layi. } × (beverages ƙidaya).
Fitarwa rubuta: (beverages haɗa: [',']), sabon-layi.
Fitarwa rubuta: (numbers haɗa: ['||']).
