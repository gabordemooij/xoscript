# catch-all test (practical)
>> HTML := Rubutu sabo.
HTML idan: ['encode:'] yi: { :tekst
	kai ƙara-a-ƙarshe: (tekst
	musanya: ['&'] da: ['&amp;'], 
	musanya: ['<'] da: ['&lt;'],
	musanya: ['>'] da: ['&gt;'],
	musanya: ['"'] da: ['&quot;']).
}.
>> blog := HTML sabo.
blog ƙara-a-ƙarshe: ['<h1>'],
     encode: ['Koffie & Thee'],
     ƙara-a-ƙarshe: ['</h1>'].
Fitarwa rubuta: blog, sabon-layi.


>> Roman := Lamba sabo.
Roman idan: ['stringy'] yi: {
	>> a := [''].
	{ a ƙara-a-ƙarshe: ['I']. } × kai. <- a.
}.

>> x := Roman sabo.
x ƙara: 3.
Fitarwa rubuta: x stringy, sabon-layi.

>> Quantum := Boolean sabo.
Quantum idan: ['true?'] yi: { <- ['maybe True']. }.
Fitarwa rubuta: (Quantum sabo true?), sabon-layi.

>> Nihil := Babu sabo.
Nihil idan: ['rubutu'] yi: { <- ['Nihil']. }.
Fitarwa rubuta: (Nihil sabo), sabon-layi.
