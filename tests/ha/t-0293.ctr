
>> city := Jeri ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Jeri ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature bisa: city.
>> cities := weather maɓallai jera: { :a :b <- (a kwatanta: b). }.
>> temperatures := weather ƙimomi jera: { :a :b <- (a kwatanta: b) mara-kyau?. }.

Fitarwa rubuta: (cities haɗa: [',']), sabon-layi.
Fitarwa rubuta: (temperatures haɗa: [',']), sabon-layi.
