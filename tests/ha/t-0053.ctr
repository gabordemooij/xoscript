60 × {
	>> x := (Lamba random % 6) + 1.
	(x ≤ 6) ƙarya: { Fitarwa rubuta: ['FAIL']. }.
	(x ≥0) ƙarya: { Fitarwa rubuta: ['FAIL']. }.
	x := (Lamba random % 3) + 1.
	(x < 3) ƙarya: { Fitarwa rubuta: ['FAIL']. }.
	(x>-1) ƙarya: { Fitarwa rubuta: ['FAIL']. }.
	x := ((Boolean flip) lamba).
	(x = 0 ko: x = 1) ƙarya: { Fitarwa rubuta: ['FAIL']. }.
	x := ((Gaskiya flip) lamba).
	(x = 0 ko: x = 1) ƙarya: { Fitarwa rubuta: ['FAIL']. }.
	x := (Boolean flip ko-dai: ['HEAD'] ko: ['TAIL']).
	((x = ['HEAD']) ko: (x = ['TAIL'])) ƙarya: { Fitarwa rubuta: ['FAIL']. }.
}.
Fitarwa rubuta: ['DONE'].

