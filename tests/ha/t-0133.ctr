


>> Deck := Jeri sabo.
Deck idan: ['print'] yi: {
        >> len := kai ƙidaya - 1.
        { :i
                >> len2 := kai ƙidaya - 1.
                Fitarwa rubuta: ['len: '].
                Fitarwa rubuta: len, sabon-layi.
                Fitarwa rubuta: ['len2: '].
                Fitarwa rubuta: len2, sabon-layi.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
