Lamba idan: ['factorial'] yi: {
	>> total := 1.
	{ :index total ninka-da: (kai - (index)). } × kai. <- total.
}.
>> Printer := Abu sabo.
Printer idan: ['print:and:'] yi: { :x :y
	Fitarwa rubuta: ['a='] + x + [', b='] + y, sabon-layi.
}.
>> a := 4.5. >> b := a zagaye-ƙasa.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a zagaye-sama.
Printer print: a and: b.
a := 4.5. b := a zagaye-ƙasa.
Printer print: a and: b.
a := 4.5. b := a zagaye.
Printer print: a and: b.
a := 4.2. b := a zagaye.
Printer print: a and: b.

Fitarwa rubuta: (9 saura: 5), sabon-layi.
Fitarwa rubuta: -666 cikakkiyar-ƙima, sabon-layi.
Fitarwa rubuta: 49 tushen-murabbaʼi, sabon-layi.
Fitarwa rubuta: (2 ƙarfi: 3), sabon-layi.
>> l := (Jeri ← 9 ; 6).
Fitarwa rubuta: l mafi-ƙanƙanta.

