# test list operations


>> cakes := Jeri ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes musanya: 1 tsawo: 2 da: ( Jeri ← ['cinnamon'] ; ['pineapple'] ).
Fitarwa rubuta: (buy haɗa: [',']), sabon-layi.


>> buy := cakes musanya: 1 tsawo: 12 da: ( Jeri ← ['cinnamon'] ; ['pineapple'] ).
Fitarwa rubuta: (buy haɗa: [',']), sabon-layi.


>> buy := cakes musanya: 2 tsawo: 10 da: ( Jeri sabo ).
Fitarwa rubuta: (buy haɗa: [',']), sabon-layi.


>> buy := cakes musanya: 0 tsawo: 1 da: ( Jeri sabo ).
Fitarwa rubuta: (buy haɗa: [',']), sabon-layi.


>> buy := cakes musanya: ['0'] tsawo: ['1'] da: ['x'].
Fitarwa rubuta: (buy haɗa: [',']), sabon-layi.
