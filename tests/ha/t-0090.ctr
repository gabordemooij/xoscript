Fitarwa rubuta: ['1,2,3,4,5,6,7,8,9,A,'], sabon-layi.
>> Scope := Abu sabo.
Scope idan: ['initialize:'] yi: { :x nasa property := x. }.
Scope idan: ['confirm'] yi: { Fitarwa rubuta: [',']. }.
Scope idan: ['gwaji'] yi: {
	Fitarwa rubuta: nasa property.
	kai confirm.
	( 1 = 1 ) gaskiya: { Fitarwa rubuta: nasa property. kai confirm. }.
	( 1 = 0 ) ƙarya: { Fitarwa rubuta: nasa property. kai confirm. }.
	>> y := 2. { Fitarwa rubuta: nasa property. kai confirm. } muddin: { y rage: 1. <- (y > 0). }.
	{ Fitarwa rubuta: nasa property. kai confirm. } × 1.
	(Jeri ← 1) kowane: {  Fitarwa rubuta: nasa property. kai confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Ƙamus sabo one: ['item']) kowane: { Fitarwa rubuta: nasa property. kai confirm. }.
	{ 1 ÷ 0. } kama: { Fitarwa rubuta: nasa property. kai confirm. }, fara.
	Fitarwa sabon-layi.
}.
>> scope1 := Scope sabo.
scope1 initialize: ['X'].
scope1 gwaji.
>> function := { 
	nasa property := ['Y'].
	Fitarwa rubuta: nasa property.
	kai confirm.
	( 1 = 1 ) gaskiya: { Fitarwa rubuta: nasa property. kai confirm. }.
	( 1 = 0 ) ƙarya: { Fitarwa rubuta: nasa property. kai confirm. }.
	>> y := 2. { Fitarwa rubuta: nasa property. kai confirm. } muddin: { y rage: 1. <- (y > 0). }.
	{ Fitarwa rubuta: nasa property. kai confirm. } × 1.
	(Jeri ← 1) kowane: {  Fitarwa rubuta: nasa property. kai confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Ƙamus sabo one: ['item']) kowane: { Fitarwa rubuta: nasa property. kai confirm. }.
	{ 1 ÷ 0. } kama: { Fitarwa rubuta: nasa property. kai confirm. }, fara.
	Fitarwa sabon-layi.
}.
function idan: ['confirm'] yi: { Fitarwa rubuta: [',']. }.
function aiwatar: 1 da: 2.
