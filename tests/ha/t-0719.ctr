Server init.
>> fmt := Tsari sabo: ['%#3x'].

>> blob := Blob sabo: 4.
blob bytes: ( 
	Jeri sabo ; 0 ; 1 ; 2 ; 3
).

>> file := Fayil sabo: ['/tmp/blob'].
file blob: blob.
blob saki.

>> karanta := file blob.
karanta 
daga: 0 
tsawo: 4, 
yi kowane: { :i :b 
	Fitarwa
	rubuta: (fmt aiwatar-cikakkiyar-lamba: b),
	sabon-layi.
}.
karanta saki.
