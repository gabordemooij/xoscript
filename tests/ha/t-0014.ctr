>> Greeter := Abu sabo.
Greeter idan: ['make'] yi: {
	>> gr := Abu sabo.
	gr idan: ['setName:'] yi: { :aname
		nasa suna := aname.
	}.
	gr idan: ['greet'] yi: {
		Fitarwa rubuta: nasa suna.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a sabo.
c setName: ['THREE'].
c greet.
>> d := a sabo.
d setName: ['FOUR'].
d greet.
c greet.
