# recursive interpolation not allowed

Fitarwa rubuta: 
['recursive string interolation enabled: '] + (
	Shiri fasali: 
	['RECURSIVE_STRINTPOL']
), sabon-layi.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Fitarwa rubuta: a, sabon-layi.


