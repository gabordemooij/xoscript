
Shiri sarrafa-ƙwaƙwalwa: 4.

>> Animal := Abu sabo.
Animal idan: ['make'] yi: {
	>> animal := Abu sabo.
	animal idan: ['makeSound'] yi: {
		Fitarwa rubuta: nasa sound.
	}. <- animal.
}.
>> Cat := Abu sabo.
Cat idan: ['make'] yi: {
	>> cat := Animal make.
	cat idan: ['init'] yi: {
		nasa sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
