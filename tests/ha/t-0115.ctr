{
	wannan-aiki kuskure: ['Dont fail.'].
	unknown doSomething.
} kama: {
	Fitarwa rubuta: ['Caught!'].
}, fara.

{
	wannan-aiki kuskure: ['Dont fail.'].
	nasa unknown doSomething.
} kama: {
	Fitarwa rubuta: ['Caught!'].
}, fara.

{
	wannan-aiki kuskure: ['Dont fail.'].
	unknown := 122.
} kama: {
	Fitarwa rubuta: ['Caught!'].
}, fara.


{
	wannan-aiki kuskure: ['Dont fail.'].
	Gaskiya katse.
	Fitarwa rubuta: ['FAIL'].
} kama: {
	Fitarwa rubuta: ['Caught!'].
}, fara.

{
	{
		wannan-aiki kuskure: ['Dont fail.'].
		Gaskiya katse.
		Fitarwa rubuta: ['FAIL'].
	} kama: { :x
		(x = ['Dont fail.']) gaskiya: { wannan-aiki kuskure: ['Nested Caught!']. }.
	}, fara.
} kama: { :e
	Fitarwa rubuta: e.
}, fara.
