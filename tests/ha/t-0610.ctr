
>> Rectangle := Abu sabo.

Rectangle idan: ['area'] yi: { <- nasa tsawo * nasa width.
}.

Rectangle idan: ['length:'] yi: { :tsawo
	nasa tsawo := tsawo.
}.

Rectangle idan: ['width:'] yi: { :width
	nasa width := width.
}.

Rectangle idan: ['sabo'] yi: {
	# this will not result into an infinite loop
	>> rectangle := kai sabo.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle sabo.
Fitarwa rubuta: a area, sabon-layi. #0

>> b := Rectangle sabo length: 2, width: 3.
Fitarwa rubuta: b area, sabon-layi. #6

