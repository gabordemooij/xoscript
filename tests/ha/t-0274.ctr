

Jeri idan: ['column:'] yi: { :column
	>> result := Jeri sabo.
	kai kowane: { :index :row
		row kowane: { :index :cell
			(index = column) gaskiya: { result ƙara-a-ƙarshe: cell. }.
		}.
	}. <- result.
}.


>> a := Jeri ←
	(Jeri ← 1 ; 2 ; 3) ;
	(Jeri ← 4 ; 5 ; 6) ;
	(Jeri ← 7 ; 8 ; 9).

>> b := a column: 1.
Fitarwa rubuta: b, sabon-layi.

b := a column: 20.
Fitarwa rubuta: b, sabon-layi.

b := a column: -100.
Fitarwa rubuta: b, sabon-layi.
