


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Shiri sarrafa-ƙwaƙwalwa: 0.
>> palette := Babu.
>> colors := Babu.

{
palette := Ƙamus sabo.
palette 
	sanya: ['#F00'] a: ['red'],
	sanya: ['#0F0'] a: ['green'],
	sanya: ['#00F'] a: ['blue'].
Fitarwa rubuta: ['number of RGB codes in palette: '] + ( palette ƙidaya ), sabon-layi.
Fitarwa rubuta: ['RGB code of green is: '] + ( palette ? ['green'] ), sabon-layi.
colors := [''].
( palette kowane: { :suna :lamba-tsari
		colors := colors + ( suna + [':'] + lamba-tsari ).
} ).
Fitarwa rubuta: ['All colors in palette: '] + colors, sabon-layi.
} fara.
Shiri tsaftace.
usedMemory1 := (Shiri ƙwaƙwalwa ? 0).

{
palette := Ƙamus sabo.
palette 
	sanya: ['#F00'] a: ['red'],
	sanya: ['#0F0'] a: ['green'],
	sanya: ['#00F'] a: ['blue'].
Fitarwa rubuta: ['number of RGB codes in palette: '] + ( palette ƙidaya ), sabon-layi.
Fitarwa rubuta: ['RGB code of green is: '] + ( palette ? ['green'] ), sabon-layi.
colors := [''].
( palette kowane: { :suna :lamba-tsari
		colors := colors + ( suna + [':'] + lamba-tsari ).
} ).
Fitarwa rubuta: ['All colors in palette: '] + colors, sabon-layi.
} fara.
Shiri tsaftace.
usedMemory2 := (Shiri ƙwaƙwalwa ? 0).

{
palette := Ƙamus sabo.
palette 
	sanya: ['#F00'] a: ['red'],
	sanya: ['#0F0'] a: ['green'],
	sanya: ['#00F'] a: ['blue'].
Fitarwa rubuta: ['number of RGB codes in palette: '] + ( palette ƙidaya ), sabon-layi.
Fitarwa rubuta: ['RGB code of green is: '] + ( palette ? ['green'] ), sabon-layi.
colors := [''].
( palette kowane: { :suna :lamba-tsari
		colors := colors + ( suna + [':'] + lamba-tsari ).
} ).
Fitarwa rubuta: ['All colors in palette: '] + colors, sabon-layi.
