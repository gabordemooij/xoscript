# test qualifiers

Shiri tsaftace.

>> Fruit := Abu sabo.
Fruit idan: ['sabo'] yi: {
	>> f := kai sabo.
	f apples: 0. <- f.
}.
Fruit idan: ['apples:'] yi: { :a nasa apples := a. }.
Fruit idan: ['apples'] yi: { <- nasa apples. }.
Fruit idan: ['+'] yi: { :f
	>> n := Fruit sabo.
	n apples: (f apples + nasa apples). <- n.
}.
Lamba idan: ['apples'] yi: { <- ((Fruit sabo) apples: kai).
}.

Fruit idan: ['rubutu'] yi: { <- nasa apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Fitarwa rubuta: q, sabon-layi.




q := 3 apples + 4 apples.
Fitarwa rubuta: q, sabon-layi.



q := 3 apples + 4 apples.
Fitarwa rubuta: q, sabon-layi.


