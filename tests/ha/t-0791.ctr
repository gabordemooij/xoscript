Server init.

>> DB := Maria-DB sabo mai-masauki: ['localhost'],
	sunan-mai-amfani: ['xo'],
	kalmar-sirri: ['pass123'],
	sunan-rumbun-bayanai: ['xobase'],
	haɗu.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> sigogin-nema := Tambayar-Maria sabo: SQL.

# set database
sigogin-nema rumbun-bayanai: DB.

sigogin-nema ɗauko: { :row
	Fitarwa rubuta: row world, sabon-layi.
}.
