# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Shiri saiti: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server haɗi: ( Jeri sabo ;
 libname ; ['fopen'] ;
 ( Jeri sabo ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
haɗi: ( Jeri sabo ;
 Babu ; # means same lib
 ['fread'] ;
 ( Jeri sabo ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Babu ; # means same object (i.e. Stream)
 ['fread']
),
haɗi: (
 Jeri sabo ;
 Babu ; # means same lib
 ['fwrite'] ;
 ( Jeri sabo ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Babu ; # means same lib
 ['fwrite']
),
haɗi: (
 Jeri sabo ;
 Babu ; # means same lib
 ['rewind'] ;
 ( Jeri sabo ; ['pointer'] ) ;
 ['int'] ;
 Babu ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> hanyar-fayil := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: hanyar-fayil mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream saƙo: ['fwrite'] hujjoji: (Jeri sabo ; str ; 1 ; 6 ; fd ).
Fitarwa rubuta: bytes-written, sabon-layi.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob sabo: 20.

# read from file
>> bytes-read := Stream saƙo: ['fread'] hujjoji: (Jeri sabo ; buf ; 1 ; 6 ; fd ).
Fitarwa rubuta: bytes-read, sabon-layi.
Fitarwa rubuta: buf, sabon-layi.

# free memory
str  saki.
hanyar-fayil saki.
mode saki.
buf  saki.


