>> t := Babu.

# you can control the time zone for
# parsing like this:
Lokaci yanki: ['CET'].
t := Lokaci daga-tushe: ['1981-02-03 04:05:06'].
Fitarwa rubuta: t, sabon-layi.

# now using CEST time zone:
Lokaci yanki: ['CEST'].
t := Lokaci daga-tushe: ['1981-02-03 04:05:06'].
Fitarwa rubuta: t, sabon-layi.

# error if string cannot be parsed
{ Lokaci daga-tushe: ['1900']. } kama: { Babu. }, fara.
