Lamba idan: ['factorial'] yi: {
	>> total := 1.
	{ :index total ninka-da: (kai - index). } × kai. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Shiri sarrafa-ƙwaƙwalwa: 0.

{
2 exponent factorial.
Fitarwa rubuta: (11 saura: 3), sabon-layi.
Fitarwa rubuta: (3.4 zagaye), sabon-layi.
Fitarwa rubuta: (7.1 zagaye-sama), sabon-layi.
Fitarwa rubuta: (7.9 zagaye-ƙasa), sabon-layi.
}
fara.

Shiri tsaftace.

usedMemory1 := (Shiri ƙwaƙwalwa ? 0).

{
2 exponent factorial.
Fitarwa rubuta: (11 saura: 3), sabon-layi.
Fitarwa rubuta: (3.4 zagaye), sabon-layi.
Fitarwa rubuta: (7.1 zagaye-sama), sabon-layi.
Fitarwa rubuta: (7.9 zagaye-ƙasa), sabon-layi.
}
fara.

Shiri tsaftace.
usedMemory2 := (Shiri ƙwaƙwalwa ? 0).


{
2 exponent factorial.
Fitarwa rubuta: (11 saura: 3), sabon-layi.
Fitarwa rubuta: (3.4 zagaye), sabon-layi.
Fitarwa rubuta: (7.1 zagaye-sama), sabon-layi.
Fitarwa rubuta: (7.9 zagaye-ƙasa), sabon-layi.
} fara.

Shiri tsaftace.
usedMemory3 := (Shiri ƙwaƙwalwa ? 0).



( usedMemory1 = usedMemory2 da: usedMemory1 = usedMemory3, da: usedMemory2 = usedMemory3 ) gaskiya: {
	Fitarwa rubuta: ['No memory leaks here'].
}, ƙarya: {
	Fitarwa rubuta: ['Leaking memory...'].
}.
