Server init.
Fitarwa rubuta: ['Database date test'], sabon-layi.

>> db := Maria-DB sabo mai-masauki: ['localhost'],
	sunan-mai-amfani: ['xo'], 
	kalmar-sirri: ['pass123'],
	sunan-rumbun-bayanai: ['xobase'],
	haɗu.

>> sigogin-nema :=
db tambaya: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
ɗauko: { :row
	Fitarwa rubuta: row datetest, sabon-layi.
}.
