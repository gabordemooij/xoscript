

>> Matryoshka := Abu sabo.
Matryoshka idan: ['double:'] yi: { :secret
	nasa secret := secret × 2.
}.
Matryoshka idan: ['sabo:'] yi: { :secret
	>> answer := Babu.
	>> t := (secret > 255).
	Fitarwa rubuta: (secret + [' | '] + t), sabon-layi.
	t gaskiya: {
		answer := secret.
	}, in-ba-haka-ba: {
		answer := Matryoshka maimaita-kai sabo: (kai double: secret).
	}. <- answer.
}.

>> x := Matryoshka sabo: 2.
