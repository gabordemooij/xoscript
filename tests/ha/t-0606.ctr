>> Point := Abu sabo.
Point idan: ['x-coordinate:'] yi: { :x nasa x := x. }.
Point idan: ['y-coordinate:'] yi: { :y nasa y := y. }.
Point idan: ['x-coordinate']  yi: { <- nasa x kwafi. }.
Point idan: ['y-coordinate']  yi: { <- nasa y kwafi. }.

Point idan: ['='] yi: { :other <- ( nasa x = other x-coordinate
		 da: nasa y = other y-coordinate ).
}.

>> pier := Point sabo x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point sabo x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point sabo x-coordinate: 5, y-coordinate: 6.

Fitarwa rubuta: pier = town-hall, sabon-layi.
Fitarwa rubuta: pier = restaurant, sabon-layi.
