# Test ASCII variants

# Numbers

Fitarwa rubuta: (2 !=: 3), sabon-layi.
Fitarwa rubuta: (2 <=: 2), sabon-layi.
Fitarwa rubuta: (2 >=: 2), sabon-layi.

# Strings

Fitarwa rubuta: (['b'] >=: ['a']), sabon-layi.
Fitarwa rubuta: (['b'] !=: ['a']), sabon-layi.
Fitarwa rubuta: (['b'] <=: ['c']), sabon-layi.

# Bools

Fitarwa rubuta: (Gaskiya !=: Ƙarya), sabon-layi.

# Objects

Fitarwa rubuta: (Abu sabo !=: Abu sabo), sabon-layi.

# ASCII list symbol <-:

Fitarwa rubuta: (Jeri <<: 1, ; 2 ; 3) ƙidaya = 3, sabon-layi.

