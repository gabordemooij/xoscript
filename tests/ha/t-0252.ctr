#Linux
>> clock := Lokaci sabo.
clock yanki: ['UTC-1'].
clock shekara: 1981, wata: 1, rana: 5,
      awa: 13, minti: 15, daƙiƙa: 13.

Fitarwa rubuta: clock, sabon-layi.
clock yanki: ['UTC+0'].

Fitarwa rubuta: (
	(clock shekara sauƙi) + ['-'] + (clock wata) + ['-'] + (clock rana) + [' '] +
	(clock awa) + [':'] + (clock minti) + [':'] + (clock daƙiƙa) + [' '] +
	['W'] + (clock mako) + (clock yanki)
), sabon-layi.


clock yanki: ['UTC-1'].
Fitarwa rubuta: (
	(clock shekara sauƙi) + ['-'] + (clock wata) + ['-'] + (clock rana) + [' '] +
	(clock awa) + [':'] + (clock minti) + [':'] + (clock daƙiƙa) + [' '] +
	['W'] + (clock mako) + (clock yanki)
), sabon-layi.
