
>> a := Jeri ← (Jeri ← 100 ; 200 ; 300) ; (Jeri ← 9 ; 8 ; 7).
Fitarwa rubuta: ['at 0,1 :'].
Fitarwa rubuta: a ? 0 ? 1, sabon-layi. 
Fitarwa rubuta: ['at 1,2 :'].
Fitarwa rubuta: a ? 1 ? 2, sabon-layi. 
>> menu := Ƙamus sabo.
menu sanya: (Jeri ← ['pizza'] ; ['spaghetti']) a: ['Italian Cuisine'].
menu sanya: (Jeri ← ['bifteki'] ; ['suflaki']) a: ['Greek Cuisine'].
Fitarwa rubuta: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), sabon-layi. 
Fitarwa rubuta: ['but not on the same plate.'], sabon-layi.
