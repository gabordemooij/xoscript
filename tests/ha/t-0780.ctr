Server init.

# JSON encoder only supports UTF-8, no surrogate pairs

>> dicts := Jeri sabo ;
	# {"key":"normal"} normal ASCII
	( Ƙamus sabo sanya: ['normal'] a: ['key'] ) ;
	# {"key":"hello world"} space character
	( Ƙamus sabo sanya: ['hello world'] a: ['key'] ) ;
	# {"key":"quote: \""} double quote
	( Ƙamus sabo sanya: ['"'] a: ['key'] ) ;
	# {"key":"backslash: \\"} backslash
	( Ƙamus sabo sanya: ['backslash: \\'] a: ['key'] ) ;
	# {"key":"slash: /"} slash
	( Ƙamus sabo sanya: ['slash: /'] a: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( Ƙamus sabo sanya: ['backspace: \b'] a: ['key'] ) ;
	# {"key":"formfeed: \f"} form-feed escape
	( Ƙamus sabo sanya: ['formfeed: \f'] a: ['key'] ) ;
	# {"key":"newline: \n"} newline
	( Ƙamus sabo sanya: ['newline: \n'] a: ['key'] ) ;
	( Ƙamus sabo sanya: ['newline: ↵'] a: ['key'] ) ;
	( Ƙamus sabo sanya: ['newline: 
	'] a: ['key'] ) ;
	# {"key":"carriage return: \r"} carriage-return
	( Ƙamus sabo sanya: ['carriage return: \r'] a: ['key'] ) ;
	# {"key":"tab: \t"} tab
	( Ƙamus sabo sanya: ['tab \t'] a: ['key'] ) ;
	( Ƙamus sabo sanya: ['tab ⇿'] a: ['key'] ) ;
	( Ƙamus sabo sanya: ['tab  '] a: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( Ƙamus sabo sanya: ['NUL \u0000'] a: ['key'] ) ;
	( Ƙamus sabo sanya: ['NUL \0'] a: ['key'] ) ;
	# {"key":"control: \u0001"} control character 0x01
	( Ƙamus sabo sanya: ['control: \u0001'] a: ['key'] ) ;
	# {"key":"control: \u001F"} control character 0x1F
	( Ƙamus sabo sanya: ['control: \u001F'] a: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-byte char
	( Ƙamus sabo sanya: ['unicode: é'] a: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-byte char
	( Ƙamus sabo sanya: ['unicode: €'] a: ['key'] ) ;
	# {"key":"unicode: 日本語"} multiple 3-byte UTF-8 chars
	( Ƙamus sabo sanya: ['unicode: 日本語'] a: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-byte char
	( Ƙamus sabo sanya: ['unicode: 😀'] a: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	( Ƙamus sabo sanya: ['unicode: 🧑‍💻'] a: ['key'] ) ;
	# {"key":"combining: e\u0301"} combining accent
	( Ƙamus sabo sanya: ['combining: e\u0301'] a: ['key'] ) ;
	# {"key":"escaped unicode: \u00e9"} Unicode escape BMP
	( Ƙamus sabo sanya: ['escaped unicode: \u00e9'] a: ['key'] ) ;
	# {"key":"escaped unicode: \u20ac"} Unicode escape BMP
	( Ƙamus sabo sanya: ['escaped unicode: \u20ac'] a: ['key'] ) ;
	# {"key":"escaped unicode: \ud83d\ude00"} UTF-16 surrogate pair
	( Ƙamus sabo sanya: ['escaped unicode: \ud83d\ude00'] a: ['key'] ) ;
	# {"key":""} empty value
	( Ƙamus sabo sanya: [''] a: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} special ASCII chars
	( Ƙamus sabo sanya: ['@ < > & = % + ? #'] a: ['key'] ) ;
	# {"key":"single quote: '"} single quote
	( Ƙamus sabo sanya: ['''] a: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} multiple JSON escapes
	( Ƙamus sabo sanya: ['multiple: \" \\ \n \r \t'] a: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} longer ASCII-string
	( Ƙamus sabo sanya: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] a: ['key'] ) ;
	# {"key":" value"} leading space
	( Ƙamus sabo sanya: [' value'] a: ['key'] ) ;
	# {"key":"value "} trailing space
	( Ƙamus sabo sanya: ['value '] a: ['key'] ) ;
	# {"key":" \t\n\r "} whitespace
	( Ƙamus sabo sanya: [' \t\n\r '] a: ['key'] ).

dicts kowane: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (Ƙamus sabo sanya: d key a: ['key']).
	>> b := JSON jsonify: (Ƙamus sabo sanya: ['value'] a: d key).
	>> e := JSON abu: a.
	>> f := JSON abu: b.
	((e key = d key da: (f ? d key = ['value'])) ko: (e key = ['NUL ?'])) gaskiya: {
		Fitarwa rubuta: ['OK'], sabon-layi.
	}, in-ba-haka-ba: {
		Fitarwa rubuta: ['Unable to properly encode/decode: '] + d + j, sabon-layi.
		Shiri ƙare.
	}.
}.
