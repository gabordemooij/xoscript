Lamba idan: ['roman'] yi: {
	>> lamba := kai kwafi.
	>> roman := [''].
	{
		{
			(lamba ≥ 1000) gaskiya: {
				roman ƙara-a-ƙarshe: ['Ⅿ'].
				lamba rage: 1000.
			}, katse.
		
			(lamba ≥ 500) gaskiya: {
				roman ƙara-a-ƙarshe: ['Ⅾ'].
				lamba rage: 500.
			}, katse.
		
			(lamba ≥ 100) gaskiya: {
				roman ƙara-a-ƙarshe: ['Ⅽ'].
				lamba rage: 100.
			}, katse.
		
			(lamba ≥ 50) gaskiya: {
				roman ƙara-a-ƙarshe: ['Ⅼ'].
				lamba rage: 50.
			}, katse.
		
			(lamba ≥ 50) gaskiya: {
				roman ƙara-a-ƙarshe: ['Ⅼ'].
				lamba rage: 50.
			}, katse.
		
			(lamba ≥ 10) gaskiya: {
				roman ƙara-a-ƙarshe: ['Ⅹ'].
				lamba rage: 10.
			}, katse.
			
			(lamba ≥ 9) gaskiya: {
				roman ƙara-a-ƙarshe: ['Ⅸ'].
				lamba rage: 9.
			}, katse.
			
			(lamba ≥ 5) gaskiya: {
				roman ƙara-a-ƙarshe: ['Ⅴ'].
				lamba rage: 5.
			}, katse.
			
			(lamba ≥ 4) gaskiya: {
				roman ƙara-a-ƙarshe: ['Ⅳ'].
				lamba rage: 4.
			}, katse.
			
			(lamba ≥ 1) gaskiya: {
				roman ƙara-a-ƙarshe: ['Ⅰ'].
				lamba rage: 1.
			}, katse.
		} hanyar-aiki.
	} muddin: { <- lamba > 0. }. <- roman.
}.

Fitarwa rubuta: 1 roman, sabon-layi.
Fitarwa rubuta: 2 roman, sabon-layi.
Fitarwa rubuta: 4 roman, sabon-layi.
Fitarwa rubuta: 8 roman, sabon-layi.
Fitarwa rubuta: 16 roman, sabon-layi.
Fitarwa rubuta: 32 roman, sabon-layi.
Fitarwa rubuta: 64 roman, sabon-layi.
Fitarwa rubuta: 128 roman, sabon-layi.
Fitarwa rubuta: 256 roman, sabon-layi.
Fitarwa rubuta: 1024 roman, sabon-layi.
