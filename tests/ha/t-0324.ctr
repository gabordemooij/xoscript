>> Animal := Abu sabo.
>> Factory := Abu sabo.

Animal idan: ['sabo'] yi: {
	>> animal := kai sabo.
	animal sound: ['?']. <- animal.
}.

Animal idan: ['sound:'] yi: { :s
	nasa sound := s.
}.

Animal idan: ['sound'] yi: { <- nasa sound.
}.

>> Dog := Abu sabo.
>> Cat := Abu sabo.

Dog idan: ['sabo'] yi: { <- Animal sabo sound: ['woof!'].
}.

Cat idan: ['sabo'] yi: { <- Animal sabo sound: ['meow!'].
}.

Fitarwa rubuta: Dog sabo sound, sabon-layi.
Fitarwa rubuta: Cat sabo sound, sabon-layi.

Factory idan: ['mix:and:'] yi: { :beast1 :beast2 <- Animal sabo sound: (
		( beast1 sound daga: 0 tsawo: 2 ) +
		( beast2 sound daga: 2 tsawo: 5 )
	).
}.

Fitarwa rubuta: (Factory mix: Dog sabo and: Cat sabo) sound, sabon-layi.
