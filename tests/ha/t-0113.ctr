Fitarwa rubuta: ['Continue for-loop, No - before 6 and up.'], sabon-layi.
{ :i
	Fitarwa rubuta: (i + 1), sabon-layi.
	((i + 1) > 4) ci-gaba.
	Fitarwa rubuta: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Fitarwa sabon-layi.
Fitarwa rubuta: ['Continue while-true, No --> before 5 and up.'], sabon-layi.
{
	Fitarwa rubuta: ['iteration #'] + x, sabon-layi.
	x ƙara: 1.
	((x < 5) akasi) ci-gaba.
	Fitarwa rubuta: ['-->'].
} muddin: xIsLessThan10.
Fitarwa sabon-layi.
Fitarwa rubuta: ['Continue while-false, No - before 3 only.'], sabon-layi.
{
	Fitarwa rubuta: ['iteration #'] + x, sabon-layi.
	x rage: 1.
	(x = 3) ci-gaba.
	Fitarwa rubuta: ['-'].
} muddin: { <- ( x > 0). }.

Fitarwa sabon-layi.
Fitarwa rubuta: ['Continue times-loop, No ||| before 3.'], sabon-layi.
{ :i
	Fitarwa rubuta: ['iteration #'] + i, sabon-layi.
	(i = 2) ci-gaba.
	Fitarwa rubuta: ['|||'].
} × 5.

Fitarwa sabon-layi.

{ Gaskiya ci-gaba. Fitarwa rubuta: ['dont write this!'], sabon-layi. } fara.

{ Gaskiya ci-gaba. Fitarwa rubuta: ['dont write this!'], sabon-layi. } kama: { Fitarwa rubuta: ['Dont catch this!']. }, fara.

Fitarwa rubuta: ['Test Array each-loop: 0, ... ,2'], sabon-layi.
(Jeri ← 1 ; 2 ; 3) canza-kowane: { :i
	(i = 1) ci-gaba.
	Fitarwa rubuta: ['iteration #'] + (i - 0), sabon-layi.
}.

Fitarwa rubuta: ['Test Map each-loop: c only'], sabon-layi.
>> m := Ƙamus sabo.
m sanya: ['first'] a: ['a'], sanya: ['second'] a: ['b'], sanya: ['third'] a: ['c'].
m kowane: { :k :v
	(k ≠ ['c']) ci-gaba.
	Fitarwa rubuta: ['iteration'] + k + v, sabon-layi.
}.

