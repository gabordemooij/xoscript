

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Shiri sarrafa-ƙwaƙwalwa: 0.

>> f := Fayil sabo: ['/tmp/citrine_test_file.txt'].
f exists: { f goge. }.
f rubuta: ['hello world'].

f := Fayil sabo: ['/tmp/citrine_test_file.txt'].
>> q := f karanta.
Fitarwa rubuta: q, sabon-layi.

Shiri tsaftace.
usedMemory1 := (Shiri ƙwaƙwalwa ? 0).


f := Fayil sabo: ['/tmp/citrine_test_file.txt'].
q := f karanta.
Fitarwa rubuta: q, sabon-layi.

Shiri tsaftace.
usedMemory2 := (Shiri ƙwaƙwalwa ? 0).


f := Fayil sabo: ['/tmp/citrine_test_file.txt'].
q := f karanta.
Fitarwa rubuta: q, sabon-layi.

Shiri tsaftace.
usedMemory3 := (Shiri ƙwaƙwalwa ? 0).



( usedMemory1 = usedMemory2 da: usedMemory1 = usedMemory3, da: usedMemory2 = usedMemory3 ) gaskiya: {
	Fitarwa rubuta: ['No memory leaks here'].
}, ƙarya: {
	Fitarwa rubuta: ['Leaking memory...'].
}.
