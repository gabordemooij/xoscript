Rubutu idan: ['evaluate'] yi: {
	>> lamba-tsari := Fayil sabo: ['/tmp/eval.ctr'].
	lamba-tsari rubuta: (kai rubutu + ['.']).
	Shiri yi-amfani: ['/tmp/eval.ctr'].
}.

>> a := Jeri ← 1 ; 2 ; 3.
>> b := (a rubutu).

Fitarwa rubuta: b, sabon-layi. 
(['b := '] + b) evaluate.

Fitarwa rubuta: b ? 2, sabon-layi. 

Fitarwa rubuta: (( Jeri ← 1 ; 2 ; 3 )), sabon-layi. 

Fitarwa rubuta: ((Ƙamus sabo) sanya: 1 a: 2), sabon-layi. 

>> x := ( (Jeri ← 1 ; ( Jeri ← 9 ) ; Gaskiya ) ) rubutu.
Fitarwa rubuta: x, sabon-layi. 
(['x := '] + x) evaluate.

Fitarwa rubuta: x ? 1 ? 0, sabon-layi. 

>> y := (Ƙamus sabo) sanya: (Jeri ← 1) a: (Jeri ← 2).
Fitarwa rubuta: y, sabon-layi. 

(['y := '] + y) rubutu evaluate.

Fitarwa rubuta: (y a: (Jeri ← 2) rubutu ), sabon-layi.

Fitarwa rubuta: (Jeri sabo), sabon-layi. 
Fitarwa rubuta: (Ƙamus sabo), sabon-layi. 
