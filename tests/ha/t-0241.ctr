

Rubutu idan: ['evaluate'] yi: {
	>> lamba-tsari := Fayil sabo: ['/tmp/eval.ctr'].
	lamba-tsari rubuta: (kai rubutu + ['.']).
	Shiri yi-amfani: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Jeri ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q rubutu.
Fitarwa rubuta: x, sabon-layi.
>> y := Babu.
(['y := '] + x ) evaluate.
Fitarwa rubuta: y ? 0, sabon-layi.

q := Ƙamus sanya: ['\[''] a: ['\['quote\']'].
x := q rubutu.
Fitarwa rubuta: x, sabon-layi.
y := Babu.
(['y := '] + x ) evaluate.

>> q := (Ƙamus sabo) sanya:['\[''] a:['\['quote\[''].
Fitarwa rubuta: y ? ['\['quote\']'], sabon-layi.
