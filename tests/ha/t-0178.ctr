Shiri sarrafa-ƙwaƙwalwa: 0.

>> txt := ['Word Salad'].
Fitarwa rubuta: ['last index of ord = '] + (( txt matsayin-ƙarshe: ['ord'] ) - 0), sabon-layi.
Fitarwa rubuta: ['index of ord = '] + (( txt samu: ['ord'] ) - 0), sabon-layi.
Fitarwa rubuta: ['index of ad = '] + (( txt samu: ['ad'] ) - 0), sabon-layi.
Fitarwa rubuta: ['last index of W = '] + (( txt matsayin-ƙarshe: ['W'] ) - 0), sabon-layi.
Fitarwa rubuta: ['last index of d = '] + (( txt matsayin-ƙarshe: ['d'] ) - 0), sabon-layi.
Fitarwa rubuta: ['txt equals Word Salad = '] + ( txt = ['Word Salad'] ), sabon-layi.
Fitarwa rubuta: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), sabon-layi.
Fitarwa rubuta: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), sabon-layi.
Fitarwa rubuta: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), sabon-layi.

