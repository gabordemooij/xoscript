#ffi test


Server init.

Shiri sarrafa-ƙwaƙwalwa: 4.

# for this test you need set a path to libc (puts)
>> libname := Shiri saiti: ['FFITESTLIB'].



Server haɗi: (
 Jeri sabo ;
 libname ;
 ['puts'] ;
 ( Jeri sabo ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s saki.

# test with struct

>> a := Blob sabo: 8.
a bytes: (
	Jeri <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Jeri <<: ['int'], ; ['int']).

Server haɗi: (
	Jeri <<: ['@structtest'], ;
	['@structtest'] ;
	(Jeri <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Fitarwa rubuta: ['Sum test:'] + (ffitest ffisum: a), sabon-layi.

struct saki-struct.
struct saki.
a saki.
