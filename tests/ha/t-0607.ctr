>> Combination := Jeri sabo.

Combination idan: ['ƙara-a-ƙarshe:'] yi: { :el
	kai 
	samu: el, Babu? gaskiya: { kai ƙara-a-ƙarshe: el. }.
}.

>> colours := Combination sabo.
colours
	ƙara-a-ƙarshe: ['red'],
	ƙara-a-ƙarshe: ['green'],
	ƙara-a-ƙarshe: ['blue'],
	ƙara-a-ƙarshe: ['red'].

Fitarwa rubuta: colours, sabon-layi.
