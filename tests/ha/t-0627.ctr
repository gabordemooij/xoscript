

# create a 64-bit integer for exact calculations
>> a := Int64 daga-rubutu: ['123'].

# to string
Fitarwa rubuta: a, sabon-layi.

# divide
Fitarwa rubuta: a / (Int64 daga-rubutu: ['3']), sabon-layi.

# multiply
Fitarwa rubuta: a * (Int64 daga-rubutu: ['2']), sabon-layi.

# add
Fitarwa rubuta: a + (Int64 daga-rubutu: ['1']), sabon-layi.

# subtract
Fitarwa rubuta: a - (Int64 daga-rubutu: ['2']), sabon-layi.

# compare
Fitarwa rubuta: ( a =   (Int64 daga-rubutu: ['123'])), sabon-layi.
Fitarwa rubuta: ( a !=: (Int64 daga-rubutu: ['124'])), sabon-layi.
Fitarwa rubuta: ( a <   (Int64 daga-rubutu: ['124'])), sabon-layi.
Fitarwa rubuta: ( a >   (Int64 daga-rubutu: ['122'])), sabon-layi.
Fitarwa rubuta: ( a >=: (Int64 daga-rubutu: ['123'])), sabon-layi.
Fitarwa rubuta: ( a <=: (Int64 daga-rubutu: ['123'])), sabon-layi.





	