

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Shiri sarrafa-ƙwaƙwalwa: 0.

>> a := Jeri ← ['hello'] ; ['world'] ; Gaskiya ; Babu ; 666.
>> b := a daga: 2 tsawo: 2.
Fitarwa rubuta: ( b haɗa: ['|'] ), rubuta: b ƙidaya.

Shiri tsaftace.
usedMemory1 := (Shiri ƙwaƙwalwa ? 0).


a := Jeri ← ['hello'] ; ['world'] ; Gaskiya ; Babu ; 666.
b := a daga: 2 tsawo: 2.
Fitarwa rubuta: ( b haɗa: ['|'] ), rubuta: b ƙidaya.


Shiri tsaftace.
usedMemory2 := (Shiri ƙwaƙwalwa ? 0).


a := Jeri ← ['hello'] ; ['world'] ; Gaskiya ; Babu ; 666.
b := a daga: 2 tsawo: 2.
Fitarwa rubuta: ( b haɗa: ['|'] ), rubuta: b ƙidaya.


Shiri tsaftace.
usedMemory3 := (Shiri ƙwaƙwalwa ? 0).



( usedMemory1 = usedMemory2 da: usedMemory1 = usedMemory3, da: usedMemory2 = usedMemory3 ) gaskiya: {
