# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob sabo: 8, bytes: (
	Jeri sabo ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Fitarwa rubuta: ( utf16 warware-lamba: ['utf16le'] ), sabon-layi.

utf16 saki.
>> utf32 := Blob sabo: 13, bytes: (
	Jeri sabo ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Fitarwa rubuta: ( utf32 warware-lamba: ['utf32be'] ), sabon-layi.
utf32 saki.