Fitarwa rubuta: ['Test object'], sabon-layi.
>> a := Abu sabo. 

a idan: ['item:'] yi: { :octhelper
	nasa octhelper := octhelper. 
}.

a idan: ['item'] yi: { <- nasa octhelper.
}.

a item: Oct sabo.

>> old-octhelper-address := a item samfuri adireshin-ƙwaƙwalwa.
a save-as: ['/tmp/a.bin'].
Fitarwa rubuta: ['========== RELOADING SNAP:'], sabon-layi.

>> b := Abu load-from: ['/tmp/a.bin'].

(b item samfuri adireshin-ƙwaƙwalwa = old-octhelper-address) gaskiya: {
	Fitarwa rubuta: ['Object link re-attached.'], sabon-layi.
}.
