



>> CoffeeGrounds := Abu sabo.
CoffeeGrounds idan: ['extract'] yi: { <- ['coffee']. }.

>> CoffeeMachine := Abu sabo.
CoffeeMachine idan: ['init'] yi: {
	nasa coffeegrounds := CoffeeGrounds sabo.
}.
CoffeeMachine idan: ['sabo'] yi: { <- CoffeeMachine `new init.
}.

CoffeeMachine idan: ['makeTea'] yi: { <- (nasa tealeaves extract). }.
CoffeeMachine idan: ['makeCoffee'] yi: { <- (nasa coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine sabo.

Fitarwa rubuta:
	coffeeDream 
	makeCoffee.

Fitarwa rubuta:
	coffeeDream 
	makeTea.
