Jeri idan: ['kwafi'] yi: {
	>> kwafi := Jeri sabo.
	kai kowane: { :lamba :section
		kwafi ƙara-a-ƙarshe: section maimaita-kai kwafi.
	}. <- kwafi.
}.

>> sheep := Jeri sabo ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep kwafi.
clones kowane: { :lamba :sheep
	sheep ƙara-a-ƙarshe: ['2'].
}.

Fitarwa rubuta: sheep, sabon-layi.
Fitarwa rubuta: clones, sabon-layi.
