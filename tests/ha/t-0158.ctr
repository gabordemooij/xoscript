>> x := [' hallo '].

>> y := x manyan-haruffa.
Fitarwa rubuta: x, sabon-layi.
Fitarwa rubuta: (x iri-ɗaya: y), sabon-layi.

>> y := x ƙananan-haruffa.
Fitarwa rubuta: x, sabon-layi.
Fitarwa rubuta: (x iri-ɗaya: y), sabon-layi.

>> y := x datse.
Fitarwa rubuta: x, sabon-layi.
Fitarwa rubuta: (x iri-ɗaya: y), sabon-layi.

>> y := x tsallake: 1.
Fitarwa rubuta: x, sabon-layi.
Fitarwa rubuta: (x iri-ɗaya: y), sabon-layi.

>> y := x daga: 1 tsawo: 2.
Fitarwa rubuta: x, sabon-layi.
Fitarwa rubuta: (x iri-ɗaya: y), sabon-layi.