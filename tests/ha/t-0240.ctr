# test qualifiers

>> $ := Abu sabo.

$ idan: ['amsa:'] yi: { :x
	
	>> operation := x harafi: 0.
	>> valuta := x harafi: 1.
	>> money := x tsallake: 2.
	
	>> amount := 0.

	( operation = ['+'] ) gaskiya: {
		( valuta = ['£'] ) gaskiya: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Fitarwa rubuta: x, sabon-layi.


>> Fruit := Abu sabo.

Fruit idan: ['sabo'] yi: {
	>> f := kai sabo.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit idan: ['apples:'] yi: { :a nasa apples := a. }.
Fruit idan: ['oranges:'] yi: { :p nasa oranges := p. }.
Fruit idan: ['apples'] yi: { <- nasa apples. }.
Fruit idan: ['oranges'] yi: { <- nasa oranges. }.

Fruit idan: ['+'] yi: { :f
	
	>> n := Fruit sabo.
	f ƙara: 1.
	
	n apples: (f apples + nasa apples).
	n oranges:  (f oranges  + nasa oranges). <- n.
}.

Fruit idan: ['rubutu'] yi: { <- ( nasa apples rubutu + [' apples and '] + nasa oranges + [' oranges'] ).
}.

Lamba idan: ['apples'] yi: { <- ((Fruit sabo) apples: kai).
}.

Lamba idan: ['apple'] yi: { <- ((Fruit sabo) apples: kai).
}.

Lamba idan: ['oranges'] yi: { <- ((Fruit sabo) oranges: kai).
}.




Fitarwa rubuta: (1 apple + 3 oranges + 4 apples), sabon-layi.


Rubutu idan: ['twice'] yi: { <- ((kai rubutu) + (kai rubutu)).
}.



Fitarwa rubuta: ['❤❤❤'] twice.



