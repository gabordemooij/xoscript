Server init.

>> message := ['this is a string to be encrypted!'].
>> key := ['secret123!'].
>> vault := Asusu sabo: ['myvault'].

>> encrypted := vault ɓoye: message maɓalli: key.
>> decrypted := vault buɗe-ɓoye: encrypted maɓalli: key.

Fitarwa 
rubuta: ['Message:'], sabon-layi
rubuta: message, sabon-layi
rubuta: ['Decrypted:'], sabon-layi
rubuta: decrypted, sabon-layi.
