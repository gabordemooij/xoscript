
>> countries := Jeri sabo
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Jeri sabo
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods bisa: countries, kowane: { :key :value
	counter ƙara: 1.
}.

Fitarwa rubuta: (['we serve counter dishes'] counter: counter), sabon-layi.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] haruffa jera: { :v
	counter ƙara: 0.
}.

Fitarwa rubuta: (['we sort counter dishes'] counter: counter), sabon-layi.


>> counter := 0.
{
	{
		counter ƙara: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Fitarwa rubuta: (['we calculate counter numbers.'] counter: counter), sabon-layi.

