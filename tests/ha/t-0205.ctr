>> str := ['write:'].
Fitarwa saƙo: ['rubuta:'] hujjoji: (Jeri ← ['Hello World']), sabon-layi. 

Lamba idan: ['isbetween:and:'] yi: { :a :b <- ((kai ≥ a) da: (kai ≤ b)).
}.

str := ['isbetween:and:'].
Fitarwa rubuta: (3 saƙo: str hujjoji: (Jeri ← 2 ; 8)), sabon-layi.
Fitarwa rubuta: (3 saƙo: str hujjoji: (Jeri ← 1 ; 2)), sabon-layi.


>> CoffeeMachine := Abu sabo.
CoffeeMachine idan: ['makeCoffeeWithSugar:milk:'] yi: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Jeri ← 4 ; 2.
Fitarwa rubuta: ( CoffeeMachine saƙo: order hujjoji: coffeeConfiguration ), sabon-layi.
