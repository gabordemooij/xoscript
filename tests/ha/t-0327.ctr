

Jeri idan: ['fixture:'] yi: { :f
	nasa fixture := f.
}.

Jeri idan: ['ƙidaya'] yi: { <- nasa fixture.
}.

Jeri idan: ['aantal'] yi: { <- nasa fixture.
}.


>> x := Babu.
{

	x := ['hello'] 
	musanya:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] harafi: 2)
			)
		)
	da: (
		(['...hal'] + ['lo']) 
			manyan-haruffa 
			lowecase 
			manyan-haruffa 
			tsallake: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Jeri ← 0 ; 1 ; 4; 9 ; (Jeri ← 0 ; 3; 1) ; 4
							) kafin-na-ƙarshe
						) ? 1
					) + 
					((Jeri ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					ƙidaya
				)
			)
	).

} × 10.
Fitarwa rubuta: x, sabon-layi.

