Fitarwa rubuta: ['Test object'], sabon-layi.
>> greeter := Abu sabo.
greeter idan: ['name:'] yi: { :suna
	nasa xname := suna. 
}.
greeter idan: ['greet'] yi: {
	Fitarwa rubuta: ['Hello '] + nasa xname, sabon-layi.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Fitarwa rubuta: ['========== RELOADING SNAP:'], sabon-layi.
>> b := Abu load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
