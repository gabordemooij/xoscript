Server init.
Fitarwa rubuta: ['Database time test'], sabon-layi.

>> db := Maria-DB sabo mai-masauki: ['localhost'],
	sunan-mai-amfani: ['xo'], 
	kalmar-sirri: ['pass123'],
	sunan-rumbun-bayanai: ['xobase'],
	haɗu.

>> sigogin-nema :=
db tambaya: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
ɗauko: { :row
	Fitarwa rubuta: row timetest, sabon-layi.
}.
