>> t := Gaskiya.
(t = Gaskiya) gaskiya: { Fitarwa rubuta: ['T']. }.
(t = Ƙarya) gaskiya: { Fitarwa rubuta: ['F']. }.
Fitarwa rubuta: ['|'].
>> t := Ƙarya.
(t = Gaskiya) gaskiya: { Fitarwa rubuta: ['T']. }.
(t = Ƙarya) gaskiya: { Fitarwa rubuta: ['F']. }.
Fitarwa rubuta: ['|'].
>> f := Gaskiya.
(t = Gaskiya da: f = Ƙarya) gaskiya: { Fitarwa rubuta: ['T']. }.
(t = Ƙarya da: f = Gaskiya) gaskiya: { Fitarwa rubuta: ['F']. }.
Fitarwa rubuta: ['|'].
>> n := Babu.
(n Babu?) gaskiya: { Fitarwa rubuta: ['T']. }.
(n Babu?) ƙarya: { Fitarwa rubuta: ['F']. }.
Fitarwa rubuta: ['|'].
(f Boolean?) gaskiya: { Fitarwa rubuta: ['T']. }.
(f Boolean?) ƙarya: { Fitarwa rubuta: ['F']. }.



