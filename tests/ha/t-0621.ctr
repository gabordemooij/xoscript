>> phrases := Jeri sabo
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases kowane: { :_ :phrase 
	>> e := Server base64-ɓoye-lamba: phrase.
	>> d := Server base64-warware-lamba: e.
	Fitarwa rubuta: (
		message kwafi ~encoded: e, ~decoded: d
	), sabon-layi.
}.
