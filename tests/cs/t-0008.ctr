>> Pozdravovač := Objekt nový.
Pozdravovač při: ['vyrobit'] udělat: {
	>> pozdravovač := Objekt nový.
	pozdravovač při: ['name:'] udělat: { :název
		Výstup psát: ['nastavuji jméno'].
		vlastní moje-jméno := název.
	}.
	pozdravovač při: ['pozdravit'] udělat: {
		Výstup psát: ['Hello'].
		Výstup psát: vlastní moje-jméno.
	}. <- pozdravovač.
}.
>> pozdravovač := Pozdravovač vyrobit.
pozdravovač name: ['sluníčko!'].
pozdravovač pozdravit.
