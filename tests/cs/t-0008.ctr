>> Greeter := Objekt nový.
Greeter při: ['make'] udělat: {
	>> greeter := Objekt nový.
	greeter při: ['name:'] udělat: { :název
		Výstup psát: ['setting a name'].
		vlastní myName := název.
	}.
	greeter při: ['greet'] udělat: {
		Výstup psát: ['Hello'].
		Výstup psát: vlastní myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
