

>> g  := Server nový.
>> v  := Trezor nový.
>> ok := 0.

>> tajnosti := Seznam nový ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> hesla := tajnosti kopírovat.
hesla každý: { :i :p
	tajnosti každý: { :n :s
		{
			>> zašifrováno := v šifrovat: s klíč: p.
			>> dešifrováno := v dešifrovat: zašifrováno klíč: p.
			(dešifrováno = s) pravda: {
				ok přičíst: 1.
			}, jinak: {
				Výstup psát: ['šifrování/dešifrování selhalo: '], nový-řádek.
				Výstup psát: s, nový-řádek.
				Výstup psát: ['zašifrováno: '] + zašifrováno, nový-řádek.
				Výstup psát: ['dešifrováno: '] + zašifrováno, nový-řádek.
				Program konec.
			}.
		} chytit: { :chb
			(s = [''] nebo: p = ['']) pravda: {
				ok přičíst: 1.
			}, jinak: {
				Výstup psát: chb, nový-řádek.
				Program konec.
			}.
		}, spustit.
	}.
}.

Výstup psát: ( ok + [' šifrování trezoru otestováno.'] ), nový-řádek.