>> numbers := ['1,2,3'] rozdělit: [','].
Výstup psát: ['I got: '] + numbers počet + [' numbers.'],nový-řádek.
{ :i Výstup psát: ['number #'] + i + [':'] + (numbers pozice: i), nový-řádek.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages rozdělit: [' Or '].
Výstup psát: ['We serve'], nový-řádek.
{ :i Výstup psát: ['->'] + (beverages pozice: i), nový-řádek. } × (beverages počet).
Výstup psát: (beverages spojit: [',']), nový-řádek.
Výstup psát: (numbers spojit: ['||']).
