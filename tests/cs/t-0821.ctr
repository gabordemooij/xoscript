# uvozovka, která se nikdy neuzavře, musí vyvolat chybu, ne nekonečnou smyčku
>> cesta := ['/tmp/test0821.csv'].
>> file := Soubor nový: cesta.

file psát: ['a,b\n"1,2\n'].
{
	file oddělovač: [','] uvozovka: ['"'] řádky: { :line
		Výstup psát: line, nový-řádek.
	}.
} chytit: { :e Výstup psát: e, nový-řádek. }, spustit.

# uzavřená uvozovka stále funguje
file psát: ['a,b\n"1,2",3'].
file oddělovač: [','] uvozovka: ['"'] řádky: { :line
	Výstup psát: line, nový-řádek.
}.
file smazat.
