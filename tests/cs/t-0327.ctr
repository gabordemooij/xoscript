

Seznam při: ['fixture:'] udělat: { :f
	vlastní fixture := f.
}.

Seznam při: ['počet'] udělat: { <- vlastní fixture.
}.

Seznam při: ['aantal'] udělat: { <- vlastní fixture.
}.


>> x := Nic.
{

	x := ['hello'] 
	nahradit:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] znak: 2)
			)
		)
	za: (
		(['...hal'] + ['lo']) 
			velkými-písmeny 
			lowecase 
			velkými-písmeny 
			přeskočit: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Seznam ← 0 ; 1 ; 4; 9 ; (Seznam ← 0 ; 3; 1) ; 4
							) druhý-od-konce
						) ? 1
					) + 
					((Seznam ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					počet
				)
			)
	).

} × 10.
Výstup psát: x, nový-řádek.

