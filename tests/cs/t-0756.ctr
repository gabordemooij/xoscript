Výstup psát: ['Testovací objekt'], nový-řádek.
>> pozdravovač := Objekt nový.
pozdravovač při: ['name:'] udělat: { :název
	vlastní xjméno := název. 
}.
pozdravovač při: ['pozdravit'] udělat: {
	Výstup psát: ['Nazdar '] + vlastní xjméno, nový-řádek.
}.
pozdravovač name: ['Sherlock'].
pozdravovač save-as: ['/tmp/a.bin'].
pozdravovač save-as: ['/tmp/b.bin'].
Výstup psát: ['========== OPĚTOVNÉ NAČTENÍ SNÍMKU:'], nový-řádek.
>> b := Objekt load-from: ['/tmp/a.bin'].
>> c := Objekt load-from: ['/tmp/b.bin'].
b pozdravit.
b name: ['Watson'], pozdravit.
c name: ['Moriarty'], pozdravit.
