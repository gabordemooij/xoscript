Výstup psát: ['Pokračování smyčky for, Ne - před 6 a výš.'], nový-řádek.
{ :i
	Výstup psát: (i + 1), nový-řádek.
	((i + 1) > 4) pokračovat.
	Výstup psát: ['-'].
} × 10.

>> x := 0.
>> x-je-menší-než-10 := { <- ( x < 10 ). }.
Výstup nový-řádek.
Výstup psát: ['Pokračování while-true, Ne --> před 5 a výš.'], nový-řádek.
{
	Výstup psát: ['iteration #'] + x, nový-řádek.
	x přičíst: 1.
	((x < 5) ne) pokračovat.
	Výstup psát: ['-->'].
} zatímco: x-je-menší-než-10.
Výstup nový-řádek.
Výstup psát: ['Pokračování while-false, Ne - jen před 3.'], nový-řádek.
{
	Výstup psát: ['iteration #'] + x, nový-řádek.
	x odečíst: 1.
	(x = 3) pokračovat.
	Výstup psát: ['-'].
} zatímco: { <- ( x > 0). }.

Výstup nový-řádek.
Výstup psát: ['Pokračování smyčky times, Ne ||| před 3.'], nový-řádek.
{ :i
	Výstup psát: ['iteration #'] + i, nový-řádek.
	(i = 2) pokračovat.
	Výstup psát: ['|||'].
} × 5.

Výstup nový-řádek.

{ Pravda pokračovat. Výstup psát: ['tohle nepiš!'], nový-řádek. } spustit.

{ Pravda pokračovat. Výstup psát: ['tohle nepiš!'], nový-řádek. } chytit: { Výstup psát: ['Tohle nechytej!']. }, spustit.

Výstup psát: ['Test smyčky each pole: 0, ... ,2'], nový-řádek.
(Seznam ← 1 ; 2 ; 3) zobrazit: { :i
	(i = 1) pokračovat.
	Výstup psát: ['iteration #'] + (i - 0), nový-řádek.
}.

Výstup psát: ['Test smyčky each mapy: jen c'], nový-řádek.
>> m := Slovník nový.
m umístit: ['first'] na: ['a'], umístit: ['second'] na: ['b'], umístit: ['třetí'] na: ['c'].
m každý: { :k :v
	(k ≠ ['c']) pokračovat.
	Výstup psát: ['iteration'] + k + v, nový-řádek.
}.

