Výstup psát: ['Continue for-loop, No - before 6 and up.'], nový-řádek.
{ :i
	Výstup psát: (i + 1), nový-řádek.
	((i + 1) > 4) pokračovat.
	Výstup psát: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Výstup nový-řádek.
Výstup psát: ['Continue while-true, No --> before 5 and up.'], nový-řádek.
{
	Výstup psát: ['iteration #'] + x, nový-řádek.
	x přičíst: 1.
	((x < 5) ne) pokračovat.
	Výstup psát: ['-->'].
} zatímco: xIsLessThan10.
Výstup nový-řádek.
Výstup psát: ['Continue while-false, No - before 3 only.'], nový-řádek.
{
	Výstup psát: ['iteration #'] + x, nový-řádek.
	x odečíst: 1.
	(x = 3) pokračovat.
	Výstup psát: ['-'].
} zatímco: { <- ( x > 0). }.

Výstup nový-řádek.
Výstup psát: ['Continue times-loop, No ||| before 3.'], nový-řádek.
{ :i
	Výstup psát: ['iteration #'] + i, nový-řádek.
	(i = 2) pokračovat.
	Výstup psát: ['|||'].
} × 5.

Výstup nový-řádek.

{ Pravda pokračovat. Výstup psát: ['dont write this!'], nový-řádek. } spustit.

{ Pravda pokračovat. Výstup psát: ['dont write this!'], nový-řádek. } chytit: { Výstup psát: ['Dont catch this!']. }, spustit.

Výstup psát: ['Test Array each-loop: 0, ... ,2'], nový-řádek.
(Seznam ← 1 ; 2 ; 3) zobrazit: { :i
	(i = 1) pokračovat.
	Výstup psát: ['iteration #'] + (i - 0), nový-řádek.
}.

Výstup psát: ['Test Map each-loop: c only'], nový-řádek.
>> m := Slovník nový.
m umístit: ['first'] na: ['a'], umístit: ['second'] na: ['b'], umístit: ['third'] na: ['c'].
m každý: { :k :v
	(k ≠ ['c']) pokračovat.
	Výstup psát: ['iteration'] + k + v, nový-řádek.
}.

