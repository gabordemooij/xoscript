Server init.

Výstup psát: (
	Vzor nový: ['^\\w+$'],
	shoda: ['test@example.com'] 
), nový-řádek. # 0 shod, selže na @ a .

Výstup psát: (
	Vzor nový: ['^[^@]+@[^\.]+\.\\w+$'],
	shoda: ['test@example.com'] 
), nový-řádek. # 1 shoda

Výstup psát: (
	Vzor nový: ['[^@]+@[^\.]+\.\\w+'],
	shoda: ['test@example.com'] 
), nový-řádek. # 1 shoda

Výstup psát: (
	Vzor nový: ['([^@]+)@([^\.]+)\.\\w+'],
	shoda: ['test@example.com'] 
), nový-řádek. # 1 shoda, na skupinách nezáleží

Výstup psát: (
	Vzor nový: ['[a-z]'],
	shoda: ['test@example.com'] 
), nový-řádek. # 14 shod

Výstup psát: (
	Vzor nový: ['.*'],
	shoda: ['test@example.com'] 
), nový-řádek. # 1 shoda (celá)

Výstup psát: (
	Vzor nový: ['(.*)'],
	shoda: ['test@example.com'] 
), nový-řádek. # 1 shoda (celá)

Výstup psát: (
	Vzor nový: ['\\s*[^@]+@[^\.]+\.\\w+'],
	shoda: ['test@example.com'] 
), nový-řádek. # 1 shoda, mezera před je volitelná, ignoruje se