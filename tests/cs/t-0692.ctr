Server init.

Výstup psát: (
	Vzor nový: ['^\\w+$'],
	shoda: ['test@example.com'] 
), nový-řádek. # 0 match, fails on @ and .

Výstup psát: (
	Vzor nový: ['^[^@]+@[^\.]+\.\\w+$'],
	shoda: ['test@example.com'] 
), nový-řádek. # 1 match

Výstup psát: (
	Vzor nový: ['[^@]+@[^\.]+\.\\w+'],
	shoda: ['test@example.com'] 
), nový-řádek. # 1 match

Výstup psát: (
	Vzor nový: ['([^@]+)@([^\.]+)\.\\w+'],
	shoda: ['test@example.com'] 
), nový-řádek. # 1 match, groups dont matter

Výstup psát: (
	Vzor nový: ['[a-z]'],
	shoda: ['test@example.com'] 
), nový-řádek. # 14 matches

Výstup psát: (
	Vzor nový: ['.*'],
	shoda: ['test@example.com'] 
), nový-řádek. # 1 match (all)

Výstup psát: (
	Vzor nový: ['(.*)'],
	shoda: ['test@example.com'] 
), nový-řádek. # 1 match (all)

Výstup psát: (
	Vzor nový: ['\\s*[^@]+@[^\.]+\.\\w+'],
	shoda: ['test@example.com'] 
), nový-řádek. # 1 match, prefix space optional, gets ignored