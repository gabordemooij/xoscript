# test operací se seznamy


>> dorty := Seznam ←
	['apple'] ;
	['bobule'] ;
	['čoko'] ;
	['sýr'].


>> koupit := dorty nahradit: 1 délka: 2 za: ( Seznam ← ['skořice'] ; ['ananas'] ).
Výstup psát: (koupit spojit: [',']), nový-řádek.


>> koupit := dorty nahradit: 1 délka: 12 za: ( Seznam ← ['skořice'] ; ['ananas'] ).
Výstup psát: (koupit spojit: [',']), nový-řádek.


>> koupit := dorty nahradit: 2 délka: 10 za: ( Seznam nový ).
Výstup psát: (koupit spojit: [',']), nový-řádek.


>> koupit := dorty nahradit: 0 délka: 1 za: ( Seznam nový ).
Výstup psát: (koupit spojit: [',']), nový-řádek.


>> koupit := dorty nahradit: ['0'] délka: ['1'] za: ['x'].
Výstup psát: (koupit spojit: [',']), nový-řádek.
