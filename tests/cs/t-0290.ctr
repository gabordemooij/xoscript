# test list operations


>> cakes := Seznam ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes nahradit: 1 délka: 2 za: ( Seznam ← ['cinnamon'] ; ['pineapple'] ).
Výstup psát: (buy spojit: [',']), nový-řádek.


>> buy := cakes nahradit: 1 délka: 12 za: ( Seznam ← ['cinnamon'] ; ['pineapple'] ).
Výstup psát: (buy spojit: [',']), nový-řádek.


>> buy := cakes nahradit: 2 délka: 10 za: ( Seznam nový ).
Výstup psát: (buy spojit: [',']), nový-řádek.


>> buy := cakes nahradit: 0 délka: 1 za: ( Seznam nový ).
Výstup psát: (buy spojit: [',']), nový-řádek.


>> buy := cakes nahradit: ['0'] délka: ['1'] za: ['x'].
Výstup psát: (buy spojit: [',']), nový-řádek.
