>> opakovač := Objekt nový.
opakovač při: ['odpovědět:'] udělat: { :co
	Výstup psát: co + [' '].
}.
opakovač při: ['odpovědět:a:'] udělat: { :co :say
	Výstup psát: co, psát: say + [' '].
}.
opakovač při: ['odpovědět:a:a:'] udělat: { :co :say :více
	Výstup psát: co, psát: say, psát: více.
}.
opakovač opakovat.
opakovač everything: ['Říkám.'].
opakovač and: ['I '] everything: ['dělám.'].
