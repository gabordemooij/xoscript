>> makeAdder := { :x
	>> f := { :y <- (vlastní x + y). } nastavit: ['x'] na: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i vlastní q umístit: (vlastní f aplikovat: (vlastní q ? i)) na: i. } 
	nastavit: ['q'] na: array,
	nastavit: ['f'] na: func.
	{ :i mapping aplikovat: i. } × (array počet).
}.

>> a := Seznam ← 1; 2; 3.
mapper aplikovat: a a: (makeAdder aplikovat: 100).
Výstup psát: (a pozice: 0), nový-řádek.
Výstup psát: (a ? 1), nový-řádek.
Výstup psát: (a ? 2), nový-řádek.
