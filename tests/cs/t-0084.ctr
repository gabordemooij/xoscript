>> vytvořit-sčítačku := { :x
	>> f := { :y <- (vlastní x + y). } nastavit: ['x'] na: x. <- f.
}.
>> mapovač := { :pole :fce
	>> mapovací-funkce := { :i vlastní q umístit: (vlastní f aplikovat: (vlastní q ? i)) na: i. } 
	nastavit: ['q'] na: pole,
	nastavit: ['f'] na: fce.
	{ :i mapovací-funkce aplikovat: i. } × (pole počet).
}.

>> a := Seznam ← 1; 2; 3.
mapovač aplikovat: a a: (vytvořit-sčítačku aplikovat: 100).
Výstup psát: (a pozice: 0), nový-řádek.
Výstup psát: (a ? 1), nový-řádek.
Výstup psát: (a ? 2), nový-řádek.
