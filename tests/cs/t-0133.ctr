


>> Deck := Seznam nový.
Deck při: ['print'] udělat: {
        >> len := sebe počet - 1.
        { :i
                >> len2 := sebe počet - 1.
                Výstup psát: ['len: '].
                Výstup psát: len, nový-řádek.
                Výstup psát: ['len2: '].
                Výstup psát: len2, nový-řádek.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
