# test databáze
# potřebnou konfiguraci viz příklad server.xo

Server init.
Výstup psát: ['Test databáze'], nový-řádek.

>> db := Maria-DB nový hostitel: ['localhost'],
	uživatel: ['xo'], heslo: ['pass123'], název-databáze: ['xobase'], připojit.

Výstup psát: ['Lze se připojit? '] + db připojeno?, nový-řádek.

>> parametry-hledání := db dotaz: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parametry: ( Seznam nový ; ['abc'] ; 12.35 ; 6 ). # parametrizované dotazy

{  parametry-hledání provést. db potvrdit. } chytit: { :e db vrátit-zpět.  }, spustit.

Výstup psát: ['Lze vkládat? '] + ( parametry-hledání insert-id > 0 ), nový-řádek.

>> x := 0.
>> parametry-hledání :=
db dotaz: ['SELECT * FROM book order by id desc limit 2'], 
načíst: { :řádka 
	x přičíst: 1.
	Pravda přestat. # musí uklidit, žádné 'Commands out of sync'
}.

>> parametry-hledání :=
db dotaz: ['SELECT * FROM book order by id desc limit 2'], 
načíst: { :řádka
	x přičíst: 1.
	Pravda přestat.
}.

(x > 0) pravda: {
	Výstup psát: ['Lze přerušit uprostřed načítání? '].
}.

Výstup psát: Pravda, nový-řádek.