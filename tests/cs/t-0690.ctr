# database test
# see example server.xo for required config

Server init.
Výstup psát: ['Database test'], nový-řádek.

>> db := Maria-DB nový hostitel: ['localhost'],
	uživatel: ['xo'], heslo: ['pass123'], název-databáze: ['xobase'], připojit.

Výstup psát: ['Can we connect? '] + db připojeno?, nový-řádek.

>> parametry-hledání := db dotaz: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parametry: ( Seznam nový ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  parametry-hledání provést. db potvrdit. } chytit: { :e db vrátit-zpět.  }, spustit.

Výstup psát: ['Can we insert? '] + ( parametry-hledání insert-id > 0 ), nový-řádek.

>> x := 0.
>> parametry-hledání :=
db dotaz: ['SELECT * FROM book order by id desc limit 2'], 
načíst: { :row 
	x přičíst: 1.
	Pravda přestat. # must clean up, no 'Commands out of sync'
}.

>> parametry-hledání :=
db dotaz: ['SELECT * FROM book order by id desc limit 2'], 
načíst: { :row
	x přičíst: 1.
	Pravda přestat.
}.

(x > 0) pravda: {
	Výstup psát: ['Can we break in the middle of a fetch? '].
}.

Výstup psát: Pravda, nový-řádek.