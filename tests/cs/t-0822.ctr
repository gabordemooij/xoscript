# méně parametrů než zástupných symbolů musí vyvolat chybu, ne čtení za koncem vazeb
Server init.

>> db := Maria-DB nový hostitel: ['localhost'],
	uživatel: ['xo'],
	heslo: ['pass123'],
	název-databáze: ['xobase'],
	připojit.

>> parametry-hledání := db dotaz: ['SELECT ? AS a, ? AS b, ? AS c'].
parametry-hledání parametry: (Seznam nový ; ['1']).
{ parametry-hledání načíst: { :řádka Výstup psát: řádka, nový-řádek. }. } chytit: { :e Výstup psát: e, nový-řádek. }, spustit.

>> parametry-hledání := db dotaz: ['SELECT ? AS a'].
{ parametry-hledání načíst: { :řádka Výstup psát: řádka, nový-řádek. }. } chytit: { :e Výstup psát: e, nový-řádek. }, spustit.

# správný počet stále funguje, nadbytečné parametry se jako dříve ignorují
>> parametry-hledání := db dotaz: ['SELECT ? AS a, ? AS b'].
parametry-hledání parametry: (Seznam nový ; ['1'] ; ['2']).
parametry-hledání načíst: { :řádka Výstup psát: (řádka na: ['a']), psát: (řádka na: ['b']), nový-řádek. }.
parametry-hledání parametry: (Seznam nový ; ['1'] ; ['2'] ; ['3']).
parametry-hledání načíst: { :řádka Výstup psát: (řádka na: ['a']), psát: (řádka na: ['b']), nový-řádek. }.
