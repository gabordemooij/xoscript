
>> Size := Objekt nový.
Size při: ['is:'] udělat: { :číslo
	číslo při: ['+'] udělat: { :číslo
		>> unit := číslo jednotka.
		>> factor := 1.
		
		unit
		v-případě: ['inch'] udělat: { factor := 0.0833. }. <- sebe + (číslo * factor).
	}. <- číslo.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Výstup psát: plank + edge, nový-řádek.
