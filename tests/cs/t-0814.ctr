# formát relační cookie, typ obsahu json, jen webové protokoly, svg zobrazené přímo
Server inicializovat.
Program použít: ['../../../src/xo/cs/webtools.xo'].

>> Falešný-požadavek := Objekt nový.
Falešný-požadavek při: ['value:'] udělat: { :hodnota
	vlastní hodnota := hodnota.
}.
Falešný-požadavek při: ['cookie:'] udělat: { :název
	<- vlastní hodnota.
}.

>> Testovací-relace := Relace-dočasný-soubor nový.
Testovací-relace při: ['načíst'] udělat: {
	<- Slovník nový.
}.
Testovací-relace při: ['identifikátor-relace'] udělat: {
	<- vlastní id.
}.

>> cookies := Seznam nový
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

cookies každý: { :i :cookie
	>> požadavek := Falešný-požadavek nový.
	požadavek value: cookie.
	>> správce := Testovací-relace nový.
	>> web := Webový-dokument nový.
	web požadavek: požadavek.
	web správce-relací: správce.
	web zahájit-relaci.
	Výstup psát: ( správce identifikátor-relace = cookie ), nový-řádek.
}.

>> web := Webový-dokument nový.
web json: (Slovník nový umístit: ['b'] na: ['a']).
Výstup psát: ['\n'], nový-řádek.

{ Síť get: ['file:///etc/hostname']. } chytit: { :e
	Výstup psát: e, nový-řádek.
}, spustit.

>> svg := Soubor nový: ['/tmp/test0814.svg'].
svg psát: ['<svg xmlns="x"></svg>'].
Výstup nový-řádek.
Server předat: ['test0814.svg'] prefix: ['/tmp/'].
svg smazat.
