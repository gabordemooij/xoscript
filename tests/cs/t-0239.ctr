Seznam při: ['sum'] udělat: {
	>> total := 0.
	sebe každý: { :index :element
		total přičíst: element.
	}. <- total.
}.

>> a := Pravda.



a při: ['řetězec'] udělat: {
	>> answer := Nic.
	( sebe = Pravda ) pravda: {
		answer := ['Yep'].
	}, jinak: {
		answer := ['Nope'].
	}. <- answer.
}.

a při: ['číslo'] udělat: {
	>> answer := Nic.
	( sebe = Pravda ) pravda: {
		answer := 10.
	}, jinak: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b při: ['řetězec'] udělat: { <- ['Devil'].
}.

b při: ['logický'] udělat: { <- Nepravda.
}.


Výstup psát: a, nový-řádek.  
Výstup psát: (90 + a), nový-řádek. 
Výstup psát: b, nový-řádek. 
Výstup psát: (Pravda a: b), nový-řádek.

a := Seznam ← ['hello'] ; ['world'] ; Pravda ; Nic ; 666. 
a := a + ( Seznam ← 1 ).
Výstup psát: a, nový-řádek.
Výstup psát: ((Slovník nový) umístit: Nic na: Nic), nový-řádek.
Výstup psát: a sum, nový-řádek. 


{
	a při: ['řetězec'] udělat: { <- Nic. }.
	a := [''] + a.
} chytit: { :error
	Výstup psát: ['Error noted: '] + error, nový-řádek.
}, spustit.



{
	a při: ['číslo'] udělat: { <- Nic. }.
	a := 3 × a.
} chytit: { :error
	Výstup psát: ['Error noted: '] + error, nový-řádek.
}, spustit.


{
	a při: ['logický'] udělat: { <- Nic. }.
	a := Pravda a: a. 
} chytit: { :error
	Výstup psát: ['Error noted: '] + error, nový-řádek.
}, spustit.





