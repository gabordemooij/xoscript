Seznam při: ['součet'] udělat: {
	>> celkem := 0.
	sebe každý: { :index :prvek
		celkem přičíst: prvek.
	}. <- celkem.
}.

>> a := Pravda.



a při: ['řetězec'] udělat: {
	>> odpověď := Nic.
	( sebe = Pravda ) pravda: {
		odpověď := ['Jo'].
	}, jinak: {
		odpověď := ['Kdepak'].
	}. <- odpověď.
}.

a při: ['číslo'] udělat: {
	>> odpověď := Nic.
	( sebe = Pravda ) pravda: {
		odpověď := 10.
	}, jinak: {
		odpověď := 20.
	}. <- odpověď.
}.

>> b := 666.

b při: ['řetězec'] udělat: { <- ['Ďábel'].
}.

b při: ['logický'] udělat: { <- Nepravda.
}.


Výstup psát: a, nový-řádek.  
Výstup psát: (90 + a), nový-řádek. 
Výstup psát: b, nový-řádek. 
Výstup psát: (Pravda a: b), nový-řádek.

a := Seznam ← ['hello'] ; ['world'] ; Pravda ; Nic ; 666. 
a := a + ( Seznam ← 1 ).
Výstup psát: a, nový-řádek.
Výstup psát: ((Slovník nový) umístit: Nic na: Nic), nový-řádek.
Výstup psát: a součet, nový-řádek. 


{
	a při: ['řetězec'] udělat: { <- Nic. }.
	a := [''] + a.
} chytit: { :chyba
	Výstup psát: ['Zaznamenaná chyba: '] + chyba, nový-řádek.
}, spustit.



{
	a při: ['číslo'] udělat: { <- Nic. }.
	a := 3 × a.
} chytit: { :chyba
	Výstup psát: ['Zaznamenaná chyba: '] + chyba, nový-řádek.
}, spustit.


{
	a při: ['logický'] udělat: { <- Nic. }.
	a := Pravda a: a. 
} chytit: { :chyba
	Výstup psát: ['Zaznamenaná chyba: '] + chyba, nový-řádek.
}, spustit.





