# test číslo -> řetězec -> číslo
{

	>> x := Číslo mezi: 0 a: 1000000.
	>> d := Číslo mezi: 1 a: 7.
	>> e := 10 umocnit-na: d.

	x vydělit: e.
	>> y := x řetězec číslo.

	(x = y) nepravda: {
		Výstup psát: x, nový-řádek.
		Výstup psát: y, nový-řádek.
		Program konec.
	}.

} * 1000.
Výstup psát: ['OK'], nový-řádek.