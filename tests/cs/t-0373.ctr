# compliance test

# use international numbers

Výstup psát: ['1000 -> '].
Výstup psát: 1000, nový-řádek. #1000

Výstup psát: ['1.5 -> '].
Výstup psát: 1.5, nový-řádek.  #1.5

Výstup psát: ['1001.5 -> '].
Výstup psát: 1.5 + 1000, nový-řádek. #1001.5

# use 0-indexed arrays
>> x := Seznam nový ; 1 ; 2 ; 3.
>> y := Seznam nový ; ['a'] ; ['b'] ; ['c'].

Výstup psát: ['1 -> '].
Výstup psát: x ? 0, nový-řádek. #1

Výstup psát: ['1 -> '].
Výstup psát: (x na: 0), nový-řádek. #1

Výstup psát: ['1 -> '].
Výstup psát: x první, nový-řádek. #1

Výstup psát: ['3 -> '].
Výstup psát: x poslední, nový-řádek. #3

Výstup psát: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Výstup psát: (x podle: y), nový-řádek.

Výstup psát: ['1 -> '].
Výstup psát: (x od: 0 délka: 1) první, nový-řádek. #1

Výstup psát: ['0 -> '].
Výstup psát: (x hledat: 1), nový-řádek. #0

x umístit: 9 na: 0.

Výstup psát: ['9 -> '].
Výstup psát: (x na: 0), nový-řádek. #9

x předřadit: 8.
Výstup psát: ['8 -> '].
Výstup psát: (x na: 0), nový-řádek. #9


x připojit: 10.
Výstup psát: ['10 -> '].
Výstup psát: (x na: 4), nový-řádek. #10








