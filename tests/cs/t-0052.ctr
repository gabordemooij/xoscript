>> items := Slovník nový.
items umístit: ['zelená'] na: ['color-1'].
items umístit: ['oranžová'] na: ['color-2'].
items umístit: ['červená'] na: ['color-3'].
>> i := 0.
>> s := [''].
items každý: { :key :barva
	Výstup psát: ['color #'] + i + [' je: '] + barva + [' '].
	i přičíst: 1.
}.
Výstup psát: i + [' barev!'].
