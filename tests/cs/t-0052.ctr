>> items := Slovník nový.
items umístit: ['green'] na: ['color-1'].
items umístit: ['orange'] na: ['color-2'].
items umístit: ['red'] na: ['color-3'].
>> i := 0.
>> s := [''].
items každý: { :key :color
	Výstup psát: ['color #'] + i + [' is: '] + color + [' '].
	i přičíst: 1.
}.
Výstup psát: i + [' colors!'].
