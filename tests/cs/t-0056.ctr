>> z := Objekt nový.
z při: ['value:'] udělat: { :v
	vlastní value := v. <- sebe.
}.
z při: ['value'] udělat: { <- vlastní value. }.
(z setValue: 1) value: 2.
Výstup psát: z value.
>> x := z.
Výstup psát: x value.
z := Nic.
Výstup psát: z value.
Výstup psát: x value.
Výstup psát: ['hello'].
Výstup psát: 3 + 2.
Výstup psát: (3 > 2).
