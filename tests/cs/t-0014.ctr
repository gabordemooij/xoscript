>> Pozdravovač := Objekt nový.
Pozdravovač při: ['vyrobit'] udělat: {
	>> pz := Objekt nový.
	pz při: ['setName:'] udělat: { :jméno
		vlastní název := jméno.
	}.
	pz při: ['pozdravit'] udělat: {
		Výstup psát: vlastní název.
	}. <- pz.
}.
>> a := Pozdravovač vyrobit.
>> b := Pozdravovač vyrobit.
a setName: ['JEDNA'].
b setName: ['DVA'].
a pozdravit.
b pozdravit.
>> c := a nový.
c setName: ['TŘI'].
c pozdravit.
>> d := a nový.
d setName: ['ČTYŘI'].
d pozdravit.
c pozdravit.
