>> Greeter := Objekt nový.
Greeter při: ['make'] udělat: {
	>> gr := Objekt nový.
	gr při: ['setName:'] udělat: { :aname
		vlastní název := aname.
	}.
	gr při: ['greet'] udělat: {
		Výstup psát: vlastní název.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a nový.
c setName: ['THREE'].
c greet.
>> d := a nový.
d setName: ['FOUR'].
d greet.
c greet.
