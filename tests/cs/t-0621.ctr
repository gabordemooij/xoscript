>> věty := Seznam nový
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> vzkaz := ['Phrase: ~decoded base64: ~encoded'].
	
věty každý: { :_ :věta 
	>> e := Server base64-kódovat: věta.
	>> d := Server base64-dekódovat: e.
	Výstup psát: (
		vzkaz kopírovat ~encoded: e, ~decoded: d
	), nový-řádek.
}.
