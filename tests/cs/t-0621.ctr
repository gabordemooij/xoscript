>> phrases := Seznam nový
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases každý: { :_ :phrase 
	>> e := Server base64-kódovat: phrase.
	>> d := Server base64-dekódovat: e.
	Výstup psát: (
		message kopírovat ~encoded: e, ~decoded: d
	), nový-řádek.
}.
