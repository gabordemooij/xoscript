


>> víno := Objekt nový.


víno při: ['na-řetězec'] udělat: { <- ['merlot'].
}.

víno při: ['naarTekst'] udělat: { <- ['merlot'].
}.


víno při: ['='] udělat: { :other wine <- ( sebe na-řetězec = other wine ).
}.

víno při: ['=='] udělat: { :other wine <- ( sebe na-řetězec = other wine ).
}.



víno
	v-případě: ['cabernet'] udělat: { Výstup psát: ['je to Cabernet!']. },
	v-případě: ['syrah']    udělat: { Výstup psát: ['je to Syrah!'].    },
	v-případě: ['merlot']   udělat: { Výstup psát: ['je to Merlot!'].   },
	v-případě: ['malbec']   udělat: { Výstup psát: ['je to Malbec!'].   }.

