


>> wine := Objekt nový.


wine při: ['toString'] udělat: { <- ['merlot'].
}.

wine při: ['naarTekst'] udělat: { <- ['merlot'].
}.


wine při: ['='] udělat: { :other wine <- ( sebe toString = other wine ).
}.

wine při: ['=='] udělat: { :other wine <- ( sebe toString = other wine ).
}.



wine
	v-případě: ['cabernet'] udělat: { Výstup psát: ['it's a Cabernet!']. },
	v-případě: ['syrah']    udělat: { Výstup psát: ['it's a Syrah!'].    },
	v-případě: ['merlot']   udělat: { Výstup psát: ['it's a Merlot!'].   },
	v-případě: ['malbec']   udělat: { Výstup psát: ['it's a Malbec!'].   }.

