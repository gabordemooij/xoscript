>> Point := Objekt nový.
Point při: ['x-coordinate:'] udělat: { :x vlastní x := x. }.
Point při: ['y-coordinate:'] udělat: { :y vlastní y := y. }.
Point při: ['x-coordinate']  udělat: { <- vlastní x kopírovat. }.
Point při: ['y-coordinate']  udělat: { <- vlastní y kopírovat. }.

Point při: ['='] udělat: { :other <- ( vlastní x = other x-coordinate
		 a: vlastní y = other y-coordinate ).
}.

>> pier := Point nový x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point nový x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point nový x-coordinate: 5, y-coordinate: 6.

Výstup psát: pier = town-hall, nový-řádek.
Výstup psát: pier = restaurant, nový-řádek.
