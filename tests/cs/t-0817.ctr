# hodnota končící první částí otevírací uvozovky musí přežít serializaci
>> hodnoty := Seznam nový
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

hodnoty každý: { :i :value
	>> d := Slovník nový.
	d umístit: value na: ['k'].
	d umístit: ['second'] na: ['j'].
	>> r := d kód objekt.
	Výstup psát: r počet, nový-řádek.
	Výstup psát: ( (r na: ['k']) = value ), nový-řádek.
}.
