Server init.

# zapsat testovací soubor
>> f := Soubor nový: ['/tmp/test.gif'].
f psát: ['GIF87a01234567810'].

# poskytnout soubor
Server předat: ['test.gif'] prefix: ['/tmp/'].

Výstup nový-řádek.

Výstup psát: ['Mimo kontejner (bezpečnost):'], nový-řádek.
{ Server předat: ['../passwd'] prefix: ['/tmp/']. }
chytit: { :e Výstup psát: e, nový-řádek. },
spustit.

Výstup psát: ['Neplatný prefix:'], nový-řádek.
{ Server předat: ['test.gif'] prefix: ['z:\\']. }
chytit: { :e Výstup psát: e, nový-řádek. },
spustit.

Výstup psát: ['Neexistující soubor:'], nový-řádek.
{ Server předat: ['xxx.xxx'] prefix: ['/tmp/']. }
chytit: { :e Výstup psát: e, nový-řádek. },
spustit.
