Server init.

# write a test file
>> f := Soubor nový: ['/tmp/test.gif'].
f psát: ['GIF87a01234567810'].

# serve the file
Server předat: ['test.gif'] prefix: ['/tmp/'].

Výstup nový-řádek.

Výstup psát: ['Outside container (security):'], nový-řádek.
{ Server předat: ['../passwd'] prefix: ['/tmp/']. }
chytit: { :e Výstup psát: e, nový-řádek. },
spustit.

Výstup psát: ['Invalid prefix:'], nový-řádek.
{ Server předat: ['test.gif'] prefix: ['z:\\']. }
chytit: { :e Výstup psát: e, nový-řádek. },
spustit.

Výstup psát: ['Non-existant file:'], nový-řádek.
{ Server předat: ['xxx.xxx'] prefix: ['/tmp/']. }
chytit: { :e Výstup psát: e, nový-řádek. },
spustit.
