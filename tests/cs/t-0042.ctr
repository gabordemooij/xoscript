>> items := Slovník nový.
items umístit: ['černá'] na: ['coffee'], umístit: ['earl grey'] na: ['čaj'].
Výstup psát: (items na: ['coffee']), psát: (items na: ['čaj']).
Výstup psát: ['pole obsahuje'] + items počet + [' položek.'].
items umístit: ['kapučíno'] na: ['coffee'].
Výstup psát: ['Teď je moje káva.. '] + (items na: ['coffee']).
items umístit: ['aaa'] na: ['1'].
items umístit: ['bbb'] na: ['2'].
Výstup psát: (items na: ['a']).
