>> items := Slovník nový.
items umístit: ['black'] na: ['coffee'], umístit: ['earl grey'] na: ['tea'].
Výstup psát: (items na: ['coffee']), psát: (items na: ['tea']).
Výstup psát: ['there are'] + items počet + [' items in the array.'].
items umístit: ['capuccino'] na: ['coffee'].
Výstup psát: ['Now my coffee is.. '] + (items na: ['coffee']).
items umístit: ['aaa'] na: ['1'].
items umístit: ['bbb'] na: ['2'].
Výstup psát: (items na: ['a']).
