

Řetězec při: ['vyhodnotit'] udělat: {
	>> kód := Soubor nový: ['/tmp/eval.ctr'].
	kód psát: sebe řetězec + ['.'].
	Program použít: ['/tmp/eval.ctr'].
}.

>> a := (Seznam ← (
	(Slovník nový)
		umístit: ['doména'] na: ['mywebsite.com'],
		umístit: (Seznam ←
			((Slovník nový)
				umístit: ['domů'] na: ['title'],
				umístit: ['<html></html>'] na: ['body'],
				umístit: ['2017-01-01'] na: ['vytvořeno']
			) ;
			((Slovník nový)
				umístit: ['onás(c)'] na: ['title'],
				umístit: ['<credits>Author Inc.</credits>'] na: ['body']
			)
		) na: ['stránky']
	)
) řetězec.

Výstup psát: a typ, nový-řádek.
Výstup psát: a, nový-řádek.

>> b := Nic.
(['b := '] + a) vyhodnotit.
Výstup psát: b ? 0 ? ['stránky'] ? 1 ? ['body'], nový-řádek.

>> c := b ? 0.
>> d := c řetězec.
Výstup psát: d typ, nový-řádek.

>> e := Nic.
(['e := '] + d) vyhodnotit.
Výstup psát: e ? ['stránky'] ? 0, nový-řádek.
