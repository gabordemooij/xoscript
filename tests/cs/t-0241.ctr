

Řetězec při: ['vyhodnotit'] udělat: {
	>> kód := Soubor nový: ['/tmp/eval.ctr'].
	kód psát: (sebe řetězec + ['.']).
	Program použít: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Seznam ← (['Uvozovky '] + Q + [' jsou zlo?']) ; 1.
>> x := q řetězec.
Výstup psát: x, nový-řádek.
>> y := Nic.
(['y := '] + x ) vyhodnotit.
Výstup psát: y ? 0, nový-řádek.

q := Slovník umístit: ['\[''] na: ['\['quote\']'].
x := q řetězec.
Výstup psát: x, nový-řádek.
y := Nic.
(['y := '] + x ) vyhodnotit.

>> q := (Slovník nový) umístit:['\[''] na:['\['quote\[''].
Výstup psát: y ? ['\['quote\']'], nový-řádek.
