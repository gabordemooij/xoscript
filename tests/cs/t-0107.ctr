
Výstup psát: ['Přerušení smyčky for, 0-4.'], nový-řádek.
{ :i
	Výstup psát: ['iteration #'] + i, nový-řádek.
	(i = 4) přestat.
} × 10.

>> x := 0.
>> x-je-menší-než-10 := { <- ( x < 10 ). }.

Výstup psát: ['Přerušení smyčky while-true, 0-4.'], nový-řádek.
{
	Výstup psát: ['iteration #'] + x, nový-řádek.
	x přičíst: 1.
	((x < 5) ne) přestat.
} zatímco: x-je-menší-než-10.

Výstup psát: ['Přerušení smyčky while-false, 5,4.'], nový-řádek.
{
	Výstup psát: ['iteration #'] + x, nový-řádek.
	x odečíst: 1.
	(x = 3) přestat.
} zatímco: { <- (x > 0). }.

Výstup psát: ['Přerušení smyčky times, 1-4.'], nový-řádek.
{ :i
	Výstup psát: ['iteration #'] + i, nový-řádek.
	(i = 4) přestat.
} × 5.

Výstup psát: ['Přerušení bloku, řádek netiskni.'], nový-řádek.
{ Pravda přestat. Výstup psát: ['tohle nepiš!'], nový-řádek. } spustit.

Výstup psát: ['Přerušení bloku, nespouštěj catch...'], nový-řádek.
{ Pravda přestat. Výstup psát: ['tohle nepiš!'], nový-řádek. } chytit: { Výstup psát: ['Tohle nechytej!']. }, spustit.

Výstup psát: ['Test smyčky each pole: 0,1'], nový-řádek.
(Seznam ← 1 ; 2 ; 3) zobrazit: { :i
	Výstup psát: ['iteration #'] + i, nový-řádek.
	(i = 1) přestat.
}.

Výstup psát: ['Test smyčky each mapy: jen c'], nový-řádek.
>> m := Slovník nový.
m umístit: ['first'] na: ['a'], umístit: ['second'] na: ['b'], umístit: ['třetí'] na: ['c'].
m každý: { :k :v
	Výstup psát: ['iteration'] + v + k, nový-řádek.
	Pravda přestat.
}.

