
Výstup psát: ['Break for-loop, 0-4.'], nový-řádek.
{ :i
	Výstup psát: ['iteration #'] + i, nový-řádek.
	(i = 4) přestat.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Výstup psát: ['Break while-true loop, 0-4.'], nový-řádek.
{
	Výstup psát: ['iteration #'] + x, nový-řádek.
	x přičíst: 1.
	((x < 5) ne) přestat.
} zatímco: xIsLessThan10.

Výstup psát: ['Break while-false loop, 5,4.'], nový-řádek.
{
	Výstup psát: ['iteration #'] + x, nový-řádek.
	x odečíst: 1.
	(x = 3) přestat.
} zatímco: { <- (x > 0). }.

Výstup psát: ['Break times loop, 1-4.'], nový-řádek.
{ :i
	Výstup psát: ['iteration #'] + i, nový-řádek.
	(i = 4) přestat.
} × 5.

Výstup psát: ['Break block, dont print line.'], nový-řádek.
{ Pravda přestat. Výstup psát: ['dont write this!'], nový-řádek. } spustit.

Výstup psát: ['Break block, dont fire catch...'], nový-řádek.
{ Pravda přestat. Výstup psát: ['dont write this!'], nový-řádek. } chytit: { Výstup psát: ['Dont catch this!']. }, spustit.

Výstup psát: ['Test Array each-loop: 0,1'], nový-řádek.
(Seznam ← 1 ; 2 ; 3) zobrazit: { :i
	Výstup psát: ['iteration #'] + i, nový-řádek.
	(i = 1) přestat.
}.

Výstup psát: ['Test Map each-loop: c only'], nový-řádek.
>> m := Slovník nový.
m umístit: ['first'] na: ['a'], umístit: ['second'] na: ['b'], umístit: ['third'] na: ['c'].
m každý: { :k :v
	Výstup psát: ['iteration'] + v + k, nový-řádek.
	Pravda přestat.
}.

