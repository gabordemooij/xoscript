
Program správa-paměti: 4.

>> Zvíře := Objekt nový.
Zvíře při: ['vyrobit'] udělat: {
	>> zvíře := Objekt nový.
	zvíře při: ['vydat-zvuk'] udělat: {
		Výstup psát: vlastní zvuk.
	}. <- zvíře.
}.
>> Kočka := Objekt nový.
Kočka při: ['vyrobit'] udělat: {
	>> kočka := Zvíře vyrobit.
	kočka při: ['init'] udělat: {
		vlastní zvuk := ['meow!'].
	}.
	kočka init. <- kočka.
}.
>> tom := Kočka vyrobit.
tom vydat-zvuk.
