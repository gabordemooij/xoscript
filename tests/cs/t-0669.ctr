# Hešování hesel
Server init.

# Uživatel nastaví heslo
>> hsl := ['pass123'].

# Uložíte ho takto
>> otisk := Trezor 
	heš-hesla: hsl.

# Pak se uživatel přihlásí
# Pokus 1
>> a1 := ['abcd123'].
# Pokus 2
>> a2 := ['pass123'].

# Ověření
>> a := Trezor 
	heš-hesla: otisk ověřit: a1.
	# neúspěch 
>> b := Trezor
	heš-hesla: otisk ověřit: a2.
	# ok!

Výstup psát: a, nový-řádek.
Výstup psát: b, nový-řádek.

