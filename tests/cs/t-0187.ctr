Číslo při: ['faktoriál'] udělat: {
	>> celkem := 1.
	{ :index celkem vynásobit: (sebe - index). } × sebe. <- celkem.
}.

>> použitá-paměť1 := 0.
>> použitá-paměť2 := 0.
>> použitá-paměť3 := 0.
>> použitá-paměť4 := 0.

Program správa-paměti: 0.

{
2 exponent faktoriál.
Výstup psát: (11 modulo: 3), nový-řádek.
Výstup psát: (3.4 zaokrouhlit), nový-řádek.
Výstup psát: (7.1 horní-celá-část), nový-řádek.
Výstup psát: (7.9 dolní-celá-část), nový-řádek.
}
spustit.

Program vymazat-paměť.

použitá-paměť1 := (Program paměť ? 0).

{
2 exponent faktoriál.
Výstup psát: (11 modulo: 3), nový-řádek.
Výstup psát: (3.4 zaokrouhlit), nový-řádek.
Výstup psát: (7.1 horní-celá-část), nový-řádek.
Výstup psát: (7.9 dolní-celá-část), nový-řádek.
}
spustit.

Program vymazat-paměť.
použitá-paměť2 := (Program paměť ? 0).


{
2 exponent faktoriál.
Výstup psát: (11 modulo: 3), nový-řádek.
Výstup psát: (3.4 zaokrouhlit), nový-řádek.
Výstup psát: (7.1 horní-celá-část), nový-řádek.
Výstup psát: (7.9 dolní-celá-část), nový-řádek.
} spustit.

Program vymazat-paměť.
použitá-paměť3 := (Program paměť ? 0).



( použitá-paměť1 = použitá-paměť2 a: použitá-paměť1 = použitá-paměť3, a: použitá-paměť2 = použitá-paměť3 ) pravda: {
	Výstup psát: ['Žádné úniky paměti'].
}, nepravda: {
	Výstup psát: ['Uniká paměť...'].
}.
