Řetězec při: ['html'] udělat: { <- (
		sebe
		nahradit: ['&'] za: ['&amp;'],
		nahradit: ['<'] za: ['&lt;'],
		nahradit: ['>'] za: ['&gt;'],
		nahradit: ['''] za: ['&apos;'],
		nahradit: ['"'] za: ['&quot;']
	).
}.

>> použitá-paměť1 := 0.
>> použitá-paměť2 := 0.
>> použitá-paměť3 := 0.
>> použitá-paměť4 := 0.

Program správa-paměti: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Výstup psát: txt kopírovat html, nový-řádek.
Výstup psát: txt kopírovat malými-písmeny, nový-řádek.
Výstup psát: txt kopírovat velkými-písmeny, nový-řádek.
} spustit.

Program vymazat-paměť.

použitá-paměť1 := (Program paměť ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Výstup psát: txt kopírovat html, nový-řádek.
Výstup psát: txt kopírovat malými-písmeny, nový-řádek.
Výstup psát: txt kopírovat velkými-písmeny, nový-řádek.
} spustit.

Program vymazat-paměť.
použitá-paměť2 := (Program paměť ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Výstup psát: txt kopírovat html, nový-řádek.
Výstup psát: txt kopírovat malými-písmeny, nový-řádek.
Výstup psát: txt kopírovat velkými-písmeny, nový-řádek.
} spustit.

Program vymazat-paměť.
použitá-paměť3 := (Program paměť ? 0).



( použitá-paměť1 = použitá-paměť2 a: použitá-paměť1 = použitá-paměť3, a: použitá-paměť2 = použitá-paměť3 ) pravda: {
	Výstup psát: ['Žádné úniky paměti'].
}, nepravda: {
	Výstup psát: ['Uniká paměť...'].
}.
