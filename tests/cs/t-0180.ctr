Řetězec při: ['html'] udělat: { <- (
		sebe
		nahradit: ['&'] za: ['&amp;'],
		nahradit: ['<'] za: ['&lt;'],
		nahradit: ['>'] za: ['&gt;'],
		nahradit: ['''] za: ['&apos;'],
		nahradit: ['"'] za: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program správa-paměti: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Výstup psát: txt kopírovat html, nový-řádek.
Výstup psát: txt kopírovat malými-písmeny, nový-řádek.
Výstup psát: txt kopírovat velkými-písmeny, nový-řádek.
} spustit.

Program vymazat-paměť.

usedMemory1 := (Program paměť ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Výstup psát: txt kopírovat html, nový-řádek.
Výstup psát: txt kopírovat malými-písmeny, nový-řádek.
Výstup psát: txt kopírovat velkými-písmeny, nový-řádek.
} spustit.

Program vymazat-paměť.
usedMemory2 := (Program paměť ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Výstup psát: txt kopírovat html, nový-řádek.
Výstup psát: txt kopírovat malými-písmeny, nový-řádek.
Výstup psát: txt kopírovat velkými-písmeny, nový-řádek.
} spustit.

Program vymazat-paměť.
usedMemory3 := (Program paměť ? 0).



( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) pravda: {
	Výstup psát: ['No memory leaks here'].
}, nepravda: {
	Výstup psát: ['Leaking memory...'].
}.
