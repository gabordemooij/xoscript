Číslo při: ['factorial'] udělat: {
	>> total := 1.
	{ :index total vynásobit: (sebe - (index)). } × sebe. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Výstup psát: a.
>> b := 2 + 3 factorial.
Výstup psát: b.
>> c := 3 factorial + 2.
Výstup psát: c.
>> d := 2 + (3 factorial).
Výstup psát: d.
Výstup psát: 2 + 3 factorial + 1.
