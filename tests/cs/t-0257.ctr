
>> Greeter := Objekt nový.
Greeter při: ['nový'] udělat: {
	vlastní název := ['?'].
}.
Greeter při: ['name:'] udělat: { :název
	vlastní název := název.
}.
Greeter při: ['greet'] udělat: {
	Výstup psát: (['hello[you]'] [you]: vlastní název).
}.
>> friend := Greeter nový.
friend name: ['1'].
friend greet.
