# formát musí odpovídat typu hodnoty, typ může přijít od klienta
>> zkusit := { :formátování :value
	{ Výstup psát: ( (Formát nový: formátování) aplikovat: value ), nový-řádek. } chytit: { :e Výstup psát: e, nový-řádek. }, spustit.
}.
>> zkusit-celé := { :formátování :value
	{ Výstup psát: ( (Formát nový: formátování) aplikovat-celé: value ), nový-řádek. } chytit: { :e Výstup psát: e, nový-řádek. }, spustit.
}.

# sedí
zkusit aplikovat: ['|%s|'] a: ['text'].
zkusit aplikovat: ['%06.2f'] a: 5.5.
zkusit aplikovat: ['100%% %s'] a: ['jistě'].
zkusit-celé aplikovat: ['%03d'] a: 7.
zkusit-celé aplikovat: ['%x'] a: 255.
zkusit aplikovat: ['%d'] a: (Int64 nový z-řetězce: ['12']).
zkusit aplikovat: ['%lld'] a: (Int64 nový z-řetězce: ['12']).
zkusit aplikovat: ['%.1lf'] a: 5.5.
zkusit-celé aplikovat: ['%hd'] a: 7.

# nesedí
zkusit aplikovat: ['%s'] a: 12345.
zkusit aplikovat: ['%d'] a: 12345.
zkusit aplikovat: ['%f'] a: ['text'].
zkusit-celé aplikovat: ['%d'] a: ['text'].
zkusit-celé aplikovat: ['%s'] a: 5.
zkusit aplikovat: ['%s %s'] a: ['text'].
zkusit aplikovat: ['%n'] a: ['text'].
zkusit aplikovat: ['%*s'] a: ['text'].
zkusit aplikovat: ['%'] a: ['text'].

# modifikátor délky nesedí
zkusit aplikovat: ['%ls'] a: ['text'].
zkusit aplikovat: ['%Lf'] a: 5.5.
zkusit-celé aplikovat: ['%ld'] a: 7.
zkusit-celé aplikovat: ['%lld'] a: 7.
zkusit aplikovat: ['%Ld'] a: (Int64 nový z-řetězce: ['12']).

# šířka, která nesedí pro printf, musí vyvolat chybu, ne pád
zkusit aplikovat: ['%99999999999s'] a: ['text'].
