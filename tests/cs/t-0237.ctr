
Řetězec při: ['evaluate'] udělat: {
	>> kód := Soubor nový: ['/tmp/eval.ctr'].
	kód psát: (sebe řetězec + ['.']).
	Program použít: ['/tmp/eval.ctr'].
}.

>> map :=
	(Slovník nový)
	umístit: ['Hi There'] na: ['two'],
	umístit: (Seznam ← ['hello'] ; ['world'] ; (Seznam ← 1 ; 2; 9) ; Nepravda) na: ['one'],
	umístit: ( (Slovník nový) umístit: ['wrrld'] na: ['misspelled'] ) na: ['three'],
	umístit: (Seznam ← ((Slovník nový) umístit: ['treasure'] na: ['hidden']) ; 2) na: ['four']. 
>> str := map řetězec.
>> map2 := Nic.
(['map2 := '] + str ) evaluate.
Výstup psát: map2 ? ['one'] ? 0.
Výstup psát: map2 ? ['one'] ? 1.
Výstup psát: map2 ? ['four'] ? 0 ? ['hidden'].
Výstup psát: map2 ? ['one'] ? 2 ? 2.
