
Řetězec při: ['vyhodnotit'] udělat: {
	>> kód := Soubor nový: ['/tmp/eval.ctr'].
	kód psát: (sebe řetězec + ['.']).
	Program použít: ['/tmp/eval.ctr'].
}.

>> map :=
	(Slovník nový)
	umístit: ['Ahoj všichni'] na: ['two'],
	umístit: (Seznam ← ['hello'] ; ['world'] ; (Seznam ← 1 ; 2; 9) ; Nepravda) na: ['jedna'],
	umístit: ( (Slovník nový) umístit: ['svte'] na: ['překlep'] ) na: ['three'],
	umístit: (Seznam ← ((Slovník nový) umístit: ['poklad'] na: ['skrytý']) ; 2) na: ['čtyři']. 
>> str := map řetězec.
>> map2 := Nic.
(['map2 := '] + str ) vyhodnotit.
Výstup psát: map2 ? ['jedna'] ? 0.
Výstup psát: map2 ? ['jedna'] ? 1.
Výstup psát: map2 ? ['čtyři'] ? 0 ? ['skrytý'].
Výstup psát: map2 ? ['jedna'] ? 2 ? 2.
