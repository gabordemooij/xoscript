>> Úkolník := Objekt nový.

Úkolník při: ['nový'] udělat: {
	vlastní list := Seznam nový.
}.

Úkolník při: ['nieuw'] udělat: {
	vlastní list := Seznam nový.
}.

Úkolník při: ['+'] udělat: { :úkol
	vlastní list připojit: úkol.
}.

Úkolník při: ['number of tasks?'] udělat: { <-  vlastní list počet.
}.

>> úkoly := 
	Úkolník nový 
	+ ['uvařit večeři'] 
	+ ['uklidit pokoj'].
	
Výstup psát: ['You have $ tasks to do'] $ úkoly number of tasks?.
