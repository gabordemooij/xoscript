>> To-Do := Objekt nový.

To-Do při: ['nový'] udělat: {
	vlastní list := Seznam nový.
}.

To-Do při: ['nieuw'] udělat: {
	vlastní list := Seznam nový.
}.

To-Do při: ['+'] udělat: { :task
	vlastní list připojit: task.
}.

To-Do při: ['number of tasks?'] udělat: { <-  vlastní list počet.
}.

>> todos := 
	To-Do nový 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Výstup psát: ['You have $ tasks to do'] $ todos number of tasks?.
