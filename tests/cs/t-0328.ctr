Program správa-paměti: 4.

>> Zdvojovač := Objekt nový.
>> Násobitel := Objekt nový.
Zdvojovač při: ['zdvojnásobit:a:'] udělat: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Násobitel při: ['násobit:a:'] udělat: { :x :y <- (x × y).
}.

Výstup psát: (
	Zdvojovač zdvojnásobit:
		(Zdvojovač zdvojnásobit: 
			(Násobitel násobit: 2 a: 3)
		a:
			(Násobitel násobit: 3 a: 4)
		)
	a:
		(Zdvojovač zdvojnásobit: 
			(Násobitel násobit: 2 a: 3)
		a:
			(Násobitel násobit: 3 a: 4)
		)
), nový-řádek.
