# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> cesta := ['/tmp/dat.csv'].
>> csv := Soubor nový: cesta.
csv psát: s.

# accepts CRLF LF CR, varying row length
csv oddělovač: [';'] uvozovka: ['"'] řádky: { :line
	Program vymazat-paměť.
	Výstup psát: line, nový-řádek.
	Program vymazat-paměť.
}.

# unequal lines
s připojit: ['\njustone'].
csv psát: s.
{
	csv oddělovač: [';'] uvozovka: ['"'] řádky: { :line
		Výstup psát: line, nový-řádek.
	}.
} chytit: { :e 
	Výstup psát: e, nový-řádek.
}, spustit.

# invalid format
s := ['"he"llo";world'].
csv psát: s.
{
	csv oddělovač: [';'] uvozovka: ['"'] řádky: { :line
		Výstup psát: line, nový-řádek.
	}.
} chytit: { :e 
	Výstup psát: e, nový-řádek.
}, spustit.
