# bezproblémový průběh
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> cesta := ['/tmp/dat.csv'].
>> csv := Soubor nový: cesta.
csv psát: s.

# přijímá CRLF LF CR, různá délka řádků
csv oddělovač: [';'] uvozovka: ['"'] řádky: { :line
	Program vymazat-paměť.
	Výstup psát: line, nový-řádek.
	Program vymazat-paměť.
}.

# nestejné řádky
s připojit: ['\njustone'].
csv psát: s.
{
	csv oddělovač: [';'] uvozovka: ['"'] řádky: { :line
		Výstup psát: line, nový-řádek.
	}.
} chytit: { :e 
	Výstup psát: e, nový-řádek.
}, spustit.

# neplatný formát
s := ['"he"llo";world'].
csv psát: s.
{
	csv oddělovač: [';'] uvozovka: ['"'] řádky: { :line
		Výstup psát: line, nový-řádek.
	}.
} chytit: { :e 
	Výstup psát: e, nový-řádek.
}, spustit.
