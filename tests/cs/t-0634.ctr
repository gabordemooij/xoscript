# Program shell-escape vytváří kanonickou syntaxi posix shellu
# kompatibilní s: bash/dash, zsh, ksh

>> c := Program shell-escape: ['abc'].
Výstup psát: c, nový-řádek.
Výstup psát: ( Program systém: ['echo '] + c ), nový-řádek.

c := Program shell-escape: ['a'b'c'].
Výstup psát: c, nový-řádek.
Výstup psát: ( Program systém: ['echo '] + c ), nový-řádek.

c := Program shell-escape: ['a\'c'].
Výstup psát: c, nový-řádek.
Výstup psát: ( Program systém: ['echo '] + c ), nový-řádek.