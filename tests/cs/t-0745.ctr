Výstup psát: ['Test object'], nový-řádek.
>> a := Objekt nový. 

a při: ['item:'] udělat: { :dict
	vlastní dict := dict. 
}.

a při: ['item'] udělat: { <- vlastní dict.
}.

a item: (
Slovník nový
	hello: ['world']).

>> old-dict-address := a item prototyp adresa-paměti.
a save-as: ['/tmp/a.bin'].
Výstup psát: ['========== RELOADING SNAP:'], nový-řádek.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp adresa-paměti = old-dict-address) pravda: {
	Výstup psát: ['Object link re-attached.'], nový-řádek.
}.

Výstup psát: b item, nový-řádek.
