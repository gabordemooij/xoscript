Logický při: ['xor:'] udělat: { :a :b <- ((a a: b ne) nebo: (a ne a: b)).
}.

>> o := Objekt nový.
o při: ['hello'] udělat: { ['Empty']. }.
{ o při: 2 udělat: 3.} chytit: { :e Výstup psát: e, nový-řádek. }, spustit.
{ o při: ['test'] udělat: 3.} chytit: { :e Výstup psát: e, nový-řádek. }, spustit.
{ o při: ['hello'] udělat: { ['Empty']. }.} chytit: { :e Výstup psát: e, nový-řádek. }, spustit. 
{ >> z := 4 ÷ 0. } chytit: { :e Výstup psát: e, nový-řádek. }, spustit. 
{ (Pravda a: Nic) pravda: { Výstup psát: ['X'].}. } chytit: { :e Výstup psát: e, nový-řádek. }, spustit. 
{ ([''] xor: 0) pravda: { Výstup psát: ['X'].}. } chytit: { :e Výstup psát: e, nový-řádek. }, spustit. 
{ (1 < ['2']) pravda: { Výstup psát: ['OK']. }. } chytit: { :e Výstup psát: e, nový-řádek. }, spustit. 
{ (1 < ['2.0']) pravda: { Výstup psát: ['OK']. }. } chytit: { :e Výstup psát: e, nový-řádek. }, spustit. 
{ (1 < ['x2.0']) pravda: { Výstup psát: ['NO!']. }. } chytit: { :e Výstup psát: e, nový-řádek. }, spustit. 
{ Výstup psát: (['hello OK there'] od: ['6'] délka: ['2']). } spustit. 
