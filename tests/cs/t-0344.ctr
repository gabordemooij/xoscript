# test zachycení všeho (praktický)
>> HTML := Řetězec nový.
HTML při: ['encode:'] udělat: { :tekst
	sebe připojit: (tekst
	nahradit: ['&'] za: ['&amp;'], 
	nahradit: ['<'] za: ['&lt;'],
	nahradit: ['>'] za: ['&gt;'],
	nahradit: ['"'] za: ['&quot;']).
}.
>> blog := HTML nový.
blog připojit: ['<h1>'],
     encode: ['Koffie & Thee'],
     připojit: ['</h1>'].
Výstup psát: blog, nový-řádek.


>> Římské := Číslo nový.
Římské při: ['řetězcovitě'] udělat: {
	>> a := [''].
	{ a připojit: ['I']. } × sebe. <- a.
}.

>> x := Římské nový.
x přičíst: 3.
Výstup psát: x řetězcovitě, nový-řádek.

>> Kvantum := Logický nový.
Kvantum při: ['true?'] udělat: { <- ['možná Pravda']. }.
Výstup psát: (Kvantum nový true?), nový-řádek.

>> Nihil := Nic nový.
Nihil při: ['řetězec'] udělat: { <- ['Nihil']. }.
Výstup psát: (Nihil nový), nový-řádek.
