# catch-all test (practical)
>> HTML := Řetězec nový.
HTML při: ['encode:'] udělat: { :tekst
	sebe připojit: (tekst
	nahradit: ['&'] za: ['&amp;'], 
	nahradit: ['<'] za: ['&lt;'],
	nahradit: ['>'] za: ['&gt;'],
	nahradit: ['"'] za: ['&quot;']).
}.
>> blog := HTML nový.
blog připojit: ['<h1>'],
     encode: ['Koffie & Thee'],
     připojit: ['</h1>'].
Výstup psát: blog, nový-řádek.


>> Roman := Číslo nový.
Roman při: ['stringy'] udělat: {
	>> a := [''].
	{ a připojit: ['I']. } × sebe. <- a.
}.

>> x := Roman nový.
x přičíst: 3.
Výstup psát: x stringy, nový-řádek.

>> Quantum := Logický nový.
Quantum při: ['true?'] udělat: { <- ['maybe True']. }.
Výstup psát: (Quantum nový true?), nový-řádek.

>> Nihil := Nic nový.
Nihil při: ['řetězec'] udělat: { <- ['Nihil']. }.
Výstup psát: (Nihil nový), nový-řádek.
