

Seznam při: ['column:'] udělat: { :column
	>> result := Seznam nový.
	sebe každý: { :index :row
		row každý: { :index :cell
			(index = column) pravda: { result připojit: cell. }.
		}.
	}. <- result.
}.


>> a := Seznam ←
	(Seznam ← 1 ; 2 ; 3) ;
	(Seznam ← 4 ; 5 ; 6) ;
	(Seznam ← 7 ; 8 ; 9).

>> b := a column: 1.
Výstup psát: b, nový-řádek.

b := a column: 20.
Výstup psát: b, nový-řádek.

b := a column: -100.
Výstup psát: b, nový-řádek.
