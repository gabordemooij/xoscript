Program správa-paměti: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } chytit: {
		oops přičíst: 1.
	}, spustit.
} × 1000.

{
	Výstup psát: ['hi there!'].
	tato-úloha chyba: ['oops'].
	Výstup psát: ['hi there!'].
	{ Výstup psát: ['dont print this']. } spustit.
} chytit: { :e 
	Výstup psát: ['got ya!']. 
	Výstup psát: e.
}, spustit.
