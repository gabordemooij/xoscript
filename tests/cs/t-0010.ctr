>> Animal := Objekt nový.
Animal při: ['make'] udělat: {
	>> animal := Objekt nový.
	animal při: ['makeSound'] udělat: {
		Výstup psát: vlastní sound.
	}. <- animal.
}.
>> Cat := Objekt nový.
Cat při: ['make'] udělat: {
	>> cat := Animal make.
	cat při: ['init'] udělat: {
		vlastní sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
