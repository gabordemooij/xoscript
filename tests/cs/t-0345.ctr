# test catch-all methods
>> x13 := Objekt nový.
x13 při: ['a'] udělat: { :a Výstup psát: 0, nový-řádek. }.
x13 při: ['a:'] udělat: { :a Výstup psát: a, nový-řádek. <- 5. }.
x13 při: ['a:b:'] udělat: { :a :b Výstup psát: (a + b), nový-řádek. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
