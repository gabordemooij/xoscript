#Linux

(Soubor nový: ['/tmp/testje']) existuje nepravda: {
	Program systém: ['mkdir /tmp/testje'].	
}.

(Soubor nový: ['/tmp/testje/file1']) existuje nepravda: {
	Program systém: ['touch /tmp/testje/file1'].	
}.

(Soubor nový: ['/tmp/testje/folder1']) existuje nepravda: {
	Program systém: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Soubor seznam: ['/tmp/testje'].

>> q := Seznam nový.

l každý: { :k :v v každý: { :x :y q připojit: y. }. }.

>> s := q řetězec.

(s obsahuje: ['file1']) pravda:   { Výstup psát: ['OK'], nový-řádek. }.
(s obsahuje: ['file2']) pravda:   { Výstup psát: ['XX'], nový-řádek. }.
(s obsahuje: ['folder1']) pravda: { Výstup psát: ['OK'], nový-řádek. }.
