# použití FFI s pluginem Server

# připojení k libc (závisí na platformě)
>> název-knihovny := Program nastavení: ['FFITESTLIB'].

# propojit funkce stdio z C pro pokročilé operace se soubory
Server propojit: ( Seznam nový ;
 název-knihovny ; ['fopen'] ;
 ( Seznam nový ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
propojit: ( Seznam nový ;
 Nic ; # znamená stejnou knihovnu
 ['fread'] ;
 ( Seznam nový ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nic ; # znamená stejný objekt (tj. Stream)
 ['fread']
),
propojit: (
 Seznam nový ;
 Nic ; # znamená stejnou knihovnu
 ['fwrite'] ;
 ( Seznam nový ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nic ; # znamená stejnou knihovnu
 ['fwrite']
),
propojit: (
 Seznam nový ;
 Nic ; # znamená stejnou knihovnu
 ['rewind'] ;
 ( Seznam nový ; ['pointer'] ) ;
 ['int'] ;
 Nic ; # znamená stejnou knihovnu
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> cesta := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# otevřít soubor pomocí fopen(path, mode)
>> fd := Stream path: cesta mode: mode.

# zapsat bajty z bufferu textový-řetězec do souboru
>> zapsané-bajty := Stream zpráva: ['fwrite'] parametry: (Seznam nový ; str ; 1 ; 6 ; fd ).
Výstup psát: zapsané-bajty, nový-řádek.

# přetočit ukazatel souboru na začátek
Stream rewind: fd.

# alokovat buffer
>> buf := Blob nový: 20.

# číst ze souboru
>> přečtené-bajty := Stream zpráva: ['fread'] parametry: (Seznam nový ; buf ; 1 ; 6 ; fd ).
Výstup psát: přečtené-bajty, nový-řádek.
Výstup psát: buf, nový-řádek.

# uvolnit paměť
str  uvolnit.
cesta uvolnit.
mode uvolnit.
buf  uvolnit.


