# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Program nastavení: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server propojit: ( Seznam nový ;
 libname ; ['fopen'] ;
 ( Seznam nový ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
propojit: ( Seznam nový ;
 Nic ; # means same lib
 ['fread'] ;
 ( Seznam nový ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nic ; # means same object (i.e. Stream)
 ['fread']
),
propojit: (
 Seznam nový ;
 Nic ; # means same lib
 ['fwrite'] ;
 ( Seznam nový ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nic ; # means same lib
 ['fwrite']
),
propojit: (
 Seznam nový ;
 Nic ; # means same lib
 ['rewind'] ;
 ( Seznam nový ; ['pointer'] ) ;
 ['int'] ;
 Nic ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> cesta := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: cesta mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream zpráva: ['fwrite'] parametry: (Seznam nový ; str ; 1 ; 6 ; fd ).
Výstup psát: bytes-written, nový-řádek.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob nový: 20.

# read from file
>> bytes-read := Stream zpráva: ['fread'] parametry: (Seznam nový ; buf ; 1 ; 6 ; fd ).
Výstup psát: bytes-read, nový-řádek.
Výstup psát: buf, nový-řádek.

# free memory
str  uvolnit.
cesta uvolnit.
mode uvolnit.
buf  uvolnit.


