# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Vzor nový: pattern.
	p shoda: subject udělat: { :m :g
		Výstup psát: g počet, psát: [' '], psát: (g spojit: ['|']), nový-řádek. <- m.
	}.
}.
show aplikovat: ['(a)|(b)'] a: ['b'].
show aplikovat: ['(a)|(b)'] a: ['a'].
show aplikovat: ['(x)?y'] a: ['y'].
show aplikovat: ['(x)?(y)(z)?'] a: ['xy'].
