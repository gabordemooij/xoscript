# skupina, která není součástí shody, nesmí způsobit pád a musí zachovat čísla skupin
Server init.
>> ukázat := { :vzorek :subject
	>> p := Vzor nový: vzorek.
	p shoda: subject udělat: { :m :g
		Výstup psát: g počet, psát: [' '], psát: (g spojit: ['|']), nový-řádek.
		<- m.
	}.
}.
ukázat aplikovat: ['(a)|(b)'] a: ['b'].
ukázat aplikovat: ['(a)|(b)'] a: ['a'].
ukázat aplikovat: ['(x)?y'] a: ['y'].
ukázat aplikovat: ['(x)?(y)(z)?'] a: ['xy'].
