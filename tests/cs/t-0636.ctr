# test parsování url

Server init.
>> url := URL z: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Výstup psát: ['schéma = '] + url schéma, nový-řádek.
Výstup psát: ['hostitel = '] + url hostitel, nový-řádek.
Výstup psát: ['port = '] + url port, nový-řádek.
Výstup psát: ['cesta = '] + url cesta, nový-řádek.
Výstup psát: ['dotaz = '] + url parametry-hledání, nový-řádek.
Výstup psát: ['fragment = '] + url fragment, nový-řádek.
