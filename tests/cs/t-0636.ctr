# test url parsing

Server init.
>> url := URL z: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Výstup psát: ['scheme = '] + url schéma, nový-řádek.
Výstup psát: ['host = '] + url hostitel, nový-řádek.
Výstup psát: ['port = '] + url port, nový-řádek.
Výstup psát: ['path = '] + url cesta, nový-řádek.
Výstup psát: ['query = '] + url parametry-hledání, nový-řádek.
Výstup psát: ['fragment = '] + url fragment, nový-řádek.
