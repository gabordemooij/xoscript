>> V := Objekt.
V při: ['řetězec'] udělat: {
	Výstup psát: ['přetypování'], nový-řádek.
	<- ['abc'].
}.

Výstup psát: ( Program nastavení: ['abc'] ), nový-řádek.

# parametry nesmí být uvolněny GC
Program nastavení: ([''] + V nový) hodnota: ([''] + V nový).

Výstup psát: ( Program nastavení: ['abc'] ), nový-řádek.
