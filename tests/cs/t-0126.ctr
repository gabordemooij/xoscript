#Linux
>> Hltač := Objekt nový.

Hltač při: ['nový'] udělat: {
	vlastní str := [''].
}.

Hltač při: ['nieuw'] udělat: {
	vlastní str := [''].
}.

Hltač při: ['odpovědět:'] udělat: { :blah
		vlastní str připojit: blah.
}.

Hltač při: ['odpovědět:a:'] udělat: { :blah :blahah
		vlastní str připojit: (blah od: 0 délka: (blah délka - 1)).
		vlastní str připojit: [' '].
		vlastní str připojit: blahah.
}.

Hltač při: ['obdržet'] udělat: {
	>> buffer := vlastní str.
	vlastní str := ['']. <- buffer.
}.


Výstup psát: (Program systém: (Hltač nový echo: ['Nazdar, umím psát na konzoli přes plynulé API!'], obdržet)).


{ Soubor nový: ['/tmp/from.txt'], smazat. } chytit: { ['Prázdné']. }, spustit.
{ Soubor nový: ['/tmp/to.txt'], smazat. } chytit: { ['Prázdné']. }, spustit.


Soubor nový: ['/tmp/to.txt'], existuje nepravda: {
	Výstup psát: ['Confirmed. Target file does not exist.\
'].
}.
Soubor nový: ['/tmp/from.txt'], existuje nepravda: {
	Výstup psát: ['Confirmed. Source file does not exist.\
'].
}.



Program systém: (Hltač nový touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obdržet).



Program systém: (Hltač nový cp: ['/tmp/from.txt /tmp/to.txt'], obdržet).

Soubor nový: ['/tmp/to.txt'], existuje pravda: {
	Výstup psát: ['Confirmed. Target file has been created by shell.\
'].
}.


Výstup psát: ['Obsah souboru je:'] + (Soubor nový: ['/tmp/to.txt'], číst), nový-řádek.
