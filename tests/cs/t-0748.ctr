Výstup psát: ['Test object'], nový-řádek.
>> a := Objekt nový. 

a při: ['item:'] udělat: { :logický
	vlastní logický := logický. 
}.

a při: ['item'] udělat: { <- vlastní logický.
}.

a item: Pravda.

Výstup psát: a item, nový-řádek.

>> old-bool-address := a item prototyp adresa-paměti.
a save-as: ['/tmp/a.bin'].
Výstup psát: ['========== RELOADING SNAP:'], nový-řádek.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp adresa-paměti = old-bool-address) pravda: {
	Výstup psát: ['Object link re-attached.'], nový-řádek.
}.

Výstup psát: b item, nový-řádek.
