# edge cases from a request must give an error or a result, not a crash
Server init.

Výstup psát: ['<'] + (['abc'] od: 0 délka: 0, velkými-písmeny) + ['>'], nový-řádek.
Výstup psát: ['<'] + (['abc'] od: 0 délka: 0, malými-písmeny) + ['>'], nový-řádek.
Výstup psát: ['<'] + (['abc'] přeskočit: 3, velkými-písmeny) + ['>'], nový-řádek.
Výstup psát: [''] velkými-písmeny bytes, nový-řádek.
Výstup psát: ['aB'] velkými-písmeny, nový-řádek.
Výstup psát: ['aB'] malými-písmeny, nový-řádek.

Výstup psát: (Okamžik nový: 0) rok, nový-řádek.
{ Okamžik nový: ['9e300'] číslo. } chytit: { :e Výstup psát: e, nový-řádek. }, spustit.
{ Okamžik nový: ['-9e300'] číslo. } chytit: { :e Výstup psát: e, nový-řádek. }, spustit.
{ Okamžik nový: ['nan'] číslo. } chytit: { :e Výstup psát: e, nový-řádek. }, spustit.
{ Okamžik nový: 9000000000000000000. } chytit: { :e Výstup psát: e, nový-řádek. }, spustit.
