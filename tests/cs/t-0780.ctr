Server init.

# kodér JSON podporuje jen UTF-8, žádné náhradní páry (surrogate pairs)

>> slovníky := Seznam nový ;
	# {"key":"normal"} běžné ASCII
	( Slovník nový umístit: ['normální'] na: ['key'] ) ;
	# {"key":"hello world"} znak mezery
	( Slovník nový umístit: ['hello world'] na: ['key'] ) ;
	# {"key":"quote: \""} dvojitá uvozovka
	( Slovník nový umístit: ['"'] na: ['key'] ) ;
	# {"key":"backslash: \\"} zpětné lomítko
	( Slovník nový umístit: ['backslash: \\'] na: ['key'] ) ;
	# {"key":"slash: /"} lomítko
	( Slovník nový umístit: ['lomítko: /'] na: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( Slovník nový umístit: ['backspace: \b'] na: ['key'] ) ;
	# {"key":"formfeed: \f"} escape posunu stránky (form-feed)
	( Slovník nový umístit: ['formfeed: \f'] na: ['key'] ) ;
	# {"key":"newline: \n"} nový řádek
	( Slovník nový umístit: ['newline: \n'] na: ['key'] ) ;
	( Slovník nový umístit: ['newline: ↵'] na: ['key'] ) ;
	( Slovník nový umístit: ['newline: 
	'] na: ['key'] ) ;
	# {"key":"carriage return: \r"} návrat vozíku
	( Slovník nový umístit: ['carriage return: \r'] na: ['key'] ) ;
	# {"key":"tab: \t"} tabulátor
	( Slovník nový umístit: ['tab \t'] na: ['key'] ) ;
	( Slovník nový umístit: ['tab ⇿'] na: ['key'] ) ;
	( Slovník nový umístit: ['tabulátor  '] na: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( Slovník nový umístit: ['NUL \u0000'] na: ['key'] ) ;
	( Slovník nový umístit: ['NUL \0'] na: ['key'] ) ;
	# {"key":"control: \u0001"} řídicí znak 0x01
	( Slovník nový umístit: ['control: \u0001'] na: ['key'] ) ;
	# {"key":"control: \u001F"} řídicí znak 0x1F
	( Slovník nový umístit: ['control: \u001F'] na: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2bajtový znak
	( Slovník nový umístit: ['unicode: é'] na: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3bajtový znak
	( Slovník nový umístit: ['unicode: €'] na: ['key'] ) ;
	# {"key":"unicode: 日本語"} více 3bajtových znaků UTF-8
	( Slovník nový umístit: ['unicode: 日本語'] na: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4bajtový znak
	( Slovník nový umístit: ['unicode: 😀'] na: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + spojovač nulové šířky
	( Slovník nový umístit: ['unicode: 🧑‍💻'] na: ['key'] ) ;
	# {"key":"combining: e\u0301"} kombinující diakritika
	( Slovník nový umístit: ['combining: e\u0301'] na: ['key'] ) ;
	# {"key":"escaped unicode: \u00e9"} Unicode escape BMP
	( Slovník nový umístit: ['escaped unicode: \u00e9'] na: ['key'] ) ;
	# {"key":"escaped unicode: \u20ac"} Unicode escape BMP
	( Slovník nový umístit: ['escaped unicode: \u20ac'] na: ['key'] ) ;
	# {"key":"escaped unicode: \ud83d\ude00"} náhradní pár UTF-16
	( Slovník nový umístit: ['escaped unicode: \ud83d\ude00'] na: ['key'] ) ;
	# {"key":""} prázdná hodnota
	( Slovník nový umístit: [''] na: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} speciální znaky ASCII
	( Slovník nový umístit: ['@ < > & = % + ? #'] na: ['key'] ) ;
	# {"key":"single quote: '"} jednoduchá uvozovka
	( Slovník nový umístit: ['''] na: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} více escape sekvencí JSON
	( Slovník nový umístit: ['multiple: \" \\ \n \r \t'] na: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} delší ASCII řetězec
	( Slovník nový umístit: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] na: ['key'] ) ;
	# {"key":" value"} úvodní mezera
	( Slovník nový umístit: [' hodnota'] na: ['key'] ) ;
	# {"key":"value "} koncová mezera
	( Slovník nový umístit: ['hodnota '] na: ['key'] ) ;
	# {"key":" \t\n\r "} bílé znaky
	( Slovník nový umístit: [' \t\n\r '] na: ['key'] )
	.

slovníky každý: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (Slovník nový umístit: d key na: ['key']).
	>> b := JSON jsonify: (Slovník nový umístit: ['value'] na: d key).
	>> e := JSON objekt: a.
	>> f := JSON objekt: b.
	((e key = d key a: (f ? d key = ['value'])) nebo: (e key = ['NUL ?'])) pravda: {
		Výstup psát: ['OK'], nový-řádek.
	}, jinak: {
		Výstup psát: ['Nelze správně kódovat/dekódovat: '] + d + j, nový-řádek.
		Program konec.
	}.
}.
