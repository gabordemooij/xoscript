


>> CoffeeMachine := Objekt nový.
CoffeeMachine při: ['order:'] udělat: { :id
	>> coffee := ['Americano'].
	( id = 1 ) pravda: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) pravda: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) pravda: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Objekt nový.
SimpleCoffeeMachine při: ['order'] udělat: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Výstup psát: redCup, nový-řádek.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Výstup psát: greenCup, nový-řádek.
>> yellowCup := CoffeeMachine order: 1.
Výstup psát: yellowCup, nový-řádek.
>> blueCup := CoffeeMachine order: 0.
Výstup psát: blueCup, nový-řádek.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Výstup psát: blackCup, nový-řádek.
blackCup připojit: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Výstup psát: orangeCup, nový-řádek.
