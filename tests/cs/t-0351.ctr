
>> použitá-paměť1 := 0.
>> použitá-paměť2 := 0.
>> použitá-paměť3 := 0.
>> použitá-paměť4 := 0.

>> kód := {
	>> o := (
		Slovník nový
		aa: (Seznam ← 1 ; 2),
		bb: (Seznam ← 3 ; 4)
	).
	>> s := o řetězec.
	>> o2 := s objekt.
	(s  typ = Řetězec typ) pravda: { Výstup psát: ['OK1'], nový-řádek. }.
	(o2 typ = Slovník typ) pravda: { Výstup psát: ['OK2'], nový-řádek. }.
}.

Program správa-paměti: 0.
['Paměť 1 bude jiná, protože sledované bloky se přidávají hromadně.'].
Program vymazat-paměť.
použitá-paměť1 := (Program paměť ? 1).
kód spustit.
Program vymazat-paměť.
použitá-paměť2 := (Program paměť ? 1).
kód spustit.
Program vymazat-paměť.
použitá-paměť3 := (Program paměť ? 1).
kód spustit.
Program vymazat-paměť.
použitá-paměť4 := (Program paměť ? 1).

(použitá-paměť2 = použitá-paměť3 = použitá-paměť4) pravda: { Výstup psát: ['OK3'], nový-řádek. }.
 
