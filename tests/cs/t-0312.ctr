>> Slurp := Objekt nový.
Slurp při: ['nový'] udělat: {
	vlastní str := [''].
}.
Slurp naučit: ['nieuw'] znamená: ['nový'].
Slurp při: ['odpovědět:'] udělat: { :blah
		(vlastní str ≠ ['']) pravda: {
			vlastní str připojit: [' '].
		}.
		vlastní str připojit: blah.
}.
Slurp při: ['odpovědět:a:'] udělat: { :blah :blahah
		(vlastní str ≠ ['']) pravda: {
			vlastní str připojit: [' '].
		}.
		(blah délka > 1) pravda: {
			vlastní str připojit: (blah od: 0 délka: (blah délka - 1)).
		}, jinak: {
			vlastní str připojit: blah.
		}.
		vlastní str připojit: [' '].
		vlastní str připojit: blahah.
}.
Slurp při: ['obtain'] udělat: {
	>> buffer := vlastní str.
	vlastní str := ['']. <- buffer.
}.


>> parametry-hledání := Slurp nový
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

Výstup psát: parametry-hledání obtain, nový-řádek.
