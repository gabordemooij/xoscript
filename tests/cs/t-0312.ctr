>> Hltač := Objekt nový.
Hltač při: ['nový'] udělat: {
	vlastní str := [''].
}.
Hltač naučit: ['nieuw'] znamená: ['nový'].
Hltač při: ['odpovědět:'] udělat: { :blah
		(vlastní str ≠ ['']) pravda: {
			vlastní str připojit: [' '].
		}.
		vlastní str připojit: blah.
}.
Hltač při: ['odpovědět:a:'] udělat: { :blah :blahah
		(vlastní str ≠ ['']) pravda: {
			vlastní str připojit: [' '].
		}.
		(blah délka > 1) pravda: {
			vlastní str připojit: (blah od: 0 délka: (blah délka - 1)).
		}, jinak: {
			vlastní str připojit: blah.
		}.
		vlastní str připojit: [' '].
		vlastní str připojit: blahah.
}.
Hltač při: ['obdržet'] udělat: {
	>> buffer := vlastní str.
	vlastní str := ['']. <- buffer.
}.


>> parametry-hledání := Hltač nový
	select: ['*'],
	from
		uživatelé 
	where 
		user_id=: 1.

Výstup psát: parametry-hledání obdržet, nový-řádek.
