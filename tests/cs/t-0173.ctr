

Seznam při: ['sum'] udělat: {
	>> total := 0.
	sebe každý: { :index :element
		total přičíst: element.
	}. <- total.
}.

Seznam při: ['product'] udělat: {
	>> total := 1.
	sebe každý: { :index :element
		total vynásobit: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program správa-paměti: 0.

{

>> a := Seznam ← ['hello'] ; ['world'] ; Pravda ; Nic ; 666.
a := a + ( Seznam ← 1 ).
Výstup psát: ( ['sum: '] + ( a sum ) ), nový-řádek.
Výstup psát: ( ['min: '] + ( a minimum ) ), nový-řádek.
Výstup psát: ( ['max: '] + ( a maximum ) ), nový-řádek.
Výstup psát: ( ['3rd: '] + ( a ? 2 ) ), nový-řádek.
Výstup psát: ( ['prd: '] + ( a product ) ), nový-řádek.
a seřadit: { :a :b <- (b - a). }.
a každý: { :i :e Výstup psát: ( i - 0 ), nový-řádek. }.

} spustit.

Program vymazat-paměť.
usedMemory1 := (Program paměť ? 0).


{

>> a := Seznam ← ['hello'] ; ['world'] ; Pravda ; Nic ; 666.
a := a + ( Seznam ← 1 ).
Výstup psát: ( ['sum: '] + ( a sum ) ), nový-řádek.
Výstup psát: ( ['min: '] + ( a minimum ) ), nový-řádek.
Výstup psát: ( ['max: '] + ( a maximum ) ), nový-řádek.
Výstup psát: ( ['3rd: '] + ( a ? 2 ) ), nový-řádek.
Výstup psát: ( ['prd: '] + ( a product ) ), nový-řádek.
a seřadit: { :a :b <- (b - a). }.
a každý: { :i :e Výstup psát: ( i - 0 ), nový-řádek. }.

} spustit.



Program vymazat-paměť.
usedMemory2 := (Program paměť ? 0).


{

>> a := Seznam ← ['hello'] ; ['world'] ; Pravda ; Nic ; 666.
a := a + ( Seznam ← 1 ).
Výstup psát: ( ['sum: '] + ( a sum ) ), nový-řádek.
Výstup psát: ( ['min: '] + ( a minimum ) ), nový-řádek.
Výstup psát: ( ['max: '] + ( a maximum ) ), nový-řádek.
Výstup psát: ( ['3rd: '] + ( a ? 2 ) ), nový-řádek.
Výstup psát: ( ['prd: '] + ( a product ) ), nový-řádek.
a seřadit: { :a :b <- (b - a). }.
a každý: { :i :e Výstup psát: ( i - 0 ), nový-řádek. }.

} spustit.



Program vymazat-paměť.
usedMemory3 := (Program paměť ? 0).

( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) pravda: {
	Výstup psát: ['No memory leaks here'].
}, nepravda: {
	Výstup psát: ['Leaking memory...'].
}.
