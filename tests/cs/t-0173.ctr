

Seznam při: ['součet'] udělat: {
	>> celkem := 0.
	sebe každý: { :index :prvek
		celkem přičíst: prvek.
	}. <- celkem.
}.

Seznam při: ['součin'] udělat: {
	>> celkem := 1.
	sebe každý: { :index :prvek
		celkem vynásobit: prvek.
	}. <- celkem.
}.

>> použitá-paměť1 := 0.
>> použitá-paměť2 := 0.
>> použitá-paměť3 := 0.
>> použitá-paměť4 := 0.

Program správa-paměti: 0.

{

>> a := Seznam ← ['hello'] ; ['world'] ; Pravda ; Nic ; 666.
a := a + ( Seznam ← 1 ).
Výstup psát: ( ['součet: '] + ( a součet ) ), nový-řádek.
Výstup psát: ( ['min: '] + ( a minimum ) ), nový-řádek.
Výstup psát: ( ['max: '] + ( a maximum ) ), nový-řádek.
Výstup psát: ( ['3.: '] + ( a ? 2 ) ), nový-řádek.
Výstup psát: ( ['součin: '] + ( a součin ) ), nový-řádek.
a seřadit: { :a :b <- (b - a). }.
a každý: { :i :e Výstup psát: ( i - 0 ), nový-řádek. }.

} spustit.

Program vymazat-paměť.
použitá-paměť1 := (Program paměť ? 0).


