>> t := Pravda.
(t = Pravda) pravda: { Výstup psát: ['T']. }.
(t = Nepravda) pravda: { Výstup psát: ['F']. }.
Výstup psát: ['|'].
>> t := Nepravda.
(t = Pravda) pravda: { Výstup psát: ['T']. }.
(t = Nepravda) pravda: { Výstup psát: ['F']. }.
Výstup psát: ['|'].
>> f := Pravda.
(t = Pravda a: f = Nepravda) pravda: { Výstup psát: ['T']. }.
(t = Nepravda a: f = Pravda) pravda: { Výstup psát: ['F']. }.
Výstup psát: ['|'].
>> n := Nic.
(n Nic?) pravda: { Výstup psát: ['T']. }.
(n Nic?) nepravda: { Výstup psát: ['F']. }.
Výstup psát: ['|'].
(f Boolean?) pravda: { Výstup psát: ['T']. }.
(f Boolean?) nepravda: { Výstup psát: ['F']. }.



