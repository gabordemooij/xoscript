
>> g := ['globální'].
{ >> g := ['lokální']. Výstup psát: g, nový-řádek. } spustit. 
Výstup psát: g, nový-řádek. 
>> vzkaz := ['Nashle'].
>> Tajemství := Objekt nový.
Tajemství při: ['test'] udělat: {
	>> vzkaz := ['Hello'].
	vlastní vzkaz := ['World'].
	Výstup psát: vzkaz + [' '] + vlastní vzkaz, nový-řádek.
}.
