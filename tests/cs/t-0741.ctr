Výstup psát: ['Test object'], nový-řádek.
>> a := Objekt nový. 

a při: ['item:'] udělat: { :octhelper
	vlastní octhelper := octhelper. 
}.

a při: ['item'] udělat: { <- vlastní octhelper.
}.

a item: Oct nový.

>> old-octhelper-address := a item prototyp adresa-paměti.
a save-as: ['/tmp/a.bin'].
Výstup psát: ['========== RELOADING SNAP:'], nový-řádek.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp adresa-paměti = old-octhelper-address) pravda: {
	Výstup psát: ['Object link re-attached.'], nový-řádek.
}.
