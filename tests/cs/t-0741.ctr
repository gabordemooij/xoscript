Výstup psát: ['Testovací objekt'], nový-řádek.
>> a := Objekt nový. 

a při: ['item:'] udělat: { :oct-pomocník
	vlastní oct-pomocník := oct-pomocník. 
}.

a při: ['položka'] udělat: {
	<- vlastní oct-pomocník.
}.

a item: Oct nový.

>> stará-adresa-oct-pomocníka := a položka prototyp adresa-paměti.
a save-as: ['/tmp/a.bin'].
Výstup psát: ['========== OPĚTOVNÉ NAČTENÍ SNÍMKU:'], nový-řádek.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b položka prototyp adresa-paměti = stará-adresa-oct-pomocníka) pravda: {
	Výstup psát: ['Odkaz na objekt znovu připojen.'], nový-řádek.
}.
