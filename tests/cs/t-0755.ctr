Výstup psát: ['Test object'], nový-řádek.
>> greeter := Objekt nový.
greeter při: ['name:'] udělat: { :název
	vlastní xname := název. 
}.
greeter při: ['greet'] udělat: {
	Výstup psát: ['Hello '] + vlastní xname, nový-řádek.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Výstup psát: ['========== RELOADING SNAP:'], nový-řádek.
>> b := Objekt load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
