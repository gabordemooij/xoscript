# klíče a podpisy Trezor, které se dekódují na příliš dlouhé, nesmí přetéct zásobník
Server init.

>> klíče := Trezor vygenerovat-klíče.
>> sk := klíče první.
>> pk := klíče poslední.
>> sig := Trezor podepsat: ['abc'] klíčem: sk.

# 88 znaků bez paddingu se dekóduje na 66 bajtů
>> dlouhý := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 znaků bez paddingu se dekóduje na 33 bajtů
>> krátký := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Trezor podepsat: ['abc'] klíčem: dlouhý. } chytit: { :e
	Výstup psát: e, nový-řádek.
}, spustit.

{ Trezor ověřit: ['abc'] podpis: dlouhý klíčem: pk. } chytit: { :e
	Výstup psát: e, nový-řádek.
}, spustit.

{ Trezor ověřit: ['abc'] podpis: sig klíčem: krátký. } chytit: { :e
	Výstup psát: e, nový-řádek.
}, spustit.
