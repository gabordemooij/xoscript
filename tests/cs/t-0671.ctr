# veřejný klíč (k zabezpečení API atd.)
Server init.

# vygenerovat klíče
>> klíče := Trezor vygenerovat-klíče.

# soukromý (tajný) klíč
>> sk := klíče první.

# veřejný klíč
>> pk := klíče poslední.

# podepsat zprávu
>> sig := Trezor podepsat: ['abc'] klíčem: sk.

# ověřit zprávu (ok)
Výstup psát: ( 
	Trezor
		ověřit: ['abc'] 
		podpis: sig 
		klíčem: pk 
), nový-řádek.

# ověřit zprávu (neúspěch)
Výstup psát: ( 
	Trezor 
		ověřit: ['abd'] 
		podpis: sig 
		klíčem: pk 
), nový-řádek.