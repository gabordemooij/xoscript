# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Trezor vygenerovat-klíče.

# private (secret) key
>> sk := keys první.

# public key
>> pk := keys poslední.

# sign a message
>> sig := Trezor podepsat: ['abc'] klíčem: sk.

# check message (ok)
Výstup psát: ( 
	Trezor
		ověřit: ['abc'] 
		podpis: sig 
		klíčem: pk 
), nový-řádek.

# check message (fail)
Výstup psát: ( 
	Trezor 
		ověřit: ['abd'] 
		podpis: sig 
		klíčem: pk 
), nový-řádek.