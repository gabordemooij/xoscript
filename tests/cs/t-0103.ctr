>> a := Seznam ← Objekt ; Pravda ; Nepravda ; Logický ; 1 ; Číslo ; ['Str'] ; Řetězec ; { ['Empty']. }.
Výstup psát: (a počet), nový-řádek.
{ :i
	Výstup psát: 
	['a '] + 
	((a ? i) typ) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Nic?) buď: [''] nebo: ['NOT']) + 
	[' Nil.'],
	nový-řádek.
} × (a počet).
Výstup psát: ['but.. Nil is.. '] + ((Nic Nic?) buď: ['certainly NIL!'] nebo: ['not NIL??']), nový-řádek.