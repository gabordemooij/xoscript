>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objekt nový.
⚄ při: ['drawFrom:length:'] udělat: { :pool :počet
	
	>> result := [''].
	
	{
		>> index := Číslo random % (pool délka).
		result připojit: ( pool znak: (index + 1) ).
		
	} × počet. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? délka.
Výstup psát: (['x↵'] x random délka).
Výstup psát: (['y↵'] y ?? délka).

