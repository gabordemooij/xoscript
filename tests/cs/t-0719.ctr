Server init.
>> fmt := Formát nový: ['%#3x'].

>> blob := Blob nový: 4.
blob bytes: ( 
	Seznam nový ; 0 ; 1 ; 2 ; 3
).

>> file := Soubor nový: ['/tmp/blob'].
file blob: blob.
blob uvolnit.

>> číst := file blob.
číst 
od: 0 
délka: 4, 
udělat každý: { :i :b 
	Výstup
	psát: (fmt aplikovat-celé: b),
	nový-řádek.
}.
číst uvolnit.
