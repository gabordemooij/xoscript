>> randomizer := { :a :b
	>> minimum := ( a < b ) buď: a nebo: b.
	>> maximum := ( a > b ) buď: a nebo: b.
	>> x := Nic.
	{
		x := Číslo mezi: a a: b.
		((x < minimum) nebo: (x > maximum)) pravda: { 
			Výstup psát: (['Invalid value!']).
			Program konec.
		}.
	} 
	× 100. <- x.
}.
randomizer aplikovat: 0 a: 0.
