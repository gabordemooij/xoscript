>> generátor-náhody := { :a :b
	>> minimum := ( a < b ) buď: a nebo: b.
	>> maximum := ( a > b ) buď: a nebo: b.
	>> x := Nic.
	{
		x := Číslo mezi: a a: b.
		((x < minimum) nebo: (x > maximum)) pravda: { 
			Výstup psát: (['Neplatná hodnota!']).
			Program konec.
		}.
	} 
	× 100. <- x.
}.
generátor-náhody aplikovat: 0 a: 0.
generátor-náhody aplikovat: 1 a: 0.
generátor-náhody aplikovat: 1 a: 1.
generátor-náhody aplikovat: 0 a: 1.
