#Linux
>> OS := Program nastavení: ['OS'].

>> hodiny := Okamžik nový.
	
(OS = ['Haiku']) pravda: {
	hodiny pásmo: ['CET'],
	rok: 2017, měsíc: 7, den: 13,
	hodina: 18, minuta: 0, sekunda: 0.
}, jinak: {
	hodiny pásmo: ['Europe/Amsterdam'],
	rok: 2017, měsíc: 7, den: 13,
	hodina: 18, minuta: 0, sekunda: 0.
}.

hodiny při: ['oznámit'] udělat: {
	Výstup psát: sebe, nový-řádek.
}.


hodiny přičíst: 2    hodina, oznámit.
hodiny přičíst: 1    hodina, oznámit.
hodiny přičíst: 19 minuta, oznámit.
hodiny přičíst: 1  minuta, oznámit.
hodiny přičíst: 1  minuta, oznámit.
hodiny přičíst: 19 sekunda, oznámit.
hodiny přičíst: 1  sekunda, oznámit.
hodiny přičíst: 1  sekunda, oznámit.
hodiny přičíst: 2    rok, oznámit.
hodiny přičíst: 1    rok, oznámit.

