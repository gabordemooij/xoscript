#Linux
>> OS := Program nastavení: ['OS'].

>> clock := Okamžik nový.
	
(OS = ['Haiku']) pravda: {
	clock pásmo: ['CET'],
	rok: 2017, měsíc: 7, den: 13,
	hodina: 18, minuta: 0, sekunda: 0.
}, jinak: {
	clock pásmo: ['Europe/Amsterdam'],
	rok: 2017, měsíc: 7, den: 13,
	hodina: 18, minuta: 0, sekunda: 0.
}.

clock při: ['tell'] udělat: {
	Výstup psát: sebe, nový-řádek.
}.


clock přičíst: 2    hodina, tell.
clock přičíst: 1    hodina, tell.
clock přičíst: 19 minuta, tell.
clock přičíst: 1  minuta, tell.
clock přičíst: 1  minuta, tell.
clock přičíst: 19 sekunda, tell.
clock přičíst: 1  sekunda, tell.
clock přičíst: 1  sekunda, tell.
clock přičíst: 2    rok, tell.
clock přičíst: 1    rok, tell.

(OS = ['Haiku']) pravda: {
clock přičíst: 5   měsíc.
clock pásmo: ['CEST'], tell.
}, jinak: {
	clock přičíst: 5   měsíc, tell.
}.

clock přičíst: 1   měsíc, tell.
clock přičíst: 19    den, tell.
clock přičíst: 1    hodina, tell.
clock přičíst: 120  yard, tell.
