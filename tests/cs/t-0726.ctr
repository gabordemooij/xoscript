# test buffers PKI/Sign 
Server init.

>> long := ( Seznam nový naplnit: 1000 čím: ['a'] ) spojit: [''].

# sign a message
Výstup psát: ( 
	Trezor podepsat: ['abc'] klíčem: long
), nový-řádek.

Výstup psát: ( 
	Trezor
		ověřit: ['abc'] 
		podpis: long 
		klíčem: long
), nový-řádek.

Výstup psát: (
	Trezor heš-hesla: long ověřit: long
), nový-řádek.
