

>> Matrjoška := Objekt nový.
Matrjoška při: ['double:'] udělat: { :tajemství
	vlastní tajemství := tajemství × 2.
}.
Matrjoška při: ['nový:'] udělat: { :tajemství
	>> odpověď := Nic.
	>> t := (tajemství > 255).
	Výstup psát: (tajemství + [' | '] + t), nový-řádek.
	t pravda: {
		odpověď := tajemství.
	}, jinak: {
		odpověď := Matrjoška rekurzivní nový: (sebe double: tajemství).
	}. <- odpověď.
}.

>> x := Matrjoška nový: 2.
