

>> Matryoshka := Objekt nový.
Matryoshka při: ['double:'] udělat: { :secret
	vlastní secret := secret × 2.
}.
Matryoshka při: ['nový:'] udělat: { :secret
	>> answer := Nic.
	>> t := (secret > 255).
	Výstup psát: (secret + [' | '] + t), nový-řádek.
	t pravda: {
		answer := secret.
	}, jinak: {
		answer := Matryoshka rekurzivní nový: (sebe double: secret).
	}. <- answer.
}.

>> x := Matryoshka nový: 2.
