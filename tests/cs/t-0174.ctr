


>> použitá-paměť1 := 0.
>> použitá-paměť2 := 0.
>> použitá-paměť3 := 0.
>> použitá-paměť4 := 0.

Program správa-paměti: 0.
>> paleta := Nic.
>> barvy := Nic.

{
paleta := Slovník nový.
paleta 
	umístit: ['#F00'] na: ['červená'],
	umístit: ['#0F0'] na: ['zelená'],
	umístit: ['#00F'] na: ['modrá'].
Výstup psát: ['počet RGB kódů v paletě: '] + ( paleta počet ), nový-řádek.
Výstup psát: ['RGB kód zelené je: '] + ( paleta ? ['zelená'] ), nový-řádek.
barvy := [''].
( paleta každý: { :název :kód
		barvy := barvy + ( název + [':'] + kód ).
} ).
Výstup psát: ['Všechny barvy v paletě: '] + barvy, nový-řádek.
} spustit.
Program vymazat-paměť.
použitá-paměť1 := (Program paměť ? 0).

