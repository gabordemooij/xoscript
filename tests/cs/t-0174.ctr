


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program správa-paměti: 0.
>> palette := Nic.
>> colors := Nic.

{
palette := Slovník nový.
palette 
	umístit: ['#F00'] na: ['red'],
	umístit: ['#0F0'] na: ['green'],
	umístit: ['#00F'] na: ['blue'].
Výstup psát: ['number of RGB codes in palette: '] + ( palette počet ), nový-řádek.
Výstup psát: ['RGB code of green is: '] + ( palette ? ['green'] ), nový-řádek.
colors := [''].
( palette každý: { :název :kód
		colors := colors + ( název + [':'] + kód ).
} ).
Výstup psát: ['All colors in palette: '] + colors, nový-řádek.
} spustit.
Program vymazat-paměť.
usedMemory1 := (Program paměť ? 0).

{
palette := Slovník nový.
palette 
	umístit: ['#F00'] na: ['red'],
	umístit: ['#0F0'] na: ['green'],
	umístit: ['#00F'] na: ['blue'].
