>> t := Nic.

# you can control the time zone for
# parsing like this:
Okamžik pásmo: ['CET'].
t := Okamžik z: ['1981-02-03 04:05:06'].
Výstup psát: t, nový-řádek.

# now using CEST time zone:
Okamžik pásmo: ['CEST'].
t := Okamžik z: ['1981-02-03 04:05:06'].
Výstup psát: t, nový-řádek.

# error if string cannot be parsed
{ Okamžik z: ['1900']. } chytit: { Nic. }, spustit.
