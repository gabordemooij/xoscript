# dekódovat z utf16le/be nebo utf32le/be do utf8
Server init.
>> utf16 := Blob nový: 8, bytes: (
	Seznam nový ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Výstup psát: ( utf16 dekódovat: ['utf16le'] ), nový-řádek.

utf16 uvolnit.
>> utf32 := Blob nový: 13, bytes: (
	Seznam nový ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Výstup psát: ( utf32 dekódovat: ['utf32be'] ), nový-řádek.
utf32 uvolnit.