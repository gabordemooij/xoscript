# Tento test ověřuje, zda string_fill_in neztratí svůj slot (uvolněný GC) v režimu 4
# odkaz ve world.c
>> Záznamník := Objekt nový.

Záznamník při: ['say:'] udělat: { :str
	Výstup psát: str, nový-řádek.
}.

>> Položka := Objekt nový.

Položka při: ['nový:'] udělat: { :id
	<- sebe nový id: id.
}.

Položka při: ['id:'] udělat: { :id
	vlastní id := id.
}.

Položka při: ['id'] udělat: { <- vlastní id. }.


Položka při: ['řetězec'] udělat: {
	>> str := ['Item#~no'].
	str ~no: vlastní id.
	<- str.
}.


>> Print := Objekt nový.

Print při: ['items'] udělat: { 
	
	vlastní položka := Položka nový: 1.
	
	# zde buď segfault, nebo špatný řetězec
	Záznamník say: (
		['~item printed.'] ~item: vlastní položka
	).
	
	
}.

Print items.