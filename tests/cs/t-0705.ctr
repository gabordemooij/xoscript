

>> obj := Objekt nový.

obj při: ['pozdravit'] udělat: {
	<- ['ahoj'].
}.

# musí vypsat hi123hi123ok
obj při: ['úkol'] udělat: {
	vlastní vlastnost := 123.
	{
		# zkusit váže sebe/vlastní k objektu místo k bloku
		Výstup psát: sebe pozdravit.
		Výstup psát: vlastní vlastnost.
		1 / 0.
	} chytit: {
		Výstup psát: sebe pozdravit.
		Výstup psát: vlastní vlastnost.
		Výstup psát: ['ok'].
	}, zkusit.
}.

obj úkol.