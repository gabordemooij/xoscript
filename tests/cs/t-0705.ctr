

>> obj := Objekt nový.

obj při: ['greet'] udělat: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj při: ['task'] udělat: {
	vlastní property := 123.
	{
		# try binds self/own to object instead of block
		Výstup psát: sebe greet.
		Výstup psát: vlastní property.
		1 / 0.
	} chytit: {
		Výstup psát: sebe greet.
		Výstup psát: vlastní property.
		Výstup psát: ['ok'].
	}, zkusit.
}.

obj task.