Server init.
>> a := Blob nový: 4.
a bytes: ( Seznam nový ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob nový: 4.
b bytes: ( Seznam nový ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
# zděděný blob nedostane buffer, takže je k ničemu
# projde přes ctr_accept(), ale protože buffer ptr == null, vrát
>> c := a nový.
{ 
>> n := a ^ c.
Výstup psát: ['xorred:'], nový-řádek. 
Výstup psát: n, nový-řádek. 
} chytit: { :e Výstup psát: e, nový-řádek. }, spustit.
a uvolnit.
b uvolnit.
