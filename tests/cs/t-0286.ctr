['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Výstup psát: (x + y), nový-řádek.

>> x := 10040.07.
>> y := 10305.60.

Výstup psát: (x + y), nový-řádek.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Výstup psát: (x + y + z), nový-řádek.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Výstup psát: (x + y + z), nový-řádek.

>> q := 0.1.2.

Výstup psát: (q), nový-řádek.

>> q := 012.

Výstup psát: (q), nový-řádek.
