>> str := ['write:'].
Výstup zpráva: ['psát:'] parametry: (Seznam ← ['Hello World']), nový-řádek. 

Číslo při: ['isbetween:and:'] udělat: { :a :b <- ((sebe ≥ a) a: (sebe ≤ b)).
}.

str := ['isbetween:and:'].
Výstup psát: (3 zpráva: str parametry: (Seznam ← 2 ; 8)), nový-řádek.
Výstup psát: (3 zpráva: str parametry: (Seznam ← 1 ; 2)), nový-řádek.


>> CoffeeMachine := Objekt nový.
CoffeeMachine při: ['makeCoffeeWithSugar:milk:'] udělat: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Seznam ← 4 ; 2.
Výstup psát: ( CoffeeMachine zpráva: order parametry: coffeeConfiguration ), nový-řádek.
