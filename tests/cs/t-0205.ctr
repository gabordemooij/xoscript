>> str := ['write:'].
Výstup zpráva: ['psát:'] parametry: (Seznam ← ['Hello World']), nový-řádek. 

Číslo při: ['isbetween:and:'] udělat: { :a :b <- ((sebe ≥ a) a: (sebe ≤ b)).
}.

str := ['isbetween:and:'].
Výstup psát: (3 zpráva: str parametry: (Seznam ← 2 ; 8)), nový-řádek.
Výstup psát: (3 zpráva: str parametry: (Seznam ← 1 ; 2)), nový-řádek.


>> Kávovar := Objekt nový.
Kávovar při: ['makeCoffeeWithSugar:milk:'] udělat: { :sugar :milk <- ( ['Tady máte... kávu s '] + 
			sugar +
			[' lžičkami cukru a '] +
			milk +
			[' kapkami mléka.']
	).
}.

>> objednávka := ['makeCoffeeWithSugar:milk:'].
>> nastavení-kávy := Seznam ← 4 ; 2.
Výstup psát: ( Kávovar zpráva: objednávka parametry: nastavení-kávy ), nový-řádek.
