>> a := 3.
>> b := a kopírovat.
a odečíst: 1.
Výstup psát: [' a = '] + a.
Výstup psát: [' b = '] + b.
a := 3.
b := a + 4.
Výstup psát: [' a = '] + a.
Výstup psát: [' b = '] + b.
>> x := 3.
>> y := x kopírovat.
x přičíst: 10.
y odečíst: 1.
Výstup psát: [' x = '] + x.
Výstup psát: [' y = '] + y.
>> q := Objekt nový.
q při: ['setProperty:'] udělat: { :x
	vlastní prop := x.
}.
q při: ['getProperty'] udělat: { <- vlastní prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Výstup psát: [' p = '] + (p getProperty).
