
>> a := Seznam ← (Seznam ← 100 ; 200 ; 300) ; (Seznam ← 9 ; 8 ; 7).
Výstup psát: ['at 0,1 :'].
Výstup psát: a ? 0 ? 1, nový-řádek. 
Výstup psát: ['at 1,2 :'].
Výstup psát: a ? 1 ? 2, nový-řádek. 
>> menu := Slovník nový.
menu umístit: (Seznam ← ['pizza'] ; ['spaghetti']) na: ['Italian Cuisine'].
menu umístit: (Seznam ← ['bifteki'] ; ['suflaki']) na: ['Greek Cuisine'].
Výstup psát: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), nový-řádek. 
Výstup psát: ['but not on the same plate.'], nový-řádek.
