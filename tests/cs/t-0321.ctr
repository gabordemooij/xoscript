# test jednotek

Program vymazat-paměť.

>> Ovoce := Objekt nový.
Ovoce při: ['nový'] udělat: {
	>> f := sebe nový.
	f apples: 0. <- f.
}.
Ovoce při: ['apples:'] udělat: { :a vlastní jablka := a. }.
Ovoce při: ['jablka'] udělat: { <- vlastní jablka. }.
Ovoce při: ['+'] udělat: { :f
	>> n := Ovoce nový.
	n apples: (f jablka + vlastní jablka). <- n.
}.
Číslo při: ['jablka'] udělat: { <- ((Ovoce nový) apples: sebe).
}.

Ovoce při: ['řetězec'] udělat: { <- vlastní jablka + [' jablek '].
}.

>> q := 3 jablka + 4 jablka.
Výstup psát: q, nový-řádek.




q := 3 jablka + 4 jablka.
Výstup psát: q, nový-řádek.



q := 3 jablka + 4 jablka.
Výstup psát: q, nový-řádek.


