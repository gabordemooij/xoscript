
Řetězec při: ['html'] udělat: { <- (
		sebe
		nahradit: ['&'] za: ['&amp;'],
		nahradit: ['<'] za: ['&lt;'],
		nahradit: ['>'] za: ['&gt;'],
		nahradit: ['"'] za: ['&quot;']
	).
}.

>> HtmlŠtětec := Objekt nový.

HtmlŠtětec při: ['odpovědět:'] udělat: { :tag
	Výstup psát: (['<tag>↵'] tag: tag ).
}.

HtmlŠtětec při: ['odpovědět:a:'] udělat: { :tag :content
	tag := ( tag od: 0 délka: (tag délka - 1) ).
	Výstup psát: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlŠtětec při: ['content:'] udělat: { :text
	Výstup psát: text html, nový-řádek.
}.

HtmlŠtětec při: ['atr:hodnota:'] udělat: { :atr :value <- ['attr="value"'] attr: atr, value: value.
}.

>> h := HtmlŠtětec nový.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h atr: ['class'] hodnota: ['bold']),
		/span
	/body
/html.
		
