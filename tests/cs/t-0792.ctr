Server init.

>> DB := Maria-DB nový hostitel: ['localhost'],
	uživatel: ['xo'],
	heslo: ['pass123'],
	název-databáze: ['xobase'],
	připojit.
	
>> SQL := ['SELECT "hello" AS "world" '].

# rychlejší způsob, získat dotaz z DB:
>> dotaz2 := DB dotaz: SQL.

# teď nemusíte nastavovat DB
dotaz2 načíst: { :řádka
	Výstup psát: řádka world, nový-řádek.
}.
