Server init.

>> DB := Maria-DB nový hostitel: ['localhost'],
	uživatel: ['xo'],
	heslo: ['pass123'],
	název-databáze: ['xobase'],
	připojit.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB dotaz: SQL.

# now you don't have to set DB
query2 načíst: { :row
	Výstup psát: row world, nový-řádek.
}.
