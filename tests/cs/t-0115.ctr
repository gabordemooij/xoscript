{
	tato-úloha chyba: ['Dont fail.'].
	unknown doSomething.
} chytit: {
	Výstup psát: ['Caught!'].
}, spustit.

{
	tato-úloha chyba: ['Dont fail.'].
	vlastní unknown doSomething.
} chytit: {
	Výstup psát: ['Caught!'].
}, spustit.

{
	tato-úloha chyba: ['Dont fail.'].
	unknown := 122.
} chytit: {
	Výstup psát: ['Caught!'].
}, spustit.


{
	tato-úloha chyba: ['Dont fail.'].
	Pravda přestat.
	Výstup psát: ['FAIL'].
} chytit: {
	Výstup psát: ['Caught!'].
}, spustit.

{
	{
		tato-úloha chyba: ['Dont fail.'].
		Pravda přestat.
		Výstup psát: ['FAIL'].
	} chytit: { :x
		(x = ['Dont fail.']) pravda: { tato-úloha chyba: ['Nested Caught!']. }.
	}, spustit.
} chytit: { :e
	Výstup psát: e.
}, spustit.
