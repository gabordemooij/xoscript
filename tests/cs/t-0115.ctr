{
	tato-úloha chyba: ['Neselži.'].
	neznámý udělej-něco.
} chytit: {
	Výstup psát: ['Chyceno!'].
}, spustit.

{
	tato-úloha chyba: ['Neselži.'].
	vlastní neznámý udělej-něco.
} chytit: {
	Výstup psát: ['Chyceno!'].
}, spustit.

{
	tato-úloha chyba: ['Neselži.'].
	neznámý := 122.
} chytit: {
	Výstup psát: ['Chyceno!'].
}, spustit.


{
	tato-úloha chyba: ['Neselži.'].
	Pravda přestat.
	Výstup psát: ['CHYBA'].
} chytit: {
	Výstup psát: ['Chyceno!'].
}, spustit.

{
	{
		tato-úloha chyba: ['Neselži.'].
		Pravda přestat.
		Výstup psát: ['CHYBA'].
	} chytit: { :x
		(x = ['Neselži.']) pravda: { tato-úloha chyba: ['Vnořeně chyceno!']. }.
	}, spustit.
} chytit: { :e
	Výstup psát: e.
}, spustit.
