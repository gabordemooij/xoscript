# test qualifiers

>> $ := Objekt nový.

$ při: ['odpovědět:'] udělat: { :x
	
	>> operation := x znak: 0.
	>> valuta := x znak: 1.
	>> money := x přeskočit: 2.
	
	>> amount := 0.

	( operation = ['+'] ) pravda: {
		( valuta = ['£'] ) pravda: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Výstup psát: x, nový-řádek.


>> Fruit := Objekt nový.

Fruit při: ['nový'] udělat: {
	>> f := sebe nový.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit při: ['apples:'] udělat: { :a vlastní apples := a. }.
Fruit při: ['oranges:'] udělat: { :p vlastní oranges := p. }.
Fruit při: ['apples'] udělat: { <- vlastní apples. }.
Fruit při: ['oranges'] udělat: { <- vlastní oranges. }.

Fruit při: ['+'] udělat: { :f
	
	>> n := Fruit nový.
	f přičíst: 1.
	
	n apples: (f apples + vlastní apples).
	n oranges:  (f oranges  + vlastní oranges). <- n.
}.

Fruit při: ['řetězec'] udělat: { <- ( vlastní apples řetězec + [' apples and '] + vlastní oranges + [' oranges'] ).
}.

Číslo při: ['apples'] udělat: { <- ((Fruit nový) apples: sebe).
}.

Číslo při: ['apple'] udělat: { <- ((Fruit nový) apples: sebe).
}.

Číslo při: ['oranges'] udělat: { <- ((Fruit nový) oranges: sebe).
}.




Výstup psát: (1 apple + 3 oranges + 4 apples), nový-řádek.


Řetězec při: ['twice'] udělat: { <- ((sebe řetězec) + (sebe řetězec)).
}.



Výstup psát: ['❤❤❤'] twice.



