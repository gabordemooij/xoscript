# test jednotek

>> $ := Objekt nový.

$ při: ['odpovědět:'] udělat: { :x
	
	>> operace := x znak: 0.
	>> valuta := x znak: 1.
	>> peníze := x přeskočit: 2.
	
	>> částka := 0.

	( operace = ['+'] ) pravda: {
		( valuta = ['£'] ) pravda: { částka := 1.28 × peníze. }.
	}. <- částka.
}.



>> x := $ +£20.

Výstup psát: x, nový-řádek.


>> Ovoce := Objekt nový.

Ovoce při: ['nový'] udělat: {
	>> f := sebe nový.
	f apples: 0.
	f oranges: 0. <- f.
}.

Ovoce při: ['apples:'] udělat: { :a vlastní jablka := a. }.
Ovoce při: ['oranges:'] udělat: { :p vlastní pomeranče := p. }.
Ovoce při: ['jablka'] udělat: { <- vlastní jablka. }.
Ovoce při: ['pomeranče'] udělat: { <- vlastní pomeranče. }.

Ovoce při: ['+'] udělat: { :f
	
	>> n := Ovoce nový.
	f přičíst: 1.
	
	n apples: (f jablka + vlastní jablka).
	n oranges:  (f pomeranče  + vlastní pomeranče). <- n.
}.

Ovoce při: ['řetězec'] udělat: { <- ( vlastní jablka řetězec + [' jablek a '] + vlastní pomeranče + [' pomerančů'] ).
}.

Číslo při: ['jablka'] udělat: { <- ((Ovoce nový) apples: sebe).
}.

Číslo při: ['apple'] udělat: { <- ((Ovoce nový) apples: sebe).
}.

Číslo při: ['pomeranče'] udělat: { <- ((Ovoce nový) oranges: sebe).
}.




Výstup psát: (1 apple + 3 pomeranče + 4 jablka), nový-řádek.


Řetězec při: ['dvakrát'] udělat: { <- ((sebe řetězec) + (sebe řetězec)).
}.



Výstup psát: ['❤❤❤'] dvakrát.



