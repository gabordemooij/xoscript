Výstup psát: ['Test object'], nový-řádek.
>> a := Objekt nový. 
a při: ['item:'] udělat: { :lst
	vlastní lst := lst. 
}.
a při: ['item'] udělat: { <- vlastní lst.
}.
a item: (
	Seznam nový ; 1 ; (
		Seznam nový ; ['a'] ; (
			Seznam nový ; ( Okamžik nový: 1 )
		) ; ( Int64 z-řetězce: ['321'] )
	)
).
Výstup psát: a item, nový-řádek.
>> old-lst-address := a item prototyp adresa-paměti.
a save-as: ['/tmp/a.bin'].
Výstup psát: ['========== RELOADING SNAP:'], nový-řádek.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b item prototyp adresa-paměti = old-lst-address) pravda: {
	Výstup psát: ['Object link re-attached.'], nový-řádek.
}.
Výstup psát: ( b item ), nový-řádek.
