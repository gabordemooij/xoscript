Server init.
>> f := Formát nový: ['%d'].
>> a := Blob nový: 4.
a bytes: ( Seznam nový ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob nový: 4.
b bytes: ( Seznam nový ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a od: 0 délka: 3, každý: { :i :byte
	Výstup psát: ( f aplikovat-celé: byte ), nový-řádek.
}.
a ^ b.
a od: 0 délka: 3, každý: { :i :byte
	Výstup psát: ( f aplikovat-celé: byte ), nový-řádek.
}.
a ^ b.
a od: 0 délka: 3, každý: { :i :byte
	Výstup psát: ( f aplikovat-celé: byte ), nový-řádek.
}.
a uvolnit.
b uvolnit.

{ a ^ Objekt. } chytit: { :e Výstup psát: e, nový-řádek. }, spustit.
