#Linux
>> clock := Okamžik nový.
clock pásmo: ['UTC-1'].
clock rok: 1981, měsíc: 1, den: 5,
      hodina: 13, minuta: 15, sekunda: 13.

Výstup psát: clock, nový-řádek.
clock pásmo: ['UTC+0'].

Výstup psát: (
	(clock rok surový) + ['-'] + (clock měsíc) + ['-'] + (clock den) + [' '] +
	(clock hodina) + [':'] + (clock minuta) + [':'] + (clock sekunda) + [' '] +
	['W'] + (clock týden) + (clock pásmo)
), nový-řádek.


clock pásmo: ['UTC-1'].
Výstup psát: (
	(clock rok surový) + ['-'] + (clock měsíc) + ['-'] + (clock den) + [' '] +
	(clock hodina) + [':'] + (clock minuta) + [':'] + (clock sekunda) + [' '] +
	['W'] + (clock týden) + (clock pásmo)
), nový-řádek.
