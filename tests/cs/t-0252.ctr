#Linux
>> hodiny := Okamžik nový.
hodiny pásmo: ['UTC-1'].
hodiny rok: 1981, měsíc: 1, den: 5,
      hodina: 13, minuta: 15, sekunda: 13.

Výstup psát: hodiny, nový-řádek.
hodiny pásmo: ['UTC+0'].

Výstup psát: (
	(hodiny rok surový) + ['-'] + (hodiny měsíc) + ['-'] + (hodiny den) + [' '] +
	(hodiny hodina) + [':'] + (hodiny minuta) + [':'] + (hodiny sekunda) + [' '] +
	['W'] + (hodiny týden) + (hodiny pásmo)
), nový-řádek.


hodiny pásmo: ['UTC-1'].
Výstup psát: (
	(hodiny rok surový) + ['-'] + (hodiny měsíc) + ['-'] + (hodiny den) + [' '] +
	(hodiny hodina) + [':'] + (hodiny minuta) + [':'] + (hodiny sekunda) + [' '] +
	['W'] + (hodiny týden) + (hodiny pásmo)
), nový-řádek.
