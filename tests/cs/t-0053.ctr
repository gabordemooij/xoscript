60 × {
	>> x := (Číslo náhodný % 6) + 1.
	(x ≤ 6) nepravda: { Výstup psát: ['CHYBA']. }.
	(x ≥0) nepravda: { Výstup psát: ['CHYBA']. }.
	x := (Číslo náhodný % 3) + 1.
	(x < 3) nepravda: { Výstup psát: ['CHYBA']. }.
	(x>-1) nepravda: { Výstup psát: ['CHYBA']. }.
	x := ((Logický hodit-mincí) číslo).
	(x = 0 nebo: x = 1) nepravda: { Výstup psát: ['CHYBA']. }.
	x := ((Pravda hodit-mincí) číslo).
	(x = 0 nebo: x = 1) nepravda: { Výstup psát: ['CHYBA']. }.
	x := (Logický hodit-mincí buď: ['PANNA'] nebo: ['OREL']).
	((x = ['PANNA']) nebo: (x = ['OREL'])) nepravda: { Výstup psát: ['CHYBA']. }.
}.
Výstup psát: ['HOTOVO'].

