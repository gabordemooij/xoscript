60 × {
	>> x := (Číslo random % 6) + 1.
	(x ≤ 6) nepravda: { Výstup psát: ['FAIL']. }.
	(x ≥0) nepravda: { Výstup psát: ['FAIL']. }.
	x := (Číslo random % 3) + 1.
	(x < 3) nepravda: { Výstup psát: ['FAIL']. }.
	(x>-1) nepravda: { Výstup psát: ['FAIL']. }.
	x := ((Logický flip) číslo).
	(x = 0 nebo: x = 1) nepravda: { Výstup psát: ['FAIL']. }.
	x := ((Pravda flip) číslo).
	(x = 0 nebo: x = 1) nepravda: { Výstup psát: ['FAIL']. }.
	x := (Logický flip buď: ['HEAD'] nebo: ['TAIL']).
	((x = ['HEAD']) nebo: (x = ['TAIL'])) nepravda: { Výstup psát: ['FAIL']. }.
}.
Výstup psát: ['DONE'].

