>> Slurp := Objekt nový.

Slurp při: ['nový'] udělat: {
	vlastní str := [''].
}.

Slurp při: ['odpovědět:'] udělat: { :blah
		(vlastní str = ['']) pravda: {
			vlastní str připojit: blah.
		}, jinak: {
			vlastní str připojit: [' '].
			vlastní str připojit: blah.
		}.
}.

Slurp při: ['odpovědět:a:'] udělat: { :blah :blahah
		(blah délka > 1) pravda: {
			vlastní str připojit: (blah od: 0 délka: (blah délka - 1)).
		}, jinak: {
			vlastní str připojit: blah.
		}.
		vlastní str připojit: [' '].
		vlastní str připojit: blahah.
}.

Slurp při: ['obtain'] udělat: {
	>> buffer := vlastní str.
	vlastní str := ['']. <- buffer.
}.


>> x := Slurp nový.
x + 3.
Výstup psát: (x obtain), nový-řádek.
x echo: ['Hello world'].
Výstup psát: (x obtain), nový-řádek.
x tellme: 123 and: 987.
Výstup psát: (x obtain), nový-řádek.
