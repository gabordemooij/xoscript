Server init.

>> DB := Maria-DB nový hostitel: ['localhost'],
	uživatel: ['xo'],
	heslo: ['pass123'],
	název-databáze: ['xobase'],
	připojit.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> parametry-hledání := Maria-Dotaz nový: SQL.

# set database
parametry-hledání databáze: DB.

parametry-hledání načíst: { :row
	Výstup psát: row world, nový-řádek.
}.
