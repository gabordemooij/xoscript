Server init.

>> DB := Maria-DB nový hostitel: ['localhost'],
	uživatel: ['xo'],
	heslo: ['pass123'],
	název-databáze: ['xobase'],
	připojit.
	
>> SQL := ['SELECT "hello" AS "world" '].

# ručně vytvořit dotaz
>> parametry-hledání := Maria-Dotaz nový: SQL.

# nastavit databázi
parametry-hledání databáze: DB.

parametry-hledání načíst: { :řádka
	Výstup psát: řádka world, nový-řádek.
}.
