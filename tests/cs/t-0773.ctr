Výstup psát: ['Test object'], nový-řádek.
>> a := Objekt nový. 
a při: ['item:'] udělat: { :int64
	vlastní int64 := int64. 
}.
a při: ['item'] udělat: { <- vlastní int64.
}.
a item: ( Int64 z-řetězce: ['9999'] ).
Výstup psát: a item, nový-řádek.
>> old-int64-address := a item prototyp adresa-paměti.
a save-as: ['/tmp/a.bin'].
Výstup psát: ['========== RELOADING SNAP:'], nový-řádek.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b item prototyp adresa-paměti = old-int64-address) pravda: {
	Výstup psát: ['Object link re-attached.'], nový-řádek.
}.
Výstup psát: ( b item ), nový-řádek.
