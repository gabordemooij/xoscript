
>> dictionary := (
	Slovník nový
		umístit: ['b'] na: ['a'],
		umístit: ['a'] na: ['b'],
		umístit: ['z'] na: ['x'],
		umístit: ['hello'] na: ['hallo'],
		umístit: ['human'] na: ['human']
).

>> comparisons := Seznam nový.
dictionary každý: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a porovnat: b)
	).
}.

comparisons seřadit: { :a :b <- ( a porovnat: b ). }.
Výstup psát: ( comparisons spojit: ['↵'] ), nový-řádek.
comparisons spojit: ['↵'].
