
Server init.
>> rq := HTTP-Požadavek nový.
Výstup psát: ['HTTP-GET d[]=']  + ( rq get-seznam: ['d[]'] ), nový-řádek. # GET
Výstup psát: ['HTTP-GET f[]=']  + ( rq get-seznam: ['f[]'] ), nový-řádek. # GET
Výstup psát: ['HTTP-POST e[]='] + ( rq post-seznam: ['e[]'] ), nový-řádek. # GET
Výstup psát: ['HTTP-POST c=']   + ( rq post: ['c'] ), nový-řádek. # GET
Výstup psát: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), nový-řádek. # GET
