
Server init.
>> pož := HTTP-Požadavek nový.
Výstup psát: ['HTTP-GET d[]=']  + ( pož get-seznam: ['d[]'] ), nový-řádek. # GET
Výstup psát: ['HTTP-GET f[]=']  + ( pož get-seznam: ['f[]'] ), nový-řádek. # GET
Výstup psát: ['HTTP-POST e[]='] + ( pož post-seznam: ['e[]'] ), nový-řádek. # GET
Výstup psát: ['HTTP-POST c=']   + ( pož post: ['c'] ), nový-řádek. # GET
Výstup psát: ['HTTP-POST xx=']  + ( pož post: ['xx'] ), nový-řádek. # GET
