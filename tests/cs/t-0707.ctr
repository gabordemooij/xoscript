# test přetypování / převodů / vazeb
Program správa-paměti: 4.
Server init.

>> počítadlo := 0.
>> db := Maria-DB nový hostitel: ['localhost'],
	uživatel: ['xo'], heslo: ['pass123'], název-databáze: ['xobase'], připojit.

>> DvoucifernýFormát := Formát nový: ['%02d'].

# Datum a čas
{
	>> rok     := Číslo mezi: 1995 a: 2050, řetězec.
	>> měsíc    := DvoucifernýFormát aplikovat-celé: (Číslo mezi: 1 a: 12), řetězec.
	>> den      := DvoucifernýFormát aplikovat-celé: (Číslo mezi: 1 a: 28), řetězec.
	>> hodina     := DvoucifernýFormát aplikovat-celé: (Číslo mezi: 1 a: 23), řetězec.
	>> minuta   := DvoucifernýFormát aplikovat-celé: (Číslo mezi: 1 a: 59), řetězec.
	>> sekunda   := DvoucifernýFormát aplikovat-celé: (Číslo mezi: 1 a: 59), řetězec.
	>> datum-čas := ['YYYY-MM-DD HH:II:SS'].	
	datum-čas
		YYYY: rok,
		MM: měsíc,
		DD: den,
		HH: hodina,
		II: minuta,
		SS: sekunda.
	>> parametry-hledání :=
	db dotaz: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: datum-čas),
	načíst: { :řádka
		(řádka mydatetime = datum-čas) nepravda: {
			tato-úloha chyba: (
				['Očekáváno: <expected>, ale získáno: <observation>']
				<expected>: datum-čas,
				<observation>: řádka mydatetime
			).
		}.
	
	}.
	počítadlo přičíst: 1.
} * 100.

# Datum
{
	>> rok     := Číslo mezi: 1995 a: 2050, řetězec.
	>> měsíc    := DvoucifernýFormát aplikovat-celé: (Číslo mezi: 1 a: 12), řetězec.
	>> den      := DvoucifernýFormát aplikovat-celé: (Číslo mezi: 1 a: 28), řetězec.
	>> datum     := ['YYYY-MM-DD'].
	datum
		YYYY: rok,
		MM: měsíc,
		DD: den.
	>> parametry-hledání :=
	db dotaz: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: datum),
	načíst: { :řádka
		(řádka mydate = datum) nepravda: {
			tato-úloha chyba: (
				['Očekáváno: <expected>, ale získáno: <observation>']
				<expected>: datum,
				<observation>: řádka mydate
			).
		}.
	}.
	počítadlo přičíst: 1.
} * 100.


# Čas
{
	>> hodina     := DvoucifernýFormát aplikovat-celé: (Číslo mezi: 1 a: 23), řetězec.
	>> minuta   := DvoucifernýFormát aplikovat-celé: (Číslo mezi: 1 a: 59), řetězec.
	>> sekunda   := DvoucifernýFormát aplikovat-celé: (Číslo mezi: 1 a: 59), řetězec.
	>> čas := ['HH:II:SS'].
	čas
		HH: hodina,
		II: minuta,
		SS: sekunda.
	>> parametry-hledání :=
	db dotaz: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: čas),
	načíst: { :řádka
		(řádka mytime = čas) nepravda: {
			tato-úloha chyba: (
				['Očekáváno: <expected>, ale získáno: <observation>']
				<expected>: datum-čas,
				<observation>: řádka mytime
			).
		}.
	}.
	počítadlo přičíst: 1.
} * 100.


# Řetězce (varchar/text)
>> str1 := Seznam nový naplnit: 100000 čím: ['x'], spojit: [''].
{
	>> str2 := Trezor token: 40.
	>> parametry-hledání :=
	db dotaz: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	načíst: { :řádka
		(řádka str1 = str1 a: řádka str2 = str2) nepravda: {
			tato-úloha chyba: (
				['Očekáváno: <expected>, ale získáno: <observation>']
				<expected>: datum-čas,
				<observation>: řádka mytime
			).
		}.
	}.
	počítadlo přičíst: 1.
} * 100.


# Čísla
{
	>> n1  := Číslo mezi: 1 a: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 z-řetězce: ['9223372036854775807'] ) -
		( Int64 z-řetězce: ['99999'] ) +
		( Int64 z-řetězce: n1 řetězec )
	).
	>> parametry-hledání :=
	db dotaz: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	načíst: { :řádka
		(řádka n1 = n1) nepravda: {
			tato-úloha chyba: (
				['Očekáváno: <expected>, ale získáno: <observation>']
				<expected>: n1,
				<observation>: řádka n1
			).
		}.
		(řádka n2 = n2) nepravda: {
			tato-úloha chyba: (
				['Očekáváno: <expected>, ale získáno: <observation>']
				<expected>: n1,
				<observation>: řádka n2
			).
		}.
		(řádka n3 = n2 zaokrouhlit) nepravda: {
			tato-úloha chyba: (
				['Očekáváno: <expected>, ale získáno: <observation>']
				<expected>: n1,
				<observation>: řádka n3
			).
		}.
		(řádka big = big) nepravda: {
			tato-úloha chyba: (
				['Očekáváno: <expected>, ale získáno: <observation>']
				<expected>: big,
				<observation>: řádka big
			).
		}.
		
	}.
	počítadlo přičíst: 1.
} * 100.


Výstup psát: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: počítadlo
), nový-řádek.