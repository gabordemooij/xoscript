Číslo při: ['roman'] udělat: {
	>> číslo := sebe kopírovat.
	>> roman := [''].
	{
		{
			(číslo ≥ 1000) pravda: {
				roman připojit: ['Ⅿ'].
				číslo odečíst: 1000.
			}, přestat.
		
			(číslo ≥ 500) pravda: {
				roman připojit: ['Ⅾ'].
				číslo odečíst: 500.
			}, přestat.
		
			(číslo ≥ 100) pravda: {
				roman připojit: ['Ⅽ'].
				číslo odečíst: 100.
			}, přestat.
		
			(číslo ≥ 50) pravda: {
				roman připojit: ['Ⅼ'].
				číslo odečíst: 50.
			}, přestat.
		
			(číslo ≥ 50) pravda: {
				roman připojit: ['Ⅼ'].
				číslo odečíst: 50.
			}, přestat.
		
			(číslo ≥ 10) pravda: {
				roman připojit: ['Ⅹ'].
				číslo odečíst: 10.
			}, přestat.
			
			(číslo ≥ 9) pravda: {
				roman připojit: ['Ⅸ'].
				číslo odečíst: 9.
			}, přestat.
			
			(číslo ≥ 5) pravda: {
				roman připojit: ['Ⅴ'].
				číslo odečíst: 5.
			}, přestat.
			
			(číslo ≥ 4) pravda: {
				roman připojit: ['Ⅳ'].
				číslo odečíst: 4.
			}, přestat.
			
			(číslo ≥ 1) pravda: {
				roman připojit: ['Ⅰ'].
				číslo odečíst: 1.
			}, přestat.
		} postup.
	} zatímco: { <- číslo > 0. }. <- roman.
}.

Výstup psát: 1 roman, nový-řádek.
Výstup psát: 2 roman, nový-řádek.
Výstup psát: 4 roman, nový-řádek.
Výstup psát: 8 roman, nový-řádek.
Výstup psát: 16 roman, nový-řádek.
Výstup psát: 32 roman, nový-řádek.
Výstup psát: 64 roman, nový-řádek.
Výstup psát: 128 roman, nový-řádek.
Výstup psát: 256 roman, nový-řádek.
Výstup psát: 1024 roman, nový-řádek.
