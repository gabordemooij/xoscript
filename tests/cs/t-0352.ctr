Číslo při: ['římsky'] udělat: {
	>> číslo := sebe kopírovat.
	>> římsky := [''].
	{
		{
			(číslo ≥ 1000) pravda: {
				římsky připojit: ['Ⅿ'].
				číslo odečíst: 1000.
			}, přestat.
		
			(číslo ≥ 500) pravda: {
				římsky připojit: ['Ⅾ'].
				číslo odečíst: 500.
			}, přestat.
		
			(číslo ≥ 100) pravda: {
				římsky připojit: ['Ⅽ'].
				číslo odečíst: 100.
			}, přestat.
		
			(číslo ≥ 50) pravda: {
				římsky připojit: ['Ⅼ'].
				číslo odečíst: 50.
			}, přestat.
		
			(číslo ≥ 50) pravda: {
				římsky připojit: ['Ⅼ'].
				číslo odečíst: 50.
			}, přestat.
		
			(číslo ≥ 10) pravda: {
				římsky připojit: ['Ⅹ'].
				číslo odečíst: 10.
			}, přestat.
			
			(číslo ≥ 9) pravda: {
				římsky připojit: ['Ⅸ'].
				číslo odečíst: 9.
			}, přestat.
			
			(číslo ≥ 5) pravda: {
				římsky připojit: ['Ⅴ'].
				číslo odečíst: 5.
			}, přestat.
			
			(číslo ≥ 4) pravda: {
				římsky připojit: ['Ⅳ'].
				číslo odečíst: 4.
			}, přestat.
			
			(číslo ≥ 1) pravda: {
				římsky připojit: ['Ⅰ'].
				číslo odečíst: 1.
			}, přestat.
		} postup.
	} zatímco: { <- číslo > 0. }. <- římsky.
}.

Výstup psát: 1 římsky, nový-řádek.
Výstup psát: 2 římsky, nový-řádek.
Výstup psát: 4 římsky, nový-řádek.
Výstup psát: 8 římsky, nový-řádek.
