# Test sanitizéru utf8
Server init.

>> utf8-případy := Slovník nový
	# Jen ASCII
	umístit: ( Seznam nový ; 65 ; 65 ; 65 ; 65 ; 0 ) na: ['AAAA'],
	# platná 2bajtová sekvence
	umístit: ( Seznam nový ; 194 ; 162 ; 0 ) na: ['¢'],
	# Platné 3bajtové UTF-8
    umístit: ( Seznam nový ; 226 ; 130 ; 172 ; 0 ) na: ['€'],
	# Platné 4bajtové UTF-8
    umístit: ( Seznam nový ; 240 ; 144 ; 141 ; 136 ; 0 ) na: ['𐍈'],
	# Neplatný pokračovací bajt v sekvenci E2 28 AC -> začátek 3b sekv. + 28 špatný pokr. + AC pokr. bajt, ale patří ke stejné chybě
    umístit: ( Seznam nový ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) na: ['A?A'],
	# Příliš dlouhé kódování ASCII 'A' (má se stát ?),
    umístit: ( Seznam nový ; 65 ; 193 ; 129 ; 0 ) na: ['A?'],
	# Neplatný první bajt (0xFF)
    umístit: ( Seznam nový ; 255 ; 0 ) na: ['?'],
	# Neúplná vícebajtová sekvence na konci
    umístit: ( Seznam nový ; 66 ; 226 ; 0 ) na: ['B?'],
    # Prázdný řetězec
    #put: ( List new ) at: [''],
	# Více smíšených sekvencí
    umístit: ( Seznam nový ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) na: ['A€?𐍈B'].
	 
utf8-případy každý: { :key :value
	>> blob := Blob nový: value počet, bytes: value.
	>> str := blob řetězec.
	(str = key) pravda: {
		Výstup psát: ['OK'], nový-řádek.
	}, jinak: {
		Výstup psát: ['Sanitizér UTF8 selhal na: '] + key + [' výsledek: '] + str, nový-řádek.
	}.
	blob uvolnit.
}.
