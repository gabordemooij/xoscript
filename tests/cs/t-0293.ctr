
>> město := Seznam ← ['Londýn'] ; ['Paříž'] ; ['Berlín'].
>> teplota := Seznam ← ['15'] ; ['16'] ; ['15'].
>> počasí := teplota podle: město.
>> města := počasí záznamy seřadit: { :a :b <- (a porovnat: b). }.
>> teploty := počasí hodnoty seřadit: { :a :b <- (a porovnat: b) záporný?. }.

Výstup psát: (města spojit: [',']), nový-řádek.
Výstup psát: (teploty spojit: [',']), nový-řádek.
