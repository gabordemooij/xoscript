
>> city := Seznam ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Seznam ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature podle: city.
>> cities := weather záznamy seřadit: { :a :b <- (a porovnat: b). }.
>> temperatures := weather hodnoty seřadit: { :a :b <- (a porovnat: b) záporný?. }.

Výstup psát: (cities spojit: [',']), nový-řádek.
Výstup psát: (temperatures spojit: [',']), nový-řádek.
