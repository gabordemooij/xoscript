Výstup psát: ['Testovací objekt'], nový-řádek.
>> a := Objekt nový. 

a při: ['item:'] udělat: { :hex-pomocník
	vlastní hex-pomocník := hex-pomocník. 
}.

a při: ['položka'] udělat: {
	<- vlastní hex-pomocník.
}.

a item: Hx nový.

>> stará-adresa-hex-pomocníka := a položka prototyp adresa-paměti.
a save-as: ['/tmp/a.bin'].
Výstup psát: ['========== OPĚTOVNÉ NAČTENÍ SNÍMKU:'], nový-řádek.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b položka prototyp adresa-paměti = stará-adresa-hex-pomocníka) pravda: {
	Výstup psát: ['Odkaz na objekt znovu připojen.'], nový-řádek.
}.
