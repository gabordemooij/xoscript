Výstup psát: ['Test object'], nový-řádek.
>> a := Objekt nový. 

a při: ['item:'] udělat: { :hexhelper
	vlastní hexhelper := hexhelper. 
}.

a při: ['item'] udělat: { <- vlastní hexhelper.
}.

a item: Hx nový.

>> old-hexhelper-address := a item prototyp adresa-paměti.
a save-as: ['/tmp/a.bin'].
Výstup psát: ['========== RELOADING SNAP:'], nový-řádek.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp adresa-paměti = old-hexhelper-address) pravda: {
	Výstup psát: ['Object link re-attached.'], nový-řádek.
}.
