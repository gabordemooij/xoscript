Výstup psát: ['Test object'], nový-řádek.
>> cmd := Příkaz nový.
Výstup psát: cmd ls /tmp, nový-řádek.
>> old-cmd-address := cmd prototyp adresa-paměti.
cmd save-as: ['/tmp/a.bin'].
Výstup psát: ['========== RELOADING SNAP:'], nový-řádek.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b prototyp adresa-paměti = old-cmd-address) pravda: {
	Výstup psát: ['Object link re-attached.'], nový-řádek.
}.
Výstup psát: b ls, nový-řádek.


