#Linux

 >> t := Okamžik nový.
 
t pásmo: ['Europe/Amsterdam'].
t rok: 2020, měsíc: 8, den: 2, hodina: 21, minuta: 2, sekunda: 1.

>> a := t hodina.
>> ams := t pásmo.

t pásmo: ['US/Hawaii'].
>> b := t hodina.
>> hw := t pásmo.

Výstup
psát: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		buď: ['later'] nebo: ['earlier']
	)
),
nový-řádek.
 