Výstup psát: ['Test object'], nový-řádek.
>> a := Objekt nový. 

a při: ['item:'] udělat: { :binhelper
	vlastní binhelper := binhelper. 
}.

a při: ['item'] udělat: { <- vlastní binhelper.
}.

a item: Bin nový.

>> old-binhelper-address := a item prototyp adresa-paměti.
a save-as: ['/tmp/a.bin'].
Výstup psát: ['========== RELOADING SNAP:'], nový-řádek.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp adresa-paměti = old-binhelper-address) pravda: {
	Výstup psát: ['Object link re-attached.'], nový-řádek.
}.


