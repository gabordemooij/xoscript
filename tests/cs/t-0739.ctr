Výstup psát: ['Testovací objekt'], nový-řádek.
>> a := Objekt nový. 

a při: ['item:'] udělat: { :bin-pomocník
	vlastní bin-pomocník := bin-pomocník. 
}.

a při: ['položka'] udělat: {
	<- vlastní bin-pomocník.
}.

a item: Bin nový.

>> stará-adresa-bin-pomocníka := a položka prototyp adresa-paměti.
a save-as: ['/tmp/a.bin'].
Výstup psát: ['========== OPĚTOVNÉ NAČTENÍ SNÍMKU:'], nový-řádek.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b položka prototyp adresa-paměti = stará-adresa-bin-pomocníka) pravda: {
	Výstup psát: ['Odkaz na objekt znovu připojen.'], nový-řádek.
}.


