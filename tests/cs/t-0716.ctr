Výstup psát: ['Test object'], nový-řádek.
>> a := Objekt nový. 

a při: ['state:'] udělat: { :list
	vlastní list := list. 
}.

a při: ['state'] udělat: {
	Výstup psát: vlastní list, nový-řádek.
}.

a state: ( Seznam nový ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
Výstup psát: ['========== RELOADING SNAP:'], nový-řádek.
>> b := Objekt load-from: ['/tmp/a.bin'].
b state.