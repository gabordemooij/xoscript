
>> Rectangle := Objekt nový.

Rectangle při: ['area'] udělat: { <- vlastní délka * vlastní width.
}.

Rectangle při: ['length:'] udělat: { :délka
	vlastní délka := délka.
}.

Rectangle při: ['width:'] udělat: { :width
	vlastní width := width.
}.

Rectangle při: ['nový'] udělat: {
	# this will not result into an infinite loop
	>> rectangle := sebe nový.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle nový.
Výstup psát: a area, nový-řádek. #0

>> b := Rectangle nový length: 2, width: 3.
Výstup psát: b area, nový-řádek. #6

