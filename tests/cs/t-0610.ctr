
>> Obdélník := Objekt nový.

Obdélník při: ['plocha'] udělat: {
	<- vlastní délka * vlastní šířka.
}.

Obdélník při: ['length:'] udělat: { :délka
	vlastní délka := délka.
}.

Obdélník při: ['width:'] udělat: { :šířka
	vlastní šířka := šířka.
}.

Obdélník při: ['nový'] udělat: {
	# to nepovede k nekonečné smyčce
	>> obdélník := sebe nový.
	obdélník length: 0, width: 0.
	<- obdélník.
}.

>> a := Obdélník nový.
Výstup psát: a plocha, nový-řádek. #0

>> b := Obdélník nový length: 2, width: 3.
Výstup psát: b plocha, nový-řádek. #6

