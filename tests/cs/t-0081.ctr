>> map1 := Slovník nový.
>> key1 := Seznam nový.
>> key2 := Seznam nový.

map1
	umístit: ['hello'] na: key1,
	umístit: ['world'] na: key2.


Výstup
	psát: ['Map #1 contains: '] + (map1 na: key1),
	psát: [' and '] + (map1 na: key2), nový-řádek.

>> KeyeableArray := Seznam nový.
KeyeableArray při: ['toString'] udělat: { <- (sebe počet) toString.
}.

>> map2 := Slovník nový.
key1 := KeyeableArray nový.
key2 := KeyeableArray nový.

key1 připojit: 1.

map2
	umístit: ['hello'] na: key1,
	umístit: ['world'] na: key2.

Výstup
	psát: ['Map #2 contains: '] + (map2 na: key1),
	psát: [' and '] + (map2 na: key2), nový-řádek.
