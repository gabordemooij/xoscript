>> mapa1 := Slovník nový.
>> klíč1 := Seznam nový.
>> klíč2 := Seznam nový.

mapa1
	umístit: ['hello'] na: klíč1,
	umístit: ['world'] na: klíč2.


Výstup
	psát: ['Map #1 contains: '] + (mapa1 na: klíč1),
	psát: [' a '] + (mapa1 na: klíč2), nový-řádek.

>> KlíčovatelnéPole := Seznam nový.
KlíčovatelnéPole při: ['na-řetězec'] udělat: { <- (sebe počet) na-řetězec.
}.

>> map2 := Slovník nový.
klíč1 := KlíčovatelnéPole nový.
klíč2 := KlíčovatelnéPole nový.

klíč1 připojit: 1.

map2
	umístit: ['hello'] na: klíč1,
	umístit: ['world'] na: klíč2.

Výstup
	psát: ['Map #2 contains: '] + (map2 na: klíč1),
	psát: [' a '] + (map2 na: klíč2), nový-řádek.
