#ffi test


Server init.

ਪ੍ਰੋਗਰਾਮ ਮੈਮੋਰੀ-ਪ੍ਰਬੰਧ: 4.

# for this test you need set a path to libc (puts)
>> libname := ਪ੍ਰੋਗਰਾਮ ਸੈਟਿੰਗ: ['FFITESTLIB'].



Server ਲਿੰਕ: (
 ਲਿਸਟ ਨਵਾਂ ;
 libname ;
 ['puts'] ;
 ( ਲਿਸਟ ਨਵਾਂ ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s ਮੁਕਤ.

# test with struct

>> a := Blob ਨਵਾਂ: 8.
a bytes: (
	ਲਿਸਟ <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (ਲਿਸਟ <<: ['int'], ; ['int']).

Server ਲਿੰਕ: (
	ਲਿਸਟ <<: ['@structtest'], ;
	['@structtest'] ;
	(ਲਿਸਟ <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
ਆਉਟਪੁੱਟ ਲਿਖੋ: ['Sum test:'] + (ffitest ffisum: a), ਨਵੀਂ-ਲਾਈਨ.

struct struct-ਮੁਕਤ.
struct ਮੁਕਤ.
a ਮੁਕਤ.
