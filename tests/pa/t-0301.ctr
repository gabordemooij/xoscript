


>> wine := ਵਸਤੂ ਨਵਾਂ.


wine ਜਦੋਂ: ['toString'] ਕਰੋ: { <- ['merlot'].
}.

wine ਜਦੋਂ: ['naarTekst'] ਕਰੋ: { <- ['merlot'].
}.


wine ਜਦੋਂ: ['='] ਕਰੋ: { :other wine <- ( ਆਪ toString = other wine ).
}.

wine ਜਦੋਂ: ['=='] ਕਰੋ: { :other wine <- ( ਆਪ toString = other wine ).
}.



wine
	ਹਾਲਤ: ['cabernet'] ਕਰੋ: { ਆਉਟਪੁੱਟ ਲਿਖੋ: ['it's a Cabernet!']. },
	ਹਾਲਤ: ['syrah']    ਕਰੋ: { ਆਉਟਪੁੱਟ ਲਿਖੋ: ['it's a Syrah!'].    },
	ਹਾਲਤ: ['merlot']   ਕਰੋ: { ਆਉਟਪੁੱਟ ਲਿਖੋ: ['it's a Merlot!'].   },
	ਹਾਲਤ: ['malbec']   ਕਰੋ: { ਆਉਟਪੁੱਟ ਲਿਖੋ: ['it's a Malbec!'].   }.

ਆਉਟਪੁੱਟ ਨਵੀਂ-ਲਾਈਨ.
