>> echo := ਵਸਤੂ ਨਵਾਂ.
echo ਜਦੋਂ: ['ਜਵਾਬ:'] ਕਰੋ: { :sound
	{ ਆਉਟਪੁੱਟ ਲਿਖੋ: sound. } × 2.
}.
echo ho!. 


echo := ਵਸਤੂ ਨਵਾਂ.
echo ਜਦੋਂ: ['ਜਵਾਬ:ਅਤੇ:'] ਕਰੋ: { :sound :x
	{ ਆਉਟਪੁੱਟ ਲਿਖੋ: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := ਵਸਤੂ ਨਵਾਂ.
echo ਜਦੋਂ: ['ਜਵਾਬ:ਅਤੇ:ਅਤੇ:'] ਕਰੋ: { :operation :sound :x
	{ ਆਉਟਪੁੱਟ ਲਿਖੋ: sound. } × x.
}.
echo shout: ['la'] times: 4. 


