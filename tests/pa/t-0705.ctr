

>> obj := ਵਸਤੂ ਨਵਾਂ.

obj ਜਦੋਂ: ['greet'] ਕਰੋ: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj ਜਦੋਂ: ['task'] ਕਰੋ: {
	ਆਪਣਾ property := 123.
	{
		# try binds self/own to object instead of block
		ਆਉਟਪੁੱਟ ਲਿਖੋ: ਆਪ greet.
		ਆਉਟਪੁੱਟ ਲਿਖੋ: ਆਪਣਾ property.
		1 / 0.
	} ਫੜੋ: {
		ਆਉਟਪੁੱਟ ਲਿਖੋ: ਆਪ greet.
		ਆਉਟਪੁੱਟ ਲਿਖੋ: ਆਪਣਾ property.
		ਆਉਟਪੁੱਟ ਲਿਖੋ: ['ok'].
	}, ਕੋਸ਼ਿਸ਼.
}.

obj task.