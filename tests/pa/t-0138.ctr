

ਪ੍ਰੋਗਰਾਮ ਮੈਮੋਰੀ-ਪ੍ਰਬੰਧ: 1.

>> x := 0.
>> y := ['Hello'].
>> q := { ['']. }.
>> p := ਸੱਚ.
>> a := ਲਿਸਟ ← 1 ; 2 ; 3 ; 4.
>> c := ਵਸਤੂ ਨਵਾਂ.
c ਜਦੋਂ: ['greet:'] ਕਰੋ: { ਆਉਟਪੁੱਟ ਲਿਖੋ: ['greet!']. }.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.
>> usedMemory5 := 0.

ਪ੍ਰੋਗਰਾਮ ਸਫਾਈ.
>> usedMemory1 := (ਪ੍ਰੋਗਰਾਮ ਮੈਮੋਰੀ ? 0).




x := 1.
y := ['Hello'].
q := { ['']. }.
p := ਸੱਚ.
