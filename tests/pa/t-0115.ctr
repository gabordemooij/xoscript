{
	ਇਹ-ਕੰਮ ਗਲਤੀ: ['Dont fail.'].
	unknown doSomething.
} ਫੜੋ: {
	ਆਉਟਪੁੱਟ ਲਿਖੋ: ['Caught!'].
}, ਚਲਾਓ.

{
	ਇਹ-ਕੰਮ ਗਲਤੀ: ['Dont fail.'].
	ਆਪਣਾ unknown doSomething.
} ਫੜੋ: {
	ਆਉਟਪੁੱਟ ਲਿਖੋ: ['Caught!'].
}, ਚਲਾਓ.

{
	ਇਹ-ਕੰਮ ਗਲਤੀ: ['Dont fail.'].
	unknown := 122.
} ਫੜੋ: {
	ਆਉਟਪੁੱਟ ਲਿਖੋ: ['Caught!'].
}, ਚਲਾਓ.


{
	ਇਹ-ਕੰਮ ਗਲਤੀ: ['Dont fail.'].
	ਸੱਚ ਰੋਕੋ.
	ਆਉਟਪੁੱਟ ਲਿਖੋ: ['FAIL'].
} ਫੜੋ: {
	ਆਉਟਪੁੱਟ ਲਿਖੋ: ['Caught!'].
}, ਚਲਾਓ.

{
	{
		ਇਹ-ਕੰਮ ਗਲਤੀ: ['Dont fail.'].
		ਸੱਚ ਰੋਕੋ.
		ਆਉਟਪੁੱਟ ਲਿਖੋ: ['FAIL'].
	} ਫੜੋ: { :x
		(x = ['Dont fail.']) ਸੱਚ-ਹੋਵੇ-ਤਾਂ: { ਇਹ-ਕੰਮ ਗਲਤੀ: ['Nested Caught!']. }.
	}, ਚਲਾਓ.
} ਫੜੋ: { :e
	ਆਉਟਪੁੱਟ ਲਿਖੋ: e.
}, ਚਲਾਓ.
