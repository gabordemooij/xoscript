

>> g := Server ਨਵਾਂ.
>> v := ਤਿਜੋਰੀ ਨਵਾਂ.
>> ok := 0.

>> secrets := ਲਿਸਟ ਨਵਾਂ ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> passwords := secrets ਨਕਲ.
passwords ਹਰੇਕ: { :i :p
	secrets ਹਰੇਕ: { :n :s
		{
			>> encrypted := v ਇਨਕ੍ਰਿਪਟ: s ਕੁੰਜੀ: p.
			>> decrypted := v ਡੀਕ੍ਰਿਪਟ: encrypted ਕੁੰਜੀ: p.
			(decrypted = s) ਸੱਚ-ਹੋਵੇ-ਤਾਂ: {
				ok ਜਮ੍ਹਾਂ: 1.
			}, ਨਹੀਂ-ਤਾਂ: {
				ਆਉਟਪੁੱਟ ਲਿਖੋ: ['failed encrypting/decrypting: '], ਨਵੀਂ-ਲਾਈਨ.
				ਆਉਟਪੁੱਟ ਲਿਖੋ: s, ਨਵੀਂ-ਲਾਈਨ.
				ਆਉਟਪੁੱਟ ਲਿਖੋ: ['encrypted: '] + encrypted, ਨਵੀਂ-ਲਾਈਨ.
				ਆਉਟਪੁੱਟ ਲਿਖੋ: ['decrypted: '] + encrypted, ਨਵੀਂ-ਲਾਈਨ.
				ਪ੍ਰੋਗਰਾਮ ਸਮਾਪਤ.
			}.
		} ਫੜੋ: { :err
			(s = [''] ਜਾਂ: p = ['']) ਸੱਚ-ਹੋਵੇ-ਤਾਂ: {
				ok ਜਮ੍ਹਾਂ: 1.
			}, ਨਹੀਂ-ਤਾਂ: {
				ਆਉਟਪੁੱਟ ਲਿਖੋ: err, ਨਵੀਂ-ਲਾਈਨ.
				ਪ੍ਰੋਗਰਾਮ ਸਮਾਪਤ.
			}.
		}, ਚਲਾਓ.
	}.
}.

ਆਉਟਪੁੱਟ ਲਿਖੋ: ( ok + [' vault encryptions tested.'] ), ਨਵੀਂ-ਲਾਈਨ.