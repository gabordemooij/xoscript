#OBSD
>> dirname := [''].
{ dirname ਅੰਤ-ਵਿੱਚ-ਜੋੜੋ: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
ਪ੍ਰੋਗਰਾਮ ਸਿਸਟਮ: command.
ਪ੍ਰੋਗਰਾਮ chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename ਅੰਤ-ਵਿੱਚ-ਜੋੜੋ: ['YYYYYYYY']. } * 20.
ਫਾਈਲ ਨਵਾਂ: filename, ਲਿਖੋ: ['sometext'].
{ ਫਾਈਲ ਸੂਚੀ: ['/tmp/'] + dirname. } * 1000.
ਆਉਟਪੁੱਟ ਲਿਖੋ: ['no crash'], ਨਵੀਂ-ਲਾਈਨ.

