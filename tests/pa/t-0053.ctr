60 × {
	>> x := (ਸੰਖਿਆ random % 6) + 1.
	(x ≤ 6) ਝੂਠ-ਹੋਵੇ-ਤਾਂ: { ਆਉਟਪੁੱਟ ਲਿਖੋ: ['FAIL']. }.
	(x ≥0) ਝੂਠ-ਹੋਵੇ-ਤਾਂ: { ਆਉਟਪੁੱਟ ਲਿਖੋ: ['FAIL']. }.
	x := (ਸੰਖਿਆ random % 3) + 1.
	(x < 3) ਝੂਠ-ਹੋਵੇ-ਤਾਂ: { ਆਉਟਪੁੱਟ ਲਿਖੋ: ['FAIL']. }.
	(x>-1) ਝੂਠ-ਹੋਵੇ-ਤਾਂ: { ਆਉਟਪੁੱਟ ਲਿਖੋ: ['FAIL']. }.
	x := ((ਬੂਲੀਅਨ flip) ਸੰਖਿਆ-ਵਿੱਚ).
	(x = 0 ਜਾਂ: x = 1) ਝੂਠ-ਹੋਵੇ-ਤਾਂ: { ਆਉਟਪੁੱਟ ਲਿਖੋ: ['FAIL']. }.
	x := ((ਸੱਚ flip) ਸੰਖਿਆ-ਵਿੱਚ).
	(x = 0 ਜਾਂ: x = 1) ਝੂਠ-ਹੋਵੇ-ਤਾਂ: { ਆਉਟਪੁੱਟ ਲਿਖੋ: ['FAIL']. }.
	x := (ਬੂਲੀਅਨ flip ਇਹ: ['HEAD'] ਜਾਂ-ਉਹ: ['TAIL']).
	((x = ['HEAD']) ਜਾਂ: (x = ['TAIL'])) ਝੂਠ-ਹੋਵੇ-ਤਾਂ: { ਆਉਟਪੁੱਟ ਲਿਖੋ: ['FAIL']. }.
}.
ਆਉਟਪੁੱਟ ਲਿਖੋ: ['DONE'].

