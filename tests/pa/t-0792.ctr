Server init.

>> DB := Maria-DB ਨਵਾਂ ਹੋਸਟ: ['localhost'],
	ਵਰਤੋਂਕਾਰ-ਨਾਮ: ['xo'],
	ਪਾਸਵਰਡ: ['pass123'],
	ਡਾਟਾਬੇਸ-ਨਾਮ: ['xobase'],
	ਜੁੜੋ.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB ਕਿਊਰੀ: SQL.

# now you don't have to set DB
query2 ਲਿਆਓ: { :row
	ਆਉਟਪੁੱਟ ਲਿਖੋ: row world, ਨਵੀਂ-ਲਾਈਨ.
}.
