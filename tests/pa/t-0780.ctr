Server init.

# JSON encoder only supports UTF-8, no surrogate pairs

>> dicts := ਲਿਸਟ ਨਵਾਂ ;
	# {"key":"normal"} normal ASCII
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['normal'] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"hello world"} space character
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['hello world'] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"quote: \""} double quote
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['"'] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"backslash: \\"} backslash
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['backslash: \\'] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"slash: /"} slash
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['slash: /'] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['backspace: \b'] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"formfeed: \f"} form-feed escape
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['formfeed: \f'] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"newline: \n"} newline
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['newline: \n'] ਕੁੰਜੀ: ['key'] ) ;
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['newline: ↵'] ਕੁੰਜੀ: ['key'] ) ;
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['newline: 
	'] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"carriage return: \r"} carriage-return
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['carriage return: \r'] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"tab: \t"} tab
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['tab \t'] ਕੁੰਜੀ: ['key'] ) ;
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['tab ⇿'] ਕੁੰਜੀ: ['key'] ) ;
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['tab  '] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['NUL \u0000'] ਕੁੰਜੀ: ['key'] ) ;
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['NUL \0'] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"control: \u0001"} control character 0x01
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['control: \u0001'] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"control: \u001F"} control character 0x1F
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['control: \u001F'] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-byte char
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['unicode: é'] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-byte char
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['unicode: €'] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"unicode: 日本語"} multiple 3-byte UTF-8 chars
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['unicode: 日本語'] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-byte char
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['unicode: 😀'] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['unicode: 🧑‍💻'] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"combining: e\u0301"} combining accent
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['combining: e\u0301'] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"escaped unicode: \u00e9"} Unicode escape BMP
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['escaped unicode: \u00e9'] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"escaped unicode: \u20ac"} Unicode escape BMP
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['escaped unicode: \u20ac'] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"escaped unicode: \ud83d\ude00"} UTF-16 surrogate pair
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['escaped unicode: \ud83d\ude00'] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":""} empty value
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: [''] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} special ASCII chars
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['@ < > & = % + ? #'] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"single quote: '"} single quote
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['''] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} multiple JSON escapes
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['multiple: \" \\ \n \r \t'] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} longer ASCII-string
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":" value"} leading space
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: [' value'] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":"value "} trailing space
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['value '] ਕੁੰਜੀ: ['key'] ) ;
	# {"key":" \t\n\r "} whitespace
	( ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: [' \t\n\r '] ਕੁੰਜੀ: ['key'] ).

dicts ਹਰੇਕ: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: d key ਕੁੰਜੀ: ['key']).
	>> b := JSON jsonify: (ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ ਰੱਖੋ: ['value'] ਕੁੰਜੀ: d key).
	>> e := JSON ਵਸਤੂ: a.
	>> f := JSON ਵਸਤੂ: b.
	((e key = d key ਅਤੇ: (f ? d key = ['value'])) ਜਾਂ: (e key = ['NUL ?'])) ਸੱਚ-ਹੋਵੇ-ਤਾਂ: {
		ਆਉਟਪੁੱਟ ਲਿਖੋ: ['OK'], ਨਵੀਂ-ਲਾਈਨ.
	}, ਨਹੀਂ-ਤਾਂ: {
		ਆਉਟਪੁੱਟ ਲਿਖੋ: ['Unable to properly encode/decode: '] + d + j, ਨਵੀਂ-ਲਾਈਨ.
		ਪ੍ਰੋਗਰਾਮ ਸਮਾਪਤ.
	}.
}.
