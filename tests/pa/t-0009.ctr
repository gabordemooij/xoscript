>> Greeter := ਵਸਤੂ ਨਵਾਂ.
Greeter ਜਦੋਂ: ['make'] ਕਰੋ: {
	>> greeter := ਵਸਤੂ ਨਵਾਂ.
	greeter ਜਦੋਂ: ['name:'] ਕਰੋ: { :ਨਾਮ
		ਆਉਟਪੁੱਟ ਲਿਖੋ: ['setting a name'].
		ਆਪਣਾ myName := ਨਾਮ.
	}.
	greeter ਜਦੋਂ: ['performGreeting'] ਕਰੋ: {
		ਆਉਟਪੁੱਟ ਲਿਖੋ: ['Hello'].
		ਆਉਟਪੁੱਟ ਲਿਖੋ: ਆਪਣਾ myName.
	}.
	greeter ਜਦੋਂ: ['greet'] ਕਰੋ: {
		ਆਪ performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
