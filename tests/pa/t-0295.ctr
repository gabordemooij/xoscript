
>> dictionary := (
	ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ
		ਰੱਖੋ: ['b'] ਕੁੰਜੀ: ['a'],
		ਰੱਖੋ: ['a'] ਕੁੰਜੀ: ['b'],
		ਰੱਖੋ: ['z'] ਕੁੰਜੀ: ['x'],
		ਰੱਖੋ: ['hello'] ਕੁੰਜੀ: ['hallo'],
		ਰੱਖੋ: ['human'] ਕੁੰਜੀ: ['human']
).

>> comparisons := ਲਿਸਟ ਨਵਾਂ.
dictionary ਹਰੇਕ: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a ਤੁਲਨਾ: b)
	).
}.

comparisons ਤਰਤੀਬ: { :a :b <- ( a ਤੁਲਨਾ: b ). }.
ਆਉਟਪੁੱਟ ਲਿਖੋ: ( comparisons ਜੋੜੋ: ['↵'] ), ਨਵੀਂ-ਲਾਈਨ.
comparisons ਜੋੜੋ: ['↵'].
