>> phrases := ਲਿਸਟ ਨਵਾਂ
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases ਹਰੇਕ: { :_ :phrase 
	>> e := Server base64-ਇਨਕੋਡ: phrase.
	>> d := Server base64-ਡੀਕੋਡ: e.
	ਆਉਟਪੁੱਟ ਲਿਖੋ: (
		message ਨਕਲ ~encoded: e, ~decoded: d
	), ਨਵੀਂ-ਲਾਈਨ.
}.
