>> makeAdder := { :x
	>> f := { :y <- (ਆਪਣਾ x + y). } ਨਿਯਤ: ['x'] ਮੁੱਲ: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i ਆਪਣਾ q ਰੱਖੋ: (ਆਪਣਾ f ਲਾਗੂ: (ਆਪਣਾ q ? i)) ਕੁੰਜੀ: i. } 
	ਨਿਯਤ: ['q'] ਮੁੱਲ: array,
	ਨਿਯਤ: ['f'] ਮੁੱਲ: func.
	{ :i mapping ਲਾਗੂ: i. } × (array ਗਿਣਤੀ).
}.

>> a := ਲਿਸਟ ← 1; 2; 3.
mapper ਲਾਗੂ: a ਅਤੇ: (makeAdder ਲਾਗੂ: 100).
ਆਉਟਪੁੱਟ ਲਿਖੋ: (a ਥਾਂ: 0), ਨਵੀਂ-ਲਾਈਨ.
ਆਉਟਪੁੱਟ ਲਿਖੋ: (a ? 1), ਨਵੀਂ-ਲਾਈਨ.
ਆਉਟਪੁੱਟ ਲਿਖੋ: (a ? 2), ਨਵੀਂ-ਲਾਈਨ.
