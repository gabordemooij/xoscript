>> Greeter := ਵਸਤੂ ਨਵਾਂ.
Greeter ਜਦੋਂ: ['make'] ਕਰੋ: {
	>> gr := ਵਸਤੂ ਨਵਾਂ.
	gr ਜਦੋਂ: ['setName:'] ਕਰੋ: { :aname
		ਆਪਣਾ ਨਾਮ := aname.
	}.
	gr ਜਦੋਂ: ['greet'] ਕਰੋ: {
		ਆਉਟਪੁੱਟ ਲਿਖੋ: ਆਪਣਾ ਨਾਮ.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a ਨਵਾਂ.
c setName: ['THREE'].
c greet.
>> d := a ਨਵਾਂ.
d setName: ['FOUR'].
d greet.
c greet.
