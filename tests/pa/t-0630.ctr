#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := ਪੈਟਰਨ ਨਵਾਂ: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern ਮੇਲ: subject ਕਰੋ: { :m :x
	ਆਉਟਪੁੱਟ ਲਿਖੋ: m, ਨਵੀਂ-ਲਾਈਨ.
	ਆਉਟਪੁੱਟ ਲਿਖੋ: x, ਨਵੀਂ-ਲਾਈਨ. <- ['XXX'].
}.
ਆਉਟਪੁੱਟ ਲਿਖੋ: result, ਨਵੀਂ-ਲਾਈਨ.