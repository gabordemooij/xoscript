


>> CoffeeMachine := ਵਸਤੂ ਨਵਾਂ.
CoffeeMachine ਜਦੋਂ: ['order:'] ਕਰੋ: { :id
	>> coffee := ['Americano'].
	( id = 1 ) ਸੱਚ-ਹੋਵੇ-ਤਾਂ: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) ਸੱਚ-ਹੋਵੇ-ਤਾਂ: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) ਸੱਚ-ਹੋਵੇ-ਤਾਂ: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := ਵਸਤੂ ਨਵਾਂ.
SimpleCoffeeMachine ਜਦੋਂ: ['order'] ਕਰੋ: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
ਆਉਟਪੁੱਟ ਲਿਖੋ: redCup, ਨਵੀਂ-ਲਾਈਨ.
redCup := ['Tea']. 
