# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> ਫਾਈਲ-ਰਾਹ := ['/tmp/dat.csv'].
>> csv := ਫਾਈਲ ਨਵਾਂ: ਫਾਈਲ-ਰਾਹ.
csv ਲਿਖੋ: s.

# accepts CRLF LF CR, varying row length
csv ਵੰਡਕ: [';'] ਹਵਾਲਾ-ਚਿੰਨ੍ਹ: ['"'] ਲਾਈਨਾਂ: { :line
	ਪ੍ਰੋਗਰਾਮ ਸਫਾਈ.
	ਆਉਟਪੁੱਟ ਲਿਖੋ: line, ਨਵੀਂ-ਲਾਈਨ.
	ਪ੍ਰੋਗਰਾਮ ਸਫਾਈ.
}.

# unequal lines
s ਅੰਤ-ਵਿੱਚ-ਜੋੜੋ: ['\njustone'].
csv ਲਿਖੋ: s.
{
	csv ਵੰਡਕ: [';'] ਹਵਾਲਾ-ਚਿੰਨ੍ਹ: ['"'] ਲਾਈਨਾਂ: { :line
		ਆਉਟਪੁੱਟ ਲਿਖੋ: line, ਨਵੀਂ-ਲਾਈਨ.
	}.
} ਫੜੋ: { :e 
	ਆਉਟਪੁੱਟ ਲਿਖੋ: e, ਨਵੀਂ-ਲਾਈਨ.
}, ਚਲਾਓ.

# invalid format
s := ['"he"llo";world'].
csv ਲਿਖੋ: s.
{
	csv ਵੰਡਕ: [';'] ਹਵਾਲਾ-ਚਿੰਨ੍ਹ: ['"'] ਲਾਈਨਾਂ: { :line
		ਆਉਟਪੁੱਟ ਲਿਖੋ: line, ਨਵੀਂ-ਲਾਈਨ.
	}.
} ਫੜੋ: { :e 
	ਆਉਟਪੁੱਟ ਲਿਖੋ: e, ਨਵੀਂ-ਲਾਈਨ.
}, ਚਲਾਓ.
