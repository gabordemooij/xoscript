Server init.

>> DB := Maria-DB ਨਵਾਂ ਹੋਸਟ: ['localhost'],
	ਵਰਤੋਂਕਾਰ-ਨਾਮ: ['xo'],
	ਪਾਸਵਰਡ: ['pass123'],
	ਡਾਟਾਬੇਸ-ਨਾਮ: ['xobase'],
	ਜੁੜੋ.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> ਖੋਜ-ਪੈਰਾਮੀਟਰ := Maria-ਕਿਊਰੀ ਨਵਾਂ: SQL.

# set database
ਖੋਜ-ਪੈਰਾਮੀਟਰ ਡਾਟਾਬੇਸ: DB.

ਖੋਜ-ਪੈਰਾਮੀਟਰ ਲਿਆਓ: { :row
	ਆਉਟਪੁੱਟ ਲਿਖੋ: row world, ਨਵੀਂ-ਲਾਈਨ.
}.
