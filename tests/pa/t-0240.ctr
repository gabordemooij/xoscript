# test qualifiers

>> $ := ਵਸਤੂ ਨਵਾਂ.

$ ਜਦੋਂ: ['ਜਵਾਬ:'] ਕਰੋ: { :x
	
	>> operation := x ਅੱਖਰ: 0.
	>> valuta := x ਅੱਖਰ: 1.
	>> money := x ਛੱਡੋ: 2.
	
	>> amount := 0.

	( operation = ['+'] ) ਸੱਚ-ਹੋਵੇ-ਤਾਂ: {
		( valuta = ['£'] ) ਸੱਚ-ਹੋਵੇ-ਤਾਂ: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

ਆਉਟਪੁੱਟ ਲਿਖੋ: x, ਨਵੀਂ-ਲਾਈਨ.


>> Fruit := ਵਸਤੂ ਨਵਾਂ.

Fruit ਜਦੋਂ: ['ਨਵਾਂ'] ਕਰੋ: {
	>> f := ਆਪ ਨਵਾਂ.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit ਜਦੋਂ: ['apples:'] ਕਰੋ: { :a ਆਪਣਾ apples := a. }.
Fruit ਜਦੋਂ: ['oranges:'] ਕਰੋ: { :p ਆਪਣਾ oranges := p. }.
Fruit ਜਦੋਂ: ['apples'] ਕਰੋ: { <- ਆਪਣਾ apples. }.
Fruit ਜਦੋਂ: ['oranges'] ਕਰੋ: { <- ਆਪਣਾ oranges. }.

Fruit ਜਦੋਂ: ['+'] ਕਰੋ: { :f
	
	>> n := Fruit ਨਵਾਂ.
	f ਜਮ੍ਹਾਂ: 1.
	
	n apples: (f apples + ਆਪਣਾ apples).
	n oranges:  (f oranges  + ਆਪਣਾ oranges). <- n.
}.

Fruit ਜਦੋਂ: ['ਲਿਖਤ-ਵਿੱਚ'] ਕਰੋ: { <- ( ਆਪਣਾ apples ਲਿਖਤ-ਵਿੱਚ + [' apples and '] + ਆਪਣਾ oranges + [' oranges'] ).
}.

ਸੰਖਿਆ ਜਦੋਂ: ['apples'] ਕਰੋ: { <- ((Fruit ਨਵਾਂ) apples: ਆਪ).
}.

ਸੰਖਿਆ ਜਦੋਂ: ['apple'] ਕਰੋ: { <- ((Fruit ਨਵਾਂ) apples: ਆਪ).
}.

ਸੰਖਿਆ ਜਦੋਂ: ['oranges'] ਕਰੋ: { <- ((Fruit ਨਵਾਂ) oranges: ਆਪ).
}.




ਆਉਟਪੁੱਟ ਲਿਖੋ: (1 apple + 3 oranges + 4 apples), ਨਵੀਂ-ਲਾਈਨ.


ਲਿਖਤ ਜਦੋਂ: ['twice'] ਕਰੋ: { <- ((ਆਪ ਲਿਖਤ-ਵਿੱਚ) + (ਆਪ ਲਿਖਤ-ਵਿੱਚ)).
}.



ਆਉਟਪੁੱਟ ਲਿਖੋ: ['❤❤❤'] twice.



