>> randomizer := { :a :b
	>> ਘੱਟੋ-ਘੱਟ := ( a < b ) ਇਹ: a ਜਾਂ-ਉਹ: b.
	>> ਵੱਧ-ਤੋਂ-ਵੱਧ := ( a > b ) ਇਹ: a ਜਾਂ-ਉਹ: b.
	>> x := ਖਾਲੀ.
	{
		x := ਸੰਖਿਆ ਵਿਚਕਾਰ: a ਅਤੇ: b.
		((x < ਘੱਟੋ-ਘੱਟ) ਜਾਂ: (x > ਵੱਧ-ਤੋਂ-ਵੱਧ)) ਸੱਚ-ਹੋਵੇ-ਤਾਂ: { 
			ਆਉਟਪੁੱਟ ਲਿਖੋ: (['Invalid value!']).
			ਪ੍ਰੋਗਰਾਮ ਸਮਾਪਤ.
		}.
	} 
	× 100. <- x.
}.
