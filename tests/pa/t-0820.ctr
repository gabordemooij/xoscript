# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := ਪੈਟਰਨ ਨਵਾਂ: pattern.
	p ਮੇਲ: subject ਕਰੋ: { :m :g
		ਆਉਟਪੁੱਟ ਲਿਖੋ: g ਗਿਣਤੀ, ਲਿਖੋ: [' '], ਲਿਖੋ: (g ਜੋੜੋ: ['|']), ਨਵੀਂ-ਲਾਈਨ. <- m.
	}.
}.
show ਲਾਗੂ: ['(a)|(b)'] ਅਤੇ: ['b'].
show ਲਾਗੂ: ['(a)|(b)'] ਅਤੇ: ['a'].
show ਲਾਗੂ: ['(x)?y'] ਅਤੇ: ['y'].
show ਲਾਗੂ: ['(x)?(y)(z)?'] ਅਤੇ: ['xy'].
