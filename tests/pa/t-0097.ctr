
ਲਿਖਤ ਜਦੋਂ: ['html'] ਕਰੋ: { <- (
		ਆਪ
		ਬਦਲੋ: ['&'] ਨਾਲ: ['&amp;'],
		ਬਦਲੋ: ['<'] ਨਾਲ: ['&lt;'],
		ਬਦਲੋ: ['>'] ਨਾਲ: ['&gt;'],
		ਬਦਲੋ: ['"'] ਨਾਲ: ['&quot;']
	).
}.

>> HtmlBrush := ਵਸਤੂ ਨਵਾਂ.

HtmlBrush ਜਦੋਂ: ['ਜਵਾਬ:'] ਕਰੋ: { :tag
	ਆਉਟਪੁੱਟ ਲਿਖੋ: (['<tag>↵'] tag: tag ).
}.

HtmlBrush ਜਦੋਂ: ['ਜਵਾਬ:ਅਤੇ:'] ਕਰੋ: { :tag :content
	tag := ( tag ਸ਼ੁਰੂ: 0 ਲੰਬਾਈ: (tag ਲੰਬਾਈ - 1) ).
	ਆਉਟਪੁੱਟ ਲਿਖੋ: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush ਜਦੋਂ: ['content:'] ਕਰੋ: { :text
	ਆਉਟਪੁੱਟ ਲਿਖੋ: text html, ਨਵੀਂ-ਲਾਈਨ.
}.

HtmlBrush ਜਦੋਂ: ['attr:value:'] ਕਰੋ: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush ਨਵਾਂ.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
