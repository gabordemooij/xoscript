>> Animal := ਵਸਤੂ ਨਵਾਂ.
Animal ਜਦੋਂ: ['make'] ਕਰੋ: {
	>> animal := ਵਸਤੂ ਨਵਾਂ.
	animal ਜਦੋਂ: ['makeSound'] ਕਰੋ: {
		ਆਉਟਪੁੱਟ ਲਿਖੋ: ਆਪਣਾ sound.
	}. <- animal.
}.
>> Cat := ਵਸਤੂ ਨਵਾਂ.
Cat ਜਦੋਂ: ['make'] ਕਰੋ: {
	>> cat := Animal make.
	cat ਜਦੋਂ: ['init'] ਕਰੋ: {
		ਆਪਣਾ sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
