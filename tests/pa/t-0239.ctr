ਲਿਸਟ ਜਦੋਂ: ['sum'] ਕਰੋ: {
	>> total := 0.
	ਆਪ ਹਰੇਕ: { :index :element
		total ਜਮ੍ਹਾਂ: element.
	}. <- total.
}.

>> a := ਸੱਚ.



a ਜਦੋਂ: ['ਲਿਖਤ-ਵਿੱਚ'] ਕਰੋ: {
	>> answer := ਖਾਲੀ.
	( ਆਪ = ਸੱਚ ) ਸੱਚ-ਹੋਵੇ-ਤਾਂ: {
		answer := ['Yep'].
	}, ਨਹੀਂ-ਤਾਂ: {
		answer := ['Nope'].
	}. <- answer.
}.

a ਜਦੋਂ: ['ਸੰਖਿਆ-ਵਿੱਚ'] ਕਰੋ: {
	>> answer := ਖਾਲੀ.
	( ਆਪ = ਸੱਚ ) ਸੱਚ-ਹੋਵੇ-ਤਾਂ: {
		answer := 10.
	}, ਨਹੀਂ-ਤਾਂ: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b ਜਦੋਂ: ['ਲਿਖਤ-ਵਿੱਚ'] ਕਰੋ: { <- ['Devil'].
}.

b ਜਦੋਂ: ['ਬੂਲੀਅਨ-ਵਿੱਚ'] ਕਰੋ: { <- ਝੂਠ.
}.


ਆਉਟਪੁੱਟ ਲਿਖੋ: a, ਨਵੀਂ-ਲਾਈਨ.  
ਆਉਟਪੁੱਟ ਲਿਖੋ: (90 + a), ਨਵੀਂ-ਲਾਈਨ. 
ਆਉਟਪੁੱਟ ਲਿਖੋ: b, ਨਵੀਂ-ਲਾਈਨ. 
ਆਉਟਪੁੱਟ ਲਿਖੋ: (ਸੱਚ ਅਤੇ: b), ਨਵੀਂ-ਲਾਈਨ.

a := ਲਿਸਟ ← ['hello'] ; ['world'] ; ਸੱਚ ; ਖਾਲੀ ; 666. 
a := a + ( ਲਿਸਟ ← 1 ).
ਆਉਟਪੁੱਟ ਲਿਖੋ: a, ਨਵੀਂ-ਲਾਈਨ.
ਆਉਟਪੁੱਟ ਲਿਖੋ: ((ਸ਼ਬਦਕੋਸ਼ ਨਵਾਂ) ਰੱਖੋ: ਖਾਲੀ ਕੁੰਜੀ: ਖਾਲੀ), ਨਵੀਂ-ਲਾਈਨ.
ਆਉਟਪੁੱਟ ਲਿਖੋ: a sum, ਨਵੀਂ-ਲਾਈਨ. 


{
	a ਜਦੋਂ: ['ਲਿਖਤ-ਵਿੱਚ'] ਕਰੋ: { <- ਖਾਲੀ. }.
	a := [''] + a.
} ਫੜੋ: { :error
	ਆਉਟਪੁੱਟ ਲਿਖੋ: ['Error noted: '] + error, ਨਵੀਂ-ਲਾਈਨ.
}, ਚਲਾਓ.



{
	a ਜਦੋਂ: ['ਸੰਖਿਆ-ਵਿੱਚ'] ਕਰੋ: { <- ਖਾਲੀ. }.
	a := 3 × a.
} ਫੜੋ: { :error
	ਆਉਟਪੁੱਟ ਲਿਖੋ: ['Error noted: '] + error, ਨਵੀਂ-ਲਾਈਨ.
}, ਚਲਾਓ.


