

>> Matryoshka := ਵਸਤੂ ਨਵਾਂ.
Matryoshka ਜਦੋਂ: ['double:'] ਕਰੋ: { :secret
	ਆਪਣਾ secret := secret × 2.
}.
Matryoshka ਜਦੋਂ: ['ਨਵਾਂ:'] ਕਰੋ: { :secret
	>> answer := ਖਾਲੀ.
	>> t := (secret > 255).
	ਆਉਟਪੁੱਟ ਲਿਖੋ: (secret + [' | '] + t), ਨਵੀਂ-ਲਾਈਨ.
	t ਸੱਚ-ਹੋਵੇ-ਤਾਂ: {
		answer := secret.
	}, ਨਹੀਂ-ਤਾਂ: {
		answer := Matryoshka ਦੁਹਰਾਊ ਨਵਾਂ: (ਆਪ double: secret).
	}. <- answer.
}.

>> x := Matryoshka ਨਵਾਂ: 2.
