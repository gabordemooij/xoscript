
>> g := ['global'].
{ >> g := ['local']. ਆਉਟਪੁੱਟ ਲਿਖੋ: g, ਨਵੀਂ-ਲਾਈਨ. } ਚਲਾਓ. 
ਆਉਟਪੁੱਟ ਲਿਖੋ: g, ਨਵੀਂ-ਲਾਈਨ. 
>> message := ['Bye'].
>> Secret := ਵਸਤੂ ਨਵਾਂ.
Secret ਜਦੋਂ: ['ਪਰਖ'] ਕਰੋ: {
	>> message := ['Hello'].
	ਆਪਣਾ message := ['World'].
	ਆਉਟਪੁੱਟ ਲਿਖੋ: message + [' '] + ਆਪਣਾ message, ਨਵੀਂ-ਲਾਈਨ.
}.
Secret ਪਰਖ.
ਆਉਟਪੁੱਟ ਲਿਖੋ: message.
