# Alarm instel

# beëindig die program na 1 sek.
Program alarm: 1.

Uitvoer skryf: ['maks 1 sek.'], nuwe-reël.
Oomblik wag: 2.
Uitvoer skryf: ['duur te lank.'], nuwe-reël.

# let wel:
# Om 'n alarm in te stel is onomkeerbaar,
# 'n aanvaller kan dit nie afskakel nie.
# Ná die eerste oproep is die alarm gesluit.
# Die alarm is ook baie streng,
# die program *SAL* gestop word na die
# gespesifiseerde tydsinterval, selfs as dit
# in 'n blokkerende leesbewerking of so iets is.

# let wel:
# Alarm is swaar; oorweeg eerder basiese
# tydsbeperkings in die webbediener.



