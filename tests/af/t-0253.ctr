#Linux
>> OS := Program instelling: ['OS'].

>> horlosie := Oomblik nuut.
	
(OS = ['Haiku']) ja: {
	horlosie sone: ['CET'],
	jaar: 2017, maand: 7, dag: 13,
	uur: 18, minuut: 0, sekonde: 0.
}, anders: {
	horlosie sone: ['Europe/Amsterdam'],
	jaar: 2017, maand: 7, dag: 13,
	uur: 18, minuut: 0, sekonde: 0.
}.

horlosie by: ['vertel'] doen: {
	Uitvoer skryf: self, nuwe-reël.
}.


horlosie tel-by: 2    uur, vertel.
horlosie tel-by: 1    uur, vertel.
horlosie tel-by: 19 minuut, vertel.
horlosie tel-by: 1  minuut, vertel.
horlosie tel-by: 1  minuut, vertel.
horlosie tel-by: 19 sekonde, vertel.
horlosie tel-by: 1  sekonde, vertel.
horlosie tel-by: 1  sekonde, vertel.
horlosie tel-by: 2    jaar, vertel.
horlosie tel-by: 1    jaar, vertel.

(OS = ['Haiku']) ja: {
horlosie tel-by: 5   maand.
horlosie sone: ['CEST'], vertel.
}, anders: {
	horlosie tel-by: 5   maand, vertel.
}.

horlosie tel-by: 1   maand, vertel.
horlosie tel-by: 19    dag, vertel.
horlosie tel-by: 1    uur, vertel.
horlosie tel-by: 120  jaart, vertel.
