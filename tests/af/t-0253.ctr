#Linux
>> OS := Program instelling: ['OS'].

>> clock := Oomblik nuut.
	
(OS = ['Haiku']) ja: {
	clock sone: ['CET'],
	jaar: 2017, maand: 7, dag: 13,
	uur: 18, minuut: 0, sekonde: 0.
}, anders: {
	clock sone: ['Europe/Amsterdam'],
	jaar: 2017, maand: 7, dag: 13,
	uur: 18, minuut: 0, sekonde: 0.
}.

clock by: ['tell'] doen: {
	Uitvoer skryf: self, nuwe-reël.
}.


clock tel-by: 2    uur, tell.
clock tel-by: 1    uur, tell.
clock tel-by: 19 minuut, tell.
clock tel-by: 1  minuut, tell.
clock tel-by: 1  minuut, tell.
clock tel-by: 19 sekonde, tell.
clock tel-by: 1  sekonde, tell.
clock tel-by: 1  sekonde, tell.
clock tel-by: 2    jaar, tell.
clock tel-by: 1    jaar, tell.

(OS = ['Haiku']) ja: {
clock tel-by: 5   maand.
clock sone: ['CEST'], tell.
}, anders: {
	clock tel-by: 5   maand, tell.
}.

clock tel-by: 1   maand, tell.
clock tel-by: 19    dag, tell.
clock tel-by: 1    uur, tell.
clock tel-by: 120  yard, tell.
