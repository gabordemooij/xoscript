


>> Deck := Lys nuut.
Deck by: ['print'] doen: {
        >> len := self tel - 1.
        { :i
                >> len2 := self tel - 1.
                Uitvoer skryf: ['len: '].
                Uitvoer skryf: len, nuwe-reël.
                Uitvoer skryf: ['len2: '].
                Uitvoer skryf: len2, nuwe-reël.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
