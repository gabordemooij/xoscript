


>> Kaartpak := Lys nuut.
Kaartpak by: ['druk'] doen: {
        >> len := self tel - 1.
        { :i
                >> lng2 := self tel - 1.
                Uitvoer skryf: ['len: '].
                Uitvoer skryf: len, nuwe-reël.
                Uitvoer skryf: ['lng2: '].
                Uitvoer skryf: lng2, nuwe-reël.
        } × len.
}.

>> d := Kaartpak ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d druk.
