['Duisende en desimale'].

>> x := 100000000.5.
>> y := 100000000.5.

Uitvoer skryf: (x + y), nuwe-reël.

>> x := 10040.07.
>> y := 10305.60.

Uitvoer skryf: (x + y), nuwe-reël.

['Desimaal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Uitvoer skryf: (x + y + z), nuwe-reël.

['Vreemd maar geldig'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Uitvoer skryf: (x + y + z), nuwe-reël.

>> q := 0.1.2.

Uitvoer skryf: (q), nuwe-reël.

>> q := 012.

Uitvoer skryf: (q), nuwe-reël.
