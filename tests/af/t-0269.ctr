#Linux

(Lêer nuut: ['/tmp/testje']) bestaan nee: {
	Program stelsel: ['mkdir /tmp/testje'].	
}.

(Lêer nuut: ['/tmp/testje/file1']) bestaan nee: {
	Program stelsel: ['touch /tmp/testje/file1'].	
}.

(Lêer nuut: ['/tmp/testje/folder1']) bestaan nee: {
	Program stelsel: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Lêer lys: ['/tmp/testje'].

>> q := Lys nuut.

l elk: { :k :v v elk: { :x :y q voeg-agter: y. }. }.

>> s := q teks.

(s bevat: ['file1']) ja:   { Uitvoer skryf: ['OK'], nuwe-reël. }.
(s bevat: ['file2']) ja:   { Uitvoer skryf: ['XX'], nuwe-reël. }.
(s bevat: ['folder1']) ja: { Uitvoer skryf: ['OK'], nuwe-reël. }.
