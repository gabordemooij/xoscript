# publieke sleutel (om API's ens. te beveilig)
Server init.

# genereer sleutels
>> sleutels := Kluis genereer-sleutels.

# privaat (geheime) sleutel
>> sk := sleutels eerste.

# publieke sleutel
>> pk := sleutels laaste.

# onderteken 'n boodskap
>> sig := Kluis onderteken: ['abc'] met: sk.

# kontroleer boodskap (ok)
Uitvoer skryf: ( 
	Kluis
		kontroleer: ['abc'] 
		handtekening: sig 
		met: pk 
), nuwe-reël.

# kontroleer boodskap (misluk)
Uitvoer skryf: ( 
	Kluis 
		kontroleer: ['abd'] 
		handtekening: sig 
		met: pk 
), nuwe-reël.