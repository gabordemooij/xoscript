# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Kluis genereer-sleutels.

# private (secret) key
>> sk := keys eerste.

# public key
>> pk := keys laaste.

# sign a message
>> sig := Kluis onderteken: ['abc'] met: sk.

# check message (ok)
Uitvoer skryf: ( 
	Kluis
		kontroleer: ['abc'] 
		handtekening: sig 
		met: pk 
), nuwe-reël.

# check message (fail)
Uitvoer skryf: ( 
	Kluis 
		kontroleer: ['abd'] 
		handtekening: sig 
		met: pk 
), nuwe-reël.