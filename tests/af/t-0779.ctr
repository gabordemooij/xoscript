Uitvoer skryf: ['Toetsobjek'], nuwe-reël.
>> p := Pad /tmp.
Uitvoer skryf: p, nuwe-reël.
>> ou-p-adres := p prototipe geheue-adres.
p save-as: ['/tmp/a.bin'].
Uitvoer skryf: ['========== HERLAAI SNAP:'], nuwe-reël.
>> b := Objek load-from: ['/tmp/a.bin'].
(b prototipe geheue-adres = ou-p-adres) ja: {
	Uitvoer skryf: ['Objekskakel weer aangeheg.'], nuwe-reël.
}.
Uitvoer skryf: b, nuwe-reël.
