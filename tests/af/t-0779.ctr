Uitvoer skryf: ['Test object'], nuwe-reël.
>> p := Pad /tmp.
Uitvoer skryf: p, nuwe-reël.
>> old-p-address := p prototipe geheue-adres.
p save-as: ['/tmp/a.bin'].
Uitvoer skryf: ['========== RELOADING SNAP:'], nuwe-reël.
>> b := Objek load-from: ['/tmp/a.bin'].
(b prototipe geheue-adres = old-p-address) ja: {
	Uitvoer skryf: ['Object link re-attached.'], nuwe-reël.
}.
Uitvoer skryf: b, nuwe-reël.
