>> a := 3.
>> b := a kopieer.
a trek-af: 1.
Uitvoer skryf: [' a = '] + a.
Uitvoer skryf: [' b = '] + b.
a := 3.
b := a + 4.
Uitvoer skryf: [' a = '] + a.
Uitvoer skryf: [' b = '] + b.
>> x := 3.
>> y := x kopieer.
x tel-by: 10.
y trek-af: 1.
Uitvoer skryf: [' x = '] + x.
Uitvoer skryf: [' y = '] + y.
>> q := Objek nuut.
q by: ['setProperty:'] doen: { :x
	eie prop := x.
}.
q by: ['getProperty'] doen: { <- eie prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Uitvoer skryf: [' p = '] + (p getProperty).
