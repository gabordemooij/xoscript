

Lys by: ['fixture:'] doen: { :f
	eie opstelling := f.
}.

Lys by: ['tel'] doen: { <- eie opstelling.
}.

Lys by: ['aantal'] doen: { <- eie opstelling.
}.


>> x := Niks.
{

	x := ['hello'] 
	vervang:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] letter: 2)
			)
		)
	met: (
		(['...hal'] + ['lo']) 
			hoofletters 
			lowecase 
			hoofletters 
			verskuiwing: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Lys ← 0 ; 1 ; 4; 9 ; (Lys ← 0 ; 3; 1) ; 4
							) voorlaaste
						) ? 1
					) + 
					((Lys ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					tel
				)
			)
	).

} × 10.
Uitvoer skryf: x, nuwe-reël.

