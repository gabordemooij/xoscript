Uitvoer skryf: ['Gaan voort for-lus, Nee - voor 6 en hoër.'], nuwe-reël.
{ :i
	Uitvoer skryf: (i + 1), nuwe-reël.
	((i + 1) > 4) gaan-voort.
	Uitvoer skryf: ['-'].
} × 10.

>> x := 0.
>> xIsMinderAs10 := { <- ( x < 10 ). }.
Uitvoer nuwe-reël.
Uitvoer skryf: ['Gaan voort while-true, Nee --> voor 5 en hoër.'], nuwe-reël.
{
	Uitvoer skryf: ['iteration #'] + x, nuwe-reël.
	x tel-by: 1.
	((x < 5) nie) gaan-voort.
	Uitvoer skryf: ['-->'].
} terwyl: xIsMinderAs10.
Uitvoer nuwe-reël.
Uitvoer skryf: ['Gaan voort while-false, Nee - slegs voor 3.'], nuwe-reël.
{
	Uitvoer skryf: ['iteration #'] + x, nuwe-reël.
	x trek-af: 1.
	(x = 3) gaan-voort.
	Uitvoer skryf: ['-'].
} terwyl: { <- ( x > 0). }.

Uitvoer nuwe-reël.
Uitvoer skryf: ['Gaan voort times-lus, Nee ||| voor 3.'], nuwe-reël.
{ :i
	Uitvoer skryf: ['iteration #'] + i, nuwe-reël.
	(i = 2) gaan-voort.
	Uitvoer skryf: ['|||'].
} × 5.

Uitvoer nuwe-reël.

{ Ja gaan-voort. Uitvoer skryf: ['moenie dit skryf nie!'], nuwe-reël. } begin.

{ Ja gaan-voort. Uitvoer skryf: ['moenie dit skryf nie!'], nuwe-reël. } vang: { Uitvoer skryf: ['Moenie dit vang nie!']. }, begin.

Uitvoer skryf: ['Toets Lys elk-lus: 0, ... ,2'], nuwe-reël.
(Lys ← 1 ; 2 ; 3) beeld-af: { :i
	(i = 1) gaan-voort.
	Uitvoer skryf: ['iteration #'] + (i - 0), nuwe-reël.
}.

Uitvoer skryf: ['Toets Kaart elk-lus: slegs c'], nuwe-reël.
>> m := Woordeboek nuut.
m sit: ['first'] by: ['a'], sit: ['second'] by: ['b'], sit: ['derde'] by: ['c'].
m elk: { :k :v
	(k ≠ ['c']) gaan-voort.
	Uitvoer skryf: ['iteration'] + k + v, nuwe-reël.
}.

