Uitvoer skryf: ['Continue for-loop, No - before 6 and up.'], nuwe-reël.
{ :i
	Uitvoer skryf: (i + 1), nuwe-reël.
	((i + 1) > 4) gaan-voort.
	Uitvoer skryf: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Uitvoer nuwe-reël.
Uitvoer skryf: ['Continue while-true, No --> before 5 and up.'], nuwe-reël.
{
	Uitvoer skryf: ['iteration #'] + x, nuwe-reël.
	x tel-by: 1.
	((x < 5) nie) gaan-voort.
	Uitvoer skryf: ['-->'].
} terwyl: xIsLessThan10.
Uitvoer nuwe-reël.
Uitvoer skryf: ['Continue while-false, No - before 3 only.'], nuwe-reël.
{
	Uitvoer skryf: ['iteration #'] + x, nuwe-reël.
	x trek-af: 1.
	(x = 3) gaan-voort.
	Uitvoer skryf: ['-'].
} terwyl: { <- ( x > 0). }.

Uitvoer nuwe-reël.
Uitvoer skryf: ['Continue times-loop, No ||| before 3.'], nuwe-reël.
{ :i
	Uitvoer skryf: ['iteration #'] + i, nuwe-reël.
	(i = 2) gaan-voort.
	Uitvoer skryf: ['|||'].
} × 5.

Uitvoer nuwe-reël.

{ Ja gaan-voort. Uitvoer skryf: ['dont write this!'], nuwe-reël. } begin.

{ Ja gaan-voort. Uitvoer skryf: ['dont write this!'], nuwe-reël. } vang: { Uitvoer skryf: ['Dont catch this!']. }, begin.

Uitvoer skryf: ['Test Array each-loop: 0, ... ,2'], nuwe-reël.
(Lys ← 1 ; 2 ; 3) beeld-af: { :i
	(i = 1) gaan-voort.
	Uitvoer skryf: ['iteration #'] + (i - 0), nuwe-reël.
}.

Uitvoer skryf: ['Test Map each-loop: c only'], nuwe-reël.
>> m := Woordeboek nuut.
m sit: ['first'] by: ['a'], sit: ['second'] by: ['b'], sit: ['third'] by: ['c'].
m elk: { :k :v
	(k ≠ ['c']) gaan-voort.
	Uitvoer skryf: ['iteration'] + k + v, nuwe-reël.
}.

