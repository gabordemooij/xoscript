# Toets ASCII-variante

# Getalle

Uitvoer skryf: (2 !=: 3), nuwe-reël.
Uitvoer skryf: (2 <=: 2), nuwe-reël.
Uitvoer skryf: (2 >=: 2), nuwe-reël.

# Teks

Uitvoer skryf: (['b'] >=: ['a']), nuwe-reël.
Uitvoer skryf: (['b'] !=: ['a']), nuwe-reël.
Uitvoer skryf: (['b'] <=: ['c']), nuwe-reël.

# Boolese waardes

Uitvoer skryf: (Ja !=: Nee), nuwe-reël.

# Objekte

Uitvoer skryf: (Objek nuut !=: Objek nuut), nuwe-reël.

# ASCII-lyssimbool <-:

Uitvoer skryf: (Lys <<: 1, ; 2 ; 3) tel = 3, nuwe-reël.

