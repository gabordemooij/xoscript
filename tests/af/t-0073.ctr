
>> blou := ['blou'].
>> kleure := Lys ← ['yellow']; ['groen']; blou ; ['rooi']; ['oranje']; ['pers']; ['pienk'].
>> palet := kleure vanaf: 2 lengte: 3.
Uitvoer skryf: (palet voeg-saam: [',']), nuwe-reël. 
blou := ['siaan'].
Uitvoer skryf: blou, nuwe-reël. 
kleure sit: ['swart'] by: 2. 
Uitvoer skryf: (kleure voeg-saam: [',']), nuwe-reël. 
Uitvoer skryf: (palet voeg-saam: [',']), nuwe-reël. 
