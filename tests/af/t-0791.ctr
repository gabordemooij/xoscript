Server init.

>> DB := Maria-DB nuut gasheer: ['localhost'],
	gebruikersnaam: ['xo'],
	wagwoord: ['pass123'],
	databasisnaam: ['xobase'],
	verbind.
	
>> SQL := ['SELECT "hello" AS "world" '].

# skep navraag handmatig
>> soekparameters := Maria-Navraag nuut: SQL.

# stel databasis
soekparameters databasis: DB.

soekparameters haal: { :ry
	Uitvoer skryf: ry world, nuwe-reël.
}.
