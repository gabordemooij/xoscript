Uitvoer skryf: ['Toetsobjek'], nuwe-reël.
>> opd := Opdrag nuut.
Uitvoer skryf: opd ls /tmp, nuwe-reël.
>> ou-opd-adres := opd prototipe geheue-adres.
opd save-as: ['/tmp/a.bin'].
Uitvoer skryf: ['========== HERLAAI SNAP:'], nuwe-reël.
>> b := Objek load-from: ['/tmp/a.bin'].
(b prototipe geheue-adres = ou-opd-adres) ja: {
	Uitvoer skryf: ['Objekskakel weer aangeheg.'], nuwe-reël.
}.
Uitvoer skryf: b ls, nuwe-reël.


