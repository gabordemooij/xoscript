Uitvoer skryf: ['Test object'], nuwe-reël.
>> cmd := Opdrag nuut.
Uitvoer skryf: cmd ls /tmp, nuwe-reël.
>> old-cmd-address := cmd prototipe geheue-adres.
cmd save-as: ['/tmp/a.bin'].
Uitvoer skryf: ['========== RELOADING SNAP:'], nuwe-reël.
>> b := Objek load-from: ['/tmp/a.bin'].
(b prototipe geheue-adres = old-cmd-address) ja: {
	Uitvoer skryf: ['Object link re-attached.'], nuwe-reël.
}.
Uitvoer skryf: b ls, nuwe-reël.


