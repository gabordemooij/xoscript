


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program geheuebestuur: 0.
>> palette := Niks.
>> colors := Niks.

{
palette := Woordeboek nuut.
palette 
	sit: ['#F00'] by: ['red'],
	sit: ['#0F0'] by: ['green'],
	sit: ['#00F'] by: ['blue'].
Uitvoer skryf: ['number of RGB codes in palette: '] + ( palette tel ), nuwe-reël.
Uitvoer skryf: ['RGB code of green is: '] + ( palette ? ['green'] ), nuwe-reël.
colors := [''].
( palette elk: { :naam :kode
		colors := colors + ( naam + [':'] + kode ).
} ).
Uitvoer skryf: ['All colors in palette: '] + colors, nuwe-reël.
} begin.
Program ruim-op.
usedMemory1 := (Program geheue ? 0).

{
palette := Woordeboek nuut.
palette 
	sit: ['#F00'] by: ['red'],
	sit: ['#0F0'] by: ['green'],
	sit: ['#00F'] by: ['blue'].
Uitvoer skryf: ['number of RGB codes in palette: '] + ( palette tel ), nuwe-reël.
Uitvoer skryf: ['RGB code of green is: '] + ( palette ? ['green'] ), nuwe-reël.
colors := [''].
( palette elk: { :naam :kode
		colors := colors + ( naam + [':'] + kode ).
} ).
Uitvoer skryf: ['All colors in palette: '] + colors, nuwe-reël.
} begin.
Program ruim-op.
usedMemory2 := (Program geheue ? 0).

{
palette := Woordeboek nuut.
palette 
	sit: ['#F00'] by: ['red'],
	sit: ['#0F0'] by: ['green'],
	sit: ['#00F'] by: ['blue'].
Uitvoer skryf: ['number of RGB codes in palette: '] + ( palette tel ), nuwe-reël.
Uitvoer skryf: ['RGB code of green is: '] + ( palette ? ['green'] ), nuwe-reël.
colors := [''].
( palette elk: { :naam :kode
		colors := colors + ( naam + [':'] + kode ).
} ).
Uitvoer skryf: ['All colors in palette: '] + colors, nuwe-reël.
} begin.
Program ruim-op.
usedMemory3 := (Program geheue ? 0).



( usedMemory1 = usedMemory2 en: usedMemory1 = usedMemory3, en: usedMemory2 = usedMemory3 ) ja: {
	Uitvoer skryf: ['No memory leaks here'].
}, nee: {
	Uitvoer skryf: ['Leaking memory...'].
}.
