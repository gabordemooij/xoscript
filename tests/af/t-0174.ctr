


>> gebruikteGeheue1 := 0.
>> gebruikteGeheue2 := 0.
>> gebruikteGeheue3 := 0.
>> gebruikteGeheue4 := 0.

Program geheuebestuur: 0.
>> palet := Niks.
>> kleure := Niks.

{
palet := Woordeboek nuut.
palet 
	sit: ['#F00'] by: ['rooi'],
	sit: ['#0F0'] by: ['groen'],
	sit: ['#00F'] by: ['blou'].
Uitvoer skryf: ['aantal RGB-kodes in palet: '] + ( palet tel ), nuwe-reël.
Uitvoer skryf: ['RGB-kode van groen is: '] + ( palet ? ['groen'] ), nuwe-reël.
kleure := [''].
( palet elk: { :naam :kode
		kleure := kleure + ( naam + [':'] + kode ).
} ).
Uitvoer skryf: ['Alle kleure in palet: '] + kleure, nuwe-reël.
} begin.
Program ruim-op.
gebruikteGeheue1 := (Program geheue ? 0).

{
palet := Woordeboek nuut.
palet 
	sit: ['#F00'] by: ['rooi'],
	sit: ['#0F0'] by: ['groen'],
	sit: ['#00F'] by: ['blou'].
Uitvoer skryf: ['aantal RGB-kodes in palet: '] + ( palet tel ), nuwe-reël.
Uitvoer skryf: ['RGB-kode van groen is: '] + ( palet ? ['groen'] ), nuwe-reël.
kleure := [''].
( palet elk: { :naam :kode
		kleure := kleure + ( naam + [':'] + kode ).
} ).
Uitvoer skryf: ['Alle kleure in palet: '] + kleure, nuwe-reël.
} begin.
Program ruim-op.
gebruikteGeheue2 := (Program geheue ? 0).

{
palet := Woordeboek nuut.
palet 
	sit: ['#F00'] by: ['rooi'],
	sit: ['#0F0'] by: ['groen'],
	sit: ['#00F'] by: ['blou'].
Uitvoer skryf: ['aantal RGB-kodes in palet: '] + ( palet tel ), nuwe-reël.
Uitvoer skryf: ['RGB-kode van groen is: '] + ( palet ? ['groen'] ), nuwe-reël.
kleure := [''].
( palet elk: { :naam :kode
		kleure := kleure + ( naam + [':'] + kode ).
} ).
Uitvoer skryf: ['Alle kleure in palet: '] + kleure, nuwe-reël.
} begin.
Program ruim-op.
gebruikteGeheue3 := (Program geheue ? 0).



( gebruikteGeheue1 = gebruikteGeheue2 en: gebruikteGeheue1 = gebruikteGeheue3, en: gebruikteGeheue2 = gebruikteGeheue3 ) ja: {
	Uitvoer skryf: ['Geen geheuelekke hier nie'].
}, nee: {
	Uitvoer skryf: ['Geheue lek...'].
}.
