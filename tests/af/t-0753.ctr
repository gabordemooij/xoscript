Uitvoer skryf: ['Toetsobjek'], nuwe-reël.
>> a := Objek nuut. 

a by: ['item:'] doen: { :fmt
	eie fmt := fmt. 
}.

a by: ['artikel'] doen: {
	<- eie fmt.
}.

a item: ( Formaat nuut: ['|%s|'] ).

Uitvoer skryf: a artikel, nuwe-reël.

>> ou-fmt-adres := a artikel prototipe geheue-adres.
a save-as: ['/tmp/a.bin'].
Uitvoer skryf: ['========== HERLAAI SNAP:'], nuwe-reël.

>> b := Objek load-from: ['/tmp/a.bin'].

(b artikel prototipe geheue-adres = ou-fmt-adres) ja: {
	Uitvoer skryf: ['Objekskakel weer aangeheg.'], nuwe-reël.
}.

Uitvoer skryf: ( b artikel pas-toe: ['hello'] ), nuwe-reël.
