Uitvoer skryf: ['Test object'], nuwe-reël.
>> a := Objek nuut. 

a by: ['item:'] doen: { :fmt
	eie fmt := fmt. 
}.

a by: ['item'] doen: { <- eie fmt.
}.

a item: ( Formaat nuut: ['|%s|'] ).

Uitvoer skryf: a item, nuwe-reël.

>> old-fmt-address := a item prototipe geheue-adres.
a save-as: ['/tmp/a.bin'].
Uitvoer skryf: ['========== RELOADING SNAP:'], nuwe-reël.

>> b := Objek load-from: ['/tmp/a.bin'].

(b item prototipe geheue-adres = old-fmt-address) ja: {
	Uitvoer skryf: ['Object link re-attached.'], nuwe-reël.
}.

Uitvoer skryf: ( b item pas-toe: ['hello'] ), nuwe-reël.
