

>> gebruikteGeheue1 := 0.
>> gebruikteGeheue2 := 0.
>> gebruikteGeheue3 := 0.
>> gebruikteGeheue4 := 0.

Program geheuebestuur: 0.

>> txt := ['World Salad'].
Uitvoer skryf: ['hierdie teks bevat: '] + ( ( txt verdeel: [' '] ) tel ) + [' woorde.'], nuwe-reël.
txt := txt vanaf: 6 lengte: 4.
Uitvoer skryf: txt, nuwe-reël.

Program ruim-op.

gebruikteGeheue1 := (Program geheue ? 0).


txt := ['World Salad'].
Uitvoer skryf: ['hierdie teks bevat: '] + ( ( txt verdeel: [' '] ) tel ) + [' woorde.'], nuwe-reël.
txt := txt vanaf: 6 lengte: 4.
Uitvoer skryf: txt, nuwe-reël.

Program ruim-op.
gebruikteGeheue2 := (Program geheue ? 0).


txt := ['World Salad'].
