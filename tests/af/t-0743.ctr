>> V := Objek.
V by: ['teks'] doen: {
	Uitvoer skryf: ['cast'], nuwe-reël.
	<- ['abc'].
}.

Uitvoer skryf: ( Program instelling: ['abc'] ), nuwe-reël.

# url-parameters moenie deur GC opgeruim word nie
Program instelling: ([''] + V nuut) waarde: ([''] + V nuut).

Uitvoer skryf: ( Program instelling: ['abc'] ), nuwe-reël.
