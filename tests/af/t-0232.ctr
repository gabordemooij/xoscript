>> Slurp := Objek nuut.

Slurp by: ['nuut'] doen: {
	eie str := [''].
}.

Slurp by: ['reageer:'] doen: { :blah
		(eie str = ['']) ja: {
			eie str voeg-agter: blah.
		}, anders: {
			eie str voeg-agter: [' '].
			eie str voeg-agter: blah.
		}.
}.

Slurp by: ['reageer:en:'] doen: { :blah :blahah
		(blah lengte > 1) ja: {
			eie str voeg-agter: (blah vanaf: 0 lengte: (blah lengte - 1)).
		}, anders: {
			eie str voeg-agter: blah.
		}.
		eie str voeg-agter: [' '].
		eie str voeg-agter: blahah.
}.

Slurp by: ['verkry'] doen: {
	>> buffer := eie str.
	eie str := ['']. <- buffer.
}.


>> x := Slurp nuut.
x + 3.
Uitvoer skryf: (x verkry), nuwe-reël.
x echo: ['Hallo wêreld'].
Uitvoer skryf: (x verkry), nuwe-reël.
x tellme: 123 and: 987.
Uitvoer skryf: (x verkry), nuwe-reël.
