>> faktuur := Objek nuut.
faktuur by: ['begin'] doen: {
        eie getal := 0.
}.

faktuur by: ['getal'] doen: {
        eie getal tel-by: 1.
        <- eie getal kopieer.
}.

>> jaar-faktuur := faktuur nuut.
jaar-faktuur by: ['start:'] doen: { :jaar
	eie getal := jaar.
}.

jaar-faktuur start: 202000.
Uitvoer skryf: jaar-faktuur getal, nuwe-reël.
Uitvoer skryf: jaar-faktuur getal, nuwe-reël.
