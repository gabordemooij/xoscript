>> invoice := Objek nuut.
invoice by: ['begin'] doen: {
        eie getal := 0.
}.

invoice by: ['getal'] doen: {
        eie getal tel-by: 1. <- eie getal kopieer.
}.

>> year-invoice := invoice nuut.
year-invoice by: ['start:'] doen: { :jaar
	eie getal := jaar.
}.

year-invoice start: 202000.
Uitvoer skryf: year-invoice getal, nuwe-reël.
Uitvoer skryf: year-invoice getal, nuwe-reël.
