

# create a 64-bit integer for exact calculations
>> a := Int64 vanuit-teks: ['123'].

# to string
Uitvoer skryf: a, nuwe-reël.

# divide
Uitvoer skryf: a / (Int64 vanuit-teks: ['3']), nuwe-reël.

# multiply
Uitvoer skryf: a * (Int64 vanuit-teks: ['2']), nuwe-reël.

# add
Uitvoer skryf: a + (Int64 vanuit-teks: ['1']), nuwe-reël.

# subtract
Uitvoer skryf: a - (Int64 vanuit-teks: ['2']), nuwe-reël.

# compare
Uitvoer skryf: ( a =   (Int64 vanuit-teks: ['123'])), nuwe-reël.
Uitvoer skryf: ( a !=: (Int64 vanuit-teks: ['124'])), nuwe-reël.
Uitvoer skryf: ( a <   (Int64 vanuit-teks: ['124'])), nuwe-reël.
Uitvoer skryf: ( a >   (Int64 vanuit-teks: ['122'])), nuwe-reël.
Uitvoer skryf: ( a >=: (Int64 vanuit-teks: ['123'])), nuwe-reël.
Uitvoer skryf: ( a <=: (Int64 vanuit-teks: ['123'])), nuwe-reël.





	