
Server init.
Uitvoer skryf: ['Database test'], nuwe-reël.

>> db := Maria-DB nuut gasheer: ['localhost'],
	gebruikersnaam: ['xo'], 
	wagwoord: ['pass123'],
	databasisnaam: ['xobase'],
	verbind.

>> soekparameters :=
db navraag: ['SELECT REPEAT('Blah',1000) AS blah'], 
haal: { :row 
	Uitvoer skryf: row blah lengte, nuwe-reël.
}.
