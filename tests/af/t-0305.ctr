
Getal leer: ['plus:'] beteken: ['+'].
Getal by: ['+'] doen: { :x
	>> rate := 1.
	>> currency := x kwalifiseerder.
	(currency = ['euros']) ja: {
		rate := 2.
	}. <- (self plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars kwalifiseer: ['dollars'].
euros kwalifiseer: ['euros'].
>> money := dollars + euros.
Uitvoer skryf: money, nuwe-reël.
