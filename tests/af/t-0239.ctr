Lys by: ['som'] doen: {
	>> totaal := 0.
	self elk: { :indeks :element
		totaal tel-by: element.
	}. <- totaal.
}.

>> a := Ja.



a by: ['teks'] doen: {
	>> antwoord := Niks.
	( self = Ja ) ja: {
		antwoord := ['Jip'].
	}, anders: {
		antwoord := ['Nee wat'].
	}. <- antwoord.
}.

a by: ['getal'] doen: {
	>> antwoord := Niks.
	( self = Ja ) ja: {
		antwoord := 10.
	}, anders: {
		antwoord := 20.
	}. <- antwoord.
}.

>> b := 666.

b by: ['teks'] doen: { <- ['Duiwel'].
}.

b by: ['boolees'] doen: { <- Nee.
}.


Uitvoer skryf: a, nuwe-reël.  
Uitvoer skryf: (90 + a), nuwe-reël. 
Uitvoer skryf: b, nuwe-reël. 
Uitvoer skryf: (Ja en: b), nuwe-reël.

a := Lys ← ['hello'] ; ['world'] ; Ja ; Niks ; 666. 
a := a + ( Lys ← 1 ).
Uitvoer skryf: a, nuwe-reël.
Uitvoer skryf: ((Woordeboek nuut) sit: Niks by: Niks), nuwe-reël.
Uitvoer skryf: a som, nuwe-reël. 


{
	a by: ['teks'] doen: { <- Niks. }.
	a := [''] + a.
} vang: { :fout
	Uitvoer skryf: ['Fout aangeteken: '] + fout, nuwe-reël.
}, begin.



{
	a by: ['getal'] doen: { <- Niks. }.
	a := 3 × a.
} vang: { :fout
	Uitvoer skryf: ['Fout aangeteken: '] + fout, nuwe-reël.
}, begin.


{
	a by: ['boolees'] doen: { <- Niks. }.
	a := Ja en: a. 
} vang: { :fout
	Uitvoer skryf: ['Fout aangeteken: '] + fout, nuwe-reël.
}, begin.





{
	a by: ['teks'] doen: { <- Nee. }.
	a := [''] + a.
} vang: { :fout
	Uitvoer skryf: ['Fout aangeteken: '] + fout, nuwe-reël.
}, begin.



{
	a by: ['getal'] doen: { <- Ja. }.
	a := 3 × a.
} vang: { :fout
	Uitvoer skryf: ['Fout aangeteken: '] + fout, nuwe-reël.
}, begin.


{
	a by: ['boolean'] doen: { <- 1. }.
	a := Ja en: a.
} vang: { :fout
	Uitvoer skryf: ['Fout aangeteken: '] + fout, nuwe-reël.
}, begin.





{
	a by: ['teks'] doen: { <- 1. }.
	a := [''] + a.
} vang: { :fout
	Uitvoer skryf: ['Fout aangeteken: '] + fout, nuwe-reël.
}, begin.



{
	a by: ['getal'] doen: { <- ['']. }.
	a := 3 × a.
} vang: { :fout
	Uitvoer skryf: ['Fout aangeteken: '] + fout, nuwe-reël.
}, begin.


{
	a by: ['boolean'] doen: { <- ['']. }.
	a := Ja en: a.
} vang: { :fout
	Uitvoer skryf: ['Fout aangeteken: '] + fout, nuwe-reël.
}, begin.






{
	a by: ['teks'] doen: { <- (Woordeboek nuut). }.
	a := [''] + a. 
} vang: { :fout
	Uitvoer skryf: ['Fout aangeteken: '] + fout, nuwe-reël.
}, begin.



{
	a by: ['getal'] doen: { <- (Objek nuut). }.
	a := 3 × a. 
} vang: { :fout
	Uitvoer skryf: ['Fout aangeteken: '] + fout, nuwe-reël.
}, begin.


{
	a by: ['boolean'] doen: { <- (Objek nuut). }.
