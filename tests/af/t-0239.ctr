Lys by: ['sum'] doen: {
	>> total := 0.
	self elk: { :index :element
		total tel-by: element.
	}. <- total.
}.

>> a := Ja.



a by: ['teks'] doen: {
	>> answer := Niks.
	( self = Ja ) ja: {
		answer := ['Yep'].
	}, anders: {
		answer := ['Nope'].
	}. <- answer.
}.

a by: ['getal'] doen: {
	>> answer := Niks.
	( self = Ja ) ja: {
		answer := 10.
	}, anders: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b by: ['teks'] doen: { <- ['Devil'].
}.

b by: ['boolees'] doen: { <- Nee.
}.


Uitvoer skryf: a, nuwe-reël.  
Uitvoer skryf: (90 + a), nuwe-reël. 
Uitvoer skryf: b, nuwe-reël. 
Uitvoer skryf: (Ja en: b), nuwe-reël.

a := Lys ← ['hello'] ; ['world'] ; Ja ; Niks ; 666. 
a := a + ( Lys ← 1 ).
Uitvoer skryf: a, nuwe-reël.
Uitvoer skryf: ((Woordeboek nuut) sit: Niks by: Niks), nuwe-reël.
Uitvoer skryf: a sum, nuwe-reël. 


{
	a by: ['teks'] doen: { <- Niks. }.
	a := [''] + a.
} vang: { :error
	Uitvoer skryf: ['Error noted: '] + error, nuwe-reël.
}, begin.



{
	a by: ['getal'] doen: { <- Niks. }.
	a := 3 × a.
} vang: { :error
	Uitvoer skryf: ['Error noted: '] + error, nuwe-reël.
}, begin.


{
	a by: ['boolees'] doen: { <- Niks. }.
	a := Ja en: a. 
} vang: { :error
	Uitvoer skryf: ['Error noted: '] + error, nuwe-reël.
}, begin.





{
	a by: ['teks'] doen: { <- Nee. }.
	a := [''] + a.
} vang: { :error
	Uitvoer skryf: ['Error noted: '] + error, nuwe-reël.
}, begin.



{
	a by: ['getal'] doen: { <- Ja. }.
	a := 3 × a.
} vang: { :error
	Uitvoer skryf: ['Error noted: '] + error, nuwe-reël.
}, begin.


{
	a by: ['boolean'] doen: { <- 1. }.
	a := Ja en: a.
} vang: { :error
	Uitvoer skryf: ['Error noted: '] + error, nuwe-reël.
}, begin.





{
	a by: ['teks'] doen: { <- 1. }.
	a := [''] + a.
} vang: { :error
	Uitvoer skryf: ['Error noted: '] + error, nuwe-reël.
}, begin.



{
	a by: ['getal'] doen: { <- ['']. }.
	a := 3 × a.
} vang: { :error
	Uitvoer skryf: ['Error noted: '] + error, nuwe-reël.
}, begin.


{
	a by: ['boolean'] doen: { <- ['']. }.
	a := Ja en: a.
} vang: { :error
	Uitvoer skryf: ['Error noted: '] + error, nuwe-reël.
}, begin.






{
	a by: ['teks'] doen: { <- (Woordeboek nuut). }.
	a := [''] + a. 
} vang: { :error
	Uitvoer skryf: ['Error noted: '] + error, nuwe-reël.
}, begin.



