>> x := Objek nuut.
>> y := Objek nuut.
>> z := x.
Uitvoer skryf: (x = z), nuwe-reël.
Uitvoer skryf: (x = y), nuwe-reël.
Uitvoer skryf: (x ≠ y), nuwe-reël.
Uitvoer skryf: (x ≠ z), nuwe-reël.
>> m := Oomblik nuut jaar: 2070, maand: 11.
>> n := m kopieer.
Uitvoer skryf: (m = n), nuwe-reël.
Uitvoer skryf: (m ≠ n), nuwe-reël.
Uitvoer skryf: (m gelyk: m), nuwe-reël.
Uitvoer skryf: (m gelyk: n), nuwe-reël.
n maand: 12.
Uitvoer skryf: (m ≠ n), nuwe-reël.
Uitvoer skryf: (m = n), nuwe-reël.


