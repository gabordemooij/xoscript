# truskuinstrepe moet kodeserialisering oorleef, tekste mag nie te vroeg eindig nie
>> waardes := Lys nuut
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

waardes elk: { :i :value
	>> d := Woordeboek nuut.
	d sit: value by: ['k'].
	>> r := d kode objek.
	Uitvoer skryf: r tel, nuwe-reël.
	Uitvoer skryf: ( (r by: ['k']) = value ), nuwe-reël.
}.
