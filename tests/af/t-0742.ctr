Uitvoer skryf: ['Test object'], nuwe-reël.
>> a := Objek nuut. 

a by: ['item:'] doen: { :hexhelper
	eie hexhelper := hexhelper. 
}.

a by: ['item'] doen: { <- eie hexhelper.
}.

a item: Hx nuut.

>> old-hexhelper-address := a item prototipe geheue-adres.
a save-as: ['/tmp/a.bin'].
Uitvoer skryf: ['========== RELOADING SNAP:'], nuwe-reël.

>> b := Objek load-from: ['/tmp/a.bin'].

(b item prototipe geheue-adres = old-hexhelper-address) ja: {
	Uitvoer skryf: ['Object link re-attached.'], nuwe-reël.
}.
