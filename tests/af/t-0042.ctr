>> items := Woordeboek nuut.
items sit: ['black'] by: ['coffee'], sit: ['earl grey'] by: ['tea'].
Uitvoer skryf: (items by: ['coffee']), skryf: (items by: ['tea']).
Uitvoer skryf: ['there are'] + items tel + [' items in the array.'].
items sit: ['capuccino'] by: ['coffee'].
Uitvoer skryf: ['Now my coffee is.. '] + (items by: ['coffee']).
items sit: ['aaa'] by: ['1'].
items sit: ['bbb'] by: ['2'].
Uitvoer skryf: (items by: ['a']).
