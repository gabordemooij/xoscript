# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Patroon nuut: pattern.
	p passing: subject doen: { :m :g
		Uitvoer skryf: g tel, skryf: [' '], skryf: (g voeg-saam: ['|']), nuwe-reël. <- m.
	}.
}.
show pas-toe: ['(a)|(b)'] en: ['b'].
show pas-toe: ['(a)|(b)'] en: ['a'].
show pas-toe: ['(x)?y'] en: ['y'].
show pas-toe: ['(x)?(y)(z)?'] en: ['xy'].
