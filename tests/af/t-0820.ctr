# 'n groep wat nie deel van die passing is nie, mag nie laat ineenstort nie en moet die groepnommers behou
Server init.
>> wys := { :soekpatroon :subject
	>> p := Patroon nuut: soekpatroon.
	p passing: subject doen: { :m :g
		Uitvoer skryf: g tel, skryf: [' '], skryf: (g voeg-saam: ['|']), nuwe-reël.
		<- m.
	}.
}.
wys pas-toe: ['(a)|(b)'] en: ['b'].
wys pas-toe: ['(a)|(b)'] en: ['a'].
wys pas-toe: ['(x)?y'] en: ['y'].
wys pas-toe: ['(x)?(y)(z)?'] en: ['xy'].
