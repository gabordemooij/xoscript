

Program ruim-op.


>> Groente := Objek nuut.
Groente by: ['nuut'] doen: {
	>> v := self nuut.
	v init. <- v.
}.

Groente by: ['init'] doen: { eie groentes := 0. }.

Groente by: ['carrots:'] doen: { :a eie groentes := a. <- Niks. }.
Groente by: ['wortels'] doen: { <- eie groentes. }.
Groente by: ['+'] doen: { :f
	>> n := Groente nuut.
	n carrots: (f wortels + eie groentes). <- n.
}.

Groente by: ['teks'] doen: { <- eie groentes teks.
}.

Getal by: ['wortels'] doen: {
	>> x := Groente nuut.
	x carrots: self. <- x.
}.

Getal by: ['telop:en:'] doen: { :a :b <- (a + b).
}.

>> q := 0 telop: (3 wortels + 2 wortels) en: 4 wortels.
Uitvoer skryf: q, nuwe-reël.
