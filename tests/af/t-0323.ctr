

Program ruim-op.


>> Veggy := Objek nuut.
Veggy by: ['nuut'] doen: {
	>> v := self nuut.
	v init. <- v.
}.

Veggy by: ['init'] doen: { eie veggies := 0. }.

Veggy by: ['carrots:'] doen: { :a eie veggies := a. <- Niks. }.
Veggy by: ['carrots'] doen: { <- eie veggies. }.
Veggy by: ['+'] doen: { :f
	>> n := Veggy nuut.
	n carrots: (f carrots + eie veggies). <- n.
}.

Veggy by: ['teks'] doen: { <- eie veggies teks.
}.

Getal by: ['carrots'] doen: {
	>> x := Veggy nuut.
	x carrots: self. <- x.
}.

Getal by: ['add:and:'] doen: { :a :b <- (a + b).
}.

>> q := 0 add: (3 carrots + 2 carrots) and: 4 carrots.
Uitvoer skryf: q, nuwe-reël.
