# test Program version

# this feature is disabled by default
Uitvoer skryf: (
	Program funksionaliteit: 
	['RECURSIVE_STRINTPOL']
), nuwe-reël.


# but if we set the time back
>> today := Oomblik 
sone: ['CEST'],
vanuit: ['2026-02-15 10:00:00'].
Program weergawe: today.

# it will be enabled like it used to be (from now on)
Uitvoer skryf: (
	Program funksionaliteit: 
	['RECURSIVE_STRINTPOL']
), nuwe-reël.