>> Groeter := Objek nuut.
Groeter by: ['maak'] doen: {
	>> groeter := Objek nuut.
	groeter by: ['name:'] doen: { :naam
		Uitvoer skryf: ['stel 'n naam in'].
		eie myNaam := naam.
	}.
	groeter by: ['voerGroetUit'] doen: {
		Uitvoer skryf: ['Hello'].
		Uitvoer skryf: eie myNaam.
	}.
	groeter by: ['groet'] doen: {
		self voerGroetUit.
	}. <- groeter.
}.
>> groeter := Groeter maak.
groeter name: ['sonskyn!'].
groeter groet.
