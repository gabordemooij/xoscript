>> Greeter := Objek nuut.
Greeter by: ['make'] doen: {
	>> greeter := Objek nuut.
	greeter by: ['name:'] doen: { :naam
		Uitvoer skryf: ['setting a name'].
		eie myName := naam.
	}.
	greeter by: ['performGreeting'] doen: {
		Uitvoer skryf: ['Hello'].
		Uitvoer skryf: eie myName.
	}.
	greeter by: ['greet'] doen: {
		self performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
