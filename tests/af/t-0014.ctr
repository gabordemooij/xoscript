>> Groeter := Objek nuut.
Groeter by: ['maak'] doen: {
	>> gr := Objek nuut.
	gr by: ['setName:'] doen: { :eenNaam
		eie naam := eenNaam.
	}.
	gr by: ['groet'] doen: {
		Uitvoer skryf: eie naam.
	}. <- gr.
}.
>> a := Groeter maak.
>> b := Groeter maak.
a setName: ['EEN'].
b setName: ['TWEE'].
a groet.
b groet.
>> c := a nuut.
c setName: ['DRIE'].
c groet.
>> d := a nuut.
d setName: ['VIER'].
d groet.
c groet.
