>> Greeter := Objek nuut.
Greeter by: ['make'] doen: {
	>> gr := Objek nuut.
	gr by: ['setName:'] doen: { :aname
		eie naam := aname.
	}.
	gr by: ['greet'] doen: {
		Uitvoer skryf: eie naam.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a nuut.
c setName: ['THREE'].
c greet.
>> d := a nuut.
d setName: ['FOUR'].
d greet.
c greet.
