Uitvoer skryf: ['Toetsobjek'], nuwe-reël.
>> groeter := Objek nuut.
groeter by: ['name:'] doen: { :naam
	eie xnaam := naam. 
}.
groeter by: ['groet'] doen: {
	Uitvoer skryf: ['Hallo '] + eie xnaam, nuwe-reël.
}.
groeter name: ['Sherlock'].
groeter save-as: ['/tmp/a.bin'].
groeter save-as: ['/tmp/b.bin'].
Uitvoer skryf: ['========== HERLAAI SNAP:'], nuwe-reël.
>> b := Objek load-from: ['/tmp/a.bin'].
>> c := Objek load-from: ['/tmp/b.bin'].
b groet.
b name: ['Watson'], groet.
c name: ['Moriarty'], groet.
