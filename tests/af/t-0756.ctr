Uitvoer skryf: ['Test object'], nuwe-reël.
>> greeter := Objek nuut.
greeter by: ['name:'] doen: { :naam
	eie xname := naam. 
}.
greeter by: ['greet'] doen: {
	Uitvoer skryf: ['Hello '] + eie xname, nuwe-reël.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Uitvoer skryf: ['========== RELOADING SNAP:'], nuwe-reël.
>> b := Objek load-from: ['/tmp/a.bin'].
>> c := Objek load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
