
>> Dier := Objek nuut.
Dier by: ['nuut'] doen: {
	<- self nuut init.
}.

Dier by: ['init'] doen: {
	eie geluid := ['?'].
	eie bene  := 4.
}.

>> Hond := Dier nuut.
Hond by: ['init'] doen: {
	self init.
	eie geluid := ['blaf'].
}.

Dier by: ['teks'] doen: {
	<- eie bene teks + eie geluid.
}.

>> poedel := Hond nuut.
Uitvoer skryf: poedel, nuwe-reël.

