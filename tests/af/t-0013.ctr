
>> Animal := Objek nuut.
Animal by: ['nuut'] doen: { <- self nuut init.
}.

Animal by: ['init'] doen: {
	eie sound := ['?'].
	eie legs := 4.
}.

>> Dog := Animal nuut.
Dog by: ['init'] doen: {
	self init.
	eie sound := ['barks'].
}.

Animal by: ['teks'] doen: { <- eie legs teks + eie sound.
}.

>> poodle := Dog nuut.
Uitvoer skryf: poodle, nuwe-reël.

