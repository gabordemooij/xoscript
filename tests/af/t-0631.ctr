#ffi-toets


Server init.

Program geheuebestuur: 4.

# vir hierdie toets moet jy 'n pad na libc (puts) instel
>> biblioteeknaam := Program instelling: ['FFITESTLIB'].



Server koppel: (
 Lys nuut ;
 biblioteeknaam ;
 ['puts'] ;
 ( Lys nuut ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s stel-vry.

# toets met struct

>> a := Blob nuut: 8.
a bytes: (
	Lys <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struktuur := Blob struct: (Lys <<: ['int'], ; ['int']).

Server koppel: (
	Lys <<: ['@structtest'], ;
	['@structtest'] ;
	(Lys <<: struktuur) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Uitvoer skryf: ['Sum test:'] + (ffitest ffisum: a), nuwe-reël.

struktuur stel-struct-vry.
struktuur stel-vry.
a stel-vry.
