#ffi test


Server init.

Program geheuebestuur: 4.

# for this test you need set a path to libc (puts)
>> libname := Program instelling: ['FFITESTLIB'].



Server koppel: (
 Lys nuut ;
 libname ;
 ['puts'] ;
 ( Lys nuut ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s stel-vry.

# test with struct

>> a := Blob nuut: 8.
a bytes: (
	Lys <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Lys <<: ['int'], ; ['int']).

Server koppel: (
	Lys <<: ['@structtest'], ;
	['@structtest'] ;
	(Lys <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Uitvoer skryf: ['Sum test:'] + (ffitest ffisum: a), nuwe-reël.

struct stel-struct-vry.
struct stel-vry.
a stel-vry.
