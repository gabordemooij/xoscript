>> randomizer := { :a :b
	>> minimum := ( a < b ) of: a of: b.
	>> maksimum := ( a > b ) of: a of: b.
	>> x := Niks.
	{
		x := Getal tussen: a en: b.
		((x < minimum) of: (x > maksimum)) ja: { 
			Uitvoer skryf: (['Invalid value!']).
			Program einde.
		}.
	} 
	× 100. <- x.
}.
randomizer pas-toe: 0 en: 0.
randomizer pas-toe: 1 en: 0.
randomizer pas-toe: 1 en: 1.
randomizer pas-toe: 0 en: 1.
randomizer pas-toe: -1 en: 0.
randomizer pas-toe: -1 en: -1.
randomizer pas-toe: 0 en: -1.
randomizer pas-toe: 100 en: 200.
randomizer pas-toe: 999999999999998 en: 999999999999999.
