Uitvoer skryf: ['Toetsobjek'], nuwe-reël.
>> a := Objek nuut. 

a by: ['item:'] doen: { :okthulp
	eie okthulp := okthulp. 
}.

a by: ['artikel'] doen: {
	<- eie okthulp.
}.

a item: Oct nuut.

>> ou-okthulp-adres := a artikel prototipe geheue-adres.
a save-as: ['/tmp/a.bin'].
Uitvoer skryf: ['========== HERLAAI SNAP:'], nuwe-reël.

>> b := Objek load-from: ['/tmp/a.bin'].

(b artikel prototipe geheue-adres = ou-okthulp-adres) ja: {
	Uitvoer skryf: ['Objekskakel weer aangeheg.'], nuwe-reël.
}.
