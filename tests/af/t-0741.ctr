Uitvoer skryf: ['Test object'], nuwe-reël.
>> a := Objek nuut. 

a by: ['item:'] doen: { :octhelper
	eie octhelper := octhelper. 
}.

a by: ['item'] doen: { <- eie octhelper.
}.

a item: Oct nuut.

>> old-octhelper-address := a item prototipe geheue-adres.
a save-as: ['/tmp/a.bin'].
Uitvoer skryf: ['========== RELOADING SNAP:'], nuwe-reël.

>> b := Objek load-from: ['/tmp/a.bin'].

(b item prototipe geheue-adres = old-octhelper-address) ja: {
	Uitvoer skryf: ['Object link re-attached.'], nuwe-reël.
}.
