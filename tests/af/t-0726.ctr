# test buffers PKI/Sign 
Server init.

>> long := ( Lys nuut vul: 1000 met: ['a'] ) voeg-saam: [''].

# sign a message
Uitvoer skryf: ( 
	Kluis onderteken: ['abc'] met: long
), nuwe-reël.

Uitvoer skryf: ( 
	Kluis
		kontroleer: ['abc'] 
		handtekening: long 
		met: long
), nuwe-reël.

Uitvoer skryf: (
	Kluis wagwoord-hutswaarde: long kontroleer: long
), nuwe-reël.
