# toets buffers PKI/Onderteken 
Server init.

>> lank := ( Lys nuut vul: 1000 met: ['a'] ) voeg-saam: [''].

# onderteken 'n boodskap
Uitvoer skryf: ( 
	Kluis onderteken: ['abc'] met: lank
), nuwe-reël.

Uitvoer skryf: ( 
	Kluis
		kontroleer: ['abc'] 
		handtekening: lank 
		met: lank
), nuwe-reël.

Uitvoer skryf: (
	Kluis wagwoord-hutswaarde: lank kontroleer: lank
), nuwe-reël.
