

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program geheuebestuur: 0.

Getal by: ['addNum:'] doen: { :x
	self tel-by: x.
}.

Getal by: ['subtractNum:'] doen: { :x
	self trek-af: x.
}.

Getal by: ['multiplyBy:'] doen: { :x
	self vermenigvuldig-met: x.
}.

Getal by: ['divideBy:'] doen: { :x
	self deel-deur: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 tot-die-mag: 8).  
a := a + (2 tot-die-mag: -1). 
a := a + (49 vierkantswortel).   
a addNum: ((Lys ← 0 ; 1) maksimum).          
a addNum: ((Lys ← 2 ; 3) minimum).
Uitvoer skryf: a.

Program ruim-op.

usedMemory1 := (Program geheue ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 tot-die-mag: 8).  
a := a + (2 tot-die-mag: -1). 
a := a + (49 vierkantswortel).   
a addNum: ((Lys ← 0 ; 1) maksimum).          
a addNum: ((Lys ← 2 ; 3) minimum).
Uitvoer skryf: a.

Program ruim-op.
usedMemory2 := (Program geheue ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 tot-die-mag: 8).  
a := a + (2 tot-die-mag: -1). 
a := a + (49 vierkantswortel).   
a addNum: ((Lys ← 0 ; 1) maksimum).          
a addNum: ((Lys ← 2 ; 3) minimum).
Uitvoer skryf: a.

Program ruim-op.
usedMemory3 := (Program geheue ? 0).



( usedMemory1 = usedMemory2 en: usedMemory1 = usedMemory3, en: usedMemory2 = usedMemory3 ) ja: {
	Uitvoer skryf: ['No memory leaks here'].
}, nee: {
	Uitvoer skryf: ['Leaking memory...'].
}.
