Uitvoer skryf: ['1,2,3,4,5,6,7,8,9,A,'], nuwe-reël.
>> Scope := Objek nuut.
Scope by: ['initialize:'] doen: { :x eie property := x. }.
Scope by: ['confirm'] doen: { Uitvoer skryf: [',']. }.
Scope by: ['toets'] doen: {
	Uitvoer skryf: eie property.
	self confirm.
	( 1 = 1 ) ja: { Uitvoer skryf: eie property. self confirm. }.
	( 1 = 0 ) nee: { Uitvoer skryf: eie property. self confirm. }.
	>> y := 2. { Uitvoer skryf: eie property. self confirm. } terwyl: { y trek-af: 1. <- (y > 0). }.
	{ Uitvoer skryf: eie property. self confirm. } × 1.
	(Lys ← 1) elk: {  Uitvoer skryf: eie property. self confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Woordeboek nuut one: ['item']) elk: { Uitvoer skryf: eie property. self confirm. }.
	{ 1 ÷ 0. } vang: { Uitvoer skryf: eie property. self confirm. }, begin.
	Uitvoer nuwe-reël.
}.
>> scope1 := Scope nuut.
scope1 initialize: ['X'].
scope1 toets.
>> function := { 
	eie property := ['Y'].
	Uitvoer skryf: eie property.
	self confirm.
	( 1 = 1 ) ja: { Uitvoer skryf: eie property. self confirm. }.
	( 1 = 0 ) nee: { Uitvoer skryf: eie property. self confirm. }.
	>> y := 2. { Uitvoer skryf: eie property. self confirm. } terwyl: { y trek-af: 1. <- (y > 0). }.
	{ Uitvoer skryf: eie property. self confirm. } × 1.
	(Lys ← 1) elk: {  Uitvoer skryf: eie property. self confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Woordeboek nuut one: ['item']) elk: { Uitvoer skryf: eie property. self confirm. }.
	{ 1 ÷ 0. } vang: { Uitvoer skryf: eie property. self confirm. }, begin.
	Uitvoer nuwe-reël.
}.
function by: ['confirm'] doen: { Uitvoer skryf: [',']. }.
function pas-toe: 1 en: 2.
