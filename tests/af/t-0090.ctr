Uitvoer skryf: ['1,2,3,4,5,6,7,8,9,A,'], nuwe-reël.
>> Bestek := Objek nuut.
Bestek by: ['initialize:'] doen: { :x eie eienskap := x. }.
Bestek by: ['bekragtig'] doen: { Uitvoer skryf: [',']. }.
Bestek by: ['toets'] doen: {
	Uitvoer skryf: eie eienskap.
	self bekragtig.
	( 1 = 1 ) ja: { Uitvoer skryf: eie eienskap. self bekragtig. }.
	( 1 = 0 ) nee: { Uitvoer skryf: eie eienskap. self bekragtig. }.
	>> y := 2. { Uitvoer skryf: eie eienskap. self bekragtig. } terwyl: { y trek-af: 1. <- (y > 0). }.
	{ Uitvoer skryf: eie eienskap. self bekragtig. } × 1.
	(Lys ← 1) elk: {  Uitvoer skryf: eie eienskap. self bekragtig. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo implementeer eie sortering, hierdie toets faal weens versk. aantal iterasies per platform
	(Woordeboek nuut one: ['item']) elk: { Uitvoer skryf: eie eienskap. self bekragtig. }.
	{ 1 ÷ 0. } vang: { Uitvoer skryf: eie eienskap. self bekragtig. }, begin.
	Uitvoer nuwe-reël.
}.
>> bestek1 := Bestek nuut.
bestek1 initialize: ['X'].
bestek1 toets.
>> funksieblok := { 
	eie eienskap := ['Y'].
	Uitvoer skryf: eie eienskap.
	self bekragtig.
	( 1 = 1 ) ja: { Uitvoer skryf: eie eienskap. self bekragtig. }.
	( 1 = 0 ) nee: { Uitvoer skryf: eie eienskap. self bekragtig. }.
	>> y := 2. { Uitvoer skryf: eie eienskap. self bekragtig. } terwyl: { y trek-af: 1. <- (y > 0). }.
	{ Uitvoer skryf: eie eienskap. self bekragtig. } × 1.
	(Lys ← 1) elk: {  Uitvoer skryf: eie eienskap. self bekragtig. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Woordeboek nuut one: ['item']) elk: { Uitvoer skryf: eie eienskap. self bekragtig. }.
	{ 1 ÷ 0. } vang: { Uitvoer skryf: eie eienskap. self bekragtig. }, begin.
	Uitvoer nuwe-reël.
}.
funksieblok by: ['bekragtig'] doen: { Uitvoer skryf: [',']. }.
funksieblok pas-toe: 1 en: 2.
