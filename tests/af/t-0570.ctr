#Linux

 >> t := Oomblik nuut.
 
t sone: ['Europe/Amsterdam'].
t jaar: 2020, maand: 8, dag: 2, uur: 21, minuut: 2, sekonde: 1.

>> a := t uur.
>> ams := t sone.

t sone: ['US/Hawaii'].
>> b := t uur.
>> hw := t sone.

Uitvoer
skryf: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		of: ['later'] of: ['vroeër']
	)
),
nuwe-reël.
 