Uitvoer skryf: ['Test object'], nuwe-reël.
>> a := Objek nuut. 

a by: ['item:'] doen: { :moment
	eie moment := moment. 
}.

a by: ['item'] doen: { <- eie moment.
}.

>> today := Oomblik nuut sone: ['CEST'], jaar: 2026, maand: 7.
a item: today.
Uitvoer skryf: a item, nuwe-reël.
a save-as: ['/tmp/a.bin'].

