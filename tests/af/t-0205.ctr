>> str := ['write:'].
Uitvoer boodskap: ['skryf:'] argumente: (Lys ← ['Hello World']), nuwe-reël. 

Getal by: ['isbetween:and:'] doen: { :a :b <- ((self ≥ a) en: (self ≤ b)).
}.

str := ['isbetween:and:'].
Uitvoer skryf: (3 boodskap: str argumente: (Lys ← 2 ; 8)), nuwe-reël.
Uitvoer skryf: (3 boodskap: str argumente: (Lys ← 1 ; 2)), nuwe-reël.


>> Koffiemasjien := Objek nuut.
Koffiemasjien by: ['makeCoffeeWithSugar:milk:'] doen: { :sugar :milk <- ( ['Hier is jy... koffie met '] + 
			sugar +
			[' lepels suiker en '] +
			milk +
			[' druppels melk.']
	).
}.

>> bestelling := ['makeCoffeeWithSugar:milk:'].
>> koffieKonfigurasie := Lys ← 4 ; 2.
Uitvoer skryf: ( Koffiemasjien boodskap: bestelling argumente: koffieKonfigurasie ), nuwe-reël.
