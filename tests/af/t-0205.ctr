>> str := ['write:'].
Uitvoer boodskap: ['skryf:'] argumente: (Lys ← ['Hello World']), nuwe-reël. 

Getal by: ['isbetween:and:'] doen: { :a :b <- ((self ≥ a) en: (self ≤ b)).
}.

str := ['isbetween:and:'].
Uitvoer skryf: (3 boodskap: str argumente: (Lys ← 2 ; 8)), nuwe-reël.
Uitvoer skryf: (3 boodskap: str argumente: (Lys ← 1 ; 2)), nuwe-reël.


>> CoffeeMachine := Objek nuut.
CoffeeMachine by: ['makeCoffeeWithSugar:milk:'] doen: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Lys ← 4 ; 2.
Uitvoer skryf: ( CoffeeMachine boodskap: order argumente: coffeeConfiguration ), nuwe-reël.
