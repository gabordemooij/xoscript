>> x := [' hallo '].

>> y := x hoofletters.
Uitvoer skryf: x, nuwe-reël.
Uitvoer skryf: (x gelyk: y), nuwe-reël.

>> y := x kleinletters.
Uitvoer skryf: x, nuwe-reël.
Uitvoer skryf: (x gelyk: y), nuwe-reël.

>> y := x snoei.
Uitvoer skryf: x, nuwe-reël.
Uitvoer skryf: (x gelyk: y), nuwe-reël.

>> y := x verskuiwing: 1.
Uitvoer skryf: x, nuwe-reël.
Uitvoer skryf: (x gelyk: y), nuwe-reël.

>> y := x vanaf: 1 lengte: 2.
Uitvoer skryf: x, nuwe-reël.
Uitvoer skryf: (x gelyk: y), nuwe-reël.