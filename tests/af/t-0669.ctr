# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Kluis 
	wagwoord-hutswaarde: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Kluis 
	wagwoord-hutswaarde: hash kontroleer: a1.
	# fail 
>> b := Kluis
	wagwoord-hutswaarde: hash kontroleer: a2.
	# ok!

Uitvoer skryf: a, nuwe-reël.
Uitvoer skryf: b, nuwe-reël.

