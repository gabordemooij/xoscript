# Wagwoord-hutswaardes
Server init.

# Gebruiker stel 'n wagwoord
>> wagw := ['pass123'].

# Jy stoor dit so
>> hutswaarde := Kluis 
	wagwoord-hutswaarde: wagw.

# Dan meld die gebruiker aan
# Poging 1
>> a1 := ['abcd123'].
# Poging 2
>> a2 := ['pass123'].

# Kontroleer
>> a := Kluis 
	wagwoord-hutswaarde: hutswaarde kontroleer: a1.
	# misluk 
>> b := Kluis
	wagwoord-hutswaarde: hutswaarde kontroleer: a2.
	# ok!

Uitvoer skryf: a, nuwe-reël.
Uitvoer skryf: b, nuwe-reël.

