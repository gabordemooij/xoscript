>> Animal := Objek nuut.
Animal by: ['make'] doen: {
	>> animal := Objek nuut.
	animal by: ['makeSound'] doen: {
		Uitvoer skryf: eie sound.
	}. <- animal.
}.
>> Cat := Objek nuut.
Cat by: ['make'] doen: {
	>> cat := Animal make.
	cat by: ['init'] doen: {
		eie sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
