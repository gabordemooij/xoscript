>> Slurp := Objek nuut.
Slurp by: ['nuut'] doen: {
	eie str := [''].
}.

Slurp by: ['reageer:'] doen: { :blah
		(eie str ≠ ['']) ja: {
			eie str voeg-agter: [' '].
		}.
		eie str voeg-agter: blah.
}.
Slurp by: ['reageer:en:'] doen: { :blah :blahah
		(eie str ≠ ['']) ja: {
			eie str voeg-agter: [' '].
		}.
		(blah lengte > 1) ja: {
			eie str voeg-agter: (blah vanaf: 0 lengte: (blah lengte - 1)).
		}, anders: {
			eie str voeg-agter: blah.
		}.
		eie str voeg-agter: [' '].
		eie str voeg-agter: blahah.
}.
Slurp by: ['verkry'] doen: {
	>> buffer := eie str.
	eie str := ['']. <- buffer.
}.

>> s := Slurp nuut.
s hello: ['world'].
Uitvoer skryf: ( s verkry ), nuwe-reël.
