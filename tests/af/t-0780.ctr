Server init.

# JSON-enkodeerder ondersteun slegs UTF-8, geen surrogaatpare nie

>> woordeboeke := Lys nuut ;
	# {"key":"normal"} normale ASCII
	( Woordeboek nuut sit: ['normal'] by: ['key'] ) ;
	# {"key":"hello world"} spasieteken
	( Woordeboek nuut sit: ['hello world'] by: ['key'] ) ;
	# {"key":"quote: \""} dubbele aanhalingsteken
	( Woordeboek nuut sit: ['"'] by: ['key'] ) ;
	# {"key":"backslash: \\"} truskuinstreep
	( Woordeboek nuut sit: ['backslash: \\'] by: ['key'] ) ;
	# {"key":"slash: /"} skuinstreep
	( Woordeboek nuut sit: ['slash: /'] by: ['key'] ) ;
	# {"key":"backspace: \b"} terugspasie
	( Woordeboek nuut sit: ['backspace: \b'] by: ['key'] ) ;
	# {"key":"formfeed: \f"} bladvoer-ontsnapping
	( Woordeboek nuut sit: ['formfeed: \f'] by: ['key'] ) ;
	# {"key":"newline: \n"} nuwe reël
	( Woordeboek nuut sit: ['newline: \n'] by: ['key'] ) ;
	( Woordeboek nuut sit: ['newline: ↵'] by: ['key'] ) ;
	( Woordeboek nuut sit: ['newline: 
	'] by: ['key'] ) ;
	# {"key":"carriage return: \r"} karretjie-terugkeer
	( Woordeboek nuut sit: ['carriage return: \r'] by: ['key'] ) ;
	# {"key":"tab: \t"} oortjie
	( Woordeboek nuut sit: ['tab \t'] by: ['key'] ) ;
	( Woordeboek nuut sit: ['tab ⇿'] by: ['key'] ) ;
	( Woordeboek nuut sit: ['tab  '] by: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( Woordeboek nuut sit: ['NUL \u0000'] by: ['key'] ) ;
	( Woordeboek nuut sit: ['NUL \0'] by: ['key'] ) ;
	# {"key":"control: \u0001"} beheerteken 0x01
	( Woordeboek nuut sit: ['control: \u0001'] by: ['key'] ) ;
	# {"key":"control: \u001F"} beheerteken 0x1F
	( Woordeboek nuut sit: ['control: \u001F'] by: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-greep-teken
	( Woordeboek nuut sit: ['unicode: é'] by: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-greep-teken
	( Woordeboek nuut sit: ['unicode: €'] by: ['key'] ) ;
	# {"key":"unicode: 日本語"} meerdere 3-greep-UTF-8-tekens
	( Woordeboek nuut sit: ['unicode: 日本語'] by: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-greep-teken
	( Woordeboek nuut sit: ['unicode: 😀'] by: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + nulwydte-verbinder
	( Woordeboek nuut sit: ['unicode: 🧑‍💻'] by: ['key'] ) ;
	# {"key":"combining: é"} kombinerende aksent
	( Woordeboek nuut sit: ['combining: e\u0301'] by: ['key'] ) ;
	# {"key":"escaped unicode: é"} Unicode-ontsnapping BMP
	( Woordeboek nuut sit: ['escaped unicode: \u00e9'] by: ['key'] ) ;
	# {"key":"escaped unicode: €"} Unicode-ontsnapping BMP
	( Woordeboek nuut sit: ['escaped unicode: \u20ac'] by: ['key'] ) ;
	# {"key":"escaped unicode: 😀"} UTF-16-surrogaatpaar
	( Woordeboek nuut sit: ['escaped unicode: \ud83d\ude00'] by: ['key'] ) ;
	# {"key":""} leë waarde
	( Woordeboek nuut sit: [''] by: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} spesiale ASCII-tekens
	( Woordeboek nuut sit: ['@ < > & = % + ? #'] by: ['key'] ) ;
	# {"key":"single quote: '"} enkele aanhalingsteken
	( Woordeboek nuut sit: ['''] by: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} meerdere JSON-ontsnappings
	( Woordeboek nuut sit: ['multiple: \" \\ \n \r \t'] by: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} langer ASCII-teks
	( Woordeboek nuut sit: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] by: ['key'] ) ;
	# {"key":" value"} spasie vooraan
	( Woordeboek nuut sit: [' value'] by: ['key'] ) ;
	# {"key":"value "} spasie agteraan
	( Woordeboek nuut sit: ['value '] by: ['key'] ) ;
	# {"key":" \t\n\r "} witspasie
	( Woordeboek nuut sit: [' \t\n\r '] by: ['key'] )
	.

woordeboeke elk: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (Woordeboek nuut sit: d key by: ['key']).
	>> b := JSON jsonify: (Woordeboek nuut sit: ['value'] by: d key).
	>> e := JSON objek: a.
	>> f := JSON objek: b.
	((e key = d key en: (f ? d key = ['value'])) of: (e key = ['NUL ?'])) ja: {
		Uitvoer skryf: ['OK'], nuwe-reël.
	}, anders: {
		Uitvoer skryf: ['Kan nie behoorlik enkodeer/dekodeer nie: '] + d + j, nuwe-reël.
		Program einde.
	}.
}.
