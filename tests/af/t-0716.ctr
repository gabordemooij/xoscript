Uitvoer skryf: ['Toetsobjek'], nuwe-reël.
>> a := Objek nuut. 

a by: ['state:'] doen: { :list
	eie list := list. 
}.

a by: ['toestand'] doen: {
	Uitvoer skryf: eie list, nuwe-reël.
}.

a state: ( Lys nuut ; ['lysitem'] ; ['artikel2'] ).
a toestand.

a save-as: ['/tmp/a.bin'].
Uitvoer skryf: ['========== HERLAAI SNAP:'], nuwe-reël.
>> b := Objek load-from: ['/tmp/a.bin'].
b toestand.