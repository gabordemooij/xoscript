

>> obj := Objek nuut.

obj by: ['greet'] doen: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj by: ['task'] doen: {
	eie property := 123.
	{
		# try binds self/own to object instead of block
		Uitvoer skryf: self greet.
		Uitvoer skryf: eie property.
		1 / 0.
	} vang: {
		Uitvoer skryf: self greet.
		Uitvoer skryf: eie property.
		Uitvoer skryf: ['ok'].
	}, probeer.
}.

obj task.