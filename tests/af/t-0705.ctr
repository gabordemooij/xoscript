

>> obj := Objek nuut.

obj by: ['groet'] doen: {
	<- ['haai'].
}.

# moet hi123hi123ok uitvoer
obj by: ['taak'] doen: {
	eie eienskap := 123.
	{
		# probeer bind self/eie aan objek in plaas van blok
		Uitvoer skryf: self groet.
		Uitvoer skryf: eie eienskap.
		1 / 0.
	} vang: {
		Uitvoer skryf: self groet.
		Uitvoer skryf: eie eienskap.
		Uitvoer skryf: ['ok'].
	}, probeer.
}.

obj taak.