# nakomingstoets

# gebruik internasionale getalle

Uitvoer skryf: ['1000 -> '].
Uitvoer skryf: 1000, nuwe-reël. #1000

Uitvoer skryf: ['1.5 -> '].
Uitvoer skryf: 1.5, nuwe-reël.  #1.5

Uitvoer skryf: ['1001.5 -> '].
Uitvoer skryf: 1.5 + 1000, nuwe-reël. #1001.5

# gebruik 0-geïndekseerde reekse
>> x := Lys nuut ; 1 ; 2 ; 3.
>> y := Lys nuut ; ['a'] ; ['b'] ; ['c'].

Uitvoer skryf: ['1 -> '].
Uitvoer skryf: x ? 0, nuwe-reël. #1

Uitvoer skryf: ['1 -> '].
Uitvoer skryf: (x by: 0), nuwe-reël. #1

Uitvoer skryf: ['1 -> '].
Uitvoer skryf: x eerste, nuwe-reël. #1

Uitvoer skryf: ['3 -> '].
Uitvoer skryf: x laaste, nuwe-reël. #3

Uitvoer skryf: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Uitvoer skryf: (x per: y), nuwe-reël.

Uitvoer skryf: ['1 -> '].
Uitvoer skryf: (x vanaf: 0 lengte: 1) eerste, nuwe-reël. #1

Uitvoer skryf: ['0 -> '].
Uitvoer skryf: (x vind: 1), nuwe-reël. #0

x sit: 9 by: 0.

Uitvoer skryf: ['9 -> '].
Uitvoer skryf: (x by: 0), nuwe-reël. #9

x voeg-voor: 8.
Uitvoer skryf: ['8 -> '].
Uitvoer skryf: (x by: 0), nuwe-reël. #9


x voeg-agter: 10.
Uitvoer skryf: ['10 -> '].
Uitvoer skryf: (x by: 4), nuwe-reël. #10








