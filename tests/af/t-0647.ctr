Server init.
Uitvoer skryf: ['Databasis-tydtoets'], nuwe-reël.

>> db := Maria-DB nuut gasheer: ['localhost'],
	gebruikersnaam: ['xo'], 
	wagwoord: ['pass123'],
	databasisnaam: ['xobase'],
	verbind.

>> soekparameters :=
db navraag: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
haal: { :ry
	Uitvoer skryf: ry timetest, nuwe-reël.
}.
