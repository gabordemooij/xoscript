Server init.
Uitvoer skryf: ['Database time test'], nuwe-reël.

>> db := Maria-DB nuut gasheer: ['localhost'],
	gebruikersnaam: ['xo'], 
	wagwoord: ['pass123'],
	databasisnaam: ['xobase'],
	verbind.

>> soekparameters :=
db navraag: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
haal: { :row
	Uitvoer skryf: row timetest, nuwe-reël.
}.
