>> verw := verb1 navraag: ['DELETE FROM book WHERE id > 0'].
{  verw voer-uit. verb1 bevestig. } vang: { :e verb1 rol-terug.  }, begin.

>> invoeg := verb1 navraag: ['INSERT INTO book (id) VALUES(null)'].
invoeg voer-uit.

>> tel := verb1 navraag: ['SELECT COUNT(*) AS num FROM book'].
tel haal: { :ry Uitvoer skryf: ry num, nuwe-reël. }.

