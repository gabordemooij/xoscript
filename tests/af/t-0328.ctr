Program geheuebestuur: 4.

>> Doubler := Objek nuut.
>> Multiplier := Objek nuut.
Doubler by: ['double:and:'] doen: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier by: ['multiply:and:'] doen: { :x :y <- (x × y).
}.

Uitvoer skryf: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), nuwe-reël.
