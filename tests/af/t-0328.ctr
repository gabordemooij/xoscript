Program geheuebestuur: 4.

>> Verdubbelaar := Objek nuut.
>> Vermenigvuldiger := Objek nuut.
Verdubbelaar by: ['verdubbel:en:'] doen: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Vermenigvuldiger by: ['vermenigvuldig:en:'] doen: { :x :y <- (x × y).
}.

Uitvoer skryf: (
	Verdubbelaar verdubbel:
		(Verdubbelaar verdubbel: 
			(Vermenigvuldiger vermenigvuldig: 2 en: 3)
		en:
			(Vermenigvuldiger vermenigvuldig: 3 en: 4)
		)
	en:
		(Verdubbelaar verdubbel: 
			(Vermenigvuldiger vermenigvuldig: 2 en: 3)
		en:
			(Vermenigvuldiger vermenigvuldig: 3 en: 4)
		)
), nuwe-reël.
