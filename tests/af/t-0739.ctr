Uitvoer skryf: ['Test object'], nuwe-reël.
>> a := Objek nuut. 

a by: ['item:'] doen: { :binhelper
	eie binhelper := binhelper. 
}.

a by: ['item'] doen: { <- eie binhelper.
}.

a item: Bin nuut.

>> old-binhelper-address := a item prototipe geheue-adres.
a save-as: ['/tmp/a.bin'].
Uitvoer skryf: ['========== RELOADING SNAP:'], nuwe-reël.

>> b := Objek load-from: ['/tmp/a.bin'].

(b item prototipe geheue-adres = old-binhelper-address) ja: {
	Uitvoer skryf: ['Object link re-attached.'], nuwe-reël.
}.


