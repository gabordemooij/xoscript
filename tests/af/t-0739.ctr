Uitvoer skryf: ['Toetsobjek'], nuwe-reël.
>> a := Objek nuut. 

a by: ['item:'] doen: { :binhulp
	eie binhulp := binhulp. 
}.

a by: ['artikel'] doen: {
	<- eie binhulp.
}.

a item: Bin nuut.

>> ou-binhulp-adres := a artikel prototipe geheue-adres.
a save-as: ['/tmp/a.bin'].
Uitvoer skryf: ['========== HERLAAI SNAP:'], nuwe-reël.

>> b := Objek load-from: ['/tmp/a.bin'].

(b artikel prototipe geheue-adres = ou-binhulp-adres) ja: {
	Uitvoer skryf: ['Objekskakel weer aangeheg.'], nuwe-reël.
}.


