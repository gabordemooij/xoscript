# edge cases from a request must give an error or a result, not a crash
Server init.

Uitvoer skryf: ['<'] + (['abc'] vanaf: 0 lengte: 0, hoofletters) + ['>'], nuwe-reël.
Uitvoer skryf: ['<'] + (['abc'] vanaf: 0 lengte: 0, kleinletters) + ['>'], nuwe-reël.
Uitvoer skryf: ['<'] + (['abc'] verskuiwing: 3, hoofletters) + ['>'], nuwe-reël.
Uitvoer skryf: [''] hoofletters bytes, nuwe-reël.
Uitvoer skryf: ['aB'] hoofletters, nuwe-reël.
Uitvoer skryf: ['aB'] kleinletters, nuwe-reël.

Uitvoer skryf: (Oomblik nuut: 0) jaar, nuwe-reël.
{ Oomblik nuut: ['9e300'] getal. } vang: { :e Uitvoer skryf: e, nuwe-reël. }, begin.
{ Oomblik nuut: ['-9e300'] getal. } vang: { :e Uitvoer skryf: e, nuwe-reël. }, begin.
{ Oomblik nuut: ['nan'] getal. } vang: { :e Uitvoer skryf: e, nuwe-reël. }, begin.
{ Oomblik nuut: 9000000000000000000. } vang: { :e Uitvoer skryf: e, nuwe-reël. }, begin.
