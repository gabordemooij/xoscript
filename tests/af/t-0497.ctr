Server init.

# skryf 'n toetslêer
>> f := Lêer nuut: ['/tmp/test.gif'].
f skryf: ['GIF87a01234567810'].

# bedien die lêer
Server gee-deur: ['test.gif'] voorvoegsel: ['/tmp/'].

Uitvoer nuwe-reël.

Uitvoer skryf: ['Buite houer (sekuriteit):'], nuwe-reël.
{ Server gee-deur: ['../passwd'] voorvoegsel: ['/tmp/']. }
vang: { :e Uitvoer skryf: e, nuwe-reël. },
begin.

Uitvoer skryf: ['Ongeldige voorvoegsel:'], nuwe-reël.
{ Server gee-deur: ['test.gif'] voorvoegsel: ['z:\\']. }
vang: { :e Uitvoer skryf: e, nuwe-reël. },
begin.

Uitvoer skryf: ['Nie-bestaande lêer:'], nuwe-reël.
{ Server gee-deur: ['xxx.xxx'] voorvoegsel: ['/tmp/']. }
vang: { :e Uitvoer skryf: e, nuwe-reël. },
begin.
