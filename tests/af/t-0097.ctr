
Teks by: ['html'] doen: { <- (
		self
		vervang: ['&'] met: ['&amp;'],
		vervang: ['<'] met: ['&lt;'],
		vervang: ['>'] met: ['&gt;'],
		vervang: ['"'] met: ['&quot;']
	).
}.

>> HtmlKwas := Objek nuut.

HtmlKwas by: ['reageer:'] doen: { :etiket
	Uitvoer skryf: (['<tag>↵'] tag: etiket ).
}.

HtmlKwas by: ['reageer:en:'] doen: { :etiket :content
	etiket := ( etiket vanaf: 0 lengte: (etiket lengte - 1) ).
	Uitvoer skryf: (['<tag content>↵'] tag: etiket, content: content).
}.

HtmlKwas by: ['content:'] doen: { :skrif
	Uitvoer skryf: skrif html, nuwe-reël.
}.

HtmlKwas by: ['kenm:waarde:'] doen: { :kenm :value <- ['attr="value"'] attr: kenm, value: value.
}.

>> h := HtmlKwas nuut.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h kenm: ['class'] waarde: ['bold']),
		/span
	/body
/html.
		
