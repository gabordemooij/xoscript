>> To-Do := Objek nuut.

To-Do by: ['nuut'] doen: {
	eie list := Lys nuut.
}.

To-Do by: ['nieuw'] doen: {
	eie list := Lys nuut.
}.

To-Do by: ['+'] doen: { :task
	eie list voeg-agter: task.
}.

To-Do by: ['number of tasks?'] doen: { <-  eie list tel.
}.

>> todos := 
	To-Do nuut 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Uitvoer skryf: ['You have $ tasks to do'] $ todos number of tasks?.
