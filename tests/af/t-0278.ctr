>> Te-Doen := Objek nuut.

Te-Doen by: ['nuut'] doen: {
	eie list := Lys nuut.
}.

Te-Doen by: ['nieuw'] doen: {
	eie list := Lys nuut.
}.

Te-Doen by: ['+'] doen: { :taak
	eie list voeg-agter: taak.
}.

Te-Doen by: ['number of tasks?'] doen: { <-  eie list tel.
}.

>> takies := 
	Te-Doen nuut 
	+ ['kook aandete'] 
	+ ['maak kamer skoon'].
	
Uitvoer skryf: ['You have $ tasks to do'] $ takies number of tasks?.
