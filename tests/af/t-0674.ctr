# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> pad := ['/tmp/dat.csv'].
>> csv := Lêer nuut: pad.
csv skryf: s.

# accepts CRLF LF CR, varying row length
csv skeidingsteken: [';'] aanhalingsteken: ['"'] reëls: { :line
	Program ruim-op.
	Uitvoer skryf: line, nuwe-reël.
	Program ruim-op.
}.

# unequal lines
s voeg-agter: ['\njustone'].
csv skryf: s.
{
	csv skeidingsteken: [';'] aanhalingsteken: ['"'] reëls: { :line
		Uitvoer skryf: line, nuwe-reël.
	}.
} vang: { :e 
	Uitvoer skryf: e, nuwe-reël.
}, begin.

# invalid format
s := ['"he"llo";world'].
csv skryf: s.
{
	csv skeidingsteken: [';'] aanhalingsteken: ['"'] reëls: { :line
		Uitvoer skryf: line, nuwe-reël.
	}.
} vang: { :e 
	Uitvoer skryf: e, nuwe-reël.
}, begin.
