# databasistoets
# sien voorbeeld server.xo vir die vereiste konfigurasie

Server init.
Uitvoer skryf: ['Databasistoets'], nuwe-reël.

>> db := Maria-DB nuut gasheer: ['localhost'],
	gebruikersnaam: ['xo'], wagwoord: ['pass123'], databasisnaam: ['xobase'], verbind.

Uitvoer skryf: ['Kan ons verbind? '] + db verbind?, nuwe-reël.

>> soekparameters := db navraag: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parameters: ( Lys nuut ; ['abc'] ; 12.35 ; 6 ). # geparametriseerde navrae

{  soekparameters voer-uit. db bevestig. } vang: { :e db rol-terug.  }, begin.

Uitvoer skryf: ['Kan ons invoeg? '] + ( soekparameters insert-id > 0 ), nuwe-reël.

>> Obj := Objek nuut.
Obj by: ['haal-rye-op'] doen: {
	eie tel := 0.
	>> soekparameters :=
	db navraag: ['SELECT * FROM book order by id desc limit 2'], 
	haal: { :ry 
		eie tel tel-by: 1.
		Ja onderbreek.
	}. # rekords haal
	<- eie tel kopieer.
}.

Uitvoer skryf: ['Kan ons navraag doen? '] + ( Obj haal-rye-op > 0 ), nuwe-reël.
