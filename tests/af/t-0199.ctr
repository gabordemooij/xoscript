
Program geheuebestuur: 4.

>> Dier := Objek nuut.
Dier by: ['maak'] doen: {
	>> dier := Objek nuut.
	dier by: ['maakGeluid'] doen: {
		Uitvoer skryf: eie geluid.
	}. <- dier.
}.
>> Kat := Objek nuut.
Kat by: ['maak'] doen: {
	>> kat := Dier maak.
	kat by: ['init'] doen: {
		eie geluid := ['meow!'].
	}.
	kat init. <- kat.
}.
>> tom := Kat maak.
tom maakGeluid.
