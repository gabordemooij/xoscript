

Lys by: ['sum'] doen: {
	>> total := 0.
	self elk: { :index :element
		total tel-by: element.
	}. <- total.
}.

Lys by: ['product'] doen: {
	>> total := 1.
	self elk: { :index :element
		total vermenigvuldig-met: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program geheuebestuur: 0.

{

>> a := Lys ← ['hello'] ; ['world'] ; Ja ; Niks ; 666.
a := a + ( Lys ← 1 ).
Uitvoer skryf: ( ['sum: '] + ( a sum ) ), nuwe-reël.
Uitvoer skryf: ( ['min: '] + ( a minimum ) ), nuwe-reël.
Uitvoer skryf: ( ['max: '] + ( a maksimum ) ), nuwe-reël.
Uitvoer skryf: ( ['3rd: '] + ( a ? 2 ) ), nuwe-reël.
Uitvoer skryf: ( ['prd: '] + ( a product ) ), nuwe-reël.
a sorteer: { :a :b <- (b - a). }.
a elk: { :i :e Uitvoer skryf: ( i - 0 ), nuwe-reël. }.

} begin.

Program ruim-op.
usedMemory1 := (Program geheue ? 0).


