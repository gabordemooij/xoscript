

Lys by: ['som'] doen: {
	>> totaal := 0.
	self elk: { :indeks :element
		totaal tel-by: element.
	}. <- totaal.
}.

Lys by: ['produk'] doen: {
	>> totaal := 1.
	self elk: { :indeks :element
		totaal vermenigvuldig-met: element.
	}. <- totaal.
}.

>> gebruikteGeheue1 := 0.
>> gebruikteGeheue2 := 0.
>> gebruikteGeheue3 := 0.
>> gebruikteGeheue4 := 0.

Program geheuebestuur: 0.

{

>> a := Lys ← ['hello'] ; ['world'] ; Ja ; Niks ; 666.
a := a + ( Lys ← 1 ).
Uitvoer skryf: ( ['som: '] + ( a som ) ), nuwe-reël.
Uitvoer skryf: ( ['min: '] + ( a minimum ) ), nuwe-reël.
Uitvoer skryf: ( ['maks: '] + ( a maksimum ) ), nuwe-reël.
Uitvoer skryf: ( ['3de: '] + ( a ? 2 ) ), nuwe-reël.
Uitvoer skryf: ( ['prd: '] + ( a produk ) ), nuwe-reël.
a sorteer: { :a :b <- (b - a). }.
a elk: { :i :e Uitvoer skryf: ( i - 0 ), nuwe-reël. }.

} begin.

Program ruim-op.
gebruikteGeheue1 := (Program geheue ? 0).


{

>> a := Lys ← ['hello'] ; ['world'] ; Ja ; Niks ; 666.
a := a + ( Lys ← 1 ).
Uitvoer skryf: ( ['som: '] + ( a som ) ), nuwe-reël.
Uitvoer skryf: ( ['min: '] + ( a minimum ) ), nuwe-reël.
Uitvoer skryf: ( ['maks: '] + ( a maksimum ) ), nuwe-reël.
Uitvoer skryf: ( ['3de: '] + ( a ? 2 ) ), nuwe-reël.
Uitvoer skryf: ( ['prd: '] + ( a produk ) ), nuwe-reël.
a sorteer: { :a :b <- (b - a). }.
a elk: { :i :e Uitvoer skryf: ( i - 0 ), nuwe-reël. }.

} begin.



Program ruim-op.
gebruikteGeheue2 := (Program geheue ? 0).


{

>> a := Lys ← ['hello'] ; ['world'] ; Ja ; Niks ; 666.
a := a + ( Lys ← 1 ).
Uitvoer skryf: ( ['som: '] + ( a som ) ), nuwe-reël.
Uitvoer skryf: ( ['min: '] + ( a minimum ) ), nuwe-reël.
Uitvoer skryf: ( ['maks: '] + ( a maksimum ) ), nuwe-reël.
Uitvoer skryf: ( ['3de: '] + ( a ? 2 ) ), nuwe-reël.
Uitvoer skryf: ( ['prd: '] + ( a produk ) ), nuwe-reël.
a sorteer: { :a :b <- (b - a). }.
a elk: { :i :e Uitvoer skryf: ( i - 0 ), nuwe-reël. }.

