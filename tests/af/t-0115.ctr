{
	hierdie-taak fout: ['Dont fail.'].
	unknown doSomething.
} vang: {
	Uitvoer skryf: ['Caught!'].
}, begin.

{
	hierdie-taak fout: ['Dont fail.'].
	eie unknown doSomething.
} vang: {
	Uitvoer skryf: ['Caught!'].
}, begin.

{
	hierdie-taak fout: ['Dont fail.'].
	unknown := 122.
} vang: {
	Uitvoer skryf: ['Caught!'].
}, begin.


{
	hierdie-taak fout: ['Dont fail.'].
	Ja onderbreek.
	Uitvoer skryf: ['FAIL'].
} vang: {
	Uitvoer skryf: ['Caught!'].
}, begin.

{
	{
		hierdie-taak fout: ['Dont fail.'].
		Ja onderbreek.
		Uitvoer skryf: ['FAIL'].
	} vang: { :x
		(x = ['Dont fail.']) ja: { hierdie-taak fout: ['Nested Caught!']. }.
	}, begin.
} vang: { :e
	Uitvoer skryf: e.
}, begin.
