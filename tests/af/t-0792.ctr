Server init.

>> DB := Maria-DB nuut gasheer: ['localhost'],
	gebruikersnaam: ['xo'],
	wagwoord: ['pass123'],
	databasisnaam: ['xobase'],
	verbind.
	
>> SQL := ['SELECT "hello" AS "world" '].

# 'n vinniger manier, kry navraag uit DB:
>> navraag2 := DB navraag: SQL.

# nou hoef jy nie DB te stel nie
navraag2 haal: { :ry
	Uitvoer skryf: ry world, nuwe-reël.
}.
