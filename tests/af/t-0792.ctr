Server init.

>> DB := Maria-DB nuut gasheer: ['localhost'],
	gebruikersnaam: ['xo'],
	wagwoord: ['pass123'],
	databasisnaam: ['xobase'],
	verbind.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB navraag: SQL.

# now you don't have to set DB
query2 haal: { :row
	Uitvoer skryf: row world, nuwe-reël.
}.
