

Lys by: ['column:'] doen: { :column
	>> result := Lys nuut.
	self elk: { :index :row
		row elk: { :index :cell
			(index = column) ja: { result voeg-agter: cell. }.
		}.
	}. <- result.
}.


>> a := Lys ←
	(Lys ← 1 ; 2 ; 3) ;
	(Lys ← 4 ; 5 ; 6) ;
	(Lys ← 7 ; 8 ; 9).

>> b := a column: 1.
Uitvoer skryf: b, nuwe-reël.

b := a column: 20.
Uitvoer skryf: b, nuwe-reël.

b := a column: -100.
Uitvoer skryf: b, nuwe-reël.
