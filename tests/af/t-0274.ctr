

Lys by: ['column:'] doen: { :kolom
	>> resultaat := Lys nuut.
	self elk: { :indeks :ry
		ry elk: { :indeks :sel
			(indeks = kolom) ja: { resultaat voeg-agter: sel. }.
		}.
	}. <- resultaat.
}.


>> a := Lys ←
	(Lys ← 1 ; 2 ; 3) ;
	(Lys ← 4 ; 5 ; 6) ;
	(Lys ← 7 ; 8 ; 9).

>> b := a column: 1.
Uitvoer skryf: b, nuwe-reël.

b := a column: 20.
Uitvoer skryf: b, nuwe-reël.

b := a column: -100.
Uitvoer skryf: b, nuwe-reël.
