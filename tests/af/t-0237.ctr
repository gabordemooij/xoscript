
Teks by: ['evalueer'] doen: {
	>> kode := Lêer nuut: ['/tmp/eval.ctr'].
	kode skryf: (self teks + ['.']).
	Program gebruik: ['/tmp/eval.ctr'].
}.

>> map :=
	(Woordeboek nuut)
	sit: ['Haai Daar'] by: ['two'],
	sit: (Lys ← ['hello'] ; ['world'] ; (Lys ← 1 ; 2; 9) ; Nee) by: ['een'],
	sit: ( (Woordeboek nuut) sit: ['wêrrld'] by: ['verkeerdgespel'] ) by: ['three'],
	sit: (Lys ← ((Woordeboek nuut) sit: ['skat'] by: ['versteek']) ; 2) by: ['vier']. 
>> str := map teks.
>> map2 := Niks.
(['map2 := '] + str ) evalueer.
Uitvoer skryf: map2 ? ['een'] ? 0.
Uitvoer skryf: map2 ? ['een'] ? 1.
Uitvoer skryf: map2 ? ['vier'] ? 0 ? ['versteek'].
Uitvoer skryf: map2 ? ['een'] ? 2 ? 2.
