
Teks by: ['evaluate'] doen: {
	>> kode := Lêer nuut: ['/tmp/eval.ctr'].
	kode skryf: (self teks + ['.']).
	Program gebruik: ['/tmp/eval.ctr'].
}.

>> map :=
	(Woordeboek nuut)
	sit: ['Hi There'] by: ['two'],
	sit: (Lys ← ['hello'] ; ['world'] ; (Lys ← 1 ; 2; 9) ; Nee) by: ['one'],
	sit: ( (Woordeboek nuut) sit: ['wrrld'] by: ['misspelled'] ) by: ['three'],
	sit: (Lys ← ((Woordeboek nuut) sit: ['treasure'] by: ['hidden']) ; 2) by: ['four']. 
>> str := map teks.
>> map2 := Niks.
(['map2 := '] + str ) evaluate.
Uitvoer skryf: map2 ? ['one'] ? 0.
Uitvoer skryf: map2 ? ['one'] ? 1.
Uitvoer skryf: map2 ? ['four'] ? 0 ? ['hidden'].
Uitvoer skryf: map2 ? ['one'] ? 2 ? 2.
