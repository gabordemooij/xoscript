
Server init.
Uitvoer skryf: ['Database test'], nuwe-reël.

>> db := Maria-DB nuut gasheer: ['localhost'],
	gebruikersnaam: ['xo'], 
	wagwoord: ['pass123'],
	databasisnaam: ['xobase'],
	verbind.

>> soekparameters :=
db navraag: ['SELECT UNHEX('CAFE') AS blobby'],
haal: { :row
	Uitvoer skryf: ( row blobby vanaf: 0 lengte: 2 ), nuwe-reël.
	row blobby stel-vry.
}.
