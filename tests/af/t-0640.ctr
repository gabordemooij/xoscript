
Server init.
Uitvoer skryf: ['Databasistoets'], nuwe-reël.

>> db := Maria-DB nuut gasheer: ['localhost'],
	gebruikersnaam: ['xo'], 
	wagwoord: ['pass123'],
	databasisnaam: ['xobase'],
	verbind.

>> soekparameters :=
db navraag: ['SELECT UNHEX('CAFE') AS blobby'],
haal: { :ry
	Uitvoer skryf: ( ry blobby vanaf: 0 lengte: 2 ), nuwe-reël.
	ry blobby stel-vry.
}.
