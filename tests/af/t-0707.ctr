# toets tipe-omskakelings / omsettings / bindings
Program geheuebestuur: 4.
Server init.

>> teller := 0.
>> db := Maria-DB nuut gasheer: ['localhost'],
	gebruikersnaam: ['xo'], wagwoord: ['pass123'], databasisnaam: ['xobase'], verbind.

>> TweeSyferFormaat := Formaat nuut: ['%02d'].

# Datumtyd
{
	>> jaar     := Getal tussen: 1995 en: 2050, teks.
	>> maand    := TweeSyferFormaat pas-toe-heelgetal: (Getal tussen: 1 en: 12), teks.
	>> dag      := TweeSyferFormaat pas-toe-heelgetal: (Getal tussen: 1 en: 28), teks.
	>> uur     := TweeSyferFormaat pas-toe-heelgetal: (Getal tussen: 1 en: 23), teks.
	>> minuut   := TweeSyferFormaat pas-toe-heelgetal: (Getal tussen: 1 en: 59), teks.
	>> sekonde   := TweeSyferFormaat pas-toe-heelgetal: (Getal tussen: 1 en: 59), teks.
	>> datumtyd := ['YYYY-MM-DD HH:II:SS'].	
	datumtyd
		YYYY: jaar,
		MM: maand,
		DD: dag,
		HH: uur,
		II: minuut,
		SS: sekonde.
	>> soekparameters :=
	db navraag: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: datumtyd),
	haal: { :ry
		(ry mydatetime = datumtyd) nee: {
			hierdie-taak fout: (
				['Verwag: <expected> maar gekry: <observation>']
				<expected>: datumtyd,
				<observation>: ry mydatetime
			).
		}.
	
	}.
	teller tel-by: 1.
} * 100.

# Datum
{
	>> jaar     := Getal tussen: 1995 en: 2050, teks.
	>> maand    := TweeSyferFormaat pas-toe-heelgetal: (Getal tussen: 1 en: 12), teks.
	>> dag      := TweeSyferFormaat pas-toe-heelgetal: (Getal tussen: 1 en: 28), teks.
	>> datum     := ['YYYY-MM-DD'].
	datum
		YYYY: jaar,
		MM: maand,
		DD: dag.
	>> soekparameters :=
	db navraag: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: datum),
	haal: { :ry
		(ry mydate = datum) nee: {
			hierdie-taak fout: (
				['Verwag: <expected> maar gekry: <observation>']
				<expected>: datum,
				<observation>: ry mydate
			).
		}.
	}.
	teller tel-by: 1.
} * 100.


# Tyd
{
	>> uur     := TweeSyferFormaat pas-toe-heelgetal: (Getal tussen: 1 en: 23), teks.
	>> minuut   := TweeSyferFormaat pas-toe-heelgetal: (Getal tussen: 1 en: 59), teks.
	>> sekonde   := TweeSyferFormaat pas-toe-heelgetal: (Getal tussen: 1 en: 59), teks.
	>> tyd := ['HH:II:SS'].
	tyd
		HH: uur,
		II: minuut,
		SS: sekonde.
	>> soekparameters :=
	db navraag: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: tyd),
	haal: { :ry
		(ry mytime = tyd) nee: {
			hierdie-taak fout: (
				['Verwag: <expected> maar gekry: <observation>']
				<expected>: datumtyd,
				<observation>: ry mytime
			).
		}.
	}.
	teller tel-by: 1.
} * 100.


# Teks (varchar/text)
>> str1 := Lys nuut vul: 100000 met: ['x'], voeg-saam: [''].
{
	>> str2 := Kluis token: 40.
	>> soekparameters :=
	db navraag: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	haal: { :ry
		(ry str1 = str1 en: ry str2 = str2) nee: {
			hierdie-taak fout: (
				['Verwag: <expected> maar gekry: <observation>']
				<expected>: datumtyd,
				<observation>: ry mytime
			).
		}.
	}.
	teller tel-by: 1.
} * 100.


# Getalle
{
	>> n1  := Getal tussen: 1 en: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 vanuit-teks: ['9223372036854775807'] ) -
		( Int64 vanuit-teks: ['99999'] ) +
		( Int64 vanuit-teks: n1 teks )
	).
	>> soekparameters :=
	db navraag: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	haal: { :ry
		(ry n1 = n1) nee: {
			hierdie-taak fout: (
				['Verwag: <expected> maar gekry: <observation>']
				<expected>: n1,
				<observation>: ry n1
			).
		}.
		(ry n2 = n2) nee: {
			hierdie-taak fout: (
				['Verwag: <expected> maar gekry: <observation>']
				<expected>: n1,
				<observation>: ry n2
			).
		}.
		(ry n3 = n2 afgerond) nee: {
			hierdie-taak fout: (
				['Verwag: <expected> maar gekry: <observation>']
				<expected>: n1,
				<observation>: ry n3
			).
		}.
		(ry big = big) nee: {
			hierdie-taak fout: (
				['Verwag: <expected> maar gekry: <observation>']
				<expected>: big,
				<observation>: ry big
			).
		}.
		
	}.
	teller tel-by: 1.
} * 100.


Uitvoer skryf: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: teller
), nuwe-reël.