# test qualifiers

>> $ := Objek nuut.

$ by: ['reageer:'] doen: { :x
	
	>> operation := x letter: 0.
	>> valuta := x letter: 1.
	>> money := x verskuiwing: 2.
	
	>> amount := 0.

	( operation = ['+'] ) ja: {
		( valuta = ['£'] ) ja: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Uitvoer skryf: x, nuwe-reël.


>> Fruit := Objek nuut.

Fruit by: ['nuut'] doen: {
	>> f := self nuut.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit by: ['apples:'] doen: { :a eie apples := a. }.
Fruit by: ['oranges:'] doen: { :p eie oranges := p. }.
Fruit by: ['apples'] doen: { <- eie apples. }.
Fruit by: ['oranges'] doen: { <- eie oranges. }.

Fruit by: ['+'] doen: { :f
	
	>> n := Fruit nuut.
	f tel-by: 1.
	
	n apples: (f apples + eie apples).
	n oranges:  (f oranges  + eie oranges). <- n.
}.

Fruit by: ['teks'] doen: { <- ( eie apples teks + [' apples and '] + eie oranges + [' oranges'] ).
}.

Getal by: ['apples'] doen: { <- ((Fruit nuut) apples: self).
}.

Getal by: ['apple'] doen: { <- ((Fruit nuut) apples: self).
}.

Getal by: ['oranges'] doen: { <- ((Fruit nuut) oranges: self).
}.




Uitvoer skryf: (1 apple + 3 oranges + 4 apples), nuwe-reël.


Teks by: ['twice'] doen: { <- ((self teks) + (self teks)).
}.



Uitvoer skryf: ['❤❤❤'] twice.



