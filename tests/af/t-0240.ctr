# toets kwalifiseerders

>> $ := Objek nuut.

$ by: ['reageer:'] doen: { :x
	
	>> bewerking := x letter: 0.
	>> valuta := x letter: 1.
	>> geld := x verskuiwing: 2.
	
	>> bedrag := 0.

	( bewerking = ['+'] ) ja: {
		( valuta = ['£'] ) ja: { bedrag := 1.28 × geld. }.
	}. <- bedrag.
}.



>> x := $ +£20.

Uitvoer skryf: x, nuwe-reël.


>> Vrug := Objek nuut.

Vrug by: ['nuut'] doen: {
	>> f := self nuut.
	f apples: 0.
	f oranges: 0. <- f.
}.

Vrug by: ['apples:'] doen: { :a eie appels := a. }.
Vrug by: ['oranges:'] doen: { :p eie lemoene := p. }.
Vrug by: ['appels'] doen: { <- eie appels. }.
Vrug by: ['lemoene'] doen: { <- eie lemoene. }.

Vrug by: ['+'] doen: { :f
	
	>> n := Vrug nuut.
	f tel-by: 1.
	
	n apples: (f appels + eie appels).
	n oranges:  (f lemoene  + eie lemoene). <- n.
}.

Vrug by: ['teks'] doen: { <- ( eie appels teks + [' appels en '] + eie lemoene + [' lemoene'] ).
}.

Getal by: ['appels'] doen: { <- ((Vrug nuut) apples: self).
}.

Getal by: ['apple'] doen: { <- ((Vrug nuut) apples: self).
}.

Getal by: ['lemoene'] doen: { <- ((Vrug nuut) oranges: self).
}.




Uitvoer skryf: (1 apple + 3 lemoene + 4 appels), nuwe-reël.


Teks by: ['tweekeer'] doen: { <- ((self teks) + (self teks)).
}.



Uitvoer skryf: ['❤❤❤'] tweekeer.



