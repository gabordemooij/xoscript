# test catch-all methods
>> x13 := Objek nuut.
x13 by: ['a'] doen: { :a Uitvoer skryf: 0, nuwe-reël. }.
x13 by: ['a:'] doen: { :a Uitvoer skryf: a, nuwe-reël. <- 5. }.
x13 by: ['a:b:'] doen: { :a :b Uitvoer skryf: (a + b), nuwe-reël. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
