>> phrases := Lys nuut
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases elk: { :_ :phrase 
	>> e := Server base64-kodeer: phrase.
	>> d := Server base64-dekodeer: e.
	Uitvoer skryf: (
		message kopieer ~encoded: e, ~decoded: d
	), nuwe-reël.
}.
