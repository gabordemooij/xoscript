>> frases := Lys nuut
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> boodskap := ['Phrase: ~decoded base64: ~encoded'].
	
frases elk: { :_ :frase 
	>> e := Server base64-kodeer: frase.
	>> d := Server base64-dekodeer: e.
	Uitvoer skryf: (
		boodskap kopieer ~encoded: e, ~decoded: d
	), nuwe-reël.
}.
