
>> Rectangle := Objek nuut.

Rectangle by: ['area'] doen: { <- eie lengte * eie width.
}.

Rectangle by: ['length:'] doen: { :lengte
	eie lengte := lengte.
}.

Rectangle by: ['width:'] doen: { :width
	eie width := width.
}.

Rectangle by: ['nuut'] doen: {
	# this will not result into an infinite loop
	>> rectangle := self nuut.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle nuut.
Uitvoer skryf: a area, nuwe-reël. #0

>> b := Rectangle nuut length: 2, width: 3.
Uitvoer skryf: b area, nuwe-reël. #6

