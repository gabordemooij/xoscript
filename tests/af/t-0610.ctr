
>> Reghoek := Objek nuut.

Reghoek by: ['oppervlakte'] doen: {
	<- eie lengte * eie breedte.
}.

Reghoek by: ['length:'] doen: { :lengte
	eie lengte := lengte.
}.

Reghoek by: ['width:'] doen: { :breedte
	eie breedte := breedte.
}.

Reghoek by: ['nuut'] doen: {
	# dit sal nie tot 'n oneindige lus lei nie
	>> reghoek := self nuut.
	reghoek length: 0, width: 0.
	<- reghoek.
}.

>> a := Reghoek nuut.
Uitvoer skryf: a oppervlakte, nuwe-reël. #0

>> b := Reghoek nuut length: 2, width: 3.
Uitvoer skryf: b oppervlakte, nuwe-reël. #6

