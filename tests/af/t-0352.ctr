Getal by: ['roman'] doen: {
	>> getal := self kopieer.
	>> roman := [''].
	{
		{
			(getal ≥ 1000) ja: {
				roman voeg-agter: ['Ⅿ'].
				getal trek-af: 1000.
			}, onderbreek.
		
			(getal ≥ 500) ja: {
				roman voeg-agter: ['Ⅾ'].
				getal trek-af: 500.
			}, onderbreek.
		
			(getal ≥ 100) ja: {
				roman voeg-agter: ['Ⅽ'].
				getal trek-af: 100.
			}, onderbreek.
		
			(getal ≥ 50) ja: {
				roman voeg-agter: ['Ⅼ'].
				getal trek-af: 50.
			}, onderbreek.
		
			(getal ≥ 50) ja: {
				roman voeg-agter: ['Ⅼ'].
				getal trek-af: 50.
			}, onderbreek.
		
			(getal ≥ 10) ja: {
				roman voeg-agter: ['Ⅹ'].
				getal trek-af: 10.
			}, onderbreek.
			
			(getal ≥ 9) ja: {
				roman voeg-agter: ['Ⅸ'].
				getal trek-af: 9.
			}, onderbreek.
			
			(getal ≥ 5) ja: {
				roman voeg-agter: ['Ⅴ'].
				getal trek-af: 5.
			}, onderbreek.
			
			(getal ≥ 4) ja: {
				roman voeg-agter: ['Ⅳ'].
				getal trek-af: 4.
			}, onderbreek.
			
			(getal ≥ 1) ja: {
				roman voeg-agter: ['Ⅰ'].
				getal trek-af: 1.
			}, onderbreek.
		} prosedure.
	} terwyl: { <- getal > 0. }. <- roman.
}.

Uitvoer skryf: 1 roman, nuwe-reël.
Uitvoer skryf: 2 roman, nuwe-reël.
Uitvoer skryf: 4 roman, nuwe-reël.
Uitvoer skryf: 8 roman, nuwe-reël.
Uitvoer skryf: 16 roman, nuwe-reël.
Uitvoer skryf: 32 roman, nuwe-reël.
Uitvoer skryf: 64 roman, nuwe-reël.
Uitvoer skryf: 128 roman, nuwe-reël.
Uitvoer skryf: 256 roman, nuwe-reël.
Uitvoer skryf: 1024 roman, nuwe-reël.
