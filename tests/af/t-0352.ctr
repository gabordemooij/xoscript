Getal by: ['romeins'] doen: {
	>> getal := self kopieer.
	>> romeins := [''].
	{
		{
			(getal ≥ 1000) ja: {
				romeins voeg-agter: ['Ⅿ'].
				getal trek-af: 1000.
			}, onderbreek.
		
			(getal ≥ 500) ja: {
				romeins voeg-agter: ['Ⅾ'].
				getal trek-af: 500.
			}, onderbreek.
		
			(getal ≥ 100) ja: {
				romeins voeg-agter: ['Ⅽ'].
				getal trek-af: 100.
			}, onderbreek.
		
			(getal ≥ 50) ja: {
				romeins voeg-agter: ['Ⅼ'].
				getal trek-af: 50.
			}, onderbreek.
		
			(getal ≥ 50) ja: {
				romeins voeg-agter: ['Ⅼ'].
				getal trek-af: 50.
			}, onderbreek.
		
			(getal ≥ 10) ja: {
				romeins voeg-agter: ['Ⅹ'].
				getal trek-af: 10.
			}, onderbreek.
			
			(getal ≥ 9) ja: {
				romeins voeg-agter: ['Ⅸ'].
				getal trek-af: 9.
			}, onderbreek.
			
			(getal ≥ 5) ja: {
				romeins voeg-agter: ['Ⅴ'].
				getal trek-af: 5.
			}, onderbreek.
			
			(getal ≥ 4) ja: {
				romeins voeg-agter: ['Ⅳ'].
				getal trek-af: 4.
			}, onderbreek.
			
			(getal ≥ 1) ja: {
				romeins voeg-agter: ['Ⅰ'].
				getal trek-af: 1.
			}, onderbreek.
		} prosedure.
	} terwyl: { <- getal > 0. }. <- romeins.
}.

Uitvoer skryf: 1 romeins, nuwe-reël.
Uitvoer skryf: 2 romeins, nuwe-reël.
Uitvoer skryf: 4 romeins, nuwe-reël.
