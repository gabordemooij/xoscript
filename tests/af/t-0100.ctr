Teks by: ['html'] doen: { <- (
		self
		vervang: ['&'] met: ['&amp;'],
		vervang: ['<'] met: ['&lt;'],
		vervang: ['>'] met: ['&gt;'],
		vervang: ['"'] met: ['&quot;']
	).
}.

>> list := Lys nuut.

['Verbatim Syntax'] letters elk: { :getal :letter
	list ; ((['<li>#Number:Letter</li>']) Number: (getal), Letter: letter).
}.

Uitvoer list.





>> template := ['
<html>
<body>
<p>Hello this is a test!</p>
<p>The string \‘Verbatim Syntax\’ has: 15 code points...</p>
<ul>
[list]
</ul>
</body> 
</html>
'] [list]: (list voeg-saam: ['↵']).

Uitvoer skryf: template.

