



>> CoffeeGrounds := Objek nuut.
CoffeeGrounds by: ['extract'] doen: { <- ['coffee']. }.

>> CoffeeMachine := Objek nuut.
CoffeeMachine by: ['init'] doen: {
	eie coffeegrounds := CoffeeGrounds nuut.
}.
CoffeeMachine by: ['nuut'] doen: { <- CoffeeMachine `new init.
}.

CoffeeMachine by: ['makeTea'] doen: { <- (eie tealeaves extract). }.
CoffeeMachine by: ['makeCoffee'] doen: { <- (eie coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine nuut.

Uitvoer skryf:
	coffeeDream 
	makeCoffee.

Uitvoer skryf:
	coffeeDream 
	makeTea.
