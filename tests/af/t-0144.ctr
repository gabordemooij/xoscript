



>> Koffiemoer := Objek nuut.
Koffiemoer by: ['onttrek'] doen: { <- ['coffee']. }.

>> Koffiemasjien := Objek nuut.
Koffiemasjien by: ['init'] doen: {
	eie koffiemoer := Koffiemoer nuut.
}.
Koffiemasjien by: ['nuut'] doen: { <- Koffiemasjien `new init.
}.

Koffiemasjien by: ['maakTee'] doen: { <- (eie teeblare onttrek). }.
Koffiemasjien by: ['maakKoffie'] doen: { <- (eie koffiemoer onttrek). }.

>> koffieDroom := Koffiemasjien nuut.

Uitvoer skryf:
	koffieDroom 
	maakKoffie.

Uitvoer skryf:
	koffieDroom 
	maakTee.
