
>> countries := Lys nuut
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Lys nuut
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods per: countries, elk: { :key :value
	counter tel-by: 1.
}.

Uitvoer skryf: (['we serve counter dishes'] counter: counter), nuwe-reël.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] letters sorteer: { :v
	counter tel-by: 0.
}.

Uitvoer skryf: (['we sort counter dishes'] counter: counter), nuwe-reël.


>> counter := 0.
{
	{
		counter tel-by: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Uitvoer skryf: (['we calculate counter numbers.'] counter: counter), nuwe-reël.

