
>> lande := Lys nuut
	~ ['Switserland']
	~ ['Italië']
	~ ['Duitsland'].

>> kosse := Lys nuut
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Suurkool'].


>> teller := 0.
kosse per: lande, elk: { :key :value
	teller tel-by: 1.
}.

Uitvoer skryf: (['we serve counter dishes'] counter: teller), nuwe-reël.

>> teller := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] letters sorteer: { :v
	teller tel-by: 0.
}.

Uitvoer skryf: (['we sort counter dishes'] counter: teller), nuwe-reël.


>> teller := 0.
{
	{
		teller tel-by: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Uitvoer skryf: (['we calculate counter numbers.'] counter: teller), nuwe-reël.

