Getal by: ['fakulteit'] doen: {
	>> totaal := 1.
	{ :indeks totaal vermenigvuldig-met: (self - indeks). } × self. <- totaal.
}.

>> gebruikteGeheue1 := 0.
>> gebruikteGeheue2 := 0.
>> gebruikteGeheue3 := 0.
>> gebruikteGeheue4 := 0.

Program geheuebestuur: 0.

{
2 eksponent fakulteit.
Uitvoer skryf: (11 modulo: 3), nuwe-reël.
Uitvoer skryf: (3.4 afgerond), nuwe-reël.
Uitvoer skryf: (7.1 rond-op), nuwe-reël.
Uitvoer skryf: (7.9 rond-af), nuwe-reël.
}
begin.

Program ruim-op.

gebruikteGeheue1 := (Program geheue ? 0).

{
2 eksponent fakulteit.
Uitvoer skryf: (11 modulo: 3), nuwe-reël.
Uitvoer skryf: (3.4 afgerond), nuwe-reël.
Uitvoer skryf: (7.1 rond-op), nuwe-reël.
Uitvoer skryf: (7.9 rond-af), nuwe-reël.
}
begin.

Program ruim-op.
gebruikteGeheue2 := (Program geheue ? 0).


{
2 eksponent fakulteit.
Uitvoer skryf: (11 modulo: 3), nuwe-reël.
Uitvoer skryf: (3.4 afgerond), nuwe-reël.
Uitvoer skryf: (7.1 rond-op), nuwe-reël.
Uitvoer skryf: (7.9 rond-af), nuwe-reël.
} begin.

Program ruim-op.
gebruikteGeheue3 := (Program geheue ? 0).



( gebruikteGeheue1 = gebruikteGeheue2 en: gebruikteGeheue1 = gebruikteGeheue3, en: gebruikteGeheue2 = gebruikteGeheue3 ) ja: {
	Uitvoer skryf: ['Geen geheuelekke hier nie'].
}, nee: {
	Uitvoer skryf: ['Geheue lek...'].
}.
