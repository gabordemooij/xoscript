Getal by: ['factorial'] doen: {
	>> total := 1.
	{ :index total vermenigvuldig-met: (self - index). } × self. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program geheuebestuur: 0.

{
2 exponent factorial.
Uitvoer skryf: (11 modulo: 3), nuwe-reël.
Uitvoer skryf: (3.4 afgerond), nuwe-reël.
Uitvoer skryf: (7.1 rond-op), nuwe-reël.
Uitvoer skryf: (7.9 rond-af), nuwe-reël.
}
begin.

Program ruim-op.

usedMemory1 := (Program geheue ? 0).

{
2 exponent factorial.
Uitvoer skryf: (11 modulo: 3), nuwe-reël.
Uitvoer skryf: (3.4 afgerond), nuwe-reël.
Uitvoer skryf: (7.1 rond-op), nuwe-reël.
Uitvoer skryf: (7.9 rond-af), nuwe-reël.
}
begin.

Program ruim-op.
usedMemory2 := (Program geheue ? 0).


{
2 exponent factorial.
Uitvoer skryf: (11 modulo: 3), nuwe-reël.
Uitvoer skryf: (3.4 afgerond), nuwe-reël.
Uitvoer skryf: (7.1 rond-op), nuwe-reël.
Uitvoer skryf: (7.9 rond-af), nuwe-reël.
} begin.

Program ruim-op.
usedMemory3 := (Program geheue ? 0).



( usedMemory1 = usedMemory2 en: usedMemory1 = usedMemory3, en: usedMemory2 = usedMemory3 ) ja: {
	Uitvoer skryf: ['No memory leaks here'].
}, nee: {
	Uitvoer skryf: ['Leaking memory...'].
}.
