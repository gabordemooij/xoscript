
>> a := Lys ← (Lys ← 100 ; 200 ; 300) ; (Lys ← 9 ; 8 ; 7).
Uitvoer skryf: ['by 0,1 :'].
Uitvoer skryf: a ? 0 ? 1, nuwe-reël. 
Uitvoer skryf: ['by 1,2 :'].
Uitvoer skryf: a ? 1 ? 2, nuwe-reël. 
>> spyskaart := Woordeboek nuut.
spyskaart sit: (Lys ← ['pizza'] ; ['spaghetti']) by: ['Italiaanse Kookkuns'].
spyskaart sit: (Lys ← ['bifteki'] ; ['suflaki']) by: ['Griekse Kookkuns'].
Uitvoer skryf: ['Ek hou van '] + (spyskaart ? ['Griekse Kookkuns'] ? 0) + [' en '] + (spyskaart ? ['Italiaanse Kookkuns'] ? 1), nuwe-reël. 
Uitvoer skryf: ['maar nie op dieselfde bord nie.'], nuwe-reël.
