
>> a := Lys ← (Lys ← 100 ; 200 ; 300) ; (Lys ← 9 ; 8 ; 7).
Uitvoer skryf: ['at 0,1 :'].
Uitvoer skryf: a ? 0 ? 1, nuwe-reël. 
Uitvoer skryf: ['at 1,2 :'].
Uitvoer skryf: a ? 1 ? 2, nuwe-reël. 
>> menu := Woordeboek nuut.
menu sit: (Lys ← ['pizza'] ; ['spaghetti']) by: ['Italian Cuisine'].
menu sit: (Lys ← ['bifteki'] ; ['suflaki']) by: ['Greek Cuisine'].
Uitvoer skryf: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), nuwe-reël. 
Uitvoer skryf: ['but not on the same plate.'], nuwe-reël.
