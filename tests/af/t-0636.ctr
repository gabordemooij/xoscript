# test url parsing

Server init.
>> url := URL vanuit: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Uitvoer skryf: ['scheme = '] + url skema, nuwe-reël.
Uitvoer skryf: ['host = '] + url gasheer, nuwe-reël.
Uitvoer skryf: ['port = '] + url poort, nuwe-reël.
Uitvoer skryf: ['path = '] + url pad, nuwe-reël.
Uitvoer skryf: ['query = '] + url soekparameters, nuwe-reël.
Uitvoer skryf: ['fragment = '] + url anker, nuwe-reël.
