# toets URL-ontleding

Server init.
>> url := URL vanuit: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Uitvoer skryf: ['skema = '] + url skema, nuwe-reël.
Uitvoer skryf: ['gasheer = '] + url gasheer, nuwe-reël.
Uitvoer skryf: ['poort = '] + url poort, nuwe-reël.
Uitvoer skryf: ['pad = '] + url pad, nuwe-reël.
Uitvoer skryf: ['soekparameters = '] + url soekparameters, nuwe-reël.
Uitvoer skryf: ['anker = '] + url anker, nuwe-reël.
