# FFI gebruik met die Server-inprop

# koppel aan libc (platformspesifiek)
>> biblioteeknaam := Program instelling: ['FFITESTLIB'].

# koppel stdio-funksies uit C vir gevorderde lêerbewerkings
Server koppel: ( Lys nuut ;
 biblioteeknaam ; ['fopen'] ;
 ( Lys nuut ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
koppel: ( Lys nuut ;
 Niks ; # beteken dieselfde biblioteek
 ['fread'] ;
 ( Lys nuut ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Niks ; # beteken dieselfde objek (d.w.s. Stroom)
 ['fread']
),
koppel: (
 Lys nuut ;
 Niks ; # beteken dieselfde biblioteek
 ['fwrite'] ;
 ( Lys nuut ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Niks ; # beteken dieselfde biblioteek
 ['fwrite']
),
koppel: (
 Lys nuut ;
 Niks ; # beteken dieselfde biblioteek
 ['rewind'] ;
 ( Lys nuut ; ['pointer'] ) ;
 ['int'] ;
 Niks ; # beteken dieselfde biblioteek
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> pad := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open 'n lêer met fopen(path, mode)
>> lb := Stream path: pad mode: mode.

# skryf grepe uit buffer teksstring na lêer
>> grepe-geskryf := Stream boodskap: ['fwrite'] argumente: (Lys nuut ; str ; 1 ; 6 ; lb ).
Uitvoer skryf: grepe-geskryf, nuwe-reël.

# spoel lêerwyser terug
Stream rewind: lb.

# ken 'n buffer toe
>> buf := Blob nuut: 20.

# lees uit lêer
>> grepe-gelees := Stream boodskap: ['fread'] argumente: (Lys nuut ; buf ; 1 ; 6 ; lb ).
Uitvoer skryf: grepe-gelees, nuwe-reël.
Uitvoer skryf: buf, nuwe-reël.

# stel geheue vry
str  stel-vry.
pad stel-vry.
mode stel-vry.
buf  stel-vry.


