


>> Koffiemasjien := Objek nuut.
Koffiemasjien by: ['order:'] doen: { :id
	>> coffee := ['Americano'].
	( id = 1 ) ja: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) ja: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) ja: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> EenvoudigeKoffiemasjien := Objek nuut.
EenvoudigeKoffiemasjien by: ['bestelling'] doen: { <- ['Swart']. }.
>> rooiKoppie := Koffiemasjien order: 1.
Uitvoer skryf: rooiKoppie, nuwe-reël.
rooiKoppie := ['Tee']. 
>> groenKoppie := Koffiemasjien order: 0.
Uitvoer skryf: groenKoppie, nuwe-reël.
>> geelKoppie := Koffiemasjien order: 1.
Uitvoer skryf: geelKoppie, nuwe-reël.
>> blouKoppie := Koffiemasjien order: 0.
Uitvoer skryf: blouKoppie, nuwe-reël.
>> plastiekKoppie := EenvoudigeKoffiemasjien bestelling.
plastiekKoppie := ['Limonade']. 
>> swartKoppie := EenvoudigeKoffiemasjien bestelling.
Uitvoer skryf: swartKoppie, nuwe-reël.
swartKoppie voeg-agter: [' neeee.... bier. '].
>> oranjeKoppie := EenvoudigeKoffiemasjien bestelling.
Uitvoer skryf: oranjeKoppie, nuwe-reël.
