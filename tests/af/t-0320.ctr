


>> CoffeeMachine := Objek nuut.
CoffeeMachine by: ['order:'] doen: { :id
	>> coffee := ['Americano'].
	( id = 1 ) ja: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) ja: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) ja: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Objek nuut.
SimpleCoffeeMachine by: ['order'] doen: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Uitvoer skryf: redCup, nuwe-reël.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Uitvoer skryf: greenCup, nuwe-reël.
>> yellowCup := CoffeeMachine order: 1.
Uitvoer skryf: yellowCup, nuwe-reël.
>> blueCup := CoffeeMachine order: 0.
Uitvoer skryf: blueCup, nuwe-reël.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Uitvoer skryf: blackCup, nuwe-reël.
blackCup voeg-agter: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Uitvoer skryf: orangeCup, nuwe-reël.
