
>> XX := Objek nuut.
>> X := Objek nuut.

XX by: ['QQ'] doen: { <- 1. }.
XX by: ['Q'] doen: { <- 1. }.
XX by: ['QQ:'] doen: { <- 1. }.
XX by: ['QQ:QQ:'] doen: { <- 1. }.

