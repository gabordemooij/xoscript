# toets kwalifiseerders

Program ruim-op.

>> Vrug := Objek nuut.
Vrug by: ['nuut'] doen: {
	>> f := self nuut.
	f apples: 0. <- f.
}.
Vrug by: ['apples:'] doen: { :a eie appels := a. }.
Vrug by: ['appels'] doen: { <- eie appels. }.
Vrug by: ['+'] doen: { :f
	>> n := Vrug nuut.
	n apples: (f appels + eie appels). <- n.
}.
Getal by: ['appels'] doen: { <- ((Vrug nuut) apples: self).
}.

Vrug by: ['teks'] doen: { <- eie appels + [' appels '].
}.

>> q := 3 appels + 4 appels.
Uitvoer skryf: q, nuwe-reël.




q := 3 appels + 4 appels.
Uitvoer skryf: q, nuwe-reël.



q := 3 appels + 4 appels.
Uitvoer skryf: q, nuwe-reël.


