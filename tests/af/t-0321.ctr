# test qualifiers

Program ruim-op.

>> Fruit := Objek nuut.
Fruit by: ['nuut'] doen: {
	>> f := self nuut.
	f apples: 0. <- f.
}.
Fruit by: ['apples:'] doen: { :a eie apples := a. }.
Fruit by: ['apples'] doen: { <- eie apples. }.
Fruit by: ['+'] doen: { :f
	>> n := Fruit nuut.
	n apples: (f apples + eie apples). <- n.
}.
Getal by: ['apples'] doen: { <- ((Fruit nuut) apples: self).
}.

Fruit by: ['teks'] doen: { <- eie apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Uitvoer skryf: q, nuwe-reël.




q := 3 apples + 4 apples.
Uitvoer skryf: q, nuwe-reël.



q := 3 apples + 4 apples.
Uitvoer skryf: q, nuwe-reël.


