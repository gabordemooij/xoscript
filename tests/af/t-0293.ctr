
>> stad := Lys ← ['Londen'] ; ['Parys'] ; ['Berlyn'].
>> temperatuur := Lys ← ['15'] ; ['16'] ; ['15'].
>> weer := temperatuur per: stad.
>> stede := weer inskrywings sorteer: { :a :b <- (a vergelyk: b). }.
>> temperature := weer waardes sorteer: { :a :b <- (a vergelyk: b) negatief?. }.

Uitvoer skryf: (stede voeg-saam: [',']), nuwe-reël.
Uitvoer skryf: (temperature voeg-saam: [',']), nuwe-reël.
