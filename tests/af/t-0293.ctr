
>> city := Lys ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Lys ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature per: city.
>> cities := weather inskrywings sorteer: { :a :b <- (a vergelyk: b). }.
>> temperatures := weather waardes sorteer: { :a :b <- (a vergelyk: b) negatief?. }.

Uitvoer skryf: (cities voeg-saam: [',']), nuwe-reël.
Uitvoer skryf: (temperatures voeg-saam: [',']), nuwe-reël.
