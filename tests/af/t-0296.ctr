
>> shop := (Woordeboek nuut
	sit: ['magazine'] by: ['books'],
	sit: ['computer'] by: ['electronics'],
	sit: ['lipstick'] by: ['cosmetics']
).
Uitvoer skryf: (shop het: ['computer']), nuwe-reël. 
Uitvoer skryf: (shop het: ['sausage']), nuwe-reël. 
Uitvoer skryf: (shop het: ['computers']), nuwe-reël. 
Uitvoer skryf: (shop het: ['compute']), nuwe-reël. 
Uitvoer skryf: (shop het: ['2computer']), nuwe-reël. 
