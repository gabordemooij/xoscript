
>> winkel := (Woordeboek nuut
	sit: ['tydskrif'] by: ['books'],
	sit: ['rekenaar'] by: ['elektronika'],
	sit: ['lipstiffie'] by: ['skoonheidsmiddels']
).
Uitvoer skryf: (winkel het: ['rekenaar']), nuwe-reël. 
Uitvoer skryf: (winkel het: ['wors']), nuwe-reël. 
Uitvoer skryf: (winkel het: ['rekenaars']), nuwe-reël. 
Uitvoer skryf: (winkel het: ['reken']), nuwe-reël. 
Uitvoer skryf: (winkel het: ['2rekenaar']), nuwe-reël. 
