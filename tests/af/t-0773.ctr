Uitvoer skryf: ['Test object'], nuwe-reël.
>> a := Objek nuut. 
a by: ['item:'] doen: { :int64
	eie int64 := int64. 
}.
a by: ['item'] doen: { <- eie int64.
}.
a item: ( Int64 vanuit-teks: ['9999'] ).
Uitvoer skryf: a item, nuwe-reël.
>> old-int64-address := a item prototipe geheue-adres.
a save-as: ['/tmp/a.bin'].
Uitvoer skryf: ['========== RELOADING SNAP:'], nuwe-reël.
>> b := Objek load-from: ['/tmp/a.bin'].
(b item prototipe geheue-adres = old-int64-address) ja: {
	Uitvoer skryf: ['Object link re-attached.'], nuwe-reël.
}.
Uitvoer skryf: ( b item ), nuwe-reël.
