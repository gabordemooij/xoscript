Uitvoer skryf: ['Toetsobjek'], nuwe-reël.
>> a := Objek nuut. 
a by: ['item:'] doen: { :int64
	eie int64 := int64. 
}.
a by: ['artikel'] doen: {
	<- eie int64.
}.
a item: ( Int64 vanuit-teks: ['9999'] ).
Uitvoer skryf: a artikel, nuwe-reël.
>> ou-int64-adres := a artikel prototipe geheue-adres.
a save-as: ['/tmp/a.bin'].
Uitvoer skryf: ['========== HERLAAI SNAP:'], nuwe-reël.
>> b := Objek load-from: ['/tmp/a.bin'].
(b artikel prototipe geheue-adres = ou-int64-adres) ja: {
	Uitvoer skryf: ['Objekskakel weer aangeheg.'], nuwe-reël.
}.
Uitvoer skryf: ( b artikel ), nuwe-reël.
