>> getalle := ['1,2,3'] verdeel: [','].
Uitvoer skryf: ['Ek het: '] + getalle tel + [' getalle.'],nuwe-reël.
{ :i Uitvoer skryf: ['number #'] + i + [':'] + (getalle posisie: i), nuwe-reël.} × 3.
>> drankies := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
drankies := drankies verdeel: [' Or '].
Uitvoer skryf: ['Ons bedien'], nuwe-reël.
{ :i Uitvoer skryf: ['->'] + (drankies posisie: i), nuwe-reël. } × (drankies tel).
Uitvoer skryf: (drankies voeg-saam: [',']), nuwe-reël.
Uitvoer skryf: (getalle voeg-saam: ['||']).
