>> numbers := ['1,2,3'] verdeel: [','].
Uitvoer skryf: ['I got: '] + numbers tel + [' numbers.'],nuwe-reël.
{ :i Uitvoer skryf: ['number #'] + i + [':'] + (numbers posisie: i), nuwe-reël.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages verdeel: [' Or '].
Uitvoer skryf: ['We serve'], nuwe-reël.
{ :i Uitvoer skryf: ['->'] + (beverages posisie: i), nuwe-reël. } × (beverages tel).
Uitvoer skryf: (beverages voeg-saam: [',']), nuwe-reël.
Uitvoer skryf: (numbers voeg-saam: ['||']).
