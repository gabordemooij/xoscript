Uitvoer skryf: ['Toetsobjek'], nuwe-reël.
>> a := Objek nuut. 

a by: ['item:'] doen: { :mmt
	eie mmt := mmt. 
}.

a by: ['artikel'] doen: {
	<- eie mmt.
}.

>> vandag := Oomblik nuut sone: ['CEST'], jaar: 2026, maand: 7.
a item: vandag.
Uitvoer skryf: a artikel, nuwe-reël.
a save-as: ['/tmp/a.bin'].
Uitvoer skryf: ['========== HERLAAI SNAP:'], nuwe-reël.
>> b := Objek load-from: ['/tmp/a.bin'].
Uitvoer skryf: b artikel, nuwe-reël.
