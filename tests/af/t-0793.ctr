Server init.

>> DB := Maria-DB nuut gasheer: ['localhost'],
	gebruikersnaam: ['xo'],
	wagwoord: ['pass123'],
	databasisnaam: ['xobase'],
	verbind.

{
	DB navraag:
	['DROP TABLE movies'],
	voer-uit.
} vang: { Niks. }, begin.

DB navraag:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
voer-uit.

DB navraag: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parameters: ( Lys nuut ; ['Halloween'] ),
voer-uit.

DB navraag: ['SELECT * FROM movies'],
haal: { :fliek
	Uitvoer skryf: fliek title, nuwe-reël.
}.

