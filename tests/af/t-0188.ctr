

>> gebruikteGeheue1 := 0.
>> gebruikteGeheue2 := 0.
>> gebruikteGeheue3 := 0.
>> gebruikteGeheue4 := 0.

Program geheuebestuur: 0.

{ :i Uitvoer skryf: i. } × 4.
Uitvoer nuwe-reël.
{ :i Uitvoer skryf: (4 - i). } × 4.
Uitvoer nuwe-reël.
( 1 > 2 ) nee: { Uitvoer skryf: ['BLOK 1'], nuwe-reël. }.
( 2 > 1 ) ja:  { Uitvoer skryf: ['BLOK 2'], nuwe-reël. }.

>> i := 0.
{ Uitvoer skryf: i. i tel-by: 1. } terwyl: { <- ( i < 3). }.
Uitvoer nuwe-reël.

i := 3.
{ Uitvoer skryf: i. i := i - 1. } terwyl: { <- ( i > 0). }.
Uitvoer nuwe-reël.


Program ruim-op.

gebruikteGeheue1 := (Program geheue ? 0).


{ :i  Uitvoer skryf: i. } × 4.
Uitvoer nuwe-reël.
{ :i  Uitvoer skryf: (4 - i). } × 4.
Uitvoer nuwe-reël.
( 1 > 2 ) nee: { Uitvoer skryf: ['BLOK 1'], nuwe-reël. }.
( 2 > 1 ) ja:  { Uitvoer skryf: ['BLOK 2'], nuwe-reël. }.

>> i := 0.
{ Uitvoer skryf: i. i tel-by: 1. } terwyl: { <- ( i < 3). }.
Uitvoer nuwe-reël.

i := 3.
{ Uitvoer skryf: i. i := i - 1. } terwyl: { <- ( i > 0). }.
Uitvoer nuwe-reël.



Program ruim-op.
gebruikteGeheue2 := (Program geheue ? 0).


{ :i Uitvoer skryf: i. } × 4.
Uitvoer nuwe-reël.
{ :i Uitvoer skryf: (4 - i). } × 4.
Uitvoer nuwe-reël.
( 1 > 2 ) nee: { Uitvoer skryf: ['BLOK 1'], nuwe-reël. }.
( 2 > 1 ) ja:  { Uitvoer skryf: ['BLOK 2'], nuwe-reël. }.

>> i := 0.
{ Uitvoer skryf: i. i tel-by: 1. } terwyl: { <- ( i < 3). }.
Uitvoer nuwe-reël.

i := 3.
{ Uitvoer skryf: i. i := i - 1. } terwyl: { <- ( i > 0). }.
Uitvoer nuwe-reël.

Program ruim-op.
gebruikteGeheue3 := (Program geheue ? 0).



( gebruikteGeheue1 = gebruikteGeheue2 en: gebruikteGeheue1 = gebruikteGeheue3, en: gebruikteGeheue2 = gebruikteGeheue3 ) ja: {
	Uitvoer skryf: ['Geen geheuelekke hier nie'].
}, nee: {
	Uitvoer skryf: ['Geheue lek...'].
}.
