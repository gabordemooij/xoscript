>> Punt := Objek nuut.
Punt by: ['x-coordinate:'] doen: { :x eie x := x. }.
Punt by: ['y-coordinate:'] doen: { :y eie y := y. }.
Punt by: ['x-koördinaat']  doen: { <- eie x kopieer. }.
Punt by: ['y-koördinaat']  doen: { <- eie y kopieer. }.

Punt by: ['='] doen: { :ander
	<- ( eie x = ander x-koördinaat
		 en: eie y = ander y-koördinaat ).
}.

>> pier := Punt nuut x-coordinate: 5, y-coordinate: 6.
>> stadsaal := Punt nuut x-coordinate: 7, y-coordinate: 1.
>> restaurant := Punt nuut x-coordinate: 5, y-coordinate: 6.

Uitvoer skryf: pier = stadsaal, nuwe-reël.
Uitvoer skryf: pier = restaurant, nuwe-reël.
