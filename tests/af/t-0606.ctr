>> Point := Objek nuut.
Point by: ['x-coordinate:'] doen: { :x eie x := x. }.
Point by: ['y-coordinate:'] doen: { :y eie y := y. }.
Point by: ['x-coordinate']  doen: { <- eie x kopieer. }.
Point by: ['y-coordinate']  doen: { <- eie y kopieer. }.

Point by: ['='] doen: { :other <- ( eie x = other x-coordinate
		 en: eie y = other y-coordinate ).
}.

>> pier := Point nuut x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point nuut x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point nuut x-coordinate: 5, y-coordinate: 6.

Uitvoer skryf: pier = town-hall, nuwe-reël.
Uitvoer skryf: pier = restaurant, nuwe-reël.
