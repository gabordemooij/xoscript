#Linux
>> clock := Oomblik nuut.
clock sone: ['UTC-1'].
clock jaar: 1981, maand: 1, dag: 5,
      uur: 13, minuut: 15, sekonde: 13.

Uitvoer skryf: clock, nuwe-reël.
clock sone: ['UTC+0'].

Uitvoer skryf: (
	(clock jaar gewoon) + ['-'] + (clock maand) + ['-'] + (clock dag) + [' '] +
	(clock uur) + [':'] + (clock minuut) + [':'] + (clock sekonde) + [' '] +
	['W'] + (clock week) + (clock sone)
), nuwe-reël.


clock sone: ['UTC-1'].
Uitvoer skryf: (
	(clock jaar gewoon) + ['-'] + (clock maand) + ['-'] + (clock dag) + [' '] +
	(clock uur) + [':'] + (clock minuut) + [':'] + (clock sekonde) + [' '] +
	['W'] + (clock week) + (clock sone)
), nuwe-reël.
