#Linux
>> horlosie := Oomblik nuut.
horlosie sone: ['UTC-1'].
horlosie jaar: 1981, maand: 1, dag: 5,
      uur: 13, minuut: 15, sekonde: 13.

Uitvoer skryf: horlosie, nuwe-reël.
horlosie sone: ['UTC+0'].

Uitvoer skryf: (
	(horlosie jaar gewoon) + ['-'] + (horlosie maand) + ['-'] + (horlosie dag) + [' '] +
	(horlosie uur) + [':'] + (horlosie minuut) + [':'] + (horlosie sekonde) + [' '] +
	['W'] + (horlosie week) + (horlosie sone)
), nuwe-reël.


horlosie sone: ['UTC-1'].
Uitvoer skryf: (
	(horlosie jaar gewoon) + ['-'] + (horlosie maand) + ['-'] + (horlosie dag) + [' '] +
	(horlosie uur) + [':'] + (horlosie minuut) + [':'] + (horlosie sekonde) + [' '] +
	['W'] + (horlosie week) + (horlosie sone)
), nuwe-reël.
