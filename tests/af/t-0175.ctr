

>> gebruikteGeheue1 := 0.
>> gebruikteGeheue2 := 0.
>> gebruikteGeheue3 := 0.
>> gebruikteGeheue4 := 0.

>> x := 100.

Program geheuebestuur: 0.

{
>> txt := ['hallo '] + ['world'].
txt := txt + [' - kan ons teks gebruik.. '].
txt := txt + ['sonder om '] + x + ['-tal grepe te lek ?'].
txt voeg-agter: ['!!'].
Uitvoer skryf: txt.
} begin.

Program ruim-op.

gebruikteGeheue1 := (Program geheue ? 0).


{
>> txt := ['hallo '] + ['world'].
txt := txt + [' - kan ons teks gebruik.. '].
txt := txt + ['sonder om '] + x + ['-tal grepe te lek ?'].
txt voeg-agter: ['!!'].
Uitvoer skryf: txt.
} begin.

Program ruim-op.
gebruikteGeheue2 := (Program geheue ? 0).


{
>> txt := ['hallo '] + ['world'].
txt := txt + [' - kan ons teks gebruik.. '].
txt := txt + ['sonder om '] + x + ['-tal grepe te lek ?'].
txt voeg-agter: ['!!'].
Uitvoer skryf: txt.
} begin.

Program ruim-op.
gebruikteGeheue3 := (Program geheue ? 0).



( gebruikteGeheue1 = gebruikteGeheue2 en: gebruikteGeheue1 = gebruikteGeheue3, en: gebruikteGeheue2 = gebruikteGeheue3 ) ja: {
	Uitvoer skryf: ['Geen geheuelekke hier nie'].
}, nee: {
	Uitvoer skryf: ['Geheue lek...'].
}.
