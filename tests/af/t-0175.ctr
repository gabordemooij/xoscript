>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> x := 100.

Program geheuebestuur: 0.

{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt voeg-agter: ['!!'].
Uitvoer skryf: txt.
} begin.

Program ruim-op.

usedMemory1 := (Program geheue ? 0).


{
