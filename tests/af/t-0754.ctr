Uitvoer skryf: ['Toetsobjek'], nuwe-reël.
>> a := Objek nuut. 

a by: ['item:'] doen: { :uit
	eie uit := uit. 
}.

a by: ['artikel'] doen: {
	<- eie uit.
}.

a by: ['groet'] doen: {
	Uitvoer skryf: ['haai van oorspronklike uitvoer!'], nuwe-reël.
}.

a item: Uitvoer.

Uitvoer skryf: a artikel, nuwe-reël.

>> ou-uit-adres := a artikel prototipe geheue-adres.
a save-as: ['/tmp/a.bin'].
Uitvoer skryf: ['========== HERLAAI SNAP:'], nuwe-reël.

>> b := Objek load-from: ['/tmp/a.bin'].

(b artikel prototipe geheue-adres = ou-uit-adres) ja: {
	Uitvoer skryf: ['Objekskakel weer aangeheg.'], nuwe-reël.
}.

b artikel skryf: ['hallo van gelaaide uitvoer!'], nuwe-reël.
b groet.
