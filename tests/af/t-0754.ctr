Uitvoer skryf: ['Test object'], nuwe-reël.
>> a := Objek nuut. 

a by: ['item:'] doen: { :out
	eie out := out. 
}.

a by: ['item'] doen: { <- eie out.
}.

a by: ['greet'] doen: {
	Uitvoer skryf: ['hi from original out!'], nuwe-reël.
}.

a item: Uitvoer.

Uitvoer skryf: a item, nuwe-reël.

>> old-out-address := a item prototipe geheue-adres.
a save-as: ['/tmp/a.bin'].
Uitvoer skryf: ['========== RELOADING SNAP:'], nuwe-reël.

>> b := Objek load-from: ['/tmp/a.bin'].

(b item prototipe geheue-adres = old-out-address) ja: {
	Uitvoer skryf: ['Object link re-attached.'], nuwe-reël.
}.

b item skryf: ['hello from loaded out!'], nuwe-reël.
b greet.
