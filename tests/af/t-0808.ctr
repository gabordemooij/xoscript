# kluissleutels en handtekeninge wat te lank dekodeer, mag nie die stapel laat oorloop nie
Server init.

>> sleutels := Kluis genereer-sleutels.
>> sk := sleutels eerste.
>> pk := sleutels laaste.
>> sig := Kluis onderteken: ['abc'] met: sk.

# 88 tekens sonder opvulling dekodeer na 66 grepe
>> lank := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 tekens sonder opvulling dekodeer na 33 grepe
>> kort := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Kluis onderteken: ['abc'] met: lank. } vang: { :e
	Uitvoer skryf: e, nuwe-reël.
}, begin.

{ Kluis kontroleer: ['abc'] handtekening: lank met: pk. } vang: { :e
	Uitvoer skryf: e, nuwe-reël.
}, begin.

{ Kluis kontroleer: ['abc'] handtekening: sig met: kort. } vang: { :e
	Uitvoer skryf: e, nuwe-reël.
}, begin.
