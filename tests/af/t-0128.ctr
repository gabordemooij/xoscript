
Lys by: ['sum'] doen: {
	>> total := 0.
	self elk: { :index :element
		total tel-by: element.
	}. <- total.
}.

>> a := Lys ← 9 ; 8 ; 7.
Uitvoer skryf: (a sum), nuwe-reël. 
>> a := Lys ← 1 ; 9.
Uitvoer skryf: (a sum), nuwe-reël. 
>> a := Lys ← ['o'] ; 2.
Uitvoer skryf: (a sum), nuwe-reël. 
Uitvoer skryf: (Lys nuut sum), nuwe-reël. 
