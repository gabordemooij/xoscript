>> z := Objek nuut.
z by: ['value:'] doen: { :v
	eie value := v. <- self.
}.
z by: ['value'] doen: { <- eie value. }.
(z setValue: 1) value: 2.
Uitvoer skryf: z value.
>> x := z.
Uitvoer skryf: x value.
z := Niks.
Uitvoer skryf: z value.
Uitvoer skryf: x value.
Uitvoer skryf: ['hello'].
Uitvoer skryf: 3 + 2.
Uitvoer skryf: (3 > 2).
