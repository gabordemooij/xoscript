
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> kode := {
	>> o := (
		Woordeboek nuut
		aa: (Lys ← 1 ; 2),
		bb: (Lys ← 3 ; 4)
	).
	>> s := o teks.
	>> o2 := s objek.
	(s  tipe = Teks tipe) ja: { Uitvoer skryf: ['OK1'], nuwe-reël. }.
	(o2 tipe = Woordeboek tipe) ja: { Uitvoer skryf: ['OK2'], nuwe-reël. }.
}.

Program geheuebestuur: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Program ruim-op.
usedMemory1 := (Program geheue ? 1).
kode begin.
Program ruim-op.
usedMemory2 := (Program geheue ? 1).
kode begin.
Program ruim-op.
usedMemory3 := (Program geheue ? 1).
kode begin.
Program ruim-op.
usedMemory4 := (Program geheue ? 1).

(usedMemory2 = usedMemory3 = usedMemory4) ja: { Uitvoer skryf: ['OK3'], nuwe-reël. }.
 
