
>> gebruikteGeheue1 := 0.
>> gebruikteGeheue2 := 0.
>> gebruikteGeheue3 := 0.
>> gebruikteGeheue4 := 0.

>> kode := {
	>> o := (
		Woordeboek nuut
		aa: (Lys ← 1 ; 2),
		bb: (Lys ← 3 ; 4)
	).
	>> s := o teks.
	>> o2 := s objek.
	(s  tipe = Teks tipe) ja: { Uitvoer skryf: ['OK1'], nuwe-reël. }.
	(o2 tipe = Woordeboek tipe) ja: { Uitvoer skryf: ['OK2'], nuwe-reël. }.
}.

Program geheuebestuur: 0.
['Geheue 1 sal verskil omdat gevolgde blokke in grootmaat bygevoeg word.'].
Program ruim-op.
gebruikteGeheue1 := (Program geheue ? 1).
kode begin.
Program ruim-op.
gebruikteGeheue2 := (Program geheue ? 1).
kode begin.
Program ruim-op.
gebruikteGeheue3 := (Program geheue ? 1).
kode begin.
Program ruim-op.
gebruikteGeheue4 := (Program geheue ? 1).

(gebruikteGeheue2 = gebruikteGeheue3 = gebruikteGeheue4) ja: { Uitvoer skryf: ['OK3'], nuwe-reël. }.
 
