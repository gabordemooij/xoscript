# Toets utf8-skoonmaker
Server init.

>> utf8gevalle := Woordeboek nuut
	# Slegs ASCII
	sit: ( Lys nuut ; 65 ; 65 ; 65 ; 65 ; 0 ) by: ['AAAA'],
	# geldige 2-greep-reeks
	sit: ( Lys nuut ; 194 ; 162 ; 0 ) by: ['¢'],
	# Geldige 3-greep-UTF-8
    sit: ( Lys nuut ; 226 ; 130 ; 172 ; 0 ) by: ['€'],
	# Geldige 4-greep-UTF-8
    sit: ( Lys nuut ; 240 ; 144 ; 141 ; 136 ; 0 ) by: ['𐍈'],
	# Ongeldige voortsettingsgreep in reeks E2 28 AC -> begin 3g-reeks + 28 verkeerde vtg + AC vtg-greep, maar behoort tot dieselfde fout
    sit: ( Lys nuut ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) by: ['A?A'],
	# Oorlang kodering van ASCII 'A' (moet ? word),
    sit: ( Lys nuut ; 65 ; 193 ; 129 ; 0 ) by: ['A?'],
	# Ongeldige eerste greep (0xFF)
    sit: ( Lys nuut ; 255 ; 0 ) by: ['?'],
	# Onvolledige multigreep-reeks aan die einde
    sit: ( Lys nuut ; 66 ; 226 ; 0 ) by: ['B?'],
    # Leë teks
    #put: ( List new ) at: [''],
	# Meerdere gemengde reekse
    sit: ( Lys nuut ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) by: ['A€?𐍈B'].
	 
utf8gevalle elk: { :key :value
	>> blob := Blob nuut: value tel, bytes: value.
	>> str := blob teks.
	(str = key) ja: {
		Uitvoer skryf: ['OK'], nuwe-reël.
	}, anders: {
		Uitvoer skryf: ['UTF8-opruimer het misluk op: '] + key + [' kry: '] + str, nuwe-reël.
	}.
	blob stel-vry.
}.
