# Test utf8 sanitizer
Server init.

>> utf8cases := Woordeboek nuut
	# ASCII only
	sit: ( Lys nuut ; 65 ; 65 ; 65 ; 65 ; 0 ) by: ['AAAA'],
	# valid 2 byte sequence
	sit: ( Lys nuut ; 194 ; 162 ; 0 ) by: ['¢'],
	# Valid 3-byte UTF-8
    sit: ( Lys nuut ; 226 ; 130 ; 172 ; 0 ) by: ['€'],
	# Valid 4-byte UTF-8
    sit: ( Lys nuut ; 240 ; 144 ; 141 ; 136 ; 0 ) by: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    sit: ( Lys nuut ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) by: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    sit: ( Lys nuut ; 65 ; 193 ; 129 ; 0 ) by: ['A?'],
	# Invalid first byte (0xFF)
    sit: ( Lys nuut ; 255 ; 0 ) by: ['?'],
	# Incomplete multi-byte sequence at end
    sit: ( Lys nuut ; 66 ; 226 ; 0 ) by: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    sit: ( Lys nuut ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) by: ['A€?𐍈B'].
	 
utf8cases elk: { :key :value
	>> blob := Blob nuut: value tel, bytes: value.
	>> str := blob teks.
	(str = key) ja: {
		Uitvoer skryf: ['OK'], nuwe-reël.
	}, anders: {
		Uitvoer skryf: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, nuwe-reël.
	}.
	blob stel-vry.
}.
