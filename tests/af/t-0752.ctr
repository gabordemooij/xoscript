Uitvoer skryf: ['Test object'], nuwe-reël.
>> a := Objek nuut. 

a by: ['item:'] doen: { :boolees
	eie boolees := boolees. 
}.

a by: ['item'] doen: { <- eie boolees.
}.

a item: Boolees.

Uitvoer skryf: a item, nuwe-reël.

>> old-bool-address := a item prototipe geheue-adres.
a save-as: ['/tmp/a.bin'].
Uitvoer skryf: ['========== RELOADING SNAP:'], nuwe-reël.

>> b := Objek load-from: ['/tmp/a.bin'].

(b item prototipe geheue-adres = old-bool-address) ja: {
	Uitvoer skryf: ['Object link re-attached.'], nuwe-reël.
}.

Uitvoer skryf: b item, nuwe-reël.
