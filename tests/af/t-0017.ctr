Getal by: ['factorial'] doen: {
	>> total := 1.
	{ :index total vermenigvuldig-met: (self - (index)). } × self. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Uitvoer skryf: a.
>> b := 2 + 3 factorial.
Uitvoer skryf: b.
>> c := 3 factorial + 2.
Uitvoer skryf: c.
>> d := 2 + (3 factorial).
Uitvoer skryf: d.
Uitvoer skryf: 2 + 3 factorial + 1.
