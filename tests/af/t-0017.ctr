Getal by: ['fakulteit'] doen: {
	>> totaal := 1.
	{ :indeks totaal vermenigvuldig-met: (self - (indeks)). } × self. <- totaal.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Uitvoer skryf: a.
>> b := 2 + 3 fakulteit.
Uitvoer skryf: b.
>> c := 3 fakulteit + 2.
Uitvoer skryf: c.
>> d := 2 + (3 fakulteit).
Uitvoer skryf: d.
Uitvoer skryf: 2 + 3 fakulteit + 1.
