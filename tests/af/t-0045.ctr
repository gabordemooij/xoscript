Program geheuebestuur: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } vang: {
		oops tel-by: 1.
	}, begin.
} × 1000.

{
	Uitvoer skryf: ['hi there!'].
	hierdie-taak fout: ['oops'].
	Uitvoer skryf: ['hi there!'].
	{ Uitvoer skryf: ['dont print this']. } begin.
} vang: { :e 
