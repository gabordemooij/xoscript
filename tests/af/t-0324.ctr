>> Animal := Objek nuut.
>> Factory := Objek nuut.

Animal by: ['nuut'] doen: {
	>> animal := self nuut.
	animal sound: ['?']. <- animal.
}.

Animal by: ['sound:'] doen: { :s
	eie sound := s.
}.

Animal by: ['sound'] doen: { <- eie sound.
}.

>> Dog := Objek nuut.
>> Cat := Objek nuut.

Dog by: ['nuut'] doen: { <- Animal nuut sound: ['woof!'].
}.

Cat by: ['nuut'] doen: { <- Animal nuut sound: ['meow!'].
}.

Uitvoer skryf: Dog nuut sound, nuwe-reël.
Uitvoer skryf: Cat nuut sound, nuwe-reël.

Factory by: ['mix:and:'] doen: { :beast1 :beast2 <- Animal nuut sound: (
		( beast1 sound vanaf: 0 lengte: 2 ) +
		( beast2 sound vanaf: 2 lengte: 5 )
	).
}.

Uitvoer skryf: (Factory mix: Dog nuut and: Cat nuut) sound, nuwe-reël.
