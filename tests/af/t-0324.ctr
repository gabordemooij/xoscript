>> Dier := Objek nuut.
>> Fabriek := Objek nuut.

Dier by: ['nuut'] doen: {
	>> dier := self nuut.
	dier sound: ['?']. <- dier.
}.

Dier by: ['sound:'] doen: { :s
	eie geluid := s.
}.

Dier by: ['geluid'] doen: { <- eie geluid.
}.

>> Hond := Objek nuut.
>> Kat := Objek nuut.

Hond by: ['nuut'] doen: { <- Dier nuut sound: ['woef!'].
}.

Kat by: ['nuut'] doen: { <- Dier nuut sound: ['meow!'].
}.

Uitvoer skryf: Hond nuut geluid, nuwe-reël.
Uitvoer skryf: Kat nuut geluid, nuwe-reël.

Fabriek by: ['meng:en:'] doen: { :bees1 :bees2 <- Dier nuut sound: (
		( bees1 geluid vanaf: 0 lengte: 2 ) +
		( bees2 geluid vanaf: 2 lengte: 5 )
	).
}.

Uitvoer skryf: (Fabriek meng: Hond nuut en: Kat nuut) geluid, nuwe-reël.
