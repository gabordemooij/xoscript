# a value ending in the first part of an opening quote must survive serialization
>> waardes := Lys nuut
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

waardes elk: { :i :value
	>> d := Woordeboek nuut.
	d sit: value by: ['k'].
	d sit: ['second'] by: ['j'].
	>> r := d kode objek.
	Uitvoer skryf: r tel, nuwe-reël.
	Uitvoer skryf: ( (r by: ['k']) = value ), nuwe-reël.
}.
