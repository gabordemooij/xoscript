Server init.

Uitvoer skryf: (
	Patroon nuut: ['^\\w+$'],
	passing: ['test@example.com'] 
), nuwe-reël. # 0 passings, faal op @ en .

Uitvoer skryf: (
	Patroon nuut: ['^[^@]+@[^\.]+\.\\w+$'],
	passing: ['test@example.com'] 
), nuwe-reël. # 1 passing

Uitvoer skryf: (
	Patroon nuut: ['[^@]+@[^\.]+\.\\w+'],
	passing: ['test@example.com'] 
), nuwe-reël. # 1 passing

Uitvoer skryf: (
	Patroon nuut: ['([^@]+)@([^\.]+)\.\\w+'],
	passing: ['test@example.com'] 
), nuwe-reël. # 1 passing, groepe maak nie saak nie

Uitvoer skryf: (
	Patroon nuut: ['[a-z]'],
	passing: ['test@example.com'] 
), nuwe-reël. # 14 passings

Uitvoer skryf: (
	Patroon nuut: ['.*'],
	passing: ['test@example.com'] 
), nuwe-reël. # 1 passing (alles)

Uitvoer skryf: (
	Patroon nuut: ['(.*)'],
	passing: ['test@example.com'] 
), nuwe-reël. # 1 passing (alles)

Uitvoer skryf: (
	Patroon nuut: ['\\s*[^@]+@[^\.]+\.\\w+'],
	passing: ['test@example.com'] 
), nuwe-reël. # 1 passing, spasie vooraan opsioneel, word geïgnoreer