Server init.

Uitvoer skryf: (
	Patroon nuut: ['^\\w+$'],
	passing: ['test@example.com'] 
), nuwe-reël. # 0 match, fails on @ and .

Uitvoer skryf: (
	Patroon nuut: ['^[^@]+@[^\.]+\.\\w+$'],
	passing: ['test@example.com'] 
), nuwe-reël. # 1 match

Uitvoer skryf: (
	Patroon nuut: ['[^@]+@[^\.]+\.\\w+'],
	passing: ['test@example.com'] 
), nuwe-reël. # 1 match

Uitvoer skryf: (
	Patroon nuut: ['([^@]+)@([^\.]+)\.\\w+'],
	passing: ['test@example.com'] 
), nuwe-reël. # 1 match, groups dont matter

Uitvoer skryf: (
	Patroon nuut: ['[a-z]'],
	passing: ['test@example.com'] 
), nuwe-reël. # 14 matches

Uitvoer skryf: (
	Patroon nuut: ['.*'],
	passing: ['test@example.com'] 
), nuwe-reël. # 1 match (all)

Uitvoer skryf: (
	Patroon nuut: ['(.*)'],
	passing: ['test@example.com'] 
), nuwe-reël. # 1 match (all)

Uitvoer skryf: (
	Patroon nuut: ['\\s*[^@]+@[^\.]+\.\\w+'],
	passing: ['test@example.com'] 
), nuwe-reël. # 1 match, prefix space optional, gets ignored