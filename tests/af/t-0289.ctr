#Linux
>> OS := Program stelsel: (Opdrag uname -s), snoei.

>> Slurp := Objek nuut.
Slurp by: ['nuut'] doen: {
	eie str := [''].
}.
Slurp by: ['reageer:'] doen: { :blah
		(eie str ≠ ['']) ja: {
			eie str voeg-agter: [' '].
		}.
		eie str voeg-agter: blah.
}.
Slurp by: ['reageer:en:'] doen: { :blah :blahah
		(eie str ≠ ['']) ja: {
			eie str voeg-agter: [' '].
		}.
		(blah lengte > 1) ja: {
			eie str voeg-agter: (blah vanaf: 0 lengte: (blah lengte - 1)).
		}, anders: {
			eie str voeg-agter: blah.
		}.
		eie str voeg-agter: [' '].
		eie str voeg-agter: blahah.
}.
Slurp by: ['obtain'] doen: {
	>> buffer := eie str.
	eie str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text voeg-agter: ['hello'].
} × 1000.


Uitvoer skryf: (
	Program stelsel: (
		Slurp nuut
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

