# test list operations


>> cakes := Lys ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes vervang: 1 lengte: 2 met: ( Lys ← ['cinnamon'] ; ['pineapple'] ).
Uitvoer skryf: (buy voeg-saam: [',']), nuwe-reël.


>> buy := cakes vervang: 1 lengte: 12 met: ( Lys ← ['cinnamon'] ; ['pineapple'] ).
Uitvoer skryf: (buy voeg-saam: [',']), nuwe-reël.


>> buy := cakes vervang: 2 lengte: 10 met: ( Lys nuut ).
Uitvoer skryf: (buy voeg-saam: [',']), nuwe-reël.


>> buy := cakes vervang: 0 lengte: 1 met: ( Lys nuut ).
Uitvoer skryf: (buy voeg-saam: [',']), nuwe-reël.


>> buy := cakes vervang: ['0'] lengte: ['1'] met: ['x'].
Uitvoer skryf: (buy voeg-saam: [',']), nuwe-reël.
