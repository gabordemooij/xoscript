# toets lysbewerkings


>> koeke := Lys ←
	['apple'] ;
	['bessie'] ;
	['sjokolade'] ;
	['kaas'].


>> koop := koeke vervang: 1 lengte: 2 met: ( Lys ← ['kaneel'] ; ['pynappel'] ).
Uitvoer skryf: (koop voeg-saam: [',']), nuwe-reël.


>> koop := koeke vervang: 1 lengte: 12 met: ( Lys ← ['kaneel'] ; ['pynappel'] ).
Uitvoer skryf: (koop voeg-saam: [',']), nuwe-reël.


>> koop := koeke vervang: 2 lengte: 10 met: ( Lys nuut ).
Uitvoer skryf: (koop voeg-saam: [',']), nuwe-reël.


>> koop := koeke vervang: 0 lengte: 1 met: ( Lys nuut ).
Uitvoer skryf: (koop voeg-saam: [',']), nuwe-reël.


>> koop := koeke vervang: ['0'] lengte: ['1'] met: ['x'].
Uitvoer skryf: (koop voeg-saam: [',']), nuwe-reël.
