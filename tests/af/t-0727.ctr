Server init.
>> f := Formaat nuut: ['%d'].
>> a := Blob nuut: 4.
a bytes: ( Lys nuut ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob nuut: 4.
b bytes: ( Lys nuut ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a vanaf: 0 lengte: 3, elk: { :i :byte
	Uitvoer skryf: ( f pas-toe-heelgetal: byte ), nuwe-reël.
}.
a ^ b.
a vanaf: 0 lengte: 3, elk: { :i :byte
	Uitvoer skryf: ( f pas-toe-heelgetal: byte ), nuwe-reël.
}.
a ^ b.
a vanaf: 0 lengte: 3, elk: { :i :byte
	Uitvoer skryf: ( f pas-toe-heelgetal: byte ), nuwe-reël.
}.
a stel-vry.
b stel-vry.

{ a ^ Objek. } vang: { :e Uitvoer skryf: e, nuwe-reël. }, begin.
