
Server init.
>> rq := HTTP-Versoek nuut.
Uitvoer skryf: ['HTTP-GET d[]=']  + ( rq get-lys: ['d[]'] ), nuwe-reël. # GET
Uitvoer skryf: ['HTTP-GET f[]=']  + ( rq get-lys: ['f[]'] ), nuwe-reël. # GET
Uitvoer skryf: ['HTTP-POST e[]='] + ( rq post-lys: ['e[]'] ), nuwe-reël. # GET
Uitvoer skryf: ['HTTP-POST c=']   + ( rq post: ['c'] ), nuwe-reël. # GET
Uitvoer skryf: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), nuwe-reël. # GET
