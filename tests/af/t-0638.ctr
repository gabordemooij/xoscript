
Server init.
>> vsk := HTTP-Versoek nuut.
Uitvoer skryf: ['HTTP-GET d[]=']  + ( vsk get-lys: ['d[]'] ), nuwe-reël. # GET
Uitvoer skryf: ['HTTP-GET f[]=']  + ( vsk get-lys: ['f[]'] ), nuwe-reël. # GET
Uitvoer skryf: ['HTTP-POST e[]='] + ( vsk post-lys: ['e[]'] ), nuwe-reël. # GET
Uitvoer skryf: ['HTTP-POST c=']   + ( vsk post: ['c'] ), nuwe-reël. # GET
Uitvoer skryf: ['HTTP-POST xx=']  + ( vsk post: ['xx'] ), nuwe-reël. # GET
