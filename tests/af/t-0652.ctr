# test number -> string -> number
{

	>> x := Getal tussen: 0 en: 1000000.
	>> d := Getal tussen: 1 en: 7.
	>> e := 10 tot-die-mag: d.

	x deel-deur: e.
	>> y := x teks getal.

	(x = y) nee: {
		Uitvoer skryf: x, nuwe-reël.
		Uitvoer skryf: y, nuwe-reël.
		Program einde.
	}.

} * 1000.
Uitvoer skryf: ['OK'], nuwe-reël.