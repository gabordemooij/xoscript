>> t := Ja.
(t = Ja) ja: { Uitvoer skryf: ['T']. }.
(t = Nee) ja: { Uitvoer skryf: ['F']. }.
Uitvoer skryf: ['|'].
>> t := Nee.
(t = Ja) ja: { Uitvoer skryf: ['T']. }.
(t = Nee) ja: { Uitvoer skryf: ['F']. }.
Uitvoer skryf: ['|'].
>> f := Ja.
(t = Ja en: f = Nee) ja: { Uitvoer skryf: ['T']. }.
(t = Nee en: f = Ja) ja: { Uitvoer skryf: ['F']. }.
Uitvoer skryf: ['|'].
>> n := Niks.
(n Niks?) ja: { Uitvoer skryf: ['T']. }.
(n Niks?) nee: { Uitvoer skryf: ['F']. }.
Uitvoer skryf: ['|'].
(f Boolean?) ja: { Uitvoer skryf: ['T']. }.
(f Boolean?) nee: { Uitvoer skryf: ['F']. }.



