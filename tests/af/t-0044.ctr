>> list := Lys nuut.
list ~ ['hello'].
Uitvoer skryf: list tel.
list voeg-agter: ['world'].
Uitvoer skryf: list tel.
Uitvoer skryf: list haal-laaste, skryf: list tel.
list voeg-agter: ['there'].
Uitvoer skryf: list tel.
Uitvoer skryf: (list posisie: 0), skryf: (list posisie: 1).
list sit: ['xmas'] by: 1.
list sit: ['merry'] by: 0.
Uitvoer skryf: list tel.
Uitvoer skryf: (list posisie: 0), skryf: (list posisie: 1).
