>> t := Niks.

# jy kan die tydsone vir
# ontleding so beheer:
Oomblik sone: ['CET'].
t := Oomblik vanuit: ['1981-02-03 04:05:06'].
Uitvoer skryf: t, nuwe-reël.

# nou met CEST-tydsone:
Oomblik sone: ['CEST'].
t := Oomblik vanuit: ['1981-02-03 04:05:06'].
Uitvoer skryf: t, nuwe-reël.

# fout as teks nie ontleed kan word nie
{ Oomblik vanuit: ['1900']. } vang: { Niks. }, begin.
