>> t := Niks.

# you can control the time zone for
# parsing like this:
Oomblik sone: ['CET'].
t := Oomblik vanuit: ['1981-02-03 04:05:06'].
Uitvoer skryf: t, nuwe-reël.

# now using CEST time zone:
Oomblik sone: ['CEST'].
t := Oomblik vanuit: ['1981-02-03 04:05:06'].
Uitvoer skryf: t, nuwe-reël.

# error if string cannot be parsed
{ Oomblik vanuit: ['1900']. } vang: { Niks. }, begin.
