Uitvoer skryf: ['Test object'], nuwe-reël.
>> a := Objek nuut. 

a by: ['item:'] doen: { :dict
	eie dict := dict. 
}.

a by: ['item'] doen: { <- eie dict.
}.

a item: (
Woordeboek nuut
	hello: ['world']).

>> old-dict-address := a item prototipe geheue-adres.
a save-as: ['/tmp/a.bin'].
Uitvoer skryf: ['========== RELOADING SNAP:'], nuwe-reël.

>> b := Objek load-from: ['/tmp/a.bin'].

(b item prototipe geheue-adres = old-dict-address) ja: {
	Uitvoer skryf: ['Object link re-attached.'], nuwe-reël.
}.

Uitvoer skryf: b item, nuwe-reël.
