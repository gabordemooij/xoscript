Uitvoer skryf: ['Toetsobjek'], nuwe-reël.
>> a := Objek nuut. 

a by: ['item:'] doen: { :wb
	eie wb := wb. 
}.

a by: ['artikel'] doen: {
	<- eie wb.
}.

a item: (
Woordeboek nuut
	hello: ['world']).

>> ou-wb-adres := a artikel prototipe geheue-adres.
a save-as: ['/tmp/a.bin'].
Uitvoer skryf: ['========== HERLAAI SNAP:'], nuwe-reël.

>> b := Objek load-from: ['/tmp/a.bin'].

(b artikel prototipe geheue-adres = ou-wb-adres) ja: {
	Uitvoer skryf: ['Objekskakel weer aangeheg.'], nuwe-reël.
}.

Uitvoer skryf: b artikel, nuwe-reël.
