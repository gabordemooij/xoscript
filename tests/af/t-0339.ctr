
>> a := Objek nuut.

a by: ['kode'] doen: {
	>> antwoord := ['‘A‘']’’. <- antwoord.
}.

>> b := ['B'].

Uitvoer skryf: Lys ← a ; b, nuwe-reël.
Uitvoer skryf: (Woordeboek nuut sit: a by: a), nuwe-reël.
Uitvoer skryf: Lys ← ( Lys ← a ), nuwe-reël.
Uitvoer skryf: (Woordeboek nuut sit: (Woordeboek nuut sit: a by: a) by: (Woordeboek nuut sit: a by: a)), nuwe-reël.
Uitvoer skryf: (Woordeboek nuut sit: (Lys ← a) by: (Lys ← a)), nuwe-reël.
Uitvoer skryf: Lys ← (Woordeboek nuut sit: a by: a), nuwe-reël.

['plak afvoer van hierbo hier, toets of dit ontleedbaar is:'].

Uitvoer skryf: ['-- ontleed-toets --'], nuwe-reël.

>> x1 := Lys ← ['A‘']'] ; ['B'].
>> x2 := (Woordeboek nuut) sit:['A‘']'] by:['A‘']'].
>> x3 := Lys ← (Lys ← ['A‘']']).
>> x4 := (Woordeboek nuut) sit:((Woordeboek nuut) sit:['A‘']'] by:['A‘']']) by:((Woordeboek nuut) sit:['A‘']'] by:['A‘']']).
>> x5 := (Woordeboek nuut) sit:(Lys ← ['A‘']']) by:(Lys ← ['A‘']']).
>> x6 := Lys ← ((Woordeboek nuut) sit:['A‘']'] by:['A‘']']).

Uitvoer skryf: x1, nuwe-reël.
Uitvoer skryf: x2, nuwe-reël.
Uitvoer skryf: x3, nuwe-reël.
Uitvoer skryf: x4, nuwe-reël.
Uitvoer skryf: x5, nuwe-reël.
Uitvoer skryf: x6, nuwe-reël.

