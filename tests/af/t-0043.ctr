>> herhaler := Objek nuut.
herhaler by: ['reageer:'] doen: { :wat
	Uitvoer skryf: wat + [' '].
}.
herhaler by: ['reageer:en:'] doen: { :wat :say
	Uitvoer skryf: wat, skryf: say + [' '].
}.
herhaler by: ['reageer:en:en:'] doen: { :wat :say :meer
	Uitvoer skryf: wat, skryf: say, skryf: meer.
}.
herhaler herhaal.
herhaler everything: ['Ek sê.'].
herhaler and: ['I '] everything: ['doen.'].
