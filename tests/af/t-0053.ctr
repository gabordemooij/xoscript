60 × {
	>> x := (Getal willekeurig % 6) + 1.
	(x ≤ 6) nee: { Uitvoer skryf: ['MISLUK']. }.
	(x ≥0) nee: { Uitvoer skryf: ['MISLUK']. }.
	x := (Getal willekeurig % 3) + 1.
	(x < 3) nee: { Uitvoer skryf: ['MISLUK']. }.
	(x>-1) nee: { Uitvoer skryf: ['MISLUK']. }.
	x := ((Boolees muntgooi) getal).
	(x = 0 of: x = 1) nee: { Uitvoer skryf: ['MISLUK']. }.
	x := ((Ja muntgooi) getal).
	(x = 0 of: x = 1) nee: { Uitvoer skryf: ['MISLUK']. }.
	x := (Boolees muntgooi of: ['KOP'] of: ['STERT']).
	((x = ['KOP']) of: (x = ['STERT'])) nee: { Uitvoer skryf: ['MISLUK']. }.
}.
Uitvoer skryf: ['KLAAR'].

