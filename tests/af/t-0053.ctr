60 × {
	>> x := (Getal random % 6) + 1.
	(x ≤ 6) nee: { Uitvoer skryf: ['FAIL']. }.
	(x ≥0) nee: { Uitvoer skryf: ['FAIL']. }.
	x := (Getal random % 3) + 1.
	(x < 3) nee: { Uitvoer skryf: ['FAIL']. }.
	(x>-1) nee: { Uitvoer skryf: ['FAIL']. }.
	x := ((Boolees flip) getal).
	(x = 0 of: x = 1) nee: { Uitvoer skryf: ['FAIL']. }.
	x := ((Ja flip) getal).
	(x = 0 of: x = 1) nee: { Uitvoer skryf: ['FAIL']. }.
	x := (Boolees flip of: ['HEAD'] of: ['TAIL']).
	((x = ['HEAD']) of: (x = ['TAIL'])) nee: { Uitvoer skryf: ['FAIL']. }.
}.
Uitvoer skryf: ['DONE'].

