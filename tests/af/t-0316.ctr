>> Grandfather := Objek nuut.
Grandfather by: ['greet'] doen: {
	Uitvoer skryf: ['Ave!'], nuwe-reël.
}.
>> Father := Grandfather nuut.
Father by: ['greet'] doen: {
	Uitvoer skryf: ['Hello'], nuwe-reël.
	self greet.
}.
>> Son := Father nuut.
Son by: ['greet'] doen: {
	Uitvoer skryf: ['Hi'], nuwe-reël.
	self greet.
}.

Son greet.

>> Roundabout := Objek nuut.
Roundabout by: ['circle:'] doen: { :x
	Uitvoer skryf: x, nuwe-reël.
	(x < 3) ja: { self rekursief circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) ja: { Uitvoer skryf: x, nuwe-reël. x tel-by: 1.  increment begin. }. }.
increment begin.