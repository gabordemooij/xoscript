>> Oupa := Objek nuut.
Oupa by: ['groet'] doen: {
	Uitvoer skryf: ['Ave!'], nuwe-reël.
}.
>> Pa := Oupa nuut.
Pa by: ['groet'] doen: {
	Uitvoer skryf: ['Hello'], nuwe-reël.
	self groet.
}.
>> Seun := Pa nuut.
Seun by: ['groet'] doen: {
	Uitvoer skryf: ['Haai'], nuwe-reël.
	self groet.
}.

Seun groet.

>> Verkeersirkel := Objek nuut.
Verkeersirkel by: ['circle:'] doen: { :x
	Uitvoer skryf: x, nuwe-reël.
	(x < 3) ja: { self rekursief circle: x + 1. }.
}.

Verkeersirkel circle: 1.

>> x := 1.
>> verhoog := { (x ≤ 3) ja: { Uitvoer skryf: x, nuwe-reël. x tel-by: 1.  verhoog begin. }. }.
verhoog begin.