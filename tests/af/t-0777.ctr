#OBSD
>> dirname := [''].
{ dirname voeg-agter: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Program stelsel: command.
Program chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename voeg-agter: ['YYYYYYYY']. } * 20.
Lêer nuut: filename, skryf: ['sometext'].
{ Lêer lys: ['/tmp/'] + dirname. } * 1000.
Uitvoer skryf: ['no crash'], nuwe-reël.

