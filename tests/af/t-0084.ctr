>> makeAdder := { :x
	>> f := { :y <- (eie x + y). } stel: ['x'] waarde: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i eie q sit: (eie f pas-toe: (eie q ? i)) by: i. } 
	stel: ['q'] waarde: array,
	stel: ['f'] waarde: func.
	{ :i mapping pas-toe: i. } × (array tel).
}.

>> a := Lys ← 1; 2; 3.
mapper pas-toe: a en: (makeAdder pas-toe: 100).
Uitvoer skryf: (a posisie: 0), nuwe-reël.
Uitvoer skryf: (a ? 1), nuwe-reël.
Uitvoer skryf: (a ? 2), nuwe-reël.
