>> maakOpteller := { :x
	>> f := { :y <- (eie x + y). } stel: ['x'] waarde: x. <- f.
}.
>> afbeelder := { :reeks :fnk
	>> afbeelding := { :i eie q sit: (eie f pas-toe: (eie q ? i)) by: i. } 
	stel: ['q'] waarde: reeks,
	stel: ['f'] waarde: fnk.
	{ :i afbeelding pas-toe: i. } × (reeks tel).
}.

>> a := Lys ← 1; 2; 3.
afbeelder pas-toe: a en: (maakOpteller pas-toe: 100).
Uitvoer skryf: (a posisie: 0), nuwe-reël.
Uitvoer skryf: (a ? 1), nuwe-reël.
Uitvoer skryf: (a ? 2), nuwe-reël.
