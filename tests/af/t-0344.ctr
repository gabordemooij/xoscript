# vang-alles-toets (prakties)
>> HTML := Teks nuut.
HTML by: ['encode:'] doen: { :tekst
	self voeg-agter: (tekst
	vervang: ['&'] met: ['&amp;'], 
	vervang: ['<'] met: ['&lt;'],
	vervang: ['>'] met: ['&gt;'],
	vervang: ['"'] met: ['&quot;']).
}.
>> blog := HTML nuut.
blog voeg-agter: ['<h1>'],
     encode: ['Koffie & Thee'],
     voeg-agter: ['</h1>'].
Uitvoer skryf: blog, nuwe-reël.


>> Romeins := Getal nuut.
Romeins by: ['teksagtig'] doen: {
	>> a := [''].
	{ a voeg-agter: ['I']. } × self. <- a.
}.

>> x := Romeins nuut.
x tel-by: 3.
Uitvoer skryf: x teksagtig, nuwe-reël.

>> Kwantum := Boolees nuut.
Kwantum by: ['true?'] doen: { <- ['miskien Ja']. }.
Uitvoer skryf: (Kwantum nuut true?), nuwe-reël.

>> Nihil := Niks nuut.
Nihil by: ['teks'] doen: { <- ['Nihil']. }.
Uitvoer skryf: (Nihil nuut), nuwe-reël.
