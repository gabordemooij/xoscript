# catch-all test (practical)
>> HTML := Teks nuut.
HTML by: ['encode:'] doen: { :tekst
	self voeg-agter: (tekst
	vervang: ['&'] met: ['&amp;'], 
	vervang: ['<'] met: ['&lt;'],
	vervang: ['>'] met: ['&gt;'],
	vervang: ['"'] met: ['&quot;']).
}.
>> blog := HTML nuut.
blog voeg-agter: ['<h1>'],
     encode: ['Koffie & Thee'],
     voeg-agter: ['</h1>'].
Uitvoer skryf: blog, nuwe-reël.


>> Roman := Getal nuut.
Roman by: ['stringy'] doen: {
	>> a := [''].
	{ a voeg-agter: ['I']. } × self. <- a.
}.

>> x := Roman nuut.
x tel-by: 3.
Uitvoer skryf: x stringy, nuwe-reël.

>> Quantum := Boolees nuut.
Quantum by: ['true?'] doen: { <- ['maybe True']. }.
Uitvoer skryf: (Quantum nuut true?), nuwe-reël.

>> Nihil := Niks nuut.
Nihil by: ['teks'] doen: { <- ['Nihil']. }.
Uitvoer skryf: (Nihil nuut), nuwe-reël.
