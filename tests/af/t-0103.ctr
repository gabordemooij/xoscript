>> a := Lys ← Objek ; Ja ; Nee ; Boolees ; 1 ; Getal ; ['Str'] ; Teks ; { ['Empty']. }.
Uitvoer skryf: (a tel), nuwe-reël.
{ :i
	Uitvoer skryf: 
	['a '] + 
	((a ? i) tipe) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Niks?) of: [''] of: ['NOT']) + 
	[' Nil.'],
	nuwe-reël.
} × (a tel).
Uitvoer skryf: ['but.. Nil is.. '] + ((Niks Niks?) of: ['certainly NIL!'] of: ['not NIL??']), nuwe-reël.