>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program geheuebestuur: 0.

{
Oomblik tyd.
Oomblik wag: 1.
Uitvoer skryf: Program argumente, nuwe-reël.
Program argument: 0.
Getal random.
Uitvoer skryf: (Program stelsel: ['echo 'Hello'']).
} begin.

Program ruim-op.
usedMemory1 := (Program geheue ? 0).

{
Oomblik tyd.
Oomblik wag: 1.
Uitvoer skryf: Program argumente, nuwe-reël.
Program argument: 0.
Getal random.
Uitvoer skryf: (Program stelsel: ['echo 'Hello'']).
} begin.

