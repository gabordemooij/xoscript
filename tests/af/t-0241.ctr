

Teks by: ['evaluate'] doen: {
	>> kode := Lêer nuut: ['/tmp/eval.ctr'].
	kode skryf: (self teks + ['.']).
	Program gebruik: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Lys ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q teks.
Uitvoer skryf: x, nuwe-reël.
>> y := Niks.
(['y := '] + x ) evaluate.
Uitvoer skryf: y ? 0, nuwe-reël.

q := Woordeboek sit: ['\[''] by: ['\['quote\']'].
x := q teks.
Uitvoer skryf: x, nuwe-reël.
y := Niks.
(['y := '] + x ) evaluate.

>> q := (Woordeboek nuut) sit:['\[''] by:['\['quote\[''].
Uitvoer skryf: y ? ['\['quote\']'], nuwe-reël.
