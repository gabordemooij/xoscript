Uitvoer skryf: ['Toetsobjek'], nuwe-reël.
>> a := Objek nuut. 
a by: ['item:'] doen: { :lst
	eie lst := lst. 
}.
a by: ['artikel'] doen: {
	<- eie lst.
}.
a item: (
	Lys nuut ; 1 ; (
		Lys nuut ; ['a'] ; (
			Lys nuut ; ( Oomblik nuut: 1 )
		) ; ( Int64 vanuit-teks: ['321'] )
	)
).
Uitvoer skryf: a artikel, nuwe-reël.
>> ou-lst-adres := a artikel prototipe geheue-adres.
a save-as: ['/tmp/a.bin'].
Uitvoer skryf: ['========== HERLAAI SNAP:'], nuwe-reël.
>> b := Objek load-from: ['/tmp/a.bin'].
(b artikel prototipe geheue-adres = ou-lst-adres) ja: {
	Uitvoer skryf: ['Objekskakel weer aangeheg.'], nuwe-reël.
}.
Uitvoer skryf: ( b artikel ), nuwe-reël.
