Uitvoer skryf: ['Test object'], nuwe-reël.
>> a := Objek nuut. 
a by: ['item:'] doen: { :lst
	eie lst := lst. 
}.
a by: ['item'] doen: { <- eie lst.
}.
a item: (
	Lys nuut ; 1 ; (
		Lys nuut ; ['a'] ; (
			Lys nuut ; ( Oomblik nuut: 1 )
		) ; ( Int64 vanuit-teks: ['321'] )
	)
).
Uitvoer skryf: a item, nuwe-reël.
>> old-lst-address := a item prototipe geheue-adres.
a save-as: ['/tmp/a.bin'].
Uitvoer skryf: ['========== RELOADING SNAP:'], nuwe-reël.
>> b := Objek load-from: ['/tmp/a.bin'].
(b item prototipe geheue-adres = old-lst-address) ja: {
	Uitvoer skryf: ['Object link re-attached.'], nuwe-reël.
}.
Uitvoer skryf: ( b item ), nuwe-reël.
