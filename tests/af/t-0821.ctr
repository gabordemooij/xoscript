# 'n aanhalingsteken wat nooit sluit nie, moet 'n fout gee, nie 'n eindelose lus nie
>> pad := ['/tmp/test0821.csv'].
>> file := Lêer nuut: pad.

file skryf: ['a,b\n"1,2\n'].
{
	file skeidingsteken: [','] aanhalingsteken: ['"'] reëls: { :line
		Uitvoer skryf: line, nuwe-reël.
	}.
} vang: { :e Uitvoer skryf: e, nuwe-reël. }, begin.

# 'n geslote aanhalingsteken werk steeds
file skryf: ['a,b\n"1,2",3'].
file skeidingsteken: [','] aanhalingsteken: ['"'] reëls: { :line
	Uitvoer skryf: line, nuwe-reël.
}.
file verwyder.
