Server init.
Uitvoer skryf: ['Database date test'], nuwe-reël.

>> db := Maria-DB nuut gasheer: ['localhost'],
	gebruikersnaam: ['xo'], 
	wagwoord: ['pass123'],
	databasisnaam: ['xobase'],
	verbind.

>> soekparameters :=
db navraag: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
haal: { :row
	Uitvoer skryf: row datetest, nuwe-reël.
}.
