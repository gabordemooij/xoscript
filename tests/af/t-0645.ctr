Server init.
Uitvoer skryf: ['Databasis-datumtoets'], nuwe-reël.

>> db := Maria-DB nuut gasheer: ['localhost'],
	gebruikersnaam: ['xo'], 
	wagwoord: ['pass123'],
	databasisnaam: ['xobase'],
	verbind.

>> soekparameters :=
db navraag: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
haal: { :ry
	Uitvoer skryf: ry datetest, nuwe-reël.
}.
