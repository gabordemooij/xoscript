Boolees by: ['xor:'] doen: { :a :b <- ((a en: b nie) of: (a nie en: b)).
}.

>> o := Objek nuut.
o by: ['hello'] doen: { ['Empty']. }.
{ o by: 2 doen: 3.} vang: { :e Uitvoer skryf: e, nuwe-reël. }, begin.
{ o by: ['toets'] doen: 3.} vang: { :e Uitvoer skryf: e, nuwe-reël. }, begin.
{ o by: ['hello'] doen: { ['Empty']. }.} vang: { :e Uitvoer skryf: e, nuwe-reël. }, begin. 
{ >> z := 4 ÷ 0. } vang: { :e Uitvoer skryf: e, nuwe-reël. }, begin. 
{ (Ja en: Niks) ja: { Uitvoer skryf: ['X'].}. } vang: { :e Uitvoer skryf: e, nuwe-reël. }, begin. 
{ ([''] xor: 0) ja: { Uitvoer skryf: ['X'].}. } vang: { :e Uitvoer skryf: e, nuwe-reël. }, begin. 
{ (1 < ['2']) ja: { Uitvoer skryf: ['OK']. }. } vang: { :e Uitvoer skryf: e, nuwe-reël. }, begin. 
{ (1 < ['2.0']) ja: { Uitvoer skryf: ['OK']. }. } vang: { :e Uitvoer skryf: e, nuwe-reël. }, begin. 
{ (1 < ['x2.0']) ja: { Uitvoer skryf: ['NO!']. }. } vang: { :e Uitvoer skryf: e, nuwe-reël. }, begin. 
{ Uitvoer skryf: (['hello OK there'] vanaf: ['6'] lengte: ['2']). } begin. 
