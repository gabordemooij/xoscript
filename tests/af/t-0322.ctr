

>> Matryoshka := Objek nuut.
Matryoshka by: ['double:'] doen: { :geheim
	eie geheim := geheim × 2.
}.
Matryoshka by: ['nuut:'] doen: { :geheim
	>> antwoord := Niks.
	>> t := (geheim > 255).
	Uitvoer skryf: (geheim + [' | '] + t), nuwe-reël.
	t ja: {
		antwoord := geheim.
	}, anders: {
		antwoord := Matryoshka rekursief nuut: (self double: geheim).
	}. <- antwoord.
}.

>> x := Matryoshka nuut: 2.
