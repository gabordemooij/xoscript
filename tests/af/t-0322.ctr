

>> Matryoshka := Objek nuut.
Matryoshka by: ['double:'] doen: { :secret
	eie secret := secret × 2.
}.
Matryoshka by: ['nuut:'] doen: { :secret
	>> answer := Niks.
	>> t := (secret > 255).
	Uitvoer skryf: (secret + [' | '] + t), nuwe-reël.
	t ja: {
		answer := secret.
	}, anders: {
		answer := Matryoshka rekursief nuut: (self double: secret).
	}. <- answer.
}.

>> x := Matryoshka nuut: 2.
