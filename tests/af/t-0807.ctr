# databasisfoutboodskappe mag nie as formaatstringe hanteer word nie
Server init.

>> db := Maria-DB nuut gasheer: ['localhost'],
	gebruikersnaam: ['xo'],
	wagwoord: ['pass123'],
	databasisnaam: ['xobase'],
	verbind.

>> soekparameters := db navraag: ['SELECT %% FROM'].
{ soekparameters voer-uit. } vang: { :e
	Uitvoer skryf: ( e bevat: ['%%'] ), nuwe-reël.
}, begin.
