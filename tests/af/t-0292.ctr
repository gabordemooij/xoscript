>> winery := { <- (	Woordeboek nuut
		sit: 2 by: ['merlot'],
		sit: 3 by: ['malbec'],
		sit: 4 by: ['syrah']
	).
}.

Uitvoer skryf: (((winery begin) - ['nothing']) tel), nuwe-reël.
Uitvoer skryf: (((winery begin) - ['merlot']) tel), nuwe-reël.
Uitvoer skryf: (((winery begin) - ['malbec']) tel), nuwe-reël.
Uitvoer skryf: (((winery begin) - ['syrah']) tel), nuwe-reël.
Uitvoer skryf: (((winery begin) - ['merlot'] - ['malbec']) tel), nuwe-reël.
Uitvoer skryf: (((winery begin) - ['merlot'] - ['syrah']) tel), nuwe-reël.
Uitvoer skryf: (((winery begin) - ['malbec'] -['syrah']) tel), nuwe-reël.
Uitvoer skryf: (((winery begin) - ['malbec'] - ['syrah'] - ['merlot']) tel), nuwe-reël.

