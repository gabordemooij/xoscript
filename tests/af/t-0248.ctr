

Teks by: ['evalueer'] doen: {
	>> kode := Lêer nuut: ['/tmp/eval.ctr'].
	kode skryf: self teks + ['.'].
	Program gebruik: ['/tmp/eval.ctr'].
}.

>> a := (Lys ← (
	(Woordeboek nuut)
		sit: ['domein'] by: ['mywebsite.com'],
		sit: (Lys ←
			((Woordeboek nuut)
				sit: ['tuis'] by: ['title'],
				sit: ['<html></html>'] by: ['body'],
				sit: ['2017-01-01'] by: ['geskep']
			) ;
			((Woordeboek nuut)
				sit: ['oorons(c)'] by: ['title'],
				sit: ['<credits>Author Inc.</credits>'] by: ['body']
			)
		) by: ['bladsye']
	)
) teks.

Uitvoer skryf: a tipe, nuwe-reël.
Uitvoer skryf: a, nuwe-reël.

>> b := Niks.
(['b := '] + a) evalueer.
Uitvoer skryf: b ? 0 ? ['bladsye'] ? 1 ? ['body'], nuwe-reël.

>> c := b ? 0.
>> d := c teks.
Uitvoer skryf: d tipe, nuwe-reël.

>> e := Niks.
(['e := '] + d) evalueer.
Uitvoer skryf: e ? ['bladsye'] ? 0, nuwe-reël.
