

Teks by: ['evaluate'] doen: {
	>> kode := Lêer nuut: ['/tmp/eval.ctr'].
	kode skryf: self teks + ['.'].
	Program gebruik: ['/tmp/eval.ctr'].
}.

>> a := (Lys ← (
	(Woordeboek nuut)
		sit: ['domain'] by: ['mywebsite.com'],
		sit: (Lys ←
			((Woordeboek nuut)
				sit: ['home'] by: ['title'],
				sit: ['<html></html>'] by: ['body'],
				sit: ['2017-01-01'] by: ['created']
			) ;
			((Woordeboek nuut)
				sit: ['aboutus(c)'] by: ['title'],
				sit: ['<credits>Author Inc.</credits>'] by: ['body']
			)
		) by: ['pages']
	)
) teks.

Uitvoer skryf: a tipe, nuwe-reël.
Uitvoer skryf: a, nuwe-reël.

>> b := Niks.
(['b := '] + a) evaluate.
Uitvoer skryf: b ? 0 ? ['pages'] ? 1 ? ['body'], nuwe-reël.

>> c := b ? 0.
>> d := c teks.
Uitvoer skryf: d tipe, nuwe-reël.

>> e := Niks.
(['e := '] + d) evaluate.
Uitvoer skryf: e ? ['pages'] ? 0, nuwe-reël.
