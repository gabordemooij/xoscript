Server init.

>> x := Blob nuut: 65 tipe: ['char'].
# for this test you need set a path to libc (puts)
>> libname := Program instelling: ['FFITESTLIB'].
Server koppel: (
 Lys nuut ;
 libname ;
 ['putchar'] ;
 ( Lys nuut ; ['char'] ) ;
 ['void'] ;
 ['Print'] ;
 ['char:']
).
Print char: (x vanaf: 0 lengte: 1), nuwe-reël.
x stel-vry.

