
>> woordelys := (
	Woordeboek nuut
		sit: ['b'] by: ['a'],
		sit: ['a'] by: ['b'],
		sit: ['z'] by: ['x'],
		sit: ['hello'] by: ['hallo'],
		sit: ['mens'] by: ['mens']
).

>> vergelykings := Lys nuut.
woordelys elk: { :a :b
	vergelykings ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a vergelyk: b)
	).
}.

vergelykings sorteer: { :a :b <- ( a vergelyk: b ). }.
Uitvoer skryf: ( vergelykings voeg-saam: ['↵'] ), nuwe-reël.
vergelykings voeg-saam: ['↵'].
