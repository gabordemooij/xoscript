
>> dictionary := (
	Woordeboek nuut
		sit: ['b'] by: ['a'],
		sit: ['a'] by: ['b'],
		sit: ['z'] by: ['x'],
		sit: ['hello'] by: ['hallo'],
		sit: ['human'] by: ['human']
).

>> comparisons := Lys nuut.
dictionary elk: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a vergelyk: b)
	).
}.

comparisons sorteer: { :a :b <- ( a vergelyk: b ). }.
Uitvoer skryf: ( comparisons voeg-saam: ['↵'] ), nuwe-reël.
comparisons voeg-saam: ['↵'].
