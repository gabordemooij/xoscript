Teks by: ['html'] doen: { <- (
		self
		vervang: ['&'] met: ['&amp;'],
		vervang: ['<'] met: ['&lt;'],
		vervang: ['>'] met: ['&gt;'],
		vervang: ['''] met: ['&apos;'],
		vervang: ['"'] met: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program geheuebestuur: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Uitvoer skryf: txt kopieer html, nuwe-reël.
Uitvoer skryf: txt kopieer kleinletters, nuwe-reël.
Uitvoer skryf: txt kopieer hoofletters, nuwe-reël.
} begin.

Program ruim-op.

usedMemory1 := (Program geheue ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Uitvoer skryf: txt kopieer html, nuwe-reël.
Uitvoer skryf: txt kopieer kleinletters, nuwe-reël.
Uitvoer skryf: txt kopieer hoofletters, nuwe-reël.
} begin.

Program ruim-op.
usedMemory2 := (Program geheue ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Uitvoer skryf: txt kopieer html, nuwe-reël.
Uitvoer skryf: txt kopieer kleinletters, nuwe-reël.
Uitvoer skryf: txt kopieer hoofletters, nuwe-reël.
} begin.

Program ruim-op.
usedMemory3 := (Program geheue ? 0).



( usedMemory1 = usedMemory2 en: usedMemory1 = usedMemory3, en: usedMemory2 = usedMemory3 ) ja: {
	Uitvoer skryf: ['No memory leaks here'].
}, nee: {
	Uitvoer skryf: ['Leaking memory...'].
}.
