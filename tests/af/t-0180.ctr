Teks by: ['html'] doen: { <- (
		self
		vervang: ['&'] met: ['&amp;'],
		vervang: ['<'] met: ['&lt;'],
		vervang: ['>'] met: ['&gt;'],
		vervang: ['''] met: ['&apos;'],
		vervang: ['"'] met: ['&quot;']
	).
}.

>> gebruikteGeheue1 := 0.
>> gebruikteGeheue2 := 0.
>> gebruikteGeheue3 := 0.
>> gebruikteGeheue4 := 0.

Program geheuebestuur: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Uitvoer skryf: txt kopieer html, nuwe-reël.
Uitvoer skryf: txt kopieer kleinletters, nuwe-reël.
Uitvoer skryf: txt kopieer hoofletters, nuwe-reël.
} begin.

Program ruim-op.

gebruikteGeheue1 := (Program geheue ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Uitvoer skryf: txt kopieer html, nuwe-reël.
Uitvoer skryf: txt kopieer kleinletters, nuwe-reël.
Uitvoer skryf: txt kopieer hoofletters, nuwe-reël.
} begin.

Program ruim-op.
gebruikteGeheue2 := (Program geheue ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Uitvoer skryf: txt kopieer html, nuwe-reël.
Uitvoer skryf: txt kopieer kleinletters, nuwe-reël.
Uitvoer skryf: txt kopieer hoofletters, nuwe-reël.
} begin.

Program ruim-op.
gebruikteGeheue3 := (Program geheue ? 0).



( gebruikteGeheue1 = gebruikteGeheue2 en: gebruikteGeheue1 = gebruikteGeheue3, en: gebruikteGeheue2 = gebruikteGeheue3 ) ja: {
	Uitvoer skryf: ['Geen geheuelekke hier nie'].
}, nee: {
	Uitvoer skryf: ['Geheue lek...'].
}.
