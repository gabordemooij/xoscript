# Hierdie toets kyk of string_fill_in nie sy gleuf verloor nie (deur GC opgeruim) in modus 4
# verwysing in world.c
>> Logboek := Objek nuut.

Logboek by: ['say:'] doen: { :str
	Uitvoer skryf: str, nuwe-reël.
}.

>> Artikel := Objek nuut.

Artikel by: ['nuut:'] doen: { :id
	<- self nuut id: id.
}.

Artikel by: ['id:'] doen: { :id
	eie id := id.
}.

Artikel by: ['id'] doen: { <- eie id. }.


Artikel by: ['teks'] doen: {
	>> str := ['Item#~no'].
	str ~no: eie id.
	<- str.
}.


>> Print := Objek nuut.

Print by: ['items'] doen: { 
	
	eie artikel := Artikel nuut: 1.
	
	# óf segfault óf verkeerde teks hier
	Logboek say: (
		['~item printed.'] ~item: eie artikel
	).
	
	
}.

Print items.