# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := Objek nuut.

Log by: ['say:'] doen: { :str
	Uitvoer skryf: str, nuwe-reël.
}.

>> Item := Objek nuut.

Item by: ['nuut:'] doen: { :id <- self nuut id: id.
}.

Item by: ['id:'] doen: { :id
	eie id := id.
}.

Item by: ['id'] doen: { <- eie id. }.


Item by: ['teks'] doen: {
	>> str := ['Item#~no'].
	str ~no: eie id. <- str.
}.


>> Print := Objek nuut.

Print by: ['items'] doen: { 
	
	eie item := Item nuut: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: eie item
	).
	
	
}.

Print items.