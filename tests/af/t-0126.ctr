#Linux
>> Slurp := Objek nuut.

Slurp by: ['nuut'] doen: {
	eie str := [''].
}.

Slurp by: ['nieuw'] doen: {
	eie str := [''].
}.

Slurp by: ['reageer:'] doen: { :blah
		eie str voeg-agter: blah.
}.

Slurp by: ['reageer:en:'] doen: { :blah :blahah
		eie str voeg-agter: (blah vanaf: 0 lengte: (blah lengte - 1)).
		eie str voeg-agter: [' '].
		eie str voeg-agter: blahah.
}.

Slurp by: ['obtain'] doen: {
	>> buffer := eie str.
	eie str := ['']. <- buffer.
}.


Uitvoer skryf: (Program stelsel: (Slurp nuut echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Lêer nuut: ['/tmp/from.txt'], verwyder. } vang: { ['Empty']. }, begin.
{ Lêer nuut: ['/tmp/to.txt'], verwyder. } vang: { ['Empty']. }, begin.


Lêer nuut: ['/tmp/to.txt'], bestaan nee: {
	Uitvoer skryf: ['Confirmed. Target file does not exist.\
'].
}.
Lêer nuut: ['/tmp/from.txt'], bestaan nee: {
	Uitvoer skryf: ['Confirmed. Source file does not exist.\
'].
}.



Program stelsel: (Slurp nuut touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Program stelsel: (Slurp nuut cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Lêer nuut: ['/tmp/to.txt'], bestaan ja: {
	Uitvoer skryf: ['Confirmed. Target file has been created by shell.\
'].
}.


Uitvoer skryf: ['Contents of file is:'] + (Lêer nuut: ['/tmp/to.txt'], lees), nuwe-reël.
