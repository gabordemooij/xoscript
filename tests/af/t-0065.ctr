Getal by: ['fakulteit'] doen: {
	>> totaal := 1.
	{ :indeks totaal vermenigvuldig-met: (self - (indeks)). } × self. <- totaal.
}.
>> Drukker := Objek nuut.
Drukker by: ['druk:en:'] doen: { :x :y
	Uitvoer skryf: ['a='] + x + [', b='] + y, nuwe-reël.
}.
>> a := 4.5. >> b := a rond-af.
Drukker druk: a en: b.
a := 4. b := a fakulteit.
Drukker druk: a en: b.
a := 4.5. b := a rond-op.
Drukker druk: a en: b.
a := 4.5. b := a rond-af.
Drukker druk: a en: b.
a := 4.5. b := a afgerond.
Drukker druk: a en: b.
a := 4.2. b := a afgerond.
Drukker druk: a en: b.

Uitvoer skryf: (9 modulo: 5), nuwe-reël.
Uitvoer skryf: -666 absoluut, nuwe-reël.
Uitvoer skryf: 49 vierkantswortel, nuwe-reël.
Uitvoer skryf: (2 tot-die-mag: 3), nuwe-reël.
>> l := (Lys ← 9 ; 6).
Uitvoer skryf: l minimum.

