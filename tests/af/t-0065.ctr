Getal by: ['factorial'] doen: {
	>> total := 1.
	{ :index total vermenigvuldig-met: (self - (index)). } × self. <- total.
}.
>> Printer := Objek nuut.
Printer by: ['print:and:'] doen: { :x :y
	Uitvoer skryf: ['a='] + x + [', b='] + y, nuwe-reël.
}.
>> a := 4.5. >> b := a rond-af.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a rond-op.
Printer print: a and: b.
a := 4.5. b := a rond-af.
Printer print: a and: b.
a := 4.5. b := a afgerond.
Printer print: a and: b.
a := 4.2. b := a afgerond.
Printer print: a and: b.

Uitvoer skryf: (9 modulo: 5), nuwe-reël.
Uitvoer skryf: -666 absoluut, nuwe-reël.
Uitvoer skryf: 49 vierkantswortel, nuwe-reël.
Uitvoer skryf: (2 tot-die-mag: 3), nuwe-reël.
>> l := (Lys ← 9 ; 6).
Uitvoer skryf: l minimum.

