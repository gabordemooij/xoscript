


>> wyn := Objek nuut.


wyn by: ['naTeks'] doen: { <- ['merlot'].
}.

wyn by: ['naarTekst'] doen: { <- ['merlot'].
}.


wyn by: ['='] doen: { :other wine <- ( self naTeks = other wine ).
}.

wyn by: ['=='] doen: { :other wine <- ( self naTeks = other wine ).
}.



wyn
	geval: ['cabernet'] doen: { Uitvoer skryf: ['dis 'n Cabernet!']. },
	geval: ['syrah']    doen: { Uitvoer skryf: ['dis 'n Syrah!'].    },
	geval: ['merlot']   doen: { Uitvoer skryf: ['dis 'n Merlot!'].   },
	geval: ['malbec']   doen: { Uitvoer skryf: ['dis 'n Malbec!'].   }.

Uitvoer nuwe-reël.
