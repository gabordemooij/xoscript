


>> wine := Objek nuut.


wine by: ['toString'] doen: { <- ['merlot'].
}.

wine by: ['naarTekst'] doen: { <- ['merlot'].
}.


wine by: ['='] doen: { :other wine <- ( self toString = other wine ).
}.

wine by: ['=='] doen: { :other wine <- ( self toString = other wine ).
}.



wine
	geval: ['cabernet'] doen: { Uitvoer skryf: ['it's a Cabernet!']. },
	geval: ['syrah']    doen: { Uitvoer skryf: ['it's a Syrah!'].    },
	geval: ['merlot']   doen: { Uitvoer skryf: ['it's a Merlot!'].   },
	geval: ['malbec']   doen: { Uitvoer skryf: ['it's a Malbec!'].   }.

Uitvoer nuwe-reël.
