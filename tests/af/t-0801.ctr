Server init.

>> db := Maria-DB nuut gasheer: ['localhost'],
	gebruikersnaam: ['xo'],
	wagwoord: ['pass123'],
	databasisnaam: ['xobase'],
	verbind.

>> verw := db navraag: ['DELETE FROM book WHERE id > 0'].
{  verw voer-uit. db bevestig. } vang: { :e db rol-terug.  }, begin.

>> tel := db navraag: ['SELECT COUNT(*) AS num FROM book'].
tel haal: { :ry Uitvoer skryf: ry num, nuwe-reël. }.
