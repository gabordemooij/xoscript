>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objek nuut.
⚄ by: ['trekUit:lengte:'] doen: { :poel :tel
	
	>> resultaat := [''].
	
	{
		>> indeks := Getal willekeurig % (poel lengte).
		resultaat voeg-agter: ( poel letter: (indeks + 1) ).
		
	} × tel. <- resultaat.
}.

>> willekeurig := ⚄ trekUit: ?? lengte: ?? lengte.
Uitvoer skryf: (['x↵'] x willekeurig lengte).
Uitvoer skryf: (['y↵'] y ?? lengte).

