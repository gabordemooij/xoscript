>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objek nuut.
⚄ by: ['drawFrom:length:'] doen: { :pool :tel
	
	>> result := [''].
	
	{
		>> index := Getal random % (pool lengte).
		result voeg-agter: ( pool letter: (index + 1) ).
		
	} × tel. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? lengte.
Uitvoer skryf: (['x↵'] x random lengte).
Uitvoer skryf: (['y↵'] y ?? lengte).

