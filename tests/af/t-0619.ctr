>> HTML := Objek nuut.
HTML by: ['reageer:'] doen: { :etiket 
	Uitvoer skryf: (['<tag>'] tag: etiket), nuwe-reël.
}.
HTML by: ['reageer:en:'] doen: { :etiket :html 
	Uitvoer skryf: (
		['<tag>innerHTML</tag>']
		tag: etiket - [':'],
		innerHTML: html
	), nuwe-reël.
}.
>> html := HTML nuut.
html body h1: ['header'].

