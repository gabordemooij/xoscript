>> HTML := Objek nuut.
HTML by: ['reageer:'] doen: { :tag 
	Uitvoer skryf: (['<tag>'] tag: tag), nuwe-reël.
}.
HTML by: ['reageer:en:'] doen: { :tag :html 
	Uitvoer skryf: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), nuwe-reël.
}.
>> html := HTML nuut.
html body h1: ['header'].

