Server init.
Uitvoer skryf: ['Databasis-datumtydtoets'], nuwe-reël.

>> db := Maria-DB nuut gasheer: ['localhost'],
	gebruikersnaam: ['xo'], 
	wagwoord: ['pass123'],
	databasisnaam: ['xobase'],
	verbind.

>> soekparameters :=
db navraag: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
haal: { :ry
	Uitvoer skryf: ry datetimetest, nuwe-reël.
}.
