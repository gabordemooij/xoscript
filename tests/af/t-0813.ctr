# line breaks in values must not create extra headers
Server inisialiseer.
Program gebruik: ['../../../src/xo/af/webtools.xo'].
Program gebruik: ['../../../src/xo/af/mailtools.xo'].

>> kopstuk := HTTP-Kop nuut sleutel: ['Location'] waarde: ['/ok\r\nX-Injected: yes'].
Uitvoer skryf: kopstuk.

>> web := Webdokument nuut.
web gaan-na: ['/ok\r\nX-Injected: yes'].
Uitvoer skryf: ['\n'], nuwe-reël.

>> mail := E-pos nuut.
mail aan: (Lys nuut ; ['a@example.invalid\r\nX-To: yes']).
mail cc: (Lys nuut ; ['b@example.invalid\r\nX-Cc: yes']).
mail bcc: (Lys nuut ; ['c@example.invalid\r\nX-Bcc: yes']).
mail afsender: ['d@example.invalid\r\nX-From: yes'] naam: ['site\r\nX-Name: yes'].
mail onderwerp: ['hello\r\nX-Subject: yes'].
mail boodskapteks: ['line1\r\nline2'].
Uitvoer skryf: mail genereer.

>> html := HTML-E-pos nuut.
html aan: (Lys nuut ; ['a@example.invalid\r\nX-To: yes']).
html afsender: ['d@example.invalid'] naam: ['site'].
html onderwerp: ['hello\r\nX-Subject: yes'].
html boodskapteks: ['body'].
Uitvoer skryf: ( html genereer bevat: ['\nX-'] ), nuwe-reël.
Uitvoer skryf: ( html genereer bevat: ['X-To: yes'] ), nuwe-reël.
