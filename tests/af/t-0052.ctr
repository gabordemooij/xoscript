>> items := Woordeboek nuut.
items sit: ['groen'] by: ['kleur-1'].
items sit: ['oranje'] by: ['kleur-2'].
items sit: ['rooi'] by: ['kleur-3'].
>> i := 0.
>> s := [''].
items elk: { :key :kleur
	Uitvoer skryf: ['color #'] + i + [' is: '] + kleur + [' '].
	i tel-by: 1.
}.
Uitvoer skryf: i + [' kleure!'].
