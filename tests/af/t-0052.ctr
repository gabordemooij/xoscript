>> items := Woordeboek nuut.
items sit: ['green'] by: ['color-1'].
items sit: ['orange'] by: ['color-2'].
items sit: ['red'] by: ['color-3'].
>> i := 0.
>> s := [''].
items elk: { :key :color
	Uitvoer skryf: ['color #'] + i + [' is: '] + color + [' '].
	i tel-by: 1.
}.
Uitvoer skryf: i + [' colors!'].
