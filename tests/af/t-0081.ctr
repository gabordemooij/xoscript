>> map1 := Woordeboek nuut.
>> key1 := Lys nuut.
>> key2 := Lys nuut.

map1
	sit: ['hello'] by: key1,
	sit: ['world'] by: key2.


Uitvoer
	skryf: ['Map #1 contains: '] + (map1 by: key1),
	skryf: [' and '] + (map1 by: key2), nuwe-reël.

>> KeyeableArray := Lys nuut.
KeyeableArray by: ['toString'] doen: { <- (self tel) toString.
}.

>> map2 := Woordeboek nuut.
key1 := KeyeableArray nuut.
key2 := KeyeableArray nuut.

key1 voeg-agter: 1.

map2
	sit: ['hello'] by: key1,
	sit: ['world'] by: key2.

Uitvoer
	skryf: ['Map #2 contains: '] + (map2 by: key1),
	skryf: [' and '] + (map2 by: key2), nuwe-reël.
