>> kaart1 := Woordeboek nuut.
>> sleutel1 := Lys nuut.
>> sleutel2 := Lys nuut.

kaart1
	sit: ['hello'] by: sleutel1,
	sit: ['world'] by: sleutel2.


Uitvoer
	skryf: ['Map #1 contains: '] + (kaart1 by: sleutel1),
	skryf: [' en '] + (kaart1 by: sleutel2), nuwe-reël.

>> SleutelbareLys := Lys nuut.
SleutelbareLys by: ['naTeks'] doen: { <- (self tel) naTeks.
}.

>> map2 := Woordeboek nuut.
sleutel1 := SleutelbareLys nuut.
sleutel2 := SleutelbareLys nuut.

sleutel1 voeg-agter: 1.

map2
	sit: ['hello'] by: sleutel1,
	sit: ['world'] by: sleutel2.

Uitvoer
	skryf: ['Map #2 contains: '] + (map2 by: sleutel1),
	skryf: [' en '] + (map2 by: sleutel2), nuwe-reël.
