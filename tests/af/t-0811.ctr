# vanaf:lengte: tel letters en oorleef baie groot getalle
>> s := ['ééééééééééééééé'].
Uitvoer skryf: (s kopieer vanaf: 0 lengte: 20), nuwe-reël.
Uitvoer skryf: (s kopieer vanaf: 10 lengte: 20), nuwe-reël.
Uitvoer skryf: (s kopieer vanaf: 14 lengte: 1), nuwe-reël.
Uitvoer skryf: (s kopieer verskuiwing: 20), nuwe-reël.
Uitvoer skryf: ['-'], nuwe-reël.
Uitvoer skryf: (['abcdef'] vanaf: 2 lengte: 2), nuwe-reël.
Uitvoer skryf: (['abc'] vanaf: 1 lengte: ['9e300'] getal), nuwe-reël.
Uitvoer skryf: (['abc'] vanaf: 1 lengte: ['-9e300'] getal), nuwe-reël.
Uitvoer skryf: (['abc'] vanaf: ['9e300'] getal lengte: 1), nuwe-reël.
Uitvoer skryf: ['-'], nuwe-reël.
Uitvoer skryf: (['abc'] vanaf: ['-9e300'] getal lengte: 2), nuwe-reël.
Uitvoer skryf: (['abc'] vanaf: ['nan'] getal lengte: 2), nuwe-reël.
Uitvoer skryf: (['abc'] vanaf: 0 lengte: ['nan'] getal), nuwe-reël.
Uitvoer skryf: ['-'], nuwe-reël.
