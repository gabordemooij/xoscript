
Uitvoer skryf: ['Onderbreek for-lus, 0-4.'], nuwe-reël.
{ :i
	Uitvoer skryf: ['iteration #'] + i, nuwe-reël.
	(i = 4) onderbreek.
} × 10.

>> x := 0.
>> xIsMinderAs10 := { <- ( x < 10 ). }.

Uitvoer skryf: ['Onderbreek while-true-lus, 0-4.'], nuwe-reël.
{
	Uitvoer skryf: ['iteration #'] + x, nuwe-reël.
	x tel-by: 1.
	((x < 5) nie) onderbreek.
} terwyl: xIsMinderAs10.

Uitvoer skryf: ['Onderbreek while-false-lus, 5,4.'], nuwe-reël.
{
	Uitvoer skryf: ['iteration #'] + x, nuwe-reël.
	x trek-af: 1.
	(x = 3) onderbreek.
} terwyl: { <- (x > 0). }.

Uitvoer skryf: ['Onderbreek times-lus, 1-4.'], nuwe-reël.
{ :i
	Uitvoer skryf: ['iteration #'] + i, nuwe-reël.
	(i = 4) onderbreek.
} × 5.

Uitvoer skryf: ['Onderbreek blok, moenie reël druk nie.'], nuwe-reël.
{ Ja onderbreek. Uitvoer skryf: ['moenie dit skryf nie!'], nuwe-reël. } begin.

Uitvoer skryf: ['Onderbreek blok, moenie vang aktiveer nie...'], nuwe-reël.
{ Ja onderbreek. Uitvoer skryf: ['moenie dit skryf nie!'], nuwe-reël. } vang: { Uitvoer skryf: ['Moenie dit vang nie!']. }, begin.

Uitvoer skryf: ['Toets Lys elk-lus: 0,1'], nuwe-reël.
(Lys ← 1 ; 2 ; 3) beeld-af: { :i
	Uitvoer skryf: ['iteration #'] + i, nuwe-reël.
	(i = 1) onderbreek.
}.

Uitvoer skryf: ['Toets Kaart elk-lus: slegs c'], nuwe-reël.
>> m := Woordeboek nuut.
m sit: ['first'] by: ['a'], sit: ['second'] by: ['b'], sit: ['derde'] by: ['c'].
m elk: { :k :v
	Uitvoer skryf: ['iteration'] + v + k, nuwe-reël.
	Ja onderbreek.
}.

