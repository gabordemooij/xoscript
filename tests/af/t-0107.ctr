
Uitvoer skryf: ['Break for-loop, 0-4.'], nuwe-reël.
{ :i
	Uitvoer skryf: ['iteration #'] + i, nuwe-reël.
	(i = 4) onderbreek.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Uitvoer skryf: ['Break while-true loop, 0-4.'], nuwe-reël.
{
	Uitvoer skryf: ['iteration #'] + x, nuwe-reël.
	x tel-by: 1.
	((x < 5) nie) onderbreek.
} terwyl: xIsLessThan10.

Uitvoer skryf: ['Break while-false loop, 5,4.'], nuwe-reël.
{
	Uitvoer skryf: ['iteration #'] + x, nuwe-reël.
	x trek-af: 1.
	(x = 3) onderbreek.
} terwyl: { <- (x > 0). }.

Uitvoer skryf: ['Break times loop, 1-4.'], nuwe-reël.
{ :i
	Uitvoer skryf: ['iteration #'] + i, nuwe-reël.
	(i = 4) onderbreek.
} × 5.

Uitvoer skryf: ['Break block, dont print line.'], nuwe-reël.
{ Ja onderbreek. Uitvoer skryf: ['dont write this!'], nuwe-reël. } begin.

Uitvoer skryf: ['Break block, dont fire catch...'], nuwe-reël.
{ Ja onderbreek. Uitvoer skryf: ['dont write this!'], nuwe-reël. } vang: { Uitvoer skryf: ['Dont catch this!']. }, begin.

Uitvoer skryf: ['Test Array each-loop: 0,1'], nuwe-reël.
(Lys ← 1 ; 2 ; 3) beeld-af: { :i
	Uitvoer skryf: ['iteration #'] + i, nuwe-reël.
	(i = 1) onderbreek.
}.

Uitvoer skryf: ['Test Map each-loop: c only'], nuwe-reël.
>> m := Woordeboek nuut.
m sit: ['first'] by: ['a'], sit: ['second'] by: ['b'], sit: ['third'] by: ['c'].
m elk: { :k :v
	Uitvoer skryf: ['iteration'] + v + k, nuwe-reël.
	Ja onderbreek.
}.

