Uitvoer skryf: ((Lys nuut
	by: ['plaque:'] doen: { :x eie o := x. },
	by: ['plaque']  doen: { <- eie o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Lys ← 1)
	~ (Lys ← 1 ; 2)
	~ (Lys ← 1 ; 2 ; 3)
	~ (Lys ← 1 ; 2 ; 3 ; 4)
	~ (Lys ← 1 ; 2 ; 3 ; 4 ; 5)
) elk: { :i :el
	{ Uitvoer skryf: hierdie-taak. } × el tel.
	Uitvoer nuwe-reël.
}) plaque, nuwe-reël.


