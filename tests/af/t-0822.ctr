# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := Maria-DB nuut gasheer: ['localhost'],
	gebruikersnaam: ['xo'],
	wagwoord: ['pass123'],
	databasisnaam: ['xobase'],
	verbind.

>> soekparameters := db navraag: ['SELECT ? AS a, ? AS b, ? AS c'].
soekparameters parameters: (Lys nuut ; ['1']).
{ soekparameters haal: { :row Uitvoer skryf: row, nuwe-reël. }. } vang: { :e Uitvoer skryf: e, nuwe-reël. }, begin.

>> soekparameters := db navraag: ['SELECT ? AS a'].
{ soekparameters haal: { :row Uitvoer skryf: row, nuwe-reël. }. } vang: { :e Uitvoer skryf: e, nuwe-reël. }, begin.

# the right number still works, more parameters are ignored as before
>> soekparameters := db navraag: ['SELECT ? AS a, ? AS b'].
soekparameters parameters: (Lys nuut ; ['1'] ; ['2']).
soekparameters haal: { :row Uitvoer skryf: (row by: ['a']), skryf: (row by: ['b']), nuwe-reël. }.
soekparameters parameters: (Lys nuut ; ['1'] ; ['2'] ; ['3']).
soekparameters haal: { :row Uitvoer skryf: (row by: ['a']), skryf: (row by: ['b']), nuwe-reël. }.
