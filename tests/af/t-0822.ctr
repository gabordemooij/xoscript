# minder parameters as plekhouers moet 'n fout gee, nie verby die bindings lees nie
Server init.

>> db := Maria-DB nuut gasheer: ['localhost'],
	gebruikersnaam: ['xo'],
	wagwoord: ['pass123'],
	databasisnaam: ['xobase'],
	verbind.

>> soekparameters := db navraag: ['SELECT ? AS a, ? AS b, ? AS c'].
soekparameters parameters: (Lys nuut ; ['1']).
{ soekparameters haal: { :ry Uitvoer skryf: ry, nuwe-reël. }. } vang: { :e Uitvoer skryf: e, nuwe-reël. }, begin.

>> soekparameters := db navraag: ['SELECT ? AS a'].
{ soekparameters haal: { :ry Uitvoer skryf: ry, nuwe-reël. }. } vang: { :e Uitvoer skryf: e, nuwe-reël. }, begin.

# die regte aantal werk steeds, meer parameters word soos voorheen geïgnoreer
>> soekparameters := db navraag: ['SELECT ? AS a, ? AS b'].
soekparameters parameters: (Lys nuut ; ['1'] ; ['2']).
soekparameters haal: { :ry Uitvoer skryf: (ry by: ['a']), skryf: (ry by: ['b']), nuwe-reël. }.
soekparameters parameters: (Lys nuut ; ['1'] ; ['2'] ; ['3']).
soekparameters haal: { :ry Uitvoer skryf: (ry by: ['a']), skryf: (ry by: ['b']), nuwe-reël. }.
