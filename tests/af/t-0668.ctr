# dekodeer van utf16le/be of utf32le/be na utf8
Server init.
>> utf16 := Blob nuut: 8, bytes: (
	Lys nuut ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Uitvoer skryf: ( utf16 dekodeer: ['utf16le'] ), nuwe-reël.

utf16 stel-vry.
>> utf32 := Blob nuut: 13, bytes: (
	Lys nuut ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Uitvoer skryf: ( utf32 dekodeer: ['utf32be'] ), nuwe-reël.
utf32 stel-vry.