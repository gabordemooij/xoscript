Teks by: ['evalueer'] doen: {
	>> kode := Lêer nuut: ['/tmp/eval.ctr'].
	kode skryf: (self teks + ['.']).
	Program gebruik: ['/tmp/eval.ctr'].
}.

>> a := Lys ← 1 ; 2 ; 3.
>> b := (a teks).

Uitvoer skryf: b, nuwe-reël. 
(['b := '] + b) evalueer.

Uitvoer skryf: b ? 2, nuwe-reël. 

Uitvoer skryf: (( Lys ← 1 ; 2 ; 3 )), nuwe-reël. 

Uitvoer skryf: ((Woordeboek nuut) sit: 1 by: 2), nuwe-reël. 

>> x := ( (Lys ← 1 ; ( Lys ← 9 ) ; Ja ) ) teks.
Uitvoer skryf: x, nuwe-reël. 
(['x := '] + x) evalueer.

Uitvoer skryf: x ? 1 ? 0, nuwe-reël. 

>> y := (Woordeboek nuut) sit: (Lys ← 1) by: (Lys ← 2).
Uitvoer skryf: y, nuwe-reël. 

(['y := '] + y) teks evalueer.

Uitvoer skryf: (y by: (Lys ← 2) teks ), nuwe-reël.

Uitvoer skryf: (Lys nuut), nuwe-reël. 
Uitvoer skryf: (Woordeboek nuut), nuwe-reël. 
