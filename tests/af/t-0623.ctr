

>> g  := Server nuut.
>> v  := Kluis nuut.
>> ok := 0.

>> geheime := Lys nuut ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> wagwoorde := geheime kopieer.
wagwoorde elk: { :i :p
	geheime elk: { :n :s
		{
			>> geënkripteer := v enkripteer: s sleutel: p.
			>> gedekripteer := v dekripteer: geënkripteer sleutel: p.
			(gedekripteer = s) ja: {
				ok tel-by: 1.
			}, anders: {
				Uitvoer skryf: ['enkripsie/dekripsie het misluk: '], nuwe-reël.
				Uitvoer skryf: s, nuwe-reël.
				Uitvoer skryf: ['geënkripteer: '] + geënkripteer, nuwe-reël.
				Uitvoer skryf: ['gedekripteer: '] + geënkripteer, nuwe-reël.
				Program einde.
			}.
		} vang: { :flt
			(s = [''] of: p = ['']) ja: {
				ok tel-by: 1.
			}, anders: {
				Uitvoer skryf: flt, nuwe-reël.
				Program einde.
			}.
		}, begin.
	}.
}.

Uitvoer skryf: ( ok + [' kluis-enkripsies getoets.'] ), nuwe-reël.