
>> Size := Objek nuut.
Size by: ['is:'] doen: { :getal
	getal by: ['+'] doen: { :getal
		>> unit := getal kwalifiseerder.
		>> factor := 1.
		
		unit
		geval: ['inch'] doen: { factor := 0.0833. }. <- self + (getal * factor).
	}. <- getal.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Uitvoer skryf: plank + edge, nuwe-reël.
