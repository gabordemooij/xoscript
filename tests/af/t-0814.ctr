# sessiekoekie-formaat, json-inhoudstipe, slegs webprotokolle, svg inlyn gewys
Server inisialiseer.
Program gebruik: ['../../../src/xo/af/webtools.xo'].

>> Vals-Versoek := Objek nuut.
Vals-Versoek by: ['value:'] doen: { :waarde
	eie waarde := waarde.
}.
Vals-Versoek by: ['cookie:'] doen: { :naam
	<- eie waarde.
}.

>> Toets-Sessie := Tydelike-lêer-sessie nuut.
Toets-Sessie by: ['laai'] doen: {
	<- Woordeboek nuut.
}.
Toets-Sessie by: ['sessie-kenmerk'] doen: {
	<- eie id.
}.

>> koekies := Lys nuut
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

koekies elk: { :i :koekie
	>> versoek := Vals-Versoek nuut.
	versoek value: koekie.
	>> bestuurder := Toets-Sessie nuut.
	>> web := Webdokument nuut.
	web versoek: versoek.
	web sessiebestuurder: bestuurder.
	web sessie-begin.
	Uitvoer skryf: ( bestuurder sessie-kenmerk = koekie ), nuwe-reël.
}.

>> web := Webdokument nuut.
web json: (Woordeboek nuut sit: ['b'] by: ['a']).
Uitvoer skryf: ['\n'], nuwe-reël.

{ Netwerk get: ['file:///etc/hostname']. } vang: { :e
	Uitvoer skryf: e, nuwe-reël.
}, begin.

>> svg := Lêer nuut: ['/tmp/test0814.svg'].
svg skryf: ['<svg xmlns="x"></svg>'].
Uitvoer nuwe-reël.
Server gee-deur: ['test0814.svg'] voorvoegsel: ['/tmp/'].
svg verwyder.
