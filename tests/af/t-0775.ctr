Uitvoer skryf: ['Test object'], nuwe-reël.
>> l := Lys nuut ; 1 ; ( Lys nuut ; (Oomblik nuut: 1) ; (Int64 vanuit-teks: ['321']) ; (Lys nuut ; 3)).
Uitvoer skryf: l, nuwe-reël.
>> old-lst-address := l prototipe geheue-adres.
l save-as: ['/tmp/a.bin'].
Uitvoer skryf: ['========== RELOADING SNAP:'], nuwe-reël.
>> b := Objek load-from: ['/tmp/a.bin'].
(b prototipe geheue-adres = old-lst-address) ja: {
	Uitvoer skryf: ['Object link re-attached.'], nuwe-reël.
}.
Uitvoer skryf: b, nuwe-reël.
