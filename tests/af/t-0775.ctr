Uitvoer skryf: ['Toetsobjek'], nuwe-reël.
>> l := Lys nuut ; 1 ; ( Lys nuut ; (Oomblik nuut: 1) ; (Int64 vanuit-teks: ['321']) ; (Lys nuut ; 3)).
Uitvoer skryf: l, nuwe-reël.
>> ou-lst-adres := l prototipe geheue-adres.
l save-as: ['/tmp/a.bin'].
Uitvoer skryf: ['========== HERLAAI SNAP:'], nuwe-reël.
>> b := Objek load-from: ['/tmp/a.bin'].
(b prototipe geheue-adres = ou-lst-adres) ja: {
	Uitvoer skryf: ['Objekskakel weer aangeheg.'], nuwe-reël.
}.
Uitvoer skryf: b, nuwe-reël.
