

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program hukommelsesstyring: 0.

>> txt := ['Word Salad'].
Uddata skriv: ['last index of ord = '] + (( txt sidste: ['ord'] ) - 0), stop.
Uddata skriv: ['index of ord = '] + (( txt find: ['ord'] ) - 0), stop.
Uddata skriv: ['index of ad = '] + (( txt find: ['ad'] ) - 0), stop.
Uddata skriv: ['last index of W = '] + (( txt sidste: ['W'] ) - 0), stop.
Uddata skriv: ['last index of d = '] + (( txt sidste: ['d'] ) - 0), stop.
Uddata skriv: ['txt equals Word Salad = '] + ( txt = ['Word Salad'] ), stop.
Uddata skriv: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), stop.
Uddata skriv: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), stop.
Uddata skriv: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), stop.

Program ryd-op.

usedMemory1 := (Program hukommelse ? 0).


txt := ['Word Salad'].
Uddata skriv: ['last index of ord = '] + (( txt sidste: ['ord'] ) - 0), stop.
Uddata skriv: ['index of ord = '] + (( txt find: ['ord'] ) - 0), stop.
