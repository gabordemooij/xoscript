

>> brugtHukommelse1 := 0.
>> brugtHukommelse2 := 0.
>> brugtHukommelse3 := 0.
>> brugtHukommelse4 := 0.

Program hukommelsesstyring: 0.

>> txt := ['Word Salad'].
Uddata skriv: ['sidste indeks af rds = '] + (( txt sidste: ['ord'] ) - 0), stop.
Uddata skriv: ['indeks af rds = '] + (( txt find: ['ord'] ) - 0), stop.
Uddata skriv: ['indeks af at = '] + (( txt find: ['ad'] ) - 0), stop.
Uddata skriv: ['sidste indeks af W = '] + (( txt sidste: ['W'] ) - 0), stop.
Uddata skriv: ['sidste indeks af d = '] + (( txt sidste: ['d'] ) - 0), stop.
Uddata skriv: ['tkst er lig med Ordsalat = '] + ( txt = ['Word Salad'] ), stop.
Uddata skriv: ['tkst er lig med Cæsarsalat = '] + ( txt = ['Cæsarsalat'] ), stop.
Uddata skriv: ['tkst er ikke lig med Ordsalat = '] + ( txt ≠ ['Word Salad'] ), stop.
Uddata skriv: ['tkst er ikke lig med Cæsarsalat = '] + ( txt ≠ ['Cæsarsalat'] ), stop.

Program ryd-op.

brugtHukommelse1 := (Program hukommelse ? 0).


txt := ['Word Salad'].
Uddata skriv: ['sidste indeks af rds = '] + (( txt sidste: ['ord'] ) - 0), stop.
Uddata skriv: ['indeks af rds = '] + (( txt find: ['ord'] ) - 0), stop.
Uddata skriv: ['indeks af at = '] + (( txt find: ['ad'] ) - 0), stop.
Uddata skriv: ['sidste indeks af W = '] + (( txt sidste: ['W'] ) - 0), stop.
Uddata skriv: ['sidste indeks af d = '] + (( txt sidste: ['d'] ) - 0), stop.
Uddata skriv: ['tkst er lig med Ordsalat = '] + ( txt = ['Word Salad'] ), stop.
Uddata skriv: ['tkst er lig med Cæsarsalat = '] + ( txt = ['Cæsarsalat'] ), stop.
Uddata skriv: ['tkst er ikke lig med Ordsalat = '] + ( txt ≠ ['Word Salad'] ), stop.
Uddata skriv: ['tkst er ikke lig med Cæsarsalat = '] + ( txt ≠ ['Cæsarsalat'] ), stop.

Program ryd-op.
brugtHukommelse2 := (Program hukommelse ? 0).


txt := ['Word Salad'].
Uddata skriv: ['sidste indeks af rds = '] + (( txt sidste: ['ord'] ) - 0), stop.
Uddata skriv: ['indeks af rds = '] + (( txt find: ['ord'] ) - 0), stop.
Uddata skriv: ['indeks af at = '] + (( txt find: ['ad'] ) - 0), stop.
Uddata skriv: ['sidste indeks af W = '] + (( txt sidste: ['W'] ) - 0), stop.
Uddata skriv: ['sidste indeks af d = '] + (( txt sidste: ['d'] ) - 0), stop.
Uddata skriv: ['tkst er lig med Ordsalat = '] + ( txt = ['Word Salad'] ), stop.
Uddata skriv: ['tkst er lig med Cæsarsalat = '] + ( txt = ['Cæsarsalat'] ), stop.
Uddata skriv: ['tkst er ikke lig med Ordsalat = '] + ( txt ≠ ['Word Salad'] ), stop.
Uddata skriv: ['tkst er ikke lig med Cæsarsalat = '] + ( txt ≠ ['Cæsarsalat'] ), stop.

Program ryd-op.
brugtHukommelse3 := (Program hukommelse ? 0).



( brugtHukommelse1 = brugtHukommelse2 og: brugtHukommelse1 = brugtHukommelse3, og: brugtHukommelse2 = brugtHukommelse3 ) sand: {
	Uddata skriv: ['Ingen hukommelseslæk her'].
}, falsk: {
	Uddata skriv: ['Lækker hukommelse...'].
}.
