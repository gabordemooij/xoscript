>> Huskeliste := Objekt ny.

Huskeliste ved: ['ny'] gør: {
	egen list := Liste ny.
}.

Huskeliste ved: ['nieuw'] gør: {
	egen list := Liste ny.
}.

Huskeliste ved: ['+'] gør: { :opgave
	egen list tilføj: opgave.
}.

Huskeliste ved: ['number of tasks?'] gør: { <-  egen list antal.
}.

>> gøremål := 
	Huskeliste ny 
	+ ['lav aftensmad'] 
	+ ['ryd op på værelset'].
	
Uddata skriv: ['You have $ tasks to do'] $ gøremål number of tasks?.
