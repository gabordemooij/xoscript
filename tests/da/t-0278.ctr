>> To-Do := Objekt ny.

To-Do ved: ['ny'] gør: {
	egen list := Liste ny.
}.

To-Do ved: ['nieuw'] gør: {
	egen list := Liste ny.
}.

To-Do ved: ['+'] gør: { :task
	egen list tilføj: task.
}.

To-Do ved: ['number of tasks?'] gør: { <-  egen list antal.
}.

>> todos := 
	To-Do ny 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Uddata skriv: ['You have $ tasks to do'] $ todos number of tasks?.
