
Tekst ved: ['html'] gør: { <- (
		selv
		erstat: ['&'] med: ['&amp;'],
		erstat: ['<'] med: ['&lt;'],
		erstat: ['>'] med: ['&gt;'],
		erstat: ['"'] med: ['&quot;']
	).
}.

>> HtmlPensel := Objekt ny.

HtmlPensel ved: ['svar:'] gør: { :tag
	Uddata skriv: (['<tag>↵'] tag: tag ).
}.

HtmlPensel ved: ['svar:og:'] gør: { :tag :content
	tag := ( tag fra: 0 længde: (tag længde - 1) ).
	Uddata skriv: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlPensel ved: ['content:'] gør: { :tekststykke
	Uddata skriv: tekststykke html, stop.
}.

HtmlPensel ved: ['attr:værdi:'] gør: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlPensel ny.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] værdi: ['bold']),
		/span
	/body
/html.
		
