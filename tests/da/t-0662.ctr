>> t := Intet.

# you can control the time zone for
# parsing like this:
Øjeblik zone: ['CET'].
t := Øjeblik fra: ['1981-02-03 04:05:06'].
Uddata skriv: t, stop.

# now using CEST time zone:
Øjeblik zone: ['CEST'].
t := Øjeblik fra: ['1981-02-03 04:05:06'].
Uddata skriv: t, stop.

# error if string cannot be parsed
{ Øjeblik fra: ['1900']. } fang: { Intet. }, start.
