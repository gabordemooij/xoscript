>> t := Intet.

# du kan styre tidszonen for
# parsing sådan her:
Øjeblik zone: ['CET'].
t := Øjeblik fra: ['1981-02-03 04:05:06'].
Uddata skriv: t, stop.

# bruger nu tidszonen CEST:
Øjeblik zone: ['CEST'].
t := Øjeblik fra: ['1981-02-03 04:05:06'].
Uddata skriv: t, stop.

# fejl hvis teksten ikke kan parses
{ Øjeblik fra: ['1900']. } fang: { Intet. }, start.
