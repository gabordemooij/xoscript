

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program hukommelsesstyring: 0.

>> f := Fil ny: ['/tmp/citrine_test_file.txt'].
f exists: { f slet. }.
f skriv: ['hello world'].
>> q := f størrelse.
Uddata skriv: q, stop.

f := Fil ny: ['/tmp/citrine_test_file.txt'].
q := f størrelse.
Uddata skriv: q, stop.

Program ryd-op.
usedMemory1 := (Program hukommelse ? 0).


f := Fil ny: ['/tmp/citrine_test_file.txt'].
q := f størrelse.
Uddata skriv: q, stop.

Program ryd-op.
usedMemory2 := (Program hukommelse ? 0).


f := Fil ny: ['/tmp/citrine_test_file.txt'].
q := f størrelse.
Uddata skriv: q, stop.

Program ryd-op.
usedMemory3 := (Program hukommelse ? 0).



( usedMemory1 = usedMemory2 og: usedMemory1 = usedMemory3, og: usedMemory2 = usedMemory3 ) sand: {
	Uddata skriv: ['No memory leaks here'].
}, falsk: {
	Uddata skriv: ['Leaking memory...'].
}.
