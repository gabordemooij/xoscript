Uddata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gør: { :boolsk
	egen boolsk := boolsk. 
}.

a ved: ['vare'] gør: {
	<- egen boolsk.
}.

a item: Boolsk.

Uddata skriv: a vare, stop.

>> gammel-bool-adresse := a vare prototype hukommelsesadresse.
a save-as: ['/tmp/a.bin'].
Uddata skriv: ['========== GENINDLÆSER SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b vare prototype hukommelsesadresse = gammel-bool-adresse) sand: {
	Uddata skriv: ['Objektlink genoprettet.'], stop.
}.

Uddata skriv: b vare, stop.
