Uddata skriv: ['Continue for-loop, No - before 6 and up.'], stop.
{ :i
	Uddata skriv: (i + 1), stop.
	((i + 1) > 4) fortsæt.
	Uddata skriv: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Uddata stop.
Uddata skriv: ['Continue while-true, No --> before 5 and up.'], stop.
{
	Uddata skriv: ['iteration #'] + x, stop.
	x læg-til: 1.
	((x < 5) ikke) fortsæt.
	Uddata skriv: ['-->'].
} mens: xIsLessThan10.
Uddata stop.
Uddata skriv: ['Continue while-false, No - before 3 only.'], stop.
{
	Uddata skriv: ['iteration #'] + x, stop.
	x træk-fra: 1.
	(x = 3) fortsæt.
	Uddata skriv: ['-'].
} mens: { <- ( x > 0). }.

Uddata stop.
Uddata skriv: ['Continue times-loop, No ||| before 3.'], stop.
{ :i
	Uddata skriv: ['iteration #'] + i, stop.
	(i = 2) fortsæt.
	Uddata skriv: ['|||'].
} × 5.

Uddata stop.

{ Sand fortsæt. Uddata skriv: ['dont write this!'], stop. } start.

{ Sand fortsæt. Uddata skriv: ['dont write this!'], stop. } fang: { Uddata skriv: ['Dont catch this!']. }, start.

Uddata skriv: ['Test Array each-loop: 0, ... ,2'], stop.
(Liste ← 1 ; 2 ; 3) afbild: { :i
	(i = 1) fortsæt.
	Uddata skriv: ['iteration #'] + (i - 0), stop.
}.

Uddata skriv: ['Test Map each-loop: c only'], stop.
>> m := Ordbog ny.
m sæt: ['first'] ved: ['a'], sæt: ['second'] ved: ['b'], sæt: ['third'] ved: ['c'].
m hver: { :k :v
	(k ≠ ['c']) fortsæt.
	Uddata skriv: ['iteration'] + k + v, stop.
}.

