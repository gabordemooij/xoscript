Uddata skriv: ['Fortsæt for-løkke, Nej - før 6 og op.'], stop.
{ :i
	Uddata skriv: (i + 1), stop.
	((i + 1) > 4) fortsæt.
	Uddata skriv: ['-'].
} × 10.

>> x := 0.
>> xErMindreEnd10 := { <- ( x < 10 ). }.
Uddata stop.
Uddata skriv: ['Fortsæt while-true, Nej --> før 5 og op.'], stop.
{
	Uddata skriv: ['iteration #'] + x, stop.
	x læg-til: 1.
	((x < 5) ikke) fortsæt.
	Uddata skriv: ['-->'].
} mens: xErMindreEnd10.
Uddata stop.
Uddata skriv: ['Fortsæt while-false, Nej - kun før 3.'], stop.
{
	Uddata skriv: ['iteration #'] + x, stop.
	x træk-fra: 1.
	(x = 3) fortsæt.
	Uddata skriv: ['-'].
} mens: { <- ( x > 0). }.

Uddata stop.
Uddata skriv: ['Fortsæt times-løkke, Nej ||| før 3.'], stop.
{ :i
	Uddata skriv: ['iteration #'] + i, stop.
	(i = 2) fortsæt.
	Uddata skriv: ['|||'].
} × 5.

Uddata stop.

{ Sand fortsæt. Uddata skriv: ['skriv ikke dette!'], stop. } start.

{ Sand fortsæt. Uddata skriv: ['skriv ikke dette!'], stop. } fang: { Uddata skriv: ['Fang ikke dette!']. }, start.

Uddata skriv: ['Test Liste each-løkke: 0, ... ,2'], stop.
(Liste ← 1 ; 2 ; 3) afbild: { :i
	(i = 1) fortsæt.
	Uddata skriv: ['iteration #'] + (i - 0), stop.
}.

Uddata skriv: ['Test Ordbog each-løkke: kun c'], stop.
>> m := Ordbog ny.
m sæt: ['first'] ved: ['a'], sæt: ['second'] ved: ['b'], sæt: ['tredje'] ved: ['c'].
m hver: { :k :v
	(k ≠ ['c']) fortsæt.
	Uddata skriv: ['iteration'] + k + v, stop.
}.

