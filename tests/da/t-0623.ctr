

>> g  := Server ny.
>> v  := Boks ny.
>> ok := 0.

>> hemmeligheder := Liste ny ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> kodeordene := hemmeligheder kopiér.
kodeordene hver: { :i :p
	hemmeligheder hver: { :n :s
		{
			>> krypteret := v kryptér: s nøgle: p.
			>> dekrypteret := v dekryptér: krypteret nøgle: p.
			(dekrypteret = s) sand: {
				ok læg-til: 1.
			}, ellers: {
				Uddata skriv: ['kryptering/dekryptering mislykkedes: '], stop.
				Uddata skriv: s, stop.
				Uddata skriv: ['krypteret: '] + krypteret, stop.
				Uddata skriv: ['dekrypteret: '] + krypteret, stop.
				Program afslut.
			}.
		} fang: { :fjl
			(s = [''] eller: p = ['']) sand: {
				ok læg-til: 1.
			}, ellers: {
				Uddata skriv: fjl, stop.
				Program afslut.
			}.
		}, start.
	}.
}.

Uddata skriv: ( ok + [' boks-krypteringer testet.'] ), stop.