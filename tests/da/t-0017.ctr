Tal ved: ['fakultet'] gør: {
	>> total := 1.
	{ :indeks total gang-med: (selv - (indeks)). } × selv. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Uddata skriv: a.
>> b := 2 + 3 fakultet.
Uddata skriv: b.
>> c := 3 fakultet + 2.
Uddata skriv: c.
>> d := 2 + (3 fakultet).
Uddata skriv: d.
Uddata skriv: 2 + 3 fakultet + 1.
