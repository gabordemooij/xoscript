Tal ved: ['factorial'] gør: {
	>> total := 1.
	{ :index total gang-med: (selv - (index)). } × selv. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Uddata skriv: a.
>> b := 2 + 3 factorial.
Uddata skriv: b.
>> c := 3 factorial + 2.
Uddata skriv: c.
>> d := 2 + (3 factorial).
Uddata skriv: d.
Uddata skriv: 2 + 3 factorial + 1.
