


>> vin := Objekt ny.


vin ved: ['tilTekst'] gør: { <- ['merlot'].
}.

vin ved: ['naarTekst'] gør: { <- ['merlot'].
}.


vin ved: ['='] gør: { :other wine <- ( selv tilTekst = other wine ).
}.

vin ved: ['=='] gør: { :other wine <- ( selv tilTekst = other wine ).
}.



vin
	tilfælde: ['cabernet'] gør: { Uddata skriv: ['det er en Cabernet!']. },
	tilfælde: ['syrah']    gør: { Uddata skriv: ['det er en Syrah!'].    },
	tilfælde: ['merlot']   gør: { Uddata skriv: ['det er en Merlot!'].   },
	tilfælde: ['malbec']   gør: { Uddata skriv: ['det er en Malbec!'].   }.

Uddata stop.
