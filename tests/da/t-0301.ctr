


>> wine := Objekt ny.


wine ved: ['toString'] gør: { <- ['merlot'].
}.

wine ved: ['naarTekst'] gør: { <- ['merlot'].
}.


wine ved: ['='] gør: { :other wine <- ( selv toString = other wine ).
}.

wine ved: ['=='] gør: { :other wine <- ( selv toString = other wine ).
}.



wine
	tilfælde: ['cabernet'] gør: { Uddata skriv: ['it's a Cabernet!']. },
	tilfælde: ['syrah']    gør: { Uddata skriv: ['it's a Syrah!'].    },
	tilfælde: ['merlot']   gør: { Uddata skriv: ['it's a Merlot!'].   },
	tilfælde: ['malbec']   gør: { Uddata skriv: ['it's a Malbec!'].   }.

