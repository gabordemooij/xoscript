>> str := ['write:'].
Uddata besked: ['skriv:'] argumenter: (Liste ← ['Hello World']), stop. 

Tal ved: ['isbetween:and:'] gør: { :a :b <- ((selv ≥ a) og: (selv ≤ b)).
}.

str := ['isbetween:and:'].
Uddata skriv: (3 besked: str argumenter: (Liste ← 2 ; 8)), stop.
Uddata skriv: (3 besked: str argumenter: (Liste ← 1 ; 2)), stop.


>> CoffeeMachine := Objekt ny.
CoffeeMachine ved: ['makeCoffeeWithSugar:milk:'] gør: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Liste ← 4 ; 2.
Uddata skriv: ( CoffeeMachine besked: order argumenter: coffeeConfiguration ), stop.
