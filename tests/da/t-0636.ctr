# test url parsing

Server init.
>> url := URL fra: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Uddata skriv: ['scheme = '] + url skema, stop.
Uddata skriv: ['host = '] + url vært, stop.
Uddata skriv: ['port = '] + url port, stop.
Uddata skriv: ['path = '] + url sti, stop.
Uddata skriv: ['query = '] + url søgeparametre, stop.
Uddata skriv: ['fragment = '] + url fragment, stop.
