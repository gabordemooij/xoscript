# test url-parsing

Server init.
>> url := URL fra: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Uddata skriv: ['skema = '] + url skema, stop.
Uddata skriv: ['vært = '] + url vært, stop.
Uddata skriv: ['port = '] + url port, stop.
Uddata skriv: ['sti = '] + url sti, stop.
Uddata skriv: ['forespørgsel = '] + url søgeparametre, stop.
Uddata skriv: ['fragment = '] + url fragment, stop.
