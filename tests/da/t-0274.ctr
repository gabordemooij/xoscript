

Liste ved: ['column:'] gør: { :column
	>> result := Liste ny.
	selv hver: { :index :row
		row hver: { :index :cell
			(index = column) sand: { result tilføj: cell. }.
		}.
	}. <- result.
}.


>> a := Liste ←
	(Liste ← 1 ; 2 ; 3) ;
	(Liste ← 4 ; 5 ; 6) ;
	(Liste ← 7 ; 8 ; 9).

>> b := a column: 1.
Uddata skriv: b, stop.

b := a column: 20.
Uddata skriv: b, stop.

b := a column: -100.
Uddata skriv: b, stop.
