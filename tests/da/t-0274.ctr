

Liste ved: ['column:'] gør: { :kolonne
	>> resultat := Liste ny.
	selv hver: { :indeks :række
		række hver: { :indeks :celle
			(indeks = kolonne) sand: { resultat tilføj: celle. }.
		}.
	}. <- resultat.
}.


>> a := Liste ←
	(Liste ← 1 ; 2 ; 3) ;
	(Liste ← 4 ; 5 ; 6) ;
	(Liste ← 7 ; 8 ; 9).

>> b := a column: 1.
Uddata skriv: b, stop.

b := a column: 20.
Uddata skriv: b, stop.

b := a column: -100.
Uddata skriv: b, stop.
