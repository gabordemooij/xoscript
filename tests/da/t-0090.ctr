Uddata skriv: ['1,2,3,4,5,6,7,8,9,A,'], stop.
>> Virkefelt := Objekt ny.
Virkefelt ved: ['initialize:'] gør: { :x egen egenskab := x. }.
Virkefelt ved: ['godkend'] gør: { Uddata skriv: [',']. }.
Virkefelt ved: ['test'] gør: {
	Uddata skriv: egen egenskab.
	selv godkend.
	( 1 = 1 ) sand: { Uddata skriv: egen egenskab. selv godkend. }.
	( 1 = 0 ) falsk: { Uddata skriv: egen egenskab. selv godkend. }.
	>> y := 2. { Uddata skriv: egen egenskab. selv godkend. } mens: { y træk-fra: 1. <- (y > 0). }.
	{ Uddata skriv: egen egenskab. selv godkend. } × 1.
	(Liste ← 1) hver: {  Uddata skriv: egen egenskab. selv godkend. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo implementér egen sortering, denne test fejler pga. forskelligt antal iterationer pr. platform
	(Ordbog ny one: ['item']) hver: { Uddata skriv: egen egenskab. selv godkend. }.
	{ 1 ÷ 0. } fang: { Uddata skriv: egen egenskab. selv godkend. }, start.
	Uddata stop.
}.
>> virkefelt1 := Virkefelt ny.
virkefelt1 initialize: ['X'].
virkefelt1 test.
>> funktionen := { 
	egen egenskab := ['Y'].
	Uddata skriv: egen egenskab.
	selv godkend.
	( 1 = 1 ) sand: { Uddata skriv: egen egenskab. selv godkend. }.
	( 1 = 0 ) falsk: { Uddata skriv: egen egenskab. selv godkend. }.
	>> y := 2. { Uddata skriv: egen egenskab. selv godkend. } mens: { y træk-fra: 1. <- (y > 0). }.
	{ Uddata skriv: egen egenskab. selv godkend. } × 1.
	(Liste ← 1) hver: {  Uddata skriv: egen egenskab. selv godkend. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Ordbog ny one: ['item']) hver: { Uddata skriv: egen egenskab. selv godkend. }.
	{ 1 ÷ 0. } fang: { Uddata skriv: egen egenskab. selv godkend. }, start.
	Uddata stop.
}.
funktionen ved: ['godkend'] gør: { Uddata skriv: [',']. }.
funktionen anvend: 1 og: 2.
