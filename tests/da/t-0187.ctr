Tal ved: ['factorial'] gør: {
	>> total := 1.
	{ :index total gang-med: (selv - index). } × selv. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program hukommelsesstyring: 0.

{
2 exponent factorial.
Uddata skriv: (11 modulo: 3), stop.
Uddata skriv: (3.4 afrund), stop.
Uddata skriv: (7.1 rund-op), stop.
Uddata skriv: (7.9 rund-ned), stop.
}
start.

Program ryd-op.

usedMemory1 := (Program hukommelse ? 0).

{
2 exponent factorial.
Uddata skriv: (11 modulo: 3), stop.
Uddata skriv: (3.4 afrund), stop.
Uddata skriv: (7.1 rund-op), stop.
Uddata skriv: (7.9 rund-ned), stop.
}
start.

Program ryd-op.
usedMemory2 := (Program hukommelse ? 0).


{
2 exponent factorial.
Uddata skriv: (11 modulo: 3), stop.
Uddata skriv: (3.4 afrund), stop.
Uddata skriv: (7.1 rund-op), stop.
Uddata skriv: (7.9 rund-ned), stop.
} start.

Program ryd-op.
usedMemory3 := (Program hukommelse ? 0).



( usedMemory1 = usedMemory2 og: usedMemory1 = usedMemory3, og: usedMemory2 = usedMemory3 ) sand: {
	Uddata skriv: ['No memory leaks here'].
}, falsk: {
	Uddata skriv: ['Leaking memory...'].
}.
