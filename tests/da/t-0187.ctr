Tal ved: ['fakultet'] gør: {
	>> total := 1.
	{ :indeks total gang-med: (selv - indeks). } × selv. <- total.
}.

>> brugtHukommelse1 := 0.
>> brugtHukommelse2 := 0.
>> brugtHukommelse3 := 0.
>> brugtHukommelse4 := 0.

Program hukommelsesstyring: 0.

{
2 eksponent fakultet.
Uddata skriv: (11 modulo: 3), stop.
Uddata skriv: (3.4 afrund), stop.
Uddata skriv: (7.1 rund-op), stop.
Uddata skriv: (7.9 rund-ned), stop.
}
start.

Program ryd-op.

brugtHukommelse1 := (Program hukommelse ? 0).

{
2 eksponent fakultet.
Uddata skriv: (11 modulo: 3), stop.
Uddata skriv: (3.4 afrund), stop.
Uddata skriv: (7.1 rund-op), stop.
Uddata skriv: (7.9 rund-ned), stop.
}
start.

Program ryd-op.
brugtHukommelse2 := (Program hukommelse ? 0).


{
2 eksponent fakultet.
Uddata skriv: (11 modulo: 3), stop.
Uddata skriv: (3.4 afrund), stop.
Uddata skriv: (7.1 rund-op), stop.
Uddata skriv: (7.9 rund-ned), stop.
} start.

Program ryd-op.
brugtHukommelse3 := (Program hukommelse ? 0).



( brugtHukommelse1 = brugtHukommelse2 og: brugtHukommelse1 = brugtHukommelse3, og: brugtHukommelse2 = brugtHukommelse3 ) sand: {
	Uddata skriv: ['Ingen hukommelseslæk her'].
}, falsk: {
	Uddata skriv: ['Lækker hukommelse...'].
}.
