{
	denne-opgave fejl: ['Fejl ikke.'].
	ukendt gørNoget.
} fang: {
	Uddata skriv: ['Fanget!'].
}, start.

{
	denne-opgave fejl: ['Fejl ikke.'].
	egen ukendt gørNoget.
} fang: {
	Uddata skriv: ['Fanget!'].
}, start.

{
	denne-opgave fejl: ['Fejl ikke.'].
	ukendt := 122.
} fang: {
	Uddata skriv: ['Fanget!'].
}, start.


{
	denne-opgave fejl: ['Fejl ikke.'].
	Sand afbryd.
	Uddata skriv: ['FEJL'].
} fang: {
	Uddata skriv: ['Fanget!'].
}, start.

{
	{
		denne-opgave fejl: ['Fejl ikke.'].
		Sand afbryd.
		Uddata skriv: ['FEJL'].
	} fang: { :x
		(x = ['Fejl ikke.']) sand: { denne-opgave fejl: ['Indlejret fanget!']. }.
	}, start.
} fang: { :e
	Uddata skriv: e.
}, start.
