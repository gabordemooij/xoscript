{
	denne-opgave fejl: ['Dont fail.'].
	unknown doSomething.
} fang: {
	Uddata skriv: ['Caught!'].
}, start.

{
	denne-opgave fejl: ['Dont fail.'].
	egen unknown doSomething.
} fang: {
	Uddata skriv: ['Caught!'].
}, start.

{
	denne-opgave fejl: ['Dont fail.'].
	unknown := 122.
} fang: {
	Uddata skriv: ['Caught!'].
}, start.


{
	denne-opgave fejl: ['Dont fail.'].
	Sand afbryd.
	Uddata skriv: ['FAIL'].
} fang: {
	Uddata skriv: ['Caught!'].
}, start.

{
	{
		denne-opgave fejl: ['Dont fail.'].
		Sand afbryd.
		Uddata skriv: ['FAIL'].
	} fang: { :x
		(x = ['Dont fail.']) sand: { denne-opgave fejl: ['Nested Caught!']. }.
	}, start.
} fang: { :e
	Uddata skriv: e.
}, start.
