# test qualifiers

Program ryd-op.

>> Fruit := Objekt ny.
Fruit ved: ['ny'] gør: {
	>> f := selv ny.
	f apples: 0. <- f.
}.
Fruit ved: ['apples:'] gør: { :a egen apples := a. }.
Fruit ved: ['apples'] gør: { <- egen apples. }.
Fruit ved: ['+'] gør: { :f
	>> n := Fruit ny.
	n apples: (f apples + egen apples). <- n.
}.
Tal ved: ['apples'] gør: { <- ((Fruit ny) apples: selv).
}.

Fruit ved: ['tekst'] gør: { <- egen apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Uddata skriv: q, stop.




q := 3 apples + 4 apples.
Uddata skriv: q, stop.



q := 3 apples + 4 apples.
Uddata skriv: q, stop.


