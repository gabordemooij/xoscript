# test betegnelser

Program ryd-op.

>> Frugt := Objekt ny.
Frugt ved: ['ny'] gør: {
	>> f := selv ny.
	f apples: 0. <- f.
}.
Frugt ved: ['apples:'] gør: { :a egen æbler := a. }.
Frugt ved: ['æbler'] gør: { <- egen æbler. }.
Frugt ved: ['+'] gør: { :f
	>> n := Frugt ny.
	n apples: (f æbler + egen æbler). <- n.
}.
Tal ved: ['æbler'] gør: { <- ((Frugt ny) apples: selv).
}.

Frugt ved: ['tekst'] gør: { <- egen æbler + [' æbler '].
}.

>> q := 3 æbler + 4 æbler.
Uddata skriv: q, stop.




q := 3 æbler + 4 æbler.
