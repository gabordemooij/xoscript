>> x := [' hallo '].

>> y := x store-bogstaver.
Uddata skriv: x, stop.
Uddata skriv: (x lige-med: y), stop.

>> y := x små-bogstaver.
Uddata skriv: x, stop.
Uddata skriv: (x lige-med: y), stop.

>> y := x trim.
Uddata skriv: x, stop.
Uddata skriv: (x lige-med: y), stop.

>> y := x forskydning: 1.
Uddata skriv: x, stop.
Uddata skriv: (x lige-med: y), stop.

>> y := x fra: 1 længde: 2.
Uddata skriv: x, stop.
Uddata skriv: (x lige-med: y), stop.