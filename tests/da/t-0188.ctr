

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program hukommelsesstyring: 0.

{ :i Uddata skriv: i. } × 4.
Uddata stop.
{ :i Uddata skriv: (4 - i). } × 4.
Uddata stop.
( 1 > 2 ) falsk: { Uddata skriv: ['BLOCK 1'], stop. }.
( 2 > 1 ) sand:  { Uddata skriv: ['BLOCK 2'], stop. }.

>> i := 0.
{ Uddata skriv: i. i læg-til: 1. } mens: { <- ( i < 3). }.
Uddata stop.

i := 3.
{ Uddata skriv: i. i := i - 1. } mens: { <- ( i > 0). }.
Uddata stop.


Program ryd-op.

usedMemory1 := (Program hukommelse ? 0).


{ :i  Uddata skriv: i. } × 4.
Uddata stop.
{ :i  Uddata skriv: (4 - i). } × 4.
Uddata stop.
( 1 > 2 ) falsk: { Uddata skriv: ['BLOCK 1'], stop. }.
( 2 > 1 ) sand:  { Uddata skriv: ['BLOCK 2'], stop. }.

>> i := 0.
{ Uddata skriv: i. i læg-til: 1. } mens: { <- ( i < 3). }.
Uddata stop.

i := 3.
{ Uddata skriv: i. i := i - 1. } mens: { <- ( i > 0). }.
Uddata stop.



Program ryd-op.
usedMemory2 := (Program hukommelse ? 0).


{ :i Uddata skriv: i. } × 4.
Uddata stop.
{ :i Uddata skriv: (4 - i). } × 4.
Uddata stop.
( 1 > 2 ) falsk: { Uddata skriv: ['BLOCK 1'], stop. }.
( 2 > 1 ) sand:  { Uddata skriv: ['BLOCK 2'], stop. }.

>> i := 0.
{ Uddata skriv: i. i læg-til: 1. } mens: { <- ( i < 3). }.
Uddata stop.

i := 3.
{ Uddata skriv: i. i := i - 1. } mens: { <- ( i > 0). }.
Uddata stop.

Program ryd-op.
usedMemory3 := (Program hukommelse ? 0).



( usedMemory1 = usedMemory2 og: usedMemory1 = usedMemory3, og: usedMemory2 = usedMemory3 ) sand: {
	Uddata skriv: ['No memory leaks here'].
}, falsk: {
	Uddata skriv: ['Leaking memory...'].
}.
