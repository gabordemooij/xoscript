

>> brugtHukommelse1 := 0.
>> brugtHukommelse2 := 0.
>> brugtHukommelse3 := 0.
>> brugtHukommelse4 := 0.

Program hukommelsesstyring: 0.

{ :i Uddata skriv: i. } × 4.
Uddata stop.
{ :i Uddata skriv: (4 - i). } × 4.
Uddata stop.
( 1 > 2 ) falsk: { Uddata skriv: ['BLOK 1'], stop. }.
( 2 > 1 ) sand:  { Uddata skriv: ['BLOK 2'], stop. }.

>> i := 0.
{ Uddata skriv: i. i læg-til: 1. } mens: { <- ( i < 3). }.
Uddata stop.

i := 3.
{ Uddata skriv: i. i := i - 1. } mens: { <- ( i > 0). }.
Uddata stop.


Program ryd-op.

brugtHukommelse1 := (Program hukommelse ? 0).


{ :i  Uddata skriv: i. } × 4.
Uddata stop.
{ :i  Uddata skriv: (4 - i). } × 4.
Uddata stop.
( 1 > 2 ) falsk: { Uddata skriv: ['BLOK 1'], stop. }.
( 2 > 1 ) sand:  { Uddata skriv: ['BLOK 2'], stop. }.

>> i := 0.
{ Uddata skriv: i. i læg-til: 1. } mens: { <- ( i < 3). }.
Uddata stop.

i := 3.
{ Uddata skriv: i. i := i - 1. } mens: { <- ( i > 0). }.
Uddata stop.



Program ryd-op.
brugtHukommelse2 := (Program hukommelse ? 0).


{ :i Uddata skriv: i. } × 4.
Uddata stop.
{ :i Uddata skriv: (4 - i). } × 4.
Uddata stop.
( 1 > 2 ) falsk: { Uddata skriv: ['BLOK 1'], stop. }.
( 2 > 1 ) sand:  { Uddata skriv: ['BLOK 2'], stop. }.

>> i := 0.
{ Uddata skriv: i. i læg-til: 1. } mens: { <- ( i < 3). }.
Uddata stop.

i := 3.
{ Uddata skriv: i. i := i - 1. } mens: { <- ( i > 0). }.
Uddata stop.

Program ryd-op.
brugtHukommelse3 := (Program hukommelse ? 0).



( brugtHukommelse1 = brugtHukommelse2 og: brugtHukommelse1 = brugtHukommelse3, og: brugtHukommelse2 = brugtHukommelse3 ) sand: {
	Uddata skriv: ['Ingen hukommelseslæk her'].
}, falsk: {
	Uddata skriv: ['Lækker hukommelse...'].
}.
