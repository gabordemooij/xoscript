Uddata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gør: { :ordbogen
	egen ordbogen := ordbogen. 
}.

a ved: ['vare'] gør: {
	<- egen ordbogen.
}.

a item: (
Ordbog ny
	hello: ['world']).

>> gammel-ordbog-adresse := a vare prototype hukommelsesadresse.
a save-as: ['/tmp/a.bin'].
Uddata skriv: ['========== GENINDLÆSER SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b vare prototype hukommelsesadresse = gammel-ordbog-adresse) sand: {
	Uddata skriv: ['Objektlink genoprettet.'], stop.
}.

Uddata skriv: b vare, stop.
