Uddata skriv: ['Test object'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gør: { :dict
	egen dict := dict. 
}.

a ved: ['item'] gør: { <- egen dict.
}.

a item: (
Ordbog ny
	hello: ['world']).

>> old-dict-address := a item prototype hukommelsesadresse.
a save-as: ['/tmp/a.bin'].
Uddata skriv: ['========== RELOADING SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototype hukommelsesadresse = old-dict-address) sand: {
	Uddata skriv: ['Object link re-attached.'], stop.
}.

Uddata skriv: b item, stop.
