# catch-all test (practical)
>> HTML := Tekst ny.
HTML ved: ['encode:'] gør: { :tekst
	selv tilføj: (tekst
	erstat: ['&'] med: ['&amp;'], 
	erstat: ['<'] med: ['&lt;'],
	erstat: ['>'] med: ['&gt;'],
	erstat: ['"'] med: ['&quot;']).
}.
>> blog := HTML ny.
blog tilføj: ['<h1>'],
     encode: ['Koffie & Thee'],
     tilføj: ['</h1>'].
Uddata skriv: blog, stop.


>> Roman := Tal ny.
Roman ved: ['stringy'] gør: {
	>> a := [''].
	{ a tilføj: ['I']. } × selv. <- a.
}.

>> x := Roman ny.
x læg-til: 3.
Uddata skriv: x stringy, stop.

>> Quantum := Boolsk ny.
Quantum ved: ['true?'] gør: { <- ['maybe True']. }.
Uddata skriv: (Quantum ny true?), stop.

>> Nihil := Intet ny.
Nihil ved: ['tekst'] gør: { <- ['Nihil']. }.
Uddata skriv: (Nihil ny), stop.
