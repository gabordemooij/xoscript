# catch-all-test (praktisk)
>> HTML := Tekst ny.
HTML ved: ['encode:'] gør: { :teksten
	selv tilføj: (teksten
	erstat: ['&'] med: ['&amp;'], 
	erstat: ['<'] med: ['&lt;'],
	erstat: ['>'] med: ['&gt;'],
	erstat: ['"'] med: ['&quot;']).
}.
>> blog := HTML ny.
blog tilføj: ['<h1>'],
     encode: ['Koffie & Thee'],
     tilføj: ['</h1>'].
Uddata skriv: blog, stop.


>> Romertal := Tal ny.
Romertal ved: ['tekstagtig'] gør: {
	>> a := [''].
	{ a tilføj: ['I']. } × selv. <- a.
}.

>> x := Romertal ny.
x læg-til: 3.
Uddata skriv: x tekstagtig, stop.

>> Kvante := Boolsk ny.
Kvante ved: ['true?'] gør: { <- ['måske Sand']. }.
Uddata skriv: (Kvante ny true?), stop.

>> Nihil := Intet ny.
Nihil ved: ['tekst'] gør: { <- ['Nihil']. }.
Uddata skriv: (Nihil ny), stop.
