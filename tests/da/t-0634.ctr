# Program shell-escape giver kanonisk posix-shellsyntaks
# kompatibel med: bash/dash, zsh, ksh

>> c := Program shell-escape: ['abc'].
Uddata skriv: c, stop.
Uddata skriv: ( Program system: ['echo '] + c ), stop.

c := Program shell-escape: ['a'b'c'].
Uddata skriv: c, stop.
Uddata skriv: ( Program system: ['echo '] + c ), stop.

c := Program shell-escape: ['a\'c'].
Uddata skriv: c, stop.
Uddata skriv: ( Program system: ['echo '] + c ), stop.