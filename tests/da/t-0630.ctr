#regex-test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> mønstret := Mønster ny: ['href="([^"]+)" target="([^"]+)"'].
>> resultat  := mønstret match: subject gør: { :m :x
	Uddata skriv: m, stop.
	Uddata skriv: x, stop.
	<- ['XXX'].
}.
Uddata skriv: resultat, stop.