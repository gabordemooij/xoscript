>> phrases := Liste ny
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases hver: { :_ :phrase 
	>> e := Server base64-kode: phrase.
	>> d := Server base64-afkode: e.
	Uddata skriv: (
		message kopiér ~encoded: e, ~decoded: d
	), stop.
}.
