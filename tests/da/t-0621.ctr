>> sætninger := Liste ny
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> besked := ['Phrase: ~decoded base64: ~encoded'].
	
sætninger hver: { :_ :sætning 
	>> e := Server base64-kode: sætning.
	>> d := Server base64-afkode: e.
	Uddata skriv: (
		besked kopiér ~encoded: e, ~decoded: d
	), stop.
}.
