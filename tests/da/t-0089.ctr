>> randomizer := { :a :b
	>> minimum := ( a < b ) enten: a eller: b.
	>> maksimum := ( a > b ) enten: a eller: b.
	>> x := Intet.
	{
		x := Tal mellem: a og: b.
		((x < minimum) eller: (x > maksimum)) sand: { 
			Uddata skriv: (['Invalid value!']).
			Program afslut.
		}.
	} 
	× 100. <- x.
}.
randomizer anvend: 0 og: 0.
randomizer anvend: 1 og: 0.
