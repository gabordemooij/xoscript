Server init.

>> conn1 := Maria-DB ny vært: ['localhost'],
	brugernavn: ['xo'],
	adgangskode: ['pass123'],
	databasenavn: ['xobase'],
	tilslut.

>> conn2 := Maria-DB ny vært: ['localhost'],
	brugernavn: ['xo'],
	adgangskode: ['pass123'],
	databasenavn: ['xobase'],
	tilslut.
#...
>> del := conn1 forespørgsel: ['DELETE FROM book WHERE id > 0'].
{  del udfør. conn1 bekræft. } fang: { :e conn1 rul-tilbage.  }, start.

>> insert := conn1 forespørgsel: ['INSERT INTO book (id) VALUES(null)'].
insert udfør.

>> antal := conn1 forespørgsel: ['SELECT COUNT(*) AS num FROM book'].
antal hent: { :row Uddata skriv: row num, stop. }.

# does not show up
# insert not committed on connection 1
>> antal := conn2 forespørgsel: ['SELECT COUNT(*) AS num FROM book'].
antal hent: { :row Uddata skriv: row num, stop. }.
