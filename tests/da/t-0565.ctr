Server init.

>> besked := ['dette er en tekst, der skal krypteres!'].
>> key := ['hemmelig123!'].
>> boksen := Boks ny: ['minboks'].

>> krypteret := boksen kryptér: besked nøgle: key.
>> dekrypteret := boksen dekryptér: krypteret nøgle: key.

Uddata 
skriv: ['Message:'], stop
skriv: besked, stop
skriv: ['Decrypted:'], stop
