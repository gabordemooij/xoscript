

>> brugtHukommelse1 := 0.
>> brugtHukommelse2 := 0.
>> brugtHukommelse3 := 0.
>> brugtHukommelse4 := 0.

Program hukommelsesstyring: 0.

>> txt := ['1.6'].
>> n := txt tal.
>> t := txt boolsk.
Uddata skriv: n, stop.
Uddata skriv: t, stop.
Uddata skriv: n type, stop.
Uddata skriv: t type, stop.

Program ryd-op.

brugtHukommelse1 := (Program hukommelse ? 0).


txt := ['1.6'].
n := txt tal.
t := txt boolsk.
Uddata skriv: n, stop.
Uddata skriv: t, stop.
Uddata skriv: n type, stop.
Uddata skriv: t type, stop.

Program ryd-op.
brugtHukommelse2 := (Program hukommelse ? 0).


txt := ['1.6'].
n := txt tal.
t := txt boolsk.
Uddata skriv: n, stop.
Uddata skriv: t, stop.
Uddata skriv: n type, stop.
Uddata skriv: t type, stop.

Program ryd-op.
brugtHukommelse3 := (Program hukommelse ? 0).



( brugtHukommelse1 = brugtHukommelse2 og: brugtHukommelse1 = brugtHukommelse3, og: brugtHukommelse2 = brugtHukommelse3 ) sand: {
	Uddata skriv: ['Ingen hukommelseslæk her'].
}, falsk: {
	Uddata skriv: ['Lækker hukommelse...'].
}.
