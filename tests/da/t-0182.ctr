

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program hukommelsesstyring: 0.

>> txt := ['1.6'].
>> n := txt tal.
>> t := txt boolsk.
Uddata skriv: n, stop.
Uddata skriv: t, stop.
Uddata skriv: n type, stop.
Uddata skriv: t type, stop.

Program ryd-op.

usedMemory1 := (Program hukommelse ? 0).


txt := ['1.6'].
n := txt tal.
t := txt boolsk.
Uddata skriv: n, stop.
Uddata skriv: t, stop.
Uddata skriv: n type, stop.
Uddata skriv: t type, stop.

Program ryd-op.
usedMemory2 := (Program hukommelse ? 0).


txt := ['1.6'].
n := txt tal.
t := txt boolsk.
Uddata skriv: n, stop.
Uddata skriv: t, stop.
Uddata skriv: n type, stop.
Uddata skriv: t type, stop.

Program ryd-op.
usedMemory3 := (Program hukommelse ? 0).



( usedMemory1 = usedMemory2 og: usedMemory1 = usedMemory3, og: usedMemory2 = usedMemory3 ) sand: {
	Uddata skriv: ['No memory leaks here'].
}, falsk: {
	Uddata skriv: ['Leaking memory...'].
}.
