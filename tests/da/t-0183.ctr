

>> brugtHukommelse1 := 0.
>> brugtHukommelse2 := 0.
>> brugtHukommelse3 := 0.
>> brugtHukommelse4 := 0.

Program hukommelsesstyring: 0.

>> o := Objekt ny.
>> o2 := Objekt ny.
Uddata skriv: o Intet?, stop.
Uddata skriv: o type, stop.
Uddata skriv: ( o lige-med: o ), stop.
Uddata skriv: ( o lige-med: o2 ), stop.
Uddata skriv: o mig-selv, stop.
Uddata skriv: ( o gør færdig ), stop.

Program ryd-op.

brugtHukommelse1 := (Program hukommelse ? 0).


o := Objekt ny.
o2 := Objekt ny.
Uddata skriv: o Intet?, stop.
Uddata skriv: o type, stop.
Uddata skriv: ( o lige-med: o ), stop.
Uddata skriv: ( o lige-med: o2 ), stop.
Uddata skriv: o mig-selv, stop.
Uddata skriv: ( o gør færdig ), stop.

Program ryd-op.
brugtHukommelse2 := (Program hukommelse ? 0).


o := Objekt ny.
o2 := Objekt ny.
Uddata skriv: o Intet?, stop.
Uddata skriv: o type, stop.
Uddata skriv: ( o lige-med: o ), stop.
Uddata skriv: ( o lige-med: o2 ), stop.
Uddata skriv: o mig-selv, stop.
Uddata skriv: ( o gør færdig ), stop.

Program ryd-op.
brugtHukommelse3 := (Program hukommelse ? 0).



( brugtHukommelse1 = brugtHukommelse2 og: brugtHukommelse1 = brugtHukommelse3, og: brugtHukommelse2 = brugtHukommelse3 ) sand: {
	Uddata skriv: ['Ingen hukommelseslæk her'].
}, falsk: {
	Uddata skriv: ['Lækker hukommelse...'].
}.
