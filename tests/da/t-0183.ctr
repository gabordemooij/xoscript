

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program hukommelsesstyring: 0.

>> o := Objekt ny.
>> o2 := Objekt ny.
Uddata skriv: o Intet?, stop.
Uddata skriv: o type, stop.
Uddata skriv: ( o lige-med: o ), stop.
Uddata skriv: ( o lige-med: o2 ), stop.
Uddata skriv: o mig-selv, stop.
Uddata skriv: ( o gør færdig ), stop.

Program ryd-op.

usedMemory1 := (Program hukommelse ? 0).


o := Objekt ny.
o2 := Objekt ny.
Uddata skriv: o Intet?, stop.
Uddata skriv: o type, stop.
Uddata skriv: ( o lige-med: o ), stop.
Uddata skriv: ( o lige-med: o2 ), stop.
Uddata skriv: o mig-selv, stop.
Uddata skriv: ( o gør færdig ), stop.

Program ryd-op.
usedMemory2 := (Program hukommelse ? 0).


o := Objekt ny.
o2 := Objekt ny.
Uddata skriv: o Intet?, stop.
Uddata skriv: o type, stop.
Uddata skriv: ( o lige-med: o ), stop.
Uddata skriv: ( o lige-med: o2 ), stop.
Uddata skriv: o mig-selv, stop.
Uddata skriv: ( o gør færdig ), stop.

Program ryd-op.
usedMemory3 := (Program hukommelse ? 0).



( usedMemory1 = usedMemory2 og: usedMemory1 = usedMemory3, og: usedMemory2 = usedMemory3 ) sand: {
	Uddata skriv: ['No memory leaks here'].
}, falsk: {
	Uddata skriv: ['Leaking memory...'].
}.
