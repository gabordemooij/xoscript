>> Punkt := Objekt ny.
Punkt ved: ['x-coordinate:'] gør: { :x egen x := x. }.
Punkt ved: ['y-coordinate:'] gør: { :y egen y := y. }.
Punkt ved: ['x-koordinat']  gør: { <- egen x kopiér. }.
Punkt ved: ['y-koordinat']  gør: { <- egen y kopiér. }.

Punkt ved: ['='] gør: { :anden
	<- ( egen x = anden x-koordinat
		 og: egen y = anden y-koordinat ).
}.

>> mole := Punkt ny x-coordinate: 5, y-coordinate: 6.
>> rådhus := Punkt ny x-coordinate: 7, y-coordinate: 1.
>> restaurant := Punkt ny x-coordinate: 5, y-coordinate: 6.

Uddata skriv: mole = rådhus, stop.
Uddata skriv: mole = restaurant, stop.
