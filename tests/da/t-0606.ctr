>> Point := Objekt ny.
Point ved: ['x-coordinate:'] gør: { :x egen x := x. }.
Point ved: ['y-coordinate:'] gør: { :y egen y := y. }.
Point ved: ['x-coordinate']  gør: { <- egen x kopiér. }.
Point ved: ['y-coordinate']  gør: { <- egen y kopiér. }.

Point ved: ['='] gør: { :other <- ( egen x = other x-coordinate
		 og: egen y = other y-coordinate ).
}.

>> pier := Point ny x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point ny x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point ny x-coordinate: 5, y-coordinate: 6.

Uddata skriv: pier = town-hall, stop.
Uddata skriv: pier = restaurant, stop.
