Uddata skriv: ['Testobjekt'], stop.
>> p := Sti /tmp.
Uddata skriv: p, stop.
>> gammel-p-adresse := p prototype hukommelsesadresse.
p save-as: ['/tmp/a.bin'].
Uddata skriv: ['========== GENINDLÆSER SNAP:'], stop.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b prototype hukommelsesadresse = gammel-p-adresse) sand: {
	Uddata skriv: ['Objektlink genoprettet.'], stop.
}.
Uddata skriv: b, stop.
