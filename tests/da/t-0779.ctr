Uddata skriv: ['Test object'], stop.
>> p := Sti /tmp.
Uddata skriv: p, stop.
>> old-p-address := p prototype hukommelsesadresse.
p save-as: ['/tmp/a.bin'].
Uddata skriv: ['========== RELOADING SNAP:'], stop.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b prototype hukommelsesadresse = old-p-address) sand: {
	Uddata skriv: ['Object link re-attached.'], stop.
}.
Uddata skriv: b, stop.
