


>> brugtHukommelse1 := 0.
>> brugtHukommelse2 := 0.
>> brugtHukommelse3 := 0.
>> brugtHukommelse4 := 0.

Program hukommelsesstyring: 0.
>> palet := Intet.
>> farver := Intet.

{
palet := Ordbog ny.
palet 
	sæt: ['#F00'] ved: ['rød'],
	sæt: ['#0F0'] ved: ['grøn'],
	sæt: ['#00F'] ved: ['blå'].
Uddata skriv: ['antal RGB-koder i paletten: '] + ( palet antal ), stop.
Uddata skriv: ['RGB-kode for grøn er: '] + ( palet ? ['grøn'] ), stop.
farver := [''].
( palet hver: { :navn :code
		farver := farver + ( navn + [':'] + code ).
} ).
Uddata skriv: ['Alle farver i paletten: '] + farver, stop.
} start.
Program ryd-op.
brugtHukommelse1 := (Program hukommelse ? 0).

{
palet := Ordbog ny.
palet 
	sæt: ['#F00'] ved: ['rød'],
	sæt: ['#0F0'] ved: ['grøn'],
	sæt: ['#00F'] ved: ['blå'].
Uddata skriv: ['antal RGB-koder i paletten: '] + ( palet antal ), stop.
Uddata skriv: ['RGB-kode for grøn er: '] + ( palet ? ['grøn'] ), stop.
farver := [''].
( palet hver: { :navn :code
		farver := farver + ( navn + [':'] + code ).
} ).
Uddata skriv: ['Alle farver i paletten: '] + farver, stop.
} start.
Program ryd-op.
brugtHukommelse2 := (Program hukommelse ? 0).

{
palet := Ordbog ny.
palet 
	sæt: ['#F00'] ved: ['rød'],
	sæt: ['#0F0'] ved: ['grøn'],
	sæt: ['#00F'] ved: ['blå'].
Uddata skriv: ['antal RGB-koder i paletten: '] + ( palet antal ), stop.
Uddata skriv: ['RGB-kode for grøn er: '] + ( palet ? ['grøn'] ), stop.
farver := [''].
( palet hver: { :navn :code
		farver := farver + ( navn + [':'] + code ).
} ).
Uddata skriv: ['Alle farver i paletten: '] + farver, stop.
} start.
Program ryd-op.
brugtHukommelse3 := (Program hukommelse ? 0).



( brugtHukommelse1 = brugtHukommelse2 og: brugtHukommelse1 = brugtHukommelse3, og: brugtHukommelse2 = brugtHukommelse3 ) sand: {
	Uddata skriv: ['Ingen hukommelseslæk her'].
}, falsk: {
	Uddata skriv: ['Lækker hukommelse...'].
}.
