


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program hukommelsesstyring: 0.
>> palette := Intet.
>> colors := Intet.

{
palette := Ordbog ny.
palette 
	sæt: ['#F00'] ved: ['red'],
	sæt: ['#0F0'] ved: ['green'],
	sæt: ['#00F'] ved: ['blue'].
Uddata skriv: ['number of RGB codes in palette: '] + ( palette antal ), stop.
Uddata skriv: ['RGB code of green is: '] + ( palette ? ['green'] ), stop.
colors := [''].
( palette hver: { :navn :code
		colors := colors + ( navn + [':'] + code ).
} ).
Uddata skriv: ['All colors in palette: '] + colors, stop.
} start.
Program ryd-op.
usedMemory1 := (Program hukommelse ? 0).

{
palette := Ordbog ny.
palette 
	sæt: ['#F00'] ved: ['red'],
	sæt: ['#0F0'] ved: ['green'],
	sæt: ['#00F'] ved: ['blue'].
Uddata skriv: ['number of RGB codes in palette: '] + ( palette antal ), stop.
Uddata skriv: ['RGB code of green is: '] + ( palette ? ['green'] ), stop.
colors := [''].
( palette hver: { :navn :code
		colors := colors + ( navn + [':'] + code ).
} ).
Uddata skriv: ['All colors in palette: '] + colors, stop.
} start.
Program ryd-op.
usedMemory2 := (Program hukommelse ? 0).

{
palette := Ordbog ny.
palette 
	sæt: ['#F00'] ved: ['red'],
	sæt: ['#0F0'] ved: ['green'],
	sæt: ['#00F'] ved: ['blue'].
Uddata skriv: ['number of RGB codes in palette: '] + ( palette antal ), stop.
Uddata skriv: ['RGB code of green is: '] + ( palette ? ['green'] ), stop.
colors := [''].
( palette hver: { :navn :code
		colors := colors + ( navn + [':'] + code ).
} ).
Uddata skriv: ['All colors in palette: '] + colors, stop.
} start.
Program ryd-op.
usedMemory3 := (Program hukommelse ? 0).



( usedMemory1 = usedMemory2 og: usedMemory1 = usedMemory3, og: usedMemory2 = usedMemory3 ) sand: {
	Uddata skriv: ['No memory leaks here'].
}, falsk: {
	Uddata skriv: ['Leaking memory...'].
}.
