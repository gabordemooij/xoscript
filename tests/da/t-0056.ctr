>> z := Objekt ny.
z ved: ['value:'] gør: { :v
	egen value := v. <- selv.
}.
z ved: ['value'] gør: { <- egen value. }.
(z setValue: 1) value: 2.
Uddata skriv: z value.
>> x := z.
Uddata skriv: x value.
z := Intet.
Uddata skriv: z value.
Uddata skriv: x value.
Uddata skriv: ['hello'].
Uddata skriv: 3 + 2.
Uddata skriv: (3 > 2).
