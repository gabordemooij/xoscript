# test typekonverteringer / omdannelser / bindinger
Program hukommelsesstyring: 4.
Server init.

>> tæller := 0.
>> db := Maria-DB ny vært: ['localhost'],
	brugernavn: ['xo'], adgangskode: ['pass123'], databasenavn: ['xobase'], tilslut.

>> TocifretFormat := Format ny: ['%02d'].

# Datotid
{
	>> år     := Tal mellem: 1995 og: 2050, tekst.
	>> måned    := TocifretFormat anvend-heltal: (Tal mellem: 1 og: 12), tekst.
	>> dag      := TocifretFormat anvend-heltal: (Tal mellem: 1 og: 28), tekst.
	>> time     := TocifretFormat anvend-heltal: (Tal mellem: 1 og: 23), tekst.
	>> minut   := TocifretFormat anvend-heltal: (Tal mellem: 1 og: 59), tekst.
	>> sekund   := TocifretFormat anvend-heltal: (Tal mellem: 1 og: 59), tekst.
	>> datotid := ['YYYY-MM-DD HH:II:SS'].	
	datotid
		YYYY: år,
		MM: måned,
		DD: dag,
		HH: time,
		II: minut,
		SS: sekund.
	>> søgeparametre :=
	db forespørgsel: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: datotid),
	hent: { :række
		(række mydatetime = datotid) falsk: {
			denne-opgave fejl: (
				['Forventet: <expected> men fik: <observation>']
				<expected>: datotid,
				<observation>: række mydatetime
			).
		}.
	
	}.
	tæller læg-til: 1.
} * 100.

# Dato
{
	>> år     := Tal mellem: 1995 og: 2050, tekst.
	>> måned    := TocifretFormat anvend-heltal: (Tal mellem: 1 og: 12), tekst.
	>> dag      := TocifretFormat anvend-heltal: (Tal mellem: 1 og: 28), tekst.
	>> dato     := ['YYYY-MM-DD'].
	dato
		YYYY: år,
		MM: måned,
		DD: dag.
	>> søgeparametre :=
	db forespørgsel: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: dato),
	hent: { :række
		(række mydate = dato) falsk: {
			denne-opgave fejl: (
				['Forventet: <expected> men fik: <observation>']
				<expected>: dato,
				<observation>: række mydate
			).
		}.
	}.
	tæller læg-til: 1.
} * 100.


# Tid
{
	>> time     := TocifretFormat anvend-heltal: (Tal mellem: 1 og: 23), tekst.
	>> minut   := TocifretFormat anvend-heltal: (Tal mellem: 1 og: 59), tekst.
	>> sekund   := TocifretFormat anvend-heltal: (Tal mellem: 1 og: 59), tekst.
	>> tid := ['HH:II:SS'].
	tid
		HH: time,
		II: minut,
		SS: sekund.
	>> søgeparametre :=
	db forespørgsel: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: tid),
	hent: { :række
		(række mytime = tid) falsk: {
			denne-opgave fejl: (
				['Forventet: <expected> men fik: <observation>']
				<expected>: datotid,
				<observation>: række mytime
			).
		}.
	}.
	tæller læg-til: 1.
} * 100.


# Tekster (varchar/text)
>> str1 := Liste ny fyld: 100000 med: ['x'], saml: [''].
{
	>> str2 := Boks token: 40.
	>> søgeparametre :=
	db forespørgsel: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	hent: { :række
		(række str1 = str1 og: række str2 = str2) falsk: {
			denne-opgave fejl: (
				['Forventet: <expected> men fik: <observation>']
				<expected>: datotid,
				<observation>: række mytime
			).
		}.
	}.
	tæller læg-til: 1.
} * 100.


# Tal
{
	>> n1  := Tal mellem: 1 og: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 fra-tekst: ['9223372036854775807'] ) -
		( Int64 fra-tekst: ['99999'] ) +
		( Int64 fra-tekst: n1 tekst )
	).
	>> søgeparametre :=
	db forespørgsel: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	hent: { :række
		(række n1 = n1) falsk: {
			denne-opgave fejl: (
				['Forventet: <expected> men fik: <observation>']
				<expected>: n1,
				<observation>: række n1
			).
		}.
		(række n2 = n2) falsk: {
			denne-opgave fejl: (
				['Forventet: <expected> men fik: <observation>']
				<expected>: n1,
				<observation>: række n2
			).
		}.
		(række n3 = n2 afrund) falsk: {
			denne-opgave fejl: (
				['Forventet: <expected> men fik: <observation>']
				<expected>: n1,
				<observation>: række n3
			).
		}.
		(række big = big) falsk: {
			denne-opgave fejl: (
				['Forventet: <expected> men fik: <observation>']
				<expected>: big,
				<observation>: række big
			).
		}.
		
	}.
	tæller læg-til: 1.
} * 100.


Uddata skriv: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: tæller
), stop.