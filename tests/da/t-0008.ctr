>> Hilser := Objekt ny.
Hilser ved: ['lav'] gør: {
	>> hilser := Objekt ny.
	hilser ved: ['name:'] gør: { :navn
		Uddata skriv: ['sætter et navn'].
		egen mitNavn := navn.
	}.
	hilser ved: ['hils'] gør: {
		Uddata skriv: ['Hello'].
		Uddata skriv: egen mitNavn.
	}. <- hilser.
}.
>> hilser := Hilser lav.
hilser name: ['solskin!'].
hilser hils.
