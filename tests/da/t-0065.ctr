Tal ved: ['factorial'] gør: {
	>> total := 1.
	{ :index total gang-med: (selv - (index)). } × selv. <- total.
}.
>> Printer := Objekt ny.
Printer ved: ['print:and:'] gør: { :x :y
	Uddata skriv: ['a='] + x + [', b='] + y, stop.
}.
>> a := 4.5. >> b := a rund-ned.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a rund-op.
Printer print: a and: b.
a := 4.5. b := a rund-ned.
Printer print: a and: b.
a := 4.5. b := a afrund.
Printer print: a and: b.
a := 4.2. b := a afrund.
Printer print: a and: b.

Uddata skriv: (9 modulo: 5), stop.
Uddata skriv: -666 absolut, stop.
Uddata skriv: 49 kvadratrod, stop.
Uddata skriv: (2 opløftet: 3), stop.
>> l := (Liste ← 9 ; 6).
Uddata skriv: l minimum.

