#Linux
>> clock := Øjeblik ny.
clock zone: ['UTC-1'].
clock år: 1981, måned: 1, dag: 5,
      time: 13, minut: 15, sekund: 13.

Uddata skriv: clock, stop.
clock zone: ['UTC+0'].

Uddata skriv: (
	(clock år rå) + ['-'] + (clock måned) + ['-'] + (clock dag) + [' '] +
	(clock time) + [':'] + (clock minut) + [':'] + (clock sekund) + [' '] +
	['W'] + (clock uge) + (clock zone)
), stop.


clock zone: ['UTC-1'].
Uddata skriv: (
	(clock år rå) + ['-'] + (clock måned) + ['-'] + (clock dag) + [' '] +
	(clock time) + [':'] + (clock minut) + [':'] + (clock sekund) + [' '] +
	['W'] + (clock uge) + (clock zone)
), stop.
