#Linux
>> ur := Øjeblik ny.
ur zone: ['UTC-1'].
ur år: 1981, måned: 1, dag: 5,
      time: 13, minut: 15, sekund: 13.

Uddata skriv: ur, stop.
ur zone: ['UTC+0'].

Uddata skriv: (
	(ur år rå) + ['-'] + (ur måned) + ['-'] + (ur dag) + [' '] +
	(ur time) + [':'] + (ur minut) + [':'] + (ur sekund) + [' '] +
	['W'] + (ur uge) + (ur zone)
), stop.


ur zone: ['UTC-1'].
Uddata skriv: (
	(ur år rå) + ['-'] + (ur måned) + ['-'] + (ur dag) + [' '] +
	(ur time) + [':'] + (ur minut) + [':'] + (ur sekund) + [' '] +
	['W'] + (ur uge) + (ur zone)
), stop.
