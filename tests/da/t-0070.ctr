>> numbers := ['1,2,3'] opdel: [','].
Uddata skriv: ['I got: '] + numbers antal + [' numbers.'],stop.
{ :i Uddata skriv: ['number #'] + i + [':'] + (numbers position: i), stop.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages opdel: [' Or '].
Uddata skriv: ['We serve'], stop.
{ :i Uddata skriv: ['->'] + (beverages position: i), stop. } × (beverages antal).
Uddata skriv: (beverages saml: [',']), stop.
Uddata skriv: (numbers saml: ['||']).
