>> tallene := ['1,2,3'] opdel: [','].
Uddata skriv: ['Jeg fik: '] + tallene antal + [' tal.'],stop.
{ :i Uddata skriv: ['number #'] + i + [':'] + (tallene position: i), stop.} × 3.
>> drikkevarer := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
drikkevarer := drikkevarer opdel: [' Or '].
Uddata skriv: ['Vi serverer'], stop.
{ :i Uddata skriv: ['->'] + (drikkevarer position: i), stop. } × (drikkevarer antal).
Uddata skriv: (drikkevarer saml: [',']), stop.
Uddata skriv: (tallene saml: ['||']).
