# Test utf8-rensning
Server init.

>> utf8tilfælde := Ordbog ny
	# Kun ASCII
	sæt: ( Liste ny ; 65 ; 65 ; 65 ; 65 ; 0 ) ved: ['AAAA'],
	# gyldig 2-byte-sekvens
	sæt: ( Liste ny ; 194 ; 162 ; 0 ) ved: ['¢'],
	# Gyldig 3-byte UTF-8
    sæt: ( Liste ny ; 226 ; 130 ; 172 ; 0 ) ved: ['€'],
	# Gyldig 4-byte UTF-8
    sæt: ( Liste ny ; 240 ; 144 ; 141 ; 136 ; 0 ) ved: ['𐍈'],
	# Ugyldig fortsættelsesbyte i sekvensen E2 28 AC -> start 3b-sekv + 28 forkert fortsættelse + AC fortsættelsesbyte, men hører til samme fejl
    sæt: ( Liste ny ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) ved: ['A?A'],
	# Overlang kodning af ASCII 'A' (bør blive ?),
    sæt: ( Liste ny ; 65 ; 193 ; 129 ; 0 ) ved: ['A?'],
	# Ugyldig første byte (0xFF)
    sæt: ( Liste ny ; 255 ; 0 ) ved: ['?'],
	# Ufuldstændig multibyte-sekvens til sidst
    sæt: ( Liste ny ; 66 ; 226 ; 0 ) ved: ['B?'],
    # Tom tekst
    #put: ( List new ) at: [''],
	# Flere blandede sekvenser
    sæt: ( Liste ny ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) ved: ['A€?𐍈B'].
	 
utf8tilfælde hver: { :key :value
	>> blob := Blob ny: value antal, bytes: value.
	>> str := blob tekst.
	(str = key) sand: {
		Uddata skriv: ['OK'], stop.
	}, ellers: {
		Uddata skriv: ['UTF8-rensning fejlede på: '] + key + [' fik: '] + str, stop.
	}.
	blob frigiv.
}.
