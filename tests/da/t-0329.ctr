Uddata skriv: ((Liste ny
	ved: ['plaque:'] gør: { :x egen o := x. },
	ved: ['plakette']  gør: { <- egen o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Liste ← 1)
	~ (Liste ← 1 ; 2)
	~ (Liste ← 1 ; 2 ; 3)
	~ (Liste ← 1 ; 2 ; 3 ; 4)
	~ (Liste ← 1 ; 2 ; 3 ; 4 ; 5)
) hver: { :i :el
	{ Uddata skriv: denne-opgave. } × el antal.
	Uddata stop.
}) plakette, stop.


