

# create a 64-bit integer for exact calculations
>> a := Int64 fra-tekst: ['123'].

# to string
Uddata skriv: a, stop.

# divide
Uddata skriv: a / (Int64 fra-tekst: ['3']), stop.

# multiply
Uddata skriv: a * (Int64 fra-tekst: ['2']), stop.

# add
Uddata skriv: a + (Int64 fra-tekst: ['1']), stop.

# subtract
Uddata skriv: a - (Int64 fra-tekst: ['2']), stop.

# compare
Uddata skriv: ( a =   (Int64 fra-tekst: ['123'])), stop.
Uddata skriv: ( a !=: (Int64 fra-tekst: ['124'])), stop.
Uddata skriv: ( a <   (Int64 fra-tekst: ['124'])), stop.
Uddata skriv: ( a >   (Int64 fra-tekst: ['122'])), stop.
Uddata skriv: ( a >=: (Int64 fra-tekst: ['123'])), stop.
Uddata skriv: ( a <=: (Int64 fra-tekst: ['123'])), stop.





	