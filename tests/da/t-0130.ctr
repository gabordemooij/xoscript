# brug af FFI med Server-pluginnet

# forbind til libc (platformsafhængigt)
>> biblnavn := Program indstilling: ['FFITESTLIB'].

# forbind stdio-funktioner fra C til avancerede filoperationer
Server forbind: ( Liste ny ;
 biblnavn ; ['fopen'] ;
 ( Liste ny ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
forbind: ( Liste ny ;
 Intet ; # betyder samme bibliotek
 ['fread'] ;
 ( Liste ny ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Intet ; # betyder samme objekt (dvs. Stream)
 ['fread']
),
forbind: (
 Liste ny ;
 Intet ; # betyder samme bibliotek
 ['fwrite'] ;
 ( Liste ny ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Intet ; # betyder samme bibliotek
 ['fwrite']
),
forbind: (
 Liste ny ;
 Intet ; # betyder samme bibliotek
 ['rewind'] ;
 ( Liste ny ; ['pointer'] ) ;
 ['int'] ;
 Intet ; # betyder samme bibliotek
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> sti := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# åbn en fil med fopen(path, mode)
>> fd := Stream path: sti mode: mode.

# skriv bytes fra bufferen tegnstreng til filen
>> bytes-skrevet := Stream besked: ['fwrite'] argumenter: (Liste ny ; str ; 1 ; 6 ; fd ).
Uddata skriv: bytes-skrevet, stop.

# spol filmarkøren tilbage
Stream rewind: fd.

# alloker en buffer
>> buf := Blob ny: 20.

# læs fra filen
>> bytes-læst := Stream besked: ['fread'] argumenter: (Liste ny ; buf ; 1 ; 6 ; fd ).
Uddata skriv: bytes-læst, stop.
Uddata skriv: buf, stop.

# frigiv hukommelse
str  frigiv.
sti frigiv.
mode frigiv.
buf  frigiv.


