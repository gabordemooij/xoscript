Uddata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gør: { :øjeblikket
	egen øjeblikket := øjeblikket. 
}.

a ved: ['vare'] gør: {
	<- egen øjeblikket.
}.

>> idag := Liste ny ; ( Øjeblik ny zone: ['CEST'], år: 2026, måned: 7 ).
a item: idag.
Uddata skriv: a vare ? 0, stop.
a save-as: ['/tmp/a.bin'].
