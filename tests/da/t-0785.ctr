Uddata skriv: ['Test object'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gør: { :moment
	egen moment := moment. 
}.

a ved: ['item'] gør: { <- egen moment.
}.

>> today := Liste ny ; ( Øjeblik ny zone: ['CEST'], år: 2026, måned: 7 ).
a item: today.
Uddata skriv: a item ? 0, stop.
a save-as: ['/tmp/a.bin'].
