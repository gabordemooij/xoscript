Uddata skriv: ['Test object'], stop.
>> cmd := Kommando ny.
Uddata skriv: cmd ls /tmp, stop.
>> old-cmd-address := cmd prototype hukommelsesadresse.
cmd save-as: ['/tmp/a.bin'].
Uddata skriv: ['========== RELOADING SNAP:'], stop.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b prototype hukommelsesadresse = old-cmd-address) sand: {
	Uddata skriv: ['Object link re-attached.'], stop.
}.
Uddata skriv: b ls, stop.


