>> Grandfather := Objekt ny.
Grandfather ved: ['greet'] gør: {
	Uddata skriv: ['Ave!'], stop.
}.
>> Father := Grandfather ny.
Father ved: ['greet'] gør: {
	Uddata skriv: ['Hello'], stop.
	selv greet.
}.
>> Son := Father ny.
Son ved: ['greet'] gør: {
	Uddata skriv: ['Hi'], stop.
	selv greet.
}.

Son greet.

>> Roundabout := Objekt ny.
Roundabout ved: ['circle:'] gør: { :x
	Uddata skriv: x, stop.
	(x < 3) sand: { selv rekursiv circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) sand: { Uddata skriv: x, stop. x læg-til: 1.  increment start. }. }.
increment start.