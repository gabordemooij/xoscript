Program hukommelsesstyring: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } fang: {
		oops læg-til: 1.
	}, start.
} × 1000.

{
	Uddata skriv: ['hi there!'].
	denne-opgave fejl: ['oops'].
	Uddata skriv: ['hi there!'].
	{ Uddata skriv: ['dont print this']. } start.
} fang: { :e 
	Uddata skriv: ['got ya!']. 
	Uddata skriv: e.
}, start.
