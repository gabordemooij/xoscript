Program hukommelsesstyring: 4.

>> Fordobler := Objekt ny.
>> Multiplikator := Objekt ny.
Fordobler ved: ['fordobl:og:'] gør: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplikator ved: ['gang:og:'] gør: { :x :y <- (x × y).
}.

Uddata skriv: (
	Fordobler fordobl:
		(Fordobler fordobl: 
			(Multiplikator gang: 2 og: 3)
		og:
			(Multiplikator gang: 3 og: 4)
		)
	og:
		(Fordobler fordobl: 
			(Multiplikator gang: 2 og: 3)
		og:
			(Multiplikator gang: 3 og: 4)
		)
), stop.
