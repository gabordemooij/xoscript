Program hukommelsesstyring: 4.

>> Doubler := Objekt ny.
>> Multiplier := Objekt ny.
Doubler ved: ['double:and:'] gør: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier ved: ['multiply:and:'] gør: { :x :y <- (x × y).
}.

Uddata skriv: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), stop.
