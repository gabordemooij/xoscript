>> Slurp := Objekt ny.

Slurp ved: ['ny'] gør: {
	egen str := [''].
}.

Slurp ved: ['svar:'] gør: { :blah
		(egen str = ['']) sand: {
			egen str tilføj: blah.
		}, ellers: {
			egen str tilføj: [' '].
			egen str tilføj: blah.
		}.
}.

Slurp ved: ['svar:og:'] gør: { :blah :blahah
		(blah længde > 1) sand: {
			egen str tilføj: (blah fra: 0 længde: (blah længde - 1)).
		}, ellers: {
			egen str tilføj: blah.
		}.
		egen str tilføj: [' '].
		egen str tilføj: blahah.
}.

Slurp ved: ['obtain'] gør: {
	>> buffer := egen str.
	egen str := ['']. <- buffer.
}.


>> x := Slurp ny.
x + 3.
Uddata skriv: (x obtain), stop.
x echo: ['Hello world'].
Uddata skriv: (x obtain), stop.
x tellme: 123 and: 987.
Uddata skriv: (x obtain), stop.
