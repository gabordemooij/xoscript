>> vingård := { <- (	Ordbog ny
		sæt: 2 ved: ['merlot'],
		sæt: 3 ved: ['malbec'],
		sæt: 4 ved: ['syrah']
	).
}.

Uddata skriv: (((vingård start) - ['intet']) antal), stop.
Uddata skriv: (((vingård start) - ['merlot']) antal), stop.
Uddata skriv: (((vingård start) - ['malbec']) antal), stop.
Uddata skriv: (((vingård start) - ['syrah']) antal), stop.
Uddata skriv: (((vingård start) - ['merlot'] - ['malbec']) antal), stop.
Uddata skriv: (((vingård start) - ['merlot'] - ['syrah']) antal), stop.
Uddata skriv: (((vingård start) - ['malbec'] -['syrah']) antal), stop.
Uddata skriv: (((vingård start) - ['malbec'] - ['syrah'] - ['merlot']) antal), stop.

