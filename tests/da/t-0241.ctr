

Tekst ved: ['evaluer'] gør: {
	>> code := Fil ny: ['/tmp/eval.ctr'].
	code skriv: (selv tekst + ['.']).
	Program brug: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Liste ← (['Anførselstegn '] + Q + [' er onde?']) ; 1.
>> x := q tekst.
Uddata skriv: x, stop.
>> y := Intet.
(['y := '] + x ) evaluer.
Uddata skriv: y ? 0, stop.

q := Ordbog sæt: ['\[''] ved: ['\['quote\']'].
x := q tekst.
Uddata skriv: x, stop.
y := Intet.
(['y := '] + x ) evaluer.

>> q := (Ordbog ny) sæt:['\[''] ved:['\['quote\[''].
Uddata skriv: y ? ['\['quote\']'], stop.
