Uddata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gør: { :hexhjælper
	egen hexhjælper := hexhjælper. 
}.

a ved: ['vare'] gør: {
	<- egen hexhjælper.
}.

a item: Hx ny.

>> gammel-hexhjælper-adresse := a vare prototype hukommelsesadresse.
a save-as: ['/tmp/a.bin'].
Uddata skriv: ['========== GENINDLÆSER SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b vare prototype hukommelsesadresse = gammel-hexhjælper-adresse) sand: {
	Uddata skriv: ['Objektlink genoprettet.'], stop.
}.
