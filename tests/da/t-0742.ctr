Uddata skriv: ['Test object'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gør: { :hexhelper
	egen hexhelper := hexhelper. 
}.

a ved: ['item'] gør: { <- egen hexhelper.
}.

a item: Hx ny.

>> old-hexhelper-address := a item prototype hukommelsesadresse.
a save-as: ['/tmp/a.bin'].
Uddata skriv: ['========== RELOADING SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototype hukommelsesadresse = old-hexhelper-address) sand: {
	Uddata skriv: ['Object link re-attached.'], stop.
}.
