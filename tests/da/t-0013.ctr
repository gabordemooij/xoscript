
>> Dyr := Objekt ny.
Dyr ved: ['ny'] gør: {
	<- selv ny init.
}.

Dyr ved: ['init'] gør: {
	egen lyd := ['?'].
	egen ben  := 4.
}.

>> Hund := Dyr ny.
Hund ved: ['init'] gør: {
	selv init.
	egen lyd := ['gør'].
}.

Dyr ved: ['tekst'] gør: {
	<- egen ben tekst + egen lyd.
}.

>> puddel := Hund ny.
Uddata skriv: puddel, stop.

