
>> Animal := Objekt ny.
Animal ved: ['ny'] gør: { <- selv ny init.
}.

Animal ved: ['init'] gør: {
	egen sound := ['?'].
	egen legs := 4.
}.

>> Dog := Animal ny.
Dog ved: ['init'] gør: {
	selv init.
	egen sound := ['barks'].
}.

Animal ved: ['tekst'] gør: { <- egen legs tekst + egen sound.
}.

>> poodle := Dog ny.
Uddata skriv: poodle, stop.

