# færre parametre end pladsholdere skal give en fejl, ikke læse forbi bindingerne
Server init.

>> db := Maria-DB ny vært: ['localhost'],
	brugernavn: ['xo'],
	adgangskode: ['pass123'],
	databasenavn: ['xobase'],
	tilslut.

>> søgeparametre := db forespørgsel: ['SELECT ? AS a, ? AS b, ? AS c'].
søgeparametre parametre: (Liste ny ; ['1']).
{ søgeparametre hent: { :række Uddata skriv: række, stop. }. } fang: { :e Uddata skriv: e, stop. }, start.

>> søgeparametre := db forespørgsel: ['SELECT ? AS a'].
{ søgeparametre hent: { :række Uddata skriv: række, stop. }. } fang: { :e Uddata skriv: e, stop. }, start.

# det rigtige antal virker stadig, flere parametre ignoreres som før
>> søgeparametre := db forespørgsel: ['SELECT ? AS a, ? AS b'].
søgeparametre parametre: (Liste ny ; ['1'] ; ['2']).
søgeparametre hent: { :række Uddata skriv: (række ved: ['a']), skriv: (række ved: ['b']), stop. }.
søgeparametre parametre: (Liste ny ; ['1'] ; ['2'] ; ['3']).
søgeparametre hent: { :række Uddata skriv: (række ved: ['a']), skriv: (række ved: ['b']), stop. }.
