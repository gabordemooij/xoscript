Server init.

>> DB := Maria-DB ny vært: ['localhost'],
	brugernavn: ['xo'],
	adgangskode: ['pass123'],
	databasenavn: ['xobase'],
	tilslut.

{
	DB forespørgsel:
	['DROP TABLE movies'],
	udfør.
} fang: { Intet. }, start.

DB forespørgsel:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
udfør.

DB forespørgsel: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parametre: ( Liste ny ; ['Halloween'] ),
udfør.

DB forespørgsel: ['SELECT * FROM movies'],
hent: { :movie
	Uddata skriv: movie title, stop.
}.

