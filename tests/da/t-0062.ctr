Boolsk ved: ['xor:'] gør: { :a :b <- ((a og: b ikke) eller: (a ikke og: b)).
}.

>> o := Objekt ny.
o ved: ['hello'] gør: { ['Empty']. }.
{ o ved: 2 gør: 3.} fang: { :e Uddata skriv: e, stop. }, start.
{ o ved: ['test'] gør: 3.} fang: { :e Uddata skriv: e, stop. }, start.
{ o ved: ['hello'] gør: { ['Empty']. }.} fang: { :e Uddata skriv: e, stop. }, start. 
{ >> z := 4 ÷ 0. } fang: { :e Uddata skriv: e, stop. }, start. 
{ (Sand og: Intet) sand: { Uddata skriv: ['X'].}. } fang: { :e Uddata skriv: e, stop. }, start. 
{ ([''] xor: 0) sand: { Uddata skriv: ['X'].}. } fang: { :e Uddata skriv: e, stop. }, start. 
{ (1 < ['2']) sand: { Uddata skriv: ['OK']. }. } fang: { :e Uddata skriv: e, stop. }, start. 
{ (1 < ['2.0']) sand: { Uddata skriv: ['OK']. }. } fang: { :e Uddata skriv: e, stop. }, start. 
{ (1 < ['x2.0']) sand: { Uddata skriv: ['NO!']. }. } fang: { :e Uddata skriv: e, stop. }, start. 
{ Uddata skriv: (['hello OK there'] fra: ['6'] længde: ['2']). } start. 
