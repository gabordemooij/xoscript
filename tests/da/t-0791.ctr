Server init.

>> DB := Maria-DB ny vært: ['localhost'],
	brugernavn: ['xo'],
	adgangskode: ['pass123'],
	databasenavn: ['xobase'],
	tilslut.
	
>> SQL := ['SELECT "hello" AS "world" '].

# opret forespørgsel manuelt
>> søgeparametre := Maria-Forespørgsel ny: SQL.

# sæt database
søgeparametre database: DB.

søgeparametre hent: { :række
	Uddata skriv: række world, stop.
}.
