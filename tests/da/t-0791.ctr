Server init.

>> DB := Maria-DB ny vært: ['localhost'],
	brugernavn: ['xo'],
	adgangskode: ['pass123'],
	databasenavn: ['xobase'],
	tilslut.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> søgeparametre := Maria-Forespørgsel ny: SQL.

# set database
søgeparametre database: DB.

søgeparametre hent: { :row
	Uddata skriv: row world, stop.
}.
