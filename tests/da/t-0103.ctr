>> a := Liste ← Objekt ; Sand ; Falsk ; Boolsk ; 1 ; Tal ; ['Str'] ; Tekst ; { ['Empty']. }.
Uddata skriv: (a antal), stop.
{ :i
	Uddata skriv: 
	['a '] + 
	((a ? i) type) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Intet?) enten: [''] eller: ['NOT']) + 
	[' Nil.'],
	stop.
} × (a antal).
Uddata skriv: ['but.. Nil is.. '] + ((Intet Intet?) enten: ['certainly NIL!'] eller: ['not NIL??']), stop.