Liste ved: ['sum'] gør: {
	>> total := 0.
	selv hver: { :index :element
		total læg-til: element.
	}. <- total.
}.

>> a := Sand.



a ved: ['tekst'] gør: {
	>> answer := Intet.
	( selv = Sand ) sand: {
		answer := ['Yep'].
	}, ellers: {
		answer := ['Nope'].
	}. <- answer.
}.

a ved: ['tal'] gør: {
	>> answer := Intet.
	( selv = Sand ) sand: {
		answer := 10.
	}, ellers: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b ved: ['tekst'] gør: { <- ['Devil'].
}.

b ved: ['boolsk'] gør: { <- Falsk.
}.


Uddata skriv: a, stop.  
Uddata skriv: (90 + a), stop. 
Uddata skriv: b, stop. 
Uddata skriv: (Sand og: b), stop.

a := Liste ← ['hello'] ; ['world'] ; Sand ; Intet ; 666. 
a := a + ( Liste ← 1 ).
Uddata skriv: a, stop.
Uddata skriv: ((Ordbog ny) sæt: Intet ved: Intet), stop.
Uddata skriv: a sum, stop. 


{
	a ved: ['tekst'] gør: { <- Intet. }.
	a := [''] + a.
} fang: { :error
	Uddata skriv: ['Error noted: '] + error, stop.
}, start.



{
	a ved: ['tal'] gør: { <- Intet. }.
	a := 3 × a.
} fang: { :error
	Uddata skriv: ['Error noted: '] + error, stop.
}, start.


{
	a ved: ['boolsk'] gør: { <- Intet. }.
	a := Sand og: a. 
} fang: { :error
	Uddata skriv: ['Error noted: '] + error, stop.
}, start.





