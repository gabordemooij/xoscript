Liste ved: ['sum'] gør: {
	>> total := 0.
	selv hver: { :indeks :element
		total læg-til: element.
	}. <- total.
}.

>> a := Sand.



a ved: ['tekst'] gør: {
	>> svar := Intet.
	( selv = Sand ) sand: {
		svar := ['Jep'].
	}, ellers: {
		svar := ['Næ'].
	}. <- svar.
}.

a ved: ['tal'] gør: {
	>> svar := Intet.
	( selv = Sand ) sand: {
		svar := 10.
	}, ellers: {
		svar := 20.
	}. <- svar.
}.

>> b := 666.

b ved: ['tekst'] gør: { <- ['Djævel'].
}.

b ved: ['boolsk'] gør: { <- Falsk.
}.


Uddata skriv: a, stop.  
Uddata skriv: (90 + a), stop. 
Uddata skriv: b, stop. 
Uddata skriv: (Sand og: b), stop.

a := Liste ← ['hello'] ; ['world'] ; Sand ; Intet ; 666. 
a := a + ( Liste ← 1 ).
Uddata skriv: a, stop.
Uddata skriv: ((Ordbog ny) sæt: Intet ved: Intet), stop.
Uddata skriv: a sum, stop. 


{
	a ved: ['tekst'] gør: { <- Intet. }.
	a := [''] + a.
} fang: { :fejl
	Uddata skriv: ['Fejl noteret: '] + fejl, stop.
}, start.



{
	a ved: ['tal'] gør: { <- Intet. }.
	a := 3 × a.
} fang: { :fejl
	Uddata skriv: ['Fejl noteret: '] + fejl, stop.
}, start.


{
	a ved: ['boolsk'] gør: { <- Intet. }.
	a := Sand og: a. 
} fang: { :fejl
	Uddata skriv: ['Fejl noteret: '] + fejl, stop.
}, start.





