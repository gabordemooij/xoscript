	a ved: ['tekst'] gør: { <- Falsk. }.
	a := [''] + a.
} fang: { :error
	Uddata skriv: ['Error noted: '] + error, stop.
}, start.



{
	a ved: ['tal'] gør: { <- Sand. }.
	a := 3 × a.
} fang: { :error
	Uddata skriv: ['Error noted: '] + error, stop.
}, start.


