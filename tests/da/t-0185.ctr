

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program hukommelsesstyring: 0.

>> a := -2 absolut.
a := a atan.
a := a cos.
a := a log.
a := a sin.
a := a tan.


Program ryd-op.

usedMemory1 := (Program hukommelse ? 0).


a := -2 absolut.
a := a atan.
a := a cos.
a := a log.
a := a sin.
a := a tan.


Program ryd-op.
usedMemory2 := (Program hukommelse ? 0).


a := -2 absolut.
a := a atan.
a := a cos.
a := a log.
