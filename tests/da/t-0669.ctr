# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Boks 
	adgangskode-hash: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Boks 
	adgangskode-hash: hash bekræft: a1.
	# fail 
>> b := Boks
	adgangskode-hash: hash bekræft: a2.
	# ok!

Uddata skriv: a, stop.
Uddata skriv: b, stop.

