# Hashing af adgangskoder
Server init.

# Brugeren angiver en adgangskode
>> kode := ['pass123'].

# Du gemmer den sådan her
>> hash := Boks 
	adgangskode-hash: kode.

# Derefter logger brugeren ind
# Forsøg 1
>> a1 := ['abcd123'].
# Forsøg 2
>> a2 := ['pass123'].

# Bekræft
>> a := Boks 
	adgangskode-hash: hash bekræft: a1.
	# fejler 
>> b := Boks
	adgangskode-hash: hash bekræft: a2.
	# ok!

Uddata skriv: a, stop.
Uddata skriv: b, stop.

