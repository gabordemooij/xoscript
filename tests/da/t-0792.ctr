Server init.

>> DB := Maria-DB ny vært: ['localhost'],
	brugernavn: ['xo'],
	adgangskode: ['pass123'],
	databasenavn: ['xobase'],
	tilslut.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB forespørgsel: SQL.

# now you don't have to set DB
query2 hent: { :row
	Uddata skriv: row world, stop.
}.
