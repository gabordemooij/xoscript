Server init.

>> DB := Maria-DB ny vært: ['localhost'],
	brugernavn: ['xo'],
	adgangskode: ['pass123'],
	databasenavn: ['xobase'],
	tilslut.
	
>> SQL := ['SELECT "hello" AS "world" '].

# en hurtigere måde, hent forespørgsel fra DB:
