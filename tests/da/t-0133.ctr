


>> Deck := Liste ny.
Deck ved: ['print'] gør: {
        >> len := selv antal - 1.
        { :i
                >> len2 := selv antal - 1.
                Uddata skriv: ['len: '].
                Uddata skriv: len, stop.
                Uddata skriv: ['len2: '].
                Uddata skriv: len2, stop.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
