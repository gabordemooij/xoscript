Server init.
>> f := Format ny: ['%d'].
>> a := Blob ny: 4.
a bytes: ( Liste ny ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob ny: 4.
b bytes: ( Liste ny ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a fra: 0 længde: 3, hver: { :i :byte
	Uddata skriv: ( f anvend-heltal: byte ), stop.
}.
a ^ b.
a fra: 0 længde: 3, hver: { :i :byte
	Uddata skriv: ( f anvend-heltal: byte ), stop.
}.
a ^ b.
a fra: 0 længde: 3, hver: { :i :byte
	Uddata skriv: ( f anvend-heltal: byte ), stop.
}.
a frigiv.
b frigiv.

{ a ^ Objekt. } fang: { :e Uddata skriv: e, stop. }, start.
