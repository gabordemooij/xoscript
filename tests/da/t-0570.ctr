#Linux

 >> t := Øjeblik ny.
 
t zone: ['Europe/Amsterdam'].
t år: 2020, måned: 8, dag: 2, time: 21, minut: 2, sekund: 1.

>> a := t time.
>> ams := t zone.

t zone: ['US/Hawaii'].
>> b := t time.
>> hw := t zone.

Uddata
skriv: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		enten: ['senere'] eller: ['tidligere']
	)
),
stop.
 