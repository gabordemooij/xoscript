# offentlig nøgle (til at sikre API'er osv.)
Server init.

# generér nøgler
>> nøgler := Boks generér-nøgler.

# privat (hemmelig) nøgle
>> sk := nøgler første.

# offentlig nøgle
>> pk := nøgler sidste.

# signér en besked
>> sig := Boks signér: ['abc'] med: sk.

# kontrollér besked (ok)
Uddata skriv: ( 
	Boks
		kontrollér: ['abc'] 
		signatur: sig 
		med: pk 
), stop.

# kontrollér besked (fejler)
Uddata skriv: ( 
	Boks 
		kontrollér: ['abd'] 
		signatur: sig 
		med: pk 
), stop.