# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Boks generér-nøgler.

# private (secret) key
>> sk := keys første.

# public key
>> pk := keys sidste.

# sign a message
>> sig := Boks signér: ['abc'] med: sk.

# check message (ok)
Uddata skriv: ( 
	Boks
		kontrollér: ['abc'] 
		signatur: sig 
		med: pk 
), stop.

# check message (fail)
Uddata skriv: ( 
	Boks 
		kontrollér: ['abd'] 
		signatur: sig 
		med: pk 
), stop.