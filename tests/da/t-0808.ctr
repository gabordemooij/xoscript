# boks-nøgler og signaturer, der afkodes for lange, må ikke få stakken til at løbe over
Server init.

>> nøgler := Boks generér-nøgler.
>> sk := nøgler første.
>> pk := nøgler sidste.
>> sig := Boks signér: ['abc'] med: sk.

# 88 tegn uden padding afkodes til 66 bytes
>> lang := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 tegn uden padding afkodes til 33 bytes
>> kort := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Boks signér: ['abc'] med: lang. } fang: { :e
	Uddata skriv: e, stop.
}, start.

{ Boks kontrollér: ['abc'] signatur: lang med: pk. } fang: { :e
	Uddata skriv: e, stop.
}, start.

{ Boks kontrollér: ['abc'] signatur: sig med: kort. } fang: { :e
	Uddata skriv: e, stop.
}, start.
