>> Dyr := Objekt ny.
>> Fabrik := Objekt ny.

Dyr ved: ['ny'] gør: {
	>> dyr := selv ny.
	dyr sound: ['?']. <- dyr.
}.

Dyr ved: ['sound:'] gør: { :s
	egen lyd := s.
}.

Dyr ved: ['lyd'] gør: { <- egen lyd.
}.

>> Hund := Objekt ny.
>> Kat := Objekt ny.

Hund ved: ['ny'] gør: { <- Dyr ny sound: ['woof!'].
}.

Kat ved: ['ny'] gør: { <- Dyr ny sound: ['meow!'].
}.

Uddata skriv: Hund ny lyd, stop.
Uddata skriv: Kat ny lyd, stop.

Fabrik ved: ['bland:og:'] gør: { :dyr1 :dyr2 <- Dyr ny sound: (
		( dyr1 lyd fra: 0 længde: 2 ) +
		( dyr2 lyd fra: 2 længde: 5 )
	).
}.

Uddata skriv: (Fabrik bland: Hund ny og: Kat ny) lyd, stop.
