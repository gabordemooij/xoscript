>> Animal := Objekt ny.
>> Factory := Objekt ny.

Animal ved: ['ny'] gør: {
	>> animal := selv ny.
	animal sound: ['?']. <- animal.
}.

Animal ved: ['sound:'] gør: { :s
	egen sound := s.
}.

Animal ved: ['sound'] gør: { <- egen sound.
}.

>> Dog := Objekt ny.
>> Cat := Objekt ny.

Dog ved: ['ny'] gør: { <- Animal ny sound: ['woof!'].
}.

Cat ved: ['ny'] gør: { <- Animal ny sound: ['meow!'].
}.

Uddata skriv: Dog ny sound, stop.
Uddata skriv: Cat ny sound, stop.

Factory ved: ['mix:and:'] gør: { :beast1 :beast2 <- Animal ny sound: (
		( beast1 sound fra: 0 længde: 2 ) +
		( beast2 sound fra: 2 længde: 5 )
	).
}.

Uddata skriv: (Factory mix: Dog ny and: Cat ny) sound, stop.
