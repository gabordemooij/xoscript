Uddata skriv: ['Test object'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gør: { :octhelper
	egen octhelper := octhelper. 
}.

a ved: ['item'] gør: { <- egen octhelper.
}.

a item: Oct ny.

>> old-octhelper-address := a item prototype hukommelsesadresse.
a save-as: ['/tmp/a.bin'].
Uddata skriv: ['========== RELOADING SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototype hukommelsesadresse = old-octhelper-address) sand: {
	Uddata skriv: ['Object link re-attached.'], stop.
}.
