Uddata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gør: { :okthjælper
	egen okthjælper := okthjælper. 
}.

a ved: ['vare'] gør: {
	<- egen okthjælper.
}.

a item: Oct ny.

>> gammel-okthjælper-adresse := a vare prototype hukommelsesadresse.
a save-as: ['/tmp/a.bin'].
Uddata skriv: ['========== GENINDLÆSER SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b vare prototype hukommelsesadresse = gammel-okthjælper-adresse) sand: {
	Uddata skriv: ['Objektlink genoprettet.'], stop.
}.
