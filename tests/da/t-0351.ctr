
>> brugtHukommelse1 := 0.
>> brugtHukommelse2 := 0.
>> brugtHukommelse3 := 0.
>> brugtHukommelse4 := 0.

>> code := {
	>> o := (
		Ordbog ny
		aa: (Liste ← 1 ; 2),
		bb: (Liste ← 3 ; 4)
	).
	>> s := o tekst.
	>> o2 := s objekt.
	(s  type = Tekst type) sand: { Uddata skriv: ['OK1'], stop. }.
	(o2 type = Ordbog type) sand: { Uddata skriv: ['OK2'], stop. }.
}.

Program hukommelsesstyring: 0.
['Hukommelse 1 vil være anderledes, fordi sporede blokke tilføjes samlet.'].
Program ryd-op.
brugtHukommelse1 := (Program hukommelse ? 1).
code start.
Program ryd-op.
brugtHukommelse2 := (Program hukommelse ? 1).
code start.
Program ryd-op.
brugtHukommelse3 := (Program hukommelse ? 1).
code start.
Program ryd-op.
brugtHukommelse4 := (Program hukommelse ? 1).

(brugtHukommelse2 = brugtHukommelse3 = brugtHukommelse4) sand: { Uddata skriv: ['OK3'], stop. }.
 
