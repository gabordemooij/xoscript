Server init.

>> db := Maria-DB ny vært: ['localhost'],
	brugernavn: ['xo'],
	adgangskode: ['pass123'],
	databasenavn: ['xobase'],
	tilslut.

>> del := db forespørgsel: ['DELETE FROM book WHERE id > 0'].
{  del udfør. db bekræft. } fang: { :e db rul-tilbage.  }, start.

>> antal := db forespørgsel: ['SELECT COUNT(*) AS num FROM book'].
antal hent: { :row Uddata skriv: row num, stop. }.
