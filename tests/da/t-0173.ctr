

Liste ved: ['sum'] gør: {
	>> total := 0.
	selv hver: { :index :element
		total læg-til: element.
	}. <- total.
}.

Liste ved: ['product'] gør: {
	>> total := 1.
	selv hver: { :index :element
		total gang-med: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program hukommelsesstyring: 0.

{

>> a := Liste ← ['hello'] ; ['world'] ; Sand ; Intet ; 666.
a := a + ( Liste ← 1 ).
Uddata skriv: ( ['sum: '] + ( a sum ) ), stop.
Uddata skriv: ( ['min: '] + ( a minimum ) ), stop.
Uddata skriv: ( ['max: '] + ( a maksimum ) ), stop.
Uddata skriv: ( ['3rd: '] + ( a ? 2 ) ), stop.
Uddata skriv: ( ['prd: '] + ( a product ) ), stop.
a sortér: { :a :b <- (b - a). }.
a hver: { :i :e Uddata skriv: ( i - 0 ), stop. }.

} start.

Program ryd-op.
usedMemory1 := (Program hukommelse ? 0).


{

>> a := Liste ← ['hello'] ; ['world'] ; Sand ; Intet ; 666.
a := a + ( Liste ← 1 ).
Uddata skriv: ( ['sum: '] + ( a sum ) ), stop.
Uddata skriv: ( ['min: '] + ( a minimum ) ), stop.
Uddata skriv: ( ['max: '] + ( a maksimum ) ), stop.
Uddata skriv: ( ['3rd: '] + ( a ? 2 ) ), stop.
Uddata skriv: ( ['prd: '] + ( a product ) ), stop.
a sortér: { :a :b <- (b - a). }.
a hver: { :i :e Uddata skriv: ( i - 0 ), stop. }.

} start.



Program ryd-op.
usedMemory2 := (Program hukommelse ? 0).


{

>> a := Liste ← ['hello'] ; ['world'] ; Sand ; Intet ; 666.
a := a + ( Liste ← 1 ).
Uddata skriv: ( ['sum: '] + ( a sum ) ), stop.
Uddata skriv: ( ['min: '] + ( a minimum ) ), stop.
Uddata skriv: ( ['max: '] + ( a maksimum ) ), stop.
Uddata skriv: ( ['3rd: '] + ( a ? 2 ) ), stop.
Uddata skriv: ( ['prd: '] + ( a product ) ), stop.
a sortér: { :a :b <- (b - a). }.
a hver: { :i :e Uddata skriv: ( i - 0 ), stop. }.

} start.



Program ryd-op.
usedMemory3 := (Program hukommelse ? 0).

( usedMemory1 = usedMemory2 og: usedMemory1 = usedMemory3, og: usedMemory2 = usedMemory3 ) sand: {
	Uddata skriv: ['No memory leaks here'].
}, falsk: {
	Uddata skriv: ['Leaking memory...'].
}.
