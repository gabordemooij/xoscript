

Liste ved: ['sum'] gør: {
	>> total := 0.
	selv hver: { :indeks :element
		total læg-til: element.
	}. <- total.
}.

Liste ved: ['produkt'] gør: {
	>> total := 1.
	selv hver: { :indeks :element
		total gang-med: element.
	}. <- total.
}.

>> brugtHukommelse1 := 0.
>> brugtHukommelse2 := 0.
>> brugtHukommelse3 := 0.
>> brugtHukommelse4 := 0.

Program hukommelsesstyring: 0.

{

>> a := Liste ← ['hello'] ; ['world'] ; Sand ; Intet ; 666.
a := a + ( Liste ← 1 ).
Uddata skriv: ( ['sum: '] + ( a sum ) ), stop.
Uddata skriv: ( ['min: '] + ( a minimum ) ), stop.
Uddata skriv: ( ['maks: '] + ( a maksimum ) ), stop.
Uddata skriv: ( ['3.: '] + ( a ? 2 ) ), stop.
Uddata skriv: ( ['prd: '] + ( a produkt ) ), stop.
a sortér: { :a :b <- (b - a). }.
a hver: { :i :e Uddata skriv: ( i - 0 ), stop. }.

} start.

Program ryd-op.
brugtHukommelse1 := (Program hukommelse ? 0).


{

>> a := Liste ← ['hello'] ; ['world'] ; Sand ; Intet ; 666.
a := a + ( Liste ← 1 ).
Uddata skriv: ( ['sum: '] + ( a sum ) ), stop.
Uddata skriv: ( ['min: '] + ( a minimum ) ), stop.
Uddata skriv: ( ['maks: '] + ( a maksimum ) ), stop.
Uddata skriv: ( ['3.: '] + ( a ? 2 ) ), stop.
Uddata skriv: ( ['prd: '] + ( a produkt ) ), stop.
a sortér: { :a :b <- (b - a). }.
a hver: { :i :e Uddata skriv: ( i - 0 ), stop. }.

} start.



Program ryd-op.
brugtHukommelse2 := (Program hukommelse ? 0).


{

>> a := Liste ← ['hello'] ; ['world'] ; Sand ; Intet ; 666.
a := a + ( Liste ← 1 ).
Uddata skriv: ( ['sum: '] + ( a sum ) ), stop.
Uddata skriv: ( ['min: '] + ( a minimum ) ), stop.
Uddata skriv: ( ['maks: '] + ( a maksimum ) ), stop.
Uddata skriv: ( ['3.: '] + ( a ? 2 ) ), stop.
Uddata skriv: ( ['prd: '] + ( a produkt ) ), stop.
a sortér: { :a :b <- (b - a). }.
a hver: { :i :e Uddata skriv: ( i - 0 ), stop. }.

} start.



Program ryd-op.
brugtHukommelse3 := (Program hukommelse ? 0).

( brugtHukommelse1 = brugtHukommelse2 og: brugtHukommelse1 = brugtHukommelse3, og: brugtHukommelse2 = brugtHukommelse3 ) sand: {
	Uddata skriv: ['Ingen hukommelseslæk her'].
}, falsk: {
	Uddata skriv: ['Lækker hukommelse...'].
}.
