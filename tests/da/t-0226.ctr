# Test ASCII-varianter

# Tal

Uddata skriv: (2 !=: 3), stop.
Uddata skriv: (2 <=: 2), stop.
Uddata skriv: (2 >=: 2), stop.

# Tekster

Uddata skriv: (['b'] >=: ['a']), stop.
Uddata skriv: (['b'] !=: ['a']), stop.
Uddata skriv: (['b'] <=: ['c']), stop.

# Boolske værdier

Uddata skriv: (Sand !=: Falsk), stop.

# Objekter

Uddata skriv: (Objekt ny !=: Objekt ny), stop.

# ASCII-listesymbol <-:

Uddata skriv: (Liste <<: 1, ; 2 ; 3) antal = 3, stop.

