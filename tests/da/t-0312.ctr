>> Slurp := Objekt ny.
Slurp ved: ['ny'] gør: {
	egen str := [''].
}.
Slurp lær: ['nieuw'] betyder: ['ny'].
Slurp ved: ['svar:'] gør: { :blah
		(egen str ≠ ['']) sand: {
			egen str tilføj: [' '].
		}.
		egen str tilføj: blah.
}.
Slurp ved: ['svar:og:'] gør: { :blah :blahah
		(egen str ≠ ['']) sand: {
			egen str tilføj: [' '].
		}.
		(blah længde > 1) sand: {
			egen str tilføj: (blah fra: 0 længde: (blah længde - 1)).
		}, ellers: {
			egen str tilføj: blah.
		}.
		egen str tilføj: [' '].
		egen str tilføj: blahah.
}.
Slurp ved: ['skaf'] gør: {
	>> buffer := egen str.
	egen str := ['']. <- buffer.
}.


>> søgeparametre := Slurp ny
	select: ['*'],
	from
		brugere 
	where 
		user_id=: 1.

Uddata skriv: søgeparametre skaf, stop.
