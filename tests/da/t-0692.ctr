Server init.

Uddata skriv: (
	Mønster ny: ['^\\w+$'],
	match: ['test@example.com'] 
), stop. # 0 match, fejler på @ og .

Uddata skriv: (
	Mønster ny: ['^[^@]+@[^\.]+\.\\w+$'],
	match: ['test@example.com'] 
), stop. # 1 match

Uddata skriv: (
	Mønster ny: ['[^@]+@[^\.]+\.\\w+'],
	match: ['test@example.com'] 
), stop. # 1 match

Uddata skriv: (
	Mønster ny: ['([^@]+)@([^\.]+)\.\\w+'],
	match: ['test@example.com'] 
), stop. # 1 match, grupper betyder ikke noget

Uddata skriv: (
	Mønster ny: ['[a-z]'],
	match: ['test@example.com'] 
), stop. # 14 match

Uddata skriv: (
	Mønster ny: ['.*'],
	match: ['test@example.com'] 
), stop. # 1 match (alle)

Uddata skriv: (
	Mønster ny: ['(.*)'],
	match: ['test@example.com'] 
), stop. # 1 match (alle)

Uddata skriv: (
	Mønster ny: ['\\s*[^@]+@[^\.]+\.\\w+'],
	match: ['test@example.com'] 
), stop. # 1 match, mellemrum foran er valgfrit, ignoreres