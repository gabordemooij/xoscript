Server init.
Uddata skriv: ['Database-datotidstest'], stop.

>> db := Maria-DB ny vært: ['localhost'],
	brugernavn: ['xo'], 
	adgangskode: ['pass123'],
	databasenavn: ['xobase'],
	tilslut.

>> søgeparametre :=
db forespørgsel: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
hent: { :række
	Uddata skriv: række datetimetest, stop.
}.
