

>> Matryoshka := Objekt ny.
Matryoshka ved: ['double:'] gør: { :hemmelighed
	egen hemmelighed := hemmelighed × 2.
}.
Matryoshka ved: ['ny:'] gør: { :hemmelighed
	>> svar := Intet.
	>> t := (hemmelighed > 255).
	Uddata skriv: (hemmelighed + [' | '] + t), stop.
	t sand: {
		svar := hemmelighed.
	}, ellers: {
		svar := Matryoshka rekursiv ny: (selv double: hemmelighed).
	}. <- svar.
}.

>> x := Matryoshka ny: 2.
