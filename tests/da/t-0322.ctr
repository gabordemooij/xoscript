

>> Matryoshka := Objekt ny.
Matryoshka ved: ['double:'] gør: { :secret
	egen secret := secret × 2.
}.
Matryoshka ved: ['ny:'] gør: { :secret
	>> answer := Intet.
	>> t := (secret > 255).
	Uddata skriv: (secret + [' | '] + t), stop.
	t sand: {
		answer := secret.
	}, ellers: {
		answer := Matryoshka rekursiv ny: (selv double: secret).
	}. <- answer.
}.

>> x := Matryoshka ny: 2.
