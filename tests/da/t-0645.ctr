Server init.
Uddata skriv: ['Database-datotest'], stop.

>> db := Maria-DB ny vært: ['localhost'],
	brugernavn: ['xo'], 
	adgangskode: ['pass123'],
	databasenavn: ['xobase'],
	tilslut.

>> søgeparametre :=
db forespørgsel: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
hent: { :række
	Uddata skriv: række datetest, stop.
}.
