Uddata skriv: ['Testobjekt'], stop.
>> hilser := Objekt ny.
hilser ved: ['name:'] gør: { :navn
	egen xnavn := navn. 
}.
hilser ved: ['hils'] gør: {
	Uddata skriv: ['Hej '] + egen xnavn, stop.
}.
hilser name: ['Sherlock'].
hilser save-as: ['/tmp/a.bin'].
hilser save-as: ['/tmp/b.bin'].
Uddata skriv: ['========== GENINDLÆSER SNAP:'], stop.
>> b := Objekt load-from: ['/tmp/a.bin'].
>> c := Objekt load-from: ['/tmp/b.bin'].
b hils.
b name: ['Watson'], hils.
c name: ['Moriarty'], hils.
