Uddata skriv: ['Test object'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gør: { :file
	egen file := file. 
}.

a ved: ['item'] gør: { <- egen file.
}.

>> f := Fil ny: ['/tmp/aaa.txt'].
a item: f.
Uddata skriv: a item, stop.
a save-as: ['/tmp/a.bin'].
Uddata skriv: ['========== RELOADING SNAP:'], stop.
>> b := Objekt load-from: ['/tmp/a.bin'].
Uddata skriv: b item, stop.
