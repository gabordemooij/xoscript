# databasefejlmeddelelser må ikke behandles som formatstrenge
Server init.

>> db := Maria-DB ny vært: ['localhost'],
	brugernavn: ['xo'],
	adgangskode: ['pass123'],
	databasenavn: ['xobase'],
	tilslut.

>> søgeparametre := db forespørgsel: ['SELECT %% FROM'].
{ søgeparametre udfør. } fang: { :e
	Uddata skriv: ( e indeholder: ['%%'] ), stop.
}, start.
