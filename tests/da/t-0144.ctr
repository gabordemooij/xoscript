



>> CoffeeGrounds := Objekt ny.
CoffeeGrounds ved: ['extract'] gør: { <- ['coffee']. }.

>> CoffeeMachine := Objekt ny.
CoffeeMachine ved: ['init'] gør: {
	egen coffeegrounds := CoffeeGrounds ny.
}.
CoffeeMachine ved: ['ny'] gør: { <- CoffeeMachine `new init.
}.

CoffeeMachine ved: ['makeTea'] gør: { <- (egen tealeaves extract). }.
CoffeeMachine ved: ['makeCoffee'] gør: { <- (egen coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine ny.

Uddata skriv:
	coffeeDream 
	makeCoffee.

Uddata skriv:
	coffeeDream 
	makeTea.
