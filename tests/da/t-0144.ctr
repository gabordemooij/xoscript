



>> Kaffegrums := Objekt ny.
Kaffegrums ved: ['udtræk'] gør: { <- ['coffee']. }.

>> Kaffemaskine := Objekt ny.
Kaffemaskine ved: ['init'] gør: {
	egen kaffegrums := Kaffegrums ny.
}.
Kaffemaskine ved: ['ny'] gør: { <- Kaffemaskine `new init.
}.

Kaffemaskine ved: ['lavTe'] gør: { <- (egen teblade udtræk). }.
Kaffemaskine ved: ['lavKaffe'] gør: { <- (egen kaffegrums udtræk). }.

>> kaffedrøm := Kaffemaskine ny.

Uddata skriv:
	kaffedrøm 
	lavKaffe.

Uddata skriv:
	kaffedrøm 
	lavTe.
