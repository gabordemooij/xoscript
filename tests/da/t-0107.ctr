
Uddata skriv: ['Afbryd for-løkke, 0-4.'], stop.
{ :i
	Uddata skriv: ['iteration #'] + i, stop.
	(i = 4) afbryd.
} × 10.

>> x := 0.
>> xErMindreEnd10 := { <- ( x < 10 ). }.

Uddata skriv: ['Afbryd while-true-løkke, 0-4.'], stop.
{
	Uddata skriv: ['iteration #'] + x, stop.
	x læg-til: 1.
	((x < 5) ikke) afbryd.
} mens: xErMindreEnd10.

Uddata skriv: ['Afbryd while-false-løkke, 5,4.'], stop.
{
	Uddata skriv: ['iteration #'] + x, stop.
	x træk-fra: 1.
	(x = 3) afbryd.
} mens: { <- (x > 0). }.

Uddata skriv: ['Afbryd times-løkke, 1-4.'], stop.
{ :i
	Uddata skriv: ['iteration #'] + i, stop.
	(i = 4) afbryd.
} × 5.

Uddata skriv: ['Afbryd blok, udskriv ikke linjen.'], stop.
{ Sand afbryd. Uddata skriv: ['skriv ikke dette!'], stop. } start.

Uddata skriv: ['Afbryd blok, udløs ikke catch...'], stop.
{ Sand afbryd. Uddata skriv: ['skriv ikke dette!'], stop. } fang: { Uddata skriv: ['Fang ikke dette!']. }, start.

Uddata skriv: ['Test Liste each-løkke: 0,1'], stop.
(Liste ← 1 ; 2 ; 3) afbild: { :i
	Uddata skriv: ['iteration #'] + i, stop.
	(i = 1) afbryd.
}.

Uddata skriv: ['Test Ordbog each-løkke: kun c'], stop.
>> m := Ordbog ny.
m sæt: ['first'] ved: ['a'], sæt: ['second'] ved: ['b'], sæt: ['tredje'] ved: ['c'].
m hver: { :k :v
	Uddata skriv: ['iteration'] + v + k, stop.
	Sand afbryd.
}.

