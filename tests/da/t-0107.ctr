
Uddata skriv: ['Break for-loop, 0-4.'], stop.
{ :i
	Uddata skriv: ['iteration #'] + i, stop.
	(i = 4) afbryd.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Uddata skriv: ['Break while-true loop, 0-4.'], stop.
{
	Uddata skriv: ['iteration #'] + x, stop.
	x læg-til: 1.
	((x < 5) ikke) afbryd.
} mens: xIsLessThan10.

Uddata skriv: ['Break while-false loop, 5,4.'], stop.
{
	Uddata skriv: ['iteration #'] + x, stop.
	x træk-fra: 1.
	(x = 3) afbryd.
} mens: { <- (x > 0). }.

Uddata skriv: ['Break times loop, 1-4.'], stop.
{ :i
	Uddata skriv: ['iteration #'] + i, stop.
	(i = 4) afbryd.
} × 5.

Uddata skriv: ['Break block, dont print line.'], stop.
{ Sand afbryd. Uddata skriv: ['dont write this!'], stop. } start.

Uddata skriv: ['Break block, dont fire catch...'], stop.
{ Sand afbryd. Uddata skriv: ['dont write this!'], stop. } fang: { Uddata skriv: ['Dont catch this!']. }, start.

Uddata skriv: ['Test Array each-loop: 0,1'], stop.
(Liste ← 1 ; 2 ; 3) afbild: { :i
	Uddata skriv: ['iteration #'] + i, stop.
	(i = 1) afbryd.
}.

Uddata skriv: ['Test Map each-loop: c only'], stop.
>> m := Ordbog ny.
m sæt: ['first'] ved: ['a'], sæt: ['second'] ved: ['b'], sæt: ['third'] ved: ['c'].
m hver: { :k :v
	Uddata skriv: ['iteration'] + v + k, stop.
	Sand afbryd.
}.

