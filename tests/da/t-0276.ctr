>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objekt ny.
⚄ ved: ['drawFrom:length:'] gør: { :pool :antal
	
	>> result := [''].
	
	{
		>> index := Tal random % (pool længde).
		result tilføj: ( pool tegn: (index + 1) ).
		
	} × antal. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? længde.
Uddata skriv: (['x↵'] x random længde).
Uddata skriv: (['y↵'] y ?? længde).

