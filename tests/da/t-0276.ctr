>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objekt ny.
⚄ ved: ['trækFra:længde:'] gør: { :pulje :antal
	
	>> resultat := [''].
	
	{
		>> indeks := Tal tilfældig % (pulje længde).
		resultat tilføj: ( pulje tegn: (indeks + 1) ).
		
	} × antal. <- resultat.
}.

>> tilfældig := ⚄ trækFra: ?? længde: ?? længde.
Uddata skriv: (['x↵'] x tilfældig længde).
Uddata skriv: (['y↵'] y ?? længde).

