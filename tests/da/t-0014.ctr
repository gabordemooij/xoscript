>> Greeter := Objekt ny.
Greeter ved: ['make'] gør: {
	>> gr := Objekt ny.
	gr ved: ['setName:'] gør: { :aname
		egen navn := aname.
	}.
	gr ved: ['greet'] gør: {
		Uddata skriv: egen navn.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a ny.
c setName: ['THREE'].
c greet.
>> d := a ny.
d setName: ['FOUR'].
d greet.
c greet.
