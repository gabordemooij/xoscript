>> Hilser := Objekt ny.
Hilser ved: ['lav'] gør: {
	>> gr := Objekt ny.
	gr ved: ['setName:'] gør: { :etNavn
		egen navn := etNavn.
	}.
	gr ved: ['hils'] gør: {
		Uddata skriv: egen navn.
	}. <- gr.
}.
>> a := Hilser lav.
>> b := Hilser lav.
a setName: ['EN'].
b setName: ['TO'].
a hils.
b hils.
>> c := a ny.
c setName: ['TRE'].
c hils.
>> d := a ny.
d setName: ['FIRE'].
d hils.
c hils.
