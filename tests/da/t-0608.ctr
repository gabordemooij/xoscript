
>> Size := Objekt ny.
Size ved: ['is:'] gør: { :tal
	tal ved: ['+'] gør: { :tal
		>> unit := tal betegnelse.
		>> factor := 1.
		
		unit
		tilfælde: ['inch'] gør: { factor := 0.0833. }. <- selv + (tal * factor).
	}. <- tal.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Uddata skriv: plank + edge, stop.
