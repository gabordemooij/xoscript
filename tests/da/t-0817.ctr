# a value ending in the first part of an opening quote must survive serialization
>> værdier := Liste ny
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

værdier hver: { :i :value
	>> d := Ordbog ny.
	d sæt: value ved: ['k'].
	d sæt: ['second'] ved: ['j'].
	>> r := d code objekt.
	Uddata skriv: r antal, stop.
	Uddata skriv: ( (r ved: ['k']) = value ), stop.
}.
