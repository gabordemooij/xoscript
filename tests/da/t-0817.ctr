# en værdi, der ender på første del af et åbnende anførselstegn, skal overleve serialisering
>> værdier := Liste ny
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

værdier hver: { :i :value
	>> d := Ordbog ny.
	d sæt: value ved: ['k'].
	d sæt: ['second'] ved: ['j'].
	>> r := d code objekt.
	Uddata skriv: r antal, stop.
	Uddata skriv: ( (r ved: ['k']) = value ), stop.
}.
