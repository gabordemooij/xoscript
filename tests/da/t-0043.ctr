>> gentager := Objekt ny.
gentager ved: ['svar:'] gør: { :hvad
	Uddata skriv: hvad + [' '].
}.
gentager ved: ['svar:og:'] gør: { :hvad :say
	Uddata skriv: hvad, skriv: say + [' '].
}.
gentager ved: ['svar:og:og:'] gør: { :hvad :say :mere
	Uddata skriv: hvad, skriv: say, skriv: mere.
}.
gentager gentag.
gentager everything: ['Jeg siger.'].
gentager and: ['I '] everything: ['gør.'].
