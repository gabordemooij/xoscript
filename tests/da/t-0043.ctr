>> repeater := Objekt ny.
repeater ved: ['svar:'] gør: { :what
	Uddata skriv: what + [' '].
}.
repeater ved: ['svar:og:'] gør: { :what :say
	Uddata skriv: what, skriv: say + [' '].
}.
repeater ved: ['svar:og:og:'] gør: { :what :say :more
	Uddata skriv: what, skriv: say, skriv: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
