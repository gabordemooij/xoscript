
>> city := Liste ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Liste ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature efter: city.
>> cities := weather poster sortér: { :a :b <- (a sammenlign: b). }.
>> temperatures := weather værdier sortér: { :a :b <- (a sammenlign: b) negativ?. }.

Uddata skriv: (cities saml: [',']), stop.
Uddata skriv: (temperatures saml: [',']), stop.
