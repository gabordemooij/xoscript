
>> by := Liste ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperatur := Liste ← ['15'] ; ['16'] ; ['15'].
>> vejr := temperatur efter: by.
>> byer := vejr poster sortér: { :a :b <- (a sammenlign: b). }.
>> temperaturer := vejr værdier sortér: { :a :b <- (a sammenlign: b) negativ?. }.

Uddata skriv: (byer saml: [',']), stop.
Uddata skriv: (temperaturer saml: [',']), stop.
