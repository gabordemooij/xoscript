Uddata skriv: ['Test object'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gør: { :fmt
	egen fmt := fmt. 
}.

a ved: ['item'] gør: { <- egen fmt.
}.

a item: ( Format ny: ['|%s|'] ).

Uddata skriv: a item, stop.

>> old-fmt-address := a item prototype hukommelsesadresse.
a save-as: ['/tmp/a.bin'].
Uddata skriv: ['========== RELOADING SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototype hukommelsesadresse = old-fmt-address) sand: {
	Uddata skriv: ['Object link re-attached.'], stop.
}.

Uddata skriv: ( b item anvend: ['hello'] ), stop.
