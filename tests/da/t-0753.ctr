Uddata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gør: { :fmt
	egen fmt := fmt. 
}.

a ved: ['vare'] gør: {
	<- egen fmt.
}.

a item: ( Format ny: ['|%s|'] ).

Uddata skriv: a vare, stop.

>> gammel-fmt-adresse := a vare prototype hukommelsesadresse.
a save-as: ['/tmp/a.bin'].
Uddata skriv: ['========== GENINDLÆSER SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b vare prototype hukommelsesadresse = gammel-fmt-adresse) sand: {
	Uddata skriv: ['Objektlink genoprettet.'], stop.
}.

Uddata skriv: ( b vare anvend: ['hello'] ), stop.
