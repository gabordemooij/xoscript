
>> countries := Liste ny
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Liste ny
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods efter: countries, hver: { :key :value
	counter læg-til: 1.
}.

Uddata skriv: (['we serve counter dishes'] counter: counter), stop.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] tegn sortér: { :v
	counter læg-til: 0.
}.

Uddata skriv: (['we sort counter dishes'] counter: counter), stop.


>> counter := 0.
{
	{
		counter læg-til: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Uddata skriv: (['we calculate counter numbers.'] counter: counter), stop.

