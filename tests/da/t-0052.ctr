>> items := Ordbog ny.
items sæt: ['green'] ved: ['color-1'].
items sæt: ['orange'] ved: ['color-2'].
items sæt: ['red'] ved: ['color-3'].
>> i := 0.
>> s := [''].
items hver: { :key :color
	Uddata skriv: ['color #'] + i + [' is: '] + color + [' '].
	i læg-til: 1.
}.
Uddata skriv: i + [' colors!'].
