
>> ordliste := (
	Ordbog ny
		sæt: ['b'] ved: ['a'],
		sæt: ['a'] ved: ['b'],
		sæt: ['z'] ved: ['x'],
		sæt: ['hello'] ved: ['hallo'],
		sæt: ['menneske'] ved: ['menneske']
).

>> sammenligninger := Liste ny.
ordliste hver: { :a :b
	sammenligninger ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a sammenlign: b)
	).
}.

sammenligninger sortér: { :a :b <- ( a sammenlign: b ). }.
Uddata skriv: ( sammenligninger saml: ['↵'] ), stop.
sammenligninger saml: ['↵'].
