
>> dictionary := (
	Ordbog ny
		sæt: ['b'] ved: ['a'],
		sæt: ['a'] ved: ['b'],
		sæt: ['z'] ved: ['x'],
		sæt: ['hello'] ved: ['hallo'],
		sæt: ['human'] ved: ['human']
).

>> comparisons := Liste ny.
dictionary hver: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a sammenlign: b)
	).
}.

comparisons sortér: { :a :b <- ( a sammenlign: b ). }.
Uddata skriv: ( comparisons saml: ['↵'] ), stop.
comparisons saml: ['↵'].
