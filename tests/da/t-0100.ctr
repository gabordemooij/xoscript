Tekst ved: ['html'] gør: { <- (
		selv
		erstat: ['&'] med: ['&amp;'],
		erstat: ['<'] med: ['&lt;'],
		erstat: ['>'] med: ['&gt;'],
		erstat: ['"'] med: ['&quot;']
	).
}.

>> list := Liste ny.

['Verbatim Syntax'] tegn hver: { :tal :letter
	list ; ((['<li>#Number:Letter</li>']) Number: (tal), Letter: letter).
}.

Uddata list.





>> template := ['
<html>
<body>
<p>Hello this is a test!</p>
<p>The string \‘Verbatim Syntax\’ has: 15 code points...</p>
<ul>
[list]
</ul>
</body> 
</html>
'] [list]: (list saml: ['↵']).

