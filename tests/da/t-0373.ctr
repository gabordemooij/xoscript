# overensstemmelsestest

# brug internationale tal

Uddata skriv: ['1000 -> '].
Uddata skriv: 1000, stop. #1000

Uddata skriv: ['1.5 -> '].
Uddata skriv: 1.5, stop.  #1.5

Uddata skriv: ['1001.5 -> '].
Uddata skriv: 1.5 + 1000, stop. #1001.5

# brug 0-indekserede arrays
>> x := Liste ny ; 1 ; 2 ; 3.
>> y := Liste ny ; ['a'] ; ['b'] ; ['c'].

Uddata skriv: ['1 -> '].
Uddata skriv: x ? 0, stop. #1

Uddata skriv: ['1 -> '].
Uddata skriv: (x ved: 0), stop. #1

Uddata skriv: ['1 -> '].
Uddata skriv: x første, stop. #1

Uddata skriv: ['3 -> '].
Uddata skriv: x sidste, stop. #3

Uddata skriv: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Uddata skriv: (x efter: y), stop.

Uddata skriv: ['1 -> '].
Uddata skriv: (x fra: 0 længde: 1) første, stop. #1

Uddata skriv: ['0 -> '].
Uddata skriv: (x find: 1), stop. #0

x sæt: 9 ved: 0.

Uddata skriv: ['9 -> '].
Uddata skriv: (x ved: 0), stop. #9

x indsæt-først: 8.
Uddata skriv: ['8 -> '].
Uddata skriv: (x ved: 0), stop. #9


x tilføj: 10.
Uddata skriv: ['10 -> '].
Uddata skriv: (x ved: 4), stop. #10








