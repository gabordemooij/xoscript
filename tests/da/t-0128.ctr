
Liste ved: ['sum'] gør: {
	>> total := 0.
	selv hver: { :indeks :element
		total læg-til: element.
	}. <- total.
}.

>> a := Liste ← 9 ; 8 ; 7.
Uddata skriv: (a sum), stop. 
>> a := Liste ← 1 ; 9.
Uddata skriv: (a sum), stop. 
>> a := Liste ← ['o'] ; 2.
Uddata skriv: (a sum), stop. 
Uddata skriv: (Liste ny sum), stop. 
