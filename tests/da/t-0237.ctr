
Tekst ved: ['evaluer'] gør: {
	>> code := Fil ny: ['/tmp/eval.ctr'].
	code skriv: (selv tekst + ['.']).
	Program brug: ['/tmp/eval.ctr'].
}.

>> map :=
	(Ordbog ny)
	sæt: ['Hej Der'] ved: ['two'],
	sæt: (Liste ← ['hello'] ; ['world'] ; (Liste ← 1 ; 2; 9) ; Falsk) ved: ['en'],
	sæt: ( (Ordbog ny) sæt: ['vrrden'] ved: ['stavet forkert'] ) ved: ['three'],
	sæt: (Liste ← ((Ordbog ny) sæt: ['skat'] ved: ['skjult']) ; 2) ved: ['fire']. 
>> str := map tekst.
>> map2 := Intet.
(['map2 := '] + str ) evaluer.
Uddata skriv: map2 ? ['en'] ? 0.
Uddata skriv: map2 ? ['en'] ? 1.
Uddata skriv: map2 ? ['fire'] ? 0 ? ['skjult'].
Uddata skriv: map2 ? ['en'] ? 2 ? 2.
