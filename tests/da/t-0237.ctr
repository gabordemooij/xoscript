
Tekst ved: ['evaluate'] gør: {
	>> code := Fil ny: ['/tmp/eval.ctr'].
	code skriv: (selv tekst + ['.']).
	Program brug: ['/tmp/eval.ctr'].
}.

>> map :=
	(Ordbog ny)
	sæt: ['Hi There'] ved: ['two'],
	sæt: (Liste ← ['hello'] ; ['world'] ; (Liste ← 1 ; 2; 9) ; Falsk) ved: ['one'],
	sæt: ( (Ordbog ny) sæt: ['wrrld'] ved: ['misspelled'] ) ved: ['three'],
	sæt: (Liste ← ((Ordbog ny) sæt: ['treasure'] ved: ['hidden']) ; 2) ved: ['four']. 
>> str := map tekst.
>> map2 := Intet.
(['map2 := '] + str ) evaluate.
Uddata skriv: map2 ? ['one'] ? 0.
Uddata skriv: map2 ? ['one'] ? 1.
Uddata skriv: map2 ? ['four'] ? 0 ? ['hidden'].
Uddata skriv: map2 ? ['one'] ? 2 ? 2.
