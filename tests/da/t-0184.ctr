

>> brugtHukommelse1 := 0.
>> brugtHukommelse2 := 0.
>> brugtHukommelse3 := 0.
>> brugtHukommelse4 := 0.

Program hukommelsesstyring: 0.

Tal ved: ['addNum:'] gør: { :x
	selv læg-til: x.
}.

Tal ved: ['subtractNum:'] gør: { :x
	selv træk-fra: x.
}.

Tal ved: ['multiplyBy:'] gør: { :x
	selv gang-med: x.
}.

Tal ved: ['divideBy:'] gør: { :x
	selv del-med: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 opløftet: 8).  
a := a + (2 opløftet: -1). 
a := a + (49 kvadratrod).   
a addNum: ((Liste ← 0 ; 1) maksimum).          
a addNum: ((Liste ← 2 ; 3) minimum).
Uddata skriv: a.

Program ryd-op.

brugtHukommelse1 := (Program hukommelse ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 opløftet: 8).  
a := a + (2 opløftet: -1). 
a := a + (49 kvadratrod).   
a addNum: ((Liste ← 0 ; 1) maksimum).          
a addNum: ((Liste ← 2 ; 3) minimum).
Uddata skriv: a.

Program ryd-op.
brugtHukommelse2 := (Program hukommelse ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 opløftet: 8).  
a := a + (2 opløftet: -1). 
a := a + (49 kvadratrod).   
a addNum: ((Liste ← 0 ; 1) maksimum).          
a addNum: ((Liste ← 2 ; 3) minimum).
Uddata skriv: a.

Program ryd-op.
brugtHukommelse3 := (Program hukommelse ? 0).



( brugtHukommelse1 = brugtHukommelse2 og: brugtHukommelse1 = brugtHukommelse3, og: brugtHukommelse2 = brugtHukommelse3 ) sand: {
	Uddata skriv: ['Ingen hukommelseslæk her'].
}, falsk: {
	Uddata skriv: ['Lækker hukommelse...'].
}.
