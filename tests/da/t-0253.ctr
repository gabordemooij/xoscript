#Linux
>> OS := Program indstilling: ['OS'].

>> clock := Øjeblik ny.
	
(OS = ['Haiku']) sand: {
	clock zone: ['CET'],
	år: 2017, måned: 7, dag: 13,
	time: 18, minut: 0, sekund: 0.
}, ellers: {
	clock zone: ['Europe/Amsterdam'],
	år: 2017, måned: 7, dag: 13,
	time: 18, minut: 0, sekund: 0.
}.

clock ved: ['tell'] gør: {
	Uddata skriv: selv, stop.
}.


clock læg-til: 2    time, tell.
clock læg-til: 1    time, tell.
clock læg-til: 19 minut, tell.
clock læg-til: 1  minut, tell.
clock læg-til: 1  minut, tell.
clock læg-til: 19 sekund, tell.
clock læg-til: 1  sekund, tell.
clock læg-til: 1  sekund, tell.
clock læg-til: 2    år, tell.
clock læg-til: 1    år, tell.

(OS = ['Haiku']) sand: {
clock læg-til: 5   måned.
clock zone: ['CEST'], tell.
}, ellers: {
	clock læg-til: 5   måned, tell.
}.

clock læg-til: 1   måned, tell.
clock læg-til: 19    dag, tell.
clock læg-til: 1    time, tell.
clock læg-til: 120  yard, tell.
