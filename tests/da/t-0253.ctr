#Linux
>> OS := Program indstilling: ['OS'].

>> ur := Øjeblik ny.
	
(OS = ['Haiku']) sand: {
	ur zone: ['CET'],
	år: 2017, måned: 7, dag: 13,
	time: 18, minut: 0, sekund: 0.
}, ellers: {
	ur zone: ['Europe/Amsterdam'],
	år: 2017, måned: 7, dag: 13,
	time: 18, minut: 0, sekund: 0.
}.

ur ved: ['fortæl'] gør: {
	Uddata skriv: selv, stop.
}.


