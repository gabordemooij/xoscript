# test betegnelser

>> $ := Objekt ny.

$ ved: ['svar:'] gør: { :x
	
	>> operation := x tegn: 0.
	>> valutategn := x tegn: 1.
	>> penge := x forskydning: 2.
	
	>> beløb := 0.

	( operation = ['+'] ) sand: {
		( valutategn = ['£'] ) sand: { beløb := 1.28 × penge. }.
	}. <- beløb.
}.



>> x := $ +£20.

Uddata skriv: x, stop.


>> Frugt := Objekt ny.

Frugt ved: ['ny'] gør: {
	>> f := selv ny.
	f apples: 0.
	f oranges: 0. <- f.
}.

Frugt ved: ['apples:'] gør: { :a egen æbler := a. }.
Frugt ved: ['oranges:'] gør: { :p egen appelsiner := p. }.
Frugt ved: ['æbler'] gør: { <- egen æbler. }.
Frugt ved: ['appelsiner'] gør: { <- egen appelsiner. }.

Frugt ved: ['+'] gør: { :f
	
	>> n := Frugt ny.
	f læg-til: 1.
	
	n apples: (f æbler + egen æbler).
	n oranges:  (f appelsiner  + egen appelsiner). <- n.
}.

Frugt ved: ['tekst'] gør: { <- ( egen æbler tekst + [' æbler og '] + egen appelsiner + [' appelsiner'] ).
}.

Tal ved: ['æbler'] gør: { <- ((Frugt ny) apples: selv).
}.

Tal ved: ['apple'] gør: { <- ((Frugt ny) apples: selv).
}.

Tal ved: ['appelsiner'] gør: { <- ((Frugt ny) oranges: selv).
}.




Uddata skriv: (1 apple + 3 appelsiner + 4 æbler), stop.


Tekst ved: ['dobbelt'] gør: { <- ((selv tekst) + (selv tekst)).
}.



Uddata skriv: ['❤❤❤'] dobbelt.



