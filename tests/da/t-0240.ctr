# test qualifiers

>> $ := Objekt ny.

$ ved: ['svar:'] gør: { :x
	
	>> operation := x tegn: 0.
	>> valuta := x tegn: 1.
	>> money := x forskydning: 2.
	
	>> amount := 0.

	( operation = ['+'] ) sand: {
		( valuta = ['£'] ) sand: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Uddata skriv: x, stop.


>> Fruit := Objekt ny.

Fruit ved: ['ny'] gør: {
	>> f := selv ny.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit ved: ['apples:'] gør: { :a egen apples := a. }.
Fruit ved: ['oranges:'] gør: { :p egen oranges := p. }.
Fruit ved: ['apples'] gør: { <- egen apples. }.
Fruit ved: ['oranges'] gør: { <- egen oranges. }.

Fruit ved: ['+'] gør: { :f
	
	>> n := Fruit ny.
	f læg-til: 1.
	
	n apples: (f apples + egen apples).
	n oranges:  (f oranges  + egen oranges). <- n.
}.

Fruit ved: ['tekst'] gør: { <- ( egen apples tekst + [' apples and '] + egen oranges + [' oranges'] ).
}.

Tal ved: ['apples'] gør: { <- ((Fruit ny) apples: selv).
}.

Tal ved: ['apple'] gør: { <- ((Fruit ny) apples: selv).
}.

Tal ved: ['oranges'] gør: { <- ((Fruit ny) oranges: selv).
}.




Uddata skriv: (1 apple + 3 oranges + 4 apples), stop.


Tekst ved: ['twice'] gør: { <- ((selv tekst) + (selv tekst)).
}.



Uddata skriv: ['❤❤❤'] twice.



