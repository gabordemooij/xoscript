# et format skal passe til værdiens type, typen kan komme fra en klient
>> prøv := { :formatering :value
	{ Uddata skriv: ( (Format ny: formatering) anvend: value ), stop. } fang: { :e Uddata skriv: e, stop. }, start.
}.
>> prøv-heltal := { :formatering :value
	{ Uddata skriv: ( (Format ny: formatering) anvend-heltal: value ), stop. } fang: { :e Uddata skriv: e, stop. }, start.
}.

# passer
prøv anvend: ['|%s|'] og: ['text'].
prøv anvend: ['%06.2f'] og: 5.5.
prøv anvend: ['100%% %s'] og: ['sikkert'].
prøv-heltal anvend: ['%03d'] og: 7.
prøv-heltal anvend: ['%x'] og: 255.
prøv anvend: ['%d'] og: (Int64 ny fra-tekst: ['12']).
prøv anvend: ['%lld'] og: (Int64 ny fra-tekst: ['12']).
prøv anvend: ['%.1lf'] og: 5.5.
prøv-heltal anvend: ['%hd'] og: 7.

# passer ikke
prøv anvend: ['%s'] og: 12345.
prøv anvend: ['%d'] og: 12345.
prøv anvend: ['%f'] og: ['text'].
prøv-heltal anvend: ['%d'] og: ['text'].
prøv-heltal anvend: ['%s'] og: 5.
prøv anvend: ['%s %s'] og: ['text'].
prøv anvend: ['%n'] og: ['text'].
prøv anvend: ['%*s'] og: ['text'].
prøv anvend: ['%'] og: ['text'].

# længdemodifikatoren passer ikke
prøv anvend: ['%ls'] og: ['text'].
prøv anvend: ['%Lf'] og: 5.5.
prøv-heltal anvend: ['%ld'] og: 7.
prøv-heltal anvend: ['%lld'] og: 7.
prøv anvend: ['%Ld'] og: (Int64 ny fra-tekst: ['12']).

# en bredde, der ikke passer til printf, skal give en fejl, ikke et nedbrud
prøv anvend: ['%99999999999s'] og: ['text'].
