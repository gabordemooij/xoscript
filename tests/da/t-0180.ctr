Tekst ved: ['html'] gør: { <- (
		selv
		erstat: ['&'] med: ['&amp;'],
		erstat: ['<'] med: ['&lt;'],
		erstat: ['>'] med: ['&gt;'],
		erstat: ['''] med: ['&apos;'],
		erstat: ['"'] med: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program hukommelsesstyring: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Uddata skriv: txt kopiér html, stop.
Uddata skriv: txt kopiér små-bogstaver, stop.
Uddata skriv: txt kopiér store-bogstaver, stop.
} start.

Program ryd-op.

usedMemory1 := (Program hukommelse ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Uddata skriv: txt kopiér html, stop.
Uddata skriv: txt kopiér små-bogstaver, stop.
Uddata skriv: txt kopiér store-bogstaver, stop.
} start.

Program ryd-op.
usedMemory2 := (Program hukommelse ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Uddata skriv: txt kopiér html, stop.
Uddata skriv: txt kopiér små-bogstaver, stop.
Uddata skriv: txt kopiér store-bogstaver, stop.
} start.

Program ryd-op.
usedMemory3 := (Program hukommelse ? 0).



( usedMemory1 = usedMemory2 og: usedMemory1 = usedMemory3, og: usedMemory2 = usedMemory3 ) sand: {
	Uddata skriv: ['No memory leaks here'].
}, falsk: {
	Uddata skriv: ['Leaking memory...'].
}.
