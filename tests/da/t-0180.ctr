Tekst ved: ['html'] gør: { <- (
		selv
		erstat: ['&'] med: ['&amp;'],
		erstat: ['<'] med: ['&lt;'],
		erstat: ['>'] med: ['&gt;'],
		erstat: ['''] med: ['&apos;'],
		erstat: ['"'] med: ['&quot;']
	).
}.

>> brugtHukommelse1 := 0.
>> brugtHukommelse2 := 0.
>> brugtHukommelse3 := 0.
>> brugtHukommelse4 := 0.

Program hukommelsesstyring: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Uddata skriv: txt kopiér html, stop.
Uddata skriv: txt kopiér små-bogstaver, stop.
Uddata skriv: txt kopiér store-bogstaver, stop.
} start.

Program ryd-op.

brugtHukommelse1 := (Program hukommelse ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Uddata skriv: txt kopiér html, stop.
Uddata skriv: txt kopiér små-bogstaver, stop.
Uddata skriv: txt kopiér store-bogstaver, stop.
} start.

Program ryd-op.
brugtHukommelse2 := (Program hukommelse ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Uddata skriv: txt kopiér html, stop.
Uddata skriv: txt kopiér små-bogstaver, stop.
Uddata skriv: txt kopiér store-bogstaver, stop.
} start.

Program ryd-op.
brugtHukommelse3 := (Program hukommelse ? 0).



( brugtHukommelse1 = brugtHukommelse2 og: brugtHukommelse1 = brugtHukommelse3, og: brugtHukommelse2 = brugtHukommelse3 ) sand: {
	Uddata skriv: ['Ingen hukommelseslæk her'].
}, falsk: {
	Uddata skriv: ['Lækker hukommelse...'].
}.
