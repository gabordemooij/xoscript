>> map1 := Ordbog ny.
>> key1 := Liste ny.
>> key2 := Liste ny.

map1
	sæt: ['hello'] ved: key1,
	sæt: ['world'] ved: key2.


Uddata
	skriv: ['Map #1 contains: '] + (map1 ved: key1),
	skriv: [' and '] + (map1 ved: key2), stop.

>> KeyeableArray := Liste ny.
KeyeableArray ved: ['toString'] gør: { <- (selv antal) toString.
}.

>> map2 := Ordbog ny.
key1 := KeyeableArray ny.
key2 := KeyeableArray ny.

key1 tilføj: 1.

map2
	sæt: ['hello'] ved: key1,
	sæt: ['world'] ved: key2.

Uddata
	skriv: ['Map #2 contains: '] + (map2 ved: key1),
	skriv: [' and '] + (map2 ved: key2), stop.
