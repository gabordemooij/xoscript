>> tabel1 := Ordbog ny.
>> nøgle1 := Liste ny.
>> nøgle2 := Liste ny.

tabel1
	sæt: ['hello'] ved: nøgle1,
	sæt: ['world'] ved: nøgle2.


Uddata
	skriv: ['Map #1 contains: '] + (tabel1 ved: nøgle1),
	skriv: [' og '] + (tabel1 ved: nøgle2), stop.

>> NøgleListe := Liste ny.
NøgleListe ved: ['tilTekst'] gør: { <- (selv antal) tilTekst.
}.

>> map2 := Ordbog ny.
nøgle1 := NøgleListe ny.
nøgle2 := NøgleListe ny.

nøgle1 tilføj: 1.

map2
	sæt: ['hello'] ved: nøgle1,
	sæt: ['world'] ved: nøgle2.

Uddata
	skriv: ['Map #2 contains: '] + (map2 ved: nøgle1),
	skriv: [' og '] + (map2 ved: nøgle2), stop.
