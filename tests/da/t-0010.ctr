>> Animal := Objekt ny.
Animal ved: ['make'] gør: {
	>> animal := Objekt ny.
	animal ved: ['makeSound'] gør: {
		Uddata skriv: egen sound.
	}. <- animal.
}.
>> Cat := Objekt ny.
Cat ved: ['make'] gør: {
	>> cat := Animal make.
	cat ved: ['init'] gør: {
		egen sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
