Tal ved: ['roman'] gør: {
	>> tal := selv kopiér.
	>> roman := [''].
	{
		{
			(tal ≥ 1000) sand: {
				roman tilføj: ['Ⅿ'].
				tal træk-fra: 1000.
			}, afbryd.
		
			(tal ≥ 500) sand: {
				roman tilføj: ['Ⅾ'].
				tal træk-fra: 500.
			}, afbryd.
		
			(tal ≥ 100) sand: {
				roman tilføj: ['Ⅽ'].
				tal træk-fra: 100.
			}, afbryd.
		
			(tal ≥ 50) sand: {
				roman tilføj: ['Ⅼ'].
				tal træk-fra: 50.
			}, afbryd.
		
			(tal ≥ 50) sand: {
				roman tilføj: ['Ⅼ'].
				tal træk-fra: 50.
			}, afbryd.
		
			(tal ≥ 10) sand: {
				roman tilføj: ['Ⅹ'].
				tal træk-fra: 10.
			}, afbryd.
			
			(tal ≥ 9) sand: {
				roman tilføj: ['Ⅸ'].
				tal træk-fra: 9.
			}, afbryd.
			
			(tal ≥ 5) sand: {
				roman tilføj: ['Ⅴ'].
				tal træk-fra: 5.
			}, afbryd.
			
			(tal ≥ 4) sand: {
				roman tilføj: ['Ⅳ'].
				tal træk-fra: 4.
			}, afbryd.
			
			(tal ≥ 1) sand: {
				roman tilføj: ['Ⅰ'].
				tal træk-fra: 1.
			}, afbryd.
		} procedure.
	} mens: { <- tal > 0. }. <- roman.
}.

Uddata skriv: 1 roman, stop.
Uddata skriv: 2 roman, stop.
Uddata skriv: 4 roman, stop.
Uddata skriv: 8 roman, stop.
Uddata skriv: 16 roman, stop.
Uddata skriv: 32 roman, stop.
Uddata skriv: 64 roman, stop.
Uddata skriv: 128 roman, stop.
Uddata skriv: 256 roman, stop.
Uddata skriv: 1024 roman, stop.
