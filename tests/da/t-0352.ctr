Tal ved: ['romertal'] gør: {
	>> tal := selv kopiér.
	>> romertal := [''].
	{
		{
			(tal ≥ 1000) sand: {
				romertal tilføj: ['Ⅿ'].
				tal træk-fra: 1000.
			}, afbryd.
		
			(tal ≥ 500) sand: {
				romertal tilføj: ['Ⅾ'].
				tal træk-fra: 500.
			}, afbryd.
		
			(tal ≥ 100) sand: {
				romertal tilføj: ['Ⅽ'].
				tal træk-fra: 100.
			}, afbryd.
		
			(tal ≥ 50) sand: {
				romertal tilføj: ['Ⅼ'].
				tal træk-fra: 50.
			}, afbryd.
		
			(tal ≥ 50) sand: {
				romertal tilføj: ['Ⅼ'].
				tal træk-fra: 50.
			}, afbryd.
		
			(tal ≥ 10) sand: {
				romertal tilføj: ['Ⅹ'].
				tal træk-fra: 10.
			}, afbryd.
			
			(tal ≥ 9) sand: {
				romertal tilføj: ['Ⅸ'].
				tal træk-fra: 9.
			}, afbryd.
			
			(tal ≥ 5) sand: {
				romertal tilføj: ['Ⅴ'].
				tal træk-fra: 5.
			}, afbryd.
			
			(tal ≥ 4) sand: {
				romertal tilføj: ['Ⅳ'].
				tal træk-fra: 4.
			}, afbryd.
			
			(tal ≥ 1) sand: {
				romertal tilføj: ['Ⅰ'].
				tal træk-fra: 1.
			}, afbryd.
		} procedure.
	} mens: { <- tal > 0. }. <- romertal.
}.

Uddata skriv: 1 romertal, stop.
Uddata skriv: 2 romertal, stop.
Uddata skriv: 4 romertal, stop.
Uddata skriv: 8 romertal, stop.
Uddata skriv: 16 romertal, stop.
Uddata skriv: 32 romertal, stop.
Uddata skriv: 64 romertal, stop.
Uddata skriv: 128 romertal, stop.
Uddata skriv: 256 romertal, stop.
Uddata skriv: 1024 romertal, stop.
