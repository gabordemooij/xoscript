# test list operations


>> cakes := Liste ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes erstat: 1 længde: 2 med: ( Liste ← ['cinnamon'] ; ['pineapple'] ).
Uddata skriv: (buy saml: [',']), stop.


>> buy := cakes erstat: 1 længde: 12 med: ( Liste ← ['cinnamon'] ; ['pineapple'] ).
Uddata skriv: (buy saml: [',']), stop.


>> buy := cakes erstat: 2 længde: 10 med: ( Liste ny ).
Uddata skriv: (buy saml: [',']), stop.


>> buy := cakes erstat: 0 længde: 1 med: ( Liste ny ).
Uddata skriv: (buy saml: [',']), stop.


>> buy := cakes erstat: ['0'] længde: ['1'] med: ['x'].
Uddata skriv: (buy saml: [',']), stop.
