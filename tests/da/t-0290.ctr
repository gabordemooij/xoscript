# test listeoperationer


>> kager := Liste ←
	['apple'] ;
	['bær'] ;
	['choko'] ;
	['ost'].


>> køb := kager erstat: 1 længde: 2 med: ( Liste ← ['kanel'] ; ['ananas'] ).
Uddata skriv: (køb saml: [',']), stop.


>> køb := kager erstat: 1 længde: 12 med: ( Liste ← ['kanel'] ; ['ananas'] ).
Uddata skriv: (køb saml: [',']), stop.


>> køb := kager erstat: 2 længde: 10 med: ( Liste ny ).
Uddata skriv: (køb saml: [',']), stop.


>> køb := kager erstat: 0 længde: 1 med: ( Liste ny ).
Uddata skriv: (køb saml: [',']), stop.


>> køb := kager erstat: ['0'] længde: ['1'] med: ['x'].
Uddata skriv: (køb saml: [',']), stop.
