

Tekst ved: ['evaluer'] gør: {
	>> code := Fil ny: ['/tmp/eval.ctr'].
	code skriv: selv tekst + ['.'].
	Program brug: ['/tmp/eval.ctr'].
}.

>> a := (Liste ← (
	(Ordbog ny)
		sæt: ['domæne'] ved: ['mywebsite.com'],
		sæt: (Liste ←
			((Ordbog ny)
				sæt: ['hjem'] ved: ['title'],
				sæt: ['<html></html>'] ved: ['body'],
				sæt: ['2017-01-01'] ved: ['oprettet']
			) ;
			((Ordbog ny)
				sæt: ['omos(c)'] ved: ['title'],
				sæt: ['<credits>Forfatter A/S</credits>'] ved: ['body']
			)
		) ved: ['sider']
	)
) tekst.

Uddata skriv: a type, stop.
Uddata skriv: a, stop.

>> b := Intet.
(['b := '] + a) evaluer.
Uddata skriv: b ? 0 ? ['sider'] ? 1 ? ['body'], stop.

>> c := b ? 0.
>> d := c tekst.
Uddata skriv: d type, stop.

>> e := Intet.
(['e := '] + d) evaluer.
Uddata skriv: e ? ['sider'] ? 0, stop.
