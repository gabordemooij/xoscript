{
	>> a := Liste ny.
	a tilføj: 1.
	a tilføj: 2.
	Uddata skriv: (a saml: [',']), stop.
	a sæt: 3 ved: 2.
	Uddata skriv: (a saml: [',']), stop.
	a sæt: 4 ved: 10.
	Uddata skriv: (a saml: [',']), stop.
	a tag-første.
	a tag-første.
	a tag-første.
	Uddata skriv: (a saml: [',']), stop.
	a sæt: 9 ved: 0.
	Uddata skriv: (a saml: [',']), stop.
	a sæt: 6 ved: -1.
} fang: { :e
	Uddata skriv: ['Uncatched error has occurred.↵'] + e, stop.
}, start.


