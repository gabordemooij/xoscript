# glad sti
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> sti := ['/tmp/dat.csv'].
>> csv := Fil ny: sti.
csv skriv: s.

# accepterer CRLF LF CR, varierende rækkelængde
csv skilletegn: [';'] citationstegn: ['"'] linjer: { :line
	Program ryd-op.
	Uddata skriv: line, stop.
	Program ryd-op.
}.

# ulige mange linjer
s tilføj: ['\njustone'].
csv skriv: s.
{
	csv skilletegn: [';'] citationstegn: ['"'] linjer: { :line
		Uddata skriv: line, stop.
	}.
} fang: { :e 
	Uddata skriv: e, stop.
}, start.

# ugyldigt format
s := ['"he"llo";world'].
csv skriv: s.
{
	csv skilletegn: [';'] citationstegn: ['"'] linjer: { :line
		Uddata skriv: line, stop.
	}.
} fang: { :e 
	Uddata skriv: e, stop.
}, start.
