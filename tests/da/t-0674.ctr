# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> sti := ['/tmp/dat.csv'].
>> csv := Fil ny: sti.
csv skriv: s.

# accepts CRLF LF CR, varying row length
csv skilletegn: [';'] citationstegn: ['"'] linjer: { :line
	Program ryd-op.
	Uddata skriv: line, stop.
	Program ryd-op.
}.

# unequal lines
s tilføj: ['\njustone'].
csv skriv: s.
{
	csv skilletegn: [';'] citationstegn: ['"'] linjer: { :line
		Uddata skriv: line, stop.
	}.
} fang: { :e 
	Uddata skriv: e, stop.
}, start.

# invalid format
s := ['"he"llo";world'].
csv skriv: s.
{
	csv skilletegn: [';'] citationstegn: ['"'] linjer: { :line
		Uddata skriv: line, stop.
	}.
} fang: { :e 
	Uddata skriv: e, stop.
}, start.
