# test buffere PKI/Sign 
Server init.

>> lang := ( Liste ny fyld: 1000 med: ['a'] ) saml: [''].

# signér en besked
Uddata skriv: ( 
	Boks signér: ['abc'] med: lang
), stop.

Uddata skriv: ( 
	Boks
		kontrollér: ['abc'] 
		signatur: lang 
		med: lang
), stop.

Uddata skriv: (
	Boks adgangskode-hash: lang bekræft: lang
), stop.
