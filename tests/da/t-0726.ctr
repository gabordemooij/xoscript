# test buffers PKI/Sign 
Server init.

>> long := ( Liste ny fyld: 1000 med: ['a'] ) saml: [''].

# sign a message
Uddata skriv: ( 
	Boks signér: ['abc'] med: long
), stop.

Uddata skriv: ( 
	Boks
		kontrollér: ['abc'] 
		signatur: long 
		med: long
), stop.

Uddata skriv: (
	Boks adgangskode-hash: long bekræft: long
), stop.
