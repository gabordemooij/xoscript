#Linux

(Fil ny: ['/tmp/testje']) findes falsk: {
	Program system: ['mkdir /tmp/testje'].	
}.

(Fil ny: ['/tmp/testje/file1']) findes falsk: {
	Program system: ['touch /tmp/testje/file1'].	
}.

(Fil ny: ['/tmp/testje/folder1']) findes falsk: {
	Program system: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Fil liste: ['/tmp/testje'].

>> q := Liste ny.

l hver: { :k :v v hver: { :x :y q tilføj: y. }. }.

>> s := q tekst.

(s indeholder: ['file1']) sand:   { Uddata skriv: ['OK'], stop. }.
(s indeholder: ['file2']) sand:   { Uddata skriv: ['XX'], stop. }.
(s indeholder: ['folder1']) sand: { Uddata skriv: ['OK'], stop. }.
