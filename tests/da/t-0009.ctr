>> Greeter := Objekt ny.
Greeter ved: ['make'] gør: {
	>> greeter := Objekt ny.
	greeter ved: ['name:'] gør: { :navn
		Uddata skriv: ['setting a name'].
		egen myName := navn.
	}.
	greeter ved: ['performGreeting'] gør: {
		Uddata skriv: ['Hello'].
		Uddata skriv: egen myName.
	}.
	greeter ved: ['greet'] gør: {
		selv performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
