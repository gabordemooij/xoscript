
>> Rektangel := Objekt ny.

Rektangel ved: ['areal'] gør: {
	<- egen længde * egen bredde.
}.

Rektangel ved: ['length:'] gør: { :længde
	egen længde := længde.
}.

Rektangel ved: ['width:'] gør: { :bredde
	egen bredde := bredde.
}.

Rektangel ved: ['ny'] gør: {
	# dette giver ikke en uendelig løkke
	>> rektangel := selv ny.
	rektangel length: 0, width: 0.
	<- rektangel.
}.

>> a := Rektangel ny.
Uddata skriv: a areal, stop. #0

>> b := Rektangel ny length: 2, width: 3.
Uddata skriv: b areal, stop. #6

