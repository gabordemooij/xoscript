
>> Rectangle := Objekt ny.

Rectangle ved: ['area'] gør: { <- egen længde * egen width.
}.

Rectangle ved: ['length:'] gør: { :længde
	egen længde := længde.
}.

Rectangle ved: ['width:'] gør: { :width
	egen width := width.
}.

Rectangle ved: ['ny'] gør: {
	# this will not result into an infinite loop
	>> rectangle := selv ny.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle ny.
Uddata skriv: a area, stop. #0

>> b := Rectangle ny length: 2, width: 3.
Uddata skriv: b area, stop. #6

