# Denne test kontrollerer, om string_fill_in ikke mister sin plads (gc'ed) i tilstand 4
# reference i world.c
>> Logbog := Objekt ny.

Logbog ved: ['say:'] gør: { :str
	Uddata skriv: str, stop.
}.

>> Vare := Objekt ny.

Vare ved: ['ny:'] gør: { :id
	<- selv ny id: id.
}.

Vare ved: ['id:'] gør: { :id
	egen id := id.
}.

Vare ved: ['id'] gør: { <- egen id. }.


Vare ved: ['tekst'] gør: {
	>> str := ['Item#~no'].
	str ~no: egen id.
	<- str.
}.


>> Print := Objekt ny.

Print ved: ['items'] gør: { 
	
	egen vare := Vare ny: 1.
	
	# enten segfault eller forkert tegnstreng her
	Logbog say: (
		['~item printed.'] ~item: egen vare
	).
	
	
}.

Print items.