>> items := Ordbog ny.
items sæt: ['sort'] ved: ['coffee'], sæt: ['earl grey'] ved: ['te'].
Uddata skriv: (items ved: ['coffee']), skriv: (items ved: ['te']).
Uddata skriv: ['der er'] + items antal + [' elementer i listen.'].
items sæt: ['cappuccino'] ved: ['coffee'].
Uddata skriv: ['Nu er min kaffe.. '] + (items ved: ['coffee']).
items sæt: ['aaa'] ved: ['1'].
items sæt: ['bbb'] ved: ['2'].
Uddata skriv: (items ved: ['a']).
