>> items := Ordbog ny.
items sæt: ['black'] ved: ['coffee'], sæt: ['earl grey'] ved: ['tea'].
Uddata skriv: (items ved: ['coffee']), skriv: (items ved: ['tea']).
Uddata skriv: ['there are'] + items antal + [' items in the array.'].
items sæt: ['capuccino'] ved: ['coffee'].
Uddata skriv: ['Now my coffee is.. '] + (items ved: ['coffee']).
items sæt: ['aaa'] ved: ['1'].
items sæt: ['bbb'] ved: ['2'].
Uddata skriv: (items ved: ['a']).
