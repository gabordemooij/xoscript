# databasetest
# se eksemplet server.xo for den nødvendige konfiguration

Server init.
Uddata skriv: ['Databasetest'], stop.

>> db := Maria-DB ny vært: ['localhost'],
	brugernavn: ['xo'], adgangskode: ['pass123'], databasenavn: ['xobase'], tilslut.

Uddata skriv: ['Kan vi forbinde? '] + db tilsluttet?, stop.

>> søgeparametre := db forespørgsel: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parametre: ( Liste ny ; ['abc'] ; 12.35 ; 6 ). # parameteriserede forespørgsler

{  søgeparametre udfør. db bekræft. } fang: { :e db rul-tilbage.  }, start.

Uddata skriv: ['Kan vi indsætte? '] + ( søgeparametre insert-id > 0 ), stop.

>> Obj := Objekt ny.
Obj ved: ['hent-rækker'] gør: {
	egen antal := 0.
	>> søgeparametre :=
	db forespørgsel: ['SELECT * FROM book order by id desc limit 2'], 
	hent: { :række 
		egen antal læg-til: 1.
		Sand afbryd.
	}. # hentning af rækker
	<- egen antal kopiér.
}.

Uddata skriv: ['Kan vi forespørge? '] + ( Obj hent-rækker > 0 ), stop.
