Uddata skriv: ['Test object'], stop.
>> greeter := Objekt ny.
greeter ved: ['name:'] gør: { :navn
	egen xname := navn. 
}.
greeter ved: ['greet'] gør: {
	Uddata skriv: ['Hello '] + egen xname, stop.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Uddata skriv: ['========== RELOADING SNAP:'], stop.
>> b := Objekt load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
