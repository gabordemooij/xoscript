
Program hukommelsesstyring: 4.

>> Dyr := Objekt ny.
Dyr ved: ['lav'] gør: {
	>> dyr := Objekt ny.
	dyr ved: ['lavLyd'] gør: {
		Uddata skriv: egen lyd.
	}. <- dyr.
}.
>> Kat := Objekt ny.
Kat ved: ['lav'] gør: {
	>> kat := Dyr lav.
	kat ved: ['init'] gør: {
		egen lyd := ['meow!'].
	}.
	kat init. <- kat.
}.
>> tom := Kat lav.
tom lavLyd.
