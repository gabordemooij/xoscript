>> faktura := Objekt ny.
faktura ved: ['start'] gør: {
        egen tal := 0.
}.

faktura ved: ['tal'] gør: {
        egen tal læg-til: 1.
        <- egen tal kopiér.
}.

>> årsfaktura := faktura ny.
årsfaktura ved: ['start:'] gør: { :år
	egen tal := år.
}.

årsfaktura start: 202000.
Uddata skriv: årsfaktura tal, stop.
Uddata skriv: årsfaktura tal, stop.
