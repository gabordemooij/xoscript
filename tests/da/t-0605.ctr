>> invoice := Objekt ny.
invoice ved: ['start'] gør: {
        egen tal := 0.
}.

invoice ved: ['tal'] gør: {
        egen tal læg-til: 1. <- egen tal kopiér.
}.

>> year-invoice := invoice ny.
year-invoice ved: ['start:'] gør: { :år
	egen tal := år.
}.

year-invoice start: 202000.
Uddata skriv: year-invoice tal, stop.
Uddata skriv: year-invoice tal, stop.
