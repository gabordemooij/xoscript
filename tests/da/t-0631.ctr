#ffi-test


Server init.

Program hukommelsesstyring: 4.

# til denne test skal du angive en sti til libc (puts)
>> biblnavn := Program indstilling: ['FFITESTLIB'].



Server forbind: (
 Liste ny ;
 biblnavn ;
 ['puts'] ;
 ( Liste ny ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s frigiv.

# test med struct

>> a := Blob ny: 8.
a bytes: (
	Liste <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Liste <<: ['int'], ; ['int']).

Server forbind: (
	Liste <<: ['@structtest'], ;
	['@structtest'] ;
	(Liste <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Uddata skriv: ['Sumtest:'] + (ffitest ffisum: a), stop.

struct frigiv-struct.
struct frigiv.
a frigiv.
