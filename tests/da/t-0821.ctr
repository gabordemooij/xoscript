# et anførselstegn, der aldrig lukkes, skal give en fejl, ikke en uendelig løkke
>> sti := ['/tmp/test0821.csv'].
>> file := Fil ny: sti.

file skriv: ['a,b\n"1,2\n'].
{
	file skilletegn: [','] citationstegn: ['"'] linjer: { :line
		Uddata skriv: line, stop.
	}.
} fang: { :e Uddata skriv: e, stop. }, start.

# et lukket anførselstegn virker stadig
file skriv: ['a,b\n"1,2",3'].
file skilletegn: [','] citationstegn: ['"'] linjer: { :line
	Uddata skriv: line, stop.
}.
file slet.
