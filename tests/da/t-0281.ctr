>> q := Liste ← 1 ; 2 ; 3.
{ q ? ['1']. } fang: { Uddata skriv: ['caught!'], stop. }, start.
{ q ? Sand. } fang: { Uddata skriv: ['caught!'], stop. }, start.
{ q ? Falsk. } fang: { Uddata skriv: ['caught!'], stop. }, start.
{ q ? Intet. } fang: { Uddata skriv: ['caught!'], stop. }, start.
{ q ? (Liste ny). } fang: { Uddata skriv: ['caught!'], stop. }, start.
{ q ? (Objekt ny). } fang: { Uddata skriv: ['caught!'], stop. }, start.
{ q ? ({ ['Empty']. }). } fang: { Uddata skriv: ['caught!'], stop. }, start.
Uddata skriv: ['caught them all'], stop.
