>> t := Sand.
(t = Sand) sand: { Uddata skriv: ['T']. }.
(t = Falsk) sand: { Uddata skriv: ['F']. }.
Uddata skriv: ['|'].
>> t := Falsk.
(t = Sand) sand: { Uddata skriv: ['T']. }.
(t = Falsk) sand: { Uddata skriv: ['F']. }.
Uddata skriv: ['|'].
>> f := Sand.
(t = Sand og: f = Falsk) sand: { Uddata skriv: ['T']. }.
(t = Falsk og: f = Sand) sand: { Uddata skriv: ['F']. }.
Uddata skriv: ['|'].
>> n := Intet.
(n Intet?) sand: { Uddata skriv: ['T']. }.
(n Intet?) falsk: { Uddata skriv: ['F']. }.
Uddata skriv: ['|'].
(f Boolean?) sand: { Uddata skriv: ['T']. }.
(f Boolean?) falsk: { Uddata skriv: ['F']. }.



