Uddata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gør: { :ud
	egen ud := ud. 
}.

a ved: ['vare'] gør: {
	<- egen ud.
}.

a ved: ['hils'] gør: {
	Uddata skriv: ['hej fra den oprindelige ud!'], stop.
}.

a item: Uddata.

Uddata skriv: a vare, stop.

>> gammel-ud-adresse := a vare prototype hukommelsesadresse.
a save-as: ['/tmp/a.bin'].
Uddata skriv: ['========== GENINDLÆSER SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b vare prototype hukommelsesadresse = gammel-ud-adresse) sand: {
	Uddata skriv: ['Objektlink genoprettet.'], stop.
}.

b vare skriv: ['hej fra den indlæste ud!'], stop.
b hils.
