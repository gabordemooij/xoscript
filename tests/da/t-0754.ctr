Uddata skriv: ['Test object'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gør: { :out
	egen out := out. 
}.

a ved: ['item'] gør: { <- egen out.
}.

a ved: ['greet'] gør: {
	Uddata skriv: ['hi from original out!'], stop.
}.

a item: Uddata.

Uddata skriv: a item, stop.

>> old-out-address := a item prototype hukommelsesadresse.
a save-as: ['/tmp/a.bin'].
Uddata skriv: ['========== RELOADING SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototype hukommelsesadresse = old-out-address) sand: {
	Uddata skriv: ['Object link re-attached.'], stop.
}.

b item skriv: ['hello from loaded out!'], stop.
b greet.
