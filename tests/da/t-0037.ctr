>> a := 3.
>> b := a kopiér.
a træk-fra: 1.
Uddata skriv: [' a = '] + a.
Uddata skriv: [' b = '] + b.
a := 3.
b := a + 4.
Uddata skriv: [' a = '] + a.
Uddata skriv: [' b = '] + b.
>> x := 3.
>> y := x kopiér.
x læg-til: 10.
y træk-fra: 1.
Uddata skriv: [' x = '] + x.
Uddata skriv: [' y = '] + y.
>> q := Objekt ny.
q ved: ['setProperty:'] gør: { :x
	egen egensk := x.
}.
q ved: ['hentEgenskab'] gør: { <- egen egensk.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Uddata skriv: [' p = '] + (p hentEgenskab).
