Uddata skriv: ['Test object'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gør: { :binhelper
	egen binhelper := binhelper. 
}.

a ved: ['item'] gør: { <- egen binhelper.
}.

a item: Bin ny.

>> old-binhelper-address := a item prototype hukommelsesadresse.
a save-as: ['/tmp/a.bin'].
Uddata skriv: ['========== RELOADING SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototype hukommelsesadresse = old-binhelper-address) sand: {
	Uddata skriv: ['Object link re-attached.'], stop.
}.


