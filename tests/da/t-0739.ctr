Uddata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gør: { :binhjælper
	egen binhjælper := binhjælper. 
}.

a ved: ['vare'] gør: {
	<- egen binhjælper.
}.

a item: Bin ny.

>> gammel-binhjælper-adresse := a vare prototype hukommelsesadresse.
a save-as: ['/tmp/a.bin'].
Uddata skriv: ['========== GENINDLÆSER SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b vare prototype hukommelsesadresse = gammel-binhjælper-adresse) sand: {
	Uddata skriv: ['Objektlink genoprettet.'], stop.
}.


