

Liste ved: ['fixture:'] gør: { :f
	egen fixture := f.
}.

Liste ved: ['antal'] gør: { <- egen fixture.
}.

Liste ved: ['aantal'] gør: { <- egen fixture.
}.


>> x := Intet.
{

	x := ['hello'] 
	erstat:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] tegn: 2)
			)
		)
	med: (
		(['...hal'] + ['lo']) 
			store-bogstaver 
			lowecase 
			store-bogstaver 
			forskydning: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Liste ← 0 ; 1 ; 4; 9 ; (Liste ← 0 ; 3; 1) ; 4
							) næstsidste
						) ? 1
					) + 
					((Liste ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					antal
				)
			)
	).

} × 10.
Uddata skriv: x, stop.

