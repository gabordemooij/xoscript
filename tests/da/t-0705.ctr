

>> obj := Objekt ny.

obj ved: ['greet'] gør: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj ved: ['task'] gør: {
	egen property := 123.
	{
		# try binds self/own to object instead of block
		Uddata skriv: selv greet.
		Uddata skriv: egen property.
		1 / 0.
	} fang: {
		Uddata skriv: selv greet.
		Uddata skriv: egen property.
		Uddata skriv: ['ok'].
	}, prøv.
}.

obj task.