

>> obj := Objekt ny.

obj ved: ['hils'] gør: {
	<- ['hej'].
}.

# skal udskrive hi123hi123ok
obj ved: ['opgave'] gør: {
	egen egenskab := 123.
	{
		# try binder selv/egen til objektet i stedet for blokken
		Uddata skriv: selv hils.
		Uddata skriv: egen egenskab.
		1 / 0.
	} fang: {
		Uddata skriv: selv hils.
		Uddata skriv: egen egenskab.
		Uddata skriv: ['ok'].
	}, prøv.
}.

obj opgave.