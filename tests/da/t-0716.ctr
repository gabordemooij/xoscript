Uddata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 

a ved: ['state:'] gør: { :list
	egen list := list. 
}.

a ved: ['tilstanden'] gør: {
	Uddata skriv: egen list, stop.
}.

a state: ( Liste ny ; ['listeelement'] ; ['element2'] ).
a tilstanden.

a save-as: ['/tmp/a.bin'].
Uddata skriv: ['========== GENINDLÆSER SNAP:'], stop.
>> b := Objekt load-from: ['/tmp/a.bin'].
b tilstanden.