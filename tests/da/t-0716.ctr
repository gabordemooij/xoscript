Uddata skriv: ['Test object'], stop.
>> a := Objekt ny. 

a ved: ['state:'] gør: { :list
	egen list := list. 
}.

a ved: ['state'] gør: {
	Uddata skriv: egen list, stop.
}.

a state: ( Liste ny ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
