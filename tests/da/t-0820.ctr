# en gruppe, der ikke er en del af matchet, må ikke give nedbrud og skal bevare gruppenumrene
Server init.
>> vis := { :mønstret :subject
	>> p := Mønster ny: mønstret.
	p match: subject gør: { :m :g
		Uddata skriv: g antal, skriv: [' '], skriv: (g saml: ['|']), stop.
		<- m.
	}.
}.
vis anvend: ['(a)|(b)'] og: ['b'].
vis anvend: ['(a)|(b)'] og: ['a'].
vis anvend: ['(x)?y'] og: ['y'].
vis anvend: ['(x)?(y)(z)?'] og: ['xy'].
