# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Mønster ny: pattern.
	p match: subject gør: { :m :g
		Uddata skriv: g antal, skriv: [' '], skriv: (g saml: ['|']), stop. <- m.
	}.
}.
show anvend: ['(a)|(b)'] og: ['b'].
show anvend: ['(a)|(b)'] og: ['a'].
show anvend: ['(x)?y'] og: ['y'].
show anvend: ['(x)?(y)(z)?'] og: ['xy'].
