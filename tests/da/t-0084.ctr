>> lavAdderer := { :x
	>> f := { :y <- (egen x + y). } sæt: ['x'] værdi: x. <- f.
}.
>> afbilder := { :array :fkt
	>> afbildning := { :i egen q sæt: (egen f anvend: (egen q ? i)) ved: i. } 
	sæt: ['q'] værdi: array,
	sæt: ['f'] værdi: fkt.
	{ :i afbildning anvend: i. } × (array antal).
}.

>> a := Liste ← 1; 2; 3.
afbilder anvend: a og: (lavAdderer anvend: 100).
Uddata skriv: (a position: 0), stop.
Uddata skriv: (a ? 1), stop.
Uddata skriv: (a ? 2), stop.
