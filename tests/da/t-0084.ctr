>> makeAdder := { :x
	>> f := { :y <- (egen x + y). } sæt: ['x'] værdi: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i egen q sæt: (egen f anvend: (egen q ? i)) ved: i. } 
	sæt: ['q'] værdi: array,
	sæt: ['f'] værdi: func.
	{ :i mapping anvend: i. } × (array antal).
}.

>> a := Liste ← 1; 2; 3.
mapper anvend: a og: (makeAdder anvend: 100).
Uddata skriv: (a position: 0), stop.
Uddata skriv: (a ? 1), stop.
Uddata skriv: (a ? 2), stop.
