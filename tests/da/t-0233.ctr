
>> Slurp := Objekt ny.

Slurp ved: ['ny'] gør: {
	egen str := [''].
}.

Slurp ved: ['svar:'] gør: { :blah
		(egen str = ['']) sand: {
			egen str tilføj: blah.
		}, ellers: {
			egen str tilføj: [' '].
			egen str tilføj: blah.
		}.
}.

Slurp ved: ['svar:og:'] gør: { :blah :blahah
		(blah længde > 1) sand: {
			egen str tilføj: (blah fra: 0 længde: (blah længde - 1)).
		}, ellers: {
			egen str tilføj: blah.
		}.
		egen str tilføj: [' '].
		egen str tilføj: blahah.
}.

Slurp ved: ['skaf'] gør: {
	>> buffer := egen str.
	egen str := ['']. <- buffer.
}.

Uddata skriv: ( Program system: ( Slurp ny echo hello world skaf ) ).
