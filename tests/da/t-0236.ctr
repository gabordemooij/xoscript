>> Slurp := Objekt ny.
Slurp ved: ['ny'] gør: {
	egen str := [''].
}.


Slurp ved: ['svar:'] gør: { :blah
		(egen str ≠ ['']) sand: {
			egen str tilføj: [' '].
		}.
		egen str tilføj: blah.
}.
Slurp ved: ['svar:og:'] gør: { :blah :blahah
		(egen str ≠ ['']) sand: {
			egen str tilføj: [' '].
		}.
		(blah længde > 1) sand: {
			egen str tilføj: (blah fra: 0 længde: (blah længde - 1)).
		}, ellers: {
			egen str tilføj: blah.
		}.
		egen str tilføj: [' '].
		egen str tilføj: blahah.
}.
Slurp ved: ['skaf'] gør: {
	>> buffer := egen str.
	egen str := ['']. <- buffer.
}.

>> søgeparametre := Slurp ny.
søgeparametre select: ['*'], from brugere where: ['id = 2'].
Uddata skriv: (søgeparametre skaf), stop.
