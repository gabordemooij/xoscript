


>> CoffeeMachine := Objekt ny.
CoffeeMachine ved: ['order:'] gør: { :id
	>> coffee := ['Americano'].
	( id = 1 ) sand: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) sand: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) sand: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Objekt ny.
SimpleCoffeeMachine ved: ['order'] gør: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Uddata skriv: redCup, stop.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Uddata skriv: greenCup, stop.
>> yellowCup := CoffeeMachine order: 1.
Uddata skriv: yellowCup, stop.
>> blueCup := CoffeeMachine order: 0.
Uddata skriv: blueCup, stop.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Uddata skriv: blackCup, stop.
blackCup tilføj: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Uddata skriv: orangeCup, stop.
