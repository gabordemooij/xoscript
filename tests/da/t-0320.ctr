


>> Kaffemaskine := Objekt ny.
Kaffemaskine ved: ['order:'] gør: { :id
	>> coffee := ['Americano'].
	( id = 1 ) sand: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) sand: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) sand: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpelKaffemaskine := Objekt ny.
SimpelKaffemaskine ved: ['bestilling'] gør: { <- ['Sort']. }.
>> rødKop := Kaffemaskine order: 1.
Uddata skriv: rødKop, stop.
rødKop := ['Te']. 
>> grønKop := Kaffemaskine order: 0.
Uddata skriv: grønKop, stop.
>> gulKop := Kaffemaskine order: 1.
Uddata skriv: gulKop, stop.
>> blåKop := Kaffemaskine order: 0.
Uddata skriv: blåKop, stop.
>> plastikKop := SimpelKaffemaskine bestilling.
plastikKop := ['Limonade']. 
>> sortKop := SimpelKaffemaskine bestilling.
Uddata skriv: sortKop, stop.
sortKop tilføj: [' neeej.... øl. '].
>> orangeKop := SimpelKaffemaskine bestilling.
Uddata skriv: orangeKop, stop.
