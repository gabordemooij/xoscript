60 × {
	>> x := (Tal tilfældig % 6) + 1.
	(x ≤ 6) falsk: { Uddata skriv: ['FEJL']. }.
	(x ≥0) falsk: { Uddata skriv: ['FEJL']. }.
	x := (Tal tilfældig % 3) + 1.
	(x < 3) falsk: { Uddata skriv: ['FEJL']. }.
	(x>-1) falsk: { Uddata skriv: ['FEJL']. }.
	x := ((Boolsk vend) tal).
	(x = 0 eller: x = 1) falsk: { Uddata skriv: ['FEJL']. }.
	x := ((Sand vend) tal).
	(x = 0 eller: x = 1) falsk: { Uddata skriv: ['FEJL']. }.
	x := (Boolsk vend enten: ['PLAT'] eller: ['KRONE']).
	((x = ['PLAT']) eller: (x = ['KRONE'])) falsk: { Uddata skriv: ['FEJL']. }.
}.
Uddata skriv: ['FÆRDIG'].

