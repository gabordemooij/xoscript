60 × {
	>> x := (Tal random % 6) + 1.
	(x ≤ 6) falsk: { Uddata skriv: ['FAIL']. }.
	(x ≥0) falsk: { Uddata skriv: ['FAIL']. }.
	x := (Tal random % 3) + 1.
	(x < 3) falsk: { Uddata skriv: ['FAIL']. }.
	(x>-1) falsk: { Uddata skriv: ['FAIL']. }.
	x := ((Boolsk flip) tal).
	(x = 0 eller: x = 1) falsk: { Uddata skriv: ['FAIL']. }.
	x := ((Sand flip) tal).
	(x = 0 eller: x = 1) falsk: { Uddata skriv: ['FAIL']. }.
	x := (Boolsk flip enten: ['HEAD'] eller: ['TAIL']).
	((x = ['HEAD']) eller: (x = ['TAIL'])) falsk: { Uddata skriv: ['FAIL']. }.
}.
Uddata skriv: ['DONE'].

