Server init.

>> پایگاه := Maria-DB جدید میزبان: ⌝'localhost'⌜,
	نام-کاربری: ⌝'xo'⌜,
	گذرواژه: ⌝'pass123'⌜,
	نام-پایگاه: ⌝'xobase'⌜,
	وصل-شو.
	
>> SQL := ⌝'SELECT "hello" AS "world" '⌜.

# ساختن دستی پرس‌وجو
>> پارامترهای-جستجو := پرس-و-جوی-Maria جدید: SQL.

# تنظیم پایگاه داده
پارامترهای-جستجو پایگاه-داده: پایگاه.

