Server init.

>> DB := Maria-DB جدید میزبان: ⌝'localhost'⌜,
	نام-کاربری: ⌝'xo'⌜,
	گذرواژه: ⌝'pass123'⌜,
	نام-پایگاه: ⌝'xobase'⌜,
	وصل-شو.
	
>> SQL := ⌝'SELECT "hello" AS "world" '⌜.

# manually create query
>> پارامترهای-جستجو := پرس-و-جوی-Maria جدید: SQL.

# set database
پارامترهای-جستجو پایگاه-داده: DB.

پارامترهای-جستجو واکشی: ⎬ :row
	خروجی بنویس: row world, سطر-نو.
⎨.
