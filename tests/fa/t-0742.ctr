خروجی بنویس: ⌝'Test object'⌜, سطر-نو.
>> a := شیء جدید. 

a هنگام: ⌝'item:'⌜ انجام: ⎬ :hexhelper
	خودم hexhelper := hexhelper. 
⎨.

a هنگام: ⌝'item'⌜ انجام: ⎬ <- خودم hexhelper.
⎨.

a item: شانزده-شانزدهی جدید.

>> old-hexhelper-address := a item پیش-نمونه نشانی-حافظه.
a save-as: ⌝'/tmp/a.bin'⌜.
خروجی بنویس: ⌝'========== RELOADING SNAP:'⌜, سطر-نو.

>> b := شیء load-from: ⌝'/tmp/a.bin'⌜.

﴿b item پیش-نمونه نشانی-حافظه = old-hexhelper-address﴾ اگر-درست: ⎬
	خروجی بنویس: ⌝'Object link re-attached.'⌜, سطر-نو.
⎨.
