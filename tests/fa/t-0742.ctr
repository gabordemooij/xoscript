خروجی بنویس: ⌝'شیء آزمایشی'⌜, سطر-نو.
>> a := شیء جدید. 

a هنگام: ⌝'item:'⌜ انجام: ⎬ :یاور-هگز
	خودم یاور-هگز := یاور-هگز. 
⎨.

a هنگام: ⌝'قلم'⌜ انجام: ⎬
	<- خودم یاور-هگز.
⎨.

a item: شانزده-شانزدهی جدید.

>> نشانی-قدیم-یاور-هگز := a قلم پیش-نمونه نشانی-حافظه.
a save-as: ⌝'/tmp/a.bin'⌜.
خروجی بنویس: ⌝'========== بارگذاری دوباره‌ی SNAP:'⌜, سطر-نو.

>> b := شیء load-from: ⌝'/tmp/a.bin'⌜.

﴿b قلم پیش-نمونه نشانی-حافظه = نشانی-قدیم-یاور-هگز﴾ اگر-درست: ⎬
	خروجی بنویس: ⌝'پیوند شیء دوباره وصل شد.'⌜, سطر-نو.
⎨.
