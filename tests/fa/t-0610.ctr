
>> نوع-مستطیل := شیء جدید.

نوع-مستطیل هنگام: ⌝'مساحت'⌜ انجام: ⎬
	<- خودم طول * خودم پهنا.
⎨.

نوع-مستطیل هنگام: ⌝'length:'⌜ انجام: ⎬ :طول
	خودم طول := طول.
⎨.

نوع-مستطیل هنگام: ⌝'width:'⌜ انجام: ⎬ :پهنا
	خودم پهنا := پهنا.
⎨.

نوع-مستطیل هنگام: ⌝'جدید'⌜ انجام: ⎬
	# این به حلقه بی‌پایان نمی‌انجامد
	>> مستطیل := خود جدید.
	مستطیل length: 0, width: 0.
	<- مستطیل.
⎨.

>> a := نوع-مستطیل جدید.
خروجی بنویس: a مساحت, سطر-نو. #0

>> b := نوع-مستطیل جدید length: 2, width: 3.
خروجی بنویس: b مساحت, سطر-نو. #6

