
>> Rectangle := شیء جدید.

Rectangle هنگام: ⌝'area'⌜ انجام: ⎬ <- خودم طول * خودم width.
⎨.

Rectangle هنگام: ⌝'length:'⌜ انجام: ⎬ :طول
	خودم طول := طول.
⎨.

Rectangle هنگام: ⌝'width:'⌜ انجام: ⎬ :width
	خودم width := width.
⎨.

Rectangle هنگام: ⌝'جدید'⌜ انجام: ⎬
	# this will not result into an infinite loop
	>> rectangle := خود جدید.
	rectangle length: 0, width: 0. <- rectangle.
⎨.

>> a := Rectangle جدید.
خروجی بنویس: a area, سطر-نو. #0

>> b := Rectangle جدید length: 2, width: 3.
خروجی بنویس: b area, سطر-نو. #6

