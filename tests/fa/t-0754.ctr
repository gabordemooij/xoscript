خروجی بنویس: ⌝'Test object'⌜, سطر-نو.
>> a := شیء جدید. 

a هنگام: ⌝'item:'⌜ انجام: ⎬ :out
	خودم out := out. 
⎨.

a هنگام: ⌝'item'⌜ انجام: ⎬ <- خودم out.
⎨.

a هنگام: ⌝'greet'⌜ انجام: ⎬
	خروجی بنویس: ⌝'hi from original out!'⌜, سطر-نو.
⎨.

a item: خروجی.

خروجی بنویس: a item, سطر-نو.

>> old-out-address := a item پیش-نمونه نشانی-حافظه.
a save-as: ⌝'/tmp/a.bin'⌜.
خروجی بنویس: ⌝'========== RELOADING SNAP:'⌜, سطر-نو.

>> b := شیء load-from: ⌝'/tmp/a.bin'⌜.

﴿b item پیش-نمونه نشانی-حافظه = old-out-address﴾ اگر-درست: ⎬
	خروجی بنویس: ⌝'Object link re-attached.'⌜, سطر-نو.
⎨.

b item بنویس: ⌝'hello from loaded out!'⌜, سطر-نو.
b greet.
