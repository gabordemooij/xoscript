


>> wine := شیء جدید.


wine هنگام: ⌝'toString'⌜ انجام: ⎬ <- ⌝'merlot'⌜.
⎨.

wine هنگام: ⌝'naarTekst'⌜ انجام: ⎬ <- ⌝'merlot'⌜.
⎨.


wine هنگام: ⌝'='⌜ انجام: ⎬ :other wine <- ﴿ خود toString = other wine ﴾.
⎨.

wine هنگام: ⌝'=='⌜ انجام: ⎬ :other wine <- ﴿ خود toString = other wine ﴾.
⎨.



wine
	حالت: ⌝'cabernet'⌜ انجام: ⎬ خروجی بنویس: ⌝'it's a Cabernet!'⌜. ⎨,
	حالت: ⌝'syrah'⌜    انجام: ⎬ خروجی بنویس: ⌝'it's a Syrah!'⌜.    ⎨,
	حالت: ⌝'merlot'⌜   انجام: ⎬ خروجی بنویس: ⌝'it's a Merlot!'⌜.   ⎨,
	حالت: ⌝'malbec'⌜   انجام: ⎬ خروجی بنویس: ⌝'it's a Malbec!'⌜.   ⎨.

