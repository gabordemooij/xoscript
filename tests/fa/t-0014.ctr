>> Greeter := شیء جدید.
Greeter هنگام: ⌝'make'⌜ انجام: ⎬
	>> gr := شیء جدید.
	gr هنگام: ⌝'setName:'⌜ انجام: ⎬ :aname
		خودم نام := aname.
	⎨.
	gr هنگام: ⌝'greet'⌜ انجام: ⎬
		خروجی بنویس: خودم نام.
	⎨. <- gr.
⎨.
>> a := Greeter make.
>> b := Greeter make.
a setName: ⌝'ONE'⌜.
b setName: ⌝'TWO'⌜.
a greet.
b greet.
>> c := a جدید.
c setName: ⌝'THREE'⌜.
c greet.
>> d := a جدید.
d setName: ⌝'FOUR'⌜.
d greet.
c greet.
