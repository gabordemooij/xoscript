>> نوع-خوشامدگو := شیء جدید.
نوع-خوشامدگو هنگام: ⌝'بساز'⌜ انجام: ⎬
	>> خگ := شیء جدید.
	خگ هنگام: ⌝'setName:'⌜ انجام: ⎬ :یک-نام
		خودم نام := یک-نام.
	⎨.
	خگ هنگام: ⌝'سلام-کن'⌜ انجام: ⎬
		خروجی بنویس: خودم نام.
	⎨. <- خگ.
⎨.
>> a := نوع-خوشامدگو بساز.
>> b := نوع-خوشامدگو بساز.
a setName: ⌝'ONE'⌜.
b setName: ⌝'دو'⌜.
a سلام-کن.
b سلام-کن.
>> c := a جدید.
c setName: ⌝'سه'⌜.
c سلام-کن.
>> d := a جدید.
d setName: ⌝'FOUR'⌜.
d سلام-کن.
c سلام-کن.
