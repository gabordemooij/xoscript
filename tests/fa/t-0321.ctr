# آزمون یکاها

برنامه پاکسازی.

>> میوه := شیء جدید.
میوه هنگام: ⌝'جدید'⌜ انجام: ⎬
	>> f := خود جدید.
	f apples: 0. <- f.
⎨.
میوه هنگام: ⌝'apples:'⌜ انجام: ⎬ :a خودم سیب-ها := a. ⎨.
میوه هنگام: ⌝'سیب-ها'⌜ انجام: ⎬ <- خودم سیب-ها. ⎨.
میوه هنگام: ⌝'+'⌜ انجام: ⎬ :f
	>> n := میوه جدید.
	n apples: ﴿f سیب-ها + خودم سیب-ها﴾. <- n.
⎨.
عدد هنگام: ⌝'سیب-ها'⌜ انجام: ⎬ <- ﴿﴿میوه جدید﴾ apples: خود﴾.
⎨.

میوه هنگام: ⌝'به-رشته'⌜ انجام: ⎬ <- خودم سیب-ها + ⌝' سیب '⌜.
⎨.

>> q := 3 سیب-ها + 4 سیب-ها.
خروجی بنویس: q, سطر-نو.




q := 3 سیب-ها + 4 سیب-ها.
خروجی بنویس: q, سطر-نو.



q := 3 سیب-ها + 4 سیب-ها.
خروجی بنویس: q, سطر-نو.


