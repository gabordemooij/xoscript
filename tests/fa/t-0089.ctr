>> randomizer := ⎬ :a :b
	>> کمینه := ﴿ a < b ﴾ یکی: a یا-دیگری: b.
	>> بیشینه := ﴿ a > b ﴾ یکی: a یا-دیگری: b.
	>> x := هیچ.
	⎬
		x := عدد بین: a تا: b.
		﴿﴿x < کمینه﴾ یا: ﴿x > بیشینه﴾﴾ اگر-درست: ⎬ 
			خروجی بنویس: ﴿⌝'Invalid value!'⌜﴾.
			برنامه پایان.
		⎨.
	⎨ 
	× 100. <- x.
⎨.
