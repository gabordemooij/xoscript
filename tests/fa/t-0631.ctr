#آزمون ffi


Server init.

برنامه مدیریت-حافظه: 4.

# برای این آزمون باید مسیری به libc (puts) تنظیم کنید
>> نام-کتابخانه := برنامه پیکربندی: ⌝'FFITESTLIB'⌜.



Server پیوند: ﴿
 لیست جدید ;
 نام-کتابخانه ;
 ⌝'puts'⌜ ;
 ﴿ لیست جدید ; ⌝'pointer'⌜ ﴾ ;
 ⌝'void'⌜ ;
 ⌝'Puts'⌜ ;
 ⌝'str:'⌜
﴾.

>> s := Blob utf8: ⌝'Hello from FFI!\n'⌜.

Puts str: s.
s آزاد-کن.

# آزمون با struct

>> a := Blob جدید: 8.
a بایت-ها: ﴿
	لیست <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
﴾.

>> struct := Blob struct: ﴿لیست <<: ⌝'int'⌜, ; ⌝'int'⌜﴾.

Server پیوند: ﴿
	لیست <<: ⌝'@structtest'⌜, ;
	⌝'@structtest'⌜ ;
	﴿لیست <<: struct﴾ ; 
	⌝'int'⌜ ;	
	⌝'ffitest'⌜ ;
	⌝'ffisum:'⌜
﴾.
	
خروجی بنویس: ⌝'آزمون جمع:'⌜ + ﴿ffitest ffisum: a﴾, سطر-نو.

struct آزاد-کن-struct.
struct آزاد-کن.
a آزاد-کن.
