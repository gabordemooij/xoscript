#ffi test


Server init.

برنامه مدیریت-حافظه: 4.

# for this test you need set a path to libc (puts)
>> libname := برنامه پیکربندی: ⌝'FFITESTLIB'⌜.



Server پیوند: ﴿
 لیست جدید ;
 libname ;
 ⌝'puts'⌜ ;
 ﴿ لیست جدید ; ⌝'pointer'⌜ ﴾ ;
 ⌝'void'⌜ ;
 ⌝'Puts'⌜ ;
 ⌝'str:'⌜
﴾.

>> s := Blob utf8: ⌝'Hello from FFI!\n'⌜.

Puts str: s.
s آزاد-کن.

# test with struct

>> a := Blob جدید: 8.
a بایت-ها: ﴿
	لیست <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
﴾.

>> struct := Blob struct: ﴿لیست <<: ⌝'int'⌜, ; ⌝'int'⌜﴾.

Server پیوند: ﴿
	لیست <<: ⌝'@structtest'⌜, ;
	⌝'@structtest'⌜ ;
	﴿لیست <<: struct﴾ ; 
	⌝'int'⌜ ;	
	⌝'ffitest'⌜ ;
	⌝'ffisum:'⌜
﴾.
	
خروجی بنویس: ⌝'Sum test:'⌜ + ﴿ffitest ffisum: a﴾, سطر-نو.

struct آزاد-کن-struct.
struct آزاد-کن.
a آزاد-کن.
