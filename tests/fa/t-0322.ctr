

>> Matryoshka := شیء جدید.
Matryoshka هنگام: ⌝'double:'⌜ انجام: ⎬ :secret
	خودم secret := secret × 2.
⎨.
Matryoshka هنگام: ⌝'جدید:'⌜ انجام: ⎬ :secret
	>> answer := هیچ.
	>> t := ﴿secret > 255﴾.
	خروجی بنویس: ﴿secret + ⌝' | '⌜ + t﴾, سطر-نو.
	t اگر-درست: ⎬
		answer := secret.
	⎨, وگرنه: ⎬
		answer := Matryoshka بازگشتی جدید: ﴿خود double: secret﴾.
	⎨. <- answer.
⎨.

>> x := Matryoshka جدید: 2.
