# compliance test

# use international numbers

خروجی بنویس: ⌝'1000 -> '⌜.
خروجی بنویس: 1000, سطر-نو. #1000

خروجی بنویس: ⌝'1.5 -> '⌜.
خروجی بنویس: 1.5, سطر-نو.  #1.5

خروجی بنویس: ⌝'1001.5 -> '⌜.
خروجی بنویس: 1.5 + 1000, سطر-نو. #1001.5

# use 0-indexed arrays
>> x := لیست جدید ; 1 ; 2 ; 3.
>> y := لیست جدید ; ⌝'a'⌜ ; ⌝'b'⌜ ; ⌝'c'⌜.

خروجی بنویس: ⌝'1 -> '⌜.
خروجی بنویس: x ? 0, سطر-نو. #1

خروجی بنویس: ⌝'1 -> '⌜.
خروجی بنویس: ﴿x در: 0﴾, سطر-نو. #1

خروجی بنویس: ⌝'1 -> '⌜.
خروجی بنویس: x نخست, سطر-نو. #1

خروجی بنویس: ⌝'3 -> '⌜.
خروجی بنویس: x آخری, سطر-نو. #3

خروجی بنویس: ⌝'(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '⌜.
خروجی بنویس: ﴿x بر-پایه: y﴾, سطر-نو.

خروجی بنویس: ⌝'1 -> '⌜.
خروجی بنویس: ﴿x آغاز: 0 طول: 1﴾ نخست, سطر-نو. #1

خروجی بنویس: ⌝'0 -> '⌜.
خروجی بنویس: ﴿x بیاب: 1﴾, سطر-نو. #0

x بگذار: 9 کلید: 0.

خروجی بنویس: ⌝'9 -> '⌜.
خروجی بنویس: ﴿x در: 0﴾, سطر-نو. #9

x بیفزا-به-آغاز: 8.
خروجی بنویس: ⌝'8 -> '⌜.
خروجی بنویس: ﴿x در: 0﴾, سطر-نو. #9


x بیفزا-به-پایان: 10.
خروجی بنویس: ⌝'10 -> '⌜.
خروجی بنویس: ﴿x در: 4﴾, سطر-نو. #10








