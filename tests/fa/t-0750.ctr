خروجی بنویس: ⌝'شیء آزمایشی'⌜, سطر-نو.
>> a := شیء جدید. 

a هنگام: ⌝'item:'⌜ انجام: ⎬ :هیچی
	خودم هیچی := هیچی. 
⎨.

a هنگام: ⌝'قلم'⌜ انجام: ⎬
	<- خودم هیچی.
⎨.

a item: هیچ.

خروجی بنویس: a قلم, سطر-نو.

>> نشانی-قدیم-هیچی := a قلم پیش-نمونه نشانی-حافظه.
a save-as: ⌝'/tmp/a.bin'⌜.
خروجی بنویس: ⌝'========== بارگذاری دوباره‌ی SNAP:'⌜, سطر-نو.

>> b := شیء load-from: ⌝'/tmp/a.bin'⌜.

﴿b قلم پیش-نمونه نشانی-حافظه = نشانی-قدیم-هیچی﴾ اگر-درست: ⎬
	خروجی بنویس: ⌝'پیوند شیء دوباره وصل شد.'⌜, سطر-نو.
⎨.

خروجی بنویس: b قلم, سطر-نو.
