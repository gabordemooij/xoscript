
>> countries := لیست جدید
	~ ⌝'Switzerland'⌜
	~ ⌝'Italy'⌜
	~ ⌝'Germany'⌜.

>> foods := لیست جدید
	~ ⌝'Rösti'⌜
	~ ⌝'Spaghetti'⌜
	~ ⌝'Sauerkraut'⌜.


>> counter := 0.
foods بر-پایه: countries, هرکدام: ⎬ :key :value
	counter بیفزا: 1.
⎨.

خروجی بنویس: ﴿⌝'we serve counter dishes'⌜ counter: counter﴾, سطر-نو.

>> counter := 42.
⌝'TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'⌜ نویسه-ها مرتب-کن: ⎬ :v
	counter بیفزا: 0.
⎨.

خروجی بنویس: ﴿⌝'we sort counter dishes'⌜ counter: counter﴾, سطر-نو.


>> counter := 0.
⎬
	⎬
		counter بیفزا: 1.
	⎨ × ﴿3 + 1 + 1 × 0.5﴾.
⎨ × 100.


خروجی بنویس: ﴿⌝'we calculate counter numbers.'⌜ counter: counter﴾, سطر-نو.

