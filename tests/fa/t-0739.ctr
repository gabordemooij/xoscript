خروجی بنویس: ⌝'Test object'⌜, سطر-نو.
>> a := شیء جدید. 

a هنگام: ⌝'item:'⌜ انجام: ⎬ :binhelper
	خودم binhelper := binhelper. 
⎨.

a هنگام: ⌝'item'⌜ انجام: ⎬ <- خودم binhelper.
⎨.

a item: دودویی جدید.

>> old-binhelper-address := a item پیش-نمونه نشانی-حافظه.
a save-as: ⌝'/tmp/a.bin'⌜.
خروجی بنویس: ⌝'========== RELOADING SNAP:'⌜, سطر-نو.

>> b := شیء load-from: ⌝'/tmp/a.bin'⌜.

﴿b item پیش-نمونه نشانی-حافظه = old-binhelper-address﴾ اگر-درست: ⎬
	خروجی بنویس: ⌝'Object link re-attached.'⌜, سطر-نو.
⎨.


