Server init.

# رمزگذار JSON فقط از UTF-8 پشتیبانی می‌کند، بدون جفت‌های جانشین

>> دیکشنری-ها := لیست جدید ;
	# {"key":"normal"} ASCII عادی
	﴿ واژه-نامه جدید بگذار: ⌝'عادی'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"hello world"} نویسه فاصله
	﴿ واژه-نامه جدید بگذار: ⌝'hello world'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"quote: \""} نقل‌قول دوتایی
	﴿ واژه-نامه جدید بگذار: ⌝'"'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"backslash: \\"} بک‌اسلش
	﴿ واژه-نامه جدید بگذار: ⌝'backslash: \\'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"slash: /"} اسلش
	﴿ واژه-نامه جدید بگذار: ⌝'اسلش: /'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"backspace: \b"} پس‌بر
	﴿ واژه-نامه جدید بگذار: ⌝'backspace: \b'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"formfeed: \f"} گریز form-feed
	﴿ واژه-نامه جدید بگذار: ⌝'formfeed: \f'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"newline: \n"} سطر نو
	﴿ واژه-نامه جدید بگذار: ⌝'newline: \n'⌜ کلید: ⌝'key'⌜ ﴾ ;
	﴿ واژه-نامه جدید بگذار: ⌝'newline: ↵'⌜ کلید: ⌝'key'⌜ ﴾ ;
	﴿ واژه-نامه جدید بگذار: ⌝'newline: 
	'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"carriage return: \r"} بازگشت نورد
	﴿ واژه-نامه جدید بگذار: ⌝'carriage return: \r'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"tab: \t"} تب
	﴿ واژه-نامه جدید بگذار: ⌝'tab \t'⌜ کلید: ⌝'key'⌜ ﴾ ;
	﴿ واژه-نامه جدید بگذار: ⌝'tab ⇿'⌜ کلید: ⌝'key'⌜ ﴾ ;
	﴿ واژه-نامه جدید بگذار: ⌝'tab  '⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u0000"} NUL
	﴿ واژه-نامه جدید بگذار: ⌝'NUL \u0000'⌜ کلید: ⌝'key'⌜ ﴾ ;
	﴿ واژه-نامه جدید بگذار: ⌝'NUL \0'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u0001"} نویسه کنترلی 0x01
	﴿ واژه-نامه جدید بگذار: ⌝'control: \u0001'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u001F"} نویسه کنترلی 0x1F
	﴿ واژه-نامه جدید بگذار: ⌝'control: \u001F'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: é"} UTF-8، نویسه 2 بایتی
	﴿ واژه-نامه جدید بگذار: ⌝'یونیکد: é'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: €"} UTF-8، نویسه 3 بایتی
	﴿ واژه-نامه جدید بگذار: ⌝'یونیکد: €'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 日本語"} چند نویسه UTF-8 سه بایتی
	﴿ واژه-نامه جدید بگذار: ⌝'یونیکد: 日本語'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 😀"} UTF-8، نویسه 4 بایتی
	﴿ واژه-نامه جدید بگذار: ⌝'یونیکد: 😀'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 🧑‍💻"} ایموجی + اتصال‌دهنده بی‌عرض
	﴿ واژه-نامه جدید بگذار: ⌝'یونیکد: 🧑‍💻'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"combining: é"} اعراب ترکیبی
	﴿ واژه-نامه جدید بگذار: ⌝'combining: e\u0301'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: é"} گریز یونیکد BMP
	﴿ واژه-نامه جدید بگذار: ⌝'escaped unicode: \u00e9'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: €"} گریز یونیکد BMP
	﴿ واژه-نامه جدید بگذار: ⌝'escaped unicode: \u20ac'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: 😀"} جفت جانشین UTF-16
	﴿ واژه-نامه جدید بگذار: ⌝'escaped unicode: \ud83d\ude00'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":""} مقدار خالی
	﴿ واژه-نامه جدید بگذار: ⌝''⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"@ < > & = % + ? #"} نویسه‌های ویژه ASCII
	﴿ واژه-نامه جدید بگذار: ⌝'@ < > & = % + ? #'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"single quote: '"} نقل‌قول تکی
	﴿ واژه-نامه جدید بگذار: ⌝'''⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"multiple: \" \\ \n \r \t"} چند گریز JSON
	﴿ واژه-نامه جدید بگذار: ⌝'multiple: \" \\ \n \r \t'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} رشته ASCII بلندتر
	﴿ واژه-نامه جدید بگذار: ⌝'aaaaaaaaaaaaaaaaaaaaaaaaaa'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":" value"} فاصله آغازین
	﴿ واژه-نامه جدید بگذار: ⌝' مقدار'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"value "} فاصله پایانی
	﴿ واژه-نامه جدید بگذار: ⌝'مقدار '⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":" \t\n\r "} فضای خالی
	﴿ واژه-نامه جدید بگذار: ⌝' \t\n\r '⌜ کلید: ⌝'key'⌜ ﴾
	.

دیکشنری-ها هرکدام: ⎬ :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: ﴿واژه-نامه جدید بگذار: d key کلید: ⌝'key'⌜﴾.
	>> b := JSON jsonify: ﴿واژه-نامه جدید بگذار: ⌝'value'⌜ کلید: d key﴾.
	>> e := JSON شیء: a.
	>> f := JSON شیء: b.
	﴿﴿e key = d key و: ﴿f ? d key = ⌝'value'⌜﴾﴾ یا: ﴿e key = ⌝'NUL ?'⌜﴾﴾ اگر-درست: ⎬
		خروجی بنویس: ⌝'OK'⌜, سطر-نو.
	⎨, وگرنه: ⎬
		خروجی بنویس: ⌝'رمزگذاری/رمزگشایی درست ممکن نیست: '⌜ + d + j, سطر-نو.
		برنامه پایان.
	⎨.
⎨.
