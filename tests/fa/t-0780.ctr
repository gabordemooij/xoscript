Server init.

# JSON encoder only supports UTF-8, no surrogate pairs

>> dicts := لیست جدید ;
	# {"key":"normal"} normal ASCII
	﴿ واژه-نامه جدید بگذار: ⌝'normal'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"hello world"} space character
	﴿ واژه-نامه جدید بگذار: ⌝'hello world'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"quote: \""} double quote
	﴿ واژه-نامه جدید بگذار: ⌝'"'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"backslash: \\"} backslash
	﴿ واژه-نامه جدید بگذار: ⌝'backslash: \\'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"slash: /"} slash
	﴿ واژه-نامه جدید بگذار: ⌝'slash: /'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"backspace: \b"} backspace
	﴿ واژه-نامه جدید بگذار: ⌝'backspace: \b'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"formfeed: \f"} form-feed escape
	﴿ واژه-نامه جدید بگذار: ⌝'formfeed: \f'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"newline: \n"} newline
	﴿ واژه-نامه جدید بگذار: ⌝'newline: \n'⌜ کلید: ⌝'key'⌜ ﴾ ;
	﴿ واژه-نامه جدید بگذار: ⌝'newline: ↵'⌜ کلید: ⌝'key'⌜ ﴾ ;
	﴿ واژه-نامه جدید بگذار: ⌝'newline: 
	'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"carriage return: \r"} carriage-return
	﴿ واژه-نامه جدید بگذار: ⌝'carriage return: \r'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"tab: \t"} tab
	﴿ واژه-نامه جدید بگذار: ⌝'tab \t'⌜ کلید: ⌝'key'⌜ ﴾ ;
	﴿ واژه-نامه جدید بگذار: ⌝'tab ⇿'⌜ کلید: ⌝'key'⌜ ﴾ ;
	﴿ واژه-نامه جدید بگذار: ⌝'tab  '⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u0000"} NUL
	﴿ واژه-نامه جدید بگذار: ⌝'NUL \u0000'⌜ کلید: ⌝'key'⌜ ﴾ ;
	﴿ واژه-نامه جدید بگذار: ⌝'NUL \0'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u0001"} control character 0x01
	﴿ واژه-نامه جدید بگذار: ⌝'control: \u0001'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u001F"} control character 0x1F
	﴿ واژه-نامه جدید بگذار: ⌝'control: \u001F'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: é"} UTF-8, 2-byte char
	﴿ واژه-نامه جدید بگذار: ⌝'unicode: é'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: €"} UTF-8, 3-byte char
	﴿ واژه-نامه جدید بگذار: ⌝'unicode: €'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 日本語"} multiple 3-byte UTF-8 chars
	﴿ واژه-نامه جدید بگذار: ⌝'unicode: 日本語'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 😀"} UTF-8, 4-byte char
	﴿ واژه-نامه جدید بگذار: ⌝'unicode: 😀'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	﴿ واژه-نامه جدید بگذار: ⌝'unicode: 🧑‍💻'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"combining: e\u0301"} combining accent
	﴿ واژه-نامه جدید بگذار: ⌝'combining: e\u0301'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: \u00e9"} Unicode escape BMP
	﴿ واژه-نامه جدید بگذار: ⌝'escaped unicode: \u00e9'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: \u20ac"} Unicode escape BMP
	﴿ واژه-نامه جدید بگذار: ⌝'escaped unicode: \u20ac'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: \ud83d\ude00"} UTF-16 surrogate pair
	﴿ واژه-نامه جدید بگذار: ⌝'escaped unicode: \ud83d\ude00'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":""} empty value
	﴿ واژه-نامه جدید بگذار: ⌝''⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"@ < > & = % + ? #"} special ASCII chars
	﴿ واژه-نامه جدید بگذار: ⌝'@ < > & = % + ? #'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"single quote: '"} single quote
	﴿ واژه-نامه جدید بگذار: ⌝'''⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"multiple: \" \\ \n \r \t"} multiple JSON escapes
	﴿ واژه-نامه جدید بگذار: ⌝'multiple: \" \\ \n \r \t'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} longer ASCII-string
	﴿ واژه-نامه جدید بگذار: ⌝'aaaaaaaaaaaaaaaaaaaaaaaaaa'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":" value"} leading space
	﴿ واژه-نامه جدید بگذار: ⌝' value'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"value "} trailing space
	﴿ واژه-نامه جدید بگذار: ⌝'value '⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":" \t\n\r "} whitespace
	﴿ واژه-نامه جدید بگذار: ⌝' \t\n\r '⌜ کلید: ⌝'key'⌜ ﴾.

dicts هرکدام: ⎬ :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: ﴿واژه-نامه جدید بگذار: d key کلید: ⌝'key'⌜﴾.
	>> b := JSON jsonify: ﴿واژه-نامه جدید بگذار: ⌝'value'⌜ کلید: d key﴾.
	>> e := JSON شیء: a.
	>> f := JSON شیء: b.
	﴿﴿e key = d key و: ﴿f ? d key = ⌝'value'⌜﴾﴾ یا: ﴿e key = ⌝'NUL ?'⌜﴾﴾ اگر-درست: ⎬
		خروجی بنویس: ⌝'OK'⌜, سطر-نو.
	⎨, وگرنه: ⎬
		خروجی بنویس: ⌝'Unable to properly encode/decode: '⌜ + d + j, سطر-نو.
		برنامه پایان.
	⎨.
⎨.
