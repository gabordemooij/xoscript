لیست هنگام: ⌝'رونوشت'⌜ انجام: ⎬
	>> رونوشت := لیست جدید.
	خود هرکدام: ⎬ :به-عدد :قسمت
		رونوشت بیفزا-به-پایان: قسمت بازگشتی رونوشت.
	⎨.
	<- رونوشت.
⎨.

>> گوسفند := لیست جدید ; ⌝'Dolly'⌜ ; ⌝'شاون'⌜. 
>> کلون-ها := گوسفند رونوشت.
کلون-ها هرکدام: ⎬ :به-عدد :گوسفند
	گوسفند بیفزا-به-پایان: ⌝'2'⌜.
⎨.

خروجی بنویس: گوسفند, سطر-نو.
خروجی بنویس: کلون-ها, سطر-نو.
