خروجی بنویس: ⌝'شیء آزمایشی'⌜, سطر-نو.
>> a := شیء جدید. 

a هنگام: ⌝'item:'⌜ انجام: ⎬ :به-بولی
	خودم به-بولی := به-بولی. 
⎨.

a هنگام: ⌝'قلم'⌜ انجام: ⎬
	<- خودم به-بولی.
⎨.

a item: درست.

خروجی بنویس: a قلم, سطر-نو.

>> نشانی-قدیم-بولی := a قلم پیش-نمونه نشانی-حافظه.
a save-as: ⌝'/tmp/a.bin'⌜.
خروجی بنویس: ⌝'========== بارگذاری دوباره‌ی SNAP:'⌜, سطر-نو.

>> b := شیء load-from: ⌝'/tmp/a.bin'⌜.

﴿b قلم پیش-نمونه نشانی-حافظه = نشانی-قدیم-بولی﴾ اگر-درست: ⎬
	خروجی بنویس: ⌝'پیوند شیء دوباره وصل شد.'⌜, سطر-نو.
⎨.

خروجی بنویس: b قلم, سطر-نو.
