# happy flow
>> s := ⌝'hello;"""world"""\n"of";"c\ns\nv"'⌜.
>> مسیر-پرونده := ⌝'/tmp/dat.csv'⌜.
>> csv := پرونده جدید: مسیر-پرونده.
csv بنویس: s.

# accepts CRLF LF CR, varying row length
csv جداکننده: ⌝';'⌜ نقل-قول: ⌝'"'⌜ سطرها: ⎬ :line
	برنامه پاکسازی.
	خروجی بنویس: line, سطر-نو.
	برنامه پاکسازی.
⎨.

# unequal lines
s بیفزا-به-پایان: ⌝'\njustone'⌜.
csv بنویس: s.
⎬
	csv جداکننده: ⌝';'⌜ نقل-قول: ⌝'"'⌜ سطرها: ⎬ :line
		خروجی بنویس: line, سطر-نو.
	⎨.
⎨ بگیر: ⎬ :e 
	خروجی بنویس: e, سطر-نو.
⎨, اجرا.

# invalid format
s := ⌝'"he"llo";world'⌜.
csv بنویس: s.
⎬
	csv جداکننده: ⌝';'⌜ نقل-قول: ⌝'"'⌜ سطرها: ⎬ :line
		خروجی بنویس: line, سطر-نو.
	⎨.
⎨ بگیر: ⎬ :e 
	خروجی بنویس: e, سطر-نو.
⎨, اجرا.
