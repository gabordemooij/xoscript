# کدگشایی از utf16le/be یا utf32le/be به utf8
Server init.
>> utf16 := Blob جدید: 8, بایت-ها: ﴿
	لیست جدید ; شانزده-شانزدهی x41 ; شانزده-شانزدهی x00 ; شانزده-شانزدهی x3D ; شانزده-شانزدهی xD8
	         ; شانزده-شانزدهی x0A ; شانزده-شانزدهی xDE ; شانزده-شانزدهی x42 ; شانزده-شانزدهی x00
﴾.

خروجی بنویس: ﴿ utf16 کدگشایی: ⌝'utf16le'⌜ ﴾, سطر-نو.

utf16 آزاد-کن.
>> utf32 := Blob جدید: 13, بایت-ها: ﴿
	لیست جدید ; شانزده-شانزدهی x00 ; شانزده-شانزدهی x00 ; شانزده-شانزدهی x00 ; شانزده-شانزدهی x41
	         ; شانزده-شانزدهی x00 ; شانزده-شانزدهی x01 ; شانزده-شانزدهی xF6 ; شانزده-شانزدهی x0A
	         ; شانزده-شانزدهی x00 ; شانزده-شانزدهی x00 ; شانزده-شانزدهی x00 ; شانزده-شانزدهی x42
	         ; شانزده-شانزدهی x00
﴾.

خروجی بنویس: ﴿ utf32 کدگشایی: ⌝'utf32be'⌜ ﴾, سطر-نو.
utf32 آزاد-کن.