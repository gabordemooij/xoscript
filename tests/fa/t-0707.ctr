# آزمون تبدیل نوع / تبدیل‌ها / پیوندها
برنامه مدیریت-حافظه: 4.
Server init.

>> شمارنده := 0.
>> پد := Maria-DB جدید میزبان: ⌝'localhost'⌜,
	نام-کاربری: ⌝'xo'⌜, گذرواژه: ⌝'pass123'⌜, نام-پایگاه: ⌝'xobase'⌜, وصل-شو.

>> قالب-دو-رقمی := قالب جدید: ⌝'%02d'⌜.

# تاریخ و زمان
⎬
	>> سال     := عدد بین: 1995 تا: 2050, به-رشته.
	>> ماه    := قالب-دو-رقمی اعمال-صحیح: ﴿عدد بین: 1 تا: 12﴾, به-رشته.
	>> روز      := قالب-دو-رقمی اعمال-صحیح: ﴿عدد بین: 1 تا: 28﴾, به-رشته.
	>> ساعت     := قالب-دو-رقمی اعمال-صحیح: ﴿عدد بین: 1 تا: 23﴾, به-رشته.
	>> دقیقه   := قالب-دو-رقمی اعمال-صحیح: ﴿عدد بین: 1 تا: 59﴾, به-رشته.
	>> ثانیه   := قالب-دو-رقمی اعمال-صحیح: ﴿عدد بین: 1 تا: 59﴾, به-رشته.
	>> تاریخ-زمان := ⌝'YYYY-MM-DD HH:II:SS'⌜.	
	تاریخ-زمان
		YYYY: سال,
		MM: ماه,
		DD: روز,
		HH: ساعت,
		II: دقیقه,
		SS: ثانیه.
	>> پارامترهای-جستجو :=
	پد پرس-و-جو: ﴿⌝'
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'⌜ <datetime>: تاریخ-زمان﴾,
	واکشی: ⎬ :سطر
		﴿سطر mydatetime = تاریخ-زمان﴾ اگر-نادرست: ⎬
			این-کار خطا: ﴿
				⌝'انتظار: <expected> اما دریافت شد: <observation>'⌜
				<expected>: تاریخ-زمان,
				<observation>: سطر mydatetime
			﴾.
		⎨.
	
	⎨.
	شمارنده بیفزا: 1.
⎨ * 100.

# تاریخ
⎬
	>> سال     := عدد بین: 1995 تا: 2050, به-رشته.
	>> ماه    := قالب-دو-رقمی اعمال-صحیح: ﴿عدد بین: 1 تا: 12﴾, به-رشته.
	>> روز      := قالب-دو-رقمی اعمال-صحیح: ﴿عدد بین: 1 تا: 28﴾, به-رشته.
	>> تاریخ     := ⌝'YYYY-MM-DD'⌜.
	تاریخ
		YYYY: سال,
		MM: ماه,
		DD: روز.
	>> پارامترهای-جستجو :=
	پد پرس-و-جو: ﴿⌝'
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'⌜ <date>: تاریخ﴾,
	واکشی: ⎬ :سطر
		﴿سطر mydate = تاریخ﴾ اگر-نادرست: ⎬
			این-کار خطا: ﴿
				⌝'انتظار: <expected> اما دریافت شد: <observation>'⌜
				<expected>: تاریخ,
				<observation>: سطر mydate
			﴾.
		⎨.
	⎨.
	شمارنده بیفزا: 1.
⎨ * 100.


# زمان
⎬
	>> ساعت     := قالب-دو-رقمی اعمال-صحیح: ﴿عدد بین: 1 تا: 23﴾, به-رشته.
	>> دقیقه   := قالب-دو-رقمی اعمال-صحیح: ﴿عدد بین: 1 تا: 59﴾, به-رشته.
	>> ثانیه   := قالب-دو-رقمی اعمال-صحیح: ﴿عدد بین: 1 تا: 59﴾, به-رشته.
	>> زمان := ⌝'HH:II:SS'⌜.
	زمان
		HH: ساعت,
		II: دقیقه,
		SS: ثانیه.
	>> پارامترهای-جستجو :=
	پد پرس-و-جو: ﴿⌝'
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'⌜ <time>: زمان﴾,
	واکشی: ⎬ :سطر
		﴿سطر mytime = زمان﴾ اگر-نادرست: ⎬
			این-کار خطا: ﴿
				⌝'انتظار: <expected> اما دریافت شد: <observation>'⌜
				<expected>: تاریخ-زمان,
				<observation>: سطر mytime
			﴾.
		⎨.
	⎨.
	شمارنده بیفزا: 1.
⎨ * 100.


# رشته‌ها (varchar/text)
>> str1 := لیست جدید پر-کن: 100000 با: ⌝'x'⌜, بپیوند: ⌝''⌜.
⎬
	>> str2 := گاوصندوق توکن: 40.
	>> پارامترهای-جستجو :=
	پد پرس-و-جو: ﴿⌝'
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'⌜ 
	<str1>: str1,
	<str2>: str2
	﴾,
	واکشی: ⎬ :سطر
		﴿سطر str1 = str1 و: سطر str2 = str2﴾ اگر-نادرست: ⎬
			این-کار خطا: ﴿
				⌝'انتظار: <expected> اما دریافت شد: <observation>'⌜
				<expected>: تاریخ-زمان,
				<observation>: سطر mytime
			﴾.
		⎨.
	⎨.
	شمارنده بیفزا: 1.
⎨ * 100.


# عددها
⎬
	>> n1  := عدد بین: 1 تا: 99999.
	>> n2  := n1 / 1000.
	>> big := ﴿
		﴿ Int64 از-رشته: ⌝'9223372036854775807'⌜ ﴾ -
		﴿ Int64 از-رشته: ⌝'99999'⌜ ﴾ +
		﴿ Int64 از-رشته: n1 به-رشته ﴾
	﴾.
	>> پارامترهای-جستجو :=
	پد پرس-و-جو: ﴿⌝'
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	'⌜
	<n1>: n1,
	<n2>: n2,
	<big>: big
	﴾,
	واکشی: ⎬ :سطر
		﴿سطر n1 = n1﴾ اگر-نادرست: ⎬
			این-کار خطا: ﴿
				⌝'انتظار: <expected> اما دریافت شد: <observation>'⌜
				<expected>: n1,
				<observation>: سطر n1
			﴾.
		⎨.
		﴿سطر n2 = n2﴾ اگر-نادرست: ⎬
			این-کار خطا: ﴿
				⌝'انتظار: <expected> اما دریافت شد: <observation>'⌜
				<expected>: n1,
				<observation>: سطر n2
			﴾.
		⎨.
		﴿سطر n3 = n2 گرد﴾ اگر-نادرست: ⎬
			این-کار خطا: ﴿
				⌝'انتظار: <expected> اما دریافت شد: <observation>'⌜
				<expected>: n1,
				<observation>: سطر n3
			﴾.
		⎨.
		﴿سطر big = big﴾ اگر-نادرست: ⎬
			این-کار خطا: ﴿
				⌝'انتظار: <expected> اما دریافت شد: <observation>'⌜
				<expected>: big,
				<observation>: سطر big
			﴾.
		⎨.
		
	⎨.
	شمارنده بیفزا: 1.
⎨ * 100.


خروجی بنویس: ﴿
	⌝'OK, <counter> fuzzy casts/conversions tested.'⌜
	<counter>: شمارنده
﴾, سطر-نو.