

>> g  := Server جدید.
>> v  := گاوصندوق جدید.
>> موفق := 0.

>> رازها := لیست جدید ; 
	 ⌝'aaa'⌜ ;
	 ⌝''⌜ ; 
	 ⌝'AB'⌜ ;
	 ⌝'abcdefghijklmnopqrstuvwxyz0123456789'⌜ ; 
	 ⌝'!@--+467hdHJKJs__=3hjsakd'⌜ ;
	 ⌝'spaces and	tabs'⌜ ;
	 ⌝'漢字'⌜ ;
	 ⌝'==[abc]=='⌜.
	
>> گذرواژه-ها := رازها رونوشت.
گذرواژه-ها هرکدام: ⎬ :i :p
	رازها هرکدام: ⎬ :n :s
		⎬
			>> رمزشده := v رمزگذاری: s کلید: p.
			>> رمزگشوده := v رمزگشایی: رمزشده کلید: p.
			﴿رمزگشوده = s﴾ اگر-درست: ⎬
				موفق بیفزا: 1.
			⎨, وگرنه: ⎬
				خروجی بنویس: ⌝'رمزگذاری/رمزگشایی ناموفق: '⌜, سطر-نو.
				خروجی بنویس: s, سطر-نو.
				خروجی بنویس: ⌝'رمزشده: '⌜ + رمزشده, سطر-نو.
				خروجی بنویس: ⌝'رمزگشوده: '⌜ + رمزشده, سطر-نو.
				برنامه پایان.
			⎨.
		⎨ بگیر: ⎬ :اشکال
			﴿s = ⌝''⌜ یا: p = ⌝''⌜﴾ اگر-درست: ⎬
				موفق بیفزا: 1.
			⎨, وگرنه: ⎬
				خروجی بنویس: اشکال, سطر-نو.
				برنامه پایان.
			⎨.
		⎨, اجرا.
	⎨.
⎨.

خروجی بنویس: ﴿ موفق + ⌝' رمزگذاری صندوقچه آزموده شد.'⌜ ﴾, سطر-نو.