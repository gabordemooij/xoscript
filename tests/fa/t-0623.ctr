

>> g := Server جدید.
>> v := گاوصندوق جدید.
>> ok := 0.

>> secrets := لیست جدید ; 
	 ⌝'aaa'⌜ ;
	 ⌝''⌜ ; 
	 ⌝'AB'⌜ ;
	 ⌝'abcdefghijklmnopqrstuvwxyz0123456789'⌜ ; 
	 ⌝'!@--+467hdHJKJs__=3hjsakd'⌜ ;
	 ⌝'spaces and	tabs'⌜ ;
	 ⌝'漢字'⌜ ;
	 ⌝'==[abc]=='⌜.
	
>> passwords := secrets رونوشت.
passwords هرکدام: ⎬ :i :p
	secrets هرکدام: ⎬ :n :s
		⎬
			>> encrypted := v رمزگذاری: s کلید: p.
			>> decrypted := v رمزگشایی: encrypted کلید: p.
			﴿decrypted = s﴾ اگر-درست: ⎬
				ok بیفزا: 1.
			⎨, وگرنه: ⎬
				خروجی بنویس: ⌝'failed encrypting/decrypting: '⌜, سطر-نو.
				خروجی بنویس: s, سطر-نو.
				خروجی بنویس: ⌝'encrypted: '⌜ + encrypted, سطر-نو.
				خروجی بنویس: ⌝'decrypted: '⌜ + encrypted, سطر-نو.
				برنامه پایان.
			⎨.
		⎨ بگیر: ⎬ :err
			﴿s = ⌝''⌜ یا: p = ⌝''⌜﴾ اگر-درست: ⎬
				ok بیفزا: 1.
			⎨, وگرنه: ⎬
				خروجی بنویس: err, سطر-نو.
				برنامه پایان.
			⎨.
		⎨, اجرا.
	⎨.
⎨.

خروجی بنویس: ﴿ ok + ⌝' vault encryptions tested.'⌜ ﴾, سطر-نو.