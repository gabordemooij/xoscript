# استفاده از FFI با افزونه Server

# اتصال به libc (وابسته به سکو)
>> نام-کتابخانه := برنامه پیکربندی: ⌝'FFITESTLIB'⌜.

# پیوند توابع stdio از c برای عملیات پیشرفته روی پرونده
Server پیوند: ﴿ لیست جدید ;
 نام-کتابخانه ; ⌝'fopen'⌜ ;
 ﴿ لیست جدید ; ⌝'pointer'⌜ ; ⌝'pointer'⌜﴾ ;
 ⌝'pointer'⌜ ;
 ⌝'Stream'⌜ ;
 ⌝'path:mode:'⌜
﴾,
پیوند: ﴿ لیست جدید ;
 هیچ ; # یعنی همان کتابخانه
 ⌝'fread'⌜ ;
 ﴿ لیست جدید ; ⌝'pointer'⌜ ; ⌝'int'⌜ ; ⌝'int'⌜ ; ⌝'pointer'⌜ ﴾ ;
 ⌝'int'⌜ ;
 هیچ ; # یعنی همان شیء (یعنی Stream)
 ⌝'fread'⌜
﴾,
پیوند: ﴿
 لیست جدید ;
 هیچ ; # یعنی همان کتابخانه
 ⌝'fwrite'⌜ ;
 ﴿ لیست جدید ; ⌝'pointer'⌜ ; ⌝'int'⌜ ; ⌝'int'⌜ ; ⌝'pointer'⌜ ﴾ ;
 ⌝'int'⌜ ;
 هیچ ; # یعنی همان کتابخانه
 ⌝'fwrite'⌜
﴾,
پیوند: ﴿
 لیست جدید ;
 هیچ ; # یعنی همان کتابخانه
 ⌝'rewind'⌜ ;
 ﴿ لیست جدید ; ⌝'pointer'⌜ ﴾ ;
 ⌝'int'⌜ ;
 هیچ ; # یعنی همان کتابخانه
 ⌝'rewind:'⌜
﴾.

>> str  := Blob utf8: ⌝'abc123'⌜.
>> مسیر-پرونده := Blob utf8: ⌝'/tmp/bla.txt'⌜.
>> mode := Blob utf8: ⌝'w+'⌜.

# باز کردن یک پرونده با fopen(path, mode)
>> fd := Stream path: مسیر-پرونده mode: mode.

# نوشتن بایت‌ها از بافر str در پرونده
>> بایت-های-نوشته := Stream پیام: ⌝'fwrite'⌜ آرگومان-ها: ﴿لیست جدید ; str ; 1 ; 6 ; fd ﴾.
خروجی بنویس: بایت-های-نوشته, سطر-نو.

# برگرداندن اشاره‌گر پرونده به آغاز
Stream rewind: fd.

# تخصیص یک بافر
>> باف := Blob جدید: 20.

# خواندن از پرونده
>> بایت-های-خوانده := Stream پیام: ⌝'fread'⌜ آرگومان-ها: ﴿لیست جدید ; باف ; 1 ; 6 ; fd ﴾.
خروجی بنویس: بایت-های-خوانده, سطر-نو.
خروجی بنویس: باف, سطر-نو.

# آزاد کردن حافظه
str  آزاد-کن.
مسیر-پرونده آزاد-کن.
mode آزاد-کن.
باف  آزاد-کن.


