خروجی بنویس: ⌝'Test object'⌜, سطر-نو.
>> a := شیء جدید. 

a هنگام: ⌝'item:'⌜ انجام: ⎬ :octhelper
	خودم octhelper := octhelper. 
⎨.

a هنگام: ⌝'item'⌜ انجام: ⎬ <- خودم octhelper.
⎨.

a item: هشت-هشتی جدید.

>> old-octhelper-address := a item پیش-نمونه نشانی-حافظه.
a save-as: ⌝'/tmp/a.bin'⌜.
خروجی بنویس: ⌝'========== RELOADING SNAP:'⌜, سطر-نو.

>> b := شیء load-from: ⌝'/tmp/a.bin'⌜.

﴿b item پیش-نمونه نشانی-حافظه = old-octhelper-address﴾ اگر-درست: ⎬
	خروجی بنویس: ⌝'Object link re-attached.'⌜, سطر-نو.
⎨.
