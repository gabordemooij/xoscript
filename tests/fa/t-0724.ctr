خروجی بنویس: ⌝'Test object'⌜, سطر-نو.
>> a := شیء جدید. 

a هنگام: ⌝'item:'⌜ انجام: ⎬ :file
	خودم file := file. 
⎨.

a هنگام: ⌝'item'⌜ انجام: ⎬ <- خودم file.
⎨.

>> f := پرونده جدید: ⌝'/tmp/aaa.txt'⌜.
a item: f.
خروجی بنویس: a item, سطر-نو.
a save-as: ⌝'/tmp/a.bin'⌜.
خروجی بنویس: ⌝'========== RELOADING SNAP:'⌜, سطر-نو.
>> b := شیء load-from: ⌝'/tmp/a.bin'⌜.
خروجی بنویس: b item, سطر-نو.
