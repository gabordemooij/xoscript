خروجی بنویس: ⌝'شیء آزمایشی'⌜, سطر-نو.
>> a := شیء جدید. 

a هنگام: ⌝'item:'⌜ انجام: ⎬ :file
	خودم file := file. 
⎨.

a هنگام: ⌝'قلم'⌜ انجام: ⎬
	<- خودم file.
⎨.

>> f := پرونده جدید: ⌝'/tmp/aaa.txt'⌜.
a item: f.
خروجی بنویس: a قلم, سطر-نو.
a save-as: ⌝'/tmp/a.bin'⌜.
خروجی بنویس: ⌝'========== بارگذاری دوباره‌ی SNAP:'⌜, سطر-نو.
>> b := شیء load-from: ⌝'/tmp/a.bin'⌜.
خروجی بنویس: b قلم, سطر-نو.
