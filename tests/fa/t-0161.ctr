برنامه مدیریت-حافظه: 0.
لیست هنگام: ⌝'مجموع'⌜ انجام: ⎬
	>> جمع-کل := 0.
	خود هرکدام: ⎬ :اندیس :عنصر
		جمع-کل بیفزا: عنصر.
	⎨. <- جمع-کل.
⎨.

>> حافظه-مصرفی1 := 0.
>> حافظه-مصرفی2 := 0.
>> حافظه-مصرفی3 := 0.
>> حافظه-مصرفی4 := 0.



>> f := پرونده جدید: ⌝'/tmp/test.txt'⌜.
f بنویس: ⌝'Lorem Ipsum'⌜.
f ببند.
  

f := پرونده جدید: ⌝'/tmp/test.txt'⌜.
