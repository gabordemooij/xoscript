# آزمون تجزیه url

Server init.
>> url := URL از: ⌝'https://xoscript.com:1234/a/b/c?test=1#hello'⌜.

خروجی بنویس: ⌝'طرح = '⌜ + url طرح, سطر-نو.
خروجی بنویس: ⌝'میزبان = '⌜ + url میزبان, سطر-نو.
خروجی بنویس: ⌝'درگاه = '⌜ + url درگاه, سطر-نو.
خروجی بنویس: ⌝'مسیر = '⌜ + url مسیر-پرونده, سطر-نو.
خروجی بنویس: ⌝'پرس‌وجو = '⌜ + url پارامترهای-جستجو, سطر-نو.
خروجی بنویس: ⌝'قطعه = '⌜ + url تکه, سطر-نو.
