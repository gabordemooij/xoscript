# test url parsing

Server init.
>> url := URL از: ⌝'https://xoscript.com:1234/a/b/c?test=1#hello'⌜.

خروجی بنویس: ⌝'scheme = '⌜ + url طرح, سطر-نو.
خروجی بنویس: ⌝'host = '⌜ + url میزبان, سطر-نو.
خروجی بنویس: ⌝'port = '⌜ + url درگاه, سطر-نو.
خروجی بنویس: ⌝'path = '⌜ + url مسیر-پرونده, سطر-نو.
خروجی بنویس: ⌝'query = '⌜ + url پارامترهای-جستجو, سطر-نو.
خروجی بنویس: ⌝'fragment = '⌜ + url تکه, سطر-نو.
