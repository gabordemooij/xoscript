خروجی بنویس: ⌝'شیء آزمایشی'⌜, سطر-نو.
>> a := شیء جدید. 

a هنگام: ⌝'item:'⌜ انجام: ⎬ :num
	خودم num := num. 
⎨.

a هنگام: ⌝'قلم'⌜ انجام: ⎬
	<- خودم num.
⎨.

a item: 123.

خروجی بنویس: a قلم, سطر-نو.

>> نشانی-قدیم-عددک := a قلم پیش-نمونه نشانی-حافظه.
a save-as: ⌝'/tmp/a.bin'⌜.
خروجی بنویس: ⌝'========== بارگذاری دوباره‌ی SNAP:'⌜, سطر-نو.

>> b := شیء load-from: ⌝'/tmp/a.bin'⌜.

﴿b قلم پیش-نمونه نشانی-حافظه = نشانی-قدیم-عددک﴾ اگر-درست: ⎬
	خروجی بنویس: ⌝'پیوند شیء دوباره وصل شد.'⌜, سطر-نو.
⎨.

خروجی بنویس: b قلم, سطر-نو.
