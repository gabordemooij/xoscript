خروجی بنویس: ⌝'Test object'⌜, سطر-نو.
>> a := شیء جدید. 

a هنگام: ⌝'item:'⌜ انجام: ⎬ :num
	خودم num := num. 
⎨.

a هنگام: ⌝'item'⌜ انجام: ⎬ <- خودم num.
⎨.

a item: 123.

خروجی بنویس: a item, سطر-نو.

>> old-num-address := a item پیش-نمونه نشانی-حافظه.
a save-as: ⌝'/tmp/a.bin'⌜.
خروجی بنویس: ⌝'========== RELOADING SNAP:'⌜, سطر-نو.

>> b := شیء load-from: ⌝'/tmp/a.bin'⌜.

﴿b item پیش-نمونه نشانی-حافظه = old-num-address﴾ اگر-درست: ⎬
	خروجی بنویس: ⌝'Object link re-attached.'⌜, سطر-نو.
⎨.

خروجی بنویس: b item, سطر-نو.
