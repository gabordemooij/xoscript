#Linux
>> clock := لحظه جدید.
clock منطقه-زمانی: ⌝'UTC-1'⌜.
clock سال: 1981, ماه: 1, روز: 5,
      ساعت: 13, دقیقه: 15, ثانیه: 13.

خروجی بنویس: clock, سطر-نو.
clock منطقه-زمانی: ⌝'UTC+0'⌜.

خروجی بنویس: ﴿
	﴿clock سال ساده﴾ + ⌝'-'⌜ + ﴿clock ماه﴾ + ⌝'-'⌜ + ﴿clock روز﴾ + ⌝' '⌜ +
	﴿clock ساعت﴾ + ⌝':'⌜ + ﴿clock دقیقه﴾ + ⌝':'⌜ + ﴿clock ثانیه﴾ + ⌝' '⌜ +
	⌝'W'⌜ + ﴿clock هفته﴾ + ﴿clock منطقه-زمانی﴾
﴾, سطر-نو.


clock منطقه-زمانی: ⌝'UTC-1'⌜.
خروجی بنویس: ﴿
	﴿clock سال ساده﴾ + ⌝'-'⌜ + ﴿clock ماه﴾ + ⌝'-'⌜ + ﴿clock روز﴾ + ⌝' '⌜ +
	﴿clock ساعت﴾ + ⌝':'⌜ + ﴿clock دقیقه﴾ + ⌝':'⌜ + ﴿clock ثانیه﴾ + ⌝' '⌜ +
	⌝'W'⌜ + ﴿clock هفته﴾ + ﴿clock منطقه-زمانی﴾
﴾, سطر-نو.
