لیست هنگام: ⌝'مجموع'⌜ انجام: ⎬
	>> جمع-کل := 0.
	خود هرکدام: ⎬ :اندیس :عنصر
		جمع-کل بیفزا: عنصر.
	⎨. <- جمع-کل.
⎨.

>> a := درست.



a هنگام: ⌝'به-رشته'⌜ انجام: ⎬
	>> جواب := هیچ.
	﴿ خود = درست ﴾ اگر-درست: ⎬
		جواب := ⌝'اوهوم'⌜.
	⎨, وگرنه: ⎬
		جواب := ⌝'نُچ'⌜.
	⎨. <- جواب.
⎨.

a هنگام: ⌝'به-عدد'⌜ انجام: ⎬
	>> جواب := هیچ.
	﴿ خود = درست ﴾ اگر-درست: ⎬
		جواب := 10.
	⎨, وگرنه: ⎬
		جواب := 20.
	⎨. <- جواب.
⎨.

>> b := 666.

b هنگام: ⌝'به-رشته'⌜ انجام: ⎬ <- ⌝'شیطان'⌜.
⎨.

b هنگام: ⌝'به-بولی'⌜ انجام: ⎬ <- نادرست.
⎨.


خروجی بنویس: a, سطر-نو.  
خروجی بنویس: ﴿90 + a﴾, سطر-نو. 
خروجی بنویس: b, سطر-نو. 
خروجی بنویس: ﴿درست و: b﴾, سطر-نو.

a := لیست ← ⌝'hello'⌜ ; ⌝'world'⌜ ; درست ; هیچ ; 666. 
a := a + ﴿ لیست ← 1 ﴾.
خروجی بنویس: a, سطر-نو.
خروجی بنویس: ﴿﴿واژه-نامه جدید﴾ بگذار: هیچ کلید: هیچ﴾, سطر-نو.
خروجی بنویس: a مجموع, سطر-نو. 


⎬
	a هنگام: ⌝'به-رشته'⌜ انجام: ⎬ <- هیچ. ⎨.
