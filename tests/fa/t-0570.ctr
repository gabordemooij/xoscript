#Linux

 >> t := لحظه جدید.
 
t منطقه-زمانی: ⌝'Europe/Amsterdam'⌜.
t سال: 2020, ماه: 8, روز: 2, ساعت: 21, دقیقه: 2, ثانیه: 1.

>> a := t ساعت.
>> ams := t منطقه-زمانی.

t منطقه-زمانی: ⌝'US/Hawaii'⌜.
>> b := t ساعت.
>> hw := t منطقه-زمانی.

خروجی
بنویس: ﴿
	⌝'It's diff in zone2 than in zone1'⌜
	zone1: ams,
	zone2: hw,
	diff: ﴿
		﴿b > a﴾
		یکی: ⌝'دیرتر'⌜ یا-دیگری: ⌝'زودتر'⌜
	﴾
﴾,
سطر-نو.
 