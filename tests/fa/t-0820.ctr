# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := ⎬ :pattern :subject
	>> p := الگو جدید: pattern.
	p تطبیق: subject انجام: ⎬ :m :g
		خروجی بنویس: g تعداد, بنویس: ⌝' '⌜, بنویس: ﴿g بپیوند: ⌝'|'⌜﴾, سطر-نو. <- m.
	⎨.
⎨.
show اعمال: ⌝'(a)|(b)'⌜ و: ⌝'b'⌜.
show اعمال: ⌝'(a)|(b)'⌜ و: ⌝'a'⌜.
show اعمال: ⌝'(x)?y'⌜ و: ⌝'y'⌜.
show اعمال: ⌝'(x)?(y)(z)?'⌜ و: ⌝'xy'⌜.
