خروجی بنویس: ⌝'Test object'⌜, سطر-نو.
>> a := شیء جدید. 

a هنگام: ⌝'item:'⌜ انجام: ⎬ :moment
	خودم moment := moment. 
⎨.

a هنگام: ⌝'item'⌜ انجام: ⎬ <- خودم moment.
⎨.

>> today := لحظه جدید منطقه-زمانی: ⌝'CEST'⌜, سال: 2026, ماه: 7.
a item: today.
خروجی بنویس: a item, سطر-نو.
a save-as: ⌝'/tmp/a.bin'⌜.
خروجی بنویس: ⌝'========== RELOADING SNAP:'⌜, سطر-نو.
>> b := شیء load-from: ⌝'/tmp/a.bin'⌜.
خروجی بنویس: b item, سطر-نو.
