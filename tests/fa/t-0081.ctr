>> map1 := واژه-نامه جدید.
>> key1 := لیست جدید.
>> key2 := لیست جدید.

map1
	بگذار: ⌝'hello'⌜ کلید: key1,
	بگذار: ⌝'world'⌜ کلید: key2.


خروجی
	بنویس: ⌝'Map #1 contains: '⌜ + ﴿map1 در: key1﴾,
	بنویس: ⌝' and '⌜ + ﴿map1 در: key2﴾, سطر-نو.

>> KeyeableArray := لیست جدید.
KeyeableArray هنگام: ⌝'toString'⌜ انجام: ⎬ <- ﴿خود تعداد﴾ toString.
⎨.

>> map2 := واژه-نامه جدید.
key1 := KeyeableArray جدید.
key2 := KeyeableArray جدید.

key1 بیفزا-به-پایان: 1.

map2
	بگذار: ⌝'hello'⌜ کلید: key1,
	بگذار: ⌝'world'⌜ کلید: key2.

خروجی
	بنویس: ⌝'Map #2 contains: '⌜ + ﴿map2 در: key1﴾,
	بنویس: ⌝' and '⌜ + ﴿map2 در: key2﴾, سطر-نو.
