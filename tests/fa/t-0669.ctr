# درهم‌سازی گذرواژه
Server init.

# کاربر یک گذرواژه تعیین می‌کند
>> گذرو := ⌝'pass123'⌜.

# آن را این‌گونه ذخیره می‌کنید
>> هش := گاوصندوق 
	درهم-گذرواژه: گذرو.

# سپس کاربر وارد می‌شود
# تلاش 1
>> a1 := ⌝'abcd123'⌜.
# تلاش 2
>> a2 := ⌝'pass123'⌜.

# راستی‌آزمایی
>> a := گاوصندوق 
	درهم-گذرواژه: هش راستی-آزمایی: a1.
	# ناموفق 
>> b := گاوصندوق
	درهم-گذرواژه: هش راستی-آزمایی: a2.
	# موفق!

خروجی بنویس: a, سطر-نو.
خروجی بنویس: b, سطر-نو.

