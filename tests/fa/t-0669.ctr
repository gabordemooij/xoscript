# Password hashing
Server init.

# User sets a password
>> passw := ⌝'pass123'⌜.

# You store it like this
>> hash := گاوصندوق 
	درهم-گذرواژه: passw.

# Then, user logs in
# Attempt 1
>> a1 := ⌝'abcd123'⌜.
# Attempt 2
>> a2 := ⌝'pass123'⌜.

# Verify
>> a := گاوصندوق 
	درهم-گذرواژه: hash راستی-آزمایی: a1.
	# fail 
>> b := گاوصندوق
	درهم-گذرواژه: hash راستی-آزمایی: a2.
	# ok!

خروجی بنویس: a, سطر-نو.
خروجی بنویس: b, سطر-نو.

