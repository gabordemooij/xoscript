# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := گاوصندوق تولید-کلید.

# private (secret) key
>> sk := keys نخست.

# public key
>> pk := keys آخری.

# sign a message
>> sig := گاوصندوق امضا: ⌝'abc'⌜ با: sk.

# check message (ok)
خروجی بنویس: ﴿ 
	گاوصندوق
		بررسی: ⌝'abc'⌜ 
		امضا: sig 
		با: pk 
﴾, سطر-نو.

# check message (fail)
خروجی بنویس: ﴿ 
	گاوصندوق 
		بررسی: ⌝'abd'⌜ 
		امضا: sig 
		با: pk 
﴾, سطر-نو.