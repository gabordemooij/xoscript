# کلید عمومی (برای ایمن‌سازی APIها و غیره)
Server init.

# تولید جفت-کلید
>> جفت-کلید := گاوصندوق تولید-کلید.

# کلید خصوصی (محرمانه)
>> sk := جفت-کلید نخست.

# کلید عمومی
>> pk := جفت-کلید آخری.

# امضای یک پیام
>> امضا := گاوصندوق امضا: ⌝'abc'⌜ با: sk.

# بررسی پیام (موفق)
خروجی بنویس: ﴿ 
	گاوصندوق
		بررسی: ⌝'abc'⌜ 
		امضا: امضا 
		با: pk 
﴾, سطر-نو.

# بررسی پیام (ناموفق)
خروجی بنویس: ﴿ 
	گاوصندوق 
		بررسی: ⌝'abd'⌜ 
		امضا: امضا 
		با: pk 
﴾, سطر-نو.