Server init.

خروجی بنویس: ﴿
	الگو جدید: ⌝'^\\w+$'⌜,
	تطبیق: ⌝'test@example.com'⌜ 
﴾, سطر-نو. # 0 تطابق، روی @ و . شکست می‌خورد

خروجی بنویس: ﴿
	الگو جدید: ⌝'^[^@]+@[^\.]+\.\\w+$'⌜,
	تطبیق: ⌝'test@example.com'⌜ 
﴾, سطر-نو. # 1 تطابق

خروجی بنویس: ﴿
	الگو جدید: ⌝'[^@]+@[^\.]+\.\\w+'⌜,
	تطبیق: ⌝'test@example.com'⌜ 
﴾, سطر-نو. # 1 تطابق

خروجی بنویس: ﴿
	الگو جدید: ⌝'([^@]+)@([^\.]+)\.\\w+'⌜,
	تطبیق: ⌝'test@example.com'⌜ 
﴾, سطر-نو. # 1 تطابق، گروه‌ها مهم نیستند

خروجی بنویس: ﴿
	الگو جدید: ⌝'[a-z]'⌜,
	تطبیق: ⌝'test@example.com'⌜ 
﴾, سطر-نو. # 14 تطابق

خروجی بنویس: ﴿
	الگو جدید: ⌝'.*'⌜,
	تطبیق: ⌝'test@example.com'⌜ 
﴾, سطر-نو. # 1 تطابق (همه)

خروجی بنویس: ﴿
	الگو جدید: ⌝'(.*)'⌜,
	تطبیق: ⌝'test@example.com'⌜ 
﴾, سطر-نو. # 1 تطابق (همه)

خروجی بنویس: ﴿
	الگو جدید: ⌝'\\s*[^@]+@[^\.]+\.\\w+'⌜,
	تطبیق: ⌝'test@example.com'⌜ 
﴾, سطر-نو. # 1 تطابق، فاصله پیشوند اختیاری است و نادیده گرفته می‌شود