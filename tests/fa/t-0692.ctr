Server init.

خروجی بنویس: ﴿
	الگو جدید: ⌝'^\\w+$'⌜,
	تطبیق: ⌝'test@example.com'⌜ 
﴾, سطر-نو. # 0 match, fails on @ and .

خروجی بنویس: ﴿
	الگو جدید: ⌝'^[^@]+@[^\.]+\.\\w+$'⌜,
	تطبیق: ⌝'test@example.com'⌜ 
﴾, سطر-نو. # 1 match

خروجی بنویس: ﴿
	الگو جدید: ⌝'[^@]+@[^\.]+\.\\w+'⌜,
	تطبیق: ⌝'test@example.com'⌜ 
﴾, سطر-نو. # 1 match

خروجی بنویس: ﴿
	الگو جدید: ⌝'([^@]+)@([^\.]+)\.\\w+'⌜,
	تطبیق: ⌝'test@example.com'⌜ 
﴾, سطر-نو. # 1 match, groups dont matter

خروجی بنویس: ﴿
	الگو جدید: ⌝'[a-z]'⌜,
	تطبیق: ⌝'test@example.com'⌜ 
﴾, سطر-نو. # 14 matches

خروجی بنویس: ﴿
	الگو جدید: ⌝'.*'⌜,
	تطبیق: ⌝'test@example.com'⌜ 
﴾, سطر-نو. # 1 match (all)

خروجی بنویس: ﴿
	الگو جدید: ⌝'(.*)'⌜,
	تطبیق: ⌝'test@example.com'⌜ 
﴾, سطر-نو. # 1 match (all)

خروجی بنویس: ﴿
	الگو جدید: ⌝'\\s*[^@]+@[^\.]+\.\\w+'⌜,
	تطبیق: ⌝'test@example.com'⌜ 
﴾, سطر-نو. # 1 match, prefix space optional, gets ignored