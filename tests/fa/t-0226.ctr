# آزمون گونه‌های ASCII

# عددها

خروجی بنویس: ﴿2 !=: 3﴾, سطر-نو.
خروجی بنویس: ﴿2 <=: 2﴾, سطر-نو.
خروجی بنویس: ﴿2 >=: 2﴾, سطر-نو.

# رشته‌ها

خروجی بنویس: ﴿⌝'b'⌜ >=: ⌝'a'⌜﴾, سطر-نو.
خروجی بنویس: ﴿⌝'b'⌜ !=: ⌝'a'⌜﴾, سطر-نو.
خروجی بنویس: ﴿⌝'b'⌜ <=: ⌝'c'⌜﴾, سطر-نو.

# بولی‌ها

خروجی بنویس: ﴿درست !=: نادرست﴾, سطر-نو.

# شیءها

خروجی بنویس: ﴿شیء جدید !=: شیء جدید﴾, سطر-نو.

# نماد لیست در ASCII <-:

خروجی بنویس: ﴿لیست <<: 1, ; 2 ; 3﴾ تعداد = 3, سطر-نو.

