Server init.

>> پایگاه := Maria-DB جدید میزبان: ⌝'localhost'⌜,
	نام-کاربری: ⌝'xo'⌜,
	گذرواژه: ⌝'pass123'⌜,
	نام-پایگاه: ⌝'xobase'⌜,
	وصل-شو.
	
>> SQL := ⌝'SELECT "hello" AS "world" '⌜.

# راه سریع‌تر، گرفتن پرس‌وجو از پایگاه:
>> پرس-و-جو2 := پایگاه پرس-و-جو: SQL.

# اکنون لازم نیست پایگاه را تنظیم کنید
پرس-و-جو2 واکشی: ⎬ :سطر
	خروجی بنویس: سطر world, سطر-نو.
⎨.
