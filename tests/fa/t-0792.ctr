Server init.

>> DB := Maria-DB جدید میزبان: ⌝'localhost'⌜,
	نام-کاربری: ⌝'xo'⌜,
	گذرواژه: ⌝'pass123'⌜,
	نام-پایگاه: ⌝'xobase'⌜,
	وصل-شو.
	
>> SQL := ⌝'SELECT "hello" AS "world" '⌜.

# a quicker way, get query from DB:
>> query2 := DB پرس-و-جو: SQL.

# now you don't have to set DB
query2 واکشی: ⎬ :row
	خروجی بنویس: row world, سطر-نو.
⎨.
