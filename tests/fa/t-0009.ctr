>> Greeter := شیء جدید.
Greeter هنگام: ⌝'make'⌜ انجام: ⎬
	>> greeter := شیء جدید.
	greeter هنگام: ⌝'name:'⌜ انجام: ⎬ :نام
		خروجی بنویس: ⌝'setting a name'⌜.
		خودم myName := نام.
	⎨.
	greeter هنگام: ⌝'performGreeting'⌜ انجام: ⎬
		خروجی بنویس: ⌝'Hello'⌜.
		خروجی بنویس: خودم myName.
	⎨.
	greeter هنگام: ⌝'greet'⌜ انجام: ⎬
		خود performGreeting.
	⎨. <- greeter.
⎨.
>> greeter := Greeter make.
greeter name: ⌝'sunshine!'⌜.
greeter greet.
