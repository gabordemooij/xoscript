

لیست هنگام: ⌝'sum'⌜ انجام: ⎬
	>> total := 0.
	خود هرکدام: ⎬ :index :element
		total بیفزا: element.
	⎨. <- total.
⎨.

لیست هنگام: ⌝'product'⌜ انجام: ⎬
	>> total := 1.
	خود هرکدام: ⎬ :index :element
		total ضرب-در: element.
	⎨. <- total.
⎨.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

برنامه مدیریت-حافظه: 0.

⎬

>> a := لیست ← ⌝'hello'⌜ ; ⌝'world'⌜ ; درست ; هیچ ; 666.
a := a + ﴿ لیست ← 1 ﴾.
خروجی بنویس: ﴿ ⌝'sum: '⌜ + ﴿ a sum ﴾ ﴾, سطر-نو.
خروجی بنویس: ﴿ ⌝'min: '⌜ + ﴿ a کمینه ﴾ ﴾, سطر-نو.
خروجی بنویس: ﴿ ⌝'max: '⌜ + ﴿ a بیشینه ﴾ ﴾, سطر-نو.
خروجی بنویس: ﴿ ⌝'3rd: '⌜ + ﴿ a ? 2 ﴾ ﴾, سطر-نو.
خروجی بنویس: ﴿ ⌝'prd: '⌜ + ﴿ a product ﴾ ﴾, سطر-نو.
a مرتب-کن: ⎬ :a :b <- ﴿b - a﴾. ⎨.
a هرکدام: ⎬ :i :e خروجی بنویس: ﴿ i - 0 ﴾, سطر-نو. ⎨.

⎨ اجرا.

برنامه پاکسازی.
usedMemory1 := ﴿برنامه حافظه ? 0﴾.


