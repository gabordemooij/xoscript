

لیست هنگام: ⌝'column:'⌜ انجام: ⎬ :column
	>> result := لیست جدید.
	خود هرکدام: ⎬ :index :row
		row هرکدام: ⎬ :index :cell
			﴿index = column﴾ اگر-درست: ⎬ result بیفزا-به-پایان: cell. ⎨.
		⎨.
	⎨. <- result.
⎨.


>> a := لیست ←
	﴿لیست ← 1 ; 2 ; 3﴾ ;
	﴿لیست ← 4 ; 5 ; 6﴾ ;
	﴿لیست ← 7 ; 8 ; 9﴾.

>> b := a column: 1.
خروجی بنویس: b, سطر-نو.

b := a column: 20.
خروجی بنویس: b, سطر-نو.

b := a column: -100.
خروجی بنویس: b, سطر-نو.
