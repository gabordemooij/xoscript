

لیست هنگام: ⌝'column:'⌜ انجام: ⎬ :ستون
	>> نتیجه := لیست جدید.
	خود هرکدام: ⎬ :اندیس :سطر
		سطر هرکدام: ⎬ :اندیس :خانه
			﴿اندیس = ستون﴾ اگر-درست: ⎬ نتیجه بیفزا-به-پایان: خانه. ⎨.
		⎨.
	⎨. <- نتیجه.
⎨.


>> a := لیست ←
	﴿لیست ← 1 ; 2 ; 3﴾ ;
	﴿لیست ← 4 ; 5 ; 6﴾ ;
	﴿لیست ← 7 ; 8 ; 9﴾.

>> b := a column: 1.
خروجی بنویس: b, سطر-نو.

b := a column: 20.
خروجی بنویس: b, سطر-نو.

b := a column: -100.
خروجی بنویس: b, سطر-نو.
