#آزمون regex
Server init.
>> subject := ⌝'<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'⌜.
>> الگوی-متنی := الگو جدید: ⌝'href="([^"]+)" target="([^"]+)"'⌜.
>> نتیجه  := الگوی-متنی تطبیق: subject انجام: ⎬ :m :x
	خروجی بنویس: m, سطر-نو.
	خروجی بنویس: x, سطر-نو.
	<- ⌝'XXX'⌜.
⎨.
خروجی بنویس: نتیجه, سطر-نو.