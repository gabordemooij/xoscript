# database test
# see example server.xo for required config

Server init.
خروجی بنویس: ⌝'Database test'⌜, سطر-نو.

>> db := Maria-DB جدید میزبان: ⌝'localhost'⌜,
	نام-کاربری: ⌝'xo'⌜, گذرواژه: ⌝'pass123'⌜, نام-پایگاه: ⌝'xobase'⌜, وصل-شو.

خروجی بنویس: ⌝'Can we connect? '⌜ + db وصل-است?, سطر-نو.

>> پارامترهای-جستجو := db پرس-و-جو: ⌝'
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'⌜, پارامترها: ﴿ لیست جدید ; ⌝'abc'⌜ ; 12.35 ; 6 ﴾. # parameterized queries

⎬  پارامترهای-جستجو اجرا-کن. db تایید. ⎨ بگیر: ⎬ :e db برگردان.  ⎨, اجرا.

خروجی بنویس: ⌝'Can we insert? '⌜ + ﴿ پارامترهای-جستجو insert-id > 0 ﴾, سطر-نو.

>> x := 0.
>> پارامترهای-جستجو :=
db پرس-و-جو: ⌝'SELECT * FROM book order by id desc limit 2'⌜, 
واکشی: ⎬ :row 
	x بیفزا: 1.
	درست بشکن. # must clean up, no 'Commands out of sync'
⎨.

>> پارامترهای-جستجو :=
db پرس-و-جو: ⌝'SELECT * FROM book order by id desc limit 2'⌜, 
واکشی: ⎬ :row
	x بیفزا: 1.
	درست بشکن.
⎨.

﴿x > 0﴾ اگر-درست: ⎬
	خروجی بنویس: ⌝'Can we break in the middle of a fetch? '⌜.
⎨.

خروجی بنویس: درست, سطر-نو.