


>> Deck := لیست جدید.
Deck هنگام: ⌝'print'⌜ انجام: ⎬
        >> len := خود تعداد - 1.
        ⎬ :i
                >> len2 := خود تعداد - 1.
                خروجی بنویس: ⌝'len: '⌜.
                خروجی بنویس: len, سطر-نو.
                خروجی بنویس: ⌝'len2: '⌜.
                خروجی بنویس: len2, سطر-نو.
        ⎨ × len.
⎨.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
