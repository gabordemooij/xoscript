


>> دسته-کارت := لیست جدید.
دسته-کارت هنگام: ⌝'چاپ-کن'⌜ انجام: ⎬
        >> len := خود تعداد - 1.
        ⎬ :i
                >> طول2 := خود تعداد - 1.
                خروجی بنویس: ⌝'طول: '⌜.
                خروجی بنویس: len, سطر-نو.
                خروجی بنویس: ⌝'طول2: '⌜.
                خروجی بنویس: طول2, سطر-نو.
        ⎨ × len.
⎨.

>> d := دسته-کارت ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d چاپ-کن.
