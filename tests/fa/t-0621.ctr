>> phrases := لیست جدید
	~ ⌝'abcd'⌜
	~ ⌝'hello world'⌜
	~ ⌝''⌜
	~ ⌝'@.,;"'⌜
	~ ⌝'this is a much much longer string to be encoded!'⌜.

>> message := ⌝'Phrase: ~decoded base64: ~encoded'⌜.
	
phrases هرکدام: ⎬ :_ :phrase 
	>> e := Server base64-کدگذاری: phrase.
	>> d := Server base64-کدگشایی: e.
	خروجی بنویس: ﴿
		message رونوشت ~encoded: e, ~decoded: d
	﴾, سطر-نو.
⎨.
