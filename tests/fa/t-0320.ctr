


>> قهوه-ساز := شیء جدید.
قهوه-ساز هنگام: ⌝'order:'⌜ انجام: ⎬ :id
	>> coffee := ⌝'آمریکانو'⌜.
	﴿ id = 1 ﴾ اگر-درست: ⎬
		coffee := ⌝'کاپوچینوی داغ'⌜.
	⎨.
	﴿ id = 2 ﴾ اگر-درست: ⎬
		coffee := ⌝'اسپرسو'⌜.
	⎨.
	﴿ id = 3 ﴾ اگر-درست: ⎬
		coffee := ⌝'لاته'⌜.
	⎨. <- coffee.
⎨.
>> قهوه-ساز-ساده := شیء جدید.
قهوه-ساز-ساده هنگام: ⌝'سفارش'⌜ انجام: ⎬ <- ⌝'تلخ'⌜. ⎨.
>> فنجان-قرمز := قهوه-ساز order: 1.
خروجی بنویس: فنجان-قرمز, سطر-نو.
فنجان-قرمز := ⌝'چای سیاه'⌜. 
>> فنجان-سبز := قهوه-ساز order: 0.
خروجی بنویس: فنجان-سبز, سطر-نو.
>> فنجان-زرد := قهوه-ساز order: 1.
خروجی بنویس: فنجان-زرد, سطر-نو.
>> فنجان-آبی := قهوه-ساز order: 0.
خروجی بنویس: فنجان-آبی, سطر-نو.
>> فنجان-پلاستیکی := قهوه-ساز-ساده سفارش.
فنجان-پلاستیکی := ⌝'لیموناد'⌜. 
>> فنجان-سیاه := قهوه-ساز-ساده سفارش.
خروجی بنویس: فنجان-سیاه, سطر-نو.
فنجان-سیاه بیفزا-به-پایان: ⌝' نههه.... آبجو. '⌜.
>> فنجان-نارنجی := قهوه-ساز-ساده سفارش.
خروجی بنویس: فنجان-نارنجی, سطر-نو.
