# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := شیء جدید.

Log هنگام: ⌝'say:'⌜ انجام: ⎬ :str
	خروجی بنویس: str, سطر-نو.
⎨.

>> Item := شیء جدید.

Item هنگام: ⌝'جدید:'⌜ انجام: ⎬ :id <- خود جدید id: id.
⎨.

Item هنگام: ⌝'id:'⌜ انجام: ⎬ :id
	خودم id := id.
⎨.

Item هنگام: ⌝'id'⌜ انجام: ⎬ <- خودم id. ⎨.


Item هنگام: ⌝'به-رشته'⌜ انجام: ⎬
	>> str := ⌝'Item#~no'⌜.
	str ~no: خودم id. <- str.
⎨.


>> Print := شیء جدید.

Print هنگام: ⌝'items'⌜ انجام: ⎬ 
	
	خودم item := Item جدید: 1.
	
	# either segfault or wrong str here
	Log say: ﴿
		⌝'~item printed.'⌜ ~item: خودم item
	﴾.
	
	
⎨.

Print items.