# این آزمون بررسی می‌کند که string_fill_in در حالت 4 جایگاه خود را از دست ندهد (gc'ed)
# ارجاع در world.c
>> گزارش := شیء جدید.

گزارش هنگام: ⌝'say:'⌜ انجام: ⎬ :str
	خروجی بنویس: str, سطر-نو.
⎨.

>> نوع-قلم := شیء جدید.

نوع-قلم هنگام: ⌝'جدید:'⌜ انجام: ⎬ :id
	<- خود جدید id: id.
⎨.

نوع-قلم هنگام: ⌝'id:'⌜ انجام: ⎬ :id
	خودم id := id.
⎨.

نوع-قلم هنگام: ⌝'id'⌜ انجام: ⎬ <- خودم id. ⎨.


نوع-قلم هنگام: ⌝'به-رشته'⌜ انجام: ⎬
	>> str := ⌝'Item#~no'⌜.
	str ~no: خودم id.
	<- str.
⎨.


>> Print := شیء جدید.

Print هنگام: ⌝'items'⌜ انجام: ⎬ 
	
	خودم قلم := نوع-قلم جدید: 1.
	
	# اینجا یا segfault یا رشته نادرست
	گزارش say: ﴿
		⌝'~item printed.'⌜ ~item: خودم قلم
	﴾.
	
	
⎨.

Print items.