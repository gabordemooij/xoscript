Server init.

>> DB := Maria-DB new host: ['localhost'],
	username: ['xo'],
	password: ['pass123'],
	dbname: ['xobase'],
	connect.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> query := Maria-Query new: SQL.

# set database
query database: DB.

query fetch: { :row
	Out write: row world, stop.
}.
