Génn bind: ['Test object'], taxaw.
>> a := Denc xees. 

a bu: ['item:'] def: { :dëppante
	sama dëppante := dëppante. 
}.

a bu: ['item'] def: { <- sama dëppante.
}.

a item: Dëkkul.

Génn bind: a item, taxaw.

>> old-bool-address := a item royuwaay dëkkuwaayu-xalaat.
a save-as: ['/tmp/a.bin'].
Génn bind: ['========== RELOADING SNAP:'], taxaw.

>> b := Denc load-from: ['/tmp/a.bin'].

(b item royuwaay dëkkuwaayu-xalaat = old-bool-address) dëgg: {
	Génn bind: ['Object link re-attached.'], taxaw.
}.

Génn bind: b item, taxaw.
