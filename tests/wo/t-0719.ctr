Server init.
>> fmt := Melo xees: ['%#3x'].

>> blob := Blob xees: 4.
blob bytes: ( 
	Jokkalante xees ; 0 ; 1 ; 2 ; 3
).

>> file := Dencukaayu xees: ['/tmp/blob'].
file blob: blob.
blob bàyyi.

>> jàng := file blob.
jàng 
dale: 0 
guddaay: 4, 
def kenn-ci-kenn: { :i :b 
	Génn
	bind: (fmt jëfandikoo-lim-bu-mat: b),
	taxaw.
}.
jàng bàyyi.
