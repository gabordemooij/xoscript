
>> dictionary := (
	Listin xees
		teg: ['b'] ci: ['a'],
		teg: ['a'] ci: ['b'],
		teg: ['z'] ci: ['x'],
		teg: ['hello'] ci: ['hallo'],
		teg: ['human'] ci: ['human']
).

>> comparisons := Jokkalante xees.
dictionary kenn-ci-kenn: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a dippee: b)
	).
}.

comparisons tëgg: { :a :b <- ( a dippee: b ). }.
Génn bind: ( comparisons boole: ['↵'] ), taxaw.
comparisons boole: ['↵'].
