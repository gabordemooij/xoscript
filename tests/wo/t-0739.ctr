Génn bind: ['Test object'], taxaw.
>> a := Denc xees. 

a bu: ['item:'] def: { :binhelper
	sama binhelper := binhelper. 
}.

a bu: ['item'] def: { <- sama binhelper.
}.

a item: Bin xees.

>> old-binhelper-address := a item royuwaay dëkkuwaayu-xalaat.
a save-as: ['/tmp/a.bin'].
Génn bind: ['========== RELOADING SNAP:'], taxaw.

>> b := Denc load-from: ['/tmp/a.bin'].

(b item royuwaay dëkkuwaayu-xalaat = old-binhelper-address) dëgg: {
	Génn bind: ['Object link re-attached.'], taxaw.
}.


