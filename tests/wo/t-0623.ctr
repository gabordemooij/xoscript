

>> g := Server xees.
>> v := Wàqu-kaaraange xees.
>> ok := 0.

>> secrets := Jokkalante xees ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> passwords := secrets duppitu.
passwords kenn-ci-kenn: { :i :p
	secrets kenn-ci-kenn: { :n :s
		{
			>> encrypted := v nëbb: s caabi: p.
			>> decrypted := v feeñal: encrypted caabi: p.
			(decrypted = s) dëgg: {
				ok yokk: 1.
			}, lu-dul: {
				Génn bind: ['failed encrypting/decrypting: '], taxaw.
				Génn bind: s, taxaw.
				Génn bind: ['encrypted: '] + encrypted, taxaw.
				Génn bind: ['decrypted: '] + encrypted, taxaw.
				Prograam nopi.
			}.
		} jàpp: { :err
			(s = [''] walla: p = ['']) dëgg: {
				ok yokk: 1.
			}, lu-dul: {
				Génn bind: err, taxaw.
				Prograam nopi.
			}.
		}, dox.
	}.
}.

Génn bind: ( ok + [' vault encryptions tested.'] ), taxaw.