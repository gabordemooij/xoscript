>> x := Denc xees.
>> y := Denc xees.
>> z := x.
Génn bind: (x = z), taxaw.
Génn bind: (x = y), taxaw.
Génn bind: (x ≠ y), taxaw.
Génn bind: (x ≠ z), taxaw.
>> m := Waxtu xees at: 2070, weer: 11.
>> n := m duppitu.
Génn bind: (m = n), taxaw.
Génn bind: (m ≠ n), taxaw.
Génn bind: (m mooy: m), taxaw.
Génn bind: (m mooy: n), taxaw.
n weer: 12.
Génn bind: (m ≠ n), taxaw.
Génn bind: (m = n), taxaw.


