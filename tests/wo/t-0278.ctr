>> To-Do := Denc xees.

To-Do bu: ['xees'] def: {
	sama list := Jokkalante xees.
}.

To-Do bu: ['nieuw'] def: {
	sama list := Jokkalante xees.
}.

To-Do bu: ['+'] def: { :task
	sama list yokk-ci-mujj: task.
}.

To-Do bu: ['number of tasks?'] def: { <-  sama list waññ.
}.

>> todos := 
	To-Do xees 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Génn bind: ['You have $ tasks to do'] $ todos number of tasks?.
