

Mbind bu: ['evaluate'] def: {
	>> koodu := Dencukaayu xees: ['/tmp/eval.ctr'].
	koodu bind: man mbind + ['.'].
	Prograam ay-jumtukaay: ['/tmp/eval.ctr'].
}.

>> a := (Jokkalante ← (
	(Listin xees)
		teg: ['domain'] ci: ['mywebsite.com'],
		teg: (Jokkalante ←
			((Listin xees)
				teg: ['home'] ci: ['title'],
				teg: ['<html></html>'] ci: ['body'],
				teg: ['2017-01-01'] ci: ['created']
			) ;
			((Listin xees)
				teg: ['aboutus(c)'] ci: ['title'],
				teg: ['<credits>Author Inc.</credits>'] ci: ['body']
			)
		) ci: ['pages']
	)
) mbind.

Génn bind: a xeetu, taxaw.
Génn bind: a, taxaw.

>> b := Dara.
(['b := '] + a) evaluate.
Génn bind: b ? 0 ? ['pages'] ? 1 ? ['body'], taxaw.

>> c := b ? 0.
>> d := c mbind.
Génn bind: d xeetu, taxaw.

>> e := Dara.
(['e := '] + d) evaluate.
Génn bind: e ? ['pages'] ? 0, taxaw.
