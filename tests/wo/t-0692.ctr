Server init.

Génn bind: (
	Nataal-seet xees: ['^\\w+$'],
	méngoo: ['test@example.com'] 
), taxaw. # 0 match, fails on @ and .

Génn bind: (
	Nataal-seet xees: ['^[^@]+@[^\.]+\.\\w+$'],
	méngoo: ['test@example.com'] 
), taxaw. # 1 match

Génn bind: (
	Nataal-seet xees: ['[^@]+@[^\.]+\.\\w+'],
	méngoo: ['test@example.com'] 
), taxaw. # 1 match

Génn bind: (
	Nataal-seet xees: ['([^@]+)@([^\.]+)\.\\w+'],
	méngoo: ['test@example.com'] 
), taxaw. # 1 match, groups dont matter

Génn bind: (
	Nataal-seet xees: ['[a-z]'],
	méngoo: ['test@example.com'] 
), taxaw. # 14 matches

Génn bind: (
	Nataal-seet xees: ['.*'],
	méngoo: ['test@example.com'] 
), taxaw. # 1 match (all)

Génn bind: (
	Nataal-seet xees: ['(.*)'],
	méngoo: ['test@example.com'] 
), taxaw. # 1 match (all)

Génn bind: (
	Nataal-seet xees: ['\\s*[^@]+@[^\.]+\.\\w+'],
	méngoo: ['test@example.com'] 
), taxaw. # 1 match, prefix space optional, gets ignored