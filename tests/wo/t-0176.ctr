

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prograam faraay: 0.

>> txt := ['Word Salad'].
Génn bind: ['Text Length: '] + txt guddaay, taxaw.
Génn bind: ['Character at 2:'] + ( txt araf: 2 ), taxaw.
Génn bind: (( txt wone: ['S'] ) - 0), taxaw.

Prograam faaral-njaboot.

usedMemory1 := (Prograam xalaat ? 0).


txt := ['Word Salad'].
Génn bind: ['Text Length: '] + txt guddaay, taxaw.
Génn bind: ['Character at 2:'] + ( txt araf: 2 ), taxaw.
Génn bind: (( txt wone: ['S'] ) - 0), taxaw.

Prograam faaral-njaboot.
usedMemory2 := (Prograam xalaat ? 0).


