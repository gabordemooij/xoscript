['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Génn bind: (x + y), taxaw.

>> x := 10040.07.
>> y := 10305.60.

Génn bind: (x + y), taxaw.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Génn bind: (x + y + z), taxaw.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Génn bind: (x + y + z), taxaw.

>> q := 0.1.2.

Génn bind: (q), taxaw.

>> q := 012.

Génn bind: (q), taxaw.
