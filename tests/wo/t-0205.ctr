>> str := ['write:'].
Génn bataaxal: ['bind:'] laaj: (Jokkalante ← ['Hello World']), taxaw. 

Lim bu: ['isbetween:and:'] def: { :a :b <- ((man ≥ a) ak: (man ≤ b)).
}.

str := ['isbetween:and:'].
Génn bind: (3 bataaxal: str laaj: (Jokkalante ← 2 ; 8)), taxaw.
Génn bind: (3 bataaxal: str laaj: (Jokkalante ← 1 ; 2)), taxaw.


>> CoffeeMachine := Denc xees.
CoffeeMachine bu: ['makeCoffeeWithSugar:milk:'] def: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Jokkalante ← 4 ; 2.
Génn bind: ( CoffeeMachine bataaxal: order laaj: coffeeConfiguration ), taxaw.
