

Mbind bu: ['html'] def: { <- (
		man
		wuutal: ['&'] ci: ['&amp;'],
		wuutal: ['<'] ci: ['&lt;'],
		wuutal: ['>'] ci: ['&gt;'],
		wuutal: ['"'] ci: ['&quot;']
	).
}.


Génn bind: ([' left trimmed '] jële-ruuj-diggante) + [' '] + ( ['and right trimmed'] jële-ruuj-diggante) + ['!'], taxaw.
Génn bind: ['<html>"html & entities"</html>'] html.
