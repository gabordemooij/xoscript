>> makeAdder := { :x
	>> f := { :y <- (sama x + y). } denc: ['x'] njëg: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i sama q teg: (sama f jëfandikoo: (sama q ? i)) ci: i. } 
	denc: ['q'] njëg: array,
	denc: ['f'] njëg: func.
	{ :i mapping jëfandikoo: i. } × (array waññ).
}.

>> a := Jokkalante ← 1; 2; 3.
mapper jëfandikoo: a ak: (makeAdder jëfandikoo: 100).
Génn bind: (a barab: 0), taxaw.
Génn bind: (a ? 1), taxaw.
Génn bind: (a ? 2), taxaw.
