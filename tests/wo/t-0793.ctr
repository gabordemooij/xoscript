Server init.

>> DB := Maria-DB xees dalalkat: ['localhost'],
	turu-jëfandikukat: ['xo'],
	baatu-jall: ['pass123'],
	turu-dencukaayu-njoxe: ['xobase'],
	lëkkaloo.

{
	DB laaj-njoxe:
	['DROP TABLE movies'],
	jëfe.
} jàpp: { Dara. }, dox.

DB laaj-njoxe:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
jëfe.

DB laaj-njoxe: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
tànneef-yi: ( Jokkalante xees ; ['Halloween'] ),
jëfe.

DB laaj-njoxe: ['SELECT * FROM movies'],
indi: { :movie
	Génn bind: movie title, taxaw.
}.

