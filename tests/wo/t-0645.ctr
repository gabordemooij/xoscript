Server init.
Génn bind: ['Database date test'], taxaw.

>> db := Maria-DB xees dalalkat: ['localhost'],
	turu-jëfandikukat: ['xo'], 
	baatu-jall: ['pass123'],
	turu-dencukaayu-njoxe: ['xobase'],
	lëkkaloo.

>> tànneefi-seet :=
db laaj-njoxe: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
indi: { :row
	Génn bind: row datetest, taxaw.
}.
