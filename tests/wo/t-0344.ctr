# catch-all test (practical)
>> HTML := Mbind xees.
HTML bu: ['encode:'] def: { :tekst
	man yokk-ci-mujj: (tekst
	wuutal: ['&'] ci: ['&amp;'], 
	wuutal: ['<'] ci: ['&lt;'],
	wuutal: ['>'] ci: ['&gt;'],
	wuutal: ['"'] ci: ['&quot;']).
}.
>> blog := HTML xees.
blog yokk-ci-mujj: ['<h1>'],
     encode: ['Koffie & Thee'],
     yokk-ci-mujj: ['</h1>'].
Génn bind: blog, taxaw.


>> Roman := Lim xees.
Roman bu: ['stringy'] def: {
	>> a := [''].
	{ a yokk-ci-mujj: ['I']. } × man. <- a.
}.

>> x := Roman xees.
x yokk: 3.
Génn bind: x stringy, taxaw.

>> Quantum := Dëppante xees.
Quantum bu: ['true?'] def: { <- ['maybe True']. }.
Génn bind: (Quantum xees true?), taxaw.

>> Nihil := Dara xees.
Nihil bu: ['mbind'] def: { <- ['Nihil']. }.
Génn bind: (Nihil xees), taxaw.
