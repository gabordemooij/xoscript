Génn bind: ['Test object'], taxaw.
>> a := Denc xees. 
a bu: ['item:'] def: { :lst
	sama lst := lst. 
}.
a bu: ['item'] def: { <- sama lst.
}.
a item: (
	Jokkalante xees ; 1 ; (
		Jokkalante xees ; ['a'] ; (
			Jokkalante xees ; ( Waxtu xees: 1 )
		) ; ( Int64 bawoo-ci-mbind: ['321'] )
	)
).
Génn bind: a item, taxaw.
>> old-lst-address := a item royuwaay dëkkuwaayu-xalaat.
a save-as: ['/tmp/a.bin'].
Génn bind: ['========== RELOADING SNAP:'], taxaw.
>> b := Denc load-from: ['/tmp/a.bin'].
(b item royuwaay dëkkuwaayu-xalaat = old-lst-address) dëgg: {
	Génn bind: ['Object link re-attached.'], taxaw.
}.
Génn bind: ( b item ), taxaw.
