Server init.

>> DB := Maria-DB xees dalalkat: ['localhost'],
	turu-jëfandikukat: ['xo'],
	baatu-jall: ['pass123'],
	turu-dencukaayu-njoxe: ['xobase'],
	lëkkaloo.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> tànneefi-seet := Laaj-Maria xees: SQL.

# set database
tànneefi-seet dencukaayu-njoxe: DB.

tànneefi-seet indi: { :row
	Génn bind: row world, taxaw.
}.
