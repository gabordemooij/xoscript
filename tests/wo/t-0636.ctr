# test url parsing

Server init.
>> url := URL bawoo: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Génn bind: ['scheme = '] + url tëralin-dëkkuwaay, taxaw.
Génn bind: ['host = '] + url dalalkat, taxaw.
Génn bind: ['port = '] + url buntu, taxaw.
Génn bind: ['path = '] + url xoll, taxaw.
Génn bind: ['query = '] + url tànneefi-seet, taxaw.
Génn bind: ['fragment = '] + url xaaj, taxaw.
