Génn bind: ['Test object'], taxaw.
>> a := Denc xees. 

a bu: ['item:'] def: { :octhelper
	sama octhelper := octhelper. 
}.

a bu: ['item'] def: { <- sama octhelper.
}.

a item: Oct xees.

>> old-octhelper-address := a item royuwaay dëkkuwaayu-xalaat.
a save-as: ['/tmp/a.bin'].
Génn bind: ['========== RELOADING SNAP:'], taxaw.

>> b := Denc load-from: ['/tmp/a.bin'].

(b item royuwaay dëkkuwaayu-xalaat = old-octhelper-address) dëgg: {
	Génn bind: ['Object link re-attached.'], taxaw.
}.
