>> Animal := Denc xees.
>> Factory := Denc xees.

Animal bu: ['xees'] def: {
	>> animal := man xees.
	animal sound: ['?']. <- animal.
}.

Animal bu: ['sound:'] def: { :s
	sama sound := s.
}.

Animal bu: ['sound'] def: { <- sama sound.
}.

>> Dog := Denc xees.
>> Cat := Denc xees.

Dog bu: ['xees'] def: { <- Animal xees sound: ['woof!'].
}.

Cat bu: ['xees'] def: { <- Animal xees sound: ['meow!'].
}.

Génn bind: Dog xees sound, taxaw.
Génn bind: Cat xees sound, taxaw.

Factory bu: ['mix:and:'] def: { :beast1 :beast2 <- Animal xees sound: (
		( beast1 sound dale: 0 guddaay: 2 ) +
		( beast2 sound dale: 2 guddaay: 5 )
	).
}.

Génn bind: (Factory mix: Dog xees and: Cat xees) sound, taxaw.
