>> Greeter := Denc xees.
Greeter bu: ['make'] def: {
	>> gr := Denc xees.
	gr bu: ['setName:'] def: { :aname
		sama tur := aname.
	}.
	gr bu: ['greet'] def: {
		Génn bind: sama tur.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a xees.
c setName: ['THREE'].
c greet.
>> d := a xees.
d setName: ['FOUR'].
d greet.
c greet.
