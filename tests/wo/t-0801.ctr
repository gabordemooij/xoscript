Server init.

>> db := Maria-DB xees dalalkat: ['localhost'],
	turu-jëfandikukat: ['xo'],
	baatu-jall: ['pass123'],
	turu-dencukaayu-njoxe: ['xobase'],
	lëkkaloo.

>> del := db laaj-njoxe: ['DELETE FROM book WHERE id > 0'].
{  del jëfe. db dëggal. } jàpp: { :e db delloo-gannaaw.  }, dox.

>> waññ := db laaj-njoxe: ['SELECT COUNT(*) AS num FROM book'].
waññ indi: { :row Génn bind: row num, taxaw. }.
