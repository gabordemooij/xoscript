>> Greeter := Denc xees.
Greeter bu: ['make'] def: {
	>> greeter := Denc xees.
	greeter bu: ['name:'] def: { :tur
		Génn bind: ['setting a name'].
		sama myName := tur.
	}.
	greeter bu: ['greet'] def: {
		Génn bind: ['Hello'].
		Génn bind: sama myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
