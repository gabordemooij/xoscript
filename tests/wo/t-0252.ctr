#Linux
>> clock := Waxtu xees.
clock diiwaan: ['UTC-1'].
clock at: 1981, weer: 1, bés: 5,
      waxtu: 13, simaa: 15, saa: 13.

Génn bind: clock, taxaw.
clock diiwaan: ['UTC+0'].

Génn bind: (
	(clock at ëpp) + ['-'] + (clock weer) + ['-'] + (clock bés) + [' '] +
	(clock waxtu) + [':'] + (clock simaa) + [':'] + (clock saa) + [' '] +
	['W'] + (clock ayu-bés) + (clock diiwaan)
), taxaw.


clock diiwaan: ['UTC-1'].
Génn bind: (
	(clock at ëpp) + ['-'] + (clock weer) + ['-'] + (clock bés) + [' '] +
	(clock waxtu) + [':'] + (clock simaa) + [':'] + (clock saa) + [' '] +
	['W'] + (clock ayu-bés) + (clock diiwaan)
), taxaw.
