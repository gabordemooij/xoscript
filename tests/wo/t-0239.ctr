Jokkalante bu: ['sum'] def: {
	>> total := 0.
	man kenn-ci-kenn: { :index :element
		total yokk: element.
	}. <- total.
}.

>> a := Dëgg.



a bu: ['mbind'] def: {
	>> answer := Dara.
	( man = Dëgg ) dëgg: {
		answer := ['Yep'].
	}, lu-dul: {
		answer := ['Nope'].
	}. <- answer.
}.

a bu: ['lim'] def: {
	>> answer := Dara.
	( man = Dëgg ) dëgg: {
		answer := 10.
	}, lu-dul: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b bu: ['mbind'] def: { <- ['Devil'].
}.

b bu: ['dëppante'] def: { <- Dëkkul.
}.


Génn bind: a, taxaw.  
Génn bind: (90 + a), taxaw. 
Génn bind: b, taxaw. 
Génn bind: (Dëgg ak: b), taxaw.

a := Jokkalante ← ['hello'] ; ['world'] ; Dëgg ; Dara ; 666. 
a := a + ( Jokkalante ← 1 ).
Génn bind: a, taxaw.
Génn bind: ((Listin xees) teg: Dara ci: Dara), taxaw.
Génn bind: a sum, taxaw. 


{
	a bu: ['mbind'] def: { <- Dara. }.
	a := [''] + a.
} jàpp: { :error
	Génn bind: ['Error noted: '] + error, taxaw.
}, dox.



{
	a bu: ['lim'] def: { <- Dara. }.
	a := 3 × a.
} jàpp: { :error
	Génn bind: ['Error noted: '] + error, taxaw.
}, dox.


{
	a bu: ['dëppante'] def: { <- Dara. }.
	a := Dëgg ak: a. 
} jàpp: { :error
	Génn bind: ['Error noted: '] + error, taxaw.
}, dox.





{
	a bu: ['mbind'] def: { <- Dëkkul. }.
	a := [''] + a.
} jàpp: { :error
	Génn bind: ['Error noted: '] + error, taxaw.
}, dox.



{
	a bu: ['lim'] def: { <- Dëgg. }.
	a := 3 × a.
} jàpp: { :error
	Génn bind: ['Error noted: '] + error, taxaw.
}, dox.


{
	a bu: ['boolean'] def: { <- 1. }.
	a := Dëgg ak: a.
} jàpp: { :error
	Génn bind: ['Error noted: '] + error, taxaw.
}, dox.





{
	a bu: ['mbind'] def: { <- 1. }.
	a := [''] + a.
} jàpp: { :error
	Génn bind: ['Error noted: '] + error, taxaw.
}, dox.



{
	a bu: ['lim'] def: { <- ['']. }.
	a := 3 × a.
} jàpp: { :error
	Génn bind: ['Error noted: '] + error, taxaw.
}, dox.


{
	a bu: ['boolean'] def: { <- ['']. }.
	a := Dëgg ak: a.
} jàpp: { :error
	Génn bind: ['Error noted: '] + error, taxaw.
}, dox.






{
	a bu: ['mbind'] def: { <- (Listin xees). }.
	a := [''] + a. 
} jàpp: { :error
	Génn bind: ['Error noted: '] + error, taxaw.
}, dox.



{
	a bu: ['lim'] def: { <- (Denc xees). }.
	a := 3 × a. 
} jàpp: { :error
	Génn bind: ['Error noted: '] + error, taxaw.
}, dox.


{
	a bu: ['boolean'] def: { <- (Denc xees). }.
	a := Dëgg ak: a.
} jàpp: { :error
	Génn bind: ['Error noted: '] + error, taxaw.
