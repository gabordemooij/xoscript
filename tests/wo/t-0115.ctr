{
	liggéey-bi njuumte: ['Dont fail.'].
	unknown doSomething.
} jàpp: {
	Génn bind: ['Caught!'].
}, dox.

{
	liggéey-bi njuumte: ['Dont fail.'].
	sama unknown doSomething.
} jàpp: {
	Génn bind: ['Caught!'].
}, dox.

{
	liggéey-bi njuumte: ['Dont fail.'].
	unknown := 122.
} jàpp: {
	Génn bind: ['Caught!'].
}, dox.


{
	liggéey-bi njuumte: ['Dont fail.'].
	Dëgg dog.
	Génn bind: ['FAIL'].
} jàpp: {
	Génn bind: ['Caught!'].
}, dox.

{
	{
		liggéey-bi njuumte: ['Dont fail.'].
		Dëgg dog.
		Génn bind: ['FAIL'].
	} jàpp: { :x
		(x = ['Dont fail.']) dëgg: { liggéey-bi njuumte: ['Nested Caught!']. }.
	}, dox.
} jàpp: { :e
	Génn bind: e.
}, dox.
