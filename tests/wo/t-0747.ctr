Génn bind: ['Test object'], taxaw.
>> a := Denc xees. 

a bu: ['item:'] def: { :num
	sama num := num. 
}.

a bu: ['item'] def: { <- sama num.
}.

a item: 123.

Génn bind: a item, taxaw.

>> old-num-address := a item royuwaay dëkkuwaayu-xalaat.
a save-as: ['/tmp/a.bin'].
Génn bind: ['========== RELOADING SNAP:'], taxaw.

>> b := Denc load-from: ['/tmp/a.bin'].

(b item royuwaay dëkkuwaayu-xalaat = old-num-address) dëgg: {
	Génn bind: ['Object link re-attached.'], taxaw.
}.

Génn bind: b item, taxaw.
