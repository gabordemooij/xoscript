

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prograam faraay: 0.

>> o := Denc xees.
>> o2 := Denc xees.
Génn bind: o Dara?, taxaw.
Génn bind: o xeetu, taxaw.
Génn bind: ( o mooy: o ), taxaw.
Génn bind: ( o mooy: o2 ), taxaw.
Génn bind: o man-ci-man, taxaw.
Génn bind: ( o def noppi ), taxaw.

Prograam faaral-njaboot.

usedMemory1 := (Prograam xalaat ? 0).


o := Denc xees.
o2 := Denc xees.
Génn bind: o Dara?, taxaw.
Génn bind: o xeetu, taxaw.
Génn bind: ( o mooy: o ), taxaw.
