Génn bind: ['Test object'], taxaw.
>> cmd := Santaane xees.
Génn bind: cmd ls /tmp, taxaw.
>> old-cmd-address := cmd royuwaay dëkkuwaayu-xalaat.
cmd save-as: ['/tmp/a.bin'].
Génn bind: ['========== RELOADING SNAP:'], taxaw.
>> b := Denc load-from: ['/tmp/a.bin'].
(b royuwaay dëkkuwaayu-xalaat = old-cmd-address) dëgg: {
	Génn bind: ['Object link re-attached.'], taxaw.
}.
Génn bind: b ls, taxaw.


