
Jokkalante bu: ['product'] def: {
	>> total := 1.
	man kenn-ci-kenn: { :index :element
		total leggi-ci: element.
	}. <- total.
}.

>> a := Jokkalante ← 1 ; 2 ; 3.
Génn bind: a product, taxaw.
Génn bind: (Jokkalante ← 2 ; 4 ; 8) product, taxaw. 
Génn bind: (Jokkalante ← -2 ; 10) product, taxaw. 
Génn bind: (Jokkalante ← 0.5 ; -2) product, taxaw. 
