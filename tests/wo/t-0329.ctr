Génn bind: ((Jokkalante xees
	bu: ['plaque:'] def: { :x sama o := x. },
	bu: ['plaque']  def: { <- sama o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Jokkalante ← 1)
	~ (Jokkalante ← 1 ; 2)
	~ (Jokkalante ← 1 ; 2 ; 3)
	~ (Jokkalante ← 1 ; 2 ; 3 ; 4)
	~ (Jokkalante ← 1 ; 2 ; 3 ; 4 ; 5)
) kenn-ci-kenn: { :i :el
	{ Génn bind: liggéey-bi. } × el waññ.
	Génn taxaw.
}) plaque, taxaw.


