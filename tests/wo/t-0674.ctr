# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> xoll := ['/tmp/dat.csv'].
>> csv := Dencukaayu xees: xoll.
csv bind: s.

# accepts CRLF LF CR, varying row length
csv xaajalekaay: [';'] màndargam-wax: ['"'] rëdd-yi: { :line
	Prograam faaral-njaboot.
	Génn bind: line, taxaw.
	Prograam faaral-njaboot.
}.

# unequal lines
s yokk-ci-mujj: ['\njustone'].
csv bind: s.
{
	csv xaajalekaay: [';'] màndargam-wax: ['"'] rëdd-yi: { :line
		Génn bind: line, taxaw.
	}.
} jàpp: { :e 
	Génn bind: e, taxaw.
}, dox.

# invalid format
s := ['"he"llo";world'].
csv bind: s.
{
	csv xaajalekaay: [';'] màndargam-wax: ['"'] rëdd-yi: { :line
		Génn bind: line, taxaw.
	}.
} jàpp: { :e 
	Génn bind: e, taxaw.
}, dox.
