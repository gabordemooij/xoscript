# edge cases from a request must give an error or a result, not a crash
Server init.

Génn bind: ['<'] + (['abc'] dale: 0 guddaay: 0, mag-araf) + ['>'], taxaw.
Génn bind: ['<'] + (['abc'] dale: 0 guddaay: 0, ndaw-araf) + ['>'], taxaw.
Génn bind: ['<'] + (['abc'] tëb: 3, mag-araf) + ['>'], taxaw.
Génn bind: [''] mag-araf bytes, taxaw.
Génn bind: ['aB'] mag-araf, taxaw.
Génn bind: ['aB'] ndaw-araf, taxaw.

Génn bind: (Waxtu xees: 0) at, taxaw.
{ Waxtu xees: ['9e300'] lim. } jàpp: { :e Génn bind: e, taxaw. }, dox.
{ Waxtu xees: ['-9e300'] lim. } jàpp: { :e Génn bind: e, taxaw. }, dox.
{ Waxtu xees: ['nan'] lim. } jàpp: { :e Génn bind: e, taxaw. }, dox.
{ Waxtu xees: 9000000000000000000. } jàpp: { :e Génn bind: e, taxaw. }, dox.
