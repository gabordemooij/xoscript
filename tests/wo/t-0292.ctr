>> winery := { <- (	Listin xees
		teg: 2 ci: ['merlot'],
		teg: 3 ci: ['malbec'],
		teg: 4 ci: ['syrah']
	).
}.

Génn bind: (((winery dox) - ['nothing']) waññ), taxaw.
Génn bind: (((winery dox) - ['merlot']) waññ), taxaw.
Génn bind: (((winery dox) - ['malbec']) waññ), taxaw.
Génn bind: (((winery dox) - ['syrah']) waññ), taxaw.
Génn bind: (((winery dox) - ['merlot'] - ['malbec']) waññ), taxaw.
Génn bind: (((winery dox) - ['merlot'] - ['syrah']) waññ), taxaw.
Génn bind: (((winery dox) - ['malbec'] -['syrah']) waññ), taxaw.
Génn bind: (((winery dox) - ['malbec'] - ['syrah'] - ['merlot']) waññ), taxaw.

