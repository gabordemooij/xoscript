>> Point := Denc xees.
Point bu: ['x-coordinate:'] def: { :x sama x := x. }.
Point bu: ['y-coordinate:'] def: { :y sama y := y. }.
Point bu: ['x-coordinate']  def: { <- sama x duppitu. }.
Point bu: ['y-coordinate']  def: { <- sama y duppitu. }.

Point bu: ['='] def: { :other <- ( sama x = other x-coordinate
		 ak: sama y = other y-coordinate ).
}.

>> pier := Point xees x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point xees x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point xees x-coordinate: 5, y-coordinate: 6.

Génn bind: pier = town-hall, taxaw.
Génn bind: pier = restaurant, taxaw.
