Génn bind: ['Continue for-loop, No - before 6 and up.'], taxaw.
{ :i
	Génn bind: (i + 1), taxaw.
	((i + 1) > 4) kontine.
	Génn bind: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Génn taxaw.
Génn bind: ['Continue while-true, No --> before 5 and up.'], taxaw.
{
	Génn bind: ['iteration #'] + x, taxaw.
	x yokk: 1.
	((x < 5) du) kontine.
	Génn bind: ['-->'].
} fiy: xIsLessThan10.
Génn taxaw.
Génn bind: ['Continue while-false, No - before 3 only.'], taxaw.
{
	Génn bind: ['iteration #'] + x, taxaw.
	x wàññi: 1.
	(x = 3) kontine.
	Génn bind: ['-'].
} fiy: { <- ( x > 0). }.

Génn taxaw.
Génn bind: ['Continue times-loop, No ||| before 3.'], taxaw.
{ :i
	Génn bind: ['iteration #'] + i, taxaw.
	(i = 2) kontine.
	Génn bind: ['|||'].
} × 5.

Génn taxaw.

{ Dëgg kontine. Génn bind: ['dont write this!'], taxaw. } dox.

{ Dëgg kontine. Génn bind: ['dont write this!'], taxaw. } jàpp: { Génn bind: ['Dont catch this!']. }, dox.

Génn bind: ['Test Array each-loop: 0, ... ,2'], taxaw.
(Jokkalante ← 1 ; 2 ; 3) naat: { :i
	(i = 1) kontine.
	Génn bind: ['iteration #'] + (i - 0), taxaw.
}.

Génn bind: ['Test Map each-loop: c only'], taxaw.
>> m := Listin xees.
m teg: ['first'] ci: ['a'], teg: ['second'] ci: ['b'], teg: ['third'] ci: ['c'].
m kenn-ci-kenn: { :k :v
	(k ≠ ['c']) kontine.
	Génn bind: ['iteration'] + k + v, taxaw.
}.

