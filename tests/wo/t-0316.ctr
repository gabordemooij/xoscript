>> Grandfather := Denc xees.
Grandfather bu: ['greet'] def: {
	Génn bind: ['Ave!'], taxaw.
}.
>> Father := Grandfather xees.
Father bu: ['greet'] def: {
	Génn bind: ['Hello'], taxaw.
	man greet.
}.
>> Son := Father xees.
Son bu: ['greet'] def: {
	Génn bind: ['Hi'], taxaw.
	man greet.
}.

Son greet.

>> Roundabout := Denc xees.
Roundabout bu: ['circle:'] def: { :x
	Génn bind: x, taxaw.
	(x < 3) dëgg: { man dellu-ci-bopp circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) dëgg: { Génn bind: x, taxaw. x yokk: 1.  increment dox. }. }.
increment dox.