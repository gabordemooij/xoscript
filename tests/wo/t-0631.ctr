#ffi test


Server init.

Prograam faraay: 4.

# for this test you need set a path to libc (puts)
>> libname := Prograam jamono: ['FFITESTLIB'].



Server lëkkale: (
 Jokkalante xees ;
 libname ;
 ['puts'] ;
 ( Jokkalante xees ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s bàyyi.

# test with struct

>> a := Blob xees: 8.
a bytes: (
	Jokkalante <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Jokkalante <<: ['int'], ; ['int']).

Server lëkkale: (
	Jokkalante <<: ['@structtest'], ;
	['@structtest'] ;
	(Jokkalante <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Génn bind: ['Sum test:'] + (ffitest ffisum: a), taxaw.

struct bàyyi-struct.
struct bàyyi.
a bàyyi.
