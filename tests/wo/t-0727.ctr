Server init.
>> f := Melo xees: ['%d'].
>> a := Blob xees: 4.
a bytes: ( Jokkalante xees ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob xees: 4.
b bytes: ( Jokkalante xees ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a dale: 0 guddaay: 3, kenn-ci-kenn: { :i :byte
	Génn bind: ( f jëfandikoo-lim-bu-mat: byte ), taxaw.
}.
a ^ b.
a dale: 0 guddaay: 3, kenn-ci-kenn: { :i :byte
	Génn bind: ( f jëfandikoo-lim-bu-mat: byte ), taxaw.
}.
a ^ b.
a dale: 0 guddaay: 3, kenn-ci-kenn: { :i :byte
	Génn bind: ( f jëfandikoo-lim-bu-mat: byte ), taxaw.
}.
a bàyyi.
b bàyyi.

{ a ^ Denc. } jàpp: { :e Génn bind: e, taxaw. }, dox.
