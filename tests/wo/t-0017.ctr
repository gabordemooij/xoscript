Lim bu: ['factorial'] def: {
	>> total := 1.
	{ :index total leggi-ci: (man - (index)). } × man. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Génn bind: a.
>> b := 2 + 3 factorial.
Génn bind: b.
>> c := 3 factorial + 2.
Génn bind: c.
>> d := 2 + (3 factorial).
Génn bind: d.
Génn bind: 2 + 3 factorial + 1.
