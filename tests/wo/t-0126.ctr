#Linux
>> Slurp := Denc xees.

Slurp bu: ['xees'] def: {
	sama str := [''].
}.

Slurp bu: ['nieuw'] def: {
	sama str := [''].
}.

Slurp bu: ['tontu:'] def: { :blah
		sama str yokk-ci-mujj: blah.
}.

Slurp bu: ['tontu:ak:'] def: { :blah :blahah
		sama str yokk-ci-mujj: (blah dale: 0 guddaay: (blah guddaay - 1)).
		sama str yokk-ci-mujj: [' '].
		sama str yokk-ci-mujj: blahah.
}.

Slurp bu: ['obtain'] def: {
	>> buffer := sama str.
	sama str := ['']. <- buffer.
}.


Génn bind: (Prograam oordinaatëer: (Slurp xees echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Dencukaayu xees: ['/tmp/from.txt'], far. } jàpp: { ['Empty']. }, dox.
{ Dencukaayu xees: ['/tmp/to.txt'], far. } jàpp: { ['Empty']. }, dox.


Dencukaayu xees: ['/tmp/to.txt'], nekk dëkkul: {
	Génn bind: ['Confirmed. Target file does not exist.\
'].
}.
Dencukaayu xees: ['/tmp/from.txt'], nekk dëkkul: {
	Génn bind: ['Confirmed. Source file does not exist.\
'].
}.



Prograam oordinaatëer: (Slurp xees touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Prograam oordinaatëer: (Slurp xees cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Dencukaayu xees: ['/tmp/to.txt'], nekk dëgg: {
	Génn bind: ['Confirmed. Target file has been created by shell.\
'].
}.


Génn bind: ['Contents of file is:'] + (Dencukaayu xees: ['/tmp/to.txt'], jàng), taxaw.
