>> list := Jokkalante xees.
list ~ ['hello'].
Génn bind: list waññ.
list yokk-ci-mujj: ['world'].
Génn bind: list waññ.
Génn bind: list jële-ci-gannaaw, bind: list waññ.
list yokk-ci-mujj: ['there'].
Génn bind: list waññ.
Génn bind: (list barab: 0), bind: (list barab: 1).
list teg: ['xmas'] ci: 1.
list teg: ['merry'] ci: 0.
Génn bind: list waññ.
Génn bind: (list barab: 0), bind: (list barab: 1).
