Génn bind: ['Test object'], taxaw.
>> a := Denc xees. 

a bu: ['item:'] def: { :dict
	sama dict := dict. 
}.

a bu: ['item'] def: { <- sama dict.
}.

a item: (
Listin xees
	hello: ['world'],
	world: (Listin xees teg: ['a'] ci: ['b'])).

Génn bind: a item, taxaw.

>> old-dict-address := a item royuwaay dëkkuwaayu-xalaat.
a save-as: ['/tmp/a.bin'].
Génn bind: ['========== RELOADING SNAP:'], taxaw.

>> b := Denc load-from: ['/tmp/a.bin'].

(b item royuwaay dëkkuwaayu-xalaat = old-dict-address) dëgg: {
	Génn bind: ['Object link re-attached.'], taxaw.
}.

Génn bind: b item, taxaw.
