# a quote that never closes must give an error, not an endless loop
>> xoll := ['/tmp/test0821.csv'].
>> file := Dencukaayu xees: xoll.

file bind: ['a,b\n"1,2\n'].
{
	file xaajalekaay: [','] màndargam-wax: ['"'] rëdd-yi: { :line
		Génn bind: line, taxaw.
	}.
} jàpp: { :e Génn bind: e, taxaw. }, dox.

# a closed quote still works
file bind: ['a,b\n"1,2",3'].
file xaajalekaay: [','] màndargam-wax: ['"'] rëdd-yi: { :line
	Génn bind: line, taxaw.
}.
file far.
