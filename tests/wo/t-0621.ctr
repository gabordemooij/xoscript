>> phrases := Jokkalante xees
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases kenn-ci-kenn: { :_ :phrase 
	>> e := Server base64-koode: phrase.
	>> d := Server base64-dindi-kood: e.
	Génn bind: (
		message duppitu ~encoded: e, ~decoded: d
	), taxaw.
}.
