60 × {
	>> x := (Lim random % 6) + 1.
	(x ≤ 6) dëkkul: { Génn bind: ['FAIL']. }.
	(x ≥0) dëkkul: { Génn bind: ['FAIL']. }.
	x := (Lim random % 3) + 1.
	(x < 3) dëkkul: { Génn bind: ['FAIL']. }.
	(x>-1) dëkkul: { Génn bind: ['FAIL']. }.
	x := ((Dëppante flip) lim).
	(x = 0 walla: x = 1) dëkkul: { Génn bind: ['FAIL']. }.
	x := ((Dëgg flip) lim).
	(x = 0 walla: x = 1) dëkkul: { Génn bind: ['FAIL']. }.
	x := (Dëppante flip mbaa: ['HEAD'] mbaa: ['TAIL']).
	((x = ['HEAD']) walla: (x = ['TAIL'])) dëkkul: { Génn bind: ['FAIL']. }.
}.
Génn bind: ['DONE'].

