>> t := Dëgg.
(t = Dëgg) dëgg: { Génn bind: ['T']. }.
(t = Dëkkul) dëgg: { Génn bind: ['F']. }.
Génn bind: ['|'].
>> t := Dëkkul.
(t = Dëgg) dëgg: { Génn bind: ['T']. }.
(t = Dëkkul) dëgg: { Génn bind: ['F']. }.
Génn bind: ['|'].
>> f := Dëgg.
(t = Dëgg ak: f = Dëkkul) dëgg: { Génn bind: ['T']. }.
(t = Dëkkul ak: f = Dëgg) dëgg: { Génn bind: ['F']. }.
Génn bind: ['|'].
>> n := Dara.
(n Dara?) dëgg: { Génn bind: ['T']. }.
(n Dara?) dëkkul: { Génn bind: ['F']. }.
Génn bind: ['|'].
(f Boolean?) dëgg: { Génn bind: ['T']. }.
(f Boolean?) dëkkul: { Génn bind: ['F']. }.



