# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Prograam shell-escape: ['abc'].
Génn bind: c, taxaw.
Génn bind: ( Prograam oordinaatëer: ['echo '] + c ), taxaw.

c := Prograam shell-escape: ['a'b'c'].
Génn bind: c, taxaw.
Génn bind: ( Prograam oordinaatëer: ['echo '] + c ), taxaw.

c := Prograam shell-escape: ['a\'c'].
Génn bind: c, taxaw.
Génn bind: ( Prograam oordinaatëer: ['echo '] + c ), taxaw.