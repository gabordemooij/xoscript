Génn bind: ['Test object'], taxaw.
>> a := Denc xees. 

a bu: ['item:'] def: { :hexhelper
	sama hexhelper := hexhelper. 
}.

a bu: ['item'] def: { <- sama hexhelper.
}.

a item: Hx xees.

>> old-hexhelper-address := a item royuwaay dëkkuwaayu-xalaat.
a save-as: ['/tmp/a.bin'].
Génn bind: ['========== RELOADING SNAP:'], taxaw.

>> b := Denc load-from: ['/tmp/a.bin'].

(b item royuwaay dëkkuwaayu-xalaat = old-hexhelper-address) dëgg: {
	Génn bind: ['Object link re-attached.'], taxaw.
}.
