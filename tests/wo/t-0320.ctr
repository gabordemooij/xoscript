


>> CoffeeMachine := Denc xees.
CoffeeMachine bu: ['order:'] def: { :id
	>> coffee := ['Americano'].
	( id = 1 ) dëgg: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) dëgg: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) dëgg: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Denc xees.
SimpleCoffeeMachine bu: ['order'] def: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Génn bind: redCup, taxaw.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Génn bind: greenCup, taxaw.
>> yellowCup := CoffeeMachine order: 1.
Génn bind: yellowCup, taxaw.
>> blueCup := CoffeeMachine order: 0.
Génn bind: blueCup, taxaw.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Génn bind: blackCup, taxaw.
blackCup yokk-ci-mujj: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Génn bind: orangeCup, taxaw.
