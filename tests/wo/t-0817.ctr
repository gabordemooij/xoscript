# a value ending in the first part of an opening quote must survive serialization
>> njëriñ-yi := Jokkalante xees
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

njëriñ-yi kenn-ci-kenn: { :i :value
	>> d := Listin xees.
	d teg: value ci: ['k'].
	d teg: ['second'] ci: ['j'].
	>> r := d koodu denc.
	Génn bind: r waññ, taxaw.
	Génn bind: ( (r ci: ['k']) = value ), taxaw.
}.
