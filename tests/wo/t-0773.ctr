Génn bind: ['Test object'], taxaw.
>> a := Denc xees. 
a bu: ['item:'] def: { :int64
	sama int64 := int64. 
}.
a bu: ['item'] def: { <- sama int64.
}.
a item: ( Int64 bawoo-ci-mbind: ['9999'] ).
Génn bind: a item, taxaw.
>> old-int64-address := a item royuwaay dëkkuwaayu-xalaat.
a save-as: ['/tmp/a.bin'].
Génn bind: ['========== RELOADING SNAP:'], taxaw.
>> b := Denc load-from: ['/tmp/a.bin'].
(b item royuwaay dëkkuwaayu-xalaat = old-int64-address) dëgg: {
	Génn bind: ['Object link re-attached.'], taxaw.
}.
Génn bind: ( b item ), taxaw.
