# test list operations


>> cakes := Jokkalante ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes wuutal: 1 guddaay: 2 ak: ( Jokkalante ← ['cinnamon'] ; ['pineapple'] ).
Génn bind: (buy boole: [',']), taxaw.


>> buy := cakes wuutal: 1 guddaay: 12 ak: ( Jokkalante ← ['cinnamon'] ; ['pineapple'] ).
Génn bind: (buy boole: [',']), taxaw.


>> buy := cakes wuutal: 2 guddaay: 10 ak: ( Jokkalante xees ).
Génn bind: (buy boole: [',']), taxaw.


>> buy := cakes wuutal: 0 guddaay: 1 ak: ( Jokkalante xees ).
Génn bind: (buy boole: [',']), taxaw.


>> buy := cakes wuutal: ['0'] guddaay: ['1'] ak: ['x'].
Génn bind: (buy boole: [',']), taxaw.
