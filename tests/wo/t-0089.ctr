>> randomizer := { :a :b
	>> ndaw := ( a < b ) mbaa: a mbaa: b.
	>> mag := ( a > b ) mbaa: a mbaa: b.
	>> x := Dara.
	{
		x := Lim digante: a ak: b.
		((x < ndaw) walla: (x > mag)) dëgg: { 
			Génn bind: (['Invalid value!']).
			Prograam nopi.
		}.
	} 
	× 100. <- x.
}.
randomizer jëfandikoo: 0 ak: 0.
