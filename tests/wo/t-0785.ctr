Génn bind: ['Test object'], taxaw.
>> a := Denc xees. 

a bu: ['item:'] def: { :moment
	sama moment := moment. 
}.

a bu: ['item'] def: { <- sama moment.
}.

>> today := Jokkalante xees ; ( Waxtu xees diiwaan: ['CEST'], at: 2026, weer: 7 ).
a item: today.
Génn bind: a item ? 0, taxaw.
a save-as: ['/tmp/a.bin'].
