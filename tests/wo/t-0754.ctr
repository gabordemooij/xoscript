Génn bind: ['Test object'], taxaw.
>> a := Denc xees. 

a bu: ['item:'] def: { :out
	sama out := out. 
}.

a bu: ['item'] def: { <- sama out.
}.

a bu: ['greet'] def: {
	Génn bind: ['hi from original out!'], taxaw.
}.

a item: Génn.

Génn bind: a item, taxaw.

>> old-out-address := a item royuwaay dëkkuwaayu-xalaat.
a save-as: ['/tmp/a.bin'].
Génn bind: ['========== RELOADING SNAP:'], taxaw.

>> b := Denc load-from: ['/tmp/a.bin'].

(b item royuwaay dëkkuwaayu-xalaat = old-out-address) dëgg: {
	Génn bind: ['Object link re-attached.'], taxaw.
}.

b item bind: ['hello from loaded out!'], taxaw.
b greet.
