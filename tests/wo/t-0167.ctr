

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prograam faraay: 0.

>> f := Dencukaayu xees: ['/tmp/citrine_test_file.txt'].
f exists: { f far. }.
f bind: ['hello world'].
>> q := f réyaay.
Génn bind: q, taxaw.

f := Dencukaayu xees: ['/tmp/citrine_test_file.txt'].
q := f réyaay.
Génn bind: q, taxaw.

Prograam faaral-njaboot.
usedMemory1 := (Prograam xalaat ? 0).


f := Dencukaayu xees: ['/tmp/citrine_test_file.txt'].
q := f réyaay.
Génn bind: q, taxaw.

Prograam faaral-njaboot.
usedMemory2 := (Prograam xalaat ? 0).


f := Dencukaayu xees: ['/tmp/citrine_test_file.txt'].
q := f réyaay.
Génn bind: q, taxaw.

Prograam faaral-njaboot.
usedMemory3 := (Prograam xalaat ? 0).



( usedMemory1 = usedMemory2 ak: usedMemory1 = usedMemory3, ak: usedMemory2 = usedMemory3 ) dëgg: {
	Génn bind: ['No memory leaks here'].
}, dëkkul: {
	Génn bind: ['Leaking memory...'].
}.
