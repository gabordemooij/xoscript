Génn bind: ['Test object'], taxaw.
>> a := Denc xees. 

a bu: ['item:'] def: { :moment
	sama moment := moment. 
}.

a bu: ['item'] def: { <- sama moment.
}.

>> today := Waxtu xees diiwaan: ['CEST'], at: 2026, weer: 7.
a item: today.
Génn bind: a item, taxaw.
a save-as: ['/tmp/a.bin'].
Génn bind: ['========== RELOADING SNAP:'], taxaw.
>> b := Denc load-from: ['/tmp/a.bin'].
Génn bind: b item, taxaw.
