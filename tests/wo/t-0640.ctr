
Server init.
Génn bind: ['Database test'], taxaw.

>> db := Maria-DB xees dalalkat: ['localhost'],
	turu-jëfandikukat: ['xo'], 
	baatu-jall: ['pass123'],
	turu-dencukaayu-njoxe: ['xobase'],
	lëkkaloo.

>> tànneefi-seet :=
db laaj-njoxe: ['SELECT UNHEX('CAFE') AS blobby'],
indi: { :row
	Génn bind: ( row blobby dale: 0 guddaay: 2 ), taxaw.
	row blobby bàyyi.
}.
