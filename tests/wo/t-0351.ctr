
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> koodu := {
	>> o := (
		Listin xees
		aa: (Jokkalante ← 1 ; 2),
		bb: (Jokkalante ← 3 ; 4)
	).
	>> s := o mbind.
	>> o2 := s denc.
	(s  xeetu = Mbind xeetu) dëgg: { Génn bind: ['OK1'], taxaw. }.
	(o2 xeetu = Listin xeetu) dëgg: { Génn bind: ['OK2'], taxaw. }.
}.

Prograam faraay: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Prograam faaral-njaboot.
usedMemory1 := (Prograam xalaat ? 1).
koodu dox.
Prograam faaral-njaboot.
usedMemory2 := (Prograam xalaat ? 1).
koodu dox.
