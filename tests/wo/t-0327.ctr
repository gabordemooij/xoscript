

Jokkalante bu: ['fixture:'] def: { :f
	sama fixture := f.
}.

Jokkalante bu: ['waññ'] def: { <- sama fixture.
}.

Jokkalante bu: ['aantal'] def: { <- sama fixture.
}.


>> x := Dara.
{

	x := ['hello'] 
	wuutal:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] araf: 2)
			)
		)
	ci: (
