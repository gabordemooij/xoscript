Génn bind: ['1,2,3,4,5,6,7,8,9,A,'], taxaw.
>> Scope := Denc xees.
Scope bu: ['initialize:'] def: { :x sama property := x. }.
Scope bu: ['confirm'] def: { Génn bind: [',']. }.
Scope bu: ['natt'] def: {
	Génn bind: sama property.
	man confirm.
	( 1 = 1 ) dëgg: { Génn bind: sama property. man confirm. }.
	( 1 = 0 ) dëkkul: { Génn bind: sama property. man confirm. }.
	>> y := 2. { Génn bind: sama property. man confirm. } fiy: { y wàññi: 1. <- (y > 0). }.
	{ Génn bind: sama property. man confirm. } × 1.
	(Jokkalante ← 1) kenn-ci-kenn: {  Génn bind: sama property. man confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Listin xees one: ['item']) kenn-ci-kenn: { Génn bind: sama property. man confirm. }.
	{ 1 ÷ 0. } jàpp: { Génn bind: sama property. man confirm. }, dox.
	Génn taxaw.
}.
>> scope1 := Scope xees.
scope1 initialize: ['X'].
scope1 natt.
>> function := { 
	sama property := ['Y'].
	Génn bind: sama property.
	man confirm.
	( 1 = 1 ) dëgg: { Génn bind: sama property. man confirm. }.
	( 1 = 0 ) dëkkul: { Génn bind: sama property. man confirm. }.
	>> y := 2. { Génn bind: sama property. man confirm. } fiy: { y wàññi: 1. <- (y > 0). }.
	{ Génn bind: sama property. man confirm. } × 1.
	(Jokkalante ← 1) kenn-ci-kenn: {  Génn bind: sama property. man confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Listin xees one: ['item']) kenn-ci-kenn: { Génn bind: sama property. man confirm. }.
	{ 1 ÷ 0. } jàpp: { Génn bind: sama property. man confirm. }, dox.
	Génn taxaw.
}.
function bu: ['confirm'] def: { Génn bind: [',']. }.
function jëfandikoo: 1 ak: 2.
