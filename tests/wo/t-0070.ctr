>> numbers := ['1,2,3'] xaaj: [','].
Génn bind: ['I got: '] + numbers waññ + [' numbers.'],taxaw.
{ :i Génn bind: ['number #'] + i + [':'] + (numbers barab: i), taxaw.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages xaaj: [' Or '].
Génn bind: ['We serve'], taxaw.
{ :i Génn bind: ['->'] + (beverages barab: i), taxaw. } × (beverages waññ).
Génn bind: (beverages boole: [',']), taxaw.
Génn bind: (numbers boole: ['||']).
