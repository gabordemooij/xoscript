Mbind bu: ['evaluate'] def: {
	>> koodu := Dencukaayu xees: ['/tmp/eval.ctr'].
	koodu bind: (man mbind + ['.']).
	Prograam ay-jumtukaay: ['/tmp/eval.ctr'].
}.

>> a := Jokkalante ← 1 ; 2 ; 3.
>> b := (a mbind).

Génn bind: b, taxaw. 
(['b := '] + b) evaluate.

Génn bind: b ? 2, taxaw. 

Génn bind: (( Jokkalante ← 1 ; 2 ; 3 )), taxaw. 

Génn bind: ((Listin xees) teg: 1 ci: 2), taxaw. 

>> x := ( (Jokkalante ← 1 ; ( Jokkalante ← 9 ) ; Dëgg ) ) mbind.
Génn bind: x, taxaw. 
(['x := '] + x) evaluate.

Génn bind: x ? 1 ? 0, taxaw. 

>> y := (Listin xees) teg: (Jokkalante ← 1) ci: (Jokkalante ← 2).
Génn bind: y, taxaw. 

(['y := '] + y) mbind evaluate.

Génn bind: (y ci: (Jokkalante ← 2) mbind ), taxaw.

Génn bind: (Jokkalante xees), taxaw. 
Génn bind: (Listin xees), taxaw. 
