>> Slurp := Denc xees.

Slurp bu: ['xees'] def: {
	sama str := [''].
}.

Slurp bu: ['tontu:'] def: { :blah
		(sama str = ['']) dëgg: {
			sama str yokk-ci-mujj: blah.
		}, lu-dul: {
			sama str yokk-ci-mujj: [' '].
			sama str yokk-ci-mujj: blah.
		}.
}.

Slurp bu: ['tontu:ak:'] def: { :blah :blahah
		(blah guddaay > 1) dëgg: {
			sama str yokk-ci-mujj: (blah dale: 0 guddaay: (blah guddaay - 1)).
		}, lu-dul: {
			sama str yokk-ci-mujj: blah.
		}.
		sama str yokk-ci-mujj: [' '].
		sama str yokk-ci-mujj: blahah.
}.

Slurp bu: ['obtain'] def: {
	>> buffer := sama str.
	sama str := ['']. <- buffer.
}.


>> x := Slurp xees.
x + 3.
Génn bind: (x obtain), taxaw.
x echo: ['Hello world'].
Génn bind: (x obtain), taxaw.
x tellme: 123 and: 987.
Génn bind: (x obtain), taxaw.
