# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Nataal-seet xees: pattern.
	p méngoo: subject def: { :m :g
		Génn bind: g waññ, bind: [' '], bind: (g boole: ['|']), taxaw. <- m.
	}.
}.
show jëfandikoo: ['(a)|(b)'] ak: ['b'].
show jëfandikoo: ['(a)|(b)'] ak: ['a'].
show jëfandikoo: ['(x)?y'] ak: ['y'].
show jëfandikoo: ['(x)?(y)(z)?'] ak: ['xy'].
