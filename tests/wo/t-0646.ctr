Server init.
Génn bind: ['Database datetime test'], taxaw.

>> db := Maria-DB xees dalalkat: ['localhost'],
	turu-jëfandikukat: ['xo'], 
	baatu-jall: ['pass123'],
	turu-dencukaayu-njoxe: ['xobase'],
	lëkkaloo.

>> tànneefi-seet :=
db laaj-njoxe: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
indi: { :row
	Génn bind: row datetimetest, taxaw.
}.
