#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Nataal-seet xees: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern méngoo: subject def: { :m :x
	Génn bind: m, taxaw.
	Génn bind: x, taxaw. <- ['XXX'].
}.
Génn bind: result, taxaw.