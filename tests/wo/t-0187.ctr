Lim bu: ['factorial'] def: {
	>> total := 1.
	{ :index total leggi-ci: (man - index). } × man. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prograam faraay: 0.

{
2 exponent factorial.
Génn bind: (11 desit: 3), taxaw.
Génn bind: (3.4 waññi), taxaw.
Génn bind: (7.1 kaw), taxaw.
Génn bind: (7.9 suuf), taxaw.
}
dox.

Prograam faaral-njaboot.

usedMemory1 := (Prograam xalaat ? 0).

