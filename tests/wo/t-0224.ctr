
>> countries := Jokkalante xees
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Jokkalante xees
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods ci-lëf-bu-nekk: countries, kenn-ci-kenn: { :key :value
	counter yokk: 1.
}.

Génn bind: (['we serve counter dishes'] counter: counter), taxaw.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] araf-yi tëgg: { :v
	counter yokk: 0.
}.

Génn bind: (['we sort counter dishes'] counter: counter), taxaw.


>> counter := 0.
{
	{
		counter yokk: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Génn bind: (['we calculate counter numbers.'] counter: counter), taxaw.

