
Lim jàng: ['plus:'] tekki: ['+'].
Lim bu: ['+'] def: { :x
	>> rate := 1.
	>> currency := x wonantekat.
	(currency = ['euros']) dëgg: {
		rate := 2.
	}. <- (man plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars wonantekat: ['dollars'].
euros wonantekat: ['euros'].
>> money := dollars + euros.
Génn bind: money, taxaw.
