#Linux
>> OS := Prograam jamono: ['OS'].

>> clock := Waxtu xees.
	
(OS = ['Haiku']) dëgg: {
	clock diiwaan: ['CET'],
	at: 2017, weer: 7, bés: 13,
	waxtu: 18, simaa: 0, saa: 0.
}, lu-dul: {
	clock diiwaan: ['Europe/Amsterdam'],
	at: 2017, weer: 7, bés: 13,
	waxtu: 18, simaa: 0, saa: 0.
}.

clock bu: ['tell'] def: {
	Génn bind: man, taxaw.
}.


clock yokk: 2    waxtu, tell.
clock yokk: 1    waxtu, tell.
clock yokk: 19 simaa, tell.
clock yokk: 1  simaa, tell.
clock yokk: 1  simaa, tell.
clock yokk: 19 saa, tell.
clock yokk: 1  saa, tell.
clock yokk: 1  saa, tell.
clock yokk: 2    at, tell.
clock yokk: 1    at, tell.

(OS = ['Haiku']) dëgg: {
clock yokk: 5   weer.
clock diiwaan: ['CEST'], tell.
}, lu-dul: {
	clock yokk: 5   weer, tell.
}.

clock yokk: 1   weer, tell.
clock yokk: 19    bés, tell.
clock yokk: 1    waxtu, tell.
clock yokk: 120  yard, tell.
