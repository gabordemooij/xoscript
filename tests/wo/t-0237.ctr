
Mbind bu: ['evaluate'] def: {
	>> koodu := Dencukaayu xees: ['/tmp/eval.ctr'].
	koodu bind: (man mbind + ['.']).
	Prograam ay-jumtukaay: ['/tmp/eval.ctr'].
}.

>> map :=
	(Listin xees)
	teg: ['Hi There'] ci: ['two'],
	teg: (Jokkalante ← ['hello'] ; ['world'] ; (Jokkalante ← 1 ; 2; 9) ; Dëkkul) ci: ['one'],
	teg: ( (Listin xees) teg: ['wrrld'] ci: ['misspelled'] ) ci: ['three'],
	teg: (Jokkalante ← ((Listin xees) teg: ['treasure'] ci: ['hidden']) ; 2) ci: ['four']. 
>> str := map mbind.
>> map2 := Dara.
(['map2 := '] + str ) evaluate.
Génn bind: map2 ? ['one'] ? 0.
Génn bind: map2 ? ['one'] ? 1.
Génn bind: map2 ? ['four'] ? 0 ? ['hidden'].
Génn bind: map2 ? ['one'] ? 2 ? 2.
