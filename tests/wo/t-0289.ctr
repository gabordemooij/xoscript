#Linux
>> OS := Prograam oordinaatëer: (Santaane uname -s), jële-ruuj-diggante.

>> Slurp := Denc xees.
Slurp bu: ['xees'] def: {
	sama str := [''].
}.
Slurp bu: ['tontu:'] def: { :blah
		(sama str ≠ ['']) dëgg: {
			sama str yokk-ci-mujj: [' '].
		}.
		sama str yokk-ci-mujj: blah.
}.
Slurp bu: ['tontu:ak:'] def: { :blah :blahah
		(sama str ≠ ['']) dëgg: {
			sama str yokk-ci-mujj: [' '].
		}.
		(blah guddaay > 1) dëgg: {
			sama str yokk-ci-mujj: (blah dale: 0 guddaay: (blah guddaay - 1)).
		}, lu-dul: {
			sama str yokk-ci-mujj: blah.
		}.
		sama str yokk-ci-mujj: [' '].
		sama str yokk-ci-mujj: blahah.
}.
Slurp bu: ['obtain'] def: {
	>> buffer := sama str.
	sama str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text yokk-ci-mujj: ['hello'].
} × 1000.


Génn bind: (
	Prograam oordinaatëer: (
		Slurp xees
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

