

Jokkalante bu: ['column:'] def: { :column
	>> result := Jokkalante xees.
	man kenn-ci-kenn: { :index :row
		row kenn-ci-kenn: { :index :cell
			(index = column) dëgg: { result yokk-ci-mujj: cell. }.
		}.
	}. <- result.
}.


>> a := Jokkalante ←
	(Jokkalante ← 1 ; 2 ; 3) ;
	(Jokkalante ← 4 ; 5 ; 6) ;
	(Jokkalante ← 7 ; 8 ; 9).

>> b := a column: 1.
Génn bind: b, taxaw.

b := a column: 20.
Génn bind: b, taxaw.

b := a column: -100.
Génn bind: b, taxaw.
