>> a := 3.
>> b := a duppitu.
a wàññi: 1.
Génn bind: [' a = '] + a.
Génn bind: [' b = '] + b.
a := 3.
b := a + 4.
Génn bind: [' a = '] + a.
Génn bind: [' b = '] + b.
>> x := 3.
>> y := x duppitu.
x yokk: 10.
y wàññi: 1.
Génn bind: [' x = '] + x.
Génn bind: [' y = '] + y.
>> q := Denc xees.
q bu: ['setProperty:'] def: { :x
	sama prop := x.
}.
q bu: ['getProperty'] def: { <- sama prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Génn bind: [' p = '] + (p getProperty).
