# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := Denc xees.

Log bu: ['say:'] def: { :str
	Génn bind: str, taxaw.
}.

>> Item := Denc xees.

Item bu: ['xees:'] def: { :id <- man xees id: id.
}.

Item bu: ['id:'] def: { :id
	sama id := id.
}.

Item bu: ['id'] def: { <- sama id. }.


Item bu: ['mbind'] def: {
	>> str := ['Item#~no'].
	str ~no: sama id. <- str.
}.


>> Print := Denc xees.

Print bu: ['items'] def: { 
	
	sama item := Item xees: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: sama item
	).
	
	
}.

Print items.