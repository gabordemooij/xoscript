Prograam faraay: 0.
Jokkalante bu: ['sum'] def: {
	>> total := 0.
	man kenn-ci-kenn: { :index :element
		total yokk: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Dencukaayu xees: ['/tmp/test.txt'].
f bind: ['Lorem Ipsum'].
f tëj-lëkkaloo.
  

f := Dencukaayu xees: ['/tmp/test.txt'].
>> text := f jàng.
f tëj-lëkkaloo.



Prograam faaral-njaboot.
usedMemory1 := (Prograam xalaat ? 1).



f := Dencukaayu xees: ['/tmp/test.txt'].
text := f jàng.
f tëj-lëkkaloo.

Prograam faaral-njaboot.
usedMemory2 := (Prograam xalaat ? 1).


f := Dencukaayu xees: ['/tmp/test.txt'].
text := f jàng.
f tëj-lëkkaloo.

Prograam faaral-njaboot.
usedMemory3 := (Prograam xalaat ? 1).



( usedMemory1 = usedMemory2 ak: usedMemory1 = usedMemory3, ak: usedMemory2 = usedMemory3 ) dëgg: {
	Génn bind: ['No memory leaks here'].
}, dëkkul: {
	Génn bind: ['Leaking memory...'].
}.
