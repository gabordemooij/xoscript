>> a := Jokkalante ← Denc ; Dëgg ; Dëkkul ; Dëppante ; 1 ; Lim ; ['Str'] ; Mbind ; { ['Empty']. }.
Génn bind: (a waññ), taxaw.
{ :i
	Génn bind: 
	['a '] + 
	((a ? i) xeetu) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Dara?) mbaa: [''] mbaa: ['NOT']) + 
	[' Nil.'],
	taxaw.
} × (a waññ).
Génn bind: ['but.. Nil is.. '] + ((Dara Dara?) mbaa: ['certainly NIL!'] mbaa: ['not NIL??']), taxaw.