
>> a := Jokkalante ← (Jokkalante ← 100 ; 200 ; 300) ; (Jokkalante ← 9 ; 8 ; 7).
Génn bind: ['at 0,1 :'].
Génn bind: a ? 0 ? 1, taxaw. 
Génn bind: ['at 1,2 :'].
Génn bind: a ? 1 ? 2, taxaw. 
>> menu := Listin xees.
menu teg: (Jokkalante ← ['pizza'] ; ['spaghetti']) ci: ['Italian Cuisine'].
menu teg: (Jokkalante ← ['bifteki'] ; ['suflaki']) ci: ['Greek Cuisine'].
Génn bind: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), taxaw. 
Génn bind: ['but not on the same plate.'], taxaw.
