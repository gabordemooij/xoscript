Prograam faraay: 4.

>> Doubler := Denc xees.
>> Multiplier := Denc xees.
Doubler bu: ['double:and:'] def: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier bu: ['multiply:and:'] def: { :x :y <- (x × y).
}.

Génn bind: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), taxaw.
