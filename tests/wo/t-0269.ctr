#Linux

(Dencukaayu xees: ['/tmp/testje']) nekk dëkkul: {
	Prograam oordinaatëer: ['mkdir /tmp/testje'].	
}.

(Dencukaayu xees: ['/tmp/testje/file1']) nekk dëkkul: {
	Prograam oordinaatëer: ['touch /tmp/testje/file1'].	
}.

(Dencukaayu xees: ['/tmp/testje/folder1']) nekk dëkkul: {
	Prograam oordinaatëer: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Dencukaayu listin: ['/tmp/testje'].

>> q := Jokkalante xees.

l kenn-ci-kenn: { :k :v v kenn-ci-kenn: { :x :y q yokk-ci-mujj: y. }. }.

>> s := q mbind.

(s ëmb: ['file1']) dëgg:   { Génn bind: ['OK'], taxaw. }.
(s ëmb: ['file2']) dëgg:   { Génn bind: ['XX'], taxaw. }.
(s ëmb: ['folder1']) dëgg: { Génn bind: ['OK'], taxaw. }.
