# recursive interpolation not allowed

Génn bind: 
['recursive string interolation enabled: '] + (
	Prograam jikko: 
	['RECURSIVE_STRINTPOL']
), taxaw.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Génn bind: a, taxaw.


Prograam jikko: ['RECURSIVE_STRINTPOL'] taal: Dëgg.

Génn bind: 
['recursive string interpolation enabled: '] + (
	Prograam jikko: 
	['RECURSIVE_STRINTPOL']
), taxaw.

>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Génn bind: a, taxaw.

