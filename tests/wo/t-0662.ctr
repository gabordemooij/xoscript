>> t := Dara.

# you can control the time zone for
# parsing like this:
Waxtu diiwaan: ['CET'].
t := Waxtu bawoo: ['1981-02-03 04:05:06'].
Génn bind: t, taxaw.

# now using CEST time zone:
Waxtu diiwaan: ['CEST'].
t := Waxtu bawoo: ['1981-02-03 04:05:06'].
Génn bind: t, taxaw.

# error if string cannot be parsed
{ Waxtu bawoo: ['1900']. } jàpp: { Dara. }, dox.
