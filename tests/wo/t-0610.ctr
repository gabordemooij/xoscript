
>> Rectangle := Denc xees.

Rectangle bu: ['area'] def: { <- sama guddaay * sama width.
}.

Rectangle bu: ['length:'] def: { :guddaay
	sama guddaay := guddaay.
}.

Rectangle bu: ['width:'] def: { :width
	sama width := width.
}.

Rectangle bu: ['xees'] def: {
	# this will not result into an infinite loop
	>> rectangle := man xees.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle xees.
Génn bind: a area, taxaw. #0

>> b := Rectangle xees length: 2, width: 3.
Génn bind: b area, taxaw. #6

