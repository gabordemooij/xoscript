
Jokkalante bu: ['sum'] def: {
	>> total := 0.
	man kenn-ci-kenn: { :index :element
		total yokk: element.
	}. <- total.
}.

>> a := Jokkalante ← 9 ; 8 ; 7.
Génn bind: (a sum), taxaw. 
>> a := Jokkalante ← 1 ; 9.
Génn bind: (a sum), taxaw. 
>> a := Jokkalante ← ['o'] ; 2.
Génn bind: (a sum), taxaw. 
Génn bind: (Jokkalante xees sum), taxaw. 
