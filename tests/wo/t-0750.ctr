Génn bind: ['Test object'], taxaw.
>> a := Denc xees. 

a bu: ['item:'] def: { :nil
	sama nil := nil. 
}.

a bu: ['item'] def: { <- sama nil.
}.

a item: Dara.

Génn bind: a item, taxaw.

>> old-nil-address := a item royuwaay dëkkuwaayu-xalaat.
a save-as: ['/tmp/a.bin'].
Génn bind: ['========== RELOADING SNAP:'], taxaw.

>> b := Denc load-from: ['/tmp/a.bin'].

(b item royuwaay dëkkuwaayu-xalaat = old-nil-address) dëgg: {
	Génn bind: ['Object link re-attached.'], taxaw.
}.

Génn bind: b item, taxaw.
