#...
>> del := conn1 laaj-njoxe: ['DELETE FROM book WHERE id > 0'].
{  del jëfe. conn1 dëggal. } jàpp: { :e conn1 delloo-gannaaw.  }, dox.

>> insert := conn1 laaj-njoxe: ['INSERT INTO book (id) VALUES(null)'].
insert jëfe.

>> waññ := conn1 laaj-njoxe: ['SELECT COUNT(*) AS num FROM book'].
waññ indi: { :row Génn bind: row num, taxaw. }.

# does not show up
# insert not committed on connection 1
>> waññ := conn2 laaj-njoxe: ['SELECT COUNT(*) AS num FROM book'].
waññ indi: { :row Génn bind: row num, taxaw. }.
