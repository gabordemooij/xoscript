# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB xees dalalkat: ['localhost'],
	turu-jëfandikukat: ['xo'],
	baatu-jall: ['pass123'],
	turu-dencukaayu-njoxe: ['xobase'],
	lëkkaloo.

>> tànneefi-seet := db laaj-njoxe: ['SELECT %% FROM'].
{ tànneefi-seet jëfe. } jàpp: { :e
	Génn bind: ( e ëmb: ['%%'] ), taxaw.
}, dox.
