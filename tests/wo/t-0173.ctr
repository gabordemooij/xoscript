

Jokkalante bu: ['sum'] def: {
	>> total := 0.
	man kenn-ci-kenn: { :index :element
		total yokk: element.
	}. <- total.
}.

Jokkalante bu: ['product'] def: {
	>> total := 1.
	man kenn-ci-kenn: { :index :element
		total leggi-ci: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prograam faraay: 0.

{

>> a := Jokkalante ← ['hello'] ; ['world'] ; Dëgg ; Dara ; 666.
a := a + ( Jokkalante ← 1 ).
Génn bind: ( ['sum: '] + ( a sum ) ), taxaw.
Génn bind: ( ['min: '] + ( a ndaw ) ), taxaw.
Génn bind: ( ['max: '] + ( a mag ) ), taxaw.
Génn bind: ( ['3rd: '] + ( a ? 2 ) ), taxaw.
Génn bind: ( ['prd: '] + ( a product ) ), taxaw.
a tëgg: { :a :b <- (b - a). }.
a kenn-ci-kenn: { :i :e Génn bind: ( i - 0 ), taxaw. }.

} dox.

Prograam faaral-njaboot.
usedMemory1 := (Prograam xalaat ? 0).


{

>> a := Jokkalante ← ['hello'] ; ['world'] ; Dëgg ; Dara ; 666.
a := a + ( Jokkalante ← 1 ).
Génn bind: ( ['sum: '] + ( a sum ) ), taxaw.
Génn bind: ( ['min: '] + ( a ndaw ) ), taxaw.
Génn bind: ( ['max: '] + ( a mag ) ), taxaw.
Génn bind: ( ['3rd: '] + ( a ? 2 ) ), taxaw.
Génn bind: ( ['prd: '] + ( a product ) ), taxaw.
a tëgg: { :a :b <- (b - a). }.
a kenn-ci-kenn: { :i :e Génn bind: ( i - 0 ), taxaw. }.

} dox.



Prograam faaral-njaboot.
usedMemory2 := (Prograam xalaat ? 0).


{

>> a := Jokkalante ← ['hello'] ; ['world'] ; Dëgg ; Dara ; 666.
a := a + ( Jokkalante ← 1 ).
Génn bind: ( ['sum: '] + ( a sum ) ), taxaw.
Génn bind: ( ['min: '] + ( a ndaw ) ), taxaw.
Génn bind: ( ['max: '] + ( a mag ) ), taxaw.
Génn bind: ( ['3rd: '] + ( a ? 2 ) ), taxaw.
Génn bind: ( ['prd: '] + ( a product ) ), taxaw.
a tëgg: { :a :b <- (b - a). }.
a kenn-ci-kenn: { :i :e Génn bind: ( i - 0 ), taxaw. }.

} dox.



Prograam faaral-njaboot.
usedMemory3 := (Prograam xalaat ? 0).

( usedMemory1 = usedMemory2 ak: usedMemory1 = usedMemory3, ak: usedMemory2 = usedMemory3 ) dëgg: {
	Génn bind: ['No memory leaks here'].
}, dëkkul: {
	Génn bind: ['Leaking memory...'].
}.
