# test buffers PKI/Sign 
Server init.

>> long := ( Jokkalante xees feese: 1000 ak: ['a'] ) boole: [''].

# sign a message
Génn bind: ( 
	Wàqu-kaaraange xaatim: ['abc'] ak: long
), taxaw.

Génn bind: ( 
	Wàqu-kaaraange
		seet: ['abc'] 
		xaatim-bi: long 
		ak: long
), taxaw.

Génn bind: (
	Wàqu-kaaraange xaatimu-baatu-jall: long wóoral: long
), taxaw.
