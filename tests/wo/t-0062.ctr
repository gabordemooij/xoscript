Dëppante bu: ['xor:'] def: { :a :b <- ((a ak: b du) walla: (a du ak: b)).
}.

>> o := Denc xees.
o bu: ['hello'] def: { ['Empty']. }.
{ o bu: 2 def: 3.} jàpp: { :e Génn bind: e, taxaw. }, dox.
{ o bu: ['natt'] def: 3.} jàpp: { :e Génn bind: e, taxaw. }, dox.
{ o bu: ['hello'] def: { ['Empty']. }.} jàpp: { :e Génn bind: e, taxaw. }, dox. 
{ >> z := 4 ÷ 0. } jàpp: { :e Génn bind: e, taxaw. }, dox. 
{ (Dëgg ak: Dara) dëgg: { Génn bind: ['X'].}. } jàpp: { :e Génn bind: e, taxaw. }, dox. 
{ ([''] xor: 0) dëgg: { Génn bind: ['X'].}. } jàpp: { :e Génn bind: e, taxaw. }, dox. 
{ (1 < ['2']) dëgg: { Génn bind: ['OK']. }. } jàpp: { :e Génn bind: e, taxaw. }, dox. 
{ (1 < ['2.0']) dëgg: { Génn bind: ['OK']. }. } jàpp: { :e Génn bind: e, taxaw. }, dox. 
{ (1 < ['x2.0']) dëgg: { Génn bind: ['NO!']. }. } jàpp: { :e Génn bind: e, taxaw. }, dox. 
{ Génn bind: (['hello OK there'] dale: ['6'] guddaay: ['2']). } dox. 
