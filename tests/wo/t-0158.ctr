>> x := [' hallo '].

>> y := x mag-araf.
Génn bind: x, taxaw.
Génn bind: (x mooy: y), taxaw.

>> y := x ndaw-araf.
Génn bind: x, taxaw.
Génn bind: (x mooy: y), taxaw.

>> y := x jële-ruuj-diggante.
Génn bind: x, taxaw.
Génn bind: (x mooy: y), taxaw.

>> y := x tëb: 1.
Génn bind: x, taxaw.
Génn bind: (x mooy: y), taxaw.

>> y := x dale: 1 guddaay: 2.
Génn bind: x, taxaw.
Génn bind: (x mooy: y), taxaw.