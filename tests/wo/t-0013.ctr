
>> Animal := Denc xees.
Animal bu: ['xees'] def: { <- man xees init.
}.

Animal bu: ['init'] def: {
	sama sound := ['?'].
	sama legs := 4.
}.

>> Dog := Animal xees.
Dog bu: ['init'] def: {
	man init.
	sama sound := ['barks'].
}.

Animal bu: ['mbind'] def: { <- sama legs mbind + sama sound.
}.

>> poodle := Dog xees.
Génn bind: poodle, taxaw.

