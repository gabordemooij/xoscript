

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prograam faraay: 0.

{ :i Génn bind: i. } × 4.
Génn taxaw.
{ :i Génn bind: (4 - i). } × 4.
Génn taxaw.
( 1 > 2 ) dëkkul: { Génn bind: ['BLOCK 1'], taxaw. }.
( 2 > 1 ) dëgg:  { Génn bind: ['BLOCK 2'], taxaw. }.

>> i := 0.
{ Génn bind: i. i yokk: 1. } fiy: { <- ( i < 3). }.
Génn taxaw.

i := 3.
{ Génn bind: i. i := i - 1. } fiy: { <- ( i > 0). }.
Génn taxaw.


Prograam faaral-njaboot.

usedMemory1 := (Prograam xalaat ? 0).


{ :i  Génn bind: i. } × 4.
Génn taxaw.
{ :i  Génn bind: (4 - i). } × 4.
Génn taxaw.
( 1 > 2 ) dëkkul: { Génn bind: ['BLOCK 1'], taxaw. }.
( 2 > 1 ) dëgg:  { Génn bind: ['BLOCK 2'], taxaw. }.

>> i := 0.
{ Génn bind: i. i yokk: 1. } fiy: { <- ( i < 3). }.
Génn taxaw.

i := 3.
{ Génn bind: i. i := i - 1. } fiy: { <- ( i > 0). }.
Génn taxaw.



Prograam faaral-njaboot.
usedMemory2 := (Prograam xalaat ? 0).


{ :i Génn bind: i. } × 4.
Génn taxaw.
{ :i Génn bind: (4 - i). } × 4.
Génn taxaw.
( 1 > 2 ) dëkkul: { Génn bind: ['BLOCK 1'], taxaw. }.
( 2 > 1 ) dëgg:  { Génn bind: ['BLOCK 2'], taxaw. }.

>> i := 0.
{ Génn bind: i. i yokk: 1. } fiy: { <- ( i < 3). }.
Génn taxaw.

i := 3.
{ Génn bind: i. i := i - 1. } fiy: { <- ( i > 0). }.
Génn taxaw.

Prograam faaral-njaboot.
usedMemory3 := (Prograam xalaat ? 0).



( usedMemory1 = usedMemory2 ak: usedMemory1 = usedMemory3, ak: usedMemory2 = usedMemory3 ) dëgg: {
	Génn bind: ['No memory leaks here'].
}, dëkkul: {
	Génn bind: ['Leaking memory...'].
}.
