


>> Deck := Jokkalante xees.
Deck bu: ['print'] def: {
        >> len := man waññ - 1.
        { :i
                >> len2 := man waññ - 1.
                Génn bind: ['len: '].
                Génn bind: len, taxaw.
                Génn bind: ['len2: '].
                Génn bind: len2, taxaw.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
