Génn bind: ['Test object'], taxaw.
>> l := Jokkalante xees ; 1 ; ( Jokkalante xees ; (Waxtu xees: 1) ; (Int64 bawoo-ci-mbind: ['321']) ; (Jokkalante xees ; 3)).
Génn bind: l, taxaw.
>> old-lst-address := l royuwaay dëkkuwaayu-xalaat.
l save-as: ['/tmp/a.bin'].
Génn bind: ['========== RELOADING SNAP:'], taxaw.
>> b := Denc load-from: ['/tmp/a.bin'].
(b royuwaay dëkkuwaayu-xalaat = old-lst-address) dëgg: {
	Génn bind: ['Object link re-attached.'], taxaw.
}.
Génn bind: b, taxaw.
