>> y := ['Hello'].
>> q := { ['']. }.
>> p := Dëgg.
>> a := Jokkalante ← 1 ; 2 ; 3 ; 4.
>> c := Denc xees.
c bu: ['greet:'] def: { Génn bind: ['greet!']. }.

>> usedMemory1 := 0.
