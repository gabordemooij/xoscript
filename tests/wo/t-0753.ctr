Génn bind: ['Test object'], taxaw.
>> a := Denc xees. 

a bu: ['item:'] def: { :fmt
	sama fmt := fmt. 
}.

a bu: ['item'] def: { <- sama fmt.
}.

a item: ( Melo xees: ['|%s|'] ).

Génn bind: a item, taxaw.

>> old-fmt-address := a item royuwaay dëkkuwaayu-xalaat.
a save-as: ['/tmp/a.bin'].
Génn bind: ['========== RELOADING SNAP:'], taxaw.

>> b := Denc load-from: ['/tmp/a.bin'].

(b item royuwaay dëkkuwaayu-xalaat = old-fmt-address) dëgg: {
	Génn bind: ['Object link re-attached.'], taxaw.
}.

Génn bind: ( b item jëfandikoo: ['hello'] ), taxaw.
