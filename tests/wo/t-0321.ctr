# test qualifiers

Prograam faaral-njaboot.

>> Fruit := Denc xees.
Fruit bu: ['xees'] def: {
	>> f := man xees.
	f apples: 0. <- f.
}.
Fruit bu: ['apples:'] def: { :a sama apples := a. }.
Fruit bu: ['apples'] def: { <- sama apples. }.
Fruit bu: ['+'] def: { :f
	>> n := Fruit xees.
	n apples: (f apples + sama apples). <- n.
}.
Lim bu: ['apples'] def: { <- ((Fruit xees) apples: man).
}.

Fruit bu: ['mbind'] def: { <- sama apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Génn bind: q, taxaw.




q := 3 apples + 4 apples.
