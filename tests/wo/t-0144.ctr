



>> CoffeeGrounds := Denc xees.
CoffeeGrounds bu: ['extract'] def: { <- ['coffee']. }.

>> CoffeeMachine := Denc xees.
CoffeeMachine bu: ['init'] def: {
	sama coffeegrounds := CoffeeGrounds xees.
}.
CoffeeMachine bu: ['xees'] def: { <- CoffeeMachine `new init.
}.

CoffeeMachine bu: ['makeTea'] def: { <- (sama tealeaves extract). }.
CoffeeMachine bu: ['makeCoffee'] def: { <- (sama coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine xees.

Génn bind:
	coffeeDream 
	makeCoffee.

Génn bind:
	coffeeDream 
	makeTea.
