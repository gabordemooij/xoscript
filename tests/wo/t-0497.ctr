Server init.

# write a test file
>> f := Dencukaayu xees: ['/tmp/test.gif'].
f bind: ['GIF87a01234567810'].

# serve the file
Server jàllale: ['test.gif'] njëkk-baat: ['/tmp/'].

Génn taxaw.

Génn bind: ['Outside container (security):'], taxaw.
{ Server jàllale: ['../passwd'] njëkk-baat: ['/tmp/']. }
jàpp: { :e Génn bind: e, taxaw. },
dox.

Génn bind: ['Invalid prefix:'], taxaw.
{ Server jàllale: ['test.gif'] njëkk-baat: ['z:\\']. }
jàpp: { :e Génn bind: e, taxaw. },
dox.

Génn bind: ['Non-existant file:'], taxaw.
{ Server jàllale: ['xxx.xxx'] njëkk-baat: ['/tmp/']. }
jàpp: { :e Génn bind: e, taxaw. },
dox.
