Génn bind: ['Test object'], taxaw.
>> p := Yoon /tmp.
Génn bind: p, taxaw.
>> old-p-address := p royuwaay dëkkuwaayu-xalaat.
p save-as: ['/tmp/a.bin'].
Génn bind: ['========== RELOADING SNAP:'], taxaw.
>> b := Denc load-from: ['/tmp/a.bin'].
(b royuwaay dëkkuwaayu-xalaat = old-p-address) dëgg: {
	Génn bind: ['Object link re-attached.'], taxaw.
}.
Génn bind: b, taxaw.
