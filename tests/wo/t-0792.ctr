Server init.

>> DB := Maria-DB xees dalalkat: ['localhost'],
	turu-jëfandikukat: ['xo'],
	baatu-jall: ['pass123'],
	turu-dencukaayu-njoxe: ['xobase'],
	lëkkaloo.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB laaj-njoxe: SQL.

# now you don't have to set DB
query2 indi: { :row
	Génn bind: row world, taxaw.
}.
