
>> city := Jokkalante ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Jokkalante ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature ci-lëf-bu-nekk: city.
>> cities := weather dugal-yi tëgg: { :a :b <- (a dippee: b). }.
>> temperatures := weather njëriñ-yi tëgg: { :a :b <- (a dippee: b) bon?. }.

Génn bind: (cities boole: [',']), taxaw.
Génn bind: (temperatures boole: [',']), taxaw.
