# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Wàqu-kaaraange 
	xaatimu-baatu-jall: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Wàqu-kaaraange 
	xaatimu-baatu-jall: hash wóoral: a1.
	# fail 
>> b := Wàqu-kaaraange
	xaatimu-baatu-jall: hash wóoral: a2.
	# ok!

Génn bind: a, taxaw.
Génn bind: b, taxaw.

