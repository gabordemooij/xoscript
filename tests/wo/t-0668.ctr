# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob xees: 8, bytes: (
	Jokkalante xees ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Génn bind: ( utf16 dindi-kood: ['utf16le'] ), taxaw.

utf16 bàyyi.
>> utf32 := Blob xees: 13, bytes: (
	Jokkalante xees ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Génn bind: ( utf32 dindi-kood: ['utf32be'] ), taxaw.
utf32 bàyyi.