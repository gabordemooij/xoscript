Lim bu: ['roman'] def: {
	>> lim := man duppitu.
	>> roman := [''].
	{
		{
			(lim ≥ 1000) dëgg: {
				roman yokk-ci-mujj: ['Ⅿ'].
				lim wàññi: 1000.
			}, dog.
		
			(lim ≥ 500) dëgg: {
				roman yokk-ci-mujj: ['Ⅾ'].
				lim wàññi: 500.
			}, dog.
		
			(lim ≥ 100) dëgg: {
				roman yokk-ci-mujj: ['Ⅽ'].
				lim wàññi: 100.
			}, dog.
		
			(lim ≥ 50) dëgg: {
				roman yokk-ci-mujj: ['Ⅼ'].
				lim wàññi: 50.
			}, dog.
		
			(lim ≥ 50) dëgg: {
				roman yokk-ci-mujj: ['Ⅼ'].
				lim wàññi: 50.
			}, dog.
		
			(lim ≥ 10) dëgg: {
				roman yokk-ci-mujj: ['Ⅹ'].
				lim wàññi: 10.
			}, dog.
			
			(lim ≥ 9) dëgg: {
				roman yokk-ci-mujj: ['Ⅸ'].
				lim wàññi: 9.
			}, dog.
			
			(lim ≥ 5) dëgg: {
				roman yokk-ci-mujj: ['Ⅴ'].
				lim wàññi: 5.
			}, dog.
			
			(lim ≥ 4) dëgg: {
				roman yokk-ci-mujj: ['Ⅳ'].
				lim wàññi: 4.
			}, dog.
			
			(lim ≥ 1) dëgg: {
				roman yokk-ci-mujj: ['Ⅰ'].
				lim wàññi: 1.
			}, dog.
		} yoonu.
	} fiy: { <- lim > 0. }. <- roman.
}.

Génn bind: 1 roman, taxaw.
Génn bind: 2 roman, taxaw.
Génn bind: 4 roman, taxaw.
Génn bind: 8 roman, taxaw.
Génn bind: 16 roman, taxaw.
Génn bind: 32 roman, taxaw.
Génn bind: 64 roman, taxaw.
Génn bind: 128 roman, taxaw.
Génn bind: 256 roman, taxaw.
Génn bind: 1024 roman, taxaw.
