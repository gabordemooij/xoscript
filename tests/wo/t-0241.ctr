

Mbind bu: ['evaluate'] def: {
	>> koodu := Dencukaayu xees: ['/tmp/eval.ctr'].
	koodu bind: (man mbind + ['.']).
	Prograam ay-jumtukaay: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Jokkalante ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q mbind.
Génn bind: x, taxaw.
>> y := Dara.
(['y := '] + x ) evaluate.
Génn bind: y ? 0, taxaw.

q := Listin teg: ['\[''] ci: ['\['quote\']'].
x := q mbind.
Génn bind: x, taxaw.
y := Dara.
(['y := '] + x ) evaluate.

>> q := (Listin xees) teg:['\[''] ci:['\['quote\[''].
Génn bind: y ? ['\['quote\']'], taxaw.
