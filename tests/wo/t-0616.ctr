Jokkalante bu: ['duppitu'] def: {
	>> duppitu := Jokkalante xees.
	man kenn-ci-kenn: { :lim :section
		duppitu yokk-ci-mujj: section dellu-ci-bopp duppitu.
	}. <- duppitu.
}.

>> sheep := Jokkalante xees ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep duppitu.
clones kenn-ci-kenn: { :lim :sheep
	sheep yokk-ci-mujj: ['2'].
}.

Génn bind: sheep, taxaw.
Génn bind: clones, taxaw.
