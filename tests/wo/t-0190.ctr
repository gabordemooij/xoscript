#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prograam faraay: 0.

{
Waxtu léegi.
Waxtu xaar: 1.
Génn bind: Prograam laaj-yi, taxaw.
Prograam laaj: 0.
Lim random.
Génn bind: (Prograam oordinaatëer: ['echo 'Hello'']).
} dox.

Prograam faaral-njaboot.
usedMemory1 := (Prograam xalaat ? 0).

{
Waxtu léegi.
Waxtu xaar: 1.
Génn bind: Prograam laaj-yi, taxaw.
Prograam laaj: 0.
Lim random.
Génn bind: (Prograam oordinaatëer: ['echo 'Hello'']).
} dox.

Prograam faaral-njaboot.
usedMemory2 := (Prograam xalaat ? 0).

{
Waxtu léegi.
Waxtu xaar: 1.
Génn bind: Prograam laaj-yi, taxaw.
Prograam laaj: 0.
Lim random.
Génn bind: (Prograam oordinaatëer: ['echo 'Hello'']).
} dox.

Prograam faaral-njaboot.
usedMemory3 := (Prograam xalaat ? 0).



( usedMemory1 = usedMemory2 ak: usedMemory1 = usedMemory3, ak: usedMemory2 = usedMemory3 ) dëgg: {
	Génn bind: ['No memory leaks here'].
}, dëkkul: {
	Génn bind: ['Leaking memory...'].
}.
