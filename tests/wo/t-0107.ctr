
Génn bind: ['Break for-loop, 0-4.'], taxaw.
{ :i
	Génn bind: ['iteration #'] + i, taxaw.
	(i = 4) dog.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Génn bind: ['Break while-true loop, 0-4.'], taxaw.
{
	Génn bind: ['iteration #'] + x, taxaw.
	x yokk: 1.
	((x < 5) du) dog.
} fiy: xIsLessThan10.

Génn bind: ['Break while-false loop, 5,4.'], taxaw.
{
	Génn bind: ['iteration #'] + x, taxaw.
	x wàññi: 1.
	(x = 3) dog.
} fiy: { <- (x > 0). }.

Génn bind: ['Break times loop, 1-4.'], taxaw.
{ :i
	Génn bind: ['iteration #'] + i, taxaw.
	(i = 4) dog.
} × 5.

Génn bind: ['Break block, dont print line.'], taxaw.
{ Dëgg dog. Génn bind: ['dont write this!'], taxaw. } dox.

Génn bind: ['Break block, dont fire catch...'], taxaw.
{ Dëgg dog. Génn bind: ['dont write this!'], taxaw. } jàpp: { Génn bind: ['Dont catch this!']. }, dox.

Génn bind: ['Test Array each-loop: 0,1'], taxaw.
(Jokkalante ← 1 ; 2 ; 3) naat: { :i
	Génn bind: ['iteration #'] + i, taxaw.
	(i = 1) dog.
}.

Génn bind: ['Test Map each-loop: c only'], taxaw.
>> m := Listin xees.
m teg: ['first'] ci: ['a'], teg: ['second'] ci: ['b'], teg: ['third'] ci: ['c'].
m kenn-ci-kenn: { :k :v
	Génn bind: ['iteration'] + v + k, taxaw.
	Dëgg dog.
}.

