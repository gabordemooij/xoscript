# backslashes must survive code serialization, strings must not end early
>> njëriñ-yi := Jokkalante xees
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

njëriñ-yi kenn-ci-kenn: { :i :value
	>> d := Listin xees.
	d teg: value ci: ['k'].
	>> r := d koodu denc.
	Génn bind: r waññ, taxaw.
	Génn bind: ( (r ci: ['k']) = value ), taxaw.
}.
