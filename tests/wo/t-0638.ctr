
Server init.
>> rq := Laaj-HTTP xees.
Génn bind: ['HTTP-GET d[]=']  + ( rq get-limu: ['d[]'] ), taxaw. # GET
Génn bind: ['HTTP-GET f[]=']  + ( rq get-limu: ['f[]'] ), taxaw. # GET
Génn bind: ['HTTP-POST e[]='] + ( rq post-limu: ['e[]'] ), taxaw. # GET
Génn bind: ['HTTP-POST c=']   + ( rq post: ['c'] ), taxaw. # GET
Génn bind: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), taxaw. # GET
