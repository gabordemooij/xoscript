Server init.
Génn bind: ['Database time test'], taxaw.

>> db := Maria-DB xees dalalkat: ['localhost'],
	turu-jëfandikukat: ['xo'], 
	baatu-jall: ['pass123'],
	turu-dencukaayu-njoxe: ['xobase'],
	lëkkaloo.

>> tànneefi-seet :=
db laaj-njoxe: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
indi: { :row
	Génn bind: row timetest, taxaw.
}.
