# test qualifiers

>> $ := Denc xees.

$ bu: ['tontu:'] def: { :x
	
	>> operation := x araf: 0.
	>> valuta := x araf: 1.
	>> money := x tëb: 2.
	
	>> amount := 0.

	( operation = ['+'] ) dëgg: {
		( valuta = ['£'] ) dëgg: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Génn bind: x, taxaw.


>> Fruit := Denc xees.

Fruit bu: ['xees'] def: {
	>> f := man xees.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit bu: ['apples:'] def: { :a sama apples := a. }.
Fruit bu: ['oranges:'] def: { :p sama oranges := p. }.
Fruit bu: ['apples'] def: { <- sama apples. }.
Fruit bu: ['oranges'] def: { <- sama oranges. }.

Fruit bu: ['+'] def: { :f
	
	>> n := Fruit xees.
	f yokk: 1.
	
	n apples: (f apples + sama apples).
	n oranges:  (f oranges  + sama oranges). <- n.
}.

Fruit bu: ['mbind'] def: { <- ( sama apples mbind + [' apples and '] + sama oranges + [' oranges'] ).
}.

Lim bu: ['apples'] def: { <- ((Fruit xees) apples: man).
}.

Lim bu: ['apple'] def: { <- ((Fruit xees) apples: man).
}.

Lim bu: ['oranges'] def: { <- ((Fruit xees) oranges: man).
}.




Génn bind: (1 apple + 3 oranges + 4 apples), taxaw.


Mbind bu: ['twice'] def: { <- ((man mbind) + (man mbind)).
}.



Génn bind: ['❤❤❤'] twice.



