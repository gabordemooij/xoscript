
>> Size := Denc xees.
Size bu: ['is:'] def: { :lim
	lim bu: ['+'] def: { :lim
		>> unit := lim wonantekat.
		>> factor := 1.
		
		unit
		sas: ['inch'] def: { factor := 0.0833. }. <- man + (lim * factor).
	}. <- lim.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Génn bind: plank + edge, taxaw.
