Mbind bu: ['html'] def: { <- (
		man
		wuutal: ['&'] ci: ['&amp;'],
		wuutal: ['<'] ci: ['&lt;'],
		wuutal: ['>'] ci: ['&gt;'],
		wuutal: ['''] ci: ['&apos;'],
		wuutal: ['"'] ci: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prograam faraay: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Génn bind: txt duppitu html, taxaw.
Génn bind: txt duppitu ndaw-araf, taxaw.
Génn bind: txt duppitu mag-araf, taxaw.
} dox.

Prograam faaral-njaboot.

usedMemory1 := (Prograam xalaat ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Génn bind: txt duppitu html, taxaw.
Génn bind: txt duppitu ndaw-araf, taxaw.
Génn bind: txt duppitu mag-araf, taxaw.
} dox.

Prograam faaral-njaboot.
usedMemory2 := (Prograam xalaat ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Génn bind: txt duppitu html, taxaw.
Génn bind: txt duppitu ndaw-araf, taxaw.
Génn bind: txt duppitu mag-araf, taxaw.
} dox.

Prograam faaral-njaboot.
usedMemory3 := (Prograam xalaat ? 0).



( usedMemory1 = usedMemory2 ak: usedMemory1 = usedMemory3, ak: usedMemory2 = usedMemory3 ) dëgg: {
	Génn bind: ['No memory leaks here'].
}, dëkkul: {
	Génn bind: ['Leaking memory...'].
}.
