

# create a 64-bit integer for exact calculations
>> a := Int64 bawoo-ci-mbind: ['123'].

# to string
Génn bind: a, taxaw.

# divide
Génn bind: a / (Int64 bawoo-ci-mbind: ['3']), taxaw.

# multiply
Génn bind: a * (Int64 bawoo-ci-mbind: ['2']), taxaw.

# add
Génn bind: a + (Int64 bawoo-ci-mbind: ['1']), taxaw.

# subtract
Génn bind: a - (Int64 bawoo-ci-mbind: ['2']), taxaw.

# compare
Génn bind: ( a =   (Int64 bawoo-ci-mbind: ['123'])), taxaw.
Génn bind: ( a !=: (Int64 bawoo-ci-mbind: ['124'])), taxaw.
Génn bind: ( a <   (Int64 bawoo-ci-mbind: ['124'])), taxaw.
Génn bind: ( a >   (Int64 bawoo-ci-mbind: ['122'])), taxaw.
Génn bind: ( a >=: (Int64 bawoo-ci-mbind: ['123'])), taxaw.
Génn bind: ( a <=: (Int64 bawoo-ci-mbind: ['123'])), taxaw.





	