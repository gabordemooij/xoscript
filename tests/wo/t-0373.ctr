# compliance test

# use international numbers

Génn bind: ['1000 -> '].
Génn bind: 1000, taxaw. #1000

Génn bind: ['1.5 -> '].
Génn bind: 1.5, taxaw.  #1.5

Génn bind: ['1001.5 -> '].
Génn bind: 1.5 + 1000, taxaw. #1001.5

# use 0-indexed arrays
>> x := Jokkalante xees ; 1 ; 2 ; 3.
>> y := Jokkalante xees ; ['a'] ; ['b'] ; ['c'].

Génn bind: ['1 -> '].
Génn bind: x ? 0, taxaw. #1

Génn bind: ['1 -> '].
Génn bind: (x ci: 0), taxaw. #1

Génn bind: ['1 -> '].
Génn bind: x njëkk, taxaw. #1

Génn bind: ['3 -> '].
Génn bind: x mujj, taxaw. #3

Génn bind: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Génn bind: (x ci-lëf-bu-nekk: y), taxaw.

Génn bind: ['1 -> '].
Génn bind: (x dale: 0 guddaay: 1) njëkk, taxaw. #1

Génn bind: ['0 -> '].
Génn bind: (x wone: 1), taxaw. #0

x teg: 9 ci: 0.

Génn bind: ['9 -> '].
Génn bind: (x ci: 0), taxaw. #9

x yokk-ci-ndorte: 8.
Génn bind: ['8 -> '].
Génn bind: (x ci: 0), taxaw. #9


x yokk-ci-mujj: 10.
Génn bind: ['10 -> '].
Génn bind: (x ci: 4), taxaw. #10








