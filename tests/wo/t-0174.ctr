


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prograam faraay: 0.
>> palette := Dara.
>> colors := Dara.

{
palette := Listin xees.
palette 
	teg: ['#F00'] ci: ['red'],
	teg: ['#0F0'] ci: ['green'],
	teg: ['#00F'] ci: ['blue'].
Génn bind: ['number of RGB codes in palette: '] + ( palette waññ ), taxaw.
Génn bind: ['RGB code of green is: '] + ( palette ? ['green'] ), taxaw.
colors := [''].
( palette kenn-ci-kenn: { :tur :koodu
		colors := colors + ( tur + [':'] + koodu ).
} ).
Génn bind: ['All colors in palette: '] + colors, taxaw.
} dox.
Prograam faaral-njaboot.
usedMemory1 := (Prograam xalaat ? 0).

{
