

>> Matryoshka := Denc xees.
Matryoshka bu: ['double:'] def: { :secret
	sama secret := secret × 2.
}.
Matryoshka bu: ['xees:'] def: { :secret
	>> answer := Dara.
	>> t := (secret > 255).
	Génn bind: (secret + [' | '] + t), taxaw.
	t dëgg: {
		answer := secret.
	}, lu-dul: {
		answer := Matryoshka dellu-ci-bopp xees: (man double: secret).
	}. <- answer.
}.

>> x := Matryoshka xees: 2.
