#OBSD
>> dirname := [''].
{ dirname yokk-ci-mujj: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Prograam oordinaatëer: command.
Prograam chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename yokk-ci-mujj: ['YYYYYYYY']. } * 20.
Dencukaayu xees: filename, bind: ['sometext'].
{ Dencukaayu listin: ['/tmp/'] + dirname. } * 1000.
Génn bind: ['no crash'], taxaw.

