# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Wàqu-kaaraange sos-ay-caabi.

# private (secret) key
>> sk := keys njëkk.

# public key
>> pk := keys mujj.

# sign a message
>> sig := Wàqu-kaaraange xaatim: ['abc'] ak: sk.

# check message (ok)
Génn bind: ( 
	Wàqu-kaaraange
		seet: ['abc'] 
		xaatim-bi: sig 
		ak: pk 
), taxaw.

# check message (fail)
Génn bind: ( 
	Wàqu-kaaraange 
		seet: ['abd'] 
		xaatim-bi: sig 
		ak: pk 
), taxaw.