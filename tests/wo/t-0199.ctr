
Prograam faraay: 4.

>> Animal := Denc xees.
Animal bu: ['make'] def: {
	>> animal := Denc xees.
	animal bu: ['makeSound'] def: {
		Génn bind: sama sound.
	}. <- animal.
}.
>> Cat := Denc xees.
Cat bu: ['make'] def: {
	>> cat := Animal make.
	cat bu: ['init'] def: {
		sama sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
