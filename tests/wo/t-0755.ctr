Génn bind: ['Test object'], taxaw.
>> greeter := Denc xees.
greeter bu: ['name:'] def: { :tur
	sama xname := tur. 
}.
greeter bu: ['greet'] def: {
	Génn bind: ['Hello '] + sama xname, taxaw.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Génn bind: ['========== RELOADING SNAP:'], taxaw.
>> b := Denc load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
