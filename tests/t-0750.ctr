Out write: ['Test object'], stop.
>> a := Object new. 

a on: ['item:'] do: { :nil
	own nil := nil. 
}.

a on: ['item'] do: {
	<- own nil.
}.

a item: None.

Out write: a item, stop.

>> old-nil-address := a item prototype memory-address.
a save-as: ['/tmp/a.bin'].
Out write: ['========== RELOADING SNAP:'], stop.

>> b := Object load-from: ['/tmp/a.bin'].

(b item prototype memory-address = old-nil-address) true: {
	Out write: ['Object link re-attached.'], stop.
}.

Out write: b item, stop.
