


>> Deck := Lëscht nei.
Deck bei: ['print'] maachen: {
        >> len := selwer zielen - 1.
        { :i
                >> len2 := selwer zielen - 1.
                Ausgab schreiwen: ['len: '].
                Ausgab schreiwen: len, nei-zeil.
                Ausgab schreiwen: ['len2: '].
                Ausgab schreiwen: len2, nei-zeil.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
