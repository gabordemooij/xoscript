Ausgab schreiwen: ['Test object'], nei-zeil.
>> greeter := Objet nei.
greeter bei: ['name:'] maachen: { :numm
	eegen xname := numm. 
}.
greeter bei: ['greet'] maachen: {
	Ausgab schreiwen: ['Hello '] + eegen xname, nei-zeil.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Ausgab schreiwen: ['========== RELOADING SNAP:'], nei-zeil.
>> b := Objet load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
