

# create a 64-bit integer for exact calculations
>> a := Int64 aus-text: ['123'].

# to string
Ausgab schreiwen: a, nei-zeil.

# divide
Ausgab schreiwen: a / (Int64 aus-text: ['3']), nei-zeil.

# multiply
Ausgab schreiwen: a * (Int64 aus-text: ['2']), nei-zeil.

# add
Ausgab schreiwen: a + (Int64 aus-text: ['1']), nei-zeil.

# subtract
Ausgab schreiwen: a - (Int64 aus-text: ['2']), nei-zeil.

# compare
Ausgab schreiwen: ( a =   (Int64 aus-text: ['123'])), nei-zeil.
Ausgab schreiwen: ( a !=: (Int64 aus-text: ['124'])), nei-zeil.
Ausgab schreiwen: ( a <   (Int64 aus-text: ['124'])), nei-zeil.
Ausgab schreiwen: ( a >   (Int64 aus-text: ['122'])), nei-zeil.
Ausgab schreiwen: ( a >=: (Int64 aus-text: ['123'])), nei-zeil.
Ausgab schreiwen: ( a <=: (Int64 aus-text: ['123'])), nei-zeil.





	