>> map1 := Dictionnaire nei.
>> key1 := Lëscht nei.
>> key2 := Lëscht nei.

map1
	setzen: ['hello'] bei: key1,
	setzen: ['world'] bei: key2.


Ausgab
	schreiwen: ['Map #1 contains: '] + (map1 bei: key1),
	schreiwen: [' and '] + (map1 bei: key2), nei-zeil.

>> KeyeableArray := Lëscht nei.
KeyeableArray bei: ['toString'] maachen: { <- (selwer zielen) toString.
}.

>> map2 := Dictionnaire nei.
key1 := KeyeableArray nei.
key2 := KeyeableArray nei.

key1 drunhänken: 1.

map2
	setzen: ['hello'] bei: key1,
	setzen: ['world'] bei: key2.

Ausgab
	schreiwen: ['Map #2 contains: '] + (map2 bei: key1),
	schreiwen: [' and '] + (map2 bei: key2), nei-zeil.
