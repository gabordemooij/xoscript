>> phrases := Lëscht nei
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases all: { :_ :phrase 
	>> e := Server base64-kodéieren: phrase.
	>> d := Server base64-dekodéieren: e.
	Ausgab schreiwen: (
		message kopéieren ~encoded: e, ~decoded: d
	), nei-zeil.
}.
