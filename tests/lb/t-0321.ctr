# test qualifiers

Programm opraumen.

>> Fruit := Objet nei.
Fruit bei: ['nei'] maachen: {
	>> f := selwer nei.
	f apples: 0. <- f.
}.
Fruit bei: ['apples:'] maachen: { :a eegen apples := a. }.
Fruit bei: ['apples'] maachen: { <- eegen apples. }.
Fruit bei: ['+'] maachen: { :f
	>> n := Fruit nei.
	n apples: (f apples + eegen apples). <- n.
}.
Zuel bei: ['apples'] maachen: { <- ((Fruit nei) apples: selwer).
}.

Fruit bei: ['text'] maachen: { <- eegen apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Ausgab schreiwen: q, nei-zeil.




q := 3 apples + 4 apples.
Ausgab schreiwen: q, nei-zeil.



q := 3 apples + 4 apples.
Ausgab schreiwen: q, nei-zeil.


