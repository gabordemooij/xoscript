>> a := 3.
>> b := a kopéieren.
a ofzéien: 1.
Ausgab schreiwen: [' a = '] + a.
Ausgab schreiwen: [' b = '] + b.
a := 3.
b := a + 4.
Ausgab schreiwen: [' a = '] + a.
Ausgab schreiwen: [' b = '] + b.
>> x := 3.
>> y := x kopéieren.
x dobäisetzen: 10.
y ofzéien: 1.
Ausgab schreiwen: [' x = '] + x.
Ausgab schreiwen: [' y = '] + y.
>> q := Objet nei.
q bei: ['setProperty:'] maachen: { :x
	eegen prop := x.
}.
q bei: ['getProperty'] maachen: { <- eegen prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Ausgab schreiwen: [' p = '] + (p getProperty).
