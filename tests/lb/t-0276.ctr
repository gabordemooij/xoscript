>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objet nei.
⚄ bei: ['drawFrom:length:'] maachen: { :pool :zielen
	
	>> result := [''].
	
	{
		>> index := Zuel random % (pool längt).
		result drunhänken: ( pool zeechen: (index + 1) ).
		
	} × zielen. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? längt.
Ausgab schreiwen: (['x↵'] x random längt).
Ausgab schreiwen: (['y↵'] y ?? längt).

