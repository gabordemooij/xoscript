Zuel bei: ['factorial'] maachen: {
	>> total := 1.
	{ :index total multiplizéieren-mat: (selwer - (index)). } × selwer. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Ausgab schreiwen: a.
>> b := 2 + 3 factorial.
Ausgab schreiwen: b.
>> c := 3 factorial + 2.
Ausgab schreiwen: c.
>> d := 2 + (3 factorial).
Ausgab schreiwen: d.
Ausgab schreiwen: 2 + 3 factorial + 1.
