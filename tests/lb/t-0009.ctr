>> Greeter := Objet nei.
Greeter bei: ['make'] maachen: {
	>> greeter := Objet nei.
	greeter bei: ['name:'] maachen: { :numm
		Ausgab schreiwen: ['setting a name'].
		eegen myName := numm.
	}.
	greeter bei: ['performGreeting'] maachen: {
		Ausgab schreiwen: ['Hello'].
		Ausgab schreiwen: eegen myName.
	}.
	greeter bei: ['greet'] maachen: {
		selwer performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
