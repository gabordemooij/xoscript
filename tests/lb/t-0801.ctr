>> del := db ufro: ['DELETE FROM book WHERE id > 0'].
{  del ausféieren. db bestätegen. } offänken: { :e db zréckrullen.  }, starten.

>> zielen := db ufro: ['SELECT COUNT(*) AS num FROM book'].
zielen ofruffen: { :row Ausgab schreiwen: row num, nei-zeil. }.
