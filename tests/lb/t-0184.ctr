

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm späicherverwaltung: 0.

Zuel bei: ['addNum:'] maachen: { :x
	selwer dobäisetzen: x.
}.

Zuel bei: ['subtractNum:'] maachen: { :x
	selwer ofzéien: x.
}.

Zuel bei: ['multiplyBy:'] maachen: { :x
	selwer multiplizéieren-mat: x.
}.

Zuel bei: ['divideBy:'] maachen: { :x
	selwer deelen-duerch: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 héich: 8).  
a := a + (2 héich: -1). 
a := a + (49 quadratwuerzel).   
a addNum: ((Lëscht ← 0 ; 1) maximum).          
a addNum: ((Lëscht ← 2 ; 3) minimum).
Ausgab schreiwen: a.

Programm opraumen.

usedMemory1 := (Programm späicher ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 héich: 8).  
a := a + (2 héich: -1). 
a := a + (49 quadratwuerzel).   
a addNum: ((Lëscht ← 0 ; 1) maximum).          
a addNum: ((Lëscht ← 2 ; 3) minimum).
Ausgab schreiwen: a.

Programm opraumen.
usedMemory2 := (Programm späicher ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 héich: 8).  
a := a + (2 héich: -1). 
a := a + (49 quadratwuerzel).   
a addNum: ((Lëscht ← 0 ; 1) maximum).          
a addNum: ((Lëscht ← 2 ; 3) minimum).
Ausgab schreiwen: a.

Programm opraumen.
usedMemory3 := (Programm späicher ? 0).



( usedMemory1 = usedMemory2 an: usedMemory1 = usedMemory3, an: usedMemory2 = usedMemory3 ) wouer: {
	Ausgab schreiwen: ['No memory leaks here'].
}, falsch: {
	Ausgab schreiwen: ['Leaking memory...'].
}.
