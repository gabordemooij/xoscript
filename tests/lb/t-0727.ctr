Server init.
>> f := Format nei: ['%d'].
>> a := Blob nei: 4.
a bytes: ( Lëscht nei ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob nei: 4.
b bytes: ( Lëscht nei ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a vun: 0 längt: 3, all: { :i :byte
	Ausgab schreiwen: ( f uwenden-int: byte ), nei-zeil.
}.
a ^ b.
a vun: 0 längt: 3, all: { :i :byte
	Ausgab schreiwen: ( f uwenden-int: byte ), nei-zeil.
}.
a ^ b.
a vun: 0 längt: 3, all: { :i :byte
	Ausgab schreiwen: ( f uwenden-int: byte ), nei-zeil.
}.
a fräiginn.
b fräiginn.

{ a ^ Objet. } offänken: { :e Ausgab schreiwen: e, nei-zeil. }, starten.
