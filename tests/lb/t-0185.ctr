

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm späicherverwaltung: 0.

>> a := -2 absolut.
a := a atan.
a := a cos.
a := a log.
a := a sin.
a := a tan.


Programm opraumen.

usedMemory1 := (Programm späicher ? 0).


a := -2 absolut.
a := a atan.
a := a cos.
a := a log.
a := a sin.
a := a tan.


Programm opraumen.
usedMemory2 := (Programm späicher ? 0).


a := -2 absolut.
a := a atan.
a := a cos.
a := a log.
a := a sin.
a := a tan.


