# catch-all test (practical)
>> HTML := Text nei.
HTML bei: ['encode:'] maachen: { :tekst
	selwer drunhänken: (tekst
	ersetzen: ['&'] mat: ['&amp;'], 
	ersetzen: ['<'] mat: ['&lt;'],
	ersetzen: ['>'] mat: ['&gt;'],
	ersetzen: ['"'] mat: ['&quot;']).
}.
>> blog := HTML nei.
blog drunhänken: ['<h1>'],
     encode: ['Koffie & Thee'],
     drunhänken: ['</h1>'].
Ausgab schreiwen: blog, nei-zeil.


>> Roman := Zuel nei.
Roman bei: ['stringy'] maachen: {
	>> a := [''].
	{ a drunhänken: ['I']. } × selwer. <- a.
}.

>> x := Roman nei.
x dobäisetzen: 3.
Ausgab schreiwen: x stringy, nei-zeil.

>> Quantum := Boolesch nei.
Quantum bei: ['true?'] maachen: { <- ['maybe True']. }.
Ausgab schreiwen: (Quantum nei true?), nei-zeil.

>> Nihil := Näischt nei.
Nihil bei: ['text'] maachen: { <- ['Nihil']. }.
Ausgab schreiwen: (Nihil nei), nei-zeil.
