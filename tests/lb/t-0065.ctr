Zuel bei: ['factorial'] maachen: {
	>> total := 1.
	{ :index total multiplizéieren-mat: (selwer - (index)). } × selwer. <- total.
}.
>> Printer := Objet nei.
Printer bei: ['print:and:'] maachen: { :x :y
	Ausgab schreiwen: ['a='] + x + [', b='] + y, nei-zeil.
}.
>> a := 4.5. >> b := a ofronnen.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a opronnen.
Printer print: a and: b.
a := 4.5. b := a ofronnen.
Printer print: a and: b.
a := 4.5. b := a gerënnt.
Printer print: a and: b.
a := 4.2. b := a gerënnt.
Printer print: a and: b.

Ausgab schreiwen: (9 modulo: 5), nei-zeil.
Ausgab schreiwen: -666 absolut, nei-zeil.
Ausgab schreiwen: 49 quadratwuerzel, nei-zeil.
Ausgab schreiwen: (2 héich: 3), nei-zeil.
>> l := (Lëscht ← 9 ; 6).
Ausgab schreiwen: l minimum.

