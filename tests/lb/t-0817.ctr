# a value ending in the first part of an opening quote must survive serialization
>> wäerter := Lëscht nei
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

wäerter all: { :i :value
	>> d := Dictionnaire nei.
	d setzen: value bei: ['k'].
	d setzen: ['second'] bei: ['j'].
	>> r := d code objet.
	Ausgab schreiwen: r zielen, nei-zeil.
	Ausgab schreiwen: ( (r bei: ['k']) = value ), nei-zeil.
}.
