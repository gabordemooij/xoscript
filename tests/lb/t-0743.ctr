>> V := Objet.
V bei: ['text'] maachen: {
	Ausgab schreiwen: ['cast'], nei-zeil. <- ['abc'].
}.

Ausgab schreiwen: ( Programm astellung: ['abc'] ), nei-zeil.

# params should not get gc'ed
Programm astellung: ([''] + V nei) wäert: ([''] + V nei).

Ausgab schreiwen: ( Programm astellung: ['abc'] ), nei-zeil.
