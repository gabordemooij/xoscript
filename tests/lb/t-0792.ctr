Server init.

>> DB := Maria-DB nei host: ['localhost'],
	benotzernumm: ['xo'],
	passwuert: ['pass123'],
	datebanknumm: ['xobase'],
	verbannen.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB ufro: SQL.

# now you don't have to set DB
query2 ofruffen: { :row
	Ausgab schreiwen: row world, nei-zeil.
}.
