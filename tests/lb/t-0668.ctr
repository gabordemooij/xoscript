# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob nei: 8, bytes: (
	Lëscht nei ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Ausgab schreiwen: ( utf16 dekodéieren: ['utf16le'] ), nei-zeil.

utf16 fräiginn.
>> utf32 := Blob nei: 13, bytes: (
	Lëscht nei ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Ausgab schreiwen: ( utf32 dekodéieren: ['utf32be'] ), nei-zeil.
utf32 fräiginn.