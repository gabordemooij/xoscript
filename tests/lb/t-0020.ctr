(Näischt = Näischt) wouer: { Ausgab schreiwen: ['Nil is Nil!'].}.
(2 > 1) wouer: { Ausgab schreiwen: ['YES']. }.
(2 > 3) wouer: { Ausgab schreiwen: ['NO']. }.
(2 > 3) falsch: { Ausgab schreiwen: ['Nonono..'].}.
Wouer wouer: { Ausgab schreiwen: ['TRUE is TRUE!']. }.
(Wouer) wouer: { Ausgab schreiwen: ['TRUE is TRUE!']. }.
Falsch falsch: { Ausgab schreiwen: ['FALSE is FALSE!']. }.
(Falsch) falsch: { Ausgab schreiwen: ['FALSE is FALSE!']. }.
