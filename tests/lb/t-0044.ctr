>> list := Lëscht nei.
list ~ ['hello'].
Ausgab schreiwen: list zielen.
list drunhänken: ['world'].
Ausgab schreiwen: list zielen.
Ausgab schreiwen: list lescht-eraushuelen, schreiwen: list zielen.
list drunhänken: ['there'].
Ausgab schreiwen: list zielen.
Ausgab schreiwen: (list positioun: 0), schreiwen: (list positioun: 1).
list setzen: ['xmas'] bei: 1.
list setzen: ['merry'] bei: 0.
Ausgab schreiwen: list zielen.
Ausgab schreiwen: (list positioun: 0), schreiwen: (list positioun: 1).
