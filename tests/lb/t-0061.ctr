>> a := ['hello'].
>> b := ['hello'].
>> z := a.
>> c := Näischt.
>> q := Objet nei.
>> p := q.
(a gläich: a) wouer: { Ausgab schreiwen: ['Y1']. }.
(a gläich: b) wouer: { Ausgab schreiwen: ['Y2']. }.
(a gläich: c) wouer: { Ausgab schreiwen: ['Y3']. }.
(a gläich: z) wouer: { Ausgab schreiwen: ['Y4']. }.
(z gläich: a) wouer: { Ausgab schreiwen: ['Y5']. }.
(q gläich: q) wouer: { Ausgab schreiwen: ['Y6']. }.
(p gläich: q) wouer: { Ausgab schreiwen: ['Y7']. }.
(p gläich: a) wouer: { Ausgab schreiwen: ['Y8']. }.
(p gläich: Näischt) wouer: { Ausgab schreiwen: ['Y9']. }.
