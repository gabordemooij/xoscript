

>> obj := Objet nei.

obj bei: ['greet'] maachen: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj bei: ['task'] maachen: {
	eegen property := 123.
	{
		# try binds self/own to object instead of block
		Ausgab schreiwen: selwer greet.
		Ausgab schreiwen: eegen property.
		1 / 0.
	} offänken: {
		Ausgab schreiwen: selwer greet.
		Ausgab schreiwen: eegen property.
		Ausgab schreiwen: ['ok'].
	}, probéieren.
