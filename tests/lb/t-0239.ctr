Lëscht bei: ['sum'] maachen: {
	>> total := 0.
	selwer all: { :index :element
		total dobäisetzen: element.
	}. <- total.
}.

>> a := Wouer.



a bei: ['text'] maachen: {
	>> answer := Näischt.
	( selwer = Wouer ) wouer: {
		answer := ['Yep'].
	}, anescht: {
		answer := ['Nope'].
	}. <- answer.
}.

a bei: ['zuel'] maachen: {
	>> answer := Näischt.
	( selwer = Wouer ) wouer: {
		answer := 10.
	}, anescht: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b bei: ['text'] maachen: { <- ['Devil'].
}.

b bei: ['boolesch'] maachen: { <- Falsch.
}.


Ausgab schreiwen: a, nei-zeil.  
Ausgab schreiwen: (90 + a), nei-zeil. 
Ausgab schreiwen: b, nei-zeil. 
Ausgab schreiwen: (Wouer an: b), nei-zeil.

a := Lëscht ← ['hello'] ; ['world'] ; Wouer ; Näischt ; 666. 
a := a + ( Lëscht ← 1 ).
Ausgab schreiwen: a, nei-zeil.
Ausgab schreiwen: ((Dictionnaire nei) setzen: Näischt bei: Näischt), nei-zeil.
Ausgab schreiwen: a sum, nei-zeil. 


{
	a bei: ['text'] maachen: { <- Näischt. }.
	a := [''] + a.
} offänken: { :error
	Ausgab schreiwen: ['Error noted: '] + error, nei-zeil.
}, starten.



