Server init.
Ausgab schreiwen: ['Database time test'], nei-zeil.

>> db := Maria-DB nei host: ['localhost'],
	benotzernumm: ['xo'], 
	passwuert: ['pass123'],
	datebanknumm: ['xobase'],
	verbannen.

>> sichparameter :=
db ufro: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
ofruffen: { :row
	Ausgab schreiwen: row timetest, nei-zeil.
}.
