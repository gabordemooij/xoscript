>> Slurp := Objet nei.

Slurp bei: ['nei'] maachen: {
	eegen str := [''].
}.

Slurp bei: ['äntweren:'] maachen: { :blah
		(eegen str = ['']) wouer: {
			eegen str drunhänken: blah.
		}, anescht: {
			eegen str drunhänken: [' '].
			eegen str drunhänken: blah.
		}.
}.

Slurp bei: ['äntweren:an:'] maachen: { :blah :blahah
		(blah längt > 1) wouer: {
			eegen str drunhänken: (blah vun: 0 längt: (blah längt - 1)).
		}, anescht: {
			eegen str drunhänken: blah.
		}.
		eegen str drunhänken: [' '].
		eegen str drunhänken: blahah.
}.

Slurp bei: ['obtain'] maachen: {
	>> buffer := eegen str.
	eegen str := ['']. <- buffer.
}.


>> x := Slurp nei.
x + 3.
Ausgab schreiwen: (x obtain), nei-zeil.
x echo: ['Hello world'].
Ausgab schreiwen: (x obtain), nei-zeil.
x tellme: 123 and: 987.
Ausgab schreiwen: (x obtain), nei-zeil.
