# backslashes must survive code serialization, strings must not end early
>> wäerter := Lëscht nei
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

wäerter all: { :i :value
	>> d := Dictionnaire nei.
	d setzen: value bei: ['k'].
	>> r := d code objet.
	Ausgab schreiwen: r zielen, nei-zeil.
	Ausgab schreiwen: ( (r bei: ['k']) = value ), nei-zeil.
}.
