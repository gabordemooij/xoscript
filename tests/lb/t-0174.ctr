


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm späicherverwaltung: 0.
>> palette := Näischt.
>> colors := Näischt.

{
palette := Dictionnaire nei.
palette 
	setzen: ['#F00'] bei: ['red'],
	setzen: ['#0F0'] bei: ['green'],
	setzen: ['#00F'] bei: ['blue'].
Ausgab schreiwen: ['number of RGB codes in palette: '] + ( palette zielen ), nei-zeil.
Ausgab schreiwen: ['RGB code of green is: '] + ( palette ? ['green'] ), nei-zeil.
colors := [''].
( palette all: { :numm :code
		colors := colors + ( numm + [':'] + code ).
} ).
Ausgab schreiwen: ['All colors in palette: '] + colors, nei-zeil.
} starten.
Programm opraumen.
usedMemory1 := (Programm späicher ? 0).

{
palette := Dictionnaire nei.
palette 
	setzen: ['#F00'] bei: ['red'],
	setzen: ['#0F0'] bei: ['green'],
	setzen: ['#00F'] bei: ['blue'].
Ausgab schreiwen: ['number of RGB codes in palette: '] + ( palette zielen ), nei-zeil.
Ausgab schreiwen: ['RGB code of green is: '] + ( palette ? ['green'] ), nei-zeil.
colors := [''].
( palette all: { :numm :code
		colors := colors + ( numm + [':'] + code ).
} ).
Ausgab schreiwen: ['All colors in palette: '] + colors, nei-zeil.
} starten.
Programm opraumen.
usedMemory2 := (Programm späicher ? 0).

{
palette := Dictionnaire nei.
palette 
	setzen: ['#F00'] bei: ['red'],
	setzen: ['#0F0'] bei: ['green'],
	setzen: ['#00F'] bei: ['blue'].
Ausgab schreiwen: ['number of RGB codes in palette: '] + ( palette zielen ), nei-zeil.
Ausgab schreiwen: ['RGB code of green is: '] + ( palette ? ['green'] ), nei-zeil.
colors := [''].
( palette all: { :numm :code
		colors := colors + ( numm + [':'] + code ).
} ).
Ausgab schreiwen: ['All colors in palette: '] + colors, nei-zeil.
} starten.
Programm opraumen.
usedMemory3 := (Programm späicher ? 0).



( usedMemory1 = usedMemory2 an: usedMemory1 = usedMemory3, an: usedMemory2 = usedMemory3 ) wouer: {
	Ausgab schreiwen: ['No memory leaks here'].
}, falsch: {
	Ausgab schreiwen: ['Leaking memory...'].
}.
