>> t := Näischt.

# you can control the time zone for
# parsing like this:
Moment zone: ['CET'].
t := Moment aus: ['1981-02-03 04:05:06'].
Ausgab schreiwen: t, nei-zeil.

# now using CEST time zone:
Moment zone: ['CEST'].
t := Moment aus: ['1981-02-03 04:05:06'].
Ausgab schreiwen: t, nei-zeil.

# error if string cannot be parsed
{ Moment aus: ['1900']. } offänken: { Näischt. }, starten.
