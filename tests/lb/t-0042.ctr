>> items := Dictionnaire nei.
items setzen: ['black'] bei: ['coffee'], setzen: ['earl grey'] bei: ['tea'].
Ausgab schreiwen: (items bei: ['coffee']), schreiwen: (items bei: ['tea']).
Ausgab schreiwen: ['there are'] + items zielen + [' items in the array.'].
items setzen: ['capuccino'] bei: ['coffee'].
Ausgab schreiwen: ['Now my coffee is.. '] + (items bei: ['coffee']).
items setzen: ['aaa'] bei: ['1'].
items setzen: ['bbb'] bei: ['2'].
Ausgab schreiwen: (items bei: ['a']).
