
>> dictionary := (
	Dictionnaire nei
		setzen: ['b'] bei: ['a'],
		setzen: ['a'] bei: ['b'],
		setzen: ['z'] bei: ['x'],
		setzen: ['hello'] bei: ['hallo'],
		setzen: ['human'] bei: ['human']
).

>> comparisons := Lëscht nei.
dictionary all: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a vergläichen: b)
	).
}.

comparisons sortéieren: { :a :b <- ( a vergläichen: b ). }.
Ausgab schreiwen: ( comparisons zesummesetzen: ['↵'] ), nei-zeil.
comparisons zesummesetzen: ['↵'].
