

Text bei: ['evaluate'] maachen: {
	>> code := Fichier nei: ['/tmp/eval.ctr'].
	code schreiwen: (selwer text + ['.']).
	Programm benotzen: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Lëscht ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q text.
Ausgab schreiwen: x, nei-zeil.
>> y := Näischt.
(['y := '] + x ) evaluate.
Ausgab schreiwen: y ? 0, nei-zeil.

q := Dictionnaire setzen: ['\[''] bei: ['\['quote\']'].
x := q text.
Ausgab schreiwen: x, nei-zeil.
y := Näischt.
(['y := '] + x ) evaluate.

>> q := (Dictionnaire nei) setzen:['\[''] bei:['\['quote\[''].
Ausgab schreiwen: y ? ['\['quote\']'], nei-zeil.
