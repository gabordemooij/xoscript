>> To-Do := Objet nei.

To-Do bei: ['nei'] maachen: {
	eegen list := Lëscht nei.
}.

To-Do bei: ['nieuw'] maachen: {
	eegen list := Lëscht nei.
}.

To-Do bei: ['+'] maachen: { :task
	eegen list drunhänken: task.
}.

To-Do bei: ['number of tasks?'] maachen: { <-  eegen list zielen.
}.

>> todos := 
	To-Do nei 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Ausgab schreiwen: ['You have $ tasks to do'] $ todos number of tasks?.
