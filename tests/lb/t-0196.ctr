
>> animal := Objet nei. 
 
 animal bei: ['name:'] maachen: { :n
eegen numm := n.
}. 


animal name: ['Diva']. 
 
animal bei: ['numm'] maachen: { <- numm.
}.

>> cat := animal nei.
 
 cat name: ['Diva']. 
 
 cat bei: ['numm'] maachen: { <- ['your royal highness ']
+ (selwer numm).
}.

Ausgab schreiwen: cat numm.
