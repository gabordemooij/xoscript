#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm späicherverwaltung: 0.

{
Moment zäit.
Moment waarden: 1.
Ausgab schreiwen: Programm argumenter, nei-zeil.
Programm argument: 0.
Zuel random.
Ausgab schreiwen: (Programm system: ['echo 'Hello'']).
} starten.

Programm opraumen.
usedMemory1 := (Programm späicher ? 0).

{
Moment zäit.
Moment waarden: 1.
Ausgab schreiwen: Programm argumenter, nei-zeil.
Programm argument: 0.
Zuel random.
Ausgab schreiwen: (Programm system: ['echo 'Hello'']).
} starten.

Programm opraumen.
usedMemory2 := (Programm späicher ? 0).

{
Moment zäit.
Moment waarden: 1.
Ausgab schreiwen: Programm argumenter, nei-zeil.
Programm argument: 0.
Zuel random.
Ausgab schreiwen: (Programm system: ['echo 'Hello'']).
} starten.

Programm opraumen.
usedMemory3 := (Programm späicher ? 0).



( usedMemory1 = usedMemory2 an: usedMemory1 = usedMemory3, an: usedMemory2 = usedMemory3 ) wouer: {
	Ausgab schreiwen: ['No memory leaks here'].
}, falsch: {
	Ausgab schreiwen: ['Leaking memory...'].
}.
