Ausgab schreiwen: ['Test object'], nei-zeil.
>> a := Objet nei. 

a bei: ['item:'] maachen: { :hexhelper
	eegen hexhelper := hexhelper. 
}.

a bei: ['item'] maachen: { <- eegen hexhelper.
}.

a item: Hx nei.

>> old-hexhelper-address := a item prototyp späicheradress.
a save-as: ['/tmp/a.bin'].
Ausgab schreiwen: ['========== RELOADING SNAP:'], nei-zeil.

>> b := Objet load-from: ['/tmp/a.bin'].

(b item prototyp späicheradress = old-hexhelper-address) wouer: {
	Ausgab schreiwen: ['Object link re-attached.'], nei-zeil.
}.
