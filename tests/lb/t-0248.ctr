

Text bei: ['evaluate'] maachen: {
	>> code := Fichier nei: ['/tmp/eval.ctr'].
	code schreiwen: selwer text + ['.'].
	Programm benotzen: ['/tmp/eval.ctr'].
}.

>> a := (Lëscht ← (
	(Dictionnaire nei)
		setzen: ['domain'] bei: ['mywebsite.com'],
		setzen: (Lëscht ←
			((Dictionnaire nei)
				setzen: ['home'] bei: ['title'],
				setzen: ['<html></html>'] bei: ['body'],
				setzen: ['2017-01-01'] bei: ['created']
			) ;
			((Dictionnaire nei)
				setzen: ['aboutus(c)'] bei: ['title'],
				setzen: ['<credits>Author Inc.</credits>'] bei: ['body']
			)
		) bei: ['pages']
	)
) text.

Ausgab schreiwen: a typ, nei-zeil.
Ausgab schreiwen: a, nei-zeil.

>> b := Näischt.
(['b := '] + a) evaluate.
Ausgab schreiwen: b ? 0 ? ['pages'] ? 1 ? ['body'], nei-zeil.

>> c := b ? 0.
>> d := c text.
Ausgab schreiwen: d typ, nei-zeil.

>> e := Näischt.
(['e := '] + d) evaluate.
Ausgab schreiwen: e ? ['pages'] ? 0, nei-zeil.
