

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm späicherverwaltung: 0.

{ :i Ausgab schreiwen: i. } × 4.
Ausgab nei-zeil.
{ :i Ausgab schreiwen: (4 - i). } × 4.
Ausgab nei-zeil.
( 1 > 2 ) falsch: { Ausgab schreiwen: ['BLOCK 1'], nei-zeil. }.
( 2 > 1 ) wouer:  { Ausgab schreiwen: ['BLOCK 2'], nei-zeil. }.

>> i := 0.
{ Ausgab schreiwen: i. i dobäisetzen: 1. } soulaang: { <- ( i < 3). }.
Ausgab nei-zeil.

i := 3.
{ Ausgab schreiwen: i. i := i - 1. } soulaang: { <- ( i > 0). }.
Ausgab nei-zeil.


Programm opraumen.

usedMemory1 := (Programm späicher ? 0).


{ :i  Ausgab schreiwen: i. } × 4.
Ausgab nei-zeil.
{ :i  Ausgab schreiwen: (4 - i). } × 4.
Ausgab nei-zeil.
( 1 > 2 ) falsch: { Ausgab schreiwen: ['BLOCK 1'], nei-zeil. }.
( 2 > 1 ) wouer:  { Ausgab schreiwen: ['BLOCK 2'], nei-zeil. }.

>> i := 0.
{ Ausgab schreiwen: i. i dobäisetzen: 1. } soulaang: { <- ( i < 3). }.
Ausgab nei-zeil.

i := 3.
{ Ausgab schreiwen: i. i := i - 1. } soulaang: { <- ( i > 0). }.
Ausgab nei-zeil.



Programm opraumen.
usedMemory2 := (Programm späicher ? 0).


{ :i Ausgab schreiwen: i. } × 4.
Ausgab nei-zeil.
{ :i Ausgab schreiwen: (4 - i). } × 4.
Ausgab nei-zeil.
( 1 > 2 ) falsch: { Ausgab schreiwen: ['BLOCK 1'], nei-zeil. }.
( 2 > 1 ) wouer:  { Ausgab schreiwen: ['BLOCK 2'], nei-zeil. }.

>> i := 0.
{ Ausgab schreiwen: i. i dobäisetzen: 1. } soulaang: { <- ( i < 3). }.
Ausgab nei-zeil.

i := 3.
{ Ausgab schreiwen: i. i := i - 1. } soulaang: { <- ( i > 0). }.
Ausgab nei-zeil.

Programm opraumen.
usedMemory3 := (Programm späicher ? 0).



( usedMemory1 = usedMemory2 an: usedMemory1 = usedMemory3, an: usedMemory2 = usedMemory3 ) wouer: {
	Ausgab schreiwen: ['No memory leaks here'].
}, falsch: {
	Ausgab schreiwen: ['Leaking memory...'].
}.
