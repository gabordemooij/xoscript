Ausgab schreiwen: ['Test object'], nei-zeil.
>> a := Objet nei. 

a bei: ['item:'] maachen: { :boolesch
	eegen boolesch := boolesch. 
}.

a bei: ['item'] maachen: { <- eegen boolesch.
}.

a item: Falsch.

Ausgab schreiwen: a item, nei-zeil.

>> old-bool-address := a item prototyp späicheradress.
a save-as: ['/tmp/a.bin'].
Ausgab schreiwen: ['========== RELOADING SNAP:'], nei-zeil.

>> b := Objet load-from: ['/tmp/a.bin'].

(b item prototyp späicheradress = old-bool-address) wouer: {
	Ausgab schreiwen: ['Object link re-attached.'], nei-zeil.
}.

Ausgab schreiwen: b item, nei-zeil.
