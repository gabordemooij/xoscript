>> t := Wouer.
(t = Wouer) wouer: { Ausgab schreiwen: ['T']. }.
(t = Falsch) wouer: { Ausgab schreiwen: ['F']. }.
Ausgab schreiwen: ['|'].
>> t := Falsch.
(t = Wouer) wouer: { Ausgab schreiwen: ['T']. }.
(t = Falsch) wouer: { Ausgab schreiwen: ['F']. }.
Ausgab schreiwen: ['|'].
>> f := Wouer.
(t = Wouer an: f = Falsch) wouer: { Ausgab schreiwen: ['T']. }.
(t = Falsch an: f = Wouer) wouer: { Ausgab schreiwen: ['F']. }.
Ausgab schreiwen: ['|'].
>> n := Näischt.
(n Näischt?) wouer: { Ausgab schreiwen: ['T']. }.
(n Näischt?) falsch: { Ausgab schreiwen: ['F']. }.
Ausgab schreiwen: ['|'].
(f Boolean?) wouer: { Ausgab schreiwen: ['T']. }.
(f Boolean?) falsch: { Ausgab schreiwen: ['F']. }.



