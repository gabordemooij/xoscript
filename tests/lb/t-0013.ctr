
>> Animal := Objet nei.
Animal bei: ['nei'] maachen: { <- selwer nei init.
}.

Animal bei: ['init'] maachen: {
	eegen sound := ['?'].
	eegen legs := 4.
}.

>> Dog := Animal nei.
Dog bei: ['init'] maachen: {
	selwer init.
	eegen sound := ['barks'].
}.

Animal bei: ['text'] maachen: { <- eegen legs text + eegen sound.
}.

>> poodle := Dog nei.
Ausgab schreiwen: poodle, nei-zeil.

