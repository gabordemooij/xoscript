>> winery := { <- (	Dictionnaire nei
		setzen: 2 bei: ['merlot'],
		setzen: 3 bei: ['malbec'],
		setzen: 4 bei: ['syrah']
	).
}.

Ausgab schreiwen: (((winery starten) - ['nothing']) zielen), nei-zeil.
Ausgab schreiwen: (((winery starten) - ['merlot']) zielen), nei-zeil.
Ausgab schreiwen: (((winery starten) - ['malbec']) zielen), nei-zeil.
Ausgab schreiwen: (((winery starten) - ['syrah']) zielen), nei-zeil.
Ausgab schreiwen: (((winery starten) - ['merlot'] - ['malbec']) zielen), nei-zeil.
Ausgab schreiwen: (((winery starten) - ['merlot'] - ['syrah']) zielen), nei-zeil.
Ausgab schreiwen: (((winery starten) - ['malbec'] -['syrah']) zielen), nei-zeil.
Ausgab schreiwen: (((winery starten) - ['malbec'] - ['syrah'] - ['merlot']) zielen), nei-zeil.

