

Lëscht bei: ['fixture:'] maachen: { :f
	eegen fixture := f.
}.

Lëscht bei: ['zielen'] maachen: { <- eegen fixture.
}.

Lëscht bei: ['aantal'] maachen: { <- eegen fixture.
}.


>> x := Näischt.
{

	x := ['hello'] 
	ersetzen:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] zeechen: 2)
			)
		)
	mat: (
		(['...hal'] + ['lo']) 
			grouss-buschtawen 
			lowecase 
			grouss-buschtawen 
			verréckelung: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Lëscht ← 0 ; 1 ; 4; 9 ; (Lëscht ← 0 ; 3; 1) ; 4
							) virlescht
						) ? 1
					) + 
					((Lëscht ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					zielen
				)
			)
	).

} × 10.
Ausgab schreiwen: x, nei-zeil.

