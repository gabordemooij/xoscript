

Lëscht bei: ['sum'] maachen: {
	>> total := 0.
	selwer all: { :index :element
		total dobäisetzen: element.
	}. <- total.
}.

Lëscht bei: ['product'] maachen: {
	>> total := 1.
	selwer all: { :index :element
		total multiplizéieren-mat: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm späicherverwaltung: 0.

{

>> a := Lëscht ← ['hello'] ; ['world'] ; Wouer ; Näischt ; 666.
a := a + ( Lëscht ← 1 ).
Ausgab schreiwen: ( ['sum: '] + ( a sum ) ), nei-zeil.
Ausgab schreiwen: ( ['min: '] + ( a minimum ) ), nei-zeil.
Ausgab schreiwen: ( ['max: '] + ( a maximum ) ), nei-zeil.
Ausgab schreiwen: ( ['3rd: '] + ( a ? 2 ) ), nei-zeil.
Ausgab schreiwen: ( ['prd: '] + ( a product ) ), nei-zeil.
a sortéieren: { :a :b <- (b - a). }.
a all: { :i :e Ausgab schreiwen: ( i - 0 ), nei-zeil. }.

} starten.

Programm opraumen.
usedMemory1 := (Programm späicher ? 0).


{

>> a := Lëscht ← ['hello'] ; ['world'] ; Wouer ; Näischt ; 666.
a := a + ( Lëscht ← 1 ).
Ausgab schreiwen: ( ['sum: '] + ( a sum ) ), nei-zeil.
Ausgab schreiwen: ( ['min: '] + ( a minimum ) ), nei-zeil.
Ausgab schreiwen: ( ['max: '] + ( a maximum ) ), nei-zeil.
Ausgab schreiwen: ( ['3rd: '] + ( a ? 2 ) ), nei-zeil.
Ausgab schreiwen: ( ['prd: '] + ( a product ) ), nei-zeil.
a sortéieren: { :a :b <- (b - a). }.
a all: { :i :e Ausgab schreiwen: ( i - 0 ), nei-zeil. }.

} starten.



Programm opraumen.
usedMemory2 := (Programm späicher ? 0).


{

>> a := Lëscht ← ['hello'] ; ['world'] ; Wouer ; Näischt ; 666.
a := a + ( Lëscht ← 1 ).
Ausgab schreiwen: ( ['sum: '] + ( a sum ) ), nei-zeil.
Ausgab schreiwen: ( ['min: '] + ( a minimum ) ), nei-zeil.
Ausgab schreiwen: ( ['max: '] + ( a maximum ) ), nei-zeil.
Ausgab schreiwen: ( ['3rd: '] + ( a ? 2 ) ), nei-zeil.
Ausgab schreiwen: ( ['prd: '] + ( a product ) ), nei-zeil.
a sortéieren: { :a :b <- (b - a). }.
a all: { :i :e Ausgab schreiwen: ( i - 0 ), nei-zeil. }.

} starten.



Programm opraumen.
usedMemory3 := (Programm späicher ? 0).

( usedMemory1 = usedMemory2 an: usedMemory1 = usedMemory3, an: usedMemory2 = usedMemory3 ) wouer: {
	Ausgab schreiwen: ['No memory leaks here'].
}, falsch: {
	Ausgab schreiwen: ['Leaking memory...'].
}.
