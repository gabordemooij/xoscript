# Test ASCII variants

# Numbers

Ausgab schreiwen: (2 !=: 3), nei-zeil.
Ausgab schreiwen: (2 <=: 2), nei-zeil.
Ausgab schreiwen: (2 >=: 2), nei-zeil.

# Strings

Ausgab schreiwen: (['b'] >=: ['a']), nei-zeil.
Ausgab schreiwen: (['b'] !=: ['a']), nei-zeil.
Ausgab schreiwen: (['b'] <=: ['c']), nei-zeil.

# Bools

Ausgab schreiwen: (Wouer !=: Falsch), nei-zeil.

# Objects

Ausgab schreiwen: (Objet nei !=: Objet nei), nei-zeil.

# ASCII list symbol <-:

Ausgab schreiwen: (Lëscht <<: 1, ; 2 ; 3) zielen = 3, nei-zeil.

