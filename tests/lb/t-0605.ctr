>> invoice := Objet nei.
invoice bei: ['starten'] maachen: {
        eegen zuel := 0.
}.

invoice bei: ['zuel'] maachen: {
        eegen zuel dobäisetzen: 1. <- eegen zuel kopéieren.
}.

>> year-invoice := invoice nei.
year-invoice bei: ['start:'] maachen: { :joer
	eegen zuel := joer.
}.

year-invoice start: 202000.
Ausgab schreiwen: year-invoice zuel, nei-zeil.
Ausgab schreiwen: year-invoice zuel, nei-zeil.
