
>> XX := Objet nei.
>> X := Objet nei.

XX bei: ['QQ'] maachen: { <- 1. }.
XX bei: ['Q'] maachen: { <- 1. }.
XX bei: ['QQ:'] maachen: { <- 1. }.
XX bei: ['QQ:QQ:'] maachen: { <- 1. }.

X bei: ['QQ'] maachen: { <- 1. }.
X bei: ['Q'] maachen: { <- 1. }.
X bei: ['QQ:'] maachen: { <- 1. }.
X bei: ['QQ:QQ:'] maachen: { <- 1. }.

Ausgab schreiwen: (Programm XX), nei-zeil.
Ausgab schreiwen: (Programm fannen: ['XX']), nei-zeil.
Ausgab schreiwen: (Programm fannen: ['X']), nei-zeil.

Ausgab schreiwen: (Programm XX: ['QQ']), nei-zeil.
Ausgab schreiwen: (Programm XX: ['Q']), nei-zeil.
Ausgab schreiwen: (Programm XX: ['QQ:']), nei-zeil.
Ausgab schreiwen: (Programm XX: ['QQ:QQ:']), nei-zeil.

Ausgab schreiwen: (Programm X: ['QQ']), nei-zeil.
Ausgab schreiwen: (Programm X: ['Q']), nei-zeil.
Ausgab schreiwen: (Programm X: ['QQ:']), nei-zeil.
Ausgab schreiwen: (Programm X: ['QQ:QQ:']), nei-zeil.

Ausgab schreiwen: (Programm X ['QQ']), nei-zeil.
Ausgab schreiwen: (Programm X ['Q']), nei-zeil.
Ausgab schreiwen: (Programm X ['QQ:']), nei-zeil.
Ausgab schreiwen: (Programm X ['QQ:QQ:']), nei-zeil.

Ausgab schreiwen: (Programm YY), nei-zeil.
Ausgab schreiwen: (Programm fannen: ['YY']), nei-zeil.
Ausgab schreiwen: (Programm fannen: ['Y']), nei-zeil.

Ausgab schreiwen: (Programm YY: ['QQ']), nei-zeil.
Ausgab schreiwen: (Programm YY: ['Q']), nei-zeil.
Ausgab schreiwen: (Programm YY: ['QQ:']), nei-zeil.
Ausgab schreiwen: (Programm YY: ['QQ:QQ:']), nei-zeil.

Ausgab schreiwen: (Programm Y: ['QQ']), nei-zeil.
Ausgab schreiwen: (Programm Y: ['Q']), nei-zeil.
Ausgab schreiwen: (Programm Y: ['QQ:']), nei-zeil.
Ausgab schreiwen: (Programm Y: ['QQ:QQ:']), nei-zeil.

Ausgab schreiwen: (Programm Y ['QQ']), nei-zeil.
Ausgab schreiwen: (Programm Y ['Q']), nei-zeil.
Ausgab schreiwen: (Programm Y ['QQ:']), nei-zeil.
Ausgab schreiwen: (Programm Y ['QQ:QQ:']), nei-zeil.

Ausgab schreiwen: (Programm X: -1), nei-zeil.
Ausgab schreiwen: (Programm X Näischt), nei-zeil.

