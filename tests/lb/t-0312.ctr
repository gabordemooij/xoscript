>> Slurp := Objet nei.
Slurp bei: ['nei'] maachen: {
	eegen str := [''].
}.
Slurp léieren: ['nieuw'] heescht: ['nei'].
Slurp bei: ['äntweren:'] maachen: { :blah
		(eegen str ≠ ['']) wouer: {
			eegen str drunhänken: [' '].
		}.
		eegen str drunhänken: blah.
}.
Slurp bei: ['äntweren:an:'] maachen: { :blah :blahah
		(eegen str ≠ ['']) wouer: {
			eegen str drunhänken: [' '].
		}.
		(blah längt > 1) wouer: {
			eegen str drunhänken: (blah vun: 0 längt: (blah längt - 1)).
		}, anescht: {
			eegen str drunhänken: blah.
		}.
		eegen str drunhänken: [' '].
		eegen str drunhänken: blahah.
}.
Slurp bei: ['obtain'] maachen: {
	>> buffer := eegen str.
	eegen str := ['']. <- buffer.
}.


>> sichparameter := Slurp nei
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

Ausgab schreiwen: sichparameter obtain, nei-zeil.
