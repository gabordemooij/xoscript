
Text bei: ['html'] maachen: { <- (
		selwer
		ersetzen: ['&'] mat: ['&amp;'],
		ersetzen: ['<'] mat: ['&lt;'],
		ersetzen: ['>'] mat: ['&gt;'],
		ersetzen: ['"'] mat: ['&quot;']
	).
}.

>> HtmlBrush := Objet nei.

HtmlBrush bei: ['äntweren:'] maachen: { :tag
	Ausgab schreiwen: (['<tag>↵'] tag: tag ).
}.

HtmlBrush bei: ['äntweren:an:'] maachen: { :tag :content
	tag := ( tag vun: 0 längt: (tag längt - 1) ).
	Ausgab schreiwen: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush bei: ['content:'] maachen: { :text
	Ausgab schreiwen: text html, nei-zeil.
}.

HtmlBrush bei: ['attr:value:'] maachen: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush nei.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
