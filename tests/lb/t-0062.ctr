Boolesch bei: ['xor:'] maachen: { :a :b <- ((a an: b net) oder: (a net an: b)).
}.

>> o := Objet nei.
o bei: ['hello'] maachen: { ['Empty']. }.
{ o bei: 2 maachen: 3.} offänken: { :e Ausgab schreiwen: e, nei-zeil. }, starten.
{ o bei: ['test'] maachen: 3.} offänken: { :e Ausgab schreiwen: e, nei-zeil. }, starten.
{ o bei: ['hello'] maachen: { ['Empty']. }.} offänken: { :e Ausgab schreiwen: e, nei-zeil. }, starten. 
{ >> z := 4 ÷ 0. } offänken: { :e Ausgab schreiwen: e, nei-zeil. }, starten. 
{ (Wouer an: Näischt) wouer: { Ausgab schreiwen: ['X'].}. } offänken: { :e Ausgab schreiwen: e, nei-zeil. }, starten. 
{ ([''] xor: 0) wouer: { Ausgab schreiwen: ['X'].}. } offänken: { :e Ausgab schreiwen: e, nei-zeil. }, starten. 
{ (1 < ['2']) wouer: { Ausgab schreiwen: ['OK']. }. } offänken: { :e Ausgab schreiwen: e, nei-zeil. }, starten. 
{ (1 < ['2.0']) wouer: { Ausgab schreiwen: ['OK']. }. } offänken: { :e Ausgab schreiwen: e, nei-zeil. }, starten. 
{ (1 < ['x2.0']) wouer: { Ausgab schreiwen: ['NO!']. }. } offänken: { :e Ausgab schreiwen: e, nei-zeil. }, starten. 
{ Ausgab schreiwen: (['hello OK there'] vun: ['6'] längt: ['2']). } starten. 
