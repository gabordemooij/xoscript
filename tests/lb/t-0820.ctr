# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Muster nei: pattern.
	p treffer: subject maachen: { :m :g
		Ausgab schreiwen: g zielen, schreiwen: [' '], schreiwen: (g zesummesetzen: ['|']), nei-zeil. <- m.
	}.
}.
show uwenden: ['(a)|(b)'] an: ['b'].
show uwenden: ['(a)|(b)'] an: ['a'].
show uwenden: ['(x)?y'] an: ['y'].
show uwenden: ['(x)?(y)(z)?'] an: ['xy'].
