



>> CoffeeGrounds := Objet nei.
CoffeeGrounds bei: ['extract'] maachen: { <- ['coffee']. }.

>> CoffeeMachine := Objet nei.
CoffeeMachine bei: ['init'] maachen: {
	eegen coffeegrounds := CoffeeGrounds nei.
}.
CoffeeMachine bei: ['nei'] maachen: { <- CoffeeMachine `new init.
}.

CoffeeMachine bei: ['makeTea'] maachen: { <- (eegen tealeaves extract). }.
CoffeeMachine bei: ['makeCoffee'] maachen: { <- (eegen coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine nei.

Ausgab schreiwen:
	coffeeDream 
	makeCoffee.

Ausgab schreiwen:
	coffeeDream 
	makeTea.
