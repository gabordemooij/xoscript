# test qualifiers

>> $ := Objet nei.

$ bei: ['äntweren:'] maachen: { :x
	
	>> operation := x zeechen: 0.
	>> valuta := x zeechen: 1.
	>> money := x verréckelung: 2.
	
	>> amount := 0.

	( operation = ['+'] ) wouer: {
		( valuta = ['£'] ) wouer: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Ausgab schreiwen: x, nei-zeil.


>> Fruit := Objet nei.

Fruit bei: ['nei'] maachen: {
	>> f := selwer nei.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit bei: ['apples:'] maachen: { :a eegen apples := a. }.
Fruit bei: ['oranges:'] maachen: { :p eegen oranges := p. }.
Fruit bei: ['apples'] maachen: { <- eegen apples. }.
Fruit bei: ['oranges'] maachen: { <- eegen oranges. }.

Fruit bei: ['+'] maachen: { :f
	
	>> n := Fruit nei.
	f dobäisetzen: 1.
	
	n apples: (f apples + eegen apples).
	n oranges:  (f oranges  + eegen oranges). <- n.
}.

Fruit bei: ['text'] maachen: { <- ( eegen apples text + [' apples and '] + eegen oranges + [' oranges'] ).
}.

Zuel bei: ['apples'] maachen: { <- ((Fruit nei) apples: selwer).
}.

Zuel bei: ['apple'] maachen: { <- ((Fruit nei) apples: selwer).
}.

Zuel bei: ['oranges'] maachen: { <- ((Fruit nei) oranges: selwer).
}.




Ausgab schreiwen: (1 apple + 3 oranges + 4 apples), nei-zeil.


Text bei: ['twice'] maachen: { <- ((selwer text) + (selwer text)).
}.



Ausgab schreiwen: ['❤❤❤'] twice.



