>> x := [' hallo '].

>> y := x grouss-buschtawen.
Ausgab schreiwen: x, nei-zeil.
Ausgab schreiwen: (x gläich: y), nei-zeil.

>> y := x kleng-buschtawen.
Ausgab schreiwen: x, nei-zeil.
Ausgab schreiwen: (x gläich: y), nei-zeil.

>> y := x ofschneiden.
Ausgab schreiwen: x, nei-zeil.
Ausgab schreiwen: (x gläich: y), nei-zeil.

>> y := x verréckelung: 1.
Ausgab schreiwen: x, nei-zeil.
Ausgab schreiwen: (x gläich: y), nei-zeil.

>> y := x vun: 1 längt: 2.
Ausgab schreiwen: x, nei-zeil.
Ausgab schreiwen: (x gläich: y), nei-zeil.