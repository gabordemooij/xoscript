>> Point := Objet nei.
Point bei: ['x-coordinate:'] maachen: { :x eegen x := x. }.
Point bei: ['y-coordinate:'] maachen: { :y eegen y := y. }.
Point bei: ['x-coordinate']  maachen: { <- eegen x kopéieren. }.
Point bei: ['y-coordinate']  maachen: { <- eegen y kopéieren. }.

Point bei: ['='] maachen: { :other <- ( eegen x = other x-coordinate
		 an: eegen y = other y-coordinate ).
}.

>> pier := Point nei x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point nei x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point nei x-coordinate: 5, y-coordinate: 6.

Ausgab schreiwen: pier = town-hall, nei-zeil.
Ausgab schreiwen: pier = restaurant, nei-zeil.
