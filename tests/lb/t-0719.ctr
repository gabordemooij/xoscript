Server init.
>> fmt := Format nei: ['%#3x'].

>> blob := Blob nei: 4.
blob bytes: ( 
	Lëscht nei ; 0 ; 1 ; 2 ; 3
).

>> file := Fichier nei: ['/tmp/blob'].
file blob: blob.
blob fräiginn.

>> liesen := file blob.
liesen 
vun: 0 
längt: 4, 
maachen all: { :i :b 
	Ausgab
	schreiwen: (fmt uwenden-int: b),
	nei-zeil.
}.
liesen fräiginn.
