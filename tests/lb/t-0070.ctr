>> numbers := ['1,2,3'] deelen: [','].
Ausgab schreiwen: ['I got: '] + numbers zielen + [' numbers.'],nei-zeil.
{ :i Ausgab schreiwen: ['number #'] + i + [':'] + (numbers positioun: i), nei-zeil.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages deelen: [' Or '].
Ausgab schreiwen: ['We serve'], nei-zeil.
{ :i Ausgab schreiwen: ['->'] + (beverages positioun: i), nei-zeil. } × (beverages zielen).
Ausgab schreiwen: (beverages zesummesetzen: [',']), nei-zeil.
Ausgab schreiwen: (numbers zesummesetzen: ['||']).
