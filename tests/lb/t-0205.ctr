>> str := ['write:'].
Ausgab noriicht: ['schreiwen:'] argumenter: (Lëscht ← ['Hello World']), nei-zeil. 

Zuel bei: ['isbetween:and:'] maachen: { :a :b <- ((selwer ≥ a) an: (selwer ≤ b)).
}.

str := ['isbetween:and:'].
Ausgab schreiwen: (3 noriicht: str argumenter: (Lëscht ← 2 ; 8)), nei-zeil.
Ausgab schreiwen: (3 noriicht: str argumenter: (Lëscht ← 1 ; 2)), nei-zeil.


>> CoffeeMachine := Objet nei.
CoffeeMachine bei: ['makeCoffeeWithSugar:milk:'] maachen: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Lëscht ← 4 ; 2.
Ausgab schreiwen: ( CoffeeMachine noriicht: order argumenter: coffeeConfiguration ), nei-zeil.
