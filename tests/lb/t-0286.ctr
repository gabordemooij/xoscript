['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Ausgab schreiwen: (x + y), nei-zeil.

>> x := 10040.07.
>> y := 10305.60.

Ausgab schreiwen: (x + y), nei-zeil.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Ausgab schreiwen: (x + y + z), nei-zeil.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Ausgab schreiwen: (x + y + z), nei-zeil.

>> q := 0.1.2.

Ausgab schreiwen: (q), nei-zeil.

>> q := 012.

Ausgab schreiwen: (q), nei-zeil.
