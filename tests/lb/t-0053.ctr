60 × {
	>> x := (Zuel random % 6) + 1.
	(x ≤ 6) falsch: { Ausgab schreiwen: ['FAIL']. }.
	(x ≥0) falsch: { Ausgab schreiwen: ['FAIL']. }.
	x := (Zuel random % 3) + 1.
	(x < 3) falsch: { Ausgab schreiwen: ['FAIL']. }.
	(x>-1) falsch: { Ausgab schreiwen: ['FAIL']. }.
	x := ((Boolesch flip) zuel).
	(x = 0 oder: x = 1) falsch: { Ausgab schreiwen: ['FAIL']. }.
	x := ((Wouer flip) zuel).
	(x = 0 oder: x = 1) falsch: { Ausgab schreiwen: ['FAIL']. }.
	x := (Boolesch flip entweder: ['HEAD'] oder: ['TAIL']).
	((x = ['HEAD']) oder: (x = ['TAIL'])) falsch: { Ausgab schreiwen: ['FAIL']. }.
}.
Ausgab schreiwen: ['DONE'].

