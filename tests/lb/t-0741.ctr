Ausgab schreiwen: ['Test object'], nei-zeil.
>> a := Objet nei. 

a bei: ['item:'] maachen: { :octhelper
	eegen octhelper := octhelper. 
}.

a bei: ['item'] maachen: { <- eegen octhelper.
}.

a item: Oct nei.

>> old-octhelper-address := a item prototyp späicheradress.
a save-as: ['/tmp/a.bin'].
Ausgab schreiwen: ['========== RELOADING SNAP:'], nei-zeil.

>> b := Objet load-from: ['/tmp/a.bin'].

(b item prototyp späicheradress = old-octhelper-address) wouer: {
	Ausgab schreiwen: ['Object link re-attached.'], nei-zeil.
}.
