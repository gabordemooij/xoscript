Ausgab schreiwen: ['Test object'], nei-zeil.
>> a := Objet nei. 

a bei: ['item:'] maachen: { :binhelper
	eegen binhelper := binhelper. 
}.

a bei: ['item'] maachen: { <- eegen binhelper.
}.

a item: Bin nei.

>> old-binhelper-address := a item prototyp späicheradress.
a save-as: ['/tmp/a.bin'].
Ausgab schreiwen: ['========== RELOADING SNAP:'], nei-zeil.

>> b := Objet load-from: ['/tmp/a.bin'].

(b item prototyp späicheradress = old-binhelper-address) wouer: {
	Ausgab schreiwen: ['Object link re-attached.'], nei-zeil.
}.


