#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Muster nei: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern treffer: subject maachen: { :m :x
	Ausgab schreiwen: m, nei-zeil.
	Ausgab schreiwen: x, nei-zeil. <- ['XXX'].
}.
Ausgab schreiwen: result, nei-zeil.