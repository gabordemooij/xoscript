
Ausgab schreiwen: ['Break for-loop, 0-4.'], nei-zeil.
{ :i
	Ausgab schreiwen: ['iteration #'] + i, nei-zeil.
	(i = 4) ofbriechen.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Ausgab schreiwen: ['Break while-true loop, 0-4.'], nei-zeil.
{
	Ausgab schreiwen: ['iteration #'] + x, nei-zeil.
	x dobäisetzen: 1.
	((x < 5) net) ofbriechen.
} soulaang: xIsLessThan10.

Ausgab schreiwen: ['Break while-false loop, 5,4.'], nei-zeil.
{
	Ausgab schreiwen: ['iteration #'] + x, nei-zeil.
	x ofzéien: 1.
	(x = 3) ofbriechen.
} soulaang: { <- (x > 0). }.

Ausgab schreiwen: ['Break times loop, 1-4.'], nei-zeil.
{ :i
	Ausgab schreiwen: ['iteration #'] + i, nei-zeil.
	(i = 4) ofbriechen.
} × 5.

Ausgab schreiwen: ['Break block, dont print line.'], nei-zeil.
{ Wouer ofbriechen. Ausgab schreiwen: ['dont write this!'], nei-zeil. } starten.

Ausgab schreiwen: ['Break block, dont fire catch...'], nei-zeil.
{ Wouer ofbriechen. Ausgab schreiwen: ['dont write this!'], nei-zeil. } offänken: { Ausgab schreiwen: ['Dont catch this!']. }, starten.

Ausgab schreiwen: ['Test Array each-loop: 0,1'], nei-zeil.
(Lëscht ← 1 ; 2 ; 3) ofbilden: { :i
	Ausgab schreiwen: ['iteration #'] + i, nei-zeil.
	(i = 1) ofbriechen.
}.

Ausgab schreiwen: ['Test Map each-loop: c only'], nei-zeil.
>> m := Dictionnaire nei.
m setzen: ['first'] bei: ['a'], setzen: ['second'] bei: ['b'], setzen: ['third'] bei: ['c'].
m all: { :k :v
	Ausgab schreiwen: ['iteration'] + v + k, nei-zeil.
	Wouer ofbriechen.
}.

