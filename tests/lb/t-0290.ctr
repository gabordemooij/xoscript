# test list operations


>> cakes := Lëscht ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes ersetzen: 1 längt: 2 mat: ( Lëscht ← ['cinnamon'] ; ['pineapple'] ).
Ausgab schreiwen: (buy zesummesetzen: [',']), nei-zeil.


>> buy := cakes ersetzen: 1 längt: 12 mat: ( Lëscht ← ['cinnamon'] ; ['pineapple'] ).
Ausgab schreiwen: (buy zesummesetzen: [',']), nei-zeil.


>> buy := cakes ersetzen: 2 längt: 10 mat: ( Lëscht nei ).
Ausgab schreiwen: (buy zesummesetzen: [',']), nei-zeil.


>> buy := cakes ersetzen: 0 längt: 1 mat: ( Lëscht nei ).
Ausgab schreiwen: (buy zesummesetzen: [',']), nei-zeil.


>> buy := cakes ersetzen: ['0'] längt: ['1'] mat: ['x'].
Ausgab schreiwen: (buy zesummesetzen: [',']), nei-zeil.
