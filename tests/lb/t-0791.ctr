Server init.

>> DB := Maria-DB nei host: ['localhost'],
	benotzernumm: ['xo'],
	passwuert: ['pass123'],
	datebanknumm: ['xobase'],
	verbannen.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> sichparameter := Maria-Ufro nei: SQL.

# set database
sichparameter datebank: DB.

sichparameter ofruffen: { :row
	Ausgab schreiwen: row world, nei-zeil.
}.
