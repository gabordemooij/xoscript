Zuel bei: ['factorial'] maachen: {
	>> total := 1.
	{ :index total multiplizéieren-mat: (selwer - index). } × selwer. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm späicherverwaltung: 0.

{
2 exponent factorial.
Ausgab schreiwen: (11 modulo: 3), nei-zeil.
Ausgab schreiwen: (3.4 gerënnt), nei-zeil.
Ausgab schreiwen: (7.1 opronnen), nei-zeil.
Ausgab schreiwen: (7.9 ofronnen), nei-zeil.
}
starten.

Programm opraumen.

usedMemory1 := (Programm späicher ? 0).

{
2 exponent factorial.
Ausgab schreiwen: (11 modulo: 3), nei-zeil.
Ausgab schreiwen: (3.4 gerënnt), nei-zeil.
Ausgab schreiwen: (7.1 opronnen), nei-zeil.
Ausgab schreiwen: (7.9 ofronnen), nei-zeil.
}
starten.

Programm opraumen.
usedMemory2 := (Programm späicher ? 0).


{
2 exponent factorial.
Ausgab schreiwen: (11 modulo: 3), nei-zeil.
Ausgab schreiwen: (3.4 gerënnt), nei-zeil.
Ausgab schreiwen: (7.1 opronnen), nei-zeil.
Ausgab schreiwen: (7.9 ofronnen), nei-zeil.
} starten.

Programm opraumen.
usedMemory3 := (Programm späicher ? 0).



( usedMemory1 = usedMemory2 an: usedMemory1 = usedMemory3, an: usedMemory2 = usedMemory3 ) wouer: {
	Ausgab schreiwen: ['No memory leaks here'].
}, falsch: {
	Ausgab schreiwen: ['Leaking memory...'].
}.
