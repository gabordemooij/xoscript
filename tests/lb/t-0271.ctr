
Programm späicherverwaltung: 1.
Programm späicher: 16000000.
>> tokens := ['{}↲.:,x() '].
{ :i
	>> code := [''].
	>> x := Zuel tëscht: 1 an: 10.
	{
		>> y := Zuel tëscht: 1 an: (tokens längt).
		code drunhänken: (tokens zeechen: y).
	} × x.
	{ Funktioun nei: code. } offänken: { ['Empty']. }, starten.

} × 10000.
