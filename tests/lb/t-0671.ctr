# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Tresor schlësselen-generéieren.

# private (secret) key
>> sk := keys éischten.

# public key
>> pk := keys lescht.

# sign a message
>> sig := Tresor ënnerschreiwen: ['abc'] mat: sk.

# check message (ok)
Ausgab schreiwen: ( 
	Tresor
		iwwerpréiwen: ['abc'] 
		ënnerschrëft: sig 
		mat: pk 
), nei-zeil.

# check message (fail)
Ausgab schreiwen: ( 
	Tresor 
		iwwerpréiwen: ['abd'] 
		ënnerschrëft: sig 
		mat: pk 
), nei-zeil.