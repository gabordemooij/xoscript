{
	>> a := Lëscht nei.
	a drunhänken: 1.
	a drunhänken: 2.
	Ausgab schreiwen: (a zesummesetzen: [',']), nei-zeil.
	a setzen: 3 bei: 2.
	Ausgab schreiwen: (a zesummesetzen: [',']), nei-zeil.
	a setzen: 4 bei: 10.
	Ausgab schreiwen: (a zesummesetzen: [',']), nei-zeil.
	a éischt-eraushuelen.
	a éischt-eraushuelen.
	a éischt-eraushuelen.
	Ausgab schreiwen: (a zesummesetzen: [',']), nei-zeil.
	a setzen: 9 bei: 0.
	Ausgab schreiwen: (a zesummesetzen: [',']), nei-zeil.
	a setzen: 6 bei: -1.
} offänken: { :e
	Ausgab schreiwen: ['Uncatched error has occurred.↵'] + e, nei-zeil.
}, starten.


