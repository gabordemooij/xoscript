#Linux
>> Slurp := Objet nei.

Slurp bei: ['nei'] maachen: {
	eegen str := [''].
}.

Slurp bei: ['nieuw'] maachen: {
	eegen str := [''].
}.

Slurp bei: ['äntweren:'] maachen: { :blah
		eegen str drunhänken: blah.
}.

Slurp bei: ['äntweren:an:'] maachen: { :blah :blahah
		eegen str drunhänken: (blah vun: 0 längt: (blah längt - 1)).
		eegen str drunhänken: [' '].
		eegen str drunhänken: blahah.
}.

Slurp bei: ['obtain'] maachen: {
	>> buffer := eegen str.
	eegen str := ['']. <- buffer.
}.


Ausgab schreiwen: (Programm system: (Slurp nei echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Fichier nei: ['/tmp/from.txt'], läschen. } offänken: { ['Empty']. }, starten.
{ Fichier nei: ['/tmp/to.txt'], läschen. } offänken: { ['Empty']. }, starten.


Fichier nei: ['/tmp/to.txt'], existéiert falsch: {
	Ausgab schreiwen: ['Confirmed. Target file does not exist.\
'].
}.
Fichier nei: ['/tmp/from.txt'], existéiert falsch: {
	Ausgab schreiwen: ['Confirmed. Source file does not exist.\
'].
}.



Programm system: (Slurp nei touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Programm system: (Slurp nei cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Fichier nei: ['/tmp/to.txt'], existéiert wouer: {
	Ausgab schreiwen: ['Confirmed. Target file has been created by shell.\
'].
}.


Ausgab schreiwen: ['Contents of file is:'] + (Fichier nei: ['/tmp/to.txt'], liesen), nei-zeil.
