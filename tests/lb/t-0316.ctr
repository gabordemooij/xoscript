>> Grandfather := Objet nei.
Grandfather bei: ['greet'] maachen: {
	Ausgab schreiwen: ['Ave!'], nei-zeil.
}.
>> Father := Grandfather nei.
Father bei: ['greet'] maachen: {
	Ausgab schreiwen: ['Hello'], nei-zeil.
	selwer greet.
}.
>> Son := Father nei.
Son bei: ['greet'] maachen: {
	Ausgab schreiwen: ['Hi'], nei-zeil.
	selwer greet.
}.

Son greet.

>> Roundabout := Objet nei.
Roundabout bei: ['circle:'] maachen: { :x
	Ausgab schreiwen: x, nei-zeil.
	(x < 3) wouer: { selwer rekursiv circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) wouer: { Ausgab schreiwen: x, nei-zeil. x dobäisetzen: 1.  increment starten. }. }.
increment starten.