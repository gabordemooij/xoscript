>> HTML := Objet nei.
HTML bei: ['äntweren:'] maachen: { :tag 
	Ausgab schreiwen: (['<tag>'] tag: tag), nei-zeil.
}.
HTML bei: ['äntweren:an:'] maachen: { :tag :html 
	Ausgab schreiwen: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), nei-zeil.
}.
>> html := HTML nei.
html body h1: ['header'].

