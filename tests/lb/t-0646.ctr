Server init.
Ausgab schreiwen: ['Database datetime test'], nei-zeil.

>> db := Maria-DB nei host: ['localhost'],
	benotzernumm: ['xo'], 
	passwuert: ['pass123'],
	datebanknumm: ['xobase'],
	verbannen.

>> sichparameter :=
db ufro: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
ofruffen: { :row
	Ausgab schreiwen: row datetimetest, nei-zeil.
}.
