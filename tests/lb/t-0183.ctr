

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm späicherverwaltung: 0.

>> o := Objet nei.
>> o2 := Objet nei.
Ausgab schreiwen: o Näischt?, nei-zeil.
Ausgab schreiwen: o typ, nei-zeil.
Ausgab schreiwen: ( o gläich: o ), nei-zeil.
Ausgab schreiwen: ( o gläich: o2 ), nei-zeil.
Ausgab schreiwen: o ech-selwer, nei-zeil.
Ausgab schreiwen: ( o maachen fäerdeg ), nei-zeil.

Programm opraumen.

usedMemory1 := (Programm späicher ? 0).


o := Objet nei.
o2 := Objet nei.
Ausgab schreiwen: o Näischt?, nei-zeil.
Ausgab schreiwen: o typ, nei-zeil.
Ausgab schreiwen: ( o gläich: o ), nei-zeil.
Ausgab schreiwen: ( o gläich: o2 ), nei-zeil.
Ausgab schreiwen: o ech-selwer, nei-zeil.
Ausgab schreiwen: ( o maachen fäerdeg ), nei-zeil.

Programm opraumen.
usedMemory2 := (Programm späicher ? 0).


o := Objet nei.
o2 := Objet nei.
Ausgab schreiwen: o Näischt?, nei-zeil.
Ausgab schreiwen: o typ, nei-zeil.
Ausgab schreiwen: ( o gläich: o ), nei-zeil.
Ausgab schreiwen: ( o gläich: o2 ), nei-zeil.
Ausgab schreiwen: o ech-selwer, nei-zeil.
Ausgab schreiwen: ( o maachen fäerdeg ), nei-zeil.

