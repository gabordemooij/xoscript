# test catch-all methods
>> x13 := Objet nei.
x13 bei: ['a'] maachen: { :a Ausgab schreiwen: 0, nei-zeil. }.
x13 bei: ['a:'] maachen: { :a Ausgab schreiwen: a, nei-zeil. <- 5. }.
x13 bei: ['a:b:'] maachen: { :a :b Ausgab schreiwen: (a + b), nei-zeil. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
