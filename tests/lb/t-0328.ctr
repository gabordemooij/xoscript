Programm späicherverwaltung: 4.

>> Doubler := Objet nei.
>> Multiplier := Objet nei.
Doubler bei: ['double:and:'] maachen: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier bei: ['multiply:and:'] maachen: { :x :y <- (x × y).
}.

Ausgab schreiwen: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), nei-zeil.
