>> items := Dictionnaire nei.
items setzen: ['green'] bei: ['color-1'].
items setzen: ['orange'] bei: ['color-2'].
items setzen: ['red'] bei: ['color-3'].
>> i := 0.
>> s := [''].
items all: { :key :color
	Ausgab schreiwen: ['color #'] + i + [' is: '] + color + [' '].
	i dobäisetzen: 1.
}.
Ausgab schreiwen: i + [' colors!'].
