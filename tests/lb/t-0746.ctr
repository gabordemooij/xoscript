Ausgab schreiwen: ['Test object'], nei-zeil.
>> a := Objet nei. 

a bei: ['item:'] maachen: { :dict
	eegen dict := dict. 
}.

a bei: ['item'] maachen: { <- eegen dict.
}.

a item: (
Dictionnaire nei
	hello: ['world'],
	world: (Dictionnaire nei setzen: ['a'] bei: ['b'])).

Ausgab schreiwen: a item, nei-zeil.

>> old-dict-address := a item prototyp späicheradress.
a save-as: ['/tmp/a.bin'].
Ausgab schreiwen: ['========== RELOADING SNAP:'], nei-zeil.

>> b := Objet load-from: ['/tmp/a.bin'].

(b item prototyp späicheradress = old-dict-address) wouer: {
	Ausgab schreiwen: ['Object link re-attached.'], nei-zeil.
}.

Ausgab schreiwen: b item, nei-zeil.
