# test number -> string -> number
{

	>> x := Zuel tëscht: 0 an: 1000000.
	>> d := Zuel tëscht: 1 an: 7.
	>> e := 10 héich: d.

	x deelen-duerch: e.
	>> y := x text zuel.

	(x = y) falsch: {
		Ausgab schreiwen: x, nei-zeil.
		Ausgab schreiwen: y, nei-zeil.
		Programm enn.
	}.

} * 1000.
Ausgab schreiwen: ['OK'], nei-zeil.