
>> Size := Objet nei.
Size bei: ['is:'] maachen: { :zuel
	zuel bei: ['+'] maachen: { :zuel
		>> unit := zuel qualifikatioun.
		>> factor := 1.
		
		unit
		fall: ['inch'] maachen: { factor := 0.0833. }. <- selwer + (zuel * factor).
	}. <- zuel.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Ausgab schreiwen: plank + edge, nei-zeil.
