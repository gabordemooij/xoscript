Text bei: ['evaluate'] maachen: {
	>> code := Fichier nei: ['/tmp/eval.ctr'].
	code schreiwen: (selwer text + ['.']).
	Programm benotzen: ['/tmp/eval.ctr'].
}.

>> a := Lëscht ← 1 ; 2 ; 3.
>> b := (a text).

Ausgab schreiwen: b, nei-zeil. 
(['b := '] + b) evaluate.

Ausgab schreiwen: b ? 2, nei-zeil. 

Ausgab schreiwen: (( Lëscht ← 1 ; 2 ; 3 )), nei-zeil. 

Ausgab schreiwen: ((Dictionnaire nei) setzen: 1 bei: 2), nei-zeil. 

>> x := ( (Lëscht ← 1 ; ( Lëscht ← 9 ) ; Wouer ) ) text.
Ausgab schreiwen: x, nei-zeil. 
(['x := '] + x) evaluate.

Ausgab schreiwen: x ? 1 ? 0, nei-zeil. 

>> y := (Dictionnaire nei) setzen: (Lëscht ← 1) bei: (Lëscht ← 2).
Ausgab schreiwen: y, nei-zeil. 

(['y := '] + y) text evaluate.

Ausgab schreiwen: (y bei: (Lëscht ← 2) text ), nei-zeil.

Ausgab schreiwen: (Lëscht nei), nei-zeil. 
Ausgab schreiwen: (Dictionnaire nei), nei-zeil. 
