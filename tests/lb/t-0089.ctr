>> randomizer := { :a :b
	>> minimum := ( a < b ) entweder: a oder: b.
	>> maximum := ( a > b ) entweder: a oder: b.
	>> x := Näischt.
	{
		x := Zuel tëscht: a an: b.
		((x < minimum) oder: (x > maximum)) wouer: { 
			Ausgab schreiwen: (['Invalid value!']).
			Programm enn.
		}.
	} 
	× 100. <- x.
}.
randomizer uwenden: 0 an: 0.
randomizer uwenden: 1 an: 0.
randomizer uwenden: 1 an: 1.
randomizer uwenden: 0 an: 1.
randomizer uwenden: -1 an: 0.
