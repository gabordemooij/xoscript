#Linux
>> clock := Moment nei.
clock zone: ['UTC-1'].
clock joer: 1981, mount: 1, dag: 5,
      stonn: 13, minutt: 15, sekonn: 13.

Ausgab schreiwen: clock, nei-zeil.
clock zone: ['UTC+0'].

Ausgab schreiwen: (
	(clock joer einfach) + ['-'] + (clock mount) + ['-'] + (clock dag) + [' '] +
	(clock stonn) + [':'] + (clock minutt) + [':'] + (clock sekonn) + [' '] +
	['W'] + (clock woch) + (clock zone)
), nei-zeil.


clock zone: ['UTC-1'].
Ausgab schreiwen: (
	(clock joer einfach) + ['-'] + (clock mount) + ['-'] + (clock dag) + [' '] +
	(clock stonn) + [':'] + (clock minutt) + [':'] + (clock sekonn) + [' '] +
	['W'] + (clock woch) + (clock zone)
), nei-zeil.
