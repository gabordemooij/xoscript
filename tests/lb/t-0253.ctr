#Linux
>> OS := Programm astellung: ['OS'].

>> clock := Moment nei.
	
(OS = ['Haiku']) wouer: {
	clock zone: ['CET'],
	joer: 2017, mount: 7, dag: 13,
	stonn: 18, minutt: 0, sekonn: 0.
}, anescht: {
	clock zone: ['Europe/Amsterdam'],
	joer: 2017, mount: 7, dag: 13,
	stonn: 18, minutt: 0, sekonn: 0.
}.

clock bei: ['tell'] maachen: {
	Ausgab schreiwen: selwer, nei-zeil.
}.


clock dobäisetzen: 2    stonn, tell.
clock dobäisetzen: 1    stonn, tell.
clock dobäisetzen: 19 minutt, tell.
clock dobäisetzen: 1  minutt, tell.
clock dobäisetzen: 1  minutt, tell.
clock dobäisetzen: 19 sekonn, tell.
clock dobäisetzen: 1  sekonn, tell.
clock dobäisetzen: 1  sekonn, tell.
clock dobäisetzen: 2    joer, tell.
clock dobäisetzen: 1    joer, tell.

(OS = ['Haiku']) wouer: {
clock dobäisetzen: 5   mount.
clock zone: ['CEST'], tell.
}, anescht: {
	clock dobäisetzen: 5   mount, tell.
}.

clock dobäisetzen: 1   mount, tell.
clock dobäisetzen: 19    dag, tell.
clock dobäisetzen: 1    stonn, tell.
clock dobäisetzen: 120  yard, tell.
