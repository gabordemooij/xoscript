Ausgab schreiwen: ['Test object'], nei-zeil.
>> cmd := Befeel nei.
Ausgab schreiwen: cmd ls /tmp, nei-zeil.
>> old-cmd-address := cmd prototyp späicheradress.
cmd save-as: ['/tmp/a.bin'].
Ausgab schreiwen: ['========== RELOADING SNAP:'], nei-zeil.
>> b := Objet load-from: ['/tmp/a.bin'].
(b prototyp späicheradress = old-cmd-address) wouer: {
	Ausgab schreiwen: ['Object link re-attached.'], nei-zeil.
}.
Ausgab schreiwen: b ls, nei-zeil.


