

>> Matryoshka := Objet nei.
Matryoshka bei: ['double:'] maachen: { :secret
	eegen secret := secret × 2.
}.
Matryoshka bei: ['nei:'] maachen: { :secret
	>> answer := Näischt.
	>> t := (secret > 255).
	Ausgab schreiwen: (secret + [' | '] + t), nei-zeil.
	t wouer: {
		answer := secret.
	}, anescht: {
		answer := Matryoshka rekursiv nei: (selwer double: secret).
	}. <- answer.
}.

>> x := Matryoshka nei: 2.
