>> Greeter := Objet nei.
Greeter bei: ['make'] maachen: {
	>> gr := Objet nei.
	gr bei: ['setName:'] maachen: { :aname
		eegen numm := aname.
	}.
	gr bei: ['greet'] maachen: {
		Ausgab schreiwen: eegen numm.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a nei.
c setName: ['THREE'].
c greet.
>> d := a nei.
d setName: ['FOUR'].
d greet.
c greet.
