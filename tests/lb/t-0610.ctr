
>> Rectangle := Objet nei.

Rectangle bei: ['area'] maachen: { <- eegen längt * eegen width.
}.

Rectangle bei: ['length:'] maachen: { :längt
	eegen längt := längt.
}.

Rectangle bei: ['width:'] maachen: { :width
	eegen width := width.
}.

Rectangle bei: ['nei'] maachen: {
	# this will not result into an infinite loop
	>> rectangle := selwer nei.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle nei.
Ausgab schreiwen: a area, nei-zeil. #0

>> b := Rectangle nei length: 2, width: 3.
Ausgab schreiwen: b area, nei-zeil. #6

