Ausgab schreiwen: ['Test object'], nei-zeil.
>> a := Objet nei. 

a bei: ['item:'] maachen: { :out
	eegen out := out. 
}.

a bei: ['item'] maachen: { <- eegen out.
}.

a bei: ['greet'] maachen: {
	Ausgab schreiwen: ['hi from original out!'], nei-zeil.
}.

a item: Ausgab.

Ausgab schreiwen: a item, nei-zeil.

>> old-out-address := a item prototyp späicheradress.
a save-as: ['/tmp/a.bin'].
Ausgab schreiwen: ['========== RELOADING SNAP:'], nei-zeil.

>> b := Objet load-from: ['/tmp/a.bin'].

(b item prototyp späicheradress = old-out-address) wouer: {
	Ausgab schreiwen: ['Object link re-attached.'], nei-zeil.
}.

b item schreiwen: ['hello from loaded out!'], nei-zeil.
b greet.
