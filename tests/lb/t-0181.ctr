

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm späicherverwaltung: 0.

>> txt := ['World Salad'].
Ausgab schreiwen: ['this text contains: '] + ( ( txt deelen: [' '] ) zielen ) + [' words.'], nei-zeil.
txt := txt vun: 6 längt: 4.
Ausgab schreiwen: txt, nei-zeil.

Programm opraumen.

usedMemory1 := (Programm späicher ? 0).


txt := ['World Salad'].
Ausgab schreiwen: ['this text contains: '] + ( ( txt deelen: [' '] ) zielen ) + [' words.'], nei-zeil.
txt := txt vun: 6 längt: 4.
Ausgab schreiwen: txt, nei-zeil.

Programm opraumen.
