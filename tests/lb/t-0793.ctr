Server init.

>> DB := Maria-DB nei host: ['localhost'],
	benotzernumm: ['xo'],
	passwuert: ['pass123'],
	datebanknumm: ['xobase'],
	verbannen.

{
	DB ufro:
	['DROP TABLE movies'],
	ausféieren.
} offänken: { Näischt. }, starten.

DB ufro:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
ausféieren.

DB ufro: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parameter: ( Lëscht nei ; ['Halloween'] ),
ausféieren.

DB ufro: ['SELECT * FROM movies'],
ofruffen: { :movie
	Ausgab schreiwen: movie title, nei-zeil.
}.

