# test buffers PKI/Sign 
Server init.

>> long := ( Lëscht nei fëllt: 1000 mat: ['a'] ) zesummesetzen: [''].

# sign a message
Ausgab schreiwen: ( 
	Tresor ënnerschreiwen: ['abc'] mat: long
), nei-zeil.

Ausgab schreiwen: ( 
	Tresor
		iwwerpréiwen: ['abc'] 
		ënnerschrëft: long 
		mat: long
), nei-zeil.

Ausgab schreiwen: (
	Tresor passwuert-hash: long iwwerpréiwen: long
), nei-zeil.
