Ausgab schreiwen: ['Test object'], nei-zeil.
>> a := Objet nei. 

a bei: ['item:'] maachen: { :moment
	eegen moment := moment. 
}.

a bei: ['item'] maachen: { <- eegen moment.
}.

>> today := Moment nei zone: ['CEST'], joer: 2026, mount: 7.
a item: today.
Ausgab schreiwen: a item, nei-zeil.
a save-as: ['/tmp/a.bin'].

