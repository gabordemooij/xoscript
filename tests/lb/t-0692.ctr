Server init.

Ausgab schreiwen: (
	Muster nei: ['^\\w+$'],
	treffer: ['test@example.com'] 
), nei-zeil. # 0 match, fails on @ and .

Ausgab schreiwen: (
	Muster nei: ['^[^@]+@[^\.]+\.\\w+$'],
	treffer: ['test@example.com'] 
), nei-zeil. # 1 match

Ausgab schreiwen: (
	Muster nei: ['[^@]+@[^\.]+\.\\w+'],
	treffer: ['test@example.com'] 
), nei-zeil. # 1 match

Ausgab schreiwen: (
	Muster nei: ['([^@]+)@([^\.]+)\.\\w+'],
	treffer: ['test@example.com'] 
), nei-zeil. # 1 match, groups dont matter

Ausgab schreiwen: (
	Muster nei: ['[a-z]'],
	treffer: ['test@example.com'] 
), nei-zeil. # 14 matches

Ausgab schreiwen: (
	Muster nei: ['.*'],
	treffer: ['test@example.com'] 
), nei-zeil. # 1 match (all)

Ausgab schreiwen: (
	Muster nei: ['(.*)'],
	treffer: ['test@example.com'] 
), nei-zeil. # 1 match (all)

Ausgab schreiwen: (
	Muster nei: ['\\s*[^@]+@[^\.]+\.\\w+'],
	treffer: ['test@example.com'] 
), nei-zeil. # 1 match, prefix space optional, gets ignored