Ausgab schreiwen: ['Test object'], nei-zeil.
>> a := Objet nei. 

a bei: ['item:'] maachen: { :file
	eegen file := file. 
}.

a bei: ['item'] maachen: { <- eegen file.
}.

>> f := Fichier nei: ['/tmp/aaa.txt'].
a item: f.
Ausgab schreiwen: a item, nei-zeil.
a save-as: ['/tmp/a.bin'].
Ausgab schreiwen: ['========== RELOADING SNAP:'], nei-zeil.
>> b := Objet load-from: ['/tmp/a.bin'].
Ausgab schreiwen: b item, nei-zeil.
