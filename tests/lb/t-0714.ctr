>> a := Objet nei. 
a bei: ['greet'] maachen: { Ausgab schreiwen: ['welcome!'], nei-zeil. }.
a bei: ['greet2'] maachen: { Ausgab schreiwen: ['welcome2!'], nei-zeil. }.
a save-as: ['/tmp/a.bin'].

Ausgab schreiwen: ['========== RELOADING SNAP:'], nei-zeil.
>> b := Objet load-from: ['/tmp/a.bin'].
b greet2.