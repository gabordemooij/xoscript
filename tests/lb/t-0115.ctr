{
	dës-aufgab feeler: ['Dont fail.'].
	unknown doSomething.
} offänken: {
	Ausgab schreiwen: ['Caught!'].
}, starten.

{
	dës-aufgab feeler: ['Dont fail.'].
	eegen unknown doSomething.
} offänken: {
	Ausgab schreiwen: ['Caught!'].
}, starten.

{
	dës-aufgab feeler: ['Dont fail.'].
	unknown := 122.
} offänken: {
	Ausgab schreiwen: ['Caught!'].
}, starten.


{
	dës-aufgab feeler: ['Dont fail.'].
	Wouer ofbriechen.
	Ausgab schreiwen: ['FAIL'].
} offänken: {
	Ausgab schreiwen: ['Caught!'].
}, starten.

{
	{
		dës-aufgab feeler: ['Dont fail.'].
		Wouer ofbriechen.
		Ausgab schreiwen: ['FAIL'].
	} offänken: { :x
		(x = ['Dont fail.']) wouer: { dës-aufgab feeler: ['Nested Caught!']. }.
	}, starten.
} offänken: { :e
	Ausgab schreiwen: e.
}, starten.
