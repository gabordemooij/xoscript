#OBSD
>> dirname := [''].
{ dirname drunhänken: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Programm system: command.
Programm chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename drunhänken: ['YYYYYYYY']. } * 20.
Fichier nei: filename, schreiwen: ['sometext'].
{ Fichier lëscht: ['/tmp/'] + dirname. } * 1000.
Ausgab schreiwen: ['no crash'], nei-zeil.

