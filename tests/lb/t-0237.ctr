
Text bei: ['evaluate'] maachen: {
	>> code := Fichier nei: ['/tmp/eval.ctr'].
	code schreiwen: (selwer text + ['.']).
	Programm benotzen: ['/tmp/eval.ctr'].
}.

>> map :=
	(Dictionnaire nei)
	setzen: ['Hi There'] bei: ['two'],
	setzen: (Lëscht ← ['hello'] ; ['world'] ; (Lëscht ← 1 ; 2; 9) ; Falsch) bei: ['one'],
	setzen: ( (Dictionnaire nei) setzen: ['wrrld'] bei: ['misspelled'] ) bei: ['three'],
	setzen: (Lëscht ← ((Dictionnaire nei) setzen: ['treasure'] bei: ['hidden']) ; 2) bei: ['four']. 
>> str := map text.
>> map2 := Näischt.
(['map2 := '] + str ) evaluate.
Ausgab schreiwen: map2 ? ['one'] ? 0.
Ausgab schreiwen: map2 ? ['one'] ? 1.
Ausgab schreiwen: map2 ? ['four'] ? 0 ? ['hidden'].
Ausgab schreiwen: map2 ? ['one'] ? 2 ? 2.
