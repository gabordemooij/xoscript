>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm späicherverwaltung: 0.

>> f := Fichier nei: ['/tmp/citrine_test_file.txt'].
f exists: { f läschen. }.
f schreiwen: ['hello world'].
>> q := f wee.

f := Fichier nei: ['/tmp/citrine_test_file.txt'].
q := f wee.

Programm opraumen.
usedMemory1 := (Programm späicher ? 0).


f := Fichier nei: ['/tmp/citrine_test_file.txt'].
