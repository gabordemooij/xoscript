

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm späicherverwaltung: 0.

{
>> q := ['You should be able'].
q drunhänken: ([' to append something to a string']+['!']).
Ausgab schreiwen: q.
} starten.

Programm opraumen.
usedMemory1 := (Programm späicher ? 0).


{
>> q := ['You should be able'].
q drunhänken: ([' to append something to a string']+['!']).
Ausgab schreiwen: q.
} starten.

Programm opraumen.
usedMemory2 := (Programm späicher ? 0).


{
>> q := ['You should be able'].
q drunhänken: ([' to append something to a string']+['!']).
Ausgab schreiwen: q.
} starten.

Programm opraumen.
