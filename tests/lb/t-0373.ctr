# compliance test

# use international numbers

Ausgab schreiwen: ['1000 -> '].
Ausgab schreiwen: 1000, nei-zeil. #1000

Ausgab schreiwen: ['1.5 -> '].
Ausgab schreiwen: 1.5, nei-zeil.  #1.5

Ausgab schreiwen: ['1001.5 -> '].
Ausgab schreiwen: 1.5 + 1000, nei-zeil. #1001.5

# use 0-indexed arrays
>> x := Lëscht nei ; 1 ; 2 ; 3.
>> y := Lëscht nei ; ['a'] ; ['b'] ; ['c'].

Ausgab schreiwen: ['1 -> '].
Ausgab schreiwen: x ? 0, nei-zeil. #1

Ausgab schreiwen: ['1 -> '].
Ausgab schreiwen: (x bei: 0), nei-zeil. #1

Ausgab schreiwen: ['1 -> '].
Ausgab schreiwen: x éischten, nei-zeil. #1

Ausgab schreiwen: ['3 -> '].
Ausgab schreiwen: x lescht, nei-zeil. #3

Ausgab schreiwen: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Ausgab schreiwen: (x no: y), nei-zeil.

Ausgab schreiwen: ['1 -> '].
Ausgab schreiwen: (x vun: 0 längt: 1) éischten, nei-zeil. #1

Ausgab schreiwen: ['0 -> '].
Ausgab schreiwen: (x fannen: 1), nei-zeil. #0

x setzen: 9 bei: 0.

Ausgab schreiwen: ['9 -> '].
Ausgab schreiwen: (x bei: 0), nei-zeil. #9

x virdrun-setzen: 8.
Ausgab schreiwen: ['8 -> '].
Ausgab schreiwen: (x bei: 0), nei-zeil. #9


x drunhänken: 10.
Ausgab schreiwen: ['10 -> '].
Ausgab schreiwen: (x bei: 4), nei-zeil. #10








