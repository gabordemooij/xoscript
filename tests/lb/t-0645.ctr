Server init.
Ausgab schreiwen: ['Database date test'], nei-zeil.

>> db := Maria-DB nei host: ['localhost'],
	benotzernumm: ['xo'], 
	passwuert: ['pass123'],
	datebanknumm: ['xobase'],
	verbannen.

>> sichparameter :=
db ufro: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
ofruffen: { :row
