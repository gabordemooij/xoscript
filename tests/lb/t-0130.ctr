# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Programm astellung: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server verbannen: ( Lëscht nei ;
 libname ; ['fopen'] ;
 ( Lëscht nei ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
verbannen: ( Lëscht nei ;
 Näischt ; # means same lib
 ['fread'] ;
 ( Lëscht nei ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Näischt ; # means same object (i.e. Stream)
 ['fread']
),
verbannen: (
 Lëscht nei ;
 Näischt ; # means same lib
 ['fwrite'] ;
 ( Lëscht nei ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Näischt ; # means same lib
 ['fwrite']
),
verbannen: (
 Lëscht nei ;
 Näischt ; # means same lib
 ['rewind'] ;
 ( Lëscht nei ; ['pointer'] ) ;
 ['int'] ;
 Näischt ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> wee := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: wee mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream noriicht: ['fwrite'] argumenter: (Lëscht nei ; str ; 1 ; 6 ; fd ).
Ausgab schreiwen: bytes-written, nei-zeil.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob nei: 20.

# read from file
>> bytes-read := Stream noriicht: ['fread'] argumenter: (Lëscht nei ; buf ; 1 ; 6 ; fd ).
Ausgab schreiwen: bytes-read, nei-zeil.
Ausgab schreiwen: buf, nei-zeil.

# free memory
str  fräiginn.
wee fräiginn.
mode fräiginn.
buf  fräiginn.


