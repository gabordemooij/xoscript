

Lëscht bei: ['column:'] maachen: { :column
	>> result := Lëscht nei.
	selwer all: { :index :row
		row all: { :index :cell
			(index = column) wouer: { result drunhänken: cell. }.
		}.
	}. <- result.
}.


>> a := Lëscht ←
	(Lëscht ← 1 ; 2 ; 3) ;
	(Lëscht ← 4 ; 5 ; 6) ;
	(Lëscht ← 7 ; 8 ; 9).

>> b := a column: 1.
Ausgab schreiwen: b, nei-zeil.

b := a column: 20.
Ausgab schreiwen: b, nei-zeil.

b := a column: -100.
Ausgab schreiwen: b, nei-zeil.
