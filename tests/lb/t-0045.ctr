Programm späicherverwaltung: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } offänken: {
		oops dobäisetzen: 1.
	}, starten.
} × 1000.

{
	Ausgab schreiwen: ['hi there!'].
	dës-aufgab feeler: ['oops'].
	Ausgab schreiwen: ['hi there!'].
	{ Ausgab schreiwen: ['dont print this']. } starten.
} offänken: { :e 
	Ausgab schreiwen: ['got ya!']. 
	Ausgab schreiwen: e.
}, starten.
