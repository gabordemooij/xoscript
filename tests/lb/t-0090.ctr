Ausgab schreiwen: ['1,2,3,4,5,6,7,8,9,A,'], nei-zeil.
>> Scope := Objet nei.
Scope bei: ['initialize:'] maachen: { :x eegen property := x. }.
Scope bei: ['confirm'] maachen: { Ausgab schreiwen: [',']. }.
Scope bei: ['test'] maachen: {
	Ausgab schreiwen: eegen property.
	selwer confirm.
	( 1 = 1 ) wouer: { Ausgab schreiwen: eegen property. selwer confirm. }.
	( 1 = 0 ) falsch: { Ausgab schreiwen: eegen property. selwer confirm. }.
	>> y := 2. { Ausgab schreiwen: eegen property. selwer confirm. } soulaang: { y ofzéien: 1. <- (y > 0). }.
	{ Ausgab schreiwen: eegen property. selwer confirm. } × 1.
	(Lëscht ← 1) all: {  Ausgab schreiwen: eegen property. selwer confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Dictionnaire nei one: ['item']) all: { Ausgab schreiwen: eegen property. selwer confirm. }.
	{ 1 ÷ 0. } offänken: { Ausgab schreiwen: eegen property. selwer confirm. }, starten.
	Ausgab nei-zeil.
}.
>> scope1 := Scope nei.
scope1 initialize: ['X'].
scope1 test.
>> function := { 
	eegen property := ['Y'].
	Ausgab schreiwen: eegen property.
	selwer confirm.
	( 1 = 1 ) wouer: { Ausgab schreiwen: eegen property. selwer confirm. }.
	( 1 = 0 ) falsch: { Ausgab schreiwen: eegen property. selwer confirm. }.
	>> y := 2. { Ausgab schreiwen: eegen property. selwer confirm. } soulaang: { y ofzéien: 1. <- (y > 0). }.
	{ Ausgab schreiwen: eegen property. selwer confirm. } × 1.
	(Lëscht ← 1) all: {  Ausgab schreiwen: eegen property. selwer confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Dictionnaire nei one: ['item']) all: { Ausgab schreiwen: eegen property. selwer confirm. }.
	{ 1 ÷ 0. } offänken: { Ausgab schreiwen: eegen property. selwer confirm. }, starten.
	Ausgab nei-zeil.
}.
function bei: ['confirm'] maachen: { Ausgab schreiwen: [',']. }.
function uwenden: 1 an: 2.
