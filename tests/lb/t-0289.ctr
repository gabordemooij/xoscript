#Linux
>> OS := Programm system: (Befeel uname -s), ofschneiden.

>> Slurp := Objet nei.
Slurp bei: ['nei'] maachen: {
	eegen str := [''].
}.
Slurp bei: ['äntweren:'] maachen: { :blah
		(eegen str ≠ ['']) wouer: {
			eegen str drunhänken: [' '].
		}.
		eegen str drunhänken: blah.
}.
Slurp bei: ['äntweren:an:'] maachen: { :blah :blahah
		(eegen str ≠ ['']) wouer: {
			eegen str drunhänken: [' '].
		}.
		(blah längt > 1) wouer: {
			eegen str drunhänken: (blah vun: 0 längt: (blah längt - 1)).
		}, anescht: {
			eegen str drunhänken: blah.
		}.
		eegen str drunhänken: [' '].
		eegen str drunhänken: blahah.
}.
Slurp bei: ['obtain'] maachen: {
	>> buffer := eegen str.
	eegen str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text drunhänken: ['hello'].
} × 1000.


Ausgab schreiwen: (
	Programm system: (
		Slurp nei
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

