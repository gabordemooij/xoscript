Ausgab schreiwen: ((Lëscht nei
	bei: ['plaque:'] maachen: { :x eegen o := x. },
	bei: ['plaque']  maachen: { <- eegen o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Lëscht ← 1)
	~ (Lëscht ← 1 ; 2)
	~ (Lëscht ← 1 ; 2 ; 3)
	~ (Lëscht ← 1 ; 2 ; 3 ; 4)
	~ (Lëscht ← 1 ; 2 ; 3 ; 4 ; 5)
) all: { :i :el
	{ Ausgab schreiwen: dës-aufgab. } × el zielen.
	Ausgab nei-zeil.
}) plaque, nei-zeil.


