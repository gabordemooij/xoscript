>> x := Moment nei.
x zone: ['CEST'],
joer:2017,
mount:01,
dag:10,
stonn: 10,
minutt: 0,
sekonn: 0.

Ausgab schreiwen: x, nei-zeil.

Ausgab schreiwen: x zäit, nei-zeil.

x dobäisetzen: 1 sekonn.
x dobäisetzen: 2 minutt.
x dobäisetzen: 3 stonn.
x dobäisetzen: 4 dag.
x dobäisetzen: 1 mount.
x dobäisetzen: 6 joer.

Ausgab schreiwen: x, nei-zeil.

x ofzéien: 1 sekonn.
x ofzéien: 2 minutt.
x ofzéien: 3 stonn.
x ofzéien: 4 dag.
x ofzéien: 1 mount.
x ofzéien: 6 joer.

Ausgab schreiwen: x, nei-zeil.

>> y := x kopéieren.
>> z := x.

Ausgab schreiwen: y, nei-zeil.
Ausgab schreiwen: z, nei-zeil.
Ausgab schreiwen: (x zone = y zone), nei-zeil.
Ausgab schreiwen: (x zäit = y zäit), nei-zeil.
Ausgab schreiwen: (x = z), nei-zeil.
Ausgab schreiwen: x dag-vum-joer, nei-zeil.
Ausgab schreiwen: x wochendag, nei-zeil.
Ausgab schreiwen: x woch, nei-zeil.
