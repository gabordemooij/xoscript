>> makeAdder := { :x
	>> f := { :y <- (eegen x + y). } setzen: ['x'] wäert: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i eegen q setzen: (eegen f uwenden: (eegen q ? i)) bei: i. } 
	setzen: ['q'] wäert: array,
	setzen: ['f'] wäert: func.
	{ :i mapping uwenden: i. } × (array zielen).
}.

>> a := Lëscht ← 1; 2; 3.
mapper uwenden: a an: (makeAdder uwenden: 100).
Ausgab schreiwen: (a positioun: 0), nei-zeil.
Ausgab schreiwen: (a ? 1), nei-zeil.
Ausgab schreiwen: (a ? 2), nei-zeil.
