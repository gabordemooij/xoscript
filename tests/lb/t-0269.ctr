#Linux

(Fichier nei: ['/tmp/testje']) existéiert falsch: {
	Programm system: ['mkdir /tmp/testje'].	
}.

(Fichier nei: ['/tmp/testje/file1']) existéiert falsch: {
	Programm system: ['touch /tmp/testje/file1'].	
}.

(Fichier nei: ['/tmp/testje/folder1']) existéiert falsch: {
	Programm system: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Fichier lëscht: ['/tmp/testje'].

>> q := Lëscht nei.

l all: { :k :v v all: { :x :y q drunhänken: y. }. }.

>> s := q text.

(s enthält: ['file1']) wouer:   { Ausgab schreiwen: ['OK'], nei-zeil. }.
(s enthält: ['file2']) wouer:   { Ausgab schreiwen: ['XX'], nei-zeil. }.
(s enthält: ['folder1']) wouer: { Ausgab schreiwen: ['OK'], nei-zeil. }.
