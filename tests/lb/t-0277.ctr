

>> Cat := Objet nei.

Cat bei: ['nei'] maachen: {
	eegen sound := ['meow!'].
}.

Cat bei: ['nieuw'] maachen: {
	eegen sound := ['meow!'].
}.

Cat bei: ['makeSound'] maachen: { <- eegen sound.
}.

Cat bei: ['greet'] maachen: { <- selwer makeSound.
}.

>> cat := Cat nei.
Ausgab schreiwen: cat greet.
