
{ :i
	Ausgab schreiwen: ['This is step #'] + ( ( i ) + 1 ), nei-zeil.
} × 6.

{ :i
	Ausgab schreiwen: ['This is step #'] + ( 3 - ( i ) ), nei-zeil.
} × 6.

{ :i
	Ausgab schreiwen: ['NEVER!'], nei-zeil.
} × 0.



{ :i
	Ausgab schreiwen: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), nei-zeil.
} × 11.
