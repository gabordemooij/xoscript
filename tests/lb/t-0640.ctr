
Server init.
Ausgab schreiwen: ['Database test'], nei-zeil.

>> db := Maria-DB nei host: ['localhost'],
	benotzernumm: ['xo'], 
	passwuert: ['pass123'],
	datebanknumm: ['xobase'],
	verbannen.

>> sichparameter :=
db ufro: ['SELECT UNHEX('CAFE') AS blobby'],
ofruffen: { :row
	Ausgab schreiwen: ( row blobby vun: 0 längt: 2 ), nei-zeil.
	row blobby fräiginn.
}.
