
Programm späicherverwaltung: 4.

>> Animal := Objet nei.
Animal bei: ['make'] maachen: {
	>> animal := Objet nei.
	animal bei: ['makeSound'] maachen: {
		Ausgab schreiwen: eegen sound.
	}. <- animal.
}.
>> Cat := Objet nei.
Cat bei: ['make'] maachen: {
	>> cat := Animal make.
	cat bei: ['init'] maachen: {
		eegen sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
