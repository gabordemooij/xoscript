Ausgab schreiwen: ['Continue for-loop, No - before 6 and up.'], nei-zeil.
{ :i
	Ausgab schreiwen: (i + 1), nei-zeil.
	((i + 1) > 4) weiderfueren.
	Ausgab schreiwen: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Ausgab nei-zeil.
Ausgab schreiwen: ['Continue while-true, No --> before 5 and up.'], nei-zeil.
{
	Ausgab schreiwen: ['iteration #'] + x, nei-zeil.
	x dobäisetzen: 1.
	((x < 5) net) weiderfueren.
	Ausgab schreiwen: ['-->'].
} soulaang: xIsLessThan10.
Ausgab nei-zeil.
Ausgab schreiwen: ['Continue while-false, No - before 3 only.'], nei-zeil.
{
	Ausgab schreiwen: ['iteration #'] + x, nei-zeil.
	x ofzéien: 1.
	(x = 3) weiderfueren.
	Ausgab schreiwen: ['-'].
} soulaang: { <- ( x > 0). }.

Ausgab nei-zeil.
Ausgab schreiwen: ['Continue times-loop, No ||| before 3.'], nei-zeil.
{ :i
	Ausgab schreiwen: ['iteration #'] + i, nei-zeil.
	(i = 2) weiderfueren.
	Ausgab schreiwen: ['|||'].
} × 5.

Ausgab nei-zeil.

{ Wouer weiderfueren. Ausgab schreiwen: ['dont write this!'], nei-zeil. } starten.

{ Wouer weiderfueren. Ausgab schreiwen: ['dont write this!'], nei-zeil. } offänken: { Ausgab schreiwen: ['Dont catch this!']. }, starten.

Ausgab schreiwen: ['Test Array each-loop: 0, ... ,2'], nei-zeil.
(Lëscht ← 1 ; 2 ; 3) ofbilden: { :i
	(i = 1) weiderfueren.
	Ausgab schreiwen: ['iteration #'] + (i - 0), nei-zeil.
}.

Ausgab schreiwen: ['Test Map each-loop: c only'], nei-zeil.
>> m := Dictionnaire nei.
m setzen: ['first'] bei: ['a'], setzen: ['second'] bei: ['b'], setzen: ['third'] bei: ['c'].
m all: { :k :v
	(k ≠ ['c']) weiderfueren.
	Ausgab schreiwen: ['iteration'] + k + v, nei-zeil.
}.

