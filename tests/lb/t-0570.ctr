#Linux

 >> t := Moment nei.
 
t zone: ['Europe/Amsterdam'].
t joer: 2020, mount: 8, dag: 2, stonn: 21, minutt: 2, sekonn: 1.

>> a := t stonn.
>> ams := t zone.

t zone: ['US/Hawaii'].
>> b := t stonn.
>> hw := t zone.

Ausgab
schreiwen: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		entweder: ['later'] oder: ['earlier']
	)
),
nei-zeil.
 