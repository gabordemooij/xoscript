# a quote that never closes must give an error, not an endless loop
>> wee := ['/tmp/test0821.csv'].
>> file := Fichier nei: wee.

file schreiwen: ['a,b\n"1,2\n'].
{
	file trennzeechen: [','] gänseféisschen: ['"'] zeilen: { :line
		Ausgab schreiwen: line, nei-zeil.
	}.
} offänken: { :e Ausgab schreiwen: e, nei-zeil. }, starten.

# a closed quote still works
file schreiwen: ['a,b\n"1,2",3'].
file trennzeechen: [','] gänseféisschen: ['"'] zeilen: { :line
	Ausgab schreiwen: line, nei-zeil.
}.
file läschen.
