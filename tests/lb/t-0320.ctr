


>> CoffeeMachine := Objet nei.
CoffeeMachine bei: ['order:'] maachen: { :id
	>> coffee := ['Americano'].
	( id = 1 ) wouer: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) wouer: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) wouer: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Objet nei.
SimpleCoffeeMachine bei: ['order'] maachen: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Ausgab schreiwen: redCup, nei-zeil.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Ausgab schreiwen: greenCup, nei-zeil.
>> yellowCup := CoffeeMachine order: 1.
Ausgab schreiwen: yellowCup, nei-zeil.
>> blueCup := CoffeeMachine order: 0.
Ausgab schreiwen: blueCup, nei-zeil.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Ausgab schreiwen: blackCup, nei-zeil.
blackCup drunhänken: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Ausgab schreiwen: orangeCup, nei-zeil.
