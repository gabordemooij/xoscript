


>> wine := Objet nei.


wine bei: ['toString'] maachen: { <- ['merlot'].
}.

wine bei: ['naarTekst'] maachen: { <- ['merlot'].
}.


wine bei: ['='] maachen: { :other wine <- ( selwer toString = other wine ).
}.

wine bei: ['=='] maachen: { :other wine <- ( selwer toString = other wine ).
}.



wine
	fall: ['cabernet'] maachen: { Ausgab schreiwen: ['it's a Cabernet!']. },
	fall: ['syrah']    maachen: { Ausgab schreiwen: ['it's a Syrah!'].    },
	fall: ['merlot']   maachen: { Ausgab schreiwen: ['it's a Merlot!'].   },
	fall: ['malbec']   maachen: { Ausgab schreiwen: ['it's a Malbec!'].   }.

Ausgab nei-zeil.
