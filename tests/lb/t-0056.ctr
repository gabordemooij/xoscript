>> z := Objet nei.
z bei: ['value:'] maachen: { :v
	eegen value := v. <- selwer.
}.
z bei: ['value'] maachen: { <- eegen value. }.
(z setValue: 1) value: 2.
Ausgab schreiwen: z value.
>> x := z.
Ausgab schreiwen: x value.
z := Näischt.
Ausgab schreiwen: z value.
Ausgab schreiwen: x value.
Ausgab schreiwen: ['hello'].
Ausgab schreiwen: 3 + 2.
Ausgab schreiwen: (3 > 2).
