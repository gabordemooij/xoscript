# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB nei host: ['localhost'],
	benotzernumm: ['xo'],
	passwuert: ['pass123'],
	datebanknumm: ['xobase'],
	verbannen.

>> sichparameter := db ufro: ['SELECT %% FROM'].
{ sichparameter ausféieren. } offänken: { :e
	Ausgab schreiwen: ( e enthält: ['%%'] ), nei-zeil.
}, starten.
