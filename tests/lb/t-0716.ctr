Ausgab schreiwen: ['Test object'], nei-zeil.
>> a := Objet nei. 

a bei: ['state:'] maachen: { :list
	eegen list := list. 
}.

a bei: ['state'] maachen: {
	Ausgab schreiwen: eegen list, nei-zeil.
}.

a state: ( Lëscht nei ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
Ausgab schreiwen: ['========== RELOADING SNAP:'], nei-zeil.
>> b := Objet load-from: ['/tmp/a.bin'].
b state.