Ausgab schreiwen: ['Test object'], nei-zeil.
>> l := Lëscht nei ; 1 ; ( Lëscht nei ; (Moment nei: 1) ; (Int64 aus-text: ['321']) ; (Lëscht nei ; 3)).
Ausgab schreiwen: l, nei-zeil.
>> old-lst-address := l prototyp späicheradress.
l save-as: ['/tmp/a.bin'].
Ausgab schreiwen: ['========== RELOADING SNAP:'], nei-zeil.
>> b := Objet load-from: ['/tmp/a.bin'].
(b prototyp späicheradress = old-lst-address) wouer: {
	Ausgab schreiwen: ['Object link re-attached.'], nei-zeil.
}.
Ausgab schreiwen: b, nei-zeil.
