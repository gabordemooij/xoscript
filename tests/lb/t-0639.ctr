
Server init.
Ausgab schreiwen: ['Database test'], nei-zeil.

>> db := Maria-DB nei host: ['localhost'],
	benotzernumm: ['xo'], 
	passwuert: ['pass123'],
	datebanknumm: ['xobase'],
	verbannen.

>> sichparameter :=
db ufro: ['SELECT REPEAT('Blah',1000) AS blah'], 
ofruffen: { :row 
	Ausgab schreiwen: row blah längt, nei-zeil.
}.
