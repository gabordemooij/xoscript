
>> shop := (Dictionnaire nei
	setzen: ['magazine'] bei: ['books'],
	setzen: ['computer'] bei: ['electronics'],
	setzen: ['lipstick'] bei: ['cosmetics']
).
Ausgab schreiwen: (shop huet: ['computer']), nei-zeil. 
Ausgab schreiwen: (shop huet: ['sausage']), nei-zeil. 
Ausgab schreiwen: (shop huet: ['computers']), nei-zeil. 
Ausgab schreiwen: (shop huet: ['compute']), nei-zeil. 
Ausgab schreiwen: (shop huet: ['2computer']), nei-zeil. 
