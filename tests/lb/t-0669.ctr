# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Tresor 
	passwuert-hash: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Tresor 
	passwuert-hash: hash iwwerpréiwen: a1.
	# fail 
>> b := Tresor
	passwuert-hash: hash iwwerpréiwen: a2.
	# ok!

Ausgab schreiwen: a, nei-zeil.
Ausgab schreiwen: b, nei-zeil.

