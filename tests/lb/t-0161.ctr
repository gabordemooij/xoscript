Programm späicherverwaltung: 0.
Lëscht bei: ['sum'] maachen: {
	>> total := 0.
	selwer all: { :index :element
		total dobäisetzen: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Fichier nei: ['/tmp/test.txt'].
f schreiwen: ['Lorem Ipsum'].
f zoumaachen.
  

f := Fichier nei: ['/tmp/test.txt'].
>> text := f liesen.
f zoumaachen.



Programm opraumen.
usedMemory1 := (Programm späicher ? 1).



f := Fichier nei: ['/tmp/test.txt'].
text := f liesen.
f zoumaachen.

Programm opraumen.
usedMemory2 := (Programm späicher ? 1).


f := Fichier nei: ['/tmp/test.txt'].
text := f liesen.
f zoumaachen.

Programm opraumen.
usedMemory3 := (Programm späicher ? 1).



( usedMemory1 = usedMemory2 an: usedMemory1 = usedMemory3, an: usedMemory2 = usedMemory3 ) wouer: {
	Ausgab schreiwen: ['No memory leaks here'].
}, falsch: {
	Ausgab schreiwen: ['Leaking memory...'].
}.
