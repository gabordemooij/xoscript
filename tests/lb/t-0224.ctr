
>> countries := Lëscht nei
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Lëscht nei
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods no: countries, all: { :key :value
	counter dobäisetzen: 1.
}.

Ausgab schreiwen: (['we serve counter dishes'] counter: counter), nei-zeil.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] zeechen sortéieren: { :v
	counter dobäisetzen: 0.
}.

Ausgab schreiwen: (['we sort counter dishes'] counter: counter), nei-zeil.


>> counter := 0.
{
	{
		counter dobäisetzen: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Ausgab schreiwen: (['we calculate counter numbers.'] counter: counter), nei-zeil.

