Ausgab schreiwen: ['Test object'], nei-zeil.
>> a := Objet nei. 
a bei: ['item:'] maachen: { :int64
	eegen int64 := int64. 
}.
a bei: ['item'] maachen: { <- eegen int64.
}.
a item: ( Int64 aus-text: ['9999'] ).
Ausgab schreiwen: a item, nei-zeil.
>> old-int64-address := a item prototyp späicheradress.
a save-as: ['/tmp/a.bin'].
Ausgab schreiwen: ['========== RELOADING SNAP:'], nei-zeil.
>> b := Objet load-from: ['/tmp/a.bin'].
(b item prototyp späicheradress = old-int64-address) wouer: {
	Ausgab schreiwen: ['Object link re-attached.'], nei-zeil.
}.
Ausgab schreiwen: ( b item ), nei-zeil.
