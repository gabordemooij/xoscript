Zuel bei: ['roman'] maachen: {
	>> zuel := selwer kopéieren.
	>> roman := [''].
	{
		{
			(zuel ≥ 1000) wouer: {
				roman drunhänken: ['Ⅿ'].
				zuel ofzéien: 1000.
			}, ofbriechen.
		
			(zuel ≥ 500) wouer: {
				roman drunhänken: ['Ⅾ'].
				zuel ofzéien: 500.
			}, ofbriechen.
		
			(zuel ≥ 100) wouer: {
				roman drunhänken: ['Ⅽ'].
				zuel ofzéien: 100.
			}, ofbriechen.
		
			(zuel ≥ 50) wouer: {
				roman drunhänken: ['Ⅼ'].
				zuel ofzéien: 50.
			}, ofbriechen.
		
			(zuel ≥ 50) wouer: {
				roman drunhänken: ['Ⅼ'].
				zuel ofzéien: 50.
			}, ofbriechen.
		
			(zuel ≥ 10) wouer: {
				roman drunhänken: ['Ⅹ'].
				zuel ofzéien: 10.
			}, ofbriechen.
			
			(zuel ≥ 9) wouer: {
				roman drunhänken: ['Ⅸ'].
				zuel ofzéien: 9.
			}, ofbriechen.
			
			(zuel ≥ 5) wouer: {
				roman drunhänken: ['Ⅴ'].
				zuel ofzéien: 5.
			}, ofbriechen.
			
			(zuel ≥ 4) wouer: {
				roman drunhänken: ['Ⅳ'].
				zuel ofzéien: 4.
			}, ofbriechen.
			
			(zuel ≥ 1) wouer: {
				roman drunhänken: ['Ⅰ'].
				zuel ofzéien: 1.
			}, ofbriechen.
		} prozedur.
	} soulaang: { <- zuel > 0. }. <- roman.
}.

Ausgab schreiwen: 1 roman, nei-zeil.
Ausgab schreiwen: 2 roman, nei-zeil.
Ausgab schreiwen: 4 roman, nei-zeil.
Ausgab schreiwen: 8 roman, nei-zeil.
Ausgab schreiwen: 16 roman, nei-zeil.
Ausgab schreiwen: 32 roman, nei-zeil.
Ausgab schreiwen: 64 roman, nei-zeil.
Ausgab schreiwen: 128 roman, nei-zeil.
Ausgab schreiwen: 256 roman, nei-zeil.
Ausgab schreiwen: 1024 roman, nei-zeil.
