
>> city := Lëscht ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Lëscht ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature no: city.
>> cities := weather entréen sortéieren: { :a :b <- (a vergläichen: b). }.
>> temperatures := weather wäerter sortéieren: { :a :b <- (a vergläichen: b) negativ?. }.

Ausgab schreiwen: (cities zesummesetzen: [',']), nei-zeil.
Ausgab schreiwen: (temperatures zesummesetzen: [',']), nei-zeil.
