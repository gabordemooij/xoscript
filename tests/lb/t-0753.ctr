Ausgab schreiwen: ['Test object'], nei-zeil.
>> a := Objet nei. 

a bei: ['item:'] maachen: { :fmt
	eegen fmt := fmt. 
}.

a bei: ['item'] maachen: { <- eegen fmt.
}.

a item: ( Format nei: ['|%s|'] ).

Ausgab schreiwen: a item, nei-zeil.

>> old-fmt-address := a item prototyp späicheradress.
a save-as: ['/tmp/a.bin'].
Ausgab schreiwen: ['========== RELOADING SNAP:'], nei-zeil.

>> b := Objet load-from: ['/tmp/a.bin'].

(b item prototyp späicheradress = old-fmt-address) wouer: {
	Ausgab schreiwen: ['Object link re-attached.'], nei-zeil.
}.

Ausgab schreiwen: ( b item uwenden: ['hello'] ), nei-zeil.
