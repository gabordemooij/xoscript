Ausgab schreiwen: ['Test object'], nei-zeil.
>> a := Objet nei. 
a bei: ['item:'] maachen: { :lst
	eegen lst := lst. 
}.
a bei: ['item'] maachen: { <- eegen lst.
}.
a item: (
	Lëscht nei ; 1 ; (
		Lëscht nei ; ['a'] ; (
			Lëscht nei ; ( Moment nei: 1 )
		) ; ( Int64 aus-text: ['321'] )
	)
).
Ausgab schreiwen: a item, nei-zeil.
>> old-lst-address := a item prototyp späicheradress.
a save-as: ['/tmp/a.bin'].
Ausgab schreiwen: ['========== RELOADING SNAP:'], nei-zeil.
>> b := Objet load-from: ['/tmp/a.bin'].
(b item prototyp späicheradress = old-lst-address) wouer: {
	Ausgab schreiwen: ['Object link re-attached.'], nei-zeil.
}.
Ausgab schreiwen: ( b item ), nei-zeil.
