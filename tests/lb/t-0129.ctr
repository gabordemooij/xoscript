
Lëscht bei: ['product'] maachen: {
	>> total := 1.
	selwer all: { :index :element
		total multiplizéieren-mat: element.
	}. <- total.
}.

>> a := Lëscht ← 1 ; 2 ; 3.
Ausgab schreiwen: a product, nei-zeil.
Ausgab schreiwen: (Lëscht ← 2 ; 4 ; 8) product, nei-zeil. 
Ausgab schreiwen: (Lëscht ← -2 ; 10) product, nei-zeil. 
Ausgab schreiwen: (Lëscht ← 0.5 ; -2) product, nei-zeil. 
