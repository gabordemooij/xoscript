

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm späicherverwaltung: 0.

>> txt := ['Word Salad'].
Ausgab schreiwen: ( txt kopéieren vun: 5 längt: 5 ).
Ausgab schreiwen: ( txt kopéieren verréckelung: 5, ofschneiden ), nei-zeil.

Programm opraumen.

usedMemory1 := (Programm späicher ? 0).


txt := ['Word Salad'].
Ausgab schreiwen: ( txt kopéieren vun: 5 längt: 5 ).
Ausgab schreiwen: ( txt kopéieren verréckelung: 5, ofschneiden ), nei-zeil.

Programm opraumen.
usedMemory2 := (Programm späicher ? 0).


txt := ['Word Salad'].
