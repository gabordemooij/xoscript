Text bei: ['html'] maachen: { <- (
		selwer
		ersetzen: ['&'] mat: ['&amp;'],
		ersetzen: ['<'] mat: ['&lt;'],
		ersetzen: ['>'] mat: ['&gt;'],
		ersetzen: ['''] mat: ['&apos;'],
		ersetzen: ['"'] mat: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm späicherverwaltung: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Ausgab schreiwen: txt kopéieren html, nei-zeil.
Ausgab schreiwen: txt kopéieren kleng-buschtawen, nei-zeil.
Ausgab schreiwen: txt kopéieren grouss-buschtawen, nei-zeil.
} starten.

Programm opraumen.

usedMemory1 := (Programm späicher ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Ausgab schreiwen: txt kopéieren html, nei-zeil.
Ausgab schreiwen: txt kopéieren kleng-buschtawen, nei-zeil.
Ausgab schreiwen: txt kopéieren grouss-buschtawen, nei-zeil.
} starten.

Programm opraumen.
usedMemory2 := (Programm späicher ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Ausgab schreiwen: txt kopéieren html, nei-zeil.
Ausgab schreiwen: txt kopéieren kleng-buschtawen, nei-zeil.
Ausgab schreiwen: txt kopéieren grouss-buschtawen, nei-zeil.
} starten.

Programm opraumen.
usedMemory3 := (Programm späicher ? 0).



( usedMemory1 = usedMemory2 an: usedMemory1 = usedMemory3, an: usedMemory2 = usedMemory3 ) wouer: {
	Ausgab schreiwen: ['No memory leaks here'].
}, falsch: {
	Ausgab schreiwen: ['Leaking memory...'].
}.
