
Server init.
>> rq := HTTP-Ufro nei.
Ausgab schreiwen: ['HTTP-GET d[]=']  + ( rq get-lëscht: ['d[]'] ), nei-zeil. # GET
Ausgab schreiwen: ['HTTP-GET f[]=']  + ( rq get-lëscht: ['f[]'] ), nei-zeil. # GET
Ausgab schreiwen: ['HTTP-POST e[]='] + ( rq post-lëscht: ['e[]'] ), nei-zeil. # GET
Ausgab schreiwen: ['HTTP-POST c=']   + ( rq post: ['c'] ), nei-zeil. # GET
Ausgab schreiwen: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), nei-zeil. # GET
