# test Program version

# this feature is disabled by default
Ausgab schreiwen: (
	Programm fonctioun: 
	['RECURSIVE_STRINTPOL']
), nei-zeil.


# but if we set the time back
>> today := Moment 
zone: ['CEST'],
aus: ['2026-02-15 10:00:00'].
Programm versioun: today.

# it will be enabled like it used to be (from now on)
Ausgab schreiwen: (
	Programm fonctioun: 
	['RECURSIVE_STRINTPOL']
), nei-zeil.