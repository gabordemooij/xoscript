Server init.

>> DB := Maria-DB new host: ['localhost'],
	username: ['xo'],
	password: ['pass123'],
	dbname: ['xobase'],
	connect.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB query: SQL.

# now you don't have to set DB
query2 fetch: { :row
	Out write: row world, stop.
}.
