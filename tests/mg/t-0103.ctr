>> a := Lisitra ← Zavatra ; Marina ; Diso ; Boleanina ; 1 ; Isa ; ['Str'] ; Soratra ; { ['Empty']. }.
Vokatra soraty: (a isan-javatra), andalana-vaovao.
{ :i
	Vokatra soraty: 
	['a '] + 
	((a ? i) karazana) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Tsinontsinona?) ity: [''] na-iry: ['NOT']) + 
	[' Nil.'],
	andalana-vaovao.
} × (a isan-javatra).
Vokatra soraty: ['but.. Nil is.. '] + ((Tsinontsinona Tsinontsinona?) ity: ['certainly NIL!'] na-iry: ['not NIL??']), andalana-vaovao.