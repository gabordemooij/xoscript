

# create a 64-bit integer for exact calculations
>> a := Int64 avy-amin-ny-soratra: ['123'].

# to string
Vokatra soraty: a, andalana-vaovao.

# divide
Vokatra soraty: a / (Int64 avy-amin-ny-soratra: ['3']), andalana-vaovao.

# multiply
Vokatra soraty: a * (Int64 avy-amin-ny-soratra: ['2']), andalana-vaovao.

# add
Vokatra soraty: a + (Int64 avy-amin-ny-soratra: ['1']), andalana-vaovao.

# subtract
Vokatra soraty: a - (Int64 avy-amin-ny-soratra: ['2']), andalana-vaovao.

# compare
Vokatra soraty: ( a =   (Int64 avy-amin-ny-soratra: ['123'])), andalana-vaovao.
Vokatra soraty: ( a !=: (Int64 avy-amin-ny-soratra: ['124'])), andalana-vaovao.
Vokatra soraty: ( a <   (Int64 avy-amin-ny-soratra: ['124'])), andalana-vaovao.
Vokatra soraty: ( a >   (Int64 avy-amin-ny-soratra: ['122'])), andalana-vaovao.
Vokatra soraty: ( a >=: (Int64 avy-amin-ny-soratra: ['123'])), andalana-vaovao.
Vokatra soraty: ( a <=: (Int64 avy-amin-ny-soratra: ['123'])), andalana-vaovao.





	