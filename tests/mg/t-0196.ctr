
>> animal := Zavatra vaovao. 
 
 animal rehefa: ['name:'] ataovy: { :n
azy anarana := n.
}. 


animal name: ['Diva']. 
 
animal rehefa: ['anarana'] ataovy: { <- anarana.
}.

>> cat := animal vaovao.
 
 cat name: ['Diva']. 
 
 cat rehefa: ['anarana'] ataovy: { <- ['your royal highness ']
+ (tena anarana).
}.

Vokatra soraty: cat anarana.
