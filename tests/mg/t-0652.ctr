# test number -> string -> number
{

	>> x := Isa eo: 0 ary: 1000000.
	>> d := Isa eo: 1 ary: 7.
	>> e := 10 fahefana: d.

	x zarao-amin: e.
	>> y := x soratra isa.

	(x = y) diso: {
		Vokatra soraty: x, andalana-vaovao.
		Vokatra soraty: y, andalana-vaovao.
		Fandaharana faranana.
	}.

} * 1000.
Vokatra soraty: ['OK'], andalana-vaovao.