
Lisitra rehefa: ['product'] ataovy: {
	>> total := 1.
	tena tsirairay: { :index :element
		total ampitomboy: element.
	}. <- total.
}.

>> a := Lisitra ← 1 ; 2 ; 3.
Vokatra soraty: a product, andalana-vaovao.
Vokatra soraty: (Lisitra ← 2 ; 4 ; 8) product, andalana-vaovao. 
Vokatra soraty: (Lisitra ← -2 ; 10) product, andalana-vaovao. 
Vokatra soraty: (Lisitra ← 0.5 ; -2) product, andalana-vaovao. 
