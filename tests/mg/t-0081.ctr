>> map1 := Rakibolana vaovao.
>> key1 := Lisitra vaovao.
>> key2 := Lisitra vaovao.

map1
	apetraho: ['hello'] eo: key1,
	apetraho: ['world'] eo: key2.


Vokatra
	soraty: ['Map #1 contains: '] + (map1 eo: key1),
	soraty: [' and '] + (map1 eo: key2), andalana-vaovao.

>> KeyeableArray := Lisitra vaovao.
KeyeableArray rehefa: ['toString'] ataovy: { <- (tena isan-javatra) toString.
}.

>> map2 := Rakibolana vaovao.
key1 := KeyeableArray vaovao.
key2 := KeyeableArray vaovao.

key1 ampio-any-amin-ny-farany: 1.

map2
	apetraho: ['hello'] eo: key1,
	apetraho: ['world'] eo: key2.

Vokatra
	soraty: ['Map #2 contains: '] + (map2 eo: key1),
	soraty: [' and '] + (map2 eo: key2), andalana-vaovao.
