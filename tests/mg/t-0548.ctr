Server init.

>> x := Blob vaovao: 65 karazana: ['char'].
# for this test you need set a path to libc (puts)
>> libname := Fandaharana fikirakirana: ['FFITESTLIB'].
Server ampifandraiso: (
 Lisitra vaovao ;
 libname ;
 ['putchar'] ;
 ( Lisitra vaovao ; ['char'] ) ;
 ['void'] ;
 ['Print'] ;
 ['char:']
).
Print char: (x manomboka: 0 halavany: 1), andalana-vaovao.
x afaho.

