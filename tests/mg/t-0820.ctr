# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Lamina vaovao: pattern.
	p fifanarahana: subject ataovy: { :m :g
		Vokatra soraty: g isan-javatra, soraty: [' '], soraty: (g atambaro: ['|']), andalana-vaovao. <- m.
	}.
}.
show ampiharo: ['(a)|(b)'] ary: ['b'].
show ampiharo: ['(a)|(b)'] ary: ['a'].
show ampiharo: ['(x)?y'] ary: ['y'].
show ampiharo: ['(x)?(y)(z)?'] ary: ['xy'].
