Vokatra soraty: ['Test object'], andalana-vaovao.
>> a := Zavatra vaovao. 
a rehefa: ['item:'] ataovy: { :int64
	azy int64 := int64. 
}.
a rehefa: ['item'] ataovy: { <- azy int64.
}.
a item: ( Int64 avy-amin-ny-soratra: ['9999'] ).
Vokatra soraty: a item, andalana-vaovao.
>> old-int64-address := a item modely-voalohany adiresy-fahatsiarovana.
a save-as: ['/tmp/a.bin'].
Vokatra soraty: ['========== RELOADING SNAP:'], andalana-vaovao.
>> b := Zavatra load-from: ['/tmp/a.bin'].
(b item modely-voalohany adiresy-fahatsiarovana = old-int64-address) marina: {
	Vokatra soraty: ['Object link re-attached.'], andalana-vaovao.
}.
Vokatra soraty: ( b item ), andalana-vaovao.
