# test qualifiers

>> $ := Zavatra vaovao.

$ rehefa: ['valio:'] ataovy: { :x
	
	>> operation := x litera: 0.
	>> valuta := x litera: 1.
	>> money := x dingano: 2.
	
	>> amount := 0.

	( operation = ['+'] ) marina: {
		( valuta = ['£'] ) marina: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Vokatra soraty: x, andalana-vaovao.


>> Fruit := Zavatra vaovao.

Fruit rehefa: ['vaovao'] ataovy: {
	>> f := tena vaovao.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit rehefa: ['apples:'] ataovy: { :a azy apples := a. }.
Fruit rehefa: ['oranges:'] ataovy: { :p azy oranges := p. }.
Fruit rehefa: ['apples'] ataovy: { <- azy apples. }.
Fruit rehefa: ['oranges'] ataovy: { <- azy oranges. }.

Fruit rehefa: ['+'] ataovy: { :f
	
	>> n := Fruit vaovao.
	f ampio: 1.
	
	n apples: (f apples + azy apples).
	n oranges:  (f oranges  + azy oranges). <- n.
}.

Fruit rehefa: ['soratra'] ataovy: { <- ( azy apples soratra + [' apples and '] + azy oranges + [' oranges'] ).
}.

Isa rehefa: ['apples'] ataovy: { <- ((Fruit vaovao) apples: tena).
}.

Isa rehefa: ['apple'] ataovy: { <- ((Fruit vaovao) apples: tena).
}.

Isa rehefa: ['oranges'] ataovy: { <- ((Fruit vaovao) oranges: tena).
}.




Vokatra soraty: (1 apple + 3 oranges + 4 apples), andalana-vaovao.


Soratra rehefa: ['twice'] ataovy: { <- ((tena soratra) + (tena soratra)).
}.



Vokatra soraty: ['❤❤❤'] twice.



