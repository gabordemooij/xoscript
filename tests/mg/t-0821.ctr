# a quote that never closes must give an error, not an endless loop
>> lalan-drakitra := ['/tmp/test0821.csv'].
>> file := Rakitra vaovao: lalan-drakitra.

file soraty: ['a,b\n"1,2\n'].
{
	file mpampisaraka: [','] farango-sosona: ['"'] andalana: { :line
		Vokatra soraty: line, andalana-vaovao.
	}.
} sambory: { :e Vokatra soraty: e, andalana-vaovao. }, atombohy.

# a closed quote still works
file soraty: ['a,b\n"1,2",3'].
file mpampisaraka: [','] farango-sosona: ['"'] andalana: { :line
	Vokatra soraty: line, andalana-vaovao.
}.
file fafao.
