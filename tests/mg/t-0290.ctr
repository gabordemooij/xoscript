# test list operations


>> cakes := Lisitra ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes soloy: 1 halavany: 2 amin: ( Lisitra ← ['cinnamon'] ; ['pineapple'] ).
Vokatra soraty: (buy atambaro: [',']), andalana-vaovao.


>> buy := cakes soloy: 1 halavany: 12 amin: ( Lisitra ← ['cinnamon'] ; ['pineapple'] ).
Vokatra soraty: (buy atambaro: [',']), andalana-vaovao.


>> buy := cakes soloy: 2 halavany: 10 amin: ( Lisitra vaovao ).
Vokatra soraty: (buy atambaro: [',']), andalana-vaovao.


>> buy := cakes soloy: 0 halavany: 1 amin: ( Lisitra vaovao ).
Vokatra soraty: (buy atambaro: [',']), andalana-vaovao.


>> buy := cakes soloy: ['0'] halavany: ['1'] amin: ['x'].
Vokatra soraty: (buy atambaro: [',']), andalana-vaovao.
