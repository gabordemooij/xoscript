# Can we use UTF8 in regex?
Server init.
>> p := Lamina vaovao: ['\\w'].
Vokatra soraty: ( p fifanarahana: ['x'] ), andalana-vaovao.
Vokatra soraty: ( p fifanarahana: ['é'] ), andalana-vaovao.
>> p := Lamina vaovao: ['(*UTF)(*UCP)\\w'].
Vokatra soraty: ( p fifanarahana: ['é'] ), andalana-vaovao.
# should give 101