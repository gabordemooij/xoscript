>> Greeter := Zavatra vaovao.
Greeter rehefa: ['make'] ataovy: {
	>> greeter := Zavatra vaovao.
	greeter rehefa: ['name:'] ataovy: { :anarana
		Vokatra soraty: ['setting a name'].
		azy myName := anarana.
	}.
	greeter rehefa: ['greet'] ataovy: {
		Vokatra soraty: ['Hello'].
		Vokatra soraty: azy myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
