Server init.
Vokatra soraty: ['Database date test'], andalana-vaovao.

>> db := Maria-DB vaovao mpampiantrano: ['localhost'],
	anaran-mpampiasa: ['xo'], 
	tenimiafina: ['pass123'],
	anaran-tahirin-kevitra: ['xobase'],
	mifandraisa.

>> masontsivana-fikarohana :=
db fanontaniana: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
alaivo: { :row
	Vokatra soraty: row datetest, andalana-vaovao.
}.
