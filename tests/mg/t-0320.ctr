


>> CoffeeMachine := Zavatra vaovao.
CoffeeMachine rehefa: ['order:'] ataovy: { :id
	>> coffee := ['Americano'].
	( id = 1 ) marina: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) marina: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) marina: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Zavatra vaovao.
SimpleCoffeeMachine rehefa: ['order'] ataovy: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Vokatra soraty: redCup, andalana-vaovao.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Vokatra soraty: greenCup, andalana-vaovao.
>> yellowCup := CoffeeMachine order: 1.
Vokatra soraty: yellowCup, andalana-vaovao.
>> blueCup := CoffeeMachine order: 0.
Vokatra soraty: blueCup, andalana-vaovao.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Vokatra soraty: blackCup, andalana-vaovao.
blackCup ampio-any-amin-ny-farany: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Vokatra soraty: orangeCup, andalana-vaovao.
