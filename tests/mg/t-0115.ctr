{
	ity-asa-ity fahadisoana: ['Dont fail.'].
	unknown doSomething.
} sambory: {
	Vokatra soraty: ['Caught!'].
}, atombohy.

{
	ity-asa-ity fahadisoana: ['Dont fail.'].
	azy unknown doSomething.
} sambory: {
	Vokatra soraty: ['Caught!'].
}, atombohy.

{
	ity-asa-ity fahadisoana: ['Dont fail.'].
	unknown := 122.
} sambory: {
	Vokatra soraty: ['Caught!'].
}, atombohy.


{
	ity-asa-ity fahadisoana: ['Dont fail.'].
	Marina atsaharo.
	Vokatra soraty: ['FAIL'].
} sambory: {
	Vokatra soraty: ['Caught!'].
}, atombohy.

{
	{
		ity-asa-ity fahadisoana: ['Dont fail.'].
		Marina atsaharo.
		Vokatra soraty: ['FAIL'].
	} sambory: { :x
		(x = ['Dont fail.']) marina: { ity-asa-ity fahadisoana: ['Nested Caught!']. }.
	}, atombohy.
} sambory: { :e
	Vokatra soraty: e.
}, atombohy.
