Vokatra soraty: ['Continue for-loop, No - before 6 and up.'], andalana-vaovao.
{ :i
	Vokatra soraty: (i + 1), andalana-vaovao.
	((i + 1) > 4) tohizo.
	Vokatra soraty: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Vokatra andalana-vaovao.
Vokatra soraty: ['Continue while-true, No --> before 5 and up.'], andalana-vaovao.
{
	Vokatra soraty: ['iteration #'] + x, andalana-vaovao.
	x ampio: 1.
	((x < 5) tsy) tohizo.
	Vokatra soraty: ['-->'].
} raha-mbola: xIsLessThan10.
Vokatra andalana-vaovao.
Vokatra soraty: ['Continue while-false, No - before 3 only.'], andalana-vaovao.
{
	Vokatra soraty: ['iteration #'] + x, andalana-vaovao.
	x analao: 1.
	(x = 3) tohizo.
	Vokatra soraty: ['-'].
} raha-mbola: { <- ( x > 0). }.

Vokatra andalana-vaovao.
Vokatra soraty: ['Continue times-loop, No ||| before 3.'], andalana-vaovao.
{ :i
	Vokatra soraty: ['iteration #'] + i, andalana-vaovao.
	(i = 2) tohizo.
	Vokatra soraty: ['|||'].
} × 5.

Vokatra andalana-vaovao.

{ Marina tohizo. Vokatra soraty: ['dont write this!'], andalana-vaovao. } atombohy.

{ Marina tohizo. Vokatra soraty: ['dont write this!'], andalana-vaovao. } sambory: { Vokatra soraty: ['Dont catch this!']. }, atombohy.

Vokatra soraty: ['Test Array each-loop: 0, ... ,2'], andalana-vaovao.
(Lisitra ← 1 ; 2 ; 3) ovay-tsirairay: { :i
	(i = 1) tohizo.
	Vokatra soraty: ['iteration #'] + (i - 0), andalana-vaovao.
}.

Vokatra soraty: ['Test Map each-loop: c only'], andalana-vaovao.
>> m := Rakibolana vaovao.
m apetraho: ['first'] eo: ['a'], apetraho: ['second'] eo: ['b'], apetraho: ['third'] eo: ['c'].
m tsirairay: { :k :v
	(k ≠ ['c']) tohizo.
	Vokatra soraty: ['iteration'] + k + v, andalana-vaovao.
}.

