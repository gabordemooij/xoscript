
>> Animal := Zavatra vaovao.
Animal rehefa: ['vaovao'] ataovy: { <- tena vaovao init.
}.

Animal rehefa: ['init'] ataovy: {
	azy sound := ['?'].
	azy legs := 4.
}.

>> Dog := Animal vaovao.
Dog rehefa: ['init'] ataovy: {
	tena init.
	azy sound := ['barks'].
}.

Animal rehefa: ['soratra'] ataovy: { <- azy legs soratra + azy sound.
}.

>> poodle := Dog vaovao.
Vokatra soraty: poodle, andalana-vaovao.

