#OBSD
>> dirname := [''].
{ dirname ampio-any-amin-ny-farany: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Fandaharana rafitra: command.
Fandaharana chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename ampio-any-amin-ny-farany: ['YYYYYYYY']. } * 20.
Rakitra vaovao: filename, soraty: ['sometext'].
{ Rakitra lisitra: ['/tmp/'] + dirname. } * 1000.
Vokatra soraty: ['no crash'], andalana-vaovao.

