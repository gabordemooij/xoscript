# catch-all test (practical)
>> HTML := Soratra vaovao.
HTML rehefa: ['encode:'] ataovy: { :tekst
	tena ampio-any-amin-ny-farany: (tekst
	soloy: ['&'] amin: ['&amp;'], 
	soloy: ['<'] amin: ['&lt;'],
	soloy: ['>'] amin: ['&gt;'],
	soloy: ['"'] amin: ['&quot;']).
}.
>> blog := HTML vaovao.
blog ampio-any-amin-ny-farany: ['<h1>'],
     encode: ['Koffie & Thee'],
     ampio-any-amin-ny-farany: ['</h1>'].
Vokatra soraty: blog, andalana-vaovao.


>> Roman := Isa vaovao.
Roman rehefa: ['stringy'] ataovy: {
	>> a := [''].
	{ a ampio-any-amin-ny-farany: ['I']. } × tena. <- a.
}.

>> x := Roman vaovao.
x ampio: 3.
Vokatra soraty: x stringy, andalana-vaovao.

>> Quantum := Boleanina vaovao.
Quantum rehefa: ['true?'] ataovy: { <- ['maybe True']. }.
Vokatra soraty: (Quantum vaovao true?), andalana-vaovao.

>> Nihil := Tsinontsinona vaovao.
Nihil rehefa: ['soratra'] ataovy: { <- ['Nihil']. }.
Vokatra soraty: (Nihil vaovao), andalana-vaovao.
