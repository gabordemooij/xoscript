>> numbers := ['1,2,3'] zarao: [','].
Vokatra soraty: ['I got: '] + numbers isan-javatra + [' numbers.'],andalana-vaovao.
{ :i Vokatra soraty: ['number #'] + i + [':'] + (numbers toerana: i), andalana-vaovao.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages zarao: [' Or '].
Vokatra soraty: ['We serve'], andalana-vaovao.
{ :i Vokatra soraty: ['->'] + (beverages toerana: i), andalana-vaovao. } × (beverages isan-javatra).
Vokatra soraty: (beverages atambaro: [',']), andalana-vaovao.
Vokatra soraty: (numbers atambaro: ['||']).
