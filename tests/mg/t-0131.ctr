
>> a := Lisitra ← (Lisitra ← 100 ; 200 ; 300) ; (Lisitra ← 9 ; 8 ; 7).
Vokatra soraty: ['at 0,1 :'].
Vokatra soraty: a ? 0 ? 1, andalana-vaovao. 
Vokatra soraty: ['at 1,2 :'].
Vokatra soraty: a ? 1 ? 2, andalana-vaovao. 
>> menu := Rakibolana vaovao.
menu apetraho: (Lisitra ← ['pizza'] ; ['spaghetti']) eo: ['Italian Cuisine'].
menu apetraho: (Lisitra ← ['bifteki'] ; ['suflaki']) eo: ['Greek Cuisine'].
Vokatra soraty: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), andalana-vaovao. 
Vokatra soraty: ['but not on the same plate.'], andalana-vaovao.
