>> repeater := Zavatra vaovao.
repeater rehefa: ['valio:'] ataovy: { :what
	Vokatra soraty: what + [' '].
}.
repeater rehefa: ['valio:ary:'] ataovy: { :what :say
	Vokatra soraty: what, soraty: say + [' '].
}.
repeater rehefa: ['valio:ary:ary:'] ataovy: { :what :say :more
	Vokatra soraty: what, soraty: say, soraty: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
