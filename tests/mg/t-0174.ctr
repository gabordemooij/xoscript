{
palette := Rakibolana vaovao.
palette 
	apetraho: ['#F00'] eo: ['red'],
	apetraho: ['#0F0'] eo: ['green'],
	apetraho: ['#00F'] eo: ['blue'].
Vokatra soraty: ['number of RGB codes in palette: '] + ( palette isan-javatra ), andalana-vaovao.
Vokatra soraty: ['RGB code of green is: '] + ( palette ? ['green'] ), andalana-vaovao.
colors := [''].
( palette tsirairay: { :anarana :kaody
		colors := colors + ( anarana + [':'] + kaody ).
} ).
Vokatra soraty: ['All colors in palette: '] + colors, andalana-vaovao.
} atombohy.
Fandaharana diovy.
usedMemory1 := (Fandaharana fahatsiarovana ? 0).

