
Isa ianaro: ['plus:'] midika: ['+'].
Isa rehefa: ['+'] ataovy: { :x
	>> rate := 1.
	>> currency := x venty-isa.
	(currency = ['euros']) marina: {
		rate := 2.
	}. <- (tena plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars venty: ['dollars'].
euros venty: ['euros'].
>> money := dollars + euros.
Vokatra soraty: money, andalana-vaovao.
