# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB vaovao mpampiantrano: ['localhost'],
	anaran-mpampiasa: ['xo'],
	tenimiafina: ['pass123'],
	anaran-tahirin-kevitra: ['xobase'],
	mifandraisa.

>> masontsivana-fikarohana := db fanontaniana: ['SELECT %% FROM'].
{ masontsivana-fikarohana tanteraho. } sambory: { :e
	Vokatra soraty: ( e misy: ['%%'] ), andalana-vaovao.
}, atombohy.
