Server init.
Vokatra soraty: ['Database datetime test'], andalana-vaovao.

>> db := Maria-DB vaovao mpampiantrano: ['localhost'],
	anaran-mpampiasa: ['xo'], 
	tenimiafina: ['pass123'],
	anaran-tahirin-kevitra: ['xobase'],
	mifandraisa.

>> masontsivana-fikarohana :=
db fanontaniana: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
alaivo: { :row
	Vokatra soraty: row datetimetest, andalana-vaovao.
}.
