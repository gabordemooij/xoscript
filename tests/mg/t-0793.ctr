Server init.

>> DB := Maria-DB vaovao mpampiantrano: ['localhost'],
	anaran-mpampiasa: ['xo'],
	tenimiafina: ['pass123'],
	anaran-tahirin-kevitra: ['xobase'],
	mifandraisa.

{
	DB fanontaniana:
	['DROP TABLE movies'],
	tanteraho.
} sambory: { Tsinontsinona. }, atombohy.

DB fanontaniana:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
tanteraho.

DB fanontaniana: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
masontsivana: ( Lisitra vaovao ; ['Halloween'] ),
tanteraho.

DB fanontaniana: ['SELECT * FROM movies'],
alaivo: { :movie
	Vokatra soraty: movie title, andalana-vaovao.
}.

