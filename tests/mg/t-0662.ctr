>> t := Tsinontsinona.

# you can control the time zone for
# parsing like this:
Fotoana faritr-ora: ['CET'].
t := Fotoana loharano: ['1981-02-03 04:05:06'].
Vokatra soraty: t, andalana-vaovao.

# now using CEST time zone:
Fotoana faritr-ora: ['CEST'].
t := Fotoana loharano: ['1981-02-03 04:05:06'].
Vokatra soraty: t, andalana-vaovao.

# error if string cannot be parsed
{ Fotoana loharano: ['1900']. } sambory: { Tsinontsinona. }, atombohy.
