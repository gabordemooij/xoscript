Server init.
>> a := Blob vaovao: 4.
a bytes: ( Lisitra vaovao ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob vaovao: 4.
b bytes: ( Lisitra vaovao ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a ^ b.
{
	a ^ ( Rakitra vaovao: ['noblob???'] ).
} sambory: { :e Vokatra soraty: e, andalana-vaovao. }, atombohy.
a afaho.
b afaho.
