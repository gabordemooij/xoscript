#Linux
>> OS := Fandaharana fikirakirana: ['OS'].

>> clock := Fotoana vaovao.
	
(OS = ['Haiku']) marina: {
	clock faritr-ora: ['CET'],
	taona: 2017, volana: 7, andro: 13,
	ora: 18, minitra: 0, segondra: 0.
}, raha-tsy-izany: {
	clock faritr-ora: ['Europe/Amsterdam'],
	taona: 2017, volana: 7, andro: 13,
	ora: 18, minitra: 0, segondra: 0.
}.

clock rehefa: ['tell'] ataovy: {
	Vokatra soraty: tena, andalana-vaovao.
}.


clock ampio: 2    ora, tell.
clock ampio: 1    ora, tell.
clock ampio: 19 minitra, tell.
clock ampio: 1  minitra, tell.
clock ampio: 1  minitra, tell.
clock ampio: 19 segondra, tell.
clock ampio: 1  segondra, tell.
clock ampio: 1  segondra, tell.
clock ampio: 2    taona, tell.
clock ampio: 1    taona, tell.

(OS = ['Haiku']) marina: {
clock ampio: 5   volana.
clock faritr-ora: ['CEST'], tell.
}, raha-tsy-izany: {
	clock ampio: 5   volana, tell.
}.

clock ampio: 1   volana, tell.
