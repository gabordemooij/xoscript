Isa rehefa: ['roman'] ataovy: {
	>> isa := tena adikao.
	>> roman := [''].
	{
		{
			(isa ≥ 1000) marina: {
				roman ampio-any-amin-ny-farany: ['Ⅿ'].
				isa analao: 1000.
			}, atsaharo.
		
			(isa ≥ 500) marina: {
				roman ampio-any-amin-ny-farany: ['Ⅾ'].
				isa analao: 500.
			}, atsaharo.
		
			(isa ≥ 100) marina: {
				roman ampio-any-amin-ny-farany: ['Ⅽ'].
				isa analao: 100.
			}, atsaharo.
		
			(isa ≥ 50) marina: {
				roman ampio-any-amin-ny-farany: ['Ⅼ'].
				isa analao: 50.
			}, atsaharo.
		
			(isa ≥ 50) marina: {
				roman ampio-any-amin-ny-farany: ['Ⅼ'].
				isa analao: 50.
			}, atsaharo.
		
			(isa ≥ 10) marina: {
				roman ampio-any-amin-ny-farany: ['Ⅹ'].
				isa analao: 10.
			}, atsaharo.
			
			(isa ≥ 9) marina: {
				roman ampio-any-amin-ny-farany: ['Ⅸ'].
				isa analao: 9.
			}, atsaharo.
			
			(isa ≥ 5) marina: {
				roman ampio-any-amin-ny-farany: ['Ⅴ'].
				isa analao: 5.
			}, atsaharo.
			
			(isa ≥ 4) marina: {
				roman ampio-any-amin-ny-farany: ['Ⅳ'].
				isa analao: 4.
			}, atsaharo.
			
			(isa ≥ 1) marina: {
				roman ampio-any-amin-ny-farany: ['Ⅰ'].
				isa analao: 1.
			}, atsaharo.
		} fomba-fiasa.
	} raha-mbola: { <- isa > 0. }. <- roman.
}.

Vokatra soraty: 1 roman, andalana-vaovao.
Vokatra soraty: 2 roman, andalana-vaovao.
Vokatra soraty: 4 roman, andalana-vaovao.
Vokatra soraty: 8 roman, andalana-vaovao.
Vokatra soraty: 16 roman, andalana-vaovao.
Vokatra soraty: 32 roman, andalana-vaovao.
Vokatra soraty: 64 roman, andalana-vaovao.
Vokatra soraty: 128 roman, andalana-vaovao.
Vokatra soraty: 256 roman, andalana-vaovao.
Vokatra soraty: 1024 roman, andalana-vaovao.
