Boleanina rehefa: ['xor:'] ataovy: { :a :b <- ((a ary: b tsy) na: (a tsy ary: b)).
}.

>> o := Zavatra vaovao.
o rehefa: ['hello'] ataovy: { ['Empty']. }.
{ o rehefa: 2 ataovy: 3.} sambory: { :e Vokatra soraty: e, andalana-vaovao. }, atombohy.
{ o rehefa: ['fitsapana'] ataovy: 3.} sambory: { :e Vokatra soraty: e, andalana-vaovao. }, atombohy.
{ o rehefa: ['hello'] ataovy: { ['Empty']. }.} sambory: { :e Vokatra soraty: e, andalana-vaovao. }, atombohy. 
{ >> z := 4 ÷ 0. } sambory: { :e Vokatra soraty: e, andalana-vaovao. }, atombohy. 
{ (Marina ary: Tsinontsinona) marina: { Vokatra soraty: ['X'].}. } sambory: { :e Vokatra soraty: e, andalana-vaovao. }, atombohy. 
{ ([''] xor: 0) marina: { Vokatra soraty: ['X'].}. } sambory: { :e Vokatra soraty: e, andalana-vaovao. }, atombohy. 
{ (1 < ['2']) marina: { Vokatra soraty: ['OK']. }. } sambory: { :e Vokatra soraty: e, andalana-vaovao. }, atombohy. 
{ (1 < ['2.0']) marina: { Vokatra soraty: ['OK']. }. } sambory: { :e Vokatra soraty: e, andalana-vaovao. }, atombohy. 
{ (1 < ['x2.0']) marina: { Vokatra soraty: ['NO!']. }. } sambory: { :e Vokatra soraty: e, andalana-vaovao. }, atombohy. 
{ Vokatra soraty: (['hello OK there'] manomboka: ['6'] halavany: ['2']). } atombohy. 
