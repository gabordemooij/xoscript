>> randomizer := { :a :b
	>> kely-indrindra := ( a < b ) ity: a na-iry: b.
	>> lehibe-indrindra := ( a > b ) ity: a na-iry: b.
	>> x := Tsinontsinona.
	{
		x := Isa eo: a ary: b.
		((x < kely-indrindra) na: (x > lehibe-indrindra)) marina: { 
			Vokatra soraty: (['Invalid value!']).
			Fandaharana faranana.
		}.
	} 
	× 100. <- x.
}.
randomizer ampiharo: 0 ary: 0.
randomizer ampiharo: 1 ary: 0.
