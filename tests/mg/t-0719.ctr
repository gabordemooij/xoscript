Server init.
>> fmt := Endrika vaovao: ['%#3x'].

>> blob := Blob vaovao: 4.
blob bytes: ( 
	Lisitra vaovao ; 0 ; 1 ; 2 ; 3
).

>> file := Rakitra vaovao: ['/tmp/blob'].
file blob: blob.
blob afaho.

>> vakio := file blob.
vakio 
manomboka: 0 
halavany: 4, 
ataovy tsirairay: { :i :b 
	Vokatra
	soraty: (fmt ampiharo-isa-feno: b),
	andalana-vaovao.
}.
vakio afaho.
