>> Greeter := Zavatra vaovao.
Greeter rehefa: ['make'] ataovy: {
	>> gr := Zavatra vaovao.
	gr rehefa: ['setName:'] ataovy: { :aname
		azy anarana := aname.
	}.
	gr rehefa: ['greet'] ataovy: {
		Vokatra soraty: azy anarana.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a vaovao.
c setName: ['THREE'].
c greet.
>> d := a vaovao.
d setName: ['FOUR'].
d greet.
c greet.
