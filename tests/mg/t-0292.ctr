>> winery := { <- (	Rakibolana vaovao
		apetraho: 2 eo: ['merlot'],
		apetraho: 3 eo: ['malbec'],
		apetraho: 4 eo: ['syrah']
	).
}.

Vokatra soraty: (((winery atombohy) - ['nothing']) isan-javatra), andalana-vaovao.
Vokatra soraty: (((winery atombohy) - ['merlot']) isan-javatra), andalana-vaovao.
Vokatra soraty: (((winery atombohy) - ['malbec']) isan-javatra), andalana-vaovao.
Vokatra soraty: (((winery atombohy) - ['syrah']) isan-javatra), andalana-vaovao.
Vokatra soraty: (((winery atombohy) - ['merlot'] - ['malbec']) isan-javatra), andalana-vaovao.
Vokatra soraty: (((winery atombohy) - ['merlot'] - ['syrah']) isan-javatra), andalana-vaovao.
Vokatra soraty: (((winery atombohy) - ['malbec'] -['syrah']) isan-javatra), andalana-vaovao.
Vokatra soraty: (((winery atombohy) - ['malbec'] - ['syrah'] - ['merlot']) isan-javatra), andalana-vaovao.

