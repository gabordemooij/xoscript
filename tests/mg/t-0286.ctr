['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Vokatra soraty: (x + y), andalana-vaovao.

>> x := 10040.07.
>> y := 10305.60.

Vokatra soraty: (x + y), andalana-vaovao.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Vokatra soraty: (x + y + z), andalana-vaovao.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Vokatra soraty: (x + y + z), andalana-vaovao.

>> q := 0.1.2.

Vokatra soraty: (q), andalana-vaovao.

>> q := 012.

Vokatra soraty: (q), andalana-vaovao.
