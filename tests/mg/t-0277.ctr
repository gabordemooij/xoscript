

>> Cat := Zavatra vaovao.

Cat rehefa: ['vaovao'] ataovy: {
	azy sound := ['meow!'].
}.

Cat rehefa: ['nieuw'] ataovy: {
	azy sound := ['meow!'].
}.

Cat rehefa: ['makeSound'] ataovy: { <- azy sound.
}.

Cat rehefa: ['greet'] ataovy: { <- tena makeSound.
}.

>> cat := Cat vaovao.
Vokatra soraty: cat greet.
