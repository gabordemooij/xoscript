Vokatra soraty: ['Test object'], andalana-vaovao.
>> a := Zavatra vaovao. 

a rehefa: ['item:'] ataovy: { :nil
	azy nil := nil. 
}.

a rehefa: ['item'] ataovy: { <- azy nil.
}.

a item: Tsinontsinona.

Vokatra soraty: a item, andalana-vaovao.

>> old-nil-address := a item modely-voalohany adiresy-fahatsiarovana.
a save-as: ['/tmp/a.bin'].
Vokatra soraty: ['========== RELOADING SNAP:'], andalana-vaovao.

>> b := Zavatra load-from: ['/tmp/a.bin'].

(b item modely-voalohany adiresy-fahatsiarovana = old-nil-address) marina: {
	Vokatra soraty: ['Object link re-attached.'], andalana-vaovao.
}.

Vokatra soraty: b item, andalana-vaovao.
