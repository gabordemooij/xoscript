Server init.
Vokatra soraty: ['Database time test'], andalana-vaovao.

>> db := Maria-DB vaovao mpampiantrano: ['localhost'],
	anaran-mpampiasa: ['xo'], 
	tenimiafina: ['pass123'],
	anaran-tahirin-kevitra: ['xobase'],
	mifandraisa.

>> masontsivana-fikarohana :=
db fanontaniana: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
alaivo: { :row
	Vokatra soraty: row timetest, andalana-vaovao.
}.
