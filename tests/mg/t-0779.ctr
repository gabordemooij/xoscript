Vokatra soraty: ['Test object'], andalana-vaovao.
>> p := Lalana /tmp.
Vokatra soraty: p, andalana-vaovao.
>> old-p-address := p modely-voalohany adiresy-fahatsiarovana.
p save-as: ['/tmp/a.bin'].
Vokatra soraty: ['========== RELOADING SNAP:'], andalana-vaovao.
>> b := Zavatra load-from: ['/tmp/a.bin'].
(b modely-voalohany adiresy-fahatsiarovana = old-p-address) marina: {
	Vokatra soraty: ['Object link re-attached.'], andalana-vaovao.
}.
Vokatra soraty: b, andalana-vaovao.
