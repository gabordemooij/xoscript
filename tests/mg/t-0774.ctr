Vokatra soraty: ['Test object'], andalana-vaovao.
>> a := Zavatra vaovao. 
a rehefa: ['item:'] ataovy: { :lst
	azy lst := lst. 
}.
a rehefa: ['item'] ataovy: { <- azy lst.
}.
a item: (
	Lisitra vaovao ; 1 ; (
		Lisitra vaovao ; ['a'] ; (
			Lisitra vaovao ; ( Fotoana vaovao: 1 )
		) ; ( Int64 avy-amin-ny-soratra: ['321'] )
	)
).
Vokatra soraty: a item, andalana-vaovao.
>> old-lst-address := a item modely-voalohany adiresy-fahatsiarovana.
a save-as: ['/tmp/a.bin'].
Vokatra soraty: ['========== RELOADING SNAP:'], andalana-vaovao.
>> b := Zavatra load-from: ['/tmp/a.bin'].
(b item modely-voalohany adiresy-fahatsiarovana = old-lst-address) marina: {
	Vokatra soraty: ['Object link re-attached.'], andalana-vaovao.
}.
Vokatra soraty: ( b item ), andalana-vaovao.
