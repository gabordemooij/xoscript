



>> CoffeeGrounds := Zavatra vaovao.
CoffeeGrounds rehefa: ['extract'] ataovy: { <- ['coffee']. }.

>> CoffeeMachine := Zavatra vaovao.
CoffeeMachine rehefa: ['init'] ataovy: {
	azy coffeegrounds := CoffeeGrounds vaovao.
}.
CoffeeMachine rehefa: ['vaovao'] ataovy: { <- CoffeeMachine `new init.
}.

CoffeeMachine rehefa: ['makeTea'] ataovy: { <- (azy tealeaves extract). }.
CoffeeMachine rehefa: ['makeCoffee'] ataovy: { <- (azy coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine vaovao.

Vokatra soraty:
	coffeeDream 
	makeCoffee.

Vokatra soraty:
	coffeeDream 
	makeTea.
