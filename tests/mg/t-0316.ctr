>> Grandfather := Zavatra vaovao.
Grandfather rehefa: ['greet'] ataovy: {
	Vokatra soraty: ['Ave!'], andalana-vaovao.
}.
>> Father := Grandfather vaovao.
Father rehefa: ['greet'] ataovy: {
	Vokatra soraty: ['Hello'], andalana-vaovao.
	tena greet.
}.
>> Son := Father vaovao.
Son rehefa: ['greet'] ataovy: {
	Vokatra soraty: ['Hi'], andalana-vaovao.
	tena greet.
}.

Son greet.

>> Roundabout := Zavatra vaovao.
Roundabout rehefa: ['circle:'] ataovy: { :x
	Vokatra soraty: x, andalana-vaovao.
	(x < 3) marina: { tena miantso-tena circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) marina: { Vokatra soraty: x, andalana-vaovao. x ampio: 1.  increment atombohy. }. }.
increment atombohy.