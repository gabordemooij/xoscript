Soratra rehefa: ['evaluate'] ataovy: {
	>> kaody := Rakitra vaovao: ['/tmp/eval.ctr'].
	kaody soraty: (tena soratra + ['.']).
	Fandaharana ampiasao: ['/tmp/eval.ctr'].
}.

>> a := Lisitra ← 1 ; 2 ; 3.
>> b := (a soratra).

Vokatra soraty: b, andalana-vaovao. 
(['b := '] + b) evaluate.

Vokatra soraty: b ? 2, andalana-vaovao. 

Vokatra soraty: (( Lisitra ← 1 ; 2 ; 3 )), andalana-vaovao. 

Vokatra soraty: ((Rakibolana vaovao) apetraho: 1 eo: 2), andalana-vaovao. 

>> x := ( (Lisitra ← 1 ; ( Lisitra ← 9 ) ; Marina ) ) soratra.
Vokatra soraty: x, andalana-vaovao. 
(['x := '] + x) evaluate.

Vokatra soraty: x ? 1 ? 0, andalana-vaovao. 

>> y := (Rakibolana vaovao) apetraho: (Lisitra ← 1) eo: (Lisitra ← 2).
Vokatra soraty: y, andalana-vaovao. 

(['y := '] + y) soratra evaluate.

Vokatra soraty: (y eo: (Lisitra ← 2) soratra ), andalana-vaovao.

Vokatra soraty: (Lisitra vaovao), andalana-vaovao. 
Vokatra soraty: (Rakibolana vaovao), andalana-vaovao. 
