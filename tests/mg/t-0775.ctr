Vokatra soraty: ['Test object'], andalana-vaovao.
>> l := Lisitra vaovao ; 1 ; ( Lisitra vaovao ; (Fotoana vaovao: 1) ; (Int64 avy-amin-ny-soratra: ['321']) ; (Lisitra vaovao ; 3)).
Vokatra soraty: l, andalana-vaovao.
>> old-lst-address := l modely-voalohany adiresy-fahatsiarovana.
l save-as: ['/tmp/a.bin'].
Vokatra soraty: ['========== RELOADING SNAP:'], andalana-vaovao.
>> b := Zavatra load-from: ['/tmp/a.bin'].
(b modely-voalohany adiresy-fahatsiarovana = old-lst-address) marina: {
	Vokatra soraty: ['Object link re-attached.'], andalana-vaovao.
}.
Vokatra soraty: b, andalana-vaovao.
