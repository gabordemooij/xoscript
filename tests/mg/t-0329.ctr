Vokatra soraty: ((Lisitra vaovao
	rehefa: ['plaque:'] ataovy: { :x azy o := x. },
	rehefa: ['plaque']  ataovy: { <- azy o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Lisitra ← 1)
	~ (Lisitra ← 1 ; 2)
	~ (Lisitra ← 1 ; 2 ; 3)
	~ (Lisitra ← 1 ; 2 ; 3 ; 4)
	~ (Lisitra ← 1 ; 2 ; 3 ; 4 ; 5)
) tsirairay: { :i :el
	{ Vokatra soraty: ity-asa-ity. } × el isan-javatra.
	Vokatra andalana-vaovao.
}) plaque, andalana-vaovao.


