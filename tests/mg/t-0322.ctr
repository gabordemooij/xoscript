

>> Matryoshka := Zavatra vaovao.
Matryoshka rehefa: ['double:'] ataovy: { :secret
	azy secret := secret × 2.
}.
Matryoshka rehefa: ['vaovao:'] ataovy: { :secret
	>> answer := Tsinontsinona.
	>> t := (secret > 255).
	Vokatra soraty: (secret + [' | '] + t), andalana-vaovao.
	t marina: {
		answer := secret.
	}, raha-tsy-izany: {
		answer := Matryoshka miantso-tena vaovao: (tena double: secret).
	}. <- answer.
}.

>> x := Matryoshka vaovao: 2.
