

>> g := Server vaovao.
>> v := Vata-fiarovana vaovao.
>> ok := 0.

>> secrets := Lisitra vaovao ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> passwords := secrets adikao.
passwords tsirairay: { :i :p
	secrets tsirairay: { :n :s
		{
			>> encrypted := v afeno: s fanalahidy: p.
			>> decrypted := v avoahy: encrypted fanalahidy: p.
			(decrypted = s) marina: {
				ok ampio: 1.
			}, raha-tsy-izany: {
				Vokatra soraty: ['failed encrypting/decrypting: '], andalana-vaovao.
				Vokatra soraty: s, andalana-vaovao.
				Vokatra soraty: ['encrypted: '] + encrypted, andalana-vaovao.
				Vokatra soraty: ['decrypted: '] + encrypted, andalana-vaovao.
				Fandaharana faranana.
			}.
		} sambory: { :err
			(s = [''] na: p = ['']) marina: {
				ok ampio: 1.
			}, raha-tsy-izany: {
				Vokatra soraty: err, andalana-vaovao.
				Fandaharana faranana.
			}.
		}, atombohy.
	}.
}.

Vokatra soraty: ( ok + [' vault encryptions tested.'] ), andalana-vaovao.