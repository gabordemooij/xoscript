# vault keys and signatures that decode too long must not overflow the stack
Server init.

>> keys := Vata-fiarovana mamorona-fanalahidy.
>> sk := keys voalohany.
>> pk := keys farany.
>> sig := Vata-fiarovana soniavo: ['abc'] amin: sk.

# 88 characters without padding decode to 66 bytes
>> long := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 characters without padding decode to 33 bytes
>> short := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Vata-fiarovana soniavo: ['abc'] amin: long. } sambory: { :e
	Vokatra soraty: e, andalana-vaovao.
}, atombohy.

{ Vata-fiarovana jereo: ['abc'] sonia: long amin: pk. } sambory: { :e
	Vokatra soraty: e, andalana-vaovao.
}, atombohy.

{ Vata-fiarovana jereo: ['abc'] sonia: sig amin: short. } sambory: { :e
	Vokatra soraty: e, andalana-vaovao.
}, atombohy.
