Server init.

>> DB := Maria-DB vaovao mpampiantrano: ['localhost'],
	anaran-mpampiasa: ['xo'],
	tenimiafina: ['pass123'],
	anaran-tahirin-kevitra: ['xobase'],
	mifandraisa.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> masontsivana-fikarohana := Fanontaniana-Maria vaovao: SQL.

# set database
masontsivana-fikarohana tahirin-kevitra: DB.

masontsivana-fikarohana alaivo: { :row
	Vokatra soraty: row world, andalana-vaovao.
}.
