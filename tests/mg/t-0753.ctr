Vokatra soraty: ['Test object'], andalana-vaovao.
>> a := Zavatra vaovao. 

a rehefa: ['item:'] ataovy: { :fmt
	azy fmt := fmt. 
}.

a rehefa: ['item'] ataovy: { <- azy fmt.
}.

a item: ( Endrika vaovao: ['|%s|'] ).

Vokatra soraty: a item, andalana-vaovao.

>> old-fmt-address := a item modely-voalohany adiresy-fahatsiarovana.
a save-as: ['/tmp/a.bin'].
Vokatra soraty: ['========== RELOADING SNAP:'], andalana-vaovao.

>> b := Zavatra load-from: ['/tmp/a.bin'].

(b item modely-voalohany adiresy-fahatsiarovana = old-fmt-address) marina: {
	Vokatra soraty: ['Object link re-attached.'], andalana-vaovao.
}.

Vokatra soraty: ( b item ampiharo: ['hello'] ), andalana-vaovao.
