Vokatra soraty: ['Test object'], andalana-vaovao.
>> a := Zavatra vaovao. 

a rehefa: ['item:'] ataovy: { :out
	azy out := out. 
}.

a rehefa: ['item'] ataovy: { <- azy out.
}.

a rehefa: ['greet'] ataovy: {
	Vokatra soraty: ['hi from original out!'], andalana-vaovao.
}.

a item: Vokatra.

Vokatra soraty: a item, andalana-vaovao.

>> old-out-address := a item modely-voalohany adiresy-fahatsiarovana.
a save-as: ['/tmp/a.bin'].
Vokatra soraty: ['========== RELOADING SNAP:'], andalana-vaovao.

>> b := Zavatra load-from: ['/tmp/a.bin'].

(b item modely-voalohany adiresy-fahatsiarovana = old-out-address) marina: {
	Vokatra soraty: ['Object link re-attached.'], andalana-vaovao.
}.

b item soraty: ['hello from loaded out!'], andalana-vaovao.
b greet.
