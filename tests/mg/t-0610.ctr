
>> Rectangle := Zavatra vaovao.

Rectangle rehefa: ['area'] ataovy: { <- azy halavany * azy width.
}.

Rectangle rehefa: ['length:'] ataovy: { :halavany
	azy halavany := halavany.
}.

Rectangle rehefa: ['width:'] ataovy: { :width
	azy width := width.
}.

Rectangle rehefa: ['vaovao'] ataovy: {
	# this will not result into an infinite loop
	>> rectangle := tena vaovao.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle vaovao.
Vokatra soraty: a area, andalana-vaovao. #0

>> b := Rectangle vaovao length: 2, width: 3.
Vokatra soraty: b area, andalana-vaovao. #6

