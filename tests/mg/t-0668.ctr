# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob vaovao: 8, bytes: (
	Lisitra vaovao ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Vokatra soraty: ( utf16 esory-kaody: ['utf16le'] ), andalana-vaovao.

utf16 afaho.
>> utf32 := Blob vaovao: 13, bytes: (
	Lisitra vaovao ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Vokatra soraty: ( utf32 esory-kaody: ['utf32be'] ), andalana-vaovao.
utf32 afaho.