Server init.

Vokatra soraty: (
	Lamina vaovao: ['^\\w+$'],
	fifanarahana: ['test@example.com'] 
), andalana-vaovao. # 0 match, fails on @ and .

Vokatra soraty: (
	Lamina vaovao: ['^[^@]+@[^\.]+\.\\w+$'],
	fifanarahana: ['test@example.com'] 
), andalana-vaovao. # 1 match

Vokatra soraty: (
	Lamina vaovao: ['[^@]+@[^\.]+\.\\w+'],
	fifanarahana: ['test@example.com'] 
), andalana-vaovao. # 1 match

Vokatra soraty: (
	Lamina vaovao: ['([^@]+)@([^\.]+)\.\\w+'],
	fifanarahana: ['test@example.com'] 
), andalana-vaovao. # 1 match, groups dont matter

Vokatra soraty: (
	Lamina vaovao: ['[a-z]'],
	fifanarahana: ['test@example.com'] 
), andalana-vaovao. # 14 matches

Vokatra soraty: (
	Lamina vaovao: ['.*'],
	fifanarahana: ['test@example.com'] 
), andalana-vaovao. # 1 match (all)

Vokatra soraty: (
	Lamina vaovao: ['(.*)'],
	fifanarahana: ['test@example.com'] 
), andalana-vaovao. # 1 match (all)

Vokatra soraty: (
	Lamina vaovao: ['\\s*[^@]+@[^\.]+\.\\w+'],
	fifanarahana: ['test@example.com'] 
), andalana-vaovao. # 1 match, prefix space optional, gets ignored