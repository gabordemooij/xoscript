# session cookie format, json content type, web protocols only, svg shown inline
Server omano.
Fandaharana ampiasao: ['../../../src/xo/mg/webtools.xo'].

>> Fake-Request := Zavatra vaovao.
Fake-Request rehefa: ['value:'] ataovy: { :sanda
	azy sanda := sanda.
}.
Fake-Request rehefa: ['cookie:'] ataovy: { :anarana <- azy sanda.
}.

>> Test-Session := Fivoriana-rakitra-vonjimaika vaovao.
Test-Session rehefa: ['ampidiro'] ataovy: { <- Rakibolana vaovao.
}.
Test-Session rehefa: ['session-id'] ataovy: { <- azy id.
}.

>> cookies := Lisitra vaovao
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

cookies tsirairay: { :i :cookie
	>> fangatahana-http := Fake-Request vaovao.
	fangatahana-http value: cookie.
	>> mpitantana := Test-Session vaovao.
	>> web := Antontan-taratasy-Web vaovao.
	web fangatahana-http: fangatahana-http.
	web mpitantana-fivoriana: mpitantana.
	web atombohy-ny-fivoriana.
	Vokatra soraty: ( mpitantana session-id = cookie ), andalana-vaovao.
}.

>> web := Antontan-taratasy-Web vaovao.
web json: (Rakibolana vaovao apetraho: ['b'] eo: ['a']).
Vokatra soraty: ['\n'], andalana-vaovao.

{ Tambajotra get: ['file:///etc/hostname']. } sambory: { :e
	Vokatra soraty: e, andalana-vaovao.
}, atombohy.

>> svg := Rakitra vaovao: ['/tmp/test0814.svg'].
svg soraty: ['<svg xmlns="x"></svg>'].
Vokatra andalana-vaovao.
Server ampitao: ['test0814.svg'] tovona: ['/tmp/'].
svg fafao.
