# compliance test

# use international numbers

Vokatra soraty: ['1000 -> '].
Vokatra soraty: 1000, andalana-vaovao. #1000

Vokatra soraty: ['1.5 -> '].
Vokatra soraty: 1.5, andalana-vaovao.  #1.5

Vokatra soraty: ['1001.5 -> '].
Vokatra soraty: 1.5 + 1000, andalana-vaovao. #1001.5

# use 0-indexed arrays
>> x := Lisitra vaovao ; 1 ; 2 ; 3.
>> y := Lisitra vaovao ; ['a'] ; ['b'] ; ['c'].

Vokatra soraty: ['1 -> '].
Vokatra soraty: x ? 0, andalana-vaovao. #1

Vokatra soraty: ['1 -> '].
Vokatra soraty: (x eo: 0), andalana-vaovao. #1

Vokatra soraty: ['1 -> '].
Vokatra soraty: x voalohany, andalana-vaovao. #1

Vokatra soraty: ['3 -> '].
Vokatra soraty: x farany, andalana-vaovao. #3

Vokatra soraty: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Vokatra soraty: (x araka: y), andalana-vaovao.

Vokatra soraty: ['1 -> '].
Vokatra soraty: (x manomboka: 0 halavany: 1) voalohany, andalana-vaovao. #1

Vokatra soraty: ['0 -> '].
Vokatra soraty: (x tadiavo: 1), andalana-vaovao. #0

x apetraho: 9 eo: 0.

Vokatra soraty: ['9 -> '].
Vokatra soraty: (x eo: 0), andalana-vaovao. #9

x ampio-any-am-piandohana: 8.
Vokatra soraty: ['8 -> '].
Vokatra soraty: (x eo: 0), andalana-vaovao. #9


x ampio-any-amin-ny-farany: 10.
Vokatra soraty: ['10 -> '].
Vokatra soraty: (x eo: 4), andalana-vaovao. #10








