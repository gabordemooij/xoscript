Soratra rehefa: ['html'] ataovy: { <- (
		tena
		soloy: ['&'] amin: ['&amp;'],
		soloy: ['<'] amin: ['&lt;'],
		soloy: ['>'] amin: ['&gt;'],
		soloy: ['''] amin: ['&apos;'],
		soloy: ['"'] amin: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Fandaharana fitantanana-fahatsiarovana: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Vokatra soraty: txt adikao html, andalana-vaovao.
Vokatra soraty: txt adikao sora-madinika, andalana-vaovao.
Vokatra soraty: txt adikao sora-baventy, andalana-vaovao.
} atombohy.

Fandaharana diovy.

usedMemory1 := (Fandaharana fahatsiarovana ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Vokatra soraty: txt adikao html, andalana-vaovao.
Vokatra soraty: txt adikao sora-madinika, andalana-vaovao.
Vokatra soraty: txt adikao sora-baventy, andalana-vaovao.
} atombohy.

Fandaharana diovy.
usedMemory2 := (Fandaharana fahatsiarovana ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Vokatra soraty: txt adikao html, andalana-vaovao.
Vokatra soraty: txt adikao sora-madinika, andalana-vaovao.
Vokatra soraty: txt adikao sora-baventy, andalana-vaovao.
} atombohy.

Fandaharana diovy.
usedMemory3 := (Fandaharana fahatsiarovana ? 0).



( usedMemory1 = usedMemory2 ary: usedMemory1 = usedMemory3, ary: usedMemory2 = usedMemory3 ) marina: {
	Vokatra soraty: ['No memory leaks here'].
}, diso: {
	Vokatra soraty: ['Leaking memory...'].
}.
