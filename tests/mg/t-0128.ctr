
Lisitra rehefa: ['sum'] ataovy: {
	>> total := 0.
	tena tsirairay: { :index :element
		total ampio: element.
	}. <- total.
}.

>> a := Lisitra ← 9 ; 8 ; 7.
Vokatra soraty: (a sum), andalana-vaovao. 
>> a := Lisitra ← 1 ; 9.
Vokatra soraty: (a sum), andalana-vaovao. 
>> a := Lisitra ← ['o'] ; 2.
Vokatra soraty: (a sum), andalana-vaovao. 
Vokatra soraty: (Lisitra vaovao sum), andalana-vaovao. 
