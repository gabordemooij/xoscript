Server init.
>> f := Endrika vaovao: ['%d'].
>> a := Blob vaovao: 4.
a bytes: ( Lisitra vaovao ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob vaovao: 4.
b bytes: ( Lisitra vaovao ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a manomboka: 0 halavany: 3, tsirairay: { :i :byte
	Vokatra soraty: ( f ampiharo-isa-feno: byte ), andalana-vaovao.
}.
a ^ b.
a manomboka: 0 halavany: 3, tsirairay: { :i :byte
	Vokatra soraty: ( f ampiharo-isa-feno: byte ), andalana-vaovao.
}.
a ^ b.
a manomboka: 0 halavany: 3, tsirairay: { :i :byte
	Vokatra soraty: ( f ampiharo-isa-feno: byte ), andalana-vaovao.
}.
a afaho.
b afaho.

{ a ^ Zavatra. } sambory: { :e Vokatra soraty: e, andalana-vaovao. }, atombohy.
