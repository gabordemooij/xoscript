

Lisitra rehefa: ['sum'] ataovy: {
	>> total := 0.
	tena tsirairay: { :index :element
		total ampio: element.
	}. <- total.
}.

Lisitra rehefa: ['product'] ataovy: {
	>> total := 1.
	tena tsirairay: { :index :element
		total ampitomboy: element.
	}. <- total.
}.

>> usedMemory1 := 0.
