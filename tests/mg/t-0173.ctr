Fandaharana fitantanana-fahatsiarovana: 0.

{

>> a := Lisitra ← ['hello'] ; ['world'] ; Marina ; Tsinontsinona ; 666.
a := a + ( Lisitra ← 1 ).
Vokatra soraty: ( ['sum: '] + ( a sum ) ), andalana-vaovao.
Vokatra soraty: ( ['min: '] + ( a kely-indrindra ) ), andalana-vaovao.
Vokatra soraty: ( ['max: '] + ( a lehibe-indrindra ) ), andalana-vaovao.
Vokatra soraty: ( ['3rd: '] + ( a ? 2 ) ), andalana-vaovao.
Vokatra soraty: ( ['prd: '] + ( a product ) ), andalana-vaovao.
a alaharo: { :a :b <- (b - a). }.
a tsirairay: { :i :e Vokatra soraty: ( i - 0 ), andalana-vaovao. }.

} atombohy.

