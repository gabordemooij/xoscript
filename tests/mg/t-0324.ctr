>> Animal := Zavatra vaovao.
>> Factory := Zavatra vaovao.

Animal rehefa: ['vaovao'] ataovy: {
	>> animal := tena vaovao.
	animal sound: ['?']. <- animal.
}.

Animal rehefa: ['sound:'] ataovy: { :s
	azy sound := s.
}.

Animal rehefa: ['sound'] ataovy: { <- azy sound.
}.

>> Dog := Zavatra vaovao.
>> Cat := Zavatra vaovao.

Dog rehefa: ['vaovao'] ataovy: { <- Animal vaovao sound: ['woof!'].
}.

Cat rehefa: ['vaovao'] ataovy: { <- Animal vaovao sound: ['meow!'].
}.

Vokatra soraty: Dog vaovao sound, andalana-vaovao.
Vokatra soraty: Cat vaovao sound, andalana-vaovao.

Factory rehefa: ['mix:and:'] ataovy: { :beast1 :beast2 <- Animal vaovao sound: (
		( beast1 sound manomboka: 0 halavany: 2 ) +
		( beast2 sound manomboka: 2 halavany: 5 )
	).
}.

Vokatra soraty: (Factory mix: Dog vaovao and: Cat vaovao) sound, andalana-vaovao.
