
Soratra rehefa: ['evaluate'] ataovy: {
	>> kaody := Rakitra vaovao: ['/tmp/eval.ctr'].
	kaody soraty: (tena soratra + ['.']).
	Fandaharana ampiasao: ['/tmp/eval.ctr'].
}.

>> map :=
	(Rakibolana vaovao)
	apetraho: ['Hi There'] eo: ['two'],
	apetraho: (Lisitra ← ['hello'] ; ['world'] ; (Lisitra ← 1 ; 2; 9) ; Diso) eo: ['one'],
	apetraho: ( (Rakibolana vaovao) apetraho: ['wrrld'] eo: ['misspelled'] ) eo: ['three'],
	apetraho: (Lisitra ← ((Rakibolana vaovao) apetraho: ['treasure'] eo: ['hidden']) ; 2) eo: ['four']. 
>> str := map soratra.
>> map2 := Tsinontsinona.
(['map2 := '] + str ) evaluate.
Vokatra soraty: map2 ? ['one'] ? 0.
Vokatra soraty: map2 ? ['one'] ? 1.
Vokatra soraty: map2 ? ['four'] ? 0 ? ['hidden'].
Vokatra soraty: map2 ? ['one'] ? 2 ? 2.
