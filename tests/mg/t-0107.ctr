
Vokatra soraty: ['Break for-loop, 0-4.'], andalana-vaovao.
{ :i
	Vokatra soraty: ['iteration #'] + i, andalana-vaovao.
	(i = 4) atsaharo.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Vokatra soraty: ['Break while-true loop, 0-4.'], andalana-vaovao.
{
	Vokatra soraty: ['iteration #'] + x, andalana-vaovao.
	x ampio: 1.
	((x < 5) tsy) atsaharo.
} raha-mbola: xIsLessThan10.

Vokatra soraty: ['Break while-false loop, 5,4.'], andalana-vaovao.
{
	Vokatra soraty: ['iteration #'] + x, andalana-vaovao.
	x analao: 1.
	(x = 3) atsaharo.
} raha-mbola: { <- (x > 0). }.

Vokatra soraty: ['Break times loop, 1-4.'], andalana-vaovao.
{ :i
	Vokatra soraty: ['iteration #'] + i, andalana-vaovao.
	(i = 4) atsaharo.
} × 5.

Vokatra soraty: ['Break block, dont print line.'], andalana-vaovao.
{ Marina atsaharo. Vokatra soraty: ['dont write this!'], andalana-vaovao. } atombohy.

Vokatra soraty: ['Break block, dont fire catch...'], andalana-vaovao.
{ Marina atsaharo. Vokatra soraty: ['dont write this!'], andalana-vaovao. } sambory: { Vokatra soraty: ['Dont catch this!']. }, atombohy.

Vokatra soraty: ['Test Array each-loop: 0,1'], andalana-vaovao.
(Lisitra ← 1 ; 2 ; 3) ovay-tsirairay: { :i
	Vokatra soraty: ['iteration #'] + i, andalana-vaovao.
	(i = 1) atsaharo.
}.

Vokatra soraty: ['Test Map each-loop: c only'], andalana-vaovao.
>> m := Rakibolana vaovao.
m apetraho: ['first'] eo: ['a'], apetraho: ['second'] eo: ['b'], apetraho: ['third'] eo: ['c'].
m tsirairay: { :k :v
	Vokatra soraty: ['iteration'] + v + k, andalana-vaovao.
	Marina atsaharo.
}.

