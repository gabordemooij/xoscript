>> q := Lisitra ← 1 ; 2 ; 3.
{ q ? ['1']. } sambory: { Vokatra soraty: ['caught!'], andalana-vaovao. }, atombohy.
{ q ? Marina. } sambory: { Vokatra soraty: ['caught!'], andalana-vaovao. }, atombohy.
{ q ? Diso. } sambory: { Vokatra soraty: ['caught!'], andalana-vaovao. }, atombohy.
{ q ? Tsinontsinona. } sambory: { Vokatra soraty: ['caught!'], andalana-vaovao. }, atombohy.
{ q ? (Lisitra vaovao). } sambory: { Vokatra soraty: ['caught!'], andalana-vaovao. }, atombohy.
{ q ? (Zavatra vaovao). } sambory: { Vokatra soraty: ['caught!'], andalana-vaovao. }, atombohy.
{ q ? ({ ['Empty']. }). } sambory: { Vokatra soraty: ['caught!'], andalana-vaovao. }, atombohy.
Vokatra soraty: ['caught them all'], andalana-vaovao.
