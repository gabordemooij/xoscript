
Fandaharana fitantanana-fahatsiarovana: 1.
Fandaharana fahatsiarovana: 16000000.
>> tokens := ['{}↲.:,x() '].
{ :i
	>> kaody := [''].
	>> x := Isa eo: 1 ary: 10.
	{
		>> y := Isa eo: 1 ary: (tokens halavany).
		kaody ampio-any-amin-ny-farany: (tokens litera: y).
	} × x.
	{ Asa vaovao: kaody. } sambory: { ['Empty']. }, atombohy.

} × 10000.
Vokatra soraty: ['OK'], andalana-vaovao.
