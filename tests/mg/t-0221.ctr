>> x := Zavatra vaovao.
>> y := Zavatra vaovao.
>> z := x.
Vokatra soraty: (x = z), andalana-vaovao.
Vokatra soraty: (x = y), andalana-vaovao.
Vokatra soraty: (x ≠ y), andalana-vaovao.
Vokatra soraty: (x ≠ z), andalana-vaovao.
>> m := Fotoana vaovao taona: 2070, volana: 11.
>> n := m adikao.
Vokatra soraty: (m = n), andalana-vaovao.
Vokatra soraty: (m ≠ n), andalana-vaovao.
Vokatra soraty: (m mitovy-tanteraka: m), andalana-vaovao.
Vokatra soraty: (m mitovy-tanteraka: n), andalana-vaovao.
n volana: 12.
Vokatra soraty: (m ≠ n), andalana-vaovao.
Vokatra soraty: (m = n), andalana-vaovao.


