>> Point := Zavatra vaovao.
Point rehefa: ['x-coordinate:'] ataovy: { :x azy x := x. }.
Point rehefa: ['y-coordinate:'] ataovy: { :y azy y := y. }.
Point rehefa: ['x-coordinate']  ataovy: { <- azy x adikao. }.
Point rehefa: ['y-coordinate']  ataovy: { <- azy y adikao. }.

Point rehefa: ['='] ataovy: { :other <- ( azy x = other x-coordinate
		 ary: azy y = other y-coordinate ).
}.

>> pier := Point vaovao x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point vaovao x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point vaovao x-coordinate: 5, y-coordinate: 6.

Vokatra soraty: pier = town-hall, andalana-vaovao.
Vokatra soraty: pier = restaurant, andalana-vaovao.
