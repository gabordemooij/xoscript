>> i := 0.
Vokatra soraty: ['Can we count to 10 using a whileTrue loop ?'], andalana-vaovao.
{ Vokatra soraty: i, andalana-vaovao. } raha-mbola: { i ampio: 1. <- (i ≤ 10). }.
Vokatra soraty: ['Can we count back from 10 to 0 using a whileFalse loop ?'], andalana-vaovao.
{ Vokatra soraty: i, andalana-vaovao. } raha-mbola: { i analao: 1. <- (i ≥ 0). }.
