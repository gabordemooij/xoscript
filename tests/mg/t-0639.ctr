
Server init.
Vokatra soraty: ['Database test'], andalana-vaovao.

>> db := Maria-DB vaovao mpampiantrano: ['localhost'],
	anaran-mpampiasa: ['xo'], 
	tenimiafina: ['pass123'],
	anaran-tahirin-kevitra: ['xobase'],
	mifandraisa.

>> masontsivana-fikarohana :=
db fanontaniana: ['SELECT REPEAT('Blah',1000) AS blah'], 
alaivo: { :row 
	Vokatra soraty: row blah halavany, andalana-vaovao.
