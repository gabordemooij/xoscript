Vokatra soraty: ['Test object'], andalana-vaovao.
>> greeter := Zavatra vaovao.
greeter rehefa: ['name:'] ataovy: { :anarana
	azy xname := anarana. 
}.
greeter rehefa: ['greet'] ataovy: {
	Vokatra soraty: ['Hello '] + azy xname, andalana-vaovao.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Vokatra soraty: ['========== RELOADING SNAP:'], andalana-vaovao.
>> b := Zavatra load-from: ['/tmp/a.bin'].
>> c := Zavatra load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
