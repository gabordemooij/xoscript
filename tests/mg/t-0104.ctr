
{ :i
	Vokatra soraty: ['This is step #'] + ( ( i ) + 1 ), andalana-vaovao.
} × 6.

{ :i
	Vokatra soraty: ['This is step #'] + ( 3 - ( i ) ), andalana-vaovao.
} × 6.

{ :i
	Vokatra soraty: ['NEVER!'], andalana-vaovao.
} × 0.



{ :i
	Vokatra soraty: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), andalana-vaovao.
} × 11.
