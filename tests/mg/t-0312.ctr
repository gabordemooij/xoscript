>> Slurp := Zavatra vaovao.
Slurp rehefa: ['vaovao'] ataovy: {
	azy str := [''].
}.
Slurp ianaro: ['nieuw'] midika: ['vaovao'].
Slurp rehefa: ['valio:'] ataovy: { :blah
		(azy str ≠ ['']) marina: {
			azy str ampio-any-amin-ny-farany: [' '].
		}.
		azy str ampio-any-amin-ny-farany: blah.
}.
Slurp rehefa: ['valio:ary:'] ataovy: { :blah :blahah
		(azy str ≠ ['']) marina: {
			azy str ampio-any-amin-ny-farany: [' '].
		}.
		(blah halavany > 1) marina: {
			azy str ampio-any-amin-ny-farany: (blah manomboka: 0 halavany: (blah halavany - 1)).
		}, raha-tsy-izany: {
			azy str ampio-any-amin-ny-farany: blah.
		}.
		azy str ampio-any-amin-ny-farany: [' '].
		azy str ampio-any-amin-ny-farany: blahah.
}.
Slurp rehefa: ['obtain'] ataovy: {
	>> buffer := azy str.
	azy str := ['']. <- buffer.
}.


>> masontsivana-fikarohana := Slurp vaovao
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

Vokatra soraty: masontsivana-fikarohana obtain, andalana-vaovao.
