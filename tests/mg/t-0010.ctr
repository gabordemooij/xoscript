>> Animal := Zavatra vaovao.
Animal rehefa: ['make'] ataovy: {
	>> animal := Zavatra vaovao.
	animal rehefa: ['makeSound'] ataovy: {
		Vokatra soraty: azy sound.
	}. <- animal.
}.
>> Cat := Zavatra vaovao.
Cat rehefa: ['make'] ataovy: {
	>> cat := Animal make.
	cat rehefa: ['init'] ataovy: {
		azy sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
