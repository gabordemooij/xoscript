Lisitra rehefa: ['sum'] ataovy: {
	>> total := 0.
	tena tsirairay: { :index :element
		total ampio: element.
	}. <- total.
}.

>> a := Marina.



a rehefa: ['soratra'] ataovy: {
	>> answer := Tsinontsinona.
	( tena = Marina ) marina: {
		answer := ['Yep'].
	}, raha-tsy-izany: {
		answer := ['Nope'].
	}. <- answer.
}.

a rehefa: ['isa'] ataovy: {
	>> answer := Tsinontsinona.
	( tena = Marina ) marina: {
		answer := 10.
	}, raha-tsy-izany: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b rehefa: ['soratra'] ataovy: { <- ['Devil'].
}.

b rehefa: ['boleanina'] ataovy: { <- Diso.
}.


Vokatra soraty: a, andalana-vaovao.  
Vokatra soraty: (90 + a), andalana-vaovao. 
Vokatra soraty: b, andalana-vaovao. 
Vokatra soraty: (Marina ary: b), andalana-vaovao.

a := Lisitra ← ['hello'] ; ['world'] ; Marina ; Tsinontsinona ; 666. 
a := a + ( Lisitra ← 1 ).
Vokatra soraty: a, andalana-vaovao.
Vokatra soraty: ((Rakibolana vaovao) apetraho: Tsinontsinona eo: Tsinontsinona), andalana-vaovao.
Vokatra soraty: a sum, andalana-vaovao. 


{
	a rehefa: ['soratra'] ataovy: { <- Tsinontsinona. }.
	a := [''] + a.
} sambory: { :error
	Vokatra soraty: ['Error noted: '] + error, andalana-vaovao.
}, atombohy.



{
	a rehefa: ['isa'] ataovy: { <- Tsinontsinona. }.
	a := 3 × a.
} sambory: { :error
	Vokatra soraty: ['Error noted: '] + error, andalana-vaovao.
}, atombohy.


{
	a rehefa: ['boleanina'] ataovy: { <- Tsinontsinona. }.
