
>> city := Lisitra ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Lisitra ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature araka: city.
>> cities := weather fanalahidy alaharo: { :a :b <- (a ampitahao: b). }.
>> temperatures := weather sanda-rehetra alaharo: { :a :b <- (a ampitahao: b) ambany-aotra?. }.

Vokatra soraty: (cities atambaro: [',']), andalana-vaovao.
Vokatra soraty: (temperatures atambaro: [',']), andalana-vaovao.
