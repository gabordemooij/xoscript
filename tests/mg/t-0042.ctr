>> items := Rakibolana vaovao.
items apetraho: ['black'] eo: ['coffee'], apetraho: ['earl grey'] eo: ['tea'].
Vokatra soraty: (items eo: ['coffee']), soraty: (items eo: ['tea']).
Vokatra soraty: ['there are'] + items isan-javatra + [' items in the array.'].
items apetraho: ['capuccino'] eo: ['coffee'].
Vokatra soraty: ['Now my coffee is.. '] + (items eo: ['coffee']).
items apetraho: ['aaa'] eo: ['1'].
items apetraho: ['bbb'] eo: ['2'].
Vokatra soraty: (items eo: ['a']).
