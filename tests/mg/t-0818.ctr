# edge cases from a request must give an error or a result, not a crash
Server init.

Vokatra soraty: ['<'] + (['abc'] manomboka: 0 halavany: 0, sora-baventy) + ['>'], andalana-vaovao.
Vokatra soraty: ['<'] + (['abc'] manomboka: 0 halavany: 0, sora-madinika) + ['>'], andalana-vaovao.
Vokatra soraty: ['<'] + (['abc'] dingano: 3, sora-baventy) + ['>'], andalana-vaovao.
Vokatra soraty: [''] sora-baventy bytes, andalana-vaovao.
Vokatra soraty: ['aB'] sora-baventy, andalana-vaovao.
Vokatra soraty: ['aB'] sora-madinika, andalana-vaovao.

Vokatra soraty: (Fotoana vaovao: 0) taona, andalana-vaovao.
{ Fotoana vaovao: ['9e300'] isa. } sambory: { :e Vokatra soraty: e, andalana-vaovao. }, atombohy.
{ Fotoana vaovao: ['-9e300'] isa. } sambory: { :e Vokatra soraty: e, andalana-vaovao. }, atombohy.
{ Fotoana vaovao: ['nan'] isa. } sambory: { :e Vokatra soraty: e, andalana-vaovao. }, atombohy.
{ Fotoana vaovao: 9000000000000000000. } sambory: { :e Vokatra soraty: e, andalana-vaovao. }, atombohy.
