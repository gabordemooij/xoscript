#Linux

(Rakitra vaovao: ['/tmp/testje']) misy diso: {
	Fandaharana rafitra: ['mkdir /tmp/testje'].	
}.

(Rakitra vaovao: ['/tmp/testje/file1']) misy diso: {
	Fandaharana rafitra: ['touch /tmp/testje/file1'].	
}.

(Rakitra vaovao: ['/tmp/testje/folder1']) misy diso: {
	Fandaharana rafitra: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Rakitra lisitra: ['/tmp/testje'].

>> q := Lisitra vaovao.

l tsirairay: { :k :v v tsirairay: { :x :y q ampio-any-amin-ny-farany: y. }. }.

>> s := q soratra.

(s misy: ['file1']) marina:   { Vokatra soraty: ['OK'], andalana-vaovao. }.
(s misy: ['file2']) marina:   { Vokatra soraty: ['XX'], andalana-vaovao. }.
(s misy: ['folder1']) marina: { Vokatra soraty: ['OK'], andalana-vaovao. }.
