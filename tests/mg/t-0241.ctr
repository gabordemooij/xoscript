

Soratra rehefa: ['evaluate'] ataovy: {
	>> kaody := Rakitra vaovao: ['/tmp/eval.ctr'].
	kaody soraty: (tena soratra + ['.']).
	Fandaharana ampiasao: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Lisitra ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q soratra.
Vokatra soraty: x, andalana-vaovao.
>> y := Tsinontsinona.
(['y := '] + x ) evaluate.
Vokatra soraty: y ? 0, andalana-vaovao.

q := Rakibolana apetraho: ['\[''] eo: ['\['quote\']'].
x := q soratra.
Vokatra soraty: x, andalana-vaovao.
y := Tsinontsinona.
(['y := '] + x ) evaluate.

>> q := (Rakibolana vaovao) apetraho:['\[''] eo:['\['quote\[''].
Vokatra soraty: y ? ['\['quote\']'], andalana-vaovao.
