# recursive interpolation not allowed

Vokatra soraty: 
['recursive string interolation enabled: '] + (
	Fandaharana endri-javatra: 
	['RECURSIVE_STRINTPOL']
), andalana-vaovao.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Vokatra soraty: a, andalana-vaovao.


