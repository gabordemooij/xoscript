# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Vata-fiarovana mamorona-fanalahidy.

# private (secret) key
>> sk := keys voalohany.

# public key
>> pk := keys farany.

# sign a message
>> sig := Vata-fiarovana soniavo: ['abc'] amin: sk.

# check message (ok)
Vokatra soraty: ( 
	Vata-fiarovana
		jereo: ['abc'] 
		sonia: sig 
		amin: pk 
), andalana-vaovao.

# check message (fail)
Vokatra soraty: ( 
	Vata-fiarovana 
		jereo: ['abd'] 
		sonia: sig 
		amin: pk 
), andalana-vaovao.