>> str := ['write:'].
Vokatra hafatra: ['soraty:'] fampidirana: (Lisitra ← ['Hello World']), andalana-vaovao. 

Isa rehefa: ['isbetween:and:'] ataovy: { :a :b <- ((tena ≥ a) ary: (tena ≤ b)).
}.

str := ['isbetween:and:'].
Vokatra soraty: (3 hafatra: str fampidirana: (Lisitra ← 2 ; 8)), andalana-vaovao.
Vokatra soraty: (3 hafatra: str fampidirana: (Lisitra ← 1 ; 2)), andalana-vaovao.


>> CoffeeMachine := Zavatra vaovao.
CoffeeMachine rehefa: ['makeCoffeeWithSugar:milk:'] ataovy: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Lisitra ← 4 ; 2.
Vokatra soraty: ( CoffeeMachine hafatra: order fampidirana: coffeeConfiguration ), andalana-vaovao.
