# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := Maria-DB vaovao mpampiantrano: ['localhost'],
	anaran-mpampiasa: ['xo'],
	tenimiafina: ['pass123'],
	anaran-tahirin-kevitra: ['xobase'],
	mifandraisa.

>> masontsivana-fikarohana := db fanontaniana: ['SELECT ? AS a, ? AS b, ? AS c'].
masontsivana-fikarohana masontsivana: (Lisitra vaovao ; ['1']).
{ masontsivana-fikarohana alaivo: { :row Vokatra soraty: row, andalana-vaovao. }. } sambory: { :e Vokatra soraty: e, andalana-vaovao. }, atombohy.

>> masontsivana-fikarohana := db fanontaniana: ['SELECT ? AS a'].
{ masontsivana-fikarohana alaivo: { :row Vokatra soraty: row, andalana-vaovao. }. } sambory: { :e Vokatra soraty: e, andalana-vaovao. }, atombohy.

# the right number still works, more parameters are ignored as before
>> masontsivana-fikarohana := db fanontaniana: ['SELECT ? AS a, ? AS b'].
masontsivana-fikarohana masontsivana: (Lisitra vaovao ; ['1'] ; ['2']).
masontsivana-fikarohana alaivo: { :row Vokatra soraty: (row eo: ['a']), soraty: (row eo: ['b']), andalana-vaovao. }.
masontsivana-fikarohana masontsivana: (Lisitra vaovao ; ['1'] ; ['2'] ; ['3']).
masontsivana-fikarohana alaivo: { :row Vokatra soraty: (row eo: ['a']), soraty: (row eo: ['b']), andalana-vaovao. }.
