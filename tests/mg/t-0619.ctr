>> HTML := Zavatra vaovao.
HTML rehefa: ['valio:'] ataovy: { :tag 
	Vokatra soraty: (['<tag>'] tag: tag), andalana-vaovao.
}.
HTML rehefa: ['valio:ary:'] ataovy: { :tag :html 
	Vokatra soraty: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), andalana-vaovao.
}.
>> html := HTML vaovao.
html body h1: ['header'].

