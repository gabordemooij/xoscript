Lisitra rehefa: ['adikao'] ataovy: {
	>> adikao := Lisitra vaovao.
	tena tsirairay: { :isa :section
		adikao ampio-any-amin-ny-farany: section miantso-tena adikao.
	}. <- adikao.
}.

>> sheep := Lisitra vaovao ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep adikao.
clones tsirairay: { :isa :sheep
	sheep ampio-any-amin-ny-farany: ['2'].
}.

Vokatra soraty: sheep, andalana-vaovao.
Vokatra soraty: clones, andalana-vaovao.
