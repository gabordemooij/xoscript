


>> Deck := Lisitra vaovao.
Deck rehefa: ['print'] ataovy: {
        >> len := tena isan-javatra - 1.
        { :i
                >> len2 := tena isan-javatra - 1.
                Vokatra soraty: ['len: '].
                Vokatra soraty: len, andalana-vaovao.
                Vokatra soraty: ['len2: '].
                Vokatra soraty: len2, andalana-vaovao.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
