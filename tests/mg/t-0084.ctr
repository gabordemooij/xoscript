>> makeAdder := { :x
	>> f := { :y <- (azy x + y). } apetraho: ['x'] sanda: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i azy q apetraho: (azy f ampiharo: (azy q ? i)) eo: i. } 
	apetraho: ['q'] sanda: array,
	apetraho: ['f'] sanda: func.
	{ :i mapping ampiharo: i. } × (array isan-javatra).
}.

>> a := Lisitra ← 1; 2; 3.
mapper ampiharo: a ary: (makeAdder ampiharo: 100).
Vokatra soraty: (a toerana: 0), andalana-vaovao.
Vokatra soraty: (a ? 1), andalana-vaovao.
Vokatra soraty: (a ? 2), andalana-vaovao.
