
Soratra rehefa: ['html'] ataovy: { <- (
		tena
		soloy: ['&'] amin: ['&amp;'],
		soloy: ['<'] amin: ['&lt;'],
		soloy: ['>'] amin: ['&gt;'],
		soloy: ['"'] amin: ['&quot;']
	).
}.

>> HtmlBrush := Zavatra vaovao.

HtmlBrush rehefa: ['valio:'] ataovy: { :tag
	Vokatra soraty: (['<tag>↵'] tag: tag ).
}.

HtmlBrush rehefa: ['valio:ary:'] ataovy: { :tag :content
	tag := ( tag manomboka: 0 halavany: (tag halavany - 1) ).
	Vokatra soraty: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush rehefa: ['content:'] ataovy: { :text
	Vokatra soraty: text html, andalana-vaovao.
}.

HtmlBrush rehefa: ['attr:value:'] ataovy: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush vaovao.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
