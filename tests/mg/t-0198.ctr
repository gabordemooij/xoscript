

Fandaharana fitantanana-fahatsiarovana: 4.
{
	>> cat := Zavatra vaovao.
	cat rehefa: ['work'] ataovy: {
		ity-asa-ity fahadisoana: ['Uncatched error has occurred.↵Cats have personel for that!'].
		Vokatra soraty: ['dont print this!'].
	}.
	{ cat work. } atombohy.
} sambory: { :e
	Vokatra soraty: e.
}, atombohy.
