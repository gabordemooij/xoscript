# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> lalan-drakitra := ['/tmp/dat.csv'].
>> csv := Rakitra vaovao: lalan-drakitra.
csv soraty: s.

# accepts CRLF LF CR, varying row length
csv mpampisaraka: [';'] farango-sosona: ['"'] andalana: { :line
	Fandaharana diovy.
	Vokatra soraty: line, andalana-vaovao.
	Fandaharana diovy.
}.

# unequal lines
s ampio-any-amin-ny-farany: ['\njustone'].
csv soraty: s.
{
	csv mpampisaraka: [';'] farango-sosona: ['"'] andalana: { :line
		Vokatra soraty: line, andalana-vaovao.
	}.
} sambory: { :e 
	Vokatra soraty: e, andalana-vaovao.
}, atombohy.

# invalid format
s := ['"he"llo";world'].
csv soraty: s.
{
	csv mpampisaraka: [';'] farango-sosona: ['"'] andalana: { :line
		Vokatra soraty: line, andalana-vaovao.
	}.
} sambory: { :e 
	Vokatra soraty: e, andalana-vaovao.
}, atombohy.
