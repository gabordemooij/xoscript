>> x := Fotoana vaovao.
x faritr-ora: ['CEST'],
taona:2017,
volana:01,
andro:10,
ora: 10,
minitra: 0,
segondra: 0.

Vokatra soraty: x, andalana-vaovao.

Vokatra soraty: x fotoana, andalana-vaovao.

x ampio: 1 segondra.
x ampio: 2 minitra.
x ampio: 3 ora.
x ampio: 4 andro.
x ampio: 1 volana.
x ampio: 6 taona.

Vokatra soraty: x, andalana-vaovao.

x analao: 1 segondra.
x analao: 2 minitra.
x analao: 3 ora.
x analao: 4 andro.
x analao: 1 volana.
x analao: 6 taona.

Vokatra soraty: x, andalana-vaovao.

>> y := x adikao.
>> z := x.

Vokatra soraty: y, andalana-vaovao.
Vokatra soraty: z, andalana-vaovao.
Vokatra soraty: (x faritr-ora = y faritr-ora), andalana-vaovao.
Vokatra soraty: (x fotoana = y fotoana), andalana-vaovao.
Vokatra soraty: (x = z), andalana-vaovao.
Vokatra soraty: x andro-ny-taona, andalana-vaovao.
Vokatra soraty: x andron-ny-herinandro, andalana-vaovao.
Vokatra soraty: x herinandro, andalana-vaovao.
