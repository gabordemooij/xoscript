# a value ending in the first part of an opening quote must survive serialization
>> sanda-rehetra := Lisitra vaovao
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

sanda-rehetra tsirairay: { :i :value
	>> d := Rakibolana vaovao.
	d apetraho: value eo: ['k'].
	d apetraho: ['second'] eo: ['j'].
	>> r := d kaody zavatra.
	Vokatra soraty: r isan-javatra, andalana-vaovao.
	Vokatra soraty: ( (r eo: ['k']) = value ), andalana-vaovao.
}.
