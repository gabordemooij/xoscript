Server init.

>> db := Maria-DB vaovao mpampiantrano: ['localhost'],
	anaran-mpampiasa: ['xo'],
	tenimiafina: ['pass123'],
	anaran-tahirin-kevitra: ['xobase'],
	mifandraisa.

>> masontsivana-fikarohana := db fanontaniana: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], masontsivana: ( Lisitra vaovao ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  masontsivana-fikarohana tanteraho. db hamafiso. } sambory: { :e db avereno.  }, atombohy.

Vokatra soraty: ['Can we insert? '] + ( masontsivana-fikarohana insert-id > 0 ), andalana-vaovao.
