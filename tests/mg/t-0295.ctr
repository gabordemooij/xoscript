
>> dictionary := (
	Rakibolana vaovao
		apetraho: ['b'] eo: ['a'],
		apetraho: ['a'] eo: ['b'],
		apetraho: ['z'] eo: ['x'],
		apetraho: ['hello'] eo: ['hallo'],
		apetraho: ['human'] eo: ['human']
).

>> comparisons := Lisitra vaovao.
dictionary tsirairay: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a ampitahao: b)
	).
}.

comparisons alaharo: { :a :b <- ( a ampitahao: b ). }.
Vokatra soraty: ( comparisons atambaro: ['↵'] ), andalana-vaovao.
comparisons atambaro: ['↵'].
