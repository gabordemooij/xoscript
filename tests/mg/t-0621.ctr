>> phrases := Lisitra vaovao
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases tsirairay: { :_ :phrase 
	>> e := Server base64-asio-kaody: phrase.
	>> d := Server base64-esory-kaody: e.
	Vokatra soraty: (
		message adikao ~encoded: e, ~decoded: d
	), andalana-vaovao.
}.
