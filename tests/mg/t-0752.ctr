Vokatra soraty: ['Test object'], andalana-vaovao.
>> a := Zavatra vaovao. 

a rehefa: ['item:'] ataovy: { :boleanina
	azy boleanina := boleanina. 
}.

a rehefa: ['item'] ataovy: { <- azy boleanina.
}.

a item: Boleanina.

Vokatra soraty: a item, andalana-vaovao.

>> old-bool-address := a item modely-voalohany adiresy-fahatsiarovana.
a save-as: ['/tmp/a.bin'].
Vokatra soraty: ['========== RELOADING SNAP:'], andalana-vaovao.

>> b := Zavatra load-from: ['/tmp/a.bin'].

(b item modely-voalohany adiresy-fahatsiarovana = old-bool-address) marina: {
	Vokatra soraty: ['Object link re-attached.'], andalana-vaovao.
}.

Vokatra soraty: b item, andalana-vaovao.
