

Soratra rehefa: ['html'] ataovy: { <- (
		tena
		soloy: ['&'] amin: ['&amp;'],
		soloy: ['<'] amin: ['&lt;'],
		soloy: ['>'] amin: ['&gt;'],
		soloy: ['"'] amin: ['&quot;']
	).
}.


Vokatra soraty: ([' left trimmed '] tapaho-ny-elanelana) + [' '] + ( ['and right trimmed'] tapaho-ny-elanelana) + ['!'], andalana-vaovao.
Vokatra soraty: ['<html>"html & entities"</html>'] html.
