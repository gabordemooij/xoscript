
Server init.
Vokatra soraty: ['Database test'], andalana-vaovao.

>> db := Maria-DB vaovao mpampiantrano: ['localhost'],
	anaran-mpampiasa: ['xo'], 
	tenimiafina: ['pass123'],
	anaran-tahirin-kevitra: ['xobase'],
	mifandraisa.

>> masontsivana-fikarohana :=
db fanontaniana: ['SELECT UNHEX('CAFE') AS blobby'],
alaivo: { :row
	Vokatra soraty: ( row blobby manomboka: 0 halavany: 2 ), andalana-vaovao.
	row blobby afaho.
}.
