# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Vata-fiarovana 
	hash-tenimiafina: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Vata-fiarovana 
	hash-tenimiafina: hash hamarino: a1.
	# fail 
>> b := Vata-fiarovana
	hash-tenimiafina: hash hamarino: a2.
	# ok!

Vokatra soraty: a, andalana-vaovao.
Vokatra soraty: b, andalana-vaovao.

