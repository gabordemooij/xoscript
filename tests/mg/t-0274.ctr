

Lisitra rehefa: ['column:'] ataovy: { :column
	>> result := Lisitra vaovao.
	tena tsirairay: { :index :row
		row tsirairay: { :index :cell
			(index = column) marina: { result ampio-any-amin-ny-farany: cell. }.
		}.
	}. <- result.
}.


>> a := Lisitra ←
	(Lisitra ← 1 ; 2 ; 3) ;
	(Lisitra ← 4 ; 5 ; 6) ;
	(Lisitra ← 7 ; 8 ; 9).

>> b := a column: 1.
Vokatra soraty: b, andalana-vaovao.

b := a column: 20.
Vokatra soraty: b, andalana-vaovao.

b := a column: -100.
Vokatra soraty: b, andalana-vaovao.
