#Linux
>> Slurp := Zavatra vaovao.

Slurp rehefa: ['vaovao'] ataovy: {
	azy str := [''].
}.

Slurp rehefa: ['nieuw'] ataovy: {
	azy str := [''].
}.

Slurp rehefa: ['valio:'] ataovy: { :blah
		azy str ampio-any-amin-ny-farany: blah.
}.

Slurp rehefa: ['valio:ary:'] ataovy: { :blah :blahah
		azy str ampio-any-amin-ny-farany: (blah manomboka: 0 halavany: (blah halavany - 1)).
		azy str ampio-any-amin-ny-farany: [' '].
		azy str ampio-any-amin-ny-farany: blahah.
}.

Slurp rehefa: ['obtain'] ataovy: {
	>> buffer := azy str.
	azy str := ['']. <- buffer.
}.


Vokatra soraty: (Fandaharana rafitra: (Slurp vaovao echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Rakitra vaovao: ['/tmp/from.txt'], fafao. } sambory: { ['Empty']. }, atombohy.
{ Rakitra vaovao: ['/tmp/to.txt'], fafao. } sambory: { ['Empty']. }, atombohy.


Rakitra vaovao: ['/tmp/to.txt'], misy diso: {
	Vokatra soraty: ['Confirmed. Target file does not exist.\
'].
}.
Rakitra vaovao: ['/tmp/from.txt'], misy diso: {
	Vokatra soraty: ['Confirmed. Source file does not exist.\
'].
}.



Fandaharana rafitra: (Slurp vaovao touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Fandaharana rafitra: (Slurp vaovao cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Rakitra vaovao: ['/tmp/to.txt'], misy marina: {
	Vokatra soraty: ['Confirmed. Target file has been created by shell.\
'].
}.


Vokatra soraty: ['Contents of file is:'] + (Rakitra vaovao: ['/tmp/to.txt'], vakio), andalana-vaovao.
