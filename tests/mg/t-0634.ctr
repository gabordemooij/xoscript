# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Fandaharana shell-escape: ['abc'].
Vokatra soraty: c, andalana-vaovao.
Vokatra soraty: ( Fandaharana rafitra: ['echo '] + c ), andalana-vaovao.

c := Fandaharana shell-escape: ['a'b'c'].
Vokatra soraty: c, andalana-vaovao.
Vokatra soraty: ( Fandaharana rafitra: ['echo '] + c ), andalana-vaovao.

c := Fandaharana shell-escape: ['a\'c'].
Vokatra soraty: c, andalana-vaovao.
Vokatra soraty: ( Fandaharana rafitra: ['echo '] + c ), andalana-vaovao.