Server init.

# create a memory block of 10 bytes
>> fahatsiarovana := Blob vaovao: 10.

# fill it with 3 bytes
fahatsiarovana bytes: ( Lisitra vaovao ; 65 ; 66 ; 67 ).

# write the bytes to StdOut as a string
Vokatra soraty: fahatsiarovana soratra, andalana-vaovao.

# free the memory block
fahatsiarovana afaho.

