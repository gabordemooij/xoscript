Fandaharana fitantanana-fahatsiarovana: 4.

>> Doubler := Zavatra vaovao.
>> Multiplier := Zavatra vaovao.
Doubler rehefa: ['double:and:'] ataovy: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier rehefa: ['multiply:and:'] ataovy: { :x :y <- (x × y).
}.

Vokatra soraty: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), andalana-vaovao.
