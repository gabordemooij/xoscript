

Soratra rehefa: ['evaluate'] ataovy: {
	>> kaody := Rakitra vaovao: ['/tmp/eval.ctr'].
	kaody soraty: tena soratra + ['.'].
	Fandaharana ampiasao: ['/tmp/eval.ctr'].
}.

>> a := (Lisitra ← (
	(Rakibolana vaovao)
		apetraho: ['domain'] eo: ['mywebsite.com'],
		apetraho: (Lisitra ←
			((Rakibolana vaovao)
				apetraho: ['home'] eo: ['title'],
				apetraho: ['<html></html>'] eo: ['body'],
				apetraho: ['2017-01-01'] eo: ['created']
			) ;
			((Rakibolana vaovao)
				apetraho: ['aboutus(c)'] eo: ['title'],
				apetraho: ['<credits>Author Inc.</credits>'] eo: ['body']
			)
		) eo: ['pages']
	)
) soratra.

Vokatra soraty: a karazana, andalana-vaovao.
Vokatra soraty: a, andalana-vaovao.

>> b := Tsinontsinona.
(['b := '] + a) evaluate.
Vokatra soraty: b ? 0 ? ['pages'] ? 1 ? ['body'], andalana-vaovao.

>> c := b ? 0.
>> d := c soratra.
Vokatra soraty: d karazana, andalana-vaovao.

>> e := Tsinontsinona.
(['e := '] + d) evaluate.
Vokatra soraty: e ? ['pages'] ? 0, andalana-vaovao.
