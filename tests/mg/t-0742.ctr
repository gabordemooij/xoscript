Vokatra soraty: ['Test object'], andalana-vaovao.
>> a := Zavatra vaovao. 

a rehefa: ['item:'] ataovy: { :hexhelper
	azy hexhelper := hexhelper. 
}.

a rehefa: ['item'] ataovy: { <- azy hexhelper.
}.

a item: Hx vaovao.

>> old-hexhelper-address := a item modely-voalohany adiresy-fahatsiarovana.
a save-as: ['/tmp/a.bin'].
Vokatra soraty: ['========== RELOADING SNAP:'], andalana-vaovao.

>> b := Zavatra load-from: ['/tmp/a.bin'].

(b item modely-voalohany adiresy-fahatsiarovana = old-hexhelper-address) marina: {
	Vokatra soraty: ['Object link re-attached.'], andalana-vaovao.
}.
