
>> Size := Zavatra vaovao.
Size rehefa: ['is:'] ataovy: { :isa
	isa rehefa: ['+'] ataovy: { :isa
		>> unit := isa venty-isa.
		>> factor := 1.
		
		unit
		raharaha: ['inch'] ataovy: { factor := 0.0833. }. <- tena + (isa * factor).
	}. <- isa.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Vokatra soraty: plank + edge, andalana-vaovao.
