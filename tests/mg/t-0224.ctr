
>> countries := Lisitra vaovao
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Lisitra vaovao
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods araka: countries, tsirairay: { :key :value
	counter ampio: 1.
}.

Vokatra soraty: (['we serve counter dishes'] counter: counter), andalana-vaovao.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] litera-rehetra alaharo: { :v
	counter ampio: 0.
}.

Vokatra soraty: (['we sort counter dishes'] counter: counter), andalana-vaovao.


>> counter := 0.
{
	{
		counter ampio: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Vokatra soraty: (['we calculate counter numbers.'] counter: counter), andalana-vaovao.

