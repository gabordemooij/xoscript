Vokatra soraty: (['a:b:'] - [':']), andalana-vaovao.
Vokatra soraty: (['Lorem Ipsum'] - ['Ipsum']), andalana-vaovao.
Vokatra soraty: (['a.................b.......................c...........'] - ['.']), andalana-vaovao.
Vokatra soraty: (['a--b--c---d'] - ['--']), andalana-vaovao.
Vokatra soraty: (['-'] - ['--']), andalana-vaovao.
Vokatra soraty: ([''] - ['--']), andalana-vaovao.
Vokatra soraty: (['--'] - ['']), andalana-vaovao.
Vokatra soraty: ([''] - ['']), andalana-vaovao.
>> x := ['xx'].
>> y := x - ['x'].
Vokatra soraty: x, andalana-vaovao.
Vokatra soraty: y, andalana-vaovao.
>> x := ['a,bb,c'].
>> y := x soloy: [''] amin: ['xx'].
Vokatra soraty: ((x mitovy-tanteraka: y) ity: ['OK'] na-iry: ['BUG! Did return a copy by accident!']), andalana-vaovao.