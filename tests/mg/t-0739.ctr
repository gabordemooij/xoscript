Vokatra soraty: ['Test object'], andalana-vaovao.
>> a := Zavatra vaovao. 

a rehefa: ['item:'] ataovy: { :binhelper
	azy binhelper := binhelper. 
}.

a rehefa: ['item'] ataovy: { <- azy binhelper.
}.

a item: Bin vaovao.

>> old-binhelper-address := a item modely-voalohany adiresy-fahatsiarovana.
a save-as: ['/tmp/a.bin'].
Vokatra soraty: ['========== RELOADING SNAP:'], andalana-vaovao.

>> b := Zavatra load-from: ['/tmp/a.bin'].

(b item modely-voalohany adiresy-fahatsiarovana = old-binhelper-address) marina: {
	Vokatra soraty: ['Object link re-attached.'], andalana-vaovao.
}.


