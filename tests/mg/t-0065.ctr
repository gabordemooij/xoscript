Isa rehefa: ['factorial'] ataovy: {
	>> total := 1.
	{ :index total ampitomboy: (tena - (index)). } × tena. <- total.
}.
>> Printer := Zavatra vaovao.
Printer rehefa: ['print:and:'] ataovy: { :x :y
	Vokatra soraty: ['a='] + x + [', b='] + y, andalana-vaovao.
}.
>> a := 4.5. >> b := a ahena-ho-isa-feno.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a ampiakarina-ho-isa-feno.
Printer print: a and: b.
a := 4.5. b := a ahena-ho-isa-feno.
Printer print: a and: b.
a := 4.5. b := a boribory-isa.
Printer print: a and: b.
a := 4.2. b := a boribory-isa.
Printer print: a and: b.

