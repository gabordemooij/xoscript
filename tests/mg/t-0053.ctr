60 × {
	>> x := (Isa random % 6) + 1.
	(x ≤ 6) diso: { Vokatra soraty: ['FAIL']. }.
	(x ≥0) diso: { Vokatra soraty: ['FAIL']. }.
	x := (Isa random % 3) + 1.
	(x < 3) diso: { Vokatra soraty: ['FAIL']. }.
	(x>-1) diso: { Vokatra soraty: ['FAIL']. }.
	x := ((Boleanina flip) isa).
	(x = 0 na: x = 1) diso: { Vokatra soraty: ['FAIL']. }.
	x := ((Marina flip) isa).
	(x = 0 na: x = 1) diso: { Vokatra soraty: ['FAIL']. }.
	x := (Boleanina flip ity: ['HEAD'] na-iry: ['TAIL']).
	((x = ['HEAD']) na: (x = ['TAIL'])) diso: { Vokatra soraty: ['FAIL']. }.
}.
Vokatra soraty: ['DONE'].

