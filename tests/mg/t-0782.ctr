Vokatra soraty: ['Test object'], andalana-vaovao.
>> cmd := Baiko vaovao.
Vokatra soraty: cmd ls /tmp, andalana-vaovao.
>> old-cmd-address := cmd modely-voalohany adiresy-fahatsiarovana.
cmd save-as: ['/tmp/a.bin'].
Vokatra soraty: ['========== RELOADING SNAP:'], andalana-vaovao.
>> b := Zavatra load-from: ['/tmp/a.bin'].
(b modely-voalohany adiresy-fahatsiarovana = old-cmd-address) marina: {
	Vokatra soraty: ['Object link re-attached.'], andalana-vaovao.
}.
Vokatra soraty: b ls, andalana-vaovao.


