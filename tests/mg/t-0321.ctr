# test qualifiers

Fandaharana diovy.

>> Fruit := Zavatra vaovao.
Fruit rehefa: ['vaovao'] ataovy: {
	>> f := tena vaovao.
	f apples: 0. <- f.
}.
Fruit rehefa: ['apples:'] ataovy: { :a azy apples := a. }.
Fruit rehefa: ['apples'] ataovy: { <- azy apples. }.
Fruit rehefa: ['+'] ataovy: { :f
	>> n := Fruit vaovao.
	n apples: (f apples + azy apples). <- n.
}.
Isa rehefa: ['apples'] ataovy: { <- ((Fruit vaovao) apples: tena).
}.

Fruit rehefa: ['soratra'] ataovy: { <- azy apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Vokatra soraty: q, andalana-vaovao.




q := 3 apples + 4 apples.
