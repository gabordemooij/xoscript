
>> shop := (Rakibolana vaovao
	apetraho: ['magazine'] eo: ['books'],
	apetraho: ['computer'] eo: ['electronics'],
	apetraho: ['lipstick'] eo: ['cosmetics']
).
Vokatra soraty: (shop manana: ['computer']), andalana-vaovao. 
Vokatra soraty: (shop manana: ['sausage']), andalana-vaovao. 
Vokatra soraty: (shop manana: ['computers']), andalana-vaovao. 
Vokatra soraty: (shop manana: ['compute']), andalana-vaovao. 
Vokatra soraty: (shop manana: ['2computer']), andalana-vaovao. 
