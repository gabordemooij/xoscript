Vokatra soraty: ['Test object'], andalana-vaovao.
>> a := Zavatra vaovao. 

a rehefa: ['item:'] ataovy: { :octhelper
	azy octhelper := octhelper. 
}.

a rehefa: ['item'] ataovy: { <- azy octhelper.
}.

a item: Oct vaovao.

>> old-octhelper-address := a item modely-voalohany adiresy-fahatsiarovana.
a save-as: ['/tmp/a.bin'].
Vokatra soraty: ['========== RELOADING SNAP:'], andalana-vaovao.

>> b := Zavatra load-from: ['/tmp/a.bin'].

(b item modely-voalohany adiresy-fahatsiarovana = old-octhelper-address) marina: {
	Vokatra soraty: ['Object link re-attached.'], andalana-vaovao.
}.
