#Linux
>> clock := Fotoana vaovao.
clock faritr-ora: ['UTC-1'].
clock taona: 1981, volana: 1, andro: 5,
      ora: 13, minitra: 15, segondra: 13.

Vokatra soraty: clock, andalana-vaovao.
clock faritr-ora: ['UTC+0'].

Vokatra soraty: (
	(clock taona tsotra) + ['-'] + (clock volana) + ['-'] + (clock andro) + [' '] +
	(clock ora) + [':'] + (clock minitra) + [':'] + (clock segondra) + [' '] +
	['W'] + (clock herinandro) + (clock faritr-ora)
), andalana-vaovao.


clock faritr-ora: ['UTC-1'].
Vokatra soraty: (
	(clock taona tsotra) + ['-'] + (clock volana) + ['-'] + (clock andro) + [' '] +
	(clock ora) + [':'] + (clock minitra) + [':'] + (clock segondra) + [' '] +
	['W'] + (clock herinandro) + (clock faritr-ora)
), andalana-vaovao.
