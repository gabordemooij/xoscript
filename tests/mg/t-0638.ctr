
Server init.
>> rq := Fangatahana-HTTP vaovao.
Vokatra soraty: ['HTTP-GET d[]=']  + ( rq get-lisitra: ['d[]'] ), andalana-vaovao. # GET
Vokatra soraty: ['HTTP-GET f[]=']  + ( rq get-lisitra: ['f[]'] ), andalana-vaovao. # GET
Vokatra soraty: ['HTTP-POST e[]='] + ( rq post-lisitra: ['e[]'] ), andalana-vaovao. # GET
Vokatra soraty: ['HTTP-POST c=']   + ( rq post: ['c'] ), andalana-vaovao. # GET
Vokatra soraty: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), andalana-vaovao. # GET
