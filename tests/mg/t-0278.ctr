>> To-Do := Zavatra vaovao.

To-Do rehefa: ['vaovao'] ataovy: {
	azy list := Lisitra vaovao.
}.

To-Do rehefa: ['nieuw'] ataovy: {
	azy list := Lisitra vaovao.
}.

To-Do rehefa: ['+'] ataovy: { :task
	azy list ampio-any-amin-ny-farany: task.
}.

To-Do rehefa: ['number of tasks?'] ataovy: { <-  azy list isan-javatra.
}.

>> todos := 
	To-Do vaovao 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Vokatra soraty: ['You have $ tasks to do'] $ todos number of tasks?.
