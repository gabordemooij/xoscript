>> Greeter := Objeto crear.
Greeter al: ['make'] hacer: {
	>> gr := Objeto crear.
	gr al: ['setName:'] hacer: { :aname
		mi nombre := aname.
	}.
	gr al: ['greet'] hacer: {
		Salida escribir: mi nombre.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a crear.
c setName: ['THREE'].
c greet.
>> d := a crear.
d setName: ['FOUR'].
d greet.
c greet.
