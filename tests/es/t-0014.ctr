>> Saludador := Objeto crear.
Saludador al: ['fabricar'] hacer: {
	>> gr := Objeto crear.
	gr al: ['setName:'] hacer: { :unNombre
		mi nombre := unNombre.
	}.
	gr al: ['saludar'] hacer: {
		Salida escribir: mi nombre.
	}. <- gr.
}.
>> a := Saludador fabricar.
>> b := Saludador fabricar.
a setName: ['UNO'].
b setName: ['DOS'].
a saludar.
b saludar.
>> c := a crear.
c setName: ['TRES'].
c saludar.
>> d := a crear.
d setName: ['CUATRO'].
d saludar.
c saludar.
