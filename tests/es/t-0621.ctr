>> phrases := Lista crear
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases cada: { :_ :phrase 
	>> e := Server codificar-base64: phrase.
	>> d := Server decodificar-base64: e.
	Salida escribir: (
		message copiar ~encoded: e, ~decoded: d
	), detener.
}.
