>> frases := Lista crear
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> aviso := ['Phrase: ~decoded base64: ~encoded'].
	
frases cada: { :_ :frase 
	>> e := Server codificar-base64: frase.
	>> d := Server decodificar-base64: e.
	Salida escribir: (
		aviso copiar ~encoded: e, ~decoded: d
	), detener.
}.
