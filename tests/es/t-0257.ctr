
>> Saludador := Objeto crear.
Saludador al: ['crear'] hacer: {
	mi nombre := ['?'].
}.
Saludador al: ['name:'] hacer: { :nombre
	mi nombre := nombre.
}.
Saludador al: ['saludar'] hacer: {
	Salida escribir: (['hello[you]'] [you]: mi nombre).
}.
>> amigo := Saludador crear.
amigo name: ['1'].
amigo saludar.
