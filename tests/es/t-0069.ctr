

Texto al: ['html'] hacer: { <- (
		yo
		reemplazar: ['&'] con: ['&amp;'],
		reemplazar: ['<'] con: ['&lt;'],
		reemplazar: ['>'] con: ['&gt;'],
		reemplazar: ['"'] con: ['&quot;']
	).
}.


Salida escribir: ([' left trimmed '] recortar) + [' '] + ( ['and right trimmed'] recortar) + ['!'], detener.
Salida escribir: ['<html>"html & entities"</html>'] html.
