
Número aprender: ['plus:'] significa: ['+'].
Número al: ['+'] hacer: { :x
	>> rate := 1.
	>> currency := x calificador.
	(currency = ['euros']) verdadero: {
		rate := 2.
	}. <- (yo plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars calificar: ['dollars'].
euros calificar: ['euros'].
>> money := dollars + euros.
Salida escribir: money, detener.
