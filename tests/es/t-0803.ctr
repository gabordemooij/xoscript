#...
>> elim := con1 consultar: ['DELETE FROM book WHERE id > 0'].
{  elim ejecutar. con1 confirmar. } capturar: { :e con1 revertir.  }, empezar.

>> inserción := con1 consultar: ['INSERT INTO book (id) VALUES(null)'].
inserción ejecutar.

>> contar := con1 consultar: ['SELECT COUNT(*) AS num FROM book'].
contar extraer: { :fila Salida escribir: fila num, detener. }.

# no aparece
# inserción no confirmada en la conexión 1
>> contar := con2 consultar: ['SELECT COUNT(*) AS num FROM book'].
contar extraer: { :fila Salida escribir: fila num, detener. }.
