# los saltos de línea en los valores no deben crear cabeceras extra
Server iniciar.
Programa utilizar: ['../../../src/xo/es/webtools.xo'].
Programa utilizar: ['../../../src/xo/es/mailtools.xo'].

>> cabezera := Cabezera-HTTP crear clave: ['Location'] valor: ['/ok\r\nX-Injected: yes'].
Salida escribir: cabezera.

>> web := Documento-Web crear.
web ir-a: ['/ok\r\nX-Injected: yes'].
Salida escribir: ['\n'], detener.

>> correo := Email crear.
correo destinatario: (Lista crear ; ['a@example.invalid\r\nX-To: yes']).
correo cc: (Lista crear ; ['b@example.invalid\r\nX-Cc: yes']).
correo bcc: (Lista crear ; ['c@example.invalid\r\nX-Bcc: yes']).
correo remitente: ['d@example.invalid\r\nX-From: yes'] nombre: ['site\r\nX-Name: yes'].
correo asunto: ['hello\r\nX-Subject: yes'].
correo cuerpo: ['line1\r\nline2'].
Salida escribir: correo generar.

>> html := HTML-Email crear.
html destinatario: (Lista crear ; ['a@example.invalid\r\nX-To: yes']).
html remitente: ['d@example.invalid'] nombre: ['sitio'].
html asunto: ['hello\r\nX-Subject: yes'].
html cuerpo: ['body'].
Salida escribir: ( html generar contiene: ['\nX-'] ), detener.
Salida escribir: ( html generar contiene: ['X-To: yes'] ), detener.
