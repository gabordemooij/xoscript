

>> g  := Server crear.
>> v  := Contenedor-seguro crear.
>> ok := 0.

>> secretos := Lista crear ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> claves-acceso := secretos copiar.
claves-acceso cada: { :i :p
	secretos cada: { :n :s
		{
			>> cifrado := v cifrar: s clave: p.
			>> descifrado := v descifrar: cifrado clave: p.
			(descifrado = s) verdadero: {
				ok añadir: 1.
			}, otro: {
				Salida escribir: ['fallo al cifrar/descifrar: '], detener.
				Salida escribir: s, detener.
				Salida escribir: ['cifrado: '] + cifrado, detener.
				Salida escribir: ['descifrado: '] + cifrado, detener.
				Programa finalizar.
			}.
		} capturar: { :err
			(s = [''] o: p = ['']) verdadero: {
				ok añadir: 1.
			}, otro: {
				Salida escribir: err, detener.
				Programa finalizar.
			}.
		}, empezar.
	}.
}.

Salida escribir: ( ok + [' cifrados de bóveda probados.'] ), detener.