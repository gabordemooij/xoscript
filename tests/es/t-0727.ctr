Server init.
>> f := Formato crear: ['%d'].
>> a := Blob crear: 4.
a bytes: ( Lista crear ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob crear: 4.
b bytes: ( Lista crear ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a desde: 0 longitud: 3, cada: { :i :byte
	Salida escribir: ( f aplicar-a-entero: byte ) , detener.
}.
a ^ b.
a desde: 0 longitud: 3, cada: { :i :byte
	Salida escribir: ( f aplicar-a-entero: byte ) , detener.
}.
a ^ b.
a desde: 0 longitud: 3, cada: { :i :byte
	Salida escribir: ( f aplicar-a-entero: byte ) , detener.
}.
a liberar.
b liberar.

{ a ^ Objeto. } capturar: { :e Salida escribir: e, detener. }, empezar.
