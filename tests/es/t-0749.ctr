Salida escribir: ['Test object'], detener.
>> a := Objeto crear. 

a al: ['item:'] hacer: { :booleano
	mi booleano := booleano. 
}.

a al: ['item'] hacer: { <- mi booleano.
}.

a item: Falso.

Salida escribir: a item, detener.

>> old-bool-address := a item prototipo dirección-de-memoria.
a save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RELOADING SNAP:'], detener.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b item prototipo dirección-de-memoria = old-bool-address) verdadero: {
	Salida escribir: ['Object link re-attached.'], detener.
}.

Salida escribir: b item, detener.
