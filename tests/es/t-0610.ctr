
>> Rectángulo := Objeto crear.

Rectángulo al: ['área'] hacer: {
	<- mi longitud * mi anchura.
}.

Rectángulo al: ['length:'] hacer: { :longitud
	mi longitud := longitud.
}.

Rectángulo al: ['width:'] hacer: { :anchura
	mi anchura := anchura.
}.

Rectángulo al: ['crear'] hacer: {
	# esto no producirá un bucle infinito
	>> rectángulo := yo crear.
	rectángulo length: 0, width: 0.
	<- rectángulo.
}.

>> a := Rectángulo crear.
Salida escribir: a área, detener. #0

>> b := Rectángulo crear length: 2, width: 3.
Salida escribir: b área, detener. #6

