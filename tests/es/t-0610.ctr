
>> Rectangle := Objeto crear.

Rectangle al: ['area'] hacer: { <- mi longitud * mi width.
}.

Rectangle al: ['length:'] hacer: { :longitud
	mi longitud := longitud.
}.

Rectangle al: ['width:'] hacer: { :width
	mi width := width.
}.

Rectangle al: ['crear'] hacer: {
	# this will not result into an infinite loop
	>> rectangle := yo crear.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle crear.
Salida escribir: a area, detener. #0

>> b := Rectangle crear length: 2, width: 3.
Salida escribir: b area, detener. #6

