# formato de cookie de sesión, tipo de contenido json, solo protocolos web, svg mostrado en línea
Server iniciar.
Programa utilizar: ['../../../src/xo/es/webtools.xo'].

>> Petición-Falsa := Objeto crear.
Petición-Falsa al: ['value:'] hacer: { :valor
	mi valor := valor.
}.
Petición-Falsa al: ['cookie:'] hacer: { :nombre
	<- mi valor.
}.

>> Sesión-Prueba := Ficherotemporal-sesión crear.
Sesión-Prueba al: ['cargar'] hacer: {
	<- Diccionario crear.
}.
Sesión-Prueba al: ['id-de-sesión'] hacer: {
	<- mi id.
}.

>> cookies := Lista crear
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

cookies cada: { :i :cookie
	>> solicitud := Petición-Falsa crear.
	solicitud value: cookie.
	>> gestor := Sesión-Prueba crear.
	>> web := Documento-Web crear.
	web solicitud: solicitud.
	web controlador-sesión: gestor.
	web empezar-sesión.
	Salida escribir: ( gestor id-de-sesión = cookie ), detener.
}.

>> web := Documento-Web crear.
web json: (Diccionario crear poner: ['b'] en: ['a']).
Salida escribir: ['\n'], detener.

{ Red obtener: ['file:///etc/hostname']. } capturar: { :e
	Salida escribir: e, detener.
}, empezar.

>> svg := Archivo crear: ['/tmp/test0814.svg'].
svg escribir: ['<svg xmlns="x"></svg>'].
Salida detener.
Server acceso-directo: ['test0814.svg'] prefijo: ['/tmp/'].
svg eliminar.
