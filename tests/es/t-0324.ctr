>> Animal := Objeto crear.
>> Fábrica := Objeto crear.

Animal al: ['crear'] hacer: {
	>> animal := yo crear.
	animal sound: ['?']. <- animal.
}.

Animal al: ['sound:'] hacer: { :s
	mi sonido := s.
}.

Animal al: ['sonido'] hacer: { <- mi sonido.
}.

>> Perro := Objeto crear.
>> Gato := Objeto crear.

Perro al: ['crear'] hacer: { <- Animal crear sound: ['woof!'].
}.

Gato al: ['crear'] hacer: { <- Animal crear sound: ['meow!'].
}.

Salida escribir: Perro crear sonido, detener.
Salida escribir: Gato crear sonido, detener.

Fábrica al: ['mezclar:y:'] hacer: { :bestia1 :bestia2 <- Animal crear sound: (
		( bestia1 sonido desde: 0 longitud: 2 ) +
		( bestia2 sonido desde: 2 longitud: 5 )
	).
}.

Salida escribir: (Fábrica mezclar: Perro crear y: Gato crear) sonido, detener.
