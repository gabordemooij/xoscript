>> Animal := Objeto crear.
>> Factory := Objeto crear.

Animal al: ['crear'] hacer: {
	>> animal := yo crear.
	animal sound: ['?']. <- animal.
}.

Animal al: ['sound:'] hacer: { :s
	mi sound := s.
}.

Animal al: ['sound'] hacer: { <- mi sound.
}.

>> Dog := Objeto crear.
>> Cat := Objeto crear.

Dog al: ['crear'] hacer: { <- Animal crear sound: ['woof!'].
}.

Cat al: ['crear'] hacer: { <- Animal crear sound: ['meow!'].
}.

Salida escribir: Dog crear sound, detener.
Salida escribir: Cat crear sound, detener.

Factory al: ['mix:and:'] hacer: { :beast1 :beast2 <- Animal crear sound: (
		( beast1 sound desde: 0 longitud: 2 ) +
		( beast2 sound desde: 2 longitud: 5 )
	).
}.

Salida escribir: (Factory mix: Dog crear and: Cat crear) sound, detener.
