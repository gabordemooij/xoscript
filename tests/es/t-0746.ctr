Salida escribir: ['Test object'], detener.
>> a := Objeto crear. 

a al: ['item:'] hacer: { :dict
	mi dict := dict. 
}.

a al: ['item'] hacer: { <- mi dict.
}.

a item: (
Diccionario crear
	hello: ['world'],
	world: (Diccionario crear poner: ['a'] en: ['b'])).

Salida escribir: a item, detener.

>> old-dict-address := a item prototipo dirección-de-memoria.
a save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RELOADING SNAP:'], detener.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b item prototipo dirección-de-memoria = old-dict-address) verdadero: {
	Salida escribir: ['Object link re-attached.'], detener.
}.

Salida escribir: b item, detener.
