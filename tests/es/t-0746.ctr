Salida escribir: ['Objeto de prueba'], detener.
>> a := Objeto crear. 

a al: ['item:'] hacer: { :dicc
	mi dicc := dicc. 
}.

a al: ['artículo'] hacer: {
	<- mi dicc.
}.

a item: (
Diccionario crear
	hello: ['world'],
	world: (Diccionario crear poner: ['a'] en: ['b'])).

Salida escribir: a artículo, detener.

>> antigua-dirección-dicc := a artículo prototipo dirección-de-memoria.
a save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RECARGANDO SNAP:'], detener.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b artículo prototipo dirección-de-memoria = antigua-dirección-dicc) verdadero: {
	Salida escribir: ['Enlace de objeto reconectado.'], detener.
}.

Salida escribir: b artículo, detener.
