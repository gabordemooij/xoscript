>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objeto crear.
⚄ al: ['drawFrom:length:'] hacer: { :pool :contar
	
	>> result := [''].
	
	{
		>> index := Número random % (pool longitud).
		result adjuntar: ( pool caracter: (index + 1) ).
		
	} × contar. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? longitud.
Salida escribir: (['x↵'] x random longitud).
Salida escribir: (['y↵'] y ?? longitud).

