>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objeto crear.
⚄ al: ['sacarDe:cantidad:'] hacer: { :bombo :contar
	
	>> res := [''].
	
	{
		>> índice := Número aleatorio % (bombo longitud).
		res adjuntar: ( bombo caracter: (índice + 1) ).
		
	} × contar. <- res.
}.

>> aleatorio := ⚄ sacarDe: ?? cantidad: ?? longitud.
Salida escribir: (['x↵'] x aleatorio longitud).
Salida escribir: (['y↵'] y ?? longitud).

