Texto al: ['evaluar'] hacer: {
	>> código := Archivo crear: ['/tmp/eval.ctr'].
	código escribir: (yo texto + ['.']).
	Programa utilizar: ['/tmp/eval.ctr'].
}.

>> a := Lista ← 1 ; 2 ; 3.
>> b := (a texto).

Salida escribir: b, detener. 
(['b := '] + b) evaluar.

Salida escribir: b ? 2, detener. 

Salida escribir: (( Lista ← 1 ; 2 ; 3 )), detener. 

Salida escribir: ((Diccionario crear) poner: 1 en: 2), detener. 

>> x := ( (Lista ← 1 ; ( Lista ← 9 ) ; Verdadero ) ) texto.
Salida escribir: x, detener. 
(['x := '] + x) evaluar.

Salida escribir: x ? 1 ? 0, detener. 

>> y := (Diccionario crear) poner: (Lista ← 1) en: (Lista ← 2).
Salida escribir: y, detener. 

(['y := '] + y) texto evaluar.

Salida escribir: (y en: (Lista ← 2) texto ), detener.

Salida escribir: (Lista crear), detener. 
Salida escribir: (Diccionario crear), detener. 
