# decodificar de utf16le/be o utf32le/be a utf8
Server init.
>> utf16 := Blob crear: 8, bytes: (
	Lista crear ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Salida escribir: ( utf16 decodificar: ['utf16le'] ), detener.

utf16 liberar.
>> utf32 := Blob crear: 13, bytes: (
	Lista crear ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Salida escribir: ( utf32 decodificar: ['utf32be'] ), detener.
utf32 liberar.