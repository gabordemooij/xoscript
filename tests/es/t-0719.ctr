Server init.
>> fmt := Formato crear: ['%#3x'].

>> blob := Blob crear: 4.
blob bytes: ( 
	Lista crear ; 0 ; 1 ; 2 ; 3
).

>> file := Archivo crear: ['/tmp/blob'].
file blob: blob.
blob liberar.

>> leer := file blob.
leer 
desde: 0 
longitud: 4, 
hacer cada: { :i :b 
	Salida
	escribir: (fmt aplicar-a-entero: b),
	detener.
}.
leer liberar.
