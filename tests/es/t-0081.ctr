>> mapa1 := Diccionario crear.
>> clave1 := Lista crear.
>> clave2 := Lista crear.

mapa1
	poner: ['hello'] en: clave1,
	poner: ['world'] en: clave2.


Salida
	escribir: ['Map #1 contains: '] + (mapa1 en: clave1),
	escribir: [' y '] + (mapa1 en: clave2), detener.

>> ArregloConClaves := Lista crear.
ArregloConClaves al: ['aTexto'] hacer: { <- (yo contar) aTexto.
}.

>> map2 := Diccionario crear.
clave1 := ArregloConClaves crear.
clave2 := ArregloConClaves crear.

clave1 adjuntar: 1.

map2
	poner: ['hello'] en: clave1,
	poner: ['world'] en: clave2.

Salida
	escribir: ['Map #2 contains: '] + (map2 en: clave1),
	escribir: [' y '] + (map2 en: clave2), detener.
