>> a := 3.
>> b := a copiar.
a restar: 1.
Salida escribir: [' a = '] + a.
Salida escribir: [' b = '] + b.
a := 3.
b := a + 4.
Salida escribir: [' a = '] + a.
Salida escribir: [' b = '] + b.
>> x := 3.
>> y := x copiar.
x añadir: 10.
y restar: 1.
Salida escribir: [' x = '] + x.
Salida escribir: [' y = '] + y.
>> q := Objeto crear.
q al: ['setProperty:'] hacer: { :x
	mi prop := x.
}.
q al: ['getProperty'] hacer: { <- mi prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Salida escribir: [' p = '] + (p getProperty).
