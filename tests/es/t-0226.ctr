# Probar variantes ASCII

# Números

Salida escribir: (2 !=: 3), detener.
Salida escribir: (2 <=: 2), detener.
Salida escribir: (2 >=: 2), detener.

# Textos

Salida escribir: (['b'] >=: ['a']), detener.
Salida escribir: (['b'] !=: ['a']), detener.
Salida escribir: (['b'] <=: ['c']), detener.

# Booleanos

Salida escribir: (Verdadero !=: Falso), detener.

# Objetos

Salida escribir: (Objeto crear !=: Objeto crear), detener.

# símbolo de lista ASCII <-:

Salida escribir: (Lista <<: 1, ; 2 ; 3) contar = 3, detener.

