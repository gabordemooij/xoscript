# test list operations


>> cakes := Lista ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes reemplazar: 1 longitud: 2 con: ( Lista ← ['cinnamon'] ; ['pineapple'] ).
Salida escribir: (buy unir: [',']), detener.


>> buy := cakes reemplazar: 1 longitud: 12 con: ( Lista ← ['cinnamon'] ; ['pineapple'] ).
Salida escribir: (buy unir: [',']), detener.


>> buy := cakes reemplazar: 2 longitud: 10 con: ( Lista crear ).
Salida escribir: (buy unir: [',']), detener.


>> buy := cakes reemplazar: 0 longitud: 1 con: ( Lista crear ).
Salida escribir: (buy unir: [',']), detener.


>> buy := cakes reemplazar: ['0'] longitud: ['1'] con: ['x'].
Salida escribir: (buy unir: [',']), detener.
