# prueba de operaciones con listas


>> pasteles := Lista ←
	['manzana'] ;
	['baya'] ;
	['choco'] ;
	['queso'].


>> comprar := pasteles reemplazar: 1 longitud: 2 con: ( Lista ← ['canela'] ; ['piña'] ).
Salida escribir: (comprar unir: [',']), detener.


>> comprar := pasteles reemplazar: 1 longitud: 12 con: ( Lista ← ['canela'] ; ['piña'] ).
Salida escribir: (comprar unir: [',']), detener.


>> comprar := pasteles reemplazar: 2 longitud: 10 con: ( Lista crear ).
Salida escribir: (comprar unir: [',']), detener.


>> comprar := pasteles reemplazar: 0 longitud: 1 con: ( Lista crear ).
Salida escribir: (comprar unir: [',']), detener.


>> comprar := pasteles reemplazar: ['0'] longitud: ['1'] con: ['x'].
Salida escribir: (comprar unir: [',']), detener.
