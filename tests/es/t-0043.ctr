>> repetidor := Objeto crear.
repetidor al: ['responder:'] hacer: { :qué
	Salida escribir: qué + [' '].
}.
repetidor al: ['responder:y:'] hacer: { :qué :say
	Salida escribir: qué, escribir: say + [' '].
}.
repetidor al: ['responder:y:y:'] hacer: { :qué :say :más
	Salida escribir: qué, escribir: say, escribir: más.
}.
repetidor repetir.
repetidor everything: ['Yo digo.'].
repetidor and: ['I '] everything: ['hago.'].
