# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Contenedor-seguro 
	hash-contraseña: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Contenedor-seguro 
	verificar-hash: hash contraseña: a1.
	# fail 
>> b := Contenedor-seguro
	verificar-hash: hash contraseña: a2.
	# ok!

Salida escribir: a, detener.
Salida escribir: b, detener.

