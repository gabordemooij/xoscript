# Hash de contraseñas
Server init.

# El usuario establece una contraseña
>> contr := ['pass123'].

# Se guarda así
>> hash := Contenedor-seguro 
	hash-contraseña: contr.

# Después, el usuario inicia sesión
# Intento 1
>> a1 := ['abcd123'].
# Intento 2
>> a2 := ['pass123'].

# Verificar
>> a := Contenedor-seguro 
	verificar-hash: hash contraseña: a1.
	# falla 
>> b := Contenedor-seguro
	verificar-hash: hash contraseña: a2.
	# ¡ok!

Salida escribir: a, detener.
Salida escribir: b, detener.

