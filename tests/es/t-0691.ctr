Server init.

# devolver algo que no es texto desde coincidir:ejecutar: debería funcionar
>> subject := ['abc'].
>> patrón := Patrón crear: ['([ac])'].
>> res  := patrón coincidir: subject ejecutar: { :m :x
	Salida escribir: m, detener.
	Salida escribir: x, detener.
	<- Nulo.
}.
Salida escribir: res, detener.