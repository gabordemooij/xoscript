>> x := [' hallo '].

>> y := x mayúsculas.
Salida escribir: x, detener.
Salida escribir: (x es: y), detener.

>> y := x minúsculas.
Salida escribir: x, detener.
Salida escribir: (x es: y), detener.

>> y := x recortar.
Salida escribir: x, detener.
Salida escribir: (x es: y), detener.

>> y := x saltar: 1.
Salida escribir: x, detener.
Salida escribir: (x es: y), detener.

>> y := x desde: 1 longitud: 2.
Salida escribir: x, detener.
Salida escribir: (x es: y), detener.