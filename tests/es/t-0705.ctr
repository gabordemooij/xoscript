

>> obj := Objeto crear.

obj al: ['greet'] hacer: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj al: ['task'] hacer: {
	mi property := 123.
	{
		# try binds self/own to object instead of block
		Salida escribir: yo greet.
		Salida escribir: mi property.
		1 / 0.
	} capturar: {
		Salida escribir: yo greet.
		Salida escribir: mi property.
		Salida escribir: ['ok'].
	}, intentar.
}.

obj task.