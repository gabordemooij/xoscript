Salida escribir: ['Objeto de prueba'], detener.
>> a := Objeto crear. 

a al: ['item:'] hacer: { :booleano
	mi booleano := booleano. 
}.

a al: ['artículo'] hacer: {
	<- mi booleano.
}.

a item: Verdadero.

Salida escribir: a artículo, detener.

>> antigua-dirección-bool := a artículo prototipo dirección-de-memoria.
a save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RECARGANDO SNAP:'], detener.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b artículo prototipo dirección-de-memoria = antigua-dirección-bool) verdadero: {
	Salida escribir: ['Enlace de objeto reconectado.'], detener.
}.

Salida escribir: b artículo, detener.
