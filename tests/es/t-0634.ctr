# Programa escapar-sistema produce sintaxis de shell posix canónica
# compatible con: bash/dash, zsh, ksh

>> c := Programa escapar-sistema: ['abc'].
Salida escribir: c, detener.
Salida escribir: ( Programa sistema: ['echo '] + c ), detener.

c := Programa escapar-sistema: ['a'b'c'].
Salida escribir: c, detener.
Salida escribir: ( Programa sistema: ['echo '] + c ), detener.

c := Programa escapar-sistema: ['a\'c'].
Salida escribir: c, detener.
Salida escribir: ( Programa sistema: ['echo '] + c ), detener.