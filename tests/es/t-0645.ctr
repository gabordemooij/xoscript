Server init.
Salida escribir: ['Prueba de fecha en base de datos'], detener.

>> bd := Maria-DB crear host: ['localhost'],
	usuario: ['xo'], 
	contraseña: ['pass123'],
	nombre-base-datos: ['xobase'],
	conectar.

>> consulta :=
bd consultar: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
extraer: { :fila
	Salida escribir: fila datetest, detener.
}.
