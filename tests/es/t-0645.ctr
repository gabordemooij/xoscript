Server init.
Salida escribir: ['Database date test'], detener.

>> db := Maria-DB crear host: ['localhost'],
	usuario: ['xo'], 
	contraseña: ['pass123'],
	nombre-base-datos: ['xobase'],
	conectar.

>> consulta :=
db consultar: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
extraer: { :row
	Salida escribir: row datetest, detener.
}.
