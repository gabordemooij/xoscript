>> memoriaUsada4 := 0.

Programa orden: 0.

>> txt := ['Word Salad'].
Salida escribir: ( txt copiar desde: 5 longitud: 5 ).
Salida escribir: ( txt copiar saltar: 5, recortar ), detener.

Programa limpiar-memoria.

memoriaUsada1 := (Programa memoria ? 0).


