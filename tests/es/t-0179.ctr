

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa orden: 0.

>> txt := ['Word Salad'].
Salida escribir: ( txt copiar desde: 5 longitud: 5 ).
Salida escribir: ( txt copiar saltar: 5, recortar ), detener.

Programa limpiar-memoria.

usedMemory1 := (Programa memoria ? 0).


txt := ['Word Salad'].
