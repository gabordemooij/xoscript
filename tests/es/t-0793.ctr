Server init.

>> DB := Maria-DB crear host: ['localhost'],
	usuario: ['xo'],
	contraseña: ['pass123'],
	nombre-base-datos: ['xobase'],
	conectar.

{
	DB consultar:
	['DROP TABLE movies'],
	ejecutar.
} capturar: { Nulo. }, empezar.

DB consultar:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
ejecutar.

DB consultar: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parámetros: ( Lista crear ; ['Halloween'] ),
ejecutar.

DB consultar: ['SELECT * FROM movies'],
extraer: { :movie
	Salida escribir: movie title, detener.
}.

