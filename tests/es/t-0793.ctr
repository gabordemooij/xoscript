Server init.

>> BD := Maria-DB crear host: ['localhost'],
	usuario: ['xo'],
	contraseña: ['pass123'],
	nombre-base-datos: ['xobase'],
	conectar.

{
	BD consultar:
	['DROP TABLE movies'],
	ejecutar.
} capturar: { Nulo. }, empezar.

BD consultar:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
ejecutar.

BD consultar: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parámetros: ( Lista crear ; ['Halloween'] ),
ejecutar.

BD consultar: ['SELECT * FROM movies'],
extraer: { :película
	Salida escribir: película title, detener.
}.

