Lista al: ['suma'] hacer: {
	>> total := 0.
	yo cada: { :índice :elemento
		total añadir: elemento.
	}. <- total.
}.

>> a := Verdadero.



a al: ['texto'] hacer: {
	>> contestación := Nulo.
	( yo = Verdadero ) verdadero: {
		contestación := ['Sip'].
	}, otro: {
		contestación := ['Qué va'].
	}. <- contestación.
}.

a al: ['número'] hacer: {
	>> contestación := Nulo.
	( yo = Verdadero ) verdadero: {
		contestación := 10.
	}, otro: {
		contestación := 20.
	}. <- contestación.
}.

>> b := 666.

b al: ['texto'] hacer: { <- ['Diablo'].
}.

b al: ['booleano'] hacer: { <- Falso.
}.


Salida escribir: a, detener.  
Salida escribir: (90 + a), detener. 
Salida escribir: b, detener. 
Salida escribir: (Verdadero y: b), detener.

a := Lista ← ['hello'] ; ['world'] ; Verdadero ; Nulo ; 666. 
a := a + ( Lista ← 1 ).
Salida escribir: a, detener.
Salida escribir: ((Diccionario crear) poner: Nulo en: Nulo), detener.
Salida escribir: a suma, detener. 


{
	a al: ['texto'] hacer: { <- Nulo. }.
	a := [''] + a.
} capturar: { :fallo
	Salida escribir: ['Error anotado: '] + fallo, detener.
}, empezar.



{
	a al: ['número'] hacer: { <- Nulo. }.
	a := 3 × a.
} capturar: { :fallo
	Salida escribir: ['Error anotado: '] + fallo, detener.
}, empezar.


{
	a al: ['booleano'] hacer: { <- Nulo. }.
	a := Verdadero y: a. 
} capturar: { :fallo
	Salida escribir: ['Error anotado: '] + fallo, detener.
}, empezar.





