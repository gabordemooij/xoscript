Lista al: ['sum'] hacer: {
	>> total := 0.
	yo cada: { :index :element
		total añadir: element.
	}. <- total.
}.

>> a := Verdadero.



a al: ['texto'] hacer: {
	>> answer := Nulo.
	( yo = Verdadero ) verdadero: {
		answer := ['Yep'].
	}, otro: {
		answer := ['Nope'].
	}. <- answer.
}.

a al: ['número'] hacer: {
	>> answer := Nulo.
	( yo = Verdadero ) verdadero: {
		answer := 10.
	}, otro: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b al: ['texto'] hacer: { <- ['Devil'].
}.

b al: ['booleano'] hacer: { <- Falso.
}.


Salida escribir: a, detener.  
Salida escribir: (90 + a), detener. 
Salida escribir: b, detener. 
Salida escribir: (Verdadero y: b), detener.

a := Lista ← ['hello'] ; ['world'] ; Verdadero ; Nulo ; 666. 
a := a + ( Lista ← 1 ).
Salida escribir: a, detener.
Salida escribir: ((Diccionario crear) poner: Nulo en: Nulo), detener.
Salida escribir: a sum, detener. 


{
	a al: ['texto'] hacer: { <- Nulo. }.
	a := [''] + a.
} capturar: { :error
	Salida escribir: ['Error noted: '] + error, detener.
}, empezar.



{
	a al: ['número'] hacer: { <- Nulo. }.
	a := 3 × a.
} capturar: { :error
	Salida escribir: ['Error noted: '] + error, detener.
}, empezar.


