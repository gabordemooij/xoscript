

Lista al: ['suma'] hacer: {
	>> total := 0.
	yo cada: { :índice :elemento
		total añadir: elemento.
	}. <- total.
}.

Lista al: ['producto'] hacer: {
	>> total := 1.
	yo cada: { :índice :elemento
		total multiplicar: elemento.
	}. <- total.
}.

>> memoriaUsada1 := 0.
>> memoriaUsada2 := 0.
>> memoriaUsada3 := 0.
>> memoriaUsada4 := 0.

Programa orden: 0.

{

>> a := Lista ← ['hello'] ; ['world'] ; Verdadero ; Nulo ; 666.
a := a + ( Lista ← 1 ).
Salida escribir: ( ['suma: '] + ( a suma ) ), detener.
Salida escribir: ( ['mín: '] + ( a mínimo ) ), detener.
Salida escribir: ( ['máx: '] + ( a máximo ) ), detener.
Salida escribir: ( ['3.º: '] + ( a ? 2 ) ), detener.
Salida escribir: ( ['prod: '] + ( a producto ) ), detener.
a ordenar: { :a :b <- (b - a). }.
a cada: { :i :e Salida escribir: ( i - 0 ), detener. }.

} empezar.

Programa limpiar-memoria.
memoriaUsada1 := (Programa memoria ? 0).


{

>> a := Lista ← ['hello'] ; ['world'] ; Verdadero ; Nulo ; 666.
a := a + ( Lista ← 1 ).
Salida escribir: ( ['suma: '] + ( a suma ) ), detener.
Salida escribir: ( ['mín: '] + ( a mínimo ) ), detener.
Salida escribir: ( ['máx: '] + ( a máximo ) ), detener.
Salida escribir: ( ['3.º: '] + ( a ? 2 ) ), detener.
Salida escribir: ( ['prod: '] + ( a producto ) ), detener.
a ordenar: { :a :b <- (b - a). }.
a cada: { :i :e Salida escribir: ( i - 0 ), detener. }.

} empezar.



Programa limpiar-memoria.
memoriaUsada2 := (Programa memoria ? 0).


{

>> a := Lista ← ['hello'] ; ['world'] ; Verdadero ; Nulo ; 666.
a := a + ( Lista ← 1 ).
Salida escribir: ( ['suma: '] + ( a suma ) ), detener.
Salida escribir: ( ['mín: '] + ( a mínimo ) ), detener.
Salida escribir: ( ['máx: '] + ( a máximo ) ), detener.
Salida escribir: ( ['3.º: '] + ( a ? 2 ) ), detener.
Salida escribir: ( ['prod: '] + ( a producto ) ), detener.
a ordenar: { :a :b <- (b - a). }.
a cada: { :i :e Salida escribir: ( i - 0 ), detener. }.

} empezar.



Programa limpiar-memoria.
memoriaUsada3 := (Programa memoria ? 0).

( memoriaUsada1 = memoriaUsada2 y: memoriaUsada1 = memoriaUsada3, y: memoriaUsada2 = memoriaUsada3 ) verdadero: {
	Salida escribir: ['Aquí no hay fugas de memoria'].
}, falso: {
	Salida escribir: ['Fuga de memoria...'].
}.
