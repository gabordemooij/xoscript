

Lista al: ['sum'] hacer: {
	>> total := 0.
	yo cada: { :index :element
		total añadir: element.
	}. <- total.
}.

Lista al: ['product'] hacer: {
	>> total := 1.
	yo cada: { :index :element
		total multiplicar: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa orden: 0.

{

>> a := Lista ← ['hello'] ; ['world'] ; Verdadero ; Nulo ; 666.
a := a + ( Lista ← 1 ).
Salida escribir: ( ['sum: '] + ( a sum ) ), detener.
Salida escribir: ( ['min: '] + ( a mínimo ) ), detener.
Salida escribir: ( ['max: '] + ( a máximo ) ), detener.
Salida escribir: ( ['3rd: '] + ( a ? 2 ) ), detener.
Salida escribir: ( ['prd: '] + ( a product ) ), detener.
a ordenar: { :a :b <- (b - a). }.
a cada: { :i :e Salida escribir: ( i - 0 ), detener. }.

} empezar.

Programa limpiar-memoria.
usedMemory1 := (Programa memoria ? 0).


{

>> a := Lista ← ['hello'] ; ['world'] ; Verdadero ; Nulo ; 666.
a := a + ( Lista ← 1 ).
Salida escribir: ( ['sum: '] + ( a sum ) ), detener.
Salida escribir: ( ['min: '] + ( a mínimo ) ), detener.
Salida escribir: ( ['max: '] + ( a máximo ) ), detener.
Salida escribir: ( ['3rd: '] + ( a ? 2 ) ), detener.
Salida escribir: ( ['prd: '] + ( a product ) ), detener.
a ordenar: { :a :b <- (b - a). }.
a cada: { :i :e Salida escribir: ( i - 0 ), detener. }.

} empezar.



Programa limpiar-memoria.
usedMemory2 := (Programa memoria ? 0).


{

>> a := Lista ← ['hello'] ; ['world'] ; Verdadero ; Nulo ; 666.
a := a + ( Lista ← 1 ).
Salida escribir: ( ['sum: '] + ( a sum ) ), detener.
Salida escribir: ( ['min: '] + ( a mínimo ) ), detener.
Salida escribir: ( ['max: '] + ( a máximo ) ), detener.
Salida escribir: ( ['3rd: '] + ( a ? 2 ) ), detener.
Salida escribir: ( ['prd: '] + ( a product ) ), detener.
a ordenar: { :a :b <- (b - a). }.
a cada: { :i :e Salida escribir: ( i - 0 ), detener. }.

} empezar.



Programa limpiar-memoria.
usedMemory3 := (Programa memoria ? 0).

( usedMemory1 = usedMemory2 y: usedMemory1 = usedMemory3, y: usedMemory2 = usedMemory3 ) verdadero: {
	Salida escribir: ['No memory leaks here'].
}, falso: {
	Salida escribir: ['Leaking memory...'].
}.
