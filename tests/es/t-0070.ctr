>> números := ['1,2,3'] partir: [','].
Salida escribir: ['Tengo: '] + números contar + [' números.'],detener.
{ :i Salida escribir: ['number #'] + i + [':'] + (números posición: i), detener.} × 3.
>> bebidas := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
bebidas := bebidas partir: [' Or '].
Salida escribir: ['Servimos'], detener.
{ :i Salida escribir: ['->'] + (bebidas posición: i), detener. } × (bebidas contar).
Salida escribir: (bebidas unir: [',']), detener.
Salida escribir: (números unir: ['||']).
