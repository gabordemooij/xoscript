>> numbers := ['1,2,3'] partir: [','].
Salida escribir: ['I got: '] + numbers contar + [' numbers.'],detener.
{ :i Salida escribir: ['number #'] + i + [':'] + (numbers posición: i), detener.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages partir: [' Or '].
Salida escribir: ['We serve'], detener.
{ :i Salida escribir: ['->'] + (beverages posición: i), detener. } × (beverages contar).
Salida escribir: (beverages unir: [',']), detener.
Salida escribir: (numbers unir: ['||']).
