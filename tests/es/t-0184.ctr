

>> memoriaUsada1 := 0.
>> memoriaUsada2 := 0.
>> memoriaUsada3 := 0.
>> memoriaUsada4 := 0.

Programa orden: 0.

Número al: ['addNum:'] hacer: { :x
	yo añadir: x.
}.

Número al: ['subtractNum:'] hacer: { :x
	yo restar: x.
}.

Número al: ['multiplyBy:'] hacer: { :x
	yo multiplicar: x.
}.

Número al: ['divideBy:'] hacer: { :x
	yo dividir: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 elevado-a: 8).  
a := a + (2 elevado-a: -1). 
a := a + (49 raiz-cuadrada).   
a addNum: ((Lista ← 0 ; 1) máximo).          
a addNum: ((Lista ← 2 ; 3) mínimo).
Salida escribir: a.

Programa limpiar-memoria.

memoriaUsada1 := (Programa memoria ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 elevado-a: 8).  
a := a + (2 elevado-a: -1). 
a := a + (49 raiz-cuadrada).   
a addNum: ((Lista ← 0 ; 1) máximo).          
a addNum: ((Lista ← 2 ; 3) mínimo).
Salida escribir: a.

Programa limpiar-memoria.
memoriaUsada2 := (Programa memoria ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 elevado-a: 8).  
a := a + (2 elevado-a: -1). 
a := a + (49 raiz-cuadrada).   
a addNum: ((Lista ← 0 ; 1) máximo).          
a addNum: ((Lista ← 2 ; 3) mínimo).
Salida escribir: a.

Programa limpiar-memoria.
memoriaUsada3 := (Programa memoria ? 0).



( memoriaUsada1 = memoriaUsada2 y: memoriaUsada1 = memoriaUsada3, y: memoriaUsada2 = memoriaUsada3 ) verdadero: {
	Salida escribir: ['Aquí no hay fugas de memoria'].
}, falso: {
	Salida escribir: ['Fuga de memoria...'].
}.
