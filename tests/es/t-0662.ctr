>> t := Nulo.

# puede controlar la zona horaria para
# el análisis así:
Momento zona: ['CET'].
t := Momento desde: ['1981-02-03 04:05:06'].
Salida escribir: t, detener.

# ahora con la zona horaria CEST:
Momento zona: ['CEST'].
t := Momento desde: ['1981-02-03 04:05:06'].
Salida escribir: t, detener.

# error si el texto no se puede analizar
{ Momento desde: ['1900']. } capturar: { Nulo. }, empezar.
