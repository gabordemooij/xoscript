

Texto al: ['evaluate'] hacer: {
	>> código := Archivo crear: ['/tmp/eval.ctr'].
	código escribir: (yo texto + ['.']).
	Programa utilizar: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Lista ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q texto.
Salida escribir: x, detener.
>> y := Nulo.
(['y := '] + x ) evaluate.
Salida escribir: y ? 0, detener.

q := Diccionario poner: ['\[''] en: ['\['quote\']'].
x := q texto.
Salida escribir: x, detener.
y := Nulo.
(['y := '] + x ) evaluate.

>> q := (Diccionario crear) poner:['\[''] en:['\['quote\[''].
Salida escribir: y ? ['\['quote\']'], detener.
