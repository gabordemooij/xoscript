


>> vino := Objeto crear.


vino al: ['aTexto'] hacer: { <- ['merlot'].
}.

vino al: ['naarTekst'] hacer: { <- ['merlot'].
}.


vino al: ['='] hacer: { :other wine <- ( yo aTexto = other wine ).
}.

vino al: ['=='] hacer: { :other wine <- ( yo aTexto = other wine ).
}.



vino
	en-caso-de: ['cabernet'] hacer: { Salida escribir: ['¡es un Cabernet!']. },
	en-caso-de: ['syrah']    hacer: { Salida escribir: ['¡es un Syrah!'].    },
	en-caso-de: ['merlot']   hacer: { Salida escribir: ['¡es un Merlot!'].   },
	en-caso-de: ['malbec']   hacer: { Salida escribir: ['¡es un Malbec!'].   }.

Salida detener.
