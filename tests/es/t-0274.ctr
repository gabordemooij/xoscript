

Lista al: ['column:'] hacer: { :columna
	>> res := Lista crear.
	yo cada: { :índice :fila
		fila cada: { :índice :celda
			(índice = columna) verdadero: { res adjuntar: celda. }.
		}.
	}. <- res.
}.


>> a := Lista ←
	(Lista ← 1 ; 2 ; 3) ;
	(Lista ← 4 ; 5 ; 6) ;
	(Lista ← 7 ; 8 ; 9).

>> b := a column: 1.
Salida escribir: b, detener.

b := a column: 20.
Salida escribir: b, detener.

b := a column: -100.
Salida escribir: b, detener.
