

Lista al: ['column:'] hacer: { :column
	>> result := Lista crear.
	yo cada: { :index :row
		row cada: { :index :cell
			(index = column) verdadero: { result adjuntar: cell. }.
		}.
	}. <- result.
}.


>> a := Lista ←
	(Lista ← 1 ; 2 ; 3) ;
	(Lista ← 4 ; 5 ; 6) ;
	(Lista ← 7 ; 8 ; 9).

>> b := a column: 1.
Salida escribir: b, detener.

b := a column: 20.
Salida escribir: b, detener.

b := a column: -100.
Salida escribir: b, detener.
