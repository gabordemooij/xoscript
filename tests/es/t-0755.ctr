Salida escribir: ['Test object'], detener.
>> greeter := Objeto crear.
greeter al: ['name:'] hacer: { :nombre
	mi xname := nombre. 
}.
greeter al: ['greet'] hacer: {
	Salida escribir: ['Hello '] + mi xname, detener.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RELOADING SNAP:'], detener.
>> b := Objeto load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
