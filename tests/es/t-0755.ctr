Salida escribir: ['Objeto de prueba'], detener.
>> saludador := Objeto crear.
saludador al: ['name:'] hacer: { :nombre
	mi xnombre := nombre. 
}.
saludador al: ['saludar'] hacer: {
	Salida escribir: ['Hola '] + mi xnombre, detener.
}.
saludador name: ['Sherlock'].
saludador save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RECARGANDO SNAP:'], detener.
>> b := Objeto load-from: ['/tmp/a.bin'].
b saludar.
b name: ['Watson'], saludar.
