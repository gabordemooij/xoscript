
Lista al: ['suma'] hacer: {
	>> total := 0.
	yo cada: { :índice :elemento
		total añadir: elemento.
	}. <- total.
}.

>> a := Lista ← 9 ; 8 ; 7.
Salida escribir: (a suma), detener. 
>> a := Lista ← 1 ; 9.
Salida escribir: (a suma), detener. 
>> a := Lista ← ['o'] ; 2.
Salida escribir: (a suma), detener. 
Salida escribir: (Lista crear suma), detener. 
