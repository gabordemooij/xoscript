
Lista al: ['sum'] hacer: {
	>> total := 0.
	yo cada: { :index :element
		total añadir: element.
	}. <- total.
}.

>> a := Lista ← 9 ; 8 ; 7.
Salida escribir: (a sum), detener. 
>> a := Lista ← 1 ; 9.
Salida escribir: (a sum), detener. 
>> a := Lista ← ['o'] ; 2.
Salida escribir: (a sum), detener. 
Salida escribir: (Lista crear sum), detener. 
