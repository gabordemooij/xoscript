#prueba de ffi


Server init.

Programa orden: 4.

# para esta prueba hay que configurar una ruta a libc (puts)
>> nombrelib := Programa configurar: ['FFITESTLIB'].



Server vincular: (
 Lista crear ;
 nombrelib ;
 ['puts'] ;
 ( Lista crear ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s liberar.

# prueba con struct

>> a := Blob crear: 8.
a bytes: (
	Lista <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> estruct := Blob estructura: (Lista <<: ['int'], ; ['int']).

Server vincular: (
	Lista <<: ['@structtest'], ;
	['@structtest'] ;
	(Lista <<: estruct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Salida escribir: ['Prueba de suma:'] + (ffitest ffisum: a), detener.

estruct liberar-estructura.
estruct liberar.
a liberar.
