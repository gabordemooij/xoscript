{
	>> a := Lista crear.
	a adjuntar: 1.
	a adjuntar: 2.
	Salida escribir: (a unir: [',']), detener.
	a poner: 3 en: 2.
	Salida escribir: (a unir: [',']), detener.
	a poner: 4 en: 10.
	Salida escribir: (a unir: [',']), detener.
	a cortar-primero.
	a cortar-primero.
	a cortar-primero.
	Salida escribir: (a unir: [',']), detener.
	a poner: 9 en: 0.
	Salida escribir: (a unir: [',']), detener.
	a poner: 6 en: -1.
} capturar: { :e
	Salida escribir: ['Uncatched error has occurred.↵'] + e, detener.
}, empezar.


