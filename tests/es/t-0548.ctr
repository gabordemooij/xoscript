Server init.

>> x := Blob crear: 65 tipo: ['char'].
# for this test you need set a path to libc (puts)
>> libname := Programa configurar: ['FFITESTLIB'].
Server vincular: (
 Lista crear ;
 libname ;
 ['putchar'] ;
 ( Lista crear ; ['char'] ) ;
 ['void'] ;
 ['Print'] ;
 ['char:']
).
Print char: (x desde: 0 longitud: 1), detener.
x liberar.

