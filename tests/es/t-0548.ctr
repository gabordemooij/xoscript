Server init.

>> x := Blob crear: 65 tipo: ['char'].
# para esta prueba hay que configurar una ruta a libc (puts)
>> nombrelib := Programa configurar: ['FFITESTLIB'].
Server vincular: (
 Lista crear ;
 nombrelib ;
 ['putchar'] ;
 ( Lista crear ; ['char'] ) ;
 ['void'] ;
 ['Print'] ;
 ['char:']
).
Print char: (x desde: 0 longitud: 1), detener.
x liberar.

