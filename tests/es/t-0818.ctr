# edge cases from a request must give an error or a result, not a crash
Server init.

Salida escribir: ['<'] + (['abc'] desde: 0 longitud: 0, mayúsculas) + ['>'], detener.
Salida escribir: ['<'] + (['abc'] desde: 0 longitud: 0, minúsculas) + ['>'], detener.
Salida escribir: ['<'] + (['abc'] saltar: 3, mayúsculas) + ['>'], detener.
Salida escribir: [''] mayúsculas bytes, detener.
Salida escribir: ['aB'] mayúsculas, detener.
Salida escribir: ['aB'] minúsculas, detener.

Salida escribir: (Momento crear: 0) año, detener.
{ Momento crear: ['9e300'] número. } capturar: { :e Salida escribir: e, detener. }, empezar.
{ Momento crear: ['-9e300'] número. } capturar: { :e Salida escribir: e, detener. }, empezar.
{ Momento crear: ['nan'] número. } capturar: { :e Salida escribir: e, detener. }, empezar.
{ Momento crear: 9000000000000000000. } capturar: { :e Salida escribir: e, detener. }, empezar.
