#Linux
>> OS := Programa configurar: ['OS'].

>> clock := Momento crear.
	
(OS = ['Haiku']) verdadero: {
	clock zona: ['CET'],
	año: 2017, mes: 7, día: 13,
	hora: 18, minuto: 0, segundo: 0.
}, otro: {
	clock zona: ['Europe/Amsterdam'],
	año: 2017, mes: 7, día: 13,
	hora: 18, minuto: 0, segundo: 0.
}.

clock al: ['tell'] hacer: {
	Salida escribir: yo, detener.
}.


clock añadir: 2    hora, tell.
clock añadir: 1    hora, tell.
clock añadir: 19 minuto, tell.
clock añadir: 1  minuto, tell.
clock añadir: 1  minuto, tell.
clock añadir: 19 segundo, tell.
clock añadir: 1  segundo, tell.
clock añadir: 1  segundo, tell.
clock añadir: 2    año, tell.
clock añadir: 1    año, tell.

(OS = ['Haiku']) verdadero: {
clock añadir: 5   mes.
clock zona: ['CEST'], tell.
}, otro: {
	clock añadir: 5   mes, tell.
}.

clock añadir: 1   mes, tell.
clock añadir: 19    día, tell.
clock añadir: 1    hora, tell.
clock añadir: 120  yard, tell.
