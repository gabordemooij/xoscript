

# create a 64-bit integer for exact calculations
>> a := Int64 desde-texto: ['123'].

# to string
Salida escribir: a, detener.

# divide
Salida escribir: a / (Int64 desde-texto: ['3']), detener.

# multiply
Salida escribir: a * (Int64 desde-texto: ['2']), detener.

# add
Salida escribir: a + (Int64 desde-texto: ['1']), detener.

# subtract
Salida escribir: a - (Int64 desde-texto: ['2']), detener.

# compare
Salida escribir: ( a =   (Int64 desde-texto: ['123'])), detener.
Salida escribir: ( a !=: (Int64 desde-texto: ['124'])), detener.
Salida escribir: ( a <   (Int64 desde-texto: ['124'])), detener.
Salida escribir: ( a >   (Int64 desde-texto: ['122'])), detener.
Salida escribir: ( a >=: (Int64 desde-texto: ['123'])), detener.
Salida escribir: ( a <=: (Int64 desde-texto: ['123'])), detener.





	