# prueba de calificadores

Programa limpiar-memoria.

>> Fruta := Objeto crear.
Fruta al: ['crear'] hacer: {
	>> f := yo crear.
	f apples: 0. <- f.
}.
Fruta al: ['apples:'] hacer: { :a mi manzanas := a. }.
Fruta al: ['manzanas'] hacer: { <- mi manzanas. }.
Fruta al: ['+'] hacer: { :f
	>> n := Fruta crear.
	n apples: (f manzanas + mi manzanas). <- n.
}.
Número al: ['manzanas'] hacer: { <- ((Fruta crear) apples: yo).
}.

Fruta al: ['texto'] hacer: { <- mi manzanas + [' manzanas '].
}.

>> q := 3 manzanas + 4 manzanas.
Salida escribir: q, detener.




q := 3 manzanas + 4 manzanas.
Salida escribir: q, detener.



q := 3 manzanas + 4 manzanas.
Salida escribir: q, detener.


