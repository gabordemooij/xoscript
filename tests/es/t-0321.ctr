# test qualifiers

Programa limpiar-memoria.

>> Fruit := Objeto crear.
Fruit al: ['crear'] hacer: {
	>> f := yo crear.
	f apples: 0. <- f.
}.
Fruit al: ['apples:'] hacer: { :a mi apples := a. }.
Fruit al: ['apples'] hacer: { <- mi apples. }.
Fruit al: ['+'] hacer: { :f
	>> n := Fruit crear.
	n apples: (f apples + mi apples). <- n.
}.
Número al: ['apples'] hacer: { <- ((Fruit crear) apples: yo).
}.

Fruit al: ['texto'] hacer: { <- mi apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Salida escribir: q, detener.




q := 3 apples + 4 apples.
