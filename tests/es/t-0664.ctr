# no se permite la interpolación recursiva

Salida escribir: 
['interolación de texto recursiva activada: '] + (
	Programa funcionalidad: 
	['RECURSIVE_STRINTPOL']
), detener.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Salida escribir: a, detener.


Programa funcionalidad: ['RECURSIVE_STRINTPOL'] activada: Verdadero.

Salida escribir: 
['interpolación de texto recursiva activada: '] + (
	Programa funcionalidad: 
	['RECURSIVE_STRINTPOL']
), detener.

>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Salida escribir: a, detener.

Programa funcionalidad: ['RECURSIVE_STRINTPOL'] activada: Falso.

Salida escribir: 
['interpolación de texto recursiva activada: '] + (
	Programa funcionalidad: 
	['RECURSIVE_STRINTPOL']
), detener.

>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Salida escribir: a, detener.
