# recursive interpolation not allowed

Salida escribir: 
['recursive string interolation enabled: '] + (
	Programa funcionalidad: 
	['RECURSIVE_STRINTPOL']
), detener.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Salida escribir: a, detener.


