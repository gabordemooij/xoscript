

Texto al: ['evaluar'] hacer: {
	>> código := Archivo crear: ['/tmp/eval.ctr'].
	código escribir: yo texto + ['.'].
	Programa utilizar: ['/tmp/eval.ctr'].
}.

>> a := (Lista ← (
	(Diccionario crear)
		poner: ['dominio'] en: ['mywebsite.com'],
		poner: (Lista ←
			((Diccionario crear)
				poner: ['inicio'] en: ['title'],
				poner: ['<html></html>'] en: ['body'],
				poner: ['2017-01-01'] en: ['creado']
			) ;
			((Diccionario crear)
				poner: ['sobrenosotros(c)'] en: ['title'],
				poner: ['<credits>Author Inc.</credits>'] en: ['body']
			)
		) en: ['páginas']
	)
) texto.

Salida escribir: a tipo, detener.
Salida escribir: a, detener.

>> b := Nulo.
(['b := '] + a) evaluar.
Salida escribir: b ? 0 ? ['páginas'] ? 1 ? ['body'], detener.

>> c := b ? 0.
>> d := c texto.
Salida escribir: d tipo, detener.

>> e := Nulo.
(['e := '] + d) evaluar.
Salida escribir: e ? ['páginas'] ? 0, detener.
