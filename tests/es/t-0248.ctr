

Texto al: ['evaluate'] hacer: {
	>> código := Archivo crear: ['/tmp/eval.ctr'].
	código escribir: yo texto + ['.'].
	Programa utilizar: ['/tmp/eval.ctr'].
}.

>> a := (Lista ← (
	(Diccionario crear)
		poner: ['domain'] en: ['mywebsite.com'],
		poner: (Lista ←
			((Diccionario crear)
				poner: ['home'] en: ['title'],
				poner: ['<html></html>'] en: ['body'],
				poner: ['2017-01-01'] en: ['created']
			) ;
			((Diccionario crear)
				poner: ['aboutus(c)'] en: ['title'],
				poner: ['<credits>Author Inc.</credits>'] en: ['body']
			)
		) en: ['pages']
	)
) texto.

Salida escribir: a tipo, detener.
Salida escribir: a, detener.

>> b := Nulo.
(['b := '] + a) evaluate.
Salida escribir: b ? 0 ? ['pages'] ? 1 ? ['body'], detener.

>> c := b ? 0.
>> d := c texto.
Salida escribir: d tipo, detener.

>> e := Nulo.
(['e := '] + d) evaluate.
Salida escribir: e ? ['pages'] ? 0, detener.
