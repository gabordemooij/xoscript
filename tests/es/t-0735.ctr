Server init.
>> a := Blob crear: 4.
a bytes: ( Lista crear ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob crear: 4.
b bytes: ( Lista crear ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
# inherited blob does not get the buffer, so it's useless
# it will pass ctr_accept() but since buffer ptr == null, it will retur
>> c := a crear.
{ 
>> n := a ^ c.
Salida escribir: ['xorred:'], detener. 
Salida escribir: n, detener. 
} capturar: { :e Salida escribir: e, detener. }, empezar.
a liberar.
b liberar.
