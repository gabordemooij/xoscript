Número al: ['factorial'] hacer: {
	>> total := 1.
	{ :index total multiplicar: (yo - (index)). } × yo. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Salida escribir: a.
>> b := 2 + 3 factorial.
Salida escribir: b.
>> c := 3 factorial + 2.
Salida escribir: c.
>> d := 2 + (3 factorial).
Salida escribir: d.
Salida escribir: 2 + 3 factorial + 1.
