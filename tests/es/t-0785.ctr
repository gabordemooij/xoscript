Salida escribir: ['Objeto de prueba'], detener.
>> a := Objeto crear. 

a al: ['item:'] hacer: { :momento
	mi momento := momento. 
}.

a al: ['artículo'] hacer: {
	<- mi momento.
}.

>> hoy := Lista crear ; ( Momento crear zona: ['CEST'], año: 2026, mes: 7 ).
a item: hoy.
Salida escribir: a artículo ? 0, detener.
a save-as: ['/tmp/a.bin'].
