Salida escribir: ['Test object'], detener.
>> a := Objeto crear. 

a al: ['item:'] hacer: { :moment
	mi moment := moment. 
}.

a al: ['item'] hacer: { <- mi moment.
}.

>> today := Lista crear ; ( Momento crear zona: ['CEST'], año: 2026, mes: 7 ).
a item: today.
Salida escribir: a item ? 0, detener.
a save-as: ['/tmp/a.bin'].
