>> w := ['A_bottle_of_Whisky and a rare steak.'].
Salida escribir: ['=== Basic test, grab the bottle! ==='], detener.
Salida escribir: ['>']+(w copiar desde:2 longitud: 6), detener.
Salida escribir: ['>']+(w copiar desde:8 longitud: -6), detener.
Salida escribir: ['>']+(w copiar desde:2 longitud: 6), detener.
Salida escribir: ['>']+(w copiar desde:8 longitud: -6), detener.
Salida escribir: ['=== Take a single char ==='], detener.
Salida escribir: ['>']+(w copiar desde:7 longitud: 1), detener.
Salida escribir: ['>']+(w copiar desde:7 longitud: 1), detener.
Salida escribir: ['=== The 0 case, empty string ==='], detener.
Salida escribir: ['>']+(w copiar desde:7 longitud: 0), detener.
Salida escribir: ['>']+(w copiar desde:7 longitud: 0), detener.
Salida escribir: ['=== Edge case, first character only ==='], detener.
Salida escribir: ['>']+(w copiar desde:0 longitud: 1), detener.
Salida escribir: ['>']+(w copiar desde:0 longitud: 1), detener.
Salida escribir: ['>']+(w copiar desde:1 longitud: -1), detener.
Salida escribir: ['>']+(w copiar desde:1 longitud: -1), detener.
Salida escribir: ['=== Edge case, last character only ==='], detener.
Salida escribir: ['>']+(w copiar desde:35 longitud: 1), detener.
Salida escribir: ['>']+(w copiar desde:35 longitud: 1), detener.
Salida escribir: ['>']+(w copiar desde:36 longitud: -1), detener.
Salida escribir: ['>']+(w copiar desde:36 longitud: -1), detener.
Salida escribir: ['=== Out of bounds, empty string ==='], detener.
Salida escribir: ['>']+(w copiar desde:36 longitud: 37), detener.
Salida escribir: ['>']+(w copiar desde:36 longitud: 47), detener.
Salida escribir: ['>']+(w copiar desde:-1 longitud: -2), detener.
Salida escribir: ['>']+(w copiar desde:-2 longitud: -1), detener.
Salida escribir: ['=== Part out of bounds, full string ==='], detener.
Salida escribir: ['>']+(w copiar desde:-20 longitud: 90), detener.
Salida escribir: ['>']+(w copiar desde:90 longitud: -20), detener.
Salida escribir: ['>']+(w copiar desde:-20 longitud: 90), detener.
Salida escribir: ['>']+(w copiar desde:90 longitud: -120), detener.
