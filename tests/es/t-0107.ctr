
Salida escribir: ['Romper bucle for, 0-4.'], detener.
{ :i
	Salida escribir: ['iteration #'] + i, detener.
	(i = 4) salir.
} × 10.

>> x := 0.
>> xEsMenorQue10 := { <- ( x < 10 ). }.

Salida escribir: ['Romper bucle while-true, 0-4.'], detener.
{
	Salida escribir: ['iteration #'] + x, detener.
	x añadir: 1.
	((x < 5) no) salir.
} mientras: xEsMenorQue10.

Salida escribir: ['Romper bucle while-false, 5,4.'], detener.
{
	Salida escribir: ['iteration #'] + x, detener.
	x restar: 1.
	(x = 3) salir.
} mientras: { <- (x > 0). }.

Salida escribir: ['Romper bucle times, 1-4.'], detener.
{ :i
	Salida escribir: ['iteration #'] + i, detener.
	(i = 4) salir.
} × 5.

Salida escribir: ['Romper bloque, no imprimir línea.'], detener.
{ Verdadero salir. Salida escribir: ['¡no escribas esto!'], detener. } empezar.

Salida escribir: ['Romper bloque, no disparar catch...'], detener.
{ Verdadero salir. Salida escribir: ['¡no escribas esto!'], detener. } capturar: { Salida escribir: ['¡No captures esto!']. }, empezar.

Salida escribir: ['Prueba de bucle each en Lista: 0,1'], detener.
(Lista ← 1 ; 2 ; 3) diccionario: { :i
	Salida escribir: ['iteration #'] + i, detener.
	(i = 1) salir.
}.

Salida escribir: ['Prueba de bucle each en Diccionario: solo c'], detener.
>> m := Diccionario crear.
m poner: ['first'] en: ['a'], poner: ['second'] en: ['b'], poner: ['tercero'] en: ['c'].
m cada: { :k :v
	Salida escribir: ['iteration'] + v + k, detener.
	Verdadero salir.
}.

