
Salida escribir: ['Break for-loop, 0-4.'], detener.
{ :i
	Salida escribir: ['iteration #'] + i, detener.
	(i = 4) salir.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Salida escribir: ['Break while-true loop, 0-4.'], detener.
{
	Salida escribir: ['iteration #'] + x, detener.
	x añadir: 1.
	((x < 5) no) salir.
} mientras: xIsLessThan10.

Salida escribir: ['Break while-false loop, 5,4.'], detener.
{
	Salida escribir: ['iteration #'] + x, detener.
	x restar: 1.
	(x = 3) salir.
} mientras: { <- (x > 0). }.

Salida escribir: ['Break times loop, 1-4.'], detener.
{ :i
	Salida escribir: ['iteration #'] + i, detener.
	(i = 4) salir.
} × 5.

Salida escribir: ['Break block, dont print line.'], detener.
{ Verdadero salir. Salida escribir: ['dont write this!'], detener. } empezar.

Salida escribir: ['Break block, dont fire catch...'], detener.
{ Verdadero salir. Salida escribir: ['dont write this!'], detener. } capturar: { Salida escribir: ['Dont catch this!']. }, empezar.

Salida escribir: ['Test Array each-loop: 0,1'], detener.
(Lista ← 1 ; 2 ; 3) diccionario: { :i
	Salida escribir: ['iteration #'] + i, detener.
	(i = 1) salir.
}.

Salida escribir: ['Test Map each-loop: c only'], detener.
>> m := Diccionario crear.
m poner: ['first'] en: ['a'], poner: ['second'] en: ['b'], poner: ['third'] en: ['c'].
m cada: { :k :v
	Salida escribir: ['iteration'] + v + k, detener.
	Verdadero salir.
}.

