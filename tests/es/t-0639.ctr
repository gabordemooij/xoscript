
Server init.
Salida escribir: ['Prueba de base de datos'], detener.

>> bd := Maria-DB crear host: ['localhost'],
	usuario: ['xo'], 
	contraseña: ['pass123'],
	nombre-base-datos: ['xobase'],
	conectar.

>> consulta :=
bd consultar: ['SELECT REPEAT('Blah',1000) AS blah'], 
extraer: { :fila 
	Salida escribir: fila blah longitud, detener.
}.
