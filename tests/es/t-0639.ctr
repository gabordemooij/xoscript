
Server init.
Salida escribir: ['Database test'], detener.

>> db := Maria-DB crear host: ['localhost'],
	usuario: ['xo'], 
	contraseña: ['pass123'],
	nombre-base-datos: ['xobase'],
	conectar.

>> consulta :=
db consultar: ['SELECT REPEAT('Blah',1000) AS blah'], 
extraer: { :row 
	Salida escribir: row blah longitud, detener.
}.
