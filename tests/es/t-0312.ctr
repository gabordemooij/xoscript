>> Sorbedor := Objeto crear.
Sorbedor al: ['crear'] hacer: {
	mi str := [''].
}.
Sorbedor aprender: ['nieuw'] significa: ['crear'].
Sorbedor al: ['responder:'] hacer: { :blah
		(mi str ≠ ['']) verdadero: {
			mi str adjuntar: [' '].
		}.
		mi str adjuntar: blah.
}.
Sorbedor al: ['responder:y:'] hacer: { :blah :blahah
		(mi str ≠ ['']) verdadero: {
			mi str adjuntar: [' '].
		}.
		(blah longitud > 1) verdadero: {
			mi str adjuntar: (blah desde: 0 longitud: (blah longitud - 1)).
		}, otro: {
			mi str adjuntar: blah.
		}.
		mi str adjuntar: [' '].
		mi str adjuntar: blahah.
}.
Sorbedor al: ['recoger'] hacer: {
	>> búfer := mi str.
	mi str := ['']. <- búfer.
}.


>> consulta := Sorbedor crear
	select: ['*'],
	from
		usuarios 
	where 
		user_id=: 1.

Salida escribir: consulta recoger, detener.
