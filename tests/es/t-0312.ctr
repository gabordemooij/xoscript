>> Slurp := Objeto crear.
Slurp al: ['crear'] hacer: {
	mi str := [''].
}.
Slurp aprender: ['nieuw'] significa: ['crear'].
Slurp al: ['responder:'] hacer: { :blah
		(mi str ≠ ['']) verdadero: {
			mi str adjuntar: [' '].
		}.
		mi str adjuntar: blah.
}.
Slurp al: ['responder:y:'] hacer: { :blah :blahah
		(mi str ≠ ['']) verdadero: {
			mi str adjuntar: [' '].
		}.
		(blah longitud > 1) verdadero: {
			mi str adjuntar: (blah desde: 0 longitud: (blah longitud - 1)).
		}, otro: {
			mi str adjuntar: blah.
		}.
		mi str adjuntar: [' '].
		mi str adjuntar: blahah.
}.
Slurp al: ['obtain'] hacer: {
	>> buffer := mi str.
	mi str := ['']. <- buffer.
}.


>> consulta := Slurp crear
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

Salida escribir: consulta obtain, detener.
