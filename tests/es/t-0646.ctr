Server init.
Salida escribir: ['Database datetime test'], detener.

>> db := Maria-DB crear host: ['localhost'],
	usuario: ['xo'], 
	contraseña: ['pass123'],
	nombre-base-datos: ['xobase'],
	conectar.

>> consulta :=
db consultar: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
extraer: { :row
	Salida escribir: row datetimetest, detener.
}.
