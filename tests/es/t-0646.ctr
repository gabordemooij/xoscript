Server init.
Salida escribir: ['Prueba de fecha y hora en base de datos'], detener.

>> bd := Maria-DB crear host: ['localhost'],
	usuario: ['xo'], 
	contraseña: ['pass123'],
	nombre-base-datos: ['xobase'],
	conectar.

>> consulta :=
bd consultar: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
extraer: { :fila
	Salida escribir: fila datetimetest, detener.
}.
