Server init.

>> BD := Maria-DB crear host: ['localhost'],
	usuario: ['xo'],
	contraseña: ['pass123'],
	nombre-base-datos: ['xobase'],
	conectar.
	
>> SQL := ['SELECT "hello" AS "world" '].

# una forma más rápida, obtener la consulta desde BD:
>> consulta2 := BD consultar: SQL.

# ahora no hace falta establecer BD
consulta2 extraer: { :fila
	Salida escribir: fila world, detener.
}.
