Server init.

>> DB := Maria-DB crear host: ['localhost'],
	usuario: ['xo'],
	contraseña: ['pass123'],
	nombre-base-datos: ['xobase'],
	conectar.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB consultar: SQL.

# now you don't have to set DB
query2 extraer: { :row
	Salida escribir: row world, detener.
}.
