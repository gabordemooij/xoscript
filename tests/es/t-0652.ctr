# test number -> string -> number
{

	>> x := Número entre: 0 y: 1000000.
	>> d := Número entre: 1 y: 7.
	>> e := 10 elevado-a: d.

	x dividir: e.
	>> y := x texto número.

	(x = y) falso: {
		Salida escribir: x, detener.
		Salida escribir: y, detener.
		Programa finalizar.
	}.

} * 1000.
Salida escribir: ['OK'], detener.