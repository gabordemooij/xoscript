>> aleatorizador := { :a :b
	>> mínimo := ( a < b ) o: a o: b.
	>> máximo := ( a > b ) o: a o: b.
	>> x := Nulo.
	{
		x := Número entre: a y: b.
		((x < mínimo) o: (x > máximo)) verdadero: { 
			Salida escribir: (['¡Valor no válido!']).
			Programa finalizar.
		}.
	} 
	× 100. <- x.
}.
