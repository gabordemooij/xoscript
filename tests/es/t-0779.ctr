Salida escribir: ['Objeto de prueba'], detener.
>> p := Ruta /tmp.
Salida escribir: p, detener.
>> antigua-dirección-p := p prototipo dirección-de-memoria.
p save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RECARGANDO SNAP:'], detener.
>> b := Objeto load-from: ['/tmp/a.bin'].
(b prototipo dirección-de-memoria = antigua-dirección-p) verdadero: {
	Salida escribir: ['Enlace de objeto reconectado.'], detener.
}.
Salida escribir: b, detener.
