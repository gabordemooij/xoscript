Salida escribir: ['Test object'], detener.
>> p := Ruta /tmp.
Salida escribir: p, detener.
>> old-p-address := p prototipo dirección-de-memoria.
p save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RELOADING SNAP:'], detener.
>> b := Objeto load-from: ['/tmp/a.bin'].
(b prototipo dirección-de-memoria = old-p-address) verdadero: {
	Salida escribir: ['Object link re-attached.'], detener.
}.
Salida escribir: b, detener.
