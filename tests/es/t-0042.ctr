>> items := Diccionario crear.
items poner: ['black'] en: ['coffee'], poner: ['earl grey'] en: ['tea'].
Salida escribir: (items en: ['coffee']), escribir: (items en: ['tea']).
Salida escribir: ['there are'] + items contar + [' items in the array.'].
items poner: ['capuccino'] en: ['coffee'].
Salida escribir: ['Now my coffee is.. '] + (items en: ['coffee']).
items poner: ['aaa'] en: ['1'].
items poner: ['bbb'] en: ['2'].
Salida escribir: (items en: ['a']).
