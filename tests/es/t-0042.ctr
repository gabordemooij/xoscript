>> items := Diccionario crear.
items poner: ['solo'] en: ['coffee'], poner: ['earl grey'] en: ['té'].
Salida escribir: (items en: ['coffee']), escribir: (items en: ['té']).
Salida escribir: ['hay'] + items contar + [' elementos en el arreglo.'].
items poner: ['capuchino'] en: ['coffee'].
Salida escribir: ['Ahora mi café es.. '] + (items en: ['coffee']).
items poner: ['aaa'] en: ['1'].
items poner: ['bbb'] en: ['2'].
Salida escribir: (items en: ['a']).
