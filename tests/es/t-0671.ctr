# clave pública (para proteger APIs, etc.)
Server init.

# generar claves
>> claves := Contenedor-seguro claves-criptográficas.

# clave privada (secreta)
>> sk := claves primero.

# clave pública
>> pk := claves último.

# firmar un mensaje
>> firma := Contenedor-seguro firmar: ['abc'] con: sk.

# comprobar el mensaje (ok)
Salida escribir: ( 
	Contenedor-seguro
		verificar: ['abc'] 
		firma: firma 
		con: pk 
), detener.

# comprobar el mensaje (falla)
Salida escribir: ( 
	Contenedor-seguro 
		verificar: ['abd'] 
		firma: firma 
		con: pk 
), detener.