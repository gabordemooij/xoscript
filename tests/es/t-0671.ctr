# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Contenedor-seguro claves-criptográficas.

# private (secret) key
>> sk := keys primero.

# public key
>> pk := keys último.

# sign a message
>> sig := Contenedor-seguro firmar: ['abc'] con: sk.

# check message (ok)
Salida escribir: ( 
	Contenedor-seguro
		verificar: ['abc'] 
		firma: sig 
		con: pk 
), detener.

# check message (fail)
Salida escribir: ( 
	Contenedor-seguro 
		verificar: ['abd'] 
		firma: sig 
		con: pk 
), detener.