>> Animal := Objeto crear.
Animal al: ['fabricar'] hacer: {
	>> animal := Objeto crear.
	animal al: ['hacerSonido'] hacer: {
		Salida escribir: mi sonido.
	}. <- animal.
}.
>> Gato := Objeto crear.
Gato al: ['fabricar'] hacer: {
	>> gato := Animal fabricar.
	gato al: ['init'] hacer: {
		mi sonido := ['meow!'].
	}.
	gato init. <- gato.
}.
>> tom := Gato fabricar.
tom hacerSonido.
