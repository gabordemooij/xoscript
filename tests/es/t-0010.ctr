>> Animal := Objeto crear.
Animal al: ['make'] hacer: {
	>> animal := Objeto crear.
	animal al: ['makeSound'] hacer: {
		Salida escribir: mi sound.
	}. <- animal.
}.
>> Cat := Objeto crear.
Cat al: ['make'] hacer: {
	>> cat := Animal make.
	cat al: ['init'] hacer: {
		mi sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
