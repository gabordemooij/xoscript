Salida escribir: ['Objeto de prueba'], detener.
>> a := Objeto crear. 
a al: ['item:'] hacer: { :lst
	mi lst := lst. 
}.
a al: ['artículo'] hacer: {
	<- mi lst.
}.
a item: (
	Lista crear ; 1 ; (
		Lista crear ; ['a'] ; (
			Lista crear ; ( Momento crear: 1 )
		) ; ( Int64 desde-texto: ['321'] )
	)
).
Salida escribir: a artículo, detener.
>> antigua-dirección-lst := a artículo prototipo dirección-de-memoria.
a save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RECARGANDO SNAP:'], detener.
>> b := Objeto load-from: ['/tmp/a.bin'].
(b artículo prototipo dirección-de-memoria = antigua-dirección-lst) verdadero: {
	Salida escribir: ['Enlace de objeto reconectado.'], detener.
}.
Salida escribir: ( b artículo ), detener.
