Salida escribir: ['Test object'], detener.
>> a := Objeto crear. 
a al: ['item:'] hacer: { :lst
	mi lst := lst. 
}.
a al: ['item'] hacer: { <- mi lst.
}.
a item: (
	Lista crear ; 1 ; (
		Lista crear ; ['a'] ; (
			Lista crear ; ( Momento crear: 1 )
		) ; ( Int64 desde-texto: ['321'] )
	)
).
Salida escribir: a item, detener.
>> old-lst-address := a item prototipo dirección-de-memoria.
a save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RELOADING SNAP:'], detener.
>> b := Objeto load-from: ['/tmp/a.bin'].
(b item prototipo dirección-de-memoria = old-lst-address) verdadero: {
	Salida escribir: ['Object link re-attached.'], detener.
}.
Salida escribir: ( b item ), detener.
