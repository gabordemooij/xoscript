Texto al: ['html'] hacer: { <- (
		yo
		reemplazar: ['&'] con: ['&amp;'],
		reemplazar: ['<'] con: ['&lt;'],
		reemplazar: ['>'] con: ['&gt;'],
		reemplazar: ['''] con: ['&apos;'],
		reemplazar: ['"'] con: ['&quot;']
	).
}.

>> memoriaUsada1 := 0.
>> memoriaUsada2 := 0.
>> memoriaUsada3 := 0.
>> memoriaUsada4 := 0.

Programa orden: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Salida escribir: txt copiar html, detener.
Salida escribir: txt copiar minúsculas, detener.
Salida escribir: txt copiar mayúsculas, detener.
} empezar.

Programa limpiar-memoria.

memoriaUsada1 := (Programa memoria ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Salida escribir: txt copiar html, detener.
Salida escribir: txt copiar minúsculas, detener.
Salida escribir: txt copiar mayúsculas, detener.
} empezar.

Programa limpiar-memoria.
memoriaUsada2 := (Programa memoria ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Salida escribir: txt copiar html, detener.
Salida escribir: txt copiar minúsculas, detener.
Salida escribir: txt copiar mayúsculas, detener.
} empezar.

Programa limpiar-memoria.
memoriaUsada3 := (Programa memoria ? 0).



( memoriaUsada1 = memoriaUsada2 y: memoriaUsada1 = memoriaUsada3, y: memoriaUsada2 = memoriaUsada3 ) verdadero: {
	Salida escribir: ['Aquí no hay fugas de memoria'].
}, falso: {
	Salida escribir: ['Fuga de memoria...'].
}.
