Texto al: ['html'] hacer: { <- (
		yo
		reemplazar: ['&'] con: ['&amp;'],
		reemplazar: ['<'] con: ['&lt;'],
		reemplazar: ['>'] con: ['&gt;'],
		reemplazar: ['''] con: ['&apos;'],
		reemplazar: ['"'] con: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa orden: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Salida escribir: txt copiar html, detener.
Salida escribir: txt copiar minúsculas, detener.
Salida escribir: txt copiar mayúsculas, detener.
} empezar.

Programa limpiar-memoria.

usedMemory1 := (Programa memoria ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Salida escribir: txt copiar html, detener.
Salida escribir: txt copiar minúsculas, detener.
Salida escribir: txt copiar mayúsculas, detener.
} empezar.

Programa limpiar-memoria.
usedMemory2 := (Programa memoria ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
