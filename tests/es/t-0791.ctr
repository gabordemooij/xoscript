Server init.

>> BD := Maria-DB crear host: ['localhost'],
	usuario: ['xo'],
	contraseña: ['pass123'],
	nombre-base-datos: ['xobase'],
	conectar.
	
>> SQL := ['SELECT "hello" AS "world" '].

# crear la consulta manualmente
>> consulta := Maria-Consulta crear: SQL.

# establecer la base de datos
consulta base-de-datos: BD.

consulta extraer: { :fila
	Salida escribir: fila world, detener.
}.
