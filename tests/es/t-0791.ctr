Server init.

>> DB := Maria-DB crear host: ['localhost'],
	usuario: ['xo'],
	contraseña: ['pass123'],
	nombre-base-datos: ['xobase'],
	conectar.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> consulta := Maria-Consulta crear: SQL.

# set database
consulta base-de-datos: DB.

consulta extraer: { :row
	Salida escribir: row world, detener.
}.
