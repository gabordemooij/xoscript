>> Abuelo := Objeto crear.
Abuelo al: ['saludar'] hacer: {
	Salida escribir: ['Ave!'], detener.
}.
>> Padre := Abuelo crear.
Padre al: ['saludar'] hacer: {
	Salida escribir: ['Hello'], detener.
	yo saludar.
}.
>> Hijo := Padre crear.
Hijo al: ['saludar'] hacer: {
	Salida escribir: ['Buenas'], detener.
	yo saludar.
}.

Hijo saludar.

>> Rotonda := Objeto crear.
Rotonda al: ['circle:'] hacer: { :x
	Salida escribir: x, detener.
	(x < 3) verdadero: { yo recursivo circle: x + 1. }.
}.

Rotonda circle: 1.

>> x := 1.
>> incrementar := { (x ≤ 3) verdadero: { Salida escribir: x, detener. x añadir: 1.  incrementar empezar. }. }.
incrementar empezar.