>> Grandfather := Objeto crear.
Grandfather al: ['greet'] hacer: {
	Salida escribir: ['Ave!'], detener.
}.
>> Father := Grandfather crear.
Father al: ['greet'] hacer: {
	Salida escribir: ['Hello'], detener.
	yo greet.
}.
>> Son := Father crear.
Son al: ['greet'] hacer: {
	Salida escribir: ['Hi'], detener.
	yo greet.
}.

Son greet.

>> Roundabout := Objeto crear.
Roundabout al: ['circle:'] hacer: { :x
	Salida escribir: x, detener.
	(x < 3) verdadero: { yo recursivo circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) verdadero: { Salida escribir: x, detener. x añadir: 1.  increment empezar. }. }.
increment empezar.