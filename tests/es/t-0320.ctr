


>> Cafetera := Objeto crear.
Cafetera al: ['order:'] hacer: { :id
	>> coffee := ['Americano'].
	( id = 1 ) verdadero: {
		coffee := ['Capuchino'].
	}.
	( id = 2 ) verdadero: {
		coffee := ['Expreso'].
	}.
	( id = 3 ) verdadero: {
		coffee := ['Café con leche'].
	}. <- coffee.
}.
>> CafeteraSimple := Objeto crear.
CafeteraSimple al: ['pedido'] hacer: { <- ['Solo']. }.
>> tazaRoja := Cafetera order: 1.
Salida escribir: tazaRoja, detener.
tazaRoja := ['Té']. 
>> tazaVerde := Cafetera order: 0.
Salida escribir: tazaVerde, detener.
>> tazaAmarilla := Cafetera order: 1.
Salida escribir: tazaAmarilla, detener.
>> tazaAzul := Cafetera order: 0.
Salida escribir: tazaAzul, detener.
>> tazaPlástico := CafeteraSimple pedido.
tazaPlástico := ['Limonada']. 
>> tazaNegra := CafeteraSimple pedido.
Salida escribir: tazaNegra, detener.
tazaNegra adjuntar: [' nooo.... cerveza. '].
>> tazaNaranja := CafeteraSimple pedido.
Salida escribir: tazaNaranja, detener.
