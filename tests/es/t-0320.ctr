


>> CoffeeMachine := Objeto crear.
CoffeeMachine al: ['order:'] hacer: { :id
	>> coffee := ['Americano'].
	( id = 1 ) verdadero: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) verdadero: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) verdadero: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Objeto crear.
SimpleCoffeeMachine al: ['order'] hacer: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Salida escribir: redCup, detener.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Salida escribir: greenCup, detener.
>> yellowCup := CoffeeMachine order: 1.
Salida escribir: yellowCup, detener.
>> blueCup := CoffeeMachine order: 0.
Salida escribir: blueCup, detener.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Salida escribir: blackCup, detener.
blackCup adjuntar: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Salida escribir: orangeCup, detener.
