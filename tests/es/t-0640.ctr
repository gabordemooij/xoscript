
Server init.
Salida escribir: ['Prueba de base de datos'], detener.

>> bd := Maria-DB crear host: ['localhost'],
	usuario: ['xo'], 
	contraseña: ['pass123'],
	nombre-base-datos: ['xobase'],
	conectar.

>> consulta :=
bd consultar: ['SELECT UNHEX('CAFE') AS blobby'],
extraer: { :fila
	Salida escribir: ( fila blobby desde: 0 longitud: 2 ), detener.
	fila blobby liberar.
}.
