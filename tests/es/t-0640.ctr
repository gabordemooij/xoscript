
Server init.
Salida escribir: ['Database test'], detener.

>> db := Maria-DB crear host: ['localhost'],
	usuario: ['xo'], 
	contraseña: ['pass123'],
	nombre-base-datos: ['xobase'],
	conectar.

>> consulta :=
db consultar: ['SELECT UNHEX('CAFE') AS blobby'],
extraer: { :row
	Salida escribir: ( row blobby desde: 0 longitud: 2 ), detener.
	row blobby liberar.
}.
