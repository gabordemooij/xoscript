

Lista al: ['fixture:'] hacer: { :f
	mi fixture := f.
}.

Lista al: ['contar'] hacer: { <- mi fixture.
}.

Lista al: ['aantal'] hacer: { <- mi fixture.
}.


>> x := Nulo.
{

	x := ['hello'] 
	reemplazar:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] caracter: 2)
			)
		)
	con: (
		(['...hal'] + ['lo']) 
			mayúsculas 
			lowecase 
			mayúsculas 
			saltar: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Lista ← 0 ; 1 ; 4; 9 ; (Lista ← 0 ; 3; 1) ; 4
							) penúltimo
						) ? 1
					) + 
					((Lista ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					contar
				)
			)
	).

} × 10.
Salida escribir: x, detener.

