Salida escribir: ((Lista crear
	al: ['plaque:'] hacer: { :x mi o := x. },
	al: ['placa']  hacer: { <- mi o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Lista ← 1)
	~ (Lista ← 1 ; 2)
	~ (Lista ← 1 ; 2 ; 3)
	~ (Lista ← 1 ; 2 ; 3 ; 4)
	~ (Lista ← 1 ; 2 ; 3 ; 4 ; 5)
) cada: { :i :elem
	{ Salida escribir: la-tarea-actual. } × elem contar.
	Salida detener.
}) placa, detener.


