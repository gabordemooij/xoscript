>> Combination := Lista crear.

Combination al: ['adjuntar:'] hacer: { :el
	yo 
	encontrar: el, ¿nulo? verdadero: { yo adjuntar: el. }.
}.

>> colours := Combination crear.
colours
	adjuntar: ['red'],
	adjuntar: ['green'],
	adjuntar: ['blue'],
	adjuntar: ['red'].

Salida escribir: colours, detener.
