>> Combinación := Lista crear.

Combinación al: ['adjuntar:'] hacer: { :elem
	yo 
	encontrar: elem, ¿nulo? verdadero: { yo adjuntar: elem. }.
}.

>> tonos := Combinación crear.
tonos
	adjuntar: ['rojo'],
	adjuntar: ['verde'],
	adjuntar: ['azul'],
	adjuntar: ['rojo'].

Salida escribir: tonos, detener.
