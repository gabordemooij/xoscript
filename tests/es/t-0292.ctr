>> winery := { <- (	Diccionario crear
		poner: 2 en: ['merlot'],
		poner: 3 en: ['malbec'],
		poner: 4 en: ['syrah']
	).
}.

Salida escribir: (((winery empezar) - ['nothing']) contar), detener.
Salida escribir: (((winery empezar) - ['merlot']) contar), detener.
Salida escribir: (((winery empezar) - ['malbec']) contar), detener.
Salida escribir: (((winery empezar) - ['syrah']) contar), detener.
Salida escribir: (((winery empezar) - ['merlot'] - ['malbec']) contar), detener.
Salida escribir: (((winery empezar) - ['merlot'] - ['syrah']) contar), detener.
Salida escribir: (((winery empezar) - ['malbec'] -['syrah']) contar), detener.
Salida escribir: (((winery empezar) - ['malbec'] - ['syrah'] - ['merlot']) contar), detener.

