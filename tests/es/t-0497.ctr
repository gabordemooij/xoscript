Server init.

# escribir un archivo de prueba
>> f := Archivo crear: ['/tmp/test.gif'].
f escribir: ['GIF87a01234567810'].

# servir el archivo
Server acceso-directo: ['test.gif'] prefijo: ['/tmp/'].

Salida detener.

Salida escribir: ['Fuera del contenedor (seguridad):'], detener.
{ Server acceso-directo: ['../passwd'] prefijo: ['/tmp/']. }
capturar: { :e Salida escribir: e, detener. },
empezar.

Salida escribir: ['Prefijo no válido:'], detener.
{ Server acceso-directo: ['test.gif'] prefijo: ['z:\\']. }
capturar: { :e Salida escribir: e, detener. },
empezar.

Salida escribir: ['Archivo inexistente:'], detener.
{ Server acceso-directo: ['xxx.xxx'] prefijo: ['/tmp/']. }
capturar: { :e Salida escribir: e, detener. },
empezar.
