Server init.

# el codificador JSON solo admite UTF-8, sin pares sustitutos

>> diccs := Lista crear ;
	# {"key":"normal"} ASCII normal
	( Diccionario crear poner: ['normal'] en: ['key'] ) ;
	# {"key":"hello world"} carácter de espacio
	( Diccionario crear poner: ['hello world'] en: ['key'] ) ;
	# {"key":"quote: \""} comilla doble
	( Diccionario crear poner: ['"'] en: ['key'] ) ;
	# {"key":"backslash: \\"} barra invertida
	( Diccionario crear poner: ['backslash: \\'] en: ['key'] ) ;
	# {"key":"slash: /"} barra
	( Diccionario crear poner: ['barra: /'] en: ['key'] ) ;
	# {"key":"backspace: \b"} retroceso
	( Diccionario crear poner: ['backspace: \b'] en: ['key'] ) ;
	# {"key":"formfeed: \f"} escape de avance de página
	( Diccionario crear poner: ['formfeed: \f'] en: ['key'] ) ;
	# {"key":"newline: \n"} salto de línea
	( Diccionario crear poner: ['newline: \n'] en: ['key'] ) ;
	( Diccionario crear poner: ['newline: ↵'] en: ['key'] ) ;
	( Diccionario crear poner: ['newline: 
	'] en: ['key'] ) ;
	# {"key":"carriage return: \r"} retorno de carro
	( Diccionario crear poner: ['carriage return: \r'] en: ['key'] ) ;
	# {"key":"tab: \t"} tabulador
	( Diccionario crear poner: ['tab \t'] en: ['key'] ) ;
	( Diccionario crear poner: ['tab ⇿'] en: ['key'] ) ;
	( Diccionario crear poner: ['tabulador  '] en: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( Diccionario crear poner: ['NUL \u0000'] en: ['key'] ) ;
	( Diccionario crear poner: ['NUL \0'] en: ['key'] ) ;
	# {"key":"control: \u0001"} carácter de control 0x01
	( Diccionario crear poner: ['control: \u0001'] en: ['key'] ) ;
	# {"key":"control: \u001F"} carácter de control 0x1F
	( Diccionario crear poner: ['control: \u001F'] en: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, carácter de 2 bytes
	( Diccionario crear poner: ['unicode: é'] en: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, carácter de 3 bytes
	( Diccionario crear poner: ['unicode: €'] en: ['key'] ) ;
	# {"key":"unicode: 日本語"} varios caracteres UTF-8 de 3 bytes
	( Diccionario crear poner: ['unicode: 日本語'] en: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, carácter de 4 bytes
	( Diccionario crear poner: ['unicode: 😀'] en: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + unión de ancho cero
	( Diccionario crear poner: ['unicode: 🧑‍💻'] en: ['key'] ) ;
	# {"key":"combining: é"} acento combinado
	( Diccionario crear poner: ['combining: e\u0301'] en: ['key'] ) ;
	# {"key":"escaped unicode: é"} escape Unicode BMP
	( Diccionario crear poner: ['escaped unicode: \u00e9'] en: ['key'] ) ;
	# {"key":"escaped unicode: €"} escape Unicode BMP
	( Diccionario crear poner: ['escaped unicode: \u20ac'] en: ['key'] ) ;
	# {"key":"escaped unicode: 😀"} par sustituto UTF-16
	( Diccionario crear poner: ['escaped unicode: \ud83d\ude00'] en: ['key'] ) ;
	# {"key":""} valor vacío
	( Diccionario crear poner: [''] en: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} caracteres ASCII especiales
	( Diccionario crear poner: ['@ < > & = % + ? #'] en: ['key'] ) ;
	# {"key":"single quote: '"} comilla simple
	( Diccionario crear poner: ['''] en: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} varios escapes JSON
	( Diccionario crear poner: ['multiple: \" \\ \n \r \t'] en: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} texto ASCII más largo
	( Diccionario crear poner: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] en: ['key'] ) ;
	# {"key":" value"} espacio inicial
	( Diccionario crear poner: [' value'] en: ['key'] ) ;
	# {"key":"value "} espacio final
	( Diccionario crear poner: ['value '] en: ['key'] ) ;
	# {"key":" \t\n\r "} espacios en blanco
	( Diccionario crear poner: [' \t\n\r '] en: ['key'] )
	.

diccs cada: { :_ :d
	>> j := JSON jsonificar: d.
	>> a := JSON jsonificar: (Diccionario crear poner: d key en: ['key']).
	>> b := JSON jsonificar: (Diccionario crear poner: ['value'] en: d key).
	>> e := JSON objeto: a.
	>> f := JSON objeto: b.
	((e key = d key y: (f ? d key = ['value'])) o: (e key = ['NUL ?'])) verdadero: {
		Salida escribir: ['OK'], detener.
	}, otro: {
		Salida escribir: ['No se pudo codificar/decodificar correctamente: '] + d + j, detener.
		Programa finalizar.
	}.
}.
