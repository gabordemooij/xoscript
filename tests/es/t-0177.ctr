

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa orden: 0.

>> txt := [' Word Salad '].
txt := txt reemplazar: ['Word'] con: ['Ceasar'].
txt := txt recortar.
Salida escribir: txt, detener.

Programa limpiar-memoria.

usedMemory1 := (Programa memoria ? 0).


txt := [' Word Salad '].
txt := txt reemplazar: ['Word'] con: ['Ceasar'].
txt := txt recortar.
Salida escribir: txt, detener.

Programa limpiar-memoria.
usedMemory2 := (Programa memoria ? 0).


txt := [' Word Salad '].
txt := txt reemplazar: ['Word'] con: ['Ceasar'].
txt := txt recortar.
Salida escribir: txt, detener.

Programa limpiar-memoria.
usedMemory3 := (Programa memoria ? 0).



( usedMemory1 = usedMemory2 y: usedMemory1 = usedMemory3, y: usedMemory2 = usedMemory3 ) verdadero: {
	Salida escribir: ['No memory leaks here'].
}, falso: {
	Salida escribir: ['Leaking memory...'].
}.
