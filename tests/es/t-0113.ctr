Salida escribir: ['Continue for-loop, No - before 6 and up.'], detener.
{ :i
	Salida escribir: (i + 1), detener.
	((i + 1) > 4) continuar.
	Salida escribir: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Salida detener.
Salida escribir: ['Continue while-true, No --> before 5 and up.'], detener.
{
	Salida escribir: ['iteration #'] + x, detener.
	x añadir: 1.
	((x < 5) no) continuar.
	Salida escribir: ['-->'].
} mientras: xIsLessThan10.
Salida detener.
Salida escribir: ['Continue while-false, No - before 3 only.'], detener.
{
	Salida escribir: ['iteration #'] + x, detener.
	x restar: 1.
	(x = 3) continuar.
	Salida escribir: ['-'].
} mientras: { <- ( x > 0). }.

Salida detener.
Salida escribir: ['Continue times-loop, No ||| before 3.'], detener.
{ :i
	Salida escribir: ['iteration #'] + i, detener.
	(i = 2) continuar.
	Salida escribir: ['|||'].
} × 5.

Salida detener.

{ Verdadero continuar. Salida escribir: ['dont write this!'], detener. } empezar.

{ Verdadero continuar. Salida escribir: ['dont write this!'], detener. } capturar: { Salida escribir: ['Dont catch this!']. }, empezar.

Salida escribir: ['Test Array each-loop: 0, ... ,2'], detener.
(Lista ← 1 ; 2 ; 3) diccionario: { :i
	(i = 1) continuar.
	Salida escribir: ['iteration #'] + (i - 0), detener.
}.

Salida escribir: ['Test Map each-loop: c only'], detener.
>> m := Diccionario crear.
m poner: ['first'] en: ['a'], poner: ['second'] en: ['b'], poner: ['third'] en: ['c'].
m cada: { :k :v
	(k ≠ ['c']) continuar.
	Salida escribir: ['iteration'] + k + v, detener.
}.

