Salida escribir: ['Continuar bucle for, No - antes de 6 y más.'], detener.
{ :i
	Salida escribir: (i + 1), detener.
	((i + 1) > 4) continuar.
	Salida escribir: ['-'].
} × 10.

>> x := 0.
>> xEsMenorQue10 := { <- ( x < 10 ). }.
Salida detener.
Salida escribir: ['Continuar while-true, No --> antes de 5 y más.'], detener.
{
	Salida escribir: ['iteration #'] + x, detener.
	x añadir: 1.
	((x < 5) no) continuar.
	Salida escribir: ['-->'].
} mientras: xEsMenorQue10.
Salida detener.
Salida escribir: ['Continuar while-false, No - solo antes de 3.'], detener.
{
	Salida escribir: ['iteration #'] + x, detener.
	x restar: 1.
	(x = 3) continuar.
	Salida escribir: ['-'].
} mientras: { <- ( x > 0). }.

Salida detener.
Salida escribir: ['Continuar bucle times, No ||| antes de 3.'], detener.
{ :i
	Salida escribir: ['iteration #'] + i, detener.
	(i = 2) continuar.
	Salida escribir: ['|||'].
} × 5.

Salida detener.

{ Verdadero continuar. Salida escribir: ['¡no escribas esto!'], detener. } empezar.

{ Verdadero continuar. Salida escribir: ['¡no escribas esto!'], detener. } capturar: { Salida escribir: ['¡No captures esto!']. }, empezar.

Salida escribir: ['Prueba de bucle each en Lista: 0, ... ,2'], detener.
(Lista ← 1 ; 2 ; 3) diccionario: { :i
	(i = 1) continuar.
	Salida escribir: ['iteration #'] + (i - 0), detener.
}.

Salida escribir: ['Prueba de bucle each en Diccionario: solo c'], detener.
>> m := Diccionario crear.
m poner: ['first'] en: ['a'], poner: ['second'] en: ['b'], poner: ['tercero'] en: ['c'].
m cada: { :k :v
	(k ≠ ['c']) continuar.
	Salida escribir: ['iteration'] + k + v, detener.
}.

