# una comilla que nunca se cierra debe dar un error, no un bucle infinito
>> ruta := ['/tmp/test0821.csv'].
>> file := Archivo crear: ruta.

file escribir: ['a,b\n"1,2\n'].
{
	file separador: [','] comillas: ['"'] reglas: { :line
		Salida escribir: line, detener.
	}.
} capturar: { :e Salida escribir: e, detener. }, empezar.

# una comilla cerrada sigue funcionando
file escribir: ['a,b\n"1,2",3'].
file separador: [','] comillas: ['"'] reglas: { :line
	Salida escribir: line, detener.
}.
file eliminar.
