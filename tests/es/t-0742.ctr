Salida escribir: ['Test object'], detener.
>> a := Objeto crear. 

a al: ['item:'] hacer: { :hexhelper
	mi hexhelper := hexhelper. 
}.

a al: ['item'] hacer: { <- mi hexhelper.
}.

a item: Hx crear.

>> old-hexhelper-address := a item prototipo dirección-de-memoria.
a save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RELOADING SNAP:'], detener.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b item prototipo dirección-de-memoria = old-hexhelper-address) verdadero: {
	Salida escribir: ['Object link re-attached.'], detener.
}.
