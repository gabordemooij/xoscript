Salida escribir: ['Objeto de prueba'], detener.
>> a := Objeto crear. 

a al: ['item:'] hacer: { :ayudantehex
	mi ayudantehex := ayudantehex. 
}.

a al: ['artículo'] hacer: {
	<- mi ayudantehex.
}.

a item: Hx crear.

>> antigua-dirección-ayudantehex := a artículo prototipo dirección-de-memoria.
a save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RECARGANDO SNAP:'], detener.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b artículo prototipo dirección-de-memoria = antigua-dirección-ayudantehex) verdadero: {
	Salida escribir: ['Enlace de objeto reconectado.'], detener.
}.
