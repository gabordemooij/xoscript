# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB crear host: ['localhost'],
	usuario: ['xo'],
	contraseña: ['pass123'],
	nombre-base-datos: ['xobase'],
	conectar.

>> consulta := db consultar: ['SELECT %% FROM'].
{ consulta ejecutar. } capturar: { :e
	Salida escribir: ( e contiene: ['%%'] ), detener.
}, empezar.
