# los mensajes de error de la base de datos no deben tratarse como cadenas de formato
Server init.

>> bd := Maria-DB crear host: ['localhost'],
	usuario: ['xo'],
	contraseña: ['pass123'],
	nombre-base-datos: ['xobase'],
	conectar.

>> consulta := bd consultar: ['SELECT %% FROM'].
{ consulta ejecutar. } capturar: { :e
	Salida escribir: ( e contiene: ['%%'] ), detener.
}, empezar.
