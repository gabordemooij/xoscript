# Probar el saneador de utf8
Server init.

>> casosutf8 := Diccionario crear
	# solo ASCII
	poner: ( Lista crear ; 65 ; 65 ; 65 ; 65 ; 0 ) en: ['AAAA'],
	# secuencia válida de 2 bytes
	poner: ( Lista crear ; 194 ; 162 ; 0 ) en: ['¢'],
	# UTF-8 válido de 3 bytes
    poner: ( Lista crear ; 226 ; 130 ; 172 ; 0 ) en: ['€'],
	# UTF-8 válido de 4 bytes
    poner: ( Lista crear ; 240 ; 144 ; 141 ; 136 ; 0 ) en: ['𐍈'],
	# Byte de continuación inválido en la secuencia E2 28 AC -> inicia secuencia de 3b + 28 cont. erróneo + AC byte cont., pero pertenece al mismo error
    poner: ( Lista crear ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) en: ['A?A'],
	# Codificación demasiado larga de la 'A' ASCII (debería convertirse en ?),
    poner: ( Lista crear ; 65 ; 193 ; 129 ; 0 ) en: ['A?'],
	# Primer byte inválido (0xFF)
    poner: ( Lista crear ; 255 ; 0 ) en: ['?'],
	# Secuencia multibyte incompleta al final
    poner: ( Lista crear ; 66 ; 226 ; 0 ) en: ['B?'],
    # Texto vacío
    #put: ( List new ) at: [''],
	# Varias secuencias mezcladas
    poner: ( Lista crear ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) en: ['A€?𐍈B'].
	 
casosutf8 cada: { :key :value
	>> blob := Blob crear: value contar, bytes: value.
	>> str := blob texto.
	(str = key) verdadero: {
		Salida escribir: ['OK'], detener.
	}, otro: {
		Salida escribir: ['El saneador UTF8 falló en: '] + key + [' obtuvo: '] + str, detener.
	}.
	blob liberar.
}.
