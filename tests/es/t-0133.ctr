


>> Baraja := Lista crear.
Baraja al: ['imprimir'] hacer: {
        >> len := yo contar - 1.
        { :i
                >> long2 := yo contar - 1.
                Salida escribir: ['long: '].
                Salida escribir: len, detener.
                Salida escribir: ['long2: '].
                Salida escribir: long2, detener.
        } × len.
}.

>> d := Baraja ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d imprimir.
