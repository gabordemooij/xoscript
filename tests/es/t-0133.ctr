


>> Deck := Lista crear.
Deck al: ['print'] hacer: {
        >> len := yo contar - 1.
        { :i
                >> len2 := yo contar - 1.
                Salida escribir: ['len: '].
                Salida escribir: len, detener.
                Salida escribir: ['len2: '].
                Salida escribir: len2, detener.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
