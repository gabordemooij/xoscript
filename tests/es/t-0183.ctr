

>> memoriaUsada1 := 0.
>> memoriaUsada2 := 0.
>> memoriaUsada3 := 0.
>> memoriaUsada4 := 0.

Programa orden: 0.

>> o := Objeto crear.
>> o2 := Objeto crear.
Salida escribir: o ¿nulo?, detener.
Salida escribir: o tipo, detener.
Salida escribir: ( o es: o ), detener.
Salida escribir: ( o es: o2 ), detener.
Salida escribir: o yo-mismo, detener.
Salida escribir: ( o hacer hecho ), detener.

Programa limpiar-memoria.

memoriaUsada1 := (Programa memoria ? 0).


o := Objeto crear.
o2 := Objeto crear.
Salida escribir: o ¿nulo?, detener.
Salida escribir: o tipo, detener.
Salida escribir: ( o es: o ), detener.
Salida escribir: ( o es: o2 ), detener.
Salida escribir: o yo-mismo, detener.
Salida escribir: ( o hacer hecho ), detener.

Programa limpiar-memoria.
memoriaUsada2 := (Programa memoria ? 0).


o := Objeto crear.
o2 := Objeto crear.
Salida escribir: o ¿nulo?, detener.
Salida escribir: o tipo, detener.
Salida escribir: ( o es: o ), detener.
Salida escribir: ( o es: o2 ), detener.
Salida escribir: o yo-mismo, detener.
Salida escribir: ( o hacer hecho ), detener.

Programa limpiar-memoria.
memoriaUsada3 := (Programa memoria ? 0).



( memoriaUsada1 = memoriaUsada2 y: memoriaUsada1 = memoriaUsada3, y: memoriaUsada2 = memoriaUsada3 ) verdadero: {
	Salida escribir: ['Aquí no hay fugas de memoria'].
}, falso: {
	Salida escribir: ['Fuga de memoria...'].
}.
