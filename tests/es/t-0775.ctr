Salida escribir: ['Test object'], detener.
>> l := Lista crear ; 1 ; ( Lista crear ; (Momento crear: 1) ; (Int64 desde-texto: ['321']) ; (Lista crear ; 3)).
Salida escribir: l, detener.
>> old-lst-address := l prototipo dirección-de-memoria.
l save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RELOADING SNAP:'], detener.
>> b := Objeto load-from: ['/tmp/a.bin'].
(b prototipo dirección-de-memoria = old-lst-address) verdadero: {
	Salida escribir: ['Object link re-attached.'], detener.
}.
Salida escribir: b, detener.
