Salida escribir: ['Objeto de prueba'], detener.
>> l := Lista crear ; 1 ; ( Lista crear ; (Momento crear: 1) ; (Int64 desde-texto: ['321']) ; (Lista crear ; 3)).
Salida escribir: l, detener.
>> antigua-dirección-lst := l prototipo dirección-de-memoria.
l save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RECARGANDO SNAP:'], detener.
>> b := Objeto load-from: ['/tmp/a.bin'].
(b prototipo dirección-de-memoria = antigua-dirección-lst) verdadero: {
	Salida escribir: ['Enlace de objeto reconectado.'], detener.
}.
Salida escribir: b, detener.
