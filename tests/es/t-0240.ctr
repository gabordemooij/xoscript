# prueba de calificadores

>> $ := Objeto crear.

$ al: ['responder:'] hacer: { :x
	
	>> operación := x caracter: 0.
	>> divisa := x caracter: 1.
	>> dinero := x saltar: 2.
	
	>> cantidad := 0.

	( operación = ['+'] ) verdadero: {
		( divisa = ['£'] ) verdadero: { cantidad := 1.28 × dinero. }.
	}. <- cantidad.
}.



>> x := $ +£20.

Salida escribir: x, detener.


>> Fruta := Objeto crear.

Fruta al: ['crear'] hacer: {
	>> f := yo crear.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruta al: ['apples:'] hacer: { :a mi manzanas := a. }.
Fruta al: ['oranges:'] hacer: { :p mi naranjas := p. }.
Fruta al: ['manzanas'] hacer: { <- mi manzanas. }.
Fruta al: ['naranjas'] hacer: { <- mi naranjas. }.

Fruta al: ['+'] hacer: { :f
	
	>> n := Fruta crear.
	f añadir: 1.
	
	n apples: (f manzanas + mi manzanas).
	n oranges:  (f naranjas  + mi naranjas). <- n.
}.

Fruta al: ['texto'] hacer: { <- ( mi manzanas texto + [' manzanas y '] + mi naranjas + [' naranjas'] ).
}.

Número al: ['manzanas'] hacer: { <- ((Fruta crear) apples: yo).
}.

Número al: ['manzana'] hacer: { <- ((Fruta crear) apples: yo).
}.

Número al: ['naranjas'] hacer: { <- ((Fruta crear) oranges: yo).
}.




Salida escribir: (1 manzana + 3 naranjas + 4 manzanas), detener.


Texto al: ['dosVeces'] hacer: { <- ((yo texto) + (yo texto)).
}.



Salida escribir: ['❤❤❤'] dosVeces.



