# test qualifiers

>> $ := Objeto crear.

$ al: ['responder:'] hacer: { :x
	
	>> operation := x caracter: 0.
	>> valuta := x caracter: 1.
	>> money := x saltar: 2.
	
	>> amount := 0.

	( operation = ['+'] ) verdadero: {
		( valuta = ['£'] ) verdadero: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Salida escribir: x, detener.


>> Fruit := Objeto crear.

Fruit al: ['crear'] hacer: {
	>> f := yo crear.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit al: ['apples:'] hacer: { :a mi apples := a. }.
Fruit al: ['oranges:'] hacer: { :p mi oranges := p. }.
Fruit al: ['apples'] hacer: { <- mi apples. }.
Fruit al: ['oranges'] hacer: { <- mi oranges. }.

Fruit al: ['+'] hacer: { :f
	
	>> n := Fruit crear.
	f añadir: 1.
	
	n apples: (f apples + mi apples).
	n oranges:  (f oranges  + mi oranges). <- n.
}.

Fruit al: ['texto'] hacer: { <- ( mi apples texto + [' apples and '] + mi oranges + [' oranges'] ).
}.

Número al: ['apples'] hacer: { <- ((Fruit crear) apples: yo).
}.

Número al: ['apple'] hacer: { <- ((Fruit crear) apples: yo).
}.

Número al: ['oranges'] hacer: { <- ((Fruit crear) oranges: yo).
}.




Salida escribir: (1 apple + 3 oranges + 4 apples), detener.


Texto al: ['twice'] hacer: { <- ((yo texto) + (yo texto)).
}.



Salida escribir: ['❤❤❤'] twice.



