>> Point := Objeto crear.
Point al: ['x-coordinate:'] hacer: { :x mi x := x. }.
Point al: ['y-coordinate:'] hacer: { :y mi y := y. }.
Point al: ['x-coordinate']  hacer: { <- mi x copiar. }.
Point al: ['y-coordinate']  hacer: { <- mi y copiar. }.

Point al: ['='] hacer: { :other <- ( mi x = other x-coordinate
		 y: mi y = other y-coordinate ).
}.

>> pier := Point crear x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point crear x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point crear x-coordinate: 5, y-coordinate: 6.

Salida escribir: pier = town-hall, detener.
Salida escribir: pier = restaurant, detener.
