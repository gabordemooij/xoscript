>> Punto := Objeto crear.
Punto al: ['x-coordinate:'] hacer: { :x mi x := x. }.
Punto al: ['y-coordinate:'] hacer: { :y mi y := y. }.
Punto al: ['coordenada-x']  hacer: { <- mi x copiar. }.
Punto al: ['coordenada-y']  hacer: { <- mi y copiar. }.

Punto al: ['='] hacer: { :otroPunto
	<- ( mi x = otroPunto coordenada-x
		 y: mi y = otroPunto coordenada-y ).
}.

>> muelle := Punto crear x-coordinate: 5, y-coordinate: 6.
>> ayuntamiento := Punto crear x-coordinate: 7, y-coordinate: 1.
>> restaurante := Punto crear x-coordinate: 5, y-coordinate: 6.

Salida escribir: muelle = ayuntamiento, detener.
Salida escribir: muelle = restaurante, detener.
