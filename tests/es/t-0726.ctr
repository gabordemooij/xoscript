# prueba de búferes PKI/Sign 
Server init.

>> largo := ( Lista crear llenar: 1000 con: ['a'] ) unir: [''].

# firmar un mensaje
Salida escribir: ( 
	Contenedor-seguro firmar: ['abc'] con: largo
), detener.

Salida escribir: ( 
	Contenedor-seguro
		verificar: ['abc'] 
		firma: largo 
		con: largo
), detener.

Salida escribir: (
	Contenedor-seguro verificar-hash: largo contraseña: largo
), detener.
