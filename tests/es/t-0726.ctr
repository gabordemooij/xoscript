# test buffers PKI/Sign 
Server init.

>> long := ( Lista crear llenar: 1000 con: ['a'] ) unir: [''].

# sign a message
Salida escribir: ( 
	Contenedor-seguro firmar: ['abc'] con: long
), detener.

Salida escribir: ( 
	Contenedor-seguro
		verificar: ['abc'] 
		firma: long 
		con: long
), detener.

Salida escribir: (
	Contenedor-seguro verificar-hash: long contraseña: long
), detener.
