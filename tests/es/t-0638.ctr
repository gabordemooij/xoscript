
Server init.
>> pt := Petición-HTTP crear.
Salida escribir: ['HTTP-GET d[]=']  + ( pt obtener-lista: ['d[]'] ), detener. # GET
Salida escribir: ['HTTP-GET f[]=']  + ( pt obtener-lista: ['f[]'] ), detener. # GET
Salida escribir: ['HTTP-POST e[]='] + ( pt enviar-lista: ['e[]'] ), detener. # GET
Salida escribir: ['HTTP-POST c=']   + ( pt enviar: ['c'] ), detener. # GET
Salida escribir: ['HTTP-POST xx=']  + ( pt enviar: ['xx'] ), detener. # GET
