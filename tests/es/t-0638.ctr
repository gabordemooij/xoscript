
Server init.
>> rq := Petición-HTTP crear.
Salida escribir: ['HTTP-GET d[]=']  + ( rq obtener-lista: ['d[]'] ), detener. # GET
Salida escribir: ['HTTP-GET f[]=']  + ( rq obtener-lista: ['f[]'] ), detener. # GET
Salida escribir: ['HTTP-POST e[]='] + ( rq enviar-lista: ['e[]'] ), detener. # GET
Salida escribir: ['HTTP-POST c=']   + ( rq enviar: ['c'] ), detener. # GET
Salida escribir: ['HTTP-POST xx=']  + ( rq enviar: ['xx'] ), detener. # GET
