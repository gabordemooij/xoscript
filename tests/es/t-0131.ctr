
>> a := Lista ← (Lista ← 100 ; 200 ; 300) ; (Lista ← 9 ; 8 ; 7).
Salida escribir: ['en 0,1 :'].
Salida escribir: a ? 0 ? 1, detener. 
Salida escribir: ['en 1,2 :'].
Salida escribir: a ? 1 ? 2, detener. 
>> menú := Diccionario crear.
menú poner: (Lista ← ['pizza'] ; ['espaguetis']) en: ['Cocina italiana'].
menú poner: (Lista ← ['bifteki'] ; ['suflaki']) en: ['Cocina griega'].
Salida escribir: ['Me encantan '] + (menú ? ['Cocina griega'] ? 0) + [' y '] + (menú ? ['Cocina italiana'] ? 1), detener. 
Salida escribir: ['pero no en el mismo plato.'], detener.
