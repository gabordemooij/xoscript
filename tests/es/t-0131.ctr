
>> a := Lista ← (Lista ← 100 ; 200 ; 300) ; (Lista ← 9 ; 8 ; 7).
Salida escribir: ['at 0,1 :'].
Salida escribir: a ? 0 ? 1, detener. 
Salida escribir: ['at 1,2 :'].
Salida escribir: a ? 1 ? 2, detener. 
>> menu := Diccionario crear.
menu poner: (Lista ← ['pizza'] ; ['spaghetti']) en: ['Italian Cuisine'].
menu poner: (Lista ← ['bifteki'] ; ['suflaki']) en: ['Greek Cuisine'].
Salida escribir: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), detener. 
Salida escribir: ['but not on the same plate.'], detener.
