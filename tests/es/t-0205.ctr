>> str := ['write:'].
Salida mensaje: ['escribir:'] argumentos: (Lista ← ['Hello World']), detener. 

Número al: ['isbetween:and:'] hacer: { :a :b <- ((yo ≥ a) y: (yo ≤ b)).
}.

str := ['isbetween:and:'].
Salida escribir: (3 mensaje: str argumentos: (Lista ← 2 ; 8)), detener.
Salida escribir: (3 mensaje: str argumentos: (Lista ← 1 ; 2)), detener.


>> Cafetera := Objeto crear.
Cafetera al: ['makeCoffeeWithSugar:milk:'] hacer: { :sugar :milk <- ( ['Aquí tienes... café con '] + 
			sugar +
			[' cucharadas de azúcar y '] +
			milk +
			[' gotas de leche.']
	).
}.

>> pedido := ['makeCoffeeWithSugar:milk:'].
>> configuraciónCafé := Lista ← 4 ; 2.
Salida escribir: ( Cafetera mensaje: pedido argumentos: configuraciónCafé ), detener.
