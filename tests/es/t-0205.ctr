>> str := ['write:'].
Salida mensaje: ['escribir:'] argumentos: (Lista ← ['Hello World']), detener. 

Número al: ['isbetween:and:'] hacer: { :a :b <- ((yo ≥ a) y: (yo ≤ b)).
}.

str := ['isbetween:and:'].
Salida escribir: (3 mensaje: str argumentos: (Lista ← 2 ; 8)), detener.
Salida escribir: (3 mensaje: str argumentos: (Lista ← 1 ; 2)), detener.


>> CoffeeMachine := Objeto crear.
CoffeeMachine al: ['makeCoffeeWithSugar:milk:'] hacer: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Lista ← 4 ; 2.
Salida escribir: ( CoffeeMachine mensaje: order argumentos: coffeeConfiguration ), detener.
