>> q := Lista ← 1 ; 2 ; 3.
{ q ? ['1']. } capturar: { Salida escribir: ['¡capturado!'], detener. }, empezar.
{ q ? Verdadero. } capturar: { Salida escribir: ['¡capturado!'], detener. }, empezar.
{ q ? Falso. } capturar: { Salida escribir: ['¡capturado!'], detener. }, empezar.
{ q ? Nulo. } capturar: { Salida escribir: ['¡capturado!'], detener. }, empezar.
{ q ? (Lista crear). } capturar: { Salida escribir: ['¡capturado!'], detener. }, empezar.
{ q ? (Objeto crear). } capturar: { Salida escribir: ['¡capturado!'], detener. }, empezar.
{ q ? ({ ['Vacío']. }). } capturar: { Salida escribir: ['¡capturado!'], detener. }, empezar.
Salida escribir: ['los capturé todos'], detener.
