Salida escribir: ['Objeto de prueba'], detener.
>> a := Objeto crear. 

a al: ['item:'] hacer: { :nil
	mi nil := nil. 
}.

a al: ['artículo'] hacer: {
	<- mi nil.
}.

a item: Nulo.

Salida escribir: a artículo, detener.

>> antigua-dirección-nil := a artículo prototipo dirección-de-memoria.
a save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RECARGANDO SNAP:'], detener.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b artículo prototipo dirección-de-memoria = antigua-dirección-nil) verdadero: {
	Salida escribir: ['Enlace de objeto reconectado.'], detener.
}.

Salida escribir: b artículo, detener.
