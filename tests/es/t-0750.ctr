Salida escribir: ['Test object'], detener.
>> a := Objeto crear. 

a al: ['item:'] hacer: { :nil
	mi nil := nil. 
}.

a al: ['item'] hacer: { <- mi nil.
}.

a item: Nulo.

Salida escribir: a item, detener.

>> old-nil-address := a item prototipo dirección-de-memoria.
a save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RELOADING SNAP:'], detener.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b item prototipo dirección-de-memoria = old-nil-address) verdadero: {
	Salida escribir: ['Object link re-attached.'], detener.
}.

Salida escribir: b item, detener.
