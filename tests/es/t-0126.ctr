#Linux
>> Sorbedor := Objeto crear.

Sorbedor al: ['crear'] hacer: {
	mi str := [''].
}.

Sorbedor al: ['nieuw'] hacer: {
	mi str := [''].
}.

Sorbedor al: ['responder:'] hacer: { :blah
		mi str adjuntar: blah.
}.

Sorbedor al: ['responder:y:'] hacer: { :blah :blahah
		mi str adjuntar: (blah desde: 0 longitud: (blah longitud - 1)).
		mi str adjuntar: [' '].
		mi str adjuntar: blahah.
}.

Sorbedor al: ['recoger'] hacer: {
	>> búfer := mi str.
	mi str := ['']. <- búfer.
}.


Salida escribir: (Programa sistema: (Sorbedor crear echo: ['¡Hola, puedo escribir en la consola con una API fluida!'], recoger)).


{ Archivo crear: ['/tmp/from.txt'], eliminar. } capturar: { ['Vacío']. }, empezar.
{ Archivo crear: ['/tmp/to.txt'], eliminar. } capturar: { ['Vacío']. }, empezar.


Archivo crear: ['/tmp/to.txt'], existe falso: {
	Salida escribir: ['Confirmed. Target file does not exist.\
'].
}.
Archivo crear: ['/tmp/from.txt'], existe falso: {
	Salida escribir: ['Confirmed. Source file does not exist.\
'].
}.



Programa sistema: (Sorbedor crear touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], recoger).



Programa sistema: (Sorbedor crear cp: ['/tmp/from.txt /tmp/to.txt'], recoger).

Archivo crear: ['/tmp/to.txt'], existe verdadero: {
	Salida escribir: ['Confirmed. Target file has been created by shell.\
'].
}.


Salida escribir: ['El contenido del archivo es:'] + (Archivo crear: ['/tmp/to.txt'], leer), detener.
