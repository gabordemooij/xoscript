>> crearSumador := { :x
	>> f := { :y <- (mi x + y). } valor: ['x'] asignar: x. <- f.
}.
>> mapeador := { :arreglo :func
	>> mapeo := { :i mi q poner: (mi f aplicar: (mi q ? i)) en: i. } 
	valor: ['q'] asignar: arreglo,
	valor: ['f'] asignar: func.
	{ :i mapeo aplicar: i. } × (arreglo contar).
}.

>> a := Lista ← 1; 2; 3.
mapeador aplicar: a y: (crearSumador aplicar: 100).
Salida escribir: (a posición: 0), detener.
Salida escribir: (a ? 1), detener.
Salida escribir: (a ? 2), detener.
