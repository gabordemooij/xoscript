>> makeAdder := { :x
	>> f := { :y <- (mi x + y). } valor: ['x'] asignar: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i mi q poner: (mi f aplicar: (mi q ? i)) en: i. } 
	valor: ['q'] asignar: array,
	valor: ['f'] asignar: func.
	{ :i mapping aplicar: i. } × (array contar).
}.

>> a := Lista ← 1; 2; 3.
mapper aplicar: a y: (makeAdder aplicar: 100).
Salida escribir: (a posición: 0), detener.
Salida escribir: (a ? 1), detener.
Salida escribir: (a ? 2), detener.
