Salida escribir: ['1,2,3,4,5,6,7,8,9,A,'], detener.
>> Ámbito := Objeto crear.
Ámbito al: ['initialize:'] hacer: { :x mi propiedad := x. }.
Ámbito al: ['comprobar'] hacer: { Salida escribir: [',']. }.
Ámbito al: ['pruebas'] hacer: {
	Salida escribir: mi propiedad.
	yo comprobar.
	( 1 = 1 ) verdadero: { Salida escribir: mi propiedad. yo comprobar. }.
	( 1 = 0 ) falso: { Salida escribir: mi propiedad. yo comprobar. }.
	>> y := 2. { Salida escribir: mi propiedad. yo comprobar. } mientras: { y restar: 1. <- (y > 0). }.
	{ Salida escribir: mi propiedad. yo comprobar. } × 1.
	(Lista ← 1) cada: {  Salida escribir: mi propiedad. yo comprobar. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo implementar ordenación propia, esta prueba falla por el distinto número de iteraciones según la plataforma
	(Diccionario crear one: ['item']) cada: { Salida escribir: mi propiedad. yo comprobar. }.
	{ 1 ÷ 0. } capturar: { Salida escribir: mi propiedad. yo comprobar. }, empezar.
	Salida detener.
}.
>> ámbito1 := Ámbito crear.
ámbito1 initialize: ['X'].
ámbito1 pruebas.
>> laFunción := { 
	mi propiedad := ['Y'].
	Salida escribir: mi propiedad.
	yo comprobar.
	( 1 = 1 ) verdadero: { Salida escribir: mi propiedad. yo comprobar. }.
	( 1 = 0 ) falso: { Salida escribir: mi propiedad. yo comprobar. }.
	>> y := 2. { Salida escribir: mi propiedad. yo comprobar. } mientras: { y restar: 1. <- (y > 0). }.
	{ Salida escribir: mi propiedad. yo comprobar. } × 1.
	(Lista ← 1) cada: {  Salida escribir: mi propiedad. yo comprobar. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Diccionario crear one: ['item']) cada: { Salida escribir: mi propiedad. yo comprobar. }.
	{ 1 ÷ 0. } capturar: { Salida escribir: mi propiedad. yo comprobar. }, empezar.
	Salida detener.
}.
laFunción al: ['comprobar'] hacer: { Salida escribir: [',']. }.
laFunción aplicar: 1 y: 2.
