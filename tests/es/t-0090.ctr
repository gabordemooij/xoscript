Salida escribir: ['1,2,3,4,5,6,7,8,9,A,'], detener.
>> Scope := Objeto crear.
Scope al: ['initialize:'] hacer: { :x mi property := x. }.
Scope al: ['confirm'] hacer: { Salida escribir: [',']. }.
Scope al: ['pruebas'] hacer: {
	Salida escribir: mi property.
	yo confirm.
	( 1 = 1 ) verdadero: { Salida escribir: mi property. yo confirm. }.
	( 1 = 0 ) falso: { Salida escribir: mi property. yo confirm. }.
	>> y := 2. { Salida escribir: mi property. yo confirm. } mientras: { y restar: 1. <- (y > 0). }.
	{ Salida escribir: mi property. yo confirm. } × 1.
	(Lista ← 1) cada: {  Salida escribir: mi property. yo confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Diccionario crear one: ['item']) cada: { Salida escribir: mi property. yo confirm. }.
	{ 1 ÷ 0. } capturar: { Salida escribir: mi property. yo confirm. }, empezar.
	Salida detener.
}.
>> scope1 := Scope crear.
scope1 initialize: ['X'].
scope1 pruebas.
>> function := { 
	mi property := ['Y'].
	Salida escribir: mi property.
	yo confirm.
	( 1 = 1 ) verdadero: { Salida escribir: mi property. yo confirm. }.
	( 1 = 0 ) falso: { Salida escribir: mi property. yo confirm. }.
	>> y := 2. { Salida escribir: mi property. yo confirm. } mientras: { y restar: 1. <- (y > 0). }.
	{ Salida escribir: mi property. yo confirm. } × 1.
	(Lista ← 1) cada: {  Salida escribir: mi property. yo confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Diccionario crear one: ['item']) cada: { Salida escribir: mi property. yo confirm. }.
	{ 1 ÷ 0. } capturar: { Salida escribir: mi property. yo confirm. }, empezar.
	Salida detener.
}.
function al: ['confirm'] hacer: { Salida escribir: [',']. }.
function aplicar: 1 y: 2.
