# un grupo que no forma parte de la coincidencia no debe provocar un fallo grave y debe conservar los números de grupo
Server init.
>> mostrar := { :patrón :subject
	>> p := Patrón crear: patrón.
	p coincidir: subject ejecutar: { :m :g
		Salida escribir: g contar, escribir: [' '], escribir: (g unir: ['|']), detener.
		<- m.
	}.
}.
mostrar aplicar: ['(a)|(b)'] y: ['b'].
mostrar aplicar: ['(a)|(b)'] y: ['a'].
mostrar aplicar: ['(x)?y'] y: ['y'].
mostrar aplicar: ['(x)?(y)(z)?'] y: ['xy'].
