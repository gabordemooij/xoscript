# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Patrón crear: pattern.
	p coincidir: subject ejecutar: { :m :g
		Salida escribir: g contar, escribir: [' '], escribir: (g unir: ['|']), detener. <- m.
	}.
}.
show aplicar: ['(a)|(b)'] y: ['b'].
show aplicar: ['(a)|(b)'] y: ['a'].
show aplicar: ['(x)?y'] y: ['y'].
show aplicar: ['(x)?(y)(z)?'] y: ['xy'].
