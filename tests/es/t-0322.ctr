

>> Matryoshka := Objeto crear.
Matryoshka al: ['double:'] hacer: { :secret
	mi secret := secret × 2.
}.
Matryoshka al: ['crear:'] hacer: { :secret
	>> answer := Nulo.
	>> t := (secret > 255).
	Salida escribir: (secret + [' | '] + t), detener.
	t verdadero: {
		answer := secret.
	}, otro: {
		answer := Matryoshka recursivo crear: (yo double: secret).
	}. <- answer.
}.

>> x := Matryoshka crear: 2.
