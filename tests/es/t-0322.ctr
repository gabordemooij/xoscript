

>> Matrioska := Objeto crear.
Matrioska al: ['double:'] hacer: { :secreto
	mi secreto := secreto × 2.
}.
Matrioska al: ['crear:'] hacer: { :secreto
	>> contestación := Nulo.
	>> t := (secreto > 255).
	Salida escribir: (secreto + [' | '] + t), detener.
	t verdadero: {
		contestación := secreto.
	}, otro: {
		contestación := Matrioska recursivo crear: (yo double: secreto).
	}. <- contestación.
}.

>> x := Matrioska crear: 2.
