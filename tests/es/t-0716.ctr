Salida escribir: ['Objeto de prueba'], detener.
>> a := Objeto crear. 

a al: ['state:'] hacer: { :list
	mi list := list. 
}.

a al: ['estado'] hacer: {
	Salida escribir: mi list, detener.
}.

a state: ( Lista crear ; ['elementolista'] ; ['artículo2'] ).
a estado.

a save-as: ['/tmp/a.bin'].
