Programa orden: 4.

>> Duplicador := Objeto crear.
>> Multiplicador := Objeto crear.
Duplicador al: ['duplicar:y:'] hacer: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplicador al: ['multiplicar:y:'] hacer: { :x :y <- (x × y).
}.

Salida escribir: (
	Duplicador duplicar:
		(Duplicador duplicar: 
			(Multiplicador multiplicar: 2 y: 3)
		y:
			(Multiplicador multiplicar: 3 y: 4)
		)
	y:
		(Duplicador duplicar: 
			(Multiplicador multiplicar: 2 y: 3)
		y:
			(Multiplicador multiplicar: 3 y: 4)
		)
), detener.
