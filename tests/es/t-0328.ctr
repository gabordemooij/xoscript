Programa orden: 4.

>> Doubler := Objeto crear.
>> Multiplier := Objeto crear.
Doubler al: ['double:and:'] hacer: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier al: ['multiply:and:'] hacer: { :x :y <- (x × y).
}.

Salida escribir: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), detener.
