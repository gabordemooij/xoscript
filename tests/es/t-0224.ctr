
>> countries := Lista crear
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Lista crear
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods por: countries, cada: { :key :value
	counter añadir: 1.
}.

Salida escribir: (['we serve counter dishes'] counter: counter), detener.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] caracteres ordenar: { :v
	counter añadir: 0.
}.

Salida escribir: (['we sort counter dishes'] counter: counter), detener.


>> counter := 0.
{
	{
		counter añadir: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Salida escribir: (['we calculate counter numbers.'] counter: counter), detener.

