
>> países := Lista crear
	~ ['Suiza']
	~ ['Italia']
	~ ['Alemania'].

>> comidas := Lista crear
	~ ['Rösti']
	~ ['Espaguetis']
	~ ['Chucrut'].


>> contador := 0.
comidas por: países, cada: { :key :value
	contador añadir: 1.
}.

Salida escribir: (['we serve counter dishes'] counter: contador), detener.

>> contador := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] caracteres ordenar: { :v
	contador añadir: 0.
}.

Salida escribir: (['we sort counter dishes'] counter: contador), detener.


>> contador := 0.
{
	{
		contador añadir: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Salida escribir: (['we calculate counter numbers.'] counter: contador), detener.

