#Linux
>> clock := Momento crear.
clock zona: ['UTC-1'].
clock año: 1981, mes: 1, día: 5,
      hora: 13, minuto: 15, segundo: 13.

Salida escribir: clock, detener.
clock zona: ['UTC+0'].

Salida escribir: (
	(clock año bruto) + ['-'] + (clock mes) + ['-'] + (clock día) + [' '] +
	(clock hora) + [':'] + (clock minuto) + [':'] + (clock segundo) + [' '] +
	['W'] + (clock semana) + (clock zona)
), detener.


clock zona: ['UTC-1'].
Salida escribir: (
	(clock año bruto) + ['-'] + (clock mes) + ['-'] + (clock día) + [' '] +
	(clock hora) + [':'] + (clock minuto) + [':'] + (clock segundo) + [' '] +
	['W'] + (clock semana) + (clock zona)
), detener.
