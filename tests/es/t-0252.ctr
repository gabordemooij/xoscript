#Linux
>> reloj := Momento crear.
reloj zona: ['UTC-1'].
reloj año: 1981, mes: 1, día: 5,
      hora: 13, minuto: 15, segundo: 13.

Salida escribir: reloj, detener.
reloj zona: ['UTC+0'].

Salida escribir: (
	(reloj año bruto) + ['-'] + (reloj mes) + ['-'] + (reloj día) + [' '] +
	(reloj hora) + [':'] + (reloj minuto) + [':'] + (reloj segundo) + [' '] +
	['W'] + (reloj semana) + (reloj zona)
), detener.


reloj zona: ['UTC-1'].
Salida escribir: (
	(reloj año bruto) + ['-'] + (reloj mes) + ['-'] + (reloj día) + [' '] +
	(reloj hora) + [':'] + (reloj minuto) + [':'] + (reloj segundo) + [' '] +
	['W'] + (reloj semana) + (reloj zona)
), detener.
