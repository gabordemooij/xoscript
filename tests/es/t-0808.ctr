# las claves y firmas de Contenedor-seguro que decodifican demasiado largas no deben desbordar la pila
Server init.

>> claves := Contenedor-seguro claves-criptográficas.
>> sk := claves primero.
>> pk := claves último.
>> firma := Contenedor-seguro firmar: ['abc'] con: sk.

# 88 caracteres sin relleno decodifican a 66 bytes
>> largo := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 caracteres sin relleno decodifican a 33 bytes
>> corto := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Contenedor-seguro firmar: ['abc'] con: largo. } capturar: { :e
	Salida escribir: e, detener.
}, empezar.

{ Contenedor-seguro verificar: ['abc'] firma: largo con: pk. } capturar: { :e
	Salida escribir: e, detener.
}, empezar.

{ Contenedor-seguro verificar: ['abc'] firma: firma con: corto. } capturar: { :e
	Salida escribir: e, detener.
}, empezar.
