Salida escribir: ['Objeto de prueba'], detener.
>> a := Objeto crear. 

a al: ['item:'] hacer: { :sal
	mi sal := sal. 
}.

a al: ['artículo'] hacer: {
	<- mi sal.
}.

a al: ['saludar'] hacer: {
	Salida escribir: ['¡hola desde la salida original!'], detener.
}.

a item: Salida.

Salida escribir: a artículo, detener.

>> antigua-dirección-sal := a artículo prototipo dirección-de-memoria.
a save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RECARGANDO SNAP:'], detener.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b artículo prototipo dirección-de-memoria = antigua-dirección-sal) verdadero: {
	Salida escribir: ['Enlace de objeto reconectado.'], detener.
}.

b artículo escribir: ['¡hola desde la salida cargada!'], detener.
b saludar.
