Salida escribir: ['Test object'], detener.
>> a := Objeto crear. 

a al: ['item:'] hacer: { :out
	mi out := out. 
}.

a al: ['item'] hacer: { <- mi out.
}.

a al: ['greet'] hacer: {
	Salida escribir: ['hi from original out!'], detener.
}.

a item: Salida.

Salida escribir: a item, detener.

>> old-out-address := a item prototipo dirección-de-memoria.
a save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RELOADING SNAP:'], detener.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b item prototipo dirección-de-memoria = old-out-address) verdadero: {
	Salida escribir: ['Object link re-attached.'], detener.
}.

b item escribir: ['hello from loaded out!'], detener.
b greet.
