>> V := Objeto.
V al: ['texto'] hacer: {
	Salida escribir: ['conversión'], detener.
	<- ['abc'].
}.

Salida escribir: ( Programa configurar: ['abc'] ), detener.

# los parámetros no deben ser recolectados por el GC
Programa establecer: ([''] + V crear) valor: ([''] + V crear).

Salida escribir: ( Programa configurar: ['abc'] ), detener.
