#Linux
>> OS := Programa sistema: (Comando uname -s), recortar.

>> Slurp := Objeto crear.
Slurp al: ['crear'] hacer: {
	mi str := [''].
}.
Slurp al: ['responder:'] hacer: { :blah
		(mi str ≠ ['']) verdadero: {
			mi str adjuntar: [' '].
		}.
		mi str adjuntar: blah.
}.
Slurp al: ['responder:y:'] hacer: { :blah :blahah
		(mi str ≠ ['']) verdadero: {
			mi str adjuntar: [' '].
		}.
		(blah longitud > 1) verdadero: {
			mi str adjuntar: (blah desde: 0 longitud: (blah longitud - 1)).
		}, otro: {
			mi str adjuntar: blah.
		}.
		mi str adjuntar: [' '].
		mi str adjuntar: blahah.
}.
Slurp al: ['obtain'] hacer: {
	>> buffer := mi str.
	mi str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text adjuntar: ['hello'].
} × 1000.


Salida escribir: (
	Programa sistema: (
		Slurp crear
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

