#Linux
>> SO := Programa sistema: (Comando uname -s), recortar.

>> Sorbedor := Objeto crear.
Sorbedor al: ['crear'] hacer: {
	mi str := [''].
}.
Sorbedor al: ['responder:'] hacer: { :blah
		(mi str ≠ ['']) verdadero: {
			mi str adjuntar: [' '].
		}.
		mi str adjuntar: blah.
}.
Sorbedor al: ['responder:y:'] hacer: { :blah :blahah
		(mi str ≠ ['']) verdadero: {
			mi str adjuntar: [' '].
		}.
		(blah longitud > 1) verdadero: {
			mi str adjuntar: (blah desde: 0 longitud: (blah longitud - 1)).
		}, otro: {
			mi str adjuntar: blah.
		}.
		mi str adjuntar: [' '].
		mi str adjuntar: blahah.
}.
Sorbedor al: ['recoger'] hacer: {
	>> búfer := mi str.
	mi str := ['']. <- búfer.
}.
>> large text := [''].
{
	large text adjuntar: ['hello'].
} × 1000.


Salida escribir: (
	Programa sistema: (
		Sorbedor crear
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: SO)
		) recoger
).

