# menos parámetros que marcadores debe dar un error, no leer más allá de los enlaces
Server init.

>> bd := Maria-DB crear host: ['localhost'],
	usuario: ['xo'],
	contraseña: ['pass123'],
	nombre-base-datos: ['xobase'],
	conectar.

>> consulta := bd consultar: ['SELECT ? AS a, ? AS b, ? AS c'].
consulta parámetros: (Lista crear ; ['1']).
{ consulta extraer: { :fila Salida escribir: fila, detener. }. } capturar: { :e Salida escribir: e, detener. }, empezar.

>> consulta := bd consultar: ['SELECT ? AS a'].
{ consulta extraer: { :fila Salida escribir: fila, detener. }. } capturar: { :e Salida escribir: e, detener. }, empezar.

# el número correcto sigue funcionando, los parámetros de más se ignoran como antes
>> consulta := bd consultar: ['SELECT ? AS a, ? AS b'].
consulta parámetros: (Lista crear ; ['1'] ; ['2']).
consulta extraer: { :fila Salida escribir: (fila en: ['a']), escribir: (fila en: ['b']), detener. }.
consulta parámetros: (Lista crear ; ['1'] ; ['2'] ; ['3']).
consulta extraer: { :fila Salida escribir: (fila en: ['a']), escribir: (fila en: ['b']), detener. }.
