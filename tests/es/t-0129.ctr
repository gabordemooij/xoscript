
Lista al: ['producto'] hacer: {
	>> total := 1.
	yo cada: { :índice :elemento
		total multiplicar: elemento.
	}. <- total.
}.

>> a := Lista ← 1 ; 2 ; 3.
Salida escribir: a producto, detener.
Salida escribir: (Lista ← 2 ; 4 ; 8) producto, detener. 
Salida escribir: (Lista ← -2 ; 10) producto, detener. 
Salida escribir: (Lista ← 0.5 ; -2) producto, detener. 
