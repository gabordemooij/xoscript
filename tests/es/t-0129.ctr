
Lista al: ['product'] hacer: {
	>> total := 1.
	yo cada: { :index :element
		total multiplicar: element.
	}. <- total.
}.

>> a := Lista ← 1 ; 2 ; 3.
Salida escribir: a product, detener.
Salida escribir: (Lista ← 2 ; 4 ; 8) product, detener. 
Salida escribir: (Lista ← -2 ; 10) product, detener. 
Salida escribir: (Lista ← 0.5 ; -2) product, detener. 
