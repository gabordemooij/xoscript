# caso normal
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> ruta := ['/tmp/dat.csv'].
>> csv := Archivo crear: ruta.
csv escribir: s.

# acepta CRLF LF CR, longitud de fila variable
csv separador: [';'] comillas: ['"'] reglas: { :line
	Programa limpiar-memoria.
	Salida escribir: line, detener.
	Programa limpiar-memoria.
}.

# líneas desiguales
s adjuntar: ['\njustone'].
csv escribir: s.
{
	csv separador: [';'] comillas: ['"'] reglas: { :line
		Salida escribir: line, detener.
	}.
} capturar: { :e 
	Salida escribir: e, detener.
}, empezar.

# formato inválido
s := ['"he"llo";world'].
csv escribir: s.
{
	csv separador: [';'] comillas: ['"'] reglas: { :line
		Salida escribir: line, detener.
	}.
} capturar: { :e 
	Salida escribir: e, detener.
}, empezar.
