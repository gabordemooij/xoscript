>> Greeter := Objeto crear.
Greeter al: ['make'] hacer: {
	>> greeter := Objeto crear.
	greeter al: ['name:'] hacer: { :nombre
		Salida escribir: ['setting a name'].
		mi myName := nombre.
	}.
	greeter al: ['greet'] hacer: {
		Salida escribir: ['Hello'].
		Salida escribir: mi myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
