>> Saludador := Objeto crear.
Saludador al: ['fabricar'] hacer: {
	>> saludador := Objeto crear.
	saludador al: ['name:'] hacer: { :nombre
		Salida escribir: ['asignando un nombre'].
		mi miNombre := nombre.
	}.
	saludador al: ['realizarSaludo'] hacer: {
		Salida escribir: ['Hello'].
		Salida escribir: mi miNombre.
	}.
	saludador al: ['saludar'] hacer: {
		yo realizarSaludo.
	}. <- saludador.
}.
>> saludador := Saludador fabricar.
saludador name: ['¡rayo de sol!'].
saludador saludar.
