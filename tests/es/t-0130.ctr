# usar FFI con el plugin Server

# conectar con libc (depende de la plataforma)
>> nombrelib := Programa configurar: ['FFITESTLIB'].

# enlazar funciones stdio de C para operaciones avanzadas con archivos
Server vincular: ( Lista crear ;
 nombrelib ; ['fopen'] ;
 ( Lista crear ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
vincular: ( Lista crear ;
 Nulo ; # significa la misma biblioteca
 ['fread'] ;
 ( Lista crear ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nulo ; # significa el mismo objeto (es decir, Flujo)
 ['fread']
),
vincular: (
 Lista crear ;
 Nulo ; # significa la misma biblioteca
 ['fwrite'] ;
 ( Lista crear ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nulo ; # significa la misma biblioteca
 ['fwrite']
),
vincular: (
 Lista crear ;
 Nulo ; # significa la misma biblioteca
 ['rewind'] ;
 ( Lista crear ; ['pointer'] ) ;
 ['int'] ;
 Nulo ; # significa la misma biblioteca
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> ruta := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# abrir un archivo con fopen(path, mode)
>> fd := Stream path: ruta mode: mode.

# escribir bytes del búfer str en el archivo
>> bytes-escritos := Stream mensaje: ['fwrite'] argumentos: (Lista crear ; str ; 1 ; 6 ; fd ).
Salida escribir: bytes-escritos, detener.

# rebobinar el puntero del archivo
Stream rewind: fd.

# reservar un búfer
>> búf := Blob crear: 20.

# leer del archivo
>> bytes-leídos := Stream mensaje: ['fread'] argumentos: (Lista crear ; búf ; 1 ; 6 ; fd ).
Salida escribir: bytes-leídos, detener.
Salida escribir: búf, detener.

# liberar memoria
str  liberar.
ruta liberar.
mode liberar.
búf  liberar.


