>> items := Diccionario crear.
items poner: ['verde'] en: ['color-1'].
items poner: ['naranja'] en: ['color-2'].
items poner: ['rojo'] en: ['color-3'].
>> i := 0.
>> s := [''].
items cada: { :key :color
	Salida escribir: ['color #'] + i + [' es: '] + color + [' '].
	i añadir: 1.
}.
Salida escribir: i + [' colores!'].
