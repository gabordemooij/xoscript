>> items := Diccionario crear.
items poner: ['green'] en: ['color-1'].
items poner: ['orange'] en: ['color-2'].
items poner: ['red'] en: ['color-3'].
>> i := 0.
>> s := [''].
items cada: { :key :color
	Salida escribir: ['color #'] + i + [' is: '] + color + [' '].
	i añadir: 1.
}.
Salida escribir: i + [' colors!'].
