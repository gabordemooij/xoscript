Salida escribir: ['Objeto de prueba'], detener.
>> a := Objeto crear. 

a al: ['item:'] hacer: { :num
	mi num := num. 
}.

a al: ['artículo'] hacer: {
	<- mi num.
}.

a item: 123.

Salida escribir: a artículo, detener.

>> antigua-dirección-num := a artículo prototipo dirección-de-memoria.
a save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RECARGANDO SNAP:'], detener.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b artículo prototipo dirección-de-memoria = antigua-dirección-num) verdadero: {
	Salida escribir: ['Enlace de objeto reconectado.'], detener.
}.

Salida escribir: b artículo, detener.
