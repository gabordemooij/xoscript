Salida escribir: ['Test object'], detener.
>> a := Objeto crear. 

a al: ['item:'] hacer: { :num
	mi num := num. 
}.

a al: ['item'] hacer: { <- mi num.
}.

a item: 123.

Salida escribir: a item, detener.

>> old-num-address := a item prototipo dirección-de-memoria.
a save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RELOADING SNAP:'], detener.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b item prototipo dirección-de-memoria = old-num-address) verdadero: {
	Salida escribir: ['Object link re-attached.'], detener.
}.

Salida escribir: b item, detener.
