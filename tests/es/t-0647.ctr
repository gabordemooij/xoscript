Server init.
Salida escribir: ['Prueba de hora en base de datos'], detener.

>> bd := Maria-DB crear host: ['localhost'],
	usuario: ['xo'], 
	contraseña: ['pass123'],
	nombre-base-datos: ['xobase'],
	conectar.

>> consulta :=
bd consultar: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
extraer: { :fila
	Salida escribir: fila timetest, detener.
}.
