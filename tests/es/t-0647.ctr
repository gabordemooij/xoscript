Server init.
Salida escribir: ['Database time test'], detener.

>> db := Maria-DB crear host: ['localhost'],
	usuario: ['xo'], 
	contraseña: ['pass123'],
	nombre-base-datos: ['xobase'],
	conectar.

>> consulta :=
db consultar: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
extraer: { :row
	Salida escribir: row timetest, detener.
}.
