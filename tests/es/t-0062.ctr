Booleano al: ['xor:'] hacer: { :a :b <- ((a y: b no) o: (a no y: b)).
}.

>> o := Objeto crear.
o al: ['hello'] hacer: { ['Empty']. }.
{ o al: 2 hacer: 3.} capturar: { :e Salida escribir: e, detener. }, empezar.
{ o al: ['pruebas'] hacer: 3.} capturar: { :e Salida escribir: e, detener. }, empezar.
{ o al: ['hello'] hacer: { ['Empty']. }.} capturar: { :e Salida escribir: e, detener. }, empezar. 
{ >> z := 4 ÷ 0. } capturar: { :e Salida escribir: e, detener. }, empezar. 
{ (Verdadero y: Nulo) verdadero: { Salida escribir: ['X'].}. } capturar: { :e Salida escribir: e, detener. }, empezar. 
{ ([''] xor: 0) verdadero: { Salida escribir: ['X'].}. } capturar: { :e Salida escribir: e, detener. }, empezar. 
{ (1 < ['2']) verdadero: { Salida escribir: ['OK']. }. } capturar: { :e Salida escribir: e, detener. }, empezar. 
{ (1 < ['2.0']) verdadero: { Salida escribir: ['OK']. }. } capturar: { :e Salida escribir: e, detener. }, empezar. 
{ (1 < ['x2.0']) verdadero: { Salida escribir: ['NO!']. }. } capturar: { :e Salida escribir: e, detener. }, empezar. 
{ Salida escribir: (['hello OK there'] desde: ['6'] longitud: ['2']). } empezar. 
