# un valor que termina en la primera parte de una comilla de apertura debe sobrevivir a la serialización
>> valores := Lista crear
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

valores cada: { :i :value
	>> d := Diccionario crear.
	d poner: value en: ['k'].
	d poner: ['second'] en: ['j'].
	>> r := d código objeto.
	Salida escribir: r contar, detener.
	Salida escribir: ( (r en: ['k']) = value ), detener.
}.
