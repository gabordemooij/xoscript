
>> ciudad := Lista ← ['Londres'] ; ['París'] ; ['Berlín'].
>> temperatura := Lista ← ['15'] ; ['16'] ; ['15'].
>> clima := temperatura por: ciudad.
>> ciudades := clima entradas ordenar: { :a :b <- (a comparar: b). }.
>> temperaturas := clima valores ordenar: { :a :b <- (a comparar: b) ¿negativo?. }.

Salida escribir: (ciudades unir: [',']), detener.
Salida escribir: (temperaturas unir: [',']), detener.
