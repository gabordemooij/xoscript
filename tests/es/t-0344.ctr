# catch-all test (practical)
>> HTML := Texto crear.
HTML al: ['encode:'] hacer: { :tekst
	yo adjuntar: (tekst
	reemplazar: ['&'] con: ['&amp;'], 
	reemplazar: ['<'] con: ['&lt;'],
	reemplazar: ['>'] con: ['&gt;'],
	reemplazar: ['"'] con: ['&quot;']).
}.
>> blog := HTML crear.
blog adjuntar: ['<h1>'],
     encode: ['Koffie & Thee'],
     adjuntar: ['</h1>'].
Salida escribir: blog, detener.


>> Roman := Número crear.
Roman al: ['stringy'] hacer: {
	>> a := [''].
	{ a adjuntar: ['I']. } × yo. <- a.
}.

>> x := Roman crear.
x añadir: 3.
Salida escribir: x stringy, detener.

>> Quantum := Booleano crear.
Quantum al: ['true?'] hacer: { <- ['maybe True']. }.
Salida escribir: (Quantum crear true?), detener.

>> Nihil := Nulo crear.
Nihil al: ['texto'] hacer: { <- ['Nihil']. }.
Salida escribir: (Nihil crear), detener.
