# prueba de captura general (práctica)
>> HTML := Texto crear.
HTML al: ['encode:'] hacer: { :tekst
	yo adjuntar: (tekst
	reemplazar: ['&'] con: ['&amp;'], 
	reemplazar: ['<'] con: ['&lt;'],
	reemplazar: ['>'] con: ['&gt;'],
	reemplazar: ['"'] con: ['&quot;']).
}.
>> blog := HTML crear.
blog adjuntar: ['<h1>'],
     encode: ['Koffie & Thee'],
     adjuntar: ['</h1>'].
Salida escribir: blog, detener.


>> Romano := Número crear.
Romano al: ['enTexto'] hacer: {
	>> a := [''].
	{ a adjuntar: ['I']. } × yo. <- a.
}.

>> x := Romano crear.
x añadir: 3.
Salida escribir: x enTexto, detener.

>> Cuántico := Booleano crear.
Cuántico al: ['true?'] hacer: { <- ['quizá Verdadero']. }.
Salida escribir: (Cuántico crear true?), detener.

>> Nihil := Nulo crear.
Nihil al: ['texto'] hacer: { <- ['Nihil']. }.
Salida escribir: (Nihil crear), detener.
