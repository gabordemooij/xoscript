Número al: ['factorial'] hacer: {
	>> total := 1.
	{ :índice total multiplicar: (yo - índice). } × yo. <- total.
}.

>> memoriaUsada1 := 0.
>> memoriaUsada2 := 0.
>> memoriaUsada3 := 0.
>> memoriaUsada4 := 0.

Programa orden: 0.

{
2 exponente factorial.
Salida escribir: (11 módulo: 3), detener.
Salida escribir: (3.4 redondeado), detener.
Salida escribir: (7.1 redondear-alto), detener.
Salida escribir: (7.9 redondear-bajo), detener.
}
empezar.

Programa limpiar-memoria.

memoriaUsada1 := (Programa memoria ? 0).

{
2 exponente factorial.
Salida escribir: (11 módulo: 3), detener.
Salida escribir: (3.4 redondeado), detener.
Salida escribir: (7.1 redondear-alto), detener.
Salida escribir: (7.9 redondear-bajo), detener.
}
empezar.

Programa limpiar-memoria.
memoriaUsada2 := (Programa memoria ? 0).


{
2 exponente factorial.
Salida escribir: (11 módulo: 3), detener.
Salida escribir: (3.4 redondeado), detener.
Salida escribir: (7.1 redondear-alto), detener.
Salida escribir: (7.9 redondear-bajo), detener.
} empezar.

Programa limpiar-memoria.
memoriaUsada3 := (Programa memoria ? 0).



( memoriaUsada1 = memoriaUsada2 y: memoriaUsada1 = memoriaUsada3, y: memoriaUsada2 = memoriaUsada3 ) verdadero: {
	Salida escribir: ['Aquí no hay fugas de memoria'].
}, falso: {
	Salida escribir: ['Fuga de memoria...'].
}.
