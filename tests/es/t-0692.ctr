Server init.

Salida escribir: (
	Patrón crear: ['^\\w+$'],
	coincidir: ['test@example.com'] 
), detener. # 0 match, fails on @ and .

Salida escribir: (
	Patrón crear: ['^[^@]+@[^\.]+\.\\w+$'],
	coincidir: ['test@example.com'] 
), detener. # 1 match

Salida escribir: (
	Patrón crear: ['[^@]+@[^\.]+\.\\w+'],
	coincidir: ['test@example.com'] 
), detener. # 1 match

Salida escribir: (
	Patrón crear: ['([^@]+)@([^\.]+)\.\\w+'],
	coincidir: ['test@example.com'] 
), detener. # 1 match, groups dont matter

Salida escribir: (
	Patrón crear: ['[a-z]'],
	coincidir: ['test@example.com'] 
), detener. # 14 matches

Salida escribir: (
	Patrón crear: ['.*'],
	coincidir: ['test@example.com'] 
), detener. # 1 match (all)

Salida escribir: (
	Patrón crear: ['(.*)'],
	coincidir: ['test@example.com'] 
), detener. # 1 match (all)

Salida escribir: (
	Patrón crear: ['\\s*[^@]+@[^\.]+\.\\w+'],
	coincidir: ['test@example.com'] 
), detener. # 1 match, prefix space optional, gets ignored