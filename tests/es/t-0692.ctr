Server init.

Salida escribir: (
	Patrón crear: ['^\\w+$'],
	coincidir: ['test@example.com'] 
), detener. # 0 coincidencias, falla en @ y .

Salida escribir: (
	Patrón crear: ['^[^@]+@[^\.]+\.\\w+$'],
	coincidir: ['test@example.com'] 
), detener. # 1 coincidencia

Salida escribir: (
	Patrón crear: ['[^@]+@[^\.]+\.\\w+'],
	coincidir: ['test@example.com'] 
), detener. # 1 coincidencia

Salida escribir: (
	Patrón crear: ['([^@]+)@([^\.]+)\.\\w+'],
	coincidir: ['test@example.com'] 
), detener. # 1 coincidencia, los grupos no importan

Salida escribir: (
	Patrón crear: ['[a-z]'],
	coincidir: ['test@example.com'] 
), detener. # 14 coincidencias

Salida escribir: (
	Patrón crear: ['.*'],
	coincidir: ['test@example.com'] 
), detener. # 1 coincidencia (todo)

Salida escribir: (
	Patrón crear: ['(.*)'],
	coincidir: ['test@example.com'] 
), detener. # 1 coincidencia (todo)

Salida escribir: (
	Patrón crear: ['\\s*[^@]+@[^\.]+\.\\w+'],
	coincidir: ['test@example.com'] 
), detener. # 1 coincidencia, el espacio inicial es opcional y se ignora