Lista al: ['copiar'] hacer: {
	>> copiar := Lista crear.
	yo cada: { :número :sección
		copiar adjuntar: sección recursivo copiar.
	}.
	<- copiar.
}.

>> oveja := Lista crear ; ['Dolly'] ; ['Shaun']. 
>> clones := oveja copiar.
clones cada: { :número :oveja
	oveja adjuntar: ['2'].
}.

Salida escribir: oveja, detener.
Salida escribir: clones, detener.
