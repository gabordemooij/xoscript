Lista al: ['copiar'] hacer: {
	>> copiar := Lista crear.
	yo cada: { :número :section
		copiar adjuntar: section recursivo copiar.
	}. <- copiar.
}.

>> sheep := Lista crear ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep copiar.
clones cada: { :número :sheep
	sheep adjuntar: ['2'].
}.

Salida escribir: sheep, detener.
Salida escribir: clones, detener.
