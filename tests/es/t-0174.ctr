


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa orden: 0.
>> palette := Nulo.
>> colors := Nulo.

{
palette := Diccionario crear.
palette 
	poner: ['#F00'] en: ['red'],
	poner: ['#0F0'] en: ['green'],
	poner: ['#00F'] en: ['blue'].
Salida escribir: ['number of RGB codes in palette: '] + ( palette contar ), detener.
Salida escribir: ['RGB code of green is: '] + ( palette ? ['green'] ), detener.
colors := [''].
( palette cada: { :nombre :código
		colors := colors + ( nombre + [':'] + código ).
} ).
Salida escribir: ['All colors in palette: '] + colors, detener.
} empezar.
Programa limpiar-memoria.
usedMemory1 := (Programa memoria ? 0).

{
palette := Diccionario crear.
palette 
	poner: ['#F00'] en: ['red'],
	poner: ['#0F0'] en: ['green'],
	poner: ['#00F'] en: ['blue'].
Salida escribir: ['number of RGB codes in palette: '] + ( palette contar ), detener.
Salida escribir: ['RGB code of green is: '] + ( palette ? ['green'] ), detener.
colors := [''].
( palette cada: { :nombre :código
		colors := colors + ( nombre + [':'] + código ).
} ).
Salida escribir: ['All colors in palette: '] + colors, detener.
} empezar.
Programa limpiar-memoria.
usedMemory2 := (Programa memoria ? 0).

{
palette := Diccionario crear.
palette 
	poner: ['#F00'] en: ['red'],
	poner: ['#0F0'] en: ['green'],
	poner: ['#00F'] en: ['blue'].
Salida escribir: ['number of RGB codes in palette: '] + ( palette contar ), detener.
Salida escribir: ['RGB code of green is: '] + ( palette ? ['green'] ), detener.
colors := [''].
( palette cada: { :nombre :código
		colors := colors + ( nombre + [':'] + código ).
} ).
Salida escribir: ['All colors in palette: '] + colors, detener.
} empezar.
Programa limpiar-memoria.
usedMemory3 := (Programa memoria ? 0).



( usedMemory1 = usedMemory2 y: usedMemory1 = usedMemory3, y: usedMemory2 = usedMemory3 ) verdadero: {
	Salida escribir: ['No memory leaks here'].
}, falso: {
	Salida escribir: ['Leaking memory...'].
}.
