


>> memoriaUsada1 := 0.
>> memoriaUsada2 := 0.
>> memoriaUsada3 := 0.
>> memoriaUsada4 := 0.

Programa orden: 0.
>> paleta := Nulo.
>> colores := Nulo.

{
paleta := Diccionario crear.
paleta 
	poner: ['#F00'] en: ['rojo'],
	poner: ['#0F0'] en: ['verde'],
	poner: ['#00F'] en: ['azul'].
Salida escribir: ['número de códigos RGB en la paleta: '] + ( paleta contar ), detener.
Salida escribir: ['El código RGB de verde es: '] + ( paleta ? ['verde'] ), detener.
colores := [''].
( paleta cada: { :nombre :código
		colores := colores + ( nombre + [':'] + código ).
} ).
Salida escribir: ['Todos los colores de la paleta: '] + colores, detener.
} empezar.
Programa limpiar-memoria.
memoriaUsada1 := (Programa memoria ? 0).

{
paleta := Diccionario crear.
paleta 
	poner: ['#F00'] en: ['rojo'],
	poner: ['#0F0'] en: ['verde'],
	poner: ['#00F'] en: ['azul'].
Salida escribir: ['número de códigos RGB en la paleta: '] + ( paleta contar ), detener.
Salida escribir: ['El código RGB de verde es: '] + ( paleta ? ['verde'] ), detener.
colores := [''].
( paleta cada: { :nombre :código
		colores := colores + ( nombre + [':'] + código ).
} ).
Salida escribir: ['Todos los colores de la paleta: '] + colores, detener.
} empezar.
Programa limpiar-memoria.
memoriaUsada2 := (Programa memoria ? 0).

{
paleta := Diccionario crear.
paleta 
	poner: ['#F00'] en: ['rojo'],
	poner: ['#0F0'] en: ['verde'],
	poner: ['#00F'] en: ['azul'].
Salida escribir: ['número de códigos RGB en la paleta: '] + ( paleta contar ), detener.
Salida escribir: ['El código RGB de verde es: '] + ( paleta ? ['verde'] ), detener.
colores := [''].
( paleta cada: { :nombre :código
		colores := colores + ( nombre + [':'] + código ).
} ).
Salida escribir: ['Todos los colores de la paleta: '] + colores, detener.
} empezar.
Programa limpiar-memoria.
memoriaUsada3 := (Programa memoria ? 0).



( memoriaUsada1 = memoriaUsada2 y: memoriaUsada1 = memoriaUsada3, y: memoriaUsada2 = memoriaUsada3 ) verdadero: {
	Salida escribir: ['Aquí no hay fugas de memoria'].
}, falso: {
	Salida escribir: ['Fuga de memoria...'].
}.
