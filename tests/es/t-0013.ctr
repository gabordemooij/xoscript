
>> Animal := Objeto crear.
Animal al: ['crear'] hacer: {
	<- yo crear init.
}.

Animal al: ['init'] hacer: {
	mi sonido := ['?'].
	mi patas  := 4.
}.

>> Perro := Animal crear.
Perro al: ['init'] hacer: {
	yo init.
	mi sonido := ['ladra'].
}.

Animal al: ['texto'] hacer: {
	<- mi patas texto + mi sonido.
}.

>> caniche := Perro crear.
Salida escribir: caniche, detener.

