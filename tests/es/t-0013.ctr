
>> Animal := Objeto crear.
Animal al: ['crear'] hacer: { <- yo crear init.
}.

Animal al: ['init'] hacer: {
	mi sound := ['?'].
	mi legs := 4.
}.

>> Dog := Animal crear.
Dog al: ['init'] hacer: {
	yo init.
	mi sound := ['barks'].
}.

Animal al: ['texto'] hacer: { <- mi legs texto + mi sound.
}.

>> poodle := Dog crear.
Salida escribir: poodle, detener.

