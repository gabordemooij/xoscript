>> memoriaUsada4 := 0.

Programa orden: 0.

>> txt := ['1.6'].
>> n := txt número.
>> t := txt booleano.
Salida escribir: n, detener.
Salida escribir: t, detener.
Salida escribir: n tipo, detener.
Salida escribir: t tipo, detener.

Programa limpiar-memoria.

memoriaUsada1 := (Programa memoria ? 0).


