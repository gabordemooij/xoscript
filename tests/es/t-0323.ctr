

Programa limpiar-memoria.


>> Veggy := Objeto crear.
Veggy al: ['crear'] hacer: {
	>> v := yo crear.
	v init. <- v.
}.

Veggy al: ['init'] hacer: { mi veggies := 0. }.

Veggy al: ['carrots:'] hacer: { :a mi veggies := a. <- Nulo. }.
Veggy al: ['carrots'] hacer: { <- mi veggies. }.
Veggy al: ['+'] hacer: { :f
	>> n := Veggy crear.
	n carrots: (f carrots + mi veggies). <- n.
}.

Veggy al: ['texto'] hacer: { <- mi veggies texto.
}.

Número al: ['carrots'] hacer: {
	>> x := Veggy crear.
	x carrots: yo. <- x.
}.

Número al: ['add:and:'] hacer: { :a :b <- (a + b).
}.

>> q := 0 add: (3 carrots + 2 carrots) and: 4 carrots.
Salida escribir: q, detener.
