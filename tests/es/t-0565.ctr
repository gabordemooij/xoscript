Server init.

>> message := ['this is a string to be encrypted!'].
>> key := ['secret123!'].
>> vault := Contenedor-seguro crear: ['myvault'].

>> encrypted := vault cifrar: message clave: key.
>> decrypted := vault descifrar: encrypted clave: key.

Salida 
escribir: ['Message:'], detener
escribir: message, detener
escribir: ['Decrypted:'], detener
escribir: decrypted, detener.
