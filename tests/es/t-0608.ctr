
>> Medida := Objeto crear.
Medida al: ['is:'] hacer: { :número
	número al: ['+'] hacer: { :número
		>> unidad := número calificador.
		>> factor := 1.
		
		unidad
		en-caso-de: ['inch'] hacer: { factor := 0.0833. }.

		<- yo + (número * factor).
	}.
	<- número.
}.

# Este número de tamaño se puede usar así:

>> tablón := Medida is: 6 pie.
>> borde := Medida is: 50 inch.

# Esto se mostrará como: 10.165
Salida escribir: tablón + borde, detener.
