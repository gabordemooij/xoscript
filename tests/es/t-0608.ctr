
>> Size := Objeto crear.
Size al: ['is:'] hacer: { :número
	número al: ['+'] hacer: { :número
		>> unit := número calificador.
		>> factor := 1.
		
		unit
		en-caso-de: ['inch'] hacer: { factor := 0.0833. }. <- yo + (número * factor).
	}. <- número.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Salida escribir: plank + edge, detener.
