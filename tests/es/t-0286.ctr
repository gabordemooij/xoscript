['Miles y decimales'].

>> x := 100000000.5.
>> y := 100000000.5.

Salida escribir: (x + y), detener.

>> x := 10040.07.
>> y := 10305.60.

Salida escribir: (x + y), detener.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Salida escribir: (x + y + z), detener.

['Raro pero válido'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Salida escribir: (x + y + z), detener.

>> q := 0.1.2.

Salida escribir: (q), detener.

>> q := 012.

Salida escribir: (q), detener.
