# prueba de conversiones de tipo / enlaces
Programa orden: 4.
Server init.

>> contador := 0.
>> bd := Maria-DB crear host: ['localhost'],
	usuario: ['xo'], contraseña: ['pass123'], nombre-base-datos: ['xobase'], conectar.

>> FormatoDosDígitos := Formato crear: ['%02d'].

# Fecha y hora
{
	>> año     := Número entre: 1995 y: 2050, texto.
	>> mes    := FormatoDosDígitos aplicar-a-entero: (Número entre: 1 y: 12), texto.
	>> día      := FormatoDosDígitos aplicar-a-entero: (Número entre: 1 y: 28), texto.
	>> hora     := FormatoDosDígitos aplicar-a-entero: (Número entre: 1 y: 23), texto.
	>> minuto   := FormatoDosDígitos aplicar-a-entero: (Número entre: 1 y: 59), texto.
	>> segundo   := FormatoDosDígitos aplicar-a-entero: (Número entre: 1 y: 59), texto.
	>> datetime := ['YYYY-MM-DD HH:II:SS'].	
	datetime
		YYYY: año,
		MM: mes,
		DD: día,
		HH: hora,
		II: minuto,
		SS: segundo.
	>> consulta :=
	bd consultar: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: datetime),
	extraer: { :fila
		(fila mydatetime = datetime) falso: {
			la-tarea-actual error: (
				['Se esperaba: <expected> pero se obtuvo: <observation>']
				<expected>: datetime,
				<observation>: fila mydatetime
			).
		}.
	
	}.
	contador añadir: 1.
} * 100.

# Fecha
{
	>> año     := Número entre: 1995 y: 2050, texto.
	>> mes    := FormatoDosDígitos aplicar-a-entero: (Número entre: 1 y: 12), texto.
	>> día      := FormatoDosDígitos aplicar-a-entero: (Número entre: 1 y: 28), texto.
	>> date     := ['YYYY-MM-DD'].
	date
		YYYY: año,
		MM: mes,
		DD: día.
	>> consulta :=
	bd consultar: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: date),
	extraer: { :fila
		(fila mydate = date) falso: {
			la-tarea-actual error: (
				['Se esperaba: <expected> pero se obtuvo: <observation>']
				<expected>: date,
				<observation>: fila mydate
			).
		}.
	}.
	contador añadir: 1.
} * 100.


# Hora
{
	>> hora     := FormatoDosDígitos aplicar-a-entero: (Número entre: 1 y: 23), texto.
	>> minuto   := FormatoDosDígitos aplicar-a-entero: (Número entre: 1 y: 59), texto.
	>> segundo   := FormatoDosDígitos aplicar-a-entero: (Número entre: 1 y: 59), texto.
	>> tiempo := ['HH:II:SS'].
	tiempo
		HH: hora,
		II: minuto,
		SS: segundo.
	>> consulta :=
	bd consultar: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: tiempo),
	extraer: { :fila
		(fila mytime = tiempo) falso: {
			la-tarea-actual error: (
				['Se esperaba: <expected> pero se obtuvo: <observation>']
				<expected>: datetime,
				<observation>: fila mytime
			).
		}.
	}.
	contador añadir: 1.
} * 100.


# Textos (varchar/text)
>> str1 := Lista crear llenar: 100000 con: ['x'], unir: [''].
{
	>> str2 := Contenedor-seguro token: 40.
	>> consulta :=
	bd consultar: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	extraer: { :fila
		(fila str1 = str1 y: fila str2 = str2) falso: {
			la-tarea-actual error: (
				['Se esperaba: <expected> pero se obtuvo: <observation>']
				<expected>: datetime,
				<observation>: fila mytime
			).
		}.
	}.
	contador añadir: 1.
} * 100.


# Números
{
	>> n1  := Número entre: 1 y: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 desde-texto: ['9223372036854775807'] ) -
		( Int64 desde-texto: ['99999'] ) +
		( Int64 desde-texto: n1 texto )
	).
	>> consulta :=
	bd consultar: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	extraer: { :fila
		(fila n1 = n1) falso: {
			la-tarea-actual error: (
				['Se esperaba: <expected> pero se obtuvo: <observation>']
				<expected>: n1,
				<observation>: fila n1
			).
		}.
		(fila n2 = n2) falso: {
			la-tarea-actual error: (
				['Se esperaba: <expected> pero se obtuvo: <observation>']
				<expected>: n1,
				<observation>: fila n2
			).
		}.
		(fila n3 = n2 redondeado) falso: {
			la-tarea-actual error: (
				['Se esperaba: <expected> pero se obtuvo: <observation>']
				<expected>: n1,
				<observation>: fila n3
			).
		}.
		(fila big = big) falso: {
			la-tarea-actual error: (
				['Se esperaba: <expected> pero se obtuvo: <observation>']
				<expected>: big,
				<observation>: fila big
			).
		}.
		
	}.
	contador añadir: 1.
} * 100.


Salida escribir: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: contador
), detener.