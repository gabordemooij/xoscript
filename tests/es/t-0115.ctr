{
	la-tarea-actual error: ['Dont fail.'].
	unknown doSomething.
} capturar: {
	Salida escribir: ['Caught!'].
}, empezar.

{
	la-tarea-actual error: ['Dont fail.'].
	mi unknown doSomething.
} capturar: {
	Salida escribir: ['Caught!'].
}, empezar.

{
	la-tarea-actual error: ['Dont fail.'].
	unknown := 122.
} capturar: {
	Salida escribir: ['Caught!'].
}, empezar.


{
	la-tarea-actual error: ['Dont fail.'].
	Verdadero salir.
	Salida escribir: ['FAIL'].
} capturar: {
	Salida escribir: ['Caught!'].
}, empezar.

{
	{
		la-tarea-actual error: ['Dont fail.'].
		Verdadero salir.
		Salida escribir: ['FAIL'].
	} capturar: { :x
		(x = ['Dont fail.']) verdadero: { la-tarea-actual error: ['Nested Caught!']. }.
	}, empezar.
} capturar: { :e
	Salida escribir: e.
}, empezar.
