{
	{
		la-tarea-actual error: ['No falles.'].
		Verdadero salir.
		Salida escribir: ['FALLO'].
	} capturar: { :x
		(x = ['No falles.']) verdadero: { la-tarea-actual error: ['¡Capturado anidado!']. }.
	}, empezar.
} capturar: { :e
	Salida escribir: e.
}, empezar.
