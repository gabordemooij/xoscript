#Linux

 >> t := Momento crear.
 
t zona: ['Europe/Amsterdam'].
t año: 2020, mes: 8, día: 2, hora: 21, minuto: 2, segundo: 1.

>> a := t hora.
>> ams := t zona.

t zona: ['US/Hawaii'].
>> b := t hora.
>> hw := t zona.

Salida
escribir: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		o: ['más tarde'] o: ['más temprano']
	)
),
detener.
 