Salida escribir: ['Objeto de prueba'], detener.
>> a := Objeto crear. 

a al: ['item:'] hacer: { :fmt
	mi fmt := fmt. 
}.

a al: ['artículo'] hacer: {
	<- mi fmt.
}.

a item: ( Formato crear: ['|%s|'] ).

Salida escribir: a artículo, detener.

>> antigua-dirección-fmt := a artículo prototipo dirección-de-memoria.
a save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RECARGANDO SNAP:'], detener.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b artículo prototipo dirección-de-memoria = antigua-dirección-fmt) verdadero: {
	Salida escribir: ['Enlace de objeto reconectado.'], detener.
}.

Salida escribir: ( b artículo aplicar: ['hello'] ), detener.
