Salida escribir: (['a:b:'] - [':']), detener.
Salida escribir: (['Lorem Ipsum'] - ['Ipsum']), detener.
Salida escribir: (['a.................b.......................c...........'] - ['.']), detener.
Salida escribir: (['a--b--c---d'] - ['--']), detener.
Salida escribir: (['-'] - ['--']), detener.
Salida escribir: ([''] - ['--']), detener.
Salida escribir: (['--'] - ['']), detener.
Salida escribir: ([''] - ['']), detener.
>> x := ['xx'].
>> y := x - ['x'].
Salida escribir: x, detener.
Salida escribir: y, detener.
>> x := ['a,bb,c'].
>> y := x reemplazar: [''] con: ['xx'].
Salida escribir: ((x es: y) o: ['OK'] o: ['¡ERROR! ¡Devolvió una copia por accidente!']), detener.