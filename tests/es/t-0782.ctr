Salida escribir: ['Test object'], detener.
>> cmd := Comando crear.
Salida escribir: cmd ls /tmp, detener.
>> old-cmd-address := cmd prototipo dirección-de-memoria.
cmd save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RELOADING SNAP:'], detener.
>> b := Objeto load-from: ['/tmp/a.bin'].
(b prototipo dirección-de-memoria = old-cmd-address) verdadero: {
	Salida escribir: ['Object link re-attached.'], detener.
}.
Salida escribir: b ls, detener.


