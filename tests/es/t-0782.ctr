Salida escribir: ['Objeto de prueba'], detener.
>> cmd := Comando crear.
Salida escribir: cmd ls /tmp, detener.
>> antigua-dirección-cmd := cmd prototipo dirección-de-memoria.
cmd save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RECARGANDO SNAP:'], detener.
>> b := Objeto load-from: ['/tmp/a.bin'].
(b prototipo dirección-de-memoria = antigua-dirección-cmd) verdadero: {
	Salida escribir: ['Enlace de objeto reconectado.'], detener.
}.
Salida escribir: b ls, detener.


