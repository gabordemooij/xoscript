Salida escribir: ['Objeto de prueba'], detener.
>> a := Objeto crear. 

a al: ['item:'] hacer: { :ayudanteoct
	mi ayudanteoct := ayudanteoct. 
}.

a al: ['artículo'] hacer: {
	<- mi ayudanteoct.
}.

a item: Oct crear.

>> antigua-dirección-ayudanteoct := a artículo prototipo dirección-de-memoria.
a save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RECARGANDO SNAP:'], detener.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b artículo prototipo dirección-de-memoria = antigua-dirección-ayudanteoct) verdadero: {
	Salida escribir: ['Enlace de objeto reconectado.'], detener.
}.
