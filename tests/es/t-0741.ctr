Salida escribir: ['Test object'], detener.
>> a := Objeto crear. 

a al: ['item:'] hacer: { :octhelper
	mi octhelper := octhelper. 
}.

a al: ['item'] hacer: { <- mi octhelper.
}.

a item: Oct crear.

>> old-octhelper-address := a item prototipo dirección-de-memoria.
a save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RELOADING SNAP:'], detener.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b item prototipo dirección-de-memoria = old-octhelper-address) verdadero: {
	Salida escribir: ['Object link re-attached.'], detener.
}.
