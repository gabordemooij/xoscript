>> z := Objeto crear.
z al: ['value:'] hacer: { :v
	mi value := v. <- yo.
}.
z al: ['value'] hacer: { <- mi value. }.
(z setValue: 1) value: 2.
Salida escribir: z value.
>> x := z.
Salida escribir: x value.
z := Nulo.
Salida escribir: z value.
Salida escribir: x value.
