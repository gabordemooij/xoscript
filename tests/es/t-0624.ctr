# Esta prueba comprueba que string_fill_in no pierde su ranura (recolectada por el GC) en el modo 4
# referencia en world.c
>> Registro := Objeto crear.

Registro al: ['say:'] hacer: { :str
	Salida escribir: str, detener.
}.

>> Artículo := Objeto crear.

Artículo al: ['crear:'] hacer: { :id
	<- yo crear id: id.
}.

Artículo al: ['id:'] hacer: { :id
	mi id := id.
}.

Artículo al: ['id'] hacer: { <- mi id. }.


Artículo al: ['texto'] hacer: {
	>> str := ['Item#~no'].
	str ~no: mi id.
	<- str.
}.


>> Print := Objeto crear.

Print al: ['items'] hacer: { 
	
	mi artículo := Artículo crear: 1.
	
	# aquí, o un segfault o un texto incorrecto
	Registro say: (
		['~item printed.'] ~item: mi artículo
	).
	
	
}.

Print items.