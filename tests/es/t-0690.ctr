# prueba de base de datos
# ver el ejemplo server.xo para la configuración necesaria

Server init.
Salida escribir: ['Prueba de base de datos'], detener.

>> bd := Maria-DB crear host: ['localhost'],
	usuario: ['xo'], contraseña: ['pass123'], nombre-base-datos: ['xobase'], conectar.

Salida escribir: ['¿Podemos conectar? '] + bd ¿conectado?, detener.

>> consulta := bd consultar: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parámetros: ( Lista crear ; ['abc'] ; 12.35 ; 6 ). # consultas parametrizadas

{  consulta ejecutar. bd confirmar. } capturar: { :e bd revertir.  }, empezar.

Salida escribir: ['¿Podemos insertar? '] + ( consulta id-insertado > 0 ), detener.

>> x := 0.
>> consulta :=
bd consultar: ['SELECT * FROM book order by id desc limit 2'], 
extraer: { :fila 
	x añadir: 1.
	Verdadero salir. # debe limpiar, sin 'Commands out of sync'
}.

>> consulta :=
bd consultar: ['SELECT * FROM book order by id desc limit 2'], 
extraer: { :fila
	x añadir: 1.
	Verdadero salir.
}.

(x > 0) verdadero: {
	Salida escribir: ['¿Podemos interrumpir en medio de un fetch? '].
}.

Salida escribir: Verdadero, detener.