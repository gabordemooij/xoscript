
>> vocabulario := (
	Diccionario crear
		poner: ['b'] en: ['a'],
		poner: ['a'] en: ['b'],
		poner: ['z'] en: ['x'],
		poner: ['hello'] en: ['hallo'],
		poner: ['humano'] en: ['humano']
).

>> comparaciones := Lista crear.
vocabulario cada: { :a :b
	comparaciones ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a comparar: b)
	).
}.

comparaciones ordenar: { :a :b <- ( a comparar: b ). }.
Salida escribir: ( comparaciones unir: ['↵'] ), detener.
comparaciones unir: ['↵'].
