
>> dictionary := (
	Diccionario crear
		poner: ['b'] en: ['a'],
		poner: ['a'] en: ['b'],
		poner: ['z'] en: ['x'],
		poner: ['hello'] en: ['hallo'],
		poner: ['human'] en: ['human']
).

>> comparisons := Lista crear.
dictionary cada: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a comparar: b)
	).
}.

comparisons ordenar: { :a :b <- ( a comparar: b ). }.
Salida escribir: ( comparisons unir: ['↵'] ), detener.
comparisons unir: ['↵'].
