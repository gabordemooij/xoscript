# prueba de métodos de captura general
>> x13 := Objeto crear.
x13 al: ['a'] hacer: { :a Salida escribir: 0, detener. }.
x13 al: ['a:'] hacer: { :a Salida escribir: a, detener. <- 5. }.
x13 al: ['a:b:'] hacer: { :a :b Salida escribir: (a + b), detener. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
