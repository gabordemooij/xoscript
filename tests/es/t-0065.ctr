Número al: ['factorial'] hacer: {
	>> total := 1.
	{ :índice total multiplicar: (yo - (índice)). } × yo. <- total.
}.
>> Impresora := Objeto crear.
Impresora al: ['imprimir:y:'] hacer: { :x :y
	Salida escribir: ['a='] + x + [', b='] + y, detener.
}.
>> a := 4.5. >> b := a redondear-bajo.
Impresora imprimir: a y: b.
a := 4. b := a factorial.
Impresora imprimir: a y: b.
a := 4.5. b := a redondear-alto.
Impresora imprimir: a y: b.
a := 4.5. b := a redondear-bajo.
Impresora imprimir: a y: b.
a := 4.5. b := a redondeado.
Impresora imprimir: a y: b.
a := 4.2. b := a redondeado.
Impresora imprimir: a y: b.

