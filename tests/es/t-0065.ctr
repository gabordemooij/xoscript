Número al: ['factorial'] hacer: {
	>> total := 1.
	{ :index total multiplicar: (yo - (index)). } × yo. <- total.
}.
>> Printer := Objeto crear.
Printer al: ['print:and:'] hacer: { :x :y
	Salida escribir: ['a='] + x + [', b='] + y, detener.
}.
>> a := 4.5. >> b := a redondear-bajo.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a redondear-alto.
Printer print: a and: b.
a := 4.5. b := a redondear-bajo.
Printer print: a and: b.
a := 4.5. b := a redondeado.
Printer print: a and: b.
a := 4.2. b := a redondeado.
Printer print: a and: b.

Salida escribir: (9 módulo: 5), detener.
Salida escribir: -666 absoluto, detener.
Salida escribir: 49 raiz-cuadrada, detener.
Salida escribir: (2 elevado-a: 3), detener.
>> l := (Lista ← 9 ; 6).
Salida escribir: l mínimo.

