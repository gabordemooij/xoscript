# prueba de conformidad

# usar números internacionales

Salida escribir: ['1000 -> '].
Salida escribir: 1000, detener. #1000

Salida escribir: ['1.5 -> '].
Salida escribir: 1.5, detener.  #1.5

Salida escribir: ['1001.5 -> '].
Salida escribir: 1.5 + 1000, detener. #1001.5

# usar arreglos con índice desde 0
>> x := Lista crear ; 1 ; 2 ; 3.
>> y := Lista crear ; ['a'] ; ['b'] ; ['c'].

Salida escribir: ['1 -> '].
Salida escribir: x ? 0, detener. #1

Salida escribir: ['1 -> '].
Salida escribir: (x en: 0), detener. #1

Salida escribir: ['1 -> '].
Salida escribir: x primero, detener. #1

Salida escribir: ['3 -> '].
Salida escribir: x último, detener. #3

Salida escribir: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Salida escribir: (x por: y), detener.

Salida escribir: ['1 -> '].
Salida escribir: (x desde: 0 longitud: 1) primero, detener. #1

Salida escribir: ['0 -> '].
Salida escribir: (x encontrar: 1), detener. #0

x poner: 9 en: 0.

Salida escribir: ['9 -> '].
Salida escribir: (x en: 0), detener. #9

x anteponer: 8.
Salida escribir: ['8 -> '].
Salida escribir: (x en: 0), detener. #9


x adjuntar: 10.
Salida escribir: ['10 -> '].
Salida escribir: (x en: 4), detener. #10








