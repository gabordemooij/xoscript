#Linux

(Archivo crear: ['/tmp/testje']) existe falso: {
	Programa sistema: ['mkdir /tmp/testje'].	
}.

(Archivo crear: ['/tmp/testje/file1']) existe falso: {
	Programa sistema: ['touch /tmp/testje/file1'].	
}.

(Archivo crear: ['/tmp/testje/folder1']) existe falso: {
	Programa sistema: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Archivo lista: ['/tmp/testje'].

>> q := Lista crear.

l cada: { :k :v v cada: { :x :y q adjuntar: y. }. }.

>> s := q texto.

(s contiene: ['file1']) verdadero:   { Salida escribir: ['OK'], detener. }.
(s contiene: ['file2']) verdadero:   { Salida escribir: ['XX'], detener. }.
(s contiene: ['folder1']) verdadero: { Salida escribir: ['OK'], detener. }.
