>> t := Verdadero.
(t = Verdadero) verdadero: { Salida escribir: ['T']. }.
(t = Falso) verdadero: { Salida escribir: ['F']. }.
Salida escribir: ['|'].
>> t := Falso.
(t = Verdadero) verdadero: { Salida escribir: ['T']. }.
(t = Falso) verdadero: { Salida escribir: ['F']. }.
Salida escribir: ['|'].
>> f := Verdadero.
(t = Verdadero y: f = Falso) verdadero: { Salida escribir: ['T']. }.
(t = Falso y: f = Verdadero) verdadero: { Salida escribir: ['F']. }.
Salida escribir: ['|'].
>> n := Nulo.
(n ¿nulo?) verdadero: { Salida escribir: ['T']. }.
(n ¿nulo?) falso: { Salida escribir: ['F']. }.
Salida escribir: ['|'].
(f Boolean?) verdadero: { Salida escribir: ['T']. }.
(f Boolean?) falso: { Salida escribir: ['F']. }.



