# test url parsing

Server init.
>> url := URL desde: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Salida escribir: ['scheme = '] + url esquema, detener.
Salida escribir: ['host = '] + url host, detener.
Salida escribir: ['port = '] + url puerto, detener.
Salida escribir: ['path = '] + url ruta, detener.
Salida escribir: ['query = '] + url consulta, detener.
Salida escribir: ['fragment = '] + url fragmento, detener.
