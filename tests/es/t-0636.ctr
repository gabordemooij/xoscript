# prueba de análisis de URL

Server init.
>> url := URL desde: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Salida escribir: ['esquema = '] + url esquema, detener.
Salida escribir: ['host = '] + url host, detener.
Salida escribir: ['puerto = '] + url puerto, detener.
Salida escribir: ['ruta = '] + url ruta, detener.
Salida escribir: ['consulta = '] + url consulta, detener.
Salida escribir: ['fragmento = '] + url fragmento, detener.
