Server init.

>> bd := Maria-DB crear host: ['localhost'],
	usuario: ['xo'],
	contraseña: ['pass123'],
	nombre-base-datos: ['xobase'],
	conectar.

>> elim := bd consultar: ['DELETE FROM book WHERE id > 0'].
{  elim ejecutar. bd confirmar. } capturar: { :e bd revertir.  }, empezar.

>> contar := bd consultar: ['SELECT COUNT(*) AS num FROM book'].
contar extraer: { :fila Salida escribir: fila num, detener. }.
