Server init.

>> db := Maria-DB crear host: ['localhost'],
	usuario: ['xo'],
	contraseña: ['pass123'],
	nombre-base-datos: ['xobase'],
	conectar.

>> del := db consultar: ['DELETE FROM book WHERE id > 0'].
{  del ejecutar. db confirmar. } capturar: { :e db revertir.  }, empezar.

>> contar := db consultar: ['SELECT COUNT(*) AS num FROM book'].
contar extraer: { :row Salida escribir: row num, detener. }.
