Salida escribir: ['Test object'], detener.
>> a := Objeto crear. 

a al: ['item:'] hacer: { :binhelper
	mi binhelper := binhelper. 
}.

a al: ['item'] hacer: { <- mi binhelper.
}.

a item: Bin crear.

>> old-binhelper-address := a item prototipo dirección-de-memoria.
a save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RELOADING SNAP:'], detener.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b item prototipo dirección-de-memoria = old-binhelper-address) verdadero: {
	Salida escribir: ['Object link re-attached.'], detener.
}.


