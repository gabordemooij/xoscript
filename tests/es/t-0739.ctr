Salida escribir: ['Objeto de prueba'], detener.
>> a := Objeto crear. 

a al: ['item:'] hacer: { :ayudantebin
	mi ayudantebin := ayudantebin. 
}.

a al: ['artículo'] hacer: {
	<- mi ayudantebin.
}.

a item: Bin crear.

>> antigua-dirección-ayudantebin := a artículo prototipo dirección-de-memoria.
a save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RECARGANDO SNAP:'], detener.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b artículo prototipo dirección-de-memoria = antigua-dirección-ayudantebin) verdadero: {
	Salida escribir: ['Enlace de objeto reconectado.'], detener.
}.


