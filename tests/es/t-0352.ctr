Número al: ['roman'] hacer: {
	>> número := yo copiar.
	>> roman := [''].
	{
		{
			(número ≥ 1000) verdadero: {
				roman adjuntar: ['Ⅿ'].
				número restar: 1000.
			}, salir.
		
			(número ≥ 500) verdadero: {
				roman adjuntar: ['Ⅾ'].
				número restar: 500.
			}, salir.
		
			(número ≥ 100) verdadero: {
				roman adjuntar: ['Ⅽ'].
				número restar: 100.
			}, salir.
		
			(número ≥ 50) verdadero: {
				roman adjuntar: ['Ⅼ'].
				número restar: 50.
			}, salir.
		
			(número ≥ 50) verdadero: {
				roman adjuntar: ['Ⅼ'].
				número restar: 50.
			}, salir.
		
			(número ≥ 10) verdadero: {
				roman adjuntar: ['Ⅹ'].
				número restar: 10.
			}, salir.
			
			(número ≥ 9) verdadero: {
				roman adjuntar: ['Ⅸ'].
				número restar: 9.
			}, salir.
			
			(número ≥ 5) verdadero: {
				roman adjuntar: ['Ⅴ'].
				número restar: 5.
			}, salir.
			
			(número ≥ 4) verdadero: {
				roman adjuntar: ['Ⅳ'].
				número restar: 4.
			}, salir.
			
			(número ≥ 1) verdadero: {
				roman adjuntar: ['Ⅰ'].
				número restar: 1.
			}, salir.
		} proceder.
	} mientras: { <- número > 0. }. <- roman.
}.

Salida escribir: 1 roman, detener.
Salida escribir: 2 roman, detener.
Salida escribir: 4 roman, detener.
Salida escribir: 8 roman, detener.
Salida escribir: 16 roman, detener.
Salida escribir: 32 roman, detener.
Salida escribir: 64 roman, detener.
Salida escribir: 128 roman, detener.
Salida escribir: 256 roman, detener.
Salida escribir: 1024 roman, detener.
