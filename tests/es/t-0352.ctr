Número al: ['romano'] hacer: {
	>> número := yo copiar.
	>> romano := [''].
	{
		{
			(número ≥ 1000) verdadero: {
				romano adjuntar: ['Ⅿ'].
				número restar: 1000.
			}, salir.
		
			(número ≥ 500) verdadero: {
				romano adjuntar: ['Ⅾ'].
				número restar: 500.
			}, salir.
		
			(número ≥ 100) verdadero: {
				romano adjuntar: ['Ⅽ'].
				número restar: 100.
			}, salir.
		
			(número ≥ 50) verdadero: {
				romano adjuntar: ['Ⅼ'].
				número restar: 50.
			}, salir.
		
			(número ≥ 50) verdadero: {
				romano adjuntar: ['Ⅼ'].
				número restar: 50.
			}, salir.
		
			(número ≥ 10) verdadero: {
				romano adjuntar: ['Ⅹ'].
				número restar: 10.
			}, salir.
			
			(número ≥ 9) verdadero: {
				romano adjuntar: ['Ⅸ'].
				número restar: 9.
			}, salir.
			
			(número ≥ 5) verdadero: {
				romano adjuntar: ['Ⅴ'].
				número restar: 5.
			}, salir.
			
			(número ≥ 4) verdadero: {
				romano adjuntar: ['Ⅳ'].
				número restar: 4.
			}, salir.
			
			(número ≥ 1) verdadero: {
				romano adjuntar: ['Ⅰ'].
				número restar: 1.
			}, salir.
		} proceder.
	} mientras: { <- número > 0. }. <- romano.
}.

Salida escribir: 1 romano, detener.
Salida escribir: 2 romano, detener.
Salida escribir: 4 romano, detener.
Salida escribir: 8 romano, detener.
Salida escribir: 16 romano, detener.
Salida escribir: 32 romano, detener.
Salida escribir: 64 romano, detener.
Salida escribir: 128 romano, detener.
Salida escribir: 256 romano, detener.
Salida escribir: 1024 romano, detener.
