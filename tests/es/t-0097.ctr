
Texto al: ['html'] hacer: { <- (
		yo
		reemplazar: ['&'] con: ['&amp;'],
		reemplazar: ['<'] con: ['&lt;'],
		reemplazar: ['>'] con: ['&gt;'],
		reemplazar: ['"'] con: ['&quot;']
	).
}.

>> PincelHtml := Objeto crear.

PincelHtml al: ['responder:'] hacer: { :etiqueta
	Salida escribir: (['<tag>↵'] tag: etiqueta ).
}.

PincelHtml al: ['responder:y:'] hacer: { :etiqueta :content
	etiqueta := ( etiqueta desde: 0 longitud: (etiqueta longitud - 1) ).
	Salida escribir: (['<tag content>↵'] tag: etiqueta, content: content).
}.

PincelHtml al: ['content:'] hacer: { :elTexto
	Salida escribir: elTexto html, detener.
}.

PincelHtml al: ['atr:valor:'] hacer: { :atr :value <- ['attr="value"'] attr: atr, value: value.
}.

>> h := PincelHtml crear.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h atr: ['class'] valor: ['bold']),
		/span
	/body
/html.
		
