>> Pendientes := Objeto crear.

Pendientes al: ['crear'] hacer: {
	mi list := Lista crear.
}.

Pendientes al: ['nieuw'] hacer: {
	mi list := Lista crear.
}.

Pendientes al: ['+'] hacer: { :tarea
	mi list adjuntar: tarea.
}.

Pendientes al: ['number of tasks?'] hacer: { <-  mi list contar.
}.

>> pendientes := 
	Pendientes crear 
	+ ['hacer la cena'] 
	+ ['limpiar la habitación'].
	
Salida escribir: ['You have $ tasks to do'] $ pendientes number of tasks?.
