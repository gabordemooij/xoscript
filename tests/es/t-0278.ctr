>> To-Do := Objeto crear.

To-Do al: ['crear'] hacer: {
	mi list := Lista crear.
}.

To-Do al: ['nieuw'] hacer: {
	mi list := Lista crear.
}.

To-Do al: ['+'] hacer: { :task
	mi list adjuntar: task.
}.

To-Do al: ['number of tasks?'] hacer: { <-  mi list contar.
}.

>> todos := 
	To-Do crear 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Salida escribir: ['You have $ tasks to do'] $ todos number of tasks?.
