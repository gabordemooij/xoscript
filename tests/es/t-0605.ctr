>> invoice := Objeto crear.
invoice al: ['empezar'] hacer: {
        mi número := 0.
}.

invoice al: ['número'] hacer: {
        mi número añadir: 1. <- mi número copiar.
}.

>> year-invoice := invoice crear.
year-invoice al: ['start:'] hacer: { :año
	mi número := año.
}.

year-invoice start: 202000.
Salida escribir: year-invoice número, detener.
