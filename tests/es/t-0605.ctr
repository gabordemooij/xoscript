>> factura := Objeto crear.
factura al: ['empezar'] hacer: {
        mi número := 0.
}.

factura al: ['número'] hacer: {
        mi número añadir: 1.
        <- mi número copiar.
}.

>> factura-anual := factura crear.
factura-anual al: ['start:'] hacer: { :año
	mi número := año.
}.

factura-anual start: 202000.
Salida escribir: factura-anual número, detener.
Salida escribir: factura-anual número, detener.
