Salida escribir: ['Test object'], detener.
>> a := Objeto crear. 
a al: ['item:'] hacer: { :int64
	mi int64 := int64. 
}.
a al: ['item'] hacer: { <- mi int64.
}.
a item: ( Int64 desde-texto: ['9999'] ).
Salida escribir: a item, detener.
>> old-int64-address := a item prototipo dirección-de-memoria.
a save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RELOADING SNAP:'], detener.
>> b := Objeto load-from: ['/tmp/a.bin'].
(b item prototipo dirección-de-memoria = old-int64-address) verdadero: {
	Salida escribir: ['Object link re-attached.'], detener.
}.
Salida escribir: ( b item ), detener.
