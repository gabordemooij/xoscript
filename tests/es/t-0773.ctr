Salida escribir: ['Objeto de prueba'], detener.
>> a := Objeto crear. 
a al: ['item:'] hacer: { :int64
	mi int64 := int64. 
}.
a al: ['artículo'] hacer: {
	<- mi int64.
}.
a item: ( Int64 desde-texto: ['9999'] ).
Salida escribir: a artículo, detener.
>> antigua-dirección-int64 := a artículo prototipo dirección-de-memoria.
a save-as: ['/tmp/a.bin'].
Salida escribir: ['========== RECARGANDO SNAP:'], detener.
>> b := Objeto load-from: ['/tmp/a.bin'].
(b artículo prototipo dirección-de-memoria = antigua-dirección-int64) verdadero: {
	Salida escribir: ['Enlace de objeto reconectado.'], detener.
}.
Salida escribir: ( b artículo ), detener.
