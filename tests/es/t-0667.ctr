# test Program version

# this feature is disabled by default
Salida escribir: (
	Programa funcionalidad: 
	['RECURSIVE_STRINTPOL']
), detener.


# but if we set the time back
>> today := Momento 
zona: ['CEST'],
desde: ['2026-02-15 10:00:00'].
Programa versión: today.

# it will be enabled like it used to be (from now on)
Salida escribir: (
	Programa funcionalidad: 
	['RECURSIVE_STRINTPOL']
), detener.