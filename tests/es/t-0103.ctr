>> a := Lista ← Objeto ; Verdadero ; Falso ; Booleano ; 1 ; Número ; ['Str'] ; Texto ; { ['Vacío']. }.
Salida escribir: (a contar), detener.
{ :i
	Salida escribir: 
	['a '] + 
	((a ? i) tipo) +
	([' \‘this\’ '] this: (a ? i))  +
	[' es '] +
	(((a ? i) ¿nulo?) o: [''] o: ['no']) + 
	[' Nulo.'],
	detener.
} × (a contar).
Salida escribir: ['pero.. Nulo es.. '] + ((Nulo ¿nulo?) o: ['¡ciertamente NULO!'] o: ['¿no NULO??']), detener.