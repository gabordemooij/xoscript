>> a := Lista ← Objeto ; Verdadero ; Falso ; Booleano ; 1 ; Número ; ['Str'] ; Texto ; { ['Empty']. }.
Salida escribir: (a contar), detener.
{ :i
	Salida escribir: 
	['a '] + 
	((a ? i) tipo) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) ¿nulo?) o: [''] o: ['NOT']) + 
	[' Nil.'],
	detener.
} × (a contar).
Salida escribir: ['but.. Nil is.. '] + ((Nulo ¿nulo?) o: ['certainly NIL!'] o: ['not NIL??']), detener.