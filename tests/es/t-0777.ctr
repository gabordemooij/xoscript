#OBSD
>> dirname := [''].
{ dirname adjuntar: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Programa sistema: command.
Programa chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename adjuntar: ['YYYYYYYY']. } * 20.
Archivo crear: filename, escribir: ['sometext'].
{ Archivo lista: ['/tmp/'] + dirname. } * 1000.
Salida escribir: ['no crash'], detener.

