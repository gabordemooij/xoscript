60 × {
	>> x := (Número random % 6) + 1.
	(x ≤ 6) falso: { Salida escribir: ['FAIL']. }.
	(x ≥0) falso: { Salida escribir: ['FAIL']. }.
	x := (Número random % 3) + 1.
	(x < 3) falso: { Salida escribir: ['FAIL']. }.
	(x>-1) falso: { Salida escribir: ['FAIL']. }.
	x := ((Booleano flip) número).
	(x = 0 o: x = 1) falso: { Salida escribir: ['FAIL']. }.
	x := ((Verdadero flip) número).
	(x = 0 o: x = 1) falso: { Salida escribir: ['FAIL']. }.
	x := (Booleano flip o: ['HEAD'] o: ['TAIL']).
	((x = ['HEAD']) o: (x = ['TAIL'])) falso: { Salida escribir: ['FAIL']. }.
}.
Salida escribir: ['DONE'].

