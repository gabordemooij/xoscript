60 × {
	>> x := (Número aleatorio % 6) + 1.
	(x ≤ 6) falso: { Salida escribir: ['FALLO']. }.
	(x ≥0) falso: { Salida escribir: ['FALLO']. }.
	x := (Número aleatorio % 3) + 1.
	(x < 3) falso: { Salida escribir: ['FALLO']. }.
	(x>-1) falso: { Salida escribir: ['FALLO']. }.
	x := ((Booleano lanzar) número).
	(x = 0 o: x = 1) falso: { Salida escribir: ['FALLO']. }.
	x := ((Verdadero lanzar) número).
	(x = 0 o: x = 1) falso: { Salida escribir: ['FALLO']. }.
	x := (Booleano lanzar o: ['CARA'] o: ['CRUZ']).
	((x = ['CARA']) o: (x = ['CRUZ'])) falso: { Salida escribir: ['FALLO']. }.
}.
Salida escribir: ['HECHO'].

