



>> PosoDeCafé := Objeto crear.
PosoDeCafé al: ['sacar'] hacer: { <- ['coffee']. }.

>> Cafetera := Objeto crear.
Cafetera al: ['init'] hacer: {
	mi posodecafé := PosoDeCafé crear.
}.
Cafetera al: ['crear'] hacer: { <- Cafetera `new init.
}.

Cafetera al: ['hacerTé'] hacer: { <- (mi hojasdeté sacar). }.
Cafetera al: ['hacerCafé'] hacer: { <- (mi posodecafé sacar). }.

>> sueñoDeCafé := Cafetera crear.

Salida escribir:
	sueñoDeCafé 
	hacerCafé.

Salida escribir:
	sueñoDeCafé 
	hacerTé.
