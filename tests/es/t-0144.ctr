



>> CoffeeGrounds := Objeto crear.
CoffeeGrounds al: ['extract'] hacer: { <- ['coffee']. }.

>> CoffeeMachine := Objeto crear.
CoffeeMachine al: ['init'] hacer: {
	mi coffeegrounds := CoffeeGrounds crear.
}.
CoffeeMachine al: ['crear'] hacer: { <- CoffeeMachine `new init.
}.

CoffeeMachine al: ['makeTea'] hacer: { <- (mi tealeaves extract). }.
CoffeeMachine al: ['makeCoffee'] hacer: { <- (mi coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine crear.

Salida escribir:
	coffeeDream 
	makeCoffee.

Salida escribir:
	coffeeDream 
	makeTea.
