
Texto al: ['evaluar'] hacer: {
	>> código := Archivo crear: ['/tmp/eval.ctr'].
	código escribir: (yo texto + ['.']).
	Programa utilizar: ['/tmp/eval.ctr'].
}.

>> map :=
	(Diccionario crear)
	poner: ['Hola a todos'] en: ['two'],
	poner: (Lista ← ['hello'] ; ['world'] ; (Lista ← 1 ; 2; 9) ; Falso) en: ['uno'],
	poner: ( (Diccionario crear) poner: ['mnudo'] en: ['malescrito'] ) en: ['three'],
	poner: (Lista ← ((Diccionario crear) poner: ['tesoro'] en: ['oculto']) ; 2) en: ['cuatro']. 
>> str := map texto.
>> map2 := Nulo.
(['map2 := '] + str ) evaluar.
Salida escribir: map2 ? ['uno'] ? 0.
Salida escribir: map2 ? ['uno'] ? 1.
Salida escribir: map2 ? ['cuatro'] ? 0 ? ['oculto'].
Salida escribir: map2 ? ['uno'] ? 2 ? 2.
