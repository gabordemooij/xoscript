
Texto al: ['evaluate'] hacer: {
	>> código := Archivo crear: ['/tmp/eval.ctr'].
	código escribir: (yo texto + ['.']).
	Programa utilizar: ['/tmp/eval.ctr'].
}.

>> map :=
	(Diccionario crear)
	poner: ['Hi There'] en: ['two'],
	poner: (Lista ← ['hello'] ; ['world'] ; (Lista ← 1 ; 2; 9) ; Falso) en: ['one'],
	poner: ( (Diccionario crear) poner: ['wrrld'] en: ['misspelled'] ) en: ['three'],
	poner: (Lista ← ((Diccionario crear) poner: ['treasure'] en: ['hidden']) ; 2) en: ['four']. 
>> str := map texto.
>> map2 := Nulo.
(['map2 := '] + str ) evaluate.
Salida escribir: map2 ? ['one'] ? 0.
Salida escribir: map2 ? ['one'] ? 1.
Salida escribir: map2 ? ['four'] ? 0 ? ['hidden'].
Salida escribir: map2 ? ['one'] ? 2 ? 2.
