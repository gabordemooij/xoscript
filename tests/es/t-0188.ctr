

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa orden: 0.

{ :i Salida escribir: i. } × 4.
Salida detener.
{ :i Salida escribir: (4 - i). } × 4.
Salida detener.
( 1 > 2 ) falso: { Salida escribir: ['BLOCK 1'], detener. }.
( 2 > 1 ) verdadero:  { Salida escribir: ['BLOCK 2'], detener. }.

>> i := 0.
{ Salida escribir: i. i añadir: 1. } mientras: { <- ( i < 3). }.
Salida detener.

i := 3.
{ Salida escribir: i. i := i - 1. } mientras: { <- ( i > 0). }.
Salida detener.


Programa limpiar-memoria.

usedMemory1 := (Programa memoria ? 0).


{ :i  Salida escribir: i. } × 4.
Salida detener.
{ :i  Salida escribir: (4 - i). } × 4.
Salida detener.
( 1 > 2 ) falso: { Salida escribir: ['BLOCK 1'], detener. }.
( 2 > 1 ) verdadero:  { Salida escribir: ['BLOCK 2'], detener. }.

>> i := 0.
{ Salida escribir: i. i añadir: 1. } mientras: { <- ( i < 3). }.
Salida detener.

i := 3.
{ Salida escribir: i. i := i - 1. } mientras: { <- ( i > 0). }.
Salida detener.



Programa limpiar-memoria.
usedMemory2 := (Programa memoria ? 0).


{ :i Salida escribir: i. } × 4.
Salida detener.
{ :i Salida escribir: (4 - i). } × 4.
Salida detener.
( 1 > 2 ) falso: { Salida escribir: ['BLOCK 1'], detener. }.
( 2 > 1 ) verdadero:  { Salida escribir: ['BLOCK 2'], detener. }.

>> i := 0.
{ Salida escribir: i. i añadir: 1. } mientras: { <- ( i < 3). }.
Salida detener.

i := 3.
{ Salida escribir: i. i := i - 1. } mientras: { <- ( i > 0). }.
Salida detener.

Programa limpiar-memoria.
usedMemory3 := (Programa memoria ? 0).



( usedMemory1 = usedMemory2 y: usedMemory1 = usedMemory3, y: usedMemory2 = usedMemory3 ) verdadero: {
	Salida escribir: ['No memory leaks here'].
}, falso: {
	Salida escribir: ['Leaking memory...'].
}.
