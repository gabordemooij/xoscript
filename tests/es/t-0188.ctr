

>> memoriaUsada1 := 0.
>> memoriaUsada2 := 0.
>> memoriaUsada3 := 0.
>> memoriaUsada4 := 0.

Programa orden: 0.

{ :i Salida escribir: i. } × 4.
Salida detener.
{ :i Salida escribir: (4 - i). } × 4.
Salida detener.
( 1 > 2 ) falso: { Salida escribir: ['BLOQUE 1'], detener. }.
( 2 > 1 ) verdadero:  { Salida escribir: ['BLOQUE 2'], detener. }.

>> i := 0.
{ Salida escribir: i. i añadir: 1. } mientras: { <- ( i < 3). }.
Salida detener.

i := 3.
{ Salida escribir: i. i := i - 1. } mientras: { <- ( i > 0). }.
Salida detener.


Programa limpiar-memoria.

memoriaUsada1 := (Programa memoria ? 0).


{ :i  Salida escribir: i. } × 4.
Salida detener.
{ :i  Salida escribir: (4 - i). } × 4.
Salida detener.
( 1 > 2 ) falso: { Salida escribir: ['BLOQUE 1'], detener. }.
( 2 > 1 ) verdadero:  { Salida escribir: ['BLOQUE 2'], detener. }.

>> i := 0.
{ Salida escribir: i. i añadir: 1. } mientras: { <- ( i < 3). }.
Salida detener.

i := 3.
{ Salida escribir: i. i := i - 1. } mientras: { <- ( i > 0). }.
Salida detener.



Programa limpiar-memoria.
memoriaUsada2 := (Programa memoria ? 0).


{ :i Salida escribir: i. } × 4.
Salida detener.
{ :i Salida escribir: (4 - i). } × 4.
Salida detener.
( 1 > 2 ) falso: { Salida escribir: ['BLOQUE 1'], detener. }.
( 2 > 1 ) verdadero:  { Salida escribir: ['BLOQUE 2'], detener. }.

>> i := 0.
{ Salida escribir: i. i añadir: 1. } mientras: { <- ( i < 3). }.
Salida detener.

i := 3.
{ Salida escribir: i. i := i - 1. } mientras: { <- ( i > 0). }.
Salida detener.

Programa limpiar-memoria.
memoriaUsada3 := (Programa memoria ? 0).



( memoriaUsada1 = memoriaUsada2 y: memoriaUsada1 = memoriaUsada3, y: memoriaUsada2 = memoriaUsada3 ) verdadero: {
	Salida escribir: ['Aquí no hay fugas de memoria'].
}, falso: {
	Salida escribir: ['Fuga de memoria...'].
}.
