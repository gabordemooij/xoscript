>> HTML := Objeto crear.
HTML al: ['responder:'] hacer: { :tag 
	Salida escribir: (['<tag>'] tag: tag), detener.
}.
HTML al: ['responder:y:'] hacer: { :tag :html 
	Salida escribir: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), detener.
}.
>> html := HTML crear.
html body h1: ['header'].

