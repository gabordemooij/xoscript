>> HTML := Objeto crear.
HTML al: ['responder:'] hacer: { :etiqueta 
	Salida escribir: (['<tag>'] tag: etiqueta), detener.
}.
HTML al: ['responder:y:'] hacer: { :etiqueta :html 
	Salida escribir: (
		['<tag>innerHTML</tag>']
		tag: etiqueta - [':'],
		innerHTML: html
	), detener.
}.
>> html := HTML crear.
html body h1: ['header'].

