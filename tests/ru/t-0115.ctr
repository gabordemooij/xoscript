{
	этот-блок-кода ошибка: ['Не падай.'].
	неизвестный сделатьЧтоТо.
} впоймать: {
	Выход написать: ['Поймано!'].
}, запуск.

{
	этот-блок-кода ошибка: ['Не падай.'].
	мой неизвестный сделатьЧтоТо.
} впоймать: {
	Выход написать: ['Поймано!'].
}, запуск.

{
	этот-блок-кода ошибка: ['Не падай.'].
	неизвестный := 122.
} впоймать: {
	Выход написать: ['Поймано!'].
}, запуск.


{
	этот-блок-кода ошибка: ['Не падай.'].
	Истина разрыв.
	Выход написать: ['ОШИБКА'].
} впоймать: {
	Выход написать: ['Поймано!'].
}, запуск.

{
	{
		этот-блок-кода ошибка: ['Не падай.'].
		Истина разрыв.
		Выход написать: ['ОШИБКА'].
	} впоймать: { :x
		(x = ['Не падай.']) истина: { этот-блок-кода ошибка: ['Вложенное поймано!']. }.
	}, запуск.
} впоймать: { :e
	Выход написать: e.
}, запуск.
