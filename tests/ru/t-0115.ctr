{
	этот-блок-кода ошибка: ['Dont fail.'].
	unknown doSomething.
} впоймать: {
	Выход написать: ['Caught!'].
}, запуск.

{
	этот-блок-кода ошибка: ['Dont fail.'].
	мой unknown doSomething.
} впоймать: {
	Выход написать: ['Caught!'].
}, запуск.

{
	этот-блок-кода ошибка: ['Dont fail.'].
	unknown := 122.
} впоймать: {
	Выход написать: ['Caught!'].
}, запуск.


{
	этот-блок-кода ошибка: ['Dont fail.'].
	Истина разрыв.
	Выход написать: ['FAIL'].
} впоймать: {
	Выход написать: ['Caught!'].
}, запуск.

{
	{
		этот-блок-кода ошибка: ['Dont fail.'].
		Истина разрыв.
		Выход написать: ['FAIL'].
	} впоймать: { :x
		(x = ['Dont fail.']) истина: { этот-блок-кода ошибка: ['Nested Caught!']. }.
	}, запуск.
} впоймать: { :e
	Выход написать: e.
}, запуск.
