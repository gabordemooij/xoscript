# тест методов перехвата всех сообщений
>> x13 := Объект новый.
x13 в: ['a'] сделать: { :a Выход написать: 0, стоп. }.
x13 в: ['a:'] сделать: { :a Выход написать: a, стоп. <- 5. }.
x13 в: ['a:b:'] сделать: { :a :b Выход написать: (a + b), стоп. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
