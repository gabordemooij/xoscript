Server init.

>> db := MariaDB новый хост: ['localhost'],
	пользователь: ['xo'],
	пароль: ['pass123'],
	имя-базы: ['xobase'],
	подключить.

>> параметры := db запрос: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], параметры: ( Список новый ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  параметры мутация. db commit. } впоймать: { :e db rollback.  }, запуск.

Выход написать: ['Can we insert? '] + ( параметры insert-id > 0 ), стоп.
