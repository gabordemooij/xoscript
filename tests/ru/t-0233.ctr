
>> Глоток := Объект новый.

Глоток в: ['новый'] сделать: {
	мой str := [''].
}.

Глоток в: ['ответить:'] сделать: { :blah
		(мой str = ['']) истина: {
			мой str добавить-в-конец: blah.
		}, иначе: {
			мой str добавить-в-конец: [' '].
			мой str добавить-в-конец: blah.
		}.
}.

Глоток в: ['ответить:и:'] сделать: { :blah :блаха
		(blah длина > 1) истина: {
			мой str добавить-в-конец: (blah от: 0 длина: (blah длина - 1)).
		}, иначе: {
			мой str добавить-в-конец: blah.
		}.
		мой str добавить-в-конец: [' '].
		мой str добавить-в-конец: блаха.
}.

Глоток в: ['заполучить'] сделать: {
	>> буфер := мой str.
	мой str := ['']. <- буфер.
}.

Выход написать: ( Программа Системная-команда: ( Глоток новый echo hello world заполучить ) ).
