>> Animal := Объект новый.
Animal в: ['make'] сделать: {
	>> animal := Объект новый.
	animal в: ['makeSound'] сделать: {
		Выход написать: мой sound.
	}. <- animal.
}.
>> Cat := Объект новый.
Cat в: ['make'] сделать: {
	>> cat := Animal make.
	cat в: ['init'] сделать: {
		мой sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
