# открытый ключ (для защиты API и т. п.)
Server init.

# генерируем ключи
>> пара-ключей := Хранилище криптографические-ключи.

# закрытый (секретный) ключ
>> зкл := пара-ключей первый.

# открытый ключ
>> откл := пара-ключей последний.

# подписываем сообщение
>> подп := Хранилище подписать: ['abc'] с: зкл.

# проверка сообщения (ок)
Выход написать: ( 
	Хранилище
		проверить: ['abc'] 
		подпись: подп 
		с: откл 
), стоп.

# проверка сообщения (неудача)
Выход написать: ( 
	Хранилище 
		проверить: ['abd'] 
		подпись: подп 
		с: откл 
), стоп.