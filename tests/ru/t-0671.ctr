# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Хранилище криптографические-ключи.

# private (secret) key
>> sk := keys первый.

# public key
>> pk := keys последний.

# sign a message
>> sig := Хранилище подписать: ['abc'] с: sk.

# check message (ok)
Выход написать: ( 
	Хранилище
		проверить: ['abc'] 
		подпись: sig 
		с: pk 
), стоп.

# check message (fail)
Выход написать: ( 
	Хранилище 
		проверить: ['abd'] 
		подпись: sig 
		с: pk 
), стоп.