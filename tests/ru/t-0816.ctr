# a format must fit the type of the value, the type can come from a client
>> попробуй := { :format :value
	{ Выход написать: ( (Формат новый: format) применить: value ), стоп. } впоймать: { :e Выход написать: e, стоп. }, запуск.
}.
>> try-int := { :format :value
	{ Выход написать: ( (Формат новый: format) применить-int: value ), стоп. } впоймать: { :e Выход написать: e, стоп. }, запуск.
}.

# fits
попробуй применить: ['|%s|'] и: ['text'].
попробуй применить: ['%06.2f'] и: 5.5.
попробуй применить: ['100%% %s'] и: ['sure'].
try-int применить: ['%03d'] и: 7.
try-int применить: ['%x'] и: 255.
попробуй применить: ['%d'] и: (Int64 новый от-тексту: ['12']).
попробуй применить: ['%lld'] и: (Int64 новый от-тексту: ['12']).
попробуй применить: ['%.1lf'] и: 5.5.
try-int применить: ['%hd'] и: 7.

# does not fit
попробуй применить: ['%s'] и: 12345.
попробуй применить: ['%d'] и: 12345.
попробуй применить: ['%f'] и: ['text'].
try-int применить: ['%d'] и: ['text'].
try-int применить: ['%s'] и: 5.
попробуй применить: ['%s %s'] и: ['text'].
попробуй применить: ['%n'] и: ['text'].
попробуй применить: ['%*s'] и: ['text'].
попробуй применить: ['%'] и: ['text'].

# length modifier does not fit
попробуй применить: ['%ls'] и: ['text'].
попробуй применить: ['%Lf'] и: 5.5.
try-int применить: ['%ld'] и: 7.
try-int применить: ['%lld'] и: 7.
попробуй применить: ['%Ld'] и: (Int64 новый от-тексту: ['12']).

# a width that does not fit printf must give an error, not a crash
попробуй применить: ['%99999999999s'] и: ['text'].
