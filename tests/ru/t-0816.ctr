# формат должен соответствовать типу значения, тип может прийти от клиента
>> попробуй := { :формат-значения :value
	{ Выход написать: ( (Формат новый: формат-значения) применить: value ), стоп. } впоймать: { :e Выход написать: e, стоп. }, запуск.
}.
>> попробовать-целое := { :формат-значения :value
	{ Выход написать: ( (Формат новый: формат-значения) применить-int: value ), стоп. } впоймать: { :e Выход написать: e, стоп. }, запуск.
}.

# подходит
попробуй применить: ['|%s|'] и: ['text'].
попробуй применить: ['%06.2f'] и: 5.5.
попробуй применить: ['100%% %s'] и: ['конечно'].
попробовать-целое применить: ['%03d'] и: 7.
попробовать-целое применить: ['%x'] и: 255.
попробуй применить: ['%d'] и: (Int64 новый от-тексту: ['12']).
попробуй применить: ['%lld'] и: (Int64 новый от-тексту: ['12']).
попробуй применить: ['%.1lf'] и: 5.5.
попробовать-целое применить: ['%hd'] и: 7.

# не подходит
попробуй применить: ['%s'] и: 12345.
попробуй применить: ['%d'] и: 12345.
попробуй применить: ['%f'] и: ['text'].
попробовать-целое применить: ['%d'] и: ['text'].
попробовать-целое применить: ['%s'] и: 5.
попробуй применить: ['%s %s'] и: ['text'].
попробуй применить: ['%n'] и: ['text'].
попробуй применить: ['%*s'] и: ['text'].
попробуй применить: ['%'] и: ['text'].

# модификатор длины не подходит
попробуй применить: ['%ls'] и: ['text'].
попробуй применить: ['%Lf'] и: 5.5.
попробовать-целое применить: ['%ld'] и: 7.
попробовать-целое применить: ['%lld'] и: 7.
попробуй применить: ['%Ld'] и: (Int64 новый от-тексту: ['12']).

# ширина, которая не подходит для printf, должна давать ошибку, а не сбой
попробуй применить: ['%99999999999s'] и: ['text'].
