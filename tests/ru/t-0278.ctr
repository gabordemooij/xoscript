>> Дела := Объект новый.

Дела в: ['новый'] сделать: {
	мой list := Список новый.
}.

Дела в: ['nieuw'] сделать: {
	мой list := Список новый.
}.

Дела в: ['+'] сделать: { :задача
	мой list добавить-в-конец: задача.
}.

Дела в: ['number of tasks?'] сделать: { <-  мой list счетчик.
}.

>> список-дел := 
	Дела новый 
	+ ['приготовить ужин'] 
	+ ['убрать комнату'].
	
Выход написать: ['You have $ tasks to do'] $ список-дел number of tasks?.
