Выход написать: ['Test object'], стоп.
>> a := Объект новый. 

a в: ['item:'] сделать: { :out
	мой out := out. 
}.

a в: ['item'] сделать: { <- мой out.
}.

a в: ['greet'] сделать: {
	Выход написать: ['hi from original out!'], стоп.
}.

a item: Выход.

Выход написать: a item, стоп.

>> old-out-address := a item прототип адрес-памяти.
a save-as: ['/tmp/a.bin'].
Выход написать: ['========== RELOADING SNAP:'], стоп.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип адрес-памяти = old-out-address) истина: {
	Выход написать: ['Object link re-attached.'], стоп.
}.

b item написать: ['hello from loaded out!'], стоп.
b greet.
