Выход написать: ['Тестовый объект'], стоп.
>> a := Объект новый. 

a в: ['item:'] сделать: { :выв
	мой выв := выв. 
}.

a в: ['предмет'] сделать: {
	<- мой выв.
}.

a в: ['поприветствовать'] сделать: {
	Выход написать: ['привет из исходного выхода!'], стоп.
}.

a item: Выход.

Выход написать: a предмет, стоп.

>> старый-адрес-выв := a предмет прототип адрес-памяти.
a save-as: ['/tmp/a.bin'].
Выход написать: ['========== ПЕРЕЗАГРУЗКА СНИМКА:'], стоп.

>> b := Объект load-from: ['/tmp/a.bin'].

(b предмет прототип адрес-памяти = старый-адрес-выв) истина: {
	Выход написать: ['Связь объекта восстановлена.'], стоп.
}.

b предмет написать: ['привет из загруженного выхода!'], стоп.
b поприветствовать.
