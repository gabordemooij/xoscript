# Хеширование пароля
Server init.

# Пользователь задаёт пароль
>> пар := ['pass123'].

# Сохраняете его вот так
>> хешПароля := Хранилище 
	хэш-пароля: пар.

# Затем пользователь входит в систему
# Попытка 1
>> a1 := ['abcd123'].
# Попытка 2
>> a2 := ['pass123'].

# Проверка
>> a := Хранилище 
	хэш-пароля: хешПароля проверить: a1.
	# неудача 
>> b := Хранилище
	хэш-пароля: хешПароля проверить: a2.
	# ок!

Выход написать: a, стоп.
Выход написать: b, стоп.

