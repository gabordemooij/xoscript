# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Хранилище 
	хэш-пароля: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Хранилище 
	хэш-пароля: hash проверить: a1.
	# fail 
>> b := Хранилище
	хэш-пароля: hash проверить: a2.
	# ok!

Выход написать: a, стоп.
Выход написать: b, стоп.

