
>> словарь := (
	Карта новый
		разместить: ['b'] в: ['a'],
		разместить: ['a'] в: ['b'],
		разместить: ['z'] в: ['x'],
		разместить: ['hello'] в: ['hallo'],
		разместить: ['human'] в: ['human']
).

>> сравнения := Список новый.
словарь каждый: { :a :b
	сравнения ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a сравнить: b)
	).
}.

сравнения сортировать: { :a :b <- ( a сравнить: b ). }.
Выход написать: ( сравнения присоединить: ['↵'] ), стоп.
сравнения присоединить: ['↵'].
