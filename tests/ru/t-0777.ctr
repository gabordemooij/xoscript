#OBSD
>> имяКаталога := [''].
{ имяКаталога добавить-в-конец: ['X/']. } * (1024 / 2 - 4).
>> команда := ['mkdir -p /tmp/'] + имяКаталога.
Программа Системная-команда: команда.
Программа chdir: ['/tmp/'] + имяКаталога.
>> имяФайла := [''].
{ имяФайла добавить-в-конец: ['YYYYYYYY']. } * 20.
Файл новый: имяФайла, написать: ['какой-то текст'].
{ Файл список: ['/tmp/'] + имяКаталога. } * 1000.
Выход написать: ['без падения'], стоп.

