# test buffers PKI/Sign 
Server init.

>> long := ( Список новый заполнить: 1000 буквой: ['a'] ) присоединить: [''].

# sign a message
Выход написать: ( 
	Хранилище подписать: ['abc'] с: long
), стоп.

Выход написать: ( 
	Хранилище
		проверить: ['abc'] 
		подпись: long 
		с: long
), стоп.

Выход написать: (
	Хранилище хэш-пароля: long проверить: long
), стоп.
