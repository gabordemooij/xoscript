# тест буферов PKI/Sign 
Server init.

>> длинный := ( Список новый заполнить: 1000 буквой: ['a'] ) присоединить: [''].

# подписываем сообщение
Выход написать: ( 
	Хранилище подписать: ['abc'] с: длинный
), стоп.

Выход написать: ( 
	Хранилище
		проверить: ['abc'] 
		подпись: длинный 
		с: длинный
), стоп.

Выход написать: (
	Хранилище хэш-пароля: длинный проверить: длинный
), стоп.
