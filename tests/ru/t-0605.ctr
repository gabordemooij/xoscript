>> счёт-фактура := Объект новый.
счёт-фактура в: ['запуск'] сделать: {
        мой к-числу := 0.
}.

счёт-фактура в: ['к-числу'] сделать: {
        мой к-числу добавить: 1.
        <- мой к-числу скопировать.
}.

>> годовой-счёт := счёт-фактура новый.
годовой-счёт в: ['start:'] сделать: { :год
	мой к-числу := год.
}.

годовой-счёт start: 202000.
Выход написать: годовой-счёт к-числу, стоп.
Выход написать: годовой-счёт к-числу, стоп.
