>> invoice := Объект новый.
invoice в: ['запуск'] сделать: {
        мой к-числу := 0.
}.

invoice в: ['к-числу'] сделать: {
        мой к-числу добавить: 1. <- мой к-числу скопировать.
}.

>> year-invoice := invoice новый.
year-invoice в: ['start:'] сделать: { :год
	мой к-числу := год.
}.

year-invoice start: 202000.
