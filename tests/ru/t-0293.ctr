
>> город := Список ← ['Лондон'] ; ['Париж'] ; ['Берлин'].
>> температура := Список ← ['15'] ; ['16'] ; ['15'].
>> погода := температура на: город.
>> города := погода ключи сортировать: { :a :b <- (a сравнить: b). }.
>> температуры := погода значение сортировать: { :a :b <- (a сравнить: b) отрицательный?. }.

Выход написать: (города присоединить: [',']), стоп.
Выход написать: (температуры присоединить: [',']), стоп.
