

>> занятаПамять1 := 0.
>> занятаПамять2 := 0.
>> занятаПамять3 := 0.
>> занятаПамять4 := 0.

Программа режим-памяти: 0.

>> a := Список ← ['hello'] ; ['world'] ; Истина ; Пустой ; 666.
>> b := a от: 2 длина: 2.
Выход написать: ( b присоединить: ['|'] ), написать: b счетчик.

Программа уборка.
занятаПамять1 := (Программа лимит ? 0).


a := Список ← ['hello'] ; ['world'] ; Истина ; Пустой ; 666.
b := a от: 2 длина: 2.
Выход написать: ( b присоединить: ['|'] ), написать: b счетчик.


Программа уборка.
занятаПамять2 := (Программа лимит ? 0).


a := Список ← ['hello'] ; ['world'] ; Истина ; Пустой ; 666.
b := a от: 2 длина: 2.
Выход написать: ( b присоединить: ['|'] ), написать: b счетчик.


Программа уборка.
занятаПамять3 := (Программа лимит ? 0).



( занятаПамять1 = занятаПамять2 и: занятаПамять1 = занятаПамять3, и: занятаПамять2 = занятаПамять3 ) истина: {
	Выход написать: ['Здесь нет утечек памяти'].
}, ложь: {
	Выход написать: ['Утечка памяти...'].
}.
