>> x := [' hallo '].

>> y := x верхний-регистр.
Выход написать: x, стоп.
Выход написать: (x равно: y), стоп.

>> y := x нижний-регистр.
Выход написать: x, стоп.
Выход написать: (x равно: y), стоп.

>> y := x сократить.
Выход написать: x, стоп.
Выход написать: (x равно: y), стоп.

>> y := x сместить: 1.
Выход написать: x, стоп.
Выход написать: (x равно: y), стоп.

>> y := x от: 1 длина: 2.
Выход написать: x, стоп.
Выход написать: (x равно: y), стоп.