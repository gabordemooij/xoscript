# compliance test

# use international numbers

Выход написать: ['1000 -> '].
Выход написать: 1000, стоп. #1000

Выход написать: ['1.5 -> '].
Выход написать: 1.5, стоп.  #1.5

Выход написать: ['1001.5 -> '].
Выход написать: 1.5 + 1000, стоп. #1001.5

# use 0-indexed arrays
>> x := Список новый ; 1 ; 2 ; 3.
>> y := Список новый ; ['a'] ; ['b'] ; ['c'].

Выход написать: ['1 -> '].
Выход написать: x ? 0, стоп. #1

Выход написать: ['1 -> '].
Выход написать: (x в: 0), стоп. #1

Выход написать: ['1 -> '].
Выход написать: x первый, стоп. #1

Выход написать: ['3 -> '].
Выход написать: x последний, стоп. #3

Выход написать: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Выход написать: (x на: y), стоп.

Выход написать: ['1 -> '].
Выход написать: (x от: 0 длина: 1) первый, стоп. #1

Выход написать: ['0 -> '].
Выход написать: (x найти: 1), стоп. #0

x разместить: 9 в: 0.

Выход написать: ['9 -> '].
Выход написать: (x в: 0), стоп. #9

x добавить-в-начало: 8.
Выход написать: ['8 -> '].
Выход написать: (x в: 0), стоп. #9


x добавить-в-конец: 10.
Выход написать: ['10 -> '].
Выход написать: (x в: 4), стоп. #10








