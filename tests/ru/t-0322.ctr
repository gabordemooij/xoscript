

>> Матрёшка := Объект новый.
Матрёшка в: ['double:'] сделать: { :секрет
	мой секрет := секрет × 2.
}.
Матрёшка в: ['новый:'] сделать: { :секрет
	>> ответ := Пустой.
	>> t := (секрет > 255).
	Выход написать: (секрет + [' | '] + t), стоп.
	t истина: {
		ответ := секрет.
	}, иначе: {
		ответ := Матрёшка рекурсия новый: (сам double: секрет).
	}. <- ответ.
}.

>> x := Матрёшка новый: 2.
