

>> Matryoshka := Объект новый.
Matryoshka в: ['double:'] сделать: { :secret
	мой secret := secret × 2.
}.
Matryoshka в: ['новый:'] сделать: { :secret
	>> answer := Пустой.
	>> t := (secret > 255).
	Выход написать: (secret + [' | '] + t), стоп.
	t истина: {
		answer := secret.
	}, иначе: {
		answer := Matryoshka рекурсия новый: (сам double: secret).
	}. <- answer.
}.

>> x := Matryoshka новый: 2.
