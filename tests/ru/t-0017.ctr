Число в: ['факториал'] сделать: {
	>> итог := 1.
	{ :индекс итог умножить-на: (сам - (индекс)). } × сам. <- итог.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Выход написать: a.
>> b := 2 + 3 факториал.
Выход написать: b.
>> c := 3 факториал + 2.
Выход написать: c.
>> d := 2 + (3 факториал).
Выход написать: d.
Выход написать: 2 + 3 факториал + 1.
