Число в: ['factorial'] сделать: {
	>> total := 1.
	{ :index total умножить-на: (сам - (index)). } × сам. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Выход написать: a.
>> b := 2 + 3 factorial.
Выход написать: b.
>> c := 3 factorial + 2.
Выход написать: c.
>> d := 2 + (3 factorial).
Выход написать: d.
Выход написать: 2 + 3 factorial + 1.
