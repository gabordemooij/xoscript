>> a := Объект новый. 
a в: ['поприветствовать'] сделать: { Выход написать: ['добро пожаловать!'], стоп. }.
a в: ['поприветствовать2'] сделать: { Выход написать: ['добро пожаловать2!'], стоп. }.
a save-as: ['/tmp/a.bin'].

Выход написать: ['========== ПЕРЕЗАГРУЗКА СНИМКА:'], стоп.
>> b := Объект load-from: ['/tmp/a.bin'].
b поприветствовать2.