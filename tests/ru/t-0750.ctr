Выход написать: ['Тестовый объект'], стоп.
>> a := Объект новый. 

a в: ['item:'] сделать: { :ничего
	мой ничего := ничего. 
}.

a в: ['предмет'] сделать: {
	<- мой ничего.
}.

a item: Пустой.

Выход написать: a предмет, стоп.

>> старый-адрес-ничего := a предмет прототип адрес-памяти.
a save-as: ['/tmp/a.bin'].
Выход написать: ['========== ПЕРЕЗАГРУЗКА СНИМКА:'], стоп.

>> b := Объект load-from: ['/tmp/a.bin'].

(b предмет прототип адрес-памяти = старый-адрес-ничего) истина: {
	Выход написать: ['Связь объекта восстановлена.'], стоп.
}.

Выход написать: b предмет, стоп.
