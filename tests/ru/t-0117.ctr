>> t := Истина.
(t = Истина) истина: { Выход написать: ['T']. }.
(t = Ложь) истина: { Выход написать: ['F']. }.
Выход написать: ['|'].
>> t := Ложь.
(t = Истина) истина: { Выход написать: ['T']. }.
(t = Ложь) истина: { Выход написать: ['F']. }.
Выход написать: ['|'].
>> f := Истина.
(t = Истина и: f = Ложь) истина: { Выход написать: ['T']. }.
(t = Ложь и: f = Истина) истина: { Выход написать: ['F']. }.
Выход написать: ['|'].
>> n := Пустой.
(n пустой?) истина: { Выход написать: ['T']. }.
(n пустой?) ложь: { Выход написать: ['F']. }.
Выход написать: ['|'].
(f Boolean?) истина: { Выход написать: ['T']. }.
(f Boolean?) ложь: { Выход написать: ['F']. }.



