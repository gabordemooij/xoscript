#Linux

(Файл новый: ['/tmp/testje']) существует ложь: {
	Программа Системная-команда: ['mkdir /tmp/testje'].	
}.

(Файл новый: ['/tmp/testje/file1']) существует ложь: {
	Программа Системная-команда: ['touch /tmp/testje/file1'].	
}.

(Файл новый: ['/tmp/testje/folder1']) существует ложь: {
	Программа Системная-команда: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Файл список: ['/tmp/testje'].

>> q := Список новый.

l каждый: { :k :v v каждый: { :x :y q добавить-в-конец: y. }. }.

>> s := q к-тексту.

(s содержит: ['file1']) истина:   { Выход написать: ['OK'], стоп. }.
(s содержит: ['file2']) истина:   { Выход написать: ['XX'], стоп. }.
(s содержит: ['folder1']) истина: { Выход написать: ['OK'], стоп. }.
