

Список в: ['sum'] сделать: {
	>> total := 0.
	сам каждый: { :index :element
		total добавить: element.
	}. <- total.
}.

Список в: ['product'] сделать: {
	>> total := 1.
	сам каждый: { :index :element
		total умножить-на: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Программа режим-памяти: 0.

{

>> a := Список ← ['hello'] ; ['world'] ; Истина ; Пустой ; 666.
a := a + ( Список ← 1 ).
Выход написать: ( ['sum: '] + ( a sum ) ), стоп.
Выход написать: ( ['min: '] + ( a минимум ) ), стоп.
Выход написать: ( ['max: '] + ( a максимум ) ), стоп.
Выход написать: ( ['3rd: '] + ( a ? 2 ) ), стоп.
Выход написать: ( ['prd: '] + ( a product ) ), стоп.
a сортировать: { :a :b <- (b - a). }.
a каждый: { :i :e Выход написать: ( i - 0 ), стоп. }.

} запуск.

