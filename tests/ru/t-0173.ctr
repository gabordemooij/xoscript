

Список в: ['сумма'] сделать: {
	>> итог := 0.
	сам каждый: { :индекс :элемент
		итог добавить: элемент.
	}. <- итог.
}.

Список в: ['произведение'] сделать: {
	>> итог := 1.
	сам каждый: { :индекс :элемент
		итог умножить-на: элемент.
	}. <- итог.
}.

>> занятаПамять1 := 0.
>> занятаПамять2 := 0.
>> занятаПамять3 := 0.
>> занятаПамять4 := 0.

Программа режим-памяти: 0.

{

>> a := Список ← ['hello'] ; ['world'] ; Истина ; Пустой ; 666.
a := a + ( Список ← 1 ).
Выход написать: ( ['сумма: '] + ( a сумма ) ), стоп.
Выход написать: ( ['мин: '] + ( a минимум ) ), стоп.
Выход написать: ( ['макс: '] + ( a максимум ) ), стоп.
Выход написать: ( ['3-й: '] + ( a ? 2 ) ), стоп.
Выход написать: ( ['произв: '] + ( a произведение ) ), стоп.
a сортировать: { :a :b <- (b - a). }.
a каждый: { :i :e Выход написать: ( i - 0 ), стоп. }.

} запуск.

