# успешный сценарий
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> путь := ['/tmp/dat.csv'].
>> csv := Файл новый: путь.
csv написать: s.

# принимает CRLF LF CR, разная длина строк
csv разделитель: [';'] кавычки: ['"'] строки: { :line
	Программа уборка.
	Выход написать: line, стоп.
	Программа уборка.
}.

# строки разной длины
s добавить-в-конец: ['\njustone'].
csv написать: s.
{
	csv разделитель: [';'] кавычки: ['"'] строки: { :line
		Выход написать: line, стоп.
	}.
} впоймать: { :e 
	Выход написать: e, стоп.
}, запуск.

# недопустимый формат
s := ['"he"llo";world'].
csv написать: s.
{
	csv разделитель: [';'] кавычки: ['"'] строки: { :line
		Выход написать: line, стоп.
	}.
} впоймать: { :e 
	Выход написать: e, стоп.
}, запуск.
