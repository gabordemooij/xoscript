


>> занятаПамять1 := 0.
>> занятаПамять2 := 0.
>> занятаПамять3 := 0.
>> занятаПамять4 := 0.

Программа режим-памяти: 0.
>> палитра := Пустой.
>> цвета := Пустой.

{
палитра := Карта новый.
палитра 
	разместить: ['#F00'] в: ['красный'],
	разместить: ['#0F0'] в: ['зелёный'],
	разместить: ['#00F'] в: ['синий'].
Выход написать: ['количество RGB-кодов в палитре: '] + ( палитра счетчик ), стоп.
Выход написать: ['RGB-код зелёного: '] + ( палитра ? ['зелёный'] ), стоп.
цвета := [''].
( палитра каждый: { :имя :код
		цвета := цвета + ( имя + [':'] + код ).
} ).
Выход написать: ['Все цвета в палитре: '] + цвета, стоп.
} запуск.
Программа уборка.
занятаПамять1 := (Программа лимит ? 0).

