>> Greeter := Объект новый.
Greeter в: ['make'] сделать: {
	>> gr := Объект новый.
	gr в: ['setName:'] сделать: { :aname
		мой имя := aname.
	}.
	gr в: ['greet'] сделать: {
		Выход написать: мой имя.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a новый.
c setName: ['THREE'].
c greet.
>> d := a новый.
d setName: ['FOUR'].
d greet.
c greet.
