>> Приветствователь := Объект новый.
Приветствователь в: ['создать'] сделать: {
	>> пр := Объект новый.
	пр в: ['setName:'] сделать: { :имяАргумент
		мой имя := имяАргумент.
	}.
	пр в: ['поприветствовать'] сделать: {
		Выход написать: мой имя.
	}. <- пр.
}.
>> a := Приветствователь создать.
>> b := Приветствователь создать.
a setName: ['ОДИН'].
b setName: ['ДВА'].
a поприветствовать.
b поприветствовать.
>> c := a новый.
c setName: ['ТРИ'].
c поприветствовать.
>> d := a новый.
d setName: ['ЧЕТЫРЕ'].
d поприветствовать.
c поприветствовать.
