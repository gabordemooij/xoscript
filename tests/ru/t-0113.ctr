Выход написать: ['Продолжение цикла for, Нет - перед 6 и выше.'], стоп.
{ :i
	Выход написать: (i + 1), стоп.
	((i + 1) > 4) продолжить.
	Выход написать: ['-'].
} × 10.

>> x := 0.
>> xМеньше10 := { <- ( x < 10 ). }.
Выход стоп.
Выход написать: ['Продолжение while-true, Нет --> перед 5 и выше.'], стоп.
{
	Выход написать: ['iteration #'] + x, стоп.
	x добавить: 1.
	((x < 5) не) продолжить.
	Выход написать: ['-->'].
} пока: xМеньше10.
Выход стоп.
Выход написать: ['Продолжение while-false, Нет - только перед 3.'], стоп.
{
	Выход написать: ['iteration #'] + x, стоп.
	x вычесть: 1.
	(x = 3) продолжить.
	Выход написать: ['-'].
} пока: { <- ( x > 0). }.

Выход стоп.
Выход написать: ['Продолжение цикла times, Нет ||| перед 3.'], стоп.
{ :i
	Выход написать: ['iteration #'] + i, стоп.
	(i = 2) продолжить.
	Выход написать: ['|||'].
} × 5.

Выход стоп.

{ Истина продолжить. Выход написать: ['не пиши это!'], стоп. } запуск.

{ Истина продолжить. Выход написать: ['не пиши это!'], стоп. } впоймать: { Выход написать: ['Не перехватывай это!']. }, запуск.

Выход написать: ['Тест цикла each по массиву: 0, ... ,2'], стоп.
(Список ← 1 ; 2 ; 3) карта: { :i
	(i = 1) продолжить.
	Выход написать: ['iteration #'] + (i - 0), стоп.
}.

Выход написать: ['Тест цикла each по карте: только c'], стоп.
>> m := Карта новый.
m разместить: ['first'] в: ['a'], разместить: ['second'] в: ['b'], разместить: ['третий'] в: ['c'].
m каждый: { :k :v
	(k ≠ ['c']) продолжить.
	Выход написать: ['iteration'] + k + v, стоп.
}.

