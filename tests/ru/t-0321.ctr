# тест квалификаторов

Программа уборка.

>> Фрукт := Объект новый.
Фрукт в: ['новый'] сделать: {
	>> f := сам новый.
	f apples: 0. <- f.
}.
Фрукт в: ['apples:'] сделать: { :a мой яблоки := a. }.
Фрукт в: ['яблоки'] сделать: { <- мой яблоки. }.
Фрукт в: ['+'] сделать: { :f
	>> n := Фрукт новый.
	n apples: (f яблоки + мой яблоки). <- n.
}.
Число в: ['яблоки'] сделать: { <- ((Фрукт новый) apples: сам).
}.

Фрукт в: ['к-тексту'] сделать: { <- мой яблоки + [' яблок '].
}.

>> q := 3 яблоки + 4 яблоки.
Выход написать: q, стоп.




q := 3 яблоки + 4 яблоки.
Выход написать: q, стоп.



q := 3 яблоки + 4 яблоки.
Выход написать: q, стоп.


