# test qualifiers

Программа уборка.

>> Fruit := Объект новый.
Fruit в: ['новый'] сделать: {
	>> f := сам новый.
	f apples: 0. <- f.
}.
Fruit в: ['apples:'] сделать: { :a мой apples := a. }.
Fruit в: ['apples'] сделать: { <- мой apples. }.
Fruit в: ['+'] сделать: { :f
	>> n := Fruit новый.
	n apples: (f apples + мой apples). <- n.
}.
Число в: ['apples'] сделать: { <- ((Fruit новый) apples: сам).
}.

Fruit в: ['к-тексту'] сделать: { <- мой apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Выход написать: q, стоп.




q := 3 apples + 4 apples.
Выход написать: q, стоп.



q := 3 apples + 4 apples.
Выход написать: q, стоп.


