

Список в: ['column:'] сделать: { :столбец
	>> результат := Список новый.
	сам каждый: { :индекс :ряд
		ряд каждый: { :индекс :ячейка
			(индекс = столбец) истина: { результат добавить-в-конец: ячейка. }.
		}.
	}. <- результат.
}.


>> a := Список ←
	(Список ← 1 ; 2 ; 3) ;
	(Список ← 4 ; 5 ; 6) ;
	(Список ← 7 ; 8 ; 9).

>> b := a column: 1.
Выход написать: b, стоп.

b := a column: 20.
Выход написать: b, стоп.

b := a column: -100.
Выход написать: b, стоп.
