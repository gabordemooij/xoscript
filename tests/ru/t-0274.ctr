

Список в: ['column:'] сделать: { :column
	>> result := Список новый.
	сам каждый: { :index :row
		row каждый: { :index :cell
			(index = column) истина: { result добавить-в-конец: cell. }.
		}.
	}. <- result.
}.


>> a := Список ←
	(Список ← 1 ; 2 ; 3) ;
	(Список ← 4 ; 5 ; 6) ;
	(Список ← 7 ; 8 ; 9).

>> b := a column: 1.
Выход написать: b, стоп.

b := a column: 20.
Выход написать: b, стоп.

b := a column: -100.
Выход написать: b, стоп.
