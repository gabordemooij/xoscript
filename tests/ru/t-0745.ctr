Выход написать: ['Тестовый объект'], стоп.
>> a := Объект новый. 

a в: ['item:'] сделать: { :словарик
	мой словарик := словарик. 
}.

a в: ['предмет'] сделать: {
	<- мой словарик.
}.

a item: (
Карта новый
	hello: ['world']).

>> старый-адрес-словарика := a предмет прототип адрес-памяти.
a save-as: ['/tmp/a.bin'].
Выход написать: ['========== ПЕРЕЗАГРУЗКА СНИМКА:'], стоп.

