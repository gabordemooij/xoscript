Выход написать: ['Test object'], стоп.
>> a := Объект новый. 

a в: ['item:'] сделать: { :hexhelper
	мой hexhelper := hexhelper. 
}.

a в: ['item'] сделать: { <- мой hexhelper.
}.

a item: Hx новый.

>> old-hexhelper-address := a item прототип адрес-памяти.
a save-as: ['/tmp/a.bin'].
Выход написать: ['========== RELOADING SNAP:'], стоп.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип адрес-памяти = old-hexhelper-address) истина: {
	Выход написать: ['Object link re-attached.'], стоп.
}.
