Выход написать: ['Тестовый объект'], стоп.
>> a := Объект новый. 

a в: ['item:'] сделать: { :шестнадцатеричныйПомощник
	мой шестнадцатеричныйПомощник := шестнадцатеричныйПомощник. 
}.

a в: ['предмет'] сделать: {
	<- мой шестнадцатеричныйПомощник.
}.

a item: Hx новый.

>> старый-адрес-шестнадцатеричногоПомощника := a предмет прототип адрес-памяти.
a save-as: ['/tmp/a.bin'].
Выход написать: ['========== ПЕРЕЗАГРУЗКА СНИМКА:'], стоп.

>> b := Объект load-from: ['/tmp/a.bin'].

(b предмет прототип адрес-памяти = старый-адрес-шестнадцатеричногоПомощника) истина: {
	Выход написать: ['Связь объекта восстановлена.'], стоп.
