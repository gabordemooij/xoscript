#Linux
>> Глоток := Объект новый.

Глоток в: ['новый'] сделать: {
	мой str := [''].
}.

Глоток в: ['nieuw'] сделать: {
	мой str := [''].
}.

Глоток в: ['ответить:'] сделать: { :blah
		мой str добавить-в-конец: blah.
}.

Глоток в: ['ответить:и:'] сделать: { :blah :блаха
		мой str добавить-в-конец: (blah от: 0 длина: (blah длина - 1)).
		мой str добавить-в-конец: [' '].
		мой str добавить-в-конец: блаха.
}.

Глоток в: ['заполучить'] сделать: {
	>> буфер := мой str.
	мой str := ['']. <- буфер.
}.


Выход написать: (Программа Системная-команда: (Глоток новый echo: ['Привет, я умею писать в консоль через fluent API!'], заполучить)).


{ Файл новый: ['/tmp/from.txt'], удалить. } впоймать: { ['Пусто']. }, запуск.
{ Файл новый: ['/tmp/to.txt'], удалить. } впоймать: { ['Пусто']. }, запуск.


Файл новый: ['/tmp/to.txt'], существует ложь: {
	Выход написать: ['Confirmed. Target file does not exist.\
'].
}.
Файл новый: ['/tmp/from.txt'], существует ложь: {
	Выход написать: ['Confirmed. Source file does not exist.\
'].
}.



Программа Системная-команда: (Глоток новый touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], заполучить).



Программа Системная-команда: (Глоток новый cp: ['/tmp/from.txt /tmp/to.txt'], заполучить).

Файл новый: ['/tmp/to.txt'], существует истина: {
	Выход написать: ['Confirmed. Target file has been created by shell.\
'].
}.


Выход написать: ['Содержимое файла:'] + (Файл новый: ['/tmp/to.txt'], прочитать), стоп.
