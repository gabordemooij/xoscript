Server init.

>> message := ['this is a string to be encrypted!'].
>> key := ['secret123!'].
>> vault := Хранилище новый: ['myvault'].

>> encrypted := vault шифровать: message ключ: key.
>> decrypted := vault расшифровать: encrypted ключ: key.

