
Программа режим-памяти: 4.

>> Животное := Объект новый.
Животное в: ['создать'] сделать: {
	>> животное := Объект новый.
	животное в: ['издатьЗвук'] сделать: {
		Выход написать: мой звук.
	}. <- животное.
}.
>> Кот := Объект новый.
Кот в: ['создать'] сделать: {
	>> кот := Животное создать.
	кот в: ['init'] сделать: {
		мой звук := ['meow!'].
	}.
	кот init. <- кот.
}.
>> том := Кот создать.
том издатьЗвук.
