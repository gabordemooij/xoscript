# Тест очистки utf8
Server init.

>> случаиUtf8 := Карта новый
	# Только ASCII
	разместить: ( Список новый ; 65 ; 65 ; 65 ; 65 ; 0 ) в: ['AAAA'],
	# допустимая 2-байтовая последовательность
	разместить: ( Список новый ; 194 ; 162 ; 0 ) в: ['¢'],
	# Допустимый 3-байтовый UTF-8
    разместить: ( Список новый ; 226 ; 130 ; 172 ; 0 ) в: ['€'],
	# Допустимый 4-байтовый UTF-8
    разместить: ( Список новый ; 240 ; 144 ; 141 ; 136 ; 0 ) в: ['𐍈'],
	# Недопустимый байт продолжения в последовательности E2 28 AC -> начало 3b посл. + 28 неверн. продолж. + AC байт продолж., но относится к той же ошибке
    разместить: ( Список новый ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) в: ['A?A'],
	# Слишком длинная кодировка ASCII 'A' (должна стать ?),
    разместить: ( Список новый ; 65 ; 193 ; 129 ; 0 ) в: ['A?'],
	# Недопустимый первый байт (0xFF)
    разместить: ( Список новый ; 255 ; 0 ) в: ['?'],
	# Незавершённая многобайтовая последовательность в конце
    разместить: ( Список новый ; 66 ; 226 ; 0 ) в: ['B?'],
    # Пустая строка
    #put: ( List new ) at: [''],
	# Несколько смешанных последовательностей
    разместить: ( Список новый ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) в: ['A€?𐍈B'].
	 
случаиUtf8 каждый: { :key :value
	>> blob := Blob новый: value счетчик, байта: value.
	>> str := blob к-тексту.
	(str = key) истина: {
		Выход написать: ['OK'], стоп.
	}, иначе: {
		Выход написать: ['Санитайзер UTF8 не справился с: '] + key + [' получено: '] + str, стоп.
	}.
	blob свободно.
}.
