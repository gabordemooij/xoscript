>> Животное := Объект новый.
>> Фабрика := Объект новый.

Животное в: ['новый'] сделать: {
	>> животное := сам новый.
	животное sound: ['?']. <- животное.
}.

Животное в: ['sound:'] сделать: { :s
	мой звук := s.
}.

Животное в: ['звук'] сделать: { <- мой звук.
}.

>> Собака := Объект новый.
>> Кот := Объект новый.

Собака в: ['новый'] сделать: { <- Животное новый sound: ['woof!'].
}.

Кот в: ['новый'] сделать: { <- Животное новый sound: ['meow!'].
}.

Выход написать: Собака новый звук, стоп.
Выход написать: Кот новый звук, стоп.

Фабрика в: ['смешать:и:'] сделать: { :зверь1 :зверь2 <- Животное новый sound: (
		( зверь1 звук от: 0 длина: 2 ) +
		( зверь2 звук от: 2 длина: 5 )
	).
}.

Выход написать: (Фабрика смешать: Собака новый и: Кот новый) звук, стоп.
