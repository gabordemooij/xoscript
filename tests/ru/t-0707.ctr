# Strings (varchar/text)
>> str1 := Список новый заполнить: 100000 буквой: ['x'], присоединить: [''].
{
	>> str2 := Хранилище токен: 40.
	>> параметры :=
	db запрос: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	получить: { :row
		(row str1 = str1 и: row str2 = str2) ложь: {
			этот-блок-кода ошибка: (
				['Expected: <expected> but got: <observation>']
				<expected>: datetime,
				<observation>: row mytime
			).
		}.
	}.
	counter добавить: 1.
} * 100.


# Numbers
{
	>> n1 := Число между: 1 и: 99999.
	>> n2 := n1 / 1000.
	>> big := (
		( Int64 от-тексту: ['9223372036854775807'] ) -
		( Int64 от-тексту: ['99999'] ) +
		( Int64 от-тексту: n1 к-тексту )
	).
	>> параметры :=
	db запрос: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	получить: { :row
		(row n1 = n1) ложь: {
			этот-блок-кода ошибка: (
				['Expected: <expected> but got: <observation>']
				<expected>: n1,
				<observation>: row n1
			).
		}.
		(row n2 = n2) ложь: {
			этот-блок-кода ошибка: (
				['Expected: <expected> but got: <observation>']
				<expected>: n1,
				<observation>: row n2
			).
		}.
		(row n3 = n2 округлить) ложь: {
			этот-блок-кода ошибка: (
				['Expected: <expected> but got: <observation>']
				<expected>: n1,
				<observation>: row n3
			).
		}.
		(row big = big) ложь: {
			этот-блок-кода ошибка: (
				['Expected: <expected> but got: <observation>']
				<expected>: big,
				<observation>: row big
			).
		}.
		
	}.
	counter добавить: 1.
} * 100.


Выход написать: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: counter
), стоп.