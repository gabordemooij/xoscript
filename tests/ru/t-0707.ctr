# тест приведения типов / преобразований / привязок
Программа режим-памяти: 4.
Server init.

>> счётчик := 0.
>> бд := MariaDB новый хост: ['localhost'],
	пользователь: ['xo'], пароль: ['pass123'], имя-базы: ['xobase'], подключить.

>> ДвузначныйФормат := Формат новый: ['%02d'].

# Дата и время
{
	>> год     := Число между: 1995 и: 2050, к-тексту.
	>> месяц    := ДвузначныйФормат применить-int: (Число между: 1 и: 12), к-тексту.
	>> день      := ДвузначныйФормат применить-int: (Число между: 1 и: 28), к-тексту.
	>> час     := ДвузначныйФормат применить-int: (Число между: 1 и: 23), к-тексту.
	>> минут   := ДвузначныйФормат применить-int: (Число между: 1 и: 59), к-тексту.
	>> секунд   := ДвузначныйФормат применить-int: (Число между: 1 и: 59), к-тексту.
	>> датавремя := ['YYYY-MM-DD HH:II:SS'].	
	датавремя
		YYYY: год,
		MM: месяц,
		DD: день,
		HH: час,
		II: минут,
		SS: секунд.
	>> параметры :=
	бд запрос: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: датавремя),
	получить: { :ряд
		(ряд mydatetime = датавремя) ложь: {
			этот-блок-кода ошибка: (
				['Ожидалось: <expected>, но получено: <observation>']
				<expected>: датавремя,
				<observation>: ряд mydatetime
			).
		}.
	
	}.
	счётчик добавить: 1.
} * 100.

# Дата
{
	>> год     := Число между: 1995 и: 2050, к-тексту.
	>> месяц    := ДвузначныйФормат применить-int: (Число между: 1 и: 12), к-тексту.
	>> день      := ДвузначныйФормат применить-int: (Число между: 1 и: 28), к-тексту.
	>> дата     := ['YYYY-MM-DD'].
	дата
		YYYY: год,
		MM: месяц,
		DD: день.
	>> параметры :=
	бд запрос: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: дата),
	получить: { :ряд
		(ряд mydate = дата) ложь: {
			этот-блок-кода ошибка: (
				['Ожидалось: <expected>, но получено: <observation>']
				<expected>: дата,
				<observation>: ряд mydate
			).
		}.
	}.
	счётчик добавить: 1.
} * 100.


# Время
{
	>> час     := ДвузначныйФормат применить-int: (Число между: 1 и: 23), к-тексту.
	>> минут   := ДвузначныйФормат применить-int: (Число между: 1 и: 59), к-тексту.
	>> секунд   := ДвузначныйФормат применить-int: (Число между: 1 и: 59), к-тексту.
	>> время := ['HH:II:SS'].
	время
		HH: час,
		II: минут,
		SS: секунд.
	>> параметры :=
	бд запрос: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: время),
	получить: { :ряд
		(ряд mytime = время) ложь: {
			этот-блок-кода ошибка: (
				['Ожидалось: <expected>, но получено: <observation>']
				<expected>: датавремя,
				<observation>: ряд mytime
			).
		}.
	}.
	счётчик добавить: 1.
} * 100.


# Строки (varchar/text)
>> str1 := Список новый заполнить: 100000 буквой: ['x'], присоединить: [''].
{
	>> str2 := Хранилище токен: 40.
	>> параметры :=
	бд запрос: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	получить: { :ряд
		(ряд str1 = str1 и: ряд str2 = str2) ложь: {
			этот-блок-кода ошибка: (
				['Ожидалось: <expected>, но получено: <observation>']
				<expected>: датавремя,
				<observation>: ряд mytime
			).
		}.
	}.
	счётчик добавить: 1.
} * 100.


# Числа
{
	>> n1  := Число между: 1 и: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 от-тексту: ['9223372036854775807'] ) -
		( Int64 от-тексту: ['99999'] ) +
		( Int64 от-тексту: n1 к-тексту )
	).
	>> параметры :=
	бд запрос: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	получить: { :ряд
		(ряд n1 = n1) ложь: {
			этот-блок-кода ошибка: (
				['Ожидалось: <expected>, но получено: <observation>']
				<expected>: n1,
				<observation>: ряд n1
			).
		}.
		(ряд n2 = n2) ложь: {
			этот-блок-кода ошибка: (
				['Ожидалось: <expected>, но получено: <observation>']
				<expected>: n1,
				<observation>: ряд n2
			).
		}.
		(ряд n3 = n2 округлить) ложь: {
			этот-блок-кода ошибка: (
				['Ожидалось: <expected>, но получено: <observation>']
				<expected>: n1,
				<observation>: ряд n3
			).
		}.
		(ряд big = big) ложь: {
			этот-блок-кода ошибка: (
				['Ожидалось: <expected>, но получено: <observation>']
				<expected>: big,
				<observation>: ряд big
			).
		}.
		
	}.
	счётчик добавить: 1.
} * 100.


Выход написать: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: счётчик
), стоп.