# test type casts / conversions / bindings
Программа режим-памяти: 4.
Server init.

>> counter := 0.
>> db := MariaDB новый хост: ['localhost'],
	пользователь: ['xo'], пароль: ['pass123'], имя-базы: ['xobase'], подключить.

>> TwoDigitFormat := Формат новый: ['%02d'].

# Datetime
{
	>> год := Число между: 1995 и: 2050, к-тексту.
	>> месяц := TwoDigitFormat применить-int: (Число между: 1 и: 12), к-тексту.
	>> день := TwoDigitFormat применить-int: (Число между: 1 и: 28), к-тексту.
	>> час := TwoDigitFormat применить-int: (Число между: 1 и: 23), к-тексту.
	>> минут := TwoDigitFormat применить-int: (Число между: 1 и: 59), к-тексту.
	>> секунд := TwoDigitFormat применить-int: (Число между: 1 и: 59), к-тексту.
	>> datetime := ['YYYY-MM-DD HH:II:SS'].	
	datetime
		YYYY: год,
		MM: месяц,
		DD: день,
		HH: час,
		II: минут,
		SS: секунд.
	>> параметры :=
	db запрос: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: datetime),
	получить: { :row
		(row mydatetime = datetime) ложь: {
			этот-блок-кода ошибка: (
				['Expected: <expected> but got: <observation>']
				<expected>: datetime,
				<observation>: row mydatetime
			).
		}.
	
	}.
	counter добавить: 1.
} * 100.

