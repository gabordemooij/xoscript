Выход написать: ['Test object'], стоп.
>> a := Объект новый. 

a в: ['item:'] сделать: { :num
	мой num := num. 
}.

a в: ['item'] сделать: { <- мой num.
}.

a item: 123.

Выход написать: a item, стоп.

>> old-num-address := a item прототип адрес-памяти.
a save-as: ['/tmp/a.bin'].
Выход написать: ['========== RELOADING SNAP:'], стоп.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип адрес-памяти = old-num-address) истина: {
	Выход написать: ['Object link re-attached.'], стоп.
}.

Выход написать: b item, стоп.
