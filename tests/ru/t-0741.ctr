Выход написать: ['Test object'], стоп.
>> a := Объект новый. 

a в: ['item:'] сделать: { :octhelper
	мой octhelper := octhelper. 
}.

a в: ['item'] сделать: { <- мой octhelper.
}.

a item: Oct новый.

>> old-octhelper-address := a item прототип адрес-памяти.
a save-as: ['/tmp/a.bin'].
Выход написать: ['========== RELOADING SNAP:'], стоп.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип адрес-памяти = old-octhelper-address) истина: {
	Выход написать: ['Object link re-attached.'], стоп.
}.
