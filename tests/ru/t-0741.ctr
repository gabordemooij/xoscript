Выход написать: ['Тестовый объект'], стоп.
>> a := Объект новый. 

a в: ['item:'] сделать: { :восьмеричныйПомощник
	мой восьмеричныйПомощник := восьмеричныйПомощник. 
}.

a в: ['предмет'] сделать: {
	<- мой восьмеричныйПомощник.
}.

a item: Oct новый.

>> старый-адрес-восьмеричногоПомощника := a предмет прототип адрес-памяти.
a save-as: ['/tmp/a.bin'].
Выход написать: ['========== ПЕРЕЗАГРУЗКА СНИМКА:'], стоп.

>> b := Объект load-from: ['/tmp/a.bin'].

(b предмет прототип адрес-памяти = старый-адрес-восьмеричногоПомощника) истина: {
	Выход написать: ['Связь объекта восстановлена.'], стоп.
}.
