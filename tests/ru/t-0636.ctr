# тест разбора url

Server init.
>> url := URL от: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Выход написать: ['схема = '] + url схема, стоп.
Выход написать: ['хост = '] + url хост, стоп.
Выход написать: ['порт = '] + url порт, стоп.
Выход написать: ['путь = '] + url путь, стоп.
Выход написать: ['запрос = '] + url параметры, стоп.
Выход написать: ['фрагмент = '] + url фрагмент, стоп.
