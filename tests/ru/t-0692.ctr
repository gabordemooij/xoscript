Server init.

Выход написать: (
	Шаблон новый: ['^\\w+$'],
	совпадение: ['test@example.com'] 
), стоп. # 0 match, fails on @ and .

Выход написать: (
	Шаблон новый: ['^[^@]+@[^\.]+\.\\w+$'],
	совпадение: ['test@example.com'] 
), стоп. # 1 match

Выход написать: (
	Шаблон новый: ['[^@]+@[^\.]+\.\\w+'],
	совпадение: ['test@example.com'] 
), стоп. # 1 match

Выход написать: (
	Шаблон новый: ['([^@]+)@([^\.]+)\.\\w+'],
	совпадение: ['test@example.com'] 
), стоп. # 1 match, groups dont matter

Выход написать: (
	Шаблон новый: ['[a-z]'],
	совпадение: ['test@example.com'] 
), стоп. # 14 matches

Выход написать: (
	Шаблон новый: ['.*'],
	совпадение: ['test@example.com'] 
), стоп. # 1 match (all)

Выход написать: (
	Шаблон новый: ['(.*)'],
	совпадение: ['test@example.com'] 
), стоп. # 1 match (all)

Выход написать: (
	Шаблон новый: ['\\s*[^@]+@[^\.]+\.\\w+'],
	совпадение: ['test@example.com'] 
), стоп. # 1 match, prefix space optional, gets ignored