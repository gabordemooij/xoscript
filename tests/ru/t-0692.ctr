Server init.

Выход написать: (
	Шаблон новый: ['^\\w+$'],
	совпадение: ['test@example.com'] 
), стоп. # 0 совпадений, не проходит на @ и .

Выход написать: (
	Шаблон новый: ['^[^@]+@[^\.]+\.\\w+$'],
	совпадение: ['test@example.com'] 
), стоп. # 1 совпадение

Выход написать: (
	Шаблон новый: ['[^@]+@[^\.]+\.\\w+'],
	совпадение: ['test@example.com'] 
), стоп. # 1 совпадение

Выход написать: (
	Шаблон новый: ['([^@]+)@([^\.]+)\.\\w+'],
	совпадение: ['test@example.com'] 
), стоп. # 1 совпадение, группы не важны

Выход написать: (
	Шаблон новый: ['[a-z]'],
	совпадение: ['test@example.com'] 
), стоп. # 14 совпадений

Выход написать: (
	Шаблон новый: ['.*'],
	совпадение: ['test@example.com'] 
), стоп. # 1 совпадение (все)

Выход написать: (
	Шаблон новый: ['(.*)'],
	совпадение: ['test@example.com'] 
), стоп. # 1 совпадение (все)

Выход написать: (
	Шаблон новый: ['\\s*[^@]+@[^\.]+\.\\w+'],
	совпадение: ['test@example.com'] 
), стоп. # 1 совпадение, пробел-префикс необязателен, игнорируется