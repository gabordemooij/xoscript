Выход написать: ['Тестовый объект'], стоп.
>> кмд := Командование новый.
Выход написать: кмд ls /tmp, стоп.
>> старый-адрес-кмд := кмд прототип адрес-памяти.
кмд save-as: ['/tmp/a.bin'].
Выход написать: ['========== ПЕРЕЗАГРУЗКА СНИМКА:'], стоп.
>> b := Объект load-from: ['/tmp/a.bin'].
(b прототип адрес-памяти = старый-адрес-кмд) истина: {
	Выход написать: ['Связь объекта восстановлена.'], стоп.
}.
Выход написать: b ls, стоп.


