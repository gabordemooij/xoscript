>> карта1 := Карта новый.
>> ключ1 := Список новый.
>> ключ2 := Список новый.

карта1
	разместить: ['hello'] в: ключ1,
	разместить: ['world'] в: ключ2.


Выход
	написать: ['Map #1 contains: '] + (карта1 в: ключ1),
	написать: [' и '] + (карта1 в: ключ2), стоп.

>> КлючевойМассив := Список новый.
КлючевойМассив в: ['вТекст'] сделать: { <- (сам счетчик) вТекст.
}.

>> map2 := Карта новый.
ключ1 := КлючевойМассив новый.
ключ2 := КлючевойМассив новый.

ключ1 добавить-в-конец: 1.

map2
	разместить: ['hello'] в: ключ1,
	разместить: ['world'] в: ключ2.

Выход
	написать: ['Map #2 contains: '] + (map2 в: ключ1),
	написать: [' и '] + (map2 в: ключ2), стоп.
