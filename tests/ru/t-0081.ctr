>> map1 := Карта новый.
>> key1 := Список новый.
>> key2 := Список новый.

map1
	разместить: ['hello'] в: key1,
	разместить: ['world'] в: key2.


Выход
	написать: ['Map #1 contains: '] + (map1 в: key1),
	написать: [' and '] + (map1 в: key2), стоп.

>> KeyeableArray := Список новый.
KeyeableArray в: ['toString'] сделать: { <- (сам счетчик) toString.
}.

>> map2 := Карта новый.
key1 := KeyeableArray новый.
key2 := KeyeableArray новый.

key1 добавить-в-конец: 1.

map2
	разместить: ['hello'] в: key1,
	разместить: ['world'] в: key2.

Выход
	написать: ['Map #2 contains: '] + (map2 в: key1),
	написать: [' and '] + (map2 в: key2), стоп.
