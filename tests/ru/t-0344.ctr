# catch-all test (practical)
>> HTML := Текст новый.
HTML в: ['encode:'] сделать: { :tekst
	сам добавить-в-конец: (tekst
	заменить: ['&'] на: ['&amp;'], 
	заменить: ['<'] на: ['&lt;'],
	заменить: ['>'] на: ['&gt;'],
	заменить: ['"'] на: ['&quot;']).
}.
>> blog := HTML новый.
blog добавить-в-конец: ['<h1>'],
     encode: ['Koffie & Thee'],
     добавить-в-конец: ['</h1>'].
Выход написать: blog, стоп.


>> Roman := Число новый.
Roman в: ['stringy'] сделать: {
	>> a := [''].
	{ a добавить-в-конец: ['I']. } × сам. <- a.
}.

>> x := Roman новый.
x добавить: 3.
Выход написать: x stringy, стоп.

>> Quantum := Логический новый.
Quantum в: ['true?'] сделать: { <- ['maybe True']. }.
Выход написать: (Quantum новый true?), стоп.

>> Nihil := Пустой новый.
Nihil в: ['к-тексту'] сделать: { <- ['Nihil']. }.
Выход написать: (Nihil новый), стоп.
