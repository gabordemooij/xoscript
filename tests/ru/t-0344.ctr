# тест перехвата всех сообщений (практический)
>> HTML := Текст новый.
HTML в: ['encode:'] сделать: { :текстик
	сам добавить-в-конец: (текстик
	заменить: ['&'] на: ['&amp;'], 
	заменить: ['<'] на: ['&lt;'],
	заменить: ['>'] на: ['&gt;'],
	заменить: ['"'] на: ['&quot;']).
}.
>> блог := HTML новый.
блог добавить-в-конец: ['<h1>'],
     encode: ['Koffie & Thee'],
     добавить-в-конец: ['</h1>'].
Выход написать: блог, стоп.


>> Римское := Число новый.
Римское в: ['текстовый'] сделать: {
	>> a := [''].
	{ a добавить-в-конец: ['I']. } × сам. <- a.
}.

>> x := Римское новый.
x добавить: 3.
Выход написать: x текстовый, стоп.

>> Квант := Логический новый.
Квант в: ['true?'] сделать: { <- ['возможно Истина']. }.
Выход написать: (Квант новый true?), стоп.

>> Ничто := Пустой новый.
Ничто в: ['к-тексту'] сделать: { <- ['Ничто']. }.
Выход написать: (Ничто новый), стоп.
