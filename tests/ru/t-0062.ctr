Логический в: ['xor:'] сделать: { :a :b <- ((a и: b не) или: (a не и: b)).
}.

>> o := Объект новый.
o в: ['hello'] сделать: { ['Empty']. }.
{ o в: 2 сделать: 3.} впоймать: { :e Выход написать: e, стоп. }, запуск.
{ o в: ['тест'] сделать: 3.} впоймать: { :e Выход написать: e, стоп. }, запуск.
{ o в: ['hello'] сделать: { ['Empty']. }.} впоймать: { :e Выход написать: e, стоп. }, запуск. 
{ >> z := 4 ÷ 0. } впоймать: { :e Выход написать: e, стоп. }, запуск. 
{ (Истина и: Пустой) истина: { Выход написать: ['X'].}. } впоймать: { :e Выход написать: e, стоп. }, запуск. 
{ ([''] xor: 0) истина: { Выход написать: ['X'].}. } впоймать: { :e Выход написать: e, стоп. }, запуск. 
{ (1 < ['2']) истина: { Выход написать: ['OK']. }. } впоймать: { :e Выход написать: e, стоп. }, запуск. 
{ (1 < ['2.0']) истина: { Выход написать: ['OK']. }. } впоймать: { :e Выход написать: e, стоп. }, запуск. 
{ (1 < ['x2.0']) истина: { Выход написать: ['NO!']. }. } впоймать: { :e Выход написать: e, стоп. }, запуск. 
{ Выход написать: (['hello OK there'] от: ['6'] длина: ['2']). } запуск. 
