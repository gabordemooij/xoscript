# тест число -> текст -> число
{

	>> x := Число между: 0 и: 1000000.
	>> d := Число между: 1 и: 7.
	>> e := 10 в-степени: d.

	x разделить-на: e.
	>> y := x к-тексту к-числу.

	(x = y) ложь: {
		Выход написать: x, стоп.
		Выход написать: y, стоп.
		Программа конец.
	}.

} * 1000.
Выход написать: ['OK'], стоп.