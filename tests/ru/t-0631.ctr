#тест ffi


Server init.

Программа режим-памяти: 4.

# для этого теста нужно задать путь к libc (puts)
>> имяБиблиотеки := Программа конфигурация: ['FFITESTLIB'].



Server связать: (
 Список новый ;
 имяБиблиотеки ;
 ['puts'] ;
 ( Список новый ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s свободно.

# тест со структурой

>> a := Blob новый: 8.
a байта: (
	Список <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> структ := Blob структура: (Список <<: ['int'], ; ['int']).

Server связать: (
	Список <<: ['@structtest'], ;
	['@structtest'] ;
	(Список <<: структ) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Выход написать: ['Тест суммы:'] + (ffitest ffisum: a), стоп.

структ структура-свободно.
структ свободно.
a свободно.
