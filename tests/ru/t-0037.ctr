>> a := 3.
>> b := a скопировать.
a вычесть: 1.
Выход написать: [' a = '] + a.
Выход написать: [' b = '] + b.
a := 3.
b := a + 4.
Выход написать: [' a = '] + a.
Выход написать: [' b = '] + b.
>> x := 3.
>> y := x скопировать.
x добавить: 10.
y вычесть: 1.
Выход написать: [' x = '] + x.
Выход написать: [' y = '] + y.
>> q := Объект новый.
q в: ['setProperty:'] сделать: { :x
	мой св := x.
}.
q в: ['получитьСвойство'] сделать: { <- мой св.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Выход написать: [' p = '] + (p получитьСвойство).
