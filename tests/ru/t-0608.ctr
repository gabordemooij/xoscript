
>> Размерность := Объект новый.
Размерность в: ['is:'] сделать: { :к-числу
	к-числу в: ['+'] сделать: { :к-числу
		>> единица := к-числу квалифицировать.
		>> коэффициент := 1.
		
		единица
		случай: ['inch'] сделать: { коэффициент := 0.0833. }.

		<- сам + (к-числу * коэффициент).
	}.
	<- к-числу.
}.

# Это число размера можно использовать так:

>> доска := Размерность is: 6 футов.
>> кромка := Размерность is: 50 inch.

# Это будет показано как: 10.165
Выход написать: доска + кромка, стоп.
