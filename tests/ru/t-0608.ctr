
>> Size := Объект новый.
Size в: ['is:'] сделать: { :к-числу
	к-числу в: ['+'] сделать: { :к-числу
		>> unit := к-числу квалифицировать.
		>> factor := 1.
		
		unit
		случай: ['inch'] сделать: { factor := 0.0833. }. <- сам + (к-числу * factor).
	}. <- к-числу.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Выход написать: plank + edge, стоп.
