>> Slurp := Объект новый.

Slurp в: ['новый'] сделать: {
	мой str := [''].
}.

Slurp в: ['ответить:'] сделать: { :blah
		(мой str = ['']) истина: {
			мой str добавить-в-конец: blah.
		}, иначе: {
			мой str добавить-в-конец: [' '].
			мой str добавить-в-конец: blah.
		}.
}.

Slurp в: ['ответить:и:'] сделать: { :blah :blahah
		(blah длина > 1) истина: {
			мой str добавить-в-конец: (blah от: 0 длина: (blah длина - 1)).
		}, иначе: {
			мой str добавить-в-конец: blah.
		}.
		мой str добавить-в-конец: [' '].
		мой str добавить-в-конец: blahah.
}.

Slurp в: ['obtain'] сделать: {
	>> buffer := мой str.
	мой str := ['']. <- buffer.
}.


>> x := Slurp новый.
x + 3.
Выход написать: (x obtain), стоп.
x echo: ['Hello world'].
Выход написать: (x obtain), стоп.
x tellme: 123 and: 987.
Выход написать: (x obtain), стоп.
