# используем FFI с плагином Server

# подключаемся к libc (зависит от платформы)
>> имяБиблиотеки := Программа конфигурация: ['FFITESTLIB'].

# связываем функции stdio из C для расширенных операций с файлами
Server связать: ( Список новый ;
 имяБиблиотеки ; ['fopen'] ;
 ( Список новый ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
связать: ( Список новый ;
 Пустой ; # означает ту же библиотеку
 ['fread'] ;
 ( Список новый ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Пустой ; # означает тот же объект (т. е. Поток)
 ['fread']
),
связать: (
 Список новый ;
 Пустой ; # означает ту же библиотеку
 ['fwrite'] ;
 ( Список новый ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Пустой ; # означает ту же библиотеку
 ['fwrite']
),
связать: (
 Список новый ;
 Пустой ; # означает ту же библиотеку
 ['rewind'] ;
 ( Список новый ; ['pointer'] ) ;
 ['int'] ;
 Пустой ; # означает ту же библиотеку
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> путь := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# открываем файл с помощью fopen(path, mode)
>> дф := Stream path: путь mode: mode.

# записываем байты из буфера строчка в файл
>> записано-байтов := Stream сообщение: ['fwrite'] аргументы: (Список новый ; str ; 1 ; 6 ; дф ).
Выход написать: записано-байтов, стоп.

# перематываем указатель файла
Stream rewind: дф.

# выделяем буфер
>> буф := Blob новый: 20.

# читаем из файла
>> прочитано-байтов := Stream сообщение: ['fread'] аргументы: (Список новый ; буф ; 1 ; 6 ; дф ).
Выход написать: прочитано-байтов, стоп.
Выход написать: буф, стоп.

# освобождаем память
str  свободно.
путь свободно.
mode свободно.
буф  свободно.


