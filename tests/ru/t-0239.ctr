Список в: ['сумма'] сделать: {
	>> итог := 0.
	сам каждый: { :индекс :элемент
		итог добавить: элемент.
	}. <- итог.
}.

>> a := Истина.



a в: ['к-тексту'] сделать: {
	>> ответ := Пустой.
	( сам = Истина ) истина: {
		ответ := ['Ага'].
	}, иначе: {
		ответ := ['Неа'].
	}. <- ответ.
}.

a в: ['к-числу'] сделать: {
	>> ответ := Пустой.
	( сам = Истина ) истина: {
		ответ := 10.
	}, иначе: {
		ответ := 20.
	}. <- ответ.
}.

>> b := 666.

b в: ['к-тексту'] сделать: { <- ['Дьявол'].
}.

b в: ['к-логический'] сделать: { <- Ложь.
}.


Выход написать: a, стоп.  
Выход написать: (90 + a), стоп. 
Выход написать: b, стоп. 
Выход написать: (Истина и: b), стоп.

a := Список ← ['hello'] ; ['world'] ; Истина ; Пустой ; 666. 
a := a + ( Список ← 1 ).
Выход написать: a, стоп.
Выход написать: ((Карта новый) разместить: Пустой в: Пустой), стоп.
Выход написать: a сумма, стоп. 


{
	a в: ['к-тексту'] сделать: { <- Пустой. }.
	a := [''] + a.
} впоймать: { :исключение
	Выход написать: ['Ошибка замечена: '] + исключение, стоп.
}, запуск.



