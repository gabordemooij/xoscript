Список в: ['sum'] сделать: {
	>> total := 0.
	сам каждый: { :index :element
		total добавить: element.
	}. <- total.
}.

>> a := Истина.



a в: ['к-тексту'] сделать: {
	>> answer := Пустой.
	( сам = Истина ) истина: {
		answer := ['Yep'].
	}, иначе: {
		answer := ['Nope'].
	}. <- answer.
}.

a в: ['к-числу'] сделать: {
	>> answer := Пустой.
	( сам = Истина ) истина: {
		answer := 10.
	}, иначе: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b в: ['к-тексту'] сделать: { <- ['Devil'].
}.

b в: ['к-логический'] сделать: { <- Ложь.
}.


Выход написать: a, стоп.  
Выход написать: (90 + a), стоп. 
Выход написать: b, стоп. 
Выход написать: (Истина и: b), стоп.

a := Список ← ['hello'] ; ['world'] ; Истина ; Пустой ; 666. 
a := a + ( Список ← 1 ).
Выход написать: a, стоп.
Выход написать: ((Карта новый) разместить: Пустой в: Пустой), стоп.
Выход написать: a sum, стоп. 


{
	a в: ['к-тексту'] сделать: { <- Пустой. }.
	a := [''] + a.
} впоймать: { :error
	Выход написать: ['Error noted: '] + error, стоп.
}, запуск.



