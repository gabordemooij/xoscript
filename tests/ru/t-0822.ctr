# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := MariaDB новый хост: ['localhost'],
	пользователь: ['xo'],
	пароль: ['pass123'],
	имя-базы: ['xobase'],
	подключить.

>> параметры := db запрос: ['SELECT ? AS a, ? AS b, ? AS c'].
параметры параметры: (Список новый ; ['1']).
{ параметры получить: { :row Выход написать: row, стоп. }. } впоймать: { :e Выход написать: e, стоп. }, запуск.

>> параметры := db запрос: ['SELECT ? AS a'].
{ параметры получить: { :row Выход написать: row, стоп. }. } впоймать: { :e Выход написать: e, стоп. }, запуск.

# the right number still works, more parameters are ignored as before
>> параметры := db запрос: ['SELECT ? AS a, ? AS b'].
параметры параметры: (Список новый ; ['1'] ; ['2']).
параметры получить: { :row Выход написать: (row в: ['a']), написать: (row в: ['b']), стоп. }.
параметры параметры: (Список новый ; ['1'] ; ['2'] ; ['3']).
параметры получить: { :row Выход написать: (row в: ['a']), написать: (row в: ['b']), стоп. }.
