# меньше параметров, чем заполнителей, должно давать ошибку, а не чтение за пределами привязок
Server init.

>> бд := MariaDB новый хост: ['localhost'],
	пользователь: ['xo'],
	пароль: ['pass123'],
	имя-базы: ['xobase'],
	подключить.

>> параметры := бд запрос: ['SELECT ? AS a, ? AS b, ? AS c'].
параметры параметры: (Список новый ; ['1']).
{ параметры получить: { :ряд Выход написать: ряд, стоп. }. } впоймать: { :e Выход написать: e, стоп. }, запуск.

>> параметры := бд запрос: ['SELECT ? AS a'].
{ параметры получить: { :ряд Выход написать: ряд, стоп. }. } впоймать: { :e Выход написать: e, стоп. }, запуск.

# правильное количество по-прежнему работает, лишние параметры, как и раньше, игнорируются
>> параметры := бд запрос: ['SELECT ? AS a, ? AS b'].
параметры параметры: (Список новый ; ['1'] ; ['2']).
параметры получить: { :ряд Выход написать: (ряд в: ['a']), написать: (ряд в: ['b']), стоп. }.
параметры параметры: (Список новый ; ['1'] ; ['2'] ; ['3']).
параметры получить: { :ряд Выход написать: (ряд в: ['a']), написать: (ряд в: ['b']), стоп. }.
