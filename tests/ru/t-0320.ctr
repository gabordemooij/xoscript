


>> CoffeeMachine := Объект новый.
CoffeeMachine в: ['order:'] сделать: { :id
	>> coffee := ['Americano'].
	( id = 1 ) истина: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) истина: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) истина: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Объект новый.
SimpleCoffeeMachine в: ['order'] сделать: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Выход написать: redCup, стоп.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Выход написать: greenCup, стоп.
>> yellowCup := CoffeeMachine order: 1.
Выход написать: yellowCup, стоп.
>> blueCup := CoffeeMachine order: 0.
Выход написать: blueCup, стоп.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Выход написать: blackCup, стоп.
blackCup добавить-в-конец: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Выход написать: orangeCup, стоп.
