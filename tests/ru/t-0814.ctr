# формат cookie сессии, тип содержимого json, только веб-протоколы, svg показывается встроенно
Server инициализировать.
Программа импортировать: ['../../../src/xo/ru/webtools.xo'].

>> Поддельный-Запрос := Объект новый.
Поддельный-Запрос в: ['value:'] сделать: { :величина
	мой величина := величина.
}.
Поддельный-Запрос в: ['cookie:'] сделать: { :имя
	<- мой величина.
}.

>> Тестовая-Сессия := Сессия-временный-файл новый.
Тестовая-Сессия в: ['загрузить'] сделать: {
	<- Карта новый.
}.
Тестовая-Сессия в: ['ид-сеанса'] сделать: {
	<- мой id.
}.

>> куки := Список новый
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

куки каждый: { :i :кука
	>> http-запрос := Поддельный-Запрос новый.
	http-запрос value: кука.
	>> менеджер := Тестовая-Сессия новый.
	>> веб := Веб-документ новый.
	веб http-запрос: http-запрос.
	веб менеджер-сессий: менеджер.
	веб начать-сессию.
	Выход написать: ( менеджер ид-сеанса = кука ), стоп.
}.

>> веб := Веб-документ новый.
веб json: (Карта новый разместить: ['b'] в: ['a']).
Выход написать: ['\n'], стоп.

{ Сеть get: ['file:///etc/hostname']. } впоймать: { :e
	Выход написать: e, стоп.
}, запуск.

>> svg := Файл новый: ['/tmp/test0814.svg'].
svg написать: ['<svg xmlns="x"></svg>'].
Выход стоп.
Server передача: ['test0814.svg'] префикс: ['/tmp/'].
svg удалить.
