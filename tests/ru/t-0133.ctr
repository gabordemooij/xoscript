


>> Колода := Список новый.
Колода в: ['напечатать'] сделать: {
        >> len := сам счетчик - 1.
        { :i
                >> длина2 := сам счетчик - 1.
                Выход написать: ['длина: '].
                Выход написать: len, стоп.
                Выход написать: ['длина2: '].
                Выход написать: длина2, стоп.
        } × len.
}.

>> d := Колода ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d напечатать.
