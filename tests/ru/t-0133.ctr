


>> Deck := Список новый.
Deck в: ['print'] сделать: {
        >> len := сам счетчик - 1.
        { :i
                >> len2 := сам счетчик - 1.
                Выход написать: ['len: '].
                Выход написать: len, стоп.
                Выход написать: ['len2: '].
                Выход написать: len2, стоп.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
