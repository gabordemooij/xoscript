#Linux
>> часы := Момент новый.
часы часовая-зона: ['UTC-1'].
часы год: 1981, месяц: 1, день: 5,
      час: 13, минут: 15, секунд: 13.

Выход написать: часы, стоп.
часы часовая-зона: ['UTC+0'].

Выход написать: (
	(часы год преобразовать) + ['-'] + (часы месяц) + ['-'] + (часы день) + [' '] +
	(часы час) + [':'] + (часы минут) + [':'] + (часы секунд) + [' '] +
	['W'] + (часы неделя) + (часы часовая-зона)
), стоп.


часы часовая-зона: ['UTC-1'].
Выход написать: (
	(часы год преобразовать) + ['-'] + (часы месяц) + ['-'] + (часы день) + [' '] +
	(часы час) + [':'] + (часы минут) + [':'] + (часы секунд) + [' '] +
	['W'] + (часы неделя) + (часы часовая-зона)
), стоп.
