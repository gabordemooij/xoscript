# test list operations


>> cakes := Список ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes заменить: 1 длина: 2 на: ( Список ← ['cinnamon'] ; ['pineapple'] ).
Выход написать: (buy присоединить: [',']), стоп.


>> buy := cakes заменить: 1 длина: 12 на: ( Список ← ['cinnamon'] ; ['pineapple'] ).
Выход написать: (buy присоединить: [',']), стоп.


>> buy := cakes заменить: 2 длина: 10 на: ( Список новый ).
Выход написать: (buy присоединить: [',']), стоп.


>> buy := cakes заменить: 0 длина: 1 на: ( Список новый ).
Выход написать: (buy присоединить: [',']), стоп.


>> buy := cakes заменить: ['0'] длина: ['1'] на: ['x'].
Выход написать: (buy присоединить: [',']), стоп.
