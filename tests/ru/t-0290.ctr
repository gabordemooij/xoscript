# тест операций со списками


>> пирожные := Список ←
	['apple'] ;
	['ягода'] ;
	['шоко'] ;
	['сыр'].


>> купить := пирожные заменить: 1 длина: 2 на: ( Список ← ['корица'] ; ['ананас'] ).
Выход написать: (купить присоединить: [',']), стоп.


>> купить := пирожные заменить: 1 длина: 12 на: ( Список ← ['корица'] ; ['ананас'] ).
Выход написать: (купить присоединить: [',']), стоп.


>> купить := пирожные заменить: 2 длина: 10 на: ( Список новый ).
Выход написать: (купить присоединить: [',']), стоп.


>> купить := пирожные заменить: 0 длина: 1 на: ( Список новый ).
Выход написать: (купить присоединить: [',']), стоп.


>> купить := пирожные заменить: ['0'] длина: ['1'] на: ['x'].
Выход написать: (купить присоединить: [',']), стоп.
