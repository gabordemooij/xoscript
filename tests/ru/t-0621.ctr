>> фразы := Список новый
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> послание := ['Phrase: ~decoded base64: ~encoded'].
	
фразы каждый: { :_ :фраза 
	>> e := Server base64-кодировать: фраза.
	>> d := Server base64-декодировать: e.
	Выход написать: (
		послание скопировать ~encoded: e, ~decoded: d
	), стоп.
}.
