
>> Приветствователь := Объект новый.
Приветствователь в: ['новый'] сделать: {
	мой имя := ['?'].
}.
Приветствователь в: ['name:'] сделать: { :имя
	мой имя := имя.
}.
Приветствователь в: ['поприветствовать'] сделать: {
	Выход написать: (['hello[you]'] [you]: мой имя).
}.
>> друг := Приветствователь новый.
друг name: ['1'].
друг поприветствовать.
