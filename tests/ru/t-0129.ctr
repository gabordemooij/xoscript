
Список в: ['product'] сделать: {
	>> total := 1.
	сам каждый: { :index :element
		total умножить-на: element.
	}. <- total.
}.

>> a := Список ← 1 ; 2 ; 3.
Выход написать: a product, стоп.
Выход написать: (Список ← 2 ; 4 ; 8) product, стоп. 
Выход написать: (Список ← -2 ; 10) product, стоп. 
Выход написать: (Список ← 0.5 ; -2) product, стоп. 
