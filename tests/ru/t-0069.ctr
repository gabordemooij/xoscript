

Текст в: ['html'] сделать: { <- (
		сам
		заменить: ['&'] на: ['&amp;'],
		заменить: ['<'] на: ['&lt;'],
		заменить: ['>'] на: ['&gt;'],
		заменить: ['"'] на: ['&quot;']
	).
}.


Выход написать: ([' left trimmed '] сократить) + [' '] + ( ['and right trimmed'] сократить) + ['!'], стоп.
Выход написать: ['<html>"html & entities"</html>'] html.
