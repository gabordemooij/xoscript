
Выход написать: ['Прерывание цикла for, 0-4.'], стоп.
{ :i
	Выход написать: ['iteration #'] + i, стоп.
	(i = 4) разрыв.
} × 10.

>> x := 0.
>> xМеньше10 := { <- ( x < 10 ). }.

Выход написать: ['Прерывание цикла while-true, 0-4.'], стоп.
{
	Выход написать: ['iteration #'] + x, стоп.
	x добавить: 1.
	((x < 5) не) разрыв.
} пока: xМеньше10.

Выход написать: ['Прерывание цикла while-false, 5,4.'], стоп.
{
	Выход написать: ['iteration #'] + x, стоп.
	x вычесть: 1.
	(x = 3) разрыв.
} пока: { <- (x > 0). }.

Выход написать: ['Прерывание цикла times, 1-4.'], стоп.
{ :i
	Выход написать: ['iteration #'] + i, стоп.
	(i = 4) разрыв.
} × 5.

Выход написать: ['Прерывание блока, строку не печатать.'], стоп.
{ Истина разрыв. Выход написать: ['не пиши это!'], стоп. } запуск.

Выход написать: ['Прерывание блока, catch не срабатывает...'], стоп.
{ Истина разрыв. Выход написать: ['не пиши это!'], стоп. } впоймать: { Выход написать: ['Не перехватывай это!']. }, запуск.

Выход написать: ['Тест цикла each по массиву: 0,1'], стоп.
(Список ← 1 ; 2 ; 3) карта: { :i
	Выход написать: ['iteration #'] + i, стоп.
	(i = 1) разрыв.
}.

Выход написать: ['Тест цикла each по карте: только c'], стоп.
>> m := Карта новый.
m разместить: ['first'] в: ['a'], разместить: ['second'] в: ['b'], разместить: ['третий'] в: ['c'].
m каждый: { :k :v
	Выход написать: ['iteration'] + v + k, стоп.
	Истина разрыв.
}.

