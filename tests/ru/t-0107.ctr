
Выход написать: ['Break for-loop, 0-4.'], стоп.
{ :i
	Выход написать: ['iteration #'] + i, стоп.
	(i = 4) разрыв.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Выход написать: ['Break while-true loop, 0-4.'], стоп.
{
	Выход написать: ['iteration #'] + x, стоп.
	x добавить: 1.
	((x < 5) не) разрыв.
} пока: xIsLessThan10.

Выход написать: ['Break while-false loop, 5,4.'], стоп.
{
	Выход написать: ['iteration #'] + x, стоп.
	x вычесть: 1.
	(x = 3) разрыв.
} пока: { <- (x > 0). }.

Выход написать: ['Break times loop, 1-4.'], стоп.
{ :i
	Выход написать: ['iteration #'] + i, стоп.
	(i = 4) разрыв.
} × 5.

Выход написать: ['Break block, dont print line.'], стоп.
{ Истина разрыв. Выход написать: ['dont write this!'], стоп. } запуск.

Выход написать: ['Break block, dont fire catch...'], стоп.
{ Истина разрыв. Выход написать: ['dont write this!'], стоп. } впоймать: { Выход написать: ['Dont catch this!']. }, запуск.

Выход написать: ['Test Array each-loop: 0,1'], стоп.
(Список ← 1 ; 2 ; 3) карта: { :i
	Выход написать: ['iteration #'] + i, стоп.
	(i = 1) разрыв.
}.

Выход написать: ['Test Map each-loop: c only'], стоп.
>> m := Карта новый.
m разместить: ['first'] в: ['a'], разместить: ['second'] в: ['b'], разместить: ['third'] в: ['c'].
m каждый: { :k :v
	Выход написать: ['iteration'] + v + k, стоп.
	Истина разрыв.
}.

