>> t := Пустой.

# you can control the time zone for
# parsing like this:
Момент часовая-зона: ['CET'].
t := Момент от: ['1981-02-03 04:05:06'].
Выход написать: t, стоп.

# now using CEST time zone:
Момент часовая-зона: ['CEST'].
t := Момент от: ['1981-02-03 04:05:06'].
Выход написать: t, стоп.

# error if string cannot be parsed
{ Момент от: ['1900']. } впоймать: { Пустой. }, запуск.
