>> винодельня := { <- (	Карта новый
		разместить: 2 в: ['merlot'],
		разместить: 3 в: ['malbec'],
		разместить: 4 в: ['syrah']
	).
}.

Выход написать: (((винодельня запуск) - ['ничего']) счетчик), стоп.
Выход написать: (((винодельня запуск) - ['merlot']) счетчик), стоп.
Выход написать: (((винодельня запуск) - ['malbec']) счетчик), стоп.
Выход написать: (((винодельня запуск) - ['syrah']) счетчик), стоп.
Выход написать: (((винодельня запуск) - ['merlot'] - ['malbec']) счетчик), стоп.
Выход написать: (((винодельня запуск) - ['merlot'] - ['syrah']) счетчик), стоп.
Выход написать: (((винодельня запуск) - ['malbec'] -['syrah']) счетчик), стоп.
Выход написать: (((винодельня запуск) - ['malbec'] - ['syrah'] - ['merlot']) счетчик), стоп.

