Программа режим-памяти: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } впоймать: {
		oops добавить: 1.
	}, запуск.
} × 1000.

{
	Выход написать: ['hi there!'].
	этот-блок-кода ошибка: ['oops'].
	Выход написать: ['hi there!'].
	{ Выход написать: ['dont print this']. } запуск.
} впоймать: { :e 
	Выход написать: ['got ya!']. 
	Выход написать: e.
}, запуск.
