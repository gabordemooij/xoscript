>> Приветствователь := Объект новый.
Приветствователь в: ['создать'] сделать: {
	>> приветствователь := Объект новый.
	приветствователь в: ['name:'] сделать: { :имя
		Выход написать: ['задаём имя'].
		мой моёИмя := имя.
	}.
	приветствователь в: ['выполнитьПриветствие'] сделать: {
		Выход написать: ['Hello'].
		Выход написать: мой моёИмя.
	}.
	приветствователь в: ['поприветствовать'] сделать: {
		сам выполнитьПриветствие.
	}. <- приветствователь.
}.
>> приветствователь := Приветствователь создать.
приветствователь name: ['солнышко!'].
приветствователь поприветствовать.
