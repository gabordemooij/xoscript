>> Greeter := Объект новый.
Greeter в: ['make'] сделать: {
	>> greeter := Объект новый.
	greeter в: ['name:'] сделать: { :имя
		Выход написать: ['setting a name'].
		мой myName := имя.
	}.
	greeter в: ['performGreeting'] сделать: {
		Выход написать: ['Hello'].
		Выход написать: мой myName.
	}.
	greeter в: ['greet'] сделать: {
		сам performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
