


>> вино := Объект новый.


вино в: ['вТекст'] сделать: { <- ['merlot'].
}.

вино в: ['naarTekst'] сделать: { <- ['merlot'].
}.


вино в: ['='] сделать: { :other wine <- ( сам вТекст = other wine ).
}.

вино в: ['=='] сделать: { :other wine <- ( сам вТекст = other wine ).
}.



вино
	случай: ['cabernet'] сделать: { Выход написать: ['это Каберне!']. },
