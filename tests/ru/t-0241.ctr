

Текст в: ['вычислить'] сделать: {
	>> код := Файл новый: ['/tmp/eval.ctr'].
	код написать: (сам к-тексту + ['.']).
	Программа импортировать: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Список ← (['Кавычки '] + Q + [' — зло?']) ; 1.
>> x := q к-тексту.
Выход написать: x, стоп.
>> y := Пустой.
(['y := '] + x ) вычислить.
Выход написать: y ? 0, стоп.

q := Карта разместить: ['\[''] в: ['\['quote\']'].
x := q к-тексту.
Выход написать: x, стоп.
y := Пустой.
(['y := '] + x ) вычислить.

>> q := (Карта новый) разместить:['\[''] в:['\['quote\[''].
Выход написать: y ? ['\['quote\']'], стоп.
