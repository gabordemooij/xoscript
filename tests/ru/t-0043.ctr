>> повторитель := Объект новый.
повторитель в: ['ответить:'] сделать: { :что
	Выход написать: что + [' '].
}.
повторитель в: ['ответить:и:'] сделать: { :что :say
	Выход написать: что, написать: say + [' '].
}.
повторитель в: ['ответить:и:и:'] сделать: { :что :say :ещё
	Выход написать: что, написать: say, написать: ещё.
}.
повторитель повторить.
повторитель everything: ['Я говорю.'].
повторитель and: ['I '] everything: ['делаю.'].
