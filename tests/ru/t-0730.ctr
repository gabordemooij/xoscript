Выход написать: ['Test object'], стоп.
>> a := Объект новый. 

a в: ['item:'] сделать: { :moment
	мой moment := moment. 
}.

a в: ['item'] сделать: { <- мой moment.
}.

>> today := Момент новый часовая-зона: ['CEST'], год: 2026, месяц: 7.
a item: today.
Выход написать: a item, стоп.
a save-as: ['/tmp/a.bin'].
Выход написать: ['========== RELOADING SNAP:'], стоп.
>> b := Объект load-from: ['/tmp/a.bin'].
Выход написать: b item, стоп.
