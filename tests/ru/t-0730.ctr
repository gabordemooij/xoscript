Выход написать: ['Тестовый объект'], стоп.
>> a := Объект новый. 

a в: ['item:'] сделать: { :мгновение
	мой мгновение := мгновение. 
}.

a в: ['предмет'] сделать: {
	<- мой мгновение.
}.

>> сегодня := Момент новый часовая-зона: ['CEST'], год: 2026, месяц: 7.
a item: сегодня.
Выход написать: a предмет, стоп.
a save-as: ['/tmp/a.bin'].
Выход написать: ['========== ПЕРЕЗАГРУЗКА СНИМКА:'], стоп.
>> b := Объект load-from: ['/tmp/a.bin'].
Выход написать: b предмет, стоп.
