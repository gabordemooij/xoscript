
Текст в: ['html'] сделать: { <- (
		сам
		заменить: ['&'] на: ['&amp;'],
		заменить: ['<'] на: ['&lt;'],
		заменить: ['>'] на: ['&gt;'],
		заменить: ['"'] на: ['&quot;']
	).
}.

>> HtmlКисть := Объект новый.

HtmlКисть в: ['ответить:'] сделать: { :тег
	Выход написать: (['<tag>↵'] tag: тег ).
}.

HtmlКисть в: ['ответить:и:'] сделать: { :тег :content
	тег := ( тег от: 0 длина: (тег длина - 1) ).
	Выход написать: (['<tag content>↵'] tag: тег, content: content).
}.

HtmlКисть в: ['content:'] сделать: { :текст
	Выход написать: текст html, стоп.
}.

HtmlКисть в: ['атр:знач:'] сделать: { :атр :value <- ['attr="value"'] attr: атр, value: value.
}.

>> h := HtmlКисть новый.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h атр: ['class'] знач: ['bold']),
		/span
	/body
/html.
		
