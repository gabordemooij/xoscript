
Текст в: ['html'] сделать: { <- (
		сам
		заменить: ['&'] на: ['&amp;'],
		заменить: ['<'] на: ['&lt;'],
		заменить: ['>'] на: ['&gt;'],
		заменить: ['"'] на: ['&quot;']
	).
}.

>> HtmlBrush := Объект новый.

HtmlBrush в: ['ответить:'] сделать: { :tag
	Выход написать: (['<tag>↵'] tag: tag ).
}.

HtmlBrush в: ['ответить:и:'] сделать: { :tag :content
	tag := ( tag от: 0 длина: (tag длина - 1) ).
	Выход написать: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush в: ['content:'] сделать: { :text
	Выход написать: text html, стоп.
}.

HtmlBrush в: ['attr:value:'] сделать: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush новый.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
