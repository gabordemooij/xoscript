

Текст в: ['вычислить'] сделать: {
	>> код := Файл новый: ['/tmp/eval.ctr'].
	код написать: сам к-тексту + ['.'].
	Программа импортировать: ['/tmp/eval.ctr'].
}.

>> a := (Список ← (
	(Карта новый)
		разместить: ['домен'] в: ['mywebsite.com'],
		разместить: (Список ←
			((Карта новый)
				разместить: ['главная'] в: ['title'],
				разместить: ['<html></html>'] в: ['body'],
				разместить: ['2017-01-01'] в: ['создано']
			) ;
			((Карта новый)
				разместить: ['aboutus(c)'] в: ['title'],
				разместить: ['<credits>Author Inc.</credits>'] в: ['body']
			)
		) в: ['страницы']
	)
) к-тексту.

Выход написать: a тип, стоп.
Выход написать: a, стоп.

>> b := Пустой.
(['b := '] + a) вычислить.
Выход написать: b ? 0 ? ['страницы'] ? 1 ? ['body'], стоп.

>> c := b ? 0.
>> d := c к-тексту.
Выход написать: d тип, стоп.

>> e := Пустой.
(['e := '] + d) вычислить.
Выход написать: e ? ['страницы'] ? 0, стоп.
