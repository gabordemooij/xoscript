# тест базы данных
# нужную конфигурацию см. в примере server.xo

Server init.
Выход написать: ['Тест базы данных'], стоп.

>> бд := MariaDB новый хост: ['localhost'],
	пользователь: ['xo'], пароль: ['pass123'], имя-базы: ['xobase'], подключить.

Выход написать: ['Можем ли подключиться? '] + бд подключено?, стоп.

>> параметры := бд запрос: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], параметры: ( Список новый ; ['abc'] ; 12.35 ; 6 ). # параметризованные запросы

{  параметры мутация. бд commit. } впоймать: { :e бд rollback.  }, запуск.

Выход написать: ['Можем ли вставить? '] + ( параметры insert-id > 0 ), стоп.

>> Объ := Объект новый.
Объ в: ['получить-строки'] сделать: {
	мой счетчик := 0.
	>> параметры :=
	бд запрос: ['SELECT * FROM book order by id desc limit 2'], 
	получить: { :ряд 
		мой счетчик добавить: 1.
		Истина разрыв.
	}. # получение строк
	<- мой счетчик скопировать.
}.

Выход написать: ['Можем ли выполнить запрос? '] + ( Объ получить-строки > 0 ), стоп.
