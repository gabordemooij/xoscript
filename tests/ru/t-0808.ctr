# ключи и подписи хранилища, которые декодируются в слишком длинное значение, не должны переполнять стек
Server init.

>> пара-ключей := Хранилище криптографические-ключи.
>> зкл := пара-ключей первый.
>> откл := пара-ключей последний.
>> подп := Хранилище подписать: ['abc'] с: зкл.

# 88 символов без дополнения декодируются в 66 байт
>> длинный := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 символа без дополнения декодируются в 33 байта
>> короткий := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Хранилище подписать: ['abc'] с: длинный. } впоймать: { :e
	Выход написать: e, стоп.
}, запуск.

{ Хранилище проверить: ['abc'] подпись: длинный с: откл. } впоймать: { :e
	Выход написать: e, стоп.
}, запуск.

{ Хранилище проверить: ['abc'] подпись: подп с: короткий. } впоймать: { :e
	Выход написать: e, стоп.
}, запуск.
