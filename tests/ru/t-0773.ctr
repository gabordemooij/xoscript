Выход написать: ['Test object'], стоп.
>> a := Объект новый. 
a в: ['item:'] сделать: { :int64
	мой int64 := int64. 
}.
a в: ['item'] сделать: { <- мой int64.
}.
a item: ( Int64 от-тексту: ['9999'] ).
Выход написать: a item, стоп.
>> old-int64-address := a item прототип адрес-памяти.
a save-as: ['/tmp/a.bin'].
Выход написать: ['========== RELOADING SNAP:'], стоп.
>> b := Объект load-from: ['/tmp/a.bin'].
(b item прототип адрес-памяти = old-int64-address) истина: {
	Выход написать: ['Object link re-attached.'], стоп.
}.
Выход написать: ( b item ), стоп.
