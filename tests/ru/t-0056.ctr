>> z := Объект новый.
z в: ['value:'] сделать: { :v
	мой value := v. <- сам.
}.
z в: ['value'] сделать: { <- мой value. }.
(z setValue: 1) value: 2.
Выход написать: z value.
>> x := z.
Выход написать: x value.
z := Пустой.
Выход написать: z value.
Выход написать: x value.
Выход написать: ['hello'].
Выход написать: 3 + 2.
Выход написать: (3 > 2).
