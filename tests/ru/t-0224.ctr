
>> countries := Список новый
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Список новый
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods на: countries, каждый: { :key :value
	counter добавить: 1.
}.

Выход написать: (['we serve counter dishes'] counter: counter), стоп.

