Программа режим-памяти: 0.
Список в: ['сумма'] сделать: {
	>> итог := 0.
	сам каждый: { :индекс :элемент
		итог добавить: элемент.
	}. <- итог.
}.

>> занятаПамять1 := 0.
>> занятаПамять2 := 0.
>> занятаПамять3 := 0.
>> занятаПамять4 := 0.



>> f := Файл новый: ['/tmp/test.txt'].
f написать: ['Lorem Ipsum'].
f закрыть.
  

f := Файл новый: ['/tmp/test.txt'].
>> текст := f прочитать.
f закрыть.



Программа уборка.
занятаПамять1 := (Программа лимит ? 1).



f := Файл новый: ['/tmp/test.txt'].
текст := f прочитать.
f закрыть.

Программа уборка.
занятаПамять2 := (Программа лимит ? 1).


f := Файл новый: ['/tmp/test.txt'].
текст := f прочитать.
f закрыть.

Программа уборка.
занятаПамять3 := (Программа лимит ? 1).



( занятаПамять1 = занятаПамять2 и: занятаПамять1 = занятаПамять3, и: занятаПамять2 = занятаПамять3 ) истина: {
	Выход написать: ['Здесь нет утечек памяти'].
}, ложь: {
	Выход написать: ['Утечка памяти...'].
}.
