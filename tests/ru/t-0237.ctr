
Текст в: ['вычислить'] сделать: {
	>> код := Файл новый: ['/tmp/eval.ctr'].
	код написать: (сам к-тексту + ['.']).
	Программа импортировать: ['/tmp/eval.ctr'].
}.

>> map :=
	(Карта новый)
	разместить: ['Привет вам'] в: ['two'],
	разместить: (Список ← ['hello'] ; ['world'] ; (Список ← 1 ; 2; 9) ; Ложь) в: ['один'],
	разместить: ( (Карта новый) разместить: ['мирр'] в: ['с ошибкой'] ) в: ['three'],
	разместить: (Список ← ((Карта новый) разместить: ['сокровище'] в: ['спрятано']) ; 2) в: ['четыре']. 
>> str := map к-тексту.
>> map2 := Пустой.
(['map2 := '] + str ) вычислить.
Выход написать: map2 ? ['один'] ? 0.
Выход написать: map2 ? ['один'] ? 1.
Выход написать: map2 ? ['четыре'] ? 0 ? ['спрятано'].
Выход написать: map2 ? ['один'] ? 2 ? 2.
