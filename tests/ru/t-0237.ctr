
Текст в: ['evaluate'] сделать: {
	>> код := Файл новый: ['/tmp/eval.ctr'].
	код написать: (сам к-тексту + ['.']).
	Программа импортировать: ['/tmp/eval.ctr'].
}.

>> map :=
	(Карта новый)
	разместить: ['Hi There'] в: ['two'],
	разместить: (Список ← ['hello'] ; ['world'] ; (Список ← 1 ; 2; 9) ; Ложь) в: ['one'],
	разместить: ( (Карта новый) разместить: ['wrrld'] в: ['misspelled'] ) в: ['three'],
	разместить: (Список ← ((Карта новый) разместить: ['treasure'] в: ['hidden']) ; 2) в: ['four']. 
>> str := map к-тексту.
>> map2 := Пустой.
(['map2 := '] + str ) evaluate.
Выход написать: map2 ? ['one'] ? 0.
Выход написать: map2 ? ['one'] ? 1.
Выход написать: map2 ? ['four'] ? 0 ? ['hidden'].
Выход написать: map2 ? ['one'] ? 2 ? 2.
