Выход написать: ['Test object'], стоп.
>> a := Объект новый. 
a в: ['item:'] сделать: { :lst
	мой lst := lst. 
}.
a в: ['item'] сделать: { <- мой lst.
}.
a item: (
	Список новый ; 1 ; (
		Список новый ; ['a'] ; (
			Список новый ; ( Момент новый: 1 )
		) ; ( Int64 от-тексту: ['321'] )
	)
