>> items := Карта новый.
items разместить: ['чёрный'] в: ['coffee'], разместить: ['earl grey'] в: ['чай'].
Выход написать: (items в: ['coffee']), написать: (items в: ['чай']).
Выход написать: ['всего'] + items счетчик + [' предметов в массиве.'].
items разместить: ['капучино'] в: ['coffee'].
Выход написать: ['Теперь мой кофе.. '] + (items в: ['coffee']).
items разместить: ['aaa'] в: ['1'].
items разместить: ['bbb'] в: ['2'].
Выход написать: (items в: ['a']).
