>> items := Карта новый.
items разместить: ['black'] в: ['coffee'], разместить: ['earl grey'] в: ['tea'].
Выход написать: (items в: ['coffee']), написать: (items в: ['tea']).
Выход написать: ['there are'] + items счетчик + [' items in the array.'].
items разместить: ['capuccino'] в: ['coffee'].
Выход написать: ['Now my coffee is.. '] + (items в: ['coffee']).
items разместить: ['aaa'] в: ['1'].
items разместить: ['bbb'] в: ['2'].
Выход написать: (items в: ['a']).
