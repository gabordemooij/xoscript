# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Программа shell-escape: ['abc'].
Выход написать: c, стоп.
Выход написать: ( Программа Системная-команда: ['echo '] + c ), стоп.

c := Программа shell-escape: ['a'b'c'].
Выход написать: c, стоп.
Выход написать: ( Программа Системная-команда: ['echo '] + c ), стоп.

c := Программа shell-escape: ['a\'c'].
Выход написать: c, стоп.
Выход написать: ( Программа Системная-команда: ['echo '] + c ), стоп.