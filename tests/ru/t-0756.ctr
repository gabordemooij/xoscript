Выход написать: ['Тестовый объект'], стоп.
>> приветствователь := Объект новый.
приветствователь в: ['name:'] сделать: { :имя
	мой xимя := имя. 
}.
приветствователь в: ['поприветствовать'] сделать: {
	Выход написать: ['Привет, '] + мой xимя, стоп.
}.
приветствователь name: ['Sherlock'].
приветствователь save-as: ['/tmp/a.bin'].
приветствователь save-as: ['/tmp/b.bin'].
Выход написать: ['========== ПЕРЕЗАГРУЗКА СНИМКА:'], стоп.
>> b := Объект load-from: ['/tmp/a.bin'].
>> c := Объект load-from: ['/tmp/b.bin'].
b поприветствовать.
b name: ['Watson'], поприветствовать.
c name: ['Moriarty'], поприветствовать.
