{
	>> a := Список новый.
	a добавить-в-конец: 1.
	a добавить-в-конец: 2.
	Выход написать: (a присоединить: [',']), стоп.
	a разместить: 3 в: 2.
	Выход написать: (a присоединить: [',']), стоп.
	a разместить: 4 в: 10.
	Выход написать: (a присоединить: [',']), стоп.
	a срез-слева.
	a срез-слева.
	a срез-слева.
	Выход написать: (a присоединить: [',']), стоп.
	a разместить: 9 в: 0.
	Выход написать: (a присоединить: [',']), стоп.
	a разместить: 6 в: -1.
} впоймать: { :e
	Выход написать: ['Uncatched error has occurred.↵'] + e, стоп.
}, запуск.


