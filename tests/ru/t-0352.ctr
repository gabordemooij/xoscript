Число в: ['roman'] сделать: {
	>> к-числу := сам скопировать.
	>> roman := [''].
	{
		{
			(к-числу ≥ 1000) истина: {
				roman добавить-в-конец: ['Ⅿ'].
				к-числу вычесть: 1000.
			}, разрыв.
		
			(к-числу ≥ 500) истина: {
				roman добавить-в-конец: ['Ⅾ'].
				к-числу вычесть: 500.
			}, разрыв.
		
			(к-числу ≥ 100) истина: {
				roman добавить-в-конец: ['Ⅽ'].
				к-числу вычесть: 100.
			}, разрыв.
		
			(к-числу ≥ 50) истина: {
				roman добавить-в-конец: ['Ⅼ'].
				к-числу вычесть: 50.
			}, разрыв.
		
			(к-числу ≥ 50) истина: {
				roman добавить-в-конец: ['Ⅼ'].
				к-числу вычесть: 50.
			}, разрыв.
		
			(к-числу ≥ 10) истина: {
				roman добавить-в-конец: ['Ⅹ'].
				к-числу вычесть: 10.
			}, разрыв.
			
			(к-числу ≥ 9) истина: {
				roman добавить-в-конец: ['Ⅸ'].
				к-числу вычесть: 9.
			}, разрыв.
			
			(к-числу ≥ 5) истина: {
				roman добавить-в-конец: ['Ⅴ'].
				к-числу вычесть: 5.
			}, разрыв.
			
			(к-числу ≥ 4) истина: {
				roman добавить-в-конец: ['Ⅳ'].
				к-числу вычесть: 4.
			}, разрыв.
			
			(к-числу ≥ 1) истина: {
				roman добавить-в-конец: ['Ⅰ'].
				к-числу вычесть: 1.
			}, разрыв.
		} процедура.
	} пока: { <- к-числу > 0. }. <- roman.
}.

Выход написать: 1 roman, стоп.
Выход написать: 2 roman, стоп.
Выход написать: 4 roman, стоп.
Выход написать: 8 roman, стоп.
Выход написать: 16 roman, стоп.
Выход написать: 32 roman, стоп.
