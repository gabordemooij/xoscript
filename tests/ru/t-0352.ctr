Число в: ['римское'] сделать: {
	>> к-числу := сам скопировать.
	>> римское := [''].
	{
		{
			(к-числу ≥ 1000) истина: {
				римское добавить-в-конец: ['Ⅿ'].
				к-числу вычесть: 1000.
			}, разрыв.
		
			(к-числу ≥ 500) истина: {
				римское добавить-в-конец: ['Ⅾ'].
				к-числу вычесть: 500.
			}, разрыв.
		
			(к-числу ≥ 100) истина: {
				римское добавить-в-конец: ['Ⅽ'].
				к-числу вычесть: 100.
			}, разрыв.
		
			(к-числу ≥ 50) истина: {
				римское добавить-в-конец: ['Ⅼ'].
				к-числу вычесть: 50.
			}, разрыв.
		
			(к-числу ≥ 50) истина: {
				римское добавить-в-конец: ['Ⅼ'].
				к-числу вычесть: 50.
			}, разрыв.
		
			(к-числу ≥ 10) истина: {
				римское добавить-в-конец: ['Ⅹ'].
				к-числу вычесть: 10.
			}, разрыв.
			
			(к-числу ≥ 9) истина: {
				римское добавить-в-конец: ['Ⅸ'].
				к-числу вычесть: 9.
			}, разрыв.
			
			(к-числу ≥ 5) истина: {
				римское добавить-в-конец: ['Ⅴ'].
				к-числу вычесть: 5.
			}, разрыв.
			
			(к-числу ≥ 4) истина: {
				римское добавить-в-конец: ['Ⅳ'].
				к-числу вычесть: 4.
			}, разрыв.
			
			(к-числу ≥ 1) истина: {
				римское добавить-в-конец: ['Ⅰ'].
				к-числу вычесть: 1.
			}, разрыв.
		} процедура.
	} пока: { <- к-числу > 0. }. <- римское.
}.

Выход написать: 1 римское, стоп.
