# группа, не входящая в совпадение, не должна вызывать сбой и должна сохранять номера групп
Server init.
>> показать := { :образец :subject
	>> p := Шаблон новый: образец.
	p совпадение: subject выполнить: { :m :g
		Выход написать: g счетчик, написать: [' '], написать: (g присоединить: ['|']), стоп.
		<- m.
	}.
}.
показать применить: ['(a)|(b)'] и: ['b'].
показать применить: ['(a)|(b)'] и: ['a'].
показать применить: ['(x)?y'] и: ['y'].
показать применить: ['(x)?(y)(z)?'] и: ['xy'].
