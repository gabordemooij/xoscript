Список в: ['скопировать'] сделать: {
	>> скопировать := Список новый.
	сам каждый: { :к-числу :раздел
		скопировать добавить-в-конец: раздел рекурсия скопировать.
	}.
	<- скопировать.
}.

>> овца := Список новый ; ['Dolly'] ; ['Shaun']. 
>> клоны := овца скопировать.
клоны каждый: { :к-числу :овца
	овца добавить-в-конец: ['2'].
}.

Выход написать: овца, стоп.
Выход написать: клоны, стоп.
