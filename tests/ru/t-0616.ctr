Список в: ['скопировать'] сделать: {
	>> скопировать := Список новый.
	сам каждый: { :к-числу :section
		скопировать добавить-в-конец: section рекурсия скопировать.
	}. <- скопировать.
}.

>> sheep := Список новый ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep скопировать.
clones каждый: { :к-числу :sheep
	sheep добавить-в-конец: ['2'].
}.

Выход написать: sheep, стоп.
Выход написать: clones, стоп.
