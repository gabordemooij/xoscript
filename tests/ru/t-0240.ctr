# test qualifiers

>> $ := Объект новый.

$ в: ['ответить:'] сделать: { :x
	
	>> operation := x набор-символов: 0.
	>> valuta := x набор-символов: 1.
	>> money := x сместить: 2.
	
	>> amount := 0.

	( operation = ['+'] ) истина: {
		( valuta = ['£'] ) истина: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Выход написать: x, стоп.


>> Fruit := Объект новый.

Fruit в: ['новый'] сделать: {
	>> f := сам новый.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit в: ['apples:'] сделать: { :a мой apples := a. }.
Fruit в: ['oranges:'] сделать: { :p мой oranges := p. }.
Fruit в: ['apples'] сделать: { <- мой apples. }.
Fruit в: ['oranges'] сделать: { <- мой oranges. }.

Fruit в: ['+'] сделать: { :f
	
	>> n := Fruit новый.
	f добавить: 1.
	
	n apples: (f apples + мой apples).
	n oranges:  (f oranges  + мой oranges). <- n.
}.

Fruit в: ['к-тексту'] сделать: { <- ( мой apples к-тексту + [' apples and '] + мой oranges + [' oranges'] ).
}.

Число в: ['apples'] сделать: { <- ((Fruit новый) apples: сам).
}.

Число в: ['apple'] сделать: { <- ((Fruit новый) apples: сам).
}.

Число в: ['oranges'] сделать: { <- ((Fruit новый) oranges: сам).
}.




Выход написать: (1 apple + 3 oranges + 4 apples), стоп.


Текст в: ['twice'] сделать: { <- ((сам к-тексту) + (сам к-тексту)).
}.



Выход написать: ['❤❤❤'] twice.



