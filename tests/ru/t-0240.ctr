# тест квалификаторов

>> $ := Объект новый.

$ в: ['ответить:'] сделать: { :x
	
	>> операция := x набор-символов: 0.
	>> валюта := x набор-символов: 1.
	>> деньги := x сместить: 2.
	
	>> количество := 0.

	( операция = ['+'] ) истина: {
		( валюта = ['£'] ) истина: { количество := 1.28 × деньги. }.
	}. <- количество.
}.



>> x := $ +£20.

Выход написать: x, стоп.


>> Фрукт := Объект новый.

Фрукт в: ['новый'] сделать: {
	>> f := сам новый.
	f apples: 0.
	f oranges: 0. <- f.
}.

Фрукт в: ['apples:'] сделать: { :a мой яблоки := a. }.
Фрукт в: ['oranges:'] сделать: { :p мой апельсины := p. }.
Фрукт в: ['яблоки'] сделать: { <- мой яблоки. }.
Фрукт в: ['апельсины'] сделать: { <- мой апельсины. }.

Фрукт в: ['+'] сделать: { :f
	
	>> n := Фрукт новый.
	f добавить: 1.
	
	n apples: (f яблоки + мой яблоки).
	n oranges:  (f апельсины  + мой апельсины). <- n.
}.

Фрукт в: ['к-тексту'] сделать: { <- ( мой яблоки к-тексту + [' яблок и '] + мой апельсины + [' апельсинов'] ).
}.

Число в: ['яблоки'] сделать: { <- ((Фрукт новый) apples: сам).
}.

Число в: ['apple'] сделать: { <- ((Фрукт новый) apples: сам).
}.

Число в: ['апельсины'] сделать: { <- ((Фрукт новый) oranges: сам).
}.




Выход написать: (1 apple + 3 апельсины + 4 яблоки), стоп.


Текст в: ['дважды'] сделать: { <- ((сам к-тексту) + (сам к-тексту)).
}.



Выход написать: ['❤❤❤'] дважды.



