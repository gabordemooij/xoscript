

>> объ := Объект новый.

объ в: ['поприветствовать'] сделать: {
	<- ['привет'].
}.

# должно вывести hi123hi123ok
объ в: ['задача'] сделать: {
	мой свойство := 123.
	{
		# попробуй привязывает сам/мой к объекту вместо блока
		Выход написать: сам поприветствовать.
		Выход написать: мой свойство.
		1 / 0.
	} впоймать: {
		Выход написать: сам поприветствовать.
		Выход написать: мой свойство.
		Выход написать: ['ok'].
	}, попробуй.
}.

объ задача.