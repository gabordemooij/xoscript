>> создатьСумматор := { :x
	>> f := { :y <- (мой x + y). } задать: ['x'] значение: x. <- f.
}.
>> отображатель := { :массив :функ
	>> отображение := { :i мой q разместить: (мой f применить: (мой q ? i)) в: i. } 
	задать: ['q'] значение: массив,
	задать: ['f'] значение: функ.
	{ :i отображение применить: i. } × (массив счетчик).
}.

>> a := Список ← 1; 2; 3.
отображатель применить: a и: (создатьСумматор применить: 100).
Выход написать: (a позиция: 0), стоп.
Выход написать: (a ? 1), стоп.
Выход написать: (a ? 2), стоп.
