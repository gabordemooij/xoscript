>> makeAdder := { :x
	>> f := { :y <- (мой x + y). } задать: ['x'] значение: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i мой q разместить: (мой f применить: (мой q ? i)) в: i. } 
	задать: ['q'] значение: array,
	задать: ['f'] значение: func.
	{ :i mapping применить: i. } × (array счетчик).
}.

>> a := Список ← 1; 2; 3.
mapper применить: a и: (makeAdder применить: 100).
Выход написать: (a позиция: 0), стоп.
Выход написать: (a ? 1), стоп.
Выход написать: (a ? 2), стоп.
