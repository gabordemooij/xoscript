# a value ending in the first part of an opening quote must survive serialization
>> значение := Список новый
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

значение каждый: { :i :value
	>> d := Карта новый.
	d разместить: value в: ['k'].
	d разместить: ['second'] в: ['j'].
	>> r := d код объект.
	Выход написать: r счетчик, стоп.
	Выход написать: ( (r в: ['k']) = value ), стоп.
}.
