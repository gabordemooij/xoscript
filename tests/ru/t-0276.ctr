>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Объект новый.
⚄ в: ['вытянутьИз:количество:'] сделать: { :пул :счетчик
	
	>> результат := [''].
	
	{
		>> индекс := Число случайное % (пул длина).
		результат добавить-в-конец: ( пул набор-символов: (индекс + 1) ).
		
	} × счетчик. <- результат.
}.

>> случайное := ⚄ вытянутьИз: ?? количество: ?? длина.
Выход написать: (['x↵'] x случайное длина).
Выход написать: (['y↵'] y ?? длина).

