
Server init.
>> зпр := HTTP-запрос новый.
Выход написать: ['HTTP-GET d[]=']  + ( зпр get-список: ['d[]'] ), стоп. # GET
Выход написать: ['HTTP-GET f[]=']  + ( зпр get-список: ['f[]'] ), стоп. # GET
Выход написать: ['HTTP-POST e[]='] + ( зпр post-список: ['e[]'] ), стоп. # GET
Выход написать: ['HTTP-POST c=']   + ( зпр post: ['c'] ), стоп. # GET
Выход написать: ['HTTP-POST xx=']  + ( зпр post: ['xx'] ), стоп. # GET
