Выход написать: ['Test object'], стоп.
>> a := Объект новый. 

a в: ['item:'] сделать: { :fmt
	мой fmt := fmt. 
}.

a в: ['item'] сделать: { <- мой fmt.
}.

a item: ( Формат новый: ['|%s|'] ).

Выход написать: a item, стоп.

>> old-fmt-address := a item прототип адрес-памяти.
a save-as: ['/tmp/a.bin'].
Выход написать: ['========== RELOADING SNAP:'], стоп.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип адрес-памяти = old-fmt-address) истина: {
	Выход написать: ['Object link re-attached.'], стоп.
}.

Выход написать: ( b item применить: ['hello'] ), стоп.
