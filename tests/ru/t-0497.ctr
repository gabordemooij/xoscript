Server init.

# записываем тестовый файл
>> f := Файл новый: ['/tmp/test.gif'].
f написать: ['GIF87a01234567810'].

# отдаём файл
Server передача: ['test.gif'] префикс: ['/tmp/'].

Выход стоп.

Выход написать: ['Вне контейнера (безопасность):'], стоп.
{ Server передача: ['../passwd'] префикс: ['/tmp/']. }
впоймать: { :e Выход написать: e, стоп. },
запуск.

Выход написать: ['Неверный префикс:'], стоп.
{ Server передача: ['test.gif'] префикс: ['z:\\']. }
впоймать: { :e Выход написать: e, стоп. },
запуск.

Выход написать: ['Несуществующий файл:'], стоп.
{ Server передача: ['xxx.xxx'] префикс: ['/tmp/']. }
впоймать: { :e Выход написать: e, стоп. },
запуск.
