60 × {
	>> x := (Число случайное % 6) + 1.
	(x ≤ 6) ложь: { Выход написать: ['ОШИБКА']. }.
	(x ≥0) ложь: { Выход написать: ['ОШИБКА']. }.
	x := (Число случайное % 3) + 1.
	(x < 3) ложь: { Выход написать: ['ОШИБКА']. }.
	(x>-1) ложь: { Выход написать: ['ОШИБКА']. }.
	x := ((Логический подбросить) к-числу).
	(x = 0 или: x = 1) ложь: { Выход написать: ['ОШИБКА']. }.
	x := ((Истина подбросить) к-числу).
	(x = 0 или: x = 1) ложь: { Выход написать: ['ОШИБКА']. }.
	x := (Логический подбросить либо: ['ОРЁЛ'] или: ['РЕШКА']).
	((x = ['ОРЁЛ']) или: (x = ['РЕШКА'])) ложь: { Выход написать: ['ОШИБКА']. }.
}.
Выход написать: ['ГОТОВО'].

