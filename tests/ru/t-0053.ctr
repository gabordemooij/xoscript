60 × {
	>> x := (Число random % 6) + 1.
	(x ≤ 6) ложь: { Выход написать: ['FAIL']. }.
	(x ≥0) ложь: { Выход написать: ['FAIL']. }.
	x := (Число random % 3) + 1.
	(x < 3) ложь: { Выход написать: ['FAIL']. }.
	(x>-1) ложь: { Выход написать: ['FAIL']. }.
	x := ((Логический flip) к-числу).
	(x = 0 или: x = 1) ложь: { Выход написать: ['FAIL']. }.
	x := ((Истина flip) к-числу).
	(x = 0 или: x = 1) ложь: { Выход написать: ['FAIL']. }.
	x := (Логический flip либо: ['HEAD'] или: ['TAIL']).
	((x = ['HEAD']) или: (x = ['TAIL'])) ложь: { Выход написать: ['FAIL']. }.
}.
Выход написать: ['DONE'].

