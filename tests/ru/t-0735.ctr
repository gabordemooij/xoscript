Server init.
>> a := Blob новый: 4.
a байта: ( Список новый ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob новый: 4.
b байта: ( Список новый ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
# унаследованный blob не получает буфер, поэтому он бесполезен
# он пройдёт ctr_accept(), но поскольку buffer ptr == null, он верн
>> c := a новый.
{ 
>> n := a ^ c.
Выход написать: ['xorred:'], стоп. 
Выход написать: n, стоп. 
} впоймать: { :e Выход написать: e, стоп. }, запуск.
a свободно.
b свободно.
