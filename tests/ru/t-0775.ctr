Выход написать: ['Тестовый объект'], стоп.
>> l := Список новый ; 1 ; ( Список новый ; (Момент новый: 1) ; (Int64 от-тексту: ['321']) ; (Список новый ; 3)).
Выход написать: l, стоп.
>> старый-адрес-спис := l прототип адрес-памяти.
l save-as: ['/tmp/a.bin'].
Выход написать: ['========== ПЕРЕЗАГРУЗКА СНИМКА:'], стоп.
>> b := Объект load-from: ['/tmp/a.bin'].
(b прототип адрес-памяти = старый-адрес-спис) истина: {
	Выход написать: ['Связь объекта восстановлена.'], стоп.
}.
Выход написать: b, стоп.
