
>> Животное := Объект новый.
Животное в: ['новый'] сделать: {
	<- сам новый init.
}.

Животное в: ['init'] сделать: {
	мой звук := ['?'].
	мой ноги  := 4.
}.

>> Собака := Животное новый.
Собака в: ['init'] сделать: {
	сам init.
	мой звук := ['лает'].
}.

Животное в: ['к-тексту'] сделать: {
	<- мой ноги к-тексту + мой звук.
}.

>> пудель := Собака новый.
Выход написать: пудель, стоп.

