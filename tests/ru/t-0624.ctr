# Этот тест проверяет, что string_fill_in не теряет свой слот (gc'ed) в режиме 4
# ссылка в world.c
>> Журнал := Объект новый.

Журнал в: ['say:'] сделать: { :str
	Выход написать: str, стоп.
}.

>> Предмет := Объект новый.

Предмет в: ['новый:'] сделать: { :id
	<- сам новый id: id.
}.

Предмет в: ['id:'] сделать: { :id
	мой id := id.
}.

Предмет в: ['id'] сделать: { <- мой id. }.


Предмет в: ['к-тексту'] сделать: {
	>> str := ['Item#~no'].
	str ~no: мой id.
	<- str.
}.


>> Print := Объект новый.

Print в: ['items'] сделать: { 
	
	мой предмет := Предмет новый: 1.
	
	# здесь либо segfault, либо неверная строка
	Журнал say: (
		['~item printed.'] ~item: мой предмет
	).
	
	
}.

Print items.