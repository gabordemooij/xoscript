>> x := Объект новый.
>> y := Объект новый.
>> z := x.
Выход написать: (x = z), стоп.
Выход написать: (x = y), стоп.
Выход написать: (x ≠ y), стоп.
Выход написать: (x ≠ z), стоп.
>> m := Момент новый год: 2070, месяц: 11.
>> n := m скопировать.
Выход написать: (m = n), стоп.
Выход написать: (m ≠ n), стоп.
Выход написать: (m равно: m), стоп.
Выход написать: (m равно: n), стоп.
n месяц: 12.
