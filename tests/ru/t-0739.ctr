Выход написать: ['Тестовый объект'], стоп.
>> a := Объект новый. 

a в: ['item:'] сделать: { :двоичныйПомощник
	мой двоичныйПомощник := двоичныйПомощник. 
}.

a в: ['предмет'] сделать: {
	<- мой двоичныйПомощник.
}.

a item: Bin новый.

>> старый-адрес-двоичногоПомощника := a предмет прототип адрес-памяти.
a save-as: ['/tmp/a.bin'].
Выход написать: ['========== ПЕРЕЗАГРУЗКА СНИМКА:'], стоп.

>> b := Объект load-from: ['/tmp/a.bin'].

(b предмет прототип адрес-памяти = старый-адрес-двоичногоПомощника) истина: {
	Выход написать: ['Связь объекта восстановлена.'], стоп.
}.


