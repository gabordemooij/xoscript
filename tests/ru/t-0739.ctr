Выход написать: ['Test object'], стоп.
>> a := Объект новый. 

a в: ['item:'] сделать: { :binhelper
	мой binhelper := binhelper. 
}.

a в: ['item'] сделать: { <- мой binhelper.
}.

a item: Bin новый.

>> old-binhelper-address := a item прототип адрес-памяти.
a save-as: ['/tmp/a.bin'].
Выход написать: ['========== RELOADING SNAP:'], стоп.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип адрес-памяти = old-binhelper-address) истина: {
	Выход написать: ['Object link re-attached.'], стоп.
}.


