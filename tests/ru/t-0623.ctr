

>> g  := Server новый.
>> v  := Хранилище новый.
>> ок := 0.

>> секреты := Список новый ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> пароли := секреты скопировать.
пароли каждый: { :i :p
	секреты каждый: { :n :s
		{
			>> зашифровано := v шифровать: s ключ: p.
			>> расшифровано := v расшифровать: зашифровано ключ: p.
			(расшифровано = s) истина: {
				ок добавить: 1.
			}, иначе: {
				Выход написать: ['ошибка шифрования/расшифровки: '], стоп.
				Выход написать: s, стоп.
				Выход написать: ['зашифровано: '] + зашифровано, стоп.
				Выход написать: ['расшифровано: '] + зашифровано, стоп.
				Программа конец.
			}.
		} впоймать: { :ош
			(s = [''] или: p = ['']) истина: {
				ок добавить: 1.
			}, иначе: {
				Выход написать: ош, стоп.
				Программа конец.
			}.
		}, запуск.
	}.
}.

Выход написать: ( ок + [' шифрований сейфа проверено.'] ), стоп.