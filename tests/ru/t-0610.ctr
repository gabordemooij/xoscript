
>> Rectangle := Объект новый.

Rectangle в: ['area'] сделать: { <- мой длина * мой width.
}.

Rectangle в: ['length:'] сделать: { :длина
	мой длина := длина.
}.

Rectangle в: ['width:'] сделать: { :width
	мой width := width.
}.

Rectangle в: ['новый'] сделать: {
	# this will not result into an infinite loop
	>> rectangle := сам новый.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle новый.
Выход написать: a area, стоп. #0

>> b := Rectangle новый length: 2, width: 3.
Выход написать: b area, стоп. #6

