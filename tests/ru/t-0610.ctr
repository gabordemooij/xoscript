
>> Прямоугольник := Объект новый.

Прямоугольник в: ['площадь'] сделать: {
	<- мой длина * мой ширина.
}.

Прямоугольник в: ['length:'] сделать: { :длина
	мой длина := длина.
}.

Прямоугольник в: ['width:'] сделать: { :ширина
	мой ширина := ширина.
}.

Прямоугольник в: ['новый'] сделать: {
	# это не приведёт к бесконечному циклу
	>> прямоугольник := сам новый.
	прямоугольник length: 0, width: 0.
	<- прямоугольник.
}.

>> a := Прямоугольник новый.
Выход написать: a площадь, стоп. #0

>> b := Прямоугольник новый length: 2, width: 3.
Выход написать: b площадь, стоп. #6

