#Linux
>> OS := Программа Системная-команда: (Командование uname -s), сократить.

>> Slurp := Объект новый.
Slurp в: ['новый'] сделать: {
	мой str := [''].
}.
Slurp в: ['ответить:'] сделать: { :blah
		(мой str ≠ ['']) истина: {
			мой str добавить-в-конец: [' '].
		}.
		мой str добавить-в-конец: blah.
}.
Slurp в: ['ответить:и:'] сделать: { :blah :blahah
		(мой str ≠ ['']) истина: {
			мой str добавить-в-конец: [' '].
		}.
		(blah длина > 1) истина: {
			мой str добавить-в-конец: (blah от: 0 длина: (blah длина - 1)).
		}, иначе: {
			мой str добавить-в-конец: blah.
		}.
		мой str добавить-в-конец: [' '].
		мой str добавить-в-конец: blahah.
}.
Slurp в: ['obtain'] сделать: {
	>> buffer := мой str.
	мой str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text добавить-в-конец: ['hello'].
} × 1000.


Выход написать: (
	Программа Системная-команда: (
		Slurp новый
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

