

# create a 64-bit integer for exact calculations
>> a := Int64 от-тексту: ['123'].

# to string
Выход написать: a, стоп.

# divide
Выход написать: a / (Int64 от-тексту: ['3']), стоп.

# multiply
Выход написать: a * (Int64 от-тексту: ['2']), стоп.

# add
Выход написать: a + (Int64 от-тексту: ['1']), стоп.

# subtract
Выход написать: a - (Int64 от-тексту: ['2']), стоп.

# compare
Выход написать: ( a =   (Int64 от-тексту: ['123'])), стоп.
Выход написать: ( a !=: (Int64 от-тексту: ['124'])), стоп.
Выход написать: ( a <   (Int64 от-тексту: ['124'])), стоп.
Выход написать: ( a >   (Int64 от-тексту: ['122'])), стоп.
Выход написать: ( a >=: (Int64 от-тексту: ['123'])), стоп.
Выход написать: ( a <=: (Int64 от-тексту: ['123'])), стоп.





	