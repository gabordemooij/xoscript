

Программа уборка.


>> Овощ := Объект новый.
Овощ в: ['новый'] сделать: {
	>> v := сам новый.
	v init. <- v.
}.

Овощ в: ['init'] сделать: { мой овощи := 0. }.

Овощ в: ['carrots:'] сделать: { :a мой овощи := a. <- Пустой. }.
Овощ в: ['морковь'] сделать: { <- мой овощи. }.
Овощ в: ['+'] сделать: { :f
	>> n := Овощ новый.
	n carrots: (f морковь + мой овощи). <- n.
}.

Овощ в: ['к-тексту'] сделать: { <- мой овощи к-тексту.
}.

Число в: ['морковь'] сделать: {
	>> x := Овощ новый.
	x carrots: сам. <- x.
}.

Число в: ['сложить:и:'] сделать: { :a :b <- (a + b).
}.

>> q := 0 сложить: (3 морковь + 2 морковь) и: 4 морковь.
Выход написать: q, стоп.
