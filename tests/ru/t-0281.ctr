>> q := Список ← 1 ; 2 ; 3.
{ q ? ['1']. } впоймать: { Выход написать: ['поймано!'], стоп. }, запуск.
{ q ? Истина. } впоймать: { Выход написать: ['поймано!'], стоп. }, запуск.
{ q ? Ложь. } впоймать: { Выход написать: ['поймано!'], стоп. }, запуск.
{ q ? Пустой. } впоймать: { Выход написать: ['поймано!'], стоп. }, запуск.
{ q ? (Список новый). } впоймать: { Выход написать: ['поймано!'], стоп. }, запуск.
{ q ? (Объект новый). } впоймать: { Выход написать: ['поймано!'], стоп. }, запуск.
{ q ? ({ ['Пусто']. }). } впоймать: { Выход написать: ['поймано!'], стоп. }, запуск.
Выход написать: ['всех поймали'], стоп.
