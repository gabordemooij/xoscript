>> q := Список ← 1 ; 2 ; 3.
{ q ? ['1']. } впоймать: { Выход написать: ['caught!'], стоп. }, запуск.
{ q ? Истина. } впоймать: { Выход написать: ['caught!'], стоп. }, запуск.
{ q ? Ложь. } впоймать: { Выход написать: ['caught!'], стоп. }, запуск.
{ q ? Пустой. } впоймать: { Выход написать: ['caught!'], стоп. }, запуск.
{ q ? (Список новый). } впоймать: { Выход написать: ['caught!'], стоп. }, запуск.
{ q ? (Объект новый). } впоймать: { Выход написать: ['caught!'], стоп. }, запуск.
{ q ? ({ ['Empty']. }). } впоймать: { Выход написать: ['caught!'], стоп. }, запуск.
Выход написать: ['caught them all'], стоп.
