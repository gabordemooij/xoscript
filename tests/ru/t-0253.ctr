#Linux
>> ОС := Программа конфигурация: ['ОС'].

>> часы := Момент новый.
	
(ОС = ['Haiku']) истина: {
	часы часовая-зона: ['CET'],
	год: 2017, месяц: 7, день: 13,
	час: 18, минут: 0, секунд: 0.
}, иначе: {
	часы часовая-зона: ['Europe/Amsterdam'],
	год: 2017, месяц: 7, день: 13,
	час: 18, минут: 0, секунд: 0.
}.

часы в: ['сообщить'] сделать: {
	Выход написать: сам, стоп.
}.


часы добавить: 2    час, сообщить.
часы добавить: 1    час, сообщить.
часы добавить: 19 минут, сообщить.
