>> a := ['hello'].
>> b := ['hello'].
>> z := a.
>> c := Пустой.
>> q := Объект новый.
>> p := q.
(a равно: a) истина: { Выход написать: ['Y1']. }.
(a равно: b) истина: { Выход написать: ['Y2']. }.
(a равно: c) истина: { Выход написать: ['Y3']. }.
(a равно: z) истина: { Выход написать: ['Y4']. }.
(z равно: a) истина: { Выход написать: ['Y5']. }.
(q равно: q) истина: { Выход написать: ['Y6']. }.
(p равно: q) истина: { Выход написать: ['Y7']. }.
(p равно: a) истина: { Выход написать: ['Y8']. }.
(p равно: Пустой) истина: { Выход написать: ['Y9']. }.
