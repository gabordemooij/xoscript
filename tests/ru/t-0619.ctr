>> HTML := Объект новый.
HTML в: ['ответить:'] сделать: { :тег 
	Выход написать: (['<tag>'] tag: тег), стоп.
}.
HTML в: ['ответить:и:'] сделать: { :тег :html 
	Выход написать: (
		['<tag>innerHTML</tag>']
		tag: тег - [':'],
		innerHTML: html
	), стоп.
}.
>> html := HTML новый.
html body h1: ['header'].

