>> HTML := Объект новый.
HTML в: ['ответить:'] сделать: { :tag 
	Выход написать: (['<tag>'] tag: tag), стоп.
}.
HTML в: ['ответить:и:'] сделать: { :tag :html 
	Выход написать: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), стоп.
}.
>> html := HTML новый.
html body h1: ['header'].

