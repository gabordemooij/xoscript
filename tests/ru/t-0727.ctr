Server init.
>> f := Формат новый: ['%d'].
>> a := Blob новый: 4.
a байта: ( Список новый ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob новый: 4.
b байта: ( Список новый ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a от: 0 длина: 3, каждый: { :i :байта
	Выход написать: ( f применить-int: байта ) , стоп.
}.
a ^ b.
a от: 0 длина: 3, каждый: { :i :байта
	Выход написать: ( f применить-int: байта ) , стоп.
}.
a ^ b.
a от: 0 длина: 3, каждый: { :i :байта
	Выход написать: ( f применить-int: байта ) , стоп.
}.
a свободно.
b свободно.

{ a ^ Объект. } впоймать: { :e Выход написать: e, стоп. }, запуск.
