# незакрытая кавычка должна давать ошибку, а не бесконечный цикл
>> путь := ['/tmp/test0821.csv'].
>> file := Файл новый: путь.

file написать: ['a,b\n"1,2\n'].
{
	file разделитель: [','] кавычки: ['"'] строки: { :line
		Выход написать: line, стоп.
	}.
} впоймать: { :e Выход написать: e, стоп. }, запуск.

# закрытая кавычка по-прежнему работает
file написать: ['a,b\n"1,2",3'].
file разделитель: [','] кавычки: ['"'] строки: { :line
	Выход написать: line, стоп.
}.
file удалить.
