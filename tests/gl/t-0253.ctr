#Linux
>> OS := Programa configuración: ['OS'].

>> clock := Momento novo.
	
(OS = ['Haiku']) certo: {
	clock zona: ['CET'],
	ano: 2017, mes: 7, día: 13,
	hora: 18, minuto: 0, segundo: 0.
}, senón: {
	clock zona: ['Europe/Amsterdam'],
	ano: 2017, mes: 7, día: 13,
	hora: 18, minuto: 0, segundo: 0.
}.

clock en: ['tell'] facer: {
	Saída escribir: eu, salto-de-liña.
}.


clock sumar: 2    hora, tell.
clock sumar: 1    hora, tell.
clock sumar: 19 minuto, tell.
clock sumar: 1  minuto, tell.
clock sumar: 1  minuto, tell.
clock sumar: 19 segundo, tell.
clock sumar: 1  segundo, tell.
clock sumar: 1  segundo, tell.
clock sumar: 2    ano, tell.
clock sumar: 1    ano, tell.

(OS = ['Haiku']) certo: {
clock sumar: 5   mes.
clock zona: ['CEST'], tell.
}, senón: {
	clock sumar: 5   mes, tell.
}.

clock sumar: 1   mes, tell.
clock sumar: 19    día, tell.
clock sumar: 1    hora, tell.
clock sumar: 120  yard, tell.
