
>> dictionary := (
	Dicionario novo
		poñer: ['b'] en: ['a'],
		poñer: ['a'] en: ['b'],
		poñer: ['z'] en: ['x'],
		poñer: ['hello'] en: ['hallo'],
		poñer: ['human'] en: ['human']
).

>> comparisons := Lista novo.
dictionary cada: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a comparar: b)
	).
}.

comparisons ordenar: { :a :b <- ( a comparar: b ). }.
Saída escribir: ( comparisons unir: ['↵'] ), salto-de-liña.
comparisons unir: ['↵'].
