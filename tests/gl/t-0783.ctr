Saída escribir: ['Test object'], salto-de-liña.
>> a := Obxecto novo. 

a en: ['item:'] facer: { :moment
	propio moment := moment. 
}.

a en: ['item'] facer: { <- propio moment.
}.

>> today := Momento novo zona: ['CEST'], ano: 2026, mes: 7.
a item: today.
Saída escribir: a item, salto-de-liña.
a save-as: ['/tmp/a.bin'].

