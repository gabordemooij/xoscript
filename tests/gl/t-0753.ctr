Saída escribir: ['Test object'], salto-de-liña.
>> a := Obxecto novo. 

a en: ['item:'] facer: { :fmt
	propio fmt := fmt. 
}.

a en: ['item'] facer: { <- propio fmt.
}.

a item: ( Formato novo: ['|%s|'] ).

Saída escribir: a item, salto-de-liña.

>> old-fmt-address := a item prototipo enderezo-de-memoria.
a save-as: ['/tmp/a.bin'].
Saída escribir: ['========== RELOADING SNAP:'], salto-de-liña.

>> b := Obxecto load-from: ['/tmp/a.bin'].

(b item prototipo enderezo-de-memoria = old-fmt-address) certo: {
	Saída escribir: ['Object link re-attached.'], salto-de-liña.
}.

Saída escribir: ( b item aplicar: ['hello'] ), salto-de-liña.
