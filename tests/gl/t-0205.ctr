>> str := ['write:'].
Saída mensaxe: ['escribir:'] argumentos: (Lista ← ['Hello World']), salto-de-liña. 

Número en: ['isbetween:and:'] facer: { :a :b <- ((eu ≥ a) e: (eu ≤ b)).
}.

str := ['isbetween:and:'].
Saída escribir: (3 mensaxe: str argumentos: (Lista ← 2 ; 8)), salto-de-liña.
Saída escribir: (3 mensaxe: str argumentos: (Lista ← 1 ; 2)), salto-de-liña.


>> CoffeeMachine := Obxecto novo.
CoffeeMachine en: ['makeCoffeeWithSugar:milk:'] facer: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Lista ← 4 ; 2.
Saída escribir: ( CoffeeMachine mensaxe: order argumentos: coffeeConfiguration ), salto-de-liña.
