Server init.
>> fmt := Formato novo: ['%#3x'].

>> blob := Blob novo: 4.
blob bytes: ( 
	Lista novo ; 0 ; 1 ; 2 ; 3
).

>> file := Ficheiro novo: ['/tmp/blob'].
file blob: blob.
blob liberar.

>> ler := file blob.
ler 
de: 0 
lonxitude: 4, 
facer cada: { :i :b 
	Saída
	escribir: (fmt aplicar-enteiro: b),
	salto-de-liña.
}.
ler liberar.
