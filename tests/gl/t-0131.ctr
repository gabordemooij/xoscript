
>> a := Lista ← (Lista ← 100 ; 200 ; 300) ; (Lista ← 9 ; 8 ; 7).
Saída escribir: ['at 0,1 :'].
Saída escribir: a ? 0 ? 1, salto-de-liña. 
Saída escribir: ['at 1,2 :'].
Saída escribir: a ? 1 ? 2, salto-de-liña. 
>> menu := Dicionario novo.
menu poñer: (Lista ← ['pizza'] ; ['spaghetti']) en: ['Italian Cuisine'].
menu poñer: (Lista ← ['bifteki'] ; ['suflaki']) en: ['Greek Cuisine'].
Saída escribir: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), salto-de-liña. 
Saída escribir: ['but not on the same plate.'], salto-de-liña.
