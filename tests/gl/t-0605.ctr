>> invoice := Obxecto novo.
invoice en: ['iniciar'] facer: {
        propio número := 0.
}.

invoice en: ['número'] facer: {
        propio número sumar: 1. <- propio número copiar.
}.

>> year-invoice := invoice novo.
year-invoice en: ['start:'] facer: { :ano
	propio número := ano.
}.

year-invoice start: 202000.
Saída escribir: year-invoice número, salto-de-liña.
