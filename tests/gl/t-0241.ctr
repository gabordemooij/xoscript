

Texto en: ['evaluate'] facer: {
	>> código := Ficheiro novo: ['/tmp/eval.ctr'].
	código escribir: (eu texto + ['.']).
	Programa usar: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Lista ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q texto.
Saída escribir: x, salto-de-liña.
>> y := Nada.
(['y := '] + x ) evaluate.
Saída escribir: y ? 0, salto-de-liña.

q := Dicionario poñer: ['\[''] en: ['\['quote\']'].
x := q texto.
Saída escribir: x, salto-de-liña.
y := Nada.
(['y := '] + x ) evaluate.

>> q := (Dicionario novo) poñer:['\[''] en:['\['quote\[''].
Saída escribir: y ? ['\['quote\']'], salto-de-liña.
