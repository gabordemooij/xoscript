>> Animal := Obxecto novo.
Animal en: ['make'] facer: {
	>> animal := Obxecto novo.
	animal en: ['makeSound'] facer: {
		Saída escribir: propio sound.
	}. <- animal.
}.
>> Cat := Obxecto novo.
Cat en: ['make'] facer: {
	>> cat := Animal make.
	cat en: ['init'] facer: {
		propio sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
