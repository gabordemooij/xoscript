Server init.

>> db := Maria-DB novo anfitrión: ['localhost'],
	usuario: ['xo'],
	contrasinal: ['pass123'],
	nome-base: ['xobase'],
	conectar.

>> del := db consulta: ['DELETE FROM book WHERE id > 0'].
{  del executar. db confirmar. } capturar: { :e db desfacer.  }, iniciar.

>> contar := db consulta: ['SELECT COUNT(*) AS num FROM book'].
contar obter: { :row Saída escribir: row num, salto-de-liña. }.
