#Linux
>> Slurp := Obxecto novo.

Slurp en: ['novo'] facer: {
	propio str := [''].
}.

Slurp en: ['nieuw'] facer: {
	propio str := [''].
}.

Slurp en: ['responder:'] facer: { :blah
		propio str engadir-ao-final: blah.
}.

Slurp en: ['responder:e:'] facer: { :blah :blahah
		propio str engadir-ao-final: (blah de: 0 lonxitude: (blah lonxitude - 1)).
		propio str engadir-ao-final: [' '].
		propio str engadir-ao-final: blahah.
}.

Slurp en: ['obtain'] facer: {
	>> buffer := propio str.
	propio str := ['']. <- buffer.
}.


Saída escribir: (Programa sistema: (Slurp novo echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Ficheiro novo: ['/tmp/from.txt'], eliminar. } capturar: { ['Empty']. }, iniciar.
{ Ficheiro novo: ['/tmp/to.txt'], eliminar. } capturar: { ['Empty']. }, iniciar.


Ficheiro novo: ['/tmp/to.txt'], existe falso: {
	Saída escribir: ['Confirmed. Target file does not exist.\
'].
}.
Ficheiro novo: ['/tmp/from.txt'], existe falso: {
	Saída escribir: ['Confirmed. Source file does not exist.\
'].
}.



Programa sistema: (Slurp novo touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Programa sistema: (Slurp novo cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Ficheiro novo: ['/tmp/to.txt'], existe certo: {
	Saída escribir: ['Confirmed. Target file has been created by shell.\
'].
}.


Saída escribir: ['Contents of file is:'] + (Ficheiro novo: ['/tmp/to.txt'], ler), salto-de-liña.
