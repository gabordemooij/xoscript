
>> shop := (Dicionario novo
	poñer: ['magazine'] en: ['books'],
	poñer: ['computer'] en: ['electronics'],
	poñer: ['lipstick'] en: ['cosmetics']
).
Saída escribir: (shop ten: ['computer']), salto-de-liña. 
Saída escribir: (shop ten: ['sausage']), salto-de-liña. 
Saída escribir: (shop ten: ['computers']), salto-de-liña. 
Saída escribir: (shop ten: ['compute']), salto-de-liña. 
Saída escribir: (shop ten: ['2computer']), salto-de-liña. 
