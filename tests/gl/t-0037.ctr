>> a := 3.
>> b := a copiar.
a restar: 1.
Saída escribir: [' a = '] + a.
Saída escribir: [' b = '] + b.
a := 3.
b := a + 4.
Saída escribir: [' a = '] + a.
Saída escribir: [' b = '] + b.
>> x := 3.
>> y := x copiar.
x sumar: 10.
y restar: 1.
Saída escribir: [' x = '] + x.
Saída escribir: [' y = '] + y.
>> q := Obxecto novo.
q en: ['setProperty:'] facer: { :x
	propio prop := x.
}.
q en: ['getProperty'] facer: { <- propio prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Saída escribir: [' p = '] + (p getProperty).
