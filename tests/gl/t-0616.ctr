Lista en: ['copiar'] facer: {
	>> copiar := Lista novo.
	eu cada: { :número :section
		copiar engadir-ao-final: section recursivo copiar.
	}. <- copiar.
}.

>> sheep := Lista novo ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep copiar.
clones cada: { :número :sheep
	sheep engadir-ao-final: ['2'].
}.

Saída escribir: sheep, salto-de-liña.
Saída escribir: clones, salto-de-liña.
