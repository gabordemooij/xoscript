# Can we use UTF8 in regex?
Server init.
>> p := Patrón novo: ['\\w'].
Saída escribir: ( p coincidencia: ['x'] ), salto-de-liña.
Saída escribir: ( p coincidencia: ['é'] ), salto-de-liña.
>> p := Patrón novo: ['(*UTF)(*UCP)\\w'].
Saída escribir: ( p coincidencia: ['é'] ), salto-de-liña.
# should give 101