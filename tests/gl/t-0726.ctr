# test buffers PKI/Sign 
Server init.

>> long := ( Lista novo encher: 1000 con: ['a'] ) unir: [''].

# sign a message
Saída escribir: ( 
	Caixa-forte asinar: ['abc'] con: long
), salto-de-liña.

Saída escribir: ( 
	Caixa-forte
		comprobar: ['abc'] 
		sinatura: long 
		con: long
), salto-de-liña.

Saída escribir: (
	Caixa-forte resumo-contrasinal: long verificar: long
), salto-de-liña.
