
Saída escribir: ['Break for-loop, 0-4.'], salto-de-liña.
{ :i
	Saída escribir: ['iteration #'] + i, salto-de-liña.
	(i = 4) interromper.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Saída escribir: ['Break while-true loop, 0-4.'], salto-de-liña.
{
	Saída escribir: ['iteration #'] + x, salto-de-liña.
	x sumar: 1.
	((x < 5) non) interromper.
} mentres: xIsLessThan10.

Saída escribir: ['Break while-false loop, 5,4.'], salto-de-liña.
{
	Saída escribir: ['iteration #'] + x, salto-de-liña.
	x restar: 1.
	(x = 3) interromper.
} mentres: { <- (x > 0). }.

Saída escribir: ['Break times loop, 1-4.'], salto-de-liña.
{ :i
	Saída escribir: ['iteration #'] + i, salto-de-liña.
	(i = 4) interromper.
} × 5.

Saída escribir: ['Break block, dont print line.'], salto-de-liña.
{ Certo interromper. Saída escribir: ['dont write this!'], salto-de-liña. } iniciar.

Saída escribir: ['Break block, dont fire catch...'], salto-de-liña.
{ Certo interromper. Saída escribir: ['dont write this!'], salto-de-liña. } capturar: { Saída escribir: ['Dont catch this!']. }, iniciar.

Saída escribir: ['Test Array each-loop: 0,1'], salto-de-liña.
(Lista ← 1 ; 2 ; 3) transformar: { :i
	Saída escribir: ['iteration #'] + i, salto-de-liña.
	(i = 1) interromper.
}.

Saída escribir: ['Test Map each-loop: c only'], salto-de-liña.
>> m := Dicionario novo.
m poñer: ['first'] en: ['a'], poñer: ['second'] en: ['b'], poñer: ['third'] en: ['c'].
m cada: { :k :v
	Saída escribir: ['iteration'] + v + k, salto-de-liña.
	Certo interromper.
}.

