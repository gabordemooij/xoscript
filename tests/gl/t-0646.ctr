Server init.
Saída escribir: ['Database datetime test'], salto-de-liña.

>> db := Maria-DB novo anfitrión: ['localhost'],
	usuario: ['xo'], 
	contrasinal: ['pass123'],
	nome-base: ['xobase'],
	conectar.

>> parámetros-de-busca :=
db consulta: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
obter: { :row
	Saída escribir: row datetimetest, salto-de-liña.
}.
