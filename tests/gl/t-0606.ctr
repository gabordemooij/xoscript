>> Point := Obxecto novo.
Point en: ['x-coordinate:'] facer: { :x propio x := x. }.
Point en: ['y-coordinate:'] facer: { :y propio y := y. }.
Point en: ['x-coordinate']  facer: { <- propio x copiar. }.
Point en: ['y-coordinate']  facer: { <- propio y copiar. }.

Point en: ['='] facer: { :other <- ( propio x = other x-coordinate
		 e: propio y = other y-coordinate ).
}.

>> pier := Point novo x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point novo x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point novo x-coordinate: 5, y-coordinate: 6.

Saída escribir: pier = town-hall, salto-de-liña.
Saída escribir: pier = restaurant, salto-de-liña.
