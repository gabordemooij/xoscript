Programa xestión-memoria: 0.
Lista en: ['sum'] facer: {
	>> total := 0.
	eu cada: { :index :element
		total sumar: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Ficheiro novo: ['/tmp/test.txt'].
f escribir: ['Lorem Ipsum'].
f pechar.
  

f := Ficheiro novo: ['/tmp/test.txt'].
>> text := f ler.
f pechar.



Programa limpar.
usedMemory1 := (Programa memoria ? 1).



f := Ficheiro novo: ['/tmp/test.txt'].
text := f ler.
f pechar.

Programa limpar.
usedMemory2 := (Programa memoria ? 1).


f := Ficheiro novo: ['/tmp/test.txt'].
text := f ler.
f pechar.

Programa limpar.
usedMemory3 := (Programa memoria ? 1).



( usedMemory1 = usedMemory2 e: usedMemory1 = usedMemory3, e: usedMemory2 = usedMemory3 ) certo: {
	Saída escribir: ['No memory leaks here'].
}, falso: {
	Saída escribir: ['Leaking memory...'].
}.
