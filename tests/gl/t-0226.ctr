# Test ASCII variants

# Numbers

Saída escribir: (2 !=: 3), salto-de-liña.
Saída escribir: (2 <=: 2), salto-de-liña.
Saída escribir: (2 >=: 2), salto-de-liña.

# Strings

Saída escribir: (['b'] >=: ['a']), salto-de-liña.
Saída escribir: (['b'] !=: ['a']), salto-de-liña.
Saída escribir: (['b'] <=: ['c']), salto-de-liña.

# Bools

Saída escribir: (Certo !=: Falso), salto-de-liña.

# Objects

Saída escribir: (Obxecto novo !=: Obxecto novo), salto-de-liña.

# ASCII list symbol <-:

Saída escribir: (Lista <<: 1, ; 2 ; 3) contar = 3, salto-de-liña.

