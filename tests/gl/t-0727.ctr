Server init.
>> f := Formato novo: ['%d'].
>> a := Blob novo: 4.
a bytes: ( Lista novo ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob novo: 4.
b bytes: ( Lista novo ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a de: 0 lonxitude: 3, cada: { :i :byte
	Saída escribir: ( f aplicar-enteiro: byte ), salto-de-liña.
}.
a ^ b.
a de: 0 lonxitude: 3, cada: { :i :byte
	Saída escribir: ( f aplicar-enteiro: byte ), salto-de-liña.
}.
a ^ b.
a de: 0 lonxitude: 3, cada: { :i :byte
	Saída escribir: ( f aplicar-enteiro: byte ), salto-de-liña.
}.
a liberar.
b liberar.

{ a ^ Obxecto. } capturar: { :e Saída escribir: e, salto-de-liña. }, iniciar.
