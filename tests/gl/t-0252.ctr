#Linux
>> clock := Momento novo.
clock zona: ['UTC-1'].
clock ano: 1981, mes: 1, día: 5,
      hora: 13, minuto: 15, segundo: 13.

Saída escribir: clock, salto-de-liña.
clock zona: ['UTC+0'].

Saída escribir: (
	(clock ano simple) + ['-'] + (clock mes) + ['-'] + (clock día) + [' '] +
	(clock hora) + [':'] + (clock minuto) + [':'] + (clock segundo) + [' '] +
	['W'] + (clock semana) + (clock zona)
), salto-de-liña.


clock zona: ['UTC-1'].
Saída escribir: (
	(clock ano simple) + ['-'] + (clock mes) + ['-'] + (clock día) + [' '] +
	(clock hora) + [':'] + (clock minuto) + [':'] + (clock segundo) + [' '] +
	['W'] + (clock semana) + (clock zona)
), salto-de-liña.
