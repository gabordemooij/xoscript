

Lista en: ['fixture:'] facer: { :f
	propio fixture := f.
}.

Lista en: ['contar'] facer: { <- propio fixture.
}.

Lista en: ['aantal'] facer: { <- propio fixture.
}.


>> x := Nada.
{

	x := ['hello'] 
	substituír:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] carácter: 2)
			)
		)
	por: (
		(['...hal'] + ['lo']) 
			maiúsculas 
			lowecase 
			maiúsculas 
			desprazamento: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Lista ← 0 ; 1 ; 4; 9 ; (Lista ← 0 ; 3; 1) ; 4
							) penúltimo
						) ? 1
					) + 
					((Lista ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					contar
				)
			)
	).

} × 10.
Saída escribir: x, salto-de-liña.

