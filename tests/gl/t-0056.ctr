>> z := Obxecto novo.
z en: ['value:'] facer: { :v
	propio value := v. <- eu.
}.
z en: ['value'] facer: { <- propio value. }.
(z setValue: 1) value: 2.
Saída escribir: z value.
>> x := z.
Saída escribir: x value.
z := Nada.
Saída escribir: z value.
Saída escribir: x value.
Saída escribir: ['hello'].
