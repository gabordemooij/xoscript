

Lista en: ['sum'] facer: {
	>> total := 0.
	eu cada: { :index :element
		total sumar: element.
	}. <- total.
}.

Lista en: ['product'] facer: {
	>> total := 1.
	eu cada: { :index :element
		total multiplicar-por: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa xestión-memoria: 0.

{

>> a := Lista ← ['hello'] ; ['world'] ; Certo ; Nada ; 666.
a := a + ( Lista ← 1 ).
Saída escribir: ( ['sum: '] + ( a sum ) ), salto-de-liña.
Saída escribir: ( ['min: '] + ( a mínimo ) ), salto-de-liña.
Saída escribir: ( ['max: '] + ( a máximo ) ), salto-de-liña.
Saída escribir: ( ['3rd: '] + ( a ? 2 ) ), salto-de-liña.
Saída escribir: ( ['prd: '] + ( a product ) ), salto-de-liña.
a ordenar: { :a :b <- (b - a). }.
a cada: { :i :e Saída escribir: ( i - 0 ), salto-de-liña. }.

} iniciar.

Programa limpar.
usedMemory1 := (Programa memoria ? 0).


{

>> a := Lista ← ['hello'] ; ['world'] ; Certo ; Nada ; 666.
a := a + ( Lista ← 1 ).
Saída escribir: ( ['sum: '] + ( a sum ) ), salto-de-liña.
Saída escribir: ( ['min: '] + ( a mínimo ) ), salto-de-liña.
Saída escribir: ( ['max: '] + ( a máximo ) ), salto-de-liña.
Saída escribir: ( ['3rd: '] + ( a ? 2 ) ), salto-de-liña.
Saída escribir: ( ['prd: '] + ( a product ) ), salto-de-liña.
a ordenar: { :a :b <- (b - a). }.
a cada: { :i :e Saída escribir: ( i - 0 ), salto-de-liña. }.

} iniciar.



Programa limpar.
usedMemory2 := (Programa memoria ? 0).


{

>> a := Lista ← ['hello'] ; ['world'] ; Certo ; Nada ; 666.
a := a + ( Lista ← 1 ).
Saída escribir: ( ['sum: '] + ( a sum ) ), salto-de-liña.
Saída escribir: ( ['min: '] + ( a mínimo ) ), salto-de-liña.
Saída escribir: ( ['max: '] + ( a máximo ) ), salto-de-liña.
Saída escribir: ( ['3rd: '] + ( a ? 2 ) ), salto-de-liña.
Saída escribir: ( ['prd: '] + ( a product ) ), salto-de-liña.
a ordenar: { :a :b <- (b - a). }.
a cada: { :i :e Saída escribir: ( i - 0 ), salto-de-liña. }.

} iniciar.



Programa limpar.
usedMemory3 := (Programa memoria ? 0).

( usedMemory1 = usedMemory2 e: usedMemory1 = usedMemory3, e: usedMemory2 = usedMemory3 ) certo: {
	Saída escribir: ['No memory leaks here'].
}, falso: {
	Saída escribir: ['Leaking memory...'].
}.
