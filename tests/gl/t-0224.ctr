
>> countries := Lista novo
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Lista novo
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods por: countries, cada: { :key :value
	counter sumar: 1.
}.

Saída escribir: (['we serve counter dishes'] counter: counter), salto-de-liña.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] caracteres ordenar: { :v
	counter sumar: 0.
}.

Saída escribir: (['we sort counter dishes'] counter: counter), salto-de-liña.


>> counter := 0.
{
	{
		counter sumar: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Saída escribir: (['we calculate counter numbers.'] counter: counter), salto-de-liña.

