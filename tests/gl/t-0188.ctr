

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa xestión-memoria: 0.

{ :i Saída escribir: i. } × 4.
Saída salto-de-liña.
{ :i Saída escribir: (4 - i). } × 4.
Saída salto-de-liña.
( 1 > 2 ) falso: { Saída escribir: ['BLOCK 1'], salto-de-liña. }.
( 2 > 1 ) certo:  { Saída escribir: ['BLOCK 2'], salto-de-liña. }.

>> i := 0.
{ Saída escribir: i. i sumar: 1. } mentres: { <- ( i < 3). }.
Saída salto-de-liña.

i := 3.
{ Saída escribir: i. i := i - 1. } mentres: { <- ( i > 0). }.
Saída salto-de-liña.


Programa limpar.

usedMemory1 := (Programa memoria ? 0).


{ :i  Saída escribir: i. } × 4.
Saída salto-de-liña.
{ :i  Saída escribir: (4 - i). } × 4.
Saída salto-de-liña.
( 1 > 2 ) falso: { Saída escribir: ['BLOCK 1'], salto-de-liña. }.
( 2 > 1 ) certo:  { Saída escribir: ['BLOCK 2'], salto-de-liña. }.

>> i := 0.
{ Saída escribir: i. i sumar: 1. } mentres: { <- ( i < 3). }.
Saída salto-de-liña.

i := 3.
{ Saída escribir: i. i := i - 1. } mentres: { <- ( i > 0). }.
Saída salto-de-liña.



Programa limpar.
usedMemory2 := (Programa memoria ? 0).


{ :i Saída escribir: i. } × 4.
Saída salto-de-liña.
{ :i Saída escribir: (4 - i). } × 4.
Saída salto-de-liña.
( 1 > 2 ) falso: { Saída escribir: ['BLOCK 1'], salto-de-liña. }.
( 2 > 1 ) certo:  { Saída escribir: ['BLOCK 2'], salto-de-liña. }.

>> i := 0.
{ Saída escribir: i. i sumar: 1. } mentres: { <- ( i < 3). }.
Saída salto-de-liña.

i := 3.
{ Saída escribir: i. i := i - 1. } mentres: { <- ( i > 0). }.
Saída salto-de-liña.

Programa limpar.
usedMemory3 := (Programa memoria ? 0).



( usedMemory1 = usedMemory2 e: usedMemory1 = usedMemory3, e: usedMemory2 = usedMemory3 ) certo: {
	Saída escribir: ['No memory leaks here'].
}, falso: {
	Saída escribir: ['Leaking memory...'].
}.
