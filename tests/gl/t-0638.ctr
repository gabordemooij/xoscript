
Server init.
>> rq := Petición-HTTP novo.
Saída escribir: ['HTTP-GET d[]=']  + ( rq get-lista: ['d[]'] ), salto-de-liña. # GET
Saída escribir: ['HTTP-GET f[]=']  + ( rq get-lista: ['f[]'] ), salto-de-liña. # GET
Saída escribir: ['HTTP-POST e[]='] + ( rq post-lista: ['e[]'] ), salto-de-liña. # GET
Saída escribir: ['HTTP-POST c=']   + ( rq post: ['c'] ), salto-de-liña. # GET
Saída escribir: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), salto-de-liña. # GET
