# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Patrón novo: pattern.
	p coincidencia: subject facer: { :m :g
		Saída escribir: g contar, escribir: [' '], escribir: (g unir: ['|']), salto-de-liña. <- m.
	}.
}.
show aplicar: ['(a)|(b)'] e: ['b'].
show aplicar: ['(a)|(b)'] e: ['a'].
show aplicar: ['(x)?y'] e: ['y'].
show aplicar: ['(x)?(y)(z)?'] e: ['xy'].
