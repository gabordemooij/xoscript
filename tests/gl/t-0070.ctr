>> numbers := ['1,2,3'] partir: [','].
Saída escribir: ['I got: '] + numbers contar + [' numbers.'],salto-de-liña.
{ :i Saída escribir: ['number #'] + i + [':'] + (numbers posición: i), salto-de-liña.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages partir: [' Or '].
Saída escribir: ['We serve'], salto-de-liña.
{ :i Saída escribir: ['->'] + (beverages posición: i), salto-de-liña. } × (beverages contar).
Saída escribir: (beverages unir: [',']), salto-de-liña.
Saída escribir: (numbers unir: ['||']).
