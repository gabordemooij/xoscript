Server init.

Saída escribir: (
	Patrón novo: ['^\\w+$'],
	coincidencia: ['test@example.com'] 
), salto-de-liña. # 0 match, fails on @ and .

Saída escribir: (
	Patrón novo: ['^[^@]+@[^\.]+\.\\w+$'],
	coincidencia: ['test@example.com'] 
), salto-de-liña. # 1 match

Saída escribir: (
	Patrón novo: ['[^@]+@[^\.]+\.\\w+'],
	coincidencia: ['test@example.com'] 
), salto-de-liña. # 1 match

Saída escribir: (
	Patrón novo: ['([^@]+)@([^\.]+)\.\\w+'],
	coincidencia: ['test@example.com'] 
), salto-de-liña. # 1 match, groups dont matter

Saída escribir: (
	Patrón novo: ['[a-z]'],
	coincidencia: ['test@example.com'] 
), salto-de-liña. # 14 matches

Saída escribir: (
	Patrón novo: ['.*'],
	coincidencia: ['test@example.com'] 
), salto-de-liña. # 1 match (all)

Saída escribir: (
	Patrón novo: ['(.*)'],
	coincidencia: ['test@example.com'] 
), salto-de-liña. # 1 match (all)

Saída escribir: (
	Patrón novo: ['\\s*[^@]+@[^\.]+\.\\w+'],
	coincidencia: ['test@example.com'] 
), salto-de-liña. # 1 match, prefix space optional, gets ignored