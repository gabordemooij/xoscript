# test catch-all methods
>> x13 := Obxecto novo.
x13 en: ['a'] facer: { :a Saída escribir: 0, salto-de-liña. }.
x13 en: ['a:'] facer: { :a Saída escribir: a, salto-de-liña. <- 5. }.
x13 en: ['a:b:'] facer: { :a :b Saída escribir: (a + b), salto-de-liña. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
