#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa xestión-memoria: 0.

{
Momento tempo.
Momento agardar: 1.
Saída escribir: Programa argumentos, salto-de-liña.
Programa argumento: 0.
Número random.
Saída escribir: (Programa sistema: ['echo 'Hello'']).
} iniciar.

Programa limpar.
usedMemory1 := (Programa memoria ? 0).

{
Momento tempo.
Momento agardar: 1.
Saída escribir: Programa argumentos, salto-de-liña.
Programa argumento: 0.
Número random.
Saída escribir: (Programa sistema: ['echo 'Hello'']).
} iniciar.

Programa limpar.
usedMemory2 := (Programa memoria ? 0).

{
Momento tempo.
Momento agardar: 1.
