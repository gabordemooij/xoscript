#Linux

 >> t := Momento novo.
 
t zona: ['Europe/Amsterdam'].
t ano: 2020, mes: 8, día: 2, hora: 21, minuto: 2, segundo: 1.

>> a := t hora.
>> ams := t zona.

t zona: ['US/Hawaii'].
>> b := t hora.
>> hw := t zona.

Saída
escribir: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		ou: ['later'] ou: ['earlier']
	)
),
salto-de-liña.
 