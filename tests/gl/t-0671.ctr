# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Caixa-forte xerar-chaves.

# private (secret) key
>> sk := keys primeiro.

# public key
>> pk := keys último.

# sign a message
>> sig := Caixa-forte asinar: ['abc'] con: sk.

# check message (ok)
Saída escribir: ( 
	Caixa-forte
		comprobar: ['abc'] 
		sinatura: sig 
		con: pk 
), salto-de-liña.

# check message (fail)
Saída escribir: ( 
	Caixa-forte 
		comprobar: ['abd'] 
		sinatura: sig 
		con: pk 
), salto-de-liña.