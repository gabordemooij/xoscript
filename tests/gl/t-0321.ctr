# test qualifiers

Programa limpar.

>> Fruit := Obxecto novo.
Fruit en: ['novo'] facer: {
	>> f := eu novo.
	f apples: 0. <- f.
}.
Fruit en: ['apples:'] facer: { :a propio apples := a. }.
Fruit en: ['apples'] facer: { <- propio apples. }.
Fruit en: ['+'] facer: { :f
	>> n := Fruit novo.
	n apples: (f apples + propio apples). <- n.
}.
Número en: ['apples'] facer: { <- ((Fruit novo) apples: eu).
}.

Fruit en: ['texto'] facer: { <- propio apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Saída escribir: q, salto-de-liña.




q := 3 apples + 4 apples.
Saída escribir: q, salto-de-liña.



