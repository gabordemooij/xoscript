Número en: ['factorial'] facer: {
	>> total := 1.
	{ :index total multiplicar-por: (eu - (index)). } × eu. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Saída escribir: a.
>> b := 2 + 3 factorial.
Saída escribir: b.
>> c := 3 factorial + 2.
Saída escribir: c.
>> d := 2 + (3 factorial).
Saída escribir: d.
Saída escribir: 2 + 3 factorial + 1.
