
Lista en: ['product'] facer: {
	>> total := 1.
	eu cada: { :index :element
		total multiplicar-por: element.
	}. <- total.
}.

>> a := Lista ← 1 ; 2 ; 3.
Saída escribir: a product, salto-de-liña.
Saída escribir: (Lista ← 2 ; 4 ; 8) product, salto-de-liña. 
Saída escribir: (Lista ← -2 ; 10) product, salto-de-liña. 
Saída escribir: (Lista ← 0.5 ; -2) product, salto-de-liña. 
