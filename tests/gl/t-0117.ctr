>> t := Certo.
(t = Certo) certo: { Saída escribir: ['T']. }.
(t = Falso) certo: { Saída escribir: ['F']. }.
Saída escribir: ['|'].
>> t := Falso.
(t = Certo) certo: { Saída escribir: ['T']. }.
(t = Falso) certo: { Saída escribir: ['F']. }.
Saída escribir: ['|'].
>> f := Certo.
(t = Certo e: f = Falso) certo: { Saída escribir: ['T']. }.
(t = Falso e: f = Certo) certo: { Saída escribir: ['F']. }.
Saída escribir: ['|'].
>> n := Nada.
(n Nada?) certo: { Saída escribir: ['T']. }.
(n Nada?) falso: { Saída escribir: ['F']. }.
Saída escribir: ['|'].
(f Boolean?) certo: { Saída escribir: ['T']. }.
(f Boolean?) falso: { Saída escribir: ['F']. }.



