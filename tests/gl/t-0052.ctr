>> items := Dicionario novo.
items poñer: ['green'] en: ['color-1'].
items poñer: ['orange'] en: ['color-2'].
items poñer: ['red'] en: ['color-3'].
>> i := 0.
>> s := [''].
items cada: { :key :color
	Saída escribir: ['color #'] + i + [' is: '] + color + [' '].
	i sumar: 1.
}.
Saída escribir: i + [' colors!'].
