# test list operations


>> cakes := Lista ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes substituír: 1 lonxitude: 2 por: ( Lista ← ['cinnamon'] ; ['pineapple'] ).
Saída escribir: (buy unir: [',']), salto-de-liña.


>> buy := cakes substituír: 1 lonxitude: 12 por: ( Lista ← ['cinnamon'] ; ['pineapple'] ).
Saída escribir: (buy unir: [',']), salto-de-liña.


>> buy := cakes substituír: 2 lonxitude: 10 por: ( Lista novo ).
Saída escribir: (buy unir: [',']), salto-de-liña.


>> buy := cakes substituír: 0 lonxitude: 1 por: ( Lista novo ).
Saída escribir: (buy unir: [',']), salto-de-liña.


>> buy := cakes substituír: ['0'] lonxitude: ['1'] por: ['x'].
Saída escribir: (buy unir: [',']), salto-de-liña.
