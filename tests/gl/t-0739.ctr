Saída escribir: ['Test object'], salto-de-liña.
>> a := Obxecto novo. 

a en: ['item:'] facer: { :binhelper
	propio binhelper := binhelper. 
}.

a en: ['item'] facer: { <- propio binhelper.
}.

a item: Bin novo.

>> old-binhelper-address := a item prototipo enderezo-de-memoria.
a save-as: ['/tmp/a.bin'].
Saída escribir: ['========== RELOADING SNAP:'], salto-de-liña.

>> b := Obxecto load-from: ['/tmp/a.bin'].

(b item prototipo enderezo-de-memoria = old-binhelper-address) certo: {
	Saída escribir: ['Object link re-attached.'], salto-de-liña.
}.


