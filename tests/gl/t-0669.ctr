# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Caixa-forte 
	resumo-contrasinal: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Caixa-forte 
	resumo-contrasinal: hash verificar: a1.
	# fail 
>> b := Caixa-forte
	resumo-contrasinal: hash verificar: a2.
	# ok!

Saída escribir: a, salto-de-liña.
Saída escribir: b, salto-de-liña.

