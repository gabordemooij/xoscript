>> x := Obxecto novo.
>> y := Obxecto novo.
>> z := x.
Saída escribir: (x = z), salto-de-liña.
Saída escribir: (x = y), salto-de-liña.
Saída escribir: (x ≠ y), salto-de-liña.
Saída escribir: (x ≠ z), salto-de-liña.
>> m := Momento novo ano: 2070, mes: 11.
>> n := m copiar.
Saída escribir: (m = n), salto-de-liña.
Saída escribir: (m ≠ n), salto-de-liña.
Saída escribir: (m igual-a: m), salto-de-liña.
Saída escribir: (m igual-a: n), salto-de-liña.
n mes: 12.
Saída escribir: (m ≠ n), salto-de-liña.
Saída escribir: (m = n), salto-de-liña.


