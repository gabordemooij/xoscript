
>> Size := Obxecto novo.
Size en: ['is:'] facer: { :número
	número en: ['+'] facer: { :número
		>> unit := número cualificador.
		>> factor := 1.
		
		unit
		caso: ['inch'] facer: { factor := 0.0833. }. <- eu + (número * factor).
	}. <- número.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Saída escribir: plank + edge, salto-de-liña.
