>> Grandfather := Obxecto novo.
Grandfather en: ['greet'] facer: {
	Saída escribir: ['Ave!'], salto-de-liña.
}.
>> Father := Grandfather novo.
Father en: ['greet'] facer: {
	Saída escribir: ['Hello'], salto-de-liña.
	eu greet.
}.
>> Son := Father novo.
Son en: ['greet'] facer: {
	Saída escribir: ['Hi'], salto-de-liña.
	eu greet.
}.

Son greet.

>> Roundabout := Obxecto novo.
Roundabout en: ['circle:'] facer: { :x
	Saída escribir: x, salto-de-liña.
	(x < 3) certo: { eu recursivo circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) certo: { Saída escribir: x, salto-de-liña. x sumar: 1.  increment iniciar. }. }.
increment iniciar.