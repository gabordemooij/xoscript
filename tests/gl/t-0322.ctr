

>> Matryoshka := Obxecto novo.
Matryoshka en: ['double:'] facer: { :secret
	propio secret := secret × 2.
}.
Matryoshka en: ['novo:'] facer: { :secret
	>> answer := Nada.
	>> t := (secret > 255).
	Saída escribir: (secret + [' | '] + t), salto-de-liña.
	t certo: {
		answer := secret.
	}, senón: {
		answer := Matryoshka recursivo novo: (eu double: secret).
	}. <- answer.
}.

>> x := Matryoshka novo: 2.
