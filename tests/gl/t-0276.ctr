>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Obxecto novo.
⚄ en: ['drawFrom:length:'] facer: { :pool :contar
	
	>> result := [''].
	
	{
		>> index := Número random % (pool lonxitude).
		result engadir-ao-final: ( pool carácter: (index + 1) ).
		
	} × contar. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? lonxitude.
Saída escribir: (['x↵'] x random lonxitude).
Saída escribir: (['y↵'] y ?? lonxitude).

