>> x := Momento novo.
x zona: ['CEST'],
ano:2017,
mes:01,
día:10,
hora: 10,
minuto: 0,
segundo: 0.

Saída escribir: x, salto-de-liña.

Saída escribir: x tempo, salto-de-liña.

x sumar: 1 segundo.
x sumar: 2 minuto.
x sumar: 3 hora.
x sumar: 4 día.
x sumar: 1 mes.
x sumar: 6 ano.

Saída escribir: x, salto-de-liña.

x restar: 1 segundo.
x restar: 2 minuto.
x restar: 3 hora.
x restar: 4 día.
x restar: 1 mes.
x restar: 6 ano.

Saída escribir: x, salto-de-liña.

>> y := x copiar.
>> z := x.

Saída escribir: y, salto-de-liña.
Saída escribir: z, salto-de-liña.
Saída escribir: (x zona = y zona), salto-de-liña.
Saída escribir: (x tempo = y tempo), salto-de-liña.
Saída escribir: (x = z), salto-de-liña.
Saída escribir: x día-do-ano, salto-de-liña.
Saída escribir: x día-da-semana, salto-de-liña.
Saída escribir: x semana, salto-de-liña.
