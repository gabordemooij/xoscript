Saída escribir: ['Test object'], salto-de-liña.
>> a := Obxecto novo. 
a en: ['item:'] facer: { :lst
	propio lst := lst. 
}.
a en: ['item'] facer: { <- propio lst.
}.
a item: (
	Lista novo ; 1 ; (
		Lista novo ; ['a'] ; (
			Lista novo ; ( Momento novo: 1 )
		) ; ( Int64 desde-texto: ['321'] )
	)
).
Saída escribir: a item, salto-de-liña.
>> old-lst-address := a item prototipo enderezo-de-memoria.
a save-as: ['/tmp/a.bin'].
Saída escribir: ['========== RELOADING SNAP:'], salto-de-liña.
>> b := Obxecto load-from: ['/tmp/a.bin'].
(b item prototipo enderezo-de-memoria = old-lst-address) certo: {
	Saída escribir: ['Object link re-attached.'], salto-de-liña.
}.
Saída escribir: ( b item ), salto-de-liña.
