


>> CoffeeMachine := Obxecto novo.
CoffeeMachine en: ['order:'] facer: { :id
	>> coffee := ['Americano'].
	( id = 1 ) certo: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) certo: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) certo: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Obxecto novo.
SimpleCoffeeMachine en: ['order'] facer: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Saída escribir: redCup, salto-de-liña.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Saída escribir: greenCup, salto-de-liña.
>> yellowCup := CoffeeMachine order: 1.
Saída escribir: yellowCup, salto-de-liña.
>> blueCup := CoffeeMachine order: 0.
Saída escribir: blueCup, salto-de-liña.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Saída escribir: blackCup, salto-de-liña.
blackCup engadir-ao-final: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Saída escribir: orangeCup, salto-de-liña.
