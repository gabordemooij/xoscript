

Lista en: ['column:'] facer: { :column
	>> result := Lista novo.
	eu cada: { :index :row
		row cada: { :index :cell
			(index = column) certo: { result engadir-ao-final: cell. }.
		}.
	}. <- result.
}.


>> a := Lista ←
	(Lista ← 1 ; 2 ; 3) ;
	(Lista ← 4 ; 5 ; 6) ;
	(Lista ← 7 ; 8 ; 9).

>> b := a column: 1.
Saída escribir: b, salto-de-liña.

b := a column: 20.
Saída escribir: b, salto-de-liña.

b := a column: -100.
Saída escribir: b, salto-de-liña.
