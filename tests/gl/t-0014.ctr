>> Greeter := Obxecto novo.
Greeter en: ['make'] facer: {
	>> gr := Obxecto novo.
	gr en: ['setName:'] facer: { :aname
		propio nome := aname.
	}.
	gr en: ['greet'] facer: {
		Saída escribir: propio nome.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a novo.
c setName: ['THREE'].
c greet.
>> d := a novo.
d setName: ['FOUR'].
d greet.
c greet.
