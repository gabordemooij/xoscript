

Texto en: ['html'] facer: { <- (
		eu
		substituír: ['&'] por: ['&amp;'],
		substituír: ['<'] por: ['&lt;'],
		substituír: ['>'] por: ['&gt;'],
		substituír: ['"'] por: ['&quot;']
	).
}.


Saída escribir: ([' left trimmed '] recortar) + [' '] + ( ['and right trimmed'] recortar) + ['!'], salto-de-liña.
Saída escribir: ['<html>"html & entities"</html>'] html.
