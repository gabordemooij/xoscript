Saída escribir: ['Test object'], salto-de-liña.
>> a := Obxecto novo. 

a en: ['item:'] facer: { :out
	propio out := out. 
}.

a en: ['item'] facer: { <- propio out.
}.

a en: ['greet'] facer: {
	Saída escribir: ['hi from original out!'], salto-de-liña.
}.

a item: Saída.

Saída escribir: a item, salto-de-liña.

>> old-out-address := a item prototipo enderezo-de-memoria.
a save-as: ['/tmp/a.bin'].
Saída escribir: ['========== RELOADING SNAP:'], salto-de-liña.

>> b := Obxecto load-from: ['/tmp/a.bin'].

(b item prototipo enderezo-de-memoria = old-out-address) certo: {
	Saída escribir: ['Object link re-attached.'], salto-de-liña.
}.

b item escribir: ['hello from loaded out!'], salto-de-liña.
b greet.
