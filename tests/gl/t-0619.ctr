>> HTML := Obxecto novo.
HTML en: ['responder:'] facer: { :tag 
	Saída escribir: (['<tag>'] tag: tag), salto-de-liña.
}.
HTML en: ['responder:e:'] facer: { :tag :html 
	Saída escribir: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), salto-de-liña.
}.
>> html := HTML novo.
html body h1: ['header'].

