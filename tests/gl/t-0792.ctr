Server init.

>> DB := Maria-DB novo anfitrión: ['localhost'],
	usuario: ['xo'],
	contrasinal: ['pass123'],
	nome-base: ['xobase'],
	conectar.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB consulta: SQL.

# now you don't have to set DB
query2 obter: { :row
	Saída escribir: row world, salto-de-liña.
}.
