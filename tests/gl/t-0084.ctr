>> makeAdder := { :x
	>> f := { :y <- (propio x + y). } establecer: ['x'] valor: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i propio q poñer: (propio f aplicar: (propio q ? i)) en: i. } 
	establecer: ['q'] valor: array,
	establecer: ['f'] valor: func.
	{ :i mapping aplicar: i. } × (array contar).
}.

>> a := Lista ← 1; 2; 3.
mapper aplicar: a e: (makeAdder aplicar: 100).
Saída escribir: (a posición: 0), salto-de-liña.
Saída escribir: (a ? 1), salto-de-liña.
Saída escribir: (a ? 2), salto-de-liña.
