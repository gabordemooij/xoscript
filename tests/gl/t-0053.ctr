60 × {
	>> x := (Número random % 6) + 1.
	(x ≤ 6) falso: { Saída escribir: ['FAIL']. }.
	(x ≥0) falso: { Saída escribir: ['FAIL']. }.
	x := (Número random % 3) + 1.
	(x < 3) falso: { Saída escribir: ['FAIL']. }.
	(x>-1) falso: { Saída escribir: ['FAIL']. }.
	x := ((Booleano flip) número).
	(x = 0 ou: x = 1) falso: { Saída escribir: ['FAIL']. }.
	x := ((Certo flip) número).
	(x = 0 ou: x = 1) falso: { Saída escribir: ['FAIL']. }.
	x := (Booleano flip ou: ['HEAD'] ou: ['TAIL']).
	((x = ['HEAD']) ou: (x = ['TAIL'])) falso: { Saída escribir: ['FAIL']. }.
}.
Saída escribir: ['DONE'].

