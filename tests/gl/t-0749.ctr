Saída escribir: ['Test object'], salto-de-liña.
>> a := Obxecto novo. 

a en: ['item:'] facer: { :booleano
	propio booleano := booleano. 
}.

a en: ['item'] facer: { <- propio booleano.
}.

a item: Falso.

Saída escribir: a item, salto-de-liña.

>> old-bool-address := a item prototipo enderezo-de-memoria.
a save-as: ['/tmp/a.bin'].
Saída escribir: ['========== RELOADING SNAP:'], salto-de-liña.

>> b := Obxecto load-from: ['/tmp/a.bin'].

(b item prototipo enderezo-de-memoria = old-bool-address) certo: {
	Saída escribir: ['Object link re-attached.'], salto-de-liña.
}.

Saída escribir: b item, salto-de-liña.
