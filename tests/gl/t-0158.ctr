>> x := [' hallo '].

>> y := x maiúsculas.
Saída escribir: x, salto-de-liña.
Saída escribir: (x igual-a: y), salto-de-liña.

>> y := x minúsculas.
Saída escribir: x, salto-de-liña.
Saída escribir: (x igual-a: y), salto-de-liña.

>> y := x recortar.
Saída escribir: x, salto-de-liña.
Saída escribir: (x igual-a: y), salto-de-liña.

>> y := x desprazamento: 1.
Saída escribir: x, salto-de-liña.
Saída escribir: (x igual-a: y), salto-de-liña.

>> y := x de: 1 lonxitude: 2.
Saída escribir: x, salto-de-liña.
Saída escribir: (x igual-a: y), salto-de-liña.