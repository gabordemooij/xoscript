Server init.

>> DB := Maria-DB novo anfitrión: ['localhost'],
	usuario: ['xo'],
	contrasinal: ['pass123'],
	nome-base: ['xobase'],
	conectar.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> parámetros-de-busca := Maria-Consulta novo: SQL.

# set database
parámetros-de-busca base-de-datos: DB.

parámetros-de-busca obter: { :row
	Saída escribir: row world, salto-de-liña.
}.
