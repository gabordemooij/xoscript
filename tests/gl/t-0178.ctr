Saída escribir: ['last index of W = '] + (( txt último: ['W'] ) - 0), salto-de-liña.
Saída escribir: ['last index of d = '] + (( txt último: ['d'] ) - 0), salto-de-liña.
Saída escribir: ['txt equals Word Salad = '] + ( txt = ['Word Salad'] ), salto-de-liña.
Saída escribir: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), salto-de-liña.
Saída escribir: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), salto-de-liña.
Saída escribir: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), salto-de-liña.

