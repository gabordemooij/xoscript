>> winery := { <- (	Dicionario novo
		poñer: 2 en: ['merlot'],
		poñer: 3 en: ['malbec'],
		poñer: 4 en: ['syrah']
	).
}.

Saída escribir: (((winery iniciar) - ['nothing']) contar), salto-de-liña.
Saída escribir: (((winery iniciar) - ['merlot']) contar), salto-de-liña.
Saída escribir: (((winery iniciar) - ['malbec']) contar), salto-de-liña.
Saída escribir: (((winery iniciar) - ['syrah']) contar), salto-de-liña.
Saída escribir: (((winery iniciar) - ['merlot'] - ['malbec']) contar), salto-de-liña.
Saída escribir: (((winery iniciar) - ['merlot'] - ['syrah']) contar), salto-de-liña.
Saída escribir: (((winery iniciar) - ['malbec'] -['syrah']) contar), salto-de-liña.
Saída escribir: (((winery iniciar) - ['malbec'] - ['syrah'] - ['merlot']) contar), salto-de-liña.

