# edge cases from a request must give an error or a result, not a crash
Server init.

Saída escribir: ['<'] + (['abc'] de: 0 lonxitude: 0, maiúsculas) + ['>'], salto-de-liña.
Saída escribir: ['<'] + (['abc'] de: 0 lonxitude: 0, minúsculas) + ['>'], salto-de-liña.
Saída escribir: ['<'] + (['abc'] desprazamento: 3, maiúsculas) + ['>'], salto-de-liña.
Saída escribir: [''] maiúsculas bytes, salto-de-liña.
Saída escribir: ['aB'] maiúsculas, salto-de-liña.
Saída escribir: ['aB'] minúsculas, salto-de-liña.

Saída escribir: (Momento novo: 0) ano, salto-de-liña.
{ Momento novo: ['9e300'] número. } capturar: { :e Saída escribir: e, salto-de-liña. }, iniciar.
{ Momento novo: ['-9e300'] número. } capturar: { :e Saída escribir: e, salto-de-liña. }, iniciar.
{ Momento novo: ['nan'] número. } capturar: { :e Saída escribir: e, salto-de-liña. }, iniciar.
{ Momento novo: 9000000000000000000. } capturar: { :e Saída escribir: e, salto-de-liña. }, iniciar.
