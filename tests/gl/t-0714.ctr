>> a := Obxecto novo. 
a en: ['greet'] facer: { Saída escribir: ['welcome!'], salto-de-liña. }.
a en: ['greet2'] facer: { Saída escribir: ['welcome2!'], salto-de-liña. }.
a save-as: ['/tmp/a.bin'].

Saída escribir: ['========== RELOADING SNAP:'], salto-de-liña.
>> b := Obxecto load-from: ['/tmp/a.bin'].
b greet2.