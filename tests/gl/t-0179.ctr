

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa xestión-memoria: 0.

>> txt := ['Word Salad'].
Saída escribir: ( txt copiar de: 5 lonxitude: 5 ).
Saída escribir: ( txt copiar desprazamento: 5, recortar ), salto-de-liña.

Programa limpar.

usedMemory1 := (Programa memoria ? 0).


txt := ['Word Salad'].
Saída escribir: ( txt copiar de: 5 lonxitude: 5 ).
Saída escribir: ( txt copiar desprazamento: 5, recortar ), salto-de-liña.

Programa limpar.
usedMemory2 := (Programa memoria ? 0).


txt := ['Word Salad'].
