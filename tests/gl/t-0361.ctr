
>> XX := Obxecto novo.
>> X := Obxecto novo.

XX en: ['QQ'] facer: { <- 1. }.
XX en: ['Q'] facer: { <- 1. }.
XX en: ['QQ:'] facer: { <- 1. }.
XX en: ['QQ:QQ:'] facer: { <- 1. }.

X en: ['QQ'] facer: { <- 1. }.
X en: ['Q'] facer: { <- 1. }.
X en: ['QQ:'] facer: { <- 1. }.
X en: ['QQ:QQ:'] facer: { <- 1. }.

Saída escribir: (Programa XX), salto-de-liña.
Saída escribir: (Programa atopar: ['XX']), salto-de-liña.
Saída escribir: (Programa atopar: ['X']), salto-de-liña.

Saída escribir: (Programa XX: ['QQ']), salto-de-liña.
Saída escribir: (Programa XX: ['Q']), salto-de-liña.
Saída escribir: (Programa XX: ['QQ:']), salto-de-liña.
Saída escribir: (Programa XX: ['QQ:QQ:']), salto-de-liña.

Saída escribir: (Programa X: ['QQ']), salto-de-liña.
Saída escribir: (Programa X: ['Q']), salto-de-liña.
Saída escribir: (Programa X: ['QQ:']), salto-de-liña.
Saída escribir: (Programa X: ['QQ:QQ:']), salto-de-liña.

Saída escribir: (Programa X ['QQ']), salto-de-liña.
Saída escribir: (Programa X ['Q']), salto-de-liña.
Saída escribir: (Programa X ['QQ:']), salto-de-liña.
Saída escribir: (Programa X ['QQ:QQ:']), salto-de-liña.

Saída escribir: (Programa YY), salto-de-liña.
Saída escribir: (Programa atopar: ['YY']), salto-de-liña.
Saída escribir: (Programa atopar: ['Y']), salto-de-liña.

Saída escribir: (Programa YY: ['QQ']), salto-de-liña.
Saída escribir: (Programa YY: ['Q']), salto-de-liña.
Saída escribir: (Programa YY: ['QQ:']), salto-de-liña.
Saída escribir: (Programa YY: ['QQ:QQ:']), salto-de-liña.

Saída escribir: (Programa Y: ['QQ']), salto-de-liña.
Saída escribir: (Programa Y: ['Q']), salto-de-liña.
Saída escribir: (Programa Y: ['QQ:']), salto-de-liña.
Saída escribir: (Programa Y: ['QQ:QQ:']), salto-de-liña.

Saída escribir: (Programa Y ['QQ']), salto-de-liña.
Saída escribir: (Programa Y ['Q']), salto-de-liña.
Saída escribir: (Programa Y ['QQ:']), salto-de-liña.
Saída escribir: (Programa Y ['QQ:QQ:']), salto-de-liña.

Saída escribir: (Programa X: -1), salto-de-liña.
Saída escribir: (Programa X Nada), salto-de-liña.

