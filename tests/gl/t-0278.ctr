>> To-Do := Obxecto novo.

To-Do en: ['novo'] facer: {
	propio list := Lista novo.
}.

To-Do en: ['nieuw'] facer: {
	propio list := Lista novo.
}.

To-Do en: ['+'] facer: { :task
	propio list engadir-ao-final: task.
}.

To-Do en: ['number of tasks?'] facer: { <-  propio list contar.
}.

>> todos := 
	To-Do novo 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Saída escribir: ['You have $ tasks to do'] $ todos number of tasks?.
