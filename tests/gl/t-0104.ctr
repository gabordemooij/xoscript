
{ :i
	Saída escribir: ['This is step #'] + ( ( i ) + 1 ), salto-de-liña.
} × 6.

{ :i
	Saída escribir: ['This is step #'] + ( 3 - ( i ) ), salto-de-liña.
} × 6.

{ :i
	Saída escribir: ['NEVER!'], salto-de-liña.
} × 0.



{ :i
	Saída escribir: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), salto-de-liña.
} × 11.
