Programa xestión-memoria: 4.

>> Doubler := Obxecto novo.
>> Multiplier := Obxecto novo.
Doubler en: ['double:and:'] facer: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier en: ['multiply:and:'] facer: { :x :y <- (x × y).
}.

Saída escribir: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), salto-de-liña.
