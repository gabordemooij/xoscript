>> items := Dicionario novo.
items poñer: ['black'] en: ['coffee'], poñer: ['earl grey'] en: ['tea'].
Saída escribir: (items en: ['coffee']), escribir: (items en: ['tea']).
Saída escribir: ['there are'] + items contar + [' items in the array.'].
items poñer: ['capuccino'] en: ['coffee'].
Saída escribir: ['Now my coffee is.. '] + (items en: ['coffee']).
items poñer: ['aaa'] en: ['1'].
items poñer: ['bbb'] en: ['2'].
Saída escribir: (items en: ['a']).
