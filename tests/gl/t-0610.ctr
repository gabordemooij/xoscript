
>> Rectangle := Obxecto novo.

Rectangle en: ['area'] facer: { <- propio lonxitude * propio width.
}.

Rectangle en: ['length:'] facer: { :lonxitude
	propio lonxitude := lonxitude.
}.

Rectangle en: ['width:'] facer: { :width
	propio width := width.
}.

Rectangle en: ['novo'] facer: {
	# this will not result into an infinite loop
	>> rectangle := eu novo.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle novo.
Saída escribir: a area, salto-de-liña. #0

>> b := Rectangle novo length: 2, width: 3.
Saída escribir: b area, salto-de-liña. #6

