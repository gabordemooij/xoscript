Saída escribir: ['Test object'], salto-de-liña.
>> greeter := Obxecto novo.
greeter en: ['name:'] facer: { :nome
	propio xname := nome. 
}.
greeter en: ['greet'] facer: {
	Saída escribir: ['Hello '] + propio xname, salto-de-liña.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Saída escribir: ['========== RELOADING SNAP:'], salto-de-liña.
>> b := Obxecto load-from: ['/tmp/a.bin'].
>> c := Obxecto load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
