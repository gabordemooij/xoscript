#Linux

(Ficheiro novo: ['/tmp/testje']) existe falso: {
	Programa sistema: ['mkdir /tmp/testje'].	
}.

(Ficheiro novo: ['/tmp/testje/file1']) existe falso: {
	Programa sistema: ['touch /tmp/testje/file1'].	
}.

(Ficheiro novo: ['/tmp/testje/folder1']) existe falso: {
	Programa sistema: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Ficheiro lista: ['/tmp/testje'].

>> q := Lista novo.

l cada: { :k :v v cada: { :x :y q engadir-ao-final: y. }. }.

>> s := q texto.

(s contén: ['file1']) certo:   { Saída escribir: ['OK'], salto-de-liña. }.
(s contén: ['file2']) certo:   { Saída escribir: ['XX'], salto-de-liña. }.
(s contén: ['folder1']) certo: { Saída escribir: ['OK'], salto-de-liña. }.
