# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB novo anfitrión: ['localhost'],
	usuario: ['xo'],
	contrasinal: ['pass123'],
	nome-base: ['xobase'],
	conectar.

>> parámetros-de-busca := db consulta: ['SELECT %% FROM'].
{ parámetros-de-busca executar. } capturar: { :e
	Saída escribir: ( e contén: ['%%'] ), salto-de-liña.
}, iniciar.
