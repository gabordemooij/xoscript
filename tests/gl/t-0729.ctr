Server init.
>> a := Blob novo: 4.
a bytes: ( Lista novo ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob novo: 4.
b bytes: ( Lista novo ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a ^ b.
{
	a ^ ( Ficheiro novo: ['noblob???'] ).
} capturar: { :e Saída escribir: e, salto-de-liña. }, iniciar.
a liberar.
b liberar.
