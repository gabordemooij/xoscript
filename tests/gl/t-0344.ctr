# catch-all test (practical)
>> HTML := Texto novo.
HTML en: ['encode:'] facer: { :tekst
	eu engadir-ao-final: (tekst
	substituír: ['&'] por: ['&amp;'], 
	substituír: ['<'] por: ['&lt;'],
	substituír: ['>'] por: ['&gt;'],
	substituír: ['"'] por: ['&quot;']).
}.
>> blog := HTML novo.
blog engadir-ao-final: ['<h1>'],
     encode: ['Koffie & Thee'],
     engadir-ao-final: ['</h1>'].
Saída escribir: blog, salto-de-liña.


>> Roman := Número novo.
Roman en: ['stringy'] facer: {
	>> a := [''].
	{ a engadir-ao-final: ['I']. } × eu. <- a.
}.

>> x := Roman novo.
x sumar: 3.
Saída escribir: x stringy, salto-de-liña.

>> Quantum := Booleano novo.
Quantum en: ['true?'] facer: { <- ['maybe True']. }.
Saída escribir: (Quantum novo true?), salto-de-liña.

>> Nihil := Nada novo.
Nihil en: ['texto'] facer: { <- ['Nihil']. }.
Saída escribir: (Nihil novo), salto-de-liña.
