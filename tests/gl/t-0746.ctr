Saída escribir: ['Test object'], salto-de-liña.
>> a := Obxecto novo. 

a en: ['item:'] facer: { :dict
	propio dict := dict. 
}.

a en: ['item'] facer: { <- propio dict.
}.

a item: (
Dicionario novo
	hello: ['world'],
	world: (Dicionario novo poñer: ['a'] en: ['b'])).

Saída escribir: a item, salto-de-liña.

>> old-dict-address := a item prototipo enderezo-de-memoria.
a save-as: ['/tmp/a.bin'].
Saída escribir: ['========== RELOADING SNAP:'], salto-de-liña.

>> b := Obxecto load-from: ['/tmp/a.bin'].

(b item prototipo enderezo-de-memoria = old-dict-address) certo: {
	Saída escribir: ['Object link re-attached.'], salto-de-liña.
}.

Saída escribir: b item, salto-de-liña.
