

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa xestión-memoria: 0.

>> o := Obxecto novo.
>> o2 := Obxecto novo.
Saída escribir: o Nada?, salto-de-liña.
Saída escribir: o tipo, salto-de-liña.
Saída escribir: ( o igual-a: o ), salto-de-liña.
Saída escribir: ( o igual-a: o2 ), salto-de-liña.
Saída escribir: o eu-mesmo, salto-de-liña.
Saída escribir: ( o facer feito ), salto-de-liña.

Programa limpar.

usedMemory1 := (Programa memoria ? 0).


o := Obxecto novo.
o2 := Obxecto novo.
Saída escribir: o Nada?, salto-de-liña.
Saída escribir: o tipo, salto-de-liña.
Saída escribir: ( o igual-a: o ), salto-de-liña.
Saída escribir: ( o igual-a: o2 ), salto-de-liña.
Saída escribir: o eu-mesmo, salto-de-liña.
Saída escribir: ( o facer feito ), salto-de-liña.

Programa limpar.
usedMemory2 := (Programa memoria ? 0).


o := Obxecto novo.
o2 := Obxecto novo.
Saída escribir: o Nada?, salto-de-liña.
Saída escribir: o tipo, salto-de-liña.
Saída escribir: ( o igual-a: o ), salto-de-liña.
Saída escribir: ( o igual-a: o2 ), salto-de-liña.
Saída escribir: o eu-mesmo, salto-de-liña.
Saída escribir: ( o facer feito ), salto-de-liña.

Programa limpar.
usedMemory3 := (Programa memoria ? 0).



( usedMemory1 = usedMemory2 e: usedMemory1 = usedMemory3, e: usedMemory2 = usedMemory3 ) certo: {
	Saída escribir: ['No memory leaks here'].
}, falso: {
	Saída escribir: ['Leaking memory...'].
}.
