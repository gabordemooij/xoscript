>> randomizer := { :a :b
	>> mínimo := ( a < b ) ou: a ou: b.
	>> máximo := ( a > b ) ou: a ou: b.
	>> x := Nada.
	{
		x := Número entre: a e: b.
		((x < mínimo) ou: (x > máximo)) certo: { 
			Saída escribir: (['Invalid value!']).
			Programa final.
		}.
	} 
	× 100. <- x.
}.
