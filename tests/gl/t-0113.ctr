Saída escribir: ['Continue for-loop, No - before 6 and up.'], salto-de-liña.
{ :i
	Saída escribir: (i + 1), salto-de-liña.
	((i + 1) > 4) continuar.
	Saída escribir: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Saída salto-de-liña.
Saída escribir: ['Continue while-true, No --> before 5 and up.'], salto-de-liña.
{
	Saída escribir: ['iteration #'] + x, salto-de-liña.
	x sumar: 1.
	((x < 5) non) continuar.
	Saída escribir: ['-->'].
} mentres: xIsLessThan10.
Saída salto-de-liña.
Saída escribir: ['Continue while-false, No - before 3 only.'], salto-de-liña.
{
	Saída escribir: ['iteration #'] + x, salto-de-liña.
	x restar: 1.
	(x = 3) continuar.
	Saída escribir: ['-'].
} mentres: { <- ( x > 0). }.

Saída salto-de-liña.
Saída escribir: ['Continue times-loop, No ||| before 3.'], salto-de-liña.
{ :i
	Saída escribir: ['iteration #'] + i, salto-de-liña.
	(i = 2) continuar.
	Saída escribir: ['|||'].
} × 5.

Saída salto-de-liña.

{ Certo continuar. Saída escribir: ['dont write this!'], salto-de-liña. } iniciar.

{ Certo continuar. Saída escribir: ['dont write this!'], salto-de-liña. } capturar: { Saída escribir: ['Dont catch this!']. }, iniciar.

Saída escribir: ['Test Array each-loop: 0, ... ,2'], salto-de-liña.
(Lista ← 1 ; 2 ; 3) transformar: { :i
	(i = 1) continuar.
	Saída escribir: ['iteration #'] + (i - 0), salto-de-liña.
}.

Saída escribir: ['Test Map each-loop: c only'], salto-de-liña.
>> m := Dicionario novo.
m poñer: ['first'] en: ['a'], poñer: ['second'] en: ['b'], poñer: ['third'] en: ['c'].
m cada: { :k :v
	(k ≠ ['c']) continuar.
	Saída escribir: ['iteration'] + k + v, salto-de-liña.
}.

