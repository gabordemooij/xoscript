Saída escribir: ['Test object'], salto-de-liña.
>> a := Obxecto novo. 
a en: ['item:'] facer: { :int64
	propio int64 := int64. 
}.
a en: ['item'] facer: { <- propio int64.
}.
a item: ( Int64 desde-texto: ['9999'] ).
Saída escribir: a item, salto-de-liña.
>> old-int64-address := a item prototipo enderezo-de-memoria.
a save-as: ['/tmp/a.bin'].
Saída escribir: ['========== RELOADING SNAP:'], salto-de-liña.
>> b := Obxecto load-from: ['/tmp/a.bin'].
(b item prototipo enderezo-de-memoria = old-int64-address) certo: {
	Saída escribir: ['Object link re-attached.'], salto-de-liña.
}.
Saída escribir: ( b item ), salto-de-liña.
