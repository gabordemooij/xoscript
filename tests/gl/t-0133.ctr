


>> Deck := Lista novo.
Deck en: ['print'] facer: {
        >> len := eu contar - 1.
        { :i
                >> len2 := eu contar - 1.
                Saída escribir: ['len: '].
                Saída escribir: len, salto-de-liña.
                Saída escribir: ['len2: '].
                Saída escribir: len2, salto-de-liña.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
