

Texto en: ['evaluate'] facer: {
	>> código := Ficheiro novo: ['/tmp/eval.ctr'].
	código escribir: eu texto + ['.'].
	Programa usar: ['/tmp/eval.ctr'].
}.

>> a := (Lista ← (
	(Dicionario novo)
		poñer: ['domain'] en: ['mywebsite.com'],
		poñer: (Lista ←
			((Dicionario novo)
				poñer: ['home'] en: ['title'],
				poñer: ['<html></html>'] en: ['body'],
				poñer: ['2017-01-01'] en: ['created']
			) ;
			((Dicionario novo)
				poñer: ['aboutus(c)'] en: ['title'],
				poñer: ['<credits>Author Inc.</credits>'] en: ['body']
			)
		) en: ['pages']
	)
) texto.

Saída escribir: a tipo, salto-de-liña.
Saída escribir: a, salto-de-liña.

>> b := Nada.
(['b := '] + a) evaluate.
Saída escribir: b ? 0 ? ['pages'] ? 1 ? ['body'], salto-de-liña.

>> c := b ? 0.
>> d := c texto.
Saída escribir: d tipo, salto-de-liña.

>> e := Nada.
(['e := '] + d) evaluate.
Saída escribir: e ? ['pages'] ? 0, salto-de-liña.
