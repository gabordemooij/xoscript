>> a := Lista ← Obxecto ; Certo ; Falso ; Booleano ; 1 ; Número ; ['Str'] ; Texto ; { ['Empty']. }.
Saída escribir: (a contar), salto-de-liña.
{ :i
	Saída escribir: 
	['a '] + 
	((a ? i) tipo) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Nada?) ou: [''] ou: ['NOT']) + 
	[' Nil.'],
	salto-de-liña.
} × (a contar).
Saída escribir: ['but.. Nil is.. '] + ((Nada Nada?) ou: ['certainly NIL!'] ou: ['not NIL??']), salto-de-liña.