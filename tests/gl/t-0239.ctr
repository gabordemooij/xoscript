Lista en: ['sum'] facer: {
	>> total := 0.
	eu cada: { :index :element
		total sumar: element.
	}. <- total.
}.

>> a := Certo.



a en: ['texto'] facer: {
	>> answer := Nada.
	( eu = Certo ) certo: {
		answer := ['Yep'].
	}, senón: {
		answer := ['Nope'].
	}. <- answer.
}.

a en: ['número'] facer: {
	>> answer := Nada.
	( eu = Certo ) certo: {
		answer := 10.
	}, senón: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b en: ['texto'] facer: { <- ['Devil'].
}.

b en: ['booleano'] facer: { <- Falso.
}.


Saída escribir: a, salto-de-liña.  
Saída escribir: (90 + a), salto-de-liña. 
Saída escribir: b, salto-de-liña. 
Saída escribir: (Certo e: b), salto-de-liña.

a := Lista ← ['hello'] ; ['world'] ; Certo ; Nada ; 666. 
a := a + ( Lista ← 1 ).
Saída escribir: a, salto-de-liña.
Saída escribir: ((Dicionario novo) poñer: Nada en: Nada), salto-de-liña.
Saída escribir: a sum, salto-de-liña. 


