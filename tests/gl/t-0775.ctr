Saída escribir: ['Test object'], salto-de-liña.
>> l := Lista novo ; 1 ; ( Lista novo ; (Momento novo: 1) ; (Int64 desde-texto: ['321']) ; (Lista novo ; 3)).
Saída escribir: l, salto-de-liña.
>> old-lst-address := l prototipo enderezo-de-memoria.
l save-as: ['/tmp/a.bin'].
Saída escribir: ['========== RELOADING SNAP:'], salto-de-liña.
>> b := Obxecto load-from: ['/tmp/a.bin'].
(b prototipo enderezo-de-memoria = old-lst-address) certo: {
	Saída escribir: ['Object link re-attached.'], salto-de-liña.
}.
Saída escribir: b, salto-de-liña.
