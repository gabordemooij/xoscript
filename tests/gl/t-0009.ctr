>> Greeter := Obxecto novo.
Greeter en: ['make'] facer: {
	>> greeter := Obxecto novo.
	greeter en: ['name:'] facer: { :nome
		Saída escribir: ['setting a name'].
		propio myName := nome.
	}.
	greeter en: ['performGreeting'] facer: {
		Saída escribir: ['Hello'].
		Saída escribir: propio myName.
	}.
	greeter en: ['greet'] facer: {
		eu performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
