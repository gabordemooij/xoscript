>> map1 := Dicionario novo.
>> key1 := Lista novo.
>> key2 := Lista novo.

map1
	poñer: ['hello'] en: key1,
	poñer: ['world'] en: key2.


Saída
	escribir: ['Map #1 contains: '] + (map1 en: key1),
	escribir: [' and '] + (map1 en: key2), salto-de-liña.

>> KeyeableArray := Lista novo.
KeyeableArray en: ['toString'] facer: { <- (eu contar) toString.
}.

>> map2 := Dicionario novo.
key1 := KeyeableArray novo.
key2 := KeyeableArray novo.

key1 engadir-ao-final: 1.

map2
	poñer: ['hello'] en: key1,
	poñer: ['world'] en: key2.

Saída
	escribir: ['Map #2 contains: '] + (map2 en: key1),
	escribir: [' and '] + (map2 en: key2), salto-de-liña.
