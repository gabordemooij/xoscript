
>> city := Lista ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Lista ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature por: city.
>> cities := weather entradas ordenar: { :a :b <- (a comparar: b). }.
>> temperatures := weather valores ordenar: { :a :b <- (a comparar: b) negativo?. }.

Saída escribir: (cities unir: [',']), salto-de-liña.
Saída escribir: (temperatures unir: [',']), salto-de-liña.
