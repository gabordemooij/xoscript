['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Saída escribir: (x + y), salto-de-liña.

>> x := 10040.07.
>> y := 10305.60.

Saída escribir: (x + y), salto-de-liña.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Saída escribir: (x + y + z), salto-de-liña.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Saída escribir: (x + y + z), salto-de-liña.

>> q := 0.1.2.

Saída escribir: (q), salto-de-liña.

>> q := 012.

Saída escribir: (q), salto-de-liña.
