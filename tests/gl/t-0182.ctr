

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa xestión-memoria: 0.

>> txt := ['1.6'].
>> n := txt número.
>> t := txt booleano.
Saída escribir: n, salto-de-liña.
Saída escribir: t, salto-de-liña.
Saída escribir: n tipo, salto-de-liña.
Saída escribir: t tipo, salto-de-liña.

Programa limpar.

usedMemory1 := (Programa memoria ? 0).


txt := ['1.6'].
n := txt número.
t := txt booleano.
Saída escribir: n, salto-de-liña.
Saída escribir: t, salto-de-liña.
Saída escribir: n tipo, salto-de-liña.
Saída escribir: t tipo, salto-de-liña.

Programa limpar.
usedMemory2 := (Programa memoria ? 0).


txt := ['1.6'].
n := txt número.
t := txt booleano.
Saída escribir: n, salto-de-liña.
Saída escribir: t, salto-de-liña.
Saída escribir: n tipo, salto-de-liña.
Saída escribir: t tipo, salto-de-liña.

Programa limpar.
usedMemory3 := (Programa memoria ? 0).



( usedMemory1 = usedMemory2 e: usedMemory1 = usedMemory3, e: usedMemory2 = usedMemory3 ) certo: {
