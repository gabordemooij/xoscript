Texto en: ['evaluate'] facer: {
	>> código := Ficheiro novo: ['/tmp/eval.ctr'].
	código escribir: (eu texto + ['.']).
	Programa usar: ['/tmp/eval.ctr'].
}.

>> a := Lista ← 1 ; 2 ; 3.
>> b := (a texto).

Saída escribir: b, salto-de-liña. 
(['b := '] + b) evaluate.

Saída escribir: b ? 2, salto-de-liña. 

Saída escribir: (( Lista ← 1 ; 2 ; 3 )), salto-de-liña. 

Saída escribir: ((Dicionario novo) poñer: 1 en: 2), salto-de-liña. 

>> x := ( (Lista ← 1 ; ( Lista ← 9 ) ; Certo ) ) texto.
Saída escribir: x, salto-de-liña. 
(['x := '] + x) evaluate.

Saída escribir: x ? 1 ? 0, salto-de-liña. 

>> y := (Dicionario novo) poñer: (Lista ← 1) en: (Lista ← 2).
Saída escribir: y, salto-de-liña. 

(['y := '] + y) texto evaluate.

Saída escribir: (y en: (Lista ← 2) texto ), salto-de-liña.

Saída escribir: (Lista novo), salto-de-liña. 
Saída escribir: (Dicionario novo), salto-de-liña. 
