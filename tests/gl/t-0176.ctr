

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa xestión-memoria: 0.

>> txt := ['Word Salad'].
Saída escribir: ['Text Length: '] + txt lonxitude, salto-de-liña.
Saída escribir: ['Character at 2:'] + ( txt carácter: 2 ), salto-de-liña.
Saída escribir: (( txt atopar: ['S'] ) - 0), salto-de-liña.

Programa limpar.

usedMemory1 := (Programa memoria ? 0).


txt := ['Word Salad'].
Saída escribir: ['Text Length: '] + txt lonxitude, salto-de-liña.
Saída escribir: ['Character at 2:'] + ( txt carácter: 2 ), salto-de-liña.
Saída escribir: (( txt atopar: ['S'] ) - 0), salto-de-liña.

Programa limpar.
usedMemory2 := (Programa memoria ? 0).


txt := ['Word Salad'].
Saída escribir: ['Text Length: '] + txt lonxitude, salto-de-liña.
Saída escribir: ['Character at 2:'] + ( txt carácter: 2 ), salto-de-liña.
Saída escribir: (( txt atopar: ['S'] ) - 0), salto-de-liña.

Programa limpar.
usedMemory3 := (Programa memoria ? 0).



( usedMemory1 = usedMemory2 e: usedMemory1 = usedMemory3, e: usedMemory2 = usedMemory3 ) certo: {
	Saída escribir: ['No memory leaks here'].
}, falso: {
	Saída escribir: ['Leaking memory...'].
}.
