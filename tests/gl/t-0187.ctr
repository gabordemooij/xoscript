Número en: ['factorial'] facer: {
	>> total := 1.
	{ :index total multiplicar-por: (eu - index). } × eu. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa xestión-memoria: 0.

{
2 exponent factorial.
Saída escribir: (11 módulo: 3), salto-de-liña.
Saída escribir: (3.4 arredondar), salto-de-liña.
Saída escribir: (7.1 arredondar-arriba), salto-de-liña.
Saída escribir: (7.9 arredondar-abaixo), salto-de-liña.
}
iniciar.

Programa limpar.

usedMemory1 := (Programa memoria ? 0).

{
2 exponent factorial.
Saída escribir: (11 módulo: 3), salto-de-liña.
Saída escribir: (3.4 arredondar), salto-de-liña.
Saída escribir: (7.1 arredondar-arriba), salto-de-liña.
Saída escribir: (7.9 arredondar-abaixo), salto-de-liña.
}
iniciar.

Programa limpar.
usedMemory2 := (Programa memoria ? 0).


{
2 exponent factorial.
Saída escribir: (11 módulo: 3), salto-de-liña.
Saída escribir: (3.4 arredondar), salto-de-liña.
Saída escribir: (7.1 arredondar-arriba), salto-de-liña.
Saída escribir: (7.9 arredondar-abaixo), salto-de-liña.
} iniciar.

Programa limpar.
usedMemory3 := (Programa memoria ? 0).



( usedMemory1 = usedMemory2 e: usedMemory1 = usedMemory3, e: usedMemory2 = usedMemory3 ) certo: {
	Saída escribir: ['No memory leaks here'].
}, falso: {
	Saída escribir: ['Leaking memory...'].
}.
