



>> CoffeeGrounds := Obxecto novo.
CoffeeGrounds en: ['extract'] facer: { <- ['coffee']. }.

>> CoffeeMachine := Obxecto novo.
CoffeeMachine en: ['init'] facer: {
	propio coffeegrounds := CoffeeGrounds novo.
}.
CoffeeMachine en: ['novo'] facer: { <- CoffeeMachine `new init.
}.

CoffeeMachine en: ['makeTea'] facer: { <- (propio tealeaves extract). }.
CoffeeMachine en: ['makeCoffee'] facer: { <- (propio coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine novo.

Saída escribir:
	coffeeDream 
	makeCoffee.

Saída escribir:
	coffeeDream 
	makeTea.
