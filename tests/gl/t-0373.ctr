# compliance test

# use international numbers

Saída escribir: ['1000 -> '].
Saída escribir: 1000, salto-de-liña. #1000

Saída escribir: ['1.5 -> '].
Saída escribir: 1.5, salto-de-liña.  #1.5

Saída escribir: ['1001.5 -> '].
Saída escribir: 1.5 + 1000, salto-de-liña. #1001.5

# use 0-indexed arrays
>> x := Lista novo ; 1 ; 2 ; 3.
>> y := Lista novo ; ['a'] ; ['b'] ; ['c'].

Saída escribir: ['1 -> '].
Saída escribir: x ? 0, salto-de-liña. #1

Saída escribir: ['1 -> '].
Saída escribir: (x en: 0), salto-de-liña. #1

Saída escribir: ['1 -> '].
Saída escribir: x primeiro, salto-de-liña. #1

Saída escribir: ['3 -> '].
Saída escribir: x último, salto-de-liña. #3

Saída escribir: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Saída escribir: (x por: y), salto-de-liña.

Saída escribir: ['1 -> '].
Saída escribir: (x de: 0 lonxitude: 1) primeiro, salto-de-liña. #1

Saída escribir: ['0 -> '].
Saída escribir: (x atopar: 1), salto-de-liña. #0

x poñer: 9 en: 0.

Saída escribir: ['9 -> '].
Saída escribir: (x en: 0), salto-de-liña. #9

x engadir-ao-comezo: 8.
Saída escribir: ['8 -> '].
Saída escribir: (x en: 0), salto-de-liña. #9


x engadir-ao-final: 10.
Saída escribir: ['10 -> '].
Saída escribir: (x en: 4), salto-de-liña. #10








