

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa xestión-memoria: 0.

Número en: ['addNum:'] facer: { :x
	eu sumar: x.
}.

Número en: ['subtractNum:'] facer: { :x
	eu restar: x.
}.

Número en: ['multiplyBy:'] facer: { :x
	eu multiplicar-por: x.
}.

Número en: ['divideBy:'] facer: { :x
	eu dividir-por: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 potencia: 8).  
a := a + (2 potencia: -1). 
a := a + (49 raíz-cadrada).   
a addNum: ((Lista ← 0 ; 1) máximo).          
a addNum: ((Lista ← 2 ; 3) mínimo).
Saída escribir: a.

Programa limpar.

usedMemory1 := (Programa memoria ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 potencia: 8).  
a := a + (2 potencia: -1). 
a := a + (49 raíz-cadrada).   
a addNum: ((Lista ← 0 ; 1) máximo).          
a addNum: ((Lista ← 2 ; 3) mínimo).
Saída escribir: a.

Programa limpar.
usedMemory2 := (Programa memoria ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 potencia: 8).  
a := a + (2 potencia: -1). 
a := a + (49 raíz-cadrada).   
a addNum: ((Lista ← 0 ; 1) máximo).          
a addNum: ((Lista ← 2 ; 3) mínimo).
Saída escribir: a.

Programa limpar.
usedMemory3 := (Programa memoria ? 0).



( usedMemory1 = usedMemory2 e: usedMemory1 = usedMemory3, e: usedMemory2 = usedMemory3 ) certo: {
	Saída escribir: ['No memory leaks here'].
}, falso: {
	Saída escribir: ['Leaking memory...'].
}.
