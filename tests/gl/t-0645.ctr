Server init.
Saída escribir: ['Database date test'], salto-de-liña.

>> db := Maria-DB novo anfitrión: ['localhost'],
	usuario: ['xo'], 
	contrasinal: ['pass123'],
	nome-base: ['xobase'],
	conectar.

>> parámetros-de-busca :=
db consulta: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
obter: { :row
	Saída escribir: row datetest, salto-de-liña.
}.
