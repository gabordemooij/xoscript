wine en: ['='] facer: { :other wine <- ( eu toString = other wine ).
}.

wine en: ['=='] facer: { :other wine <- ( eu toString = other wine ).
}.



wine
	caso: ['cabernet'] facer: { Saída escribir: ['it's a Cabernet!']. },
	caso: ['syrah']    facer: { Saída escribir: ['it's a Syrah!'].    },
	caso: ['merlot']   facer: { Saída escribir: ['it's a Merlot!'].   },
	caso: ['malbec']   facer: { Saída escribir: ['it's a Malbec!'].   }.

