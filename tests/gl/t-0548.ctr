Server init.

>> x := Blob novo: 65 tipo: ['char'].
# for this test you need set a path to libc (puts)
>> libname := Programa configuración: ['FFITESTLIB'].
Server ligar: (
 Lista novo ;
 libname ;
 ['putchar'] ;
 ( Lista novo ; ['char'] ) ;
 ['void'] ;
 ['Print'] ;
 ['char:']
).
Print char: (x de: 0 lonxitude: 1), salto-de-liña.
x liberar.

