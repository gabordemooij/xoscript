Saída escribir: ['Test object'], salto-de-liña.
>> p := Rota /tmp.
Saída escribir: p, salto-de-liña.
>> old-p-address := p prototipo enderezo-de-memoria.
p save-as: ['/tmp/a.bin'].
Saída escribir: ['========== RELOADING SNAP:'], salto-de-liña.
>> b := Obxecto load-from: ['/tmp/a.bin'].
(b prototipo enderezo-de-memoria = old-p-address) certo: {
	Saída escribir: ['Object link re-attached.'], salto-de-liña.
}.
Saída escribir: b, salto-de-liña.
