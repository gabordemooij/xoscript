Booleano en: ['xor:'] facer: { :a :b <- ((a e: b non) ou: (a non e: b)).
}.

>> o := Obxecto novo.
o en: ['hello'] facer: { ['Empty']. }.
{ o en: 2 facer: 3.} capturar: { :e Saída escribir: e, salto-de-liña. }, iniciar.
{ o en: ['proba'] facer: 3.} capturar: { :e Saída escribir: e, salto-de-liña. }, iniciar.
{ o en: ['hello'] facer: { ['Empty']. }.} capturar: { :e Saída escribir: e, salto-de-liña. }, iniciar. 
{ >> z := 4 ÷ 0. } capturar: { :e Saída escribir: e, salto-de-liña. }, iniciar. 
{ (Certo e: Nada) certo: { Saída escribir: ['X'].}. } capturar: { :e Saída escribir: e, salto-de-liña. }, iniciar. 
{ ([''] xor: 0) certo: { Saída escribir: ['X'].}. } capturar: { :e Saída escribir: e, salto-de-liña. }, iniciar. 
{ (1 < ['2']) certo: { Saída escribir: ['OK']. }. } capturar: { :e Saída escribir: e, salto-de-liña. }, iniciar. 
{ (1 < ['2.0']) certo: { Saída escribir: ['OK']. }. } capturar: { :e Saída escribir: e, salto-de-liña. }, iniciar. 
{ (1 < ['x2.0']) certo: { Saída escribir: ['NO!']. }. } capturar: { :e Saída escribir: e, salto-de-liña. }, iniciar. 
{ Saída escribir: (['hello OK there'] de: ['6'] lonxitude: ['2']). } iniciar. 
