
Texto en: ['evaluate'] facer: {
	>> código := Ficheiro novo: ['/tmp/eval.ctr'].
	código escribir: (eu texto + ['.']).
	Programa usar: ['/tmp/eval.ctr'].
}.

>> map :=
	(Dicionario novo)
	poñer: ['Hi There'] en: ['two'],
	poñer: (Lista ← ['hello'] ; ['world'] ; (Lista ← 1 ; 2; 9) ; Falso) en: ['one'],
	poñer: ( (Dicionario novo) poñer: ['wrrld'] en: ['misspelled'] ) en: ['three'],
	poñer: (Lista ← ((Dicionario novo) poñer: ['treasure'] en: ['hidden']) ; 2) en: ['four']. 
>> str := map texto.
>> map2 := Nada.
(['map2 := '] + str ) evaluate.
Saída escribir: map2 ? ['one'] ? 0.
Saída escribir: map2 ? ['one'] ? 1.
Saída escribir: map2 ? ['four'] ? 0 ? ['hidden'].
Saída escribir: map2 ? ['one'] ? 2 ? 2.
