# test number -> string -> number
{

	>> x := Número entre: 0 e: 1000000.
	>> d := Número entre: 1 e: 7.
	>> e := 10 potencia: d.

	x dividir-por: e.
	>> y := x texto número.

	(x = y) falso: {
		Saída escribir: x, salto-de-liña.
		Saída escribir: y, salto-de-liña.
		Programa final.
	}.

} * 1000.
Saída escribir: ['OK'], salto-de-liña.