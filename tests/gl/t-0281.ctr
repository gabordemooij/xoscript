>> q := Lista ← 1 ; 2 ; 3.
{ q ? ['1']. } capturar: { Saída escribir: ['caught!'], salto-de-liña. }, iniciar.
{ q ? Certo. } capturar: { Saída escribir: ['caught!'], salto-de-liña. }, iniciar.
{ q ? Falso. } capturar: { Saída escribir: ['caught!'], salto-de-liña. }, iniciar.
{ q ? Nada. } capturar: { Saída escribir: ['caught!'], salto-de-liña. }, iniciar.
{ q ? (Lista novo). } capturar: { Saída escribir: ['caught!'], salto-de-liña. }, iniciar.
{ q ? (Obxecto novo). } capturar: { Saída escribir: ['caught!'], salto-de-liña. }, iniciar.
{ q ? ({ ['Empty']. }). } capturar: { Saída escribir: ['caught!'], salto-de-liña. }, iniciar.
Saída escribir: ['caught them all'], salto-de-liña.
