
>> Animal := Obxecto novo.
Animal en: ['novo'] facer: { <- eu novo init.
}.

Animal en: ['init'] facer: {
	propio sound := ['?'].
	propio legs := 4.
}.

>> Dog := Animal novo.
Dog en: ['init'] facer: {
	eu init.
	propio sound := ['barks'].
}.

Animal en: ['texto'] facer: { <- propio legs texto + propio sound.
}.

>> poodle := Dog novo.
Saída escribir: poodle, salto-de-liña.

