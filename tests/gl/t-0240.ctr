# test qualifiers

>> $ := Obxecto novo.

$ en: ['responder:'] facer: { :x
	
	>> operation := x carácter: 0.
	>> valuta := x carácter: 1.
	>> money := x desprazamento: 2.
	
	>> amount := 0.

	( operation = ['+'] ) certo: {
		( valuta = ['£'] ) certo: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Saída escribir: x, salto-de-liña.


>> Fruit := Obxecto novo.

Fruit en: ['novo'] facer: {
	>> f := eu novo.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit en: ['apples:'] facer: { :a propio apples := a. }.
Fruit en: ['oranges:'] facer: { :p propio oranges := p. }.
Fruit en: ['apples'] facer: { <- propio apples. }.
Fruit en: ['oranges'] facer: { <- propio oranges. }.

Fruit en: ['+'] facer: { :f
	
	>> n := Fruit novo.
	f sumar: 1.
	
	n apples: (f apples + propio apples).
	n oranges:  (f oranges  + propio oranges). <- n.
}.

Fruit en: ['texto'] facer: { <- ( propio apples texto + [' apples and '] + propio oranges + [' oranges'] ).
}.

Número en: ['apples'] facer: { <- ((Fruit novo) apples: eu).
}.

Número en: ['apple'] facer: { <- ((Fruit novo) apples: eu).
}.

Número en: ['oranges'] facer: { <- ((Fruit novo) oranges: eu).
}.




Saída escribir: (1 apple + 3 oranges + 4 apples), salto-de-liña.


Texto en: ['twice'] facer: { <- ((eu texto) + (eu texto)).
}.



Saída escribir: ['❤❤❤'] twice.



