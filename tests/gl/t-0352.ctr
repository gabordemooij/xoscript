Número en: ['roman'] facer: {
	>> número := eu copiar.
	>> roman := [''].
	{
		{
			(número ≥ 1000) certo: {
				roman engadir-ao-final: ['Ⅿ'].
				número restar: 1000.
			}, interromper.
		
			(número ≥ 500) certo: {
				roman engadir-ao-final: ['Ⅾ'].
				número restar: 500.
			}, interromper.
		
			(número ≥ 100) certo: {
				roman engadir-ao-final: ['Ⅽ'].
				número restar: 100.
			}, interromper.
		
			(número ≥ 50) certo: {
				roman engadir-ao-final: ['Ⅼ'].
				número restar: 50.
			}, interromper.
		
			(número ≥ 50) certo: {
				roman engadir-ao-final: ['Ⅼ'].
				número restar: 50.
			}, interromper.
		
			(número ≥ 10) certo: {
				roman engadir-ao-final: ['Ⅹ'].
				número restar: 10.
			}, interromper.
			
			(número ≥ 9) certo: {
				roman engadir-ao-final: ['Ⅸ'].
				número restar: 9.
			}, interromper.
			
			(número ≥ 5) certo: {
				roman engadir-ao-final: ['Ⅴ'].
				número restar: 5.
			}, interromper.
			
			(número ≥ 4) certo: {
				roman engadir-ao-final: ['Ⅳ'].
				número restar: 4.
			}, interromper.
			
			(número ≥ 1) certo: {
				roman engadir-ao-final: ['Ⅰ'].
				número restar: 1.
			}, interromper.
		} procedemento.
	} mentres: { <- número > 0. }. <- roman.
}.

Saída escribir: 1 roman, salto-de-liña.
Saída escribir: 2 roman, salto-de-liña.
Saída escribir: 4 roman, salto-de-liña.
Saída escribir: 8 roman, salto-de-liña.
Saída escribir: 16 roman, salto-de-liña.
Saída escribir: 32 roman, salto-de-liña.
Saída escribir: 64 roman, salto-de-liña.
Saída escribir: 128 roman, salto-de-liña.
Saída escribir: 256 roman, salto-de-liña.
Saída escribir: 1024 roman, salto-de-liña.
