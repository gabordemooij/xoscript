
Lista en: ['sum'] facer: {
	>> total := 0.
	eu cada: { :index :element
		total sumar: element.
	}. <- total.
}.

>> a := Lista ← 9 ; 8 ; 7.
Saída escribir: (a sum), salto-de-liña. 
>> a := Lista ← 1 ; 9.
Saída escribir: (a sum), salto-de-liña. 
>> a := Lista ← ['o'] ; 2.
Saída escribir: (a sum), salto-de-liña. 
Saída escribir: (Lista novo sum), salto-de-liña. 
