Texto en: ['html'] facer: { <- (
		eu
		substituír: ['&'] por: ['&amp;'],
		substituír: ['<'] por: ['&lt;'],
		substituír: ['>'] por: ['&gt;'],
		substituír: ['''] por: ['&apos;'],
		substituír: ['"'] por: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa xestión-memoria: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Saída escribir: txt copiar html, salto-de-liña.
Saída escribir: txt copiar minúsculas, salto-de-liña.
Saída escribir: txt copiar maiúsculas, salto-de-liña.
} iniciar.

Programa limpar.

usedMemory1 := (Programa memoria ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Saída escribir: txt copiar html, salto-de-liña.
Saída escribir: txt copiar minúsculas, salto-de-liña.
Saída escribir: txt copiar maiúsculas, salto-de-liña.
} iniciar.

Programa limpar.
usedMemory2 := (Programa memoria ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Saída escribir: txt copiar html, salto-de-liña.
Saída escribir: txt copiar minúsculas, salto-de-liña.
Saída escribir: txt copiar maiúsculas, salto-de-liña.
} iniciar.

Programa limpar.
usedMemory3 := (Programa memoria ? 0).



( usedMemory1 = usedMemory2 e: usedMemory1 = usedMemory3, e: usedMemory2 = usedMemory3 ) certo: {
	Saída escribir: ['No memory leaks here'].
}, falso: {
	Saída escribir: ['Leaking memory...'].
}.
