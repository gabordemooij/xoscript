# test url parsing

Server init.
>> url := URL desde: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Saída escribir: ['scheme = '] + url esquema, salto-de-liña.
Saída escribir: ['host = '] + url anfitrión, salto-de-liña.
Saída escribir: ['port = '] + url porto, salto-de-liña.
Saída escribir: ['path = '] + url camiño, salto-de-liña.
Saída escribir: ['query = '] + url parámetros-de-busca, salto-de-liña.
Saída escribir: ['fragment = '] + url fragmento, salto-de-liña.
