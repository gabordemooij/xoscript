Número en: ['factorial'] facer: {
	>> total := 1.
	{ :index total multiplicar-por: (eu - (index)). } × eu. <- total.
}.
>> Printer := Obxecto novo.
Printer en: ['print:and:'] facer: { :x :y
	Saída escribir: ['a='] + x + [', b='] + y, salto-de-liña.
}.
>> a := 4.5. >> b := a arredondar-abaixo.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a arredondar-arriba.
Printer print: a and: b.
a := 4.5. b := a arredondar-abaixo.
Printer print: a and: b.
a := 4.5. b := a arredondar.
Printer print: a and: b.
a := 4.2. b := a arredondar.
Printer print: a and: b.

