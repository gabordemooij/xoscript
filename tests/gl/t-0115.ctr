{
	{
		esta-tarefa erro: ['Dont fail.'].
		Certo interromper.
		Saída escribir: ['FAIL'].
	} capturar: { :x
		(x = ['Dont fail.']) certo: { esta-tarefa erro: ['Nested Caught!']. }.
	}, iniciar.
} capturar: { :e
	Saída escribir: e.
}, iniciar.
