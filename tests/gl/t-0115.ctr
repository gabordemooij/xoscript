	esta-tarefa erro: ['Dont fail.'].
	unknown doSomething.
} capturar: {
	Saída escribir: ['Caught!'].
}, iniciar.

{
	esta-tarefa erro: ['Dont fail.'].
	propio unknown doSomething.
} capturar: {
	Saída escribir: ['Caught!'].
}, iniciar.

