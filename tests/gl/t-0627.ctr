

# create a 64-bit integer for exact calculations
>> a := Int64 desde-texto: ['123'].

# to string
Saída escribir: a, salto-de-liña.

# divide
Saída escribir: a / (Int64 desde-texto: ['3']), salto-de-liña.

# multiply
Saída escribir: a * (Int64 desde-texto: ['2']), salto-de-liña.

# add
Saída escribir: a + (Int64 desde-texto: ['1']), salto-de-liña.

# subtract
Saída escribir: a - (Int64 desde-texto: ['2']), salto-de-liña.

# compare
Saída escribir: ( a =   (Int64 desde-texto: ['123'])), salto-de-liña.
Saída escribir: ( a !=: (Int64 desde-texto: ['124'])), salto-de-liña.
Saída escribir: ( a <   (Int64 desde-texto: ['124'])), salto-de-liña.
Saída escribir: ( a >   (Int64 desde-texto: ['122'])), salto-de-liña.
Saída escribir: ( a >=: (Int64 desde-texto: ['123'])), salto-de-liña.
Saída escribir: ( a <=: (Int64 desde-texto: ['123'])), salto-de-liña.





	