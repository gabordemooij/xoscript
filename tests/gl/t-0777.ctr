#OBSD
>> dirname := [''].
{ dirname engadir-ao-final: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Programa sistema: command.
Programa chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename engadir-ao-final: ['YYYYYYYY']. } * 20.
Ficheiro novo: filename, escribir: ['sometext'].
{ Ficheiro lista: ['/tmp/'] + dirname. } * 1000.
Saída escribir: ['no crash'], salto-de-liña.

