# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob novo: 8, bytes: (
	Lista novo ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Saída escribir: ( utf16 descodificar: ['utf16le'] ), salto-de-liña.

utf16 liberar.
>> utf32 := Blob novo: 13, bytes: (
	Lista novo ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Saída escribir: ( utf32 descodificar: ['utf32be'] ), salto-de-liña.
utf32 liberar.