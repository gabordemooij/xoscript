>> repeater := Obxecto novo.
repeater en: ['responder:'] facer: { :what
	Saída escribir: what + [' '].
}.
repeater en: ['responder:e:'] facer: { :what :say
	Saída escribir: what, escribir: say + [' '].
}.
repeater en: ['responder:e:e:'] facer: { :what :say :more
	Saída escribir: what, escribir: say, escribir: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
