Saída escribir: ['Test object'], salto-de-liña.
>> cmd := Orde novo.
Saída escribir: cmd ls /tmp, salto-de-liña.
>> old-cmd-address := cmd prototipo enderezo-de-memoria.
cmd save-as: ['/tmp/a.bin'].
Saída escribir: ['========== RELOADING SNAP:'], salto-de-liña.
>> b := Obxecto load-from: ['/tmp/a.bin'].
(b prototipo enderezo-de-memoria = old-cmd-address) certo: {
	Saída escribir: ['Object link re-attached.'], salto-de-liña.
}.
Saída escribir: b ls, salto-de-liña.


