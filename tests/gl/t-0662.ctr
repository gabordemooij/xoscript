>> t := Nada.

# you can control the time zone for
# parsing like this:
Momento zona: ['CET'].
t := Momento desde: ['1981-02-03 04:05:06'].
Saída escribir: t, salto-de-liña.

# now using CEST time zone:
Momento zona: ['CEST'].
t := Momento desde: ['1981-02-03 04:05:06'].
Saída escribir: t, salto-de-liña.

# error if string cannot be parsed
{ Momento desde: ['1900']. } capturar: { Nada. }, iniciar.
