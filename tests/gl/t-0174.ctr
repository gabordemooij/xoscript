


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa xestión-memoria: 0.
>> palette := Nada.
>> colors := Nada.

{
palette := Dicionario novo.
palette 
	poñer: ['#F00'] en: ['red'],
	poñer: ['#0F0'] en: ['green'],
	poñer: ['#00F'] en: ['blue'].
Saída escribir: ['number of RGB codes in palette: '] + ( palette contar ), salto-de-liña.
Saída escribir: ['RGB code of green is: '] + ( palette ? ['green'] ), salto-de-liña.
colors := [''].
( palette cada: { :nome :código
		colors := colors + ( nome + [':'] + código ).
} ).
Saída escribir: ['All colors in palette: '] + colors, salto-de-liña.
} iniciar.
Programa limpar.
usedMemory1 := (Programa memoria ? 0).

{
palette := Dicionario novo.
palette 
	poñer: ['#F00'] en: ['red'],
	poñer: ['#0F0'] en: ['green'],
	poñer: ['#00F'] en: ['blue'].
