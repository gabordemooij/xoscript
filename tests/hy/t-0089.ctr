>> randomizer := { :a :b
	>> նվազագույն := ( a < b ) կամ-սա: a կամ-դա: b.
	>> առավելագույն := ( a > b ) կամ-սա: a կամ-դա: b.
	>> x := Դատարկ.
	{
		x := Թիվ միջև: a մինչև: b.
		((x < նվազագույն) կամ: (x > առավելագույն)) եթե-ճիշտ: { 
			Ելք գրել: (['Invalid value!']).
			Ծրագիր ավարտել.
		}.
	} 
	× 100. <- x.
}.
