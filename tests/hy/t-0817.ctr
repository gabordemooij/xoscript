# a value ending in the first part of an opening quote must survive serialization
>> արժեքներ := Ցուցակ նոր
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

արժեքներ յուրաքանչյուր: { :i :value
	>> d := Բառարան նոր.
	d դնել: value բանալի: ['k'].
	d դնել: ['second'] բանալի: ['j'].
	>> r := d կոդ օբյեկտ.
	Ելք գրել: r քանակ, նոր-տող.
	Ելք գրել: ( (r դիրքում: ['k']) = value ), նոր-տող.
}.
