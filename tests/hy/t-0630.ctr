#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Նմուշ նոր: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern համընկնում: subject կատարել: { :m :x
	Ելք գրել: m, նոր-տող.
	Ելք գրել: x, նոր-տող. <- ['XXX'].
}.
Ելք գրել: result, նոր-տող.