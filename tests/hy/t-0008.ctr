>> Greeter := Օբյեկտ նոր.
Greeter ստանալիս: ['make'] կատարել: {
	>> greeter := Օբյեկտ նոր.
	greeter ստանալիս: ['name:'] կատարել: { :անուն
		Ելք գրել: ['setting a name'].
		սեփական myName := անուն.
	}.
	greeter ստանալիս: ['greet'] կատարել: {
		Ելք գրել: ['Hello'].
		Ելք գրել: սեփական myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
