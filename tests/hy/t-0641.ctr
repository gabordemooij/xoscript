# Test utf8 sanitizer
Server init.

>> utf8cases := Բառարան նոր
	# ASCII only
	դնել: ( Ցուցակ նոր ; 65 ; 65 ; 65 ; 65 ; 0 ) բանալի: ['AAAA'],
	# valid 2 byte sequence
	դնել: ( Ցուցակ նոր ; 194 ; 162 ; 0 ) բանալի: ['¢'],
	# Valid 3-byte UTF-8
    դնել: ( Ցուցակ նոր ; 226 ; 130 ; 172 ; 0 ) բանալի: ['€'],
	# Valid 4-byte UTF-8
    դնել: ( Ցուցակ նոր ; 240 ; 144 ; 141 ; 136 ; 0 ) բանալի: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    դնել: ( Ցուցակ նոր ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) բանալի: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    դնել: ( Ցուցակ նոր ; 65 ; 193 ; 129 ; 0 ) բանալի: ['A?'],
	# Invalid first byte (0xFF)
    դնել: ( Ցուցակ նոր ; 255 ; 0 ) բանալի: ['?'],
	# Incomplete multi-byte sequence at end
    դնել: ( Ցուցակ նոր ; 66 ; 226 ; 0 ) բանալի: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    դնել: ( Ցուցակ նոր ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) բանալի: ['A€?𐍈B'].
	 
utf8cases յուրաքանչյուր: { :key :value
	>> blob := Blob նոր: value քանակ, bytes: value.
	>> str := blob տող.
	(str = key) եթե-ճիշտ: {
		Ելք գրել: ['OK'], նոր-տող.
	}, այլապես: {
		Ելք գրել: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, նոր-տող.
	}.
	blob ազատել.
}.
