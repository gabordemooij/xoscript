# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Նմուշ նոր: pattern.
	p համընկնում: subject կատարել: { :m :g
		Ելք գրել: g քանակ, գրել: [' '], գրել: (g միացնել: ['|']), նոր-տող. <- m.
	}.
}.
show կիրառել: ['(a)|(b)'] և: ['b'].
show կիրառել: ['(a)|(b)'] և: ['a'].
show կիրառել: ['(x)?y'] և: ['y'].
show կիրառել: ['(x)?(y)(z)?'] և: ['xy'].
