

>> obj := Օբյեկտ նոր.

obj ստանալիս: ['greet'] կատարել: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj ստանալիս: ['task'] կատարել: {
	սեփական property := 123.
	{
		# try binds self/own to object instead of block
		Ելք գրել: ինքը greet.
		Ելք գրել: սեփական property.
		1 / 0.
	} որսալ: {
		Ելք գրել: ինքը greet.
		Ելք գրել: սեփական property.
		Ելք գրել: ['ok'].
	}, փորձել.
}.

obj task.