Server init.

>> DB := Maria-DB նոր հոսթ: ['localhost'],
	օգտանուն: ['xo'],
	գաղտնաբառ: ['pass123'],
	բազայի-անուն: ['xobase'],
	միանալ.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB հարցում: SQL.

# now you don't have to set DB
query2 ստանալ: { :row
	Ելք գրել: row world, նոր-տող.
}.
