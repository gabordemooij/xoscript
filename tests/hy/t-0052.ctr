>> items := Բառարան նոր.
items դնել: ['green'] բանալի: ['color-1'].
items դնել: ['orange'] բանալի: ['color-2'].
items դնել: ['red'] բանալի: ['color-3'].
>> i := 0.
>> s := [''].
items յուրաքանչյուր: { :key :color
	Ելք գրել: ['color #'] + i + [' is: '] + color + [' '].
	i գումարել: 1.
}.
Ելք գրել: i + [' colors!'].
