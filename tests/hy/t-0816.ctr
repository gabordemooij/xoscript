# a format must fit the type of the value, the type can come from a client
>> փորձել := { :format :value
	{ Ելք գրել: ( (Ձևաչափ նոր: format) կիրառել: value ), նոր-տող. } որսալ: { :e Ելք գրել: e, նոր-տող. }, գործարկել.
}.
>> try-int := { :format :value
	{ Ելք գրել: ( (Ձևաչափ նոր: format) կիրառել-ամբողջ: value ), նոր-տող. } որսալ: { :e Ելք գրել: e, նոր-տող. }, գործարկել.
}.

# fits
փորձել կիրառել: ['|%s|'] և: ['text'].
փորձել կիրառել: ['%06.2f'] և: 5.5.
փորձել կիրառել: ['100%% %s'] և: ['sure'].
try-int կիրառել: ['%03d'] և: 7.
try-int կիրառել: ['%x'] և: 255.
փորձել կիրառել: ['%d'] և: (Int64 նոր տողից: ['12']).
փորձել կիրառել: ['%lld'] և: (Int64 նոր տողից: ['12']).
փորձել կիրառել: ['%.1lf'] և: 5.5.
try-int կիրառել: ['%hd'] և: 7.

# does not fit
փորձել կիրառել: ['%s'] և: 12345.
փորձել կիրառել: ['%d'] և: 12345.
փորձել կիրառել: ['%f'] և: ['text'].
try-int կիրառել: ['%d'] և: ['text'].
try-int կիրառել: ['%s'] և: 5.
փորձել կիրառել: ['%s %s'] և: ['text'].
փորձել կիրառել: ['%n'] և: ['text'].
փորձել կիրառել: ['%*s'] և: ['text'].
փորձել կիրառել: ['%'] և: ['text'].

# length modifier does not fit
փորձել կիրառել: ['%ls'] և: ['text'].
փորձել կիրառել: ['%Lf'] և: 5.5.
try-int կիրառել: ['%ld'] և: 7.
try-int կիրառել: ['%lld'] և: 7.
փորձել կիրառել: ['%Ld'] և: (Int64 նոր տողից: ['12']).

# a width that does not fit printf must give an error, not a crash
փորձել կիրառել: ['%99999999999s'] և: ['text'].
