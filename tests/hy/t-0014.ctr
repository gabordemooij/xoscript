>> Greeter := Օբյեկտ նոր.
Greeter ստանալիս: ['make'] կատարել: {
	>> gr := Օբյեկտ նոր.
	gr ստանալիս: ['setName:'] կատարել: { :aname
		սեփական անուն := aname.
	}.
	gr ստանալիս: ['greet'] կատարել: {
		Ելք գրել: սեփական անուն.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a նոր.
c setName: ['THREE'].
c greet.
>> d := a նոր.
d setName: ['FOUR'].
d greet.
c greet.
