>> makeAdder := { :x
	>> f := { :y <- (սեփական x + y). } սահմանել: ['x'] արժեք: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i սեփական q դնել: (սեփական f կիրառել: (սեփական q ? i)) բանալի: i. } 
	սահմանել: ['q'] արժեք: array,
	սահմանել: ['f'] արժեք: func.
	{ :i mapping կիրառել: i. } × (array քանակ).
}.

>> a := Ցուցակ ← 1; 2; 3.
mapper կիրառել: a և: (makeAdder կիրառել: 100).
Ելք գրել: (a դիրք: 0), նոր-տող.
Ելք գրել: (a ? 1), նոր-տող.
Ելք գրել: (a ? 2), նոր-տող.
