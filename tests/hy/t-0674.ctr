# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> ուղի := ['/tmp/dat.csv'].
>> csv := Ֆայլ նոր: ուղի.
csv գրել: s.

# accepts CRLF LF CR, varying row length
csv բաժանիչ: [';'] չակերտ: ['"'] տողեր: { :line
	Ծրագիր մաքրել.
	Ելք գրել: line, նոր-տող.
	Ծրագիր մաքրել.
}.

# unequal lines
s ավելացնել-վերջում: ['\njustone'].
csv գրել: s.
{
	csv բաժանիչ: [';'] չակերտ: ['"'] տողեր: { :line
		Ելք գրել: line, նոր-տող.
	}.
} որսալ: { :e 
	Ելք գրել: e, նոր-տող.
}, գործարկել.

# invalid format
s := ['"he"llo";world'].
csv գրել: s.
{
	csv բաժանիչ: [';'] չակերտ: ['"'] տողեր: { :line
		Ելք գրել: line, նոր-տող.
	}.
} որսալ: { :e 
	Ելք գրել: e, նոր-տող.
}, գործարկել.
