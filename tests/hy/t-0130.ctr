# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Ծրագիր կարգավորում: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server կապել: ( Ցուցակ նոր ;
 libname ; ['fopen'] ;
 ( Ցուցակ նոր ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
կապել: ( Ցուցակ նոր ;
 Դատարկ ; # means same lib
 ['fread'] ;
 ( Ցուցակ նոր ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Դատարկ ; # means same object (i.e. Stream)
 ['fread']
),
կապել: (
 Ցուցակ նոր ;
 Դատարկ ; # means same lib
 ['fwrite'] ;
 ( Ցուցակ նոր ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Դատարկ ; # means same lib
 ['fwrite']
),
կապել: (
 Ցուցակ նոր ;
 Դատարկ ; # means same lib
 ['rewind'] ;
 ( Ցուցակ նոր ; ['pointer'] ) ;
 ['int'] ;
 Դատարկ ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> ուղի := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: ուղի mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream հաղորդագրություն: ['fwrite'] արգումենտներ: (Ցուցակ նոր ; str ; 1 ; 6 ; fd ).
Ելք գրել: bytes-written, նոր-տող.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob նոր: 20.

# read from file
>> bytes-read := Stream հաղորդագրություն: ['fread'] արգումենտներ: (Ցուցակ նոր ; buf ; 1 ; 6 ; fd ).
Ելք գրել: bytes-read, նոր-տող.
Ելք գրել: buf, նոր-տող.

# free memory
str  ազատել.
ուղի ազատել.
mode ազատել.
buf  ազատել.


