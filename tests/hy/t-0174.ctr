


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Ծրագիր հիշողության-կառավարում: 0.
>> palette := Դատարկ.
>> colors := Դատարկ.

{
palette := Բառարան նոր.
palette 
	դնել: ['#F00'] բանալի: ['red'],
	դնել: ['#0F0'] բանալի: ['green'],
	դնել: ['#00F'] բանալի: ['blue'].
Ելք գրել: ['number of RGB codes in palette: '] + ( palette քանակ ), նոր-տող.
Ելք գրել: ['RGB code of green is: '] + ( palette ? ['green'] ), նոր-տող.
colors := [''].
( palette յուրաքանչյուր: { :անուն :կոդ
		colors := colors + ( անուն + [':'] + կոդ ).
} ).
Ելք գրել: ['All colors in palette: '] + colors, նոր-տող.
} գործարկել.
Ծրագիր մաքրել.
usedMemory1 := (Ծրագիր հիշողություն ? 0).

{
palette := Բառարան նոր.
palette 
	դնել: ['#F00'] բանալի: ['red'],
	դնել: ['#0F0'] բանալի: ['green'],
	դնել: ['#00F'] բանալի: ['blue'].
Ելք գրել: ['number of RGB codes in palette: '] + ( palette քանակ ), նոր-տող.
Ելք գրել: ['RGB code of green is: '] + ( palette ? ['green'] ), նոր-տող.
colors := [''].
( palette յուրաքանչյուր: { :անուն :կոդ
		colors := colors + ( անուն + [':'] + կոդ ).
} ).
Ելք գրել: ['All colors in palette: '] + colors, նոր-տող.
} գործարկել.
Ծրագիր մաքրել.
usedMemory2 := (Ծրագիր հիշողություն ? 0).

{
palette := Բառարան նոր.
palette 
	դնել: ['#F00'] բանալի: ['red'],
	դնել: ['#0F0'] բանալի: ['green'],
	դնել: ['#00F'] բանալի: ['blue'].
Ելք գրել: ['number of RGB codes in palette: '] + ( palette քանակ ), նոր-տող.
Ելք գրել: ['RGB code of green is: '] + ( palette ? ['green'] ), նոր-տող.
colors := [''].
( palette յուրաքանչյուր: { :անուն :կոդ
		colors := colors + ( անուն + [':'] + կոդ ).
} ).
Ելք գրել: ['All colors in palette: '] + colors, նոր-տող.
} գործարկել.
Ծրագիր մաքրել.
usedMemory3 := (Ծրագիր հիշողություն ? 0).



( usedMemory1 = usedMemory2 և: usedMemory1 = usedMemory3, և: usedMemory2 = usedMemory3 ) եթե-ճիշտ: {
	Ելք գրել: ['No memory leaks here'].
}, եթե-սխալ: {
	Ելք գրել: ['Leaking memory...'].
}.
