
>> countries := Ցուցակ նոր
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Ցուցակ նոր
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods ըստ: countries, յուրաքանչյուր: { :key :value
	counter գումարել: 1.
}.

Ելք գրել: (['we serve counter dishes'] counter: counter), նոր-տող.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] նիշեր դասավորել: { :v
	counter գումարել: 0.
}.

Ելք գրել: (['we sort counter dishes'] counter: counter), նոր-տող.


>> counter := 0.
{
	{
		counter գումարել: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Ելք գրել: (['we calculate counter numbers.'] counter: counter), նոր-տող.

