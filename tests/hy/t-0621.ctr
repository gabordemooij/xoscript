>> phrases := Ցուցակ նոր
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases յուրաքանչյուր: { :_ :phrase 
	>> e := Server base64-կոդավորել: phrase.
	>> d := Server base64-ապակոդավորել: e.
	Ելք գրել: (
		message պատճենել ~encoded: e, ~decoded: d
	), նոր-տող.
}.
