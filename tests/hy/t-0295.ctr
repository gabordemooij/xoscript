
>> dictionary := (
	Բառարան նոր
		դնել: ['b'] բանալի: ['a'],
		դնել: ['a'] բանալի: ['b'],
		դնել: ['z'] բանալի: ['x'],
		դնել: ['hello'] բանալի: ['hallo'],
		դնել: ['human'] բանալի: ['human']
).

>> comparisons := Ցուցակ նոր.
dictionary յուրաքանչյուր: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a համեմատել: b)
	).
}.

comparisons դասավորել: { :a :b <- ( a համեմատել: b ). }.
Ելք գրել: ( comparisons միացնել: ['↵'] ), նոր-տող.
comparisons միացնել: ['↵'].
