#OBSD
>> dirname := [''].
{ dirname append: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Program os: command.
Program chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename append: ['YYYYYYYY']. } * 20.
File new: filename, write: ['sometext'].
{ File list: ['/tmp/'] + dirname. } * 1000.
Out write: ['no crash'], stop.

