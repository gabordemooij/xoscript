
Daptar nalika: ['sum'] lakukeun: {
	>> total := 0.
	diri unggal: { :index :element
		total tambah: element.
	}. <- total.
}.

>> a := Daptar ← 9 ; 8 ; 7.
Kaluaran tulis: (a sum), baris-anyar. 
>> a := Daptar ← 1 ; 9.
Kaluaran tulis: (a sum), baris-anyar. 
>> a := Daptar ← ['o'] ; 2.
Kaluaran tulis: (a sum), baris-anyar. 
Kaluaran tulis: (Daptar anyar sum), baris-anyar. 
