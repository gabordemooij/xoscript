

Daptar nalika: ['column:'] lakukeun: { :column
	>> result := Daptar anyar.
	diri unggal: { :index :row
		row unggal: { :index :cell
			(index = column) bener: { result tambah-di-tungtung: cell. }.
		}.
	}. <- result.
}.


>> a := Daptar ←
	(Daptar ← 1 ; 2 ; 3) ;
	(Daptar ← 4 ; 5 ; 6) ;
	(Daptar ← 7 ; 8 ; 9).

>> b := a column: 1.
Kaluaran tulis: b, baris-anyar.

b := a column: 20.
Kaluaran tulis: b, baris-anyar.

b := a column: -100.
Kaluaran tulis: b, baris-anyar.
