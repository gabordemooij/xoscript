Kaluaran tulis: ['Continue for-loop, No - before 6 and up.'], baris-anyar.
{ :i
	Kaluaran tulis: (i + 1), baris-anyar.
	((i + 1) > 4) nuluykeun.
	Kaluaran tulis: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Kaluaran baris-anyar.
Kaluaran tulis: ['Continue while-true, No --> before 5 and up.'], baris-anyar.
{
	Kaluaran tulis: ['iteration #'] + x, baris-anyar.
	x tambah: 1.
	((x < 5) lain) nuluykeun.
	Kaluaran tulis: ['-->'].
} salila: xIsLessThan10.
Kaluaran baris-anyar.
Kaluaran tulis: ['Continue while-false, No - before 3 only.'], baris-anyar.
{
	Kaluaran tulis: ['iteration #'] + x, baris-anyar.
	x kurangan: 1.
	(x = 3) nuluykeun.
	Kaluaran tulis: ['-'].
} salila: { <- ( x > 0). }.

Kaluaran baris-anyar.
Kaluaran tulis: ['Continue times-loop, No ||| before 3.'], baris-anyar.
{ :i
	Kaluaran tulis: ['iteration #'] + i, baris-anyar.
	(i = 2) nuluykeun.
	Kaluaran tulis: ['|||'].
} × 5.

Kaluaran baris-anyar.

{ Bener nuluykeun. Kaluaran tulis: ['dont write this!'], baris-anyar. } jalankeun.

{ Bener nuluykeun. Kaluaran tulis: ['dont write this!'], baris-anyar. } tangkep: { Kaluaran tulis: ['Dont catch this!']. }, jalankeun.

Kaluaran tulis: ['Test Array each-loop: 0, ... ,2'], baris-anyar.
(Daptar ← 1 ; 2 ; 3) robah-unggal: { :i
	(i = 1) nuluykeun.
	Kaluaran tulis: ['iteration #'] + (i - 0), baris-anyar.
}.

Kaluaran tulis: ['Test Map each-loop: c only'], baris-anyar.
>> m := Kamus anyar.
m teundeun: ['first'] di: ['a'], teundeun: ['second'] di: ['b'], teundeun: ['third'] di: ['c'].
m unggal: { :k :v
	(k ≠ ['c']) nuluykeun.
	Kaluaran tulis: ['iteration'] + k + v, baris-anyar.
}.

