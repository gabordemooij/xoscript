>> t := Kosong.

# you can control the time zone for
# parsing like this:
Waktu zona: ['CET'].
t := Waktu tina: ['1981-02-03 04:05:06'].
Kaluaran tulis: t, baris-anyar.

# now using CEST time zone:
Waktu zona: ['CEST'].
t := Waktu tina: ['1981-02-03 04:05:06'].
Kaluaran tulis: t, baris-anyar.

# error if string cannot be parsed
{ Waktu tina: ['1900']. } tangkep: { Kosong. }, jalankeun.
