>> x := Waktu anyar.
x zona: ['CEST'],
taun:2017,
bulan:01,
poé:10,
jam: 10,
menit: 0,
detik: 0.

Kaluaran tulis: x, baris-anyar.

Kaluaran tulis: x wanci, baris-anyar.

x tambah: 1 detik.
x tambah: 2 menit.
x tambah: 3 jam.
x tambah: 4 poé.
x tambah: 1 bulan.
x tambah: 6 taun.

Kaluaran tulis: x, baris-anyar.

x kurangan: 1 detik.
x kurangan: 2 menit.
x kurangan: 3 jam.
x kurangan: 4 poé.
x kurangan: 1 bulan.
x kurangan: 6 taun.

Kaluaran tulis: x, baris-anyar.

>> y := x salin.
>> z := x.

Kaluaran tulis: y, baris-anyar.
Kaluaran tulis: z, baris-anyar.
Kaluaran tulis: (x zona = y zona), baris-anyar.
Kaluaran tulis: (x wanci = y wanci), baris-anyar.
Kaluaran tulis: (x = z), baris-anyar.
Kaluaran tulis: x poé-dina-taun, baris-anyar.
Kaluaran tulis: x poé-dina-minggu, baris-anyar.
Kaluaran tulis: x minggu, baris-anyar.
