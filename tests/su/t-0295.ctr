
>> dictionary := (
	Kamus anyar
		teundeun: ['b'] di: ['a'],
		teundeun: ['a'] di: ['b'],
		teundeun: ['z'] di: ['x'],
		teundeun: ['hello'] di: ['hallo'],
		teundeun: ['human'] di: ['human']
).

>> comparisons := Daptar anyar.
dictionary unggal: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a bandingkeun: b)
	).
}.

comparisons runtuykeun: { :a :b <- ( a bandingkeun: b ). }.
Kaluaran tulis: ( comparisons gabungkeun: ['↵'] ), baris-anyar.
comparisons gabungkeun: ['↵'].
