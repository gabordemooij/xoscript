Téks nalika: ['evaluate'] lakukeun: {
	>> kode := Berkas anyar: ['/tmp/eval.ctr'].
	kode tulis: (diri téks + ['.']).
	Program paké: ['/tmp/eval.ctr'].
}.

>> a := Daptar ← 1 ; 2 ; 3.
>> b := (a téks).

Kaluaran tulis: b, baris-anyar. 
(['b := '] + b) evaluate.

Kaluaran tulis: b ? 2, baris-anyar. 

Kaluaran tulis: (( Daptar ← 1 ; 2 ; 3 )), baris-anyar. 

Kaluaran tulis: ((Kamus anyar) teundeun: 1 di: 2), baris-anyar. 

>> x := ( (Daptar ← 1 ; ( Daptar ← 9 ) ; Bener ) ) téks.
Kaluaran tulis: x, baris-anyar. 
(['x := '] + x) evaluate.

Kaluaran tulis: x ? 1 ? 0, baris-anyar. 

>> y := (Kamus anyar) teundeun: (Daptar ← 1) di: (Daptar ← 2).
Kaluaran tulis: y, baris-anyar. 

(['y := '] + y) téks evaluate.

Kaluaran tulis: (y di: (Daptar ← 2) téks ), baris-anyar.

Kaluaran tulis: (Daptar anyar), baris-anyar. 
Kaluaran tulis: (Kamus anyar), baris-anyar. 
