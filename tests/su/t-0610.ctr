
>> Rectangle := Obyek anyar.

Rectangle nalika: ['area'] lakukeun: { <- milik panjang * milik width.
}.

Rectangle nalika: ['length:'] lakukeun: { :panjang
	milik panjang := panjang.
}.

Rectangle nalika: ['width:'] lakukeun: { :width
	milik width := width.
}.

Rectangle nalika: ['anyar'] lakukeun: {
	# this will not result into an infinite loop
	>> rectangle := diri anyar.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle anyar.
Kaluaran tulis: a area, baris-anyar. #0

>> b := Rectangle anyar length: 2, width: 3.
Kaluaran tulis: b area, baris-anyar. #6

