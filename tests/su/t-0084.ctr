>> makeAdder := { :x
	>> f := { :y <- (milik x + y). } atur: ['x'] nilai: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i milik q teundeun: (milik f larapkeun: (milik q ? i)) di: i. } 
	atur: ['q'] nilai: array,
	atur: ['f'] nilai: func.
	{ :i mapping larapkeun: i. } × (array jumlah).
}.

>> a := Daptar ← 1; 2; 3.
mapper larapkeun: a jeung: (makeAdder larapkeun: 100).
Kaluaran tulis: (a posisi: 0), baris-anyar.
Kaluaran tulis: (a ? 1), baris-anyar.
Kaluaran tulis: (a ? 2), baris-anyar.
