
{ :i
	Kaluaran tulis: ['This is step #'] + ( ( i ) + 1 ), baris-anyar.
} × 6.

{ :i
	Kaluaran tulis: ['This is step #'] + ( 3 - ( i ) ), baris-anyar.
} × 6.

{ :i
	Kaluaran tulis: ['NEVER!'], baris-anyar.
} × 0.



{ :i
	Kaluaran tulis: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), baris-anyar.
} × 11.
