# test qualifiers

Program beresihan.

>> Fruit := Obyek anyar.
Fruit nalika: ['anyar'] lakukeun: {
	>> f := diri anyar.
	f apples: 0. <- f.
}.
Fruit nalika: ['apples:'] lakukeun: { :a milik apples := a. }.
Fruit nalika: ['apples'] lakukeun: { <- milik apples. }.
Fruit nalika: ['+'] lakukeun: { :f
	>> n := Fruit anyar.
	n apples: (f apples + milik apples). <- n.
}.
Angka nalika: ['apples'] lakukeun: { <- ((Fruit anyar) apples: diri).
}.

Fruit nalika: ['téks'] lakukeun: { <- milik apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Kaluaran tulis: q, baris-anyar.




