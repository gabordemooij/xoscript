Server init.

>> DB := Maria-DB anyar hos: ['localhost'],
	ngaran-pamaké: ['xo'],
	sandi: ['pass123'],
	ngaran-basis-data: ['xobase'],
	sambungkeun.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB kueri: SQL.

# now you don't have to set DB
query2 cokot: { :row
	Kaluaran tulis: row world, baris-anyar.
}.
