60 × {
	>> x := (Angka random % 6) + 1.
	(x ≤ 6) salah: { Kaluaran tulis: ['FAIL']. }.
	(x ≥0) salah: { Kaluaran tulis: ['FAIL']. }.
	x := (Angka random % 3) + 1.
	(x < 3) salah: { Kaluaran tulis: ['FAIL']. }.
	(x>-1) salah: { Kaluaran tulis: ['FAIL']. }.
	x := ((Boolean flip) angka).
	(x = 0 atawa: x = 1) salah: { Kaluaran tulis: ['FAIL']. }.
	x := ((Bener flip) angka).
	(x = 0 atawa: x = 1) salah: { Kaluaran tulis: ['FAIL']. }.
	x := (Boolean flip pilih: ['HEAD'] atawa: ['TAIL']).
	((x = ['HEAD']) atawa: (x = ['TAIL'])) salah: { Kaluaran tulis: ['FAIL']. }.
}.
Kaluaran tulis: ['DONE'].

