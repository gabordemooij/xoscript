>> numbers := ['1,2,3'] pisahkeun: [','].
Kaluaran tulis: ['I got: '] + numbers jumlah + [' numbers.'],baris-anyar.
{ :i Kaluaran tulis: ['number #'] + i + [':'] + (numbers posisi: i), baris-anyar.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages pisahkeun: [' Or '].
Kaluaran tulis: ['We serve'], baris-anyar.
{ :i Kaluaran tulis: ['->'] + (beverages posisi: i), baris-anyar. } × (beverages jumlah).
Kaluaran tulis: (beverages gabungkeun: [',']), baris-anyar.
Kaluaran tulis: (numbers gabungkeun: ['||']).
