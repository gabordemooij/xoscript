Server init.
Kaluaran tulis: ['Database date test'], baris-anyar.

>> db := Maria-DB anyar hos: ['localhost'],
	ngaran-pamaké: ['xo'], 
	sandi: ['pass123'],
	ngaran-basis-data: ['xobase'],
	sambungkeun.

>> paraméter-panéangan :=
db kueri: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
cokot: { :row
	Kaluaran tulis: row datetest, baris-anyar.
}.
