# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Brankas 
	hash-sandi: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Brankas 
	hash-sandi: hash pariksa: a1.
	# fail 
>> b := Brankas
	hash-sandi: hash pariksa: a2.
	# ok!

Kaluaran tulis: a, baris-anyar.
Kaluaran tulis: b, baris-anyar.

