# test buffers PKI/Sign 
Server init.

>> long := ( Daptar anyar eusian: 1000 ku: ['a'] ) gabungkeun: [''].

# sign a message
Kaluaran tulis: ( 
	Brankas tanda-tangan: ['abc'] maké: long
), baris-anyar.

Kaluaran tulis: ( 
	Brankas
		pariksa: ['abc'] 
		tanda-tangan: long 
		maké: long
), baris-anyar.

Kaluaran tulis: (
	Brankas hash-sandi: long pariksa: long
), baris-anyar.
