Server init.

>> DB := Maria-DB anyar hos: ['localhost'],
	ngaran-pamaké: ['xo'],
	sandi: ['pass123'],
	ngaran-basis-data: ['xobase'],
	sambungkeun.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> paraméter-panéangan := Maria-Kueri anyar: SQL.

# set database
paraméter-panéangan basis-data: DB.

paraméter-panéangan cokot: { :row
	Kaluaran tulis: row world, baris-anyar.
}.
