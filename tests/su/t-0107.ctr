
Kaluaran tulis: ['Break for-loop, 0-4.'], baris-anyar.
{ :i
	Kaluaran tulis: ['iteration #'] + i, baris-anyar.
	(i = 4) eureunkeun.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Kaluaran tulis: ['Break while-true loop, 0-4.'], baris-anyar.
{
	Kaluaran tulis: ['iteration #'] + x, baris-anyar.
	x tambah: 1.
	((x < 5) lain) eureunkeun.
} salila: xIsLessThan10.

Kaluaran tulis: ['Break while-false loop, 5,4.'], baris-anyar.
{
	Kaluaran tulis: ['iteration #'] + x, baris-anyar.
	x kurangan: 1.
	(x = 3) eureunkeun.
} salila: { <- (x > 0). }.

Kaluaran tulis: ['Break times loop, 1-4.'], baris-anyar.
{ :i
	Kaluaran tulis: ['iteration #'] + i, baris-anyar.
	(i = 4) eureunkeun.
} × 5.

Kaluaran tulis: ['Break block, dont print line.'], baris-anyar.
{ Bener eureunkeun. Kaluaran tulis: ['dont write this!'], baris-anyar. } jalankeun.

Kaluaran tulis: ['Break block, dont fire catch...'], baris-anyar.
{ Bener eureunkeun. Kaluaran tulis: ['dont write this!'], baris-anyar. } tangkep: { Kaluaran tulis: ['Dont catch this!']. }, jalankeun.

Kaluaran tulis: ['Test Array each-loop: 0,1'], baris-anyar.
(Daptar ← 1 ; 2 ; 3) robah-unggal: { :i
	Kaluaran tulis: ['iteration #'] + i, baris-anyar.
	(i = 1) eureunkeun.
}.

Kaluaran tulis: ['Test Map each-loop: c only'], baris-anyar.
>> m := Kamus anyar.
m teundeun: ['first'] di: ['a'], teundeun: ['second'] di: ['b'], teundeun: ['third'] di: ['c'].
m unggal: { :k :v
	Kaluaran tulis: ['iteration'] + v + k, baris-anyar.
	Bener eureunkeun.
}.

