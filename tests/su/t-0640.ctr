
Server init.
Kaluaran tulis: ['Database test'], baris-anyar.

>> db := Maria-DB anyar hos: ['localhost'],
	ngaran-pamaké: ['xo'], 
	sandi: ['pass123'],
	ngaran-basis-data: ['xobase'],
	sambungkeun.

>> paraméter-panéangan :=
db kueri: ['SELECT UNHEX('CAFE') AS blobby'],
cokot: { :row
	Kaluaran tulis: ( row blobby tina: 0 panjang: 2 ), baris-anyar.
	row blobby bébaskeun.
}.
