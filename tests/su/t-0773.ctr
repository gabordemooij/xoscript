Kaluaran tulis: ['Test object'], baris-anyar.
>> a := Obyek anyar. 
a nalika: ['item:'] lakukeun: { :int64
	milik int64 := int64. 
}.
a nalika: ['item'] lakukeun: { <- milik int64.
}.
a item: ( Int64 tina-téks: ['9999'] ).
Kaluaran tulis: a item, baris-anyar.
>> old-int64-address := a item prototipe alamat-mémori.
a save-as: ['/tmp/a.bin'].
Kaluaran tulis: ['========== RELOADING SNAP:'], baris-anyar.
>> b := Obyek load-from: ['/tmp/a.bin'].
(b item prototipe alamat-mémori = old-int64-address) bener: {
	Kaluaran tulis: ['Object link re-attached.'], baris-anyar.
}.
Kaluaran tulis: ( b item ), baris-anyar.
