


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program manajemén-mémori: 0.
>> palette := Kosong.
>> colors := Kosong.

{
palette := Kamus anyar.
palette 
	teundeun: ['#F00'] di: ['red'],
	teundeun: ['#0F0'] di: ['green'],
	teundeun: ['#00F'] di: ['blue'].
Kaluaran tulis: ['number of RGB codes in palette: '] + ( palette jumlah ), baris-anyar.
Kaluaran tulis: ['RGB code of green is: '] + ( palette ? ['green'] ), baris-anyar.
colors := [''].
( palette unggal: { :ngaran :kode
		colors := colors + ( ngaran + [':'] + kode ).
} ).
Kaluaran tulis: ['All colors in palette: '] + colors, baris-anyar.
} jalankeun.
Program beresihan.
usedMemory1 := (Program mémori ? 0).

