>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Obyek anyar.
⚄ nalika: ['drawFrom:length:'] lakukeun: { :pool :jumlah
	
	>> result := [''].
	
	{
		>> index := Angka random % (pool panjang).
		result tambah-di-tungtung: ( pool karakter: (index + 1) ).
		
	} × jumlah. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? panjang.
Kaluaran tulis: (['x↵'] x random panjang).
Kaluaran tulis: (['y↵'] y ?? panjang).

