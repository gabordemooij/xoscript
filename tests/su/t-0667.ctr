# test Program version

# this feature is disabled by default
Kaluaran tulis: (
	Program fitur: 
	['RECURSIVE_STRINTPOL']
), baris-anyar.


# but if we set the time back
>> today := Waktu 
zona: ['CEST'],
tina: ['2026-02-15 10:00:00'].
Program vérsi: today.

# it will be enabled like it used to be (from now on)
Kaluaran tulis: (
	Program fitur: 
	['RECURSIVE_STRINTPOL']
), baris-anyar.