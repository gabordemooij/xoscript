# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := Obyek anyar.

Log nalika: ['say:'] lakukeun: { :str
	Kaluaran tulis: str, baris-anyar.
}.

>> Item := Obyek anyar.

Item nalika: ['anyar:'] lakukeun: { :id <- diri anyar id: id.
}.

Item nalika: ['id:'] lakukeun: { :id
	milik id := id.
}.

Item nalika: ['id'] lakukeun: { <- milik id. }.


Item nalika: ['téks'] lakukeun: {
	>> str := ['Item#~no'].
	str ~no: milik id. <- str.
}.


>> Print := Obyek anyar.

Print nalika: ['items'] lakukeun: { 
	
	milik item := Item anyar: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: milik item
	).
	
	
}.

Print items.