>> a := Daptar ← Obyek ; Bener ; Salah ; Boolean ; 1 ; Angka ; ['Str'] ; Téks ; { ['Empty']. }.
Kaluaran tulis: (a jumlah), baris-anyar.
{ :i
	Kaluaran tulis: 
	['a '] + 
	((a ? i) tipe) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Kosong?) pilih: [''] atawa: ['NOT']) + 
	[' Nil.'],
	baris-anyar.
} × (a jumlah).
Kaluaran tulis: ['but.. Nil is.. '] + ((Kosong Kosong?) pilih: ['certainly NIL!'] atawa: ['not NIL??']), baris-anyar.