Daptar nalika: ['sum'] lakukeun: {
	>> total := 0.
	diri unggal: { :index :element
		total tambah: element.
	}. <- total.
}.

>> a := Bener.



a nalika: ['téks'] lakukeun: {
	>> answer := Kosong.
	( diri = Bener ) bener: {
		answer := ['Yep'].
	}, lamun-henteu: {
		answer := ['Nope'].
	}. <- answer.
}.

a nalika: ['angka'] lakukeun: {
	>> answer := Kosong.
	( diri = Bener ) bener: {
		answer := 10.
	}, lamun-henteu: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b nalika: ['téks'] lakukeun: { <- ['Devil'].
}.

b nalika: ['boolean'] lakukeun: { <- Salah.
}.


Kaluaran tulis: a, baris-anyar.  
Kaluaran tulis: (90 + a), baris-anyar. 
Kaluaran tulis: b, baris-anyar. 
Kaluaran tulis: (Bener jeung: b), baris-anyar.

a := Daptar ← ['hello'] ; ['world'] ; Bener ; Kosong ; 666. 
a := a + ( Daptar ← 1 ).
Kaluaran tulis: a, baris-anyar.
Kaluaran tulis: ((Kamus anyar) teundeun: Kosong di: Kosong), baris-anyar.
Kaluaran tulis: a sum, baris-anyar. 


{
	a nalika: ['téks'] lakukeun: { <- Kosong. }.
	a := [''] + a.
} tangkep: { :error
	Kaluaran tulis: ['Error noted: '] + error, baris-anyar.
}, jalankeun.



{
	a nalika: ['angka'] lakukeun: { <- Kosong. }.
	a := 3 × a.
} tangkep: { :error
	Kaluaran tulis: ['Error noted: '] + error, baris-anyar.
}, jalankeun.


{
	a nalika: ['boolean'] lakukeun: { <- Kosong. }.
	a := Bener jeung: a. 
} tangkep: { :error
	Kaluaran tulis: ['Error noted: '] + error, baris-anyar.
}, jalankeun.





