Kaluaran tulis: ['1,2,3,4,5,6,7,8,9,A,'], baris-anyar.
>> Scope := Obyek anyar.
Scope nalika: ['initialize:'] lakukeun: { :x milik property := x. }.
Scope nalika: ['confirm'] lakukeun: { Kaluaran tulis: [',']. }.
Scope nalika: ['uji'] lakukeun: {
	Kaluaran tulis: milik property.
	diri confirm.
	( 1 = 1 ) bener: { Kaluaran tulis: milik property. diri confirm. }.
	( 1 = 0 ) salah: { Kaluaran tulis: milik property. diri confirm. }.
	>> y := 2. { Kaluaran tulis: milik property. diri confirm. } salila: { y kurangan: 1. <- (y > 0). }.
	{ Kaluaran tulis: milik property. diri confirm. } × 1.
	(Daptar ← 1) unggal: {  Kaluaran tulis: milik property. diri confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Kamus anyar one: ['item']) unggal: { Kaluaran tulis: milik property. diri confirm. }.
	{ 1 ÷ 0. } tangkep: { Kaluaran tulis: milik property. diri confirm. }, jalankeun.
	Kaluaran baris-anyar.
}.
>> scope1 := Scope anyar.
scope1 initialize: ['X'].
scope1 uji.
>> function := { 
	milik property := ['Y'].
	Kaluaran tulis: milik property.
	diri confirm.
	( 1 = 1 ) bener: { Kaluaran tulis: milik property. diri confirm. }.
	( 1 = 0 ) salah: { Kaluaran tulis: milik property. diri confirm. }.
	>> y := 2. { Kaluaran tulis: milik property. diri confirm. } salila: { y kurangan: 1. <- (y > 0). }.
	{ Kaluaran tulis: milik property. diri confirm. } × 1.
	(Daptar ← 1) unggal: {  Kaluaran tulis: milik property. diri confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Kamus anyar one: ['item']) unggal: { Kaluaran tulis: milik property. diri confirm. }.
	{ 1 ÷ 0. } tangkep: { Kaluaran tulis: milik property. diri confirm. }, jalankeun.
	Kaluaran baris-anyar.
}.
function nalika: ['confirm'] lakukeun: { Kaluaran tulis: [',']. }.
function larapkeun: 1 jeung: 2.
