>> t := Bener.
(t = Bener) bener: { Kaluaran tulis: ['T']. }.
(t = Salah) bener: { Kaluaran tulis: ['F']. }.
Kaluaran tulis: ['|'].
>> t := Salah.
(t = Bener) bener: { Kaluaran tulis: ['T']. }.
(t = Salah) bener: { Kaluaran tulis: ['F']. }.
Kaluaran tulis: ['|'].
>> f := Bener.
(t = Bener jeung: f = Salah) bener: { Kaluaran tulis: ['T']. }.
(t = Salah jeung: f = Bener) bener: { Kaluaran tulis: ['F']. }.
Kaluaran tulis: ['|'].
>> n := Kosong.
(n Kosong?) bener: { Kaluaran tulis: ['T']. }.
(n Kosong?) salah: { Kaluaran tulis: ['F']. }.
Kaluaran tulis: ['|'].
(f Boolean?) bener: { Kaluaran tulis: ['T']. }.
(f Boolean?) salah: { Kaluaran tulis: ['F']. }.



