Angka nalika: ['factorial'] lakukeun: {
	>> total := 1.
	{ :index total kalikeun-ku: (diri - (index)). } × diri. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Kaluaran tulis: a.
>> b := 2 + 3 factorial.
Kaluaran tulis: b.
>> c := 3 factorial + 2.
Kaluaran tulis: c.
>> d := 2 + (3 factorial).
Kaluaran tulis: d.
Kaluaran tulis: 2 + 3 factorial + 1.
