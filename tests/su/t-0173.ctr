

Daptar nalika: ['sum'] lakukeun: {
	>> total := 0.
	diri unggal: { :index :element
		total tambah: element.
	}. <- total.
}.

Daptar nalika: ['product'] lakukeun: {
	>> total := 1.
	diri unggal: { :index :element
		total kalikeun-ku: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program manajemén-mémori: 0.

{

>> a := Daptar ← ['hello'] ; ['world'] ; Bener ; Kosong ; 666.
a := a + ( Daptar ← 1 ).
Kaluaran tulis: ( ['sum: '] + ( a sum ) ), baris-anyar.
Kaluaran tulis: ( ['min: '] + ( a minimum ) ), baris-anyar.
Kaluaran tulis: ( ['max: '] + ( a maksimum ) ), baris-anyar.
Kaluaran tulis: ( ['3rd: '] + ( a ? 2 ) ), baris-anyar.
Kaluaran tulis: ( ['prd: '] + ( a product ) ), baris-anyar.
a runtuykeun: { :a :b <- (b - a). }.
a unggal: { :i :e Kaluaran tulis: ( i - 0 ), baris-anyar. }.

} jalankeun.

Program beresihan.
