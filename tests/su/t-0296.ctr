
>> shop := (Kamus anyar
	teundeun: ['magazine'] di: ['books'],
	teundeun: ['computer'] di: ['electronics'],
	teundeun: ['lipstick'] di: ['cosmetics']
).
Kaluaran tulis: (shop miboga: ['computer']), baris-anyar. 
Kaluaran tulis: (shop miboga: ['sausage']), baris-anyar. 
Kaluaran tulis: (shop miboga: ['computers']), baris-anyar. 
Kaluaran tulis: (shop miboga: ['compute']), baris-anyar. 
Kaluaran tulis: (shop miboga: ['2computer']), baris-anyar. 
