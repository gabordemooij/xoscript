# test url parsing

Server init.
>> url := URL tina: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Kaluaran tulis: ['scheme = '] + url skéma, baris-anyar.
Kaluaran tulis: ['host = '] + url hos, baris-anyar.
Kaluaran tulis: ['port = '] + url porta, baris-anyar.
Kaluaran tulis: ['path = '] + url jalur, baris-anyar.
Kaluaran tulis: ['query = '] + url paraméter-panéangan, baris-anyar.
Kaluaran tulis: ['fragment = '] + url sempalan, baris-anyar.
