

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program manajemén-mémori: 0.

>> txt := ['World Salad'].
Kaluaran tulis: ['this text contains: '] + ( ( txt pisahkeun: [' '] ) jumlah ) + [' words.'], baris-anyar.
txt := txt tina: 6 panjang: 4.
Kaluaran tulis: txt, baris-anyar.

Program beresihan.

usedMemory1 := (Program mémori ? 0).


txt := ['World Salad'].
Kaluaran tulis: ['this text contains: '] + ( ( txt pisahkeun: [' '] ) jumlah ) + [' words.'], baris-anyar.
txt := txt tina: 6 panjang: 4.
