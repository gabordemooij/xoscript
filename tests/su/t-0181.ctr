Program beresihan.
usedMemory2 := (Program mémori ? 0).


txt := ['World Salad'].
Kaluaran tulis: ['this text contains: '] + ( ( txt pisahkeun: [' '] ) jumlah ) + [' words.'], baris-anyar.
