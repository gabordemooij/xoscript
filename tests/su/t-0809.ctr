# backslashes must survive code serialization, strings must not end early
>> nilai-nilai := Daptar anyar
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

nilai-nilai unggal: { :i :value
	>> d := Kamus anyar.
	d teundeun: value di: ['k'].
	>> r := d kode obyek.
	Kaluaran tulis: r jumlah, baris-anyar.
	Kaluaran tulis: ( (r di: ['k']) = value ), baris-anyar.
}.
