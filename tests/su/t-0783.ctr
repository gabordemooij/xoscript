Kaluaran tulis: ['Test object'], baris-anyar.
>> a := Obyek anyar. 

a nalika: ['item:'] lakukeun: { :moment
	milik moment := moment. 
}.

a nalika: ['item'] lakukeun: { <- milik moment.
}.

>> today := Waktu anyar zona: ['CEST'], taun: 2026, bulan: 7.
a item: today.
Kaluaran tulis: a item, baris-anyar.
a save-as: ['/tmp/a.bin'].

