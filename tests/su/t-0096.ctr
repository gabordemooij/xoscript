
>> Product := Obyek anyar.
Product nalika: ['a'] lakukeun: { :price
	Kaluaran tulis: ['cost ']+ price.
}.
>> Apples := Product anyar.
Kaluaran tulis: ['Apples cost: '].
Apples a 60.
Kaluaran tulis: [' cent a piece.'].


Angka nalika: ['X'] lakukeun: { :b
	b × diri. 
}.
7 X { :i Kaluaran tulis: i. }.
