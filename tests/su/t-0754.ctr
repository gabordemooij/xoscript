Kaluaran tulis: ['Test object'], baris-anyar.
>> a := Obyek anyar. 

a nalika: ['item:'] lakukeun: { :out
	milik out := out. 
}.

a nalika: ['item'] lakukeun: { <- milik out.
}.

a nalika: ['greet'] lakukeun: {
	Kaluaran tulis: ['hi from original out!'], baris-anyar.
}.

a item: Kaluaran.

Kaluaran tulis: a item, baris-anyar.

>> old-out-address := a item prototipe alamat-mémori.
a save-as: ['/tmp/a.bin'].
Kaluaran tulis: ['========== RELOADING SNAP:'], baris-anyar.

>> b := Obyek load-from: ['/tmp/a.bin'].

(b item prototipe alamat-mémori = old-out-address) bener: {
	Kaluaran tulis: ['Object link re-attached.'], baris-anyar.
}.

b item tulis: ['hello from loaded out!'], baris-anyar.
b greet.
