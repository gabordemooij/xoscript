Angka nalika: ['roman'] lakukeun: {
	>> angka := diri salin.
	>> roman := [''].
	{
		{
			(angka ≥ 1000) bener: {
				roman tambah-di-tungtung: ['Ⅿ'].
				angka kurangan: 1000.
			}, eureunkeun.
		
			(angka ≥ 500) bener: {
				roman tambah-di-tungtung: ['Ⅾ'].
				angka kurangan: 500.
			}, eureunkeun.
		
			(angka ≥ 100) bener: {
				roman tambah-di-tungtung: ['Ⅽ'].
				angka kurangan: 100.
			}, eureunkeun.
		
			(angka ≥ 50) bener: {
				roman tambah-di-tungtung: ['Ⅼ'].
				angka kurangan: 50.
			}, eureunkeun.
		
			(angka ≥ 50) bener: {
				roman tambah-di-tungtung: ['Ⅼ'].
				angka kurangan: 50.
			}, eureunkeun.
		
			(angka ≥ 10) bener: {
				roman tambah-di-tungtung: ['Ⅹ'].
				angka kurangan: 10.
			}, eureunkeun.
			
			(angka ≥ 9) bener: {
				roman tambah-di-tungtung: ['Ⅸ'].
				angka kurangan: 9.
			}, eureunkeun.
			
			(angka ≥ 5) bener: {
				roman tambah-di-tungtung: ['Ⅴ'].
				angka kurangan: 5.
			}, eureunkeun.
			
			(angka ≥ 4) bener: {
				roman tambah-di-tungtung: ['Ⅳ'].
				angka kurangan: 4.
			}, eureunkeun.
			
			(angka ≥ 1) bener: {
				roman tambah-di-tungtung: ['Ⅰ'].
				angka kurangan: 1.
			}, eureunkeun.
		} prosedur.
	} salila: { <- angka > 0. }. <- roman.
}.

Kaluaran tulis: 1 roman, baris-anyar.
Kaluaran tulis: 2 roman, baris-anyar.
Kaluaran tulis: 4 roman, baris-anyar.
Kaluaran tulis: 8 roman, baris-anyar.
Kaluaran tulis: 16 roman, baris-anyar.
Kaluaran tulis: 32 roman, baris-anyar.
Kaluaran tulis: 64 roman, baris-anyar.
Kaluaran tulis: 128 roman, baris-anyar.
Kaluaran tulis: 256 roman, baris-anyar.
Kaluaran tulis: 1024 roman, baris-anyar.
