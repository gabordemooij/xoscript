>> To-Do := Obyek anyar.

To-Do nalika: ['anyar'] lakukeun: {
	milik list := Daptar anyar.
}.

To-Do nalika: ['nieuw'] lakukeun: {
	milik list := Daptar anyar.
}.

To-Do nalika: ['+'] lakukeun: { :task
	milik list tambah-di-tungtung: task.
}.

To-Do nalika: ['number of tasks?'] lakukeun: { <-  milik list jumlah.
}.

>> todos := 
	To-Do anyar 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Kaluaran tulis: ['You have $ tasks to do'] $ todos number of tasks?.
