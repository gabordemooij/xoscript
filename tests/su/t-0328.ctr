Program manajemén-mémori: 4.

>> Doubler := Obyek anyar.
>> Multiplier := Obyek anyar.
Doubler nalika: ['double:and:'] lakukeun: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier nalika: ['multiply:and:'] lakukeun: { :x :y <- (x × y).
}.

Kaluaran tulis: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), baris-anyar.
