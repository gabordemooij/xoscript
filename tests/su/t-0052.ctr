>> items := Kamus anyar.
items teundeun: ['green'] di: ['color-1'].
items teundeun: ['orange'] di: ['color-2'].
items teundeun: ['red'] di: ['color-3'].
>> i := 0.
>> s := [''].
items unggal: { :key :color
	Kaluaran tulis: ['color #'] + i + [' is: '] + color + [' '].
	i tambah: 1.
}.
Kaluaran tulis: i + [' colors!'].
