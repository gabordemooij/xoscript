Boolean nalika: ['xor:'] lakukeun: { :b <- ((diri jeung: b lain) atawa: (diri lain jeung: b)).
}.

Kaluaran tulis: ['Length is:'] + ['ABCD'] panjang.
>> x := ['ABCDE'].

Kaluaran tulis: ['Length is:'] + x panjang.
((['ABC'] panjang + 1 = 4) jeung: (2 ≠ 3)) lain lain bener: { Kaluaran tulis: ['Yes']. }.
(((3 > 4) atawa: (4 > 2)) jeung: (Bener atawa: Salah), jeung: (Bener xor: Bener) lain ) bener: { Kaluaran tulis: ['Yes']. }.
{ Kaluaran tulis: ['Running']. } jalankeun.
