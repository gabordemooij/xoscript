
Server init.
>> rq := Paménta-HTTP anyar.
Kaluaran tulis: ['HTTP-GET d[]=']  + ( rq get-daptar: ['d[]'] ), baris-anyar. # GET
Kaluaran tulis: ['HTTP-GET f[]=']  + ( rq get-daptar: ['f[]'] ), baris-anyar. # GET
Kaluaran tulis: ['HTTP-POST e[]='] + ( rq post-daptar: ['e[]'] ), baris-anyar. # GET
Kaluaran tulis: ['HTTP-POST c=']   + ( rq post: ['c'] ), baris-anyar. # GET
Kaluaran tulis: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), baris-anyar. # GET
