# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB anyar hos: ['localhost'],
	ngaran-pamaké: ['xo'],
	sandi: ['pass123'],
	ngaran-basis-data: ['xobase'],
	sambungkeun.

>> paraméter-panéangan := db kueri: ['SELECT %% FROM'].
{ paraméter-panéangan laksanakeun. } tangkep: { :e
	Kaluaran tulis: ( e ngandung: ['%%'] ), baris-anyar.
}, jalankeun.
