>> str := ['write:'].
Kaluaran pesen: ['tulis:'] argumén: (Daptar ← ['Hello World']), baris-anyar. 

Angka nalika: ['isbetween:and:'] lakukeun: { :a :b <- ((diri ≥ a) jeung: (diri ≤ b)).
}.

str := ['isbetween:and:'].
Kaluaran tulis: (3 pesen: str argumén: (Daptar ← 2 ; 8)), baris-anyar.
Kaluaran tulis: (3 pesen: str argumén: (Daptar ← 1 ; 2)), baris-anyar.


>> CoffeeMachine := Obyek anyar.
CoffeeMachine nalika: ['makeCoffeeWithSugar:milk:'] lakukeun: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Daptar ← 4 ; 2.
Kaluaran tulis: ( CoffeeMachine pesen: order argumén: coffeeConfiguration ), baris-anyar.
