#Linux
>> clock := Waktu anyar.
clock zona: ['UTC-1'].
clock taun: 1981, bulan: 1, poé: 5,
      jam: 13, menit: 15, detik: 13.

Kaluaran tulis: clock, baris-anyar.
clock zona: ['UTC+0'].

Kaluaran tulis: (
	(clock taun polos) + ['-'] + (clock bulan) + ['-'] + (clock poé) + [' '] +
	(clock jam) + [':'] + (clock menit) + [':'] + (clock detik) + [' '] +
	['W'] + (clock minggu) + (clock zona)
), baris-anyar.


clock zona: ['UTC-1'].
Kaluaran tulis: (
	(clock taun polos) + ['-'] + (clock bulan) + ['-'] + (clock poé) + [' '] +
	(clock jam) + [':'] + (clock menit) + [':'] + (clock detik) + [' '] +
	['W'] + (clock minggu) + (clock zona)
), baris-anyar.
