>> x := Obyek anyar.
>> y := Obyek anyar.
>> z := x.
Kaluaran tulis: (x = z), baris-anyar.
Kaluaran tulis: (x = y), baris-anyar.
Kaluaran tulis: (x ≠ y), baris-anyar.
Kaluaran tulis: (x ≠ z), baris-anyar.
>> m := Waktu anyar taun: 2070, bulan: 11.
>> n := m salin.
Kaluaran tulis: (m = n), baris-anyar.
Kaluaran tulis: (m ≠ n), baris-anyar.
Kaluaran tulis: (m sarua-jeung: m), baris-anyar.
Kaluaran tulis: (m sarua-jeung: n), baris-anyar.
n bulan: 12.
Kaluaran tulis: (m ≠ n), baris-anyar.
Kaluaran tulis: (m = n), baris-anyar.


