Téks nalika: ['html'] lakukeun: { <- (
		diri
		ganti: ['&'] ku: ['&amp;'],
		ganti: ['<'] ku: ['&lt;'],
		ganti: ['>'] ku: ['&gt;'],
		ganti: ['''] ku: ['&apos;'],
		ganti: ['"'] ku: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program manajemén-mémori: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Kaluaran tulis: txt salin html, baris-anyar.
Kaluaran tulis: txt salin hurup-leutik, baris-anyar.
Kaluaran tulis: txt salin hurup-gedé, baris-anyar.
} jalankeun.

Program beresihan.

usedMemory1 := (Program mémori ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Kaluaran tulis: txt salin html, baris-anyar.
Kaluaran tulis: txt salin hurup-leutik, baris-anyar.
Kaluaran tulis: txt salin hurup-gedé, baris-anyar.
} jalankeun.

Program beresihan.
usedMemory2 := (Program mémori ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Kaluaran tulis: txt salin html, baris-anyar.
Kaluaran tulis: txt salin hurup-leutik, baris-anyar.
Kaluaran tulis: txt salin hurup-gedé, baris-anyar.
} jalankeun.

Program beresihan.
usedMemory3 := (Program mémori ? 0).



( usedMemory1 = usedMemory2 jeung: usedMemory1 = usedMemory3, jeung: usedMemory2 = usedMemory3 ) bener: {
	Kaluaran tulis: ['No memory leaks here'].
}, salah: {
	Kaluaran tulis: ['Leaking memory...'].
}.
