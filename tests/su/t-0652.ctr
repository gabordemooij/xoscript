# test number -> string -> number
{

	>> x := Angka antara: 0 jeung: 1000000.
	>> d := Angka antara: 1 jeung: 7.
	>> e := 10 pangkat: d.

	x bagi-ku: e.
	>> y := x téks angka.

	(x = y) salah: {
		Kaluaran tulis: x, baris-anyar.
		Kaluaran tulis: y, baris-anyar.
		Program réngsékeun.
	}.

} * 1000.
Kaluaran tulis: ['OK'], baris-anyar.