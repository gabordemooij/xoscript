

>> Cat := Obyek anyar.

Cat nalika: ['anyar'] lakukeun: {
	milik sound := ['meow!'].
}.

Cat nalika: ['nieuw'] lakukeun: {
	milik sound := ['meow!'].
}.

Cat nalika: ['makeSound'] lakukeun: { <- milik sound.
}.

Cat nalika: ['greet'] lakukeun: { <- diri makeSound.
}.

>> cat := Cat anyar.
Kaluaran tulis: cat greet.
