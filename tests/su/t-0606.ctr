>> Point := Obyek anyar.
Point nalika: ['x-coordinate:'] lakukeun: { :x milik x := x. }.
Point nalika: ['y-coordinate:'] lakukeun: { :y milik y := y. }.
Point nalika: ['x-coordinate']  lakukeun: { <- milik x salin. }.
Point nalika: ['y-coordinate']  lakukeun: { <- milik y salin. }.

Point nalika: ['='] lakukeun: { :other <- ( milik x = other x-coordinate
		 jeung: milik y = other y-coordinate ).
}.

>> pier := Point anyar x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point anyar x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point anyar x-coordinate: 5, y-coordinate: 6.

Kaluaran tulis: pier = town-hall, baris-anyar.
Kaluaran tulis: pier = restaurant, baris-anyar.
