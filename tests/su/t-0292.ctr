>> winery := { <- (	Kamus anyar
		teundeun: 2 di: ['merlot'],
		teundeun: 3 di: ['malbec'],
		teundeun: 4 di: ['syrah']
	).
}.

Kaluaran tulis: (((winery jalankeun) - ['nothing']) jumlah), baris-anyar.
Kaluaran tulis: (((winery jalankeun) - ['merlot']) jumlah), baris-anyar.
Kaluaran tulis: (((winery jalankeun) - ['malbec']) jumlah), baris-anyar.
Kaluaran tulis: (((winery jalankeun) - ['syrah']) jumlah), baris-anyar.
Kaluaran tulis: (((winery jalankeun) - ['merlot'] - ['malbec']) jumlah), baris-anyar.
Kaluaran tulis: (((winery jalankeun) - ['merlot'] - ['syrah']) jumlah), baris-anyar.
Kaluaran tulis: (((winery jalankeun) - ['malbec'] -['syrah']) jumlah), baris-anyar.
Kaluaran tulis: (((winery jalankeun) - ['malbec'] - ['syrah'] - ['merlot']) jumlah), baris-anyar.

