Daptar nalika: ['salin'] lakukeun: {
	>> salin := Daptar anyar.
	diri unggal: { :angka :section
		salin tambah-di-tungtung: section rékursif salin.
	}. <- salin.
}.

>> sheep := Daptar anyar ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep salin.
clones unggal: { :angka :sheep
	sheep tambah-di-tungtung: ['2'].
}.

Kaluaran tulis: sheep, baris-anyar.
Kaluaran tulis: clones, baris-anyar.
