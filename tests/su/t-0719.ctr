Server init.
>> fmt := Format anyar: ['%#3x'].

>> blob := Blob anyar: 4.
blob bytes: ( 
	Daptar anyar ; 0 ; 1 ; 2 ; 3
).

>> file := Berkas anyar: ['/tmp/blob'].
file blob: blob.
blob bébaskeun.

>> baca := file blob.
baca 
tina: 0 
panjang: 4, 
lakukeun unggal: { :i :b 
	Kaluaran
	tulis: (fmt larapkeun-wilangan-buleud: b),
	baris-anyar.
}.
baca bébaskeun.
