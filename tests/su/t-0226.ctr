# Test ASCII variants

# Numbers

Kaluaran tulis: (2 !=: 3), baris-anyar.
Kaluaran tulis: (2 <=: 2), baris-anyar.
Kaluaran tulis: (2 >=: 2), baris-anyar.

# Strings

Kaluaran tulis: (['b'] >=: ['a']), baris-anyar.
Kaluaran tulis: (['b'] !=: ['a']), baris-anyar.
Kaluaran tulis: (['b'] <=: ['c']), baris-anyar.

# Bools

Kaluaran tulis: (Bener !=: Salah), baris-anyar.

# Objects

Kaluaran tulis: (Obyek anyar !=: Obyek anyar), baris-anyar.

# ASCII list symbol <-:

Kaluaran tulis: (Daptar <<: 1, ; 2 ; 3) jumlah = 3, baris-anyar.

