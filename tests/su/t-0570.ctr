#Linux

 >> t := Waktu anyar.
 
t zona: ['Europe/Amsterdam'].
t taun: 2020, bulan: 8, poé: 2, jam: 21, menit: 2, detik: 1.

>> a := t jam.
>> ams := t zona.

t zona: ['US/Hawaii'].
>> b := t jam.
>> hw := t zona.

Kaluaran
tulis: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		pilih: ['later'] atawa: ['earlier']
	)
),
baris-anyar.
 