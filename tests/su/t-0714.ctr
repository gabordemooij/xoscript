>> a := Obyek anyar. 
a nalika: ['greet'] lakukeun: { Kaluaran tulis: ['welcome!'], baris-anyar. }.
a nalika: ['greet2'] lakukeun: { Kaluaran tulis: ['welcome2!'], baris-anyar. }.
a save-as: ['/tmp/a.bin'].

Kaluaran tulis: ['========== RELOADING SNAP:'], baris-anyar.
>> b := Obyek load-from: ['/tmp/a.bin'].
b greet2.