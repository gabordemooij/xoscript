# a quote that never closes must give an error, not an endless loop
>> jalur := ['/tmp/test0821.csv'].
>> file := Berkas anyar: jalur.

file tulis: ['a,b\n"1,2\n'].
{
	file pamisah: [','] tanda-kutip: ['"'] baris: { :line
		Kaluaran tulis: line, baris-anyar.
	}.
} tangkep: { :e Kaluaran tulis: e, baris-anyar. }, jalankeun.

# a closed quote still works
file tulis: ['a,b\n"1,2",3'].
file pamisah: [','] tanda-kutip: ['"'] baris: { :line
	Kaluaran tulis: line, baris-anyar.
}.
file pupus.
