>> a := 3.
>> b := a salin.
a kurangan: 1.
Kaluaran tulis: [' a = '] + a.
Kaluaran tulis: [' b = '] + b.
a := 3.
b := a + 4.
Kaluaran tulis: [' a = '] + a.
Kaluaran tulis: [' b = '] + b.
>> x := 3.
>> y := x salin.
x tambah: 10.
y kurangan: 1.
Kaluaran tulis: [' x = '] + x.
Kaluaran tulis: [' y = '] + y.
>> q := Obyek anyar.
q nalika: ['setProperty:'] lakukeun: { :x
	milik prop := x.
}.
q nalika: ['getProperty'] lakukeun: { <- milik prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Kaluaran tulis: [' p = '] + (p getProperty).
