>> Grandfather := Obyek anyar.
Grandfather nalika: ['greet'] lakukeun: {
	Kaluaran tulis: ['Ave!'], baris-anyar.
}.
>> Father := Grandfather anyar.
Father nalika: ['greet'] lakukeun: {
	Kaluaran tulis: ['Hello'], baris-anyar.
	diri greet.
}.
>> Son := Father anyar.
Son nalika: ['greet'] lakukeun: {
	Kaluaran tulis: ['Hi'], baris-anyar.
	diri greet.
}.

Son greet.

>> Roundabout := Obyek anyar.
Roundabout nalika: ['circle:'] lakukeun: { :x
	Kaluaran tulis: x, baris-anyar.
	(x < 3) bener: { diri rékursif circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) bener: { Kaluaran tulis: x, baris-anyar. x tambah: 1.  increment jalankeun. }. }.
increment jalankeun.