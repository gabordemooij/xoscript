>> randomizer := { :a :b
	>> minimum := ( a < b ) pilih: a atawa: b.
	>> maksimum := ( a > b ) pilih: a atawa: b.
	>> x := Kosong.
	{
		x := Angka antara: a jeung: b.
		((x < minimum) atawa: (x > maksimum)) bener: { 
			Kaluaran tulis: (['Invalid value!']).
			Program réngsékeun.
		}.
	} 
	× 100. <- x.
}.
randomizer larapkeun: 0 jeung: 0.
