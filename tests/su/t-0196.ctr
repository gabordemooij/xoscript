
>> animal := Obyek anyar. 
 
 animal nalika: ['name:'] lakukeun: { :n
milik ngaran := n.
}. 


animal name: ['Diva']. 
 
animal nalika: ['ngaran'] lakukeun: { <- ngaran.
}.

>> cat := animal anyar.
 
 cat name: ['Diva']. 
 
 cat nalika: ['ngaran'] lakukeun: { <- ['your royal highness ']
+ (diri ngaran).
}.

Kaluaran tulis: cat ngaran.
