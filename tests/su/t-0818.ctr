# edge cases from a request must give an error or a result, not a crash
Server init.

Kaluaran tulis: ['<'] + (['abc'] tina: 0 panjang: 0, hurup-gedé) + ['>'], baris-anyar.
Kaluaran tulis: ['<'] + (['abc'] tina: 0 panjang: 0, hurup-leutik) + ['>'], baris-anyar.
Kaluaran tulis: ['<'] + (['abc'] liwatan: 3, hurup-gedé) + ['>'], baris-anyar.
Kaluaran tulis: [''] hurup-gedé bytes, baris-anyar.
Kaluaran tulis: ['aB'] hurup-gedé, baris-anyar.
Kaluaran tulis: ['aB'] hurup-leutik, baris-anyar.

Kaluaran tulis: (Waktu anyar: 0) taun, baris-anyar.
{ Waktu anyar: ['9e300'] angka. } tangkep: { :e Kaluaran tulis: e, baris-anyar. }, jalankeun.
{ Waktu anyar: ['-9e300'] angka. } tangkep: { :e Kaluaran tulis: e, baris-anyar. }, jalankeun.
{ Waktu anyar: ['nan'] angka. } tangkep: { :e Kaluaran tulis: e, baris-anyar. }, jalankeun.
{ Waktu anyar: 9000000000000000000. } tangkep: { :e Kaluaran tulis: e, baris-anyar. }, jalankeun.
