Server init.

>> db := Maria-DB anyar hos: ['localhost'],
	ngaran-pamaké: ['xo'],
	sandi: ['pass123'],
	ngaran-basis-data: ['xobase'],
	sambungkeun.

>> paraméter-panéangan := db kueri: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], paraméter: ( Daptar anyar ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  paraméter-panéangan laksanakeun. db tetepkeun. } tangkep: { :e db bolaykeun.  }, jalankeun.

Kaluaran tulis: ['Can we insert? '] + ( paraméter-panéangan insert-id > 0 ), baris-anyar.
