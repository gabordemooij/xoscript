
>> Greeter := Obyek anyar.
Greeter nalika: ['anyar'] lakukeun: {
	milik ngaran := ['?'].
}.
Greeter nalika: ['name:'] lakukeun: { :ngaran
	milik ngaran := ngaran.
}.
Greeter nalika: ['greet'] lakukeun: {
	Kaluaran tulis: (['hello[you]'] [you]: milik ngaran).
}.
>> friend := Greeter anyar.
friend name: ['1'].
friend greet.
