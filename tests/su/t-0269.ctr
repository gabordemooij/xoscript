#Linux

(Berkas anyar: ['/tmp/testje']) aya salah: {
	Program sistem: ['mkdir /tmp/testje'].	
}.

(Berkas anyar: ['/tmp/testje/file1']) aya salah: {
	Program sistem: ['touch /tmp/testje/file1'].	
}.

(Berkas anyar: ['/tmp/testje/folder1']) aya salah: {
	Program sistem: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Berkas daptar: ['/tmp/testje'].

>> q := Daptar anyar.

l unggal: { :k :v v unggal: { :x :y q tambah-di-tungtung: y. }. }.

>> s := q téks.

(s ngandung: ['file1']) bener:   { Kaluaran tulis: ['OK'], baris-anyar. }.
(s ngandung: ['file2']) bener:   { Kaluaran tulis: ['XX'], baris-anyar. }.
(s ngandung: ['folder1']) bener: { Kaluaran tulis: ['OK'], baris-anyar. }.
