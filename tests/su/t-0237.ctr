
Téks nalika: ['evaluate'] lakukeun: {
	>> kode := Berkas anyar: ['/tmp/eval.ctr'].
	kode tulis: (diri téks + ['.']).
	Program paké: ['/tmp/eval.ctr'].
}.

>> map :=
	(Kamus anyar)
	teundeun: ['Hi There'] di: ['two'],
	teundeun: (Daptar ← ['hello'] ; ['world'] ; (Daptar ← 1 ; 2; 9) ; Salah) di: ['one'],
	teundeun: ( (Kamus anyar) teundeun: ['wrrld'] di: ['misspelled'] ) di: ['three'],
	teundeun: (Daptar ← ((Kamus anyar) teundeun: ['treasure'] di: ['hidden']) ; 2) di: ['four']. 
>> str := map téks.
>> map2 := Kosong.
(['map2 := '] + str ) evaluate.
Kaluaran tulis: map2 ? ['one'] ? 0.
Kaluaran tulis: map2 ? ['one'] ? 1.
Kaluaran tulis: map2 ? ['four'] ? 0 ? ['hidden'].
Kaluaran tulis: map2 ? ['one'] ? 2 ? 2.
