Server init.

>> message := ['this is a string to be encrypted!'].
>> key := ['secret123!'].
>> vault := Brankas anyar: ['myvault'].

>> encrypted := vault énkripsi: message konci: key.
>> decrypted := vault dékripsi: encrypted konci: key.

