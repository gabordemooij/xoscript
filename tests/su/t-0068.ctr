>> w := ['A_bottle_of_Whisky and a rare steak.'].
Kaluaran tulis: ['=== Basic test, grab the bottle! ==='], baris-anyar.
Kaluaran tulis: ['>']+(w salin tina:2 panjang: 6), baris-anyar.
Kaluaran tulis: ['>']+(w salin tina:8 panjang: -6), baris-anyar.
Kaluaran tulis: ['>']+(w salin tina:2 panjang: 6), baris-anyar.
