Server init.

Kaluaran tulis: (
	Pola anyar: ['^\\w+$'],
	cocog: ['test@example.com'] 
), baris-anyar. # 0 match, fails on @ and .

Kaluaran tulis: (
	Pola anyar: ['^[^@]+@[^\.]+\.\\w+$'],
	cocog: ['test@example.com'] 
), baris-anyar. # 1 match

Kaluaran tulis: (
	Pola anyar: ['[^@]+@[^\.]+\.\\w+'],
	cocog: ['test@example.com'] 
), baris-anyar. # 1 match

Kaluaran tulis: (
	Pola anyar: ['([^@]+)@([^\.]+)\.\\w+'],
	cocog: ['test@example.com'] 
), baris-anyar. # 1 match, groups dont matter

Kaluaran tulis: (
	Pola anyar: ['[a-z]'],
	cocog: ['test@example.com'] 
), baris-anyar. # 14 matches

Kaluaran tulis: (
	Pola anyar: ['.*'],
	cocog: ['test@example.com'] 
), baris-anyar. # 1 match (all)

Kaluaran tulis: (
	Pola anyar: ['(.*)'],
	cocog: ['test@example.com'] 
), baris-anyar. # 1 match (all)

Kaluaran tulis: (
	Pola anyar: ['\\s*[^@]+@[^\.]+\.\\w+'],
	cocog: ['test@example.com'] 
), baris-anyar. # 1 match, prefix space optional, gets ignored