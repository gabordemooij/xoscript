#OBSD
>> dirname := [''].
{ dirname tambah-di-tungtung: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Program sistem: command.
Program chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename tambah-di-tungtung: ['YYYYYYYY']. } * 20.
Berkas anyar: filename, tulis: ['sometext'].
{ Berkas daptar: ['/tmp/'] + dirname. } * 1000.
Kaluaran tulis: ['no crash'], baris-anyar.

