>> HTML := Obyek anyar.
HTML nalika: ['jawab:'] lakukeun: { :tag 
	Kaluaran tulis: (['<tag>'] tag: tag), baris-anyar.
}.
HTML nalika: ['jawab:jeung:'] lakukeun: { :tag :html 
	Kaluaran tulis: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), baris-anyar.
}.
>> html := HTML anyar.
html body h1: ['header'].

