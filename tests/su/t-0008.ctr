>> Greeter := Obyek anyar.
Greeter nalika: ['make'] lakukeun: {
	>> greeter := Obyek anyar.
	greeter nalika: ['name:'] lakukeun: { :ngaran
		Kaluaran tulis: ['setting a name'].
		milik myName := ngaran.
	}.
	greeter nalika: ['greet'] lakukeun: {
		Kaluaran tulis: ['Hello'].
		Kaluaran tulis: milik myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
