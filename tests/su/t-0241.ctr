

Téks nalika: ['evaluate'] lakukeun: {
	>> kode := Berkas anyar: ['/tmp/eval.ctr'].
	kode tulis: (diri téks + ['.']).
	Program paké: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Daptar ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q téks.
Kaluaran tulis: x, baris-anyar.
>> y := Kosong.
(['y := '] + x ) evaluate.
Kaluaran tulis: y ? 0, baris-anyar.

q := Kamus teundeun: ['\[''] di: ['\['quote\']'].
x := q téks.
Kaluaran tulis: x, baris-anyar.
y := Kosong.
(['y := '] + x ) evaluate.

>> q := (Kamus anyar) teundeun:['\[''] di:['\['quote\[''].
Kaluaran tulis: y ? ['\['quote\']'], baris-anyar.
