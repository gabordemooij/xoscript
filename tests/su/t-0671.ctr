# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Brankas jieun-konci.

# private (secret) key
>> sk := keys kahiji.

# public key
>> pk := keys pamungkas.

# sign a message
>> sig := Brankas tanda-tangan: ['abc'] maké: sk.

# check message (ok)
Kaluaran tulis: ( 
	Brankas
		pariksa: ['abc'] 
		tanda-tangan: sig 
		maké: pk 
), baris-anyar.

# check message (fail)
Kaluaran tulis: ( 
	Brankas 
		pariksa: ['abd'] 
		tanda-tangan: sig 
		maké: pk 
), baris-anyar.