
Angka diajar: ['plus:'] hartosna: ['+'].
Angka nalika: ['+'] lakukeun: { :x
	>> rate := 1.
	>> currency := x satuan-angka.
	(currency = ['euros']) bener: {
		rate := 2.
	}. <- (diri plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars satuan: ['dollars'].
euros satuan: ['euros'].
>> money := dollars + euros.
Kaluaran tulis: money, baris-anyar.
