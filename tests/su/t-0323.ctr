

Program beresihan.


>> Veggy := Obyek anyar.
Veggy nalika: ['anyar'] lakukeun: {
	>> v := diri anyar.
	v init. <- v.
}.

Veggy nalika: ['init'] lakukeun: { milik veggies := 0. }.

Veggy nalika: ['carrots:'] lakukeun: { :a milik veggies := a. <- Kosong. }.
Veggy nalika: ['carrots'] lakukeun: { <- milik veggies. }.
Veggy nalika: ['+'] lakukeun: { :f
	>> n := Veggy anyar.
	n carrots: (f carrots + milik veggies). <- n.
}.

Veggy nalika: ['téks'] lakukeun: { <- milik veggies téks.
}.

Angka nalika: ['carrots'] lakukeun: {
	>> x := Veggy anyar.
	x carrots: diri. <- x.
}.

Angka nalika: ['add:and:'] lakukeun: { :a :b <- (a + b).
}.

>> q := 0 add: (3 carrots + 2 carrots) and: 4 carrots.
Kaluaran tulis: q, baris-anyar.
