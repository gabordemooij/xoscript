

# create a 64-bit integer for exact calculations
>> a := Int64 tina-téks: ['123'].

# to string
Kaluaran tulis: a, baris-anyar.

# divide
Kaluaran tulis: a / (Int64 tina-téks: ['3']), baris-anyar.

# multiply
Kaluaran tulis: a * (Int64 tina-téks: ['2']), baris-anyar.

# add
Kaluaran tulis: a + (Int64 tina-téks: ['1']), baris-anyar.

# subtract
Kaluaran tulis: a - (Int64 tina-téks: ['2']), baris-anyar.

# compare
Kaluaran tulis: ( a =   (Int64 tina-téks: ['123'])), baris-anyar.
Kaluaran tulis: ( a !=: (Int64 tina-téks: ['124'])), baris-anyar.
Kaluaran tulis: ( a <   (Int64 tina-téks: ['124'])), baris-anyar.
Kaluaran tulis: ( a >   (Int64 tina-téks: ['122'])), baris-anyar.
Kaluaran tulis: ( a >=: (Int64 tina-téks: ['123'])), baris-anyar.
Kaluaran tulis: ( a <=: (Int64 tina-téks: ['123'])), baris-anyar.





	