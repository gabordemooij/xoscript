# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Pola anyar: pattern.
	p cocog: subject lakukeun: { :m :g
		Kaluaran tulis: g jumlah, tulis: [' '], tulis: (g gabungkeun: ['|']), baris-anyar. <- m.
	}.
}.
show larapkeun: ['(a)|(b)'] jeung: ['b'].
show larapkeun: ['(a)|(b)'] jeung: ['a'].
show larapkeun: ['(x)?y'] jeung: ['y'].
show larapkeun: ['(x)?(y)(z)?'] jeung: ['xy'].
