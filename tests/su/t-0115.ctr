{
	tugas-ieu kasalahan: ['Dont fail.'].
	unknown doSomething.
} tangkep: {
	Kaluaran tulis: ['Caught!'].
}, jalankeun.

{
	tugas-ieu kasalahan: ['Dont fail.'].
	milik unknown doSomething.
} tangkep: {
	Kaluaran tulis: ['Caught!'].
}, jalankeun.

{
	tugas-ieu kasalahan: ['Dont fail.'].
	unknown := 122.
} tangkep: {
	Kaluaran tulis: ['Caught!'].
}, jalankeun.


{
	tugas-ieu kasalahan: ['Dont fail.'].
	Bener eureunkeun.
	Kaluaran tulis: ['FAIL'].
} tangkep: {
	Kaluaran tulis: ['Caught!'].
}, jalankeun.

{
	{
		tugas-ieu kasalahan: ['Dont fail.'].
		Bener eureunkeun.
		Kaluaran tulis: ['FAIL'].
	} tangkep: { :x
		(x = ['Dont fail.']) bener: { tugas-ieu kasalahan: ['Nested Caught!']. }.
	}, jalankeun.
} tangkep: { :e
	Kaluaran tulis: e.
}, jalankeun.
