>> phrases := Daptar anyar
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases unggal: { :_ :phrase 
	>> e := Server base64-énkode: phrase.
	>> d := Server base64-dékode: e.
	Kaluaran tulis: (
		message salin ~encoded: e, ~decoded: d
	), baris-anyar.
}.
