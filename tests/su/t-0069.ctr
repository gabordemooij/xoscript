

Téks nalika: ['html'] lakukeun: { <- (
		diri
		ganti: ['&'] ku: ['&amp;'],
		ganti: ['<'] ku: ['&lt;'],
		ganti: ['>'] ku: ['&gt;'],
		ganti: ['"'] ku: ['&quot;']
	).
}.


Kaluaran tulis: ([' left trimmed '] pangkas) + [' '] + ( ['and right trimmed'] pangkas) + ['!'], baris-anyar.
Kaluaran tulis: ['<html>"html & entities"</html>'] html.
