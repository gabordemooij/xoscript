Angka nalika: ['factorial'] lakukeun: {
	>> total := 1.
	{ :index total kalikeun-ku: (diri - (index)). } × diri. <- total.
}.
>> Printer := Obyek anyar.
Printer nalika: ['print:and:'] lakukeun: { :x :y
	Kaluaran tulis: ['a='] + x + [', b='] + y, baris-anyar.
}.
>> a := 4.5. >> b := a buleudkeun-ka-handap.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a buleudkeun-ka-luhur.
Printer print: a and: b.
a := 4.5. b := a buleudkeun-ka-handap.
Printer print: a and: b.
a := 4.5. b := a buleudkeun.
Printer print: a and: b.
a := 4.2. b := a buleudkeun.
Printer print: a and: b.

