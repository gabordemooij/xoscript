Kaluaran tulis: ['Test object'], baris-anyar.
>> a := Obyek anyar. 

a nalika: ['state:'] lakukeun: { :list
	milik list := list. 
}.

a nalika: ['state'] lakukeun: {
	Kaluaran tulis: milik list, baris-anyar.
}.

a state: ( Daptar anyar ; ['listitem'] ; ['item2'] ).
