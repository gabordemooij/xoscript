Kaluaran tulis: ['Test object'], baris-anyar.
>> l := Daptar anyar ; 1 ; ( Daptar anyar ; (Waktu anyar: 1) ; (Int64 tina-téks: ['321']) ; (Daptar anyar ; 3)).
Kaluaran tulis: l, baris-anyar.
>> old-lst-address := l prototipe alamat-mémori.
l save-as: ['/tmp/a.bin'].
Kaluaran tulis: ['========== RELOADING SNAP:'], baris-anyar.
>> b := Obyek load-from: ['/tmp/a.bin'].
(b prototipe alamat-mémori = old-lst-address) bener: {
	Kaluaran tulis: ['Object link re-attached.'], baris-anyar.
}.
Kaluaran tulis: b, baris-anyar.
