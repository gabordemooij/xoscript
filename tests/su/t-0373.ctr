# compliance test

# use international numbers

Kaluaran tulis: ['1000 -> '].
Kaluaran tulis: 1000, baris-anyar. #1000

Kaluaran tulis: ['1.5 -> '].
Kaluaran tulis: 1.5, baris-anyar.  #1.5

Kaluaran tulis: ['1001.5 -> '].
Kaluaran tulis: 1.5 + 1000, baris-anyar. #1001.5

# use 0-indexed arrays
>> x := Daptar anyar ; 1 ; 2 ; 3.
>> y := Daptar anyar ; ['a'] ; ['b'] ; ['c'].

Kaluaran tulis: ['1 -> '].
Kaluaran tulis: x ? 0, baris-anyar. #1

Kaluaran tulis: ['1 -> '].
Kaluaran tulis: (x di: 0), baris-anyar. #1

Kaluaran tulis: ['1 -> '].
Kaluaran tulis: x kahiji, baris-anyar. #1

Kaluaran tulis: ['3 -> '].
Kaluaran tulis: x pamungkas, baris-anyar. #3

Kaluaran tulis: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Kaluaran tulis: (x numutkeun: y), baris-anyar.

Kaluaran tulis: ['1 -> '].
Kaluaran tulis: (x tina: 0 panjang: 1) kahiji, baris-anyar. #1

Kaluaran tulis: ['0 -> '].
Kaluaran tulis: (x téangan: 1), baris-anyar. #0

x teundeun: 9 di: 0.

Kaluaran tulis: ['9 -> '].
Kaluaran tulis: (x di: 0), baris-anyar. #9

x tambah-di-hareup: 8.
Kaluaran tulis: ['8 -> '].
Kaluaran tulis: (x di: 0), baris-anyar. #9


x tambah-di-tungtung: 10.
Kaluaran tulis: ['10 -> '].
Kaluaran tulis: (x di: 4), baris-anyar. #10








