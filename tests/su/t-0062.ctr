Boolean nalika: ['xor:'] lakukeun: { :a :b <- ((a jeung: b lain) atawa: (a lain jeung: b)).
}.

>> o := Obyek anyar.
o nalika: ['hello'] lakukeun: { ['Empty']. }.
{ o nalika: 2 lakukeun: 3.} tangkep: { :e Kaluaran tulis: e, baris-anyar. }, jalankeun.
{ o nalika: ['uji'] lakukeun: 3.} tangkep: { :e Kaluaran tulis: e, baris-anyar. }, jalankeun.
{ o nalika: ['hello'] lakukeun: { ['Empty']. }.} tangkep: { :e Kaluaran tulis: e, baris-anyar. }, jalankeun. 
{ >> z := 4 ÷ 0. } tangkep: { :e Kaluaran tulis: e, baris-anyar. }, jalankeun. 
{ (Bener jeung: Kosong) bener: { Kaluaran tulis: ['X'].}. } tangkep: { :e Kaluaran tulis: e, baris-anyar. }, jalankeun. 
{ ([''] xor: 0) bener: { Kaluaran tulis: ['X'].}. } tangkep: { :e Kaluaran tulis: e, baris-anyar. }, jalankeun. 
{ (1 < ['2']) bener: { Kaluaran tulis: ['OK']. }. } tangkep: { :e Kaluaran tulis: e, baris-anyar. }, jalankeun. 
{ (1 < ['2.0']) bener: { Kaluaran tulis: ['OK']. }. } tangkep: { :e Kaluaran tulis: e, baris-anyar. }, jalankeun. 
{ (1 < ['x2.0']) bener: { Kaluaran tulis: ['NO!']. }. } tangkep: { :e Kaluaran tulis: e, baris-anyar. }, jalankeun. 
{ Kaluaran tulis: (['hello OK there'] tina: ['6'] panjang: ['2']). } jalankeun. 
