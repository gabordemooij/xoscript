>> Animal := Obyek anyar.
Animal nalika: ['make'] lakukeun: {
	>> animal := Obyek anyar.
	animal nalika: ['makeSound'] lakukeun: {
		Kaluaran tulis: milik sound.
	}. <- animal.
}.
>> Cat := Obyek anyar.
Cat nalika: ['make'] lakukeun: {
	>> cat := Animal make.
	cat nalika: ['init'] lakukeun: {
		milik sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
