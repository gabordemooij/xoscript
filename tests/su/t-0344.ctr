# catch-all test (practical)
>> HTML := Téks anyar.
HTML nalika: ['encode:'] lakukeun: { :tekst
	diri tambah-di-tungtung: (tekst
	ganti: ['&'] ku: ['&amp;'], 
	ganti: ['<'] ku: ['&lt;'],
	ganti: ['>'] ku: ['&gt;'],
	ganti: ['"'] ku: ['&quot;']).
}.
>> blog := HTML anyar.
blog tambah-di-tungtung: ['<h1>'],
     encode: ['Koffie & Thee'],
     tambah-di-tungtung: ['</h1>'].
Kaluaran tulis: blog, baris-anyar.


>> Roman := Angka anyar.
Roman nalika: ['stringy'] lakukeun: {
	>> a := [''].
	{ a tambah-di-tungtung: ['I']. } × diri. <- a.
}.

>> x := Roman anyar.
x tambah: 3.
Kaluaran tulis: x stringy, baris-anyar.

>> Quantum := Boolean anyar.
Quantum nalika: ['true?'] lakukeun: { <- ['maybe True']. }.
Kaluaran tulis: (Quantum anyar true?), baris-anyar.

>> Nihil := Kosong anyar.
Nihil nalika: ['téks'] lakukeun: { <- ['Nihil']. }.
Kaluaran tulis: (Nihil anyar), baris-anyar.
