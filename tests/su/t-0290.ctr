# test list operations


>> cakes := Daptar ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes ganti: 1 panjang: 2 ku: ( Daptar ← ['cinnamon'] ; ['pineapple'] ).
Kaluaran tulis: (buy gabungkeun: [',']), baris-anyar.


>> buy := cakes ganti: 1 panjang: 12 ku: ( Daptar ← ['cinnamon'] ; ['pineapple'] ).
Kaluaran tulis: (buy gabungkeun: [',']), baris-anyar.


>> buy := cakes ganti: 2 panjang: 10 ku: ( Daptar anyar ).
Kaluaran tulis: (buy gabungkeun: [',']), baris-anyar.


>> buy := cakes ganti: 0 panjang: 1 ku: ( Daptar anyar ).
Kaluaran tulis: (buy gabungkeun: [',']), baris-anyar.


>> buy := cakes ganti: ['0'] panjang: ['1'] ku: ['x'].
Kaluaran tulis: (buy gabungkeun: [',']), baris-anyar.
