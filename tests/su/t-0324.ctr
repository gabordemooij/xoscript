>> Animal := Obyek anyar.
>> Factory := Obyek anyar.

Animal nalika: ['anyar'] lakukeun: {
	>> animal := diri anyar.
	animal sound: ['?']. <- animal.
}.

Animal nalika: ['sound:'] lakukeun: { :s
	milik sound := s.
}.

Animal nalika: ['sound'] lakukeun: { <- milik sound.
}.

>> Dog := Obyek anyar.
>> Cat := Obyek anyar.

Dog nalika: ['anyar'] lakukeun: { <- Animal anyar sound: ['woof!'].
}.

Cat nalika: ['anyar'] lakukeun: { <- Animal anyar sound: ['meow!'].
}.

Kaluaran tulis: Dog anyar sound, baris-anyar.
Kaluaran tulis: Cat anyar sound, baris-anyar.

Factory nalika: ['mix:and:'] lakukeun: { :beast1 :beast2 <- Animal anyar sound: (
		( beast1 sound tina: 0 panjang: 2 ) +
		( beast2 sound tina: 2 panjang: 5 )
	).
}.

Kaluaran tulis: (Factory mix: Dog anyar and: Cat anyar) sound, baris-anyar.
