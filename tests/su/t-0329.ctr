Kaluaran tulis: ((Daptar anyar
	nalika: ['plaque:'] lakukeun: { :x milik o := x. },
	nalika: ['plaque']  lakukeun: { <- milik o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Daptar ← 1)
	~ (Daptar ← 1 ; 2)
	~ (Daptar ← 1 ; 2 ; 3)
	~ (Daptar ← 1 ; 2 ; 3 ; 4)
	~ (Daptar ← 1 ; 2 ; 3 ; 4 ; 5)
) unggal: { :i :el
	{ Kaluaran tulis: tugas-ieu. } × el jumlah.
	Kaluaran baris-anyar.
}) plaque, baris-anyar.


