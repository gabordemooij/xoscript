Kaluaran tulis: ['Test object'], baris-anyar.
>> cmd := Paréntah anyar.
Kaluaran tulis: cmd ls /tmp, baris-anyar.
>> old-cmd-address := cmd prototipe alamat-mémori.
cmd save-as: ['/tmp/a.bin'].
Kaluaran tulis: ['========== RELOADING SNAP:'], baris-anyar.
>> b := Obyek load-from: ['/tmp/a.bin'].
(b prototipe alamat-mémori = old-cmd-address) bener: {
	Kaluaran tulis: ['Object link re-attached.'], baris-anyar.
}.
Kaluaran tulis: b ls, baris-anyar.


