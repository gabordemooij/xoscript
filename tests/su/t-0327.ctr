

Daptar nalika: ['fixture:'] lakukeun: { :f
	milik fixture := f.
}.

Daptar nalika: ['jumlah'] lakukeun: { <- milik fixture.
}.

Daptar nalika: ['aantal'] lakukeun: { <- milik fixture.
}.


>> x := Kosong.
{

	x := ['hello'] 
	ganti:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] karakter: 2)
			)
		)
	ku: (
		(['...hal'] + ['lo']) 
			hurup-gedé 
			lowecase 
			hurup-gedé 
			liwatan: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Daptar ← 0 ; 1 ; 4; 9 ; (Daptar ← 0 ; 3; 1) ; 4
							) saméméh-pamungkas
						) ? 1
					) + 
					((Daptar ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					jumlah
				)
			)
	).

} × 10.
Kaluaran tulis: x, baris-anyar.

