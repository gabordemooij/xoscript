Server init.
>> a := Blob anyar: 4.
a bytes: ( Daptar anyar ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob anyar: 4.
b bytes: ( Daptar anyar ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
# inherited blob does not get the buffer, so it's useless
# it will pass ctr_accept() but since buffer ptr == null, it will retur
>> c := a anyar.
{ 
>> n := a ^ c.
Kaluaran tulis: ['xorred:'], baris-anyar. 
Kaluaran tulis: n, baris-anyar. 
} tangkep: { :e Kaluaran tulis: e, baris-anyar. }, jalankeun.
a bébaskeun.
b bébaskeun.
