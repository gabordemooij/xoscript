#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Pola anyar: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern cocog: subject lakukeun: { :m :x
	Kaluaran tulis: m, baris-anyar.
	Kaluaran tulis: x, baris-anyar. <- ['XXX'].
}.
Kaluaran tulis: result, baris-anyar.