
Téks nalika: ['html'] lakukeun: { <- (
		diri
		ganti: ['&'] ku: ['&amp;'],
		ganti: ['<'] ku: ['&lt;'],
		ganti: ['>'] ku: ['&gt;'],
		ganti: ['"'] ku: ['&quot;']
	).
}.

>> HtmlBrush := Obyek anyar.

HtmlBrush nalika: ['jawab:'] lakukeun: { :tag
	Kaluaran tulis: (['<tag>↵'] tag: tag ).
}.

HtmlBrush nalika: ['jawab:jeung:'] lakukeun: { :tag :content
	tag := ( tag tina: 0 panjang: (tag panjang - 1) ).
	Kaluaran tulis: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush nalika: ['content:'] lakukeun: { :text
	Kaluaran tulis: text html, baris-anyar.
}.

HtmlBrush nalika: ['attr:value:'] lakukeun: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush anyar.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
