
>> city := Daptar ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Daptar ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature numutkeun: city.
>> cities := weather konci-konci runtuykeun: { :a :b <- (a bandingkeun: b). }.
>> temperatures := weather nilai-nilai runtuykeun: { :a :b <- (a bandingkeun: b) négatif?. }.

Kaluaran tulis: (cities gabungkeun: [',']), baris-anyar.
Kaluaran tulis: (temperatures gabungkeun: [',']), baris-anyar.
