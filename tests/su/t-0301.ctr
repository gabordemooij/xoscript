


>> wine := Obyek anyar.


wine nalika: ['toString'] lakukeun: { <- ['merlot'].
}.

wine nalika: ['naarTekst'] lakukeun: { <- ['merlot'].
}.


wine nalika: ['='] lakukeun: { :other wine <- ( diri toString = other wine ).
}.

wine nalika: ['=='] lakukeun: { :other wine <- ( diri toString = other wine ).
}.



wine
	kasus: ['cabernet'] lakukeun: { Kaluaran tulis: ['it's a Cabernet!']. },
	kasus: ['syrah']    lakukeun: { Kaluaran tulis: ['it's a Syrah!'].    },
	kasus: ['merlot']   lakukeun: { Kaluaran tulis: ['it's a Merlot!'].   },
	kasus: ['malbec']   lakukeun: { Kaluaran tulis: ['it's a Malbec!'].   }.

Kaluaran baris-anyar.
