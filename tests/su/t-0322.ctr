

>> Matryoshka := Obyek anyar.
Matryoshka nalika: ['double:'] lakukeun: { :secret
	milik secret := secret × 2.
}.
Matryoshka nalika: ['anyar:'] lakukeun: { :secret
	>> answer := Kosong.
	>> t := (secret > 255).
	Kaluaran tulis: (secret + [' | '] + t), baris-anyar.
	t bener: {
		answer := secret.
	}, lamun-henteu: {
		answer := Matryoshka rékursif anyar: (diri double: secret).
	}. <- answer.
}.

>> x := Matryoshka anyar: 2.
