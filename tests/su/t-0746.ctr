Kaluaran tulis: ['Test object'], baris-anyar.
>> a := Obyek anyar. 

a nalika: ['item:'] lakukeun: { :dict
	milik dict := dict. 
}.

a nalika: ['item'] lakukeun: { <- milik dict.
}.

a item: (
Kamus anyar
	hello: ['world'],
	world: (Kamus anyar teundeun: ['a'] di: ['b'])).

Kaluaran tulis: a item, baris-anyar.

>> old-dict-address := a item prototipe alamat-mémori.
a save-as: ['/tmp/a.bin'].
Kaluaran tulis: ['========== RELOADING SNAP:'], baris-anyar.

>> b := Obyek load-from: ['/tmp/a.bin'].

(b item prototipe alamat-mémori = old-dict-address) bener: {
	Kaluaran tulis: ['Object link re-attached.'], baris-anyar.
}.

Kaluaran tulis: b item, baris-anyar.
