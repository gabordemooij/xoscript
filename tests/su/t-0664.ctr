# recursive interpolation not allowed

Kaluaran tulis: 
['recursive string interolation enabled: '] + (
	Program fitur: 
	['RECURSIVE_STRINTPOL']
), baris-anyar.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Kaluaran tulis: a, baris-anyar.


