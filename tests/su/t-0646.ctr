Server init.
Kaluaran tulis: ['Database datetime test'], baris-anyar.

>> db := Maria-DB anyar hos: ['localhost'],
	ngaran-pamaké: ['xo'], 
	sandi: ['pass123'],
	ngaran-basis-data: ['xobase'],
	sambungkeun.

>> paraméter-panéangan :=
db kueri: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
cokot: { :row
	Kaluaran tulis: row datetimetest, baris-anyar.
}.
