Kaluaran tulis: ['Test object'], baris-anyar.
>> a := Obyek anyar. 

a nalika: ['item:'] lakukeun: { :octhelper
	milik octhelper := octhelper. 
}.

a nalika: ['item'] lakukeun: { <- milik octhelper.
}.

a item: Oct anyar.

>> old-octhelper-address := a item prototipe alamat-mémori.
a save-as: ['/tmp/a.bin'].
Kaluaran tulis: ['========== RELOADING SNAP:'], baris-anyar.

>> b := Obyek load-from: ['/tmp/a.bin'].

(b item prototipe alamat-mémori = old-octhelper-address) bener: {
	Kaluaran tulis: ['Object link re-attached.'], baris-anyar.
}.
