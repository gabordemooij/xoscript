Server init.

>> DB := Maria-DB anyar hos: ['localhost'],
	ngaran-pamaké: ['xo'],
	sandi: ['pass123'],
	ngaran-basis-data: ['xobase'],
	sambungkeun.

{
	DB kueri:
	['DROP TABLE movies'],
	laksanakeun.
} tangkep: { Kosong. }, jalankeun.

DB kueri:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
laksanakeun.

DB kueri: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
paraméter: ( Daptar anyar ; ['Halloween'] ),
laksanakeun.

DB kueri: ['SELECT * FROM movies'],
cokot: { :movie
	Kaluaran tulis: movie title, baris-anyar.
}.

