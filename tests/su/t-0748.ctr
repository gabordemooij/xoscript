Kaluaran tulis: ['Test object'], baris-anyar.
>> a := Obyek anyar. 

a nalika: ['item:'] lakukeun: { :boolean
	milik boolean := boolean. 
}.

a nalika: ['item'] lakukeun: { <- milik boolean.
}.

a item: Bener.

Kaluaran tulis: a item, baris-anyar.

>> old-bool-address := a item prototipe alamat-mémori.
a save-as: ['/tmp/a.bin'].
Kaluaran tulis: ['========== RELOADING SNAP:'], baris-anyar.

>> b := Obyek load-from: ['/tmp/a.bin'].

(b item prototipe alamat-mémori = old-bool-address) bener: {
	Kaluaran tulis: ['Object link re-attached.'], baris-anyar.
}.

Kaluaran tulis: b item, baris-anyar.
