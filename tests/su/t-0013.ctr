
>> Animal := Obyek anyar.
Animal nalika: ['anyar'] lakukeun: { <- diri anyar init.
}.

Animal nalika: ['init'] lakukeun: {
	milik sound := ['?'].
	milik legs := 4.
}.

>> Dog := Animal anyar.
Dog nalika: ['init'] lakukeun: {
	diri init.
	milik sound := ['barks'].
}.

Animal nalika: ['téks'] lakukeun: { <- milik legs téks + milik sound.
}.

>> poodle := Dog anyar.
Kaluaran tulis: poodle, baris-anyar.

