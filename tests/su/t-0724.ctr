Kaluaran tulis: ['Test object'], baris-anyar.
>> a := Obyek anyar. 

a nalika: ['item:'] lakukeun: { :file
	milik file := file. 
}.

a nalika: ['item'] lakukeun: { <- milik file.
}.

>> f := Berkas anyar: ['/tmp/aaa.txt'].
a item: f.
Kaluaran tulis: a item, baris-anyar.
a save-as: ['/tmp/a.bin'].
Kaluaran tulis: ['========== RELOADING SNAP:'], baris-anyar.
>> b := Obyek load-from: ['/tmp/a.bin'].
Kaluaran tulis: b item, baris-anyar.
