>> items := Kamus anyar.
items teundeun: ['black'] di: ['coffee'], teundeun: ['earl grey'] di: ['tea'].
Kaluaran tulis: (items di: ['coffee']), tulis: (items di: ['tea']).
Kaluaran tulis: ['there are'] + items jumlah + [' items in the array.'].
items teundeun: ['capuccino'] di: ['coffee'].
Kaluaran tulis: ['Now my coffee is.. '] + (items di: ['coffee']).
items teundeun: ['aaa'] di: ['1'].
items teundeun: ['bbb'] di: ['2'].
Kaluaran tulis: (items di: ['a']).
