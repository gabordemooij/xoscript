>> q := Daptar ← 1 ; 2 ; 3.
{ q ? ['1']. } tangkep: { Kaluaran tulis: ['caught!'], baris-anyar. }, jalankeun.
{ q ? Bener. } tangkep: { Kaluaran tulis: ['caught!'], baris-anyar. }, jalankeun.
{ q ? Salah. } tangkep: { Kaluaran tulis: ['caught!'], baris-anyar. }, jalankeun.
{ q ? Kosong. } tangkep: { Kaluaran tulis: ['caught!'], baris-anyar. }, jalankeun.
{ q ? (Daptar anyar). } tangkep: { Kaluaran tulis: ['caught!'], baris-anyar. }, jalankeun.
{ q ? (Obyek anyar). } tangkep: { Kaluaran tulis: ['caught!'], baris-anyar. }, jalankeun.
{ q ? ({ ['Empty']. }). } tangkep: { Kaluaran tulis: ['caught!'], baris-anyar. }, jalankeun.
Kaluaran tulis: ['caught them all'], baris-anyar.
