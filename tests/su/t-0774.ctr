Kaluaran tulis: ['Test object'], baris-anyar.
>> a := Obyek anyar. 
a nalika: ['item:'] lakukeun: { :lst
	milik lst := lst. 
}.
a nalika: ['item'] lakukeun: { <- milik lst.
}.
a item: (
	Daptar anyar ; 1 ; (
		Daptar anyar ; ['a'] ; (
			Daptar anyar ; ( Waktu anyar: 1 )
		) ; ( Int64 tina-téks: ['321'] )
	)
).
Kaluaran tulis: a item, baris-anyar.
>> old-lst-address := a item prototipe alamat-mémori.
a save-as: ['/tmp/a.bin'].
Kaluaran tulis: ['========== RELOADING SNAP:'], baris-anyar.
>> b := Obyek load-from: ['/tmp/a.bin'].
(b item prototipe alamat-mémori = old-lst-address) bener: {
	Kaluaran tulis: ['Object link re-attached.'], baris-anyar.
}.
Kaluaran tulis: ( b item ), baris-anyar.
