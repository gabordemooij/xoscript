Server init.
Kaluaran tulis: ['Database time test'], baris-anyar.

>> db := Maria-DB anyar hos: ['localhost'],
	ngaran-pamaké: ['xo'], 
	sandi: ['pass123'],
	ngaran-basis-data: ['xobase'],
	sambungkeun.

>> paraméter-panéangan :=
db kueri: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
cokot: { :row
	Kaluaran tulis: row timetest, baris-anyar.
}.
