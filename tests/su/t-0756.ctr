Kaluaran tulis: ['Test object'], baris-anyar.
>> greeter := Obyek anyar.
greeter nalika: ['name:'] lakukeun: { :ngaran
	milik xname := ngaran. 
}.
greeter nalika: ['greet'] lakukeun: {
	Kaluaran tulis: ['Hello '] + milik xname, baris-anyar.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Kaluaran tulis: ['========== RELOADING SNAP:'], baris-anyar.
>> b := Obyek load-from: ['/tmp/a.bin'].
>> c := Obyek load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
