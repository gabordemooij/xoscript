Server init.
>> f := Format anyar: ['%d'].
>> a := Blob anyar: 4.
a bytes: ( Daptar anyar ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob anyar: 4.
b bytes: ( Daptar anyar ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a tina: 0 panjang: 3, unggal: { :i :byte
	Kaluaran tulis: ( f larapkeun-wilangan-buleud: byte ), baris-anyar.
}.
a ^ b.
a tina: 0 panjang: 3, unggal: { :i :byte
	Kaluaran tulis: ( f larapkeun-wilangan-buleud: byte ), baris-anyar.
}.
a ^ b.
a tina: 0 panjang: 3, unggal: { :i :byte
	Kaluaran tulis: ( f larapkeun-wilangan-buleud: byte ), baris-anyar.
}.
a bébaskeun.
b bébaskeun.

{ a ^ Obyek. } tangkep: { :e Kaluaran tulis: e, baris-anyar. }, jalankeun.
