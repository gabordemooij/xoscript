
Daptar nalika: ['product'] lakukeun: {
	>> total := 1.
	diri unggal: { :index :element
		total kalikeun-ku: element.
	}. <- total.
}.

>> a := Daptar ← 1 ; 2 ; 3.
Kaluaran tulis: a product, baris-anyar.
Kaluaran tulis: (Daptar ← 2 ; 4 ; 8) product, baris-anyar. 
Kaluaran tulis: (Daptar ← -2 ; 10) product, baris-anyar. 
Kaluaran tulis: (Daptar ← 0.5 ; -2) product, baris-anyar. 
