Kaluaran tulis: ['Test object'], baris-anyar.
>> a := Obyek anyar. 

a nalika: ['item:'] lakukeun: { :hexhelper
	milik hexhelper := hexhelper. 
}.

a nalika: ['item'] lakukeun: { <- milik hexhelper.
}.

a item: Hx anyar.

>> old-hexhelper-address := a item prototipe alamat-mémori.
a save-as: ['/tmp/a.bin'].
Kaluaran tulis: ['========== RELOADING SNAP:'], baris-anyar.

>> b := Obyek load-from: ['/tmp/a.bin'].

(b item prototipe alamat-mémori = old-hexhelper-address) bener: {
	Kaluaran tulis: ['Object link re-attached.'], baris-anyar.
}.
