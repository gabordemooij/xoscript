



>> CoffeeGrounds := Obyek anyar.
CoffeeGrounds nalika: ['extract'] lakukeun: { <- ['coffee']. }.

>> CoffeeMachine := Obyek anyar.
CoffeeMachine nalika: ['init'] lakukeun: {
	milik coffeegrounds := CoffeeGrounds anyar.
}.
CoffeeMachine nalika: ['anyar'] lakukeun: { <- CoffeeMachine `new init.
}.

CoffeeMachine nalika: ['makeTea'] lakukeun: { <- (milik tealeaves extract). }.
CoffeeMachine nalika: ['makeCoffee'] lakukeun: { <- (milik coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine anyar.

Kaluaran tulis:
	coffeeDream 
	makeCoffee.

Kaluaran tulis:
	coffeeDream 
	makeTea.
