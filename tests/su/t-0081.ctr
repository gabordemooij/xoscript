>> map1 := Kamus anyar.
>> key1 := Daptar anyar.
>> key2 := Daptar anyar.

map1
	teundeun: ['hello'] di: key1,
	teundeun: ['world'] di: key2.


Kaluaran
	tulis: ['Map #1 contains: '] + (map1 di: key1),
	tulis: [' and '] + (map1 di: key2), baris-anyar.

>> KeyeableArray := Daptar anyar.
KeyeableArray nalika: ['toString'] lakukeun: { <- (diri jumlah) toString.
}.

>> map2 := Kamus anyar.
key1 := KeyeableArray anyar.
key2 := KeyeableArray anyar.

key1 tambah-di-tungtung: 1.

map2
	teundeun: ['hello'] di: key1,
	teundeun: ['world'] di: key2.

Kaluaran
	tulis: ['Map #2 contains: '] + (map2 di: key1),
	tulis: [' and '] + (map2 di: key2), baris-anyar.
