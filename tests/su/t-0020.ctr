(Kosong = Kosong) bener: { Kaluaran tulis: ['Nil is Nil!'].}.
(2 > 1) bener: { Kaluaran tulis: ['YES']. }.
(2 > 3) bener: { Kaluaran tulis: ['NO']. }.
(2 > 3) salah: { Kaluaran tulis: ['Nonono..'].}.
Bener bener: { Kaluaran tulis: ['TRUE is TRUE!']. }.
(Bener) bener: { Kaluaran tulis: ['TRUE is TRUE!']. }.
Salah salah: { Kaluaran tulis: ['FALSE is FALSE!']. }.
(Salah) salah: { Kaluaran tulis: ['FALSE is FALSE!']. }.
