


>> CoffeeMachine := Obyek anyar.
CoffeeMachine nalika: ['order:'] lakukeun: { :id
	>> coffee := ['Americano'].
	( id = 1 ) bener: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) bener: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) bener: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Obyek anyar.
SimpleCoffeeMachine nalika: ['order'] lakukeun: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Kaluaran tulis: redCup, baris-anyar.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Kaluaran tulis: greenCup, baris-anyar.
>> yellowCup := CoffeeMachine order: 1.
Kaluaran tulis: yellowCup, baris-anyar.
>> blueCup := CoffeeMachine order: 0.
Kaluaran tulis: blueCup, baris-anyar.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Kaluaran tulis: blackCup, baris-anyar.
blackCup tambah-di-tungtung: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Kaluaran tulis: orangeCup, baris-anyar.
