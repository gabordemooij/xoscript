


>> Deck := Daptar anyar.
Deck nalika: ['print'] lakukeun: {
        >> len := diri jumlah - 1.
        { :i
                >> len2 := diri jumlah - 1.
                Kaluaran tulis: ['len: '].
                Kaluaran tulis: len, baris-anyar.
                Kaluaran tulis: ['len2: '].
                Kaluaran tulis: len2, baris-anyar.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
