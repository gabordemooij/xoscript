# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob anyar: 8, bytes: (
	Daptar anyar ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Kaluaran tulis: ( utf16 dékode: ['utf16le'] ), baris-anyar.

utf16 bébaskeun.
>> utf32 := Blob anyar: 13, bytes: (
	Daptar anyar ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Kaluaran tulis: ( utf32 dékode: ['utf32be'] ), baris-anyar.
utf32 bébaskeun.