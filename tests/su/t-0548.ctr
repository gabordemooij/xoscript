Server init.

>> x := Blob anyar: 65 tipe: ['char'].
# for this test you need set a path to libc (puts)
>> libname := Program setélan: ['FFITESTLIB'].
Server tautkeun: (
 Daptar anyar ;
 libname ;
 ['putchar'] ;
 ( Daptar anyar ; ['char'] ) ;
 ['void'] ;
 ['Print'] ;
 ['char:']
).
Print char: (x tina: 0 panjang: 1), baris-anyar.
x bébaskeun.

