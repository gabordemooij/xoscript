
>> countries := Daptar anyar
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Daptar anyar
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods numutkeun: countries, unggal: { :key :value
	counter tambah: 1.
}.

Kaluaran tulis: (['we serve counter dishes'] counter: counter), baris-anyar.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] aksara runtuykeun: { :v
	counter tambah: 0.
}.

Kaluaran tulis: (['we sort counter dishes'] counter: counter), baris-anyar.


>> counter := 0.
{
	{
		counter tambah: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Kaluaran tulis: (['we calculate counter numbers.'] counter: counter), baris-anyar.

