>> invoice := Obyek anyar.
invoice nalika: ['jalankeun'] lakukeun: {
        milik angka := 0.
}.

invoice nalika: ['angka'] lakukeun: {
        milik angka tambah: 1. <- milik angka salin.
}.

>> year-invoice := invoice anyar.
year-invoice nalika: ['start:'] lakukeun: { :taun
	milik angka := taun.
}.

year-invoice start: 202000.
Kaluaran tulis: year-invoice angka, baris-anyar.
Kaluaran tulis: year-invoice angka, baris-anyar.
