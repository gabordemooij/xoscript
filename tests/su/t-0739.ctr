Kaluaran tulis: ['Test object'], baris-anyar.
>> a := Obyek anyar. 

a nalika: ['item:'] lakukeun: { :binhelper
	milik binhelper := binhelper. 
}.

a nalika: ['item'] lakukeun: { <- milik binhelper.
}.

a item: Bin anyar.

>> old-binhelper-address := a item prototipe alamat-mémori.
a save-as: ['/tmp/a.bin'].
Kaluaran tulis: ['========== RELOADING SNAP:'], baris-anyar.

>> b := Obyek load-from: ['/tmp/a.bin'].

(b item prototipe alamat-mémori = old-binhelper-address) bener: {
	Kaluaran tulis: ['Object link re-attached.'], baris-anyar.
}.


