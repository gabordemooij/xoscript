>> Greeter := Obyek anyar.
Greeter nalika: ['make'] lakukeun: {
	>> gr := Obyek anyar.
	gr nalika: ['setName:'] lakukeun: { :aname
		milik ngaran := aname.
	}.
	gr nalika: ['greet'] lakukeun: {
		Kaluaran tulis: milik ngaran.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a anyar.
c setName: ['THREE'].
c greet.
>> d := a anyar.
d setName: ['FOUR'].
d greet.
c greet.
