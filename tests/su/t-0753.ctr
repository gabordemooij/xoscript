Kaluaran tulis: ['Test object'], baris-anyar.
>> a := Obyek anyar. 

a nalika: ['item:'] lakukeun: { :fmt
	milik fmt := fmt. 
}.

a nalika: ['item'] lakukeun: { <- milik fmt.
}.

a item: ( Format anyar: ['|%s|'] ).

Kaluaran tulis: a item, baris-anyar.

>> old-fmt-address := a item prototipe alamat-mémori.
a save-as: ['/tmp/a.bin'].
Kaluaran tulis: ['========== RELOADING SNAP:'], baris-anyar.

>> b := Obyek load-from: ['/tmp/a.bin'].

(b item prototipe alamat-mémori = old-fmt-address) bener: {
	Kaluaran tulis: ['Object link re-attached.'], baris-anyar.
}.

Kaluaran tulis: ( b item larapkeun: ['hello'] ), baris-anyar.
