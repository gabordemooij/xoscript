# test qualifiers

>> $ := Obyek anyar.

$ nalika: ['jawab:'] lakukeun: { :x
	
	>> operation := x karakter: 0.
	>> valuta := x karakter: 1.
	>> money := x liwatan: 2.
	
	>> amount := 0.

	( operation = ['+'] ) bener: {
		( valuta = ['£'] ) bener: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Kaluaran tulis: x, baris-anyar.


>> Fruit := Obyek anyar.

Fruit nalika: ['anyar'] lakukeun: {
	>> f := diri anyar.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit nalika: ['apples:'] lakukeun: { :a milik apples := a. }.
Fruit nalika: ['oranges:'] lakukeun: { :p milik oranges := p. }.
Fruit nalika: ['apples'] lakukeun: { <- milik apples. }.
Fruit nalika: ['oranges'] lakukeun: { <- milik oranges. }.

Fruit nalika: ['+'] lakukeun: { :f
	
	>> n := Fruit anyar.
	f tambah: 1.
	
	n apples: (f apples + milik apples).
	n oranges:  (f oranges  + milik oranges). <- n.
}.

Fruit nalika: ['téks'] lakukeun: { <- ( milik apples téks + [' apples and '] + milik oranges + [' oranges'] ).
}.

Angka nalika: ['apples'] lakukeun: { <- ((Fruit anyar) apples: diri).
}.

Angka nalika: ['apple'] lakukeun: { <- ((Fruit anyar) apples: diri).
}.

Angka nalika: ['oranges'] lakukeun: { <- ((Fruit anyar) oranges: diri).
}.




Kaluaran tulis: (1 apple + 3 oranges + 4 apples), baris-anyar.


Téks nalika: ['twice'] lakukeun: { <- ((diri téks) + (diri téks)).
}.



Kaluaran tulis: ['❤❤❤'] twice.



