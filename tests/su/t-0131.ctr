
>> a := Daptar ← (Daptar ← 100 ; 200 ; 300) ; (Daptar ← 9 ; 8 ; 7).
Kaluaran tulis: ['at 0,1 :'].
Kaluaran tulis: a ? 0 ? 1, baris-anyar. 
Kaluaran tulis: ['at 1,2 :'].
Kaluaran tulis: a ? 1 ? 2, baris-anyar. 
>> menu := Kamus anyar.
menu teundeun: (Daptar ← ['pizza'] ; ['spaghetti']) di: ['Italian Cuisine'].
menu teundeun: (Daptar ← ['bifteki'] ; ['suflaki']) di: ['Greek Cuisine'].
Kaluaran tulis: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), baris-anyar. 
Kaluaran tulis: ['but not on the same plate.'], baris-anyar.
