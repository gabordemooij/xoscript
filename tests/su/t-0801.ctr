Server init.

>> db := Maria-DB anyar hos: ['localhost'],
	ngaran-pamaké: ['xo'],
	sandi: ['pass123'],
	ngaran-basis-data: ['xobase'],
	sambungkeun.

>> del := db kueri: ['DELETE FROM book WHERE id > 0'].
{  del laksanakeun. db tetepkeun. } tangkep: { :e db bolaykeun.  }, jalankeun.

>> jumlah := db kueri: ['SELECT COUNT(*) AS num FROM book'].
jumlah cokot: { :row Kaluaran tulis: row num, baris-anyar. }.
