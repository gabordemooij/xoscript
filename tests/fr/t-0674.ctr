# cas nominal
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> chemin := ['/tmp/dat.csv'].
>> csv := Fichier nouveau: chemin.
csv écrire: s.

# accepte CRLF LF CR, longueur de ligne variable
csv délimiteur: [';'] guillemet: ['"'] lignes: { :line
	Programme nettoyer.
	Sortie écrire: line, stop.
	Programme nettoyer.
}.

# lignes inégales
s ajouter: ['\njustone'].
csv écrire: s.
{
	csv délimiteur: [';'] guillemet: ['"'] lignes: { :line
		Sortie écrire: line, stop.
	}.
} intercepter: { :e 
	Sortie écrire: e, stop.
}, démarrer.

# format invalide
s := ['"he"llo";world'].
csv écrire: s.
{
	csv délimiteur: [';'] guillemet: ['"'] lignes: { :line
		Sortie écrire: line, stop.
	}.
} intercepter: { :e 
	Sortie écrire: e, stop.
}, démarrer.
