# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> chemin := ['/tmp/dat.csv'].
>> csv := Fichier nouveau: chemin.
csv écrire: s.

# accepts CRLF LF CR, varying row length
csv délimiteur: [';'] guillemet: ['"'] lignes: { :line
	Programme nettoyer.
	Sortie écrire: line, stop.
	Programme nettoyer.
}.

# unequal lines
s ajouter: ['\njustone'].
csv écrire: s.
{
	csv délimiteur: [';'] guillemet: ['"'] lignes: { :line
		Sortie écrire: line, stop.
	}.
} intercepter: { :e 
	Sortie écrire: e, stop.
}, démarrer.

# invalid format
s := ['"he"llo";world'].
csv écrire: s.
{
	csv délimiteur: [';'] guillemet: ['"'] lignes: { :line
		Sortie écrire: line, stop.
	}.
} intercepter: { :e 
	Sortie écrire: e, stop.
}, démarrer.
