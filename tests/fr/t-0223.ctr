>> x := Moment nouveau.
x zone: ['CEST'],
année:2017,
mois:01,
jour:10,
heure: 10,
minute: 0,
seconde: 0.

Sortie écrire: x, stop.

Sortie écrire: x temps, stop.

x additionner: 1 seconde.
x additionner: 2 minute.
x additionner: 3 heure.
x additionner: 4 jour.
x additionner: 1 mois.
x additionner: 6 année.

Sortie écrire: x, stop.

x soustraire: 1 seconde.
x soustraire: 2 minute.
x soustraire: 3 heure.
x soustraire: 4 jour.
x soustraire: 1 mois.
x soustraire: 6 année.

Sortie écrire: x, stop.

>> y := x copier.
>> z := x.

Sortie écrire: y, stop.
Sortie écrire: z, stop.
Sortie écrire: (x zone = y zone), stop.
Sortie écrire: (x temps = y temps), stop.
Sortie écrire: (x = z), stop.
Sortie écrire: x jour-de-année, stop.
Sortie écrire: x jour-de-la-semaine, stop.
Sortie écrire: x semaine, stop.
