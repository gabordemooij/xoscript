Nombre quand: ['roman'] faire: {
	>> nombre := soi copier.
	>> roman := [''].
	{
		{
			(nombre ≥ 1000) oui: {
				roman ajouter: ['Ⅿ'].
				nombre soustraire: 1000.
			}, interrompre.
		
			(nombre ≥ 500) oui: {
				roman ajouter: ['Ⅾ'].
				nombre soustraire: 500.
			}, interrompre.
		
			(nombre ≥ 100) oui: {
				roman ajouter: ['Ⅽ'].
				nombre soustraire: 100.
			}, interrompre.
		
			(nombre ≥ 50) oui: {
				roman ajouter: ['Ⅼ'].
				nombre soustraire: 50.
			}, interrompre.
		
			(nombre ≥ 50) oui: {
				roman ajouter: ['Ⅼ'].
				nombre soustraire: 50.
			}, interrompre.
		
			(nombre ≥ 10) oui: {
				roman ajouter: ['Ⅹ'].
				nombre soustraire: 10.
			}, interrompre.
			
			(nombre ≥ 9) oui: {
				roman ajouter: ['Ⅸ'].
				nombre soustraire: 9.
			}, interrompre.
			
			(nombre ≥ 5) oui: {
				roman ajouter: ['Ⅴ'].
				nombre soustraire: 5.
			}, interrompre.
			
			(nombre ≥ 4) oui: {
				roman ajouter: ['Ⅳ'].
				nombre soustraire: 4.
			}, interrompre.
			
			(nombre ≥ 1) oui: {
				roman ajouter: ['Ⅰ'].
				nombre soustraire: 1.
			}, interrompre.
		} procédure.
	} tant-que: { <- nombre > 0. }. <- roman.
}.

Sortie écrire: 1 roman, stop.
Sortie écrire: 2 roman, stop.
Sortie écrire: 4 roman, stop.
Sortie écrire: 8 roman, stop.
Sortie écrire: 16 roman, stop.
Sortie écrire: 32 roman, stop.
Sortie écrire: 64 roman, stop.
Sortie écrire: 128 roman, stop.
Sortie écrire: 256 roman, stop.
Sortie écrire: 1024 roman, stop.
