Nombre quand: ['romain'] faire: {
	>> nombre := soi copier.
	>> romain := [''].
	{
		{
			(nombre ≥ 1000) oui: {
				romain ajouter: ['Ⅿ'].
				nombre soustraire: 1000.
			}, interrompre.
		
			(nombre ≥ 500) oui: {
				romain ajouter: ['Ⅾ'].
				nombre soustraire: 500.
			}, interrompre.
		
			(nombre ≥ 100) oui: {
				romain ajouter: ['Ⅽ'].
				nombre soustraire: 100.
			}, interrompre.
		
			(nombre ≥ 50) oui: {
				romain ajouter: ['Ⅼ'].
				nombre soustraire: 50.
			}, interrompre.
		
			(nombre ≥ 50) oui: {
				romain ajouter: ['Ⅼ'].
				nombre soustraire: 50.
			}, interrompre.
		
			(nombre ≥ 10) oui: {
				romain ajouter: ['Ⅹ'].
				nombre soustraire: 10.
			}, interrompre.
			
			(nombre ≥ 9) oui: {
				romain ajouter: ['Ⅸ'].
				nombre soustraire: 9.
			}, interrompre.
			
			(nombre ≥ 5) oui: {
				romain ajouter: ['Ⅴ'].
				nombre soustraire: 5.
			}, interrompre.
			
			(nombre ≥ 4) oui: {
				romain ajouter: ['Ⅳ'].
				nombre soustraire: 4.
			}, interrompre.
			
			(nombre ≥ 1) oui: {
				romain ajouter: ['Ⅰ'].
				nombre soustraire: 1.
			}, interrompre.
		} procédure.
	} tant-que: { <- nombre > 0. }. <- romain.
}.

Sortie écrire: 1 romain, stop.
Sortie écrire: 2 romain, stop.
Sortie écrire: 4 romain, stop.
Sortie écrire: 8 romain, stop.
Sortie écrire: 16 romain, stop.
Sortie écrire: 32 romain, stop.
Sortie écrire: 64 romain, stop.
Sortie écrire: 128 romain, stop.
Sortie écrire: 256 romain, stop.
Sortie écrire: 1024 romain, stop.
