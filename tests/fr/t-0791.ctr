Server init.

>> DB := Maria-DB nouveau hôte: ['localhost'],
	utilisateur: ['xo'],
	mot-de-passe: ['pass123'],
	nom-base: ['xobase'],
	connecter.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> paramètres-recherche := Maria-Requête nouveau: SQL.

# set database
paramètres-recherche base-de-données: DB.

paramètres-recherche récupérer: { :row
	Sortie écrire: row world, stop.
}.
