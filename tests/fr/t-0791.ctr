Server init.

>> BD := Maria-DB nouveau hôte: ['localhost'],
	utilisateur: ['xo'],
	mot-de-passe: ['pass123'],
	nom-base: ['xobase'],
	connecter.
	
>> SQL := ['SELECT "hello" AS "world" '].

# créer la requête manuellement
>> paramètres-recherche := Maria-Requête nouveau: SQL.

# définir la base de données
paramètres-recherche base-de-données: BD.

paramètres-recherche récupérer: { :rangée
	Sortie écrire: rangée world, stop.
}.
