

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programme gestion-mémoire: 0.

>> f := Fichier nouveau: ['/tmp/citrine_test_file.txt'].
f exists: { f supprimer. }.
f écrire: ['hello world'].
>> q := f taille.
Sortie écrire: q, stop.

f := Fichier nouveau: ['/tmp/citrine_test_file.txt'].
q := f taille.
Sortie écrire: q, stop.

Programme nettoyer.
usedMemory1 := (Programme mémoire ? 0).


f := Fichier nouveau: ['/tmp/citrine_test_file.txt'].
q := f taille.
Sortie écrire: q, stop.

Programme nettoyer.
usedMemory2 := (Programme mémoire ? 0).


f := Fichier nouveau: ['/tmp/citrine_test_file.txt'].
q := f taille.
