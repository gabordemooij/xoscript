>> t := Oui.
(t = Oui) oui: { Sortie écrire: ['T']. }.
(t = Non) oui: { Sortie écrire: ['F']. }.
Sortie écrire: ['|'].
>> t := Non.
(t = Oui) oui: { Sortie écrire: ['T']. }.
(t = Non) oui: { Sortie écrire: ['F']. }.
Sortie écrire: ['|'].
>> f := Oui.
(t = Oui et: f = Non) oui: { Sortie écrire: ['T']. }.
(t = Non et: f = Oui) oui: { Sortie écrire: ['F']. }.
Sortie écrire: ['|'].
>> n := Rien.
(n Rien?) oui: { Sortie écrire: ['T']. }.
(n Rien?) non: { Sortie écrire: ['F']. }.
Sortie écrire: ['|'].
(f Boolean?) oui: { Sortie écrire: ['T']. }.
(f Boolean?) non: { Sortie écrire: ['F']. }.



