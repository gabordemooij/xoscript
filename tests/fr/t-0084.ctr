>> créerAdditionneur := { :x
	>> f := { :y <- (propre x + y). } donner: ['x'] valeur: x. <- f.
}.
>> transformateur := { :tableau :fonc
	>> projection := { :i propre q mettre: (propre f appliquer: (propre q ? i)) à: i. } 
	donner: ['q'] valeur: tableau,
	donner: ['f'] valeur: fonc.
	{ :i projection appliquer: i. } × (tableau compter).
}.

>> a := Liste ← 1; 2; 3.
transformateur appliquer: a et: (créerAdditionneur appliquer: 100).
Sortie écrire: (a position: 0), stop.
Sortie écrire: (a ? 1), stop.
Sortie écrire: (a ? 2), stop.
