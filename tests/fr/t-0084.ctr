>> makeAdder := { :x
	>> f := { :y <- (propre x + y). } donner: ['x'] valeur: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i propre q mettre: (propre f appliquer: (propre q ? i)) à: i. } 
	donner: ['q'] valeur: array,
	donner: ['f'] valeur: func.
	{ :i mapping appliquer: i. } × (array compter).
}.

>> a := Liste ← 1; 2; 3.
mapper appliquer: a et: (makeAdder appliquer: 100).
Sortie écrire: (a position: 0), stop.
Sortie écrire: (a ? 1), stop.
Sortie écrire: (a ? 2), stop.
