Nombre quand: ['factorial'] faire: {
	>> total := 1.
	{ :index total multiplier-par: (soi - index). } × soi. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programme gestion-mémoire: 0.

{
2 exponent factorial.
Sortie écrire: (11 modulo: 3), stop.
Sortie écrire: (3.4 arrondi), stop.
Sortie écrire: (7.1 plafond), stop.
Sortie écrire: (7.9 plancher), stop.
}
démarrer.

Programme nettoyer.

usedMemory1 := (Programme mémoire ? 0).

