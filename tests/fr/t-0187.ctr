Nombre quand: ['factorielle'] faire: {
	>> total := 1.
	{ :indice total multiplier-par: (soi - indice). } × soi. <- total.
}.

>> mémoireUtilisée1 := 0.
>> mémoireUtilisée2 := 0.
>> mémoireUtilisée3 := 0.
>> mémoireUtilisée4 := 0.

Programme gestion-mémoire: 0.

{
2 exposant factorielle.
Sortie écrire: (11 modulo: 3), stop.
Sortie écrire: (3.4 arrondi), stop.
Sortie écrire: (7.1 plafond), stop.
Sortie écrire: (7.9 plancher), stop.
}
démarrer.

Programme nettoyer.

mémoireUtilisée1 := (Programme mémoire ? 0).

{
2 exposant factorielle.
Sortie écrire: (11 modulo: 3), stop.
Sortie écrire: (3.4 arrondi), stop.
Sortie écrire: (7.1 plafond), stop.
Sortie écrire: (7.9 plancher), stop.
}
démarrer.

Programme nettoyer.
mémoireUtilisée2 := (Programme mémoire ? 0).


{
2 exposant factorielle.
Sortie écrire: (11 modulo: 3), stop.
Sortie écrire: (3.4 arrondi), stop.
Sortie écrire: (7.1 plafond), stop.
Sortie écrire: (7.9 plancher), stop.
} démarrer.

Programme nettoyer.
mémoireUtilisée3 := (Programme mémoire ? 0).



( mémoireUtilisée1 = mémoireUtilisée2 et: mémoireUtilisée1 = mémoireUtilisée3, et: mémoireUtilisée2 = mémoireUtilisée3 ) oui: {
	Sortie écrire: ['Pas de fuite de mémoire ici'].
}, non: {
	Sortie écrire: ['Fuite de mémoire...'].
}.
