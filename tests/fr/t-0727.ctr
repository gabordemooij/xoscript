Server init.
>> f := Format nouveau: ['%d'].
>> a := Blob nouveau: 4.
a bytes: ( Liste nouveau ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob nouveau: 4.
b bytes: ( Liste nouveau ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a de: 0 longueur: 3, chaque: { :i :byte
	Sortie écrire: ( f appliquer-entier: byte ), stop.
}.
a ^ b.
a de: 0 longueur: 3, chaque: { :i :byte
	Sortie écrire: ( f appliquer-entier: byte ), stop.
}.
a ^ b.
a de: 0 longueur: 3, chaque: { :i :byte
	Sortie écrire: ( f appliquer-entier: byte ), stop.
}.
a libérer.
b libérer.

{ a ^ Objet. } intercepter: { :e Sortie écrire: e, stop. }, démarrer.
