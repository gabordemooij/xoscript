

Texte quand: ['html'] faire: { <- (
		soi
		remplacer: ['&'] par: ['&amp;'],
		remplacer: ['<'] par: ['&lt;'],
		remplacer: ['>'] par: ['&gt;'],
		remplacer: ['"'] par: ['&quot;']
	).
}.


Sortie écrire: ([' coupé à gauche '] rogner) + [' '] + ( ['et coupé à droite'] rogner) + ['!'], stop.
Sortie écrire: ['<html>"html & entities"</html>'] html.
