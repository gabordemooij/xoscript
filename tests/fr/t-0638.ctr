
Server init.
>> rq := Requête-HTTP nouveau.
Sortie écrire: ['HTTP-GET d[]=']  + ( rq get-liste: ['d[]'] ), stop. # GET
Sortie écrire: ['HTTP-GET f[]=']  + ( rq get-liste: ['f[]'] ), stop. # GET
Sortie écrire: ['HTTP-POST e[]='] + ( rq post-liste: ['e[]'] ), stop. # GET
Sortie écrire: ['HTTP-POST c=']   + ( rq post: ['c'] ), stop. # GET
Sortie écrire: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), stop. # GET
