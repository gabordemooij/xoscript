#OBSD
>> dirname := [''].
{ dirname ajouter: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Programme système: command.
Programme chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename ajouter: ['YYYYYYYY']. } * 20.
Fichier nouveau: filename, écrire: ['sometext'].
{ Fichier liste: ['/tmp/'] + dirname. } * 1000.
Sortie écrire: ['no crash'], stop.

