


>> CoffeeMachine := Objet nouveau.
CoffeeMachine quand: ['order:'] faire: { :id
	>> coffee := ['Americano'].
	( id = 1 ) oui: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) oui: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) oui: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Objet nouveau.
SimpleCoffeeMachine quand: ['order'] faire: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Sortie écrire: redCup, stop.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Sortie écrire: greenCup, stop.
>> yellowCup := CoffeeMachine order: 1.
Sortie écrire: yellowCup, stop.
>> blueCup := CoffeeMachine order: 0.
Sortie écrire: blueCup, stop.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Sortie écrire: blackCup, stop.
blackCup ajouter: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Sortie écrire: orangeCup, stop.
