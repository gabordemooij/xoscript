


>> MachineÀCafé := Objet nouveau.
MachineÀCafé quand: ['order:'] faire: { :id
	>> coffee := ['Americano'].
	( id = 1 ) oui: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) oui: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) oui: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> MachineÀCaféSimple := Objet nouveau.
MachineÀCaféSimple quand: ['commander'] faire: { <- ['Noir']. }.
>> tasseRouge := MachineÀCafé order: 1.
Sortie écrire: tasseRouge, stop.
tasseRouge := ['Thé']. 
>> tasseVerte := MachineÀCafé order: 0.
Sortie écrire: tasseVerte, stop.
>> tasseJaune := MachineÀCafé order: 1.
Sortie écrire: tasseJaune, stop.
>> tasseBleue := MachineÀCafé order: 0.
Sortie écrire: tasseBleue, stop.
>> tasseEnPlastique := MachineÀCaféSimple commander.
tasseEnPlastique := ['Limonade']. 
>> tasseNoire := MachineÀCaféSimple commander.
Sortie écrire: tasseNoire, stop.
tasseNoire ajouter: [' nooon.... bière. '].
>> tasseOrange := MachineÀCaféSimple commander.
Sortie écrire: tasseOrange, stop.
