

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programme gestion-mémoire: 0.

>> txt := ['World Salad'].
Sortie écrire: ['this text contains: '] + ( ( txt diviser: [' '] ) compter ) + [' words.'], stop.
txt := txt de: 6 longueur: 4.
Sortie écrire: txt, stop.

Programme nettoyer.

usedMemory1 := (Programme mémoire ? 0).


txt := ['World Salad'].
Sortie écrire: ['this text contains: '] + ( ( txt diviser: [' '] ) compter ) + [' words.'], stop.
txt := txt de: 6 longueur: 4.
Sortie écrire: txt, stop.

Programme nettoyer.
usedMemory2 := (Programme mémoire ? 0).


txt := ['World Salad'].
