#Linux

(Fichier nouveau: ['/tmp/testje']) existe non: {
	Programme système: ['mkdir /tmp/testje'].	
}.

(Fichier nouveau: ['/tmp/testje/file1']) existe non: {
	Programme système: ['touch /tmp/testje/file1'].	
}.

(Fichier nouveau: ['/tmp/testje/folder1']) existe non: {
	Programme système: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Fichier liste: ['/tmp/testje'].

>> q := Liste nouveau.

l chaque: { :k :v v chaque: { :x :y q ajouter: y. }. }.

>> s := q texte.

(s contient: ['file1']) oui:   { Sortie écrire: ['OK'], stop. }.
(s contient: ['file2']) oui:   { Sortie écrire: ['XX'], stop. }.
(s contient: ['folder1']) oui: { Sortie écrire: ['OK'], stop. }.
