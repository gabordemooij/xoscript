# un guillemet jamais fermé doit donner une erreur, pas une boucle sans fin
>> chemin := ['/tmp/test0821.csv'].
>> file := Fichier nouveau: chemin.

file écrire: ['a,b\n"1,2\n'].
{
	file délimiteur: [','] guillemet: ['"'] lignes: { :line
		Sortie écrire: line, stop.
	}.
} intercepter: { :e Sortie écrire: e, stop. }, démarrer.

# un guillemet fermé fonctionne toujours
file écrire: ['a,b\n"1,2",3'].
file délimiteur: [','] guillemet: ['"'] lignes: { :line
	Sortie écrire: line, stop.
}.
file supprimer.
