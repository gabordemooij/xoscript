# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob nouveau: 8, bytes: (
	Liste nouveau ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Sortie écrire: ( utf16 décoder: ['utf16le'] ), stop.

utf16 libérer.
>> utf32 := Blob nouveau: 13, bytes: (
	Liste nouveau ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Sortie écrire: ( utf32 décoder: ['utf32be'] ), stop.
utf32 libérer.