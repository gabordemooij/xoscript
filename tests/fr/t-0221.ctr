>> x := Objet nouveau.
>> y := Objet nouveau.
>> z := x.
Sortie écrire: (x = z), stop.
Sortie écrire: (x = y), stop.
Sortie écrire: (x ≠ y), stop.
Sortie écrire: (x ≠ z), stop.
>> m := Moment nouveau année: 2070, mois: 11.
>> n := m copier.
Sortie écrire: (m = n), stop.
Sortie écrire: (m ≠ n), stop.
Sortie écrire: (m est-égal-à: m), stop.
Sortie écrire: (m est-égal-à: n), stop.
n mois: 12.
Sortie écrire: (m ≠ n), stop.
Sortie écrire: (m = n), stop.


