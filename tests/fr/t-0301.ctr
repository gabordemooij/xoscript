


>> vin := Objet nouveau.


vin quand: ['enTexte'] faire: { <- ['merlot'].
}.

vin quand: ['naarTekst'] faire: { <- ['merlot'].
}.


vin quand: ['='] faire: { :other wine <- ( soi enTexte = other wine ).
}.

vin quand: ['=='] faire: { :other wine <- ( soi enTexte = other wine ).
}.



vin
	cas: ['cabernet'] faire: { Sortie écrire: ['c'est un Cabernet !']. },
	cas: ['syrah']    faire: { Sortie écrire: ['c'est un Syrah !'].    },
	cas: ['merlot']   faire: { Sortie écrire: ['c'est un Merlot !'].   },
	cas: ['malbec']   faire: { Sortie écrire: ['c'est un Malbec !'].   }.

Sortie stop.
