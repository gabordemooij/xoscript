>> f := Fichier nouveau: ['/tmp/citrine_test_file.txt'].
f exists: { f supprimer. }.
f écrire: ['hello world'].

Programme nettoyer.
mémoireUtilisée1 := (Programme mémoire ? 0).


f := Fichier nouveau: ['/tmp/citrine_test_file.txt'].
f exists: { f supprimer. }.
f écrire: ['hello world'].

Programme nettoyer.
