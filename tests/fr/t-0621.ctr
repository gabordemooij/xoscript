>> phrases := Liste nouveau
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase : ~decoded base64 : ~encoded'].
	
phrases chaque: { :_ :phrase 
	>> e := Server base64-encoder: phrase.
	>> d := Server base64-décoder: e.
	Sortie écrire: (
		message copier ~encoded: e, ~decoded: d
	), stop.
}.
