Sortie écrire: ['Objet de test'], stop.
>> salueur := Objet nouveau.
salueur quand: ['name:'] faire: { :nom
	propre xnom := nom. 
}.
salueur quand: ['saluer'] faire: {
	Sortie écrire: ['Bonjour '] + propre xnom, stop.
}.
salueur name: ['Sherlock'].
salueur save-as: ['/tmp/a.bin'].
salueur save-as: ['/tmp/b.bin'].
Sortie écrire: ['========== RECHARGEMENT DU SNAP :'], stop.
>> b := Objet load-from: ['/tmp/a.bin'].
>> c := Objet load-from: ['/tmp/b.bin'].
b saluer.
b name: ['Watson'], saluer.
c name: ['Moriarty'], saluer.
