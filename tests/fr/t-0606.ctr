>> Point := Objet nouveau.
Point quand: ['x-coordinate:'] faire: { :x propre x := x. }.
Point quand: ['y-coordinate:'] faire: { :y propre y := y. }.
Point quand: ['coordonnée-x']  faire: { <- propre x copier. }.
Point quand: ['coordonnée-y']  faire: { <- propre y copier. }.

Point quand: ['='] faire: { :autre
	<- ( propre x = autre coordonnée-x
		 et: propre y = autre coordonnée-y ).
}.

>> jetée := Point nouveau x-coordinate: 5, y-coordinate: 6.
>> mairie := Point nouveau x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point nouveau x-coordinate: 5, y-coordinate: 6.

Sortie écrire: jetée = mairie, stop.
Sortie écrire: jetée = restaurant, stop.
