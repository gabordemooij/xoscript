>> Point := Objet nouveau.
Point quand: ['x-coordinate:'] faire: { :x propre x := x. }.
Point quand: ['y-coordinate:'] faire: { :y propre y := y. }.
Point quand: ['x-coordinate']  faire: { <- propre x copier. }.
Point quand: ['y-coordinate']  faire: { <- propre y copier. }.

Point quand: ['='] faire: { :other <- ( propre x = other x-coordinate
		 et: propre y = other y-coordinate ).
}.

>> pier := Point nouveau x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point nouveau x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point nouveau x-coordinate: 5, y-coordinate: 6.

Sortie écrire: pier = town-hall, stop.
Sortie écrire: pier = restaurant, stop.
