

Programme nettoyer.


>> Légume := Objet nouveau.
Légume quand: ['nouveau'] faire: {
	>> v := soi nouveau.
	v init. <- v.
}.

Légume quand: ['init'] faire: { propre légumes := 0. }.

Légume quand: ['carrots:'] faire: { :a propre légumes := a. <- Rien. }.
Légume quand: ['carottes'] faire: { <- propre légumes. }.
Légume quand: ['+'] faire: { :f
	>> n := Légume nouveau.
	n carrots: (f carottes + propre légumes). <- n.
}.

Légume quand: ['texte'] faire: { <- propre légumes texte.
}.

Nombre quand: ['carottes'] faire: {
	>> x := Légume nouveau.
	x carrots: soi. <- x.
}.

Nombre quand: ['additionner:et:'] faire: { :a :b <- (a + b).
}.

>> q := 0 additionner: (3 carottes + 2 carottes) et: 4 carottes.
Sortie écrire: q, stop.
