# moins de paramètres que d'emplacements doit donner une erreur, pas lire au-delà des liaisons
Server init.

>> bd := Maria-DB nouveau hôte: ['localhost'],
	utilisateur: ['xo'],
	mot-de-passe: ['pass123'],
	nom-base: ['xobase'],
	connecter.

>> paramètres-recherche := bd requête: ['SELECT ? AS a, ? AS b, ? AS c'].
paramètres-recherche paramètres: (Liste nouveau ; ['1']).
{ paramètres-recherche récupérer: { :rangée Sortie écrire: rangée, stop. }. } intercepter: { :e Sortie écrire: e, stop. }, démarrer.

>> paramètres-recherche := bd requête: ['SELECT ? AS a'].
{ paramètres-recherche récupérer: { :rangée Sortie écrire: rangée, stop. }. } intercepter: { :e Sortie écrire: e, stop. }, démarrer.

# le bon nombre fonctionne toujours, les paramètres en trop sont ignorés comme avant
>> paramètres-recherche := bd requête: ['SELECT ? AS a, ? AS b'].
paramètres-recherche paramètres: (Liste nouveau ; ['1'] ; ['2']).
paramètres-recherche récupérer: { :rangée Sortie écrire: (rangée à: ['a']), écrire: (rangée à: ['b']), stop. }.
paramètres-recherche paramètres: (Liste nouveau ; ['1'] ; ['2'] ; ['3']).
paramètres-recherche récupérer: { :rangée Sortie écrire: (rangée à: ['a']), écrire: (rangée à: ['b']), stop. }.
