Texte quand: ['html'] faire: { <- (
		soi
		remplacer: ['&'] par: ['&amp;'],
		remplacer: ['<'] par: ['&lt;'],
		remplacer: ['>'] par: ['&gt;'],
		remplacer: ['''] par: ['&apos;'],
		remplacer: ['"'] par: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programme gestion-mémoire: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Sortie écrire: txt copier html, stop.
Sortie écrire: txt copier minuscules, stop.
Sortie écrire: txt copier majuscules, stop.
} démarrer.

Programme nettoyer.

usedMemory1 := (Programme mémoire ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Sortie écrire: txt copier html, stop.
Sortie écrire: txt copier minuscules, stop.
Sortie écrire: txt copier majuscules, stop.
} démarrer.

Programme nettoyer.
usedMemory2 := (Programme mémoire ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Sortie écrire: txt copier html, stop.
Sortie écrire: txt copier minuscules, stop.
Sortie écrire: txt copier majuscules, stop.
} démarrer.

Programme nettoyer.
usedMemory3 := (Programme mémoire ? 0).



( usedMemory1 = usedMemory2 et: usedMemory1 = usedMemory3, et: usedMemory2 = usedMemory3 ) oui: {
	Sortie écrire: ['No memory leaks here'].
}, non: {
	Sortie écrire: ['Leaking memory...'].
}.
