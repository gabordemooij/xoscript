Texte quand: ['html'] faire: { <- (
		soi
		remplacer: ['&'] par: ['&amp;'],
		remplacer: ['<'] par: ['&lt;'],
		remplacer: ['>'] par: ['&gt;'],
		remplacer: ['''] par: ['&apos;'],
		remplacer: ['"'] par: ['&quot;']
	).
}.

>> mémoireUtilisée1 := 0.
>> mémoireUtilisée2 := 0.
>> mémoireUtilisée3 := 0.
>> mémoireUtilisée4 := 0.

Programme gestion-mémoire: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Sortie écrire: txt copier html, stop.
Sortie écrire: txt copier minuscules, stop.
Sortie écrire: txt copier majuscules, stop.
} démarrer.

Programme nettoyer.

mémoireUtilisée1 := (Programme mémoire ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Sortie écrire: txt copier html, stop.
Sortie écrire: txt copier minuscules, stop.
Sortie écrire: txt copier majuscules, stop.
} démarrer.

Programme nettoyer.
mémoireUtilisée2 := (Programme mémoire ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Sortie écrire: txt copier html, stop.
Sortie écrire: txt copier minuscules, stop.
Sortie écrire: txt copier majuscules, stop.
} démarrer.

Programme nettoyer.
mémoireUtilisée3 := (Programme mémoire ? 0).



( mémoireUtilisée1 = mémoireUtilisée2 et: mémoireUtilisée1 = mémoireUtilisée3, et: mémoireUtilisée2 = mémoireUtilisée3 ) oui: {
	Sortie écrire: ['Pas de fuite de mémoire ici'].
}, non: {
	Sortie écrire: ['Fuite de mémoire...'].
}.
