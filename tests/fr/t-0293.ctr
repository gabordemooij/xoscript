
>> ville := Liste ← ['Londres'] ; ['Paris'] ; ['Berlin'].
>> température := Liste ← ['15'] ; ['16'] ; ['15'].
>> météo := température par: ville.
>> villes := météo entrées trier: { :a :b <- (a comparer: b). }.
>> températures := météo valeurs trier: { :a :b <- (a comparer: b) négatif?. }.

Sortie écrire: (villes joindre: [',']), stop.
Sortie écrire: (températures joindre: [',']), stop.
