
>> city := Liste ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Liste ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature par: city.
>> cities := weather entrées trier: { :a :b <- (a comparer: b). }.
>> temperatures := weather valeurs trier: { :a :b <- (a comparer: b) négatif?. }.

Sortie écrire: (cities joindre: [',']), stop.
Sortie écrire: (temperatures joindre: [',']), stop.
