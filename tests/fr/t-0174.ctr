{
palette := Dictionnaire nouveau.
palette 
	mettre: ['#F00'] à: ['red'],
	mettre: ['#0F0'] à: ['green'],
	mettre: ['#00F'] à: ['blue'].
Sortie écrire: ['number of RGB codes in palette: '] + ( palette compter ), stop.
Sortie écrire: ['RGB code of green is: '] + ( palette ? ['green'] ), stop.
colors := [''].
( palette chaque: { :nom :code
		colors := colors + ( nom + [':'] + code ).
} ).
Sortie écrire: ['All colors in palette: '] + colors, stop.
} démarrer.
Programme nettoyer.
