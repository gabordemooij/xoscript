


>> mémoireUtilisée1 := 0.
>> mémoireUtilisée2 := 0.
>> mémoireUtilisée3 := 0.
>> mémoireUtilisée4 := 0.

Programme gestion-mémoire: 0.
>> palette := Rien.
>> couleurs := Rien.

{
palette := Dictionnaire nouveau.
palette 
	mettre: ['#F00'] à: ['rouge'],
	mettre: ['#0F0'] à: ['vert'],
	mettre: ['#00F'] à: ['bleu'].
Sortie écrire: ['nombre de codes RVB dans la palette : '] + ( palette compter ), stop.
Sortie écrire: ['le code RVB du vert est : '] + ( palette ? ['vert'] ), stop.
couleurs := [''].
( palette chaque: { :nom :code
		couleurs := couleurs + ( nom + [':'] + code ).
} ).
Sortie écrire: ['Toutes les couleurs de la palette : '] + couleurs, stop.
} démarrer.
Programme nettoyer.
mémoireUtilisée1 := (Programme mémoire ? 0).

{
palette := Dictionnaire nouveau.
palette 
	mettre: ['#F00'] à: ['rouge'],
	mettre: ['#0F0'] à: ['vert'],
	mettre: ['#00F'] à: ['bleu'].
Sortie écrire: ['nombre de codes RVB dans la palette : '] + ( palette compter ), stop.
