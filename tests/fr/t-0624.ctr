# Ce test vérifie que string_fill_in ne perd pas son emplacement (gc'ed) en mode 4
# référence dans world.c
>> Journal := Objet nouveau.

Journal quand: ['say:'] faire: { :str
	Sortie écrire: str, stop.
}.

>> Article := Objet nouveau.

Article quand: ['nouveau:'] faire: { :id
	<- soi nouveau id: id.
}.

Article quand: ['id:'] faire: { :id
	propre id := id.
}.

Article quand: ['id'] faire: { <- propre id. }.


Article quand: ['texte'] faire: {
	>> str := ['Item#~no'].
	str ~no: propre id.
	<- str.
}.


>> Print := Objet nouveau.

Print quand: ['items'] faire: { 
	
	propre article := Article nouveau: 1.
	
	# soit un segfault, soit un mauvais str ici
	Journal say: (
		['~item printed.'] ~item: propre article
	).
	
	
}.

Print items.