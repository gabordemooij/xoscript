#Linux
>> Slurp := Objet nouveau.

Slurp quand: ['nouveau'] faire: {
	propre str := [''].
}.

Slurp quand: ['nieuw'] faire: {
	propre str := [''].
}.

Slurp quand: ['répondre:'] faire: { :blah
		propre str ajouter: blah.
}.

Slurp quand: ['répondre:et:'] faire: { :blah :blahah
		propre str ajouter: (blah de: 0 longueur: (blah longueur - 1)).
		propre str ajouter: [' '].
		propre str ajouter: blahah.
}.

Slurp quand: ['obtenir'] faire: {
	>> tampon := propre str.
	propre str := ['']. <- tampon.
}.


Sortie écrire: (Programme système: (Slurp nouveau echo: ['Bonjour, je peux écrire dans la console avec une API fluide !'], obtenir)).


{ Fichier nouveau: ['/tmp/from.txt'], supprimer. } intercepter: { ['Vide']. }, démarrer.
{ Fichier nouveau: ['/tmp/to.txt'], supprimer. } intercepter: { ['Vide']. }, démarrer.


Fichier nouveau: ['/tmp/to.txt'], existe non: {
	Sortie écrire: ['Confirmed. Target file does not exist.\
'].
}.
Fichier nouveau: ['/tmp/from.txt'], existe non: {
	Sortie écrire: ['Confirmed. Source file does not exist.\
'].
}.



Programme système: (Slurp nouveau touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtenir).



Programme système: (Slurp nouveau cp: ['/tmp/from.txt /tmp/to.txt'], obtenir).

Fichier nouveau: ['/tmp/to.txt'], existe oui: {
	Sortie écrire: ['Confirmed. Target file has been created by shell.\
'].
}.


Sortie écrire: ['Le contenu du fichier est :'] + (Fichier nouveau: ['/tmp/to.txt'], lire), stop.
