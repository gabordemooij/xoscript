# un groupe qui ne fait pas partie de la correspondance ne doit pas planter et doit conserver les numéros de groupe
Server init.
>> montrer := { :regex :subject
	>> p := Motif nouveau: regex.
	p correspondance: subject faire: { :m :g
		Sortie écrire: g compter, écrire: [' '], écrire: (g joindre: ['|']), stop.
		<- m.
	}.
}.
montrer appliquer: ['(a)|(b)'] et: ['b'].
montrer appliquer: ['(a)|(b)'] et: ['a'].
montrer appliquer: ['(x)?y'] et: ['y'].
montrer appliquer: ['(x)?(y)(z)?'] et: ['xy'].
