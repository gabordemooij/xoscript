# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Motif nouveau: pattern.
	p correspondance: subject faire: { :m :g
		Sortie écrire: g compter, écrire: [' '], écrire: (g joindre: ['|']), stop. <- m.
	}.
}.
show appliquer: ['(a)|(b)'] et: ['b'].
show appliquer: ['(a)|(b)'] et: ['a'].
show appliquer: ['(x)?y'] et: ['y'].
show appliquer: ['(x)?(y)(z)?'] et: ['xy'].
