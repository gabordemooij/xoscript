

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programme gestion-mémoire: 0.

>> o := Objet nouveau.
>> o2 := Objet nouveau.
Sortie écrire: o Rien?, stop.
Sortie écrire: o type, stop.
Sortie écrire: ( o est-égal-à: o ), stop.
Sortie écrire: ( o est-égal-à: o2 ), stop.
Sortie écrire: o moi-même, stop.
Sortie écrire: ( o faire terminé ), stop.

Programme nettoyer.

usedMemory1 := (Programme mémoire ? 0).


o := Objet nouveau.
o2 := Objet nouveau.
Sortie écrire: o Rien?, stop.
Sortie écrire: o type, stop.
Sortie écrire: ( o est-égal-à: o ), stop.
Sortie écrire: ( o est-égal-à: o2 ), stop.
Sortie écrire: o moi-même, stop.
Sortie écrire: ( o faire terminé ), stop.

Programme nettoyer.
usedMemory2 := (Programme mémoire ? 0).


o := Objet nouveau.
o2 := Objet nouveau.
Sortie écrire: o Rien?, stop.
Sortie écrire: o type, stop.
Sortie écrire: ( o est-égal-à: o ), stop.
Sortie écrire: ( o est-égal-à: o2 ), stop.
Sortie écrire: o moi-même, stop.
Sortie écrire: ( o faire terminé ), stop.

Programme nettoyer.
usedMemory3 := (Programme mémoire ? 0).



( usedMemory1 = usedMemory2 et: usedMemory1 = usedMemory3, et: usedMemory2 = usedMemory3 ) oui: {
	Sortie écrire: ['No memory leaks here'].
}, non: {
	Sortie écrire: ['Leaking memory...'].
}.
