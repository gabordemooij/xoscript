

>> mémoireUtilisée1 := 0.
>> mémoireUtilisée2 := 0.
>> mémoireUtilisée3 := 0.
>> mémoireUtilisée4 := 0.

Programme gestion-mémoire: 0.

>> o := Objet nouveau.
>> o2 := Objet nouveau.
Sortie écrire: o Rien?, stop.
Sortie écrire: o type, stop.
Sortie écrire: ( o est-égal-à: o ), stop.
Sortie écrire: ( o est-égal-à: o2 ), stop.
Sortie écrire: o moi-même, stop.
Sortie écrire: ( o faire terminé ), stop.

Programme nettoyer.

mémoireUtilisée1 := (Programme mémoire ? 0).


o := Objet nouveau.
o2 := Objet nouveau.
Sortie écrire: o Rien?, stop.
Sortie écrire: o type, stop.
Sortie écrire: ( o est-égal-à: o ), stop.
Sortie écrire: ( o est-égal-à: o2 ), stop.
Sortie écrire: o moi-même, stop.
Sortie écrire: ( o faire terminé ), stop.

Programme nettoyer.
mémoireUtilisée2 := (Programme mémoire ? 0).


o := Objet nouveau.
o2 := Objet nouveau.
Sortie écrire: o Rien?, stop.
Sortie écrire: o type, stop.
Sortie écrire: ( o est-égal-à: o ), stop.
Sortie écrire: ( o est-égal-à: o2 ), stop.
Sortie écrire: o moi-même, stop.
Sortie écrire: ( o faire terminé ), stop.

Programme nettoyer.
mémoireUtilisée3 := (Programme mémoire ? 0).



( mémoireUtilisée1 = mémoireUtilisée2 et: mémoireUtilisée1 = mémoireUtilisée3, et: mémoireUtilisée2 = mémoireUtilisée3 ) oui: {
	Sortie écrire: ['Pas de fuite de mémoire ici'].
}, non: {
	Sortie écrire: ['Fuite de mémoire...'].
}.
