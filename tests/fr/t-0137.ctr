


Programme gestion-mémoire: 0.

>> x := 0.
>> y := ['Hello'].
>> q := { ['Vide']. }.
>> p := Oui.
>> a := Liste ← 1 ; 2 ; 3 ; 4.

>> mémoireUtilisée1 := 0.
>> mémoireUtilisée2 := 0.
>> mémoireUtilisée3 := 0.
>> mémoireUtilisée4 := 0.

Programme nettoyer.
mémoireUtilisée1 := (Programme mémoire ? 0).




x := 1.
y := ['Hello'].
q := { ['Vide']. }.
p := Oui.
a := Liste ← 1 ; 2 ; 3 ; 5.

Programme nettoyer.
mémoireUtilisée2 := (Programme mémoire ? 0).




x := 2.
y := ['Hello'].
q := { ['Vide']. }.
p := Oui.
a := Liste ← 1 ; 2 ; 3 ; 4.

Programme nettoyer.
mémoireUtilisée3 := (Programme mémoire ? 0).




x := 3.
y := ['Hello'].
q := { ['Vide']. }.
p := Oui.
a := Liste ← 1 ; 2 ; 3 ; 5.


Programme nettoyer.
mémoireUtilisée4 := (Programme mémoire ? 0).





x := 4.
y := ['Hello'].
q := { ['Vide']. }.
p := Oui.
a := Liste ← 1 ; 2 ; 3 ; 4.

Programme nettoyer.
>> mémoireUtilisée5 := (Programme mémoire ? 0).




(mémoireUtilisée1 = mémoireUtilisée2 = mémoireUtilisée3 = mémoireUtilisée4 = mémoireUtilisée5) oui: {
	Sortie écrire: ['L'utilisation de la mémoire reste stable.'], stop.
}, sinon: {
	Sortie écrire: ['La mémoire utilisée n'est pas stable.'], stop.
	Sortie écrire: mémoireUtilisée1, stop.
	Sortie écrire: mémoireUtilisée2, stop.
	Sortie écrire: mémoireUtilisée3, stop.
	Sortie écrire: mémoireUtilisée4, stop.
	Sortie écrire: mémoireUtilisée5, stop.
}.
