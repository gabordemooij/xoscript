60 × {
	>> x := (Nombre hasard % 6) + 1.
	(x ≤ 6) non: { Sortie écrire: ['ÉCHEC']. }.
	(x ≥0) non: { Sortie écrire: ['ÉCHEC']. }.
	x := (Nombre hasard % 3) + 1.
	(x < 3) non: { Sortie écrire: ['ÉCHEC']. }.
	(x>-1) non: { Sortie écrire: ['ÉCHEC']. }.
	x := ((Booléen pileOuFace) nombre).
	(x = 0 ou: x = 1) non: { Sortie écrire: ['ÉCHEC']. }.
	x := ((Oui pileOuFace) nombre).
	(x = 0 ou: x = 1) non: { Sortie écrire: ['ÉCHEC']. }.
	x := (Booléen pileOuFace soit: ['FACE'] soit: ['PILE']).
	((x = ['FACE']) ou: (x = ['PILE'])) non: { Sortie écrire: ['ÉCHEC']. }.
}.
Sortie écrire: ['TERMINÉ'].

