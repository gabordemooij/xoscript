60 × {
	>> x := (Nombre random % 6) + 1.
	(x ≤ 6) non: { Sortie écrire: ['FAIL']. }.
	(x ≥0) non: { Sortie écrire: ['FAIL']. }.
	x := (Nombre random % 3) + 1.
	(x < 3) non: { Sortie écrire: ['FAIL']. }.
	(x>-1) non: { Sortie écrire: ['FAIL']. }.
	x := ((Booléen flip) nombre).
	(x = 0 ou: x = 1) non: { Sortie écrire: ['FAIL']. }.
	x := ((Oui flip) nombre).
	(x = 0 ou: x = 1) non: { Sortie écrire: ['FAIL']. }.
	x := (Booléen flip soit: ['HEAD'] soit: ['TAIL']).
	((x = ['HEAD']) ou: (x = ['TAIL'])) non: { Sortie écrire: ['FAIL']. }.
}.
Sortie écrire: ['DONE'].

