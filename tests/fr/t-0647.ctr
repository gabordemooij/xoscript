Server init.
Sortie écrire: ['Test d'heure de base de données'], stop.

>> bd := Maria-DB nouveau hôte: ['localhost'],
	utilisateur: ['xo'], 
	mot-de-passe: ['pass123'],
	nom-base: ['xobase'],
	connecter.

>> paramètres-recherche :=
bd requête: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
récupérer: { :rangée
	Sortie écrire: rangée timetest, stop.
}.
