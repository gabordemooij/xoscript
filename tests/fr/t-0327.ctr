

Liste quand: ['fixture:'] faire: { :f
	propre fixture := f.
}.

Liste quand: ['compter'] faire: { <- propre fixture.
}.

Liste quand: ['aantal'] faire: { <- propre fixture.
}.


>> x := Rien.
{

	x := ['hello'] 
	remplacer:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] caractère: 2)
			)
		)
	par: (
		(['...hal'] + ['lo']) 
			majuscules 
			lowecase 
			majuscules 
			décalage: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Liste ← 0 ; 1 ; 4; 9 ; (Liste ← 0 ; 3; 1) ; 4
							) avant-dernier
						) ? 1
					) + 
					((Liste ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					compter
				)
			)
	).

} × 10.
Sortie écrire: x, stop.

