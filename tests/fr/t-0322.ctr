

>> Matriochka := Objet nouveau.
Matriochka quand: ['double:'] faire: { :secret
	propre secret := secret × 2.
}.
Matriochka quand: ['nouveau:'] faire: { :secret
	>> solution := Rien.
	>> t := (secret > 255).
	Sortie écrire: (secret + [' | '] + t), stop.
	t oui: {
		solution := secret.
	}, sinon: {
		solution := Matriochka récursif nouveau: (soi double: secret).
	}. <- solution.
}.

>> x := Matriochka nouveau: 2.
