

>> Matryoshka := Objet nouveau.
Matryoshka quand: ['double:'] faire: { :secret
	propre secret := secret × 2.
}.
Matryoshka quand: ['nouveau:'] faire: { :secret
	>> answer := Rien.
	>> t := (secret > 255).
	Sortie écrire: (secret + [' | '] + t), stop.
	t oui: {
		answer := secret.
	}, sinon: {
		answer := Matryoshka récursif nouveau: (soi double: secret).
	}. <- answer.
}.

>> x := Matryoshka nouveau: 2.
