# test de base de données
# voir l'exemple server.xo pour la configuration requise

Server init.
Sortie écrire: ['Test de base de données'], stop.

>> bd := Maria-DB nouveau hôte: ['localhost'],
	utilisateur: ['xo'], mot-de-passe: ['pass123'], nom-base: ['xobase'], connecter.

Sortie écrire: ['Peut-on se connecter ? '] + bd connecté?, stop.

>> paramètres-recherche := bd requête: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], paramètres: ( Liste nouveau ; ['abc'] ; 12.35 ; 6 ). # requêtes paramétrées

{  paramètres-recherche exécuter. bd valider. } intercepter: { :e bd annuler.  }, démarrer.

Sortie écrire: ['Peut-on insérer ? '] + ( paramètres-recherche insert-id > 0 ), stop.

>> Obj := Objet nouveau.
Obj quand: ['récupérer-rangées'] faire: {
	propre compter := 0.
	>> paramètres-recherche :=
	bd requête: ['SELECT * FROM book order by id desc limit 2'], 
	récupérer: { :rangée 
		propre compter additionner: 1.
		Oui interrompre.
	}. # récupération des lignes
	<- propre compter copier.
}.

Sortie écrire: ['Peut-on interroger ? '] + ( Obj récupérer-rangées > 0 ), stop.
