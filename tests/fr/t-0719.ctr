Server init.
>> fmt := Format nouveau: ['%#3x'].

>> blob := Blob nouveau: 4.
blob bytes: ( 
	Liste nouveau ; 0 ; 1 ; 2 ; 3
).

>> file := Fichier nouveau: ['/tmp/blob'].
file blob: blob.
blob libérer.

>> lire := file blob.
lire 
de: 0 
longueur: 4, 
faire chaque: { :i :b 
	Sortie
	écrire: (fmt appliquer-entier: b),
	stop.
}.
lire libérer.
