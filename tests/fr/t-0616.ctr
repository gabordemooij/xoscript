Liste quand: ['copier'] faire: {
	>> copier := Liste nouveau.
	soi chaque: { :nombre :section
		copier ajouter: section récursif copier.
	}. <- copier.
}.

>> sheep := Liste nouveau ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep copier.
clones chaque: { :nombre :sheep
	sheep ajouter: ['2'].
}.

Sortie écrire: sheep, stop.
Sortie écrire: clones, stop.
