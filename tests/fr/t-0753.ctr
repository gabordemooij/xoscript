Sortie écrire: ['Objet de test'], stop.
>> a := Objet nouveau. 

a quand: ['item:'] faire: { :fmt
	propre fmt := fmt. 
}.

a quand: ['article'] faire: {
	<- propre fmt.
}.

a item: ( Format nouveau: ['|%s|'] ).

Sortie écrire: a article, stop.

>> ancienne-adresse-fmt := a article prototype adresse-mémoire.
a save-as: ['/tmp/a.bin'].
Sortie écrire: ['========== RECHARGEMENT DU SNAP :'], stop.

>> b := Objet load-from: ['/tmp/a.bin'].

(b article prototype adresse-mémoire = ancienne-adresse-fmt) oui: {
	Sortie écrire: ['Lien d'objet rattaché.'], stop.
}.

Sortie écrire: ( b article appliquer: ['hello'] ), stop.
