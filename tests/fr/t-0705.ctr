

>> obj := Objet nouveau.

obj quand: ['saluer'] faire: {
	<- ['salut'].
}.

# doit afficher hi123hi123ok
obj quand: ['tâche'] faire: {
	propre propriété := 123.
	{
		# essayer lie soi/propre à l'objet au lieu du bloc
		Sortie écrire: soi saluer.
		Sortie écrire: propre propriété.
		1 / 0.
	} intercepter: {
		Sortie écrire: soi saluer.
		Sortie écrire: propre propriété.
		Sortie écrire: ['ok'].
	}, essayer.
}.

obj tâche.