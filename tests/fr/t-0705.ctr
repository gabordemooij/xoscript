

>> obj := Objet nouveau.

obj quand: ['greet'] faire: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj quand: ['task'] faire: {
	propre property := 123.
	{
		# try binds self/own to object instead of block
		Sortie écrire: soi greet.
