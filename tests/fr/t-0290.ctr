# test des opérations sur les listes


>> gâteaux := Liste ←
	['apple'] ;
	['baies'] ;
	['choco'] ;
	['fromage'].


>> achat := gâteaux remplacer: 1 longueur: 2 par: ( Liste ← ['cannelle'] ; ['ananas'] ).
Sortie écrire: (achat joindre: [',']), stop.


>> achat := gâteaux remplacer: 1 longueur: 12 par: ( Liste ← ['cannelle'] ; ['ananas'] ).
Sortie écrire: (achat joindre: [',']), stop.


>> achat := gâteaux remplacer: 2 longueur: 10 par: ( Liste nouveau ).
Sortie écrire: (achat joindre: [',']), stop.


>> achat := gâteaux remplacer: 0 longueur: 1 par: ( Liste nouveau ).
Sortie écrire: (achat joindre: [',']), stop.


>> achat := gâteaux remplacer: ['0'] longueur: ['1'] par: ['x'].
Sortie écrire: (achat joindre: [',']), stop.
