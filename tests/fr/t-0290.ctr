# test list operations


>> cakes := Liste ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes remplacer: 1 longueur: 2 par: ( Liste ← ['cinnamon'] ; ['pineapple'] ).
Sortie écrire: (buy joindre: [',']), stop.


>> buy := cakes remplacer: 1 longueur: 12 par: ( Liste ← ['cinnamon'] ; ['pineapple'] ).
Sortie écrire: (buy joindre: [',']), stop.


>> buy := cakes remplacer: 2 longueur: 10 par: ( Liste nouveau ).
Sortie écrire: (buy joindre: [',']), stop.


>> buy := cakes remplacer: 0 longueur: 1 par: ( Liste nouveau ).
Sortie écrire: (buy joindre: [',']), stop.


>> buy := cakes remplacer: ['0'] longueur: ['1'] par: ['x'].
Sortie écrire: (buy joindre: [',']), stop.
