>> items := Dictionnaire nouveau.
items mettre: ['noir'] à: ['coffee'], mettre: ['earl grey'] à: ['thé'].
Sortie écrire: (items à: ['coffee']), écrire: (items à: ['thé']).
Sortie écrire: ['il y a'] + items compter + [' éléments dans le tableau.'].
items mettre: ['cappuccino'] à: ['coffee'].
Sortie écrire: ['Maintenant mon café est.. '] + (items à: ['coffee']).
items mettre: ['aaa'] à: ['1'].
items mettre: ['bbb'] à: ['2'].
Sortie écrire: (items à: ['a']).
