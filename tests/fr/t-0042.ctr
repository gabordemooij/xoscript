>> items := Dictionnaire nouveau.
items mettre: ['black'] à: ['coffee'], mettre: ['earl grey'] à: ['tea'].
Sortie écrire: (items à: ['coffee']), écrire: (items à: ['tea']).
Sortie écrire: ['there are'] + items compter + [' items in the array.'].
items mettre: ['capuccino'] à: ['coffee'].
Sortie écrire: ['Now my coffee is.. '] + (items à: ['coffee']).
items mettre: ['aaa'] à: ['1'].
items mettre: ['bbb'] à: ['2'].
Sortie écrire: (items à: ['a']).
