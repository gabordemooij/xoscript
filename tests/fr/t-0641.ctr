# Test du nettoyeur utf8
Server init.

>> casutf8 := Dictionnaire nouveau
	# ASCII uniquement
	mettre: ( Liste nouveau ; 65 ; 65 ; 65 ; 65 ; 0 ) à: ['AAAA'],
	# séquence valide de 2 octets
	mettre: ( Liste nouveau ; 194 ; 162 ; 0 ) à: ['¢'],
	# UTF-8 valide sur 3 octets
    mettre: ( Liste nouveau ; 226 ; 130 ; 172 ; 0 ) à: ['€'],
	# UTF-8 valide sur 4 octets
    mettre: ( Liste nouveau ; 240 ; 144 ; 141 ; 136 ; 0 ) à: ['𐍈'],
	# Octet de continuation invalide dans la séquence E2 28 AC -> début seq 3o + 28 cnt erroné + AC octet cnt, mais relève de la même erreur
    mettre: ( Liste nouveau ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) à: ['A?A'],
	# Encodage trop long de l'ASCII 'A' (devrait devenir ?),
    mettre: ( Liste nouveau ; 65 ; 193 ; 129 ; 0 ) à: ['A?'],
	# Premier octet invalide (0xFF)
    mettre: ( Liste nouveau ; 255 ; 0 ) à: ['?'],
	# Séquence multi-octets incomplète à la fin
    mettre: ( Liste nouveau ; 66 ; 226 ; 0 ) à: ['B?'],
    # Texte vide
    #put: ( List new ) at: [''],
	# Plusieurs séquences mélangées
    mettre: ( Liste nouveau ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) à: ['A€?𐍈B'].
	 
casutf8 chaque: { :key :value
	>> blob := Blob nouveau: value compter, bytes: value.
	>> str := blob texte.
	(str = key) oui: {
		Sortie écrire: ['OK'], stop.
	}, sinon: {
		Sortie écrire: ['Le nettoyeur UTF8 a échoué sur : '] + key + [' obtenu : '] + str, stop.
	}.
	blob libérer.
}.
