

>> mémoireUtilisée1 := 0.
>> mémoireUtilisée2 := 0.
>> mémoireUtilisée3 := 0.
>> mémoireUtilisée4 := 0.

Programme gestion-mémoire: 0.

{ :i Sortie écrire: i. } × 4.
Sortie stop.
{ :i Sortie écrire: (4 - i). } × 4.
Sortie stop.
( 1 > 2 ) non: { Sortie écrire: ['BLOC 1'], stop. }.
( 2 > 1 ) oui:  { Sortie écrire: ['BLOC 2'], stop. }.

>> i := 0.
{ Sortie écrire: i. i additionner: 1. } tant-que: { <- ( i < 3). }.
Sortie stop.

i := 3.
{ Sortie écrire: i. i := i - 1. } tant-que: { <- ( i > 0). }.
Sortie stop.


Programme nettoyer.

mémoireUtilisée1 := (Programme mémoire ? 0).


{ :i  Sortie écrire: i. } × 4.
Sortie stop.
{ :i  Sortie écrire: (4 - i). } × 4.
Sortie stop.
( 1 > 2 ) non: { Sortie écrire: ['BLOC 1'], stop. }.
( 2 > 1 ) oui:  { Sortie écrire: ['BLOC 2'], stop. }.

>> i := 0.
{ Sortie écrire: i. i additionner: 1. } tant-que: { <- ( i < 3). }.
Sortie stop.

i := 3.
{ Sortie écrire: i. i := i - 1. } tant-que: { <- ( i > 0). }.
Sortie stop.



Programme nettoyer.
mémoireUtilisée2 := (Programme mémoire ? 0).


{ :i Sortie écrire: i. } × 4.
Sortie stop.
{ :i Sortie écrire: (4 - i). } × 4.
Sortie stop.
( 1 > 2 ) non: { Sortie écrire: ['BLOC 1'], stop. }.
( 2 > 1 ) oui:  { Sortie écrire: ['BLOC 2'], stop. }.

>> i := 0.
{ Sortie écrire: i. i additionner: 1. } tant-que: { <- ( i < 3). }.
Sortie stop.

i := 3.
{ Sortie écrire: i. i := i - 1. } tant-que: { <- ( i > 0). }.
Sortie stop.

Programme nettoyer.
mémoireUtilisée3 := (Programme mémoire ? 0).



( mémoireUtilisée1 = mémoireUtilisée2 et: mémoireUtilisée1 = mémoireUtilisée3, et: mémoireUtilisée2 = mémoireUtilisée3 ) oui: {
	Sortie écrire: ['Pas de fuite de mémoire ici'].
}, non: {
	Sortie écrire: ['Fuite de mémoire...'].
}.
