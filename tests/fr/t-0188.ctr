

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programme gestion-mémoire: 0.

{ :i Sortie écrire: i. } × 4.
Sortie stop.
{ :i Sortie écrire: (4 - i). } × 4.
Sortie stop.
( 1 > 2 ) non: { Sortie écrire: ['BLOCK 1'], stop. }.
( 2 > 1 ) oui:  { Sortie écrire: ['BLOCK 2'], stop. }.

>> i := 0.
{ Sortie écrire: i. i additionner: 1. } tant-que: { <- ( i < 3). }.
Sortie stop.

i := 3.
{ Sortie écrire: i. i := i - 1. } tant-que: { <- ( i > 0). }.
Sortie stop.


Programme nettoyer.

usedMemory1 := (Programme mémoire ? 0).


{ :i  Sortie écrire: i. } × 4.
Sortie stop.
{ :i  Sortie écrire: (4 - i). } × 4.
Sortie stop.
( 1 > 2 ) non: { Sortie écrire: ['BLOCK 1'], stop. }.
( 2 > 1 ) oui:  { Sortie écrire: ['BLOCK 2'], stop. }.

>> i := 0.
{ Sortie écrire: i. i additionner: 1. } tant-que: { <- ( i < 3). }.
Sortie stop.

i := 3.
{ Sortie écrire: i. i := i - 1. } tant-que: { <- ( i > 0). }.
Sortie stop.



Programme nettoyer.
usedMemory2 := (Programme mémoire ? 0).


{ :i Sortie écrire: i. } × 4.
Sortie stop.
{ :i Sortie écrire: (4 - i). } × 4.
Sortie stop.
( 1 > 2 ) non: { Sortie écrire: ['BLOCK 1'], stop. }.
( 2 > 1 ) oui:  { Sortie écrire: ['BLOCK 2'], stop. }.

>> i := 0.
{ Sortie écrire: i. i additionner: 1. } tant-que: { <- ( i < 3). }.
Sortie stop.

i := 3.
{ Sortie écrire: i. i := i - 1. } tant-que: { <- ( i > 0). }.
Sortie stop.

Programme nettoyer.
usedMemory3 := (Programme mémoire ? 0).



( usedMemory1 = usedMemory2 et: usedMemory1 = usedMemory3, et: usedMemory2 = usedMemory3 ) oui: {
	Sortie écrire: ['No memory leaks here'].
}, non: {
	Sortie écrire: ['Leaking memory...'].
}.
