

Liste quand: ['column:'] faire: { :colonne
	>> résultat := Liste nouveau.
	soi chaque: { :indice :rangée
		rangée chaque: { :indice :cellule
			(indice = colonne) oui: { résultat ajouter: cellule. }.
		}.
	}. <- résultat.
}.


>> a := Liste ←
	(Liste ← 1 ; 2 ; 3) ;
	(Liste ← 4 ; 5 ; 6) ;
	(Liste ← 7 ; 8 ; 9).

>> b := a column: 1.
Sortie écrire: b, stop.

b := a column: 20.
Sortie écrire: b, stop.

b := a column: -100.
Sortie écrire: b, stop.
