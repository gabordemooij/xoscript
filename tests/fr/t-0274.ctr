

Liste quand: ['column:'] faire: { :column
	>> result := Liste nouveau.
	soi chaque: { :index :row
		row chaque: { :index :cell
			(index = column) oui: { result ajouter: cell. }.
		}.
	}. <- result.
}.


>> a := Liste ←
	(Liste ← 1 ; 2 ; 3) ;
	(Liste ← 4 ; 5 ; 6) ;
	(Liste ← 7 ; 8 ; 9).

>> b := a column: 1.
Sortie écrire: b, stop.

b := a column: 20.
Sortie écrire: b, stop.

b := a column: -100.
Sortie écrire: b, stop.
