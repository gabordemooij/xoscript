# test des conversions de type / conversions / liaisons
Programme gestion-mémoire: 4.
Server init.

>> compteur := 0.
>> bd := Maria-DB nouveau hôte: ['localhost'],
	utilisateur: ['xo'], mot-de-passe: ['pass123'], nom-base: ['xobase'], connecter.

>> FormatDeuxChiffres := Format nouveau: ['%02d'].

# Date et heure
{
	>> année     := Nombre entre: 1995 et: 2050, texte.
	>> mois    := FormatDeuxChiffres appliquer-entier: (Nombre entre: 1 et: 12), texte.
	>> jour      := FormatDeuxChiffres appliquer-entier: (Nombre entre: 1 et: 28), texte.
	>> heure     := FormatDeuxChiffres appliquer-entier: (Nombre entre: 1 et: 23), texte.
	>> minute   := FormatDeuxChiffres appliquer-entier: (Nombre entre: 1 et: 59), texte.
	>> seconde   := FormatDeuxChiffres appliquer-entier: (Nombre entre: 1 et: 59), texte.
	>> dateheure := ['YYYY-MM-DD HH:II:SS'].	
	dateheure
		YYYY: année,
		MM: mois,
		DD: jour,
		HH: heure,
		II: minute,
		SS: seconde.
	>> paramètres-recherche :=
	bd requête: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: dateheure),
	récupérer: { :rangée
		(rangée mydatetime = dateheure) non: {
			cette-tâche erreur: (
				['Attendu : <expected> mais obtenu : <observation>']
				<expected>: dateheure,
				<observation>: rangée mydatetime
			).
		}.
	
	}.
	compteur additionner: 1.
} * 100.

# Date
{
	>> année     := Nombre entre: 1995 et: 2050, texte.
	>> mois    := FormatDeuxChiffres appliquer-entier: (Nombre entre: 1 et: 12), texte.
	>> jour      := FormatDeuxChiffres appliquer-entier: (Nombre entre: 1 et: 28), texte.
	>> date     := ['YYYY-MM-DD'].
	date
		YYYY: année,
		MM: mois,
		DD: jour.
	>> paramètres-recherche :=
	bd requête: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: date),
	récupérer: { :rangée
		(rangée mydate = date) non: {
			cette-tâche erreur: (
				['Attendu : <expected> mais obtenu : <observation>']
				<expected>: date,
				<observation>: rangée mydate
			).
		}.
	}.
	compteur additionner: 1.
} * 100.


# Heure
{
	>> heure     := FormatDeuxChiffres appliquer-entier: (Nombre entre: 1 et: 23), texte.
	>> minute   := FormatDeuxChiffres appliquer-entier: (Nombre entre: 1 et: 59), texte.
	>> seconde   := FormatDeuxChiffres appliquer-entier: (Nombre entre: 1 et: 59), texte.
	>> temps := ['HH:II:SS'].
	temps
		HH: heure,
		II: minute,
		SS: seconde.
	>> paramètres-recherche :=
	bd requête: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: temps),
	récupérer: { :rangée
		(rangée mytime = temps) non: {
			cette-tâche erreur: (
				['Attendu : <expected> mais obtenu : <observation>']
				<expected>: dateheure,
				<observation>: rangée mytime
			).
		}.
	}.
	compteur additionner: 1.
} * 100.


# Textes (varchar/text)
>> str1 := Liste nouveau remplir: 100000 avec: ['x'], joindre: [''].
{
	>> str2 := Coffre jeton: 40.
	>> paramètres-recherche :=
	bd requête: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	récupérer: { :rangée
		(rangée str1 = str1 et: rangée str2 = str2) non: {
			cette-tâche erreur: (
				['Attendu : <expected> mais obtenu : <observation>']
				<expected>: dateheure,
				<observation>: rangée mytime
			).
		}.
	}.
	compteur additionner: 1.
} * 100.


# Nombres
{
	>> n1  := Nombre entre: 1 et: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 depuis-texte: ['9223372036854775807'] ) -
		( Int64 depuis-texte: ['99999'] ) +
		( Int64 depuis-texte: n1 texte )
	).
	>> paramètres-recherche :=
	bd requête: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	récupérer: { :rangée
		(rangée n1 = n1) non: {
			cette-tâche erreur: (
				['Attendu : <expected> mais obtenu : <observation>']
				<expected>: n1,
				<observation>: rangée n1
			).
		}.
		(rangée n2 = n2) non: {
			cette-tâche erreur: (
				['Attendu : <expected> mais obtenu : <observation>']
				<expected>: n1,
				<observation>: rangée n2
			).
		}.
		(rangée n3 = n2 arrondi) non: {
			cette-tâche erreur: (
				['Attendu : <expected> mais obtenu : <observation>']
				<expected>: n1,
				<observation>: rangée n3
			).
		}.
		(rangée big = big) non: {
			cette-tâche erreur: (
				['Attendu : <expected> mais obtenu : <observation>']
				<expected>: big,
				<observation>: rangée big
			).
		}.
		
	}.
	compteur additionner: 1.
} * 100.


Sortie écrire: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: compteur
), stop.