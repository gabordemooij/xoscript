>> q := Objet nouveau.
q quand: ['setProperty:'] faire: { :x
	propre prop := x.
}.
q quand: ['getProperty'] faire: { <- propre prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Sortie écrire: [' p = '] + (p getProperty).
