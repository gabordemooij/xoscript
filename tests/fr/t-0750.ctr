Sortie écrire: ['Test object'], stop.
>> a := Objet nouveau. 

a quand: ['item:'] faire: { :nil
	propre nil := nil. 
}.

a quand: ['item'] faire: { <- propre nil.
}.

a item: Rien.

Sortie écrire: a item, stop.

>> old-nil-address := a item prototype adresse-mémoire.
a save-as: ['/tmp/a.bin'].
Sortie écrire: ['========== RELOADING SNAP:'], stop.

>> b := Objet load-from: ['/tmp/a.bin'].

(b item prototype adresse-mémoire = old-nil-address) oui: {
	Sortie écrire: ['Object link re-attached.'], stop.
}.

Sortie écrire: b item, stop.
