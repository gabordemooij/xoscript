Sortie écrire: ['Objet de test'], stop.
>> a := Objet nouveau. 

a quand: ['item:'] faire: { :néant
	propre néant := néant. 
}.

a quand: ['article'] faire: {
	<- propre néant.
}.

a item: Rien.

Sortie écrire: a article, stop.

>> ancienne-adresse-néant := a article prototype adresse-mémoire.
a save-as: ['/tmp/a.bin'].
Sortie écrire: ['========== RECHARGEMENT DU SNAP :'], stop.

>> b := Objet load-from: ['/tmp/a.bin'].

(b article prototype adresse-mémoire = ancienne-adresse-néant) oui: {
	Sortie écrire: ['Lien d'objet rattaché.'], stop.
}.

Sortie écrire: b article, stop.
