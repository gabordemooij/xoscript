Liste quand: ['somme'] faire: {
	>> total := 0.
	soi chaque: { :indice :élément
		total additionner: élément.
	}. <- total.
}.

>> a := Oui.



a quand: ['texte'] faire: {
	>> solution := Rien.
	( soi = Oui ) oui: {
		solution := ['Ouais'].
	}, sinon: {
		solution := ['Nan'].
	}. <- solution.
}.

a quand: ['nombre'] faire: {
	>> solution := Rien.
	( soi = Oui ) oui: {
		solution := 10.
	}, sinon: {
		solution := 20.
	}. <- solution.
}.

>> b := 666.

b quand: ['texte'] faire: { <- ['Diable'].
}.

b quand: ['booléen'] faire: { <- Non.
}.


Sortie écrire: a, stop.  
Sortie écrire: (90 + a), stop. 
Sortie écrire: b, stop. 
Sortie écrire: (Oui et: b), stop.

a := Liste ← ['hello'] ; ['world'] ; Oui ; Rien ; 666. 
a := a + ( Liste ← 1 ).
Sortie écrire: a, stop.
Sortie écrire: ((Dictionnaire nouveau) mettre: Rien à: Rien), stop.
Sortie écrire: a somme, stop. 


{
	a quand: ['texte'] faire: { <- Rien. }.
	a := [''] + a.
} intercepter: { :erreur
	Sortie écrire: ['Erreur notée : '] + erreur, stop.
}, démarrer.



