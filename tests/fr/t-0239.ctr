Liste quand: ['sum'] faire: {
	>> total := 0.
	soi chaque: { :index :element
		total additionner: element.
	}. <- total.
}.

>> a := Oui.



a quand: ['texte'] faire: {
	>> answer := Rien.
	( soi = Oui ) oui: {
		answer := ['Yep'].
	}, sinon: {
		answer := ['Nope'].
	}. <- answer.
}.

a quand: ['nombre'] faire: {
	>> answer := Rien.
	( soi = Oui ) oui: {
		answer := 10.
	}, sinon: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b quand: ['texte'] faire: { <- ['Devil'].
}.

b quand: ['booléen'] faire: { <- Non.
}.


Sortie écrire: a, stop.  
Sortie écrire: (90 + a), stop. 
Sortie écrire: b, stop. 
Sortie écrire: (Oui et: b), stop.

a := Liste ← ['hello'] ; ['world'] ; Oui ; Rien ; 666. 
a := a + ( Liste ← 1 ).
Sortie écrire: a, stop.
Sortie écrire: ((Dictionnaire nouveau) mettre: Rien à: Rien), stop.
Sortie écrire: a sum, stop. 


{
	a quand: ['texte'] faire: { <- Rien. }.
	a := [''] + a.
} intercepter: { :error
	Sortie écrire: ['Error noted: '] + error, stop.
}, démarrer.



