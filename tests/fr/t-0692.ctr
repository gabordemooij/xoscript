Server init.

Sortie écrire: (
	Motif nouveau: ['^\\w+$'],
	correspondance: ['test@example.com'] 
), stop. # 0 correspondance, échoue sur @ et .

Sortie écrire: (
	Motif nouveau: ['^[^@]+@[^\.]+\.\\w+$'],
	correspondance: ['test@example.com'] 
), stop. # 1 correspondance

Sortie écrire: (
	Motif nouveau: ['[^@]+@[^\.]+\.\\w+'],
	correspondance: ['test@example.com'] 
), stop. # 1 correspondance

Sortie écrire: (
	Motif nouveau: ['([^@]+)@([^\.]+)\.\\w+'],
	correspondance: ['test@example.com'] 
), stop. # 1 correspondance, les groupes n'ont pas d'importance

Sortie écrire: (
	Motif nouveau: ['[a-z]'],
	correspondance: ['test@example.com'] 
), stop. # 14 correspondances

Sortie écrire: (
	Motif nouveau: ['.*'],
	correspondance: ['test@example.com'] 
), stop. # 1 correspondance (tout)

Sortie écrire: (
	Motif nouveau: ['(.*)'],
	correspondance: ['test@example.com'] 
), stop. # 1 correspondance (tout)

Sortie écrire: (
	Motif nouveau: ['\\s*[^@]+@[^\.]+\.\\w+'],
	correspondance: ['test@example.com'] 
), stop. # 1 correspondance, espace préfixe facultatif, ignoré