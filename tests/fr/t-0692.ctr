Server init.

Sortie écrire: (
	Motif nouveau: ['^\\w+$'],
	correspondance: ['test@example.com'] 
), stop. # 0 match, fails on @ and .

Sortie écrire: (
	Motif nouveau: ['^[^@]+@[^\.]+\.\\w+$'],
	correspondance: ['test@example.com'] 
), stop. # 1 match

Sortie écrire: (
	Motif nouveau: ['[^@]+@[^\.]+\.\\w+'],
	correspondance: ['test@example.com'] 
), stop. # 1 match

Sortie écrire: (
	Motif nouveau: ['([^@]+)@([^\.]+)\.\\w+'],
	correspondance: ['test@example.com'] 
), stop. # 1 match, groups dont matter

Sortie écrire: (
	Motif nouveau: ['[a-z]'],
	correspondance: ['test@example.com'] 
), stop. # 14 matches

Sortie écrire: (
	Motif nouveau: ['.*'],
	correspondance: ['test@example.com'] 
), stop. # 1 match (all)

Sortie écrire: (
	Motif nouveau: ['(.*)'],
	correspondance: ['test@example.com'] 
), stop. # 1 match (all)

Sortie écrire: (
	Motif nouveau: ['\\s*[^@]+@[^\.]+\.\\w+'],
	correspondance: ['test@example.com'] 
), stop. # 1 match, prefix space optional, gets ignored