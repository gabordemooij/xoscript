Sortie écrire: ['Objet de test'], stop.
>> a := Objet nouveau. 
a quand: ['item:'] faire: { :int64
	propre int64 := int64. 
}.
a quand: ['article'] faire: {
	<- propre int64.
}.
a item: ( Int64 depuis-texte: ['9999'] ).
Sortie écrire: a article, stop.
>> ancienne-adresse-int64 := a article prototype adresse-mémoire.
a save-as: ['/tmp/a.bin'].
Sortie écrire: ['========== RECHARGEMENT DU SNAP :'], stop.
>> b := Objet load-from: ['/tmp/a.bin'].
(b article prototype adresse-mémoire = ancienne-adresse-int64) oui: {
	Sortie écrire: ['Lien d'objet rattaché.'], stop.
}.
Sortie écrire: ( b article ), stop.
