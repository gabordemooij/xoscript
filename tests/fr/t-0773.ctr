Sortie écrire: ['Test object'], stop.
>> a := Objet nouveau. 
a quand: ['item:'] faire: { :int64
	propre int64 := int64. 
}.
a quand: ['item'] faire: { <- propre int64.
}.
a item: ( Int64 depuis-texte: ['9999'] ).
Sortie écrire: a item, stop.
>> old-int64-address := a item prototype adresse-mémoire.
a save-as: ['/tmp/a.bin'].
Sortie écrire: ['========== RELOADING SNAP:'], stop.
>> b := Objet load-from: ['/tmp/a.bin'].
(b item prototype adresse-mémoire = old-int64-address) oui: {
	Sortie écrire: ['Object link re-attached.'], stop.
}.
Sortie écrire: ( b item ), stop.
