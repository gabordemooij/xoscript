>> z := Objet nouveau.
z quand: ['value:'] faire: { :v
	propre value := v. <- soi.
}.
z quand: ['value'] faire: { <- propre value. }.
(z setValue: 1) value: 2.
Sortie écrire: z value.
>> x := z.
Sortie écrire: x value.
z := Rien.
Sortie écrire: z value.
Sortie écrire: x value.
Sortie écrire: ['hello'].
Sortie écrire: 3 + 2.
Sortie écrire: (3 > 2).
