# format du cookie de session, type de contenu json, protocoles web uniquement, svg affiché en ligne
Server initialiser.
Programme utiliser: ['../../../src/xo/fr/webtools.xo'].

>> Fausse-Requête := Objet nouveau.
Fausse-Requête quand: ['value:'] faire: { :valeur
	propre valeur := valeur.
}.
Fausse-Requête quand: ['cookie:'] faire: { :nom
	<- propre valeur.
}.

>> Session-Test := Session-fichier-temporaire nouveau.
Session-Test quand: ['charger'] faire: {
	<- Dictionnaire nouveau.
}.
Session-Test quand: ['id-de-session'] faire: {
	<- propre id.
}.

>> cookies := Liste nouveau
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

cookies chaque: { :i :cookie
	>> demande := Fausse-Requête nouveau.
	demande value: cookie.
	>> gestionnaire := Session-Test nouveau.
	>> web := Document-Web nouveau.
	web demande: demande.
	web gestionnaire-session: gestionnaire.
	web démarrer-session.
	Sortie écrire: ( gestionnaire id-de-session = cookie ), stop.
}.

>> web := Document-Web nouveau.
web json: (Dictionnaire nouveau mettre: ['b'] à: ['a']).
Sortie écrire: ['\n'], stop.

{ Réseau get: ['file:///etc/hostname']. } intercepter: { :e
	Sortie écrire: e, stop.
}, démarrer.

>> svg := Fichier nouveau: ['/tmp/test0814.svg'].
svg écrire: ['<svg xmlns="x"></svg>'].
Sortie stop.
Server transmettre: ['test0814.svg'] préfixe: ['/tmp/'].
svg supprimer.
