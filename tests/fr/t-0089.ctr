>> randomizer := { :a :b
	>> minimum := ( a < b ) soit: a soit: b.
	>> maximum := ( a > b ) soit: a soit: b.
	>> x := Rien.
	{
		x := Nombre entre: a et: b.
		((x < minimum) ou: (x > maximum)) oui: { 
			Sortie écrire: (['Invalid value!']).
			Programme fin.
		}.
	} 
	× 100. <- x.
}.
randomizer appliquer: 0 et: 0.
randomizer appliquer: 1 et: 0.
