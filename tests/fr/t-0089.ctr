>> générateurAléatoire := { :a :b
	>> minimum := ( a < b ) soit: a soit: b.
	>> maximum := ( a > b ) soit: a soit: b.
	>> x := Rien.
	{
		x := Nombre entre: a et: b.
		((x < minimum) ou: (x > maximum)) oui: { 
			Sortie écrire: (['Valeur invalide !']).
			Programme fin.
		}.
	} 
	× 100. <- x.
}.
générateurAléatoire appliquer: 0 et: 0.
