Server init.

>> DB := Maria-DB nouveau hôte: ['localhost'],
	utilisateur: ['xo'],
	mot-de-passe: ['pass123'],
	nom-base: ['xobase'],
	connecter.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB requête: SQL.

# now you don't have to set DB
query2 récupérer: { :row
	Sortie écrire: row world, stop.
}.
