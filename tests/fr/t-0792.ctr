Server init.

>> BD := Maria-DB nouveau hôte: ['localhost'],
	utilisateur: ['xo'],
	mot-de-passe: ['pass123'],
	nom-base: ['xobase'],
	connecter.
	
>> SQL := ['SELECT "hello" AS "world" '].

# une façon plus rapide, obtenir la requête depuis BD :
>> requête2 := BD requête: SQL.

# maintenant, plus besoin de définir BD
requête2 récupérer: { :rangée
	Sortie écrire: rangée world, stop.
}.
