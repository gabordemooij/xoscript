

>> g  := Server nouveau.
>> v  := Coffre nouveau.
>> ok := 0.

>> secrets := Liste nouveau ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> motsDePasse := secrets copier.
motsDePasse chaque: { :i :p
	secrets chaque: { :n :s
		{
			>> chiffré := v chiffrer: s clé: p.
			>> déchiffré := v déchiffrer: chiffré clé: p.
			(déchiffré = s) oui: {
				ok additionner: 1.
			}, sinon: {
				Sortie écrire: ['échec du chiffrement/déchiffrement : '], stop.
				Sortie écrire: s, stop.
				Sortie écrire: ['chiffré : '] + chiffré, stop.
				Sortie écrire: ['déchiffré : '] + chiffré, stop.
				Programme fin.
			}.
		} intercepter: { :err
			(s = [''] ou: p = ['']) oui: {
				ok additionner: 1.
			}, sinon: {
				Sortie écrire: err, stop.
				Programme fin.
			}.
		}, démarrer.
	}.
}.

Sortie écrire: ( ok + [' chiffrements de coffre testés.'] ), stop.