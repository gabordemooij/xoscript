Server init.

>> db := Maria-DB nouveau hôte: ['localhost'],
	utilisateur: ['xo'],
	mot-de-passe: ['pass123'],
	nom-base: ['xobase'],
	connecter.

>> del := db requête: ['DELETE FROM book WHERE id > 0'].
{  del exécuter. db valider. } intercepter: { :e db annuler.  }, démarrer.

>> compter := db requête: ['SELECT COUNT(*) AS num FROM book'].
compter récupérer: { :row Sortie écrire: row num, stop. }.
