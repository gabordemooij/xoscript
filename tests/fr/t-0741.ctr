Sortie écrire: ['Test object'], stop.
>> a := Objet nouveau. 

a quand: ['item:'] faire: { :octhelper
	propre octhelper := octhelper. 
}.

a quand: ['item'] faire: { <- propre octhelper.
}.

a item: Oct nouveau.

>> old-octhelper-address := a item prototype adresse-mémoire.
a save-as: ['/tmp/a.bin'].
Sortie écrire: ['========== RELOADING SNAP:'], stop.

>> b := Objet load-from: ['/tmp/a.bin'].

(b item prototype adresse-mémoire = old-octhelper-address) oui: {
	Sortie écrire: ['Object link re-attached.'], stop.
}.
