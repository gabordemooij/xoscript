Sortie écrire: ['Objet de test'], stop.
>> a := Objet nouveau. 

a quand: ['item:'] faire: { :aideoct
	propre aideoct := aideoct. 
}.

a quand: ['article'] faire: {
	<- propre aideoct.
}.

a item: Oct nouveau.

>> ancienne-adresse-aideoct := a article prototype adresse-mémoire.
a save-as: ['/tmp/a.bin'].
Sortie écrire: ['========== RECHARGEMENT DU SNAP :'], stop.

>> b := Objet load-from: ['/tmp/a.bin'].

(b article prototype adresse-mémoire = ancienne-adresse-aideoct) oui: {
	Sortie écrire: ['Lien d'objet rattaché.'], stop.
}.
