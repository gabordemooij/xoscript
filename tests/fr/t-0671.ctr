# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Coffre générer-clés.

# private (secret) key
>> sk := keys premier.

# public key
>> pk := keys dernier.

# sign a message
>> sig := Coffre signer: ['abc'] avec: sk.

# check message (ok)
Sortie écrire: ( 
	Coffre
		vérifier: ['abc'] 
		signature: sig 
		avec: pk 
), stop.

# check message (fail)
Sortie écrire: ( 
	Coffre 
		vérifier: ['abd'] 
		signature: sig 
		avec: pk 
), stop.