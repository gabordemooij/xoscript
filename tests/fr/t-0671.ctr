# clé publique (pour sécuriser des API, etc.)
Server init.

# générer les clés
>> clés := Coffre générer-clés.

# clé privée (secrète)
>> cs := clés premier.

# clé publique
>> cp := clés dernier.

# signer un message
>> sig := Coffre signer: ['abc'] avec: cs.

# vérifier le message (ok)
Sortie écrire: ( 
	Coffre
		vérifier: ['abc'] 
		signature: sig 
		avec: cp 
), stop.

# vérifier le message (échec)
Sortie écrire: ( 
	Coffre 
		vérifier: ['abd'] 
		signature: sig 
		avec: cp 
), stop.