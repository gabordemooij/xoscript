>> map1 := Dictionnaire nouveau.
>> key1 := Liste nouveau.
>> key2 := Liste nouveau.

map1
	mettre: ['hello'] à: key1,
	mettre: ['world'] à: key2.


Sortie
	écrire: ['Map #1 contains: '] + (map1 à: key1),
	écrire: [' and '] + (map1 à: key2), stop.

>> KeyeableArray := Liste nouveau.
KeyeableArray quand: ['toString'] faire: { <- (soi compter) toString.
}.

>> map2 := Dictionnaire nouveau.
key1 := KeyeableArray nouveau.
key2 := KeyeableArray nouveau.

key1 ajouter: 1.

map2
	mettre: ['hello'] à: key1,
	mettre: ['world'] à: key2.

Sortie
	écrire: ['Map #2 contains: '] + (map2 à: key1),
	écrire: [' and '] + (map2 à: key2), stop.
