>> table1 := Dictionnaire nouveau.
>> clé1 := Liste nouveau.
>> clé2 := Liste nouveau.

table1
	mettre: ['hello'] à: clé1,
	mettre: ['world'] à: clé2.


Sortie
	écrire: ['Map #1 contains: '] + (table1 à: clé1),
	écrire: [' et '] + (table1 à: clé2), stop.

>> TableauÀClés := Liste nouveau.
TableauÀClés quand: ['enTexte'] faire: { <- (soi compter) enTexte.
}.

>> map2 := Dictionnaire nouveau.
clé1 := TableauÀClés nouveau.
clé2 := TableauÀClés nouveau.

clé1 ajouter: 1.

map2
	mettre: ['hello'] à: clé1,
	mettre: ['world'] à: clé2.

Sortie
	écrire: ['Map #2 contains: '] + (map2 à: clé1),
	écrire: [' et '] + (map2 à: clé2), stop.
