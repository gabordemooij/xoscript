	connecter.
#...
>> del := conn1 requête: ['DELETE FROM book WHERE id > 0'].
{  del exécuter. conn1 valider. } intercepter: { :e conn1 annuler.  }, démarrer.

>> insert := conn1 requête: ['INSERT INTO book (id) VALUES(null)'].
insert exécuter.

>> compter := conn1 requête: ['SELECT COUNT(*) AS num FROM book'].
compter récupérer: { :row Sortie écrire: row num, stop. }.

# does not show up
# insert not committed on connection 1
>> compter := conn2 requête: ['SELECT COUNT(*) AS num FROM book'].
compter récupérer: { :row Sortie écrire: row num, stop. }.
