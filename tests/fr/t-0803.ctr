>> suppr := conn1 requête: ['DELETE FROM book WHERE id > 0'].
{  suppr exécuter. conn1 valider. } intercepter: { :e conn1 annuler.  }, démarrer.

>> insertion := conn1 requête: ['INSERT INTO book (id) VALUES(null)'].
insertion exécuter.

>> compter := conn1 requête: ['SELECT COUNT(*) AS num FROM book'].
compter récupérer: { :rangée Sortie écrire: rangée num, stop. }.

# n'apparaît pas
