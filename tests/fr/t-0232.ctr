>> Slurp := Objet nouveau.

Slurp quand: ['nouveau'] faire: {
	propre str := [''].
}.

Slurp quand: ['répondre:'] faire: { :blah
		(propre str = ['']) oui: {
			propre str ajouter: blah.
		}, sinon: {
			propre str ajouter: [' '].
			propre str ajouter: blah.
		}.
}.

Slurp quand: ['répondre:et:'] faire: { :blah :blahah
		(blah longueur > 1) oui: {
			propre str ajouter: (blah de: 0 longueur: (blah longueur - 1)).
		}, sinon: {
			propre str ajouter: blah.
		}.
		propre str ajouter: [' '].
		propre str ajouter: blahah.
}.

Slurp quand: ['obtain'] faire: {
	>> buffer := propre str.
	propre str := ['']. <- buffer.
}.


>> x := Slurp nouveau.
x + 3.
Sortie écrire: (x obtain), stop.
x echo: ['Hello world'].
Sortie écrire: (x obtain), stop.
x tellme: 123 and: 987.
Sortie écrire: (x obtain), stop.
