#Linux

 >> t := Moment nouveau.
 
t zone: ['Europe/Amsterdam'].
t année: 2020, mois: 8, jour: 2, heure: 21, minute: 2, seconde: 1.

>> a := t heure.
>> ams := t zone.

t zone: ['US/Hawaii'].
>> b := t heure.
>> hw := t zone.

Sortie
écrire: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		soit: ['plus tard'] soit: ['plus tôt']
	)
),
stop.
 