Sortie écrire: ['Test object'], stop.
>> greeter := Objet nouveau.
greeter quand: ['name:'] faire: { :nom
	propre xname := nom. 
}.
greeter quand: ['greet'] faire: {
	Sortie écrire: ['Hello '] + propre xname, stop.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Sortie écrire: ['========== RELOADING SNAP:'], stop.
>> b := Objet load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
