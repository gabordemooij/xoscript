>> Salueur := Objet nouveau.
Salueur quand: ['fabriquer'] faire: {
	>> salueur := Objet nouveau.
	salueur quand: ['name:'] faire: { :nom
		Sortie écrire: ['attribution d'un nom'].
		propre monNom := nom.
	}.
	salueur quand: ['saluer'] faire: {
		Sortie écrire: ['Hello'].
		Sortie écrire: propre monNom.
	}. <- salueur.
}.
>> salueur := Salueur fabriquer.
salueur name: ['rayon de soleil !'].
salueur saluer.
