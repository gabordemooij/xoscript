>> Greeter := Objet nouveau.
Greeter quand: ['make'] faire: {
	>> greeter := Objet nouveau.
	greeter quand: ['name:'] faire: { :nom
		Sortie écrire: ['setting a name'].
		propre myName := nom.
	}.
	greeter quand: ['greet'] faire: {
		Sortie écrire: ['Hello'].
		Sortie écrire: propre myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
