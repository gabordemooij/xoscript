# les messages d'erreur de la base de données ne doivent pas être traités comme des textes de format
Server init.

>> bd := Maria-DB nouveau hôte: ['localhost'],
	utilisateur: ['xo'],
	mot-de-passe: ['pass123'],
	nom-base: ['xobase'],
	connecter.

>> paramètres-recherche := bd requête: ['SELECT %% FROM'].
{ paramètres-recherche exécuter. } intercepter: { :e
	Sortie écrire: ( e contient: ['%%'] ), stop.
}, démarrer.
