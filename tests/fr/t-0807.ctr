# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB nouveau hôte: ['localhost'],
	utilisateur: ['xo'],
	mot-de-passe: ['pass123'],
	nom-base: ['xobase'],
	connecter.

>> paramètres-recherche := db requête: ['SELECT %% FROM'].
{ paramètres-recherche exécuter. } intercepter: { :e
	Sortie écrire: ( e contient: ['%%'] ), stop.
}, démarrer.
