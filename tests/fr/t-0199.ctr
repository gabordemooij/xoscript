
Programme gestion-mémoire: 4.

>> Animal := Objet nouveau.
Animal quand: ['fabriquer'] faire: {
	>> animal := Objet nouveau.
	animal quand: ['faireDuBruit'] faire: {
		Sortie écrire: propre son.
	}. <- animal.
}.
>> Chat := Objet nouveau.
Chat quand: ['fabriquer'] faire: {
	>> chat := Animal fabriquer.
	chat quand: ['init'] faire: {
		propre son := ['meow!'].
	}.
	chat init. <- chat.
}.
>> tom := Chat fabriquer.
tom faireDuBruit.
