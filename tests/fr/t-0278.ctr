>> To-Do := Objet nouveau.

To-Do quand: ['nouveau'] faire: {
	propre list := Liste nouveau.
}.

To-Do quand: ['nieuw'] faire: {
	propre list := Liste nouveau.
}.

To-Do quand: ['+'] faire: { :task
	propre list ajouter: task.
}.

To-Do quand: ['number of tasks?'] faire: { <-  propre list compter.
}.

>> todos := 
	To-Do nouveau 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Sortie écrire: ['You have $ tasks to do'] $ todos number of tasks?.
