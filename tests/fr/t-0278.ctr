>> À-Faire := Objet nouveau.

À-Faire quand: ['nouveau'] faire: {
	propre list := Liste nouveau.
}.

À-Faire quand: ['nieuw'] faire: {
	propre list := Liste nouveau.
}.

À-Faire quand: ['+'] faire: { :tâche
	propre list ajouter: tâche.
}.

À-Faire quand: ['number of tasks?'] faire: { <-  propre list compter.
}.

>> tâches := 
	À-Faire nouveau 
	+ ['préparer le dîner'] 
	+ ['ranger la chambre'].
	
Sortie écrire: ['You have $ tasks to do'] $ tâches number of tasks?.
