>> facture := Objet nouveau.
facture quand: ['démarrer'] faire: {
        propre nombre := 0.
}.

facture quand: ['nombre'] faire: {
        propre nombre additionner: 1.
        <- propre nombre copier.
}.

>> facture-annuelle := facture nouveau.
facture-annuelle quand: ['start:'] faire: { :année
	propre nombre := année.
}.

facture-annuelle start: 202000.
Sortie écrire: facture-annuelle nombre, stop.
Sortie écrire: facture-annuelle nombre, stop.
