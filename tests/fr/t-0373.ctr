# test de conformité

# utiliser les nombres internationaux

Sortie écrire: ['1000 -> '].
Sortie écrire: 1000, stop. #1000

Sortie écrire: ['1.5 -> '].
Sortie écrire: 1.5, stop.  #1.5

Sortie écrire: ['1001.5 -> '].
Sortie écrire: 1.5 + 1000, stop. #1001.5

# utiliser des tableaux indexés à partir de 0
>> x := Liste nouveau ; 1 ; 2 ; 3.
>> y := Liste nouveau ; ['a'] ; ['b'] ; ['c'].

Sortie écrire: ['1 -> '].
Sortie écrire: x ? 0, stop. #1

Sortie écrire: ['1 -> '].
Sortie écrire: (x à: 0), stop. #1

Sortie écrire: ['1 -> '].
Sortie écrire: x premier, stop. #1

Sortie écrire: ['3 -> '].
Sortie écrire: x dernier, stop. #3

Sortie écrire: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Sortie écrire: (x par: y), stop.

Sortie écrire: ['1 -> '].
Sortie écrire: (x de: 0 longueur: 1) premier, stop. #1

Sortie écrire: ['0 -> '].
Sortie écrire: (x trouver: 1), stop. #0

x mettre: 9 à: 0.

Sortie écrire: ['9 -> '].
Sortie écrire: (x à: 0), stop. #9

x préfixer: 8.
Sortie écrire: ['8 -> '].
Sortie écrire: (x à: 0), stop. #9


x ajouter: 10.
Sortie écrire: ['10 -> '].
Sortie écrire: (x à: 4), stop. #10








