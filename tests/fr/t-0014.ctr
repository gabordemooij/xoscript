>> Greeter := Objet nouveau.
Greeter quand: ['make'] faire: {
	>> gr := Objet nouveau.
	gr quand: ['setName:'] faire: { :aname
		propre nom := aname.
	}.
	gr quand: ['greet'] faire: {
		Sortie écrire: propre nom.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a nouveau.
c setName: ['THREE'].
c greet.
>> d := a nouveau.
d setName: ['FOUR'].
d greet.
c greet.
