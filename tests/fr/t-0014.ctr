>> Salueur := Objet nouveau.
Salueur quand: ['fabriquer'] faire: {
	>> gr := Objet nouveau.
	gr quand: ['setName:'] faire: { :unNom
		propre nom := unNom.
	}.
	gr quand: ['saluer'] faire: {
		Sortie écrire: propre nom.
	}. <- gr.
}.
>> a := Salueur fabriquer.
>> b := Salueur fabriquer.
a setName: ['UN'].
b setName: ['DEUX'].
a saluer.
b saluer.
>> c := a nouveau.
c setName: ['TROIS'].
c saluer.
>> d := a nouveau.
d setName: ['QUATRE'].
d saluer.
c saluer.
