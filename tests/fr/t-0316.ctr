>> GrandPère := Objet nouveau.
GrandPère quand: ['saluer'] faire: {
	Sortie écrire: ['Ave!'], stop.
}.
>> Père := GrandPère nouveau.
Père quand: ['saluer'] faire: {
	Sortie écrire: ['Hello'], stop.
	soi saluer.
}.
>> Fils := Père nouveau.
Fils quand: ['saluer'] faire: {
	Sortie écrire: ['Salut'], stop.
	soi saluer.
}.

Fils saluer.

>> RondPoint := Objet nouveau.
RondPoint quand: ['circle:'] faire: { :x
	Sortie écrire: x, stop.
	(x < 3) oui: { soi récursif circle: x + 1. }.
}.

RondPoint circle: 1.

>> x := 1.
>> incrémenter := { (x ≤ 3) oui: { Sortie écrire: x, stop. x additionner: 1.  incrémenter démarrer. }. }.
incrémenter démarrer.