>> Grandfather := Objet nouveau.
Grandfather quand: ['greet'] faire: {
	Sortie écrire: ['Ave!'], stop.
}.
>> Father := Grandfather nouveau.
Father quand: ['greet'] faire: {
	Sortie écrire: ['Hello'], stop.
	soi greet.
}.
>> Son := Father nouveau.
Son quand: ['greet'] faire: {
	Sortie écrire: ['Hi'], stop.
	soi greet.
}.

Son greet.

>> Roundabout := Objet nouveau.
Roundabout quand: ['circle:'] faire: { :x
	Sortie écrire: x, stop.
	(x < 3) oui: { soi récursif circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) oui: { Sortie écrire: x, stop. x additionner: 1.  increment démarrer. }. }.
increment démarrer.