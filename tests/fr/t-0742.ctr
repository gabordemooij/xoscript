Sortie écrire: ['Test object'], stop.
>> a := Objet nouveau. 

a quand: ['item:'] faire: { :hexhelper
	propre hexhelper := hexhelper. 
}.

a quand: ['item'] faire: { <- propre hexhelper.
}.

a item: Hx nouveau.

>> old-hexhelper-address := a item prototype adresse-mémoire.
a save-as: ['/tmp/a.bin'].
Sortie écrire: ['========== RELOADING SNAP:'], stop.

>> b := Objet load-from: ['/tmp/a.bin'].

(b item prototype adresse-mémoire = old-hexhelper-address) oui: {
	Sortie écrire: ['Object link re-attached.'], stop.
}.
