Sortie écrire: ['Objet de test'], stop.
>> a := Objet nouveau. 

a quand: ['item:'] faire: { :aidehex
	propre aidehex := aidehex. 
}.

a quand: ['article'] faire: {
	<- propre aidehex.
}.

a item: Hx nouveau.

>> ancienne-adresse-aidehex := a article prototype adresse-mémoire.
a save-as: ['/tmp/a.bin'].
Sortie écrire: ['========== RECHARGEMENT DU SNAP :'], stop.

>> b := Objet load-from: ['/tmp/a.bin'].

(b article prototype adresse-mémoire = ancienne-adresse-aidehex) oui: {
	Sortie écrire: ['Lien d'objet rattaché.'], stop.
}.
