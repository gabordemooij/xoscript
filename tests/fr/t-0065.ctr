Nombre quand: ['factorial'] faire: {
	>> total := 1.
	{ :index total multiplier-par: (soi - (index)). } × soi. <- total.
}.
>> Printer := Objet nouveau.
Printer quand: ['print:and:'] faire: { :x :y
	Sortie écrire: ['a='] + x + [', b='] + y, stop.
}.
>> a := 4.5. >> b := a plancher.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a plafond.
Printer print: a and: b.
a := 4.5. b := a plancher.
Printer print: a and: b.
a := 4.5. b := a arrondi.
Printer print: a and: b.
a := 4.2. b := a arrondi.
Printer print: a and: b.

Sortie écrire: (9 modulo: 5), stop.
Sortie écrire: -666 absolu, stop.
Sortie écrire: 49 racine-carrée, stop.
Sortie écrire: (2 puissance: 3), stop.
>> l := (Liste ← 9 ; 6).
Sortie écrire: l minimum.

