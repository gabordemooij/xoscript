
Liste quand: ['produit'] faire: {
	>> total := 1.
	soi chaque: { :indice :élément
		total multiplier-par: élément.
	}. <- total.
}.

>> a := Liste ← 1 ; 2 ; 3.
Sortie écrire: a produit, stop.
Sortie écrire: (Liste ← 2 ; 4 ; 8) produit, stop. 
Sortie écrire: (Liste ← -2 ; 10) produit, stop. 
Sortie écrire: (Liste ← 0.5 ; -2) produit, stop. 
