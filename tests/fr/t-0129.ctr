
Liste quand: ['product'] faire: {
	>> total := 1.
	soi chaque: { :index :element
		total multiplier-par: element.
	}. <- total.
}.

>> a := Liste ← 1 ; 2 ; 3.
Sortie écrire: a product, stop.
Sortie écrire: (Liste ← 2 ; 4 ; 8) product, stop. 
Sortie écrire: (Liste ← -2 ; 10) product, stop. 
Sortie écrire: (Liste ← 0.5 ; -2) product, stop. 
