>> Slurp := Objet nouveau.
Slurp quand: ['nouveau'] faire: {
	propre str := [''].
}.
Slurp apprendre: ['nieuw'] signifie: ['nouveau'].
Slurp quand: ['répondre:'] faire: { :blah
		(propre str ≠ ['']) oui: {
			propre str ajouter: [' '].
		}.
		propre str ajouter: blah.
}.
Slurp quand: ['répondre:et:'] faire: { :blah :blahah
		(propre str ≠ ['']) oui: {
			propre str ajouter: [' '].
		}.
		(blah longueur > 1) oui: {
			propre str ajouter: (blah de: 0 longueur: (blah longueur - 1)).
		}, sinon: {
			propre str ajouter: blah.
		}.
		propre str ajouter: [' '].
		propre str ajouter: blahah.
}.
Slurp quand: ['obtenir'] faire: {
	>> tampon := propre str.
	propre str := ['']. <- tampon.
}.


>> paramètres-recherche := Slurp nouveau
	select: ['*'],
	from
		utilisateurs 
	where 
		user_id=: 1.

Sortie écrire: paramètres-recherche obtenir, stop.
