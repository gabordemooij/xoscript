
>> lexique := (
	Dictionnaire nouveau
		mettre: ['b'] à: ['a'],
		mettre: ['a'] à: ['b'],
		mettre: ['z'] à: ['x'],
		mettre: ['hello'] à: ['hallo'],
		mettre: ['humain'] à: ['humain']
).

>> comparaisons := Liste nouveau.
lexique chaque: { :a :b
	comparaisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a comparer: b)
	).
}.

comparaisons trier: { :a :b <- ( a comparer: b ). }.
Sortie écrire: ( comparaisons joindre: ['↵'] ), stop.
comparaisons joindre: ['↵'].
