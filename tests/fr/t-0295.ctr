
>> dictionary := (
	Dictionnaire nouveau
		mettre: ['b'] à: ['a'],
		mettre: ['a'] à: ['b'],
		mettre: ['z'] à: ['x'],
		mettre: ['hello'] à: ['hallo'],
		mettre: ['human'] à: ['human']
).

>> comparisons := Liste nouveau.
dictionary chaque: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a comparer: b)
	).
}.

comparisons trier: { :a :b <- ( a comparer: b ). }.
Sortie écrire: ( comparisons joindre: ['↵'] ), stop.
comparisons joindre: ['↵'].
