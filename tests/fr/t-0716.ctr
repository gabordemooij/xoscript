Sortie écrire: ['Objet de test'], stop.
>> a := Objet nouveau. 

a quand: ['state:'] faire: { :list
	propre list := list. 
}.

a quand: ['état'] faire: {
	Sortie écrire: propre list, stop.
}.

a state: ( Liste nouveau ; ['élémentliste'] ; ['article2'] ).
a état.

a save-as: ['/tmp/a.bin'].
Sortie écrire: ['========== RECHARGEMENT DU SNAP :'], stop.
>> b := Objet load-from: ['/tmp/a.bin'].
b état.