Sortie écrire: ['Test object'], stop.
>> a := Objet nouveau. 

a quand: ['state:'] faire: { :list
	propre list := list. 
}.

a quand: ['state'] faire: {
	Sortie écrire: propre list, stop.
}.

a state: ( Liste nouveau ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
Sortie écrire: ['========== RELOADING SNAP:'], stop.
>> b := Objet load-from: ['/tmp/a.bin'].
b state.