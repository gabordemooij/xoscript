# test Program version

# this feature is disabled by default
Sortie écrire: (
	Programme fonctionnalité: 
	['RECURSIVE_STRINTPOL']
), stop.


# but if we set the time back
>> today := Moment 
zone: ['CEST'],
depuis: ['2026-02-15 10:00:00'].
Programme version: today.

# it will be enabled like it used to be (from now on)
Sortie écrire: (
	Programme fonctionnalité: 
	['RECURSIVE_STRINTPOL']
), stop.