Programme gestion-mémoire: 4.

>> Doubleur := Objet nouveau.
>> Multiplicateur := Objet nouveau.
Doubleur quand: ['doubler:et:'] faire: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplicateur quand: ['multiplier:et:'] faire: { :x :y <- (x × y).
}.

Sortie écrire: (
	Doubleur doubler:
		(Doubleur doubler: 
			(Multiplicateur multiplier: 2 et: 3)
		et:
			(Multiplicateur multiplier: 3 et: 4)
		)
	et:
		(Doubleur doubler: 
			(Multiplicateur multiplier: 2 et: 3)
		et:
			(Multiplicateur multiplier: 3 et: 4)
		)
), stop.
