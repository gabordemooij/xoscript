Programme gestion-mémoire: 4.

>> Doubler := Objet nouveau.
>> Multiplier := Objet nouveau.
Doubler quand: ['double:and:'] faire: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier quand: ['multiply:and:'] faire: { :x :y <- (x × y).
}.

Sortie écrire: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), stop.
