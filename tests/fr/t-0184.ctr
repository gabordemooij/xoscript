

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programme gestion-mémoire: 0.

Nombre quand: ['addNum:'] faire: { :x
	soi additionner: x.
}.

Nombre quand: ['subtractNum:'] faire: { :x
	soi soustraire: x.
}.

Nombre quand: ['multiplyBy:'] faire: { :x
	soi multiplier-par: x.
}.

Nombre quand: ['divideBy:'] faire: { :x
	soi diviser-par: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 puissance: 8).  
a := a + (2 puissance: -1). 
a := a + (49 racine-carrée).   
a addNum: ((Liste ← 0 ; 1) maximum).          
a addNum: ((Liste ← 2 ; 3) minimum).
Sortie écrire: a.

Programme nettoyer.

usedMemory1 := (Programme mémoire ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 puissance: 8).  
a := a + (2 puissance: -1). 
a := a + (49 racine-carrée).   
a addNum: ((Liste ← 0 ; 1) maximum).          
a addNum: ((Liste ← 2 ; 3) minimum).
Sortie écrire: a.

Programme nettoyer.
usedMemory2 := (Programme mémoire ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 puissance: 8).  
a := a + (2 puissance: -1). 
a := a + (49 racine-carrée).   
a addNum: ((Liste ← 0 ; 1) maximum).          
a addNum: ((Liste ← 2 ; 3) minimum).
Sortie écrire: a.

Programme nettoyer.
usedMemory3 := (Programme mémoire ? 0).



( usedMemory1 = usedMemory2 et: usedMemory1 = usedMemory3, et: usedMemory2 = usedMemory3 ) oui: {
	Sortie écrire: ['No memory leaks here'].
}, non: {
	Sortie écrire: ['Leaking memory...'].
}.
