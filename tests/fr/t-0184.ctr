

>> mémoireUtilisée1 := 0.
>> mémoireUtilisée2 := 0.
>> mémoireUtilisée3 := 0.
>> mémoireUtilisée4 := 0.

Programme gestion-mémoire: 0.

Nombre quand: ['addNum:'] faire: { :x
	soi additionner: x.
}.

Nombre quand: ['subtractNum:'] faire: { :x
	soi soustraire: x.
}.

Nombre quand: ['multiplyBy:'] faire: { :x
	soi multiplier-par: x.
}.

Nombre quand: ['divideBy:'] faire: { :x
	soi diviser-par: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 puissance: 8).  
a := a + (2 puissance: -1). 
a := a + (49 racine-carrée).   
a addNum: ((Liste ← 0 ; 1) maximum).          
a addNum: ((Liste ← 2 ; 3) minimum).
Sortie écrire: a.

Programme nettoyer.

mémoireUtilisée1 := (Programme mémoire ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
