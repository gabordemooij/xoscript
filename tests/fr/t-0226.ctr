# Test des variantes ASCII

# Nombres

Sortie écrire: (2 !=: 3), stop.
Sortie écrire: (2 <=: 2), stop.
Sortie écrire: (2 >=: 2), stop.

# Textes

Sortie écrire: (['b'] >=: ['a']), stop.
Sortie écrire: (['b'] !=: ['a']), stop.
Sortie écrire: (['b'] <=: ['c']), stop.

# Booléens

Sortie écrire: (Oui !=: Non), stop.

# Objets

Sortie écrire: (Objet nouveau !=: Objet nouveau), stop.

# symbole de liste ASCII <-:

Sortie écrire: (Liste <<: 1, ; 2 ; 3) compter = 3, stop.

