

>> Cat := Objet nouveau.

Cat quand: ['nouveau'] faire: {
	propre sound := ['meow!'].
}.

Cat quand: ['nieuw'] faire: {
	propre sound := ['meow!'].
}.

Cat quand: ['makeSound'] faire: { <- propre sound.
}.

Cat quand: ['greet'] faire: { <- soi makeSound.
}.

>> cat := Cat nouveau.
Sortie écrire: cat greet.
