

>> Chat := Objet nouveau.

Chat quand: ['nouveau'] faire: {
	propre son := ['meow!'].
}.

Chat quand: ['nieuw'] faire: {
	propre son := ['meow!'].
}.

Chat quand: ['faireDuBruit'] faire: { <- propre son.
}.

Chat quand: ['saluer'] faire: { <- soi faireDuBruit.
}.

>> chat := Chat nouveau.
Sortie écrire: chat saluer.
