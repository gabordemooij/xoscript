Sortie écrire: ['Objet de test'], stop.
>> a := Objet nouveau. 
a quand: ['item:'] faire: { :lst
	propre lst := lst. 
}.
a quand: ['article'] faire: {
	<- propre lst.
}.
a item: (
	Liste nouveau ; 1 ; (
		Liste nouveau ; ['a'] ; (
			Liste nouveau ; ( Moment nouveau: 1 )
		) ; ( Int64 depuis-texte: ['321'] )
	)
).
Sortie écrire: a article, stop.
>> ancienne-adresse-lst := a article prototype adresse-mémoire.
a save-as: ['/tmp/a.bin'].
Sortie écrire: ['========== RECHARGEMENT DU SNAP :'], stop.
>> b := Objet load-from: ['/tmp/a.bin'].
(b article prototype adresse-mémoire = ancienne-adresse-lst) oui: {
	Sortie écrire: ['Lien d'objet rattaché.'], stop.
}.
Sortie écrire: ( b article ), stop.
