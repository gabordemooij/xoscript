


>> Paquet := Liste nouveau.
Paquet quand: ['imprimer'] faire: {
        >> len := soi compter - 1.
        { :i
                >> lon2 := soi compter - 1.
                Sortie écrire: ['long : '].
                Sortie écrire: len, stop.
                Sortie écrire: ['long2 : '].
                Sortie écrire: lon2, stop.
        } × len.
}.

>> d := Paquet ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d imprimer.
