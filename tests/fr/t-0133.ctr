


>> Deck := Liste nouveau.
Deck quand: ['print'] faire: {
        >> len := soi compter - 1.
        { :i
                >> len2 := soi compter - 1.
                Sortie écrire: ['len: '].
                Sortie écrire: len, stop.
                Sortie écrire: ['len2: '].
                Sortie écrire: len2, stop.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
