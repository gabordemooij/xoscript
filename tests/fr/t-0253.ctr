#Linux
>> OS := Programme paramètre: ['OS'].

>> horloge := Moment nouveau.
	
(OS = ['Haiku']) oui: {
	horloge zone: ['CET'],
	année: 2017, mois: 7, jour: 13,
	heure: 18, minute: 0, seconde: 0.
}, sinon: {
	horloge zone: ['Europe/Amsterdam'],
	année: 2017, mois: 7, jour: 13,
	heure: 18, minute: 0, seconde: 0.
}.

horloge quand: ['annoncer'] faire: {
	Sortie écrire: soi, stop.
}.


horloge additionner: 2    heure, annoncer.
horloge additionner: 1    heure, annoncer.
horloge additionner: 19 minute, annoncer.
horloge additionner: 1  minute, annoncer.
horloge additionner: 1  minute, annoncer.
horloge additionner: 19 seconde, annoncer.
horloge additionner: 1  seconde, annoncer.
horloge additionner: 1  seconde, annoncer.
horloge additionner: 2    année, annoncer.
horloge additionner: 1    année, annoncer.

(OS = ['Haiku']) oui: {
horloge additionner: 5   mois.
horloge zone: ['CEST'], annoncer.
}, sinon: {
	horloge additionner: 5   mois, annoncer.
}.

horloge additionner: 1   mois, annoncer.
horloge additionner: 19    jour, annoncer.
horloge additionner: 1    heure, annoncer.
horloge additionner: 120  yard, annoncer.
