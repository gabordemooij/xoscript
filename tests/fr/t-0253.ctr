#Linux
>> OS := Programme paramètre: ['OS'].

>> clock := Moment nouveau.
	
(OS = ['Haiku']) oui: {
	clock zone: ['CET'],
	année: 2017, mois: 7, jour: 13,
	heure: 18, minute: 0, seconde: 0.
}, sinon: {
	clock zone: ['Europe/Amsterdam'],
	année: 2017, mois: 7, jour: 13,
	heure: 18, minute: 0, seconde: 0.
}.

clock quand: ['tell'] faire: {
	Sortie écrire: soi, stop.
}.


clock additionner: 2    heure, tell.
clock additionner: 1    heure, tell.
clock additionner: 19 minute, tell.
clock additionner: 1  minute, tell.
clock additionner: 1  minute, tell.
clock additionner: 19 seconde, tell.
clock additionner: 1  seconde, tell.
clock additionner: 1  seconde, tell.
clock additionner: 2    année, tell.
clock additionner: 1    année, tell.

(OS = ['Haiku']) oui: {
clock additionner: 5   mois.
clock zone: ['CEST'], tell.
}, sinon: {
	clock additionner: 5   mois, tell.
}.

clock additionner: 1   mois, tell.
clock additionner: 19    jour, tell.
clock additionner: 1    heure, tell.
clock additionner: 120  yard, tell.
