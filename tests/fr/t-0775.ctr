Sortie écrire: ['Test object'], stop.
>> l := Liste nouveau ; 1 ; ( Liste nouveau ; (Moment nouveau: 1) ; (Int64 depuis-texte: ['321']) ; (Liste nouveau ; 3)).
Sortie écrire: l, stop.
>> old-lst-address := l prototype adresse-mémoire.
l save-as: ['/tmp/a.bin'].
Sortie écrire: ['========== RELOADING SNAP:'], stop.
>> b := Objet load-from: ['/tmp/a.bin'].
(b prototype adresse-mémoire = old-lst-address) oui: {
	Sortie écrire: ['Object link re-attached.'], stop.
}.
Sortie écrire: b, stop.
