Sortie écrire: ['Objet de test'], stop.
>> l := Liste nouveau ; 1 ; ( Liste nouveau ; (Moment nouveau: 1) ; (Int64 depuis-texte: ['321']) ; (Liste nouveau ; 3)).
Sortie écrire: l, stop.
>> ancienne-adresse-lst := l prototype adresse-mémoire.
l save-as: ['/tmp/a.bin'].
Sortie écrire: ['========== RECHARGEMENT DU SNAP :'], stop.
>> b := Objet load-from: ['/tmp/a.bin'].
(b prototype adresse-mémoire = ancienne-adresse-lst) oui: {
	Sortie écrire: ['Lien d'objet rattaché.'], stop.
}.
Sortie écrire: b, stop.
