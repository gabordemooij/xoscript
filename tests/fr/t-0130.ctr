# utilisation de FFI avec le plugin Serveur

# connexion à libc (spécifique à la plateforme)
>> nomlib := Programme paramètre: ['FFITESTLIB'].

# lier les fonctions stdio de C pour des opérations avancées sur les fichiers
Server lier: ( Liste nouveau ;
 nomlib ; ['fopen'] ;
 ( Liste nouveau ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
lier: ( Liste nouveau ;
 Rien ; # signifie même bibliothèque
 ['fread'] ;
 ( Liste nouveau ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Rien ; # signifie même objet (c.-à-d. Stream)
 ['fread']
),
lier: (
 Liste nouveau ;
 Rien ; # signifie même bibliothèque
 ['fwrite'] ;
 ( Liste nouveau ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Rien ; # signifie même bibliothèque
 ['fwrite']
),
lier: (
 Liste nouveau ;
 Rien ; # signifie même bibliothèque
 ['rewind'] ;
 ( Liste nouveau ; ['pointer'] ) ;
 ['int'] ;
 Rien ; # signifie même bibliothèque
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> chemin := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# ouvrir un fichier avec fopen(path, mode)
>> fd := Stream path: chemin mode: mode.

# écrire les octets du tampon str dans le fichier
>> octets-écrits := Stream message: ['fwrite'] arguments: (Liste nouveau ; str ; 1 ; 6 ; fd ).
Sortie écrire: octets-écrits, stop.

# rembobiner le pointeur de fichier
Stream rewind: fd.

# allouer un tampon
>> buf := Blob nouveau: 20.

# lire depuis le fichier
>> octets-lus := Stream message: ['fread'] arguments: (Liste nouveau ; buf ; 1 ; 6 ; fd ).
Sortie écrire: octets-lus, stop.
Sortie écrire: buf, stop.

# libérer la mémoire
str  libérer.
chemin libérer.
mode libérer.
buf  libérer.


