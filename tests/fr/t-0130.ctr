# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Programme paramètre: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server lier: ( Liste nouveau ;
 libname ; ['fopen'] ;
 ( Liste nouveau ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
lier: ( Liste nouveau ;
 Rien ; # means same lib
 ['fread'] ;
 ( Liste nouveau ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Rien ; # means same object (i.e. Stream)
 ['fread']
),
lier: (
 Liste nouveau ;
 Rien ; # means same lib
 ['fwrite'] ;
 ( Liste nouveau ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Rien ; # means same lib
 ['fwrite']
),
lier: (
 Liste nouveau ;
 Rien ; # means same lib
 ['rewind'] ;
 ( Liste nouveau ; ['pointer'] ) ;
 ['int'] ;
 Rien ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> chemin := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: chemin mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream message: ['fwrite'] arguments: (Liste nouveau ; str ; 1 ; 6 ; fd ).
Sortie écrire: bytes-written, stop.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob nouveau: 20.

# read from file
>> bytes-read := Stream message: ['fread'] arguments: (Liste nouveau ; buf ; 1 ; 6 ; fd ).
Sortie écrire: bytes-read, stop.
Sortie écrire: buf, stop.

# free memory
str  libérer.
chemin libérer.
mode libérer.
buf  libérer.


