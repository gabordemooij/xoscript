>> t := Rien.

# you can control the time zone for
# parsing like this:
Moment zone: ['CET'].
t := Moment depuis: ['1981-02-03 04:05:06'].
Sortie écrire: t, stop.

# now using CEST time zone:
Moment zone: ['CEST'].
t := Moment depuis: ['1981-02-03 04:05:06'].
Sortie écrire: t, stop.

# error if string cannot be parsed
{ Moment depuis: ['1900']. } intercepter: { Rien. }, démarrer.
