>> t := Rien.

# vous pouvez contrôler le fuseau horaire pour
# l'analyse comme ceci :
Moment zone: ['CET'].
t := Moment depuis: ['1981-02-03 04:05:06'].
Sortie écrire: t, stop.

# maintenant avec le fuseau horaire CEST :
Moment zone: ['CEST'].
t := Moment depuis: ['1981-02-03 04:05:06'].
Sortie écrire: t, stop.

# erreur si le texte ne peut pas être analysé
{ Moment depuis: ['1900']. } intercepter: { Rien. }, démarrer.
