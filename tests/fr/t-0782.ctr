Sortie écrire: ['Test object'], stop.
>> cmd := Commande nouveau.
Sortie écrire: cmd ls /tmp, stop.
>> old-cmd-address := cmd prototype adresse-mémoire.
cmd save-as: ['/tmp/a.bin'].
Sortie écrire: ['========== RELOADING SNAP:'], stop.
>> b := Objet load-from: ['/tmp/a.bin'].
(b prototype adresse-mémoire = old-cmd-address) oui: {
	Sortie écrire: ['Object link re-attached.'], stop.
}.
Sortie écrire: b ls, stop.


