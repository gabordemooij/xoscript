Sortie écrire: ['Objet de test'], stop.
>> cmd := Commande nouveau.
Sortie écrire: cmd ls /tmp, stop.
>> ancienne-adresse-cmd := cmd prototype adresse-mémoire.
cmd save-as: ['/tmp/a.bin'].
Sortie écrire: ['========== RECHARGEMENT DU SNAP :'], stop.
>> b := Objet load-from: ['/tmp/a.bin'].
(b prototype adresse-mémoire = ancienne-adresse-cmd) oui: {
	Sortie écrire: ['Lien d'objet rattaché.'], stop.
}.
Sortie écrire: b ls, stop.


