Sortie écrire: ['Objet de test'], stop.
>> a := Objet nouveau. 

a quand: ['item:'] faire: { :flux
	propre flux := flux. 
}.

a quand: ['article'] faire: {
	<- propre flux.
}.

a quand: ['saluer'] faire: {
	Sortie écrire: ['salut depuis la sortie d'origine !'], stop.
}.

a item: Sortie.

Sortie écrire: a article, stop.

>> ancienne-adresse-flux := a article prototype adresse-mémoire.
a save-as: ['/tmp/a.bin'].
Sortie écrire: ['========== RECHARGEMENT DU SNAP :'], stop.

>> b := Objet load-from: ['/tmp/a.bin'].

(b article prototype adresse-mémoire = ancienne-adresse-flux) oui: {
	Sortie écrire: ['Lien d'objet rattaché.'], stop.
}.

b article écrire: ['bonjour depuis la sortie chargée !'], stop.
b saluer.
