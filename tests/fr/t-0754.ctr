Sortie écrire: ['Test object'], stop.
>> a := Objet nouveau. 

a quand: ['item:'] faire: { :out
	propre out := out. 
}.

a quand: ['item'] faire: { <- propre out.
}.

a quand: ['greet'] faire: {
	Sortie écrire: ['hi from original out!'], stop.
}.

a item: Sortie.

Sortie écrire: a item, stop.

>> old-out-address := a item prototype adresse-mémoire.
a save-as: ['/tmp/a.bin'].
Sortie écrire: ['========== RELOADING SNAP:'], stop.

>> b := Objet load-from: ['/tmp/a.bin'].

(b item prototype adresse-mémoire = old-out-address) oui: {
	Sortie écrire: ['Object link re-attached.'], stop.
}.

b item écrire: ['hello from loaded out!'], stop.
b greet.
