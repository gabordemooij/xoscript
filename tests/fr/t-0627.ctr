

# create a 64-bit integer for exact calculations
>> a := Int64 depuis-texte: ['123'].

# to string
Sortie écrire: a, stop.

# divide
Sortie écrire: a / (Int64 depuis-texte: ['3']), stop.

# multiply
Sortie écrire: a * (Int64 depuis-texte: ['2']), stop.

# add
Sortie écrire: a + (Int64 depuis-texte: ['1']), stop.

# subtract
Sortie écrire: a - (Int64 depuis-texte: ['2']), stop.

# compare
Sortie écrire: ( a =   (Int64 depuis-texte: ['123'])), stop.
Sortie écrire: ( a !=: (Int64 depuis-texte: ['124'])), stop.
Sortie écrire: ( a <   (Int64 depuis-texte: ['124'])), stop.
Sortie écrire: ( a >   (Int64 depuis-texte: ['122'])), stop.
Sortie écrire: ( a >=: (Int64 depuis-texte: ['123'])), stop.
Sortie écrire: ( a <=: (Int64 depuis-texte: ['123'])), stop.





	