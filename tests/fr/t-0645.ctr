Server init.
Sortie écrire: ['Test de date de base de données'], stop.

>> bd := Maria-DB nouveau hôte: ['localhost'],
	utilisateur: ['xo'], 
	mot-de-passe: ['pass123'],
	nom-base: ['xobase'],
	connecter.

>> paramètres-recherche :=
bd requête: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
récupérer: { :rangée
	Sortie écrire: rangée datetest, stop.
}.
