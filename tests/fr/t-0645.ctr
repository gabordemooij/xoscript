Server init.
Sortie écrire: ['Database date test'], stop.

>> db := Maria-DB nouveau hôte: ['localhost'],
	utilisateur: ['xo'], 
	mot-de-passe: ['pass123'],
	nom-base: ['xobase'],
	connecter.

>> paramètres-recherche :=
db requête: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
récupérer: { :row
