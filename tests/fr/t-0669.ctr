# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Coffre 
	hachage-mot-de-passe: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Coffre 
	hachage-mot-de-passe: hash vérifier: a1.
	# fail 
>> b := Coffre
	hachage-mot-de-passe: hash vérifier: a2.
	# ok!

Sortie écrire: a, stop.
Sortie écrire: b, stop.

