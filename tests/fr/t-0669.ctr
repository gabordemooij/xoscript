# Hachage de mot de passe
Server init.

# L'utilisateur définit un mot de passe
>> mdp := ['pass123'].

# Vous le stockez ainsi
>> empreinte := Coffre 
	hachage-mot-de-passe: mdp.

# Ensuite, l'utilisateur se connecte
# Tentative 1
>> a1 := ['abcd123'].
# Tentative 2
>> a2 := ['pass123'].

# Vérifier
>> a := Coffre 
	hachage-mot-de-passe: empreinte vérifier: a1.
	# échec 
>> b := Coffre
	hachage-mot-de-passe: empreinte vérifier: a2.
	# ok !

Sortie écrire: a, stop.
Sortie écrire: b, stop.

