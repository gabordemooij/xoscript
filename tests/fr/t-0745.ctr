Sortie écrire: ['Objet de test'], stop.
>> a := Objet nouveau. 

a quand: ['item:'] faire: { :dico
	propre dico := dico. 
}.

a quand: ['article'] faire: {
	<- propre dico.
}.

a item: (
Dictionnaire nouveau
	hello: ['world']).

>> ancienne-adresse-dico := a article prototype adresse-mémoire.
a save-as: ['/tmp/a.bin'].
Sortie écrire: ['========== RECHARGEMENT DU SNAP :'], stop.

>> b := Objet load-from: ['/tmp/a.bin'].

(b article prototype adresse-mémoire = ancienne-adresse-dico) oui: {
	Sortie écrire: ['Lien d'objet rattaché.'], stop.
}.

Sortie écrire: b article, stop.
