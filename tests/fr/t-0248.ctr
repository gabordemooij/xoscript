

Texte quand: ['evaluate'] faire: {
	>> code := Fichier nouveau: ['/tmp/eval.ctr'].
	code écrire: soi texte + ['.'].
	Programme utiliser: ['/tmp/eval.ctr'].
}.

>> a := (Liste ← (
	(Dictionnaire nouveau)
		mettre: ['domain'] à: ['mywebsite.com'],
		mettre: (Liste ←
			((Dictionnaire nouveau)
				mettre: ['home'] à: ['title'],
				mettre: ['<html></html>'] à: ['body'],
				mettre: ['2017-01-01'] à: ['created']
			) ;
			((Dictionnaire nouveau)
				mettre: ['aboutus(c)'] à: ['title'],
				mettre: ['<credits>Author Inc.</credits>'] à: ['body']
			)
		) à: ['pages']
	)
) texte.

Sortie écrire: a type, stop.
Sortie écrire: a, stop.

>> b := Rien.
(['b := '] + a) evaluate.
Sortie écrire: b ? 0 ? ['pages'] ? 1 ? ['body'], stop.

>> c := b ? 0.
>> d := c texte.
Sortie écrire: d type, stop.

>> e := Rien.
(['e := '] + d) evaluate.
Sortie écrire: e ? ['pages'] ? 0, stop.
