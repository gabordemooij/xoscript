>> répéteur := Objet nouveau.
répéteur quand: ['répondre:'] faire: { :quoi
	Sortie écrire: quoi + [' '].
}.
répéteur quand: ['répondre:et:'] faire: { :quoi :say
	Sortie écrire: quoi, écrire: say + [' '].
}.
répéteur quand: ['répondre:et:et:'] faire: { :quoi :say :plus
	Sortie écrire: quoi, écrire: say, écrire: plus.
}.
répéteur répéter.
répéteur everything: ['Je dis.'].
répéteur and: ['I '] everything: ['do.'].
