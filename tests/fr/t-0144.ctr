



>> MarcDeCafé := Objet nouveau.
MarcDeCafé quand: ['extraire'] faire: { <- ['coffee']. }.

>> MachineÀCafé := Objet nouveau.
MachineÀCafé quand: ['init'] faire: {
	propre marcdecafé := MarcDeCafé nouveau.
}.
MachineÀCafé quand: ['nouveau'] faire: { <- MachineÀCafé `new init.
}.

MachineÀCafé quand: ['préparerThé'] faire: { <- (propre feuillesdethé extraire). }.
MachineÀCafé quand: ['préparerCafé'] faire: { <- (propre marcdecafé extraire). }.

>> rêveDeCafé := MachineÀCafé nouveau.

Sortie écrire:
	rêveDeCafé 
	préparerCafé.

Sortie écrire:
	rêveDeCafé 
	préparerThé.
