



>> CoffeeGrounds := Objet nouveau.
CoffeeGrounds quand: ['extract'] faire: { <- ['coffee']. }.

>> CoffeeMachine := Objet nouveau.
CoffeeMachine quand: ['init'] faire: {
	propre coffeegrounds := CoffeeGrounds nouveau.
}.
CoffeeMachine quand: ['nouveau'] faire: { <- CoffeeMachine `new init.
}.

CoffeeMachine quand: ['makeTea'] faire: { <- (propre tealeaves extract). }.
CoffeeMachine quand: ['makeCoffee'] faire: { <- (propre coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine nouveau.

Sortie écrire:
	coffeeDream 
	makeCoffee.

Sortie écrire:
	coffeeDream 
	makeTea.
