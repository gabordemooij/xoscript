>> Animal := Objet nouveau.
Animal quand: ['make'] faire: {
	>> animal := Objet nouveau.
	animal quand: ['makeSound'] faire: {
		Sortie écrire: propre sound.
	}. <- animal.
}.
>> Cat := Objet nouveau.
Cat quand: ['make'] faire: {
	>> cat := Animal make.
	cat quand: ['init'] faire: {
		propre sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
