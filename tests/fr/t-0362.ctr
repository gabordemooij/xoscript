Sortie écrire: (['a:b:'] - [':']), stop.
Sortie écrire: (['Lorem Ipsum'] - ['Ipsum']), stop.
Sortie écrire: (['a.................b.......................c...........'] - ['.']), stop.
Sortie écrire: (['a--b--c---d'] - ['--']), stop.
Sortie écrire: (['-'] - ['--']), stop.
Sortie écrire: ([''] - ['--']), stop.
Sortie écrire: (['--'] - ['']), stop.
Sortie écrire: ([''] - ['']), stop.
>> x := ['xx'].
>> y := x - ['x'].
Sortie écrire: x, stop.
Sortie écrire: y, stop.
>> x := ['a,bb,c'].
>> y := x remplacer: [''] par: ['xx'].
Sortie écrire: ((x est-égal-à: y) soit: ['OK'] soit: ['BOGUE ! A renvoyé une copie par accident !']), stop.