Sortie écrire: ['Objet de test'], stop.
>> a := Objet nouveau. 

a quand: ['item:'] faire: { :booléen
	propre booléen := booléen. 
}.

a quand: ['article'] faire: {
	<- propre booléen.
}.

a item: Booléen.

Sortie écrire: a article, stop.

>> ancienne-adresse-bool := a article prototype adresse-mémoire.
a save-as: ['/tmp/a.bin'].
Sortie écrire: ['========== RECHARGEMENT DU SNAP :'], stop.

>> b := Objet load-from: ['/tmp/a.bin'].

(b article prototype adresse-mémoire = ancienne-adresse-bool) oui: {
	Sortie écrire: ['Lien d'objet rattaché.'], stop.
}.

Sortie écrire: b article, stop.
