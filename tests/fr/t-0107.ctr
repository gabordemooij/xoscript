
Sortie écrire: ['Break for-loop, 0-4.'], stop.
{ :i
	Sortie écrire: ['iteration #'] + i, stop.
	(i = 4) interrompre.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Sortie écrire: ['Break while-true loop, 0-4.'], stop.
{
	Sortie écrire: ['iteration #'] + x, stop.
	x additionner: 1.
	((x < 5) non) interrompre.
} tant-que: xIsLessThan10.

Sortie écrire: ['Break while-false loop, 5,4.'], stop.
{
	Sortie écrire: ['iteration #'] + x, stop.
	x soustraire: 1.
	(x = 3) interrompre.
} tant-que: { <- (x > 0). }.

Sortie écrire: ['Break times loop, 1-4.'], stop.
{ :i
	Sortie écrire: ['iteration #'] + i, stop.
	(i = 4) interrompre.
} × 5.

Sortie écrire: ['Break block, dont print line.'], stop.
{ Oui interrompre. Sortie écrire: ['dont write this!'], stop. } démarrer.

Sortie écrire: ['Break block, dont fire catch...'], stop.
{ Oui interrompre. Sortie écrire: ['dont write this!'], stop. } intercepter: { Sortie écrire: ['Dont catch this!']. }, démarrer.

Sortie écrire: ['Test Array each-loop: 0,1'], stop.
(Liste ← 1 ; 2 ; 3) transformer: { :i
	Sortie écrire: ['iteration #'] + i, stop.
	(i = 1) interrompre.
}.

Sortie écrire: ['Test Map each-loop: c only'], stop.
>> m := Dictionnaire nouveau.
m mettre: ['first'] à: ['a'], mettre: ['second'] à: ['b'], mettre: ['third'] à: ['c'].
m chaque: { :k :v
	Sortie écrire: ['iteration'] + v + k, stop.
	Oui interrompre.
}.

