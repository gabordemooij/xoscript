
Sortie écrire: ['Interrompre la boucle for, 0-4.'], stop.
{ :i
	Sortie écrire: ['iteration #'] + i, stop.
	(i = 4) interrompre.
} × 10.

>> x := 0.
>> xEstInférieurÀ10 := { <- ( x < 10 ). }.

Sortie écrire: ['Interrompre la boucle while-true, 0-4.'], stop.
{
	Sortie écrire: ['iteration #'] + x, stop.
	x additionner: 1.
	((x < 5) non) interrompre.
} tant-que: xEstInférieurÀ10.

Sortie écrire: ['Interrompre la boucle while-false, 5,4.'], stop.
{
	Sortie écrire: ['iteration #'] + x, stop.
	x soustraire: 1.
	(x = 3) interrompre.
} tant-que: { <- (x > 0). }.

Sortie écrire: ['Interrompre la boucle times, 1-4.'], stop.
{ :i
	Sortie écrire: ['iteration #'] + i, stop.
	(i = 4) interrompre.
} × 5.

Sortie écrire: ['Interrompre le bloc, ne pas afficher la ligne.'], stop.
{ Oui interrompre. Sortie écrire: ['ne pas écrire ceci !'], stop. } démarrer.

Sortie écrire: ['Interrompre le bloc, ne pas déclencher le catch...'], stop.
{ Oui interrompre. Sortie écrire: ['ne pas écrire ceci !'], stop. } intercepter: { Sortie écrire: ['Ne pas intercepter ceci !']. }, démarrer.

Sortie écrire: ['Test de la boucle chaque sur Liste : 0,1'], stop.
(Liste ← 1 ; 2 ; 3) transformer: { :i
	Sortie écrire: ['iteration #'] + i, stop.
	(i = 1) interrompre.
}.

Sortie écrire: ['Test de la boucle chaque sur Dictionnaire : c seulement'], stop.
>> m := Dictionnaire nouveau.
m mettre: ['first'] à: ['a'], mettre: ['second'] à: ['b'], mettre: ['troisième'] à: ['c'].
m chaque: { :k :v
	Sortie écrire: ['iteration'] + v + k, stop.
	Oui interrompre.
}.

