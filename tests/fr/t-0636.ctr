# test de l'analyse d'URL

Server init.
>> url := URL depuis: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Sortie écrire: ['schéma = '] + url schéma, stop.
Sortie écrire: ['hôte = '] + url hôte, stop.
Sortie écrire: ['port = '] + url port, stop.
Sortie écrire: ['chemin = '] + url chemin, stop.
Sortie écrire: ['requête = '] + url paramètres-recherche, stop.
Sortie écrire: ['fragment = '] + url fragment, stop.
