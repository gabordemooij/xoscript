>> HTML := Objet nouveau.
HTML quand: ['répondre:'] faire: { :balise 
	Sortie écrire: (['<tag>'] tag: balise), stop.
}.
HTML quand: ['répondre:et:'] faire: { :balise :html 
	Sortie écrire: (
		['<tag>innerHTML</tag>']
		tag: balise - [':'],
		innerHTML: html
	), stop.
}.
>> html := HTML nouveau.
html body h1: ['header'].

