>> HTML := Objet nouveau.
HTML quand: ['répondre:'] faire: { :tag 
	Sortie écrire: (['<tag>'] tag: tag), stop.
}.
HTML quand: ['répondre:et:'] faire: { :tag :html 
	Sortie écrire: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), stop.
}.
>> html := HTML nouveau.
html body h1: ['header'].

