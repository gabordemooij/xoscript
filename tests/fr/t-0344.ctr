# test attrape-tout (pratique)
>> HTML := Texte nouveau.
HTML quand: ['encode:'] faire: { :tekst
	soi ajouter: (tekst
	remplacer: ['&'] par: ['&amp;'], 
	remplacer: ['<'] par: ['&lt;'],
	remplacer: ['>'] par: ['&gt;'],
	remplacer: ['"'] par: ['&quot;']).
}.
>> blog := HTML nouveau.
blog ajouter: ['<h1>'],
     encode: ['Koffie & Thee'],
     ajouter: ['</h1>'].
Sortie écrire: blog, stop.


>> Romain := Nombre nouveau.
Romain quand: ['textuel'] faire: {
	>> a := [''].
	{ a ajouter: ['I']. } × soi. <- a.
}.

>> x := Romain nouveau.
x additionner: 3.
Sortie écrire: x textuel, stop.

>> Quantique := Booléen nouveau.
Quantique quand: ['true?'] faire: { <- ['peut-être Oui']. }.
Sortie écrire: (Quantique nouveau true?), stop.

>> Nihil := Rien nouveau.
Nihil quand: ['texte'] faire: { <- ['Nihil']. }.
Sortie écrire: (Nihil nouveau), stop.
