# catch-all test (practical)
>> HTML := Texte nouveau.
HTML quand: ['encode:'] faire: { :tekst
	soi ajouter: (tekst
	remplacer: ['&'] par: ['&amp;'], 
	remplacer: ['<'] par: ['&lt;'],
	remplacer: ['>'] par: ['&gt;'],
	remplacer: ['"'] par: ['&quot;']).
}.
>> blog := HTML nouveau.
blog ajouter: ['<h1>'],
     encode: ['Koffie & Thee'],
     ajouter: ['</h1>'].
Sortie écrire: blog, stop.


>> Roman := Nombre nouveau.
Roman quand: ['stringy'] faire: {
	>> a := [''].
	{ a ajouter: ['I']. } × soi. <- a.
}.

>> x := Roman nouveau.
x additionner: 3.
Sortie écrire: x stringy, stop.

>> Quantum := Booléen nouveau.
Quantum quand: ['true?'] faire: { <- ['maybe True']. }.
Sortie écrire: (Quantum nouveau true?), stop.

>> Nihil := Rien nouveau.
Nihil quand: ['texte'] faire: { <- ['Nihil']. }.
Sortie écrire: (Nihil nouveau), stop.
