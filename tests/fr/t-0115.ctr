{
	cette-tâche erreur: ['N'échoue pas.'].
	inconnu faireQuelqueChose.
} intercepter: {
	Sortie écrire: ['Intercepté !'].
}, démarrer.

{
	cette-tâche erreur: ['N'échoue pas.'].
	propre inconnu faireQuelqueChose.
} intercepter: {
	Sortie écrire: ['Intercepté !'].
}, démarrer.

{
	cette-tâche erreur: ['N'échoue pas.'].
	inconnu := 122.
} intercepter: {
	Sortie écrire: ['Intercepté !'].
}, démarrer.


{
	cette-tâche erreur: ['N'échoue pas.'].
	Oui interrompre.
	Sortie écrire: ['ÉCHEC'].
} intercepter: {
	Sortie écrire: ['Intercepté !'].
}, démarrer.

{
	{
		cette-tâche erreur: ['N'échoue pas.'].
		Oui interrompre.
		Sortie écrire: ['ÉCHEC'].
	} intercepter: { :x
		(x = ['N'échoue pas.']) oui: { cette-tâche erreur: ['Intercepté imbriqué !']. }.
	}, démarrer.
} intercepter: { :e
	Sortie écrire: e.
}, démarrer.
