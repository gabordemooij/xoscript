{
	cette-tâche erreur: ['Dont fail.'].
	unknown doSomething.
} intercepter: {
	Sortie écrire: ['Caught!'].
}, démarrer.

{
	cette-tâche erreur: ['Dont fail.'].
	propre unknown doSomething.
} intercepter: {
	Sortie écrire: ['Caught!'].
}, démarrer.

{
	cette-tâche erreur: ['Dont fail.'].
	unknown := 122.
} intercepter: {
	Sortie écrire: ['Caught!'].
}, démarrer.


{
	cette-tâche erreur: ['Dont fail.'].
	Oui interrompre.
	Sortie écrire: ['FAIL'].
} intercepter: {
	Sortie écrire: ['Caught!'].
}, démarrer.

{
	{
		cette-tâche erreur: ['Dont fail.'].
		Oui interrompre.
		Sortie écrire: ['FAIL'].
	} intercepter: { :x
		(x = ['Dont fail.']) oui: { cette-tâche erreur: ['Nested Caught!']. }.
	}, démarrer.
} intercepter: { :e
	Sortie écrire: e.
}, démarrer.
