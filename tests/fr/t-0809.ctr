# les barres obliques inverses doivent survivre à la sérialisation du code, les textes ne doivent pas se terminer trop tôt
>> valeurs := Liste nouveau
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

valeurs chaque: { :i :value
	>> d := Dictionnaire nouveau.
	d mettre: value à: ['k'].
	>> r := d code objet.
	Sortie écrire: r compter, stop.
	Sortie écrire: ( (r à: ['k']) = value ), stop.
}.
