Server init.

>> BD := Maria-DB nouveau hôte: ['localhost'],
	utilisateur: ['xo'],
	mot-de-passe: ['pass123'],
	nom-base: ['xobase'],
	connecter.

{
	BD requête:
	['DROP TABLE movies'],
	exécuter.
} intercepter: { Rien. }, démarrer.

BD requête:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
exécuter.

BD requête: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
paramètres: ( Liste nouveau ; ['Halloween'] ),
exécuter.

BD requête: ['SELECT * FROM movies'],
récupérer: { :film
	Sortie écrire: film title, stop.
}.

