# un format doit correspondre au type de la valeur, le type peut venir d'un client
>> essayer := { :spéc :value
	{ Sortie écrire: ( (Format nouveau: spéc) appliquer: value ), stop. } intercepter: { :e Sortie écrire: e, stop. }, démarrer.
}.
>> essayer-entier := { :spéc :value
	{ Sortie écrire: ( (Format nouveau: spéc) appliquer-entier: value ), stop. } intercepter: { :e Sortie écrire: e, stop. }, démarrer.
}.

# convient
essayer appliquer: ['|%s|'] et: ['text'].
essayer appliquer: ['%06.2f'] et: 5.5.
essayer appliquer: ['100%% %s'] et: ['bien sûr'].
essayer-entier appliquer: ['%03d'] et: 7.
essayer-entier appliquer: ['%x'] et: 255.
essayer appliquer: ['%d'] et: (Int64 nouveau depuis-texte: ['12']).
essayer appliquer: ['%lld'] et: (Int64 nouveau depuis-texte: ['12']).
essayer appliquer: ['%.1lf'] et: 5.5.
essayer-entier appliquer: ['%hd'] et: 7.

# ne convient pas
essayer appliquer: ['%s'] et: 12345.
essayer appliquer: ['%d'] et: 12345.
essayer appliquer: ['%f'] et: ['text'].
essayer-entier appliquer: ['%d'] et: ['text'].
essayer-entier appliquer: ['%s'] et: 5.
essayer appliquer: ['%s %s'] et: ['text'].
essayer appliquer: ['%n'] et: ['text'].
essayer appliquer: ['%*s'] et: ['text'].
essayer appliquer: ['%'] et: ['text'].

# le modificateur de longueur ne convient pas
essayer appliquer: ['%ls'] et: ['text'].
essayer appliquer: ['%Lf'] et: 5.5.
essayer-entier appliquer: ['%ld'] et: 7.
essayer-entier appliquer: ['%lld'] et: 7.
essayer appliquer: ['%Ld'] et: (Int64 nouveau depuis-texte: ['12']).

# une largeur qui ne convient pas à printf doit donner une erreur, pas un plantage
essayer appliquer: ['%99999999999s'] et: ['text'].
