Sortie écrire: ['Continuer la boucle for, Non - avant 6 et plus.'], stop.
{ :i
	Sortie écrire: (i + 1), stop.
	((i + 1) > 4) continuer.
	Sortie écrire: ['-'].
} × 10.

>> x := 0.
>> xEstInférieurÀ10 := { <- ( x < 10 ). }.
Sortie stop.
Sortie écrire: ['Continuer while-true, Non --> avant 5 et plus.'], stop.
{
	Sortie écrire: ['iteration #'] + x, stop.
	x additionner: 1.
	((x < 5) non) continuer.
	Sortie écrire: ['-->'].
} tant-que: xEstInférieurÀ10.
Sortie stop.
Sortie écrire: ['Continuer while-false, Non - avant 3 seulement.'], stop.
{
	Sortie écrire: ['iteration #'] + x, stop.
	x soustraire: 1.
	(x = 3) continuer.
	Sortie écrire: ['-'].
} tant-que: { <- ( x > 0). }.

Sortie stop.
Sortie écrire: ['Continuer la boucle times, Non ||| avant 3.'], stop.
{ :i
	Sortie écrire: ['iteration #'] + i, stop.
	(i = 2) continuer.
	Sortie écrire: ['|||'].
} × 5.

Sortie stop.

{ Oui continuer. Sortie écrire: ['ne pas écrire ceci !'], stop. } démarrer.

{ Oui continuer. Sortie écrire: ['ne pas écrire ceci !'], stop. } intercepter: { Sortie écrire: ['Ne pas intercepter ceci !']. }, démarrer.

Sortie écrire: ['Test de la boucle chaque sur Liste : 0, ... ,2'], stop.
(Liste ← 1 ; 2 ; 3) transformer: { :i
	(i = 1) continuer.
	Sortie écrire: ['iteration #'] + (i - 0), stop.
}.

Sortie écrire: ['Test de la boucle chaque sur Dictionnaire : c seulement'], stop.
>> m := Dictionnaire nouveau.
m mettre: ['first'] à: ['a'], mettre: ['second'] à: ['b'], mettre: ['troisième'] à: ['c'].
m chaque: { :k :v
	(k ≠ ['c']) continuer.
	Sortie écrire: ['iteration'] + k + v, stop.
}.

