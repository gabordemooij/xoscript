Sortie écrire: ['Continue for-loop, No - before 6 and up.'], stop.
{ :i
	Sortie écrire: (i + 1), stop.
	((i + 1) > 4) continuer.
	Sortie écrire: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Sortie stop.
Sortie écrire: ['Continue while-true, No --> before 5 and up.'], stop.
{
	Sortie écrire: ['iteration #'] + x, stop.
	x additionner: 1.
	((x < 5) non) continuer.
	Sortie écrire: ['-->'].
} tant-que: xIsLessThan10.
Sortie stop.
Sortie écrire: ['Continue while-false, No - before 3 only.'], stop.
{
	Sortie écrire: ['iteration #'] + x, stop.
	x soustraire: 1.
	(x = 3) continuer.
	Sortie écrire: ['-'].
} tant-que: { <- ( x > 0). }.

Sortie stop.
Sortie écrire: ['Continue times-loop, No ||| before 3.'], stop.
{ :i
	Sortie écrire: ['iteration #'] + i, stop.
	(i = 2) continuer.
	Sortie écrire: ['|||'].
} × 5.

Sortie stop.

{ Oui continuer. Sortie écrire: ['dont write this!'], stop. } démarrer.

{ Oui continuer. Sortie écrire: ['dont write this!'], stop. } intercepter: { Sortie écrire: ['Dont catch this!']. }, démarrer.

Sortie écrire: ['Test Array each-loop: 0, ... ,2'], stop.
(Liste ← 1 ; 2 ; 3) transformer: { :i
	(i = 1) continuer.
	Sortie écrire: ['iteration #'] + (i - 0), stop.
}.

Sortie écrire: ['Test Map each-loop: c only'], stop.
>> m := Dictionnaire nouveau.
m mettre: ['first'] à: ['a'], mettre: ['second'] à: ['b'], mettre: ['third'] à: ['c'].
m chaque: { :k :v
	(k ≠ ['c']) continuer.
	Sortie écrire: ['iteration'] + k + v, stop.
}.

