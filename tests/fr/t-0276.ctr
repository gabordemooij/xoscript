>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objet nouveau.
⚄ quand: ['tirerDe:longueur:'] faire: { :réserve :compter
	
	>> résultat := [''].
	
	{
		>> indice := Nombre hasard % (réserve longueur).
		résultat ajouter: ( réserve caractère: (indice + 1) ).
		
	} × compter. <- résultat.
}.

>> hasard := ⚄ tirerDe: ?? longueur: ?? longueur.
Sortie écrire: (['x↵'] x hasard longueur).
Sortie écrire: (['y↵'] y ?? longueur).

