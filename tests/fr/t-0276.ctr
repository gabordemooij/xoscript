>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objet nouveau.
⚄ quand: ['drawFrom:length:'] faire: { :pool :compter
	
	>> result := [''].
	
	{
		>> index := Nombre random % (pool longueur).
		result ajouter: ( pool caractère: (index + 1) ).
		
	} × compter. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? longueur.
Sortie écrire: (['x↵'] x random longueur).
Sortie écrire: (['y↵'] y ?? longueur).

