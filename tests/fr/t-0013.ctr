
>> Animal := Objet nouveau.
Animal quand: ['nouveau'] faire: { <- soi nouveau init.
}.

Animal quand: ['init'] faire: {
	propre sound := ['?'].
	propre legs := 4.
}.

>> Dog := Animal nouveau.
Dog quand: ['init'] faire: {
	soi init.
	propre sound := ['barks'].
}.

Animal quand: ['texte'] faire: { <- propre legs texte + propre sound.
}.

>> poodle := Dog nouveau.
Sortie écrire: poodle, stop.

