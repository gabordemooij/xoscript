
>> Animal := Objet nouveau.
Animal quand: ['nouveau'] faire: {
	<- soi nouveau init.
}.

Animal quand: ['init'] faire: {
	propre son := ['?'].
	propre pattes  := 4.
}.

>> Chien := Animal nouveau.
Chien quand: ['init'] faire: {
	soi init.
	propre son := ['aboie'].
}.

Animal quand: ['texte'] faire: {
	<- propre pattes texte + propre son.
}.

>> caniche := Chien nouveau.
Sortie écrire: caniche, stop.

