

Liste quand: ['somme'] faire: {
	>> total := 0.
	soi chaque: { :indice :élément
		total additionner: élément.
	}. <- total.
}.

Liste quand: ['produit'] faire: {
	>> total := 1.
	soi chaque: { :indice :élément
		total multiplier-par: élément.
	}. <- total.
}.

>> mémoireUtilisée1 := 0.
>> mémoireUtilisée2 := 0.
>> mémoireUtilisée3 := 0.
>> mémoireUtilisée4 := 0.

Programme gestion-mémoire: 0.

{

>> a := Liste ← ['hello'] ; ['world'] ; Oui ; Rien ; 666.
a := a + ( Liste ← 1 ).
Sortie écrire: ( ['somme : '] + ( a somme ) ), stop.
Sortie écrire: ( ['min : '] + ( a minimum ) ), stop.
Sortie écrire: ( ['max : '] + ( a maximum ) ), stop.
Sortie écrire: ( ['3e : '] + ( a ? 2 ) ), stop.
Sortie écrire: ( ['prod : '] + ( a produit ) ), stop.
a trier: { :a :b <- (b - a). }.
a chaque: { :i :e Sortie écrire: ( i - 0 ), stop. }.

} démarrer.

Programme nettoyer.
mémoireUtilisée1 := (Programme mémoire ? 0).


{

>> a := Liste ← ['hello'] ; ['world'] ; Oui ; Rien ; 666.
a := a + ( Liste ← 1 ).
