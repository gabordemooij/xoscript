

Liste quand: ['sum'] faire: {
	>> total := 0.
	soi chaque: { :index :element
		total additionner: element.
	}. <- total.
}.

Liste quand: ['product'] faire: {
	>> total := 1.
	soi chaque: { :index :element
		total multiplier-par: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programme gestion-mémoire: 0.

{

>> a := Liste ← ['hello'] ; ['world'] ; Oui ; Rien ; 666.
a := a + ( Liste ← 1 ).
Sortie écrire: ( ['sum: '] + ( a sum ) ), stop.
Sortie écrire: ( ['min: '] + ( a minimum ) ), stop.
Sortie écrire: ( ['max: '] + ( a maximum ) ), stop.
Sortie écrire: ( ['3rd: '] + ( a ? 2 ) ), stop.
Sortie écrire: ( ['prd: '] + ( a product ) ), stop.
a trier: { :a :b <- (b - a). }.
a chaque: { :i :e Sortie écrire: ( i - 0 ), stop. }.

} démarrer.

Programme nettoyer.
usedMemory1 := (Programme mémoire ? 0).


{

>> a := Liste ← ['hello'] ; ['world'] ; Oui ; Rien ; 666.
a := a + ( Liste ← 1 ).
Sortie écrire: ( ['sum: '] + ( a sum ) ), stop.
Sortie écrire: ( ['min: '] + ( a minimum ) ), stop.
Sortie écrire: ( ['max: '] + ( a maximum ) ), stop.
Sortie écrire: ( ['3rd: '] + ( a ? 2 ) ), stop.
Sortie écrire: ( ['prd: '] + ( a product ) ), stop.
a trier: { :a :b <- (b - a). }.
a chaque: { :i :e Sortie écrire: ( i - 0 ), stop. }.

} démarrer.



Programme nettoyer.
usedMemory2 := (Programme mémoire ? 0).


{

>> a := Liste ← ['hello'] ; ['world'] ; Oui ; Rien ; 666.
a := a + ( Liste ← 1 ).
Sortie écrire: ( ['sum: '] + ( a sum ) ), stop.
Sortie écrire: ( ['min: '] + ( a minimum ) ), stop.
Sortie écrire: ( ['max: '] + ( a maximum ) ), stop.
Sortie écrire: ( ['3rd: '] + ( a ? 2 ) ), stop.
Sortie écrire: ( ['prd: '] + ( a product ) ), stop.
a trier: { :a :b <- (b - a). }.
a chaque: { :i :e Sortie écrire: ( i - 0 ), stop. }.

} démarrer.



Programme nettoyer.
usedMemory3 := (Programme mémoire ? 0).

( usedMemory1 = usedMemory2 et: usedMemory1 = usedMemory3, et: usedMemory2 = usedMemory3 ) oui: {
	Sortie écrire: ['No memory leaks here'].
}, non: {
	Sortie écrire: ['Leaking memory...'].
}.
