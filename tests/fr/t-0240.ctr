# test des qualificatifs

>> $ := Objet nouveau.

$ quand: ['répondre:'] faire: { :x
	
	>> opération := x caractère: 0.
	>> symbole := x caractère: 1.
	>> argent := x décalage: 2.
	
	>> montant := 0.

	( opération = ['+'] ) oui: {
		( symbole = ['£'] ) oui: { montant := 1.28 × argent. }.
	}. <- montant.
}.



>> x := $ +£20.

Sortie écrire: x, stop.


>> Fruit := Objet nouveau.

Fruit quand: ['nouveau'] faire: {
	>> f := soi nouveau.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit quand: ['apples:'] faire: { :a propre pommes := a. }.
Fruit quand: ['oranges:'] faire: { :p propre oranges := p. }.
Fruit quand: ['pommes'] faire: { <- propre pommes. }.
Fruit quand: ['oranges'] faire: { <- propre oranges. }.

Fruit quand: ['+'] faire: { :f
	
	>> n := Fruit nouveau.
	f additionner: 1.
	
	n apples: (f pommes + propre pommes).
	n oranges:  (f oranges  + propre oranges). <- n.
}.

Fruit quand: ['texte'] faire: { <- ( propre pommes texte + [' pommes et '] + propre oranges + [' oranges'] ).
}.

Nombre quand: ['pommes'] faire: { <- ((Fruit nouveau) apples: soi).
}.

Nombre quand: ['apple'] faire: { <- ((Fruit nouveau) apples: soi).
}.

Nombre quand: ['oranges'] faire: { <- ((Fruit nouveau) oranges: soi).
}.




Sortie écrire: (1 apple + 3 oranges + 4 pommes), stop.


Texte quand: ['deuxFois'] faire: { <- ((soi texte) + (soi texte)).
}.



Sortie écrire: ['❤❤❤'] deuxFois.



