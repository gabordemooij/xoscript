# test qualifiers

>> $ := Objet nouveau.

$ quand: ['répondre:'] faire: { :x
	
	>> operation := x caractère: 0.
	>> valuta := x caractère: 1.
	>> money := x décalage: 2.
	
	>> amount := 0.

	( operation = ['+'] ) oui: {
		( valuta = ['£'] ) oui: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Sortie écrire: x, stop.


>> Fruit := Objet nouveau.

Fruit quand: ['nouveau'] faire: {
	>> f := soi nouveau.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit quand: ['apples:'] faire: { :a propre apples := a. }.
Fruit quand: ['oranges:'] faire: { :p propre oranges := p. }.
Fruit quand: ['apples'] faire: { <- propre apples. }.
Fruit quand: ['oranges'] faire: { <- propre oranges. }.

Fruit quand: ['+'] faire: { :f
	
	>> n := Fruit nouveau.
	f additionner: 1.
	
	n apples: (f apples + propre apples).
	n oranges:  (f oranges  + propre oranges). <- n.
}.

Fruit quand: ['texte'] faire: { <- ( propre apples texte + [' apples and '] + propre oranges + [' oranges'] ).
}.

Nombre quand: ['apples'] faire: { <- ((Fruit nouveau) apples: soi).
}.

Nombre quand: ['apple'] faire: { <- ((Fruit nouveau) apples: soi).
}.

Nombre quand: ['oranges'] faire: { <- ((Fruit nouveau) oranges: soi).
}.




Sortie écrire: (1 apple + 3 oranges + 4 apples), stop.


Texte quand: ['twice'] faire: { <- ((soi texte) + (soi texte)).
}.



Sortie écrire: ['❤❤❤'] twice.



