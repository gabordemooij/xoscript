
Texte quand: ['évaluer'] faire: {
	>> code := Fichier nouveau: ['/tmp/eval.ctr'].
	code écrire: (soi texte + ['.']).
	Programme utiliser: ['/tmp/eval.ctr'].
}.

>> map :=
	(Dictionnaire nouveau)
	mettre: ['Salut toi'] à: ['two'],
	mettre: (Liste ← ['hello'] ; ['world'] ; (Liste ← 1 ; 2; 9) ; Non) à: ['un'],
	mettre: ( (Dictionnaire nouveau) mettre: ['mnde'] à: ['malorthographié'] ) à: ['three'],
	mettre: (Liste ← ((Dictionnaire nouveau) mettre: ['trésor'] à: ['caché']) ; 2) à: ['quatre']. 
>> str := map texte.
>> map2 := Rien.
(['map2 := '] + str ) évaluer.
Sortie écrire: map2 ? ['un'] ? 0.
Sortie écrire: map2 ? ['un'] ? 1.
Sortie écrire: map2 ? ['quatre'] ? 0 ? ['caché'].
Sortie écrire: map2 ? ['un'] ? 2 ? 2.
