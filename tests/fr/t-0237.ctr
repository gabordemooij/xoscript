
Texte quand: ['evaluate'] faire: {
	>> code := Fichier nouveau: ['/tmp/eval.ctr'].
	code écrire: (soi texte + ['.']).
	Programme utiliser: ['/tmp/eval.ctr'].
}.

>> map :=
	(Dictionnaire nouveau)
	mettre: ['Hi There'] à: ['two'],
	mettre: (Liste ← ['hello'] ; ['world'] ; (Liste ← 1 ; 2; 9) ; Non) à: ['one'],
	mettre: ( (Dictionnaire nouveau) mettre: ['wrrld'] à: ['misspelled'] ) à: ['three'],
	mettre: (Liste ← ((Dictionnaire nouveau) mettre: ['treasure'] à: ['hidden']) ; 2) à: ['four']. 
>> str := map texte.
>> map2 := Rien.
(['map2 := '] + str ) evaluate.
Sortie écrire: map2 ? ['one'] ? 0.
Sortie écrire: map2 ? ['one'] ? 1.
Sortie écrire: map2 ? ['four'] ? 0 ? ['hidden'].
Sortie écrire: map2 ? ['one'] ? 2 ? 2.
