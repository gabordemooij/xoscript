Sortie écrire: ['Test object'], stop.
>> a := Objet nouveau. 

a quand: ['item:'] faire: { :num
	propre num := num. 
}.

a quand: ['item'] faire: { <- propre num.
}.

a item: 123.

Sortie écrire: a item, stop.

>> old-num-address := a item prototype adresse-mémoire.
a save-as: ['/tmp/a.bin'].
Sortie écrire: ['========== RELOADING SNAP:'], stop.

>> b := Objet load-from: ['/tmp/a.bin'].

(b item prototype adresse-mémoire = old-num-address) oui: {
	Sortie écrire: ['Object link re-attached.'], stop.
}.

Sortie écrire: b item, stop.
