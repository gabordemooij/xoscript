>> Slurp := Objet nouveau.
Slurp quand: ['nouveau'] faire: {
	propre str := [''].
}.


Slurp quand: ['répondre:'] faire: { :blah
		(propre str ≠ ['']) oui: {
			propre str ajouter: [' '].
		}.
		propre str ajouter: blah.
}.
Slurp quand: ['répondre:et:'] faire: { :blah :blahah
		(propre str ≠ ['']) oui: {
			propre str ajouter: [' '].
		}.
		(blah longueur > 1) oui: {
			propre str ajouter: (blah de: 0 longueur: (blah longueur - 1)).
		}, sinon: {
			propre str ajouter: blah.
		}.
		propre str ajouter: [' '].
		propre str ajouter: blahah.
}.
Slurp quand: ['obtain'] faire: {
	>> buffer := propre str.
	propre str := ['']. <- buffer.
}.

>> paramètres-recherche := Slurp nouveau.
paramètres-recherche select: ['*'], from users where: ['id = 2'].
Sortie écrire: (paramètres-recherche obtain), stop.
