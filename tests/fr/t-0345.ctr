# test catch-all methods
>> x13 := Objet nouveau.
x13 quand: ['a'] faire: { :a Sortie écrire: 0, stop. }.
x13 quand: ['a:'] faire: { :a Sortie écrire: a, stop. <- 5. }.
x13 quand: ['a:b:'] faire: { :a :b Sortie écrire: (a + b), stop. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
