>> V := Objet.
V quand: ['texte'] faire: {
	Sortie écrire: ['conversion'], stop.
	<- ['abc'].
}.

Sortie écrire: ( Programme paramètre: ['abc'] ), stop.

# les paramètres ne doivent pas être collectés par le GC
Programme paramètre: ([''] + V nouveau) valeur: ([''] + V nouveau).

Sortie écrire: ( Programme paramètre: ['abc'] ), stop.
