
Nombre apprendre: ['plus:'] signifie: ['+'].
Nombre quand: ['+'] faire: { :x
	>> taux := 1.
	>> devise := x qualificatif.
	(devise = ['euros']) oui: {
		taux := 2.
	}. <- (soi plus: (x × taux)).
}.
>> dollars := 3.
>> euros := 2.
dollars qualifier: ['dollars'].
euros qualifier: ['euros'].
>> argent := dollars + euros.
Sortie écrire: argent, stop.
