
Nombre apprendre: ['plus:'] signifie: ['+'].
Nombre quand: ['+'] faire: { :x
	>> rate := 1.
	>> currency := x qualificatif.
	(currency = ['euros']) oui: {
		rate := 2.
	}. <- (soi plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars qualifier: ['dollars'].
euros qualifier: ['euros'].
>> money := dollars + euros.
Sortie écrire: money, stop.
