Sortie écrire: ['Test object'], stop.
>> a := Objet nouveau. 

a quand: ['item:'] faire: { :booléen
	propre booléen := booléen. 
}.

a quand: ['item'] faire: { <- propre booléen.
}.

a item: Oui.

Sortie écrire: a item, stop.

>> old-bool-address := a item prototype adresse-mémoire.
a save-as: ['/tmp/a.bin'].
Sortie écrire: ['========== RELOADING SNAP:'], stop.

>> b := Objet load-from: ['/tmp/a.bin'].

(b item prototype adresse-mémoire = old-bool-address) oui: {
	Sortie écrire: ['Object link re-attached.'], stop.
}.

Sortie écrire: b item, stop.
