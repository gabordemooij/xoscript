# Programme shell-escape produit une syntaxe shell posix canonique
# compatible avec : bash/dash, zsh, ksh

>> c := Programme shell-escape: ['abc'].
Sortie écrire: c, stop.
Sortie écrire: ( Programme système: ['echo '] + c ), stop.

c := Programme shell-escape: ['a'b'c'].
Sortie écrire: c, stop.
Sortie écrire: ( Programme système: ['echo '] + c ), stop.

c := Programme shell-escape: ['a\'c'].
Sortie écrire: c, stop.
Sortie écrire: ( Programme système: ['echo '] + c ), stop.