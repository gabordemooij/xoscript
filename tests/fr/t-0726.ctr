# test des tampons PKI/Signature 
Server init.

>> long := ( Liste nouveau remplir: 1000 avec: ['a'] ) joindre: [''].

# signer un message
Sortie écrire: ( 
	Coffre signer: ['abc'] avec: long
), stop.

Sortie écrire: ( 
	Coffre
		vérifier: ['abc'] 
		signature: long 
		avec: long
), stop.

Sortie écrire: (
	Coffre hachage-mot-de-passe: long vérifier: long
), stop.
