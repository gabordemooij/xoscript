
>> countries := Liste nouveau
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Liste nouveau
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods par: countries, chaque: { :key :value
	counter additionner: 1.
}.

Sortie écrire: (['we serve counter dishes'] counter: counter), stop.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] caractères trier: { :v
	counter additionner: 0.
}.

Sortie écrire: (['we sort counter dishes'] counter: counter), stop.


>> counter := 0.
{
	{
		counter additionner: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Sortie écrire: (['we calculate counter numbers.'] counter: counter), stop.

