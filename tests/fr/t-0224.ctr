
>> pays := Liste nouveau
	~ ['Suisse']
	~ ['Italie']
	~ ['Allemagne'].

>> aliments := Liste nouveau
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Choucroute'].


>> compteur := 0.
aliments par: pays, chaque: { :key :value
	compteur additionner: 1.
}.

Sortie écrire: (['we serve counter dishes'] counter: compteur), stop.

>> compteur := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] caractères trier: { :v
	compteur additionner: 0.
}.

Sortie écrire: (['we sort counter dishes'] counter: compteur), stop.


>> compteur := 0.
{
	{
		compteur additionner: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Sortie écrire: (['we calculate counter numbers.'] counter: compteur), stop.

