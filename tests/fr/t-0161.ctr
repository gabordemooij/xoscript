Programme gestion-mémoire: 0.
Liste quand: ['somme'] faire: {
	>> total := 0.
	soi chaque: { :indice :élément
		total additionner: élément.
	}. <- total.
}.

>> mémoireUtilisée1 := 0.
>> mémoireUtilisée2 := 0.
>> mémoireUtilisée3 := 0.
>> mémoireUtilisée4 := 0.



>> f := Fichier nouveau: ['/tmp/test.txt'].
f écrire: ['Lorem Ipsum'].
f fermer.
  

f := Fichier nouveau: ['/tmp/test.txt'].
>> libellé := f lire.
f fermer.



Programme nettoyer.
mémoireUtilisée1 := (Programme mémoire ? 1).



f := Fichier nouveau: ['/tmp/test.txt'].
libellé := f lire.
f fermer.

Programme nettoyer.
mémoireUtilisée2 := (Programme mémoire ? 1).


f := Fichier nouveau: ['/tmp/test.txt'].
libellé := f lire.
f fermer.

Programme nettoyer.
mémoireUtilisée3 := (Programme mémoire ? 1).



( mémoireUtilisée1 = mémoireUtilisée2 et: mémoireUtilisée1 = mémoireUtilisée3, et: mémoireUtilisée2 = mémoireUtilisée3 ) oui: {
	Sortie écrire: ['Pas de fuite de mémoire ici'].
}, non: {
	Sortie écrire: ['Fuite de mémoire...'].
}.
