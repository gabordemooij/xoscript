Sortie écrire: ((Liste nouveau
	quand: ['plaque:'] faire: { :x propre o := x. },
	quand: ['plaque']  faire: { <- propre o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Liste ← 1)
	~ (Liste ← 1 ; 2)
	~ (Liste ← 1 ; 2 ; 3)
	~ (Liste ← 1 ; 2 ; 3 ; 4)
	~ (Liste ← 1 ; 2 ; 3 ; 4 ; 5)
) chaque: { :i :el
	{ Sortie écrire: cette-tâche. } × el compter.
	Sortie stop.
}) plaque, stop.


