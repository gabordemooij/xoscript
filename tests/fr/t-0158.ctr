>> x := [' hallo '].

>> y := x majuscules.
Sortie écrire: x, stop.
Sortie écrire: (x est-égal-à: y), stop.

>> y := x minuscules.
Sortie écrire: x, stop.
Sortie écrire: (x est-égal-à: y), stop.

>> y := x rogner.
Sortie écrire: x, stop.
Sortie écrire: (x est-égal-à: y), stop.

>> y := x décalage: 1.
Sortie écrire: x, stop.
Sortie écrire: (x est-égal-à: y), stop.

>> y := x de: 1 longueur: 2.
Sortie écrire: x, stop.
Sortie écrire: (x est-égal-à: y), stop.