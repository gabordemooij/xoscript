
>> Size := Objet nouveau.
Size quand: ['is:'] faire: { :nombre
	nombre quand: ['+'] faire: { :nombre
		>> unit := nombre qualificatif.
		>> factor := 1.
		
		unit
		cas: ['inch'] faire: { factor := 0.0833. }. <- soi + (nombre * factor).
	}. <- nombre.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Sortie écrire: plank + edge, stop.
