
>> Dimension := Objet nouveau.
Dimension quand: ['is:'] faire: { :nombre
	nombre quand: ['+'] faire: { :nombre
		>> unité := nombre qualificatif.
		>> facteur := 1.
		
		unité
		cas: ['inch'] faire: { facteur := 0.0833. }.

		<- soi + (nombre * facteur).
	}.
	<- nombre.
}.

# Ce nombre de taille peut s'utiliser ainsi :

>> planche := Dimension is: 6 pied.
>> bord := Dimension is: 50 inch.

# Cela s'affichera comme : 10.165
Sortie écrire: planche + bord, stop.
