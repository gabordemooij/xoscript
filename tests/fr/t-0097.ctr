
Texte quand: ['html'] faire: { <- (
		soi
		remplacer: ['&'] par: ['&amp;'],
		remplacer: ['<'] par: ['&lt;'],
		remplacer: ['>'] par: ['&gt;'],
		remplacer: ['"'] par: ['&quot;']
	).
}.

>> PinceauHtml := Objet nouveau.

PinceauHtml quand: ['répondre:'] faire: { :balise
	Sortie écrire: (['<tag>↵'] tag: balise ).
}.

PinceauHtml quand: ['répondre:et:'] faire: { :balise :content
	balise := ( balise de: 0 longueur: (balise longueur - 1) ).
	Sortie écrire: (['<tag content>↵'] tag: balise, content: content).
}.

PinceauHtml quand: ['content:'] faire: { :libellé
	Sortie écrire: libellé html, stop.
}.

PinceauHtml quand: ['attr:valeur:'] faire: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := PinceauHtml nouveau.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] valeur: ['bold']),
		/span
	/body
/html.
		
