#Linux
>> OS := Programme système: (Commande uname -s), rogner.

>> Slurp := Objet nouveau.
Slurp quand: ['nouveau'] faire: {
	propre str := [''].
}.
Slurp quand: ['répondre:'] faire: { :blah
		(propre str ≠ ['']) oui: {
			propre str ajouter: [' '].
		}.
		propre str ajouter: blah.
}.
Slurp quand: ['répondre:et:'] faire: { :blah :blahah
		(propre str ≠ ['']) oui: {
			propre str ajouter: [' '].
		}.
		(blah longueur > 1) oui: {
			propre str ajouter: (blah de: 0 longueur: (blah longueur - 1)).
		}, sinon: {
			propre str ajouter: blah.
		}.
		propre str ajouter: [' '].
		propre str ajouter: blahah.
}.
Slurp quand: ['obtenir'] faire: {
	>> tampon := propre str.
	propre str := ['']. <- tampon.
}.
>> large text := [''].
{
	large text ajouter: ['hello'].
} × 1000.


Sortie écrire: (
	Programme système: (
		Slurp nouveau
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtenir
).

