

>> mémoireUtilisée1 := 0.
>> mémoireUtilisée2 := 0.
>> mémoireUtilisée3 := 0.
>> mémoireUtilisée4 := 0.

Programme gestion-mémoire: 0.

>> txt := ['Word Salad'].
Sortie écrire: ['dernier indice de ots = '] + (( txt dernier: ['ord'] ) - 0), stop.
Sortie écrire: ['indice de ots = '] + (( txt trouver: ['ord'] ) - 0), stop.
Sortie écrire: ['indice de ad = '] + (( txt trouver: ['ad'] ) - 0), stop.
Sortie écrire: ['dernier indice de W = '] + (( txt dernier: ['W'] ) - 0), stop.
Sortie écrire: ['dernier indice de d = '] + (( txt dernier: ['d'] ) - 0), stop.
Sortie écrire: ['txt égale Salade Mots = '] + ( txt = ['Word Salad'] ), stop.
Sortie écrire: ['txt égale Salade César = '] + ( txt = ['Salade César'] ), stop.
Sortie écrire: ['txt n'égale pas Salade Mots = '] + ( txt ≠ ['Word Salad'] ), stop.
Sortie écrire: ['txt n'égale pas Salade César = '] + ( txt ≠ ['Salade César'] ), stop.

Programme nettoyer.

mémoireUtilisée1 := (Programme mémoire ? 0).


txt := ['Word Salad'].
Sortie écrire: ['dernier indice de ots = '] + (( txt dernier: ['ord'] ) - 0), stop.
Sortie écrire: ['indice de ots = '] + (( txt trouver: ['ord'] ) - 0), stop.
Sortie écrire: ['indice de ad = '] + (( txt trouver: ['ad'] ) - 0), stop.
Sortie écrire: ['dernier indice de W = '] + (( txt dernier: ['W'] ) - 0), stop.
Sortie écrire: ['dernier indice de d = '] + (( txt dernier: ['d'] ) - 0), stop.
Sortie écrire: ['txt égale Salade Mots = '] + ( txt = ['Word Salad'] ), stop.
Sortie écrire: ['txt égale Salade César = '] + ( txt = ['Salade César'] ), stop.
Sortie écrire: ['txt n'égale pas Salade Mots = '] + ( txt ≠ ['Word Salad'] ), stop.
Sortie écrire: ['txt n'égale pas Salade César = '] + ( txt ≠ ['Salade César'] ), stop.

Programme nettoyer.
mémoireUtilisée2 := (Programme mémoire ? 0).


txt := ['Word Salad'].
Sortie écrire: ['dernier indice de ots = '] + (( txt dernier: ['ord'] ) - 0), stop.
Sortie écrire: ['indice de ots = '] + (( txt trouver: ['ord'] ) - 0), stop.
Sortie écrire: ['indice de ad = '] + (( txt trouver: ['ad'] ) - 0), stop.
Sortie écrire: ['dernier indice de W = '] + (( txt dernier: ['W'] ) - 0), stop.
Sortie écrire: ['dernier indice de d = '] + (( txt dernier: ['d'] ) - 0), stop.
Sortie écrire: ['txt égale Salade Mots = '] + ( txt = ['Word Salad'] ), stop.
Sortie écrire: ['txt égale Salade César = '] + ( txt = ['Salade César'] ), stop.
Sortie écrire: ['txt n'égale pas Salade Mots = '] + ( txt ≠ ['Word Salad'] ), stop.
Sortie écrire: ['txt n'égale pas Salade César = '] + ( txt ≠ ['Salade César'] ), stop.

Programme nettoyer.
mémoireUtilisée3 := (Programme mémoire ? 0).



( mémoireUtilisée1 = mémoireUtilisée2 et: mémoireUtilisée1 = mémoireUtilisée3, et: mémoireUtilisée2 = mémoireUtilisée3 ) oui: {
	Sortie écrire: ['Pas de fuite de mémoire ici'].
}, non: {
	Sortie écrire: ['Fuite de mémoire...'].
}.
