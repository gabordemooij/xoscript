
>> Rectangle := Objet nouveau.

Rectangle quand: ['aire'] faire: {
	<- propre longueur * propre largeur.
}.

Rectangle quand: ['length:'] faire: { :longueur
	propre longueur := longueur.
}.

Rectangle quand: ['width:'] faire: { :largeur
	propre largeur := largeur.
}.

Rectangle quand: ['nouveau'] faire: {
	# cela ne provoquera pas de boucle infinie
	>> rectangle := soi nouveau.
	rectangle length: 0, width: 0.
	<- rectangle.
}.

>> a := Rectangle nouveau.
Sortie écrire: a aire, stop. #0

>> b := Rectangle nouveau length: 2, width: 3.
Sortie écrire: b aire, stop. #6

