
>> Rectangle := Objet nouveau.

Rectangle quand: ['area'] faire: { <- propre longueur * propre width.
}.

Rectangle quand: ['length:'] faire: { :longueur
	propre longueur := longueur.
}.

Rectangle quand: ['width:'] faire: { :width
	propre width := width.
}.

Rectangle quand: ['nouveau'] faire: {
	# this will not result into an infinite loop
	>> rectangle := soi nouveau.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle nouveau.
Sortie écrire: a area, stop. #0

>> b := Rectangle nouveau length: 2, width: 3.
Sortie écrire: b area, stop. #6

