>> numbers := ['1,2,3'] diviser: [','].
Sortie écrire: ['I got: '] + numbers compter + [' numbers.'],stop.
{ :i Sortie écrire: ['number #'] + i + [':'] + (numbers position: i), stop.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages diviser: [' Or '].
Sortie écrire: ['We serve'], stop.
{ :i Sortie écrire: ['->'] + (beverages position: i), stop. } × (beverages compter).
Sortie écrire: (beverages joindre: [',']), stop.
Sortie écrire: (numbers joindre: ['||']).
