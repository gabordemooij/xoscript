>> nombres := ['1,2,3'] diviser: [','].
Sortie écrire: ['J'ai : '] + nombres compter + [' nombres.'],stop.
{ :i Sortie écrire: ['number #'] + i + [':'] + (nombres position: i), stop.} × 3.
>> boissons := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
boissons := boissons diviser: [' Or '].
Sortie écrire: ['Nous servons'], stop.
{ :i Sortie écrire: ['->'] + (boissons position: i), stop. } × (boissons compter).
Sortie écrire: (boissons joindre: [',']), stop.
Sortie écrire: (nombres joindre: ['||']).
