#Linux
>> clock := Moment nouveau.
clock zone: ['UTC-1'].
clock année: 1981, mois: 1, jour: 5,
      heure: 13, minute: 15, seconde: 13.

Sortie écrire: clock, stop.
clock zone: ['UTC+0'].

Sortie écrire: (
	(clock année brut) + ['-'] + (clock mois) + ['-'] + (clock jour) + [' '] +
	(clock heure) + [':'] + (clock minute) + [':'] + (clock seconde) + [' '] +
	['W'] + (clock semaine) + (clock zone)
), stop.


clock zone: ['UTC-1'].
Sortie écrire: (
	(clock année brut) + ['-'] + (clock mois) + ['-'] + (clock jour) + [' '] +
	(clock heure) + [':'] + (clock minute) + [':'] + (clock seconde) + [' '] +
	['W'] + (clock semaine) + (clock zone)
), stop.
