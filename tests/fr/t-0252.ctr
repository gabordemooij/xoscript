#Linux
>> horloge := Moment nouveau.
horloge zone: ['UTC-1'].
horloge année: 1981, mois: 1, jour: 5,
      heure: 13, minute: 15, seconde: 13.

Sortie écrire: horloge, stop.
horloge zone: ['UTC+0'].

Sortie écrire: (
	(horloge année brut) + ['-'] + (horloge mois) + ['-'] + (horloge jour) + [' '] +
	(horloge heure) + [':'] + (horloge minute) + [':'] + (horloge seconde) + [' '] +
	['W'] + (horloge semaine) + (horloge zone)
), stop.


horloge zone: ['UTC-1'].
Sortie écrire: (
	(horloge année brut) + ['-'] + (horloge mois) + ['-'] + (horloge jour) + [' '] +
	(horloge heure) + [':'] + (horloge minute) + [':'] + (horloge seconde) + [' '] +
	['W'] + (horloge semaine) + (horloge zone)
), stop.
