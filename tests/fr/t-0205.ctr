>> str := ['write:'].
Sortie message: ['écrire:'] arguments: (Liste ← ['Hello World']), stop. 

Nombre quand: ['isbetween:and:'] faire: { :a :b <- ((soi ≥ a) et: (soi ≤ b)).
}.

str := ['isbetween:and:'].
Sortie écrire: (3 message: str arguments: (Liste ← 2 ; 8)), stop.
Sortie écrire: (3 message: str arguments: (Liste ← 1 ; 2)), stop.


>> CoffeeMachine := Objet nouveau.
CoffeeMachine quand: ['makeCoffeeWithSugar:milk:'] faire: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Liste ← 4 ; 2.
Sortie écrire: ( CoffeeMachine message: order arguments: coffeeConfiguration ), stop.
