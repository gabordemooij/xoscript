>> str := ['write:'].
Sortie message: ['écrire:'] arguments: (Liste ← ['Hello World']), stop. 

Nombre quand: ['isbetween:and:'] faire: { :a :b <- ((soi ≥ a) et: (soi ≤ b)).
}.

str := ['isbetween:and:'].
Sortie écrire: (3 message: str arguments: (Liste ← 2 ; 8)), stop.
Sortie écrire: (3 message: str arguments: (Liste ← 1 ; 2)), stop.


>> MachineÀCafé := Objet nouveau.
MachineÀCafé quand: ['makeCoffeeWithSugar:milk:'] faire: { :sugar :milk <- ( ['Et voilà... un café avec '] + 
			sugar +
			[' cuillères de sucre et '] +
			milk +
			[' gouttes de lait.']
	).
}.

>> commander := ['makeCoffeeWithSugar:milk:'].
>> configurationCafé := Liste ← 4 ; 2.
Sortie écrire: ( MachineÀCafé message: commander arguments: configurationCafé ), stop.
