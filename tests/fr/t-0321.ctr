# test qualifiers

Programme nettoyer.

>> Fruit := Objet nouveau.
Fruit quand: ['nouveau'] faire: {
	>> f := soi nouveau.
	f apples: 0. <- f.
}.
Fruit quand: ['apples:'] faire: { :a propre apples := a. }.
Fruit quand: ['apples'] faire: { <- propre apples. }.
Fruit quand: ['+'] faire: { :f
	>> n := Fruit nouveau.
	n apples: (f apples + propre apples). <- n.
}.
Nombre quand: ['apples'] faire: { <- ((Fruit nouveau) apples: soi).
}.

Fruit quand: ['texte'] faire: { <- propre apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Sortie écrire: q, stop.




q := 3 apples + 4 apples.
Sortie écrire: q, stop.



q := 3 apples + 4 apples.
