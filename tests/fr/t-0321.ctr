# test des qualificatifs

Programme nettoyer.

>> Fruit := Objet nouveau.
Fruit quand: ['nouveau'] faire: {
	>> f := soi nouveau.
	f apples: 0. <- f.
}.
Fruit quand: ['apples:'] faire: { :a propre pommes := a. }.
Fruit quand: ['pommes'] faire: { <- propre pommes. }.
Fruit quand: ['+'] faire: { :f
	>> n := Fruit nouveau.
	n apples: (f pommes + propre pommes). <- n.
}.
Nombre quand: ['pommes'] faire: { <- ((Fruit nouveau) apples: soi).
}.

Fruit quand: ['texte'] faire: { <- propre pommes + [' pommes '].
}.

>> q := 3 pommes + 4 pommes.
Sortie écrire: q, stop.




q := 3 pommes + 4 pommes.
Sortie écrire: q, stop.



q := 3 pommes + 4 pommes.
Sortie écrire: q, stop.


