Sortie écrire: ['Test object'], stop.
>> a := Objet nouveau. 

a quand: ['item:'] faire: { :moment
	propre moment := moment. 
}.

a quand: ['item'] faire: { <- propre moment.
}.

>> today := Liste nouveau ; ( Moment nouveau zone: ['CEST'], année: 2026, mois: 7 ).
a item: today.
Sortie écrire: a item ? 0, stop.
a save-as: ['/tmp/a.bin'].
