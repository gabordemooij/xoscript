Sortie écrire: ['Objet de test'], stop.
>> a := Objet nouveau. 

a quand: ['item:'] faire: { :unMoment
	propre unMoment := unMoment. 
}.

a quand: ['article'] faire: {
	<- propre unMoment.
}.

>> aujourdhui := Liste nouveau ; ( Moment nouveau zone: ['CEST'], année: 2026, mois: 7 ).
a item: aujourdhui.
Sortie écrire: a article ? 0, stop.
a save-as: ['/tmp/a.bin'].
