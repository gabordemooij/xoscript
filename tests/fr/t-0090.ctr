Sortie écrire: ['1,2,3,4,5,6,7,8,9,A,'], stop.
>> Portée := Objet nouveau.
Portée quand: ['initialize:'] faire: { :x propre propriété := x. }.
Portée quand: ['confirmer'] faire: { Sortie écrire: [',']. }.
Portée quand: ['test'] faire: {
	Sortie écrire: propre propriété.
	soi confirmer.
	( 1 = 1 ) oui: { Sortie écrire: propre propriété. soi confirmer. }.
	( 1 = 0 ) non: { Sortie écrire: propre propriété. soi confirmer. }.
	>> y := 2. { Sortie écrire: propre propriété. soi confirmer. } tant-que: { y soustraire: 1. <- (y > 0). }.
	{ Sortie écrire: propre propriété. soi confirmer. } × 1.
	(Liste ← 1) chaque: {  Sortie écrire: propre propriété. soi confirmer. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo implémenter un tri propre, ce test échoue car le nombre d'itérations diffère selon la plateforme
	(Dictionnaire nouveau one: ['item']) chaque: { Sortie écrire: propre propriété. soi confirmer. }.
	{ 1 ÷ 0. } intercepter: { Sortie écrire: propre propriété. soi confirmer. }, démarrer.
	Sortie stop.
}.
>> portée1 := Portée nouveau.
portée1 initialize: ['X'].
portée1 test.
>> maFonction := { 
	propre propriété := ['Y'].
	Sortie écrire: propre propriété.
	soi confirmer.
	( 1 = 1 ) oui: { Sortie écrire: propre propriété. soi confirmer. }.
	( 1 = 0 ) non: { Sortie écrire: propre propriété. soi confirmer. }.
	>> y := 2. { Sortie écrire: propre propriété. soi confirmer. } tant-que: { y soustraire: 1. <- (y > 0). }.
	{ Sortie écrire: propre propriété. soi confirmer. } × 1.
	(Liste ← 1) chaque: {  Sortie écrire: propre propriété. soi confirmer. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Dictionnaire nouveau one: ['item']) chaque: { Sortie écrire: propre propriété. soi confirmer. }.
	{ 1 ÷ 0. } intercepter: { Sortie écrire: propre propriété. soi confirmer. }, démarrer.
	Sortie stop.
}.
