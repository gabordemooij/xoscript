# les clés et signatures du coffre-fort qui se décodent trop longues ne doivent pas déborder de la pile
Server init.

>> clés := Coffre générer-clés.
>> cs := clés premier.
>> cp := clés dernier.
>> sig := Coffre signer: ['abc'] avec: cs.

# 88 caractères sans remplissage se décodent en 66 octets
>> long := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 caractères sans remplissage se décodent en 33 octets
>> court := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Coffre signer: ['abc'] avec: long. } intercepter: { :e
	Sortie écrire: e, stop.
}, démarrer.

{ Coffre vérifier: ['abc'] signature: long avec: cp. } intercepter: { :e
	Sortie écrire: e, stop.
}, démarrer.

{ Coffre vérifier: ['abc'] signature: sig avec: court. } intercepter: { :e
	Sortie écrire: e, stop.
}, démarrer.
