

Texte quand: ['evaluate'] faire: {
	>> code := Fichier nouveau: ['/tmp/eval.ctr'].
	code écrire: (soi texte + ['.']).
	Programme utiliser: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Liste ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q texte.
Sortie écrire: x, stop.
>> y := Rien.
(['y := '] + x ) evaluate.
Sortie écrire: y ? 0, stop.

q := Dictionnaire mettre: ['\[''] à: ['\['quote\']'].
x := q texte.
Sortie écrire: x, stop.
y := Rien.
(['y := '] + x ) evaluate.

>> q := (Dictionnaire nouveau) mettre:['\[''] à:['\['quote\[''].
Sortie écrire: y ? ['\['quote\']'], stop.
