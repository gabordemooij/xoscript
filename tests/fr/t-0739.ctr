Sortie écrire: ['Objet de test'], stop.
>> a := Objet nouveau. 

a quand: ['item:'] faire: { :aidebin
	propre aidebin := aidebin. 
}.

a quand: ['article'] faire: {
	<- propre aidebin.
}.

a item: Bin nouveau.

>> ancienne-adresse-aidebin := a article prototype adresse-mémoire.
a save-as: ['/tmp/a.bin'].
Sortie écrire: ['========== RECHARGEMENT DU SNAP :'], stop.

>> b := Objet load-from: ['/tmp/a.bin'].

(b article prototype adresse-mémoire = ancienne-adresse-aidebin) oui: {
	Sortie écrire: ['Lien d'objet rattaché.'], stop.
}.


