Sortie écrire: ['Test object'], stop.
>> a := Objet nouveau. 

a quand: ['item:'] faire: { :binhelper
	propre binhelper := binhelper. 
}.

a quand: ['item'] faire: { <- propre binhelper.
}.

a item: Bin nouveau.

>> old-binhelper-address := a item prototype adresse-mémoire.
a save-as: ['/tmp/a.bin'].
Sortie écrire: ['========== RELOADING SNAP:'], stop.

>> b := Objet load-from: ['/tmp/a.bin'].

(b item prototype adresse-mémoire = old-binhelper-address) oui: {
	Sortie écrire: ['Object link re-attached.'], stop.
}.


