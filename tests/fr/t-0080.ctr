{
	>> a := Liste nouveau.
	a ajouter: 1.
	a ajouter: 2.
	Sortie écrire: (a joindre: [',']), stop.
	a mettre: 3 à: 2.
	Sortie écrire: (a joindre: [',']), stop.
	a mettre: 4 à: 10.
	Sortie écrire: (a joindre: [',']), stop.
	a retirer-premier.
	a retirer-premier.
	a retirer-premier.
	Sortie écrire: (a joindre: [',']), stop.
	a mettre: 9 à: 0.
	Sortie écrire: (a joindre: [',']), stop.
	a mettre: 6 à: -1.
} intercepter: { :e
	Sortie écrire: ['Uncatched error has occurred.↵'] + e, stop.
}, démarrer.


