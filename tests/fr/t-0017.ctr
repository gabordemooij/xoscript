Nombre quand: ['factorial'] faire: {
	>> total := 1.
	{ :index total multiplier-par: (soi - (index)). } × soi. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Sortie écrire: a.
>> b := 2 + 3 factorial.
Sortie écrire: b.
>> c := 3 factorial + 2.
Sortie écrire: c.
>> d := 2 + (3 factorial).
Sortie écrire: d.
Sortie écrire: 2 + 3 factorial + 1.
