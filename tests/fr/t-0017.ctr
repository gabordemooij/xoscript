Nombre quand: ['factorielle'] faire: {
	>> total := 1.
	{ :indice total multiplier-par: (soi - (indice)). } × soi. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Sortie écrire: a.
>> b := 2 + 3 factorielle.
Sortie écrire: b.
>> c := 3 factorielle + 2.
Sortie écrire: c.
>> d := 2 + (3 factorielle).
Sortie écrire: d.
Sortie écrire: 2 + 3 factorielle + 1.
