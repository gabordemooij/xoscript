>> a := Liste ← Objet ; Oui ; Non ; Booléen ; 1 ; Nombre ; ['Str'] ; Texte ; { ['Empty']. }.
Sortie écrire: (a compter), stop.
{ :i
	Sortie écrire: 
	['a '] + 
	((a ? i) type) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Rien?) soit: [''] soit: ['NOT']) + 
	[' Nil.'],
	stop.
} × (a compter).
Sortie écrire: ['but.. Nil is.. '] + ((Rien Rien?) soit: ['certainly NIL!'] soit: ['not NIL??']), stop.