>> a := Liste ← Objet ; Oui ; Non ; Booléen ; 1 ; Nombre ; ['Txt'] ; Texte ; { ['Vide']. }.
Sortie écrire: (a compter), stop.
{ :i
	Sortie écrire: 
	['a '] + 
	((a ? i) type) +
	([' \‘this\’ '] this: (a ? i))  +
	[' est '] +
	(((a ? i) Rien?) soit: [''] soit: ['PAS']) + 
	[' Rien.'],
	stop.
} × (a compter).
Sortie écrire: ['mais.. Rien est.. '] + ((Rien Rien?) soit: ['certainement RIEN !'] soit: ['pas RIEN ??']), stop.