# test number -> string -> number
{

	>> x := Nombre entre: 0 et: 1000000.
	>> d := Nombre entre: 1 et: 7.
	>> e := 10 puissance: d.

	x diviser-par: e.
	>> y := x texte nombre.

	(x = y) non: {
		Sortie écrire: x, stop.
		Sortie écrire: y, stop.
		Programme fin.
	}.

} * 1000.
Sortie écrire: ['OK'], stop.