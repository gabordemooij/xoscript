>> t := Waxba.

# you can control the time zone for
# parsing like this:
Xilli aag: ['CET'].
t := Xilli isha: ['1981-02-03 04:05:06'].
Soo-saar qor: t, sadar-cusub.

# now using CEST time zone:
Xilli aag: ['CEST'].
t := Xilli isha: ['1981-02-03 04:05:06'].
Soo-saar qor: t, sadar-cusub.

# error if string cannot be parsed
{ Xilli isha: ['1900']. } qabo: { Waxba. }, bilow.
