Barnaamij maamulka-xusuusta: 4.

>> Doubler := Walax cusub.
>> Multiplier := Walax cusub.
Doubler marka: ['double:and:'] samee: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier marka: ['multiply:and:'] samee: { :x :y <- (x × y).
}.

Soo-saar qor: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), sadar-cusub.
