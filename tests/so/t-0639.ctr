
Server init.
Soo-saar qor: ['Database test'], sadar-cusub.

>> db := Maria-DB cusub martigeliye: ['localhost'],
	magaca-isticmaalaha: ['xo'], 
	furaha-sirta: ['pass123'],
	magaca-xogta: ['xobase'],
	ku-xirmo.

>> xuduudaha-raadinta :=
db weydiin: ['SELECT REPEAT('Blah',1000) AS blah'], 
soo-qaad: { :row 
	Soo-saar qor: row blah dherer, sadar-cusub.
}.
