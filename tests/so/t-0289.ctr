#Linux
>> OS := Barnaamij nidaam: (Amar uname -s), jar-bannaanka.

>> Slurp := Walax cusub.
Slurp marka: ['cusub'] samee: {
	iska-leh str := [''].
}.
Slurp marka: ['jawaab:'] samee: { :blah
		(iska-leh str ≠ ['']) run: {
			iska-leh str dhammaadka-ku-dar: [' '].
		}.
		iska-leh str dhammaadka-ku-dar: blah.
}.
Slurp marka: ['jawaab:iyo:'] samee: { :blah :blahah
		(iska-leh str ≠ ['']) run: {
			iska-leh str dhammaadka-ku-dar: [' '].
		}.
		(blah dherer > 1) run: {
			iska-leh str dhammaadka-ku-dar: (blah ka: 0 dherer: (blah dherer - 1)).
		}, haddii-kale: {
			iska-leh str dhammaadka-ku-dar: blah.
		}.
		iska-leh str dhammaadka-ku-dar: [' '].
		iska-leh str dhammaadka-ku-dar: blahah.
}.
Slurp marka: ['obtain'] samee: {
	>> buffer := iska-leh str.
	iska-leh str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text dhammaadka-ku-dar: ['hello'].
} × 1000.


Soo-saar qor: (
	Barnaamij nidaam: (
		Slurp cusub
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

