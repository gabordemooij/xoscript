>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Walax cusub.
⚄ marka: ['drawFrom:length:'] samee: { :pool :tirada-guud
	
	>> result := [''].
	
	{
		>> index := Tiro random % (pool dherer).
		result dhammaadka-ku-dar: ( pool xaraf: (index + 1) ).
		
	} × tirada-guud. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? dherer.
