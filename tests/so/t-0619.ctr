>> HTML := Walax cusub.
HTML marka: ['jawaab:'] samee: { :tag 
	Soo-saar qor: (['<tag>'] tag: tag), sadar-cusub.
}.
HTML marka: ['jawaab:iyo:'] samee: { :tag :html 
	Soo-saar qor: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), sadar-cusub.
}.
>> html := HTML cusub.
html body h1: ['header'].

