

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Barnaamij maamulka-xusuusta: 0.

>> o := Walax cusub.
>> o2 := Walax cusub.
Soo-saar qor: o Waxba?, sadar-cusub.
Soo-saar qor: o nooc, sadar-cusub.
Soo-saar qor: ( o isku-mid: o ), sadar-cusub.
Soo-saar qor: ( o isku-mid: o2 ), sadar-cusub.
Soo-saar qor: o naftayda, sadar-cusub.
Soo-saar qor: ( o samee dhammaaday ), sadar-cusub.

Barnaamij nadiifi.

usedMemory1 := (Barnaamij xusuus ? 0).


o := Walax cusub.
o2 := Walax cusub.
Soo-saar qor: o Waxba?, sadar-cusub.
Soo-saar qor: o nooc, sadar-cusub.
Soo-saar qor: ( o isku-mid: o ), sadar-cusub.
Soo-saar qor: ( o isku-mid: o2 ), sadar-cusub.
Soo-saar qor: o naftayda, sadar-cusub.
Soo-saar qor: ( o samee dhammaaday ), sadar-cusub.

Barnaamij nadiifi.
usedMemory2 := (Barnaamij xusuus ? 0).


o := Walax cusub.
o2 := Walax cusub.
Soo-saar qor: o Waxba?, sadar-cusub.
Soo-saar qor: o nooc, sadar-cusub.
Soo-saar qor: ( o isku-mid: o ), sadar-cusub.
Soo-saar qor: ( o isku-mid: o2 ), sadar-cusub.
Soo-saar qor: o naftayda, sadar-cusub.
Soo-saar qor: ( o samee dhammaaday ), sadar-cusub.

Barnaamij nadiifi.
usedMemory3 := (Barnaamij xusuus ? 0).



( usedMemory1 = usedMemory2 iyo: usedMemory1 = usedMemory3, iyo: usedMemory2 = usedMemory3 ) run: {
	Soo-saar qor: ['No memory leaks here'].
}, been: {
	Soo-saar qor: ['Leaking memory...'].
}.
