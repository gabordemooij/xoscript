>> a := 3.
>> b := a koobiyee.
a ka-jar: 1.
Soo-saar qor: [' a = '] + a.
Soo-saar qor: [' b = '] + b.
a := 3.
b := a + 4.
Soo-saar qor: [' a = '] + a.
Soo-saar qor: [' b = '] + b.
>> x := 3.
>> y := x koobiyee.
x ku-dar: 10.
y ka-jar: 1.
Soo-saar qor: [' x = '] + x.
Soo-saar qor: [' y = '] + y.
>> q := Walax cusub.
q marka: ['setProperty:'] samee: { :x
	iska-leh prop := x.
}.
q marka: ['getProperty'] samee: { <- iska-leh prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Soo-saar qor: [' p = '] + (p getProperty).
