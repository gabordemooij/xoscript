Tiro marka: ['roman'] samee: {
	>> tiro := naf koobiyee.
	>> roman := [''].
	{
		{
			(tiro ≥ 1000) run: {
				roman dhammaadka-ku-dar: ['Ⅿ'].
				tiro ka-jar: 1000.
			}, jooji-wareegga.
		
			(tiro ≥ 500) run: {
				roman dhammaadka-ku-dar: ['Ⅾ'].
				tiro ka-jar: 500.
			}, jooji-wareegga.
		
			(tiro ≥ 100) run: {
				roman dhammaadka-ku-dar: ['Ⅽ'].
				tiro ka-jar: 100.
			}, jooji-wareegga.
		
			(tiro ≥ 50) run: {
				roman dhammaadka-ku-dar: ['Ⅼ'].
				tiro ka-jar: 50.
			}, jooji-wareegga.
		
			(tiro ≥ 50) run: {
				roman dhammaadka-ku-dar: ['Ⅼ'].
				tiro ka-jar: 50.
			}, jooji-wareegga.
		
			(tiro ≥ 10) run: {
				roman dhammaadka-ku-dar: ['Ⅹ'].
				tiro ka-jar: 10.
			}, jooji-wareegga.
			
			(tiro ≥ 9) run: {
				roman dhammaadka-ku-dar: ['Ⅸ'].
				tiro ka-jar: 9.
			}, jooji-wareegga.
			
			(tiro ≥ 5) run: {
				roman dhammaadka-ku-dar: ['Ⅴ'].
				tiro ka-jar: 5.
			}, jooji-wareegga.
			
			(tiro ≥ 4) run: {
				roman dhammaadka-ku-dar: ['Ⅳ'].
				tiro ka-jar: 4.
			}, jooji-wareegga.
			
			(tiro ≥ 1) run: {
				roman dhammaadka-ku-dar: ['Ⅰ'].
				tiro ka-jar: 1.
			}, jooji-wareegga.
		} habraac.
	} inta: { <- tiro > 0. }. <- roman.
}.

Soo-saar qor: 1 roman, sadar-cusub.
Soo-saar qor: 2 roman, sadar-cusub.
Soo-saar qor: 4 roman, sadar-cusub.
Soo-saar qor: 8 roman, sadar-cusub.
Soo-saar qor: 16 roman, sadar-cusub.
Soo-saar qor: 32 roman, sadar-cusub.
Soo-saar qor: 64 roman, sadar-cusub.
Soo-saar qor: 128 roman, sadar-cusub.
Soo-saar qor: 256 roman, sadar-cusub.
Soo-saar qor: 1024 roman, sadar-cusub.
