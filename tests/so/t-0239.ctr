} qabo: { :error
	Soo-saar qor: ['Error noted: '] + error, sadar-cusub.
}, bilow.



{
	a marka: ['tiro'] samee: { <- Run. }.
	a := 3 × a.
} qabo: { :error
	Soo-saar qor: ['Error noted: '] + error, sadar-cusub.
}, bilow.


