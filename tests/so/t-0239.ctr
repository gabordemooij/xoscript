Liis marka: ['sum'] samee: {
	>> total := 0.
	naf mid-kasta: { :index :element
		total ku-dar: element.
	}. <- total.
}.

>> a := Run.



a marka: ['qoraal'] samee: {
	>> answer := Waxba.
	( naf = Run ) run: {
		answer := ['Yep'].
	}, haddii-kale: {
		answer := ['Nope'].
	}. <- answer.
}.

a marka: ['tiro'] samee: {
	>> answer := Waxba.
	( naf = Run ) run: {
		answer := 10.
	}, haddii-kale: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b marka: ['qoraal'] samee: { <- ['Devil'].
}.

b marka: ['buuliyaan'] samee: { <- Been.
}.


Soo-saar qor: a, sadar-cusub.  
Soo-saar qor: (90 + a), sadar-cusub. 
Soo-saar qor: b, sadar-cusub. 
Soo-saar qor: (Run iyo: b), sadar-cusub.

a := Liis ← ['hello'] ; ['world'] ; Run ; Waxba ; 666. 
a := a + ( Liis ← 1 ).
Soo-saar qor: a, sadar-cusub.
Soo-saar qor: ((Qaamuus cusub) dhig: Waxba furaha: Waxba), sadar-cusub.
Soo-saar qor: a sum, sadar-cusub. 


{
	a marka: ['qoraal'] samee: { <- Waxba. }.
	a := [''] + a.
} qabo: { :error
	Soo-saar qor: ['Error noted: '] + error, sadar-cusub.
}, bilow.



{
	a marka: ['tiro'] samee: { <- Waxba. }.
	a := 3 × a.
} qabo: { :error
	Soo-saar qor: ['Error noted: '] + error, sadar-cusub.
}, bilow.


{
	a marka: ['buuliyaan'] samee: { <- Waxba. }.
	a := Run iyo: a. 
} qabo: { :error
	Soo-saar qor: ['Error noted: '] + error, sadar-cusub.
}, bilow.





