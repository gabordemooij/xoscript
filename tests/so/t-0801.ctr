Server init.

>> db := Maria-DB cusub martigeliye: ['localhost'],
	magaca-isticmaalaha: ['xo'],
	furaha-sirta: ['pass123'],
	magaca-xogta: ['xobase'],
	ku-xirmo.

>> del := db weydiin: ['DELETE FROM book WHERE id > 0'].
{  del fuli. db xaqiiji. } qabo: { :e db dib-u-celi.  }, bilow.

>> tirada-guud := db weydiin: ['SELECT COUNT(*) AS num FROM book'].
tirada-guud soo-qaad: { :row Soo-saar qor: row num, sadar-cusub. }.
