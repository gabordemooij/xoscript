# recursive interpolation not allowed

Soo-saar qor: 
['recursive string interolation enabled: '] + (
	Barnaamij astaan: 
	['RECURSIVE_STRINTPOL']
), sadar-cusub.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Soo-saar qor: a, sadar-cusub.


Barnaamij astaan: ['RECURSIVE_STRINTPOL'] shid: Run.

