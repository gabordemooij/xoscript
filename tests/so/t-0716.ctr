Soo-saar qor: ['Test object'], sadar-cusub.
>> a := Walax cusub. 

a marka: ['state:'] samee: { :list
	iska-leh list := list. 
}.

a marka: ['state'] samee: {
	Soo-saar qor: iska-leh list, sadar-cusub.
}.

a state: ( Liis cusub ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
Soo-saar qor: ['========== RELOADING SNAP:'], sadar-cusub.
>> b := Walax load-from: ['/tmp/a.bin'].
