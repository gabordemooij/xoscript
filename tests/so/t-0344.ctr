# catch-all test (practical)
>> HTML := Qoraal cusub.
HTML marka: ['encode:'] samee: { :tekst
	naf dhammaadka-ku-dar: (tekst
	beddel: ['&'] ku: ['&amp;'], 
	beddel: ['<'] ku: ['&lt;'],
	beddel: ['>'] ku: ['&gt;'],
	beddel: ['"'] ku: ['&quot;']).
}.
>> blog := HTML cusub.
blog dhammaadka-ku-dar: ['<h1>'],
     encode: ['Koffie & Thee'],
     dhammaadka-ku-dar: ['</h1>'].
Soo-saar qor: blog, sadar-cusub.


>> Roman := Tiro cusub.
Roman marka: ['stringy'] samee: {
	>> a := [''].
	{ a dhammaadka-ku-dar: ['I']. } × naf. <- a.
}.

>> x := Roman cusub.
x ku-dar: 3.
Soo-saar qor: x stringy, sadar-cusub.

>> Quantum := Buuliyaan cusub.
Quantum marka: ['true?'] samee: { <- ['maybe True']. }.
Soo-saar qor: (Quantum cusub true?), sadar-cusub.

>> Nihil := Waxba cusub.
Nihil marka: ['qoraal'] samee: { <- ['Nihil']. }.
Soo-saar qor: (Nihil cusub), sadar-cusub.
