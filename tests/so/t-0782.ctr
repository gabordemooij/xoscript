Soo-saar qor: ['Test object'], sadar-cusub.
>> cmd := Amar cusub.
Soo-saar qor: cmd ls /tmp, sadar-cusub.
>> old-cmd-address := cmd tusaale-hore cinwaanka-xusuusta.
cmd save-as: ['/tmp/a.bin'].
Soo-saar qor: ['========== RELOADING SNAP:'], sadar-cusub.
>> b := Walax load-from: ['/tmp/a.bin'].
(b tusaale-hore cinwaanka-xusuusta = old-cmd-address) run: {
	Soo-saar qor: ['Object link re-attached.'], sadar-cusub.
}.
Soo-saar qor: b ls, sadar-cusub.


