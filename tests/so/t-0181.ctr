

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Barnaamij maamulka-xusuusta: 0.

>> txt := ['World Salad'].
Soo-saar qor: ['this text contains: '] + ( ( txt kala-qaybi: [' '] ) tirada-guud ) + [' words.'], sadar-cusub.
txt := txt ka: 6 dherer: 4.
Soo-saar qor: txt, sadar-cusub.

Barnaamij nadiifi.

usedMemory1 := (Barnaamij xusuus ? 0).


