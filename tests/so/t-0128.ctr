
Liis marka: ['sum'] samee: {
	>> total := 0.
	naf mid-kasta: { :index :element
		total ku-dar: element.
	}. <- total.
}.

>> a := Liis ← 9 ; 8 ; 7.
Soo-saar qor: (a sum), sadar-cusub. 
>> a := Liis ← 1 ; 9.
Soo-saar qor: (a sum), sadar-cusub. 
>> a := Liis ← ['o'] ; 2.
Soo-saar qor: (a sum), sadar-cusub. 
Soo-saar qor: (Liis cusub sum), sadar-cusub. 
