# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Khasnad 
	hash-furaha-sirta: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Khasnad 
	hash-furaha-sirta: hash xaqiiji: a1.
	# fail 
>> b := Khasnad
	hash-furaha-sirta: hash xaqiiji: a2.
	# ok!

Soo-saar qor: a, sadar-cusub.
Soo-saar qor: b, sadar-cusub.

