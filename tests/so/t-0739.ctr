Soo-saar qor: ['Test object'], sadar-cusub.
>> a := Walax cusub. 

a marka: ['item:'] samee: { :binhelper
	iska-leh binhelper := binhelper. 
}.

a marka: ['item'] samee: { <- iska-leh binhelper.
}.

a item: Bin cusub.

>> old-binhelper-address := a item tusaale-hore cinwaanka-xusuusta.
a save-as: ['/tmp/a.bin'].
Soo-saar qor: ['========== RELOADING SNAP:'], sadar-cusub.

>> b := Walax load-from: ['/tmp/a.bin'].

(b item tusaale-hore cinwaanka-xusuusta = old-binhelper-address) run: {
	Soo-saar qor: ['Object link re-attached.'], sadar-cusub.
}.


