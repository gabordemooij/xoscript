


>> Deck := Liis cusub.
Deck marka: ['print'] samee: {
        >> len := naf tirada-guud - 1.
        { :i
                >> len2 := naf tirada-guud - 1.
                Soo-saar qor: ['len: '].
                Soo-saar qor: len, sadar-cusub.
                Soo-saar qor: ['len2: '].
                Soo-saar qor: len2, sadar-cusub.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
