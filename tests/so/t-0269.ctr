#Linux

(Fayl cusub: ['/tmp/testje']) jira been: {
	Barnaamij nidaam: ['mkdir /tmp/testje'].	
}.

(Fayl cusub: ['/tmp/testje/file1']) jira been: {
	Barnaamij nidaam: ['touch /tmp/testje/file1'].	
}.

(Fayl cusub: ['/tmp/testje/folder1']) jira been: {
	Barnaamij nidaam: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Fayl liis: ['/tmp/testje'].

>> q := Liis cusub.

l mid-kasta: { :k :v v mid-kasta: { :x :y q dhammaadka-ku-dar: y. }. }.

>> s := q qoraal.

(s ku-jira: ['file1']) run:   { Soo-saar qor: ['OK'], sadar-cusub. }.
(s ku-jira: ['file2']) run:   { Soo-saar qor: ['XX'], sadar-cusub. }.
(s ku-jira: ['folder1']) run: { Soo-saar qor: ['OK'], sadar-cusub. }.
