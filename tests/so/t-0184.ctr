

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Barnaamij maamulka-xusuusta: 0.

Tiro marka: ['addNum:'] samee: { :x
	naf ku-dar: x.
}.

Tiro marka: ['subtractNum:'] samee: { :x
	naf ka-jar: x.
}.

Tiro marka: ['multiplyBy:'] samee: { :x
	naf ku-dhufo: x.
}.

Tiro marka: ['divideBy:'] samee: { :x
	naf u-qaybi: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 jibbaar: 8).  
a := a + (2 jibbaar: -1). 
a := a + (49 xididka-laba-jibbaaran).   
a addNum: ((Liis ← 0 ; 1) ugu-weyn).          
a addNum: ((Liis ← 2 ; 3) ugu-yar).
Soo-saar qor: a.

Barnaamij nadiifi.

usedMemory1 := (Barnaamij xusuus ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 jibbaar: 8).  
a := a + (2 jibbaar: -1). 
a := a + (49 xididka-laba-jibbaaran).   
a addNum: ((Liis ← 0 ; 1) ugu-weyn).          
a addNum: ((Liis ← 2 ; 3) ugu-yar).
Soo-saar qor: a.

Barnaamij nadiifi.
usedMemory2 := (Barnaamij xusuus ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 jibbaar: 8).  
a := a + (2 jibbaar: -1). 
a := a + (49 xididka-laba-jibbaaran).   
a addNum: ((Liis ← 0 ; 1) ugu-weyn).          
a addNum: ((Liis ← 2 ; 3) ugu-yar).
Soo-saar qor: a.

Barnaamij nadiifi.
usedMemory3 := (Barnaamij xusuus ? 0).



( usedMemory1 = usedMemory2 iyo: usedMemory1 = usedMemory3, iyo: usedMemory2 = usedMemory3 ) run: {
	Soo-saar qor: ['No memory leaks here'].
}, been: {
	Soo-saar qor: ['Leaking memory...'].
}.
