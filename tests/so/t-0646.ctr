Server init.
Soo-saar qor: ['Database datetime test'], sadar-cusub.

>> db := Maria-DB cusub martigeliye: ['localhost'],
	magaca-isticmaalaha: ['xo'], 
	furaha-sirta: ['pass123'],
	magaca-xogta: ['xobase'],
	ku-xirmo.

>> xuduudaha-raadinta :=
db weydiin: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
soo-qaad: { :row
	Soo-saar qor: row datetimetest, sadar-cusub.
}.
