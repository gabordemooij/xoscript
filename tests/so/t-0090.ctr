Soo-saar qor: ['1,2,3,4,5,6,7,8,9,A,'], sadar-cusub.
>> Scope := Walax cusub.
Scope marka: ['initialize:'] samee: { :x iska-leh property := x. }.
Scope marka: ['confirm'] samee: { Soo-saar qor: [',']. }.
Scope marka: ['tijaabo'] samee: {
	Soo-saar qor: iska-leh property.
	naf confirm.
	( 1 = 1 ) run: { Soo-saar qor: iska-leh property. naf confirm. }.
	( 1 = 0 ) been: { Soo-saar qor: iska-leh property. naf confirm. }.
	>> y := 2. { Soo-saar qor: iska-leh property. naf confirm. } inta: { y ka-jar: 1. <- (y > 0). }.
	{ Soo-saar qor: iska-leh property. naf confirm. } × 1.
	(Liis ← 1) mid-kasta: {  Soo-saar qor: iska-leh property. naf confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Qaamuus cusub one: ['item']) mid-kasta: { Soo-saar qor: iska-leh property. naf confirm. }.
	{ 1 ÷ 0. } qabo: { Soo-saar qor: iska-leh property. naf confirm. }, bilow.
	Soo-saar sadar-cusub.
}.
>> scope1 := Scope cusub.
scope1 initialize: ['X'].
scope1 tijaabo.
