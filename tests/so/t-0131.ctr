
>> a := Liis ← (Liis ← 100 ; 200 ; 300) ; (Liis ← 9 ; 8 ; 7).
Soo-saar qor: ['at 0,1 :'].
Soo-saar qor: a ? 0 ? 1, sadar-cusub. 
Soo-saar qor: ['at 1,2 :'].
Soo-saar qor: a ? 1 ? 2, sadar-cusub. 
>> menu := Qaamuus cusub.
menu dhig: (Liis ← ['pizza'] ; ['spaghetti']) furaha: ['Italian Cuisine'].
menu dhig: (Liis ← ['bifteki'] ; ['suflaki']) furaha: ['Greek Cuisine'].
Soo-saar qor: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), sadar-cusub. 
Soo-saar qor: ['but not on the same plate.'], sadar-cusub.
