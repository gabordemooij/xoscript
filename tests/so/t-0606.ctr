>> Point := Walax cusub.
Point marka: ['x-coordinate:'] samee: { :x iska-leh x := x. }.
Point marka: ['y-coordinate:'] samee: { :y iska-leh y := y. }.
Point marka: ['x-coordinate']  samee: { <- iska-leh x koobiyee. }.
Point marka: ['y-coordinate']  samee: { <- iska-leh y koobiyee. }.

Point marka: ['='] samee: { :other <- ( iska-leh x = other x-coordinate
		 iyo: iska-leh y = other y-coordinate ).
}.

>> pier := Point cusub x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point cusub x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point cusub x-coordinate: 5, y-coordinate: 6.

Soo-saar qor: pier = town-hall, sadar-cusub.
Soo-saar qor: pier = restaurant, sadar-cusub.
