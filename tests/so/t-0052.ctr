>> items := Qaamuus cusub.
items dhig: ['green'] furaha: ['color-1'].
items dhig: ['orange'] furaha: ['color-2'].
items dhig: ['red'] furaha: ['color-3'].
>> i := 0.
>> s := [''].
items mid-kasta: { :key :color
	Soo-saar qor: ['color #'] + i + [' is: '] + color + [' '].
	i ku-dar: 1.
}.
Soo-saar qor: i + [' colors!'].
