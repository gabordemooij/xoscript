#Linux
>> OS := Barnaamij dejin: ['OS'].

>> clock := Xilli cusub.
	
(OS = ['Haiku']) run: {
	clock aag: ['CET'],
	sannad: 2017, bil: 7, maalin: 13,
	saac: 18, daqiiqad: 0, ilbiriqsi: 0.
}, haddii-kale: {
	clock aag: ['Europe/Amsterdam'],
	sannad: 2017, bil: 7, maalin: 13,
	saac: 18, daqiiqad: 0, ilbiriqsi: 0.
}.

clock marka: ['tell'] samee: {
	Soo-saar qor: naf, sadar-cusub.
}.


clock ku-dar: 2    saac, tell.
clock ku-dar: 1    saac, tell.
clock ku-dar: 19 daqiiqad, tell.
clock ku-dar: 1  daqiiqad, tell.
clock ku-dar: 1  daqiiqad, tell.
clock ku-dar: 19 ilbiriqsi, tell.
clock ku-dar: 1  ilbiriqsi, tell.
clock ku-dar: 1  ilbiriqsi, tell.
clock ku-dar: 2    sannad, tell.
clock ku-dar: 1    sannad, tell.

(OS = ['Haiku']) run: {
clock ku-dar: 5   bil.
clock aag: ['CEST'], tell.
}, haddii-kale: {
	clock ku-dar: 5   bil, tell.
}.

clock ku-dar: 1   bil, tell.
clock ku-dar: 19    maalin, tell.
clock ku-dar: 1    saac, tell.
clock ku-dar: 120  yard, tell.
