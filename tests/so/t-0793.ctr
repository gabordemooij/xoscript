Server init.

>> DB := Maria-DB cusub martigeliye: ['localhost'],
	magaca-isticmaalaha: ['xo'],
	furaha-sirta: ['pass123'],
	magaca-xogta: ['xobase'],
	ku-xirmo.

{
	DB weydiin:
	['DROP TABLE movies'],
	fuli.
} qabo: { Waxba. }, bilow.

DB weydiin:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
fuli.

DB weydiin: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
xuduudo: ( Liis cusub ; ['Halloween'] ),
fuli.

DB weydiin: ['SELECT * FROM movies'],
soo-qaad: { :movie
	Soo-saar qor: movie title, sadar-cusub.
}.

