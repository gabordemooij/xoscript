Server init.

>> DB := Maria-DB cusub martigeliye: ['localhost'],
	magaca-isticmaalaha: ['xo'],
	furaha-sirta: ['pass123'],
	magaca-xogta: ['xobase'],
	ku-xirmo.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> xuduudaha-raadinta := Weydiin-Maria cusub: SQL.

# set database
xuduudaha-raadinta xog-ururin: DB.

xuduudaha-raadinta soo-qaad: { :row
	Soo-saar qor: row world, sadar-cusub.
}.
