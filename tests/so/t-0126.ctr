#Linux
>> Slurp := Walax cusub.

Slurp marka: ['cusub'] samee: {
	iska-leh str := [''].
}.

Slurp marka: ['nieuw'] samee: {
	iska-leh str := [''].
}.

Slurp marka: ['jawaab:'] samee: { :blah
		iska-leh str dhammaadka-ku-dar: blah.
}.

Slurp marka: ['jawaab:iyo:'] samee: { :blah :blahah
		iska-leh str dhammaadka-ku-dar: (blah ka: 0 dherer: (blah dherer - 1)).
		iska-leh str dhammaadka-ku-dar: [' '].
		iska-leh str dhammaadka-ku-dar: blahah.
}.

Slurp marka: ['obtain'] samee: {
	>> buffer := iska-leh str.
	iska-leh str := ['']. <- buffer.
}.


Soo-saar qor: (Barnaamij nidaam: (Slurp cusub echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Fayl cusub: ['/tmp/from.txt'], tirtir. } qabo: { ['Empty']. }, bilow.
{ Fayl cusub: ['/tmp/to.txt'], tirtir. } qabo: { ['Empty']. }, bilow.


Fayl cusub: ['/tmp/to.txt'], jira been: {
	Soo-saar qor: ['Confirmed. Target file does not exist.\
'].
}.
Fayl cusub: ['/tmp/from.txt'], jira been: {
	Soo-saar qor: ['Confirmed. Source file does not exist.\
'].
}.



Barnaamij nidaam: (Slurp cusub touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Barnaamij nidaam: (Slurp cusub cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Fayl cusub: ['/tmp/to.txt'], jira run: {
	Soo-saar qor: ['Confirmed. Target file has been created by shell.\
'].
}.


Soo-saar qor: ['Contents of file is:'] + (Fayl cusub: ['/tmp/to.txt'], akhri), sadar-cusub.
