#Linux
>> clock := Xilli cusub.
clock aag: ['UTC-1'].
clock sannad: 1981, bil: 1, maalin: 5,
      saac: 13, daqiiqad: 15, ilbiriqsi: 13.

Soo-saar qor: clock, sadar-cusub.
clock aag: ['UTC+0'].

Soo-saar qor: (
	(clock sannad fudud) + ['-'] + (clock bil) + ['-'] + (clock maalin) + [' '] +
	(clock saac) + [':'] + (clock daqiiqad) + [':'] + (clock ilbiriqsi) + [' '] +
	['W'] + (clock toddobaad) + (clock aag)
), sadar-cusub.


clock aag: ['UTC-1'].
Soo-saar qor: (
	(clock sannad fudud) + ['-'] + (clock bil) + ['-'] + (clock maalin) + [' '] +
	(clock saac) + [':'] + (clock daqiiqad) + [':'] + (clock ilbiriqsi) + [' '] +
	['W'] + (clock toddobaad) + (clock aag)
), sadar-cusub.
