# test list operations


>> cakes := Liis ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes beddel: 1 dherer: 2 ku: ( Liis ← ['cinnamon'] ; ['pineapple'] ).
Soo-saar qor: (buy isku-dar: [',']), sadar-cusub.


>> buy := cakes beddel: 1 dherer: 12 ku: ( Liis ← ['cinnamon'] ; ['pineapple'] ).
Soo-saar qor: (buy isku-dar: [',']), sadar-cusub.


>> buy := cakes beddel: 2 dherer: 10 ku: ( Liis cusub ).
Soo-saar qor: (buy isku-dar: [',']), sadar-cusub.


>> buy := cakes beddel: 0 dherer: 1 ku: ( Liis cusub ).
Soo-saar qor: (buy isku-dar: [',']), sadar-cusub.


>> buy := cakes beddel: ['0'] dherer: ['1'] ku: ['x'].
Soo-saar qor: (buy isku-dar: [',']), sadar-cusub.
