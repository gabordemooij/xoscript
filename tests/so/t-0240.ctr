# test qualifiers

>> $ := Walax cusub.

$ marka: ['jawaab:'] samee: { :x
	
	>> operation := x xaraf: 0.
	>> valuta := x xaraf: 1.
	>> money := x ka-bood: 2.
	
	>> amount := 0.

	( operation = ['+'] ) run: {
		( valuta = ['£'] ) run: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Soo-saar qor: x, sadar-cusub.


>> Fruit := Walax cusub.

Fruit marka: ['cusub'] samee: {
	>> f := naf cusub.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit marka: ['apples:'] samee: { :a iska-leh apples := a. }.
Fruit marka: ['oranges:'] samee: { :p iska-leh oranges := p. }.
Fruit marka: ['apples'] samee: { <- iska-leh apples. }.
Fruit marka: ['oranges'] samee: { <- iska-leh oranges. }.

Fruit marka: ['+'] samee: { :f
	
	>> n := Fruit cusub.
	f ku-dar: 1.
	
	n apples: (f apples + iska-leh apples).
	n oranges:  (f oranges  + iska-leh oranges). <- n.
}.

Fruit marka: ['qoraal'] samee: { <- ( iska-leh apples qoraal + [' apples and '] + iska-leh oranges + [' oranges'] ).
}.

Tiro marka: ['apples'] samee: { <- ((Fruit cusub) apples: naf).
}.

Tiro marka: ['apple'] samee: { <- ((Fruit cusub) apples: naf).
}.

Tiro marka: ['oranges'] samee: { <- ((Fruit cusub) oranges: naf).
}.




Soo-saar qor: (1 apple + 3 oranges + 4 apples), sadar-cusub.


Qoraal marka: ['twice'] samee: { <- ((naf qoraal) + (naf qoraal)).
}.



Soo-saar qor: ['❤❤❤'] twice.



