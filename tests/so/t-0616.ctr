Liis marka: ['koobiyee'] samee: {
	>> koobiyee := Liis cusub.
	naf mid-kasta: { :tiro :section
		koobiyee dhammaadka-ku-dar: section is-wacid koobiyee.
	}. <- koobiyee.
}.

>> sheep := Liis cusub ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep koobiyee.
clones mid-kasta: { :tiro :sheep
	sheep dhammaadka-ku-dar: ['2'].
}.

Soo-saar qor: sheep, sadar-cusub.
Soo-saar qor: clones, sadar-cusub.
