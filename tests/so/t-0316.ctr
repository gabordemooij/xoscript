>> Grandfather := Walax cusub.
Grandfather marka: ['greet'] samee: {
	Soo-saar qor: ['Ave!'], sadar-cusub.
}.
>> Father := Grandfather cusub.
Father marka: ['greet'] samee: {
	Soo-saar qor: ['Hello'], sadar-cusub.
	naf greet.
}.
>> Son := Father cusub.
Son marka: ['greet'] samee: {
	Soo-saar qor: ['Hi'], sadar-cusub.
	naf greet.
}.

Son greet.

>> Roundabout := Walax cusub.
Roundabout marka: ['circle:'] samee: { :x
	Soo-saar qor: x, sadar-cusub.
	(x < 3) run: { naf is-wacid circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) run: { Soo-saar qor: x, sadar-cusub. x ku-dar: 1.  increment bilow. }. }.
increment bilow.