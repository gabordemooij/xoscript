# test url parsing

Server init.
>> url := URL isha: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Soo-saar qor: ['scheme = '] + url qorshe-cinwaan, sadar-cusub.
Soo-saar qor: ['host = '] + url martigeliye, sadar-cusub.
Soo-saar qor: ['port = '] + url deked, sadar-cusub.
Soo-saar qor: ['path = '] + url waddada-faylka, sadar-cusub.
Soo-saar qor: ['query = '] + url xuduudaha-raadinta, sadar-cusub.
Soo-saar qor: ['fragment = '] + url jajab, sadar-cusub.
