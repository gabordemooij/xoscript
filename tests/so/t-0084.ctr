>> makeAdder := { :x
	>> f := { :y <- (iska-leh x + y). } deji: ['x'] qiime: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i iska-leh q dhig: (iska-leh f ku-dabaq: (iska-leh q ? i)) furaha: i. } 
	deji: ['q'] qiime: array,
	deji: ['f'] qiime: func.
	{ :i mapping ku-dabaq: i. } × (array tirada-guud).
}.

>> a := Liis ← 1; 2; 3.
mapper ku-dabaq: a iyo: (makeAdder ku-dabaq: 100).
Soo-saar qor: (a boos: 0), sadar-cusub.
Soo-saar qor: (a ? 1), sadar-cusub.
Soo-saar qor: (a ? 2), sadar-cusub.
