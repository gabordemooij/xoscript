Soo-saar qor: ['Test object'], sadar-cusub.
>> a := Walax cusub. 

a marka: ['item:'] samee: { :num
	iska-leh num := num. 
}.

a marka: ['item'] samee: { <- iska-leh num.
}.

a item: 123.

Soo-saar qor: a item, sadar-cusub.

>> old-num-address := a item tusaale-hore cinwaanka-xusuusta.
a save-as: ['/tmp/a.bin'].
Soo-saar qor: ['========== RELOADING SNAP:'], sadar-cusub.

>> b := Walax load-from: ['/tmp/a.bin'].

(b item tusaale-hore cinwaanka-xusuusta = old-num-address) run: {
	Soo-saar qor: ['Object link re-attached.'], sadar-cusub.
}.

Soo-saar qor: b item, sadar-cusub.
