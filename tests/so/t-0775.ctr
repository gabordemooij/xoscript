Soo-saar qor: ['Test object'], sadar-cusub.
>> l := Liis cusub ; 1 ; ( Liis cusub ; (Xilli cusub: 1) ; (Int64 qoraal-ka: ['321']) ; (Liis cusub ; 3)).
Soo-saar qor: l, sadar-cusub.
>> old-lst-address := l tusaale-hore cinwaanka-xusuusta.
l save-as: ['/tmp/a.bin'].
Soo-saar qor: ['========== RELOADING SNAP:'], sadar-cusub.
>> b := Walax load-from: ['/tmp/a.bin'].
(b tusaale-hore cinwaanka-xusuusta = old-lst-address) run: {
	Soo-saar qor: ['Object link re-attached.'], sadar-cusub.
}.
Soo-saar qor: b, sadar-cusub.
