

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Barnaamij maamulka-xusuusta: 0.

>> txt := ['Word Salad'].
Soo-saar qor: ['Text Length: '] + txt dherer, sadar-cusub.
Soo-saar qor: ['Character at 2:'] + ( txt xaraf: 2 ), sadar-cusub.
Soo-saar qor: (( txt hel: ['S'] ) - 0), sadar-cusub.

Barnaamij nadiifi.

usedMemory1 := (Barnaamij xusuus ? 0).


txt := ['Word Salad'].
Soo-saar qor: ['Text Length: '] + txt dherer, sadar-cusub.
Soo-saar qor: ['Character at 2:'] + ( txt xaraf: 2 ), sadar-cusub.
Soo-saar qor: (( txt hel: ['S'] ) - 0), sadar-cusub.

Barnaamij nadiifi.
usedMemory2 := (Barnaamij xusuus ? 0).


txt := ['Word Salad'].
Soo-saar qor: ['Text Length: '] + txt dherer, sadar-cusub.
Soo-saar qor: ['Character at 2:'] + ( txt xaraf: 2 ), sadar-cusub.
Soo-saar qor: (( txt hel: ['S'] ) - 0), sadar-cusub.

Barnaamij nadiifi.
usedMemory3 := (Barnaamij xusuus ? 0).



( usedMemory1 = usedMemory2 iyo: usedMemory1 = usedMemory3, iyo: usedMemory2 = usedMemory3 ) run: {
	Soo-saar qor: ['No memory leaks here'].
}, been: {
	Soo-saar qor: ['Leaking memory...'].
}.
