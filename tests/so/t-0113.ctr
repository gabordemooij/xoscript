Soo-saar qor: ['Continue for-loop, No - before 6 and up.'], sadar-cusub.
{ :i
	Soo-saar qor: (i + 1), sadar-cusub.
	((i + 1) > 4) sii-wad.
	Soo-saar qor: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Soo-saar sadar-cusub.
Soo-saar qor: ['Continue while-true, No --> before 5 and up.'], sadar-cusub.
{
	Soo-saar qor: ['iteration #'] + x, sadar-cusub.
	x ku-dar: 1.
	((x < 5) lid) sii-wad.
	Soo-saar qor: ['-->'].
} inta: xIsLessThan10.
Soo-saar sadar-cusub.
Soo-saar qor: ['Continue while-false, No - before 3 only.'], sadar-cusub.
{
	Soo-saar qor: ['iteration #'] + x, sadar-cusub.
	x ka-jar: 1.
	(x = 3) sii-wad.
	Soo-saar qor: ['-'].
} inta: { <- ( x > 0). }.

Soo-saar sadar-cusub.
Soo-saar qor: ['Continue times-loop, No ||| before 3.'], sadar-cusub.
{ :i
	Soo-saar qor: ['iteration #'] + i, sadar-cusub.
	(i = 2) sii-wad.
	Soo-saar qor: ['|||'].
} × 5.

Soo-saar sadar-cusub.

{ Run sii-wad. Soo-saar qor: ['dont write this!'], sadar-cusub. } bilow.

{ Run sii-wad. Soo-saar qor: ['dont write this!'], sadar-cusub. } qabo: { Soo-saar qor: ['Dont catch this!']. }, bilow.

Soo-saar qor: ['Test Array each-loop: 0, ... ,2'], sadar-cusub.
(Liis ← 1 ; 2 ; 3) beddel-mid-kasta: { :i
	(i = 1) sii-wad.
	Soo-saar qor: ['iteration #'] + (i - 0), sadar-cusub.
}.

Soo-saar qor: ['Test Map each-loop: c only'], sadar-cusub.
>> m := Qaamuus cusub.
m dhig: ['first'] furaha: ['a'], dhig: ['second'] furaha: ['b'], dhig: ['third'] furaha: ['c'].
m mid-kasta: { :k :v
	(k ≠ ['c']) sii-wad.
	Soo-saar qor: ['iteration'] + k + v, sadar-cusub.
}.

