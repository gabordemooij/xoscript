



>> CoffeeGrounds := Walax cusub.
CoffeeGrounds marka: ['extract'] samee: { <- ['coffee']. }.

>> CoffeeMachine := Walax cusub.
CoffeeMachine marka: ['init'] samee: {
	iska-leh coffeegrounds := CoffeeGrounds cusub.
}.
CoffeeMachine marka: ['cusub'] samee: { <- CoffeeMachine `new init.
}.

CoffeeMachine marka: ['makeTea'] samee: { <- (iska-leh tealeaves extract). }.
CoffeeMachine marka: ['makeCoffee'] samee: { <- (iska-leh coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine cusub.

Soo-saar qor:
	coffeeDream 
	makeCoffee.

Soo-saar qor:
	coffeeDream 
	makeTea.
