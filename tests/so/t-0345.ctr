# test catch-all methods
>> x13 := Walax cusub.
x13 marka: ['a'] samee: { :a Soo-saar qor: 0, sadar-cusub. }.
x13 marka: ['a:'] samee: { :a Soo-saar qor: a, sadar-cusub. <- 5. }.
x13 marka: ['a:b:'] samee: { :a :b Soo-saar qor: (a + b), sadar-cusub. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
