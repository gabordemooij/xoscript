

Qoraal marka: ['evaluate'] samee: {
	>> koodh := Fayl cusub: ['/tmp/eval.ctr'].
	koodh qor: (naf qoraal + ['.']).
	Barnaamij isticmaal: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Liis ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q qoraal.
Soo-saar qor: x, sadar-cusub.
>> y := Waxba.
(['y := '] + x ) evaluate.
Soo-saar qor: y ? 0, sadar-cusub.

q := Qaamuus dhig: ['\[''] furaha: ['\['quote\']'].
x := q qoraal.
Soo-saar qor: x, sadar-cusub.
y := Waxba.
(['y := '] + x ) evaluate.

>> q := (Qaamuus cusub) dhig:['\[''] furaha:['\['quote\[''].
Soo-saar qor: y ? ['\['quote\']'], sadar-cusub.
