(2 < 9) run: { Soo-saar qor: ['Yes, nine is less than ten.']. }.
(9 < 2) run: { Soo-saar qor: ['My logic fails']. }.
Soo-saar qor: (-2 + 6).
Soo-saar qor: (-3 - -3).
>> TrueIsNice := 3.
Soo-saar qor: TrueIsNice.
>> FalseIsBad := ['Not true!'].
Soo-saar qor: FalseIsBad.
>> NilIsEmpty := ['Yep'].
Soo-saar qor: NilIsEmpty.
