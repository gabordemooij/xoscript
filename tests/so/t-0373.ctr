# compliance test

# use international numbers

Soo-saar qor: ['1000 -> '].
Soo-saar qor: 1000, sadar-cusub. #1000

Soo-saar qor: ['1.5 -> '].
Soo-saar qor: 1.5, sadar-cusub.  #1.5

Soo-saar qor: ['1001.5 -> '].
Soo-saar qor: 1.5 + 1000, sadar-cusub. #1001.5

# use 0-indexed arrays
>> x := Liis cusub ; 1 ; 2 ; 3.
>> y := Liis cusub ; ['a'] ; ['b'] ; ['c'].

Soo-saar qor: ['1 -> '].
Soo-saar qor: x ? 0, sadar-cusub. #1

Soo-saar qor: ['1 -> '].
Soo-saar qor: (x meesha: 0), sadar-cusub. #1

Soo-saar qor: ['1 -> '].
Soo-saar qor: x ugu-horreeya, sadar-cusub. #1

Soo-saar qor: ['3 -> '].
Soo-saar qor: x ugu-dambeeya, sadar-cusub. #3

Soo-saar qor: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Soo-saar qor: (x sida: y), sadar-cusub.

Soo-saar qor: ['1 -> '].
Soo-saar qor: (x ka: 0 dherer: 1) ugu-horreeya, sadar-cusub. #1

Soo-saar qor: ['0 -> '].
Soo-saar qor: (x hel: 1), sadar-cusub. #0

x dhig: 9 furaha: 0.

Soo-saar qor: ['9 -> '].
Soo-saar qor: (x meesha: 0), sadar-cusub. #9

x bilowga-ku-dar: 8.
Soo-saar qor: ['8 -> '].
Soo-saar qor: (x meesha: 0), sadar-cusub. #9


x dhammaadka-ku-dar: 10.
Soo-saar qor: ['10 -> '].
Soo-saar qor: (x meesha: 4), sadar-cusub. #10








