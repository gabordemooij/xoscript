
Qoraal marka: ['evaluate'] samee: {
	>> koodh := Fayl cusub: ['/tmp/eval.ctr'].
	koodh qor: (naf qoraal + ['.']).
	Barnaamij isticmaal: ['/tmp/eval.ctr'].
}.

>> map :=
	(Qaamuus cusub)
	dhig: ['Hi There'] furaha: ['two'],
	dhig: (Liis ← ['hello'] ; ['world'] ; (Liis ← 1 ; 2; 9) ; Been) furaha: ['one'],
	dhig: ( (Qaamuus cusub) dhig: ['wrrld'] furaha: ['misspelled'] ) furaha: ['three'],
	dhig: (Liis ← ((Qaamuus cusub) dhig: ['treasure'] furaha: ['hidden']) ; 2) furaha: ['four']. 
>> str := map qoraal.
>> map2 := Waxba.
(['map2 := '] + str ) evaluate.
Soo-saar qor: map2 ? ['one'] ? 0.
Soo-saar qor: map2 ? ['one'] ? 1.
Soo-saar qor: map2 ? ['four'] ? 0 ? ['hidden'].
Soo-saar qor: map2 ? ['one'] ? 2 ? 2.
