# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Barnaamij shell-escape: ['abc'].
Soo-saar qor: c, sadar-cusub.
Soo-saar qor: ( Barnaamij nidaam: ['echo '] + c ), sadar-cusub.

c := Barnaamij shell-escape: ['a'b'c'].
Soo-saar qor: c, sadar-cusub.
Soo-saar qor: ( Barnaamij nidaam: ['echo '] + c ), sadar-cusub.

c := Barnaamij shell-escape: ['a\'c'].
Soo-saar qor: c, sadar-cusub.
Soo-saar qor: ( Barnaamij nidaam: ['echo '] + c ), sadar-cusub.