>> phrases := Liis cusub
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases mid-kasta: { :_ :phrase 
	>> e := Server base64-koodee: phrase.
	>> d := Server base64-koodh-fur: e.
	Soo-saar qor: (
		message koobiyee ~encoded: e, ~decoded: d
	), sadar-cusub.
}.
