

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Barnaamij maamulka-xusuusta: 0.

{ :i Soo-saar qor: i. } × 4.
Soo-saar sadar-cusub.
{ :i Soo-saar qor: (4 - i). } × 4.
Soo-saar sadar-cusub.
( 1 > 2 ) been: { Soo-saar qor: ['BLOCK 1'], sadar-cusub. }.
( 2 > 1 ) run:  { Soo-saar qor: ['BLOCK 2'], sadar-cusub. }.

>> i := 0.
{ Soo-saar qor: i. i ku-dar: 1. } inta: { <- ( i < 3). }.
Soo-saar sadar-cusub.

i := 3.
{ Soo-saar qor: i. i := i - 1. } inta: { <- ( i > 0). }.
Soo-saar sadar-cusub.


Barnaamij nadiifi.

usedMemory1 := (Barnaamij xusuus ? 0).


{ :i  Soo-saar qor: i. } × 4.
Soo-saar sadar-cusub.
{ :i  Soo-saar qor: (4 - i). } × 4.
Soo-saar sadar-cusub.
( 1 > 2 ) been: { Soo-saar qor: ['BLOCK 1'], sadar-cusub. }.
( 2 > 1 ) run:  { Soo-saar qor: ['BLOCK 2'], sadar-cusub. }.

>> i := 0.
{ Soo-saar qor: i. i ku-dar: 1. } inta: { <- ( i < 3). }.
Soo-saar sadar-cusub.

i := 3.
{ Soo-saar qor: i. i := i - 1. } inta: { <- ( i > 0). }.
Soo-saar sadar-cusub.



Barnaamij nadiifi.
usedMemory2 := (Barnaamij xusuus ? 0).


{ :i Soo-saar qor: i. } × 4.
