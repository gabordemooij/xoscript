>> x := Waxba.
Soo-saar qor: x koodh walax nooc, sadar-cusub.
Soo-saar qor: x koodh walax qoraal, sadar-cusub.

>> x := Run.
Soo-saar qor: x koodh walax nooc, sadar-cusub.
Soo-saar qor: x koodh walax qoraal, sadar-cusub.

>> x := Been.
Soo-saar qor: x koodh walax nooc, sadar-cusub.
Soo-saar qor: x koodh walax qoraal, sadar-cusub.

>> x := 1.
Soo-saar qor: x koodh walax nooc, sadar-cusub.
Soo-saar qor: x koodh walax qoraal, sadar-cusub.

>> x := -3.
Soo-saar qor: x koodh walax nooc, sadar-cusub.
Soo-saar qor: x koodh walax qoraal, sadar-cusub.

>> x := 9.2.
Soo-saar qor: x koodh walax nooc, sadar-cusub.
Soo-saar qor: x koodh walax qoraal, sadar-cusub.

>> x := -9.2.
Soo-saar qor: x koodh walax nooc, sadar-cusub.
Soo-saar qor: x koodh walax qoraal, sadar-cusub.

>> x := Liis cusub.
Soo-saar qor: x koodh walax nooc, sadar-cusub.
Soo-saar qor: x koodh walax qoraal, sadar-cusub.

>> x := Liis ← 1 ; 2.
Soo-saar qor: x koodh walax nooc, sadar-cusub.
Soo-saar qor: x koodh walax qoraal, sadar-cusub.

>> x := Liis ← 1 ; (Liis ← 2).
Soo-saar qor: x koodh walax nooc, sadar-cusub.
Soo-saar qor: x koodh walax qoraal, sadar-cusub.

>> x := Liis ← 1 ; (Liis ← 2) ; 3.
Soo-saar qor: x koodh walax nooc, sadar-cusub.
Soo-saar qor: x koodh walax qoraal, sadar-cusub.

>> x := Liis ← 1 ; ((Qaamuus cusub) dhig:['a'] furaha:['b']) ; 3.
Soo-saar qor: x koodh walax nooc, sadar-cusub.
Soo-saar qor: x koodh walax qoraal, sadar-cusub.

>> x := Liis ← 1 ; ((Qaamuus cusub) dhig:(Liis ← 9) furaha:['b']) ; 3.
Soo-saar qor: x koodh walax nooc, sadar-cusub.
Soo-saar qor: x koodh walax qoraal, sadar-cusub.

>> x := (Qaamuus cusub) dhig:2 furaha:['1'].
Soo-saar qor: x koodh walax nooc, sadar-cusub.
Soo-saar qor: x koodh walax qoraal, sadar-cusub.

>> x := (Qaamuus cusub) dhig:2 furaha:['x'].
Soo-saar qor: x koodh walax nooc, sadar-cusub.
Soo-saar qor: x koodh walax qoraal, sadar-cusub.

>> x := (Qaamuus cusub) dhig:(Liis ← 1 ; 2) furaha:['x'].
Soo-saar qor: x koodh walax nooc, sadar-cusub.
Soo-saar qor: x koodh walax qoraal, sadar-cusub.

>> x := (Qaamuus cusub) dhig:(Liis ← ((Qaamuus cusub) dhig:['q'] furaha:['y']) ; 2) furaha:['x'].
Soo-saar qor: x koodh walax nooc, sadar-cusub.
Soo-saar qor: x koodh walax qoraal, sadar-cusub.

Soo-saar qor: ['2 + 3'] walax, sadar-cusub.
Soo-saar qor: ['2 + 3'] walax nooc, sadar-cusub.




