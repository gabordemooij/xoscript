
Soo-saar qor: ['Break for-loop, 0-4.'], sadar-cusub.
{ :i
	Soo-saar qor: ['iteration #'] + i, sadar-cusub.
	(i = 4) jooji-wareegga.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Soo-saar qor: ['Break while-true loop, 0-4.'], sadar-cusub.
{
	Soo-saar qor: ['iteration #'] + x, sadar-cusub.
	x ku-dar: 1.
	((x < 5) lid) jooji-wareegga.
} inta: xIsLessThan10.

Soo-saar qor: ['Break while-false loop, 5,4.'], sadar-cusub.
{
	Soo-saar qor: ['iteration #'] + x, sadar-cusub.
	x ka-jar: 1.
	(x = 3) jooji-wareegga.
} inta: { <- (x > 0). }.

Soo-saar qor: ['Break times loop, 1-4.'], sadar-cusub.
{ :i
	Soo-saar qor: ['iteration #'] + i, sadar-cusub.
	(i = 4) jooji-wareegga.
} × 5.

Soo-saar qor: ['Break block, dont print line.'], sadar-cusub.
{ Run jooji-wareegga. Soo-saar qor: ['dont write this!'], sadar-cusub. } bilow.

Soo-saar qor: ['Break block, dont fire catch...'], sadar-cusub.
{ Run jooji-wareegga. Soo-saar qor: ['dont write this!'], sadar-cusub. } qabo: { Soo-saar qor: ['Dont catch this!']. }, bilow.

Soo-saar qor: ['Test Array each-loop: 0,1'], sadar-cusub.
(Liis ← 1 ; 2 ; 3) beddel-mid-kasta: { :i
	Soo-saar qor: ['iteration #'] + i, sadar-cusub.
	(i = 1) jooji-wareegga.
}.

Soo-saar qor: ['Test Map each-loop: c only'], sadar-cusub.
>> m := Qaamuus cusub.
m dhig: ['first'] furaha: ['a'], dhig: ['second'] furaha: ['b'], dhig: ['third'] furaha: ['c'].
m mid-kasta: { :k :v
	Soo-saar qor: ['iteration'] + v + k, sadar-cusub.
	Run jooji-wareegga.
}.

