Server init.
>> f := Qaab cusub: ['%d'].
>> a := Blob cusub: 4.
a bytes: ( Liis cusub ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob cusub: 4.
b bytes: ( Liis cusub ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a ka: 0 dherer: 3, mid-kasta: { :i :byte
	Soo-saar qor: ( f ku-dabaq-tiro-dhan: byte ), sadar-cusub.
}.
a ^ b.
a ka: 0 dherer: 3, mid-kasta: { :i :byte
	Soo-saar qor: ( f ku-dabaq-tiro-dhan: byte ), sadar-cusub.
}.
a ^ b.
a ka: 0 dherer: 3, mid-kasta: { :i :byte
	Soo-saar qor: ( f ku-dabaq-tiro-dhan: byte ), sadar-cusub.
}.
a sii-daa.
b sii-daa.

{ a ^ Walax. } qabo: { :e Soo-saar qor: e, sadar-cusub. }, bilow.
