Soo-saar qor: ['Test object'], sadar-cusub.
>> greeter := Walax cusub.
greeter marka: ['name:'] samee: { :magac
	iska-leh xname := magac. 
}.
greeter marka: ['greet'] samee: {
	Soo-saar qor: ['Hello '] + iska-leh xname, sadar-cusub.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Soo-saar qor: ['========== RELOADING SNAP:'], sadar-cusub.
>> b := Walax load-from: ['/tmp/a.bin'].
>> c := Walax load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
