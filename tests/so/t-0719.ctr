Server init.
>> fmt := Qaab cusub: ['%#3x'].

>> blob := Blob cusub: 4.
blob bytes: ( 
	Liis cusub ; 0 ; 1 ; 2 ; 3
).

>> file := Fayl cusub: ['/tmp/blob'].
file blob: blob.
blob sii-daa.

>> akhri := file blob.
akhri 
ka: 0 
dherer: 4, 
samee mid-kasta: { :i :b 
	Soo-saar
	qor: (fmt ku-dabaq-tiro-dhan: b),
	sadar-cusub.
}.
akhri sii-daa.
