

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Barnaamij maamulka-xusuusta: 0.

>> txt := ['Word Salad'].
Soo-saar qor: ['last index of ord = '] + (( txt booska-ugu-dambeeya: ['ord'] ) - 0), sadar-cusub.
Soo-saar qor: ['index of ord = '] + (( txt hel: ['ord'] ) - 0), sadar-cusub.
Soo-saar qor: ['index of ad = '] + (( txt hel: ['ad'] ) - 0), sadar-cusub.
