>> a := Liis ← Walax ; Run ; Been ; Buuliyaan ; 1 ; Tiro ; ['Str'] ; Qoraal ; { ['Empty']. }.
Soo-saar qor: (a tirada-guud), sadar-cusub.
{ :i
	Soo-saar qor: 
	['a '] + 
	((a ? i) nooc) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Waxba?) kan: [''] ama-kaas: ['NOT']) + 
	[' Nil.'],
	sadar-cusub.
} × (a tirada-guud).
Soo-saar qor: ['but.. Nil is.. '] + ((Waxba Waxba?) kan: ['certainly NIL!'] ama-kaas: ['not NIL??']), sadar-cusub.