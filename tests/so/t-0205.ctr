>> str := ['write:'].
Soo-saar farriin: ['qor:'] dooddo: (Liis ← ['Hello World']), sadar-cusub. 

Tiro marka: ['isbetween:and:'] samee: { :a :b <- ((naf ≥ a) iyo: (naf ≤ b)).
}.

str := ['isbetween:and:'].
Soo-saar qor: (3 farriin: str dooddo: (Liis ← 2 ; 8)), sadar-cusub.
Soo-saar qor: (3 farriin: str dooddo: (Liis ← 1 ; 2)), sadar-cusub.


>> CoffeeMachine := Walax cusub.
CoffeeMachine marka: ['makeCoffeeWithSugar:milk:'] samee: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Liis ← 4 ; 2.
Soo-saar qor: ( CoffeeMachine farriin: order dooddo: coffeeConfiguration ), sadar-cusub.
