

Liis marka: ['sum'] samee: {
	>> total := 0.
	naf mid-kasta: { :index :element
		total ku-dar: element.
	}. <- total.
}.

Liis marka: ['product'] samee: {
	>> total := 1.
	naf mid-kasta: { :index :element
		total ku-dhufo: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Barnaamij maamulka-xusuusta: 0.

{

>> a := Liis ← ['hello'] ; ['world'] ; Run ; Waxba ; 666.
a := a + ( Liis ← 1 ).
Soo-saar qor: ( ['sum: '] + ( a sum ) ), sadar-cusub.
Soo-saar qor: ( ['min: '] + ( a ugu-yar ) ), sadar-cusub.
Soo-saar qor: ( ['max: '] + ( a ugu-weyn ) ), sadar-cusub.
Soo-saar qor: ( ['3rd: '] + ( a ? 2 ) ), sadar-cusub.
Soo-saar qor: ( ['prd: '] + ( a product ) ), sadar-cusub.
a kala-sooc: { :a :b <- (b - a). }.
a mid-kasta: { :i :e Soo-saar qor: ( i - 0 ), sadar-cusub. }.

} bilow.

Barnaamij nadiifi.
usedMemory1 := (Barnaamij xusuus ? 0).


{

>> a := Liis ← ['hello'] ; ['world'] ; Run ; Waxba ; 666.
a := a + ( Liis ← 1 ).
Soo-saar qor: ( ['sum: '] + ( a sum ) ), sadar-cusub.
Soo-saar qor: ( ['min: '] + ( a ugu-yar ) ), sadar-cusub.
Soo-saar qor: ( ['max: '] + ( a ugu-weyn ) ), sadar-cusub.
Soo-saar qor: ( ['3rd: '] + ( a ? 2 ) ), sadar-cusub.
Soo-saar qor: ( ['prd: '] + ( a product ) ), sadar-cusub.
a kala-sooc: { :a :b <- (b - a). }.
a mid-kasta: { :i :e Soo-saar qor: ( i - 0 ), sadar-cusub. }.

} bilow.



Barnaamij nadiifi.
usedMemory2 := (Barnaamij xusuus ? 0).


{

>> a := Liis ← ['hello'] ; ['world'] ; Run ; Waxba ; 666.
a := a + ( Liis ← 1 ).
Soo-saar qor: ( ['sum: '] + ( a sum ) ), sadar-cusub.
Soo-saar qor: ( ['min: '] + ( a ugu-yar ) ), sadar-cusub.
Soo-saar qor: ( ['max: '] + ( a ugu-weyn ) ), sadar-cusub.
Soo-saar qor: ( ['3rd: '] + ( a ? 2 ) ), sadar-cusub.
Soo-saar qor: ( ['prd: '] + ( a product ) ), sadar-cusub.
a kala-sooc: { :a :b <- (b - a). }.
a mid-kasta: { :i :e Soo-saar qor: ( i - 0 ), sadar-cusub. }.

} bilow.



Barnaamij nadiifi.
usedMemory3 := (Barnaamij xusuus ? 0).

( usedMemory1 = usedMemory2 iyo: usedMemory1 = usedMemory3, iyo: usedMemory2 = usedMemory3 ) run: {
	Soo-saar qor: ['No memory leaks here'].
}, been: {
	Soo-saar qor: ['Leaking memory...'].
}.
