Barnaamij maamulka-xusuusta: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } qabo: {
		oops ku-dar: 1.
	}, bilow.
} × 1000.

{
	Soo-saar qor: ['hi there!'].
	hawshan qalad: ['oops'].
	Soo-saar qor: ['hi there!'].
	{ Soo-saar qor: ['dont print this']. } bilow.
} qabo: { :e 
	Soo-saar qor: ['got ya!']. 
	Soo-saar qor: e.
}, bilow.
