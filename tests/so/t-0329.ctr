Soo-saar qor: ((Liis cusub
	marka: ['plaque:'] samee: { :x iska-leh o := x. },
	marka: ['plaque']  samee: { <- iska-leh o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Liis ← 1)
	~ (Liis ← 1 ; 2)
	~ (Liis ← 1 ; 2 ; 3)
	~ (Liis ← 1 ; 2 ; 3 ; 4)
	~ (Liis ← 1 ; 2 ; 3 ; 4 ; 5)
) mid-kasta: { :i :el
	{ Soo-saar qor: hawshan. } × el tirada-guud.
	Soo-saar sadar-cusub.
}) plaque, sadar-cusub.


