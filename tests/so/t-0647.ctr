Server init.
Soo-saar qor: ['Database time test'], sadar-cusub.

>> db := Maria-DB cusub martigeliye: ['localhost'],
	magaca-isticmaalaha: ['xo'], 
	furaha-sirta: ['pass123'],
	magaca-xogta: ['xobase'],
	ku-xirmo.

>> xuduudaha-raadinta :=
db weydiin: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
soo-qaad: { :row
	Soo-saar qor: row timetest, sadar-cusub.
}.
