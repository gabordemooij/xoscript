>> map1 := Qaamuus cusub.
>> key1 := Liis cusub.
>> key2 := Liis cusub.

map1
	dhig: ['hello'] furaha: key1,
	dhig: ['world'] furaha: key2.


Soo-saar
	qor: ['Map #1 contains: '] + (map1 meesha: key1),
	qor: [' and '] + (map1 meesha: key2), sadar-cusub.

>> KeyeableArray := Liis cusub.
KeyeableArray marka: ['toString'] samee: { <- (naf tirada-guud) toString.
}.

>> map2 := Qaamuus cusub.
key1 := KeyeableArray cusub.
key2 := KeyeableArray cusub.

key1 dhammaadka-ku-dar: 1.

map2
	dhig: ['hello'] furaha: key1,
	dhig: ['world'] furaha: key2.

Soo-saar
	qor: ['Map #2 contains: '] + (map2 meesha: key1),
	qor: [' and '] + (map2 meesha: key2), sadar-cusub.
