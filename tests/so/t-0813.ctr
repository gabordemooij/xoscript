# line breaks in values must not create extra headers
Server diyaari.
Barnaamij isticmaal: ['../../../src/xo/so/webtools.xo'].
Barnaamij isticmaal: ['../../../src/xo/so/mailtools.xo'].

>> madax := Madax-HTTP cusub fure: ['Location'] qiime: ['/ok\r\nX-Injected: yes'].
Soo-saar qor: madax.

>> web := Dukumeenti-Web cusub.
web u-gudub: ['/ok\r\nX-Injected: yes'].
Soo-saar qor: ['\n'], sadar-cusub.

>> mail := Iimayl cusub.
mail loo-diro: (Liis cusub ; ['a@example.invalid\r\nX-To: yes']).
mail cc: (Liis cusub ; ['b@example.invalid\r\nX-Cc: yes']).
mail bcc: (Liis cusub ; ['c@example.invalid\r\nX-Bcc: yes']).
mail diraha: ['d@example.invalid\r\nX-From: yes'] magac: ['site\r\nX-Name: yes'].
mail mawduuc: ['hello\r\nX-Subject: yes'].
mail jirka: ['line1\r\nline2'].
Soo-saar qor: mail abuur.

>> html := Iimayl-HTML cusub.
html loo-diro: (Liis cusub ; ['a@example.invalid\r\nX-To: yes']).
html diraha: ['d@example.invalid'] magac: ['site'].
html mawduuc: ['hello\r\nX-Subject: yes'].
html jirka: ['body'].
Soo-saar qor: ( html abuur ku-jira: ['\nX-'] ), sadar-cusub.
Soo-saar qor: ( html abuur ku-jira: ['X-To: yes'] ), sadar-cusub.
