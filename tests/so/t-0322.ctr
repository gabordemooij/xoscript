

>> Matryoshka := Walax cusub.
Matryoshka marka: ['double:'] samee: { :secret
	iska-leh secret := secret × 2.
}.
Matryoshka marka: ['cusub:'] samee: { :secret
	>> answer := Waxba.
	>> t := (secret > 255).
	Soo-saar qor: (secret + [' | '] + t), sadar-cusub.
	t run: {
		answer := secret.
	}, haddii-kale: {
		answer := Matryoshka is-wacid cusub: (naf double: secret).
	}. <- answer.
}.

>> x := Matryoshka cusub: 2.
