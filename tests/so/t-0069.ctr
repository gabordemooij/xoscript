

Qoraal marka: ['html'] samee: { <- (
		naf
		beddel: ['&'] ku: ['&amp;'],
		beddel: ['<'] ku: ['&lt;'],
		beddel: ['>'] ku: ['&gt;'],
		beddel: ['"'] ku: ['&quot;']
	).
}.


Soo-saar qor: ([' left trimmed '] jar-bannaanka) + [' '] + ( ['and right trimmed'] jar-bannaanka) + ['!'], sadar-cusub.
Soo-saar qor: ['<html>"html & entities"</html>'] html.
