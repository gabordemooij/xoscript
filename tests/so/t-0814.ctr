# session cookie format, json content type, web protocols only, svg shown inline
Server diyaari.
Barnaamij isticmaal: ['../../../src/xo/so/webtools.xo'].

>> Fake-Request := Walax cusub.
Fake-Request marka: ['value:'] samee: { :qiime
	iska-leh qiime := qiime.
}.
Fake-Request marka: ['cookie:'] samee: { :magac <- iska-leh qiime.
}.

>> Test-Session := Fadhi-fayl-ku-meel-gaar cusub.
Test-Session marka: ['soo-rar'] samee: { <- Qaamuus cusub.
}.
Test-Session marka: ['session-id'] samee: { <- iska-leh id.
}.

>> cookies := Liis cusub
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

cookies mid-kasta: { :i :cookie
	>> codsi-http := Fake-Request cusub.
	codsi-http value: cookie.
	>> maamule := Test-Session cusub.
	>> web := Dukumeenti-Web cusub.
	web codsi-http: codsi-http.
	web maamulaha-fadhiyada: maamule.
	web bilow-fadhi.
	Soo-saar qor: ( maamule session-id = cookie ), sadar-cusub.
}.

>> web := Dukumeenti-Web cusub.
web json: (Qaamuus cusub dhig: ['b'] furaha: ['a']).
Soo-saar qor: ['\n'], sadar-cusub.

{ Shabakad get: ['file:///etc/hostname']. } qabo: { :e
	Soo-saar qor: e, sadar-cusub.
}, bilow.

>> svg := Fayl cusub: ['/tmp/test0814.svg'].
svg qor: ['<svg xmlns="x"></svg>'].
Soo-saar sadar-cusub.
Server gudbi: ['test0814.svg'] horgale: ['/tmp/'].
svg tirtir.
