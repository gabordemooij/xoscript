
>> shop := (Qaamuus cusub
	dhig: ['magazine'] furaha: ['books'],
	dhig: ['computer'] furaha: ['electronics'],
	dhig: ['lipstick'] furaha: ['cosmetics']
).
Soo-saar qor: (shop leeyahay: ['computer']), sadar-cusub. 
Soo-saar qor: (shop leeyahay: ['sausage']), sadar-cusub. 
Soo-saar qor: (shop leeyahay: ['computers']), sadar-cusub. 
Soo-saar qor: (shop leeyahay: ['compute']), sadar-cusub. 
Soo-saar qor: (shop leeyahay: ['2computer']), sadar-cusub. 
