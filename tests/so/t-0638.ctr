
Server init.
>> rq := Codsi-HTTP cusub.
Soo-saar qor: ['HTTP-GET d[]=']  + ( rq get-liis: ['d[]'] ), sadar-cusub. # GET
Soo-saar qor: ['HTTP-GET f[]=']  + ( rq get-liis: ['f[]'] ), sadar-cusub. # GET
Soo-saar qor: ['HTTP-POST e[]='] + ( rq post-liis: ['e[]'] ), sadar-cusub. # GET
Soo-saar qor: ['HTTP-POST c=']   + ( rq post: ['c'] ), sadar-cusub. # GET
Soo-saar qor: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), sadar-cusub. # GET
