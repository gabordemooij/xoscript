60 × {
	>> x := (Tiro random % 6) + 1.
	(x ≤ 6) been: { Soo-saar qor: ['FAIL']. }.
	(x ≥0) been: { Soo-saar qor: ['FAIL']. }.
	x := (Tiro random % 3) + 1.
	(x < 3) been: { Soo-saar qor: ['FAIL']. }.
	(x>-1) been: { Soo-saar qor: ['FAIL']. }.
	x := ((Buuliyaan flip) tiro).
	(x = 0 ama: x = 1) been: { Soo-saar qor: ['FAIL']. }.
	x := ((Run flip) tiro).
	(x = 0 ama: x = 1) been: { Soo-saar qor: ['FAIL']. }.
	x := (Buuliyaan flip kan: ['HEAD'] ama-kaas: ['TAIL']).
	((x = ['HEAD']) ama: (x = ['TAIL'])) been: { Soo-saar qor: ['FAIL']. }.
}.
Soo-saar qor: ['DONE'].

