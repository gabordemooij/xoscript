#OBSD
>> dirname := [''].
{ dirname dhammaadka-ku-dar: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Barnaamij nidaam: command.
Barnaamij chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename dhammaadka-ku-dar: ['YYYYYYYY']. } * 20.
Fayl cusub: filename, qor: ['sometext'].
{ Fayl liis: ['/tmp/'] + dirname. } * 1000.
Soo-saar qor: ['no crash'], sadar-cusub.

