>> a := Walax cusub. 
a marka: ['greet'] samee: { Soo-saar qor: ['welcome!'], sadar-cusub. }.
a marka: ['greet2'] samee: { Soo-saar qor: ['welcome2!'], sadar-cusub. }.
a save-as: ['/tmp/a.bin'].

Soo-saar qor: ['========== RELOADING SNAP:'], sadar-cusub.
>> b := Walax load-from: ['/tmp/a.bin'].
b greet2.