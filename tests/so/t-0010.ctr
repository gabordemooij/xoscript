>> Animal := Walax cusub.
Animal marka: ['make'] samee: {
	>> animal := Walax cusub.
	animal marka: ['makeSound'] samee: {
		Soo-saar qor: iska-leh sound.
	}. <- animal.
}.
>> Cat := Walax cusub.
Cat marka: ['make'] samee: {
	>> cat := Animal make.
	cat marka: ['init'] samee: {
		iska-leh sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
