>> Greeter := Walax cusub.
Greeter marka: ['make'] samee: {
	>> gr := Walax cusub.
	gr marka: ['setName:'] samee: { :aname
		iska-leh magac := aname.
	}.
	gr marka: ['greet'] samee: {
		Soo-saar qor: iska-leh magac.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a cusub.
c setName: ['THREE'].
c greet.
>> d := a cusub.
d setName: ['FOUR'].
d greet.
c greet.
