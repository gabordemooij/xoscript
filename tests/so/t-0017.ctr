Tiro marka: ['factorial'] samee: {
	>> total := 1.
	{ :index total ku-dhufo: (naf - (index)). } × naf. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Soo-saar qor: a.
>> b := 2 + 3 factorial.
Soo-saar qor: b.
>> c := 3 factorial + 2.
Soo-saar qor: c.
>> d := 2 + (3 factorial).
Soo-saar qor: d.
Soo-saar qor: 2 + 3 factorial + 1.
