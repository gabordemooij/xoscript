Server init.
Soo-saar qor: ['Database date test'], sadar-cusub.

>> db := Maria-DB cusub martigeliye: ['localhost'],
	magaca-isticmaalaha: ['xo'], 
	furaha-sirta: ['pass123'],
	magaca-xogta: ['xobase'],
	ku-xirmo.

>> xuduudaha-raadinta :=
db weydiin: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
soo-qaad: { :row
	Soo-saar qor: row datetest, sadar-cusub.
}.
