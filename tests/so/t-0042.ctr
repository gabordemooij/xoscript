>> items := Qaamuus cusub.
items dhig: ['black'] furaha: ['coffee'], dhig: ['earl grey'] furaha: ['tea'].
Soo-saar qor: (items meesha: ['coffee']), qor: (items meesha: ['tea']).
Soo-saar qor: ['there are'] + items tirada-guud + [' items in the array.'].
items dhig: ['capuccino'] furaha: ['coffee'].
Soo-saar qor: ['Now my coffee is.. '] + (items meesha: ['coffee']).
items dhig: ['aaa'] furaha: ['1'].
items dhig: ['bbb'] furaha: ['2'].
Soo-saar qor: (items meesha: ['a']).
