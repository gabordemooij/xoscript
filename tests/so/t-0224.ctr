
>> countries := Liis cusub
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Liis cusub
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods sida: countries, mid-kasta: { :key :value
	counter ku-dar: 1.
}.

Soo-saar qor: (['we serve counter dishes'] counter: counter), sadar-cusub.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] xarfaha kala-sooc: { :v
	counter ku-dar: 0.
}.

Soo-saar qor: (['we sort counter dishes'] counter: counter), sadar-cusub.


>> counter := 0.
{
	{
		counter ku-dar: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Soo-saar qor: (['we calculate counter numbers.'] counter: counter), sadar-cusub.

