#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Hannaan cusub: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern is-waafaq: subject samee: { :m :x
	Soo-saar qor: m, sadar-cusub.
	Soo-saar qor: x, sadar-cusub. <- ['XXX'].
}.
Soo-saar qor: result, sadar-cusub.