# a quote that never closes must give an error, not an endless loop
>> waddada-faylka := ['/tmp/test0821.csv'].
>> file := Fayl cusub: waddada-faylka.

file qor: ['a,b\n"1,2\n'].
{
	file kala-saare: [','] calaamad-xigasho: ['"'] sadarro: { :line
		Soo-saar qor: line, sadar-cusub.
	}.
} qabo: { :e Soo-saar qor: e, sadar-cusub. }, bilow.

# a closed quote still works
file qor: ['a,b\n"1,2",3'].
file kala-saare: [','] calaamad-xigasho: ['"'] sadarro: { :line
	Soo-saar qor: line, sadar-cusub.
}.
file tirtir.
