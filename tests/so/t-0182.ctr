

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Barnaamij maamulka-xusuusta: 0.

>> txt := ['1.6'].
>> n := txt tiro.
>> t := txt buuliyaan.
Soo-saar qor: n, sadar-cusub.
Soo-saar qor: t, sadar-cusub.
Soo-saar qor: n nooc, sadar-cusub.
Soo-saar qor: t nooc, sadar-cusub.

Barnaamij nadiifi.

usedMemory1 := (Barnaamij xusuus ? 0).


txt := ['1.6'].
n := txt tiro.
t := txt buuliyaan.
Soo-saar qor: n, sadar-cusub.
Soo-saar qor: t, sadar-cusub.
Soo-saar qor: n nooc, sadar-cusub.
Soo-saar qor: t nooc, sadar-cusub.

Barnaamij nadiifi.
usedMemory2 := (Barnaamij xusuus ? 0).


txt := ['1.6'].
n := txt tiro.
t := txt buuliyaan.
Soo-saar qor: n, sadar-cusub.
Soo-saar qor: t, sadar-cusub.
Soo-saar qor: n nooc, sadar-cusub.
Soo-saar qor: t nooc, sadar-cusub.

Barnaamij nadiifi.
usedMemory3 := (Barnaamij xusuus ? 0).



( usedMemory1 = usedMemory2 iyo: usedMemory1 = usedMemory3, iyo: usedMemory2 = usedMemory3 ) run: {
	Soo-saar qor: ['No memory leaks here'].
}, been: {
	Soo-saar qor: ['Leaking memory...'].
}.
