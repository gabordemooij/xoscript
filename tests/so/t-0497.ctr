Server init.

# write a test file
>> f := Fayl cusub: ['/tmp/test.gif'].
f qor: ['GIF87a01234567810'].

# serve the file
Server gudbi: ['test.gif'] horgale: ['/tmp/'].

Soo-saar sadar-cusub.

Soo-saar qor: ['Outside container (security):'], sadar-cusub.
{ Server gudbi: ['../passwd'] horgale: ['/tmp/']. }
qabo: { :e Soo-saar qor: e, sadar-cusub. },
bilow.

Soo-saar qor: ['Invalid prefix:'], sadar-cusub.
{ Server gudbi: ['test.gif'] horgale: ['z:\\']. }
qabo: { :e Soo-saar qor: e, sadar-cusub. },
bilow.

Soo-saar qor: ['Non-existant file:'], sadar-cusub.
{ Server gudbi: ['xxx.xxx'] horgale: ['/tmp/']. }
qabo: { :e Soo-saar qor: e, sadar-cusub. },
bilow.
