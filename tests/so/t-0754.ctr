Soo-saar qor: ['Test object'], sadar-cusub.
>> a := Walax cusub. 

a marka: ['item:'] samee: { :out
	iska-leh out := out. 
}.

a marka: ['item'] samee: { <- iska-leh out.
}.

a marka: ['greet'] samee: {
	Soo-saar qor: ['hi from original out!'], sadar-cusub.
}.

a item: Soo-saar.

Soo-saar qor: a item, sadar-cusub.

>> old-out-address := a item tusaale-hore cinwaanka-xusuusta.
a save-as: ['/tmp/a.bin'].
Soo-saar qor: ['========== RELOADING SNAP:'], sadar-cusub.

>> b := Walax load-from: ['/tmp/a.bin'].

(b item tusaale-hore cinwaanka-xusuusta = old-out-address) run: {
	Soo-saar qor: ['Object link re-attached.'], sadar-cusub.
}.

b item qor: ['hello from loaded out!'], sadar-cusub.
b greet.
