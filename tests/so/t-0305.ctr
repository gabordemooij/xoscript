
Tiro baro: ['plus:'] macnaha: ['+'].
Tiro marka: ['+'] samee: { :x
	>> rate := 1.
	>> currency := x halbeegga-tirada.
	(currency = ['euros']) run: {
		rate := 2.
	}. <- (naf plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars halbeeg: ['dollars'].
euros halbeeg: ['euros'].
>> money := dollars + euros.
Soo-saar qor: money, sadar-cusub.
