
Liis marka: ['product'] samee: {
	>> total := 1.
	naf mid-kasta: { :index :element
		total ku-dhufo: element.
	}. <- total.
}.

>> a := Liis ← 1 ; 2 ; 3.
Soo-saar qor: a product, sadar-cusub.
Soo-saar qor: (Liis ← 2 ; 4 ; 8) product, sadar-cusub. 
Soo-saar qor: (Liis ← -2 ; 10) product, sadar-cusub. 
Soo-saar qor: (Liis ← 0.5 ; -2) product, sadar-cusub. 
