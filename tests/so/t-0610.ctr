
>> Rectangle := Walax cusub.

Rectangle marka: ['area'] samee: { <- iska-leh dherer * iska-leh width.
}.

Rectangle marka: ['length:'] samee: { :dherer
	iska-leh dherer := dherer.
}.

Rectangle marka: ['width:'] samee: { :width
	iska-leh width := width.
}.

Rectangle marka: ['cusub'] samee: {
	# this will not result into an infinite loop
	>> rectangle := naf cusub.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle cusub.
Soo-saar qor: a area, sadar-cusub. #0

>> b := Rectangle cusub length: 2, width: 3.
Soo-saar qor: b area, sadar-cusub. #6

