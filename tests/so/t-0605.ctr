>> invoice := Walax cusub.
invoice marka: ['bilow'] samee: {
        iska-leh tiro := 0.
}.

invoice marka: ['tiro'] samee: {
        iska-leh tiro ku-dar: 1. <- iska-leh tiro koobiyee.
}.

>> year-invoice := invoice cusub.
year-invoice marka: ['start:'] samee: { :sannad
	iska-leh tiro := sannad.
}.

year-invoice start: 202000.
Soo-saar qor: year-invoice tiro, sadar-cusub.
Soo-saar qor: year-invoice tiro, sadar-cusub.
