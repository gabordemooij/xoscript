Soo-saar qor: ['Test object'], sadar-cusub.
>> a := Walax cusub. 

a marka: ['item:'] samee: { :hexhelper
	iska-leh hexhelper := hexhelper. 
}.

a marka: ['item'] samee: { <- iska-leh hexhelper.
}.

a item: Hx cusub.

>> old-hexhelper-address := a item tusaale-hore cinwaanka-xusuusta.
a save-as: ['/tmp/a.bin'].
Soo-saar qor: ['========== RELOADING SNAP:'], sadar-cusub.

>> b := Walax load-from: ['/tmp/a.bin'].

(b item tusaale-hore cinwaanka-xusuusta = old-hexhelper-address) run: {
	Soo-saar qor: ['Object link re-attached.'], sadar-cusub.
}.
