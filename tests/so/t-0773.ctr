Soo-saar qor: ['Test object'], sadar-cusub.
>> a := Walax cusub. 
a marka: ['item:'] samee: { :int64
	iska-leh int64 := int64. 
}.
a marka: ['item'] samee: { <- iska-leh int64.
}.
a item: ( Int64 qoraal-ka: ['9999'] ).
Soo-saar qor: a item, sadar-cusub.
>> old-int64-address := a item tusaale-hore cinwaanka-xusuusta.
a save-as: ['/tmp/a.bin'].
Soo-saar qor: ['========== RELOADING SNAP:'], sadar-cusub.
>> b := Walax load-from: ['/tmp/a.bin'].
(b item tusaale-hore cinwaanka-xusuusta = old-int64-address) run: {
	Soo-saar qor: ['Object link re-attached.'], sadar-cusub.
}.
Soo-saar qor: ( b item ), sadar-cusub.
