# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob cusub: 8, bytes: (
	Liis cusub ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Soo-saar qor: ( utf16 koodh-fur: ['utf16le'] ), sadar-cusub.

utf16 sii-daa.
>> utf32 := Blob cusub: 13, bytes: (
	Liis cusub ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Soo-saar qor: ( utf32 koodh-fur: ['utf32be'] ), sadar-cusub.
utf32 sii-daa.