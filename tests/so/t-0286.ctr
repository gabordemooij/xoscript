['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Soo-saar qor: (x + y), sadar-cusub.

>> x := 10040.07.
>> y := 10305.60.

Soo-saar qor: (x + y), sadar-cusub.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Soo-saar qor: (x + y + z), sadar-cusub.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Soo-saar qor: (x + y + z), sadar-cusub.

>> q := 0.1.2.

Soo-saar qor: (q), sadar-cusub.

>> q := 012.

Soo-saar qor: (q), sadar-cusub.
