
>> city := Liis ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Liis ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature sida: city.
>> cities := weather furayaasha kala-sooc: { :a :b <- (a isbarbar-dhig: b). }.
>> temperatures := weather qiimayaasha kala-sooc: { :a :b <- (a isbarbar-dhig: b) taban?. }.

Soo-saar qor: (cities isku-dar: [',']), sadar-cusub.
Soo-saar qor: (temperatures isku-dar: [',']), sadar-cusub.
