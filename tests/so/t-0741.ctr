Soo-saar qor: ['Test object'], sadar-cusub.
>> a := Walax cusub. 

a marka: ['item:'] samee: { :octhelper
	iska-leh octhelper := octhelper. 
}.

a marka: ['item'] samee: { <- iska-leh octhelper.
}.

a item: Oct cusub.

>> old-octhelper-address := a item tusaale-hore cinwaanka-xusuusta.
a save-as: ['/tmp/a.bin'].
Soo-saar qor: ['========== RELOADING SNAP:'], sadar-cusub.

>> b := Walax load-from: ['/tmp/a.bin'].

(b item tusaale-hore cinwaanka-xusuusta = old-octhelper-address) run: {
	Soo-saar qor: ['Object link re-attached.'], sadar-cusub.
}.
