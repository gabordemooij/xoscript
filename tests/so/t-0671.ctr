# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Khasnad samee-furayaal.

# private (secret) key
>> sk := keys ugu-horreeya.

# public key
>> pk := keys ugu-dambeeya.

# sign a message
>> sig := Khasnad saxiix: ['abc'] ku: sk.

# check message (ok)
Soo-saar qor: ( 
	Khasnad
		hubi: ['abc'] 
		saxiix: sig 
		ku: pk 
), sadar-cusub.

# check message (fail)
Soo-saar qor: ( 
	Khasnad 
		hubi: ['abd'] 
		saxiix: sig 
		ku: pk 
), sadar-cusub.