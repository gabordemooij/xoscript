# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB cusub martigeliye: ['localhost'],
	magaca-isticmaalaha: ['xo'],
	furaha-sirta: ['pass123'],
	magaca-xogta: ['xobase'],
	ku-xirmo.

>> xuduudaha-raadinta := db weydiin: ['SELECT %% FROM'].
{ xuduudaha-raadinta fuli. } qabo: { :e
	Soo-saar qor: ( e ku-jira: ['%%'] ), sadar-cusub.
}, bilow.
