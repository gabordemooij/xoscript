>> x := [' hallo '].

>> y := x xarfo-waaweyn.
Soo-saar qor: x, sadar-cusub.
Soo-saar qor: (x isku-mid: y), sadar-cusub.

>> y := x xarfo-yaryar.
Soo-saar qor: x, sadar-cusub.
Soo-saar qor: (x isku-mid: y), sadar-cusub.

>> y := x jar-bannaanka.
Soo-saar qor: x, sadar-cusub.
Soo-saar qor: (x isku-mid: y), sadar-cusub.

>> y := x ka-bood: 1.
Soo-saar qor: x, sadar-cusub.
Soo-saar qor: (x isku-mid: y), sadar-cusub.

>> y := x ka: 1 dherer: 2.
Soo-saar qor: x, sadar-cusub.
Soo-saar qor: (x isku-mid: y), sadar-cusub.