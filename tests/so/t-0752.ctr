Soo-saar qor: ['Test object'], sadar-cusub.
>> a := Walax cusub. 

a marka: ['item:'] samee: { :buuliyaan
	iska-leh buuliyaan := buuliyaan. 
}.

a marka: ['item'] samee: { <- iska-leh buuliyaan.
}.

a item: Buuliyaan.

Soo-saar qor: a item, sadar-cusub.

>> old-bool-address := a item tusaale-hore cinwaanka-xusuusta.
a save-as: ['/tmp/a.bin'].
Soo-saar qor: ['========== RELOADING SNAP:'], sadar-cusub.

>> b := Walax load-from: ['/tmp/a.bin'].

(b item tusaale-hore cinwaanka-xusuusta = old-bool-address) run: {
	Soo-saar qor: ['Object link re-attached.'], sadar-cusub.
}.

Soo-saar qor: b item, sadar-cusub.
