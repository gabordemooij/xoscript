
>> Size := Walax cusub.
Size marka: ['is:'] samee: { :tiro
	tiro marka: ['+'] samee: { :tiro
		>> unit := tiro halbeegga-tirada.
		>> factor := 1.
		
		unit
		haddii: ['inch'] samee: { factor := 0.0833. }. <- naf + (tiro * factor).
	}. <- tiro.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Soo-saar qor: plank + edge, sadar-cusub.
