


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Barnaamij maamulka-xusuusta: 0.
>> palette := Waxba.
>> colors := Waxba.

{
palette := Qaamuus cusub.
palette 
	dhig: ['#F00'] furaha: ['red'],
	dhig: ['#0F0'] furaha: ['green'],
	dhig: ['#00F'] furaha: ['blue'].
Soo-saar qor: ['number of RGB codes in palette: '] + ( palette tirada-guud ), sadar-cusub.
Soo-saar qor: ['RGB code of green is: '] + ( palette ? ['green'] ), sadar-cusub.
colors := [''].
( palette mid-kasta: { :magac :koodh
		colors := colors + ( magac + [':'] + koodh ).
} ).
Soo-saar qor: ['All colors in palette: '] + colors, sadar-cusub.
} bilow.
Barnaamij nadiifi.
usedMemory1 := (Barnaamij xusuus ? 0).

{
palette := Qaamuus cusub.
palette 
	dhig: ['#F00'] furaha: ['red'],
	dhig: ['#0F0'] furaha: ['green'],
	dhig: ['#00F'] furaha: ['blue'].
Soo-saar qor: ['number of RGB codes in palette: '] + ( palette tirada-guud ), sadar-cusub.
Soo-saar qor: ['RGB code of green is: '] + ( palette ? ['green'] ), sadar-cusub.
colors := [''].
( palette mid-kasta: { :magac :koodh
		colors := colors + ( magac + [':'] + koodh ).
} ).
Soo-saar qor: ['All colors in palette: '] + colors, sadar-cusub.
} bilow.
Barnaamij nadiifi.
usedMemory2 := (Barnaamij xusuus ? 0).

{
palette := Qaamuus cusub.
palette 
	dhig: ['#F00'] furaha: ['red'],
	dhig: ['#0F0'] furaha: ['green'],
	dhig: ['#00F'] furaha: ['blue'].
Soo-saar qor: ['number of RGB codes in palette: '] + ( palette tirada-guud ), sadar-cusub.
Soo-saar qor: ['RGB code of green is: '] + ( palette ? ['green'] ), sadar-cusub.
colors := [''].
( palette mid-kasta: { :magac :koodh
		colors := colors + ( magac + [':'] + koodh ).
} ).
Soo-saar qor: ['All colors in palette: '] + colors, sadar-cusub.
} bilow.
Barnaamij nadiifi.
usedMemory3 := (Barnaamij xusuus ? 0).



( usedMemory1 = usedMemory2 iyo: usedMemory1 = usedMemory3, iyo: usedMemory2 = usedMemory3 ) run: {
	Soo-saar qor: ['No memory leaks here'].
}, been: {
	Soo-saar qor: ['Leaking memory...'].
}.
