# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Hannaan cusub: pattern.
	p is-waafaq: subject samee: { :m :g
		Soo-saar qor: g tirada-guud, qor: [' '], qor: (g isku-dar: ['|']), sadar-cusub. <- m.
	}.
}.
show ku-dabaq: ['(a)|(b)'] iyo: ['b'].
show ku-dabaq: ['(a)|(b)'] iyo: ['a'].
show ku-dabaq: ['(x)?y'] iyo: ['y'].
show ku-dabaq: ['(x)?(y)(z)?'] iyo: ['xy'].
