>> To-Do := Walax cusub.

To-Do marka: ['cusub'] samee: {
	iska-leh list := Liis cusub.
}.

To-Do marka: ['nieuw'] samee: {
	iska-leh list := Liis cusub.
}.

To-Do marka: ['+'] samee: { :task
	iska-leh list dhammaadka-ku-dar: task.
}.

To-Do marka: ['number of tasks?'] samee: { <-  iska-leh list tirada-guud.
}.

>> todos := 
	To-Do cusub 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Soo-saar qor: ['You have $ tasks to do'] $ todos number of tasks?.
