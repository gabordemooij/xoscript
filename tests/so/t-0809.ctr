# backslashes must survive code serialization, strings must not end early
>> qiimayaasha := Liis cusub
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

qiimayaasha mid-kasta: { :i :value
	>> d := Qaamuus cusub.
	d dhig: value furaha: ['k'].
	>> r := d koodh walax.
	Soo-saar qor: r tirada-guud, sadar-cusub.
	Soo-saar qor: ( (r meesha: ['k']) = value ), sadar-cusub.
}.
