Soo-saar qor: ['Test object'], sadar-cusub.
>> a := Walax cusub. 

a marka: ['item:'] samee: { :fmt
	iska-leh fmt := fmt. 
}.

a marka: ['item'] samee: { <- iska-leh fmt.
}.

a item: ( Qaab cusub: ['|%s|'] ).

Soo-saar qor: a item, sadar-cusub.

>> old-fmt-address := a item tusaale-hore cinwaanka-xusuusta.
a save-as: ['/tmp/a.bin'].
Soo-saar qor: ['========== RELOADING SNAP:'], sadar-cusub.

>> b := Walax load-from: ['/tmp/a.bin'].

(b item tusaale-hore cinwaanka-xusuusta = old-fmt-address) run: {
	Soo-saar qor: ['Object link re-attached.'], sadar-cusub.
}.

Soo-saar qor: ( b item ku-dabaq: ['hello'] ), sadar-cusub.
