# test buffers PKI/Sign 
Server init.

>> long := ( Liis cusub buuxi: 1000 ku: ['a'] ) isku-dar: [''].

# sign a message
Soo-saar qor: ( 
	Khasnad saxiix: ['abc'] ku: long
), sadar-cusub.

Soo-saar qor: ( 
	Khasnad
		hubi: ['abc'] 
		saxiix: long 
		ku: long
), sadar-cusub.

Soo-saar qor: (
	Khasnad hash-furaha-sirta: long xaqiiji: long
), sadar-cusub.
