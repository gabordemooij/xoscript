
>> dictionary := (
	Qaamuus cusub
		dhig: ['b'] furaha: ['a'],
		dhig: ['a'] furaha: ['b'],
		dhig: ['z'] furaha: ['x'],
		dhig: ['hello'] furaha: ['hallo'],
		dhig: ['human'] furaha: ['human']
).

>> comparisons := Liis cusub.
dictionary mid-kasta: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a isbarbar-dhig: b)
	).
}.

comparisons kala-sooc: { :a :b <- ( a isbarbar-dhig: b ). }.
Soo-saar qor: ( comparisons isku-dar: ['↵'] ), sadar-cusub.
comparisons isku-dar: ['↵'].
