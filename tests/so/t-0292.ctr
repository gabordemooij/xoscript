>> winery := { <- (	Qaamuus cusub
		dhig: 2 furaha: ['merlot'],
		dhig: 3 furaha: ['malbec'],
		dhig: 4 furaha: ['syrah']
	).
}.

Soo-saar qor: (((winery bilow) - ['nothing']) tirada-guud), sadar-cusub.
Soo-saar qor: (((winery bilow) - ['merlot']) tirada-guud), sadar-cusub.
Soo-saar qor: (((winery bilow) - ['malbec']) tirada-guud), sadar-cusub.
Soo-saar qor: (((winery bilow) - ['syrah']) tirada-guud), sadar-cusub.
Soo-saar qor: (((winery bilow) - ['merlot'] - ['malbec']) tirada-guud), sadar-cusub.
Soo-saar qor: (((winery bilow) - ['merlot'] - ['syrah']) tirada-guud), sadar-cusub.
Soo-saar qor: (((winery bilow) - ['malbec'] -['syrah']) tirada-guud), sadar-cusub.
Soo-saar qor: (((winery bilow) - ['malbec'] - ['syrah'] - ['merlot']) tirada-guud), sadar-cusub.

