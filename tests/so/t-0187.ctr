Tiro marka: ['factorial'] samee: {
	>> total := 1.
	{ :index total ku-dhufo: (naf - index). } × naf. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Barnaamij maamulka-xusuusta: 0.

{
2 exponent factorial.
Soo-saar qor: (11 hadhaa: 3), sadar-cusub.
Soo-saar qor: (3.4 soo-koob), sadar-cusub.
Soo-saar qor: (7.1 kor-u-soo-koob), sadar-cusub.
Soo-saar qor: (7.9 hoos-u-soo-koob), sadar-cusub.
}
bilow.

Barnaamij nadiifi.

usedMemory1 := (Barnaamij xusuus ? 0).

{
2 exponent factorial.
Soo-saar qor: (11 hadhaa: 3), sadar-cusub.
Soo-saar qor: (3.4 soo-koob), sadar-cusub.
Soo-saar qor: (7.1 kor-u-soo-koob), sadar-cusub.
Soo-saar qor: (7.9 hoos-u-soo-koob), sadar-cusub.
}
bilow.

Barnaamij nadiifi.
usedMemory2 := (Barnaamij xusuus ? 0).


{
2 exponent factorial.
Soo-saar qor: (11 hadhaa: 3), sadar-cusub.
Soo-saar qor: (3.4 soo-koob), sadar-cusub.
Soo-saar qor: (7.1 kor-u-soo-koob), sadar-cusub.
Soo-saar qor: (7.9 hoos-u-soo-koob), sadar-cusub.
} bilow.

Barnaamij nadiifi.
usedMemory3 := (Barnaamij xusuus ? 0).



( usedMemory1 = usedMemory2 iyo: usedMemory1 = usedMemory3, iyo: usedMemory2 = usedMemory3 ) run: {
	Soo-saar qor: ['No memory leaks here'].
}, been: {
	Soo-saar qor: ['Leaking memory...'].
}.
