>> q := Liis ← 1 ; 2 ; 3.
{ q ? ['1']. } qabo: { Soo-saar qor: ['caught!'], sadar-cusub. }, bilow.
{ q ? Run. } qabo: { Soo-saar qor: ['caught!'], sadar-cusub. }, bilow.
{ q ? Been. } qabo: { Soo-saar qor: ['caught!'], sadar-cusub. }, bilow.
{ q ? Waxba. } qabo: { Soo-saar qor: ['caught!'], sadar-cusub. }, bilow.
{ q ? (Liis cusub). } qabo: { Soo-saar qor: ['caught!'], sadar-cusub. }, bilow.
{ q ? (Walax cusub). } qabo: { Soo-saar qor: ['caught!'], sadar-cusub. }, bilow.
{ q ? ({ ['Empty']. }). } qabo: { Soo-saar qor: ['caught!'], sadar-cusub. }, bilow.
Soo-saar qor: ['caught them all'], sadar-cusub.
