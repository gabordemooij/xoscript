>> Greeter := Walax cusub.
Greeter marka: ['make'] samee: {
	>> greeter := Walax cusub.
	greeter marka: ['name:'] samee: { :magac
		Soo-saar qor: ['setting a name'].
		iska-leh myName := magac.
	}.
	greeter marka: ['performGreeting'] samee: {
		Soo-saar qor: ['Hello'].
		Soo-saar qor: iska-leh myName.
	}.
	greeter marka: ['greet'] samee: {
		naf performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
