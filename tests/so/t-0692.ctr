Server init.

Soo-saar qor: (
	Hannaan cusub: ['^\\w+$'],
	is-waafaq: ['test@example.com'] 
), sadar-cusub. # 0 match, fails on @ and .

Soo-saar qor: (
	Hannaan cusub: ['^[^@]+@[^\.]+\.\\w+$'],
	is-waafaq: ['test@example.com'] 
), sadar-cusub. # 1 match

Soo-saar qor: (
	Hannaan cusub: ['[^@]+@[^\.]+\.\\w+'],
	is-waafaq: ['test@example.com'] 
), sadar-cusub. # 1 match

Soo-saar qor: (
	Hannaan cusub: ['([^@]+)@([^\.]+)\.\\w+'],
	is-waafaq: ['test@example.com'] 
), sadar-cusub. # 1 match, groups dont matter

Soo-saar qor: (
	Hannaan cusub: ['[a-z]'],
	is-waafaq: ['test@example.com'] 
), sadar-cusub. # 14 matches

Soo-saar qor: (
	Hannaan cusub: ['.*'],
	is-waafaq: ['test@example.com'] 
), sadar-cusub. # 1 match (all)

Soo-saar qor: (
	Hannaan cusub: ['(.*)'],
	is-waafaq: ['test@example.com'] 
), sadar-cusub. # 1 match (all)

Soo-saar qor: (
	Hannaan cusub: ['\\s*[^@]+@[^\.]+\.\\w+'],
	is-waafaq: ['test@example.com'] 
), sadar-cusub. # 1 match, prefix space optional, gets ignored