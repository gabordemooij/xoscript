>> randomizer := { :a :b
	>> ugu-yar := ( a < b ) kan: a ama-kaas: b.
	>> ugu-weyn := ( a > b ) kan: a ama-kaas: b.
	>> x := Waxba.
	{
		x := Tiro dhexeeya: a iyo: b.
		((x < ugu-yar) ama: (x > ugu-weyn)) run: { 
			Soo-saar qor: (['Invalid value!']).
			Barnaamij dhammee.
		}.
	} 
	× 100. <- x.
}.
randomizer ku-dabaq: 0 iyo: 0.
randomizer ku-dabaq: 1 iyo: 0.
