Qoraal marka: ['evaluate'] samee: {
	>> koodh := Fayl cusub: ['/tmp/eval.ctr'].
	koodh qor: (naf qoraal + ['.']).
	Barnaamij isticmaal: ['/tmp/eval.ctr'].
}.

>> a := Liis ← 1 ; 2 ; 3.
>> b := (a qoraal).

Soo-saar qor: b, sadar-cusub. 
(['b := '] + b) evaluate.

Soo-saar qor: b ? 2, sadar-cusub. 

Soo-saar qor: (( Liis ← 1 ; 2 ; 3 )), sadar-cusub. 

Soo-saar qor: ((Qaamuus cusub) dhig: 1 furaha: 2), sadar-cusub. 

>> x := ( (Liis ← 1 ; ( Liis ← 9 ) ; Run ) ) qoraal.
Soo-saar qor: x, sadar-cusub. 
(['x := '] + x) evaluate.

Soo-saar qor: x ? 1 ? 0, sadar-cusub. 

>> y := (Qaamuus cusub) dhig: (Liis ← 1) furaha: (Liis ← 2).
Soo-saar qor: y, sadar-cusub. 

(['y := '] + y) qoraal evaluate.

Soo-saar qor: (y meesha: (Liis ← 2) qoraal ), sadar-cusub.

Soo-saar qor: (Liis cusub), sadar-cusub. 
Soo-saar qor: (Qaamuus cusub), sadar-cusub. 
