Soo-saar qor: ['Test object'], sadar-cusub.
>> a := Walax cusub. 

a marka: ['item:'] samee: { :dict
	iska-leh dict := dict. 
}.

a marka: ['item'] samee: { <- iska-leh dict.
}.

a item: (
Qaamuus cusub
	hello: ['world'],
	world: (Qaamuus cusub dhig: ['a'] furaha: ['b'])).

Soo-saar qor: a item, sadar-cusub.

>> old-dict-address := a item tusaale-hore cinwaanka-xusuusta.
a save-as: ['/tmp/a.bin'].
Soo-saar qor: ['========== RELOADING SNAP:'], sadar-cusub.

>> b := Walax load-from: ['/tmp/a.bin'].

(b item tusaale-hore cinwaanka-xusuusta = old-dict-address) run: {
	Soo-saar qor: ['Object link re-attached.'], sadar-cusub.
}.

Soo-saar qor: b item, sadar-cusub.
