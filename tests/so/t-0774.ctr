Soo-saar qor: ['Test object'], sadar-cusub.
>> a := Walax cusub. 
a marka: ['item:'] samee: { :lst
	iska-leh lst := lst. 
}.
a marka: ['item'] samee: { <- iska-leh lst.
}.
a item: (
	Liis cusub ; 1 ; (
		Liis cusub ; ['a'] ; (
			Liis cusub ; ( Xilli cusub: 1 )
		) ; ( Int64 qoraal-ka: ['321'] )
	)
).
Soo-saar qor: a item, sadar-cusub.
>> old-lst-address := a item tusaale-hore cinwaanka-xusuusta.
a save-as: ['/tmp/a.bin'].
Soo-saar qor: ['========== RELOADING SNAP:'], sadar-cusub.
>> b := Walax load-from: ['/tmp/a.bin'].
(b item tusaale-hore cinwaanka-xusuusta = old-lst-address) run: {
	Soo-saar qor: ['Object link re-attached.'], sadar-cusub.
}.
Soo-saar qor: ( b item ), sadar-cusub.
