# test qualifiers

Barnaamij nadiifi.

>> Fruit := Walax cusub.
Fruit marka: ['cusub'] samee: {
	>> f := naf cusub.
	f apples: 0. <- f.
}.
Fruit marka: ['apples:'] samee: { :a iska-leh apples := a. }.
Fruit marka: ['apples'] samee: { <- iska-leh apples. }.
Fruit marka: ['+'] samee: { :f
	>> n := Fruit cusub.
	n apples: (f apples + iska-leh apples). <- n.
}.
Tiro marka: ['apples'] samee: { <- ((Fruit cusub) apples: naf).
}.

Fruit marka: ['qoraal'] samee: { <- iska-leh apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Soo-saar qor: q, sadar-cusub.




q := 3 apples + 4 apples.
Soo-saar qor: q, sadar-cusub.



q := 3 apples + 4 apples.
Soo-saar qor: q, sadar-cusub.


