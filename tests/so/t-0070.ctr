>> numbers := ['1,2,3'] kala-qaybi: [','].
Soo-saar qor: ['I got: '] + numbers tirada-guud + [' numbers.'],sadar-cusub.
{ :i Soo-saar qor: ['number #'] + i + [':'] + (numbers boos: i), sadar-cusub.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages kala-qaybi: [' Or '].
Soo-saar qor: ['We serve'], sadar-cusub.
{ :i Soo-saar qor: ['->'] + (beverages boos: i), sadar-cusub. } × (beverages tirada-guud).
Soo-saar qor: (beverages isku-dar: [',']), sadar-cusub.
Soo-saar qor: (numbers isku-dar: ['||']).
