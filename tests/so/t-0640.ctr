
Server init.
Soo-saar qor: ['Database test'], sadar-cusub.

>> db := Maria-DB cusub martigeliye: ['localhost'],
	magaca-isticmaalaha: ['xo'], 
	furaha-sirta: ['pass123'],
	magaca-xogta: ['xobase'],
	ku-xirmo.

>> xuduudaha-raadinta :=
db weydiin: ['SELECT UNHEX('CAFE') AS blobby'],
soo-qaad: { :row
	Soo-saar qor: ( row blobby ka: 0 dherer: 2 ), sadar-cusub.
	row blobby sii-daa.
}.
