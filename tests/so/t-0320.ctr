


>> CoffeeMachine := Walax cusub.
CoffeeMachine marka: ['order:'] samee: { :id
	>> coffee := ['Americano'].
	( id = 1 ) run: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) run: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) run: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Walax cusub.
SimpleCoffeeMachine marka: ['order'] samee: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Soo-saar qor: redCup, sadar-cusub.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Soo-saar qor: greenCup, sadar-cusub.
>> yellowCup := CoffeeMachine order: 1.
Soo-saar qor: yellowCup, sadar-cusub.
>> blueCup := CoffeeMachine order: 0.
Soo-saar qor: blueCup, sadar-cusub.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Soo-saar qor: blackCup, sadar-cusub.
blackCup dhammaadka-ku-dar: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Soo-saar qor: orangeCup, sadar-cusub.
