

Liis marka: ['column:'] samee: { :column
	>> result := Liis cusub.
	naf mid-kasta: { :index :row
		row mid-kasta: { :index :cell
			(index = column) run: { result dhammaadka-ku-dar: cell. }.
		}.
	}. <- result.
}.


>> a := Liis ←
	(Liis ← 1 ; 2 ; 3) ;
	(Liis ← 4 ; 5 ; 6) ;
	(Liis ← 7 ; 8 ; 9).

>> b := a column: 1.
Soo-saar qor: b, sadar-cusub.

b := a column: 20.
Soo-saar qor: b, sadar-cusub.

b := a column: -100.
Soo-saar qor: b, sadar-cusub.
