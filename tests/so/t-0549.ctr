>> struct := Blob struct: (
	Liis cusub 
		; ['int']
		; ['int']
		; ['int']
		; ['int']
		; ['int']
		; ['int']
		; ['int']
		; ['int']
).


>> libname := Barnaamij dejin: ['FFITESTLIB'].

Server xiriiri: (
 Liis cusub ;
 libname ;
 ['asctime'] ;
 ( Liis cusub ; ['pointer'] ) ;
