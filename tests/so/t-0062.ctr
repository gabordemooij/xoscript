Buuliyaan marka: ['xor:'] samee: { :a :b <- ((a iyo: b lid) ama: (a lid iyo: b)).
}.

>> o := Walax cusub.
o marka: ['hello'] samee: { ['Empty']. }.
{ o marka: 2 samee: 3.} qabo: { :e Soo-saar qor: e, sadar-cusub. }, bilow.
{ o marka: ['tijaabo'] samee: 3.} qabo: { :e Soo-saar qor: e, sadar-cusub. }, bilow.
{ o marka: ['hello'] samee: { ['Empty']. }.} qabo: { :e Soo-saar qor: e, sadar-cusub. }, bilow. 
{ >> z := 4 ÷ 0. } qabo: { :e Soo-saar qor: e, sadar-cusub. }, bilow. 
{ (Run iyo: Waxba) run: { Soo-saar qor: ['X'].}. } qabo: { :e Soo-saar qor: e, sadar-cusub. }, bilow. 
{ ([''] xor: 0) run: { Soo-saar qor: ['X'].}. } qabo: { :e Soo-saar qor: e, sadar-cusub. }, bilow. 
{ (1 < ['2']) run: { Soo-saar qor: ['OK']. }. } qabo: { :e Soo-saar qor: e, sadar-cusub. }, bilow. 
{ (1 < ['2.0']) run: { Soo-saar qor: ['OK']. }. } qabo: { :e Soo-saar qor: e, sadar-cusub. }, bilow. 
{ (1 < ['x2.0']) run: { Soo-saar qor: ['NO!']. }. } qabo: { :e Soo-saar qor: e, sadar-cusub. }, bilow. 
{ Soo-saar qor: (['hello OK there'] ka: ['6'] dherer: ['2']). } bilow. 
