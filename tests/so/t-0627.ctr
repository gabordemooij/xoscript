

# create a 64-bit integer for exact calculations
>> a := Int64 qoraal-ka: ['123'].

# to string
Soo-saar qor: a, sadar-cusub.

# divide
Soo-saar qor: a / (Int64 qoraal-ka: ['3']), sadar-cusub.

# multiply
Soo-saar qor: a * (Int64 qoraal-ka: ['2']), sadar-cusub.

# add
Soo-saar qor: a + (Int64 qoraal-ka: ['1']), sadar-cusub.

# subtract
Soo-saar qor: a - (Int64 qoraal-ka: ['2']), sadar-cusub.

# compare
Soo-saar qor: ( a =   (Int64 qoraal-ka: ['123'])), sadar-cusub.
Soo-saar qor: ( a !=: (Int64 qoraal-ka: ['124'])), sadar-cusub.
Soo-saar qor: ( a <   (Int64 qoraal-ka: ['124'])), sadar-cusub.
Soo-saar qor: ( a >   (Int64 qoraal-ka: ['122'])), sadar-cusub.
Soo-saar qor: ( a >=: (Int64 qoraal-ka: ['123'])), sadar-cusub.
Soo-saar qor: ( a <=: (Int64 qoraal-ka: ['123'])), sadar-cusub.





	