

Qoraal marka: ['evaluate'] samee: {
	>> koodh := Fayl cusub: ['/tmp/eval.ctr'].
	koodh qor: naf qoraal + ['.'].
	Barnaamij isticmaal: ['/tmp/eval.ctr'].
}.

>> a := (Liis ← (
	(Qaamuus cusub)
		dhig: ['domain'] furaha: ['mywebsite.com'],
		dhig: (Liis ←
			((Qaamuus cusub)
				dhig: ['home'] furaha: ['title'],
				dhig: ['<html></html>'] furaha: ['body'],
				dhig: ['2017-01-01'] furaha: ['created']
			) ;
			((Qaamuus cusub)
				dhig: ['aboutus(c)'] furaha: ['title'],
				dhig: ['<credits>Author Inc.</credits>'] furaha: ['body']
			)
		) furaha: ['pages']
	)
) qoraal.

Soo-saar qor: a nooc, sadar-cusub.
Soo-saar qor: a, sadar-cusub.

>> b := Waxba.
(['b := '] + a) evaluate.
Soo-saar qor: b ? 0 ? ['pages'] ? 1 ? ['body'], sadar-cusub.

>> c := b ? 0.
>> d := c qoraal.
Soo-saar qor: d nooc, sadar-cusub.

>> e := Waxba.
(['e := '] + d) evaluate.
Soo-saar qor: e ? ['pages'] ? 0, sadar-cusub.
