Tiro marka: ['factorial'] samee: {
	>> total := 1.
	{ :index total ku-dhufo: (naf - (index)). } × naf. <- total.
}.
>> Printer := Walax cusub.
Printer marka: ['print:and:'] samee: { :x :y
	Soo-saar qor: ['a='] + x + [', b='] + y, sadar-cusub.
}.
>> a := 4.5. >> b := a hoos-u-soo-koob.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a kor-u-soo-koob.
Printer print: a and: b.
a := 4.5. b := a hoos-u-soo-koob.
Printer print: a and: b.
a := 4.5. b := a soo-koob.
Printer print: a and: b.
a := 4.2. b := a soo-koob.
Printer print: a and: b.

Soo-saar qor: (9 hadhaa: 5), sadar-cusub.
Soo-saar qor: -666 qiime-dhab, sadar-cusub.
Soo-saar qor: 49 xididka-laba-jibbaaran, sadar-cusub.
Soo-saar qor: (2 jibbaar: 3), sadar-cusub.
>> l := (Liis ← 9 ; 6).
Soo-saar qor: l ugu-yar.

