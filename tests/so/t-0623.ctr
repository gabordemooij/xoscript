

>> g := Server cusub.
>> v := Khasnad cusub.
>> ok := 0.

>> secrets := Liis cusub ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> passwords := secrets koobiyee.
passwords mid-kasta: { :i :p
	secrets mid-kasta: { :n :s
		{
			>> encrypted := v sir-geli: s fure: p.
			>> decrypted := v sir-fur: encrypted fure: p.
			(decrypted = s) run: {
				ok ku-dar: 1.
			}, haddii-kale: {
				Soo-saar qor: ['failed encrypting/decrypting: '], sadar-cusub.
				Soo-saar qor: s, sadar-cusub.
				Soo-saar qor: ['encrypted: '] + encrypted, sadar-cusub.
				Soo-saar qor: ['decrypted: '] + encrypted, sadar-cusub.
				Barnaamij dhammee.
			}.
		} qabo: { :err
			(s = [''] ama: p = ['']) run: {
				ok ku-dar: 1.
			}, haddii-kale: {
				Soo-saar qor: err, sadar-cusub.
				Barnaamij dhammee.
			}.
		}, bilow.
	}.
}.

Soo-saar qor: ( ok + [' vault encryptions tested.'] ), sadar-cusub.