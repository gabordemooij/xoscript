{
	hawshan qalad: ['Dont fail.'].
	unknown doSomething.
} qabo: {
	Soo-saar qor: ['Caught!'].
}, bilow.

{
	hawshan qalad: ['Dont fail.'].
	iska-leh unknown doSomething.
} qabo: {
	Soo-saar qor: ['Caught!'].
}, bilow.

{
	hawshan qalad: ['Dont fail.'].
	unknown := 122.
} qabo: {
	Soo-saar qor: ['Caught!'].
}, bilow.


{
	hawshan qalad: ['Dont fail.'].
	Run jooji-wareegga.
	Soo-saar qor: ['FAIL'].
} qabo: {
	Soo-saar qor: ['Caught!'].
}, bilow.

{
	{
		hawshan qalad: ['Dont fail.'].
		Run jooji-wareegga.
		Soo-saar qor: ['FAIL'].
	} qabo: { :x
		(x = ['Dont fail.']) run: { hawshan qalad: ['Nested Caught!']. }.
	}, bilow.
} qabo: { :e
	Soo-saar qor: e.
}, bilow.
