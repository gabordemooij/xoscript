
>> Animal := Walax cusub.
Animal marka: ['cusub'] samee: { <- naf cusub init.
}.

Animal marka: ['init'] samee: {
	iska-leh sound := ['?'].
	iska-leh legs := 4.
}.

>> Dog := Animal cusub.
Dog marka: ['init'] samee: {
	naf init.
	iska-leh sound := ['barks'].
}.

Animal marka: ['qoraal'] samee: { <- iska-leh legs qoraal + iska-leh sound.
}.

>> poodle := Dog cusub.
Soo-saar qor: poodle, sadar-cusub.

