# test number -> string -> number
{

	>> x := Tiro dhexeeya: 0 iyo: 1000000.
	>> d := Tiro dhexeeya: 1 iyo: 7.
	>> e := 10 jibbaar: d.

	x u-qaybi: e.
	>> y := x qoraal tiro.

	(x = y) been: {
		Soo-saar qor: x, sadar-cusub.
		Soo-saar qor: y, sadar-cusub.
		Barnaamij dhammee.
	}.

} * 1000.
Soo-saar qor: ['OK'], sadar-cusub.