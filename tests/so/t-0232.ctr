>> Slurp := Walax cusub.

Slurp marka: ['cusub'] samee: {
	iska-leh str := [''].
}.

Slurp marka: ['jawaab:'] samee: { :blah
		(iska-leh str = ['']) run: {
			iska-leh str dhammaadka-ku-dar: blah.
		}, haddii-kale: {
			iska-leh str dhammaadka-ku-dar: [' '].
			iska-leh str dhammaadka-ku-dar: blah.
		}.
}.

Slurp marka: ['jawaab:iyo:'] samee: { :blah :blahah
		(blah dherer > 1) run: {
			iska-leh str dhammaadka-ku-dar: (blah ka: 0 dherer: (blah dherer - 1)).
		}, haddii-kale: {
			iska-leh str dhammaadka-ku-dar: blah.
		}.
		iska-leh str dhammaadka-ku-dar: [' '].
		iska-leh str dhammaadka-ku-dar: blahah.
}.

Slurp marka: ['obtain'] samee: {
	>> buffer := iska-leh str.
	iska-leh str := ['']. <- buffer.
}.


>> x := Slurp cusub.
x + 3.
Soo-saar qor: (x obtain), sadar-cusub.
x echo: ['Hello world'].
Soo-saar qor: (x obtain), sadar-cusub.
x tellme: 123 and: 987.
Soo-saar qor: (x obtain), sadar-cusub.
