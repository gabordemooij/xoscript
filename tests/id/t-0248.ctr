

Teks saat: ['evaluate'] lakukan: {
	>> kode := Berkas baru: ['/tmp/eval.ctr'].
	kode tulis: diri teks + ['.'].
	Program gunakan: ['/tmp/eval.ctr'].
}.

>> a := (Daftar ← (
	(Kamus baru)
		taruh: ['domain'] di: ['mywebsite.com'],
		taruh: (Daftar ←
			((Kamus baru)
				taruh: ['home'] di: ['title'],
				taruh: ['<html></html>'] di: ['body'],
				taruh: ['2017-01-01'] di: ['created']
			) ;
			((Kamus baru)
				taruh: ['aboutus(c)'] di: ['title'],
				taruh: ['<credits>Author Inc.</credits>'] di: ['body']
			)
		) di: ['pages']
	)
) teks.

Keluaran tulis: a tipe, baris-baru.
Keluaran tulis: a, baris-baru.

>> b := Kosong.
(['b := '] + a) evaluate.
Keluaran tulis: b ? 0 ? ['pages'] ? 1 ? ['body'], baris-baru.

>> c := b ? 0.
>> d := c teks.
Keluaran tulis: d tipe, baris-baru.

>> e := Kosong.
(['e := '] + d) evaluate.
Keluaran tulis: e ? ['pages'] ? 0, baris-baru.
