
Program manajemen-memori: 4.

>> Animal := Objek baru.
Animal saat: ['make'] lakukan: {
	>> animal := Objek baru.
	animal saat: ['makeSound'] lakukan: {
		Keluaran tulis: milik sound.
	}. <- animal.
}.
>> Cat := Objek baru.
Cat saat: ['make'] lakukan: {
	>> cat := Animal make.
	cat saat: ['init'] lakukan: {
		milik sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
