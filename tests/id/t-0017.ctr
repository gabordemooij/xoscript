Angka saat: ['faktorial'] lakukan: {
	>> total := 1.
	{ :indeks total kalikan-dengan: (diri - (indeks)). } × diri. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Keluaran tulis: a.
>> b := 2 + 3 faktorial.
Keluaran tulis: b.
>> c := 3 faktorial + 2.
Keluaran tulis: c.
>> d := 2 + (3 faktorial).
Keluaran tulis: d.
Keluaran tulis: 2 + 3 faktorial + 1.
