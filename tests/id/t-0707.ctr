# uji konversi tipe / konversi / pengikatan
Program manajemen-memori: 4.
Server init.

>> penghitung := 0.
>> bd := Maria-DB baru hos: ['localhost'],
	nama-pengguna: ['xo'], kata-sandi: ['pass123'], nama-basis-data: ['xobase'], sambungkan.

>> FormatDuaDigit := Format baru: ['%02d'].

# Tanggal-waktu
{
	>> tahun     := Angka antara: 1995 dan: 2050, teks.
	>> bulan    := FormatDuaDigit terapkan-bilangan-bulat: (Angka antara: 1 dan: 12), teks.
	>> hari      := FormatDuaDigit terapkan-bilangan-bulat: (Angka antara: 1 dan: 28), teks.
	>> jam     := FormatDuaDigit terapkan-bilangan-bulat: (Angka antara: 1 dan: 23), teks.
	>> menit   := FormatDuaDigit terapkan-bilangan-bulat: (Angka antara: 1 dan: 59), teks.
	>> detik   := FormatDuaDigit terapkan-bilangan-bulat: (Angka antara: 1 dan: 59), teks.
	>> tanggalwaktu := ['YYYY-MM-DD HH:II:SS'].	
	tanggalwaktu
		YYYY: tahun,
		MM: bulan,
		DD: hari,
		HH: jam,
		II: menit,
		SS: detik.
	>> parameter-pencarian :=
	bd kueri: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: tanggalwaktu),
	ambil: { :barisan
		(barisan mydatetime = tanggalwaktu) salah: {
			tugas-ini galat: (
				['Diharapkan: <expected> tapi didapat: <observation>']
				<expected>: tanggalwaktu,
				<observation>: barisan mydatetime
			).
		}.
	
	}.
	penghitung tambah: 1.
} * 100.

# Tanggal
{
	>> tahun     := Angka antara: 1995 dan: 2050, teks.
	>> bulan    := FormatDuaDigit terapkan-bilangan-bulat: (Angka antara: 1 dan: 12), teks.
	>> hari      := FormatDuaDigit terapkan-bilangan-bulat: (Angka antara: 1 dan: 28), teks.
	>> tanggal     := ['YYYY-MM-DD'].
	tanggal
		YYYY: tahun,
		MM: bulan,
		DD: hari.
	>> parameter-pencarian :=
	bd kueri: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: tanggal),
	ambil: { :barisan
		(barisan mydate = tanggal) salah: {
			tugas-ini galat: (
				['Diharapkan: <expected> tapi didapat: <observation>']
				<expected>: tanggal,
				<observation>: barisan mydate
			).
		}.
	}.
	penghitung tambah: 1.
} * 100.


# Waktu
{
	>> jam     := FormatDuaDigit terapkan-bilangan-bulat: (Angka antara: 1 dan: 23), teks.
	>> menit   := FormatDuaDigit terapkan-bilangan-bulat: (Angka antara: 1 dan: 59), teks.
	>> detik   := FormatDuaDigit terapkan-bilangan-bulat: (Angka antara: 1 dan: 59), teks.
	>> waktu := ['HH:II:SS'].
	waktu
		HH: jam,
		II: menit,
		SS: detik.
	>> parameter-pencarian :=
	bd kueri: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: waktu),
	ambil: { :barisan
		(barisan mytime = waktu) salah: {
			tugas-ini galat: (
				['Diharapkan: <expected> tapi didapat: <observation>']
				<expected>: tanggalwaktu,
				<observation>: barisan mytime
			).
		}.
	}.
	penghitung tambah: 1.
} * 100.


# Teks (varchar/text)
>> str1 := Daftar baru isi: 100000 dengan: ['x'], gabungkan: [''].
{
	>> str2 := Brankas token: 40.
	>> parameter-pencarian :=
	bd kueri: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	ambil: { :barisan
		(barisan str1 = str1 dan: barisan str2 = str2) salah: {
			tugas-ini galat: (
				['Diharapkan: <expected> tapi didapat: <observation>']
				<expected>: tanggalwaktu,
				<observation>: barisan mytime
			).
		}.
	}.
	penghitung tambah: 1.
} * 100.


# Angka
{
	>> n1  := Angka antara: 1 dan: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 dari-teks: ['9223372036854775807'] ) -
		( Int64 dari-teks: ['99999'] ) +
		( Int64 dari-teks: n1 teks )
	).
	>> parameter-pencarian :=
	bd kueri: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	ambil: { :barisan
		(barisan n1 = n1) salah: {
			tugas-ini galat: (
				['Diharapkan: <expected> tapi didapat: <observation>']
				<expected>: n1,
				<observation>: barisan n1
			).
		}.
		(barisan n2 = n2) salah: {
			tugas-ini galat: (
				['Diharapkan: <expected> tapi didapat: <observation>']
				<expected>: n1,
				<observation>: barisan n2
			).
		}.
		(barisan n3 = n2 bulatkan) salah: {
			tugas-ini galat: (
				['Diharapkan: <expected> tapi didapat: <observation>']
				<expected>: n1,
				<observation>: barisan n3
			).
		}.
		(barisan big = big) salah: {
			tugas-ini galat: (
				['Diharapkan: <expected> tapi didapat: <observation>']
				<expected>: big,
				<observation>: barisan big
			).
		}.
		
	}.
	penghitung tambah: 1.
} * 100.


Keluaran tulis: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: penghitung
), baris-baru.