Server init.
Keluaran tulis: ['Database datetime test'], baris-baru.

>> db := Maria-DB baru hos: ['localhost'],
	nama-pengguna: ['xo'], 
	kata-sandi: ['pass123'],
	nama-basis-data: ['xobase'],
	sambungkan.

>> parameter-pencarian :=
db kueri: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
ambil: { :row
	Keluaran tulis: row datetimetest, baris-baru.
}.
