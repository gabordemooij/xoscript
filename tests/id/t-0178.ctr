Program manajemen-memori: 0.

>> txt := ['Word Salad'].
Keluaran tulis: ['indeks terakhir dari ord = '] + (( txt posisi-terakhir: ['ord'] ) - 0), baris-baru.
Keluaran tulis: ['indeks dari ord = '] + (( txt temukan: ['ord'] ) - 0), baris-baru.
Keluaran tulis: ['indeks dari ad = '] + (( txt temukan: ['ad'] ) - 0), baris-baru.
Keluaran tulis: ['indeks terakhir dari W = '] + (( txt posisi-terakhir: ['W'] ) - 0), baris-baru.
Keluaran tulis: ['indeks terakhir dari d = '] + (( txt posisi-terakhir: ['d'] ) - 0), baris-baru.
Keluaran tulis: ['txt sama dengan Word Salad = '] + ( txt = ['Word Salad'] ), baris-baru.
Keluaran tulis: ['txt sama dengan Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), baris-baru.
Keluaran tulis: ['txt tidak sama dengan Word Salad = '] + ( txt ≠ ['Word Salad'] ), baris-baru.
Keluaran tulis: ['txt tidak sama dengan Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), baris-baru.

