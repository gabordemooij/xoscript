Program manajemen-memori: 0.

>> txt := ['Word Salad'].
Keluaran tulis: ['last index of ord = '] + (( txt posisi-terakhir: ['ord'] ) - 0), baris-baru.
Keluaran tulis: ['index of ord = '] + (( txt temukan: ['ord'] ) - 0), baris-baru.
Keluaran tulis: ['index of ad = '] + (( txt temukan: ['ad'] ) - 0), baris-baru.
Keluaran tulis: ['last index of W = '] + (( txt posisi-terakhir: ['W'] ) - 0), baris-baru.
Keluaran tulis: ['last index of d = '] + (( txt posisi-terakhir: ['d'] ) - 0), baris-baru.
Keluaran tulis: ['txt equals Word Salad = '] + ( txt = ['Word Salad'] ), baris-baru.
Keluaran tulis: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), baris-baru.
Keluaran tulis: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), baris-baru.
Keluaran tulis: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), baris-baru.

