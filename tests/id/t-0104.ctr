
{ :i
	Keluaran tulis: ['This is step #'] + ( ( i ) + 1 ), baris-baru.
} × 6.

{ :i
	Keluaran tulis: ['This is step #'] + ( 3 - ( i ) ), baris-baru.
} × 6.

{ :i
	Keluaran tulis: ['TIDAK PERNAH!'], baris-baru.
} × 0.



{ :i
	Keluaran tulis: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), baris-baru.
} × 11.
