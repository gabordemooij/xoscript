>> makeAdder := { :x
	>> f := { :y <- (milik x + y). } atur: ['x'] nilai: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i milik q taruh: (milik f terapkan: (milik q ? i)) di: i. } 
	atur: ['q'] nilai: array,
	atur: ['f'] nilai: func.
	{ :i mapping terapkan: i. } × (array jumlah).
}.

>> a := Daftar ← 1; 2; 3.
mapper terapkan: a dan: (makeAdder terapkan: 100).
Keluaran tulis: (a posisi: 0), baris-baru.
Keluaran tulis: (a ? 1), baris-baru.
Keluaran tulis: (a ? 2), baris-baru.
