>> buatPenambah := { :x
	>> f := { :y <- (milik x + y). } atur: ['x'] nilai: x. <- f.
}.
>> pemeta := { :larik :fn
	>> fungsiPeta := { :i milik q taruh: (milik f terapkan: (milik q ? i)) di: i. } 
	atur: ['q'] nilai: larik,
	atur: ['f'] nilai: fn.
	{ :i fungsiPeta terapkan: i. } × (larik jumlah).
}.

>> a := Daftar ← 1; 2; 3.
pemeta terapkan: a dan: (buatPenambah terapkan: 100).
Keluaran tulis: (a posisi: 0), baris-baru.
Keluaran tulis: (a ? 1), baris-baru.
Keluaran tulis: (a ? 2), baris-baru.
