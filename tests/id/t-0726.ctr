# test buffers PKI/Sign 
Server init.

>> long := ( Daftar baru isi: 1000 dengan: ['a'] ) gabungkan: [''].

# sign a message
Keluaran tulis: ( 
	Brankas tanda-tangani: ['abc'] dengan: long
), baris-baru.

Keluaran tulis: ( 
	Brankas
		periksa: ['abc'] 
		tanda-tangan: long 
		dengan: long
), baris-baru.

Keluaran tulis: (
	Brankas hash-kata-sandi: long verifikasi: long
), baris-baru.
