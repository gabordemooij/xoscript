# uji penyangga PKI/Sign 
Server init.

>> panjang-sekali := ( Daftar baru isi: 1000 dengan: ['a'] ) gabungkan: [''].

# tanda tangani pesan
Keluaran tulis: ( 
	Brankas tanda-tangani: ['abc'] dengan: panjang-sekali
), baris-baru.

Keluaran tulis: ( 
	Brankas
		periksa: ['abc'] 
		tanda-tangan: panjang-sekali 
		dengan: panjang-sekali
), baris-baru.

Keluaran tulis: (
	Brankas hash-kata-sandi: panjang-sekali verifikasi: panjang-sekali
), baris-baru.
