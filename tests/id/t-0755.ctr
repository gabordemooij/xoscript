Keluaran tulis: ['Test object'], baris-baru.
>> greeter := Objek baru.
greeter saat: ['name:'] lakukan: { :nama
	milik xname := nama. 
}.
greeter saat: ['greet'] lakukan: {
	Keluaran tulis: ['Hello '] + milik xname, baris-baru.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baru.
>> b := Objek load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
