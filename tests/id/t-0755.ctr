Keluaran tulis: ['Objek uji'], baris-baru.
>> penyapa := Objek baru.
penyapa saat: ['name:'] lakukan: { :nama
	milik xnama := nama. 
}.
penyapa saat: ['sapa'] lakukan: {
	Keluaran tulis: ['Halo '] + milik xnama, baris-baru.
}.
penyapa name: ['Sherlock'].
penyapa save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== MEMUAT ULANG SNAP:'], baris-baru.
>> b := Objek load-from: ['/tmp/a.bin'].
b sapa.
b name: ['Watson'], sapa.
