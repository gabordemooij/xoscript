# uji basis data
# lihat contoh server.xo untuk konfigurasi yang diperlukan

Server init.
Keluaran tulis: ['Tes basis data'], baris-baru.

>> bd := Maria-DB baru hos: ['localhost'],
	nama-pengguna: ['xo'], kata-sandi: ['pass123'], nama-basis-data: ['xobase'], sambungkan.

Keluaran tulis: ['Bisakah kita terhubung? '] + bd tersambung?, baris-baru.

>> parameter-pencarian := bd kueri: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parameter: ( Daftar baru ; ['abc'] ; 12.35 ; 6 ). # kueri berparameter

{  parameter-pencarian jalankan. bd komit. } tangkap: { :e bd batalkan.  }, mulai.

Keluaran tulis: ['Bisakah kita menyisipkan? '] + ( parameter-pencarian insert-id > 0 ), baris-baru.

>> x := 0.
>> parameter-pencarian :=
bd kueri: ['SELECT * FROM book order by id desc limit 2'], 
ambil: { :barisan 
	x tambah: 1.
	Benar hentikan. # harus dibersihkan, tanpa 'Commands out of sync'
}.

>> parameter-pencarian :=
bd kueri: ['SELECT * FROM book order by id desc limit 2'], 
ambil: { :barisan
	x tambah: 1.
	Benar hentikan.
}.

(x > 0) benar: {
	Keluaran tulis: ['Bisakah kita berhenti di tengah fetch? '].
}.

Keluaran tulis: Benar, baris-baru.