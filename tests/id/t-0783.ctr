Keluaran tulis: ['Test object'], baris-baru.
>> a := Objek baru. 

a saat: ['item:'] lakukan: { :moment
	milik moment := moment. 
}.

a saat: ['item'] lakukan: { <- milik moment.
}.

>> today := Momen baru zona: ['CEST'], tahun: 2026, bulan: 7.
a item: today.
Keluaran tulis: a item, baris-baru.
a save-as: ['/tmp/a.bin'].

