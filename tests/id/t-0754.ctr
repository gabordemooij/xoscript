Keluaran tulis: ['Test object'], baris-baru.
>> a := Objek baru. 

a saat: ['item:'] lakukan: { :out
	milik out := out. 
}.

a saat: ['item'] lakukan: { <- milik out.
}.

a saat: ['greet'] lakukan: {
	Keluaran tulis: ['hi from original out!'], baris-baru.
}.

a item: Keluaran.

Keluaran tulis: a item, baris-baru.

>> old-out-address := a item prototipe alamat-memori.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baru.

>> b := Objek load-from: ['/tmp/a.bin'].

(b item prototipe alamat-memori = old-out-address) benar: {
	Keluaran tulis: ['Object link re-attached.'], baris-baru.
}.

b item tulis: ['hello from loaded out!'], baris-baru.
b greet.
