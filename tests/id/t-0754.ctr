Keluaran tulis: ['Objek uji'], baris-baru.
>> a := Objek baru. 

a saat: ['item:'] lakukan: { :klr
	milik klr := klr. 
}.

a saat: ['barang'] lakukan: {
	<- milik klr.
}.

a saat: ['sapa'] lakukan: {
	Keluaran tulis: ['hai dari out asli!'], baris-baru.
}.

a item: Keluaran.

Keluaran tulis: a barang, baris-baru.

>> alamat-lama-klr := a barang prototipe alamat-memori.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== MEMUAT ULANG SNAP:'], baris-baru.

>> b := Objek load-from: ['/tmp/a.bin'].

(b barang prototipe alamat-memori = alamat-lama-klr) benar: {
	Keluaran tulis: ['Tautan objek dipasang kembali.'], baris-baru.
}.

b barang tulis: ['halo dari out yang dimuat!'], baris-baru.
b sapa.
