
Server init.
Keluaran tulis: ['Database test'], baris-baru.

>> db := Maria-DB baru hos: ['localhost'],
	nama-pengguna: ['xo'], 
	kata-sandi: ['pass123'],
	nama-basis-data: ['xobase'],
	sambungkan.

>> parameter-pencarian :=
db kueri: ['SELECT UNHEX('CAFE') AS blobby'],
ambil: { :row
	Keluaran tulis: ( row blobby dari: 0 panjang: 2 ), baris-baru.
	row blobby bebaskan.
}.
