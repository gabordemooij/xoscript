
Server init.
Keluaran tulis: ['Tes basis data'], baris-baru.

>> bd := Maria-DB baru hos: ['localhost'],
	nama-pengguna: ['xo'], 
	kata-sandi: ['pass123'],
	nama-basis-data: ['xobase'],
	sambungkan.

>> parameter-pencarian :=
bd kueri: ['SELECT UNHEX('CAFE') AS blobby'],
ambil: { :barisan
	Keluaran tulis: ( barisan blobby dari: 0 panjang: 2 ), baris-baru.
	barisan blobby bebaskan.
}.
