Angka saat: ['factorial'] lakukan: {
	>> total := 1.
	{ :index total kalikan-dengan: (diri - (index)). } × diri. <- total.
}.
>> Printer := Objek baru.
Printer saat: ['print:and:'] lakukan: { :x :y
	Keluaran tulis: ['a='] + x + [', b='] + y, baris-baru.
}.
>> a := 4.5. >> b := a bulatkan-ke-bawah.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a bulatkan-ke-atas.
Printer print: a and: b.
a := 4.5. b := a bulatkan-ke-bawah.
Printer print: a and: b.
a := 4.5. b := a bulatkan.
Printer print: a and: b.
a := 4.2. b := a bulatkan.
Printer print: a and: b.

Keluaran tulis: (9 sisa-bagi: 5), baris-baru.
Keluaran tulis: -666 mutlak, baris-baru.
Keluaran tulis: 49 akar-kuadrat, baris-baru.
Keluaran tulis: (2 pangkat: 3), baris-baru.
>> l := (Daftar ← 9 ; 6).
Keluaran tulis: l minimum.

