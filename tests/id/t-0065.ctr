Angka saat: ['faktorial'] lakukan: {
	>> total := 1.
	{ :indeks total kalikan-dengan: (diri - (indeks)). } × diri. <- total.
}.
>> Pencetak := Objek baru.
Pencetak saat: ['cetak:dan:'] lakukan: { :x :y
	Keluaran tulis: ['a='] + x + [', b='] + y, baris-baru.
}.
>> a := 4.5. >> b := a bulatkan-ke-bawah.
Pencetak cetak: a dan: b.
