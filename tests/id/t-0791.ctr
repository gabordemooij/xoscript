Server init.

>> DB := Maria-DB baru hos: ['localhost'],
	nama-pengguna: ['xo'],
	kata-sandi: ['pass123'],
	nama-basis-data: ['xobase'],
	sambungkan.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> parameter-pencarian := Maria-Kueri baru: SQL.

# set database
parameter-pencarian basis-data: DB.

parameter-pencarian ambil: { :row
	Keluaran tulis: row world, baris-baru.
}.
