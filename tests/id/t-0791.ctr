Server init.

>> BD := Maria-DB baru hos: ['localhost'],
	nama-pengguna: ['xo'],
	kata-sandi: ['pass123'],
	nama-basis-data: ['xobase'],
	sambungkan.
	
>> SQL := ['SELECT "hello" AS "world" '].

# buat kueri secara manual
>> parameter-pencarian := Maria-Kueri baru: SQL.

# atur basis data
parameter-pencarian basis-data: BD.

parameter-pencarian ambil: { :barisan
	Keluaran tulis: barisan world, baris-baru.
}.
