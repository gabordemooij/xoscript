Program manajemen-memori: 4.

>> Pengganda := Objek baru.
>> Pengali := Objek baru.
Pengganda saat: ['gandakan:dan:'] lakukan: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Pengali saat: ['kalikan:dan:'] lakukan: { :x :y <- (x × y).
}.

Keluaran tulis: (
	Pengganda gandakan:
		(Pengganda gandakan: 
			(Pengali kalikan: 2 dan: 3)
		dan:
			(Pengali kalikan: 3 dan: 4)
		)
	dan:
		(Pengganda gandakan: 
			(Pengali kalikan: 2 dan: 3)
		dan:
			(Pengali kalikan: 3 dan: 4)
		)
), baris-baru.
