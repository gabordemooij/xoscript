Program manajemen-memori: 4.

>> Doubler := Objek baru.
>> Multiplier := Objek baru.
Doubler saat: ['double:and:'] lakukan: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier saat: ['multiply:and:'] lakukan: { :x :y <- (x × y).
}.

Keluaran tulis: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), baris-baru.
