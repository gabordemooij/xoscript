Keluaran tulis: ['Objek uji'], baris-baru.
>> a := Objek baru. 

a saat: ['item:'] lakukan: { :pembantuokt
	milik pembantuokt := pembantuokt. 
}.

a saat: ['barang'] lakukan: {
	<- milik pembantuokt.
}.

a item: Oct baru.

>> alamat-lama-pembantuokt := a barang prototipe alamat-memori.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== MEMUAT ULANG SNAP:'], baris-baru.

>> b := Objek load-from: ['/tmp/a.bin'].

(b barang prototipe alamat-memori = alamat-lama-pembantuokt) benar: {
	Keluaran tulis: ['Tautan objek dipasang kembali.'], baris-baru.
}.
