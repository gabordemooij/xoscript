Keluaran tulis: ['Test object'], baris-baru.
>> a := Objek baru. 

a saat: ['item:'] lakukan: { :octhelper
	milik octhelper := octhelper. 
}.

a saat: ['item'] lakukan: { <- milik octhelper.
}.

a item: Oct baru.

>> old-octhelper-address := a item prototipe alamat-memori.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baru.

>> b := Objek load-from: ['/tmp/a.bin'].

(b item prototipe alamat-memori = old-octhelper-address) benar: {
	Keluaran tulis: ['Object link re-attached.'], baris-baru.
}.
