Keluaran tulis: ['Test object'], baris-baru.
>> a := Objek baru. 

a saat: ['item:'] lakukan: { :binhelper
	milik binhelper := binhelper. 
}.

a saat: ['item'] lakukan: { <- milik binhelper.
}.

a item: Bin baru.

>> old-binhelper-address := a item prototipe alamat-memori.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baru.

>> b := Objek load-from: ['/tmp/a.bin'].

(b item prototipe alamat-memori = old-binhelper-address) benar: {
	Keluaran tulis: ['Object link re-attached.'], baris-baru.
}.


