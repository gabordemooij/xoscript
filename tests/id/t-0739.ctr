Keluaran tulis: ['Objek uji'], baris-baru.
>> a := Objek baru. 

a saat: ['item:'] lakukan: { :pembantubin
	milik pembantubin := pembantubin. 
}.

a saat: ['barang'] lakukan: {
	<- milik pembantubin.
}.

a item: Bin baru.

>> alamat-lama-pembantubin := a barang prototipe alamat-memori.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== MEMUAT ULANG SNAP:'], baris-baru.

>> b := Objek load-from: ['/tmp/a.bin'].

(b barang prototipe alamat-memori = alamat-lama-pembantubin) benar: {
	Keluaran tulis: ['Tautan objek dipasang kembali.'], baris-baru.
}.


