60 × {
	>> x := (Angka acak % 6) + 1.
	(x ≤ 6) salah: { Keluaran tulis: ['GAGAL']. }.
	(x ≥0) salah: { Keluaran tulis: ['GAGAL']. }.
	x := (Angka acak % 3) + 1.
	(x < 3) salah: { Keluaran tulis: ['GAGAL']. }.
	(x>-1) salah: { Keluaran tulis: ['GAGAL']. }.
	x := ((Boolean lempar) angka).
	(x = 0 atau: x = 1) salah: { Keluaran tulis: ['GAGAL']. }.
	x := ((Benar lempar) angka).
	(x = 0 atau: x = 1) salah: { Keluaran tulis: ['GAGAL']. }.
	x := (Boolean lempar pilih: ['GAMBAR'] atau: ['ANGKA']).
	((x = ['GAMBAR']) atau: (x = ['ANGKA'])) salah: { Keluaran tulis: ['GAGAL']. }.
}.
Keluaran tulis: ['SELESAI'].

