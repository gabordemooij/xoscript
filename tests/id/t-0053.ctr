60 × {
	>> x := (Angka random % 6) + 1.
	(x ≤ 6) salah: { Keluaran tulis: ['FAIL']. }.
	(x ≥0) salah: { Keluaran tulis: ['FAIL']. }.
	x := (Angka random % 3) + 1.
	(x < 3) salah: { Keluaran tulis: ['FAIL']. }.
	(x>-1) salah: { Keluaran tulis: ['FAIL']. }.
	x := ((Boolean flip) angka).
	(x = 0 atau: x = 1) salah: { Keluaran tulis: ['FAIL']. }.
	x := ((Benar flip) angka).
	(x = 0 atau: x = 1) salah: { Keluaran tulis: ['FAIL']. }.
	x := (Boolean flip pilih: ['HEAD'] atau: ['TAIL']).
	((x = ['HEAD']) atau: (x = ['TAIL'])) salah: { Keluaran tulis: ['FAIL']. }.
}.
Keluaran tulis: ['DONE'].

