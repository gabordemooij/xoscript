>> Titik := Objek baru.
Titik saat: ['x-coordinate:'] lakukan: { :x milik x := x. }.
Titik saat: ['y-coordinate:'] lakukan: { :y milik y := y. }.
Titik saat: ['koordinat-x']  lakukan: { <- milik x salin. }.
Titik saat: ['koordinat-y']  lakukan: { <- milik y salin. }.

Titik saat: ['='] lakukan: { :lainnya
	<- ( milik x = lainnya koordinat-x
		 dan: milik y = lainnya koordinat-y ).
}.

>> dermaga := Titik baru x-coordinate: 5, y-coordinate: 6.
>> balai-kota := Titik baru x-coordinate: 7, y-coordinate: 1.
>> restoran := Titik baru x-coordinate: 5, y-coordinate: 6.

Keluaran tulis: dermaga = balai-kota, baris-baru.
Keluaran tulis: dermaga = restoran, baris-baru.
