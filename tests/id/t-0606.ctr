>> Point := Objek baru.
Point saat: ['x-coordinate:'] lakukan: { :x milik x := x. }.
Point saat: ['y-coordinate:'] lakukan: { :y milik y := y. }.
Point saat: ['x-coordinate']  lakukan: { <- milik x salin. }.
Point saat: ['y-coordinate']  lakukan: { <- milik y salin. }.

Point saat: ['='] lakukan: { :other <- ( milik x = other x-coordinate
		 dan: milik y = other y-coordinate ).
}.

>> pier := Point baru x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point baru x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point baru x-coordinate: 5, y-coordinate: 6.

Keluaran tulis: pier = town-hall, baris-baru.
Keluaran tulis: pier = restaurant, baris-baru.
