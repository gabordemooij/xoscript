#Linux
>> clock := Momen baru.
clock zona: ['UTC-1'].
clock tahun: 1981, bulan: 1, hari: 5,
      jam: 13, menit: 15, detik: 13.

Keluaran tulis: clock, baris-baru.
clock zona: ['UTC+0'].

Keluaran tulis: (
	(clock tahun polos) + ['-'] + (clock bulan) + ['-'] + (clock hari) + [' '] +
	(clock jam) + [':'] + (clock menit) + [':'] + (clock detik) + [' '] +
	['W'] + (clock minggu) + (clock zona)
), baris-baru.


clock zona: ['UTC-1'].
Keluaran tulis: (
	(clock tahun polos) + ['-'] + (clock bulan) + ['-'] + (clock hari) + [' '] +
	(clock jam) + [':'] + (clock menit) + [':'] + (clock detik) + [' '] +
	['W'] + (clock minggu) + (clock zona)
), baris-baru.
