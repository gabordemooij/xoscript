#Linux
>> arloji := Momen baru.
arloji zona: ['UTC-1'].
arloji tahun: 1981, bulan: 1, hari: 5,
      jam: 13, menit: 15, detik: 13.

Keluaran tulis: arloji, baris-baru.
arloji zona: ['UTC+0'].

Keluaran tulis: (
	(arloji tahun polos) + ['-'] + (arloji bulan) + ['-'] + (arloji hari) + [' '] +
	(arloji jam) + [':'] + (arloji menit) + [':'] + (arloji detik) + [' '] +
	['W'] + (arloji minggu) + (arloji zona)
), baris-baru.


arloji zona: ['UTC-1'].
Keluaran tulis: (
	(arloji tahun polos) + ['-'] + (arloji bulan) + ['-'] + (arloji hari) + [' '] +
	(arloji jam) + [':'] + (arloji menit) + [':'] + (arloji detik) + [' '] +
	['W'] + (arloji minggu) + (arloji zona)
), baris-baru.
