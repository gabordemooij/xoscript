# mengembalikan non-teks dari match/do seharusnya tidak masalah
>> subject := ['abc'].
>> pola-cari := Pola baru: ['([ac])'].
>> hasil  := pola-cari cocok: subject lakukan: { :m :x
	Keluaran tulis: m, baris-baru.
	Keluaran tulis: x, baris-baru.
	<- Kosong.
}.
Keluaran tulis: hasil, baris-baru.