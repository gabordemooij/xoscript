>> Hewan := Objek baru.
Hewan saat: ['buat'] lakukan: {
	>> hewan := Objek baru.
	hewan saat: ['bersuara'] lakukan: {
		Keluaran tulis: milik suara.
	}. <- hewan.
}.
>> Kucing := Objek baru.
Kucing saat: ['buat'] lakukan: {
	>> kucing := Hewan buat.
	kucing saat: ['init'] lakukan: {
		milik suara := ['meow!'].
	}.
	kucing init. <- kucing.
}.
>> tom := Kucing buat.
tom bersuara.
