>> a := Daftar ← Objek ; Benar ; Salah ; Boolean ; 1 ; Angka ; ['Str'] ; Teks ; { ['Kosong']. }.
Keluaran tulis: (a jumlah), baris-baru.
{ :i
	Keluaran tulis: 
	['a '] + 
	((a ? i) tipe) +
	([' \‘this\’ '] this: (a ? i))  +
	[' adalah '] +
	(((a ? i) Kosong?) pilih: [''] atau: ['BUKAN']) + 
	[' Kosong.'],
	baris-baru.
} × (a jumlah).
Keluaran tulis: ['tapi.. Kosong itu.. '] + ((Kosong Kosong?) pilih: ['pasti KOSONG!'] atau: ['bukan KOSONG??']), baris-baru.