>> a := Daftar ← Objek ; Benar ; Salah ; Boolean ; 1 ; Angka ; ['Str'] ; Teks ; { ['Empty']. }.
Keluaran tulis: (a jumlah), baris-baru.
{ :i
	Keluaran tulis: 
	['a '] + 
	((a ? i) tipe) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Kosong?) pilih: [''] atau: ['NOT']) + 
	[' Nil.'],
	baris-baru.
} × (a jumlah).
Keluaran tulis: ['but.. Nil is.. '] + ((Kosong Kosong?) pilih: ['certainly NIL!'] atau: ['not NIL??']), baris-baru.