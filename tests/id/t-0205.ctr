>> str := ['write:'].
Keluaran pesan: ['tulis:'] argumen: (Daftar ← ['Hello World']), baris-baru. 

Angka saat: ['isbetween:and:'] lakukan: { :a :b <- ((diri ≥ a) dan: (diri ≤ b)).
}.

str := ['isbetween:and:'].
Keluaran tulis: (3 pesan: str argumen: (Daftar ← 2 ; 8)), baris-baru.
Keluaran tulis: (3 pesan: str argumen: (Daftar ← 1 ; 2)), baris-baru.


>> CoffeeMachine := Objek baru.
CoffeeMachine saat: ['makeCoffeeWithSugar:milk:'] lakukan: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Daftar ← 4 ; 2.
Keluaran tulis: ( CoffeeMachine pesan: order argumen: coffeeConfiguration ), baris-baru.
