>> str := ['write:'].
Keluaran pesan: ['tulis:'] argumen: (Daftar ← ['Hello World']), baris-baru. 

Angka saat: ['isbetween:and:'] lakukan: { :a :b <- ((diri ≥ a) dan: (diri ≤ b)).
}.

str := ['isbetween:and:'].
Keluaran tulis: (3 pesan: str argumen: (Daftar ← 2 ; 8)), baris-baru.
Keluaran tulis: (3 pesan: str argumen: (Daftar ← 1 ; 2)), baris-baru.


>> MesinKopi := Objek baru.
MesinKopi saat: ['makeCoffeeWithSugar:milk:'] lakukan: { :sugar :milk <- ( ['Silakan... kopi dengan '] + 
			sugar +
			[' sendok gula dan '] +
			milk +
			[' tetes susu.']
	).
}.

>> pesanan := ['makeCoffeeWithSugar:milk:'].
>> konfigurasiKopi := Daftar ← 4 ; 2.
Keluaran tulis: ( MesinKopi pesan: pesanan argumen: konfigurasiKopi ), baris-baru.
