Keluaran tulis: ['Objek uji'], baris-baru.
>> a := Objek baru. 

a saat: ['item:'] lakukan: { :fmt
	milik fmt := fmt. 
}.

a saat: ['barang'] lakukan: {
	<- milik fmt.
}.

a item: ( Format baru: ['|%s|'] ).

Keluaran tulis: a barang, baris-baru.

>> alamat-lama-fmt := a barang prototipe alamat-memori.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== MEMUAT ULANG SNAP:'], baris-baru.

>> b := Objek load-from: ['/tmp/a.bin'].

(b barang prototipe alamat-memori = alamat-lama-fmt) benar: {
	Keluaran tulis: ['Tautan objek dipasang kembali.'], baris-baru.
}.

Keluaran tulis: ( b barang terapkan: ['hello'] ), baris-baru.
