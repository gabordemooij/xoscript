Keluaran tulis: ['Test object'], baris-baru.
>> a := Objek baru. 

a saat: ['item:'] lakukan: { :fmt
	milik fmt := fmt. 
}.

a saat: ['item'] lakukan: { <- milik fmt.
}.

a item: ( Format baru: ['|%s|'] ).

Keluaran tulis: a item, baris-baru.

>> old-fmt-address := a item prototipe alamat-memori.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baru.

>> b := Objek load-from: ['/tmp/a.bin'].

(b item prototipe alamat-memori = old-fmt-address) benar: {
	Keluaran tulis: ['Object link re-attached.'], baris-baru.
}.

Keluaran tulis: ( b item terapkan: ['hello'] ), baris-baru.
