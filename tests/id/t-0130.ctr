# menggunakan FFI dengan plugin Server

# sambungkan ke libc (tergantung platform)
>> namapustaka := Program pengaturan: ['FFITESTLIB'].

# tautkan fungsi stdio dari C untuk operasi berkas lanjutan
Server tautkan: ( Daftar baru ;
 namapustaka ; ['fopen'] ;
 ( Daftar baru ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
tautkan: ( Daftar baru ;
 Kosong ; # berarti pustaka yang sama
 ['fread'] ;
 ( Daftar baru ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Kosong ; # berarti objek yang sama (yaitu Aliran)
 ['fread']
),
tautkan: (
 Daftar baru ;
 Kosong ; # berarti pustaka yang sama
 ['fwrite'] ;
 ( Daftar baru ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Kosong ; # berarti pustaka yang sama
 ['fwrite']
),
tautkan: (
 Daftar baru ;
 Kosong ; # berarti pustaka yang sama
 ['rewind'] ;
 ( Daftar baru ; ['pointer'] ) ;
 ['int'] ;
 Kosong ; # berarti pustaka yang sama
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> jalur := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# buka berkas dengan fopen(path, mode)
>> fd := Stream path: jalur mode: mode.

# tulis byte dari penyangga untaian ke berkas
>> bita-tertulis := Stream pesan: ['fwrite'] argumen: (Daftar baru ; str ; 1 ; 6 ; fd ).
Keluaran tulis: bita-tertulis, baris-baru.

# putar balik penunjuk berkas
Stream rewind: fd.

# alokasikan penyangga
>> pyg := Blob baru: 20.

# baca dari berkas
>> bita-terbaca := Stream pesan: ['fread'] argumen: (Daftar baru ; pyg ; 1 ; 6 ; fd ).
Keluaran tulis: bita-terbaca, baris-baru.
Keluaran tulis: pyg, baris-baru.

# bebaskan memori
str  bebaskan.
jalur bebaskan.
mode bebaskan.
pyg  bebaskan.


