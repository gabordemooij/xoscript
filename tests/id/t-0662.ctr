>> t := Kosong.

# you can control the time zone for
# parsing like this:
Momen zona: ['CET'].
t := Momen dari: ['1981-02-03 04:05:06'].
Keluaran tulis: t, baris-baru.

# now using CEST time zone:
Momen zona: ['CEST'].
t := Momen dari: ['1981-02-03 04:05:06'].
Keluaran tulis: t, baris-baru.

# error if string cannot be parsed
{ Momen dari: ['1900']. } tangkap: { Kosong. }, mulai.
