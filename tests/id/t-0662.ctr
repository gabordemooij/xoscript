>> t := Kosong.

# Anda dapat mengatur zona waktu untuk
# penguraian seperti ini:
Momen zona: ['CET'].
t := Momen dari: ['1981-02-03 04:05:06'].
Keluaran tulis: t, baris-baru.

# sekarang menggunakan zona waktu CEST:
Momen zona: ['CEST'].
t := Momen dari: ['1981-02-03 04:05:06'].
Keluaran tulis: t, baris-baru.

# galat jika teks tidak dapat diurai
{ Momen dari: ['1900']. } tangkap: { Kosong. }, mulai.
