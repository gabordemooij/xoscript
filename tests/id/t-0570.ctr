#Linux

 >> t := Momen baru.
 
t zona: ['Europe/Amsterdam'].
t tahun: 2020, bulan: 8, hari: 2, jam: 21, menit: 2, detik: 1.

>> a := t jam.
>> ams := t zona.

t zona: ['US/Hawaii'].
>> b := t jam.
>> hw := t zona.

Keluaran
tulis: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		pilih: ['later'] atau: ['earlier']
	)
),
baris-baru.
 