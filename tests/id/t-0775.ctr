Keluaran tulis: ['Objek uji'], baris-baru.
>> l := Daftar baru ; 1 ; ( Daftar baru ; (Momen baru: 1) ; (Int64 dari-teks: ['321']) ; (Daftar baru ; 3)).
Keluaran tulis: l, baris-baru.
>> alamat-lama-dft := l prototipe alamat-memori.
l save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== MEMUAT ULANG SNAP:'], baris-baru.
>> b := Objek load-from: ['/tmp/a.bin'].
(b prototipe alamat-memori = alamat-lama-dft) benar: {
	Keluaran tulis: ['Tautan objek dipasang kembali.'], baris-baru.
}.
Keluaran tulis: b, baris-baru.
