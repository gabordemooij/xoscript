Keluaran tulis: ['Test object'], baris-baru.
>> l := Daftar baru ; 1 ; ( Daftar baru ; (Momen baru: 1) ; (Int64 dari-teks: ['321']) ; (Daftar baru ; 3)).
Keluaran tulis: l, baris-baru.
>> old-lst-address := l prototipe alamat-memori.
l save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baru.
>> b := Objek load-from: ['/tmp/a.bin'].
(b prototipe alamat-memori = old-lst-address) benar: {
	Keluaran tulis: ['Object link re-attached.'], baris-baru.
}.
Keluaran tulis: b, baris-baru.
