>> x := [' hallo '].

>> y := x huruf-besar.
Keluaran tulis: x, baris-baru.
Keluaran tulis: (x sama-dengan: y), baris-baru.

>> y := x huruf-kecil.
Keluaran tulis: x, baris-baru.
Keluaran tulis: (x sama-dengan: y), baris-baru.

>> y := x pangkas.
Keluaran tulis: x, baris-baru.
Keluaran tulis: (x sama-dengan: y), baris-baru.

>> y := x lewati: 1.
Keluaran tulis: x, baris-baru.
Keluaran tulis: (x sama-dengan: y), baris-baru.

>> y := x dari: 1 panjang: 2.
Keluaran tulis: x, baris-baru.
Keluaran tulis: (x sama-dengan: y), baris-baru.