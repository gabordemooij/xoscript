Server init.
>> f := Format baru: ['%d'].
>> a := Blob baru: 4.
a bytes: ( Daftar baru ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob baru: 4.
b bytes: ( Daftar baru ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a dari: 0 panjang: 3, setiap: { :i :byte
	Keluaran tulis: ( f terapkan-bilangan-bulat: byte ) , baris-baru.
}.
a ^ b.
a dari: 0 panjang: 3, setiap: { :i :byte
	Keluaran tulis: ( f terapkan-bilangan-bulat: byte ) , baris-baru.
}.
a ^ b.
a dari: 0 panjang: 3, setiap: { :i :byte
	Keluaran tulis: ( f terapkan-bilangan-bulat: byte ) , baris-baru.
}.
a bebaskan.
b bebaskan.

{ a ^ Objek. } tangkap: { :e Keluaran tulis: e, baris-baru. }, mulai.
