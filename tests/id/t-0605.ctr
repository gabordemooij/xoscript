>> invoice := Objek baru.
invoice saat: ['mulai'] lakukan: {
        milik angka := 0.
}.

invoice saat: ['angka'] lakukan: {
        milik angka tambah: 1. <- milik angka salin.
}.

>> year-invoice := invoice baru.
year-invoice saat: ['start:'] lakukan: { :tahun
	milik angka := tahun.
}.

year-invoice start: 202000.
Keluaran tulis: year-invoice angka, baris-baru.
Keluaran tulis: year-invoice angka, baris-baru.
