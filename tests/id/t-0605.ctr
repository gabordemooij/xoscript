>> faktur := Objek baru.
faktur saat: ['mulai'] lakukan: {
        milik angka := 0.
}.

faktur saat: ['angka'] lakukan: {
        milik angka tambah: 1.
        <- milik angka salin.
}.

>> faktur-tahunan := faktur baru.
faktur-tahunan saat: ['start:'] lakukan: { :tahun
	milik angka := tahun.
}.

faktur-tahunan start: 202000.
Keluaran tulis: faktur-tahunan angka, baris-baru.
Keluaran tulis: faktur-tahunan angka, baris-baru.
