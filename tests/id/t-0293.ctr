
>> city := Daftar ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Daftar ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature menurut: city.
>> cities := weather kunci-kunci urutkan: { :a :b <- (a bandingkan: b). }.
>> temperatures := weather nilai-nilai urutkan: { :a :b <- (a bandingkan: b) negatif?. }.

Keluaran tulis: (cities gabungkan: [',']), baris-baru.
Keluaran tulis: (temperatures gabungkan: [',']), baris-baru.
