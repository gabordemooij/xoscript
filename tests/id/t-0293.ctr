
>> kota := Daftar ← ['London'] ; ['Paris'] ; ['Berlin'].
>> suhu := Daftar ← ['15'] ; ['16'] ; ['15'].
>> cuaca := suhu menurut: kota.
>> kota-kota := cuaca kunci-kunci urutkan: { :a :b <- (a bandingkan: b). }.
>> suhu-suhu := cuaca nilai-nilai urutkan: { :a :b <- (a bandingkan: b) negatif?. }.

Keluaran tulis: (kota-kota gabungkan: [',']), baris-baru.
Keluaran tulis: (suhu-suhu gabungkan: [',']), baris-baru.
