
>> kamus-kata := (
	Kamus baru
		taruh: ['b'] di: ['a'],
		taruh: ['a'] di: ['b'],
		taruh: ['z'] di: ['x'],
		taruh: ['hello'] di: ['hallo'],
		taruh: ['manusia'] di: ['manusia']
).

>> perbandingan := Daftar baru.
kamus-kata setiap: { :a :b
	perbandingan ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a bandingkan: b)
	).
}.

perbandingan urutkan: { :a :b <- ( a bandingkan: b ). }.
Keluaran tulis: ( perbandingan gabungkan: ['↵'] ), baris-baru.
perbandingan gabungkan: ['↵'].
