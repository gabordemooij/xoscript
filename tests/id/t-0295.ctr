
>> dictionary := (
	Kamus baru
		taruh: ['b'] di: ['a'],
		taruh: ['a'] di: ['b'],
		taruh: ['z'] di: ['x'],
		taruh: ['hello'] di: ['hallo'],
		taruh: ['human'] di: ['human']
).

>> comparisons := Daftar baru.
dictionary setiap: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a bandingkan: b)
	).
}.

comparisons urutkan: { :a :b <- ( a bandingkan: b ). }.
Keluaran tulis: ( comparisons gabungkan: ['↵'] ), baris-baru.
comparisons gabungkan: ['↵'].
