>> V := Objek.
V saat: ['teks'] lakukan: {
	Keluaran tulis: ['cast'], baris-baru.
	<- ['abc'].
}.

Keluaran tulis: ( Program pengaturan: ['abc'] ), baris-baru.

# parameter-url tidak boleh terkena gc
Program pengaturan: ([''] + V baru) nilai: ([''] + V baru).

Keluaran tulis: ( Program pengaturan: ['abc'] ), baris-baru.
