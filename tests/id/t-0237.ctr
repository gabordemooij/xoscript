
Teks saat: ['evaluasi'] lakukan: {
	>> kode := Berkas baru: ['/tmp/eval.ctr'].
	kode tulis: (diri teks + ['.']).
	Program gunakan: ['/tmp/eval.ctr'].
}.

>> map :=
	(Kamus baru)
	taruh: ['Hai Semua'] di: ['two'],
	taruh: (Daftar ← ['hello'] ; ['world'] ; (Daftar ← 1 ; 2; 9) ; Salah) di: ['satu'],
	taruh: ( (Kamus baru) taruh: ['wrrld'] di: ['salah-eja'] ) di: ['three'],
	taruh: (Daftar ← ((Kamus baru) taruh: ['harta karun'] di: ['tersembunyi']) ; 2) di: ['empat']. 
>> str := map teks.
>> map2 := Kosong.
(['map2 := '] + str ) evaluasi.
Keluaran tulis: map2 ? ['satu'] ? 0.
Keluaran tulis: map2 ? ['satu'] ? 1.
Keluaran tulis: map2 ? ['empat'] ? 0 ? ['tersembunyi'].
Keluaran tulis: map2 ? ['satu'] ? 2 ? 2.
