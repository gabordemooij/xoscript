
Teks saat: ['evaluate'] lakukan: {
	>> kode := Berkas baru: ['/tmp/eval.ctr'].
	kode tulis: (diri teks + ['.']).
	Program gunakan: ['/tmp/eval.ctr'].
}.

>> map :=
	(Kamus baru)
	taruh: ['Hi There'] di: ['two'],
	taruh: (Daftar ← ['hello'] ; ['world'] ; (Daftar ← 1 ; 2; 9) ; Salah) di: ['one'],
	taruh: ( (Kamus baru) taruh: ['wrrld'] di: ['misspelled'] ) di: ['three'],
	taruh: (Daftar ← ((Kamus baru) taruh: ['treasure'] di: ['hidden']) ; 2) di: ['four']. 
>> str := map teks.
>> map2 := Kosong.
(['map2 := '] + str ) evaluate.
Keluaran tulis: map2 ? ['one'] ? 0.
Keluaran tulis: map2 ? ['one'] ? 1.
Keluaran tulis: map2 ? ['four'] ? 0 ? ['hidden'].
Keluaran tulis: map2 ? ['one'] ? 2 ? 2.
