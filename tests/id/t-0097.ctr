
Teks saat: ['html'] lakukan: { <- (
		diri
		ganti: ['&'] dengan: ['&amp;'],
		ganti: ['<'] dengan: ['&lt;'],
		ganti: ['>'] dengan: ['&gt;'],
		ganti: ['"'] dengan: ['&quot;']
	).
}.

>> KuasHtml := Objek baru.

KuasHtml saat: ['tanggapi:'] lakukan: { :tag
	Keluaran tulis: (['<tag>↵'] tag: tag ).
}.

KuasHtml saat: ['tanggapi:dan:'] lakukan: { :tag :content
	tag := ( tag dari: 0 panjang: (tag panjang - 1) ).
	Keluaran tulis: (['<tag content>↵'] tag: tag, content: content).
}.

KuasHtml saat: ['content:'] lakukan: { :tulisan
	Keluaran tulis: tulisan html, baris-baru.
}.

KuasHtml saat: ['atr:nilai:'] lakukan: { :atr :value <- ['attr="value"'] attr: atr, value: value.
}.

>> h := KuasHtml baru.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h atr: ['class'] nilai: ['bold']),
		/span
	/body
/html.
		
