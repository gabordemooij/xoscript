	arloji zona: ['CET'],
	tahun: 2017, bulan: 7, hari: 13,
	jam: 18, menit: 0, detik: 0.
}, selain-itu: {
	arloji zona: ['Europe/Amsterdam'],
	tahun: 2017, bulan: 7, hari: 13,
	jam: 18, menit: 0, detik: 0.
}.

arloji saat: ['beritahu'] lakukan: {
	Keluaran tulis: diri, baris-baru.
}.


