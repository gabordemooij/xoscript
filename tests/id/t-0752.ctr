Keluaran tulis: ['Test object'], baris-baru.
>> a := Objek baru. 

a saat: ['item:'] lakukan: { :boolean
	milik boolean := boolean. 
}.

a saat: ['item'] lakukan: { <- milik boolean.
}.

a item: Boolean.

Keluaran tulis: a item, baris-baru.

>> old-bool-address := a item prototipe alamat-memori.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baru.

>> b := Objek load-from: ['/tmp/a.bin'].

(b item prototipe alamat-memori = old-bool-address) benar: {
	Keluaran tulis: ['Object link re-attached.'], baris-baru.
}.

Keluaran tulis: b item, baris-baru.
