# tanda kutip yang tidak pernah ditutup harus memberi galat, bukan perulangan tanpa akhir
>> jalur := ['/tmp/test0821.csv'].
>> file := Berkas baru: jalur.

file tulis: ['a,b\n"1,2\n'].
{
	file pemisah: [','] tanda-kutip: ['"'] baris: { :line
		Keluaran tulis: line, baris-baru.
	}.
} tangkap: { :e Keluaran tulis: e, baris-baru. }, mulai.

# tanda kutip yang ditutup tetap berfungsi
file tulis: ['a,b\n"1,2",3'].
file pemisah: [','] tanda-kutip: ['"'] baris: { :line
	Keluaran tulis: line, baris-baru.
}.
file hapus.
