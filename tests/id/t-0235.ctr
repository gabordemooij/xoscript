>> Seruput := Objek baru.
Seruput saat: ['baru'] lakukan: {
	milik str := [''].
}.

Seruput saat: ['tanggapi:'] lakukan: { :blah
		(milik str ≠ ['']) benar: {
			milik str tambah-di-akhir: [' '].
		}.
		milik str tambah-di-akhir: blah.
}.
Seruput saat: ['tanggapi:dan:'] lakukan: { :blah :blahah
		(milik str ≠ ['']) benar: {
			milik str tambah-di-akhir: [' '].
		}.
		(blah panjang > 1) benar: {
			milik str tambah-di-akhir: (blah dari: 0 panjang: (blah panjang - 1)).
		}, selain-itu: {
			milik str tambah-di-akhir: blah.
		}.
		milik str tambah-di-akhir: [' '].
		milik str tambah-di-akhir: blahah.
}.
Seruput saat: ['peroleh'] lakukan: {
	>> penyangga := milik str.
	milik str := ['']. <- penyangga.
}.

>> s := Seruput baru.
s hello: ['world'].
Keluaran tulis: ( s peroleh ), baris-baru.
