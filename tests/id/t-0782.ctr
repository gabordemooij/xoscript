Keluaran tulis: ['Objek uji'], baris-baru.
>> pth := Perintah baru.
Keluaran tulis: pth ls /tmp, baris-baru.
>> alamat-lama-pth := pth prototipe alamat-memori.
pth save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== MEMUAT ULANG SNAP:'], baris-baru.
>> b := Objek load-from: ['/tmp/a.bin'].
(b prototipe alamat-memori = alamat-lama-pth) benar: {
	Keluaran tulis: ['Tautan objek dipasang kembali.'], baris-baru.
}.
Keluaran tulis: b ls, baris-baru.


