Keluaran tulis: ['Test object'], baris-baru.
>> cmd := Perintah baru.
Keluaran tulis: cmd ls /tmp, baris-baru.
>> old-cmd-address := cmd prototipe alamat-memori.
cmd save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baru.
>> b := Objek load-from: ['/tmp/a.bin'].
(b prototipe alamat-memori = old-cmd-address) benar: {
	Keluaran tulis: ['Object link re-attached.'], baris-baru.
}.
Keluaran tulis: b ls, baris-baru.


