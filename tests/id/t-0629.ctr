# database test
# see example server.xo for required config

Server init.
Keluaran tulis: ['Database test'], baris-baru.

>> db := Maria-DB baru hos: ['localhost'],
	nama-pengguna: ['xo'], kata-sandi: ['pass123'], nama-basis-data: ['xobase'], sambungkan.

Keluaran tulis: ['Can we connect? '] + db tersambung?, baris-baru.

>> parameter-pencarian := db kueri: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parameter: ( Daftar baru ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  parameter-pencarian jalankan. db komit. } tangkap: { :e db batalkan.  }, mulai.

Keluaran tulis: ['Can we insert? '] + ( parameter-pencarian insert-id > 0 ), baris-baru.

>> Obj := Objek baru.
Obj saat: ['retrieve-rows'] lakukan: {
	milik jumlah := 0.
	>> parameter-pencarian :=
	db kueri: ['SELECT * FROM book order by id desc limit 2'], 
	ambil: { :row 
		milik jumlah tambah: 1.
		Benar hentikan.
	}. <- milik jumlah salin.
}.

Keluaran tulis: ['Can we query? '] + ( Obj retrieve-rows > 0 ), baris-baru.
