Server init.

>> BD := Maria-DB baru hos: ['localhost'],
	nama-pengguna: ['xo'],
	kata-sandi: ['pass123'],
	nama-basis-data: ['xobase'],
	sambungkan.

{
	BD kueri:
	['DROP TABLE movies'],
	jalankan.
} tangkap: { Kosong. }, mulai.

BD kueri:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
jalankan.

BD kueri: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parameter: ( Daftar baru ; ['Halloween'] ),
jalankan.

BD kueri: ['SELECT * FROM movies'],
ambil: { :film
	Keluaran tulis: film title, baris-baru.
}.

