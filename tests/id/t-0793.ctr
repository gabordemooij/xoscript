Server init.

>> DB := Maria-DB baru hos: ['localhost'],
	nama-pengguna: ['xo'],
	kata-sandi: ['pass123'],
	nama-basis-data: ['xobase'],
	sambungkan.

{
	DB kueri:
	['DROP TABLE movies'],
	jalankan.
} tangkap: { Kosong. }, mulai.

DB kueri:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
jalankan.

DB kueri: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parameter: ( Daftar baru ; ['Halloween'] ),
jalankan.

DB kueri: ['SELECT * FROM movies'],
ambil: { :movie
	Keluaran tulis: movie title, baris-baru.
}.

