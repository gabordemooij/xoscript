>> winery := { <- (	Kamus baru
		taruh: 2 di: ['merlot'],
		taruh: 3 di: ['malbec'],
		taruh: 4 di: ['syrah']
	).
}.

Keluaran tulis: (((winery mulai) - ['nothing']) jumlah), baris-baru.
Keluaran tulis: (((winery mulai) - ['merlot']) jumlah), baris-baru.
Keluaran tulis: (((winery mulai) - ['malbec']) jumlah), baris-baru.
Keluaran tulis: (((winery mulai) - ['syrah']) jumlah), baris-baru.
Keluaran tulis: (((winery mulai) - ['merlot'] - ['malbec']) jumlah), baris-baru.
Keluaran tulis: (((winery mulai) - ['merlot'] - ['syrah']) jumlah), baris-baru.
Keluaran tulis: (((winery mulai) - ['malbec'] -['syrah']) jumlah), baris-baru.
Keluaran tulis: (((winery mulai) - ['malbec'] - ['syrah'] - ['merlot']) jumlah), baris-baru.

