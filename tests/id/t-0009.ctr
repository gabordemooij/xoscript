>> Penyapa := Objek baru.
Penyapa saat: ['buat'] lakukan: {
	>> penyapa := Objek baru.
	penyapa saat: ['name:'] lakukan: { :nama
		Keluaran tulis: ['mengatur nama'].
		milik namaku := nama.
	}.
	penyapa saat: ['lakukanSapaan'] lakukan: {
		Keluaran tulis: ['Hello'].
		Keluaran tulis: milik namaku.
	}.
	penyapa saat: ['sapa'] lakukan: {
		diri lakukanSapaan.
	}. <- penyapa.
}.
>> penyapa := Penyapa buat.
penyapa name: ['sinar matahari!'].
penyapa sapa.
