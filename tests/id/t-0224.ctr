
>> negara-negara := Daftar baru
	~ ['Swiss']
	~ ['Italia']
	~ ['Jerman'].

>> makanan := Daftar baru
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> penghitung := 0.
makanan menurut: negara-negara, setiap: { :key :value
	penghitung tambah: 1.
}.

Keluaran tulis: (['we serve counter dishes'] counter: penghitung), baris-baru.

>> penghitung := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] daftar-karakter urutkan: { :v
	penghitung tambah: 0.
}.

Keluaran tulis: (['we sort counter dishes'] counter: penghitung), baris-baru.


>> penghitung := 0.
{
	{
		penghitung tambah: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Keluaran tulis: (['we calculate counter numbers.'] counter: penghitung), baris-baru.

