
>> countries := Daftar baru
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Daftar baru
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods menurut: countries, setiap: { :key :value
	counter tambah: 1.
}.

Keluaran tulis: (['we serve counter dishes'] counter: counter), baris-baru.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] daftar-karakter urutkan: { :v
	counter tambah: 0.
}.

Keluaran tulis: (['we sort counter dishes'] counter: counter), baris-baru.


>> counter := 0.
{
	{
		counter tambah: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Keluaran tulis: (['we calculate counter numbers.'] counter: counter), baris-baru.

