Teks saat: ['html'] lakukan: { <- (
		diri
		ganti: ['&'] dengan: ['&amp;'],
		ganti: ['<'] dengan: ['&lt;'],
		ganti: ['>'] dengan: ['&gt;'],
		ganti: ['''] dengan: ['&apos;'],
		ganti: ['"'] dengan: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program manajemen-memori: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Keluaran tulis: txt salin html, baris-baru.
Keluaran tulis: txt salin huruf-kecil, baris-baru.
Keluaran tulis: txt salin huruf-besar, baris-baru.
} mulai.

Program bersihkan.

usedMemory1 := (Program memori ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Keluaran tulis: txt salin html, baris-baru.
Keluaran tulis: txt salin huruf-kecil, baris-baru.
Keluaran tulis: txt salin huruf-besar, baris-baru.
} mulai.

Program bersihkan.
usedMemory2 := (Program memori ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Keluaran tulis: txt salin html, baris-baru.
Keluaran tulis: txt salin huruf-kecil, baris-baru.
Keluaran tulis: txt salin huruf-besar, baris-baru.
} mulai.

Program bersihkan.
usedMemory3 := (Program memori ? 0).



( usedMemory1 = usedMemory2 dan: usedMemory1 = usedMemory3, dan: usedMemory2 = usedMemory3 ) benar: {
	Keluaran tulis: ['No memory leaks here'].
}, salah: {
	Keluaran tulis: ['Leaking memory...'].
}.
