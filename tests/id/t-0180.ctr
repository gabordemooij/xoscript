Teks saat: ['html'] lakukan: { <- (
		diri
		ganti: ['&'] dengan: ['&amp;'],
		ganti: ['<'] dengan: ['&lt;'],
		ganti: ['>'] dengan: ['&gt;'],
		ganti: ['''] dengan: ['&apos;'],
		ganti: ['"'] dengan: ['&quot;']
	).
}.

>> memoriTerpakai1 := 0.
>> memoriTerpakai2 := 0.
>> memoriTerpakai3 := 0.
>> memoriTerpakai4 := 0.

Program manajemen-memori: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Keluaran tulis: txt salin html, baris-baru.
Keluaran tulis: txt salin huruf-kecil, baris-baru.
Keluaran tulis: txt salin huruf-besar, baris-baru.
} mulai.

Program bersihkan.

memoriTerpakai1 := (Program memori ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Keluaran tulis: txt salin html, baris-baru.
Keluaran tulis: txt salin huruf-kecil, baris-baru.
Keluaran tulis: txt salin huruf-besar, baris-baru.
} mulai.

Program bersihkan.
memoriTerpakai2 := (Program memori ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Keluaran tulis: txt salin html, baris-baru.
Keluaran tulis: txt salin huruf-kecil, baris-baru.
Keluaran tulis: txt salin huruf-besar, baris-baru.
} mulai.

Program bersihkan.
memoriTerpakai3 := (Program memori ? 0).



( memoriTerpakai1 = memoriTerpakai2 dan: memoriTerpakai1 = memoriTerpakai3, dan: memoriTerpakai2 = memoriTerpakai3 ) benar: {
	Keluaran tulis: ['Tidak ada kebocoran memori di sini'].
}, salah: {
	Keluaran tulis: ['Memori bocor...'].
}.
