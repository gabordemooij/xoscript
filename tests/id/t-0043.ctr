>> pengulang := Objek baru.
pengulang saat: ['tanggapi:'] lakukan: { :apa
	Keluaran tulis: apa + [' '].
}.
pengulang saat: ['tanggapi:dan:'] lakukan: { :apa :say
	Keluaran tulis: apa, tulis: say + [' '].
}.
pengulang saat: ['tanggapi:dan:dan:'] lakukan: { :apa :say :lagi
	Keluaran tulis: apa, tulis: say, tulis: lagi.
}.
pengulang ulangi.
pengulang everything: ['Saya bilang.'].
pengulang and: ['I '] everything: ['do.'].
