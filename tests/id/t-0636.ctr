# test url parsing

Server init.
>> url := URL dari: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Keluaran tulis: ['scheme = '] + url skema, baris-baru.
Keluaran tulis: ['host = '] + url hos, baris-baru.
Keluaran tulis: ['port = '] + url porta, baris-baru.
Keluaran tulis: ['path = '] + url jalur, baris-baru.
Keluaran tulis: ['query = '] + url parameter-pencarian, baris-baru.
Keluaran tulis: ['fragment = '] + url fragmen, baris-baru.
