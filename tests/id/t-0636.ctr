# uji penguraian url

Server init.
>> url := URL dari: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Keluaran tulis: ['skema = '] + url skema, baris-baru.
Keluaran tulis: ['host = '] + url hos, baris-baru.
Keluaran tulis: ['port = '] + url porta, baris-baru.
Keluaran tulis: ['jalur = '] + url jalur, baris-baru.
Keluaran tulis: ['kueri = '] + url parameter-pencarian, baris-baru.
Keluaran tulis: ['fragmen = '] + url fragmen, baris-baru.
