



>> AmpasKopi := Objek baru.
AmpasKopi saat: ['seduh'] lakukan: { <- ['coffee']. }.

>> MesinKopi := Objek baru.
MesinKopi saat: ['init'] lakukan: {
	milik ampaskopi := AmpasKopi baru.
}.
MesinKopi saat: ['baru'] lakukan: { <- MesinKopi `new init.
}.

MesinKopi saat: ['buatTeh'] lakukan: { <- (milik daunteh seduh). }.
MesinKopi saat: ['buatKopi'] lakukan: { <- (milik ampaskopi seduh). }.

>> mimpiKopi := MesinKopi baru.

Keluaran tulis:
	mimpiKopi 
	buatKopi.

Keluaran tulis:
	mimpiKopi 
	buatTeh.
