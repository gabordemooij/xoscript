



>> CoffeeGrounds := Objek baru.
CoffeeGrounds saat: ['extract'] lakukan: { <- ['coffee']. }.

>> CoffeeMachine := Objek baru.
CoffeeMachine saat: ['init'] lakukan: {
	milik coffeegrounds := CoffeeGrounds baru.
}.
CoffeeMachine saat: ['baru'] lakukan: { <- CoffeeMachine `new init.
}.

CoffeeMachine saat: ['makeTea'] lakukan: { <- (milik tealeaves extract). }.
CoffeeMachine saat: ['makeCoffee'] lakukan: { <- (milik coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine baru.

Keluaran tulis:
	coffeeDream 
	makeCoffee.

Keluaran tulis:
	coffeeDream 
	makeTea.
