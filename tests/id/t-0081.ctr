>> peta1 := Kamus baru.
>> kunci1 := Daftar baru.
>> kunci2 := Daftar baru.

peta1
	taruh: ['hello'] di: kunci1,
	taruh: ['world'] di: kunci2.


Keluaran
	tulis: ['Map #1 contains: '] + (peta1 di: kunci1),
	tulis: [' dan '] + (peta1 di: kunci2), baris-baru.

>> LarikBerkunci := Daftar baru.
LarikBerkunci saat: ['keTeks'] lakukan: { <- (diri jumlah) keTeks.
}.

>> map2 := Kamus baru.
kunci1 := LarikBerkunci baru.
kunci2 := LarikBerkunci baru.

kunci1 tambah-di-akhir: 1.

map2
	taruh: ['hello'] di: kunci1,
	taruh: ['world'] di: kunci2.

Keluaran
	tulis: ['Map #2 contains: '] + (map2 di: kunci1),
	tulis: [' dan '] + (map2 di: kunci2), baris-baru.
