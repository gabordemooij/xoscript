>> map1 := Kamus baru.
>> key1 := Daftar baru.
>> key2 := Daftar baru.

map1
	taruh: ['hello'] di: key1,
	taruh: ['world'] di: key2.


Keluaran
	tulis: ['Map #1 contains: '] + (map1 di: key1),
	tulis: [' and '] + (map1 di: key2), baris-baru.

>> KeyeableArray := Daftar baru.
KeyeableArray saat: ['toString'] lakukan: { <- (diri jumlah) toString.
}.

>> map2 := Kamus baru.
key1 := KeyeableArray baru.
key2 := KeyeableArray baru.

key1 tambah-di-akhir: 1.

map2
	taruh: ['hello'] di: key1,
	taruh: ['world'] di: key2.

Keluaran
	tulis: ['Map #2 contains: '] + (map2 di: key1),
	tulis: [' and '] + (map2 di: key2), baris-baru.
