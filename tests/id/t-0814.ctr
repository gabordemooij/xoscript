# format kuki sesi, tipe konten json, hanya protokol web, svg ditampilkan inline
Server inisialisasi.
Program gunakan: ['../../../src/xo/id/webtools.xo'].

>> Permintaan-Palsu := Objek baru.
Permintaan-Palsu saat: ['value:'] lakukan: { :nilai
	milik nilai := nilai.
}.
Permintaan-Palsu saat: ['cookie:'] lakukan: { :nama
	<- milik nilai.
}.

>> Sesi-Uji := Sesi-berkas-sementara baru.
Sesi-Uji saat: ['muat'] lakukan: {
	<- Kamus baru.
}.
Sesi-Uji saat: ['pengenal-sesi'] lakukan: {
	<- milik id.
}.

>> kuki-kuki := Daftar baru
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

kuki-kuki setiap: { :i :kuki
	>> permintaan-http := Permintaan-Palsu baru.
	permintaan-http value: kuki.
	>> pengelola := Sesi-Uji baru.
	>> web := Dokumen-Web baru.
	web permintaan-http: permintaan-http.
	web pengelola-sesi: pengelola.
	web mulai-sesi.
	Keluaran tulis: ( pengelola pengenal-sesi = kuki ), baris-baru.
}.

>> web := Dokumen-Web baru.
web json: (Kamus baru taruh: ['b'] di: ['a']).
Keluaran tulis: ['\n'], baris-baru.

{ Jaringan get: ['file:///etc/hostname']. } tangkap: { :e
	Keluaran tulis: e, baris-baru.
}, mulai.

>> svg := Berkas baru: ['/tmp/test0814.svg'].
svg tulis: ['<svg xmlns="x"></svg>'].
Keluaran baris-baru.
Server teruskan: ['test0814.svg'] awalan: ['/tmp/'].
svg hapus.
