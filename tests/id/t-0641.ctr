# Uji pembersih utf8
Server init.

>> kasus-utf8 := Kamus baru
	# Hanya ASCII
	taruh: ( Daftar baru ; 65 ; 65 ; 65 ; 65 ; 0 ) di: ['AAAA'],
	# urutan 2 byte yang valid
	taruh: ( Daftar baru ; 194 ; 162 ; 0 ) di: ['¢'],
	# UTF-8 3-byte yang valid
    taruh: ( Daftar baru ; 226 ; 130 ; 172 ; 0 ) di: ['€'],
	# UTF-8 4-byte yang valid
    taruh: ( Daftar baru ; 240 ; 144 ; 141 ; 136 ; 0 ) di: ['𐍈'],
	# Byte lanjutan tidak valid dalam urutan E2 28 AC -> awal urutan 3b + 28 lanjutan salah + AC byte lanjutan, tetapi termasuk galat yang sama
    taruh: ( Daftar baru ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) di: ['A?A'],
	# Pengodean berlebih dari ASCII 'A' (seharusnya menjadi ?),
    taruh: ( Daftar baru ; 65 ; 193 ; 129 ; 0 ) di: ['A?'],
	# Byte pertama tidak valid (0xFF)
    taruh: ( Daftar baru ; 255 ; 0 ) di: ['?'],
	# Urutan multi-byte tidak lengkap di akhir
    taruh: ( Daftar baru ; 66 ; 226 ; 0 ) di: ['B?'],
    # Teks kosong
    #put: ( List new ) at: [''],
	# Beberapa urutan campuran
    taruh: ( Daftar baru ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) di: ['A€?𐍈B'].
	 
kasus-utf8 setiap: { :key :value
	>> blob := Blob baru: value jumlah, bytes: value.
	>> str := blob teks.
	(str = key) benar: {
		Keluaran tulis: ['OK'], baris-baru.
	}, selain-itu: {
		Keluaran tulis: ['Sanitizer UTF8 gagal pada: '] + key + [' dapat: '] + str, baris-baru.
	}.
	blob bebaskan.
}.
