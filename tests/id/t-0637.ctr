# Mengatur alarm

# menghentikan program setelah 1 detik.
Program batas-waktu: 1.

Keluaran tulis: ['maks 1 detik.'], baris-baru.
Momen tunggu: 2.
Keluaran tulis: ['terlalu lama.'], baris-baru.

# catatan:
# Mengatur alarm tidak dapat dibatalkan,
# penyerang tidak dapat menonaktifkannya.
# Setelah panggilan pertama, alarm terkunci.
# Selain itu alarm benar-benar keras,
# program *AKAN* dihentikan setelah
# selang waktu yang ditentukan, bahkan jika
# sedang dalam pembacaan yang memblokir atau semacamnya.

# catatan:
# Alarm itu berat, pertimbangkan untuk mengatur
# batas waktu dasar di server web saja.



