>> a := Objek baru. 
a saat: ['greet'] lakukan: { Keluaran tulis: ['welcome!'], baris-baru. }.
a saat: ['greet2'] lakukan: { Keluaran tulis: ['welcome2!'], baris-baru. }.
a save-as: ['/tmp/a.bin'].

Keluaran tulis: ['========== RELOADING SNAP:'], baris-baru.
>> b := Objek load-from: ['/tmp/a.bin'].
b greet2.