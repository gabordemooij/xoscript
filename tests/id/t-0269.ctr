#Linux

(Berkas baru: ['/tmp/testje']) ada salah: {
	Program sistem: ['mkdir /tmp/testje'].	
}.

(Berkas baru: ['/tmp/testje/file1']) ada salah: {
	Program sistem: ['touch /tmp/testje/file1'].	
}.

(Berkas baru: ['/tmp/testje/folder1']) ada salah: {
	Program sistem: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Berkas daftar: ['/tmp/testje'].

>> q := Daftar baru.

l setiap: { :k :v v setiap: { :x :y q tambah-di-akhir: y. }. }.

>> s := q teks.

(s mengandung: ['file1']) benar:   { Keluaran tulis: ['OK'], baris-baru. }.
(s mengandung: ['file2']) benar:   { Keluaran tulis: ['XX'], baris-baru. }.
(s mengandung: ['folder1']) benar: { Keluaran tulis: ['OK'], baris-baru. }.
