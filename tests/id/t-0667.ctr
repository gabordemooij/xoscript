# test Program version

# this feature is disabled by default
Keluaran tulis: (
	Program fitur: 
	['RECURSIVE_STRINTPOL']
), baris-baru.


# but if we set the time back
>> today := Momen 
zona: ['CEST'],
dari: ['2026-02-15 10:00:00'].
Program versi: today.

# it will be enabled like it used to be (from now on)
Keluaran tulis: (
	Program fitur: 
	['RECURSIVE_STRINTPOL']
), baris-baru.