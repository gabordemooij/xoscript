

# buat bilangan bulat 64-bit untuk perhitungan yang tepat
>> a := Int64 dari-teks: ['123'].

# ke teks
Keluaran tulis: a, baris-baru.

# bagi
Keluaran tulis: a / (Int64 dari-teks: ['3']), baris-baru.

# kali
Keluaran tulis: a * (Int64 dari-teks: ['2']), baris-baru.

# tambah
Keluaran tulis: a + (Int64 dari-teks: ['1']), baris-baru.

# kurang
Keluaran tulis: a - (Int64 dari-teks: ['2']), baris-baru.

# bandingkan
Keluaran tulis: ( a =   (Int64 dari-teks: ['123'])), baris-baru.
Keluaran tulis: ( a !=: (Int64 dari-teks: ['124'])), baris-baru.
Keluaran tulis: ( a <   (Int64 dari-teks: ['124'])), baris-baru.
Keluaran tulis: ( a >   (Int64 dari-teks: ['122'])), baris-baru.
Keluaran tulis: ( a >=: (Int64 dari-teks: ['123'])), baris-baru.
Keluaran tulis: ( a <=: (Int64 dari-teks: ['123'])), baris-baru.





	