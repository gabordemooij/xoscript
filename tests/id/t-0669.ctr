# Hash kata sandi
Server init.

# Pengguna mengatur kata sandi
>> sandi := ['pass123'].

# Anda menyimpannya seperti ini
>> hash := Brankas 
	hash-kata-sandi: sandi.

# Lalu, pengguna masuk
# Percobaan 1
>> a1 := ['abcd123'].
# Percobaan 2
>> a2 := ['pass123'].

# Verifikasi
>> a := Brankas 
	hash-kata-sandi: hash verifikasi: a1.
	# gagal 
>> b := Brankas
	hash-kata-sandi: hash verifikasi: a2.
	# ok!

Keluaran tulis: a, baris-baru.
Keluaran tulis: b, baris-baru.

