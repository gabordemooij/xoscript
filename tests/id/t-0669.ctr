# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Brankas 
	hash-kata-sandi: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Brankas 
	hash-kata-sandi: hash verifikasi: a1.
	# fail 
>> b := Brankas
	hash-kata-sandi: hash verifikasi: a2.
	# ok!

Keluaran tulis: a, baris-baru.
Keluaran tulis: b, baris-baru.

