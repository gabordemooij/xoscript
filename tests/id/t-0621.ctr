>> frasa-frasa := Daftar baru
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> pesan := ['Phrase: ~decoded base64: ~encoded'].
	
frasa-frasa setiap: { :_ :frasa 
	>> e := Server base64-enkode: frasa.
	>> d := Server base64-dekode: e.
	Keluaran tulis: (
		pesan salin ~encoded: e, ~decoded: d
	), baris-baru.
}.
