

>> g  := Server baru.
>> v  := Brankas baru.
>> ok := 0.

>> rahasia-rahasia := Daftar baru ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> daftar-sandi := rahasia-rahasia salin.
daftar-sandi setiap: { :i :p
	rahasia-rahasia setiap: { :n :s
		{
			>> terenkripsi := v enkripsi: s kunci: p.
			>> terdekripsi := v dekripsi: terenkripsi kunci: p.
			(terdekripsi = s) benar: {
				ok tambah: 1.
			}, selain-itu: {
				Keluaran tulis: ['gagal mengenkripsi/mendekripsi: '], baris-baru.
				Keluaran tulis: s, baris-baru.
				Keluaran tulis: ['terenkripsi: '] + terenkripsi, baris-baru.
				Keluaran tulis: ['terdekripsi: '] + terenkripsi, baris-baru.
				Program akhiri.
			}.
		} tangkap: { :glt
			(s = [''] atau: p = ['']) benar: {
				ok tambah: 1.
			}, selain-itu: {
				Keluaran tulis: glt, baris-baru.
				Program akhiri.
			}.
		}, mulai.
	}.
}.

Keluaran tulis: ( ok + [' enkripsi brankas diuji.'] ), baris-baru.