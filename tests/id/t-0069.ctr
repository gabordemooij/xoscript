

Teks saat: ['html'] lakukan: { <- (
		diri
		ganti: ['&'] dengan: ['&amp;'],
		ganti: ['<'] dengan: ['&lt;'],
		ganti: ['>'] dengan: ['&gt;'],
		ganti: ['"'] dengan: ['&quot;']
	).
}.


Keluaran tulis: ([' kiri dipangkas '] pangkas) + [' '] + ( ['dan kanan dipangkas'] pangkas) + ['!'], baris-baru.
Keluaran tulis: ['<html>"html & entities"</html>'] html.
