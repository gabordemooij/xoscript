>> Grandfather := Objek baru.
Grandfather saat: ['greet'] lakukan: {
	Keluaran tulis: ['Ave!'], baris-baru.
}.
>> Father := Grandfather baru.
Father saat: ['greet'] lakukan: {
	Keluaran tulis: ['Hello'], baris-baru.
	diri greet.
}.
>> Son := Father baru.
Son saat: ['greet'] lakukan: {
	Keluaran tulis: ['Hi'], baris-baru.
	diri greet.
}.

Son greet.

>> Roundabout := Objek baru.
Roundabout saat: ['circle:'] lakukan: { :x
	Keluaran tulis: x, baris-baru.
	(x < 3) benar: { diri rekursif circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) benar: { Keluaran tulis: x, baris-baru. x tambah: 1.  increment mulai. }. }.
increment mulai.