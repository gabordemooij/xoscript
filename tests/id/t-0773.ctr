Keluaran tulis: ['Test object'], baris-baru.
>> a := Objek baru. 
a saat: ['item:'] lakukan: { :int64
	milik int64 := int64. 
}.
a saat: ['item'] lakukan: { <- milik int64.
}.
a item: ( Int64 dari-teks: ['9999'] ).
Keluaran tulis: a item, baris-baru.
>> old-int64-address := a item prototipe alamat-memori.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baru.
>> b := Objek load-from: ['/tmp/a.bin'].
(b item prototipe alamat-memori = old-int64-address) benar: {
	Keluaran tulis: ['Object link re-attached.'], baris-baru.
}.
Keluaran tulis: ( b item ), baris-baru.
