# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Brankas buat-kunci.

# private (secret) key
>> sk := keys pertama.

# public key
>> pk := keys terakhir.

# sign a message
>> sig := Brankas tanda-tangani: ['abc'] dengan: sk.

# check message (ok)
Keluaran tulis: ( 
	Brankas
		periksa: ['abc'] 
		tanda-tangan: sig 
		dengan: pk 
), baris-baru.

# check message (fail)
Keluaran tulis: ( 
	Brankas 
		periksa: ['abd'] 
		tanda-tangan: sig 
		dengan: pk 
), baris-baru.