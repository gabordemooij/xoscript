# kunci publik (untuk mengamankan API dll)
Server init.

# buat kunci
>> pasangan-kunci := Brankas buat-kunci.

# kunci privat (rahasia)
>> kpr := pasangan-kunci pertama.

# kunci publik
>> kpu := pasangan-kunci terakhir.

# tanda tangani pesan
>> ttd := Brankas tanda-tangani: ['abc'] dengan: kpr.

# periksa pesan (ok)
Keluaran tulis: ( 
	Brankas
		periksa: ['abc'] 
		tanda-tangan: ttd 
		dengan: kpu 
), baris-baru.

# periksa pesan (gagal)
Keluaran tulis: ( 
	Brankas 
		periksa: ['abd'] 
		tanda-tangan: ttd 
		dengan: kpu 
), baris-baru.