
Server init.
Keluaran tulis: ['Tes basis data'], baris-baru.

>> bd := Maria-DB baru hos: ['localhost'],
	nama-pengguna: ['xo'], 
	kata-sandi: ['pass123'],
	nama-basis-data: ['xobase'],
	sambungkan.

>> parameter-pencarian :=
bd kueri: ['SELECT REPEAT('Blah',1000) AS blah'], 
ambil: { :barisan 
	Keluaran tulis: barisan blah panjang, baris-baru.
}.
