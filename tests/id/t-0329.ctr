Keluaran tulis: ((Daftar baru
	saat: ['plaque:'] lakukan: { :x milik o := x. },
	saat: ['plaque']  lakukan: { <- milik o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Daftar ← 1)
	~ (Daftar ← 1 ; 2)
	~ (Daftar ← 1 ; 2 ; 3)
	~ (Daftar ← 1 ; 2 ; 3 ; 4)
	~ (Daftar ← 1 ; 2 ; 3 ; 4 ; 5)
) setiap: { :i :el
	{ Keluaran tulis: tugas-ini. } × el jumlah.
	Keluaran baris-baru.
}) plaque, baris-baru.


