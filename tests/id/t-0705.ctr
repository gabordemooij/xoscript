

>> obj := Objek baru.

obj saat: ['sapa'] lakukan: {
	<- ['hai'].
}.

# harus menghasilkan hi123hi123ok
obj saat: ['tugas'] lakukan: {
	milik properti := 123.
	{
		# coba mengikat diri/milik ke objek alih-alih ke blok
		Keluaran tulis: diri sapa.
		Keluaran tulis: milik properti.
		1 / 0.
	} tangkap: {
		Keluaran tulis: diri sapa.
		Keluaran tulis: milik properti.
		Keluaran tulis: ['ok'].
	}, coba.
}.

obj tugas.