

>> Matryoshka := Objek baru.
Matryoshka saat: ['double:'] lakukan: { :rahasia
	milik rahasia := rahasia × 2.
}.
Matryoshka saat: ['baru:'] lakukan: { :rahasia
	>> jawaban := Kosong.
	>> t := (rahasia > 255).
	Keluaran tulis: (rahasia + [' | '] + t), baris-baru.
	t benar: {
		jawaban := rahasia.
	}, selain-itu: {
		jawaban := Matryoshka rekursif baru: (diri double: rahasia).
	}. <- jawaban.
}.

>> x := Matryoshka baru: 2.
