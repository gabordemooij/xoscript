

>> Matryoshka := Objek baru.
Matryoshka saat: ['double:'] lakukan: { :secret
	milik secret := secret × 2.
}.
Matryoshka saat: ['baru:'] lakukan: { :secret
	>> answer := Kosong.
	>> t := (secret > 255).
	Keluaran tulis: (secret + [' | '] + t), baris-baru.
	t benar: {
		answer := secret.
	}, selain-itu: {
		answer := Matryoshka rekursif baru: (diri double: secret).
	}. <- answer.
}.

>> x := Matryoshka baru: 2.
