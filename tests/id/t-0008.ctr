>> Greeter := Objek baru.
Greeter saat: ['make'] lakukan: {
	>> greeter := Objek baru.
	greeter saat: ['name:'] lakukan: { :nama
		Keluaran tulis: ['setting a name'].
		milik myName := nama.
	}.
	greeter saat: ['greet'] lakukan: {
		Keluaran tulis: ['Hello'].
		Keluaran tulis: milik myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
