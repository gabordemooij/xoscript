Boolean saat: ['xor:'] lakukan: { :a :b <- ((a dan: b bukan) atau: (a bukan dan: b)).
}.

>> o := Objek baru.
o saat: ['hello'] lakukan: { ['Empty']. }.
{ o saat: 2 lakukan: 3.} tangkap: { :e Keluaran tulis: e, baris-baru. }, mulai.
{ o saat: ['uji'] lakukan: 3.} tangkap: { :e Keluaran tulis: e, baris-baru. }, mulai.
{ o saat: ['hello'] lakukan: { ['Empty']. }.} tangkap: { :e Keluaran tulis: e, baris-baru. }, mulai. 
{ >> z := 4 ÷ 0. } tangkap: { :e Keluaran tulis: e, baris-baru. }, mulai. 
{ (Benar dan: Kosong) benar: { Keluaran tulis: ['X'].}. } tangkap: { :e Keluaran tulis: e, baris-baru. }, mulai. 
{ ([''] xor: 0) benar: { Keluaran tulis: ['X'].}. } tangkap: { :e Keluaran tulis: e, baris-baru. }, mulai. 
{ (1 < ['2']) benar: { Keluaran tulis: ['OK']. }. } tangkap: { :e Keluaran tulis: e, baris-baru. }, mulai. 
{ (1 < ['2.0']) benar: { Keluaran tulis: ['OK']. }. } tangkap: { :e Keluaran tulis: e, baris-baru. }, mulai. 
{ (1 < ['x2.0']) benar: { Keluaran tulis: ['NO!']. }. } tangkap: { :e Keluaran tulis: e, baris-baru. }, mulai. 
{ Keluaran tulis: (['hello OK there'] dari: ['6'] panjang: ['2']). } mulai. 
