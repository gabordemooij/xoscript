Keluaran tulis: ['Objek uji'], baris-baru.
>> a := Objek baru. 

a saat: ['state:'] lakukan: { :list
	milik list := list. 
}.

a saat: ['keadaan'] lakukan: {
	Keluaran tulis: milik list, baris-baru.
}.

a state: ( Daftar baru ; ['itemdaftar'] ; ['item2'] ).
a keadaan.

a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== MEMUAT ULANG SNAP:'], baris-baru.
>> b := Objek load-from: ['/tmp/a.bin'].
b keadaan.