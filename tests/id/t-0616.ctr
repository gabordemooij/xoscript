Daftar saat: ['salin'] lakukan: {
	>> salin := Daftar baru.
	diri setiap: { :angka :seksi
		salin tambah-di-akhir: seksi rekursif salin.
	}.
	<- salin.
}.

>> domba := Daftar baru ; ['Dolly'] ; ['Shaun']. 
>> klon-klon := domba salin.
klon-klon setiap: { :angka :domba
	domba tambah-di-akhir: ['2'].
}.

Keluaran tulis: domba, baris-baru.
Keluaran tulis: klon-klon, baris-baru.
