Daftar saat: ['salin'] lakukan: {
	>> salin := Daftar baru.
	diri setiap: { :angka :section
		salin tambah-di-akhir: section rekursif salin.
	}. <- salin.
}.

>> sheep := Daftar baru ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep salin.
clones setiap: { :angka :sheep
	sheep tambah-di-akhir: ['2'].
}.

Keluaran tulis: sheep, baris-baru.
Keluaran tulis: clones, baris-baru.
