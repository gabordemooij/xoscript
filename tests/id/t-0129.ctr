
Daftar saat: ['hasil-kali'] lakukan: {
	>> total := 1.
	diri setiap: { :indeks :elemen
		total kalikan-dengan: elemen.
	}. <- total.
}.

>> a := Daftar ← 1 ; 2 ; 3.
Keluaran tulis: a hasil-kali, baris-baru.
Keluaran tulis: (Daftar ← 2 ; 4 ; 8) hasil-kali, baris-baru. 
Keluaran tulis: (Daftar ← -2 ; 10) hasil-kali, baris-baru. 
Keluaran tulis: (Daftar ← 0.5 ; -2) hasil-kali, baris-baru. 
