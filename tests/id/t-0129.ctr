
Daftar saat: ['product'] lakukan: {
	>> total := 1.
	diri setiap: { :index :element
		total kalikan-dengan: element.
	}. <- total.
}.

>> a := Daftar ← 1 ; 2 ; 3.
Keluaran tulis: a product, baris-baru.
Keluaran tulis: (Daftar ← 2 ; 4 ; 8) product, baris-baru. 
Keluaran tulis: (Daftar ← -2 ; 10) product, baris-baru. 
Keluaran tulis: (Daftar ← 0.5 ; -2) product, baris-baru. 
