>> t := Benar.
(t = Benar) benar: { Keluaran tulis: ['T']. }.
(t = Salah) benar: { Keluaran tulis: ['F']. }.
Keluaran tulis: ['|'].
>> t := Salah.
(t = Benar) benar: { Keluaran tulis: ['T']. }.
(t = Salah) benar: { Keluaran tulis: ['F']. }.
Keluaran tulis: ['|'].
>> f := Benar.
(t = Benar dan: f = Salah) benar: { Keluaran tulis: ['T']. }.
(t = Salah dan: f = Benar) benar: { Keluaran tulis: ['F']. }.
Keluaran tulis: ['|'].
>> n := Kosong.
(n Kosong?) benar: { Keluaran tulis: ['T']. }.
(n Kosong?) salah: { Keluaran tulis: ['F']. }.
Keluaran tulis: ['|'].
(f Boolean?) benar: { Keluaran tulis: ['T']. }.
(f Boolean?) salah: { Keluaran tulis: ['F']. }.



