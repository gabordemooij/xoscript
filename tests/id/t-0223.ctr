>> x := Momen baru.
x zona: ['CEST'],
tahun:2017,
bulan:01,
hari:10,
jam: 10,
menit: 0,
detik: 0.

Keluaran tulis: x, baris-baru.

Keluaran tulis: x waktu, baris-baru.

x tambah: 1 detik.
x tambah: 2 menit.
x tambah: 3 jam.
x tambah: 4 hari.
x tambah: 1 bulan.
x tambah: 6 tahun.

Keluaran tulis: x, baris-baru.

x kurangi: 1 detik.
x kurangi: 2 menit.
x kurangi: 3 jam.
x kurangi: 4 hari.
x kurangi: 1 bulan.
x kurangi: 6 tahun.

Keluaran tulis: x, baris-baru.

>> y := x salin.
>> z := x.

Keluaran tulis: y, baris-baru.
Keluaran tulis: z, baris-baru.
Keluaran tulis: (x zona = y zona), baris-baru.
Keluaran tulis: (x waktu = y waktu), baris-baru.
Keluaran tulis: (x = z), baris-baru.
Keluaran tulis: x hari-dalam-tahun, baris-baru.
Keluaran tulis: x hari-dalam-minggu, baris-baru.
Keluaran tulis: x minggu, baris-baru.
