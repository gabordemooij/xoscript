>> Slurp := Objek baru.

Slurp saat: ['baru'] lakukan: {
	milik str := [''].
}.

Slurp saat: ['tanggapi:'] lakukan: { :blah
		(milik str = ['']) benar: {
			milik str tambah-di-akhir: blah.
		}, selain-itu: {
			milik str tambah-di-akhir: [' '].
			milik str tambah-di-akhir: blah.
		}.
}.

Slurp saat: ['tanggapi:dan:'] lakukan: { :blah :blahah
		(blah panjang > 1) benar: {
			milik str tambah-di-akhir: (blah dari: 0 panjang: (blah panjang - 1)).
		}, selain-itu: {
			milik str tambah-di-akhir: blah.
		}.
		milik str tambah-di-akhir: [' '].
		milik str tambah-di-akhir: blahah.
}.

Slurp saat: ['obtain'] lakukan: {
	>> buffer := milik str.
	milik str := ['']. <- buffer.
}.


>> x := Slurp baru.
x + 3.
Keluaran tulis: (x obtain), baris-baru.
x echo: ['Hello world'].
Keluaran tulis: (x obtain), baris-baru.
x tellme: 123 and: 987.
Keluaran tulis: (x obtain), baris-baru.
