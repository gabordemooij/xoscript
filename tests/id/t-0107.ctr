
Keluaran tulis: ['Hentikan loop for, 0-4.'], baris-baru.
{ :i
	Keluaran tulis: ['iteration #'] + i, baris-baru.
	(i = 4) hentikan.
} × 10.

>> x := 0.
>> xKurangDari10 := { <- ( x < 10 ). }.

Keluaran tulis: ['Hentikan loop while-true, 0-4.'], baris-baru.
{
	Keluaran tulis: ['iteration #'] + x, baris-baru.
	x tambah: 1.
	((x < 5) bukan) hentikan.
} selama: xKurangDari10.

Keluaran tulis: ['Hentikan loop while-false, 5,4.'], baris-baru.
{
	Keluaran tulis: ['iteration #'] + x, baris-baru.
	x kurangi: 1.
	(x = 3) hentikan.
} selama: { <- (x > 0). }.

Keluaran tulis: ['Hentikan loop times, 1-4.'], baris-baru.
{ :i
	Keluaran tulis: ['iteration #'] + i, baris-baru.
	(i = 4) hentikan.
} × 5.

Keluaran tulis: ['Hentikan blok, jangan cetak baris.'], baris-baru.
{ Benar hentikan. Keluaran tulis: ['jangan tulis ini!'], baris-baru. } mulai.

Keluaran tulis: ['Hentikan blok, jangan picu catch...'], baris-baru.
{ Benar hentikan. Keluaran tulis: ['jangan tulis ini!'], baris-baru. } tangkap: { Keluaran tulis: ['Jangan tangkap ini!']. }, mulai.

Keluaran tulis: ['Uji loop each Larik: 0,1'], baris-baru.
(Daftar ← 1 ; 2 ; 3) petakan: { :i
	Keluaran tulis: ['iteration #'] + i, baris-baru.
	(i = 1) hentikan.
}.

Keluaran tulis: ['Uji loop each Kamus: hanya c'], baris-baru.
>> m := Kamus baru.
m taruh: ['first'] di: ['a'], taruh: ['second'] di: ['b'], taruh: ['ketiga'] di: ['c'].
m setiap: { :k :v
	Keluaran tulis: ['iteration'] + v + k, baris-baru.
	Benar hentikan.
}.

