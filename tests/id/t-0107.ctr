
Keluaran tulis: ['Break for-loop, 0-4.'], baris-baru.
{ :i
	Keluaran tulis: ['iteration #'] + i, baris-baru.
	(i = 4) hentikan.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Keluaran tulis: ['Break while-true loop, 0-4.'], baris-baru.
{
	Keluaran tulis: ['iteration #'] + x, baris-baru.
	x tambah: 1.
	((x < 5) bukan) hentikan.
} selama: xIsLessThan10.

Keluaran tulis: ['Break while-false loop, 5,4.'], baris-baru.
{
	Keluaran tulis: ['iteration #'] + x, baris-baru.
	x kurangi: 1.
	(x = 3) hentikan.
} selama: { <- (x > 0). }.

Keluaran tulis: ['Break times loop, 1-4.'], baris-baru.
{ :i
	Keluaran tulis: ['iteration #'] + i, baris-baru.
	(i = 4) hentikan.
} × 5.

Keluaran tulis: ['Break block, dont print line.'], baris-baru.
{ Benar hentikan. Keluaran tulis: ['dont write this!'], baris-baru. } mulai.

Keluaran tulis: ['Break block, dont fire catch...'], baris-baru.
{ Benar hentikan. Keluaran tulis: ['dont write this!'], baris-baru. } tangkap: { Keluaran tulis: ['Dont catch this!']. }, mulai.

Keluaran tulis: ['Test Array each-loop: 0,1'], baris-baru.
(Daftar ← 1 ; 2 ; 3) petakan: { :i
	Keluaran tulis: ['iteration #'] + i, baris-baru.
	(i = 1) hentikan.
}.

Keluaran tulis: ['Test Map each-loop: c only'], baris-baru.
>> m := Kamus baru.
m taruh: ['first'] di: ['a'], taruh: ['second'] di: ['b'], taruh: ['third'] di: ['c'].
m setiap: { :k :v
	Keluaran tulis: ['iteration'] + v + k, baris-baru.
	Benar hentikan.
}.

