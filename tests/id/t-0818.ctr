# edge cases from a request must give an error or a result, not a crash
Server init.

Keluaran tulis: ['<'] + (['abc'] dari: 0 panjang: 0, huruf-besar) + ['>'], baris-baru.
Keluaran tulis: ['<'] + (['abc'] dari: 0 panjang: 0, huruf-kecil) + ['>'], baris-baru.
Keluaran tulis: ['<'] + (['abc'] lewati: 3, huruf-besar) + ['>'], baris-baru.
Keluaran tulis: [''] huruf-besar bytes, baris-baru.
Keluaran tulis: ['aB'] huruf-besar, baris-baru.
Keluaran tulis: ['aB'] huruf-kecil, baris-baru.

Keluaran tulis: (Momen baru: 0) tahun, baris-baru.
{ Momen baru: ['9e300'] angka. } tangkap: { :e Keluaran tulis: e, baris-baru. }, mulai.
{ Momen baru: ['-9e300'] angka. } tangkap: { :e Keluaran tulis: e, baris-baru. }, mulai.
{ Momen baru: ['nan'] angka. } tangkap: { :e Keluaran tulis: e, baris-baru. }, mulai.
{ Momen baru: 9000000000000000000. } tangkap: { :e Keluaran tulis: e, baris-baru. }, mulai.
