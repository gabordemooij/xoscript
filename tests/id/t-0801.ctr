Server init.

>> db := Maria-DB baru hos: ['localhost'],
	nama-pengguna: ['xo'],
	kata-sandi: ['pass123'],
	nama-basis-data: ['xobase'],
	sambungkan.

>> del := db kueri: ['DELETE FROM book WHERE id > 0'].
{  del jalankan. db komit. } tangkap: { :e db batalkan.  }, mulai.

>> jumlah := db kueri: ['SELECT COUNT(*) AS num FROM book'].
jumlah ambil: { :row Keluaran tulis: row num, baris-baru. }.
