Server init.

>> bd := Maria-DB baru hos: ['localhost'],
	nama-pengguna: ['xo'],
	kata-sandi: ['pass123'],
	nama-basis-data: ['xobase'],
	sambungkan.

>> hps := bd kueri: ['DELETE FROM book WHERE id > 0'].
{  hps jalankan. bd komit. } tangkap: { :e bd batalkan.  }, mulai.

>> jumlah := bd kueri: ['SELECT COUNT(*) AS num FROM book'].
jumlah ambil: { :barisan Keluaran tulis: barisan num, baris-baru. }.
