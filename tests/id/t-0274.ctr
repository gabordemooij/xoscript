

Daftar saat: ['column:'] lakukan: { :column
	>> result := Daftar baru.
	diri setiap: { :index :row
		row setiap: { :index :cell
			(index = column) benar: { result tambah-di-akhir: cell. }.
		}.
	}. <- result.
}.


>> a := Daftar ←
	(Daftar ← 1 ; 2 ; 3) ;
	(Daftar ← 4 ; 5 ; 6) ;
	(Daftar ← 7 ; 8 ; 9).

>> b := a column: 1.
Keluaran tulis: b, baris-baru.

b := a column: 20.
Keluaran tulis: b, baris-baru.

b := a column: -100.
Keluaran tulis: b, baris-baru.
