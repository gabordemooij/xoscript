

Daftar saat: ['column:'] lakukan: { :kolom
	>> hasil := Daftar baru.
	diri setiap: { :indeks :barisan
		barisan setiap: { :indeks :sel
			(indeks = kolom) benar: { hasil tambah-di-akhir: sel. }.
		}.
	}. <- hasil.
}.


>> a := Daftar ←
	(Daftar ← 1 ; 2 ; 3) ;
	(Daftar ← 4 ; 5 ; 6) ;
	(Daftar ← 7 ; 8 ; 9).

>> b := a column: 1.
Keluaran tulis: b, baris-baru.

b := a column: 20.
Keluaran tulis: b, baris-baru.

b := a column: -100.
Keluaran tulis: b, baris-baru.
