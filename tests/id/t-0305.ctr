
Angka pelajari: ['plus:'] berarti: ['+'].
Angka saat: ['+'] lakukan: { :x
	>> rate := 1.
	>> currency := x satuan.
	(currency = ['euros']) benar: {
		rate := 2.
	}. <- (diri plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars beri-satuan: ['dollars'].
euros beri-satuan: ['euros'].
>> money := dollars + euros.
Keluaran tulis: money, baris-baru.
