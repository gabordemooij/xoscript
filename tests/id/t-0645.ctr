Server init.
Keluaran tulis: ['Tes tanggal basis data'], baris-baru.

>> bd := Maria-DB baru hos: ['localhost'],
	nama-pengguna: ['xo'], 
	kata-sandi: ['pass123'],
	nama-basis-data: ['xobase'],
	sambungkan.

>> parameter-pencarian :=
bd kueri: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
ambil: { :barisan
	Keluaran tulis: barisan datetest, baris-baru.
}.
