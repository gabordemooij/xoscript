Server init.
Keluaran tulis: ['Database date test'], baris-baru.

>> db := Maria-DB baru hos: ['localhost'],
	nama-pengguna: ['xo'], 
	kata-sandi: ['pass123'],
	nama-basis-data: ['xobase'],
	sambungkan.

>> parameter-pencarian :=
db kueri: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
ambil: { :row
	Keluaran tulis: row datetest, baris-baru.
}.
