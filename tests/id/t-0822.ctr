# parameter yang lebih sedikit dari placeholder harus memberi galat, bukan membaca melewati binding
Server init.

>> bd := Maria-DB baru hos: ['localhost'],
	nama-pengguna: ['xo'],
	kata-sandi: ['pass123'],
	nama-basis-data: ['xobase'],
	sambungkan.

>> parameter-pencarian := bd kueri: ['SELECT ? AS a, ? AS b, ? AS c'].
parameter-pencarian parameter: (Daftar baru ; ['1']).
{ parameter-pencarian ambil: { :barisan Keluaran tulis: barisan, baris-baru. }. } tangkap: { :e Keluaran tulis: e, baris-baru. }, mulai.

>> parameter-pencarian := bd kueri: ['SELECT ? AS a'].
{ parameter-pencarian ambil: { :barisan Keluaran tulis: barisan, baris-baru. }. } tangkap: { :e Keluaran tulis: e, baris-baru. }, mulai.

# jumlah yang tepat tetap berfungsi, parameter berlebih diabaikan seperti sebelumnya
>> parameter-pencarian := bd kueri: ['SELECT ? AS a, ? AS b'].
parameter-pencarian parameter: (Daftar baru ; ['1'] ; ['2']).
parameter-pencarian ambil: { :barisan Keluaran tulis: (barisan di: ['a']), tulis: (barisan di: ['b']), baris-baru. }.
parameter-pencarian parameter: (Daftar baru ; ['1'] ; ['2'] ; ['3']).
parameter-pencarian ambil: { :barisan Keluaran tulis: (barisan di: ['a']), tulis: (barisan di: ['b']), baris-baru. }.
