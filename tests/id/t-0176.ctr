

>> memoriTerpakai1 := 0.
>> memoriTerpakai2 := 0.
>> memoriTerpakai3 := 0.
>> memoriTerpakai4 := 0.

Program manajemen-memori: 0.

>> txt := ['Word Salad'].
Keluaran tulis: ['Panjang Teks: '] + txt panjang, baris-baru.
Keluaran tulis: ['Karakter di 2:'] + ( txt karakter: 2 ), baris-baru.
Keluaran tulis: (( txt temukan: ['S'] ) - 0), baris-baru.

Program bersihkan.

memoriTerpakai1 := (Program memori ? 0).


txt := ['Word Salad'].
Keluaran tulis: ['Panjang Teks: '] + txt panjang, baris-baru.
Keluaran tulis: ['Karakter di 2:'] + ( txt karakter: 2 ), baris-baru.
Keluaran tulis: (( txt temukan: ['S'] ) - 0), baris-baru.

Program bersihkan.
memoriTerpakai2 := (Program memori ? 0).


txt := ['Word Salad'].
Keluaran tulis: ['Panjang Teks: '] + txt panjang, baris-baru.
Keluaran tulis: ['Karakter di 2:'] + ( txt karakter: 2 ), baris-baru.
Keluaran tulis: (( txt temukan: ['S'] ) - 0), baris-baru.

Program bersihkan.
memoriTerpakai3 := (Program memori ? 0).



( memoriTerpakai1 = memoriTerpakai2 dan: memoriTerpakai1 = memoriTerpakai3, dan: memoriTerpakai2 = memoriTerpakai3 ) benar: {
	Keluaran tulis: ['Tidak ada kebocoran memori di sini'].
}, salah: {
	Keluaran tulis: ['Memori bocor...'].
}.
