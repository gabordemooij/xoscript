

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program manajemen-memori: 0.

>> txt := ['Word Salad'].
Keluaran tulis: ['Text Length: '] + txt panjang, baris-baru.
Keluaran tulis: ['Character at 2:'] + ( txt karakter: 2 ), baris-baru.
Keluaran tulis: (( txt temukan: ['S'] ) - 0), baris-baru.

Program bersihkan.

usedMemory1 := (Program memori ? 0).


txt := ['Word Salad'].
Keluaran tulis: ['Text Length: '] + txt panjang, baris-baru.
Keluaran tulis: ['Character at 2:'] + ( txt karakter: 2 ), baris-baru.
Keluaran tulis: (( txt temukan: ['S'] ) - 0), baris-baru.

Program bersihkan.
usedMemory2 := (Program memori ? 0).


txt := ['Word Salad'].
Keluaran tulis: ['Text Length: '] + txt panjang, baris-baru.
Keluaran tulis: ['Character at 2:'] + ( txt karakter: 2 ), baris-baru.
Keluaran tulis: (( txt temukan: ['S'] ) - 0), baris-baru.

Program bersihkan.
usedMemory3 := (Program memori ? 0).



( usedMemory1 = usedMemory2 dan: usedMemory1 = usedMemory3, dan: usedMemory2 = usedMemory3 ) benar: {
	Keluaran tulis: ['No memory leaks here'].
}, salah: {
	Keluaran tulis: ['Leaking memory...'].
}.
