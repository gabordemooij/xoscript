# test list operations


>> cakes := Daftar ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes ganti: 1 panjang: 2 dengan: ( Daftar ← ['cinnamon'] ; ['pineapple'] ).
Keluaran tulis: (buy gabungkan: [',']), baris-baru.


>> buy := cakes ganti: 1 panjang: 12 dengan: ( Daftar ← ['cinnamon'] ; ['pineapple'] ).
Keluaran tulis: (buy gabungkan: [',']), baris-baru.


>> buy := cakes ganti: 2 panjang: 10 dengan: ( Daftar baru ).
Keluaran tulis: (buy gabungkan: [',']), baris-baru.


>> buy := cakes ganti: 0 panjang: 1 dengan: ( Daftar baru ).
Keluaran tulis: (buy gabungkan: [',']), baris-baru.


>> buy := cakes ganti: ['0'] panjang: ['1'] dengan: ['x'].
Keluaran tulis: (buy gabungkan: [',']), baris-baru.
