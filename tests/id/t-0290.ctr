# uji operasi daftar


>> kue-kue := Daftar ←
	['apple'] ;
	['beri'] ;
	['cokelat'] ;
	['keju'].


>> beli := kue-kue ganti: 1 panjang: 2 dengan: ( Daftar ← ['kayu manis'] ; ['nanas'] ).
Keluaran tulis: (beli gabungkan: [',']), baris-baru.


>> beli := kue-kue ganti: 1 panjang: 12 dengan: ( Daftar ← ['kayu manis'] ; ['nanas'] ).
Keluaran tulis: (beli gabungkan: [',']), baris-baru.


>> beli := kue-kue ganti: 2 panjang: 10 dengan: ( Daftar baru ).
Keluaran tulis: (beli gabungkan: [',']), baris-baru.


>> beli := kue-kue ganti: 0 panjang: 1 dengan: ( Daftar baru ).
Keluaran tulis: (beli gabungkan: [',']), baris-baru.


>> beli := kue-kue ganti: ['0'] panjang: ['1'] dengan: ['x'].
Keluaran tulis: (beli gabungkan: [',']), baris-baru.
