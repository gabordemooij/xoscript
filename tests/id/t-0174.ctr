


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program manajemen-memori: 0.
>> palette := Kosong.
>> colors := Kosong.

{
palette := Kamus baru.
palette 
	taruh: ['#F00'] di: ['red'],
	taruh: ['#0F0'] di: ['green'],
	taruh: ['#00F'] di: ['blue'].
Keluaran tulis: ['number of RGB codes in palette: '] + ( palette jumlah ), baris-baru.
Keluaran tulis: ['RGB code of green is: '] + ( palette ? ['green'] ), baris-baru.
colors := [''].
( palette setiap: { :nama :kode
		colors := colors + ( nama + [':'] + kode ).
} ).
Keluaran tulis: ['All colors in palette: '] + colors, baris-baru.
} mulai.
Program bersihkan.
usedMemory1 := (Program memori ? 0).

{
palette := Kamus baru.
palette 
	taruh: ['#F00'] di: ['red'],
	taruh: ['#0F0'] di: ['green'],
	taruh: ['#00F'] di: ['blue'].
