


>> memoriTerpakai1 := 0.
>> memoriTerpakai2 := 0.
>> memoriTerpakai3 := 0.
>> memoriTerpakai4 := 0.

Program manajemen-memori: 0.
>> palet := Kosong.
>> warna-warna := Kosong.

{
palet := Kamus baru.
palet 
	taruh: ['#F00'] di: ['merah'],
	taruh: ['#0F0'] di: ['hijau'],
	taruh: ['#00F'] di: ['biru'].
Keluaran tulis: ['jumlah kode RGB dalam palet: '] + ( palet jumlah ), baris-baru.
Keluaran tulis: ['Kode RGB hijau adalah: '] + ( palet ? ['hijau'] ), baris-baru.
warna-warna := [''].
( palet setiap: { :nama :kode
		warna-warna := warna-warna + ( nama + [':'] + kode ).
} ).
Keluaran tulis: ['Semua warna dalam palet: '] + warna-warna, baris-baru.
} mulai.
Program bersihkan.
memoriTerpakai1 := (Program memori ? 0).

{
palet := Kamus baru.
palet 
	taruh: ['#F00'] di: ['merah'],
	taruh: ['#0F0'] di: ['hijau'],
