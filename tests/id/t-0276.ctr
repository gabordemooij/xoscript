>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objek baru.
⚄ saat: ['drawFrom:length:'] lakukan: { :pool :jumlah
	
	>> result := [''].
	
	{
		>> index := Angka random % (pool panjang).
		result tambah-di-akhir: ( pool karakter: (index + 1) ).
		
	} × jumlah. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? panjang.
Keluaran tulis: (['x↵'] x random panjang).
Keluaran tulis: (['y↵'] y ?? panjang).

