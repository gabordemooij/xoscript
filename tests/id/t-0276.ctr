>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objek baru.
⚄ saat: ['ambilDari:panjang:'] lakukan: { :kumpulan :jumlah
	
	>> hasil := [''].
	
	{
		>> indeks := Angka acak % (kumpulan panjang).
		hasil tambah-di-akhir: ( kumpulan karakter: (indeks + 1) ).
		
	} × jumlah. <- hasil.
}.

>> acak := ⚄ ambilDari: ?? panjang: ?? panjang.
Keluaran tulis: (['x↵'] x acak panjang).
Keluaran tulis: (['y↵'] y ?? panjang).

