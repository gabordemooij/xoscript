Angka saat: ['roman'] lakukan: {
	>> angka := diri salin.
	>> roman := [''].
	{
		{
			(angka ≥ 1000) benar: {
				roman tambah-di-akhir: ['Ⅿ'].
				angka kurangi: 1000.
			}, hentikan.
		
			(angka ≥ 500) benar: {
				roman tambah-di-akhir: ['Ⅾ'].
				angka kurangi: 500.
			}, hentikan.
		
			(angka ≥ 100) benar: {
				roman tambah-di-akhir: ['Ⅽ'].
				angka kurangi: 100.
			}, hentikan.
		
			(angka ≥ 50) benar: {
				roman tambah-di-akhir: ['Ⅼ'].
				angka kurangi: 50.
			}, hentikan.
		
			(angka ≥ 50) benar: {
				roman tambah-di-akhir: ['Ⅼ'].
				angka kurangi: 50.
			}, hentikan.
		
			(angka ≥ 10) benar: {
				roman tambah-di-akhir: ['Ⅹ'].
				angka kurangi: 10.
			}, hentikan.
			
			(angka ≥ 9) benar: {
				roman tambah-di-akhir: ['Ⅸ'].
				angka kurangi: 9.
			}, hentikan.
			
			(angka ≥ 5) benar: {
				roman tambah-di-akhir: ['Ⅴ'].
				angka kurangi: 5.
			}, hentikan.
			
			(angka ≥ 4) benar: {
				roman tambah-di-akhir: ['Ⅳ'].
				angka kurangi: 4.
			}, hentikan.
			
			(angka ≥ 1) benar: {
				roman tambah-di-akhir: ['Ⅰ'].
				angka kurangi: 1.
			}, hentikan.
		} prosedur.
	} selama: { <- angka > 0. }. <- roman.
}.

Keluaran tulis: 1 roman, baris-baru.
Keluaran tulis: 2 roman, baris-baru.
Keluaran tulis: 4 roman, baris-baru.
Keluaran tulis: 8 roman, baris-baru.
Keluaran tulis: 16 roman, baris-baru.
Keluaran tulis: 32 roman, baris-baru.
Keluaran tulis: 64 roman, baris-baru.
Keluaran tulis: 128 roman, baris-baru.
Keluaran tulis: 256 roman, baris-baru.
Keluaran tulis: 1024 roman, baris-baru.
