Angka saat: ['romawi'] lakukan: {
	>> angka := diri salin.
	>> romawi := [''].
	{
		{
			(angka ≥ 1000) benar: {
				romawi tambah-di-akhir: ['Ⅿ'].
				angka kurangi: 1000.
			}, hentikan.
		
			(angka ≥ 500) benar: {
				romawi tambah-di-akhir: ['Ⅾ'].
				angka kurangi: 500.
			}, hentikan.
		
			(angka ≥ 100) benar: {
				romawi tambah-di-akhir: ['Ⅽ'].
				angka kurangi: 100.
			}, hentikan.
		
			(angka ≥ 50) benar: {
				romawi tambah-di-akhir: ['Ⅼ'].
				angka kurangi: 50.
			}, hentikan.
		
			(angka ≥ 50) benar: {
				romawi tambah-di-akhir: ['Ⅼ'].
				angka kurangi: 50.
			}, hentikan.
		
			(angka ≥ 10) benar: {
				romawi tambah-di-akhir: ['Ⅹ'].
				angka kurangi: 10.
			}, hentikan.
			
			(angka ≥ 9) benar: {
				romawi tambah-di-akhir: ['Ⅸ'].
				angka kurangi: 9.
			}, hentikan.
			
			(angka ≥ 5) benar: {
				romawi tambah-di-akhir: ['Ⅴ'].
				angka kurangi: 5.
			}, hentikan.
			
			(angka ≥ 4) benar: {
				romawi tambah-di-akhir: ['Ⅳ'].
				angka kurangi: 4.
			}, hentikan.
			
			(angka ≥ 1) benar: {
				romawi tambah-di-akhir: ['Ⅰ'].
				angka kurangi: 1.
			}, hentikan.
		} prosedur.
	} selama: { <- angka > 0. }. <- romawi.
}.

Keluaran tulis: 1 romawi, baris-baru.
Keluaran tulis: 2 romawi, baris-baru.
Keluaran tulis: 4 romawi, baris-baru.
Keluaran tulis: 8 romawi, baris-baru.
