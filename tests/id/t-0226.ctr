# Uji varian ASCII

# Angka

Keluaran tulis: (2 !=: 3), baris-baru.
Keluaran tulis: (2 <=: 2), baris-baru.
Keluaran tulis: (2 >=: 2), baris-baru.

# Teks

Keluaran tulis: (['b'] >=: ['a']), baris-baru.
Keluaran tulis: (['b'] !=: ['a']), baris-baru.
Keluaran tulis: (['b'] <=: ['c']), baris-baru.

# Boolean

Keluaran tulis: (Benar !=: Salah), baris-baru.

# Objek

Keluaran tulis: (Objek baru !=: Objek baru), baris-baru.

# simbol daftar ASCII <-:

Keluaran tulis: (Daftar <<: 1, ; 2 ; 3) jumlah = 3, baris-baru.

