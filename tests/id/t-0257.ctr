
>> Greeter := Objek baru.
Greeter saat: ['baru'] lakukan: {
	milik nama := ['?'].
}.
Greeter saat: ['name:'] lakukan: { :nama
	milik nama := nama.
}.
Greeter saat: ['greet'] lakukan: {
	Keluaran tulis: (['hello[you]'] [you]: milik nama).
}.
>> friend := Greeter baru.
friend name: ['1'].
friend greet.
