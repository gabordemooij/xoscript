{
	tugas-ini galat: ['Dont fail.'].
	unknown doSomething.
} tangkap: {
	Keluaran tulis: ['Caught!'].
}, mulai.

{
	tugas-ini galat: ['Dont fail.'].
	milik unknown doSomething.
} tangkap: {
	Keluaran tulis: ['Caught!'].
}, mulai.

{
	tugas-ini galat: ['Dont fail.'].
	unknown := 122.
} tangkap: {
	Keluaran tulis: ['Caught!'].
}, mulai.


{
	tugas-ini galat: ['Dont fail.'].
	Benar hentikan.
	Keluaran tulis: ['FAIL'].
} tangkap: {
	Keluaran tulis: ['Caught!'].
}, mulai.

{
	{
		tugas-ini galat: ['Dont fail.'].
		Benar hentikan.
		Keluaran tulis: ['FAIL'].
	} tangkap: { :x
		(x = ['Dont fail.']) benar: { tugas-ini galat: ['Nested Caught!']. }.
	}, mulai.
} tangkap: { :e
	Keluaran tulis: e.
}, mulai.
