

Teks saat: ['evaluasi'] lakukan: {
	>> kode := Berkas baru: ['/tmp/eval.ctr'].
	kode tulis: (diri teks + ['.']).
	Program gunakan: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Daftar ← (['Tanda kutip '] + Q + [' itu jahat?']) ; 1.
>> x := q teks.
Keluaran tulis: x, baris-baru.
>> y := Kosong.
(['y := '] + x ) evaluasi.
Keluaran tulis: y ? 0, baris-baru.

q := Kamus taruh: ['\[''] di: ['\['quote\']'].
x := q teks.
Keluaran tulis: x, baris-baru.
y := Kosong.
(['y := '] + x ) evaluasi.

>> q := (Kamus baru) taruh:['\[''] di:['\['quote\[''].
Keluaran tulis: y ? ['\['quote\']'], baris-baru.
