#OBSD
>> dirname := [''].
{ dirname tambah-di-akhir: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Program sistem: command.
Program chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename tambah-di-akhir: ['YYYYYYYY']. } * 20.
Berkas baru: filename, tulis: ['sometext'].
{ Berkas daftar: ['/tmp/'] + dirname. } * 1000.
Keluaran tulis: ['no crash'], baris-baru.

