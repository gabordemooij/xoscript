>> items := Kamus baru.
items taruh: ['black'] di: ['coffee'], taruh: ['earl grey'] di: ['tea'].
Keluaran tulis: (items di: ['coffee']), tulis: (items di: ['tea']).
Keluaran tulis: ['there are'] + items jumlah + [' items in the array.'].
items taruh: ['capuccino'] di: ['coffee'].
Keluaran tulis: ['Now my coffee is.. '] + (items di: ['coffee']).
items taruh: ['aaa'] di: ['1'].
items taruh: ['bbb'] di: ['2'].
Keluaran tulis: (items di: ['a']).
