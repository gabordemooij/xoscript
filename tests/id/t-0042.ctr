>> items := Kamus baru.
items taruh: ['hitam'] di: ['coffee'], taruh: ['earl grey'] di: ['teh'].
Keluaran tulis: (items di: ['coffee']), tulis: (items di: ['teh']).
Keluaran tulis: ['ada'] + items jumlah + [' item dalam larik.'].
items taruh: ['capuccino'] di: ['coffee'].
Keluaran tulis: ['Sekarang kopi saya adalah.. '] + (items di: ['coffee']).
items taruh: ['aaa'] di: ['1'].
items taruh: ['bbb'] di: ['2'].
Keluaran tulis: (items di: ['a']).
