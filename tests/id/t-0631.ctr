#uji ffi


Server init.

Program manajemen-memori: 4.

# untuk uji ini Anda perlu mengatur jalur ke libc (puts)
>> namapustaka := Program pengaturan: ['FFITESTLIB'].



Server tautkan: (
 Daftar baru ;
 namapustaka ;
 ['puts'] ;
 ( Daftar baru ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s bebaskan.

# uji dengan struct

>> a := Blob baru: 8.
a bytes: (
	Daftar <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struktur := Blob struct: (Daftar <<: ['int'], ; ['int']).

Server tautkan: (
	Daftar <<: ['@structtest'], ;
	['@structtest'] ;
	(Daftar <<: struktur) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Keluaran tulis: ['Tes jumlah:'] + (ffitest ffisum: a), baris-baru.

struktur bebaskan-struct.
struktur bebaskan.
a bebaskan.
