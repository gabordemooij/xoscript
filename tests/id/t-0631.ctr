#ffi test


Server init.

Program manajemen-memori: 4.

# for this test you need set a path to libc (puts)
>> libname := Program pengaturan: ['FFITESTLIB'].



Server tautkan: (
 Daftar baru ;
 libname ;
 ['puts'] ;
 ( Daftar baru ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s bebaskan.

# test with struct

>> a := Blob baru: 8.
a bytes: (
	Daftar <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Daftar <<: ['int'], ; ['int']).

Server tautkan: (
	Daftar <<: ['@structtest'], ;
	['@structtest'] ;
	(Daftar <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Keluaran tulis: ['Sum test:'] + (ffitest ffisum: a), baris-baru.

struct bebaskan-struct.
struct bebaskan.
a bebaskan.
