Keluaran tulis: ['Test object'], baris-baru.
>> a := Objek baru. 

a saat: ['item:'] lakukan: { :hexhelper
	milik hexhelper := hexhelper. 
}.

a saat: ['item'] lakukan: { <- milik hexhelper.
}.

a item: Hx baru.

>> old-hexhelper-address := a item prototipe alamat-memori.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baru.

>> b := Objek load-from: ['/tmp/a.bin'].

(b item prototipe alamat-memori = old-hexhelper-address) benar: {
	Keluaran tulis: ['Object link re-attached.'], baris-baru.
}.
