Keluaran tulis: ['Objek uji'], baris-baru.
>> a := Objek baru. 

a saat: ['item:'] lakukan: { :pembantuheks
	milik pembantuheks := pembantuheks. 
}.

a saat: ['barang'] lakukan: {
	<- milik pembantuheks.
}.

a item: Hx baru.

>> alamat-lama-pembantuheks := a barang prototipe alamat-memori.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== MEMUAT ULANG SNAP:'], baris-baru.

>> b := Objek load-from: ['/tmp/a.bin'].

(b barang prototipe alamat-memori = alamat-lama-pembantuheks) benar: {
	Keluaran tulis: ['Tautan objek dipasang kembali.'], baris-baru.
}.
