Keluaran tulis: ['Test object'], baris-baru.
>> a := Objek baru. 

a saat: ['item:'] lakukan: { :dict
	milik dict := dict. 
}.

a saat: ['item'] lakukan: { <- milik dict.
}.

a item: (
Kamus baru
	hello: ['world']).

>> old-dict-address := a item prototipe alamat-memori.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baru.

>> b := Objek load-from: ['/tmp/a.bin'].

(b item prototipe alamat-memori = old-dict-address) benar: {
	Keluaran tulis: ['Object link re-attached.'], baris-baru.
}.

Keluaran tulis: b item, baris-baru.
