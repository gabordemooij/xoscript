Teks saat: ['evaluate'] lakukan: {
	>> kode := Berkas baru: ['/tmp/eval.ctr'].
	kode tulis: (diri teks + ['.']).
	Program gunakan: ['/tmp/eval.ctr'].
}.

>> a := Daftar ← 1 ; 2 ; 3.
>> b := (a teks).

Keluaran tulis: b, baris-baru. 
(['b := '] + b) evaluate.

Keluaran tulis: b ? 2, baris-baru. 

Keluaran tulis: (( Daftar ← 1 ; 2 ; 3 )), baris-baru. 

Keluaran tulis: ((Kamus baru) taruh: 1 di: 2), baris-baru. 

>> x := ( (Daftar ← 1 ; ( Daftar ← 9 ) ; Benar ) ) teks.
Keluaran tulis: x, baris-baru. 
(['x := '] + x) evaluate.

Keluaran tulis: x ? 1 ? 0, baris-baru. 

>> y := (Kamus baru) taruh: (Daftar ← 1) di: (Daftar ← 2).
Keluaran tulis: y, baris-baru. 

(['y := '] + y) teks evaluate.

Keluaran tulis: (y di: (Daftar ← 2) teks ), baris-baru.

Keluaran tulis: (Daftar baru), baris-baru. 
Keluaran tulis: (Kamus baru), baris-baru. 
