


>> anggur := Objek baru.


anggur saat: ['keTeks'] lakukan: { <- ['merlot'].
}.

anggur saat: ['naarTekst'] lakukan: { <- ['merlot'].
}.


anggur saat: ['='] lakukan: { :other wine <- ( diri keTeks = other wine ).
}.

anggur saat: ['=='] lakukan: { :other wine <- ( diri keTeks = other wine ).
}.



anggur
	kasus: ['cabernet'] lakukan: { Keluaran tulis: ['ini Cabernet!']. },
	kasus: ['syrah']    lakukan: { Keluaran tulis: ['ini Syrah!'].    },
	kasus: ['merlot']   lakukan: { Keluaran tulis: ['ini Merlot!'].   },
	kasus: ['malbec']   lakukan: { Keluaran tulis: ['ini Malbec!'].   }.

Keluaran baris-baru.
