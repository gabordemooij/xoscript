


>> wine := Objek baru.


wine saat: ['toString'] lakukan: { <- ['merlot'].
}.

wine saat: ['naarTekst'] lakukan: { <- ['merlot'].
}.


wine saat: ['='] lakukan: { :other wine <- ( diri toString = other wine ).
}.

wine saat: ['=='] lakukan: { :other wine <- ( diri toString = other wine ).
}.



wine
	kasus: ['cabernet'] lakukan: { Keluaran tulis: ['it's a Cabernet!']. },
	kasus: ['syrah']    lakukan: { Keluaran tulis: ['it's a Syrah!'].    },
	kasus: ['merlot']   lakukan: { Keluaran tulis: ['it's a Merlot!'].   },
	kasus: ['malbec']   lakukan: { Keluaran tulis: ['it's a Malbec!'].   }.

Keluaran baris-baru.
