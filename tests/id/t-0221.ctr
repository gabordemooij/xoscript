>> x := Objek baru.
>> y := Objek baru.
>> z := x.
Keluaran tulis: (x = z), baris-baru.
Keluaran tulis: (x = y), baris-baru.
Keluaran tulis: (x ≠ y), baris-baru.
Keluaran tulis: (x ≠ z), baris-baru.
>> m := Momen baru tahun: 2070, bulan: 11.
>> n := m salin.
Keluaran tulis: (m = n), baris-baru.
Keluaran tulis: (m ≠ n), baris-baru.
Keluaran tulis: (m sama-dengan: m), baris-baru.
Keluaran tulis: (m sama-dengan: n), baris-baru.
n bulan: 12.
Keluaran tulis: (m ≠ n), baris-baru.
Keluaran tulis: (m = n), baris-baru.


