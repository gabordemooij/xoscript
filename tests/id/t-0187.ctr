Angka saat: ['faktorial'] lakukan: {
	>> total := 1.
	{ :indeks total kalikan-dengan: (diri - indeks). } × diri. <- total.
}.

>> memoriTerpakai1 := 0.
>> memoriTerpakai2 := 0.
>> memoriTerpakai3 := 0.
>> memoriTerpakai4 := 0.

Program manajemen-memori: 0.

{
2 eksponen faktorial.
Keluaran tulis: (11 sisa-bagi: 3), baris-baru.
Keluaran tulis: (3.4 bulatkan), baris-baru.
Keluaran tulis: (7.1 bulatkan-ke-atas), baris-baru.
Keluaran tulis: (7.9 bulatkan-ke-bawah), baris-baru.
}
mulai.

Program bersihkan.

memoriTerpakai1 := (Program memori ? 0).

{
2 eksponen faktorial.
Keluaran tulis: (11 sisa-bagi: 3), baris-baru.
Keluaran tulis: (3.4 bulatkan), baris-baru.
Keluaran tulis: (7.1 bulatkan-ke-atas), baris-baru.
Keluaran tulis: (7.9 bulatkan-ke-bawah), baris-baru.
}
mulai.

Program bersihkan.
memoriTerpakai2 := (Program memori ? 0).


{
2 eksponen faktorial.
Keluaran tulis: (11 sisa-bagi: 3), baris-baru.
Keluaran tulis: (3.4 bulatkan), baris-baru.
Keluaran tulis: (7.1 bulatkan-ke-atas), baris-baru.
Keluaran tulis: (7.9 bulatkan-ke-bawah), baris-baru.
} mulai.

Program bersihkan.
memoriTerpakai3 := (Program memori ? 0).



( memoriTerpakai1 = memoriTerpakai2 dan: memoriTerpakai1 = memoriTerpakai3, dan: memoriTerpakai2 = memoriTerpakai3 ) benar: {
	Keluaran tulis: ['Tidak ada kebocoran memori di sini'].
}, salah: {
	Keluaran tulis: ['Memori bocor...'].
}.
