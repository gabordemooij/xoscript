Angka saat: ['factorial'] lakukan: {
	>> total := 1.
	{ :index total kalikan-dengan: (diri - index). } × diri. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program manajemen-memori: 0.

{
2 exponent factorial.
Keluaran tulis: (11 sisa-bagi: 3), baris-baru.
Keluaran tulis: (3.4 bulatkan), baris-baru.
Keluaran tulis: (7.1 bulatkan-ke-atas), baris-baru.
Keluaran tulis: (7.9 bulatkan-ke-bawah), baris-baru.
}
mulai.

Program bersihkan.

usedMemory1 := (Program memori ? 0).

{
2 exponent factorial.
Keluaran tulis: (11 sisa-bagi: 3), baris-baru.
Keluaran tulis: (3.4 bulatkan), baris-baru.
