Server init.

>> BD := Maria-DB baru hos: ['localhost'],
	nama-pengguna: ['xo'],
	kata-sandi: ['pass123'],
	nama-basis-data: ['xobase'],
	sambungkan.
	
>> SQL := ['SELECT "hello" AS "world" '].

# cara yang lebih cepat, ambil kueri dari BD:
>> kueri2 := BD kueri: SQL.

# sekarang Anda tidak perlu mengatur BD
kueri2 ambil: { :barisan
	Keluaran tulis: barisan world, baris-baru.
}.
