Server init.

>> DB := Maria-DB baru hos: ['localhost'],
	nama-pengguna: ['xo'],
	kata-sandi: ['pass123'],
	nama-basis-data: ['xobase'],
	sambungkan.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB kueri: SQL.

# now you don't have to set DB
query2 ambil: { :row
	Keluaran tulis: row world, baris-baru.
}.
