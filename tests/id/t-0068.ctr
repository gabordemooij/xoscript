>> w := ['A_bottle_of_Whisky and a rare steak.'].
Keluaran tulis: ['=== Basic test, grab the bottle! ==='], baris-baru.
Keluaran tulis: ['>']+(w salin dari:2 panjang: 6), baris-baru.
Keluaran tulis: ['>']+(w salin dari:8 panjang: -6), baris-baru.
Keluaran tulis: ['>']+(w salin dari:2 panjang: 6), baris-baru.
Keluaran tulis: ['>']+(w salin dari:8 panjang: -6), baris-baru.
Keluaran tulis: ['=== Take a single char ==='], baris-baru.
Keluaran tulis: ['>']+(w salin dari:7 panjang: 1), baris-baru.
Keluaran tulis: ['>']+(w salin dari:7 panjang: 1), baris-baru.
Keluaran tulis: ['=== The 0 case, empty string ==='], baris-baru.
Keluaran tulis: ['>']+(w salin dari:7 panjang: 0), baris-baru.
Keluaran tulis: ['>']+(w salin dari:7 panjang: 0), baris-baru.
Keluaran tulis: ['=== Edge case, first character only ==='], baris-baru.
Keluaran tulis: ['>']+(w salin dari:0 panjang: 1), baris-baru.
Keluaran tulis: ['>']+(w salin dari:0 panjang: 1), baris-baru.
Keluaran tulis: ['>']+(w salin dari:1 panjang: -1), baris-baru.
Keluaran tulis: ['>']+(w salin dari:1 panjang: -1), baris-baru.
Keluaran tulis: ['=== Edge case, last character only ==='], baris-baru.
Keluaran tulis: ['>']+(w salin dari:35 panjang: 1), baris-baru.
Keluaran tulis: ['>']+(w salin dari:35 panjang: 1), baris-baru.
Keluaran tulis: ['>']+(w salin dari:36 panjang: -1), baris-baru.
Keluaran tulis: ['>']+(w salin dari:36 panjang: -1), baris-baru.
Keluaran tulis: ['=== Out of bounds, empty string ==='], baris-baru.
Keluaran tulis: ['>']+(w salin dari:36 panjang: 37), baris-baru.
Keluaran tulis: ['>']+(w salin dari:36 panjang: 47), baris-baru.
Keluaran tulis: ['>']+(w salin dari:-1 panjang: -2), baris-baru.
Keluaran tulis: ['>']+(w salin dari:-2 panjang: -1), baris-baru.
Keluaran tulis: ['=== Part out of bounds, full string ==='], baris-baru.
Keluaran tulis: ['>']+(w salin dari:-20 panjang: 90), baris-baru.
Keluaran tulis: ['>']+(w salin dari:90 panjang: -20), baris-baru.
Keluaran tulis: ['>']+(w salin dari:-20 panjang: 90), baris-baru.
Keluaran tulis: ['>']+(w salin dari:90 panjang: -120), baris-baru.
