
Server init.
>> rq := Permintaan-HTTP baru.
Keluaran tulis: ['HTTP-GET d[]=']  + ( rq get-daftar: ['d[]'] ), baris-baru. # GET
Keluaran tulis: ['HTTP-GET f[]=']  + ( rq get-daftar: ['f[]'] ), baris-baru. # GET
Keluaran tulis: ['HTTP-POST e[]='] + ( rq post-daftar: ['e[]'] ), baris-baru. # GET
Keluaran tulis: ['HTTP-POST c=']   + ( rq post: ['c'] ), baris-baru. # GET
Keluaran tulis: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), baris-baru. # GET
