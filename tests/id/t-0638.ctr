
Server init.
>> pmt := Permintaan-HTTP baru.
Keluaran tulis: ['HTTP-GET d[]=']  + ( pmt get-daftar: ['d[]'] ), baris-baru. # GET
Keluaran tulis: ['HTTP-GET f[]=']  + ( pmt get-daftar: ['f[]'] ), baris-baru. # GET
Keluaran tulis: ['HTTP-POST e[]='] + ( pmt post-daftar: ['e[]'] ), baris-baru. # GET
Keluaran tulis: ['HTTP-POST c=']   + ( pmt post: ['c'] ), baris-baru. # GET
Keluaran tulis: ['HTTP-POST xx=']  + ( pmt post: ['xx'] ), baris-baru. # GET
