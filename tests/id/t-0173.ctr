

Daftar saat: ['jumlahkan'] lakukan: {
	>> total := 0.
	diri setiap: { :indeks :elemen
		total tambah: elemen.
	}. <- total.
}.

Daftar saat: ['hasil-kali'] lakukan: {
	>> total := 1.
	diri setiap: { :indeks :elemen
		total kalikan-dengan: elemen.
	}. <- total.
}.

>> memoriTerpakai1 := 0.
>> memoriTerpakai2 := 0.
>> memoriTerpakai3 := 0.
>> memoriTerpakai4 := 0.

Program manajemen-memori: 0.

{

>> a := Daftar ← ['hello'] ; ['world'] ; Benar ; Kosong ; 666.
a := a + ( Daftar ← 1 ).
Keluaran tulis: ( ['jumlah: '] + ( a jumlahkan ) ), baris-baru.
Keluaran tulis: ( ['min: '] + ( a minimum ) ), baris-baru.
Keluaran tulis: ( ['maks: '] + ( a maksimum ) ), baris-baru.
Keluaran tulis: ( ['ke-3: '] + ( a ? 2 ) ), baris-baru.
Keluaran tulis: ( ['hasil kali: '] + ( a hasil-kali ) ), baris-baru.
a urutkan: { :a :b <- (b - a). }.
a setiap: { :i :e Keluaran tulis: ( i - 0 ), baris-baru. }.

} mulai.

