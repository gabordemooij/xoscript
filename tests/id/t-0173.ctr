

Daftar saat: ['sum'] lakukan: {
	>> total := 0.
	diri setiap: { :index :element
		total tambah: element.
	}. <- total.
}.

Daftar saat: ['product'] lakukan: {
	>> total := 1.
	diri setiap: { :index :element
		total kalikan-dengan: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program manajemen-memori: 0.

{

>> a := Daftar ← ['hello'] ; ['world'] ; Benar ; Kosong ; 666.
a := a + ( Daftar ← 1 ).
Keluaran tulis: ( ['sum: '] + ( a sum ) ), baris-baru.
Keluaran tulis: ( ['min: '] + ( a minimum ) ), baris-baru.
Keluaran tulis: ( ['max: '] + ( a maksimum ) ), baris-baru.
Keluaran tulis: ( ['3rd: '] + ( a ? 2 ) ), baris-baru.
Keluaran tulis: ( ['prd: '] + ( a product ) ), baris-baru.
a urutkan: { :a :b <- (b - a). }.
a setiap: { :i :e Keluaran tulis: ( i - 0 ), baris-baru. }.

} mulai.

Program bersihkan.
usedMemory1 := (Program memori ? 0).


{

>> a := Daftar ← ['hello'] ; ['world'] ; Benar ; Kosong ; 666.
a := a + ( Daftar ← 1 ).
Keluaran tulis: ( ['sum: '] + ( a sum ) ), baris-baru.
Keluaran tulis: ( ['min: '] + ( a minimum ) ), baris-baru.
Keluaran tulis: ( ['max: '] + ( a maksimum ) ), baris-baru.
