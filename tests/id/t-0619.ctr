>> TeksHTML := Objek baru.
TeksHTML saat: ['tanggapi:'] lakukan: { :tag 
	Keluaran tulis: (['<tag>'] tag: tag), baris-baru.
}.
TeksHTML saat: ['tanggapi:dan:'] lakukan: { :tag :html 
	Keluaran tulis: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), baris-baru.
}.
>> html := TeksHTML baru.
html body h1: ['header'].

