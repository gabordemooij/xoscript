# Uji ini memeriksa apakah string_fill_in tidak kehilangan slotnya (di-gc) dalam mode 4
# referensi di world.c
>> Jurnal := Objek baru.

Jurnal saat: ['say:'] lakukan: { :str
	Keluaran tulis: str, baris-baru.
}.

>> Barang := Objek baru.

Barang saat: ['baru:'] lakukan: { :id
	<- diri baru id: id.
}.

Barang saat: ['id:'] lakukan: { :id
	milik id := id.
}.

Barang saat: ['id'] lakukan: { <- milik id. }.


Barang saat: ['teks'] lakukan: {
	>> str := ['Item#~no'].
	str ~no: milik id.
	<- str.
}.


>> Print := Objek baru.

Print saat: ['items'] lakukan: { 
	
	milik barang := Barang baru: 1.
	
	# entah segfault atau untaian yang salah di sini
	Jurnal say: (
		['~item printed.'] ~item: milik barang
	).
	
	
}.

Print items.