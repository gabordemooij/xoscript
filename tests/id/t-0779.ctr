Keluaran tulis: ['Objek uji'], baris-baru.
>> p := Jalur /tmp.
Keluaran tulis: p, baris-baru.
>> alamat-lama-p := p prototipe alamat-memori.
p save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== MEMUAT ULANG SNAP:'], baris-baru.
>> b := Objek load-from: ['/tmp/a.bin'].
(b prototipe alamat-memori = alamat-lama-p) benar: {
	Keluaran tulis: ['Tautan objek dipasang kembali.'], baris-baru.
}.
Keluaran tulis: b, baris-baru.
