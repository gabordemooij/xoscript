Keluaran tulis: ['Test object'], baris-baru.
>> p := Jalur /tmp.
Keluaran tulis: p, baris-baru.
>> old-p-address := p prototipe alamat-memori.
p save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baru.
>> b := Objek load-from: ['/tmp/a.bin'].
(b prototipe alamat-memori = old-p-address) benar: {
	Keluaran tulis: ['Object link re-attached.'], baris-baru.
}.
Keluaran tulis: b, baris-baru.
