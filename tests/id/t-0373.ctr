# compliance test

# use international numbers

Keluaran tulis: ['1000 -> '].
Keluaran tulis: 1000, baris-baru. #1000

Keluaran tulis: ['1.5 -> '].
Keluaran tulis: 1.5, baris-baru.  #1.5

Keluaran tulis: ['1001.5 -> '].
Keluaran tulis: 1.5 + 1000, baris-baru. #1001.5

# use 0-indexed arrays
>> x := Daftar baru ; 1 ; 2 ; 3.
>> y := Daftar baru ; ['a'] ; ['b'] ; ['c'].

Keluaran tulis: ['1 -> '].
Keluaran tulis: x ? 0, baris-baru. #1

Keluaran tulis: ['1 -> '].
Keluaran tulis: (x di: 0), baris-baru. #1

Keluaran tulis: ['1 -> '].
Keluaran tulis: x pertama, baris-baru. #1

Keluaran tulis: ['3 -> '].
Keluaran tulis: x terakhir, baris-baru. #3

Keluaran tulis: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Keluaran tulis: (x menurut: y), baris-baru.

Keluaran tulis: ['1 -> '].
Keluaran tulis: (x dari: 0 panjang: 1) pertama, baris-baru. #1

Keluaran tulis: ['0 -> '].
Keluaran tulis: (x temukan: 1), baris-baru. #0

x taruh: 9 di: 0.

Keluaran tulis: ['9 -> '].
Keluaran tulis: (x di: 0), baris-baru. #9

x tambah-di-awal: 8.
Keluaran tulis: ['8 -> '].
Keluaran tulis: (x di: 0), baris-baru. #9


x tambah-di-akhir: 10.
Keluaran tulis: ['10 -> '].
Keluaran tulis: (x di: 4), baris-baru. #10








