# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Pola baru: pattern.
	p cocok: subject lakukan: { :m :g
		Keluaran tulis: g jumlah, tulis: [' '], tulis: (g gabungkan: ['|']), baris-baru. <- m.
	}.
}.
show terapkan: ['(a)|(b)'] dan: ['b'].
show terapkan: ['(a)|(b)'] dan: ['a'].
show terapkan: ['(x)?y'] dan: ['y'].
show terapkan: ['(x)?(y)(z)?'] dan: ['xy'].
