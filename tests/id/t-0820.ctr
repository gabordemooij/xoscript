# grup yang bukan bagian dari kecocokan tidak boleh crash dan harus mempertahankan nomor grup
Server init.
>> tampilkan := { :pola-cari :subject
	>> p := Pola baru: pola-cari.
	p cocok: subject lakukan: { :m :g
		Keluaran tulis: g jumlah, tulis: [' '], tulis: (g gabungkan: ['|']), baris-baru.
		<- m.
	}.
}.
tampilkan terapkan: ['(a)|(b)'] dan: ['b'].
tampilkan terapkan: ['(a)|(b)'] dan: ['a'].
tampilkan terapkan: ['(x)?y'] dan: ['y'].
tampilkan terapkan: ['(x)?(y)(z)?'] dan: ['xy'].
