Server init.

# tulis berkas uji
>> f := Berkas baru: ['/tmp/test.gif'].
f tulis: ['GIF87a01234567810'].

# sajikan berkas
Server teruskan: ['test.gif'] awalan: ['/tmp/'].

Keluaran baris-baru.

Keluaran tulis: ['Di luar kontainer (keamanan):'], baris-baru.
{ Server teruskan: ['../passwd'] awalan: ['/tmp/']. }
tangkap: { :e Keluaran tulis: e, baris-baru. },
mulai.

Keluaran tulis: ['Prefiks tidak valid:'], baris-baru.
{ Server teruskan: ['test.gif'] awalan: ['z:\\']. }
tangkap: { :e Keluaran tulis: e, baris-baru. },
mulai.

Keluaran tulis: ['Berkas tidak ada:'], baris-baru.
{ Server teruskan: ['xxx.xxx'] awalan: ['/tmp/']. }
tangkap: { :e Keluaran tulis: e, baris-baru. },
mulai.
