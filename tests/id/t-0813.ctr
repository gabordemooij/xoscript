# pemisah baris dalam nilai tidak boleh membuat tajuk tambahan
Server inisialisasi.
Program gunakan: ['../../../src/xo/id/webtools.xo'].
Program gunakan: ['../../../src/xo/id/mailtools.xo'].

>> tajuk := Tajuk-HTTP baru kunci-tajuk: ['Location'] nilai: ['/ok\r\nX-Injected: yes'].
Keluaran tulis: tajuk.

>> web := Dokumen-Web baru.
web pergi-ke: ['/ok\r\nX-Injected: yes'].
Keluaran tulis: ['\n'], baris-baru.

>> surat := Surel baru.
surat kepada: (Daftar baru ; ['a@example.invalid\r\nX-To: yes']).
surat cc: (Daftar baru ; ['b@example.invalid\r\nX-Cc: yes']).
surat bcc: (Daftar baru ; ['c@example.invalid\r\nX-Bcc: yes']).
surat pengirim: ['d@example.invalid\r\nX-From: yes'] nama: ['site\r\nX-Name: yes'].
surat subjek: ['hello\r\nX-Subject: yes'].
surat badan: ['line1\r\nline2'].
Keluaran tulis: surat hasilkan.

>> html := Surel-HTML baru.
html kepada: (Daftar baru ; ['a@example.invalid\r\nX-To: yes']).
html pengirim: ['d@example.invalid'] nama: ['site'].
html subjek: ['hello\r\nX-Subject: yes'].
html badan: ['body'].
Keluaran tulis: ( html hasilkan mengandung: ['\nX-'] ), baris-baru.
Keluaran tulis: ( html hasilkan mengandung: ['X-To: yes'] ), baris-baru.
