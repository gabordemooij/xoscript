>> Agenda := Objek baru.

Agenda saat: ['baru'] lakukan: {
	milik list := Daftar baru.
}.

Agenda saat: ['nieuw'] lakukan: {
	milik list := Daftar baru.
}.

Agenda saat: ['+'] lakukan: { :tugas
	milik list tambah-di-akhir: tugas.
}.

Agenda saat: ['number of tasks?'] lakukan: { <-  milik list jumlah.
}.

>> tugas-tugas := 
	Agenda baru 
	+ ['masak makan malam'] 
	+ ['bersihkan kamar'].
	
Keluaran tulis: ['You have $ tasks to do'] $ tugas-tugas number of tasks?.
