>> To-Do := Objek baru.

To-Do saat: ['baru'] lakukan: {
	milik list := Daftar baru.
}.

To-Do saat: ['nieuw'] lakukan: {
	milik list := Daftar baru.
}.

To-Do saat: ['+'] lakukan: { :task
	milik list tambah-di-akhir: task.
}.

To-Do saat: ['number of tasks?'] lakukan: { <-  milik list jumlah.
}.

>> todos := 
	To-Do baru 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Keluaran tulis: ['You have $ tasks to do'] $ todos number of tasks?.
