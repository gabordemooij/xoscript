Keluaran tulis: ['Lanjutkan loop for, Tidak - sebelum 6 ke atas.'], baris-baru.
{ :i
	Keluaran tulis: (i + 1), baris-baru.
	((i + 1) > 4) lanjutkan.
	Keluaran tulis: ['-'].
} × 10.

>> x := 0.
>> xKurangDari10 := { <- ( x < 10 ). }.
Keluaran baris-baru.
Keluaran tulis: ['Lanjutkan while-true, Tidak --> sebelum 5 ke atas.'], baris-baru.
{
	Keluaran tulis: ['iteration #'] + x, baris-baru.
	x tambah: 1.
	((x < 5) bukan) lanjutkan.
	Keluaran tulis: ['-->'].
} selama: xKurangDari10.
Keluaran baris-baru.
Keluaran tulis: ['Lanjutkan while-false, Tidak - hanya sebelum 3.'], baris-baru.
{
	Keluaran tulis: ['iteration #'] + x, baris-baru.
	x kurangi: 1.
	(x = 3) lanjutkan.
	Keluaran tulis: ['-'].
} selama: { <- ( x > 0). }.

Keluaran baris-baru.
Keluaran tulis: ['Lanjutkan loop times, Tidak ||| sebelum 3.'], baris-baru.
{ :i
	Keluaran tulis: ['iteration #'] + i, baris-baru.
	(i = 2) lanjutkan.
	Keluaran tulis: ['|||'].
} × 5.

Keluaran baris-baru.

{ Benar lanjutkan. Keluaran tulis: ['jangan tulis ini!'], baris-baru. } mulai.

{ Benar lanjutkan. Keluaran tulis: ['jangan tulis ini!'], baris-baru. } tangkap: { Keluaran tulis: ['Jangan tangkap ini!']. }, mulai.

Keluaran tulis: ['Uji loop each Larik: 0, ... ,2'], baris-baru.
(Daftar ← 1 ; 2 ; 3) petakan: { :i
	(i = 1) lanjutkan.
	Keluaran tulis: ['iteration #'] + (i - 0), baris-baru.
}.

Keluaran tulis: ['Uji loop each Kamus: hanya c'], baris-baru.
>> m := Kamus baru.
m taruh: ['first'] di: ['a'], taruh: ['second'] di: ['b'], taruh: ['ketiga'] di: ['c'].
m setiap: { :k :v
	(k ≠ ['c']) lanjutkan.
	Keluaran tulis: ['iteration'] + k + v, baris-baru.
}.

