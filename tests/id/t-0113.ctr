Keluaran tulis: ['Continue for-loop, No - before 6 and up.'], baris-baru.
{ :i
	Keluaran tulis: (i + 1), baris-baru.
	((i + 1) > 4) lanjutkan.
	Keluaran tulis: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Keluaran baris-baru.
Keluaran tulis: ['Continue while-true, No --> before 5 and up.'], baris-baru.
{
	Keluaran tulis: ['iteration #'] + x, baris-baru.
	x tambah: 1.
	((x < 5) bukan) lanjutkan.
	Keluaran tulis: ['-->'].
} selama: xIsLessThan10.
Keluaran baris-baru.
Keluaran tulis: ['Continue while-false, No - before 3 only.'], baris-baru.
{
	Keluaran tulis: ['iteration #'] + x, baris-baru.
	x kurangi: 1.
	(x = 3) lanjutkan.
	Keluaran tulis: ['-'].
} selama: { <- ( x > 0). }.

Keluaran baris-baru.
Keluaran tulis: ['Continue times-loop, No ||| before 3.'], baris-baru.
{ :i
	Keluaran tulis: ['iteration #'] + i, baris-baru.
	(i = 2) lanjutkan.
	Keluaran tulis: ['|||'].
} × 5.

Keluaran baris-baru.

{ Benar lanjutkan. Keluaran tulis: ['dont write this!'], baris-baru. } mulai.

{ Benar lanjutkan. Keluaran tulis: ['dont write this!'], baris-baru. } tangkap: { Keluaran tulis: ['Dont catch this!']. }, mulai.

Keluaran tulis: ['Test Array each-loop: 0, ... ,2'], baris-baru.
(Daftar ← 1 ; 2 ; 3) petakan: { :i
	(i = 1) lanjutkan.
	Keluaran tulis: ['iteration #'] + (i - 0), baris-baru.
}.

Keluaran tulis: ['Test Map each-loop: c only'], baris-baru.
>> m := Kamus baru.
m taruh: ['first'] di: ['a'], taruh: ['second'] di: ['b'], taruh: ['third'] di: ['c'].
m setiap: { :k :v
	(k ≠ ['c']) lanjutkan.
	Keluaran tulis: ['iteration'] + k + v, baris-baru.
}.

