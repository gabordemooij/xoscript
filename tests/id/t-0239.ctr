Daftar saat: ['jumlahkan'] lakukan: {
	>> total := 0.
	diri setiap: { :indeks :elemen
		total tambah: elemen.
	}. <- total.
}.

>> a := Benar.



a saat: ['teks'] lakukan: {
	>> jawaban := Kosong.
	( diri = Benar ) benar: {
		jawaban := ['Yup'].
	}, selain-itu: {
		jawaban := ['Bukan'].
	}. <- jawaban.
}.

a saat: ['angka'] lakukan: {
	>> jawaban := Kosong.
	( diri = Benar ) benar: {
		jawaban := 10.
	}, selain-itu: {
		jawaban := 20.
	}. <- jawaban.
}.

>> b := 666.

b saat: ['teks'] lakukan: { <- ['Iblis'].
}.

b saat: ['boolean'] lakukan: { <- Salah.
}.


Keluaran tulis: a, baris-baru.  
Keluaran tulis: (90 + a), baris-baru. 
Keluaran tulis: b, baris-baru. 
Keluaran tulis: (Benar dan: b), baris-baru.

a := Daftar ← ['hello'] ; ['world'] ; Benar ; Kosong ; 666. 
a := a + ( Daftar ← 1 ).
Keluaran tulis: a, baris-baru.
Keluaran tulis: ((Kamus baru) taruh: Kosong di: Kosong), baris-baru.
Keluaran tulis: a jumlahkan, baris-baru. 


{
	a saat: ['teks'] lakukan: { <- Kosong. }.
	a := [''] + a.
} tangkap: { :galat
	Keluaran tulis: ['Galat dicatat: '] + galat, baris-baru.
}, mulai.



{
	a saat: ['angka'] lakukan: { <- Kosong. }.
	a := 3 × a.
} tangkap: { :galat
	Keluaran tulis: ['Galat dicatat: '] + galat, baris-baru.
}, mulai.


{
	a saat: ['boolean'] lakukan: { <- Kosong. }.
	a := Benar dan: a. 
} tangkap: { :galat
	Keluaran tulis: ['Galat dicatat: '] + galat, baris-baru.
}, mulai.





