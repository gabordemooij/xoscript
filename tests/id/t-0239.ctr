	a saat: ['angka'] lakukan: { <- Kosong. }.
	a := 3 × a.
} tangkap: { :error
	Keluaran tulis: ['Error noted: '] + error, baris-baru.
}, mulai.


{
	a saat: ['boolean'] lakukan: { <- Kosong. }.
	a := Benar dan: a. 
} tangkap: { :error
	Keluaran tulis: ['Error noted: '] + error, baris-baru.
}, mulai.





