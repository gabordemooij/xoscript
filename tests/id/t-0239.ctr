Daftar saat: ['sum'] lakukan: {
	>> total := 0.
	diri setiap: { :index :element
		total tambah: element.
	}. <- total.
}.

>> a := Benar.



a saat: ['teks'] lakukan: {
	>> answer := Kosong.
	( diri = Benar ) benar: {
		answer := ['Yep'].
	}, selain-itu: {
		answer := ['Nope'].
	}. <- answer.
}.

a saat: ['angka'] lakukan: {
	>> answer := Kosong.
	( diri = Benar ) benar: {
		answer := 10.
	}, selain-itu: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b saat: ['teks'] lakukan: { <- ['Devil'].
}.

b saat: ['boolean'] lakukan: { <- Salah.
}.


Keluaran tulis: a, baris-baru.  
Keluaran tulis: (90 + a), baris-baru. 
Keluaran tulis: b, baris-baru. 
Keluaran tulis: (Benar dan: b), baris-baru.

a := Daftar ← ['hello'] ; ['world'] ; Benar ; Kosong ; 666. 
a := a + ( Daftar ← 1 ).
Keluaran tulis: a, baris-baru.
Keluaran tulis: ((Kamus baru) taruh: Kosong di: Kosong), baris-baru.
Keluaran tulis: a sum, baris-baru. 


{
	a saat: ['teks'] lakukan: { <- Kosong. }.
	a := [''] + a.
} tangkap: { :error
	Keluaran tulis: ['Error noted: '] + error, baris-baru.
}, mulai.



