Keluaran tulis: ['1,2,3,4,5,6,7,8,9,A,'], baris-baru.
>> Scope := Objek baru.
Scope saat: ['initialize:'] lakukan: { :x milik property := x. }.
Scope saat: ['confirm'] lakukan: { Keluaran tulis: [',']. }.
Scope saat: ['uji'] lakukan: {
	Keluaran tulis: milik property.
	diri confirm.
	( 1 = 1 ) benar: { Keluaran tulis: milik property. diri confirm. }.
	( 1 = 0 ) salah: { Keluaran tulis: milik property. diri confirm. }.
	>> y := 2. { Keluaran tulis: milik property. diri confirm. } selama: { y kurangi: 1. <- (y > 0). }.
	{ Keluaran tulis: milik property. diri confirm. } × 1.
	(Daftar ← 1) setiap: {  Keluaran tulis: milik property. diri confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Kamus baru one: ['item']) setiap: { Keluaran tulis: milik property. diri confirm. }.
	{ 1 ÷ 0. } tangkap: { Keluaran tulis: milik property. diri confirm. }, mulai.
	Keluaran baris-baru.
}.
>> scope1 := Scope baru.
scope1 initialize: ['X'].
scope1 uji.
>> function := { 
	milik property := ['Y'].
	Keluaran tulis: milik property.
	diri confirm.
	( 1 = 1 ) benar: { Keluaran tulis: milik property. diri confirm. }.
	( 1 = 0 ) salah: { Keluaran tulis: milik property. diri confirm. }.
	>> y := 2. { Keluaran tulis: milik property. diri confirm. } selama: { y kurangi: 1. <- (y > 0). }.
	{ Keluaran tulis: milik property. diri confirm. } × 1.
	(Daftar ← 1) setiap: {  Keluaran tulis: milik property. diri confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Kamus baru one: ['item']) setiap: { Keluaran tulis: milik property. diri confirm. }.
	{ 1 ÷ 0. } tangkap: { Keluaran tulis: milik property. diri confirm. }, mulai.
	Keluaran baris-baru.
}.
function saat: ['confirm'] lakukan: { Keluaran tulis: [',']. }.
function terapkan: 1 dan: 2.
