Keluaran tulis: ['1,2,3,4,5,6,7,8,9,A,'], baris-baru.
>> Lingkup := Objek baru.
Lingkup saat: ['initialize:'] lakukan: { :x milik properti := x. }.
Lingkup saat: ['konfirmasi'] lakukan: { Keluaran tulis: [',']. }.
Lingkup saat: ['uji'] lakukan: {
	Keluaran tulis: milik properti.
	diri konfirmasi.
	( 1 = 1 ) benar: { Keluaran tulis: milik properti. diri konfirmasi. }.
	( 1 = 0 ) salah: { Keluaran tulis: milik properti. diri konfirmasi. }.
	>> y := 2. { Keluaran tulis: milik properti. diri konfirmasi. } selama: { y kurangi: 1. <- (y > 0). }.
	{ Keluaran tulis: milik properti. diri konfirmasi. } × 1.
	(Daftar ← 1) setiap: {  Keluaran tulis: milik properti. diri konfirmasi. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo implementasikan pengurutan sendiri, uji ini gagal karena jumlah iterasi berbeda per platform
	(Kamus baru one: ['item']) setiap: { Keluaran tulis: milik properti. diri konfirmasi. }.
	{ 1 ÷ 0. } tangkap: { Keluaran tulis: milik properti. diri konfirmasi. }, mulai.
	Keluaran baris-baru.
}.
>> lingkup1 := Lingkup baru.
lingkup1 initialize: ['X'].
lingkup1 uji.
>> fungsiSaya := { 
	milik properti := ['Y'].
	Keluaran tulis: milik properti.
	diri konfirmasi.
	( 1 = 1 ) benar: { Keluaran tulis: milik properti. diri konfirmasi. }.
	( 1 = 0 ) salah: { Keluaran tulis: milik properti. diri konfirmasi. }.
	>> y := 2. { Keluaran tulis: milik properti. diri konfirmasi. } selama: { y kurangi: 1. <- (y > 0). }.
	{ Keluaran tulis: milik properti. diri konfirmasi. } × 1.
	(Daftar ← 1) setiap: {  Keluaran tulis: milik properti. diri konfirmasi. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Kamus baru one: ['item']) setiap: { Keluaran tulis: milik properti. diri konfirmasi. }.
	{ 1 ÷ 0. } tangkap: { Keluaran tulis: milik properti. diri konfirmasi. }, mulai.
	Keluaran baris-baru.
}.
fungsiSaya saat: ['konfirmasi'] lakukan: { Keluaran tulis: [',']. }.
fungsiSaya terapkan: 1 dan: 2.
