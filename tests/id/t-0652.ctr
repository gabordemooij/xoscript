# test number -> string -> number
{

	>> x := Angka antara: 0 dan: 1000000.
	>> d := Angka antara: 1 dan: 7.
	>> e := 10 pangkat: d.

	x bagi-dengan: e.
	>> y := x teks angka.

	(x = y) salah: {
		Keluaran tulis: x, baris-baru.
		Keluaran tulis: y, baris-baru.
		Program akhiri.
	}.

} * 1000.
Keluaran tulis: ['OK'], baris-baru.