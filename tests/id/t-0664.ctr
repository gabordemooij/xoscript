# recursive interpolation not allowed

Keluaran tulis: 
['recursive string interolation enabled: '] + (
	Program fitur: 
	['RECURSIVE_STRINTPOL']
), baris-baru.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Keluaran tulis: a, baris-baru.


Program fitur: ['RECURSIVE_STRINTPOL'] aktifkan: Benar.

Keluaran tulis: 
['recursive string interpolation enabled: '] + (
	Program fitur: 
	['RECURSIVE_STRINTPOL']
), baris-baru.

>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Keluaran tulis: a, baris-baru.

Program fitur: ['RECURSIVE_STRINTPOL'] aktifkan: Salah.

