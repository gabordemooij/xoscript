(Kosong = Kosong) benar: { Keluaran tulis: ['Nil is Nil!'].}.
(2 > 1) benar: { Keluaran tulis: ['YES']. }.
(2 > 3) benar: { Keluaran tulis: ['NO']. }.
(2 > 3) salah: { Keluaran tulis: ['Nonono..'].}.
Benar benar: { Keluaran tulis: ['TRUE is TRUE!']. }.
(Benar) benar: { Keluaran tulis: ['TRUE is TRUE!']. }.
Salah salah: { Keluaran tulis: ['FALSE is FALSE!']. }.
(Salah) salah: { Keluaran tulis: ['FALSE is FALSE!']. }.
