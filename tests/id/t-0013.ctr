
>> Animal := Objek baru.
Animal saat: ['baru'] lakukan: { <- diri baru init.
}.

Animal saat: ['init'] lakukan: {
	milik sound := ['?'].
	milik legs := 4.
}.

>> Dog := Animal baru.
Dog saat: ['init'] lakukan: {
	diri init.
	milik sound := ['barks'].
}.

Animal saat: ['teks'] lakukan: { <- milik legs teks + milik sound.
}.

>> poodle := Dog baru.
Keluaran tulis: poodle, baris-baru.

