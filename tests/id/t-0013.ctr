
>> Hewan := Objek baru.
Hewan saat: ['baru'] lakukan: {
	<- diri baru init.
}.

Hewan saat: ['init'] lakukan: {
	milik suara := ['?'].
	milik kaki  := 4.
}.

>> Anjing := Hewan baru.
Anjing saat: ['init'] lakukan: {
	diri init.
	milik suara := ['menggonggong'].
}.

Hewan saat: ['teks'] lakukan: {
	<- milik kaki teks + milik suara.
}.

>> pudel := Anjing baru.
Keluaran tulis: pudel, baris-baru.

