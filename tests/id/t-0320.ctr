


>> CoffeeMachine := Objek baru.
CoffeeMachine saat: ['order:'] lakukan: { :id
	>> coffee := ['Americano'].
	( id = 1 ) benar: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) benar: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) benar: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Objek baru.
SimpleCoffeeMachine saat: ['order'] lakukan: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Keluaran tulis: redCup, baris-baru.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Keluaran tulis: greenCup, baris-baru.
>> yellowCup := CoffeeMachine order: 1.
Keluaran tulis: yellowCup, baris-baru.
>> blueCup := CoffeeMachine order: 0.
Keluaran tulis: blueCup, baris-baru.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Keluaran tulis: blackCup, baris-baru.
blackCup tambah-di-akhir: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Keluaran tulis: orangeCup, baris-baru.
