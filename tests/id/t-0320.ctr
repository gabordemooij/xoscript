


>> MesinKopi := Objek baru.
MesinKopi saat: ['order:'] lakukan: { :id
	>> coffee := ['Americano'].
	( id = 1 ) benar: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) benar: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) benar: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> MesinKopiSederhana := Objek baru.
MesinKopiSederhana saat: ['pesanan'] lakukan: { <- ['Hitam']. }.
>> cangkirMerah := MesinKopi order: 1.
Keluaran tulis: cangkirMerah, baris-baru.
cangkirMerah := ['Teh']. 
>> cangkirHijau := MesinKopi order: 0.
Keluaran tulis: cangkirHijau, baris-baru.
>> cangkirKuning := MesinKopi order: 1.
Keluaran tulis: cangkirKuning, baris-baru.
>> cangkirBiru := MesinKopi order: 0.
Keluaran tulis: cangkirBiru, baris-baru.
>> cangkirPlastik := MesinKopiSederhana pesanan.
cangkirPlastik := ['Limun']. 
>> cangkirHitam := MesinKopiSederhana pesanan.
Keluaran tulis: cangkirHitam, baris-baru.
cangkirHitam tambah-di-akhir: [' tidaaak.... bir. '].
>> cangkirOranye := MesinKopiSederhana pesanan.
Keluaran tulis: cangkirOranye, baris-baru.
