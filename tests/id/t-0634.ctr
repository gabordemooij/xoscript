# Program shell-escape menghasilkan sintaksis shell posix kanonik
# kompatibel dengan: bash/dash, zsh, ksh

>> c := Program shell-escape: ['abc'].
Keluaran tulis: c, baris-baru.
Keluaran tulis: ( Program sistem: ['echo '] + c ), baris-baru.

c := Program shell-escape: ['a'b'c'].
Keluaran tulis: c, baris-baru.
Keluaran tulis: ( Program sistem: ['echo '] + c ), baris-baru.

c := Program shell-escape: ['a\'c'].
Keluaran tulis: c, baris-baru.
Keluaran tulis: ( Program sistem: ['echo '] + c ), baris-baru.