# uji satuan

Program bersihkan.

>> Buah := Objek baru.
Buah saat: ['baru'] lakukan: {
	>> f := diri baru.
	f apples: 0. <- f.
}.
Buah saat: ['apples:'] lakukan: { :a milik apel := a. }.
Buah saat: ['apel'] lakukan: { <- milik apel. }.
Buah saat: ['+'] lakukan: { :f
	>> n := Buah baru.
	n apples: (f apel + milik apel). <- n.
}.
Angka saat: ['apel'] lakukan: { <- ((Buah baru) apples: diri).
}.

Buah saat: ['teks'] lakukan: { <- milik apel + [' apel '].
}.

>> q := 3 apel + 4 apel.
Keluaran tulis: q, baris-baru.




q := 3 apel + 4 apel.
Keluaran tulis: q, baris-baru.



q := 3 apel + 4 apel.
Keluaran tulis: q, baris-baru.


