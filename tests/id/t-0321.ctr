# test qualifiers

Program bersihkan.

>> Fruit := Objek baru.
Fruit saat: ['baru'] lakukan: {
	>> f := diri baru.
	f apples: 0. <- f.
}.
Fruit saat: ['apples:'] lakukan: { :a milik apples := a. }.
Fruit saat: ['apples'] lakukan: { <- milik apples. }.
Fruit saat: ['+'] lakukan: { :f
	>> n := Fruit baru.
	n apples: (f apples + milik apples). <- n.
}.
Angka saat: ['apples'] lakukan: { <- ((Fruit baru) apples: diri).
}.

Fruit saat: ['teks'] lakukan: { <- milik apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Keluaran tulis: q, baris-baru.




q := 3 apples + 4 apples.
Keluaran tulis: q, baris-baru.



