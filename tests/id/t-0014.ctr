>> Penyapa := Objek baru.
Penyapa saat: ['buat'] lakukan: {
	>> pny := Objek baru.
	pny saat: ['setName:'] lakukan: { :sebuahNama
		milik nama := sebuahNama.
	}.
	pny saat: ['sapa'] lakukan: {
		Keluaran tulis: milik nama.
	}. <- pny.
}.
>> a := Penyapa buat.
>> b := Penyapa buat.
a setName: ['SATU'].
b setName: ['DUA'].
a sapa.
b sapa.
>> c := a baru.
c setName: ['TIGA'].
c sapa.
>> d := a baru.
d setName: ['EMPAT'].
d sapa.
c sapa.
