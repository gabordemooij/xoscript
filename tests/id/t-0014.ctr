>> Greeter := Objek baru.
Greeter saat: ['make'] lakukan: {
	>> gr := Objek baru.
	gr saat: ['setName:'] lakukan: { :aname
		milik nama := aname.
	}.
	gr saat: ['greet'] lakukan: {
		Keluaran tulis: milik nama.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a baru.
c setName: ['THREE'].
c greet.
>> d := a baru.
d setName: ['FOUR'].
d greet.
c greet.
