# uji tangkap-semua (praktis)
>> TeksHTML := Teks baru.
TeksHTML saat: ['encode:'] lakukan: { :tekst
	diri tambah-di-akhir: (tekst
	ganti: ['&'] dengan: ['&amp;'], 
	ganti: ['<'] dengan: ['&lt;'],
	ganti: ['>'] dengan: ['&gt;'],
	ganti: ['"'] dengan: ['&quot;']).
}.
>> blog := TeksHTML baru.
blog tambah-di-akhir: ['<h1>'],
     encode: ['Koffie & Thee'],
     tambah-di-akhir: ['</h1>'].
Keluaran tulis: blog, baris-baru.


>> Romawi := Angka baru.
Romawi saat: ['keteksan'] lakukan: {
	>> a := [''].
	{ a tambah-di-akhir: ['I']. } × diri. <- a.
}.

>> x := Romawi baru.
x tambah: 3.
Keluaran tulis: x keteksan, baris-baru.

>> Kuantum := Boolean baru.
Kuantum saat: ['true?'] lakukan: { <- ['mungkin Benar']. }.
Keluaran tulis: (Kuantum baru true?), baris-baru.

>> Nihil := Kosong baru.
Nihil saat: ['teks'] lakukan: { <- ['Nihil']. }.
Keluaran tulis: (Nihil baru), baris-baru.
