# catch-all test (practical)
>> HTML := Teks baru.
HTML saat: ['encode:'] lakukan: { :tekst
	diri tambah-di-akhir: (tekst
	ganti: ['&'] dengan: ['&amp;'], 
	ganti: ['<'] dengan: ['&lt;'],
	ganti: ['>'] dengan: ['&gt;'],
	ganti: ['"'] dengan: ['&quot;']).
}.
>> blog := HTML baru.
blog tambah-di-akhir: ['<h1>'],
     encode: ['Koffie & Thee'],
     tambah-di-akhir: ['</h1>'].
Keluaran tulis: blog, baris-baru.


>> Roman := Angka baru.
Roman saat: ['stringy'] lakukan: {
	>> a := [''].
	{ a tambah-di-akhir: ['I']. } × diri. <- a.
}.

>> x := Roman baru.
x tambah: 3.
Keluaran tulis: x stringy, baris-baru.

>> Quantum := Boolean baru.
Quantum saat: ['true?'] lakukan: { <- ['maybe True']. }.
Keluaran tulis: (Quantum baru true?), baris-baru.

>> Nihil := Kosong baru.
Nihil saat: ['teks'] lakukan: { <- ['Nihil']. }.
Keluaran tulis: (Nihil baru), baris-baru.
