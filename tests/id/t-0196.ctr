
>> animal := Objek baru. 
 
 animal saat: ['name:'] lakukan: { :n
milik nama := n.
}. 


animal name: ['Diva']. 
 
animal saat: ['nama'] lakukan: { <- nama.
}.

>> cat := animal baru.
 
 cat name: ['Diva']. 
 
 cat saat: ['nama'] lakukan: { <- ['your royal highness ']
+ (diri nama).
}.

Keluaran tulis: cat nama.
