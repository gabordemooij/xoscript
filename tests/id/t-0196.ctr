
>> hewan := Objek baru. 
 
 hewan saat: ['name:'] lakukan: { :n
milik nama := n.
}. 


hewan name: ['Diva']. 
 
hewan saat: ['nama'] lakukan: { <- nama.
}.

>> kucing := hewan baru.
 
 kucing name: ['Diva']. 
 
 kucing saat: ['nama'] lakukan: { <- ['Yang Mulia ']
+ (diri nama).
}.

Keluaran tulis: kucing nama.
