['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Keluaran tulis: (x + y), baris-baru.

>> x := 10040.07.
>> y := 10305.60.

Keluaran tulis: (x + y), baris-baru.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Keluaran tulis: (x + y + z), baris-baru.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Keluaran tulis: (x + y + z), baris-baru.

>> q := 0.1.2.

Keluaran tulis: (q), baris-baru.

>> q := 012.

Keluaran tulis: (q), baris-baru.
