

Daftar saat: ['fixture:'] lakukan: { :f
	milik fixture := f.
}.

Daftar saat: ['jumlah'] lakukan: { <- milik fixture.
}.

Daftar saat: ['aantal'] lakukan: { <- milik fixture.
}.


>> x := Kosong.
{

	x := ['hello'] 
	ganti:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] karakter: 2)
			)
		)
	dengan: (
		(['...hal'] + ['lo']) 
			huruf-besar 
			lowecase 
			huruf-besar 
			lewati: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Daftar ← 0 ; 1 ; 4; 9 ; (Daftar ← 0 ; 3; 1) ; 4
							) kedua-terakhir
						) ? 1
					) + 
					((Daftar ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					jumlah
				)
			)
	).

} × 10.
Keluaran tulis: x, baris-baru.

