# uji satuan

>> $ := Objek baru.

$ saat: ['tanggapi:'] lakukan: { :x
	
	>> operasi := x karakter: 0.
	>> valuta := x karakter: 1.
	>> uang := x lewati: 2.
	
	>> jumlah-uang := 0.

	( operasi = ['+'] ) benar: {
		( valuta = ['£'] ) benar: { jumlah-uang := 1.28 × uang. }.
	}. <- jumlah-uang.
}.



>> x := $ +£20.

Keluaran tulis: x, baris-baru.


>> Buah := Objek baru.

Buah saat: ['baru'] lakukan: {
	>> f := diri baru.
	f apples: 0.
	f oranges: 0. <- f.
}.

Buah saat: ['apples:'] lakukan: { :a milik apel := a. }.
Buah saat: ['oranges:'] lakukan: { :p milik jeruk := p. }.
Buah saat: ['apel'] lakukan: { <- milik apel. }.
Buah saat: ['jeruk'] lakukan: { <- milik jeruk. }.

Buah saat: ['+'] lakukan: { :f
	
	>> n := Buah baru.
	f tambah: 1.
	
	n apples: (f apel + milik apel).
	n oranges:  (f jeruk  + milik jeruk). <- n.
}.

Buah saat: ['teks'] lakukan: { <- ( milik apel teks + [' apel dan '] + milik jeruk + [' jeruk'] ).
}.

Angka saat: ['apel'] lakukan: { <- ((Buah baru) apples: diri).
}.

Angka saat: ['apple'] lakukan: { <- ((Buah baru) apples: diri).
}.

Angka saat: ['jeruk'] lakukan: { <- ((Buah baru) oranges: diri).
}.




Keluaran tulis: (1 apple + 3 jeruk + 4 apel), baris-baru.


Teks saat: ['dua-kali'] lakukan: { <- ((diri teks) + (diri teks)).
}.



Keluaran tulis: ['❤❤❤'] dua-kali.



