# test qualifiers

>> $ := Objek baru.

$ saat: ['tanggapi:'] lakukan: { :x
	
	>> operation := x karakter: 0.
	>> valuta := x karakter: 1.
	>> money := x lewati: 2.
	
	>> amount := 0.

	( operation = ['+'] ) benar: {
		( valuta = ['£'] ) benar: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Keluaran tulis: x, baris-baru.


>> Fruit := Objek baru.

Fruit saat: ['baru'] lakukan: {
	>> f := diri baru.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit saat: ['apples:'] lakukan: { :a milik apples := a. }.
Fruit saat: ['oranges:'] lakukan: { :p milik oranges := p. }.
Fruit saat: ['apples'] lakukan: { <- milik apples. }.
Fruit saat: ['oranges'] lakukan: { <- milik oranges. }.

Fruit saat: ['+'] lakukan: { :f
	
	>> n := Fruit baru.
	f tambah: 1.
	
	n apples: (f apples + milik apples).
	n oranges:  (f oranges  + milik oranges). <- n.
}.

Fruit saat: ['teks'] lakukan: { <- ( milik apples teks + [' apples and '] + milik oranges + [' oranges'] ).
}.

Angka saat: ['apples'] lakukan: { <- ((Fruit baru) apples: diri).
}.

Angka saat: ['apple'] lakukan: { <- ((Fruit baru) apples: diri).
}.

Angka saat: ['oranges'] lakukan: { <- ((Fruit baru) oranges: diri).
}.




Keluaran tulis: (1 apple + 3 oranges + 4 apples), baris-baru.


Teks saat: ['twice'] lakukan: { <- ((diri teks) + (diri teks)).
}.



Keluaran tulis: ['❤❤❤'] twice.



