

>> Kucing := Objek baru.

Kucing saat: ['baru'] lakukan: {
	milik suara := ['meow!'].
}.

Kucing saat: ['nieuw'] lakukan: {
	milik suara := ['meow!'].
}.

Kucing saat: ['bersuara'] lakukan: { <- milik suara.
}.

Kucing saat: ['sapa'] lakukan: { <- diri bersuara.
}.

>> kucing := Kucing baru.
Keluaran tulis: kucing sapa.
