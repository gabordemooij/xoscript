# kunci dan tanda tangan Brankas yang terlalu panjang setelah didekode tidak boleh meluapkan stack
Server init.

>> pasangan-kunci := Brankas buat-kunci.
>> kpr := pasangan-kunci pertama.
>> kpu := pasangan-kunci terakhir.
>> ttd := Brankas tanda-tangani: ['abc'] dengan: kpr.

# 88 karakter tanpa padding didekode menjadi 66 byte
>> panjang-sekali := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 karakter tanpa padding didekode menjadi 33 byte
>> pendek := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Brankas tanda-tangani: ['abc'] dengan: panjang-sekali. } tangkap: { :e
	Keluaran tulis: e, baris-baru.
}, mulai.

{ Brankas periksa: ['abc'] tanda-tangan: panjang-sekali dengan: kpu. } tangkap: { :e
	Keluaran tulis: e, baris-baru.
}, mulai.

{ Brankas periksa: ['abc'] tanda-tangan: ttd dengan: pendek. } tangkap: { :e
	Keluaran tulis: e, baris-baru.
}, mulai.
