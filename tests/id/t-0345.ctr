# uji metode tangkap-semua
>> x13 := Objek baru.
x13 saat: ['a'] lakukan: { :a Keluaran tulis: 0, baris-baru. }.
x13 saat: ['a:'] lakukan: { :a Keluaran tulis: a, baris-baru. <- 5. }.
x13 saat: ['a:b:'] lakukan: { :a :b Keluaran tulis: (a + b), baris-baru. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
