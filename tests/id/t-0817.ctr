# nilai yang berakhir pada bagian pertama tanda kutip pembuka harus bertahan saat serialisasi
>> nilai-nilai := Daftar baru
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

nilai-nilai setiap: { :i :value
	>> d := Kamus baru.
	d taruh: value di: ['k'].
	d taruh: ['second'] di: ['j'].
	>> r := d kode objek.
	Keluaran tulis: r jumlah, baris-baru.
	Keluaran tulis: ( (r di: ['k']) = value ), baris-baru.
}.
