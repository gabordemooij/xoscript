Server init.
Keluaran tulis: ['Database time test'], baris-baru.

>> db := Maria-DB baru hos: ['localhost'],
	nama-pengguna: ['xo'], 
	kata-sandi: ['pass123'],
	nama-basis-data: ['xobase'],
	sambungkan.

>> parameter-pencarian :=
db kueri: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
ambil: { :row
	Keluaran tulis: row timetest, baris-baru.
}.
