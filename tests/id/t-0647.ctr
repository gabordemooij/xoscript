Server init.
Keluaran tulis: ['Tes waktu basis data'], baris-baru.

>> bd := Maria-DB baru hos: ['localhost'],
	nama-pengguna: ['xo'], 
	kata-sandi: ['pass123'],
	nama-basis-data: ['xobase'],
	sambungkan.

>> parameter-pencarian :=
bd kueri: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
ambil: { :barisan
	Keluaran tulis: barisan timetest, baris-baru.
}.
