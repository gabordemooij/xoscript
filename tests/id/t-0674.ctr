# alur normal
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> jalur := ['/tmp/dat.csv'].
>> csv := Berkas baru: jalur.
csv tulis: s.

# menerima CRLF LF CR, panjang baris bervariasi
csv pemisah: [';'] tanda-kutip: ['"'] baris: { :line
	Program bersihkan.
	Keluaran tulis: line, baris-baru.
	Program bersihkan.
}.

# baris tidak sama
s tambah-di-akhir: ['\njustone'].
csv tulis: s.
{
	csv pemisah: [';'] tanda-kutip: ['"'] baris: { :line
		Keluaran tulis: line, baris-baru.
	}.
} tangkap: { :e 
	Keluaran tulis: e, baris-baru.
}, mulai.

# format tidak valid
s := ['"he"llo";world'].
csv tulis: s.
{
	csv pemisah: [';'] tanda-kutip: ['"'] baris: { :line
		Keluaran tulis: line, baris-baru.
	}.
} tangkap: { :e 
	Keluaran tulis: e, baris-baru.
}, mulai.
