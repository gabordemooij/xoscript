# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> jalur := ['/tmp/dat.csv'].
>> csv := Berkas baru: jalur.
csv tulis: s.

# accepts CRLF LF CR, varying row length
csv pemisah: [';'] tanda-kutip: ['"'] baris: { :line
	Program bersihkan.
	Keluaran tulis: line, baris-baru.
	Program bersihkan.
}.

# unequal lines
s tambah-di-akhir: ['\njustone'].
csv tulis: s.
{
	csv pemisah: [';'] tanda-kutip: ['"'] baris: { :line
		Keluaran tulis: line, baris-baru.
	}.
} tangkap: { :e 
	Keluaran tulis: e, baris-baru.
}, mulai.

# invalid format
s := ['"he"llo";world'].
csv tulis: s.
{
	csv pemisah: [';'] tanda-kutip: ['"'] baris: { :line
		Keluaran tulis: line, baris-baru.
	}.
} tangkap: { :e 
	Keluaran tulis: e, baris-baru.
}, mulai.
