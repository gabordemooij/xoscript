Server init.

Keluaran tulis: (
	Pola baru: ['^\\w+$'],
	cocok: ['test@example.com'] 
), baris-baru. # 0 kecocokan, gagal pada @ dan .

Keluaran tulis: (
	Pola baru: ['^[^@]+@[^\.]+\.\\w+$'],
	cocok: ['test@example.com'] 
), baris-baru. # 1 kecocokan

Keluaran tulis: (
	Pola baru: ['[^@]+@[^\.]+\.\\w+'],
	cocok: ['test@example.com'] 
), baris-baru. # 1 kecocokan

Keluaran tulis: (
	Pola baru: ['([^@]+)@([^\.]+)\.\\w+'],
	cocok: ['test@example.com'] 
), baris-baru. # 1 kecocokan, grup tidak berpengaruh

Keluaran tulis: (
	Pola baru: ['[a-z]'],
	cocok: ['test@example.com'] 
), baris-baru. # 14 kecocokan

Keluaran tulis: (
	Pola baru: ['.*'],
	cocok: ['test@example.com'] 
), baris-baru. # 1 kecocokan (semua)

Keluaran tulis: (
	Pola baru: ['(.*)'],
	cocok: ['test@example.com'] 
), baris-baru. # 1 kecocokan (semua)

Keluaran tulis: (
	Pola baru: ['\\s*[^@]+@[^\.]+\.\\w+'],
	cocok: ['test@example.com'] 
), baris-baru. # 1 kecocokan, spasi awalan opsional, diabaikan