Server init.

Keluaran tulis: (
	Pola baru: ['^\\w+$'],
	cocok: ['test@example.com'] 
), baris-baru. # 0 match, fails on @ and .

Keluaran tulis: (
	Pola baru: ['^[^@]+@[^\.]+\.\\w+$'],
	cocok: ['test@example.com'] 
), baris-baru. # 1 match

Keluaran tulis: (
	Pola baru: ['[^@]+@[^\.]+\.\\w+'],
	cocok: ['test@example.com'] 
), baris-baru. # 1 match

Keluaran tulis: (
	Pola baru: ['([^@]+)@([^\.]+)\.\\w+'],
	cocok: ['test@example.com'] 
), baris-baru. # 1 match, groups dont matter

Keluaran tulis: (
	Pola baru: ['[a-z]'],
	cocok: ['test@example.com'] 
), baris-baru. # 14 matches

Keluaran tulis: (
	Pola baru: ['.*'],
	cocok: ['test@example.com'] 
), baris-baru. # 1 match (all)

Keluaran tulis: (
	Pola baru: ['(.*)'],
	cocok: ['test@example.com'] 
), baris-baru. # 1 match (all)

Keluaran tulis: (
	Pola baru: ['\\s*[^@]+@[^\.]+\.\\w+'],
	cocok: ['test@example.com'] 
), baris-baru. # 1 match, prefix space optional, gets ignored