txt := txt + ['tanpa membocorkan '] + x + ['-an byte ?'].
txt tambah-di-akhir: ['!!'].
Keluaran tulis: txt.
} mulai.

Program bersihkan.

memoriTerpakai1 := (Program memori ? 0).


