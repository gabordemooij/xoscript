#Linux
>> Seruput := Objek baru.

Seruput saat: ['baru'] lakukan: {
	milik str := [''].
}.

Seruput saat: ['nieuw'] lakukan: {
	milik str := [''].
}.

Seruput saat: ['tanggapi:'] lakukan: { :blah
		milik str tambah-di-akhir: blah.
}.

Seruput saat: ['tanggapi:dan:'] lakukan: { :blah :blahah
		milik str tambah-di-akhir: (blah dari: 0 panjang: (blah panjang - 1)).
		milik str tambah-di-akhir: [' '].
		milik str tambah-di-akhir: blahah.
}.

Seruput saat: ['peroleh'] lakukan: {
	>> penyangga := milik str.
	milik str := ['']. <- penyangga.
}.


Keluaran tulis: (Program sistem: (Seruput baru echo: ['Halo, saya bisa menulis ke konsol dengan API fluid!'], peroleh)).


{ Berkas baru: ['/tmp/from.txt'], hapus. } tangkap: { ['Kosong']. }, mulai.
{ Berkas baru: ['/tmp/to.txt'], hapus. } tangkap: { ['Kosong']. }, mulai.


Berkas baru: ['/tmp/to.txt'], ada salah: {
	Keluaran tulis: ['Confirmed. Target file does not exist.\
'].
}.
Berkas baru: ['/tmp/from.txt'], ada salah: {
	Keluaran tulis: ['Confirmed. Source file does not exist.\
'].
}.



Program sistem: (Seruput baru touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], peroleh).



Program sistem: (Seruput baru cp: ['/tmp/from.txt /tmp/to.txt'], peroleh).

Berkas baru: ['/tmp/to.txt'], ada benar: {
	Keluaran tulis: ['Confirmed. Target file has been created by shell.\
'].
}.


Keluaran tulis: ['Isi berkas adalah:'] + (Berkas baru: ['/tmp/to.txt'], baca), baris-baru.
