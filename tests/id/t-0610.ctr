
>> PersegiPanjang := Objek baru.

PersegiPanjang saat: ['luas'] lakukan: {
	<- milik panjang * milik lebar.
}.

PersegiPanjang saat: ['length:'] lakukan: { :panjang
	milik panjang := panjang.
}.

PersegiPanjang saat: ['width:'] lakukan: { :lebar
	milik lebar := lebar.
}.

PersegiPanjang saat: ['baru'] lakukan: {
	# ini tidak akan menghasilkan perulangan tanpa akhir
	>> persegiPanjang := diri baru.
	persegiPanjang length: 0, width: 0.
	<- persegiPanjang.
}.

>> a := PersegiPanjang baru.
Keluaran tulis: a luas, baris-baru. #0

>> b := PersegiPanjang baru length: 2, width: 3.
Keluaran tulis: b luas, baris-baru. #6

