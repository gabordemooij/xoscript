
>> Rectangle := Objek baru.

Rectangle saat: ['area'] lakukan: { <- milik panjang * milik width.
}.

Rectangle saat: ['length:'] lakukan: { :panjang
	milik panjang := panjang.
}.

Rectangle saat: ['width:'] lakukan: { :width
	milik width := width.
}.

Rectangle saat: ['baru'] lakukan: {
	# this will not result into an infinite loop
	>> rectangle := diri baru.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle baru.
Keluaran tulis: a area, baris-baru. #0

>> b := Rectangle baru length: 2, width: 3.
Keluaran tulis: b area, baris-baru. #6

