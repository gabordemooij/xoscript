>> Animal := Objek baru.
>> Factory := Objek baru.

Animal saat: ['baru'] lakukan: {
	>> animal := diri baru.
	animal sound: ['?']. <- animal.
}.

Animal saat: ['sound:'] lakukan: { :s
	milik sound := s.
}.

Animal saat: ['sound'] lakukan: { <- milik sound.
}.

>> Dog := Objek baru.
>> Cat := Objek baru.

Dog saat: ['baru'] lakukan: { <- Animal baru sound: ['woof!'].
}.

Cat saat: ['baru'] lakukan: { <- Animal baru sound: ['meow!'].
}.

Keluaran tulis: Dog baru sound, baris-baru.
Keluaran tulis: Cat baru sound, baris-baru.

Factory saat: ['mix:and:'] lakukan: { :beast1 :beast2 <- Animal baru sound: (
		( beast1 sound dari: 0 panjang: 2 ) +
		( beast2 sound dari: 2 panjang: 5 )
	).
}.

Keluaran tulis: (Factory mix: Dog baru and: Cat baru) sound, baris-baru.
