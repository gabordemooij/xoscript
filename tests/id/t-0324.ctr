>> Hewan := Objek baru.
>> Pabrik := Objek baru.

Hewan saat: ['baru'] lakukan: {
	>> hewan := diri baru.
	hewan sound: ['?']. <- hewan.
}.

Hewan saat: ['sound:'] lakukan: { :s
	milik suara := s.
}.

Hewan saat: ['suara'] lakukan: { <- milik suara.
}.

>> Anjing := Objek baru.
>> Kucing := Objek baru.

Anjing saat: ['baru'] lakukan: { <- Hewan baru sound: ['woof!'].
}.

Kucing saat: ['baru'] lakukan: { <- Hewan baru sound: ['meow!'].
}.

Keluaran tulis: Anjing baru suara, baris-baru.
Keluaran tulis: Kucing baru suara, baris-baru.

Pabrik saat: ['campur:dan:'] lakukan: { :binatang1 :binatang2 <- Hewan baru sound: (
		( binatang1 suara dari: 0 panjang: 2 ) +
		( binatang2 suara dari: 2 panjang: 5 )
	).
}.

Keluaran tulis: (Pabrik campur: Anjing baru dan: Kucing baru) suara, baris-baru.
