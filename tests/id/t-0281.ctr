>> q := Daftar ← 1 ; 2 ; 3.
{ q ? ['1']. } tangkap: { Keluaran tulis: ['tertangkap!'], baris-baru. }, mulai.
{ q ? Benar. } tangkap: { Keluaran tulis: ['tertangkap!'], baris-baru. }, mulai.
{ q ? Salah. } tangkap: { Keluaran tulis: ['tertangkap!'], baris-baru. }, mulai.
{ q ? Kosong. } tangkap: { Keluaran tulis: ['tertangkap!'], baris-baru. }, mulai.
{ q ? (Daftar baru). } tangkap: { Keluaran tulis: ['tertangkap!'], baris-baru. }, mulai.
{ q ? (Objek baru). } tangkap: { Keluaran tulis: ['tertangkap!'], baris-baru. }, mulai.
{ q ? ({ ['Kosong']. }). } tangkap: { Keluaran tulis: ['tertangkap!'], baris-baru. }, mulai.
Keluaran tulis: ['tertangkap semua'], baris-baru.
