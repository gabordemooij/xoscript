Keluaran tulis: ['Objek uji'], baris-baru.
>> a := Objek baru. 
a saat: ['item:'] lakukan: { :dft
	milik dft := dft. 
}.
a saat: ['barang'] lakukan: {
	<- milik dft.
}.
a item: (
	Daftar baru ; 1 ; (
		Daftar baru ; ['a'] ; (
			Daftar baru ; ( Momen baru: 1 )
		) ; ( Int64 dari-teks: ['321'] )
	)
).
Keluaran tulis: a barang, baris-baru.
>> alamat-lama-dft := a barang prototipe alamat-memori.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== MEMUAT ULANG SNAP:'], baris-baru.
>> b := Objek load-from: ['/tmp/a.bin'].
(b barang prototipe alamat-memori = alamat-lama-dft) benar: {
	Keluaran tulis: ['Tautan objek dipasang kembali.'], baris-baru.
}.
Keluaran tulis: ( b barang ), baris-baru.
