Keluaran tulis: ['Test object'], baris-baru.
>> a := Objek baru. 
a saat: ['item:'] lakukan: { :lst
	milik lst := lst. 
}.
a saat: ['item'] lakukan: { <- milik lst.
}.
a item: (
	Daftar baru ; 1 ; (
		Daftar baru ; ['a'] ; (
			Daftar baru ; ( Momen baru: 1 )
		) ; ( Int64 dari-teks: ['321'] )
	)
).
Keluaran tulis: a item, baris-baru.
>> old-lst-address := a item prototipe alamat-memori.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baru.
>> b := Objek load-from: ['/tmp/a.bin'].
(b item prototipe alamat-memori = old-lst-address) benar: {
	Keluaran tulis: ['Object link re-attached.'], baris-baru.
}.
Keluaran tulis: ( b item ), baris-baru.
