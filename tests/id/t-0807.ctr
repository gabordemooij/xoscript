# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB baru hos: ['localhost'],
	nama-pengguna: ['xo'],
	kata-sandi: ['pass123'],
	nama-basis-data: ['xobase'],
	sambungkan.

>> parameter-pencarian := db kueri: ['SELECT %% FROM'].
{ parameter-pencarian jalankan. } tangkap: { :e
	Keluaran tulis: ( e mengandung: ['%%'] ), baris-baru.
}, mulai.
