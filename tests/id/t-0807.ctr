# pesan galat basis data tidak boleh diperlakukan sebagai teks format
Server init.

>> bd := Maria-DB baru hos: ['localhost'],
	nama-pengguna: ['xo'],
	kata-sandi: ['pass123'],
	nama-basis-data: ['xobase'],
	sambungkan.

>> parameter-pencarian := bd kueri: ['SELECT %% FROM'].
{ parameter-pencarian jalankan. } tangkap: { :e
	Keluaran tulis: ( e mengandung: ['%%'] ), baris-baru.
}, mulai.
