
>> a := Daftar ← (Daftar ← 100 ; 200 ; 300) ; (Daftar ← 9 ; 8 ; 7).
Keluaran tulis: ['pada 0,1 :'].
Keluaran tulis: a ? 0 ? 1, baris-baru. 
Keluaran tulis: ['pada 1,2 :'].
Keluaran tulis: a ? 1 ? 2, baris-baru. 
>> menu := Kamus baru.
menu taruh: (Daftar ← ['pizza'] ; ['spageti']) di: ['Masakan Italia'].
menu taruh: (Daftar ← ['bifteki'] ; ['suflaki']) di: ['Masakan Yunani'].
Keluaran tulis: ['Saya suka '] + (menu ? ['Masakan Yunani'] ? 0) + [' dan '] + (menu ? ['Masakan Italia'] ? 1), baris-baru. 
Keluaran tulis: ['tapi tidak di piring yang sama.'], baris-baru.
