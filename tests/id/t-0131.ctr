
>> a := Daftar ← (Daftar ← 100 ; 200 ; 300) ; (Daftar ← 9 ; 8 ; 7).
Keluaran tulis: ['at 0,1 :'].
Keluaran tulis: a ? 0 ? 1, baris-baru. 
Keluaran tulis: ['at 1,2 :'].
Keluaran tulis: a ? 1 ? 2, baris-baru. 
>> menu := Kamus baru.
menu taruh: (Daftar ← ['pizza'] ; ['spaghetti']) di: ['Italian Cuisine'].
menu taruh: (Daftar ← ['bifteki'] ; ['suflaki']) di: ['Greek Cuisine'].
Keluaran tulis: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), baris-baru. 
Keluaran tulis: ['but not on the same plate.'], baris-baru.
