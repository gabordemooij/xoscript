Server init.
>> fmt := Format baru: ['%#3x'].

>> blob := Blob baru: 4.
blob bytes: ( 
	Daftar baru ; 0 ; 1 ; 2 ; 3
).

>> file := Berkas baru: ['/tmp/blob'].
file blob: blob.
blob bebaskan.

>> baca := file blob.
baca 
dari: 0 
panjang: 4, 
lakukan setiap: { :i :b 
	Keluaran
	tulis: (fmt terapkan-bilangan-bulat: b),
	baris-baru.
}.
baca bebaskan.
