


>> Deck := Daftar baru.
Deck saat: ['print'] lakukan: {
        >> len := diri jumlah - 1.
        { :i
                >> len2 := diri jumlah - 1.
                Keluaran tulis: ['len: '].
                Keluaran tulis: len, baris-baru.
                Keluaran tulis: ['len2: '].
                Keluaran tulis: len2, baris-baru.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
