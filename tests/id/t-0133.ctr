


>> Dek := Daftar baru.
Dek saat: ['cetak'] lakukan: {
        >> len := diri jumlah - 1.
        { :i
                >> pjg2 := diri jumlah - 1.
                Keluaran tulis: ['panj: '].
                Keluaran tulis: len, baris-baru.
                Keluaran tulis: ['panj2: '].
                Keluaran tulis: pjg2, baris-baru.
        } × len.
}.

>> d := Dek ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d cetak.
