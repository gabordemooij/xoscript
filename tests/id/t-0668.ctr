# dekode dari utf16le/be atau utf32le/be ke utf8
Server init.
>> utf16 := Blob baru: 8, bytes: (
	Daftar baru ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Keluaran tulis: ( utf16 dekode: ['utf16le'] ), baris-baru.

utf16 bebaskan.
>> utf32 := Blob baru: 13, bytes: (
	Daftar baru ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Keluaran tulis: ( utf32 dekode: ['utf32be'] ), baris-baru.
utf32 bebaskan.