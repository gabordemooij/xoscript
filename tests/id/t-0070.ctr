>> numbers := ['1,2,3'] pisahkan: [','].
Keluaran tulis: ['I got: '] + numbers jumlah + [' numbers.'],baris-baru.
{ :i Keluaran tulis: ['number #'] + i + [':'] + (numbers posisi: i), baris-baru.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages pisahkan: [' Or '].
Keluaran tulis: ['We serve'], baris-baru.
{ :i Keluaran tulis: ['->'] + (beverages posisi: i), baris-baru. } × (beverages jumlah).
Keluaran tulis: (beverages gabungkan: [',']), baris-baru.
Keluaran tulis: (numbers gabungkan: ['||']).
