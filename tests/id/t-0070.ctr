>> angka-angka := ['1,2,3'] pisahkan: [','].
Keluaran tulis: ['Saya dapat: '] + angka-angka jumlah + [' angka.'],baris-baru.
{ :i Keluaran tulis: ['number #'] + i + [':'] + (angka-angka posisi: i), baris-baru.} × 3.
>> minuman := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
minuman := minuman pisahkan: [' Or '].
Keluaran tulis: ['Kami menyajikan'], baris-baru.
{ :i Keluaran tulis: ['->'] + (minuman posisi: i), baris-baru. } × (minuman jumlah).
Keluaran tulis: (minuman gabungkan: [',']), baris-baru.
Keluaran tulis: (angka-angka gabungkan: ['||']).
