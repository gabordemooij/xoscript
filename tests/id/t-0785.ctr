Keluaran tulis: ['Objek uji'], baris-baru.
>> a := Objek baru. 

a saat: ['item:'] lakukan: { :mmn
	milik mmn := mmn. 
}.

a saat: ['barang'] lakukan: {
	<- milik mmn.
}.

>> hari-ini := Daftar baru ; ( Momen baru zona: ['CEST'], tahun: 2026, bulan: 7 ).
a item: hari-ini.
Keluaran tulis: a barang ? 0, baris-baru.
a save-as: ['/tmp/a.bin'].
