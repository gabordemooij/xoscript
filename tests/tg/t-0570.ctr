#Linux

 >> t := Лаҳза нав.
 
t минтақаи-вақт: ['Europe/Amsterdam'].
t сол: 2020, моҳ: 8, рӯз: 2, соат: 21, дақиқа: 2, сония: 1.

>> a := t соат.
>> ams := t минтақаи-вақт.

t минтақаи-вақт: ['US/Hawaii'].
>> b := t соат.
>> hw := t минтақаи-вақт.

Баромад
навис: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		ин: ['later'] ё-он: ['earlier']
	)
),
сатри-нав.
 