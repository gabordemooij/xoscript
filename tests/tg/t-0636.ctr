# test url parsing

Server init.
>> url := URL манбаъ: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Баромад навис: ['scheme = '] + url схема, сатри-нав.
Баромад навис: ['host = '] + url мизбон, сатри-нав.
Баромад навис: ['port = '] + url порт, сатри-нав.
Баромад навис: ['path = '] + url роҳ, сатри-нав.
Баромад навис: ['query = '] + url параметрҳои-ҷустуҷӯ, сатри-нав.
Баромад навис: ['fragment = '] + url порча, сатри-нав.
