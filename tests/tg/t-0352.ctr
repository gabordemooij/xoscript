Адад ҳангоми: ['roman'] иҷро: {
	>> адад := худ нусха.
	>> roman := [''].
	{
		{
			(адад ≥ 1000) агар-рост: {
				roman ба-охир-илова: ['Ⅿ'].
				адад тарҳ: 1000.
			}, буридан.
		
			(адад ≥ 500) агар-рост: {
				roman ба-охир-илова: ['Ⅾ'].
				адад тарҳ: 500.
			}, буридан.
		
			(адад ≥ 100) агар-рост: {
				roman ба-охир-илова: ['Ⅽ'].
				адад тарҳ: 100.
			}, буридан.
		
			(адад ≥ 50) агар-рост: {
				roman ба-охир-илова: ['Ⅼ'].
				адад тарҳ: 50.
			}, буридан.
		
			(адад ≥ 50) агар-рост: {
				roman ба-охир-илова: ['Ⅼ'].
				адад тарҳ: 50.
			}, буридан.
		
			(адад ≥ 10) агар-рост: {
				roman ба-охир-илова: ['Ⅹ'].
				адад тарҳ: 10.
			}, буридан.
			
			(адад ≥ 9) агар-рост: {
				roman ба-охир-илова: ['Ⅸ'].
				адад тарҳ: 9.
			}, буридан.
			
			(адад ≥ 5) агар-рост: {
				roman ба-охир-илова: ['Ⅴ'].
				адад тарҳ: 5.
			}, буридан.
			
			(адад ≥ 4) агар-рост: {
				roman ба-охир-илова: ['Ⅳ'].
				адад тарҳ: 4.
			}, буридан.
			
			(адад ≥ 1) агар-рост: {
				roman ба-охир-илова: ['Ⅰ'].
				адад тарҳ: 1.
			}, буридан.
		} тартиб.
	} то-даме: { <- адад > 0. }. <- roman.
}.

Баромад навис: 1 roman, сатри-нав.
Баромад навис: 2 roman, сатри-нав.
Баромад навис: 4 roman, сатри-нав.
Баромад навис: 8 roman, сатри-нав.
Баромад навис: 16 roman, сатри-нав.
Баромад навис: 32 roman, сатри-нав.
Баромад навис: 64 roman, сатри-нав.
Баромад навис: 128 roman, сатри-нав.
Баромад навис: 256 roman, сатри-нав.
Баромад навис: 1024 roman, сатри-нав.
