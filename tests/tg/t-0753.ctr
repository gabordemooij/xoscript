Баромад навис: ['Test object'], сатри-нав.
>> a := Объект нав. 

a ҳангоми: ['item:'] иҷро: { :fmt
	худӣ fmt := fmt. 
}.

a ҳангоми: ['item'] иҷро: { <- худӣ fmt.
}.

a item: ( Формат нав: ['|%s|'] ).

Баромад навис: a item, сатри-нав.

>> old-fmt-address := a item прототип суроғаи-хотира.
a save-as: ['/tmp/a.bin'].
Баромад навис: ['========== RELOADING SNAP:'], сатри-нав.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип суроғаи-хотира = old-fmt-address) агар-рост: {
	Баромад навис: ['Object link re-attached.'], сатри-нав.
}.

Баромад навис: ( b item татбиқ: ['hello'] ), сатри-нав.
