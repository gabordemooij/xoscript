Server init.
>> fmt := Формат нав: ['%#3x'].

>> blob := Blob нав: 4.
blob bytes: ( 
	Феҳрист нав ; 0 ; 1 ; 2 ; 3
).

>> file := Файл нав: ['/tmp/blob'].
file blob: blob.
blob озод.

>> хон := file blob.
хон 
оғоз: 0 
дарозӣ: 4, 
оғози-занҷир ҳар-як: { :i :b 
	Баромад
	навис: (fmt татбиқ-ба-бутун: b),
	сатри-нав.
}.
хон озод.
