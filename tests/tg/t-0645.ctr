Server init.
Баромад навис: ['Database date test'], сатри-нав.

>> db := Maria-DB нав мизбон: ['localhost'],
	номи-корбар: ['xo'], 
	парол: ['pass123'],
	номи-пойгоҳ: ['xobase'],
	пайваст-шав.

>> параметрҳои-ҷустуҷӯ :=
db дархост: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
гирифтан: { :row
	Баромад навис: row datetest, сатри-нав.
}.
