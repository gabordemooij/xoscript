#...
>> del := conn1 дархост: ['DELETE FROM book WHERE id > 0'].
{  del иҷро-кун. conn1 тасдиқ. } дошта-гир: { :e conn1 бозгашт.  }, оғоз.

>> insert := conn1 дархост: ['INSERT INTO book (id) VALUES(null)'].
insert иҷро-кун.

>> шумора := conn1 дархост: ['SELECT COUNT(*) AS num FROM book'].
шумора гирифтан: { :row Баромад навис: row num, сатри-нав. }.

# does not show up
# insert not committed on connection 1
>> шумора := conn2 дархост: ['SELECT COUNT(*) AS num FROM book'].
шумора гирифтан: { :row Баромад навис: row num, сатри-нав. }.
