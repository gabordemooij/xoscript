
Матн ҳангоми: ['html'] иҷро: { <- (
		худ
		иваз: ['&'] бо: ['&amp;'],
		иваз: ['<'] бо: ['&lt;'],
		иваз: ['>'] бо: ['&gt;'],
		иваз: ['"'] бо: ['&quot;']
	).
}.

>> HtmlBrush := Объект нав.

HtmlBrush ҳангоми: ['ҷавоб:'] иҷро: { :tag
	Баромад навис: (['<tag>↵'] tag: tag ).
}.

HtmlBrush ҳангоми: ['ҷавоб:ва:'] иҷро: { :tag :content
	tag := ( tag оғоз: 0 дарозӣ: (tag дарозӣ - 1) ).
	Баромад навис: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush ҳангоми: ['content:'] иҷро: { :text
	Баромад навис: text html, сатри-нав.
}.

HtmlBrush ҳангоми: ['attr:value:'] иҷро: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush нав.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
