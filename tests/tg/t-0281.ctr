>> q := Феҳрист ← 1 ; 2 ; 3.
{ q ? ['1']. } дошта-гир: { Баромад навис: ['caught!'], сатри-нав. }, оғоз.
{ q ? Рост. } дошта-гир: { Баромад навис: ['caught!'], сатри-нав. }, оғоз.
{ q ? Дурӯғ. } дошта-гир: { Баромад навис: ['caught!'], сатри-нав. }, оғоз.
{ q ? Ҳеҷ. } дошта-гир: { Баромад навис: ['caught!'], сатри-нав. }, оғоз.
{ q ? (Феҳрист нав). } дошта-гир: { Баромад навис: ['caught!'], сатри-нав. }, оғоз.
{ q ? (Объект нав). } дошта-гир: { Баромад навис: ['caught!'], сатри-нав. }, оғоз.
{ q ? ({ ['Empty']. }). } дошта-гир: { Баромад навис: ['caught!'], сатри-нав. }, оғоз.
Баромад навис: ['caught them all'], сатри-нав.
