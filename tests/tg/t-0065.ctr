Адад ҳангоми: ['factorial'] иҷро: {
	>> total := 1.
	{ :index total зарб: (худ - (index)). } × худ. <- total.
}.
>> Printer := Объект нав.
Printer ҳангоми: ['print:and:'] иҷро: { :x :y
	Баромад навис: ['a='] + x + [', b='] + y, сатри-нав.
}.
>> a := 4.5. >> b := a ба-поён-яклухт.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a ба-боло-яклухт.
Printer print: a and: b.
a := 4.5. b := a ба-поён-яклухт.
Printer print: a and: b.
a := 4.5. b := a яклухт.
Printer print: a and: b.
a := 4.2. b := a яклухт.
Printer print: a and: b.

Баромад навис: (9 бақия: 5), сатри-нав.
Баромад навис: -666 қимати-мутлақ, сатри-нав.
Баромад навис: 49 решаи-квадратӣ, сатри-нав.
Баромад навис: (2 дараҷа: 3), сатри-нав.
>> l := (Феҳрист ← 9 ; 6).
Баромад навис: l камтарин.

