>> t := Ҳеҷ.

# you can control the time zone for
# parsing like this:
Лаҳза минтақаи-вақт: ['CET'].
t := Лаҳза манбаъ: ['1981-02-03 04:05:06'].
Баромад навис: t, сатри-нав.

# now using CEST time zone:
Лаҳза минтақаи-вақт: ['CEST'].
t := Лаҳза манбаъ: ['1981-02-03 04:05:06'].
Баромад навис: t, сатри-нав.

# error if string cannot be parsed
{ Лаҳза манбаъ: ['1900']. } дошта-гир: { Ҳеҷ. }, оғоз.
