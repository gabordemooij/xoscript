>> t := Рост.
(t = Рост) агар-рост: { Баромад навис: ['T']. }.
(t = Дурӯғ) агар-рост: { Баромад навис: ['F']. }.
Баромад навис: ['|'].
>> t := Дурӯғ.
(t = Рост) агар-рост: { Баромад навис: ['T']. }.
(t = Дурӯғ) агар-рост: { Баромад навис: ['F']. }.
Баромад навис: ['|'].
>> f := Рост.
(t = Рост ва: f = Дурӯғ) агар-рост: { Баромад навис: ['T']. }.
(t = Дурӯғ ва: f = Рост) агар-рост: { Баромад навис: ['F']. }.
Баромад навис: ['|'].
>> n := Ҳеҷ.
(n Ҳеҷ?) агар-рост: { Баромад навис: ['T']. }.
(n Ҳеҷ?) агар-дурӯғ: { Баромад навис: ['F']. }.
Баромад навис: ['|'].
(f Boolean?) агар-рост: { Баромад навис: ['T']. }.
(f Boolean?) агар-дурӯғ: { Баромад навис: ['F']. }.



