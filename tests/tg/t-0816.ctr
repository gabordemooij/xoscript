# a format must fit the type of the value, the type can come from a client
>> кӯшиш := { :format :value
	{ Баромад навис: ( (Формат нав: format) татбиқ: value ), сатри-нав. } дошта-гир: { :e Баромад навис: e, сатри-нав. }, оғоз.
}.
>> try-int := { :format :value
	{ Баромад навис: ( (Формат нав: format) татбиқ-ба-бутун: value ), сатри-нав. } дошта-гир: { :e Баромад навис: e, сатри-нав. }, оғоз.
}.

# fits
кӯшиш татбиқ: ['|%s|'] ва: ['text'].
кӯшиш татбиқ: ['%06.2f'] ва: 5.5.
кӯшиш татбиқ: ['100%% %s'] ва: ['sure'].
try-int татбиқ: ['%03d'] ва: 7.
try-int татбиқ: ['%x'] ва: 255.
кӯшиш татбиқ: ['%d'] ва: (Int64 нав аз-матн: ['12']).
кӯшиш татбиқ: ['%lld'] ва: (Int64 нав аз-матн: ['12']).
кӯшиш татбиқ: ['%.1lf'] ва: 5.5.
try-int татбиқ: ['%hd'] ва: 7.

# does not fit
кӯшиш татбиқ: ['%s'] ва: 12345.
кӯшиш татбиқ: ['%d'] ва: 12345.
кӯшиш татбиқ: ['%f'] ва: ['text'].
try-int татбиқ: ['%d'] ва: ['text'].
try-int татбиқ: ['%s'] ва: 5.
кӯшиш татбиқ: ['%s %s'] ва: ['text'].
кӯшиш татбиқ: ['%n'] ва: ['text'].
кӯшиш татбиқ: ['%*s'] ва: ['text'].
кӯшиш татбиқ: ['%'] ва: ['text'].

# length modifier does not fit
кӯшиш татбиқ: ['%ls'] ва: ['text'].
кӯшиш татбиқ: ['%Lf'] ва: 5.5.
try-int татбиқ: ['%ld'] ва: 7.
try-int татбиқ: ['%lld'] ва: 7.
кӯшиш татбиқ: ['%Ld'] ва: (Int64 нав аз-матн: ['12']).

# a width that does not fit printf must give an error, not a crash
кӯшиш татбиқ: ['%99999999999s'] ва: ['text'].
