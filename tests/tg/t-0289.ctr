#Linux
>> OS := Барнома система: (Фармон uname -s), буриши-фосила.

>> Slurp := Объект нав.
Slurp ҳангоми: ['нав'] иҷро: {
	худӣ str := [''].
}.
Slurp ҳангоми: ['ҷавоб:'] иҷро: { :blah
		(худӣ str ≠ ['']) агар-рост: {
			худӣ str ба-охир-илова: [' '].
		}.
		худӣ str ба-охир-илова: blah.
}.
Slurp ҳангоми: ['ҷавоб:ва:'] иҷро: { :blah :blahah
		(худӣ str ≠ ['']) агар-рост: {
			худӣ str ба-охир-илова: [' '].
		}.
		(blah дарозӣ > 1) агар-рост: {
			худӣ str ба-охир-илова: (blah оғоз: 0 дарозӣ: (blah дарозӣ - 1)).
		}, вагарна: {
			худӣ str ба-охир-илова: blah.
		}.
		худӣ str ба-охир-илова: [' '].
		худӣ str ба-охир-илова: blahah.
}.
Slurp ҳангоми: ['obtain'] иҷро: {
	>> buffer := худӣ str.
	худӣ str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text ба-охир-илова: ['hello'].
} × 1000.


Баромад навис: (
	Барнома система: (
		Slurp нав
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

