#OBSD
>> dirname := [''].
{ dirname ба-охир-илова: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Барнома система: command.
Барнома chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename ба-охир-илова: ['YYYYYYYY']. } * 20.
Файл нав: filename, навис: ['sometext'].
{ Файл рӯйхат: ['/tmp/'] + dirname. } * 1000.
Баромад навис: ['no crash'], сатри-нав.

