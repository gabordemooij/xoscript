


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Барнома идораи-хотира: 0.
>> palette := Ҳеҷ.
>> colors := Ҳеҷ.

{
palette := Луғат нав.
palette 
	гузор: ['#F00'] калид: ['red'],
	гузор: ['#0F0'] калид: ['green'],
	гузор: ['#00F'] калид: ['blue'].
Баромад навис: ['number of RGB codes in palette: '] + ( palette шумора ), сатри-нав.
Баромад навис: ['RGB code of green is: '] + ( palette ? ['green'] ), сатри-нав.
colors := [''].
( palette ҳар-як: { :ном :код
		colors := colors + ( ном + [':'] + код ).
} ).
Баромад навис: ['All colors in palette: '] + colors, сатри-нав.
} оғоз.
Барнома тозакунӣ.
usedMemory1 := (Барнома хотира ? 0).

{
palette := Луғат нав.
palette 
	гузор: ['#F00'] калид: ['red'],
	гузор: ['#0F0'] калид: ['green'],
	гузор: ['#00F'] калид: ['blue'].
Баромад навис: ['number of RGB codes in palette: '] + ( palette шумора ), сатри-нав.
Баромад навис: ['RGB code of green is: '] + ( palette ? ['green'] ), сатри-нав.
colors := [''].
( palette ҳар-як: { :ном :код
		colors := colors + ( ном + [':'] + код ).
} ).
Баромад навис: ['All colors in palette: '] + colors, сатри-нав.
} оғоз.
Барнома тозакунӣ.
usedMemory2 := (Барнома хотира ? 0).

{
palette := Луғат нав.
palette 
	гузор: ['#F00'] калид: ['red'],
	гузор: ['#0F0'] калид: ['green'],
	гузор: ['#00F'] калид: ['blue'].
Баромад навис: ['number of RGB codes in palette: '] + ( palette шумора ), сатри-нав.
Баромад навис: ['RGB code of green is: '] + ( palette ? ['green'] ), сатри-нав.
colors := [''].
( palette ҳар-як: { :ном :код
		colors := colors + ( ном + [':'] + код ).
} ).
Баромад навис: ['All colors in palette: '] + colors, сатри-нав.
} оғоз.
Барнома тозакунӣ.
usedMemory3 := (Барнома хотира ? 0).



( usedMemory1 = usedMemory2 ва: usedMemory1 = usedMemory3, ва: usedMemory2 = usedMemory3 ) агар-рост: {
	Баромад навис: ['No memory leaks here'].
}, агар-дурӯғ: {
	Баромад навис: ['Leaking memory...'].
}.
