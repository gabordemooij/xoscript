>> map1 := Луғат нав.
>> key1 := Феҳрист нав.
>> key2 := Феҳрист нав.

map1
	гузор: ['hello'] калид: key1,
	гузор: ['world'] калид: key2.


Баромад
	навис: ['Map #1 contains: '] + (map1 дар: key1),
	навис: [' and '] + (map1 дар: key2), сатри-нав.

>> KeyeableArray := Феҳрист нав.
KeyeableArray ҳангоми: ['toString'] иҷро: { <- (худ шумора) toString.
}.

>> map2 := Луғат нав.
key1 := KeyeableArray нав.
key2 := KeyeableArray нав.

key1 ба-охир-илова: 1.

map2
	гузор: ['hello'] калид: key1,
	гузор: ['world'] калид: key2.

Баромад
	навис: ['Map #2 contains: '] + (map2 дар: key1),
	навис: [' and '] + (map2 дар: key2), сатри-нав.
