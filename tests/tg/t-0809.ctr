# backslashes must survive code serialization, strings must not end early
>> қиматҳо := Феҳрист нав
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

қиматҳо ҳар-як: { :i :value
	>> d := Луғат нав.
	d гузор: value калид: ['k'].
	>> r := d код объект.
	Баромад навис: r шумора, сатри-нав.
	Баромад навис: ( (r дар: ['k']) = value ), сатри-нав.
}.
