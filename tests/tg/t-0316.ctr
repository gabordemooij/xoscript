>> Grandfather := Объект нав.
Grandfather ҳангоми: ['greet'] иҷро: {
	Баромад навис: ['Ave!'], сатри-нав.
}.
>> Father := Grandfather нав.
Father ҳангоми: ['greet'] иҷро: {
	Баромад навис: ['Hello'], сатри-нав.
	худ greet.
}.
>> Son := Father нав.
Son ҳангоми: ['greet'] иҷро: {
	Баромад навис: ['Hi'], сатри-нав.
	худ greet.
}.

Son greet.

>> Roundabout := Объект нав.
Roundabout ҳангоми: ['circle:'] иҷро: { :x
	Баромад навис: x, сатри-нав.
	(x < 3) агар-рост: { худ рекурсивӣ circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) агар-рост: { Баромад навис: x, сатри-нав. x ҷамъ: 1.  increment оғоз. }. }.
increment оғоз.