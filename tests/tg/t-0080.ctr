{
	>> a := Феҳрист нав.
	a ба-охир-илова: 1.
	a ба-охир-илова: 2.
	Баромад навис: (a пайваст: [',']), сатри-нав.
	a гузор: 3 калид: 2.
	Баромад навис: (a пайваст: [',']), сатри-нав.
	a гузор: 4 калид: 10.
	Баромад навис: (a пайваст: [',']), сатри-нав.
	a якумро-гир.
	a якумро-гир.
	a якумро-гир.
	Баромад навис: (a пайваст: [',']), сатри-нав.
	a гузор: 9 калид: 0.
	Баромад навис: (a пайваст: [',']), сатри-нав.
	a гузор: 6 калид: -1.
} дошта-гир: { :e
	Баромад навис: ['Uncatched error has occurred.↵'] + e, сатри-нав.
}, оғоз.


