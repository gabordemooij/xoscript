


>> CoffeeMachine := Объект нав.
CoffeeMachine ҳангоми: ['order:'] иҷро: { :id
	>> coffee := ['Americano'].
	( id = 1 ) агар-рост: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) агар-рост: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) агар-рост: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Объект нав.
SimpleCoffeeMachine ҳангоми: ['order'] иҷро: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Баромад навис: redCup, сатри-нав.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Баромад навис: greenCup, сатри-нав.
>> yellowCup := CoffeeMachine order: 1.
Баромад навис: yellowCup, сатри-нав.
>> blueCup := CoffeeMachine order: 0.
Баромад навис: blueCup, сатри-нав.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Баромад навис: blackCup, сатри-нав.
blackCup ба-охир-илова: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Баромад навис: orangeCup, сатри-нав.
