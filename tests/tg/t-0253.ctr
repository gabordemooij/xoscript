#Linux
>> OS := Барнома танзим: ['OS'].

>> clock := Лаҳза нав.
	
(OS = ['Haiku']) агар-рост: {
	clock минтақаи-вақт: ['CET'],
	сол: 2017, моҳ: 7, рӯз: 13,
	соат: 18, дақиқа: 0, сония: 0.
}, вагарна: {
	clock минтақаи-вақт: ['Europe/Amsterdam'],
	сол: 2017, моҳ: 7, рӯз: 13,
	соат: 18, дақиқа: 0, сония: 0.
}.

clock ҳангоми: ['tell'] иҷро: {
	Баромад навис: худ, сатри-нав.
}.


clock ҷамъ: 2    соат, tell.
clock ҷамъ: 1    соат, tell.
clock ҷамъ: 19 дақиқа, tell.
clock ҷамъ: 1  дақиқа, tell.
clock ҷамъ: 1  дақиқа, tell.
clock ҷамъ: 19 сония, tell.
clock ҷамъ: 1  сония, tell.
clock ҷамъ: 1  сония, tell.
clock ҷамъ: 2    сол, tell.
clock ҷамъ: 1    сол, tell.

(OS = ['Haiku']) агар-рост: {
clock ҷамъ: 5   моҳ.
clock минтақаи-вақт: ['CEST'], tell.
}, вагарна: {
	clock ҷамъ: 5   моҳ, tell.
}.

clock ҷамъ: 1   моҳ, tell.
clock ҷамъ: 19    рӯз, tell.
clock ҷамъ: 1    соат, tell.
clock ҷамъ: 120  yard, tell.
