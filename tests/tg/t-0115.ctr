{
	ин-вазифа хато: ['Dont fail.'].
	unknown doSomething.
} дошта-гир: {
	Баромад навис: ['Caught!'].
}, оғоз.

{
	ин-вазифа хато: ['Dont fail.'].
	худӣ unknown doSomething.
} дошта-гир: {
	Баромад навис: ['Caught!'].
}, оғоз.

{
	ин-вазифа хато: ['Dont fail.'].
	unknown := 122.
} дошта-гир: {
	Баромад навис: ['Caught!'].
}, оғоз.


{
	ин-вазифа хато: ['Dont fail.'].
	Рост буридан.
	Баромад навис: ['FAIL'].
} дошта-гир: {
	Баромад навис: ['Caught!'].
}, оғоз.

{
	{
		ин-вазифа хато: ['Dont fail.'].
		Рост буридан.
		Баромад навис: ['FAIL'].
	} дошта-гир: { :x
		(x = ['Dont fail.']) агар-рост: { ин-вазифа хато: ['Nested Caught!']. }.
	}, оғоз.
} дошта-гир: { :e
	Баромад навис: e.
}, оғоз.
