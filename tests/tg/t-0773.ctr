Баромад навис: ['Test object'], сатри-нав.
>> a := Объект нав. 
a ҳангоми: ['item:'] иҷро: { :int64
	худӣ int64 := int64. 
}.
a ҳангоми: ['item'] иҷро: { <- худӣ int64.
}.
a item: ( Int64 аз-матн: ['9999'] ).
Баромад навис: a item, сатри-нав.
>> old-int64-address := a item прототип суроғаи-хотира.
a save-as: ['/tmp/a.bin'].
Баромад навис: ['========== RELOADING SNAP:'], сатри-нав.
>> b := Объект load-from: ['/tmp/a.bin'].
(b item прототип суроғаи-хотира = old-int64-address) агар-рост: {
	Баромад навис: ['Object link re-attached.'], сатри-нав.
}.
Баромад навис: ( b item ), сатри-нав.
