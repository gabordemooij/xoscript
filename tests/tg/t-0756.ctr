Баромад навис: ['Test object'], сатри-нав.
>> greeter := Объект нав.
greeter ҳангоми: ['name:'] иҷро: { :ном
	худӣ xname := ном. 
}.
greeter ҳангоми: ['greet'] иҷро: {
	Баромад навис: ['Hello '] + худӣ xname, сатри-нав.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Баромад навис: ['========== RELOADING SNAP:'], сатри-нав.
>> b := Объект load-from: ['/tmp/a.bin'].
>> c := Объект load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
