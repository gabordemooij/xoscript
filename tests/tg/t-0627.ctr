

# create a 64-bit integer for exact calculations
>> a := Int64 аз-матн: ['123'].

# to string
Баромад навис: a, сатри-нав.

# divide
Баромад навис: a / (Int64 аз-матн: ['3']), сатри-нав.

# multiply
Баромад навис: a * (Int64 аз-матн: ['2']), сатри-нав.

# add
Баромад навис: a + (Int64 аз-матн: ['1']), сатри-нав.

# subtract
Баромад навис: a - (Int64 аз-матн: ['2']), сатри-нав.

# compare
Баромад навис: ( a =   (Int64 аз-матн: ['123'])), сатри-нав.
Баромад навис: ( a !=: (Int64 аз-матн: ['124'])), сатри-нав.
Баромад навис: ( a <   (Int64 аз-матн: ['124'])), сатри-нав.
Баромад навис: ( a >   (Int64 аз-матн: ['122'])), сатри-нав.
Баромад навис: ( a >=: (Int64 аз-матн: ['123'])), сатри-нав.
Баромад навис: ( a <=: (Int64 аз-матн: ['123'])), сатри-нав.





	