>> Greeter := Объект нав.
Greeter ҳангоми: ['make'] иҷро: {
	>> greeter := Объект нав.
	greeter ҳангоми: ['name:'] иҷро: { :ном
		Баромад навис: ['setting a name'].
		худӣ myName := ном.
	}.
	greeter ҳангоми: ['performGreeting'] иҷро: {
		Баромад навис: ['Hello'].
		Баромад навис: худӣ myName.
	}.
	greeter ҳангоми: ['greet'] иҷро: {
		худ performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
