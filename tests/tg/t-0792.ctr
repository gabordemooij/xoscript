Server init.

>> DB := Maria-DB нав мизбон: ['localhost'],
	номи-корбар: ['xo'],
	парол: ['pass123'],
	номи-пойгоҳ: ['xobase'],
	пайваст-шав.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB дархост: SQL.

# now you don't have to set DB
query2 гирифтан: { :row
	Баромад навис: row world, сатри-нав.
}.
