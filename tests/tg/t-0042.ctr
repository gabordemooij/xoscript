>> items := Луғат нав.
items гузор: ['black'] калид: ['coffee'], гузор: ['earl grey'] калид: ['tea'].
Баромад навис: (items дар: ['coffee']), навис: (items дар: ['tea']).
Баромад навис: ['there are'] + items шумора + [' items in the array.'].
items гузор: ['capuccino'] калид: ['coffee'].
Баромад навис: ['Now my coffee is.. '] + (items дар: ['coffee']).
items гузор: ['aaa'] калид: ['1'].
items гузор: ['bbb'] калид: ['2'].
Баромад навис: (items дар: ['a']).
