
>> Size := Объект нав.
Size ҳангоми: ['is:'] иҷро: { :адад
	адад ҳангоми: ['+'] иҷро: { :адад
		>> unit := адад воҳиди-ченак.
		>> factor := 1.
		
		unit
		ҳолат: ['inch'] иҷро: { factor := 0.0833. }. <- худ + (адад * factor).
	}. <- адад.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Баромад навис: plank + edge, сатри-нав.
