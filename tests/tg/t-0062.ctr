Мантиқӣ ҳангоми: ['xor:'] иҷро: { :a :b <- ((a ва: b баръакс) ё: (a баръакс ва: b)).
}.

>> o := Объект нав.
o ҳангоми: ['hello'] иҷро: { ['Empty']. }.
{ o ҳангоми: 2 иҷро: 3.} дошта-гир: { :e Баромад навис: e, сатри-нав. }, оғоз.
{ o ҳангоми: ['санҷиш'] иҷро: 3.} дошта-гир: { :e Баромад навис: e, сатри-нав. }, оғоз.
{ o ҳангоми: ['hello'] иҷро: { ['Empty']. }.} дошта-гир: { :e Баромад навис: e, сатри-нав. }, оғоз. 
{ >> z := 4 ÷ 0. } дошта-гир: { :e Баромад навис: e, сатри-нав. }, оғоз. 
{ (Рост ва: Ҳеҷ) агар-рост: { Баромад навис: ['X'].}. } дошта-гир: { :e Баромад навис: e, сатри-нав. }, оғоз. 
{ ([''] xor: 0) агар-рост: { Баромад навис: ['X'].}. } дошта-гир: { :e Баромад навис: e, сатри-нав. }, оғоз. 
{ (1 < ['2']) агар-рост: { Баромад навис: ['OK']. }. } дошта-гир: { :e Баромад навис: e, сатри-нав. }, оғоз. 
{ (1 < ['2.0']) агар-рост: { Баромад навис: ['OK']. }. } дошта-гир: { :e Баромад навис: e, сатри-нав. }, оғоз. 
{ (1 < ['x2.0']) агар-рост: { Баромад навис: ['NO!']. }. } дошта-гир: { :e Баромад навис: e, сатри-нав. }, оғоз. 
{ Баромад навис: (['hello OK there'] оғоз: ['6'] дарозӣ: ['2']). } оғоз. 
