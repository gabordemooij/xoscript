Барнома идораи-хотира: 0.
Феҳрист ҳангоми: ['sum'] иҷро: {
	>> total := 0.
	худ ҳар-як: { :index :element
		total ҷамъ: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Файл нав: ['/tmp/test.txt'].
f навис: ['Lorem Ipsum'].
f пӯш.
  

f := Файл нав: ['/tmp/test.txt'].
>> text := f хон.
f пӯш.



Барнома тозакунӣ.
usedMemory1 := (Барнома хотира ? 1).



f := Файл нав: ['/tmp/test.txt'].
text := f хон.
f пӯш.

Барнома тозакунӣ.
usedMemory2 := (Барнома хотира ? 1).


f := Файл нав: ['/tmp/test.txt'].
text := f хон.
f пӯш.

Барнома тозакунӣ.
usedMemory3 := (Барнома хотира ? 1).



( usedMemory1 = usedMemory2 ва: usedMemory1 = usedMemory3, ва: usedMemory2 = usedMemory3 ) агар-рост: {
	Баромад навис: ['No memory leaks here'].
}, агар-дурӯғ: {
	Баромад навис: ['Leaking memory...'].
}.
