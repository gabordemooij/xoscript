

Матн ҳангоми: ['evaluate'] иҷро: {
	>> код := Файл нав: ['/tmp/eval.ctr'].
	код навис: (худ матн + ['.']).
	Барнома истифода: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Феҳрист ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q матн.
Баромад навис: x, сатри-нав.
>> y := Ҳеҷ.
(['y := '] + x ) evaluate.
Баромад навис: y ? 0, сатри-нав.

q := Луғат гузор: ['\[''] калид: ['\['quote\']'].
x := q матн.
Баромад навис: x, сатри-нав.
y := Ҳеҷ.
(['y := '] + x ) evaluate.

>> q := (Луғат нав) гузор:['\[''] калид:['\['quote\[''].
Баромад навис: y ? ['\['quote\']'], сатри-нав.
