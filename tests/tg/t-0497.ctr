Server init.

# write a test file
>> f := Файл нав: ['/tmp/test.gif'].
f навис: ['GIF87a01234567810'].

# serve the file
Server гузарон: ['test.gif'] префикс: ['/tmp/'].

Баромад сатри-нав.

Баромад навис: ['Outside container (security):'], сатри-нав.
{ Server гузарон: ['../passwd'] префикс: ['/tmp/']. }
дошта-гир: { :e Баромад навис: e, сатри-нав. },
оғоз.

Баромад навис: ['Invalid prefix:'], сатри-нав.
{ Server гузарон: ['test.gif'] префикс: ['z:\\']. }
дошта-гир: { :e Баромад навис: e, сатри-нав. },
оғоз.

Баромад навис: ['Non-existant file:'], сатри-нав.
{ Server гузарон: ['xxx.xxx'] префикс: ['/tmp/']. }
дошта-гир: { :e Баромад навис: e, сатри-нав. },
оғоз.
