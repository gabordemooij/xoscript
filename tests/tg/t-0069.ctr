

Матн ҳангоми: ['html'] иҷро: { <- (
		худ
		иваз: ['&'] бо: ['&amp;'],
		иваз: ['<'] бо: ['&lt;'],
		иваз: ['>'] бо: ['&gt;'],
		иваз: ['"'] бо: ['&quot;']
	).
}.


Баромад навис: ([' left trimmed '] буриши-фосила) + [' '] + ( ['and right trimmed'] буриши-фосила) + ['!'], сатри-нав.
Баромад навис: ['<html>"html & entities"</html>'] html.
