

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Барнома идораи-хотира: 0.

>> a := Феҳрист ← ['hello'] ; ['world'] ; Рост ; Ҳеҷ ; 666.
a оғози-занҷир охиринро-гир якумро-гир ба-аввал-илова: ['hi'], ба-охир-илова: 999, анҷоми-занҷир.
Баромад навис: ( a пайваст: [','] ), сатри-нав.

Барнома тозакунӣ.
usedMemory1 := (Барнома хотира ? 0).


a := Феҳрист ← ['hello'] ; ['world'] ; Рост ; Ҳеҷ ; 666.
a охиринро-гир. a якумро-гир. a ба-аввал-илова: ['hi'], ба-охир-илова: 999.
Баромад навис: ( a пайваст: [','] ), сатри-нав.


Барнома тозакунӣ.
usedMemory2 := (Барнома хотира ? 0).


a := Феҳрист ← ['hello'] ; ['world'] ; Рост ; Ҳеҷ ; 666.
a оғози-занҷир охиринро-гир якумро-гир ба-аввал-илова: ['hi'], ба-охир-илова: 999, анҷоми-занҷир.
Баромад навис: ( a пайваст: [','] ), сатри-нав.


Барнома тозакунӣ.
usedMemory3 := (Барнома хотира ? 0).



( usedMemory1 = usedMemory2 ва: usedMemory1 = usedMemory3, ва: usedMemory2 = usedMemory3 ) агар-рост: {
	Баромад навис: ['No memory leaks here'].
}, агар-дурӯғ: {
	Баромад навис: ['Leaking memory...'].
}.
