>> Combination := Феҳрист нав.

Combination ҳангоми: ['ба-охир-илова:'] иҷро: { :el
	худ 
	ёфтан: el, Ҳеҷ? агар-рост: { худ ба-охир-илова: el. }.
}.

>> colours := Combination нав.
colours
	ба-охир-илова: ['red'],
	ба-охир-илова: ['green'],
	ба-охир-илова: ['blue'],
	ба-охир-илова: ['red'].

Баромад навис: colours, сатри-нав.
