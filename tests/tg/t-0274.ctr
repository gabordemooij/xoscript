

Феҳрист ҳангоми: ['column:'] иҷро: { :column
	>> result := Феҳрист нав.
	худ ҳар-як: { :index :row
		row ҳар-як: { :index :cell
			(index = column) агар-рост: { result ба-охир-илова: cell. }.
		}.
	}. <- result.
}.


>> a := Феҳрист ←
	(Феҳрист ← 1 ; 2 ; 3) ;
	(Феҳрист ← 4 ; 5 ; 6) ;
	(Феҳрист ← 7 ; 8 ; 9).

>> b := a column: 1.
Баромад навис: b, сатри-нав.

b := a column: 20.
Баромад навис: b, сатри-нав.

b := a column: -100.
Баромад навис: b, сатри-нав.
