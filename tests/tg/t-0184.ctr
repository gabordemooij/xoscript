

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Барнома идораи-хотира: 0.

Адад ҳангоми: ['addNum:'] иҷро: { :x
	худ ҷамъ: x.
}.

Адад ҳангоми: ['subtractNum:'] иҷро: { :x
	худ тарҳ: x.
}.

Адад ҳангоми: ['multiplyBy:'] иҷро: { :x
	худ зарб: x.
}.

Адад ҳангоми: ['divideBy:'] иҷро: { :x
	худ тақсим-ба: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 дараҷа: 8).  
a := a + (2 дараҷа: -1). 
a := a + (49 решаи-квадратӣ).   
a addNum: ((Феҳрист ← 0 ; 1) бештарин).          
a addNum: ((Феҳрист ← 2 ; 3) камтарин).
Баромад навис: a.

Барнома тозакунӣ.

usedMemory1 := (Барнома хотира ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 дараҷа: 8).  
a := a + (2 дараҷа: -1). 
a := a + (49 решаи-квадратӣ).   
a addNum: ((Феҳрист ← 0 ; 1) бештарин).          
a addNum: ((Феҳрист ← 2 ; 3) камтарин).
Баромад навис: a.

Барнома тозакунӣ.
usedMemory2 := (Барнома хотира ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 дараҷа: 8).  
a := a + (2 дараҷа: -1). 
a := a + (49 решаи-квадратӣ).   
a addNum: ((Феҳрист ← 0 ; 1) бештарин).          
a addNum: ((Феҳрист ← 2 ; 3) камтарин).
Баромад навис: a.

Барнома тозакунӣ.
usedMemory3 := (Барнома хотира ? 0).



( usedMemory1 = usedMemory2 ва: usedMemory1 = usedMemory3, ва: usedMemory2 = usedMemory3 ) агар-рост: {
	Баромад навис: ['No memory leaks here'].
}, агар-дурӯғ: {
	Баромад навис: ['Leaking memory...'].
}.
