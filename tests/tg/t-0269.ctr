#Linux

(Файл нав: ['/tmp/testje']) мавҷуд агар-дурӯғ: {
	Барнома система: ['mkdir /tmp/testje'].	
}.

(Файл нав: ['/tmp/testje/file1']) мавҷуд агар-дурӯғ: {
	Барнома система: ['touch /tmp/testje/file1'].	
}.

(Файл нав: ['/tmp/testje/folder1']) мавҷуд агар-дурӯғ: {
	Барнома система: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Файл рӯйхат: ['/tmp/testje'].

>> q := Феҳрист нав.

l ҳар-як: { :k :v v ҳар-як: { :x :y q ба-охир-илова: y. }. }.

>> s := q матн.

(s дар-бар-дорад: ['file1']) агар-рост:   { Баромад навис: ['OK'], сатри-нав. }.
(s дар-бар-дорад: ['file2']) агар-рост:   { Баромад навис: ['XX'], сатри-нав. }.
(s дар-бар-дорад: ['folder1']) агар-рост: { Баромад навис: ['OK'], сатри-нав. }.
