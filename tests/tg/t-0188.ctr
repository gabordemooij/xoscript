

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Барнома идораи-хотира: 0.

{ :i Баромад навис: i. } × 4.
Баромад сатри-нав.
{ :i Баромад навис: (4 - i). } × 4.
Баромад сатри-нав.
( 1 > 2 ) агар-дурӯғ: { Баромад навис: ['BLOCK 1'], сатри-нав. }.
( 2 > 1 ) агар-рост:  { Баромад навис: ['BLOCK 2'], сатри-нав. }.

>> i := 0.
{ Баромад навис: i. i ҷамъ: 1. } то-даме: { <- ( i < 3). }.
Баромад сатри-нав.

i := 3.
{ Баромад навис: i. i := i - 1. } то-даме: { <- ( i > 0). }.
Баромад сатри-нав.


Барнома тозакунӣ.

usedMemory1 := (Барнома хотира ? 0).


{ :i  Баромад навис: i. } × 4.
Баромад сатри-нав.
{ :i  Баромад навис: (4 - i). } × 4.
Баромад сатри-нав.
( 1 > 2 ) агар-дурӯғ: { Баромад навис: ['BLOCK 1'], сатри-нав. }.
( 2 > 1 ) агар-рост:  { Баромад навис: ['BLOCK 2'], сатри-нав. }.

>> i := 0.
{ Баромад навис: i. i ҷамъ: 1. } то-даме: { <- ( i < 3). }.
Баромад сатри-нав.

i := 3.
{ Баромад навис: i. i := i - 1. } то-даме: { <- ( i > 0). }.
Баромад сатри-нав.



Барнома тозакунӣ.
usedMemory2 := (Барнома хотира ? 0).


{ :i Баромад навис: i. } × 4.
Баромад сатри-нав.
{ :i Баромад навис: (4 - i). } × 4.
Баромад сатри-нав.
( 1 > 2 ) агар-дурӯғ: { Баромад навис: ['BLOCK 1'], сатри-нав. }.
( 2 > 1 ) агар-рост:  { Баромад навис: ['BLOCK 2'], сатри-нав. }.

>> i := 0.
{ Баромад навис: i. i ҷамъ: 1. } то-даме: { <- ( i < 3). }.
Баромад сатри-нав.

i := 3.
{ Баромад навис: i. i := i - 1. } то-даме: { <- ( i > 0). }.
Баромад сатри-нав.

Барнома тозакунӣ.
usedMemory3 := (Барнома хотира ? 0).



( usedMemory1 = usedMemory2 ва: usedMemory1 = usedMemory3, ва: usedMemory2 = usedMemory3 ) агар-рост: {
	Баромад навис: ['No memory leaks here'].
}, агар-дурӯғ: {
	Баромад навис: ['Leaking memory...'].
}.
