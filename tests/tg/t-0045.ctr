Барнома идораи-хотира: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } дошта-гир: {
		oops ҷамъ: 1.
	}, оғоз.
} × 1000.

{
	Баромад навис: ['hi there!'].
	ин-вазифа хато: ['oops'].
	Баромад навис: ['hi there!'].
	{ Баромад навис: ['dont print this']. } оғоз.
} дошта-гир: { :e 
