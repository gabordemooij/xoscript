# test list operations


>> cakes := Феҳрист ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes иваз: 1 дарозӣ: 2 бо: ( Феҳрист ← ['cinnamon'] ; ['pineapple'] ).
Баромад навис: (buy пайваст: [',']), сатри-нав.


>> buy := cakes иваз: 1 дарозӣ: 12 бо: ( Феҳрист ← ['cinnamon'] ; ['pineapple'] ).
Баромад навис: (buy пайваст: [',']), сатри-нав.


>> buy := cakes иваз: 2 дарозӣ: 10 бо: ( Феҳрист нав ).
Баромад навис: (buy пайваст: [',']), сатри-нав.


>> buy := cakes иваз: 0 дарозӣ: 1 бо: ( Феҳрист нав ).
Баромад навис: (buy пайваст: [',']), сатри-нав.


>> buy := cakes иваз: ['0'] дарозӣ: ['1'] бо: ['x'].
Баромад навис: (buy пайваст: [',']), сатри-нав.
