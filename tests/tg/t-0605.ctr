>> invoice := Объект нав.
invoice ҳангоми: ['оғоз'] иҷро: {
        худӣ адад := 0.
}.

invoice ҳангоми: ['адад'] иҷро: {
        худӣ адад ҷамъ: 1. <- худӣ адад нусха.
}.

>> year-invoice := invoice нав.
year-invoice ҳангоми: ['start:'] иҷро: { :сол
	худӣ адад := сол.
}.

year-invoice start: 202000.
Баромад навис: year-invoice адад, сатри-нав.
Баромад навис: year-invoice адад, сатри-нав.
