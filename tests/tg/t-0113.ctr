Баромад навис: ['Continue for-loop, No - before 6 and up.'], сатри-нав.
{ :i
	Баромад навис: (i + 1), сатри-нав.
	((i + 1) > 4) идома.
	Баромад навис: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Баромад сатри-нав.
Баромад навис: ['Continue while-true, No --> before 5 and up.'], сатри-нав.
{
	Баромад навис: ['iteration #'] + x, сатри-нав.
	x ҷамъ: 1.
	((x < 5) баръакс) идома.
	Баромад навис: ['-->'].
} то-даме: xIsLessThan10.
Баромад сатри-нав.
Баромад навис: ['Continue while-false, No - before 3 only.'], сатри-нав.
{
	Баромад навис: ['iteration #'] + x, сатри-нав.
	x тарҳ: 1.
	(x = 3) идома.
	Баромад навис: ['-'].
} то-даме: { <- ( x > 0). }.

Баромад сатри-нав.
Баромад навис: ['Continue times-loop, No ||| before 3.'], сатри-нав.
{ :i
	Баромад навис: ['iteration #'] + i, сатри-нав.
	(i = 2) идома.
	Баромад навис: ['|||'].
} × 5.

Баромад сатри-нав.

{ Рост идома. Баромад навис: ['dont write this!'], сатри-нав. } оғоз.

{ Рост идома. Баромад навис: ['dont write this!'], сатри-нав. } дошта-гир: { Баромад навис: ['Dont catch this!']. }, оғоз.

Баромад навис: ['Test Array each-loop: 0, ... ,2'], сатри-нав.
(Феҳрист ← 1 ; 2 ; 3) табдил: { :i
	(i = 1) идома.
	Баромад навис: ['iteration #'] + (i - 0), сатри-нав.
}.

Баромад навис: ['Test Map each-loop: c only'], сатри-нав.
>> m := Луғат нав.
m гузор: ['first'] калид: ['a'], гузор: ['second'] калид: ['b'], гузор: ['third'] калид: ['c'].
m ҳар-як: { :k :v
	(k ≠ ['c']) идома.
	Баромад навис: ['iteration'] + k + v, сатри-нав.
}.

