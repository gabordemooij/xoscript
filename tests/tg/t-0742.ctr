Баромад навис: ['Test object'], сатри-нав.
>> a := Объект нав. 

a ҳангоми: ['item:'] иҷро: { :hexhelper
	худӣ hexhelper := hexhelper. 
}.

a ҳангоми: ['item'] иҷро: { <- худӣ hexhelper.
}.

a item: Hx нав.

>> old-hexhelper-address := a item прототип суроғаи-хотира.
a save-as: ['/tmp/a.bin'].
Баромад навис: ['========== RELOADING SNAP:'], сатри-нав.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип суроғаи-хотира = old-hexhelper-address) агар-рост: {
	Баромад навис: ['Object link re-attached.'], сатри-нав.
}.
