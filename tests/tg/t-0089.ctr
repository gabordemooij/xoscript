>> randomizer := { :a :b
	>> камтарин := ( a < b ) ин: a ё-он: b.
	>> бештарин := ( a > b ) ин: a ё-он: b.
	>> x := Ҳеҷ.
	{
		x := Адад байни: a то: b.
		((x < камтарин) ё: (x > бештарин)) агар-рост: { 
			Баромад навис: (['Invalid value!']).
			Барнома анҷом.
		}.
	} 
	× 100. <- x.
}.
randomizer татбиқ: 0 ва: 0.
randomizer татбиқ: 1 ва: 0.
randomizer татбиқ: 1 ва: 1.
randomizer татбиқ: 0 ва: 1.
randomizer татбиқ: -1 ва: 0.
randomizer татбиқ: -1 ва: -1.
randomizer татбиқ: 0 ва: -1.
