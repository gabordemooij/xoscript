Адад ҳангоми: ['factorial'] иҷро: {
	>> total := 1.
	{ :index total зарб: (худ - index). } × худ. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Барнома идораи-хотира: 0.

{
2 exponent factorial.
Баромад навис: (11 бақия: 3), сатри-нав.
Баромад навис: (3.4 яклухт), сатри-нав.
Баромад навис: (7.1 ба-боло-яклухт), сатри-нав.
Баромад навис: (7.9 ба-поён-яклухт), сатри-нав.
}
оғоз.

Барнома тозакунӣ.

usedMemory1 := (Барнома хотира ? 0).

{
2 exponent factorial.
Баромад навис: (11 бақия: 3), сатри-нав.
Баромад навис: (3.4 яклухт), сатри-нав.
Баромад навис: (7.1 ба-боло-яклухт), сатри-нав.
Баромад навис: (7.9 ба-поён-яклухт), сатри-нав.
}
оғоз.

Барнома тозакунӣ.
usedMemory2 := (Барнома хотира ? 0).


{
2 exponent factorial.
Баромад навис: (11 бақия: 3), сатри-нав.
Баромад навис: (3.4 яклухт), сатри-нав.
Баромад навис: (7.1 ба-боло-яклухт), сатри-нав.
Баромад навис: (7.9 ба-поён-яклухт), сатри-нав.
} оғоз.

Барнома тозакунӣ.
usedMemory3 := (Барнома хотира ? 0).



( usedMemory1 = usedMemory2 ва: usedMemory1 = usedMemory3, ва: usedMemory2 = usedMemory3 ) агар-рост: {
	Баромад навис: ['No memory leaks here'].
}, агар-дурӯғ: {
	Баромад навис: ['Leaking memory...'].
}.
