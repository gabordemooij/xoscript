# compliance test

# use international numbers

Баромад навис: ['1000 -> '].
Баромад навис: 1000, сатри-нав. #1000

Баромад навис: ['1.5 -> '].
Баромад навис: 1.5, сатри-нав.  #1.5

Баромад навис: ['1001.5 -> '].
Баромад навис: 1.5 + 1000, сатри-нав. #1001.5

# use 0-indexed arrays
>> x := Феҳрист нав ; 1 ; 2 ; 3.
>> y := Феҳрист нав ; ['a'] ; ['b'] ; ['c'].

Баромад навис: ['1 -> '].
Баромад навис: x ? 0, сатри-нав. #1

Баромад навис: ['1 -> '].
Баромад навис: (x дар: 0), сатри-нав. #1

Баромад навис: ['1 -> '].
Баромад навис: x якум, сатри-нав. #1

Баромад навис: ['3 -> '].
Баромад навис: x охирин, сатри-нав. #3

Баромад навис: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Баромад навис: (x аз-рӯи: y), сатри-нав.

Баромад навис: ['1 -> '].
Баромад навис: (x оғоз: 0 дарозӣ: 1) якум, сатри-нав. #1

Баромад навис: ['0 -> '].
Баромад навис: (x ёфтан: 1), сатри-нав. #0

x гузор: 9 калид: 0.

Баромад навис: ['9 -> '].
Баромад навис: (x дар: 0), сатри-нав. #9

x ба-аввал-илова: 8.
Баромад навис: ['8 -> '].
Баромад навис: (x дар: 0), сатри-нав. #9


x ба-охир-илова: 10.
Баромад навис: ['10 -> '].
Баромад навис: (x дар: 4), сатри-нав. #10








