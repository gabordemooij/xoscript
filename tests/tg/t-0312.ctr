>> Slurp := Объект нав.
Slurp ҳангоми: ['нав'] иҷро: {
	худӣ str := [''].
}.
Slurp омӯз: ['nieuw'] маъно: ['нав'].
Slurp ҳангоми: ['ҷавоб:'] иҷро: { :blah
		(худӣ str ≠ ['']) агар-рост: {
			худӣ str ба-охир-илова: [' '].
		}.
		худӣ str ба-охир-илова: blah.
}.
Slurp ҳангоми: ['ҷавоб:ва:'] иҷро: { :blah :blahah
		(худӣ str ≠ ['']) агар-рост: {
			худӣ str ба-охир-илова: [' '].
		}.
		(blah дарозӣ > 1) агар-рост: {
			худӣ str ба-охир-илова: (blah оғоз: 0 дарозӣ: (blah дарозӣ - 1)).
		}, вагарна: {
			худӣ str ба-охир-илова: blah.
		}.
		худӣ str ба-охир-илова: [' '].
		худӣ str ба-охир-илова: blahah.
}.
Slurp ҳангоми: ['obtain'] иҷро: {
	>> buffer := худӣ str.
	худӣ str := ['']. <- buffer.
}.


>> параметрҳои-ҷустуҷӯ := Slurp нав
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

Баромад навис: параметрҳои-ҷустуҷӯ obtain, сатри-нав.
