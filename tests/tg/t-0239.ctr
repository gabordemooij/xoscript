Феҳрист ҳангоми: ['sum'] иҷро: {
	>> total := 0.
	худ ҳар-як: { :index :element
		total ҷамъ: element.
	}. <- total.
}.

>> a := Рост.



a ҳангоми: ['матн'] иҷро: {
	>> answer := Ҳеҷ.
	( худ = Рост ) агар-рост: {
		answer := ['Yep'].
	}, вагарна: {
		answer := ['Nope'].
	}. <- answer.
}.

a ҳангоми: ['адад'] иҷро: {
	>> answer := Ҳеҷ.
	( худ = Рост ) агар-рост: {
		answer := 10.
	}, вагарна: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b ҳангоми: ['матн'] иҷро: { <- ['Devil'].
}.

b ҳангоми: ['мантиқӣ'] иҷро: { <- Дурӯғ.
}.


Баромад навис: a, сатри-нав.  
Баромад навис: (90 + a), сатри-нав. 
Баромад навис: b, сатри-нав. 
Баромад навис: (Рост ва: b), сатри-нав.

a := Феҳрист ← ['hello'] ; ['world'] ; Рост ; Ҳеҷ ; 666. 
a := a + ( Феҳрист ← 1 ).
Баромад навис: a, сатри-нав.
Баромад навис: ((Луғат нав) гузор: Ҳеҷ калид: Ҳеҷ), сатри-нав.
Баромад навис: a sum, сатри-нав. 


{
	a ҳангоми: ['матн'] иҷро: { <- Ҳеҷ. }.
	a := [''] + a.
} дошта-гир: { :error
	Баромад навис: ['Error noted: '] + error, сатри-нав.
}, оғоз.



{
	a ҳангоми: ['адад'] иҷро: { <- Ҳеҷ. }.
	a := 3 × a.
} дошта-гир: { :error
	Баромад навис: ['Error noted: '] + error, сатри-нав.
}, оғоз.


{
	a ҳангоми: ['мантиқӣ'] иҷро: { <- Ҳеҷ. }.
	a := Рост ва: a. 
} дошта-гир: { :error
	Баромад навис: ['Error noted: '] + error, сатри-нав.
}, оғоз.





