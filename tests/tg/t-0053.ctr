60 × {
	>> x := (Адад random % 6) + 1.
	(x ≤ 6) агар-дурӯғ: { Баромад навис: ['FAIL']. }.
	(x ≥0) агар-дурӯғ: { Баромад навис: ['FAIL']. }.
	x := (Адад random % 3) + 1.
	(x < 3) агар-дурӯғ: { Баромад навис: ['FAIL']. }.
	(x>-1) агар-дурӯғ: { Баромад навис: ['FAIL']. }.
	x := ((Мантиқӣ flip) адад).
	(x = 0 ё: x = 1) агар-дурӯғ: { Баромад навис: ['FAIL']. }.
	x := ((Рост flip) адад).
	(x = 0 ё: x = 1) агар-дурӯғ: { Баромад навис: ['FAIL']. }.
	x := (Мантиқӣ flip ин: ['HEAD'] ё-он: ['TAIL']).
	((x = ['HEAD']) ё: (x = ['TAIL'])) агар-дурӯғ: { Баромад навис: ['FAIL']. }.
}.
Баромад навис: ['DONE'].

