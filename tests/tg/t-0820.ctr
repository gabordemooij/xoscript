# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Қолаб нав: pattern.
	p мувофиқат: subject иҷро: { :m :g
		Баромад навис: g шумора, навис: [' '], навис: (g пайваст: ['|']), сатри-нав. <- m.
	}.
}.
show татбиқ: ['(a)|(b)'] ва: ['b'].
show татбиқ: ['(a)|(b)'] ва: ['a'].
show татбиқ: ['(x)?y'] ва: ['y'].
show татбиқ: ['(x)?(y)(z)?'] ва: ['xy'].
