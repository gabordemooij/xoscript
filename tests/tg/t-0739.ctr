Баромад навис: ['Test object'], сатри-нав.
>> a := Объект нав. 

a ҳангоми: ['item:'] иҷро: { :binhelper
	худӣ binhelper := binhelper. 
}.

a ҳангоми: ['item'] иҷро: { <- худӣ binhelper.
}.

a item: Bin нав.

>> old-binhelper-address := a item прототип суроғаи-хотира.
a save-as: ['/tmp/a.bin'].
Баромад навис: ['========== RELOADING SNAP:'], сатри-нав.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип суроғаи-хотира = old-binhelper-address) агар-рост: {
	Баромад навис: ['Object link re-attached.'], сатри-нав.
}.


