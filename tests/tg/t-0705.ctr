

>> obj := Объект нав.

obj ҳангоми: ['greet'] иҷро: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj ҳангоми: ['task'] иҷро: {
	худӣ property := 123.
	{
		# try binds self/own to object instead of block
		Баромад навис: худ greet.
		Баромад навис: худӣ property.
		1 / 0.
	} дошта-гир: {
		Баромад навис: худ greet.
		Баромад навис: худӣ property.
		Баромад навис: ['ok'].
	}, кӯшиш.
}.

obj task.