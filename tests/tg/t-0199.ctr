
Барнома идораи-хотира: 4.

>> Animal := Объект нав.
Animal ҳангоми: ['make'] иҷро: {
	>> animal := Объект нав.
	animal ҳангоми: ['makeSound'] иҷро: {
		Баромад навис: худӣ sound.
	}. <- animal.
}.
>> Cat := Объект нав.
Cat ҳангоми: ['make'] иҷро: {
	>> cat := Animal make.
	cat ҳангоми: ['init'] иҷро: {
		худӣ sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
