#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Қолаб нав: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern мувофиқат: subject иҷро: { :m :x
	Баромад навис: m, сатри-нав.
	Баромад навис: x, сатри-нав. <- ['XXX'].
}.
Баромад навис: result, сатри-нав.