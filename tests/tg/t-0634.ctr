# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Барнома shell-escape: ['abc'].
Баромад навис: c, сатри-нав.
Баромад навис: ( Барнома система: ['echo '] + c ), сатри-нав.

c := Барнома shell-escape: ['a'b'c'].
Баромад навис: c, сатри-нав.
Баромад навис: ( Барнома система: ['echo '] + c ), сатри-нав.

c := Барнома shell-escape: ['a\'c'].
Баромад навис: c, сатри-нав.
Баромад навис: ( Барнома система: ['echo '] + c ), сатри-нав.