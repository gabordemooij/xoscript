# test qualifiers

>> $ := Объект нав.

$ ҳангоми: ['ҷавоб:'] иҷро: { :x
	
	>> operation := x аломат: 0.
	>> valuta := x аломат: 1.
	>> money := x гузариш: 2.
	
	>> amount := 0.

	( operation = ['+'] ) агар-рост: {
		( valuta = ['£'] ) агар-рост: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Баромад навис: x, сатри-нав.


>> Fruit := Объект нав.

Fruit ҳангоми: ['нав'] иҷро: {
	>> f := худ нав.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit ҳангоми: ['apples:'] иҷро: { :a худӣ apples := a. }.
Fruit ҳангоми: ['oranges:'] иҷро: { :p худӣ oranges := p. }.
Fruit ҳангоми: ['apples'] иҷро: { <- худӣ apples. }.
Fruit ҳангоми: ['oranges'] иҷро: { <- худӣ oranges. }.

Fruit ҳангоми: ['+'] иҷро: { :f
	
	>> n := Fruit нав.
	f ҷамъ: 1.
	
	n apples: (f apples + худӣ apples).
	n oranges:  (f oranges  + худӣ oranges). <- n.
}.

Fruit ҳангоми: ['матн'] иҷро: { <- ( худӣ apples матн + [' apples and '] + худӣ oranges + [' oranges'] ).
}.

Адад ҳангоми: ['apples'] иҷро: { <- ((Fruit нав) apples: худ).
}.

Адад ҳангоми: ['apple'] иҷро: { <- ((Fruit нав) apples: худ).
}.

Адад ҳангоми: ['oranges'] иҷро: { <- ((Fruit нав) oranges: худ).
}.




Баромад навис: (1 apple + 3 oranges + 4 apples), сатри-нав.


Матн ҳангоми: ['twice'] иҷро: { <- ((худ матн) + (худ матн)).
}.



Баромад навис: ['❤❤❤'] twice.



