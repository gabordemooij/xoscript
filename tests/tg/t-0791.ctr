Server init.

>> DB := Maria-DB нав мизбон: ['localhost'],
	номи-корбар: ['xo'],
	парол: ['pass123'],
	номи-пойгоҳ: ['xobase'],
	пайваст-шав.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> параметрҳои-ҷустуҷӯ := Maria-Дархост нав: SQL.

# set database
параметрҳои-ҷустуҷӯ пойгоҳи-додаҳо: DB.

параметрҳои-ҷустуҷӯ гирифтан: { :row
	Баромад навис: row world, сатри-нав.
}.
