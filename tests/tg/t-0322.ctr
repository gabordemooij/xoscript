

>> Matryoshka := Объект нав.
Matryoshka ҳангоми: ['double:'] иҷро: { :secret
	худӣ secret := secret × 2.
}.
Matryoshka ҳангоми: ['нав:'] иҷро: { :secret
	>> answer := Ҳеҷ.
	>> t := (secret > 255).
	Баромад навис: (secret + [' | '] + t), сатри-нав.
	t агар-рост: {
		answer := secret.
	}, вагарна: {
		answer := Matryoshka рекурсивӣ нав: (худ double: secret).
	}. <- answer.
}.

>> x := Matryoshka нав: 2.
