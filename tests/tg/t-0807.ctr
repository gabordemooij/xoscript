# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB нав мизбон: ['localhost'],
	номи-корбар: ['xo'],
	парол: ['pass123'],
	номи-пойгоҳ: ['xobase'],
	пайваст-шав.

>> параметрҳои-ҷустуҷӯ := db дархост: ['SELECT %% FROM'].
{ параметрҳои-ҷустуҷӯ иҷро-кун. } дошта-гир: { :e
	Баромад навис: ( e дар-бар-дорад: ['%%'] ), сатри-нав.
}, оғоз.
