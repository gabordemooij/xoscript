# catch-all test (practical)
>> HTML := Матн нав.
HTML ҳангоми: ['encode:'] иҷро: { :tekst
	худ ба-охир-илова: (tekst
	иваз: ['&'] бо: ['&amp;'], 
	иваз: ['<'] бо: ['&lt;'],
	иваз: ['>'] бо: ['&gt;'],
	иваз: ['"'] бо: ['&quot;']).
}.
>> blog := HTML нав.
blog ба-охир-илова: ['<h1>'],
     encode: ['Koffie & Thee'],
     ба-охир-илова: ['</h1>'].
Баромад навис: blog, сатри-нав.


>> Roman := Адад нав.
Roman ҳангоми: ['stringy'] иҷро: {
	>> a := [''].
	{ a ба-охир-илова: ['I']. } × худ. <- a.
}.

>> x := Roman нав.
x ҷамъ: 3.
Баромад навис: x stringy, сатри-нав.

>> Quantum := Мантиқӣ нав.
Quantum ҳангоми: ['true?'] иҷро: { <- ['maybe True']. }.
Баромад навис: (Quantum нав true?), сатри-нав.

>> Nihil := Ҳеҷ нав.
Nihil ҳангоми: ['матн'] иҷро: { <- ['Nihil']. }.
Баромад навис: (Nihil нав), сатри-нав.
