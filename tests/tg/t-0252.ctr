#Linux
>> clock := Лаҳза нав.
clock минтақаи-вақт: ['UTC-1'].
clock сол: 1981, моҳ: 1, рӯз: 5,
      соат: 13, дақиқа: 15, сония: 13.

Баромад навис: clock, сатри-нав.
clock минтақаи-вақт: ['UTC+0'].

Баромад навис: (
	(clock сол одӣ) + ['-'] + (clock моҳ) + ['-'] + (clock рӯз) + [' '] +
	(clock соат) + [':'] + (clock дақиқа) + [':'] + (clock сония) + [' '] +
	['W'] + (clock ҳафта) + (clock минтақаи-вақт)
), сатри-нав.


clock минтақаи-вақт: ['UTC-1'].
Баромад навис: (
	(clock сол одӣ) + ['-'] + (clock моҳ) + ['-'] + (clock рӯз) + [' '] +
	(clock соат) + [':'] + (clock дақиқа) + [':'] + (clock сония) + [' '] +
	['W'] + (clock ҳафта) + (clock минтақаи-вақт)
), сатри-нав.
