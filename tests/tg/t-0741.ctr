Баромад навис: ['Test object'], сатри-нав.
>> a := Объект нав. 

a ҳангоми: ['item:'] иҷро: { :octhelper
	худӣ octhelper := octhelper. 
}.

a ҳангоми: ['item'] иҷро: { <- худӣ octhelper.
}.

a item: Oct нав.

>> old-octhelper-address := a item прототип суроғаи-хотира.
a save-as: ['/tmp/a.bin'].
Баромад навис: ['========== RELOADING SNAP:'], сатри-нав.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип суроғаи-хотира = old-octhelper-address) агар-рост: {
	Баромад навис: ['Object link re-attached.'], сатри-нав.
}.
