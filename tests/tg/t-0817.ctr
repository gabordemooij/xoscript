# a value ending in the first part of an opening quote must survive serialization
>> қиматҳо := Феҳрист нав
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

қиматҳо ҳар-як: { :i :value
	>> d := Луғат нав.
	d гузор: value калид: ['k'].
	d гузор: ['second'] калид: ['j'].
	>> r := d код объект.
	Баромад навис: r шумора, сатри-нав.
	Баромад навис: ( (r дар: ['k']) = value ), сатри-нав.
}.
