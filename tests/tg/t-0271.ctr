
Барнома идораи-хотира: 1.
Барнома хотира: 16000000.
>> tokens := ['{}↲.:,x() '].
{ :i
	>> код := [''].
	>> x := Адад байни: 1 то: 10.
	{
		>> y := Адад байни: 1 то: (tokens дарозӣ).
		код ба-охир-илова: (tokens аломат: y).
	} × x.
	{ Функсия нав: код. } дошта-гир: { ['Empty']. }, оғоз.

} × 10000.
Баромад навис: ['OK'], сатри-нав.
