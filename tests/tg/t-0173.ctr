

Феҳрист ҳангоми: ['sum'] иҷро: {
	>> total := 0.
	худ ҳар-як: { :index :element
		total ҷамъ: element.
	}. <- total.
}.

Феҳрист ҳангоми: ['product'] иҷро: {
	>> total := 1.
	худ ҳар-як: { :index :element
		total зарб: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Барнома идораи-хотира: 0.

{

>> a := Феҳрист ← ['hello'] ; ['world'] ; Рост ; Ҳеҷ ; 666.
a := a + ( Феҳрист ← 1 ).
Баромад навис: ( ['sum: '] + ( a sum ) ), сатри-нав.
Баромад навис: ( ['min: '] + ( a камтарин ) ), сатри-нав.
Баромад навис: ( ['max: '] + ( a бештарин ) ), сатри-нав.
Баромад навис: ( ['3rd: '] + ( a ? 2 ) ), сатри-нав.
Баромад навис: ( ['prd: '] + ( a product ) ), сатри-нав.
a мураттаб: { :a :b <- (b - a). }.
a ҳар-як: { :i :e Баромад навис: ( i - 0 ), сатри-нав. }.

} оғоз.

Барнома тозакунӣ.
usedMemory1 := (Барнома хотира ? 0).


{

>> a := Феҳрист ← ['hello'] ; ['world'] ; Рост ; Ҳеҷ ; 666.
a := a + ( Феҳрист ← 1 ).
Баромад навис: ( ['sum: '] + ( a sum ) ), сатри-нав.
Баромад навис: ( ['min: '] + ( a камтарин ) ), сатри-нав.
Баромад навис: ( ['max: '] + ( a бештарин ) ), сатри-нав.
Баромад навис: ( ['3rd: '] + ( a ? 2 ) ), сатри-нав.
Баромад навис: ( ['prd: '] + ( a product ) ), сатри-нав.
a мураттаб: { :a :b <- (b - a). }.
a ҳар-як: { :i :e Баромад навис: ( i - 0 ), сатри-нав. }.

} оғоз.



Барнома тозакунӣ.
usedMemory2 := (Барнома хотира ? 0).


{

>> a := Феҳрист ← ['hello'] ; ['world'] ; Рост ; Ҳеҷ ; 666.
a := a + ( Феҳрист ← 1 ).
Баромад навис: ( ['sum: '] + ( a sum ) ), сатри-нав.
Баромад навис: ( ['min: '] + ( a камтарин ) ), сатри-нав.
Баромад навис: ( ['max: '] + ( a бештарин ) ), сатри-нав.
Баромад навис: ( ['3rd: '] + ( a ? 2 ) ), сатри-нав.
Баромад навис: ( ['prd: '] + ( a product ) ), сатри-нав.
a мураттаб: { :a :b <- (b - a). }.
a ҳар-як: { :i :e Баромад навис: ( i - 0 ), сатри-нав. }.

} оғоз.



Барнома тозакунӣ.
usedMemory3 := (Барнома хотира ? 0).

( usedMemory1 = usedMemory2 ва: usedMemory1 = usedMemory3, ва: usedMemory2 = usedMemory3 ) агар-рост: {
	Баромад навис: ['No memory leaks here'].
}, агар-дурӯғ: {
	Баромад навис: ['Leaking memory...'].
}.
