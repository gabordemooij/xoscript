>> HTML := Объект нав.
HTML ҳангоми: ['ҷавоб:'] иҷро: { :tag 
	Баромад навис: (['<tag>'] tag: tag), сатри-нав.
}.
HTML ҳангоми: ['ҷавоб:ва:'] иҷро: { :tag :html 
	Баромад навис: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), сатри-нав.
}.
>> html := HTML нав.
html body h1: ['header'].

