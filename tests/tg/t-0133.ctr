


>> Deck := Феҳрист нав.
Deck ҳангоми: ['print'] иҷро: {
        >> len := худ шумора - 1.
        { :i
                >> len2 := худ шумора - 1.
                Баромад навис: ['len: '].
                Баромад навис: len, сатри-нав.
                Баромад навис: ['len2: '].
                Баромад навис: len2, сатри-нав.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
