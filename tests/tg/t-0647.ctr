Server init.
Баромад навис: ['Database time test'], сатри-нав.

>> db := Maria-DB нав мизбон: ['localhost'],
	номи-корбар: ['xo'], 
	парол: ['pass123'],
	номи-пойгоҳ: ['xobase'],
	пайваст-шав.

>> параметрҳои-ҷустуҷӯ :=
db дархост: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
гирифтан: { :row
	Баромад навис: row timetest, сатри-нав.
}.
