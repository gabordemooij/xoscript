>> To-Do := Объект нав.

To-Do ҳангоми: ['нав'] иҷро: {
	худӣ list := Феҳрист нав.
}.

To-Do ҳангоми: ['nieuw'] иҷро: {
	худӣ list := Феҳрист нав.
}.

To-Do ҳангоми: ['+'] иҷро: { :task
	худӣ list ба-охир-илова: task.
}.

To-Do ҳангоми: ['number of tasks?'] иҷро: { <-  худӣ list шумора.
}.

>> todos := 
	To-Do нав 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Баромад навис: ['You have $ tasks to do'] $ todos number of tasks?.
