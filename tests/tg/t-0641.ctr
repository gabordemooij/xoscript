# Test utf8 sanitizer
Server init.

>> utf8cases := Луғат нав
	# ASCII only
	гузор: ( Феҳрист нав ; 65 ; 65 ; 65 ; 65 ; 0 ) калид: ['AAAA'],
	# valid 2 byte sequence
	гузор: ( Феҳрист нав ; 194 ; 162 ; 0 ) калид: ['¢'],
	# Valid 3-byte UTF-8
    гузор: ( Феҳрист нав ; 226 ; 130 ; 172 ; 0 ) калид: ['€'],
	# Valid 4-byte UTF-8
    гузор: ( Феҳрист нав ; 240 ; 144 ; 141 ; 136 ; 0 ) калид: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    гузор: ( Феҳрист нав ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) калид: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    гузор: ( Феҳрист нав ; 65 ; 193 ; 129 ; 0 ) калид: ['A?'],
	# Invalid first byte (0xFF)
    гузор: ( Феҳрист нав ; 255 ; 0 ) калид: ['?'],
	# Incomplete multi-byte sequence at end
    гузор: ( Феҳрист нав ; 66 ; 226 ; 0 ) калид: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    гузор: ( Феҳрист нав ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) калид: ['A€?𐍈B'].
	 
utf8cases ҳар-як: { :key :value
	>> blob := Blob нав: value шумора, bytes: value.
	>> str := blob матн.
	(str = key) агар-рост: {
		Баромад навис: ['OK'], сатри-нав.
	}, вагарна: {
		Баромад навис: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, сатри-нав.
	}.
	blob озод.
}.
