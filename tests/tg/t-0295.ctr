
>> dictionary := (
	Луғат нав
		гузор: ['b'] калид: ['a'],
		гузор: ['a'] калид: ['b'],
		гузор: ['z'] калид: ['x'],
		гузор: ['hello'] калид: ['hallo'],
		гузор: ['human'] калид: ['human']
).

>> comparisons := Феҳрист нав.
dictionary ҳар-як: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a муқоиса: b)
	).
}.

comparisons мураттаб: { :a :b <- ( a муқоиса: b ). }.
Баромад навис: ( comparisons пайваст: ['↵'] ), сатри-нав.
comparisons пайваст: ['↵'].
