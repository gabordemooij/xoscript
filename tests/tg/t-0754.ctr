Баромад навис: ['Test object'], сатри-нав.
>> a := Объект нав. 

a ҳангоми: ['item:'] иҷро: { :out
	худӣ out := out. 
}.

a ҳангоми: ['item'] иҷро: { <- худӣ out.
}.

a ҳангоми: ['greet'] иҷро: {
	Баромад навис: ['hi from original out!'], сатри-нав.
}.

a item: Баромад.

Баромад навис: a item, сатри-нав.

>> old-out-address := a item прототип суроғаи-хотира.
a save-as: ['/tmp/a.bin'].
Баромад навис: ['========== RELOADING SNAP:'], сатри-нав.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип суроғаи-хотира = old-out-address) агар-рост: {
	Баромад навис: ['Object link re-attached.'], сатри-нав.
}.

b item навис: ['hello from loaded out!'], сатри-нав.
b greet.
