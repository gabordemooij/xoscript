



>> CoffeeGrounds := Объект нав.
CoffeeGrounds ҳангоми: ['extract'] иҷро: { <- ['coffee']. }.

>> CoffeeMachine := Объект нав.
CoffeeMachine ҳангоми: ['init'] иҷро: {
	худӣ coffeegrounds := CoffeeGrounds нав.
}.
CoffeeMachine ҳангоми: ['нав'] иҷро: { <- CoffeeMachine `new init.
}.

CoffeeMachine ҳангоми: ['makeTea'] иҷро: { <- (худӣ tealeaves extract). }.
CoffeeMachine ҳангоми: ['makeCoffee'] иҷро: { <- (худӣ coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine нав.

Баромад навис:
	coffeeDream 
	makeCoffee.

Баромад навис:
	coffeeDream 
	makeTea.
