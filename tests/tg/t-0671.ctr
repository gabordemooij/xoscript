# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Сейф сохтани-калидҳо.

# private (secret) key
>> sk := keys якум.

# public key
>> pk := keys охирин.

# sign a message
>> sig := Сейф имзо: ['abc'] бо-калид: sk.

# check message (ok)
Баромад навис: ( 
	Сейф
		санҷ: ['abc'] 
		имзо: sig 
		бо-калид: pk 
), сатри-нав.

# check message (fail)
Баромад навис: ( 
	Сейф 
		санҷ: ['abd'] 
		имзо: sig 
		бо-калид: pk 
), сатри-нав.