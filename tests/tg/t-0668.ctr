# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob нав: 8, bytes: (
	Феҳрист нав ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Баромад навис: ( utf16 рамзкушоӣ: ['utf16le'] ), сатри-нав.

utf16 озод.
>> utf32 := Blob нав: 13, bytes: (
	Феҳрист нав ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Баромад навис: ( utf32 рамзкушоӣ: ['utf32be'] ), сатри-нав.
utf32 озод.