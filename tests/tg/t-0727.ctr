Server init.
>> f := Формат нав: ['%d'].
>> a := Blob нав: 4.
a bytes: ( Феҳрист нав ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob нав: 4.
b bytes: ( Феҳрист нав ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a оғоз: 0 дарозӣ: 3, ҳар-як: { :i :byte
	Баромад навис: ( f татбиқ-ба-бутун: byte ), сатри-нав.
}.
a ^ b.
a оғоз: 0 дарозӣ: 3, ҳар-як: { :i :byte
	Баромад навис: ( f татбиқ-ба-бутун: byte ), сатри-нав.
}.
a ^ b.
a оғоз: 0 дарозӣ: 3, ҳар-як: { :i :byte
	Баромад навис: ( f татбиқ-ба-бутун: byte ), сатри-нав.
}.
a озод.
b озод.

{ a ^ Объект. } дошта-гир: { :e Баромад навис: e, сатри-нав. }, оғоз.
