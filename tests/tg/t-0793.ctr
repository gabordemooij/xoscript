Server init.

>> DB := Maria-DB нав мизбон: ['localhost'],
	номи-корбар: ['xo'],
	парол: ['pass123'],
	номи-пойгоҳ: ['xobase'],
	пайваст-шав.

{
	DB дархост:
	['DROP TABLE movies'],
	иҷро-кун.
} дошта-гир: { Ҳеҷ. }, оғоз.

DB дархост:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
иҷро-кун.

DB дархост: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
параметрҳо: ( Феҳрист нав ; ['Halloween'] ),
иҷро-кун.

DB дархост: ['SELECT * FROM movies'],
гирифтан: { :movie
	Баромад навис: movie title, сатри-нав.
}.

