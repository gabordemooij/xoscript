
Баромад навис: ['Break for-loop, 0-4.'], сатри-нав.
{ :i
	Баромад навис: ['iteration #'] + i, сатри-нав.
	(i = 4) буридан.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Баромад навис: ['Break while-true loop, 0-4.'], сатри-нав.
{
	Баромад навис: ['iteration #'] + x, сатри-нав.
	x ҷамъ: 1.
	((x < 5) баръакс) буридан.
} то-даме: xIsLessThan10.

Баромад навис: ['Break while-false loop, 5,4.'], сатри-нав.
{
	Баромад навис: ['iteration #'] + x, сатри-нав.
	x тарҳ: 1.
	(x = 3) буридан.
} то-даме: { <- (x > 0). }.

Баромад навис: ['Break times loop, 1-4.'], сатри-нав.
{ :i
	Баромад навис: ['iteration #'] + i, сатри-нав.
	(i = 4) буридан.
} × 5.

Баромад навис: ['Break block, dont print line.'], сатри-нав.
{ Рост буридан. Баромад навис: ['dont write this!'], сатри-нав. } оғоз.

Баромад навис: ['Break block, dont fire catch...'], сатри-нав.
{ Рост буридан. Баромад навис: ['dont write this!'], сатри-нав. } дошта-гир: { Баромад навис: ['Dont catch this!']. }, оғоз.

Баромад навис: ['Test Array each-loop: 0,1'], сатри-нав.
(Феҳрист ← 1 ; 2 ; 3) табдил: { :i
	Баромад навис: ['iteration #'] + i, сатри-нав.
	(i = 1) буридан.
}.

Баромад навис: ['Test Map each-loop: c only'], сатри-нав.
>> m := Луғат нав.
m гузор: ['first'] калид: ['a'], гузор: ['second'] калид: ['b'], гузор: ['third'] калид: ['c'].
m ҳар-як: { :k :v
	Баромад навис: ['iteration'] + v + k, сатри-нав.
	Рост буридан.
}.

