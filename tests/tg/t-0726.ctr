# test buffers PKI/Sign 
Server init.

>> long := ( Феҳрист нав пур: 1000 бо-қимат: ['a'] ) пайваст: [''].

# sign a message
Баромад навис: ( 
	Сейф имзо: ['abc'] бо-калид: long
), сатри-нав.

Баромад навис: ( 
	Сейф
		санҷ: ['abc'] 
		имзо: long 
		бо-калид: long
), сатри-нав.

Баромад навис: (
	Сейф ҳеши-парол: long тафтиш: long
), сатри-нав.
