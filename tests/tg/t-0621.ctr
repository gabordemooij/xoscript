>> phrases := Феҳрист нав
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases ҳар-як: { :_ :phrase 
	>> e := Server base64-рамзгузорӣ: phrase.
	>> d := Server base64-рамзкушоӣ: e.
	Баромад навис: (
		message нусха ~encoded: e, ~decoded: d
	), сатри-нав.
}.
