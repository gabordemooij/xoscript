

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Барнома идораи-хотира: 0.

>> txt := ['Word Salad'].
Баромад навис: ['Text Length: '] + txt дарозӣ, сатри-нав.
Баромад навис: ['Character at 2:'] + ( txt аломат: 2 ), сатри-нав.
Баромад навис: (( txt ёфтан: ['S'] ) - 0), сатри-нав.

Барнома тозакунӣ.

usedMemory1 := (Барнома хотира ? 0).


txt := ['Word Salad'].
Баромад навис: ['Text Length: '] + txt дарозӣ, сатри-нав.
Баромад навис: ['Character at 2:'] + ( txt аломат: 2 ), сатри-нав.
Баромад навис: (( txt ёфтан: ['S'] ) - 0), сатри-нав.

Барнома тозакунӣ.
usedMemory2 := (Барнома хотира ? 0).


txt := ['Word Salad'].
Баромад навис: ['Text Length: '] + txt дарозӣ, сатри-нав.
Баромад навис: ['Character at 2:'] + ( txt аломат: 2 ), сатри-нав.
Баромад навис: (( txt ёфтан: ['S'] ) - 0), сатри-нав.

Барнома тозакунӣ.
usedMemory3 := (Барнома хотира ? 0).



( usedMemory1 = usedMemory2 ва: usedMemory1 = usedMemory3, ва: usedMemory2 = usedMemory3 ) агар-рост: {
	Баромад навис: ['No memory leaks here'].
}, агар-дурӯғ: {
	Баромад навис: ['Leaking memory...'].
}.
