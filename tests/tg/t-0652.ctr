# test number -> string -> number
{

	>> x := Адад байни: 0 то: 1000000.
	>> d := Адад байни: 1 то: 7.
	>> e := 10 дараҷа: d.

	x тақсим-ба: e.
	>> y := x матн адад.

	(x = y) агар-дурӯғ: {
		Баромад навис: x, сатри-нав.
		Баромад навис: y, сатри-нав.
		Барнома анҷом.
	}.

} * 1000.
Баромад навис: ['OK'], сатри-нав.