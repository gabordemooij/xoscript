
Server init.
Баромад навис: ['Database test'], сатри-нав.

>> db := Maria-DB нав мизбон: ['localhost'],
	номи-корбар: ['xo'], 
	парол: ['pass123'],
	номи-пойгоҳ: ['xobase'],
	пайваст-шав.

>> параметрҳои-ҷустуҷӯ :=
db дархост: ['SELECT UNHEX('CAFE') AS blobby'],
гирифтан: { :row
	Баромад навис: ( row blobby оғоз: 0 дарозӣ: 2 ), сатри-нав.
	row blobby озод.
}.
