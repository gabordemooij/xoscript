# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := Maria-DB нав мизбон: ['localhost'],
	номи-корбар: ['xo'],
	парол: ['pass123'],
	номи-пойгоҳ: ['xobase'],
	пайваст-шав.

>> параметрҳои-ҷустуҷӯ := db дархост: ['SELECT ? AS a, ? AS b, ? AS c'].
параметрҳои-ҷустуҷӯ параметрҳо: (Феҳрист нав ; ['1']).
{ параметрҳои-ҷустуҷӯ гирифтан: { :row Баромад навис: row, сатри-нав. }. } дошта-гир: { :e Баромад навис: e, сатри-нав. }, оғоз.

>> параметрҳои-ҷустуҷӯ := db дархост: ['SELECT ? AS a'].
{ параметрҳои-ҷустуҷӯ гирифтан: { :row Баромад навис: row, сатри-нав. }. } дошта-гир: { :e Баромад навис: e, сатри-нав. }, оғоз.

# the right number still works, more parameters are ignored as before
>> параметрҳои-ҷустуҷӯ := db дархост: ['SELECT ? AS a, ? AS b'].
параметрҳои-ҷустуҷӯ параметрҳо: (Феҳрист нав ; ['1'] ; ['2']).
параметрҳои-ҷустуҷӯ гирифтан: { :row Баромад навис: (row дар: ['a']), навис: (row дар: ['b']), сатри-нав. }.
параметрҳои-ҷустуҷӯ параметрҳо: (Феҳрист нав ; ['1'] ; ['2'] ; ['3']).
параметрҳои-ҷустуҷӯ гирифтан: { :row Баромад навис: (row дар: ['a']), навис: (row дар: ['b']), сатри-нав. }.
