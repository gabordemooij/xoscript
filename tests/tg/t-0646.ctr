Server init.
Баромад навис: ['Database datetime test'], сатри-нав.

>> db := Maria-DB нав мизбон: ['localhost'],
	номи-корбар: ['xo'], 
	парол: ['pass123'],
	номи-пойгоҳ: ['xobase'],
	пайваст-шав.

>> параметрҳои-ҷустуҷӯ :=
db дархост: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
гирифтан: { :row
	Баромад навис: row datetimetest, сатри-нав.
}.
