# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Сейф 
	ҳеши-парол: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Сейф 
	ҳеши-парол: hash тафтиш: a1.
	# fail 
>> b := Сейф
	ҳеши-парол: hash тафтиш: a2.
	# ok!

Баромад навис: a, сатри-нав.
Баромад навис: b, сатри-нав.

