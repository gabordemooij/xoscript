Server init.

Баромад навис: (
	Қолаб нав: ['^\\w+$'],
	мувофиқат: ['test@example.com'] 
), сатри-нав. # 0 match, fails on @ and .

Баромад навис: (
	Қолаб нав: ['^[^@]+@[^\.]+\.\\w+$'],
	мувофиқат: ['test@example.com'] 
), сатри-нав. # 1 match

Баромад навис: (
	Қолаб нав: ['[^@]+@[^\.]+\.\\w+'],
	мувофиқат: ['test@example.com'] 
), сатри-нав. # 1 match

Баромад навис: (
	Қолаб нав: ['([^@]+)@([^\.]+)\.\\w+'],
	мувофиқат: ['test@example.com'] 
), сатри-нав. # 1 match, groups dont matter

Баромад навис: (
	Қолаб нав: ['[a-z]'],
	мувофиқат: ['test@example.com'] 
), сатри-нав. # 14 matches

Баромад навис: (
	Қолаб нав: ['.*'],
	мувофиқат: ['test@example.com'] 
), сатри-нав. # 1 match (all)

Баромад навис: (
	Қолаб нав: ['(.*)'],
	мувофиқат: ['test@example.com'] 
), сатри-нав. # 1 match (all)

Баромад навис: (
	Қолаб нав: ['\\s*[^@]+@[^\.]+\.\\w+'],
	мувофиқат: ['test@example.com'] 
), сатри-нав. # 1 match, prefix space optional, gets ignored