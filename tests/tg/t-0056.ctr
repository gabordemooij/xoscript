>> z := Объект нав.
z ҳангоми: ['value:'] иҷро: { :v
	худӣ value := v. <- худ.
}.
z ҳангоми: ['value'] иҷро: { <- худӣ value. }.
(z setValue: 1) value: 2.
Баромад навис: z value.
>> x := z.
Баромад навис: x value.
z := Ҳеҷ.
Баромад навис: z value.
Баромад навис: x value.
Баромад навис: ['hello'].
