Server init.

>> db := Maria-DB нав мизбон: ['localhost'],
	номи-корбар: ['xo'],
	парол: ['pass123'],
	номи-пойгоҳ: ['xobase'],
	пайваст-шав.

>> del := db дархост: ['DELETE FROM book WHERE id > 0'].
{  del иҷро-кун. db тасдиқ. } дошта-гир: { :e db бозгашт.  }, оғоз.

>> шумора := db дархост: ['SELECT COUNT(*) AS num FROM book'].
шумора гирифтан: { :row Баромад навис: row num, сатри-нав. }.
