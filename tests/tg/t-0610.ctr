
>> Rectangle := Объект нав.

Rectangle ҳангоми: ['area'] иҷро: { <- худӣ дарозӣ * худӣ width.
}.

Rectangle ҳангоми: ['length:'] иҷро: { :дарозӣ
	худӣ дарозӣ := дарозӣ.
}.

Rectangle ҳангоми: ['width:'] иҷро: { :width
	худӣ width := width.
}.

Rectangle ҳангоми: ['нав'] иҷро: {
	# this will not result into an infinite loop
	>> rectangle := худ нав.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle нав.
Баромад навис: a area, сатри-нав. #0

>> b := Rectangle нав length: 2, width: 3.
Баромад навис: b area, сатри-нав. #6

