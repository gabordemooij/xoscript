>> repeater := Объект нав.
repeater ҳангоми: ['ҷавоб:'] иҷро: { :what
	Баромад навис: what + [' '].
}.
repeater ҳангоми: ['ҷавоб:ва:'] иҷро: { :what :say
	Баромад навис: what, навис: say + [' '].
}.
repeater ҳангоми: ['ҷавоб:ва:ва:'] иҷро: { :what :say :more
	Баромад навис: what, навис: say, навис: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
