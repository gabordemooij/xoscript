# a quote that never closes must give an error, not an endless loop
>> роҳ := ['/tmp/test0821.csv'].
>> file := Файл нав: роҳ.

file навис: ['a,b\n"1,2\n'].
{
	file ҷудокунанда: [','] нохунак: ['"'] сатрҳо: { :line
		Баромад навис: line, сатри-нав.
	}.
} дошта-гир: { :e Баромад навис: e, сатри-нав. }, оғоз.

# a closed quote still works
file навис: ['a,b\n"1,2",3'].
file ҷудокунанда: [','] нохунак: ['"'] сатрҳо: { :line
	Баромад навис: line, сатри-нав.
}.
file ҳазф.
