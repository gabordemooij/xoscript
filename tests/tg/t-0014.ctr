>> Greeter := Объект нав.
Greeter ҳангоми: ['make'] иҷро: {
	>> gr := Объект нав.
	gr ҳангоми: ['setName:'] иҷро: { :aname
		худӣ ном := aname.
	}.
	gr ҳангоми: ['greet'] иҷро: {
		Баромад навис: худӣ ном.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a нав.
c setName: ['THREE'].
c greet.
>> d := a нав.
d setName: ['FOUR'].
d greet.
c greet.
