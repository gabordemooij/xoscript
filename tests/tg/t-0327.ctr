

Феҳрист ҳангоми: ['fixture:'] иҷро: { :f
	худӣ fixture := f.
}.

Феҳрист ҳангоми: ['шумора'] иҷро: { <- худӣ fixture.
}.

Феҳрист ҳангоми: ['aantal'] иҷро: { <- худӣ fixture.
}.


>> x := Ҳеҷ.
{

	x := ['hello'] 
	иваз:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] аломат: 2)
			)
		)
	бо: (
		(['...hal'] + ['lo']) 
			ҳарфҳои-калон 
			lowecase 
			ҳарфҳои-калон 
			гузариш: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Феҳрист ← 0 ; 1 ; 4; 9 ; (Феҳрист ← 0 ; 3; 1) ; 4
							) пеш-аз-охирин
						) ? 1
					) + 
					((Феҳрист ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					шумора
				)
			)
	).

} × 10.
Баромад навис: x, сатри-нав.

