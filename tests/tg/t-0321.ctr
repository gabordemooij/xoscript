# test qualifiers

Барнома тозакунӣ.

>> Fruit := Объект нав.
Fruit ҳангоми: ['нав'] иҷро: {
	>> f := худ нав.
	f apples: 0. <- f.
}.
Fruit ҳангоми: ['apples:'] иҷро: { :a худӣ apples := a. }.
Fruit ҳангоми: ['apples'] иҷро: { <- худӣ apples. }.
Fruit ҳангоми: ['+'] иҷро: { :f
	>> n := Fruit нав.
	n apples: (f apples + худӣ apples). <- n.
}.
Адад ҳангоми: ['apples'] иҷро: { <- ((Fruit нав) apples: худ).
}.

Fruit ҳангоми: ['матн'] иҷро: { <- худӣ apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Баромад навис: q, сатри-нав.




q := 3 apples + 4 apples.
Баромад навис: q, сатри-нав.



q := 3 apples + 4 apples.
Баромад навис: q, сатри-нав.


