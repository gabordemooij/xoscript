# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> роҳ := ['/tmp/dat.csv'].
>> csv := Файл нав: роҳ.
csv навис: s.

# accepts CRLF LF CR, varying row length
csv ҷудокунанда: [';'] нохунак: ['"'] сатрҳо: { :line
	Барнома тозакунӣ.
	Баромад навис: line, сатри-нав.
	Барнома тозакунӣ.
}.

# unequal lines
s ба-охир-илова: ['\njustone'].
csv навис: s.
{
	csv ҷудокунанда: [';'] нохунак: ['"'] сатрҳо: { :line
		Баромад навис: line, сатри-нав.
	}.
} дошта-гир: { :e 
	Баромад навис: e, сатри-нав.
}, оғоз.

# invalid format
s := ['"he"llo";world'].
csv навис: s.
{
	csv ҷудокунанда: [';'] нохунак: ['"'] сатрҳо: { :line
		Баромад навис: line, сатри-нав.
	}.
} дошта-гир: { :e 
	Баромад навис: e, сатри-нав.
}, оғоз.
