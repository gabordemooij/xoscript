>> makeAdder := { :x
	>> f := { :y <- (худӣ x + y). } муқаррар: ['x'] қимат: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i худӣ q гузор: (худӣ f татбиқ: (худӣ q ? i)) калид: i. } 
	муқаррар: ['q'] қимат: array,
	муқаррар: ['f'] қимат: func.
	{ :i mapping татбиқ: i. } × (array шумора).
}.

>> a := Феҳрист ← 1; 2; 3.
mapper татбиқ: a ва: (makeAdder татбиқ: 100).
Баромад навис: (a мавқеъ: 0), сатри-нав.
Баромад навис: (a ? 1), сатри-нав.
Баромад навис: (a ? 2), сатри-нав.
