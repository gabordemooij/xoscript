
Server init.
Баромад навис: ['Database test'], сатри-нав.

>> db := Maria-DB нав мизбон: ['localhost'],
	номи-корбар: ['xo'], 
	парол: ['pass123'],
	номи-пойгоҳ: ['xobase'],
	пайваст-шав.

>> параметрҳои-ҷустуҷӯ :=
db дархост: ['SELECT REPEAT('Blah',1000) AS blah'], 
гирифтан: { :row 
	Баромад навис: row blah дарозӣ, сатри-нав.
}.
