>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Объект нав.
⚄ ҳангоми: ['drawFrom:length:'] иҷро: { :pool :шумора
	
	>> result := [''].
	
	{
		>> index := Адад random % (pool дарозӣ).
		result ба-охир-илова: ( pool аломат: (index + 1) ).
		
	} × шумора. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? дарозӣ.
Баромад навис: (['x↵'] x random дарозӣ).
Баромад навис: (['y↵'] y ?? дарозӣ).

