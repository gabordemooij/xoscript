# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := Объект нав.

Log ҳангоми: ['say:'] иҷро: { :str
	Баромад навис: str, сатри-нав.
}.

>> Item := Объект нав.

Item ҳангоми: ['нав:'] иҷро: { :id <- худ нав id: id.
}.

Item ҳангоми: ['id:'] иҷро: { :id
	худӣ id := id.
}.

Item ҳангоми: ['id'] иҷро: { <- худӣ id. }.


Item ҳангоми: ['матн'] иҷро: {
	>> str := ['Item#~no'].
	str ~no: худӣ id. <- str.
}.


>> Print := Объект нав.

Print ҳангоми: ['items'] иҷро: { 
	
	худӣ item := Item нав: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: худӣ item
	).
	
	
}.

Print items.