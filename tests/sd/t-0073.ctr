
>> blue := ⌝'blue'⌜.
>> colors := لسٽ ← ⌝'yellow'⌜; ⌝'green'⌜; blue ; ⌝'red'⌜; ⌝'orange'⌜; ⌝'purple'⌜; ⌝'pink'⌜.
>> palette := colors شروعات: 2 ڊيگهه: 3.
آئوٽ-پٽ لکو: ﴿palette ملايو: ⌝','⌜﴾, نئين-سٽ. 
blue := ⌝'cyan'⌜.
