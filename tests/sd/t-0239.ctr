لسٽ جڏهن: ⌝'sum'⌜ ڪريو: ⎬
	>> total := 0.
	پاڻ هر-هڪ: ⎬ :index :element
		total جوڙ: element.
	⎨. <- total.
⎨.

>> a := سچ.



a جڏهن: ⌝'متن-طور'⌜ ڪريو: ⎬
	>> answer := خالي.
	﴿ پاڻ = سچ ﴾ جيڪڏهن-سچ: ⎬
		answer := ⌝'Yep'⌜.
	⎨, نه-ته: ⎬
		answer := ⌝'Nope'⌜.
	⎨. <- answer.
⎨.

a جڏهن: ⌝'انگ-طور'⌜ ڪريو: ⎬
	>> answer := خالي.
	﴿ پاڻ = سچ ﴾ جيڪڏهن-سچ: ⎬
		answer := 10.
	⎨, نه-ته: ⎬
		answer := 20.
	⎨. <- answer.
⎨.

>> b := 666.

b جڏهن: ⌝'متن-طور'⌜ ڪريو: ⎬ <- ⌝'Devil'⌜.
⎨.

b جڏهن: ⌝'بولين-طور'⌜ ڪريو: ⎬ <- ڪوڙ.
⎨.


آئوٽ-پٽ لکو: a, نئين-سٽ.  
آئوٽ-پٽ لکو: ﴿90 + a﴾, نئين-سٽ. 
آئوٽ-پٽ لکو: b, نئين-سٽ. 
آئوٽ-پٽ لکو: ﴿سچ ۽: b﴾, نئين-سٽ.

a := لسٽ ← ⌝'hello'⌜ ; ⌝'world'⌜ ; سچ ; خالي ; 666. 
a := a + ﴿ لسٽ ← 1 ﴾.
آئوٽ-پٽ لکو: a, نئين-سٽ.
آئوٽ-پٽ لکو: ﴿﴿لغت نئون﴾ رکو: خالي ڪنجي: خالي﴾, نئين-سٽ.
آئوٽ-پٽ لکو: a sum, نئين-سٽ. 


⎬
	a جڏهن: ⌝'متن-طور'⌜ ڪريو: ⎬ <- خالي. ⎨.
	a := ⌝''⌜ + a.
⎨ پڪڙيو: ⎬ :error
	آئوٽ-پٽ لکو: ⌝'Error noted: '⌜ + error, نئين-سٽ.
⎨, هلايو.



⎬
	a جڏهن: ⌝'انگ-طور'⌜ ڪريو: ⎬ <- خالي. ⎨.
	a := 3 × a.
⎨ پڪڙيو: ⎬ :error
	آئوٽ-پٽ لکو: ⌝'Error noted: '⌜ + error, نئين-سٽ.
⎨, هلايو.


⎬
	a جڏهن: ⌝'بولين-طور'⌜ ڪريو: ⎬ <- خالي. ⎨.
