Server init.

# JSON encoder only supports UTF-8, no surrogate pairs

>> dicts := لسٽ نئون ;
	# {"key":"normal"} normal ASCII
	﴿ لغت نئون رکو: ⌝'normal'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"hello world"} space character
	﴿ لغت نئون رکو: ⌝'hello world'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"quote: \""} double quote
	﴿ لغت نئون رکو: ⌝'"'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"backslash: \\"} backslash
	﴿ لغت نئون رکو: ⌝'backslash: \\'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"slash: /"} slash
	﴿ لغت نئون رکو: ⌝'slash: /'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"backspace: \b"} backspace
	﴿ لغت نئون رکو: ⌝'backspace: \b'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"formfeed: \f"} form-feed escape
	﴿ لغت نئون رکو: ⌝'formfeed: \f'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"newline: \n"} newline
	﴿ لغت نئون رکو: ⌝'newline: \n'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	﴿ لغت نئون رکو: ⌝'newline: ↵'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	﴿ لغت نئون رکو: ⌝'newline: 
	'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"carriage return: \r"} carriage-return
	﴿ لغت نئون رکو: ⌝'carriage return: \r'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"tab: \t"} tab
	﴿ لغت نئون رکو: ⌝'tab \t'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	﴿ لغت نئون رکو: ⌝'tab ⇿'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	﴿ لغت نئون رکو: ⌝'tab  '⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u0000"} NUL
	﴿ لغت نئون رکو: ⌝'NUL \u0000'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	﴿ لغت نئون رکو: ⌝'NUL \0'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u0001"} control character 0x01
	﴿ لغت نئون رکو: ⌝'control: \u0001'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u001F"} control character 0x1F
	﴿ لغت نئون رکو: ⌝'control: \u001F'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: é"} UTF-8, 2-byte char
	﴿ لغت نئون رکو: ⌝'unicode: é'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: €"} UTF-8, 3-byte char
	﴿ لغت نئون رکو: ⌝'unicode: €'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 日本語"} multiple 3-byte UTF-8 chars
	﴿ لغت نئون رکو: ⌝'unicode: 日本語'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 😀"} UTF-8, 4-byte char
	﴿ لغت نئون رکو: ⌝'unicode: 😀'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	﴿ لغت نئون رکو: ⌝'unicode: 🧑‍💻'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"combining: e\u0301"} combining accent
	﴿ لغت نئون رکو: ⌝'combining: e\u0301'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: \u00e9"} Unicode escape BMP
	﴿ لغت نئون رکو: ⌝'escaped unicode: \u00e9'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: \u20ac"} Unicode escape BMP
	﴿ لغت نئون رکو: ⌝'escaped unicode: \u20ac'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: \ud83d\ude00"} UTF-16 surrogate pair
	﴿ لغت نئون رکو: ⌝'escaped unicode: \ud83d\ude00'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":""} empty value
	﴿ لغت نئون رکو: ⌝''⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"@ < > & = % + ? #"} special ASCII chars
	﴿ لغت نئون رکو: ⌝'@ < > & = % + ? #'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"single quote: '"} single quote
	﴿ لغت نئون رکو: ⌝'''⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"multiple: \" \\ \n \r \t"} multiple JSON escapes
	﴿ لغت نئون رکو: ⌝'multiple: \" \\ \n \r \t'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} longer ASCII-string
	﴿ لغت نئون رکو: ⌝'aaaaaaaaaaaaaaaaaaaaaaaaaa'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":" value"} leading space
	﴿ لغت نئون رکو: ⌝' value'⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":"value "} trailing space
	﴿ لغت نئون رکو: ⌝'value '⌜ ڪنجي: ⌝'key'⌜ ﴾ ;
	# {"key":" \t\n\r "} whitespace
	﴿ لغت نئون رکو: ⌝' \t\n\r '⌜ ڪنجي: ⌝'key'⌜ ﴾.

dicts هر-هڪ: ⎬ :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: ﴿لغت نئون رکو: d key ڪنجي: ⌝'key'⌜﴾.
	>> b := JSON jsonify: ﴿لغت نئون رکو: ⌝'value'⌜ ڪنجي: d key﴾.
	>> e := JSON شيء: a.
	>> f := JSON شيء: b.
	﴿﴿e key = d key ۽: ﴿f ? d key = ⌝'value'⌜﴾﴾ يا: ﴿e key = ⌝'NUL ?'⌜﴾﴾ جيڪڏهن-سچ: ⎬
		آئوٽ-پٽ لکو: ⌝'OK'⌜, نئين-سٽ.
	⎨, نه-ته: ⎬
		آئوٽ-پٽ لکو: ⌝'Unable to properly encode/decode: '⌜ + d + j, نئين-سٽ.
		پروگرام پڄاڻي.
	⎨.
⎨.
