

لسٽ جڏهن: ⌝'column:'⌜ ڪريو: ⎬ :column
	>> result := لسٽ نئون.
	پاڻ هر-هڪ: ⎬ :index :row
		row هر-هڪ: ⎬ :index :cell
			﴿index = column﴾ جيڪڏهن-سچ: ⎬ result آخر-۾-جوڙيو: cell. ⎨.
		⎨.
	⎨. <- result.
⎨.


>> a := لسٽ ←
	﴿لسٽ ← 1 ; 2 ; 3﴾ ;
	﴿لسٽ ← 4 ; 5 ; 6﴾ ;
	﴿لسٽ ← 7 ; 8 ; 9﴾.

>> b := a column: 1.
آئوٽ-پٽ لکو: b, نئين-سٽ.

b := a column: 20.
آئوٽ-پٽ لکو: b, نئين-سٽ.

b := a column: -100.
آئوٽ-پٽ لکو: b, نئين-سٽ.
