# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := ٽجوڙي ڪنجيون-ٺاهيو.

# private (secret) key
>> sk := keys پهريون.

# public key
>> pk := keys آخري.

# sign a message
>> sig := ٽجوڙي صحيح: ⌝'abc'⌜ ڪنجي-سان: sk.

# check message (ok)
آئوٽ-پٽ لکو: ﴿ 
	ٽجوڙي
		جاچيو: ⌝'abc'⌜ 
		صحيح: sig 
		ڪنجي-سان: pk 
﴾, نئين-سٽ.

# check message (fail)
آئوٽ-پٽ لکو: ﴿ 
	ٽجوڙي 
		جاچيو: ⌝'abd'⌜ 
		صحيح: sig 
		ڪنجي-سان: pk 
﴾, نئين-سٽ.