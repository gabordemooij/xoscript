# Password hashing
Server init.

# User sets a password
>> passw := ⌝'pass123'⌜.

# You store it like this
>> hash := ٽجوڙي 
	پاسورڊ-هيش: passw.

# Then, user logs in
# Attempt 1
>> a1 := ⌝'abcd123'⌜.
# Attempt 2
>> a2 := ⌝'pass123'⌜.

# Verify
>> a := ٽجوڙي 
	پاسورڊ-هيش: hash تصديق: a1.
	# fail 
>> b := ٽجوڙي
	پاسورڊ-هيش: hash تصديق: a2.
	# ok!

آئوٽ-پٽ لکو: a, نئين-سٽ.
آئوٽ-پٽ لکو: b, نئين-سٽ.

