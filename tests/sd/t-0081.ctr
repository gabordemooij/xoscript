>> map1 := لغت نئون.
>> key1 := لسٽ نئون.
>> key2 := لسٽ نئون.

map1
	رکو: ⌝'hello'⌜ ڪنجي: key1,
	رکو: ⌝'world'⌜ ڪنجي: key2.


آئوٽ-پٽ
	لکو: ⌝'Map #1 contains: '⌜ + ﴿map1 تي: key1﴾,
	لکو: ⌝' and '⌜ + ﴿map1 تي: key2﴾, نئين-سٽ.

>> KeyeableArray := لسٽ نئون.
KeyeableArray جڏهن: ⌝'toString'⌜ ڪريو: ⎬ <- ﴿پاڻ ڳڻپ﴾ toString.
⎨.

>> map2 := لغت نئون.
key1 := KeyeableArray نئون.
key2 := KeyeableArray نئون.

key1 آخر-۾-جوڙيو: 1.

map2
	رکو: ⌝'hello'⌜ ڪنجي: key1,
	رکو: ⌝'world'⌜ ڪنجي: key2.

آئوٽ-پٽ
	لکو: ⌝'Map #2 contains: '⌜ + ﴿map2 تي: key1﴾,
	لکو: ⌝' and '⌜ + ﴿map2 تي: key2﴾, نئين-سٽ.
