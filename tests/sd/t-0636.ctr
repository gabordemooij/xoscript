# test url parsing

Server init.
>> url := URL مان: ⌝'https://xoscript.com:1234/a/b/c?test=1#hello'⌜.

آئوٽ-پٽ لکو: ⌝'scheme = '⌜ + url اسڪيم, نئين-سٽ.
آئوٽ-پٽ لکو: ⌝'host = '⌜ + url ميزبان, نئين-سٽ.
آئوٽ-پٽ لکو: ⌝'port = '⌜ + url پورٽ, نئين-سٽ.
آئوٽ-پٽ لکو: ⌝'path = '⌜ + url فائل-رستو, نئين-سٽ.
آئوٽ-پٽ لکو: ⌝'query = '⌜ + url ڳولا-پيراميٽر, نئين-سٽ.
آئوٽ-پٽ لکو: ⌝'fragment = '⌜ + url ٽڪرو, نئين-سٽ.
