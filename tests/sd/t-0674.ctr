# happy flow
>> s := ⌝'hello;"""world"""\n"of";"c\ns\nv"'⌜.
>> فائل-رستو := ⌝'/tmp/dat.csv'⌜.
>> csv := فائل نئون: فائل-رستو.
csv لکو: s.

# accepts CRLF LF CR, varying row length
csv ڌار-ڪندڙ: ⌝';'⌜ واڪ-نشان: ⌝'"'⌜ سٽون: ⎬ :line
	پروگرام صفائي.
	آئوٽ-پٽ لکو: line, نئين-سٽ.
	پروگرام صفائي.
⎨.

# unequal lines
s آخر-۾-جوڙيو: ⌝'\njustone'⌜.
csv لکو: s.
⎬
	csv ڌار-ڪندڙ: ⌝';'⌜ واڪ-نشان: ⌝'"'⌜ سٽون: ⎬ :line
		آئوٽ-پٽ لکو: line, نئين-سٽ.
	⎨.
⎨ پڪڙيو: ⎬ :e 
	آئوٽ-پٽ لکو: e, نئين-سٽ.
⎨, هلايو.

# invalid format
s := ⌝'"he"llo";world'⌜.
csv لکو: s.
⎬
	csv ڌار-ڪندڙ: ⌝';'⌜ واڪ-نشان: ⌝'"'⌜ سٽون: ⎬ :line
		آئوٽ-پٽ لکو: line, نئين-سٽ.
	⎨.
⎨ پڪڙيو: ⎬ :e 
	آئوٽ-پٽ لکو: e, نئين-سٽ.
⎨, هلايو.
