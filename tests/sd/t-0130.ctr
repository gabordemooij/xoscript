# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := پروگرام سيٽنگ: ⌝'FFITESTLIB'⌜.

# link stdio functions from c for advances file operations
Server ڳنڍيو: ﴿ لسٽ نئون ;
 libname ; ⌝'fopen'⌜ ;
 ﴿ لسٽ نئون ; ⌝'pointer'⌜ ; ⌝'pointer'⌜﴾ ;
 ⌝'pointer'⌜ ;
 ⌝'Stream'⌜ ;
 ⌝'path:mode:'⌜
﴾,
ڳنڍيو: ﴿ لسٽ نئون ;
 خالي ; # means same lib
 ⌝'fread'⌜ ;
 ﴿ لسٽ نئون ; ⌝'pointer'⌜ ; ⌝'int'⌜ ; ⌝'int'⌜ ; ⌝'pointer'⌜ ﴾ ;
 ⌝'int'⌜ ;
 خالي ; # means same object (i.e. Stream)
 ⌝'fread'⌜
﴾,
ڳنڍيو: ﴿
 لسٽ نئون ;
 خالي ; # means same lib
 ⌝'fwrite'⌜ ;
 ﴿ لسٽ نئون ; ⌝'pointer'⌜ ; ⌝'int'⌜ ; ⌝'int'⌜ ; ⌝'pointer'⌜ ﴾ ;
 ⌝'int'⌜ ;
 خالي ; # means same lib
 ⌝'fwrite'⌜
﴾,
ڳنڍيو: ﴿
 لسٽ نئون ;
 خالي ; # means same lib
 ⌝'rewind'⌜ ;
 ﴿ لسٽ نئون ; ⌝'pointer'⌜ ﴾ ;
 ⌝'int'⌜ ;
 خالي ; # means same lib
 ⌝'rewind:'⌜
﴾.

>> str := Blob utf8: ⌝'abc123'⌜.
>> فائل-رستو := Blob utf8: ⌝'/tmp/bla.txt'⌜.
>> mode := Blob utf8: ⌝'w+'⌜.

# open a file with fopen(path, mode)
>> fd := Stream path: فائل-رستو mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream پيغام: ⌝'fwrite'⌜ دليل: ﴿لسٽ نئون ; str ; 1 ; 6 ; fd ﴾.
آئوٽ-پٽ لکو: bytes-written, نئين-سٽ.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob نئون: 20.

# read from file
>> bytes-read := Stream پيغام: ⌝'fread'⌜ دليل: ﴿لسٽ نئون ; buf ; 1 ; 6 ; fd ﴾.
آئوٽ-پٽ لکو: bytes-read, نئين-سٽ.
آئوٽ-پٽ لکو: buf, نئين-سٽ.

# free memory
str  آزاد-ڪريو.
فائل-رستو آزاد-ڪريو.
mode آزاد-ڪريو.
buf  آزاد-ڪريو.


