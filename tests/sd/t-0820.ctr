# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := ⎬ :pattern :subject
	>> p := نمونو-ڳولا نئون: pattern.
	p ميلاپ: subject ڪريو: ⎬ :m :g
		آئوٽ-پٽ لکو: g ڳڻپ, لکو: ⌝' '⌜, لکو: ﴿g ملايو: ⌝'|'⌜﴾, نئين-سٽ. <- m.
	⎨.
⎨.
show لاڳو: ⌝'(a)|(b)'⌜ ۽: ⌝'b'⌜.
show لاڳو: ⌝'(a)|(b)'⌜ ۽: ⌝'a'⌜.
show لاڳو: ⌝'(x)?y'⌜ ۽: ⌝'y'⌜.
show لاڳو: ⌝'(x)?(y)(z)?'⌜ ۽: ⌝'xy'⌜.
