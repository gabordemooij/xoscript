>> Greeter := شيء نئون.
Greeter جڏهن: ⌝'make'⌜ ڪريو: ⎬
	>> gr := شيء نئون.
	gr جڏهن: ⌝'setName:'⌜ ڪريو: ⎬ :aname
		پنهنجو نالو := aname.
	⎨.
	gr جڏهن: ⌝'greet'⌜ ڪريو: ⎬
		آئوٽ-پٽ لکو: پنهنجو نالو.
	⎨. <- gr.
⎨.
>> a := Greeter make.
>> b := Greeter make.
a setName: ⌝'ONE'⌜.
b setName: ⌝'TWO'⌜.
a greet.
b greet.
>> c := a نئون.
c setName: ⌝'THREE'⌜.
c greet.
>> d := a نئون.
d setName: ⌝'FOUR'⌜.
d greet.
c greet.
