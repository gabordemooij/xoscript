Server init.

>> DB := Maria-DB نئون ميزبان: ⌝'localhost'⌜,
	يوزر-نالو: ⌝'xo'⌜,
	پاسورڊ: ⌝'pass123'⌜,
	ڊيٽابيس-نالو: ⌝'xobase'⌜,
	ڳنڍجو.
	
>> SQL := ⌝'SELECT "hello" AS "world" '⌜.

# manually create query
>> ڳولا-پيراميٽر := سوال-Maria نئون: SQL.

# set database
ڳولا-پيراميٽر ڊيٽابيس: DB.

ڳولا-پيراميٽر آڻيو: ⎬ :row
	آئوٽ-پٽ لکو: row world, نئين-سٽ.
⎨.
