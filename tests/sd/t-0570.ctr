#Linux

 >> t := لمحو نئون.
 
t ٽائيم-زون: ⌝'Europe/Amsterdam'⌜.
t سال: 2020, مهينو: 8, ڏينهن: 2, ڪلاڪ: 21, منٽ: 2, سيڪنڊ: 1.

>> a := t ڪلاڪ.
>> ams := t ٽائيم-زون.

t ٽائيم-زون: ⌝'US/Hawaii'⌜.
>> b := t ڪلاڪ.
>> hw := t ٽائيم-زون.

آئوٽ-پٽ
لکو: ﴿
	⌝'It's diff in zone2 than in zone1'⌜
	zone1: ams,
	zone2: hw,
	diff: ﴿
		﴿b > a﴾
		هي: ⌝'later'⌜ يا-هو: ⌝'earlier'⌜
	﴾
﴾,
نئين-سٽ.
 