# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := شيء نئون.

Log جڏهن: ⌝'say:'⌜ ڪريو: ⎬ :str
	آئوٽ-پٽ لکو: str, نئين-سٽ.
⎨.

>> Item := شيء نئون.

Item جڏهن: ⌝'نئون:'⌜ ڪريو: ⎬ :id <- پاڻ نئون id: id.
⎨.

Item جڏهن: ⌝'id:'⌜ ڪريو: ⎬ :id
	پنهنجو id := id.
⎨.

Item جڏهن: ⌝'id'⌜ ڪريو: ⎬ <- پنهنجو id. ⎨.


Item جڏهن: ⌝'متن-طور'⌜ ڪريو: ⎬
	>> str := ⌝'Item#~no'⌜.
	str ~no: پنهنجو id. <- str.
⎨.


>> Print := شيء نئون.

Print جڏهن: ⌝'items'⌜ ڪريو: ⎬ 
	
	پنهنجو item := Item نئون: 1.
	
	# either segfault or wrong str here
	Log say: ﴿
		⌝'~item printed.'⌜ ~item: پنهنجو item
	﴾.
	
	
⎨.

Print items.