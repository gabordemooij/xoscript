#regex test
Server init.
>> subject := ⌝'<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'⌜.
>> pattern := نمونو-ڳولا نئون: ⌝'href="([^"]+)" target="([^"]+)"'⌜.
>> result := pattern ميلاپ: subject ڪريو: ⎬ :m :x
	آئوٽ-پٽ لکو: m, نئين-سٽ.
	آئوٽ-پٽ لکو: x, نئين-سٽ. <- ⌝'XXX'⌜.
⎨.
آئوٽ-پٽ لکو: result, نئين-سٽ.