Server init.

>> DB := Maria-DB نئون ميزبان: ⌝'localhost'⌜,
	يوزر-نالو: ⌝'xo'⌜,
	پاسورڊ: ⌝'pass123'⌜,
	ڊيٽابيس-نالو: ⌝'xobase'⌜,
	ڳنڍجو.
	
>> SQL := ⌝'SELECT "hello" AS "world" '⌜.

# a quicker way, get query from DB:
>> query2 := DB سوال: SQL.

# now you don't have to set DB
query2 آڻيو: ⎬ :row
	آئوٽ-پٽ لکو: row world, نئين-سٽ.
⎨.
