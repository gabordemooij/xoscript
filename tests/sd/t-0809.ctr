# backslashes must survive code serialization, strings must not end early
>> قدر := لسٽ نئون
	; ⌝'C:\\new'⌜
	; ⌝'ends with backslash \\'⌜
	; ⌝'\\\\'⌜
	; ⌝'x\\\'] at: 9, put: 1 at: 2).'⌜.

قدر هر-هڪ: ⎬ :i :value
	>> d := لغت نئون.
	d رکو: value ڪنجي: ⌝'k'⌜.
	>> r := d ڪوڊ شيء-طور.
	آئوٽ-پٽ لکو: r ڳڻپ, نئين-سٽ.
	آئوٽ-پٽ لکو: ﴿ ﴿r تي: ⌝'k'⌜﴾ = value ﴾, نئين-سٽ.
⎨.
