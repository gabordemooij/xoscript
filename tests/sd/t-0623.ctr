

>> g := Server نئون.
>> v := ٽجوڙي نئون.
>> ok := 0.

>> secrets := لسٽ نئون ; 
	 ⌝'aaa'⌜ ;
	 ⌝''⌜ ; 
	 ⌝'AB'⌜ ;
	 ⌝'abcdefghijklmnopqrstuvwxyz0123456789'⌜ ; 
	 ⌝'!@--+467hdHJKJs__=3hjsakd'⌜ ;
	 ⌝'spaces and	tabs'⌜ ;
	 ⌝'漢字'⌜ ;
	 ⌝'==[abc]=='⌜.
	
>> passwords := secrets نقل.
passwords هر-هڪ: ⎬ :i :p
	secrets هر-هڪ: ⎬ :n :s
		⎬
			>> encrypted := v ڳجهو-ڪريو: s ڪنجي: p.
			>> decrypted := v ڳجهو-کوليو: encrypted ڪنجي: p.
			﴿decrypted = s﴾ جيڪڏهن-سچ: ⎬
				ok جوڙ: 1.
			⎨, نه-ته: ⎬
				آئوٽ-پٽ لکو: ⌝'failed encrypting/decrypting: '⌜, نئين-سٽ.
				آئوٽ-پٽ لکو: s, نئين-سٽ.
				آئوٽ-پٽ لکو: ⌝'encrypted: '⌜ + encrypted, نئين-سٽ.
				آئوٽ-پٽ لکو: ⌝'decrypted: '⌜ + encrypted, نئين-سٽ.
				پروگرام پڄاڻي.
			⎨.
		⎨ پڪڙيو: ⎬ :err
			﴿s = ⌝''⌜ يا: p = ⌝''⌜﴾ جيڪڏهن-سچ: ⎬
				ok جوڙ: 1.
			⎨, نه-ته: ⎬
				آئوٽ-پٽ لکو: err, نئين-سٽ.
				پروگرام پڄاڻي.
			⎨.
		⎨, هلايو.
	⎨.
⎨.

آئوٽ-پٽ لکو: ﴿ ok + ⌝' vault encryptions tested.'⌜ ﴾, نئين-سٽ.