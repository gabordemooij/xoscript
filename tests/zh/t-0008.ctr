>> Greeter := 对象 新建.
Greeter 在: ['make'] 执行: {
	>> greeter := 对象 新建.
	greeter 在: ['name:'] 执行: { :名称
		输出 写入: ['setting a name'].
		拥有 myName := 名称.
	}.
	greeter 在: ['greet'] 执行: {
		输出 写入: ['Hello'].
		输出 写入: 拥有 myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
