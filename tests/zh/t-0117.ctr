>> t := 是.
(t = 是) 是: { 输出 写入: ['T']. }.
(t = 否) 是: { 输出 写入: ['F']. }.
输出 写入: ['|'].
>> t := 否.
(t = 是) 是: { 输出 写入: ['T']. }.
(t = 否) 是: { 输出 写入: ['F']. }.
输出 写入: ['|'].
>> f := 是.
(t = 是 且: f = 否) 是: { 输出 写入: ['T']. }.
(t = 否 且: f = 是) 是: { 输出 写入: ['F']. }.
输出 写入: ['|'].
>> n := 空.
(n 为空?) 是: { 输出 写入: ['T']. }.
(n 为空?) 否: { 输出 写入: ['F']. }.
输出 写入: ['|'].
(f Boolean?) 是: { 输出 写入: ['T']. }.
(f Boolean?) 否: { 输出 写入: ['F']. }.



