
文本 在: ['求值'] 执行: {
	>> 代码 := 文件 新建: ['/tmp/eval.ctr'].
	代码 写入: (自身 转文本 + ['.']).
	程序 使用: ['/tmp/eval.ctr'].
}.

>> map :=
	(映射对象 新建)
	放: ['嗨，你们好'] 在: ['two'],
	放: (数组对象 ← ['hello'] ; ['world'] ; (数组对象 ← 1 ; 2; 9) ; 否) 在: ['一'],
	放: ( (映射对象 新建) 放: ['世介'] 在: ['拼错了'] ) 在: ['three'],
	放: (数组对象 ← ((映射对象 新建) 放: ['宝藏'] 在: ['隐藏']) ; 2) 在: ['四']. 
>> str := map 转文本.
>> map2 := 空.
(['map2 := '] + str ) 求值.
输出 写入: map2 ? ['一'] ? 0.
输出 写入: map2 ? ['一'] ? 1.
输出 写入: map2 ? ['四'] ? 0 ? ['隐藏'].
输出 写入: map2 ? ['一'] ? 2 ? 2.
