

数组对象 在: ['fixture:'] 执行: { :f
	拥有 fixture := f.
}.

数组对象 在: ['计数'] 执行: { <- 拥有 fixture.
}.

数组对象 在: ['aantal'] 执行: { <- 拥有 fixture.
}.


>> x := 空.
{

	x := ['hello'] 
	替换:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] 字符: 2)
			)
		)
	为: (
		(['...hal'] + ['lo']) 
			大写 
			lowecase 
			大写 
			跳过: -1 + ( 
				11 - 12 + (
					(
						(
							(
								数组对象 ← 0 ; 1 ; 4; 9 ; (数组对象 ← 0 ; 3; 1) ; 4
							) 倒数第二
						) ? 1
					) + 
					((数组对象 ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					计数
				)
			)
	).

} × 10.
