
>> Size := 对象 新建.
Size 在: ['is:'] 执行: { :转数值
	转数值 在: ['+'] 执行: { :转数值
		>> unit := 转数值 限定.
		>> factor := 1.
		
		unit
		情况: ['inch'] 执行: { factor := 0.0833. }. <- 自身 + (转数值 * factor).
	}. <- 转数值.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
输出 写入: plank + edge, 停止.
