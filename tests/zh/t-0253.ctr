#Linux
>> OS := 程序 环境变量: ['OS'].

>> clock := 时间对象 新建.
	
(OS = ['Haiku']) 是: {
	clock 时区: ['CET'],
	年: 2017, 月: 7, 日: 13,
	小时: 18, 分钟: 0, 秒: 0.
}, 否则: {
	clock 时区: ['Europe/Amsterdam'],
	年: 2017, 月: 7, 日: 13,
	小时: 18, 分钟: 0, 秒: 0.
}.

clock 在: ['tell'] 执行: {
	输出 写入: 自身, 停止.
}.


clock 加: 2    小时, tell.
clock 加: 1    小时, tell.
clock 加: 19 分钟, tell.
clock 加: 1  分钟, tell.
clock 加: 1  分钟, tell.
clock 加: 19 秒数, tell.
clock 加: 1  秒数, tell.
clock 加: 1  秒数, tell.
clock 加: 2    年份, tell.
clock 加: 1    年份, tell.

(OS = ['Haiku']) 是: {
clock 加: 5   月份.
clock 时区: ['CEST'], tell.
}, 否则: {
	clock 加: 5   月份, tell.
}.

clock 加: 1   月份, tell.
clock 加: 19    日数, tell.
clock 加: 1    小时, tell.
clock 加: 120  yard, tell.
