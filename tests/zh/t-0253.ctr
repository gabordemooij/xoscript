#Linux
>> OS := 程序 环境变量: ['OS'].

>> 时钟 := 时间对象 新建.
	
(OS = ['Haiku']) 是: {
	时钟 时区: ['CET'],
	年: 2017, 月: 7, 日: 13,
	小时: 18, 分钟: 0, 秒: 0.
}, 否则: {
	时钟 时区: ['Europe/Amsterdam'],
	年: 2017, 月: 7, 日: 13,
	小时: 18, 分钟: 0, 秒: 0.
}.

时钟 在: ['报时'] 执行: {
	输出 写入: 自身, 停止.
}.


时钟 加: 2    小时, 报时.
时钟 加: 1    小时, 报时.
时钟 加: 19 分钟, 报时.
时钟 加: 1  分钟, 报时.
时钟 加: 1  分钟, 报时.
时钟 加: 19 秒数, 报时.
时钟 加: 1  秒数, 报时.
时钟 加: 1  秒数, 报时.
时钟 加: 2    年份, 报时.
时钟 加: 1    年份, 报时.

(OS = ['Haiku']) 是: {
时钟 加: 5   月份.
时钟 时区: ['CEST'], 报时.
}, 否则: {
	时钟 加: 5   月份, 报时.
}.

时钟 加: 1   月份, 报时.
时钟 加: 19    日数, 报时.
时钟 加: 1    小时, 报时.
时钟 加: 120  yard, 报时.
