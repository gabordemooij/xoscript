

>> 已用内存1 := 0.
>> 已用内存2 := 0.
>> 已用内存3 := 0.
>> 已用内存4 := 0.

程序 GC模式: 0.

数值 在: ['addNum:'] 执行: { :x
	自身 加: x.
}.

数值 在: ['subtractNum:'] 执行: { :x
	自身 减: x.
}.

数值 在: ['multiplyBy:'] 执行: { :x
	自身 乘: x.
}.

数值 在: ['divideBy:'] 执行: { :x
	自身 除: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 幂: 8).  
a := a + (2 幂: -1). 
a := a + (49 平方根).   
a addNum: ((数组对象 ← 0 ; 1) 最大).          
a addNum: ((数组对象 ← 2 ; 3) 最小).
输出 写入: a.

程序 清扫.

已用内存1 := (程序 内存 ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 幂: 8).  
a := a + (2 幂: -1). 
a := a + (49 平方根).   
a addNum: ((数组对象 ← 0 ; 1) 最大).          
a addNum: ((数组对象 ← 2 ; 3) 最小).
输出 写入: a.

程序 清扫.
已用内存2 := (程序 内存 ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 幂: 8).  
a := a + (2 幂: -1). 
a := a + (49 平方根).   
a addNum: ((数组对象 ← 0 ; 1) 最大).          
a addNum: ((数组对象 ← 2 ; 3) 最小).
输出 写入: a.

程序 清扫.
已用内存3 := (程序 内存 ? 0).



( 已用内存1 = 已用内存2 且: 已用内存1 = 已用内存3, 且: 已用内存2 = 已用内存3 ) 是: {
	输出 写入: ['这里没有内存泄漏'].
}, 否: {
	输出 写入: ['内存泄漏中...'].
}.
