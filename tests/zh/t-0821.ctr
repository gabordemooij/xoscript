# 永不闭合的引号必须报错，而不是无限循环
>> 路径 := ['/tmp/test0821.csv'].
>> file := 文件 新建: 路径.

file 写入: ['a,b\n"1,2\n'].
{
	file 分隔: [','] 引号: ['"'] 行: { :line
		输出 写入: line, 停止.
	}.
} 捕获: { :e 输出 写入: e, 停止. }, 运行.

# 闭合的引号仍然正常工作
file 写入: ['a,b\n"1,2",3'].
file 分隔: [','] 引号: ['"'] 行: { :line
	输出 写入: line, 停止.
}.
file 删除.
