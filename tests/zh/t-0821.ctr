# a quote that never closes must give an error, not an endless loop
>> 路径 := ['/tmp/test0821.csv'].
>> file := 文件 新建: 路径.

file 写入: ['a,b\n"1,2\n'].
{
	file 分隔: [','] 引号: ['"'] 行: { :line
		输出 写入: line, 停止.
	}.
} 捕获: { :e 输出 写入: e, 停止. }, 运行.

# a closed quote still works
file 写入: ['a,b\n"1,2",3'].
file 分隔: [','] 引号: ['"'] 行: { :line
	输出 写入: line, 停止.
}.
file 删除.
