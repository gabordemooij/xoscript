# 此测试检查 string_fill_in 在模式 4 下不会丢失其槽位（被 gc 回收）
# 参见 world.c
>> 日志器 := 对象 新建.

日志器 在: ['say:'] 执行: { :str
	输出 写入: str, 停止.
}.

>> 物品类 := 对象 新建.

物品类 在: ['新建:'] 执行: { :id
	<- 自身 新建 id: id.
}.

物品类 在: ['id:'] 执行: { :id
	拥有 id := id.
}.

物品类 在: ['id'] 执行: { <- 拥有 id. }.


物品类 在: ['转文本'] 执行: {
	>> str := ['Item#~no'].
	str ~no: 拥有 id.
	<- str.
}.


>> Print := 对象 新建.

Print 在: ['items'] 执行: { 
	
	拥有 物品 := 物品类 新建: 1.
	
	# 否则这里会段错误或字符串出错
	日志器 say: (
		['~item printed.'] ~item: 拥有 物品
	).
	
	
}.

Print items.