

>> Matryoshka := 对象 新建.
Matryoshka 在: ['double:'] 执行: { :secret
	拥有 secret := secret × 2.
}.
Matryoshka 在: ['新建:'] 执行: { :secret
	>> answer := 空.
	>> t := (secret > 255).
	输出 写入: (secret + [' | '] + t), 停止.
	t 是: {
		answer := secret.
	}, 否则: {
		answer := Matryoshka 递归 新建: (自身 double: secret).
	}. <- answer.
}.

>> x := Matryoshka 新建: 2.
