# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := 保险库 生成加密密钥.

# private (secret) key
>> sk := keys 第一个.

# public key
>> pk := keys 最后.

# sign a message
>> sig := 保险库 签名: ['abc'] 用: sk.

# check message (ok)
输出 写入: ( 
	保险库
		验证: ['abc'] 
		签名: sig 
		用: pk 
), 停止.

# check message (fail)
输出 写入: ( 
	保险库 
		验证: ['abd'] 
		签名: sig 
		用: pk 
), 停止.