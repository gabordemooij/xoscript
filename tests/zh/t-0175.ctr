

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> x := 100.

程序 GC模式: 0.

{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt 追加: ['!!'].
输出 写入: txt.
} 运行.

程序 清扫.

usedMemory1 := (程序 内存 ? 0).


{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt 追加: ['!!'].
输出 写入: txt.
} 运行.

程序 清扫.
usedMemory2 := (程序 内存 ? 0).


{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt 追加: ['!!'].
输出 写入: txt.
} 运行.

程序 清扫.
usedMemory3 := (程序 内存 ? 0).



( usedMemory1 = usedMemory2 且: usedMemory1 = usedMemory3, 且: usedMemory2 = usedMemory3 ) 是: {
	输出 写入: ['No memory leaks here'].
}, 否: {
	输出 写入: ['Leaking memory...'].
}.
