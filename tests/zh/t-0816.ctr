# a format must fit the type of the value, the type can come from a client
>> 尝试 := { :format :value
	{ 输出 写入: ( (格式 新建: format) 应用: value ), 停止. } 捕获: { :e 输出 写入: e, 停止. }, 运行.
}.
>> try-int := { :format :value
	{ 输出 写入: ( (格式 新建: format) 应用-整数: value ), 停止. } 捕获: { :e 输出 写入: e, 停止. }, 运行.
}.

# fits
尝试 应用: ['|%s|'] 和: ['text'].
尝试 应用: ['%06.2f'] 和: 5.5.
尝试 应用: ['100%% %s'] 和: ['sure'].
try-int 应用: ['%03d'] 和: 7.
try-int 应用: ['%x'] 和: 255.
尝试 应用: ['%d'] 和: (Int64 新建 从字符串: ['12']).
尝试 应用: ['%lld'] 和: (Int64 新建 从字符串: ['12']).
尝试 应用: ['%.1lf'] 和: 5.5.
try-int 应用: ['%hd'] 和: 7.

# does not fit
尝试 应用: ['%s'] 和: 12345.
尝试 应用: ['%d'] 和: 12345.
尝试 应用: ['%f'] 和: ['text'].
try-int 应用: ['%d'] 和: ['text'].
try-int 应用: ['%s'] 和: 5.
尝试 应用: ['%s %s'] 和: ['text'].
尝试 应用: ['%n'] 和: ['text'].
尝试 应用: ['%*s'] 和: ['text'].
尝试 应用: ['%'] 和: ['text'].

# length modifier does not fit
尝试 应用: ['%ls'] 和: ['text'].
尝试 应用: ['%Lf'] 和: 5.5.
try-int 应用: ['%ld'] 和: 7.
try-int 应用: ['%lld'] 和: 7.
尝试 应用: ['%Ld'] 和: (Int64 新建 从字符串: ['12']).

# a width that does not fit printf must give an error, not a crash
尝试 应用: ['%99999999999s'] 和: ['text'].
