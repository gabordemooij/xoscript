#Linux
>> 时钟 := 时间对象 新建.
时钟 时区: ['UTC-1'].
时钟 年: 1981, 月: 1, 日: 5,
      小时: 13, 分钟: 15, 秒: 13.

输出 写入: 时钟, 停止.
时钟 时区: ['UTC+0'].

输出 写入: (
	(时钟 年份 原始) + ['-'] + (时钟 月份) + ['-'] + (时钟 日数) + [' '] +
	(时钟 小时) + [':'] + (时钟 分钟) + [':'] + (时钟 秒数) + [' '] +
	['W'] + (时钟 周数) + (时钟 时区)
), 停止.


时钟 时区: ['UTC-1'].
输出 写入: (
	(时钟 年份 原始) + ['-'] + (时钟 月份) + ['-'] + (时钟 日数) + [' '] +
	(时钟 小时) + [':'] + (时钟 分钟) + [':'] + (时钟 秒数) + [' '] +
	['W'] + (时钟 周数) + (时钟 时区)
), 停止.
