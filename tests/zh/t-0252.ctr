#Linux
>> clock := 时间对象 新建.
clock 时区: ['UTC-1'].
clock 年: 1981, 月: 1, 日: 5,
      小时: 13, 分钟: 15, 秒: 13.

输出 写入: clock, 停止.
clock 时区: ['UTC+0'].

输出 写入: (
	(clock 年份 原始) + ['-'] + (clock 月份) + ['-'] + (clock 日数) + [' '] +
	(clock 小时) + [':'] + (clock 分钟) + [':'] + (clock 秒数) + [' '] +
	['W'] + (clock 周数) + (clock 时区)
), 停止.


clock 时区: ['UTC-1'].
输出 写入: (
	(clock 年份 原始) + ['-'] + (clock 月份) + ['-'] + (clock 日数) + [' '] +
	(clock 小时) + [':'] + (clock 分钟) + [':'] + (clock 秒数) + [' '] +
	['W'] + (clock 周数) + (clock 时区)
), 停止.
