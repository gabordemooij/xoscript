


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

程序 GC模式: 0.
>> palette := 空.
>> colors := 空.

{
palette := 映射对象 新建.
palette 
	放: ['#F00'] 在: ['red'],
	放: ['#0F0'] 在: ['green'],
	放: ['#00F'] 在: ['blue'].
输出 写入: ['number of RGB codes in palette: '] + ( palette 计数 ), 停止.
输出 写入: ['RGB code of green is: '] + ( palette ? ['green'] ), 停止.
colors := [''].
( palette 每个: { :名称 :代码
		colors := colors + ( 名称 + [':'] + 代码 ).
} ).
输出 写入: ['All colors in palette: '] + colors, 停止.
} 运行.
程序 清扫.
usedMemory1 := (程序 内存 ? 0).

