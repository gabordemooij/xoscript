


>> 已用内存1 := 0.
>> 已用内存2 := 0.
>> 已用内存3 := 0.
>> 已用内存4 := 0.

程序 GC模式: 0.
>> 调色板 := 空.
>> 颜色列表 := 空.

{
调色板 := 映射对象 新建.
调色板 
	放: ['#F00'] 在: ['红色'],
	放: ['#0F0'] 在: ['绿色'],
	放: ['#00F'] 在: ['蓝色'].
输出 写入: ['调色板中的 RGB 代码数: '] + ( 调色板 计数 ), 停止.
输出 写入: ['绿色的 RGB 代码是: '] + ( 调色板 ? ['绿色'] ), 停止.
颜色列表 := [''].
( 调色板 每个: { :名称 :代码
		颜色列表 := 颜色列表 + ( 名称 + [':'] + 代码 ).
} ).
输出 写入: ['调色板中的所有颜色: '] + 颜色列表, 停止.
} 运行.
程序 清扫.
已用内存1 := (程序 内存 ? 0).

