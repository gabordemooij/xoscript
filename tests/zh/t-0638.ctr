
Server init.
>> 请求 := 互联网请求 新建.
输出 写入: ['HTTP-GET d[]=']  + ( 请求 搜索词列表: ['d[]'] ), 停止. # GET
输出 写入: ['HTTP-GET f[]=']  + ( 请求 搜索词列表: ['f[]'] ), 停止. # GET
输出 写入: ['HTTP-POST e[]='] + ( 请求 表单数据: ['e[]'] ), 停止. # GET
输出 写入: ['HTTP-POST c=']   + ( 请求 表单输入: ['c'] ), 停止. # GET
输出 写入: ['HTTP-POST xx=']  + ( 请求 表单输入: ['xx'] ), 停止. # GET
