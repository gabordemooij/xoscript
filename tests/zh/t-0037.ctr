>> a := 3.
>> b := a 复制.
a 减: 1.
输出 写入: [' a = '] + a.
输出 写入: [' b = '] + b.
a := 3.
b := a + 4.
输出 写入: [' a = '] + a.
输出 写入: [' b = '] + b.
>> x := 3.
>> y := x 复制.
x 加: 10.
y 减: 1.
输出 写入: [' x = '] + x.
输出 写入: [' y = '] + y.
>> q := 对象 新建.
q 在: ['setProperty:'] 执行: { :x
	拥有 属性 := x.
}.
q 在: ['取得属性'] 执行: { <- 拥有 属性.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
输出 写入: [' p = '] + (p 取得属性).
