>> Animal := 对象 新建.
Animal 在: ['make'] 执行: {
	>> animal := 对象 新建.
	animal 在: ['makeSound'] 执行: {
		输出 写入: 拥有 sound.
	}. <- animal.
}.
>> Cat := 对象 新建.
Cat 在: ['make'] 执行: {
	>> cat := Animal make.
	cat 在: ['init'] 执行: {
		拥有 sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
