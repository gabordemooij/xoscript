Server init.

输出 写入: (
	模式 新建: ['^\\w+$'],
	匹配: ['test@example.com'] 
), 停止. # 0 个匹配，在 @ 和 . 处失败

输出 写入: (
	模式 新建: ['^[^@]+@[^\.]+\.\\w+$'],
	匹配: ['test@example.com'] 
), 停止. # 1 个匹配

输出 写入: (
	模式 新建: ['[^@]+@[^\.]+\.\\w+'],
	匹配: ['test@example.com'] 
), 停止. # 1 个匹配

输出 写入: (
	模式 新建: ['([^@]+)@([^\.]+)\.\\w+'],
	匹配: ['test@example.com'] 
), 停止. # 1 个匹配，分组无关紧要

输出 写入: (
	模式 新建: ['[a-z]'],
	匹配: ['test@example.com'] 
), 停止. # 14 个匹配

输出 写入: (
	模式 新建: ['.*'],
	匹配: ['test@example.com'] 
), 停止. # 1 个匹配（全部）

输出 写入: (
	模式 新建: ['(.*)'],
	匹配: ['test@example.com'] 
), 停止. # 1 个匹配（全部）

输出 写入: (
	模式 新建: ['\\s*[^@]+@[^\.]+\.\\w+'],
	匹配: ['test@example.com'] 
), 停止. # 1 个匹配，前缀空格可选，会被忽略