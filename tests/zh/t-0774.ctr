输出 写入: ['测试对象'], 停止.
>> a := 对象 新建. 
a 在: ['item:'] 执行: { :列表
	拥有 列表 := 列表. 
}.
a 在: ['物品'] 执行: {
	<- 拥有 列表.
}.
a item: (
	数组对象 新建 ; 1 ; (
		数组对象 新建 ; ['a'] ; (
			数组对象 新建 ; ( 时间对象 新建: 1 )
		) ; ( Int64 从字符串: ['321'] )
	)
).
