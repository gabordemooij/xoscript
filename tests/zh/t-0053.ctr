60 × {
	>> x := (数值 random % 6) + 1.
	(x ≤ 6) 否: { 输出 写入: ['FAIL']. }.
	(x ≥0) 否: { 输出 写入: ['FAIL']. }.
	x := (数值 random % 3) + 1.
	(x < 3) 否: { 输出 写入: ['FAIL']. }.
	(x>-1) 否: { 输出 写入: ['FAIL']. }.
	x := ((布尔 flip) 转数值).
	(x = 0 或: x = 1) 否: { 输出 写入: ['FAIL']. }.
	x := ((是 flip) 转数值).
	(x = 0 或: x = 1) 否: { 输出 写入: ['FAIL']. }.
	x := (布尔 flip 或: ['HEAD'] 或: ['TAIL']).
	((x = ['HEAD']) 或: (x = ['TAIL'])) 否: { 输出 写入: ['FAIL']. }.
}.
输出 写入: ['DONE'].

