60 × {
	>> x := (数值 随机 % 6) + 1.
	(x ≤ 6) 否: { 输出 写入: ['失败']. }.
	(x ≥0) 否: { 输出 写入: ['失败']. }.
	x := (数值 随机 % 3) + 1.
	(x < 3) 否: { 输出 写入: ['失败']. }.
	(x>-1) 否: { 输出 写入: ['失败']. }.
	x := ((布尔 翻转) 转数值).
	(x = 0 或: x = 1) 否: { 输出 写入: ['失败']. }.
	x := ((是 翻转) 转数值).
	(x = 0 或: x = 1) 否: { 输出 写入: ['失败']. }.
	x := (布尔 翻转 或: ['正面'] 或: ['反面']).
	((x = ['正面']) 或: (x = ['反面'])) 否: { 输出 写入: ['失败']. }.
}.
输出 写入: ['已完成'].

