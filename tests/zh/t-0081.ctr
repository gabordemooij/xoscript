>> 映射1 := 映射对象 新建.
>> 键1 := 数组对象 新建.
>> 键2 := 数组对象 新建.

映射1
	放: ['hello'] 在: 键1,
	放: ['world'] 在: 键2.


输出
	写入: ['Map #1 contains: '] + (映射1 在: 键1),
	写入: [' 和 '] + (映射1 在: 键2), 停止.

>> 可键数组 := 数组对象 新建.
可键数组 在: ['转字符串'] 执行: { <- (自身 计数) 转字符串.
}.

>> map2 := 映射对象 新建.
键1 := 可键数组 新建.
键2 := 可键数组 新建.

键1 追加: 1.

map2
	放: ['hello'] 在: 键1,
	放: ['world'] 在: 键2.

输出
	写入: ['Map #2 contains: '] + (map2 在: 键1),
	写入: [' 和 '] + (map2 在: 键2), 停止.
