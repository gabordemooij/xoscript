>> map1 := 映射对象 新建.
>> key1 := 数组对象 新建.
>> key2 := 数组对象 新建.

map1
	放: ['hello'] 在: key1,
	放: ['world'] 在: key2.


输出
	写入: ['Map #1 contains: '] + (map1 在: key1),
	写入: [' and '] + (map1 在: key2), 停止.

>> KeyeableArray := 数组对象 新建.
KeyeableArray 在: ['toString'] 执行: { <- (自身 计数) toString.
}.

>> map2 := 映射对象 新建.
key1 := KeyeableArray 新建.
key2 := KeyeableArray 新建.

key1 追加: 1.

map2
	放: ['hello'] 在: key1,
	放: ['world'] 在: key2.

输出
	写入: ['Map #2 contains: '] + (map2 在: key1),
	写入: [' and '] + (map2 在: key2), 停止.
