# catch-all test (practical)
>> HTML := 文本 新建.
HTML 在: ['encode:'] 执行: { :tekst
	自身 追加: (tekst
	替换: ['&'] 为: ['&amp;'], 
	替换: ['<'] 为: ['&lt;'],
	替换: ['>'] 为: ['&gt;'],
	替换: ['"'] 为: ['&quot;']).
}.
>> blog := HTML 新建.
blog 追加: ['<h1>'],
     encode: ['Koffie & Thee'],
     追加: ['</h1>'].
输出 写入: blog, 停止.


>> Roman := 数值 新建.
Roman 在: ['stringy'] 执行: {
	>> a := [''].
	{ a 追加: ['I']. } × 自身. <- a.
}.

>> x := Roman 新建.
x 加: 3.
输出 写入: x stringy, 停止.

>> Quantum := 布尔 新建.
Quantum 在: ['true?'] 执行: { <- ['maybe True']. }.
输出 写入: (Quantum 新建 true?), 停止.

>> Nihil := 空 新建.
Nihil 在: ['转文本'] 执行: { <- ['Nihil']. }.
输出 写入: (Nihil 新建), 停止.
