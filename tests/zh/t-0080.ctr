{
	>> a := 数组对象 新建.
	a 追加: 1.
	a 追加: 2.
	输出 写入: (a 连接: [',']), 停止.
	a 放: 3 在: 2.
	输出 写入: (a 连接: [',']), 停止.
	a 放: 4 在: 10.
	输出 写入: (a 连接: [',']), 停止.
	a 左移.
	a 左移.
	a 左移.
	输出 写入: (a 连接: [',']), 停止.
	a 放: 9 在: 0.
	输出 写入: (a 连接: [',']), 停止.
	a 放: 6 在: -1.
} 捕获: { :e
	输出 写入: ['Uncatched error has occurred.↵'] + e, 停止.
}, 运行.


