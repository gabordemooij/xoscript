
文本 在: ['互联网文档'] 执行: { <- (
		自身
		替换: ['&'] 为: ['&amp;'],
		替换: ['<'] 为: ['&lt;'],
		替换: ['>'] 为: ['&gt;'],
		替换: ['"'] 为: ['&quot;']
	).
}.

>> HTML画笔 := 对象 新建.

HTML画笔 在: ['响应:'] 执行: { :标签
	输出 写入: (['<tag>↵'] tag: 标签 ).
}.

HTML画笔 在: ['响应:参数:'] 执行: { :标签 :content
	标签 := ( 标签 从: 0 长度: (标签 长度 - 1) ).
	输出 写入: (['<tag content>↵'] tag: 标签, content: content).
}.

HTML画笔 在: ['content:'] 执行: { :文字
	输出 写入: 文字 互联网文档, 停止.
}.

HTML画笔 在: ['属性名:属性值:'] 执行: { :属性名 :value <- ['attr="value"'] attr: 属性名, value: value.
}.

>> h := HTML画笔 新建.


h 互联网文档
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h 属性名: ['class'] 属性值: ['bold']),
		/span
	/body
/html.
		
