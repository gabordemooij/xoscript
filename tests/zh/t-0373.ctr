# 兼容性测试

# 使用国际数字格式

输出 写入: ['1000 -> '].
输出 写入: 1000, 停止. #1000

输出 写入: ['1.5 -> '].
输出 写入: 1.5, 停止.  #1.5

输出 写入: ['1001.5 -> '].
输出 写入: 1.5 + 1000, 停止. #1001.5

# 使用从 0 开始索引的数组
>> x := 数组对象 新建 ; 1 ; 2 ; 3.
>> y := 数组对象 新建 ; ['a'] ; ['b'] ; ['c'].

输出 写入: ['1 -> '].
输出 写入: x ? 0, 停止. #1

输出 写入: ['1 -> '].
输出 写入: (x 在: 0), 停止. #1

输出 写入: ['1 -> '].
输出 写入: x 第一个, 停止. #1

输出 写入: ['3 -> '].
输出 写入: x 最后, 停止. #3

输出 写入: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
输出 写入: (x 按: y), 停止.

输出 写入: ['1 -> '].
输出 写入: (x 从: 0 长度: 1) 第一个, 停止. #1

输出 写入: ['0 -> '].
输出 写入: (x 查找: 1), 停止. #0

x 放: 9 在: 0.

输出 写入: ['9 -> '].
输出 写入: (x 在: 0), 停止. #9

x 前置: 8.
输出 写入: ['8 -> '].
输出 写入: (x 在: 0), 停止. #9


x 追加: 10.
输出 写入: ['10 -> '].
输出 写入: (x 在: 4), 停止. #10








