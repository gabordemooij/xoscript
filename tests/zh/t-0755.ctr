输出 写入: ['Test object'], 停止.
>> greeter := 对象 新建.
greeter 在: ['name:'] 执行: { :名称
	拥有 xname := 名称. 
}.
greeter 在: ['greet'] 执行: {
	输出 写入: ['Hello '] + 拥有 xname, 停止.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
输出 写入: ['========== RELOADING SNAP:'], 停止.
>> b := 对象 load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
