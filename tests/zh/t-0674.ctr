# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> 路径 := ['/tmp/dat.csv'].
>> csv := 文件 新建: 路径.
csv 写入: s.

# accepts CRLF LF CR, varying row length
csv 分隔: [';'] 引号: ['"'] 行: { :line
	程序 清扫.
	输出 写入: line, 停止.
	程序 清扫.
}.

# unequal lines
s 追加: ['\njustone'].
csv 写入: s.
{
	csv 分隔: [';'] 引号: ['"'] 行: { :line
		输出 写入: line, 停止.
	}.
} 捕获: { :e 
	输出 写入: e, 停止.
}, 运行.

# invalid format
s := ['"he"llo";world'].
csv 写入: s.
{
	csv 分隔: [';'] 引号: ['"'] 行: { :line
		输出 写入: line, 停止.
	}.
} 捕获: { :e 
	输出 写入: e, 停止.
}, 运行.
