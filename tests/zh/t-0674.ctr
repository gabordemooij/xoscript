# 正常流程
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> 路径 := ['/tmp/dat.csv'].
>> csv := 文件 新建: 路径.
csv 写入: s.

# 接受 CRLF LF CR，行长度可以不同
csv 分隔: [';'] 引号: ['"'] 行: { :line
	程序 清扫.
	输出 写入: line, 停止.
	程序 清扫.
}.

# 行长度不一致
s 追加: ['\njustone'].
csv 写入: s.
{
	csv 分隔: [';'] 引号: ['"'] 行: { :line
		输出 写入: line, 停止.
	}.
} 捕获: { :e 
	输出 写入: e, 停止.
}, 运行.

# 无效格式
s := ['"he"llo";world'].
csv 写入: s.
{
	csv 分隔: [';'] 引号: ['"'] 行: { :line
		输出 写入: line, 停止.
	}.
} 捕获: { :e 
	输出 写入: e, 停止.
}, 运行.
