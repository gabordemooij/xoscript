# 测试 utf8 清理器
Server init.

>> utf8用例 := 映射对象 新建
	# 仅 ASCII
	放: ( 数组对象 新建 ; 65 ; 65 ; 65 ; 65 ; 0 ) 在: ['AAAA'],
	# 有效的 2 字节序列
	放: ( 数组对象 新建 ; 194 ; 162 ; 0 ) 在: ['¢'],
	# 有效的 3 字节 UTF-8
    放: ( 数组对象 新建 ; 226 ; 130 ; 172 ; 0 ) 在: ['€'],
	# 有效的 4 字节 UTF-8
    放: ( 数组对象 新建 ; 240 ; 144 ; 141 ; 136 ; 0 ) 在: ['𐍈'],
	# 序列 E2 28 AC 中的无效续字节 -> 开始 3 字节序列 + 28 错误续字节 + AC 续字节，但属于同一个错误
    放: ( 数组对象 新建 ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) 在: ['A?A'],
	# ASCII 'A' 的超长编码（应变为 ?），
    放: ( 数组对象 新建 ; 65 ; 193 ; 129 ; 0 ) 在: ['A?'],
	# 无效的首字节（0xFF）
    放: ( 数组对象 新建 ; 255 ; 0 ) 在: ['?'],
	# 末尾不完整的多字节序列
    放: ( 数组对象 新建 ; 66 ; 226 ; 0 ) 在: ['B?'],
    # 空字符串
    #put: ( List new ) at: [''],
	# 多个混合序列
    放: ( 数组对象 新建 ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) 在: ['A€?𐍈B'].
	 
utf8用例 每个: { :key :value
	>> 二进制对象 := 二进制 新建: value 计数, 字节: value.
	>> str := 二进制对象 转文本.
	(str = key) 是: {
		输出 写入: ['OK'], 停止.
	}, 否则: {
		输出 写入: ['UTF8 清理失败: '] + key + [' 得到: '] + str, 停止.
	}.
	二进制对象 释放.
}.
