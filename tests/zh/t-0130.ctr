# 通过 Server 插件使用 FFI

# 连接到 libc（与平台相关）
>> 库名 := 程序 环境变量: ['FFITESTLIB'].

# 从 C 链接 stdio 函数，用于高级文件操作
Server 链接: ( 数组对象 新建 ;
 库名 ; ['fopen'] ;
 ( 数组对象 新建 ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
链接: ( 数组对象 新建 ;
 空 ; # 表示同一个库
 ['fread'] ;
 ( 数组对象 新建 ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 空 ; # 表示同一个对象（即 流）
 ['fread']
),
链接: (
 数组对象 新建 ;
 空 ; # 表示同一个库
 ['fwrite'] ;
 ( 数组对象 新建 ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 空 ; # 表示同一个库
 ['fwrite']
),
链接: (
 数组对象 新建 ;
 空 ; # 表示同一个库
 ['rewind'] ;
 ( 数组对象 新建 ; ['pointer'] ) ;
 ['int'] ;
 空 ; # 表示同一个库
 ['rewind:']
).

>> str  := 二进制 可读的: ['abc123'].
>> 路径 := 二进制 可读的: ['/tmp/bla.txt'].
>> mode := 二进制 可读的: ['w+'].

# 用 fopen(path, mode) 打开文件
>> fd := Stream path: 路径 mode: mode.

# 把缓冲区 str 中的字节写入文件
>> 已写字节数 := Stream 消息: ['fwrite'] 参数: (数组对象 新建 ; str ; 1 ; 6 ; fd ).
输出 写入: 已写字节数, 停止.

# 将文件指针倒回开头
Stream rewind: fd.

# 分配缓冲区
>> 缓冲 := 二进制 新建: 20.

# 从文件读取
>> 已读字节数 := Stream 消息: ['fread'] 参数: (数组对象 新建 ; 缓冲 ; 1 ; 6 ; fd ).
输出 写入: 已读字节数, 停止.
输出 写入: 缓冲, 停止.

# 释放内存
str  释放.
路径 释放.
mode 释放.
缓冲  释放.


