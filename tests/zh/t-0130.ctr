# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := 程序 环境变量: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server 链接: ( 数组对象 新建 ;
 libname ; ['fopen'] ;
 ( 数组对象 新建 ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
链接: ( 数组对象 新建 ;
 空 ; # means same lib
 ['fread'] ;
 ( 数组对象 新建 ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 空 ; # means same object (i.e. Stream)
 ['fread']
),
链接: (
 数组对象 新建 ;
 空 ; # means same lib
 ['fwrite'] ;
 ( 数组对象 新建 ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 空 ; # means same lib
 ['fwrite']
),
链接: (
 数组对象 新建 ;
 空 ; # means same lib
 ['rewind'] ;
 ( 数组对象 新建 ; ['pointer'] ) ;
 ['int'] ;
 空 ; # means same lib
 ['rewind:']
).

>> str := 二进制 可读的: ['abc123'].
>> 路径 := 二进制 可读的: ['/tmp/bla.txt'].
>> mode := 二进制 可读的: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: 路径 mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream 消息: ['fwrite'] 参数: (数组对象 新建 ; str ; 1 ; 6 ; fd ).
输出 写入: bytes-written, 停止.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := 二进制 新建: 20.

# read from file
>> bytes-read := Stream 消息: ['fread'] 参数: (数组对象 新建 ; buf ; 1 ; 6 ; fd ).
输出 写入: bytes-read, 停止.
输出 写入: buf, 停止.

# free memory
str  释放.
路径 释放.
mode 释放.
buf  释放.


