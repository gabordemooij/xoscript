# test url parsing

Server init.
>> url := URL 从: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

输出 写入: ['scheme = '] + url 协议, 停止.
输出 写入: ['host = '] + url 主机, 停止.
输出 写入: ['port = '] + url 端口, 停止.
输出 写入: ['path = '] + url 路径, 停止.
输出 写入: ['query = '] + url 参数, 停止.
输出 写入: ['fragment = '] + url 片段, 停止.
