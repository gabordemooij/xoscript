数组对象 在: ['求和'] 执行: {
	>> 总计 := 0.
	自身 每个: { :索引 :元素
		总计 加: 元素.
	}. <- 总计.
}.

>> a := 是.



a 在: ['转文本'] 执行: {
	>> 答案 := 空.
	( 自身 = 是 ) 是: {
		答案 := ['没错'].
	}, 否则: {
		答案 := ['不对'].
	}. <- 答案.
}.

a 在: ['转数值'] 执行: {
	>> 答案 := 空.
	( 自身 = 是 ) 是: {
		答案 := 10.
	}, 否则: {
		答案 := 20.
	}. <- 答案.
}.

>> b := 666.

b 在: ['转文本'] 执行: { <- ['恶魔'].
}.

b 在: ['转布尔'] 执行: { <- 否.
}.


输出 写入: a, 停止.  
输出 写入: (90 + a), 停止. 
输出 写入: b, 停止. 
输出 写入: (是 且: b), 停止.

a := 数组对象 ← ['hello'] ; ['world'] ; 是 ; 空 ; 666. 
a := a + ( 数组对象 ← 1 ).
输出 写入: a, 停止.
输出 写入: ((映射对象 新建) 放: 空 在: 空), 停止.
输出 写入: a 求和, 停止. 


{
	a 在: ['转文本'] 执行: { <- 空. }.
	a := [''] + a.
} 捕获: { :错误信息
	输出 写入: ['已记录错误: '] + 错误信息, 停止.
}, 运行.



{
	a 在: ['转数值'] 执行: { <- 空. }.
	a := 3 × a.
} 捕获: { :错误信息
	输出 写入: ['已记录错误: '] + 错误信息, 停止.
}, 运行.


{
	a 在: ['转布尔'] 执行: { <- 空. }.
	a := 是 且: a. 
} 捕获: { :错误信息
	输出 写入: ['已记录错误: '] + 错误信息, 停止.
}, 运行.





