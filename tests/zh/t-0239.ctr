数组对象 在: ['sum'] 执行: {
	>> total := 0.
	自身 每个: { :index :element
		total 加: element.
	}. <- total.
}.

>> a := 是.



a 在: ['转文本'] 执行: {
	>> answer := 空.
	( 自身 = 是 ) 是: {
		answer := ['Yep'].
	}, 否则: {
		answer := ['Nope'].
	}. <- answer.
}.

a 在: ['转数值'] 执行: {
	>> answer := 空.
	( 自身 = 是 ) 是: {
		answer := 10.
	}, 否则: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b 在: ['转文本'] 执行: { <- ['Devil'].
}.

b 在: ['转布尔'] 执行: { <- 否.
}.


输出 写入: a, 停止.  
输出 写入: (90 + a), 停止. 
输出 写入: b, 停止. 
输出 写入: (是 且: b), 停止.

a := 数组对象 ← ['hello'] ; ['world'] ; 是 ; 空 ; 666. 
a := a + ( 数组对象 ← 1 ).
输出 写入: a, 停止.
输出 写入: ((映射对象 新建) 放: 空 在: 空), 停止.
输出 写入: a sum, 停止. 


{
	a 在: ['转文本'] 执行: { <- 空. }.
	a := [''] + a.
} 捕获: { :error
	输出 写入: ['Error noted: '] + error, 停止.
}, 运行.



{
	a 在: ['转数值'] 执行: { <- 空. }.
	a := 3 × a.
} 捕获: { :error
	输出 写入: ['Error noted: '] + error, 停止.
}, 运行.


{
	a 在: ['转布尔'] 执行: { <- 空. }.
	a := 是 且: a. 
} 捕获: { :error
	输出 写入: ['Error noted: '] + error, 停止.
}, 运行.





