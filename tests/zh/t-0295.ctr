
>> dictionary := (
	映射对象 新建
		放: ['b'] 在: ['a'],
		放: ['a'] 在: ['b'],
		放: ['z'] 在: ['x'],
		放: ['hello'] 在: ['hallo'],
		放: ['human'] 在: ['human']
).

>> comparisons := 数组对象 新建.
dictionary 每个: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a 比较: b)
	).
}.

comparisons 排序: { :a :b <- ( a 比较: b ). }.
输出 写入: ( comparisons 连接: ['↵'] ), 停止.
comparisons 连接: ['↵'].
