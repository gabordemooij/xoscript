

数组对象 在: ['sum'] 执行: {
	>> total := 0.
	自身 每个: { :index :element
		total 加: element.
	}. <- total.
}.

数组对象 在: ['product'] 执行: {
	>> total := 1.
	自身 每个: { :index :element
		total 乘: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

程序 GC模式: 0.

{

>> a := 数组对象 ← ['hello'] ; ['world'] ; 是 ; 空 ; 666.
a := a + ( 数组对象 ← 1 ).
输出 写入: ( ['sum: '] + ( a sum ) ), 停止.
输出 写入: ( ['min: '] + ( a 最小 ) ), 停止.
输出 写入: ( ['max: '] + ( a 最大 ) ), 停止.
输出 写入: ( ['3rd: '] + ( a ? 2 ) ), 停止.
输出 写入: ( ['prd: '] + ( a product ) ), 停止.
a 排序: { :a :b <- (b - a). }.
a 每个: { :i :e 输出 写入: ( i - 0 ), 停止. }.

} 运行.

程序 清扫.
usedMemory1 := (程序 内存 ? 0).


{

>> a := 数组对象 ← ['hello'] ; ['world'] ; 是 ; 空 ; 666.
a := a + ( 数组对象 ← 1 ).
输出 写入: ( ['sum: '] + ( a sum ) ), 停止.
输出 写入: ( ['min: '] + ( a 最小 ) ), 停止.
输出 写入: ( ['max: '] + ( a 最大 ) ), 停止.
输出 写入: ( ['3rd: '] + ( a ? 2 ) ), 停止.
输出 写入: ( ['prd: '] + ( a product ) ), 停止.
a 排序: { :a :b <- (b - a). }.
a 每个: { :i :e 输出 写入: ( i - 0 ), 停止. }.

} 运行.



程序 清扫.
usedMemory2 := (程序 内存 ? 0).


{

>> a := 数组对象 ← ['hello'] ; ['world'] ; 是 ; 空 ; 666.
a := a + ( 数组对象 ← 1 ).
输出 写入: ( ['sum: '] + ( a sum ) ), 停止.
输出 写入: ( ['min: '] + ( a 最小 ) ), 停止.
输出 写入: ( ['max: '] + ( a 最大 ) ), 停止.
输出 写入: ( ['3rd: '] + ( a ? 2 ) ), 停止.
输出 写入: ( ['prd: '] + ( a product ) ), 停止.
a 排序: { :a :b <- (b - a). }.
a 每个: { :i :e 输出 写入: ( i - 0 ), 停止. }.

} 运行.



程序 清扫.
usedMemory3 := (程序 内存 ? 0).

( usedMemory1 = usedMemory2 且: usedMemory1 = usedMemory3, 且: usedMemory2 = usedMemory3 ) 是: {
	输出 写入: ['No memory leaks here'].
}, 否: {
	输出 写入: ['Leaking memory...'].
}.
