

数组对象 在: ['求和'] 执行: {
	>> 总计 := 0.
	自身 每个: { :索引 :元素
		总计 加: 元素.
	}. <- 总计.
}.

数组对象 在: ['乘积'] 执行: {
	>> 总计 := 1.
	自身 每个: { :索引 :元素
		总计 乘: 元素.
	}. <- 总计.
}.

>> 已用内存1 := 0.
>> 已用内存2 := 0.
>> 已用内存3 := 0.
>> 已用内存4 := 0.

程序 GC模式: 0.

{

>> a := 数组对象 ← ['hello'] ; ['world'] ; 是 ; 空 ; 666.
a := a + ( 数组对象 ← 1 ).
输出 写入: ( ['总和: '] + ( a 求和 ) ), 停止.
输出 写入: ( ['最小值: '] + ( a 最小 ) ), 停止.
输出 写入: ( ['最大值: '] + ( a 最大 ) ), 停止.
输出 写入: ( ['第3个: '] + ( a ? 2 ) ), 停止.
输出 写入: ( ['乘积: '] + ( a 乘积 ) ), 停止.
a 排序: { :a :b <- (b - a). }.
a 每个: { :i :e 输出 写入: ( i - 0 ), 停止. }.

} 运行.

程序 清扫.
已用内存1 := (程序 内存 ? 0).


{

>> a := 数组对象 ← ['hello'] ; ['world'] ; 是 ; 空 ; 666.
a := a + ( 数组对象 ← 1 ).
输出 写入: ( ['总和: '] + ( a 求和 ) ), 停止.
输出 写入: ( ['最小值: '] + ( a 最小 ) ), 停止.
输出 写入: ( ['最大值: '] + ( a 最大 ) ), 停止.
输出 写入: ( ['第3个: '] + ( a ? 2 ) ), 停止.
输出 写入: ( ['乘积: '] + ( a 乘积 ) ), 停止.
a 排序: { :a :b <- (b - a). }.
a 每个: { :i :e 输出 写入: ( i - 0 ), 停止. }.

} 运行.



程序 清扫.
已用内存2 := (程序 内存 ? 0).


{

>> a := 数组对象 ← ['hello'] ; ['world'] ; 是 ; 空 ; 666.
a := a + ( 数组对象 ← 1 ).
输出 写入: ( ['总和: '] + ( a 求和 ) ), 停止.
输出 写入: ( ['最小值: '] + ( a 最小 ) ), 停止.
输出 写入: ( ['最大值: '] + ( a 最大 ) ), 停止.
输出 写入: ( ['第3个: '] + ( a ? 2 ) ), 停止.
输出 写入: ( ['乘积: '] + ( a 乘积 ) ), 停止.
