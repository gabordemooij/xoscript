>> 待办 := 对象 新建.

待办 在: ['新建'] 执行: {
	拥有 list := 数组对象 新建.
}.

待办 在: ['nieuw'] 执行: {
	拥有 list := 数组对象 新建.
}.

待办 在: ['+'] 执行: { :任务
	拥有 list 追加: 任务.
}.

待办 在: ['number of tasks?'] 执行: { <-  拥有 list 计数.
}.

>> 待办列表 := 
	待办 新建 
	+ ['做晚饭'] 
	+ ['打扫房间'].
	
输出 写入: ['You have $ tasks to do'] $ 待办列表 number of tasks?.
