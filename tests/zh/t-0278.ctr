>> To-Do := 对象 新建.

To-Do 在: ['新建'] 执行: {
	拥有 list := 数组对象 新建.
}.

To-Do 在: ['nieuw'] 执行: {
	拥有 list := 数组对象 新建.
}.

To-Do 在: ['+'] 执行: { :task
	拥有 list 追加: task.
}.

To-Do 在: ['number of tasks?'] 执行: { <-  拥有 list 计数.
}.

>> todos := 
	To-Do 新建 
	+ ['cook dinner'] 
	+ ['clean room'].
	
输出 写入: ['You have $ tasks to do'] $ todos number of tasks?.
