# 测试限定词

>> $ := 对象 新建.

$ 在: ['响应:'] 执行: { :x
	
	>> 运算 := x 字符: 0.
	>> 货币符号 := x 字符: 1.
	>> 钱 := x 跳过: 2.
	
	>> 金额 := 0.

	( 运算 = ['+'] ) 是: {
		( 货币符号 = ['£'] ) 是: { 金额 := 1.28 × 钱. }.
	}. <- 金额.
}.



>> x := $ +£20.

输出 写入: x, 停止.


>> 水果类 := 对象 新建.

水果类 在: ['新建'] 执行: {
	>> f := 自身 新建.
	f apples: 0.
	f oranges: 0. <- f.
}.

水果类 在: ['apples:'] 执行: { :a 拥有 苹果 := a. }.
水果类 在: ['oranges:'] 执行: { :p 拥有 橙子 := p. }.
水果类 在: ['苹果'] 执行: { <- 拥有 苹果. }.
水果类 在: ['橙子'] 执行: { <- 拥有 橙子. }.

水果类 在: ['+'] 执行: { :f
	
	>> n := 水果类 新建.
	f 加: 1.
	
	n apples: (f 苹果 + 拥有 苹果).
	n oranges:  (f 橙子  + 拥有 橙子). <- n.
}.

水果类 在: ['转文本'] 执行: { <- ( 拥有 苹果 转文本 + [' 个苹果和 '] + 拥有 橙子 + [' 个橙子'] ).
}.

数值 在: ['苹果'] 执行: { <- ((水果类 新建) apples: 自身).
}.

数值 在: ['apple'] 执行: { <- ((水果类 新建) apples: 自身).
}.

数值 在: ['橙子'] 执行: { <- ((水果类 新建) oranges: 自身).
}.




输出 写入: (1 apple + 3 橙子 + 4 苹果), 停止.


文本 在: ['两次'] 执行: { <- ((自身 转文本) + (自身 转文本)).
}.



输出 写入: ['❤❤❤'] 两次.



