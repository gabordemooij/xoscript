# test qualifiers

>> $ := 对象 新建.

$ 在: ['响应:'] 执行: { :x
	
	>> operation := x 字符: 0.
	>> valuta := x 字符: 1.
	>> money := x 跳过: 2.
	
	>> amount := 0.

	( operation = ['+'] ) 是: {
		( valuta = ['£'] ) 是: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

输出 写入: x, 停止.


>> Fruit := 对象 新建.

Fruit 在: ['新建'] 执行: {
	>> f := 自身 新建.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit 在: ['apples:'] 执行: { :a 拥有 apples := a. }.
Fruit 在: ['oranges:'] 执行: { :p 拥有 oranges := p. }.
Fruit 在: ['apples'] 执行: { <- 拥有 apples. }.
Fruit 在: ['oranges'] 执行: { <- 拥有 oranges. }.

Fruit 在: ['+'] 执行: { :f
	
	>> n := Fruit 新建.
	f 加: 1.
	
	n apples: (f apples + 拥有 apples).
	n oranges:  (f oranges  + 拥有 oranges). <- n.
}.

Fruit 在: ['转文本'] 执行: { <- ( 拥有 apples 转文本 + [' apples and '] + 拥有 oranges + [' oranges'] ).
}.

数值 在: ['apples'] 执行: { <- ((Fruit 新建) apples: 自身).
}.

数值 在: ['apple'] 执行: { <- ((Fruit 新建) apples: 自身).
}.

数值 在: ['oranges'] 执行: { <- ((Fruit 新建) oranges: 自身).
}.




输出 写入: (1 apple + 3 oranges + 4 apples), 停止.


文本 在: ['twice'] 执行: { <- ((自身 转文本) + (自身 转文本)).
}.



输出 写入: ['❤❤❤'] twice.



