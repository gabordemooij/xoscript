>> items := 映射对象 新建.
items 放: ['黑咖啡'] 在: ['coffee'], 放: ['伯爵茶'] 在: ['茶'].
输出 写入: (items 在: ['coffee']), 写入: (items 在: ['茶']).
输出 写入: ['数组中共有'] + items 计数 + [' 个条目。'].
items 放: ['卡布奇诺'] 在: ['coffee'].
输出 写入: ['现在我的咖啡是.. '] + (items 在: ['coffee']).
items 放: ['aaa'] 在: ['1'].
items 放: ['bbb'] 在: ['2'].
输出 写入: (items 在: ['a']).
