#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := 模式 新建: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern 匹配: subject 执行: { :m :x
	输出 写入: m, 停止.
	输出 写入: x, 停止. <- ['XXX'].
}.
输出 写入: result, 停止.