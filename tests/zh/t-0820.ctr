# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := 模式 新建: pattern.
	p 匹配: subject 执行: { :m :g
		输出 写入: g 计数, 写入: [' '], 写入: (g 连接: ['|']), 停止. <- m.
	}.
}.
show 应用: ['(a)|(b)'] 和: ['b'].
show 应用: ['(a)|(b)'] 和: ['a'].
show 应用: ['(x)?y'] 和: ['y'].
show 应用: ['(x)?(y)(z)?'] 和: ['xy'].
