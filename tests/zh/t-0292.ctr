>> 酒庄 := { <- (	映射对象 新建
		放: 2 在: ['梅洛'],
		放: 3 在: ['马尔贝克'],
		放: 4 在: ['西拉']
	).
}.

输出 写入: (((酒庄 运行) - ['无']) 计数), 停止.
输出 写入: (((酒庄 运行) - ['梅洛']) 计数), 停止.
输出 写入: (((酒庄 运行) - ['马尔贝克']) 计数), 停止.
输出 写入: (((酒庄 运行) - ['西拉']) 计数), 停止.
输出 写入: (((酒庄 运行) - ['梅洛'] - ['马尔贝克']) 计数), 停止.
输出 写入: (((酒庄 运行) - ['梅洛'] - ['西拉']) 计数), 停止.
输出 写入: (((酒庄 运行) - ['马尔贝克'] -['西拉']) 计数), 停止.
输出 写入: (((酒庄 运行) - ['马尔贝克'] - ['西拉'] - ['梅洛']) 计数), 停止.

