>> phrases := 数组对象 新建
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases 每个: { :_ :phrase 
	>> e := Server 互联网编码: phrase.
	>> d := Server 互联网解码: e.
	输出 写入: (
		message 复制 ~encoded: e, ~decoded: d
	), 停止.
}.
