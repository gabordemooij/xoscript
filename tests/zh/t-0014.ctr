>> Greeter := 对象 新建.
Greeter 在: ['make'] 执行: {
	>> gr := 对象 新建.
	gr 在: ['setName:'] 执行: { :aname
		拥有 名称 := aname.
	}.
	gr 在: ['greet'] 执行: {
		输出 写入: 拥有 名称.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a 新建.
c setName: ['THREE'].
c greet.
>> d := a 新建.
d setName: ['FOUR'].
d greet.
c greet.
