>> 问候者类 := 对象 新建.
问候者类 在: ['制造'] 执行: {
	>> 问 := 对象 新建.
	问 在: ['setName:'] 执行: { :某名字
		拥有 名称 := 某名字.
	}.
	问 在: ['问候'] 执行: {
		输出 写入: 拥有 名称.
	}. <- 问.
}.
>> a := 问候者类 制造.
>> b := 问候者类 制造.
a setName: ['壹'].
b setName: ['贰'].
a 问候.
b 问候.
>> c := a 新建.
c setName: ['叁'].
c 问候.
>> d := a 新建.
d setName: ['肆'].
d 问候.
c 问候.
