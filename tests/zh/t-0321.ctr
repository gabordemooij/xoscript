# 测试限定词

程序 清扫.

>> 水果类 := 对象 新建.
水果类 在: ['新建'] 执行: {
	>> f := 自身 新建.
	f apples: 0. <- f.
}.
水果类 在: ['apples:'] 执行: { :a 拥有 苹果 := a. }.
水果类 在: ['苹果'] 执行: { <- 拥有 苹果. }.
水果类 在: ['+'] 执行: { :f
	>> n := 水果类 新建.
	n apples: (f 苹果 + 拥有 苹果). <- n.
}.
数值 在: ['苹果'] 执行: { <- ((水果类 新建) apples: 自身).
}.

水果类 在: ['转文本'] 执行: { <- 拥有 苹果 + [' 个苹果 '].
}.

>> q := 3 苹果 + 4 苹果.
输出 写入: q, 停止.




q := 3 苹果 + 4 苹果.
输出 写入: q, 停止.



q := 3 苹果 + 4 苹果.
输出 写入: q, 停止.


