# test qualifiers

程序 清扫.

>> Fruit := 对象 新建.
Fruit 在: ['新建'] 执行: {
	>> f := 自身 新建.
	f apples: 0. <- f.
}.
Fruit 在: ['apples:'] 执行: { :a 拥有 apples := a. }.
Fruit 在: ['apples'] 执行: { <- 拥有 apples. }.
Fruit 在: ['+'] 执行: { :f
	>> n := Fruit 新建.
	n apples: (f apples + 拥有 apples). <- n.
}.
数值 在: ['apples'] 执行: { <- ((Fruit 新建) apples: 自身).
}.

Fruit 在: ['转文本'] 执行: { <- 拥有 apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
输出 写入: q, 停止.




q := 3 apples + 4 apples.
输出 写入: q, 停止.



q := 3 apples + 4 apples.
输出 写入: q, 停止.


