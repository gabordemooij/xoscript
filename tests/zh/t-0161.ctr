程序 GC模式: 0.
数组对象 在: ['求和'] 执行: {
	>> 总计 := 0.
	自身 每个: { :索引 :元素
		总计 加: 元素.
	}. <- 总计.
}.

>> 已用内存1 := 0.
>> 已用内存2 := 0.
>> 已用内存3 := 0.
>> 已用内存4 := 0.



>> f := 文件 新建: ['/tmp/test.txt'].
f 写入: ['Lorem Ipsum'].
f 关闭.
  

f := 文件 新建: ['/tmp/test.txt'].
>> 文字 := f 读取.
f 关闭.



程序 清扫.
已用内存1 := (程序 内存 ? 1).



f := 文件 新建: ['/tmp/test.txt'].
文字 := f 读取.
f 关闭.

程序 清扫.
已用内存2 := (程序 内存 ? 1).


f := 文件 新建: ['/tmp/test.txt'].
文字 := f 读取.
f 关闭.

程序 清扫.
已用内存3 := (程序 内存 ? 1).



( 已用内存1 = 已用内存2 且: 已用内存1 = 已用内存3, 且: 已用内存2 = 已用内存3 ) 是: {
	输出 写入: ['这里没有内存泄漏'].
}, 否: {
	输出 写入: ['内存泄漏中...'].
}.
