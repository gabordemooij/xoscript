#Linux

 >> t := 时间对象 新建.
 
t 时区: ['Europe/Amsterdam'].
t 年: 2020, 月: 8, 日: 2, 小时: 21, 分钟: 2, 秒: 1.

>> a := t 小时.
>> ams := t 时区.

t 时区: ['US/Hawaii'].
>> b := t 小时.
>> hw := t 时区.

输出
写入: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		或: ['更晚'] 或: ['更早']
	)
),
停止.
 