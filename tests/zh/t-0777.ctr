#OBSD
>> dirname := [''].
{ dirname 追加: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
程序 系统命令: command.
程序 更改工作目录: ['/tmp/'] + dirname.
>> filename := [''].
{ filename 追加: ['YYYYYYYY']. } * 20.
文件 新建: filename, 写入: ['sometext'].
{ 文件 数组: ['/tmp/'] + dirname. } * 1000.
输出 写入: ['no crash'], 停止.

