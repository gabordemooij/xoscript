输出 写入: ['Continue for-loop, No - before 6 and up.'], 停止.
{ :i
	输出 写入: (i + 1), 停止.
	((i + 1) > 4) 继续.
	输出 写入: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
输出 停止.
输出 写入: ['Continue while-true, No --> before 5 and up.'], 停止.
{
	输出 写入: ['iteration #'] + x, 停止.
	x 加: 1.
	((x < 5) 取反) 继续.
	输出 写入: ['-->'].
} 当: xIsLessThan10.
输出 停止.
输出 写入: ['Continue while-false, No - before 3 only.'], 停止.
{
	输出 写入: ['iteration #'] + x, 停止.
	x 减: 1.
	(x = 3) 继续.
	输出 写入: ['-'].
} 当: { <- ( x > 0). }.

输出 停止.
输出 写入: ['Continue times-loop, No ||| before 3.'], 停止.
{ :i
	输出 写入: ['iteration #'] + i, 停止.
	(i = 2) 继续.
	输出 写入: ['|||'].
} × 5.

输出 停止.

{ 是 继续. 输出 写入: ['dont write this!'], 停止. } 运行.

{ 是 继续. 输出 写入: ['dont write this!'], 停止. } 捕获: { 输出 写入: ['Dont catch this!']. }, 运行.

输出 写入: ['Test Array each-loop: 0, ... ,2'], 停止.
(数组对象 ← 1 ; 2 ; 3) 映射: { :i
	(i = 1) 继续.
	输出 写入: ['iteration #'] + (i - 0), 停止.
}.

输出 写入: ['Test Map each-loop: c only'], 停止.
>> m := 映射对象 新建.
m 放: ['first'] 在: ['a'], 放: ['second'] 在: ['b'], 放: ['third'] 在: ['c'].
m 每个: { :k :v
	(k ≠ ['c']) 继续.
	输出 写入: ['iteration'] + k + v, 停止.
}.

