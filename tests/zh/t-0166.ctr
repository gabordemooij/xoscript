

>> 已用内存1 := 0.
>> 已用内存2 := 0.
>> 已用内存3 := 0.
>> 已用内存4 := 0.

程序 GC模式: 0.

{
>> q := ['你应该能够'].
q 追加: ([' 向字符串追加内容']+['!']).
输出 写入: q.
} 运行.

程序 清扫.
已用内存1 := (程序 内存 ? 0).


{
>> q := ['你应该能够'].
q 追加: ([' 向字符串追加内容']+['!']).
输出 写入: q.
} 运行.

程序 清扫.
已用内存2 := (程序 内存 ? 0).


{
>> q := ['你应该能够'].
q 追加: ([' 向字符串追加内容']+['!']).
输出 写入: q.
} 运行.

程序 清扫.
已用内存3 := (程序 内存 ? 0).



( 已用内存1 = 已用内存2 且: 已用内存1 = 已用内存3, 且: 已用内存2 = 已用内存3 ) 是: {
	输出 写入: ['这里没有内存泄漏'].
}, 否: {
	输出 写入: ['内存泄漏中...'].
}.
