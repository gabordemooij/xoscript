# Time
{
	>> 小时 := TwoDigitFormat 应用-整数: (数值 在: 1 和: 23), 转文本.
	>> 分钟 := TwoDigitFormat 应用-整数: (数值 在: 1 和: 59), 转文本.
	>> 秒数 := TwoDigitFormat 应用-整数: (数值 在: 1 和: 59), 转文本.
	>> 时间 := ['HH:II:SS'].
	时间
		HH: 小时,
		II: 分钟,
		SS: 秒数.
	>> 参数 :=
	db 查询: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: 时间),
	获取: { :row
		(row mytime = 时间) 否: {
			当前任务 错误: (
				['Expected: <expected> but got: <observation>']
				<expected>: datetime,
				<observation>: row mytime
			).
		}.
	}.
	counter 加: 1.
} * 100.


# Strings (varchar/text)
>> str1 := 数组对象 新建 填: 100000 充: ['x'], 连接: [''].
{
	>> str2 := 保险库 令牌: 40.
	>> 参数 :=
	db 查询: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	获取: { :row
		(row str1 = str1 且: row str2 = str2) 否: {
			当前任务 错误: (
				['Expected: <expected> but got: <observation>']
				<expected>: datetime,
				<observation>: row mytime
			).
		}.
	}.
	counter 加: 1.
} * 100.


# Numbers
{
	>> n1 := 数值 在: 1 和: 99999.
	>> n2 := n1 / 1000.
	>> big := (
		( Int64 从字符串: ['9223372036854775807'] ) -
		( Int64 从字符串: ['99999'] ) +
		( Int64 从字符串: n1 转文本 )
	).
	>> 参数 :=
	db 查询: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	获取: { :row
		(row n1 = n1) 否: {
			当前任务 错误: (
				['Expected: <expected> but got: <observation>']
				<expected>: n1,
				<observation>: row n1
			).
		}.
		(row n2 = n2) 否: {
			当前任务 错误: (
				['Expected: <expected> but got: <observation>']
				<expected>: n1,
				<observation>: row n2
			).
		}.
		(row n3 = n2 四舍五入) 否: {
			当前任务 错误: (
				['Expected: <expected> but got: <observation>']
				<expected>: n1,
				<observation>: row n3
			).
		}.
		(row big = big) 否: {
			当前任务 错误: (
				['Expected: <expected> but got: <observation>']
				<expected>: big,
				<observation>: row big
			).
		}.
		
	}.
	counter 加: 1.
} * 100.


输出 写入: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: counter
), 停止.