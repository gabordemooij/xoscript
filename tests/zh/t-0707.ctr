# 测试类型转换 / 转换 / 绑定
程序 GC模式: 4.
Server init.

>> 计数器 := 0.
>> db := 数据库 新建 主机: ['localhost'],
	用户名: ['xo'], 密码: ['pass123'], 数据库名: ['xobase'], 连接.

>> 两位格式 := 格式 新建: ['%02d'].

# 日期时间
{
	>> 年份     := 数值 在: 1995 和: 2050, 转文本.
	>> 月份    := 两位格式 应用-整数: (数值 在: 1 和: 12), 转文本.
	>> 日数      := 两位格式 应用-整数: (数值 在: 1 和: 28), 转文本.
	>> 小时     := 两位格式 应用-整数: (数值 在: 1 和: 23), 转文本.
	>> 分钟   := 两位格式 应用-整数: (数值 在: 1 和: 59), 转文本.
	>> 秒数   := 两位格式 应用-整数: (数值 在: 1 和: 59), 转文本.
	>> 日期时间 := ['YYYY-MM-DD HH:II:SS'].	
	日期时间
		YYYY: 年份,
		MM: 月份,
		DD: 日数,
		HH: 小时,
		II: 分钟,
		SS: 秒数.
	>> 参数 :=
	db 查询: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: 日期时间),
	获取: { :行数据
		(行数据 mydatetime = 日期时间) 否: {
			当前任务 错误: (
				['预期: <expected> 但得到: <observation>']
				<expected>: 日期时间,
				<observation>: 行数据 mydatetime
			).
		}.
	
	}.
	计数器 加: 1.
} * 100.

# 日期
{
	>> 年份     := 数值 在: 1995 和: 2050, 转文本.
	>> 月份    := 两位格式 应用-整数: (数值 在: 1 和: 12), 转文本.
	>> 日数      := 两位格式 应用-整数: (数值 在: 1 和: 28), 转文本.
	>> 日期     := ['YYYY-MM-DD'].
	日期
		YYYY: 年份,
		MM: 月份,
		DD: 日数.
	>> 参数 :=
	db 查询: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: 日期),
	获取: { :行数据
		(行数据 mydate = 日期) 否: {
			当前任务 错误: (
				['预期: <expected> 但得到: <observation>']
				<expected>: 日期,
				<observation>: 行数据 mydate
			).
		}.
	}.
	计数器 加: 1.
} * 100.


# 时间
{
	>> 小时     := 两位格式 应用-整数: (数值 在: 1 和: 23), 转文本.
	>> 分钟   := 两位格式 应用-整数: (数值 在: 1 和: 59), 转文本.
	>> 秒数   := 两位格式 应用-整数: (数值 在: 1 和: 59), 转文本.
	>> 时间 := ['HH:II:SS'].
	时间
		HH: 小时,
		II: 分钟,
		SS: 秒数.
	>> 参数 :=
	db 查询: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: 时间),
	获取: { :行数据
		(行数据 mytime = 时间) 否: {
			当前任务 错误: (
				['预期: <expected> 但得到: <observation>']
				<expected>: 日期时间,
				<observation>: 行数据 mytime
			).
		}.
	}.
	计数器 加: 1.
} * 100.


# 字符串（varchar/text）
>> str1 := 数组对象 新建 填: 100000 充: ['x'], 连接: [''].
{
	>> str2 := 保险库 令牌: 40.
	>> 参数 :=
	db 查询: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	获取: { :行数据
		(行数据 str1 = str1 且: 行数据 str2 = str2) 否: {
			当前任务 错误: (
				['预期: <expected> 但得到: <observation>']
				<expected>: 日期时间,
				<observation>: 行数据 mytime
			).
		}.
	}.
	计数器 加: 1.
} * 100.


# 数值
{
	>> n1  := 数值 在: 1 和: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 从字符串: ['9223372036854775807'] ) -
		( Int64 从字符串: ['99999'] ) +
		( Int64 从字符串: n1 转文本 )
	).
	>> 参数 :=
	db 查询: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	获取: { :行数据
		(行数据 n1 = n1) 否: {
			当前任务 错误: (
				['预期: <expected> 但得到: <observation>']
				<expected>: n1,
				<observation>: 行数据 n1
			).
		}.
		(行数据 n2 = n2) 否: {
			当前任务 错误: (
				['预期: <expected> 但得到: <observation>']
				<expected>: n1,
				<observation>: 行数据 n2
			).
		}.
		(行数据 n3 = n2 四舍五入) 否: {
			当前任务 错误: (
				['预期: <expected> 但得到: <observation>']
				<expected>: n1,
				<observation>: 行数据 n3
			).
		}.
		(行数据 big = big) 否: {
			当前任务 错误: (
				['预期: <expected> 但得到: <observation>']
				<expected>: big,
				<observation>: 行数据 big
			).
		}.
		
	}.
	计数器 加: 1.
} * 100.


输出 写入: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: 计数器
), 停止.