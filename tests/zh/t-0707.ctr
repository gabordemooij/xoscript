# test type casts / conversions / bindings
程序 GC模式: 4.
Server init.

>> counter := 0.
>> db := 数据库 新建 主机: ['localhost'],
	用户名: ['xo'], 密码: ['pass123'], 数据库名: ['xobase'], 连接.

>> TwoDigitFormat := 格式 新建: ['%02d'].

# Datetime
{
	>> 年份 := 数值 在: 1995 和: 2050, 转文本.
	>> 月份 := TwoDigitFormat 应用-整数: (数值 在: 1 和: 12), 转文本.
	>> 日数 := TwoDigitFormat 应用-整数: (数值 在: 1 和: 28), 转文本.
	>> 小时 := TwoDigitFormat 应用-整数: (数值 在: 1 和: 23), 转文本.
	>> 分钟 := TwoDigitFormat 应用-整数: (数值 在: 1 和: 59), 转文本.
	>> 秒数 := TwoDigitFormat 应用-整数: (数值 在: 1 和: 59), 转文本.
	>> datetime := ['YYYY-MM-DD HH:II:SS'].	
	datetime
		YYYY: 年份,
		MM: 月份,
		DD: 日数,
		HH: 小时,
		II: 分钟,
		SS: 秒数.
	>> 参数 :=
	db 查询: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: datetime),
	获取: { :row
		(row mydatetime = datetime) 否: {
			当前任务 错误: (
				['Expected: <expected> but got: <observation>']
				<expected>: datetime,
				<observation>: row mydatetime
			).
		}.
	
	}.
	counter 加: 1.
} * 100.

