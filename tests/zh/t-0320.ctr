


>> CoffeeMachine := 对象 新建.
CoffeeMachine 在: ['order:'] 执行: { :id
	>> coffee := ['Americano'].
	( id = 1 ) 是: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) 是: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) 是: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := 对象 新建.
SimpleCoffeeMachine 在: ['order'] 执行: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
输出 写入: redCup, 停止.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
输出 写入: greenCup, 停止.
>> yellowCup := CoffeeMachine order: 1.
输出 写入: yellowCup, 停止.
>> blueCup := CoffeeMachine order: 0.
输出 写入: blueCup, 停止.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
输出 写入: blackCup, 停止.
blackCup 追加: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
输出 写入: orangeCup, 停止.
