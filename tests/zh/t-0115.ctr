{
	当前任务 错误: ['Dont fail.'].
	unknown doSomething.
} 捕获: {
	输出 写入: ['Caught!'].
}, 运行.

{
	当前任务 错误: ['Dont fail.'].
	拥有 unknown doSomething.
} 捕获: {
	输出 写入: ['Caught!'].
}, 运行.

{
	当前任务 错误: ['Dont fail.'].
	unknown := 122.
} 捕获: {
	输出 写入: ['Caught!'].
}, 运行.


{
	当前任务 错误: ['Dont fail.'].
	是 中断.
	输出 写入: ['FAIL'].
} 捕获: {
	输出 写入: ['Caught!'].
}, 运行.

{
	{
		当前任务 错误: ['Dont fail.'].
		是 中断.
		输出 写入: ['FAIL'].
	} 捕获: { :x
		(x = ['Dont fail.']) 是: { 当前任务 错误: ['Nested Caught!']. }.
	}, 运行.
} 捕获: { :e
	输出 写入: e.
}, 运行.
