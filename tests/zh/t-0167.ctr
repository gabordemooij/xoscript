

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

程序 GC模式: 0.

>> f := 文件 新建: ['/tmp/citrine_test_file.txt'].
f exists: { f 删除. }.
f 写入: ['hello world'].
>> q := f 大小.
输出 写入: q, 停止.

f := 文件 新建: ['/tmp/citrine_test_file.txt'].
q := f 大小.
输出 写入: q, 停止.

程序 清扫.
usedMemory1 := (程序 内存 ? 0).


f := 文件 新建: ['/tmp/citrine_test_file.txt'].
q := f 大小.
输出 写入: q, 停止.

程序 清扫.
usedMemory2 := (程序 内存 ? 0).


f := 文件 新建: ['/tmp/citrine_test_file.txt'].
q := f 大小.
输出 写入: q, 停止.

程序 清扫.
usedMemory3 := (程序 内存 ? 0).



( usedMemory1 = usedMemory2 且: usedMemory1 = usedMemory3, 且: usedMemory2 = usedMemory3 ) 是: {
	输出 写入: ['No memory leaks here'].
}, 否: {
	输出 写入: ['Leaking memory...'].
}.
