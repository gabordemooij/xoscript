
>> Rectangle := 对象 新建.

Rectangle 在: ['area'] 执行: { <- 拥有 长度 * 拥有 width.
}.

Rectangle 在: ['length:'] 执行: { :长度
	拥有 长度 := 长度.
}.

Rectangle 在: ['width:'] 执行: { :width
	拥有 width := width.
}.

Rectangle 在: ['新建'] 执行: {
	# this will not result into an infinite loop
	>> rectangle := 自身 新建.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle 新建.
输出 写入: a area, 停止. #0

>> b := Rectangle 新建 length: 2, width: 3.
输出 写入: b area, 停止. #6

