>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := 对象 新建.
⚄ 在: ['drawFrom:length:'] 执行: { :pool :计数
	
	>> result := [''].
	
	{
		>> index := 数值 random % (pool 长度).
		result 追加: ( pool 字符: (index + 1) ).
		
	} × 计数. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? 长度.
输出 写入: (['x↵'] x random 长度).
输出 写入: (['y↵'] y ?? 长度).

