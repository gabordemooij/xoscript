# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := 保险库 
	密码哈希: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := 保险库 
	密码哈希: hash 验证: a1.
	# fail 
>> b := 保险库
	密码哈希: hash 验证: a2.
	# ok!

输出 写入: a, 停止.
输出 写入: b, 停止.

