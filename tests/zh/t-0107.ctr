
输出 写入: ['Break for-loop, 0-4.'], 停止.
{ :i
	输出 写入: ['iteration #'] + i, 停止.
	(i = 4) 中断.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

输出 写入: ['Break while-true loop, 0-4.'], 停止.
{
	输出 写入: ['iteration #'] + x, 停止.
	x 加: 1.
	((x < 5) 取反) 中断.
} 当: xIsLessThan10.

输出 写入: ['Break while-false loop, 5,4.'], 停止.
{
	输出 写入: ['iteration #'] + x, 停止.
	x 减: 1.
	(x = 3) 中断.
} 当: { <- (x > 0). }.

输出 写入: ['Break times loop, 1-4.'], 停止.
{ :i
	输出 写入: ['iteration #'] + i, 停止.
	(i = 4) 中断.
} × 5.

输出 写入: ['Break block, dont print line.'], 停止.
{ 是 中断. 输出 写入: ['dont write this!'], 停止. } 运行.

输出 写入: ['Break block, dont fire catch...'], 停止.
{ 是 中断. 输出 写入: ['dont write this!'], 停止. } 捕获: { 输出 写入: ['Dont catch this!']. }, 运行.

输出 写入: ['Test Array each-loop: 0,1'], 停止.
(数组对象 ← 1 ; 2 ; 3) 映射: { :i
	输出 写入: ['iteration #'] + i, 停止.
	(i = 1) 中断.
}.

输出 写入: ['Test Map each-loop: c only'], 停止.
>> m := 映射对象 新建.
m 放: ['first'] 在: ['a'], 放: ['second'] 在: ['b'], 放: ['third'] 在: ['c'].
m 每个: { :k :v
	输出 写入: ['iteration'] + v + k, 停止.
	是 中断.
}.

