# test list operations


>> cakes := 数组对象 ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes 替换: 1 长度: 2 为: ( 数组对象 ← ['cinnamon'] ; ['pineapple'] ).
输出 写入: (buy 连接: [',']), 停止.


>> buy := cakes 替换: 1 长度: 12 为: ( 数组对象 ← ['cinnamon'] ; ['pineapple'] ).
输出 写入: (buy 连接: [',']), 停止.


>> buy := cakes 替换: 2 长度: 10 为: ( 数组对象 新建 ).
输出 写入: (buy 连接: [',']), 停止.


>> buy := cakes 替换: 0 长度: 1 为: ( 数组对象 新建 ).
输出 写入: (buy 连接: [',']), 停止.


>> buy := cakes 替换: ['0'] 长度: ['1'] 为: ['x'].
输出 写入: (buy 连接: [',']), 停止.
