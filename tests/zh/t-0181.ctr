

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

程序 GC模式: 0.

>> txt := ['World Salad'].
输出 写入: ['this text contains: '] + ( ( txt 拆分: [' '] ) 计数 ) + [' words.'], 停止.
txt := txt 从: 6 长度: 4.
输出 写入: txt, 停止.

程序 清扫.

usedMemory1 := (程序 内存 ? 0).


txt := ['World Salad'].
输出 写入: ['this text contains: '] + ( ( txt 拆分: [' '] ) 计数 ) + [' words.'], 停止.
