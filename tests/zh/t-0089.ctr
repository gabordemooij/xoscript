>> 随机器 := { :a :b
	>> 最小 := ( a < b ) 或: a 或: b.
	>> 最大 := ( a > b ) 或: a 或: b.
	>> x := 空.
	{
		x := 数值 在: a 和: b.
		((x < 最小) 或: (x > 最大)) 是: { 
			输出 写入: (['无效的值！']).
			程序 结束.
		}.
	} 
	× 100. <- x.
}.
随机器 应用: 0 和: 0.
随机器 应用: 1 和: 0.
