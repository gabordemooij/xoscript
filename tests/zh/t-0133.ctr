


>> Deck := 数组对象 新建.
Deck 在: ['print'] 执行: {
        >> len := 自身 计数 - 1.
        { :i
                >> len2 := 自身 计数 - 1.
                输出 写入: ['len: '].
                输出 写入: len, 停止.
                输出 写入: ['len2: '].
                输出 写入: len2, 停止.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
