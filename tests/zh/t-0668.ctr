# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := 二进制 新建: 8, 字节: (
	数组对象 新建 ; 十六进制 x41 ; 十六进制 x00 ; 十六进制 x3D ; 十六进制 xD8
	         ; 十六进制 x0A ; 十六进制 xDE ; 十六进制 x42 ; 十六进制 x00
).

输出 写入: ( utf16 解码: ['utf16le'] ), 停止.

utf16 释放.
>> utf32 := 二进制 新建: 13, 字节: (
	数组对象 新建 ; 十六进制 x00 ; 十六进制 x00 ; 十六进制 x00 ; 十六进制 x41
	         ; 十六进制 x00 ; 十六进制 x01 ; 十六进制 xF6 ; 十六进制 x0A
	         ; 十六进制 x00 ; 十六进制 x00 ; 十六进制 x00 ; 十六进制 x42
	         ; 十六进制 x00
).

输出 写入: ( utf32 解码: ['utf32be'] ), 停止.
utf32 释放.