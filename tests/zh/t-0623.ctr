

>> g := Server 新建.
>> v := 保险库 新建.
>> ok := 0.

>> secrets := 数组对象 新建 ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> passwords := secrets 复制.
passwords 每个: { :i :p
	secrets 每个: { :n :s
		{
			>> encrypted := v 加密: s 密钥: p.
			>> decrypted := v 解密: encrypted 密钥: p.
			(decrypted = s) 是: {
				ok 加: 1.
			}, 否则: {
				输出 写入: ['failed encrypting/decrypting: '], 停止.
				输出 写入: s, 停止.
				输出 写入: ['encrypted: '] + encrypted, 停止.
				输出 写入: ['decrypted: '] + encrypted, 停止.
				程序 结束.
			}.
		} 捕获: { :err
			(s = [''] 或: p = ['']) 是: {
				ok 加: 1.
			}, 否则: {
				输出 写入: err, 停止.
				程序 结束.
			}.
		}, 运行.
	}.
}.

输出 写入: ( ok + [' vault encryptions tested.'] ), 停止.