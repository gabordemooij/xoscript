

>> g  := Server 新建.
>> v  := 保险库 新建.
>> ok := 0.

>> 秘密列表 := 数组对象 新建 ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> 密码列表 := 秘密列表 复制.
密码列表 每个: { :i :p
	秘密列表 每个: { :n :s
		{
			>> 密文 := v 加密: s 密钥: p.
			>> 明文 := v 解密: 密文 密钥: p.
			(明文 = s) 是: {
				ok 加: 1.
			}, 否则: {
				输出 写入: ['加密/解密失败: '], 停止.
				输出 写入: s, 停止.
				输出 写入: ['已加密: '] + 密文, 停止.
				输出 写入: ['已解密: '] + 密文, 停止.
				程序 结束.
			}.
		} 捕获: { :err
			(s = [''] 或: p = ['']) 是: {
				ok 加: 1.
			}, 否则: {
				输出 写入: err, 停止.
				程序 结束.
			}.
		}, 运行.
	}.
}.

输出 写入: ( ok + [' 次保险库加密已测试。'] ), 停止.