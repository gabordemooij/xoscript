>> Grandfather := 对象 新建.
Grandfather 在: ['greet'] 执行: {
	输出 写入: ['Ave!'], 停止.
}.
>> Father := Grandfather 新建.
Father 在: ['greet'] 执行: {
	输出 写入: ['Hello'], 停止.
	自身 greet.
}.
>> Son := Father 新建.
Son 在: ['greet'] 执行: {
	输出 写入: ['Hi'], 停止.
	自身 greet.
}.

Son greet.

>> Roundabout := 对象 新建.
Roundabout 在: ['circle:'] 执行: { :x
	输出 写入: x, 停止.
	(x < 3) 是: { 自身 递归 circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) 是: { 输出 写入: x, 停止. x 加: 1.  increment 运行. }. }.
increment 运行.