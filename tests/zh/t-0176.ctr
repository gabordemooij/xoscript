

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

程序 GC模式: 0.

>> txt := ['Word Salad'].
输出 写入: ['Text Length: '] + txt 长度, 停止.
输出 写入: ['Character at 2:'] + ( txt 字符: 2 ), 停止.
输出 写入: (( txt 查找: ['S'] ) - 0), 停止.

程序 清扫.

usedMemory1 := (程序 内存 ? 0).


txt := ['Word Salad'].
输出 写入: ['Text Length: '] + txt 长度, 停止.
输出 写入: ['Character at 2:'] + ( txt 字符: 2 ), 停止.
输出 写入: (( txt 查找: ['S'] ) - 0), 停止.

程序 清扫.
usedMemory2 := (程序 内存 ? 0).


txt := ['Word Salad'].
输出 写入: ['Text Length: '] + txt 长度, 停止.
输出 写入: ['Character at 2:'] + ( txt 字符: 2 ), 停止.
输出 写入: (( txt 查找: ['S'] ) - 0), 停止.

