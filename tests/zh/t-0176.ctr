

>> 已用内存1 := 0.
>> 已用内存2 := 0.
>> 已用内存3 := 0.
>> 已用内存4 := 0.

程序 GC模式: 0.

>> txt := ['Word Salad'].
输出 写入: ['文本长度: '] + txt 长度, 停止.
输出 写入: ['位置 2 的字符:'] + ( txt 字符: 2 ), 停止.
输出 写入: (( txt 查找: ['S'] ) - 0), 停止.

程序 清扫.

已用内存1 := (程序 内存 ? 0).


txt := ['Word Salad'].
输出 写入: ['文本长度: '] + txt 长度, 停止.
输出 写入: ['位置 2 的字符:'] + ( txt 字符: 2 ), 停止.
输出 写入: (( txt 查找: ['S'] ) - 0), 停止.

程序 清扫.
已用内存2 := (程序 内存 ? 0).


txt := ['Word Salad'].
输出 写入: ['文本长度: '] + txt 长度, 停止.
输出 写入: ['位置 2 的字符:'] + ( txt 字符: 2 ), 停止.
输出 写入: (( txt 查找: ['S'] ) - 0), 停止.

程序 清扫.
已用内存3 := (程序 内存 ? 0).



( 已用内存1 = 已用内存2 且: 已用内存1 = 已用内存3, 且: 已用内存2 = 已用内存3 ) 是: {
	输出 写入: ['这里没有内存泄漏'].
}, 否: {
	输出 写入: ['内存泄漏中...'].
}.
