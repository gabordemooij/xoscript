>> phrases := تىزىم يېڭى
	~ ⌝'abcd'⌜
	~ ⌝'hello world'⌜
	~ ⌝''⌜
	~ ⌝'@.,;"'⌜
	~ ⌝'this is a much much longer string to be encoded!'⌜.

>> message := ⌝'Phrase: ~decoded base64: ~encoded'⌜.
	
phrases ھەربىر: ⎬ :_ :phrase 
	>> e := Server base64-كودلاش: phrase.
	>> d := Server base64-كود-يېشىش: e.
	چىقىرىش ياز: ﴿
		message كۆچۈر ~encoded: e, ~decoded: d
	﴾, يېڭى-قۇر.
⎨.
