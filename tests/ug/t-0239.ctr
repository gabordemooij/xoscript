تىزىم كەلگەندە: ⌝'sum'⌜ قىل: ⎬
	>> total := 0.
	ئۆزى ھەربىر: ⎬ :index :element
		total قوش: element.
	⎨. <- total.
⎨.

>> a := راست.



a كەلگەندە: ⌝'تېكىستكە'⌜ قىل: ⎬
	>> answer := قۇرۇق.
	﴿ ئۆزى = راست ﴾ راست-بولسا: ⎬
		answer := ⌝'Yep'⌜.
	⎨, بولمىسا: ⎬
		answer := ⌝'Nope'⌜.
	⎨. <- answer.
⎨.

a كەلگەندە: ⌝'سانغا'⌜ قىل: ⎬
	>> answer := قۇرۇق.
	﴿ ئۆزى = راست ﴾ راست-بولسا: ⎬
		answer := 10.
	⎨, بولمىسا: ⎬
		answer := 20.
	⎨. <- answer.
⎨.

>> b := 666.

b كەلگەندە: ⌝'تېكىستكە'⌜ قىل: ⎬ <- ⌝'Devil'⌜.
⎨.

b كەلگەندە: ⌝'لوگىكىلىققا'⌜ قىل: ⎬ <- يالغان.
⎨.


چىقىرىش ياز: a, يېڭى-قۇر.  
چىقىرىش ياز: ﴿90 + a﴾, يېڭى-قۇر. 
چىقىرىش ياز: b, يېڭى-قۇر. 
چىقىرىش ياز: ﴿راست ۋە: b﴾, يېڭى-قۇر.

a := تىزىم ← ⌝'hello'⌜ ; ⌝'world'⌜ ; راست ; قۇرۇق ; 666. 
a := a + ﴿ تىزىم ← 1 ﴾.
چىقىرىش ياز: a, يېڭى-قۇر.
چىقىرىش ياز: ﴿﴿لۇغەت يېڭى﴾ قوي: قۇرۇق ئاچقۇچ: قۇرۇق﴾, يېڭى-قۇر.
چىقىرىش ياز: a sum, يېڭى-قۇر. 


⎬
	a كەلگەندە: ⌝'تېكىستكە'⌜ قىل: ⎬ <- قۇرۇق. ⎨.
	a := ⌝''⌜ + a.
⎨ تۇت: ⎬ :error
	چىقىرىش ياز: ⌝'Error noted: '⌜ + error, يېڭى-قۇر.
⎨, ئىجرا.



⎬
	a كەلگەندە: ⌝'سانغا'⌜ قىل: ⎬ <- قۇرۇق. ⎨.
	a := 3 × a.
⎨ تۇت: ⎬ :error
	چىقىرىش ياز: ⌝'Error noted: '⌜ + error, يېڭى-قۇر.
⎨, ئىجرا.


⎬
	a كەلگەندە: ⌝'لوگىكىلىققا'⌜ قىل: ⎬ <- قۇرۇق. ⎨.
	a := راست ۋە: a. 
⎨ تۇت: ⎬ :error
	چىقىرىش ياز: ⌝'Error noted: '⌜ + error, يېڭى-قۇر.
⎨, ئىجرا.





