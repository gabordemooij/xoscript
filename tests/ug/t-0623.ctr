

>> g := Server يېڭى.
>> v := ساندۇق يېڭى.
>> ok := 0.

>> secrets := تىزىم يېڭى ; 
	 ⌝'aaa'⌜ ;
	 ⌝''⌜ ; 
	 ⌝'AB'⌜ ;
	 ⌝'abcdefghijklmnopqrstuvwxyz0123456789'⌜ ; 
	 ⌝'!@--+467hdHJKJs__=3hjsakd'⌜ ;
	 ⌝'spaces and	tabs'⌜ ;
	 ⌝'漢字'⌜ ;
	 ⌝'==[abc]=='⌜.
	
>> passwords := secrets كۆچۈر.
passwords ھەربىر: ⎬ :i :p
	secrets ھەربىر: ⎬ :n :s
		⎬
			>> encrypted := v شىفىرلا: s ئاچقۇچ: p.
			>> decrypted := v شىفىر-يەش: encrypted ئاچقۇچ: p.
			﴿decrypted = s﴾ راست-بولسا: ⎬
				ok قوش: 1.
			⎨, بولمىسا: ⎬
				چىقىرىش ياز: ⌝'failed encrypting/decrypting: '⌜, يېڭى-قۇر.
				چىقىرىش ياز: s, يېڭى-قۇر.
				چىقىرىش ياز: ⌝'encrypted: '⌜ + encrypted, يېڭى-قۇر.
				چىقىرىش ياز: ⌝'decrypted: '⌜ + encrypted, يېڭى-قۇر.
				پروگرامما ئاخىرلاشتۇر.
			⎨.
		⎨ تۇت: ⎬ :err
			﴿s = ⌝''⌜ ياكى: p = ⌝''⌜﴾ راست-بولسا: ⎬
				ok قوش: 1.
			⎨, بولمىسا: ⎬
				چىقىرىش ياز: err, يېڭى-قۇر.
				پروگرامما ئاخىرلاشتۇر.
			⎨.
		⎨, ئىجرا.
	⎨.
⎨.

چىقىرىش ياز: ﴿ ok + ⌝' vault encryptions tested.'⌜ ﴾, يېڭى-قۇر.