# Password hashing
Server init.

# User sets a password
>> passw := ⌝'pass123'⌜.

# You store it like this
>> hash := ساندۇق 
	ئىم-خەش: passw.

# Then, user logs in
# Attempt 1
>> a1 := ⌝'abcd123'⌜.
# Attempt 2
>> a2 := ⌝'pass123'⌜.

# Verify
>> a := ساندۇق 
	ئىم-خەش: hash دەلىللە: a1.
	# fail 
>> b := ساندۇق
	ئىم-خەش: hash دەلىللە: a2.
	# ok!

چىقىرىش ياز: a, يېڭى-قۇر.
چىقىرىش ياز: b, يېڭى-قۇر.

