#regex test
Server init.
>> subject := ⌝'<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'⌜.
>> pattern := ئەندىزە يېڭى: ⌝'href="([^"]+)" target="([^"]+)"'⌜.
>> result := pattern ماسلىق: subject قىل: ⎬ :m :x
	چىقىرىش ياز: m, يېڭى-قۇر.
	چىقىرىش ياز: x, يېڭى-قۇر. <- ⌝'XXX'⌜.
⎨.
چىقىرىش ياز: result, يېڭى-قۇر.