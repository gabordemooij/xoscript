>> map1 := لۇغەت يېڭى.
>> key1 := تىزىم يېڭى.
>> key2 := تىزىم يېڭى.

map1
	قوي: ⌝'hello'⌜ ئاچقۇچ: key1,
	قوي: ⌝'world'⌜ ئاچقۇچ: key2.


چىقىرىش
	ياز: ⌝'Map #1 contains: '⌜ + ﴿map1 ئورۇندا: key1﴾,
	ياز: ⌝' and '⌜ + ﴿map1 ئورۇندا: key2﴾, يېڭى-قۇر.

>> KeyeableArray := تىزىم يېڭى.
KeyeableArray كەلگەندە: ⌝'toString'⌜ قىل: ⎬ <- ﴿ئۆزى سانى﴾ toString.
⎨.

>> map2 := لۇغەت يېڭى.
key1 := KeyeableArray يېڭى.
key2 := KeyeableArray يېڭى.

key1 ئاخىرىغا-قوش: 1.

map2
	قوي: ⌝'hello'⌜ ئاچقۇچ: key1,
	قوي: ⌝'world'⌜ ئاچقۇچ: key2.

چىقىرىش
	ياز: ⌝'Map #2 contains: '⌜ + ﴿map2 ئورۇندا: key1﴾,
	ياز: ⌝' and '⌜ + ﴿map2 ئورۇندا: key2﴾, يېڭى-قۇر.
