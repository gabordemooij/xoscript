# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := ⎬ :pattern :subject
	>> p := ئەندىزە يېڭى: pattern.
	p ماسلىق: subject قىل: ⎬ :m :g
		چىقىرىش ياز: g سانى, ياز: ⌝' '⌜, ياز: ﴿g بىرلەشتۈر: ⌝'|'⌜﴾, يېڭى-قۇر. <- m.
	⎨.
⎨.
show قوللان: ⌝'(a)|(b)'⌜ ۋە: ⌝'b'⌜.
show قوللان: ⌝'(a)|(b)'⌜ ۋە: ⌝'a'⌜.
show قوللان: ⌝'(x)?y'⌜ ۋە: ⌝'y'⌜.
show قوللان: ⌝'(x)?(y)(z)?'⌜ ۋە: ⌝'xy'⌜.
