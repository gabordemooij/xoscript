# happy flow
>> s := ⌝'hello;"""world"""\n"of";"c\ns\nv"'⌜.
>> ھۆججەت-يولى := ⌝'/tmp/dat.csv'⌜.
>> csv := ھۆججەت يېڭى: ھۆججەت-يولى.
csv ياز: s.

# accepts CRLF LF CR, varying row length
csv ئايرىغۇچ: ⌝';'⌜ تىرناق: ⌝'"'⌜ قۇرلار: ⎬ :line
	پروگرامما تازىلا.
	چىقىرىش ياز: line, يېڭى-قۇر.
	پروگرامما تازىلا.
⎨.

# unequal lines
s ئاخىرىغا-قوش: ⌝'\njustone'⌜.
csv ياز: s.
⎬
	csv ئايرىغۇچ: ⌝';'⌜ تىرناق: ⌝'"'⌜ قۇرلار: ⎬ :line
		چىقىرىش ياز: line, يېڭى-قۇر.
	⎨.
⎨ تۇت: ⎬ :e 
	چىقىرىش ياز: e, يېڭى-قۇر.
⎨, ئىجرا.

# invalid format
s := ⌝'"he"llo";world'⌜.
csv ياز: s.
⎬
	csv ئايرىغۇچ: ⌝';'⌜ تىرناق: ⌝'"'⌜ قۇرلار: ⎬ :line
		چىقىرىش ياز: line, يېڭى-قۇر.
	⎨.
⎨ تۇت: ⎬ :e 
	چىقىرىش ياز: e, يېڭى-قۇر.
⎨, ئىجرا.
