#Linux

 >> t := پەيت يېڭى.
 
t ۋاقىت-رايونى: ⌝'Europe/Amsterdam'⌜.
t يىل: 2020, ئاي: 8, كۈن: 2, سائەت: 21, مىنۇت: 2, سېكۇنت: 1.

>> a := t سائەت.
>> ams := t ۋاقىت-رايونى.

t ۋاقىت-رايونى: ⌝'US/Hawaii'⌜.
>> b := t سائەت.
>> hw := t ۋاقىت-رايونى.

چىقىرىش
ياز: ﴿
	⌝'It's diff in zone2 than in zone1'⌜
	zone1: ams,
	zone2: hw,
	diff: ﴿
		﴿b > a﴾
		بۇ: ⌝'later'⌜ ياكى-ئۇ: ⌝'earlier'⌜
	﴾
﴾,
يېڭى-قۇر.
 