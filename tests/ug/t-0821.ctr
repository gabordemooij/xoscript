# a quote that never closes must give an error, not an endless loop
>> ھۆججەت-يولى := ⌝'/tmp/test0821.csv'⌜.
>> file := ھۆججەت يېڭى: ھۆججەت-يولى.

file ياز: ⌝'a,b\n"1,2\n'⌜.
⎬
	file ئايرىغۇچ: ⌝','⌜ تىرناق: ⌝'"'⌜ قۇرلار: ⎬ :line
		چىقىرىش ياز: line, يېڭى-قۇر.
	⎨.
⎨ تۇت: ⎬ :e چىقىرىش ياز: e, يېڭى-قۇر. ⎨, ئىجرا.

# a closed quote still works
file ياز: ⌝'a,b\n"1,2",3'⌜.
file ئايرىغۇچ: ⌝','⌜ تىرناق: ⌝'"'⌜ قۇرلار: ⎬ :line
	چىقىرىش ياز: line, يېڭى-قۇر.
⎨.
file ئۆچۈر.
