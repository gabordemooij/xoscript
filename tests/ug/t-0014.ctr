>> Greeter := ئوبيېكت يېڭى.
Greeter كەلگەندە: ⌝'make'⌜ قىل: ⎬
	>> gr := ئوبيېكت يېڭى.
	gr كەلگەندە: ⌝'setName:'⌜ قىل: ⎬ :aname
		ئۆزىنىڭ ئات := aname.
	⎨.
	gr كەلگەندە: ⌝'greet'⌜ قىل: ⎬
		چىقىرىش ياز: ئۆزىنىڭ ئات.
	⎨. <- gr.
⎨.
>> a := Greeter make.
>> b := Greeter make.
a setName: ⌝'ONE'⌜.
b setName: ⌝'TWO'⌜.
a greet.
b greet.
>> c := a يېڭى.
c setName: ⌝'THREE'⌜.
c greet.
>> d := a يېڭى.
d setName: ⌝'FOUR'⌜.
d greet.
c greet.
