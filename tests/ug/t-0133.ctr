


>> Deck := تىزىم يېڭى.
Deck كەلگەندە: ⌝'print'⌜ قىل: ⎬
        >> len := ئۆزى سانى - 1.
        ⎬ :i
                >> len2 := ئۆزى سانى - 1.
                چىقىرىش ياز: ⌝'len: '⌜.
                چىقىرىش ياز: len, يېڭى-قۇر.
                چىقىرىش ياز: ⌝'len2: '⌜.
                چىقىرىش ياز: len2, يېڭى-قۇر.
        ⎨ × len.
⎨.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
