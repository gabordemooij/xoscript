# test url parsing

Server init.
>> url := URL مەنبە: ⌝'https://xoscript.com:1234/a/b/c?test=1#hello'⌜.

چىقىرىش ياز: ⌝'scheme = '⌜ + url لايىھە, يېڭى-قۇر.
چىقىرىش ياز: ⌝'host = '⌜ + url باش-ماشىنا, يېڭى-قۇر.
چىقىرىش ياز: ⌝'port = '⌜ + url ئېغىز, يېڭى-قۇر.
چىقىرىش ياز: ⌝'path = '⌜ + url ھۆججەت-يولى, يېڭى-قۇر.
چىقىرىش ياز: ⌝'query = '⌜ + url ئىزدەش-پارامېتىرلىرى, يېڭى-قۇر.
چىقىرىش ياز: ⌝'fragment = '⌜ + url بۆلەك, يېڭى-قۇر.
