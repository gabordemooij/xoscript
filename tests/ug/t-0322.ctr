

>> Matryoshka := ئوبيېكت يېڭى.
Matryoshka كەلگەندە: ⌝'double:'⌜ قىل: ⎬ :secret
	ئۆزىنىڭ secret := secret × 2.
⎨.
Matryoshka كەلگەندە: ⌝'يېڭى:'⌜ قىل: ⎬ :secret
	>> answer := قۇرۇق.
	>> t := ﴿secret > 255﴾.
	چىقىرىش ياز: ﴿secret + ⌝' | '⌜ + t﴾, يېڭى-قۇر.
	t راست-بولسا: ⎬
		answer := secret.
	⎨, بولمىسا: ⎬
		answer := Matryoshka قايتىلانما يېڭى: ﴿ئۆزى double: secret﴾.
	⎨. <- answer.
⎨.

>> x := Matryoshka يېڭى: 2.
