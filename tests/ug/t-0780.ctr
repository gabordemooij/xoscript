Server init.

# JSON encoder only supports UTF-8, no surrogate pairs

>> dicts := تىزىم يېڭى ;
	# {"key":"normal"} normal ASCII
	﴿ لۇغەت يېڭى قوي: ⌝'normal'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"hello world"} space character
	﴿ لۇغەت يېڭى قوي: ⌝'hello world'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"quote: \""} double quote
	﴿ لۇغەت يېڭى قوي: ⌝'"'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"backslash: \\"} backslash
	﴿ لۇغەت يېڭى قوي: ⌝'backslash: \\'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"slash: /"} slash
	﴿ لۇغەت يېڭى قوي: ⌝'slash: /'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"backspace: \b"} backspace
	﴿ لۇغەت يېڭى قوي: ⌝'backspace: \b'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"formfeed: \f"} form-feed escape
	﴿ لۇغەت يېڭى قوي: ⌝'formfeed: \f'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"newline: \n"} newline
	﴿ لۇغەت يېڭى قوي: ⌝'newline: \n'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	﴿ لۇغەت يېڭى قوي: ⌝'newline: ↵'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	﴿ لۇغەت يېڭى قوي: ⌝'newline: 
	'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"carriage return: \r"} carriage-return
	﴿ لۇغەت يېڭى قوي: ⌝'carriage return: \r'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"tab: \t"} tab
	﴿ لۇغەت يېڭى قوي: ⌝'tab \t'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	﴿ لۇغەت يېڭى قوي: ⌝'tab ⇿'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	﴿ لۇغەت يېڭى قوي: ⌝'tab  '⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u0000"} NUL
	﴿ لۇغەت يېڭى قوي: ⌝'NUL \u0000'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	﴿ لۇغەت يېڭى قوي: ⌝'NUL \0'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u0001"} control character 0x01
	﴿ لۇغەت يېڭى قوي: ⌝'control: \u0001'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u001F"} control character 0x1F
	﴿ لۇغەت يېڭى قوي: ⌝'control: \u001F'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: é"} UTF-8, 2-byte char
	﴿ لۇغەت يېڭى قوي: ⌝'unicode: é'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: €"} UTF-8, 3-byte char
	﴿ لۇغەت يېڭى قوي: ⌝'unicode: €'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 日本語"} multiple 3-byte UTF-8 chars
	﴿ لۇغەت يېڭى قوي: ⌝'unicode: 日本語'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 😀"} UTF-8, 4-byte char
	﴿ لۇغەت يېڭى قوي: ⌝'unicode: 😀'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	﴿ لۇغەت يېڭى قوي: ⌝'unicode: 🧑‍💻'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"combining: e\u0301"} combining accent
	﴿ لۇغەت يېڭى قوي: ⌝'combining: e\u0301'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: \u00e9"} Unicode escape BMP
	﴿ لۇغەت يېڭى قوي: ⌝'escaped unicode: \u00e9'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: \u20ac"} Unicode escape BMP
	﴿ لۇغەت يېڭى قوي: ⌝'escaped unicode: \u20ac'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: \ud83d\ude00"} UTF-16 surrogate pair
	﴿ لۇغەت يېڭى قوي: ⌝'escaped unicode: \ud83d\ude00'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":""} empty value
	﴿ لۇغەت يېڭى قوي: ⌝''⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"@ < > & = % + ? #"} special ASCII chars
	﴿ لۇغەت يېڭى قوي: ⌝'@ < > & = % + ? #'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"single quote: '"} single quote
	﴿ لۇغەت يېڭى قوي: ⌝'''⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"multiple: \" \\ \n \r \t"} multiple JSON escapes
	﴿ لۇغەت يېڭى قوي: ⌝'multiple: \" \\ \n \r \t'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} longer ASCII-string
	﴿ لۇغەت يېڭى قوي: ⌝'aaaaaaaaaaaaaaaaaaaaaaaaaa'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":" value"} leading space
	﴿ لۇغەت يېڭى قوي: ⌝' value'⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":"value "} trailing space
	﴿ لۇغەت يېڭى قوي: ⌝'value '⌜ ئاچقۇچ: ⌝'key'⌜ ﴾ ;
	# {"key":" \t\n\r "} whitespace
	﴿ لۇغەت يېڭى قوي: ⌝' \t\n\r '⌜ ئاچقۇچ: ⌝'key'⌜ ﴾.

dicts ھەربىر: ⎬ :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: ﴿لۇغەت يېڭى قوي: d key ئاچقۇچ: ⌝'key'⌜﴾.
	>> b := JSON jsonify: ﴿لۇغەت يېڭى قوي: ⌝'value'⌜ ئاچقۇچ: d key﴾.
	>> e := JSON ئوبيېكت: a.
	>> f := JSON ئوبيېكت: b.
	﴿﴿e key = d key ۋە: ﴿f ? d key = ⌝'value'⌜﴾﴾ ياكى: ﴿e key = ⌝'NUL ?'⌜﴾﴾ راست-بولسا: ⎬
		چىقىرىش ياز: ⌝'OK'⌜, يېڭى-قۇر.
	⎨, بولمىسا: ⎬
		چىقىرىش ياز: ⌝'Unable to properly encode/decode: '⌜ + d + j, يېڭى-قۇر.
		پروگرامما ئاخىرلاشتۇر.
	⎨.
⎨.
