# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := ساندۇق ئاچقۇچ-ھاسىللا.

# private (secret) key
>> sk := keys بىرىنچى.

# public key
>> pk := keys ئاخىرقى.

# sign a message
>> sig := ساندۇق ئىمزالا: ⌝'abc'⌜ ئاچقۇچتا: sk.

# check message (ok)
چىقىرىش ياز: ﴿ 
	ساندۇق
		تەكشۈر: ⌝'abc'⌜ 
		ئىمزا: sig 
		ئاچقۇچتا: pk 
﴾, يېڭى-قۇر.

# check message (fail)
چىقىرىش ياز: ﴿ 
	ساندۇق 
		تەكشۈر: ⌝'abd'⌜ 
		ئىمزا: sig 
		ئاچقۇچتا: pk 
﴾, يېڭى-قۇر.