# backslashes must survive code serialization, strings must not end early
>> قىممەتلەر := تىزىم يېڭى
	; ⌝'C:\\new'⌜
	; ⌝'ends with backslash \\'⌜
	; ⌝'\\\\'⌜
	; ⌝'x\\\'] at: 9, put: 1 at: 2).'⌜.

قىممەتلەر ھەربىر: ⎬ :i :value
	>> d := لۇغەت يېڭى.
	d قوي: value ئاچقۇچ: ⌝'k'⌜.
	>> r := d كود ئوبيېكتقا.
	چىقىرىش ياز: r سانى, يېڭى-قۇر.
	چىقىرىش ياز: ﴿ ﴿r ئورۇندا: ⌝'k'⌜﴾ = value ﴾, يېڭى-قۇر.
⎨.
