# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob يېڭى: 8, بايتلار: ﴿
	تىزىم يېڭى ; ئون-ئالتىلىك x41 ; ئون-ئالتىلىك x00 ; ئون-ئالتىلىك x3D ; ئون-ئالتىلىك xD8
	         ; ئون-ئالتىلىك x0A ; ئون-ئالتىلىك xDE ; ئون-ئالتىلىك x42 ; ئون-ئالتىلىك x00
﴾.

چىقىرىش ياز: ﴿ utf16 كود-يېشىش: ⌝'utf16le'⌜ ﴾, يېڭى-قۇر.

utf16 بوشات.
>> utf32 := Blob يېڭى: 13, بايتلار: ﴿
	تىزىم يېڭى ; ئون-ئالتىلىك x00 ; ئون-ئالتىلىك x00 ; ئون-ئالتىلىك x00 ; ئون-ئالتىلىك x41
	         ; ئون-ئالتىلىك x00 ; ئون-ئالتىلىك x01 ; ئون-ئالتىلىك xF6 ; ئون-ئالتىلىك x0A
	         ; ئون-ئالتىلىك x00 ; ئون-ئالتىلىك x00 ; ئون-ئالتىلىك x00 ; ئون-ئالتىلىك x42
	         ; ئون-ئالتىلىك x00
﴾.

چىقىرىش ياز: ﴿ utf32 كود-يېشىش: ⌝'utf32be'⌜ ﴾, يېڭى-قۇر.
utf32 بوشات.