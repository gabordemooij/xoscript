>> repeater := ئوبيېكت يېڭى.
repeater كەلگەندە: ⌝'جاۋاب:'⌜ قىل: ⎬ :what
	چىقىرىش ياز: what + ⌝' '⌜.
⎨.
repeater كەلگەندە: ⌝'جاۋاب:ۋە:'⌜ قىل: ⎬ :what :say
	چىقىرىش ياز: what, ياز: say + ⌝' '⌜.
⎨.
repeater كەلگەندە: ⌝'جاۋاب:ۋە:ۋە:'⌜ قىل: ⎬ :what :say :more
	چىقىرىش ياز: what, ياز: say, ياز: more.
⎨.
repeater repeat.
repeater everything: ⌝'I say.'⌜.
repeater and: ⌝'I '⌜ everything: ⌝'do.'⌜.
