Server init.

>> DB := Maria-DB يېڭى باش-ماشىنا: ⌝'localhost'⌜,
	ئىشلەتكۈچى-ئاتى: ⌝'xo'⌜,
	ئىم: ⌝'pass123'⌜,
	ساندان-ئاتى: ⌝'xobase'⌜,
	باغلان.
	
>> SQL := ⌝'SELECT "hello" AS "world" '⌜.

# a quicker way, get query from DB:
>> query2 := DB سۈرۈشتۈرۈش: SQL.

# now you don't have to set DB
query2 ئېلىپ-كەل: ⎬ :row
	چىقىرىش ياز: row world, يېڭى-قۇر.
⎨.
