#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa pagdumala-sa-panumduman: 0.

{
Gutlo oras-karon.
Gutlo hulat: 1.
Gawas isulat: Programa gidaghanon-sa-argumento, bag-ong-linya.
Programa argumento: 0.
Numero random.
Gawas isulat: (Programa sistema: ['echo 'Hello'']).
} padagana.

Programa limpyohi.
usedMemory1 := (Programa panumduman ? 0).

{
Gutlo oras-karon.
Gutlo hulat: 1.
Gawas isulat: Programa gidaghanon-sa-argumento, bag-ong-linya.
Programa argumento: 0.
Numero random.
Gawas isulat: (Programa sistema: ['echo 'Hello'']).
} padagana.

Programa limpyohi.
usedMemory2 := (Programa panumduman ? 0).

{
Gutlo oras-karon.
Gutlo hulat: 1.
Gawas isulat: Programa gidaghanon-sa-argumento, bag-ong-linya.
Programa argumento: 0.
Numero random.
Gawas isulat: (Programa sistema: ['echo 'Hello'']).
} padagana.

Programa limpyohi.
usedMemory3 := (Programa panumduman ? 0).



( usedMemory1 = usedMemory2 ug: usedMemory1 = usedMemory3, ug: usedMemory2 = usedMemory3 ) tinuod: {
	Gawas isulat: ['No memory leaks here'].
}, bakak: {
	Gawas isulat: ['Leaking memory...'].
}.
