#Linux
>> OS := Programa kahikayan: ['OS'].

>> clock := Gutlo bag-o.
	
(OS = ['Haiku']) tinuod: {
	clock sona: ['CET'],
	tuig: 2017, bulan: 7, adlaw: 13,
	oras: 18, minuto: 0, segundo: 0.
}, kon-dili: {
	clock sona: ['Europe/Amsterdam'],
	tuig: 2017, bulan: 7, adlaw: 13,
	oras: 18, minuto: 0, segundo: 0.
}.

clock kon: ['tell'] buhata: {
	Gawas isulat: kaugalingon, bag-ong-linya.
}.


clock idugang: 2    oras, tell.
clock idugang: 1    oras, tell.
clock idugang: 19 minuto, tell.
clock idugang: 1  minuto, tell.
clock idugang: 1  minuto, tell.
clock idugang: 19 segundo, tell.
clock idugang: 1  segundo, tell.
clock idugang: 1  segundo, tell.
clock idugang: 2    tuig, tell.
clock idugang: 1    tuig, tell.

(OS = ['Haiku']) tinuod: {
clock idugang: 5   bulan.
clock sona: ['CEST'], tell.
}, kon-dili: {
	clock idugang: 5   bulan, tell.
}.

clock idugang: 1   bulan, tell.
clock idugang: 19    adlaw, tell.
clock idugang: 1    oras, tell.
clock idugang: 120  yard, tell.
