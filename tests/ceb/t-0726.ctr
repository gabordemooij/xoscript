# test buffers PKI/Sign 
Server init.

>> long := ( Lista bag-o pun-on: 1000 sa: ['a'] ) hiusaha: [''].

# sign a message
Gawas isulat: ( 
	Kaha pirmahi: ['abc'] gamit: long
), bag-ong-linya.

Gawas isulat: ( 
	Kaha
		susiha: ['abc'] 
		pirma: long 
		gamit: long
), bag-ong-linya.

Gawas isulat: (
	Kaha hash-sa-password: long pamatud-i: long
), bag-ong-linya.
