

>> obj := Butang bag-o.

obj kon: ['greet'] buhata: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj kon: ['task'] buhata: {
	akoa property := 123.
	{
		# try binds self/own to object instead of block
		Gawas isulat: kaugalingon greet.
		Gawas isulat: akoa property.
		1 / 0.
	} dakpon: {
		Gawas isulat: kaugalingon greet.
		Gawas isulat: akoa property.
		Gawas isulat: ['ok'].
	}, sulayi.
}.

obj task.