Gawas isulat: ['Test object'], bag-ong-linya.
>> cmd := Sugo bag-o.
Gawas isulat: cmd ls /tmp, bag-ong-linya.
>> old-cmd-address := cmd prototipo adres-sa-panumduman.
cmd save-as: ['/tmp/a.bin'].
Gawas isulat: ['========== RELOADING SNAP:'], bag-ong-linya.
>> b := Butang load-from: ['/tmp/a.bin'].
(b prototipo adres-sa-panumduman = old-cmd-address) tinuod: {
	Gawas isulat: ['Object link re-attached.'], bag-ong-linya.
}.
Gawas isulat: b ls, bag-ong-linya.


