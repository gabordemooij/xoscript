# test qualifiers

>> $ := Butang bag-o.

$ kon: ['tubag:'] buhata: { :x
	
	>> operation := x titik: 0.
	>> valuta := x titik: 1.
	>> money := x laktawi: 2.
	
	>> amount := 0.

	( operation = ['+'] ) tinuod: {
		( valuta = ['£'] ) tinuod: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Gawas isulat: x, bag-ong-linya.


>> Fruit := Butang bag-o.

Fruit kon: ['bag-o'] buhata: {
	>> f := kaugalingon bag-o.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit kon: ['apples:'] buhata: { :a akoa apples := a. }.
Fruit kon: ['oranges:'] buhata: { :p akoa oranges := p. }.
Fruit kon: ['apples'] buhata: { <- akoa apples. }.
Fruit kon: ['oranges'] buhata: { <- akoa oranges. }.

Fruit kon: ['+'] buhata: { :f
	
	>> n := Fruit bag-o.
	f idugang: 1.
	
	n apples: (f apples + akoa apples).
	n oranges:  (f oranges  + akoa oranges). <- n.
}.

Fruit kon: ['teksto'] buhata: { <- ( akoa apples teksto + [' apples and '] + akoa oranges + [' oranges'] ).
}.

Numero kon: ['apples'] buhata: { <- ((Fruit bag-o) apples: kaugalingon).
}.

Numero kon: ['apple'] buhata: { <- ((Fruit bag-o) apples: kaugalingon).
}.

Numero kon: ['oranges'] buhata: { <- ((Fruit bag-o) oranges: kaugalingon).
}.




Gawas isulat: (1 apple + 3 oranges + 4 apples), bag-ong-linya.


Teksto kon: ['twice'] buhata: { <- ((kaugalingon teksto) + (kaugalingon teksto)).
}.



Gawas isulat: ['❤❤❤'] twice.



