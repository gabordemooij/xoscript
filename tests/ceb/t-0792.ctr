Server init.

>> DB := Maria-DB bag-o host: ['localhost'],
	ngalan-sa-user: ['xo'],
	password: ['pass123'],
	ngalan-sa-database: ['xobase'],
	sumpay.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB pangutana: SQL.

# now you don't have to set DB
query2 kuhaa: { :row
	Gawas isulat: row world, bag-ong-linya.
}.
