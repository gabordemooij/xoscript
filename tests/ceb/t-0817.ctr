# a value ending in the first part of an opening quote must survive serialization
>> mga-bili := Lista bag-o
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

mga-bili matag: { :i :value
	>> d := Diksyonaryo bag-o.
	d ibutang: value sa: ['k'].
	d ibutang: ['second'] sa: ['j'].
	>> r := d kodigo butang.
	Gawas isulat: r ihap, bag-ong-linya.
	Gawas isulat: ( (r sa: ['k']) = value ), bag-ong-linya.
}.
