

# create a 64-bit integer for exact calculations
>> a := Int64 gikan-sa-teksto: ['123'].

# to string
Gawas isulat: a, bag-ong-linya.

# divide
Gawas isulat: a / (Int64 gikan-sa-teksto: ['3']), bag-ong-linya.

# multiply
Gawas isulat: a * (Int64 gikan-sa-teksto: ['2']), bag-ong-linya.

# add
Gawas isulat: a + (Int64 gikan-sa-teksto: ['1']), bag-ong-linya.

# subtract
Gawas isulat: a - (Int64 gikan-sa-teksto: ['2']), bag-ong-linya.

# compare
Gawas isulat: ( a =   (Int64 gikan-sa-teksto: ['123'])), bag-ong-linya.
Gawas isulat: ( a !=: (Int64 gikan-sa-teksto: ['124'])), bag-ong-linya.
Gawas isulat: ( a <   (Int64 gikan-sa-teksto: ['124'])), bag-ong-linya.
Gawas isulat: ( a >   (Int64 gikan-sa-teksto: ['122'])), bag-ong-linya.
Gawas isulat: ( a >=: (Int64 gikan-sa-teksto: ['123'])), bag-ong-linya.
Gawas isulat: ( a <=: (Int64 gikan-sa-teksto: ['123'])), bag-ong-linya.





	