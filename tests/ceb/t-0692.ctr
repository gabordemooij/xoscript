Server init.

Gawas isulat: (
	Sumbanan bag-o: ['^\\w+$'],
	tukma: ['test@example.com'] 
), bag-ong-linya. # 0 match, fails on @ and .

Gawas isulat: (
	Sumbanan bag-o: ['^[^@]+@[^\.]+\.\\w+$'],
	tukma: ['test@example.com'] 
), bag-ong-linya. # 1 match

Gawas isulat: (
	Sumbanan bag-o: ['[^@]+@[^\.]+\.\\w+'],
	tukma: ['test@example.com'] 
), bag-ong-linya. # 1 match

Gawas isulat: (
	Sumbanan bag-o: ['([^@]+)@([^\.]+)\.\\w+'],
	tukma: ['test@example.com'] 
), bag-ong-linya. # 1 match, groups dont matter

Gawas isulat: (
	Sumbanan bag-o: ['[a-z]'],
	tukma: ['test@example.com'] 
), bag-ong-linya. # 14 matches

Gawas isulat: (
	Sumbanan bag-o: ['.*'],
	tukma: ['test@example.com'] 
), bag-ong-linya. # 1 match (all)

Gawas isulat: (
	Sumbanan bag-o: ['(.*)'],
	tukma: ['test@example.com'] 
), bag-ong-linya. # 1 match (all)

Gawas isulat: (
	Sumbanan bag-o: ['\\s*[^@]+@[^\.]+\.\\w+'],
	tukma: ['test@example.com'] 
), bag-ong-linya. # 1 match, prefix space optional, gets ignored