

Lista kon: ['fixture:'] buhata: { :f
	akoa fixture := f.
}.

Lista kon: ['ihap'] buhata: { <- akoa fixture.
}.

Lista kon: ['aantal'] buhata: { <- akoa fixture.
}.


>> x := Wala.
{

	x := ['hello'] 
	ilisi:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] titik: 2)
			)
		)
	ug: (
		(['...hal'] + ['lo']) 
			dagkong-titik 
			lowecase 
			dagkong-titik 
			laktawi: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Lista ← 0 ; 1 ; 4; 9 ; (Lista ← 0 ; 3; 1) ; 4
							) sa-dili-pa-katapusan
						) ? 1
					) + 
					((Lista ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					ihap
				)
			)
	).

} × 10.
Gawas isulat: x, bag-ong-linya.

