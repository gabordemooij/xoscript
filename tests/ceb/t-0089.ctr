>> randomizer := { :a :b
	>> kinagamyan := ( a < b ) kini: a o-kana: b.
	>> kinadak-an := ( a > b ) kini: a o-kana: b.
	>> x := Wala.
	{
		x := Numero sa-taliwala: a ug: b.
		((x < kinagamyan) o: (x > kinadak-an)) tinuod: { 
			Gawas isulat: (['Invalid value!']).
			Programa taposa.
		}.
	} 
	× 100. <- x.
}.
randomizer ipadapat: 0 ug: 0.
randomizer ipadapat: 1 ug: 0.
randomizer ipadapat: 1 ug: 1.
randomizer ipadapat: 0 ug: 1.
randomizer ipadapat: -1 ug: 0.
randomizer ipadapat: -1 ug: -1.
randomizer ipadapat: 0 ug: -1.
