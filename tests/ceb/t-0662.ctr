>> t := Wala.

# you can control the time zone for
# parsing like this:
Gutlo sona: ['CET'].
t := Gutlo gikan: ['1981-02-03 04:05:06'].
Gawas isulat: t, bag-ong-linya.

# now using CEST time zone:
Gutlo sona: ['CEST'].
t := Gutlo gikan: ['1981-02-03 04:05:06'].
Gawas isulat: t, bag-ong-linya.

# error if string cannot be parsed
{ Gutlo gikan: ['1900']. } dakpon: { Wala. }, padagana.
