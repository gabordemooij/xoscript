Server init.

>> DB := Maria-DB bag-o host: ['localhost'],
	ngalan-sa-user: ['xo'],
	password: ['pass123'],
	ngalan-sa-database: ['xobase'],
	sumpay.

{
	DB pangutana:
	['DROP TABLE movies'],
	ipatuman.
} dakpon: { Wala. }, padagana.

DB pangutana:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
ipatuman.

DB pangutana: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
mga-parametro: ( Lista bag-o ; ['Halloween'] ),
ipatuman.

DB pangutana: ['SELECT * FROM movies'],
kuhaa: { :movie
	Gawas isulat: movie title, bag-ong-linya.
}.

