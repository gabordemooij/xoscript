# test number -> string -> number
{

	>> x := Numero sa-taliwala: 0 ug: 1000000.
	>> d := Numero sa-taliwala: 1 ug: 7.
	>> e := 10 gipataas-sa: d.

	x bahinon-sa: e.
	>> y := x teksto numero.

	(x = y) bakak: {
		Gawas isulat: x, bag-ong-linya.
		Gawas isulat: y, bag-ong-linya.
		Programa taposa.
	}.

} * 1000.
Gawas isulat: ['OK'], bag-ong-linya.