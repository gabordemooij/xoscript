
Teksto kon: ['evaluate'] buhata: {
	>> kodigo := Payl bag-o: ['/tmp/eval.ctr'].
	kodigo isulat: (kaugalingon teksto + ['.']).
	Programa gamita: ['/tmp/eval.ctr'].
}.

>> map :=
	(Diksyonaryo bag-o)
	ibutang: ['Hi There'] sa: ['two'],
	ibutang: (Lista ← ['hello'] ; ['world'] ; (Lista ← 1 ; 2; 9) ; Bakak) sa: ['one'],
	ibutang: ( (Diksyonaryo bag-o) ibutang: ['wrrld'] sa: ['misspelled'] ) sa: ['three'],
	ibutang: (Lista ← ((Diksyonaryo bag-o) ibutang: ['treasure'] sa: ['hidden']) ; 2) sa: ['four']. 
>> str := map teksto.
>> map2 := Wala.
(['map2 := '] + str ) evaluate.
Gawas isulat: map2 ? ['one'] ? 0.
Gawas isulat: map2 ? ['one'] ? 1.
Gawas isulat: map2 ? ['four'] ? 0 ? ['hidden'].
Gawas isulat: map2 ? ['one'] ? 2 ? 2.
