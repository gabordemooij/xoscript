

>> Matryoshka := Butang bag-o.
Matryoshka kon: ['double:'] buhata: { :secret
	akoa secret := secret × 2.
}.
Matryoshka kon: ['bag-o:'] buhata: { :secret
	>> answer := Wala.
	>> t := (secret > 255).
	Gawas isulat: (secret + [' | '] + t), bag-ong-linya.
	t tinuod: {
		answer := secret.
	}, kon-dili: {
		answer := Matryoshka rekursibo bag-o: (kaugalingon double: secret).
	}. <- answer.
}.

>> x := Matryoshka bag-o: 2.
