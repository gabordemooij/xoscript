Gawas isulat: ['Test object'], bag-ong-linya.
>> a := Butang bag-o. 

a kon: ['item:'] buhata: { :binhelper
	akoa binhelper := binhelper. 
}.

a kon: ['item'] buhata: { <- akoa binhelper.
}.

a item: Bin bag-o.

>> old-binhelper-address := a item prototipo adres-sa-panumduman.
a save-as: ['/tmp/a.bin'].
Gawas isulat: ['========== RELOADING SNAP:'], bag-ong-linya.

>> b := Butang load-from: ['/tmp/a.bin'].

(b item prototipo adres-sa-panumduman = old-binhelper-address) tinuod: {
	Gawas isulat: ['Object link re-attached.'], bag-ong-linya.
}.


