Numero kon: ['factorial'] buhata: {
	>> total := 1.
	{ :index total padaghana-sa: (kaugalingon - (index)). } × kaugalingon. <- total.
}.
>> Printer := Butang bag-o.
Printer kon: ['print:and:'] buhata: { :x :y
	Gawas isulat: ['a='] + x + [', b='] + y, bag-ong-linya.
}.
>> a := 4.5. >> b := a lingina-paubos.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a lingina-pataas.
Printer print: a and: b.
a := 4.5. b := a lingina-paubos.
Printer print: a and: b.
a := 4.5. b := a lingina.
Printer print: a and: b.
a := 4.2. b := a lingina.
Printer print: a and: b.

Gawas isulat: (9 sobra: 5), bag-ong-linya.
Gawas isulat: -666 hingpit-nga-bili, bag-ong-linya.
Gawas isulat: 49 gamot-kwadrado, bag-ong-linya.
Gawas isulat: (2 gipataas-sa: 3), bag-ong-linya.
>> l := (Lista ← 9 ; 6).
Gawas isulat: l kinagamyan.

