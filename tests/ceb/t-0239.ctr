Lista kon: ['sum'] buhata: {
	>> total := 0.
	kaugalingon matag: { :index :element
		total idugang: element.
	}. <- total.
}.

>> a := Tinuod.



a kon: ['teksto'] buhata: {
	>> answer := Wala.
	( kaugalingon = Tinuod ) tinuod: {
		answer := ['Yep'].
	}, kon-dili: {
		answer := ['Nope'].
	}. <- answer.
}.

a kon: ['numero'] buhata: {
	>> answer := Wala.
	( kaugalingon = Tinuod ) tinuod: {
		answer := 10.
	}, kon-dili: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b kon: ['teksto'] buhata: { <- ['Devil'].
}.

b kon: ['boolean'] buhata: { <- Bakak.
}.


Gawas isulat: a, bag-ong-linya.  
Gawas isulat: (90 + a), bag-ong-linya. 
Gawas isulat: b, bag-ong-linya. 
Gawas isulat: (Tinuod ug: b), bag-ong-linya.

a := Lista ← ['hello'] ; ['world'] ; Tinuod ; Wala ; 666. 
a := a + ( Lista ← 1 ).
Gawas isulat: a, bag-ong-linya.
Gawas isulat: ((Diksyonaryo bag-o) ibutang: Wala sa: Wala), bag-ong-linya.
Gawas isulat: a sum, bag-ong-linya. 


{
	a kon: ['teksto'] buhata: { <- Wala. }.
	a := [''] + a.
} dakpon: { :error
	Gawas isulat: ['Error noted: '] + error, bag-ong-linya.
}, padagana.



{
	a kon: ['numero'] buhata: { <- Wala. }.
	a := 3 × a.
} dakpon: { :error
	Gawas isulat: ['Error noted: '] + error, bag-ong-linya.
}, padagana.


{
	a kon: ['boolean'] buhata: { <- Wala. }.
	a := Tinuod ug: a. 
} dakpon: { :error
	Gawas isulat: ['Error noted: '] + error, bag-ong-linya.
}, padagana.





