>> Slurp := Butang bag-o.

Slurp kon: ['bag-o'] buhata: {
	akoa str := [''].
}.

Slurp kon: ['tubag:'] buhata: { :blah
		(akoa str = ['']) tinuod: {
			akoa str idugang-sa-tumoy: blah.
		}, kon-dili: {
			akoa str idugang-sa-tumoy: [' '].
			akoa str idugang-sa-tumoy: blah.
		}.
}.

Slurp kon: ['tubag:ug:'] buhata: { :blah :blahah
		(blah gitas-on > 1) tinuod: {
			akoa str idugang-sa-tumoy: (blah gikan-sa: 0 gitas-on: (blah gitas-on - 1)).
		}, kon-dili: {
			akoa str idugang-sa-tumoy: blah.
		}.
		akoa str idugang-sa-tumoy: [' '].
		akoa str idugang-sa-tumoy: blahah.
}.

Slurp kon: ['obtain'] buhata: {
	>> buffer := akoa str.
	akoa str := ['']. <- buffer.
}.


>> x := Slurp bag-o.
x + 3.
Gawas isulat: (x obtain), bag-ong-linya.
x echo: ['Hello world'].
Gawas isulat: (x obtain), bag-ong-linya.
x tellme: 123 and: 987.
Gawas isulat: (x obtain), bag-ong-linya.
