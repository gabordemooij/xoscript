Numero kon: ['roman'] buhata: {
	>> numero := kaugalingon kopyaha.
	>> roman := [''].
	{
		{
			(numero ≥ 1000) tinuod: {
				roman idugang-sa-tumoy: ['Ⅿ'].
				numero kuhai: 1000.
			}, hunonga.
		
			(numero ≥ 500) tinuod: {
				roman idugang-sa-tumoy: ['Ⅾ'].
				numero kuhai: 500.
			}, hunonga.
		
			(numero ≥ 100) tinuod: {
				roman idugang-sa-tumoy: ['Ⅽ'].
				numero kuhai: 100.
			}, hunonga.
		
			(numero ≥ 50) tinuod: {
				roman idugang-sa-tumoy: ['Ⅼ'].
				numero kuhai: 50.
			}, hunonga.
		
			(numero ≥ 50) tinuod: {
				roman idugang-sa-tumoy: ['Ⅼ'].
				numero kuhai: 50.
			}, hunonga.
		
			(numero ≥ 10) tinuod: {
				roman idugang-sa-tumoy: ['Ⅹ'].
				numero kuhai: 10.
			}, hunonga.
			
			(numero ≥ 9) tinuod: {
				roman idugang-sa-tumoy: ['Ⅸ'].
				numero kuhai: 9.
			}, hunonga.
			
			(numero ≥ 5) tinuod: {
				roman idugang-sa-tumoy: ['Ⅴ'].
				numero kuhai: 5.
			}, hunonga.
			
			(numero ≥ 4) tinuod: {
				roman idugang-sa-tumoy: ['Ⅳ'].
				numero kuhai: 4.
			}, hunonga.
			
			(numero ≥ 1) tinuod: {
				roman idugang-sa-tumoy: ['Ⅰ'].
				numero kuhai: 1.
			}, hunonga.
		} pamaagi.
	} samtang: { <- numero > 0. }. <- roman.
}.

Gawas isulat: 1 roman, bag-ong-linya.
Gawas isulat: 2 roman, bag-ong-linya.
Gawas isulat: 4 roman, bag-ong-linya.
Gawas isulat: 8 roman, bag-ong-linya.
Gawas isulat: 16 roman, bag-ong-linya.
Gawas isulat: 32 roman, bag-ong-linya.
Gawas isulat: 64 roman, bag-ong-linya.
Gawas isulat: 128 roman, bag-ong-linya.
Gawas isulat: 256 roman, bag-ong-linya.
Gawas isulat: 1024 roman, bag-ong-linya.
