# catch-all test (practical)
>> HTML := Teksto bag-o.
HTML kon: ['encode:'] buhata: { :tekst
	kaugalingon idugang-sa-tumoy: (tekst
	ilisi: ['&'] ug: ['&amp;'], 
	ilisi: ['<'] ug: ['&lt;'],
	ilisi: ['>'] ug: ['&gt;'],
	ilisi: ['"'] ug: ['&quot;']).
}.
>> blog := HTML bag-o.
blog idugang-sa-tumoy: ['<h1>'],
     encode: ['Koffie & Thee'],
     idugang-sa-tumoy: ['</h1>'].
Gawas isulat: blog, bag-ong-linya.


>> Roman := Numero bag-o.
Roman kon: ['stringy'] buhata: {
	>> a := [''].
	{ a idugang-sa-tumoy: ['I']. } × kaugalingon. <- a.
}.

>> x := Roman bag-o.
x idugang: 3.
Gawas isulat: x stringy, bag-ong-linya.

>> Quantum := Boolean bag-o.
Quantum kon: ['true?'] buhata: { <- ['maybe True']. }.
Gawas isulat: (Quantum bag-o true?), bag-ong-linya.

>> Nihil := Wala bag-o.
Nihil kon: ['teksto'] buhata: { <- ['Nihil']. }.
Gawas isulat: (Nihil bag-o), bag-ong-linya.
