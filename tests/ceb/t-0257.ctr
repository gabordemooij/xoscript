
>> Greeter := Butang bag-o.
Greeter kon: ['bag-o'] buhata: {
	akoa ngalan := ['?'].
}.
Greeter kon: ['name:'] buhata: { :ngalan
	akoa ngalan := ngalan.
}.
Greeter kon: ['greet'] buhata: {
	Gawas isulat: (['hello[you]'] [you]: akoa ngalan).
}.
>> friend := Greeter bag-o.
friend name: ['1'].
friend greet.
