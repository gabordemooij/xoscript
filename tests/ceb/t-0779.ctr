Gawas isulat: ['Test object'], bag-ong-linya.
>> p := Agianan /tmp.
Gawas isulat: p, bag-ong-linya.
>> old-p-address := p prototipo adres-sa-panumduman.
p save-as: ['/tmp/a.bin'].
Gawas isulat: ['========== RELOADING SNAP:'], bag-ong-linya.
>> b := Butang load-from: ['/tmp/a.bin'].
(b prototipo adres-sa-panumduman = old-p-address) tinuod: {
	Gawas isulat: ['Object link re-attached.'], bag-ong-linya.
}.
Gawas isulat: b, bag-ong-linya.
