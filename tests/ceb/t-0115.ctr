{
	kining-buluhaton sayup: ['Dont fail.'].
	unknown doSomething.
} dakpon: {
	Gawas isulat: ['Caught!'].
}, padagana.

{
	kining-buluhaton sayup: ['Dont fail.'].
	akoa unknown doSomething.
} dakpon: {
	Gawas isulat: ['Caught!'].
}, padagana.

{
	kining-buluhaton sayup: ['Dont fail.'].
	unknown := 122.
} dakpon: {
	Gawas isulat: ['Caught!'].
}, padagana.


{
	kining-buluhaton sayup: ['Dont fail.'].
	Tinuod hunonga.
	Gawas isulat: ['FAIL'].
} dakpon: {
	Gawas isulat: ['Caught!'].
}, padagana.

{
	{
		kining-buluhaton sayup: ['Dont fail.'].
		Tinuod hunonga.
		Gawas isulat: ['FAIL'].
	} dakpon: { :x
		(x = ['Dont fail.']) tinuod: { kining-buluhaton sayup: ['Nested Caught!']. }.
	}, padagana.
} dakpon: { :e
	Gawas isulat: e.
}, padagana.
