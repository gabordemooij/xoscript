# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob bag-o: 8, bytes: (
	Lista bag-o ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Gawas isulat: ( utf16 i-decode: ['utf16le'] ), bag-ong-linya.

utf16 buhii.
>> utf32 := Blob bag-o: 13, bytes: (
	Lista bag-o ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Gawas isulat: ( utf32 i-decode: ['utf32be'] ), bag-ong-linya.
utf32 buhii.