
Lista kon: ['product'] buhata: {
	>> total := 1.
	kaugalingon matag: { :index :element
		total padaghana-sa: element.
	}. <- total.
}.

>> a := Lista ← 1 ; 2 ; 3.
Gawas isulat: a product, bag-ong-linya.
Gawas isulat: (Lista ← 2 ; 4 ; 8) product, bag-ong-linya. 
Gawas isulat: (Lista ← -2 ; 10) product, bag-ong-linya. 
Gawas isulat: (Lista ← 0.5 ; -2) product, bag-ong-linya. 
