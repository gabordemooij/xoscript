>> Greeter := Butang bag-o.
Greeter kon: ['make'] buhata: {
	>> gr := Butang bag-o.
	gr kon: ['setName:'] buhata: { :aname
		akoa ngalan := aname.
	}.
	gr kon: ['greet'] buhata: {
		Gawas isulat: akoa ngalan.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a bag-o.
c setName: ['THREE'].
c greet.
>> d := a bag-o.
d setName: ['FOUR'].
d greet.
c greet.
