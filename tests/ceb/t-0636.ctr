# test url parsing

Server init.
>> url := URL gikan: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Gawas isulat: ['scheme = '] + url eskema, bag-ong-linya.
Gawas isulat: ['host = '] + url host, bag-ong-linya.
Gawas isulat: ['port = '] + url port, bag-ong-linya.
Gawas isulat: ['path = '] + url dalan-sa-payl, bag-ong-linya.
Gawas isulat: ['query = '] + url parametro-sa-pagpangita, bag-ong-linya.
Gawas isulat: ['fragment = '] + url tipik, bag-ong-linya.
