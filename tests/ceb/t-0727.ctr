Server init.
>> f := Porma bag-o: ['%d'].
>> a := Blob bag-o: 4.
a bytes: ( Lista bag-o ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob bag-o: 4.
b bytes: ( Lista bag-o ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a gikan-sa: 0 gitas-on: 3, matag: { :i :byte
	Gawas isulat: ( f ipadapat-tibuok-numero: byte ), bag-ong-linya.
}.
a ^ b.
a gikan-sa: 0 gitas-on: 3, matag: { :i :byte
	Gawas isulat: ( f ipadapat-tibuok-numero: byte ), bag-ong-linya.
}.
a ^ b.
a gikan-sa: 0 gitas-on: 3, matag: { :i :byte
	Gawas isulat: ( f ipadapat-tibuok-numero: byte ), bag-ong-linya.
}.
a buhii.
b buhii.

{ a ^ Butang. } dakpon: { :e Gawas isulat: e, bag-ong-linya. }, padagana.
