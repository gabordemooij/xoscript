>> makeAdder := { :x
	>> f := { :y <- (akoa x + y). } ibutang: ['x'] bili: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i akoa q ibutang: (akoa f ipadapat: (akoa q ? i)) sa: i. } 
	ibutang: ['q'] bili: array,
	ibutang: ['f'] bili: func.
	{ :i mapping ipadapat: i. } × (array ihap).
}.

>> a := Lista ← 1; 2; 3.
mapper ipadapat: a ug: (makeAdder ipadapat: 100).
Gawas isulat: (a posisyon: 0), bag-ong-linya.
Gawas isulat: (a ? 1), bag-ong-linya.
Gawas isulat: (a ? 2), bag-ong-linya.
