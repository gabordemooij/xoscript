Gawas isulat: ['Test object'], bag-ong-linya.
>> a := Butang bag-o. 

a kon: ['item:'] buhata: { :fmt
	akoa fmt := fmt. 
}.

a kon: ['item'] buhata: { <- akoa fmt.
}.

a item: ( Porma bag-o: ['|%s|'] ).

Gawas isulat: a item, bag-ong-linya.

>> old-fmt-address := a item prototipo adres-sa-panumduman.
a save-as: ['/tmp/a.bin'].
Gawas isulat: ['========== RELOADING SNAP:'], bag-ong-linya.

>> b := Butang load-from: ['/tmp/a.bin'].

(b item prototipo adres-sa-panumduman = old-fmt-address) tinuod: {
	Gawas isulat: ['Object link re-attached.'], bag-ong-linya.
}.

Gawas isulat: ( b item ipadapat: ['hello'] ), bag-ong-linya.
