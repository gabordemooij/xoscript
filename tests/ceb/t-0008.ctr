>> Greeter := Butang bag-o.
Greeter kon: ['make'] buhata: {
	>> greeter := Butang bag-o.
	greeter kon: ['name:'] buhata: { :ngalan
		Gawas isulat: ['setting a name'].
		akoa myName := ngalan.
	}.
	greeter kon: ['greet'] buhata: {
		Gawas isulat: ['Hello'].
		Gawas isulat: akoa myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
