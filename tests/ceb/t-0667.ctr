# test Program version

# this feature is disabled by default
Gawas isulat: (
	Programa bahin: 
	['RECURSIVE_STRINTPOL']
), bag-ong-linya.


# but if we set the time back
>> today := Gutlo 
sona: ['CEST'],
gikan: ['2026-02-15 10:00:00'].
Programa bersyon: today.

# it will be enabled like it used to be (from now on)
Gawas isulat: (
	Programa bahin: 
	['RECURSIVE_STRINTPOL']
), bag-ong-linya.