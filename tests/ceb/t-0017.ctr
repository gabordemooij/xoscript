Numero kon: ['factorial'] buhata: {
	>> total := 1.
	{ :index total padaghana-sa: (kaugalingon - (index)). } × kaugalingon. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Gawas isulat: a.
>> b := 2 + 3 factorial.
Gawas isulat: b.
>> c := 3 factorial + 2.
Gawas isulat: c.
>> d := 2 + (3 factorial).
Gawas isulat: d.
Gawas isulat: 2 + 3 factorial + 1.
