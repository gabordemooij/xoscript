# test list operations


>> cakes := Lista ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes pulihan: 1 gitas-on: 2 sa: ( Lista ← ['cinnamon'] ; ['pineapple'] ).
Gawas isulat: (buy hiusaha: [',']), bag-ong-linya.


>> buy := cakes pulihan: 1 gitas-on: 12 sa: ( Lista ← ['cinnamon'] ; ['pineapple'] ).
Gawas isulat: (buy hiusaha: [',']), bag-ong-linya.


>> buy := cakes pulihan: 2 gitas-on: 10 sa: ( Lista bag-o ).
Gawas isulat: (buy hiusaha: [',']), bag-ong-linya.


>> buy := cakes pulihan: 0 gitas-on: 1 sa: ( Lista bag-o ).
Gawas isulat: (buy hiusaha: [',']), bag-ong-linya.


>> buy := cakes pulihan: ['0'] gitas-on: ['1'] sa: ['x'].
Gawas isulat: (buy hiusaha: [',']), bag-ong-linya.
