Gawas isulat: ['Test object'], bag-ong-linya.
>> greeter := Butang bag-o.
greeter kon: ['name:'] buhata: { :ngalan
	akoa xname := ngalan. 
}.
greeter kon: ['greet'] buhata: {
	Gawas isulat: ['Hello '] + akoa xname, bag-ong-linya.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Gawas isulat: ['========== RELOADING SNAP:'], bag-ong-linya.
>> b := Butang load-from: ['/tmp/a.bin'].
>> c := Butang load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
