#Linux

(Payl bag-o: ['/tmp/testje']) anaa bakak: {
	Programa sistema: ['mkdir /tmp/testje'].	
}.

(Payl bag-o: ['/tmp/testje/file1']) anaa bakak: {
	Programa sistema: ['touch /tmp/testje/file1'].	
}.

(Payl bag-o: ['/tmp/testje/folder1']) anaa bakak: {
	Programa sistema: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Payl lista: ['/tmp/testje'].

>> q := Lista bag-o.

l matag: { :k :v v matag: { :x :y q idugang-sa-tumoy: y. }. }.

>> s := q teksto.

(s naglangkob: ['file1']) tinuod:   { Gawas isulat: ['OK'], bag-ong-linya. }.
(s naglangkob: ['file2']) tinuod:   { Gawas isulat: ['XX'], bag-ong-linya. }.
(s naglangkob: ['folder1']) tinuod: { Gawas isulat: ['OK'], bag-ong-linya. }.
