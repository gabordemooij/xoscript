# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Sumbanan bag-o: pattern.
	p tukma: subject buhata: { :m :g
		Gawas isulat: g ihap, isulat: [' '], isulat: (g hiusaha: ['|']), bag-ong-linya. <- m.
	}.
}.
show ipadapat: ['(a)|(b)'] ug: ['b'].
show ipadapat: ['(a)|(b)'] ug: ['a'].
show ipadapat: ['(x)?y'] ug: ['y'].
show ipadapat: ['(x)?(y)(z)?'] ug: ['xy'].
