Programa pagdumala-sa-panumduman: 0.
Lista kon: ['sum'] buhata: {
	>> total := 0.
	kaugalingon matag: { :index :element
		total idugang: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Payl bag-o: ['/tmp/test.txt'].
f isulat: ['Lorem Ipsum'].
f sirad-i.
  

f := Payl bag-o: ['/tmp/test.txt'].
>> text := f basaha.
f sirad-i.



Programa limpyohi.
usedMemory1 := (Programa panumduman ? 1).



f := Payl bag-o: ['/tmp/test.txt'].
text := f basaha.
f sirad-i.

Programa limpyohi.
usedMemory2 := (Programa panumduman ? 1).


f := Payl bag-o: ['/tmp/test.txt'].
text := f basaha.
f sirad-i.

Programa limpyohi.
usedMemory3 := (Programa panumduman ? 1).



( usedMemory1 = usedMemory2 ug: usedMemory1 = usedMemory3, ug: usedMemory2 = usedMemory3 ) tinuod: {
	Gawas isulat: ['No memory leaks here'].
}, bakak: {
	Gawas isulat: ['Leaking memory...'].
}.
