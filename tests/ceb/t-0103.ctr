>> a := Lista ← Butang ; Tinuod ; Bakak ; Boolean ; 1 ; Numero ; ['Str'] ; Teksto ; { ['Empty']. }.
Gawas isulat: (a ihap), bag-ong-linya.
{ :i
	Gawas isulat: 
	['a '] + 
	((a ? i) matang) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Wala?) kini: [''] o-kana: ['NOT']) + 
	[' Nil.'],
	bag-ong-linya.
} × (a ihap).
Gawas isulat: ['but.. Nil is.. '] + ((Wala Wala?) kini: ['certainly NIL!'] o-kana: ['not NIL??']), bag-ong-linya.