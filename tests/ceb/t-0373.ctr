# compliance test

# use international numbers

Gawas isulat: ['1000 -> '].
Gawas isulat: 1000, bag-ong-linya. #1000

Gawas isulat: ['1.5 -> '].
Gawas isulat: 1.5, bag-ong-linya.  #1.5

Gawas isulat: ['1001.5 -> '].
Gawas isulat: 1.5 + 1000, bag-ong-linya. #1001.5

# use 0-indexed arrays
>> x := Lista bag-o ; 1 ; 2 ; 3.
>> y := Lista bag-o ; ['a'] ; ['b'] ; ['c'].

Gawas isulat: ['1 -> '].
Gawas isulat: x ? 0, bag-ong-linya. #1

Gawas isulat: ['1 -> '].
Gawas isulat: (x sa: 0), bag-ong-linya. #1

Gawas isulat: ['1 -> '].
Gawas isulat: x una, bag-ong-linya. #1

Gawas isulat: ['3 -> '].
Gawas isulat: x katapusan, bag-ong-linya. #3

Gawas isulat: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Gawas isulat: (x sumala-sa: y), bag-ong-linya.

Gawas isulat: ['1 -> '].
Gawas isulat: (x gikan-sa: 0 gitas-on: 1) una, bag-ong-linya. #1

Gawas isulat: ['0 -> '].
Gawas isulat: (x pangitaa: 1), bag-ong-linya. #0

x ibutang: 9 sa: 0.

Gawas isulat: ['9 -> '].
Gawas isulat: (x sa: 0), bag-ong-linya. #9

x idugang-sa-sinugdan: 8.
Gawas isulat: ['8 -> '].
Gawas isulat: (x sa: 0), bag-ong-linya. #9


x idugang-sa-tumoy: 10.
Gawas isulat: ['10 -> '].
Gawas isulat: (x sa: 4), bag-ong-linya. #10








