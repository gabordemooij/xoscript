c kon: ['greet:'] buhata: { Gawas isulat: ['greet!']. }.


Programa limpyohi.
>> usedMemory5 := (Programa panumduman ? 0).




(usedMemory1 = usedMemory2 = usedMemory3 = usedMemory4 = usedMemory5) tinuod: { 
	Gawas isulat: ['Memory usage remains stable.'], bag-ong-linya.
}, kon-dili: {
	Gawas isulat: ['Used memory not stable.'], bag-ong-linya.
}.
