

Programa pagdumala-sa-panumduman: 1.

>> x := 0.
>> y := ['Hello'].
>> q := { ['']. }.
>> p := Tinuod.
>> a := Lista ← 1 ; 2 ; 3 ; 4.
>> c := Butang bag-o.
c kon: ['greet:'] buhata: { Gawas isulat: ['greet!']. }.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.
>> usedMemory5 := 0.

Programa limpyohi.
>> usedMemory1 := (Programa panumduman ? 0).




x := 1.
y := ['Hello'].
q := { ['']. }.
p := Tinuod.
a := Lista ← 1 ; 2 ; 3 ; 5.
c := Butang bag-o.
c kon: ['greet:'] buhata: { Gawas isulat: ['greet!']. }.


Programa limpyohi.
>> usedMemory2 := (Programa panumduman ? 0).




x := 2.
