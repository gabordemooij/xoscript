q := { ['']. }.
p := Tinuod.
a := Lista ← 1 ; 2 ; 3 ; 4.
c := Butang bag-o.
c kon: ['greet:'] buhata: { Gawas isulat: ['greet!']. }.

Programa limpyohi.
>> usedMemory3 := (Programa panumduman ? 0).




x := 3.
y := ['Hello'].
q := { ['']. }.
p := Tinuod.
a := Lista ← 1 ; 2 ; 3 ; 5.
c := Butang bag-o.
c kon: ['greet:'] buhata: { Gawas isulat: ['greet!']. }.
c := Butang bag-o.
c kon: ['greet:'] buhata: { Gawas isulat: ['a different greet!'], bag-ong-linya. }.


Programa limpyohi.
>> usedMemory4 := (Programa panumduman ? 0).





x := 4.
y := ['Hello'].
q := { ['']. }.
