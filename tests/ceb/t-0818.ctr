# edge cases from a request must give an error or a result, not a crash
Server init.

Gawas isulat: ['<'] + (['abc'] gikan-sa: 0 gitas-on: 0, dagkong-titik) + ['>'], bag-ong-linya.
Gawas isulat: ['<'] + (['abc'] gikan-sa: 0 gitas-on: 0, gagmayng-titik) + ['>'], bag-ong-linya.
Gawas isulat: ['<'] + (['abc'] laktawi: 3, dagkong-titik) + ['>'], bag-ong-linya.
Gawas isulat: [''] dagkong-titik bytes, bag-ong-linya.
Gawas isulat: ['aB'] dagkong-titik, bag-ong-linya.
Gawas isulat: ['aB'] gagmayng-titik, bag-ong-linya.

Gawas isulat: (Gutlo bag-o: 0) tuig, bag-ong-linya.
{ Gutlo bag-o: ['9e300'] numero. } dakpon: { :e Gawas isulat: e, bag-ong-linya. }, padagana.
{ Gutlo bag-o: ['-9e300'] numero. } dakpon: { :e Gawas isulat: e, bag-ong-linya. }, padagana.
{ Gutlo bag-o: ['nan'] numero. } dakpon: { :e Gawas isulat: e, bag-ong-linya. }, padagana.
{ Gutlo bag-o: 9000000000000000000. } dakpon: { :e Gawas isulat: e, bag-ong-linya. }, padagana.
