Gawas isulat: ['Test object'], bag-ong-linya.
>> a := Butang bag-o. 

a kon: ['item:'] buhata: { :hexhelper
	akoa hexhelper := hexhelper. 
}.

a kon: ['item'] buhata: { <- akoa hexhelper.
}.

a item: Hx bag-o.

>> old-hexhelper-address := a item prototipo adres-sa-panumduman.
a save-as: ['/tmp/a.bin'].
Gawas isulat: ['========== RELOADING SNAP:'], bag-ong-linya.

>> b := Butang load-from: ['/tmp/a.bin'].

(b item prototipo adres-sa-panumduman = old-hexhelper-address) tinuod: {
	Gawas isulat: ['Object link re-attached.'], bag-ong-linya.
}.
