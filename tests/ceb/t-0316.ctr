>> Grandfather := Butang bag-o.
Grandfather kon: ['greet'] buhata: {
	Gawas isulat: ['Ave!'], bag-ong-linya.
}.
>> Father := Grandfather bag-o.
Father kon: ['greet'] buhata: {
	Gawas isulat: ['Hello'], bag-ong-linya.
	kaugalingon greet.
}.
>> Son := Father bag-o.
Son kon: ['greet'] buhata: {
	Gawas isulat: ['Hi'], bag-ong-linya.
	kaugalingon greet.
}.

Son greet.

>> Roundabout := Butang bag-o.
Roundabout kon: ['circle:'] buhata: { :x
	Gawas isulat: x, bag-ong-linya.
	(x < 3) tinuod: { kaugalingon rekursibo circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) tinuod: { Gawas isulat: x, bag-ong-linya. x idugang: 1.  increment padagana. }. }.
increment padagana.