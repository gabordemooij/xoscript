Gawas isulat: ['Test object'], bag-ong-linya.
>> a := Butang bag-o. 
a kon: ['item:'] buhata: { :int64
	akoa int64 := int64. 
}.
a kon: ['item'] buhata: { <- akoa int64.
}.
a item: ( Int64 gikan-sa-teksto: ['9999'] ).
Gawas isulat: a item, bag-ong-linya.
>> old-int64-address := a item prototipo adres-sa-panumduman.
a save-as: ['/tmp/a.bin'].
Gawas isulat: ['========== RELOADING SNAP:'], bag-ong-linya.
>> b := Butang load-from: ['/tmp/a.bin'].
(b item prototipo adres-sa-panumduman = old-int64-address) tinuod: {
	Gawas isulat: ['Object link re-attached.'], bag-ong-linya.
}.
Gawas isulat: ( b item ), bag-ong-linya.
