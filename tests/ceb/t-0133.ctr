


>> Deck := Lista bag-o.
Deck kon: ['print'] buhata: {
        >> len := kaugalingon ihap - 1.
        { :i
                >> len2 := kaugalingon ihap - 1.
                Gawas isulat: ['len: '].
                Gawas isulat: len, bag-ong-linya.
                Gawas isulat: ['len2: '].
                Gawas isulat: len2, bag-ong-linya.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
