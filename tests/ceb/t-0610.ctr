
>> Rectangle := Butang bag-o.

Rectangle kon: ['area'] buhata: { <- akoa gitas-on * akoa width.
}.

Rectangle kon: ['length:'] buhata: { :gitas-on
	akoa gitas-on := gitas-on.
}.

Rectangle kon: ['width:'] buhata: { :width
	akoa width := width.
}.

Rectangle kon: ['bag-o'] buhata: {
	# this will not result into an infinite loop
	>> rectangle := kaugalingon bag-o.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle bag-o.
Gawas isulat: a area, bag-ong-linya. #0

>> b := Rectangle bag-o length: 2, width: 3.
Gawas isulat: b area, bag-ong-linya. #6

