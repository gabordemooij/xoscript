Boolean kon: ['xor:'] buhata: { :a :b <- ((a ug: b dili) o: (a dili ug: b)).
}.

>> o := Butang bag-o.
o kon: ['hello'] buhata: { ['Empty']. }.
{ o kon: 2 buhata: 3.} dakpon: { :e Gawas isulat: e, bag-ong-linya. }, padagana.
{ o kon: ['sulay'] buhata: 3.} dakpon: { :e Gawas isulat: e, bag-ong-linya. }, padagana.
{ o kon: ['hello'] buhata: { ['Empty']. }.} dakpon: { :e Gawas isulat: e, bag-ong-linya. }, padagana. 
{ >> z := 4 ÷ 0. } dakpon: { :e Gawas isulat: e, bag-ong-linya. }, padagana. 
{ (Tinuod ug: Wala) tinuod: { Gawas isulat: ['X'].}. } dakpon: { :e Gawas isulat: e, bag-ong-linya. }, padagana. 
{ ([''] xor: 0) tinuod: { Gawas isulat: ['X'].}. } dakpon: { :e Gawas isulat: e, bag-ong-linya. }, padagana. 
{ (1 < ['2']) tinuod: { Gawas isulat: ['OK']. }. } dakpon: { :e Gawas isulat: e, bag-ong-linya. }, padagana. 
{ (1 < ['2.0']) tinuod: { Gawas isulat: ['OK']. }. } dakpon: { :e Gawas isulat: e, bag-ong-linya. }, padagana. 
{ (1 < ['x2.0']) tinuod: { Gawas isulat: ['NO!']. }. } dakpon: { :e Gawas isulat: e, bag-ong-linya. }, padagana. 
{ Gawas isulat: (['hello OK there'] gikan-sa: ['6'] gitas-on: ['2']). } padagana. 
