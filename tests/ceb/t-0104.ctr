
{ :i
	Gawas isulat: ['This is step #'] + ( ( i ) + 1 ), bag-ong-linya.
} × 6.

{ :i
	Gawas isulat: ['This is step #'] + ( 3 - ( i ) ), bag-ong-linya.
} × 6.

{ :i
	Gawas isulat: ['NEVER!'], bag-ong-linya.
} × 0.



{ :i
	Gawas isulat: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), bag-ong-linya.
} × 11.
