#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Sumbanan bag-o: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern tukma: subject buhata: { :m :x
	Gawas isulat: m, bag-ong-linya.
	Gawas isulat: x, bag-ong-linya. <- ['XXX'].
}.
Gawas isulat: result, bag-ong-linya.