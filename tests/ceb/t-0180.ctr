Teksto kon: ['html'] buhata: { <- (
		kaugalingon
		ilisi: ['&'] ug: ['&amp;'],
		ilisi: ['<'] ug: ['&lt;'],
		ilisi: ['>'] ug: ['&gt;'],
		ilisi: ['''] ug: ['&apos;'],
		ilisi: ['"'] ug: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa pagdumala-sa-panumduman: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Gawas isulat: txt kopyaha html, bag-ong-linya.
Gawas isulat: txt kopyaha gagmayng-titik, bag-ong-linya.
Gawas isulat: txt kopyaha dagkong-titik, bag-ong-linya.
} padagana.

Programa limpyohi.

usedMemory1 := (Programa panumduman ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Gawas isulat: txt kopyaha html, bag-ong-linya.
Gawas isulat: txt kopyaha gagmayng-titik, bag-ong-linya.
Gawas isulat: txt kopyaha dagkong-titik, bag-ong-linya.
} padagana.

Programa limpyohi.
usedMemory2 := (Programa panumduman ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Gawas isulat: txt kopyaha html, bag-ong-linya.
Gawas isulat: txt kopyaha gagmayng-titik, bag-ong-linya.
Gawas isulat: txt kopyaha dagkong-titik, bag-ong-linya.
} padagana.

Programa limpyohi.
usedMemory3 := (Programa panumduman ? 0).



( usedMemory1 = usedMemory2 ug: usedMemory1 = usedMemory3, ug: usedMemory2 = usedMemory3 ) tinuod: {
	Gawas isulat: ['No memory leaks here'].
}, bakak: {
	Gawas isulat: ['Leaking memory...'].
}.
