

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa pagdumala-sa-panumduman: 0.

>> txt := ['World Salad'].
Gawas isulat: ['this text contains: '] + ( ( txt bahina: [' '] ) ihap ) + [' words.'], bag-ong-linya.
txt := txt gikan-sa: 6 gitas-on: 4.
Gawas isulat: txt, bag-ong-linya.

Programa limpyohi.

usedMemory1 := (Programa panumduman ? 0).


txt := ['World Salad'].
Gawas isulat: ['this text contains: '] + ( ( txt bahina: [' '] ) ihap ) + [' words.'], bag-ong-linya.
