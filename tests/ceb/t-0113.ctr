Gawas isulat: ['Continue for-loop, No - before 6 and up.'], bag-ong-linya.
{ :i
	Gawas isulat: (i + 1), bag-ong-linya.
	((i + 1) > 4) padayon.
	Gawas isulat: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Gawas bag-ong-linya.
Gawas isulat: ['Continue while-true, No --> before 5 and up.'], bag-ong-linya.
{
	Gawas isulat: ['iteration #'] + x, bag-ong-linya.
	x idugang: 1.
	((x < 5) dili) padayon.
	Gawas isulat: ['-->'].
} samtang: xIsLessThan10.
Gawas bag-ong-linya.
Gawas isulat: ['Continue while-false, No - before 3 only.'], bag-ong-linya.
{
	Gawas isulat: ['iteration #'] + x, bag-ong-linya.
	x kuhai: 1.
	(x = 3) padayon.
	Gawas isulat: ['-'].
} samtang: { <- ( x > 0). }.

Gawas bag-ong-linya.
Gawas isulat: ['Continue times-loop, No ||| before 3.'], bag-ong-linya.
{ :i
	Gawas isulat: ['iteration #'] + i, bag-ong-linya.
	(i = 2) padayon.
	Gawas isulat: ['|||'].
} × 5.

Gawas bag-ong-linya.

{ Tinuod padayon. Gawas isulat: ['dont write this!'], bag-ong-linya. } padagana.

{ Tinuod padayon. Gawas isulat: ['dont write this!'], bag-ong-linya. } dakpon: { Gawas isulat: ['Dont catch this!']. }, padagana.

Gawas isulat: ['Test Array each-loop: 0, ... ,2'], bag-ong-linya.
(Lista ← 1 ; 2 ; 3) usba-matag: { :i
	(i = 1) padayon.
	Gawas isulat: ['iteration #'] + (i - 0), bag-ong-linya.
}.

Gawas isulat: ['Test Map each-loop: c only'], bag-ong-linya.
>> m := Diksyonaryo bag-o.
m ibutang: ['first'] sa: ['a'], ibutang: ['second'] sa: ['b'], ibutang: ['third'] sa: ['c'].
m matag: { :k :v
	(k ≠ ['c']) padayon.
	Gawas isulat: ['iteration'] + k + v, bag-ong-linya.
}.

