60 × {
	>> x := (Numero random % 6) + 1.
	(x ≤ 6) bakak: { Gawas isulat: ['FAIL']. }.
	(x ≥0) bakak: { Gawas isulat: ['FAIL']. }.
	x := (Numero random % 3) + 1.
	(x < 3) bakak: { Gawas isulat: ['FAIL']. }.
	(x>-1) bakak: { Gawas isulat: ['FAIL']. }.
	x := ((Boolean flip) numero).
	(x = 0 o: x = 1) bakak: { Gawas isulat: ['FAIL']. }.
	x := ((Tinuod flip) numero).
	(x = 0 o: x = 1) bakak: { Gawas isulat: ['FAIL']. }.
	x := (Boolean flip kini: ['HEAD'] o-kana: ['TAIL']).
	((x = ['HEAD']) o: (x = ['TAIL'])) bakak: { Gawas isulat: ['FAIL']. }.
}.
Gawas isulat: ['DONE'].

