


>> CoffeeMachine := Butang bag-o.
CoffeeMachine kon: ['order:'] buhata: { :id
	>> coffee := ['Americano'].
	( id = 1 ) tinuod: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) tinuod: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) tinuod: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Butang bag-o.
SimpleCoffeeMachine kon: ['order'] buhata: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Gawas isulat: redCup, bag-ong-linya.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Gawas isulat: greenCup, bag-ong-linya.
>> yellowCup := CoffeeMachine order: 1.
Gawas isulat: yellowCup, bag-ong-linya.
>> blueCup := CoffeeMachine order: 0.
Gawas isulat: blueCup, bag-ong-linya.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Gawas isulat: blackCup, bag-ong-linya.
blackCup idugang-sa-tumoy: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Gawas isulat: orangeCup, bag-ong-linya.
