

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa pagdumala-sa-panumduman: 0.

Numero kon: ['addNum:'] buhata: { :x
	kaugalingon idugang: x.
}.

Numero kon: ['subtractNum:'] buhata: { :x
	kaugalingon kuhai: x.
}.

Numero kon: ['multiplyBy:'] buhata: { :x
	kaugalingon padaghana-sa: x.
}.

Numero kon: ['divideBy:'] buhata: { :x
	kaugalingon bahinon-sa: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 gipataas-sa: 8).  
a := a + (2 gipataas-sa: -1). 
a := a + (49 gamot-kwadrado).   
a addNum: ((Lista ← 0 ; 1) kinadak-an).          
a addNum: ((Lista ← 2 ; 3) kinagamyan).
Gawas isulat: a.

Programa limpyohi.

usedMemory1 := (Programa panumduman ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 gipataas-sa: 8).  
a := a + (2 gipataas-sa: -1). 
a := a + (49 gamot-kwadrado).   
a addNum: ((Lista ← 0 ; 1) kinadak-an).          
a addNum: ((Lista ← 2 ; 3) kinagamyan).
Gawas isulat: a.

Programa limpyohi.
usedMemory2 := (Programa panumduman ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 gipataas-sa: 8).  
a := a + (2 gipataas-sa: -1). 
a := a + (49 gamot-kwadrado).   
a addNum: ((Lista ← 0 ; 1) kinadak-an).          
a addNum: ((Lista ← 2 ; 3) kinagamyan).
Gawas isulat: a.

Programa limpyohi.
usedMemory3 := (Programa panumduman ? 0).



( usedMemory1 = usedMemory2 ug: usedMemory1 = usedMemory3, ug: usedMemory2 = usedMemory3 ) tinuod: {
	Gawas isulat: ['No memory leaks here'].
}, bakak: {
	Gawas isulat: ['Leaking memory...'].
}.
