# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> dalan-sa-payl := ['/tmp/dat.csv'].
>> csv := Payl bag-o: dalan-sa-payl.
csv isulat: s.

# accepts CRLF LF CR, varying row length
csv tigbulag: [';'] kutlo: ['"'] mga-linya: { :line
	Programa limpyohi.
	Gawas isulat: line, bag-ong-linya.
	Programa limpyohi.
}.

# unequal lines
s idugang-sa-tumoy: ['\njustone'].
csv isulat: s.
{
	csv tigbulag: [';'] kutlo: ['"'] mga-linya: { :line
		Gawas isulat: line, bag-ong-linya.
	}.
} dakpon: { :e 
	Gawas isulat: e, bag-ong-linya.
}, padagana.

# invalid format
s := ['"he"llo";world'].
csv isulat: s.
{
	csv tigbulag: [';'] kutlo: ['"'] mga-linya: { :line
		Gawas isulat: line, bag-ong-linya.
	}.
} dakpon: { :e 
	Gawas isulat: e, bag-ong-linya.
}, padagana.
