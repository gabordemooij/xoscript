>> x := [' hallo '].

>> y := x dagkong-titik.
Gawas isulat: x, bag-ong-linya.
Gawas isulat: (x pareho: y), bag-ong-linya.

>> y := x gagmayng-titik.
Gawas isulat: x, bag-ong-linya.
Gawas isulat: (x pareho: y), bag-ong-linya.

>> y := x putli.
Gawas isulat: x, bag-ong-linya.
Gawas isulat: (x pareho: y), bag-ong-linya.

>> y := x laktawi: 1.
Gawas isulat: x, bag-ong-linya.
Gawas isulat: (x pareho: y), bag-ong-linya.

>> y := x gikan-sa: 1 gitas-on: 2.
