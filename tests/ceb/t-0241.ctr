

Teksto kon: ['evaluate'] buhata: {
	>> kodigo := Payl bag-o: ['/tmp/eval.ctr'].
	kodigo isulat: (kaugalingon teksto + ['.']).
	Programa gamita: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Lista ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q teksto.
Gawas isulat: x, bag-ong-linya.
>> y := Wala.
(['y := '] + x ) evaluate.
Gawas isulat: y ? 0, bag-ong-linya.

q := Diksyonaryo ibutang: ['\[''] sa: ['\['quote\']'].
x := q teksto.
Gawas isulat: x, bag-ong-linya.
y := Wala.
(['y := '] + x ) evaluate.

>> q := (Diksyonaryo bag-o) ibutang:['\[''] sa:['\['quote\[''].
Gawas isulat: y ? ['\['quote\']'], bag-ong-linya.
