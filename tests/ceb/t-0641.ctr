# Test utf8 sanitizer
Server init.

>> utf8cases := Diksyonaryo bag-o
	# ASCII only
	ibutang: ( Lista bag-o ; 65 ; 65 ; 65 ; 65 ; 0 ) sa: ['AAAA'],
	# valid 2 byte sequence
	ibutang: ( Lista bag-o ; 194 ; 162 ; 0 ) sa: ['¢'],
	# Valid 3-byte UTF-8
    ibutang: ( Lista bag-o ; 226 ; 130 ; 172 ; 0 ) sa: ['€'],
	# Valid 4-byte UTF-8
    ibutang: ( Lista bag-o ; 240 ; 144 ; 141 ; 136 ; 0 ) sa: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    ibutang: ( Lista bag-o ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) sa: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    ibutang: ( Lista bag-o ; 65 ; 193 ; 129 ; 0 ) sa: ['A?'],
	# Invalid first byte (0xFF)
    ibutang: ( Lista bag-o ; 255 ; 0 ) sa: ['?'],
	# Incomplete multi-byte sequence at end
    ibutang: ( Lista bag-o ; 66 ; 226 ; 0 ) sa: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    ibutang: ( Lista bag-o ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) sa: ['A€?𐍈B'].
	 
utf8cases matag: { :key :value
	>> blob := Blob bag-o: value ihap, bytes: value.
	>> str := blob teksto.
	(str = key) tinuod: {
		Gawas isulat: ['OK'], bag-ong-linya.
	}, kon-dili: {
		Gawas isulat: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, bag-ong-linya.
	}.
	blob buhii.
}.
