# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB bag-o host: ['localhost'],
	ngalan-sa-user: ['xo'],
	password: ['pass123'],
	ngalan-sa-database: ['xobase'],
	sumpay.

>> parametro-sa-pagpangita := db pangutana: ['SELECT %% FROM'].
{ parametro-sa-pagpangita ipatuman. } dakpon: { :e
	Gawas isulat: ( e naglangkob: ['%%'] ), bag-ong-linya.
}, padagana.
