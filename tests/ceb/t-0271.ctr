
Programa pagdumala-sa-panumduman: 1.
Programa panumduman: 16000000.
>> tokens := ['{}↲.:,x() '].
{ :i
	>> kodigo := [''].
	>> x := Numero sa-taliwala: 1 ug: 10.
	{
		>> y := Numero sa-taliwala: 1 ug: (tokens gitas-on).
		kodigo idugang-sa-tumoy: (tokens titik: y).
	} × x.
	{ Punsyon bag-o: kodigo. } dakpon: { ['Empty']. }, padagana.

} × 10000.
Gawas isulat: ['OK'], bag-ong-linya.
