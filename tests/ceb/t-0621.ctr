>> phrases := Lista bag-o
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases matag: { :_ :phrase 
	>> e := Server base64-i-encode: phrase.
	>> d := Server base64-i-decode: e.
	Gawas isulat: (
		message kopyaha ~encoded: e, ~decoded: d
	), bag-ong-linya.
}.
