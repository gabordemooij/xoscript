Gawas isulat: ['Test object'], bag-ong-linya.
>> l := Lista bag-o ; 1 ; ( Lista bag-o ; (Gutlo bag-o: 1) ; (Int64 gikan-sa-teksto: ['321']) ; (Lista bag-o ; 3)).
Gawas isulat: l, bag-ong-linya.
>> old-lst-address := l prototipo adres-sa-panumduman.
l save-as: ['/tmp/a.bin'].
Gawas isulat: ['========== RELOADING SNAP:'], bag-ong-linya.
>> b := Butang load-from: ['/tmp/a.bin'].
(b prototipo adres-sa-panumduman = old-lst-address) tinuod: {
	Gawas isulat: ['Object link re-attached.'], bag-ong-linya.
}.
Gawas isulat: b, bag-ong-linya.
