
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> kodigo := {
	>> o := (
		Diksyonaryo bag-o
		aa: (Lista ← 1 ; 2),
		bb: (Lista ← 3 ; 4)
	).
	>> s := o teksto.
	>> o2 := s butang.
	(s  matang = Teksto matang) tinuod: { Gawas isulat: ['OK1'], bag-ong-linya. }.
	(o2 matang = Diksyonaryo matang) tinuod: { Gawas isulat: ['OK2'], bag-ong-linya. }.
}.

Programa pagdumala-sa-panumduman: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Programa limpyohi.
usedMemory1 := (Programa panumduman ? 1).
kodigo padagana.
Programa limpyohi.
usedMemory2 := (Programa panumduman ? 1).
kodigo padagana.
Programa limpyohi.
usedMemory3 := (Programa panumduman ? 1).
kodigo padagana.
Programa limpyohi.
usedMemory4 := (Programa panumduman ? 1).

(usedMemory2 = usedMemory3 = usedMemory4) tinuod: { Gawas isulat: ['OK3'], bag-ong-linya. }.
 
