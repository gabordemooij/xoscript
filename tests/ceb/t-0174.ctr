


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa pagdumala-sa-panumduman: 0.
>> palette := Wala.
>> colors := Wala.

{
palette := Diksyonaryo bag-o.
palette 
	ibutang: ['#F00'] sa: ['red'],
	ibutang: ['#0F0'] sa: ['green'],
	ibutang: ['#00F'] sa: ['blue'].
Gawas isulat: ['number of RGB codes in palette: '] + ( palette ihap ), bag-ong-linya.
Gawas isulat: ['RGB code of green is: '] + ( palette ? ['green'] ), bag-ong-linya.
colors := [''].
( palette matag: { :ngalan :kodigo
		colors := colors + ( ngalan + [':'] + kodigo ).
} ).
Gawas isulat: ['All colors in palette: '] + colors, bag-ong-linya.
} padagana.
Programa limpyohi.
usedMemory1 := (Programa panumduman ? 0).

