Programa pagdumala-sa-panumduman: 4.

>> Doubler := Butang bag-o.
>> Multiplier := Butang bag-o.
Doubler kon: ['double:and:'] buhata: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier kon: ['multiply:and:'] buhata: { :x :y <- (x × y).
}.

Gawas isulat: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), bag-ong-linya.
