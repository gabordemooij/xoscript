# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Kaha 
	hash-sa-password: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Kaha 
	hash-sa-password: hash pamatud-i: a1.
	# fail 
>> b := Kaha
	hash-sa-password: hash pamatud-i: a2.
	# ok!

Gawas isulat: a, bag-ong-linya.
Gawas isulat: b, bag-ong-linya.

