Server init.
Gawas isulat: ['Database time test'], bag-ong-linya.

>> db := Maria-DB bag-o host: ['localhost'],
	ngalan-sa-user: ['xo'], 
	password: ['pass123'],
	ngalan-sa-database: ['xobase'],
	sumpay.

>> parametro-sa-pagpangita :=
db pangutana: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
kuhaa: { :row
	Gawas isulat: row timetest, bag-ong-linya.
}.
