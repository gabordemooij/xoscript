#Linux
>> clock := Gutlo bag-o.
clock sona: ['UTC-1'].
clock tuig: 1981, bulan: 1, adlaw: 5,
      oras: 13, minuto: 15, segundo: 13.

Gawas isulat: clock, bag-ong-linya.
clock sona: ['UTC+0'].

Gawas isulat: (
	(clock tuig yano) + ['-'] + (clock bulan) + ['-'] + (clock adlaw) + [' '] +
	(clock oras) + [':'] + (clock minuto) + [':'] + (clock segundo) + [' '] +
	['W'] + (clock semana) + (clock sona)
), bag-ong-linya.


clock sona: ['UTC-1'].
Gawas isulat: (
	(clock tuig yano) + ['-'] + (clock bulan) + ['-'] + (clock adlaw) + [' '] +
	(clock oras) + [':'] + (clock minuto) + [':'] + (clock segundo) + [' '] +
	['W'] + (clock semana) + (clock sona)
), bag-ong-linya.
