
Server init.
>> rq := Hangyo-HTTP bag-o.
Gawas isulat: ['HTTP-GET d[]=']  + ( rq get-lista: ['d[]'] ), bag-ong-linya. # GET
Gawas isulat: ['HTTP-GET f[]=']  + ( rq get-lista: ['f[]'] ), bag-ong-linya. # GET
Gawas isulat: ['HTTP-POST e[]='] + ( rq post-lista: ['e[]'] ), bag-ong-linya. # GET
Gawas isulat: ['HTTP-POST c=']   + ( rq post: ['c'] ), bag-ong-linya. # GET
Gawas isulat: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), bag-ong-linya. # GET
