Gawas isulat: ((Lista bag-o
	kon: ['plaque:'] buhata: { :x akoa o := x. },
	kon: ['plaque']  buhata: { <- akoa o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Lista ← 1)
	~ (Lista ← 1 ; 2)
	~ (Lista ← 1 ; 2 ; 3)
	~ (Lista ← 1 ; 2 ; 3 ; 4)
	~ (Lista ← 1 ; 2 ; 3 ; 4 ; 5)
) matag: { :i :el
	{ Gawas isulat: kining-buluhaton. } × el ihap.
	Gawas bag-ong-linya.
}) plaque, bag-ong-linya.


