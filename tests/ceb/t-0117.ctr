>> t := Tinuod.
(t = Tinuod) tinuod: { Gawas isulat: ['T']. }.
(t = Bakak) tinuod: { Gawas isulat: ['F']. }.
Gawas isulat: ['|'].
>> t := Bakak.
(t = Tinuod) tinuod: { Gawas isulat: ['T']. }.
(t = Bakak) tinuod: { Gawas isulat: ['F']. }.
Gawas isulat: ['|'].
>> f := Tinuod.
(t = Tinuod ug: f = Bakak) tinuod: { Gawas isulat: ['T']. }.
(t = Bakak ug: f = Tinuod) tinuod: { Gawas isulat: ['F']. }.
Gawas isulat: ['|'].
>> n := Wala.
(n Wala?) tinuod: { Gawas isulat: ['T']. }.
(n Wala?) bakak: { Gawas isulat: ['F']. }.
Gawas isulat: ['|'].
(f Boolean?) tinuod: { Gawas isulat: ['T']. }.
(f Boolean?) bakak: { Gawas isulat: ['F']. }.



