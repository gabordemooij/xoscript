>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Butang bag-o.
⚄ kon: ['drawFrom:length:'] buhata: { :pool :ihap
	
	>> result := [''].
	
	{
		>> index := Numero random % (pool gitas-on).
		result idugang-sa-tumoy: ( pool titik: (index + 1) ).
		
	} × ihap. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? gitas-on.
Gawas isulat: (['x↵'] x random gitas-on).
Gawas isulat: (['y↵'] y ?? gitas-on).

