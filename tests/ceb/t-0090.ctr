Gawas isulat: ['1,2,3,4,5,6,7,8,9,A,'], bag-ong-linya.
>> Scope := Butang bag-o.
Scope kon: ['initialize:'] buhata: { :x akoa property := x. }.
Scope kon: ['confirm'] buhata: { Gawas isulat: [',']. }.
Scope kon: ['sulay'] buhata: {
	Gawas isulat: akoa property.
	kaugalingon confirm.
	( 1 = 1 ) tinuod: { Gawas isulat: akoa property. kaugalingon confirm. }.
	( 1 = 0 ) bakak: { Gawas isulat: akoa property. kaugalingon confirm. }.
	>> y := 2. { Gawas isulat: akoa property. kaugalingon confirm. } samtang: { y kuhai: 1. <- (y > 0). }.
	{ Gawas isulat: akoa property. kaugalingon confirm. } × 1.
	(Lista ← 1) matag: {  Gawas isulat: akoa property. kaugalingon confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Diksyonaryo bag-o one: ['item']) matag: { Gawas isulat: akoa property. kaugalingon confirm. }.
	{ 1 ÷ 0. } dakpon: { Gawas isulat: akoa property. kaugalingon confirm. }, padagana.
	Gawas bag-ong-linya.
}.
>> scope1 := Scope bag-o.
scope1 initialize: ['X'].
scope1 sulay.
>> function := { 
	akoa property := ['Y'].
	Gawas isulat: akoa property.
	kaugalingon confirm.
	( 1 = 1 ) tinuod: { Gawas isulat: akoa property. kaugalingon confirm. }.
	( 1 = 0 ) bakak: { Gawas isulat: akoa property. kaugalingon confirm. }.
	>> y := 2. { Gawas isulat: akoa property. kaugalingon confirm. } samtang: { y kuhai: 1. <- (y > 0). }.
	{ Gawas isulat: akoa property. kaugalingon confirm. } × 1.
	(Lista ← 1) matag: {  Gawas isulat: akoa property. kaugalingon confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Diksyonaryo bag-o one: ['item']) matag: { Gawas isulat: akoa property. kaugalingon confirm. }.
	{ 1 ÷ 0. } dakpon: { Gawas isulat: akoa property. kaugalingon confirm. }, padagana.
	Gawas bag-ong-linya.
}.
function kon: ['confirm'] buhata: { Gawas isulat: [',']. }.
function ipadapat: 1 ug: 2.
