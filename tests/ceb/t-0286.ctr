['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Gawas isulat: (x + y), bag-ong-linya.

>> x := 10040.07.
>> y := 10305.60.

Gawas isulat: (x + y), bag-ong-linya.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Gawas isulat: (x + y + z), bag-ong-linya.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Gawas isulat: (x + y + z), bag-ong-linya.

>> q := 0.1.2.

Gawas isulat: (q), bag-ong-linya.

>> q := 012.

Gawas isulat: (q), bag-ong-linya.
