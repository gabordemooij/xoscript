>> HTML := Butang bag-o.
HTML kon: ['tubag:'] buhata: { :tag 
	Gawas isulat: (['<tag>'] tag: tag), bag-ong-linya.
}.
HTML kon: ['tubag:ug:'] buhata: { :tag :html 
	Gawas isulat: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), bag-ong-linya.
}.
>> html := HTML bag-o.
html body h1: ['header'].

