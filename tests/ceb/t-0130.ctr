# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Programa kahikayan: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server isumpay: ( Lista bag-o ;
 libname ; ['fopen'] ;
 ( Lista bag-o ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
isumpay: ( Lista bag-o ;
 Wala ; # means same lib
 ['fread'] ;
 ( Lista bag-o ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Wala ; # means same object (i.e. Stream)
 ['fread']
),
isumpay: (
 Lista bag-o ;
 Wala ; # means same lib
 ['fwrite'] ;
 ( Lista bag-o ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Wala ; # means same lib
 ['fwrite']
),
isumpay: (
 Lista bag-o ;
 Wala ; # means same lib
 ['rewind'] ;
 ( Lista bag-o ; ['pointer'] ) ;
 ['int'] ;
 Wala ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> dalan-sa-payl := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: dalan-sa-payl mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream mensahe: ['fwrite'] argumento: (Lista bag-o ; str ; 1 ; 6 ; fd ).
Gawas isulat: bytes-written, bag-ong-linya.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob bag-o: 20.

# read from file
>> bytes-read := Stream mensahe: ['fread'] argumento: (Lista bag-o ; buf ; 1 ; 6 ; fd ).
Gawas isulat: bytes-read, bag-ong-linya.
Gawas isulat: buf, bag-ong-linya.

# free memory
str  buhii.
dalan-sa-payl buhii.
mode buhii.
buf  buhii.


