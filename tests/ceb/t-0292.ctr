>> winery := { <- (	Diksyonaryo bag-o
		ibutang: 2 sa: ['merlot'],
		ibutang: 3 sa: ['malbec'],
		ibutang: 4 sa: ['syrah']
	).
}.

Gawas isulat: (((winery padagana) - ['nothing']) ihap), bag-ong-linya.
Gawas isulat: (((winery padagana) - ['merlot']) ihap), bag-ong-linya.
Gawas isulat: (((winery padagana) - ['malbec']) ihap), bag-ong-linya.
Gawas isulat: (((winery padagana) - ['syrah']) ihap), bag-ong-linya.
Gawas isulat: (((winery padagana) - ['merlot'] - ['malbec']) ihap), bag-ong-linya.
Gawas isulat: (((winery padagana) - ['merlot'] - ['syrah']) ihap), bag-ong-linya.
Gawas isulat: (((winery padagana) - ['malbec'] -['syrah']) ihap), bag-ong-linya.
Gawas isulat: (((winery padagana) - ['malbec'] - ['syrah'] - ['merlot']) ihap), bag-ong-linya.

