usedMemory2 := (Programa panumduman ? 0).


{ :i Gawas isulat: i. } × 4.
Gawas bag-ong-linya.
{ :i Gawas isulat: (4 - i). } × 4.
Gawas bag-ong-linya.
( 1 > 2 ) bakak: { Gawas isulat: ['BLOCK 1'], bag-ong-linya. }.
( 2 > 1 ) tinuod:  { Gawas isulat: ['BLOCK 2'], bag-ong-linya. }.

>> i := 0.
{ Gawas isulat: i. i idugang: 1. } samtang: { <- ( i < 3). }.
Gawas bag-ong-linya.

i := 3.
{ Gawas isulat: i. i := i - 1. } samtang: { <- ( i > 0). }.
Gawas bag-ong-linya.

Programa limpyohi.
usedMemory3 := (Programa panumduman ? 0).



( usedMemory1 = usedMemory2 ug: usedMemory1 = usedMemory3, ug: usedMemory2 = usedMemory3 ) tinuod: {
	Gawas isulat: ['No memory leaks here'].
}, bakak: {
	Gawas isulat: ['Leaking memory...'].
}.
