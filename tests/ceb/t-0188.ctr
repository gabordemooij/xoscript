

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa pagdumala-sa-panumduman: 0.

{ :i Gawas isulat: i. } × 4.
Gawas bag-ong-linya.
{ :i Gawas isulat: (4 - i). } × 4.
Gawas bag-ong-linya.
( 1 > 2 ) bakak: { Gawas isulat: ['BLOCK 1'], bag-ong-linya. }.
( 2 > 1 ) tinuod:  { Gawas isulat: ['BLOCK 2'], bag-ong-linya. }.

>> i := 0.
{ Gawas isulat: i. i idugang: 1. } samtang: { <- ( i < 3). }.
Gawas bag-ong-linya.

i := 3.
{ Gawas isulat: i. i := i - 1. } samtang: { <- ( i > 0). }.
Gawas bag-ong-linya.


Programa limpyohi.

usedMemory1 := (Programa panumduman ? 0).


{ :i  Gawas isulat: i. } × 4.
Gawas bag-ong-linya.
{ :i  Gawas isulat: (4 - i). } × 4.
Gawas bag-ong-linya.
( 1 > 2 ) bakak: { Gawas isulat: ['BLOCK 1'], bag-ong-linya. }.
( 2 > 1 ) tinuod:  { Gawas isulat: ['BLOCK 2'], bag-ong-linya. }.

>> i := 0.
