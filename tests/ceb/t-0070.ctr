>> numbers := ['1,2,3'] bahina: [','].
Gawas isulat: ['I got: '] + numbers ihap + [' numbers.'],bag-ong-linya.
{ :i Gawas isulat: ['number #'] + i + [':'] + (numbers posisyon: i), bag-ong-linya.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages bahina: [' Or '].
Gawas isulat: ['We serve'], bag-ong-linya.
{ :i Gawas isulat: ['->'] + (beverages posisyon: i), bag-ong-linya. } × (beverages ihap).
Gawas isulat: (beverages hiusaha: [',']), bag-ong-linya.
Gawas isulat: (numbers hiusaha: ['||']).
