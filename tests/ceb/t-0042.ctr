>> items := Diksyonaryo bag-o.
items ibutang: ['black'] sa: ['coffee'], ibutang: ['earl grey'] sa: ['tea'].
Gawas isulat: (items sa: ['coffee']), isulat: (items sa: ['tea']).
Gawas isulat: ['there are'] + items ihap + [' items in the array.'].
items ibutang: ['capuccino'] sa: ['coffee'].
Gawas isulat: ['Now my coffee is.. '] + (items sa: ['coffee']).
items ibutang: ['aaa'] sa: ['1'].
items ibutang: ['bbb'] sa: ['2'].
Gawas isulat: (items sa: ['a']).
