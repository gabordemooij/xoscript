Server init.
>> fmt := Porma bag-o: ['%#3x'].

>> blob := Blob bag-o: 4.
blob bytes: ( 
	Lista bag-o ; 0 ; 1 ; 2 ; 3
).

>> file := Payl bag-o: ['/tmp/blob'].
file blob: blob.
blob buhii.

>> basaha := file blob.
basaha 
gikan-sa: 0 
gitas-on: 4, 
buhata matag: { :i :b 
	Gawas
	isulat: (fmt ipadapat-tibuok-numero: b),
	bag-ong-linya.
}.
basaha buhii.
