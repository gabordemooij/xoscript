
Gawas isulat: ['Break for-loop, 0-4.'], bag-ong-linya.
{ :i
	Gawas isulat: ['iteration #'] + i, bag-ong-linya.
	(i = 4) hunonga.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Gawas isulat: ['Break while-true loop, 0-4.'], bag-ong-linya.
{
	Gawas isulat: ['iteration #'] + x, bag-ong-linya.
	x idugang: 1.
	((x < 5) dili) hunonga.
} samtang: xIsLessThan10.

Gawas isulat: ['Break while-false loop, 5,4.'], bag-ong-linya.
{
	Gawas isulat: ['iteration #'] + x, bag-ong-linya.
	x kuhai: 1.
	(x = 3) hunonga.
} samtang: { <- (x > 0). }.

Gawas isulat: ['Break times loop, 1-4.'], bag-ong-linya.
{ :i
	Gawas isulat: ['iteration #'] + i, bag-ong-linya.
	(i = 4) hunonga.
} × 5.

Gawas isulat: ['Break block, dont print line.'], bag-ong-linya.
{ Tinuod hunonga. Gawas isulat: ['dont write this!'], bag-ong-linya. } padagana.

Gawas isulat: ['Break block, dont fire catch...'], bag-ong-linya.
{ Tinuod hunonga. Gawas isulat: ['dont write this!'], bag-ong-linya. } dakpon: { Gawas isulat: ['Dont catch this!']. }, padagana.

Gawas isulat: ['Test Array each-loop: 0,1'], bag-ong-linya.
(Lista ← 1 ; 2 ; 3) usba-matag: { :i
	Gawas isulat: ['iteration #'] + i, bag-ong-linya.
	(i = 1) hunonga.
}.

Gawas isulat: ['Test Map each-loop: c only'], bag-ong-linya.
>> m := Diksyonaryo bag-o.
m ibutang: ['first'] sa: ['a'], ibutang: ['second'] sa: ['b'], ibutang: ['third'] sa: ['c'].
m matag: { :k :v
	Gawas isulat: ['iteration'] + v + k, bag-ong-linya.
	Tinuod hunonga.
}.

