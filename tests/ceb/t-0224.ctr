
>> countries := Lista bag-o
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Lista bag-o
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods sumala-sa: countries, matag: { :key :value
	counter idugang: 1.
}.

Gawas isulat: (['we serve counter dishes'] counter: counter), bag-ong-linya.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] mga-titik han-aya: { :v
	counter idugang: 0.
}.

Gawas isulat: (['we sort counter dishes'] counter: counter), bag-ong-linya.


>> counter := 0.
{
	{
		counter idugang: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Gawas isulat: (['we calculate counter numbers.'] counter: counter), bag-ong-linya.

