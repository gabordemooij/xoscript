Gawas isulat: ['Test object'], bag-ong-linya.
>> a := Butang bag-o. 

a kon: ['item:'] buhata: { :octhelper
	akoa octhelper := octhelper. 
}.

a kon: ['item'] buhata: { <- akoa octhelper.
}.

a item: Oct bag-o.

>> old-octhelper-address := a item prototipo adres-sa-panumduman.
a save-as: ['/tmp/a.bin'].
Gawas isulat: ['========== RELOADING SNAP:'], bag-ong-linya.

>> b := Butang load-from: ['/tmp/a.bin'].

(b item prototipo adres-sa-panumduman = old-octhelper-address) tinuod: {
	Gawas isulat: ['Object link re-attached.'], bag-ong-linya.
}.
