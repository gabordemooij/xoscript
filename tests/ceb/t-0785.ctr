Gawas isulat: ['Test object'], bag-ong-linya.
>> a := Butang bag-o. 

a kon: ['item:'] buhata: { :moment
	akoa moment := moment. 
}.

a kon: ['item'] buhata: { <- akoa moment.
}.

>> today := Lista bag-o ; ( Gutlo bag-o sona: ['CEST'], tuig: 2026, bulan: 7 ).
a item: today.
Gawas isulat: a item ? 0, bag-ong-linya.
a save-as: ['/tmp/a.bin'].
