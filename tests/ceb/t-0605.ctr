>> invoice := Butang bag-o.
invoice kon: ['padagana'] buhata: {
        akoa numero := 0.
}.

invoice kon: ['numero'] buhata: {
        akoa numero idugang: 1. <- akoa numero kopyaha.
}.

>> year-invoice := invoice bag-o.
year-invoice kon: ['start:'] buhata: { :tuig
	akoa numero := tuig.
}.

year-invoice start: 202000.
Gawas isulat: year-invoice numero, bag-ong-linya.
Gawas isulat: year-invoice numero, bag-ong-linya.
