wine kon: ['='] buhata: { :other wine <- ( kaugalingon toString = other wine ).
}.

wine kon: ['=='] buhata: { :other wine <- ( kaugalingon toString = other wine ).
}.



wine
	kaso: ['cabernet'] buhata: { Gawas isulat: ['it's a Cabernet!']. },
	kaso: ['syrah']    buhata: { Gawas isulat: ['it's a Syrah!'].    },
	kaso: ['merlot']   buhata: { Gawas isulat: ['it's a Merlot!'].   },
	kaso: ['malbec']   buhata: { Gawas isulat: ['it's a Malbec!'].   }.

