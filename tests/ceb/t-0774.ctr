Gawas isulat: ['Test object'], bag-ong-linya.
>> a := Butang bag-o. 
a kon: ['item:'] buhata: { :lst
	akoa lst := lst. 
}.
a kon: ['item'] buhata: { <- akoa lst.
}.
a item: (
	Lista bag-o ; 1 ; (
		Lista bag-o ; ['a'] ; (
			Lista bag-o ; ( Gutlo bag-o: 1 )
		) ; ( Int64 gikan-sa-teksto: ['321'] )
	)
).
Gawas isulat: a item, bag-ong-linya.
>> old-lst-address := a item prototipo adres-sa-panumduman.
a save-as: ['/tmp/a.bin'].
Gawas isulat: ['========== RELOADING SNAP:'], bag-ong-linya.
>> b := Butang load-from: ['/tmp/a.bin'].
(b item prototipo adres-sa-panumduman = old-lst-address) tinuod: {
	Gawas isulat: ['Object link re-attached.'], bag-ong-linya.
}.
Gawas isulat: ( b item ), bag-ong-linya.
