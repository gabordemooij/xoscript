# test qualifiers

Programa limpyohi.

>> Fruit := Butang bag-o.
Fruit kon: ['bag-o'] buhata: {
	>> f := kaugalingon bag-o.
	f apples: 0. <- f.
}.
Fruit kon: ['apples:'] buhata: { :a akoa apples := a. }.
Fruit kon: ['apples'] buhata: { <- akoa apples. }.
Fruit kon: ['+'] buhata: { :f
	>> n := Fruit bag-o.
	n apples: (f apples + akoa apples). <- n.
}.
Numero kon: ['apples'] buhata: { <- ((Fruit bag-o) apples: kaugalingon).
}.

Fruit kon: ['teksto'] buhata: { <- akoa apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Gawas isulat: q, bag-ong-linya.




q := 3 apples + 4 apples.
Gawas isulat: q, bag-ong-linya.



q := 3 apples + 4 apples.
Gawas isulat: q, bag-ong-linya.


