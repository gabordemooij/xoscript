#OBSD
>> dirname := [''].
{ dirname idugang-sa-tumoy: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Programa sistema: command.
Programa chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename idugang-sa-tumoy: ['YYYYYYYY']. } * 20.
Payl bag-o: filename, isulat: ['sometext'].
{ Payl lista: ['/tmp/'] + dirname. } * 1000.
Gawas isulat: ['no crash'], bag-ong-linya.

