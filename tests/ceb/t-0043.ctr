>> repeater := Butang bag-o.
repeater kon: ['tubag:'] buhata: { :what
	Gawas isulat: what + [' '].
}.
repeater kon: ['tubag:ug:'] buhata: { :what :say
	Gawas isulat: what, isulat: say + [' '].
}.
repeater kon: ['tubag:ug:ug:'] buhata: { :what :say :more
	Gawas isulat: what, isulat: say, isulat: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
