Gawas isulat: ['Test object'], bag-ong-linya.
>> a := Butang bag-o. 

a kon: ['item:'] buhata: { :dict
	akoa dict := dict. 
}.

a kon: ['item'] buhata: { <- akoa dict.
}.

a item: (
Diksyonaryo bag-o
	hello: ['world'],
	world: (Diksyonaryo bag-o ibutang: ['a'] sa: ['b'])).

Gawas isulat: a item, bag-ong-linya.

>> old-dict-address := a item prototipo adres-sa-panumduman.
a save-as: ['/tmp/a.bin'].
Gawas isulat: ['========== RELOADING SNAP:'], bag-ong-linya.

>> b := Butang load-from: ['/tmp/a.bin'].

(b item prototipo adres-sa-panumduman = old-dict-address) tinuod: {
	Gawas isulat: ['Object link re-attached.'], bag-ong-linya.
}.

Gawas isulat: b item, bag-ong-linya.
