Server init.

# write a test file
>> f := Payl bag-o: ['/tmp/test.gif'].
f isulat: ['GIF87a01234567810'].

# serve the file
Server ipasa: ['test.gif'] unlapi: ['/tmp/'].

Gawas bag-ong-linya.

Gawas isulat: ['Outside container (security):'], bag-ong-linya.
{ Server ipasa: ['../passwd'] unlapi: ['/tmp/']. }
dakpon: { :e Gawas isulat: e, bag-ong-linya. },
padagana.

Gawas isulat: ['Invalid prefix:'], bag-ong-linya.
{ Server ipasa: ['test.gif'] unlapi: ['z:\\']. }
dakpon: { :e Gawas isulat: e, bag-ong-linya. },
padagana.

Gawas isulat: ['Non-existant file:'], bag-ong-linya.
{ Server ipasa: ['xxx.xxx'] unlapi: ['/tmp/']. }
dakpon: { :e Gawas isulat: e, bag-ong-linya. },
padagana.
