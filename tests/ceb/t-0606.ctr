>> Point := Butang bag-o.
Point kon: ['x-coordinate:'] buhata: { :x akoa x := x. }.
Point kon: ['y-coordinate:'] buhata: { :y akoa y := y. }.
Point kon: ['x-coordinate']  buhata: { <- akoa x kopyaha. }.
Point kon: ['y-coordinate']  buhata: { <- akoa y kopyaha. }.

Point kon: ['='] buhata: { :other <- ( akoa x = other x-coordinate
		 ug: akoa y = other y-coordinate ).
}.

>> pier := Point bag-o x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point bag-o x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point bag-o x-coordinate: 5, y-coordinate: 6.

Gawas isulat: pier = town-hall, bag-ong-linya.
Gawas isulat: pier = restaurant, bag-ong-linya.
