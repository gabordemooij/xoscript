>> Animal := Butang bag-o.
Animal kon: ['make'] buhata: {
	>> animal := Butang bag-o.
	animal kon: ['makeSound'] buhata: {
		Gawas isulat: akoa sound.
	}. <- animal.
}.
>> Cat := Butang bag-o.
Cat kon: ['make'] buhata: {
	>> cat := Animal make.
	cat kon: ['init'] buhata: {
		akoa sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
