
>> city := Lista ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Lista ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature sumala-sa: city.
>> cities := weather mga-yawe han-aya: { :a :b <- (a itandi: b). }.
>> temperatures := weather mga-bili han-aya: { :a :b <- (a itandi: b) negatibo?. }.

Gawas isulat: (cities hiusaha: [',']), bag-ong-linya.
Gawas isulat: (temperatures hiusaha: [',']), bag-ong-linya.
