Numero kon: ['factorial'] buhata: {
	>> total := 1.
	{ :index total padaghana-sa: (kaugalingon - index). } × kaugalingon. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa pagdumala-sa-panumduman: 0.

{
2 exponent factorial.
Gawas isulat: (11 sobra: 3), bag-ong-linya.
Gawas isulat: (3.4 lingina), bag-ong-linya.
Gawas isulat: (7.1 lingina-pataas), bag-ong-linya.
Gawas isulat: (7.9 lingina-paubos), bag-ong-linya.
}
padagana.

Programa limpyohi.

usedMemory1 := (Programa panumduman ? 0).

{
2 exponent factorial.
Gawas isulat: (11 sobra: 3), bag-ong-linya.
Gawas isulat: (3.4 lingina), bag-ong-linya.
Gawas isulat: (7.1 lingina-pataas), bag-ong-linya.
Gawas isulat: (7.9 lingina-paubos), bag-ong-linya.
}
padagana.

Programa limpyohi.
usedMemory2 := (Programa panumduman ? 0).


{
2 exponent factorial.
Gawas isulat: (11 sobra: 3), bag-ong-linya.
Gawas isulat: (3.4 lingina), bag-ong-linya.
Gawas isulat: (7.1 lingina-pataas), bag-ong-linya.
Gawas isulat: (7.9 lingina-paubos), bag-ong-linya.
} padagana.

Programa limpyohi.
usedMemory3 := (Programa panumduman ? 0).



( usedMemory1 = usedMemory2 ug: usedMemory1 = usedMemory3, ug: usedMemory2 = usedMemory3 ) tinuod: {
	Gawas isulat: ['No memory leaks here'].
}, bakak: {
	Gawas isulat: ['Leaking memory...'].
}.
