
Server init.
Gawas isulat: ['Database test'], bag-ong-linya.

>> db := Maria-DB bag-o host: ['localhost'],
	ngalan-sa-user: ['xo'], 
	password: ['pass123'],
	ngalan-sa-database: ['xobase'],
	sumpay.

>> parametro-sa-pagpangita :=
db pangutana: ['SELECT REPEAT('Blah',1000) AS blah'], 
kuhaa: { :row 
