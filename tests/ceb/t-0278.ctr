>> To-Do := Butang bag-o.

To-Do kon: ['bag-o'] buhata: {
	akoa list := Lista bag-o.
}.

To-Do kon: ['nieuw'] buhata: {
	akoa list := Lista bag-o.
}.

To-Do kon: ['+'] buhata: { :task
	akoa list idugang-sa-tumoy: task.
}.

To-Do kon: ['number of tasks?'] buhata: { <-  akoa list ihap.
}.

>> todos := 
	To-Do bag-o 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Gawas isulat: ['You have $ tasks to do'] $ todos number of tasks?.
