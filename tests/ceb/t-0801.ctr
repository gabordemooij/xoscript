Server init.

>> db := Maria-DB bag-o host: ['localhost'],
	ngalan-sa-user: ['xo'],
	password: ['pass123'],
	ngalan-sa-database: ['xobase'],
	sumpay.

>> del := db pangutana: ['DELETE FROM book WHERE id > 0'].
{  del ipatuman. db kumpirmaha. } dakpon: { :e db ibalik.  }, padagana.

>> ihap := db pangutana: ['SELECT COUNT(*) AS num FROM book'].
ihap kuhaa: { :row Gawas isulat: row num, bag-ong-linya. }.
