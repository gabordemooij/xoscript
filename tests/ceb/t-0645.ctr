Server init.
Gawas isulat: ['Database date test'], bag-ong-linya.

>> db := Maria-DB bag-o host: ['localhost'],
	ngalan-sa-user: ['xo'], 
	password: ['pass123'],
	ngalan-sa-database: ['xobase'],
	sumpay.

>> parametro-sa-pagpangita :=
db pangutana: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
kuhaa: { :row
	Gawas isulat: row datetest, bag-ong-linya.
}.
