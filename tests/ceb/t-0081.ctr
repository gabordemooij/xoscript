>> map1 := Diksyonaryo bag-o.
>> key1 := Lista bag-o.
>> key2 := Lista bag-o.

map1
	ibutang: ['hello'] sa: key1,
	ibutang: ['world'] sa: key2.


Gawas
	isulat: ['Map #1 contains: '] + (map1 sa: key1),
	isulat: [' and '] + (map1 sa: key2), bag-ong-linya.

>> KeyeableArray := Lista bag-o.
KeyeableArray kon: ['toString'] buhata: { <- (kaugalingon ihap) toString.
}.

>> map2 := Diksyonaryo bag-o.
key1 := KeyeableArray bag-o.
key2 := KeyeableArray bag-o.

key1 idugang-sa-tumoy: 1.

map2
	ibutang: ['hello'] sa: key1,
	ibutang: ['world'] sa: key2.

Gawas
	isulat: ['Map #2 contains: '] + (map2 sa: key1),
	isulat: [' and '] + (map2 sa: key2), bag-ong-linya.
