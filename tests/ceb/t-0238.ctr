Teksto kon: ['evaluate'] buhata: {
	>> kodigo := Payl bag-o: ['/tmp/eval.ctr'].
	kodigo isulat: (kaugalingon teksto + ['.']).
	Programa gamita: ['/tmp/eval.ctr'].
}.

>> a := Lista ← 1 ; 2 ; 3.
>> b := (a teksto).

Gawas isulat: b, bag-ong-linya. 
(['b := '] + b) evaluate.

Gawas isulat: b ? 2, bag-ong-linya. 

Gawas isulat: (( Lista ← 1 ; 2 ; 3 )), bag-ong-linya. 

Gawas isulat: ((Diksyonaryo bag-o) ibutang: 1 sa: 2), bag-ong-linya. 

>> x := ( (Lista ← 1 ; ( Lista ← 9 ) ; Tinuod ) ) teksto.
Gawas isulat: x, bag-ong-linya. 
(['x := '] + x) evaluate.

Gawas isulat: x ? 1 ? 0, bag-ong-linya. 

>> y := (Diksyonaryo bag-o) ibutang: (Lista ← 1) sa: (Lista ← 2).
Gawas isulat: y, bag-ong-linya. 

(['y := '] + y) teksto evaluate.

Gawas isulat: (y sa: (Lista ← 2) teksto ), bag-ong-linya.

Gawas isulat: (Lista bag-o), bag-ong-linya. 
Gawas isulat: (Diksyonaryo bag-o), bag-ong-linya. 
