

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa pagdumala-sa-panumduman: 0.

>> a := Lista ← ['hello'] ; ['world'] ; Tinuod ; Wala ; 666.
a buhata kuhaa-ang-ulahi kuhaa-ang-una idugang-sa-sinugdan: ['hi'], idugang-sa-tumoy: 999, human.
Gawas isulat: ( a hiusaha: [','] ), bag-ong-linya.

Programa limpyohi.
usedMemory1 := (Programa panumduman ? 0).


a := Lista ← ['hello'] ; ['world'] ; Tinuod ; Wala ; 666.
a kuhaa-ang-ulahi. a kuhaa-ang-una. a idugang-sa-sinugdan: ['hi'], idugang-sa-tumoy: 999.
Gawas isulat: ( a hiusaha: [','] ), bag-ong-linya.


Programa limpyohi.
usedMemory2 := (Programa panumduman ? 0).


a := Lista ← ['hello'] ; ['world'] ; Tinuod ; Wala ; 666.
a buhata kuhaa-ang-ulahi kuhaa-ang-una idugang-sa-sinugdan: ['hi'], idugang-sa-tumoy: 999, human.
