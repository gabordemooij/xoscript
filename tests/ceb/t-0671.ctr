# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Kaha paghimo-ug-yawe.

# private (secret) key
>> sk := keys una.

# public key
>> pk := keys katapusan.

# sign a message
>> sig := Kaha pirmahi: ['abc'] gamit: sk.

# check message (ok)
Gawas isulat: ( 
	Kaha
		susiha: ['abc'] 
		pirma: sig 
		gamit: pk 
), bag-ong-linya.

# check message (fail)
Gawas isulat: ( 
	Kaha 
		susiha: ['abd'] 
		pirma: sig 
		gamit: pk 
), bag-ong-linya.