>> a := 3.
>> b := a kopyaha.
a kuhai: 1.
Gawas isulat: [' a = '] + a.
Gawas isulat: [' b = '] + b.
a := 3.
b := a + 4.
Gawas isulat: [' a = '] + a.
Gawas isulat: [' b = '] + b.
>> x := 3.
>> y := x kopyaha.
x idugang: 10.
y kuhai: 1.
Gawas isulat: [' x = '] + x.
Gawas isulat: [' y = '] + y.
>> q := Butang bag-o.
q kon: ['setProperty:'] buhata: { :x
	akoa prop := x.
}.
q kon: ['getProperty'] buhata: { <- akoa prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Gawas isulat: [' p = '] + (p getProperty).
