

Lista kon: ['sum'] buhata: {
	>> total := 0.
	kaugalingon matag: { :index :element
		total idugang: element.
	}. <- total.
}.

Lista kon: ['product'] buhata: {
	>> total := 1.
	kaugalingon matag: { :index :element
		total padaghana-sa: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa pagdumala-sa-panumduman: 0.

{

>> a := Lista ← ['hello'] ; ['world'] ; Tinuod ; Wala ; 666.
a := a + ( Lista ← 1 ).
Gawas isulat: ( ['sum: '] + ( a sum ) ), bag-ong-linya.
Gawas isulat: ( ['min: '] + ( a kinagamyan ) ), bag-ong-linya.
Gawas isulat: ( ['max: '] + ( a kinadak-an ) ), bag-ong-linya.
Gawas isulat: ( ['3rd: '] + ( a ? 2 ) ), bag-ong-linya.
Gawas isulat: ( ['prd: '] + ( a product ) ), bag-ong-linya.
a han-aya: { :a :b <- (b - a). }.
a matag: { :i :e Gawas isulat: ( i - 0 ), bag-ong-linya. }.

} padagana.

Programa limpyohi.
usedMemory1 := (Programa panumduman ? 0).


{

>> a := Lista ← ['hello'] ; ['world'] ; Tinuod ; Wala ; 666.
a := a + ( Lista ← 1 ).
Gawas isulat: ( ['sum: '] + ( a sum ) ), bag-ong-linya.
Gawas isulat: ( ['min: '] + ( a kinagamyan ) ), bag-ong-linya.
Gawas isulat: ( ['max: '] + ( a kinadak-an ) ), bag-ong-linya.
Gawas isulat: ( ['3rd: '] + ( a ? 2 ) ), bag-ong-linya.
Gawas isulat: ( ['prd: '] + ( a product ) ), bag-ong-linya.
a han-aya: { :a :b <- (b - a). }.
a matag: { :i :e Gawas isulat: ( i - 0 ), bag-ong-linya. }.

} padagana.



Programa limpyohi.
usedMemory2 := (Programa panumduman ? 0).


{

>> a := Lista ← ['hello'] ; ['world'] ; Tinuod ; Wala ; 666.
a := a + ( Lista ← 1 ).
Gawas isulat: ( ['sum: '] + ( a sum ) ), bag-ong-linya.
Gawas isulat: ( ['min: '] + ( a kinagamyan ) ), bag-ong-linya.
Gawas isulat: ( ['max: '] + ( a kinadak-an ) ), bag-ong-linya.
Gawas isulat: ( ['3rd: '] + ( a ? 2 ) ), bag-ong-linya.
Gawas isulat: ( ['prd: '] + ( a product ) ), bag-ong-linya.
a han-aya: { :a :b <- (b - a). }.
a matag: { :i :e Gawas isulat: ( i - 0 ), bag-ong-linya. }.

} padagana.



Programa limpyohi.
usedMemory3 := (Programa panumduman ? 0).

( usedMemory1 = usedMemory2 ug: usedMemory1 = usedMemory3, ug: usedMemory2 = usedMemory3 ) tinuod: {
	Gawas isulat: ['No memory leaks here'].
}, bakak: {
	Gawas isulat: ['Leaking memory...'].
}.
