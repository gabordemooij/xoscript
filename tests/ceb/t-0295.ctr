
>> dictionary := (
	Diksyonaryo bag-o
		ibutang: ['b'] sa: ['a'],
		ibutang: ['a'] sa: ['b'],
		ibutang: ['z'] sa: ['x'],
		ibutang: ['hello'] sa: ['hallo'],
		ibutang: ['human'] sa: ['human']
).

>> comparisons := Lista bag-o.
dictionary matag: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a itandi: b)
	).
}.

comparisons han-aya: { :a :b <- ( a itandi: b ). }.
Gawas isulat: ( comparisons hiusaha: ['↵'] ), bag-ong-linya.
comparisons hiusaha: ['↵'].
