>> del := conn1 pangutana: ['DELETE FROM book WHERE id > 0'].
{  del ipatuman. conn1 kumpirmaha. } dakpon: { :e conn1 ibalik.  }, padagana.

>> insert := conn1 pangutana: ['INSERT INTO book (id) VALUES(null)'].
insert ipatuman.

>> ihap := conn1 pangutana: ['SELECT COUNT(*) AS num FROM book'].
ihap kuhaa: { :row Gawas isulat: row num, bag-ong-linya. }.

# does not show up
# insert not committed on connection 1
