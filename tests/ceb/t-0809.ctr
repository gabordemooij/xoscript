# backslashes must survive code serialization, strings must not end early
>> mga-bili := Lista bag-o
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

mga-bili matag: { :i :value
	>> d := Diksyonaryo bag-o.
	d ibutang: value sa: ['k'].
	>> r := d kodigo butang.
	Gawas isulat: r ihap, bag-ong-linya.
	Gawas isulat: ( (r sa: ['k']) = value ), bag-ong-linya.
}.
