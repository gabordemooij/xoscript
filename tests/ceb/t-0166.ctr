

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa pagdumala-sa-panumduman: 0.

{
>> q := ['You should be able'].
q idugang-sa-tumoy: ([' to append something to a string']+['!']).
Gawas isulat: q.
} padagana.

Programa limpyohi.
usedMemory1 := (Programa panumduman ? 0).


{
>> q := ['You should be able'].
q idugang-sa-tumoy: ([' to append something to a string']+['!']).
Gawas isulat: q.
} padagana.

