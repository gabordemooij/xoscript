

Lista kon: ['column:'] buhata: { :column
	>> result := Lista bag-o.
	kaugalingon matag: { :index :row
		row matag: { :index :cell
			(index = column) tinuod: { result idugang-sa-tumoy: cell. }.
		}.
	}. <- result.
}.


>> a := Lista ←
	(Lista ← 1 ; 2 ; 3) ;
	(Lista ← 4 ; 5 ; 6) ;
	(Lista ← 7 ; 8 ; 9).

>> b := a column: 1.
Gawas isulat: b, bag-ong-linya.

b := a column: 20.
Gawas isulat: b, bag-ong-linya.

b := a column: -100.
Gawas isulat: b, bag-ong-linya.
