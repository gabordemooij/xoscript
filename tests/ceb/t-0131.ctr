
>> a := Lista ← (Lista ← 100 ; 200 ; 300) ; (Lista ← 9 ; 8 ; 7).
Gawas isulat: ['at 0,1 :'].
Gawas isulat: a ? 0 ? 1, bag-ong-linya. 
Gawas isulat: ['at 1,2 :'].
Gawas isulat: a ? 1 ? 2, bag-ong-linya. 
>> menu := Diksyonaryo bag-o.
menu ibutang: (Lista ← ['pizza'] ; ['spaghetti']) sa: ['Italian Cuisine'].
menu ibutang: (Lista ← ['bifteki'] ; ['suflaki']) sa: ['Greek Cuisine'].
Gawas isulat: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), bag-ong-linya. 
Gawas isulat: ['but not on the same plate.'], bag-ong-linya.
