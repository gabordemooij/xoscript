>> z := Butang bag-o.
z kon: ['value:'] buhata: { :v
	akoa value := v. <- kaugalingon.
}.
z kon: ['value'] buhata: { <- akoa value. }.
(z setValue: 1) value: 2.
Gawas isulat: z value.
>> x := z.
Gawas isulat: x value.
z := Wala.
Gawas isulat: z value.
Gawas isulat: x value.
Gawas isulat: ['hello'].
Gawas isulat: 3 + 2.
Gawas isulat: (3 > 2).
