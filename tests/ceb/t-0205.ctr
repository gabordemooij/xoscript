>> str := ['write:'].
Gawas mensahe: ['isulat:'] argumento: (Lista ← ['Hello World']), bag-ong-linya. 

Numero kon: ['isbetween:and:'] buhata: { :a :b <- ((kaugalingon ≥ a) ug: (kaugalingon ≤ b)).
}.

str := ['isbetween:and:'].
Gawas isulat: (3 mensahe: str argumento: (Lista ← 2 ; 8)), bag-ong-linya.
Gawas isulat: (3 mensahe: str argumento: (Lista ← 1 ; 2)), bag-ong-linya.


>> CoffeeMachine := Butang bag-o.
CoffeeMachine kon: ['makeCoffeeWithSugar:milk:'] buhata: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Lista ← 4 ; 2.
Gawas isulat: ( CoffeeMachine mensahe: order argumento: coffeeConfiguration ), bag-ong-linya.
