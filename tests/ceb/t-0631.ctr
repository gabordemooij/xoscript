#ffi test


Server init.

Programa pagdumala-sa-panumduman: 4.

# for this test you need set a path to libc (puts)
>> libname := Programa kahikayan: ['FFITESTLIB'].



Server isumpay: (
 Lista bag-o ;
 libname ;
 ['puts'] ;
 ( Lista bag-o ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s buhii.

# test with struct

>> a := Blob bag-o: 8.
a bytes: (
	Lista <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Lista <<: ['int'], ; ['int']).

Server isumpay: (
	Lista <<: ['@structtest'], ;
	['@structtest'] ;
	(Lista <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Gawas isulat: ['Sum test:'] + (ffitest ffisum: a), bag-ong-linya.

struct buhii-struct.
struct buhii.
a buhii.
