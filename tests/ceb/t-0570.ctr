#Linux

 >> t := Gutlo bag-o.
 
t sona: ['Europe/Amsterdam'].
t tuig: 2020, bulan: 8, adlaw: 2, oras: 21, minuto: 2, segundo: 1.

>> a := t oras.
>> ams := t sona.

t sona: ['US/Hawaii'].
>> b := t oras.
>> hw := t sona.

Gawas
isulat: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		kini: ['later'] o-kana: ['earlier']
	)
),
bag-ong-linya.
 