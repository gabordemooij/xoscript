>> a := Butang bag-o. 
a kon: ['greet'] buhata: { Gawas isulat: ['welcome!'], bag-ong-linya. }.
a kon: ['greet2'] buhata: { Gawas isulat: ['welcome2!'], bag-ong-linya. }.
a save-as: ['/tmp/a.bin'].

Gawas isulat: ['========== RELOADING SNAP:'], bag-ong-linya.
>> b := Butang load-from: ['/tmp/a.bin'].
b greet2.