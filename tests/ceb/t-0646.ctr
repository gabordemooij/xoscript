Server init.
Gawas isulat: ['Database datetime test'], bag-ong-linya.

>> db := Maria-DB bag-o host: ['localhost'],
	ngalan-sa-user: ['xo'], 
	password: ['pass123'],
	ngalan-sa-database: ['xobase'],
	sumpay.

>> parametro-sa-pagpangita :=
db pangutana: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
kuhaa: { :row
	Gawas isulat: row datetimetest, bag-ong-linya.
}.
