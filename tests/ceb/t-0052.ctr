>> items := Diksyonaryo bag-o.
items ibutang: ['green'] sa: ['color-1'].
items ibutang: ['orange'] sa: ['color-2'].
items ibutang: ['red'] sa: ['color-3'].
>> i := 0.
>> s := [''].
items matag: { :key :color
	Gawas isulat: ['color #'] + i + [' is: '] + color + [' '].
	i idugang: 1.
}.
Gawas isulat: i + [' colors!'].
