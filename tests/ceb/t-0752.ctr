Gawas isulat: ['Test object'], bag-ong-linya.
>> a := Butang bag-o. 

a kon: ['item:'] buhata: { :boolean
	akoa boolean := boolean. 
}.

a kon: ['item'] buhata: { <- akoa boolean.
}.

a item: Boolean.

Gawas isulat: a item, bag-ong-linya.

>> old-bool-address := a item prototipo adres-sa-panumduman.
a save-as: ['/tmp/a.bin'].
Gawas isulat: ['========== RELOADING SNAP:'], bag-ong-linya.

>> b := Butang load-from: ['/tmp/a.bin'].

(b item prototipo adres-sa-panumduman = old-bool-address) tinuod: {
	Gawas isulat: ['Object link re-attached.'], bag-ong-linya.
}.

Gawas isulat: b item, bag-ong-linya.
