

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa pagdumala-sa-panumduman: 0.

>> txt := ['Word Salad'].
Gawas isulat: ['last index of ord = '] + (( txt kataposang-posisyon: ['ord'] ) - 0), bag-ong-linya.
Gawas isulat: ['index of ord = '] + (( txt pangitaa: ['ord'] ) - 0), bag-ong-linya.
Gawas isulat: ['index of ad = '] + (( txt pangitaa: ['ad'] ) - 0), bag-ong-linya.
Gawas isulat: ['last index of W = '] + (( txt kataposang-posisyon: ['W'] ) - 0), bag-ong-linya.
Gawas isulat: ['last index of d = '] + (( txt kataposang-posisyon: ['d'] ) - 0), bag-ong-linya.
Gawas isulat: ['txt equals Word Salad = '] + ( txt = ['Word Salad'] ), bag-ong-linya.
Gawas isulat: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), bag-ong-linya.
Gawas isulat: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), bag-ong-linya.
Gawas isulat: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), bag-ong-linya.

Programa limpyohi.

usedMemory1 := (Programa panumduman ? 0).


