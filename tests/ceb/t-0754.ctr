Gawas isulat: ['Test object'], bag-ong-linya.
>> a := Butang bag-o. 

a kon: ['item:'] buhata: { :out
	akoa out := out. 
}.

a kon: ['item'] buhata: { <- akoa out.
}.

a kon: ['greet'] buhata: {
	Gawas isulat: ['hi from original out!'], bag-ong-linya.
}.

a item: Gawas.

Gawas isulat: a item, bag-ong-linya.

>> old-out-address := a item prototipo adres-sa-panumduman.
a save-as: ['/tmp/a.bin'].
Gawas isulat: ['========== RELOADING SNAP:'], bag-ong-linya.

>> b := Butang load-from: ['/tmp/a.bin'].

(b item prototipo adres-sa-panumduman = old-out-address) tinuod: {
	Gawas isulat: ['Object link re-attached.'], bag-ong-linya.
}.

b item isulat: ['hello from loaded out!'], bag-ong-linya.
b greet.
