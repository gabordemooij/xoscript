Programa pagdumala-sa-panumduman: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } dakpon: {
		oops idugang: 1.
	}, padagana.
} × 1000.

{
	Gawas isulat: ['hi there!'].
	kining-buluhaton sayup: ['oops'].
	Gawas isulat: ['hi there!'].
	{ Gawas isulat: ['dont print this']. } padagana.
} dakpon: { :e 
	Gawas isulat: ['got ya!']. 
	Gawas isulat: e.
}, padagana.
