Server init.

>> DB := Maria-DB bag-o host: ['localhost'],
	ngalan-sa-user: ['xo'],
	password: ['pass123'],
	ngalan-sa-database: ['xobase'],
	sumpay.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> parametro-sa-pagpangita := Maria-Pangutana bag-o: SQL.

# set database
parametro-sa-pagpangita database: DB.

parametro-sa-pagpangita kuhaa: { :row
	Gawas isulat: row world, bag-ong-linya.
}.
