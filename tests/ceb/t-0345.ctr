# test catch-all methods
>> x13 := Butang bag-o.
x13 kon: ['a'] buhata: { :a Gawas isulat: 0, bag-ong-linya. }.
x13 kon: ['a:'] buhata: { :a Gawas isulat: a, bag-ong-linya. <- 5. }.
x13 kon: ['a:b:'] buhata: { :a :b Gawas isulat: (a + b), bag-ong-linya. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
