



>> CoffeeGrounds := Butang bag-o.
CoffeeGrounds kon: ['extract'] buhata: { <- ['coffee']. }.

>> CoffeeMachine := Butang bag-o.
CoffeeMachine kon: ['init'] buhata: {
	akoa coffeegrounds := CoffeeGrounds bag-o.
}.
CoffeeMachine kon: ['bag-o'] buhata: { <- CoffeeMachine `new init.
}.

CoffeeMachine kon: ['makeTea'] buhata: { <- (akoa tealeaves extract). }.
CoffeeMachine kon: ['makeCoffee'] buhata: { <- (akoa coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine bag-o.

Gawas isulat:
	coffeeDream 
	makeCoffee.

Gawas isulat:
	coffeeDream 
	makeTea.
