

>> g := Server નવું.
>> v := તિજોરી નવું.
>> ok := 0.

>> secrets := સૂચિ નવું ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> passwords := secrets નકલ.
passwords દરેક: { :i :p
	secrets દરેક: { :n :s
		{
			>> encrypted := v એન્ક્રિપ્ટ: s ચાવી: p.
			>> decrypted := v ડિક્રિપ્ટ: encrypted ચાવી: p.
			(decrypted = s) સાચું-હોય-તો: {
				ok સરવાળો: 1.
			}, નહીંતર: {
				આઉટપુટ લખો: ['failed encrypting/decrypting: '], નવી-લીટી.
				આઉટપુટ લખો: s, નવી-લીટી.
				આઉટપુટ લખો: ['encrypted: '] + encrypted, નવી-લીટી.
				આઉટપુટ લખો: ['decrypted: '] + encrypted, નવી-લીટી.
				પ્રોગ્રામ સમાપ્ત.
			}.
		} પકડો: { :err
			(s = [''] અથવા: p = ['']) સાચું-હોય-તો: {
				ok સરવાળો: 1.
			}, નહીંતર: {
				આઉટપુટ લખો: err, નવી-લીટી.
				પ્રોગ્રામ સમાપ્ત.
			}.
		}, ચલાવો.
	}.
}.

આઉટપુટ લખો: ( ok + [' vault encryptions tested.'] ), નવી-લીટી.