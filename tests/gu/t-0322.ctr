

>> Matryoshka := વસ્તુ નવું.
Matryoshka જ્યારે: ['double:'] કરો: { :secret
	પોતાનું secret := secret × 2.
}.
Matryoshka જ્યારે: ['નવું:'] કરો: { :secret
	>> answer := શૂન્ય.
	>> t := (secret > 255).
	આઉટપુટ લખો: (secret + [' | '] + t), નવી-લીટી.
	t સાચું-હોય-તો: {
		answer := secret.
	}, નહીંતર: {
		answer := Matryoshka પુનરાવર્તી નવું: (પોતે double: secret).
	}. <- answer.
}.

>> x := Matryoshka નવું: 2.
