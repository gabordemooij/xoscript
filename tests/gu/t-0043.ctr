>> repeater := વસ્તુ નવું.
repeater જ્યારે: ['જવાબ:'] કરો: { :what
	આઉટપુટ લખો: what + [' '].
}.
repeater જ્યારે: ['જવાબ:અને:'] કરો: { :what :say
	આઉટપુટ લખો: what, લખો: say + [' '].
}.
repeater જ્યારે: ['જવાબ:અને:અને:'] કરો: { :what :say :more
	આઉટપુટ લખો: what, લખો: say, લખો: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
