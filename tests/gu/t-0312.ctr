>> Slurp := વસ્તુ નવું.
Slurp જ્યારે: ['નવું'] કરો: {
	પોતાનું str := [''].
}.
Slurp શીખો: ['nieuw'] અર્થ: ['નવું'].
Slurp જ્યારે: ['જવાબ:'] કરો: { :blah
		(પોતાનું str ≠ ['']) સાચું-હોય-તો: {
			પોતાનું str અંતે-ઉમેરો: [' '].
		}.
		પોતાનું str અંતે-ઉમેરો: blah.
}.
Slurp જ્યારે: ['જવાબ:અને:'] કરો: { :blah :blahah
		(પોતાનું str ≠ ['']) સાચું-હોય-તો: {
			પોતાનું str અંતે-ઉમેરો: [' '].
		}.
		(blah લંબાઈ > 1) સાચું-હોય-તો: {
			પોતાનું str અંતે-ઉમેરો: (blah શરૂઆત: 0 લંબાઈ: (blah લંબાઈ - 1)).
		}, નહીંતર: {
			પોતાનું str અંતે-ઉમેરો: blah.
		}.
		પોતાનું str અંતે-ઉમેરો: [' '].
		પોતાનું str અંતે-ઉમેરો: blahah.
}.
Slurp જ્યારે: ['obtain'] કરો: {
	>> buffer := પોતાનું str.
	પોતાનું str := ['']. <- buffer.
}.


>> શોધ-પેરામીટર := Slurp નવું
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

આઉટપુટ લખો: શોધ-પેરામીટર obtain, નવી-લીટી.
