# test qualifiers

>> $ := વસ્તુ નવું.

$ જ્યારે: ['જવાબ:'] કરો: { :x
	
	>> operation := x અક્ષર: 0.
	>> valuta := x અક્ષર: 1.
	>> money := x છોડો: 2.
	
	>> amount := 0.

	( operation = ['+'] ) સાચું-હોય-તો: {
		( valuta = ['£'] ) સાચું-હોય-તો: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

આઉટપુટ લખો: x, નવી-લીટી.


>> Fruit := વસ્તુ નવું.

Fruit જ્યારે: ['નવું'] કરો: {
	>> f := પોતે નવું.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit જ્યારે: ['apples:'] કરો: { :a પોતાનું apples := a. }.
Fruit જ્યારે: ['oranges:'] કરો: { :p પોતાનું oranges := p. }.
Fruit જ્યારે: ['apples'] કરો: { <- પોતાનું apples. }.
Fruit જ્યારે: ['oranges'] કરો: { <- પોતાનું oranges. }.

Fruit જ્યારે: ['+'] કરો: { :f
	
	>> n := Fruit નવું.
	f સરવાળો: 1.
	
	n apples: (f apples + પોતાનું apples).
	n oranges:  (f oranges  + પોતાનું oranges). <- n.
}.

Fruit જ્યારે: ['લખાણમાં'] કરો: { <- ( પોતાનું apples લખાણમાં + [' apples and '] + પોતાનું oranges + [' oranges'] ).
}.

સંખ્યા જ્યારે: ['apples'] કરો: { <- ((Fruit નવું) apples: પોતે).
}.

સંખ્યા જ્યારે: ['apple'] કરો: { <- ((Fruit નવું) apples: પોતે).
}.

સંખ્યા જ્યારે: ['oranges'] કરો: { <- ((Fruit નવું) oranges: પોતે).
}.




આઉટપુટ લખો: (1 apple + 3 oranges + 4 apples), નવી-લીટી.


લખાણ જ્યારે: ['twice'] કરો: { <- ((પોતે લખાણમાં) + (પોતે લખાણમાં)).
}.



આઉટપુટ લખો: ['❤❤❤'] twice.



