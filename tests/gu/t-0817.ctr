# a value ending in the first part of an opening quote must survive serialization
>> મૂલ્યો := સૂચિ નવું
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

મૂલ્યો દરેક: { :i :value
	>> d := શબ્દકોશ નવું.
	d મૂકો: value ચાવી: ['k'].
	d મૂકો: ['second'] ચાવી: ['j'].
	>> r := d કોડ વસ્તુમાં.
	આઉટપુટ લખો: r ગણતરી, નવી-લીટી.
	આઉટપુટ લખો: ( (r પર: ['k']) = value ), નવી-લીટી.
}.
