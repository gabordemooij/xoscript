#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := પેટર્ન નવું: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern મેળ: subject કરો: { :m :x
	આઉટપુટ લખો: m, નવી-લીટી.
	આઉટપુટ લખો: x, નવી-લીટી. <- ['XXX'].
}.
આઉટપુટ લખો: result, નવી-લીટી.