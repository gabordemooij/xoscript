>> t := શૂન્ય.

# you can control the time zone for
# parsing like this:
ક્ષણ સમય-ક્ષેત્ર: ['CET'].
t := ક્ષણ માંથી: ['1981-02-03 04:05:06'].
આઉટપુટ લખો: t, નવી-લીટી.

# now using CEST time zone:
ક્ષણ સમય-ક્ષેત્ર: ['CEST'].
t := ક્ષણ માંથી: ['1981-02-03 04:05:06'].
આઉટપુટ લખો: t, નવી-લીટી.

# error if string cannot be parsed
{ ક્ષણ માંથી: ['1900']. } પકડો: { શૂન્ય. }, ચલાવો.
