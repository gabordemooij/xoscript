# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := પેટર્ન નવું: pattern.
	p મેળ: subject કરો: { :m :g
		આઉટપુટ લખો: g ગણતરી, લખો: [' '], લખો: (g જોડો: ['|']), નવી-લીટી. <- m.
	}.
}.
show લાગુ: ['(a)|(b)'] અને: ['b'].
show લાગુ: ['(a)|(b)'] અને: ['a'].
show લાગુ: ['(x)?y'] અને: ['y'].
show લાગુ: ['(x)?(y)(z)?'] અને: ['xy'].
