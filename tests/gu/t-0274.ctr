

સૂચિ જ્યારે: ['column:'] કરો: { :column
	>> result := સૂચિ નવું.
	પોતે દરેક: { :index :row
		row દરેક: { :index :cell
			(index = column) સાચું-હોય-તો: { result અંતે-ઉમેરો: cell. }.
		}.
	}. <- result.
}.


>> a := સૂચિ ←
	(સૂચિ ← 1 ; 2 ; 3) ;
	(સૂચિ ← 4 ; 5 ; 6) ;
	(સૂચિ ← 7 ; 8 ; 9).

>> b := a column: 1.
આઉટપુટ લખો: b, નવી-લીટી.

b := a column: 20.
આઉટપુટ લખો: b, નવી-લીટી.

b := a column: -100.
આઉટપુટ લખો: b, નવી-લીટી.
