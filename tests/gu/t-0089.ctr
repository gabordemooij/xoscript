>> randomizer := { :a :b
	>> લઘુત્તમ := ( a < b ) આ: a નહીં-તો: b.
	>> મહત્તમ := ( a > b ) આ: a નહીં-તો: b.
	>> x := શૂન્ય.
	{
		x := સંખ્યા વચ્ચે: a અને: b.
		((x < લઘુત્તમ) અથવા: (x > મહત્તમ)) સાચું-હોય-તો: { 
			આઉટપુટ લખો: (['Invalid value!']).
			પ્રોગ્રામ સમાપ્ત.
		}.
	} 
	× 100. <- x.
}.
