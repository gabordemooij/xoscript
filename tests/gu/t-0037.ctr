>> a := 3.
>> b := a નકલ.
a બાદ: 1.
આઉટપુટ લખો: [' a = '] + a.
આઉટપુટ લખો: [' b = '] + b.
a := 3.
b := a + 4.
આઉટપુટ લખો: [' a = '] + a.
આઉટપુટ લખો: [' b = '] + b.
>> x := 3.
>> y := x નકલ.
x સરવાળો: 10.
y બાદ: 1.
આઉટપુટ લખો: [' x = '] + x.
આઉટપુટ લખો: [' y = '] + y.
>> q := વસ્તુ નવું.
q જ્યારે: ['setProperty:'] કરો: { :x
	પોતાનું prop := x.
}.
q જ્યારે: ['getProperty'] કરો: { <- પોતાનું prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
આઉટપુટ લખો: [' p = '] + (p getProperty).
