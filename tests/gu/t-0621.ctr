>> phrases := સૂચિ નવું
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases દરેક: { :_ :phrase 
	>> e := Server base64-એન્કોડ: phrase.
	>> d := Server base64-ડિકોડ: e.
	આઉટપુટ લખો: (
		message નકલ ~encoded: e, ~decoded: d
	), નવી-લીટી.
}.
