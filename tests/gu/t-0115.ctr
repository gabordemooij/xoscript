{
	આ-કાર્ય ભૂલ: ['Dont fail.'].
	unknown doSomething.
} પકડો: {
	આઉટપુટ લખો: ['Caught!'].
}, ચલાવો.

{
	આ-કાર્ય ભૂલ: ['Dont fail.'].
	પોતાનું unknown doSomething.
} પકડો: {
	આઉટપુટ લખો: ['Caught!'].
}, ચલાવો.

{
	આ-કાર્ય ભૂલ: ['Dont fail.'].
	unknown := 122.
} પકડો: {
	આઉટપુટ લખો: ['Caught!'].
}, ચલાવો.


{
	આ-કાર્ય ભૂલ: ['Dont fail.'].
	સાચું અટકાવો.
	આઉટપુટ લખો: ['FAIL'].
} પકડો: {
	આઉટપુટ લખો: ['Caught!'].
}, ચલાવો.

{
	{
		આ-કાર્ય ભૂલ: ['Dont fail.'].
		સાચું અટકાવો.
		આઉટપુટ લખો: ['FAIL'].
	} પકડો: { :x
		(x = ['Dont fail.']) સાચું-હોય-તો: { આ-કાર્ય ભૂલ: ['Nested Caught!']. }.
	}, ચલાવો.
} પકડો: { :e
	આઉટપુટ લખો: e.
}, ચલાવો.
