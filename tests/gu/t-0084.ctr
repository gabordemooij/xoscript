>> makeAdder := { :x
	>> f := { :y <- (પોતાનું x + y). } નક્કી: ['x'] મૂલ્ય: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i પોતાનું q મૂકો: (પોતાનું f લાગુ: (પોતાનું q ? i)) ચાવી: i. } 
	નક્કી: ['q'] મૂલ્ય: array,
	નક્કી: ['f'] મૂલ્ય: func.
	{ :i mapping લાગુ: i. } × (array ગણતરી).
}.

>> a := સૂચિ ← 1; 2; 3.
mapper લાગુ: a અને: (makeAdder લાગુ: 100).
આઉટપુટ લખો: (a સ્થાન: 0), નવી-લીટી.
આઉટપુટ લખો: (a ? 1), નવી-લીટી.
આઉટપુટ લખો: (a ? 2), નવી-લીટી.
