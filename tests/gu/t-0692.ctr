Server init.

આઉટપુટ લખો: (
	પેટર્ન નવું: ['^\\w+$'],
	મેળ: ['test@example.com'] 
), નવી-લીટી. # 0 match, fails on @ and .

આઉટપુટ લખો: (
	પેટર્ન નવું: ['^[^@]+@[^\.]+\.\\w+$'],
	મેળ: ['test@example.com'] 
), નવી-લીટી. # 1 match

આઉટપુટ લખો: (
	પેટર્ન નવું: ['[^@]+@[^\.]+\.\\w+'],
	મેળ: ['test@example.com'] 
), નવી-લીટી. # 1 match

આઉટપુટ લખો: (
	પેટર્ન નવું: ['([^@]+)@([^\.]+)\.\\w+'],
	મેળ: ['test@example.com'] 
), નવી-લીટી. # 1 match, groups dont matter

આઉટપુટ લખો: (
	પેટર્ન નવું: ['[a-z]'],
	મેળ: ['test@example.com'] 
), નવી-લીટી. # 14 matches

આઉટપુટ લખો: (
	પેટર્ન નવું: ['.*'],
	મેળ: ['test@example.com'] 
), નવી-લીટી. # 1 match (all)

આઉટપુટ લખો: (
	પેટર્ન નવું: ['(.*)'],
	મેળ: ['test@example.com'] 
), નવી-લીટી. # 1 match (all)

આઉટપુટ લખો: (
	પેટર્ન નવું: ['\\s*[^@]+@[^\.]+\.\\w+'],
	મેળ: ['test@example.com'] 
), નવી-લીટી. # 1 match, prefix space optional, gets ignored