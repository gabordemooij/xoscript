


>> wine := વસ્તુ નવું.


wine જ્યારે: ['toString'] કરો: { <- ['merlot'].
}.

wine જ્યારે: ['naarTekst'] કરો: { <- ['merlot'].
}.


wine જ્યારે: ['='] કરો: { :other wine <- ( પોતે toString = other wine ).
}.

wine જ્યારે: ['=='] કરો: { :other wine <- ( પોતે toString = other wine ).
}.



wine
	કિસ્સો: ['cabernet'] કરો: { આઉટપુટ લખો: ['it's a Cabernet!']. },
	કિસ્સો: ['syrah']    કરો: { આઉટપુટ લખો: ['it's a Syrah!'].    },
	કિસ્સો: ['merlot']   કરો: { આઉટપુટ લખો: ['it's a Merlot!'].   },
	કિસ્સો: ['malbec']   કરો: { આઉટપુટ લખો: ['it's a Malbec!'].   }.

આઉટપુટ નવી-લીટી.
