>> echo := વસ્તુ નવું.
echo જ્યારે: ['જવાબ:'] કરો: { :sound
	{ આઉટપુટ લખો: sound. } × 2.
}.
echo ho!. 


echo := વસ્તુ નવું.
echo જ્યારે: ['જવાબ:અને:'] કરો: { :sound :x
	{ આઉટપુટ લખો: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := વસ્તુ નવું.
echo જ્યારે: ['જવાબ:અને:અને:'] કરો: { :operation :sound :x
	{ આઉટપુટ લખો: sound. } × x.
}.
echo shout: ['la'] times: 4. 


