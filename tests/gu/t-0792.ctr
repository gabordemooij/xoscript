Server init.

>> DB := Maria-DB નવું હોસ્ટ: ['localhost'],
	વપરાશકર્તા-નામ: ['xo'],
	પાસવર્ડ: ['pass123'],
	ડેટાબેઝ-નામ: ['xobase'],
	જોડાઓ.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB ક્વેરી: SQL.

# now you don't have to set DB
query2 લાવો: { :row
	આઉટપુટ લખો: row world, નવી-લીટી.
}.
