>> z := વસ્તુ નવું.
z જ્યારે: ['value:'] કરો: { :v
	પોતાનું value := v. <- પોતે.
}.
z જ્યારે: ['value'] કરો: { <- પોતાનું value. }.
(z setValue: 1) value: 2.
આઉટપુટ લખો: z value.
>> x := z.
આઉટપુટ લખો: x value.
z := શૂન્ય.
આઉટપુટ લખો: z value.
આઉટપુટ લખો: x value.
