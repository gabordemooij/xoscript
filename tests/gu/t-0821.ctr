# a quote that never closes must give an error, not an endless loop
>> ફાઇલ-માર્ગ := ['/tmp/test0821.csv'].
>> file := ફાઇલ નવું: ફાઇલ-માર્ગ.

file લખો: ['a,b\n"1,2\n'].
{
	file વિભાજક: [','] અવતરણ: ['"'] લીટીઓ: { :line
		આઉટપુટ લખો: line, નવી-લીટી.
	}.
} પકડો: { :e આઉટપુટ લખો: e, નવી-લીટી. }, ચલાવો.

# a closed quote still works
file લખો: ['a,b\n"1,2",3'].
file વિભાજક: [','] અવતરણ: ['"'] લીટીઓ: { :line
	આઉટપુટ લખો: line, નવી-લીટી.
}.
file કાઢી-નાખો.
