

>> obj := વસ્તુ નવું.

obj જ્યારે: ['greet'] કરો: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj જ્યારે: ['task'] કરો: {
	પોતાનું property := 123.
	{
		# try binds self/own to object instead of block
		આઉટપુટ લખો: પોતે greet.
		આઉટપુટ લખો: પોતાનું property.
		1 / 0.
	} પકડો: {
		આઉટપુટ લખો: પોતે greet.
		આઉટપુટ લખો: પોતાનું property.
		આઉટપુટ લખો: ['ok'].
	}, પ્રયાસ.
}.

obj task.