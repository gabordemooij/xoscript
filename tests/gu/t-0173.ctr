

સૂચિ જ્યારે: ['sum'] કરો: {
	>> total := 0.
	પોતે દરેક: { :index :element
		total સરવાળો: element.
	}. <- total.
}.

સૂચિ જ્યારે: ['product'] કરો: {
	>> total := 1.
	પોતે દરેક: { :index :element
		total ગુણો: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

પ્રોગ્રામ મેમરી-વ્યવસ્થાપન: 0.

{

>> a := સૂચિ ← ['hello'] ; ['world'] ; સાચું ; શૂન્ય ; 666.
a := a + ( સૂચિ ← 1 ).
આઉટપુટ લખો: ( ['sum: '] + ( a sum ) ), નવી-લીટી.
આઉટપુટ લખો: ( ['min: '] + ( a લઘુત્તમ ) ), નવી-લીટી.
આઉટપુટ લખો: ( ['max: '] + ( a મહત્તમ ) ), નવી-લીટી.
આઉટપુટ લખો: ( ['3rd: '] + ( a ? 2 ) ), નવી-લીટી.
આઉટપુટ લખો: ( ['prd: '] + ( a product ) ), નવી-લીટી.
a ક્રમ-ગોઠવો: { :a :b <- (b - a). }.
a દરેક: { :i :e આઉટપુટ લખો: ( i - 0 ), નવી-લીટી. }.

} ચલાવો.

પ્રોગ્રામ સફાઈ.
usedMemory1 := (પ્રોગ્રામ મેમરી ? 0).


{

>> a := સૂચિ ← ['hello'] ; ['world'] ; સાચું ; શૂન્ય ; 666.
a := a + ( સૂચિ ← 1 ).
આઉટપુટ લખો: ( ['sum: '] + ( a sum ) ), નવી-લીટી.
આઉટપુટ લખો: ( ['min: '] + ( a લઘુત્તમ ) ), નવી-લીટી.
આઉટપુટ લખો: ( ['max: '] + ( a મહત્તમ ) ), નવી-લીટી.
આઉટપુટ લખો: ( ['3rd: '] + ( a ? 2 ) ), નવી-લીટી.
આઉટપુટ લખો: ( ['prd: '] + ( a product ) ), નવી-લીટી.
a ક્રમ-ગોઠવો: { :a :b <- (b - a). }.
a દરેક: { :i :e આઉટપુટ લખો: ( i - 0 ), નવી-લીટી. }.

} ચલાવો.



પ્રોગ્રામ સફાઈ.
usedMemory2 := (પ્રોગ્રામ મેમરી ? 0).


{

>> a := સૂચિ ← ['hello'] ; ['world'] ; સાચું ; શૂન્ય ; 666.
a := a + ( સૂચિ ← 1 ).
આઉટપુટ લખો: ( ['sum: '] + ( a sum ) ), નવી-લીટી.
આઉટપુટ લખો: ( ['min: '] + ( a લઘુત્તમ ) ), નવી-લીટી.
આઉટપુટ લખો: ( ['max: '] + ( a મહત્તમ ) ), નવી-લીટી.
આઉટપુટ લખો: ( ['3rd: '] + ( a ? 2 ) ), નવી-લીટી.
આઉટપુટ લખો: ( ['prd: '] + ( a product ) ), નવી-લીટી.
a ક્રમ-ગોઠવો: { :a :b <- (b - a). }.
a દરેક: { :i :e આઉટપુટ લખો: ( i - 0 ), નવી-લીટી. }.

} ચલાવો.



પ્રોગ્રામ સફાઈ.
usedMemory3 := (પ્રોગ્રામ મેમરી ? 0).

( usedMemory1 = usedMemory2 અને: usedMemory1 = usedMemory3, અને: usedMemory2 = usedMemory3 ) સાચું-હોય-તો: {
	આઉટપુટ લખો: ['No memory leaks here'].
}, ખોટું-હોય-તો: {
	આઉટપુટ લખો: ['Leaking memory...'].
}.
