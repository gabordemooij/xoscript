#...
>> del := conn1 ક્વેરી: ['DELETE FROM book WHERE id > 0'].
{  del અમલ. conn1 પુષ્ટિ. } પકડો: { :e conn1 પાછું-વાળો.  }, ચલાવો.

>> insert := conn1 ક્વેરી: ['INSERT INTO book (id) VALUES(null)'].
insert અમલ.

>> ગણતરી := conn1 ક્વેરી: ['SELECT COUNT(*) AS num FROM book'].
ગણતરી લાવો: { :row આઉટપુટ લખો: row num, નવી-લીટી. }.

# does not show up
# insert not committed on connection 1
>> ગણતરી := conn2 ક્વેરી: ['SELECT COUNT(*) AS num FROM book'].
ગણતરી લાવો: { :row આઉટપુટ લખો: row num, નવી-લીટી. }.
