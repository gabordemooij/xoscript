>> Greeter := વસ્તુ નવું.
Greeter જ્યારે: ['make'] કરો: {
	>> gr := વસ્તુ નવું.
	gr જ્યારે: ['setName:'] કરો: { :aname
		પોતાનું નામ := aname.
	}.
	gr જ્યારે: ['greet'] કરો: {
		આઉટપુટ લખો: પોતાનું નામ.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a નવું.
c setName: ['THREE'].
c greet.
>> d := a નવું.
d setName: ['FOUR'].
d greet.
c greet.
