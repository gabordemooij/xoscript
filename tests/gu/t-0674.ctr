# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> ફાઇલ-માર્ગ := ['/tmp/dat.csv'].
>> csv := ફાઇલ નવું: ફાઇલ-માર્ગ.
csv લખો: s.

# accepts CRLF LF CR, varying row length
csv વિભાજક: [';'] અવતરણ: ['"'] લીટીઓ: { :line
	પ્રોગ્રામ સફાઈ.
	આઉટપુટ લખો: line, નવી-લીટી.
	પ્રોગ્રામ સફાઈ.
}.

# unequal lines
s અંતે-ઉમેરો: ['\njustone'].
csv લખો: s.
{
	csv વિભાજક: [';'] અવતરણ: ['"'] લીટીઓ: { :line
		આઉટપુટ લખો: line, નવી-લીટી.
	}.
} પકડો: { :e 
	આઉટપુટ લખો: e, નવી-લીટી.
}, ચલાવો.

# invalid format
s := ['"he"llo";world'].
csv લખો: s.
{
	csv વિભાજક: [';'] અવતરણ: ['"'] લીટીઓ: { :line
		આઉટપુટ લખો: line, નવી-લીટી.
	}.
} પકડો: { :e 
	આઉટપુટ લખો: e, નવી-લીટી.
}, ચલાવો.
