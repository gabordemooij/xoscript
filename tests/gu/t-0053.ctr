60 × {
	>> x := (સંખ્યા random % 6) + 1.
	(x ≤ 6) ખોટું-હોય-તો: { આઉટપુટ લખો: ['FAIL']. }.
	(x ≥0) ખોટું-હોય-તો: { આઉટપુટ લખો: ['FAIL']. }.
	x := (સંખ્યા random % 3) + 1.
	(x < 3) ખોટું-હોય-તો: { આઉટપુટ લખો: ['FAIL']. }.
	(x>-1) ખોટું-હોય-તો: { આઉટપુટ લખો: ['FAIL']. }.
	x := ((બુલિયન flip) સંખ્યામાં).
	(x = 0 અથવા: x = 1) ખોટું-હોય-તો: { આઉટપુટ લખો: ['FAIL']. }.
	x := ((સાચું flip) સંખ્યામાં).
	(x = 0 અથવા: x = 1) ખોટું-હોય-તો: { આઉટપુટ લખો: ['FAIL']. }.
	x := (બુલિયન flip આ: ['HEAD'] નહીં-તો: ['TAIL']).
	((x = ['HEAD']) અથવા: (x = ['TAIL'])) ખોટું-હોય-તો: { આઉટપુટ લખો: ['FAIL']. }.
}.
આઉટપુટ લખો: ['DONE'].

