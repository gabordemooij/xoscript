પ્રોગ્રામ મેમરી-વ્યવસ્થાપન: 0.
સૂચિ જ્યારે: ['sum'] કરો: {
	>> total := 0.
	પોતે દરેક: { :index :element
		total સરવાળો: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := ફાઇલ નવું: ['/tmp/test.txt'].
f લખો: ['Lorem Ipsum'].
f બંધ.
  

f := ફાઇલ નવું: ['/tmp/test.txt'].
>> text := f વાંચો.
f બંધ.



પ્રોગ્રામ સફાઈ.
usedMemory1 := (પ્રોગ્રામ મેમરી ? 1).



f := ફાઇલ નવું: ['/tmp/test.txt'].
text := f વાંચો.
f બંધ.

પ્રોગ્રામ સફાઈ.
usedMemory2 := (પ્રોગ્રામ મેમરી ? 1).


f := ફાઇલ નવું: ['/tmp/test.txt'].
text := f વાંચો.
f બંધ.

પ્રોગ્રામ સફાઈ.
usedMemory3 := (પ્રોગ્રામ મેમરી ? 1).



( usedMemory1 = usedMemory2 અને: usedMemory1 = usedMemory3, અને: usedMemory2 = usedMemory3 ) સાચું-હોય-તો: {
	આઉટપુટ લખો: ['No memory leaks here'].
}, ખોટું-હોય-તો: {
	આઉટપુટ લખો: ['Leaking memory...'].
}.
