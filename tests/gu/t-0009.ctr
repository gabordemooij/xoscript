>> Greeter := વસ્તુ નવું.
Greeter જ્યારે: ['make'] કરો: {
	>> greeter := વસ્તુ નવું.
	greeter જ્યારે: ['name:'] કરો: { :નામ
		આઉટપુટ લખો: ['setting a name'].
		પોતાનું myName := નામ.
	}.
	greeter જ્યારે: ['performGreeting'] કરો: {
		આઉટપુટ લખો: ['Hello'].
		આઉટપુટ લખો: પોતાનું myName.
	}.
	greeter જ્યારે: ['greet'] કરો: {
		પોતે performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
