>> Animal := વસ્તુ નવું.
Animal જ્યારે: ['make'] કરો: {
	>> animal := વસ્તુ નવું.
	animal જ્યારે: ['makeSound'] કરો: {
		આઉટપુટ લખો: પોતાનું sound.
	}. <- animal.
}.
>> Cat := વસ્તુ નવું.
Cat જ્યારે: ['make'] કરો: {
	>> cat := Animal make.
	cat જ્યારે: ['init'] કરો: {
		પોતાનું sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
