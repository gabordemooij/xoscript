>> items := શબ્દકોશ નવું.
items મૂકો: ['green'] ચાવી: ['color-1'].
items મૂકો: ['orange'] ચાવી: ['color-2'].
items મૂકો: ['red'] ચાવી: ['color-3'].
>> i := 0.
>> s := [''].
items દરેક: { :key :color
	આઉટપુટ લખો: ['color #'] + i + [' is: '] + color + [' '].
	i સરવાળો: 1.
}.
આઉટપુટ લખો: i + [' colors!'].
