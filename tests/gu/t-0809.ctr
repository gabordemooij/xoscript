# backslashes must survive code serialization, strings must not end early
>> મૂલ્યો := સૂચિ નવું
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

મૂલ્યો દરેક: { :i :value
	>> d := શબ્દકોશ નવું.
	d મૂકો: value ચાવી: ['k'].
	>> r := d કોડ વસ્તુમાં.
	આઉટપુટ લખો: r ગણતરી, નવી-લીટી.
	આઉટપુટ લખો: ( (r પર: ['k']) = value ), નવી-લીટી.
}.
