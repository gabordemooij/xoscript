
લખાણ જ્યારે: ['html'] કરો: { <- (
		પોતે
		બદલો: ['&'] વડે: ['&amp;'],
		બદલો: ['<'] વડે: ['&lt;'],
		બદલો: ['>'] વડે: ['&gt;'],
		બદલો: ['"'] વડે: ['&quot;']
	).
}.

>> HtmlBrush := વસ્તુ નવું.

HtmlBrush જ્યારે: ['જવાબ:'] કરો: { :tag
	આઉટપુટ લખો: (['<tag>↵'] tag: tag ).
}.

HtmlBrush જ્યારે: ['જવાબ:અને:'] કરો: { :tag :content
	tag := ( tag શરૂઆત: 0 લંબાઈ: (tag લંબાઈ - 1) ).
	આઉટપુટ લખો: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush જ્યારે: ['content:'] કરો: { :text
	આઉટપુટ લખો: text html, નવી-લીટી.
}.

HtmlBrush જ્યારે: ['attr:value:'] કરો: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush નવું.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
