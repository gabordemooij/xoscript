સૂચિ જ્યારે: ['sum'] કરો: {
	>> total := 0.
	પોતે દરેક: { :index :element
		total સરવાળો: element.
	}. <- total.
}.

>> a := સાચું.



a જ્યારે: ['લખાણમાં'] કરો: {
	>> answer := શૂન્ય.
	( પોતે = સાચું ) સાચું-હોય-તો: {
		answer := ['Yep'].
	}, નહીંતર: {
		answer := ['Nope'].
	}. <- answer.
}.

a જ્યારે: ['સંખ્યામાં'] કરો: {
	>> answer := શૂન્ય.
	( પોતે = સાચું ) સાચું-હોય-તો: {
		answer := 10.
	}, નહીંતર: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b જ્યારે: ['લખાણમાં'] કરો: { <- ['Devil'].
}.

b જ્યારે: ['બુલિયનમાં'] કરો: { <- ખોટું.
}.


આઉટપુટ લખો: a, નવી-લીટી.  
આઉટપુટ લખો: (90 + a), નવી-લીટી. 
આઉટપુટ લખો: b, નવી-લીટી. 
આઉટપુટ લખો: (સાચું અને: b), નવી-લીટી.

a := સૂચિ ← ['hello'] ; ['world'] ; સાચું ; શૂન્ય ; 666. 
a := a + ( સૂચિ ← 1 ).
આઉટપુટ લખો: a, નવી-લીટી.
આઉટપુટ લખો: ((શબ્દકોશ નવું) મૂકો: શૂન્ય ચાવી: શૂન્ય), નવી-લીટી.
આઉટપુટ લખો: a sum, નવી-લીટી. 


{
	a જ્યારે: ['લખાણમાં'] કરો: { <- શૂન્ય. }.
	a := [''] + a.
} પકડો: { :error
	આઉટપુટ લખો: ['Error noted: '] + error, નવી-લીટી.
}, ચલાવો.



