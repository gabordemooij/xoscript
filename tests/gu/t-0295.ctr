
>> dictionary := (
	શબ્દકોશ નવું
		મૂકો: ['b'] ચાવી: ['a'],
		મૂકો: ['a'] ચાવી: ['b'],
		મૂકો: ['z'] ચાવી: ['x'],
		મૂકો: ['hello'] ચાવી: ['hallo'],
		મૂકો: ['human'] ચાવી: ['human']
).

>> comparisons := સૂચિ નવું.
dictionary દરેક: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a સરખામણી: b)
	).
}.

comparisons ક્રમ-ગોઠવો: { :a :b <- ( a સરખામણી: b ). }.
આઉટપુટ લખો: ( comparisons જોડો: ['↵'] ), નવી-લીટી.
comparisons જોડો: ['↵'].
