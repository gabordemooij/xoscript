# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := વસ્તુ નવું.

Log જ્યારે: ['say:'] કરો: { :str
	આઉટપુટ લખો: str, નવી-લીટી.
}.

>> Item := વસ્તુ નવું.

Item જ્યારે: ['નવું:'] કરો: { :id <- પોતે નવું id: id.
}.

Item જ્યારે: ['id:'] કરો: { :id
	પોતાનું id := id.
}.

Item જ્યારે: ['id'] કરો: { <- પોતાનું id. }.


Item જ્યારે: ['લખાણમાં'] કરો: {
	>> str := ['Item#~no'].
	str ~no: પોતાનું id. <- str.
}.


>> Print := વસ્તુ નવું.

Print જ્યારે: ['items'] કરો: { 
	
	પોતાનું item := Item નવું: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: પોતાનું item
	).
	
	
}.

Print items.