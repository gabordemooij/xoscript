Lenaneo taolo-ea-mohopolo: 4.

>> Doubler := Ntho ncha.
>> Multiplier := Ntho ncha.
Doubler ha-ho-fihla: ['double:and:'] etsa: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier ha-ho-fihla: ['multiply:and:'] etsa: { :x :y <- (x × y).
}.

Sephetho ngola: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), mola-o-mocha.
