>> Greeter := Ntho ncha.
Greeter ha-ho-fihla: ['make'] etsa: {
	>> gr := Ntho ncha.
	gr ha-ho-fihla: ['setName:'] etsa: { :aname
		ea-hao lebitso := aname.
	}.
	gr ha-ho-fihla: ['greet'] etsa: {
		Sephetho ngola: ea-hao lebitso.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a ncha.
c setName: ['THREE'].
c greet.
>> d := a ncha.
d setName: ['FOUR'].
d greet.
c greet.
