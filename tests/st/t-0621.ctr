>> phrases := Lethathamo ncha
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases e-ngoe-le-e-ngoe: { :_ :phrase 
	>> e := Server base64-kenya-khoutu: phrase.
	>> d := Server base64-ntsha-khoutu: e.
	Sephetho ngola: (
		message kopitsa ~encoded: e, ~decoded: d
	), mola-o-mocha.
}.
