#OBSD
>> dirname := [''].
{ dirname eketsa-qetellong: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Lenaneo sistimi: command.
Lenaneo chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename eketsa-qetellong: ['YYYYYYYY']. } * 20.
Faele ncha: filename, ngola: ['sometext'].
{ Faele letoto: ['/tmp/'] + dirname. } * 1000.
Sephetho ngola: ['no crash'], mola-o-mocha.

