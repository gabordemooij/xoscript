# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Polokelo-e-sireletsehileng etsa-linotlolo.

# private (secret) key
>> sk := keys ea-pele.

# public key
>> pk := keys ea-ho-qetela.

# sign a message
>> sig := Polokelo-e-sireletsehileng saena: ['abc'] ka: sk.

# check message (ok)
Sephetho ngola: ( 
	Polokelo-e-sireletsehileng
		hlahloba: ['abc'] 
		tshaeno: sig 
		ka: pk 
), mola-o-mocha.

# check message (fail)
Sephetho ngola: ( 
	Polokelo-e-sireletsehileng 
		hlahloba: ['abd'] 
		tshaeno: sig 
		ka: pk 
), mola-o-mocha.