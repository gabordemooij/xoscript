# from:length: counts characters and survives very large numbers
>> s := ['ééééééééééééééé'].
Sephetho ngola: (s kopitsa ho-tloha: 0 bolelele: 20), mola-o-mocha.
Sephetho ngola: (s kopitsa ho-tloha: 10 bolelele: 20), mola-o-mocha.
Sephetho ngola: (s kopitsa ho-tloha: 14 bolelele: 1), mola-o-mocha.
Sephetho ngola: (s kopitsa tlola: 20), mola-o-mocha.
Sephetho ngola: ['-'], mola-o-mocha.
Sephetho ngola: (['abcdef'] ho-tloha: 2 bolelele: 2), mola-o-mocha.
Sephetho ngola: (['abc'] ho-tloha: 1 bolelele: ['9e300'] palo), mola-o-mocha.
Sephetho ngola: (['abc'] ho-tloha: 1 bolelele: ['-9e300'] palo), mola-o-mocha.
Sephetho ngola: (['abc'] ho-tloha: ['9e300'] palo bolelele: 1), mola-o-mocha.
Sephetho ngola: ['-'], mola-o-mocha.
Sephetho ngola: (['abc'] ho-tloha: ['-9e300'] palo bolelele: 2), mola-o-mocha.
Sephetho ngola: (['abc'] ho-tloha: ['nan'] palo bolelele: 2), mola-o-mocha.
Sephetho ngola: (['abc'] ho-tloha: 0 bolelele: ['nan'] palo), mola-o-mocha.
Sephetho ngola: ['-'], mola-o-mocha.
