60 × {
	>> x := (Palo random % 6) + 1.
	(x ≤ 6) leshano: { Sephetho ngola: ['FAIL']. }.
	(x ≥0) leshano: { Sephetho ngola: ['FAIL']. }.
	x := (Palo random % 3) + 1.
	(x < 3) leshano: { Sephetho ngola: ['FAIL']. }.
	(x>-1) leshano: { Sephetho ngola: ['FAIL']. }.
	x := ((Bulione flip) palo).
	(x = 0 kapa: x = 1) leshano: { Sephetho ngola: ['FAIL']. }.
	x := ((Nnete flip) palo).
	(x = 0 kapa: x = 1) leshano: { Sephetho ngola: ['FAIL']. }.
	x := (Bulione flip ena: ['HEAD'] kapa-eane: ['TAIL']).
	((x = ['HEAD']) kapa: (x = ['TAIL'])) leshano: { Sephetho ngola: ['FAIL']. }.
}.
Sephetho ngola: ['DONE'].

