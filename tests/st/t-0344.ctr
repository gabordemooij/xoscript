# catch-all test (practical)
>> HTML := Mongolo ncha.
HTML ha-ho-fihla: ['encode:'] etsa: { :tekst
	uena eketsa-qetellong: (tekst
	nkela-sebaka: ['&'] ka: ['&amp;'], 
	nkela-sebaka: ['<'] ka: ['&lt;'],
	nkela-sebaka: ['>'] ka: ['&gt;'],
	nkela-sebaka: ['"'] ka: ['&quot;']).
}.
>> blog := HTML ncha.
blog eketsa-qetellong: ['<h1>'],
     encode: ['Koffie & Thee'],
     eketsa-qetellong: ['</h1>'].
Sephetho ngola: blog, mola-o-mocha.


>> Roman := Palo ncha.
Roman ha-ho-fihla: ['stringy'] etsa: {
	>> a := [''].
	{ a eketsa-qetellong: ['I']. } × uena. <- a.
}.

>> x := Roman ncha.
x eketsa: 3.
Sephetho ngola: x stringy, mola-o-mocha.

>> Quantum := Bulione ncha.
Quantum ha-ho-fihla: ['true?'] etsa: { <- ['maybe True']. }.
Sephetho ngola: (Quantum ncha true?), mola-o-mocha.

>> Nihil := Letho ncha.
Nihil ha-ho-fihla: ['mongolo'] etsa: { <- ['Nihil']. }.
Sephetho ngola: (Nihil ncha), mola-o-mocha.
