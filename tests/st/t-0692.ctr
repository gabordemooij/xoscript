Server init.

Sephetho ngola: (
	Paterone ncha: ['^\\w+$'],
	tumellano: ['test@example.com'] 
), mola-o-mocha. # 0 match, fails on @ and .

Sephetho ngola: (
	Paterone ncha: ['^[^@]+@[^\.]+\.\\w+$'],
	tumellano: ['test@example.com'] 
), mola-o-mocha. # 1 match

Sephetho ngola: (
	Paterone ncha: ['[^@]+@[^\.]+\.\\w+'],
	tumellano: ['test@example.com'] 
), mola-o-mocha. # 1 match

Sephetho ngola: (
	Paterone ncha: ['([^@]+)@([^\.]+)\.\\w+'],
	tumellano: ['test@example.com'] 
), mola-o-mocha. # 1 match, groups dont matter

Sephetho ngola: (
	Paterone ncha: ['[a-z]'],
	tumellano: ['test@example.com'] 
), mola-o-mocha. # 14 matches

Sephetho ngola: (
	Paterone ncha: ['.*'],
	tumellano: ['test@example.com'] 
), mola-o-mocha. # 1 match (all)

Sephetho ngola: (
	Paterone ncha: ['(.*)'],
	tumellano: ['test@example.com'] 
), mola-o-mocha. # 1 match (all)

Sephetho ngola: (
	Paterone ncha: ['\\s*[^@]+@[^\.]+\.\\w+'],
	tumellano: ['test@example.com'] 
), mola-o-mocha. # 1 match, prefix space optional, gets ignored