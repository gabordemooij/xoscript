Sephetho ngola: ['Test object'], mola-o-mocha.
>> p := Tsela /tmp.
Sephetho ngola: p, mola-o-mocha.
>> old-p-address := p mohlala-oa-pele aterese-ea-mohopolo.
p save-as: ['/tmp/a.bin'].
Sephetho ngola: ['========== RELOADING SNAP:'], mola-o-mocha.
>> b := Ntho load-from: ['/tmp/a.bin'].
(b mohlala-oa-pele aterese-ea-mohopolo = old-p-address) nnete: {
	Sephetho ngola: ['Object link re-attached.'], mola-o-mocha.
}.
Sephetho ngola: b, mola-o-mocha.
