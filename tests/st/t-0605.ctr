>> invoice := Ntho ncha.
invoice ha-ho-fihla: ['qala'] etsa: {
        ea-hao palo := 0.
}.

invoice ha-ho-fihla: ['palo'] etsa: {
        ea-hao palo eketsa: 1. <- ea-hao palo kopitsa.
}.

>> year-invoice := invoice ncha.
year-invoice ha-ho-fihla: ['start:'] etsa: { :selemo
	ea-hao palo := selemo.
}.

year-invoice start: 202000.
Sephetho ngola: year-invoice palo, mola-o-mocha.
Sephetho ngola: year-invoice palo, mola-o-mocha.
