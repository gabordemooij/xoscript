['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Sephetho ngola: (x + y), mola-o-mocha.

>> x := 10040.07.
>> y := 10305.60.

Sephetho ngola: (x + y), mola-o-mocha.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Sephetho ngola: (x + y + z), mola-o-mocha.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Sephetho ngola: (x + y + z), mola-o-mocha.

>> q := 0.1.2.

Sephetho ngola: (q), mola-o-mocha.

>> q := 012.

Sephetho ngola: (q), mola-o-mocha.
