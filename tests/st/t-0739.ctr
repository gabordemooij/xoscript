Sephetho ngola: ['Test object'], mola-o-mocha.
>> a := Ntho ncha. 

a ha-ho-fihla: ['item:'] etsa: { :binhelper
	ea-hao binhelper := binhelper. 
}.

a ha-ho-fihla: ['item'] etsa: { <- ea-hao binhelper.
}.

a item: Bin ncha.

>> old-binhelper-address := a item mohlala-oa-pele aterese-ea-mohopolo.
a save-as: ['/tmp/a.bin'].
Sephetho ngola: ['========== RELOADING SNAP:'], mola-o-mocha.

>> b := Ntho load-from: ['/tmp/a.bin'].

(b item mohlala-oa-pele aterese-ea-mohopolo = old-binhelper-address) nnete: {
	Sephetho ngola: ['Object link re-attached.'], mola-o-mocha.
}.


