Palo ha-ho-fihla: ['factorial'] etsa: {
	>> total := 1.
	{ :index total ngata-ka: (uena - index). } × uena. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Lenaneo taolo-ea-mohopolo: 0.

{
2 exponent factorial.
Sephetho ngola: (11 masalla: 3), mola-o-mocha.
Sephetho ngola: (3.4 atametsa-palo), mola-o-mocha.
Sephetho ngola: (7.1 nyolla-palo), mola-o-mocha.
Sephetho ngola: (7.9 theola-palo), mola-o-mocha.
}
qala.

Lenaneo hloekisa.

usedMemory1 := (Lenaneo mohopolo ? 0).

{
2 exponent factorial.
Sephetho ngola: (11 masalla: 3), mola-o-mocha.
Sephetho ngola: (3.4 atametsa-palo), mola-o-mocha.
Sephetho ngola: (7.1 nyolla-palo), mola-o-mocha.
Sephetho ngola: (7.9 theola-palo), mola-o-mocha.
}
qala.

Lenaneo hloekisa.
usedMemory2 := (Lenaneo mohopolo ? 0).


{
2 exponent factorial.
Sephetho ngola: (11 masalla: 3), mola-o-mocha.
Sephetho ngola: (3.4 atametsa-palo), mola-o-mocha.
Sephetho ngola: (7.1 nyolla-palo), mola-o-mocha.
Sephetho ngola: (7.9 theola-palo), mola-o-mocha.
} qala.

Lenaneo hloekisa.
usedMemory3 := (Lenaneo mohopolo ? 0).



( usedMemory1 = usedMemory2 le: usedMemory1 = usedMemory3, le: usedMemory2 = usedMemory3 ) nnete: {
	Sephetho ngola: ['No memory leaks here'].
}, leshano: {
	Sephetho ngola: ['Leaking memory...'].
}.
