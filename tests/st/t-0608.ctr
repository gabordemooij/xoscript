
>> Size := Ntho ncha.
Size ha-ho-fihla: ['is:'] etsa: { :palo
	palo ha-ho-fihla: ['+'] etsa: { :palo
		>> unit := palo yuniti-ea-palo.
		>> factor := 1.
		
		unit
		haeba: ['inch'] etsa: { factor := 0.0833. }. <- uena + (palo * factor).
	}. <- palo.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Sephetho ngola: plank + edge, mola-o-mocha.
