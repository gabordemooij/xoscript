#Linux
>> clock := Motsotso-nako ncha.
clock sebaka-sa-nako: ['UTC-1'].
clock selemo: 1981, khoeli: 1, letsatsi: 5,
      hora: 13, motsotso: 15, motsotsoana: 13.

Sephetho ngola: clock, mola-o-mocha.
clock sebaka-sa-nako: ['UTC+0'].

Sephetho ngola: (
	(clock selemo e-bonolo) + ['-'] + (clock khoeli) + ['-'] + (clock letsatsi) + [' '] +
	(clock hora) + [':'] + (clock motsotso) + [':'] + (clock motsotsoana) + [' '] +
	['W'] + (clock beke) + (clock sebaka-sa-nako)
), mola-o-mocha.


clock sebaka-sa-nako: ['UTC-1'].
Sephetho ngola: (
	(clock selemo e-bonolo) + ['-'] + (clock khoeli) + ['-'] + (clock letsatsi) + [' '] +
	(clock hora) + [':'] + (clock motsotso) + [':'] + (clock motsotsoana) + [' '] +
	['W'] + (clock beke) + (clock sebaka-sa-nako)
), mola-o-mocha.
