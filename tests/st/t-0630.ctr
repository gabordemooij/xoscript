#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Paterone ncha: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern tumellano: subject etsa: { :m :x
	Sephetho ngola: m, mola-o-mocha.
	Sephetho ngola: x, mola-o-mocha. <- ['XXX'].
}.
Sephetho ngola: result, mola-o-mocha.