#Linux
>> Slurp := Ntho ncha.

Slurp ha-ho-fihla: ['ncha'] etsa: {
	ea-hao str := [''].
}.

Slurp ha-ho-fihla: ['nieuw'] etsa: {
	ea-hao str := [''].
}.

Slurp ha-ho-fihla: ['araba:'] etsa: { :blah
		ea-hao str eketsa-qetellong: blah.
}.

Slurp ha-ho-fihla: ['araba:le:'] etsa: { :blah :blahah
		ea-hao str eketsa-qetellong: (blah ho-tloha: 0 bolelele: (blah bolelele - 1)).
		ea-hao str eketsa-qetellong: [' '].
		ea-hao str eketsa-qetellong: blahah.
}.

Slurp ha-ho-fihla: ['obtain'] etsa: {
	>> buffer := ea-hao str.
	ea-hao str := ['']. <- buffer.
}.


Sephetho ngola: (Lenaneo sistimi: (Slurp ncha echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Faele ncha: ['/tmp/from.txt'], hlakola. } tšoasa: { ['Empty']. }, qala.
{ Faele ncha: ['/tmp/to.txt'], hlakola. } tšoasa: { ['Empty']. }, qala.


Faele ncha: ['/tmp/to.txt'], e-teng leshano: {
	Sephetho ngola: ['Confirmed. Target file does not exist.\
'].
}.
Faele ncha: ['/tmp/from.txt'], e-teng leshano: {
	Sephetho ngola: ['Confirmed. Source file does not exist.\
'].
}.



Lenaneo sistimi: (Slurp ncha touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Lenaneo sistimi: (Slurp ncha cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Faele ncha: ['/tmp/to.txt'], e-teng nnete: {
	Sephetho ngola: ['Confirmed. Target file has been created by shell.\
'].
}.


Sephetho ngola: ['Contents of file is:'] + (Faele ncha: ['/tmp/to.txt'], bala), mola-o-mocha.
