

>> Matryoshka := Ntho ncha.
Matryoshka ha-ho-fihla: ['double:'] etsa: { :secret
	ea-hao secret := secret × 2.
}.
Matryoshka ha-ho-fihla: ['ncha:'] etsa: { :secret
	>> answer := Letho.
	>> t := (secret > 255).
	Sephetho ngola: (secret + [' | '] + t), mola-o-mocha.
	t nnete: {
		answer := secret.
	}, ho-seng-joalo: {
		answer := Matryoshka ipheta ncha: (uena double: secret).
	}. <- answer.
}.

>> x := Matryoshka ncha: 2.
