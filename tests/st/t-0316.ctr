>> Grandfather := Ntho ncha.
Grandfather ha-ho-fihla: ['greet'] etsa: {
	Sephetho ngola: ['Ave!'], mola-o-mocha.
}.
>> Father := Grandfather ncha.
Father ha-ho-fihla: ['greet'] etsa: {
	Sephetho ngola: ['Hello'], mola-o-mocha.
	uena greet.
}.
>> Son := Father ncha.
Son ha-ho-fihla: ['greet'] etsa: {
	Sephetho ngola: ['Hi'], mola-o-mocha.
	uena greet.
}.

Son greet.

>> Roundabout := Ntho ncha.
Roundabout ha-ho-fihla: ['circle:'] etsa: { :x
	Sephetho ngola: x, mola-o-mocha.
	(x < 3) nnete: { uena ipheta circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) nnete: { Sephetho ngola: x, mola-o-mocha. x eketsa: 1.  increment qala. }. }.
increment qala.