#Linux
>> OS := Lenaneo tlhophiso: ['OS'].

>> clock := Motsotso-nako ncha.
	
(OS = ['Haiku']) nnete: {
	clock sebaka-sa-nako: ['CET'],
	selemo: 2017, khoeli: 7, letsatsi: 13,
	hora: 18, motsotso: 0, motsotsoana: 0.
}, ho-seng-joalo: {
	clock sebaka-sa-nako: ['Europe/Amsterdam'],
	selemo: 2017, khoeli: 7, letsatsi: 13,
	hora: 18, motsotso: 0, motsotsoana: 0.
}.

clock ha-ho-fihla: ['tell'] etsa: {
	Sephetho ngola: uena, mola-o-mocha.
}.


clock eketsa: 2    hora, tell.
clock eketsa: 1    hora, tell.
clock eketsa: 19 motsotso, tell.
clock eketsa: 1  motsotso, tell.
clock eketsa: 1  motsotso, tell.
clock eketsa: 19 motsotsoana, tell.
clock eketsa: 1  motsotsoana, tell.
clock eketsa: 1  motsotsoana, tell.
clock eketsa: 2    selemo, tell.
clock eketsa: 1    selemo, tell.

(OS = ['Haiku']) nnete: {
clock eketsa: 5   khoeli.
clock sebaka-sa-nako: ['CEST'], tell.
}, ho-seng-joalo: {
	clock eketsa: 5   khoeli, tell.
}.

clock eketsa: 1   khoeli, tell.
clock eketsa: 19    letsatsi, tell.
clock eketsa: 1    hora, tell.
clock eketsa: 120  yard, tell.
