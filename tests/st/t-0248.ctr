

Mongolo ha-ho-fihla: ['evaluate'] etsa: {
	>> khoutu := Faele ncha: ['/tmp/eval.ctr'].
	khoutu ngola: uena mongolo + ['.'].
	Lenaneo sebelisa: ['/tmp/eval.ctr'].
}.

>> a := (Lethathamo ← (
	(Bukantswe ncha)
		beha: ['domain'] sebakeng: ['mywebsite.com'],
		beha: (Lethathamo ←
			((Bukantswe ncha)
				beha: ['home'] sebakeng: ['title'],
				beha: ['<html></html>'] sebakeng: ['body'],
				beha: ['2017-01-01'] sebakeng: ['created']
			) ;
			((Bukantswe ncha)
				beha: ['aboutus(c)'] sebakeng: ['title'],
				beha: ['<credits>Author Inc.</credits>'] sebakeng: ['body']
			)
		) sebakeng: ['pages']
	)
) mongolo.

Sephetho ngola: a mofuta, mola-o-mocha.
Sephetho ngola: a, mola-o-mocha.

>> b := Letho.
(['b := '] + a) evaluate.
Sephetho ngola: b ? 0 ? ['pages'] ? 1 ? ['body'], mola-o-mocha.

>> c := b ? 0.
>> d := c mongolo.
Sephetho ngola: d mofuta, mola-o-mocha.

>> e := Letho.
(['e := '] + d) evaluate.
Sephetho ngola: e ? ['pages'] ? 0, mola-o-mocha.
