


>> Deck := Lethathamo ncha.
Deck ha-ho-fihla: ['print'] etsa: {
        >> len := uena palo-ea-lintho - 1.
        { :i
                >> len2 := uena palo-ea-lintho - 1.
                Sephetho ngola: ['len: '].
                Sephetho ngola: len, mola-o-mocha.
                Sephetho ngola: ['len2: '].
                Sephetho ngola: len2, mola-o-mocha.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
