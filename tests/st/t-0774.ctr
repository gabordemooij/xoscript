Sephetho ngola: ['Test object'], mola-o-mocha.
>> a := Ntho ncha. 
a ha-ho-fihla: ['item:'] etsa: { :lst
	ea-hao lst := lst. 
}.
a ha-ho-fihla: ['item'] etsa: { <- ea-hao lst.
}.
a item: (
	Lethathamo ncha ; 1 ; (
		Lethathamo ncha ; ['a'] ; (
			Lethathamo ncha ; ( Motsotso-nako ncha: 1 )
		) ; ( Int64 ho-tsoa-mongolong: ['321'] )
	)
).
Sephetho ngola: a item, mola-o-mocha.
>> old-lst-address := a item mohlala-oa-pele aterese-ea-mohopolo.
a save-as: ['/tmp/a.bin'].
Sephetho ngola: ['========== RELOADING SNAP:'], mola-o-mocha.
>> b := Ntho load-from: ['/tmp/a.bin'].
(b item mohlala-oa-pele aterese-ea-mohopolo = old-lst-address) nnete: {
	Sephetho ngola: ['Object link re-attached.'], mola-o-mocha.
}.
Sephetho ngola: ( b item ), mola-o-mocha.
