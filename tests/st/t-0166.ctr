

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Lenaneo taolo-ea-mohopolo: 0.

{
>> q := ['You should be able'].
q eketsa-qetellong: ([' to append something to a string']+['!']).
Sephetho ngola: q.
} qala.

Lenaneo hloekisa.
usedMemory1 := (Lenaneo mohopolo ? 0).


