Sephetho ngola: ['Continue for-loop, No - before 6 and up.'], mola-o-mocha.
{ :i
	Sephetho ngola: (i + 1), mola-o-mocha.
	((i + 1) > 4) tswela-pele.
	Sephetho ngola: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Sephetho mola-o-mocha.
Sephetho ngola: ['Continue while-true, No --> before 5 and up.'], mola-o-mocha.
{
	Sephetho ngola: ['iteration #'] + x, mola-o-mocha.
	x eketsa: 1.
	((x < 5) eseng) tswela-pele.
	Sephetho ngola: ['-->'].
} ha-feela: xIsLessThan10.
Sephetho mola-o-mocha.
Sephetho ngola: ['Continue while-false, No - before 3 only.'], mola-o-mocha.
{
	Sephetho ngola: ['iteration #'] + x, mola-o-mocha.
	x tlosa: 1.
	(x = 3) tswela-pele.
	Sephetho ngola: ['-'].
} ha-feela: { <- ( x > 0). }.

Sephetho mola-o-mocha.
Sephetho ngola: ['Continue times-loop, No ||| before 3.'], mola-o-mocha.
{ :i
	Sephetho ngola: ['iteration #'] + i, mola-o-mocha.
	(i = 2) tswela-pele.
	Sephetho ngola: ['|||'].
} × 5.

Sephetho mola-o-mocha.

{ Nnete tswela-pele. Sephetho ngola: ['dont write this!'], mola-o-mocha. } qala.

{ Nnete tswela-pele. Sephetho ngola: ['dont write this!'], mola-o-mocha. } tšoasa: { Sephetho ngola: ['Dont catch this!']. }, qala.

Sephetho ngola: ['Test Array each-loop: 0, ... ,2'], mola-o-mocha.
(Lethathamo ← 1 ; 2 ; 3) fetola-e-ngoe-le-e-ngoe: { :i
	(i = 1) tswela-pele.
	Sephetho ngola: ['iteration #'] + (i - 0), mola-o-mocha.
}.

Sephetho ngola: ['Test Map each-loop: c only'], mola-o-mocha.
>> m := Bukantswe ncha.
m beha: ['first'] sebakeng: ['a'], beha: ['second'] sebakeng: ['b'], beha: ['third'] sebakeng: ['c'].
m e-ngoe-le-e-ngoe: { :k :v
	(k ≠ ['c']) tswela-pele.
	Sephetho ngola: ['iteration'] + k + v, mola-o-mocha.
}.

