Mongolo ha-ho-fihla: ['evaluate'] etsa: {
	>> khoutu := Faele ncha: ['/tmp/eval.ctr'].
	khoutu ngola: (uena mongolo + ['.']).
	Lenaneo sebelisa: ['/tmp/eval.ctr'].
}.

>> a := Lethathamo ← 1 ; 2 ; 3.
>> b := (a mongolo).

Sephetho ngola: b, mola-o-mocha. 
(['b := '] + b) evaluate.

Sephetho ngola: b ? 2, mola-o-mocha. 

Sephetho ngola: (( Lethathamo ← 1 ; 2 ; 3 )), mola-o-mocha. 

Sephetho ngola: ((Bukantswe ncha) beha: 1 sebakeng: 2), mola-o-mocha. 

>> x := ( (Lethathamo ← 1 ; ( Lethathamo ← 9 ) ; Nnete ) ) mongolo.
Sephetho ngola: x, mola-o-mocha. 
(['x := '] + x) evaluate.

Sephetho ngola: x ? 1 ? 0, mola-o-mocha. 

>> y := (Bukantswe ncha) beha: (Lethathamo ← 1) sebakeng: (Lethathamo ← 2).
Sephetho ngola: y, mola-o-mocha. 

(['y := '] + y) mongolo evaluate.

Sephetho ngola: (y sebakeng: (Lethathamo ← 2) mongolo ), mola-o-mocha.

Sephetho ngola: (Lethathamo ncha), mola-o-mocha. 
Sephetho ngola: (Bukantswe ncha), mola-o-mocha. 
