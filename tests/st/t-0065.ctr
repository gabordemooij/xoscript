Palo ha-ho-fihla: ['factorial'] etsa: {
	>> total := 1.
	{ :index total ngata-ka: (uena - (index)). } × uena. <- total.
}.
>> Printer := Ntho ncha.
Printer ha-ho-fihla: ['print:and:'] etsa: { :x :y
	Sephetho ngola: ['a='] + x + [', b='] + y, mola-o-mocha.
}.
>> a := 4.5. >> b := a theola-palo.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a nyolla-palo.
Printer print: a and: b.
a := 4.5. b := a theola-palo.
Printer print: a and: b.
a := 4.5. b := a atametsa-palo.
Printer print: a and: b.
a := 4.2. b := a atametsa-palo.
Printer print: a and: b.

Sephetho ngola: (9 masalla: 5), mola-o-mocha.
Sephetho ngola: -666 boleng-bo-felletseng, mola-o-mocha.
Sephetho ngola: 49 motso-oa-sekwere, mola-o-mocha.
Sephetho ngola: (2 matla-a-palo: 3), mola-o-mocha.
>> l := (Lethathamo ← 9 ; 6).
Sephetho ngola: l e-nyane-ka-ho-fetisisa.

