

Mongolo ha-ho-fihla: ['evaluate'] etsa: {
	>> khoutu := Faele ncha: ['/tmp/eval.ctr'].
	khoutu ngola: (uena mongolo + ['.']).
	Lenaneo sebelisa: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Lethathamo ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q mongolo.
Sephetho ngola: x, mola-o-mocha.
>> y := Letho.
(['y := '] + x ) evaluate.
Sephetho ngola: y ? 0, mola-o-mocha.

q := Bukantswe beha: ['\[''] sebakeng: ['\['quote\']'].
x := q mongolo.
Sephetho ngola: x, mola-o-mocha.
y := Letho.
(['y := '] + x ) evaluate.

>> q := (Bukantswe ncha) beha:['\[''] sebakeng:['\['quote\[''].
Sephetho ngola: y ? ['\['quote\']'], mola-o-mocha.
