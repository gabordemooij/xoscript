# test qualifiers

Lenaneo hloekisa.

>> Fruit := Ntho ncha.
Fruit ha-ho-fihla: ['ncha'] etsa: {
	>> f := uena ncha.
	f apples: 0. <- f.
}.
Fruit ha-ho-fihla: ['apples:'] etsa: { :a ea-hao apples := a. }.
Fruit ha-ho-fihla: ['apples'] etsa: { <- ea-hao apples. }.
Fruit ha-ho-fihla: ['+'] etsa: { :f
	>> n := Fruit ncha.
	n apples: (f apples + ea-hao apples). <- n.
}.
Palo ha-ho-fihla: ['apples'] etsa: { <- ((Fruit ncha) apples: uena).
}.

Fruit ha-ho-fihla: ['mongolo'] etsa: { <- ea-hao apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Sephetho ngola: q, mola-o-mocha.




q := 3 apples + 4 apples.
Sephetho ngola: q, mola-o-mocha.



q := 3 apples + 4 apples.
Sephetho ngola: q, mola-o-mocha.


