Sephetho ngola: ['Test object'], mola-o-mocha.
>> a := Ntho ncha. 
a ha-ho-fihla: ['item:'] etsa: { :int64
	ea-hao int64 := int64. 
}.
a ha-ho-fihla: ['item'] etsa: { <- ea-hao int64.
}.
a item: ( Int64 ho-tsoa-mongolong: ['9999'] ).
Sephetho ngola: a item, mola-o-mocha.
>> old-int64-address := a item mohlala-oa-pele aterese-ea-mohopolo.
a save-as: ['/tmp/a.bin'].
Sephetho ngola: ['========== RELOADING SNAP:'], mola-o-mocha.
>> b := Ntho load-from: ['/tmp/a.bin'].
(b item mohlala-oa-pele aterese-ea-mohopolo = old-int64-address) nnete: {
	Sephetho ngola: ['Object link re-attached.'], mola-o-mocha.
}.
Sephetho ngola: ( b item ), mola-o-mocha.
