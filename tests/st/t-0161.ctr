Lenaneo taolo-ea-mohopolo: 0.
Lethathamo ha-ho-fihla: ['sum'] etsa: {
	>> total := 0.
	uena e-ngoe-le-e-ngoe: { :index :element
		total eketsa: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Faele ncha: ['/tmp/test.txt'].
f ngola: ['Lorem Ipsum'].
f koala.
  

f := Faele ncha: ['/tmp/test.txt'].
>> text := f bala.
f koala.



Lenaneo hloekisa.
usedMemory1 := (Lenaneo mohopolo ? 1).



f := Faele ncha: ['/tmp/test.txt'].
text := f bala.
f koala.

Lenaneo hloekisa.
usedMemory2 := (Lenaneo mohopolo ? 1).


f := Faele ncha: ['/tmp/test.txt'].
text := f bala.
f koala.

Lenaneo hloekisa.
usedMemory3 := (Lenaneo mohopolo ? 1).



( usedMemory1 = usedMemory2 le: usedMemory1 = usedMemory3, le: usedMemory2 = usedMemory3 ) nnete: {
	Sephetho ngola: ['No memory leaks here'].
}, leshano: {
	Sephetho ngola: ['Leaking memory...'].
}.
