>> t := Letho.

# you can control the time zone for
# parsing like this:
Motsotso-nako sebaka-sa-nako: ['CET'].
t := Motsotso-nako mohloli: ['1981-02-03 04:05:06'].
Sephetho ngola: t, mola-o-mocha.

# now using CEST time zone:
Motsotso-nako sebaka-sa-nako: ['CEST'].
t := Motsotso-nako mohloli: ['1981-02-03 04:05:06'].
Sephetho ngola: t, mola-o-mocha.

# error if string cannot be parsed
{ Motsotso-nako mohloli: ['1900']. } tšoasa: { Letho. }, qala.
