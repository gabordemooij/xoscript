Server init.

>> DB := Maria-DB ncha moamoheli: ['localhost'],
	lebitso-la-mosebelisi: ['xo'],
	phasewete: ['pass123'],
	lebitso-la-database: ['xobase'],
	hokela.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB potso: SQL.

# now you don't have to set DB
query2 lata: { :row
	Sephetho ngola: row world, mola-o-mocha.
}.
