>> winery := { <- (	Bukantswe ncha
		beha: 2 sebakeng: ['merlot'],
		beha: 3 sebakeng: ['malbec'],
		beha: 4 sebakeng: ['syrah']
	).
}.

Sephetho ngola: (((winery qala) - ['nothing']) palo-ea-lintho), mola-o-mocha.
Sephetho ngola: (((winery qala) - ['merlot']) palo-ea-lintho), mola-o-mocha.
Sephetho ngola: (((winery qala) - ['malbec']) palo-ea-lintho), mola-o-mocha.
Sephetho ngola: (((winery qala) - ['syrah']) palo-ea-lintho), mola-o-mocha.
Sephetho ngola: (((winery qala) - ['merlot'] - ['malbec']) palo-ea-lintho), mola-o-mocha.
Sephetho ngola: (((winery qala) - ['merlot'] - ['syrah']) palo-ea-lintho), mola-o-mocha.
Sephetho ngola: (((winery qala) - ['malbec'] -['syrah']) palo-ea-lintho), mola-o-mocha.
Sephetho ngola: (((winery qala) - ['malbec'] - ['syrah'] - ['merlot']) palo-ea-lintho), mola-o-mocha.

