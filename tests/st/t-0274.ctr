

Lethathamo ha-ho-fihla: ['column:'] etsa: { :column
	>> result := Lethathamo ncha.
	uena e-ngoe-le-e-ngoe: { :index :row
		row e-ngoe-le-e-ngoe: { :index :cell
			(index = column) nnete: { result eketsa-qetellong: cell. }.
		}.
	}. <- result.
}.


>> a := Lethathamo ←
	(Lethathamo ← 1 ; 2 ; 3) ;
	(Lethathamo ← 4 ; 5 ; 6) ;
	(Lethathamo ← 7 ; 8 ; 9).

>> b := a column: 1.
Sephetho ngola: b, mola-o-mocha.

b := a column: 20.
Sephetho ngola: b, mola-o-mocha.

b := a column: -100.
Sephetho ngola: b, mola-o-mocha.
