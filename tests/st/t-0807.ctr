# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB ncha moamoheli: ['localhost'],
	lebitso-la-mosebelisi: ['xo'],
	phasewete: ['pass123'],
	lebitso-la-database: ['xobase'],
	hokela.

>> liparamente-tsa-patlo := db potso: ['SELECT %% FROM'].
{ liparamente-tsa-patlo phetha. } tšoasa: { :e
	Sephetho ngola: ( e e-kenyelletsa: ['%%'] ), mola-o-mocha.
}, qala.
