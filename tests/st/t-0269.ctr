#Linux

(Faele ncha: ['/tmp/testje']) e-teng leshano: {
	Lenaneo sistimi: ['mkdir /tmp/testje'].	
}.

(Faele ncha: ['/tmp/testje/file1']) e-teng leshano: {
	Lenaneo sistimi: ['touch /tmp/testje/file1'].	
}.

(Faele ncha: ['/tmp/testje/folder1']) e-teng leshano: {
	Lenaneo sistimi: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Faele letoto: ['/tmp/testje'].

>> q := Lethathamo ncha.

l e-ngoe-le-e-ngoe: { :k :v v e-ngoe-le-e-ngoe: { :x :y q eketsa-qetellong: y. }. }.

>> s := q mongolo.

(s e-kenyelletsa: ['file1']) nnete:   { Sephetho ngola: ['OK'], mola-o-mocha. }.
(s e-kenyelletsa: ['file2']) nnete:   { Sephetho ngola: ['XX'], mola-o-mocha. }.
(s e-kenyelletsa: ['folder1']) nnete: { Sephetho ngola: ['OK'], mola-o-mocha. }.
