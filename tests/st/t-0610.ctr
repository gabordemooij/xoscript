
>> Rectangle := Ntho ncha.

Rectangle ha-ho-fihla: ['area'] etsa: { <- ea-hao bolelele * ea-hao width.
}.

Rectangle ha-ho-fihla: ['length:'] etsa: { :bolelele
	ea-hao bolelele := bolelele.
}.

Rectangle ha-ho-fihla: ['width:'] etsa: { :width
	ea-hao width := width.
}.

Rectangle ha-ho-fihla: ['ncha'] etsa: {
	# this will not result into an infinite loop
	>> rectangle := uena ncha.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle ncha.
Sephetho ngola: a area, mola-o-mocha. #0

>> b := Rectangle ncha length: 2, width: 3.
Sephetho ngola: b area, mola-o-mocha. #6

