Sephetho ngola: ['Test object'], mola-o-mocha.
>> a := Ntho ncha. 

a ha-ho-fihla: ['item:'] etsa: { :out
	ea-hao out := out. 
}.

a ha-ho-fihla: ['item'] etsa: { <- ea-hao out.
}.

a ha-ho-fihla: ['greet'] etsa: {
	Sephetho ngola: ['hi from original out!'], mola-o-mocha.
}.

a item: Sephetho.

Sephetho ngola: a item, mola-o-mocha.

>> old-out-address := a item mohlala-oa-pele aterese-ea-mohopolo.
a save-as: ['/tmp/a.bin'].
Sephetho ngola: ['========== RELOADING SNAP:'], mola-o-mocha.

>> b := Ntho load-from: ['/tmp/a.bin'].

(b item mohlala-oa-pele aterese-ea-mohopolo = old-out-address) nnete: {
	Sephetho ngola: ['Object link re-attached.'], mola-o-mocha.
}.

b item ngola: ['hello from loaded out!'], mola-o-mocha.
b greet.
