# a quote that never closes must give an error, not an endless loop
>> tsela-ea-faele := ['/tmp/test0821.csv'].
>> file := Faele ncha: tsela-ea-faele.

file ngola: ['a,b\n"1,2\n'].
{
	file searoli: [','] letšoao-la-qotso: ['"'] mela: { :line
		Sephetho ngola: line, mola-o-mocha.
	}.
} tšoasa: { :e Sephetho ngola: e, mola-o-mocha. }, qala.

# a closed quote still works
file ngola: ['a,b\n"1,2",3'].
file searoli: [','] letšoao-la-qotso: ['"'] mela: { :line
	Sephetho ngola: line, mola-o-mocha.
}.
file hlakola.
