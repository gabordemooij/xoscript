Palo ha-ho-fihla: ['roman'] etsa: {
	>> palo := uena kopitsa.
	>> roman := [''].
	{
		{
			(palo ≥ 1000) nnete: {
				roman eketsa-qetellong: ['Ⅿ'].
				palo tlosa: 1000.
			}, khaola.
		
			(palo ≥ 500) nnete: {
				roman eketsa-qetellong: ['Ⅾ'].
				palo tlosa: 500.
			}, khaola.
		
			(palo ≥ 100) nnete: {
				roman eketsa-qetellong: ['Ⅽ'].
				palo tlosa: 100.
			}, khaola.
		
			(palo ≥ 50) nnete: {
				roman eketsa-qetellong: ['Ⅼ'].
				palo tlosa: 50.
			}, khaola.
		
			(palo ≥ 50) nnete: {
				roman eketsa-qetellong: ['Ⅼ'].
				palo tlosa: 50.
			}, khaola.
		
			(palo ≥ 10) nnete: {
				roman eketsa-qetellong: ['Ⅹ'].
				palo tlosa: 10.
			}, khaola.
			
			(palo ≥ 9) nnete: {
				roman eketsa-qetellong: ['Ⅸ'].
				palo tlosa: 9.
			}, khaola.
			
			(palo ≥ 5) nnete: {
				roman eketsa-qetellong: ['Ⅴ'].
				palo tlosa: 5.
			}, khaola.
			
			(palo ≥ 4) nnete: {
				roman eketsa-qetellong: ['Ⅳ'].
				palo tlosa: 4.
			}, khaola.
			
			(palo ≥ 1) nnete: {
				roman eketsa-qetellong: ['Ⅰ'].
				palo tlosa: 1.
			}, khaola.
		} tsamaiso.
	} ha-feela: { <- palo > 0. }. <- roman.
}.

Sephetho ngola: 1 roman, mola-o-mocha.
Sephetho ngola: 2 roman, mola-o-mocha.
Sephetho ngola: 4 roman, mola-o-mocha.
Sephetho ngola: 8 roman, mola-o-mocha.
Sephetho ngola: 16 roman, mola-o-mocha.
Sephetho ngola: 32 roman, mola-o-mocha.
Sephetho ngola: 64 roman, mola-o-mocha.
Sephetho ngola: 128 roman, mola-o-mocha.
Sephetho ngola: 256 roman, mola-o-mocha.
Sephetho ngola: 1024 roman, mola-o-mocha.
