
{ :i
	Sephetho ngola: ['This is step #'] + ( ( i ) + 1 ), mola-o-mocha.
} × 6.

{ :i
	Sephetho ngola: ['This is step #'] + ( 3 - ( i ) ), mola-o-mocha.
} × 6.

{ :i
	Sephetho ngola: ['NEVER!'], mola-o-mocha.
} × 0.



{ :i
	Sephetho ngola: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), mola-o-mocha.
} × 11.
