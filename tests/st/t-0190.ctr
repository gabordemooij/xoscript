#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Lenaneo taolo-ea-mohopolo: 0.

{
Motsotso-nako nako.
Motsotso-nako emela: 1.
Sephetho ngola: Lenaneo palo-ea-likenyo, mola-o-mocha.
Lenaneo kenyo: 0.
Palo random.
Sephetho ngola: (Lenaneo sistimi: ['echo 'Hello'']).
} qala.

Lenaneo hloekisa.
usedMemory1 := (Lenaneo mohopolo ? 0).

{
Motsotso-nako nako.
Motsotso-nako emela: 1.
Sephetho ngola: Lenaneo palo-ea-likenyo, mola-o-mocha.
Lenaneo kenyo: 0.
Palo random.
Sephetho ngola: (Lenaneo sistimi: ['echo 'Hello'']).
} qala.

Lenaneo hloekisa.
usedMemory2 := (Lenaneo mohopolo ? 0).

{
Motsotso-nako nako.
Motsotso-nako emela: 1.
Sephetho ngola: Lenaneo palo-ea-likenyo, mola-o-mocha.
Lenaneo kenyo: 0.
Palo random.
Sephetho ngola: (Lenaneo sistimi: ['echo 'Hello'']).
} qala.

Lenaneo hloekisa.
usedMemory3 := (Lenaneo mohopolo ? 0).



( usedMemory1 = usedMemory2 le: usedMemory1 = usedMemory3, le: usedMemory2 = usedMemory3 ) nnete: {
	Sephetho ngola: ['No memory leaks here'].
}, leshano: {
	Sephetho ngola: ['Leaking memory...'].
}.
