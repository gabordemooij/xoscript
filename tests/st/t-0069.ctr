

Mongolo ha-ho-fihla: ['html'] etsa: { <- (
		uena
		nkela-sebaka: ['&'] ka: ['&amp;'],
		nkela-sebaka: ['<'] ka: ['&lt;'],
		nkela-sebaka: ['>'] ka: ['&gt;'],
		nkela-sebaka: ['"'] ka: ['&quot;']
	).
}.


Sephetho ngola: ([' left trimmed '] khaola-likheo) + [' '] + ( ['and right trimmed'] khaola-likheo) + ['!'], mola-o-mocha.
Sephetho ngola: ['<html>"html & entities"</html>'] html.
