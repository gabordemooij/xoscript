

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Lenaneo taolo-ea-mohopolo: 0.

>> txt := ['World Salad'].
Sephetho ngola: ['this text contains: '] + ( ( txt arola: [' '] ) palo-ea-lintho ) + [' words.'], mola-o-mocha.
txt := txt ho-tloha: 6 bolelele: 4.
Sephetho ngola: txt, mola-o-mocha.

Lenaneo hloekisa.

usedMemory1 := (Lenaneo mohopolo ? 0).


txt := ['World Salad'].
Sephetho ngola: ['this text contains: '] + ( ( txt arola: [' '] ) palo-ea-lintho ) + [' words.'], mola-o-mocha.
txt := txt ho-tloha: 6 bolelele: 4.
Sephetho ngola: txt, mola-o-mocha.

Lenaneo hloekisa.
usedMemory2 := (Lenaneo mohopolo ? 0).


txt := ['World Salad'].
Sephetho ngola: ['this text contains: '] + ( ( txt arola: [' '] ) palo-ea-lintho ) + [' words.'], mola-o-mocha.
txt := txt ho-tloha: 6 bolelele: 4.
Sephetho ngola: txt, mola-o-mocha.

Lenaneo hloekisa.
usedMemory3 := (Lenaneo mohopolo ? 0).



( usedMemory1 = usedMemory2 le: usedMemory1 = usedMemory3, le: usedMemory2 = usedMemory3 ) nnete: {
	Sephetho ngola: ['No memory leaks here'].
}, leshano: {
	Sephetho ngola: ['Leaking memory...'].
}.
