>> randomizer := { :a :b
	>> e-nyane-ka-ho-fetisisa := ( a < b ) ena: a kapa-eane: b.
	>> e-kholo-ka-ho-fetisisa := ( a > b ) ena: a kapa-eane: b.
	>> x := Letho.
	{
		x := Palo pakeng-tsa: a le: b.
		((x < e-nyane-ka-ho-fetisisa) kapa: (x > e-kholo-ka-ho-fetisisa)) nnete: { 
			Sephetho ngola: (['Invalid value!']).
			Lenaneo qeta.
		}.
	} 
	× 100. <- x.
}.
randomizer sebelisa-ho: 0 le: 0.
randomizer sebelisa-ho: 1 le: 0.
randomizer sebelisa-ho: 1 le: 1.
randomizer sebelisa-ho: 0 le: 1.
randomizer sebelisa-ho: -1 le: 0.
randomizer sebelisa-ho: -1 le: -1.
randomizer sebelisa-ho: 0 le: -1.
randomizer sebelisa-ho: 100 le: 200.
randomizer sebelisa-ho: 999999999999998 le: 999999999999999.
randomizer sebelisa-ho: 999999999999999 le: 999999999999998.
randomizer sebelisa-ho: 999999999999999 le: 999999999999999.
randomizer sebelisa-ho: -999999999999998 le: -999999999999999.
randomizer sebelisa-ho: -999999999999999 le: -999999999999998.
randomizer sebelisa-ho: -999999999999999 le: -999999999999999.
randomizer sebelisa-ho: 999999999999998 le: -999999999999999.
randomizer sebelisa-ho: 999999999999999 le: -999999999999998.
randomizer sebelisa-ho: 999999999999999 le: -999999999999999.
