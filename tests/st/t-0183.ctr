

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Lenaneo taolo-ea-mohopolo: 0.

>> o := Ntho ncha.
>> o2 := Ntho ncha.
Sephetho ngola: o Letho?, mola-o-mocha.
Sephetho ngola: o mofuta, mola-o-mocha.
Sephetho ngola: ( o ea-tšoanang: o ), mola-o-mocha.
Sephetho ngola: ( o ea-tšoanang: o2 ), mola-o-mocha.
Sephetho ngola: o nna-ka-sebele, mola-o-mocha.
Sephetho ngola: ( o etsa ho-felile ), mola-o-mocha.

Lenaneo hloekisa.

usedMemory1 := (Lenaneo mohopolo ? 0).


o := Ntho ncha.
o2 := Ntho ncha.
Sephetho ngola: o Letho?, mola-o-mocha.
Sephetho ngola: o mofuta, mola-o-mocha.
Sephetho ngola: ( o ea-tšoanang: o ), mola-o-mocha.
Sephetho ngola: ( o ea-tšoanang: o2 ), mola-o-mocha.
Sephetho ngola: o nna-ka-sebele, mola-o-mocha.
Sephetho ngola: ( o etsa ho-felile ), mola-o-mocha.

Lenaneo hloekisa.
usedMemory2 := (Lenaneo mohopolo ? 0).


o := Ntho ncha.
o2 := Ntho ncha.
Sephetho ngola: o Letho?, mola-o-mocha.
Sephetho ngola: o mofuta, mola-o-mocha.
Sephetho ngola: ( o ea-tšoanang: o ), mola-o-mocha.
Sephetho ngola: ( o ea-tšoanang: o2 ), mola-o-mocha.
Sephetho ngola: o nna-ka-sebele, mola-o-mocha.
Sephetho ngola: ( o etsa ho-felile ), mola-o-mocha.

Lenaneo hloekisa.
usedMemory3 := (Lenaneo mohopolo ? 0).



( usedMemory1 = usedMemory2 le: usedMemory1 = usedMemory3, le: usedMemory2 = usedMemory3 ) nnete: {
	Sephetho ngola: ['No memory leaks here'].
}, leshano: {
	Sephetho ngola: ['Leaking memory...'].
}.
