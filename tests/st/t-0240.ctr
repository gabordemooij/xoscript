# test qualifiers

>> $ := Ntho ncha.

$ ha-ho-fihla: ['araba:'] etsa: { :x
	
	>> operation := x tlhaku: 0.
	>> valuta := x tlhaku: 1.
	>> money := x tlola: 2.
	
	>> amount := 0.

	( operation = ['+'] ) nnete: {
		( valuta = ['£'] ) nnete: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Sephetho ngola: x, mola-o-mocha.


>> Fruit := Ntho ncha.

Fruit ha-ho-fihla: ['ncha'] etsa: {
	>> f := uena ncha.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit ha-ho-fihla: ['apples:'] etsa: { :a ea-hao apples := a. }.
Fruit ha-ho-fihla: ['oranges:'] etsa: { :p ea-hao oranges := p. }.
Fruit ha-ho-fihla: ['apples'] etsa: { <- ea-hao apples. }.
Fruit ha-ho-fihla: ['oranges'] etsa: { <- ea-hao oranges. }.

Fruit ha-ho-fihla: ['+'] etsa: { :f
	
	>> n := Fruit ncha.
	f eketsa: 1.
	
	n apples: (f apples + ea-hao apples).
	n oranges:  (f oranges  + ea-hao oranges). <- n.
}.

Fruit ha-ho-fihla: ['mongolo'] etsa: { <- ( ea-hao apples mongolo + [' apples and '] + ea-hao oranges + [' oranges'] ).
}.

Palo ha-ho-fihla: ['apples'] etsa: { <- ((Fruit ncha) apples: uena).
}.

Palo ha-ho-fihla: ['apple'] etsa: { <- ((Fruit ncha) apples: uena).
}.

Palo ha-ho-fihla: ['oranges'] etsa: { <- ((Fruit ncha) oranges: uena).
}.




Sephetho ngola: (1 apple + 3 oranges + 4 apples), mola-o-mocha.


Mongolo ha-ho-fihla: ['twice'] etsa: { <- ((uena mongolo) + (uena mongolo)).
}.



Sephetho ngola: ['❤❤❤'] twice.



