Sephetho ngola: ['Test object'], mola-o-mocha.
>> a := Ntho ncha. 

a ha-ho-fihla: ['item:'] etsa: { :bulione
	ea-hao bulione := bulione. 
}.

a ha-ho-fihla: ['item'] etsa: { <- ea-hao bulione.
}.

a item: Nnete.

Sephetho ngola: a item, mola-o-mocha.

>> old-bool-address := a item mohlala-oa-pele aterese-ea-mohopolo.
a save-as: ['/tmp/a.bin'].
Sephetho ngola: ['========== RELOADING SNAP:'], mola-o-mocha.

>> b := Ntho load-from: ['/tmp/a.bin'].

(b item mohlala-oa-pele aterese-ea-mohopolo = old-bool-address) nnete: {
	Sephetho ngola: ['Object link re-attached.'], mola-o-mocha.
}.

Sephetho ngola: b item, mola-o-mocha.
