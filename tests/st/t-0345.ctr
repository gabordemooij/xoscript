# test catch-all methods
>> x13 := Ntho ncha.
x13 ha-ho-fihla: ['a'] etsa: { :a Sephetho ngola: 0, mola-o-mocha. }.
x13 ha-ho-fihla: ['a:'] etsa: { :a Sephetho ngola: a, mola-o-mocha. <- 5. }.
x13 ha-ho-fihla: ['a:b:'] etsa: { :a :b Sephetho ngola: (a + b), mola-o-mocha. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
