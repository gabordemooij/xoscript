# backslashes must survive code serialization, strings must not end early
>> boleng-bohle := Lethathamo ncha
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

boleng-bohle e-ngoe-le-e-ngoe: { :i :value
	>> d := Bukantswe ncha.
	d beha: value sebakeng: ['k'].
	>> r := d khoutu ntho.
	Sephetho ngola: r palo-ea-lintho, mola-o-mocha.
	Sephetho ngola: ( (r sebakeng: ['k']) = value ), mola-o-mocha.
}.
