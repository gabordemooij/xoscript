>> usedMemory3 := 0.
>> usedMemory4 := 0.

Lenaneo taolo-ea-mohopolo: 0.

>> f := Faele ncha: ['/tmp/citrine_test_file.txt'].
f exists: { f hlakola. }.
f ngola: ['hello '].
f eketsa-qetellong: ['world'].
