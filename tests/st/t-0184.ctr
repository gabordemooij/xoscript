

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Lenaneo taolo-ea-mohopolo: 0.

Palo ha-ho-fihla: ['addNum:'] etsa: { :x
	uena eketsa: x.
}.

Palo ha-ho-fihla: ['subtractNum:'] etsa: { :x
	uena tlosa: x.
}.

Palo ha-ho-fihla: ['multiplyBy:'] etsa: { :x
	uena ngata-ka: x.
}.

Palo ha-ho-fihla: ['divideBy:'] etsa: { :x
	uena arola-ka: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 matla-a-palo: 8).  
a := a + (2 matla-a-palo: -1). 
a := a + (49 motso-oa-sekwere).   
a addNum: ((Lethathamo ← 0 ; 1) e-kholo-ka-ho-fetisisa).          
a addNum: ((Lethathamo ← 2 ; 3) e-nyane-ka-ho-fetisisa).
Sephetho ngola: a.

Lenaneo hloekisa.

usedMemory1 := (Lenaneo mohopolo ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 matla-a-palo: 8).  
a := a + (2 matla-a-palo: -1). 
a := a + (49 motso-oa-sekwere).   
a addNum: ((Lethathamo ← 0 ; 1) e-kholo-ka-ho-fetisisa).          
a addNum: ((Lethathamo ← 2 ; 3) e-nyane-ka-ho-fetisisa).
Sephetho ngola: a.

Lenaneo hloekisa.
usedMemory2 := (Lenaneo mohopolo ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 matla-a-palo: 8).  
a := a + (2 matla-a-palo: -1). 
a := a + (49 motso-oa-sekwere).   
a addNum: ((Lethathamo ← 0 ; 1) e-kholo-ka-ho-fetisisa).          
a addNum: ((Lethathamo ← 2 ; 3) e-nyane-ka-ho-fetisisa).
Sephetho ngola: a.

Lenaneo hloekisa.
usedMemory3 := (Lenaneo mohopolo ? 0).



( usedMemory1 = usedMemory2 le: usedMemory1 = usedMemory3, le: usedMemory2 = usedMemory3 ) nnete: {
	Sephetho ngola: ['No memory leaks here'].
}, leshano: {
	Sephetho ngola: ['Leaking memory...'].
}.
