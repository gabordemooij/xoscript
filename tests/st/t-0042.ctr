>> items := Bukantswe ncha.
items beha: ['black'] sebakeng: ['coffee'], beha: ['earl grey'] sebakeng: ['tea'].
Sephetho ngola: (items sebakeng: ['coffee']), ngola: (items sebakeng: ['tea']).
Sephetho ngola: ['there are'] + items palo-ea-lintho + [' items in the array.'].
items beha: ['capuccino'] sebakeng: ['coffee'].
Sephetho ngola: ['Now my coffee is.. '] + (items sebakeng: ['coffee']).
items beha: ['aaa'] sebakeng: ['1'].
items beha: ['bbb'] sebakeng: ['2'].
Sephetho ngola: (items sebakeng: ['a']).
