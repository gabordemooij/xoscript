
>> Animal := Ntho ncha.
Animal ha-ho-fihla: ['ncha'] etsa: { <- uena ncha init.
}.

Animal ha-ho-fihla: ['init'] etsa: {
	ea-hao sound := ['?'].
	ea-hao legs := 4.
}.

>> Dog := Animal ncha.
Dog ha-ho-fihla: ['init'] etsa: {
	uena init.
	ea-hao sound := ['barks'].
}.

Animal ha-ho-fihla: ['mongolo'] etsa: { <- ea-hao legs mongolo + ea-hao sound.
}.

>> poodle := Dog ncha.
Sephetho ngola: poodle, mola-o-mocha.

