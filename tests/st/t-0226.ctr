# Test ASCII variants

# Numbers

Sephetho ngola: (2 !=: 3), mola-o-mocha.
Sephetho ngola: (2 <=: 2), mola-o-mocha.
Sephetho ngola: (2 >=: 2), mola-o-mocha.

# Strings

Sephetho ngola: (['b'] >=: ['a']), mola-o-mocha.
Sephetho ngola: (['b'] !=: ['a']), mola-o-mocha.
Sephetho ngola: (['b'] <=: ['c']), mola-o-mocha.

# Bools

Sephetho ngola: (Nnete !=: Leshano), mola-o-mocha.

# Objects

Sephetho ngola: (Ntho ncha !=: Ntho ncha), mola-o-mocha.

# ASCII list symbol <-:

Sephetho ngola: (Lethathamo <<: 1, ; 2 ; 3) palo-ea-lintho = 3, mola-o-mocha.

