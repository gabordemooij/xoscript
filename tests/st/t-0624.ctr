# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := Ntho ncha.

Log ha-ho-fihla: ['say:'] etsa: { :str
	Sephetho ngola: str, mola-o-mocha.
}.

>> Item := Ntho ncha.

Item ha-ho-fihla: ['ncha:'] etsa: { :id <- uena ncha id: id.
}.

Item ha-ho-fihla: ['id:'] etsa: { :id
	ea-hao id := id.
}.

Item ha-ho-fihla: ['id'] etsa: { <- ea-hao id. }.


Item ha-ho-fihla: ['mongolo'] etsa: {
	>> str := ['Item#~no'].
	str ~no: ea-hao id. <- str.
}.


>> Print := Ntho ncha.

Print ha-ho-fihla: ['items'] etsa: { 
	
	ea-hao item := Item ncha: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: ea-hao item
	).
	
	
}.

Print items.