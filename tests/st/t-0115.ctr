{
	mosebetsi-ona phoso: ['Dont fail.'].
	unknown doSomething.
} tšoasa: {
	Sephetho ngola: ['Caught!'].
}, qala.

{
	mosebetsi-ona phoso: ['Dont fail.'].
	ea-hao unknown doSomething.
} tšoasa: {
	Sephetho ngola: ['Caught!'].
}, qala.

{
	mosebetsi-ona phoso: ['Dont fail.'].
	unknown := 122.
} tšoasa: {
	Sephetho ngola: ['Caught!'].
}, qala.


{
	mosebetsi-ona phoso: ['Dont fail.'].
	Nnete khaola.
	Sephetho ngola: ['FAIL'].
} tšoasa: {
	Sephetho ngola: ['Caught!'].
}, qala.

{
	{
		mosebetsi-ona phoso: ['Dont fail.'].
		Nnete khaola.
		Sephetho ngola: ['FAIL'].
	} tšoasa: { :x
		(x = ['Dont fail.']) nnete: { mosebetsi-ona phoso: ['Nested Caught!']. }.
	}, qala.
} tšoasa: { :e
	Sephetho ngola: e.
}, qala.
