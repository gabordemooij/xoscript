
Mongolo ha-ho-fihla: ['evaluate'] etsa: {
	>> khoutu := Faele ncha: ['/tmp/eval.ctr'].
	khoutu ngola: (uena mongolo + ['.']).
	Lenaneo sebelisa: ['/tmp/eval.ctr'].
}.

>> map :=
	(Bukantswe ncha)
	beha: ['Hi There'] sebakeng: ['two'],
	beha: (Lethathamo ← ['hello'] ; ['world'] ; (Lethathamo ← 1 ; 2; 9) ; Leshano) sebakeng: ['one'],
	beha: ( (Bukantswe ncha) beha: ['wrrld'] sebakeng: ['misspelled'] ) sebakeng: ['three'],
	beha: (Lethathamo ← ((Bukantswe ncha) beha: ['treasure'] sebakeng: ['hidden']) ; 2) sebakeng: ['four']. 
>> str := map mongolo.
>> map2 := Letho.
(['map2 := '] + str ) evaluate.
Sephetho ngola: map2 ? ['one'] ? 0.
Sephetho ngola: map2 ? ['one'] ? 1.
Sephetho ngola: map2 ? ['four'] ? 0 ? ['hidden'].
Sephetho ngola: map2 ? ['one'] ? 2 ? 2.
