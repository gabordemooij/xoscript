Server init.
>> f := Sebopeho ncha: ['%d'].
>> a := Blob ncha: 4.
a bytes: ( Lethathamo ncha ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob ncha: 4.
b bytes: ( Lethathamo ncha ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a ho-tloha: 0 bolelele: 3, e-ngoe-le-e-ngoe: { :i :byte
	Sephetho ngola: ( f sebelisa-ho-palo-e-felletseng: byte ), mola-o-mocha.
}.
a ^ b.
a ho-tloha: 0 bolelele: 3, e-ngoe-le-e-ngoe: { :i :byte
	Sephetho ngola: ( f sebelisa-ho-palo-e-felletseng: byte ), mola-o-mocha.
}.
a ^ b.
a ho-tloha: 0 bolelele: 3, e-ngoe-le-e-ngoe: { :i :byte
	Sephetho ngola: ( f sebelisa-ho-palo-e-felletseng: byte ), mola-o-mocha.
}.
a lokolla.
b lokolla.

{ a ^ Ntho. } tšoasa: { :e Sephetho ngola: e, mola-o-mocha. }, qala.
