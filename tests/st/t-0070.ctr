>> numbers := ['1,2,3'] arola: [','].
Sephetho ngola: ['I got: '] + numbers palo-ea-lintho + [' numbers.'],mola-o-mocha.
{ :i Sephetho ngola: ['number #'] + i + [':'] + (numbers boemo: i), mola-o-mocha.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages arola: [' Or '].
Sephetho ngola: ['We serve'], mola-o-mocha.
{ :i Sephetho ngola: ['->'] + (beverages boemo: i), mola-o-mocha. } × (beverages palo-ea-lintho).
Sephetho ngola: (beverages kopanya: [',']), mola-o-mocha.
Sephetho ngola: (numbers kopanya: ['||']).
