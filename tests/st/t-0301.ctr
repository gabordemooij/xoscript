


>> wine := Ntho ncha.


wine ha-ho-fihla: ['toString'] etsa: { <- ['merlot'].
}.

wine ha-ho-fihla: ['naarTekst'] etsa: { <- ['merlot'].
}.


wine ha-ho-fihla: ['='] etsa: { :other wine <- ( uena toString = other wine ).
}.

wine ha-ho-fihla: ['=='] etsa: { :other wine <- ( uena toString = other wine ).
}.



wine
	haeba: ['cabernet'] etsa: { Sephetho ngola: ['it's a Cabernet!']. },
	haeba: ['syrah']    etsa: { Sephetho ngola: ['it's a Syrah!'].    },
	haeba: ['merlot']   etsa: { Sephetho ngola: ['it's a Merlot!'].   },
	haeba: ['malbec']   etsa: { Sephetho ngola: ['it's a Malbec!'].   }.

Sephetho mola-o-mocha.
