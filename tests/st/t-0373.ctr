# compliance test

# use international numbers

Sephetho ngola: ['1000 -> '].
Sephetho ngola: 1000, mola-o-mocha. #1000

Sephetho ngola: ['1.5 -> '].
Sephetho ngola: 1.5, mola-o-mocha.  #1.5

Sephetho ngola: ['1001.5 -> '].
Sephetho ngola: 1.5 + 1000, mola-o-mocha. #1001.5

# use 0-indexed arrays
>> x := Lethathamo ncha ; 1 ; 2 ; 3.
>> y := Lethathamo ncha ; ['a'] ; ['b'] ; ['c'].

Sephetho ngola: ['1 -> '].
Sephetho ngola: x ? 0, mola-o-mocha. #1

Sephetho ngola: ['1 -> '].
Sephetho ngola: (x sebakeng: 0), mola-o-mocha. #1

Sephetho ngola: ['1 -> '].
Sephetho ngola: x ea-pele, mola-o-mocha. #1

Sephetho ngola: ['3 -> '].
Sephetho ngola: x ea-ho-qetela, mola-o-mocha. #3

Sephetho ngola: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Sephetho ngola: (x ho-latela: y), mola-o-mocha.

Sephetho ngola: ['1 -> '].
Sephetho ngola: (x ho-tloha: 0 bolelele: 1) ea-pele, mola-o-mocha. #1

Sephetho ngola: ['0 -> '].
Sephetho ngola: (x fumana: 1), mola-o-mocha. #0

x beha: 9 sebakeng: 0.

Sephetho ngola: ['9 -> '].
Sephetho ngola: (x sebakeng: 0), mola-o-mocha. #9

x eketsa-qalong: 8.
Sephetho ngola: ['8 -> '].
Sephetho ngola: (x sebakeng: 0), mola-o-mocha. #9


x eketsa-qetellong: 10.
Sephetho ngola: ['10 -> '].
Sephetho ngola: (x sebakeng: 4), mola-o-mocha. #10








