# test number -> string -> number
{

	>> x := Palo pakeng-tsa: 0 le: 1000000.
	>> d := Palo pakeng-tsa: 1 le: 7.
	>> e := 10 matla-a-palo: d.

	x arola-ka: e.
	>> y := x mongolo palo.

	(x = y) leshano: {
		Sephetho ngola: x, mola-o-mocha.
		Sephetho ngola: y, mola-o-mocha.
		Lenaneo qeta.
	}.

} * 1000.
Sephetho ngola: ['OK'], mola-o-mocha.