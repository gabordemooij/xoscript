

# create a 64-bit integer for exact calculations
>> a := Int64 ho-tsoa-mongolong: ['123'].

# to string
Sephetho ngola: a, mola-o-mocha.

# divide
Sephetho ngola: a / (Int64 ho-tsoa-mongolong: ['3']), mola-o-mocha.

# multiply
Sephetho ngola: a * (Int64 ho-tsoa-mongolong: ['2']), mola-o-mocha.

# add
Sephetho ngola: a + (Int64 ho-tsoa-mongolong: ['1']), mola-o-mocha.

# subtract
Sephetho ngola: a - (Int64 ho-tsoa-mongolong: ['2']), mola-o-mocha.

# compare
Sephetho ngola: ( a =   (Int64 ho-tsoa-mongolong: ['123'])), mola-o-mocha.
Sephetho ngola: ( a !=: (Int64 ho-tsoa-mongolong: ['124'])), mola-o-mocha.
Sephetho ngola: ( a <   (Int64 ho-tsoa-mongolong: ['124'])), mola-o-mocha.
Sephetho ngola: ( a >   (Int64 ho-tsoa-mongolong: ['122'])), mola-o-mocha.
Sephetho ngola: ( a >=: (Int64 ho-tsoa-mongolong: ['123'])), mola-o-mocha.
Sephetho ngola: ( a <=: (Int64 ho-tsoa-mongolong: ['123'])), mola-o-mocha.





	