>> map1 := Bukantswe ncha.
>> key1 := Lethathamo ncha.
>> key2 := Lethathamo ncha.

map1
	beha: ['hello'] sebakeng: key1,
	beha: ['world'] sebakeng: key2.


Sephetho
	ngola: ['Map #1 contains: '] + (map1 sebakeng: key1),
	ngola: [' and '] + (map1 sebakeng: key2), mola-o-mocha.

>> KeyeableArray := Lethathamo ncha.
KeyeableArray ha-ho-fihla: ['toString'] etsa: { <- (uena palo-ea-lintho) toString.
}.

>> map2 := Bukantswe ncha.
key1 := KeyeableArray ncha.
key2 := KeyeableArray ncha.

key1 eketsa-qetellong: 1.

map2
	beha: ['hello'] sebakeng: key1,
	beha: ['world'] sebakeng: key2.

Sephetho
	ngola: ['Map #2 contains: '] + (map2 sebakeng: key1),
	ngola: [' and '] + (map2 sebakeng: key2), mola-o-mocha.
