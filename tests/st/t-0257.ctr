
>> Greeter := Ntho ncha.
Greeter ha-ho-fihla: ['ncha'] etsa: {
	ea-hao lebitso := ['?'].
}.
Greeter ha-ho-fihla: ['name:'] etsa: { :lebitso
	ea-hao lebitso := lebitso.
}.
Greeter ha-ho-fihla: ['greet'] etsa: {
	Sephetho ngola: (['hello[you]'] [you]: ea-hao lebitso).
}.
>> friend := Greeter ncha.
friend name: ['1'].
friend greet.
