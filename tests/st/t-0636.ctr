# test url parsing

Server init.
>> url := URL mohloli: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Sephetho ngola: ['scheme = '] + url sekema, mola-o-mocha.
Sephetho ngola: ['host = '] + url moamoheli, mola-o-mocha.
Sephetho ngola: ['port = '] + url boema-kepe, mola-o-mocha.
Sephetho ngola: ['path = '] + url tsela-ea-faele, mola-o-mocha.
Sephetho ngola: ['query = '] + url liparamente-tsa-patlo, mola-o-mocha.
Sephetho ngola: ['fragment = '] + url sekhechana, mola-o-mocha.
