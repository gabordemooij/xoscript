Sephetho ngola: ['Test object'], mola-o-mocha.
>> cmd := Taelo ncha.
Sephetho ngola: cmd ls /tmp, mola-o-mocha.
>> old-cmd-address := cmd mohlala-oa-pele aterese-ea-mohopolo.
cmd save-as: ['/tmp/a.bin'].
Sephetho ngola: ['========== RELOADING SNAP:'], mola-o-mocha.
>> b := Ntho load-from: ['/tmp/a.bin'].
(b mohlala-oa-pele aterese-ea-mohopolo = old-cmd-address) nnete: {
	Sephetho ngola: ['Object link re-attached.'], mola-o-mocha.
}.
Sephetho ngola: b ls, mola-o-mocha.


