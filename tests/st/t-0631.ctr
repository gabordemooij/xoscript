#ffi test


Server init.

Lenaneo taolo-ea-mohopolo: 4.

# for this test you need set a path to libc (puts)
>> libname := Lenaneo tlhophiso: ['FFITESTLIB'].



Server hokahanya: (
 Lethathamo ncha ;
 libname ;
 ['puts'] ;
 ( Lethathamo ncha ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s lokolla.

# test with struct

>> a := Blob ncha: 8.
a bytes: (
	Lethathamo <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Lethathamo <<: ['int'], ; ['int']).

Server hokahanya: (
	Lethathamo <<: ['@structtest'], ;
	['@structtest'] ;
	(Lethathamo <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Sephetho ngola: ['Sum test:'] + (ffitest ffisum: a), mola-o-mocha.

struct lokolla-struct.
struct lokolla.
a lokolla.
