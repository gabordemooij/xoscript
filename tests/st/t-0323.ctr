

Lenaneo hloekisa.


>> Veggy := Ntho ncha.
Veggy ha-ho-fihla: ['ncha'] etsa: {
	>> v := uena ncha.
	v init. <- v.
}.

Veggy ha-ho-fihla: ['init'] etsa: { ea-hao veggies := 0. }.

Veggy ha-ho-fihla: ['carrots:'] etsa: { :a ea-hao veggies := a. <- Letho. }.
Veggy ha-ho-fihla: ['carrots'] etsa: { <- ea-hao veggies. }.
Veggy ha-ho-fihla: ['+'] etsa: { :f
	>> n := Veggy ncha.
	n carrots: (f carrots + ea-hao veggies). <- n.
}.

Veggy ha-ho-fihla: ['mongolo'] etsa: { <- ea-hao veggies mongolo.
}.

Palo ha-ho-fihla: ['carrots'] etsa: {
	>> x := Veggy ncha.
	x carrots: uena. <- x.
}.

Palo ha-ho-fihla: ['add:and:'] etsa: { :a :b <- (a + b).
}.

>> q := 0 add: (3 carrots + 2 carrots) and: 4 carrots.
Sephetho ngola: q, mola-o-mocha.
