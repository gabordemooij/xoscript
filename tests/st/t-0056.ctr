>> z := Ntho ncha.
z ha-ho-fihla: ['value:'] etsa: { :v
	ea-hao value := v. <- uena.
}.
z ha-ho-fihla: ['value'] etsa: { <- ea-hao value. }.
(z setValue: 1) value: 2.
Sephetho ngola: z value.
>> x := z.
Sephetho ngola: x value.
z := Letho.
Sephetho ngola: z value.
Sephetho ngola: x value.
Sephetho ngola: ['hello'].
Sephetho ngola: 3 + 2.
Sephetho ngola: (3 > 2).
