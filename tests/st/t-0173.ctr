

Lethathamo ha-ho-fihla: ['sum'] etsa: {
	>> total := 0.
	uena e-ngoe-le-e-ngoe: { :index :element
		total eketsa: element.
	}. <- total.
}.

Lethathamo ha-ho-fihla: ['product'] etsa: {
	>> total := 1.
	uena e-ngoe-le-e-ngoe: { :index :element
		total ngata-ka: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Lenaneo taolo-ea-mohopolo: 0.

{

>> a := Lethathamo ← ['hello'] ; ['world'] ; Nnete ; Letho ; 666.
a := a + ( Lethathamo ← 1 ).
Sephetho ngola: ( ['sum: '] + ( a sum ) ), mola-o-mocha.
Sephetho ngola: ( ['min: '] + ( a e-nyane-ka-ho-fetisisa ) ), mola-o-mocha.
Sephetho ngola: ( ['max: '] + ( a e-kholo-ka-ho-fetisisa ) ), mola-o-mocha.
Sephetho ngola: ( ['3rd: '] + ( a ? 2 ) ), mola-o-mocha.
Sephetho ngola: ( ['prd: '] + ( a product ) ), mola-o-mocha.
a hlopha: { :a :b <- (b - a). }.
a e-ngoe-le-e-ngoe: { :i :e Sephetho ngola: ( i - 0 ), mola-o-mocha. }.

} qala.

Lenaneo hloekisa.
usedMemory1 := (Lenaneo mohopolo ? 0).


{

>> a := Lethathamo ← ['hello'] ; ['world'] ; Nnete ; Letho ; 666.
a := a + ( Lethathamo ← 1 ).
Sephetho ngola: ( ['sum: '] + ( a sum ) ), mola-o-mocha.
Sephetho ngola: ( ['min: '] + ( a e-nyane-ka-ho-fetisisa ) ), mola-o-mocha.
Sephetho ngola: ( ['max: '] + ( a e-kholo-ka-ho-fetisisa ) ), mola-o-mocha.
Sephetho ngola: ( ['3rd: '] + ( a ? 2 ) ), mola-o-mocha.
Sephetho ngola: ( ['prd: '] + ( a product ) ), mola-o-mocha.
a hlopha: { :a :b <- (b - a). }.
a e-ngoe-le-e-ngoe: { :i :e Sephetho ngola: ( i - 0 ), mola-o-mocha. }.

} qala.



Lenaneo hloekisa.
usedMemory2 := (Lenaneo mohopolo ? 0).


{

>> a := Lethathamo ← ['hello'] ; ['world'] ; Nnete ; Letho ; 666.
a := a + ( Lethathamo ← 1 ).
Sephetho ngola: ( ['sum: '] + ( a sum ) ), mola-o-mocha.
Sephetho ngola: ( ['min: '] + ( a e-nyane-ka-ho-fetisisa ) ), mola-o-mocha.
Sephetho ngola: ( ['max: '] + ( a e-kholo-ka-ho-fetisisa ) ), mola-o-mocha.
Sephetho ngola: ( ['3rd: '] + ( a ? 2 ) ), mola-o-mocha.
Sephetho ngola: ( ['prd: '] + ( a product ) ), mola-o-mocha.
a hlopha: { :a :b <- (b - a). }.
a e-ngoe-le-e-ngoe: { :i :e Sephetho ngola: ( i - 0 ), mola-o-mocha. }.

} qala.



Lenaneo hloekisa.
usedMemory3 := (Lenaneo mohopolo ? 0).

( usedMemory1 = usedMemory2 le: usedMemory1 = usedMemory3, le: usedMemory2 = usedMemory3 ) nnete: {
	Sephetho ngola: ['No memory leaks here'].
}, leshano: {
	Sephetho ngola: ['Leaking memory...'].
}.
