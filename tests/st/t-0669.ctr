# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Polokelo-e-sireletsehileng 
	hash-ea-phasewete: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Polokelo-e-sireletsehileng 
	hash-ea-phasewete: hash netefatsa: a1.
	# fail 
>> b := Polokelo-e-sireletsehileng
	hash-ea-phasewete: hash netefatsa: a2.
	# ok!

Sephetho ngola: a, mola-o-mocha.
Sephetho ngola: b, mola-o-mocha.

