Sephetho ngola: ((Lethathamo ncha
	ha-ho-fihla: ['plaque:'] etsa: { :x ea-hao o := x. },
	ha-ho-fihla: ['plaque']  etsa: { <- ea-hao o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Lethathamo ← 1)
	~ (Lethathamo ← 1 ; 2)
	~ (Lethathamo ← 1 ; 2 ; 3)
	~ (Lethathamo ← 1 ; 2 ; 3 ; 4)
	~ (Lethathamo ← 1 ; 2 ; 3 ; 4 ; 5)
) e-ngoe-le-e-ngoe: { :i :el
	{ Sephetho ngola: mosebetsi-ona. } × el palo-ea-lintho.
	Sephetho mola-o-mocha.
}) plaque, mola-o-mocha.


