
>> dictionary := (
	Bukantswe ncha
		beha: ['b'] sebakeng: ['a'],
		beha: ['a'] sebakeng: ['b'],
		beha: ['z'] sebakeng: ['x'],
		beha: ['hello'] sebakeng: ['hallo'],
		beha: ['human'] sebakeng: ['human']
).

>> comparisons := Lethathamo ncha.
dictionary e-ngoe-le-e-ngoe: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a bapisa: b)
	).
}.

comparisons hlopha: { :a :b <- ( a bapisa: b ). }.
Sephetho ngola: ( comparisons kopanya: ['↵'] ), mola-o-mocha.
comparisons kopanya: ['↵'].
