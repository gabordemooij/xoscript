

# reference in world.c

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.
>> khoutu := {
	>> a := Bukantswe ncha.
	>> b := Bukantswe ncha.
	a hokahanya: b.
	b hokahanya: a.
}.
Lenaneo taolo-ea-mohopolo: 0.
Lenaneo hloekisa.
usedMemory1 := (Lenaneo mohopolo ? 0).
khoutu qala.
Lenaneo hloekisa.
usedMemory2 := (Lenaneo mohopolo ? 0).
khoutu qala.
Lenaneo hloekisa.
usedMemory3 := (Lenaneo mohopolo ? 0).
( usedMemory1 = usedMemory2 le: usedMemory1 = usedMemory3, le: usedMemory2 = usedMemory3 ) nnete: {
	Sephetho ngola: ['No memory leaks here'].
}, leshano: {
	Sephetho ngola: ['Leaking memory...'].
}.
