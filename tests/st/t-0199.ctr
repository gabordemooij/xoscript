
Lenaneo taolo-ea-mohopolo: 4.

>> Animal := Ntho ncha.
Animal ha-ho-fihla: ['make'] etsa: {
	>> animal := Ntho ncha.
	animal ha-ho-fihla: ['makeSound'] etsa: {
		Sephetho ngola: ea-hao sound.
	}. <- animal.
}.
>> Cat := Ntho ncha.
Cat ha-ho-fihla: ['make'] etsa: {
	>> cat := Animal make.
	cat ha-ho-fihla: ['init'] etsa: {
		ea-hao sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
