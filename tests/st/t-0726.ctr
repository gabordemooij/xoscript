# test buffers PKI/Sign 
Server init.

>> long := ( Lethathamo ncha tlatsa: 1000 ka: ['a'] ) kopanya: [''].

# sign a message
Sephetho ngola: ( 
	Polokelo-e-sireletsehileng saena: ['abc'] ka: long
), mola-o-mocha.

Sephetho ngola: ( 
	Polokelo-e-sireletsehileng
		hlahloba: ['abc'] 
		tshaeno: long 
		ka: long
), mola-o-mocha.

Sephetho ngola: (
	Polokelo-e-sireletsehileng hash-ea-phasewete: long netefatsa: long
), mola-o-mocha.
