>> Greeter := Ntho ncha.
Greeter ha-ho-fihla: ['make'] etsa: {
	>> greeter := Ntho ncha.
	greeter ha-ho-fihla: ['name:'] etsa: { :lebitso
		Sephetho ngola: ['setting a name'].
		ea-hao myName := lebitso.
	}.
	greeter ha-ho-fihla: ['performGreeting'] etsa: {
		Sephetho ngola: ['Hello'].
		Sephetho ngola: ea-hao myName.
	}.
	greeter ha-ho-fihla: ['greet'] etsa: {
		uena performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
