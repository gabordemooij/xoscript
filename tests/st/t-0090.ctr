Sephetho ngola: ['1,2,3,4,5,6,7,8,9,A,'], mola-o-mocha.
>> Scope := Ntho ncha.
Scope ha-ho-fihla: ['initialize:'] etsa: { :x ea-hao property := x. }.
Scope ha-ho-fihla: ['confirm'] etsa: { Sephetho ngola: [',']. }.
Scope ha-ho-fihla: ['teko'] etsa: {
	Sephetho ngola: ea-hao property.
	uena confirm.
	( 1 = 1 ) nnete: { Sephetho ngola: ea-hao property. uena confirm. }.
	( 1 = 0 ) leshano: { Sephetho ngola: ea-hao property. uena confirm. }.
	>> y := 2. { Sephetho ngola: ea-hao property. uena confirm. } ha-feela: { y tlosa: 1. <- (y > 0). }.
	{ Sephetho ngola: ea-hao property. uena confirm. } × 1.
	(Lethathamo ← 1) e-ngoe-le-e-ngoe: {  Sephetho ngola: ea-hao property. uena confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Bukantswe ncha one: ['item']) e-ngoe-le-e-ngoe: { Sephetho ngola: ea-hao property. uena confirm. }.
	{ 1 ÷ 0. } tšoasa: { Sephetho ngola: ea-hao property. uena confirm. }, qala.
	Sephetho mola-o-mocha.
}.
>> scope1 := Scope ncha.
scope1 initialize: ['X'].
scope1 teko.
>> function := { 
	ea-hao property := ['Y'].
	Sephetho ngola: ea-hao property.
	uena confirm.
	( 1 = 1 ) nnete: { Sephetho ngola: ea-hao property. uena confirm. }.
	( 1 = 0 ) leshano: { Sephetho ngola: ea-hao property. uena confirm. }.
	>> y := 2. { Sephetho ngola: ea-hao property. uena confirm. } ha-feela: { y tlosa: 1. <- (y > 0). }.
	{ Sephetho ngola: ea-hao property. uena confirm. } × 1.
	(Lethathamo ← 1) e-ngoe-le-e-ngoe: {  Sephetho ngola: ea-hao property. uena confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Bukantswe ncha one: ['item']) e-ngoe-le-e-ngoe: { Sephetho ngola: ea-hao property. uena confirm. }.
	{ 1 ÷ 0. } tšoasa: { Sephetho ngola: ea-hao property. uena confirm. }, qala.
	Sephetho mola-o-mocha.
}.
function ha-ho-fihla: ['confirm'] etsa: { Sephetho ngola: [',']. }.
function sebelisa-ho: 1 le: 2.
