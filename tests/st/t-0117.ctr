>> t := Nnete.
(t = Nnete) nnete: { Sephetho ngola: ['T']. }.
(t = Leshano) nnete: { Sephetho ngola: ['F']. }.
Sephetho ngola: ['|'].
>> t := Leshano.
(t = Nnete) nnete: { Sephetho ngola: ['T']. }.
(t = Leshano) nnete: { Sephetho ngola: ['F']. }.
Sephetho ngola: ['|'].
>> f := Nnete.
(t = Nnete le: f = Leshano) nnete: { Sephetho ngola: ['T']. }.
(t = Leshano le: f = Nnete) nnete: { Sephetho ngola: ['F']. }.
Sephetho ngola: ['|'].
>> n := Letho.
(n Letho?) nnete: { Sephetho ngola: ['T']. }.
(n Letho?) leshano: { Sephetho ngola: ['F']. }.
Sephetho ngola: ['|'].
(f Boolean?) nnete: { Sephetho ngola: ['T']. }.
(f Boolean?) leshano: { Sephetho ngola: ['F']. }.



