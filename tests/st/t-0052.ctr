>> items := Bukantswe ncha.
items beha: ['green'] sebakeng: ['color-1'].
items beha: ['orange'] sebakeng: ['color-2'].
items beha: ['red'] sebakeng: ['color-3'].
>> i := 0.
>> s := [''].
items e-ngoe-le-e-ngoe: { :key :color
	Sephetho ngola: ['color #'] + i + [' is: '] + color + [' '].
	i eketsa: 1.
}.
Sephetho ngola: i + [' colors!'].
