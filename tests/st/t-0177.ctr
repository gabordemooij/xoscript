

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Lenaneo taolo-ea-mohopolo: 0.

>> txt := [' Word Salad '].
txt := txt nkela-sebaka: ['Word'] ka: ['Ceasar'].
txt := txt khaola-likheo.
Sephetho ngola: txt, mola-o-mocha.

Lenaneo hloekisa.

usedMemory1 := (Lenaneo mohopolo ? 0).


txt := [' Word Salad '].
txt := txt nkela-sebaka: ['Word'] ka: ['Ceasar'].
txt := txt khaola-likheo.
Sephetho ngola: txt, mola-o-mocha.

