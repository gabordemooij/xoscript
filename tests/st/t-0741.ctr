Sephetho ngola: ['Test object'], mola-o-mocha.
>> a := Ntho ncha. 

a ha-ho-fihla: ['item:'] etsa: { :octhelper
	ea-hao octhelper := octhelper. 
}.

a ha-ho-fihla: ['item'] etsa: { <- ea-hao octhelper.
}.

a item: Oct ncha.

>> old-octhelper-address := a item mohlala-oa-pele aterese-ea-mohopolo.
a save-as: ['/tmp/a.bin'].
Sephetho ngola: ['========== RELOADING SNAP:'], mola-o-mocha.

>> b := Ntho load-from: ['/tmp/a.bin'].

(b item mohlala-oa-pele aterese-ea-mohopolo = old-octhelper-address) nnete: {
	Sephetho ngola: ['Object link re-attached.'], mola-o-mocha.
}.
