# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Lenaneo shell-escape: ['abc'].
Sephetho ngola: c, mola-o-mocha.
Sephetho ngola: ( Lenaneo sistimi: ['echo '] + c ), mola-o-mocha.

c := Lenaneo shell-escape: ['a'b'c'].
Sephetho ngola: c, mola-o-mocha.
Sephetho ngola: ( Lenaneo sistimi: ['echo '] + c ), mola-o-mocha.

c := Lenaneo shell-escape: ['a\'c'].
Sephetho ngola: c, mola-o-mocha.
Sephetho ngola: ( Lenaneo sistimi: ['echo '] + c ), mola-o-mocha.