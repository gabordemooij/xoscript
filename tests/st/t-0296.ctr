
>> shop := (Bukantswe ncha
	beha: ['magazine'] sebakeng: ['books'],
	beha: ['computer'] sebakeng: ['electronics'],
	beha: ['lipstick'] sebakeng: ['cosmetics']
).
Sephetho ngola: (shop e-na-le: ['computer']), mola-o-mocha. 
Sephetho ngola: (shop e-na-le: ['sausage']), mola-o-mocha. 
Sephetho ngola: (shop e-na-le: ['computers']), mola-o-mocha. 
Sephetho ngola: (shop e-na-le: ['compute']), mola-o-mocha. 
Sephetho ngola: (shop e-na-le: ['2computer']), mola-o-mocha. 
