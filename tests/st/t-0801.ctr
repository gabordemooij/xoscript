Server init.

>> db := Maria-DB ncha moamoheli: ['localhost'],
	lebitso-la-mosebelisi: ['xo'],
	phasewete: ['pass123'],
	lebitso-la-database: ['xobase'],
	hokela.

>> del := db potso: ['DELETE FROM book WHERE id > 0'].
{  del phetha. db tiisa. } tšoasa: { :e db khutlisetsa-morao.  }, qala.

>> palo-ea-lintho := db potso: ['SELECT COUNT(*) AS num FROM book'].
palo-ea-lintho lata: { :row Sephetho ngola: row num, mola-o-mocha. }.
