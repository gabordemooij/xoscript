# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob ncha: 8, bytes: (
	Lethathamo ncha ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Sephetho ngola: ( utf16 ntsha-khoutu: ['utf16le'] ), mola-o-mocha.

utf16 lokolla.
>> utf32 := Blob ncha: 13, bytes: (
	Lethathamo ncha ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Sephetho ngola: ( utf32 ntsha-khoutu: ['utf32be'] ), mola-o-mocha.
utf32 lokolla.