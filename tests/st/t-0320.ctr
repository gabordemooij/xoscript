


>> CoffeeMachine := Ntho ncha.
CoffeeMachine ha-ho-fihla: ['order:'] etsa: { :id
	>> coffee := ['Americano'].
	( id = 1 ) nnete: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) nnete: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) nnete: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Ntho ncha.
SimpleCoffeeMachine ha-ho-fihla: ['order'] etsa: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Sephetho ngola: redCup, mola-o-mocha.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Sephetho ngola: greenCup, mola-o-mocha.
>> yellowCup := CoffeeMachine order: 1.
Sephetho ngola: yellowCup, mola-o-mocha.
>> blueCup := CoffeeMachine order: 0.
Sephetho ngola: blueCup, mola-o-mocha.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Sephetho ngola: blackCup, mola-o-mocha.
blackCup eketsa-qetellong: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Sephetho ngola: orangeCup, mola-o-mocha.
