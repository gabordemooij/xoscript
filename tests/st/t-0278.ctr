>> To-Do := Ntho ncha.

To-Do ha-ho-fihla: ['ncha'] etsa: {
	ea-hao list := Lethathamo ncha.
}.

To-Do ha-ho-fihla: ['nieuw'] etsa: {
	ea-hao list := Lethathamo ncha.
}.

To-Do ha-ho-fihla: ['+'] etsa: { :task
	ea-hao list eketsa-qetellong: task.
}.

To-Do ha-ho-fihla: ['number of tasks?'] etsa: { <-  ea-hao list palo-ea-lintho.
}.

>> todos := 
	To-Do ncha 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Sephetho ngola: ['You have $ tasks to do'] $ todos number of tasks?.
