Mongolo ha-ho-fihla: ['html'] etsa: { <- (
		uena
		nkela-sebaka: ['&'] ka: ['&amp;'],
		nkela-sebaka: ['<'] ka: ['&lt;'],
		nkela-sebaka: ['>'] ka: ['&gt;'],
		nkela-sebaka: ['''] ka: ['&apos;'],
		nkela-sebaka: ['"'] ka: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Lenaneo taolo-ea-mohopolo: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Sephetho ngola: txt kopitsa html, mola-o-mocha.
Sephetho ngola: txt kopitsa litlhaku-tse-nyane, mola-o-mocha.
Sephetho ngola: txt kopitsa litlhaku-tse-kholo, mola-o-mocha.
} qala.

Lenaneo hloekisa.

usedMemory1 := (Lenaneo mohopolo ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Sephetho ngola: txt kopitsa html, mola-o-mocha.
Sephetho ngola: txt kopitsa litlhaku-tse-nyane, mola-o-mocha.
Sephetho ngola: txt kopitsa litlhaku-tse-kholo, mola-o-mocha.
} qala.

Lenaneo hloekisa.
usedMemory2 := (Lenaneo mohopolo ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Sephetho ngola: txt kopitsa html, mola-o-mocha.
Sephetho ngola: txt kopitsa litlhaku-tse-nyane, mola-o-mocha.
Sephetho ngola: txt kopitsa litlhaku-tse-kholo, mola-o-mocha.
} qala.

Lenaneo hloekisa.
usedMemory3 := (Lenaneo mohopolo ? 0).



( usedMemory1 = usedMemory2 le: usedMemory1 = usedMemory3, le: usedMemory2 = usedMemory3 ) nnete: {
	Sephetho ngola: ['No memory leaks here'].
}, leshano: {
	Sephetho ngola: ['Leaking memory...'].
}.
