
Server init.
>> rq := Kopo-HTTP ncha.
Sephetho ngola: ['HTTP-GET d[]=']  + ( rq get-lethathamo: ['d[]'] ), mola-o-mocha. # GET
Sephetho ngola: ['HTTP-GET f[]=']  + ( rq get-lethathamo: ['f[]'] ), mola-o-mocha. # GET
Sephetho ngola: ['HTTP-POST e[]='] + ( rq post-lethathamo: ['e[]'] ), mola-o-mocha. # GET
Sephetho ngola: ['HTTP-POST c=']   + ( rq post: ['c'] ), mola-o-mocha. # GET
Sephetho ngola: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), mola-o-mocha. # GET
