Sephetho ngola: ['Test object'], mola-o-mocha.
>> a := Ntho ncha. 

a ha-ho-fihla: ['item:'] etsa: { :hexhelper
	ea-hao hexhelper := hexhelper. 
}.

a ha-ho-fihla: ['item'] etsa: { <- ea-hao hexhelper.
}.

a item: Hx ncha.

>> old-hexhelper-address := a item mohlala-oa-pele aterese-ea-mohopolo.
a save-as: ['/tmp/a.bin'].
Sephetho ngola: ['========== RELOADING SNAP:'], mola-o-mocha.

>> b := Ntho load-from: ['/tmp/a.bin'].

(b item mohlala-oa-pele aterese-ea-mohopolo = old-hexhelper-address) nnete: {
	Sephetho ngola: ['Object link re-attached.'], mola-o-mocha.
}.
