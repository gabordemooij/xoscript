

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Lenaneo taolo-ea-mohopolo: 0.

>> txt := ['1.6'].
>> n := txt palo.
>> t := txt bulione.
Sephetho ngola: n, mola-o-mocha.
Sephetho ngola: t, mola-o-mocha.
Sephetho ngola: n mofuta, mola-o-mocha.
Sephetho ngola: t mofuta, mola-o-mocha.

Lenaneo hloekisa.

usedMemory1 := (Lenaneo mohopolo ? 0).


txt := ['1.6'].
n := txt palo.
t := txt bulione.
Sephetho ngola: n, mola-o-mocha.
Sephetho ngola: t, mola-o-mocha.
Sephetho ngola: n mofuta, mola-o-mocha.
Sephetho ngola: t mofuta, mola-o-mocha.

