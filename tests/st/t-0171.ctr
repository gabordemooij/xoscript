

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Lenaneo taolo-ea-mohopolo: 0.

>> a := Lethathamo ← ['hello'] ; ['world'] ; Nnete ; Letho ; 666.
a etsa ntsha-ea-ho-qetela ntsha-ea-pele eketsa-qalong: ['hi'], eketsa-qetellong: 999, ho-felile.
Sephetho ngola: ( a kopanya: [','] ), mola-o-mocha.

Lenaneo hloekisa.
usedMemory1 := (Lenaneo mohopolo ? 0).


a := Lethathamo ← ['hello'] ; ['world'] ; Nnete ; Letho ; 666.
a ntsha-ea-ho-qetela. a ntsha-ea-pele. a eketsa-qalong: ['hi'], eketsa-qetellong: 999.
Sephetho ngola: ( a kopanya: [','] ), mola-o-mocha.


Lenaneo hloekisa.
usedMemory2 := (Lenaneo mohopolo ? 0).


a := Lethathamo ← ['hello'] ; ['world'] ; Nnete ; Letho ; 666.
a etsa ntsha-ea-ho-qetela ntsha-ea-pele eketsa-qalong: ['hi'], eketsa-qetellong: 999, ho-felile.
Sephetho ngola: ( a kopanya: [','] ), mola-o-mocha.


Lenaneo hloekisa.
usedMemory3 := (Lenaneo mohopolo ? 0).



( usedMemory1 = usedMemory2 le: usedMemory1 = usedMemory3, le: usedMemory2 = usedMemory3 ) nnete: {
	Sephetho ngola: ['No memory leaks here'].
}, leshano: {
	Sephetho ngola: ['Leaking memory...'].
}.
