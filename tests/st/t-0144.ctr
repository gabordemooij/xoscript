



>> CoffeeGrounds := Ntho ncha.
CoffeeGrounds ha-ho-fihla: ['extract'] etsa: { <- ['coffee']. }.

>> CoffeeMachine := Ntho ncha.
CoffeeMachine ha-ho-fihla: ['init'] etsa: {
	ea-hao coffeegrounds := CoffeeGrounds ncha.
}.
CoffeeMachine ha-ho-fihla: ['ncha'] etsa: { <- CoffeeMachine `new init.
}.

CoffeeMachine ha-ho-fihla: ['makeTea'] etsa: { <- (ea-hao tealeaves extract). }.
CoffeeMachine ha-ho-fihla: ['makeCoffee'] etsa: { <- (ea-hao coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine ncha.

Sephetho ngola:
	coffeeDream 
	makeCoffee.

Sephetho ngola:
	coffeeDream 
	makeTea.
