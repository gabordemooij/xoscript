Sephetho ngola: ['Test object'], mola-o-mocha.
>> a := Ntho ncha. 

a ha-ho-fihla: ['item:'] etsa: { :fmt
	ea-hao fmt := fmt. 
}.

a ha-ho-fihla: ['item'] etsa: { <- ea-hao fmt.
}.

a item: ( Sebopeho ncha: ['|%s|'] ).

Sephetho ngola: a item, mola-o-mocha.

>> old-fmt-address := a item mohlala-oa-pele aterese-ea-mohopolo.
a save-as: ['/tmp/a.bin'].
Sephetho ngola: ['========== RELOADING SNAP:'], mola-o-mocha.

>> b := Ntho load-from: ['/tmp/a.bin'].

(b item mohlala-oa-pele aterese-ea-mohopolo = old-fmt-address) nnete: {
	Sephetho ngola: ['Object link re-attached.'], mola-o-mocha.
}.

Sephetho ngola: ( b item sebelisa-ho: ['hello'] ), mola-o-mocha.
