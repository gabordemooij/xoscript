Server init.

>> DB := Maria-DB ncha moamoheli: ['localhost'],
	lebitso-la-mosebelisi: ['xo'],
	phasewete: ['pass123'],
	lebitso-la-database: ['xobase'],
	hokela.

{
	DB potso:
	['DROP TABLE movies'],
	phetha.
} tšoasa: { Letho. }, qala.

DB potso:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
phetha.

DB potso: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
liparamente: ( Lethathamo ncha ; ['Halloween'] ),
phetha.

DB potso: ['SELECT * FROM movies'],
lata: { :movie
	Sephetho ngola: movie title, mola-o-mocha.
}.

