	a ha-ho-fihla: ['mongolo'] etsa: { <- (Bukantswe ncha). }.
	a := [''] + a. 
} tšoasa: { :error
	Sephetho ngola: ['Error noted: '] + error, mola-o-mocha.
}, qala.



