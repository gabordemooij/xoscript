Lethathamo ha-ho-fihla: ['sum'] etsa: {
	>> total := 0.
	uena e-ngoe-le-e-ngoe: { :index :element
		total eketsa: element.
	}. <- total.
}.

>> a := Nnete.



a ha-ho-fihla: ['mongolo'] etsa: {
	>> answer := Letho.
	( uena = Nnete ) nnete: {
		answer := ['Yep'].
	}, ho-seng-joalo: {
		answer := ['Nope'].
	}. <- answer.
}.

a ha-ho-fihla: ['palo'] etsa: {
	>> answer := Letho.
	( uena = Nnete ) nnete: {
		answer := 10.
	}, ho-seng-joalo: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b ha-ho-fihla: ['mongolo'] etsa: { <- ['Devil'].
}.

b ha-ho-fihla: ['bulione'] etsa: { <- Leshano.
}.


Sephetho ngola: a, mola-o-mocha.  
Sephetho ngola: (90 + a), mola-o-mocha. 
Sephetho ngola: b, mola-o-mocha. 
Sephetho ngola: (Nnete le: b), mola-o-mocha.

a := Lethathamo ← ['hello'] ; ['world'] ; Nnete ; Letho ; 666. 
a := a + ( Lethathamo ← 1 ).
Sephetho ngola: a, mola-o-mocha.
Sephetho ngola: ((Bukantswe ncha) beha: Letho sebakeng: Letho), mola-o-mocha.
Sephetho ngola: a sum, mola-o-mocha. 


{
	a ha-ho-fihla: ['mongolo'] etsa: { <- Letho. }.
	a := [''] + a.
} tšoasa: { :error
	Sephetho ngola: ['Error noted: '] + error, mola-o-mocha.
}, qala.



{
	a ha-ho-fihla: ['palo'] etsa: { <- Letho. }.
	a := 3 × a.
} tšoasa: { :error
	Sephetho ngola: ['Error noted: '] + error, mola-o-mocha.
}, qala.


{
	a ha-ho-fihla: ['bulione'] etsa: { <- Letho. }.
	a := Nnete le: a. 
} tšoasa: { :error
	Sephetho ngola: ['Error noted: '] + error, mola-o-mocha.
}, qala.





{
	a ha-ho-fihla: ['mongolo'] etsa: { <- Leshano. }.
	a := [''] + a.
} tšoasa: { :error
	Sephetho ngola: ['Error noted: '] + error, mola-o-mocha.
}, qala.



{
	a ha-ho-fihla: ['palo'] etsa: { <- Nnete. }.
	a := 3 × a.
} tšoasa: { :error
	Sephetho ngola: ['Error noted: '] + error, mola-o-mocha.
}, qala.


{
	a ha-ho-fihla: ['boolean'] etsa: { <- 1. }.
	a := Nnete le: a.
} tšoasa: { :error
	Sephetho ngola: ['Error noted: '] + error, mola-o-mocha.
}, qala.





