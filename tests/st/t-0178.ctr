

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Lenaneo taolo-ea-mohopolo: 0.

>> txt := ['Word Salad'].
Sephetho ngola: ['last index of ord = '] + (( txt boemo-ba-ho-qetela: ['ord'] ) - 0), mola-o-mocha.
Sephetho ngola: ['index of ord = '] + (( txt fumana: ['ord'] ) - 0), mola-o-mocha.
Sephetho ngola: ['index of ad = '] + (( txt fumana: ['ad'] ) - 0), mola-o-mocha.
Sephetho ngola: ['last index of W = '] + (( txt boemo-ba-ho-qetela: ['W'] ) - 0), mola-o-mocha.
Sephetho ngola: ['last index of d = '] + (( txt boemo-ba-ho-qetela: ['d'] ) - 0), mola-o-mocha.
Sephetho ngola: ['txt equals Word Salad = '] + ( txt = ['Word Salad'] ), mola-o-mocha.
Sephetho ngola: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), mola-o-mocha.
Sephetho ngola: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), mola-o-mocha.
Sephetho ngola: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), mola-o-mocha.

Lenaneo hloekisa.

usedMemory1 := (Lenaneo mohopolo ? 0).


