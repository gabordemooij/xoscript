>> str := ['write:'].
Sephetho molaetsa: ['ngola:'] likenyo: (Lethathamo ← ['Hello World']), mola-o-mocha. 

Palo ha-ho-fihla: ['isbetween:and:'] etsa: { :a :b <- ((uena ≥ a) le: (uena ≤ b)).
}.

str := ['isbetween:and:'].
Sephetho ngola: (3 molaetsa: str likenyo: (Lethathamo ← 2 ; 8)), mola-o-mocha.
Sephetho ngola: (3 molaetsa: str likenyo: (Lethathamo ← 1 ; 2)), mola-o-mocha.


>> CoffeeMachine := Ntho ncha.
CoffeeMachine ha-ho-fihla: ['makeCoffeeWithSugar:milk:'] etsa: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Lethathamo ← 4 ; 2.
Sephetho ngola: ( CoffeeMachine molaetsa: order likenyo: coffeeConfiguration ), mola-o-mocha.
