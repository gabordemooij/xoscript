

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Lenaneo taolo-ea-mohopolo: 0.

>> txt := ['Word Salad'].
Sephetho ngola: ['Text Length: '] + txt bolelele, mola-o-mocha.
Sephetho ngola: ['Character at 2:'] + ( txt tlhaku: 2 ), mola-o-mocha.
Sephetho ngola: (( txt fumana: ['S'] ) - 0), mola-o-mocha.

Lenaneo hloekisa.

usedMemory1 := (Lenaneo mohopolo ? 0).


txt := ['Word Salad'].
Sephetho ngola: ['Text Length: '] + txt bolelele, mola-o-mocha.
Sephetho ngola: ['Character at 2:'] + ( txt tlhaku: 2 ), mola-o-mocha.
Sephetho ngola: (( txt fumana: ['S'] ) - 0), mola-o-mocha.

Lenaneo hloekisa.
usedMemory2 := (Lenaneo mohopolo ? 0).


txt := ['Word Salad'].
Sephetho ngola: ['Text Length: '] + txt bolelele, mola-o-mocha.
Sephetho ngola: ['Character at 2:'] + ( txt tlhaku: 2 ), mola-o-mocha.
Sephetho ngola: (( txt fumana: ['S'] ) - 0), mola-o-mocha.

Lenaneo hloekisa.
usedMemory3 := (Lenaneo mohopolo ? 0).



( usedMemory1 = usedMemory2 le: usedMemory1 = usedMemory3, le: usedMemory2 = usedMemory3 ) nnete: {
	Sephetho ngola: ['No memory leaks here'].
}, leshano: {
	Sephetho ngola: ['Leaking memory...'].
}.
