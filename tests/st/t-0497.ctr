Server init.

# write a test file
>> f := Faele ncha: ['/tmp/test.gif'].
f ngola: ['GIF87a01234567810'].

# serve the file
Server fetisa: ['test.gif'] sehlongoapele: ['/tmp/'].

Sephetho mola-o-mocha.

Sephetho ngola: ['Outside container (security):'], mola-o-mocha.
{ Server fetisa: ['../passwd'] sehlongoapele: ['/tmp/']. }
tšoasa: { :e Sephetho ngola: e, mola-o-mocha. },
qala.

Sephetho ngola: ['Invalid prefix:'], mola-o-mocha.
{ Server fetisa: ['test.gif'] sehlongoapele: ['z:\\']. }
tšoasa: { :e Sephetho ngola: e, mola-o-mocha. },
qala.

Sephetho ngola: ['Non-existant file:'], mola-o-mocha.
{ Server fetisa: ['xxx.xxx'] sehlongoapele: ['/tmp/']. }
tšoasa: { :e Sephetho ngola: e, mola-o-mocha. },
qala.
