# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Paterone ncha: pattern.
	p tumellano: subject etsa: { :m :g
		Sephetho ngola: g palo-ea-lintho, ngola: [' '], ngola: (g kopanya: ['|']), mola-o-mocha. <- m.
	}.
}.
show sebelisa-ho: ['(a)|(b)'] le: ['b'].
show sebelisa-ho: ['(a)|(b)'] le: ['a'].
show sebelisa-ho: ['(x)?y'] le: ['y'].
show sebelisa-ho: ['(x)?(y)(z)?'] le: ['xy'].
