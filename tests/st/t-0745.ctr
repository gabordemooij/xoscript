Sephetho ngola: ['Test object'], mola-o-mocha.
>> a := Ntho ncha. 

a ha-ho-fihla: ['item:'] etsa: { :dict
	ea-hao dict := dict. 
}.

a ha-ho-fihla: ['item'] etsa: { <- ea-hao dict.
}.

a item: (
Bukantswe ncha
	hello: ['world']).

>> old-dict-address := a item mohlala-oa-pele aterese-ea-mohopolo.
a save-as: ['/tmp/a.bin'].
Sephetho ngola: ['========== RELOADING SNAP:'], mola-o-mocha.

>> b := Ntho load-from: ['/tmp/a.bin'].

(b item mohlala-oa-pele aterese-ea-mohopolo = old-dict-address) nnete: {
	Sephetho ngola: ['Object link re-attached.'], mola-o-mocha.
