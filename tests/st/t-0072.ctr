>> echo := Ntho ncha.
echo ha-ho-fihla: ['araba:'] etsa: { :sound
	{ Sephetho ngola: sound. } × 2.
}.
echo ho!. 


echo := Ntho ncha.
echo ha-ho-fihla: ['araba:le:'] etsa: { :sound :x
	{ Sephetho ngola: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := Ntho ncha.
echo ha-ho-fihla: ['araba:le:le:'] etsa: { :operation :sound :x
	{ Sephetho ngola: sound. } × x.
}.
echo shout: ['la'] times: 4. 


