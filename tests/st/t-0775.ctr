Sephetho ngola: ['Test object'], mola-o-mocha.
>> l := Lethathamo ncha ; 1 ; ( Lethathamo ncha ; (Motsotso-nako ncha: 1) ; (Int64 ho-tsoa-mongolong: ['321']) ; (Lethathamo ncha ; 3)).
Sephetho ngola: l, mola-o-mocha.
>> old-lst-address := l mohlala-oa-pele aterese-ea-mohopolo.
l save-as: ['/tmp/a.bin'].
Sephetho ngola: ['========== RELOADING SNAP:'], mola-o-mocha.
>> b := Ntho load-from: ['/tmp/a.bin'].
(b mohlala-oa-pele aterese-ea-mohopolo = old-lst-address) nnete: {
	Sephetho ngola: ['Object link re-attached.'], mola-o-mocha.
}.
Sephetho ngola: b, mola-o-mocha.
