

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> x := 100.

Lenaneo taolo-ea-mohopolo: 0.

{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt eketsa-qetellong: ['!!'].
Sephetho ngola: txt.
} qala.

Lenaneo hloekisa.

usedMemory1 := (Lenaneo mohopolo ? 0).


{
>> txt := ['hello '] + ['world'].
