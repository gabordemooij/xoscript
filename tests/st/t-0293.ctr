
>> city := Lethathamo ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Lethathamo ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature ho-latela: city.
>> cities := weather linotlolo hlopha: { :a :b <- (a bapisa: b). }.
>> temperatures := weather boleng-bohle hlopha: { :a :b <- (a bapisa: b) ka-tlase-ho-lefela?. }.

Sephetho ngola: (cities kopanya: [',']), mola-o-mocha.
Sephetho ngola: (temperatures kopanya: [',']), mola-o-mocha.
