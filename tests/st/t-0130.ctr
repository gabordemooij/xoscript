# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Lenaneo tlhophiso: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server hokahanya: ( Lethathamo ncha ;
 libname ; ['fopen'] ;
 ( Lethathamo ncha ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
hokahanya: ( Lethathamo ncha ;
 Letho ; # means same lib
 ['fread'] ;
 ( Lethathamo ncha ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Letho ; # means same object (i.e. Stream)
 ['fread']
),
hokahanya: (
 Lethathamo ncha ;
 Letho ; # means same lib
 ['fwrite'] ;
 ( Lethathamo ncha ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Letho ; # means same lib
 ['fwrite']
),
hokahanya: (
 Lethathamo ncha ;
 Letho ; # means same lib
 ['rewind'] ;
 ( Lethathamo ncha ; ['pointer'] ) ;
 ['int'] ;
 Letho ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> tsela-ea-faele := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: tsela-ea-faele mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream molaetsa: ['fwrite'] likenyo: (Lethathamo ncha ; str ; 1 ; 6 ; fd ).
Sephetho ngola: bytes-written, mola-o-mocha.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob ncha: 20.

# read from file
>> bytes-read := Stream molaetsa: ['fread'] likenyo: (Lethathamo ncha ; buf ; 1 ; 6 ; fd ).
Sephetho ngola: bytes-read, mola-o-mocha.
Sephetho ngola: buf, mola-o-mocha.

# free memory
str  lokolla.
tsela-ea-faele lokolla.
mode lokolla.
buf  lokolla.


