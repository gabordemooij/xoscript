
>> countries := Lethathamo ncha
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Lethathamo ncha
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods ho-latela: countries, e-ngoe-le-e-ngoe: { :key :value
	counter eketsa: 1.
}.

Sephetho ngola: (['we serve counter dishes'] counter: counter), mola-o-mocha.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] litlhaku hlopha: { :v
	counter eketsa: 0.
}.

Sephetho ngola: (['we sort counter dishes'] counter: counter), mola-o-mocha.


>> counter := 0.
{
	{
		counter eketsa: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Sephetho ngola: (['we calculate counter numbers.'] counter: counter), mola-o-mocha.

