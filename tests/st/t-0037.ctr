>> a := 3.
>> b := a kopitsa.
a tlosa: 1.
Sephetho ngola: [' a = '] + a.
Sephetho ngola: [' b = '] + b.
a := 3.
b := a + 4.
Sephetho ngola: [' a = '] + a.
Sephetho ngola: [' b = '] + b.
>> x := 3.
>> y := x kopitsa.
x eketsa: 10.
y tlosa: 1.
Sephetho ngola: [' x = '] + x.
Sephetho ngola: [' y = '] + y.
>> q := Ntho ncha.
q ha-ho-fihla: ['setProperty:'] etsa: { :x
	ea-hao prop := x.
}.
q ha-ho-fihla: ['getProperty'] etsa: { <- ea-hao prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Sephetho ngola: [' p = '] + (p getProperty).
