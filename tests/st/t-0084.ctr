>> makeAdder := { :x
	>> f := { :y <- (ea-hao x + y). } beha: ['x'] boleng: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i ea-hao q beha: (ea-hao f sebelisa-ho: (ea-hao q ? i)) sebakeng: i. } 
	beha: ['q'] boleng: array,
	beha: ['f'] boleng: func.
	{ :i mapping sebelisa-ho: i. } × (array palo-ea-lintho).
}.

>> a := Lethathamo ← 1; 2; 3.
mapper sebelisa-ho: a le: (makeAdder sebelisa-ho: 100).
Sephetho ngola: (a boemo: 0), mola-o-mocha.
Sephetho ngola: (a ? 1), mola-o-mocha.
Sephetho ngola: (a ? 2), mola-o-mocha.
