>> HTML := Ntho ncha.
HTML ha-ho-fihla: ['araba:'] etsa: { :tag 
	Sephetho ngola: (['<tag>'] tag: tag), mola-o-mocha.
}.
HTML ha-ho-fihla: ['araba:le:'] etsa: { :tag :html 
	Sephetho ngola: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), mola-o-mocha.
}.
>> html := HTML ncha.
html body h1: ['header'].

