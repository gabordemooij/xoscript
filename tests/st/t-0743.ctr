>> V := Ntho.
V ha-ho-fihla: ['mongolo'] etsa: {
	Sephetho ngola: ['cast'], mola-o-mocha. <- ['abc'].
}.

Sephetho ngola: ( Lenaneo tlhophiso: ['abc'] ), mola-o-mocha.

# params should not get gc'ed
Lenaneo tlhophiso: ([''] + V ncha) boleng: ([''] + V ncha).

Sephetho ngola: ( Lenaneo tlhophiso: ['abc'] ), mola-o-mocha.
