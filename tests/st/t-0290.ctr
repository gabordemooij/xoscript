# test list operations


>> cakes := Lethathamo ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes nkela-sebaka: 1 bolelele: 2 ka: ( Lethathamo ← ['cinnamon'] ; ['pineapple'] ).
Sephetho ngola: (buy kopanya: [',']), mola-o-mocha.


>> buy := cakes nkela-sebaka: 1 bolelele: 12 ka: ( Lethathamo ← ['cinnamon'] ; ['pineapple'] ).
Sephetho ngola: (buy kopanya: [',']), mola-o-mocha.


>> buy := cakes nkela-sebaka: 2 bolelele: 10 ka: ( Lethathamo ncha ).
Sephetho ngola: (buy kopanya: [',']), mola-o-mocha.


>> buy := cakes nkela-sebaka: 0 bolelele: 1 ka: ( Lethathamo ncha ).
Sephetho ngola: (buy kopanya: [',']), mola-o-mocha.


>> buy := cakes nkela-sebaka: ['0'] bolelele: ['1'] ka: ['x'].
Sephetho ngola: (buy kopanya: [',']), mola-o-mocha.
