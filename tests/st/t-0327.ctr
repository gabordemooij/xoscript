

Lethathamo ha-ho-fihla: ['fixture:'] etsa: { :f
	ea-hao fixture := f.
}.

Lethathamo ha-ho-fihla: ['palo-ea-lintho'] etsa: { <- ea-hao fixture.
}.

Lethathamo ha-ho-fihla: ['aantal'] etsa: { <- ea-hao fixture.
}.


>> x := Letho.
{

	x := ['hello'] 
	nkela-sebaka:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] tlhaku: 2)
			)
		)
	ka: (
		(['...hal'] + ['lo']) 
			litlhaku-tse-kholo 
			lowecase 
			litlhaku-tse-kholo 
			tlola: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Lethathamo ← 0 ; 1 ; 4; 9 ; (Lethathamo ← 0 ; 3; 1) ; 4
							) pele-ho-ea-ho-qetela
						) ? 1
					) + 
					((Lethathamo ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					palo-ea-lintho
				)
			)
	).

} × 10.
Sephetho ngola: x, mola-o-mocha.

