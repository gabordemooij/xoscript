>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Ntho ncha.
⚄ ha-ho-fihla: ['drawFrom:length:'] etsa: { :pool :palo-ea-lintho
	
	>> result := [''].
	
	{
		>> index := Palo random % (pool bolelele).
		result eketsa-qetellong: ( pool tlhaku: (index + 1) ).
		
	} × palo-ea-lintho. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? bolelele.
Sephetho ngola: (['x↵'] x random bolelele).
Sephetho ngola: (['y↵'] y ?? bolelele).

