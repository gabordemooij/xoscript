>> Point := Ntho ncha.
Point ha-ho-fihla: ['x-coordinate:'] etsa: { :x ea-hao x := x. }.
Point ha-ho-fihla: ['y-coordinate:'] etsa: { :y ea-hao y := y. }.
Point ha-ho-fihla: ['x-coordinate']  etsa: { <- ea-hao x kopitsa. }.
Point ha-ho-fihla: ['y-coordinate']  etsa: { <- ea-hao y kopitsa. }.

Point ha-ho-fihla: ['='] etsa: { :other <- ( ea-hao x = other x-coordinate
		 le: ea-hao y = other y-coordinate ).
}.

>> pier := Point ncha x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point ncha x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point ncha x-coordinate: 5, y-coordinate: 6.

Sephetho ngola: pier = town-hall, mola-o-mocha.
Sephetho ngola: pier = restaurant, mola-o-mocha.
