
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> khoutu := {
	>> o := (
		Bukantswe ncha
		aa: (Lethathamo ← 1 ; 2),
		bb: (Lethathamo ← 3 ; 4)
	).
	>> s := o mongolo.
	>> o2 := s ntho.
	(s  mofuta = Mongolo mofuta) nnete: { Sephetho ngola: ['OK1'], mola-o-mocha. }.
	(o2 mofuta = Bukantswe mofuta) nnete: { Sephetho ngola: ['OK2'], mola-o-mocha. }.
}.

Lenaneo taolo-ea-mohopolo: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Lenaneo hloekisa.
usedMemory1 := (Lenaneo mohopolo ? 1).
khoutu qala.
Lenaneo hloekisa.
usedMemory2 := (Lenaneo mohopolo ? 1).
khoutu qala.
Lenaneo hloekisa.
usedMemory3 := (Lenaneo mohopolo ? 1).
khoutu qala.
Lenaneo hloekisa.
usedMemory4 := (Lenaneo mohopolo ? 1).

(usedMemory2 = usedMemory3 = usedMemory4) nnete: { Sephetho ngola: ['OK3'], mola-o-mocha. }.
 
