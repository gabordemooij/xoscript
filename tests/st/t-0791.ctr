Server init.

>> DB := Maria-DB ncha moamoheli: ['localhost'],
	lebitso-la-mosebelisi: ['xo'],
	phasewete: ['pass123'],
	lebitso-la-database: ['xobase'],
	hokela.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> liparamente-tsa-patlo := Potso-Maria ncha: SQL.

# set database
liparamente-tsa-patlo database: DB.

liparamente-tsa-patlo lata: { :row
	Sephetho ngola: row world, mola-o-mocha.
}.
