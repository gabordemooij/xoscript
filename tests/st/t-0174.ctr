


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Lenaneo taolo-ea-mohopolo: 0.
>> palette := Letho.
>> colors := Letho.

{
palette := Bukantswe ncha.
palette 
	beha: ['#F00'] sebakeng: ['red'],
	beha: ['#0F0'] sebakeng: ['green'],
	beha: ['#00F'] sebakeng: ['blue'].
Sephetho ngola: ['number of RGB codes in palette: '] + ( palette palo-ea-lintho ), mola-o-mocha.
Sephetho ngola: ['RGB code of green is: '] + ( palette ? ['green'] ), mola-o-mocha.
colors := [''].
( palette e-ngoe-le-e-ngoe: { :lebitso :khoutu
		colors := colors + ( lebitso + [':'] + khoutu ).
} ).
Sephetho ngola: ['All colors in palette: '] + colors, mola-o-mocha.
} qala.
Lenaneo hloekisa.
usedMemory1 := (Lenaneo mohopolo ? 0).

{
palette := Bukantswe ncha.
palette 
	beha: ['#F00'] sebakeng: ['red'],
	beha: ['#0F0'] sebakeng: ['green'],
	beha: ['#00F'] sebakeng: ['blue'].
Sephetho ngola: ['number of RGB codes in palette: '] + ( palette palo-ea-lintho ), mola-o-mocha.
Sephetho ngola: ['RGB code of green is: '] + ( palette ? ['green'] ), mola-o-mocha.
colors := [''].
( palette e-ngoe-le-e-ngoe: { :lebitso :khoutu
		colors := colors + ( lebitso + [':'] + khoutu ).
} ).
Sephetho ngola: ['All colors in palette: '] + colors, mola-o-mocha.
} qala.
Lenaneo hloekisa.
usedMemory2 := (Lenaneo mohopolo ? 0).

{
palette := Bukantswe ncha.
palette 
	beha: ['#F00'] sebakeng: ['red'],
	beha: ['#0F0'] sebakeng: ['green'],
	beha: ['#00F'] sebakeng: ['blue'].
Sephetho ngola: ['number of RGB codes in palette: '] + ( palette palo-ea-lintho ), mola-o-mocha.
Sephetho ngola: ['RGB code of green is: '] + ( palette ? ['green'] ), mola-o-mocha.
colors := [''].
( palette e-ngoe-le-e-ngoe: { :lebitso :khoutu
		colors := colors + ( lebitso + [':'] + khoutu ).
} ).
Sephetho ngola: ['All colors in palette: '] + colors, mola-o-mocha.
} qala.
Lenaneo hloekisa.
usedMemory3 := (Lenaneo mohopolo ? 0).



( usedMemory1 = usedMemory2 le: usedMemory1 = usedMemory3, le: usedMemory2 = usedMemory3 ) nnete: {
	Sephetho ngola: ['No memory leaks here'].
}, leshano: {
	Sephetho ngola: ['Leaking memory...'].
}.
