Palo ha-ho-fihla: ['factorial'] etsa: {
	>> total := 1.
	{ :index total ngata-ka: (uena - (index)). } × uena. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Sephetho ngola: a.
>> b := 2 + 3 factorial.
Sephetho ngola: b.
>> c := 3 factorial + 2.
Sephetho ngola: c.
>> d := 2 + (3 factorial).
Sephetho ngola: d.
Sephetho ngola: 2 + 3 factorial + 1.
