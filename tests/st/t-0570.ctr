#Linux

 >> t := Motsotso-nako ncha.
 
t sebaka-sa-nako: ['Europe/Amsterdam'].
t selemo: 2020, khoeli: 8, letsatsi: 2, hora: 21, motsotso: 2, motsotsoana: 1.

>> a := t hora.
>> ams := t sebaka-sa-nako.

t sebaka-sa-nako: ['US/Hawaii'].
>> b := t hora.
>> hw := t sebaka-sa-nako.

Sephetho
ngola: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		ena: ['later'] kapa-eane: ['earlier']
	)
),
mola-o-mocha.
 