Server init.
>> fmt := Sebopeho ncha: ['%#3x'].

>> blob := Blob ncha: 4.
blob bytes: ( 
	Lethathamo ncha ; 0 ; 1 ; 2 ; 3
).

>> file := Faele ncha: ['/tmp/blob'].
file blob: blob.
blob lokolla.

>> bala := file blob.
bala 
ho-tloha: 0 
bolelele: 4, 
etsa e-ngoe-le-e-ngoe: { :i :b 
	Sephetho
	ngola: (fmt sebelisa-ho-palo-e-felletseng: b),
	mola-o-mocha.
}.
bala lokolla.
