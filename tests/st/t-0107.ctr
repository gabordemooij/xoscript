
Sephetho ngola: ['Break for-loop, 0-4.'], mola-o-mocha.
{ :i
	Sephetho ngola: ['iteration #'] + i, mola-o-mocha.
	(i = 4) khaola.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Sephetho ngola: ['Break while-true loop, 0-4.'], mola-o-mocha.
{
	Sephetho ngola: ['iteration #'] + x, mola-o-mocha.
	x eketsa: 1.
	((x < 5) eseng) khaola.
} ha-feela: xIsLessThan10.

Sephetho ngola: ['Break while-false loop, 5,4.'], mola-o-mocha.
{
	Sephetho ngola: ['iteration #'] + x, mola-o-mocha.
	x tlosa: 1.
	(x = 3) khaola.
} ha-feela: { <- (x > 0). }.

Sephetho ngola: ['Break times loop, 1-4.'], mola-o-mocha.
{ :i
	Sephetho ngola: ['iteration #'] + i, mola-o-mocha.
	(i = 4) khaola.
} × 5.

Sephetho ngola: ['Break block, dont print line.'], mola-o-mocha.
{ Nnete khaola. Sephetho ngola: ['dont write this!'], mola-o-mocha. } qala.

Sephetho ngola: ['Break block, dont fire catch...'], mola-o-mocha.
{ Nnete khaola. Sephetho ngola: ['dont write this!'], mola-o-mocha. } tšoasa: { Sephetho ngola: ['Dont catch this!']. }, qala.

Sephetho ngola: ['Test Array each-loop: 0,1'], mola-o-mocha.
(Lethathamo ← 1 ; 2 ; 3) fetola-e-ngoe-le-e-ngoe: { :i
	Sephetho ngola: ['iteration #'] + i, mola-o-mocha.
	(i = 1) khaola.
}.

Sephetho ngola: ['Test Map each-loop: c only'], mola-o-mocha.
>> m := Bukantswe ncha.
m beha: ['first'] sebakeng: ['a'], beha: ['second'] sebakeng: ['b'], beha: ['third'] sebakeng: ['c'].
m e-ngoe-le-e-ngoe: { :k :v
	Sephetho ngola: ['iteration'] + v + k, mola-o-mocha.
	Nnete khaola.
}.

