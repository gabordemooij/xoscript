>> usedMemory5 := (Lenaneo mohopolo ? 0).




(usedMemory1 = usedMemory2 = usedMemory3 = usedMemory4 = usedMemory5) nnete: { 
	Sephetho ngola: ['Memory usage remains stable.'], mola-o-mocha.
}, ho-seng-joalo: {
	Sephetho ngola: ['Used memory not stable.'], mola-o-mocha.
