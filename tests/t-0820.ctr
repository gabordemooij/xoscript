# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Pattern new: pattern.
	p match: subject do: { :m :g
		Out write: g count, write: [' '], write: (g combine: ['|']), stop.
		<- m.
	}.
}.
show apply: ['(a)|(b)'] and: ['b'].
show apply: ['(a)|(b)'] and: ['a'].
show apply: ['(x)?y'] and: ['y'].
show apply: ['(x)?(y)(z)?'] and: ['xy'].
