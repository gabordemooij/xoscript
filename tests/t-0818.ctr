# edge cases from a request must give an error or a result, not a crash
Server init.

Out write: ['<'] + (['abc'] from: 0 length: 0, upper) + ['>'], stop.
Out write: ['<'] + (['abc'] from: 0 length: 0, lower) + ['>'], stop.
Out write: ['<'] + (['abc'] offset: 3, upper) + ['>'], stop.
Out write: [''] upper bytes, stop.
Out write: ['aB'] upper, stop.
Out write: ['aB'] lower, stop.

Out write: (Moment new: 0) year, stop.
{ Moment new: ['9e300'] number. } except: { :e Out write: e, stop. }, start.
{ Moment new: ['-9e300'] number. } except: { :e Out write: e, stop. }, start.
{ Moment new: ['nan'] number. } except: { :e Out write: e, stop. }, start.
{ Moment new: 9000000000000000000. } except: { :e Out write: e, stop. }, start.
