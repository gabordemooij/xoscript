Zvabuda nyora: ['1,2,3,4,5,6,7,8,9,A,'], mutsara-mutsva.
>> Scope := Chinhu nyowani.
Scope kana-zvasvika: ['initialize:'] ita: { :x zvako property := x. }.
Scope kana-zvasvika: ['confirm'] ita: { Zvabuda nyora: [',']. }.
Scope kana-zvasvika: ['bvunzo'] ita: {
	Zvabuda nyora: zvako property.
	pachako confirm.
	( 1 = 1 ) chokwadi: { Zvabuda nyora: zvako property. pachako confirm. }.
	( 1 = 0 ) nhema: { Zvabuda nyora: zvako property. pachako confirm. }.
	>> y := 2. { Zvabuda nyora: zvako property. pachako confirm. } kusvikira: { y bvisa-nhamba: 1. <- (y > 0). }.
	{ Zvabuda nyora: zvako property. pachako confirm. } × 1.
	(Rondedzero ← 1) chimwe-nechimwe: {  Zvabuda nyora: zvako property. pachako confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Duramazwi nyowani one: ['item']) chimwe-nechimwe: { Zvabuda nyora: zvako property. pachako confirm. }.
	{ 1 ÷ 0. } bata: { Zvabuda nyora: zvako property. pachako confirm. }, tanga.
	Zvabuda mutsara-mutsva.
}.
>> scope1 := Scope nyowani.
scope1 initialize: ['X'].
scope1 bvunzo.
>> function := { 
	zvako property := ['Y'].
	Zvabuda nyora: zvako property.
	pachako confirm.
	( 1 = 1 ) chokwadi: { Zvabuda nyora: zvako property. pachako confirm. }.
	( 1 = 0 ) nhema: { Zvabuda nyora: zvako property. pachako confirm. }.
	>> y := 2. { Zvabuda nyora: zvako property. pachako confirm. } kusvikira: { y bvisa-nhamba: 1. <- (y > 0). }.
	{ Zvabuda nyora: zvako property. pachako confirm. } × 1.
	(Rondedzero ← 1) chimwe-nechimwe: {  Zvabuda nyora: zvako property. pachako confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Duramazwi nyowani one: ['item']) chimwe-nechimwe: { Zvabuda nyora: zvako property. pachako confirm. }.
	{ 1 ÷ 0. } bata: { Zvabuda nyora: zvako property. pachako confirm. }, tanga.
	Zvabuda mutsara-mutsva.
}.
function kana-zvasvika: ['confirm'] ita: { Zvabuda nyora: [',']. }.
function shandisa: 1 uye: 2.
