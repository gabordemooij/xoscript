
Mavara kana-zvasvika: ['evaluate'] ita: {
	>> kodhi := Faira nyowani: ['/tmp/eval.ctr'].
	kodhi nyora: (pachako mavara-emashoko + ['.']).
	Chirongwa shandisa-chishandiso: ['/tmp/eval.ctr'].
}.

>> map :=
	(Duramazwi nyowani)
	isa: ['Hi There'] pa: ['two'],
	isa: (Rondedzero ← ['hello'] ; ['world'] ; (Rondedzero ← 1 ; 2; 9) ; Nhema) pa: ['one'],
	isa: ( (Duramazwi nyowani) isa: ['wrrld'] pa: ['misspelled'] ) pa: ['three'],
	isa: (Rondedzero ← ((Duramazwi nyowani) isa: ['treasure'] pa: ['hidden']) ; 2) pa: ['four']. 
>> str := map mavara-emashoko.
>> map2 := Hapana.
(['map2 := '] + str ) evaluate.
Zvabuda nyora: map2 ? ['one'] ? 0.
Zvabuda nyora: map2 ? ['one'] ? 1.
Zvabuda nyora: map2 ? ['four'] ? 0 ? ['hidden'].
Zvabuda nyora: map2 ? ['one'] ? 2 ? 2.
