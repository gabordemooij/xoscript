>> x := Chinhu nyowani.
>> y := Chinhu nyowani.
>> z := x.
Zvabuda nyora: (x = z), mutsara-mutsva.
Zvabuda nyora: (x = y), mutsara-mutsva.
Zvabuda nyora: (x ≠ y), mutsara-mutsva.
Zvabuda nyora: (x ≠ z), mutsara-mutsva.
>> m := Nguva-chaiyo nyowani gore: 2070, mwedzi: 11.
>> n := m kopa.
Zvabuda nyora: (m = n), mutsara-mutsva.
Zvabuda nyora: (m ≠ n), mutsara-mutsva.
Zvabuda nyora: (m zvakafanana: m), mutsara-mutsva.
Zvabuda nyora: (m zvakafanana: n), mutsara-mutsva.
n mwedzi: 12.
Zvabuda nyora: (m ≠ n), mutsara-mutsva.
Zvabuda nyora: (m = n), mutsara-mutsva.


