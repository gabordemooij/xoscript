
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> kodhi := {
	>> o := (
		Duramazwi nyowani
		aa: (Rondedzero ← 1 ; 2),
		bb: (Rondedzero ← 3 ; 4)
	).
	>> s := o mavara-emashoko.
	>> o2 := s chinhu.
	(s  mhando = Mavara mhando) chokwadi: { Zvabuda nyora: ['OK1'], mutsara-mutsva. }.
	(o2 mhando = Duramazwi mhando) chokwadi: { Zvabuda nyora: ['OK2'], mutsara-mutsva. }.
}.

Chirongwa kutonga-ndangariro: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Chirongwa chenesa.
usedMemory1 := (Chirongwa ndangariro ? 1).
kodhi tanga.
Chirongwa chenesa.
usedMemory2 := (Chirongwa ndangariro ? 1).
kodhi tanga.
Chirongwa chenesa.
usedMemory3 := (Chirongwa ndangariro ? 1).
kodhi tanga.
Chirongwa chenesa.
usedMemory4 := (Chirongwa ndangariro ? 1).

(usedMemory2 = usedMemory3 = usedMemory4) chokwadi: { Zvabuda nyora: ['OK3'], mutsara-mutsva. }.
 
