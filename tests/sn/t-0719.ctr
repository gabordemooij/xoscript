Server init.
>> fmt := Chimiro nyowani: ['%#3x'].

>> blob := Blob nyowani: 4.
blob bytes: ( 
	Rondedzero nyowani ; 0 ; 1 ; 2 ; 3
).

>> file := Faira nyowani: ['/tmp/blob'].
file blob: blob.
blob sunungura.

>> verenga := file blob.
verenga 
kubva: 0 
kureba: 4, 
ita chimwe-nechimwe: { :i :b 
	Zvabuda
	nyora: (fmt shandisa-nhamba-izere: b),
	mutsara-mutsva.
}.
verenga sunungura.
