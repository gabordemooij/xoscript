

Rondedzero kana-zvasvika: ['sum'] ita: {
	>> total := 0.
	pachako chimwe-nechimwe: { :index :element
		total wedzera: element.
	}. <- total.
}.

Rondedzero kana-zvasvika: ['product'] ita: {
	>> total := 1.
	pachako chimwe-nechimwe: { :index :element
		total wanza-ne: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Chirongwa kutonga-ndangariro: 0.

{

>> a := Rondedzero ← ['hello'] ; ['world'] ; Chokwadi ; Hapana ; 666.
a := a + ( Rondedzero ← 1 ).
Zvabuda nyora: ( ['sum: '] + ( a sum ) ), mutsara-mutsva.
Zvabuda nyora: ( ['min: '] + ( a diki-diki ) ), mutsara-mutsva.
Zvabuda nyora: ( ['max: '] + ( a huru-huru ) ), mutsara-mutsva.
Zvabuda nyora: ( ['3rd: '] + ( a ? 2 ) ), mutsara-mutsva.
Zvabuda nyora: ( ['prd: '] + ( a product ) ), mutsara-mutsva.
a ronga: { :a :b <- (b - a). }.
a chimwe-nechimwe: { :i :e Zvabuda nyora: ( i - 0 ), mutsara-mutsva. }.

} tanga.

Chirongwa chenesa.
usedMemory1 := (Chirongwa ndangariro ? 0).


{

>> a := Rondedzero ← ['hello'] ; ['world'] ; Chokwadi ; Hapana ; 666.
a := a + ( Rondedzero ← 1 ).
Zvabuda nyora: ( ['sum: '] + ( a sum ) ), mutsara-mutsva.
Zvabuda nyora: ( ['min: '] + ( a diki-diki ) ), mutsara-mutsva.
Zvabuda nyora: ( ['max: '] + ( a huru-huru ) ), mutsara-mutsva.
Zvabuda nyora: ( ['3rd: '] + ( a ? 2 ) ), mutsara-mutsva.
Zvabuda nyora: ( ['prd: '] + ( a product ) ), mutsara-mutsva.
a ronga: { :a :b <- (b - a). }.
a chimwe-nechimwe: { :i :e Zvabuda nyora: ( i - 0 ), mutsara-mutsva. }.

} tanga.



Chirongwa chenesa.
usedMemory2 := (Chirongwa ndangariro ? 0).


{

>> a := Rondedzero ← ['hello'] ; ['world'] ; Chokwadi ; Hapana ; 666.
a := a + ( Rondedzero ← 1 ).
Zvabuda nyora: ( ['sum: '] + ( a sum ) ), mutsara-mutsva.
Zvabuda nyora: ( ['min: '] + ( a diki-diki ) ), mutsara-mutsva.
Zvabuda nyora: ( ['max: '] + ( a huru-huru ) ), mutsara-mutsva.
Zvabuda nyora: ( ['3rd: '] + ( a ? 2 ) ), mutsara-mutsva.
Zvabuda nyora: ( ['prd: '] + ( a product ) ), mutsara-mutsva.
a ronga: { :a :b <- (b - a). }.
a chimwe-nechimwe: { :i :e Zvabuda nyora: ( i - 0 ), mutsara-mutsva. }.

} tanga.



Chirongwa chenesa.
usedMemory3 := (Chirongwa ndangariro ? 0).

( usedMemory1 = usedMemory2 uye: usedMemory1 = usedMemory3, uye: usedMemory2 = usedMemory3 ) chokwadi: {
	Zvabuda nyora: ['No memory leaks here'].
}, nhema: {
	Zvabuda nyora: ['Leaking memory...'].
}.
