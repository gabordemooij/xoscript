
Zvabuda nyora: ['Break for-loop, 0-4.'], mutsara-mutsva.
{ :i
	Zvabuda nyora: ['iteration #'] + i, mutsara-mutsva.
	(i = 4) gura.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Zvabuda nyora: ['Break while-true loop, 0-4.'], mutsara-mutsva.
{
	Zvabuda nyora: ['iteration #'] + x, mutsara-mutsva.
	x wedzera: 1.
	((x < 5) kwete) gura.
} kusvikira: xIsLessThan10.

Zvabuda nyora: ['Break while-false loop, 5,4.'], mutsara-mutsva.
{
	Zvabuda nyora: ['iteration #'] + x, mutsara-mutsva.
	x bvisa-nhamba: 1.
	(x = 3) gura.
} kusvikira: { <- (x > 0). }.

Zvabuda nyora: ['Break times loop, 1-4.'], mutsara-mutsva.
{ :i
	Zvabuda nyora: ['iteration #'] + i, mutsara-mutsva.
	(i = 4) gura.
} × 5.

Zvabuda nyora: ['Break block, dont print line.'], mutsara-mutsva.
{ Chokwadi gura. Zvabuda nyora: ['dont write this!'], mutsara-mutsva. } tanga.

Zvabuda nyora: ['Break block, dont fire catch...'], mutsara-mutsva.
{ Chokwadi gura. Zvabuda nyora: ['dont write this!'], mutsara-mutsva. } bata: { Zvabuda nyora: ['Dont catch this!']. }, tanga.

Zvabuda nyora: ['Test Array each-loop: 0,1'], mutsara-mutsva.
(Rondedzero ← 1 ; 2 ; 3) shandura-chimwe-nechimwe: { :i
	Zvabuda nyora: ['iteration #'] + i, mutsara-mutsva.
	(i = 1) gura.
}.

Zvabuda nyora: ['Test Map each-loop: c only'], mutsara-mutsva.
>> m := Duramazwi nyowani.
m isa: ['first'] pa: ['a'], isa: ['second'] pa: ['b'], isa: ['third'] pa: ['c'].
m chimwe-nechimwe: { :k :v
	Zvabuda nyora: ['iteration'] + v + k, mutsara-mutsva.
	Chokwadi gura.
}.

