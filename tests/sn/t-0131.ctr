
>> a := Rondedzero ← (Rondedzero ← 100 ; 200 ; 300) ; (Rondedzero ← 9 ; 8 ; 7).
Zvabuda nyora: ['at 0,1 :'].
Zvabuda nyora: a ? 0 ? 1, mutsara-mutsva. 
Zvabuda nyora: ['at 1,2 :'].
Zvabuda nyora: a ? 1 ? 2, mutsara-mutsva. 
>> menu := Duramazwi nyowani.
menu isa: (Rondedzero ← ['pizza'] ; ['spaghetti']) pa: ['Italian Cuisine'].
menu isa: (Rondedzero ← ['bifteki'] ; ['suflaki']) pa: ['Greek Cuisine'].
Zvabuda nyora: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), mutsara-mutsva. 
Zvabuda nyora: ['but not on the same plate.'], mutsara-mutsva.
