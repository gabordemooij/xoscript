>> z := Chinhu nyowani.
z kana-zvasvika: ['value:'] ita: { :v
	zvako value := v. <- pachako.
}.
z kana-zvasvika: ['value'] ita: { <- zvako value. }.
(z setValue: 1) value: 2.
Zvabuda nyora: z value.
>> x := z.
Zvabuda nyora: x value.
