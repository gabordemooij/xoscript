Zvabuda nyora: ['Test object'], mutsara-mutsva.
>> a := Chinhu nyowani. 

a kana-zvasvika: ['item:'] ita: { :dict
	zvako dict := dict. 
}.

a kana-zvasvika: ['item'] ita: { <- zvako dict.
}.

a item: (
Duramazwi nyowani
	hello: ['world']).

>> old-dict-address := a item muenzaniso-wekutanga kero-yendangariro.
a save-as: ['/tmp/a.bin'].
Zvabuda nyora: ['========== RELOADING SNAP:'], mutsara-mutsva.

>> b := Chinhu load-from: ['/tmp/a.bin'].

(b item muenzaniso-wekutanga kero-yendangariro = old-dict-address) chokwadi: {
	Zvabuda nyora: ['Object link re-attached.'], mutsara-mutsva.
}.

Zvabuda nyora: b item, mutsara-mutsva.
