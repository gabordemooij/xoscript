>> Greeter := Chinhu nyowani.
Greeter kana-zvasvika: ['make'] ita: {
	>> greeter := Chinhu nyowani.
	greeter kana-zvasvika: ['name:'] ita: { :zita
		Zvabuda nyora: ['setting a name'].
		zvako myName := zita.
	}.
	greeter kana-zvasvika: ['greet'] ita: {
		Zvabuda nyora: ['Hello'].
		Zvabuda nyora: zvako myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
