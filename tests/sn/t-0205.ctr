>> str := ['write:'].
Zvabuda meseji: ['nyora:'] zvipinzwa: (Rondedzero ← ['Hello World']), mutsara-mutsva. 

Nhamba kana-zvasvika: ['isbetween:and:'] ita: { :a :b <- ((pachako ≥ a) uye: (pachako ≤ b)).
}.

str := ['isbetween:and:'].
Zvabuda nyora: (3 meseji: str zvipinzwa: (Rondedzero ← 2 ; 8)), mutsara-mutsva.
Zvabuda nyora: (3 meseji: str zvipinzwa: (Rondedzero ← 1 ; 2)), mutsara-mutsva.


>> CoffeeMachine := Chinhu nyowani.
CoffeeMachine kana-zvasvika: ['makeCoffeeWithSugar:milk:'] ita: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Rondedzero ← 4 ; 2.
Zvabuda nyora: ( CoffeeMachine meseji: order zvipinzwa: coffeeConfiguration ), mutsara-mutsva.
