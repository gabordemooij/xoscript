

>> obj := Chinhu nyowani.

obj kana-zvasvika: ['greet'] ita: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj kana-zvasvika: ['task'] ita: {
	zvako property := 123.
	{
		# try binds self/own to object instead of block
		Zvabuda nyora: pachako greet.
		Zvabuda nyora: zvako property.
		1 / 0.
	} bata: {
		Zvabuda nyora: pachako greet.
		Zvabuda nyora: zvako property.
