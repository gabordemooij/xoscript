>> a := 3.
>> b := a kopa.
a bvisa-nhamba: 1.
Zvabuda nyora: [' a = '] + a.
Zvabuda nyora: [' b = '] + b.
a := 3.
b := a + 4.
Zvabuda nyora: [' a = '] + a.
Zvabuda nyora: [' b = '] + b.
>> x := 3.
>> y := x kopa.
x wedzera: 10.
y bvisa-nhamba: 1.
Zvabuda nyora: [' x = '] + x.
Zvabuda nyora: [' y = '] + y.
>> q := Chinhu nyowani.
q kana-zvasvika: ['setProperty:'] ita: { :x
	zvako prop := x.
}.
q kana-zvasvika: ['getProperty'] ita: { <- zvako prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Zvabuda nyora: [' p = '] + (p getProperty).
