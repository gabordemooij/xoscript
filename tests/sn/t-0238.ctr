Mavara kana-zvasvika: ['evaluate'] ita: {
	>> kodhi := Faira nyowani: ['/tmp/eval.ctr'].
	kodhi nyora: (pachako mavara-emashoko + ['.']).
	Chirongwa shandisa-chishandiso: ['/tmp/eval.ctr'].
}.

>> a := Rondedzero ← 1 ; 2 ; 3.
>> b := (a mavara-emashoko).

Zvabuda nyora: b, mutsara-mutsva. 
(['b := '] + b) evaluate.

Zvabuda nyora: b ? 2, mutsara-mutsva. 

Zvabuda nyora: (( Rondedzero ← 1 ; 2 ; 3 )), mutsara-mutsva. 

Zvabuda nyora: ((Duramazwi nyowani) isa: 1 pa: 2), mutsara-mutsva. 

>> x := ( (Rondedzero ← 1 ; ( Rondedzero ← 9 ) ; Chokwadi ) ) mavara-emashoko.
Zvabuda nyora: x, mutsara-mutsva. 
(['x := '] + x) evaluate.

Zvabuda nyora: x ? 1 ? 0, mutsara-mutsva. 

>> y := (Duramazwi nyowani) isa: (Rondedzero ← 1) pa: (Rondedzero ← 2).
Zvabuda nyora: y, mutsara-mutsva. 

(['y := '] + y) mavara-emashoko evaluate.

Zvabuda nyora: (y pa: (Rondedzero ← 2) mavara-emashoko ), mutsara-mutsva.

Zvabuda nyora: (Rondedzero nyowani), mutsara-mutsva. 
Zvabuda nyora: (Duramazwi nyowani), mutsara-mutsva. 
