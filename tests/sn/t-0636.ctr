# test url parsing

Server init.
>> url := URL kwabva: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Zvabuda nyora: ['scheme = '] + url chirongwa-chekero, mutsara-mutsva.
Zvabuda nyora: ['host = '] + url mugamuchiri, mutsara-mutsva.
Zvabuda nyora: ['port = '] + url chiteshi, mutsara-mutsva.
Zvabuda nyora: ['path = '] + url nzira-yefaira, mutsara-mutsva.
