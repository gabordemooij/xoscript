Zvabuda nyora: ['Test object'], mutsara-mutsva.
>> l := Rondedzero nyowani ; 1 ; ( Rondedzero nyowani ; (Nguva-chaiyo nyowani: 1) ; (Int64 kubva-mumavara: ['321']) ; (Rondedzero nyowani ; 3)).
Zvabuda nyora: l, mutsara-mutsva.
>> old-lst-address := l muenzaniso-wekutanga kero-yendangariro.
l save-as: ['/tmp/a.bin'].
Zvabuda nyora: ['========== RELOADING SNAP:'], mutsara-mutsva.
>> b := Chinhu load-from: ['/tmp/a.bin'].
(b muenzaniso-wekutanga kero-yendangariro = old-lst-address) chokwadi: {
	Zvabuda nyora: ['Object link re-attached.'], mutsara-mutsva.
}.
Zvabuda nyora: b, mutsara-mutsva.
