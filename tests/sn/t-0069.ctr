

Mavara kana-zvasvika: ['html'] ita: { <- (
		pachako
		tsiva: ['&'] na: ['&amp;'],
		tsiva: ['<'] na: ['&lt;'],
		tsiva: ['>'] na: ['&gt;'],
		tsiva: ['"'] na: ['&quot;']
	).
}.


Zvabuda nyora: ([' left trimmed '] cheka-nzvimbo) + [' '] + ( ['and right trimmed'] cheka-nzvimbo) + ['!'], mutsara-mutsva.
Zvabuda nyora: ['<html>"html & entities"</html>'] html.
