>> makeAdder := { :x
	>> f := { :y <- (zvako x + y). } gadza: ['x'] kukosha: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i zvako q isa: (zvako f shandisa: (zvako q ? i)) pa: i. } 
	gadza: ['q'] kukosha: array,
	gadza: ['f'] kukosha: func.
	{ :i mapping shandisa: i. } × (array huwandu).
}.

>> a := Rondedzero ← 1; 2; 3.
mapper shandisa: a uye: (makeAdder shandisa: 100).
Zvabuda nyora: (a chinzvimbo: 0), mutsara-mutsva.
Zvabuda nyora: (a ? 1), mutsara-mutsva.
Zvabuda nyora: (a ? 2), mutsara-mutsva.
