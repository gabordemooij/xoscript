Rondedzero kana-zvasvika: ['sum'] ita: {
	>> total := 0.
	pachako chimwe-nechimwe: { :index :element
		total wedzera: element.
	}. <- total.
}.

>> a := Chokwadi.



a kana-zvasvika: ['mavara-emashoko'] ita: {
	>> answer := Hapana.
	( pachako = Chokwadi ) chokwadi: {
		answer := ['Yep'].
	}, kana-zvisiri: {
		answer := ['Nope'].
	}. <- answer.
}.

a kana-zvasvika: ['nhamba'] ita: {
	>> answer := Hapana.
	( pachako = Chokwadi ) chokwadi: {
		answer := 10.
	}, kana-zvisiri: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b kana-zvasvika: ['mavara-emashoko'] ita: { <- ['Devil'].
}.

b kana-zvasvika: ['bhuriyoni'] ita: { <- Nhema.
}.


Zvabuda nyora: a, mutsara-mutsva.  
Zvabuda nyora: (90 + a), mutsara-mutsva. 
Zvabuda nyora: b, mutsara-mutsva. 
Zvabuda nyora: (Chokwadi uye: b), mutsara-mutsva.

a := Rondedzero ← ['hello'] ; ['world'] ; Chokwadi ; Hapana ; 666. 
a := a + ( Rondedzero ← 1 ).
Zvabuda nyora: a, mutsara-mutsva.
Zvabuda nyora: ((Duramazwi nyowani) isa: Hapana pa: Hapana), mutsara-mutsva.
Zvabuda nyora: a sum, mutsara-mutsva. 


{
	a kana-zvasvika: ['mavara-emashoko'] ita: { <- Hapana. }.
	a := [''] + a.
} bata: { :error
	Zvabuda nyora: ['Error noted: '] + error, mutsara-mutsva.
}, tanga.



{
	a kana-zvasvika: ['nhamba'] ita: { <- Hapana. }.
	a := 3 × a.
} bata: { :error
	Zvabuda nyora: ['Error noted: '] + error, mutsara-mutsva.
}, tanga.


{
	a kana-zvasvika: ['bhuriyoni'] ita: { <- Hapana. }.
	a := Chokwadi uye: a. 
} bata: { :error
	Zvabuda nyora: ['Error noted: '] + error, mutsara-mutsva.
}, tanga.





{
	a kana-zvasvika: ['mavara-emashoko'] ita: { <- Nhema. }.
	a := [''] + a.
} bata: { :error
	Zvabuda nyora: ['Error noted: '] + error, mutsara-mutsva.
}, tanga.



