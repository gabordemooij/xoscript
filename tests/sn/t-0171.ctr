

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Chirongwa kutonga-ndangariro: 0.

>> a := Rondedzero ← ['hello'] ; ['world'] ; Chokwadi ; Hapana ; 666.
a ita tora-chekupedzisira tora-chekutanga wedzera-pakutanga: ['hi'], wedzera-kumagumo: 999, zvaitwa.
Zvabuda nyora: ( a batanidza: [','] ), mutsara-mutsva.

Chirongwa chenesa.
usedMemory1 := (Chirongwa ndangariro ? 0).


a := Rondedzero ← ['hello'] ; ['world'] ; Chokwadi ; Hapana ; 666.
a tora-chekupedzisira. a tora-chekutanga. a wedzera-pakutanga: ['hi'], wedzera-kumagumo: 999.
