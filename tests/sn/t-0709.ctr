# Can we use UTF8 in regex?
Server init.
>> p := Pateni nyowani: ['\\w'].
Zvabuda nyora: ( p kuenderana: ['x'] ), mutsara-mutsva.
Zvabuda nyora: ( p kuenderana: ['é'] ), mutsara-mutsva.
>> p := Pateni nyowani: ['(*UTF)(*UCP)\\w'].
Zvabuda nyora: ( p kuenderana: ['é'] ), mutsara-mutsva.
# should give 101