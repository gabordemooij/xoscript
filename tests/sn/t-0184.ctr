

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Chirongwa kutonga-ndangariro: 0.

Nhamba kana-zvasvika: ['addNum:'] ita: { :x
	pachako wedzera: x.
}.

Nhamba kana-zvasvika: ['subtractNum:'] ita: { :x
	pachako bvisa-nhamba: x.
}.

Nhamba kana-zvasvika: ['multiplyBy:'] ita: { :x
	pachako wanza-ne: x.
}.

Nhamba kana-zvasvika: ['divideBy:'] ita: { :x
	pachako govanisa-ne: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 simba-renhamba: 8).  
a := a + (2 simba-renhamba: -1). 
a := a + (49 mudzi-wesikweya).   
a addNum: ((Rondedzero ← 0 ; 1) huru-huru).          
a addNum: ((Rondedzero ← 2 ; 3) diki-diki).
Zvabuda nyora: a.

Chirongwa chenesa.

usedMemory1 := (Chirongwa ndangariro ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 simba-renhamba: 8).  
a := a + (2 simba-renhamba: -1). 
a := a + (49 mudzi-wesikweya).   
a addNum: ((Rondedzero ← 0 ; 1) huru-huru).          
a addNum: ((Rondedzero ← 2 ; 3) diki-diki).
Zvabuda nyora: a.

Chirongwa chenesa.
usedMemory2 := (Chirongwa ndangariro ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 simba-renhamba: 8).  
a := a + (2 simba-renhamba: -1). 
a := a + (49 mudzi-wesikweya).   
a addNum: ((Rondedzero ← 0 ; 1) huru-huru).          
a addNum: ((Rondedzero ← 2 ; 3) diki-diki).
Zvabuda nyora: a.

Chirongwa chenesa.
usedMemory3 := (Chirongwa ndangariro ? 0).



( usedMemory1 = usedMemory2 uye: usedMemory1 = usedMemory3, uye: usedMemory2 = usedMemory3 ) chokwadi: {
	Zvabuda nyora: ['No memory leaks here'].
}, nhema: {
	Zvabuda nyora: ['Leaking memory...'].
}.
