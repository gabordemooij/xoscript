>> HTML := Chinhu nyowani.
HTML kana-zvasvika: ['pindura:'] ita: { :tag 
	Zvabuda nyora: (['<tag>'] tag: tag), mutsara-mutsva.
}.
HTML kana-zvasvika: ['pindura:uye:'] ita: { :tag :html 
	Zvabuda nyora: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), mutsara-mutsva.
}.
>> html := HTML nyowani.
html body h1: ['header'].

