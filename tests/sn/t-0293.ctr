
>> city := Rondedzero ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Rondedzero ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature maererano: city.
>> cities := weather makiyi ronga: { :a :b <- (a enzanisa: b). }.
>> temperatures := weather makoshero ronga: { :a :b <- (a enzanisa: b) pasi-pezero?. }.

Zvabuda nyora: (cities batanidza: [',']), mutsara-mutsva.
Zvabuda nyora: (temperatures batanidza: [',']), mutsara-mutsva.
