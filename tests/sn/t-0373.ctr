# compliance test

# use international numbers

Zvabuda nyora: ['1000 -> '].
Zvabuda nyora: 1000, mutsara-mutsva. #1000

Zvabuda nyora: ['1.5 -> '].
Zvabuda nyora: 1.5, mutsara-mutsva.  #1.5

Zvabuda nyora: ['1001.5 -> '].
Zvabuda nyora: 1.5 + 1000, mutsara-mutsva. #1001.5

# use 0-indexed arrays
>> x := Rondedzero nyowani ; 1 ; 2 ; 3.
>> y := Rondedzero nyowani ; ['a'] ; ['b'] ; ['c'].

Zvabuda nyora: ['1 -> '].
Zvabuda nyora: x ? 0, mutsara-mutsva. #1

Zvabuda nyora: ['1 -> '].
Zvabuda nyora: (x pa: 0), mutsara-mutsva. #1

Zvabuda nyora: ['1 -> '].
Zvabuda nyora: x chekutanga, mutsara-mutsva. #1

Zvabuda nyora: ['3 -> '].
Zvabuda nyora: x chekupedzisira, mutsara-mutsva. #3

Zvabuda nyora: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Zvabuda nyora: (x maererano: y), mutsara-mutsva.

Zvabuda nyora: ['1 -> '].
Zvabuda nyora: (x kubva: 0 kureba: 1) chekutanga, mutsara-mutsva. #1

Zvabuda nyora: ['0 -> '].
Zvabuda nyora: (x tsvaga: 1), mutsara-mutsva. #0

x isa: 9 pa: 0.

Zvabuda nyora: ['9 -> '].
Zvabuda nyora: (x pa: 0), mutsara-mutsva. #9

x wedzera-pakutanga: 8.
Zvabuda nyora: ['8 -> '].
Zvabuda nyora: (x pa: 0), mutsara-mutsva. #9


x wedzera-kumagumo: 10.
Zvabuda nyora: ['10 -> '].
Zvabuda nyora: (x pa: 4), mutsara-mutsva. #10








