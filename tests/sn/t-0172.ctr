>> a := Rondedzero ← ['hello'] ; ['world'] ; Chokwadi ; Hapana ; 666.
>> b := a kubva: 2 kureba: 2.
Zvabuda nyora: ( b batanidza: ['|'] ), nyora: b huwandu.

Chirongwa chenesa.
usedMemory1 := (Chirongwa ndangariro ? 0).


