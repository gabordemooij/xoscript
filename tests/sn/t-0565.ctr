>> message := ['this is a string to be encrypted!'].
>> key := ['secret123!'].
>> vault := Dura-rakachengeteka nyowani: ['myvault'].

>> encrypted := vault viga: message kiyi: key.
>> decrypted := vault vhura-chakavigwa: encrypted kiyi: key.

