#Linux

(Faira nyowani: ['/tmp/testje']) iripo nhema: {
	Chirongwa sisitimu: ['mkdir /tmp/testje'].	
}.

(Faira nyowani: ['/tmp/testje/file1']) iripo nhema: {
	Chirongwa sisitimu: ['touch /tmp/testje/file1'].	
}.

(Faira nyowani: ['/tmp/testje/folder1']) iripo nhema: {
	Chirongwa sisitimu: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Faira rondedzero: ['/tmp/testje'].

>> q := Rondedzero nyowani.

l chimwe-nechimwe: { :k :v v chimwe-nechimwe: { :x :y q wedzera-kumagumo: y. }. }.

>> s := q mavara-emashoko.

(s rine: ['file1']) chokwadi:   { Zvabuda nyora: ['OK'], mutsara-mutsva. }.
(s rine: ['file2']) chokwadi:   { Zvabuda nyora: ['XX'], mutsara-mutsva. }.
(s rine: ['folder1']) chokwadi: { Zvabuda nyora: ['OK'], mutsara-mutsva. }.
