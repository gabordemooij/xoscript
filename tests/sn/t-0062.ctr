Bhuriyoni kana-zvasvika: ['xor:'] ita: { :a :b <- ((a uye: b kwete) kana: (a kwete uye: b)).
}.

>> o := Chinhu nyowani.
o kana-zvasvika: ['hello'] ita: { ['Empty']. }.
{ o kana-zvasvika: 2 ita: 3.} bata: { :e Zvabuda nyora: e, mutsara-mutsva. }, tanga.
{ o kana-zvasvika: ['bvunzo'] ita: 3.} bata: { :e Zvabuda nyora: e, mutsara-mutsva. }, tanga.
{ o kana-zvasvika: ['hello'] ita: { ['Empty']. }.} bata: { :e Zvabuda nyora: e, mutsara-mutsva. }, tanga. 
{ >> z := 4 ÷ 0. } bata: { :e Zvabuda nyora: e, mutsara-mutsva. }, tanga. 
{ (Chokwadi uye: Hapana) chokwadi: { Zvabuda nyora: ['X'].}. } bata: { :e Zvabuda nyora: e, mutsara-mutsva. }, tanga. 
{ ([''] xor: 0) chokwadi: { Zvabuda nyora: ['X'].}. } bata: { :e Zvabuda nyora: e, mutsara-mutsva. }, tanga. 
{ (1 < ['2']) chokwadi: { Zvabuda nyora: ['OK']. }. } bata: { :e Zvabuda nyora: e, mutsara-mutsva. }, tanga. 
{ (1 < ['2.0']) chokwadi: { Zvabuda nyora: ['OK']. }. } bata: { :e Zvabuda nyora: e, mutsara-mutsva. }, tanga. 
{ (1 < ['x2.0']) chokwadi: { Zvabuda nyora: ['NO!']. }. } bata: { :e Zvabuda nyora: e, mutsara-mutsva. }, tanga. 
{ Zvabuda nyora: (['hello OK there'] kubva: ['6'] kureba: ['2']). } tanga. 
