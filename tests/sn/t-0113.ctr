Zvabuda nyora: ['Continue for-loop, No - before 6 and up.'], mutsara-mutsva.
{ :i
	Zvabuda nyora: (i + 1), mutsara-mutsva.
	((i + 1) > 4) enderera.
	Zvabuda nyora: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Zvabuda mutsara-mutsva.
Zvabuda nyora: ['Continue while-true, No --> before 5 and up.'], mutsara-mutsva.
{
	Zvabuda nyora: ['iteration #'] + x, mutsara-mutsva.
	x wedzera: 1.
	((x < 5) kwete) enderera.
	Zvabuda nyora: ['-->'].
} kusvikira: xIsLessThan10.
Zvabuda mutsara-mutsva.
Zvabuda nyora: ['Continue while-false, No - before 3 only.'], mutsara-mutsva.
{
	Zvabuda nyora: ['iteration #'] + x, mutsara-mutsva.
	x bvisa-nhamba: 1.
	(x = 3) enderera.
	Zvabuda nyora: ['-'].
} kusvikira: { <- ( x > 0). }.

Zvabuda mutsara-mutsva.
Zvabuda nyora: ['Continue times-loop, No ||| before 3.'], mutsara-mutsva.
{ :i
	Zvabuda nyora: ['iteration #'] + i, mutsara-mutsva.
	(i = 2) enderera.
	Zvabuda nyora: ['|||'].
} × 5.

Zvabuda mutsara-mutsva.

{ Chokwadi enderera. Zvabuda nyora: ['dont write this!'], mutsara-mutsva. } tanga.

{ Chokwadi enderera. Zvabuda nyora: ['dont write this!'], mutsara-mutsva. } bata: { Zvabuda nyora: ['Dont catch this!']. }, tanga.

Zvabuda nyora: ['Test Array each-loop: 0, ... ,2'], mutsara-mutsva.
(Rondedzero ← 1 ; 2 ; 3) shandura-chimwe-nechimwe: { :i
	(i = 1) enderera.
	Zvabuda nyora: ['iteration #'] + (i - 0), mutsara-mutsva.
}.

Zvabuda nyora: ['Test Map each-loop: c only'], mutsara-mutsva.
>> m := Duramazwi nyowani.
m isa: ['first'] pa: ['a'], isa: ['second'] pa: ['b'], isa: ['third'] pa: ['c'].
m chimwe-nechimwe: { :k :v
	(k ≠ ['c']) enderera.
	Zvabuda nyora: ['iteration'] + k + v, mutsara-mutsva.
}.

