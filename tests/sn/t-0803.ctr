#...
>> del := conn1 mubvunzo: ['DELETE FROM book WHERE id > 0'].
{  del ita-murairo. conn1 simbisa. } bata: { :e conn1 dzosera-shure.  }, tanga.

>> insert := conn1 mubvunzo: ['INSERT INTO book (id) VALUES(null)'].
insert ita-murairo.

>> huwandu := conn1 mubvunzo: ['SELECT COUNT(*) AS num FROM book'].
huwandu tora: { :row Zvabuda nyora: row num, mutsara-mutsva. }.

# does not show up
# insert not committed on connection 1
>> huwandu := conn2 mubvunzo: ['SELECT COUNT(*) AS num FROM book'].
huwandu tora: { :row Zvabuda nyora: row num, mutsara-mutsva. }.
