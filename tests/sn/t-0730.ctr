Zvabuda nyora: ['Test object'], mutsara-mutsva.
>> a := Chinhu nyowani. 

a kana-zvasvika: ['item:'] ita: { :moment
	zvako moment := moment. 
}.

a kana-zvasvika: ['item'] ita: { <- zvako moment.
}.

>> today := Nguva-chaiyo nyowani nzvimbo-yenguva: ['CEST'], gore: 2026, mwedzi: 7.
a item: today.
Zvabuda nyora: a item, mutsara-mutsva.
a save-as: ['/tmp/a.bin'].
Zvabuda nyora: ['========== RELOADING SNAP:'], mutsara-mutsva.
>> b := Chinhu load-from: ['/tmp/a.bin'].
Zvabuda nyora: b item, mutsara-mutsva.
