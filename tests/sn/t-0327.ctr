

Rondedzero kana-zvasvika: ['fixture:'] ita: { :f
	zvako fixture := f.
}.

Rondedzero kana-zvasvika: ['huwandu'] ita: { <- zvako fixture.
}.

Rondedzero kana-zvasvika: ['aantal'] ita: { <- zvako fixture.
}.


>> x := Hapana.
{

	x := ['hello'] 
	tsiva:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] bhii: 2)
			)
		)
	na: (
		(['...hal'] + ['lo']) 
			mabhii-makuru 
			lowecase 
			mabhii-makuru 
			svetuka: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Rondedzero ← 0 ; 1 ; 4; 9 ; (Rondedzero ← 0 ; 3; 1) ; 4
							) pamberi-pechekupedzisira
						) ? 1
					) + 
					((Rondedzero ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					huwandu
				)
			)
	).

} × 10.
Zvabuda nyora: x, mutsara-mutsva.

