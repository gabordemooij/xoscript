>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Chinhu nyowani.
⚄ kana-zvasvika: ['drawFrom:length:'] ita: { :pool :huwandu
	
	>> result := [''].
	
	{
		>> index := Nhamba random % (pool kureba).
		result wedzera-kumagumo: ( pool bhii: (index + 1) ).
		
	} × huwandu. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? kureba.
Zvabuda nyora: (['x↵'] x random kureba).
Zvabuda nyora: (['y↵'] y ?? kureba).

