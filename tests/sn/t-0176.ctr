

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Chirongwa kutonga-ndangariro: 0.

>> txt := ['Word Salad'].
Zvabuda nyora: ['Text Length: '] + txt kureba, mutsara-mutsva.
Zvabuda nyora: ['Character at 2:'] + ( txt bhii: 2 ), mutsara-mutsva.
Zvabuda nyora: (( txt tsvaga: ['S'] ) - 0), mutsara-mutsva.

Chirongwa chenesa.

usedMemory1 := (Chirongwa ndangariro ? 0).


txt := ['Word Salad'].
Zvabuda nyora: ['Text Length: '] + txt kureba, mutsara-mutsva.
Zvabuda nyora: ['Character at 2:'] + ( txt bhii: 2 ), mutsara-mutsva.
Zvabuda nyora: (( txt tsvaga: ['S'] ) - 0), mutsara-mutsva.

Chirongwa chenesa.
usedMemory2 := (Chirongwa ndangariro ? 0).


txt := ['Word Salad'].
Zvabuda nyora: ['Text Length: '] + txt kureba, mutsara-mutsva.
Zvabuda nyora: ['Character at 2:'] + ( txt bhii: 2 ), mutsara-mutsva.
Zvabuda nyora: (( txt tsvaga: ['S'] ) - 0), mutsara-mutsva.

Chirongwa chenesa.
usedMemory3 := (Chirongwa ndangariro ? 0).



( usedMemory1 = usedMemory2 uye: usedMemory1 = usedMemory3, uye: usedMemory2 = usedMemory3 ) chokwadi: {
	Zvabuda nyora: ['No memory leaks here'].
}, nhema: {
	Zvabuda nyora: ['Leaking memory...'].
}.
