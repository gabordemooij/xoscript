>> V := Chinhu.
V kana-zvasvika: ['mavara-emashoko'] ita: {
	Zvabuda nyora: ['cast'], mutsara-mutsva. <- ['abc'].
}.

Zvabuda nyora: ( Chirongwa gadziriso: ['abc'] ), mutsara-mutsva.

# params should not get gc'ed
Chirongwa gadziriso: ([''] + V nyowani) kukosha: ([''] + V nyowani).

Zvabuda nyora: ( Chirongwa gadziriso: ['abc'] ), mutsara-mutsva.
