#Linux
>> clock := Nguva-chaiyo nyowani.
clock nzvimbo-yenguva: ['UTC-1'].
clock gore: 1981, mwedzi: 1, zuva: 5,
      awa: 13, mineti: 15, sekondi: 13.

Zvabuda nyora: clock, mutsara-mutsva.
clock nzvimbo-yenguva: ['UTC+0'].

Zvabuda nyora: (
	(clock gore zviri-nyore) + ['-'] + (clock mwedzi) + ['-'] + (clock zuva) + [' '] +
	(clock awa) + [':'] + (clock mineti) + [':'] + (clock sekondi) + [' '] +
	['W'] + (clock vhiki) + (clock nzvimbo-yenguva)
), mutsara-mutsva.


clock nzvimbo-yenguva: ['UTC-1'].
Zvabuda nyora: (
	(clock gore zviri-nyore) + ['-'] + (clock mwedzi) + ['-'] + (clock zuva) + [' '] +
	(clock awa) + [':'] + (clock mineti) + [':'] + (clock sekondi) + [' '] +
	['W'] + (clock vhiki) + (clock nzvimbo-yenguva)
), mutsara-mutsva.
