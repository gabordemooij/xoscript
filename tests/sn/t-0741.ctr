Zvabuda nyora: ['Test object'], mutsara-mutsva.
>> a := Chinhu nyowani. 

a kana-zvasvika: ['item:'] ita: { :octhelper
	zvako octhelper := octhelper. 
}.

a kana-zvasvika: ['item'] ita: { <- zvako octhelper.
}.

a item: Oct nyowani.

>> old-octhelper-address := a item muenzaniso-wekutanga kero-yendangariro.
a save-as: ['/tmp/a.bin'].
Zvabuda nyora: ['========== RELOADING SNAP:'], mutsara-mutsva.

>> b := Chinhu load-from: ['/tmp/a.bin'].

(b item muenzaniso-wekutanga kero-yendangariro = old-octhelper-address) chokwadi: {
	Zvabuda nyora: ['Object link re-attached.'], mutsara-mutsva.
}.
