>> t := Hapana.

# you can control the time zone for
# parsing like this:
Nguva-chaiyo nzvimbo-yenguva: ['CET'].
t := Nguva-chaiyo kwabva: ['1981-02-03 04:05:06'].
Zvabuda nyora: t, mutsara-mutsva.

# now using CEST time zone:
Nguva-chaiyo nzvimbo-yenguva: ['CEST'].
t := Nguva-chaiyo kwabva: ['1981-02-03 04:05:06'].
Zvabuda nyora: t, mutsara-mutsva.

# error if string cannot be parsed
{ Nguva-chaiyo kwabva: ['1900']. } bata: { Hapana. }, tanga.
