


>> wine := Chinhu nyowani.


wine kana-zvasvika: ['toString'] ita: { <- ['merlot'].
}.

wine kana-zvasvika: ['naarTekst'] ita: { <- ['merlot'].
}.


wine kana-zvasvika: ['='] ita: { :other wine <- ( pachako toString = other wine ).
}.

wine kana-zvasvika: ['=='] ita: { :other wine <- ( pachako toString = other wine ).
}.



wine
	kana-zvakadaro: ['cabernet'] ita: { Zvabuda nyora: ['it's a Cabernet!']. },
	kana-zvakadaro: ['syrah']    ita: { Zvabuda nyora: ['it's a Syrah!'].    },
	kana-zvakadaro: ['merlot']   ita: { Zvabuda nyora: ['it's a Merlot!'].   },
	kana-zvakadaro: ['malbec']   ita: { Zvabuda nyora: ['it's a Malbec!'].   }.

Zvabuda mutsara-mutsva.
