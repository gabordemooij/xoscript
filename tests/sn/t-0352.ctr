Nhamba kana-zvasvika: ['roman'] ita: {
	>> nhamba := pachako kopa.
	>> roman := [''].
	{
		{
			(nhamba ≥ 1000) chokwadi: {
				roman wedzera-kumagumo: ['Ⅿ'].
				nhamba bvisa-nhamba: 1000.
			}, gura.
		
			(nhamba ≥ 500) chokwadi: {
				roman wedzera-kumagumo: ['Ⅾ'].
				nhamba bvisa-nhamba: 500.
			}, gura.
		
			(nhamba ≥ 100) chokwadi: {
				roman wedzera-kumagumo: ['Ⅽ'].
				nhamba bvisa-nhamba: 100.
			}, gura.
		
			(nhamba ≥ 50) chokwadi: {
				roman wedzera-kumagumo: ['Ⅼ'].
				nhamba bvisa-nhamba: 50.
			}, gura.
		
			(nhamba ≥ 50) chokwadi: {
				roman wedzera-kumagumo: ['Ⅼ'].
				nhamba bvisa-nhamba: 50.
			}, gura.
		
			(nhamba ≥ 10) chokwadi: {
				roman wedzera-kumagumo: ['Ⅹ'].
				nhamba bvisa-nhamba: 10.
			}, gura.
			
			(nhamba ≥ 9) chokwadi: {
				roman wedzera-kumagumo: ['Ⅸ'].
				nhamba bvisa-nhamba: 9.
			}, gura.
			
			(nhamba ≥ 5) chokwadi: {
				roman wedzera-kumagumo: ['Ⅴ'].
				nhamba bvisa-nhamba: 5.
			}, gura.
			
			(nhamba ≥ 4) chokwadi: {
				roman wedzera-kumagumo: ['Ⅳ'].
				nhamba bvisa-nhamba: 4.
			}, gura.
			
			(nhamba ≥ 1) chokwadi: {
				roman wedzera-kumagumo: ['Ⅰ'].
				nhamba bvisa-nhamba: 1.
			}, gura.
		} maitiro.
	} kusvikira: { <- nhamba > 0. }. <- roman.
}.

Zvabuda nyora: 1 roman, mutsara-mutsva.
Zvabuda nyora: 2 roman, mutsara-mutsva.
Zvabuda nyora: 4 roman, mutsara-mutsva.
Zvabuda nyora: 8 roman, mutsara-mutsva.
Zvabuda nyora: 16 roman, mutsara-mutsva.
Zvabuda nyora: 32 roman, mutsara-mutsva.
Zvabuda nyora: 64 roman, mutsara-mutsva.
Zvabuda nyora: 128 roman, mutsara-mutsva.
Zvabuda nyora: 256 roman, mutsara-mutsva.
Zvabuda nyora: 1024 roman, mutsara-mutsva.
