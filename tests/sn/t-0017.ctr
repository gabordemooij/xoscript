Nhamba kana-zvasvika: ['factorial'] ita: {
	>> total := 1.
	{ :index total wanza-ne: (pachako - (index)). } × pachako. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Zvabuda nyora: a.
>> b := 2 + 3 factorial.
Zvabuda nyora: b.
>> c := 3 factorial + 2.
Zvabuda nyora: c.
>> d := 2 + (3 factorial).
Zvabuda nyora: d.
Zvabuda nyora: 2 + 3 factorial + 1.
