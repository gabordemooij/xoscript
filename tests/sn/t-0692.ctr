Server init.

Zvabuda nyora: (
	Pateni nyowani: ['^\\w+$'],
	kuenderana: ['test@example.com'] 
), mutsara-mutsva. # 0 match, fails on @ and .

Zvabuda nyora: (
	Pateni nyowani: ['^[^@]+@[^\.]+\.\\w+$'],
	kuenderana: ['test@example.com'] 
), mutsara-mutsva. # 1 match

Zvabuda nyora: (
	Pateni nyowani: ['[^@]+@[^\.]+\.\\w+'],
	kuenderana: ['test@example.com'] 
), mutsara-mutsva. # 1 match

Zvabuda nyora: (
	Pateni nyowani: ['([^@]+)@([^\.]+)\.\\w+'],
	kuenderana: ['test@example.com'] 
), mutsara-mutsva. # 1 match, groups dont matter

Zvabuda nyora: (
	Pateni nyowani: ['[a-z]'],
	kuenderana: ['test@example.com'] 
), mutsara-mutsva. # 14 matches

Zvabuda nyora: (
	Pateni nyowani: ['.*'],
	kuenderana: ['test@example.com'] 
), mutsara-mutsva. # 1 match (all)

Zvabuda nyora: (
	Pateni nyowani: ['(.*)'],
	kuenderana: ['test@example.com'] 
), mutsara-mutsva. # 1 match (all)

Zvabuda nyora: (
	Pateni nyowani: ['\\s*[^@]+@[^\.]+\.\\w+'],
	kuenderana: ['test@example.com'] 
), mutsara-mutsva. # 1 match, prefix space optional, gets ignored