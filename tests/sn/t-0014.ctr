>> Greeter := Chinhu nyowani.
Greeter kana-zvasvika: ['make'] ita: {
	>> gr := Chinhu nyowani.
	gr kana-zvasvika: ['setName:'] ita: { :aname
		zvako zita := aname.
	}.
	gr kana-zvasvika: ['greet'] ita: {
		Zvabuda nyora: zvako zita.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a nyowani.
c setName: ['THREE'].
c greet.
>> d := a nyowani.
d setName: ['FOUR'].
d greet.
c greet.
