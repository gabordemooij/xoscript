Server init.

>> DB := Maria-DB nyowani mugamuchiri: ['localhost'],
	zita-remushandisi: ['xo'],
	pasiwedhi: ['pass123'],
	zita-redhatabhesi: ['xobase'],
	batana.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB mubvunzo: SQL.

# now you don't have to set DB
query2 tora: { :row
	Zvabuda nyora: row world, mutsara-mutsva.
}.
