>> a := Rondedzero ← Chinhu ; Chokwadi ; Nhema ; Bhuriyoni ; 1 ; Nhamba ; ['Str'] ; Mavara ; { ['Empty']. }.
Zvabuda nyora: (a huwandu), mutsara-mutsva.
{ :i
	Zvabuda nyora: 
	['a '] + 
	((a ? i) mhando) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Hapana?) ichi: [''] kana-icho: ['NOT']) + 
	[' Nil.'],
	mutsara-mutsva.
} × (a huwandu).
Zvabuda nyora: ['but.. Nil is.. '] + ((Hapana Hapana?) ichi: ['certainly NIL!'] kana-icho: ['not NIL??']), mutsara-mutsva.