# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Dura-rakachengeteka gadzira-makiyi.

# private (secret) key
>> sk := keys chekutanga.

# public key
>> pk := keys chekupedzisira.

# sign a message
>> sig := Dura-rakachengeteka saina: ['abc'] ne: sk.

# check message (ok)
Zvabuda nyora: ( 
	Dura-rakachengeteka
		tarisa: ['abc'] 
		siginecha: sig 
		ne: pk 
), mutsara-mutsva.

# check message (fail)
Zvabuda nyora: ( 
	Dura-rakachengeteka 
		tarisa: ['abd'] 
		siginecha: sig 
		ne: pk 
), mutsara-mutsva.