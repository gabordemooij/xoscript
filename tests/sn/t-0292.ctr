>> winery := { <- (	Duramazwi nyowani
		isa: 2 pa: ['merlot'],
		isa: 3 pa: ['malbec'],
		isa: 4 pa: ['syrah']
	).
}.

Zvabuda nyora: (((winery tanga) - ['nothing']) huwandu), mutsara-mutsva.
Zvabuda nyora: (((winery tanga) - ['merlot']) huwandu), mutsara-mutsva.
Zvabuda nyora: (((winery tanga) - ['malbec']) huwandu), mutsara-mutsva.
Zvabuda nyora: (((winery tanga) - ['syrah']) huwandu), mutsara-mutsva.
Zvabuda nyora: (((winery tanga) - ['merlot'] - ['malbec']) huwandu), mutsara-mutsva.
Zvabuda nyora: (((winery tanga) - ['merlot'] - ['syrah']) huwandu), mutsara-mutsva.
Zvabuda nyora: (((winery tanga) - ['malbec'] -['syrah']) huwandu), mutsara-mutsva.
Zvabuda nyora: (((winery tanga) - ['malbec'] - ['syrah'] - ['merlot']) huwandu), mutsara-mutsva.

