

# create a 64-bit integer for exact calculations
>> a := Int64 kubva-mumavara: ['123'].

# to string
Zvabuda nyora: a, mutsara-mutsva.

# divide
Zvabuda nyora: a / (Int64 kubva-mumavara: ['3']), mutsara-mutsva.

# multiply
Zvabuda nyora: a * (Int64 kubva-mumavara: ['2']), mutsara-mutsva.

# add
Zvabuda nyora: a + (Int64 kubva-mumavara: ['1']), mutsara-mutsva.

# subtract
Zvabuda nyora: a - (Int64 kubva-mumavara: ['2']), mutsara-mutsva.

# compare
Zvabuda nyora: ( a =   (Int64 kubva-mumavara: ['123'])), mutsara-mutsva.
Zvabuda nyora: ( a !=: (Int64 kubva-mumavara: ['124'])), mutsara-mutsva.
Zvabuda nyora: ( a <   (Int64 kubva-mumavara: ['124'])), mutsara-mutsva.
Zvabuda nyora: ( a >   (Int64 kubva-mumavara: ['122'])), mutsara-mutsva.
Zvabuda nyora: ( a >=: (Int64 kubva-mumavara: ['123'])), mutsara-mutsva.
Zvabuda nyora: ( a <=: (Int64 kubva-mumavara: ['123'])), mutsara-mutsva.





	