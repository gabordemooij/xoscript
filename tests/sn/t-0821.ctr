# a quote that never closes must give an error, not an endless loop
>> nzira-yefaira := ['/tmp/test0821.csv'].
>> file := Faira nyowani: nzira-yefaira.

file nyora: ['a,b\n"1,2\n'].
{
	file chipatsanuri: [','] chiratidzo-chekutaura: ['"'] mitsara: { :line
		Zvabuda nyora: line, mutsara-mutsva.
	}.
} bata: { :e Zvabuda nyora: e, mutsara-mutsva. }, tanga.

# a closed quote still works
file nyora: ['a,b\n"1,2",3'].
file chipatsanuri: [','] chiratidzo-chekutaura: ['"'] mitsara: { :line
	Zvabuda nyora: line, mutsara-mutsva.
}.
file bvisa.
