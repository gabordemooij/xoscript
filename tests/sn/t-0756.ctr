Zvabuda nyora: ['Test object'], mutsara-mutsva.
>> greeter := Chinhu nyowani.
greeter kana-zvasvika: ['name:'] ita: { :zita
	zvako xname := zita. 
}.
greeter kana-zvasvika: ['greet'] ita: {
	Zvabuda nyora: ['Hello '] + zvako xname, mutsara-mutsva.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Zvabuda nyora: ['========== RELOADING SNAP:'], mutsara-mutsva.
>> b := Chinhu load-from: ['/tmp/a.bin'].
>> c := Chinhu load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
