>> numbers := ['1,2,3'] patsanura: [','].
Zvabuda nyora: ['I got: '] + numbers huwandu + [' numbers.'],mutsara-mutsva.
{ :i Zvabuda nyora: ['number #'] + i + [':'] + (numbers chinzvimbo: i), mutsara-mutsva.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages patsanura: [' Or '].
Zvabuda nyora: ['We serve'], mutsara-mutsva.
{ :i Zvabuda nyora: ['->'] + (beverages chinzvimbo: i), mutsara-mutsva. } × (beverages huwandu).
Zvabuda nyora: (beverages batanidza: [',']), mutsara-mutsva.
Zvabuda nyora: (numbers batanidza: ['||']).
