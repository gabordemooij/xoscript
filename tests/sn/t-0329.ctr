Zvabuda nyora: ((Rondedzero nyowani
	kana-zvasvika: ['plaque:'] ita: { :x zvako o := x. },
	kana-zvasvika: ['plaque']  ita: { <- zvako o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Rondedzero ← 1)
	~ (Rondedzero ← 1 ; 2)
	~ (Rondedzero ← 1 ; 2 ; 3)
	~ (Rondedzero ← 1 ; 2 ; 3 ; 4)
	~ (Rondedzero ← 1 ; 2 ; 3 ; 4 ; 5)
) chimwe-nechimwe: { :i :el
	{ Zvabuda nyora: basa-iri. } × el huwandu.
	Zvabuda mutsara-mutsva.
}) plaque, mutsara-mutsva.


