


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Chirongwa kutonga-ndangariro: 0.
>> palette := Hapana.
>> colors := Hapana.

{
palette := Duramazwi nyowani.
palette 
	isa: ['#F00'] pa: ['red'],
	isa: ['#0F0'] pa: ['green'],
	isa: ['#00F'] pa: ['blue'].
Zvabuda nyora: ['number of RGB codes in palette: '] + ( palette huwandu ), mutsara-mutsva.
Zvabuda nyora: ['RGB code of green is: '] + ( palette ? ['green'] ), mutsara-mutsva.
colors := [''].
( palette chimwe-nechimwe: { :zita :kodhi
		colors := colors + ( zita + [':'] + kodhi ).
} ).
Zvabuda nyora: ['All colors in palette: '] + colors, mutsara-mutsva.
} tanga.
Chirongwa chenesa.
usedMemory1 := (Chirongwa ndangariro ? 0).

{
palette := Duramazwi nyowani.
palette 
	isa: ['#F00'] pa: ['red'],
	isa: ['#0F0'] pa: ['green'],
	isa: ['#00F'] pa: ['blue'].
Zvabuda nyora: ['number of RGB codes in palette: '] + ( palette huwandu ), mutsara-mutsva.
Zvabuda nyora: ['RGB code of green is: '] + ( palette ? ['green'] ), mutsara-mutsva.
colors := [''].
( palette chimwe-nechimwe: { :zita :kodhi
		colors := colors + ( zita + [':'] + kodhi ).
} ).
Zvabuda nyora: ['All colors in palette: '] + colors, mutsara-mutsva.
} tanga.
Chirongwa chenesa.
usedMemory2 := (Chirongwa ndangariro ? 0).

