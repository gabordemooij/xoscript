(Hapana = Hapana) chokwadi: { Zvabuda nyora: ['Nil is Nil!'].}.
(2 > 1) chokwadi: { Zvabuda nyora: ['YES']. }.
(2 > 3) chokwadi: { Zvabuda nyora: ['NO']. }.
(2 > 3) nhema: { Zvabuda nyora: ['Nonono..'].}.
Chokwadi chokwadi: { Zvabuda nyora: ['TRUE is TRUE!']. }.
(Chokwadi) chokwadi: { Zvabuda nyora: ['TRUE is TRUE!']. }.
Nhema nhema: { Zvabuda nyora: ['FALSE is FALSE!']. }.
(Nhema) nhema: { Zvabuda nyora: ['FALSE is FALSE!']. }.
