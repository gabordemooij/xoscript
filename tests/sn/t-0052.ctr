>> items := Duramazwi nyowani.
items isa: ['green'] pa: ['color-1'].
items isa: ['orange'] pa: ['color-2'].
items isa: ['red'] pa: ['color-3'].
>> i := 0.
>> s := [''].
items chimwe-nechimwe: { :key :color
	Zvabuda nyora: ['color #'] + i + [' is: '] + color + [' '].
	i wedzera: 1.
}.
Zvabuda nyora: i + [' colors!'].
