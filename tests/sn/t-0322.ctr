

>> Matryoshka := Chinhu nyowani.
Matryoshka kana-zvasvika: ['double:'] ita: { :secret
	zvako secret := secret × 2.
}.
Matryoshka kana-zvasvika: ['nyowani:'] ita: { :secret
	>> answer := Hapana.
	>> t := (secret > 255).
	Zvabuda nyora: (secret + [' | '] + t), mutsara-mutsva.
	t chokwadi: {
		answer := secret.
	}, kana-zvisiri: {
		answer := Matryoshka kuzvidaidza nyowani: (pachako double: secret).
	}. <- answer.
}.

>> x := Matryoshka nyowani: 2.
