# test qualifiers

>> $ := Chinhu nyowani.

$ kana-zvasvika: ['pindura:'] ita: { :x
	
	>> operation := x bhii: 0.
	>> valuta := x bhii: 1.
	>> money := x svetuka: 2.
	
	>> amount := 0.

	( operation = ['+'] ) chokwadi: {
		( valuta = ['£'] ) chokwadi: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Zvabuda nyora: x, mutsara-mutsva.


>> Fruit := Chinhu nyowani.

Fruit kana-zvasvika: ['nyowani'] ita: {
	>> f := pachako nyowani.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit kana-zvasvika: ['apples:'] ita: { :a zvako apples := a. }.
Fruit kana-zvasvika: ['oranges:'] ita: { :p zvako oranges := p. }.
Fruit kana-zvasvika: ['apples'] ita: { <- zvako apples. }.
Fruit kana-zvasvika: ['oranges'] ita: { <- zvako oranges. }.

Fruit kana-zvasvika: ['+'] ita: { :f
	
	>> n := Fruit nyowani.
	f wedzera: 1.
	
	n apples: (f apples + zvako apples).
	n oranges:  (f oranges  + zvako oranges). <- n.
}.

Fruit kana-zvasvika: ['mavara-emashoko'] ita: { <- ( zvako apples mavara-emashoko + [' apples and '] + zvako oranges + [' oranges'] ).
}.

Nhamba kana-zvasvika: ['apples'] ita: { <- ((Fruit nyowani) apples: pachako).
}.

Nhamba kana-zvasvika: ['apple'] ita: { <- ((Fruit nyowani) apples: pachako).
}.

Nhamba kana-zvasvika: ['oranges'] ita: { <- ((Fruit nyowani) oranges: pachako).
}.




Zvabuda nyora: (1 apple + 3 oranges + 4 apples), mutsara-mutsva.


Mavara kana-zvasvika: ['twice'] ita: { <- ((pachako mavara-emashoko) + (pachako mavara-emashoko)).
}.



Zvabuda nyora: ['❤❤❤'] twice.



