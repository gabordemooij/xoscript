60 × {
	>> x := (Nhamba random % 6) + 1.
	(x ≤ 6) nhema: { Zvabuda nyora: ['FAIL']. }.
	(x ≥0) nhema: { Zvabuda nyora: ['FAIL']. }.
	x := (Nhamba random % 3) + 1.
	(x < 3) nhema: { Zvabuda nyora: ['FAIL']. }.
	(x>-1) nhema: { Zvabuda nyora: ['FAIL']. }.
	x := ((Bhuriyoni flip) nhamba).
	(x = 0 kana: x = 1) nhema: { Zvabuda nyora: ['FAIL']. }.
	x := ((Chokwadi flip) nhamba).
	(x = 0 kana: x = 1) nhema: { Zvabuda nyora: ['FAIL']. }.
	x := (Bhuriyoni flip ichi: ['HEAD'] kana-icho: ['TAIL']).
	((x = ['HEAD']) kana: (x = ['TAIL'])) nhema: { Zvabuda nyora: ['FAIL']. }.
}.
Zvabuda nyora: ['DONE'].

