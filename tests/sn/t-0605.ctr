>> invoice := Chinhu nyowani.
invoice kana-zvasvika: ['tanga'] ita: {
        zvako nhamba := 0.
}.

invoice kana-zvasvika: ['nhamba'] ita: {
        zvako nhamba wedzera: 1. <- zvako nhamba kopa.
}.

>> year-invoice := invoice nyowani.
year-invoice kana-zvasvika: ['start:'] ita: { :gore
	zvako nhamba := gore.
}.

year-invoice start: 202000.
Zvabuda nyora: year-invoice nhamba, mutsara-mutsva.
Zvabuda nyora: year-invoice nhamba, mutsara-mutsva.
