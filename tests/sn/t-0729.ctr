Server init.
>> a := Blob nyowani: 4.
a bytes: ( Rondedzero nyowani ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob nyowani: 4.
b bytes: ( Rondedzero nyowani ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a ^ b.
{
	a ^ ( Faira nyowani: ['noblob???'] ).
} bata: { :e Zvabuda nyora: e, mutsara-mutsva. }, tanga.
a sunungura.
b sunungura.
