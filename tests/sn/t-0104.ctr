
{ :i
	Zvabuda nyora: ['This is step #'] + ( ( i ) + 1 ), mutsara-mutsva.
} × 6.

{ :i
	Zvabuda nyora: ['This is step #'] + ( 3 - ( i ) ), mutsara-mutsva.
} × 6.

{ :i
	Zvabuda nyora: ['NEVER!'], mutsara-mutsva.
} × 0.



{ :i
	Zvabuda nyora: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), mutsara-mutsva.
} × 11.
