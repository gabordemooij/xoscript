#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Pateni nyowani: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern kuenderana: subject ita: { :m :x
	Zvabuda nyora: m, mutsara-mutsva.
	Zvabuda nyora: x, mutsara-mutsva. <- ['XXX'].
}.
Zvabuda nyora: result, mutsara-mutsva.