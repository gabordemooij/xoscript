>> map1 := Duramazwi nyowani.
>> key1 := Rondedzero nyowani.
>> key2 := Rondedzero nyowani.

map1
	isa: ['hello'] pa: key1,
	isa: ['world'] pa: key2.


Zvabuda
	nyora: ['Map #1 contains: '] + (map1 pa: key1),
	nyora: [' and '] + (map1 pa: key2), mutsara-mutsva.

>> KeyeableArray := Rondedzero nyowani.
KeyeableArray kana-zvasvika: ['toString'] ita: { <- (pachako huwandu) toString.
}.

>> map2 := Duramazwi nyowani.
key1 := KeyeableArray nyowani.
key2 := KeyeableArray nyowani.

key1 wedzera-kumagumo: 1.

map2
	isa: ['hello'] pa: key1,
	isa: ['world'] pa: key2.

Zvabuda
	nyora: ['Map #2 contains: '] + (map2 pa: key1),
	nyora: [' and '] + (map2 pa: key2), mutsara-mutsva.
