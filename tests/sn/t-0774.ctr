Zvabuda nyora: ['Test object'], mutsara-mutsva.
>> a := Chinhu nyowani. 
a kana-zvasvika: ['item:'] ita: { :lst
	zvako lst := lst. 
}.
a kana-zvasvika: ['item'] ita: { <- zvako lst.
}.
a item: (
	Rondedzero nyowani ; 1 ; (
		Rondedzero nyowani ; ['a'] ; (
			Rondedzero nyowani ; ( Nguva-chaiyo nyowani: 1 )
		) ; ( Int64 kubva-mumavara: ['321'] )
	)
).
Zvabuda nyora: a item, mutsara-mutsva.
>> old-lst-address := a item muenzaniso-wekutanga kero-yendangariro.
a save-as: ['/tmp/a.bin'].
Zvabuda nyora: ['========== RELOADING SNAP:'], mutsara-mutsva.
>> b := Chinhu load-from: ['/tmp/a.bin'].
(b item muenzaniso-wekutanga kero-yendangariro = old-lst-address) chokwadi: {
	Zvabuda nyora: ['Object link re-attached.'], mutsara-mutsva.
}.
Zvabuda nyora: ( b item ), mutsara-mutsva.
