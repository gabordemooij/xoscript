>> a := Chinhu nyowani.
>> b := Chinhu nyowani.
>> c := a.
Zvabuda nyora: a kero-yendangariro mabhii ? 0, mutsara-mutsva.
Zvabuda nyora: a kero-yendangariro mabhii ? 1, mutsara-mutsva.
Zvabuda nyora: a kero-yendangariro = b kero-yendangariro, mutsara-mutsva.
Zvabuda nyora: a kero-yendangariro = c kero-yendangariro, mutsara-mutsva.
