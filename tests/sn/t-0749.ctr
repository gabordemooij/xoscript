Zvabuda nyora: ['Test object'], mutsara-mutsva.
>> a := Chinhu nyowani. 

a kana-zvasvika: ['item:'] ita: { :bhuriyoni
	zvako bhuriyoni := bhuriyoni. 
}.

a kana-zvasvika: ['item'] ita: { <- zvako bhuriyoni.
}.

a item: Nhema.

Zvabuda nyora: a item, mutsara-mutsva.

>> old-bool-address := a item muenzaniso-wekutanga kero-yendangariro.
a save-as: ['/tmp/a.bin'].
Zvabuda nyora: ['========== RELOADING SNAP:'], mutsara-mutsva.

>> b := Chinhu load-from: ['/tmp/a.bin'].

(b item muenzaniso-wekutanga kero-yendangariro = old-bool-address) chokwadi: {
	Zvabuda nyora: ['Object link re-attached.'], mutsara-mutsva.
}.

Zvabuda nyora: b item, mutsara-mutsva.
