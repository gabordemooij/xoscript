Server init.

# write a test file
>> f := Faira nyowani: ['/tmp/test.gif'].
f nyora: ['GIF87a01234567810'].

# serve the file
Server pfuudza: ['test.gif'] chivakamberi: ['/tmp/'].

Zvabuda mutsara-mutsva.

Zvabuda nyora: ['Outside container (security):'], mutsara-mutsva.
{ Server pfuudza: ['../passwd'] chivakamberi: ['/tmp/']. }
bata: { :e Zvabuda nyora: e, mutsara-mutsva. },
tanga.

Zvabuda nyora: ['Invalid prefix:'], mutsara-mutsva.
{ Server pfuudza: ['test.gif'] chivakamberi: ['z:\\']. }
bata: { :e Zvabuda nyora: e, mutsara-mutsva. },
tanga.

Zvabuda nyora: ['Non-existant file:'], mutsara-mutsva.
{ Server pfuudza: ['xxx.xxx'] chivakamberi: ['/tmp/']. }
bata: { :e Zvabuda nyora: e, mutsara-mutsva. },
tanga.
