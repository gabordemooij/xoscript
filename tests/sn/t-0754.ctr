Zvabuda nyora: ['Test object'], mutsara-mutsva.
>> a := Chinhu nyowani. 

a kana-zvasvika: ['item:'] ita: { :out
	zvako out := out. 
}.

a kana-zvasvika: ['item'] ita: { <- zvako out.
}.

a kana-zvasvika: ['greet'] ita: {
	Zvabuda nyora: ['hi from original out!'], mutsara-mutsva.
}.

a item: Zvabuda.

Zvabuda nyora: a item, mutsara-mutsva.

>> old-out-address := a item muenzaniso-wekutanga kero-yendangariro.
a save-as: ['/tmp/a.bin'].
Zvabuda nyora: ['========== RELOADING SNAP:'], mutsara-mutsva.

>> b := Chinhu load-from: ['/tmp/a.bin'].

(b item muenzaniso-wekutanga kero-yendangariro = old-out-address) chokwadi: {
	Zvabuda nyora: ['Object link re-attached.'], mutsara-mutsva.
}.

b item nyora: ['hello from loaded out!'], mutsara-mutsva.
b greet.
