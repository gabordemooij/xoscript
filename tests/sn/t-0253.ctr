#Linux
>> OS := Chirongwa gadziriso: ['OS'].

>> clock := Nguva-chaiyo nyowani.
	
(OS = ['Haiku']) chokwadi: {
	clock nzvimbo-yenguva: ['CET'],
	gore: 2017, mwedzi: 7, zuva: 13,
	awa: 18, mineti: 0, sekondi: 0.
}, kana-zvisiri: {
	clock nzvimbo-yenguva: ['Europe/Amsterdam'],
	gore: 2017, mwedzi: 7, zuva: 13,
	awa: 18, mineti: 0, sekondi: 0.
}.

clock kana-zvasvika: ['tell'] ita: {
	Zvabuda nyora: pachako, mutsara-mutsva.
}.


clock wedzera: 2    awa, tell.
clock wedzera: 1    awa, tell.
clock wedzera: 19 mineti, tell.
clock wedzera: 1  mineti, tell.
clock wedzera: 1  mineti, tell.
clock wedzera: 19 sekondi, tell.
clock wedzera: 1  sekondi, tell.
clock wedzera: 1  sekondi, tell.
clock wedzera: 2    gore, tell.
clock wedzera: 1    gore, tell.

(OS = ['Haiku']) chokwadi: {
clock wedzera: 5   mwedzi.
clock nzvimbo-yenguva: ['CEST'], tell.
}, kana-zvisiri: {
	clock wedzera: 5   mwedzi, tell.
}.

clock wedzera: 1   mwedzi, tell.
clock wedzera: 19    zuva, tell.
clock wedzera: 1    awa, tell.
clock wedzera: 120  yard, tell.
