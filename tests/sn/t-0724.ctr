Zvabuda nyora: ['Test object'], mutsara-mutsva.
>> a := Chinhu nyowani. 

a kana-zvasvika: ['item:'] ita: { :file
	zvako file := file. 
}.

a kana-zvasvika: ['item'] ita: { <- zvako file.
}.

>> f := Faira nyowani: ['/tmp/aaa.txt'].
a item: f.
Zvabuda nyora: a item, mutsara-mutsva.
a save-as: ['/tmp/a.bin'].
Zvabuda nyora: ['========== RELOADING SNAP:'], mutsara-mutsva.
>> b := Chinhu load-from: ['/tmp/a.bin'].
Zvabuda nyora: b item, mutsara-mutsva.
