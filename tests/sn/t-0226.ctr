# Test ASCII variants

# Numbers

Zvabuda nyora: (2 !=: 3), mutsara-mutsva.
Zvabuda nyora: (2 <=: 2), mutsara-mutsva.
Zvabuda nyora: (2 >=: 2), mutsara-mutsva.

# Strings

Zvabuda nyora: (['b'] >=: ['a']), mutsara-mutsva.
Zvabuda nyora: (['b'] !=: ['a']), mutsara-mutsva.
Zvabuda nyora: (['b'] <=: ['c']), mutsara-mutsva.

# Bools

Zvabuda nyora: (Chokwadi !=: Nhema), mutsara-mutsva.

# Objects

Zvabuda nyora: (Chinhu nyowani !=: Chinhu nyowani), mutsara-mutsva.

# ASCII list symbol <-:

Zvabuda nyora: (Rondedzero <<: 1, ; 2 ; 3) huwandu = 3, mutsara-mutsva.

