
>> Size := Chinhu nyowani.
Size kana-zvasvika: ['is:'] ita: { :nhamba
	nhamba kana-zvasvika: ['+'] ita: { :nhamba
		>> unit := nhamba chiyero-chenhamba.
		>> factor := 1.
		
		unit
		kana-zvakadaro: ['inch'] ita: { factor := 0.0833. }. <- pachako + (nhamba * factor).
	}. <- nhamba.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Zvabuda nyora: plank + edge, mutsara-mutsva.
