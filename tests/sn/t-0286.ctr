['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Zvabuda nyora: (x + y), mutsara-mutsva.

>> x := 10040.07.
>> y := 10305.60.

Zvabuda nyora: (x + y), mutsara-mutsva.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Zvabuda nyora: (x + y + z), mutsara-mutsva.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Zvabuda nyora: (x + y + z), mutsara-mutsva.

>> q := 0.1.2.

Zvabuda nyora: (q), mutsara-mutsva.

>> q := 012.

Zvabuda nyora: (q), mutsara-mutsva.
