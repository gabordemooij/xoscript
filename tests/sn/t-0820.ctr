# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Pateni nyowani: pattern.
	p kuenderana: subject ita: { :m :g
		Zvabuda nyora: g huwandu, nyora: [' '], nyora: (g batanidza: ['|']), mutsara-mutsva. <- m.
	}.
}.
show shandisa: ['(a)|(b)'] uye: ['b'].
show shandisa: ['(a)|(b)'] uye: ['a'].
show shandisa: ['(x)?y'] uye: ['y'].
show shandisa: ['(x)?(y)(z)?'] uye: ['xy'].
