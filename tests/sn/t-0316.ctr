>> Grandfather := Chinhu nyowani.
Grandfather kana-zvasvika: ['greet'] ita: {
	Zvabuda nyora: ['Ave!'], mutsara-mutsva.
}.
>> Father := Grandfather nyowani.
Father kana-zvasvika: ['greet'] ita: {
	Zvabuda nyora: ['Hello'], mutsara-mutsva.
	pachako greet.
}.
>> Son := Father nyowani.
Son kana-zvasvika: ['greet'] ita: {
	Zvabuda nyora: ['Hi'], mutsara-mutsva.
	pachako greet.
}.

Son greet.

>> Roundabout := Chinhu nyowani.
Roundabout kana-zvasvika: ['circle:'] ita: { :x
	Zvabuda nyora: x, mutsara-mutsva.
	(x < 3) chokwadi: { pachako kuzvidaidza circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) chokwadi: { Zvabuda nyora: x, mutsara-mutsva. x wedzera: 1.  increment tanga. }. }.
increment tanga.