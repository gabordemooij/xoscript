Rondedzero kana-zvasvika: ['kopa'] ita: {
	>> kopa := Rondedzero nyowani.
	pachako chimwe-nechimwe: { :nhamba :section
		kopa wedzera-kumagumo: section kuzvidaidza kopa.
	}. <- kopa.
}.

>> sheep := Rondedzero nyowani ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep kopa.
clones chimwe-nechimwe: { :nhamba :sheep
	sheep wedzera-kumagumo: ['2'].
}.

Zvabuda nyora: sheep, mutsara-mutsva.
Zvabuda nyora: clones, mutsara-mutsva.
