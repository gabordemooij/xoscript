>> x := Chinhu nyowani.
x kana-zvasvika: ['set:'] ita: { :v zvako val := v. }.
x kana-zvasvika: ['get'] ita: { <- zvako val. }.
>> a := Chinhu nyowani.
a kana-zvasvika: ['init'] ita: {
	>> y := x nyowani.
	y set: 123.
	>> q := x nyowani.
	q set: 666.
	Zvabuda nyora: (y get), nyora: (q get).
}.
a init.
