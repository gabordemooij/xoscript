# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> nzira-yefaira := ['/tmp/dat.csv'].
>> csv := Faira nyowani: nzira-yefaira.
csv nyora: s.

# accepts CRLF LF CR, varying row length
csv chipatsanuri: [';'] chiratidzo-chekutaura: ['"'] mitsara: { :line
	Chirongwa chenesa.
	Zvabuda nyora: line, mutsara-mutsva.
	Chirongwa chenesa.
}.

# unequal lines
s wedzera-kumagumo: ['\njustone'].
csv nyora: s.
{
	csv chipatsanuri: [';'] chiratidzo-chekutaura: ['"'] mitsara: { :line
		Zvabuda nyora: line, mutsara-mutsva.
	}.
} bata: { :e 
	Zvabuda nyora: e, mutsara-mutsva.
}, tanga.

# invalid format
s := ['"he"llo";world'].
csv nyora: s.
{
	csv chipatsanuri: [';'] chiratidzo-chekutaura: ['"'] mitsara: { :line
		Zvabuda nyora: line, mutsara-mutsva.
	}.
} bata: { :e 
	Zvabuda nyora: e, mutsara-mutsva.
}, tanga.
