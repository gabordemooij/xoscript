# catch-all test (practical)
>> HTML := Mavara nyowani.
HTML kana-zvasvika: ['encode:'] ita: { :tekst
	pachako wedzera-kumagumo: (tekst
	tsiva: ['&'] na: ['&amp;'], 
	tsiva: ['<'] na: ['&lt;'],
	tsiva: ['>'] na: ['&gt;'],
	tsiva: ['"'] na: ['&quot;']).
}.
>> blog := HTML nyowani.
blog wedzera-kumagumo: ['<h1>'],
     encode: ['Koffie & Thee'],
     wedzera-kumagumo: ['</h1>'].
Zvabuda nyora: blog, mutsara-mutsva.


>> Roman := Nhamba nyowani.
Roman kana-zvasvika: ['stringy'] ita: {
	>> a := [''].
	{ a wedzera-kumagumo: ['I']. } × pachako. <- a.
}.

>> x := Roman nyowani.
x wedzera: 3.
Zvabuda nyora: x stringy, mutsara-mutsva.

>> Quantum := Bhuriyoni nyowani.
Quantum kana-zvasvika: ['true?'] ita: { <- ['maybe True']. }.
Zvabuda nyora: (Quantum nyowani true?), mutsara-mutsva.

>> Nihil := Hapana nyowani.
Nihil kana-zvasvika: ['mavara-emashoko'] ita: { <- ['Nihil']. }.
Zvabuda nyora: (Nihil nyowani), mutsara-mutsva.
