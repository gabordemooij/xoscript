Server init.

>> DB := Maria-DB nyowani mugamuchiri: ['localhost'],
	zita-remushandisi: ['xo'],
	pasiwedhi: ['pass123'],
	zita-redhatabhesi: ['xobase'],
	batana.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> maparamita-ekutsvaga := Mubvunzo-Maria nyowani: SQL.

# set database
maparamita-ekutsvaga dhatabhesi: DB.

maparamita-ekutsvaga tora: { :row
	Zvabuda nyora: row world, mutsara-mutsva.
}.
