# vault keys and signatures that decode too long must not overflow the stack
Server init.

>> keys := Dura-rakachengeteka gadzira-makiyi.
>> sk := keys chekutanga.
>> pk := keys chekupedzisira.
>> sig := Dura-rakachengeteka saina: ['abc'] ne: sk.

# 88 characters without padding decode to 66 bytes
>> long := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 characters without padding decode to 33 bytes
>> short := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Dura-rakachengeteka saina: ['abc'] ne: long. } bata: { :e
	Zvabuda nyora: e, mutsara-mutsva.
}, tanga.

{ Dura-rakachengeteka tarisa: ['abc'] siginecha: long ne: pk. } bata: { :e
	Zvabuda nyora: e, mutsara-mutsva.
}, tanga.

{ Dura-rakachengeteka tarisa: ['abc'] siginecha: sig ne: short. } bata: { :e
	Zvabuda nyora: e, mutsara-mutsva.
}, tanga.
