Zvabuda nyora: ['Test object'], mutsara-mutsva.
>> cmd := Murairo nyowani.
Zvabuda nyora: cmd ls /tmp, mutsara-mutsva.
>> old-cmd-address := cmd muenzaniso-wekutanga kero-yendangariro.
cmd save-as: ['/tmp/a.bin'].
Zvabuda nyora: ['========== RELOADING SNAP:'], mutsara-mutsva.
>> b := Chinhu load-from: ['/tmp/a.bin'].
(b muenzaniso-wekutanga kero-yendangariro = old-cmd-address) chokwadi: {
	Zvabuda nyora: ['Object link re-attached.'], mutsara-mutsva.
}.
Zvabuda nyora: b ls, mutsara-mutsva.


