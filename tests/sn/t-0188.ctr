

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Chirongwa kutonga-ndangariro: 0.

{ :i Zvabuda nyora: i. } × 4.
Zvabuda mutsara-mutsva.
{ :i Zvabuda nyora: (4 - i). } × 4.
Zvabuda mutsara-mutsva.
( 1 > 2 ) nhema: { Zvabuda nyora: ['BLOCK 1'], mutsara-mutsva. }.
( 2 > 1 ) chokwadi:  { Zvabuda nyora: ['BLOCK 2'], mutsara-mutsva. }.

>> i := 0.
{ Zvabuda nyora: i. i wedzera: 1. } kusvikira: { <- ( i < 3). }.
Zvabuda mutsara-mutsva.

i := 3.
{ Zvabuda nyora: i. i := i - 1. } kusvikira: { <- ( i > 0). }.
Zvabuda mutsara-mutsva.


Chirongwa chenesa.

usedMemory1 := (Chirongwa ndangariro ? 0).


{ :i  Zvabuda nyora: i. } × 4.
Zvabuda mutsara-mutsva.
{ :i  Zvabuda nyora: (4 - i). } × 4.
Zvabuda mutsara-mutsva.
( 1 > 2 ) nhema: { Zvabuda nyora: ['BLOCK 1'], mutsara-mutsva. }.
( 2 > 1 ) chokwadi:  { Zvabuda nyora: ['BLOCK 2'], mutsara-mutsva. }.

>> i := 0.
{ Zvabuda nyora: i. i wedzera: 1. } kusvikira: { <- ( i < 3). }.
Zvabuda mutsara-mutsva.

i := 3.
{ Zvabuda nyora: i. i := i - 1. } kusvikira: { <- ( i > 0). }.
Zvabuda mutsara-mutsva.



Chirongwa chenesa.
usedMemory2 := (Chirongwa ndangariro ? 0).


{ :i Zvabuda nyora: i. } × 4.
Zvabuda mutsara-mutsva.
{ :i Zvabuda nyora: (4 - i). } × 4.
Zvabuda mutsara-mutsva.
( 1 > 2 ) nhema: { Zvabuda nyora: ['BLOCK 1'], mutsara-mutsva. }.
( 2 > 1 ) chokwadi:  { Zvabuda nyora: ['BLOCK 2'], mutsara-mutsva. }.

>> i := 0.
{ Zvabuda nyora: i. i wedzera: 1. } kusvikira: { <- ( i < 3). }.
Zvabuda mutsara-mutsva.

i := 3.
{ Zvabuda nyora: i. i := i - 1. } kusvikira: { <- ( i > 0). }.
Zvabuda mutsara-mutsva.

Chirongwa chenesa.
usedMemory3 := (Chirongwa ndangariro ? 0).



( usedMemory1 = usedMemory2 uye: usedMemory1 = usedMemory3, uye: usedMemory2 = usedMemory3 ) chokwadi: {
	Zvabuda nyora: ['No memory leaks here'].
}, nhema: {
	Zvabuda nyora: ['Leaking memory...'].
}.
