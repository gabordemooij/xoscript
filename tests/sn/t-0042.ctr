>> items := Duramazwi nyowani.
items isa: ['black'] pa: ['coffee'], isa: ['earl grey'] pa: ['tea'].
Zvabuda nyora: (items pa: ['coffee']), nyora: (items pa: ['tea']).
Zvabuda nyora: ['there are'] + items huwandu + [' items in the array.'].
items isa: ['capuccino'] pa: ['coffee'].
Zvabuda nyora: ['Now my coffee is.. '] + (items pa: ['coffee']).
items isa: ['aaa'] pa: ['1'].
items isa: ['bbb'] pa: ['2'].
Zvabuda nyora: (items pa: ['a']).
