>> Animal := Chinhu nyowani.
Animal kana-zvasvika: ['make'] ita: {
	>> animal := Chinhu nyowani.
	animal kana-zvasvika: ['makeSound'] ita: {
		Zvabuda nyora: zvako sound.
	}. <- animal.
}.
>> Cat := Chinhu nyowani.
Cat kana-zvasvika: ['make'] ita: {
	>> cat := Animal make.
	cat kana-zvasvika: ['init'] ita: {
		zvako sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
