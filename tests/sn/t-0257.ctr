
>> Greeter := Chinhu nyowani.
Greeter kana-zvasvika: ['nyowani'] ita: {
	zvako zita := ['?'].
}.
Greeter kana-zvasvika: ['name:'] ita: { :zita
	zvako zita := zita.
}.
Greeter kana-zvasvika: ['greet'] ita: {
	Zvabuda nyora: (['hello[you]'] [you]: zvako zita).
}.
>> friend := Greeter nyowani.
friend name: ['1'].
friend greet.
