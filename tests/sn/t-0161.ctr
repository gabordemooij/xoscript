Chirongwa kutonga-ndangariro: 0.
Rondedzero kana-zvasvika: ['sum'] ita: {
	>> total := 0.
	pachako chimwe-nechimwe: { :index :element
		total wedzera: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Faira nyowani: ['/tmp/test.txt'].
f nyora: ['Lorem Ipsum'].
f vhara.
  

f := Faira nyowani: ['/tmp/test.txt'].
>> text := f verenga.
f vhara.



Chirongwa chenesa.
usedMemory1 := (Chirongwa ndangariro ? 1).



f := Faira nyowani: ['/tmp/test.txt'].
text := f verenga.
f vhara.

Chirongwa chenesa.
usedMemory2 := (Chirongwa ndangariro ? 1).


f := Faira nyowani: ['/tmp/test.txt'].
text := f verenga.
f vhara.

Chirongwa chenesa.
usedMemory3 := (Chirongwa ndangariro ? 1).



( usedMemory1 = usedMemory2 uye: usedMemory1 = usedMemory3, uye: usedMemory2 = usedMemory3 ) chokwadi: {
	Zvabuda nyora: ['No memory leaks here'].
}, nhema: {
