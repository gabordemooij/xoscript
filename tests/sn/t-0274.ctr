

Rondedzero kana-zvasvika: ['column:'] ita: { :column
	>> result := Rondedzero nyowani.
	pachako chimwe-nechimwe: { :index :row
		row chimwe-nechimwe: { :index :cell
			(index = column) chokwadi: { result wedzera-kumagumo: cell. }.
		}.
	}. <- result.
}.


>> a := Rondedzero ←
	(Rondedzero ← 1 ; 2 ; 3) ;
	(Rondedzero ← 4 ; 5 ; 6) ;
	(Rondedzero ← 7 ; 8 ; 9).

>> b := a column: 1.
Zvabuda nyora: b, mutsara-mutsva.

b := a column: 20.
Zvabuda nyora: b, mutsara-mutsva.

b := a column: -100.
Zvabuda nyora: b, mutsara-mutsva.
