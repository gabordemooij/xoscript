#Linux
>> OS := Chirongwa sisitimu: (Murairo uname -s), cheka-nzvimbo.

>> Slurp := Chinhu nyowani.
Slurp kana-zvasvika: ['nyowani'] ita: {
	zvako str := [''].
}.
Slurp kana-zvasvika: ['pindura:'] ita: { :blah
		(zvako str ≠ ['']) chokwadi: {
			zvako str wedzera-kumagumo: [' '].
		}.
		zvako str wedzera-kumagumo: blah.
}.
Slurp kana-zvasvika: ['pindura:uye:'] ita: { :blah :blahah
		(zvako str ≠ ['']) chokwadi: {
			zvako str wedzera-kumagumo: [' '].
		}.
		(blah kureba > 1) chokwadi: {
			zvako str wedzera-kumagumo: (blah kubva: 0 kureba: (blah kureba - 1)).
		}, kana-zvisiri: {
			zvako str wedzera-kumagumo: blah.
		}.
		zvako str wedzera-kumagumo: [' '].
		zvako str wedzera-kumagumo: blahah.
}.
Slurp kana-zvasvika: ['obtain'] ita: {
	>> buffer := zvako str.
	zvako str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text wedzera-kumagumo: ['hello'].
} × 1000.


Zvabuda nyora: (
	Chirongwa sisitimu: (
		Slurp nyowani
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

