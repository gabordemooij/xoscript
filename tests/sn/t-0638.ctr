
Server init.
>> rq := Chikumbiro-HTTP nyowani.
Zvabuda nyora: ['HTTP-GET d[]=']  + ( rq get-rondedzero: ['d[]'] ), mutsara-mutsva. # GET
Zvabuda nyora: ['HTTP-GET f[]=']  + ( rq get-rondedzero: ['f[]'] ), mutsara-mutsva. # GET
Zvabuda nyora: ['HTTP-POST e[]='] + ( rq post-rondedzero: ['e[]'] ), mutsara-mutsva. # GET
Zvabuda nyora: ['HTTP-POST c=']   + ( rq post: ['c'] ), mutsara-mutsva. # GET
Zvabuda nyora: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), mutsara-mutsva. # GET
