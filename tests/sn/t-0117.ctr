>> t := Chokwadi.
(t = Chokwadi) chokwadi: { Zvabuda nyora: ['T']. }.
(t = Nhema) chokwadi: { Zvabuda nyora: ['F']. }.
Zvabuda nyora: ['|'].
>> t := Nhema.
(t = Chokwadi) chokwadi: { Zvabuda nyora: ['T']. }.
(t = Nhema) chokwadi: { Zvabuda nyora: ['F']. }.
Zvabuda nyora: ['|'].
>> f := Chokwadi.
(t = Chokwadi uye: f = Nhema) chokwadi: { Zvabuda nyora: ['T']. }.
(t = Nhema uye: f = Chokwadi) chokwadi: { Zvabuda nyora: ['F']. }.
Zvabuda nyora: ['|'].
>> n := Hapana.
(n Hapana?) chokwadi: { Zvabuda nyora: ['T']. }.
(n Hapana?) nhema: { Zvabuda nyora: ['F']. }.
Zvabuda nyora: ['|'].
(f Boolean?) chokwadi: { Zvabuda nyora: ['T']. }.
(f Boolean?) nhema: { Zvabuda nyora: ['F']. }.



