Zvabuda nyora: ['Test object'], mutsara-mutsva.
>> a := Chinhu nyowani. 

a kana-zvasvika: ['item:'] ita: { :fmt
	zvako fmt := fmt. 
}.

a kana-zvasvika: ['item'] ita: { <- zvako fmt.
}.

a item: ( Chimiro nyowani: ['|%s|'] ).

Zvabuda nyora: a item, mutsara-mutsva.

>> old-fmt-address := a item muenzaniso-wekutanga kero-yendangariro.
a save-as: ['/tmp/a.bin'].
Zvabuda nyora: ['========== RELOADING SNAP:'], mutsara-mutsva.

>> b := Chinhu load-from: ['/tmp/a.bin'].

(b item muenzaniso-wekutanga kero-yendangariro = old-fmt-address) chokwadi: {
	Zvabuda nyora: ['Object link re-attached.'], mutsara-mutsva.
}.

Zvabuda nyora: ( b item shandisa: ['hello'] ), mutsara-mutsva.
