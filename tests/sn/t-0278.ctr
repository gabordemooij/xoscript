>> To-Do := Chinhu nyowani.

To-Do kana-zvasvika: ['nyowani'] ita: {
	zvako list := Rondedzero nyowani.
}.

To-Do kana-zvasvika: ['nieuw'] ita: {
	zvako list := Rondedzero nyowani.
}.

To-Do kana-zvasvika: ['+'] ita: { :task
	zvako list wedzera-kumagumo: task.
}.

To-Do kana-zvasvika: ['number of tasks?'] ita: { <-  zvako list huwandu.
}.

>> todos := 
	To-Do nyowani 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Zvabuda nyora: ['You have $ tasks to do'] $ todos number of tasks?.
