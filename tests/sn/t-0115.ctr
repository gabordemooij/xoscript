{
	basa-iri chikanganiso: ['Dont fail.'].
	unknown doSomething.
} bata: {
	Zvabuda nyora: ['Caught!'].
}, tanga.

{
	basa-iri chikanganiso: ['Dont fail.'].
	zvako unknown doSomething.
} bata: {
	Zvabuda nyora: ['Caught!'].
}, tanga.

{
	basa-iri chikanganiso: ['Dont fail.'].
	unknown := 122.
} bata: {
	Zvabuda nyora: ['Caught!'].
}, tanga.


{
	basa-iri chikanganiso: ['Dont fail.'].
	Chokwadi gura.
	Zvabuda nyora: ['FAIL'].
} bata: {
	Zvabuda nyora: ['Caught!'].
}, tanga.

{
	{
		basa-iri chikanganiso: ['Dont fail.'].
		Chokwadi gura.
		Zvabuda nyora: ['FAIL'].
	} bata: { :x
		(x = ['Dont fail.']) chokwadi: { basa-iri chikanganiso: ['Nested Caught!']. }.
	}, tanga.
} bata: { :e
	Zvabuda nyora: e.
}, tanga.
