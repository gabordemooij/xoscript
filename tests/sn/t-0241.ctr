

Mavara kana-zvasvika: ['evaluate'] ita: {
	>> kodhi := Faira nyowani: ['/tmp/eval.ctr'].
	kodhi nyora: (pachako mavara-emashoko + ['.']).
	Chirongwa shandisa-chishandiso: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Rondedzero ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q mavara-emashoko.
Zvabuda nyora: x, mutsara-mutsva.
>> y := Hapana.
(['y := '] + x ) evaluate.
Zvabuda nyora: y ? 0, mutsara-mutsva.

q := Duramazwi isa: ['\[''] pa: ['\['quote\']'].
x := q mavara-emashoko.
Zvabuda nyora: x, mutsara-mutsva.
y := Hapana.
(['y := '] + x ) evaluate.

>> q := (Duramazwi nyowani) isa:['\[''] pa:['\['quote\[''].
Zvabuda nyora: y ? ['\['quote\']'], mutsara-mutsva.
