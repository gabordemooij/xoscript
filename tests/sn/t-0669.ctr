# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Dura-rakachengeteka 
	hash-yepasiwedhi: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Dura-rakachengeteka 
	hash-yepasiwedhi: hash simbisa: a1.
	# fail 
>> b := Dura-rakachengeteka
	hash-yepasiwedhi: hash simbisa: a2.
	# ok!

Zvabuda nyora: a, mutsara-mutsva.
Zvabuda nyora: b, mutsara-mutsva.

