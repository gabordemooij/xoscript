Server init.
>> f := Chimiro nyowani: ['%d'].
>> a := Blob nyowani: 4.
a bytes: ( Rondedzero nyowani ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob nyowani: 4.
b bytes: ( Rondedzero nyowani ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a kubva: 0 kureba: 3, chimwe-nechimwe: { :i :byte
	Zvabuda nyora: ( f shandisa-nhamba-izere: byte ), mutsara-mutsva.
}.
a ^ b.
a kubva: 0 kureba: 3, chimwe-nechimwe: { :i :byte
	Zvabuda nyora: ( f shandisa-nhamba-izere: byte ), mutsara-mutsva.
}.
a ^ b.
a kubva: 0 kureba: 3, chimwe-nechimwe: { :i :byte
	Zvabuda nyora: ( f shandisa-nhamba-izere: byte ), mutsara-mutsva.
}.
a sunungura.
b sunungura.

{ a ^ Chinhu. } bata: { :e Zvabuda nyora: e, mutsara-mutsva. }, tanga.
