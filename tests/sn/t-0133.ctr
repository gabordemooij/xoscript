


>> Deck := Rondedzero nyowani.
Deck kana-zvasvika: ['print'] ita: {
        >> len := pachako huwandu - 1.
        { :i
                >> len2 := pachako huwandu - 1.
                Zvabuda nyora: ['len: '].
                Zvabuda nyora: len, mutsara-mutsva.
                Zvabuda nyora: ['len2: '].
                Zvabuda nyora: len2, mutsara-mutsva.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
