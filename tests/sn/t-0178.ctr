Zvabuda nyora: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), mutsara-mutsva.
Zvabuda nyora: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), mutsara-mutsva.
Zvabuda nyora: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), mutsara-mutsva.

