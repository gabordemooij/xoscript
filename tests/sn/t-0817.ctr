# a value ending in the first part of an opening quote must survive serialization
>> makoshero := Rondedzero nyowani
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

makoshero chimwe-nechimwe: { :i :value
	>> d := Duramazwi nyowani.
	d isa: value pa: ['k'].
	d isa: ['second'] pa: ['j'].
	>> r := d kodhi chinhu.
	Zvabuda nyora: r huwandu, mutsara-mutsva.
	Zvabuda nyora: ( (r pa: ['k']) = value ), mutsara-mutsva.
}.
