# test list operations


>> cakes := Rondedzero ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes kutsiva: 1 kureba: 2 na: ( Rondedzero ← ['cinnamon'] ; ['pineapple'] ).
Zvabuda nyora: (buy batanidza: [',']), mutsara-mutsva.


>> buy := cakes kutsiva: 1 kureba: 12 na: ( Rondedzero ← ['cinnamon'] ; ['pineapple'] ).
Zvabuda nyora: (buy batanidza: [',']), mutsara-mutsva.


>> buy := cakes kutsiva: 2 kureba: 10 na: ( Rondedzero nyowani ).
Zvabuda nyora: (buy batanidza: [',']), mutsara-mutsva.


>> buy := cakes kutsiva: 0 kureba: 1 na: ( Rondedzero nyowani ).
Zvabuda nyora: (buy batanidza: [',']), mutsara-mutsva.


>> buy := cakes kutsiva: ['0'] kureba: ['1'] na: ['x'].
Zvabuda nyora: (buy batanidza: [',']), mutsara-mutsva.
