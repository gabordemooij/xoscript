>> x := Nguva-chaiyo nyowani.
x nzvimbo-yenguva: ['CEST'],
gore:2017,
mwedzi:01,
zuva:10,
awa: 10,
mineti: 0,
sekondi: 0.

Zvabuda nyora: x, mutsara-mutsva.

Zvabuda nyora: x nguva, mutsara-mutsva.

x wedzera: 1 sekondi.
x wedzera: 2 mineti.
x wedzera: 3 awa.
x wedzera: 4 zuva.
x wedzera: 1 mwedzi.
x wedzera: 6 gore.

Zvabuda nyora: x, mutsara-mutsva.

x bvisa-nhamba: 1 sekondi.
x bvisa-nhamba: 2 mineti.
x bvisa-nhamba: 3 awa.
x bvisa-nhamba: 4 zuva.
x bvisa-nhamba: 1 mwedzi.
x bvisa-nhamba: 6 gore.

Zvabuda nyora: x, mutsara-mutsva.

>> y := x kopa.
>> z := x.

Zvabuda nyora: y, mutsara-mutsva.
Zvabuda nyora: z, mutsara-mutsva.
Zvabuda nyora: (x nzvimbo-yenguva = y nzvimbo-yenguva), mutsara-mutsva.
Zvabuda nyora: (x nguva = y nguva), mutsara-mutsva.
Zvabuda nyora: (x = z), mutsara-mutsva.
Zvabuda nyora: x zuva-regore, mutsara-mutsva.
Zvabuda nyora: x zuva-revhiki, mutsara-mutsva.
Zvabuda nyora: x vhiki, mutsara-mutsva.
