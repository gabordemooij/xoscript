Zvabuda nyora: ['Test object'], mutsara-mutsva.
>> a := Chinhu nyowani. 
a kana-zvasvika: ['item:'] ita: { :int64
	zvako int64 := int64. 
}.
a kana-zvasvika: ['item'] ita: { <- zvako int64.
}.
a item: ( Int64 kubva-mumavara: ['9999'] ).
Zvabuda nyora: a item, mutsara-mutsva.
>> old-int64-address := a item muenzaniso-wekutanga kero-yendangariro.
a save-as: ['/tmp/a.bin'].
Zvabuda nyora: ['========== RELOADING SNAP:'], mutsara-mutsva.
>> b := Chinhu load-from: ['/tmp/a.bin'].
(b item muenzaniso-wekutanga kero-yendangariro = old-int64-address) chokwadi: {
	Zvabuda nyora: ['Object link re-attached.'], mutsara-mutsva.
}.
Zvabuda nyora: ( b item ), mutsara-mutsva.
