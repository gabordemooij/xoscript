Zvabuda nyora: (['a:b:'] - [':']), mutsara-mutsva.
Zvabuda nyora: (['Lorem Ipsum'] - ['Ipsum']), mutsara-mutsva.
Zvabuda nyora: (['a.................b.......................c...........'] - ['.']), mutsara-mutsva.
Zvabuda nyora: (['a--b--c---d'] - ['--']), mutsara-mutsva.
Zvabuda nyora: (['-'] - ['--']), mutsara-mutsva.
Zvabuda nyora: ([''] - ['--']), mutsara-mutsva.
Zvabuda nyora: (['--'] - ['']), mutsara-mutsva.
Zvabuda nyora: ([''] - ['']), mutsara-mutsva.
>> x := ['xx'].
>> y := x - ['x'].
Zvabuda nyora: x, mutsara-mutsva.
Zvabuda nyora: y, mutsara-mutsva.
>> x := ['a,bb,c'].
>> y := x tsiva: [''] na: ['xx'].
Zvabuda nyora: ((x zvakafanana: y) ichi: ['OK'] kana-icho: ['BUG! Did return a copy by accident!']), mutsara-mutsva.