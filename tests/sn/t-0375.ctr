Server init.

# create a memory block of 10 bytes
>> ndangariro := Blob nyowani: 10.

# fill it with 3 bytes
ndangariro bytes: ( Rondedzero nyowani ; 65 ; 66 ; 67 ).

# write the bytes to StdOut as a string
Zvabuda nyora: ndangariro mavara-emashoko, mutsara-mutsva.

# free the memory block
ndangariro sunungura.

