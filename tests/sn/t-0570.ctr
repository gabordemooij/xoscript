#Linux

 >> t := Nguva-chaiyo nyowani.
 
t nzvimbo-yenguva: ['Europe/Amsterdam'].
t gore: 2020, mwedzi: 8, zuva: 2, awa: 21, mineti: 2, sekondi: 1.

>> a := t awa.
>> ams := t nzvimbo-yenguva.

t nzvimbo-yenguva: ['US/Hawaii'].
>> b := t awa.
>> hw := t nzvimbo-yenguva.

Zvabuda
nyora: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		ichi: ['later'] kana-icho: ['earlier']
	)
),
mutsara-mutsva.
 