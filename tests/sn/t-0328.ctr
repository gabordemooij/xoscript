Chirongwa kutonga-ndangariro: 4.

>> Doubler := Chinhu nyowani.
>> Multiplier := Chinhu nyowani.
Doubler kana-zvasvika: ['double:and:'] ita: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier kana-zvasvika: ['multiply:and:'] ita: { :x :y <- (x × y).
}.

Zvabuda nyora: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), mutsara-mutsva.
