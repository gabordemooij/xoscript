# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Chirongwa shell-escape: ['abc'].
Zvabuda nyora: c, mutsara-mutsva.
Zvabuda nyora: ( Chirongwa sisitimu: ['echo '] + c ), mutsara-mutsva.

c := Chirongwa shell-escape: ['a'b'c'].
Zvabuda nyora: c, mutsara-mutsva.
Zvabuda nyora: ( Chirongwa sisitimu: ['echo '] + c ), mutsara-mutsva.

c := Chirongwa shell-escape: ['a\'c'].
Zvabuda nyora: c, mutsara-mutsva.
Zvabuda nyora: ( Chirongwa sisitimu: ['echo '] + c ), mutsara-mutsva.