
>> Rectangle := Chinhu nyowani.

Rectangle kana-zvasvika: ['area'] ita: { <- zvako kureba * zvako width.
}.

Rectangle kana-zvasvika: ['length:'] ita: { :kureba
	zvako kureba := kureba.
}.

Rectangle kana-zvasvika: ['width:'] ita: { :width
	zvako width := width.
}.

Rectangle kana-zvasvika: ['nyowani'] ita: {
	# this will not result into an infinite loop
	>> rectangle := pachako nyowani.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle nyowani.
Zvabuda nyora: a area, mutsara-mutsva. #0

>> b := Rectangle nyowani length: 2, width: 3.
Zvabuda nyora: b area, mutsara-mutsva. #6

