# backslashes must survive code serialization, strings must not end early
>> makoshero := Rondedzero nyowani
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

makoshero chimwe-nechimwe: { :i :value
	>> d := Duramazwi nyowani.
	d isa: value pa: ['k'].
	>> r := d kodhi chinhu.
	Zvabuda nyora: r huwandu, mutsara-mutsva.
	Zvabuda nyora: ( (r pa: ['k']) = value ), mutsara-mutsva.
}.
