# test catch-all methods
>> x13 := Chinhu nyowani.
x13 kana-zvasvika: ['a'] ita: { :a Zvabuda nyora: 0, mutsara-mutsva. }.
x13 kana-zvasvika: ['a:'] ita: { :a Zvabuda nyora: a, mutsara-mutsva. <- 5. }.
x13 kana-zvasvika: ['a:b:'] ita: { :a :b Zvabuda nyora: (a + b), mutsara-mutsva. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
