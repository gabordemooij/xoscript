>> Point := Chinhu nyowani.
Point kana-zvasvika: ['x-coordinate:'] ita: { :x zvako x := x. }.
Point kana-zvasvika: ['y-coordinate:'] ita: { :y zvako y := y. }.
Point kana-zvasvika: ['x-coordinate']  ita: { <- zvako x kopa. }.
Point kana-zvasvika: ['y-coordinate']  ita: { <- zvako y kopa. }.

Point kana-zvasvika: ['='] ita: { :other <- ( zvako x = other x-coordinate
		 uye: zvako y = other y-coordinate ).
}.

>> pier := Point nyowani x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point nyowani x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point nyowani x-coordinate: 5, y-coordinate: 6.

Zvabuda nyora: pier = town-hall, mutsara-mutsva.
Zvabuda nyora: pier = restaurant, mutsara-mutsva.
