Server init.

>> DB := Maria-DB nyowani mugamuchiri: ['localhost'],
	zita-remushandisi: ['xo'],
	pasiwedhi: ['pass123'],
	zita-redhatabhesi: ['xobase'],
	batana.

{
	DB mubvunzo:
	['DROP TABLE movies'],
	ita-murairo.
} bata: { Hapana. }, tanga.

DB mubvunzo:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
ita-murairo.

DB mubvunzo: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
maparamita: ( Rondedzero nyowani ; ['Halloween'] ),
ita-murairo.

DB mubvunzo: ['SELECT * FROM movies'],
tora: { :movie
	Zvabuda nyora: movie title, mutsara-mutsva.
}.

