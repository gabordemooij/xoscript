

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Chirongwa kutonga-ndangariro: 0.

>> o := Chinhu nyowani.
>> o2 := Chinhu nyowani.
Zvabuda nyora: o Hapana?, mutsara-mutsva.
Zvabuda nyora: o mhando, mutsara-mutsva.
Zvabuda nyora: ( o zvakafanana: o ), mutsara-mutsva.
Zvabuda nyora: ( o zvakafanana: o2 ), mutsara-mutsva.
Zvabuda nyora: o ini-pachangu, mutsara-mutsva.
Zvabuda nyora: ( o ita zvaitwa ), mutsara-mutsva.

Chirongwa chenesa.

usedMemory1 := (Chirongwa ndangariro ? 0).


o := Chinhu nyowani.
