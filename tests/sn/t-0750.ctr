Zvabuda nyora: ['Test object'], mutsara-mutsva.
>> a := Chinhu nyowani. 

a kana-zvasvika: ['item:'] ita: { :nil
	zvako nil := nil. 
}.

a kana-zvasvika: ['item'] ita: { <- zvako nil.
}.

a item: Hapana.

Zvabuda nyora: a item, mutsara-mutsva.

>> old-nil-address := a item muenzaniso-wekutanga kero-yendangariro.
a save-as: ['/tmp/a.bin'].
Zvabuda nyora: ['========== RELOADING SNAP:'], mutsara-mutsva.

>> b := Chinhu load-from: ['/tmp/a.bin'].

(b item muenzaniso-wekutanga kero-yendangariro = old-nil-address) chokwadi: {
	Zvabuda nyora: ['Object link re-attached.'], mutsara-mutsva.
}.

Zvabuda nyora: b item, mutsara-mutsva.
