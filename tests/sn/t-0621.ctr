>> phrases := Rondedzero nyowani
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases chimwe-nechimwe: { :_ :phrase 
	>> e := Server base64-isa-kodhi: phrase.
	>> d := Server base64-bvisa-kodhi: e.
	Zvabuda nyora: (
		message kopa ~encoded: e, ~decoded: d
	), mutsara-mutsva.
}.
