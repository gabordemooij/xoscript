# test qualifiers

Chirongwa chenesa.

>> Fruit := Chinhu nyowani.
Fruit kana-zvasvika: ['nyowani'] ita: {
	>> f := pachako nyowani.
	f apples: 0. <- f.
}.
Fruit kana-zvasvika: ['apples:'] ita: { :a zvako apples := a. }.
Fruit kana-zvasvika: ['apples'] ita: { <- zvako apples. }.
Fruit kana-zvasvika: ['+'] ita: { :f
	>> n := Fruit nyowani.
	n apples: (f apples + zvako apples). <- n.
}.
Nhamba kana-zvasvika: ['apples'] ita: { <- ((Fruit nyowani) apples: pachako).
}.

Fruit kana-zvasvika: ['mavara-emashoko'] ita: { <- zvako apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Zvabuda nyora: q, mutsara-mutsva.




q := 3 apples + 4 apples.
Zvabuda nyora: q, mutsara-mutsva.



q := 3 apples + 4 apples.
Zvabuda nyora: q, mutsara-mutsva.


