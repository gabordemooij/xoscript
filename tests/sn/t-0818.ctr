# edge cases from a request must give an error or a result, not a crash
Server init.

Zvabuda nyora: ['<'] + (['abc'] kubva: 0 kureba: 0, mabhii-makuru) + ['>'], mutsara-mutsva.
Zvabuda nyora: ['<'] + (['abc'] kubva: 0 kureba: 0, mabhii-madiki) + ['>'], mutsara-mutsva.
Zvabuda nyora: ['<'] + (['abc'] svetuka: 3, mabhii-makuru) + ['>'], mutsara-mutsva.
Zvabuda nyora: [''] mabhii-makuru bytes, mutsara-mutsva.
Zvabuda nyora: ['aB'] mabhii-makuru, mutsara-mutsva.
Zvabuda nyora: ['aB'] mabhii-madiki, mutsara-mutsva.

Zvabuda nyora: (Nguva-chaiyo nyowani: 0) gore, mutsara-mutsva.
{ Nguva-chaiyo nyowani: ['9e300'] nhamba. } bata: { :e Zvabuda nyora: e, mutsara-mutsva. }, tanga.
{ Nguva-chaiyo nyowani: ['-9e300'] nhamba. } bata: { :e Zvabuda nyora: e, mutsara-mutsva. }, tanga.
{ Nguva-chaiyo nyowani: ['nan'] nhamba. } bata: { :e Zvabuda nyora: e, mutsara-mutsva. }, tanga.
{ Nguva-chaiyo nyowani: 9000000000000000000. } bata: { :e Zvabuda nyora: e, mutsara-mutsva. }, tanga.
