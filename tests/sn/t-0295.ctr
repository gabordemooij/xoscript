
>> dictionary := (
	Duramazwi nyowani
		isa: ['b'] pa: ['a'],
		isa: ['a'] pa: ['b'],
		isa: ['z'] pa: ['x'],
		isa: ['hello'] pa: ['hallo'],
		isa: ['human'] pa: ['human']
).

>> comparisons := Rondedzero nyowani.
dictionary chimwe-nechimwe: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a enzanisa: b)
	).
}.

comparisons ronga: { :a :b <- ( a enzanisa: b ). }.
Zvabuda nyora: ( comparisons batanidza: ['↵'] ), mutsara-mutsva.
comparisons batanidza: ['↵'].
