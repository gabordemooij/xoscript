# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB nyowani mugamuchiri: ['localhost'],
	zita-remushandisi: ['xo'],
	pasiwedhi: ['pass123'],
	zita-redhatabhesi: ['xobase'],
	batana.

>> maparamita-ekutsvaga := db mubvunzo: ['SELECT %% FROM'].
{ maparamita-ekutsvaga ita-murairo. } bata: { :e
	Zvabuda nyora: ( e rine: ['%%'] ), mutsara-mutsva.
}, tanga.
