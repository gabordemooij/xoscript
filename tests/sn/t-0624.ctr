# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := Chinhu nyowani.

Log kana-zvasvika: ['say:'] ita: { :str
	Zvabuda nyora: str, mutsara-mutsva.
}.

>> Item := Chinhu nyowani.

Item kana-zvasvika: ['nyowani:'] ita: { :id <- pachako nyowani id: id.
}.

Item kana-zvasvika: ['id:'] ita: { :id
	zvako id := id.
}.

Item kana-zvasvika: ['id'] ita: { <- zvako id. }.


Item kana-zvasvika: ['mavara-emashoko'] ita: {
	>> str := ['Item#~no'].
	str ~no: zvako id. <- str.
}.


>> Print := Chinhu nyowani.

Print kana-zvasvika: ['items'] ita: { 
	
	zvako item := Item nyowani: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: zvako item
	).
	
	
}.

Print items.