# from:length: counts characters and survives very large numbers
>> s := ['ééééééééééééééé'].
Zvabuda nyora: (s kopa kubva: 0 kureba: 20), mutsara-mutsva.
Zvabuda nyora: (s kopa kubva: 10 kureba: 20), mutsara-mutsva.
Zvabuda nyora: (s kopa kubva: 14 kureba: 1), mutsara-mutsva.
Zvabuda nyora: (s kopa svetuka: 20), mutsara-mutsva.
Zvabuda nyora: ['-'], mutsara-mutsva.
Zvabuda nyora: (['abcdef'] kubva: 2 kureba: 2), mutsara-mutsva.
Zvabuda nyora: (['abc'] kubva: 1 kureba: ['9e300'] nhamba), mutsara-mutsva.
Zvabuda nyora: (['abc'] kubva: 1 kureba: ['-9e300'] nhamba), mutsara-mutsva.
Zvabuda nyora: (['abc'] kubva: ['9e300'] nhamba kureba: 1), mutsara-mutsva.
Zvabuda nyora: ['-'], mutsara-mutsva.
Zvabuda nyora: (['abc'] kubva: ['-9e300'] nhamba kureba: 2), mutsara-mutsva.
Zvabuda nyora: (['abc'] kubva: ['nan'] nhamba kureba: 2), mutsara-mutsva.
Zvabuda nyora: (['abc'] kubva: 0 kureba: ['nan'] nhamba), mutsara-mutsva.
Zvabuda nyora: ['-'], mutsara-mutsva.
