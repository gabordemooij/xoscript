# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob nyowani: 8, bytes: (
	Rondedzero nyowani ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Zvabuda nyora: ( utf16 bvisa-kodhi: ['utf16le'] ), mutsara-mutsva.

utf16 sunungura.
>> utf32 := Blob nyowani: 13, bytes: (
	Rondedzero nyowani ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Zvabuda nyora: ( utf32 bvisa-kodhi: ['utf32be'] ), mutsara-mutsva.
utf32 sunungura.