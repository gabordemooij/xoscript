#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Chirongwa kutonga-ndangariro: 0.

{
Nguva-chaiyo nguva.
Nguva-chaiyo mirira: 1.
Zvabuda nyora: Chirongwa huwandu-hwezvipinzwa, mutsara-mutsva.
Chirongwa chipinzwa: 0.
Nhamba random.
Zvabuda nyora: (Chirongwa sisitimu: ['echo 'Hello'']).
} tanga.

Chirongwa chenesa.
usedMemory1 := (Chirongwa ndangariro ? 0).

{
Nguva-chaiyo nguva.
Nguva-chaiyo mirira: 1.
Zvabuda nyora: Chirongwa huwandu-hwezvipinzwa, mutsara-mutsva.
Chirongwa chipinzwa: 0.
Nhamba random.
Zvabuda nyora: (Chirongwa sisitimu: ['echo 'Hello'']).
} tanga.

Chirongwa chenesa.
usedMemory2 := (Chirongwa ndangariro ? 0).

{
Nguva-chaiyo nguva.
Nguva-chaiyo mirira: 1.
Zvabuda nyora: Chirongwa huwandu-hwezvipinzwa, mutsara-mutsva.
Chirongwa chipinzwa: 0.
Nhamba random.
Zvabuda nyora: (Chirongwa sisitimu: ['echo 'Hello'']).
} tanga.

Chirongwa chenesa.
usedMemory3 := (Chirongwa ndangariro ? 0).



( usedMemory1 = usedMemory2 uye: usedMemory1 = usedMemory3, uye: usedMemory2 = usedMemory3 ) chokwadi: {
	Zvabuda nyora: ['No memory leaks here'].
}, nhema: {
	Zvabuda nyora: ['Leaking memory...'].
}.
