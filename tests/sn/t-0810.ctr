# tccompare must also compare the length of both strings
Zvabuda nyora: (['secret'] tccompare: ['']), mutsara-mutsva.
Zvabuda nyora: ([''] tccompare: ['secret']), mutsara-mutsva.
Zvabuda nyora: (['secret'] tccompare: ['sec']), mutsara-mutsva.
Zvabuda nyora: (['sec'] tccompare: ['secret']), mutsara-mutsva.
Zvabuda nyora: (['secret'] tccompare: ['secret']), mutsara-mutsva.
Zvabuda nyora: ([''] tccompare: ['']), mutsara-mutsva.
