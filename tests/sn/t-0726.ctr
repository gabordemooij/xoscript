# test buffers PKI/Sign 
Server init.

>> long := ( Rondedzero nyowani zadza: 1000 na: ['a'] ) batanidza: [''].

# sign a message
Zvabuda nyora: ( 
	Dura-rakachengeteka saina: ['abc'] ne: long
), mutsara-mutsva.

Zvabuda nyora: ( 
	Dura-rakachengeteka
		tarisa: ['abc'] 
		siginecha: long 
		ne: long
), mutsara-mutsva.

Zvabuda nyora: (
	Dura-rakachengeteka hash-yepasiwedhi: long simbisa: long
), mutsara-mutsva.
