Server init.

>> db := Maria-DB nyowani mugamuchiri: ['localhost'],
	zita-remushandisi: ['xo'],
	pasiwedhi: ['pass123'],
	zita-redhatabhesi: ['xobase'],
	batana.

>> del := db mubvunzo: ['DELETE FROM book WHERE id > 0'].
{  del ita-murairo. db simbisa. } bata: { :e db dzosera-shure.  }, tanga.

>> huwandu := db mubvunzo: ['SELECT COUNT(*) AS num FROM book'].
huwandu tora: { :row Zvabuda nyora: row num, mutsara-mutsva. }.
