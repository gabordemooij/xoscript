



>> CoffeeGrounds := Chinhu nyowani.
CoffeeGrounds kana-zvasvika: ['extract'] ita: { <- ['coffee']. }.

>> CoffeeMachine := Chinhu nyowani.
CoffeeMachine kana-zvasvika: ['init'] ita: {
	zvako coffeegrounds := CoffeeGrounds nyowani.
}.
CoffeeMachine kana-zvasvika: ['nyowani'] ita: { <- CoffeeMachine `new init.
}.

CoffeeMachine kana-zvasvika: ['makeTea'] ita: { <- (zvako tealeaves extract). }.
CoffeeMachine kana-zvasvika: ['makeCoffee'] ita: { <- (zvako coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine nyowani.

Zvabuda nyora:
	coffeeDream 
	makeCoffee.

Zvabuda nyora:
	coffeeDream 
	makeTea.
