# test number -> string -> number
{

	>> x := Nhamba pakati: 0 uye: 1000000.
	>> d := Nhamba pakati: 1 uye: 7.
	>> e := 10 simba-renhamba: d.

	x govanisa-ne: e.
	>> y := x mavara-emashoko nhamba.

	(x = y) nhema: {
		Zvabuda nyora: x, mutsara-mutsva.
		Zvabuda nyora: y, mutsara-mutsva.
		Chirongwa pedza.
	}.

} * 1000.
Zvabuda nyora: ['OK'], mutsara-mutsva.