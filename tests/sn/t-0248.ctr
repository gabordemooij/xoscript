

Mavara kana-zvasvika: ['evaluate'] ita: {
	>> kodhi := Faira nyowani: ['/tmp/eval.ctr'].
	kodhi nyora: pachako mavara-emashoko + ['.'].
	Chirongwa shandisa-chishandiso: ['/tmp/eval.ctr'].
}.

>> a := (Rondedzero ← (
	(Duramazwi nyowani)
		isa: ['domain'] pa: ['mywebsite.com'],
		isa: (Rondedzero ←
			((Duramazwi nyowani)
				isa: ['home'] pa: ['title'],
				isa: ['<html></html>'] pa: ['body'],
				isa: ['2017-01-01'] pa: ['created']
			) ;
			((Duramazwi nyowani)
				isa: ['aboutus(c)'] pa: ['title'],
				isa: ['<credits>Author Inc.</credits>'] pa: ['body']
			)
		) pa: ['pages']
	)
) mavara-emashoko.

Zvabuda nyora: a mhando, mutsara-mutsva.
Zvabuda nyora: a, mutsara-mutsva.

>> b := Hapana.
(['b := '] + a) evaluate.
Zvabuda nyora: b ? 0 ? ['pages'] ? 1 ? ['body'], mutsara-mutsva.

>> c := b ? 0.
>> d := c mavara-emashoko.
Zvabuda nyora: d mhando, mutsara-mutsva.

>> e := Hapana.
(['e := '] + d) evaluate.
Zvabuda nyora: e ? ['pages'] ? 0, mutsara-mutsva.
