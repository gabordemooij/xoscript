Mavara kana-zvasvika: ['html'] ita: { <- (
		pachako
		tsiva: ['&'] na: ['&amp;'],
		tsiva: ['<'] na: ['&lt;'],
		tsiva: ['>'] na: ['&gt;'],
		tsiva: ['''] na: ['&apos;'],
		tsiva: ['"'] na: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Chirongwa kutonga-ndangariro: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Zvabuda nyora: txt kopa html, mutsara-mutsva.
Zvabuda nyora: txt kopa mabhii-madiki, mutsara-mutsva.
Zvabuda nyora: txt kopa mabhii-makuru, mutsara-mutsva.
} tanga.

Chirongwa chenesa.

usedMemory1 := (Chirongwa ndangariro ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Zvabuda nyora: txt kopa html, mutsara-mutsva.
Zvabuda nyora: txt kopa mabhii-madiki, mutsara-mutsva.
Zvabuda nyora: txt kopa mabhii-makuru, mutsara-mutsva.
} tanga.

Chirongwa chenesa.
usedMemory2 := (Chirongwa ndangariro ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Zvabuda nyora: txt kopa html, mutsara-mutsva.
Zvabuda nyora: txt kopa mabhii-madiki, mutsara-mutsva.
Zvabuda nyora: txt kopa mabhii-makuru, mutsara-mutsva.
} tanga.

Chirongwa chenesa.
usedMemory3 := (Chirongwa ndangariro ? 0).



( usedMemory1 = usedMemory2 uye: usedMemory1 = usedMemory3, uye: usedMemory2 = usedMemory3 ) chokwadi: {
	Zvabuda nyora: ['No memory leaks here'].
}, nhema: {
	Zvabuda nyora: ['Leaking memory...'].
}.
