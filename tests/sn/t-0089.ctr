>> randomizer := { :a :b
	>> diki-diki := ( a < b ) ichi: a kana-icho: b.
	>> huru-huru := ( a > b ) ichi: a kana-icho: b.
	>> x := Hapana.
	{
		x := Nhamba pakati: a uye: b.
		((x < diki-diki) kana: (x > huru-huru)) chokwadi: { 
			Zvabuda nyora: (['Invalid value!']).
			Chirongwa pedza.
		}.
	} 
	× 100. <- x.
}.
randomizer shandisa: 0 uye: 0.
randomizer shandisa: 1 uye: 0.
randomizer shandisa: 1 uye: 1.
randomizer shandisa: 0 uye: 1.
randomizer shandisa: -1 uye: 0.
randomizer shandisa: -1 uye: -1.
randomizer shandisa: 0 uye: -1.
randomizer shandisa: 100 uye: 200.
