Nhamba kana-zvasvika: ['factorial'] ita: {
	>> total := 1.
	{ :index total wanza-ne: (pachako - index). } × pachako. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Chirongwa kutonga-ndangariro: 0.

{
2 exponent factorial.
Zvabuda nyora: (11 chasara: 3), mutsara-mutsva.
Zvabuda nyora: (3.4 swededza-nhamba), mutsara-mutsva.
Zvabuda nyora: (7.1 kwidza-nhamba), mutsara-mutsva.
Zvabuda nyora: (7.9 dzikisa-nhamba), mutsara-mutsva.
}
tanga.

Chirongwa chenesa.

usedMemory1 := (Chirongwa ndangariro ? 0).

{
2 exponent factorial.
Zvabuda nyora: (11 chasara: 3), mutsara-mutsva.
Zvabuda nyora: (3.4 swededza-nhamba), mutsara-mutsva.
Zvabuda nyora: (7.1 kwidza-nhamba), mutsara-mutsva.
Zvabuda nyora: (7.9 dzikisa-nhamba), mutsara-mutsva.
}
tanga.

Chirongwa chenesa.
usedMemory2 := (Chirongwa ndangariro ? 0).


{
2 exponent factorial.
Zvabuda nyora: (11 chasara: 3), mutsara-mutsva.
Zvabuda nyora: (3.4 swededza-nhamba), mutsara-mutsva.
Zvabuda nyora: (7.1 kwidza-nhamba), mutsara-mutsva.
Zvabuda nyora: (7.9 dzikisa-nhamba), mutsara-mutsva.
} tanga.

Chirongwa chenesa.
usedMemory3 := (Chirongwa ndangariro ? 0).



( usedMemory1 = usedMemory2 uye: usedMemory1 = usedMemory3, uye: usedMemory2 = usedMemory3 ) chokwadi: {
	Zvabuda nyora: ['No memory leaks here'].
}, nhema: {
	Zvabuda nyora: ['Leaking memory...'].
}.
