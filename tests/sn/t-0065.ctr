Nhamba kana-zvasvika: ['factorial'] ita: {
	>> total := 1.
	{ :index total wanza-ne: (pachako - (index)). } × pachako. <- total.
}.
>> Printer := Chinhu nyowani.
Printer kana-zvasvika: ['print:and:'] ita: { :x :y
	Zvabuda nyora: ['a='] + x + [', b='] + y, mutsara-mutsva.
}.
>> a := 4.5. >> b := a dzikisa-nhamba.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a kwidza-nhamba.
Printer print: a and: b.
a := 4.5. b := a dzikisa-nhamba.
Printer print: a and: b.
a := 4.5. b := a swededza-nhamba.
Printer print: a and: b.
a := 4.2. b := a swededza-nhamba.
Printer print: a and: b.

Zvabuda nyora: (9 chasara: 5), mutsara-mutsva.
Zvabuda nyora: -666 kukosha-kwakazara, mutsara-mutsva.
Zvabuda nyora: 49 mudzi-wesikweya, mutsara-mutsva.
Zvabuda nyora: (2 simba-renhamba: 3), mutsara-mutsva.
>> l := (Rondedzero ← 9 ; 6).
Zvabuda nyora: l diki-diki.

