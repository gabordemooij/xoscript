Server init.
>> blob := Blob nyowani: 4.
blob bytes: ( 
	Rondedzero nyowani ; 0 ; 1 ; 2 ; 3
).
>> b64 := blob base64-isa-kodhi.
Zvabuda nyora: b64, mutsara-mutsva.
blob sunungura.
>> blob2 := Blob base64-bvisa-kodhi: b64.
Zvabuda nyora: ( blob2 kubva: 0 kureba: 4 ), mutsara-mutsva.
blob2 sunungura.
