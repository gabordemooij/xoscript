Zvabuda nyora: ['Test object'], mutsara-mutsva.
>> a := Chinhu nyowani. 

a kana-zvasvika: ['item:'] ita: { :hexhelper
	zvako hexhelper := hexhelper. 
}.

a kana-zvasvika: ['item'] ita: { <- zvako hexhelper.
}.

a item: Hx nyowani.

>> old-hexhelper-address := a item muenzaniso-wekutanga kero-yendangariro.
a save-as: ['/tmp/a.bin'].
Zvabuda nyora: ['========== RELOADING SNAP:'], mutsara-mutsva.

>> b := Chinhu load-from: ['/tmp/a.bin'].

(b item muenzaniso-wekutanga kero-yendangariro = old-hexhelper-address) chokwadi: {
	Zvabuda nyora: ['Object link re-attached.'], mutsara-mutsva.
}.
