
Rondedzero kana-zvasvika: ['product'] ita: {
	>> total := 1.
	pachako chimwe-nechimwe: { :index :element
		total wanza-ne: element.
	}. <- total.
}.

>> a := Rondedzero ← 1 ; 2 ; 3.
Zvabuda nyora: a product, mutsara-mutsva.
Zvabuda nyora: (Rondedzero ← 2 ; 4 ; 8) product, mutsara-mutsva. 
Zvabuda nyora: (Rondedzero ← -2 ; 10) product, mutsara-mutsva. 
Zvabuda nyora: (Rondedzero ← 0.5 ; -2) product, mutsara-mutsva. 
