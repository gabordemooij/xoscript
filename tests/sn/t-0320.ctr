


>> CoffeeMachine := Chinhu nyowani.
CoffeeMachine kana-zvasvika: ['order:'] ita: { :id
	>> coffee := ['Americano'].
	( id = 1 ) chokwadi: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) chokwadi: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) chokwadi: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Chinhu nyowani.
SimpleCoffeeMachine kana-zvasvika: ['order'] ita: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Zvabuda nyora: redCup, mutsara-mutsva.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Zvabuda nyora: greenCup, mutsara-mutsva.
>> yellowCup := CoffeeMachine order: 1.
Zvabuda nyora: yellowCup, mutsara-mutsva.
>> blueCup := CoffeeMachine order: 0.
Zvabuda nyora: blueCup, mutsara-mutsva.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Zvabuda nyora: blackCup, mutsara-mutsva.
blackCup wedzera-kumagumo: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Zvabuda nyora: orangeCup, mutsara-mutsva.
