# test number -> string -> number
{

	>> x := संख्या बीच: 0 और: 1000000.
	>> d := संख्या बीच: 1 और: 7.
	>> e := 10 घात: d.

	x भाग: e.
	>> y := x पाठ-में संख्या-में.

	(x = y) असत्य-हो-तो: {
		निर्गम लिखो: x, नई-पंक्ति.
		निर्गम लिखो: y, नई-पंक्ति.
		प्रोग्राम समाप्त.
	}.

} * 1000.
निर्गम लिखो: ['OK'], नई-पंक्ति.