

>> g  := Server नया.
>> v  := तिजोरी नया.
>> ठीक := 0.

>> रहस्य-सूची := सूची नया ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> पासवर्ड-सूची := रहस्य-सूची प्रतिलिपि.
पासवर्ड-सूची प्रत्येक: { :i :p
	रहस्य-सूची प्रत्येक: { :n :s
		{
			>> कूटबद्ध := v एन्क्रिप्ट: s कुंजी: p.
			>> विकूटित := v डिक्रिप्ट: कूटबद्ध कुंजी: p.
			(विकूटित = s) सत्य-हो-तो: {
				ठीक जमा: 1.
			}, अन्यथा: {
				निर्गम लिखो: ['एन्क्रिप्ट/डिक्रिप्ट विफल: '], नई-पंक्ति.
				निर्गम लिखो: s, नई-पंक्ति.
				निर्गम लिखो: ['एन्क्रिप्टेड: '] + कूटबद्ध, नई-पंक्ति.
				निर्गम लिखो: ['डिक्रिप्टेड: '] + कूटबद्ध, नई-पंक्ति.
				प्रोग्राम समाप्त.
			}.
		} पकड़ो: { :गड़बड़
			(s = [''] या: p = ['']) सत्य-हो-तो: {
				ठीक जमा: 1.
			}, अन्यथा: {
				निर्गम लिखो: गड़बड़, नई-पंक्ति.
				प्रोग्राम समाप्त.
			}.
		}, चलाओ.
	}.
}.

निर्गम लिखो: ( ठीक + [' वॉल्ट एन्क्रिप्शन परखे गए.'] ), नई-पंक्ति.