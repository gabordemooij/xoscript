
>> आयत-वर्ग := वस्तु नया.

आयत-वर्ग जब: ['क्षेत्रफल'] करो: {
	<- अपना लंबाई * अपना चौड़ाई.
}.

आयत-वर्ग जब: ['length:'] करो: { :लंबाई
	अपना लंबाई := लंबाई.
}.

आयत-वर्ग जब: ['width:'] करो: { :चौड़ाई
	अपना चौड़ाई := चौड़ाई.
}.

आयत-वर्ग जब: ['नया'] करो: {
	# इससे अनंत लूप नहीं बनेगा
	>> आयत := स्वयं नया.
	आयत length: 0, width: 0.
	<- आयत.
}.

>> a := आयत-वर्ग नया.
निर्गम लिखो: a क्षेत्रफल, नई-पंक्ति. #0

>> b := आयत-वर्ग नया length: 2, width: 3.
निर्गम लिखो: b क्षेत्रफल, नई-पंक्ति. #6

