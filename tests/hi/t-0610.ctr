
>> Rectangle := वस्तु नया.

Rectangle जब: ['area'] करो: { <- अपना लंबाई * अपना width.
}.

Rectangle जब: ['length:'] करो: { :लंबाई
	अपना लंबाई := लंबाई.
}.

Rectangle जब: ['width:'] करो: { :width
	अपना width := width.
}.

Rectangle जब: ['नया'] करो: {
	# this will not result into an infinite loop
	>> rectangle := स्वयं नया.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle नया.
निर्गम लिखो: a area, नई-पंक्ति. #0

>> b := Rectangle नया length: 2, width: 3.
निर्गम लिखो: b area, नई-पंक्ति. #6

