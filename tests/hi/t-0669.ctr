# पासवर्ड हैशिंग
Server init.

# उपयोगकर्ता पासवर्ड सेट करता है
>> पासव := ['pass123'].

# आप इसे ऐसे सहेजते हैं
>> हैश-मान := तिजोरी 
	पासवर्ड-हैश: पासव.

# फिर, उपयोगकर्ता लॉग इन करता है
# प्रयास 1
>> a1 := ['abcd123'].
# प्रयास 2
>> a2 := ['pass123'].

# सत्यापन
>> a := तिजोरी 
	पासवर्ड-हैश: हैश-मान सत्यापन: a1.
	# विफल 
>> b := तिजोरी
	पासवर्ड-हैश: हैश-मान सत्यापन: a2.
	# ठीक!

निर्गम लिखो: a, नई-पंक्ति.
निर्गम लिखो: b, नई-पंक्ति.

