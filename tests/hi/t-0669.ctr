# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := तिजोरी 
	पासवर्ड-हैश: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := तिजोरी 
	पासवर्ड-हैश: hash सत्यापन: a1.
	# fail 
>> b := तिजोरी
	पासवर्ड-हैश: hash सत्यापन: a2.
	# ok!

निर्गम लिखो: a, नई-पंक्ति.
निर्गम लिखो: b, नई-पंक्ति.

