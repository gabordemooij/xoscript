>> सुड़क := वस्तु नया.
सुड़क जब: ['नया'] करो: {
	अपना str := [''].
}.
सुड़क सीखो: ['nieuw'] अर्थ: ['नया'].
सुड़क जब: ['उत्तर:'] करो: { :blah
		(अपना str ≠ ['']) सत्य-हो-तो: {
			अपना str अंत-में-जोड़ो: [' '].
		}.
		अपना str अंत-में-जोड़ो: blah.
}.
सुड़क जब: ['उत्तर:और:'] करो: { :blah :blahah
		(अपना str ≠ ['']) सत्य-हो-तो: {
			अपना str अंत-में-जोड़ो: [' '].
		}.
		(blah लंबाई > 1) सत्य-हो-तो: {
			अपना str अंत-में-जोड़ो: (blah आरंभ: 0 लंबाई: (blah लंबाई - 1)).
		}, अन्यथा: {
			अपना str अंत-में-जोड़ो: blah.
		}.
		अपना str अंत-में-जोड़ो: [' '].
		अपना str अंत-में-जोड़ो: blahah.
}.
सुड़क जब: ['प्राप्त-करो'] करो: {
	>> बफ़र := अपना str.
	अपना str := ['']. <- बफ़र.
}.


>> खोज-पैरामीटर := सुड़क नया
	select: ['*'],
	from
		उपयोगकर्ता 
	where 
		user_id=: 1.

निर्गम लिखो: खोज-पैरामीटर प्राप्त-करो, नई-पंक्ति.
