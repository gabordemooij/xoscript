# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := तिजोरी कुंजी-बनाओ.

# private (secret) key
>> sk := keys पहला.

# public key
>> pk := keys अंतिम.

# sign a message
>> sig := तिजोरी हस्ताक्षर: ['abc'] कुंजी-से: sk.

# check message (ok)
निर्गम लिखो: ( 
	तिजोरी
		जाँचो: ['abc'] 
		हस्ताक्षर: sig 
		कुंजी-से: pk 
), नई-पंक्ति.

# check message (fail)
निर्गम लिखो: ( 
	तिजोरी 
		जाँचो: ['abd'] 
		हस्ताक्षर: sig 
		कुंजी-से: pk 
), नई-पंक्ति.