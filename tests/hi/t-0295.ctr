
>> dictionary := (
	शब्दकोश नया
		रखो: ['b'] कुंजी: ['a'],
		रखो: ['a'] कुंजी: ['b'],
		रखो: ['z'] कुंजी: ['x'],
		रखो: ['hello'] कुंजी: ['hallo'],
		रखो: ['human'] कुंजी: ['human']
).

>> comparisons := सूची नया.
dictionary प्रत्येक: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a तुलना: b)
	).
}.

comparisons क्रमित: { :a :b <- ( a तुलना: b ). }.
निर्गम लिखो: ( comparisons जोड़ो: ['↵'] ), नई-पंक्ति.
comparisons जोड़ो: ['↵'].
