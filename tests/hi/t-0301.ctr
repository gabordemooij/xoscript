


>> वाइन := वस्तु नया.


वाइन जब: ['पाठ-बनाओ'] करो: { <- ['merlot'].
}.

वाइन जब: ['naarTekst'] करो: { <- ['merlot'].
}.


वाइन जब: ['='] करो: { :other wine <- ( स्वयं पाठ-बनाओ = other wine ).
}.

वाइन जब: ['=='] करो: { :other wine <- ( स्वयं पाठ-बनाओ = other wine ).
}.



वाइन
	स्थिति: ['cabernet'] करो: { निर्गम लिखो: ['यह Cabernet है!']. },
	स्थिति: ['syrah']    करो: { निर्गम लिखो: ['यह Syrah है!'].    },
	स्थिति: ['merlot']   करो: { निर्गम लिखो: ['यह Merlot है!'].   },
	स्थिति: ['malbec']   करो: { निर्गम लिखो: ['यह Malbec है!'].   }.

निर्गम नई-पंक्ति.
