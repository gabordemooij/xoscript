


>> wine := वस्तु नया.


wine जब: ['toString'] करो: { <- ['merlot'].
}.

wine जब: ['naarTekst'] करो: { <- ['merlot'].
}.


wine जब: ['='] करो: { :other wine <- ( स्वयं toString = other wine ).
}.

wine जब: ['=='] करो: { :other wine <- ( स्वयं toString = other wine ).
}.



wine
	स्थिति: ['cabernet'] करो: { निर्गम लिखो: ['it's a Cabernet!']. },
	स्थिति: ['syrah']    करो: { निर्गम लिखो: ['it's a Syrah!'].    },
	स्थिति: ['merlot']   करो: { निर्गम लिखो: ['it's a Merlot!'].   },
	स्थिति: ['malbec']   करो: { निर्गम लिखो: ['it's a Malbec!'].   }.

निर्गम नई-पंक्ति.
