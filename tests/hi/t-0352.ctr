संख्या जब: ['roman'] करो: {
	>> संख्या-में := स्वयं प्रतिलिपि.
	>> roman := [''].
	{
		{
			(संख्या-में ≥ 1000) सत्य-हो-तो: {
				roman अंत-में-जोड़ो: ['Ⅿ'].
				संख्या-में घटाओ: 1000.
			}, तोड़ो.
		
			(संख्या-में ≥ 500) सत्य-हो-तो: {
				roman अंत-में-जोड़ो: ['Ⅾ'].
				संख्या-में घटाओ: 500.
			}, तोड़ो.
		
			(संख्या-में ≥ 100) सत्य-हो-तो: {
				roman अंत-में-जोड़ो: ['Ⅽ'].
				संख्या-में घटाओ: 100.
			}, तोड़ो.
		
			(संख्या-में ≥ 50) सत्य-हो-तो: {
				roman अंत-में-जोड़ो: ['Ⅼ'].
				संख्या-में घटाओ: 50.
			}, तोड़ो.
		
			(संख्या-में ≥ 50) सत्य-हो-तो: {
				roman अंत-में-जोड़ो: ['Ⅼ'].
				संख्या-में घटाओ: 50.
			}, तोड़ो.
		
			(संख्या-में ≥ 10) सत्य-हो-तो: {
				roman अंत-में-जोड़ो: ['Ⅹ'].
				संख्या-में घटाओ: 10.
			}, तोड़ो.
			
			(संख्या-में ≥ 9) सत्य-हो-तो: {
				roman अंत-में-जोड़ो: ['Ⅸ'].
				संख्या-में घटाओ: 9.
			}, तोड़ो.
			
			(संख्या-में ≥ 5) सत्य-हो-तो: {
				roman अंत-में-जोड़ो: ['Ⅴ'].
				संख्या-में घटाओ: 5.
			}, तोड़ो.
			
			(संख्या-में ≥ 4) सत्य-हो-तो: {
				roman अंत-में-जोड़ो: ['Ⅳ'].
				संख्या-में घटाओ: 4.
			}, तोड़ो.
			
			(संख्या-में ≥ 1) सत्य-हो-तो: {
				roman अंत-में-जोड़ो: ['Ⅰ'].
				संख्या-में घटाओ: 1.
			}, तोड़ो.
		} प्रक्रिया.
	} जब-तक: { <- संख्या-में > 0. }. <- roman.
}.

निर्गम लिखो: 1 roman, नई-पंक्ति.
