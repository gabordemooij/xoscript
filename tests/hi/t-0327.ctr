

सूची जब: ['fixture:'] करो: { :f
	अपना fixture := f.
}.

सूची जब: ['गिनती'] करो: { <- अपना fixture.
}.

सूची जब: ['aantal'] करो: { <- अपना fixture.
}.


>> x := शून्य.
{

	x := ['hello'] 
	बदलो:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] वर्ण: 2)
			)
		)
	से: (
		(['...hal'] + ['lo']) 
			बड़े-अक्षर 
			lowecase 
			बड़े-अक्षर 
			छोड़ो: -1 + ( 
