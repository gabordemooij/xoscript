#Linux
>> सुड़क := वस्तु नया.

सुड़क जब: ['नया'] करो: {
	अपना str := [''].
}.

सुड़क जब: ['nieuw'] करो: {
	अपना str := [''].
}.

सुड़क जब: ['उत्तर:'] करो: { :blah
		अपना str अंत-में-जोड़ो: blah.
}.

सुड़क जब: ['उत्तर:और:'] करो: { :blah :blahah
		अपना str अंत-में-जोड़ो: (blah आरंभ: 0 लंबाई: (blah लंबाई - 1)).
		अपना str अंत-में-जोड़ो: [' '].
		अपना str अंत-में-जोड़ो: blahah.
}.

सुड़क जब: ['प्राप्त-करो'] करो: {
	>> बफ़र := अपना str.
	अपना str := ['']. <- बफ़र.
}.


निर्गम लिखो: (प्रोग्राम सिस्टम: (सुड़क नया echo: ['मैं fluid API से कंसोल पर लिख सकता हूँ!'], प्राप्त-करो)).


{ फ़ाइल नया: ['/tmp/from.txt'], मिटाओ. } पकड़ो: { ['खाली']. }, चलाओ.
{ फ़ाइल नया: ['/tmp/to.txt'], मिटाओ. } पकड़ो: { ['खाली']. }, चलाओ.


फ़ाइल नया: ['/tmp/to.txt'], मौजूद असत्य-हो-तो: {
	निर्गम लिखो: ['Confirmed. Target file does not exist.\
'].
}.
फ़ाइल नया: ['/tmp/from.txt'], मौजूद असत्य-हो-तो: {
	निर्गम लिखो: ['Confirmed. Source file does not exist.\
'].
}.



प्रोग्राम सिस्टम: (सुड़क नया touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], प्राप्त-करो).



प्रोग्राम सिस्टम: (सुड़क नया cp: ['/tmp/from.txt /tmp/to.txt'], प्राप्त-करो).

फ़ाइल नया: ['/tmp/to.txt'], मौजूद सत्य-हो-तो: {
	निर्गम लिखो: ['Confirmed. Target file has been created by shell.\
'].
}.


निर्गम लिखो: ['फ़ाइल की सामग्री है:'] + (फ़ाइल नया: ['/tmp/to.txt'], पढ़ो), नई-पंक्ति.
