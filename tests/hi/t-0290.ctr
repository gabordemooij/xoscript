# test list operations


>> cakes := सूची ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes बदलो: 1 लंबाई: 2 से: ( सूची ← ['cinnamon'] ; ['pineapple'] ).
निर्गम लिखो: (buy जोड़ो: [',']), नई-पंक्ति.


>> buy := cakes बदलो: 1 लंबाई: 12 से: ( सूची ← ['cinnamon'] ; ['pineapple'] ).
निर्गम लिखो: (buy जोड़ो: [',']), नई-पंक्ति.


>> buy := cakes बदलो: 2 लंबाई: 10 से: ( सूची नया ).
निर्गम लिखो: (buy जोड़ो: [',']), नई-पंक्ति.


>> buy := cakes बदलो: 0 लंबाई: 1 से: ( सूची नया ).
निर्गम लिखो: (buy जोड़ो: [',']), नई-पंक्ति.


>> buy := cakes बदलो: ['0'] लंबाई: ['1'] से: ['x'].
निर्गम लिखो: (buy जोड़ो: [',']), नई-पंक्ति.
