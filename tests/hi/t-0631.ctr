#ffi test


Server init.

प्रोग्राम मेमोरी-प्रबंधन: 4.

# for this test you need set a path to libc (puts)
>> libname := प्रोग्राम सेटिंग: ['FFITESTLIB'].



Server लिंक: (
 सूची नया ;
 libname ;
 ['puts'] ;
 ( सूची नया ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s मुक्त.

# test with struct

>> a := Blob नया: 8.
a bytes: (
	सूची <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (सूची <<: ['int'], ; ['int']).

Server लिंक: (
	सूची <<: ['@structtest'], ;
	['@structtest'] ;
	(सूची <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
निर्गम लिखो: ['Sum test:'] + (ffitest ffisum: a), नई-पंक्ति.

struct struct-मुक्त.
struct मुक्त.
a मुक्त.
