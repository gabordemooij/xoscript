>> अभिवादक-वर्ग := वस्तु नया.
अभिवादक-वर्ग जब: ['बनाओ'] करो: {
	>> अभि := वस्तु नया.
	अभि जब: ['setName:'] करो: { :कोई-नाम
		अपना नाम := कोई-नाम.
	}.
	अभि जब: ['अभिवादन-करो'] करो: {
		निर्गम लिखो: अपना नाम.
	}. <- अभि.
}.
>> a := अभिवादक-वर्ग बनाओ.
>> b := अभिवादक-वर्ग बनाओ.
a setName: ['पहला'].
b setName: ['दूजा'].
a अभिवादन-करो.
b अभिवादन-करो.
>> c := a नया.
c setName: ['तीसरा'].
c अभिवादन-करो.
>> d := a नया.
d setName: ['चौथा'].
d अभिवादन-करो.
c अभिवादन-करो.
