>> Greeter := वस्तु नया.
Greeter जब: ['make'] करो: {
	>> gr := वस्तु नया.
	gr जब: ['setName:'] करो: { :aname
		अपना नाम := aname.
	}.
	gr जब: ['greet'] करो: {
		निर्गम लिखो: अपना नाम.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a नया.
c setName: ['THREE'].
c greet.
>> d := a नया.
d setName: ['FOUR'].
d greet.
c greet.
