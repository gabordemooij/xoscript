Server init.

>> DB := Maria-DB नया होस्ट: ['localhost'],
	उपयोगकर्ता-नाम: ['xo'],
	पासवर्ड: ['pass123'],
	डेटाबेस-नाम: ['xobase'],
	जुड़ो.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB क्वेरी: SQL.

# now you don't have to set DB
query2 लाओ: { :row
	निर्गम लिखो: row world, नई-पंक्ति.
}.
