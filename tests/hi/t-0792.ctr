Server init.

>> DB := Maria-DB नया होस्ट: ['localhost'],
	उपयोगकर्ता-नाम: ['xo'],
	पासवर्ड: ['pass123'],
	डेटाबेस-नाम: ['xobase'],
	जुड़ो.
	
>> SQL := ['SELECT "hello" AS "world" '].

# एक तेज़ तरीका, DB से क्वेरी लें:
>> क्वेरी2 := DB क्वेरी: SQL.

# अब आपको DB सेट नहीं करना पड़ेगा
क्वेरी2 लाओ: { :कतार
	निर्गम लिखो: कतार world, नई-पंक्ति.
}.
