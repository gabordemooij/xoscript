


>> प्रयुक्त-मेमोरी1 := 0.
>> प्रयुक्त-मेमोरी2 := 0.
>> प्रयुक्त-मेमोरी3 := 0.
>> प्रयुक्त-मेमोरी4 := 0.

प्रोग्राम मेमोरी-प्रबंधन: 0.
>> रंगपट्टी := शून्य.
>> रंगसूची := शून्य.

{
रंगपट्टी := शब्दकोश नया.
रंगपट्टी 
	रखो: ['#F00'] कुंजी: ['लाल'],
	रखो: ['#0F0'] कुंजी: ['हरा'],
	रखो: ['#00F'] कुंजी: ['नीला'].
निर्गम लिखो: ['पैलेट में RGB कोड की संख्या: '] + ( रंगपट्टी गिनती ), नई-पंक्ति.
निर्गम लिखो: ['हरे का RGB कोड है: '] + ( रंगपट्टी ? ['हरा'] ), नई-पंक्ति.
रंगसूची := [''].
( रंगपट्टी प्रत्येक: { :नाम :कोड
		रंगसूची := रंगसूची + ( नाम + [':'] + कोड ).
} ).
निर्गम लिखो: ['पैलेट के सभी रंग: '] + रंगसूची, नई-पंक्ति.
} चलाओ.
प्रोग्राम सफ़ाई.
प्रयुक्त-मेमोरी1 := (प्रोग्राम मेमोरी ? 0).

{
रंगपट्टी := शब्दकोश नया.
रंगपट्टी 
	रखो: ['#F00'] कुंजी: ['लाल'],
