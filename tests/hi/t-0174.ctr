रंगपट्टी := शब्दकोश नया.
रंगपट्टी 
	रखो: ['#F00'] कुंजी: ['लाल'],
	रखो: ['#0F0'] कुंजी: ['हरा'],
	रखो: ['#00F'] कुंजी: ['नीला'].
