>> usedMemory3 := 0.
>> usedMemory4 := 0.

प्रोग्राम मेमोरी-प्रबंधन: 0.
>> palette := शून्य.
>> colors := शून्य.

{
palette := शब्दकोश नया.
palette 
	रखो: ['#F00'] कुंजी: ['red'],
	रखो: ['#0F0'] कुंजी: ['green'],
	रखो: ['#00F'] कुंजी: ['blue'].
निर्गम लिखो: ['number of RGB codes in palette: '] + ( palette गिनती ), नई-पंक्ति.
निर्गम लिखो: ['RGB code of green is: '] + ( palette ? ['green'] ), नई-पंक्ति.
colors := [''].
( palette प्रत्येक: { :नाम :कोड
		colors := colors + ( नाम + [':'] + कोड ).
} ).
निर्गम लिखो: ['All colors in palette: '] + colors, नई-पंक्ति.
} चलाओ.
प्रोग्राम सफ़ाई.
usedMemory1 := (प्रोग्राम मेमोरी ? 0).

