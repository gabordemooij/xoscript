# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := Maria-DB नया होस्ट: ['localhost'],
	उपयोगकर्ता-नाम: ['xo'],
	पासवर्ड: ['pass123'],
	डेटाबेस-नाम: ['xobase'],
	जुड़ो.

>> खोज-पैरामीटर := db क्वेरी: ['SELECT ? AS a, ? AS b, ? AS c'].
खोज-पैरामीटर पैरामीटर: (सूची नया ; ['1']).
{ खोज-पैरामीटर लाओ: { :row निर्गम लिखो: row, नई-पंक्ति. }. } पकड़ो: { :e निर्गम लिखो: e, नई-पंक्ति. }, चलाओ.

>> खोज-पैरामीटर := db क्वेरी: ['SELECT ? AS a'].
{ खोज-पैरामीटर लाओ: { :row निर्गम लिखो: row, नई-पंक्ति. }. } पकड़ो: { :e निर्गम लिखो: e, नई-पंक्ति. }, चलाओ.

# the right number still works, more parameters are ignored as before
>> खोज-पैरामीटर := db क्वेरी: ['SELECT ? AS a, ? AS b'].
खोज-पैरामीटर पैरामीटर: (सूची नया ; ['1'] ; ['2']).
खोज-पैरामीटर लाओ: { :row निर्गम लिखो: (row पर: ['a']), लिखो: (row पर: ['b']), नई-पंक्ति. }.
खोज-पैरामीटर पैरामीटर: (सूची नया ; ['1'] ; ['2'] ; ['3']).
खोज-पैरामीटर लाओ: { :row निर्गम लिखो: (row पर: ['a']), लिखो: (row पर: ['b']), नई-पंक्ति. }.
