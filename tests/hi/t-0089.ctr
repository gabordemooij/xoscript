>> randomizer := { :a :b
	>> न्यूनतम := ( a < b ) यह: a या-वह: b.
	>> अधिकतम := ( a > b ) यह: a या-वह: b.
	>> x := शून्य.
	{
		x := संख्या बीच: a और: b.
		((x < न्यूनतम) या: (x > अधिकतम)) सत्य-हो-तो: { 
			निर्गम लिखो: (['Invalid value!']).
			प्रोग्राम समाप्त.
		}.
	} 
	× 100. <- x.
}.
