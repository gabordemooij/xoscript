#Linux
>> clock := क्षण नया.
clock समय-क्षेत्र: ['UTC-1'].
clock वर्ष: 1981, महीना: 1, दिन: 5,
      घंटा: 13, मिनट: 15, सेकंड: 13.

निर्गम लिखो: clock, नई-पंक्ति.
clock समय-क्षेत्र: ['UTC+0'].

निर्गम लिखो: (
	(clock वर्ष सादा) + ['-'] + (clock महीना) + ['-'] + (clock दिन) + [' '] +
	(clock घंटा) + [':'] + (clock मिनट) + [':'] + (clock सेकंड) + [' '] +
	['W'] + (clock सप्ताह) + (clock समय-क्षेत्र)
), नई-पंक्ति.


clock समय-क्षेत्र: ['UTC-1'].
निर्गम लिखो: (
	(clock वर्ष सादा) + ['-'] + (clock महीना) + ['-'] + (clock दिन) + [' '] +
	(clock घंटा) + [':'] + (clock मिनट) + [':'] + (clock सेकंड) + [' '] +
	['W'] + (clock सप्ताह) + (clock समय-क्षेत्र)
), नई-पंक्ति.
