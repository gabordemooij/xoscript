

>> Matryoshka := वस्तु नया.
Matryoshka जब: ['double:'] करो: { :secret
	अपना secret := secret × 2.
}.
Matryoshka जब: ['नया:'] करो: { :secret
	>> answer := शून्य.
	>> t := (secret > 255).
	निर्गम लिखो: (secret + [' | '] + t), नई-पंक्ति.
	t सत्य-हो-तो: {
		answer := secret.
	}, अन्यथा: {
		answer := Matryoshka पुनरावर्ती नया: (स्वयं double: secret).
	}. <- answer.
}.

>> x := Matryoshka नया: 2.
