>> Slurp := वस्तु नया.
Slurp जब: ['नया'] करो: {
	अपना str := [''].
}.

Slurp जब: ['उत्तर:'] करो: { :blah
		(अपना str ≠ ['']) सत्य-हो-तो: {
			अपना str अंत-में-जोड़ो: [' '].
		}.
		अपना str अंत-में-जोड़ो: blah.
}.
Slurp जब: ['उत्तर:और:'] करो: { :blah :blahah
		(अपना str ≠ ['']) सत्य-हो-तो: {
			अपना str अंत-में-जोड़ो: [' '].
		}.
		(blah लंबाई > 1) सत्य-हो-तो: {
			अपना str अंत-में-जोड़ो: (blah आरंभ: 0 लंबाई: (blah लंबाई - 1)).
		}, अन्यथा: {
			अपना str अंत-में-जोड़ो: blah.
		}.
		अपना str अंत-में-जोड़ो: [' '].
		अपना str अंत-में-जोड़ो: blahah.
}.
Slurp जब: ['obtain'] करो: {
	>> buffer := अपना str.
	अपना str := ['']. <- buffer.
}.

>> s := Slurp नया.
s hello: ['world'].
निर्गम लिखो: ( s obtain ), नई-पंक्ति.
