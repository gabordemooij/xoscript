# utf16le/be या utf32le/be से utf8 में डिकोड करें
Server init.
>> utf16 := Blob नया: 8, bytes: (
	सूची नया ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

निर्गम लिखो: ( utf16 डिकोड: ['utf16le'] ), नई-पंक्ति.

utf16 मुक्त.
>> utf32 := Blob नया: 13, bytes: (
	सूची नया ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

निर्गम लिखो: ( utf32 डिकोड: ['utf32be'] ), नई-पंक्ति.
utf32 मुक्त.