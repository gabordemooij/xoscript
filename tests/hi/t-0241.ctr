

पाठ जब: ['मूल्यांकन-करो'] करो: {
	>> कोड := फ़ाइल नया: ['/tmp/eval.ctr'].
	कोड लिखो: (स्वयं पाठ-में + ['.']).
	प्रोग्राम उपयोग: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := सूची ← (['उद्धरण '] + Q + [' बुरे हैं?']) ; 1.
>> x := q पाठ-में.
निर्गम लिखो: x, नई-पंक्ति.
>> y := शून्य.
(['y := '] + x ) मूल्यांकन-करो.
निर्गम लिखो: y ? 0, नई-पंक्ति.

q := शब्दकोश रखो: ['\[''] कुंजी: ['\['quote\']'].
x := q पाठ-में.
निर्गम लिखो: x, नई-पंक्ति.
y := शून्य.
(['y := '] + x ) मूल्यांकन-करो.

>> q := (शब्दकोश नया) रखो:['\[''] कुंजी:['\['quote\[''].
निर्गम लिखो: y ? ['\['quote\']'], नई-पंक्ति.
