# utf8 सैनिटाइज़र का परीक्षण
Server init.

>> utf8-मामले := शब्दकोश नया
	# केवल ASCII
	रखो: ( सूची नया ; 65 ; 65 ; 65 ; 65 ; 0 ) कुंजी: ['AAAA'],
	# मान्य 2 बाइट अनुक्रम
	रखो: ( सूची नया ; 194 ; 162 ; 0 ) कुंजी: ['¢'],
	# मान्य 3-बाइट UTF-8
    रखो: ( सूची नया ; 226 ; 130 ; 172 ; 0 ) कुंजी: ['€'],
	# मान्य 4-बाइट UTF-8
    रखो: ( सूची नया ; 240 ; 144 ; 141 ; 136 ; 0 ) कुंजी: ['𐍈'],
	# अनुक्रम E2 28 AC में अमान्य continuation बाइट -> 3b अनुक्रम की शुरुआत + 28 ग़लत cnt + AC cnt बाइट, पर एक ही त्रुटि का हिस्सा
    रखो: ( सूची नया ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) कुंजी: ['A?A'],
	# ASCII 'A' का overlong एन्कोडिंग (? बनना चाहिए),
    रखो: ( सूची नया ; 65 ; 193 ; 129 ; 0 ) कुंजी: ['A?'],
	# अमान्य पहला बाइट (0xFF)
    रखो: ( सूची नया ; 255 ; 0 ) कुंजी: ['?'],
	# अंत में अधूरा बहु-बाइट अनुक्रम
    रखो: ( सूची नया ; 66 ; 226 ; 0 ) कुंजी: ['B?'],
    # खाली पाठ
    #put: ( List new ) at: [''],
	# कई मिश्रित अनुक्रम
    रखो: ( सूची नया ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) कुंजी: ['A€?𐍈B'].
	 
utf8-मामले प्रत्येक: { :key :value
	>> blob := Blob नया: value गिनती, bytes: value.
	>> str := blob पाठ-में.
	(str = key) सत्य-हो-तो: {
		निर्गम लिखो: ['OK'], नई-पंक्ति.
	}, अन्यथा: {
		निर्गम लिखो: ['UTF8 सैनिटाइज़र विफल: '] + key + [' मिला: '] + str, नई-पंक्ति.
	}.
	blob मुक्त.
}.
