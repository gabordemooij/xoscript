>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := पैटर्न नया: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern मिलान: subject करो: { :m :x
	निर्गम लिखो: m, नई-पंक्ति.
	निर्गम लिखो: x, नई-पंक्ति. <- ['XXX'].
}.
निर्गम लिखो: result, नई-पंक्ति.