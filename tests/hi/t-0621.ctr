>> वाक्यांश-सूची := सूची नया
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> संदेश := ['Phrase: ~decoded base64: ~encoded'].
	
वाक्यांश-सूची प्रत्येक: { :_ :वाक्यांश 
	>> e := Server base64-एनकोड: वाक्यांश.
	>> d := Server base64-डिकोड: e.
	निर्गम लिखो: (
		संदेश प्रतिलिपि ~encoded: e, ~decoded: d
	), नई-पंक्ति.
}.
