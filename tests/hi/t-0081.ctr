>> map1 := शब्दकोश नया.
>> key1 := सूची नया.
>> key2 := सूची नया.

map1
	रखो: ['hello'] कुंजी: key1,
	रखो: ['world'] कुंजी: key2.


निर्गम
	लिखो: ['Map #1 contains: '] + (map1 पर: key1),
	लिखो: [' and '] + (map1 पर: key2), नई-पंक्ति.

>> KeyeableArray := सूची नया.
KeyeableArray जब: ['toString'] करो: { <- (स्वयं गिनती) toString.
}.

>> map2 := शब्दकोश नया.
key1 := KeyeableArray नया.
key2 := KeyeableArray नया.

key1 अंत-में-जोड़ो: 1.

map2
	रखो: ['hello'] कुंजी: key1,
	रखो: ['world'] कुंजी: key2.

निर्गम
	लिखो: ['Map #2 contains: '] + (map2 पर: key1),
	लिखो: [' and '] + (map2 पर: key2), नई-पंक्ति.
