>> numbers := ['1,2,3'] विभाजित: [','].
निर्गम लिखो: ['I got: '] + numbers गिनती + [' numbers.'],नई-पंक्ति.
{ :i निर्गम लिखो: ['number #'] + i + [':'] + (numbers स्थान: i), नई-पंक्ति.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages विभाजित: [' Or '].
निर्गम लिखो: ['We serve'], नई-पंक्ति.
{ :i निर्गम लिखो: ['->'] + (beverages स्थान: i), नई-पंक्ति. } × (beverages गिनती).
निर्गम लिखो: (beverages जोड़ो: [',']), नई-पंक्ति.
निर्गम लिखो: (numbers जोड़ो: ['||']).
