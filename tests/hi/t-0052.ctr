>> items := शब्दकोश नया.
items रखो: ['green'] कुंजी: ['color-1'].
items रखो: ['orange'] कुंजी: ['color-2'].
items रखो: ['red'] कुंजी: ['color-3'].
>> i := 0.
>> s := [''].
items प्रत्येक: { :key :color
	निर्गम लिखो: ['color #'] + i + [' is: '] + color + [' '].
	i जमा: 1.
}.
निर्गम लिखो: i + [' colors!'].
