
पाठ जब: ['मूल्यांकन-करो'] करो: {
	>> कोड := फ़ाइल नया: ['/tmp/eval.ctr'].
	कोड लिखो: (स्वयं पाठ-में + ['.']).
	प्रोग्राम उपयोग: ['/tmp/eval.ctr'].
}.

>> map :=
	(शब्दकोश नया)
	रखो: ['हाय दोस्त'] कुंजी: ['two'],
	रखो: (सूची ← ['hello'] ; ['world'] ; (सूची ← 1 ; 2; 9) ; असत्य) कुंजी: ['एक'],
	रखो: ( (शब्दकोश नया) रखो: ['wrrld'] कुंजी: ['ग़लत-वर्तनी'] ) कुंजी: ['three'],
	रखो: (सूची ← ((शब्दकोश नया) रखो: ['ख़ज़ाना'] कुंजी: ['छिपा']) ; 2) कुंजी: ['चार']. 
>> str := map पाठ-में.
>> map2 := शून्य.
(['map2 := '] + str ) मूल्यांकन-करो.
निर्गम लिखो: map2 ? ['एक'] ? 0.
निर्गम लिखो: map2 ? ['एक'] ? 1.
निर्गम लिखो: map2 ? ['चार'] ? 0 ? ['छिपा'].
निर्गम लिखो: map2 ? ['एक'] ? 2 ? 2.
