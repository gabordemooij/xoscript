संख्या जब: ['क्रमगुणित'] करो: {
	>> कुल := 1.
	{ :सूचकांक कुल गुणा: (स्वयं - (सूचकांक)). } × स्वयं. <- कुल.
}.

>> a := 3 + 2 + 10 + 1 - 3.
निर्गम लिखो: a.
>> b := 2 + 3 क्रमगुणित.
निर्गम लिखो: b.
>> c := 3 क्रमगुणित + 2.
निर्गम लिखो: c.
>> d := 2 + (3 क्रमगुणित).
निर्गम लिखो: d.
निर्गम लिखो: 2 + 3 क्रमगुणित + 1.
