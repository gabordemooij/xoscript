संख्या जब: ['factorial'] करो: {
	>> total := 1.
	{ :index total गुणा: (स्वयं - (index)). } × स्वयं. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
निर्गम लिखो: a.
>> b := 2 + 3 factorial.
निर्गम लिखो: b.
>> c := 3 factorial + 2.
निर्गम लिखो: c.
>> d := 2 + (3 factorial).
निर्गम लिखो: d.
निर्गम लिखो: 2 + 3 factorial + 1.
