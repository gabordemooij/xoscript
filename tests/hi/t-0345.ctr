# catch-all विधियों का परीक्षण
>> x13 := वस्तु नया.
x13 जब: ['a'] करो: { :a निर्गम लिखो: 0, नई-पंक्ति. }.
x13 जब: ['a:'] करो: { :a निर्गम लिखो: a, नई-पंक्ति. <- 5. }.
x13 जब: ['a:b:'] करो: { :a :b निर्गम लिखो: (a + b), नई-पंक्ति. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
