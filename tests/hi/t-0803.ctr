Server init.

>> conn1 := Maria-DB नया होस्ट: ['localhost'],
	उपयोगकर्ता-नाम: ['xo'],
	पासवर्ड: ['pass123'],
	डेटाबेस-नाम: ['xobase'],
	जुड़ो.

>> conn2 := Maria-DB नया होस्ट: ['localhost'],
	उपयोगकर्ता-नाम: ['xo'],
	पासवर्ड: ['pass123'],
	डेटाबेस-नाम: ['xobase'],
	जुड़ो.
#...
>> del := conn1 क्वेरी: ['DELETE FROM book WHERE id > 0'].
{  del निष्पादन. conn1 पुष्टि. } पकड़ो: { :e conn1 वापस-लो.  }, चलाओ.

>> insert := conn1 क्वेरी: ['INSERT INTO book (id) VALUES(null)'].
insert निष्पादन.

>> गिनती := conn1 क्वेरी: ['SELECT COUNT(*) AS num FROM book'].
गिनती लाओ: { :row निर्गम लिखो: row num, नई-पंक्ति. }.

# does not show up
# insert not committed on connection 1
>> गिनती := conn2 क्वेरी: ['SELECT COUNT(*) AS num FROM book'].
गिनती लाओ: { :row निर्गम लिखो: row num, नई-पंक्ति. }.
