प्रोग्राम मेमोरी-प्रबंधन: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } पकड़ो: {
		oops जमा: 1.
	}, चलाओ.
} × 1000.

{
	निर्गम लिखो: ['hi there!'].
	यह-कार्य त्रुटि: ['oops'].
	निर्गम लिखो: ['hi there!'].
	{ निर्गम लिखो: ['dont print this']. } चलाओ.
} पकड़ो: { :e 
	निर्गम लिखो: ['got ya!']. 
	निर्गम लिखो: e.
}, चलाओ.
