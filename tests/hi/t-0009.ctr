>> Greeter := वस्तु नया.
Greeter जब: ['make'] करो: {
	>> greeter := वस्तु नया.
	greeter जब: ['name:'] करो: { :नाम
		निर्गम लिखो: ['setting a name'].
		अपना myName := नाम.
	}.
	greeter जब: ['performGreeting'] करो: {
		निर्गम लिखो: ['Hello'].
		निर्गम लिखो: अपना myName.
	}.
	greeter जब: ['greet'] करो: {
		स्वयं performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
