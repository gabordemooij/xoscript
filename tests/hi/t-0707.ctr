# type casts / रूपांतरण / bindings का परीक्षण
प्रोग्राम मेमोरी-प्रबंधन: 4.
Server init.

>> गणक := 0.
>> डीबी := Maria-DB नया होस्ट: ['localhost'],
	उपयोगकर्ता-नाम: ['xo'], पासवर्ड: ['pass123'], डेटाबेस-नाम: ['xobase'], जुड़ो.

>> दो-अंक-प्रारूप := प्रारूप नया: ['%02d'].

# दिनांक-समय
{
	>> वर्ष     := संख्या बीच: 1995 और: 2050, पाठ-में.
	>> महीना    := दो-अंक-प्रारूप लागू-पूर्णांक: (संख्या बीच: 1 और: 12), पाठ-में.
	>> दिन      := दो-अंक-प्रारूप लागू-पूर्णांक: (संख्या बीच: 1 और: 28), पाठ-में.
	>> घंटा     := दो-अंक-प्रारूप लागू-पूर्णांक: (संख्या बीच: 1 और: 23), पाठ-में.
	>> मिनट   := दो-अंक-प्रारूप लागू-पूर्णांक: (संख्या बीच: 1 और: 59), पाठ-में.
	>> सेकंड   := दो-अंक-प्रारूप लागू-पूर्णांक: (संख्या बीच: 1 और: 59), पाठ-में.
	>> दिनांक-समय := ['YYYY-MM-DD HH:II:SS'].	
	दिनांक-समय
		YYYY: वर्ष,
		MM: महीना,
		DD: दिन,
		HH: घंटा,
		II: मिनट,
		SS: सेकंड.
	>> खोज-पैरामीटर :=
	डीबी क्वेरी: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: दिनांक-समय),
	लाओ: { :कतार
		(कतार mydatetime = दिनांक-समय) असत्य-हो-तो: {
			यह-कार्य त्रुटि: (
				['अपेक्षित: <expected> पर मिला: <observation>']
				<expected>: दिनांक-समय,
				<observation>: कतार mydatetime
			).
		}.
	
	}.
	गणक जमा: 1.
} * 100.

# दिनांक
{
	>> वर्ष     := संख्या बीच: 1995 और: 2050, पाठ-में.
	>> महीना    := दो-अंक-प्रारूप लागू-पूर्णांक: (संख्या बीच: 1 और: 12), पाठ-में.
	>> दिन      := दो-अंक-प्रारूप लागू-पूर्णांक: (संख्या बीच: 1 और: 28), पाठ-में.
	>> दिनांक     := ['YYYY-MM-DD'].
	दिनांक
		YYYY: वर्ष,
		MM: महीना,
		DD: दिन.
	>> खोज-पैरामीटर :=
	डीबी क्वेरी: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: दिनांक),
	लाओ: { :कतार
		(कतार mydate = दिनांक) असत्य-हो-तो: {
			यह-कार्य त्रुटि: (
				['अपेक्षित: <expected> पर मिला: <observation>']
				<expected>: दिनांक,
				<observation>: कतार mydate
			).
		}.
	}.
	गणक जमा: 1.
} * 100.


# समय
{
	>> घंटा     := दो-अंक-प्रारूप लागू-पूर्णांक: (संख्या बीच: 1 और: 23), पाठ-में.
	>> मिनट   := दो-अंक-प्रारूप लागू-पूर्णांक: (संख्या बीच: 1 और: 59), पाठ-में.
	>> सेकंड   := दो-अंक-प्रारूप लागू-पूर्णांक: (संख्या बीच: 1 और: 59), पाठ-में.
	>> समय := ['HH:II:SS'].
	समय
		HH: घंटा,
		II: मिनट,
		SS: सेकंड.
	>> खोज-पैरामीटर :=
	डीबी क्वेरी: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: समय),
	लाओ: { :कतार
		(कतार mytime = समय) असत्य-हो-तो: {
			यह-कार्य त्रुटि: (
				['अपेक्षित: <expected> पर मिला: <observation>']
				<expected>: दिनांक-समय,
				<observation>: कतार mytime
			).
		}.
	}.
	गणक जमा: 1.
} * 100.


# पाठ (varchar/text)
>> str1 := सूची नया भरो: 100000 मान-से: ['x'], जोड़ो: [''].
{
	>> str2 := तिजोरी टोकन: 40.
	>> खोज-पैरामीटर :=
	डीबी क्वेरी: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	लाओ: { :कतार
		(कतार str1 = str1 और: कतार str2 = str2) असत्य-हो-तो: {
			यह-कार्य त्रुटि: (
				['अपेक्षित: <expected> पर मिला: <observation>']
				<expected>: दिनांक-समय,
				<observation>: कतार mytime
			).
		}.
	}.
	गणक जमा: 1.
} * 100.


# संख्याएँ
{
	>> n1  := संख्या बीच: 1 और: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 पाठ-से: ['9223372036854775807'] ) -
		( Int64 पाठ-से: ['99999'] ) +
		( Int64 पाठ-से: n1 पाठ-में )
	).
	>> खोज-पैरामीटर :=
	डीबी क्वेरी: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	लाओ: { :कतार
		(कतार n1 = n1) असत्य-हो-तो: {
			यह-कार्य त्रुटि: (
				['अपेक्षित: <expected> पर मिला: <observation>']
				<expected>: n1,
				<observation>: कतार n1
			).
		}.
		(कतार n2 = n2) असत्य-हो-तो: {
			यह-कार्य त्रुटि: (
				['अपेक्षित: <expected> पर मिला: <observation>']
				<expected>: n1,
				<observation>: कतार n2
			).
		}.
		(कतार n3 = n2 पूर्णांकन) असत्य-हो-तो: {
			यह-कार्य त्रुटि: (
				['अपेक्षित: <expected> पर मिला: <observation>']
				<expected>: n1,
				<observation>: कतार n3
			).
		}.
		(कतार big = big) असत्य-हो-तो: {
			यह-कार्य त्रुटि: (
				['अपेक्षित: <expected> पर मिला: <observation>']
				<expected>: big,
				<observation>: कतार big
			).
		}.
		
	}.
	गणक जमा: 1.
} * 100.


निर्गम लिखो: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: गणक
), नई-पंक्ति.