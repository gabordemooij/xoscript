

सूची जब: ['योग'] करो: {
	>> कुल := 0.
	स्वयं प्रत्येक: { :सूचकांक :तत्व
		कुल जमा: तत्व.
	}. <- कुल.
}.

सूची जब: ['गुणनफल'] करो: {
	>> कुल := 1.
	स्वयं प्रत्येक: { :सूचकांक :तत्व
		कुल गुणा: तत्व.
	}. <- कुल.
}.

>> प्रयुक्त-मेमोरी1 := 0.
>> प्रयुक्त-मेमोरी2 := 0.
>> प्रयुक्त-मेमोरी3 := 0.
>> प्रयुक्त-मेमोरी4 := 0.

प्रोग्राम मेमोरी-प्रबंधन: 0.

{

>> a := सूची ← ['hello'] ; ['world'] ; सत्य ; शून्य ; 666.
a := a + ( सूची ← 1 ).
निर्गम लिखो: ( ['योग: '] + ( a योग ) ), नई-पंक्ति.
निर्गम लिखो: ( ['न्यूनतम: '] + ( a न्यूनतम ) ), नई-पंक्ति.
निर्गम लिखो: ( ['अधिकतम: '] + ( a अधिकतम ) ), नई-पंक्ति.
निर्गम लिखो: ( ['तीसरा: '] + ( a ? 2 ) ), नई-पंक्ति.
निर्गम लिखो: ( ['गुणनफल: '] + ( a गुणनफल ) ), नई-पंक्ति.
a क्रमित: { :a :b <- (b - a). }.
a प्रत्येक: { :i :e निर्गम लिखो: ( i - 0 ), नई-पंक्ति. }.

} चलाओ.

प्रोग्राम सफ़ाई.
प्रयुक्त-मेमोरी1 := (प्रोग्राम मेमोरी ? 0).


{

>> a := सूची ← ['hello'] ; ['world'] ; सत्य ; शून्य ; 666.
a := a + ( सूची ← 1 ).
निर्गम लिखो: ( ['योग: '] + ( a योग ) ), नई-पंक्ति.
निर्गम लिखो: ( ['न्यूनतम: '] + ( a न्यूनतम ) ), नई-पंक्ति.
निर्गम लिखो: ( ['अधिकतम: '] + ( a अधिकतम ) ), नई-पंक्ति.
निर्गम लिखो: ( ['तीसरा: '] + ( a ? 2 ) ), नई-पंक्ति.
निर्गम लिखो: ( ['गुणनफल: '] + ( a गुणनफल ) ), नई-पंक्ति.
a क्रमित: { :a :b <- (b - a). }.
a प्रत्येक: { :i :e निर्गम लिखो: ( i - 0 ), नई-पंक्ति. }.

} चलाओ.



प्रोग्राम सफ़ाई.
प्रयुक्त-मेमोरी2 := (प्रोग्राम मेमोरी ? 0).


{

>> a := सूची ← ['hello'] ; ['world'] ; सत्य ; शून्य ; 666.
a := a + ( सूची ← 1 ).
निर्गम लिखो: ( ['योग: '] + ( a योग ) ), नई-पंक्ति.
निर्गम लिखो: ( ['न्यूनतम: '] + ( a न्यूनतम ) ), नई-पंक्ति.
निर्गम लिखो: ( ['अधिकतम: '] + ( a अधिकतम ) ), नई-पंक्ति.
निर्गम लिखो: ( ['तीसरा: '] + ( a ? 2 ) ), नई-पंक्ति.
निर्गम लिखो: ( ['गुणनफल: '] + ( a गुणनफल ) ), नई-पंक्ति.
a क्रमित: { :a :b <- (b - a). }.
a प्रत्येक: { :i :e निर्गम लिखो: ( i - 0 ), नई-पंक्ति. }.

} चलाओ.



प्रोग्राम सफ़ाई.
प्रयुक्त-मेमोरी3 := (प्रोग्राम मेमोरी ? 0).

( प्रयुक्त-मेमोरी1 = प्रयुक्त-मेमोरी2 और: प्रयुक्त-मेमोरी1 = प्रयुक्त-मेमोरी3, और: प्रयुक्त-मेमोरी2 = प्रयुक्त-मेमोरी3 ) सत्य-हो-तो: {
	निर्गम लिखो: ['यहाँ कोई मेमोरी लीक नहीं'].
}, असत्य-हो-तो: {
	निर्गम लिखो: ['मेमोरी लीक हो रही है...'].
}.
