

सूची जब: ['sum'] करो: {
	>> total := 0.
	स्वयं प्रत्येक: { :index :element
		total जमा: element.
	}. <- total.
}.

सूची जब: ['product'] करो: {
	>> total := 1.
	स्वयं प्रत्येक: { :index :element
		total गुणा: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

प्रोग्राम मेमोरी-प्रबंधन: 0.

{

>> a := सूची ← ['hello'] ; ['world'] ; सत्य ; शून्य ; 666.
a := a + ( सूची ← 1 ).
निर्गम लिखो: ( ['sum: '] + ( a sum ) ), नई-पंक्ति.
निर्गम लिखो: ( ['min: '] + ( a न्यूनतम ) ), नई-पंक्ति.
निर्गम लिखो: ( ['max: '] + ( a अधिकतम ) ), नई-पंक्ति.
निर्गम लिखो: ( ['3rd: '] + ( a ? 2 ) ), नई-पंक्ति.
निर्गम लिखो: ( ['prd: '] + ( a product ) ), नई-पंक्ति.
a क्रमित: { :a :b <- (b - a). }.
a प्रत्येक: { :i :e निर्गम लिखो: ( i - 0 ), नई-पंक्ति. }.

} चलाओ.

प्रोग्राम सफ़ाई.
usedMemory1 := (प्रोग्राम मेमोरी ? 0).


