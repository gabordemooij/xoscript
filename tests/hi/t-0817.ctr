# a value ending in the first part of an opening quote must survive serialization
>> मान-सूची := सूची नया
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

मान-सूची प्रत्येक: { :i :value
	>> d := शब्दकोश नया.
	d रखो: value कुंजी: ['k'].
	d रखो: ['second'] कुंजी: ['j'].
	>> r := d कोड वस्तु-में.
	निर्गम लिखो: r गिनती, नई-पंक्ति.
	निर्गम लिखो: ( (r पर: ['k']) = value ), नई-पंक्ति.
}.
