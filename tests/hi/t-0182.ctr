

>> प्रयुक्त-मेमोरी1 := 0.
>> प्रयुक्त-मेमोरी2 := 0.
>> प्रयुक्त-मेमोरी3 := 0.
>> प्रयुक्त-मेमोरी4 := 0.

प्रोग्राम मेमोरी-प्रबंधन: 0.

>> txt := ['1.6'].
>> n := txt संख्या-में.
>> t := txt बूलियन-में.
निर्गम लिखो: n, नई-पंक्ति.
निर्गम लिखो: t, नई-पंक्ति.
निर्गम लिखो: n प्रकार, नई-पंक्ति.
निर्गम लिखो: t प्रकार, नई-पंक्ति.

प्रोग्राम सफ़ाई.

प्रयुक्त-मेमोरी1 := (प्रोग्राम मेमोरी ? 0).


txt := ['1.6'].
n := txt संख्या-में.
t := txt बूलियन-में.
निर्गम लिखो: n, नई-पंक्ति.
निर्गम लिखो: t, नई-पंक्ति.
निर्गम लिखो: n प्रकार, नई-पंक्ति.
निर्गम लिखो: t प्रकार, नई-पंक्ति.

प्रोग्राम सफ़ाई.
प्रयुक्त-मेमोरी2 := (प्रोग्राम मेमोरी ? 0).


txt := ['1.6'].
n := txt संख्या-में.
t := txt बूलियन-में.
निर्गम लिखो: n, नई-पंक्ति.
निर्गम लिखो: t, नई-पंक्ति.
निर्गम लिखो: n प्रकार, नई-पंक्ति.
निर्गम लिखो: t प्रकार, नई-पंक्ति.

प्रोग्राम सफ़ाई.
प्रयुक्त-मेमोरी3 := (प्रोग्राम मेमोरी ? 0).



( प्रयुक्त-मेमोरी1 = प्रयुक्त-मेमोरी2 और: प्रयुक्त-मेमोरी1 = प्रयुक्त-मेमोरी3, और: प्रयुक्त-मेमोरी2 = प्रयुक्त-मेमोरी3 ) सत्य-हो-तो: {
	निर्गम लिखो: ['यहाँ कोई मेमोरी लीक नहीं'].
}, असत्य-हो-तो: {
	निर्गम लिखो: ['मेमोरी लीक हो रही है...'].
}.
