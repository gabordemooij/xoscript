>> a := सूची ← वस्तु ; सत्य ; असत्य ; बूलियन ; 1 ; संख्या ; ['Str'] ; पाठ ; { ['खाली']. }.
निर्गम लिखो: (a गिनती), नई-पंक्ति.
{ :i
	निर्गम लिखो: 
	['a '] + 
	((a ? i) प्रकार) +
	([' \‘this\’ '] this: (a ? i))  +
	[' है '] +
	(((a ? i) शून्य?) यह: [''] या-वह: ['नहीं']) + 
	[' शून्य.'],
	नई-पंक्ति.
} × (a गिनती).
निर्गम लिखो: ['पर.. शून्य है.. '] + ((शून्य शून्य?) यह: ['बेशक शून्य!'] या-वह: ['शून्य नहीं??']), नई-पंक्ति.