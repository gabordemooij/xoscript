>> a := सूची ← वस्तु ; सत्य ; असत्य ; बूलियन ; 1 ; संख्या ; ['Str'] ; पाठ ; { ['Empty']. }.
निर्गम लिखो: (a गिनती), नई-पंक्ति.
{ :i
	निर्गम लिखो: 
	['a '] + 
	((a ? i) प्रकार) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) शून्य?) यह: [''] या-वह: ['NOT']) + 
	[' Nil.'],
	नई-पंक्ति.
} × (a गिनती).
निर्गम लिखो: ['but.. Nil is.. '] + ((शून्य शून्य?) यह: ['certainly NIL!'] या-वह: ['not NIL??']), नई-पंक्ति.