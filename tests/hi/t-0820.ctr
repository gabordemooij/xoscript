# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := पैटर्न नया: pattern.
	p मिलान: subject करो: { :m :g
		निर्गम लिखो: g गिनती, लिखो: [' '], लिखो: (g जोड़ो: ['|']), नई-पंक्ति. <- m.
	}.
}.
show लागू: ['(a)|(b)'] और: ['b'].
show लागू: ['(a)|(b)'] और: ['a'].
show लागू: ['(x)?y'] और: ['y'].
show लागू: ['(x)?(y)(z)?'] और: ['xy'].
