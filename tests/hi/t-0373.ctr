# compliance test

# use international numbers

निर्गम लिखो: ['1000 -> '].
निर्गम लिखो: 1000, नई-पंक्ति. #1000

निर्गम लिखो: ['1.5 -> '].
निर्गम लिखो: 1.5, नई-पंक्ति.  #1.5

निर्गम लिखो: ['1001.5 -> '].
निर्गम लिखो: 1.5 + 1000, नई-पंक्ति. #1001.5

# use 0-indexed arrays
>> x := सूची नया ; 1 ; 2 ; 3.
>> y := सूची नया ; ['a'] ; ['b'] ; ['c'].

निर्गम लिखो: ['1 -> '].
निर्गम लिखो: x ? 0, नई-पंक्ति. #1

निर्गम लिखो: ['1 -> '].
निर्गम लिखो: (x पर: 0), नई-पंक्ति. #1

निर्गम लिखो: ['1 -> '].
निर्गम लिखो: x पहला, नई-पंक्ति. #1

निर्गम लिखो: ['3 -> '].
निर्गम लिखो: x अंतिम, नई-पंक्ति. #3

निर्गम लिखो: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
निर्गम लिखो: (x अनुसार: y), नई-पंक्ति.

निर्गम लिखो: ['1 -> '].
निर्गम लिखो: (x आरंभ: 0 लंबाई: 1) पहला, नई-पंक्ति. #1

निर्गम लिखो: ['0 -> '].
निर्गम लिखो: (x खोजो: 1), नई-पंक्ति. #0

x रखो: 9 कुंजी: 0.

निर्गम लिखो: ['9 -> '].
निर्गम लिखो: (x पर: 0), नई-पंक्ति. #9

x आरंभ-में-जोड़ो: 8.
निर्गम लिखो: ['8 -> '].
निर्गम लिखो: (x पर: 0), नई-पंक्ति. #9


x अंत-में-जोड़ो: 10.
निर्गम लिखो: ['10 -> '].
निर्गम लिखो: (x पर: 4), नई-पंक्ति. #10








