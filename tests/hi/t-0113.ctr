निर्गम लिखो: ['for-लूप जारी रखो, No - 6 और ऊपर से पहले.'], नई-पंक्ति.
{ :i
	निर्गम लिखो: (i + 1), नई-पंक्ति.
	((i + 1) > 4) जारी.
	निर्गम लिखो: ['-'].
} × 10.

>> x := 0.
>> x-10-से-कम := { <- ( x < 10 ). }.
निर्गम नई-पंक्ति.
निर्गम लिखो: ['while-true जारी रखो, No --> 5 और ऊपर से पहले.'], नई-पंक्ति.
{
	निर्गम लिखो: ['iteration #'] + x, नई-पंक्ति.
	x जमा: 1.
	((x < 5) विपरीत) जारी.
	निर्गम लिखो: ['-->'].
} जब-तक: x-10-से-कम.
निर्गम नई-पंक्ति.
निर्गम लिखो: ['while-false जारी रखो, No - केवल 3 से पहले.'], नई-पंक्ति.
{
	निर्गम लिखो: ['iteration #'] + x, नई-पंक्ति.
	x घटाओ: 1.
	(x = 3) जारी.
	निर्गम लिखो: ['-'].
} जब-तक: { <- ( x > 0). }.

निर्गम नई-पंक्ति.
निर्गम लिखो: ['times-लूप जारी रखो, No ||| 3 से पहले.'], नई-पंक्ति.
{ :i
	निर्गम लिखो: ['iteration #'] + i, नई-पंक्ति.
	(i = 2) जारी.
	निर्गम लिखो: ['|||'].
} × 5.

निर्गम नई-पंक्ति.

{ सत्य जारी. निर्गम लिखो: ['यह मत लिखो!'], नई-पंक्ति. } चलाओ.

{ सत्य जारी. निर्गम लिखो: ['यह मत लिखो!'], नई-पंक्ति. } पकड़ो: { निर्गम लिखो: ['इसे मत पकड़ो!']. }, चलाओ.

निर्गम लिखो: ['सूची each-लूप परीक्षण: 0, ... ,2'], नई-पंक्ति.
(सूची ← 1 ; 2 ; 3) रूपांतर: { :i
	(i = 1) जारी.
	निर्गम लिखो: ['iteration #'] + (i - 0), नई-पंक्ति.
}.

निर्गम लिखो: ['शब्दकोश each-लूप परीक्षण: केवल c'], नई-पंक्ति.
>> m := शब्दकोश नया.
m रखो: ['first'] कुंजी: ['a'], रखो: ['second'] कुंजी: ['b'], रखो: ['तृतीय'] कुंजी: ['c'].
m प्रत्येक: { :k :v
	(k ≠ ['c']) जारी.
	निर्गम लिखो: ['iteration'] + k + v, नई-पंक्ति.
}.

