निर्गम लिखो: ['Continue for-loop, No - before 6 and up.'], नई-पंक्ति.
{ :i
	निर्गम लिखो: (i + 1), नई-पंक्ति.
	((i + 1) > 4) जारी.
	निर्गम लिखो: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
निर्गम नई-पंक्ति.
निर्गम लिखो: ['Continue while-true, No --> before 5 and up.'], नई-पंक्ति.
{
	निर्गम लिखो: ['iteration #'] + x, नई-पंक्ति.
	x जमा: 1.
	((x < 5) विपरीत) जारी.
	निर्गम लिखो: ['-->'].
} जब-तक: xIsLessThan10.
निर्गम नई-पंक्ति.
निर्गम लिखो: ['Continue while-false, No - before 3 only.'], नई-पंक्ति.
{
	निर्गम लिखो: ['iteration #'] + x, नई-पंक्ति.
	x घटाओ: 1.
	(x = 3) जारी.
	निर्गम लिखो: ['-'].
} जब-तक: { <- ( x > 0). }.

निर्गम नई-पंक्ति.
निर्गम लिखो: ['Continue times-loop, No ||| before 3.'], नई-पंक्ति.
{ :i
	निर्गम लिखो: ['iteration #'] + i, नई-पंक्ति.
	(i = 2) जारी.
	निर्गम लिखो: ['|||'].
} × 5.

निर्गम नई-पंक्ति.

{ सत्य जारी. निर्गम लिखो: ['dont write this!'], नई-पंक्ति. } चलाओ.

{ सत्य जारी. निर्गम लिखो: ['dont write this!'], नई-पंक्ति. } पकड़ो: { निर्गम लिखो: ['Dont catch this!']. }, चलाओ.

निर्गम लिखो: ['Test Array each-loop: 0, ... ,2'], नई-पंक्ति.
(सूची ← 1 ; 2 ; 3) रूपांतर: { :i
	(i = 1) जारी.
	निर्गम लिखो: ['iteration #'] + (i - 0), नई-पंक्ति.
}.

निर्गम लिखो: ['Test Map each-loop: c only'], नई-पंक्ति.
>> m := शब्दकोश नया.
m रखो: ['first'] कुंजी: ['a'], रखो: ['second'] कुंजी: ['b'], रखो: ['third'] कुंजी: ['c'].
m प्रत्येक: { :k :v
	(k ≠ ['c']) जारी.
	निर्गम लिखो: ['iteration'] + k + v, नई-पंक्ति.
}.

