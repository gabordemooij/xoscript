# सामान्य प्रवाह
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> फ़ाइल-पथ := ['/tmp/dat.csv'].
>> csv := फ़ाइल नया: फ़ाइल-पथ.
csv लिखो: s.

# CRLF LF CR स्वीकार करता है, पंक्तियों की लंबाई अलग-अलग
csv विभाजक: [';'] उद्धरण: ['"'] पंक्तियाँ: { :line
	प्रोग्राम सफ़ाई.
	निर्गम लिखो: line, नई-पंक्ति.
	प्रोग्राम सफ़ाई.
}.

# असमान पंक्तियाँ
s अंत-में-जोड़ो: ['\njustone'].
csv लिखो: s.
{
	csv विभाजक: [';'] उद्धरण: ['"'] पंक्तियाँ: { :line
		निर्गम लिखो: line, नई-पंक्ति.
	}.
} पकड़ो: { :e 
	निर्गम लिखो: e, नई-पंक्ति.
}, चलाओ.

# अमान्य प्रारूप
s := ['"he"llo";world'].
csv लिखो: s.
{
	csv विभाजक: [';'] उद्धरण: ['"'] पंक्तियाँ: { :line
		निर्गम लिखो: line, नई-पंक्ति.
	}.
} पकड़ो: { :e 
	निर्गम लिखो: e, नई-पंक्ति.
}, चलाओ.
