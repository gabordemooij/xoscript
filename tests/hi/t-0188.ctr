

>> प्रयुक्त-मेमोरी1 := 0.
>> प्रयुक्त-मेमोरी2 := 0.
>> प्रयुक्त-मेमोरी3 := 0.
>> प्रयुक्त-मेमोरी4 := 0.

प्रोग्राम मेमोरी-प्रबंधन: 0.

{ :i निर्गम लिखो: i. } × 4.
निर्गम नई-पंक्ति.
{ :i निर्गम लिखो: (4 - i). } × 4.
निर्गम नई-पंक्ति.
( 1 > 2 ) असत्य-हो-तो: { निर्गम लिखो: ['ब्लॉक 1'], नई-पंक्ति. }.
( 2 > 1 ) सत्य-हो-तो:  { निर्गम लिखो: ['ब्लॉक 2'], नई-पंक्ति. }.

>> i := 0.
{ निर्गम लिखो: i. i जमा: 1. } जब-तक: { <- ( i < 3). }.
निर्गम नई-पंक्ति.

i := 3.
{ निर्गम लिखो: i. i := i - 1. } जब-तक: { <- ( i > 0). }.
निर्गम नई-पंक्ति.


प्रोग्राम सफ़ाई.

प्रयुक्त-मेमोरी1 := (प्रोग्राम मेमोरी ? 0).


{ :i  निर्गम लिखो: i. } × 4.
निर्गम नई-पंक्ति.
{ :i  निर्गम लिखो: (4 - i). } × 4.
निर्गम नई-पंक्ति.
( 1 > 2 ) असत्य-हो-तो: { निर्गम लिखो: ['ब्लॉक 1'], नई-पंक्ति. }.
( 2 > 1 ) सत्य-हो-तो:  { निर्गम लिखो: ['ब्लॉक 2'], नई-पंक्ति. }.

>> i := 0.
{ निर्गम लिखो: i. i जमा: 1. } जब-तक: { <- ( i < 3). }.
निर्गम नई-पंक्ति.

i := 3.
{ निर्गम लिखो: i. i := i - 1. } जब-तक: { <- ( i > 0). }.
निर्गम नई-पंक्ति.



प्रोग्राम सफ़ाई.
प्रयुक्त-मेमोरी2 := (प्रोग्राम मेमोरी ? 0).


{ :i निर्गम लिखो: i. } × 4.
निर्गम नई-पंक्ति.
{ :i निर्गम लिखो: (4 - i). } × 4.
निर्गम नई-पंक्ति.
( 1 > 2 ) असत्य-हो-तो: { निर्गम लिखो: ['ब्लॉक 1'], नई-पंक्ति. }.
( 2 > 1 ) सत्य-हो-तो:  { निर्गम लिखो: ['ब्लॉक 2'], नई-पंक्ति. }.

>> i := 0.
{ निर्गम लिखो: i. i जमा: 1. } जब-तक: { <- ( i < 3). }.
निर्गम नई-पंक्ति.

i := 3.
{ निर्गम लिखो: i. i := i - 1. } जब-तक: { <- ( i > 0). }.
निर्गम नई-पंक्ति.

प्रोग्राम सफ़ाई.
प्रयुक्त-मेमोरी3 := (प्रोग्राम मेमोरी ? 0).



( प्रयुक्त-मेमोरी1 = प्रयुक्त-मेमोरी2 और: प्रयुक्त-मेमोरी1 = प्रयुक्त-मेमोरी3, और: प्रयुक्त-मेमोरी2 = प्रयुक्त-मेमोरी3 ) सत्य-हो-तो: {
	निर्गम लिखो: ['यहाँ कोई मेमोरी लीक नहीं'].
}, असत्य-हो-तो: {
	निर्गम लिखो: ['मेमोरी लीक हो रही है...'].
}.
