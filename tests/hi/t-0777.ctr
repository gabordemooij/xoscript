#OBSD
>> dirname := [''].
{ dirname अंत-में-जोड़ो: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
प्रोग्राम सिस्टम: command.
प्रोग्राम chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename अंत-में-जोड़ो: ['YYYYYYYY']. } * 20.
फ़ाइल नया: filename, लिखो: ['sometext'].
{ फ़ाइल सूचीबद्ध: ['/tmp/'] + dirname. } * 1000.
निर्गम लिखो: ['no crash'], नई-पंक्ति.

