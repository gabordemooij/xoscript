# a format must fit the type of the value, the type can come from a client
>> प्रयास := { :format :value
	{ निर्गम लिखो: ( (प्रारूप नया: format) लागू: value ), नई-पंक्ति. } पकड़ो: { :e निर्गम लिखो: e, नई-पंक्ति. }, चलाओ.
}.
>> try-int := { :format :value
	{ निर्गम लिखो: ( (प्रारूप नया: format) लागू-पूर्णांक: value ), नई-पंक्ति. } पकड़ो: { :e निर्गम लिखो: e, नई-पंक्ति. }, चलाओ.
}.

# fits
प्रयास लागू: ['|%s|'] और: ['text'].
प्रयास लागू: ['%06.2f'] और: 5.5.
प्रयास लागू: ['100%% %s'] और: ['sure'].
try-int लागू: ['%03d'] और: 7.
try-int लागू: ['%x'] और: 255.
प्रयास लागू: ['%d'] और: (Int64 नया पाठ-से: ['12']).
प्रयास लागू: ['%lld'] और: (Int64 नया पाठ-से: ['12']).
प्रयास लागू: ['%.1lf'] और: 5.5.
try-int लागू: ['%hd'] और: 7.

# does not fit
प्रयास लागू: ['%s'] और: 12345.
प्रयास लागू: ['%d'] और: 12345.
प्रयास लागू: ['%f'] और: ['text'].
try-int लागू: ['%d'] और: ['text'].
try-int लागू: ['%s'] और: 5.
प्रयास लागू: ['%s %s'] और: ['text'].
प्रयास लागू: ['%n'] और: ['text'].
प्रयास लागू: ['%*s'] और: ['text'].
प्रयास लागू: ['%'] और: ['text'].

# length modifier does not fit
प्रयास लागू: ['%ls'] और: ['text'].
प्रयास लागू: ['%Lf'] और: 5.5.
try-int लागू: ['%ld'] और: 7.
try-int लागू: ['%lld'] और: 7.
प्रयास लागू: ['%Ld'] और: (Int64 नया पाठ-से: ['12']).

# a width that does not fit printf must give an error, not a crash
प्रयास लागू: ['%99999999999s'] और: ['text'].
