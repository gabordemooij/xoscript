#Linux
>> OS := प्रोग्राम सेटिंग: ['OS'].

>> clock := क्षण नया.
	
(OS = ['Haiku']) सत्य-हो-तो: {
	clock समय-क्षेत्र: ['CET'],
	वर्ष: 2017, महीना: 7, दिन: 13,
	घंटा: 18, मिनट: 0, सेकंड: 0.
}, अन्यथा: {
	clock समय-क्षेत्र: ['Europe/Amsterdam'],
	वर्ष: 2017, महीना: 7, दिन: 13,
	घंटा: 18, मिनट: 0, सेकंड: 0.
}.

clock जब: ['tell'] करो: {
	निर्गम लिखो: स्वयं, नई-पंक्ति.
}.


clock जमा: 2    घंटा, tell.
clock जमा: 1    घंटा, tell.
clock जमा: 19 मिनट, tell.
clock जमा: 1  मिनट, tell.
clock जमा: 1  मिनट, tell.
clock जमा: 19 सेकंड, tell.
clock जमा: 1  सेकंड, tell.
clock जमा: 1  सेकंड, tell.
clock जमा: 2    वर्ष, tell.
clock जमा: 1    वर्ष, tell.

(OS = ['Haiku']) सत्य-हो-तो: {
clock जमा: 5   महीना.
clock समय-क्षेत्र: ['CEST'], tell.
}, अन्यथा: {
	clock जमा: 5   महीना, tell.
}.

clock जमा: 1   महीना, tell.
clock जमा: 19    दिन, tell.
clock जमा: 1    घंटा, tell.
clock जमा: 120  yard, tell.
