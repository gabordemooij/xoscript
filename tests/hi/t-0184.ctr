

>> प्रयुक्त-मेमोरी1 := 0.
>> प्रयुक्त-मेमोरी2 := 0.
>> प्रयुक्त-मेमोरी3 := 0.
>> प्रयुक्त-मेमोरी4 := 0.

प्रोग्राम मेमोरी-प्रबंधन: 0.

संख्या जब: ['addNum:'] करो: { :x
	स्वयं जमा: x.
}.

संख्या जब: ['subtractNum:'] करो: { :x
	स्वयं घटाओ: x.
}.

संख्या जब: ['multiplyBy:'] करो: { :x
	स्वयं गुणा: x.
}.

संख्या जब: ['divideBy:'] करो: { :x
	स्वयं भाग: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 घात: 8).  
a := a + (2 घात: -1). 
a := a + (49 वर्गमूल).   
a addNum: ((सूची ← 0 ; 1) अधिकतम).          
a addNum: ((सूची ← 2 ; 3) न्यूनतम).
निर्गम लिखो: a.

प्रोग्राम सफ़ाई.

प्रयुक्त-मेमोरी1 := (प्रोग्राम मेमोरी ? 0).


a := 1.
