
>> countries := सूची नया
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := सूची नया
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods अनुसार: countries, प्रत्येक: { :key :value
	counter जमा: 1.
}.

निर्गम लिखो: (['we serve counter dishes'] counter: counter), नई-पंक्ति.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] वर्ण-सूची क्रमित: { :v
	counter जमा: 0.
}.

निर्गम लिखो: (['we sort counter dishes'] counter: counter), नई-पंक्ति.


>> counter := 0.
{
	{
		counter जमा: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


निर्गम लिखो: (['we calculate counter numbers.'] counter: counter), नई-पंक्ति.

