# test qualifiers

>> $ := वस्तु नया.

$ जब: ['उत्तर:'] करो: { :x
	
	>> operation := x वर्ण: 0.
	>> valuta := x वर्ण: 1.
	>> money := x छोड़ो: 2.
	
	>> amount := 0.

	( operation = ['+'] ) सत्य-हो-तो: {
		( valuta = ['£'] ) सत्य-हो-तो: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

निर्गम लिखो: x, नई-पंक्ति.


>> Fruit := वस्तु नया.

Fruit जब: ['नया'] करो: {
	>> f := स्वयं नया.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit जब: ['apples:'] करो: { :a अपना apples := a. }.
Fruit जब: ['oranges:'] करो: { :p अपना oranges := p. }.
Fruit जब: ['apples'] करो: { <- अपना apples. }.
Fruit जब: ['oranges'] करो: { <- अपना oranges. }.

Fruit जब: ['+'] करो: { :f
	
	>> n := Fruit नया.
	f जमा: 1.
	
	n apples: (f apples + अपना apples).
	n oranges:  (f oranges  + अपना oranges). <- n.
}.

Fruit जब: ['पाठ-में'] करो: { <- ( अपना apples पाठ-में + [' apples and '] + अपना oranges + [' oranges'] ).
}.

संख्या जब: ['apples'] करो: { <- ((Fruit नया) apples: स्वयं).
}.

संख्या जब: ['apple'] करो: { <- ((Fruit नया) apples: स्वयं).
}.

संख्या जब: ['oranges'] करो: { <- ((Fruit नया) oranges: स्वयं).
}.




निर्गम लिखो: (1 apple + 3 oranges + 4 apples), नई-पंक्ति.


पाठ जब: ['twice'] करो: { <- ((स्वयं पाठ-में) + (स्वयं पाठ-में)).
}.



निर्गम लिखो: ['❤❤❤'] twice.



