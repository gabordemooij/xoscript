# इकाइयों (qualifiers) का परीक्षण

>> $ := वस्तु नया.

$ जब: ['उत्तर:'] करो: { :x
	
	>> संक्रिया := x वर्ण: 0.
	>> मुद्रा-चिह्न := x वर्ण: 1.
	>> पैसा := x छोड़ो: 2.
	
	>> राशि := 0.

	( संक्रिया = ['+'] ) सत्य-हो-तो: {
		( मुद्रा-चिह्न = ['£'] ) सत्य-हो-तो: { राशि := 1.28 × पैसा. }.
	}. <- राशि.
}.



>> x := $ +£20.

निर्गम लिखो: x, नई-पंक्ति.


>> फल-वर्ग := वस्तु नया.

फल-वर्ग जब: ['नया'] करो: {
	>> f := स्वयं नया.
	f apples: 0.
	f oranges: 0. <- f.
}.

फल-वर्ग जब: ['apples:'] करो: { :a अपना सेब := a. }.
फल-वर्ग जब: ['oranges:'] करो: { :p अपना संतरे := p. }.
फल-वर्ग जब: ['सेब'] करो: { <- अपना सेब. }.
फल-वर्ग जब: ['संतरे'] करो: { <- अपना संतरे. }.

फल-वर्ग जब: ['+'] करो: { :f
	
	>> n := फल-वर्ग नया.
	f जमा: 1.
	
	n apples: (f सेब + अपना सेब).
	n oranges:  (f संतरे  + अपना संतरे). <- n.
}.

फल-वर्ग जब: ['पाठ-में'] करो: { <- ( अपना सेब पाठ-में + [' सेब और '] + अपना संतरे + [' संतरे'] ).
}.

संख्या जब: ['सेब'] करो: { <- ((फल-वर्ग नया) apples: स्वयं).
}.

संख्या जब: ['apple'] करो: { <- ((फल-वर्ग नया) apples: स्वयं).
}.

संख्या जब: ['संतरे'] करो: { <- ((फल-वर्ग नया) oranges: स्वयं).
}.




निर्गम लिखो: (1 apple + 3 संतरे + 4 सेब), नई-पंक्ति.


पाठ जब: ['दो-बार'] करो: { <- ((स्वयं पाठ-में) + (स्वयं पाठ-में)).
}.



निर्गम लिखो: ['❤❤❤'] दो-बार.



