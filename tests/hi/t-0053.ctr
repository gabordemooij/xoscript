60 × {
	>> x := (संख्या बेतरतीब % 6) + 1.
	(x ≤ 6) असत्य-हो-तो: { निर्गम लिखो: ['विफल']. }.
	(x ≥0) असत्य-हो-तो: { निर्गम लिखो: ['विफल']. }.
	x := (संख्या बेतरतीब % 3) + 1.
	(x < 3) असत्य-हो-तो: { निर्गम लिखो: ['विफल']. }.
	(x>-1) असत्य-हो-तो: { निर्गम लिखो: ['विफल']. }.
	x := ((बूलियन उछालो) संख्या-में).
	(x = 0 या: x = 1) असत्य-हो-तो: { निर्गम लिखो: ['विफल']. }.
	x := ((सत्य उछालो) संख्या-में).
	(x = 0 या: x = 1) असत्य-हो-तो: { निर्गम लिखो: ['विफल']. }.
	x := (बूलियन उछालो यह: ['चित'] या-वह: ['पट']).
	((x = ['चित']) या: (x = ['पट'])) असत्य-हो-तो: { निर्गम लिखो: ['विफल']. }.
}.
निर्गम लिखो: ['हो गया'].

