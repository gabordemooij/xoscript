60 × {
	>> x := (संख्या random % 6) + 1.
	(x ≤ 6) असत्य-हो-तो: { निर्गम लिखो: ['FAIL']. }.
	(x ≥0) असत्य-हो-तो: { निर्गम लिखो: ['FAIL']. }.
	x := (संख्या random % 3) + 1.
	(x < 3) असत्य-हो-तो: { निर्गम लिखो: ['FAIL']. }.
	(x>-1) असत्य-हो-तो: { निर्गम लिखो: ['FAIL']. }.
	x := ((बूलियन flip) संख्या-में).
	(x = 0 या: x = 1) असत्य-हो-तो: { निर्गम लिखो: ['FAIL']. }.
	x := ((सत्य flip) संख्या-में).
	(x = 0 या: x = 1) असत्य-हो-तो: { निर्गम लिखो: ['FAIL']. }.
	x := (बूलियन flip यह: ['HEAD'] या-वह: ['TAIL']).
	((x = ['HEAD']) या: (x = ['TAIL'])) असत्य-हो-तो: { निर्गम लिखो: ['FAIL']. }.
}.
निर्गम लिखो: ['DONE'].

