>> To-Do := वस्तु नया.

To-Do जब: ['नया'] करो: {
	अपना list := सूची नया.
}.

To-Do जब: ['nieuw'] करो: {
	अपना list := सूची नया.
}.

To-Do जब: ['+'] करो: { :task
	अपना list अंत-में-जोड़ो: task.
}.

To-Do जब: ['number of tasks?'] करो: { <-  अपना list गिनती.
}.

>> todos := 
	To-Do नया 
	+ ['cook dinner'] 
	+ ['clean room'].
	
निर्गम लिखो: ['You have $ tasks to do'] $ todos number of tasks?.
