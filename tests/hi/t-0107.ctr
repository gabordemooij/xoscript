
निर्गम लिखो: ['Break for-loop, 0-4.'], नई-पंक्ति.
{ :i
	निर्गम लिखो: ['iteration #'] + i, नई-पंक्ति.
	(i = 4) तोड़ो.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

निर्गम लिखो: ['Break while-true loop, 0-4.'], नई-पंक्ति.
{
	निर्गम लिखो: ['iteration #'] + x, नई-पंक्ति.
	x जमा: 1.
	((x < 5) विपरीत) तोड़ो.
} जब-तक: xIsLessThan10.

निर्गम लिखो: ['Break while-false loop, 5,4.'], नई-पंक्ति.
{
	निर्गम लिखो: ['iteration #'] + x, नई-पंक्ति.
	x घटाओ: 1.
	(x = 3) तोड़ो.
} जब-तक: { <- (x > 0). }.

निर्गम लिखो: ['Break times loop, 1-4.'], नई-पंक्ति.
{ :i
	निर्गम लिखो: ['iteration #'] + i, नई-पंक्ति.
	(i = 4) तोड़ो.
} × 5.

निर्गम लिखो: ['Break block, dont print line.'], नई-पंक्ति.
{ सत्य तोड़ो. निर्गम लिखो: ['dont write this!'], नई-पंक्ति. } चलाओ.

निर्गम लिखो: ['Break block, dont fire catch...'], नई-पंक्ति.
{ सत्य तोड़ो. निर्गम लिखो: ['dont write this!'], नई-पंक्ति. } पकड़ो: { निर्गम लिखो: ['Dont catch this!']. }, चलाओ.

निर्गम लिखो: ['Test Array each-loop: 0,1'], नई-पंक्ति.
(सूची ← 1 ; 2 ; 3) रूपांतर: { :i
	निर्गम लिखो: ['iteration #'] + i, नई-पंक्ति.
	(i = 1) तोड़ो.
}.

निर्गम लिखो: ['Test Map each-loop: c only'], नई-पंक्ति.
>> m := शब्दकोश नया.
m रखो: ['first'] कुंजी: ['a'], रखो: ['second'] कुंजी: ['b'], रखो: ['third'] कुंजी: ['c'].
m प्रत्येक: { :k :v
	निर्गम लिखो: ['iteration'] + v + k, नई-पंक्ति.
	सत्य तोड़ो.
}.

