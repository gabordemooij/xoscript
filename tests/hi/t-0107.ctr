
निर्गम लिखो: ['for-लूप तोड़ो, 0-4.'], नई-पंक्ति.
{ :i
	निर्गम लिखो: ['iteration #'] + i, नई-पंक्ति.
	(i = 4) तोड़ो.
} × 10.

>> x := 0.
>> x-10-से-कम := { <- ( x < 10 ). }.

निर्गम लिखो: ['while-true लूप तोड़ो, 0-4.'], नई-पंक्ति.
{
	निर्गम लिखो: ['iteration #'] + x, नई-पंक्ति.
	x जमा: 1.
	((x < 5) विपरीत) तोड़ो.
} जब-तक: x-10-से-कम.

निर्गम लिखो: ['while-false लूप तोड़ो, 5,4.'], नई-पंक्ति.
{
	निर्गम लिखो: ['iteration #'] + x, नई-पंक्ति.
	x घटाओ: 1.
	(x = 3) तोड़ो.
} जब-तक: { <- (x > 0). }.

निर्गम लिखो: ['times लूप तोड़ो, 1-4.'], नई-पंक्ति.
{ :i
	निर्गम लिखो: ['iteration #'] + i, नई-पंक्ति.
	(i = 4) तोड़ो.
} × 5.

निर्गम लिखो: ['ब्लॉक तोड़ो, पंक्ति मत छापो.'], नई-पंक्ति.
{ सत्य तोड़ो. निर्गम लिखो: ['यह मत लिखो!'], नई-पंक्ति. } चलाओ.

निर्गम लिखो: ['ब्लॉक तोड़ो, catch मत चलाओ...'], नई-पंक्ति.
{ सत्य तोड़ो. निर्गम लिखो: ['यह मत लिखो!'], नई-पंक्ति. } पकड़ो: { निर्गम लिखो: ['इसे मत पकड़ो!']. }, चलाओ.

निर्गम लिखो: ['सूची each-लूप परीक्षण: 0,1'], नई-पंक्ति.
(सूची ← 1 ; 2 ; 3) रूपांतर: { :i
	निर्गम लिखो: ['iteration #'] + i, नई-पंक्ति.
	(i = 1) तोड़ो.
}.

निर्गम लिखो: ['शब्दकोश each-लूप परीक्षण: केवल c'], नई-पंक्ति.
>> m := शब्दकोश नया.
m रखो: ['first'] कुंजी: ['a'], रखो: ['second'] कुंजी: ['b'], रखो: ['तृतीय'] कुंजी: ['c'].
m प्रत्येक: { :k :v
	निर्गम लिखो: ['iteration'] + v + k, नई-पंक्ति.
	सत्य तोड़ो.
}.

