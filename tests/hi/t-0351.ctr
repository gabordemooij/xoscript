
>> प्रयुक्त-मेमोरी1 := 0.
>> प्रयुक्त-मेमोरी2 := 0.
>> प्रयुक्त-मेमोरी3 := 0.
>> प्रयुक्त-मेमोरी4 := 0.

>> कोड := {
	>> o := (
		शब्दकोश नया
		aa: (सूची ← 1 ; 2),
		bb: (सूची ← 3 ; 4)
	).
	>> s := o पाठ-में.
	>> o2 := s वस्तु-में.
	(s  प्रकार = पाठ प्रकार) सत्य-हो-तो: { निर्गम लिखो: ['OK1'], नई-पंक्ति. }.
	(o2 प्रकार = शब्दकोश प्रकार) सत्य-हो-तो: { निर्गम लिखो: ['OK2'], नई-पंक्ति. }.
}.

प्रोग्राम मेमोरी-प्रबंधन: 0.
['मेमोरी 1 अलग: ब्लॉक थोक में जुड़ते हैं.'].
प्रोग्राम सफ़ाई.
प्रयुक्त-मेमोरी1 := (प्रोग्राम मेमोरी ? 1).
कोड चलाओ.
प्रोग्राम सफ़ाई.
प्रयुक्त-मेमोरी2 := (प्रोग्राम मेमोरी ? 1).
कोड चलाओ.
प्रोग्राम सफ़ाई.
प्रयुक्त-मेमोरी3 := (प्रोग्राम मेमोरी ? 1).
कोड चलाओ.
प्रोग्राम सफ़ाई.
प्रयुक्त-मेमोरी4 := (प्रोग्राम मेमोरी ? 1).

(प्रयुक्त-मेमोरी2 = प्रयुक्त-मेमोरी3 = प्रयुक्त-मेमोरी4) सत्य-हो-तो: { निर्गम लिखो: ['OK3'], नई-पंक्ति. }.
 
