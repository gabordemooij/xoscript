>> t := शून्य.

# you can control the time zone for
# parsing like this:
क्षण समय-क्षेत्र: ['CET'].
t := क्षण से: ['1981-02-03 04:05:06'].
निर्गम लिखो: t, नई-पंक्ति.

# now using CEST time zone:
क्षण समय-क्षेत्र: ['CEST'].
t := क्षण से: ['1981-02-03 04:05:06'].
निर्गम लिखो: t, नई-पंक्ति.

# error if string cannot be parsed
{ क्षण से: ['1900']. } पकड़ो: { शून्य. }, चलाओ.
