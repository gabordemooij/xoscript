

सूची जब: ['column:'] करो: { :column
	>> result := सूची नया.
	स्वयं प्रत्येक: { :index :row
		row प्रत्येक: { :index :cell
			(index = column) सत्य-हो-तो: { result अंत-में-जोड़ो: cell. }.
		}.
	}. <- result.
}.


>> a := सूची ←
	(सूची ← 1 ; 2 ; 3) ;
	(सूची ← 4 ; 5 ; 6) ;
	(सूची ← 7 ; 8 ; 9).

>> b := a column: 1.
निर्गम लिखो: b, नई-पंक्ति.

b := a column: 20.
निर्गम लिखो: b, नई-पंक्ति.

b := a column: -100.
निर्गम लिखो: b, नई-पंक्ति.
