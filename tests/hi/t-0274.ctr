

सूची जब: ['column:'] करो: { :स्तंभ
	>> नतीजा := सूची नया.
	स्वयं प्रत्येक: { :सूचकांक :कतार
		कतार प्रत्येक: { :सूचकांक :कोष्ठ
			(सूचकांक = स्तंभ) सत्य-हो-तो: { नतीजा अंत-में-जोड़ो: कोष्ठ. }.
		}.
	}. <- नतीजा.
}.


>> a := सूची ←
	(सूची ← 1 ; 2 ; 3) ;
	(सूची ← 4 ; 5 ; 6) ;
	(सूची ← 7 ; 8 ; 9).

>> b := a column: 1.
निर्गम लिखो: b, नई-पंक्ति.

b := a column: 20.
निर्गम लिखो: b, नई-पंक्ति.

b := a column: -100.
निर्गम लिखो: b, नई-पंक्ति.
