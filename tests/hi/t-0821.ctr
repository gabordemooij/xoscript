# कभी न बंद होने वाले उद्धरण से त्रुटि आनी चाहिए, अनंत लूप नहीं
>> फ़ाइल-पथ := ['/tmp/test0821.csv'].
>> file := फ़ाइल नया: फ़ाइल-पथ.

file लिखो: ['a,b\n"1,2\n'].
{
	file विभाजक: [','] उद्धरण: ['"'] पंक्तियाँ: { :line
		निर्गम लिखो: line, नई-पंक्ति.
	}.
} पकड़ो: { :e निर्गम लिखो: e, नई-पंक्ति. }, चलाओ.

# बंद उद्धरण अब भी काम करता है
file लिखो: ['a,b\n"1,2",3'].
file विभाजक: [','] उद्धरण: ['"'] पंक्तियाँ: { :line
	निर्गम लिखो: line, नई-पंक्ति.
}.
file मिटाओ.
