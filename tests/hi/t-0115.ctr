{
	यह-कार्य त्रुटि: ['Dont fail.'].
	unknown doSomething.
} पकड़ो: {
	निर्गम लिखो: ['Caught!'].
}, चलाओ.

{
	यह-कार्य त्रुटि: ['Dont fail.'].
	अपना unknown doSomething.
} पकड़ो: {
	निर्गम लिखो: ['Caught!'].
}, चलाओ.

{
	यह-कार्य त्रुटि: ['Dont fail.'].
	unknown := 122.
} पकड़ो: {
	निर्गम लिखो: ['Caught!'].
}, चलाओ.


{
	यह-कार्य त्रुटि: ['Dont fail.'].
	सत्य तोड़ो.
	निर्गम लिखो: ['FAIL'].
} पकड़ो: {
	निर्गम लिखो: ['Caught!'].
}, चलाओ.

{
	{
		यह-कार्य त्रुटि: ['Dont fail.'].
		सत्य तोड़ो.
		निर्गम लिखो: ['FAIL'].
	} पकड़ो: { :x
		(x = ['Dont fail.']) सत्य-हो-तो: { यह-कार्य त्रुटि: ['Nested Caught!']. }.
	}, चलाओ.
} पकड़ो: { :e
	निर्गम लिखो: e.
}, चलाओ.
