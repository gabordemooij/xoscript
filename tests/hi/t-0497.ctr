Server init.

# एक परीक्षण फ़ाइल लिखें
>> f := फ़ाइल नया: ['/tmp/test.gif'].
f लिखो: ['GIF87a01234567810'].

# फ़ाइल परोसें
Server आगे-भेजो: ['test.gif'] उपसर्ग: ['/tmp/'].

निर्गम नई-पंक्ति.

निर्गम लिखो: ['कंटेनर के बाहर (सुरक्षा):'], नई-पंक्ति.
{ Server आगे-भेजो: ['../passwd'] उपसर्ग: ['/tmp/']. }
पकड़ो: { :e निर्गम लिखो: e, नई-पंक्ति. },
चलाओ.

निर्गम लिखो: ['अमान्य उपसर्ग:'], नई-पंक्ति.
{ Server आगे-भेजो: ['test.gif'] उपसर्ग: ['z:\\']. }
पकड़ो: { :e निर्गम लिखो: e, नई-पंक्ति. },
चलाओ.

निर्गम लिखो: ['अनुपस्थित फ़ाइल:'], नई-पंक्ति.
{ Server आगे-भेजो: ['xxx.xxx'] उपसर्ग: ['/tmp/']. }
पकड़ो: { :e निर्गम लिखो: e, नई-पंक्ति. },
चलाओ.
