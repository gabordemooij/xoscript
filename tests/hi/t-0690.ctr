# database test
# see example server.xo for required config

Server init.
निर्गम लिखो: ['Database test'], नई-पंक्ति.

>> db := Maria-DB नया होस्ट: ['localhost'],
	उपयोगकर्ता-नाम: ['xo'], पासवर्ड: ['pass123'], डेटाबेस-नाम: ['xobase'], जुड़ो.

निर्गम लिखो: ['Can we connect? '] + db जुड़ा-है?, नई-पंक्ति.

>> खोज-पैरामीटर := db क्वेरी: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], पैरामीटर: ( सूची नया ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  खोज-पैरामीटर निष्पादन. db पुष्टि. } पकड़ो: { :e db वापस-लो.  }, चलाओ.

निर्गम लिखो: ['Can we insert? '] + ( खोज-पैरामीटर insert-id > 0 ), नई-पंक्ति.

>> x := 0.
>> खोज-पैरामीटर :=
db क्वेरी: ['SELECT * FROM book order by id desc limit 2'], 
लाओ: { :row 
	x जमा: 1.
	सत्य तोड़ो. # must clean up, no 'Commands out of sync'
}.

>> खोज-पैरामीटर :=
db क्वेरी: ['SELECT * FROM book order by id desc limit 2'], 
लाओ: { :row
	x जमा: 1.
	सत्य तोड़ो.
}.

(x > 0) सत्य-हो-तो: {
	निर्गम लिखो: ['Can we break in the middle of a fetch? '].
}.

निर्गम लिखो: सत्य, नई-पंक्ति.