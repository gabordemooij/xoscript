पाठ जब: ['html'] करो: { <- (
		स्वयं
		बदलो: ['&'] से: ['&amp;'],
		बदलो: ['<'] से: ['&lt;'],
		बदलो: ['>'] से: ['&gt;'],
		बदलो: ['''] से: ['&apos;'],
		बदलो: ['"'] से: ['&quot;']
	).
}.

