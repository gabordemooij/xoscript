पाठ जब: ['html'] करो: { <- (
		स्वयं
		बदलो: ['&'] से: ['&amp;'],
		बदलो: ['<'] से: ['&lt;'],
		बदलो: ['>'] से: ['&gt;'],
		बदलो: ['''] से: ['&apos;'],
		बदलो: ['"'] से: ['&quot;']
	).
}.

>> प्रयुक्त-मेमोरी1 := 0.
>> प्रयुक्त-मेमोरी2 := 0.
>> प्रयुक्त-मेमोरी3 := 0.
>> प्रयुक्त-मेमोरी4 := 0.

प्रोग्राम मेमोरी-प्रबंधन: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
निर्गम लिखो: txt प्रतिलिपि html, नई-पंक्ति.
निर्गम लिखो: txt प्रतिलिपि छोटे-अक्षर, नई-पंक्ति.
निर्गम लिखो: txt प्रतिलिपि बड़े-अक्षर, नई-पंक्ति.
} चलाओ.

प्रोग्राम सफ़ाई.

प्रयुक्त-मेमोरी1 := (प्रोग्राम मेमोरी ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
निर्गम लिखो: txt प्रतिलिपि html, नई-पंक्ति.
निर्गम लिखो: txt प्रतिलिपि छोटे-अक्षर, नई-पंक्ति.
निर्गम लिखो: txt प्रतिलिपि बड़े-अक्षर, नई-पंक्ति.
} चलाओ.

प्रोग्राम सफ़ाई.
प्रयुक्त-मेमोरी2 := (प्रोग्राम मेमोरी ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
निर्गम लिखो: txt प्रतिलिपि html, नई-पंक्ति.
निर्गम लिखो: txt प्रतिलिपि छोटे-अक्षर, नई-पंक्ति.
निर्गम लिखो: txt प्रतिलिपि बड़े-अक्षर, नई-पंक्ति.
} चलाओ.

प्रोग्राम सफ़ाई.
प्रयुक्त-मेमोरी3 := (प्रोग्राम मेमोरी ? 0).



( प्रयुक्त-मेमोरी1 = प्रयुक्त-मेमोरी2 और: प्रयुक्त-मेमोरी1 = प्रयुक्त-मेमोरी3, और: प्रयुक्त-मेमोरी2 = प्रयुक्त-मेमोरी3 ) सत्य-हो-तो: {
	निर्गम लिखो: ['यहाँ कोई मेमोरी लीक नहीं'].
}, असत्य-हो-तो: {
	निर्गम लिखो: ['मेमोरी लीक हो रही है...'].
}.
