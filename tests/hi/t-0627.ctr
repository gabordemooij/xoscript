

# create a 64-bit integer for exact calculations
>> a := Int64 पाठ-से: ['123'].

# to string
निर्गम लिखो: a, नई-पंक्ति.

# divide
निर्गम लिखो: a / (Int64 पाठ-से: ['3']), नई-पंक्ति.

# multiply
निर्गम लिखो: a * (Int64 पाठ-से: ['2']), नई-पंक्ति.

# add
निर्गम लिखो: a + (Int64 पाठ-से: ['1']), नई-पंक्ति.

# subtract
निर्गम लिखो: a - (Int64 पाठ-से: ['2']), नई-पंक्ति.

# compare
निर्गम लिखो: ( a =   (Int64 पाठ-से: ['123'])), नई-पंक्ति.
निर्गम लिखो: ( a !=: (Int64 पाठ-से: ['124'])), नई-पंक्ति.
निर्गम लिखो: ( a <   (Int64 पाठ-से: ['124'])), नई-पंक्ति.
निर्गम लिखो: ( a >   (Int64 पाठ-से: ['122'])), नई-पंक्ति.
निर्गम लिखो: ( a >=: (Int64 पाठ-से: ['123'])), नई-पंक्ति.
निर्गम लिखो: ( a <=: (Int64 पाठ-से: ['123'])), नई-पंक्ति.





	