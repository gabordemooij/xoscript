
>> सुड़क := वस्तु नया.

सुड़क जब: ['नया'] करो: {
	अपना str := [''].
}.

सुड़क जब: ['उत्तर:'] करो: { :blah
		(अपना str = ['']) सत्य-हो-तो: {
			अपना str अंत-में-जोड़ो: blah.
		}, अन्यथा: {
			अपना str अंत-में-जोड़ो: [' '].
			अपना str अंत-में-जोड़ो: blah.
		}.
}.

सुड़क जब: ['उत्तर:और:'] करो: { :blah :blahah
		(blah लंबाई > 1) सत्य-हो-तो: {
			अपना str अंत-में-जोड़ो: (blah आरंभ: 0 लंबाई: (blah लंबाई - 1)).
		}, अन्यथा: {
			अपना str अंत-में-जोड़ो: blah.
		}.
		अपना str अंत-में-जोड़ो: [' '].
		अपना str अंत-में-जोड़ो: blahah.
}.

सुड़क जब: ['प्राप्त-करो'] करो: {
	>> बफ़र := अपना str.
	अपना str := ['']. <- बफ़र.
}.

निर्गम लिखो: ( प्रोग्राम सिस्टम: ( सुड़क नया echo hello world प्राप्त-करो ) ).
