सूची जब: ['योग'] करो: {
	>> कुल := 0.
	स्वयं प्रत्येक: { :सूचकांक :तत्व
		कुल जमा: तत्व.
	}. <- कुल.
}.

>> a := सत्य.



a जब: ['पाठ-में'] करो: {
	>> हल := शून्य.
	( स्वयं = सत्य ) सत्य-हो-तो: {
		हल := ['हाँ जी'].
	}, अन्यथा: {
		हल := ['बिल्कुल नहीं'].
	}. <- हल.
}.

a जब: ['संख्या-में'] करो: {
	>> हल := शून्य.
	( स्वयं = सत्य ) सत्य-हो-तो: {
		हल := 10.
	}, अन्यथा: {
		हल := 20.
	}. <- हल.
}.

>> b := 666.

b जब: ['पाठ-में'] करो: { <- ['शैतान'].
}.

b जब: ['बूलियन-में'] करो: { <- असत्य.
}.


निर्गम लिखो: a, नई-पंक्ति.  
निर्गम लिखो: (90 + a), नई-पंक्ति. 
निर्गम लिखो: b, नई-पंक्ति. 
निर्गम लिखो: (सत्य और: b), नई-पंक्ति.

a := सूची ← ['hello'] ; ['world'] ; सत्य ; शून्य ; 666. 
a := a + ( सूची ← 1 ).
निर्गम लिखो: a, नई-पंक्ति.
निर्गम लिखो: ((शब्दकोश नया) रखो: शून्य कुंजी: शून्य), नई-पंक्ति.
निर्गम लिखो: a योग, नई-पंक्ति. 


{
	a जब: ['पाठ-में'] करो: { <- शून्य. }.
	a := [''] + a.
} पकड़ो: { :त्रुटि
	निर्गम लिखो: ['त्रुटि दर्ज: '] + त्रुटि, नई-पंक्ति.
}, चलाओ.



{
	a जब: ['संख्या-में'] करो: { <- शून्य. }.
	a := 3 × a.
} पकड़ो: { :त्रुटि
	निर्गम लिखो: ['त्रुटि दर्ज: '] + त्रुटि, नई-पंक्ति.
}, चलाओ.


{
	a जब: ['बूलियन-में'] करो: { <- शून्य. }.
	a := सत्य और: a. 
} पकड़ो: { :त्रुटि
	निर्गम लिखो: ['त्रुटि दर्ज: '] + त्रुटि, नई-पंक्ति.
}, चलाओ.





{
	a जब: ['पाठ-में'] करो: { <- असत्य. }.
	a := [''] + a.
} पकड़ो: { :त्रुटि
	निर्गम लिखो: ['त्रुटि दर्ज: '] + त्रुटि, नई-पंक्ति.
}, चलाओ.



{
	a जब: ['संख्या-में'] करो: { <- सत्य. }.
	a := 3 × a.
} पकड़ो: { :त्रुटि
	निर्गम लिखो: ['त्रुटि दर्ज: '] + त्रुटि, नई-पंक्ति.
}, चलाओ.


{
	a जब: ['boolean'] करो: { <- 1. }.
	a := सत्य और: a.
} पकड़ो: { :त्रुटि
	निर्गम लिखो: ['त्रुटि दर्ज: '] + त्रुटि, नई-पंक्ति.
}, चलाओ.





{
	a जब: ['पाठ-में'] करो: { <- 1. }.
	a := [''] + a.
