{
	a जब: ['पाठ-में'] करो: { <- (शब्दकोश नया). }.
	a := [''] + a. 
} पकड़ो: { :त्रुटि
	निर्गम लिखो: ['त्रुटि दर्ज: '] + त्रुटि, नई-पंक्ति.
