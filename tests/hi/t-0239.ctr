सूची जब: ['sum'] करो: {
	>> total := 0.
	स्वयं प्रत्येक: { :index :element
		total जमा: element.
	}. <- total.
}.

>> a := सत्य.



a जब: ['पाठ-में'] करो: {
	>> answer := शून्य.
	( स्वयं = सत्य ) सत्य-हो-तो: {
		answer := ['Yep'].
	}, अन्यथा: {
		answer := ['Nope'].
	}. <- answer.
}.

a जब: ['संख्या-में'] करो: {
	>> answer := शून्य.
	( स्वयं = सत्य ) सत्य-हो-तो: {
		answer := 10.
	}, अन्यथा: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b जब: ['पाठ-में'] करो: { <- ['Devil'].
}.

b जब: ['बूलियन-में'] करो: { <- असत्य.
}.


निर्गम लिखो: a, नई-पंक्ति.  
निर्गम लिखो: (90 + a), नई-पंक्ति. 
निर्गम लिखो: b, नई-पंक्ति. 
निर्गम लिखो: (सत्य और: b), नई-पंक्ति.

a := सूची ← ['hello'] ; ['world'] ; सत्य ; शून्य ; 666. 
a := a + ( सूची ← 1 ).
निर्गम लिखो: a, नई-पंक्ति.
निर्गम लिखो: ((शब्दकोश नया) रखो: शून्य कुंजी: शून्य), नई-पंक्ति.
निर्गम लिखो: a sum, नई-पंक्ति. 


{
	a जब: ['पाठ-में'] करो: { <- शून्य. }.
	a := [''] + a.
} पकड़ो: { :error
	निर्गम लिखो: ['Error noted: '] + error, नई-पंक्ति.
}, चलाओ.



