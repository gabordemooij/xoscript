Server init.

निर्गम लिखो: (
	पैटर्न नया: ['^\\w+$'],
	मिलान: ['test@example.com'] 
), नई-पंक्ति. # 0 match, fails on @ and .

निर्गम लिखो: (
	पैटर्न नया: ['^[^@]+@[^\.]+\.\\w+$'],
	मिलान: ['test@example.com'] 
), नई-पंक्ति. # 1 match

निर्गम लिखो: (
	पैटर्न नया: ['[^@]+@[^\.]+\.\\w+'],
	मिलान: ['test@example.com'] 
), नई-पंक्ति. # 1 match

निर्गम लिखो: (
	पैटर्न नया: ['([^@]+)@([^\.]+)\.\\w+'],
	मिलान: ['test@example.com'] 
), नई-पंक्ति. # 1 match, groups dont matter

निर्गम लिखो: (
	पैटर्न नया: ['[a-z]'],
	मिलान: ['test@example.com'] 
), नई-पंक्ति. # 14 matches

निर्गम लिखो: (
	पैटर्न नया: ['.*'],
	मिलान: ['test@example.com'] 
), नई-पंक्ति. # 1 match (all)

निर्गम लिखो: (
	पैटर्न नया: ['(.*)'],
	मिलान: ['test@example.com'] 
), नई-पंक्ति. # 1 match (all)

निर्गम लिखो: (
	पैटर्न नया: ['\\s*[^@]+@[^\.]+\.\\w+'],
	मिलान: ['test@example.com'] 
), नई-पंक्ति. # 1 match, prefix space optional, gets ignored