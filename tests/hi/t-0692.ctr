Server init.

निर्गम लिखो: (
	पैटर्न नया: ['^\\w+$'],
	मिलान: ['test@example.com'] 
), नई-पंक्ति. # 0 मिलान, @ और . पर विफल

निर्गम लिखो: (
	पैटर्न नया: ['^[^@]+@[^\.]+\.\\w+$'],
	मिलान: ['test@example.com'] 
), नई-पंक्ति. # 1 मिलान

निर्गम लिखो: (
	पैटर्न नया: ['[^@]+@[^\.]+\.\\w+'],
	मिलान: ['test@example.com'] 
), नई-पंक्ति. # 1 मिलान

निर्गम लिखो: (
	पैटर्न नया: ['([^@]+)@([^\.]+)\.\\w+'],
	मिलान: ['test@example.com'] 
), नई-पंक्ति. # 1 मिलान, समूहों से फ़र्क नहीं पड़ता

निर्गम लिखो: (
	पैटर्न नया: ['[a-z]'],
	मिलान: ['test@example.com'] 
), नई-पंक्ति. # 14 मिलान

निर्गम लिखो: (
	पैटर्न नया: ['.*'],
	मिलान: ['test@example.com'] 
), नई-पंक्ति. # 1 मिलान (सब)

निर्गम लिखो: (
	पैटर्न नया: ['(.*)'],
	मिलान: ['test@example.com'] 
), नई-पंक्ति. # 1 मिलान (सब)

निर्गम लिखो: (
	पैटर्न नया: ['\\s*[^@]+@[^\.]+\.\\w+'],
	मिलान: ['test@example.com'] 
), नई-पंक्ति. # 1 मिलान, आगे का स्पेस वैकल्पिक, अनदेखा होता है