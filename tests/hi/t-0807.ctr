# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB नया होस्ट: ['localhost'],
	उपयोगकर्ता-नाम: ['xo'],
	पासवर्ड: ['pass123'],
	डेटाबेस-नाम: ['xobase'],
	जुड़ो.

>> खोज-पैरामीटर := db क्वेरी: ['SELECT %% FROM'].
{ खोज-पैरामीटर निष्पादन. } पकड़ो: { :e
	निर्गम लिखो: ( e शामिल-है: ['%%'] ), नई-पंक्ति.
}, चलाओ.
