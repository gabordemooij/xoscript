
पाठ जब: ['html'] करो: { <- (
		स्वयं
		बदलो: ['&'] से: ['&amp;'],
		बदलो: ['<'] से: ['&lt;'],
		बदलो: ['>'] से: ['&gt;'],
		बदलो: ['"'] से: ['&quot;']
	).
}.

>> HtmlBrush := वस्तु नया.

HtmlBrush जब: ['उत्तर:'] करो: { :tag
	निर्गम लिखो: (['<tag>↵'] tag: tag ).
}.

HtmlBrush जब: ['उत्तर:और:'] करो: { :tag :content
	tag := ( tag आरंभ: 0 लंबाई: (tag लंबाई - 1) ).
	निर्गम लिखो: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush जब: ['content:'] करो: { :text
	निर्गम लिखो: text html, नई-पंक्ति.
}.

HtmlBrush जब: ['attr:value:'] करो: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush नया.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
