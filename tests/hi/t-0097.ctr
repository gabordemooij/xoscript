
पाठ जब: ['html'] करो: { <- (
		स्वयं
		बदलो: ['&'] से: ['&amp;'],
		बदलो: ['<'] से: ['&lt;'],
		बदलो: ['>'] से: ['&gt;'],
		बदलो: ['"'] से: ['&quot;']
	).
}.

>> HTML-ब्रश := वस्तु नया.

HTML-ब्रश जब: ['उत्तर:'] करो: { :टैग
	निर्गम लिखो: (['<tag>↵'] tag: टैग ).
}.

HTML-ब्रश जब: ['उत्तर:और:'] करो: { :टैग :content
	टैग := ( टैग आरंभ: 0 लंबाई: (टैग लंबाई - 1) ).
	निर्गम लिखो: (['<tag content>↵'] tag: टैग, content: content).
}.

HTML-ब्रश जब: ['content:'] करो: { :लेख
	निर्गम लिखो: लेख html, नई-पंक्ति.
}.

HTML-ब्रश जब: ['विशेषता:मूल्य:'] करो: { :विशेषता :value <- ['attr="value"'] attr: विशेषता, value: value.
}.

>> h := HTML-ब्रश नया.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h विशेषता: ['class'] मूल्य: ['bold']),
		/span
	/body
/html.
		
