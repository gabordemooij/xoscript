>> makeAdder := { :x
	>> f := { :y <- (अपना x + y). } निर्धारित: ['x'] मान: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i अपना q रखो: (अपना f लागू: (अपना q ? i)) कुंजी: i. } 
	निर्धारित: ['q'] मान: array,
	निर्धारित: ['f'] मान: func.
	{ :i mapping लागू: i. } × (array गिनती).
}.

>> a := सूची ← 1; 2; 3.
mapper लागू: a और: (makeAdder लागू: 100).
निर्गम लिखो: (a स्थान: 0), नई-पंक्ति.
निर्गम लिखो: (a ? 1), नई-पंक्ति.
निर्गम लिखो: (a ? 2), नई-पंक्ति.
