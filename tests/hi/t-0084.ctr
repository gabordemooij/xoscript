>> योजक-बनाओ := { :x
	>> f := { :y <- (अपना x + y). } निर्धारित: ['x'] मान: x. <- f.
}.
>> मानचित्रक := { :सरणी :फ़ंक
	>> प्रतिचित्रण := { :i अपना q रखो: (अपना f लागू: (अपना q ? i)) कुंजी: i. } 
	निर्धारित: ['q'] मान: सरणी,
	निर्धारित: ['f'] मान: फ़ंक.
	{ :i प्रतिचित्रण लागू: i. } × (सरणी गिनती).
}.

>> a := सूची ← 1; 2; 3.
मानचित्रक लागू: a और: (योजक-बनाओ लागू: 100).
निर्गम लिखो: (a स्थान: 0), नई-पंक्ति.
निर्गम लिखो: (a ? 1), नई-पंक्ति.
निर्गम लिखो: (a ? 2), नई-पंक्ति.
