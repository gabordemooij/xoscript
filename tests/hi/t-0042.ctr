>> items := शब्दकोश नया.
items रखो: ['black'] कुंजी: ['coffee'], रखो: ['earl grey'] कुंजी: ['tea'].
निर्गम लिखो: (items पर: ['coffee']), लिखो: (items पर: ['tea']).
निर्गम लिखो: ['there are'] + items गिनती + [' items in the array.'].
items रखो: ['capuccino'] कुंजी: ['coffee'].
निर्गम लिखो: ['Now my coffee is.. '] + (items पर: ['coffee']).
items रखो: ['aaa'] कुंजी: ['1'].
items रखो: ['bbb'] कुंजी: ['2'].
निर्गम लिखो: (items पर: ['a']).
