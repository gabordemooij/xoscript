Server init.

>> DB := Maria-DB नया होस्ट: ['localhost'],
	उपयोगकर्ता-नाम: ['xo'],
	पासवर्ड: ['pass123'],
	डेटाबेस-नाम: ['xobase'],
	जुड़ो.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> खोज-पैरामीटर := Maria-क्वेरी नया: SQL.

# set database
खोज-पैरामीटर डेटाबेस: DB.

खोज-पैरामीटर लाओ: { :row
	निर्गम लिखो: row world, नई-पंक्ति.
}.
