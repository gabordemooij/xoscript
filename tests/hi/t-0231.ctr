>> सुड़क := वस्तु नया.

सुड़क जब: ['नया'] करो: {
	अपना str := [''].
}.


सुड़क जब: ['उत्तर:'] करो: { :blah
		(अपना str = ['']) सत्य-हो-तो: {
			अपना str अंत-में-जोड़ो: blah.
		}, अन्यथा: {
			अपना str अंत-में-जोड़ो: [' '].
			अपना str अंत-में-जोड़ो: blah.
		}.
}.

सुड़क जब: ['उत्तर:और:'] करो: { :blah :blahah
		अपना str अंत-में-जोड़ो: (blah आरंभ: 0 लंबाई: (blah लंबाई - 1)).
		अपना str अंत-में-जोड़ो: [' '].
		अपना str अंत-में-जोड़ो: blahah.
}.

सुड़क जब: ['प्राप्त-करो'] करो: {
	>> बफ़र := अपना str.
	अपना str := ['']. <- बफ़र.
}.


सुड़क नया hello world.
निर्गम लिखो: (सुड़क प्राप्त-करो), नई-पंक्ति. 
निर्गम लिखो: (सुड़क प्राप्त-करो), नई-पंक्ति. 
सुड़क hello world.
>> x := सुड़क नया.
निर्गम लिखो: (x प्राप्त-करो), नई-पंक्ति. 
x हाय there.
निर्गम लिखो: (x प्राप्त-करो), नई-पंक्ति. 
