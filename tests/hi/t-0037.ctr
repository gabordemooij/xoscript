>> a := 3.
>> b := a प्रतिलिपि.
a घटाओ: 1.
निर्गम लिखो: [' a = '] + a.
निर्गम लिखो: [' b = '] + b.
a := 3.
b := a + 4.
निर्गम लिखो: [' a = '] + a.
निर्गम लिखो: [' b = '] + b.
>> x := 3.
>> y := x प्रतिलिपि.
x जमा: 10.
y घटाओ: 1.
निर्गम लिखो: [' x = '] + x.
निर्गम लिखो: [' y = '] + y.
>> q := वस्तु नया.
q जब: ['setProperty:'] करो: { :x
	अपना गुण := x.
}.
q जब: ['गुण-लाओ'] करो: { <- अपना गुण.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
निर्गम लिखो: [' p = '] + (p गुण-लाओ).
