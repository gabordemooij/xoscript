# test url parsing

Server init.
>> url := URL से: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

निर्गम लिखो: ['scheme = '] + url योजना, नई-पंक्ति.
निर्गम लिखो: ['host = '] + url होस्ट, नई-पंक्ति.
निर्गम लिखो: ['port = '] + url पोर्ट, नई-पंक्ति.
निर्गम लिखो: ['path = '] + url फ़ाइल-पथ, नई-पंक्ति.
निर्गम लिखो: ['query = '] + url खोज-पैरामीटर, नई-पंक्ति.
निर्गम लिखो: ['fragment = '] + url खंड, नई-पंक्ति.
