

Ndepụta mgbe-ọbịara: ['fixture:'] mee: { :f
	nke-ya fixture := f.
}.

Ndepụta mgbe-ọbịara: ['ọnụ-ọgụgụ'] mee: { <- nke-ya fixture.
}.

Ndepụta mgbe-ọbịara: ['aantal'] mee: { <- nke-ya fixture.
}.


>> x := Efu.
{

	x := ['hello'] 
	dochie:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] mkpụrụedemede: 2)
			)
		)
	na: (
		(['...hal'] + ['lo']) 
			mkpụrụ-ukwu 
			lowecase 
			mkpụrụ-ukwu 
			mafee: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Ndepụta ← 0 ; 1 ; 4; 9 ; (Ndepụta ← 0 ; 3; 1) ; 4
							) tupu-nke-ikpeazụ
						) ? 1
					) + 
					((Ndepụta ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					ọnụ-ọgụgụ
				)
			)
	).

} × 10.
Mpụta dee: x, ahịrị-ọhụrụ.

