#Linux
>> Slurp := Ihe ohuru.

Slurp mgbe-ọbịara: ['ohuru'] mee: {
	nke-ya str := [''].
}.

Slurp mgbe-ọbịara: ['nieuw'] mee: {
	nke-ya str := [''].
}.

Slurp mgbe-ọbịara: ['zaghachi:'] mee: { :blah
		nke-ya str tinye-na-njedebe: blah.
}.

Slurp mgbe-ọbịara: ['zaghachi:na:'] mee: { :blah :blahah
		nke-ya str tinye-na-njedebe: (blah site-na: 0 ogologo: (blah ogologo - 1)).
		nke-ya str tinye-na-njedebe: [' '].
		nke-ya str tinye-na-njedebe: blahah.
}.

Slurp mgbe-ọbịara: ['obtain'] mee: {
	>> buffer := nke-ya str.
	nke-ya str := ['']. <- buffer.
}.


Mpụta dee: (Mmemme sistemụ: (Slurp ohuru echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Faịlụ ohuru: ['/tmp/from.txt'], hichapụ. } jide: { ['Empty']. }, bido.
{ Faịlụ ohuru: ['/tmp/to.txt'], hichapụ. } jide: { ['Empty']. }, bido.


Faịlụ ohuru: ['/tmp/to.txt'], dị ụgha: {
	Mpụta dee: ['Confirmed. Target file does not exist.\
'].
}.
Faịlụ ohuru: ['/tmp/from.txt'], dị ụgha: {
	Mpụta dee: ['Confirmed. Source file does not exist.\
'].
}.



Mmemme sistemụ: (Slurp ohuru touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Mmemme sistemụ: (Slurp ohuru cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Faịlụ ohuru: ['/tmp/to.txt'], dị eziokwu: {
	Mpụta dee: ['Confirmed. Target file has been created by shell.\
'].
}.


Mpụta dee: ['Contents of file is:'] + (Faịlụ ohuru: ['/tmp/to.txt'], gụọ), ahịrị-ọhụrụ.
