


>> Deck := Ndepụta ohuru.
Deck mgbe-ọbịara: ['print'] mee: {
        >> len := onwe ọnụ-ọgụgụ - 1.
        { :i
                >> len2 := onwe ọnụ-ọgụgụ - 1.
                Mpụta dee: ['len: '].
                Mpụta dee: len, ahịrị-ọhụrụ.
                Mpụta dee: ['len2: '].
                Mpụta dee: len2, ahịrị-ọhụrụ.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
