

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Mmemme njikwa-ebe-nchekwa: 0.

>> f := Faịlụ ohuru: ['/tmp/citrine_test_file.txt'].
f exists: { f hichapụ. }.
f dee: ['hello world'].
>> q := f ụzọ-faịlụ.

f := Faịlụ ohuru: ['/tmp/citrine_test_file.txt'].
q := f ụzọ-faịlụ.

Mmemme hichaa.
usedMemory1 := (Mmemme ebe-nchekwa ? 0).


f := Faịlụ ohuru: ['/tmp/citrine_test_file.txt'].
q := f ụzọ-faịlụ.

Mmemme hichaa.
usedMemory2 := (Mmemme ebe-nchekwa ? 0).


f := Faịlụ ohuru: ['/tmp/citrine_test_file.txt'].
q := f ụzọ-faịlụ.

Mmemme hichaa.
usedMemory3 := (Mmemme ebe-nchekwa ? 0).



( usedMemory1 = usedMemory2 na: usedMemory1 = usedMemory3, na: usedMemory2 = usedMemory3 ) eziokwu: {
