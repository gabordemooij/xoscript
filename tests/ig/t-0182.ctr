

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Mmemme njikwa-ebe-nchekwa: 0.

>> txt := ['1.6'].
>> n := txt nọmba.
>> t := txt boolean.
Mpụta dee: n, ahịrị-ọhụrụ.
Mpụta dee: t, ahịrị-ọhụrụ.
Mpụta dee: n ụdị, ahịrị-ọhụrụ.
Mpụta dee: t ụdị, ahịrị-ọhụrụ.

Mmemme hichaa.

usedMemory1 := (Mmemme ebe-nchekwa ? 0).


