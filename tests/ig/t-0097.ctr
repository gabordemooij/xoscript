
Ederede mgbe-ọbịara: ['html'] mee: { <- (
		onwe
		dochie: ['&'] na: ['&amp;'],
		dochie: ['<'] na: ['&lt;'],
		dochie: ['>'] na: ['&gt;'],
		dochie: ['"'] na: ['&quot;']
	).
}.

>> HtmlBrush := Ihe ohuru.

HtmlBrush mgbe-ọbịara: ['zaghachi:'] mee: { :tag
	Mpụta dee: (['<tag>↵'] tag: tag ).
}.

HtmlBrush mgbe-ọbịara: ['zaghachi:na:'] mee: { :tag :content
	tag := ( tag site-na: 0 ogologo: (tag ogologo - 1) ).
	Mpụta dee: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush mgbe-ọbịara: ['content:'] mee: { :text
	Mpụta dee: text html, ahịrị-ọhụrụ.
}.

HtmlBrush mgbe-ọbịara: ['attr:value:'] mee: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush ohuru.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
