{
	ọrụ-a njehie: ['Dont fail.'].
	unknown doSomething.
} jide: {
	Mpụta dee: ['Caught!'].
}, bido.

{
	ọrụ-a njehie: ['Dont fail.'].
	nke-ya unknown doSomething.
} jide: {
	Mpụta dee: ['Caught!'].
}, bido.

{
	ọrụ-a njehie: ['Dont fail.'].
	unknown := 122.
} jide: {
	Mpụta dee: ['Caught!'].
}, bido.


{
	ọrụ-a njehie: ['Dont fail.'].
	Eziokwu kwụsịtụ.
	Mpụta dee: ['FAIL'].
} jide: {
	Mpụta dee: ['Caught!'].
}, bido.

{
	{
		ọrụ-a njehie: ['Dont fail.'].
		Eziokwu kwụsịtụ.
		Mpụta dee: ['FAIL'].
	} jide: { :x
		(x = ['Dont fail.']) eziokwu: { ọrụ-a njehie: ['Nested Caught!']. }.
	}, bido.
} jide: { :e
	Mpụta dee: e.
}, bido.
