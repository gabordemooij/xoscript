>> items := Akwụkwọ-okwu ohuru.
items tinye: ['black'] na: ['coffee'], tinye: ['earl grey'] na: ['tea'].
Mpụta dee: (items ebe: ['coffee']), dee: (items ebe: ['tea']).
Mpụta dee: ['there are'] + items ọnụ-ọgụgụ + [' items in the array.'].
items tinye: ['capuccino'] na: ['coffee'].
Mpụta dee: ['Now my coffee is.. '] + (items ebe: ['coffee']).
items tinye: ['aaa'] na: ['1'].
items tinye: ['bbb'] na: ['2'].
Mpụta dee: (items ebe: ['a']).
