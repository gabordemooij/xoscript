>> randomizer := { :a :b
	>> nke-kacha-nta := ( a < b ) nke-a: a ma-ọ-bụ-nke-ahụ: b.
	>> nke-kacha-ukwuu := ( a > b ) nke-a: a ma-ọ-bụ-nke-ahụ: b.
	>> x := Efu.
	{
		x := Nọmba netiti: a ruo: b.
		((x < nke-kacha-nta) ma-ọ-bụ: (x > nke-kacha-ukwuu)) eziokwu: { 
			Mpụta dee: (['Invalid value!']).
			Mmemme njedebe.
		}.
	} 
	× 100. <- x.
}.
randomizer tinye-nọrụ: 0 na: 0.
