Mpụta dee: ['Test object'], ahịrị-ọhụrụ.
>> a := Ihe ohuru. 

a mgbe-ọbịara: ['item:'] mee: { :out
	nke-ya out := out. 
}.

a mgbe-ọbịara: ['item'] mee: { <- nke-ya out.
}.

a mgbe-ọbịara: ['greet'] mee: {
	Mpụta dee: ['hi from original out!'], ahịrị-ọhụrụ.
}.

a item: Mpụta.

Mpụta dee: a item, ahịrị-ọhụrụ.

>> old-out-address := a item ihe-nlereanya adreesị-ebe-nchekwa.
a save-as: ['/tmp/a.bin'].
Mpụta dee: ['========== RELOADING SNAP:'], ahịrị-ọhụrụ.

>> b := Ihe load-from: ['/tmp/a.bin'].

(b item ihe-nlereanya adreesị-ebe-nchekwa = old-out-address) eziokwu: {
	Mpụta dee: ['Object link re-attached.'], ahịrị-ọhụrụ.
}.

b item dee: ['hello from loaded out!'], ahịrị-ọhụrụ.
b greet.
