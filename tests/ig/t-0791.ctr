Server init.

>> DB := Maria-DB ohuru onye-nnabata: ['localhost'],
	aha-onye-ọrụ: ['xo'],
	okwuntughe: ['pass123'],
	aha-nchekwa-data: ['xobase'],
	jikọta.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> ihe-ọchụchọ := Ajụjụ-Maria ohuru: SQL.

# set database
ihe-ọchụchọ nchekwa-data: DB.

ihe-ọchụchọ weta: { :row
	Mpụta dee: row world, ahịrị-ọhụrụ.
}.
