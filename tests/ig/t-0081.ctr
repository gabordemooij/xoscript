>> map1 := Akwụkwọ-okwu ohuru.
>> key1 := Ndepụta ohuru.
>> key2 := Ndepụta ohuru.

map1
	tinye: ['hello'] na: key1,
	tinye: ['world'] na: key2.


Mpụta
	dee: ['Map #1 contains: '] + (map1 ebe: key1),
	dee: [' and '] + (map1 ebe: key2), ahịrị-ọhụrụ.

>> KeyeableArray := Ndepụta ohuru.
KeyeableArray mgbe-ọbịara: ['toString'] mee: { <- (onwe ọnụ-ọgụgụ) toString.
}.

>> map2 := Akwụkwọ-okwu ohuru.
key1 := KeyeableArray ohuru.
key2 := KeyeableArray ohuru.

key1 tinye-na-njedebe: 1.

map2
	tinye: ['hello'] na: key1,
	tinye: ['world'] na: key2.

Mpụta
	dee: ['Map #2 contains: '] + (map2 ebe: key1),
	dee: [' and '] + (map2 ebe: key2), ahịrị-ọhụrụ.
