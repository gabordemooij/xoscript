
>> city := Ndepụta ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Ndepụta ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature site-na: city.
>> cities := weather igodo-niile hazie: { :a :b <- (a tulee: b). }.
>> temperatures := weather uru-niile hazie: { :a :b <- (a tulee: b) erughị-efu?. }.

Mpụta dee: (cities jikọọ: [',']), ahịrị-ọhụrụ.
Mpụta dee: (temperatures jikọọ: [',']), ahịrị-ọhụrụ.
