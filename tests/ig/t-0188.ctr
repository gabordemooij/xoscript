

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Mmemme njikwa-ebe-nchekwa: 0.

{ :i Mpụta dee: i. } × 4.
Mpụta ahịrị-ọhụrụ.
{ :i Mpụta dee: (4 - i). } × 4.
Mpụta ahịrị-ọhụrụ.
( 1 > 2 ) ụgha: { Mpụta dee: ['BLOCK 1'], ahịrị-ọhụrụ. }.
( 2 > 1 ) eziokwu:  { Mpụta dee: ['BLOCK 2'], ahịrị-ọhụrụ. }.

>> i := 0.
{ Mpụta dee: i. i gbakwunye: 1. } ka-ọ-dị: { <- ( i < 3). }.
Mpụta ahịrị-ọhụrụ.

i := 3.
{ Mpụta dee: i. i := i - 1. } ka-ọ-dị: { <- ( i > 0). }.
Mpụta ahịrị-ọhụrụ.


Mmemme hichaa.

usedMemory1 := (Mmemme ebe-nchekwa ? 0).


{ :i  Mpụta dee: i. } × 4.
Mpụta ahịrị-ọhụrụ.
{ :i  Mpụta dee: (4 - i). } × 4.
Mpụta ahịrị-ọhụrụ.
( 1 > 2 ) ụgha: { Mpụta dee: ['BLOCK 1'], ahịrị-ọhụrụ. }.
( 2 > 1 ) eziokwu:  { Mpụta dee: ['BLOCK 2'], ahịrị-ọhụrụ. }.

>> i := 0.
{ Mpụta dee: i. i gbakwunye: 1. } ka-ọ-dị: { <- ( i < 3). }.
Mpụta ahịrị-ọhụrụ.

i := 3.
{ Mpụta dee: i. i := i - 1. } ka-ọ-dị: { <- ( i > 0). }.
Mpụta ahịrị-ọhụrụ.



Mmemme hichaa.
usedMemory2 := (Mmemme ebe-nchekwa ? 0).


{ :i Mpụta dee: i. } × 4.
Mpụta ahịrị-ọhụrụ.
{ :i Mpụta dee: (4 - i). } × 4.
Mpụta ahịrị-ọhụrụ.
( 1 > 2 ) ụgha: { Mpụta dee: ['BLOCK 1'], ahịrị-ọhụrụ. }.
( 2 > 1 ) eziokwu:  { Mpụta dee: ['BLOCK 2'], ahịrị-ọhụrụ. }.

>> i := 0.
{ Mpụta dee: i. i gbakwunye: 1. } ka-ọ-dị: { <- ( i < 3). }.
Mpụta ahịrị-ọhụrụ.

i := 3.
{ Mpụta dee: i. i := i - 1. } ka-ọ-dị: { <- ( i > 0). }.
Mpụta ahịrị-ọhụrụ.

Mmemme hichaa.
usedMemory3 := (Mmemme ebe-nchekwa ? 0).



( usedMemory1 = usedMemory2 na: usedMemory1 = usedMemory3, na: usedMemory2 = usedMemory3 ) eziokwu: {
	Mpụta dee: ['No memory leaks here'].
}, ụgha: {
	Mpụta dee: ['Leaking memory...'].
}.
