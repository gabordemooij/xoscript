Mmemme njikwa-ebe-nchekwa: 0.
Ndepụta mgbe-ọbịara: ['sum'] mee: {
	>> total := 0.
	onwe nke-ọ-bụla: { :index :element
		total gbakwunye: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Faịlụ ohuru: ['/tmp/test.txt'].
f dee: ['Lorem Ipsum'].
f mechie.
  

f := Faịlụ ohuru: ['/tmp/test.txt'].
>> text := f gụọ.
f mechie.



Mmemme hichaa.
usedMemory1 := (Mmemme ebe-nchekwa ? 1).



f := Faịlụ ohuru: ['/tmp/test.txt'].
text := f gụọ.
f mechie.

Mmemme hichaa.
usedMemory2 := (Mmemme ebe-nchekwa ? 1).


f := Faịlụ ohuru: ['/tmp/test.txt'].
text := f gụọ.
f mechie.

Mmemme hichaa.
usedMemory3 := (Mmemme ebe-nchekwa ? 1).



( usedMemory1 = usedMemory2 na: usedMemory1 = usedMemory3, na: usedMemory2 = usedMemory3 ) eziokwu: {
	Mpụta dee: ['No memory leaks here'].
}, ụgha: {
	Mpụta dee: ['Leaking memory...'].
}.
