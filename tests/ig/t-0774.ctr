Mpụta dee: ['Test object'], ahịrị-ọhụrụ.
>> a := Ihe ohuru. 
a mgbe-ọbịara: ['item:'] mee: { :lst
	nke-ya lst := lst. 
}.
a mgbe-ọbịara: ['item'] mee: { <- nke-ya lst.
}.
a item: (
	Ndepụta ohuru ; 1 ; (
		Ndepụta ohuru ; ['a'] ; (
			Ndepụta ohuru ; ( Oge ohuru: 1 )
		) ; ( Int64 site-na-ederede: ['321'] )
	)
).
Mpụta dee: a item, ahịrị-ọhụrụ.
>> old-lst-address := a item ihe-nlereanya adreesị-ebe-nchekwa.
a save-as: ['/tmp/a.bin'].
Mpụta dee: ['========== RELOADING SNAP:'], ahịrị-ọhụrụ.
>> b := Ihe load-from: ['/tmp/a.bin'].
(b item ihe-nlereanya adreesị-ebe-nchekwa = old-lst-address) eziokwu: {
	Mpụta dee: ['Object link re-attached.'], ahịrị-ọhụrụ.
}.
Mpụta dee: ( b item ), ahịrị-ọhụrụ.
