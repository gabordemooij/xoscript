Server init.

>> DB := Maria-DB ohuru onye-nnabata: ['localhost'],
	aha-onye-ọrụ: ['xo'],
	okwuntughe: ['pass123'],
	aha-nchekwa-data: ['xobase'],
	jikọta.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB ajụjụ: SQL.

# now you don't have to set DB
query2 weta: { :row
	Mpụta dee: row world, ahịrị-ọhụrụ.
}.
