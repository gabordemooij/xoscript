Mpụta dee: ['Test object'], ahịrị-ọhụrụ.
>> a := Ihe ohuru. 

a mgbe-ọbịara: ['item:'] mee: { :moment
	nke-ya moment := moment. 
}.

a mgbe-ọbịara: ['item'] mee: { <- nke-ya moment.
}.

>> today := Oge ohuru mpaghara: ['CEST'], afọ: 2026, ọnwa: 7.
a item: today.
Mpụta dee: a item, ahịrị-ọhụrụ.
a save-as: ['/tmp/a.bin'].

