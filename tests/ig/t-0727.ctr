Server init.
>> f := Usoro-ọdịdị ohuru: ['%d'].
>> a := Blob ohuru: 4.
a bytes: ( Ndepụta ohuru ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob ohuru: 4.
b bytes: ( Ndepụta ohuru ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a site-na: 0 ogologo: 3, nke-ọ-bụla: { :i :byte
	Mpụta dee: ( f tinye-nọrụ-ọnụọgụ-zuru: byte ), ahịrị-ọhụrụ.
}.
a ^ b.
a site-na: 0 ogologo: 3, nke-ọ-bụla: { :i :byte
	Mpụta dee: ( f tinye-nọrụ-ọnụọgụ-zuru: byte ), ahịrị-ọhụrụ.
}.
a ^ b.
a site-na: 0 ogologo: 3, nke-ọ-bụla: { :i :byte
	Mpụta dee: ( f tinye-nọrụ-ọnụọgụ-zuru: byte ), ahịrị-ọhụrụ.
}.
a hapụ.
b hapụ.

{ a ^ Ihe. } jide: { :e Mpụta dee: e, ahịrị-ọhụrụ. }, bido.
