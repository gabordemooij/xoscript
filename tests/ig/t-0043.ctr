>> repeater := Ihe ohuru.
repeater mgbe-ọbịara: ['zaghachi:'] mee: { :what
	Mpụta dee: what + [' '].
}.
repeater mgbe-ọbịara: ['zaghachi:na:'] mee: { :what :say
	Mpụta dee: what, dee: say + [' '].
}.
repeater mgbe-ọbịara: ['zaghachi:na:na:'] mee: { :what :say :more
	Mpụta dee: what, dee: say, dee: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
