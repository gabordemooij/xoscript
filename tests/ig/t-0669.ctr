# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Igbe-nchekwa 
	hash-okwuntughe: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Igbe-nchekwa 
	hash-okwuntughe: hash nyochaa: a1.
	# fail 
>> b := Igbe-nchekwa
	hash-okwuntughe: hash nyochaa: a2.
	# ok!

Mpụta dee: a, ahịrị-ọhụrụ.
Mpụta dee: b, ahịrị-ọhụrụ.

