Mmemme njikwa-ebe-nchekwa: 0.

>> txt := ['World Salad'].
Mpụta dee: ['this text contains: '] + ( ( txt kewaa: [' '] ) ọnụ-ọgụgụ ) + [' words.'], ahịrị-ọhụrụ.
