Mpụta dee: ['Continue for-loop, No - before 6 and up.'], ahịrị-ọhụrụ.
{ :i
	Mpụta dee: (i + 1), ahịrị-ọhụrụ.
	((i + 1) > 4) gaa-nihu.
	Mpụta dee: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Mpụta ahịrị-ọhụrụ.
Mpụta dee: ['Continue while-true, No --> before 5 and up.'], ahịrị-ọhụrụ.
{
	Mpụta dee: ['iteration #'] + x, ahịrị-ọhụrụ.
	x gbakwunye: 1.
	((x < 5) ọ-bụghị) gaa-nihu.
	Mpụta dee: ['-->'].
} ka-ọ-dị: xIsLessThan10.
Mpụta ahịrị-ọhụrụ.
Mpụta dee: ['Continue while-false, No - before 3 only.'], ahịrị-ọhụrụ.
{
	Mpụta dee: ['iteration #'] + x, ahịrị-ọhụrụ.
	x wepụ: 1.
	(x = 3) gaa-nihu.
	Mpụta dee: ['-'].
} ka-ọ-dị: { <- ( x > 0). }.

Mpụta ahịrị-ọhụrụ.
Mpụta dee: ['Continue times-loop, No ||| before 3.'], ahịrị-ọhụrụ.
{ :i
	Mpụta dee: ['iteration #'] + i, ahịrị-ọhụrụ.
	(i = 2) gaa-nihu.
	Mpụta dee: ['|||'].
} × 5.

Mpụta ahịrị-ọhụrụ.

{ Eziokwu gaa-nihu. Mpụta dee: ['dont write this!'], ahịrị-ọhụrụ. } bido.

{ Eziokwu gaa-nihu. Mpụta dee: ['dont write this!'], ahịrị-ọhụrụ. } jide: { Mpụta dee: ['Dont catch this!']. }, bido.

Mpụta dee: ['Test Array each-loop: 0, ... ,2'], ahịrị-ọhụrụ.
(Ndepụta ← 1 ; 2 ; 3) gbanwee-nke-ọbụla: { :i
	(i = 1) gaa-nihu.
	Mpụta dee: ['iteration #'] + (i - 0), ahịrị-ọhụrụ.
}.

Mpụta dee: ['Test Map each-loop: c only'], ahịrị-ọhụrụ.
>> m := Akwụkwọ-okwu ohuru.
m tinye: ['first'] na: ['a'], tinye: ['second'] na: ['b'], tinye: ['third'] na: ['c'].
m nke-ọ-bụla: { :k :v
	(k ≠ ['c']) gaa-nihu.
	Mpụta dee: ['iteration'] + k + v, ahịrị-ọhụrụ.
}.

