>> Animal := Ihe ohuru.
>> Factory := Ihe ohuru.

Animal mgbe-ọbịara: ['ohuru'] mee: {
	>> animal := onwe ohuru.
	animal sound: ['?']. <- animal.
}.

Animal mgbe-ọbịara: ['sound:'] mee: { :s
	nke-ya sound := s.
}.

Animal mgbe-ọbịara: ['sound'] mee: { <- nke-ya sound.
}.

>> Dog := Ihe ohuru.
>> Cat := Ihe ohuru.

Dog mgbe-ọbịara: ['ohuru'] mee: { <- Animal ohuru sound: ['woof!'].
}.

Cat mgbe-ọbịara: ['ohuru'] mee: { <- Animal ohuru sound: ['meow!'].
}.

Mpụta dee: Dog ohuru sound, ahịrị-ọhụrụ.
Mpụta dee: Cat ohuru sound, ahịrị-ọhụrụ.

Factory mgbe-ọbịara: ['mix:and:'] mee: { :beast1 :beast2 <- Animal ohuru sound: (
		( beast1 sound site-na: 0 ogologo: 2 ) +
		( beast2 sound site-na: 2 ogologo: 5 )
	).
}.

Mpụta dee: (Factory mix: Dog ohuru and: Cat ohuru) sound, ahịrị-ọhụrụ.
