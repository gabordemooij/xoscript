# tccompare must also compare the length of both strings
Mpụta dee: (['secret'] tccompare: ['']), ahịrị-ọhụrụ.
Mpụta dee: ([''] tccompare: ['secret']), ahịrị-ọhụrụ.
Mpụta dee: (['secret'] tccompare: ['sec']), ahịrị-ọhụrụ.
Mpụta dee: (['sec'] tccompare: ['secret']), ahịrị-ọhụrụ.
Mpụta dee: (['secret'] tccompare: ['secret']), ahịrị-ọhụrụ.
Mpụta dee: ([''] tccompare: ['']), ahịrị-ọhụrụ.
