Boolean mgbe-ọbịara: ['xor:'] mee: { :a :b <- ((a na: b ọ-bụghị) ma-ọ-bụ: (a ọ-bụghị na: b)).
}.

>> o := Ihe ohuru.
o mgbe-ọbịara: ['hello'] mee: { ['Empty']. }.
{ o mgbe-ọbịara: 2 mee: 3.} jide: { :e Mpụta dee: e, ahịrị-ọhụrụ. }, bido.
{ o mgbe-ọbịara: ['nnwale'] mee: 3.} jide: { :e Mpụta dee: e, ahịrị-ọhụrụ. }, bido.
{ o mgbe-ọbịara: ['hello'] mee: { ['Empty']. }.} jide: { :e Mpụta dee: e, ahịrị-ọhụrụ. }, bido. 
{ >> z := 4 ÷ 0. } jide: { :e Mpụta dee: e, ahịrị-ọhụrụ. }, bido. 
{ (Eziokwu na: Efu) eziokwu: { Mpụta dee: ['X'].}. } jide: { :e Mpụta dee: e, ahịrị-ọhụrụ. }, bido. 
{ ([''] xor: 0) eziokwu: { Mpụta dee: ['X'].}. } jide: { :e Mpụta dee: e, ahịrị-ọhụrụ. }, bido. 
{ (1 < ['2']) eziokwu: { Mpụta dee: ['OK']. }. } jide: { :e Mpụta dee: e, ahịrị-ọhụrụ. }, bido. 
{ (1 < ['2.0']) eziokwu: { Mpụta dee: ['OK']. }. } jide: { :e Mpụta dee: e, ahịrị-ọhụrụ. }, bido. 
{ (1 < ['x2.0']) eziokwu: { Mpụta dee: ['NO!']. }. } jide: { :e Mpụta dee: e, ahịrị-ọhụrụ. }, bido. 
{ Mpụta dee: (['hello OK there'] site-na: ['6'] ogologo: ['2']). } bido. 
