#Linux
>> OS := Mmemme ntọala: ['OS'].

>> clock := Oge ohuru.
	
(OS = ['Haiku']) eziokwu: {
	clock mpaghara: ['CET'],
	afọ: 2017, ọnwa: 7, ụbọchị: 13,
	elekere: 18, nkeji: 0, sekọnd: 0.
}, ma-ọ-bụghị-ya: {
	clock mpaghara: ['Europe/Amsterdam'],
	afọ: 2017, ọnwa: 7, ụbọchị: 13,
	elekere: 18, nkeji: 0, sekọnd: 0.
}.

clock mgbe-ọbịara: ['tell'] mee: {
	Mpụta dee: onwe, ahịrị-ọhụrụ.
}.


clock gbakwunye: 2    elekere, tell.
clock gbakwunye: 1    elekere, tell.
clock gbakwunye: 19 nkeji, tell.
clock gbakwunye: 1  nkeji, tell.
clock gbakwunye: 1  nkeji, tell.
clock gbakwunye: 19 sekọnd, tell.
clock gbakwunye: 1  sekọnd, tell.
clock gbakwunye: 1  sekọnd, tell.
clock gbakwunye: 2    afọ, tell.
clock gbakwunye: 1    afọ, tell.

(OS = ['Haiku']) eziokwu: {
clock gbakwunye: 5   ọnwa.
clock mpaghara: ['CEST'], tell.
}, ma-ọ-bụghị-ya: {
	clock gbakwunye: 5   ọnwa, tell.
}.

clock gbakwunye: 1   ọnwa, tell.
clock gbakwunye: 19    ụbọchị, tell.
clock gbakwunye: 1    elekere, tell.
clock gbakwunye: 120  yard, tell.
