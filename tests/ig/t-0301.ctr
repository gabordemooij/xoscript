


>> wine := Ihe ohuru.


wine mgbe-ọbịara: ['toString'] mee: { <- ['merlot'].
}.

wine mgbe-ọbịara: ['naarTekst'] mee: { <- ['merlot'].
}.


wine mgbe-ọbịara: ['='] mee: { :other wine <- ( onwe toString = other wine ).
}.

wine mgbe-ọbịara: ['=='] mee: { :other wine <- ( onwe toString = other wine ).
}.



wine
	ọ-bụrụ: ['cabernet'] mee: { Mpụta dee: ['it's a Cabernet!']. },
	ọ-bụrụ: ['syrah']    mee: { Mpụta dee: ['it's a Syrah!'].    },
	ọ-bụrụ: ['merlot']   mee: { Mpụta dee: ['it's a Merlot!'].   },
	ọ-bụrụ: ['malbec']   mee: { Mpụta dee: ['it's a Malbec!'].   }.

Mpụta ahịrị-ọhụrụ.
