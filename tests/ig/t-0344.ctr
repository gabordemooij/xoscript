# catch-all test (practical)
>> HTML := Ederede ohuru.
HTML mgbe-ọbịara: ['encode:'] mee: { :tekst
	onwe tinye-na-njedebe: (tekst
	dochie: ['&'] na: ['&amp;'], 
	dochie: ['<'] na: ['&lt;'],
	dochie: ['>'] na: ['&gt;'],
	dochie: ['"'] na: ['&quot;']).
}.
>> blog := HTML ohuru.
blog tinye-na-njedebe: ['<h1>'],
     encode: ['Koffie & Thee'],
     tinye-na-njedebe: ['</h1>'].
Mpụta dee: blog, ahịrị-ọhụrụ.


>> Roman := Nọmba ohuru.
Roman mgbe-ọbịara: ['stringy'] mee: {
	>> a := [''].
	{ a tinye-na-njedebe: ['I']. } × onwe. <- a.
}.

>> x := Roman ohuru.
x gbakwunye: 3.
Mpụta dee: x stringy, ahịrị-ọhụrụ.

>> Quantum := Boolean ohuru.
Quantum mgbe-ọbịara: ['true?'] mee: { <- ['maybe True']. }.
Mpụta dee: (Quantum ohuru true?), ahịrị-ọhụrụ.

>> Nihil := Efu ohuru.
Nihil mgbe-ọbịara: ['ederede'] mee: { <- ['Nihil']. }.
Mpụta dee: (Nihil ohuru), ahịrị-ọhụrụ.
