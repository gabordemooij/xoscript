

Ndepụta mgbe-ọbịara: ['column:'] mee: { :column
	>> result := Ndepụta ohuru.
	onwe nke-ọ-bụla: { :index :row
		row nke-ọ-bụla: { :index :cell
			(index = column) eziokwu: { result tinye-na-njedebe: cell. }.
		}.
	}. <- result.
}.


>> a := Ndepụta ←
	(Ndepụta ← 1 ; 2 ; 3) ;
	(Ndepụta ← 4 ; 5 ; 6) ;
	(Ndepụta ← 7 ; 8 ; 9).

>> b := a column: 1.
Mpụta dee: b, ahịrị-ọhụrụ.

b := a column: 20.
Mpụta dee: b, ahịrị-ọhụrụ.

b := a column: -100.
Mpụta dee: b, ahịrị-ọhụrụ.
