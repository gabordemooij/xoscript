>> t := Efu.

# you can control the time zone for
# parsing like this:
Oge mpaghara: ['CET'].
t := Oge isi-mmalite: ['1981-02-03 04:05:06'].
Mpụta dee: t, ahịrị-ọhụrụ.

# now using CEST time zone:
Oge mpaghara: ['CEST'].
t := Oge isi-mmalite: ['1981-02-03 04:05:06'].
Mpụta dee: t, ahịrị-ọhụrụ.

# error if string cannot be parsed
{ Oge isi-mmalite: ['1900']. } jide: { Efu. }, bido.
