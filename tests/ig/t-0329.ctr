Mpụta dee: ((Ndepụta ohuru
	mgbe-ọbịara: ['plaque:'] mee: { :x nke-ya o := x. },
	mgbe-ọbịara: ['plaque']  mee: { <- nke-ya o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Ndepụta ← 1)
	~ (Ndepụta ← 1 ; 2)
	~ (Ndepụta ← 1 ; 2 ; 3)
	~ (Ndepụta ← 1 ; 2 ; 3 ; 4)
	~ (Ndepụta ← 1 ; 2 ; 3 ; 4 ; 5)
) nke-ọ-bụla: { :i :el
	{ Mpụta dee: ọrụ-a. } × el ọnụ-ọgụgụ.
	Mpụta ahịrị-ọhụrụ.
}) plaque, ahịrị-ọhụrụ.


