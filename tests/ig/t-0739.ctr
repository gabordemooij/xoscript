Mpụta dee: ['Test object'], ahịrị-ọhụrụ.
>> a := Ihe ohuru. 

a mgbe-ọbịara: ['item:'] mee: { :binhelper
	nke-ya binhelper := binhelper. 
}.

a mgbe-ọbịara: ['item'] mee: { <- nke-ya binhelper.
}.

a item: Bin ohuru.

>> old-binhelper-address := a item ihe-nlereanya adreesị-ebe-nchekwa.
a save-as: ['/tmp/a.bin'].
Mpụta dee: ['========== RELOADING SNAP:'], ahịrị-ọhụrụ.

>> b := Ihe load-from: ['/tmp/a.bin'].

(b item ihe-nlereanya adreesị-ebe-nchekwa = old-binhelper-address) eziokwu: {
	Mpụta dee: ['Object link re-attached.'], ahịrị-ọhụrụ.
}.


