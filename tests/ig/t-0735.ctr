Server init.
>> a := Blob ohuru: 4.
a bytes: ( Ndepụta ohuru ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob ohuru: 4.
b bytes: ( Ndepụta ohuru ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
# inherited blob does not get the buffer, so it's useless
# it will pass ctr_accept() but since buffer ptr == null, it will retur
>> c := a ohuru.
{ 
>> n := a ^ c.
Mpụta dee: ['xorred:'], ahịrị-ọhụrụ. 
Mpụta dee: n, ahịrị-ọhụrụ. 
} jide: { :e Mpụta dee: e, ahịrị-ọhụrụ. }, bido.
a hapụ.
b hapụ.
