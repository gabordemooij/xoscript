Server init.
Mpụta dee: ['Database time test'], ahịrị-ọhụrụ.

>> db := Maria-DB ohuru onye-nnabata: ['localhost'],
	aha-onye-ọrụ: ['xo'], 
	okwuntughe: ['pass123'],
	aha-nchekwa-data: ['xobase'],
	jikọta.

>> ihe-ọchụchọ :=
db ajụjụ: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
weta: { :row
	Mpụta dee: row timetest, ahịrị-ọhụrụ.
}.
