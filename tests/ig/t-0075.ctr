>> i := 0.
Mpụta dee: ['Can we count to 10 using a whileTrue loop ?'], ahịrị-ọhụrụ.
{ Mpụta dee: i, ahịrị-ọhụrụ. } ka-ọ-dị: { i gbakwunye: 1. <- (i ≤ 10). }.
Mpụta dee: ['Can we count back from 10 to 0 using a whileFalse loop ?'], ahịrị-ọhụrụ.
{ Mpụta dee: i, ahịrị-ọhụrụ. } ka-ọ-dị: { i wepụ: 1. <- (i ≥ 0). }.
