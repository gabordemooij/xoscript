>> numbers := ['1,2,3'] kewaa: [','].
Mpụta dee: ['I got: '] + numbers ọnụ-ọgụgụ + [' numbers.'],ahịrị-ọhụrụ.
{ :i Mpụta dee: ['number #'] + i + [':'] + (numbers ọnọdụ: i), ahịrị-ọhụrụ.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages kewaa: [' Or '].
Mpụta dee: ['We serve'], ahịrị-ọhụrụ.
{ :i Mpụta dee: ['->'] + (beverages ọnọdụ: i), ahịrị-ọhụrụ. } × (beverages ọnụ-ọgụgụ).
Mpụta dee: (beverages jikọọ: [',']), ahịrị-ọhụrụ.
Mpụta dee: (numbers jikọọ: ['||']).
