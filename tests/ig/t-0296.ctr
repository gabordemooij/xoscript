
>> shop := (Akwụkwọ-okwu ohuru
	tinye: ['magazine'] na: ['books'],
	tinye: ['computer'] na: ['electronics'],
	tinye: ['lipstick'] na: ['cosmetics']
).
Mpụta dee: (shop gụnyere: ['computer']), ahịrị-ọhụrụ. 
Mpụta dee: (shop gụnyere: ['sausage']), ahịrị-ọhụrụ. 
Mpụta dee: (shop gụnyere: ['computers']), ahịrị-ọhụrụ. 
Mpụta dee: (shop gụnyere: ['compute']), ahịrị-ọhụrụ. 
Mpụta dee: (shop gụnyere: ['2computer']), ahịrị-ọhụrụ. 
