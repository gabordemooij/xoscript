>> Animal := Ihe ohuru.
Animal mgbe-ọbịara: ['make'] mee: {
	>> animal := Ihe ohuru.
	animal mgbe-ọbịara: ['makeSound'] mee: {
		Mpụta dee: nke-ya sound.
	}. <- animal.
}.
>> Cat := Ihe ohuru.
Cat mgbe-ọbịara: ['make'] mee: {
	>> cat := Animal make.
	cat mgbe-ọbịara: ['init'] mee: {
		nke-ya sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
