
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> koodu := {
	>> o := (
		Akwụkwọ-okwu ohuru
		aa: (Ndepụta ← 1 ; 2),
		bb: (Ndepụta ← 3 ; 4)
	).
	>> s := o ederede.
	>> o2 := s ihe.
	(s  ụdị = Ederede ụdị) eziokwu: { Mpụta dee: ['OK1'], ahịrị-ọhụrụ. }.
	(o2 ụdị = Akwụkwọ-okwu ụdị) eziokwu: { Mpụta dee: ['OK2'], ahịrị-ọhụrụ. }.
}.

Mmemme njikwa-ebe-nchekwa: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Mmemme hichaa.
usedMemory1 := (Mmemme ebe-nchekwa ? 1).
koodu bido.
Mmemme hichaa.
usedMemory2 := (Mmemme ebe-nchekwa ? 1).
koodu bido.
Mmemme hichaa.
usedMemory3 := (Mmemme ebe-nchekwa ? 1).
koodu bido.
Mmemme hichaa.
usedMemory4 := (Mmemme ebe-nchekwa ? 1).

(usedMemory2 = usedMemory3 = usedMemory4) eziokwu: { Mpụta dee: ['OK3'], ahịrị-ọhụrụ. }.
 
