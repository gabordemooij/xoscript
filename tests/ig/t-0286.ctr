['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Mpụta dee: (x + y), ahịrị-ọhụrụ.

>> x := 10040.07.
>> y := 10305.60.

Mpụta dee: (x + y), ahịrị-ọhụrụ.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Mpụta dee: (x + y + z), ahịrị-ọhụrụ.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Mpụta dee: (x + y + z), ahịrị-ọhụrụ.

>> q := 0.1.2.

Mpụta dee: (q), ahịrị-ọhụrụ.

>> q := 012.

Mpụta dee: (q), ahịrị-ọhụrụ.
