# test list operations


>> cakes := Ndepụta ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes dochie: 1 ogologo: 2 na: ( Ndepụta ← ['cinnamon'] ; ['pineapple'] ).
Mpụta dee: (buy jikọọ: [',']), ahịrị-ọhụrụ.


>> buy := cakes dochie: 1 ogologo: 12 na: ( Ndepụta ← ['cinnamon'] ; ['pineapple'] ).
Mpụta dee: (buy jikọọ: [',']), ahịrị-ọhụrụ.


>> buy := cakes dochie: 2 ogologo: 10 na: ( Ndepụta ohuru ).
Mpụta dee: (buy jikọọ: [',']), ahịrị-ọhụrụ.


>> buy := cakes dochie: 0 ogologo: 1 na: ( Ndepụta ohuru ).
Mpụta dee: (buy jikọọ: [',']), ahịrị-ọhụrụ.


>> buy := cakes dochie: ['0'] ogologo: ['1'] na: ['x'].
Mpụta dee: (buy jikọọ: [',']), ahịrị-ọhụrụ.
