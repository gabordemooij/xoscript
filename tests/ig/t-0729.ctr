Server init.
>> a := Blob ohuru: 4.
a bytes: ( Ndepụta ohuru ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob ohuru: 4.
b bytes: ( Ndepụta ohuru ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a ^ b.
{
	a ^ ( Faịlụ ohuru: ['noblob???'] ).
} jide: { :e Mpụta dee: e, ahịrị-ọhụrụ. }, bido.
a hapụ.
b hapụ.
