>> To-Do := Ihe ohuru.

To-Do mgbe-ọbịara: ['ohuru'] mee: {
	nke-ya list := Ndepụta ohuru.
}.

To-Do mgbe-ọbịara: ['nieuw'] mee: {
	nke-ya list := Ndepụta ohuru.
}.

To-Do mgbe-ọbịara: ['+'] mee: { :task
	nke-ya list tinye-na-njedebe: task.
}.

To-Do mgbe-ọbịara: ['number of tasks?'] mee: { <-  nke-ya list ọnụ-ọgụgụ.
}.

>> todos := 
	To-Do ohuru 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Mpụta dee: ['You have $ tasks to do'] $ todos number of tasks?.
