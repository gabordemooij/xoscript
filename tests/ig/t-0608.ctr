
>> Size := Ihe ohuru.
Size mgbe-ọbịara: ['is:'] mee: { :nọmba
	nọmba mgbe-ọbịara: ['+'] mee: { :nọmba
		>> unit := nọmba ọtụtụ-nkeji.
		>> factor := 1.
		
		unit
		ọ-bụrụ: ['inch'] mee: { factor := 0.0833. }. <- onwe + (nọmba * factor).
	}. <- nọmba.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Mpụta dee: plank + edge, ahịrị-ọhụrụ.
