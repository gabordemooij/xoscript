# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Ụkpụrụ-ọchụchọ ohuru: pattern.
	p dakọtara: subject mee: { :m :g
		Mpụta dee: g ọnụ-ọgụgụ, dee: [' '], dee: (g jikọọ: ['|']), ahịrị-ọhụrụ. <- m.
	}.
}.
show tinye-nọrụ: ['(a)|(b)'] na: ['b'].
show tinye-nọrụ: ['(a)|(b)'] na: ['a'].
show tinye-nọrụ: ['(x)?y'] na: ['y'].
show tinye-nọrụ: ['(x)?(y)(z)?'] na: ['xy'].
