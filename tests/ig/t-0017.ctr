Nọmba mgbe-ọbịara: ['factorial'] mee: {
	>> total := 1.
	{ :index total mụbaa-site-na: (onwe - (index)). } × onwe. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Mpụta dee: a.
>> b := 2 + 3 factorial.
Mpụta dee: b.
>> c := 3 factorial + 2.
Mpụta dee: c.
>> d := 2 + (3 factorial).
Mpụta dee: d.
Mpụta dee: 2 + 3 factorial + 1.
