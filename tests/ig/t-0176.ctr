

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Mmemme njikwa-ebe-nchekwa: 0.

>> txt := ['Word Salad'].
Mpụta dee: ['Text Length: '] + txt ogologo, ahịrị-ọhụrụ.
Mpụta dee: ['Character at 2:'] + ( txt mkpụrụedemede: 2 ), ahịrị-ọhụrụ.
Mpụta dee: (( txt chọta: ['S'] ) - 0), ahịrị-ọhụrụ.

Mmemme hichaa.

usedMemory1 := (Mmemme ebe-nchekwa ? 0).


txt := ['Word Salad'].
Mpụta dee: ['Text Length: '] + txt ogologo, ahịrị-ọhụrụ.
Mpụta dee: ['Character at 2:'] + ( txt mkpụrụedemede: 2 ), ahịrị-ọhụrụ.
