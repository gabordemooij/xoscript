# backslashes must survive code serialization, strings must not end early
>> uru-niile := Ndepụta ohuru
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

uru-niile nke-ọ-bụla: { :i :value
	>> d := Akwụkwọ-okwu ohuru.
	d tinye: value na: ['k'].
	>> r := d koodu ihe.
	Mpụta dee: r ọnụ-ọgụgụ, ahịrị-ọhụrụ.
	Mpụta dee: ( (r ebe: ['k']) = value ), ahịrị-ọhụrụ.
}.
