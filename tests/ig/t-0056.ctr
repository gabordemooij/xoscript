>> z := Ihe ohuru.
z mgbe-ọbịara: ['value:'] mee: { :v
	nke-ya value := v. <- onwe.
}.
z mgbe-ọbịara: ['value'] mee: { <- nke-ya value. }.
(z setValue: 1) value: 2.
Mpụta dee: z value.
>> x := z.
Mpụta dee: x value.
z := Efu.
Mpụta dee: z value.
Mpụta dee: x value.
Mpụta dee: ['hello'].
Mpụta dee: 3 + 2.
Mpụta dee: (3 > 2).
