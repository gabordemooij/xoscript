>> a := Ndepụta ← Ihe ; Eziokwu ; Ụgha ; Boolean ; 1 ; Nọmba ; ['Str'] ; Ederede ; { ['Empty']. }.
Mpụta dee: (a ọnụ-ọgụgụ), ahịrị-ọhụrụ.
{ :i
	Mpụta dee: 
	['a '] + 
	((a ? i) ụdị) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Efu?) nke-a: [''] ma-ọ-bụ-nke-ahụ: ['NOT']) + 
	[' Nil.'],
	ahịrị-ọhụrụ.
} × (a ọnụ-ọgụgụ).
Mpụta dee: ['but.. Nil is.. '] + ((Efu Efu?) nke-a: ['certainly NIL!'] ma-ọ-bụ-nke-ahụ: ['not NIL??']), ahịrị-ọhụrụ.