Mpụta dee: ['Test object'], ahịrị-ọhụrụ.
>> a := Ihe ohuru. 

a mgbe-ọbịara: ['item:'] mee: { :fmt
	nke-ya fmt := fmt. 
}.

a mgbe-ọbịara: ['item'] mee: { <- nke-ya fmt.
}.

a item: ( Usoro-ọdịdị ohuru: ['|%s|'] ).

Mpụta dee: a item, ahịrị-ọhụrụ.

>> old-fmt-address := a item ihe-nlereanya adreesị-ebe-nchekwa.
a save-as: ['/tmp/a.bin'].
Mpụta dee: ['========== RELOADING SNAP:'], ahịrị-ọhụrụ.

>> b := Ihe load-from: ['/tmp/a.bin'].

(b item ihe-nlereanya adreesị-ebe-nchekwa = old-fmt-address) eziokwu: {
	Mpụta dee: ['Object link re-attached.'], ahịrị-ọhụrụ.
}.

Mpụta dee: ( b item tinye-nọrụ: ['hello'] ), ahịrị-ọhụrụ.
