Mpụta dee: ['1,2,3,4,5,6,7,8,9,A,'], ahịrị-ọhụrụ.
>> Scope := Ihe ohuru.
Scope mgbe-ọbịara: ['initialize:'] mee: { :x nke-ya property := x. }.
Scope mgbe-ọbịara: ['confirm'] mee: { Mpụta dee: [',']. }.
Scope mgbe-ọbịara: ['nnwale'] mee: {
	Mpụta dee: nke-ya property.
	onwe confirm.
	( 1 = 1 ) eziokwu: { Mpụta dee: nke-ya property. onwe confirm. }.
	( 1 = 0 ) ụgha: { Mpụta dee: nke-ya property. onwe confirm. }.
	>> y := 2. { Mpụta dee: nke-ya property. onwe confirm. } ka-ọ-dị: { y wepụ: 1. <- (y > 0). }.
	{ Mpụta dee: nke-ya property. onwe confirm. } × 1.
	(Ndepụta ← 1) nke-ọ-bụla: {  Mpụta dee: nke-ya property. onwe confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Akwụkwọ-okwu ohuru one: ['item']) nke-ọ-bụla: { Mpụta dee: nke-ya property. onwe confirm. }.
	{ 1 ÷ 0. } jide: { Mpụta dee: nke-ya property. onwe confirm. }, bido.
	Mpụta ahịrị-ọhụrụ.
}.
>> scope1 := Scope ohuru.
scope1 initialize: ['X'].
scope1 nnwale.
>> function := { 
	nke-ya property := ['Y'].
	Mpụta dee: nke-ya property.
	onwe confirm.
	( 1 = 1 ) eziokwu: { Mpụta dee: nke-ya property. onwe confirm. }.
	( 1 = 0 ) ụgha: { Mpụta dee: nke-ya property. onwe confirm. }.
	>> y := 2. { Mpụta dee: nke-ya property. onwe confirm. } ka-ọ-dị: { y wepụ: 1. <- (y > 0). }.
	{ Mpụta dee: nke-ya property. onwe confirm. } × 1.
	(Ndepụta ← 1) nke-ọ-bụla: {  Mpụta dee: nke-ya property. onwe confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Akwụkwọ-okwu ohuru one: ['item']) nke-ọ-bụla: { Mpụta dee: nke-ya property. onwe confirm. }.
	{ 1 ÷ 0. } jide: { Mpụta dee: nke-ya property. onwe confirm. }, bido.
	Mpụta ahịrị-ọhụrụ.
}.
function mgbe-ọbịara: ['confirm'] mee: { Mpụta dee: [',']. }.
function tinye-nọrụ: 1 na: 2.
