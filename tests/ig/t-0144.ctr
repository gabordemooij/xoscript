



>> CoffeeGrounds := Ihe ohuru.
CoffeeGrounds mgbe-ọbịara: ['extract'] mee: { <- ['coffee']. }.

>> CoffeeMachine := Ihe ohuru.
CoffeeMachine mgbe-ọbịara: ['init'] mee: {
	nke-ya coffeegrounds := CoffeeGrounds ohuru.
}.
CoffeeMachine mgbe-ọbịara: ['ohuru'] mee: { <- CoffeeMachine `new init.
}.

CoffeeMachine mgbe-ọbịara: ['makeTea'] mee: { <- (nke-ya tealeaves extract). }.
CoffeeMachine mgbe-ọbịara: ['makeCoffee'] mee: { <- (nke-ya coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine ohuru.

Mpụta dee:
	coffeeDream 
	makeCoffee.

Mpụta dee:
	coffeeDream 
	makeTea.
