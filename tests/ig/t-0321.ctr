# test qualifiers

Mmemme hichaa.

>> Fruit := Ihe ohuru.
Fruit mgbe-ọbịara: ['ohuru'] mee: {
	>> f := onwe ohuru.
	f apples: 0. <- f.
}.
Fruit mgbe-ọbịara: ['apples:'] mee: { :a nke-ya apples := a. }.
Fruit mgbe-ọbịara: ['apples'] mee: { <- nke-ya apples. }.
Fruit mgbe-ọbịara: ['+'] mee: { :f
	>> n := Fruit ohuru.
	n apples: (f apples + nke-ya apples). <- n.
}.
Nọmba mgbe-ọbịara: ['apples'] mee: { <- ((Fruit ohuru) apples: onwe).
}.

Fruit mgbe-ọbịara: ['ederede'] mee: { <- nke-ya apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Mpụta dee: q, ahịrị-ọhụrụ.




q := 3 apples + 4 apples.
Mpụta dee: q, ahịrị-ọhụrụ.



q := 3 apples + 4 apples.
Mpụta dee: q, ahịrị-ọhụrụ.


