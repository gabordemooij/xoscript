

Ederede mgbe-ọbịara: ['evaluate'] mee: {
	>> koodu := Faịlụ ohuru: ['/tmp/eval.ctr'].
	koodu dee: onwe ederede + ['.'].
	Mmemme jiri: ['/tmp/eval.ctr'].
}.

>> a := (Ndepụta ← (
	(Akwụkwọ-okwu ohuru)
		tinye: ['domain'] na: ['mywebsite.com'],
		tinye: (Ndepụta ←
			((Akwụkwọ-okwu ohuru)
				tinye: ['home'] na: ['title'],
				tinye: ['<html></html>'] na: ['body'],
				tinye: ['2017-01-01'] na: ['created']
			) ;
			((Akwụkwọ-okwu ohuru)
				tinye: ['aboutus(c)'] na: ['title'],
				tinye: ['<credits>Author Inc.</credits>'] na: ['body']
			)
		) na: ['pages']
	)
) ederede.

Mpụta dee: a ụdị, ahịrị-ọhụrụ.
Mpụta dee: a, ahịrị-ọhụrụ.

>> b := Efu.
(['b := '] + a) evaluate.
Mpụta dee: b ? 0 ? ['pages'] ? 1 ? ['body'], ahịrị-ọhụrụ.

>> c := b ? 0.
>> d := c ederede.
Mpụta dee: d ụdị, ahịrị-ọhụrụ.

>> e := Efu.
(['e := '] + d) evaluate.
Mpụta dee: e ? ['pages'] ? 0, ahịrị-ọhụrụ.
