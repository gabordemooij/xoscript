Server init.

Mpụta dee: (
	Ụkpụrụ-ọchụchọ ohuru: ['^\\w+$'],
	dakọtara: ['test@example.com'] 
), ahịrị-ọhụrụ. # 0 match, fails on @ and .

Mpụta dee: (
	Ụkpụrụ-ọchụchọ ohuru: ['^[^@]+@[^\.]+\.\\w+$'],
	dakọtara: ['test@example.com'] 
), ahịrị-ọhụrụ. # 1 match

Mpụta dee: (
	Ụkpụrụ-ọchụchọ ohuru: ['[^@]+@[^\.]+\.\\w+'],
	dakọtara: ['test@example.com'] 
), ahịrị-ọhụrụ. # 1 match

Mpụta dee: (
	Ụkpụrụ-ọchụchọ ohuru: ['([^@]+)@([^\.]+)\.\\w+'],
	dakọtara: ['test@example.com'] 
), ahịrị-ọhụrụ. # 1 match, groups dont matter

Mpụta dee: (
	Ụkpụrụ-ọchụchọ ohuru: ['[a-z]'],
	dakọtara: ['test@example.com'] 
), ahịrị-ọhụrụ. # 14 matches

Mpụta dee: (
	Ụkpụrụ-ọchụchọ ohuru: ['.*'],
	dakọtara: ['test@example.com'] 
), ahịrị-ọhụrụ. # 1 match (all)

Mpụta dee: (
	Ụkpụrụ-ọchụchọ ohuru: ['(.*)'],
	dakọtara: ['test@example.com'] 
), ahịrị-ọhụrụ. # 1 match (all)

Mpụta dee: (
	Ụkpụrụ-ọchụchọ ohuru: ['\\s*[^@]+@[^\.]+\.\\w+'],
	dakọtara: ['test@example.com'] 
), ahịrị-ọhụrụ. # 1 match, prefix space optional, gets ignored