Ndepụta mgbe-ọbịara: ['sum'] mee: {
	>> total := 0.
	onwe nke-ọ-bụla: { :index :element
		total gbakwunye: element.
	}. <- total.
}.

>> a := Eziokwu.



a mgbe-ọbịara: ['ederede'] mee: {
	>> answer := Efu.
	( onwe = Eziokwu ) eziokwu: {
		answer := ['Yep'].
	}, ma-ọ-bụghị-ya: {
		answer := ['Nope'].
	}. <- answer.
}.

a mgbe-ọbịara: ['nọmba'] mee: {
	>> answer := Efu.
	( onwe = Eziokwu ) eziokwu: {
		answer := 10.
	}, ma-ọ-bụghị-ya: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b mgbe-ọbịara: ['ederede'] mee: { <- ['Devil'].
}.

b mgbe-ọbịara: ['boolean'] mee: { <- Ụgha.
}.


Mpụta dee: a, ahịrị-ọhụrụ.  
Mpụta dee: (90 + a), ahịrị-ọhụrụ. 
Mpụta dee: b, ahịrị-ọhụrụ. 
Mpụta dee: (Eziokwu na: b), ahịrị-ọhụrụ.

a := Ndepụta ← ['hello'] ; ['world'] ; Eziokwu ; Efu ; 666. 
a := a + ( Ndepụta ← 1 ).
Mpụta dee: a, ahịrị-ọhụrụ.
Mpụta dee: ((Akwụkwọ-okwu ohuru) tinye: Efu na: Efu), ahịrị-ọhụrụ.
Mpụta dee: a sum, ahịrị-ọhụrụ. 


{
	a mgbe-ọbịara: ['ederede'] mee: { <- Efu. }.
	a := [''] + a.
} jide: { :error
	Mpụta dee: ['Error noted: '] + error, ahịrị-ọhụrụ.
}, bido.



{
	a mgbe-ọbịara: ['nọmba'] mee: { <- Efu. }.
	a := 3 × a.
} jide: { :error
	Mpụta dee: ['Error noted: '] + error, ahịrị-ọhụrụ.
}, bido.


{
	a mgbe-ọbịara: ['boolean'] mee: { <- Efu. }.
	a := Eziokwu na: a. 
} jide: { :error
	Mpụta dee: ['Error noted: '] + error, ahịrị-ọhụrụ.
}, bido.





