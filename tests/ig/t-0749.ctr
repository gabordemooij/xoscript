Mpụta dee: ['Test object'], ahịrị-ọhụrụ.
>> a := Ihe ohuru. 

a mgbe-ọbịara: ['item:'] mee: { :boolean
	nke-ya boolean := boolean. 
}.

a mgbe-ọbịara: ['item'] mee: { <- nke-ya boolean.
}.

a item: Ụgha.

Mpụta dee: a item, ahịrị-ọhụrụ.

>> old-bool-address := a item ihe-nlereanya adreesị-ebe-nchekwa.
a save-as: ['/tmp/a.bin'].
Mpụta dee: ['========== RELOADING SNAP:'], ahịrị-ọhụrụ.

>> b := Ihe load-from: ['/tmp/a.bin'].

(b item ihe-nlereanya adreesị-ebe-nchekwa = old-bool-address) eziokwu: {
	Mpụta dee: ['Object link re-attached.'], ahịrị-ọhụrụ.
}.

Mpụta dee: b item, ahịrị-ọhụrụ.
