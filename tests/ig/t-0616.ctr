Ndepụta mgbe-ọbịara: ['detuo'] mee: {
	>> detuo := Ndepụta ohuru.
	onwe nke-ọ-bụla: { :nọmba :section
		detuo tinye-na-njedebe: section nkpọghachi-onwe detuo.
	}. <- detuo.
}.

>> sheep := Ndepụta ohuru ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep detuo.
clones nke-ọ-bụla: { :nọmba :sheep
	sheep tinye-na-njedebe: ['2'].
}.

Mpụta dee: sheep, ahịrị-ọhụrụ.
Mpụta dee: clones, ahịrị-ọhụrụ.
