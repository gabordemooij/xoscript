>> t := Eziokwu.
(t = Eziokwu) eziokwu: { Mpụta dee: ['T']. }.
(t = Ụgha) eziokwu: { Mpụta dee: ['F']. }.
Mpụta dee: ['|'].
>> t := Ụgha.
(t = Eziokwu) eziokwu: { Mpụta dee: ['T']. }.
(t = Ụgha) eziokwu: { Mpụta dee: ['F']. }.
Mpụta dee: ['|'].
>> f := Eziokwu.
(t = Eziokwu na: f = Ụgha) eziokwu: { Mpụta dee: ['T']. }.
(t = Ụgha na: f = Eziokwu) eziokwu: { Mpụta dee: ['F']. }.
Mpụta dee: ['|'].
>> n := Efu.
(n Efu?) eziokwu: { Mpụta dee: ['T']. }.
(n Efu?) ụgha: { Mpụta dee: ['F']. }.
Mpụta dee: ['|'].
(f Boolean?) eziokwu: { Mpụta dee: ['T']. }.
(f Boolean?) ụgha: { Mpụta dee: ['F']. }.



