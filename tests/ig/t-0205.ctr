>> str := ['write:'].
Mpụta ozi: ['dee:'] ntinye-ya: (Ndepụta ← ['Hello World']), ahịrị-ọhụrụ. 

Nọmba mgbe-ọbịara: ['isbetween:and:'] mee: { :a :b <- ((onwe ≥ a) na: (onwe ≤ b)).
}.

str := ['isbetween:and:'].
Mpụta dee: (3 ozi: str ntinye-ya: (Ndepụta ← 2 ; 8)), ahịrị-ọhụrụ.
Mpụta dee: (3 ozi: str ntinye-ya: (Ndepụta ← 1 ; 2)), ahịrị-ọhụrụ.


>> CoffeeMachine := Ihe ohuru.
CoffeeMachine mgbe-ọbịara: ['makeCoffeeWithSugar:milk:'] mee: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Ndepụta ← 4 ; 2.
Mpụta dee: ( CoffeeMachine ozi: order ntinye-ya: coffeeConfiguration ), ahịrị-ọhụrụ.
