>> HTML := Ihe ohuru.
HTML mgbe-ọbịara: ['zaghachi:'] mee: { :tag 
	Mpụta dee: (['<tag>'] tag: tag), ahịrị-ọhụrụ.
}.
HTML mgbe-ọbịara: ['zaghachi:na:'] mee: { :tag :html 
	Mpụta dee: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), ahịrị-ọhụrụ.
}.
>> html := HTML ohuru.
html body h1: ['header'].

