
Ndepụta mgbe-ọbịara: ['product'] mee: {
	>> total := 1.
	onwe nke-ọ-bụla: { :index :element
		total mụbaa-site-na: element.
	}. <- total.
}.

>> a := Ndepụta ← 1 ; 2 ; 3.
Mpụta dee: a product, ahịrị-ọhụrụ.
Mpụta dee: (Ndepụta ← 2 ; 4 ; 8) product, ahịrị-ọhụrụ. 
Mpụta dee: (Ndepụta ← -2 ; 10) product, ahịrị-ọhụrụ. 
Mpụta dee: (Ndepụta ← 0.5 ; -2) product, ahịrị-ọhụrụ. 
