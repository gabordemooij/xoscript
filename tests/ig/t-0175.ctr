

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> x := 100.

Mmemme njikwa-ebe-nchekwa: 0.

{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt tinye-na-njedebe: ['!!'].
Mpụta dee: txt.
} bido.

Mmemme hichaa.

usedMemory1 := (Mmemme ebe-nchekwa ? 0).


{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt tinye-na-njedebe: ['!!'].
