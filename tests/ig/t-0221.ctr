>> x := Ihe ohuru.
>> y := Ihe ohuru.
>> z := x.
Mpụta dee: (x = z), ahịrị-ọhụrụ.
Mpụta dee: (x = y), ahịrị-ọhụrụ.
Mpụta dee: (x ≠ y), ahịrị-ọhụrụ.
Mpụta dee: (x ≠ z), ahịrị-ọhụrụ.
>> m := Oge ohuru afọ: 2070, ọnwa: 11.
>> n := m detuo.
Mpụta dee: (m = n), ahịrị-ọhụrụ.
Mpụta dee: (m ≠ n), ahịrị-ọhụrụ.
Mpụta dee: (m otu-ihe: m), ahịrị-ọhụrụ.
Mpụta dee: (m otu-ihe: n), ahịrị-ọhụrụ.
n ọnwa: 12.
Mpụta dee: (m ≠ n), ahịrị-ọhụrụ.
Mpụta dee: (m = n), ahịrị-ọhụrụ.


