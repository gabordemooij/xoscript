>> Greeter := Ihe ohuru.
Greeter mgbe-ọbịara: ['make'] mee: {
	>> gr := Ihe ohuru.
	gr mgbe-ọbịara: ['setName:'] mee: { :aname
		nke-ya aha := aname.
	}.
	gr mgbe-ọbịara: ['greet'] mee: {
		Mpụta dee: nke-ya aha.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a ohuru.
c setName: ['THREE'].
c greet.
>> d := a ohuru.
d setName: ['FOUR'].
d greet.
c greet.
