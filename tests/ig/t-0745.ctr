Mpụta dee: ['Test object'], ahịrị-ọhụrụ.
>> a := Ihe ohuru. 

a mgbe-ọbịara: ['item:'] mee: { :dict
	nke-ya dict := dict. 
}.

a mgbe-ọbịara: ['item'] mee: { <- nke-ya dict.
}.

a item: (
Akwụkwọ-okwu ohuru
	hello: ['world']).

>> old-dict-address := a item ihe-nlereanya adreesị-ebe-nchekwa.
a save-as: ['/tmp/a.bin'].
Mpụta dee: ['========== RELOADING SNAP:'], ahịrị-ọhụrụ.

>> b := Ihe load-from: ['/tmp/a.bin'].

(b item ihe-nlereanya adreesị-ebe-nchekwa = old-dict-address) eziokwu: {
	Mpụta dee: ['Object link re-attached.'], ahịrị-ọhụrụ.
}.

Mpụta dee: b item, ahịrị-ọhụrụ.
