

>> Matryoshka := Ihe ohuru.
Matryoshka mgbe-ọbịara: ['double:'] mee: { :secret
	nke-ya secret := secret × 2.
}.
Matryoshka mgbe-ọbịara: ['ohuru:'] mee: { :secret
	>> answer := Efu.
	>> t := (secret > 255).
	Mpụta dee: (secret + [' | '] + t), ahịrị-ọhụrụ.
	t eziokwu: {
		answer := secret.
	}, ma-ọ-bụghị-ya: {
		answer := Matryoshka nkpọghachi-onwe ohuru: (onwe double: secret).
	}. <- answer.
}.

>> x := Matryoshka ohuru: 2.
