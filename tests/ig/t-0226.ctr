# Test ASCII variants

# Numbers

Mpụta dee: (2 !=: 3), ahịrị-ọhụrụ.
Mpụta dee: (2 <=: 2), ahịrị-ọhụrụ.
Mpụta dee: (2 >=: 2), ahịrị-ọhụrụ.

# Strings

Mpụta dee: (['b'] >=: ['a']), ahịrị-ọhụrụ.
Mpụta dee: (['b'] !=: ['a']), ahịrị-ọhụrụ.
Mpụta dee: (['b'] <=: ['c']), ahịrị-ọhụrụ.

# Bools

Mpụta dee: (Eziokwu !=: Ụgha), ahịrị-ọhụrụ.

# Objects

Mpụta dee: (Ihe ohuru !=: Ihe ohuru), ahịrị-ọhụrụ.

# ASCII list symbol <-:

Mpụta dee: (Ndepụta <<: 1, ; 2 ; 3) ọnụ-ọgụgụ = 3, ahịrị-ọhụrụ.

