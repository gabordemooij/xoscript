Mpụta dee: ['Test object'], ahịrị-ọhụrụ.
>> cmd := Iwu ohuru.
Mpụta dee: cmd ls /tmp, ahịrị-ọhụrụ.
>> old-cmd-address := cmd ihe-nlereanya adreesị-ebe-nchekwa.
cmd save-as: ['/tmp/a.bin'].
Mpụta dee: ['========== RELOADING SNAP:'], ahịrị-ọhụrụ.
>> b := Ihe load-from: ['/tmp/a.bin'].
(b ihe-nlereanya adreesị-ebe-nchekwa = old-cmd-address) eziokwu: {
	Mpụta dee: ['Object link re-attached.'], ahịrị-ọhụrụ.
}.
Mpụta dee: b ls, ahịrị-ọhụrụ.


