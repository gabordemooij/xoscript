Ederede mgbe-ọbịara: ['html'] mee: { <- (
		onwe
		dochie: ['&'] na: ['&amp;'],
		dochie: ['<'] na: ['&lt;'],
		dochie: ['>'] na: ['&gt;'],
		dochie: ['''] na: ['&apos;'],
		dochie: ['"'] na: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Mmemme njikwa-ebe-nchekwa: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Mpụta dee: txt detuo html, ahịrị-ọhụrụ.
Mpụta dee: txt detuo mkpụrụ-nta, ahịrị-ọhụrụ.
Mpụta dee: txt detuo mkpụrụ-ukwu, ahịrị-ọhụrụ.
} bido.

Mmemme hichaa.

usedMemory1 := (Mmemme ebe-nchekwa ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Mpụta dee: txt detuo html, ahịrị-ọhụrụ.
Mpụta dee: txt detuo mkpụrụ-nta, ahịrị-ọhụrụ.
Mpụta dee: txt detuo mkpụrụ-ukwu, ahịrị-ọhụrụ.
} bido.

Mmemme hichaa.
usedMemory2 := (Mmemme ebe-nchekwa ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Mpụta dee: txt detuo html, ahịrị-ọhụrụ.
Mpụta dee: txt detuo mkpụrụ-nta, ahịrị-ọhụrụ.
Mpụta dee: txt detuo mkpụrụ-ukwu, ahịrị-ọhụrụ.
} bido.

Mmemme hichaa.
usedMemory3 := (Mmemme ebe-nchekwa ? 0).



( usedMemory1 = usedMemory2 na: usedMemory1 = usedMemory3, na: usedMemory2 = usedMemory3 ) eziokwu: {
	Mpụta dee: ['No memory leaks here'].
}, ụgha: {
	Mpụta dee: ['Leaking memory...'].
}.
