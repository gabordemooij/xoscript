Server init.
Mpụta dee: ['Database date test'], ahịrị-ọhụrụ.

>> db := Maria-DB ohuru onye-nnabata: ['localhost'],
	aha-onye-ọrụ: ['xo'], 
	okwuntughe: ['pass123'],
	aha-nchekwa-data: ['xobase'],
	jikọta.

>> ihe-ọchụchọ :=
db ajụjụ: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
weta: { :row
	Mpụta dee: row datetest, ahịrị-ọhụrụ.
}.
