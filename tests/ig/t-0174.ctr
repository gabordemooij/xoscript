


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Mmemme njikwa-ebe-nchekwa: 0.
>> palette := Efu.
>> colors := Efu.

{
palette := Akwụkwọ-okwu ohuru.
palette 
	tinye: ['#F00'] na: ['red'],
	tinye: ['#0F0'] na: ['green'],
	tinye: ['#00F'] na: ['blue'].
Mpụta dee: ['number of RGB codes in palette: '] + ( palette ọnụ-ọgụgụ ), ahịrị-ọhụrụ.
Mpụta dee: ['RGB code of green is: '] + ( palette ? ['green'] ), ahịrị-ọhụrụ.
colors := [''].
( palette nke-ọ-bụla: { :aha :koodu
		colors := colors + ( aha + [':'] + koodu ).
} ).
Mpụta dee: ['All colors in palette: '] + colors, ahịrị-ọhụrụ.
} bido.
Mmemme hichaa.
usedMemory1 := (Mmemme ebe-nchekwa ? 0).

{
palette := Akwụkwọ-okwu ohuru.
palette 
	tinye: ['#F00'] na: ['red'],
	tinye: ['#0F0'] na: ['green'],
	tinye: ['#00F'] na: ['blue'].
Mpụta dee: ['number of RGB codes in palette: '] + ( palette ọnụ-ọgụgụ ), ahịrị-ọhụrụ.
Mpụta dee: ['RGB code of green is: '] + ( palette ? ['green'] ), ahịrị-ọhụrụ.
colors := [''].
( palette nke-ọ-bụla: { :aha :koodu
		colors := colors + ( aha + [':'] + koodu ).
} ).
Mpụta dee: ['All colors in palette: '] + colors, ahịrị-ọhụrụ.
} bido.
Mmemme hichaa.
usedMemory2 := (Mmemme ebe-nchekwa ? 0).

{
palette := Akwụkwọ-okwu ohuru.
palette 
	tinye: ['#F00'] na: ['red'],
	tinye: ['#0F0'] na: ['green'],
	tinye: ['#00F'] na: ['blue'].
Mpụta dee: ['number of RGB codes in palette: '] + ( palette ọnụ-ọgụgụ ), ahịrị-ọhụrụ.
Mpụta dee: ['RGB code of green is: '] + ( palette ? ['green'] ), ahịrị-ọhụrụ.
colors := [''].
( palette nke-ọ-bụla: { :aha :koodu
		colors := colors + ( aha + [':'] + koodu ).
} ).
Mpụta dee: ['All colors in palette: '] + colors, ahịrị-ọhụrụ.
} bido.
Mmemme hichaa.
usedMemory3 := (Mmemme ebe-nchekwa ? 0).



( usedMemory1 = usedMemory2 na: usedMemory1 = usedMemory3, na: usedMemory2 = usedMemory3 ) eziokwu: {
	Mpụta dee: ['No memory leaks here'].
}, ụgha: {
	Mpụta dee: ['Leaking memory...'].
}.
