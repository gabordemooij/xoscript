

>> Cat := Ihe ohuru.

Cat mgbe-ọbịara: ['ohuru'] mee: {
	nke-ya sound := ['meow!'].
}.

Cat mgbe-ọbịara: ['nieuw'] mee: {
	nke-ya sound := ['meow!'].
}.

Cat mgbe-ọbịara: ['makeSound'] mee: { <- nke-ya sound.
}.

Cat mgbe-ọbịara: ['greet'] mee: { <- onwe makeSound.
}.

>> cat := Cat ohuru.
Mpụta dee: cat greet.
