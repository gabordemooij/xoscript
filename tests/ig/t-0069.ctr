

Ederede mgbe-ọbịara: ['html'] mee: { <- (
		onwe
		dochie: ['&'] na: ['&amp;'],
		dochie: ['<'] na: ['&lt;'],
		dochie: ['>'] na: ['&gt;'],
		dochie: ['"'] na: ['&quot;']
	).
}.


Mpụta dee: ([' left trimmed '] bee-oghere) + [' '] + ( ['and right trimmed'] bee-oghere) + ['!'], ahịrị-ọhụrụ.
Mpụta dee: ['<html>"html & entities"</html>'] html.
