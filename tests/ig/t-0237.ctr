
Ederede mgbe-ọbịara: ['evaluate'] mee: {
	>> koodu := Faịlụ ohuru: ['/tmp/eval.ctr'].
	koodu dee: (onwe ederede + ['.']).
	Mmemme jiri: ['/tmp/eval.ctr'].
}.

>> map :=
	(Akwụkwọ-okwu ohuru)
	tinye: ['Hi There'] na: ['two'],
	tinye: (Ndepụta ← ['hello'] ; ['world'] ; (Ndepụta ← 1 ; 2; 9) ; Ụgha) na: ['one'],
	tinye: ( (Akwụkwọ-okwu ohuru) tinye: ['wrrld'] na: ['misspelled'] ) na: ['three'],
	tinye: (Ndepụta ← ((Akwụkwọ-okwu ohuru) tinye: ['treasure'] na: ['hidden']) ; 2) na: ['four']. 
>> str := map ederede.
>> map2 := Efu.
(['map2 := '] + str ) evaluate.
Mpụta dee: map2 ? ['one'] ? 0.
Mpụta dee: map2 ? ['one'] ? 1.
Mpụta dee: map2 ? ['four'] ? 0 ? ['hidden'].
Mpụta dee: map2 ? ['one'] ? 2 ? 2.
