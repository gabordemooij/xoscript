#ffi test


Server init.

Mmemme njikwa-ebe-nchekwa: 4.

# for this test you need set a path to libc (puts)
>> libname := Mmemme ntọala: ['FFITESTLIB'].



Server njikọ: (
 Ndepụta ohuru ;
 libname ;
 ['puts'] ;
 ( Ndepụta ohuru ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s hapụ.

# test with struct

>> a := Blob ohuru: 8.
a bytes: (
	Ndepụta <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Ndepụta <<: ['int'], ; ['int']).

Server njikọ: (
	Ndepụta <<: ['@structtest'], ;
	['@structtest'] ;
	(Ndepụta <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Mpụta dee: ['Sum test:'] + (ffitest ffisum: a), ahịrị-ọhụrụ.

struct hapụ-struct.
struct hapụ.
a hapụ.
