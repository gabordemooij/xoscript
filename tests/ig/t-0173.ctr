

Ndepụta mgbe-ọbịara: ['sum'] mee: {
	>> total := 0.
	onwe nke-ọ-bụla: { :index :element
		total gbakwunye: element.
	}. <- total.
}.

Ndepụta mgbe-ọbịara: ['product'] mee: {
	>> total := 1.
	onwe nke-ọ-bụla: { :index :element
		total mụbaa-site-na: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Mmemme njikwa-ebe-nchekwa: 0.

{

>> a := Ndepụta ← ['hello'] ; ['world'] ; Eziokwu ; Efu ; 666.
a := a + ( Ndepụta ← 1 ).
Mpụta dee: ( ['sum: '] + ( a sum ) ), ahịrị-ọhụrụ.
Mpụta dee: ( ['min: '] + ( a nke-kacha-nta ) ), ahịrị-ọhụrụ.
Mpụta dee: ( ['max: '] + ( a nke-kacha-ukwuu ) ), ahịrị-ọhụrụ.
Mpụta dee: ( ['3rd: '] + ( a ? 2 ) ), ahịrị-ọhụrụ.
Mpụta dee: ( ['prd: '] + ( a product ) ), ahịrị-ọhụrụ.
a hazie: { :a :b <- (b - a). }.
a nke-ọ-bụla: { :i :e Mpụta dee: ( i - 0 ), ahịrị-ọhụrụ. }.

} bido.

Mmemme hichaa.
usedMemory1 := (Mmemme ebe-nchekwa ? 0).


{

>> a := Ndepụta ← ['hello'] ; ['world'] ; Eziokwu ; Efu ; 666.
a := a + ( Ndepụta ← 1 ).
Mpụta dee: ( ['sum: '] + ( a sum ) ), ahịrị-ọhụrụ.
Mpụta dee: ( ['min: '] + ( a nke-kacha-nta ) ), ahịrị-ọhụrụ.
Mpụta dee: ( ['max: '] + ( a nke-kacha-ukwuu ) ), ahịrị-ọhụrụ.
Mpụta dee: ( ['3rd: '] + ( a ? 2 ) ), ahịrị-ọhụrụ.
Mpụta dee: ( ['prd: '] + ( a product ) ), ahịrị-ọhụrụ.
a hazie: { :a :b <- (b - a). }.
a nke-ọ-bụla: { :i :e Mpụta dee: ( i - 0 ), ahịrị-ọhụrụ. }.

} bido.



Mmemme hichaa.
usedMemory2 := (Mmemme ebe-nchekwa ? 0).


{

>> a := Ndepụta ← ['hello'] ; ['world'] ; Eziokwu ; Efu ; 666.
a := a + ( Ndepụta ← 1 ).
Mpụta dee: ( ['sum: '] + ( a sum ) ), ahịrị-ọhụrụ.
Mpụta dee: ( ['min: '] + ( a nke-kacha-nta ) ), ahịrị-ọhụrụ.
Mpụta dee: ( ['max: '] + ( a nke-kacha-ukwuu ) ), ahịrị-ọhụrụ.
Mpụta dee: ( ['3rd: '] + ( a ? 2 ) ), ahịrị-ọhụrụ.
Mpụta dee: ( ['prd: '] + ( a product ) ), ahịrị-ọhụrụ.
a hazie: { :a :b <- (b - a). }.
a nke-ọ-bụla: { :i :e Mpụta dee: ( i - 0 ), ahịrị-ọhụrụ. }.

} bido.



Mmemme hichaa.
usedMemory3 := (Mmemme ebe-nchekwa ? 0).

( usedMemory1 = usedMemory2 na: usedMemory1 = usedMemory3, na: usedMemory2 = usedMemory3 ) eziokwu: {
	Mpụta dee: ['No memory leaks here'].
}, ụgha: {
	Mpụta dee: ['Leaking memory...'].
}.
