Mpụta dee: ['Test object'], ahịrị-ọhụrụ.
>> greeter := Ihe ohuru.
greeter mgbe-ọbịara: ['name:'] mee: { :aha
	nke-ya xname := aha. 
}.
greeter mgbe-ọbịara: ['greet'] mee: {
	Mpụta dee: ['Hello '] + nke-ya xname, ahịrị-ọhụrụ.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Mpụta dee: ['========== RELOADING SNAP:'], ahịrị-ọhụrụ.
>> b := Ihe load-from: ['/tmp/a.bin'].
>> c := Ihe load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
