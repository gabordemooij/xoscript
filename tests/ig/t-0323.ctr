

Mmemme hichaa.


>> Veggy := Ihe ohuru.
Veggy mgbe-ọbịara: ['ohuru'] mee: {
	>> v := onwe ohuru.
	v init. <- v.
}.

Veggy mgbe-ọbịara: ['init'] mee: { nke-ya veggies := 0. }.

Veggy mgbe-ọbịara: ['carrots:'] mee: { :a nke-ya veggies := a. <- Efu. }.
Veggy mgbe-ọbịara: ['carrots'] mee: { <- nke-ya veggies. }.
Veggy mgbe-ọbịara: ['+'] mee: { :f
	>> n := Veggy ohuru.
	n carrots: (f carrots + nke-ya veggies). <- n.
}.

Veggy mgbe-ọbịara: ['ederede'] mee: { <- nke-ya veggies ederede.
}.

Nọmba mgbe-ọbịara: ['carrots'] mee: {
	>> x := Veggy ohuru.
	x carrots: onwe. <- x.
}.

Nọmba mgbe-ọbịara: ['add:and:'] mee: { :a :b <- (a + b).
}.

>> q := 0 add: (3 carrots + 2 carrots) and: 4 carrots.
Mpụta dee: q, ahịrị-ọhụrụ.
