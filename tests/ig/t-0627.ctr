

# create a 64-bit integer for exact calculations
>> a := Int64 site-na-ederede: ['123'].

# to string
Mpụta dee: a, ahịrị-ọhụrụ.

# divide
Mpụta dee: a / (Int64 site-na-ederede: ['3']), ahịrị-ọhụrụ.

# multiply
Mpụta dee: a * (Int64 site-na-ederede: ['2']), ahịrị-ọhụrụ.

# add
Mpụta dee: a + (Int64 site-na-ederede: ['1']), ahịrị-ọhụrụ.

# subtract
Mpụta dee: a - (Int64 site-na-ederede: ['2']), ahịrị-ọhụrụ.

# compare
Mpụta dee: ( a =   (Int64 site-na-ederede: ['123'])), ahịrị-ọhụrụ.
Mpụta dee: ( a !=: (Int64 site-na-ederede: ['124'])), ahịrị-ọhụrụ.
Mpụta dee: ( a <   (Int64 site-na-ederede: ['124'])), ahịrị-ọhụrụ.
Mpụta dee: ( a >   (Int64 site-na-ederede: ['122'])), ahịrị-ọhụrụ.
Mpụta dee: ( a >=: (Int64 site-na-ederede: ['123'])), ahịrị-ọhụrụ.
Mpụta dee: ( a <=: (Int64 site-na-ederede: ['123'])), ahịrị-ọhụrụ.





	