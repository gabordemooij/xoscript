# line breaks in values must not create extra headers
Server kwadebe.
Mmemme jiri: ['../../../src/xo/ig/webtools.xo'].
Mmemme jiri: ['../../../src/xo/ig/mailtools.xo'].

>> isi := Isi-HTTP ohuru igodo: ['Location'] uru: ['/ok\r\nX-Injected: yes'].
Mpụta dee: isi.

>> web := Akwụkwọ-Weebụ ohuru.
web gaa-na: ['/ok\r\nX-Injected: yes'].
Mpụta dee: ['\n'], ahịrị-ọhụrụ.

>> mail := Ozi-eletrọnik ohuru.
mail nye: (Ndepụta ohuru ; ['a@example.invalid\r\nX-To: yes']).
mail cc: (Ndepụta ohuru ; ['b@example.invalid\r\nX-Cc: yes']).
mail bcc: (Ndepụta ohuru ; ['c@example.invalid\r\nX-Bcc: yes']).
mail onye-ziri: ['d@example.invalid\r\nX-From: yes'] aha: ['site\r\nX-Name: yes'].
mail isiokwu: ['hello\r\nX-Subject: yes'].
mail ahụ: ['line1\r\nline2'].
Mpụta dee: mail mepụta.

>> html := Ozi-eletrọnik-HTML ohuru.
html nye: (Ndepụta ohuru ; ['a@example.invalid\r\nX-To: yes']).
html onye-ziri: ['d@example.invalid'] aha: ['site'].
html isiokwu: ['hello\r\nX-Subject: yes'].
html ahụ: ['body'].
Mpụta dee: ( html mepụta nwere: ['\nX-'] ), ahịrị-ọhụrụ.
Mpụta dee: ( html mepụta nwere: ['X-To: yes'] ), ahịrị-ọhụrụ.
