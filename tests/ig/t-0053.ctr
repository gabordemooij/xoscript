60 × {
	>> x := (Nọmba random % 6) + 1.
	(x ≤ 6) ụgha: { Mpụta dee: ['FAIL']. }.
	(x ≥0) ụgha: { Mpụta dee: ['FAIL']. }.
	x := (Nọmba random % 3) + 1.
	(x < 3) ụgha: { Mpụta dee: ['FAIL']. }.
	(x>-1) ụgha: { Mpụta dee: ['FAIL']. }.
	x := ((Boolean flip) nọmba).
	(x = 0 ma-ọ-bụ: x = 1) ụgha: { Mpụta dee: ['FAIL']. }.
	x := ((Eziokwu flip) nọmba).
	(x = 0 ma-ọ-bụ: x = 1) ụgha: { Mpụta dee: ['FAIL']. }.
	x := (Boolean flip nke-a: ['HEAD'] ma-ọ-bụ-nke-ahụ: ['TAIL']).
	((x = ['HEAD']) ma-ọ-bụ: (x = ['TAIL'])) ụgha: { Mpụta dee: ['FAIL']. }.
}.
Mpụta dee: ['DONE'].

