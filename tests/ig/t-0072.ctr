>> echo := Ihe ohuru.
echo mgbe-ọbịara: ['zaghachi:'] mee: { :sound
	{ Mpụta dee: sound. } × 2.
}.
echo ho!. 


echo := Ihe ohuru.
echo mgbe-ọbịara: ['zaghachi:na:'] mee: { :sound :x
	{ Mpụta dee: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := Ihe ohuru.
echo mgbe-ọbịara: ['zaghachi:na:na:'] mee: { :operation :sound :x
	{ Mpụta dee: sound. } × x.
}.
echo shout: ['la'] times: 4. 


