# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Igbe-nchekwa mepụta-igodo.

# private (secret) key
>> sk := keys mbụ.

# public key
>> pk := keys nke-ikpeazụ.

# sign a message
>> sig := Igbe-nchekwa bịanye-aka: ['abc'] jiri: sk.

# check message (ok)
Mpụta dee: ( 
	Igbe-nchekwa
		lelee: ['abc'] 
		mbinye-aka: sig 
		jiri: pk 
), ahịrị-ọhụrụ.

# check message (fail)
Mpụta dee: ( 
	Igbe-nchekwa 
		lelee: ['abd'] 
		mbinye-aka: sig 
		jiri: pk 
), ahịrị-ọhụrụ.