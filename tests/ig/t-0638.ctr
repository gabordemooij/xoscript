
Server init.
>> rq := Arịrịọ-HTTP ohuru.
Mpụta dee: ['HTTP-GET d[]=']  + ( rq get-ndepụta: ['d[]'] ), ahịrị-ọhụrụ. # GET
Mpụta dee: ['HTTP-GET f[]=']  + ( rq get-ndepụta: ['f[]'] ), ahịrị-ọhụrụ. # GET
Mpụta dee: ['HTTP-POST e[]='] + ( rq post-ndepụta: ['e[]'] ), ahịrị-ọhụrụ. # GET
Mpụta dee: ['HTTP-POST c=']   + ( rq post: ['c'] ), ahịrị-ọhụrụ. # GET
Mpụta dee: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), ahịrị-ọhụrụ. # GET
