#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Mmemme njikwa-ebe-nchekwa: 0.

{
Oge oge.
Oge chere: 1.
Mpụta dee: Mmemme ọnụ-ntinye, ahịrị-ọhụrụ.
Mmemme ntinye: 0.
Nọmba random.
Mpụta dee: (Mmemme sistemụ: ['echo 'Hello'']).
} bido.

Mmemme hichaa.
usedMemory1 := (Mmemme ebe-nchekwa ? 0).

{
Oge oge.
Oge chere: 1.
Mpụta dee: Mmemme ọnụ-ntinye, ahịrị-ọhụrụ.
Mmemme ntinye: 0.
Nọmba random.
Mpụta dee: (Mmemme sistemụ: ['echo 'Hello'']).
} bido.

Mmemme hichaa.
usedMemory2 := (Mmemme ebe-nchekwa ? 0).

{
Oge oge.
Oge chere: 1.
Mpụta dee: Mmemme ọnụ-ntinye, ahịrị-ọhụrụ.
Mmemme ntinye: 0.
Nọmba random.
Mpụta dee: (Mmemme sistemụ: ['echo 'Hello'']).
} bido.

Mmemme hichaa.
usedMemory3 := (Mmemme ebe-nchekwa ? 0).



( usedMemory1 = usedMemory2 na: usedMemory1 = usedMemory3, na: usedMemory2 = usedMemory3 ) eziokwu: {
	Mpụta dee: ['No memory leaks here'].
}, ụgha: {
	Mpụta dee: ['Leaking memory...'].
}.
