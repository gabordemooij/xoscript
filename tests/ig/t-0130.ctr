# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Mmemme ntọala: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server njikọ: ( Ndepụta ohuru ;
 libname ; ['fopen'] ;
 ( Ndepụta ohuru ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
njikọ: ( Ndepụta ohuru ;
 Efu ; # means same lib
 ['fread'] ;
 ( Ndepụta ohuru ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Efu ; # means same object (i.e. Stream)
 ['fread']
),
njikọ: (
 Ndepụta ohuru ;
 Efu ; # means same lib
 ['fwrite'] ;
 ( Ndepụta ohuru ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Efu ; # means same lib
 ['fwrite']
),
njikọ: (
 Ndepụta ohuru ;
 Efu ; # means same lib
 ['rewind'] ;
 ( Ndepụta ohuru ; ['pointer'] ) ;
 ['int'] ;
 Efu ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> ụzọ-faịlụ := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: ụzọ-faịlụ mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream ozi: ['fwrite'] ntinye-ya: (Ndepụta ohuru ; str ; 1 ; 6 ; fd ).
Mpụta dee: bytes-written, ahịrị-ọhụrụ.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob ohuru: 20.

# read from file
>> bytes-read := Stream ozi: ['fread'] ntinye-ya: (Ndepụta ohuru ; buf ; 1 ; 6 ; fd ).
Mpụta dee: bytes-read, ahịrị-ọhụrụ.
Mpụta dee: buf, ahịrị-ọhụrụ.

# free memory
str  hapụ.
ụzọ-faịlụ hapụ.
mode hapụ.
buf  hapụ.


