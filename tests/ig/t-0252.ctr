#Linux
>> clock := Oge ohuru.
clock mpaghara: ['UTC-1'].
clock afọ: 1981, ọnwa: 1, ụbọchị: 5,
      elekere: 13, nkeji: 15, sekọnd: 13.

Mpụta dee: clock, ahịrị-ọhụrụ.
clock mpaghara: ['UTC+0'].

Mpụta dee: (
	(clock afọ nkịtị) + ['-'] + (clock ọnwa) + ['-'] + (clock ụbọchị) + [' '] +
	(clock elekere) + [':'] + (clock nkeji) + [':'] + (clock sekọnd) + [' '] +
	['W'] + (clock izu) + (clock mpaghara)
), ahịrị-ọhụrụ.


clock mpaghara: ['UTC-1'].
Mpụta dee: (
	(clock afọ nkịtị) + ['-'] + (clock ọnwa) + ['-'] + (clock ụbọchị) + [' '] +
	(clock elekere) + [':'] + (clock nkeji) + [':'] + (clock sekọnd) + [' '] +
	['W'] + (clock izu) + (clock mpaghara)
), ahịrị-ọhụrụ.
