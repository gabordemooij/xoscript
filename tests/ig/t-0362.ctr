Mpụta dee: (['a:b:'] - [':']), ahịrị-ọhụrụ.
Mpụta dee: (['Lorem Ipsum'] - ['Ipsum']), ahịrị-ọhụrụ.
Mpụta dee: (['a.................b.......................c...........'] - ['.']), ahịrị-ọhụrụ.
Mpụta dee: (['a--b--c---d'] - ['--']), ahịrị-ọhụrụ.
Mpụta dee: (['-'] - ['--']), ahịrị-ọhụrụ.
Mpụta dee: ([''] - ['--']), ahịrị-ọhụrụ.
Mpụta dee: (['--'] - ['']), ahịrị-ọhụrụ.
Mpụta dee: ([''] - ['']), ahịrị-ọhụrụ.
>> x := ['xx'].
>> y := x - ['x'].
Mpụta dee: x, ahịrị-ọhụrụ.
Mpụta dee: y, ahịrị-ọhụrụ.
>> x := ['a,bb,c'].
>> y := x dochie: [''] na: ['xx'].
Mpụta dee: ((x otu-ihe: y) nke-a: ['OK'] ma-ọ-bụ-nke-ahụ: ['BUG! Did return a copy by accident!']), ahịrị-ọhụrụ.