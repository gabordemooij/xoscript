

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Mmemme njikwa-ebe-nchekwa: 0.

>> o := Ihe ohuru.
>> o2 := Ihe ohuru.
Mpụta dee: o Efu?, ahịrị-ọhụrụ.
Mpụta dee: o ụdị, ahịrị-ọhụrụ.
Mpụta dee: ( o otu-ihe: o ), ahịrị-ọhụrụ.
Mpụta dee: ( o otu-ihe: o2 ), ahịrị-ọhụrụ.
Mpụta dee: o onwe-m, ahịrị-ọhụrụ.
Mpụta dee: ( o mee emeela ), ahịrị-ọhụrụ.

Mmemme hichaa.

usedMemory1 := (Mmemme ebe-nchekwa ? 0).


