>> x := Oge ohuru.
x mpaghara: ['CEST'],
afọ:2017,
ọnwa:01,
ụbọchị:10,
elekere: 10,
nkeji: 0,
sekọnd: 0.

Mpụta dee: x, ahịrị-ọhụrụ.

Mpụta dee: x oge, ahịrị-ọhụrụ.

x gbakwunye: 1 sekọnd.
x gbakwunye: 2 nkeji.
x gbakwunye: 3 elekere.
x gbakwunye: 4 ụbọchị.
x gbakwunye: 1 ọnwa.
x gbakwunye: 6 afọ.

Mpụta dee: x, ahịrị-ọhụrụ.

x wepụ: 1 sekọnd.
x wepụ: 2 nkeji.
x wepụ: 3 elekere.
x wepụ: 4 ụbọchị.
x wepụ: 1 ọnwa.
x wepụ: 6 afọ.

Mpụta dee: x, ahịrị-ọhụrụ.

>> y := x detuo.
>> z := x.

Mpụta dee: y, ahịrị-ọhụrụ.
Mpụta dee: z, ahịrị-ọhụrụ.
Mpụta dee: (x mpaghara = y mpaghara), ahịrị-ọhụrụ.
Mpụta dee: (x oge = y oge), ahịrị-ọhụrụ.
Mpụta dee: (x = z), ahịrị-ọhụrụ.
Mpụta dee: x ụbọchị-nke-afọ, ahịrị-ọhụrụ.
Mpụta dee: x ubochi-izu, ahịrị-ọhụrụ.
Mpụta dee: x izu, ahịrị-ọhụrụ.
