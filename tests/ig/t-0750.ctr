Mpụta dee: ['Test object'], ahịrị-ọhụrụ.
>> a := Ihe ohuru. 

a mgbe-ọbịara: ['item:'] mee: { :nil
	nke-ya nil := nil. 
}.

a mgbe-ọbịara: ['item'] mee: { <- nke-ya nil.
}.

a item: Efu.

Mpụta dee: a item, ahịrị-ọhụrụ.

>> old-nil-address := a item ihe-nlereanya adreesị-ebe-nchekwa.
a save-as: ['/tmp/a.bin'].
Mpụta dee: ['========== RELOADING SNAP:'], ahịrị-ọhụrụ.

>> b := Ihe load-from: ['/tmp/a.bin'].

(b item ihe-nlereanya adreesị-ebe-nchekwa = old-nil-address) eziokwu: {
	Mpụta dee: ['Object link re-attached.'], ahịrị-ọhụrụ.
}.

Mpụta dee: b item, ahịrị-ọhụrụ.
