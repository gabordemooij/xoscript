Mpụta dee: ['Test object'], ahịrị-ọhụrụ.
>> a := Ihe ohuru. 
a mgbe-ọbịara: ['item:'] mee: { :int64
	nke-ya int64 := int64. 
}.
a mgbe-ọbịara: ['item'] mee: { <- nke-ya int64.
}.
a item: ( Int64 site-na-ederede: ['9999'] ).
Mpụta dee: a item, ahịrị-ọhụrụ.
>> old-int64-address := a item ihe-nlereanya adreesị-ebe-nchekwa.
a save-as: ['/tmp/a.bin'].
Mpụta dee: ['========== RELOADING SNAP:'], ahịrị-ọhụrụ.
>> b := Ihe load-from: ['/tmp/a.bin'].
(b item ihe-nlereanya adreesị-ebe-nchekwa = old-int64-address) eziokwu: {
	Mpụta dee: ['Object link re-attached.'], ahịrị-ọhụrụ.
}.
Mpụta dee: ( b item ), ahịrị-ọhụrụ.
