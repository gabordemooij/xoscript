# test buffers PKI/Sign 
Server init.

>> long := ( Ndepụta ohuru mejupụta: 1000 na: ['a'] ) jikọọ: [''].

# sign a message
Mpụta dee: ( 
	Igbe-nchekwa bịanye-aka: ['abc'] jiri: long
), ahịrị-ọhụrụ.

Mpụta dee: ( 
	Igbe-nchekwa
		lelee: ['abc'] 
		mbinye-aka: long 
		jiri: long
), ahịrị-ọhụrụ.

Mpụta dee: (
	Igbe-nchekwa hash-okwuntughe: long nyochaa: long
), ahịrị-ọhụrụ.
