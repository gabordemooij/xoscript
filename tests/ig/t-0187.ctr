Nọmba mgbe-ọbịara: ['factorial'] mee: {
	>> total := 1.
	{ :index total mụbaa-site-na: (onwe - index). } × onwe. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Mmemme njikwa-ebe-nchekwa: 0.

{
2 exponent factorial.
Mpụta dee: (11 fọdụrụ: 3), ahịrị-ọhụrụ.
Mpụta dee: (3.4 gbaa-gburugburu), ahịrị-ọhụrụ.
Mpụta dee: (7.1 gbago-elu), ahịrị-ọhụrụ.
Mpụta dee: (7.9 gbadata-ala), ahịrị-ọhụrụ.
}
bido.

Mmemme hichaa.

usedMemory1 := (Mmemme ebe-nchekwa ? 0).

{
2 exponent factorial.
Mpụta dee: (11 fọdụrụ: 3), ahịrị-ọhụrụ.
Mpụta dee: (3.4 gbaa-gburugburu), ahịrị-ọhụrụ.
Mpụta dee: (7.1 gbago-elu), ahịrị-ọhụrụ.
Mpụta dee: (7.9 gbadata-ala), ahịrị-ọhụrụ.
}
bido.

Mmemme hichaa.
usedMemory2 := (Mmemme ebe-nchekwa ? 0).


{
2 exponent factorial.
Mpụta dee: (11 fọdụrụ: 3), ahịrị-ọhụrụ.
Mpụta dee: (3.4 gbaa-gburugburu), ahịrị-ọhụrụ.
Mpụta dee: (7.1 gbago-elu), ahịrị-ọhụrụ.
Mpụta dee: (7.9 gbadata-ala), ahịrị-ọhụrụ.
} bido.

Mmemme hichaa.
usedMemory3 := (Mmemme ebe-nchekwa ? 0).



( usedMemory1 = usedMemory2 na: usedMemory1 = usedMemory3, na: usedMemory2 = usedMemory3 ) eziokwu: {
	Mpụta dee: ['No memory leaks here'].
}, ụgha: {
	Mpụta dee: ['Leaking memory...'].
}.
