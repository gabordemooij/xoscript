

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Mmemme njikwa-ebe-nchekwa: 0.

>> a := Ndepụta ← ['hello'] ; ['world'] ; Eziokwu ; Efu ; 666.
a mee wepụ-nke-ikpeazụ wepụ-nke-mbụ tinye-na-mbido: ['hi'], tinye-na-njedebe: 999, emeela.
Mpụta dee: ( a jikọọ: [','] ), ahịrị-ọhụrụ.

Mmemme hichaa.
usedMemory1 := (Mmemme ebe-nchekwa ? 0).


a := Ndepụta ← ['hello'] ; ['world'] ; Eziokwu ; Efu ; 666.
a wepụ-nke-ikpeazụ. a wepụ-nke-mbụ. a tinye-na-mbido: ['hi'], tinye-na-njedebe: 999.
Mpụta dee: ( a jikọọ: [','] ), ahịrị-ọhụrụ.


