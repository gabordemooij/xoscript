
>> Rectangle := Ihe ohuru.

Rectangle mgbe-ọbịara: ['area'] mee: { <- nke-ya ogologo * nke-ya width.
}.

Rectangle mgbe-ọbịara: ['length:'] mee: { :ogologo
	nke-ya ogologo := ogologo.
}.

Rectangle mgbe-ọbịara: ['width:'] mee: { :width
	nke-ya width := width.
}.

Rectangle mgbe-ọbịara: ['ohuru'] mee: {
	# this will not result into an infinite loop
	>> rectangle := onwe ohuru.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle ohuru.
Mpụta dee: a area, ahịrị-ọhụrụ. #0

>> b := Rectangle ohuru length: 2, width: 3.
Mpụta dee: b area, ahịrị-ọhụrụ. #6

