Mpụta dee: ['Test object'], ahịrị-ọhụrụ.
>> a := Ihe ohuru. 

a mgbe-ọbịara: ['item:'] mee: { :num
	nke-ya num := num. 
}.

a mgbe-ọbịara: ['item'] mee: { <- nke-ya num.
}.

a item: 123.

Mpụta dee: a item, ahịrị-ọhụrụ.

>> old-num-address := a item ihe-nlereanya adreesị-ebe-nchekwa.
a save-as: ['/tmp/a.bin'].
Mpụta dee: ['========== RELOADING SNAP:'], ahịrị-ọhụrụ.

>> b := Ihe load-from: ['/tmp/a.bin'].

(b item ihe-nlereanya adreesị-ebe-nchekwa = old-num-address) eziokwu: {
	Mpụta dee: ['Object link re-attached.'], ahịrị-ọhụrụ.
}.

Mpụta dee: b item, ahịrị-ọhụrụ.
