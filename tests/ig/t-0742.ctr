Mpụta dee: ['Test object'], ahịrị-ọhụrụ.
>> a := Ihe ohuru. 

a mgbe-ọbịara: ['item:'] mee: { :hexhelper
	nke-ya hexhelper := hexhelper. 
}.

a mgbe-ọbịara: ['item'] mee: { <- nke-ya hexhelper.
}.

a item: Hx ohuru.

>> old-hexhelper-address := a item ihe-nlereanya adreesị-ebe-nchekwa.
a save-as: ['/tmp/a.bin'].
Mpụta dee: ['========== RELOADING SNAP:'], ahịrị-ọhụrụ.

>> b := Ihe load-from: ['/tmp/a.bin'].

(b item ihe-nlereanya adreesị-ebe-nchekwa = old-hexhelper-address) eziokwu: {
	Mpụta dee: ['Object link re-attached.'], ahịrị-ọhụrụ.
}.
