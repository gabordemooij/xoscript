# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB ohuru onye-nnabata: ['localhost'],
	aha-onye-ọrụ: ['xo'],
	okwuntughe: ['pass123'],
	aha-nchekwa-data: ['xobase'],
	jikọta.

>> ihe-ọchụchọ := db ajụjụ: ['SELECT %% FROM'].
{ ihe-ọchụchọ mezuo. } jide: { :e
	Mpụta dee: ( e nwere: ['%%'] ), ahịrị-ọhụrụ.
}, bido.
