#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Ụkpụrụ-ọchụchọ ohuru: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern dakọtara: subject mee: { :m :x
	Mpụta dee: m, ahịrị-ọhụrụ.
	Mpụta dee: x, ahịrị-ọhụrụ. <- ['XXX'].
}.
Mpụta dee: result, ahịrị-ọhụrụ.