Nọmba mgbe-ọbịara: ['roman'] mee: {
	>> nọmba := onwe detuo.
	>> roman := [''].
	{
		{
			(nọmba ≥ 1000) eziokwu: {
				roman tinye-na-njedebe: ['Ⅿ'].
				nọmba wepụ: 1000.
			}, kwụsịtụ.
		
			(nọmba ≥ 500) eziokwu: {
				roman tinye-na-njedebe: ['Ⅾ'].
				nọmba wepụ: 500.
			}, kwụsịtụ.
		
			(nọmba ≥ 100) eziokwu: {
				roman tinye-na-njedebe: ['Ⅽ'].
				nọmba wepụ: 100.
			}, kwụsịtụ.
		
			(nọmba ≥ 50) eziokwu: {
				roman tinye-na-njedebe: ['Ⅼ'].
				nọmba wepụ: 50.
			}, kwụsịtụ.
		
			(nọmba ≥ 50) eziokwu: {
				roman tinye-na-njedebe: ['Ⅼ'].
				nọmba wepụ: 50.
			}, kwụsịtụ.
		
			(nọmba ≥ 10) eziokwu: {
				roman tinye-na-njedebe: ['Ⅹ'].
				nọmba wepụ: 10.
			}, kwụsịtụ.
			
			(nọmba ≥ 9) eziokwu: {
				roman tinye-na-njedebe: ['Ⅸ'].
				nọmba wepụ: 9.
			}, kwụsịtụ.
			
			(nọmba ≥ 5) eziokwu: {
				roman tinye-na-njedebe: ['Ⅴ'].
				nọmba wepụ: 5.
			}, kwụsịtụ.
			
			(nọmba ≥ 4) eziokwu: {
				roman tinye-na-njedebe: ['Ⅳ'].
				nọmba wepụ: 4.
			}, kwụsịtụ.
			
			(nọmba ≥ 1) eziokwu: {
				roman tinye-na-njedebe: ['Ⅰ'].
				nọmba wepụ: 1.
			}, kwụsịtụ.
		} usoro.
	} ka-ọ-dị: { <- nọmba > 0. }. <- roman.
}.

Mpụta dee: 1 roman, ahịrị-ọhụrụ.
Mpụta dee: 2 roman, ahịrị-ọhụrụ.
Mpụta dee: 4 roman, ahịrị-ọhụrụ.
Mpụta dee: 8 roman, ahịrị-ọhụrụ.
Mpụta dee: 16 roman, ahịrị-ọhụrụ.
Mpụta dee: 32 roman, ahịrị-ọhụrụ.
Mpụta dee: 64 roman, ahịrị-ọhụrụ.
Mpụta dee: 128 roman, ahịrị-ọhụrụ.
Mpụta dee: 256 roman, ahịrị-ọhụrụ.
Mpụta dee: 1024 roman, ahịrị-ọhụrụ.
