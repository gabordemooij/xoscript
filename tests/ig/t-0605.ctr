>> invoice := Ihe ohuru.
invoice mgbe-ọbịara: ['bido'] mee: {
        nke-ya nọmba := 0.
}.

invoice mgbe-ọbịara: ['nọmba'] mee: {
        nke-ya nọmba gbakwunye: 1. <- nke-ya nọmba detuo.
}.

>> year-invoice := invoice ohuru.
year-invoice mgbe-ọbịara: ['start:'] mee: { :afọ
	nke-ya nọmba := afọ.
}.

year-invoice start: 202000.
Mpụta dee: year-invoice nọmba, ahịrị-ọhụrụ.
Mpụta dee: year-invoice nọmba, ahịrị-ọhụrụ.
