# compliance test

# use international numbers

Mpụta dee: ['1000 -> '].
Mpụta dee: 1000, ahịrị-ọhụrụ. #1000

Mpụta dee: ['1.5 -> '].
Mpụta dee: 1.5, ahịrị-ọhụrụ.  #1.5

Mpụta dee: ['1001.5 -> '].
Mpụta dee: 1.5 + 1000, ahịrị-ọhụrụ. #1001.5

# use 0-indexed arrays
>> x := Ndepụta ohuru ; 1 ; 2 ; 3.
>> y := Ndepụta ohuru ; ['a'] ; ['b'] ; ['c'].

Mpụta dee: ['1 -> '].
Mpụta dee: x ? 0, ahịrị-ọhụrụ. #1

Mpụta dee: ['1 -> '].
Mpụta dee: (x ebe: 0), ahịrị-ọhụrụ. #1

Mpụta dee: ['1 -> '].
Mpụta dee: x mbụ, ahịrị-ọhụrụ. #1

Mpụta dee: ['3 -> '].
Mpụta dee: x nke-ikpeazụ, ahịrị-ọhụrụ. #3

Mpụta dee: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Mpụta dee: (x site-na: y), ahịrị-ọhụrụ.

Mpụta dee: ['1 -> '].
Mpụta dee: (x site-na: 0 ogologo: 1) mbụ, ahịrị-ọhụrụ. #1

Mpụta dee: ['0 -> '].
Mpụta dee: (x chọta: 1), ahịrị-ọhụrụ. #0

x tinye: 9 na: 0.

Mpụta dee: ['9 -> '].
Mpụta dee: (x ebe: 0), ahịrị-ọhụrụ. #9

x tinye-na-mbido: 8.
Mpụta dee: ['8 -> '].
Mpụta dee: (x ebe: 0), ahịrị-ọhụrụ. #9


