# test number -> string -> number
{

	>> x := Nọmba netiti: 0 ruo: 1000000.
	>> d := Nọmba netiti: 1 ruo: 7.
	>> e := 10 ike-ọnụọgụ: d.

	x kee-site-na: e.
	>> y := x ederede nọmba.

	(x = y) ụgha: {
		Mpụta dee: x, ahịrị-ọhụrụ.
		Mpụta dee: y, ahịrị-ọhụrụ.
		Mmemme njedebe.
	}.

} * 1000.
Mpụta dee: ['OK'], ahịrị-ọhụrụ.