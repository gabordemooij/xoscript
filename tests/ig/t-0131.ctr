
>> a := Ndepụta ← (Ndepụta ← 100 ; 200 ; 300) ; (Ndepụta ← 9 ; 8 ; 7).
Mpụta dee: ['at 0,1 :'].
Mpụta dee: a ? 0 ? 1, ahịrị-ọhụrụ. 
Mpụta dee: ['at 1,2 :'].
Mpụta dee: a ? 1 ? 2, ahịrị-ọhụrụ. 
>> menu := Akwụkwọ-okwu ohuru.
menu tinye: (Ndepụta ← ['pizza'] ; ['spaghetti']) na: ['Italian Cuisine'].
menu tinye: (Ndepụta ← ['bifteki'] ; ['suflaki']) na: ['Greek Cuisine'].
Mpụta dee: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), ahịrị-ọhụrụ. 
Mpụta dee: ['but not on the same plate.'], ahịrị-ọhụrụ.
