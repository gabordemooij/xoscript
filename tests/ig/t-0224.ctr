
>> countries := Ndepụta ohuru
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Ndepụta ohuru
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods site-na: countries, nke-ọ-bụla: { :key :value
	counter gbakwunye: 1.
}.

Mpụta dee: (['we serve counter dishes'] counter: counter), ahịrị-ọhụrụ.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] mkpụrụedemede-niile hazie: { :v
	counter gbakwunye: 0.
}.

Mpụta dee: (['we sort counter dishes'] counter: counter), ahịrị-ọhụrụ.


>> counter := 0.
{
	{
		counter gbakwunye: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Mpụta dee: (['we calculate counter numbers.'] counter: counter), ahịrị-ọhụrụ.

