Server init.
>> fmt := Usoro-ọdịdị ohuru: ['%#3x'].

>> blob := Blob ohuru: 4.
blob bytes: ( 
	Ndepụta ohuru ; 0 ; 1 ; 2 ; 3
).

>> file := Faịlụ ohuru: ['/tmp/blob'].
file blob: blob.
blob hapụ.

>> gụọ := file blob.
gụọ 
site-na: 0 
ogologo: 4, 
mee nke-ọ-bụla: { :i :b 
	Mpụta
	dee: (fmt tinye-nọrụ-ọnụọgụ-zuru: b),
	ahịrị-ọhụrụ.
}.
gụọ hapụ.
