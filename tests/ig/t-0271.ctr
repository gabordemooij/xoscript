
Mmemme njikwa-ebe-nchekwa: 1.
Mmemme ebe-nchekwa: 16000000.
>> tokens := ['{}↲.:,x() '].
{ :i
	>> koodu := [''].
	>> x := Nọmba netiti: 1 ruo: 10.
	{
		>> y := Nọmba netiti: 1 ruo: (tokens ogologo).
		koodu tinye-na-njedebe: (tokens mkpụrụedemede: y).
	} × x.
	{ Ọrụ ohuru: koodu. } jide: { ['Empty']. }, bido.

} × 10000.
Mpụta dee: ['OK'], ahịrị-ọhụrụ.
