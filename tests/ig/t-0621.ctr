>> phrases := Ndepụta ohuru
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases nke-ọ-bụla: { :_ :phrase 
	>> e := Server base64-tinye-koodu: phrase.
	>> d := Server base64-wepụ-koodu: e.
	Mpụta dee: (
		message detuo ~encoded: e, ~decoded: d
	), ahịrị-ọhụrụ.
}.
