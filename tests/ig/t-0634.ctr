# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Mmemme shell-escape: ['abc'].
Mpụta dee: c, ahịrị-ọhụrụ.
Mpụta dee: ( Mmemme sistemụ: ['echo '] + c ), ahịrị-ọhụrụ.

c := Mmemme shell-escape: ['a'b'c'].
Mpụta dee: c, ahịrị-ọhụrụ.
Mpụta dee: ( Mmemme sistemụ: ['echo '] + c ), ahịrị-ọhụrụ.

c := Mmemme shell-escape: ['a\'c'].
Mpụta dee: c, ahịrị-ọhụrụ.
Mpụta dee: ( Mmemme sistemụ: ['echo '] + c ), ahịrị-ọhụrụ.