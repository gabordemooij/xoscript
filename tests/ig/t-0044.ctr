>> list := Ndepụta ohuru.
list ~ ['hello'].
Mpụta dee: list ọnụ-ọgụgụ.
list tinye-na-njedebe: ['world'].
Mpụta dee: list ọnụ-ọgụgụ.
Mpụta dee: list wepụ-nke-ikpeazụ, dee: list ọnụ-ọgụgụ.
list tinye-na-njedebe: ['there'].
Mpụta dee: list ọnụ-ọgụgụ.
Mpụta dee: (list ọnọdụ: 0), dee: (list ọnọdụ: 1).
list tinye: ['xmas'] na: 1.
list tinye: ['merry'] na: 0.
Mpụta dee: list ọnụ-ọgụgụ.
Mpụta dee: (list ọnọdụ: 0), dee: (list ọnọdụ: 1).
