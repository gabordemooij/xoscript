
Mpụta dee: ['Break for-loop, 0-4.'], ahịrị-ọhụrụ.
{ :i
	Mpụta dee: ['iteration #'] + i, ahịrị-ọhụrụ.
	(i = 4) kwụsịtụ.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Mpụta dee: ['Break while-true loop, 0-4.'], ahịrị-ọhụrụ.
{
	Mpụta dee: ['iteration #'] + x, ahịrị-ọhụrụ.
	x gbakwunye: 1.
	((x < 5) ọ-bụghị) kwụsịtụ.
} ka-ọ-dị: xIsLessThan10.

Mpụta dee: ['Break while-false loop, 5,4.'], ahịrị-ọhụrụ.
{
	Mpụta dee: ['iteration #'] + x, ahịrị-ọhụrụ.
	x wepụ: 1.
	(x = 3) kwụsịtụ.
} ka-ọ-dị: { <- (x > 0). }.

Mpụta dee: ['Break times loop, 1-4.'], ahịrị-ọhụrụ.
{ :i
	Mpụta dee: ['iteration #'] + i, ahịrị-ọhụrụ.
	(i = 4) kwụsịtụ.
} × 5.

Mpụta dee: ['Break block, dont print line.'], ahịrị-ọhụrụ.
{ Eziokwu kwụsịtụ. Mpụta dee: ['dont write this!'], ahịrị-ọhụrụ. } bido.

Mpụta dee: ['Break block, dont fire catch...'], ahịrị-ọhụrụ.
{ Eziokwu kwụsịtụ. Mpụta dee: ['dont write this!'], ahịrị-ọhụrụ. } jide: { Mpụta dee: ['Dont catch this!']. }, bido.

Mpụta dee: ['Test Array each-loop: 0,1'], ahịrị-ọhụrụ.
(Ndepụta ← 1 ; 2 ; 3) gbanwee-nke-ọbụla: { :i
	Mpụta dee: ['iteration #'] + i, ahịrị-ọhụrụ.
	(i = 1) kwụsịtụ.
}.

Mpụta dee: ['Test Map each-loop: c only'], ahịrị-ọhụrụ.
>> m := Akwụkwọ-okwu ohuru.
m tinye: ['first'] na: ['a'], tinye: ['second'] na: ['b'], tinye: ['third'] na: ['c'].
m nke-ọ-bụla: { :k :v
	Mpụta dee: ['iteration'] + v + k, ahịrị-ọhụrụ.
	Eziokwu kwụsịtụ.
}.

