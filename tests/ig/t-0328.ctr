Mmemme njikwa-ebe-nchekwa: 4.

>> Doubler := Ihe ohuru.
>> Multiplier := Ihe ohuru.
Doubler mgbe-ọbịara: ['double:and:'] mee: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier mgbe-ọbịara: ['multiply:and:'] mee: { :x :y <- (x × y).
}.

Mpụta dee: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), ahịrị-ọhụrụ.
