>> Point := Ihe ohuru.
Point mgbe-ọbịara: ['x-coordinate:'] mee: { :x nke-ya x := x. }.
Point mgbe-ọbịara: ['y-coordinate:'] mee: { :y nke-ya y := y. }.
Point mgbe-ọbịara: ['x-coordinate']  mee: { <- nke-ya x detuo. }.
Point mgbe-ọbịara: ['y-coordinate']  mee: { <- nke-ya y detuo. }.

Point mgbe-ọbịara: ['='] mee: { :other <- ( nke-ya x = other x-coordinate
		 na: nke-ya y = other y-coordinate ).
}.

>> pier := Point ohuru x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point ohuru x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point ohuru x-coordinate: 5, y-coordinate: 6.

Mpụta dee: pier = town-hall, ahịrị-ọhụrụ.
Mpụta dee: pier = restaurant, ahịrị-ọhụrụ.
