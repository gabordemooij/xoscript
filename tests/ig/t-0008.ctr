>> Greeter := Ihe ohuru.
Greeter mgbe-ọbịara: ['make'] mee: {
	>> greeter := Ihe ohuru.
	greeter mgbe-ọbịara: ['name:'] mee: { :aha
		Mpụta dee: ['setting a name'].
		nke-ya myName := aha.
	}.
	greeter mgbe-ọbịara: ['greet'] mee: {
		Mpụta dee: ['Hello'].
		Mpụta dee: nke-ya myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
