#Linux

(Faịlụ ohuru: ['/tmp/testje']) dị ụgha: {
	Mmemme sistemụ: ['mkdir /tmp/testje'].	
}.

(Faịlụ ohuru: ['/tmp/testje/file1']) dị ụgha: {
	Mmemme sistemụ: ['touch /tmp/testje/file1'].	
}.

(Faịlụ ohuru: ['/tmp/testje/folder1']) dị ụgha: {
	Mmemme sistemụ: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Faịlụ ndepụta: ['/tmp/testje'].

>> q := Ndepụta ohuru.

l nke-ọ-bụla: { :k :v v nke-ọ-bụla: { :x :y q tinye-na-njedebe: y. }. }.

>> s := q ederede.

(s nwere: ['file1']) eziokwu:   { Mpụta dee: ['OK'], ahịrị-ọhụrụ. }.
(s nwere: ['file2']) eziokwu:   { Mpụta dee: ['XX'], ahịrị-ọhụrụ. }.
(s nwere: ['folder1']) eziokwu: { Mpụta dee: ['OK'], ahịrị-ọhụrụ. }.
