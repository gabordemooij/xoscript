# a value ending in the first part of an opening quote must survive serialization
>> uru-niile := Ndepụta ohuru
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

uru-niile nke-ọ-bụla: { :i :value
	>> d := Akwụkwọ-okwu ohuru.
	d tinye: value na: ['k'].
	d tinye: ['second'] na: ['j'].
	>> r := d koodu ihe.
	Mpụta dee: r ọnụ-ọgụgụ, ahịrị-ọhụrụ.
	Mpụta dee: ( (r ebe: ['k']) = value ), ahịrị-ọhụrụ.
}.
