(Efu = Efu) eziokwu: { Mpụta dee: ['Nil is Nil!'].}.
(2 > 1) eziokwu: { Mpụta dee: ['YES']. }.
(2 > 3) eziokwu: { Mpụta dee: ['NO']. }.
(2 > 3) ụgha: { Mpụta dee: ['Nonono..'].}.
Eziokwu eziokwu: { Mpụta dee: ['TRUE is TRUE!']. }.
(Eziokwu) eziokwu: { Mpụta dee: ['TRUE is TRUE!']. }.
Ụgha ụgha: { Mpụta dee: ['FALSE is FALSE!']. }.
(Ụgha) ụgha: { Mpụta dee: ['FALSE is FALSE!']. }.
