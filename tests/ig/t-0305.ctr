
Nọmba na-amụta: ['plus:'] pụtara: ['+'].
Nọmba mgbe-ọbịara: ['+'] mee: { :x
	>> rate := 1.
	>> currency := x ọtụtụ-nkeji.
	(currency = ['euros']) eziokwu: {
		rate := 2.
	}. <- (onwe plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars nkeji-ọtụtụ: ['dollars'].
euros nkeji-ọtụtụ: ['euros'].
>> money := dollars + euros.
Mpụta dee: money, ahịrị-ọhụrụ.
