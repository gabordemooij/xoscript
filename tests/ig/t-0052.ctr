>> items := Akwụkwọ-okwu ohuru.
items tinye: ['green'] na: ['color-1'].
items tinye: ['orange'] na: ['color-2'].
items tinye: ['red'] na: ['color-3'].
>> i := 0.
>> s := [''].
items nke-ọ-bụla: { :key :color
	Mpụta dee: ['color #'] + i + [' is: '] + color + [' '].
	i gbakwunye: 1.
}.
Mpụta dee: i + [' colors!'].
