# test url parsing

Server init.
>> url := URL isi-mmalite: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Mpụta dee: ['scheme = '] + url atụmatụ-adreesị, ahịrị-ọhụrụ.
Mpụta dee: ['host = '] + url onye-nnabata, ahịrị-ọhụrụ.
Mpụta dee: ['port = '] + url ọdụ, ahịrị-ọhụrụ.
Mpụta dee: ['path = '] + url ụzọ-faịlụ, ahịrị-ọhụrụ.
Mpụta dee: ['query = '] + url ihe-ọchụchọ, ahịrị-ọhụrụ.
Mpụta dee: ['fragment = '] + url iberibe, ahịrị-ọhụrụ.
