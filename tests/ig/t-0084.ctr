>> makeAdder := { :x
	>> f := { :y <- (nke-ya x + y). } dozie: ['x'] uru: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i nke-ya q tinye: (nke-ya f tinye-nọrụ: (nke-ya q ? i)) na: i. } 
	dozie: ['q'] uru: array,
	dozie: ['f'] uru: func.
	{ :i mapping tinye-nọrụ: i. } × (array ọnụ-ọgụgụ).
}.

>> a := Ndepụta ← 1; 2; 3.
mapper tinye-nọrụ: a na: (makeAdder tinye-nọrụ: 100).
Mpụta dee: (a ọnọdụ: 0), ahịrị-ọhụrụ.
Mpụta dee: (a ? 1), ahịrị-ọhụrụ.
Mpụta dee: (a ? 2), ahịrị-ọhụrụ.
