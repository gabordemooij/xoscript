(2 < 9) eziokwu: { Mpụta dee: ['Yes, nine is less than ten.']. }.
(9 < 2) eziokwu: { Mpụta dee: ['My logic fails']. }.
Mpụta dee: (-2 + 6).
Mpụta dee: (-3 - -3).
>> TrueIsNice := 3.
Mpụta dee: TrueIsNice.
>> FalseIsBad := ['Not true!'].
Mpụta dee: FalseIsBad.
>> NilIsEmpty := ['Yep'].
Mpụta dee: NilIsEmpty.
