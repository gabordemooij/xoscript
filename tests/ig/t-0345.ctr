# test catch-all methods
>> x13 := Ihe ohuru.
x13 mgbe-ọbịara: ['a'] mee: { :a Mpụta dee: 0, ahịrị-ọhụrụ. }.
x13 mgbe-ọbịara: ['a:'] mee: { :a Mpụta dee: a, ahịrị-ọhụrụ. <- 5. }.
x13 mgbe-ọbịara: ['a:b:'] mee: { :a :b Mpụta dee: (a + b), ahịrị-ọhụrụ. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
