>> winery := { <- (	Akwụkwọ-okwu ohuru
		tinye: 2 na: ['merlot'],
		tinye: 3 na: ['malbec'],
		tinye: 4 na: ['syrah']
	).
}.

Mpụta dee: (((winery bido) - ['nothing']) ọnụ-ọgụgụ), ahịrị-ọhụrụ.
Mpụta dee: (((winery bido) - ['merlot']) ọnụ-ọgụgụ), ahịrị-ọhụrụ.
Mpụta dee: (((winery bido) - ['malbec']) ọnụ-ọgụgụ), ahịrị-ọhụrụ.
Mpụta dee: (((winery bido) - ['syrah']) ọnụ-ọgụgụ), ahịrị-ọhụrụ.
Mpụta dee: (((winery bido) - ['merlot'] - ['malbec']) ọnụ-ọgụgụ), ahịrị-ọhụrụ.
Mpụta dee: (((winery bido) - ['merlot'] - ['syrah']) ọnụ-ọgụgụ), ahịrị-ọhụrụ.
Mpụta dee: (((winery bido) - ['malbec'] -['syrah']) ọnụ-ọgụgụ), ahịrị-ọhụrụ.
Mpụta dee: (((winery bido) - ['malbec'] - ['syrah'] - ['merlot']) ọnụ-ọgụgụ), ahịrị-ọhụrụ.

