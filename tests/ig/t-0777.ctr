#OBSD
>> dirname := [''].
{ dirname tinye-na-njedebe: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Mmemme sistemụ: command.
Mmemme chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename tinye-na-njedebe: ['YYYYYYYY']. } * 20.
Faịlụ ohuru: filename, dee: ['sometext'].
{ Faịlụ ndepụta: ['/tmp/'] + dirname. } * 1000.
Mpụta dee: ['no crash'], ahịrị-ọhụrụ.

