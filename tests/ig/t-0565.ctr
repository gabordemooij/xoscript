Server init.

>> message := ['this is a string to be encrypted!'].
>> key := ['secret123!'].
>> vault := Igbe-nchekwa ohuru: ['myvault'].

>> encrypted := vault zoo: message igodo: key.
>> decrypted := vault kpughee: encrypted igodo: key.

Mpụta 
dee: ['Message:'], ahịrị-ọhụrụ
dee: message, ahịrị-ọhụrụ
dee: ['Decrypted:'], ahịrị-ọhụrụ
dee: decrypted, ahịrị-ọhụrụ.
