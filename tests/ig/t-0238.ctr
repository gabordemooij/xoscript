Ederede mgbe-ọbịara: ['evaluate'] mee: {
	>> koodu := Faịlụ ohuru: ['/tmp/eval.ctr'].
	koodu dee: (onwe ederede + ['.']).
	Mmemme jiri: ['/tmp/eval.ctr'].
}.

>> a := Ndepụta ← 1 ; 2 ; 3.
>> b := (a ederede).

Mpụta dee: b, ahịrị-ọhụrụ. 
(['b := '] + b) evaluate.

Mpụta dee: b ? 2, ahịrị-ọhụrụ. 

Mpụta dee: (( Ndepụta ← 1 ; 2 ; 3 )), ahịrị-ọhụrụ. 

Mpụta dee: ((Akwụkwọ-okwu ohuru) tinye: 1 na: 2), ahịrị-ọhụrụ. 

>> x := ( (Ndepụta ← 1 ; ( Ndepụta ← 9 ) ; Eziokwu ) ) ederede.
Mpụta dee: x, ahịrị-ọhụrụ. 
(['x := '] + x) evaluate.

Mpụta dee: x ? 1 ? 0, ahịrị-ọhụrụ. 

>> y := (Akwụkwọ-okwu ohuru) tinye: (Ndepụta ← 1) na: (Ndepụta ← 2).
Mpụta dee: y, ahịrị-ọhụrụ. 

(['y := '] + y) ederede evaluate.

Mpụta dee: (y ebe: (Ndepụta ← 2) ederede ), ahịrị-ọhụrụ.

Mpụta dee: (Ndepụta ohuru), ahịrị-ọhụrụ. 
Mpụta dee: (Akwụkwọ-okwu ohuru), ahịrị-ọhụrụ. 
