>> Grandfather := Ihe ohuru.
Grandfather mgbe-ọbịara: ['greet'] mee: {
	Mpụta dee: ['Ave!'], ahịrị-ọhụrụ.
}.
>> Father := Grandfather ohuru.
Father mgbe-ọbịara: ['greet'] mee: {
	Mpụta dee: ['Hello'], ahịrị-ọhụrụ.
	onwe greet.
}.
>> Son := Father ohuru.
Son mgbe-ọbịara: ['greet'] mee: {
	Mpụta dee: ['Hi'], ahịrị-ọhụrụ.
	onwe greet.
}.

Son greet.

>> Roundabout := Ihe ohuru.
Roundabout mgbe-ọbịara: ['circle:'] mee: { :x
	Mpụta dee: x, ahịrị-ọhụrụ.
	(x < 3) eziokwu: { onwe nkpọghachi-onwe circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) eziokwu: { Mpụta dee: x, ahịrị-ọhụrụ. x gbakwunye: 1.  increment bido. }. }.
increment bido.