Mpụta dee: ['Test object'], ahịrị-ọhụrụ.
>> p := Ụzọ /tmp.
Mpụta dee: p, ahịrị-ọhụrụ.
>> old-p-address := p ihe-nlereanya adreesị-ebe-nchekwa.
p save-as: ['/tmp/a.bin'].
Mpụta dee: ['========== RELOADING SNAP:'], ahịrị-ọhụrụ.
>> b := Ihe load-from: ['/tmp/a.bin'].
(b ihe-nlereanya adreesị-ebe-nchekwa = old-p-address) eziokwu: {
	Mpụta dee: ['Object link re-attached.'], ahịrị-ọhụrụ.
}.
Mpụta dee: b, ahịrị-ọhụrụ.
