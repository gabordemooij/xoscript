# recursive interpolation not allowed

Mpụta dee: 
['recursive string interolation enabled: '] + (
	Mmemme njirimara: 
	['RECURSIVE_STRINTPOL']
), ahịrị-ọhụrụ.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Mpụta dee: a, ahịrị-ọhụrụ.


