


>> CoffeeMachine := Ihe ohuru.
CoffeeMachine mgbe-ọbịara: ['order:'] mee: { :id
	>> coffee := ['Americano'].
	( id = 1 ) eziokwu: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) eziokwu: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) eziokwu: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Ihe ohuru.
SimpleCoffeeMachine mgbe-ọbịara: ['order'] mee: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Mpụta dee: redCup, ahịrị-ọhụrụ.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Mpụta dee: greenCup, ahịrị-ọhụrụ.
>> yellowCup := CoffeeMachine order: 1.
Mpụta dee: yellowCup, ahịrị-ọhụrụ.
>> blueCup := CoffeeMachine order: 0.
Mpụta dee: blueCup, ahịrị-ọhụrụ.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Mpụta dee: blackCup, ahịrị-ọhụrụ.
blackCup tinye-na-njedebe: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Mpụta dee: orangeCup, ahịrị-ọhụrụ.
