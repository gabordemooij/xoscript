>> a := 3.
>> b := a detuo.
a wepụ: 1.
Mpụta dee: [' a = '] + a.
Mpụta dee: [' b = '] + b.
a := 3.
b := a + 4.
Mpụta dee: [' a = '] + a.
Mpụta dee: [' b = '] + b.
>> x := 3.
>> y := x detuo.
x gbakwunye: 10.
y wepụ: 1.
Mpụta dee: [' x = '] + x.
Mpụta dee: [' y = '] + y.
>> q := Ihe ohuru.
q mgbe-ọbịara: ['setProperty:'] mee: { :x
	nke-ya prop := x.
}.
q mgbe-ọbịara: ['getProperty'] mee: { <- nke-ya prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Mpụta dee: [' p = '] + (p getProperty).
