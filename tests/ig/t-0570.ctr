#Linux

 >> t := Oge ohuru.
 
t mpaghara: ['Europe/Amsterdam'].
t afọ: 2020, ọnwa: 8, ụbọchị: 2, elekere: 21, nkeji: 2, sekọnd: 1.

>> a := t elekere.
>> ams := t mpaghara.

t mpaghara: ['US/Hawaii'].
>> b := t elekere.
>> hw := t mpaghara.

Mpụta
dee: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		nke-a: ['later'] ma-ọ-bụ-nke-ahụ: ['earlier']
	)
),
ahịrị-ọhụrụ.
 