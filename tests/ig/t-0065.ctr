Nọmba mgbe-ọbịara: ['factorial'] mee: {
	>> total := 1.
	{ :index total mụbaa-site-na: (onwe - (index)). } × onwe. <- total.
}.
>> Printer := Ihe ohuru.
Printer mgbe-ọbịara: ['print:and:'] mee: { :x :y
	Mpụta dee: ['a='] + x + [', b='] + y, ahịrị-ọhụrụ.
}.
>> a := 4.5. >> b := a gbadata-ala.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a gbago-elu.
Printer print: a and: b.
a := 4.5. b := a gbadata-ala.
Printer print: a and: b.
a := 4.5. b := a gbaa-gburugburu.
Printer print: a and: b.
a := 4.2. b := a gbaa-gburugburu.
Printer print: a and: b.

Mpụta dee: (9 fọdụrụ: 5), ahịrị-ọhụrụ.
Mpụta dee: -666 uru-zuru-oke, ahịrị-ọhụrụ.
Mpụta dee: 49 mgbọrọgwụ-skwea, ahịrị-ọhụrụ.
Mpụta dee: (2 ike-ọnụọgụ: 3), ahịrị-ọhụrụ.
>> l := (Ndepụta ← 9 ; 6).
Mpụta dee: l nke-kacha-nta.

