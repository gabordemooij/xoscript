# a quote that never closes must give an error, not an endless loop
>> ụzọ-faịlụ := ['/tmp/test0821.csv'].
>> file := Faịlụ ohuru: ụzọ-faịlụ.

file dee: ['a,b\n"1,2\n'].
{
	file nkewa: [','] akara-nhota: ['"'] ahịrị-niile: { :line
		Mpụta dee: line, ahịrị-ọhụrụ.
	}.
} jide: { :e Mpụta dee: e, ahịrị-ọhụrụ. }, bido.

# a closed quote still works
file dee: ['a,b\n"1,2",3'].
file nkewa: [','] akara-nhota: ['"'] ahịrị-niile: { :line
	Mpụta dee: line, ahịrị-ọhụrụ.
}.
file hichapụ.
