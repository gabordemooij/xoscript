>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Ihe ohuru.
⚄ mgbe-ọbịara: ['drawFrom:length:'] mee: { :pool :ọnụ-ọgụgụ
	
	>> result := [''].
	
	{
		>> index := Nọmba random % (pool ogologo).
		result tinye-na-njedebe: ( pool mkpụrụedemede: (index + 1) ).
		
	} × ọnụ-ọgụgụ. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? ogologo.
Mpụta dee: (['x↵'] x random ogologo).
Mpụta dee: (['y↵'] y ?? ogologo).

