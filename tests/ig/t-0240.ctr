# test qualifiers

>> $ := Ihe ohuru.

$ mgbe-ọbịara: ['zaghachi:'] mee: { :x
	
	>> operation := x mkpụrụedemede: 0.
	>> valuta := x mkpụrụedemede: 1.
	>> money := x mafee: 2.
	
	>> amount := 0.

	( operation = ['+'] ) eziokwu: {
		( valuta = ['£'] ) eziokwu: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Mpụta dee: x, ahịrị-ọhụrụ.


>> Fruit := Ihe ohuru.

Fruit mgbe-ọbịara: ['ohuru'] mee: {
	>> f := onwe ohuru.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit mgbe-ọbịara: ['apples:'] mee: { :a nke-ya apples := a. }.
Fruit mgbe-ọbịara: ['oranges:'] mee: { :p nke-ya oranges := p. }.
Fruit mgbe-ọbịara: ['apples'] mee: { <- nke-ya apples. }.
Fruit mgbe-ọbịara: ['oranges'] mee: { <- nke-ya oranges. }.

Fruit mgbe-ọbịara: ['+'] mee: { :f
	
	>> n := Fruit ohuru.
	f gbakwunye: 1.
	
	n apples: (f apples + nke-ya apples).
	n oranges:  (f oranges  + nke-ya oranges). <- n.
}.

Fruit mgbe-ọbịara: ['ederede'] mee: { <- ( nke-ya apples ederede + [' apples and '] + nke-ya oranges + [' oranges'] ).
}.

Nọmba mgbe-ọbịara: ['apples'] mee: { <- ((Fruit ohuru) apples: onwe).
}.

Nọmba mgbe-ọbịara: ['apple'] mee: { <- ((Fruit ohuru) apples: onwe).
}.

Nọmba mgbe-ọbịara: ['oranges'] mee: { <- ((Fruit ohuru) oranges: onwe).
}.




Mpụta dee: (1 apple + 3 oranges + 4 apples), ahịrị-ọhụrụ.


Ederede mgbe-ọbịara: ['twice'] mee: { <- ((onwe ederede) + (onwe ederede)).
}.



Mpụta dee: ['❤❤❤'] twice.



