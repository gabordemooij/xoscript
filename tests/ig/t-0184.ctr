

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Mmemme njikwa-ebe-nchekwa: 0.

Nọmba mgbe-ọbịara: ['addNum:'] mee: { :x
	onwe gbakwunye: x.
}.

Nọmba mgbe-ọbịara: ['subtractNum:'] mee: { :x
	onwe wepụ: x.
}.

Nọmba mgbe-ọbịara: ['multiplyBy:'] mee: { :x
	onwe mụbaa-site-na: x.
}.

Nọmba mgbe-ọbịara: ['divideBy:'] mee: { :x
	onwe kee-site-na: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 ike-ọnụọgụ: 8).  
a := a + (2 ike-ọnụọgụ: -1). 
a := a + (49 mgbọrọgwụ-skwea).   
a addNum: ((Ndepụta ← 0 ; 1) nke-kacha-ukwuu).          
a addNum: ((Ndepụta ← 2 ; 3) nke-kacha-nta).
Mpụta dee: a.

Mmemme hichaa.

usedMemory1 := (Mmemme ebe-nchekwa ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 ike-ọnụọgụ: 8).  
a := a + (2 ike-ọnụọgụ: -1). 
a := a + (49 mgbọrọgwụ-skwea).   
a addNum: ((Ndepụta ← 0 ; 1) nke-kacha-ukwuu).          
a addNum: ((Ndepụta ← 2 ; 3) nke-kacha-nta).
Mpụta dee: a.

Mmemme hichaa.
usedMemory2 := (Mmemme ebe-nchekwa ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 ike-ọnụọgụ: 8).  
a := a + (2 ike-ọnụọgụ: -1). 
a := a + (49 mgbọrọgwụ-skwea).   
a addNum: ((Ndepụta ← 0 ; 1) nke-kacha-ukwuu).          
a addNum: ((Ndepụta ← 2 ; 3) nke-kacha-nta).
Mpụta dee: a.

Mmemme hichaa.
usedMemory3 := (Mmemme ebe-nchekwa ? 0).



( usedMemory1 = usedMemory2 na: usedMemory1 = usedMemory3, na: usedMemory2 = usedMemory3 ) eziokwu: {
	Mpụta dee: ['No memory leaks here'].
}, ụgha: {
	Mpụta dee: ['Leaking memory...'].
}.
