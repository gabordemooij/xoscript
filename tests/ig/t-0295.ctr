
>> dictionary := (
	Akwụkwọ-okwu ohuru
		tinye: ['b'] na: ['a'],
		tinye: ['a'] na: ['b'],
		tinye: ['z'] na: ['x'],
		tinye: ['hello'] na: ['hallo'],
		tinye: ['human'] na: ['human']
).

>> comparisons := Ndepụta ohuru.
dictionary nke-ọ-bụla: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a tulee: b)
	).
}.

comparisons hazie: { :a :b <- ( a tulee: b ). }.
Mpụta dee: ( comparisons jikọọ: ['↵'] ), ahịrị-ọhụrụ.
comparisons jikọọ: ['↵'].
