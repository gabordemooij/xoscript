# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob ohuru: 8, bytes: (
	Ndepụta ohuru ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Mpụta dee: ( utf16 wepụ-koodu: ['utf16le'] ), ahịrị-ọhụrụ.

utf16 hapụ.
>> utf32 := Blob ohuru: 13, bytes: (
	Ndepụta ohuru ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Mpụta dee: ( utf32 wepụ-koodu: ['utf32be'] ), ahịrị-ọhụrụ.
utf32 hapụ.