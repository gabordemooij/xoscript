

>> obj := Ihe ohuru.

obj mgbe-ọbịara: ['greet'] mee: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj mgbe-ọbịara: ['task'] mee: {
	nke-ya property := 123.
	{
		# try binds self/own to object instead of block
		Mpụta dee: onwe greet.
		Mpụta dee: nke-ya property.
		1 / 0.
	} jide: {
		Mpụta dee: onwe greet.
		Mpụta dee: nke-ya property.
		Mpụta dee: ['ok'].
	}, nwaa.
}.

obj task.