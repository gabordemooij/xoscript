

Ederede mgbe-ọbịara: ['evaluate'] mee: {
	>> koodu := Faịlụ ohuru: ['/tmp/eval.ctr'].
	koodu dee: (onwe ederede + ['.']).
	Mmemme jiri: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Ndepụta ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q ederede.
Mpụta dee: x, ahịrị-ọhụrụ.
>> y := Efu.
(['y := '] + x ) evaluate.
Mpụta dee: y ? 0, ahịrị-ọhụrụ.

q := Akwụkwọ-okwu tinye: ['\[''] na: ['\['quote\']'].
x := q ederede.
Mpụta dee: x, ahịrị-ọhụrụ.
y := Efu.
(['y := '] + x ) evaluate.

>> q := (Akwụkwọ-okwu ohuru) tinye:['\[''] na:['\['quote\[''].
Mpụta dee: y ? ['\['quote\']'], ahịrị-ọhụrụ.
