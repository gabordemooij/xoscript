# catch-all test (practical)
>> HTML := Текст саҥа.
HTML в: ['encode:'] сделать: { :tekst
	бэйэ эбэн-биэр: (tekst
	солбуй: ['&'] на: ['&amp;'], 
	солбуй: ['<'] на: ['&lt;'],
	солбуй: ['>'] на: ['&gt;'],
	солбуй: ['"'] на: ['&quot;']).
}.
>> blog := HTML саҥа.
blog эбэн-биэр: ['<h1>'],
     encode: ['Koffie & Thee'],
     эбэн-биэр: ['</h1>'].
Таһаарыы суруй: blog, стоп.


>> Roman := Чыыһыла саҥа.
Roman в: ['stringy'] сделать: {
	>> a := [''].
	{ a эбэн-биэр: ['I']. } × бэйэ. <- a.
}.

>> x := Roman саҥа.
x добавить: 3.
Таһаарыы суруй: x stringy, стоп.

>> Quantum := Логическай саҥа.
Quantum в: ['true?'] сделать: { <- ['maybe True']. }.
Таһаарыы суруй: (Quantum саҥа true?), стоп.

>> Nihil := Кураанах саҥа.
Nihil в: ['к-тексту'] сделать: { <- ['Nihil']. }.
Таһаарыы суруй: (Nihil саҥа), стоп.
