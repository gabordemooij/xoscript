Server init.
Таһаарыы суруй: ['Database time test'], стоп.

>> db := Maria-DB саҥа хост: ['localhost'],
	туһааччы-аата: ['xo'], 
	пароль: ['pass123'],
	база-аата: ['xobase'],
	холбон.

>> көрдөөһүн-параметрдара :=
db запрос: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
аҕал: { :row
	Таһаарыы суруй: row timetest, стоп.
}.
