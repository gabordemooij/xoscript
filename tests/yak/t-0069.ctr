

Текст в: ['html'] сделать: { <- (
		бэйэ
		солбуй: ['&'] на: ['&amp;'],
		солбуй: ['<'] на: ['&lt;'],
		солбуй: ['>'] на: ['&gt;'],
		солбуй: ['"'] на: ['&quot;']
	).
}.


Таһаарыы суруй: ([' left trimmed '] тулалыыр-итэҕэстэри-ыраастаа) + [' '] + ( ['and right trimmed'] тулалыыр-итэҕэстэри-ыраастаа) + ['!'], стоп.
Таһаарыы суруй: ['<html>"html & entities"</html>'] html.
