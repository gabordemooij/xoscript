>> phrases := Испииһэк саҥа
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases хас-биирдии: { :_ :phrase 
	>> e := Server base64-кодировать: phrase.
	>> d := Server base64-декодировать: e.
	Таһаарыы суруй: (
		message скопировать ~encoded: e, ~decoded: d
	), стоп.
}.
