Server init.
>> f := Формат саҥа: ['%d'].
>> a := Blob саҥа: 4.
a bytes: ( Испииһэк саҥа ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob саҥа: 4.
b bytes: ( Испииһэк саҥа ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a от: 0 уһуна: 3, хас-биирдии: { :i :byte
	Таһаарыы суруй: ( f туһан-бүтүн: byte ), стоп.
}.
a ^ b.
a от: 0 уһуна: 3, хас-биирдии: { :i :byte
	Таһаарыы суруй: ( f туһан-бүтүн: byte ), стоп.
}.
a ^ b.
a от: 0 уһуна: 3, хас-биирдии: { :i :byte
	Таһаарыы суруй: ( f туһан-бүтүн: byte ), стоп.
}.
a босхолоо.
b босхолоо.

{ a ^ Объект. } проблеманы-быһаарыы: { :e Таһаарыы суруй: e, стоп. }, саҕалаа.
