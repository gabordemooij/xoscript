


>> Deck := Испииһэк саҥа.
Deck в: ['print'] сделать: {
        >> len := бэйэ счетчик - 1.
        { :i
                >> len2 := бэйэ счетчик - 1.
                Таһаарыы суруй: ['len: '].
                Таһаарыы суруй: len, стоп.
                Таһаарыы суруй: ['len2: '].
                Таһаарыы суруй: len2, стоп.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
