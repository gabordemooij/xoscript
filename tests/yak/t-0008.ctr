>> Greeter := Объект саҥа.
Greeter в: ['make'] сделать: {
	>> greeter := Объект саҥа.
	greeter в: ['name:'] сделать: { :аат
		Таһаарыы суруй: ['setting a name'].
		бэйэм myName := аат.
	}.
	greeter в: ['greet'] сделать: {
		Таһаарыы суруй: ['Hello'].
		Таһаарыы суруй: бэйэм myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
