# test qualifiers

Программа умнума.

>> Fruit := Объект саҥа.
Fruit в: ['саҥа'] сделать: {
	>> f := бэйэ саҥа.
	f apples: 0. <- f.
}.
Fruit в: ['apples:'] сделать: { :a бэйэм apples := a. }.
Fruit в: ['apples'] сделать: { <- бэйэм apples. }.
Fruit в: ['+'] сделать: { :f
	>> n := Fruit саҥа.
	n apples: (f apples + бэйэм apples). <- n.
}.
Чыыһыла в: ['apples'] сделать: { <- ((Fruit саҥа) apples: бэйэ).
}.

Fruit в: ['к-тексту'] сделать: { <- бэйэм apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Таһаарыы суруй: q, стоп.




q := 3 apples + 4 apples.
Таһаарыы суруй: q, стоп.



q := 3 apples + 4 apples.
Таһаарыы суруй: q, стоп.


