# compliance test

# use international numbers

Таһаарыы суруй: ['1000 -> '].
Таһаарыы суруй: 1000, стоп. #1000

Таһаарыы суруй: ['1.5 -> '].
Таһаарыы суруй: 1.5, стоп.  #1.5

Таһаарыы суруй: ['1001.5 -> '].
Таһаарыы суруй: 1.5 + 1000, стоп. #1001.5

# use 0-indexed arrays
>> x := Испииһэк саҥа ; 1 ; 2 ; 3.
>> y := Испииһэк саҥа ; ['a'] ; ['b'] ; ['c'].

Таһаарыы суруй: ['1 -> '].
Таһаарыы суруй: x ? 0, стоп. #1

Таһаарыы суруй: ['1 -> '].
Таһаарыы суруй: (x в: 0), стоп. #1

Таһаарыы суруй: ['1 -> '].
Таһаарыы суруй: x первый, стоп. #1

Таһаарыы суруй: ['3 -> '].
Таһаарыы суруй: x последний, стоп. #3

Таһаарыы суруй: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Таһаарыы суруй: (x на: y), стоп.

Таһаарыы суруй: ['1 -> '].
Таһаарыы суруй: (x от: 0 уһуна: 1) первый, стоп. #1

Таһаарыы суруй: ['0 -> '].
Таһаарыы суруй: (x бул: 1), стоп. #0

x олоохсуй: 9 в: 0.

Таһаарыы суруй: ['9 -> '].
Таһаарыы суруй: (x в: 0), стоп. #9

x префикс: 8.
Таһаарыы суруй: ['8 -> '].
Таһаарыы суруй: (x в: 0), стоп. #9


x эбэн-биэр: 10.
Таһаарыы суруй: ['10 -> '].
Таһаарыы суруй: (x в: 4), стоп. #10








