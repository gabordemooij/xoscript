#Linux
>> OS := Программа параметр: ['OS'].

>> clock := Түгэн саҥа.
	
(OS = ['Haiku']) даа: {
	clock часовая-зона: ['CET'],
	год: 2017, месяц: 7, день: 13,
	час: 18, минут: 0, секунд: 0.
}, иначе: {
	clock часовая-зона: ['Europe/Amsterdam'],
	год: 2017, месяц: 7, день: 13,
	час: 18, минут: 0, секунд: 0.
}.

clock в: ['tell'] сделать: {
	Таһаарыы суруй: бэйэ, стоп.
}.


clock добавить: 2    час, tell.
clock добавить: 1    час, tell.
clock добавить: 19 минут, tell.
clock добавить: 1  минут, tell.
clock добавить: 1  минут, tell.
clock добавить: 19 секунд, tell.
clock добавить: 1  секунд, tell.
clock добавить: 1  секунд, tell.
clock добавить: 2    год, tell.
clock добавить: 1    год, tell.

(OS = ['Haiku']) даа: {
clock добавить: 5   месяц.
clock часовая-зона: ['CEST'], tell.
}, иначе: {
	clock добавить: 5   месяц, tell.
}.

clock добавить: 1   месяц, tell.
clock добавить: 19    день, tell.
clock добавить: 1    час, tell.
clock добавить: 120  yard, tell.
