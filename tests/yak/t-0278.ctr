>> To-Do := Объект саҥа.

To-Do в: ['саҥа'] сделать: {
	бэйэм list := Испииһэк саҥа.
}.

To-Do в: ['nieuw'] сделать: {
	бэйэм list := Испииһэк саҥа.
}.

To-Do в: ['+'] сделать: { :task
	бэйэм list эбэн-биэр: task.
}.

To-Do в: ['number of tasks?'] сделать: { <-  бэйэм list счетчик.
}.

>> todos := 
	To-Do саҥа 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Таһаарыы суруй: ['You have $ tasks to do'] $ todos number of tasks?.
