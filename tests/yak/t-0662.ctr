>> t := Кураанах.

# you can control the time zone for
# parsing like this:
Түгэн часовая-зона: ['CET'].
t := Түгэн источник: ['1981-02-03 04:05:06'].
Таһаарыы суруй: t, стоп.

# now using CEST time zone:
Түгэн часовая-зона: ['CEST'].
t := Түгэн источник: ['1981-02-03 04:05:06'].
Таһаарыы суруй: t, стоп.

# error if string cannot be parsed
{ Түгэн источник: ['1900']. } проблеманы-быһаарыы: { Кураанах. }, саҕалаа.
