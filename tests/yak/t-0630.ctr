#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Шаблон саҥа: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern сөп-түбэһии: subject оҥор: { :m :x
	Таһаарыы суруй: m, стоп.
	Таһаарыы суруй: x, стоп. <- ['XXX'].
}.
Таһаарыы суруй: result, стоп.