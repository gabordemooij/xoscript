{
	>> a := Испииһэк саҥа.
	a эбэн-биэр: 1.
	a эбэн-биэр: 2.
	Таһаарыы суруй: (a присоединить: [',']), стоп.
	a олоохсуй: 3 в: 2.
	Таһаарыы суруй: (a присоединить: [',']), стоп.
	a олоохсуй: 4 в: 10.
	Таһаарыы суруй: (a присоединить: [',']), стоп.
	a бастакы-элемени-ыл.
	a бастакы-элемени-ыл.
	a бастакы-элемени-ыл.
	Таһаарыы суруй: (a присоединить: [',']), стоп.
	a олоохсуй: 9 в: 0.
	Таһаарыы суруй: (a присоединить: [',']), стоп.
	a олоохсуй: 6 в: -1.
} проблеманы-быһаарыы: { :e
	Таһаарыы суруй: ['Uncatched error has occurred.↵'] + e, стоп.
}, саҕалаа.


