Испииһэк в: ['скопировать'] сделать: {
	>> скопировать := Испииһэк саҥа.
	бэйэ хас-биирдии: { :к-чыыһылаҕа :section
		скопировать эбэн-биэр: section рекурсия скопировать.
	}. <- скопировать.
}.

>> sheep := Испииһэк саҥа ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep скопировать.
clones хас-биирдии: { :к-чыыһылаҕа :sheep
	sheep эбэн-биэр: ['2'].
}.

Таһаарыы суруй: sheep, стоп.
Таһаарыы суруй: clones, стоп.
