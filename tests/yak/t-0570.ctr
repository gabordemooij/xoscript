#Linux

 >> t := Түгэн саҥа.
 
t часовая-зона: ['Europe/Amsterdam'].
t год: 2020, месяц: 8, день: 2, час: 21, минут: 2, секунд: 1.

>> a := t час.
>> ams := t часовая-зона.

t часовая-зона: ['US/Hawaii'].
>> b := t час.
>> hw := t часовая-зона.

Таһаарыы
суруй: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		эбэтэр: ['later'] эбэтэр: ['earlier']
	)
),
стоп.
 