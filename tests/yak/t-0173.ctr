

Испииһэк в: ['sum'] сделать: {
	>> total := 0.
	бэйэ хас-биирдии: { :index :element
		total добавить: element.
	}. <- total.
}.

Испииһэк в: ['product'] сделать: {
	>> total := 1.
	бэйэ хас-биирдии: { :index :element
		total умножить-на: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Программа өйү-салайыы: 0.

{

>> a := Испииһэк ← ['hello'] ; ['world'] ; Даа ; Кураанах ; 666.
a := a + ( Испииһэк ← 1 ).
Таһаарыы суруй: ( ['sum: '] + ( a sum ) ), стоп.
Таһаарыы суруй: ( ['min: '] + ( a минимум ) ), стоп.
Таһаарыы суруй: ( ['max: '] + ( a максимум ) ), стоп.
Таһаарыы суруй: ( ['3rd: '] + ( a ? 2 ) ), стоп.
Таһаарыы суруй: ( ['prd: '] + ( a product ) ), стоп.
a сортировкалаа: { :a :b <- (b - a). }.
a хас-биирдии: { :i :e Таһаарыы суруй: ( i - 0 ), стоп. }.

} саҕалаа.

