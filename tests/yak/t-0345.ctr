# test catch-all methods
>> x13 := Объект саҥа.
x13 в: ['a'] сделать: { :a Таһаарыы суруй: 0, стоп. }.
x13 в: ['a:'] сделать: { :a Таһаарыы суруй: a, стоп. <- 5. }.
x13 в: ['a:b:'] сделать: { :a :b Таһаарыы суруй: (a + b), стоп. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
