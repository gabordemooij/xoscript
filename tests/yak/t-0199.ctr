
Программа өйү-салайыы: 4.

>> Animal := Объект саҥа.
Animal в: ['make'] сделать: {
	>> animal := Объект саҥа.
	animal в: ['makeSound'] сделать: {
		Таһаарыы суруй: бэйэм sound.
	}. <- animal.
}.
>> Cat := Объект саҥа.
Cat в: ['make'] сделать: {
	>> cat := Animal make.
	cat в: ['init'] сделать: {
		бэйэм sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
