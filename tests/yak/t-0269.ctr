#Linux

(Файл саҥа: ['/tmp/testje']) существует суох: {
	Программа система: ['mkdir /tmp/testje'].	
}.

(Файл саҥа: ['/tmp/testje/file1']) существует суох: {
	Программа система: ['touch /tmp/testje/file1'].	
}.

(Файл саҥа: ['/tmp/testje/folder1']) существует суох: {
	Программа система: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Файл испииһэк: ['/tmp/testje'].

>> q := Испииһэк саҥа.

l хас-биирдии: { :k :v v хас-биирдии: { :x :y q эбэн-биэр: y. }. }.

>> s := q к-тексту.

(s содержит: ['file1']) даа:   { Таһаарыы суруй: ['OK'], стоп. }.
(s содержит: ['file2']) даа:   { Таһаарыы суруй: ['XX'], стоп. }.
(s содержит: ['folder1']) даа: { Таһаарыы суруй: ['OK'], стоп. }.
