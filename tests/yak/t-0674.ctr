# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> путь := ['/tmp/dat.csv'].
>> csv := Файл саҥа: путь.
csv суруй: s.

# accepts CRLF LF CR, varying row length
csv разделитель: [';'] кавычка: ['"'] строкалар: { :line
	Программа умнума.
	Таһаарыы суруй: line, стоп.
	Программа умнума.
}.

# unequal lines
s эбэн-биэр: ['\njustone'].
csv суруй: s.
{
	csv разделитель: [';'] кавычка: ['"'] строкалар: { :line
		Таһаарыы суруй: line, стоп.
	}.
} проблеманы-быһаарыы: { :e 
	Таһаарыы суруй: e, стоп.
}, саҕалаа.

# invalid format
s := ['"he"llo";world'].
csv суруй: s.
{
	csv разделитель: [';'] кавычка: ['"'] строкалар: { :line
		Таһаарыы суруй: line, стоп.
	}.
} проблеманы-быһаарыы: { :e 
	Таһаарыы суруй: e, стоп.
}, саҕалаа.
