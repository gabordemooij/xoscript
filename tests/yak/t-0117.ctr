>> t := Даа.
(t = Даа) даа: { Таһаарыы суруй: ['T']. }.
(t = Суох) даа: { Таһаарыы суруй: ['F']. }.
Таһаарыы суруй: ['|'].
>> t := Суох.
(t = Даа) даа: { Таһаарыы суруй: ['T']. }.
(t = Суох) даа: { Таһаарыы суруй: ['F']. }.
Таһаарыы суруй: ['|'].
>> f := Даа.
(t = Даа и: f = Суох) даа: { Таһаарыы суруй: ['T']. }.
(t = Суох и: f = Даа) даа: { Таһаарыы суруй: ['F']. }.
Таһаарыы суруй: ['|'].
>> n := Кураанах.
(n Кураанах?) даа: { Таһаарыы суруй: ['T']. }.
(n Кураанах?) суох: { Таһаарыы суруй: ['F']. }.
Таһаарыы суруй: ['|'].
(f Boolean?) даа: { Таһаарыы суруй: ['T']. }.
(f Boolean?) суох: { Таһаарыы суруй: ['F']. }.



