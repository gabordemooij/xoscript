#Linux
>> clock := Түгэн саҥа.
clock часовая-зона: ['UTC-1'].
clock год: 1981, месяц: 1, день: 5,
      час: 13, минут: 15, секунд: 13.

Таһаарыы суруй: clock, стоп.
clock часовая-зона: ['UTC+0'].

Таһаарыы суруй: (
	(clock год боростуой) + ['-'] + (clock месяц) + ['-'] + (clock день) + [' '] +
	(clock час) + [':'] + (clock минут) + [':'] + (clock секунд) + [' '] +
	['W'] + (clock неделя) + (clock часовая-зона)
), стоп.


clock часовая-зона: ['UTC-1'].
Таһаарыы суруй: (
	(clock год боростуой) + ['-'] + (clock месяц) + ['-'] + (clock день) + [' '] +
	(clock час) + [':'] + (clock минут) + [':'] + (clock секунд) + [' '] +
	['W'] + (clock неделя) + (clock часовая-зона)
), стоп.
