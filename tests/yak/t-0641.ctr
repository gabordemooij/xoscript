# Test utf8 sanitizer
Server init.

>> utf8cases := Тылдьыт саҥа
	# ASCII only
	олоохсуй: ( Испииһэк саҥа ; 65 ; 65 ; 65 ; 65 ; 0 ) в: ['AAAA'],
	# valid 2 byte sequence
	олоохсуй: ( Испииһэк саҥа ; 194 ; 162 ; 0 ) в: ['¢'],
	# Valid 3-byte UTF-8
    олоохсуй: ( Испииһэк саҥа ; 226 ; 130 ; 172 ; 0 ) в: ['€'],
	# Valid 4-byte UTF-8
    олоохсуй: ( Испииһэк саҥа ; 240 ; 144 ; 141 ; 136 ; 0 ) в: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    олоохсуй: ( Испииһэк саҥа ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) в: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    олоохсуй: ( Испииһэк саҥа ; 65 ; 193 ; 129 ; 0 ) в: ['A?'],
	# Invalid first byte (0xFF)
    олоохсуй: ( Испииһэк саҥа ; 255 ; 0 ) в: ['?'],
	# Incomplete multi-byte sequence at end
    олоохсуй: ( Испииһэк саҥа ; 66 ; 226 ; 0 ) в: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    олоохсуй: ( Испииһэк саҥа ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) в: ['A€?𐍈B'].
	 
utf8cases хас-биирдии: { :key :value
	>> blob := Blob саҥа: value счетчик, bytes: value.
	>> str := blob к-тексту.
	(str = key) даа: {
		Таһаарыы суруй: ['OK'], стоп.
	}, иначе: {
		Таһаарыы суруй: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, стоп.
	}.
	blob босхолоо.
}.
