

Текст в: ['evaluate'] сделать: {
	>> код := Файл саҥа: ['/tmp/eval.ctr'].
	код суруй: (бэйэ к-тексту + ['.']).
	Программа инструмент: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Испииһэк ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q к-тексту.
Таһаарыы суруй: x, стоп.
>> y := Кураанах.
(['y := '] + x ) evaluate.
Таһаарыы суруй: y ? 0, стоп.

q := Тылдьыт олоохсуй: ['\[''] в: ['\['quote\']'].
x := q к-тексту.
Таһаарыы суруй: x, стоп.
y := Кураанах.
(['y := '] + x ) evaluate.

>> q := (Тылдьыт саҥа) олоохсуй:['\[''] в:['\['quote\[''].
Таһаарыы суруй: y ? ['\['quote\']'], стоп.
