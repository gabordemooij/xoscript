# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Программа параметр: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server холбоо: ( Испииһэк саҥа ;
 libname ; ['fopen'] ;
 ( Испииһэк саҥа ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
холбоо: ( Испииһэк саҥа ;
 Кураанах ; # means same lib
 ['fread'] ;
 ( Испииһэк саҥа ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Кураанах ; # means same object (i.e. Stream)
 ['fread']
),
холбоо: (
 Испииһэк саҥа ;
 Кураанах ; # means same lib
 ['fwrite'] ;
 ( Испииһэк саҥа ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Кураанах ; # means same lib
 ['fwrite']
),
холбоо: (
 Испииһэк саҥа ;
 Кураанах ; # means same lib
 ['rewind'] ;
 ( Испииһэк саҥа ; ['pointer'] ) ;
 ['int'] ;
 Кураанах ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> путь := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: путь mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream биллэрии: ['fwrite'] аргумент: (Испииһэк саҥа ; str ; 1 ; 6 ; fd ).
Таһаарыы суруй: bytes-written, стоп.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob саҥа: 20.

# read from file
>> bytes-read := Stream биллэрии: ['fread'] аргумент: (Испииһэк саҥа ; buf ; 1 ; 6 ; fd ).
Таһаарыы суруй: bytes-read, стоп.
Таһаарыы суруй: buf, стоп.

# free memory
str  босхолоо.
путь босхолоо.
mode босхолоо.
buf  босхолоо.


