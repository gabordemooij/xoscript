# test url parsing

Server init.
>> url := URL источник: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Таһаарыы суруй: ['scheme = '] + url схема, стоп.
Таһаарыы суруй: ['host = '] + url хост, стоп.
Таһаарыы суруй: ['port = '] + url порт, стоп.
Таһаарыы суруй: ['path = '] + url путь, стоп.
Таһаарыы суруй: ['query = '] + url көрдөөһүн-параметрдара, стоп.
Таһаарыы суруй: ['fragment = '] + url фрагмент, стоп.
