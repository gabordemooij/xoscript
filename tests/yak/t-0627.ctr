

# create a 64-bit integer for exact calculations
>> a := Int64 из-текста: ['123'].

# to string
Таһаарыы суруй: a, стоп.

# divide
Таһаарыы суруй: a / (Int64 из-текста: ['3']), стоп.

# multiply
Таһаарыы суруй: a * (Int64 из-текста: ['2']), стоп.

# add
Таһаарыы суруй: a + (Int64 из-текста: ['1']), стоп.

# subtract
Таһаарыы суруй: a - (Int64 из-текста: ['2']), стоп.

# compare
Таһаарыы суруй: ( a =   (Int64 из-текста: ['123'])), стоп.
Таһаарыы суруй: ( a !=: (Int64 из-текста: ['124'])), стоп.
Таһаарыы суруй: ( a <   (Int64 из-текста: ['124'])), стоп.
Таһаарыы суруй: ( a >   (Int64 из-текста: ['122'])), стоп.
Таһаарыы суруй: ( a >=: (Int64 из-текста: ['123'])), стоп.
Таһаарыы суруй: ( a <=: (Int64 из-текста: ['123'])), стоп.





	