Таһаарыы суруй: ['Test object'], стоп.
>> a := Объект саҥа. 

a в: ['item:'] сделать: { :dict
	бэйэм dict := dict. 
}.

a в: ['item'] сделать: { <- бэйэм dict.
}.

a item: (
Тылдьыт саҥа
	hello: ['world']).

>> old-dict-address := a item прототип өй-аадырыһа.
a save-as: ['/tmp/a.bin'].
