#OBSD
>> dirname := [''].
{ dirname эбэн-биэр: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Программа система: command.
Программа chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename эбэн-биэр: ['YYYYYYYY']. } * 20.
Файл саҥа: filename, суруй: ['sometext'].
{ Файл испииһэк: ['/tmp/'] + dirname. } * 1000.
Таһаарыы суруй: ['no crash'], стоп.

