

>> Matryoshka := Объект саҥа.
Matryoshka в: ['double:'] сделать: { :secret
	бэйэм secret := secret × 2.
}.
Matryoshka в: ['саҥа:'] сделать: { :secret
	>> answer := Кураанах.
	>> t := (secret > 255).
	Таһаарыы суруй: (secret + [' | '] + t), стоп.
	t даа: {
		answer := secret.
	}, иначе: {
		answer := Matryoshka рекурсия саҥа: (бэйэ double: secret).
	}. <- answer.
}.

>> x := Matryoshka саҥа: 2.
