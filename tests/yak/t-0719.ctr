Server init.
>> fmt := Формат саҥа: ['%#3x'].

>> blob := Blob саҥа: 4.
blob bytes: ( 
	Испииһэк саҥа ; 0 ; 1 ; 2 ; 3
).

>> file := Файл саҥа: ['/tmp/blob'].
file blob: blob.
blob босхолоо.

>> аах := file blob.
аах 
от: 0 
уһуна: 4, 
оҥор хас-биирдии: { :i :b 
	Таһаарыы
	суруй: (fmt туһан-бүтүн: b),
	стоп.
}.
аах босхолоо.
