


>> CoffeeMachine := Объект саҥа.
CoffeeMachine в: ['order:'] сделать: { :id
	>> coffee := ['Americano'].
	( id = 1 ) даа: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) даа: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) даа: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Объект саҥа.
SimpleCoffeeMachine в: ['order'] сделать: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Таһаарыы суруй: redCup, стоп.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Таһаарыы суруй: greenCup, стоп.
>> yellowCup := CoffeeMachine order: 1.
Таһаарыы суруй: yellowCup, стоп.
>> blueCup := CoffeeMachine order: 0.
Таһаарыы суруй: blueCup, стоп.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Таһаарыы суруй: blackCup, стоп.
blackCup эбэн-биэр: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Таһаарыы суруй: orangeCup, стоп.
