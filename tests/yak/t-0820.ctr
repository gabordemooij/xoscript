# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Шаблон саҥа: pattern.
	p сөп-түбэһии: subject оҥор: { :m :g
		Таһаарыы суруй: g счетчик, суруй: [' '], суруй: (g присоединить: ['|']), стоп. <- m.
	}.
}.
show туһан: ['(a)|(b)'] и: ['b'].
show туһан: ['(a)|(b)'] и: ['a'].
show туһан: ['(x)?y'] и: ['y'].
show туһан: ['(x)?(y)(z)?'] и: ['xy'].
