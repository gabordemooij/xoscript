# a value ending in the first part of an opening quote must survive serialization
>> значение := Испииһэк саҥа
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

значение хас-биирдии: { :i :value
	>> d := Тылдьыт саҥа.
	d олоохсуй: value в: ['k'].
	d олоохсуй: ['second'] в: ['j'].
	>> r := d код объект.
	Таһаарыы суруй: r счетчик, стоп.
	Таһаарыы суруй: ( (r в: ['k']) = value ), стоп.
}.
