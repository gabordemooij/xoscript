Server init.

>> db := Maria-DB саҥа хост: ['localhost'],
	туһааччы-аата: ['xo'],
	пароль: ['pass123'],
	база-аата: ['xobase'],
	холбон.

>> del := db запрос: ['DELETE FROM book WHERE id > 0'].
{  del толор. db бигэргэт. } проблеманы-быһаарыы: { :e db төттөрү-төнүннэр.  }, саҕалаа.

>> счетчик := db запрос: ['SELECT COUNT(*) AS num FROM book'].
счетчик аҕал: { :row Таһаарыы суруй: row num, стоп. }.
