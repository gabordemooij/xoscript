#ffi test


Server init.

Программа өйү-салайыы: 4.

# for this test you need set a path to libc (puts)
>> libname := Программа параметр: ['FFITESTLIB'].



Server холбоо: (
 Испииһэк саҥа ;
 libname ;
 ['puts'] ;
 ( Испииһэк саҥа ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s босхолоо.

# test with struct

>> a := Blob саҥа: 8.
a bytes: (
	Испииһэк <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Испииһэк <<: ['int'], ; ['int']).

Server холбоо: (
	Испииһэк <<: ['@structtest'], ;
	['@structtest'] ;
	(Испииһэк <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Таһаарыы суруй: ['Sum test:'] + (ffitest ffisum: a), стоп.

struct struct-босхолоо.
struct босхолоо.
a босхолоо.
