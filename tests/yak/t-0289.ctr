#Linux
>> OS := Программа система: (Хамаанда uname -s), тулалыыр-итэҕэстэри-ыраастаа.

>> Slurp := Объект саҥа.
Slurp в: ['саҥа'] сделать: {
	бэйэм str := [''].
}.
Slurp в: ['хоруй:'] сделать: { :blah
		(бэйэм str ≠ ['']) даа: {
			бэйэм str эбэн-биэр: [' '].
		}.
		бэйэм str эбэн-биэр: blah.
}.
Slurp в: ['хоруй:и:'] сделать: { :blah :blahah
		(бэйэм str ≠ ['']) даа: {
			бэйэм str эбэн-биэр: [' '].
		}.
		(blah уһуна > 1) даа: {
			бэйэм str эбэн-биэр: (blah от: 0 уһуна: (blah уһуна - 1)).
		}, иначе: {
			бэйэм str эбэн-биэр: blah.
		}.
		бэйэм str эбэн-биэр: [' '].
		бэйэм str эбэн-биэр: blahah.
}.
Slurp в: ['obtain'] сделать: {
	>> buffer := бэйэм str.
	бэйэм str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text эбэн-биэр: ['hello'].
} × 1000.


Таһаарыы суруй: (
	Программа система: (
		Slurp саҥа
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

