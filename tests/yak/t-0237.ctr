
Текст в: ['evaluate'] сделать: {
	>> код := Файл саҥа: ['/tmp/eval.ctr'].
	код суруй: (бэйэ к-тексту + ['.']).
	Программа инструмент: ['/tmp/eval.ctr'].
}.

>> map :=
	(Тылдьыт саҥа)
	олоохсуй: ['Hi There'] в: ['two'],
	олоохсуй: (Испииһэк ← ['hello'] ; ['world'] ; (Испииһэк ← 1 ; 2; 9) ; Суох) в: ['one'],
	олоохсуй: ( (Тылдьыт саҥа) олоохсуй: ['wrrld'] в: ['misspelled'] ) в: ['three'],
	олоохсуй: (Испииһэк ← ((Тылдьыт саҥа) олоохсуй: ['treasure'] в: ['hidden']) ; 2) в: ['four']. 
>> str := map к-тексту.
>> map2 := Кураанах.
(['map2 := '] + str ) evaluate.
Таһаарыы суруй: map2 ? ['one'] ? 0.
Таһаарыы суруй: map2 ? ['one'] ? 1.
Таһаарыы суруй: map2 ? ['four'] ? 0 ? ['hidden'].
Таһаарыы суруй: map2 ? ['one'] ? 2 ? 2.
