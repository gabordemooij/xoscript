Таһаарыы суруй: ['Test object'], стоп.
>> a := Объект саҥа. 

a в: ['item:'] сделать: { :octhelper
	бэйэм octhelper := octhelper. 
}.

a в: ['item'] сделать: { <- бэйэм octhelper.
}.

a item: Oct саҥа.

>> old-octhelper-address := a item прототип өй-аадырыһа.
a save-as: ['/tmp/a.bin'].
Таһаарыы суруй: ['========== RELOADING SNAP:'], стоп.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип өй-аадырыһа = old-octhelper-address) даа: {
	Таһаарыы суруй: ['Object link re-attached.'], стоп.
}.
