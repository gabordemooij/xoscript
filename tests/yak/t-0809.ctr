# backslashes must survive code serialization, strings must not end early
>> значение := Испииһэк саҥа
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

значение хас-биирдии: { :i :value
	>> d := Тылдьыт саҥа.
	d олоохсуй: value в: ['k'].
	>> r := d код объект.
	Таһаарыы суруй: r счетчик, стоп.
	Таһаарыы суруй: ( (r в: ['k']) = value ), стоп.
}.
