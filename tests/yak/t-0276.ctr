>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Объект саҥа.
⚄ в: ['drawFrom:length:'] сделать: { :pool :счетчик
	
	>> result := [''].
	
	{
		>> index := Чыыһыла random % (pool уһуна).
		result эбэн-биэр: ( pool символ: (index + 1) ).
		
	} × счетчик. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? уһуна.
Таһаарыы суруй: (['x↵'] x random уһуна).
Таһаарыы суруй: (['y↵'] y ?? уһуна).

