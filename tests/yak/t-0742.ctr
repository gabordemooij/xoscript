Таһаарыы суруй: ['Test object'], стоп.
>> a := Объект саҥа. 

a в: ['item:'] сделать: { :hexhelper
	бэйэм hexhelper := hexhelper. 
}.

a в: ['item'] сделать: { <- бэйэм hexhelper.
}.

a item: Hx саҥа.

>> old-hexhelper-address := a item прототип өй-аадырыһа.
a save-as: ['/tmp/a.bin'].
Таһаарыы суруй: ['========== RELOADING SNAP:'], стоп.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип өй-аадырыһа = old-hexhelper-address) даа: {
	Таһаарыы суруй: ['Object link re-attached.'], стоп.
}.
