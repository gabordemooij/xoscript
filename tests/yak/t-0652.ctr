# test number -> string -> number
{

	>> x := Чыыһыла между: 0 и: 1000000.
	>> d := Чыыһыла между: 1 и: 7.
	>> e := 10 степень: d.

	x разделить-на: e.
	>> y := x к-тексту к-чыыһылаҕа.

	(x = y) суох: {
		Таһаарыы суруй: x, стоп.
		Таһаарыы суруй: y, стоп.
		Программа бүтэр.
	}.

} * 1000.
Таһаарыы суруй: ['OK'], стоп.