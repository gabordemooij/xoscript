Server init.

Таһаарыы суруй: (
	Шаблон саҥа: ['^\\w+$'],
	сөп-түбэһии: ['test@example.com'] 
), стоп. # 0 match, fails on @ and .

Таһаарыы суруй: (
	Шаблон саҥа: ['^[^@]+@[^\.]+\.\\w+$'],
	сөп-түбэһии: ['test@example.com'] 
), стоп. # 1 match

Таһаарыы суруй: (
	Шаблон саҥа: ['[^@]+@[^\.]+\.\\w+'],
	сөп-түбэһии: ['test@example.com'] 
), стоп. # 1 match

Таһаарыы суруй: (
	Шаблон саҥа: ['([^@]+)@([^\.]+)\.\\w+'],
	сөп-түбэһии: ['test@example.com'] 
), стоп. # 1 match, groups dont matter

Таһаарыы суруй: (
	Шаблон саҥа: ['[a-z]'],
	сөп-түбэһии: ['test@example.com'] 
), стоп. # 14 matches

Таһаарыы суруй: (
	Шаблон саҥа: ['.*'],
	сөп-түбэһии: ['test@example.com'] 
), стоп. # 1 match (all)

Таһаарыы суруй: (
	Шаблон саҥа: ['(.*)'],
	сөп-түбэһии: ['test@example.com'] 
), стоп. # 1 match (all)

Таһаарыы суруй: (
	Шаблон саҥа: ['\\s*[^@]+@[^\.]+\.\\w+'],
	сөп-түбэһии: ['test@example.com'] 
), стоп. # 1 match, prefix space optional, gets ignored