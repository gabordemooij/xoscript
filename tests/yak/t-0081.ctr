>> map1 := Тылдьыт саҥа.
>> key1 := Испииһэк саҥа.
>> key2 := Испииһэк саҥа.

map1
	олоохсуй: ['hello'] в: key1,
	олоохсуй: ['world'] в: key2.


Таһаарыы
	суруй: ['Map #1 contains: '] + (map1 в: key1),
	суруй: [' and '] + (map1 в: key2), стоп.

>> KeyeableArray := Испииһэк саҥа.
KeyeableArray в: ['toString'] сделать: { <- (бэйэ счетчик) toString.
}.

>> map2 := Тылдьыт саҥа.
key1 := KeyeableArray саҥа.
key2 := KeyeableArray саҥа.

key1 эбэн-биэр: 1.

map2
	олоохсуй: ['hello'] в: key1,
	олоохсуй: ['world'] в: key2.

Таһаарыы
	суруй: ['Map #2 contains: '] + (map2 в: key1),
	суруй: [' and '] + (map2 в: key2), стоп.
