>> көрдөөһүн-параметрдара :=
db запрос: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
аҕал: { :row
	Таһаарыы суруй: row datetimetest, стоп.
}.
