

Испииһэк в: ['column:'] сделать: { :column
	>> result := Испииһэк саҥа.
	бэйэ хас-биирдии: { :index :row
		row хас-биирдии: { :index :cell
			(index = column) даа: { result эбэн-биэр: cell. }.
		}.
	}. <- result.
}.


>> a := Испииһэк ←
	(Испииһэк ← 1 ; 2 ; 3) ;
	(Испииһэк ← 4 ; 5 ; 6) ;
	(Испииһэк ← 7 ; 8 ; 9).

>> b := a column: 1.
Таһаарыы суруй: b, стоп.

b := a column: 20.
Таһаарыы суруй: b, стоп.

b := a column: -100.
Таһаарыы суруй: b, стоп.
