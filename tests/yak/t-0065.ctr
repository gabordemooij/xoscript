Чыыһыла в: ['factorial'] сделать: {
	>> total := 1.
	{ :index total умножить-на: (бэйэ - (index)). } × бэйэ. <- total.
}.
>> Printer := Объект саҥа.
Printer в: ['print:and:'] сделать: { :x :y
	Таһаарыы суруй: ['a='] + x + [', b='] + y, стоп.
}.
>> a := 4.5. >> b := a намыһах.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a үрдүк.
Printer print: a and: b.
a := 4.5. b := a намыһах.
Printer print: a and: b.
a := 4.5. b := a төгүрүк.
Printer print: a and: b.
a := 4.2. b := a төгүрүк.
Printer print: a and: b.

