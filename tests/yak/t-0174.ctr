{
palette := Тылдьыт саҥа.
palette 
	олоохсуй: ['#F00'] в: ['red'],
	олоохсуй: ['#0F0'] в: ['green'],
	олоохсуй: ['#00F'] в: ['blue'].
Таһаарыы суруй: ['number of RGB codes in palette: '] + ( palette счетчик ), стоп.
Таһаарыы суруй: ['RGB code of green is: '] + ( palette ? ['green'] ), стоп.
colors := [''].
( palette хас-биирдии: { :аат :код
		colors := colors + ( аат + [':'] + код ).
} ).
Таһаарыы суруй: ['All colors in palette: '] + colors, стоп.
} саҕалаа.
Программа умнума.
