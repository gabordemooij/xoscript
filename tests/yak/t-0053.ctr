60 × {
	>> x := (Чыыһыла random % 6) + 1.
	(x ≤ 6) суох: { Таһаарыы суруй: ['FAIL']. }.
	(x ≥0) суох: { Таһаарыы суруй: ['FAIL']. }.
	x := (Чыыһыла random % 3) + 1.
	(x < 3) суох: { Таһаарыы суруй: ['FAIL']. }.
	(x>-1) суох: { Таһаарыы суруй: ['FAIL']. }.
	x := ((Логическай flip) к-чыыһылаҕа).
	(x = 0 или: x = 1) суох: { Таһаарыы суруй: ['FAIL']. }.
	x := ((Даа flip) к-чыыһылаҕа).
	(x = 0 или: x = 1) суох: { Таһаарыы суруй: ['FAIL']. }.
	x := (Логическай flip эбэтэр: ['HEAD'] эбэтэр: ['TAIL']).
	((x = ['HEAD']) или: (x = ['TAIL'])) суох: { Таһаарыы суруй: ['FAIL']. }.
}.
Таһаарыы суруй: ['DONE'].

