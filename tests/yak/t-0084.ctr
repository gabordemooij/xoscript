>> makeAdder := { :x
	>> f := { :y <- (бэйэм x + y). } туруор: ['x'] суолта: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i бэйэм q олоохсуй: (бэйэм f туһан: (бэйэм q ? i)) в: i. } 
	туруор: ['q'] суолта: array,
	туруор: ['f'] суолта: func.
	{ :i mapping туһан: i. } × (array счетчик).
}.

>> a := Испииһэк ← 1; 2; 3.
mapper туһан: a и: (makeAdder туһан: 100).
Таһаарыы суруй: (a позиция: 0), стоп.
Таһаарыы суруй: (a ? 1), стоп.
Таһаарыы суруй: (a ? 2), стоп.
