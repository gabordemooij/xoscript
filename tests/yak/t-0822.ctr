# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := Maria-DB саҥа хост: ['localhost'],
	туһааччы-аата: ['xo'],
	пароль: ['pass123'],
	база-аата: ['xobase'],
	холбон.

>> көрдөөһүн-параметрдара := db запрос: ['SELECT ? AS a, ? AS b, ? AS c'].
көрдөөһүн-параметрдара параметрдар: (Испииһэк саҥа ; ['1']).
{ көрдөөһүн-параметрдара аҕал: { :row Таһаарыы суруй: row, стоп. }. } проблеманы-быһаарыы: { :e Таһаарыы суруй: e, стоп. }, саҕалаа.

>> көрдөөһүн-параметрдара := db запрос: ['SELECT ? AS a'].
{ көрдөөһүн-параметрдара аҕал: { :row Таһаарыы суруй: row, стоп. }. } проблеманы-быһаарыы: { :e Таһаарыы суруй: e, стоп. }, саҕалаа.

# the right number still works, more parameters are ignored as before
>> көрдөөһүн-параметрдара := db запрос: ['SELECT ? AS a, ? AS b'].
көрдөөһүн-параметрдара параметрдар: (Испииһэк саҥа ; ['1'] ; ['2']).
көрдөөһүн-параметрдара аҕал: { :row Таһаарыы суруй: (row в: ['a']), суруй: (row в: ['b']), стоп. }.
көрдөөһүн-параметрдара параметрдар: (Испииһэк саҥа ; ['1'] ; ['2'] ; ['3']).
көрдөөһүн-параметрдара аҕал: { :row Таһаарыы суруй: (row в: ['a']), суруй: (row в: ['b']), стоп. }.
