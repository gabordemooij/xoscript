>> Greeter := Объект саҥа.
Greeter в: ['make'] сделать: {
	>> gr := Объект саҥа.
	gr в: ['setName:'] сделать: { :aname
		бэйэм аат := aname.
	}.
	gr в: ['greet'] сделать: {
		Таһаарыы суруй: бэйэм аат.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a саҥа.
c setName: ['THREE'].
c greet.
>> d := a саҥа.
d setName: ['FOUR'].
d greet.
c greet.
