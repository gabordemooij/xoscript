
>> Rectangle := Объект саҥа.

Rectangle в: ['area'] сделать: { <- бэйэм уһуна * бэйэм width.
}.

Rectangle в: ['length:'] сделать: { :уһуна
	бэйэм уһуна := уһуна.
}.

Rectangle в: ['width:'] сделать: { :width
	бэйэм width := width.
}.

Rectangle в: ['саҥа'] сделать: {
	# this will not result into an infinite loop
	>> rectangle := бэйэ саҥа.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle саҥа.
Таһаарыы суруй: a area, стоп. #0

>> b := Rectangle саҥа length: 2, width: 3.
Таһаарыы суруй: b area, стоп. #6

