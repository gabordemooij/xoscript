
Текст в: ['html'] сделать: { <- (
		бэйэ
		солбуй: ['&'] на: ['&amp;'],
		солбуй: ['<'] на: ['&lt;'],
		солбуй: ['>'] на: ['&gt;'],
		солбуй: ['"'] на: ['&quot;']
	).
}.

>> HtmlBrush := Объект саҥа.

HtmlBrush в: ['хоруй:'] сделать: { :tag
	Таһаарыы суруй: (['<tag>↵'] tag: tag ).
}.

HtmlBrush в: ['хоруй:и:'] сделать: { :tag :content
	tag := ( tag от: 0 уһуна: (tag уһуна - 1) ).
	Таһаарыы суруй: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush в: ['content:'] сделать: { :text
	Таһаарыы суруй: text html, стоп.
}.

HtmlBrush в: ['attr:value:'] сделать: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush саҥа.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
