Чыыһыла в: ['factorial'] сделать: {
	>> total := 1.
	{ :index total умножить-на: (бэйэ - (index)). } × бэйэ. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Таһаарыы суруй: a.
>> b := 2 + 3 factorial.
Таһаарыы суруй: b.
>> c := 3 factorial + 2.
Таһаарыы суруй: c.
>> d := 2 + (3 factorial).
Таһаарыы суруй: d.
Таһаарыы суруй: 2 + 3 factorial + 1.
