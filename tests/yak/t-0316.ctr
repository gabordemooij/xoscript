>> Grandfather := Объект саҥа.
Grandfather в: ['greet'] сделать: {
	Таһаарыы суруй: ['Ave!'], стоп.
}.
>> Father := Grandfather саҥа.
Father в: ['greet'] сделать: {
	Таһаарыы суруй: ['Hello'], стоп.
	бэйэ greet.
}.
>> Son := Father саҥа.
Son в: ['greet'] сделать: {
	Таһаарыы суруй: ['Hi'], стоп.
	бэйэ greet.
}.

Son greet.

>> Roundabout := Объект саҥа.
Roundabout в: ['circle:'] сделать: { :x
	Таһаарыы суруй: x, стоп.
	(x < 3) даа: { бэйэ рекурсия circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) даа: { Таһаарыы суруй: x, стоп. x добавить: 1.  increment саҕалаа. }. }.
increment саҕалаа.