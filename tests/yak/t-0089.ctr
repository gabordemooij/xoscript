>> randomizer := { :a :b
	>> минимум := ( a < b ) эбэтэр: a эбэтэр: b.
	>> максимум := ( a > b ) эбэтэр: a эбэтэр: b.
	>> x := Кураанах.
	{
		x := Чыыһыла между: a и: b.
		((x < минимум) или: (x > максимум)) даа: { 
			Таһаарыы суруй: (['Invalid value!']).
			Программа бүтэр.
		}.
	} 
	× 100. <- x.
}.
