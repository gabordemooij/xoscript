Испииһэк в: ['sum'] сделать: {
	>> total := 0.
	бэйэ хас-биирдии: { :index :element
		total добавить: element.
	}. <- total.
}.

>> a := Даа.



a в: ['к-тексту'] сделать: {
	>> answer := Кураанах.
	( бэйэ = Даа ) даа: {
		answer := ['Yep'].
	}, иначе: {
		answer := ['Nope'].
	}. <- answer.
}.

a в: ['к-чыыһылаҕа'] сделать: {
	>> answer := Кураанах.
	( бэйэ = Даа ) даа: {
		answer := 10.
	}, иначе: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b в: ['к-тексту'] сделать: { <- ['Devil'].
}.

b в: ['к-логическому-значению'] сделать: { <- Суох.
}.


Таһаарыы суруй: a, стоп.  
Таһаарыы суруй: (90 + a), стоп. 
Таһаарыы суруй: b, стоп. 
Таһаарыы суруй: (Даа и: b), стоп.

a := Испииһэк ← ['hello'] ; ['world'] ; Даа ; Кураанах ; 666. 
a := a + ( Испииһэк ← 1 ).
Таһаарыы суруй: a, стоп.
Таһаарыы суруй: ((Тылдьыт саҥа) олоохсуй: Кураанах в: Кураанах), стоп.
Таһаарыы суруй: a sum, стоп. 


{
	a в: ['к-тексту'] сделать: { <- Кураанах. }.
	a := [''] + a.
} проблеманы-быһаарыы: { :error
	Таһаарыы суруй: ['Error noted: '] + error, стоп.
}, саҕалаа.



