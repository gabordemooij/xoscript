# a format must fit the type of the value, the type can come from a client
>> боруобалаа := { :format :value
	{ Таһаарыы суруй: ( (Формат саҥа: format) туһан: value ), стоп. } проблеманы-быһаарыы: { :e Таһаарыы суруй: e, стоп. }, саҕалаа.
}.
>> try-int := { :format :value
	{ Таһаарыы суруй: ( (Формат саҥа: format) туһан-бүтүн: value ), стоп. } проблеманы-быһаарыы: { :e Таһаарыы суруй: e, стоп. }, саҕалаа.
}.

# fits
боруобалаа туһан: ['|%s|'] и: ['text'].
боруобалаа туһан: ['%06.2f'] и: 5.5.
боруобалаа туһан: ['100%% %s'] и: ['sure'].
try-int туһан: ['%03d'] и: 7.
try-int туһан: ['%x'] и: 255.
боруобалаа туһан: ['%d'] и: (Int64 саҥа из-текста: ['12']).
боруобалаа туһан: ['%lld'] и: (Int64 саҥа из-текста: ['12']).
боруобалаа туһан: ['%.1lf'] и: 5.5.
try-int туһан: ['%hd'] и: 7.

# does not fit
боруобалаа туһан: ['%s'] и: 12345.
боруобалаа туһан: ['%d'] и: 12345.
боруобалаа туһан: ['%f'] и: ['text'].
try-int туһан: ['%d'] и: ['text'].
try-int туһан: ['%s'] и: 5.
боруобалаа туһан: ['%s %s'] и: ['text'].
боруобалаа туһан: ['%n'] и: ['text'].
боруобалаа туһан: ['%*s'] и: ['text'].
боруобалаа туһан: ['%'] и: ['text'].

# length modifier does not fit
боруобалаа туһан: ['%ls'] и: ['text'].
боруобалаа туһан: ['%Lf'] и: 5.5.
try-int туһан: ['%ld'] и: 7.
try-int туһан: ['%lld'] и: 7.
боруобалаа туһан: ['%Ld'] и: (Int64 саҥа из-текста: ['12']).

# a width that does not fit printf must give an error, not a crash
боруобалаа туһан: ['%99999999999s'] и: ['text'].
