>> items := Тылдьыт саҥа.
items олоохсуй: ['green'] в: ['color-1'].
items олоохсуй: ['orange'] в: ['color-2'].
items олоохсуй: ['red'] в: ['color-3'].
>> i := 0.
>> s := [''].
items хас-биирдии: { :key :color
	Таһаарыы суруй: ['color #'] + i + [' is: '] + color + [' '].
	i добавить: 1.
