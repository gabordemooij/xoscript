Таһаарыы суруй: ['Test object'], стоп.
>> a := Объект саҥа. 

a в: ['item:'] сделать: { :binhelper
	бэйэм binhelper := binhelper. 
}.

a в: ['item'] сделать: { <- бэйэм binhelper.
}.

a item: Bin саҥа.

>> old-binhelper-address := a item прототип өй-аадырыһа.
a save-as: ['/tmp/a.bin'].
Таһаарыы суруй: ['========== RELOADING SNAP:'], стоп.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип өй-аадырыһа = old-binhelper-address) даа: {
	Таһаарыы суруй: ['Object link re-attached.'], стоп.
}.


