Server init.

>> DB := Maria-DB саҥа хост: ['localhost'],
	туһааччы-аата: ['xo'],
	пароль: ['pass123'],
	база-аата: ['xobase'],
	холбон.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> көрдөөһүн-параметрдара := Maria-Запрос саҥа: SQL.

# set database
көрдөөһүн-параметрдара дааннай-база: DB.

көрдөөһүн-параметрдара аҕал: { :row
	Таһаарыы суруй: row world, стоп.
}.
