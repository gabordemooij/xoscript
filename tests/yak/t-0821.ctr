# a quote that never closes must give an error, not an endless loop
>> путь := ['/tmp/test0821.csv'].
>> file := Файл саҥа: путь.

file суруй: ['a,b\n"1,2\n'].
{
	file разделитель: [','] кавычка: ['"'] строкалар: { :line
		Таһаарыы суруй: line, стоп.
	}.
} проблеманы-быһаарыы: { :e Таһаарыы суруй: e, стоп. }, саҕалаа.

# a closed quote still works
file суруй: ['a,b\n"1,2",3'].
file разделитель: [','] кавычка: ['"'] строкалар: { :line
	Таһаарыы суруй: line, стоп.
}.
file ыраас.
