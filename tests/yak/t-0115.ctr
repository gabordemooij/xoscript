{
	этот-блок-кода алҕас: ['Dont fail.'].
	unknown doSomething.
} проблеманы-быһаарыы: {
	Таһаарыы суруй: ['Caught!'].
}, саҕалаа.

{
	этот-блок-кода алҕас: ['Dont fail.'].
	бэйэм unknown doSomething.
} проблеманы-быһаарыы: {
	Таһаарыы суруй: ['Caught!'].
}, саҕалаа.

{
	этот-блок-кода алҕас: ['Dont fail.'].
	unknown := 122.
} проблеманы-быһаарыы: {
	Таһаарыы суруй: ['Caught!'].
}, саҕалаа.


{
	этот-блок-кода алҕас: ['Dont fail.'].
	Даа тохтоо.
	Таһаарыы суруй: ['FAIL'].
} проблеманы-быһаарыы: {
	Таһаарыы суруй: ['Caught!'].
}, саҕалаа.

{
	{
		этот-блок-кода алҕас: ['Dont fail.'].
		Даа тохтоо.
		Таһаарыы суруй: ['FAIL'].
	} проблеманы-быһаарыы: { :x
		(x = ['Dont fail.']) даа: { этот-блок-кода алҕас: ['Nested Caught!']. }.
	}, саҕалаа.
} проблеманы-быһаарыы: { :e
	Таһаарыы суруй: e.
}, саҕалаа.
