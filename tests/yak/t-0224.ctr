
>> countries := Испииһэк саҥа
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Испииһэк саҥа
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods на: countries, хас-биирдии: { :key :value
	counter добавить: 1.
}.

Таһаарыы суруй: (['we serve counter dishes'] counter: counter), стоп.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] им-бэлиэлэр сортировкалаа: { :v
	counter добавить: 0.
}.

Таһаарыы суруй: (['we sort counter dishes'] counter: counter), стоп.


>> counter := 0.
{
	{
		counter добавить: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Таһаарыы суруй: (['we calculate counter numbers.'] counter: counter), стоп.

