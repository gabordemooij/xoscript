# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB саҥа хост: ['localhost'],
	туһааччы-аата: ['xo'],
	пароль: ['pass123'],
	база-аата: ['xobase'],
	холбон.

>> көрдөөһүн-параметрдара := db запрос: ['SELECT %% FROM'].
{ көрдөөһүн-параметрдара толор. } проблеманы-быһаарыы: { :e
	Таһаарыы суруй: ( e содержит: ['%%'] ), стоп.
}, саҕалаа.
