Server init.
Таһаарыы суруй: ['Database date test'], стоп.

>> db := Maria-DB саҥа хост: ['localhost'],
	туһааччы-аата: ['xo'], 
	пароль: ['pass123'],
	база-аата: ['xobase'],
	холбон.

>> көрдөөһүн-параметрдара :=
db запрос: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
аҕал: { :row
	Таһаарыы суруй: row datetest, стоп.
}.
