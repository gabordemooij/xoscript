# test qualifiers

>> $ := Объект саҥа.

$ в: ['хоруй:'] сделать: { :x
	
	>> operation := x символ: 0.
	>> valuta := x символ: 1.
	>> money := x смести: 2.
	
	>> amount := 0.

	( operation = ['+'] ) даа: {
		( valuta = ['£'] ) даа: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Таһаарыы суруй: x, стоп.


>> Fruit := Объект саҥа.

Fruit в: ['саҥа'] сделать: {
	>> f := бэйэ саҥа.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit в: ['apples:'] сделать: { :a бэйэм apples := a. }.
Fruit в: ['oranges:'] сделать: { :p бэйэм oranges := p. }.
Fruit в: ['apples'] сделать: { <- бэйэм apples. }.
Fruit в: ['oranges'] сделать: { <- бэйэм oranges. }.

Fruit в: ['+'] сделать: { :f
	
	>> n := Fruit саҥа.
	f добавить: 1.
	
	n apples: (f apples + бэйэм apples).
	n oranges:  (f oranges  + бэйэм oranges). <- n.
}.

Fruit в: ['к-тексту'] сделать: { <- ( бэйэм apples к-тексту + [' apples and '] + бэйэм oranges + [' oranges'] ).
}.

Чыыһыла в: ['apples'] сделать: { <- ((Fruit саҥа) apples: бэйэ).
}.

Чыыһыла в: ['apple'] сделать: { <- ((Fruit саҥа) apples: бэйэ).
}.

Чыыһыла в: ['oranges'] сделать: { <- ((Fruit саҥа) oranges: бэйэ).
}.




Таһаарыы суруй: (1 apple + 3 oranges + 4 apples), стоп.


Текст в: ['twice'] сделать: { <- ((бэйэ к-тексту) + (бэйэ к-тексту)).
}.



Таһаарыы суруй: ['❤❤❤'] twice.



