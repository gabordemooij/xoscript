# test list operations


>> cakes := Испииһэк ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes заменить: 1 длина: 2 на: ( Испииһэк ← ['cinnamon'] ; ['pineapple'] ).
Таһаарыы суруй: (buy присоединить: [',']), стоп.


>> buy := cakes заменить: 1 длина: 12 на: ( Испииһэк ← ['cinnamon'] ; ['pineapple'] ).
Таһаарыы суруй: (buy присоединить: [',']), стоп.


>> buy := cakes заменить: 2 длина: 10 на: ( Испииһэк саҥа ).
Таһаарыы суруй: (buy присоединить: [',']), стоп.


>> buy := cakes заменить: 0 длина: 1 на: ( Испииһэк саҥа ).
Таһаарыы суруй: (buy присоединить: [',']), стоп.


>> buy := cakes заменить: ['0'] длина: ['1'] на: ['x'].
Таһаарыы суруй: (buy присоединить: [',']), стоп.
