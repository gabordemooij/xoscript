#Linux
>> Slurp := Объект саҥа.

Slurp в: ['саҥа'] сделать: {
	бэйэм str := [''].
}.

Slurp в: ['nieuw'] сделать: {
	бэйэм str := [''].
}.

Slurp в: ['хоруй:'] сделать: { :blah
		бэйэм str эбэн-биэр: blah.
}.

Slurp в: ['хоруй:и:'] сделать: { :blah :blahah
		бэйэм str эбэн-биэр: (blah от: 0 уһуна: (blah уһуна - 1)).
		бэйэм str эбэн-биэр: [' '].
		бэйэм str эбэн-биэр: blahah.
}.

Slurp в: ['obtain'] сделать: {
	>> buffer := бэйэм str.
	бэйэм str := ['']. <- buffer.
}.


Таһаарыы суруй: (Программа система: (Slurp саҥа echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Файл саҥа: ['/tmp/from.txt'], ыраас. } проблеманы-быһаарыы: { ['Empty']. }, саҕалаа.
{ Файл саҥа: ['/tmp/to.txt'], ыраас. } проблеманы-быһаарыы: { ['Empty']. }, саҕалаа.


Файл саҥа: ['/tmp/to.txt'], существует суох: {
	Таһаарыы суруй: ['Confirmed. Target file does not exist.\
'].
}.
Файл саҥа: ['/tmp/from.txt'], существует суох: {
	Таһаарыы суруй: ['Confirmed. Source file does not exist.\
'].
}.



Программа система: (Slurp саҥа touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Программа система: (Slurp саҥа cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Файл саҥа: ['/tmp/to.txt'], существует даа: {
	Таһаарыы суруй: ['Confirmed. Target file has been created by shell.\
'].
}.


Таһаарыы суруй: ['Contents of file is:'] + (Файл саҥа: ['/tmp/to.txt'], аах), стоп.
