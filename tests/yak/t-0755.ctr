Таһаарыы суруй: ['Test object'], стоп.
>> greeter := Объект саҥа.
greeter в: ['name:'] сделать: { :аат
	бэйэм xname := аат. 
}.
greeter в: ['greet'] сделать: {
	Таһаарыы суруй: ['Hello '] + бэйэм xname, стоп.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Таһаарыы суруй: ['========== RELOADING SNAP:'], стоп.
>> b := Объект load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
