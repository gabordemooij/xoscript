Server init.

>> DB := Maria-DB саҥа хост: ['localhost'],
	туһааччы-аата: ['xo'],
	пароль: ['pass123'],
	база-аата: ['xobase'],
	холбон.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB запрос: SQL.

# now you don't have to set DB
query2 аҕал: { :row
	Таһаарыы суруй: row world, стоп.
}.
