>> items := Тылдьыт саҥа.
items олоохсуй: ['black'] в: ['coffee'], олоохсуй: ['earl grey'] в: ['tea'].
Таһаарыы суруй: (items в: ['coffee']), суруй: (items в: ['tea']).
Таһаарыы суруй: ['there are'] + items счетчик + [' items in the array.'].
items олоохсуй: ['capuccino'] в: ['coffee'].
Таһаарыы суруй: ['Now my coffee is.. '] + (items в: ['coffee']).
items олоохсуй: ['aaa'] в: ['1'].
items олоохсуй: ['bbb'] в: ['2'].
Таһаарыы суруй: (items в: ['a']).
