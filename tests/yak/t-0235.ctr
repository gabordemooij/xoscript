>> Slurp := Объект саҥа.
Slurp в: ['саҥа'] сделать: {
	бэйэм str := [''].
}.

Slurp в: ['хоруй:'] сделать: { :blah
		(бэйэм str ≠ ['']) даа: {
			бэйэм str эбэн-биэр: [' '].
		}.
		бэйэм str эбэн-биэр: blah.
}.
Slurp в: ['хоруй:и:'] сделать: { :blah :blahah
		(бэйэм str ≠ ['']) даа: {
			бэйэм str эбэн-биэр: [' '].
		}.
		(blah уһуна > 1) даа: {
			бэйэм str эбэн-биэр: (blah от: 0 уһуна: (blah уһуна - 1)).
		}, иначе: {
			бэйэм str эбэн-биэр: blah.
		}.
		бэйэм str эбэн-биэр: [' '].
		бэйэм str эбэн-биэр: blahah.
}.
Slurp в: ['obtain'] сделать: {
	>> buffer := бэйэм str.
	бэйэм str := ['']. <- buffer.
}.

>> s := Slurp саҥа.
s hello: ['world'].
Таһаарыы суруй: ( s obtain ), стоп.
