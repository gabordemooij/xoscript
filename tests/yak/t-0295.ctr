
>> dictionary := (
	Тылдьыт саҥа
		олоохсуй: ['b'] в: ['a'],
		олоохсуй: ['a'] в: ['b'],
		олоохсуй: ['z'] в: ['x'],
		олоохсуй: ['hello'] в: ['hallo'],
		олоохсуй: ['human'] в: ['human']
).

>> comparisons := Испииһэк саҥа.
dictionary хас-биирдии: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a сравнить: b)
	).
}.

comparisons сортировкалаа: { :a :b <- ( a сравнить: b ). }.
Таһаарыы суруй: ( comparisons присоединить: ['↵'] ), стоп.
comparisons присоединить: ['↵'].
