Server init.

>> x := Blob bago: 65 uri: ['char'].
# for this test you need set a path to libc (puts)
>> libname := Programa kaayusan: ['FFITESTLIB'].
Server iugnay: (
 Listahan bago ;
 libname ;
 ['putchar'] ;
 ( Listahan bago ; ['char'] ) ;
 ['void'] ;
 ['Print'] ;
 ['char:']
).
Print char: (x mula-sa: 0 haba: 1), bagong-linya.
x palayain.

