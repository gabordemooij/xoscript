Labas isulat: ['Continue for-loop, No - before 6 and up.'], bagong-linya.
{ :i
	Labas isulat: (i + 1), bagong-linya.
	((i + 1) > 4) magpatuloy.
	Labas isulat: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Labas bagong-linya.
Labas isulat: ['Continue while-true, No --> before 5 and up.'], bagong-linya.
{
	Labas isulat: ['iteration #'] + x, bagong-linya.
	x idagdag: 1.
	((x < 5) baligtad) magpatuloy.
	Labas isulat: ['-->'].
} habang: xIsLessThan10.
Labas bagong-linya.
Labas isulat: ['Continue while-false, No - before 3 only.'], bagong-linya.
{
	Labas isulat: ['iteration #'] + x, bagong-linya.
	x ibawas: 1.
	(x = 3) magpatuloy.
	Labas isulat: ['-'].
} habang: { <- ( x > 0). }.

Labas bagong-linya.
Labas isulat: ['Continue times-loop, No ||| before 3.'], bagong-linya.
{ :i
	Labas isulat: ['iteration #'] + i, bagong-linya.
	(i = 2) magpatuloy.
	Labas isulat: ['|||'].
} × 5.

Labas bagong-linya.

{ Totoo magpatuloy. Labas isulat: ['dont write this!'], bagong-linya. } patakbuhin.

{ Totoo magpatuloy. Labas isulat: ['dont write this!'], bagong-linya. } saluhin: { Labas isulat: ['Dont catch this!']. }, patakbuhin.

Labas isulat: ['Test Array each-loop: 0, ... ,2'], bagong-linya.
(Listahan ← 1 ; 2 ; 3) baguhin-bawat: { :i
	(i = 1) magpatuloy.
	Labas isulat: ['iteration #'] + (i - 0), bagong-linya.
}.

Labas isulat: ['Test Map each-loop: c only'], bagong-linya.
>> m := Diksyunaryo bago.
m ilagay: ['first'] sa: ['a'], ilagay: ['second'] sa: ['b'], ilagay: ['third'] sa: ['c'].
m bawat: { :k :v
	(k ≠ ['c']) magpatuloy.
	Labas isulat: ['iteration'] + k + v, bagong-linya.
}.

