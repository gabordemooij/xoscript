

Listahan kapag: ['sum'] gawin: {
	>> total := 0.
	sarili bawat: { :index :element
		total idagdag: element.
	}. <- total.
}.

Listahan kapag: ['product'] gawin: {
	>> total := 1.
	sarili bawat: { :index :element
		total paramihin-ng: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa pamamahala-ng-memorya: 0.

{

>> a := Listahan ← ['hello'] ; ['world'] ; Totoo ; Wala ; 666.
a := a + ( Listahan ← 1 ).
Labas isulat: ( ['sum: '] + ( a sum ) ), bagong-linya.
Labas isulat: ( ['min: '] + ( a pinakamaliit ) ), bagong-linya.
Labas isulat: ( ['max: '] + ( a pinakamalaki ) ), bagong-linya.
Labas isulat: ( ['3rd: '] + ( a ? 2 ) ), bagong-linya.
Labas isulat: ( ['prd: '] + ( a product ) ), bagong-linya.
a ayusin: { :a :b <- (b - a). }.
a bawat: { :i :e Labas isulat: ( i - 0 ), bagong-linya. }.

} patakbuhin.

Programa linisin.
usedMemory1 := (Programa memorya ? 0).


{

>> a := Listahan ← ['hello'] ; ['world'] ; Totoo ; Wala ; 666.
a := a + ( Listahan ← 1 ).
Labas isulat: ( ['sum: '] + ( a sum ) ), bagong-linya.
Labas isulat: ( ['min: '] + ( a pinakamaliit ) ), bagong-linya.
Labas isulat: ( ['max: '] + ( a pinakamalaki ) ), bagong-linya.
Labas isulat: ( ['3rd: '] + ( a ? 2 ) ), bagong-linya.
Labas isulat: ( ['prd: '] + ( a product ) ), bagong-linya.
a ayusin: { :a :b <- (b - a). }.
a bawat: { :i :e Labas isulat: ( i - 0 ), bagong-linya. }.

} patakbuhin.



Programa linisin.
usedMemory2 := (Programa memorya ? 0).


{

>> a := Listahan ← ['hello'] ; ['world'] ; Totoo ; Wala ; 666.
a := a + ( Listahan ← 1 ).
Labas isulat: ( ['sum: '] + ( a sum ) ), bagong-linya.
Labas isulat: ( ['min: '] + ( a pinakamaliit ) ), bagong-linya.
Labas isulat: ( ['max: '] + ( a pinakamalaki ) ), bagong-linya.
Labas isulat: ( ['3rd: '] + ( a ? 2 ) ), bagong-linya.
Labas isulat: ( ['prd: '] + ( a product ) ), bagong-linya.
a ayusin: { :a :b <- (b - a). }.
a bawat: { :i :e Labas isulat: ( i - 0 ), bagong-linya. }.

} patakbuhin.



Programa linisin.
usedMemory3 := (Programa memorya ? 0).

( usedMemory1 = usedMemory2 at: usedMemory1 = usedMemory3, at: usedMemory2 = usedMemory3 ) totoo: {
	Labas isulat: ['No memory leaks here'].
}, mali: {
	Labas isulat: ['Leaking memory...'].
}.
