
>> XX := Bagay bago.
>> X := Bagay bago.

XX kapag: ['QQ'] gawin: { <- 1. }.
XX kapag: ['Q'] gawin: { <- 1. }.
XX kapag: ['QQ:'] gawin: { <- 1. }.
XX kapag: ['QQ:QQ:'] gawin: { <- 1. }.

X kapag: ['QQ'] gawin: { <- 1. }.
X kapag: ['Q'] gawin: { <- 1. }.
X kapag: ['QQ:'] gawin: { <- 1. }.
X kapag: ['QQ:QQ:'] gawin: { <- 1. }.

Labas isulat: (Programa XX), bagong-linya.
Labas isulat: (Programa hanapin: ['XX']), bagong-linya.
Labas isulat: (Programa hanapin: ['X']), bagong-linya.

Labas isulat: (Programa XX: ['QQ']), bagong-linya.
Labas isulat: (Programa XX: ['Q']), bagong-linya.
Labas isulat: (Programa XX: ['QQ:']), bagong-linya.
Labas isulat: (Programa XX: ['QQ:QQ:']), bagong-linya.

