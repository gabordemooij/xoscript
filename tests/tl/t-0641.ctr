# Test utf8 sanitizer
Server init.

>> utf8cases := Diksyunaryo bago
	# ASCII only
	ilagay: ( Listahan bago ; 65 ; 65 ; 65 ; 65 ; 0 ) sa: ['AAAA'],
	# valid 2 byte sequence
	ilagay: ( Listahan bago ; 194 ; 162 ; 0 ) sa: ['¢'],
	# Valid 3-byte UTF-8
    ilagay: ( Listahan bago ; 226 ; 130 ; 172 ; 0 ) sa: ['€'],
	# Valid 4-byte UTF-8
    ilagay: ( Listahan bago ; 240 ; 144 ; 141 ; 136 ; 0 ) sa: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    ilagay: ( Listahan bago ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) sa: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    ilagay: ( Listahan bago ; 65 ; 193 ; 129 ; 0 ) sa: ['A?'],
	# Invalid first byte (0xFF)
    ilagay: ( Listahan bago ; 255 ; 0 ) sa: ['?'],
	# Incomplete multi-byte sequence at end
    ilagay: ( Listahan bago ; 66 ; 226 ; 0 ) sa: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    ilagay: ( Listahan bago ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) sa: ['A€?𐍈B'].
	 
utf8cases bawat: { :key :value
	>> blob := Blob bago: value bilangin, bytes: value.
	>> str := blob teksto.
	(str = key) totoo: {
		Labas isulat: ['OK'], bagong-linya.
	}, kung-hindi: {
		Labas isulat: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, bagong-linya.
	}.
	blob palayain.
}.
