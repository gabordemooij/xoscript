#Linux
>> OS := Programa kaayusan: ['OS'].

>> clock := Sandali bago.
	
(OS = ['Haiku']) totoo: {
	clock sona-ng-oras: ['CET'],
	taon: 2017, buwan: 7, araw: 13,
	oras: 18, minuto: 0, segundo: 0.
}, kung-hindi: {
	clock sona-ng-oras: ['Europe/Amsterdam'],
	taon: 2017, buwan: 7, araw: 13,
	oras: 18, minuto: 0, segundo: 0.
}.

clock kapag: ['tell'] gawin: {
	Labas isulat: sarili, bagong-linya.
}.


clock idagdag: 2    oras, tell.
clock idagdag: 1    oras, tell.
clock idagdag: 19 minuto, tell.
clock idagdag: 1  minuto, tell.
clock idagdag: 1  minuto, tell.
clock idagdag: 19 segundo, tell.
clock idagdag: 1  segundo, tell.
clock idagdag: 1  segundo, tell.
clock idagdag: 2    taon, tell.
clock idagdag: 1    taon, tell.

(OS = ['Haiku']) totoo: {
clock idagdag: 5   buwan.
clock sona-ng-oras: ['CEST'], tell.
}, kung-hindi: {
	clock idagdag: 5   buwan, tell.
}.

clock idagdag: 1   buwan, tell.
clock idagdag: 19    araw, tell.
clock idagdag: 1    oras, tell.
clock idagdag: 120  yard, tell.
