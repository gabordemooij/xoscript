

Teksto kapag: ['evaluate'] gawin: {
	>> kodigo := Talaksan bago: ['/tmp/eval.ctr'].
	kodigo isulat: (sarili teksto + ['.']).
	Programa gamitin: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Listahan ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q teksto.
Labas isulat: x, bagong-linya.
>> y := Wala.
(['y := '] + x ) evaluate.
Labas isulat: y ? 0, bagong-linya.

q := Diksyunaryo ilagay: ['\[''] sa: ['\['quote\']'].
x := q teksto.
Labas isulat: x, bagong-linya.
y := Wala.
(['y := '] + x ) evaluate.

>> q := (Diksyunaryo bago) ilagay:['\[''] sa:['\['quote\[''].
Labas isulat: y ? ['\['quote\']'], bagong-linya.
