# test buffers PKI/Sign 
Server init.

>> long := ( Listahan bago punan: 1000 ng: ['a'] ) pagsamahin: [''].

# sign a message
Labas isulat: ( 
	Kaha lagdaan: ['abc'] gamit: long
), bagong-linya.

Labas isulat: ( 
	Kaha
		suriin: ['abc'] 
		lagda: long 
		gamit: long
), bagong-linya.

Labas isulat: (
	Kaha hash-ng-password: long patunayan: long
), bagong-linya.
