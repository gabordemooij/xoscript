>> Combination := Listahan bago.

Combination kapag: ['idagdag-sa-dulo:'] gawin: { :el
	sarili 
	hanapin: el, Wala? totoo: { sarili idagdag-sa-dulo: el. }.
}.

>> colours := Combination bago.
colours
	idagdag-sa-dulo: ['red'],
	idagdag-sa-dulo: ['green'],
	idagdag-sa-dulo: ['blue'],
	idagdag-sa-dulo: ['red'].

Labas isulat: colours, bagong-linya.
