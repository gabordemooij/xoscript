#Linux

(Talaksan bago: ['/tmp/testje']) umiiral mali: {
	Programa sistema: ['mkdir /tmp/testje'].	
}.

(Talaksan bago: ['/tmp/testje/file1']) umiiral mali: {
	Programa sistema: ['touch /tmp/testje/file1'].	
}.

(Talaksan bago: ['/tmp/testje/folder1']) umiiral mali: {
	Programa sistema: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Talaksan listahan: ['/tmp/testje'].

>> q := Listahan bago.

l bawat: { :k :v v bawat: { :x :y q idagdag-sa-dulo: y. }. }.

>> s := q teksto.

(s naglalaman: ['file1']) totoo:   { Labas isulat: ['OK'], bagong-linya. }.
(s naglalaman: ['file2']) totoo:   { Labas isulat: ['XX'], bagong-linya. }.
(s naglalaman: ['folder1']) totoo: { Labas isulat: ['OK'], bagong-linya. }.
