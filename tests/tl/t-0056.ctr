>> z := Bagay bago.
z kapag: ['value:'] gawin: { :v
	sarili-ko value := v. <- sarili.
}.
z kapag: ['value'] gawin: { <- sarili-ko value. }.
(z setValue: 1) value: 2.
Labas isulat: z value.
>> x := z.
Labas isulat: x value.
z := Wala.
Labas isulat: z value.
Labas isulat: x value.
Labas isulat: ['hello'].
Labas isulat: 3 + 2.
Labas isulat: (3 > 2).
