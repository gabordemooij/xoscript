>> a := Listahan ← Bagay ; Totoo ; Mali ; Boolean ; 1 ; Bilang ; ['Str'] ; Teksto ; { ['Empty']. }.
Labas isulat: (a bilangin), bagong-linya.
{ :i
	Labas isulat: 
	['a '] + 
	((a ? i) uri) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Wala?) alinman: [''] o: ['NOT']) + 
	[' Nil.'],
	bagong-linya.
} × (a bilangin).
Labas isulat: ['but.. Nil is.. '] + ((Wala Wala?) alinman: ['certainly NIL!'] o: ['not NIL??']), bagong-linya.