# catch-all test (practical)
>> HTML := Teksto bago.
HTML kapag: ['encode:'] gawin: { :tekst
	sarili idagdag-sa-dulo: (tekst
	palitan: ['&'] ng: ['&amp;'], 
	palitan: ['<'] ng: ['&lt;'],
	palitan: ['>'] ng: ['&gt;'],
	palitan: ['"'] ng: ['&quot;']).
}.
>> blog := HTML bago.
blog idagdag-sa-dulo: ['<h1>'],
     encode: ['Koffie & Thee'],
     idagdag-sa-dulo: ['</h1>'].
Labas isulat: blog, bagong-linya.


>> Roman := Bilang bago.
Roman kapag: ['stringy'] gawin: {
	>> a := [''].
	{ a idagdag-sa-dulo: ['I']. } × sarili. <- a.
}.

>> x := Roman bago.
x idagdag: 3.
Labas isulat: x stringy, bagong-linya.

>> Quantum := Boolean bago.
Quantum kapag: ['true?'] gawin: { <- ['maybe True']. }.
Labas isulat: (Quantum bago true?), bagong-linya.

>> Nihil := Wala bago.
Nihil kapag: ['teksto'] gawin: { <- ['Nihil']. }.
Labas isulat: (Nihil bago), bagong-linya.
