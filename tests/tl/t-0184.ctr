

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa pamamahala-ng-memorya: 0.

Bilang kapag: ['addNum:'] gawin: { :x
	sarili idagdag: x.
}.

Bilang kapag: ['subtractNum:'] gawin: { :x
	sarili ibawas: x.
}.

Bilang kapag: ['multiplyBy:'] gawin: { :x
	sarili paramihin-ng: x.
}.

Bilang kapag: ['divideBy:'] gawin: { :x
	sarili hatiin-ng: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 itaas-sa: 8).  
a := a + (2 itaas-sa: -1). 
a := a + (49 pariugat).   
a addNum: ((Listahan ← 0 ; 1) pinakamalaki).          
a addNum: ((Listahan ← 2 ; 3) pinakamaliit).
Labas isulat: a.

Programa linisin.

usedMemory1 := (Programa memorya ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 itaas-sa: 8).  
a := a + (2 itaas-sa: -1). 
a := a + (49 pariugat).   
a addNum: ((Listahan ← 0 ; 1) pinakamalaki).          
a addNum: ((Listahan ← 2 ; 3) pinakamaliit).
Labas isulat: a.

Programa linisin.
usedMemory2 := (Programa memorya ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 itaas-sa: 8).  
a := a + (2 itaas-sa: -1). 
a := a + (49 pariugat).   
a addNum: ((Listahan ← 0 ; 1) pinakamalaki).          
a addNum: ((Listahan ← 2 ; 3) pinakamaliit).
Labas isulat: a.

Programa linisin.
usedMemory3 := (Programa memorya ? 0).



( usedMemory1 = usedMemory2 at: usedMemory1 = usedMemory3, at: usedMemory2 = usedMemory3 ) totoo: {
	Labas isulat: ['No memory leaks here'].
}, mali: {
	Labas isulat: ['Leaking memory...'].
}.
