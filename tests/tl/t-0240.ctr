# test qualifiers

>> $ := Bagay bago.

$ kapag: ['tumugon:'] gawin: { :x
	
	>> operation := x titik: 0.
	>> valuta := x titik: 1.
	>> money := x laktawan: 2.
	
	>> amount := 0.

	( operation = ['+'] ) totoo: {
		( valuta = ['£'] ) totoo: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Labas isulat: x, bagong-linya.


>> Fruit := Bagay bago.

Fruit kapag: ['bago'] gawin: {
	>> f := sarili bago.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit kapag: ['apples:'] gawin: { :a sarili-ko apples := a. }.
Fruit kapag: ['oranges:'] gawin: { :p sarili-ko oranges := p. }.
Fruit kapag: ['apples'] gawin: { <- sarili-ko apples. }.
Fruit kapag: ['oranges'] gawin: { <- sarili-ko oranges. }.

Fruit kapag: ['+'] gawin: { :f
	
	>> n := Fruit bago.
	f idagdag: 1.
	
	n apples: (f apples + sarili-ko apples).
	n oranges:  (f oranges  + sarili-ko oranges). <- n.
}.

Fruit kapag: ['teksto'] gawin: { <- ( sarili-ko apples teksto + [' apples and '] + sarili-ko oranges + [' oranges'] ).
}.

Bilang kapag: ['apples'] gawin: { <- ((Fruit bago) apples: sarili).
}.

Bilang kapag: ['apple'] gawin: { <- ((Fruit bago) apples: sarili).
}.

Bilang kapag: ['oranges'] gawin: { <- ((Fruit bago) oranges: sarili).
}.




Labas isulat: (1 apple + 3 oranges + 4 apples), bagong-linya.


Teksto kapag: ['twice'] gawin: { <- ((sarili teksto) + (sarili teksto)).
}.



Labas isulat: ['❤❤❤'] twice.



