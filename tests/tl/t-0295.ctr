
>> dictionary := (
	Diksyunaryo bago
		ilagay: ['b'] sa: ['a'],
		ilagay: ['a'] sa: ['b'],
		ilagay: ['z'] sa: ['x'],
		ilagay: ['hello'] sa: ['hallo'],
		ilagay: ['human'] sa: ['human']
).

>> comparisons := Listahan bago.
dictionary bawat: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a ihambing: b)
	).
}.

comparisons ayusin: { :a :b <- ( a ihambing: b ). }.
Labas isulat: ( comparisons pagsamahin: ['↵'] ), bagong-linya.
comparisons pagsamahin: ['↵'].
