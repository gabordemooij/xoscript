>> invoice := Bagay bago.
invoice kapag: ['patakbuhin'] gawin: {
        sarili-ko bilang := 0.
}.

invoice kapag: ['bilang'] gawin: {
        sarili-ko bilang idagdag: 1. <- sarili-ko bilang kopyahin.
}.

>> year-invoice := invoice bago.
year-invoice kapag: ['start:'] gawin: { :taon
	sarili-ko bilang := taon.
}.

year-invoice start: 202000.
Labas isulat: year-invoice bilang, bagong-linya.
Labas isulat: year-invoice bilang, bagong-linya.
