

Listahan kapag: ['fixture:'] gawin: { :f
	sarili-ko fixture := f.
}.

Listahan kapag: ['bilangin'] gawin: { <- sarili-ko fixture.
}.

Listahan kapag: ['aantal'] gawin: { <- sarili-ko fixture.
}.


>> x := Wala.
{

	x := ['hello'] 
	palitan:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] titik: 2)
			)
		)
	ng: (
		(['...hal'] + ['lo']) 
			malalaking-titik 
			lowecase 
			malalaking-titik 
			laktawan: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Listahan ← 0 ; 1 ; 4; 9 ; (Listahan ← 0 ; 3; 1) ; 4
							) bago-ang-huli
						) ? 1
					) + 
					((Listahan ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					bilangin
				)
			)
	).

} × 10.
Labas isulat: x, bagong-linya.

