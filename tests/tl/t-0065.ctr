Bilang kapag: ['factorial'] gawin: {
	>> total := 1.
	{ :index total paramihin-ng: (sarili - (index)). } × sarili. <- total.
}.
>> Printer := Bagay bago.
Printer kapag: ['print:and:'] gawin: { :x :y
	Labas isulat: ['a='] + x + [', b='] + y, bagong-linya.
}.
>> a := 4.5. >> b := a ibaba-ang-bilog.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a itaas-ang-bilog.
Printer print: a and: b.
a := 4.5. b := a ibaba-ang-bilog.
Printer print: a and: b.
a := 4.5. b := a bilugin.
Printer print: a and: b.
a := 4.2. b := a bilugin.
Printer print: a and: b.

Labas isulat: (9 labis: 5), bagong-linya.
Labas isulat: -666 ganap-na-halaga, bagong-linya.
Labas isulat: 49 pariugat, bagong-linya.
Labas isulat: (2 itaas-sa: 3), bagong-linya.
>> l := (Listahan ← 9 ; 6).
Labas isulat: l pinakamaliit.

