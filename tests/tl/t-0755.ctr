Labas isulat: ['Test object'], bagong-linya.
>> greeter := Bagay bago.
greeter kapag: ['name:'] gawin: { :pangalan
	sarili-ko xname := pangalan. 
}.
greeter kapag: ['greet'] gawin: {
	Labas isulat: ['Hello '] + sarili-ko xname, bagong-linya.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Labas isulat: ['========== RELOADING SNAP:'], bagong-linya.
>> b := Bagay load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
