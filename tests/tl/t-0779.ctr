Labas isulat: ['Test object'], bagong-linya.
>> p := Landas /tmp.
Labas isulat: p, bagong-linya.
>> old-p-address := p prototipo adres-ng-memorya.
p save-as: ['/tmp/a.bin'].
Labas isulat: ['========== RELOADING SNAP:'], bagong-linya.
>> b := Bagay load-from: ['/tmp/a.bin'].
(b prototipo adres-ng-memorya = old-p-address) totoo: {
	Labas isulat: ['Object link re-attached.'], bagong-linya.
}.
Labas isulat: b, bagong-linya.
