['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Labas isulat: (x + y), bagong-linya.

>> x := 10040.07.
>> y := 10305.60.

Labas isulat: (x + y), bagong-linya.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Labas isulat: (x + y + z), bagong-linya.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Labas isulat: (x + y + z), bagong-linya.

>> q := 0.1.2.

Labas isulat: (q), bagong-linya.

>> q := 012.

Labas isulat: (q), bagong-linya.
