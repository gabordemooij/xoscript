Listahan kapag: ['kopyahin'] gawin: {
	>> kopyahin := Listahan bago.
	sarili bawat: { :bilang :section
		kopyahin idagdag-sa-dulo: section rekursibo kopyahin.
	}. <- kopyahin.
}.

>> sheep := Listahan bago ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep kopyahin.
clones bawat: { :bilang :sheep
	sheep idagdag-sa-dulo: ['2'].
}.

Labas isulat: sheep, bagong-linya.
Labas isulat: clones, bagong-linya.
