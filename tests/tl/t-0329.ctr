Labas isulat: ((Listahan bago
	kapag: ['plaque:'] gawin: { :x sarili-ko o := x. },
	kapag: ['plaque']  gawin: { <- sarili-ko o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Listahan ← 1)
	~ (Listahan ← 1 ; 2)
	~ (Listahan ← 1 ; 2 ; 3)
	~ (Listahan ← 1 ; 2 ; 3 ; 4)
	~ (Listahan ← 1 ; 2 ; 3 ; 4 ; 5)
) bawat: { :i :el
	{ Labas isulat: gawaing-ito. } × el bilangin.
	Labas bagong-linya.
}) plaque, bagong-linya.


