Server init.
>> f := Anyo bago: ['%d'].
>> a := Blob bago: 4.
a bytes: ( Listahan bago ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob bago: 4.
b bytes: ( Listahan bago ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a mula-sa: 0 haba: 3, bawat: { :i :byte
	Labas isulat: ( f ilapat-buumbilang: byte ), bagong-linya.
}.
a ^ b.
a mula-sa: 0 haba: 3, bawat: { :i :byte
	Labas isulat: ( f ilapat-buumbilang: byte ), bagong-linya.
}.
a ^ b.
a mula-sa: 0 haba: 3, bawat: { :i :byte
	Labas isulat: ( f ilapat-buumbilang: byte ), bagong-linya.
}.
a palayain.
b palayain.

{ a ^ Bagay. } saluhin: { :e Labas isulat: e, bagong-linya. }, patakbuhin.
