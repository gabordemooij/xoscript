>> To-Do := Bagay bago.

To-Do kapag: ['bago'] gawin: {
	sarili-ko list := Listahan bago.
}.

To-Do kapag: ['nieuw'] gawin: {
	sarili-ko list := Listahan bago.
}.

To-Do kapag: ['+'] gawin: { :task
	sarili-ko list idagdag-sa-dulo: task.
}.

To-Do kapag: ['number of tasks?'] gawin: { <-  sarili-ko list bilangin.
}.

>> todos := 
	To-Do bago 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Labas isulat: ['You have $ tasks to do'] $ todos number of tasks?.
