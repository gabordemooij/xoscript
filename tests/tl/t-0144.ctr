



>> CoffeeGrounds := Bagay bago.
CoffeeGrounds kapag: ['extract'] gawin: { <- ['coffee']. }.

>> CoffeeMachine := Bagay bago.
CoffeeMachine kapag: ['init'] gawin: {
	sarili-ko coffeegrounds := CoffeeGrounds bago.
}.
CoffeeMachine kapag: ['bago'] gawin: { <- CoffeeMachine `new init.
}.

CoffeeMachine kapag: ['makeTea'] gawin: { <- (sarili-ko tealeaves extract). }.
CoffeeMachine kapag: ['makeCoffee'] gawin: { <- (sarili-ko coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine bago.

Labas isulat:
	coffeeDream 
	makeCoffee.

Labas isulat:
	coffeeDream 
	makeTea.
