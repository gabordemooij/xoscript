Bilang kapag: ['factorial'] gawin: {
	>> total := 1.
	{ :index total paramihin-ng: (sarili - (index)). } × sarili. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Labas isulat: a.
>> b := 2 + 3 factorial.
Labas isulat: b.
>> c := 3 factorial + 2.
Labas isulat: c.
>> d := 2 + (3 factorial).
Labas isulat: d.
Labas isulat: 2 + 3 factorial + 1.
