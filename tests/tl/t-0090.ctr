Labas isulat: ['1,2,3,4,5,6,7,8,9,A,'], bagong-linya.
>> Scope := Bagay bago.
Scope kapag: ['initialize:'] gawin: { :x sarili-ko property := x. }.
Scope kapag: ['confirm'] gawin: { Labas isulat: [',']. }.
Scope kapag: ['pagsubok'] gawin: {
	Labas isulat: sarili-ko property.
	sarili confirm.
	( 1 = 1 ) totoo: { Labas isulat: sarili-ko property. sarili confirm. }.
	( 1 = 0 ) mali: { Labas isulat: sarili-ko property. sarili confirm. }.
	>> y := 2. { Labas isulat: sarili-ko property. sarili confirm. } habang: { y ibawas: 1. <- (y > 0). }.
	{ Labas isulat: sarili-ko property. sarili confirm. } × 1.
	(Listahan ← 1) bawat: {  Labas isulat: sarili-ko property. sarili confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Diksyunaryo bago one: ['item']) bawat: { Labas isulat: sarili-ko property. sarili confirm. }.
	{ 1 ÷ 0. } saluhin: { Labas isulat: sarili-ko property. sarili confirm. }, patakbuhin.
	Labas bagong-linya.
}.
>> scope1 := Scope bago.
scope1 initialize: ['X'].
scope1 pagsubok.
>> function := { 
	sarili-ko property := ['Y'].
	Labas isulat: sarili-ko property.
	sarili confirm.
