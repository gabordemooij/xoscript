Server init.
>> fmt := Anyo bago: ['%#3x'].

>> blob := Blob bago: 4.
blob bytes: ( 
	Listahan bago ; 0 ; 1 ; 2 ; 3
).

>> file := Talaksan bago: ['/tmp/blob'].
file blob: blob.
blob palayain.

>> basahin := file blob.
basahin 
mula-sa: 0 
haba: 4, 
gawin bawat: { :i :b 
	Labas
	isulat: (fmt ilapat-buumbilang: b),
	bagong-linya.
}.
basahin palayain.
