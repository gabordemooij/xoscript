# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Padron bago: pattern.
	p tugma: subject gawin: { :m :g
		Labas isulat: g bilangin, isulat: [' '], isulat: (g pagsamahin: ['|']), bagong-linya. <- m.
	}.
}.
show ilapat: ['(a)|(b)'] at: ['b'].
show ilapat: ['(a)|(b)'] at: ['a'].
show ilapat: ['(x)?y'] at: ['y'].
show ilapat: ['(x)?(y)(z)?'] at: ['xy'].
