


>> CoffeeMachine := Bagay bago.
CoffeeMachine kapag: ['order:'] gawin: { :id
	>> coffee := ['Americano'].
	( id = 1 ) totoo: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) totoo: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) totoo: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Bagay bago.
SimpleCoffeeMachine kapag: ['order'] gawin: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Labas isulat: redCup, bagong-linya.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Labas isulat: greenCup, bagong-linya.
>> yellowCup := CoffeeMachine order: 1.
Labas isulat: yellowCup, bagong-linya.
>> blueCup := CoffeeMachine order: 0.
Labas isulat: blueCup, bagong-linya.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Labas isulat: blackCup, bagong-linya.
blackCup idagdag-sa-dulo: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Labas isulat: orangeCup, bagong-linya.
