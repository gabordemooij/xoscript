Labas isulat: ['Test object'], bagong-linya.
>> a := Bagay bago. 
a kapag: ['item:'] gawin: { :lst
	sarili-ko lst := lst. 
}.
a kapag: ['item'] gawin: { <- sarili-ko lst.
}.
a item: (
	Listahan bago ; 1 ; (
		Listahan bago ; ['a'] ; (
			Listahan bago ; ( Sandali bago: 1 )
		) ; ( Int64 mula-sa-teksto: ['321'] )
	)
).
Labas isulat: a item, bagong-linya.
>> old-lst-address := a item prototipo adres-ng-memorya.
a save-as: ['/tmp/a.bin'].
Labas isulat: ['========== RELOADING SNAP:'], bagong-linya.
>> b := Bagay load-from: ['/tmp/a.bin'].
(b item prototipo adres-ng-memorya = old-lst-address) totoo: {
	Labas isulat: ['Object link re-attached.'], bagong-linya.
}.
Labas isulat: ( b item ), bagong-linya.
