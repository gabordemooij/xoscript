# test number -> string -> number
{

	>> x := Bilang sa-pagitan-ng: 0 at: 1000000.
	>> d := Bilang sa-pagitan-ng: 1 at: 7.
	>> e := 10 itaas-sa: d.

	x hatiin-ng: e.
	>> y := x teksto bilang.

	(x = y) mali: {
		Labas isulat: x, bagong-linya.
		Labas isulat: y, bagong-linya.
		Programa tapusin.
	}.

} * 1000.
Labas isulat: ['OK'], bagong-linya.