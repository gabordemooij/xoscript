Labas isulat: ['Test object'], bagong-linya.
>> a := Bagay bago. 

a kapag: ['item:'] gawin: { :octhelper
	sarili-ko octhelper := octhelper. 
}.

a kapag: ['item'] gawin: { <- sarili-ko octhelper.
}.

a item: Oct bago.

>> old-octhelper-address := a item prototipo adres-ng-memorya.
a save-as: ['/tmp/a.bin'].
Labas isulat: ['========== RELOADING SNAP:'], bagong-linya.

>> b := Bagay load-from: ['/tmp/a.bin'].

(b item prototipo adres-ng-memorya = old-octhelper-address) totoo: {
	Labas isulat: ['Object link re-attached.'], bagong-linya.
}.
