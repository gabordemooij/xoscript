>> items := Diksyunaryo bago.
items ilagay: ['black'] sa: ['coffee'], ilagay: ['earl grey'] sa: ['tea'].
Labas isulat: (items sa: ['coffee']), isulat: (items sa: ['tea']).
Labas isulat: ['there are'] + items bilangin + [' items in the array.'].
items ilagay: ['capuccino'] sa: ['coffee'].
Labas isulat: ['Now my coffee is.. '] + (items sa: ['coffee']).
items ilagay: ['aaa'] sa: ['1'].
items ilagay: ['bbb'] sa: ['2'].
Labas isulat: (items sa: ['a']).
