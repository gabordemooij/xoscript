


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa pamamahala-ng-memorya: 0.
>> palette := Wala.
>> colors := Wala.

{
palette := Diksyunaryo bago.
palette 
	ilagay: ['#F00'] sa: ['red'],
	ilagay: ['#0F0'] sa: ['green'],
	ilagay: ['#00F'] sa: ['blue'].
Labas isulat: ['number of RGB codes in palette: '] + ( palette bilangin ), bagong-linya.
Labas isulat: ['RGB code of green is: '] + ( palette ? ['green'] ), bagong-linya.
colors := [''].
( palette bawat: { :pangalan :kodigo
		colors := colors + ( pangalan + [':'] + kodigo ).
} ).
Labas isulat: ['All colors in palette: '] + colors, bagong-linya.
} patakbuhin.
Programa linisin.
usedMemory1 := (Programa memorya ? 0).

{
palette := Diksyunaryo bago.
palette 
	ilagay: ['#F00'] sa: ['red'],
	ilagay: ['#0F0'] sa: ['green'],
	ilagay: ['#00F'] sa: ['blue'].
Labas isulat: ['number of RGB codes in palette: '] + ( palette bilangin ), bagong-linya.
Labas isulat: ['RGB code of green is: '] + ( palette ? ['green'] ), bagong-linya.
colors := [''].
( palette bawat: { :pangalan :kodigo
		colors := colors + ( pangalan + [':'] + kodigo ).
} ).
Labas isulat: ['All colors in palette: '] + colors, bagong-linya.
} patakbuhin.
Programa linisin.
usedMemory2 := (Programa memorya ? 0).

{
palette := Diksyunaryo bago.
palette 
	ilagay: ['#F00'] sa: ['red'],
	ilagay: ['#0F0'] sa: ['green'],
	ilagay: ['#00F'] sa: ['blue'].
Labas isulat: ['number of RGB codes in palette: '] + ( palette bilangin ), bagong-linya.
Labas isulat: ['RGB code of green is: '] + ( palette ? ['green'] ), bagong-linya.
colors := [''].
( palette bawat: { :pangalan :kodigo
		colors := colors + ( pangalan + [':'] + kodigo ).
} ).
Labas isulat: ['All colors in palette: '] + colors, bagong-linya.
} patakbuhin.
Programa linisin.
usedMemory3 := (Programa memorya ? 0).



( usedMemory1 = usedMemory2 at: usedMemory1 = usedMemory3, at: usedMemory2 = usedMemory3 ) totoo: {
	Labas isulat: ['No memory leaks here'].
}, mali: {
	Labas isulat: ['Leaking memory...'].
}.
