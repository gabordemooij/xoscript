# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> landas-ng-file := ['/tmp/dat.csv'].
>> csv := Talaksan bago: landas-ng-file.
csv isulat: s.

# accepts CRLF LF CR, varying row length
csv panghati: [';'] panipi: ['"'] mga-linya: { :line
	Programa linisin.
	Labas isulat: line, bagong-linya.
	Programa linisin.
}.

# unequal lines
s idagdag-sa-dulo: ['\njustone'].
csv isulat: s.
{
	csv panghati: [';'] panipi: ['"'] mga-linya: { :line
		Labas isulat: line, bagong-linya.
	}.
} saluhin: { :e 
	Labas isulat: e, bagong-linya.
}, patakbuhin.

# invalid format
s := ['"he"llo";world'].
csv isulat: s.
{
	csv panghati: [';'] panipi: ['"'] mga-linya: { :line
		Labas isulat: line, bagong-linya.
	}.
} saluhin: { :e 
	Labas isulat: e, bagong-linya.
}, patakbuhin.
