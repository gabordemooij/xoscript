# test list operations


>> cakes := Listahan ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes palitan: 1 haba: 2 ng: ( Listahan ← ['cinnamon'] ; ['pineapple'] ).
Labas isulat: (buy pagsamahin: [',']), bagong-linya.


>> buy := cakes palitan: 1 haba: 12 ng: ( Listahan ← ['cinnamon'] ; ['pineapple'] ).
Labas isulat: (buy pagsamahin: [',']), bagong-linya.


>> buy := cakes palitan: 2 haba: 10 ng: ( Listahan bago ).
Labas isulat: (buy pagsamahin: [',']), bagong-linya.


>> buy := cakes palitan: 0 haba: 1 ng: ( Listahan bago ).
Labas isulat: (buy pagsamahin: [',']), bagong-linya.


>> buy := cakes palitan: ['0'] haba: ['1'] ng: ['x'].
Labas isulat: (buy pagsamahin: [',']), bagong-linya.
