	a kapag: ['bilang'] gawin: { <- Totoo. }.
	a := 3 × a.
} saluhin: { :error
	Labas isulat: ['Error noted: '] + error, bagong-linya.
}, patakbuhin.


{
	a kapag: ['boolean'] gawin: { <- 1. }.
	a := Totoo at: a.
} saluhin: { :error
	Labas isulat: ['Error noted: '] + error, bagong-linya.
}, patakbuhin.





