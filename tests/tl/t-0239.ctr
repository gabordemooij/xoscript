Listahan kapag: ['sum'] gawin: {
	>> total := 0.
	sarili bawat: { :index :element
		total idagdag: element.
	}. <- total.
}.

>> a := Totoo.



a kapag: ['teksto'] gawin: {
	>> answer := Wala.
	( sarili = Totoo ) totoo: {
		answer := ['Yep'].
	}, kung-hindi: {
		answer := ['Nope'].
	}. <- answer.
}.

a kapag: ['bilang'] gawin: {
	>> answer := Wala.
	( sarili = Totoo ) totoo: {
		answer := 10.
	}, kung-hindi: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b kapag: ['teksto'] gawin: { <- ['Devil'].
}.

b kapag: ['boolean'] gawin: { <- Mali.
}.


Labas isulat: a, bagong-linya.  
Labas isulat: (90 + a), bagong-linya. 
Labas isulat: b, bagong-linya. 
Labas isulat: (Totoo at: b), bagong-linya.

a := Listahan ← ['hello'] ; ['world'] ; Totoo ; Wala ; 666. 
a := a + ( Listahan ← 1 ).
Labas isulat: a, bagong-linya.
Labas isulat: ((Diksyunaryo bago) ilagay: Wala sa: Wala), bagong-linya.
Labas isulat: a sum, bagong-linya. 


{
	a kapag: ['teksto'] gawin: { <- Wala. }.
	a := [''] + a.
} saluhin: { :error
	Labas isulat: ['Error noted: '] + error, bagong-linya.
}, patakbuhin.



{
	a kapag: ['bilang'] gawin: { <- Wala. }.
	a := 3 × a.
} saluhin: { :error
	Labas isulat: ['Error noted: '] + error, bagong-linya.
}, patakbuhin.


{
	a kapag: ['boolean'] gawin: { <- Wala. }.
	a := Totoo at: a. 
} saluhin: { :error
	Labas isulat: ['Error noted: '] + error, bagong-linya.
}, patakbuhin.





{
	a kapag: ['teksto'] gawin: { <- Mali. }.
	a := [''] + a.
} saluhin: { :error
	Labas isulat: ['Error noted: '] + error, bagong-linya.
}, patakbuhin.



