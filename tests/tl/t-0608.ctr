
>> Size := Bagay bago.
Size kapag: ['is:'] gawin: { :bilang
	bilang kapag: ['+'] gawin: { :bilang
		>> unit := bilang yunit-ng-bilang.
		>> factor := 1.
		
		unit
		kaso: ['inch'] gawin: { factor := 0.0833. }. <- sarili + (bilang * factor).
	}. <- bilang.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Labas isulat: plank + edge, bagong-linya.
