#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa pamamahala-ng-memorya: 0.

{
Sandali oras-ngayon.
Sandali maghintay: 1.
Labas isulat: Programa bilang-ng-argumento, bagong-linya.
Programa argumento: 0.
Bilang random.
Labas isulat: (Programa sistema: ['echo 'Hello'']).
} patakbuhin.

Programa linisin.
usedMemory1 := (Programa memorya ? 0).

{
Sandali oras-ngayon.
Sandali maghintay: 1.
Labas isulat: Programa bilang-ng-argumento, bagong-linya.
Programa argumento: 0.
Bilang random.
Labas isulat: (Programa sistema: ['echo 'Hello'']).
} patakbuhin.

Programa linisin.
usedMemory2 := (Programa memorya ? 0).

{
Sandali oras-ngayon.
Sandali maghintay: 1.
Labas isulat: Programa bilang-ng-argumento, bagong-linya.
Programa argumento: 0.
Bilang random.
Labas isulat: (Programa sistema: ['echo 'Hello'']).
} patakbuhin.

Programa linisin.
usedMemory3 := (Programa memorya ? 0).



( usedMemory1 = usedMemory2 at: usedMemory1 = usedMemory3, at: usedMemory2 = usedMemory3 ) totoo: {
	Labas isulat: ['No memory leaks here'].
}, mali: {
	Labas isulat: ['Leaking memory...'].
}.
