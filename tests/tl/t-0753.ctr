Labas isulat: ['Test object'], bagong-linya.
>> a := Bagay bago. 

a kapag: ['item:'] gawin: { :fmt
	sarili-ko fmt := fmt. 
}.

a kapag: ['item'] gawin: { <- sarili-ko fmt.
}.

a item: ( Anyo bago: ['|%s|'] ).

Labas isulat: a item, bagong-linya.

>> old-fmt-address := a item prototipo adres-ng-memorya.
a save-as: ['/tmp/a.bin'].
Labas isulat: ['========== RELOADING SNAP:'], bagong-linya.

>> b := Bagay load-from: ['/tmp/a.bin'].

(b item prototipo adres-ng-memorya = old-fmt-address) totoo: {
	Labas isulat: ['Object link re-attached.'], bagong-linya.
}.

Labas isulat: ( b item ilapat: ['hello'] ), bagong-linya.
