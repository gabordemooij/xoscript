# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB bago host: ['localhost'],
	pangalan-ng-user: ['xo'],
	password: ['pass123'],
	pangalan-ng-database: ['xobase'],
	kumonekta.

>> parametro-ng-paghahanap := db tanong: ['SELECT %% FROM'].
{ parametro-ng-paghahanap isagawa. } saluhin: { :e
	Labas isulat: ( e naglalaman: ['%%'] ), bagong-linya.
}, patakbuhin.
