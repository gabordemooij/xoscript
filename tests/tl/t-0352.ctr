Bilang kapag: ['roman'] gawin: {
	>> bilang := sarili kopyahin.
	>> roman := [''].
	{
		{
			(bilang ≥ 1000) totoo: {
				roman idagdag-sa-dulo: ['Ⅿ'].
				bilang ibawas: 1000.
			}, itigil.
		
			(bilang ≥ 500) totoo: {
				roman idagdag-sa-dulo: ['Ⅾ'].
				bilang ibawas: 500.
			}, itigil.
		
			(bilang ≥ 100) totoo: {
				roman idagdag-sa-dulo: ['Ⅽ'].
				bilang ibawas: 100.
			}, itigil.
		
			(bilang ≥ 50) totoo: {
				roman idagdag-sa-dulo: ['Ⅼ'].
				bilang ibawas: 50.
			}, itigil.
		
			(bilang ≥ 50) totoo: {
				roman idagdag-sa-dulo: ['Ⅼ'].
				bilang ibawas: 50.
			}, itigil.
		
			(bilang ≥ 10) totoo: {
				roman idagdag-sa-dulo: ['Ⅹ'].
				bilang ibawas: 10.
			}, itigil.
			
			(bilang ≥ 9) totoo: {
				roman idagdag-sa-dulo: ['Ⅸ'].
				bilang ibawas: 9.
			}, itigil.
			
			(bilang ≥ 5) totoo: {
				roman idagdag-sa-dulo: ['Ⅴ'].
				bilang ibawas: 5.
			}, itigil.
			
			(bilang ≥ 4) totoo: {
				roman idagdag-sa-dulo: ['Ⅳ'].
				bilang ibawas: 4.
			}, itigil.
			
			(bilang ≥ 1) totoo: {
				roman idagdag-sa-dulo: ['Ⅰ'].
				bilang ibawas: 1.
			}, itigil.
		} pamamaraan.
	} habang: { <- bilang > 0. }. <- roman.
}.

Labas isulat: 1 roman, bagong-linya.
Labas isulat: 2 roman, bagong-linya.
Labas isulat: 4 roman, bagong-linya.
Labas isulat: 8 roman, bagong-linya.
Labas isulat: 16 roman, bagong-linya.
Labas isulat: 32 roman, bagong-linya.
Labas isulat: 64 roman, bagong-linya.
Labas isulat: 128 roman, bagong-linya.
Labas isulat: 256 roman, bagong-linya.
Labas isulat: 1024 roman, bagong-linya.
