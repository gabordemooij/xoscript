# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob bago: 8, bytes: (
	Listahan bago ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Labas isulat: ( utf16 i-decode: ['utf16le'] ), bagong-linya.

utf16 palayain.
>> utf32 := Blob bago: 13, bytes: (
	Listahan bago ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Labas isulat: ( utf32 i-decode: ['utf32be'] ), bagong-linya.
utf32 palayain.