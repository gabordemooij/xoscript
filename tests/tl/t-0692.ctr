Server init.

Labas isulat: (
	Padron bago: ['^\\w+$'],
	tugma: ['test@example.com'] 
), bagong-linya. # 0 match, fails on @ and .

Labas isulat: (
	Padron bago: ['^[^@]+@[^\.]+\.\\w+$'],
	tugma: ['test@example.com'] 
), bagong-linya. # 1 match

Labas isulat: (
	Padron bago: ['[^@]+@[^\.]+\.\\w+'],
	tugma: ['test@example.com'] 
), bagong-linya. # 1 match

Labas isulat: (
	Padron bago: ['([^@]+)@([^\.]+)\.\\w+'],
	tugma: ['test@example.com'] 
), bagong-linya. # 1 match, groups dont matter

Labas isulat: (
	Padron bago: ['[a-z]'],
	tugma: ['test@example.com'] 
), bagong-linya. # 14 matches

Labas isulat: (
	Padron bago: ['.*'],
	tugma: ['test@example.com'] 
), bagong-linya. # 1 match (all)

Labas isulat: (
	Padron bago: ['(.*)'],
	tugma: ['test@example.com'] 
), bagong-linya. # 1 match (all)

Labas isulat: (
	Padron bago: ['\\s*[^@]+@[^\.]+\.\\w+'],
	tugma: ['test@example.com'] 
), bagong-linya. # 1 match, prefix space optional, gets ignored