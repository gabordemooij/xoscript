>> numbers := ['1,2,3'] hatiin: [','].
Labas isulat: ['I got: '] + numbers bilangin + [' numbers.'],bagong-linya.
{ :i Labas isulat: ['number #'] + i + [':'] + (numbers posisyon: i), bagong-linya.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages hatiin: [' Or '].
Labas isulat: ['We serve'], bagong-linya.
{ :i Labas isulat: ['->'] + (beverages posisyon: i), bagong-linya. } × (beverages bilangin).
Labas isulat: (beverages pagsamahin: [',']), bagong-linya.
Labas isulat: (numbers pagsamahin: ['||']).
