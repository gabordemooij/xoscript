Boolean kapag: ['xor:'] gawin: { :a :b <- ((a at: b baligtad) o: (a baligtad at: b)).
}.

>> o := Bagay bago.
o kapag: ['hello'] gawin: { ['Empty']. }.
{ o kapag: 2 gawin: 3.} saluhin: { :e Labas isulat: e, bagong-linya. }, patakbuhin.
{ o kapag: ['pagsubok'] gawin: 3.} saluhin: { :e Labas isulat: e, bagong-linya. }, patakbuhin.
{ o kapag: ['hello'] gawin: { ['Empty']. }.} saluhin: { :e Labas isulat: e, bagong-linya. }, patakbuhin. 
{ >> z := 4 ÷ 0. } saluhin: { :e Labas isulat: e, bagong-linya. }, patakbuhin. 
{ (Totoo at: Wala) totoo: { Labas isulat: ['X'].}. } saluhin: { :e Labas isulat: e, bagong-linya. }, patakbuhin. 
{ ([''] xor: 0) totoo: { Labas isulat: ['X'].}. } saluhin: { :e Labas isulat: e, bagong-linya. }, patakbuhin. 
{ (1 < ['2']) totoo: { Labas isulat: ['OK']. }. } saluhin: { :e Labas isulat: e, bagong-linya. }, patakbuhin. 
{ (1 < ['2.0']) totoo: { Labas isulat: ['OK']. }. } saluhin: { :e Labas isulat: e, bagong-linya. }, patakbuhin. 
{ (1 < ['x2.0']) totoo: { Labas isulat: ['NO!']. }. } saluhin: { :e Labas isulat: e, bagong-linya. }, patakbuhin. 
{ Labas isulat: (['hello OK there'] mula-sa: ['6'] haba: ['2']). } patakbuhin. 
