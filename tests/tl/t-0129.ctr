
Listahan kapag: ['product'] gawin: {
	>> total := 1.
	sarili bawat: { :index :element
		total paramihin-ng: element.
	}. <- total.
}.

>> a := Listahan ← 1 ; 2 ; 3.
Labas isulat: a product, bagong-linya.
Labas isulat: (Listahan ← 2 ; 4 ; 8) product, bagong-linya. 
Labas isulat: (Listahan ← -2 ; 10) product, bagong-linya. 
Labas isulat: (Listahan ← 0.5 ; -2) product, bagong-linya. 
