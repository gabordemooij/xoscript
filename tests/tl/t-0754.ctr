Labas isulat: ['Test object'], bagong-linya.
>> a := Bagay bago. 

a kapag: ['item:'] gawin: { :out
	sarili-ko out := out. 
}.

a kapag: ['item'] gawin: { <- sarili-ko out.
}.

a kapag: ['greet'] gawin: {
	Labas isulat: ['hi from original out!'], bagong-linya.
}.

a item: Labas.

Labas isulat: a item, bagong-linya.

>> old-out-address := a item prototipo adres-ng-memorya.
a save-as: ['/tmp/a.bin'].
Labas isulat: ['========== RELOADING SNAP:'], bagong-linya.

>> b := Bagay load-from: ['/tmp/a.bin'].

(b item prototipo adres-ng-memorya = old-out-address) totoo: {
	Labas isulat: ['Object link re-attached.'], bagong-linya.
}.

b item isulat: ['hello from loaded out!'], bagong-linya.
b greet.
