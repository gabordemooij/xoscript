Labas isulat: ['Test object'], bagong-linya.
>> cmd := Utos bago.
Labas isulat: cmd ls /tmp, bagong-linya.
>> old-cmd-address := cmd prototipo adres-ng-memorya.
cmd save-as: ['/tmp/a.bin'].
Labas isulat: ['========== RELOADING SNAP:'], bagong-linya.
>> b := Bagay load-from: ['/tmp/a.bin'].
(b prototipo adres-ng-memorya = old-cmd-address) totoo: {
	Labas isulat: ['Object link re-attached.'], bagong-linya.
}.
Labas isulat: b ls, bagong-linya.


