Labas isulat: ['Test object'], bagong-linya.
>> a := Bagay bago. 

a kapag: ['item:'] gawin: { :hexhelper
	sarili-ko hexhelper := hexhelper. 
}.

a kapag: ['item'] gawin: { <- sarili-ko hexhelper.
}.

a item: Hx bago.

>> old-hexhelper-address := a item prototipo adres-ng-memorya.
a save-as: ['/tmp/a.bin'].
Labas isulat: ['========== RELOADING SNAP:'], bagong-linya.

>> b := Bagay load-from: ['/tmp/a.bin'].

(b item prototipo adres-ng-memorya = old-hexhelper-address) totoo: {
	Labas isulat: ['Object link re-attached.'], bagong-linya.
}.
