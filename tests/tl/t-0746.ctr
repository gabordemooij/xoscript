Labas isulat: ['Test object'], bagong-linya.
>> a := Bagay bago. 

a kapag: ['item:'] gawin: { :dict
	sarili-ko dict := dict. 
}.

a kapag: ['item'] gawin: { <- sarili-ko dict.
}.

a item: (
Diksyunaryo bago
	hello: ['world'],
	world: (Diksyunaryo bago ilagay: ['a'] sa: ['b'])).

Labas isulat: a item, bagong-linya.

>> old-dict-address := a item prototipo adres-ng-memorya.
a save-as: ['/tmp/a.bin'].
Labas isulat: ['========== RELOADING SNAP:'], bagong-linya.

>> b := Bagay load-from: ['/tmp/a.bin'].

(b item prototipo adres-ng-memorya = old-dict-address) totoo: {
	Labas isulat: ['Object link re-attached.'], bagong-linya.
}.

Labas isulat: b item, bagong-linya.
