# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Kaha gumawa-ng-susi.

# private (secret) key
>> sk := keys una.

# public key
>> pk := keys huli.

# sign a message
>> sig := Kaha lagdaan: ['abc'] gamit: sk.

# check message (ok)
Labas isulat: ( 
	Kaha
		suriin: ['abc'] 
		lagda: sig 
		gamit: pk 
), bagong-linya.

# check message (fail)
Labas isulat: ( 
	Kaha 
		suriin: ['abd'] 
		lagda: sig 
		gamit: pk 
), bagong-linya.