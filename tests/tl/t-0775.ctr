Labas isulat: ['Test object'], bagong-linya.
>> l := Listahan bago ; 1 ; ( Listahan bago ; (Sandali bago: 1) ; (Int64 mula-sa-teksto: ['321']) ; (Listahan bago ; 3)).
Labas isulat: l, bagong-linya.
>> old-lst-address := l prototipo adres-ng-memorya.
l save-as: ['/tmp/a.bin'].
Labas isulat: ['========== RELOADING SNAP:'], bagong-linya.
>> b := Bagay load-from: ['/tmp/a.bin'].
(b prototipo adres-ng-memorya = old-lst-address) totoo: {
	Labas isulat: ['Object link re-attached.'], bagong-linya.
}.
Labas isulat: b, bagong-linya.
