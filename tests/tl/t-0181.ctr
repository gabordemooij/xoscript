

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa pamamahala-ng-memorya: 0.

>> txt := ['World Salad'].
Labas isulat: ['this text contains: '] + ( ( txt hatiin: [' '] ) bilangin ) + [' words.'], bagong-linya.
txt := txt mula-sa: 6 haba: 4.
Labas isulat: txt, bagong-linya.

Programa linisin.

usedMemory1 := (Programa memorya ? 0).


