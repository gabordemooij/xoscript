>> t := Wala.

# you can control the time zone for
# parsing like this:
Sandali sona-ng-oras: ['CET'].
t := Sandali mula: ['1981-02-03 04:05:06'].
Labas isulat: t, bagong-linya.

# now using CEST time zone:
Sandali sona-ng-oras: ['CEST'].
t := Sandali mula: ['1981-02-03 04:05:06'].
Labas isulat: t, bagong-linya.

# error if string cannot be parsed
{ Sandali mula: ['1900']. } saluhin: { Wala. }, patakbuhin.
