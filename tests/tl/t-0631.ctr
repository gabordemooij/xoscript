#ffi test


Server init.

Programa pamamahala-ng-memorya: 4.

# for this test you need set a path to libc (puts)
>> libname := Programa kaayusan: ['FFITESTLIB'].



Server iugnay: (
 Listahan bago ;
 libname ;
 ['puts'] ;
 ( Listahan bago ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s palayain.

# test with struct

>> a := Blob bago: 8.
a bytes: (
	Listahan <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Listahan <<: ['int'], ; ['int']).

Server iugnay: (
	Listahan <<: ['@structtest'], ;
	['@structtest'] ;
	(Listahan <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Labas isulat: ['Sum test:'] + (ffitest ffisum: a), bagong-linya.

struct palayain-struct.
struct palayain.
a palayain.
