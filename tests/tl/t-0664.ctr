# recursive interpolation not allowed

Labas isulat: 
['recursive string interolation enabled: '] + (
	Programa tampok: 
	['RECURSIVE_STRINTPOL']
), bagong-linya.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Labas isulat: a, bagong-linya.


