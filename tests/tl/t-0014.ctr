>> Greeter := Bagay bago.
Greeter kapag: ['make'] gawin: {
	>> gr := Bagay bago.
	gr kapag: ['setName:'] gawin: { :aname
		sarili-ko pangalan := aname.
	}.
	gr kapag: ['greet'] gawin: {
		Labas isulat: sarili-ko pangalan.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a bago.
c setName: ['THREE'].
c greet.
>> d := a bago.
d setName: ['FOUR'].
d greet.
c greet.
