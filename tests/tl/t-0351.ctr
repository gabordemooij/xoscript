
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> kodigo := {
	>> o := (
		Diksyunaryo bago
		aa: (Listahan ← 1 ; 2),
		bb: (Listahan ← 3 ; 4)
	).
	>> s := o teksto.
	>> o2 := s bagay.
	(s  uri = Teksto uri) totoo: { Labas isulat: ['OK1'], bagong-linya. }.
	(o2 uri = Diksyunaryo uri) totoo: { Labas isulat: ['OK2'], bagong-linya. }.
}.

Programa pamamahala-ng-memorya: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Programa linisin.
usedMemory1 := (Programa memorya ? 1).
kodigo patakbuhin.
Programa linisin.
usedMemory2 := (Programa memorya ? 1).
kodigo patakbuhin.
Programa linisin.
usedMemory3 := (Programa memorya ? 1).
kodigo patakbuhin.
