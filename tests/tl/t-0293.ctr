
>> city := Listahan ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Listahan ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature ayon-sa: city.
>> cities := weather mga-susi ayusin: { :a :b <- (a ihambing: b). }.
>> temperatures := weather mga-halaga ayusin: { :a :b <- (a ihambing: b) negatibo?. }.

Labas isulat: (cities pagsamahin: [',']), bagong-linya.
Labas isulat: (temperatures pagsamahin: [',']), bagong-linya.
