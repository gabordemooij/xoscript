
{ :i
	Labas isulat: ['This is step #'] + ( ( i ) + 1 ), bagong-linya.
} × 6.

{ :i
	Labas isulat: ['This is step #'] + ( 3 - ( i ) ), bagong-linya.
} × 6.

{ :i
	Labas isulat: ['NEVER!'], bagong-linya.
} × 0.



{ :i
	Labas isulat: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), bagong-linya.
} × 11.
