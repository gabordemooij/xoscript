

>> Matryoshka := Bagay bago.
Matryoshka kapag: ['double:'] gawin: { :secret
	sarili-ko secret := secret × 2.
}.
Matryoshka kapag: ['bago:'] gawin: { :secret
	>> answer := Wala.
	>> t := (secret > 255).
	Labas isulat: (secret + [' | '] + t), bagong-linya.
	t totoo: {
		answer := secret.
	}, kung-hindi: {
		answer := Matryoshka rekursibo bago: (sarili double: secret).
	}. <- answer.
}.

>> x := Matryoshka bago: 2.
