Server init.

>> DB := Maria-DB bago host: ['localhost'],
	pangalan-ng-user: ['xo'],
	password: ['pass123'],
	pangalan-ng-database: ['xobase'],
	kumonekta.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB tanong: SQL.

# now you don't have to set DB
query2 kunin: { :row
	Labas isulat: row world, bagong-linya.
}.
