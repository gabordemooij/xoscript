
>> Rectangle := Bagay bago.

Rectangle kapag: ['area'] gawin: { <- sarili-ko haba * sarili-ko width.
}.

Rectangle kapag: ['length:'] gawin: { :haba
	sarili-ko haba := haba.
}.

Rectangle kapag: ['width:'] gawin: { :width
	sarili-ko width := width.
}.

Rectangle kapag: ['bago'] gawin: {
	# this will not result into an infinite loop
	>> rectangle := sarili bago.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle bago.
Labas isulat: a area, bagong-linya. #0

>> b := Rectangle bago length: 2, width: 3.
Labas isulat: b area, bagong-linya. #6

