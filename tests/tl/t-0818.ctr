# edge cases from a request must give an error or a result, not a crash
Server init.

Labas isulat: ['<'] + (['abc'] mula-sa: 0 haba: 0, malalaking-titik) + ['>'], bagong-linya.
Labas isulat: ['<'] + (['abc'] mula-sa: 0 haba: 0, maliliit-na-titik) + ['>'], bagong-linya.
Labas isulat: ['<'] + (['abc'] laktawan: 3, malalaking-titik) + ['>'], bagong-linya.
Labas isulat: [''] malalaking-titik bytes, bagong-linya.
Labas isulat: ['aB'] malalaking-titik, bagong-linya.
Labas isulat: ['aB'] maliliit-na-titik, bagong-linya.

Labas isulat: (Sandali bago: 0) taon, bagong-linya.
{ Sandali bago: ['9e300'] bilang. } saluhin: { :e Labas isulat: e, bagong-linya. }, patakbuhin.
{ Sandali bago: ['-9e300'] bilang. } saluhin: { :e Labas isulat: e, bagong-linya. }, patakbuhin.
{ Sandali bago: ['nan'] bilang. } saluhin: { :e Labas isulat: e, bagong-linya. }, patakbuhin.
{ Sandali bago: 9000000000000000000. } saluhin: { :e Labas isulat: e, bagong-linya. }, patakbuhin.
