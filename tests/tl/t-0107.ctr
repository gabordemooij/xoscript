
Labas isulat: ['Break for-loop, 0-4.'], bagong-linya.
{ :i
	Labas isulat: ['iteration #'] + i, bagong-linya.
	(i = 4) itigil.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Labas isulat: ['Break while-true loop, 0-4.'], bagong-linya.
{
	Labas isulat: ['iteration #'] + x, bagong-linya.
	x idagdag: 1.
	((x < 5) baligtad) itigil.
} habang: xIsLessThan10.

Labas isulat: ['Break while-false loop, 5,4.'], bagong-linya.
{
	Labas isulat: ['iteration #'] + x, bagong-linya.
	x ibawas: 1.
	(x = 3) itigil.
} habang: { <- (x > 0). }.

Labas isulat: ['Break times loop, 1-4.'], bagong-linya.
{ :i
	Labas isulat: ['iteration #'] + i, bagong-linya.
	(i = 4) itigil.
} × 5.

Labas isulat: ['Break block, dont print line.'], bagong-linya.
{ Totoo itigil. Labas isulat: ['dont write this!'], bagong-linya. } patakbuhin.

Labas isulat: ['Break block, dont fire catch...'], bagong-linya.
{ Totoo itigil. Labas isulat: ['dont write this!'], bagong-linya. } saluhin: { Labas isulat: ['Dont catch this!']. }, patakbuhin.

Labas isulat: ['Test Array each-loop: 0,1'], bagong-linya.
(Listahan ← 1 ; 2 ; 3) baguhin-bawat: { :i
	Labas isulat: ['iteration #'] + i, bagong-linya.
	(i = 1) itigil.
}.

Labas isulat: ['Test Map each-loop: c only'], bagong-linya.
>> m := Diksyunaryo bago.
m ilagay: ['first'] sa: ['a'], ilagay: ['second'] sa: ['b'], ilagay: ['third'] sa: ['c'].
m bawat: { :k :v
	Labas isulat: ['iteration'] + v + k, bagong-linya.
	Totoo itigil.
}.

