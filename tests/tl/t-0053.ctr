60 × {
	>> x := (Bilang random % 6) + 1.
	(x ≤ 6) mali: { Labas isulat: ['FAIL']. }.
	(x ≥0) mali: { Labas isulat: ['FAIL']. }.
	x := (Bilang random % 3) + 1.
	(x < 3) mali: { Labas isulat: ['FAIL']. }.
	(x>-1) mali: { Labas isulat: ['FAIL']. }.
	x := ((Boolean flip) bilang).
	(x = 0 o: x = 1) mali: { Labas isulat: ['FAIL']. }.
	x := ((Totoo flip) bilang).
	(x = 0 o: x = 1) mali: { Labas isulat: ['FAIL']. }.
	x := (Boolean flip alinman: ['HEAD'] o: ['TAIL']).
	((x = ['HEAD']) o: (x = ['TAIL'])) mali: { Labas isulat: ['FAIL']. }.
}.
Labas isulat: ['DONE'].

