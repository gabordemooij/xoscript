{
	gawaing-ito mali-sa-labas: ['Dont fail.'].
	unknown doSomething.
} saluhin: {
	Labas isulat: ['Caught!'].
}, patakbuhin.

{
	gawaing-ito mali-sa-labas: ['Dont fail.'].
	sarili-ko unknown doSomething.
} saluhin: {
	Labas isulat: ['Caught!'].
}, patakbuhin.

{
	gawaing-ito mali-sa-labas: ['Dont fail.'].
	unknown := 122.
} saluhin: {
	Labas isulat: ['Caught!'].
}, patakbuhin.


{
	gawaing-ito mali-sa-labas: ['Dont fail.'].
	Totoo itigil.
	Labas isulat: ['FAIL'].
} saluhin: {
	Labas isulat: ['Caught!'].
}, patakbuhin.

{
	{
		gawaing-ito mali-sa-labas: ['Dont fail.'].
		Totoo itigil.
		Labas isulat: ['FAIL'].
	} saluhin: { :x
		(x = ['Dont fail.']) totoo: { gawaing-ito mali-sa-labas: ['Nested Caught!']. }.
	}, patakbuhin.
} saluhin: { :e
	Labas isulat: e.
}, patakbuhin.
