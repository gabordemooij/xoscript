Programa pamamahala-ng-memorya: 0.
Listahan kapag: ['sum'] gawin: {
	>> total := 0.
	sarili bawat: { :index :element
		total idagdag: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Talaksan bago: ['/tmp/test.txt'].
f isulat: ['Lorem Ipsum'].
f isara.
  

f := Talaksan bago: ['/tmp/test.txt'].
>> text := f basahin.
f isara.



Programa linisin.
usedMemory1 := (Programa memorya ? 1).



f := Talaksan bago: ['/tmp/test.txt'].
text := f basahin.
f isara.

Programa linisin.
usedMemory2 := (Programa memorya ? 1).


f := Talaksan bago: ['/tmp/test.txt'].
text := f basahin.
f isara.

Programa linisin.
usedMemory3 := (Programa memorya ? 1).



( usedMemory1 = usedMemory2 at: usedMemory1 = usedMemory3, at: usedMemory2 = usedMemory3 ) totoo: {
	Labas isulat: ['No memory leaks here'].
}, mali: {
	Labas isulat: ['Leaking memory...'].
}.
