Labas isulat: ['Test object'], bagong-linya.
>> a := Bagay bago. 
a kapag: ['item:'] gawin: { :int64
	sarili-ko int64 := int64. 
}.
a kapag: ['item'] gawin: { <- sarili-ko int64.
}.
a item: ( Int64 mula-sa-teksto: ['9999'] ).
Labas isulat: a item, bagong-linya.
>> old-int64-address := a item prototipo adres-ng-memorya.
a save-as: ['/tmp/a.bin'].
Labas isulat: ['========== RELOADING SNAP:'], bagong-linya.
>> b := Bagay load-from: ['/tmp/a.bin'].
(b item prototipo adres-ng-memorya = old-int64-address) totoo: {
	Labas isulat: ['Object link re-attached.'], bagong-linya.
}.
Labas isulat: ( b item ), bagong-linya.
