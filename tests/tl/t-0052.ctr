>> items := Diksyunaryo bago.
items ilagay: ['green'] sa: ['color-1'].
items ilagay: ['orange'] sa: ['color-2'].
items ilagay: ['red'] sa: ['color-3'].
>> i := 0.
>> s := [''].
items bawat: { :key :color
	Labas isulat: ['color #'] + i + [' is: '] + color + [' '].
	i idagdag: 1.
}.
Labas isulat: i + [' colors!'].
