>> HTML := Bagay bago.
HTML kapag: ['tumugon:'] gawin: { :tag 
	Labas isulat: (['<tag>'] tag: tag), bagong-linya.
}.
HTML kapag: ['tumugon:at:'] gawin: { :tag :html 
	Labas isulat: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), bagong-linya.
}.
>> html := HTML bago.
html body h1: ['header'].

