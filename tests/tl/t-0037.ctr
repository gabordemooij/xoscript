>> a := 3.
>> b := a kopyahin.
a ibawas: 1.
Labas isulat: [' a = '] + a.
Labas isulat: [' b = '] + b.
a := 3.
b := a + 4.
Labas isulat: [' a = '] + a.
Labas isulat: [' b = '] + b.
>> x := 3.
>> y := x kopyahin.
x idagdag: 10.
y ibawas: 1.
Labas isulat: [' x = '] + x.
Labas isulat: [' y = '] + y.
>> q := Bagay bago.
q kapag: ['setProperty:'] gawin: { :x
	sarili-ko prop := x.
}.
q kapag: ['getProperty'] gawin: { <- sarili-ko prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Labas isulat: [' p = '] + (p getProperty).
