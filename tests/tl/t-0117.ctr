>> t := Totoo.
(t = Totoo) totoo: { Labas isulat: ['T']. }.
(t = Mali) totoo: { Labas isulat: ['F']. }.
Labas isulat: ['|'].
>> t := Mali.
(t = Totoo) totoo: { Labas isulat: ['T']. }.
(t = Mali) totoo: { Labas isulat: ['F']. }.
Labas isulat: ['|'].
>> f := Totoo.
(t = Totoo at: f = Mali) totoo: { Labas isulat: ['T']. }.
(t = Mali at: f = Totoo) totoo: { Labas isulat: ['F']. }.
Labas isulat: ['|'].
>> n := Wala.
(n Wala?) totoo: { Labas isulat: ['T']. }.
(n Wala?) mali: { Labas isulat: ['F']. }.
Labas isulat: ['|'].
(f Boolean?) totoo: { Labas isulat: ['T']. }.
(f Boolean?) mali: { Labas isulat: ['F']. }.



