>> a := Bagay bago. 
a kapag: ['greet'] gawin: { Labas isulat: ['welcome!'], bagong-linya. }.
a kapag: ['greet2'] gawin: { Labas isulat: ['welcome2!'], bagong-linya. }.
a save-as: ['/tmp/a.bin'].

Labas isulat: ['========== RELOADING SNAP:'], bagong-linya.
>> b := Bagay load-from: ['/tmp/a.bin'].
b greet2.