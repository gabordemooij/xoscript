Server init.

>> db := Maria-DB bago host: ['localhost'],
	pangalan-ng-user: ['xo'],
	password: ['pass123'],
	pangalan-ng-database: ['xobase'],
	kumonekta.

>> del := db tanong: ['DELETE FROM book WHERE id > 0'].
{  del isagawa. db pagtibayin. } saluhin: { :e db ibalik.  }, patakbuhin.

>> bilangin := db tanong: ['SELECT COUNT(*) AS num FROM book'].
bilangin kunin: { :row Labas isulat: row num, bagong-linya. }.
