
Listahan kapag: ['sum'] gawin: {
	>> total := 0.
	sarili bawat: { :index :element
		total idagdag: element.
	}. <- total.
}.

>> a := Listahan ← 9 ; 8 ; 7.
Labas isulat: (a sum), bagong-linya. 
>> a := Listahan ← 1 ; 9.
Labas isulat: (a sum), bagong-linya. 
>> a := Listahan ← ['o'] ; 2.
Labas isulat: (a sum), bagong-linya. 
Labas isulat: (Listahan bago sum), bagong-linya. 
