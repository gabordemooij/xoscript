

Programa pamamahala-ng-memorya: 4.
{
	>> cat := Bagay bago.
	cat kapag: ['work'] gawin: {
		gawaing-ito mali-sa-labas: ['Uncatched error has occurred.↵Cats have personel for that!'].
		Labas isulat: ['dont print this!'].
	}.
	{ cat work. } patakbuhin.
} saluhin: { :e
	Labas isulat: e.
}, patakbuhin.
