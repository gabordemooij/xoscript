
>> countries := Listahan bago
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Listahan bago
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods ayon-sa: countries, bawat: { :key :value
	counter idagdag: 1.
}.

Labas isulat: (['we serve counter dishes'] counter: counter), bagong-linya.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] mga-titik ayusin: { :v
	counter idagdag: 0.
}.

Labas isulat: (['we sort counter dishes'] counter: counter), bagong-linya.


>> counter := 0.
{
	{
		counter idagdag: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Labas isulat: (['we calculate counter numbers.'] counter: counter), bagong-linya.

