>> map1 := Diksyunaryo bago.
>> key1 := Listahan bago.
>> key2 := Listahan bago.

map1
	ilagay: ['hello'] sa: key1,
	ilagay: ['world'] sa: key2.


Labas
	isulat: ['Map #1 contains: '] + (map1 sa: key1),
	isulat: [' and '] + (map1 sa: key2), bagong-linya.

>> KeyeableArray := Listahan bago.
KeyeableArray kapag: ['toString'] gawin: { <- (sarili bilangin) toString.
}.

>> map2 := Diksyunaryo bago.
key1 := KeyeableArray bago.
key2 := KeyeableArray bago.

key1 idagdag-sa-dulo: 1.

map2
	ilagay: ['hello'] sa: key1,
	ilagay: ['world'] sa: key2.

Labas
	isulat: ['Map #2 contains: '] + (map2 sa: key1),
	isulat: [' and '] + (map2 sa: key2), bagong-linya.
