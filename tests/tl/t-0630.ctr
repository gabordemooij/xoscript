#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Padron bago: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern tugma: subject gawin: { :m :x
	Labas isulat: m, bagong-linya.
	Labas isulat: x, bagong-linya. <- ['XXX'].
}.
Labas isulat: result, bagong-linya.