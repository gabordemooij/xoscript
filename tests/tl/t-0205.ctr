>> str := ['write:'].
Labas mensahe: ['isulat:'] argumento: (Listahan ← ['Hello World']), bagong-linya. 

Bilang kapag: ['isbetween:and:'] gawin: { :a :b <- ((sarili ≥ a) at: (sarili ≤ b)).
}.

str := ['isbetween:and:'].
Labas isulat: (3 mensahe: str argumento: (Listahan ← 2 ; 8)), bagong-linya.
Labas isulat: (3 mensahe: str argumento: (Listahan ← 1 ; 2)), bagong-linya.


>> CoffeeMachine := Bagay bago.
CoffeeMachine kapag: ['makeCoffeeWithSugar:milk:'] gawin: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Listahan ← 4 ; 2.
Labas isulat: ( CoffeeMachine mensahe: order argumento: coffeeConfiguration ), bagong-linya.
