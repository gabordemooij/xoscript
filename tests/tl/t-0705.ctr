

>> obj := Bagay bago.

obj kapag: ['greet'] gawin: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj kapag: ['task'] gawin: {
	sarili-ko property := 123.
	{
		# try binds self/own to object instead of block
		Labas isulat: sarili greet.
		Labas isulat: sarili-ko property.
		1 / 0.
	} saluhin: {
		Labas isulat: sarili greet.
		Labas isulat: sarili-ko property.
		Labas isulat: ['ok'].
	}, subukan.
}.

obj task.