>> Point := Bagay bago.
Point kapag: ['x-coordinate:'] gawin: { :x sarili-ko x := x. }.
Point kapag: ['y-coordinate:'] gawin: { :y sarili-ko y := y. }.
Point kapag: ['x-coordinate']  gawin: { <- sarili-ko x kopyahin. }.
Point kapag: ['y-coordinate']  gawin: { <- sarili-ko y kopyahin. }.

Point kapag: ['='] gawin: { :other <- ( sarili-ko x = other x-coordinate
		 at: sarili-ko y = other y-coordinate ).
}.

>> pier := Point bago x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point bago x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point bago x-coordinate: 5, y-coordinate: 6.

Labas isulat: pier = town-hall, bagong-linya.
Labas isulat: pier = restaurant, bagong-linya.
