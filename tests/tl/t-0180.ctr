Teksto kapag: ['html'] gawin: { <- (
		sarili
		palitan: ['&'] ng: ['&amp;'],
		palitan: ['<'] ng: ['&lt;'],
		palitan: ['>'] ng: ['&gt;'],
		palitan: ['''] ng: ['&apos;'],
		palitan: ['"'] ng: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa pamamahala-ng-memorya: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Labas isulat: txt kopyahin html, bagong-linya.
Labas isulat: txt kopyahin maliliit-na-titik, bagong-linya.
Labas isulat: txt kopyahin malalaking-titik, bagong-linya.
} patakbuhin.

Programa linisin.

usedMemory1 := (Programa memorya ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Labas isulat: txt kopyahin html, bagong-linya.
Labas isulat: txt kopyahin maliliit-na-titik, bagong-linya.
Labas isulat: txt kopyahin malalaking-titik, bagong-linya.
} patakbuhin.

Programa linisin.
usedMemory2 := (Programa memorya ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Labas isulat: txt kopyahin html, bagong-linya.
Labas isulat: txt kopyahin maliliit-na-titik, bagong-linya.
Labas isulat: txt kopyahin malalaking-titik, bagong-linya.
} patakbuhin.

Programa linisin.
usedMemory3 := (Programa memorya ? 0).



( usedMemory1 = usedMemory2 at: usedMemory1 = usedMemory3, at: usedMemory2 = usedMemory3 ) totoo: {
	Labas isulat: ['No memory leaks here'].
}, mali: {
	Labas isulat: ['Leaking memory...'].
}.
