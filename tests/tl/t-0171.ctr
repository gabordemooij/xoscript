

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa pamamahala-ng-memorya: 0.

>> a := Listahan ← ['hello'] ; ['world'] ; Totoo ; Wala ; 666.
a gawin kunin-ang-huli kunin-ang-una idagdag-sa-simula: ['hi'], idagdag-sa-dulo: 999, tapos-na.
Labas isulat: ( a pagsamahin: [','] ), bagong-linya.

Programa linisin.
usedMemory1 := (Programa memorya ? 0).


a := Listahan ← ['hello'] ; ['world'] ; Totoo ; Wala ; 666.
a kunin-ang-huli. a kunin-ang-una. a idagdag-sa-simula: ['hi'], idagdag-sa-dulo: 999.
Labas isulat: ( a pagsamahin: [','] ), bagong-linya.


Programa linisin.
usedMemory2 := (Programa memorya ? 0).


a := Listahan ← ['hello'] ; ['world'] ; Totoo ; Wala ; 666.
a gawin kunin-ang-huli kunin-ang-una idagdag-sa-simula: ['hi'], idagdag-sa-dulo: 999, tapos-na.
Labas isulat: ( a pagsamahin: [','] ), bagong-linya.


Programa linisin.
usedMemory3 := (Programa memorya ? 0).



( usedMemory1 = usedMemory2 at: usedMemory1 = usedMemory3, at: usedMemory2 = usedMemory3 ) totoo: {
	Labas isulat: ['No memory leaks here'].
}, mali: {
	Labas isulat: ['Leaking memory...'].
}.
