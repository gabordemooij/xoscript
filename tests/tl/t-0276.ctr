>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Bagay bago.
⚄ kapag: ['drawFrom:length:'] gawin: { :pool :bilangin
	
	>> result := [''].
	
	{
		>> index := Bilang random % (pool haba).
		result idagdag-sa-dulo: ( pool titik: (index + 1) ).
		
	} × bilangin. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? haba.
Labas isulat: (['x↵'] x random haba).
Labas isulat: (['y↵'] y ?? haba).

