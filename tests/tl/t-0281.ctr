>> q := Listahan ← 1 ; 2 ; 3.
{ q ? ['1']. } saluhin: { Labas isulat: ['caught!'], bagong-linya. }, patakbuhin.
{ q ? Totoo. } saluhin: { Labas isulat: ['caught!'], bagong-linya. }, patakbuhin.
{ q ? Mali. } saluhin: { Labas isulat: ['caught!'], bagong-linya. }, patakbuhin.
{ q ? Wala. } saluhin: { Labas isulat: ['caught!'], bagong-linya. }, patakbuhin.
{ q ? (Listahan bago). } saluhin: { Labas isulat: ['caught!'], bagong-linya. }, patakbuhin.
{ q ? (Bagay bago). } saluhin: { Labas isulat: ['caught!'], bagong-linya. }, patakbuhin.
{ q ? ({ ['Empty']. }). } saluhin: { Labas isulat: ['caught!'], bagong-linya. }, patakbuhin.
Labas isulat: ['caught them all'], bagong-linya.
