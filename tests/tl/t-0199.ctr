
Programa pamamahala-ng-memorya: 4.

>> Animal := Bagay bago.
Animal kapag: ['make'] gawin: {
	>> animal := Bagay bago.
	animal kapag: ['makeSound'] gawin: {
		Labas isulat: sarili-ko sound.
	}. <- animal.
}.
>> Cat := Bagay bago.
Cat kapag: ['make'] gawin: {
	>> cat := Animal make.
	cat kapag: ['init'] gawin: {
		sarili-ko sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
