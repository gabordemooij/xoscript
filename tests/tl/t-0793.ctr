Server init.

>> DB := Maria-DB bago host: ['localhost'],
	pangalan-ng-user: ['xo'],
	password: ['pass123'],
	pangalan-ng-database: ['xobase'],
	kumonekta.

{
	DB tanong:
	['DROP TABLE movies'],
	isagawa.
} saluhin: { Wala. }, patakbuhin.

DB tanong:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
isagawa.

DB tanong: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
mga-parametro: ( Listahan bago ; ['Halloween'] ),
isagawa.

DB tanong: ['SELECT * FROM movies'],
kunin: { :movie
	Labas isulat: movie title, bagong-linya.
}.

