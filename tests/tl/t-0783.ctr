Labas isulat: ['Test object'], bagong-linya.
>> a := Bagay bago. 

a kapag: ['item:'] gawin: { :moment
	sarili-ko moment := moment. 
}.

a kapag: ['item'] gawin: { <- sarili-ko moment.
}.

>> today := Sandali bago sona-ng-oras: ['CEST'], taon: 2026, buwan: 7.
a item: today.
Labas isulat: a item, bagong-linya.
a save-as: ['/tmp/a.bin'].

