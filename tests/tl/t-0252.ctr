#Linux
>> clock := Sandali bago.
clock sona-ng-oras: ['UTC-1'].
clock taon: 1981, buwan: 1, araw: 5,
      oras: 13, minuto: 15, segundo: 13.

Labas isulat: clock, bagong-linya.
clock sona-ng-oras: ['UTC+0'].

Labas isulat: (
	(clock taon payak) + ['-'] + (clock buwan) + ['-'] + (clock araw) + [' '] +
	(clock oras) + [':'] + (clock minuto) + [':'] + (clock segundo) + [' '] +
	['W'] + (clock linggo) + (clock sona-ng-oras)
), bagong-linya.


clock sona-ng-oras: ['UTC-1'].
Labas isulat: (
	(clock taon payak) + ['-'] + (clock buwan) + ['-'] + (clock araw) + [' '] +
	(clock oras) + [':'] + (clock minuto) + [':'] + (clock segundo) + [' '] +
	['W'] + (clock linggo) + (clock sona-ng-oras)
), bagong-linya.
