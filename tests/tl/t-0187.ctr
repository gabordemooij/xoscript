Bilang kapag: ['factorial'] gawin: {
	>> total := 1.
	{ :index total paramihin-ng: (sarili - index). } × sarili. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa pamamahala-ng-memorya: 0.

{
2 exponent factorial.
Labas isulat: (11 labis: 3), bagong-linya.
Labas isulat: (3.4 bilugin), bagong-linya.
Labas isulat: (7.1 itaas-ang-bilog), bagong-linya.
Labas isulat: (7.9 ibaba-ang-bilog), bagong-linya.
}
patakbuhin.

Programa linisin.

usedMemory1 := (Programa memorya ? 0).

{
2 exponent factorial.
Labas isulat: (11 labis: 3), bagong-linya.
Labas isulat: (3.4 bilugin), bagong-linya.
Labas isulat: (7.1 itaas-ang-bilog), bagong-linya.
Labas isulat: (7.9 ibaba-ang-bilog), bagong-linya.
}
patakbuhin.

Programa linisin.
usedMemory2 := (Programa memorya ? 0).


{
2 exponent factorial.
Labas isulat: (11 labis: 3), bagong-linya.
Labas isulat: (3.4 bilugin), bagong-linya.
Labas isulat: (7.1 itaas-ang-bilog), bagong-linya.
Labas isulat: (7.9 ibaba-ang-bilog), bagong-linya.
} patakbuhin.

Programa linisin.
usedMemory3 := (Programa memorya ? 0).



( usedMemory1 = usedMemory2 at: usedMemory1 = usedMemory3, at: usedMemory2 = usedMemory3 ) totoo: {
	Labas isulat: ['No memory leaks here'].
}, mali: {
	Labas isulat: ['Leaking memory...'].
}.
