


>> wine := Bagay bago.


wine kapag: ['toString'] gawin: { <- ['merlot'].
}.

wine kapag: ['naarTekst'] gawin: { <- ['merlot'].
}.


wine kapag: ['='] gawin: { :other wine <- ( sarili toString = other wine ).
}.

wine kapag: ['=='] gawin: { :other wine <- ( sarili toString = other wine ).
}.



wine
	kaso: ['cabernet'] gawin: { Labas isulat: ['it's a Cabernet!']. },
	kaso: ['syrah']    gawin: { Labas isulat: ['it's a Syrah!'].    },
	kaso: ['merlot']   gawin: { Labas isulat: ['it's a Merlot!'].   },
	kaso: ['malbec']   gawin: { Labas isulat: ['it's a Malbec!'].   }.

Labas bagong-linya.
