
Server init.
>> rq := Kahilingan-HTTP bago.
Labas isulat: ['HTTP-GET d[]=']  + ( rq get-listahan: ['d[]'] ), bagong-linya. # GET
Labas isulat: ['HTTP-GET f[]=']  + ( rq get-listahan: ['f[]'] ), bagong-linya. # GET
Labas isulat: ['HTTP-POST e[]='] + ( rq post-listahan: ['e[]'] ), bagong-linya. # GET
Labas isulat: ['HTTP-POST c=']   + ( rq post: ['c'] ), bagong-linya. # GET
Labas isulat: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), bagong-linya. # GET
