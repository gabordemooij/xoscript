# test Program version

# this feature is disabled by default
Labas isulat: (
	Programa tampok: 
	['RECURSIVE_STRINTPOL']
), bagong-linya.


# but if we set the time back
>> today := Sandali 
sona-ng-oras: ['CEST'],
mula: ['2026-02-15 10:00:00'].
Programa bersyon: today.

# it will be enabled like it used to be (from now on)
Labas isulat: (
	Programa tampok: 
	['RECURSIVE_STRINTPOL']
), bagong-linya.