(usedMemory1 = usedMemory2 = usedMemory3 = usedMemory4 = usedMemory5) totoo: { 
	Labas isulat: ['Memory usage remains stable.'], bagong-linya.
}, kung-hindi: {
	Labas isulat: ['Used memory not stable.'], bagong-linya.
}.
