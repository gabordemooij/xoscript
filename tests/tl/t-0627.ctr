

# create a 64-bit integer for exact calculations
>> a := Int64 mula-sa-teksto: ['123'].

# to string
Labas isulat: a, bagong-linya.

# divide
Labas isulat: a / (Int64 mula-sa-teksto: ['3']), bagong-linya.

# multiply
Labas isulat: a * (Int64 mula-sa-teksto: ['2']), bagong-linya.

# add
Labas isulat: a + (Int64 mula-sa-teksto: ['1']), bagong-linya.

# subtract
Labas isulat: a - (Int64 mula-sa-teksto: ['2']), bagong-linya.

# compare
Labas isulat: ( a =   (Int64 mula-sa-teksto: ['123'])), bagong-linya.
Labas isulat: ( a !=: (Int64 mula-sa-teksto: ['124'])), bagong-linya.
Labas isulat: ( a <   (Int64 mula-sa-teksto: ['124'])), bagong-linya.
Labas isulat: ( a >   (Int64 mula-sa-teksto: ['122'])), bagong-linya.
Labas isulat: ( a >=: (Int64 mula-sa-teksto: ['123'])), bagong-linya.
Labas isulat: ( a <=: (Int64 mula-sa-teksto: ['123'])), bagong-linya.





	