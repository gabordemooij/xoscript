
>> Greeter := Bagay bago.
Greeter kapag: ['bago'] gawin: {
	sarili-ko pangalan := ['?'].
}.
Greeter kapag: ['name:'] gawin: { :pangalan
	sarili-ko pangalan := pangalan.
}.
Greeter kapag: ['greet'] gawin: {
	Labas isulat: (['hello[you]'] [you]: sarili-ko pangalan).
}.
>> friend := Greeter bago.
friend name: ['1'].
friend greet.
