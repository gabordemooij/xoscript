# Test ASCII variants

# Numbers

Labas isulat: (2 !=: 3), bagong-linya.
Labas isulat: (2 <=: 2), bagong-linya.
Labas isulat: (2 >=: 2), bagong-linya.

# Strings

Labas isulat: (['b'] >=: ['a']), bagong-linya.
Labas isulat: (['b'] !=: ['a']), bagong-linya.
Labas isulat: (['b'] <=: ['c']), bagong-linya.

# Bools

Labas isulat: (Totoo !=: Mali), bagong-linya.

# Objects

Labas isulat: (Bagay bago !=: Bagay bago), bagong-linya.

# ASCII list symbol <-:

Labas isulat: (Listahan <<: 1, ; 2 ; 3) bilangin = 3, bagong-linya.

