>> Greeter := Bagay bago.
Greeter kapag: ['make'] gawin: {
	>> greeter := Bagay bago.
	greeter kapag: ['name:'] gawin: { :pangalan
		Labas isulat: ['setting a name'].
		sarili-ko myName := pangalan.
	}.
	greeter kapag: ['performGreeting'] gawin: {
		Labas isulat: ['Hello'].
		Labas isulat: sarili-ko myName.
	}.
	greeter kapag: ['greet'] gawin: {
		sarili performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
