
>> a := Listahan ← (Listahan ← 100 ; 200 ; 300) ; (Listahan ← 9 ; 8 ; 7).
Labas isulat: ['at 0,1 :'].
Labas isulat: a ? 0 ? 1, bagong-linya. 
Labas isulat: ['at 1,2 :'].
Labas isulat: a ? 1 ? 2, bagong-linya. 
>> menu := Diksyunaryo bago.
menu ilagay: (Listahan ← ['pizza'] ; ['spaghetti']) sa: ['Italian Cuisine'].
menu ilagay: (Listahan ← ['bifteki'] ; ['suflaki']) sa: ['Greek Cuisine'].
Labas isulat: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), bagong-linya. 
Labas isulat: ['but not on the same plate.'], bagong-linya.
