>> winery := { <- (	Diksyunaryo bago
		ilagay: 2 sa: ['merlot'],
		ilagay: 3 sa: ['malbec'],
		ilagay: 4 sa: ['syrah']
	).
}.

Labas isulat: (((winery patakbuhin) - ['nothing']) bilangin), bagong-linya.
Labas isulat: (((winery patakbuhin) - ['merlot']) bilangin), bagong-linya.
Labas isulat: (((winery patakbuhin) - ['malbec']) bilangin), bagong-linya.
Labas isulat: (((winery patakbuhin) - ['syrah']) bilangin), bagong-linya.
Labas isulat: (((winery patakbuhin) - ['merlot'] - ['malbec']) bilangin), bagong-linya.
Labas isulat: (((winery patakbuhin) - ['merlot'] - ['syrah']) bilangin), bagong-linya.
Labas isulat: (((winery patakbuhin) - ['malbec'] -['syrah']) bilangin), bagong-linya.
Labas isulat: (((winery patakbuhin) - ['malbec'] - ['syrah'] - ['merlot']) bilangin), bagong-linya.

