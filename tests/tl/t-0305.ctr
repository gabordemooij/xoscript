
Bilang matuto: ['plus:'] ibig-sabihin: ['+'].
Bilang kapag: ['+'] gawin: { :x
	>> rate := 1.
	>> currency := x yunit-ng-bilang.
	(currency = ['euros']) totoo: {
		rate := 2.
	}. <- (sarili plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars yunit: ['dollars'].
euros yunit: ['euros'].
>> money := dollars + euros.
Labas isulat: money, bagong-linya.
