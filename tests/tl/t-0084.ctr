>> makeAdder := { :x
	>> f := { :y <- (sarili-ko x + y). } itakda: ['x'] halaga: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i sarili-ko q ilagay: (sarili-ko f ilapat: (sarili-ko q ? i)) sa: i. } 
	itakda: ['q'] halaga: array,
	itakda: ['f'] halaga: func.
	{ :i mapping ilapat: i. } × (array bilangin).
}.

>> a := Listahan ← 1; 2; 3.
mapper ilapat: a at: (makeAdder ilapat: 100).
Labas isulat: (a posisyon: 0), bagong-linya.
Labas isulat: (a ? 1), bagong-linya.
Labas isulat: (a ? 2), bagong-linya.
