Labas isulat: ['Test object'], bagong-linya.
>> a := Bagay bago. 

a kapag: ['item:'] gawin: { :nil
	sarili-ko nil := nil. 
}.

a kapag: ['item'] gawin: { <- sarili-ko nil.
}.

a item: Wala.

Labas isulat: a item, bagong-linya.

>> old-nil-address := a item prototipo adres-ng-memorya.
a save-as: ['/tmp/a.bin'].
Labas isulat: ['========== RELOADING SNAP:'], bagong-linya.

>> b := Bagay load-from: ['/tmp/a.bin'].

(b item prototipo adres-ng-memorya = old-nil-address) totoo: {
	Labas isulat: ['Object link re-attached.'], bagong-linya.
}.

Labas isulat: b item, bagong-linya.
