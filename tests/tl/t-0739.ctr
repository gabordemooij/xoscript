Labas isulat: ['Test object'], bagong-linya.
>> a := Bagay bago. 

a kapag: ['item:'] gawin: { :binhelper
	sarili-ko binhelper := binhelper. 
}.

a kapag: ['item'] gawin: { <- sarili-ko binhelper.
}.

a item: Bin bago.

>> old-binhelper-address := a item prototipo adres-ng-memorya.
a save-as: ['/tmp/a.bin'].
Labas isulat: ['========== RELOADING SNAP:'], bagong-linya.

>> b := Bagay load-from: ['/tmp/a.bin'].

(b item prototipo adres-ng-memorya = old-binhelper-address) totoo: {
	Labas isulat: ['Object link re-attached.'], bagong-linya.
}.


