

Listahan kapag: ['column:'] gawin: { :column
	>> result := Listahan bago.
	sarili bawat: { :index :row
		row bawat: { :index :cell
			(index = column) totoo: { result idagdag-sa-dulo: cell. }.
		}.
	}. <- result.
}.


>> a := Listahan ←
	(Listahan ← 1 ; 2 ; 3) ;
	(Listahan ← 4 ; 5 ; 6) ;
	(Listahan ← 7 ; 8 ; 9).

>> b := a column: 1.
Labas isulat: b, bagong-linya.

b := a column: 20.
Labas isulat: b, bagong-linya.

b := a column: -100.
Labas isulat: b, bagong-linya.
