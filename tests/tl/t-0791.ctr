Server init.

>> DB := Maria-DB bago host: ['localhost'],
	pangalan-ng-user: ['xo'],
	password: ['pass123'],
	pangalan-ng-database: ['xobase'],
	kumonekta.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> parametro-ng-paghahanap := Maria-Tanong bago: SQL.

# set database
parametro-ng-paghahanap database: DB.

parametro-ng-paghahanap kunin: { :row
	Labas isulat: row world, bagong-linya.
}.
