Server init.

# write a test file
>> f := Talaksan bago: ['/tmp/test.gif'].
f isulat: ['GIF87a01234567810'].

# serve the file
Server ipasa: ['test.gif'] unlapi: ['/tmp/'].

Labas bagong-linya.

Labas isulat: ['Outside container (security):'], bagong-linya.
{ Server ipasa: ['../passwd'] unlapi: ['/tmp/']. }
saluhin: { :e Labas isulat: e, bagong-linya. },
patakbuhin.

Labas isulat: ['Invalid prefix:'], bagong-linya.
{ Server ipasa: ['test.gif'] unlapi: ['z:\\']. }
saluhin: { :e Labas isulat: e, bagong-linya. },
patakbuhin.

Labas isulat: ['Non-existant file:'], bagong-linya.
{ Server ipasa: ['xxx.xxx'] unlapi: ['/tmp/']. }
saluhin: { :e Labas isulat: e, bagong-linya. },
patakbuhin.
