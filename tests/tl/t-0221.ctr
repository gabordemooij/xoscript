>> x := Bagay bago.
>> y := Bagay bago.
>> z := x.
Labas isulat: (x = z), bagong-linya.
Labas isulat: (x = y), bagong-linya.
Labas isulat: (x ≠ y), bagong-linya.
Labas isulat: (x ≠ z), bagong-linya.
>> m := Sandali bago taon: 2070, buwan: 11.
>> n := m kopyahin.
Labas isulat: (m = n), bagong-linya.
Labas isulat: (m ≠ n), bagong-linya.
Labas isulat: (m kapareho: m), bagong-linya.
Labas isulat: (m kapareho: n), bagong-linya.
n buwan: 12.
Labas isulat: (m ≠ n), bagong-linya.
Labas isulat: (m = n), bagong-linya.


