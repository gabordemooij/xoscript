Labas isulat: ['Test object'], bagong-linya.
>> a := Bagay bago. 

a kapag: ['item:'] gawin: { :boolean
	sarili-ko boolean := boolean. 
}.

a kapag: ['item'] gawin: { <- sarili-ko boolean.
}.

a item: Boolean.

Labas isulat: a item, bagong-linya.

>> old-bool-address := a item prototipo adres-ng-memorya.
a save-as: ['/tmp/a.bin'].
Labas isulat: ['========== RELOADING SNAP:'], bagong-linya.

>> b := Bagay load-from: ['/tmp/a.bin'].

(b item prototipo adres-ng-memorya = old-bool-address) totoo: {
	Labas isulat: ['Object link re-attached.'], bagong-linya.
}.

Labas isulat: b item, bagong-linya.
