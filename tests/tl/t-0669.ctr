# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Kaha 
	hash-ng-password: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Kaha 
	hash-ng-password: hash patunayan: a1.
	# fail 
>> b := Kaha
	hash-ng-password: hash patunayan: a2.
	# ok!

Labas isulat: a, bagong-linya.
Labas isulat: b, bagong-linya.

