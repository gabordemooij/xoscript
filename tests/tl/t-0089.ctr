>> randomizer := { :a :b
	>> pinakamaliit := ( a < b ) alinman: a o: b.
	>> pinakamalaki := ( a > b ) alinman: a o: b.
	>> x := Wala.
	{
		x := Bilang sa-pagitan-ng: a at: b.
		((x < pinakamaliit) o: (x > pinakamalaki)) totoo: { 
			Labas isulat: (['Invalid value!']).
			Programa tapusin.
		}.
	} 
	× 100. <- x.
}.
randomizer ilapat: 0 at: 0.
