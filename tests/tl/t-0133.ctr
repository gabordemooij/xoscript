


>> Deck := Listahan bago.
Deck kapag: ['print'] gawin: {
        >> len := sarili bilangin - 1.
        { :i
                >> len2 := sarili bilangin - 1.
                Labas isulat: ['len: '].
                Labas isulat: len, bagong-linya.
                Labas isulat: ['len2: '].
                Labas isulat: len2, bagong-linya.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
