>> Grandfather := Bagay bago.
Grandfather kapag: ['greet'] gawin: {
	Labas isulat: ['Ave!'], bagong-linya.
}.
>> Father := Grandfather bago.
Father kapag: ['greet'] gawin: {
	Labas isulat: ['Hello'], bagong-linya.
	sarili greet.
}.
>> Son := Father bago.
Son kapag: ['greet'] gawin: {
	Labas isulat: ['Hi'], bagong-linya.
	sarili greet.
}.

Son greet.

>> Roundabout := Bagay bago.
Roundabout kapag: ['circle:'] gawin: { :x
	Labas isulat: x, bagong-linya.
	(x < 3) totoo: { sarili rekursibo circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) totoo: { Labas isulat: x, bagong-linya. x idagdag: 1.  increment patakbuhin. }. }.
increment patakbuhin.