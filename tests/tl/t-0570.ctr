#Linux

 >> t := Sandali bago.
 
t sona-ng-oras: ['Europe/Amsterdam'].
t taon: 2020, buwan: 8, araw: 2, oras: 21, minuto: 2, segundo: 1.

>> a := t oras.
>> ams := t sona-ng-oras.

t sona-ng-oras: ['US/Hawaii'].
>> b := t oras.
>> hw := t sona-ng-oras.

Labas
isulat: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		alinman: ['later'] o: ['earlier']
	)
),
bagong-linya.
 