# compliance test

# use international numbers

Labas isulat: ['1000 -> '].
Labas isulat: 1000, bagong-linya. #1000

Labas isulat: ['1.5 -> '].
Labas isulat: 1.5, bagong-linya.  #1.5

Labas isulat: ['1001.5 -> '].
Labas isulat: 1.5 + 1000, bagong-linya. #1001.5

# use 0-indexed arrays
>> x := Listahan bago ; 1 ; 2 ; 3.
>> y := Listahan bago ; ['a'] ; ['b'] ; ['c'].

Labas isulat: ['1 -> '].
Labas isulat: x ? 0, bagong-linya. #1

Labas isulat: ['1 -> '].
Labas isulat: (x sa: 0), bagong-linya. #1

Labas isulat: ['1 -> '].
Labas isulat: x una, bagong-linya. #1

Labas isulat: ['3 -> '].
Labas isulat: x huli, bagong-linya. #3

Labas isulat: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Labas isulat: (x ayon-sa: y), bagong-linya.

Labas isulat: ['1 -> '].
Labas isulat: (x mula-sa: 0 haba: 1) una, bagong-linya. #1

Labas isulat: ['0 -> '].
Labas isulat: (x hanapin: 1), bagong-linya. #0

x ilagay: 9 sa: 0.

Labas isulat: ['9 -> '].
Labas isulat: (x sa: 0), bagong-linya. #9

x idagdag-sa-simula: 8.
Labas isulat: ['8 -> '].
Labas isulat: (x sa: 0), bagong-linya. #9


x idagdag-sa-dulo: 10.
Labas isulat: ['10 -> '].
Labas isulat: (x sa: 4), bagong-linya. #10








