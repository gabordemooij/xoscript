
Teksto kapag: ['evaluate'] gawin: {
	>> kodigo := Talaksan bago: ['/tmp/eval.ctr'].
	kodigo isulat: (sarili teksto + ['.']).
	Programa gamitin: ['/tmp/eval.ctr'].
}.

>> map :=
	(Diksyunaryo bago)
	ilagay: ['Hi There'] sa: ['two'],
	ilagay: (Listahan ← ['hello'] ; ['world'] ; (Listahan ← 1 ; 2; 9) ; Mali) sa: ['one'],
	ilagay: ( (Diksyunaryo bago) ilagay: ['wrrld'] sa: ['misspelled'] ) sa: ['three'],
	ilagay: (Listahan ← ((Diksyunaryo bago) ilagay: ['treasure'] sa: ['hidden']) ; 2) sa: ['four']. 
>> str := map teksto.
>> map2 := Wala.
(['map2 := '] + str ) evaluate.
Labas isulat: map2 ? ['one'] ? 0.
Labas isulat: map2 ? ['one'] ? 1.
Labas isulat: map2 ? ['four'] ? 0 ? ['hidden'].
Labas isulat: map2 ? ['one'] ? 2 ? 2.
