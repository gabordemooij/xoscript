# test qualifiers

Programa linisin.

>> Fruit := Bagay bago.
Fruit kapag: ['bago'] gawin: {
	>> f := sarili bago.
	f apples: 0. <- f.
}.
Fruit kapag: ['apples:'] gawin: { :a sarili-ko apples := a. }.
Fruit kapag: ['apples'] gawin: { <- sarili-ko apples. }.
Fruit kapag: ['+'] gawin: { :f
	>> n := Fruit bago.
	n apples: (f apples + sarili-ko apples). <- n.
}.
Bilang kapag: ['apples'] gawin: { <- ((Fruit bago) apples: sarili).
}.

Fruit kapag: ['teksto'] gawin: { <- sarili-ko apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Labas isulat: q, bagong-linya.




q := 3 apples + 4 apples.
