#Linux
>> OS := Programa sistema: (Utos uname -s), tabasin.

>> Slurp := Bagay bago.
Slurp kapag: ['bago'] gawin: {
	sarili-ko str := [''].
}.
Slurp kapag: ['tumugon:'] gawin: { :blah
		(sarili-ko str ≠ ['']) totoo: {
			sarili-ko str idagdag-sa-dulo: [' '].
		}.
		sarili-ko str idagdag-sa-dulo: blah.
}.
Slurp kapag: ['tumugon:at:'] gawin: { :blah :blahah
		(sarili-ko str ≠ ['']) totoo: {
			sarili-ko str idagdag-sa-dulo: [' '].
		}.
		(blah haba > 1) totoo: {
			sarili-ko str idagdag-sa-dulo: (blah mula-sa: 0 haba: (blah haba - 1)).
		}, kung-hindi: {
			sarili-ko str idagdag-sa-dulo: blah.
		}.
		sarili-ko str idagdag-sa-dulo: [' '].
		sarili-ko str idagdag-sa-dulo: blahah.
}.
Slurp kapag: ['obtain'] gawin: {
	>> buffer := sarili-ko str.
	sarili-ko str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text idagdag-sa-dulo: ['hello'].
} × 1000.


Labas isulat: (
	Programa sistema: (
		Slurp bago
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

