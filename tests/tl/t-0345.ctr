# test catch-all methods
>> x13 := Bagay bago.
x13 kapag: ['a'] gawin: { :a Labas isulat: 0, bagong-linya. }.
x13 kapag: ['a:'] gawin: { :a Labas isulat: a, bagong-linya. <- 5. }.
x13 kapag: ['a:b:'] gawin: { :a :b Labas isulat: (a + b), bagong-linya. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
