# test url parsing

Server init.
>> url := URL mula: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Labas isulat: ['scheme = '] + url iskema, bagong-linya.
Labas isulat: ['host = '] + url host, bagong-linya.
Labas isulat: ['port = '] + url port, bagong-linya.
Labas isulat: ['path = '] + url landas-ng-file, bagong-linya.
Labas isulat: ['query = '] + url parametro-ng-paghahanap, bagong-linya.
Labas isulat: ['fragment = '] + url bahagi, bagong-linya.
