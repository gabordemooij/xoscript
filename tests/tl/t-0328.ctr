Programa pamamahala-ng-memorya: 4.

>> Doubler := Bagay bago.
>> Multiplier := Bagay bago.
Doubler kapag: ['double:and:'] gawin: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier kapag: ['multiply:and:'] gawin: { :x :y <- (x × y).
}.

Labas isulat: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), bagong-linya.
