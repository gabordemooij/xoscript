>> items := Толь шинэ.
items хийх: ['green'] түлхүүр: ['color-1'].
items хийх: ['orange'] түлхүүр: ['color-2'].
items хийх: ['red'] түлхүүр: ['color-3'].
>> i := 0.
>> s := [''].
items бүр: { :key :color
	Гаралт бичих: ['color #'] + i + [' is: '] + color + [' '].
	i нэмэх: 1.
}.
Гаралт бичих: i + [' colors!'].
