>> repeater := Объект шинэ.
repeater ирэхэд: ['хариулах:'] гүйцэтгэ: { :what
	Гаралт бичих: what + [' '].
}.
repeater ирэхэд: ['хариулах:ба:'] гүйцэтгэ: { :what :say
	Гаралт бичих: what, бичих: say + [' '].
}.
repeater ирэхэд: ['хариулах:ба:ба:'] гүйцэтгэ: { :what :say :more
	Гаралт бичих: what, бичих: say, бичих: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
