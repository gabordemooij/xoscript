

Жагсаалт ирэхэд: ['sum'] гүйцэтгэ: {
	>> total := 0.
	өөрөө бүр: { :index :element
		total нэмэх: element.
	}. <- total.
}.

Жагсаалт ирэхэд: ['product'] гүйцэтгэ: {
	>> total := 1.
	өөрөө бүр: { :index :element
		total үржүүлэх: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програм санах-ойн-удирдлага: 0.

{

>> a := Жагсаалт ← ['hello'] ; ['world'] ; Үнэн ; Хоосон ; 666.
a := a + ( Жагсаалт ← 1 ).
Гаралт бичих: ( ['sum: '] + ( a sum ) ), шинэ-мөр.
Гаралт бичих: ( ['min: '] + ( a хамгийн-бага ) ), шинэ-мөр.
Гаралт бичих: ( ['max: '] + ( a хамгийн-их ) ), шинэ-мөр.
Гаралт бичих: ( ['3rd: '] + ( a ? 2 ) ), шинэ-мөр.
Гаралт бичих: ( ['prd: '] + ( a product ) ), шинэ-мөр.
a эрэмбэлэх: { :a :b <- (b - a). }.
a бүр: { :i :e Гаралт бичих: ( i - 0 ), шинэ-мөр. }.

} ажиллуулах.

Програм цэвэрлэх.
usedMemory1 := (Програм санах-ой ? 0).


{

>> a := Жагсаалт ← ['hello'] ; ['world'] ; Үнэн ; Хоосон ; 666.
a := a + ( Жагсаалт ← 1 ).
Гаралт бичих: ( ['sum: '] + ( a sum ) ), шинэ-мөр.
Гаралт бичих: ( ['min: '] + ( a хамгийн-бага ) ), шинэ-мөр.
Гаралт бичих: ( ['max: '] + ( a хамгийн-их ) ), шинэ-мөр.
Гаралт бичих: ( ['3rd: '] + ( a ? 2 ) ), шинэ-мөр.
Гаралт бичих: ( ['prd: '] + ( a product ) ), шинэ-мөр.
a эрэмбэлэх: { :a :b <- (b - a). }.
a бүр: { :i :e Гаралт бичих: ( i - 0 ), шинэ-мөр. }.

} ажиллуулах.



Програм цэвэрлэх.
usedMemory2 := (Програм санах-ой ? 0).


{

>> a := Жагсаалт ← ['hello'] ; ['world'] ; Үнэн ; Хоосон ; 666.
a := a + ( Жагсаалт ← 1 ).
Гаралт бичих: ( ['sum: '] + ( a sum ) ), шинэ-мөр.
Гаралт бичих: ( ['min: '] + ( a хамгийн-бага ) ), шинэ-мөр.
Гаралт бичих: ( ['max: '] + ( a хамгийн-их ) ), шинэ-мөр.
Гаралт бичих: ( ['3rd: '] + ( a ? 2 ) ), шинэ-мөр.
Гаралт бичих: ( ['prd: '] + ( a product ) ), шинэ-мөр.
a эрэмбэлэх: { :a :b <- (b - a). }.
a бүр: { :i :e Гаралт бичих: ( i - 0 ), шинэ-мөр. }.

} ажиллуулах.



Програм цэвэрлэх.
usedMemory3 := (Програм санах-ой ? 0).

( usedMemory1 = usedMemory2 ба: usedMemory1 = usedMemory3, ба: usedMemory2 = usedMemory3 ) үнэн-бол: {
	Гаралт бичих: ['No memory leaks here'].
}, худал-бол: {
	Гаралт бичих: ['Leaking memory...'].
}.
