>> makeAdder := { :x
	>> f := { :y <- (өөрийн x + y). } тохируулах: ['x'] утга: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i өөрийн q хийх: (өөрийн f хэрэглэх: (өөрийн q ? i)) түлхүүр: i. } 
	тохируулах: ['q'] утга: array,
	тохируулах: ['f'] утга: func.
	{ :i mapping хэрэглэх: i. } × (array тоо-ширхэг).
}.

>> a := Жагсаалт ← 1; 2; 3.
mapper хэрэглэх: a ба: (makeAdder хэрэглэх: 100).
Гаралт бичих: (a байрлал: 0), шинэ-мөр.
Гаралт бичих: (a ? 1), шинэ-мөр.
Гаралт бичих: (a ? 2), шинэ-мөр.
