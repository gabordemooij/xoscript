

Жагсаалт ирэхэд: ['column:'] гүйцэтгэ: { :column
	>> result := Жагсаалт шинэ.
	өөрөө бүр: { :index :row
		row бүр: { :index :cell
			(index = column) үнэн-бол: { result төгсгөлд-нэмэх: cell. }.
		}.
	}. <- result.
}.


>> a := Жагсаалт ←
	(Жагсаалт ← 1 ; 2 ; 3) ;
	(Жагсаалт ← 4 ; 5 ; 6) ;
	(Жагсаалт ← 7 ; 8 ; 9).

>> b := a column: 1.
Гаралт бичих: b, шинэ-мөр.

b := a column: 20.
Гаралт бичих: b, шинэ-мөр.

b := a column: -100.
Гаралт бичих: b, шинэ-мөр.
