
>> Greeter := Объект шинэ.
Greeter ирэхэд: ['шинэ'] гүйцэтгэ: {
	өөрийн нэр := ['?'].
}.
Greeter ирэхэд: ['name:'] гүйцэтгэ: { :нэр
	өөрийн нэр := нэр.
}.
Greeter ирэхэд: ['greet'] гүйцэтгэ: {
	Гаралт бичих: (['hello[you]'] [you]: өөрийн нэр).
}.
>> friend := Greeter шинэ.
friend name: ['1'].
friend greet.
