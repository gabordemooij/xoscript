# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Програм тохиргоо: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server холбох: ( Жагсаалт шинэ ;
 libname ; ['fopen'] ;
 ( Жагсаалт шинэ ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
холбох: ( Жагсаалт шинэ ;
 Хоосон ; # means same lib
 ['fread'] ;
 ( Жагсаалт шинэ ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Хоосон ; # means same object (i.e. Stream)
 ['fread']
),
холбох: (
 Жагсаалт шинэ ;
 Хоосон ; # means same lib
 ['fwrite'] ;
 ( Жагсаалт шинэ ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Хоосон ; # means same lib
 ['fwrite']
),
холбох: (
 Жагсаалт шинэ ;
 Хоосон ; # means same lib
 ['rewind'] ;
 ( Жагсаалт шинэ ; ['pointer'] ) ;
 ['int'] ;
 Хоосон ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> зам := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: зам mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream мессеж: ['fwrite'] аргументууд: (Жагсаалт шинэ ; str ; 1 ; 6 ; fd ).
Гаралт бичих: bytes-written, шинэ-мөр.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob шинэ: 20.

# read from file
>> bytes-read := Stream мессеж: ['fread'] аргументууд: (Жагсаалт шинэ ; buf ; 1 ; 6 ; fd ).
Гаралт бичих: bytes-read, шинэ-мөр.
Гаралт бичих: buf, шинэ-мөр.

# free memory
str  чөлөөлөх.
зам чөлөөлөх.
mode чөлөөлөх.
buf  чөлөөлөх.


