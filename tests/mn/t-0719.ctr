Server init.
>> fmt := Хэлбэр шинэ: ['%#3x'].

>> blob := Blob шинэ: 4.
blob bytes: ( 
	Жагсаалт шинэ ; 0 ; 1 ; 2 ; 3
).

>> file := Файл шинэ: ['/tmp/blob'].
file blob: blob.
blob чөлөөлөх.

>> унших := file blob.
унших 
эхлэл: 0 
урт: 4, 
гинж-эхлэл бүр: { :i :b 
	Гаралт
	бичих: (fmt хэрэглэх-бүхэл: b),
	шинэ-мөр.
}.
унших чөлөөлөх.
