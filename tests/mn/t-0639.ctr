
Server init.
Гаралт бичих: ['Database test'], шинэ-мөр.

>> db := Maria-DB шинэ хост: ['localhost'],
	хэрэглэгчийн-нэр: ['xo'], 
	нууц-үг: ['pass123'],
	өгөгдлийн-сангийн-нэр: ['xobase'],
	холбогдох.

>> хайлтын-параметрүүд :=
db асуулга: ['SELECT REPEAT('Blah',1000) AS blah'], 
татах: { :row 
	Гаралт бичих: row blah урт, шинэ-мөр.
}.
