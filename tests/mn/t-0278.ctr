>> To-Do := Объект шинэ.

To-Do ирэхэд: ['шинэ'] гүйцэтгэ: {
	өөрийн list := Жагсаалт шинэ.
}.

To-Do ирэхэд: ['nieuw'] гүйцэтгэ: {
	өөрийн list := Жагсаалт шинэ.
}.

To-Do ирэхэд: ['+'] гүйцэтгэ: { :task
	өөрийн list төгсгөлд-нэмэх: task.
}.

To-Do ирэхэд: ['number of tasks?'] гүйцэтгэ: { <-  өөрийн list тоо-ширхэг.
}.

>> todos := 
	To-Do шинэ 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Гаралт бичих: ['You have $ tasks to do'] $ todos number of tasks?.
