# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> зам := ['/tmp/dat.csv'].
>> csv := Файл шинэ: зам.
csv бичих: s.

# accepts CRLF LF CR, varying row length
csv тусгаарлагч: [';'] хашилт: ['"'] мөрүүд: { :line
	Програм цэвэрлэх.
	Гаралт бичих: line, шинэ-мөр.
	Програм цэвэрлэх.
}.

# unequal lines
s төгсгөлд-нэмэх: ['\njustone'].
csv бичих: s.
{
	csv тусгаарлагч: [';'] хашилт: ['"'] мөрүүд: { :line
		Гаралт бичих: line, шинэ-мөр.
	}.
} барих: { :e 
	Гаралт бичих: e, шинэ-мөр.
}, ажиллуулах.

# invalid format
s := ['"he"llo";world'].
csv бичих: s.
{
	csv тусгаарлагч: [';'] хашилт: ['"'] мөрүүд: { :line
		Гаралт бичих: line, шинэ-мөр.
	}.
} барих: { :e 
	Гаралт бичих: e, шинэ-мөр.
}, ажиллуулах.
