{
	энэ-даалгавар алдаа: ['Dont fail.'].
	unknown doSomething.
} барих: {
	Гаралт бичих: ['Caught!'].
}, ажиллуулах.

{
	энэ-даалгавар алдаа: ['Dont fail.'].
	өөрийн unknown doSomething.
} барих: {
	Гаралт бичих: ['Caught!'].
}, ажиллуулах.

{
	энэ-даалгавар алдаа: ['Dont fail.'].
	unknown := 122.
} барих: {
	Гаралт бичих: ['Caught!'].
}, ажиллуулах.


{
	энэ-даалгавар алдаа: ['Dont fail.'].
	Үнэн таслах.
	Гаралт бичих: ['FAIL'].
} барих: {
	Гаралт бичих: ['Caught!'].
}, ажиллуулах.

{
	{
		энэ-даалгавар алдаа: ['Dont fail.'].
		Үнэн таслах.
		Гаралт бичих: ['FAIL'].
	} барих: { :x
		(x = ['Dont fail.']) үнэн-бол: { энэ-даалгавар алдаа: ['Nested Caught!']. }.
	}, ажиллуулах.
} барих: { :e
	Гаралт бичих: e.
}, ажиллуулах.
