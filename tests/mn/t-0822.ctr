# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := Maria-DB шинэ хост: ['localhost'],
	хэрэглэгчийн-нэр: ['xo'],
	нууц-үг: ['pass123'],
	өгөгдлийн-сангийн-нэр: ['xobase'],
	холбогдох.

>> хайлтын-параметрүүд := db асуулга: ['SELECT ? AS a, ? AS b, ? AS c'].
хайлтын-параметрүүд параметрүүд: (Жагсаалт шинэ ; ['1']).
{ хайлтын-параметрүүд татах: { :row Гаралт бичих: row, шинэ-мөр. }. } барих: { :e Гаралт бичих: e, шинэ-мөр. }, ажиллуулах.

>> хайлтын-параметрүүд := db асуулга: ['SELECT ? AS a'].
{ хайлтын-параметрүүд татах: { :row Гаралт бичих: row, шинэ-мөр. }. } барих: { :e Гаралт бичих: e, шинэ-мөр. }, ажиллуулах.

# the right number still works, more parameters are ignored as before
>> хайлтын-параметрүүд := db асуулга: ['SELECT ? AS a, ? AS b'].
хайлтын-параметрүүд параметрүүд: (Жагсаалт шинэ ; ['1'] ; ['2']).
хайлтын-параметрүүд татах: { :row Гаралт бичих: (row байрлалд: ['a']), бичих: (row байрлалд: ['b']), шинэ-мөр. }.
хайлтын-параметрүүд параметрүүд: (Жагсаалт шинэ ; ['1'] ; ['2'] ; ['3']).
хайлтын-параметрүүд татах: { :row Гаралт бичих: (row байрлалд: ['a']), бичих: (row байрлалд: ['b']), шинэ-мөр. }.
