Server init.

>> DB := Maria-DB шинэ хост: ['localhost'],
	хэрэглэгчийн-нэр: ['xo'],
	нууц-үг: ['pass123'],
	өгөгдлийн-сангийн-нэр: ['xobase'],
	холбогдох.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> хайлтын-параметрүүд := Maria-Асуулга шинэ: SQL.

# set database
хайлтын-параметрүүд өгөгдлийн-сан: DB.

хайлтын-параметрүүд татах: { :row
	Гаралт бичих: row world, шинэ-мөр.
}.
