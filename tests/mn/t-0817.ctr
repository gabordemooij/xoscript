# a value ending in the first part of an opening quote must survive serialization
>> утгууд := Жагсаалт шинэ
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

утгууд бүр: { :i :value
	>> d := Толь шинэ.
	d хийх: value түлхүүр: ['k'].
	d хийх: ['second'] түлхүүр: ['j'].
	>> r := d код объект.
	Гаралт бичих: r тоо-ширхэг, шинэ-мөр.
	Гаралт бичих: ( (r байрлалд: ['k']) = value ), шинэ-мөр.
}.
