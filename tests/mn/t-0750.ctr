Гаралт бичих: ['Test object'], шинэ-мөр.
>> a := Объект шинэ. 

a ирэхэд: ['item:'] гүйцэтгэ: { :nil
	өөрийн nil := nil. 
}.

a ирэхэд: ['item'] гүйцэтгэ: { <- өөрийн nil.
}.

a item: Хоосон.

Гаралт бичих: a item, шинэ-мөр.

>> old-nil-address := a item эх-загвар санах-ойн-хаяг.
a save-as: ['/tmp/a.bin'].
Гаралт бичих: ['========== RELOADING SNAP:'], шинэ-мөр.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item эх-загвар санах-ойн-хаяг = old-nil-address) үнэн-бол: {
	Гаралт бичих: ['Object link re-attached.'], шинэ-мөр.
}.

Гаралт бичих: b item, шинэ-мөр.
