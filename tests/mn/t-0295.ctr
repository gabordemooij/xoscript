
>> dictionary := (
	Толь шинэ
		хийх: ['b'] түлхүүр: ['a'],
		хийх: ['a'] түлхүүр: ['b'],
		хийх: ['z'] түлхүүр: ['x'],
		хийх: ['hello'] түлхүүр: ['hallo'],
		хийх: ['human'] түлхүүр: ['human']
).

>> comparisons := Жагсаалт шинэ.
dictionary бүр: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a харьцуулах: b)
	).
}.

comparisons эрэмбэлэх: { :a :b <- ( a харьцуулах: b ). }.
Гаралт бичих: ( comparisons нэгтгэх: ['↵'] ), шинэ-мөр.
comparisons нэгтгэх: ['↵'].
