#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програм санах-ойн-удирдлага: 0.

{
Агшин цаг.
Агшин хүлээх: 1.
Гаралт бичих: Програм аргументын-тоо, шинэ-мөр.
Програм аргумент: 0.
Тоо random.
Гаралт бичих: (Програм систем: ['echo 'Hello'']).
} ажиллуулах.

Програм цэвэрлэх.
usedMemory1 := (Програм санах-ой ? 0).

{
Агшин цаг.
Агшин хүлээх: 1.
Гаралт бичих: Програм аргументын-тоо, шинэ-мөр.
Програм аргумент: 0.
Тоо random.
Гаралт бичих: (Програм систем: ['echo 'Hello'']).
} ажиллуулах.

Програм цэвэрлэх.
usedMemory2 := (Програм санах-ой ? 0).

{
Агшин цаг.
Агшин хүлээх: 1.
Гаралт бичих: Програм аргументын-тоо, шинэ-мөр.
Програм аргумент: 0.
Тоо random.
Гаралт бичих: (Програм систем: ['echo 'Hello'']).
} ажиллуулах.

Програм цэвэрлэх.
usedMemory3 := (Програм санах-ой ? 0).



( usedMemory1 = usedMemory2 ба: usedMemory1 = usedMemory3, ба: usedMemory2 = usedMemory3 ) үнэн-бол: {
	Гаралт бичих: ['No memory leaks here'].
}, худал-бол: {
	Гаралт бичих: ['Leaking memory...'].
}.
