


>> CoffeeMachine := Объект шинэ.
CoffeeMachine ирэхэд: ['order:'] гүйцэтгэ: { :id
	>> coffee := ['Americano'].
	( id = 1 ) үнэн-бол: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) үнэн-бол: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) үнэн-бол: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Объект шинэ.
SimpleCoffeeMachine ирэхэд: ['order'] гүйцэтгэ: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Гаралт бичих: redCup, шинэ-мөр.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Гаралт бичих: greenCup, шинэ-мөр.
>> yellowCup := CoffeeMachine order: 1.
Гаралт бичих: yellowCup, шинэ-мөр.
>> blueCup := CoffeeMachine order: 0.
Гаралт бичих: blueCup, шинэ-мөр.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Гаралт бичих: blackCup, шинэ-мөр.
blackCup төгсгөлд-нэмэх: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Гаралт бичих: orangeCup, шинэ-мөр.
