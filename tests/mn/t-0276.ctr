>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Объект шинэ.
⚄ ирэхэд: ['drawFrom:length:'] гүйцэтгэ: { :pool :тоо-ширхэг
	
	>> result := [''].
	
	{
		>> index := Тоо random % (pool урт).
		result төгсгөлд-нэмэх: ( pool тэмдэгт: (index + 1) ).
		
	} × тоо-ширхэг. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? урт.
Гаралт бичих: (['x↵'] x random урт).
Гаралт бичих: (['y↵'] y ?? урт).

