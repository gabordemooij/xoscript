# catch-all test (practical)
>> HTML := Тэмдэгт-мөр шинэ.
HTML ирэхэд: ['encode:'] гүйцэтгэ: { :tekst
	өөрөө төгсгөлд-нэмэх: (tekst
	солих: ['&'] үүгээр: ['&amp;'], 
	солих: ['<'] үүгээр: ['&lt;'],
	солих: ['>'] үүгээр: ['&gt;'],
	солих: ['"'] үүгээр: ['&quot;']).
}.
>> blog := HTML шинэ.
blog төгсгөлд-нэмэх: ['<h1>'],
     encode: ['Koffie & Thee'],
     төгсгөлд-нэмэх: ['</h1>'].
Гаралт бичих: blog, шинэ-мөр.


>> Roman := Тоо шинэ.
Roman ирэхэд: ['stringy'] гүйцэтгэ: {
	>> a := [''].
	{ a төгсгөлд-нэмэх: ['I']. } × өөрөө. <- a.
}.

>> x := Roman шинэ.
x нэмэх: 3.
Гаралт бичих: x stringy, шинэ-мөр.

>> Quantum := Логик шинэ.
Quantum ирэхэд: ['true?'] гүйцэтгэ: { <- ['maybe True']. }.
Гаралт бичих: (Quantum шинэ true?), шинэ-мөр.

>> Nihil := Хоосон шинэ.
Nihil ирэхэд: ['тэмдэгт-мөр'] гүйцэтгэ: { <- ['Nihil']. }.
Гаралт бичих: (Nihil шинэ), шинэ-мөр.
