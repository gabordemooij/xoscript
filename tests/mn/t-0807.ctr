# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB шинэ хост: ['localhost'],
	хэрэглэгчийн-нэр: ['xo'],
	нууц-үг: ['pass123'],
	өгөгдлийн-сангийн-нэр: ['xobase'],
	холбогдох.

>> хайлтын-параметрүүд := db асуулга: ['SELECT %% FROM'].
{ хайлтын-параметрүүд гүйцэтгэх. } барих: { :e
	Гаралт бичих: ( e багтаасан: ['%%'] ), шинэ-мөр.
}, ажиллуулах.
