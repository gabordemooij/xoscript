>> a := Объект шинэ. 
a ирэхэд: ['greet'] гүйцэтгэ: { Гаралт бичих: ['welcome!'], шинэ-мөр. }.
a ирэхэд: ['greet2'] гүйцэтгэ: { Гаралт бичих: ['welcome2!'], шинэ-мөр. }.
a save-as: ['/tmp/a.bin'].

Гаралт бичих: ['========== RELOADING SNAP:'], шинэ-мөр.
>> b := Объект load-from: ['/tmp/a.bin'].
b greet2.