# Test utf8 sanitizer
Server init.

>> utf8cases := Толь шинэ
	# ASCII only
	хийх: ( Жагсаалт шинэ ; 65 ; 65 ; 65 ; 65 ; 0 ) түлхүүр: ['AAAA'],
	# valid 2 byte sequence
	хийх: ( Жагсаалт шинэ ; 194 ; 162 ; 0 ) түлхүүр: ['¢'],
	# Valid 3-byte UTF-8
    хийх: ( Жагсаалт шинэ ; 226 ; 130 ; 172 ; 0 ) түлхүүр: ['€'],
	# Valid 4-byte UTF-8
    хийх: ( Жагсаалт шинэ ; 240 ; 144 ; 141 ; 136 ; 0 ) түлхүүр: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    хийх: ( Жагсаалт шинэ ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) түлхүүр: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    хийх: ( Жагсаалт шинэ ; 65 ; 193 ; 129 ; 0 ) түлхүүр: ['A?'],
	# Invalid first byte (0xFF)
    хийх: ( Жагсаалт шинэ ; 255 ; 0 ) түлхүүр: ['?'],
	# Incomplete multi-byte sequence at end
    хийх: ( Жагсаалт шинэ ; 66 ; 226 ; 0 ) түлхүүр: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    хийх: ( Жагсаалт шинэ ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) түлхүүр: ['A€?𐍈B'].
	 
utf8cases бүр: { :key :value
	>> blob := Blob шинэ: value тоо-ширхэг, bytes: value.
	>> str := blob тэмдэгт-мөр.
	(str = key) үнэн-бол: {
		Гаралт бичих: ['OK'], шинэ-мөр.
	}, үгүй-бол: {
		Гаралт бичих: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, шинэ-мөр.
	}.
	blob чөлөөлөх.
}.
