60 × {
	>> x := (Тоо random % 6) + 1.
	(x ≤ 6) худал-бол: { Гаралт бичих: ['FAIL']. }.
	(x ≥0) худал-бол: { Гаралт бичих: ['FAIL']. }.
	x := (Тоо random % 3) + 1.
	(x < 3) худал-бол: { Гаралт бичих: ['FAIL']. }.
	(x>-1) худал-бол: { Гаралт бичих: ['FAIL']. }.
	x := ((Логик flip) тоо).
	(x = 0 эсвэл: x = 1) худал-бол: { Гаралт бичих: ['FAIL']. }.
	x := ((Үнэн flip) тоо).
	(x = 0 эсвэл: x = 1) худал-бол: { Гаралт бичих: ['FAIL']. }.
	x := (Логик flip энэ: ['HEAD'] эс-бөгөөс: ['TAIL']).
	((x = ['HEAD']) эсвэл: (x = ['TAIL'])) худал-бол: { Гаралт бичих: ['FAIL']. }.
}.
Гаралт бичих: ['DONE'].

