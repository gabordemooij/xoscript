Гаралт бичих: ['Continue for-loop, No - before 6 and up.'], шинэ-мөр.
{ :i
	Гаралт бичих: (i + 1), шинэ-мөр.
	((i + 1) > 4) үргэлжлүүлэх.
	Гаралт бичих: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Гаралт шинэ-мөр.
Гаралт бичих: ['Continue while-true, No --> before 5 and up.'], шинэ-мөр.
{
	Гаралт бичих: ['iteration #'] + x, шинэ-мөр.
	x нэмэх: 1.
	((x < 5) эсрэг) үргэлжлүүлэх.
	Гаралт бичих: ['-->'].
} байх-зуур: xIsLessThan10.
Гаралт шинэ-мөр.
Гаралт бичих: ['Continue while-false, No - before 3 only.'], шинэ-мөр.
{
	Гаралт бичих: ['iteration #'] + x, шинэ-мөр.
	x хасах: 1.
	(x = 3) үргэлжлүүлэх.
	Гаралт бичих: ['-'].
} байх-зуур: { <- ( x > 0). }.

Гаралт шинэ-мөр.
Гаралт бичих: ['Continue times-loop, No ||| before 3.'], шинэ-мөр.
{ :i
	Гаралт бичих: ['iteration #'] + i, шинэ-мөр.
	(i = 2) үргэлжлүүлэх.
	Гаралт бичих: ['|||'].
} × 5.

Гаралт шинэ-мөр.

{ Үнэн үргэлжлүүлэх. Гаралт бичих: ['dont write this!'], шинэ-мөр. } ажиллуулах.

{ Үнэн үргэлжлүүлэх. Гаралт бичих: ['dont write this!'], шинэ-мөр. } барих: { Гаралт бичих: ['Dont catch this!']. }, ажиллуулах.

Гаралт бичих: ['Test Array each-loop: 0, ... ,2'], шинэ-мөр.
(Жагсаалт ← 1 ; 2 ; 3) хувиргах: { :i
	(i = 1) үргэлжлүүлэх.
	Гаралт бичих: ['iteration #'] + (i - 0), шинэ-мөр.
}.

Гаралт бичих: ['Test Map each-loop: c only'], шинэ-мөр.
>> m := Толь шинэ.
m хийх: ['first'] түлхүүр: ['a'], хийх: ['second'] түлхүүр: ['b'], хийх: ['third'] түлхүүр: ['c'].
m бүр: { :k :v
	(k ≠ ['c']) үргэлжлүүлэх.
	Гаралт бичих: ['iteration'] + k + v, шинэ-мөр.
}.

