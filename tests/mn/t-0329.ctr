Гаралт бичих: ((Жагсаалт шинэ
	ирэхэд: ['plaque:'] гүйцэтгэ: { :x өөрийн o := x. },
	ирэхэд: ['plaque']  гүйцэтгэ: { <- өөрийн o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Жагсаалт ← 1)
	~ (Жагсаалт ← 1 ; 2)
	~ (Жагсаалт ← 1 ; 2 ; 3)
	~ (Жагсаалт ← 1 ; 2 ; 3 ; 4)
	~ (Жагсаалт ← 1 ; 2 ; 3 ; 4 ; 5)
) бүр: { :i :el
	{ Гаралт бичих: энэ-даалгавар. } × el тоо-ширхэг.
	Гаралт шинэ-мөр.
}) plaque, шинэ-мөр.


