
Тэмдэгт-мөр ирэхэд: ['html'] гүйцэтгэ: { <- (
		өөрөө
		солих: ['&'] үүгээр: ['&amp;'],
		солих: ['<'] үүгээр: ['&lt;'],
		солих: ['>'] үүгээр: ['&gt;'],
		солих: ['"'] үүгээр: ['&quot;']
	).
}.

>> HtmlBrush := Объект шинэ.

HtmlBrush ирэхэд: ['хариулах:'] гүйцэтгэ: { :tag
	Гаралт бичих: (['<tag>↵'] tag: tag ).
}.

HtmlBrush ирэхэд: ['хариулах:ба:'] гүйцэтгэ: { :tag :content
	tag := ( tag эхлэл: 0 урт: (tag урт - 1) ).
	Гаралт бичих: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush ирэхэд: ['content:'] гүйцэтгэ: { :text
	Гаралт бичих: text html, шинэ-мөр.
}.

HtmlBrush ирэхэд: ['attr:value:'] гүйцэтгэ: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush шинэ.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
