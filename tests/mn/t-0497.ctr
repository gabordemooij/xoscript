Server init.

# write a test file
>> f := Файл шинэ: ['/tmp/test.gif'].
f бичих: ['GIF87a01234567810'].

# serve the file
Server дамжуулах: ['test.gif'] угтвар: ['/tmp/'].

Гаралт шинэ-мөр.

Гаралт бичих: ['Outside container (security):'], шинэ-мөр.
{ Server дамжуулах: ['../passwd'] угтвар: ['/tmp/']. }
барих: { :e Гаралт бичих: e, шинэ-мөр. },
ажиллуулах.

Гаралт бичих: ['Invalid prefix:'], шинэ-мөр.
{ Server дамжуулах: ['test.gif'] угтвар: ['z:\\']. }
барих: { :e Гаралт бичих: e, шинэ-мөр. },
ажиллуулах.

Гаралт бичих: ['Non-existant file:'], шинэ-мөр.
{ Server дамжуулах: ['xxx.xxx'] угтвар: ['/tmp/']. }
барих: { :e Гаралт бичих: e, шинэ-мөр. },
ажиллуулах.
