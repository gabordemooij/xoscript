Гаралт бичих: ['Test object'], шинэ-мөр.
>> a := Объект шинэ. 

a ирэхэд: ['item:'] гүйцэтгэ: { :num
	өөрийн num := num. 
}.

a ирэхэд: ['item'] гүйцэтгэ: { <- өөрийн num.
}.

a item: 123.

Гаралт бичих: a item, шинэ-мөр.

>> old-num-address := a item эх-загвар санах-ойн-хаяг.
a save-as: ['/tmp/a.bin'].
Гаралт бичих: ['========== RELOADING SNAP:'], шинэ-мөр.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item эх-загвар санах-ойн-хаяг = old-num-address) үнэн-бол: {
	Гаралт бичих: ['Object link re-attached.'], шинэ-мөр.
}.

Гаралт бичих: b item, шинэ-мөр.
