Гаралт бичих: ['Test object'], шинэ-мөр.
>> a := Объект шинэ. 
a ирэхэд: ['item:'] гүйцэтгэ: { :lst
	өөрийн lst := lst. 
}.
a ирэхэд: ['item'] гүйцэтгэ: { <- өөрийн lst.
}.
a item: (
	Жагсаалт шинэ ; 1 ; (
		Жагсаалт шинэ ; ['a'] ; (
			Жагсаалт шинэ ; ( Агшин шинэ: 1 )
		) ; ( Int64 тэмдэгт-мөрөөс: ['321'] )
	)
).
Гаралт бичих: a item, шинэ-мөр.
>> old-lst-address := a item эх-загвар санах-ойн-хаяг.
a save-as: ['/tmp/a.bin'].
Гаралт бичих: ['========== RELOADING SNAP:'], шинэ-мөр.
>> b := Объект load-from: ['/tmp/a.bin'].
(b item эх-загвар санах-ойн-хаяг = old-lst-address) үнэн-бол: {
	Гаралт бичих: ['Object link re-attached.'], шинэ-мөр.
}.
Гаралт бичих: ( b item ), шинэ-мөр.
