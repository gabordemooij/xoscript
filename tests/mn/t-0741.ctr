Гаралт бичих: ['Test object'], шинэ-мөр.
>> a := Объект шинэ. 

a ирэхэд: ['item:'] гүйцэтгэ: { :octhelper
	өөрийн octhelper := octhelper. 
}.

a ирэхэд: ['item'] гүйцэтгэ: { <- өөрийн octhelper.
}.

a item: Oct шинэ.

>> old-octhelper-address := a item эх-загвар санах-ойн-хаяг.
a save-as: ['/tmp/a.bin'].
Гаралт бичих: ['========== RELOADING SNAP:'], шинэ-мөр.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item эх-загвар санах-ойн-хаяг = old-octhelper-address) үнэн-бол: {
	Гаралт бичих: ['Object link re-attached.'], шинэ-мөр.
}.
