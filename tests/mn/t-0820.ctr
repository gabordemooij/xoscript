# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Загвар шинэ: pattern.
	p таарал: subject гүйцэтгэ: { :m :g
		Гаралт бичих: g тоо-ширхэг, бичих: [' '], бичих: (g нэгтгэх: ['|']), шинэ-мөр. <- m.
	}.
}.
show хэрэглэх: ['(a)|(b)'] ба: ['b'].
show хэрэглэх: ['(a)|(b)'] ба: ['a'].
show хэрэглэх: ['(x)?y'] ба: ['y'].
show хэрэглэх: ['(x)?(y)(z)?'] ба: ['xy'].
