Тоо ирэхэд: ['roman'] гүйцэтгэ: {
	>> тоо := өөрөө хуулах.
	>> roman := [''].
	{
		{
			(тоо ≥ 1000) үнэн-бол: {
				roman төгсгөлд-нэмэх: ['Ⅿ'].
				тоо хасах: 1000.
			}, таслах.
		
			(тоо ≥ 500) үнэн-бол: {
				roman төгсгөлд-нэмэх: ['Ⅾ'].
				тоо хасах: 500.
			}, таслах.
		
			(тоо ≥ 100) үнэн-бол: {
				roman төгсгөлд-нэмэх: ['Ⅽ'].
				тоо хасах: 100.
			}, таслах.
		
			(тоо ≥ 50) үнэн-бол: {
				roman төгсгөлд-нэмэх: ['Ⅼ'].
				тоо хасах: 50.
			}, таслах.
		
			(тоо ≥ 50) үнэн-бол: {
				roman төгсгөлд-нэмэх: ['Ⅼ'].
				тоо хасах: 50.
			}, таслах.
		
			(тоо ≥ 10) үнэн-бол: {
				roman төгсгөлд-нэмэх: ['Ⅹ'].
				тоо хасах: 10.
			}, таслах.
			
			(тоо ≥ 9) үнэн-бол: {
				roman төгсгөлд-нэмэх: ['Ⅸ'].
				тоо хасах: 9.
			}, таслах.
			
			(тоо ≥ 5) үнэн-бол: {
				roman төгсгөлд-нэмэх: ['Ⅴ'].
				тоо хасах: 5.
			}, таслах.
			
			(тоо ≥ 4) үнэн-бол: {
				roman төгсгөлд-нэмэх: ['Ⅳ'].
				тоо хасах: 4.
			}, таслах.
			
			(тоо ≥ 1) үнэн-бол: {
				roman төгсгөлд-нэмэх: ['Ⅰ'].
				тоо хасах: 1.
			}, таслах.
		} процедур.
	} байх-зуур: { <- тоо > 0. }. <- roman.
}.

Гаралт бичих: 1 roman, шинэ-мөр.
Гаралт бичих: 2 roman, шинэ-мөр.
Гаралт бичих: 4 roman, шинэ-мөр.
Гаралт бичих: 8 roman, шинэ-мөр.
Гаралт бичих: 16 roman, шинэ-мөр.
Гаралт бичих: 32 roman, шинэ-мөр.
Гаралт бичих: 64 roman, шинэ-мөр.
Гаралт бичих: 128 roman, шинэ-мөр.
Гаралт бичих: 256 roman, шинэ-мөр.
Гаралт бичих: 1024 roman, шинэ-мөр.
