Гаралт бичих: ['Test object'], шинэ-мөр.
>> a := Объект шинэ. 

a ирэхэд: ['item:'] гүйцэтгэ: { :hexhelper
	өөрийн hexhelper := hexhelper. 
}.

a ирэхэд: ['item'] гүйцэтгэ: { <- өөрийн hexhelper.
}.

a item: Hx шинэ.

>> old-hexhelper-address := a item эх-загвар санах-ойн-хаяг.
a save-as: ['/tmp/a.bin'].
Гаралт бичих: ['========== RELOADING SNAP:'], шинэ-мөр.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item эх-загвар санах-ойн-хаяг = old-hexhelper-address) үнэн-бол: {
	Гаралт бичих: ['Object link re-attached.'], шинэ-мөр.
}.
