# test Program version

# this feature is disabled by default
Гаралт бичих: (
	Програм боломж: 
	['RECURSIVE_STRINTPOL']
), шинэ-мөр.


# but if we set the time back
>> today := Агшин 
цагийн-бүс: ['CEST'],
эх: ['2026-02-15 10:00:00'].
Програм хувилбар: today.

# it will be enabled like it used to be (from now on)
Гаралт бичих: (
	Програм боломж: 
	['RECURSIVE_STRINTPOL']
), шинэ-мөр.