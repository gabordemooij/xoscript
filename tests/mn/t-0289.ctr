#Linux
>> OS := Програм систем: (Тушаал uname -s), тайрах.

>> Slurp := Объект шинэ.
Slurp ирэхэд: ['шинэ'] гүйцэтгэ: {
	өөрийн str := [''].
}.
Slurp ирэхэд: ['хариулах:'] гүйцэтгэ: { :blah
		(өөрийн str ≠ ['']) үнэн-бол: {
			өөрийн str төгсгөлд-нэмэх: [' '].
		}.
		өөрийн str төгсгөлд-нэмэх: blah.
}.
Slurp ирэхэд: ['хариулах:ба:'] гүйцэтгэ: { :blah :blahah
		(өөрийн str ≠ ['']) үнэн-бол: {
			өөрийн str төгсгөлд-нэмэх: [' '].
		}.
		(blah урт > 1) үнэн-бол: {
			өөрийн str төгсгөлд-нэмэх: (blah эхлэл: 0 урт: (blah урт - 1)).
		}, үгүй-бол: {
			өөрийн str төгсгөлд-нэмэх: blah.
		}.
		өөрийн str төгсгөлд-нэмэх: [' '].
		өөрийн str төгсгөлд-нэмэх: blahah.
}.
Slurp ирэхэд: ['obtain'] гүйцэтгэ: {
	>> buffer := өөрийн str.
	өөрийн str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text төгсгөлд-нэмэх: ['hello'].
} × 1000.


Гаралт бичих: (
	Програм систем: (
		Slurp шинэ
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

