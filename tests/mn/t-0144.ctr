



>> CoffeeGrounds := Объект шинэ.
CoffeeGrounds ирэхэд: ['extract'] гүйцэтгэ: { <- ['coffee']. }.

>> CoffeeMachine := Объект шинэ.
CoffeeMachine ирэхэд: ['init'] гүйцэтгэ: {
	өөрийн coffeegrounds := CoffeeGrounds шинэ.
}.
CoffeeMachine ирэхэд: ['шинэ'] гүйцэтгэ: { <- CoffeeMachine `new init.
}.

CoffeeMachine ирэхэд: ['makeTea'] гүйцэтгэ: { <- (өөрийн tealeaves extract). }.
CoffeeMachine ирэхэд: ['makeCoffee'] гүйцэтгэ: { <- (өөрийн coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine шинэ.

Гаралт бичих:
	coffeeDream 
	makeCoffee.

Гаралт бичих:
	coffeeDream 
	makeTea.
