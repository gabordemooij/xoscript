
>> Size := Объект шинэ.
Size ирэхэд: ['is:'] гүйцэтгэ: { :тоо
	тоо ирэхэд: ['+'] гүйцэтгэ: { :тоо
		>> unit := тоо хэмжих-нэгж.
		>> factor := 1.
		
		unit
		тохиолдол: ['inch'] гүйцэтгэ: { factor := 0.0833. }. <- өөрөө + (тоо * factor).
	}. <- тоо.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Гаралт бичих: plank + edge, шинэ-мөр.
