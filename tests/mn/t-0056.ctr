>> z := Объект шинэ.
z ирэхэд: ['value:'] гүйцэтгэ: { :v
	өөрийн value := v. <- өөрөө.
}.
z ирэхэд: ['value'] гүйцэтгэ: { <- өөрийн value. }.
(z setValue: 1) value: 2.
Гаралт бичих: z value.
>> x := z.
Гаралт бичих: x value.
z := Хоосон.
Гаралт бичих: z value.
Гаралт бичих: x value.
Гаралт бичих: ['hello'].
Гаралт бичих: 3 + 2.
Гаралт бичих: (3 > 2).
