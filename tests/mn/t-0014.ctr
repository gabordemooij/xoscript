>> Greeter := Объект шинэ.
Greeter ирэхэд: ['make'] гүйцэтгэ: {
	>> gr := Объект шинэ.
	gr ирэхэд: ['setName:'] гүйцэтгэ: { :aname
		өөрийн нэр := aname.
	}.
	gr ирэхэд: ['greet'] гүйцэтгэ: {
		Гаралт бичих: өөрийн нэр.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a шинэ.
c setName: ['THREE'].
c greet.
>> d := a шинэ.
d setName: ['FOUR'].
d greet.
c greet.
