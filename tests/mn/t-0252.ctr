#Linux
>> clock := Агшин шинэ.
clock цагийн-бүс: ['UTC-1'].
clock жил: 1981, сар: 1, өдөр: 5,
      цаг-нэгж: 13, минут: 15, секунд: 13.

Гаралт бичих: clock, шинэ-мөр.
clock цагийн-бүс: ['UTC+0'].

Гаралт бичих: (
	(clock жил энгийн) + ['-'] + (clock сар) + ['-'] + (clock өдөр) + [' '] +
	(clock цаг-нэгж) + [':'] + (clock минут) + [':'] + (clock секунд) + [' '] +
	['W'] + (clock долоо-хоног) + (clock цагийн-бүс)
), шинэ-мөр.


clock цагийн-бүс: ['UTC-1'].
Гаралт бичих: (
	(clock жил энгийн) + ['-'] + (clock сар) + ['-'] + (clock өдөр) + [' '] +
	(clock цаг-нэгж) + [':'] + (clock минут) + [':'] + (clock секунд) + [' '] +
	['W'] + (clock долоо-хоног) + (clock цагийн-бүс)
), шинэ-мөр.
