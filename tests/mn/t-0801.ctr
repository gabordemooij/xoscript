Server init.

>> db := Maria-DB шинэ хост: ['localhost'],
	хэрэглэгчийн-нэр: ['xo'],
	нууц-үг: ['pass123'],
	өгөгдлийн-сангийн-нэр: ['xobase'],
	холбогдох.

>> del := db асуулга: ['DELETE FROM book WHERE id > 0'].
{  del гүйцэтгэх. db батлах. } барих: { :e db буцаах.  }, ажиллуулах.

>> тоо-ширхэг := db асуулга: ['SELECT COUNT(*) AS num FROM book'].
тоо-ширхэг татах: { :row Гаралт бичих: row num, шинэ-мөр. }.
