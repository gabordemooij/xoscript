


>> wine := Объект шинэ.


wine ирэхэд: ['toString'] гүйцэтгэ: { <- ['merlot'].
}.

wine ирэхэд: ['naarTekst'] гүйцэтгэ: { <- ['merlot'].
}.


wine ирэхэд: ['='] гүйцэтгэ: { :other wine <- ( өөрөө toString = other wine ).
}.

wine ирэхэд: ['=='] гүйцэтгэ: { :other wine <- ( өөрөө toString = other wine ).
}.



wine
	тохиолдол: ['cabernet'] гүйцэтгэ: { Гаралт бичих: ['it's a Cabernet!']. },
	тохиолдол: ['syrah']    гүйцэтгэ: { Гаралт бичих: ['it's a Syrah!'].    },
	тохиолдол: ['merlot']   гүйцэтгэ: { Гаралт бичих: ['it's a Merlot!'].   },
	тохиолдол: ['malbec']   гүйцэтгэ: { Гаралт бичих: ['it's a Malbec!'].   }.

Гаралт шинэ-мөр.
