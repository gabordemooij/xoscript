
>> Rectangle := Объект шинэ.

Rectangle ирэхэд: ['area'] гүйцэтгэ: { <- өөрийн урт * өөрийн width.
}.

Rectangle ирэхэд: ['length:'] гүйцэтгэ: { :урт
	өөрийн урт := урт.
}.

Rectangle ирэхэд: ['width:'] гүйцэтгэ: { :width
	өөрийн width := width.
}.

Rectangle ирэхэд: ['шинэ'] гүйцэтгэ: {
	# this will not result into an infinite loop
	>> rectangle := өөрөө шинэ.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle шинэ.
Гаралт бичих: a area, шинэ-мөр. #0

>> b := Rectangle шинэ length: 2, width: 3.
Гаралт бичих: b area, шинэ-мөр. #6

