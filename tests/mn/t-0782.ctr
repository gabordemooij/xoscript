Гаралт бичих: ['Test object'], шинэ-мөр.
>> cmd := Тушаал шинэ.
Гаралт бичих: cmd ls /tmp, шинэ-мөр.
>> old-cmd-address := cmd эх-загвар санах-ойн-хаяг.
cmd save-as: ['/tmp/a.bin'].
Гаралт бичих: ['========== RELOADING SNAP:'], шинэ-мөр.
>> b := Объект load-from: ['/tmp/a.bin'].
(b эх-загвар санах-ойн-хаяг = old-cmd-address) үнэн-бол: {
	Гаралт бичих: ['Object link re-attached.'], шинэ-мөр.
}.
Гаралт бичих: b ls, шинэ-мөр.


