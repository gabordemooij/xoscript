# test qualifiers

>> $ := Объект шинэ.

$ ирэхэд: ['хариулах:'] гүйцэтгэ: { :x
	
	>> operation := x тэмдэгт: 0.
	>> valuta := x тэмдэгт: 1.
	>> money := x алгасах: 2.
	
	>> amount := 0.

	( operation = ['+'] ) үнэн-бол: {
		( valuta = ['£'] ) үнэн-бол: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Гаралт бичих: x, шинэ-мөр.


>> Fruit := Объект шинэ.

Fruit ирэхэд: ['шинэ'] гүйцэтгэ: {
	>> f := өөрөө шинэ.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit ирэхэд: ['apples:'] гүйцэтгэ: { :a өөрийн apples := a. }.
Fruit ирэхэд: ['oranges:'] гүйцэтгэ: { :p өөрийн oranges := p. }.
Fruit ирэхэд: ['apples'] гүйцэтгэ: { <- өөрийн apples. }.
Fruit ирэхэд: ['oranges'] гүйцэтгэ: { <- өөрийн oranges. }.

Fruit ирэхэд: ['+'] гүйцэтгэ: { :f
	
	>> n := Fruit шинэ.
	f нэмэх: 1.
	
	n apples: (f apples + өөрийн apples).
	n oranges:  (f oranges  + өөрийн oranges). <- n.
}.

Fruit ирэхэд: ['тэмдэгт-мөр'] гүйцэтгэ: { <- ( өөрийн apples тэмдэгт-мөр + [' apples and '] + өөрийн oranges + [' oranges'] ).
}.

Тоо ирэхэд: ['apples'] гүйцэтгэ: { <- ((Fruit шинэ) apples: өөрөө).
}.

Тоо ирэхэд: ['apple'] гүйцэтгэ: { <- ((Fruit шинэ) apples: өөрөө).
}.

Тоо ирэхэд: ['oranges'] гүйцэтгэ: { <- ((Fruit шинэ) oranges: өөрөө).
}.




Гаралт бичих: (1 apple + 3 oranges + 4 apples), шинэ-мөр.


Тэмдэгт-мөр ирэхэд: ['twice'] гүйцэтгэ: { <- ((өөрөө тэмдэгт-мөр) + (өөрөө тэмдэгт-мөр)).
}.



Гаралт бичих: ['❤❤❤'] twice.



