Гаралт бичих: ['Test object'], шинэ-мөр.
>> a := Объект шинэ. 

a ирэхэд: ['item:'] гүйцэтгэ: { :out
	өөрийн out := out. 
}.

a ирэхэд: ['item'] гүйцэтгэ: { <- өөрийн out.
}.

a ирэхэд: ['greet'] гүйцэтгэ: {
	Гаралт бичих: ['hi from original out!'], шинэ-мөр.
}.

a item: Гаралт.

Гаралт бичих: a item, шинэ-мөр.

>> old-out-address := a item эх-загвар санах-ойн-хаяг.
a save-as: ['/tmp/a.bin'].
Гаралт бичих: ['========== RELOADING SNAP:'], шинэ-мөр.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item эх-загвар санах-ойн-хаяг = old-out-address) үнэн-бол: {
	Гаралт бичих: ['Object link re-attached.'], шинэ-мөр.
}.

b item бичих: ['hello from loaded out!'], шинэ-мөр.
b greet.
