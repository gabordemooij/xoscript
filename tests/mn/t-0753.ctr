Гаралт бичих: ['Test object'], шинэ-мөр.
>> a := Объект шинэ. 

a ирэхэд: ['item:'] гүйцэтгэ: { :fmt
	өөрийн fmt := fmt. 
}.

a ирэхэд: ['item'] гүйцэтгэ: { <- өөрийн fmt.
}.

a item: ( Хэлбэр шинэ: ['|%s|'] ).

Гаралт бичих: a item, шинэ-мөр.

>> old-fmt-address := a item эх-загвар санах-ойн-хаяг.
a save-as: ['/tmp/a.bin'].
Гаралт бичих: ['========== RELOADING SNAP:'], шинэ-мөр.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item эх-загвар санах-ойн-хаяг = old-fmt-address) үнэн-бол: {
	Гаралт бичих: ['Object link re-attached.'], шинэ-мөр.
}.

Гаралт бичих: ( b item хэрэглэх: ['hello'] ), шинэ-мөр.
