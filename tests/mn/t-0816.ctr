# a format must fit the type of the value, the type can come from a client
>> оролдох := { :format :value
	{ Гаралт бичих: ( (Хэлбэр шинэ: format) хэрэглэх: value ), шинэ-мөр. } барих: { :e Гаралт бичих: e, шинэ-мөр. }, ажиллуулах.
}.
>> try-int := { :format :value
	{ Гаралт бичих: ( (Хэлбэр шинэ: format) хэрэглэх-бүхэл: value ), шинэ-мөр. } барих: { :e Гаралт бичих: e, шинэ-мөр. }, ажиллуулах.
}.

# fits
оролдох хэрэглэх: ['|%s|'] ба: ['text'].
оролдох хэрэглэх: ['%06.2f'] ба: 5.5.
оролдох хэрэглэх: ['100%% %s'] ба: ['sure'].
try-int хэрэглэх: ['%03d'] ба: 7.
try-int хэрэглэх: ['%x'] ба: 255.
оролдох хэрэглэх: ['%d'] ба: (Int64 шинэ тэмдэгт-мөрөөс: ['12']).
оролдох хэрэглэх: ['%lld'] ба: (Int64 шинэ тэмдэгт-мөрөөс: ['12']).
оролдох хэрэглэх: ['%.1lf'] ба: 5.5.
try-int хэрэглэх: ['%hd'] ба: 7.

# does not fit
оролдох хэрэглэх: ['%s'] ба: 12345.
оролдох хэрэглэх: ['%d'] ба: 12345.
оролдох хэрэглэх: ['%f'] ба: ['text'].
try-int хэрэглэх: ['%d'] ба: ['text'].
try-int хэрэглэх: ['%s'] ба: 5.
оролдох хэрэглэх: ['%s %s'] ба: ['text'].
оролдох хэрэглэх: ['%n'] ба: ['text'].
оролдох хэрэглэх: ['%*s'] ба: ['text'].
оролдох хэрэглэх: ['%'] ба: ['text'].

# length modifier does not fit
оролдох хэрэглэх: ['%ls'] ба: ['text'].
оролдох хэрэглэх: ['%Lf'] ба: 5.5.
try-int хэрэглэх: ['%ld'] ба: 7.
try-int хэрэглэх: ['%lld'] ба: 7.
оролдох хэрэглэх: ['%Ld'] ба: (Int64 шинэ тэмдэгт-мөрөөс: ['12']).

# a width that does not fit printf must give an error, not a crash
оролдох хэрэглэх: ['%99999999999s'] ба: ['text'].
