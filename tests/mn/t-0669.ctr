# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Сейф 
	нууц-үгийн-хэш: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Сейф 
	нууц-үгийн-хэш: hash шалгах: a1.
	# fail 
>> b := Сейф
	нууц-үгийн-хэш: hash шалгах: a2.
	# ok!

Гаралт бичих: a, шинэ-мөр.
Гаралт бичих: b, шинэ-мөр.

