

Жагсаалт ирэхэд: ['fixture:'] гүйцэтгэ: { :f
	өөрийн fixture := f.
}.

Жагсаалт ирэхэд: ['тоо-ширхэг'] гүйцэтгэ: { <- өөрийн fixture.
}.

Жагсаалт ирэхэд: ['aantal'] гүйцэтгэ: { <- өөрийн fixture.
}.


>> x := Хоосон.
{

	x := ['hello'] 
	солих:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] тэмдэгт: 2)
			)
		)
	үүгээр: (
		(['...hal'] + ['lo']) 
			том-үсэг 
			lowecase 
			том-үсэг 
			алгасах: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Жагсаалт ← 0 ; 1 ; 4; 9 ; (Жагсаалт ← 0 ; 3; 1) ; 4
							) сүүлийн-өмнөх
						) ? 1
					) + 
					((Жагсаалт ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					тоо-ширхэг
				)
			)
	).

} × 10.
Гаралт бичих: x, шинэ-мөр.

