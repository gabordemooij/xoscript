

Тэмдэгт-мөр ирэхэд: ['html'] гүйцэтгэ: { <- (
		өөрөө
		солих: ['&'] үүгээр: ['&amp;'],
		солих: ['<'] үүгээр: ['&lt;'],
		солих: ['>'] үүгээр: ['&gt;'],
		солих: ['"'] үүгээр: ['&quot;']
	).
}.


Гаралт бичих: ([' left trimmed '] тайрах) + [' '] + ( ['and right trimmed'] тайрах) + ['!'], шинэ-мөр.
Гаралт бичих: ['<html>"html & entities"</html>'] html.
