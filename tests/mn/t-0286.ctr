['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Гаралт бичих: (x + y), шинэ-мөр.

>> x := 10040.07.
>> y := 10305.60.

Гаралт бичих: (x + y), шинэ-мөр.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Гаралт бичих: (x + y + z), шинэ-мөр.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Гаралт бичих: (x + y + z), шинэ-мөр.

>> q := 0.1.2.

Гаралт бичих: (q), шинэ-мөр.

>> q := 012.

Гаралт бичих: (q), шинэ-мөр.
