Server init.

>> DB := Maria-DB шинэ хост: ['localhost'],
	хэрэглэгчийн-нэр: ['xo'],
	нууц-үг: ['pass123'],
	өгөгдлийн-сангийн-нэр: ['xobase'],
	холбогдох.

{
	DB асуулга:
	['DROP TABLE movies'],
	гүйцэтгэх.
} барих: { Хоосон. }, ажиллуулах.

DB асуулга:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
гүйцэтгэх.

DB асуулга: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
параметрүүд: ( Жагсаалт шинэ ; ['Halloween'] ),
гүйцэтгэх.

DB асуулга: ['SELECT * FROM movies'],
татах: { :movie
	Гаралт бичих: movie title, шинэ-мөр.
}.

