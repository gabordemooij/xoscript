
Гаралт бичих: ['Break for-loop, 0-4.'], шинэ-мөр.
{ :i
	Гаралт бичих: ['iteration #'] + i, шинэ-мөр.
	(i = 4) таслах.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Гаралт бичих: ['Break while-true loop, 0-4.'], шинэ-мөр.
{
	Гаралт бичих: ['iteration #'] + x, шинэ-мөр.
	x нэмэх: 1.
	((x < 5) эсрэг) таслах.
} байх-зуур: xIsLessThan10.

Гаралт бичих: ['Break while-false loop, 5,4.'], шинэ-мөр.
{
	Гаралт бичих: ['iteration #'] + x, шинэ-мөр.
	x хасах: 1.
	(x = 3) таслах.
} байх-зуур: { <- (x > 0). }.

Гаралт бичих: ['Break times loop, 1-4.'], шинэ-мөр.
{ :i
	Гаралт бичих: ['iteration #'] + i, шинэ-мөр.
	(i = 4) таслах.
} × 5.

Гаралт бичих: ['Break block, dont print line.'], шинэ-мөр.
{ Үнэн таслах. Гаралт бичих: ['dont write this!'], шинэ-мөр. } ажиллуулах.

Гаралт бичих: ['Break block, dont fire catch...'], шинэ-мөр.
{ Үнэн таслах. Гаралт бичих: ['dont write this!'], шинэ-мөр. } барих: { Гаралт бичих: ['Dont catch this!']. }, ажиллуулах.

Гаралт бичих: ['Test Array each-loop: 0,1'], шинэ-мөр.
(Жагсаалт ← 1 ; 2 ; 3) хувиргах: { :i
	Гаралт бичих: ['iteration #'] + i, шинэ-мөр.
	(i = 1) таслах.
}.

Гаралт бичих: ['Test Map each-loop: c only'], шинэ-мөр.
>> m := Толь шинэ.
m хийх: ['first'] түлхүүр: ['a'], хийх: ['second'] түлхүүр: ['b'], хийх: ['third'] түлхүүр: ['c'].
m бүр: { :k :v
	Гаралт бичих: ['iteration'] + v + k, шинэ-мөр.
	Үнэн таслах.
}.

