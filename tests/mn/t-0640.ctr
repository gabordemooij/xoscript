
Server init.
Гаралт бичих: ['Database test'], шинэ-мөр.

>> db := Maria-DB шинэ хост: ['localhost'],
	хэрэглэгчийн-нэр: ['xo'], 
	нууц-үг: ['pass123'],
	өгөгдлийн-сангийн-нэр: ['xobase'],
	холбогдох.

>> хайлтын-параметрүүд :=
db асуулга: ['SELECT UNHEX('CAFE') AS blobby'],
татах: { :row
	Гаралт бичих: ( row blobby эхлэл: 0 урт: 2 ), шинэ-мөр.
	row blobby чөлөөлөх.
}.
