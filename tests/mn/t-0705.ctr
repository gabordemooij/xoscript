

>> obj := Объект шинэ.

obj ирэхэд: ['greet'] гүйцэтгэ: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj ирэхэд: ['task'] гүйцэтгэ: {
	өөрийн property := 123.
	{
		# try binds self/own to object instead of block
		Гаралт бичих: өөрөө greet.
		Гаралт бичих: өөрийн property.
		1 / 0.
	} барих: {
		Гаралт бичих: өөрөө greet.
		Гаралт бичих: өөрийн property.
		Гаралт бичих: ['ok'].
	}, оролдох.
}.

obj task.