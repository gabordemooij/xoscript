# compliance test

# use international numbers

Гаралт бичих: ['1000 -> '].
Гаралт бичих: 1000, шинэ-мөр. #1000

Гаралт бичих: ['1.5 -> '].
Гаралт бичих: 1.5, шинэ-мөр.  #1.5

Гаралт бичих: ['1001.5 -> '].
Гаралт бичих: 1.5 + 1000, шинэ-мөр. #1001.5

# use 0-indexed arrays
>> x := Жагсаалт шинэ ; 1 ; 2 ; 3.
>> y := Жагсаалт шинэ ; ['a'] ; ['b'] ; ['c'].

Гаралт бичих: ['1 -> '].
Гаралт бичих: x ? 0, шинэ-мөр. #1

Гаралт бичих: ['1 -> '].
Гаралт бичих: (x байрлалд: 0), шинэ-мөр. #1

Гаралт бичих: ['1 -> '].
Гаралт бичих: x эхний, шинэ-мөр. #1

Гаралт бичих: ['3 -> '].
Гаралт бичих: x сүүлийн, шинэ-мөр. #3

Гаралт бичих: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Гаралт бичих: (x дагуу: y), шинэ-мөр.

Гаралт бичих: ['1 -> '].
Гаралт бичих: (x эхлэл: 0 урт: 1) эхний, шинэ-мөр. #1

Гаралт бичих: ['0 -> '].
Гаралт бичих: (x хайх: 1), шинэ-мөр. #0

x хийх: 9 түлхүүр: 0.

Гаралт бичих: ['9 -> '].
Гаралт бичих: (x байрлалд: 0), шинэ-мөр. #9

x эхэнд-нэмэх: 8.
Гаралт бичих: ['8 -> '].
Гаралт бичих: (x байрлалд: 0), шинэ-мөр. #9


x төгсгөлд-нэмэх: 10.
Гаралт бичих: ['10 -> '].
Гаралт бичих: (x байрлалд: 4), шинэ-мөр. #10








