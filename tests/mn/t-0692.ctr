Server init.

Гаралт бичих: (
	Загвар шинэ: ['^\\w+$'],
	таарал: ['test@example.com'] 
), шинэ-мөр. # 0 match, fails on @ and .

Гаралт бичих: (
	Загвар шинэ: ['^[^@]+@[^\.]+\.\\w+$'],
	таарал: ['test@example.com'] 
), шинэ-мөр. # 1 match

Гаралт бичих: (
	Загвар шинэ: ['[^@]+@[^\.]+\.\\w+'],
	таарал: ['test@example.com'] 
), шинэ-мөр. # 1 match

Гаралт бичих: (
	Загвар шинэ: ['([^@]+)@([^\.]+)\.\\w+'],
	таарал: ['test@example.com'] 
), шинэ-мөр. # 1 match, groups dont matter

Гаралт бичих: (
	Загвар шинэ: ['[a-z]'],
	таарал: ['test@example.com'] 
), шинэ-мөр. # 14 matches

Гаралт бичих: (
	Загвар шинэ: ['.*'],
	таарал: ['test@example.com'] 
), шинэ-мөр. # 1 match (all)

Гаралт бичих: (
	Загвар шинэ: ['(.*)'],
	таарал: ['test@example.com'] 
), шинэ-мөр. # 1 match (all)

Гаралт бичих: (
	Загвар шинэ: ['\\s*[^@]+@[^\.]+\.\\w+'],
	таарал: ['test@example.com'] 
), шинэ-мөр. # 1 match, prefix space optional, gets ignored