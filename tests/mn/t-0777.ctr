#OBSD
>> dirname := [''].
{ dirname төгсгөлд-нэмэх: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Програм систем: command.
Програм chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename төгсгөлд-нэмэх: ['YYYYYYYY']. } * 20.
Файл шинэ: filename, бичих: ['sometext'].
{ Файл жагсаалт: ['/tmp/'] + dirname. } * 1000.
Гаралт бичих: ['no crash'], шинэ-мөр.

