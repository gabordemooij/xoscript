Server init.

>> DB := Maria-DB шинэ хост: ['localhost'],
	хэрэглэгчийн-нэр: ['xo'],
	нууц-үг: ['pass123'],
	өгөгдлийн-сангийн-нэр: ['xobase'],
	холбогдох.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB асуулга: SQL.

# now you don't have to set DB
query2 татах: { :row
	Гаралт бичих: row world, шинэ-мөр.
}.
