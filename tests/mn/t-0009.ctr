>> Greeter := Объект шинэ.
Greeter ирэхэд: ['make'] гүйцэтгэ: {
	>> greeter := Объект шинэ.
	greeter ирэхэд: ['name:'] гүйцэтгэ: { :нэр
		Гаралт бичих: ['setting a name'].
		өөрийн myName := нэр.
	}.
	greeter ирэхэд: ['performGreeting'] гүйцэтгэ: {
		Гаралт бичих: ['Hello'].
		Гаралт бичих: өөрийн myName.
	}.
	greeter ирэхэд: ['greet'] гүйцэтгэ: {
		өөрөө performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
