Server init.
Гаралт бичих: ['Database datetime test'], шинэ-мөр.

>> db := Maria-DB шинэ хост: ['localhost'],
	хэрэглэгчийн-нэр: ['xo'], 
	нууц-үг: ['pass123'],
	өгөгдлийн-сангийн-нэр: ['xobase'],
	холбогдох.

>> хайлтын-параметрүүд :=
db асуулга: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
татах: { :row
	Гаралт бичих: row datetimetest, шинэ-мөр.
}.
