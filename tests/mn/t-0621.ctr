>> phrases := Жагсаалт шинэ
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases бүр: { :_ :phrase 
	>> e := Server base64-кодлох: phrase.
	>> d := Server base64-код-тайлах: e.
	Гаралт бичих: (
		message хуулах ~encoded: e, ~decoded: d
	), шинэ-мөр.
}.
