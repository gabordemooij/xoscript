Server init.
Гаралт бичих: ['Database time test'], шинэ-мөр.

>> db := Maria-DB шинэ хост: ['localhost'],
	хэрэглэгчийн-нэр: ['xo'], 
	нууц-үг: ['pass123'],
	өгөгдлийн-сангийн-нэр: ['xobase'],
	холбогдох.

>> хайлтын-параметрүүд :=
db асуулга: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
татах: { :row
	Гаралт бичих: row timetest, шинэ-мөр.
}.
