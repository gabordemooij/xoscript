Гаралт бичих: ['1,2,3,4,5,6,7,8,9,A,'], шинэ-мөр.
>> Scope := Объект шинэ.
Scope ирэхэд: ['initialize:'] гүйцэтгэ: { :x өөрийн property := x. }.
Scope ирэхэд: ['confirm'] гүйцэтгэ: { Гаралт бичих: [',']. }.
Scope ирэхэд: ['тест'] гүйцэтгэ: {
	Гаралт бичих: өөрийн property.
	өөрөө confirm.
	( 1 = 1 ) үнэн-бол: { Гаралт бичих: өөрийн property. өөрөө confirm. }.
	( 1 = 0 ) худал-бол: { Гаралт бичих: өөрийн property. өөрөө confirm. }.
	>> y := 2. { Гаралт бичих: өөрийн property. өөрөө confirm. } байх-зуур: { y хасах: 1. <- (y > 0). }.
	{ Гаралт бичих: өөрийн property. өөрөө confirm. } × 1.
	(Жагсаалт ← 1) бүр: {  Гаралт бичих: өөрийн property. өөрөө confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Толь шинэ one: ['item']) бүр: { Гаралт бичих: өөрийн property. өөрөө confirm. }.
	{ 1 ÷ 0. } барих: { Гаралт бичих: өөрийн property. өөрөө confirm. }, ажиллуулах.
	Гаралт шинэ-мөр.
}.
>> scope1 := Scope шинэ.
scope1 initialize: ['X'].
scope1 тест.
>> function := { 
	өөрийн property := ['Y'].
	Гаралт бичих: өөрийн property.
	өөрөө confirm.
	( 1 = 1 ) үнэн-бол: { Гаралт бичих: өөрийн property. өөрөө confirm. }.
	( 1 = 0 ) худал-бол: { Гаралт бичих: өөрийн property. өөрөө confirm. }.
	>> y := 2. { Гаралт бичих: өөрийн property. өөрөө confirm. } байх-зуур: { y хасах: 1. <- (y > 0). }.
	{ Гаралт бичих: өөрийн property. өөрөө confirm. } × 1.
	(Жагсаалт ← 1) бүр: {  Гаралт бичих: өөрийн property. өөрөө confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Толь шинэ one: ['item']) бүр: { Гаралт бичих: өөрийн property. өөрөө confirm. }.
	{ 1 ÷ 0. } барих: { Гаралт бичих: өөрийн property. өөрөө confirm. }, ажиллуулах.
	Гаралт шинэ-мөр.
}.
function ирэхэд: ['confirm'] гүйцэтгэ: { Гаралт бичих: [',']. }.
function хэрэглэх: 1 ба: 2.
