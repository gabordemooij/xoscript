
>> countries := Жагсаалт шинэ
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Жагсаалт шинэ
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods дагуу: countries, бүр: { :key :value
	counter нэмэх: 1.
}.

Гаралт бичих: (['we serve counter dishes'] counter: counter), шинэ-мөр.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] тэмдэгтүүд эрэмбэлэх: { :v
	counter нэмэх: 0.
}.

Гаралт бичих: (['we sort counter dishes'] counter: counter), шинэ-мөр.


>> counter := 0.
{
	{
		counter нэмэх: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Гаралт бичих: (['we calculate counter numbers.'] counter: counter), шинэ-мөр.

