>> invoice := Объект шинэ.
invoice ирэхэд: ['ажиллуулах'] гүйцэтгэ: {
        өөрийн тоо := 0.
}.

invoice ирэхэд: ['тоо'] гүйцэтгэ: {
        өөрийн тоо нэмэх: 1. <- өөрийн тоо хуулах.
}.

>> year-invoice := invoice шинэ.
year-invoice ирэхэд: ['start:'] гүйцэтгэ: { :жил
	өөрийн тоо := жил.
}.

year-invoice start: 202000.
Гаралт бичих: year-invoice тоо, шинэ-мөр.
Гаралт бичих: year-invoice тоо, шинэ-мөр.
