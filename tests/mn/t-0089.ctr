>> randomizer := { :a :b
	>> хамгийн-бага := ( a < b ) энэ: a эс-бөгөөс: b.
	>> хамгийн-их := ( a > b ) энэ: a эс-бөгөөс: b.
	>> x := Хоосон.
	{
		x := Тоо хооронд: a хүртэл: b.
		((x < хамгийн-бага) эсвэл: (x > хамгийн-их)) үнэн-бол: { 
			Гаралт бичих: (['Invalid value!']).
			Програм дуусгах.
		}.
	} 
	× 100. <- x.
}.
randomizer хэрэглэх: 0 ба: 0.
