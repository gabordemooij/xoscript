# test list operations


>> cakes := Жагсаалт ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes солих: 1 урт: 2 үүгээр: ( Жагсаалт ← ['cinnamon'] ; ['pineapple'] ).
Гаралт бичих: (buy нэгтгэх: [',']), шинэ-мөр.


>> buy := cakes солих: 1 урт: 12 үүгээр: ( Жагсаалт ← ['cinnamon'] ; ['pineapple'] ).
Гаралт бичих: (buy нэгтгэх: [',']), шинэ-мөр.


>> buy := cakes солих: 2 урт: 10 үүгээр: ( Жагсаалт шинэ ).
Гаралт бичих: (buy нэгтгэх: [',']), шинэ-мөр.


>> buy := cakes солих: 0 урт: 1 үүгээр: ( Жагсаалт шинэ ).
Гаралт бичих: (buy нэгтгэх: [',']), шинэ-мөр.


>> buy := cakes солих: ['0'] урт: ['1'] үүгээр: ['x'].
Гаралт бичих: (buy нэгтгэх: [',']), шинэ-мөр.
