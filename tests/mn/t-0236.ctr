>> Slurp := Объект шинэ.
Slurp ирэхэд: ['шинэ'] гүйцэтгэ: {
	өөрийн str := [''].
}.


Slurp ирэхэд: ['хариулах:'] гүйцэтгэ: { :blah
		(өөрийн str ≠ ['']) үнэн-бол: {
			өөрийн str төгсгөлд-нэмэх: [' '].
		}.
		өөрийн str төгсгөлд-нэмэх: blah.
}.
Slurp ирэхэд: ['хариулах:ба:'] гүйцэтгэ: { :blah :blahah
		(өөрийн str ≠ ['']) үнэн-бол: {
			өөрийн str төгсгөлд-нэмэх: [' '].
		}.
		(blah урт > 1) үнэн-бол: {
			өөрийн str төгсгөлд-нэмэх: (blah эхлэл: 0 урт: (blah урт - 1)).
		}, үгүй-бол: {
			өөрийн str төгсгөлд-нэмэх: blah.
		}.
		өөрийн str төгсгөлд-нэмэх: [' '].
		өөрийн str төгсгөлд-нэмэх: blahah.
}.
Slurp ирэхэд: ['obtain'] гүйцэтгэ: {
	>> buffer := өөрийн str.
	өөрийн str := ['']. <- buffer.
}.

>> хайлтын-параметрүүд := Slurp шинэ.
хайлтын-параметрүүд select: ['*'], from users where: ['id = 2'].
Гаралт бичих: (хайлтын-параметрүүд obtain), шинэ-мөр.
