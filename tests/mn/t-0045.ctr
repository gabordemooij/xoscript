Програм санах-ойн-удирдлага: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } барих: {
		oops нэмэх: 1.
	}, ажиллуулах.
} × 1000.

{
	Гаралт бичих: ['hi there!'].
	энэ-даалгавар алдаа: ['oops'].
	Гаралт бичих: ['hi there!'].
	{ Гаралт бичих: ['dont print this']. } ажиллуулах.
} барих: { :e 
	Гаралт бичих: ['got ya!']. 
	Гаралт бичих: e.
}, ажиллуулах.
