# test qualifiers

Програм цэвэрлэх.

>> Fruit := Объект шинэ.
Fruit ирэхэд: ['шинэ'] гүйцэтгэ: {
	>> f := өөрөө шинэ.
	f apples: 0. <- f.
}.
Fruit ирэхэд: ['apples:'] гүйцэтгэ: { :a өөрийн apples := a. }.
Fruit ирэхэд: ['apples'] гүйцэтгэ: { <- өөрийн apples. }.
Fruit ирэхэд: ['+'] гүйцэтгэ: { :f
	>> n := Fruit шинэ.
	n apples: (f apples + өөрийн apples). <- n.
}.
Тоо ирэхэд: ['apples'] гүйцэтгэ: { <- ((Fruit шинэ) apples: өөрөө).
}.

Fruit ирэхэд: ['тэмдэгт-мөр'] гүйцэтгэ: { <- өөрийн apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Гаралт бичих: q, шинэ-мөр.




q := 3 apples + 4 apples.
Гаралт бичих: q, шинэ-мөр.



q := 3 apples + 4 apples.
Гаралт бичих: q, шинэ-мөр.


