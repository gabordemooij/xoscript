


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програм санах-ойн-удирдлага: 0.
>> palette := Хоосон.
>> colors := Хоосон.

{
palette := Толь шинэ.
palette 
	хийх: ['#F00'] түлхүүр: ['red'],
	хийх: ['#0F0'] түлхүүр: ['green'],
	хийх: ['#00F'] түлхүүр: ['blue'].
Гаралт бичих: ['number of RGB codes in palette: '] + ( palette тоо-ширхэг ), шинэ-мөр.
Гаралт бичих: ['RGB code of green is: '] + ( palette ? ['green'] ), шинэ-мөр.
colors := [''].
( palette бүр: { :нэр :код
		colors := colors + ( нэр + [':'] + код ).
} ).
Гаралт бичих: ['All colors in palette: '] + colors, шинэ-мөр.
} ажиллуулах.
Програм цэвэрлэх.
usedMemory1 := (Програм санах-ой ? 0).

{
palette := Толь шинэ.
palette 
	хийх: ['#F00'] түлхүүр: ['red'],
	хийх: ['#0F0'] түлхүүр: ['green'],
	хийх: ['#00F'] түлхүүр: ['blue'].
Гаралт бичих: ['number of RGB codes in palette: '] + ( palette тоо-ширхэг ), шинэ-мөр.
Гаралт бичих: ['RGB code of green is: '] + ( palette ? ['green'] ), шинэ-мөр.
colors := [''].
( palette бүр: { :нэр :код
		colors := colors + ( нэр + [':'] + код ).
} ).
Гаралт бичих: ['All colors in palette: '] + colors, шинэ-мөр.
} ажиллуулах.
Програм цэвэрлэх.
