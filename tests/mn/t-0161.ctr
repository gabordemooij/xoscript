Програм санах-ойн-удирдлага: 0.
Жагсаалт ирэхэд: ['sum'] гүйцэтгэ: {
	>> total := 0.
	өөрөө бүр: { :index :element
		total нэмэх: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Файл шинэ: ['/tmp/test.txt'].
f бичих: ['Lorem Ipsum'].
f хаах.
  

f := Файл шинэ: ['/tmp/test.txt'].
>> text := f унших.
f хаах.



Програм цэвэрлэх.
usedMemory1 := (Програм санах-ой ? 1).



f := Файл шинэ: ['/tmp/test.txt'].
text := f унших.
f хаах.

Програм цэвэрлэх.
usedMemory2 := (Програм санах-ой ? 1).


f := Файл шинэ: ['/tmp/test.txt'].
text := f унших.
f хаах.

Програм цэвэрлэх.
usedMemory3 := (Програм санах-ой ? 1).



( usedMemory1 = usedMemory2 ба: usedMemory1 = usedMemory3, ба: usedMemory2 = usedMemory3 ) үнэн-бол: {
	Гаралт бичих: ['No memory leaks here'].
}, худал-бол: {
	Гаралт бичих: ['Leaking memory...'].
}.
