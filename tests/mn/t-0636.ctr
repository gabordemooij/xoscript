# test url parsing

Server init.
>> url := URL эх: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Гаралт бичих: ['scheme = '] + url схем, шинэ-мөр.
Гаралт бичих: ['host = '] + url хост, шинэ-мөр.
Гаралт бичих: ['port = '] + url порт, шинэ-мөр.
Гаралт бичих: ['path = '] + url зам, шинэ-мөр.
Гаралт бичих: ['query = '] + url хайлтын-параметрүүд, шинэ-мөр.
Гаралт бичих: ['fragment = '] + url хэсэг, шинэ-мөр.
