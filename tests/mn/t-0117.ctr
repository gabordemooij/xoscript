>> t := Үнэн.
(t = Үнэн) үнэн-бол: { Гаралт бичих: ['T']. }.
(t = Худал) үнэн-бол: { Гаралт бичих: ['F']. }.
Гаралт бичих: ['|'].
>> t := Худал.
(t = Үнэн) үнэн-бол: { Гаралт бичих: ['T']. }.
(t = Худал) үнэн-бол: { Гаралт бичих: ['F']. }.
Гаралт бичих: ['|'].
>> f := Үнэн.
(t = Үнэн ба: f = Худал) үнэн-бол: { Гаралт бичих: ['T']. }.
(t = Худал ба: f = Үнэн) үнэн-бол: { Гаралт бичих: ['F']. }.
Гаралт бичих: ['|'].
>> n := Хоосон.
(n Хоосон?) үнэн-бол: { Гаралт бичих: ['T']. }.
(n Хоосон?) худал-бол: { Гаралт бичих: ['F']. }.
Гаралт бичих: ['|'].
(f Boolean?) үнэн-бол: { Гаралт бичих: ['T']. }.
(f Boolean?) худал-бол: { Гаралт бичих: ['F']. }.



