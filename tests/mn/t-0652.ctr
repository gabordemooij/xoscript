# test number -> string -> number
{

	>> x := Тоо хооронд: 0 хүртэл: 1000000.
	>> d := Тоо хооронд: 1 хүртэл: 7.
	>> e := 10 зэрэг: d.

	x хуваах-тоонд: e.
	>> y := x тэмдэгт-мөр тоо.

	(x = y) худал-бол: {
		Гаралт бичих: x, шинэ-мөр.
		Гаралт бичих: y, шинэ-мөр.
		Програм дуусгах.
	}.

} * 1000.
Гаралт бичих: ['OK'], шинэ-мөр.