Гаралт бичих: ['Test object'], шинэ-мөр.
>> a := Объект шинэ. 

a ирэхэд: ['item:'] гүйцэтгэ: { :moment
	өөрийн moment := moment. 
}.

a ирэхэд: ['item'] гүйцэтгэ: { <- өөрийн moment.
}.

>> today := Жагсаалт шинэ ; ( Агшин шинэ цагийн-бүс: ['CEST'], жил: 2026, сар: 7 ).
a item: today.
Гаралт бичих: a item ? 0, шинэ-мөр.
a save-as: ['/tmp/a.bin'].
