Гаралт бичих: ['Test object'], шинэ-мөр.
>> greeter := Объект шинэ.
greeter ирэхэд: ['name:'] гүйцэтгэ: { :нэр
	өөрийн xname := нэр. 
}.
greeter ирэхэд: ['greet'] гүйцэтгэ: {
	Гаралт бичих: ['Hello '] + өөрийн xname, шинэ-мөр.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Гаралт бичих: ['========== RELOADING SNAP:'], шинэ-мөр.
>> b := Объект load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
