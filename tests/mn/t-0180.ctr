Тэмдэгт-мөр ирэхэд: ['html'] гүйцэтгэ: { <- (
		өөрөө
		солих: ['&'] үүгээр: ['&amp;'],
		солих: ['<'] үүгээр: ['&lt;'],
		солих: ['>'] үүгээр: ['&gt;'],
		солих: ['''] үүгээр: ['&apos;'],
		солих: ['"'] үүгээр: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програм санах-ойн-удирдлага: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Гаралт бичих: txt хуулах html, шинэ-мөр.
Гаралт бичих: txt хуулах жижиг-үсэг, шинэ-мөр.
Гаралт бичих: txt хуулах том-үсэг, шинэ-мөр.
} ажиллуулах.

Програм цэвэрлэх.

usedMemory1 := (Програм санах-ой ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Гаралт бичих: txt хуулах html, шинэ-мөр.
Гаралт бичих: txt хуулах жижиг-үсэг, шинэ-мөр.
Гаралт бичих: txt хуулах том-үсэг, шинэ-мөр.
} ажиллуулах.

Програм цэвэрлэх.
usedMemory2 := (Програм санах-ой ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Гаралт бичих: txt хуулах html, шинэ-мөр.
Гаралт бичих: txt хуулах жижиг-үсэг, шинэ-мөр.
Гаралт бичих: txt хуулах том-үсэг, шинэ-мөр.
} ажиллуулах.

Програм цэвэрлэх.
usedMemory3 := (Програм санах-ой ? 0).



( usedMemory1 = usedMemory2 ба: usedMemory1 = usedMemory3, ба: usedMemory2 = usedMemory3 ) үнэн-бол: {
	Гаралт бичих: ['No memory leaks here'].
}, худал-бол: {
	Гаралт бичих: ['Leaking memory...'].
}.
