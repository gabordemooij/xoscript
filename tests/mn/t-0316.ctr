>> Grandfather := Объект шинэ.
Grandfather ирэхэд: ['greet'] гүйцэтгэ: {
	Гаралт бичих: ['Ave!'], шинэ-мөр.
}.
>> Father := Grandfather шинэ.
Father ирэхэд: ['greet'] гүйцэтгэ: {
	Гаралт бичих: ['Hello'], шинэ-мөр.
	өөрөө greet.
}.
>> Son := Father шинэ.
Son ирэхэд: ['greet'] гүйцэтгэ: {
	Гаралт бичих: ['Hi'], шинэ-мөр.
	өөрөө greet.
}.

Son greet.

>> Roundabout := Объект шинэ.
Roundabout ирэхэд: ['circle:'] гүйцэтгэ: { :x
	Гаралт бичих: x, шинэ-мөр.
	(x < 3) үнэн-бол: { өөрөө рекурсив circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) үнэн-бол: { Гаралт бичих: x, шинэ-мөр. x нэмэх: 1.  increment ажиллуулах. }. }.
increment ажиллуулах.