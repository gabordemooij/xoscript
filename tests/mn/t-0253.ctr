#Linux
>> OS := Програм тохиргоо: ['OS'].

>> clock := Агшин шинэ.
	
(OS = ['Haiku']) үнэн-бол: {
	clock цагийн-бүс: ['CET'],
	жил: 2017, сар: 7, өдөр: 13,
	цаг-нэгж: 18, минут: 0, секунд: 0.
}, үгүй-бол: {
	clock цагийн-бүс: ['Europe/Amsterdam'],
	жил: 2017, сар: 7, өдөр: 13,
	цаг-нэгж: 18, минут: 0, секунд: 0.
}.

clock ирэхэд: ['tell'] гүйцэтгэ: {
	Гаралт бичих: өөрөө, шинэ-мөр.
}.


clock нэмэх: 2    цаг-нэгж, tell.
clock нэмэх: 1    цаг-нэгж, tell.
clock нэмэх: 19 минут, tell.
clock нэмэх: 1  минут, tell.
clock нэмэх: 1  минут, tell.
clock нэмэх: 19 секунд, tell.
clock нэмэх: 1  секунд, tell.
clock нэмэх: 1  секунд, tell.
clock нэмэх: 2    жил, tell.
clock нэмэх: 1    жил, tell.

(OS = ['Haiku']) үнэн-бол: {
clock нэмэх: 5   сар.
clock цагийн-бүс: ['CEST'], tell.
}, үгүй-бол: {
	clock нэмэх: 5   сар, tell.
}.

clock нэмэх: 1   сар, tell.
clock нэмэх: 19    өдөр, tell.
clock нэмэх: 1    цаг-нэгж, tell.
clock нэмэх: 120  yard, tell.
