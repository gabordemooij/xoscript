

# create a 64-bit integer for exact calculations
>> a := Int64 тэмдэгт-мөрөөс: ['123'].

# to string
Гаралт бичих: a, шинэ-мөр.

# divide
Гаралт бичих: a / (Int64 тэмдэгт-мөрөөс: ['3']), шинэ-мөр.

# multiply
Гаралт бичих: a * (Int64 тэмдэгт-мөрөөс: ['2']), шинэ-мөр.

# add
Гаралт бичих: a + (Int64 тэмдэгт-мөрөөс: ['1']), шинэ-мөр.

# subtract
Гаралт бичих: a - (Int64 тэмдэгт-мөрөөс: ['2']), шинэ-мөр.

# compare
Гаралт бичих: ( a =   (Int64 тэмдэгт-мөрөөс: ['123'])), шинэ-мөр.
Гаралт бичих: ( a !=: (Int64 тэмдэгт-мөрөөс: ['124'])), шинэ-мөр.
Гаралт бичих: ( a <   (Int64 тэмдэгт-мөрөөс: ['124'])), шинэ-мөр.
Гаралт бичих: ( a >   (Int64 тэмдэгт-мөрөөс: ['122'])), шинэ-мөр.
Гаралт бичих: ( a >=: (Int64 тэмдэгт-мөрөөс: ['123'])), шинэ-мөр.
Гаралт бичих: ( a <=: (Int64 тэмдэгт-мөрөөс: ['123'])), шинэ-мөр.





	