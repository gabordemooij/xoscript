

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програм санах-ойн-удирдлага: 0.

Тоо ирэхэд: ['addNum:'] гүйцэтгэ: { :x
	өөрөө нэмэх: x.
}.

Тоо ирэхэд: ['subtractNum:'] гүйцэтгэ: { :x
	өөрөө хасах: x.
}.

Тоо ирэхэд: ['multiplyBy:'] гүйцэтгэ: { :x
	өөрөө үржүүлэх: x.
}.

Тоо ирэхэд: ['divideBy:'] гүйцэтгэ: { :x
	өөрөө хуваах-тоонд: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 зэрэг: 8).  
a := a + (2 зэрэг: -1). 
a := a + (49 квадрат-язгуур).   
a addNum: ((Жагсаалт ← 0 ; 1) хамгийн-их).          
a addNum: ((Жагсаалт ← 2 ; 3) хамгийн-бага).
Гаралт бичих: a.

Програм цэвэрлэх.

usedMemory1 := (Програм санах-ой ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 зэрэг: 8).  
a := a + (2 зэрэг: -1). 
a := a + (49 квадрат-язгуур).   
a addNum: ((Жагсаалт ← 0 ; 1) хамгийн-их).          
a addNum: ((Жагсаалт ← 2 ; 3) хамгийн-бага).
Гаралт бичих: a.

Програм цэвэрлэх.
usedMemory2 := (Програм санах-ой ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 зэрэг: 8).  
a := a + (2 зэрэг: -1). 
a := a + (49 квадрат-язгуур).   
a addNum: ((Жагсаалт ← 0 ; 1) хамгийн-их).          
a addNum: ((Жагсаалт ← 2 ; 3) хамгийн-бага).
Гаралт бичих: a.

Програм цэвэрлэх.
usedMemory3 := (Програм санах-ой ? 0).



( usedMemory1 = usedMemory2 ба: usedMemory1 = usedMemory3, ба: usedMemory2 = usedMemory3 ) үнэн-бол: {
	Гаралт бичих: ['No memory leaks here'].
}, худал-бол: {
	Гаралт бичих: ['Leaking memory...'].
}.
