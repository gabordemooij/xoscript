Гаралт бичих: ['Test object'], шинэ-мөр.
>> a := Объект шинэ. 

a ирэхэд: ['item:'] гүйцэтгэ: { :логик
	өөрийн логик := логик. 
}.

a ирэхэд: ['item'] гүйцэтгэ: { <- өөрийн логик.
}.

a item: Худал.

Гаралт бичих: a item, шинэ-мөр.

>> old-bool-address := a item эх-загвар санах-ойн-хаяг.
a save-as: ['/tmp/a.bin'].
Гаралт бичих: ['========== RELOADING SNAP:'], шинэ-мөр.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item эх-загвар санах-ойн-хаяг = old-bool-address) үнэн-бол: {
	Гаралт бичих: ['Object link re-attached.'], шинэ-мөр.
}.

Гаралт бичих: b item, шинэ-мөр.
