
Програм санах-ойн-удирдлага: 4.

>> Animal := Объект шинэ.
Animal ирэхэд: ['make'] гүйцэтгэ: {
	>> animal := Объект шинэ.
	animal ирэхэд: ['makeSound'] гүйцэтгэ: {
		Гаралт бичих: өөрийн sound.
	}. <- animal.
}.
>> Cat := Объект шинэ.
Cat ирэхэд: ['make'] гүйцэтгэ: {
	>> cat := Animal make.
	cat ирэхэд: ['init'] гүйцэтгэ: {
		өөрийн sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
