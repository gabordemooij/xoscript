Жагсаалт ирэхэд: ['sum'] гүйцэтгэ: {
	>> total := 0.
	өөрөө бүр: { :index :element
		total нэмэх: element.
	}. <- total.
}.

>> a := Үнэн.



a ирэхэд: ['тэмдэгт-мөр'] гүйцэтгэ: {
	>> answer := Хоосон.
	( өөрөө = Үнэн ) үнэн-бол: {
		answer := ['Yep'].
	}, үгүй-бол: {
		answer := ['Nope'].
	}. <- answer.
}.

a ирэхэд: ['тоо'] гүйцэтгэ: {
	>> answer := Хоосон.
	( өөрөө = Үнэн ) үнэн-бол: {
		answer := 10.
	}, үгүй-бол: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b ирэхэд: ['тэмдэгт-мөр'] гүйцэтгэ: { <- ['Devil'].
}.

b ирэхэд: ['логик'] гүйцэтгэ: { <- Худал.
}.


Гаралт бичих: a, шинэ-мөр.  
Гаралт бичих: (90 + a), шинэ-мөр. 
Гаралт бичих: b, шинэ-мөр. 
Гаралт бичих: (Үнэн ба: b), шинэ-мөр.

a := Жагсаалт ← ['hello'] ; ['world'] ; Үнэн ; Хоосон ; 666. 
a := a + ( Жагсаалт ← 1 ).
Гаралт бичих: a, шинэ-мөр.
Гаралт бичих: ((Толь шинэ) хийх: Хоосон түлхүүр: Хоосон), шинэ-мөр.
Гаралт бичих: a sum, шинэ-мөр. 


{
	a ирэхэд: ['тэмдэгт-мөр'] гүйцэтгэ: { <- Хоосон. }.
	a := [''] + a.
} барих: { :error
	Гаралт бичих: ['Error noted: '] + error, шинэ-мөр.
}, ажиллуулах.



{
	a ирэхэд: ['тоо'] гүйцэтгэ: { <- Хоосон. }.
	a := 3 × a.
} барих: { :error
	Гаралт бичих: ['Error noted: '] + error, шинэ-мөр.
}, ажиллуулах.


{
	a ирэхэд: ['логик'] гүйцэтгэ: { <- Хоосон. }.
	a := Үнэн ба: a. 
} барих: { :error
	Гаралт бичих: ['Error noted: '] + error, шинэ-мөр.
}, ажиллуулах.





