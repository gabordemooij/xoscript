	a ирэхэд: ['тэмдэгт-мөр'] гүйцэтгэ: { <- Худал. }.
	a := [''] + a.
} барих: { :error
	Гаралт бичих: ['Error noted: '] + error, шинэ-мөр.
}, ажиллуулах.



