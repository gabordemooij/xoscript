>> t := Хоосон.

# you can control the time zone for
# parsing like this:
Агшин цагийн-бүс: ['CET'].
t := Агшин эх: ['1981-02-03 04:05:06'].
Гаралт бичих: t, шинэ-мөр.

# now using CEST time zone:
Агшин цагийн-бүс: ['CEST'].
t := Агшин эх: ['1981-02-03 04:05:06'].
Гаралт бичих: t, шинэ-мөр.

# error if string cannot be parsed
{ Агшин эх: ['1900']. } барих: { Хоосон. }, ажиллуулах.
