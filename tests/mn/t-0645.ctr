Server init.
Гаралт бичих: ['Database date test'], шинэ-мөр.

>> db := Maria-DB шинэ хост: ['localhost'],
	хэрэглэгчийн-нэр: ['xo'], 
	нууц-үг: ['pass123'],
	өгөгдлийн-сангийн-нэр: ['xobase'],
	холбогдох.

>> хайлтын-параметрүүд :=
db асуулга: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
татах: { :row
	Гаралт бичих: row datetest, шинэ-мөр.
}.
