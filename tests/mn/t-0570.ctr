#Linux

 >> t := Агшин шинэ.
 
t цагийн-бүс: ['Europe/Amsterdam'].
t жил: 2020, сар: 8, өдөр: 2, цаг-нэгж: 21, минут: 2, секунд: 1.

>> a := t цаг-нэгж.
>> ams := t цагийн-бүс.

t цагийн-бүс: ['US/Hawaii'].
>> b := t цаг-нэгж.
>> hw := t цагийн-бүс.

Гаралт
бичих: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		энэ: ['later'] эс-бөгөөс: ['earlier']
	)
),
шинэ-мөр.
 