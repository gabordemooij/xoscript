>> map1 := Толь шинэ.
>> key1 := Жагсаалт шинэ.
>> key2 := Жагсаалт шинэ.

map1
	хийх: ['hello'] түлхүүр: key1,
	хийх: ['world'] түлхүүр: key2.


Гаралт
	бичих: ['Map #1 contains: '] + (map1 байрлалд: key1),
	бичих: [' and '] + (map1 байрлалд: key2), шинэ-мөр.

>> KeyeableArray := Жагсаалт шинэ.
KeyeableArray ирэхэд: ['toString'] гүйцэтгэ: { <- (өөрөө тоо-ширхэг) toString.
}.

>> map2 := Толь шинэ.
key1 := KeyeableArray шинэ.
key2 := KeyeableArray шинэ.

key1 төгсгөлд-нэмэх: 1.

map2
	хийх: ['hello'] түлхүүр: key1,
	хийх: ['world'] түлхүүр: key2.

Гаралт
	бичих: ['Map #2 contains: '] + (map2 байрлалд: key1),
	бичих: [' and '] + (map2 байрлалд: key2), шинэ-мөр.
