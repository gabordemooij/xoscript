
Server init.
>> rq := HTTP-Хүсэлт шинэ.
Гаралт бичих: ['HTTP-GET d[]=']  + ( rq get-жагсаалт: ['d[]'] ), шинэ-мөр. # GET
Гаралт бичих: ['HTTP-GET f[]=']  + ( rq get-жагсаалт: ['f[]'] ), шинэ-мөр. # GET
Гаралт бичих: ['HTTP-POST e[]='] + ( rq post-жагсаалт: ['e[]'] ), шинэ-мөр. # GET
Гаралт бичих: ['HTTP-POST c=']   + ( rq post: ['c'] ), шинэ-мөр. # GET
Гаралт бичих: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), шинэ-мөр. # GET
