# test catch-all methods
>> x13 := Объект шинэ.
x13 ирэхэд: ['a'] гүйцэтгэ: { :a Гаралт бичих: 0, шинэ-мөр. }.
x13 ирэхэд: ['a:'] гүйцэтгэ: { :a Гаралт бичих: a, шинэ-мөр. <- 5. }.
x13 ирэхэд: ['a:b:'] гүйцэтгэ: { :a :b Гаралт бичих: (a + b), шинэ-мөр. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
