>> HTML := Объект шинэ.
HTML ирэхэд: ['хариулах:'] гүйцэтгэ: { :tag 
	Гаралт бичих: (['<tag>'] tag: tag), шинэ-мөр.
}.
HTML ирэхэд: ['хариулах:ба:'] гүйцэтгэ: { :tag :html 
	Гаралт бичих: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), шинэ-мөр.
}.
>> html := HTML шинэ.
html body h1: ['header'].

