Гаралт бичих: ['Test object'], шинэ-мөр.
>> a := Объект шинэ. 

a ирэхэд: ['state:'] гүйцэтгэ: { :list
	өөрийн list := list. 
}.

a ирэхэд: ['state'] гүйцэтгэ: {
	Гаралт бичих: өөрийн list, шинэ-мөр.
}.

a state: ( Жагсаалт шинэ ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
Гаралт бичих: ['========== RELOADING SNAP:'], шинэ-мөр.
>> b := Объект load-from: ['/tmp/a.bin'].
b state.