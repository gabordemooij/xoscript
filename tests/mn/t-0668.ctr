# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob шинэ: 8, bytes: (
	Жагсаалт шинэ ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Гаралт бичих: ( utf16 код-тайлах: ['utf16le'] ), шинэ-мөр.

utf16 чөлөөлөх.
>> utf32 := Blob шинэ: 13, bytes: (
	Жагсаалт шинэ ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Гаралт бичих: ( utf32 код-тайлах: ['utf32be'] ), шинэ-мөр.
utf32 чөлөөлөх.