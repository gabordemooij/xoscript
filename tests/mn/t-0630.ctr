#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Загвар шинэ: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern таарал: subject гүйцэтгэ: { :m :x
	Гаралт бичих: m, шинэ-мөр.
	Гаралт бичих: x, шинэ-мөр. <- ['XXX'].
}.
Гаралт бичих: result, шинэ-мөр.