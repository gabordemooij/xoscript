Гаралт бичих: ['Test object'], шинэ-мөр.
>> a := Объект шинэ. 

a ирэхэд: ['item:'] гүйцэтгэ: { :binhelper
	өөрийн binhelper := binhelper. 
}.

a ирэхэд: ['item'] гүйцэтгэ: { <- өөрийн binhelper.
}.

a item: Bin шинэ.

>> old-binhelper-address := a item эх-загвар санах-ойн-хаяг.
a save-as: ['/tmp/a.bin'].
Гаралт бичих: ['========== RELOADING SNAP:'], шинэ-мөр.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item эх-загвар санах-ойн-хаяг = old-binhelper-address) үнэн-бол: {
	Гаралт бичих: ['Object link re-attached.'], шинэ-мөр.
}.


