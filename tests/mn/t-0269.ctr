#Linux

(Файл шинэ: ['/tmp/testje']) байгаа худал-бол: {
	Програм систем: ['mkdir /tmp/testje'].	
}.

(Файл шинэ: ['/tmp/testje/file1']) байгаа худал-бол: {
	Програм систем: ['touch /tmp/testje/file1'].	
}.

(Файл шинэ: ['/tmp/testje/folder1']) байгаа худал-бол: {
	Програм систем: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Файл жагсаалт: ['/tmp/testje'].

>> q := Жагсаалт шинэ.

l бүр: { :k :v v бүр: { :x :y q төгсгөлд-нэмэх: y. }. }.

>> s := q тэмдэгт-мөр.

(s багтаасан: ['file1']) үнэн-бол:   { Гаралт бичих: ['OK'], шинэ-мөр. }.
(s багтаасан: ['file2']) үнэн-бол:   { Гаралт бичих: ['XX'], шинэ-мөр. }.
(s багтаасан: ['folder1']) үнэн-бол: { Гаралт бичих: ['OK'], шинэ-мөр. }.
