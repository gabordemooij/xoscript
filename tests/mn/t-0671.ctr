# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Сейф түлхүүр-үүсгэх.

# private (secret) key
>> sk := keys эхний.

# public key
>> pk := keys сүүлийн.

# sign a message
>> sig := Сейф гарын-үсэг: ['abc'] түлхүүрээр: sk.

# check message (ok)
Гаралт бичих: ( 
	Сейф
		шалгах: ['abc'] 
		гарын-үсэг: sig 
		түлхүүрээр: pk 
), шинэ-мөр.

# check message (fail)
Гаралт бичих: ( 
	Сейф 
		шалгах: ['abd'] 
		гарын-үсэг: sig 
		түлхүүрээр: pk 
), шинэ-мөр.