>> V := Объект.
V ирэхэд: ['тэмдэгт-мөр'] гүйцэтгэ: {
	Гаралт бичих: ['cast'], шинэ-мөр. <- ['abc'].
}.

Гаралт бичих: ( Програм тохиргоо: ['abc'] ), шинэ-мөр.

# params should not get gc'ed
Програм тохиргоо: ([''] + V шинэ) утга: ([''] + V шинэ).

Гаралт бичих: ( Програм тохиргоо: ['abc'] ), шинэ-мөр.
