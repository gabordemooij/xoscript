

>> Matryoshka := Объект шинэ.
Matryoshka ирэхэд: ['double:'] гүйцэтгэ: { :secret
	өөрийн secret := secret × 2.
}.
Matryoshka ирэхэд: ['шинэ:'] гүйцэтгэ: { :secret
	>> answer := Хоосон.
	>> t := (secret > 255).
	Гаралт бичих: (secret + [' | '] + t), шинэ-мөр.
	t үнэн-бол: {
		answer := secret.
	}, үгүй-бол: {
		answer := Matryoshka рекурсив шинэ: (өөрөө double: secret).
	}. <- answer.
}.

>> x := Matryoshka шинэ: 2.
