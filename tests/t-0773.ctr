Out write: ['Test object'], stop.
>> a := Object new. 
a on: ['item:'] do: { :int64
	own int64 := int64. 
}.
a on: ['item'] do: {
	<- own int64.
}.
a item: ( Int64 from-string: ['9999'] ).
Out write: a item, stop.
>> old-int64-address := a item prototype memory-address.
a save-as: ['/tmp/a.bin'].
Out write: ['========== RELOADING SNAP:'], stop.
>> b := Object load-from: ['/tmp/a.bin'].
(b item prototype memory-address = old-int64-address) true: {
	Out write: ['Object link re-attached.'], stop.
}.
Out write: ( b item ), stop.
