# תרחיש תקין
>> s := ⌝'hello;"""world"""\n"of";"c\ns\nv"'⌜.
>> נתיב-קובץ := ⌝'/tmp/dat.csv'⌜.
>> csv := קובץ חדש: נתיב-קובץ.
csv כתוב: s.

# מקבל CRLF LF CR, אורך שורות משתנה
csv מפריד: ⌝';'⌜ מירכאה: ⌝'"'⌜ שורות: ⎬ :line
	תוכנית נקה.
	פלט כתוב: line, שורה-חדשה.
	תוכנית נקה.
⎨.

# שורות לא שוות
s הוסף-בסוף: ⌝'\njustone'⌜.
csv כתוב: s.
⎬
	csv מפריד: ⌝';'⌜ מירכאה: ⌝'"'⌜ שורות: ⎬ :line
		פלט כתוב: line, שורה-חדשה.
	⎨.
⎨ תפוס: ⎬ :e 
	פלט כתוב: e, שורה-חדשה.
⎨, הפעל.

# תבנית לא תקינה
s := ⌝'"he"llo";world'⌜.
csv כתוב: s.
⎬
	csv מפריד: ⌝';'⌜ מירכאה: ⌝'"'⌜ שורות: ⎬ :line
		פלט כתוב: line, שורה-חדשה.
	⎨.
⎨ תפוס: ⎬ :e 
	פלט כתוב: e, שורה-חדשה.
⎨, הפעל.
