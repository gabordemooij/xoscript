# happy flow
>> s := ⌝'hello;"""world"""\n"of";"c\ns\nv"'⌜.
>> נתיב-קובץ := ⌝'/tmp/dat.csv'⌜.
>> csv := קובץ חדש: נתיב-קובץ.
csv כתוב: s.

# accepts CRLF LF CR, varying row length
csv מפריד: ⌝';'⌜ מירכאה: ⌝'"'⌜ שורות: ⎬ :line
	תוכנית נקה.
	פלט כתוב: line, שורה-חדשה.
	תוכנית נקה.
⎨.

# unequal lines
s הוסף-בסוף: ⌝'\njustone'⌜.
csv כתוב: s.
⎬
	csv מפריד: ⌝';'⌜ מירכאה: ⌝'"'⌜ שורות: ⎬ :line
		פלט כתוב: line, שורה-חדשה.
	⎨.
⎨ תפוס: ⎬ :e 
	פלט כתוב: e, שורה-חדשה.
⎨, הפעל.

# invalid format
s := ⌝'"he"llo";world'⌜.
csv כתוב: s.
⎬
	csv מפריד: ⌝';'⌜ מירכאה: ⌝'"'⌜ שורות: ⎬ :line
		פלט כתוב: line, שורה-חדשה.
	⎨.
⎨ תפוס: ⎬ :e 
	פלט כתוב: e, שורה-חדשה.
⎨, הפעל.
