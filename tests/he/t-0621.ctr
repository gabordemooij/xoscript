>> phrases := רשימה חדש
	~ ⌝'abcd'⌜
	~ ⌝'hello world'⌜
	~ ⌝''⌜
	~ ⌝'@.,;"'⌜
	~ ⌝'this is a much much longer string to be encoded!'⌜.

>> message := ⌝'Phrase: ~decoded base64: ~encoded'⌜.
	
phrases לכל: ⎬ :_ :phrase 
	>> e := Server base64-קידוד: phrase.
	>> d := Server base64-פענוח: e.
	פלט כתוב: ﴿
		message העתק ~encoded: e, ~decoded: d
	﴾, שורה-חדשה.
⎨.
