

>> g := Server חדש.
>> v := כספת חדש.
>> ok := 0.

>> secrets := רשימה חדש ; 
	 ⌝'aaa'⌜ ;
	 ⌝''⌜ ; 
	 ⌝'AB'⌜ ;
	 ⌝'abcdefghijklmnopqrstuvwxyz0123456789'⌜ ; 
	 ⌝'!@--+467hdHJKJs__=3hjsakd'⌜ ;
	 ⌝'spaces and	tabs'⌜ ;
	 ⌝'漢字'⌜ ;
	 ⌝'==[abc]=='⌜.
	
>> passwords := secrets העתק.
passwords לכל: ⎬ :i :p
	secrets לכל: ⎬ :n :s
		⎬
			>> encrypted := v הצפן: s מפתח: p.
			>> decrypted := v פענח-הצפנה: encrypted מפתח: p.
			﴿decrypted = s﴾ אם-אמת: ⎬
				ok חבר: 1.
			⎨, אחרת: ⎬
				פלט כתוב: ⌝'failed encrypting/decrypting: '⌜, שורה-חדשה.
				פלט כתוב: s, שורה-חדשה.
				פלט כתוב: ⌝'encrypted: '⌜ + encrypted, שורה-חדשה.
				פלט כתוב: ⌝'decrypted: '⌜ + encrypted, שורה-חדשה.
				תוכנית סיים.
			⎨.
		⎨ תפוס: ⎬ :err
			﴿s = ⌝''⌜ או: p = ⌝''⌜﴾ אם-אמת: ⎬
				ok חבר: 1.
			⎨, אחרת: ⎬
				פלט כתוב: err, שורה-חדשה.
				תוכנית סיים.
			⎨.
		⎨, הפעל.
	⎨.
⎨.

פלט כתוב: ﴿ ok + ⌝' vault encryptions tested.'⌜ ﴾, שורה-חדשה.