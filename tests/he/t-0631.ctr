#ffi test


Server init.

תוכנית ניהול-זיכרון: 4.

# for this test you need set a path to libc (puts)
>> libname := תוכנית הגדרה: ⌝'FFITESTLIB'⌜.



Server קשר: ﴿
 רשימה חדש ;
 libname ;
 ⌝'puts'⌜ ;
 ﴿ רשימה חדש ; ⌝'pointer'⌜ ﴾ ;
 ⌝'void'⌜ ;
 ⌝'Puts'⌜ ;
 ⌝'str:'⌜
﴾.

>> s := Blob utf8: ⌝'Hello from FFI!\n'⌜.

Puts str: s.
s שחרר.

# test with struct

>> a := Blob חדש: 8.
a בתים: ﴿
	רשימה <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
﴾.

>> struct := Blob struct: ﴿רשימה <<: ⌝'int'⌜, ; ⌝'int'⌜﴾.

Server קשר: ﴿
	רשימה <<: ⌝'@structtest'⌜, ;
	⌝'@structtest'⌜ ;
	﴿רשימה <<: struct﴾ ; 
	⌝'int'⌜ ;	
	⌝'ffitest'⌜ ;
	⌝'ffisum:'⌜
﴾.
	
פלט כתוב: ⌝'Sum test:'⌜ + ﴿ffitest ffisum: a﴾, שורה-חדשה.

struct שחרר-struct.
struct שחרר.
a שחרר.
