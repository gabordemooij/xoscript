Server init.

>> DB := Maria-DB חדש מארח: ⌝'localhost'⌜,
	שם-משתמש: ⌝'xo'⌜,
	סיסמה: ⌝'pass123'⌜,
	שם-מסד: ⌝'xobase'⌜,
	התחבר.
	
>> SQL := ⌝'SELECT "hello" AS "world" '⌜.

# a quicker way, get query from DB:
>> query2 := DB שאילתה: SQL.

# now you don't have to set DB
query2 שלוף: ⎬ :row
	פלט כתוב: row world, שורה-חדשה.
⎨.
