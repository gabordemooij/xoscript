# בדיקת המרות סוגים / המרות / קישורים
תוכנית ניהול-זיכרון: 4.
Server init.

>> מונה := 0.
>> מסד := Maria-DB חדש מארח: ⌝'localhost'⌜,
	שם-משתמש: ⌝'xo'⌜, סיסמה: ⌝'pass123'⌜, שם-מסד: ⌝'xobase'⌜, התחבר.

>> תבנית-דו-ספרתית := תבנית חדש: ⌝'%02d'⌜.

# תאריך ושעה
⎬
	>> שנה     := מספר בין: 1995 לבין: 2050, למחרוזת.
	>> חודש    := תבנית-דו-ספרתית החל-שלם: ﴿מספר בין: 1 לבין: 12﴾, למחרוזת.
	>> יום      := תבנית-דו-ספרתית החל-שלם: ﴿מספר בין: 1 לבין: 28﴾, למחרוזת.
	>> שעה     := תבנית-דו-ספרתית החל-שלם: ﴿מספר בין: 1 לבין: 23﴾, למחרוזת.
	>> דקה   := תבנית-דו-ספרתית החל-שלם: ﴿מספר בין: 1 לבין: 59﴾, למחרוזת.
	>> שנייה   := תבנית-דו-ספרתית החל-שלם: ﴿מספר בין: 1 לבין: 59﴾, למחרוזת.
	>> תאריך-ושעה := ⌝'YYYY-MM-DD HH:II:SS'⌜.	
	תאריך-ושעה
		YYYY: שנה,
		MM: חודש,
		DD: יום,
		HH: שעה,
		II: דקה,
		SS: שנייה.
	>> פרמטרי-חיפוש :=
	מסד שאילתה: ﴿⌝'
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'⌜ <datetime>: תאריך-ושעה﴾,
	שלוף: ⎬ :שורת-טבלה
		﴿שורת-טבלה mydatetime = תאריך-ושעה﴾ אם-שקר: ⎬
			משימה-זו שגיאה: ﴿
				⌝'צפוי: <expected> אבל התקבל: <observation>'⌜
				<expected>: תאריך-ושעה,
				<observation>: שורת-טבלה mydatetime
			﴾.
		⎨.
	
	⎨.
	מונה חבר: 1.
⎨ * 100.

# תאריך
⎬
	>> שנה     := מספר בין: 1995 לבין: 2050, למחרוזת.
	>> חודש    := תבנית-דו-ספרתית החל-שלם: ﴿מספר בין: 1 לבין: 12﴾, למחרוזת.
	>> יום      := תבנית-דו-ספרתית החל-שלם: ﴿מספר בין: 1 לבין: 28﴾, למחרוזת.
	>> תאריך     := ⌝'YYYY-MM-DD'⌜.
	תאריך
		YYYY: שנה,
		MM: חודש,
		DD: יום.
	>> פרמטרי-חיפוש :=
	מסד שאילתה: ﴿⌝'
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'⌜ <date>: תאריך﴾,
	שלוף: ⎬ :שורת-טבלה
		﴿שורת-טבלה mydate = תאריך﴾ אם-שקר: ⎬
			משימה-זו שגיאה: ﴿
				⌝'צפוי: <expected> אבל התקבל: <observation>'⌜
				<expected>: תאריך,
				<observation>: שורת-טבלה mydate
			﴾.
		⎨.
	⎨.
	מונה חבר: 1.
⎨ * 100.


# שעה
⎬
	>> שעה     := תבנית-דו-ספרתית החל-שלם: ﴿מספר בין: 1 לבין: 23﴾, למחרוזת.
	>> דקה   := תבנית-דו-ספרתית החל-שלם: ﴿מספר בין: 1 לבין: 59﴾, למחרוזת.
	>> שנייה   := תבנית-דו-ספרתית החל-שלם: ﴿מספר בין: 1 לבין: 59﴾, למחרוזת.
	>> זמן := ⌝'HH:II:SS'⌜.
	זמן
		HH: שעה,
		II: דקה,
		SS: שנייה.
	>> פרמטרי-חיפוש :=
	מסד שאילתה: ﴿⌝'
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'⌜ <time>: זמן﴾,
	שלוף: ⎬ :שורת-טבלה
		﴿שורת-טבלה mytime = זמן﴾ אם-שקר: ⎬
			משימה-זו שגיאה: ﴿
				⌝'צפוי: <expected> אבל התקבל: <observation>'⌜
				<expected>: תאריך-ושעה,
				<observation>: שורת-טבלה mytime
			﴾.
		⎨.
	⎨.
	מונה חבר: 1.
⎨ * 100.


# מחרוזות (varchar/text)
>> str1 := רשימה חדש מלא: 100000 בערך: ⌝'x'⌜, אחד: ⌝''⌜.
⎬
	>> str2 := כספת אסימון: 40.
	>> פרמטרי-חיפוש :=
	מסד שאילתה: ﴿⌝'
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'⌜ 
	<str1>: str1,
	<str2>: str2
	﴾,
	שלוף: ⎬ :שורת-טבלה
		﴿שורת-טבלה str1 = str1 וגם: שורת-טבלה str2 = str2﴾ אם-שקר: ⎬
			משימה-זו שגיאה: ﴿
				⌝'צפוי: <expected> אבל התקבל: <observation>'⌜
				<expected>: תאריך-ושעה,
				<observation>: שורת-טבלה mytime
			﴾.
		⎨.
	⎨.
	מונה חבר: 1.
⎨ * 100.


# מספרים
⎬
	>> n1  := מספר בין: 1 לבין: 99999.
	>> n2  := n1 / 1000.
	>> big := ﴿
		﴿ Int64 ממחרוזת: ⌝'9223372036854775807'⌜ ﴾ -
		﴿ Int64 ממחרוזת: ⌝'99999'⌜ ﴾ +
		﴿ Int64 ממחרוזת: n1 למחרוזת ﴾
	﴾.
	>> פרמטרי-חיפוש :=
	מסד שאילתה: ﴿⌝'
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	'⌜
	<n1>: n1,
	<n2>: n2,
	<big>: big
	﴾,
	שלוף: ⎬ :שורת-טבלה
		﴿שורת-טבלה n1 = n1﴾ אם-שקר: ⎬
			משימה-זו שגיאה: ﴿
				⌝'צפוי: <expected> אבל התקבל: <observation>'⌜
				<expected>: n1,
				<observation>: שורת-טבלה n1
			﴾.
		⎨.
		﴿שורת-טבלה n2 = n2﴾ אם-שקר: ⎬
			משימה-זו שגיאה: ﴿
				⌝'צפוי: <expected> אבל התקבל: <observation>'⌜
				<expected>: n1,
				<observation>: שורת-טבלה n2
			﴾.
		⎨.
		﴿שורת-טבלה n3 = n2 עיגול﴾ אם-שקר: ⎬
			משימה-זו שגיאה: ﴿
				⌝'צפוי: <expected> אבל התקבל: <observation>'⌜
				<expected>: n1,
				<observation>: שורת-טבלה n3
			﴾.
		⎨.
		﴿שורת-טבלה big = big﴾ אם-שקר: ⎬
			משימה-זו שגיאה: ﴿
				⌝'צפוי: <expected> אבל התקבל: <observation>'⌜
				<expected>: big,
				<observation>: שורת-טבלה big
			﴾.
		⎨.
		
	⎨.
	מונה חבר: 1.
⎨ * 100.


פלט כתוב: ﴿
	⌝'OK, <counter> fuzzy casts/conversions tested.'⌜
	<counter>: מונה
﴾, שורה-חדשה.