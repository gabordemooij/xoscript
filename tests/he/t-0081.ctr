>> map1 := מילון חדש.
>> key1 := רשימה חדש.
>> key2 := רשימה חדש.

map1
	שים: ⌝'hello'⌜ במפתח: key1,
	שים: ⌝'world'⌜ במפתח: key2.


פלט
	כתוב: ⌝'Map #1 contains: '⌜ + ﴿map1 במקום: key1﴾,
	כתוב: ⌝' and '⌜ + ﴿map1 במקום: key2﴾, שורה-חדשה.

>> KeyeableArray := רשימה חדש.
KeyeableArray בקבלת: ⌝'toString'⌜ בצע: ⎬ <- ﴿עצמי כמות﴾ toString.
⎨.

>> map2 := מילון חדש.
key1 := KeyeableArray חדש.
key2 := KeyeableArray חדש.

key1 הוסף-בסוף: 1.

map2
	שים: ⌝'hello'⌜ במפתח: key1,
	שים: ⌝'world'⌜ במפתח: key2.

פלט
	כתוב: ⌝'Map #2 contains: '⌜ + ﴿map2 במקום: key1﴾,
	כתוב: ⌝' and '⌜ + ﴿map2 במקום: key2﴾, שורה-חדשה.
