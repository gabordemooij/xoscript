# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := כספת צור-מפתחות.

# private (secret) key
>> sk := keys ראשון.

# public key
>> pk := keys אחרון.

# sign a message
>> sig := כספת חתום: ⌝'abc'⌜ במפתח: sk.

# check message (ok)
פלט כתוב: ﴿ 
	כספת
		בדוק: ⌝'abc'⌜ 
		חתימה: sig 
		במפתח: pk 
﴾, שורה-חדשה.

# check message (fail)
פלט כתוב: ﴿ 
	כספת 
		בדוק: ⌝'abd'⌜ 
		חתימה: sig 
		במפתח: pk 
﴾, שורה-חדשה.