רשימה בקבלת: ⌝'sum'⌜ בצע: ⎬
	>> total := 0.
	עצמי לכל: ⎬ :index :element
		total חבר: element.
	⎨. <- total.
⎨.

>> a := אמת.



a בקבלת: ⌝'למחרוזת'⌜ בצע: ⎬
	>> answer := כלום.
	﴿ עצמי = אמת ﴾ אם-אמת: ⎬
		answer := ⌝'Yep'⌜.
	⎨, אחרת: ⎬
		answer := ⌝'Nope'⌜.
	⎨. <- answer.
⎨.

a בקבלת: ⌝'למספר'⌜ בצע: ⎬
	>> answer := כלום.
	﴿ עצמי = אמת ﴾ אם-אמת: ⎬
		answer := 10.
	⎨, אחרת: ⎬
		answer := 20.
	⎨. <- answer.
⎨.

>> b := 666.

b בקבלת: ⌝'למחרוזת'⌜ בצע: ⎬ <- ⌝'Devil'⌜.
⎨.

b בקבלת: ⌝'לבוליאני'⌜ בצע: ⎬ <- שקר.
⎨.


