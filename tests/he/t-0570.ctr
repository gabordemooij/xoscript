#Linux

 >> t := רגע חדש.
 
t אזור-זמן: ⌝'Europe/Amsterdam'⌜.
t שנה: 2020, חודש: 8, יום: 2, שעה: 21, דקה: 2, שנייה: 1.

>> a := t שעה.
>> ams := t אזור-זמן.

t אזור-זמן: ⌝'US/Hawaii'⌜.
>> b := t שעה.
>> hw := t אזור-זמן.

פלט
כתוב: ﴿
	⌝'It's diff in zone2 than in zone1'⌜
	zone1: ams,
	zone2: hw,
	diff: ﴿
		﴿b > a﴾
		זה: ⌝'later'⌜ אחרת: ⌝'earlier'⌜
	﴾
﴾,
שורה-חדשה.
 