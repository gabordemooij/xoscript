Server init.

# מקודד ה-JSON תומך רק ב-UTF-8, בלי זוגות surrogate

>> מילונים := רשימה חדש ;
	# {"key":"normal"} ASCII רגיל
	﴿ מילון חדש שים: ⌝'רגיל'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"hello world"} תו רווח
	﴿ מילון חדש שים: ⌝'hello world'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"quote: \""} מירכאות כפולות
	﴿ מילון חדש שים: ⌝'"'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"backslash: \\"} לוכסן הפוך
	﴿ מילון חדש שים: ⌝'backslash: \\'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"slash: /"} לוכסן
	﴿ מילון חדש שים: ⌝'לוכסן: /'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"backspace: \b"} backspace
	﴿ מילון חדש שים: ⌝'backspace: \b'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"formfeed: \f"} תו בריחה form-feed
	﴿ מילון חדש שים: ⌝'formfeed: \f'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"newline: \n"} שורה חדשה
	﴿ מילון חדש שים: ⌝'newline: \n'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	﴿ מילון חדש שים: ⌝'newline: ↵'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	﴿ מילון חדש שים: ⌝'newline: 
	'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"carriage return: \r"} החזרת גררה
	﴿ מילון חדש שים: ⌝'carriage return: \r'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"tab: \t"} טאב
	﴿ מילון חדש שים: ⌝'tab \t'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	﴿ מילון חדש שים: ⌝'tab ⇿'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	﴿ מילון חדש שים: ⌝'tab  '⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u0000"} NUL
	﴿ מילון חדש שים: ⌝'NUL \u0000'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	﴿ מילון חדש שים: ⌝'NUL \0'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u0001"} תו בקרה 0x01
	﴿ מילון חדש שים: ⌝'control: \u0001'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u001F"} תו בקרה 0x1F
	﴿ מילון חדש שים: ⌝'control: \u001F'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: é"} UTF-8, תו של 2 בתים
	﴿ מילון חדש שים: ⌝'יוניקוד: é'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: €"} UTF-8, תו של 3 בתים
	﴿ מילון חדש שים: ⌝'יוניקוד: €'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 日本語"} כמה תווי UTF-8 של 3 בתים
	﴿ מילון חדש שים: ⌝'יוניקוד: 日本語'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 😀"} UTF-8, תו של 4 בתים
	﴿ מילון חדש שים: ⌝'יוניקוד: 😀'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 🧑‍💻"} אימוג'י + מחבר ברוחב אפס
	﴿ מילון חדש שים: ⌝'יוניקוד: 🧑‍💻'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"combining: é"} סימן הטעמה משולב
	﴿ מילון חדש שים: ⌝'combining: e\u0301'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: é"} תו בריחה Unicode BMP
	﴿ מילון חדש שים: ⌝'escaped unicode: \u00e9'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: €"} תו בריחה Unicode BMP
	﴿ מילון חדש שים: ⌝'escaped unicode: \u20ac'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: 😀"} זוג surrogate של UTF-16
	﴿ מילון חדש שים: ⌝'escaped unicode: \ud83d\ude00'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":""} ערך ריק
	﴿ מילון חדש שים: ⌝''⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"@ < > & = % + ? #"} תווי ASCII מיוחדים
	﴿ מילון חדש שים: ⌝'@ < > & = % + ? #'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"single quote: '"} מירכה בודדת
	﴿ מילון חדש שים: ⌝'''⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"multiple: \" \\ \n \r \t"} כמה תווי בריחה של JSON
	﴿ מילון חדש שים: ⌝'multiple: \" \\ \n \r \t'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} מחרוזת ASCII ארוכה יותר
	﴿ מילון חדש שים: ⌝'aaaaaaaaaaaaaaaaaaaaaaaaaa'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":" value"} רווח בהתחלה
	﴿ מילון חדש שים: ⌝' ערך'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"value "} רווח בסוף
	﴿ מילון חדש שים: ⌝'ערך '⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":" \t\n\r "} תווי רווח לבן
	﴿ מילון חדש שים: ⌝' \t\n\r '⌜ במפתח: ⌝'key'⌜ ﴾
	.

מילונים לכל: ⎬ :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: ﴿מילון חדש שים: d key במפתח: ⌝'key'⌜﴾.
	>> b := JSON jsonify: ﴿מילון חדש שים: ⌝'value'⌜ במפתח: d key﴾.
	>> e := JSON אובייקט: a.
	>> f := JSON אובייקט: b.
	﴿﴿e key = d key וגם: ﴿f ? d key = ⌝'value'⌜﴾﴾ או: ﴿e key = ⌝'NUL ?'⌜﴾﴾ אם-אמת: ⎬
		פלט כתוב: ⌝'OK'⌜, שורה-חדשה.
	⎨, אחרת: ⎬
		פלט כתוב: ⌝'לא ניתן לקודד/לפענח כראוי: '⌜ + d + j, שורה-חדשה.
		תוכנית סיים.
	⎨.
⎨.
