Server init.

# JSON encoder only supports UTF-8, no surrogate pairs

>> dicts := רשימה חדש ;
	# {"key":"normal"} normal ASCII
	﴿ מילון חדש שים: ⌝'normal'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"hello world"} space character
	﴿ מילון חדש שים: ⌝'hello world'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"quote: \""} double quote
	﴿ מילון חדש שים: ⌝'"'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"backslash: \\"} backslash
	﴿ מילון חדש שים: ⌝'backslash: \\'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"slash: /"} slash
	﴿ מילון חדש שים: ⌝'slash: /'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"backspace: \b"} backspace
	﴿ מילון חדש שים: ⌝'backspace: \b'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"formfeed: \f"} form-feed escape
	﴿ מילון חדש שים: ⌝'formfeed: \f'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"newline: \n"} newline
	﴿ מילון חדש שים: ⌝'newline: \n'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	﴿ מילון חדש שים: ⌝'newline: ↵'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	﴿ מילון חדש שים: ⌝'newline: 
	'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"carriage return: \r"} carriage-return
	﴿ מילון חדש שים: ⌝'carriage return: \r'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"tab: \t"} tab
	﴿ מילון חדש שים: ⌝'tab \t'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	﴿ מילון חדש שים: ⌝'tab ⇿'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	﴿ מילון חדש שים: ⌝'tab  '⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u0000"} NUL
	﴿ מילון חדש שים: ⌝'NUL \u0000'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	﴿ מילון חדש שים: ⌝'NUL \0'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u0001"} control character 0x01
	﴿ מילון חדש שים: ⌝'control: \u0001'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u001F"} control character 0x1F
	﴿ מילון חדש שים: ⌝'control: \u001F'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: é"} UTF-8, 2-byte char
	﴿ מילון חדש שים: ⌝'unicode: é'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: €"} UTF-8, 3-byte char
	﴿ מילון חדש שים: ⌝'unicode: €'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 日本語"} multiple 3-byte UTF-8 chars
	﴿ מילון חדש שים: ⌝'unicode: 日本語'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 😀"} UTF-8, 4-byte char
	﴿ מילון חדש שים: ⌝'unicode: 😀'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	﴿ מילון חדש שים: ⌝'unicode: 🧑‍💻'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"combining: e\u0301"} combining accent
	﴿ מילון חדש שים: ⌝'combining: e\u0301'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: \u00e9"} Unicode escape BMP
	﴿ מילון חדש שים: ⌝'escaped unicode: \u00e9'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: \u20ac"} Unicode escape BMP
	﴿ מילון חדש שים: ⌝'escaped unicode: \u20ac'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: \ud83d\ude00"} UTF-16 surrogate pair
	﴿ מילון חדש שים: ⌝'escaped unicode: \ud83d\ude00'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":""} empty value
	﴿ מילון חדש שים: ⌝''⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"@ < > & = % + ? #"} special ASCII chars
	﴿ מילון חדש שים: ⌝'@ < > & = % + ? #'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"single quote: '"} single quote
	﴿ מילון חדש שים: ⌝'''⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"multiple: \" \\ \n \r \t"} multiple JSON escapes
	﴿ מילון חדש שים: ⌝'multiple: \" \\ \n \r \t'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} longer ASCII-string
	﴿ מילון חדש שים: ⌝'aaaaaaaaaaaaaaaaaaaaaaaaaa'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":" value"} leading space
	﴿ מילון חדש שים: ⌝' value'⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":"value "} trailing space
	﴿ מילון חדש שים: ⌝'value '⌜ במפתח: ⌝'key'⌜ ﴾ ;
	# {"key":" \t\n\r "} whitespace
	﴿ מילון חדש שים: ⌝' \t\n\r '⌜ במפתח: ⌝'key'⌜ ﴾.

dicts לכל: ⎬ :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: ﴿מילון חדש שים: d key במפתח: ⌝'key'⌜﴾.
	>> b := JSON jsonify: ﴿מילון חדש שים: ⌝'value'⌜ במפתח: d key﴾.
	>> e := JSON אובייקט: a.
	>> f := JSON אובייקט: b.
	﴿﴿e key = d key וגם: ﴿f ? d key = ⌝'value'⌜﴾﴾ או: ﴿e key = ⌝'NUL ?'⌜﴾﴾ אם-אמת: ⎬
		פלט כתוב: ⌝'OK'⌜, שורה-חדשה.
	⎨, אחרת: ⎬
		פלט כתוב: ⌝'Unable to properly encode/decode: '⌜ + d + j, שורה-חדשה.
		תוכנית סיים.
	⎨.
⎨.
