# Password hashing
Server init.

# User sets a password
>> passw := ⌝'pass123'⌜.

# You store it like this
>> hash := כספת 
	גיבוב-סיסמה: passw.

# Then, user logs in
# Attempt 1
>> a1 := ⌝'abcd123'⌜.
# Attempt 2
>> a2 := ⌝'pass123'⌜.

# Verify
>> a := כספת 
	גיבוב-סיסמה: hash אמת: a1.
	# fail 
>> b := כספת
	גיבוב-סיסמה: hash אמת: a2.
	# ok!

פלט כתוב: a, שורה-חדשה.
פלט כתוב: b, שורה-חדשה.

