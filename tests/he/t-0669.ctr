# גיבוב סיסמאות
Server init.

# המשתמש קובע סיסמה
>> סיסמ := ⌝'pass123'⌜.

# שומרים אותה כך
>> גיבוב-שלי := כספת 
	גיבוב-סיסמה: סיסמ.

# אחר כך המשתמש מתחבר
# ניסיון 1
>> a1 := ⌝'abcd123'⌜.
# ניסיון 2
>> a2 := ⌝'pass123'⌜.

# אימות
>> a := כספת 
	גיבוב-סיסמה: גיבוב-שלי אמת: a1.
	# נכשל 
>> b := כספת
	גיבוב-סיסמה: גיבוב-שלי אמת: a2.
	# תקין!

פלט כתוב: a, שורה-חדשה.
פלט כתוב: b, שורה-חדשה.

