# Test utf8 sanitizer
Server init.

>> utf8cases := מילון חדש
	# ASCII only
	שים: ﴿ רשימה חדש ; 65 ; 65 ; 65 ; 65 ; 0 ﴾ במפתח: ⌝'AAAA'⌜,
	# valid 2 byte sequence
	שים: ﴿ רשימה חדש ; 194 ; 162 ; 0 ﴾ במפתח: ⌝'¢'⌜,
	# Valid 3-byte UTF-8
    שים: ﴿ רשימה חדש ; 226 ; 130 ; 172 ; 0 ﴾ במפתח: ⌝'€'⌜,
	# Valid 4-byte UTF-8
    שים: ﴿ רשימה חדש ; 240 ; 144 ; 141 ; 136 ; 0 ﴾ במפתח: ⌝'𐍈'⌜,
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    שים: ﴿ רשימה חדש ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ﴾ במפתח: ⌝'A?A'⌜,
	# Overlong encoding of ASCII 'A' (should become ?),
    שים: ﴿ רשימה חדש ; 65 ; 193 ; 129 ; 0 ﴾ במפתח: ⌝'A?'⌜,
	# Invalid first byte (0xFF)
    שים: ﴿ רשימה חדש ; 255 ; 0 ﴾ במפתח: ⌝'?'⌜,
	# Incomplete multi-byte sequence at end
    שים: ﴿ רשימה חדש ; 66 ; 226 ; 0 ﴾ במפתח: ⌝'B?'⌜,
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    שים: ﴿ רשימה חדש ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ﴾ במפתח: ⌝'A€?𐍈B'⌜.
	 
utf8cases לכל: ⎬ :key :value
	>> blob := Blob חדש: value כמות, בתים: value.
	>> str := blob למחרוזת.
	﴿str = key﴾ אם-אמת: ⎬
		פלט כתוב: ⌝'OK'⌜, שורה-חדשה.
	⎨, אחרת: ⎬
		פלט כתוב: ⌝'UTF8 sanitizer failed on: '⌜ + key + ⌝' got: '⌜ + str, שורה-חדשה.
	⎨.
	blob שחרר.
⎨.
