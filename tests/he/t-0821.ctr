# a quote that never closes must give an error, not an endless loop
>> נתיב-קובץ := ⌝'/tmp/test0821.csv'⌜.
>> file := קובץ חדש: נתיב-קובץ.

file כתוב: ⌝'a,b\n"1,2\n'⌜.
⎬
	file מפריד: ⌝','⌜ מירכאה: ⌝'"'⌜ שורות: ⎬ :line
		פלט כתוב: line, שורה-חדשה.
	⎨.
⎨ תפוס: ⎬ :e פלט כתוב: e, שורה-חדשה. ⎨, הפעל.

# a closed quote still works
file כתוב: ⌝'a,b\n"1,2",3'⌜.
file מפריד: ⌝','⌜ מירכאה: ⌝'"'⌜ שורות: ⎬ :line
	פלט כתוב: line, שורה-חדשה.
⎨.
file מחק.
