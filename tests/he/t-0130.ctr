# שימוש ב-FFI עם התוסף Server

# התחברות ל-libc (תלוי פלטפורמה)
>> שם-ספרייה := תוכנית הגדרה: ⌝'FFITESTLIB'⌜.

# קישור פונקציות stdio מ-C לפעולות קבצים מתקדמות
Server קשר: ﴿ רשימה חדש ;
 שם-ספרייה ; ⌝'fopen'⌜ ;
 ﴿ רשימה חדש ; ⌝'pointer'⌜ ; ⌝'pointer'⌜﴾ ;
 ⌝'pointer'⌜ ;
 ⌝'Stream'⌜ ;
 ⌝'path:mode:'⌜
﴾,
קשר: ﴿ רשימה חדש ;
 כלום ; # פירושו אותה ספרייה
 ⌝'fread'⌜ ;
 ﴿ רשימה חדש ; ⌝'pointer'⌜ ; ⌝'int'⌜ ; ⌝'int'⌜ ; ⌝'pointer'⌜ ﴾ ;
 ⌝'int'⌜ ;
 כלום ; # פירושו אותו אובייקט (כלומר זרם)
 ⌝'fread'⌜
﴾,
קשר: ﴿
 רשימה חדש ;
 כלום ; # פירושו אותה ספרייה
 ⌝'fwrite'⌜ ;
 ﴿ רשימה חדש ; ⌝'pointer'⌜ ; ⌝'int'⌜ ; ⌝'int'⌜ ; ⌝'pointer'⌜ ﴾ ;
 ⌝'int'⌜ ;
 כלום ; # פירושו אותה ספרייה
 ⌝'fwrite'⌜
﴾,
קשר: ﴿
 רשימה חדש ;
 כלום ; # פירושו אותה ספרייה
 ⌝'rewind'⌜ ;
 ﴿ רשימה חדש ; ⌝'pointer'⌜ ﴾ ;
 ⌝'int'⌜ ;
 כלום ; # פירושו אותה ספרייה
 ⌝'rewind:'⌜
﴾.

>> str  := Blob utf8: ⌝'abc123'⌜.
>> נתיב-קובץ := Blob utf8: ⌝'/tmp/bla.txt'⌜.
>> mode := Blob utf8: ⌝'w+'⌜.

# פתיחת קובץ עם fopen(path, mode)
>> מתאר-קובץ := Stream path: נתיב-קובץ mode: mode.

# כתיבת בתים מהחוצץ str לקובץ
>> בתים-שנכתבו := Stream הודעה: ⌝'fwrite'⌜ ארגומנטים: ﴿רשימה חדש ; str ; 1 ; 6 ; מתאר-קובץ ﴾.
פלט כתוב: בתים-שנכתבו, שורה-חדשה.

# החזרת מצביע הקובץ להתחלה
Stream rewind: מתאר-קובץ.

# הקצאת חוצץ
>> חוצץ-בתים := Blob חדש: 20.

# קריאה מהקובץ
>> בתים-שנקראו := Stream הודעה: ⌝'fread'⌜ ארגומנטים: ﴿רשימה חדש ; חוצץ-בתים ; 1 ; 6 ; מתאר-קובץ ﴾.
פלט כתוב: בתים-שנקראו, שורה-חדשה.
פלט כתוב: חוצץ-בתים, שורה-חדשה.

# שחרור זיכרון
str  שחרר.
נתיב-קובץ שחרר.
mode שחרר.
חוצץ-בתים  שחרר.


