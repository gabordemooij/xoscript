# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := אובייקט חדש.

Log בקבלת: ⌝'say:'⌜ בצע: ⎬ :str
	פלט כתוב: str, שורה-חדשה.
⎨.

>> Item := אובייקט חדש.

Item בקבלת: ⌝'חדש:'⌜ בצע: ⎬ :id <- עצמי חדש id: id.
⎨.

Item בקבלת: ⌝'id:'⌜ בצע: ⎬ :id
	שלי id := id.
⎨.

Item בקבלת: ⌝'id'⌜ בצע: ⎬ <- שלי id. ⎨.


Item בקבלת: ⌝'למחרוזת'⌜ בצע: ⎬
	>> str := ⌝'Item#~no'⌜.
	str ~no: שלי id. <- str.
⎨.


>> Print := אובייקט חדש.

Print בקבלת: ⌝'items'⌜ בצע: ⎬ 
	
	שלי item := Item חדש: 1.
	
	# either segfault or wrong str here
	Log say: ﴿
		⌝'~item printed.'⌜ ~item: שלי item
	﴾.
	
	
⎨.

Print items.