>> Greeter := אובייקט חדש.
Greeter בקבלת: ⌝'make'⌜ בצע: ⎬
	>> gr := אובייקט חדש.
	gr בקבלת: ⌝'setName:'⌜ בצע: ⎬ :aname
		שלי שם := aname.
	⎨.
	gr בקבלת: ⌝'greet'⌜ בצע: ⎬
		פלט כתוב: שלי שם.
	⎨. <- gr.
⎨.
>> a := Greeter make.
>> b := Greeter make.
a setName: ⌝'ONE'⌜.
b setName: ⌝'TWO'⌜.
a greet.
b greet.
>> c := a חדש.
c setName: ⌝'THREE'⌜.
c greet.
>> d := a חדש.
d setName: ⌝'FOUR'⌜.
d greet.
c greet.
