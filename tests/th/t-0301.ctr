


>> wine := ออบเจกต์ สร้างใหม่.


wine เมื่อ: ['toString'] ทำ: { <- ['merlot'].
}.

wine เมื่อ: ['naarTekst'] ทำ: { <- ['merlot'].
}.


wine เมื่อ: ['='] ทำ: { :other wine <- ( ตัวเอง toString = other wine ).
}.

wine เมื่อ: ['=='] ทำ: { :other wine <- ( ตัวเอง toString = other wine ).
}.



wine
	กรณี: ['cabernet'] ทำ: { แสดงผล เขียน: ['it's a Cabernet!']. },
	กรณี: ['syrah']    ทำ: { แสดงผล เขียน: ['it's a Syrah!'].    },
	กรณี: ['merlot']   ทำ: { แสดงผล เขียน: ['it's a Merlot!'].   },
	กรณี: ['malbec']   ทำ: { แสดงผล เขียน: ['it's a Malbec!'].   }.

แสดงผล ขึ้นบรรทัดใหม่.
