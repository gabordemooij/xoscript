
>> Greeter := ออบเจกต์ สร้างใหม่.
Greeter เมื่อ: ['สร้างใหม่'] ทำ: {
	ของตน ชื่อ := ['?'].
}.
Greeter เมื่อ: ['name:'] ทำ: { :ชื่อ
	ของตน ชื่อ := ชื่อ.
}.
Greeter เมื่อ: ['greet'] ทำ: {
	แสดงผล เขียน: (['hello[you]'] [you]: ของตน ชื่อ).
}.
>> friend := Greeter สร้างใหม่.
friend name: ['1'].
friend greet.
