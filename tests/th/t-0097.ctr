
ข้อความ เมื่อ: ['html'] ทำ: { <- (
		ตัวเอง
		แทนที่: ['&'] ด้วย: ['&amp;'],
		แทนที่: ['<'] ด้วย: ['&lt;'],
		แทนที่: ['>'] ด้วย: ['&gt;'],
		แทนที่: ['"'] ด้วย: ['&quot;']
	).
}.

>> HtmlBrush := ออบเจกต์ สร้างใหม่.

HtmlBrush เมื่อ: ['ตอบ:'] ทำ: { :tag
	แสดงผล เขียน: (['<tag>↵'] tag: tag ).
}.

HtmlBrush เมื่อ: ['ตอบ:และ:'] ทำ: { :tag :content
	tag := ( tag เริ่มที่: 0 ความยาว: (tag ความยาว - 1) ).
	แสดงผล เขียน: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush เมื่อ: ['content:'] ทำ: { :text
	แสดงผล เขียน: text html, ขึ้นบรรทัดใหม่.
}.

HtmlBrush เมื่อ: ['attr:value:'] ทำ: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush สร้างใหม่.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
