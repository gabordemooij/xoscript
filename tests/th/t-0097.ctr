
ข้อความ เมื่อ: ['html'] ทำ: { <- (
		ตัวเอง
		แทนที่: ['&'] ด้วย: ['&amp;'],
		แทนที่: ['<'] ด้วย: ['&lt;'],
		แทนที่: ['>'] ด้วย: ['&gt;'],
		แทนที่: ['"'] ด้วย: ['&quot;']
	).
}.

>> แปรงHtml := ออบเจกต์ สร้างใหม่.

แปรงHtml เมื่อ: ['ตอบ:'] ทำ: { :แท็ก
	แสดงผล เขียน: (['<tag>↵'] tag: แท็ก ).
}.

แปรงHtml เมื่อ: ['ตอบ:และ:'] ทำ: { :แท็ก :content
	แท็ก := ( แท็ก เริ่มที่: 0 ความยาว: (แท็ก ความยาว - 1) ).
	แสดงผล เขียน: (['<tag content>↵'] tag: แท็ก, content: content).
}.

แปรงHtml เมื่อ: ['content:'] ทำ: { :เนื้อข้อความ
	แสดงผล เขียน: เนื้อข้อความ html, ขึ้นบรรทัดใหม่.
}.

แปรงHtml เมื่อ: ['แอตทริบิวต์:ค่า:'] ทำ: { :แอตทริบิวต์ :value <- ['attr="value"'] attr: แอตทริบิวต์, value: value.
}.

>> h := แปรงHtml สร้างใหม่.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h แอตทริบิวต์: ['class'] ค่า: ['bold']),
		/span
	/body
/html.
		
