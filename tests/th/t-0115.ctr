{
	งานนี้ ข้อผิดพลาด: ['Dont fail.'].
	unknown doSomething.
} ดักจับ: {
	แสดงผล เขียน: ['Caught!'].
}, เริ่ม.

{
	งานนี้ ข้อผิดพลาด: ['Dont fail.'].
	ของตน unknown doSomething.
} ดักจับ: {
	แสดงผล เขียน: ['Caught!'].
}, เริ่ม.

{
	งานนี้ ข้อผิดพลาด: ['Dont fail.'].
	unknown := 122.
} ดักจับ: {
	แสดงผล เขียน: ['Caught!'].
}, เริ่ม.


{
	งานนี้ ข้อผิดพลาด: ['Dont fail.'].
	จริง หยุดวน.
	แสดงผล เขียน: ['FAIL'].
} ดักจับ: {
	แสดงผล เขียน: ['Caught!'].
}, เริ่ม.

{
	{
		งานนี้ ข้อผิดพลาด: ['Dont fail.'].
		จริง หยุดวน.
		แสดงผล เขียน: ['FAIL'].
	} ดักจับ: { :x
		(x = ['Dont fail.']) ถ้าจริง: { งานนี้ ข้อผิดพลาด: ['Nested Caught!']. }.
	}, เริ่ม.
} ดักจับ: { :e
	แสดงผล เขียน: e.
}, เริ่ม.
