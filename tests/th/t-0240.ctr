# ทดสอบหน่วย

>> $ := ออบเจกต์ สร้างใหม่.

$ เมื่อ: ['ตอบ:'] ทำ: { :x
	
	>> การดำเนินการ := x อักขระ: 0.
	>> สกุลเงินตรา := x อักขระ: 1.
	>> เงิน := x ข้าม: 2.
	
	>> จำนวนเงิน := 0.

	( การดำเนินการ = ['+'] ) ถ้าจริง: {
		( สกุลเงินตรา = ['£'] ) ถ้าจริง: { จำนวนเงิน := 1.28 × เงิน. }.
	}. <- จำนวนเงิน.
}.



>> x := $ +£20.

แสดงผล เขียน: x, ขึ้นบรรทัดใหม่.


>> ผลไม้ := ออบเจกต์ สร้างใหม่.

ผลไม้ เมื่อ: ['สร้างใหม่'] ทำ: {
	>> f := ตัวเอง สร้างใหม่.
	f apples: 0.
	f oranges: 0. <- f.
}.

ผลไม้ เมื่อ: ['apples:'] ทำ: { :a ของตน แอปเปิล := a. }.
ผลไม้ เมื่อ: ['oranges:'] ทำ: { :p ของตน ส้ม := p. }.
ผลไม้ เมื่อ: ['แอปเปิล'] ทำ: { <- ของตน แอปเปิล. }.
ผลไม้ เมื่อ: ['ส้ม'] ทำ: { <- ของตน ส้ม. }.

ผลไม้ เมื่อ: ['+'] ทำ: { :f
	
	>> n := ผลไม้ สร้างใหม่.
	f บวก: 1.
	
	n apples: (f แอปเปิล + ของตน แอปเปิล).
	n oranges:  (f ส้ม  + ของตน ส้ม). <- n.
}.

ผลไม้ เมื่อ: ['เป็นข้อความ'] ทำ: { <- ( ของตน แอปเปิล เป็นข้อความ + [' แอปเปิล และ '] + ของตน ส้ม + [' ส้ม'] ).
}.

ตัวเลข เมื่อ: ['แอปเปิล'] ทำ: { <- ((ผลไม้ สร้างใหม่) apples: ตัวเอง).
}.

ตัวเลข เมื่อ: ['apple'] ทำ: { <- ((ผลไม้ สร้างใหม่) apples: ตัวเอง).
}.

ตัวเลข เมื่อ: ['ส้ม'] ทำ: { <- ((ผลไม้ สร้างใหม่) oranges: ตัวเอง).
}.




แสดงผล เขียน: (1 apple + 3 ส้ม + 4 แอปเปิล), ขึ้นบรรทัดใหม่.


ข้อความ เมื่อ: ['สองครั้ง'] ทำ: { <- ((ตัวเอง เป็นข้อความ) + (ตัวเอง เป็นข้อความ)).
}.



แสดงผล เขียน: ['❤❤❤'] สองครั้ง.



