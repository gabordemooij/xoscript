# test qualifiers

>> $ := ออบเจกต์ สร้างใหม่.

$ เมื่อ: ['ตอบ:'] ทำ: { :x
	
	>> operation := x อักขระ: 0.
	>> valuta := x อักขระ: 1.
	>> money := x ข้าม: 2.
	
	>> amount := 0.

	( operation = ['+'] ) ถ้าจริง: {
		( valuta = ['£'] ) ถ้าจริง: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

แสดงผล เขียน: x, ขึ้นบรรทัดใหม่.


>> Fruit := ออบเจกต์ สร้างใหม่.

Fruit เมื่อ: ['สร้างใหม่'] ทำ: {
	>> f := ตัวเอง สร้างใหม่.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit เมื่อ: ['apples:'] ทำ: { :a ของตน apples := a. }.
Fruit เมื่อ: ['oranges:'] ทำ: { :p ของตน oranges := p. }.
Fruit เมื่อ: ['apples'] ทำ: { <- ของตน apples. }.
Fruit เมื่อ: ['oranges'] ทำ: { <- ของตน oranges. }.

Fruit เมื่อ: ['+'] ทำ: { :f
	
	>> n := Fruit สร้างใหม่.
	f บวก: 1.
	
	n apples: (f apples + ของตน apples).
	n oranges:  (f oranges  + ของตน oranges). <- n.
}.

Fruit เมื่อ: ['เป็นข้อความ'] ทำ: { <- ( ของตน apples เป็นข้อความ + [' apples and '] + ของตน oranges + [' oranges'] ).
}.

ตัวเลข เมื่อ: ['apples'] ทำ: { <- ((Fruit สร้างใหม่) apples: ตัวเอง).
}.

ตัวเลข เมื่อ: ['apple'] ทำ: { <- ((Fruit สร้างใหม่) apples: ตัวเอง).
}.

ตัวเลข เมื่อ: ['oranges'] ทำ: { <- ((Fruit สร้างใหม่) oranges: ตัวเอง).
}.




แสดงผล เขียน: (1 apple + 3 oranges + 4 apples), ขึ้นบรรทัดใหม่.


ข้อความ เมื่อ: ['twice'] ทำ: { <- ((ตัวเอง เป็นข้อความ) + (ตัวเอง เป็นข้อความ)).
}.



แสดงผล เขียน: ['❤❤❤'] twice.



