# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := ตู้นิรภัย 
	แฮชรหัสผ่าน: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := ตู้นิรภัย 
	แฮชรหัสผ่าน: hash ตรวจสอบ: a1.
	# fail 
>> b := ตู้นิรภัย
	แฮชรหัสผ่าน: hash ตรวจสอบ: a2.
	# ok!

แสดงผล เขียน: a, ขึ้นบรรทัดใหม่.
แสดงผล เขียน: b, ขึ้นบรรทัดใหม่.

