# การแฮชรหัสผ่าน
Server init.

# ผู้ใช้ตั้งรหัสผ่าน
>> รหัส := ['pass123'].

# คุณเก็บมันแบบนี้
>> ค่าแฮช := ตู้นิรภัย 
	แฮชรหัสผ่าน: รหัส.

# จากนั้นผู้ใช้เข้าสู่ระบบ
# ครั้งที่ 1
>> a1 := ['abcd123'].
# ครั้งที่ 2
>> a2 := ['pass123'].

# ตรวจสอบ
>> a := ตู้นิรภัย 
	แฮชรหัสผ่าน: ค่าแฮช ตรวจสอบ: a1.
	# ล้มเหลว 
>> b := ตู้นิรภัย
	แฮชรหัสผ่าน: ค่าแฮช ตรวจสอบ: a2.
	# ok!

แสดงผล เขียน: a, ขึ้นบรรทัดใหม่.
แสดงผล เขียน: b, ขึ้นบรรทัดใหม่.

