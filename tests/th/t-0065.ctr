ตัวเลข เมื่อ: ['factorial'] ทำ: {
	>> total := 1.
	{ :index total คูณด้วย: (ตัวเอง - (index)). } × ตัวเอง. <- total.
}.
>> Printer := ออบเจกต์ สร้างใหม่.
Printer เมื่อ: ['print:and:'] ทำ: { :x :y
	แสดงผล เขียน: ['a='] + x + [', b='] + y, ขึ้นบรรทัดใหม่.
}.
>> a := 4.5. >> b := a ปัดลง.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a ปัดขึ้น.
Printer print: a and: b.
a := 4.5. b := a ปัดลง.
Printer print: a and: b.
a := 4.5. b := a ปัดเศษ.
Printer print: a and: b.
a := 4.2. b := a ปัดเศษ.
Printer print: a and: b.

แสดงผล เขียน: (9 เศษหาร: 5), ขึ้นบรรทัดใหม่.
แสดงผล เขียน: -666 ค่าสัมบูรณ์, ขึ้นบรรทัดใหม่.
แสดงผล เขียน: 49 รากที่สอง, ขึ้นบรรทัดใหม่.
แสดงผล เขียน: (2 ยกกำลัง: 3), ขึ้นบรรทัดใหม่.
>> l := (ลิสต์ ← 9 ; 6).
แสดงผล เขียน: l ค่าต่ำสุด.

