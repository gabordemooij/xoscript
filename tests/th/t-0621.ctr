>> phrases := ลิสต์ สร้างใหม่
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases แต่ละตัว: { :_ :phrase 
	>> e := Server base64-เข้ารหัส: phrase.
	>> d := Server base64-ถอดรหัส: e.
	แสดงผล เขียน: (
		message คัดลอก ~encoded: e, ~decoded: d
	), ขึ้นบรรทัดใหม่.
}.
