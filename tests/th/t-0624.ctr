# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := ออบเจกต์ สร้างใหม่.

Log เมื่อ: ['say:'] ทำ: { :str
	แสดงผล เขียน: str, ขึ้นบรรทัดใหม่.
}.

>> Item := ออบเจกต์ สร้างใหม่.

Item เมื่อ: ['สร้างใหม่:'] ทำ: { :id <- ตัวเอง สร้างใหม่ id: id.
}.

Item เมื่อ: ['id:'] ทำ: { :id
	ของตน id := id.
}.

Item เมื่อ: ['id'] ทำ: { <- ของตน id. }.


Item เมื่อ: ['เป็นข้อความ'] ทำ: {
	>> str := ['Item#~no'].
	str ~no: ของตน id. <- str.
}.


>> Print := ออบเจกต์ สร้างใหม่.

Print เมื่อ: ['items'] ทำ: { 
	
	ของตน item := Item สร้างใหม่: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: ของตน item
	).
	
	
}.

Print items.