# ทดสอบนี้ตรวจว่า string_fill_in ไม่สูญเสียช่องของมัน (ถูก gc) ในโหมด 4
# อ้างอิงใน world.c
>> สมุดบันทึก := ออบเจกต์ สร้างใหม่.

สมุดบันทึก เมื่อ: ['say:'] ทำ: { :str
	แสดงผล เขียน: str, ขึ้นบรรทัดใหม่.
}.

>> สิ่งของ := ออบเจกต์ สร้างใหม่.

สิ่งของ เมื่อ: ['สร้างใหม่:'] ทำ: { :id
	<- ตัวเอง สร้างใหม่ id: id.
}.

สิ่งของ เมื่อ: ['id:'] ทำ: { :id
	ของตน id := id.
}.

สิ่งของ เมื่อ: ['id'] ทำ: { <- ของตน id. }.


สิ่งของ เมื่อ: ['เป็นข้อความ'] ทำ: {
	>> str := ['Item#~no'].
	str ~no: ของตน id.
	<- str.
}.


>> Print := ออบเจกต์ สร้างใหม่.

Print เมื่อ: ['items'] ทำ: { 
	
	ของตน ชิ้น := สิ่งของ สร้างใหม่: 1.
	
	# จะเกิด segfault หรือ str ผิดตรงนี้
	สมุดบันทึก say: (
		['~item printed.'] ~item: ของตน ชิ้น
	).
	
	
}.

Print items.