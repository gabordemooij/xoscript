

>> หน่วยความจำที่ใช้1 := 0.
>> หน่วยความจำที่ใช้2 := 0.
>> หน่วยความจำที่ใช้3 := 0.
>> หน่วยความจำที่ใช้4 := 0.

โปรแกรม จัดการหน่วยความจำ: 0.

ตัวเลข เมื่อ: ['addNum:'] ทำ: { :x
	ตัวเอง บวก: x.
}.

ตัวเลข เมื่อ: ['subtractNum:'] ทำ: { :x
	ตัวเอง ลบออก: x.
}.

ตัวเลข เมื่อ: ['multiplyBy:'] ทำ: { :x
	ตัวเอง คูณด้วย: x.
}.

ตัวเลข เมื่อ: ['divideBy:'] ทำ: { :x
	ตัวเอง หารด้วย: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 ยกกำลัง: 8).  
a := a + (2 ยกกำลัง: -1). 
a := a + (49 รากที่สอง).   
a addNum: ((ลิสต์ ← 0 ; 1) ค่าสูงสุด).          
a addNum: ((ลิสต์ ← 2 ; 3) ค่าต่ำสุด).
แสดงผล เขียน: a.

โปรแกรม เก็บกวาด.

หน่วยความจำที่ใช้1 := (โปรแกรม หน่วยความจำ ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 ยกกำลัง: 8).  
a := a + (2 ยกกำลัง: -1). 
a := a + (49 รากที่สอง).   
a addNum: ((ลิสต์ ← 0 ; 1) ค่าสูงสุด).          
a addNum: ((ลิสต์ ← 2 ; 3) ค่าต่ำสุด).
แสดงผล เขียน: a.

โปรแกรม เก็บกวาด.
หน่วยความจำที่ใช้2 := (โปรแกรม หน่วยความจำ ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 ยกกำลัง: 8).  
a := a + (2 ยกกำลัง: -1). 
a := a + (49 รากที่สอง).   
a addNum: ((ลิสต์ ← 0 ; 1) ค่าสูงสุด).          
a addNum: ((ลิสต์ ← 2 ; 3) ค่าต่ำสุด).
แสดงผล เขียน: a.

โปรแกรม เก็บกวาด.
หน่วยความจำที่ใช้3 := (โปรแกรม หน่วยความจำ ? 0).



( หน่วยความจำที่ใช้1 = หน่วยความจำที่ใช้2 และ: หน่วยความจำที่ใช้1 = หน่วยความจำที่ใช้3, และ: หน่วยความจำที่ใช้2 = หน่วยความจำที่ใช้3 ) ถ้าจริง: {
	แสดงผล เขียน: ['ไม่มีหน่วยความจำรั่วที่นี่'].
}, ถ้าเท็จ: {
	แสดงผล เขียน: ['หน่วยความจำรั่ว...'].
}.
