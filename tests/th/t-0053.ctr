60 × {
	>> x := (ตัวเลข random % 6) + 1.
	(x ≤ 6) ถ้าเท็จ: { แสดงผล เขียน: ['FAIL']. }.
	(x ≥0) ถ้าเท็จ: { แสดงผล เขียน: ['FAIL']. }.
	x := (ตัวเลข random % 3) + 1.
	(x < 3) ถ้าเท็จ: { แสดงผล เขียน: ['FAIL']. }.
	(x>-1) ถ้าเท็จ: { แสดงผล เขียน: ['FAIL']. }.
	x := ((บูลีน flip) เป็นตัวเลข).
	(x = 0 หรือ: x = 1) ถ้าเท็จ: { แสดงผล เขียน: ['FAIL']. }.
	x := ((จริง flip) เป็นตัวเลข).
	(x = 0 หรือ: x = 1) ถ้าเท็จ: { แสดงผล เขียน: ['FAIL']. }.
	x := (บูลีน flip เลือก: ['HEAD'] หรือ: ['TAIL']).
	((x = ['HEAD']) หรือ: (x = ['TAIL'])) ถ้าเท็จ: { แสดงผล เขียน: ['FAIL']. }.
}.
แสดงผล เขียน: ['DONE'].

