60 × {
	>> x := (ตัวเลข สุ่มค่า % 6) + 1.
	(x ≤ 6) ถ้าเท็จ: { แสดงผล เขียน: ['ล้มเหลว']. }.
	(x ≥0) ถ้าเท็จ: { แสดงผล เขียน: ['ล้มเหลว']. }.
	x := (ตัวเลข สุ่มค่า % 3) + 1.
	(x < 3) ถ้าเท็จ: { แสดงผล เขียน: ['ล้มเหลว']. }.
	(x>-1) ถ้าเท็จ: { แสดงผล เขียน: ['ล้มเหลว']. }.
	x := ((บูลีน โยนเหรียญ) เป็นตัวเลข).
	(x = 0 หรือ: x = 1) ถ้าเท็จ: { แสดงผล เขียน: ['ล้มเหลว']. }.
	x := ((จริง โยนเหรียญ) เป็นตัวเลข).
	(x = 0 หรือ: x = 1) ถ้าเท็จ: { แสดงผล เขียน: ['ล้มเหลว']. }.
	x := (บูลีน โยนเหรียญ เลือก: ['หัว'] หรือ: ['ก้อย']).
	((x = ['หัว']) หรือ: (x = ['ก้อย'])) ถ้าเท็จ: { แสดงผล เขียน: ['ล้มเหลว']. }.
}.
แสดงผล เขียน: ['เสร็จแล้ว'].

