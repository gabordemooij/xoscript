# กรณีปกติ
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> เส้นทาง := ['/tmp/dat.csv'].
>> csv := ไฟล์ สร้างใหม่: เส้นทาง.
csv เขียน: s.

# รับ CRLF LF CR และความยาวแถวที่ต่างกันได้
csv ตัวคั่น: [';'] อัญประกาศ: ['"'] ทีละบรรทัด: { :line
	โปรแกรม เก็บกวาด.
	แสดงผล เขียน: line, ขึ้นบรรทัดใหม่.
	โปรแกรม เก็บกวาด.
}.

# บรรทัดไม่เท่ากัน
s ต่อท้าย: ['\njustone'].
csv เขียน: s.
{
	csv ตัวคั่น: [';'] อัญประกาศ: ['"'] ทีละบรรทัด: { :line
		แสดงผล เขียน: line, ขึ้นบรรทัดใหม่.
	}.
} ดักจับ: { :e 
	แสดงผล เขียน: e, ขึ้นบรรทัดใหม่.
}, เริ่ม.

# รูปแบบไม่ถูกต้อง
s := ['"he"llo";world'].
csv เขียน: s.
{
	csv ตัวคั่น: [';'] อัญประกาศ: ['"'] ทีละบรรทัด: { :line
		แสดงผล เขียน: line, ขึ้นบรรทัดใหม่.
	}.
} ดักจับ: { :e 
	แสดงผล เขียน: e, ขึ้นบรรทัดใหม่.
}, เริ่ม.
