Server init.

>> DB := Maria-DB สร้างใหม่ โฮสต์: ['localhost'],
	ชื่อผู้ใช้: ['xo'],
	รหัสผ่าน: ['pass123'],
	ชื่อฐานข้อมูล: ['xobase'],
	เชื่อมต่อ.

{
	DB คิวรี:
	['DROP TABLE movies'],
	ดำเนินการ.
} ดักจับ: { ว่าง. }, เริ่ม.

DB คิวรี:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
ดำเนินการ.

DB คิวรี: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
พารามิเตอร์: ( ลิสต์ สร้างใหม่ ; ['Halloween'] ),
ดำเนินการ.

DB คิวรี: ['SELECT * FROM movies'],
ดึงข้อมูล: { :movie
	แสดงผล เขียน: movie title, ขึ้นบรรทัดใหม่.
}.

