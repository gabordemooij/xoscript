>> t := จริง.
(t = จริง) ถ้าจริง: { แสดงผล เขียน: ['T']. }.
(t = เท็จ) ถ้าจริง: { แสดงผล เขียน: ['F']. }.
แสดงผล เขียน: ['|'].
>> t := เท็จ.
(t = จริง) ถ้าจริง: { แสดงผล เขียน: ['T']. }.
(t = เท็จ) ถ้าจริง: { แสดงผล เขียน: ['F']. }.
แสดงผล เขียน: ['|'].
>> f := จริง.
(t = จริง และ: f = เท็จ) ถ้าจริง: { แสดงผล เขียน: ['T']. }.
(t = เท็จ และ: f = จริง) ถ้าจริง: { แสดงผล เขียน: ['F']. }.
แสดงผล เขียน: ['|'].
>> n := ว่าง.
(n ว่างไหม?) ถ้าจริง: { แสดงผล เขียน: ['T']. }.
(n ว่างไหม?) ถ้าเท็จ: { แสดงผล เขียน: ['F']. }.
แสดงผล เขียน: ['|'].
(f Boolean?) ถ้าจริง: { แสดงผล เขียน: ['T']. }.
(f Boolean?) ถ้าเท็จ: { แสดงผล เขียน: ['F']. }.



