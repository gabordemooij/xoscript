# test catch-all methods
>> x13 := ออบเจกต์ สร้างใหม่.
x13 เมื่อ: ['a'] ทำ: { :a แสดงผล เขียน: 0, ขึ้นบรรทัดใหม่. }.
x13 เมื่อ: ['a:'] ทำ: { :a แสดงผล เขียน: a, ขึ้นบรรทัดใหม่. <- 5. }.
x13 เมื่อ: ['a:b:'] ทำ: { :a :b แสดงผล เขียน: (a + b), ขึ้นบรรทัดใหม่. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
