# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob สร้างใหม่: 8, bytes: (
	ลิสต์ สร้างใหม่ ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

แสดงผล เขียน: ( utf16 ถอดรหัส: ['utf16le'] ), ขึ้นบรรทัดใหม่.

utf16 คืนหน่วยความจำ.
>> utf32 := Blob สร้างใหม่: 13, bytes: (
	ลิสต์ สร้างใหม่ ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

แสดงผล เขียน: ( utf32 ถอดรหัส: ['utf32be'] ), ขึ้นบรรทัดใหม่.
utf32 คืนหน่วยความจำ.