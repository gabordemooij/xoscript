>> HTML := ออบเจกต์ สร้างใหม่.
HTML เมื่อ: ['ตอบ:'] ทำ: { :tag 
	แสดงผล เขียน: (['<tag>'] tag: tag), ขึ้นบรรทัดใหม่.
}.
HTML เมื่อ: ['ตอบ:และ:'] ทำ: { :tag :html 
	แสดงผล เขียน: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), ขึ้นบรรทัดใหม่.
}.
>> html := HTML สร้างใหม่.
html body h1: ['header'].

