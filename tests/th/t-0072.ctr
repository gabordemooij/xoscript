>> echo := ออบเจกต์ สร้างใหม่.
echo เมื่อ: ['ตอบ:'] ทำ: { :sound
	{ แสดงผล เขียน: sound. } × 2.
}.
echo ho!. 


echo := ออบเจกต์ สร้างใหม่.
echo เมื่อ: ['ตอบ:และ:'] ทำ: { :sound :x
	{ แสดงผล เขียน: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := ออบเจกต์ สร้างใหม่.
echo เมื่อ: ['ตอบ:และ:และ:'] ทำ: { :operation :sound :x
	{ แสดงผล เขียน: sound. } × x.
}.
echo shout: ['la'] times: 4. 


