>> Greeter := ออบเจกต์ สร้างใหม่.
Greeter เมื่อ: ['make'] ทำ: {
	>> gr := ออบเจกต์ สร้างใหม่.
	gr เมื่อ: ['setName:'] ทำ: { :aname
		ของตน ชื่อ := aname.
	}.
	gr เมื่อ: ['greet'] ทำ: {
		แสดงผล เขียน: ของตน ชื่อ.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a สร้างใหม่.
c setName: ['THREE'].
c greet.
>> d := a สร้างใหม่.
d setName: ['FOUR'].
d greet.
c greet.
