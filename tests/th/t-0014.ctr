>> ผู้ทักทาย := ออบเจกต์ สร้างใหม่.
ผู้ทักทาย เมื่อ: ['สร้างตัว'] ทำ: {
	>> ทท := ออบเจกต์ สร้างใหม่.
	ทท เมื่อ: ['setName:'] ทำ: { :ชื่อหนึ่ง
		ของตน ชื่อ := ชื่อหนึ่ง.
	}.
	ทท เมื่อ: ['ทักทาย'] ทำ: {
		แสดงผล เขียน: ของตน ชื่อ.
	}. <- ทท.
}.
>> a := ผู้ทักทาย สร้างตัว.
>> b := ผู้ทักทาย สร้างตัว.
a setName: ['ONE'].
b setName: ['สอง'].
a ทักทาย.
b ทักทาย.
>> c := a สร้างใหม่.
c setName: ['สาม'].
c ทักทาย.
>> d := a สร้างใหม่.
d setName: ['FOUR'].
d ทักทาย.
c ทักทาย.
