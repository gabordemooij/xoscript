>> map1 := พจนานุกรม สร้างใหม่.
>> key1 := ลิสต์ สร้างใหม่.
>> key2 := ลิสต์ สร้างใหม่.

map1
	ใส่: ['hello'] ที่: key1,
	ใส่: ['world'] ที่: key2.


แสดงผล
	เขียน: ['Map #1 contains: '] + (map1 ที่: key1),
	เขียน: [' and '] + (map1 ที่: key2), ขึ้นบรรทัดใหม่.

>> KeyeableArray := ลิสต์ สร้างใหม่.
KeyeableArray เมื่อ: ['toString'] ทำ: { <- (ตัวเอง จำนวน) toString.
}.

>> map2 := พจนานุกรม สร้างใหม่.
key1 := KeyeableArray สร้างใหม่.
key2 := KeyeableArray สร้างใหม่.

key1 ต่อท้าย: 1.

map2
	ใส่: ['hello'] ที่: key1,
	ใส่: ['world'] ที่: key2.

แสดงผล
	เขียน: ['Map #2 contains: '] + (map2 ที่: key1),
	เขียน: [' and '] + (map2 ที่: key2), ขึ้นบรรทัดใหม่.
