#Linux
>> OS := โปรแกรม ระบบ: (คำสั่ง uname -s), ตัดช่องว่าง.

>> Slurp := ออบเจกต์ สร้างใหม่.
Slurp เมื่อ: ['สร้างใหม่'] ทำ: {
	ของตน str := [''].
}.
Slurp เมื่อ: ['ตอบ:'] ทำ: { :blah
		(ของตน str ≠ ['']) ถ้าจริง: {
			ของตน str ต่อท้าย: [' '].
		}.
		ของตน str ต่อท้าย: blah.
}.
Slurp เมื่อ: ['ตอบ:และ:'] ทำ: { :blah :blahah
		(ของตน str ≠ ['']) ถ้าจริง: {
			ของตน str ต่อท้าย: [' '].
		}.
		(blah ความยาว > 1) ถ้าจริง: {
			ของตน str ต่อท้าย: (blah เริ่มที่: 0 ความยาว: (blah ความยาว - 1)).
		}, มิฉะนั้น: {
			ของตน str ต่อท้าย: blah.
		}.
		ของตน str ต่อท้าย: [' '].
		ของตน str ต่อท้าย: blahah.
}.
Slurp เมื่อ: ['รับมา'] ทำ: {
	>> บัฟเฟอร์ := ของตน str.
	ของตน str := ['']. <- บัฟเฟอร์.
}.
>> large text := [''].
{
	large text ต่อท้าย: ['hello'].
} × 1000.


แสดงผล เขียน: (
	โปรแกรม ระบบ: (
		Slurp สร้างใหม่
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) รับมา
).

