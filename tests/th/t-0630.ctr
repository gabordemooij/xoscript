#ทดสอบ regex
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> รูปแบบค้นหา := แพตเทิร์น สร้างใหม่: ['href="([^"]+)" target="([^"]+)"'].
>> ผลที่ได้  := รูปแบบค้นหา ตรงกับ: subject ทำ: { :m :x
	แสดงผล เขียน: m, ขึ้นบรรทัดใหม่.
	แสดงผล เขียน: x, ขึ้นบรรทัดใหม่.
	<- ['XXX'].
}.
แสดงผล เขียน: ผลที่ได้, ขึ้นบรรทัดใหม่.