#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := แพตเทิร์น สร้างใหม่: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern ตรงกับ: subject ทำ: { :m :x
	แสดงผล เขียน: m, ขึ้นบรรทัดใหม่.
	แสดงผล เขียน: x, ขึ้นบรรทัดใหม่. <- ['XXX'].
}.
แสดงผล เขียน: result, ขึ้นบรรทัดใหม่.