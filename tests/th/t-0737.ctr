#ทดสอบ regex ด้วย positive look around
Server init.
>> subject := ['bacabcca'].
>> รูปแบบค้นหา := แพตเทิร์น สร้างใหม่: ['(\\w{2})(?=ca)'].
>> ผลที่ได้  := รูปแบบค้นหา ตรงกับ: subject ทำ: { :m :x
	แสดงผล เขียน: m, ขึ้นบรรทัดใหม่.
	แสดงผล เขียน: x, ขึ้นบรรทัดใหม่.
	<- ['XXX'].
}.
แสดงผล เขียน: ผลที่ได้, ขึ้นบรรทัดใหม่.
