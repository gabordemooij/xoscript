>> Slurp := ออบเจกต์ สร้างใหม่.
Slurp เมื่อ: ['สร้างใหม่'] ทำ: {
	ของตน str := [''].
}.
Slurp เรียนรู้: ['nieuw'] หมายถึง: ['สร้างใหม่'].
Slurp เมื่อ: ['ตอบ:'] ทำ: { :blah
		(ของตน str ≠ ['']) ถ้าจริง: {
			ของตน str ต่อท้าย: [' '].
		}.
		ของตน str ต่อท้าย: blah.
}.
Slurp เมื่อ: ['ตอบ:และ:'] ทำ: { :blah :blahah
		(ของตน str ≠ ['']) ถ้าจริง: {
			ของตน str ต่อท้าย: [' '].
		}.
		(blah ความยาว > 1) ถ้าจริง: {
			ของตน str ต่อท้าย: (blah เริ่มที่: 0 ความยาว: (blah ความยาว - 1)).
		}, มิฉะนั้น: {
			ของตน str ต่อท้าย: blah.
		}.
		ของตน str ต่อท้าย: [' '].
		ของตน str ต่อท้าย: blahah.
}.
Slurp เมื่อ: ['รับมา'] ทำ: {
	>> บัฟเฟอร์ := ของตน str.
	ของตน str := ['']. <- บัฟเฟอร์.
}.


>> พารามิเตอร์ค้นหา := Slurp สร้างใหม่
	select: ['*'],
	from
		ผู้ใช้ต่างๆ 
	where 
		user_id=: 1.

แสดงผล เขียน: พารามิเตอร์ค้นหา รับมา, ขึ้นบรรทัดใหม่.
