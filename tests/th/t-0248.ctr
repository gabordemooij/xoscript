

ข้อความ เมื่อ: ['evaluate'] ทำ: {
	>> โค้ด := ไฟล์ สร้างใหม่: ['/tmp/eval.ctr'].
	โค้ด เขียน: ตัวเอง เป็นข้อความ + ['.'].
	โปรแกรม ใช้: ['/tmp/eval.ctr'].
}.

>> a := (ลิสต์ ← (
	(พจนานุกรม สร้างใหม่)
		ใส่: ['domain'] ที่: ['mywebsite.com'],
		ใส่: (ลิสต์ ←
			((พจนานุกรม สร้างใหม่)
				ใส่: ['home'] ที่: ['title'],
				ใส่: ['<html></html>'] ที่: ['body'],
				ใส่: ['2017-01-01'] ที่: ['created']
			) ;
			((พจนานุกรม สร้างใหม่)
				ใส่: ['aboutus(c)'] ที่: ['title'],
				ใส่: ['<credits>Author Inc.</credits>'] ที่: ['body']
			)
		) ที่: ['pages']
	)
) เป็นข้อความ.

แสดงผล เขียน: a ชนิด, ขึ้นบรรทัดใหม่.
แสดงผล เขียน: a, ขึ้นบรรทัดใหม่.

>> b := ว่าง.
(['b := '] + a) evaluate.
แสดงผล เขียน: b ? 0 ? ['pages'] ? 1 ? ['body'], ขึ้นบรรทัดใหม่.

>> c := b ? 0.
>> d := c เป็นข้อความ.
แสดงผล เขียน: d ชนิด, ขึ้นบรรทัดใหม่.

>> e := ว่าง.
(['e := '] + d) evaluate.
แสดงผล เขียน: e ? ['pages'] ? 0, ขึ้นบรรทัดใหม่.
