

>> g  := Server สร้างใหม่.
>> v  := ตู้นิรภัย สร้างใหม่.
>> ok := 0.

>> ความลับต่างๆ := ลิสต์ สร้างใหม่ ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> รหัสผ่านต่างๆ := ความลับต่างๆ คัดลอก.
รหัสผ่านต่างๆ แต่ละตัว: { :i :p
	ความลับต่างๆ แต่ละตัว: { :n :s
		{
			>> ที่เข้ารหัส := v เข้ารหัสลับ: s กุญแจ: p.
			>> ที่ถอดรหัส := v ถอดรหัสลับ: ที่เข้ารหัส กุญแจ: p.
			(ที่ถอดรหัส = s) ถ้าจริง: {
				ok บวก: 1.
			}, มิฉะนั้น: {
				แสดงผล เขียน: ['เข้ารหัส/ถอดรหัสล้มเหลว: '], ขึ้นบรรทัดใหม่.
				แสดงผล เขียน: s, ขึ้นบรรทัดใหม่.
				แสดงผล เขียน: ['เข้ารหัสแล้ว: '] + ที่เข้ารหัส, ขึ้นบรรทัดใหม่.
				แสดงผล เขียน: ['ถอดรหัสแล้ว: '] + ที่เข้ารหัส, ขึ้นบรรทัดใหม่.
				โปรแกรม จบ.
			}.
		} ดักจับ: { :ผิดพลาด
			(s = [''] หรือ: p = ['']) ถ้าจริง: {
				ok บวก: 1.
			}, มิฉะนั้น: {
				แสดงผล เขียน: ผิดพลาด, ขึ้นบรรทัดใหม่.
				โปรแกรม จบ.
			}.
		}, เริ่ม.
	}.
}.

แสดงผล เขียน: ( ok + [' การเข้ารหัสตู้เซฟถูกทดสอบ.'] ), ขึ้นบรรทัดใหม่.