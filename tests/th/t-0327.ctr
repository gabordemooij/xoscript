>> x := ว่าง.
{

	x := ['hello'] 
	แทนที่:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] อักขระ: 2)
			)
		)
	ด้วย: (
		(['...hal'] + ['lo']) 
			ตัวพิมพ์ใหญ่ 
			ตัวพิมพ์เล็กผิด 
			ตัวพิมพ์ใหญ่ 
			ข้าม: -1 + ( 
				11 - 12 + (
					(
						(
							(
								ลิสต์ ← 0 ; 1 ; 4; 9 ; (ลิสต์ ← 0 ; 3; 1) ; 4
							) ตัวรองสุดท้าย
						) ? 1
					) + 
					((ลิสต์ ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					จำนวน
				)
			)
	).

} × 10.
