# test qualifiers

โปรแกรม เก็บกวาด.

>> Fruit := ออบเจกต์ สร้างใหม่.
Fruit เมื่อ: ['สร้างใหม่'] ทำ: {
	>> f := ตัวเอง สร้างใหม่.
	f apples: 0. <- f.
}.
Fruit เมื่อ: ['apples:'] ทำ: { :a ของตน apples := a. }.
Fruit เมื่อ: ['apples'] ทำ: { <- ของตน apples. }.
Fruit เมื่อ: ['+'] ทำ: { :f
	>> n := Fruit สร้างใหม่.
	n apples: (f apples + ของตน apples). <- n.
}.
ตัวเลข เมื่อ: ['apples'] ทำ: { <- ((Fruit สร้างใหม่) apples: ตัวเอง).
}.

Fruit เมื่อ: ['เป็นข้อความ'] ทำ: { <- ของตน apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
แสดงผล เขียน: q, ขึ้นบรรทัดใหม่.




q := 3 apples + 4 apples.
แสดงผล เขียน: q, ขึ้นบรรทัดใหม่.



q := 3 apples + 4 apples.
แสดงผล เขียน: q, ขึ้นบรรทัดใหม่.


