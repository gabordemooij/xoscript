# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := ตู้นิรภัย สร้างกุญแจ.

# private (secret) key
>> sk := keys ตัวแรก.

# public key
>> pk := keys ตัวสุดท้าย.

# sign a message
>> sig := ตู้นิรภัย ลงนาม: ['abc'] ด้วย: sk.

# check message (ok)
แสดงผล เขียน: ( 
	ตู้นิรภัย
		ตรวจ: ['abc'] 
		ลายเซ็น: sig 
		ด้วย: pk 
), ขึ้นบรรทัดใหม่.

# check message (fail)
แสดงผล เขียน: ( 
	ตู้นิรภัย 
		ตรวจ: ['abd'] 
		ลายเซ็น: sig 
		ด้วย: pk 
), ขึ้นบรรทัดใหม่.