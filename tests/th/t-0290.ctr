# test list operations


>> cakes := ลิสต์ ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes แทนที่: 1 ความยาว: 2 ด้วย: ( ลิสต์ ← ['cinnamon'] ; ['pineapple'] ).
แสดงผล เขียน: (buy รวม: [',']), ขึ้นบรรทัดใหม่.


>> buy := cakes แทนที่: 1 ความยาว: 12 ด้วย: ( ลิสต์ ← ['cinnamon'] ; ['pineapple'] ).
แสดงผล เขียน: (buy รวม: [',']), ขึ้นบรรทัดใหม่.


>> buy := cakes แทนที่: 2 ความยาว: 10 ด้วย: ( ลิสต์ สร้างใหม่ ).
แสดงผล เขียน: (buy รวม: [',']), ขึ้นบรรทัดใหม่.


>> buy := cakes แทนที่: 0 ความยาว: 1 ด้วย: ( ลิสต์ สร้างใหม่ ).
แสดงผล เขียน: (buy รวม: [',']), ขึ้นบรรทัดใหม่.


>> buy := cakes แทนที่: ['0'] ความยาว: ['1'] ด้วย: ['x'].
แสดงผล เขียน: (buy รวม: [',']), ขึ้นบรรทัดใหม่.
