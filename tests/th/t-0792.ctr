Server init.

>> DB := Maria-DB สร้างใหม่ โฮสต์: ['localhost'],
	ชื่อผู้ใช้: ['xo'],
	รหัสผ่าน: ['pass123'],
	ชื่อฐานข้อมูล: ['xobase'],
	เชื่อมต่อ.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB คิวรี: SQL.

# now you don't have to set DB
query2 ดึงข้อมูล: { :row
	แสดงผล เขียน: row world, ขึ้นบรรทัดใหม่.
}.
