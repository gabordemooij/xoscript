
>> Size := ออบเจกต์ สร้างใหม่.
Size เมื่อ: ['is:'] ทำ: { :เป็นตัวเลข
	เป็นตัวเลข เมื่อ: ['+'] ทำ: { :เป็นตัวเลข
		>> unit := เป็นตัวเลข หน่วย.
		>> factor := 1.
		
		unit
		กรณี: ['inch'] ทำ: { factor := 0.0833. }. <- ตัวเอง + (เป็นตัวเลข * factor).
	}. <- เป็นตัวเลข.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
แสดงผล เขียน: plank + edge, ขึ้นบรรทัดใหม่.
