

ข้อความ เมื่อ: ['ประเมินผล'] ทำ: {
	>> โค้ด := ไฟล์ สร้างใหม่: ['/tmp/eval.ctr'].
	โค้ด เขียน: (ตัวเอง เป็นข้อความ + ['.']).
	โปรแกรม ใช้: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := ลิสต์ ← (['เครื่องหมายคำพูด '] + Q + [' ชั่วร้ายไหม?']) ; 1.
>> x := q เป็นข้อความ.
แสดงผล เขียน: x, ขึ้นบรรทัดใหม่.
>> y := ว่าง.
(['y := '] + x ) ประเมินผล.
แสดงผล เขียน: y ? 0, ขึ้นบรรทัดใหม่.

q := พจนานุกรม ใส่: ['\[''] ที่: ['\['quote\']'].
x := q เป็นข้อความ.
แสดงผล เขียน: x, ขึ้นบรรทัดใหม่.
y := ว่าง.
(['y := '] + x ) ประเมินผล.

>> q := (พจนานุกรม สร้างใหม่) ใส่:['\[''] ที่:['\['quote\[''].
แสดงผล เขียน: y ? ['\['quote\']'], ขึ้นบรรทัดใหม่.
