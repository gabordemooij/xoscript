>> t := ว่าง.

# you can control the time zone for
# parsing like this:
ช่วงเวลา เขตเวลา: ['CET'].
t := ช่วงเวลา จาก: ['1981-02-03 04:05:06'].
แสดงผล เขียน: t, ขึ้นบรรทัดใหม่.

# now using CEST time zone:
ช่วงเวลา เขตเวลา: ['CEST'].
t := ช่วงเวลา จาก: ['1981-02-03 04:05:06'].
แสดงผล เขียน: t, ขึ้นบรรทัดใหม่.

# error if string cannot be parsed
{ ช่วงเวลา จาก: ['1900']. } ดักจับ: { ว่าง. }, เริ่ม.
