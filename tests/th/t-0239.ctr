ลิสต์ เมื่อ: ['ผลบวก'] ทำ: {
	>> ผลรวม := 0.
	ตัวเอง แต่ละตัว: { :ลำดับที่ :สมาชิก
		ผลรวม บวก: สมาชิก.
	}. <- ผลรวม.
}.

>> a := จริง.



a เมื่อ: ['เป็นข้อความ'] ทำ: {
	>> คำตอบ := ว่าง.
	( ตัวเอง = จริง ) ถ้าจริง: {
		คำตอบ := ['ใช่เลย'].
	}, มิฉะนั้น: {
		คำตอบ := ['ไม่เลย'].
	}. <- คำตอบ.
}.

a เมื่อ: ['เป็นตัวเลข'] ทำ: {
	>> คำตอบ := ว่าง.
	( ตัวเอง = จริง ) ถ้าจริง: {
		คำตอบ := 10.
	}, มิฉะนั้น: {
		คำตอบ := 20.
	}. <- คำตอบ.
}.

>> b := 666.

b เมื่อ: ['เป็นข้อความ'] ทำ: { <- ['ปีศาจ'].
}.

b เมื่อ: ['เป็นบูลีน'] ทำ: { <- เท็จ.
}.


แสดงผล เขียน: a, ขึ้นบรรทัดใหม่.  
แสดงผล เขียน: (90 + a), ขึ้นบรรทัดใหม่. 
แสดงผล เขียน: b, ขึ้นบรรทัดใหม่. 
แสดงผล เขียน: (จริง และ: b), ขึ้นบรรทัดใหม่.

