>> randomizer := { :a :b
	>> ค่าต่ำสุด := ( a < b ) เลือก: a หรือ: b.
	>> ค่าสูงสุด := ( a > b ) เลือก: a หรือ: b.
	>> x := ว่าง.
	{
		x := ตัวเลข ระหว่าง: a ถึง: b.
		((x < ค่าต่ำสุด) หรือ: (x > ค่าสูงสุด)) ถ้าจริง: { 
			แสดงผล เขียน: (['Invalid value!']).
			โปรแกรม จบ.
		}.
	} 
	× 100. <- x.
}.
