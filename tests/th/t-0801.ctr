Server init.

>> db := Maria-DB สร้างใหม่ โฮสต์: ['localhost'],
	ชื่อผู้ใช้: ['xo'],
	รหัสผ่าน: ['pass123'],
	ชื่อฐานข้อมูล: ['xobase'],
	เชื่อมต่อ.

>> del := db คิวรี: ['DELETE FROM book WHERE id > 0'].
{  del ดำเนินการ. db คอมมิต. } ดักจับ: { :e db ย้อนกลับ.  }, เริ่ม.

>> จำนวน := db คิวรี: ['SELECT COUNT(*) AS num FROM book'].
จำนวน ดึงข้อมูล: { :row แสดงผล เขียน: row num, ขึ้นบรรทัดใหม่. }.
