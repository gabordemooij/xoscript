
>> dictionary := (
	พจนานุกรม สร้างใหม่
		ใส่: ['b'] ที่: ['a'],
		ใส่: ['a'] ที่: ['b'],
		ใส่: ['z'] ที่: ['x'],
		ใส่: ['hello'] ที่: ['hallo'],
		ใส่: ['human'] ที่: ['human']
).

>> comparisons := ลิสต์ สร้างใหม่.
dictionary แต่ละตัว: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a เปรียบเทียบ: b)
	).
}.

comparisons เรียงลำดับ: { :a :b <- ( a เปรียบเทียบ: b ). }.
แสดงผล เขียน: ( comparisons รวม: ['↵'] ), ขึ้นบรรทัดใหม่.
comparisons รวม: ['↵'].
