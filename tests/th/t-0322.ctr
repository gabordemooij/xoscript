

>> Matryoshka := ออบเจกต์ สร้างใหม่.
Matryoshka เมื่อ: ['double:'] ทำ: { :secret
	ของตน secret := secret × 2.
}.
Matryoshka เมื่อ: ['สร้างใหม่:'] ทำ: { :secret
	>> answer := ว่าง.
	>> t := (secret > 255).
	แสดงผล เขียน: (secret + [' | '] + t), ขึ้นบรรทัดใหม่.
	t ถ้าจริง: {
		answer := secret.
	}, มิฉะนั้น: {
		answer := Matryoshka เรียกซ้ำ สร้างใหม่: (ตัวเอง double: secret).
	}. <- answer.
}.

>> x := Matryoshka สร้างใหม่: 2.
