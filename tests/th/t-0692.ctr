Server init.

แสดงผล เขียน: (
	แพตเทิร์น สร้างใหม่: ['^\\w+$'],
	ตรงกับ: ['test@example.com'] 
), ขึ้นบรรทัดใหม่. # 0 match, fails on @ and .

แสดงผล เขียน: (
	แพตเทิร์น สร้างใหม่: ['^[^@]+@[^\.]+\.\\w+$'],
	ตรงกับ: ['test@example.com'] 
), ขึ้นบรรทัดใหม่. # 1 match

แสดงผล เขียน: (
	แพตเทิร์น สร้างใหม่: ['[^@]+@[^\.]+\.\\w+'],
	ตรงกับ: ['test@example.com'] 
), ขึ้นบรรทัดใหม่. # 1 match

แสดงผล เขียน: (
	แพตเทิร์น สร้างใหม่: ['([^@]+)@([^\.]+)\.\\w+'],
	ตรงกับ: ['test@example.com'] 
), ขึ้นบรรทัดใหม่. # 1 match, groups dont matter

แสดงผล เขียน: (
	แพตเทิร์น สร้างใหม่: ['[a-z]'],
	ตรงกับ: ['test@example.com'] 
), ขึ้นบรรทัดใหม่. # 14 matches

แสดงผล เขียน: (
	แพตเทิร์น สร้างใหม่: ['.*'],
	ตรงกับ: ['test@example.com'] 
), ขึ้นบรรทัดใหม่. # 1 match (all)

แสดงผล เขียน: (
	แพตเทิร์น สร้างใหม่: ['(.*)'],
	ตรงกับ: ['test@example.com'] 
), ขึ้นบรรทัดใหม่. # 1 match (all)

แสดงผล เขียน: (
	แพตเทิร์น สร้างใหม่: ['\\s*[^@]+@[^\.]+\.\\w+'],
	ตรงกับ: ['test@example.com'] 
), ขึ้นบรรทัดใหม่. # 1 match, prefix space optional, gets ignored