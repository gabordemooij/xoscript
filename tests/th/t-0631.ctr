#ffi test


Server init.

โปรแกรม จัดการหน่วยความจำ: 4.

# for this test you need set a path to libc (puts)
>> libname := โปรแกรม การตั้งค่า: ['FFITESTLIB'].



Server เชื่อมโยง: (
 ลิสต์ สร้างใหม่ ;
 libname ;
 ['puts'] ;
 ( ลิสต์ สร้างใหม่ ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s คืนหน่วยความจำ.

# test with struct

>> a := Blob สร้างใหม่: 8.
a bytes: (
	ลิสต์ <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (ลิสต์ <<: ['int'], ; ['int']).

Server เชื่อมโยง: (
	ลิสต์ <<: ['@structtest'], ;
	['@structtest'] ;
	(ลิสต์ <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
แสดงผล เขียน: ['Sum test:'] + (ffitest ffisum: a), ขึ้นบรรทัดใหม่.

struct struct-คืนหน่วยความจำ.
struct คืนหน่วยความจำ.
a คืนหน่วยความจำ.
