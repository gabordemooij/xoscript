#ทดสอบ ffi


Server init.

โปรแกรม จัดการหน่วยความจำ: 4.

# สำหรับการทดสอบนี้ต้องตั้งเส้นทางไปยัง libc (puts)
>> ชื่อไลบรารี := โปรแกรม การตั้งค่า: ['FFITESTLIB'].



Server เชื่อมโยง: (
 ลิสต์ สร้างใหม่ ;
 ชื่อไลบรารี ;
 ['puts'] ;
 ( ลิสต์ สร้างใหม่ ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s คืนหน่วยความจำ.

# ทดสอบกับ struct

>> a := Blob สร้างใหม่: 8.
a bytes: (
	ลิสต์ <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> โครงสร้าง := Blob struct: (ลิสต์ <<: ['int'], ; ['int']).

Server เชื่อมโยง: (
	ลิสต์ <<: ['@structtest'], ;
	['@structtest'] ;
	(ลิสต์ <<: โครงสร้าง) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
แสดงผล เขียน: ['ทดสอบผลบวก:'] + (ffitest ffisum: a), ขึ้นบรรทัดใหม่.

โครงสร้าง struct-คืนหน่วยความจำ.
โครงสร้าง คืนหน่วยความจำ.
a คืนหน่วยความจำ.
