# ทดสอบตัวทำความสะอาด utf8
Server init.

>> กรณีutf8 := พจนานุกรม สร้างใหม่
	# ASCII เท่านั้น
	ใส่: ( ลิสต์ สร้างใหม่ ; 65 ; 65 ; 65 ; 65 ; 0 ) ที่: ['AAAA'],
	# ลำดับ 2 ไบต์ที่ถูกต้อง
	ใส่: ( ลิสต์ สร้างใหม่ ; 194 ; 162 ; 0 ) ที่: ['¢'],
	# UTF-8 3 ไบต์ที่ถูกต้อง
    ใส่: ( ลิสต์ สร้างใหม่ ; 226 ; 130 ; 172 ; 0 ) ที่: ['€'],
	# UTF-8 4 ไบต์ที่ถูกต้อง
    ใส่: ( ลิสต์ สร้างใหม่ ; 240 ; 144 ; 141 ; 136 ; 0 ) ที่: ['𐍈'],
	# ไบต์ต่อเนื่องไม่ถูกต้องในลำดับ E2 28 AC -> เริ่มลำดับ 3b + 28 ไบต์ต่อผิด + AC ไบต์ต่อ แต่เป็นข้อผิดพลาดเดียวกัน
    ใส่: ( ลิสต์ สร้างใหม่ ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) ที่: ['A?A'],
	# การเข้ารหัสเกินความยาวของ ASCII 'A' (ควรกลายเป็น ?),
    ใส่: ( ลิสต์ สร้างใหม่ ; 65 ; 193 ; 129 ; 0 ) ที่: ['A?'],
	# ไบต์แรกไม่ถูกต้อง (0xFF)
    ใส่: ( ลิสต์ สร้างใหม่ ; 255 ; 0 ) ที่: ['?'],
	# ลำดับหลายไบต์ไม่ครบที่ท้ายข้อความ
    ใส่: ( ลิสต์ สร้างใหม่ ; 66 ; 226 ; 0 ) ที่: ['B?'],
    # ข้อความว่าง
    #put: ( List new ) at: [''],
	# ลำดับผสมหลายชุด
    ใส่: ( ลิสต์ สร้างใหม่ ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) ที่: ['A€?𐍈B'].
	 
กรณีutf8 แต่ละตัว: { :key :value
	>> blob := Blob สร้างใหม่: value จำนวน, bytes: value.
	>> str := blob เป็นข้อความ.
	(str = key) ถ้าจริง: {
		แสดงผล เขียน: ['OK'], ขึ้นบรรทัดใหม่.
	}, มิฉะนั้น: {
		แสดงผล เขียน: ['ตัวกรอง UTF8 ล้มเหลวที่: '] + key + [' ได้: '] + str, ขึ้นบรรทัดใหม่.
	}.
	blob คืนหน่วยความจำ.
}.
