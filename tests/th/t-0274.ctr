

ลิสต์ เมื่อ: ['column:'] ทำ: { :column
	>> result := ลิสต์ สร้างใหม่.
	ตัวเอง แต่ละตัว: { :index :row
		row แต่ละตัว: { :index :cell
			(index = column) ถ้าจริง: { result ต่อท้าย: cell. }.
		}.
	}. <- result.
}.


>> a := ลิสต์ ←
	(ลิสต์ ← 1 ; 2 ; 3) ;
	(ลิสต์ ← 4 ; 5 ; 6) ;
	(ลิสต์ ← 7 ; 8 ; 9).

>> b := a column: 1.
แสดงผล เขียน: b, ขึ้นบรรทัดใหม่.

b := a column: 20.
แสดงผล เขียน: b, ขึ้นบรรทัดใหม่.

b := a column: -100.
แสดงผล เขียน: b, ขึ้นบรรทัดใหม่.
