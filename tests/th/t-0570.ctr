#Linux

 >> t := ช่วงเวลา สร้างใหม่.
 
t เขตเวลา: ['Europe/Amsterdam'].
t ปี: 2020, เดือน: 8, วัน: 2, ชั่วโมง: 21, นาที: 2, วินาที: 1.

>> a := t ชั่วโมง.
>> ams := t เขตเวลา.

t เขตเวลา: ['US/Hawaii'].
>> b := t ชั่วโมง.
>> hw := t เขตเวลา.

แสดงผล
เขียน: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		เลือก: ['ช้ากว่า'] หรือ: ['เร็วกว่า']
	)
),
ขึ้นบรรทัดใหม่.
 