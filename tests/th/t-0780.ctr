Server init.

# JSON encoder only supports UTF-8, no surrogate pairs

>> dicts := ลิสต์ สร้างใหม่ ;
	# {"key":"normal"} normal ASCII
	( พจนานุกรม สร้างใหม่ ใส่: ['normal'] ที่: ['key'] ) ;
	# {"key":"hello world"} space character
	( พจนานุกรม สร้างใหม่ ใส่: ['hello world'] ที่: ['key'] ) ;
	# {"key":"quote: \""} double quote
	( พจนานุกรม สร้างใหม่ ใส่: ['"'] ที่: ['key'] ) ;
	# {"key":"backslash: \\"} backslash
	( พจนานุกรม สร้างใหม่ ใส่: ['backslash: \\'] ที่: ['key'] ) ;
	# {"key":"slash: /"} slash
	( พจนานุกรม สร้างใหม่ ใส่: ['slash: /'] ที่: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( พจนานุกรม สร้างใหม่ ใส่: ['backspace: \b'] ที่: ['key'] ) ;
	# {"key":"formfeed: \f"} form-feed escape
	( พจนานุกรม สร้างใหม่ ใส่: ['formfeed: \f'] ที่: ['key'] ) ;
	# {"key":"newline: \n"} newline
	( พจนานุกรม สร้างใหม่ ใส่: ['newline: \n'] ที่: ['key'] ) ;
	( พจนานุกรม สร้างใหม่ ใส่: ['newline: ↵'] ที่: ['key'] ) ;
	( พจนานุกรม สร้างใหม่ ใส่: ['newline: 
	'] ที่: ['key'] ) ;
	# {"key":"carriage return: \r"} carriage-return
	( พจนานุกรม สร้างใหม่ ใส่: ['carriage return: \r'] ที่: ['key'] ) ;
	# {"key":"tab: \t"} tab
	( พจนานุกรม สร้างใหม่ ใส่: ['tab \t'] ที่: ['key'] ) ;
	( พจนานุกรม สร้างใหม่ ใส่: ['tab ⇿'] ที่: ['key'] ) ;
	( พจนานุกรม สร้างใหม่ ใส่: ['tab  '] ที่: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( พจนานุกรม สร้างใหม่ ใส่: ['NUL \u0000'] ที่: ['key'] ) ;
	( พจนานุกรม สร้างใหม่ ใส่: ['NUL \0'] ที่: ['key'] ) ;
	# {"key":"control: \u0001"} control character 0x01
	( พจนานุกรม สร้างใหม่ ใส่: ['control: \u0001'] ที่: ['key'] ) ;
	# {"key":"control: \u001F"} control character 0x1F
	( พจนานุกรม สร้างใหม่ ใส่: ['control: \u001F'] ที่: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-byte char
	( พจนานุกรม สร้างใหม่ ใส่: ['unicode: é'] ที่: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-byte char
	( พจนานุกรม สร้างใหม่ ใส่: ['unicode: €'] ที่: ['key'] ) ;
	# {"key":"unicode: 日本語"} multiple 3-byte UTF-8 chars
	( พจนานุกรม สร้างใหม่ ใส่: ['unicode: 日本語'] ที่: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-byte char
	( พจนานุกรม สร้างใหม่ ใส่: ['unicode: 😀'] ที่: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	( พจนานุกรม สร้างใหม่ ใส่: ['unicode: 🧑‍💻'] ที่: ['key'] ) ;
	# {"key":"combining: e\u0301"} combining accent
	( พจนานุกรม สร้างใหม่ ใส่: ['combining: e\u0301'] ที่: ['key'] ) ;
	# {"key":"escaped unicode: \u00e9"} Unicode escape BMP
	( พจนานุกรม สร้างใหม่ ใส่: ['escaped unicode: \u00e9'] ที่: ['key'] ) ;
	# {"key":"escaped unicode: \u20ac"} Unicode escape BMP
	( พจนานุกรม สร้างใหม่ ใส่: ['escaped unicode: \u20ac'] ที่: ['key'] ) ;
	# {"key":"escaped unicode: \ud83d\ude00"} UTF-16 surrogate pair
	( พจนานุกรม สร้างใหม่ ใส่: ['escaped unicode: \ud83d\ude00'] ที่: ['key'] ) ;
	# {"key":""} empty value
	( พจนานุกรม สร้างใหม่ ใส่: [''] ที่: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} special ASCII chars
	( พจนานุกรม สร้างใหม่ ใส่: ['@ < > & = % + ? #'] ที่: ['key'] ) ;
	# {"key":"single quote: '"} single quote
	( พจนานุกรม สร้างใหม่ ใส่: ['''] ที่: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} multiple JSON escapes
	( พจนานุกรม สร้างใหม่ ใส่: ['multiple: \" \\ \n \r \t'] ที่: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} longer ASCII-string
	( พจนานุกรม สร้างใหม่ ใส่: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] ที่: ['key'] ) ;
	# {"key":" value"} leading space
	( พจนานุกรม สร้างใหม่ ใส่: [' value'] ที่: ['key'] ) ;
	# {"key":"value "} trailing space
	( พจนานุกรม สร้างใหม่ ใส่: ['value '] ที่: ['key'] ) ;
	# {"key":" \t\n\r "} whitespace
	( พจนานุกรม สร้างใหม่ ใส่: [' \t\n\r '] ที่: ['key'] ).

dicts แต่ละตัว: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (พจนานุกรม สร้างใหม่ ใส่: d key ที่: ['key']).
	>> b := JSON jsonify: (พจนานุกรม สร้างใหม่ ใส่: ['value'] ที่: d key).
	>> e := JSON ออบเจกต์: a.
	>> f := JSON ออบเจกต์: b.
	((e key = d key และ: (f ? d key = ['value'])) หรือ: (e key = ['NUL ?'])) ถ้าจริง: {
		แสดงผล เขียน: ['OK'], ขึ้นบรรทัดใหม่.
	}, มิฉะนั้น: {
		แสดงผล เขียน: ['Unable to properly encode/decode: '] + d + j, ขึ้นบรรทัดใหม่.
		โปรแกรม จบ.
	}.
}.
