

ลิสต์ เมื่อ: ['sum'] ทำ: {
	>> total := 0.
	ตัวเอง แต่ละตัว: { :index :element
		total บวก: element.
	}. <- total.
}.

ลิสต์ เมื่อ: ['product'] ทำ: {
	>> total := 1.
	ตัวเอง แต่ละตัว: { :index :element
		total คูณด้วย: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

โปรแกรม จัดการหน่วยความจำ: 0.

{

>> a := ลิสต์ ← ['hello'] ; ['world'] ; จริง ; ว่าง ; 666.
a := a + ( ลิสต์ ← 1 ).
แสดงผล เขียน: ( ['sum: '] + ( a sum ) ), ขึ้นบรรทัดใหม่.
แสดงผล เขียน: ( ['min: '] + ( a ค่าต่ำสุด ) ), ขึ้นบรรทัดใหม่.
แสดงผล เขียน: ( ['max: '] + ( a ค่าสูงสุด ) ), ขึ้นบรรทัดใหม่.
แสดงผล เขียน: ( ['3rd: '] + ( a ? 2 ) ), ขึ้นบรรทัดใหม่.
แสดงผล เขียน: ( ['prd: '] + ( a product ) ), ขึ้นบรรทัดใหม่.
a เรียงลำดับ: { :a :b <- (b - a). }.
a แต่ละตัว: { :i :e แสดงผล เขียน: ( i - 0 ), ขึ้นบรรทัดใหม่. }.

} เริ่ม.

โปรแกรม เก็บกวาด.
usedMemory1 := (โปรแกรม หน่วยความจำ ? 0).


