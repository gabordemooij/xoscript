>> a := 3.
>> b := a คัดลอก.
a ลบออก: 1.
แสดงผล เขียน: [' a = '] + a.
แสดงผล เขียน: [' b = '] + b.
a := 3.
b := a + 4.
แสดงผล เขียน: [' a = '] + a.
แสดงผล เขียน: [' b = '] + b.
>> x := 3.
>> y := x คัดลอก.
x บวก: 10.
y ลบออก: 1.
แสดงผล เขียน: [' x = '] + x.
แสดงผล เขียน: [' y = '] + y.
>> q := ออบเจกต์ สร้างใหม่.
q เมื่อ: ['setProperty:'] ทำ: { :x
	ของตน คุณสมบัติ := x.
}.
q เมื่อ: ['เอาคุณสมบัติ'] ทำ: { <- ของตน คุณสมบัติ.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
แสดงผล เขียน: [' p = '] + (p เอาคุณสมบัติ).
