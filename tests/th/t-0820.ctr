# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := แพตเทิร์น สร้างใหม่: pattern.
	p ตรงกับ: subject ทำ: { :m :g
		แสดงผล เขียน: g จำนวน, เขียน: [' '], เขียน: (g รวม: ['|']), ขึ้นบรรทัดใหม่. <- m.
	}.
}.
show ใช้กับ: ['(a)|(b)'] และ: ['b'].
show ใช้กับ: ['(a)|(b)'] และ: ['a'].
show ใช้กับ: ['(x)?y'] และ: ['y'].
show ใช้กับ: ['(x)?(y)(z)?'] และ: ['xy'].
