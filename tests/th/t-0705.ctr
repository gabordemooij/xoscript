

>> obj := ออบเจกต์ สร้างใหม่.

obj เมื่อ: ['greet'] ทำ: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj เมื่อ: ['task'] ทำ: {
	ของตน property := 123.
	{
		# try binds self/own to object instead of block
		แสดงผล เขียน: ตัวเอง greet.
		แสดงผล เขียน: ของตน property.
		1 / 0.
	} ดักจับ: {
		แสดงผล เขียน: ตัวเอง greet.
		แสดงผล เขียน: ของตน property.
		แสดงผล เขียน: ['ok'].
	}, ลอง.
}.

obj task.