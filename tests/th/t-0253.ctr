#Linux
>> OS := โปรแกรม การตั้งค่า: ['OS'].

>> clock := ช่วงเวลา สร้างใหม่.
	
(OS = ['Haiku']) ถ้าจริง: {
	clock เขตเวลา: ['CET'],
	ปี: 2017, เดือน: 7, วัน: 13,
	ชั่วโมง: 18, นาที: 0, วินาที: 0.
}, มิฉะนั้น: {
	clock เขตเวลา: ['Europe/Amsterdam'],
	ปี: 2017, เดือน: 7, วัน: 13,
	ชั่วโมง: 18, นาที: 0, วินาที: 0.
}.

clock เมื่อ: ['tell'] ทำ: {
	แสดงผล เขียน: ตัวเอง, ขึ้นบรรทัดใหม่.
}.


clock บวก: 2    ชั่วโมง, tell.
clock บวก: 1    ชั่วโมง, tell.
clock บวก: 19 นาที, tell.
clock บวก: 1  นาที, tell.
clock บวก: 1  นาที, tell.
clock บวก: 19 วินาที, tell.
clock บวก: 1  วินาที, tell.
clock บวก: 1  วินาที, tell.
clock บวก: 2    ปี, tell.
clock บวก: 1    ปี, tell.

(OS = ['Haiku']) ถ้าจริง: {
clock บวก: 5   เดือน.
clock เขตเวลา: ['CEST'], tell.
}, มิฉะนั้น: {
	clock บวก: 5   เดือน, tell.
}.

clock บวก: 1   เดือน, tell.
clock บวก: 19    วัน, tell.
clock บวก: 1    ชั่วโมง, tell.
clock บวก: 120  yard, tell.
