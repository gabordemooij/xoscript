>> numbers := ['1,2,3'] แยก: [','].
แสดงผล เขียน: ['I got: '] + numbers จำนวน + [' numbers.'],ขึ้นบรรทัดใหม่.
{ :i แสดงผล เขียน: ['number #'] + i + [':'] + (numbers ตำแหน่ง: i), ขึ้นบรรทัดใหม่.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages แยก: [' Or '].
แสดงผล เขียน: ['We serve'], ขึ้นบรรทัดใหม่.
{ :i แสดงผล เขียน: ['->'] + (beverages ตำแหน่ง: i), ขึ้นบรรทัดใหม่. } × (beverages จำนวน).
แสดงผล เขียน: (beverages รวม: [',']), ขึ้นบรรทัดใหม่.
แสดงผล เขียน: (numbers รวม: ['||']).
