>> makeAdder := { :x
	>> f := { :y <- (ของตน x + y). } กำหนด: ['x'] ค่า: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i ของตน q ใส่: (ของตน f ใช้กับ: (ของตน q ? i)) ที่: i. } 
	กำหนด: ['q'] ค่า: array,
	กำหนด: ['f'] ค่า: func.
	{ :i mapping ใช้กับ: i. } × (array จำนวน).
}.

>> a := ลิสต์ ← 1; 2; 3.
mapper ใช้กับ: a และ: (makeAdder ใช้กับ: 100).
แสดงผล เขียน: (a ตำแหน่ง: 0), ขึ้นบรรทัดใหม่.
แสดงผล เขียน: (a ? 1), ขึ้นบรรทัดใหม่.
แสดงผล เขียน: (a ? 2), ขึ้นบรรทัดใหม่.
