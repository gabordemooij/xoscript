


>> Deck := ลิสต์ สร้างใหม่.
Deck เมื่อ: ['print'] ทำ: {
        >> len := ตัวเอง จำนวน - 1.
        { :i
                >> len2 := ตัวเอง จำนวน - 1.
                แสดงผล เขียน: ['len: '].
                แสดงผล เขียน: len, ขึ้นบรรทัดใหม่.
                แสดงผล เขียน: ['len2: '].
                แสดงผล เขียน: len2, ขึ้นบรรทัดใหม่.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
