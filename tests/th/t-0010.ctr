>> Animal := ออบเจกต์ สร้างใหม่.
Animal เมื่อ: ['make'] ทำ: {
	>> animal := ออบเจกต์ สร้างใหม่.
	animal เมื่อ: ['makeSound'] ทำ: {
		แสดงผล เขียน: ของตน sound.
	}. <- animal.
}.
>> Cat := ออบเจกต์ สร้างใหม่.
Cat เมื่อ: ['make'] ทำ: {
	>> cat := Animal make.
	cat เมื่อ: ['init'] ทำ: {
		ของตน sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
