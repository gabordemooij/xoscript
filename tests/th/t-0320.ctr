


>> CoffeeMachine := ออบเจกต์ สร้างใหม่.
CoffeeMachine เมื่อ: ['order:'] ทำ: { :id
	>> coffee := ['Americano'].
	( id = 1 ) ถ้าจริง: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) ถ้าจริง: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) ถ้าจริง: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := ออบเจกต์ สร้างใหม่.
SimpleCoffeeMachine เมื่อ: ['order'] ทำ: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
แสดงผล เขียน: redCup, ขึ้นบรรทัดใหม่.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
แสดงผล เขียน: greenCup, ขึ้นบรรทัดใหม่.
>> yellowCup := CoffeeMachine order: 1.
แสดงผล เขียน: yellowCup, ขึ้นบรรทัดใหม่.
>> blueCup := CoffeeMachine order: 0.
แสดงผล เขียน: blueCup, ขึ้นบรรทัดใหม่.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
แสดงผล เขียน: blackCup, ขึ้นบรรทัดใหม่.
blackCup ต่อท้าย: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
แสดงผล เขียน: orangeCup, ขึ้นบรรทัดใหม่.
