


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

โปรแกรม จัดการหน่วยความจำ: 0.
>> palette := ว่าง.
>> colors := ว่าง.

{
palette := พจนานุกรม สร้างใหม่.
palette 
	ใส่: ['#F00'] ที่: ['red'],
	ใส่: ['#0F0'] ที่: ['green'],
	ใส่: ['#00F'] ที่: ['blue'].
แสดงผล เขียน: ['number of RGB codes in palette: '] + ( palette จำนวน ), ขึ้นบรรทัดใหม่.
แสดงผล เขียน: ['RGB code of green is: '] + ( palette ? ['green'] ), ขึ้นบรรทัดใหม่.
colors := [''].
( palette แต่ละตัว: { :ชื่อ :โค้ด
		colors := colors + ( ชื่อ + [':'] + โค้ด ).
} ).
แสดงผล เขียน: ['All colors in palette: '] + colors, ขึ้นบรรทัดใหม่.
} เริ่ม.
โปรแกรม เก็บกวาด.
usedMemory1 := (โปรแกรม หน่วยความจำ ? 0).

