# a format must fit the type of the value, the type can come from a client
>> ลอง := { :format :value
	{ แสดงผล เขียน: ( (รูปแบบ สร้างใหม่: format) ใช้กับ: value ), ขึ้นบรรทัดใหม่. } ดักจับ: { :e แสดงผล เขียน: e, ขึ้นบรรทัดใหม่. }, เริ่ม.
}.
>> try-int := { :format :value
	{ แสดงผล เขียน: ( (รูปแบบ สร้างใหม่: format) ใช้กับจำนวนเต็ม: value ), ขึ้นบรรทัดใหม่. } ดักจับ: { :e แสดงผล เขียน: e, ขึ้นบรรทัดใหม่. }, เริ่ม.
}.

# fits
ลอง ใช้กับ: ['|%s|'] และ: ['text'].
ลอง ใช้กับ: ['%06.2f'] และ: 5.5.
ลอง ใช้กับ: ['100%% %s'] และ: ['sure'].
try-int ใช้กับ: ['%03d'] และ: 7.
try-int ใช้กับ: ['%x'] และ: 255.
ลอง ใช้กับ: ['%d'] และ: (Int64 สร้างใหม่ จากข้อความ: ['12']).
ลอง ใช้กับ: ['%lld'] และ: (Int64 สร้างใหม่ จากข้อความ: ['12']).
ลอง ใช้กับ: ['%.1lf'] และ: 5.5.
try-int ใช้กับ: ['%hd'] และ: 7.

# does not fit
ลอง ใช้กับ: ['%s'] และ: 12345.
ลอง ใช้กับ: ['%d'] และ: 12345.
ลอง ใช้กับ: ['%f'] และ: ['text'].
try-int ใช้กับ: ['%d'] และ: ['text'].
try-int ใช้กับ: ['%s'] และ: 5.
ลอง ใช้กับ: ['%s %s'] และ: ['text'].
ลอง ใช้กับ: ['%n'] และ: ['text'].
ลอง ใช้กับ: ['%*s'] และ: ['text'].
ลอง ใช้กับ: ['%'] และ: ['text'].

# length modifier does not fit
ลอง ใช้กับ: ['%ls'] และ: ['text'].
ลอง ใช้กับ: ['%Lf'] และ: 5.5.
try-int ใช้กับ: ['%ld'] และ: 7.
try-int ใช้กับ: ['%lld'] และ: 7.
ลอง ใช้กับ: ['%Ld'] และ: (Int64 สร้างใหม่ จากข้อความ: ['12']).

# a width that does not fit printf must give an error, not a crash
ลอง ใช้กับ: ['%99999999999s'] และ: ['text'].
