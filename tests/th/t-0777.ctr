#OBSD
>> dirname := [''].
{ dirname ต่อท้าย: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
โปรแกรม ระบบ: command.
โปรแกรม chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename ต่อท้าย: ['YYYYYYYY']. } * 20.
ไฟล์ สร้างใหม่: filename, เขียน: ['sometext'].
{ ไฟล์ รายการ: ['/tmp/'] + dirname. } * 1000.
แสดงผล เขียน: ['no crash'], ขึ้นบรรทัดใหม่.

