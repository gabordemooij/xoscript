Server init.

>> ฐานข้อมูลหลัก := Maria-DB สร้างใหม่ โฮสต์: ['localhost'],
	ชื่อผู้ใช้: ['xo'],
	รหัสผ่าน: ['pass123'],
	ชื่อฐานข้อมูล: ['xobase'],
	เชื่อมต่อ.
	
>> SQL := ['SELECT "hello" AS "world" '].

# สร้างคิวรีเอง
>> พารามิเตอร์ค้นหา := Maria-คิวรี สร้างใหม่: SQL.

# ตั้งฐานข้อมูล
พารามิเตอร์ค้นหา ฐานข้อมูล: ฐานข้อมูลหลัก.

พารามิเตอร์ค้นหา ดึงข้อมูล: { :แถว
	แสดงผล เขียน: แถว world, ขึ้นบรรทัดใหม่.
}.
