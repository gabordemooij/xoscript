Server init.

>> DB := Maria-DB สร้างใหม่ โฮสต์: ['localhost'],
	ชื่อผู้ใช้: ['xo'],
	รหัสผ่าน: ['pass123'],
	ชื่อฐานข้อมูล: ['xobase'],
	เชื่อมต่อ.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> พารามิเตอร์ค้นหา := Maria-คิวรี สร้างใหม่: SQL.

# set database
พารามิเตอร์ค้นหา ฐานข้อมูล: DB.

พารามิเตอร์ค้นหา ดึงข้อมูล: { :row
	แสดงผล เขียน: row world, ขึ้นบรรทัดใหม่.
}.
