
ข้อความ เมื่อ: ['evaluate'] ทำ: {
	>> โค้ด := ไฟล์ สร้างใหม่: ['/tmp/eval.ctr'].
	โค้ด เขียน: (ตัวเอง เป็นข้อความ + ['.']).
	โปรแกรม ใช้: ['/tmp/eval.ctr'].
}.

>> map :=
	(พจนานุกรม สร้างใหม่)
	ใส่: ['Hi There'] ที่: ['two'],
	ใส่: (ลิสต์ ← ['hello'] ; ['world'] ; (ลิสต์ ← 1 ; 2; 9) ; เท็จ) ที่: ['one'],
	ใส่: ( (พจนานุกรม สร้างใหม่) ใส่: ['wrrld'] ที่: ['misspelled'] ) ที่: ['three'],
	ใส่: (ลิสต์ ← ((พจนานุกรม สร้างใหม่) ใส่: ['treasure'] ที่: ['hidden']) ; 2) ที่: ['four']. 
>> str := map เป็นข้อความ.
>> map2 := ว่าง.
(['map2 := '] + str ) evaluate.
แสดงผล เขียน: map2 ? ['one'] ? 0.
แสดงผล เขียน: map2 ? ['one'] ? 1.
แสดงผล เขียน: map2 ? ['four'] ? 0 ? ['hidden'].
แสดงผล เขียน: map2 ? ['one'] ? 2 ? 2.
