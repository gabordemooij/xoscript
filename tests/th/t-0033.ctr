>> x := ออบเจกต์ สร้างใหม่.
x เมื่อ: ['set:'] ทำ: { :v ของตน ค่าเก็บ := v. }.
x เมื่อ: ['เอามา'] ทำ: { <- ของตน ค่าเก็บ. }.
>> a := ออบเจกต์ สร้างใหม่.
a เมื่อ: ['init'] ทำ: {
	>> y := x สร้างใหม่.
	y set: 123.
	>> q := x สร้างใหม่.
	q set: 666.
	แสดงผล เขียน: (y เอามา), เขียน: (q เอามา).
}.
a init.
