ข้อความ เมื่อ: ['html'] ทำ: { <- (
		ตัวเอง
		แทนที่: ['&'] ด้วย: ['&amp;'],
		แทนที่: ['<'] ด้วย: ['&lt;'],
		แทนที่: ['>'] ด้วย: ['&gt;'],
		แทนที่: ['''] ด้วย: ['&apos;'],
		แทนที่: ['"'] ด้วย: ['&quot;']
	).
}.

