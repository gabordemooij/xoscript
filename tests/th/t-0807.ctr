# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB สร้างใหม่ โฮสต์: ['localhost'],
	ชื่อผู้ใช้: ['xo'],
	รหัสผ่าน: ['pass123'],
	ชื่อฐานข้อมูล: ['xobase'],
	เชื่อมต่อ.

>> พารามิเตอร์ค้นหา := db คิวรี: ['SELECT %% FROM'].
{ พารามิเตอร์ค้นหา ดำเนินการ. } ดักจับ: { :e
	แสดงผล เขียน: ( e ประกอบด้วย: ['%%'] ), ขึ้นบรรทัดใหม่.
}, เริ่ม.
