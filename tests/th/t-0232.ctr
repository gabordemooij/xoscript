>> Slurp := ออบเจกต์ สร้างใหม่.

Slurp เมื่อ: ['สร้างใหม่'] ทำ: {
	ของตน str := [''].
}.

Slurp เมื่อ: ['ตอบ:'] ทำ: { :blah
		(ของตน str = ['']) ถ้าจริง: {
			ของตน str ต่อท้าย: blah.
		}, มิฉะนั้น: {
			ของตน str ต่อท้าย: [' '].
			ของตน str ต่อท้าย: blah.
		}.
}.

Slurp เมื่อ: ['ตอบ:และ:'] ทำ: { :blah :blahah
		(blah ความยาว > 1) ถ้าจริง: {
			ของตน str ต่อท้าย: (blah เริ่มที่: 0 ความยาว: (blah ความยาว - 1)).
		}, มิฉะนั้น: {
			ของตน str ต่อท้าย: blah.
		}.
		ของตน str ต่อท้าย: [' '].
		ของตน str ต่อท้าย: blahah.
}.

Slurp เมื่อ: ['obtain'] ทำ: {
	>> buffer := ของตน str.
	ของตน str := ['']. <- buffer.
}.


>> x := Slurp สร้างใหม่.
x + 3.
แสดงผล เขียน: (x obtain), ขึ้นบรรทัดใหม่.
x echo: ['Hello world'].
แสดงผล เขียน: (x obtain), ขึ้นบรรทัดใหม่.
x tellme: 123 and: 987.
แสดงผล เขียน: (x obtain), ขึ้นบรรทัดใหม่.
