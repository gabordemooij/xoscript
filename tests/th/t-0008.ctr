>> Greeter := ออบเจกต์ สร้างใหม่.
Greeter เมื่อ: ['make'] ทำ: {
	>> greeter := ออบเจกต์ สร้างใหม่.
	greeter เมื่อ: ['name:'] ทำ: { :ชื่อ
		แสดงผล เขียน: ['setting a name'].
		ของตน myName := ชื่อ.
	}.
	greeter เมื่อ: ['greet'] ทำ: {
		แสดงผล เขียน: ['Hello'].
		แสดงผล เขียน: ของตน myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
