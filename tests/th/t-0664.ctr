# recursive interpolation not allowed

แสดงผล เขียน: 
['recursive string interolation enabled: '] + (
	โปรแกรม คุณสมบัติ: 
	['RECURSIVE_STRINTPOL']
), ขึ้นบรรทัดใหม่.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

แสดงผล เขียน: a, ขึ้นบรรทัดใหม่.


โปรแกรม คุณสมบัติ: ['RECURSIVE_STRINTPOL'] เปิดใช้: จริง.

แสดงผล เขียน: 
['recursive string interpolation enabled: '] + (
	โปรแกรม คุณสมบัติ: 
	['RECURSIVE_STRINTPOL']
), ขึ้นบรรทัดใหม่.

>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

แสดงผล เขียน: a, ขึ้นบรรทัดใหม่.

โปรแกรม คุณสมบัติ: ['RECURSIVE_STRINTPOL'] เปิดใช้: เท็จ.

แสดงผล เขียน: 
['recursive string interpolation enabled: '] + (
	โปรแกรม คุณสมบัติ: 
	['RECURSIVE_STRINTPOL']
), ขึ้นบรรทัดใหม่.

>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

แสดงผล เขียน: a, ขึ้นบรรทัดใหม่.
