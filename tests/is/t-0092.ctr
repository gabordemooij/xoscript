
>> g := ['víðvært'].
{ >> g := ['staðbundið']. Úttak skrifa: g, ný-lína. } ræsa. 
Úttak skrifa: g, ný-lína. 
>> skilaboðin := ['Bless'].
>> Leyndarmál := Hlutur nýtt.
Leyndarmál við: ['prófun'] gera: {
	>> skilaboðin := ['Hello'].
	eigin skilaboðin := ['World'].
	Úttak skrifa: skilaboðin + [' '] + eigin skilaboðin, ný-lína.
}.
Leyndarmál prófun.
Úttak skrifa: skilaboðin.
