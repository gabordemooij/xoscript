

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Forrit minnisstjórnun: 0.

Tala við: ['addNum:'] gera: { :x
	sjálfur leggja-við: x.
}.

Tala við: ['subtractNum:'] gera: { :x
	sjálfur draga-frá: x.
}.

Tala við: ['multiplyBy:'] gera: { :x
	sjálfur margfalda-með: x.
}.

Tala við: ['divideBy:'] gera: { :x
	sjálfur deila-með: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 veldi: 8).  
a := a + (2 veldi: -1). 
a := a + (49 kvaðratrót).   
a addNum: ((Listi ← 0 ; 1) hámark).          
a addNum: ((Listi ← 2 ; 3) lágmark).
Úttak skrifa: a.

Forrit taka-til.

usedMemory1 := (Forrit minni ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 veldi: 8).  
a := a + (2 veldi: -1). 
a := a + (49 kvaðratrót).   
a addNum: ((Listi ← 0 ; 1) hámark).          
a addNum: ((Listi ← 2 ; 3) lágmark).
Úttak skrifa: a.

Forrit taka-til.
usedMemory2 := (Forrit minni ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 veldi: 8).  
a := a + (2 veldi: -1). 
a := a + (49 kvaðratrót).   
a addNum: ((Listi ← 0 ; 1) hámark).          
a addNum: ((Listi ← 2 ; 3) lágmark).
Úttak skrifa: a.

Forrit taka-til.
usedMemory3 := (Forrit minni ? 0).



( usedMemory1 = usedMemory2 og: usedMemory1 = usedMemory3, og: usedMemory2 = usedMemory3 ) satt: {
	Úttak skrifa: ['No memory leaks here'].
}, rangt: {
	Úttak skrifa: ['Leaking memory...'].
}.
