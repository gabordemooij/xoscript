


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Forrit minnisstjórnun: 0.
>> palette := Ekkert.
>> colors := Ekkert.

{
palette := Orðabók nýtt.
palette 
	setja: ['#F00'] við: ['red'],
	setja: ['#0F0'] við: ['green'],
	setja: ['#00F'] við: ['blue'].
Úttak skrifa: ['number of RGB codes in palette: '] + ( palette fjöldi ), ný-lína.
Úttak skrifa: ['RGB code of green is: '] + ( palette ? ['green'] ), ný-lína.
colors := [''].
( palette hver: { :nafn :kóði
		colors := colors + ( nafn + [':'] + kóði ).
} ).
Úttak skrifa: ['All colors in palette: '] + colors, ný-lína.
} ræsa.
Forrit taka-til.
usedMemory1 := (Forrit minni ? 0).

{
palette := Orðabók nýtt.
palette 
	setja: ['#F00'] við: ['red'],
	setja: ['#0F0'] við: ['green'],
	setja: ['#00F'] við: ['blue'].
Úttak skrifa: ['number of RGB codes in palette: '] + ( palette fjöldi ), ný-lína.
Úttak skrifa: ['RGB code of green is: '] + ( palette ? ['green'] ), ný-lína.
colors := [''].
( palette hver: { :nafn :kóði
		colors := colors + ( nafn + [':'] + kóði ).
} ).
Úttak skrifa: ['All colors in palette: '] + colors, ný-lína.
} ræsa.
Forrit taka-til.
usedMemory2 := (Forrit minni ? 0).

{
palette := Orðabók nýtt.
palette 
	setja: ['#F00'] við: ['red'],
	setja: ['#0F0'] við: ['green'],
	setja: ['#00F'] við: ['blue'].
Úttak skrifa: ['number of RGB codes in palette: '] + ( palette fjöldi ), ný-lína.
Úttak skrifa: ['RGB code of green is: '] + ( palette ? ['green'] ), ný-lína.
colors := [''].
