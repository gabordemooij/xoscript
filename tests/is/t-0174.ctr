


>> notaðMinni1 := 0.
>> notaðMinni2 := 0.
>> notaðMinni3 := 0.
>> notaðMinni4 := 0.

Forrit minnisstjórnun: 0.
>> litaspjald := Ekkert.
>> litir := Ekkert.

{
litaspjald := Orðabók nýtt.
litaspjald 
	setja: ['#F00'] við: ['rauður'],
	setja: ['#0F0'] við: ['grænn'],
	setja: ['#00F'] við: ['blár'].
Úttak skrifa: ['fjöldi RGB kóða í litaspjaldi: '] + ( litaspjald fjöldi ), ný-lína.
Úttak skrifa: ['RGB kóði græns er: '] + ( litaspjald ? ['grænn'] ), ný-lína.
litir := [''].
( litaspjald hver: { :nafn :kóði
		litir := litir + ( nafn + [':'] + kóði ).
} ).
Úttak skrifa: ['Allir litir í litaspjaldi: '] + litir, ný-lína.
} ræsa.
Forrit taka-til.
notaðMinni1 := (Forrit minni ? 0).

