Tala við: ['aðfeldi'] gera: {
	>> samtals := 1.
	{ :vísir samtals margfalda-með: (sjálfur - (vísir)). } × sjálfur. <- samtals.
}.
>> Prentari := Hlutur nýtt.
Prentari við: ['prenta:og:'] gera: { :x :y
	Úttak skrifa: ['a='] + x + [', b='] + y, ný-lína.
}.
>> a := 4.5. >> b := a námunda-niður.
Prentari prenta: a og: b.
a := 4. b := a aðfeldi.
Prentari prenta: a og: b.
a := 4.5. b := a námunda-upp.
Prentari prenta: a og: b.
a := 4.5. b := a námunda-niður.
Prentari prenta: a og: b.
a := 4.5. b := a námunda.
Prentari prenta: a og: b.
a := 4.2. b := a námunda.
Prentari prenta: a og: b.

Úttak skrifa: (9 leif: 5), ný-lína.
Úttak skrifa: -666 algildi, ný-lína.
Úttak skrifa: 49 kvaðratrót, ný-lína.
Úttak skrifa: (2 veldi: 3), ný-lína.
>> l := (Listi ← 9 ; 6).
Úttak skrifa: l lágmark.

