Úttak skrifa: ['Test object'], ný-lína.
>> a := Hlutur nýtt. 

a við: ['item:'] gera: { :moment
	eigin moment := moment. 
}.

a við: ['item'] gera: { <- eigin moment.
}.

>> today := Stund nýtt svæði: ['CEST'], ár: 2026, mánuður: 7.
a item: today.
Úttak skrifa: a item, ný-lína.
a save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== RELOADING SNAP:'], ný-lína.
>> b := Hlutur load-from: ['/tmp/a.bin'].
Úttak skrifa: b item, ný-lína.
