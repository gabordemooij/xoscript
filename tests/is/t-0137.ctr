(usedMemory1 = usedMemory2 = usedMemory3 = usedMemory4 = usedMemory5) satt: {
	Úttak skrifa: ['Memory usage remains stable.'], ný-lína.
}, annars: {
	Úttak skrifa: ['Used memory not stable.'], ný-lína.
