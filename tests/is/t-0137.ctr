


Forrit minnisstjórnun: 0.

>> x := 0.
>> y := ['Hello'].
>> q := { ['Tómt']. }.
>> p := Satt.
>> a := Listi ← 1 ; 2 ; 3 ; 4.

>> notaðMinni1 := 0.
>> notaðMinni2 := 0.
>> notaðMinni3 := 0.
>> notaðMinni4 := 0.

Forrit taka-til.
notaðMinni1 := (Forrit minni ? 0).




x := 1.
y := ['Hello'].
q := { ['Tómt']. }.
p := Satt.
a := Listi ← 1 ; 2 ; 3 ; 5.

Forrit taka-til.
notaðMinni2 := (Forrit minni ? 0).




x := 2.
y := ['Hello'].
q := { ['Tómt']. }.
p := Satt.
a := Listi ← 1 ; 2 ; 3 ; 4.

Forrit taka-til.
notaðMinni3 := (Forrit minni ? 0).




x := 3.
y := ['Hello'].
q := { ['Tómt']. }.
