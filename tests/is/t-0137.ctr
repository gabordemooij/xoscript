Forrit taka-til.
>> notaðMinni5 := (Forrit minni ? 0).




(notaðMinni1 = notaðMinni2 = notaðMinni3 = notaðMinni4 = notaðMinni5) satt: {
	Úttak skrifa: ['Minnisnotkun helst stöðug.'], ný-lína.
}, annars: {
	Úttak skrifa: ['Notað minni er ekki stöðugt.'], ný-lína.
	Úttak skrifa: notaðMinni1, ný-lína.
	Úttak skrifa: notaðMinni2, ný-lína.
	Úttak skrifa: notaðMinni3, ný-lína.
	Úttak skrifa: notaðMinni4, ný-lína.
	Úttak skrifa: notaðMinni5, ný-lína.
}.
