Server init.

>> DB := Maria-DB nýtt hýsill: ['localhost'],
	notandanafn: ['xo'],
	lykilorð: ['pass123'],
	nafn-gagnagrunns: ['xobase'],
	tengjast.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> leitarfæribreytur := Maria-Fyrirspurn nýtt: SQL.

# set database
leitarfæribreytur gagnagrunnur: DB.

leitarfæribreytur sækja: { :row
	Úttak skrifa: row world, ný-lína.
}.
