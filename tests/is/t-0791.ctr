Server init.

>> GG := Maria-DB nýtt hýsill: ['localhost'],
	notandanafn: ['xo'],
	lykilorð: ['pass123'],
	nafn-gagnagrunns: ['xobase'],
	tengjast.
	
>> SQL := ['SELECT "hello" AS "world" '].

# búa til fyrirspurn handvirkt
>> leitarfæribreytur := Maria-Fyrirspurn nýtt: SQL.

# stilla gagnagrunn
leitarfæribreytur gagnagrunnur: GG.

leitarfæribreytur sækja: { :röð
	Úttak skrifa: röð world, ný-lína.
}.
