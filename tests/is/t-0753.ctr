Úttak skrifa: ['Test object'], ný-lína.
>> a := Hlutur nýtt. 

a við: ['item:'] gera: { :fmt
	eigin fmt := fmt. 
}.

a við: ['item'] gera: { <- eigin fmt.
}.

a item: ( Snið nýtt: ['|%s|'] ).

Úttak skrifa: a item, ný-lína.

>> old-fmt-address := a item frumgerð minnisvistfang.
a save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== RELOADING SNAP:'], ný-lína.

>> b := Hlutur load-from: ['/tmp/a.bin'].

(b item frumgerð minnisvistfang = old-fmt-address) satt: {
	Úttak skrifa: ['Object link re-attached.'], ný-lína.
}.

Úttak skrifa: ( b item beita: ['hello'] ), ný-lína.
