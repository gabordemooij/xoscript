Úttak skrifa: ['Prófunarhlutur'], ný-lína.
>> a := Hlutur nýtt. 

a við: ['item:'] gera: { :fmt
	eigin fmt := fmt. 
}.

a við: ['liður'] gera: {
	<- eigin fmt.
}.

a item: ( Snið nýtt: ['|%s|'] ).

Úttak skrifa: a liður, ný-lína.

>> gamalt-fmt-vistfang := a liður frumgerð minnisvistfang.
a save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== ENDURHLEÐ SNAP:'], ný-lína.

>> b := Hlutur load-from: ['/tmp/a.bin'].

(b liður frumgerð minnisvistfang = gamalt-fmt-vistfang) satt: {
	Úttak skrifa: ['Hlutartengill tengdur aftur.'], ný-lína.
}.

Úttak skrifa: ( b liður beita: ['hello'] ), ný-lína.
