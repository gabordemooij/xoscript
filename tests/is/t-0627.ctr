

# búa til 64-bita heiltölu fyrir nákvæma útreikninga
>> a := Int64 úr-texta: ['123'].

# í texta
Úttak skrifa: a, ný-lína.

# deila
Úttak skrifa: a / (Int64 úr-texta: ['3']), ný-lína.

# margfalda
Úttak skrifa: a * (Int64 úr-texta: ['2']), ný-lína.

# leggja við
Úttak skrifa: a + (Int64 úr-texta: ['1']), ný-lína.

# draga frá
Úttak skrifa: a - (Int64 úr-texta: ['2']), ný-lína.

# bera saman
Úttak skrifa: ( a =   (Int64 úr-texta: ['123'])), ný-lína.
Úttak skrifa: ( a !=: (Int64 úr-texta: ['124'])), ný-lína.
Úttak skrifa: ( a <   (Int64 úr-texta: ['124'])), ný-lína.
Úttak skrifa: ( a >   (Int64 úr-texta: ['122'])), ný-lína.
Úttak skrifa: ( a >=: (Int64 úr-texta: ['123'])), ný-lína.
Úttak skrifa: ( a <=: (Int64 úr-texta: ['123'])), ný-lína.





	