Server init.

# JSON-kóðarinn styður aðeins UTF-8, engin staðgöngupör

>> orðabækur := Listi nýtt ;
	# {"key":"normal"} venjulegt ASCII
	( Orðabók nýtt setja: ['venjulegt'] við: ['key'] ) ;
	# {"key":"hello world"} bilstafur
	( Orðabók nýtt setja: ['hello world'] við: ['key'] ) ;
	# {"key":"quote: \""} tvöföld gæsalöpp
	( Orðabók nýtt setja: ['"'] við: ['key'] ) ;
	# {"key":"backslash: \\"} öfugt skástrik
	( Orðabók nýtt setja: ['backslash: \\'] við: ['key'] ) ;
	# {"key":"slash: /"} skástrik
	( Orðabók nýtt setja: ['skástrik: /'] við: ['key'] ) ;
	# {"key":"backspace: \b"} bakkstafur
	( Orðabók nýtt setja: ['backspace: \b'] við: ['key'] ) ;
	# {"key":"formfeed: \f"} form-feed lausnarstafur
	( Orðabók nýtt setja: ['formfeed: \f'] við: ['key'] ) ;
	# {"key":"newline: \n"} ný lína
	( Orðabók nýtt setja: ['newline: \n'] við: ['key'] ) ;
	( Orðabók nýtt setja: ['newline: ↵'] við: ['key'] ) ;
	( Orðabók nýtt setja: ['newline: 
	'] við: ['key'] ) ;
	# {"key":"carriage return: \r"} vagnhvarf
	( Orðabók nýtt setja: ['carriage return: \r'] við: ['key'] ) ;
	# {"key":"tab: \t"} dálkstafur
	( Orðabók nýtt setja: ['tab \t'] við: ['key'] ) ;
	( Orðabók nýtt setja: ['tab ⇿'] við: ['key'] ) ;
	( Orðabók nýtt setja: ['dálklykill  '] við: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( Orðabók nýtt setja: ['NUL \u0000'] við: ['key'] ) ;
	( Orðabók nýtt setja: ['NUL \0'] við: ['key'] ) ;
	# {"key":"control: \u0001"} stýristafur 0x01
	( Orðabók nýtt setja: ['control: \u0001'] við: ['key'] ) ;
	# {"key":"control: \u001F"} stýristafur 0x1F
	( Orðabók nýtt setja: ['control: \u001F'] við: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-bæta stafur
	( Orðabók nýtt setja: ['unicode: é'] við: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-bæta stafur
	( Orðabók nýtt setja: ['unicode: €'] við: ['key'] ) ;
	# {"key":"unicode: 日本語"} margir 3-bæta UTF-8-stafir
	( Orðabók nýtt setja: ['unicode: 日本語'] við: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-bæta stafur
	( Orðabók nýtt setja: ['unicode: 😀'] við: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	( Orðabók nýtt setja: ['unicode: 🧑‍💻'] við: ['key'] ) ;
	# {"key":"combining: e\u0301"} samsettur broddur
	( Orðabók nýtt setja: ['combining: e\u0301'] við: ['key'] ) ;
	# {"key":"escaped unicode: \u00e9"} Unicode-lausnarruna BMP
	( Orðabók nýtt setja: ['escaped unicode: \u00e9'] við: ['key'] ) ;
	# {"key":"escaped unicode: \u20ac"} Unicode-lausnarruna BMP
	( Orðabók nýtt setja: ['escaped unicode: \u20ac'] við: ['key'] ) ;
	# {"key":"escaped unicode: \ud83d\ude00"} UTF-16 staðgöngupar
	( Orðabók nýtt setja: ['escaped unicode: \ud83d\ude00'] við: ['key'] ) ;
	# {"key":""} tómt gildi
	( Orðabók nýtt setja: [''] við: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} sérstakir ASCII-stafir
	( Orðabók nýtt setja: ['@ < > & = % + ? #'] við: ['key'] ) ;
	# {"key":"single quote: '"} einföld gæsalöpp
	( Orðabók nýtt setja: ['''] við: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} margar JSON-lausnarrunur
	( Orðabók nýtt setja: ['multiple: \" \\ \n \r \t'] við: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} lengri ASCII-texti
	( Orðabók nýtt setja: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] við: ['key'] ) ;
	# {"key":" value"} bil á undan
	( Orðabók nýtt setja: [' gildi'] við: ['key'] ) ;
	# {"key":"value "} bil á eftir
	( Orðabók nýtt setja: ['gildi '] við: ['key'] ) ;
	# {"key":" \t\n\r "} bilstafir
	( Orðabók nýtt setja: [' \t\n\r '] við: ['key'] )
	.

orðabækur hver: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (Orðabók nýtt setja: d key við: ['key']).
	>> b := JSON jsonify: (Orðabók nýtt setja: ['value'] við: d key).
	>> e := JSON hlutur: a.
	>> f := JSON hlutur: b.
	((e key = d key og: (f ? d key = ['value'])) eða: (e key = ['NUL ?'])) satt: {
		Úttak skrifa: ['OK'], ný-lína.
	}, annars: {
		Úttak skrifa: ['Get ekki kóðað/afkóðað rétt: '] + d + j, ný-lína.
		Forrit enda.
	}.
}.
