# snið setuköku, json-efnisgerð, aðeins vefsamskiptareglur, svg birt innfellt
Server frumstilla.
Forrit nota: ['../../../src/xo/is/webtools.xo'].

>> Fölsk-Beiðni := Hlutur nýtt.
Fölsk-Beiðni við: ['value:'] gera: { :gildið
	eigin gildið := gildið.
}.
Fölsk-Beiðni við: ['cookie:'] gera: { :nafn
	<- eigin gildið.
}.

>> Prófunar-Seta := Bráðabirgðaskrár-seta nýtt.
Prófunar-Seta við: ['hlaða'] gera: {
	<- Orðabók nýtt.
}.
Prófunar-Seta við: ['auðkenni-setu'] gera: {
	<- eigin id.
}.

>> vafrakökur := Listi nýtt
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

vafrakökur hver: { :i :vafrakaka
	>> beiðni := Fölsk-Beiðni nýtt.
	beiðni value: vafrakaka.
	>> stjóri := Prófunar-Seta nýtt.
	>> vefur := Vefskjal nýtt.
	vefur beiðni: beiðni.
	vefur setustjóri: stjóri.
	vefur hefja-setu.
	Úttak skrifa: ( stjóri auðkenni-setu = vafrakaka ), ný-lína.
}.

>> vefur := Vefskjal nýtt.
vefur json: (Orðabók nýtt setja: ['b'] við: ['a']).
Úttak skrifa: ['\n'], ný-lína.

{ Net get: ['file:///etc/hostname']. } grípa: { :e
	Úttak skrifa: e, ný-lína.
}, ræsa.

>> svg := Skrá nýtt: ['/tmp/test0814.svg'].
svg skrifa: ['<svg xmlns="x"></svg>'].
Úttak ný-lína.
Server áframsenda: ['test0814.svg'] forskeyti: ['/tmp/'].
svg eyða.
