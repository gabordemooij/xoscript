Tala við: ['aðfeldi'] gera: {
	>> samtals := 1.
	{ :vísir samtals margfalda-með: (sjálfur - vísir). } × sjálfur. <- samtals.
}.

>> notaðMinni1 := 0.
>> notaðMinni2 := 0.
>> notaðMinni3 := 0.
>> notaðMinni4 := 0.

Forrit minnisstjórnun: 0.

{
2 veldisvísir aðfeldi.
Úttak skrifa: (11 leif: 3), ný-lína.
Úttak skrifa: (3.4 námunda), ný-lína.
Úttak skrifa: (7.1 námunda-upp), ný-lína.
Úttak skrifa: (7.9 námunda-niður), ný-lína.
}
ræsa.

Forrit taka-til.

notaðMinni1 := (Forrit minni ? 0).

{
2 veldisvísir aðfeldi.
Úttak skrifa: (11 leif: 3), ný-lína.
Úttak skrifa: (3.4 námunda), ný-lína.
Úttak skrifa: (7.1 námunda-upp), ný-lína.
Úttak skrifa: (7.9 námunda-niður), ný-lína.
}
ræsa.

Forrit taka-til.
notaðMinni2 := (Forrit minni ? 0).


{
2 veldisvísir aðfeldi.
Úttak skrifa: (11 leif: 3), ný-lína.
Úttak skrifa: (3.4 námunda), ný-lína.
Úttak skrifa: (7.1 námunda-upp), ný-lína.
Úttak skrifa: (7.9 námunda-niður), ný-lína.
} ræsa.

Forrit taka-til.
notaðMinni3 := (Forrit minni ? 0).



( notaðMinni1 = notaðMinni2 og: notaðMinni1 = notaðMinni3, og: notaðMinni2 = notaðMinni3 ) satt: {
	Úttak skrifa: ['Enginn minnisleki hér'].
}, rangt: {
	Úttak skrifa: ['Minni lekur...'].
}.
