Tala við: ['factorial'] gera: {
	>> total := 1.
	{ :index total margfalda-með: (sjálfur - index). } × sjálfur. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Forrit minnisstjórnun: 0.

{
2 exponent factorial.
Úttak skrifa: (11 leif: 3), ný-lína.
Úttak skrifa: (3.4 námunda), ný-lína.
Úttak skrifa: (7.1 námunda-upp), ný-lína.
Úttak skrifa: (7.9 námunda-niður), ný-lína.
}
ræsa.

Forrit taka-til.

usedMemory1 := (Forrit minni ? 0).

{
2 exponent factorial.
Úttak skrifa: (11 leif: 3), ný-lína.
Úttak skrifa: (3.4 námunda), ný-lína.
Úttak skrifa: (7.1 námunda-upp), ný-lína.
Úttak skrifa: (7.9 námunda-niður), ný-lína.
}
ræsa.

Forrit taka-til.
usedMemory2 := (Forrit minni ? 0).


{
2 exponent factorial.
Úttak skrifa: (11 leif: 3), ný-lína.
Úttak skrifa: (3.4 námunda), ný-lína.
Úttak skrifa: (7.1 námunda-upp), ný-lína.
Úttak skrifa: (7.9 námunda-niður), ný-lína.
} ræsa.

Forrit taka-til.
usedMemory3 := (Forrit minni ? 0).



( usedMemory1 = usedMemory2 og: usedMemory1 = usedMemory3, og: usedMemory2 = usedMemory3 ) satt: {
	Úttak skrifa: ['No memory leaks here'].
}, rangt: {
	Úttak skrifa: ['Leaking memory...'].
}.
