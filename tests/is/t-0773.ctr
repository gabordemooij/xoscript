Úttak skrifa: ['Test object'], ný-lína.
>> a := Hlutur nýtt. 
a við: ['item:'] gera: { :int64
	eigin int64 := int64. 
}.
a við: ['item'] gera: { <- eigin int64.
}.
a item: ( Int64 úr-texta: ['9999'] ).
Úttak skrifa: a item, ný-lína.
>> old-int64-address := a item frumgerð minnisvistfang.
a save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== RELOADING SNAP:'], ný-lína.
>> b := Hlutur load-from: ['/tmp/a.bin'].
(b item frumgerð minnisvistfang = old-int64-address) satt: {
	Úttak skrifa: ['Object link re-attached.'], ný-lína.
}.
Úttak skrifa: ( b item ), ný-lína.
