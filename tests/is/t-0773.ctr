Úttak skrifa: ['Prófunarhlutur'], ný-lína.
>> a := Hlutur nýtt. 
a við: ['item:'] gera: { :int64
	eigin int64 := int64. 
}.
a við: ['liður'] gera: {
	<- eigin int64.
}.
a item: ( Int64 úr-texta: ['9999'] ).
Úttak skrifa: a liður, ný-lína.
>> gamalt-int64-vistfang := a liður frumgerð minnisvistfang.
a save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== ENDURHLEÐ SNAP:'], ný-lína.
>> b := Hlutur load-from: ['/tmp/a.bin'].
(b liður frumgerð minnisvistfang = gamalt-int64-vistfang) satt: {
	Úttak skrifa: ['Hlutartengill tengdur aftur.'], ný-lína.
}.
Úttak skrifa: ( b liður ), ný-lína.
