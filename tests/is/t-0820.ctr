# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Mynstur nýtt: pattern.
	p samsvörun: subject gera: { :m :g
		Úttak skrifa: g fjöldi, skrifa: [' '], skrifa: (g sameina: ['|']), ný-lína. <- m.
	}.
}.
show beita: ['(a)|(b)'] og: ['b'].
show beita: ['(a)|(b)'] og: ['a'].
show beita: ['(x)?y'] og: ['y'].
show beita: ['(x)?(y)(z)?'] og: ['xy'].
