# hópur sem er ekki hluti af samsvöruninni má ekki valda hruni og verður að halda hópnúmerunum
Server init.
>> sýna := { :mynstrið :subject
	>> p := Mynstur nýtt: mynstrið.
	p samsvörun: subject gera: { :m :g
		Úttak skrifa: g fjöldi, skrifa: [' '], skrifa: (g sameina: ['|']), ný-lína.
		<- m.
	}.
}.
sýna beita: ['(a)|(b)'] og: ['b'].
sýna beita: ['(a)|(b)'] og: ['a'].
sýna beita: ['(x)?y'] og: ['y'].
sýna beita: ['(x)?(y)(z)?'] og: ['xy'].
