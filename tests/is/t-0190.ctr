#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Forrit minnisstjórnun: 0.

{
Stund tími.
Stund bíða: 1.
Úttak skrifa: Forrit viðföng, ný-lína.
Forrit viðfang: 0.
Tala random.
Úttak skrifa: (Forrit kerfi: ['echo 'Hello'']).
} ræsa.

Forrit taka-til.
usedMemory1 := (Forrit minni ? 0).

{
Stund tími.
Stund bíða: 1.
Úttak skrifa: Forrit viðföng, ný-lína.
Forrit viðfang: 0.
Tala random.
Úttak skrifa: (Forrit kerfi: ['echo 'Hello'']).
} ræsa.

Forrit taka-til.
usedMemory2 := (Forrit minni ? 0).

{
Stund tími.
Stund bíða: 1.
Úttak skrifa: Forrit viðföng, ný-lína.
Forrit viðfang: 0.
Tala random.
Úttak skrifa: (Forrit kerfi: ['echo 'Hello'']).
} ræsa.

Forrit taka-til.
usedMemory3 := (Forrit minni ? 0).



( usedMemory1 = usedMemory2 og: usedMemory1 = usedMemory3, og: usedMemory2 = usedMemory3 ) satt: {
	Úttak skrifa: ['No memory leaks here'].
}, rangt: {
	Úttak skrifa: ['Leaking memory...'].
}.
