>> numbers := ['1,2,3'] kljúfa: [','].
Úttak skrifa: ['I got: '] + numbers fjöldi + [' numbers.'],ný-lína.
{ :i Úttak skrifa: ['number #'] + i + [':'] + (numbers staða: i), ný-lína.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages kljúfa: [' Or '].
Úttak skrifa: ['We serve'], ný-lína.
{ :i Úttak skrifa: ['->'] + (beverages staða: i), ný-lína. } × (beverages fjöldi).
Úttak skrifa: (beverages sameina: [',']), ný-lína.
Úttak skrifa: (numbers sameina: ['||']).
