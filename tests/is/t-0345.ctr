# test catch-all methods
>> x13 := Hlutur nýtt.
x13 við: ['a'] gera: { :a Úttak skrifa: 0, ný-lína. }.
x13 við: ['a:'] gera: { :a Úttak skrifa: a, ný-lína. <- 5. }.
x13 við: ['a:b:'] gera: { :a :b Úttak skrifa: (a + b), ný-lína. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
