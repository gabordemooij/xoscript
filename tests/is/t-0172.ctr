

>> notaðMinni1 := 0.
>> notaðMinni2 := 0.
>> notaðMinni3 := 0.
>> notaðMinni4 := 0.

Forrit minnisstjórnun: 0.

>> a := Listi ← ['hello'] ; ['world'] ; Satt ; Ekkert ; 666.
>> b := a frá: 2 lengd: 2.
Úttak skrifa: ( b sameina: ['|'] ), skrifa: b fjöldi.

Forrit taka-til.
notaðMinni1 := (Forrit minni ? 0).


a := Listi ← ['hello'] ; ['world'] ; Satt ; Ekkert ; 666.
b := a frá: 2 lengd: 2.
Úttak skrifa: ( b sameina: ['|'] ), skrifa: b fjöldi.


Forrit taka-til.
notaðMinni2 := (Forrit minni ? 0).


a := Listi ← ['hello'] ; ['world'] ; Satt ; Ekkert ; 666.
b := a frá: 2 lengd: 2.
Úttak skrifa: ( b sameina: ['|'] ), skrifa: b fjöldi.


Forrit taka-til.
notaðMinni3 := (Forrit minni ? 0).



( notaðMinni1 = notaðMinni2 og: notaðMinni1 = notaðMinni3, og: notaðMinni2 = notaðMinni3 ) satt: {
	Úttak skrifa: ['Enginn minnisleki hér'].
}, rangt: {
	Úttak skrifa: ['Minni lekur...'].
}.
