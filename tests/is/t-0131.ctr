
>> a := Listi ← (Listi ← 100 ; 200 ; 300) ; (Listi ← 9 ; 8 ; 7).
Úttak skrifa: ['at 0,1 :'].
Úttak skrifa: a ? 0 ? 1, ný-lína. 
Úttak skrifa: ['at 1,2 :'].
Úttak skrifa: a ? 1 ? 2, ný-lína. 
>> menu := Orðabók nýtt.
menu setja: (Listi ← ['pizza'] ; ['spaghetti']) við: ['Italian Cuisine'].
menu setja: (Listi ← ['bifteki'] ; ['suflaki']) við: ['Greek Cuisine'].
Úttak skrifa: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), ný-lína. 
Úttak skrifa: ['but not on the same plate.'], ný-lína.
