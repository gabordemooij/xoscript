Úttak skrifa: ['Test object'], ný-lína.
>> a := Hlutur nýtt. 

a við: ['item:'] gera: { :hexhelper
	eigin hexhelper := hexhelper. 
}.

a við: ['item'] gera: { <- eigin hexhelper.
}.

a item: Hx nýtt.

>> old-hexhelper-address := a item frumgerð minnisvistfang.
a save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== RELOADING SNAP:'], ný-lína.

>> b := Hlutur load-from: ['/tmp/a.bin'].

(b item frumgerð minnisvistfang = old-hexhelper-address) satt: {
	Úttak skrifa: ['Object link re-attached.'], ný-lína.
}.
