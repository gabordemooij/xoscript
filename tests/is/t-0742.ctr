Úttak skrifa: ['Prófunarhlutur'], ný-lína.
>> a := Hlutur nýtt. 

a við: ['item:'] gera: { :hexhjálpari
	eigin hexhjálpari := hexhjálpari. 
}.

a við: ['liður'] gera: {
	<- eigin hexhjálpari.
}.

a item: Hx nýtt.

>> gamalt-hexhjálpari-vistfang := a liður frumgerð minnisvistfang.
a save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== ENDURHLEÐ SNAP:'], ný-lína.

>> b := Hlutur load-from: ['/tmp/a.bin'].

(b liður frumgerð minnisvistfang = gamalt-hexhjálpari-vistfang) satt: {
	Úttak skrifa: ['Hlutartengill tengdur aftur.'], ný-lína.
}.
