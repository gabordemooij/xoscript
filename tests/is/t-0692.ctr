Server init.

Úttak skrifa: (
	Mynstur nýtt: ['^\\w+$'],
	samsvörun: ['test@example.com'] 
), ný-lína. # 0 samsvaranir, mistekst á @ og .

Úttak skrifa: (
	Mynstur nýtt: ['^[^@]+@[^\.]+\.\\w+$'],
	samsvörun: ['test@example.com'] 
), ný-lína. # 1 samsvörun

Úttak skrifa: (
	Mynstur nýtt: ['[^@]+@[^\.]+\.\\w+'],
	samsvörun: ['test@example.com'] 
), ný-lína. # 1 samsvörun

Úttak skrifa: (
	Mynstur nýtt: ['([^@]+)@([^\.]+)\.\\w+'],
	samsvörun: ['test@example.com'] 
), ný-lína. # 1 samsvörun, hópar skipta ekki máli

Úttak skrifa: (
	Mynstur nýtt: ['[a-z]'],
	samsvörun: ['test@example.com'] 
), ný-lína. # 14 samsvaranir

Úttak skrifa: (
	Mynstur nýtt: ['.*'],
	samsvörun: ['test@example.com'] 
), ný-lína. # 1 samsvörun (allt)

Úttak skrifa: (
	Mynstur nýtt: ['(.*)'],
	samsvörun: ['test@example.com'] 
), ný-lína. # 1 samsvörun (allt)

Úttak skrifa: (
	Mynstur nýtt: ['\\s*[^@]+@[^\.]+\.\\w+'],
	samsvörun: ['test@example.com'] 
), ný-lína. # 1 samsvörun, bil á undan valfrjálst, er hunsað