Server init.

Úttak skrifa: (
	Mynstur nýtt: ['^\\w+$'],
	samsvörun: ['test@example.com'] 
), ný-lína. # 0 match, fails on @ and .

Úttak skrifa: (
	Mynstur nýtt: ['^[^@]+@[^\.]+\.\\w+$'],
	samsvörun: ['test@example.com'] 
), ný-lína. # 1 match

Úttak skrifa: (
	Mynstur nýtt: ['[^@]+@[^\.]+\.\\w+'],
	samsvörun: ['test@example.com'] 
), ný-lína. # 1 match

Úttak skrifa: (
	Mynstur nýtt: ['([^@]+)@([^\.]+)\.\\w+'],
	samsvörun: ['test@example.com'] 
), ný-lína. # 1 match, groups dont matter

Úttak skrifa: (
	Mynstur nýtt: ['[a-z]'],
	samsvörun: ['test@example.com'] 
), ný-lína. # 14 matches

Úttak skrifa: (
	Mynstur nýtt: ['.*'],
	samsvörun: ['test@example.com'] 
), ný-lína. # 1 match (all)

Úttak skrifa: (
	Mynstur nýtt: ['(.*)'],
	samsvörun: ['test@example.com'] 
), ný-lína. # 1 match (all)

Úttak skrifa: (
	Mynstur nýtt: ['\\s*[^@]+@[^\.]+\.\\w+'],
	samsvörun: ['test@example.com'] 
), ný-lína. # 1 match, prefix space optional, gets ignored