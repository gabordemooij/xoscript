Úttak skrifa: ['Prófunarhlutur'], ný-lína.
>> l := Listi nýtt ; 1 ; ( Listi nýtt ; (Stund nýtt: 1) ; (Int64 úr-texta: ['321']) ; (Listi nýtt ; 3)).
Úttak skrifa: l, ný-lína.
>> gamalt-lst-vistfang := l frumgerð minnisvistfang.
l save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== ENDURHLEÐ SNAP:'], ný-lína.
>> b := Hlutur load-from: ['/tmp/a.bin'].
(b frumgerð minnisvistfang = gamalt-lst-vistfang) satt: {
	Úttak skrifa: ['Hlutartengill tengdur aftur.'], ný-lína.
}.
Úttak skrifa: b, ný-lína.
