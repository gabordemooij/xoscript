Úttak skrifa: ['Test object'], ný-lína.
>> l := Listi nýtt ; 1 ; ( Listi nýtt ; (Stund nýtt: 1) ; (Int64 úr-texta: ['321']) ; (Listi nýtt ; 3)).
Úttak skrifa: l, ný-lína.
>> old-lst-address := l frumgerð minnisvistfang.
l save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== RELOADING SNAP:'], ný-lína.
>> b := Hlutur load-from: ['/tmp/a.bin'].
(b frumgerð minnisvistfang = old-lst-address) satt: {
	Úttak skrifa: ['Object link re-attached.'], ný-lína.
}.
Úttak skrifa: b, ný-lína.
