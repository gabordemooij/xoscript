# Hvelfing-lyklar og -undirskriftir sem afkóðast of langir mega ekki flæða yfir staflann
Server init.

>> lyklar := Hvelfing búa-til-lykla.
>> sk := lyklar fyrsta.
>> pk := lyklar síðasta.
>> sig := Hvelfing undirrita: ['abc'] með: sk.

# 88 stafir án fyllingar afkóðast í 66 bæti
>> langur := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 stafir án fyllingar afkóðast í 33 bæti
>> stuttur := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Hvelfing undirrita: ['abc'] með: langur. } grípa: { :e
	Úttak skrifa: e, ný-lína.
}, ræsa.

{ Hvelfing athuga: ['abc'] undirskrift: langur með: pk. } grípa: { :e
	Úttak skrifa: e, ný-lína.
}, ræsa.

{ Hvelfing athuga: ['abc'] undirskrift: sig með: stuttur. } grípa: { :e
	Úttak skrifa: e, ný-lína.
}, ræsa.
