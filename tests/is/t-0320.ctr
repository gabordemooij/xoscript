


>> Kaffivél := Hlutur nýtt.
Kaffivél við: ['order:'] gera: { :id
	>> coffee := ['Americano'].
	( id = 1 ) satt: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) satt: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) satt: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> EinfaldKaffivél := Hlutur nýtt.
EinfaldKaffivél við: ['pöntun'] gera: { <- ['Svart']. }.
>> rauðurBolli := Kaffivél order: 1.
Úttak skrifa: rauðurBolli, ný-lína.
rauðurBolli := ['Te']. 
>> grænnBolli := Kaffivél order: 0.
Úttak skrifa: grænnBolli, ný-lína.
>> gulurBolli := Kaffivél order: 1.
Úttak skrifa: gulurBolli, ný-lína.
>> blárBolli := Kaffivél order: 0.
Úttak skrifa: blárBolli, ný-lína.
>> plastBolli := EinfaldKaffivél pöntun.
plastBolli := ['Límonaði']. 
>> svarturBolli := EinfaldKaffivél pöntun.
Úttak skrifa: svarturBolli, ný-lína.
svarturBolli bæta-aftast: [' neiii.... bjór. '].
>> appelsínugulurBolli := EinfaldKaffivél pöntun.
Úttak skrifa: appelsínugulurBolli, ný-lína.
