


>> CoffeeMachine := Hlutur nýtt.
CoffeeMachine við: ['order:'] gera: { :id
	>> coffee := ['Americano'].
	( id = 1 ) satt: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) satt: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) satt: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Hlutur nýtt.
SimpleCoffeeMachine við: ['order'] gera: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Úttak skrifa: redCup, ný-lína.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Úttak skrifa: greenCup, ný-lína.
>> yellowCup := CoffeeMachine order: 1.
Úttak skrifa: yellowCup, ný-lína.
>> blueCup := CoffeeMachine order: 0.
Úttak skrifa: blueCup, ný-lína.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Úttak skrifa: blackCup, ný-lína.
blackCup bæta-aftast: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Úttak skrifa: orangeCup, ný-lína.
