Server init.
>> fmt := Snið nýtt: ['%#3x'].

>> blob := Blob nýtt: 4.
blob bytes: ( 
	Listi nýtt ; 0 ; 1 ; 2 ; 3
).

>> file := Skrá nýtt: ['/tmp/blob'].
file blob: blob.
blob losa.

>> lesa := file blob.
lesa 
frá: 0 
lengd: 4, 
gera hver: { :i :b 
	Úttak
	skrifa: (fmt beita-heiltölu: b),
	ný-lína.
}.
lesa losa.
