#Linux

(Skrá nýtt: ['/tmp/testje']) er-til rangt: {
	Forrit kerfi: ['mkdir /tmp/testje'].	
}.

(Skrá nýtt: ['/tmp/testje/file1']) er-til rangt: {
	Forrit kerfi: ['touch /tmp/testje/file1'].	
}.

(Skrá nýtt: ['/tmp/testje/folder1']) er-til rangt: {
	Forrit kerfi: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Skrá listi: ['/tmp/testje'].

>> q := Listi nýtt.

l hver: { :k :v v hver: { :x :y q bæta-aftast: y. }. }.

>> s := q texti.

(s inniheldur: ['file1']) satt:   { Úttak skrifa: ['OK'], ný-lína. }.
(s inniheldur: ['file2']) satt:   { Úttak skrifa: ['XX'], ný-lína. }.
(s inniheldur: ['folder1']) satt: { Úttak skrifa: ['OK'], ný-lína. }.
