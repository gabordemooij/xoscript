# prófa listaaðgerðir


>> kökur := Listi ←
	['apple'] ;
	['ber'] ;
	['súkkó'] ;
	['ostur'].


>> kaupa := kökur skipta: 1 lengd: 2 fyrir: ( Listi ← ['kanill'] ; ['ananas'] ).
Úttak skrifa: (kaupa sameina: [',']), ný-lína.


>> kaupa := kökur skipta: 1 lengd: 12 fyrir: ( Listi ← ['kanill'] ; ['ananas'] ).
Úttak skrifa: (kaupa sameina: [',']), ný-lína.


>> kaupa := kökur skipta: 2 lengd: 10 fyrir: ( Listi nýtt ).
Úttak skrifa: (kaupa sameina: [',']), ný-lína.


>> kaupa := kökur skipta: 0 lengd: 1 fyrir: ( Listi nýtt ).
Úttak skrifa: (kaupa sameina: [',']), ný-lína.


>> kaupa := kökur skipta: ['0'] lengd: ['1'] fyrir: ['x'].
Úttak skrifa: (kaupa sameina: [',']), ný-lína.
