# test list operations


>> cakes := Listi ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes skipta: 1 lengd: 2 fyrir: ( Listi ← ['cinnamon'] ; ['pineapple'] ).
Úttak skrifa: (buy sameina: [',']), ný-lína.


>> buy := cakes skipta: 1 lengd: 12 fyrir: ( Listi ← ['cinnamon'] ; ['pineapple'] ).
Úttak skrifa: (buy sameina: [',']), ný-lína.


>> buy := cakes skipta: 2 lengd: 10 fyrir: ( Listi nýtt ).
Úttak skrifa: (buy sameina: [',']), ný-lína.


>> buy := cakes skipta: 0 lengd: 1 fyrir: ( Listi nýtt ).
Úttak skrifa: (buy sameina: [',']), ný-lína.


>> buy := cakes skipta: ['0'] lengd: ['1'] fyrir: ['x'].
Úttak skrifa: (buy sameina: [',']), ný-lína.
