

Listi við: ['fixture:'] gera: { :f
	eigin fixture := f.
}.

Listi við: ['fjöldi'] gera: { <- eigin fixture.
}.

Listi við: ['aantal'] gera: { <- eigin fixture.
}.


>> x := Ekkert.
{

	x := ['hello'] 
	skipta:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] stafur: 2)
			)
		)
	fyrir: (
		(['...hal'] + ['lo']) 
			hástafir 
			lowecase 
			hástafir 
			hliðrun: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Listi ← 0 ; 1 ; 4; 9 ; (Listi ← 0 ; 3; 1) ; 4
							) næstsíðasta
						) ? 1
					) + 
					((Listi ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					fjöldi
				)
			)
	).

} × 10.
Úttak skrifa: x, ný-lína.

