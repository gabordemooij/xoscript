# test number -> string -> number
{

	>> x := Tala milli: 0 og: 1000000.
	>> d := Tala milli: 1 og: 7.
	>> e := 10 veldi: d.

	x deila-með: e.
	>> y := x texti tala.

	(x = y) rangt: {
		Úttak skrifa: x, ný-lína.
		Úttak skrifa: y, ný-lína.
		Forrit enda.
	}.

} * 1000.
Úttak skrifa: ['OK'], ný-lína.