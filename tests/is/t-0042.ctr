>> items := Orðabók nýtt.
items setja: ['svart'] við: ['coffee'], setja: ['earl grey'] við: ['te'].
Úttak skrifa: (items við: ['coffee']), skrifa: (items við: ['te']).
Úttak skrifa: ['það eru'] + items fjöldi + [' atriði í listanum.'].
items setja: ['cappuccino'] við: ['coffee'].
Úttak skrifa: ['Nú er kaffið mitt.. '] + (items við: ['coffee']).
items setja: ['aaa'] við: ['1'].
items setja: ['bbb'] við: ['2'].
Úttak skrifa: (items við: ['a']).
