>> items := Orðabók nýtt.
items setja: ['black'] við: ['coffee'], setja: ['earl grey'] við: ['tea'].
Úttak skrifa: (items við: ['coffee']), skrifa: (items við: ['tea']).
Úttak skrifa: ['there are'] + items fjöldi + [' items in the array.'].
items setja: ['capuccino'] við: ['coffee'].
Úttak skrifa: ['Now my coffee is.. '] + (items við: ['coffee']).
items setja: ['aaa'] við: ['1'].
items setja: ['bbb'] við: ['2'].
Úttak skrifa: (items við: ['a']).
