
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> kóði := {
	>> o := (
		Orðabók nýtt
		aa: (Listi ← 1 ; 2),
		bb: (Listi ← 3 ; 4)
	).
	>> s := o texti.
	>> o2 := s hlutur.
	(s  gerð = Texti gerð) satt: { Úttak skrifa: ['OK1'], ný-lína. }.
	(o2 gerð = Orðabók gerð) satt: { Úttak skrifa: ['OK2'], ný-lína. }.
}.

Forrit minnisstjórnun: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Forrit taka-til.
usedMemory1 := (Forrit minni ? 1).
kóði ræsa.
Forrit taka-til.
usedMemory2 := (Forrit minni ? 1).
kóði ræsa.
Forrit taka-til.
usedMemory3 := (Forrit minni ? 1).
kóði ræsa.
Forrit taka-til.
usedMemory4 := (Forrit minni ? 1).

(usedMemory2 = usedMemory3 = usedMemory4) satt: { Úttak skrifa: ['OK3'], ný-lína. }.
 
