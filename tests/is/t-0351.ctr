
>> notaðMinni1 := 0.
>> notaðMinni2 := 0.
>> notaðMinni3 := 0.
>> notaðMinni4 := 0.

>> kóði := {
	>> o := (
		Orðabók nýtt
		aa: (Listi ← 1 ; 2),
		bb: (Listi ← 3 ; 4)
	).
	>> s := o texti.
	>> o2 := s hlutur.
	(s  gerð = Texti gerð) satt: { Úttak skrifa: ['OK1'], ný-lína. }.
	(o2 gerð = Orðabók gerð) satt: { Úttak skrifa: ['OK2'], ný-lína. }.
}.

Forrit minnisstjórnun: 0.
['Minni 1 verður öðruvísi því raktar blokkir bætast við í einu lagi.'].
Forrit taka-til.
notaðMinni1 := (Forrit minni ? 1).
kóði ræsa.
Forrit taka-til.
notaðMinni2 := (Forrit minni ? 1).
kóði ræsa.
Forrit taka-til.
notaðMinni3 := (Forrit minni ? 1).
kóði ræsa.
Forrit taka-til.
notaðMinni4 := (Forrit minni ? 1).

(notaðMinni2 = notaðMinni3 = notaðMinni4) satt: { Úttak skrifa: ['OK3'], ný-lína. }.
 
