>> HTML := Hlutur nýtt.
HTML við: ['svara:'] gera: { :merkið 
	Úttak skrifa: (['<tag>'] tag: merkið), ný-lína.
}.
HTML við: ['svara:og:'] gera: { :merkið :html 
	Úttak skrifa: (
		['<tag>innerHTML</tag>']
		tag: merkið - [':'],
		innerHTML: html
	), ný-lína.
}.
>> html := HTML nýtt.
html body h1: ['header'].

