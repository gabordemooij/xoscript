


>> Deck := Listi nýtt.
Deck við: ['print'] gera: {
        >> len := sjálfur fjöldi - 1.
        { :i
                >> len2 := sjálfur fjöldi - 1.
                Úttak skrifa: ['len: '].
                Úttak skrifa: len, ný-lína.
                Úttak skrifa: ['len2: '].
                Úttak skrifa: len2, ný-lína.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
