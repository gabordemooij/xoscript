#Linux
>> OS := Forrit stilling: ['OS'].

>> clock := Stund nýtt.
	
(OS = ['Haiku']) satt: {
	clock svæði: ['CET'],
	ár: 2017, mánuður: 7, dagur: 13,
	klukkustund: 18, mínúta: 0, sekúnda: 0.
}, annars: {
	clock svæði: ['Europe/Amsterdam'],
	ár: 2017, mánuður: 7, dagur: 13,
	klukkustund: 18, mínúta: 0, sekúnda: 0.
}.

clock við: ['tell'] gera: {
	Úttak skrifa: sjálfur, ný-lína.
}.


clock leggja-við: 2    klukkustund, tell.
clock leggja-við: 1    klukkustund, tell.
clock leggja-við: 19 mínúta, tell.
clock leggja-við: 1  mínúta, tell.
clock leggja-við: 1  mínúta, tell.
clock leggja-við: 19 sekúnda, tell.
clock leggja-við: 1  sekúnda, tell.
clock leggja-við: 1  sekúnda, tell.
clock leggja-við: 2    ár, tell.
clock leggja-við: 1    ár, tell.

(OS = ['Haiku']) satt: {
clock leggja-við: 5   mánuður.
clock svæði: ['CEST'], tell.
}, annars: {
	clock leggja-við: 5   mánuður, tell.
}.

clock leggja-við: 1   mánuður, tell.
clock leggja-við: 19    dagur, tell.
clock leggja-við: 1    klukkustund, tell.
clock leggja-við: 120  yard, tell.
