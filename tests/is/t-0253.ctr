#Linux
>> OS := Forrit stilling: ['OS'].

>> klukka := Stund nýtt.
	
(OS = ['Haiku']) satt: {
	klukka svæði: ['CET'],
	ár: 2017, mánuður: 7, dagur: 13,
	klukkustund: 18, mínúta: 0, sekúnda: 0.
}, annars: {
	klukka svæði: ['Europe/Amsterdam'],
	ár: 2017, mánuður: 7, dagur: 13,
	klukkustund: 18, mínúta: 0, sekúnda: 0.
}.

klukka við: ['segja'] gera: {
	Úttak skrifa: sjálfur, ný-lína.
}.


klukka leggja-við: 2    klukkustund, segja.
klukka leggja-við: 1    klukkustund, segja.
klukka leggja-við: 19 mínúta, segja.
klukka leggja-við: 1  mínúta, segja.
klukka leggja-við: 1  mínúta, segja.
klukka leggja-við: 19 sekúnda, segja.
klukka leggja-við: 1  sekúnda, segja.
klukka leggja-við: 1  sekúnda, segja.
klukka leggja-við: 2    ár, segja.
klukka leggja-við: 1    ár, segja.

(OS = ['Haiku']) satt: {
klukka leggja-við: 5   mánuður.
klukka svæði: ['CEST'], segja.
}, annars: {
	klukka leggja-við: 5   mánuður, segja.
}.

klukka leggja-við: 1   mánuður, segja.
klukka leggja-við: 19    dagur, segja.
klukka leggja-við: 1    klukkustund, segja.
klukka leggja-við: 120  yard, segja.
