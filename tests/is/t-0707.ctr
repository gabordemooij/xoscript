# prófa gerðarbreytingar / umbreytingar / bindingar
Forrit minnisstjórnun: 4.
Server init.

>> teljari := 0.
>> gg := Maria-DB nýtt hýsill: ['localhost'],
	notandanafn: ['xo'], lykilorð: ['pass123'], nafn-gagnagrunns: ['xobase'], tengjast.

>> TveggjaStafaSnið := Snið nýtt: ['%02d'].

# Dagsetning og tími
{
	>> ár     := Tala milli: 1995 og: 2050, texti.
	>> mánuður    := TveggjaStafaSnið beita-heiltölu: (Tala milli: 1 og: 12), texti.
	>> dagur      := TveggjaStafaSnið beita-heiltölu: (Tala milli: 1 og: 28), texti.
	>> klukkustund     := TveggjaStafaSnið beita-heiltölu: (Tala milli: 1 og: 23), texti.
	>> mínúta   := TveggjaStafaSnið beita-heiltölu: (Tala milli: 1 og: 59), texti.
	>> sekúnda   := TveggjaStafaSnið beita-heiltölu: (Tala milli: 1 og: 59), texti.
	>> datetime := ['YYYY-MM-DD HH:II:SS'].	
	datetime
		YYYY: ár,
		MM: mánuður,
		DD: dagur,
		HH: klukkustund,
		II: mínúta,
		SS: sekúnda.
	>> leitarfæribreytur :=
	gg fyrirspurn: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: datetime),
	sækja: { :röð
		(röð mydatetime = datetime) rangt: {
			þetta-verk villa: (
				['Bjóst við: <expected> en fékk: <observation>']
				<expected>: datetime,
				<observation>: röð mydatetime
			).
		}.
	
	}.
	teljari leggja-við: 1.
} * 100.

# Dagsetning
{
	>> ár     := Tala milli: 1995 og: 2050, texti.
	>> mánuður    := TveggjaStafaSnið beita-heiltölu: (Tala milli: 1 og: 12), texti.
	>> dagur      := TveggjaStafaSnið beita-heiltölu: (Tala milli: 1 og: 28), texti.
	>> date     := ['YYYY-MM-DD'].
	date
		YYYY: ár,
		MM: mánuður,
		DD: dagur.
	>> leitarfæribreytur :=
	gg fyrirspurn: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: date),
	sækja: { :röð
		(röð mydate = date) rangt: {
			þetta-verk villa: (
				['Bjóst við: <expected> en fékk: <observation>']
				<expected>: date,
				<observation>: röð mydate
			).
		}.
	}.
	teljari leggja-við: 1.
} * 100.


# Tími
{
	>> klukkustund     := TveggjaStafaSnið beita-heiltölu: (Tala milli: 1 og: 23), texti.
	>> mínúta   := TveggjaStafaSnið beita-heiltölu: (Tala milli: 1 og: 59), texti.
	>> sekúnda   := TveggjaStafaSnið beita-heiltölu: (Tala milli: 1 og: 59), texti.
	>> tími := ['HH:II:SS'].
	tími
		HH: klukkustund,
		II: mínúta,
		SS: sekúnda.
	>> leitarfæribreytur :=
	gg fyrirspurn: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: tími),
	sækja: { :röð
		(röð mytime = tími) rangt: {
			þetta-verk villa: (
				['Bjóst við: <expected> en fékk: <observation>']
				<expected>: datetime,
				<observation>: röð mytime
			).
		}.
	}.
	teljari leggja-við: 1.
} * 100.


# Textar (varchar/text)
>> str1 := Listi nýtt fylla: 100000 með: ['x'], sameina: [''].
{
	>> str2 := Hvelfing tóki: 40.
	>> leitarfæribreytur :=
	gg fyrirspurn: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	sækja: { :röð
		(röð str1 = str1 og: röð str2 = str2) rangt: {
			þetta-verk villa: (
				['Bjóst við: <expected> en fékk: <observation>']
				<expected>: datetime,
				<observation>: röð mytime
			).
		}.
	}.
	teljari leggja-við: 1.
} * 100.


# Tölur
{
	>> n1  := Tala milli: 1 og: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 úr-texta: ['9223372036854775807'] ) -
		( Int64 úr-texta: ['99999'] ) +
		( Int64 úr-texta: n1 texti )
	).
	>> leitarfæribreytur :=
	gg fyrirspurn: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	sækja: { :röð
		(röð n1 = n1) rangt: {
			þetta-verk villa: (
				['Bjóst við: <expected> en fékk: <observation>']
				<expected>: n1,
				<observation>: röð n1
			).
		}.
		(röð n2 = n2) rangt: {
			þetta-verk villa: (
				['Bjóst við: <expected> en fékk: <observation>']
				<expected>: n1,
				<observation>: röð n2
			).
		}.
		(röð n3 = n2 námunda) rangt: {
			þetta-verk villa: (
				['Bjóst við: <expected> en fékk: <observation>']
				<expected>: n1,
				<observation>: röð n3
			).
		}.
		(röð big = big) rangt: {
			þetta-verk villa: (
				['Bjóst við: <expected> en fékk: <observation>']
				<expected>: big,
				<observation>: röð big
			).
		}.
		
	}.
	teljari leggja-við: 1.
} * 100.


Úttak skrifa: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: teljari
), ný-lína.