
>> Size := Hlutur nýtt.
Size við: ['is:'] gera: { :tala
	tala við: ['+'] gera: { :tala
		>> unit := tala tilgreining.
		>> factor := 1.
		
		unit
		tilvik: ['inch'] gera: { factor := 0.0833. }. <- sjálfur + (tala * factor).
	}. <- tala.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Úttak skrifa: plank + edge, ný-lína.
