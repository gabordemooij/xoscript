
>> Mál := Hlutur nýtt.
Mál við: ['is:'] gera: { :tala
	tala við: ['+'] gera: { :tala
		>> eining := tala tilgreining.
		>> stuðull := 1.
		
		eining
		tilvik: ['inch'] gera: { stuðull := 0.0833. }.

		<- sjálfur + (tala * stuðull).
	}.
	<- tala.
}.

# Þessa stærðartölu má nota svona:

>> planki := Mál is: 6 foot.
>> kantur := Mál is: 50 inch.

# Þetta birtist sem: 10.165
Úttak skrifa: planki + kantur, ný-lína.
