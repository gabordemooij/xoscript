

Texti við: ['meta'] gera: {
	>> kóði := Skrá nýtt: ['/tmp/eval.ctr'].
	kóði skrifa: (sjálfur texti + ['.']).
	Forrit nota: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Listi ← (['Gæsalappir '] + Q + [' eru illar?']) ; 1.
>> x := q texti.
Úttak skrifa: x, ný-lína.
>> y := Ekkert.
(['y := '] + x ) meta.
Úttak skrifa: y ? 0, ný-lína.

q := Orðabók setja: ['\[''] við: ['\['quote\']'].
x := q texti.
Úttak skrifa: x, ný-lína.
y := Ekkert.
(['y := '] + x ) meta.

>> q := (Orðabók nýtt) setja:['\[''] við:['\['quote\[''].
Úttak skrifa: y ? ['\['quote\']'], ný-lína.
