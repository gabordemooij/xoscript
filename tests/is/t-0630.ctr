#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Mynstur nýtt: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern samsvörun: subject gera: { :m :x
	Úttak skrifa: m, ný-lína.
	Úttak skrifa: x, ný-lína. <- ['XXX'].
}.
Úttak skrifa: result, ný-lína.