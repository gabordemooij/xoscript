# Prófa utf8-hreinsi
Server init.

>> utf8tilvik := Orðabók nýtt
	# Aðeins ASCII
	setja: ( Listi nýtt ; 65 ; 65 ; 65 ; 65 ; 0 ) við: ['AAAA'],
	# gild 2-bæta runa
	setja: ( Listi nýtt ; 194 ; 162 ; 0 ) við: ['¢'],
	# Gilt 3-bæta UTF-8
    setja: ( Listi nýtt ; 226 ; 130 ; 172 ; 0 ) við: ['€'],
	# Gilt 4-bæta UTF-8
    setja: ( Listi nýtt ; 240 ; 144 ; 141 ; 136 ; 0 ) við: ['𐍈'],
	# Ógilt framhaldsbæti í runu E2 28 AC -> byrjar 3b runu + 28 rangt framhald + AC framhaldsbæti, en tilheyrir sömu villu
    setja: ( Listi nýtt ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) við: ['A?A'],
	# Of löng kóðun á ASCII 'A' (ætti að verða ?),
    setja: ( Listi nýtt ; 65 ; 193 ; 129 ; 0 ) við: ['A?'],
	# Ógilt fyrsta bæti (0xFF)
    setja: ( Listi nýtt ; 255 ; 0 ) við: ['?'],
	# Ófullgerð fjölbætarruna í lokin
    setja: ( Listi nýtt ; 66 ; 226 ; 0 ) við: ['B?'],
    # Tómur texti
    #put: ( List new ) at: [''],
	# Margar blandaðar runur
    setja: ( Listi nýtt ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) við: ['A€?𐍈B'].
	 
utf8tilvik hver: { :key :value
	>> blob := Blob nýtt: value fjöldi, bytes: value.
	>> str := blob texti.
	(str = key) satt: {
		Úttak skrifa: ['OK'], ný-lína.
	}, annars: {
		Úttak skrifa: ['UTF8 hreinsun mistókst á: '] + key + [' fékk: '] + str, ný-lína.
	}.
	blob losa.
}.
