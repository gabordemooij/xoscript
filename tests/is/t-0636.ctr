# test url parsing

Server init.
>> url := URL úr: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Úttak skrifa: ['scheme = '] + url skema, ný-lína.
Úttak skrifa: ['host = '] + url hýsill, ný-lína.
Úttak skrifa: ['port = '] + url gátt, ný-lína.
Úttak skrifa: ['path = '] + url slóð, ný-lína.
Úttak skrifa: ['query = '] + url leitarfæribreytur, ný-lína.
Úttak skrifa: ['fragment = '] + url akkeri, ný-lína.
