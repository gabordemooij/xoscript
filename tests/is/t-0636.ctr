# prófa þáttun vefslóða

Server init.
>> url := URL úr: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Úttak skrifa: ['skema = '] + url skema, ný-lína.
Úttak skrifa: ['hýsill = '] + url hýsill, ný-lína.
Úttak skrifa: ['gátt = '] + url gátt, ný-lína.
Úttak skrifa: ['slóð = '] + url slóð, ný-lína.
Úttak skrifa: ['fyrirspurn = '] + url leitarfæribreytur, ný-lína.
Úttak skrifa: ['akkeri = '] + url akkeri, ný-lína.
