Úttak skrifa: ((Listi nýtt
	við: ['plaque:'] gera: { :x eigin o := x. },
	við: ['plaque']  gera: { <- eigin o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Listi ← 1)
	~ (Listi ← 1 ; 2)
	~ (Listi ← 1 ; 2 ; 3)
	~ (Listi ← 1 ; 2 ; 3 ; 4)
	~ (Listi ← 1 ; 2 ; 3 ; 4 ; 5)
) hver: { :i :el
	{ Úttak skrifa: þetta-verk. } × el fjöldi.
	Úttak ný-lína.
}) plaque, ný-lína.


