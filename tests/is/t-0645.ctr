>> gg := Maria-DB nýtt hýsill: ['localhost'],
	notandanafn: ['xo'], 
	lykilorð: ['pass123'],
	nafn-gagnagrunns: ['xobase'],
	tengjast.

>> leitarfæribreytur :=
gg fyrirspurn: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
sækja: { :röð
	Úttak skrifa: röð datetest, ný-lína.
}.
