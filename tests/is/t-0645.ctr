Server init.
Úttak skrifa: ['Database date test'], ný-lína.

>> db := Maria-DB nýtt hýsill: ['localhost'],
	notandanafn: ['xo'], 
	lykilorð: ['pass123'],
	nafn-gagnagrunns: ['xobase'],
	tengjast.

>> leitarfæribreytur :=
db fyrirspurn: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
sækja: { :row
	Úttak skrifa: row datetest, ný-lína.
}.
