>> Grandfather := Hlutur nýtt.
Grandfather við: ['greet'] gera: {
	Úttak skrifa: ['Ave!'], ný-lína.
}.
>> Father := Grandfather nýtt.
Father við: ['greet'] gera: {
	Úttak skrifa: ['Hello'], ný-lína.
	sjálfur greet.
}.
>> Son := Father nýtt.
Son við: ['greet'] gera: {
	Úttak skrifa: ['Hi'], ný-lína.
	sjálfur greet.
}.

Son greet.

>> Roundabout := Hlutur nýtt.
Roundabout við: ['circle:'] gera: { :x
	Úttak skrifa: x, ný-lína.
	(x < 3) satt: { sjálfur endurkvæmt circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) satt: { Úttak skrifa: x, ný-lína. x leggja-við: 1.  increment ræsa. }. }.
increment ræsa.