# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Forrit shell-escape: ['abc'].
Úttak skrifa: c, ný-lína.
Úttak skrifa: ( Forrit kerfi: ['echo '] + c ), ný-lína.

c := Forrit shell-escape: ['a'b'c'].
Úttak skrifa: c, ný-lína.
Úttak skrifa: ( Forrit kerfi: ['echo '] + c ), ný-lína.

c := Forrit shell-escape: ['a\'c'].
Úttak skrifa: c, ný-lína.
Úttak skrifa: ( Forrit kerfi: ['echo '] + c ), ný-lína.