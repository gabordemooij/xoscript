
Listi við: ['sum'] gera: {
	>> total := 0.
	sjálfur hver: { :index :element
		total leggja-við: element.
	}. <- total.
}.

>> a := Listi ← 9 ; 8 ; 7.
Úttak skrifa: (a sum), ný-lína. 
>> a := Listi ← 1 ; 9.
Úttak skrifa: (a sum), ný-lína. 
>> a := Listi ← ['o'] ; 2.
Úttak skrifa: (a sum), ný-lína. 
Úttak skrifa: (Listi nýtt sum), ný-lína. 
