Úttak skrifa: ['Test object'], ný-lína.
>> a := Hlutur nýtt. 

a við: ['state:'] gera: { :list
	eigin list := list. 
}.

a við: ['state'] gera: {
	Úttak skrifa: eigin list, ný-lína.
}.

a state: ( Listi nýtt ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== RELOADING SNAP:'], ný-lína.
>> b := Hlutur load-from: ['/tmp/a.bin'].
b state.