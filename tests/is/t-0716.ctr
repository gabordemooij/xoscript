Úttak skrifa: ['Prófunarhlutur'], ný-lína.
>> a := Hlutur nýtt. 

a við: ['state:'] gera: { :list
	eigin list := list. 
}.

a við: ['ástand'] gera: {
	Úttak skrifa: eigin list, ný-lína.
}.

a state: ( Listi nýtt ; ['listaliður'] ; ['liður2'] ).
a ástand.

a save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== ENDURHLEÐ SNAP:'], ný-lína.
>> b := Hlutur load-from: ['/tmp/a.bin'].
b ástand.