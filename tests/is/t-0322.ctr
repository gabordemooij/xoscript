

>> Matryoshka := Hlutur nýtt.
Matryoshka við: ['double:'] gera: { :secret
	eigin secret := secret × 2.
}.
Matryoshka við: ['nýtt:'] gera: { :secret
	>> answer := Ekkert.
	>> t := (secret > 255).
	Úttak skrifa: (secret + [' | '] + t), ný-lína.
	t satt: {
		answer := secret.
	}, annars: {
		answer := Matryoshka endurkvæmt nýtt: (sjálfur double: secret).
	}. <- answer.
}.

>> x := Matryoshka nýtt: 2.
