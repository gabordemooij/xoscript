

>> Matrjoska := Hlutur nýtt.
Matrjoska við: ['double:'] gera: { :leyndarmál
	eigin leyndarmál := leyndarmál × 2.
}.
Matrjoska við: ['nýtt:'] gera: { :leyndarmál
	>> svarið := Ekkert.
	>> t := (leyndarmál > 255).
	Úttak skrifa: (leyndarmál + [' | '] + t), ný-lína.
	t satt: {
		svarið := leyndarmál.
	}, annars: {
		svarið := Matrjoska endurkvæmt nýtt: (sjálfur double: leyndarmál).
	}. <- svarið.
}.

>> x := Matrjoska nýtt: 2.
