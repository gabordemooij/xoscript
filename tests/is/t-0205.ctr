>> str := ['write:'].
Úttak skilaboð: ['skrifa:'] viðföng: (Listi ← ['Hello World']), ný-lína. 

Tala við: ['isbetween:and:'] gera: { :a :b <- ((sjálfur ≥ a) og: (sjálfur ≤ b)).
}.

str := ['isbetween:and:'].
Úttak skrifa: (3 skilaboð: str viðföng: (Listi ← 2 ; 8)), ný-lína.
Úttak skrifa: (3 skilaboð: str viðföng: (Listi ← 1 ; 2)), ný-lína.


>> CoffeeMachine := Hlutur nýtt.
CoffeeMachine við: ['makeCoffeeWithSugar:milk:'] gera: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Listi ← 4 ; 2.
Úttak skrifa: ( CoffeeMachine skilaboð: order viðföng: coffeeConfiguration ), ný-lína.
