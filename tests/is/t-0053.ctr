60 × {
	>> x := (Tala random % 6) + 1.
	(x ≤ 6) rangt: { Úttak skrifa: ['FAIL']. }.
	(x ≥0) rangt: { Úttak skrifa: ['FAIL']. }.
	x := (Tala random % 3) + 1.
	(x < 3) rangt: { Úttak skrifa: ['FAIL']. }.
	(x>-1) rangt: { Úttak skrifa: ['FAIL']. }.
	x := ((Rökgildi flip) tala).
	(x = 0 eða: x = 1) rangt: { Úttak skrifa: ['FAIL']. }.
	x := ((Satt flip) tala).
	(x = 0 eða: x = 1) rangt: { Úttak skrifa: ['FAIL']. }.
	x := (Rökgildi flip annaðhvort: ['HEAD'] eða: ['TAIL']).
	((x = ['HEAD']) eða: (x = ['TAIL'])) rangt: { Úttak skrifa: ['FAIL']. }.
}.
Úttak skrifa: ['DONE'].

