60 × {
	>> x := (Tala handahóf % 6) + 1.
	(x ≤ 6) rangt: { Úttak skrifa: ['MISTÓKST']. }.
	(x ≥0) rangt: { Úttak skrifa: ['MISTÓKST']. }.
	x := (Tala handahóf % 3) + 1.
	(x < 3) rangt: { Úttak skrifa: ['MISTÓKST']. }.
	(x>-1) rangt: { Úttak skrifa: ['MISTÓKST']. }.
	x := ((Rökgildi kasta) tala).
	(x = 0 eða: x = 1) rangt: { Úttak skrifa: ['MISTÓKST']. }.
	x := ((Satt kasta) tala).
	(x = 0 eða: x = 1) rangt: { Úttak skrifa: ['MISTÓKST']. }.
	x := (Rökgildi kasta annaðhvort: ['FRAMHLIÐ'] eða: ['BAKHLIÐ']).
	((x = ['FRAMHLIÐ']) eða: (x = ['BAKHLIÐ'])) rangt: { Úttak skrifa: ['MISTÓKST']. }.
}.
Úttak skrifa: ['BÚIÐ'].

