# Tæting lykilorða
Server init.

# Notandi velur lykilorð
>> lykilo := ['pass123'].

# Þú geymir það svona
>> tætið := Hvelfing 
	lykilorðstæti: lykilo.

# Svo skráir notandinn sig inn
# Tilraun 1
>> a1 := ['abcd123'].
# Tilraun 2
>> a2 := ['pass123'].

# Staðfesta
>> a := Hvelfing 
	lykilorðstæti: tætið staðfesta: a1.
	# mistókst 
>> b := Hvelfing
	lykilorðstæti: tætið staðfesta: a2.
	# í lagi!

Úttak skrifa: a, ný-lína.
Úttak skrifa: b, ný-lína.

