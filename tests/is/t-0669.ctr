# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Hvelfing 
	lykilorðstæti: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Hvelfing 
	lykilorðstæti: hash staðfesta: a1.
	# fail 
>> b := Hvelfing
	lykilorðstæti: hash staðfesta: a2.
	# ok!

Úttak skrifa: a, ný-lína.
Úttak skrifa: b, ný-lína.

