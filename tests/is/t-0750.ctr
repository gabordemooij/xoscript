Úttak skrifa: ['Test object'], ný-lína.
>> a := Hlutur nýtt. 

a við: ['item:'] gera: { :nil
	eigin nil := nil. 
}.

a við: ['item'] gera: { <- eigin nil.
}.

a item: Ekkert.

Úttak skrifa: a item, ný-lína.

>> old-nil-address := a item frumgerð minnisvistfang.
a save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== RELOADING SNAP:'], ný-lína.

>> b := Hlutur load-from: ['/tmp/a.bin'].

(b item frumgerð minnisvistfang = old-nil-address) satt: {
	Úttak skrifa: ['Object link re-attached.'], ný-lína.
}.

Úttak skrifa: b item, ný-lína.
