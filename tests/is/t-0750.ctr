Úttak skrifa: ['Prófunarhlutur'], ný-lína.
>> a := Hlutur nýtt. 

a við: ['item:'] gera: { :tómt
	eigin tómt := tómt. 
}.

a við: ['liður'] gera: {
	<- eigin tómt.
}.

a item: Ekkert.

Úttak skrifa: a liður, ný-lína.

>> gamalt-tómt-vistfang := a liður frumgerð minnisvistfang.
a save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== ENDURHLEÐ SNAP:'], ný-lína.

>> b := Hlutur load-from: ['/tmp/a.bin'].

(b liður frumgerð minnisvistfang = gamalt-tómt-vistfang) satt: {
	Úttak skrifa: ['Hlutartengill tengdur aftur.'], ný-lína.
}.

Úttak skrifa: b liður, ný-lína.
