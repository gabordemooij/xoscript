

>> notaðMinni1 := 0.
>> notaðMinni2 := 0.
>> notaðMinni3 := 0.
>> notaðMinni4 := 0.

Forrit minnisstjórnun: 0.

>> txt := ['Word Salad'].
Úttak skrifa: ['Textalengd: '] + txt lengd, ný-lína.
Úttak skrifa: ['Stafur við 2:'] + ( txt stafur: 2 ), ný-lína.
Úttak skrifa: (( txt finna: ['S'] ) - 0), ný-lína.

Forrit taka-til.

notaðMinni1 := (Forrit minni ? 0).


txt := ['Word Salad'].
Úttak skrifa: ['Textalengd: '] + txt lengd, ný-lína.
Úttak skrifa: ['Stafur við 2:'] + ( txt stafur: 2 ), ný-lína.
Úttak skrifa: (( txt finna: ['S'] ) - 0), ný-lína.

