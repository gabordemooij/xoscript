>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Hlutur nýtt.
⚄ við: ['dragaÚr:lengd:'] gera: { :forði :fjöldi
	
	>> niðurstaða := [''].
	
	{
		>> vísir := Tala handahóf % (forði lengd).
		niðurstaða bæta-aftast: ( forði stafur: (vísir + 1) ).
		
	} × fjöldi. <- niðurstaða.
}.

>> handahóf := ⚄ dragaÚr: ?? lengd: ?? lengd.
Úttak skrifa: (['x↵'] x handahóf lengd).
Úttak skrifa: (['y↵'] y ?? lengd).

