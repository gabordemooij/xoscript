>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Hlutur nýtt.
⚄ við: ['drawFrom:length:'] gera: { :pool :fjöldi
	
	>> result := [''].
	
	{
		>> index := Tala random % (pool lengd).
		result bæta-aftast: ( pool stafur: (index + 1) ).
		
	} × fjöldi. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? lengd.
Úttak skrifa: (['x↵'] x random lengd).
Úttak skrifa: (['y↵'] y ?? lengd).

