Úttak skrifa: ['Continue for-loop, No - before 6 and up.'], ný-lína.
{ :i
	Úttak skrifa: (i + 1), ný-lína.
	((i + 1) > 4) halda-áfram.
	Úttak skrifa: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Úttak ný-lína.
Úttak skrifa: ['Continue while-true, No --> before 5 and up.'], ný-lína.
{
	Úttak skrifa: ['iteration #'] + x, ný-lína.
	x leggja-við: 1.
	((x < 5) ekki) halda-áfram.
	Úttak skrifa: ['-->'].
} meðan: xIsLessThan10.
Úttak ný-lína.
Úttak skrifa: ['Continue while-false, No - before 3 only.'], ný-lína.
{
	Úttak skrifa: ['iteration #'] + x, ný-lína.
	x draga-frá: 1.
	(x = 3) halda-áfram.
	Úttak skrifa: ['-'].
} meðan: { <- ( x > 0). }.

Úttak ný-lína.
Úttak skrifa: ['Continue times-loop, No ||| before 3.'], ný-lína.
{ :i
	Úttak skrifa: ['iteration #'] + i, ný-lína.
	(i = 2) halda-áfram.
	Úttak skrifa: ['|||'].
} × 5.

Úttak ný-lína.

{ Satt halda-áfram. Úttak skrifa: ['dont write this!'], ný-lína. } ræsa.

{ Satt halda-áfram. Úttak skrifa: ['dont write this!'], ný-lína. } grípa: { Úttak skrifa: ['Dont catch this!']. }, ræsa.

Úttak skrifa: ['Test Array each-loop: 0, ... ,2'], ný-lína.
(Listi ← 1 ; 2 ; 3) varpa: { :i
	(i = 1) halda-áfram.
	Úttak skrifa: ['iteration #'] + (i - 0), ný-lína.
}.

Úttak skrifa: ['Test Map each-loop: c only'], ný-lína.
>> m := Orðabók nýtt.
m setja: ['first'] við: ['a'], setja: ['second'] við: ['b'], setja: ['third'] við: ['c'].
m hver: { :k :v
	(k ≠ ['c']) halda-áfram.
	Úttak skrifa: ['iteration'] + k + v, ný-lína.
}.

