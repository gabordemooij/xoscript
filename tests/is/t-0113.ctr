Úttak skrifa: ['Halda áfram for-lykkju, Nei - á undan 6 og upp.'], ný-lína.
{ :i
	Úttak skrifa: (i + 1), ný-lína.
	((i + 1) > 4) halda-áfram.
	Úttak skrifa: ['-'].
} × 10.

>> x := 0.
>> xErMinnaEn10 := { <- ( x < 10 ). }.
Úttak ný-lína.
Úttak skrifa: ['Halda áfram while-true, Nei --> á undan 5 og upp.'], ný-lína.
{
	Úttak skrifa: ['iteration #'] + x, ný-lína.
	x leggja-við: 1.
	((x < 5) ekki) halda-áfram.
	Úttak skrifa: ['-->'].
} meðan: xErMinnaEn10.
Úttak ný-lína.
Úttak skrifa: ['Halda áfram while-false, Nei - aðeins á undan 3.'], ný-lína.
{
	Úttak skrifa: ['iteration #'] + x, ný-lína.
	x draga-frá: 1.
	(x = 3) halda-áfram.
	Úttak skrifa: ['-'].
} meðan: { <- ( x > 0). }.

Úttak ný-lína.
Úttak skrifa: ['Halda áfram times-lykkju, Nei ||| á undan 3.'], ný-lína.
{ :i
	Úttak skrifa: ['iteration #'] + i, ný-lína.
	(i = 2) halda-áfram.
	Úttak skrifa: ['|||'].
} × 5.

Úttak ný-lína.

{ Satt halda-áfram. Úttak skrifa: ['ekki skrifa þetta!'], ný-lína. } ræsa.

{ Satt halda-áfram. Úttak skrifa: ['ekki skrifa þetta!'], ný-lína. } grípa: { Úttak skrifa: ['Ekki grípa þetta!']. }, ræsa.

Úttak skrifa: ['Prófa Listi each-lykkju: 0, ... ,2'], ný-lína.
(Listi ← 1 ; 2 ; 3) varpa: { :i
	(i = 1) halda-áfram.
	Úttak skrifa: ['iteration #'] + (i - 0), ný-lína.
}.

Úttak skrifa: ['Prófa Orðabók each-lykkju: aðeins c'], ný-lína.
>> m := Orðabók nýtt.
m setja: ['first'] við: ['a'], setja: ['second'] við: ['b'], setja: ['þriðja'] við: ['c'].
m hver: { :k :v
	(k ≠ ['c']) halda-áfram.
	Úttak skrifa: ['iteration'] + k + v, ný-lína.
}.

