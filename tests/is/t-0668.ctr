# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob nýtt: 8, bytes: (
	Listi nýtt ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Úttak skrifa: ( utf16 afkóða: ['utf16le'] ), ný-lína.

utf16 losa.
>> utf32 := Blob nýtt: 13, bytes: (
	Listi nýtt ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Úttak skrifa: ( utf32 afkóða: ['utf32be'] ), ný-lína.
utf32 losa.