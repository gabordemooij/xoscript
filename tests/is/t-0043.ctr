>> endurtekari := Hlutur nýtt.
endurtekari við: ['svara:'] gera: { :hvað
	Úttak skrifa: hvað + [' '].
}.
endurtekari við: ['svara:og:'] gera: { :hvað :say
	Úttak skrifa: hvað, skrifa: say + [' '].
}.
endurtekari við: ['svara:og:og:'] gera: { :hvað :say :meira
	Úttak skrifa: hvað, skrifa: say, skrifa: meira.
}.
endurtekari endurtaka.
endurtekari everything: ['Ég segi.'].
endurtekari and: ['I '] everything: ['geri.'].
