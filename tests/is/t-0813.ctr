# line breaks in values must not create extra headers
Server frumstilla.
Forrit nota: ['../../../src/xo/is/webtools.xo'].
Forrit nota: ['../../../src/xo/is/mailtools.xo'].

>> haus := HTTP-Haus nýtt lykill: ['Location'] gildið: ['/ok\r\nX-Injected: yes'].
Úttak skrifa: haus.

>> web := Vefskjal nýtt.
web fara-á: ['/ok\r\nX-Injected: yes'].
Úttak skrifa: ['\n'], ný-lína.

>> mail := Tölvupóstur nýtt.
mail til: (Listi nýtt ; ['a@example.invalid\r\nX-To: yes']).
mail cc: (Listi nýtt ; ['b@example.invalid\r\nX-Cc: yes']).
mail bcc: (Listi nýtt ; ['c@example.invalid\r\nX-Bcc: yes']).
mail sendandi: ['d@example.invalid\r\nX-From: yes'] nafn: ['site\r\nX-Name: yes'].
mail efni: ['hello\r\nX-Subject: yes'].
mail meginmál: ['line1\r\nline2'].
Úttak skrifa: mail búa-til.

>> html := HTML-Tölvupóstur nýtt.
html til: (Listi nýtt ; ['a@example.invalid\r\nX-To: yes']).
html sendandi: ['d@example.invalid'] nafn: ['site'].
html efni: ['hello\r\nX-Subject: yes'].
html meginmál: ['body'].
Úttak skrifa: ( html búa-til inniheldur: ['\nX-'] ), ný-lína.
Úttak skrifa: ( html búa-til inniheldur: ['X-To: yes'] ), ný-lína.
