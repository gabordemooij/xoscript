# línuskil í gildum mega ekki búa til auka hausa
Server frumstilla.
Forrit nota: ['../../../src/xo/is/webtools.xo'].
Forrit nota: ['../../../src/xo/is/mailtools.xo'].

>> haus := HTTP-Haus nýtt lykill: ['Location'] gildið: ['/ok\r\nX-Injected: yes'].
Úttak skrifa: haus.

>> vefur := Vefskjal nýtt.
vefur fara-á: ['/ok\r\nX-Injected: yes'].
Úttak skrifa: ['\n'], ný-lína.

>> póstur := Tölvupóstur nýtt.
póstur til: (Listi nýtt ; ['a@example.invalid\r\nX-To: yes']).
póstur cc: (Listi nýtt ; ['b@example.invalid\r\nX-Cc: yes']).
póstur bcc: (Listi nýtt ; ['c@example.invalid\r\nX-Bcc: yes']).
póstur sendandi: ['d@example.invalid\r\nX-From: yes'] nafn: ['site\r\nX-Name: yes'].
póstur efni: ['hello\r\nX-Subject: yes'].
póstur meginmál: ['line1\r\nline2'].
Úttak skrifa: póstur búa-til.

>> html := HTML-Tölvupóstur nýtt.
html til: (Listi nýtt ; ['a@example.invalid\r\nX-To: yes']).
html sendandi: ['d@example.invalid'] nafn: ['vefsvæði'].
html efni: ['hello\r\nX-Subject: yes'].
html meginmál: ['body'].
Úttak skrifa: ( html búa-til inniheldur: ['\nX-'] ), ný-lína.
Úttak skrifa: ( html búa-til inniheldur: ['X-To: yes'] ), ný-lína.
