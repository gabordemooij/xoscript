Úttak skrifa: ['Prófunarhlutur'], ný-lína.
>> skp := Skipun nýtt.
Úttak skrifa: skp ls /tmp, ný-lína.
>> gamalt-skp-vistfang := skp frumgerð minnisvistfang.
skp save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== ENDURHLEÐ SNAP:'], ný-lína.
>> b := Hlutur load-from: ['/tmp/a.bin'].
(b frumgerð minnisvistfang = gamalt-skp-vistfang) satt: {
	Úttak skrifa: ['Hlutartengill tengdur aftur.'], ný-lína.
}.
Úttak skrifa: b ls, ný-lína.


