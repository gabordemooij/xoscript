Úttak skrifa: ['Test object'], ný-lína.
>> cmd := Skipun nýtt.
Úttak skrifa: cmd ls /tmp, ný-lína.
>> old-cmd-address := cmd frumgerð minnisvistfang.
cmd save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== RELOADING SNAP:'], ný-lína.
>> b := Hlutur load-from: ['/tmp/a.bin'].
(b frumgerð minnisvistfang = old-cmd-address) satt: {
	Úttak skrifa: ['Object link re-attached.'], ný-lína.
}.
Úttak skrifa: b ls, ný-lína.


