
>> Rétthyrningur := Hlutur nýtt.

Rétthyrningur við: ['flatarmál'] gera: {
	<- eigin lengd * eigin breidd.
}.

Rétthyrningur við: ['length:'] gera: { :lengd
	eigin lengd := lengd.
}.

Rétthyrningur við: ['width:'] gera: { :breidd
	eigin breidd := breidd.
}.

Rétthyrningur við: ['nýtt'] gera: {
	# þetta leiðir ekki til óendanlegrar lykkju
	>> rétthyrningur := sjálfur nýtt.
	rétthyrningur length: 0, width: 0.
	<- rétthyrningur.
}.

>> a := Rétthyrningur nýtt.
Úttak skrifa: a flatarmál, ný-lína. #0

>> b := Rétthyrningur nýtt length: 2, width: 3.
Úttak skrifa: b flatarmál, ný-lína. #6

