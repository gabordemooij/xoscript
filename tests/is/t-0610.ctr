
>> Rectangle := Hlutur nýtt.

Rectangle við: ['area'] gera: { <- eigin lengd * eigin width.
}.

Rectangle við: ['length:'] gera: { :lengd
	eigin lengd := lengd.
}.

Rectangle við: ['width:'] gera: { :width
	eigin width := width.
}.

Rectangle við: ['nýtt'] gera: {
	# this will not result into an infinite loop
	>> rectangle := sjálfur nýtt.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle nýtt.
Úttak skrifa: a area, ný-lína. #0

>> b := Rectangle nýtt length: 2, width: 3.
Úttak skrifa: b area, ný-lína. #6

