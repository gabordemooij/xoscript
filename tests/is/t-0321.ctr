# test qualifiers

Forrit taka-til.

>> Fruit := Hlutur nýtt.
Fruit við: ['nýtt'] gera: {
	>> f := sjálfur nýtt.
	f apples: 0. <- f.
}.
Fruit við: ['apples:'] gera: { :a eigin apples := a. }.
Fruit við: ['apples'] gera: { <- eigin apples. }.
Fruit við: ['+'] gera: { :f
	>> n := Fruit nýtt.
	n apples: (f apples + eigin apples). <- n.
}.
Tala við: ['apples'] gera: { <- ((Fruit nýtt) apples: sjálfur).
}.

Fruit við: ['texti'] gera: { <- eigin apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Úttak skrifa: q, ný-lína.




q := 3 apples + 4 apples.
Úttak skrifa: q, ný-lína.



q := 3 apples + 4 apples.
Úttak skrifa: q, ný-lína.


