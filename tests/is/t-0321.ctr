# prófa tilgreiningar

Forrit taka-til.

>> Ávöxtur := Hlutur nýtt.
Ávöxtur við: ['nýtt'] gera: {
	>> f := sjálfur nýtt.
	f apples: 0. <- f.
}.
Ávöxtur við: ['apples:'] gera: { :a eigin eplin := a. }.
Ávöxtur við: ['eplin'] gera: { <- eigin eplin. }.
Ávöxtur við: ['+'] gera: { :f
	>> n := Ávöxtur nýtt.
	n apples: (f eplin + eigin eplin). <- n.
}.
Tala við: ['eplin'] gera: { <- ((Ávöxtur nýtt) apples: sjálfur).
}.

Ávöxtur við: ['texti'] gera: { <- eigin eplin + [' epli '].
}.

>> q := 3 eplin + 4 eplin.
Úttak skrifa: q, ný-lína.




q := 3 eplin + 4 eplin.
Úttak skrifa: q, ný-lína.



q := 3 eplin + 4 eplin.
Úttak skrifa: q, ný-lína.


