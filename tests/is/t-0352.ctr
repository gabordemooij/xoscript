Tala við: ['rómversk'] gera: {
	>> tala := sjálfur afrita.
	>> rómversk := [''].
	{
		{
			(tala ≥ 1000) satt: {
				rómversk bæta-aftast: ['Ⅿ'].
				tala draga-frá: 1000.
			}, rjúfa.
		
			(tala ≥ 500) satt: {
				rómversk bæta-aftast: ['Ⅾ'].
				tala draga-frá: 500.
			}, rjúfa.
		
			(tala ≥ 100) satt: {
				rómversk bæta-aftast: ['Ⅽ'].
				tala draga-frá: 100.
			}, rjúfa.
		
			(tala ≥ 50) satt: {
				rómversk bæta-aftast: ['Ⅼ'].
				tala draga-frá: 50.
			}, rjúfa.
		
			(tala ≥ 50) satt: {
				rómversk bæta-aftast: ['Ⅼ'].
				tala draga-frá: 50.
			}, rjúfa.
		
			(tala ≥ 10) satt: {
				rómversk bæta-aftast: ['Ⅹ'].
				tala draga-frá: 10.
			}, rjúfa.
			
			(tala ≥ 9) satt: {
				rómversk bæta-aftast: ['Ⅸ'].
				tala draga-frá: 9.
			}, rjúfa.
			
			(tala ≥ 5) satt: {
				rómversk bæta-aftast: ['Ⅴ'].
				tala draga-frá: 5.
			}, rjúfa.
			
			(tala ≥ 4) satt: {
				rómversk bæta-aftast: ['Ⅳ'].
				tala draga-frá: 4.
			}, rjúfa.
			
			(tala ≥ 1) satt: {
				rómversk bæta-aftast: ['Ⅰ'].
				tala draga-frá: 1.
			}, rjúfa.
		} stefja.
	} meðan: { <- tala > 0. }. <- rómversk.
}.

Úttak skrifa: 1 rómversk, ný-lína.
Úttak skrifa: 2 rómversk, ný-lína.
Úttak skrifa: 4 rómversk, ný-lína.
Úttak skrifa: 8 rómversk, ný-lína.
