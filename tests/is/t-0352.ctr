Tala við: ['roman'] gera: {
	>> tala := sjálfur afrita.
	>> roman := [''].
	{
		{
			(tala ≥ 1000) satt: {
				roman bæta-aftast: ['Ⅿ'].
				tala draga-frá: 1000.
			}, rjúfa.
		
			(tala ≥ 500) satt: {
				roman bæta-aftast: ['Ⅾ'].
				tala draga-frá: 500.
			}, rjúfa.
		
			(tala ≥ 100) satt: {
				roman bæta-aftast: ['Ⅽ'].
				tala draga-frá: 100.
			}, rjúfa.
		
			(tala ≥ 50) satt: {
				roman bæta-aftast: ['Ⅼ'].
				tala draga-frá: 50.
			}, rjúfa.
		
			(tala ≥ 50) satt: {
				roman bæta-aftast: ['Ⅼ'].
				tala draga-frá: 50.
			}, rjúfa.
		
			(tala ≥ 10) satt: {
				roman bæta-aftast: ['Ⅹ'].
				tala draga-frá: 10.
			}, rjúfa.
			
			(tala ≥ 9) satt: {
				roman bæta-aftast: ['Ⅸ'].
				tala draga-frá: 9.
			}, rjúfa.
			
			(tala ≥ 5) satt: {
				roman bæta-aftast: ['Ⅴ'].
				tala draga-frá: 5.
			}, rjúfa.
			
			(tala ≥ 4) satt: {
				roman bæta-aftast: ['Ⅳ'].
				tala draga-frá: 4.
			}, rjúfa.
			
			(tala ≥ 1) satt: {
				roman bæta-aftast: ['Ⅰ'].
				tala draga-frá: 1.
			}, rjúfa.
		} stefja.
	} meðan: { <- tala > 0. }. <- roman.
}.

Úttak skrifa: 1 roman, ný-lína.
Úttak skrifa: 2 roman, ný-lína.
Úttak skrifa: 4 roman, ný-lína.
Úttak skrifa: 8 roman, ný-lína.
Úttak skrifa: 16 roman, ný-lína.
Úttak skrifa: 32 roman, ný-lína.
Úttak skrifa: 64 roman, ný-lína.
Úttak skrifa: 128 roman, ný-lína.
Úttak skrifa: 256 roman, ný-lína.
Úttak skrifa: 1024 roman, ný-lína.
