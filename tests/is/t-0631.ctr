#ffi-próf


Server init.

Forrit minnisstjórnun: 4.

# fyrir þetta próf þarftu að stilla slóð að libc (puts)
>> safnheiti := Forrit stilling: ['FFITESTLIB'].



Server tengja: (
 Listi nýtt ;
 safnheiti ;
 ['puts'] ;
 ( Listi nýtt ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s losa.

# próf með struct

>> a := Blob nýtt: 8.
a bytes: (
	Listi <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> strúktúr := Blob struct: (Listi <<: ['int'], ; ['int']).

Server tengja: (
	Listi <<: ['@structtest'], ;
	['@structtest'] ;
	(Listi <<: strúktúr) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Úttak skrifa: ['Summuprófun:'] + (ffitest ffisum: a), ný-lína.

strúktúr losa-struct.
strúktúr losa.
a losa.
