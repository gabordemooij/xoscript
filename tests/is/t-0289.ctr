#Linux
>> OS := Forrit kerfi: (Skipun uname -s), snyrta.

>> Slurp := Hlutur nýtt.
Slurp við: ['nýtt'] gera: {
	eigin str := [''].
}.
Slurp við: ['svara:'] gera: { :blah
		(eigin str ≠ ['']) satt: {
			eigin str bæta-aftast: [' '].
		}.
		eigin str bæta-aftast: blah.
}.
Slurp við: ['svara:og:'] gera: { :blah :blahah
		(eigin str ≠ ['']) satt: {
			eigin str bæta-aftast: [' '].
		}.
		(blah lengd > 1) satt: {
			eigin str bæta-aftast: (blah frá: 0 lengd: (blah lengd - 1)).
		}, annars: {
			eigin str bæta-aftast: blah.
		}.
		eigin str bæta-aftast: [' '].
		eigin str bæta-aftast: blahah.
}.
Slurp við: ['obtain'] gera: {
	>> buffer := eigin str.
	eigin str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text bæta-aftast: ['hello'].
} × 1000.


Úttak skrifa: (
	Forrit kerfi: (
		Slurp nýtt
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

