Úttak skrifa: ['Test object'], ný-lína.
>> a := Hlutur nýtt. 

a við: ['item:'] gera: { :octhelper
	eigin octhelper := octhelper. 
}.

a við: ['item'] gera: { <- eigin octhelper.
}.

a item: Oct nýtt.

>> old-octhelper-address := a item frumgerð minnisvistfang.
a save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== RELOADING SNAP:'], ný-lína.

>> b := Hlutur load-from: ['/tmp/a.bin'].

(b item frumgerð minnisvistfang = old-octhelper-address) satt: {
	Úttak skrifa: ['Object link re-attached.'], ný-lína.
}.
