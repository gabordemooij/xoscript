Úttak skrifa: ['Prófunarhlutur'], ný-lína.
>> a := Hlutur nýtt. 

a við: ['item:'] gera: { :okthjálpari
	eigin okthjálpari := okthjálpari. 
}.

a við: ['liður'] gera: {
	<- eigin okthjálpari.
}.

a item: Oct nýtt.

>> gamalt-okthjálpari-vistfang := a liður frumgerð minnisvistfang.
a save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== ENDURHLEÐ SNAP:'], ný-lína.

>> b := Hlutur load-from: ['/tmp/a.bin'].

(b liður frumgerð minnisvistfang = gamalt-okthjálpari-vistfang) satt: {
	Úttak skrifa: ['Hlutartengill tengdur aftur.'], ný-lína.
}.
