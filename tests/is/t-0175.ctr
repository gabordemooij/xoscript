

>> notaðMinni1 := 0.
>> notaðMinni2 := 0.
>> notaðMinni3 := 0.
>> notaðMinni4 := 0.

>> x := 100.

Forrit minnisstjórnun: 0.

{
>> txt := ['halló '] + ['world'].
txt := txt + [' - getum við notað texta.. '].
txt := txt + ['án þess að leka '] + x + ['-falt magn bæta ?'].
txt bæta-aftast: ['!!'].
Úttak skrifa: txt.
} ræsa.

Forrit taka-til.

notaðMinni1 := (Forrit minni ? 0).


{
