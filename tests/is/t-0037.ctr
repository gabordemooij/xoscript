>> a := 3.
>> b := a afrita.
a draga-frá: 1.
Úttak skrifa: [' a = '] + a.
Úttak skrifa: [' b = '] + b.
a := 3.
b := a + 4.
Úttak skrifa: [' a = '] + a.
Úttak skrifa: [' b = '] + b.
>> x := 3.
>> y := x afrita.
x leggja-við: 10.
y draga-frá: 1.
Úttak skrifa: [' x = '] + x.
Úttak skrifa: [' y = '] + y.
>> q := Hlutur nýtt.
q við: ['setProperty:'] gera: { :x
	eigin eig := x.
}.
q við: ['sækjaEiginleika'] gera: { <- eigin eig.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Úttak skrifa: [' p = '] + (p sækjaEiginleika).
