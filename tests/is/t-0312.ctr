>> Slurp := Hlutur nýtt.
Slurp við: ['nýtt'] gera: {
	eigin str := [''].
}.
Slurp læra: ['nieuw'] þýðir: ['nýtt'].
Slurp við: ['svara:'] gera: { :blah
		(eigin str ≠ ['']) satt: {
			eigin str bæta-aftast: [' '].
		}.
		eigin str bæta-aftast: blah.
}.
Slurp við: ['svara:og:'] gera: { :blah :blahah
		(eigin str ≠ ['']) satt: {
			eigin str bæta-aftast: [' '].
		}.
		(blah lengd > 1) satt: {
			eigin str bæta-aftast: (blah frá: 0 lengd: (blah lengd - 1)).
		}, annars: {
			eigin str bæta-aftast: blah.
		}.
		eigin str bæta-aftast: [' '].
		eigin str bæta-aftast: blahah.
}.
Slurp við: ['obtain'] gera: {
	>> buffer := eigin str.
	eigin str := ['']. <- buffer.
}.


>> leitarfæribreytur := Slurp nýtt
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

Úttak skrifa: leitarfæribreytur obtain, ný-lína.
