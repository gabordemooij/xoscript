
Texti við: ['html'] gera: { <- (
		sjálfur
		skipta: ['&'] fyrir: ['&amp;'],
		skipta: ['<'] fyrir: ['&lt;'],
		skipta: ['>'] fyrir: ['&gt;'],
		skipta: ['"'] fyrir: ['&quot;']
	).
}.

>> HtmlPensill := Hlutur nýtt.

HtmlPensill við: ['svara:'] gera: { :merkið
	Úttak skrifa: (['<tag>↵'] tag: merkið ).
}.

HtmlPensill við: ['svara:og:'] gera: { :merkið :content
	merkið := ( merkið frá: 0 lengd: (merkið lengd - 1) ).
	Úttak skrifa: (['<tag content>↵'] tag: merkið, content: content).
}.

HtmlPensill við: ['content:'] gera: { :textinn
	Úttak skrifa: textinn html, ný-lína.
}.

HtmlPensill við: ['attr:gildi:'] gera: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlPensill nýtt.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] gildi: ['bold']),
		/span
	/body
/html.
		
