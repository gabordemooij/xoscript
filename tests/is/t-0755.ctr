Úttak skrifa: ['Test object'], ný-lína.
>> greeter := Hlutur nýtt.
greeter við: ['name:'] gera: { :nafn
	eigin xname := nafn. 
}.
greeter við: ['greet'] gera: {
	Úttak skrifa: ['Hello '] + eigin xname, ný-lína.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== RELOADING SNAP:'], ný-lína.
>> b := Hlutur load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
