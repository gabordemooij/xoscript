['Þúsundir og aukastafir'].

>> x := 100000000.5.
>> y := 100000000.5.

Úttak skrifa: (x + y), ný-lína.

>> x := 10040.07.
>> y := 10305.60.

Úttak skrifa: (x + y), ný-lína.

['Aukastafur'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Úttak skrifa: (x + y + z), ný-lína.

['Skrýtið en gilt'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Úttak skrifa: (x + y + z), ný-lína.

>> q := 0.1.2.

Úttak skrifa: (q), ný-lína.

>> q := 012.

Úttak skrifa: (q), ný-lína.
