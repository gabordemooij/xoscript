Forrit minnisstjórnun: 4.

>> úps := 0.
{
	{ 3 ÷ 0. } grípa: {
		úps leggja-við: 1.
	}, ræsa.
} × 1000.

{
	Úttak skrifa: ['hæ þarna!'].
	þetta-verk villa: ['oops'].
	Úttak skrifa: ['hæ þarna!'].
	{ Úttak skrifa: ['ekki prenta þetta']. } ræsa.
} grípa: { :e 
