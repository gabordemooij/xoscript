Forrit minnisstjórnun: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } grípa: {
		oops leggja-við: 1.
	}, ræsa.
} × 1000.

{
	Úttak skrifa: ['hi there!'].
	þetta-verk villa: ['oops'].
	Úttak skrifa: ['hi there!'].
	{ Úttak skrifa: ['dont print this']. } ræsa.
} grípa: { :e 
	Úttak skrifa: ['got ya!']. 
	Úttak skrifa: e.
}, ræsa.
