

Listi við: ['summa'] gera: {
	>> samtals := 0.
	sjálfur hver: { :vísir :stak
		samtals leggja-við: stak.
	}. <- samtals.
}.

Listi við: ['margfeldi'] gera: {
	>> samtals := 1.
	sjálfur hver: { :vísir :stak
		samtals margfalda-með: stak.
	}. <- samtals.
}.

>> notaðMinni1 := 0.
>> notaðMinni2 := 0.
>> notaðMinni3 := 0.
>> notaðMinni4 := 0.

Forrit minnisstjórnun: 0.

{

>> a := Listi ← ['hello'] ; ['world'] ; Satt ; Ekkert ; 666.
a := a + ( Listi ← 1 ).
Úttak skrifa: ( ['summa: '] + ( a summa ) ), ný-lína.
Úttak skrifa: ( ['lágm: '] + ( a lágmark ) ), ný-lína.
Úttak skrifa: ( ['hám: '] + ( a hámark ) ), ný-lína.
Úttak skrifa: ( ['3.: '] + ( a ? 2 ) ), ný-lína.
Úttak skrifa: ( ['prd: '] + ( a margfeldi ) ), ný-lína.
a raða: { :a :b <- (b - a). }.
a hver: { :i :e Úttak skrifa: ( i - 0 ), ný-lína. }.

} ræsa.

Forrit taka-til.
notaðMinni1 := (Forrit minni ? 0).


{

>> a := Listi ← ['hello'] ; ['world'] ; Satt ; Ekkert ; 666.
a := a + ( Listi ← 1 ).
Úttak skrifa: ( ['summa: '] + ( a summa ) ), ný-lína.
Úttak skrifa: ( ['lágm: '] + ( a lágmark ) ), ný-lína.
Úttak skrifa: ( ['hám: '] + ( a hámark ) ), ný-lína.
Úttak skrifa: ( ['3.: '] + ( a ? 2 ) ), ný-lína.
Úttak skrifa: ( ['prd: '] + ( a margfeldi ) ), ný-lína.
a raða: { :a :b <- (b - a). }.
a hver: { :i :e Úttak skrifa: ( i - 0 ), ný-lína. }.

} ræsa.



Forrit taka-til.
notaðMinni2 := (Forrit minni ? 0).


{

>> a := Listi ← ['hello'] ; ['world'] ; Satt ; Ekkert ; 666.
a := a + ( Listi ← 1 ).
Úttak skrifa: ( ['summa: '] + ( a summa ) ), ný-lína.
Úttak skrifa: ( ['lágm: '] + ( a lágmark ) ), ný-lína.
Úttak skrifa: ( ['hám: '] + ( a hámark ) ), ný-lína.
Úttak skrifa: ( ['3.: '] + ( a ? 2 ) ), ný-lína.
Úttak skrifa: ( ['prd: '] + ( a margfeldi ) ), ný-lína.
a raða: { :a :b <- (b - a). }.
a hver: { :i :e Úttak skrifa: ( i - 0 ), ný-lína. }.

} ræsa.



Forrit taka-til.
notaðMinni3 := (Forrit minni ? 0).

( notaðMinni1 = notaðMinni2 og: notaðMinni1 = notaðMinni3, og: notaðMinni2 = notaðMinni3 ) satt: {
	Úttak skrifa: ['Enginn minnisleki hér'].
}, rangt: {
	Úttak skrifa: ['Minni lekur...'].
}.
