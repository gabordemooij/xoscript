

Listi við: ['sum'] gera: {
	>> total := 0.
	sjálfur hver: { :index :element
		total leggja-við: element.
	}. <- total.
}.

Listi við: ['product'] gera: {
	>> total := 1.
	sjálfur hver: { :index :element
		total margfalda-með: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Forrit minnisstjórnun: 0.

{

>> a := Listi ← ['hello'] ; ['world'] ; Satt ; Ekkert ; 666.
a := a + ( Listi ← 1 ).
Úttak skrifa: ( ['sum: '] + ( a sum ) ), ný-lína.
Úttak skrifa: ( ['min: '] + ( a lágmark ) ), ný-lína.
Úttak skrifa: ( ['max: '] + ( a hámark ) ), ný-lína.
Úttak skrifa: ( ['3rd: '] + ( a ? 2 ) ), ný-lína.
Úttak skrifa: ( ['prd: '] + ( a product ) ), ný-lína.
a raða: { :a :b <- (b - a). }.
a hver: { :i :e Úttak skrifa: ( i - 0 ), ný-lína. }.

} ræsa.

Forrit taka-til.
usedMemory1 := (Forrit minni ? 0).


{

>> a := Listi ← ['hello'] ; ['world'] ; Satt ; Ekkert ; 666.
a := a + ( Listi ← 1 ).
Úttak skrifa: ( ['sum: '] + ( a sum ) ), ný-lína.
Úttak skrifa: ( ['min: '] + ( a lágmark ) ), ný-lína.
Úttak skrifa: ( ['max: '] + ( a hámark ) ), ný-lína.
Úttak skrifa: ( ['3rd: '] + ( a ? 2 ) ), ný-lína.
Úttak skrifa: ( ['prd: '] + ( a product ) ), ný-lína.
a raða: { :a :b <- (b - a). }.
a hver: { :i :e Úttak skrifa: ( i - 0 ), ný-lína. }.

} ræsa.



Forrit taka-til.
usedMemory2 := (Forrit minni ? 0).


{

>> a := Listi ← ['hello'] ; ['world'] ; Satt ; Ekkert ; 666.
a := a + ( Listi ← 1 ).
Úttak skrifa: ( ['sum: '] + ( a sum ) ), ný-lína.
Úttak skrifa: ( ['min: '] + ( a lágmark ) ), ný-lína.
Úttak skrifa: ( ['max: '] + ( a hámark ) ), ný-lína.
Úttak skrifa: ( ['3rd: '] + ( a ? 2 ) ), ný-lína.
Úttak skrifa: ( ['prd: '] + ( a product ) ), ný-lína.
a raða: { :a :b <- (b - a). }.
a hver: { :i :e Úttak skrifa: ( i - 0 ), ný-lína. }.

} ræsa.



Forrit taka-til.
usedMemory3 := (Forrit minni ? 0).

( usedMemory1 = usedMemory2 og: usedMemory1 = usedMemory3, og: usedMemory2 = usedMemory3 ) satt: {
	Úttak skrifa: ['No memory leaks here'].
}, rangt: {
	Úttak skrifa: ['Leaking memory...'].
}.
