Úttak skrifa: ['Prófunarhlutur'], ný-lína.
>> heilsari := Hlutur nýtt.
heilsari við: ['name:'] gera: { :nafn
	eigin xnafn := nafn. 
}.
heilsari við: ['heilsa'] gera: {
	Úttak skrifa: ['Halló '] + eigin xnafn, ný-lína.
}.
heilsari name: ['Sherlock'].
heilsari save-as: ['/tmp/a.bin'].
heilsari save-as: ['/tmp/b.bin'].
Úttak skrifa: ['========== ENDURHLEÐ SNAP:'], ný-lína.
>> b := Hlutur load-from: ['/tmp/a.bin'].
>> c := Hlutur load-from: ['/tmp/b.bin'].
b heilsa.
b name: ['Watson'], heilsa.
c name: ['Moriarty'], heilsa.
