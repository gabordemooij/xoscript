

Texti við: ['evaluate'] gera: {
	>> kóði := Skrá nýtt: ['/tmp/eval.ctr'].
	kóði skrifa: sjálfur texti + ['.'].
	Forrit nota: ['/tmp/eval.ctr'].
}.

>> a := (Listi ← (
	(Orðabók nýtt)
		setja: ['domain'] við: ['mywebsite.com'],
		setja: (Listi ←
			((Orðabók nýtt)
				setja: ['home'] við: ['title'],
				setja: ['<html></html>'] við: ['body'],
				setja: ['2017-01-01'] við: ['created']
			) ;
			((Orðabók nýtt)
				setja: ['aboutus(c)'] við: ['title'],
				setja: ['<credits>Author Inc.</credits>'] við: ['body']
			)
		) við: ['pages']
	)
) texti.

Úttak skrifa: a gerð, ný-lína.
Úttak skrifa: a, ný-lína.

>> b := Ekkert.
(['b := '] + a) evaluate.
Úttak skrifa: b ? 0 ? ['pages'] ? 1 ? ['body'], ný-lína.

>> c := b ? 0.
>> d := c texti.
Úttak skrifa: d gerð, ný-lína.

>> e := Ekkert.
(['e := '] + d) evaluate.
Úttak skrifa: e ? ['pages'] ? 0, ný-lína.
