

Texti við: ['meta'] gera: {
	>> kóði := Skrá nýtt: ['/tmp/eval.ctr'].
	kóði skrifa: sjálfur texti + ['.'].
	Forrit nota: ['/tmp/eval.ctr'].
}.

>> a := (Listi ← (
	(Orðabók nýtt)
		setja: ['lén'] við: ['mywebsite.com'],
		setja: (Listi ←
			((Orðabók nýtt)
				setja: ['heim'] við: ['title'],
				setja: ['<html></html>'] við: ['body'],
				setja: ['2017-01-01'] við: ['búið til']
			) ;
			((Orðabók nýtt)
				setja: ['umokkur(c)'] við: ['title'],
				setja: ['<credits>Höfundur hf.</credits>'] við: ['body']
			)
		) við: ['síður']
	)
) texti.

Úttak skrifa: a gerð, ný-lína.
Úttak skrifa: a, ný-lína.

>> b := Ekkert.
(['b := '] + a) meta.
Úttak skrifa: b ? 0 ? ['síður'] ? 1 ? ['body'], ný-lína.

>> c := b ? 0.
>> d := c texti.
Úttak skrifa: d gerð, ný-lína.

>> e := Ekkert.
(['e := '] + d) meta.
Úttak skrifa: e ? ['síður'] ? 0, ný-lína.
