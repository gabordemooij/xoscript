
Úttak skrifa: ['Break for-loop, 0-4.'], ný-lína.
{ :i
	Úttak skrifa: ['iteration #'] + i, ný-lína.
	(i = 4) rjúfa.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Úttak skrifa: ['Break while-true loop, 0-4.'], ný-lína.
{
	Úttak skrifa: ['iteration #'] + x, ný-lína.
	x leggja-við: 1.
	((x < 5) ekki) rjúfa.
} meðan: xIsLessThan10.

Úttak skrifa: ['Break while-false loop, 5,4.'], ný-lína.
{
	Úttak skrifa: ['iteration #'] + x, ný-lína.
	x draga-frá: 1.
	(x = 3) rjúfa.
} meðan: { <- (x > 0). }.

Úttak skrifa: ['Break times loop, 1-4.'], ný-lína.
{ :i
	Úttak skrifa: ['iteration #'] + i, ný-lína.
	(i = 4) rjúfa.
} × 5.

Úttak skrifa: ['Break block, dont print line.'], ný-lína.
{ Satt rjúfa. Úttak skrifa: ['dont write this!'], ný-lína. } ræsa.

Úttak skrifa: ['Break block, dont fire catch...'], ný-lína.
{ Satt rjúfa. Úttak skrifa: ['dont write this!'], ný-lína. } grípa: { Úttak skrifa: ['Dont catch this!']. }, ræsa.

Úttak skrifa: ['Test Array each-loop: 0,1'], ný-lína.
(Listi ← 1 ; 2 ; 3) varpa: { :i
	Úttak skrifa: ['iteration #'] + i, ný-lína.
	(i = 1) rjúfa.
}.

Úttak skrifa: ['Test Map each-loop: c only'], ný-lína.
>> m := Orðabók nýtt.
m setja: ['first'] við: ['a'], setja: ['second'] við: ['b'], setja: ['third'] við: ['c'].
m hver: { :k :v
	Úttak skrifa: ['iteration'] + v + k, ný-lína.
	Satt rjúfa.
}.

