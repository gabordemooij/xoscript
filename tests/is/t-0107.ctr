
Úttak skrifa: ['Rjúfa for-lykkju, 0-4.'], ný-lína.
{ :i
	Úttak skrifa: ['iteration #'] + i, ný-lína.
	(i = 4) rjúfa.
} × 10.

>> x := 0.
>> xErMinnaEn10 := { <- ( x < 10 ). }.

Úttak skrifa: ['Rjúfa while-true lykkju, 0-4.'], ný-lína.
{
	Úttak skrifa: ['iteration #'] + x, ný-lína.
	x leggja-við: 1.
	((x < 5) ekki) rjúfa.
} meðan: xErMinnaEn10.

Úttak skrifa: ['Rjúfa while-false lykkju, 5,4.'], ný-lína.
{
	Úttak skrifa: ['iteration #'] + x, ný-lína.
	x draga-frá: 1.
	(x = 3) rjúfa.
} meðan: { <- (x > 0). }.

Úttak skrifa: ['Rjúfa times-lykkju, 1-4.'], ný-lína.
{ :i
	Úttak skrifa: ['iteration #'] + i, ný-lína.
	(i = 4) rjúfa.
} × 5.

Úttak skrifa: ['Rjúfa blokk, ekki prenta línu.'], ný-lína.
{ Satt rjúfa. Úttak skrifa: ['ekki skrifa þetta!'], ný-lína. } ræsa.

Úttak skrifa: ['Rjúfa blokk, ekki kveikja á catch...'], ný-lína.
{ Satt rjúfa. Úttak skrifa: ['ekki skrifa þetta!'], ný-lína. } grípa: { Úttak skrifa: ['Ekki grípa þetta!']. }, ræsa.

Úttak skrifa: ['Prófa Listi each-lykkju: 0,1'], ný-lína.
(Listi ← 1 ; 2 ; 3) varpa: { :i
	Úttak skrifa: ['iteration #'] + i, ný-lína.
	(i = 1) rjúfa.
}.

Úttak skrifa: ['Prófa Orðabók each-lykkju: aðeins c'], ný-lína.
>> m := Orðabók nýtt.
m setja: ['first'] við: ['a'], setja: ['second'] við: ['b'], setja: ['þriðja'] við: ['c'].
m hver: { :k :v
	Úttak skrifa: ['iteration'] + v + k, ný-lína.
	Satt rjúfa.
}.

