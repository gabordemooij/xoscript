#Linux
>> klukka := Stund nýtt.
klukka svæði: ['UTC-1'].
klukka ár: 1981, mánuður: 1, dagur: 5,
      klukkustund: 13, mínúta: 15, sekúnda: 13.

Úttak skrifa: klukka, ný-lína.
klukka svæði: ['UTC+0'].

Úttak skrifa: (
	(klukka ár einfalt) + ['-'] + (klukka mánuður) + ['-'] + (klukka dagur) + [' '] +
	(klukka klukkustund) + [':'] + (klukka mínúta) + [':'] + (klukka sekúnda) + [' '] +
	['W'] + (klukka vika) + (klukka svæði)
), ný-lína.


klukka svæði: ['UTC-1'].
Úttak skrifa: (
	(klukka ár einfalt) + ['-'] + (klukka mánuður) + ['-'] + (klukka dagur) + [' '] +
	(klukka klukkustund) + [':'] + (klukka mínúta) + [':'] + (klukka sekúnda) + [' '] +
	['W'] + (klukka vika) + (klukka svæði)
), ný-lína.
