#Linux
>> clock := Stund nýtt.
clock svæði: ['UTC-1'].
clock ár: 1981, mánuður: 1, dagur: 5,
      klukkustund: 13, mínúta: 15, sekúnda: 13.

Úttak skrifa: clock, ný-lína.
clock svæði: ['UTC+0'].

Úttak skrifa: (
	(clock ár einfalt) + ['-'] + (clock mánuður) + ['-'] + (clock dagur) + [' '] +
	(clock klukkustund) + [':'] + (clock mínúta) + [':'] + (clock sekúnda) + [' '] +
	['W'] + (clock vika) + (clock svæði)
), ný-lína.


clock svæði: ['UTC-1'].
Úttak skrifa: (
	(clock ár einfalt) + ['-'] + (clock mánuður) + ['-'] + (clock dagur) + [' '] +
	(clock klukkustund) + [':'] + (clock mínúta) + [':'] + (clock sekúnda) + [' '] +
	['W'] + (clock vika) + (clock svæði)
), ný-lína.
