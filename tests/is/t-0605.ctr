>> reikningur := Hlutur nýtt.
reikningur við: ['ræsa'] gera: {
        eigin tala := 0.
}.

reikningur við: ['tala'] gera: {
        eigin tala leggja-við: 1.
        <- eigin tala afrita.
}.

>> árs-reikningur := reikningur nýtt.
árs-reikningur við: ['start:'] gera: { :ár
	eigin tala := ár.
}.

árs-reikningur start: 202000.
Úttak skrifa: árs-reikningur tala, ný-lína.
Úttak skrifa: árs-reikningur tala, ný-lína.
