>> invoice := Hlutur nýtt.
invoice við: ['ræsa'] gera: {
        eigin tala := 0.
}.

invoice við: ['tala'] gera: {
        eigin tala leggja-við: 1. <- eigin tala afrita.
}.

>> year-invoice := invoice nýtt.
year-invoice við: ['start:'] gera: { :ár
	eigin tala := ár.
}.

year-invoice start: 202000.
Úttak skrifa: year-invoice tala, ný-lína.
Úttak skrifa: year-invoice tala, ný-lína.
