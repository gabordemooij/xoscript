	a við: ['tala'] gera: { <- Satt. }.
	a := 3 × a.
} grípa: { :error
	Úttak skrifa: ['Error noted: '] + error, ný-lína.
}, ræsa.


{
	a við: ['boolean'] gera: { <- 1. }.
	a := Satt og: a.
} grípa: { :error
	Úttak skrifa: ['Error noted: '] + error, ný-lína.
}, ræsa.





