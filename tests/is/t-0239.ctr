Listi við: ['sum'] gera: {
	>> total := 0.
	sjálfur hver: { :index :element
		total leggja-við: element.
	}. <- total.
}.

>> a := Satt.



a við: ['texti'] gera: {
	>> answer := Ekkert.
	( sjálfur = Satt ) satt: {
		answer := ['Yep'].
	}, annars: {
		answer := ['Nope'].
	}. <- answer.
}.

a við: ['tala'] gera: {
	>> answer := Ekkert.
	( sjálfur = Satt ) satt: {
		answer := 10.
	}, annars: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b við: ['texti'] gera: { <- ['Devil'].
}.

b við: ['rökgildi'] gera: { <- Rangt.
}.


Úttak skrifa: a, ný-lína.  
Úttak skrifa: (90 + a), ný-lína. 
Úttak skrifa: b, ný-lína. 
Úttak skrifa: (Satt og: b), ný-lína.

a := Listi ← ['hello'] ; ['world'] ; Satt ; Ekkert ; 666. 
a := a + ( Listi ← 1 ).
Úttak skrifa: a, ný-lína.
Úttak skrifa: ((Orðabók nýtt) setja: Ekkert við: Ekkert), ný-lína.
Úttak skrifa: a sum, ný-lína. 


{
	a við: ['texti'] gera: { <- Ekkert. }.
	a := [''] + a.
} grípa: { :error
	Úttak skrifa: ['Error noted: '] + error, ný-lína.
}, ræsa.



{
	a við: ['tala'] gera: { <- Ekkert. }.
	a := 3 × a.
} grípa: { :error
	Úttak skrifa: ['Error noted: '] + error, ný-lína.
}, ræsa.


{
	a við: ['rökgildi'] gera: { <- Ekkert. }.
	a := Satt og: a. 
} grípa: { :error
	Úttak skrifa: ['Error noted: '] + error, ný-lína.
}, ræsa.





