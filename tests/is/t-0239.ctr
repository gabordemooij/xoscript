Listi við: ['summa'] gera: {
	>> samtals := 0.
	sjálfur hver: { :vísir :stak
		samtals leggja-við: stak.
	}. <- samtals.
}.

>> a := Satt.



a við: ['texti'] gera: {
	>> svarið := Ekkert.
	( sjálfur = Satt ) satt: {
		svarið := ['Jebb'].
	}, annars: {
		svarið := ['Neibb'].
	}. <- svarið.
}.

a við: ['tala'] gera: {
	>> svarið := Ekkert.
	( sjálfur = Satt ) satt: {
		svarið := 10.
	}, annars: {
		svarið := 20.
	}. <- svarið.
}.

>> b := 666.

b við: ['texti'] gera: { <- ['Djöfull'].
}.

b við: ['rökgildi'] gera: { <- Rangt.
}.


Úttak skrifa: a, ný-lína.  
Úttak skrifa: (90 + a), ný-lína. 
Úttak skrifa: b, ný-lína. 
Úttak skrifa: (Satt og: b), ný-lína.

a := Listi ← ['hello'] ; ['world'] ; Satt ; Ekkert ; 666. 
a := a + ( Listi ← 1 ).
Úttak skrifa: a, ný-lína.
Úttak skrifa: ((Orðabók nýtt) setja: Ekkert við: Ekkert), ný-lína.
Úttak skrifa: a summa, ný-lína. 


{
	a við: ['texti'] gera: { <- Ekkert. }.
	a := [''] + a.
} grípa: { :villan
	Úttak skrifa: ['Villa skráð: '] + villan, ný-lína.
}, ræsa.



{
	a við: ['tala'] gera: { <- Ekkert. }.
	a := 3 × a.
} grípa: { :villan
	Úttak skrifa: ['Villa skráð: '] + villan, ný-lína.
}, ræsa.


{
	a við: ['rökgildi'] gera: { <- Ekkert. }.
	a := Satt og: a. 
} grípa: { :villan
	Úttak skrifa: ['Villa skráð: '] + villan, ný-lína.
}, ræsa.





{
	a við: ['texti'] gera: { <- Rangt. }.
	a := [''] + a.
} grípa: { :villan
	Úttak skrifa: ['Villa skráð: '] + villan, ný-lína.
}, ræsa.



