
>> dictionary := (
	Orðabók nýtt
		setja: ['b'] við: ['a'],
		setja: ['a'] við: ['b'],
		setja: ['z'] við: ['x'],
		setja: ['hello'] við: ['hallo'],
		setja: ['human'] við: ['human']
).

>> comparisons := Listi nýtt.
dictionary hver: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a bera-saman: b)
	).
}.

comparisons raða: { :a :b <- ( a bera-saman: b ). }.
Úttak skrifa: ( comparisons sameina: ['↵'] ), ný-lína.
comparisons sameina: ['↵'].
