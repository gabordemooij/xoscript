
>> orðasafn := (
	Orðabók nýtt
		setja: ['b'] við: ['a'],
		setja: ['a'] við: ['b'],
		setja: ['z'] við: ['x'],
		setja: ['hello'] við: ['hallo'],
		setja: ['manneskja'] við: ['manneskja']
).

>> samanburðir := Listi nýtt.
orðasafn hver: { :a :b
	samanburðir ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a bera-saman: b)
	).
}.

samanburðir raða: { :a :b <- ( a bera-saman: b ). }.
Úttak skrifa: ( samanburðir sameina: ['↵'] ), ný-lína.
samanburðir sameina: ['↵'].
