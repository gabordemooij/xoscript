Rökgildi við: ['xor:'] gera: { :a :b <- ((a og: b ekki) eða: (a ekki og: b)).
}.

>> o := Hlutur nýtt.
o við: ['hello'] gera: { ['Empty']. }.
{ o við: 2 gera: 3.} grípa: { :e Úttak skrifa: e, ný-lína. }, ræsa.
{ o við: ['prófun'] gera: 3.} grípa: { :e Úttak skrifa: e, ný-lína. }, ræsa.
{ o við: ['hello'] gera: { ['Empty']. }.} grípa: { :e Úttak skrifa: e, ný-lína. }, ræsa. 
{ >> z := 4 ÷ 0. } grípa: { :e Úttak skrifa: e, ný-lína. }, ræsa. 
{ (Satt og: Ekkert) satt: { Úttak skrifa: ['X'].}. } grípa: { :e Úttak skrifa: e, ný-lína. }, ræsa. 
{ ([''] xor: 0) satt: { Úttak skrifa: ['X'].}. } grípa: { :e Úttak skrifa: e, ný-lína. }, ræsa. 
{ (1 < ['2']) satt: { Úttak skrifa: ['OK']. }. } grípa: { :e Úttak skrifa: e, ný-lína. }, ræsa. 
{ (1 < ['2.0']) satt: { Úttak skrifa: ['OK']. }. } grípa: { :e Úttak skrifa: e, ný-lína. }, ræsa. 
{ (1 < ['x2.0']) satt: { Úttak skrifa: ['NO!']. }. } grípa: { :e Úttak skrifa: e, ný-lína. }, ræsa. 
{ Úttak skrifa: (['hello OK there'] frá: ['6'] lengd: ['2']). } ræsa. 
