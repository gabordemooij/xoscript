
>> Slurp := Hlutur nýtt.

Slurp við: ['nýtt'] gera: {
	eigin str := [''].
}.

Slurp við: ['svara:'] gera: { :blah
		(eigin str = ['']) satt: {
			eigin str bæta-aftast: blah.
		}, annars: {
			eigin str bæta-aftast: [' '].
			eigin str bæta-aftast: blah.
		}.
}.

Slurp við: ['svara:og:'] gera: { :blah :blahah
		(blah lengd > 1) satt: {
			eigin str bæta-aftast: (blah frá: 0 lengd: (blah lengd - 1)).
		}, annars: {
			eigin str bæta-aftast: blah.
		}.
		eigin str bæta-aftast: [' '].
		eigin str bæta-aftast: blahah.
}.

Slurp við: ['afla'] gera: {
	>> biðminni := eigin str.
	eigin str := ['']. <- biðminni.
}.

Úttak skrifa: ( Forrit kerfi: ( Slurp nýtt echo hello world afla ) ).
