>> Á-Dagskrá := Hlutur nýtt.

Á-Dagskrá við: ['nýtt'] gera: {
	eigin list := Listi nýtt.
}.

Á-Dagskrá við: ['nieuw'] gera: {
	eigin list := Listi nýtt.
}.

Á-Dagskrá við: ['+'] gera: { :verkefni
	eigin list bæta-aftast: verkefni.
}.

Á-Dagskrá við: ['number of tasks?'] gera: { <-  eigin list fjöldi.
}.

>> verkefnin := 
	Á-Dagskrá nýtt 
	+ ['elda kvöldmat'] 
	+ ['taka til í herberginu'].
	
Úttak skrifa: ['You have $ tasks to do'] $ verkefnin number of tasks?.
