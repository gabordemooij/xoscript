>> To-Do := Hlutur nýtt.

To-Do við: ['nýtt'] gera: {
	eigin list := Listi nýtt.
}.

To-Do við: ['nieuw'] gera: {
	eigin list := Listi nýtt.
}.

To-Do við: ['+'] gera: { :task
	eigin list bæta-aftast: task.
}.

To-Do við: ['number of tasks?'] gera: { <-  eigin list fjöldi.
}.

>> todos := 
	To-Do nýtt 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Úttak skrifa: ['You have $ tasks to do'] $ todos number of tasks?.
