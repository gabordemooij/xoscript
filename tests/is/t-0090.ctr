Úttak skrifa: ['1,2,3,4,5,6,7,8,9,A,'], ný-lína.
>> Scope := Hlutur nýtt.
Scope við: ['initialize:'] gera: { :x eigin property := x. }.
Scope við: ['confirm'] gera: { Úttak skrifa: [',']. }.
Scope við: ['prófun'] gera: {
	Úttak skrifa: eigin property.
	sjálfur confirm.
	( 1 = 1 ) satt: { Úttak skrifa: eigin property. sjálfur confirm. }.
	( 1 = 0 ) rangt: { Úttak skrifa: eigin property. sjálfur confirm. }.
	>> y := 2. { Úttak skrifa: eigin property. sjálfur confirm. } meðan: { y draga-frá: 1. <- (y > 0). }.
	{ Úttak skrifa: eigin property. sjálfur confirm. } × 1.
	(Listi ← 1) hver: {  Úttak skrifa: eigin property. sjálfur confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Orðabók nýtt one: ['item']) hver: { Úttak skrifa: eigin property. sjálfur confirm. }.
	{ 1 ÷ 0. } grípa: { Úttak skrifa: eigin property. sjálfur confirm. }, ræsa.
	Úttak ný-lína.
}.
>> scope1 := Scope nýtt.
scope1 initialize: ['X'].
scope1 prófun.
>> function := { 
	eigin property := ['Y'].
	Úttak skrifa: eigin property.
	sjálfur confirm.
	( 1 = 1 ) satt: { Úttak skrifa: eigin property. sjálfur confirm. }.
	( 1 = 0 ) rangt: { Úttak skrifa: eigin property. sjálfur confirm. }.
	>> y := 2. { Úttak skrifa: eigin property. sjálfur confirm. } meðan: { y draga-frá: 1. <- (y > 0). }.
	{ Úttak skrifa: eigin property. sjálfur confirm. } × 1.
	(Listi ← 1) hver: {  Úttak skrifa: eigin property. sjálfur confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Orðabók nýtt one: ['item']) hver: { Úttak skrifa: eigin property. sjálfur confirm. }.
	{ 1 ÷ 0. } grípa: { Úttak skrifa: eigin property. sjálfur confirm. }, ræsa.
	Úttak ný-lína.
}.
function við: ['confirm'] gera: { Úttak skrifa: [',']. }.
function beita: 1 og: 2.
