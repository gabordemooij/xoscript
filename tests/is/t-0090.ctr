Úttak skrifa: ['1,2,3,4,5,6,7,8,9,A,'], ný-lína.
>> Svið := Hlutur nýtt.
Svið við: ['initialize:'] gera: { :x eigin eigind := x. }.
Svið við: ['votta'] gera: { Úttak skrifa: [',']. }.
Svið við: ['prófun'] gera: {
	Úttak skrifa: eigin eigind.
	sjálfur votta.
	( 1 = 1 ) satt: { Úttak skrifa: eigin eigind. sjálfur votta. }.
	( 1 = 0 ) rangt: { Úttak skrifa: eigin eigind. sjálfur votta. }.
	>> y := 2. { Úttak skrifa: eigin eigind. sjálfur votta. } meðan: { y draga-frá: 1. <- (y > 0). }.
	{ Úttak skrifa: eigin eigind. sjálfur votta. } × 1.
	(Listi ← 1) hver: {  Úttak skrifa: eigin eigind. sjálfur votta. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo útfæra eigin röðun, þetta próf mistekst vegna mismunandi fjölda ítrana eftir verkvangi
	(Orðabók nýtt one: ['item']) hver: { Úttak skrifa: eigin eigind. sjálfur votta. }.
	{ 1 ÷ 0. } grípa: { Úttak skrifa: eigin eigind. sjálfur votta. }, ræsa.
	Úttak ný-lína.
}.
>> svið1 := Svið nýtt.
svið1 initialize: ['X'].
svið1 prófun.
>> fallið := { 
	eigin eigind := ['Y'].
	Úttak skrifa: eigin eigind.
	sjálfur votta.
	( 1 = 1 ) satt: { Úttak skrifa: eigin eigind. sjálfur votta. }.
	( 1 = 0 ) rangt: { Úttak skrifa: eigin eigind. sjálfur votta. }.
	>> y := 2. { Úttak skrifa: eigin eigind. sjálfur votta. } meðan: { y draga-frá: 1. <- (y > 0). }.
	{ Úttak skrifa: eigin eigind. sjálfur votta. } × 1.
	(Listi ← 1) hver: {  Úttak skrifa: eigin eigind. sjálfur votta. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Orðabók nýtt one: ['item']) hver: { Úttak skrifa: eigin eigind. sjálfur votta. }.
	{ 1 ÷ 0. } grípa: { Úttak skrifa: eigin eigind. sjálfur votta. }, ræsa.
	Úttak ný-lína.
}.
fallið við: ['votta'] gera: { Úttak skrifa: [',']. }.
fallið beita: 1 og: 2.
