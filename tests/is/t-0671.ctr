# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Hvelfing búa-til-lykla.

# private (secret) key
>> sk := keys fyrsta.

# public key
>> pk := keys síðasta.

# sign a message
>> sig := Hvelfing undirrita: ['abc'] með: sk.

# check message (ok)
Úttak skrifa: ( 
	Hvelfing
		athuga: ['abc'] 
		undirskrift: sig 
		með: pk 
), ný-lína.

# check message (fail)
Úttak skrifa: ( 
	Hvelfing 
		athuga: ['abd'] 
		undirskrift: sig 
		með: pk 
), ný-lína.