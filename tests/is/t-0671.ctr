# dreifilykill (til að tryggja API o.s.frv.)
Server init.

# búa til lykla
>> lyklar := Hvelfing búa-til-lykla.

# einkalykill (leynilykill)
>> sk := lyklar fyrsta.

# dreifilykill
>> pk := lyklar síðasta.

# undirrita skilaboð
>> sig := Hvelfing undirrita: ['abc'] með: sk.

# athuga skilaboð (í lagi)
Úttak skrifa: ( 
	Hvelfing
		athuga: ['abc'] 
		undirskrift: sig 
		með: pk 
), ný-lína.

# athuga skilaboð (mistókst)
Úttak skrifa: ( 
	Hvelfing 
		athuga: ['abd'] 
		undirskrift: sig 
		með: pk 
), ný-lína.