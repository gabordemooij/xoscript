>> map1 := Orðabók nýtt.
>> key1 := Listi nýtt.
>> key2 := Listi nýtt.

map1
	setja: ['hello'] við: key1,
	setja: ['world'] við: key2.


Úttak
	skrifa: ['Map #1 contains: '] + (map1 við: key1),
	skrifa: [' and '] + (map1 við: key2), ný-lína.

>> KeyeableArray := Listi nýtt.
KeyeableArray við: ['toString'] gera: { <- (sjálfur fjöldi) toString.
}.

>> map2 := Orðabók nýtt.
key1 := KeyeableArray nýtt.
key2 := KeyeableArray nýtt.

key1 bæta-aftast: 1.

map2
	setja: ['hello'] við: key1,
	setja: ['world'] við: key2.

Úttak
	skrifa: ['Map #2 contains: '] + (map2 við: key1),
	skrifa: [' and '] + (map2 við: key2), ný-lína.
