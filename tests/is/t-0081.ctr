>> kort1 := Orðabók nýtt.
>> lykill1 := Listi nýtt.
>> lykill2 := Listi nýtt.

kort1
	setja: ['hello'] við: lykill1,
	setja: ['world'] við: lykill2.


Úttak
	skrifa: ['Map #1 contains: '] + (kort1 við: lykill1),
	skrifa: [' og '] + (kort1 við: lykill2), ný-lína.

>> LyklanlegurListi := Listi nýtt.
LyklanlegurListi við: ['íTexta'] gera: { <- (sjálfur fjöldi) íTexta.
}.

>> map2 := Orðabók nýtt.
lykill1 := LyklanlegurListi nýtt.
lykill2 := LyklanlegurListi nýtt.

lykill1 bæta-aftast: 1.

map2
	setja: ['hello'] við: lykill1,
	setja: ['world'] við: lykill2.

Úttak
	skrifa: ['Map #2 contains: '] + (map2 við: lykill1),
	skrifa: [' og '] + (map2 við: lykill2), ný-lína.
