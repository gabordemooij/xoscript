>> Greeter := Hlutur nýtt.
Greeter við: ['make'] gera: {
	>> gr := Hlutur nýtt.
	gr við: ['setName:'] gera: { :aname
		eigin nafn := aname.
	}.
	gr við: ['greet'] gera: {
		Úttak skrifa: eigin nafn.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a nýtt.
c setName: ['THREE'].
c greet.
>> d := a nýtt.
d setName: ['FOUR'].
d greet.
c greet.
