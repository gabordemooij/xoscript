>> Heilsari := Hlutur nýtt.
Heilsari við: ['smíða'] gera: {
	>> hs := Hlutur nýtt.
	hs við: ['setName:'] gera: { :nafnið
		eigin nafn := nafnið.
	}.
	hs við: ['heilsa'] gera: {
		Úttak skrifa: eigin nafn.
	}. <- hs.
}.
>> a := Heilsari smíða.
>> b := Heilsari smíða.
a setName: ['EINN'].
b setName: ['TVEIR'].
a heilsa.
b heilsa.
>> c := a nýtt.
c setName: ['ÞRÍR'].
c heilsa.
>> d := a nýtt.
d setName: ['FJÓRIR'].
d heilsa.
c heilsa.
