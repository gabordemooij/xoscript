# gildi sem endar á fyrri hluta opnandi gæsalappar verður að lifa af raðgreiningu
>> gildi := Listi nýtt
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

gildi hver: { :i :value
	>> d := Orðabók nýtt.
	d setja: value við: ['k'].
	d setja: ['second'] við: ['j'].
	>> r := d kóði hlutur.
	Úttak skrifa: r fjöldi, ný-lína.
	Úttak skrifa: ( (r við: ['k']) = value ), ný-lína.
}.
