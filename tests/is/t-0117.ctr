>> t := Satt.
(t = Satt) satt: { Úttak skrifa: ['T']. }.
(t = Rangt) satt: { Úttak skrifa: ['F']. }.
Úttak skrifa: ['|'].
>> t := Rangt.
(t = Satt) satt: { Úttak skrifa: ['T']. }.
(t = Rangt) satt: { Úttak skrifa: ['F']. }.
Úttak skrifa: ['|'].
>> f := Satt.
(t = Satt og: f = Rangt) satt: { Úttak skrifa: ['T']. }.
(t = Rangt og: f = Satt) satt: { Úttak skrifa: ['F']. }.
Úttak skrifa: ['|'].
>> n := Ekkert.
(n Ekkert?) satt: { Úttak skrifa: ['T']. }.
(n Ekkert?) rangt: { Úttak skrifa: ['F']. }.
Úttak skrifa: ['|'].
(f Boolean?) satt: { Úttak skrifa: ['T']. }.
(f Boolean?) rangt: { Úttak skrifa: ['F']. }.



