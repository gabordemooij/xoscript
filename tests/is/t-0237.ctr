
Texti við: ['evaluate'] gera: {
	>> kóði := Skrá nýtt: ['/tmp/eval.ctr'].
	kóði skrifa: (sjálfur texti + ['.']).
	Forrit nota: ['/tmp/eval.ctr'].
}.

>> map :=
	(Orðabók nýtt)
	setja: ['Hi There'] við: ['two'],
	setja: (Listi ← ['hello'] ; ['world'] ; (Listi ← 1 ; 2; 9) ; Rangt) við: ['one'],
	setja: ( (Orðabók nýtt) setja: ['wrrld'] við: ['misspelled'] ) við: ['three'],
	setja: (Listi ← ((Orðabók nýtt) setja: ['treasure'] við: ['hidden']) ; 2) við: ['four']. 
>> str := map texti.
>> map2 := Ekkert.
(['map2 := '] + str ) evaluate.
Úttak skrifa: map2 ? ['one'] ? 0.
Úttak skrifa: map2 ? ['one'] ? 1.
Úttak skrifa: map2 ? ['four'] ? 0 ? ['hidden'].
Úttak skrifa: map2 ? ['one'] ? 2 ? 2.
