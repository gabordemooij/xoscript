
Texti við: ['meta'] gera: {
	>> kóði := Skrá nýtt: ['/tmp/eval.ctr'].
	kóði skrifa: (sjálfur texti + ['.']).
	Forrit nota: ['/tmp/eval.ctr'].
}.

>> map :=
	(Orðabók nýtt)
	setja: ['Hæ Þarna'] við: ['two'],
	setja: (Listi ← ['hello'] ; ['world'] ; (Listi ← 1 ; 2; 9) ; Rangt) við: ['einn'],
	setja: ( (Orðabók nýtt) setja: ['heimr'] við: ['stafsett vitlaust'] ) við: ['three'],
	setja: (Listi ← ((Orðabók nýtt) setja: ['fjársjóður'] við: ['falinn']) ; 2) við: ['fjórir']. 
>> str := map texti.
>> map2 := Ekkert.
(['map2 := '] + str ) meta.
Úttak skrifa: map2 ? ['einn'] ? 0.
Úttak skrifa: map2 ? ['einn'] ? 1.
Úttak skrifa: map2 ? ['fjórir'] ? 0 ? ['falinn'].
Úttak skrifa: map2 ? ['einn'] ? 2 ? 2.
