
>> borg := Listi ← ['London'] ; ['Paris'] ; ['Berlin'].
>> hitastig := Listi ← ['15'] ; ['16'] ; ['15'].
>> veður := hitastig eftir: borg.
>> borgir := veður færslur raða: { :a :b <- (a bera-saman: b). }.
>> hitatölur := veður gildi raða: { :a :b <- (a bera-saman: b) neikvætt?. }.

Úttak skrifa: (borgir sameina: [',']), ný-lína.
Úttak skrifa: (hitatölur sameina: [',']), ný-lína.
