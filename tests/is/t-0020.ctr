(Ekkert = Ekkert) satt: { Úttak skrifa: ['Nil is Nil!'].}.
(2 > 1) satt: { Úttak skrifa: ['YES']. }.
(2 > 3) satt: { Úttak skrifa: ['NO']. }.
(2 > 3) rangt: { Úttak skrifa: ['Nonono..'].}.
Satt satt: { Úttak skrifa: ['TRUE is TRUE!']. }.
(Satt) satt: { Úttak skrifa: ['TRUE is TRUE!']. }.
Rangt rangt: { Úttak skrifa: ['FALSE is FALSE!']. }.
(Rangt) rangt: { Úttak skrifa: ['FALSE is FALSE!']. }.
