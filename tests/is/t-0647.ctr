Server init.
Úttak skrifa: ['Database time test'], ný-lína.

>> db := Maria-DB nýtt hýsill: ['localhost'],
	notandanafn: ['xo'], 
	lykilorð: ['pass123'],
	nafn-gagnagrunns: ['xobase'],
	tengjast.

>> leitarfæribreytur :=
db fyrirspurn: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
sækja: { :row
	Úttak skrifa: row timetest, ný-lína.
}.
