# samræmispróf

# nota alþjóðlegar tölur

Úttak skrifa: ['1000 -> '].
Úttak skrifa: 1000, ný-lína. #1000

Úttak skrifa: ['1.5 -> '].
Úttak skrifa: 1.5, ný-lína.  #1.5

Úttak skrifa: ['1001.5 -> '].
Úttak skrifa: 1.5 + 1000, ný-lína. #1001.5

# nota fylki sem byrja á 0
>> x := Listi nýtt ; 1 ; 2 ; 3.
>> y := Listi nýtt ; ['a'] ; ['b'] ; ['c'].

Úttak skrifa: ['1 -> '].
Úttak skrifa: x ? 0, ný-lína. #1

Úttak skrifa: ['1 -> '].
Úttak skrifa: (x við: 0), ný-lína. #1

Úttak skrifa: ['1 -> '].
Úttak skrifa: x fyrsta, ný-lína. #1

Úttak skrifa: ['3 -> '].
Úttak skrifa: x síðasta, ný-lína. #3

Úttak skrifa: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Úttak skrifa: (x eftir: y), ný-lína.

Úttak skrifa: ['1 -> '].
Úttak skrifa: (x frá: 0 lengd: 1) fyrsta, ný-lína. #1

Úttak skrifa: ['0 -> '].
Úttak skrifa: (x finna: 1), ný-lína. #0

x setja: 9 við: 0.

Úttak skrifa: ['9 -> '].
Úttak skrifa: (x við: 0), ný-lína. #9

x bæta-fremst: 8.
Úttak skrifa: ['8 -> '].
Úttak skrifa: (x við: 0), ný-lína. #9


x bæta-aftast: 10.
Úttak skrifa: ['10 -> '].
Úttak skrifa: (x við: 4), ný-lína. #10








