Úttak skrifa: ['Prófunarhlutur'], ný-lína.
>> a := Hlutur nýtt. 

a við: ['item:'] gera: { :obók
	eigin obók := obók. 
}.

a við: ['liður'] gera: {
	<- eigin obók.
}.

a item: (
Orðabók nýtt
	hello: ['world']).

>> gamalt-obók-vistfang := a liður frumgerð minnisvistfang.
a save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== ENDURHLEÐ SNAP:'], ný-lína.

>> b := Hlutur load-from: ['/tmp/a.bin'].

(b liður frumgerð minnisvistfang = gamalt-obók-vistfang) satt: {
	Úttak skrifa: ['Hlutartengill tengdur aftur.'], ný-lína.
}.

Úttak skrifa: b liður, ný-lína.
