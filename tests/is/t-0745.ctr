Úttak skrifa: ['Test object'], ný-lína.
>> a := Hlutur nýtt. 

a við: ['item:'] gera: { :dict
	eigin dict := dict. 
}.

a við: ['item'] gera: { <- eigin dict.
}.

a item: (
Orðabók nýtt
	hello: ['world']).

>> old-dict-address := a item frumgerð minnisvistfang.
a save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== RELOADING SNAP:'], ný-lína.

>> b := Hlutur load-from: ['/tmp/a.bin'].

(b item frumgerð minnisvistfang = old-dict-address) satt: {
	Úttak skrifa: ['Object link re-attached.'], ný-lína.
}.

Úttak skrifa: b item, ný-lína.
