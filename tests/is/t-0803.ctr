Server init.

>> conn1 := Maria-DB nýtt hýsill: ['localhost'],
	notandanafn: ['xo'],
	lykilorð: ['pass123'],
	nafn-gagnagrunns: ['xobase'],
	tengjast.

>> conn2 := Maria-DB nýtt hýsill: ['localhost'],
	notandanafn: ['xo'],
	lykilorð: ['pass123'],
	nafn-gagnagrunns: ['xobase'],
	tengjast.
#...
>> del := conn1 fyrirspurn: ['DELETE FROM book WHERE id > 0'].
{  del keyra. conn1 staðfesta. } grípa: { :e conn1 afturkalla.  }, ræsa.

>> insert := conn1 fyrirspurn: ['INSERT INTO book (id) VALUES(null)'].
insert keyra.

>> fjöldi := conn1 fyrirspurn: ['SELECT COUNT(*) AS num FROM book'].
fjöldi sækja: { :row Úttak skrifa: row num, ný-lína. }.

# does not show up
# insert not committed on connection 1
>> fjöldi := conn2 fyrirspurn: ['SELECT COUNT(*) AS num FROM book'].
fjöldi sækja: { :row Úttak skrifa: row num, ný-lína. }.
