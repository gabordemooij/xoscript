Server init.

>> teng1 := Maria-DB nýtt hýsill: ['localhost'],
	notandanafn: ['xo'],
	lykilorð: ['pass123'],
	nafn-gagnagrunns: ['xobase'],
	tengjast.

>> teng2 := Maria-DB nýtt hýsill: ['localhost'],
	notandanafn: ['xo'],
	lykilorð: ['pass123'],
	nafn-gagnagrunns: ['xobase'],
	tengjast.
#...
>> eyðing := teng1 fyrirspurn: ['DELETE FROM book WHERE id > 0'].
{  eyðing keyra. teng1 staðfesta. } grípa: { :e teng1 afturkalla.  }, ræsa.

>> innsetning := teng1 fyrirspurn: ['INSERT INTO book (id) VALUES(null)'].
innsetning keyra.

>> fjöldi := teng1 fyrirspurn: ['SELECT COUNT(*) AS num FROM book'].
fjöldi sækja: { :röð Úttak skrifa: röð num, ný-lína. }.

# birtist ekki
# innsetning ekki staðfest á tengingu 1
>> fjöldi := teng2 fyrirspurn: ['SELECT COUNT(*) AS num FROM book'].
fjöldi sækja: { :röð Úttak skrifa: röð num, ný-lína. }.
