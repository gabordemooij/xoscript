# færri færibreytur en staðgenglar verða að gefa villu, ekki lesa út fyrir bindingarnar
Server init.

>> gg := Maria-DB nýtt hýsill: ['localhost'],
	notandanafn: ['xo'],
	lykilorð: ['pass123'],
	nafn-gagnagrunns: ['xobase'],
	tengjast.

>> leitarfæribreytur := gg fyrirspurn: ['SELECT ? AS a, ? AS b, ? AS c'].
leitarfæribreytur færibreytur: (Listi nýtt ; ['1']).
{ leitarfæribreytur sækja: { :röð Úttak skrifa: röð, ný-lína. }. } grípa: { :e Úttak skrifa: e, ný-lína. }, ræsa.

>> leitarfæribreytur := gg fyrirspurn: ['SELECT ? AS a'].
{ leitarfæribreytur sækja: { :röð Úttak skrifa: röð, ný-lína. }. } grípa: { :e Úttak skrifa: e, ný-lína. }, ræsa.

# réttur fjöldi virkar enn, fleiri færibreytur eru hunsaðar eins og áður
>> leitarfæribreytur := gg fyrirspurn: ['SELECT ? AS a, ? AS b'].
leitarfæribreytur færibreytur: (Listi nýtt ; ['1'] ; ['2']).
leitarfæribreytur sækja: { :röð Úttak skrifa: (röð við: ['a']), skrifa: (röð við: ['b']), ný-lína. }.
leitarfæribreytur færibreytur: (Listi nýtt ; ['1'] ; ['2'] ; ['3']).
leitarfæribreytur sækja: { :röð Úttak skrifa: (röð við: ['a']), skrifa: (röð við: ['b']), ný-lína. }.
