Server init.
>> f := Snið nýtt: ['%d'].
>> a := Blob nýtt: 4.
a bytes: ( Listi nýtt ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob nýtt: 4.
b bytes: ( Listi nýtt ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a frá: 0 lengd: 3, hver: { :i :byte
	Úttak skrifa: ( f beita-heiltölu: byte ), ný-lína.
}.
a ^ b.
a frá: 0 lengd: 3, hver: { :i :byte
	Úttak skrifa: ( f beita-heiltölu: byte ), ný-lína.
}.
a ^ b.
a frá: 0 lengd: 3, hver: { :i :byte
	Úttak skrifa: ( f beita-heiltölu: byte ), ný-lína.
}.
a losa.
b losa.

{ a ^ Hlutur. } grípa: { :e Úttak skrifa: e, ný-lína. }, ræsa.
