>> x := [' hallo '].

>> y := x hástafir.
Úttak skrifa: x, ný-lína.
Úttak skrifa: (x jafnt: y), ný-lína.

>> y := x lágstafir.
Úttak skrifa: x, ný-lína.
Úttak skrifa: (x jafnt: y), ný-lína.

>> y := x snyrta.
Úttak skrifa: x, ný-lína.
Úttak skrifa: (x jafnt: y), ný-lína.

>> y := x hliðrun: 1.
Úttak skrifa: x, ný-lína.
Úttak skrifa: (x jafnt: y), ný-lína.

>> y := x frá: 1 lengd: 2.
Úttak skrifa: x, ný-lína.
Úttak skrifa: (x jafnt: y), ný-lína.