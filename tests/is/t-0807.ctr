# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB nýtt hýsill: ['localhost'],
	notandanafn: ['xo'],
	lykilorð: ['pass123'],
	nafn-gagnagrunns: ['xobase'],
	tengjast.

>> leitarfæribreytur := db fyrirspurn: ['SELECT %% FROM'].
{ leitarfæribreytur keyra. } grípa: { :e
	Úttak skrifa: ( e inniheldur: ['%%'] ), ný-lína.
}, ræsa.
