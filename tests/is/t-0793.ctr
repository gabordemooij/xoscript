Server init.

>> DB := Maria-DB nýtt hýsill: ['localhost'],
	notandanafn: ['xo'],
	lykilorð: ['pass123'],
	nafn-gagnagrunns: ['xobase'],
	tengjast.

{
	DB fyrirspurn:
	['DROP TABLE movies'],
	keyra.
} grípa: { Ekkert. }, ræsa.

DB fyrirspurn:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
keyra.

DB fyrirspurn: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
færibreytur: ( Listi nýtt ; ['Halloween'] ),
keyra.

DB fyrirspurn: ['SELECT * FROM movies'],
sækja: { :movie
	Úttak skrifa: movie title, ný-lína.
}.

