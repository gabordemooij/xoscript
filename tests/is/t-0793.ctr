Server init.

>> GG := Maria-DB nýtt hýsill: ['localhost'],
	notandanafn: ['xo'],
	lykilorð: ['pass123'],
	nafn-gagnagrunns: ['xobase'],
	tengjast.

{
	GG fyrirspurn:
	['DROP TABLE movies'],
	keyra.
} grípa: { Ekkert. }, ræsa.

GG fyrirspurn:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
keyra.

GG fyrirspurn: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
færibreytur: ( Listi nýtt ; ['Halloween'] ),
keyra.

GG fyrirspurn: ['SELECT * FROM movies'],
sækja: { :kvikmynd
	Úttak skrifa: kvikmynd title, ný-lína.
}.

