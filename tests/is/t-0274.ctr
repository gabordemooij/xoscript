

Listi við: ['column:'] gera: { :dálkur
	>> niðurstaða := Listi nýtt.
	sjálfur hver: { :vísir :röð
		röð hver: { :vísir :reitur
			(vísir = dálkur) satt: { niðurstaða bæta-aftast: reitur. }.
		}.
	}. <- niðurstaða.
}.


>> a := Listi ←
	(Listi ← 1 ; 2 ; 3) ;
	(Listi ← 4 ; 5 ; 6) ;
	(Listi ← 7 ; 8 ; 9).

>> b := a column: 1.
Úttak skrifa: b, ný-lína.

b := a column: 20.
Úttak skrifa: b, ný-lína.

b := a column: -100.
Úttak skrifa: b, ný-lína.
