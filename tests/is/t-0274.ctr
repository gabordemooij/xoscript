

Listi við: ['column:'] gera: { :column
	>> result := Listi nýtt.
	sjálfur hver: { :index :row
		row hver: { :index :cell
			(index = column) satt: { result bæta-aftast: cell. }.
		}.
	}. <- result.
}.


>> a := Listi ←
	(Listi ← 1 ; 2 ; 3) ;
	(Listi ← 4 ; 5 ; 6) ;
	(Listi ← 7 ; 8 ; 9).

>> b := a column: 1.
Úttak skrifa: b, ný-lína.

b := a column: 20.
Úttak skrifa: b, ný-lína.

b := a column: -100.
Úttak skrifa: b, ný-lína.
