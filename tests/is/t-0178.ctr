

>> notaðMinni1 := 0.
>> notaðMinni2 := 0.
>> notaðMinni3 := 0.
>> notaðMinni4 := 0.

Forrit minnisstjórnun: 0.

>> txt := ['Word Salad'].
Úttak skrifa: ['síðasta staða rða = '] + (( txt síðasta: ['ord'] ) - 0), ný-lína.
Úttak skrifa: ['staða rða = '] + (( txt finna: ['ord'] ) - 0), ný-lína.
Úttak skrifa: ['staða at = '] + (( txt finna: ['ad'] ) - 0), ný-lína.
Úttak skrifa: ['síðasta staða W = '] + (( txt síðasta: ['W'] ) - 0), ný-lína.
Úttak skrifa: ['síðasta staða d = '] + (( txt síðasta: ['d'] ) - 0), ný-lína.
Úttak skrifa: ['txt jafngildir Orðasalat = '] + ( txt = ['Word Salad'] ), ný-lína.
Úttak skrifa: ['txt jafngildir Sesarsalat = '] + ( txt = ['Sesarsalat'] ), ný-lína.
Úttak skrifa: ['txt jafngildir ekki Orðasalat = '] + ( txt ≠ ['Word Salad'] ), ný-lína.
Úttak skrifa: ['txt jafngildir ekki Sesarsalat = '] + ( txt ≠ ['Sesarsalat'] ), ný-lína.

