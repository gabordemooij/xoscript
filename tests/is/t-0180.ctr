Texti við: ['html'] gera: { <- (
		sjálfur
		skipta: ['&'] fyrir: ['&amp;'],
		skipta: ['<'] fyrir: ['&lt;'],
		skipta: ['>'] fyrir: ['&gt;'],
		skipta: ['''] fyrir: ['&apos;'],
		skipta: ['"'] fyrir: ['&quot;']
	).
}.

>> notaðMinni1 := 0.
>> notaðMinni2 := 0.
>> notaðMinni3 := 0.
>> notaðMinni4 := 0.

Forrit minnisstjórnun: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Úttak skrifa: txt afrita html, ný-lína.
Úttak skrifa: txt afrita lágstafir, ný-lína.
Úttak skrifa: txt afrita hástafir, ný-lína.
} ræsa.

Forrit taka-til.

notaðMinni1 := (Forrit minni ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Úttak skrifa: txt afrita html, ný-lína.
Úttak skrifa: txt afrita lágstafir, ný-lína.
Úttak skrifa: txt afrita hástafir, ný-lína.
} ræsa.

Forrit taka-til.
notaðMinni2 := (Forrit minni ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Úttak skrifa: txt afrita html, ný-lína.
Úttak skrifa: txt afrita lágstafir, ný-lína.
Úttak skrifa: txt afrita hástafir, ný-lína.
} ræsa.

Forrit taka-til.
notaðMinni3 := (Forrit minni ? 0).



( notaðMinni1 = notaðMinni2 og: notaðMinni1 = notaðMinni3, og: notaðMinni2 = notaðMinni3 ) satt: {
	Úttak skrifa: ['Enginn minnisleki hér'].
}, rangt: {
	Úttak skrifa: ['Minni lekur...'].
}.
