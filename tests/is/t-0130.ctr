# FFI notað með Server-viðbótinni

# tengjast libc (háð verkvangi)
>> safnheiti := Forrit stilling: ['FFITESTLIB'].

# tengja stdio-föll úr C fyrir ítarlegri skráaraðgerðir
Server tengja: ( Listi nýtt ;
 safnheiti ; ['fopen'] ;
 ( Listi nýtt ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
tengja: ( Listi nýtt ;
 Ekkert ; # þýðir sama safn
 ['fread'] ;
 ( Listi nýtt ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Ekkert ; # þýðir sama hlut (þ.e. Stream)
 ['fread']
),
tengja: (
 Listi nýtt ;
 Ekkert ; # þýðir sama safn
 ['fwrite'] ;
 ( Listi nýtt ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Ekkert ; # þýðir sama safn
 ['fwrite']
),
tengja: (
 Listi nýtt ;
 Ekkert ; # þýðir sama safn
 ['rewind'] ;
 ( Listi nýtt ; ['pointer'] ) ;
 ['int'] ;
 Ekkert ; # þýðir sama safn
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> slóð := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# opna skrá með fopen(path, mode)
>> fd := Stream path: slóð mode: mode.

# skrifa bæti úr biðminninu str í skrá
>> bæti-skrifuð := Stream skilaboð: ['fwrite'] viðföng: (Listi nýtt ; str ; 1 ; 6 ; fd ).
Úttak skrifa: bæti-skrifuð, ný-lína.

# spóla skráarbendinum til baka
Stream rewind: fd.

# taka frá biðminni
>> bm := Blob nýtt: 20.

# lesa úr skrá
>> bæti-lesin := Stream skilaboð: ['fread'] viðföng: (Listi nýtt ; bm ; 1 ; 6 ; fd ).
Úttak skrifa: bæti-lesin, ný-lína.
Úttak skrifa: bm, ný-lína.

# losa minni
str  losa.
slóð losa.
mode losa.
bm  losa.


