>> z := Hlutur nýtt.
z við: ['value:'] gera: { :v
	eigin value := v. <- sjálfur.
}.
z við: ['value'] gera: { <- eigin value. }.
(z setValue: 1) value: 2.
Úttak skrifa: z value.
>> x := z.
Úttak skrifa: x value.
z := Ekkert.
Úttak skrifa: z value.
Úttak skrifa: x value.
Úttak skrifa: ['hello'].
Úttak skrifa: 3 + 2.
Úttak skrifa: (3 > 2).
