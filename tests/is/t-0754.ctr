Úttak skrifa: ['Prófunarhlutur'], ný-lína.
>> a := Hlutur nýtt. 

a við: ['item:'] gera: { :út
	eigin út := út. 
}.

a við: ['liður'] gera: {
	<- eigin út.
}.

a við: ['heilsa'] gera: {
	Úttak skrifa: ['hæ frá upprunalega úttakinu!'], ný-lína.
}.

a item: Úttak.

Úttak skrifa: a liður, ný-lína.

>> gamalt-út-vistfang := a liður frumgerð minnisvistfang.
a save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== ENDURHLEÐ SNAP:'], ný-lína.

>> b := Hlutur load-from: ['/tmp/a.bin'].

(b liður frumgerð minnisvistfang = gamalt-út-vistfang) satt: {
	Úttak skrifa: ['Hlutartengill tengdur aftur.'], ný-lína.
}.

b liður skrifa: ['halló frá hlaðna úttakinu!'], ný-lína.
b heilsa.
