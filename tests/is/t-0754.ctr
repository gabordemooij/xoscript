Úttak skrifa: ['Test object'], ný-lína.
>> a := Hlutur nýtt. 

a við: ['item:'] gera: { :out
	eigin out := out. 
}.

a við: ['item'] gera: { <- eigin out.
}.

a við: ['greet'] gera: {
	Úttak skrifa: ['hi from original out!'], ný-lína.
}.

a item: Úttak.

Úttak skrifa: a item, ný-lína.

>> old-out-address := a item frumgerð minnisvistfang.
a save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== RELOADING SNAP:'], ný-lína.

>> b := Hlutur load-from: ['/tmp/a.bin'].

(b item frumgerð minnisvistfang = old-out-address) satt: {
	Úttak skrifa: ['Object link re-attached.'], ný-lína.
}.

b item skrifa: ['hello from loaded out!'], ný-lína.
b greet.
