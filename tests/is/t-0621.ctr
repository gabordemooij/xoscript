>> phrases := Listi nýtt
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases hver: { :_ :phrase 
	>> e := Server base64-kóða: phrase.
	>> d := Server base64-afkóða: e.
	Úttak skrifa: (
		message afrita ~encoded: e, ~decoded: d
	), ný-lína.
}.
