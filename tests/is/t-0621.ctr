>> orðasambönd := Listi nýtt
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> skilaboðin := ['Phrase: ~decoded base64: ~encoded'].
	
orðasambönd hver: { :_ :orðasamband 
	>> e := Server base64-kóða: orðasamband.
	>> d := Server base64-afkóða: e.
	Úttak skrifa: (
		skilaboðin afrita ~encoded: e, ~decoded: d
	), ný-lína.
}.
