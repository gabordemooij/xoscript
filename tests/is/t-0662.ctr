>> t := Ekkert.

# you can control the time zone for
# parsing like this:
Stund svæði: ['CET'].
t := Stund úr: ['1981-02-03 04:05:06'].
Úttak skrifa: t, ný-lína.

# now using CEST time zone:
Stund svæði: ['CEST'].
t := Stund úr: ['1981-02-03 04:05:06'].
Úttak skrifa: t, ný-lína.

# error if string cannot be parsed
{ Stund úr: ['1900']. } grípa: { Ekkert. }, ræsa.
