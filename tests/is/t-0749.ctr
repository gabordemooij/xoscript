Úttak skrifa: ['Prófunarhlutur'], ný-lína.
>> a := Hlutur nýtt. 

a við: ['item:'] gera: { :rökgildi
	eigin rökgildi := rökgildi. 
}.

a við: ['liður'] gera: {
	<- eigin rökgildi.
}.

a item: Rangt.

Úttak skrifa: a liður, ný-lína.

>> gamalt-bool-vistfang := a liður frumgerð minnisvistfang.
a save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== ENDURHLEÐ SNAP:'], ný-lína.

>> b := Hlutur load-from: ['/tmp/a.bin'].

(b liður frumgerð minnisvistfang = gamalt-bool-vistfang) satt: {
	Úttak skrifa: ['Hlutartengill tengdur aftur.'], ný-lína.
}.

Úttak skrifa: b liður, ný-lína.
