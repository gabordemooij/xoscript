# Prófa ASCII-afbrigði

# Tölur

Úttak skrifa: (2 !=: 3), ný-lína.
Úttak skrifa: (2 <=: 2), ný-lína.
Úttak skrifa: (2 >=: 2), ný-lína.

# Textar

Úttak skrifa: (['b'] >=: ['a']), ný-lína.
Úttak skrifa: (['b'] !=: ['a']), ný-lína.
Úttak skrifa: (['b'] <=: ['c']), ný-lína.

# Rökgildi

Úttak skrifa: (Satt !=: Rangt), ný-lína.

# Hlutir

Úttak skrifa: (Hlutur nýtt !=: Hlutur nýtt), ný-lína.

# ASCII-listatákn <-:

Úttak skrifa: (Listi <<: 1, ; 2 ; 3) fjöldi = 3, ný-lína.

