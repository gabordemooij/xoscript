# prófa tilgreiningar

>> $ := Hlutur nýtt.

$ við: ['svara:'] gera: { :x
	
	>> aðgerð := x stafur: 0.
	>> valuta := x stafur: 1.
	>> peningar := x hliðrun: 2.
	
	>> upphæð := 0.

	( aðgerð = ['+'] ) satt: {
		( valuta = ['£'] ) satt: { upphæð := 1.28 × peningar. }.
	}. <- upphæð.
}.



>> x := $ +£20.

Úttak skrifa: x, ný-lína.


>> Ávöxtur := Hlutur nýtt.

Ávöxtur við: ['nýtt'] gera: {
	>> f := sjálfur nýtt.
	f apples: 0.
	f oranges: 0. <- f.
}.

Ávöxtur við: ['apples:'] gera: { :a eigin eplin := a. }.
Ávöxtur við: ['oranges:'] gera: { :p eigin appelsínur := p. }.
Ávöxtur við: ['eplin'] gera: { <- eigin eplin. }.
Ávöxtur við: ['appelsínur'] gera: { <- eigin appelsínur. }.

Ávöxtur við: ['+'] gera: { :f
	
	>> n := Ávöxtur nýtt.
	f leggja-við: 1.
	
	n apples: (f eplin + eigin eplin).
	n oranges:  (f appelsínur  + eigin appelsínur). <- n.
}.

Ávöxtur við: ['texti'] gera: { <- ( eigin eplin texti + [' epli og '] + eigin appelsínur + [' appelsínur'] ).
}.

Tala við: ['eplin'] gera: { <- ((Ávöxtur nýtt) apples: sjálfur).
}.

Tala við: ['apple'] gera: { <- ((Ávöxtur nýtt) apples: sjálfur).
}.

Tala við: ['appelsínur'] gera: { <- ((Ávöxtur nýtt) oranges: sjálfur).
}.




Úttak skrifa: (1 apple + 3 appelsínur + 4 eplin), ný-lína.


Texti við: ['tvisvar'] gera: { <- ((sjálfur texti) + (sjálfur texti)).
}.



Úttak skrifa: ['❤❤❤'] tvisvar.



