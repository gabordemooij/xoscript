# test qualifiers

>> $ := Hlutur nýtt.

$ við: ['svara:'] gera: { :x
	
	>> operation := x stafur: 0.
	>> valuta := x stafur: 1.
	>> money := x hliðrun: 2.
	
	>> amount := 0.

	( operation = ['+'] ) satt: {
		( valuta = ['£'] ) satt: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Úttak skrifa: x, ný-lína.


>> Fruit := Hlutur nýtt.

Fruit við: ['nýtt'] gera: {
	>> f := sjálfur nýtt.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit við: ['apples:'] gera: { :a eigin apples := a. }.
Fruit við: ['oranges:'] gera: { :p eigin oranges := p. }.
Fruit við: ['apples'] gera: { <- eigin apples. }.
Fruit við: ['oranges'] gera: { <- eigin oranges. }.

Fruit við: ['+'] gera: { :f
	
	>> n := Fruit nýtt.
	f leggja-við: 1.
	
	n apples: (f apples + eigin apples).
	n oranges:  (f oranges  + eigin oranges). <- n.
}.

Fruit við: ['texti'] gera: { <- ( eigin apples texti + [' apples and '] + eigin oranges + [' oranges'] ).
}.

Tala við: ['apples'] gera: { <- ((Fruit nýtt) apples: sjálfur).
}.

Tala við: ['apple'] gera: { <- ((Fruit nýtt) apples: sjálfur).
}.

Tala við: ['oranges'] gera: { <- ((Fruit nýtt) oranges: sjálfur).
}.




Úttak skrifa: (1 apple + 3 oranges + 4 apples), ný-lína.


Texti við: ['twice'] gera: { <- ((sjálfur texti) + (sjálfur texti)).
}.



Úttak skrifa: ['❤❤❤'] twice.



