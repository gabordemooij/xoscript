Úttak skrifa: ['Test object'], ný-lína.
>> a := Hlutur nýtt. 

a við: ['item:'] gera: { :binhelper
	eigin binhelper := binhelper. 
}.

a við: ['item'] gera: { <- eigin binhelper.
}.

a item: Bin nýtt.

>> old-binhelper-address := a item frumgerð minnisvistfang.
a save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== RELOADING SNAP:'], ný-lína.

>> b := Hlutur load-from: ['/tmp/a.bin'].

(b item frumgerð minnisvistfang = old-binhelper-address) satt: {
	Úttak skrifa: ['Object link re-attached.'], ný-lína.
}.


