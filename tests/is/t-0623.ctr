

>> g  := Server nýtt.
>> v  := Hvelfing nýtt.
>> ok := 0.

>> leyndarmálin := Listi nýtt ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> lykilorðin := leyndarmálin afrita.
lykilorðin hver: { :i :p
	leyndarmálin hver: { :n :s
		{
			>> dulkóðað := v dulkóða: s lykill: p.
			>> afkóðað := v afkóða-dulmál: dulkóðað lykill: p.
			(afkóðað = s) satt: {
				ok leggja-við: 1.
			}, annars: {
				Úttak skrifa: ['dulkóðun/afkóðun mistókst: '], ný-lína.
				Úttak skrifa: s, ný-lína.
				Úttak skrifa: ['dulkóðað: '] + dulkóðað, ný-lína.
				Úttak skrifa: ['afkóðað: '] + dulkóðað, ný-lína.
				Forrit enda.
			}.
		} grípa: { :vl
			(s = [''] eða: p = ['']) satt: {
				ok leggja-við: 1.
			}, annars: {
				Úttak skrifa: vl, ný-lína.
				Forrit enda.
			}.
		}, ræsa.
	}.
}.

Úttak skrifa: ( ok + [' dulkóðanir peningaskáps prófaðar.'] ), ný-lína.