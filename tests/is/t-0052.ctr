>> items := Orðabók nýtt.
items setja: ['green'] við: ['color-1'].
items setja: ['orange'] við: ['color-2'].
items setja: ['red'] við: ['color-3'].
>> i := 0.
>> s := [''].
items hver: { :key :color
	Úttak skrifa: ['color #'] + i + [' is: '] + color + [' '].
	i leggja-við: 1.
}.
Úttak skrifa: i + [' colors!'].
