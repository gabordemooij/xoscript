>> items := Orðabók nýtt.
items setja: ['grænn'] við: ['color-1'].
items setja: ['appelsínugulur'] við: ['color-2'].
items setja: ['rauður'] við: ['color-3'].
>> i := 0.
>> s := [''].
items hver: { :key :litur
	Úttak skrifa: ['color #'] + i + [' er: '] + litur + [' '].
	i leggja-við: 1.
}.
Úttak skrifa: i + [' litir!'].
