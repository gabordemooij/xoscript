Server init.
Úttak skrifa: ['Database datetime test'], ný-lína.

>> db := Maria-DB nýtt hýsill: ['localhost'],
	notandanafn: ['xo'], 
	lykilorð: ['pass123'],
	nafn-gagnagrunns: ['xobase'],
	tengjast.

>> leitarfæribreytur :=
db fyrirspurn: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
sækja: { :row
	Úttak skrifa: row datetimetest, ný-lína.
}.
