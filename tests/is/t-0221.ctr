>> x := Hlutur nýtt.
>> y := Hlutur nýtt.
>> z := x.
Úttak skrifa: (x = z), ný-lína.
Úttak skrifa: (x = y), ný-lína.
Úttak skrifa: (x ≠ y), ný-lína.
Úttak skrifa: (x ≠ z), ný-lína.
>> m := Stund nýtt ár: 2070, mánuður: 11.
>> n := m afrita.
Úttak skrifa: (m = n), ný-lína.
Úttak skrifa: (m ≠ n), ný-lína.
Úttak skrifa: (m jafnt: m), ný-lína.
Úttak skrifa: (m jafnt: n), ný-lína.
n mánuður: 12.
Úttak skrifa: (m ≠ n), ný-lína.
Úttak skrifa: (m = n), ný-lína.


