>> randomizer := { :a :b
	>> lágmark := ( a < b ) annaðhvort: a eða: b.
	>> hámark := ( a > b ) annaðhvort: a eða: b.
	>> x := Ekkert.
	{
		x := Tala milli: a og: b.
		((x < lágmark) eða: (x > hámark)) satt: { 
			Úttak skrifa: (['Invalid value!']).
			Forrit enda.
		}.
	} 
	× 100. <- x.
}.
