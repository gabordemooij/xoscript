
>> countries := Listi nýtt
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Listi nýtt
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods eftir: countries, hver: { :key :value
	counter leggja-við: 1.
}.

Úttak skrifa: (['we serve counter dishes'] counter: counter), ný-lína.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] stafir raða: { :v
	counter leggja-við: 0.
}.

Úttak skrifa: (['we sort counter dishes'] counter: counter), ný-lína.


>> counter := 0.
{
	{
		counter leggja-við: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Úttak skrifa: (['we calculate counter numbers.'] counter: counter), ný-lína.

