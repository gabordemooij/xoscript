
>> lönd := Listi nýtt
	~ ['Sviss']
	~ ['Ítalía']
	~ ['Þýskaland'].

>> matvæli := Listi nýtt
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Súrkál'].


>> teljari := 0.
matvæli eftir: lönd, hver: { :key :value
	teljari leggja-við: 1.
}.

Úttak skrifa: (['we serve counter dishes'] counter: teljari), ný-lína.

>> teljari := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] stafir raða: { :v
	teljari leggja-við: 0.
}.

Úttak skrifa: (['we sort counter dishes'] counter: teljari), ný-lína.


>> teljari := 0.
{
	{
		teljari leggja-við: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Úttak skrifa: (['we calculate counter numbers.'] counter: teljari), ný-lína.

