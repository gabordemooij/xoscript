{
	þetta-verk villa: ['Dont fail.'].
	unknown doSomething.
} grípa: {
	Úttak skrifa: ['Caught!'].
}, ræsa.

{
	þetta-verk villa: ['Dont fail.'].
	eigin unknown doSomething.
} grípa: {
	Úttak skrifa: ['Caught!'].
}, ræsa.

{
	þetta-verk villa: ['Dont fail.'].
	unknown := 122.
} grípa: {
	Úttak skrifa: ['Caught!'].
}, ræsa.


{
	þetta-verk villa: ['Dont fail.'].
	Satt rjúfa.
	Úttak skrifa: ['FAIL'].
} grípa: {
	Úttak skrifa: ['Caught!'].
}, ræsa.

{
	{
		þetta-verk villa: ['Dont fail.'].
		Satt rjúfa.
		Úttak skrifa: ['FAIL'].
	} grípa: { :x
		(x = ['Dont fail.']) satt: { þetta-verk villa: ['Nested Caught!']. }.
	}, ræsa.
} grípa: { :e
	Úttak skrifa: e.
}, ræsa.
