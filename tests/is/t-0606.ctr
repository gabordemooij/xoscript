>> Point := Hlutur nýtt.
Point við: ['x-coordinate:'] gera: { :x eigin x := x. }.
Point við: ['y-coordinate:'] gera: { :y eigin y := y. }.
Point við: ['x-coordinate']  gera: { <- eigin x afrita. }.
Point við: ['y-coordinate']  gera: { <- eigin y afrita. }.

Point við: ['='] gera: { :other <- ( eigin x = other x-coordinate
		 og: eigin y = other y-coordinate ).
}.

>> pier := Point nýtt x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point nýtt x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point nýtt x-coordinate: 5, y-coordinate: 6.

Úttak skrifa: pier = town-hall, ný-lína.
Úttak skrifa: pier = restaurant, ný-lína.
