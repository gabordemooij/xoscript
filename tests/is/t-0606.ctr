>> Punktur := Hlutur nýtt.
Punktur við: ['x-coordinate:'] gera: { :x eigin x := x. }.
Punktur við: ['y-coordinate:'] gera: { :y eigin y := y. }.
Punktur við: ['x-hnit']  gera: { <- eigin x afrita. }.
Punktur við: ['y-hnit']  gera: { <- eigin y afrita. }.

Punktur við: ['='] gera: { :hinn
	<- ( eigin x = hinn x-hnit
		 og: eigin y = hinn y-hnit ).
}.

>> bryggja := Punktur nýtt x-coordinate: 5, y-coordinate: 6.
>> ráðhús := Punktur nýtt x-coordinate: 7, y-coordinate: 1.
>> veitingastaður := Punktur nýtt x-coordinate: 5, y-coordinate: 6.

Úttak skrifa: bryggja = ráðhús, ný-lína.
Úttak skrifa: bryggja = veitingastaður, ný-lína.
