# prófa biðminni PKI/undirritun 
Server init.

>> langur := ( Listi nýtt fylla: 1000 með: ['a'] ) sameina: [''].

# undirrita skilaboð
Úttak skrifa: ( 
	Hvelfing undirrita: ['abc'] með: langur
), ný-lína.

Úttak skrifa: ( 
	Hvelfing
		athuga: ['abc'] 
		undirskrift: langur 
		með: langur
), ný-lína.

Úttak skrifa: (
	Hvelfing lykilorðstæti: langur staðfesta: langur
), ný-lína.
