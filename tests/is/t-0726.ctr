# test buffers PKI/Sign 
Server init.

>> long := ( Listi nýtt fylla: 1000 með: ['a'] ) sameina: [''].

# sign a message
Úttak skrifa: ( 
	Hvelfing undirrita: ['abc'] með: long
), ný-lína.

Úttak skrifa: ( 
	Hvelfing
		athuga: ['abc'] 
		undirskrift: long 
		með: long
), ný-lína.

Úttak skrifa: (
	Hvelfing lykilorðstæti: long staðfesta: long
), ný-lína.
