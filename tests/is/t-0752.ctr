Úttak skrifa: ['Test object'], ný-lína.
>> a := Hlutur nýtt. 

a við: ['item:'] gera: { :rökgildi
	eigin rökgildi := rökgildi. 
}.

a við: ['item'] gera: { <- eigin rökgildi.
}.

a item: Rökgildi.

Úttak skrifa: a item, ný-lína.

>> old-bool-address := a item frumgerð minnisvistfang.
a save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== RELOADING SNAP:'], ný-lína.

>> b := Hlutur load-from: ['/tmp/a.bin'].

(b item frumgerð minnisvistfang = old-bool-address) satt: {
	Úttak skrifa: ['Object link re-attached.'], ný-lína.
}.

Úttak skrifa: b item, ný-lína.
