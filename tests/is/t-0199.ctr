
Forrit minnisstjórnun: 4.

>> Dýr := Hlutur nýtt.
Dýr við: ['smíða'] gera: {
	>> dýr := Hlutur nýtt.
	dýr við: ['gefaHljóð'] gera: {
		Úttak skrifa: eigin hljóð.
	}. <- dýr.
}.
>> Köttur := Hlutur nýtt.
Köttur við: ['smíða'] gera: {
	>> köttur := Dýr smíða.
	köttur við: ['init'] gera: {
		eigin hljóð := ['meow!'].
	}.
	köttur init. <- köttur.
}.
>> tom := Köttur smíða.
tom gefaHljóð.
