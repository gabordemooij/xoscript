
Forrit minnisstjórnun: 4.

>> Animal := Hlutur nýtt.
Animal við: ['make'] gera: {
	>> animal := Hlutur nýtt.
	animal við: ['makeSound'] gera: {
		Úttak skrifa: eigin sound.
	}. <- animal.
}.
>> Cat := Hlutur nýtt.
Cat við: ['make'] gera: {
	>> cat := Animal make.
	cat við: ['init'] gera: {
		eigin sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
