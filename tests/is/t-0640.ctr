
Server init.
Úttak skrifa: ['Gagnagrunnsprófun'], ný-lína.

>> gg := Maria-DB nýtt hýsill: ['localhost'],
	notandanafn: ['xo'], 
	lykilorð: ['pass123'],
	nafn-gagnagrunns: ['xobase'],
	tengjast.

>> leitarfæribreytur :=
gg fyrirspurn: ['SELECT UNHEX('CAFE') AS blobby'],
sækja: { :röð
	Úttak skrifa: ( röð blobby frá: 0 lengd: 2 ), ný-lína.
	röð blobby losa.
}.
