
Server init.
Úttak skrifa: ['Database test'], ný-lína.

>> db := Maria-DB nýtt hýsill: ['localhost'],
	notandanafn: ['xo'], 
	lykilorð: ['pass123'],
	nafn-gagnagrunns: ['xobase'],
	tengjast.

>> leitarfæribreytur :=
db fyrirspurn: ['SELECT UNHEX('CAFE') AS blobby'],
sækja: { :row
	Úttak skrifa: ( row blobby frá: 0 lengd: 2 ), ný-lína.
	row blobby losa.
}.
