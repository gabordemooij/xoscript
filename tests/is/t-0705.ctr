

>> hlt := Hlutur nýtt.

hlt við: ['heilsa'] gera: {
	<- ['hæ'].
}.

# þarf að skrifa út hi123hi123ok
hlt við: ['verkefni'] gera: {
	eigin eigind := 123.
	{
		# reyna bindur sjálfur/eigin við hlutinn í stað kubbsins
		Úttak skrifa: sjálfur heilsa.
		Úttak skrifa: eigin eigind.
		1 / 0.
	} grípa: {
		Úttak skrifa: sjálfur heilsa.
		Úttak skrifa: eigin eigind.
		Úttak skrifa: ['ok'].
	}, reyna.
}.

hlt verkefni.