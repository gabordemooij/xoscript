

>> obj := Hlutur nýtt.

obj við: ['greet'] gera: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj við: ['task'] gera: {
	eigin property := 123.
	{
		# try binds self/own to object instead of block
		Úttak skrifa: sjálfur greet.
		Úttak skrifa: eigin property.
		1 / 0.
	} grípa: {
		Úttak skrifa: sjálfur greet.
		Úttak skrifa: eigin property.
		Úttak skrifa: ['ok'].
	}, reyna.
}.

obj task.