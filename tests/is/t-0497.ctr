Server init.

# write a test file
>> f := Skrá nýtt: ['/tmp/test.gif'].
f skrifa: ['GIF87a01234567810'].

# serve the file
Server áframsenda: ['test.gif'] forskeyti: ['/tmp/'].

Úttak ný-lína.

Úttak skrifa: ['Outside container (security):'], ný-lína.
{ Server áframsenda: ['../passwd'] forskeyti: ['/tmp/']. }
grípa: { :e Úttak skrifa: e, ný-lína. },
ræsa.

Úttak skrifa: ['Invalid prefix:'], ný-lína.
{ Server áframsenda: ['test.gif'] forskeyti: ['z:\\']. }
grípa: { :e Úttak skrifa: e, ný-lína. },
ræsa.

Úttak skrifa: ['Non-existant file:'], ný-lína.
{ Server áframsenda: ['xxx.xxx'] forskeyti: ['/tmp/']. }
grípa: { :e Úttak skrifa: e, ný-lína. },
ræsa.
