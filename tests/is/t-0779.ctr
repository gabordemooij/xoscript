Úttak skrifa: ['Prófunarhlutur'], ný-lína.
>> p := Slóð /tmp.
Úttak skrifa: p, ný-lína.
>> gamalt-p-vistfang := p frumgerð minnisvistfang.
p save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== ENDURHLEÐ SNAP:'], ný-lína.
>> b := Hlutur load-from: ['/tmp/a.bin'].
(b frumgerð minnisvistfang = gamalt-p-vistfang) satt: {
	Úttak skrifa: ['Hlutartengill tengdur aftur.'], ný-lína.
}.
Úttak skrifa: b, ný-lína.
