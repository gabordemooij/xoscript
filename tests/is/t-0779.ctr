Úttak skrifa: ['Test object'], ný-lína.
>> p := Slóð /tmp.
Úttak skrifa: p, ný-lína.
>> old-p-address := p frumgerð minnisvistfang.
p save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== RELOADING SNAP:'], ný-lína.
>> b := Hlutur load-from: ['/tmp/a.bin'].
(b frumgerð minnisvistfang = old-p-address) satt: {
	Úttak skrifa: ['Object link re-attached.'], ný-lína.
}.
Úttak skrifa: b, ný-lína.
