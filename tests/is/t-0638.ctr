
Server init.
>> bð := HTTP-Beiðni nýtt.
Úttak skrifa: ['HTTP-GET d[]=']  + ( bð get-listi: ['d[]'] ), ný-lína. # GET
Úttak skrifa: ['HTTP-GET f[]=']  + ( bð get-listi: ['f[]'] ), ný-lína. # GET
Úttak skrifa: ['HTTP-POST e[]='] + ( bð post-listi: ['e[]'] ), ný-lína. # GET
Úttak skrifa: ['HTTP-POST c=']   + ( bð post: ['c'] ), ný-lína. # GET
Úttak skrifa: ['HTTP-POST xx=']  + ( bð post: ['xx'] ), ný-lína. # GET
