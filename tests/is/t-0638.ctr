
Server init.
>> rq := HTTP-Beiðni nýtt.
Úttak skrifa: ['HTTP-GET d[]=']  + ( rq get-listi: ['d[]'] ), ný-lína. # GET
Úttak skrifa: ['HTTP-GET f[]=']  + ( rq get-listi: ['f[]'] ), ný-lína. # GET
Úttak skrifa: ['HTTP-POST e[]='] + ( rq post-listi: ['e[]'] ), ný-lína. # GET
Úttak skrifa: ['HTTP-POST c=']   + ( rq post: ['c'] ), ný-lína. # GET
Úttak skrifa: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), ný-lína. # GET
