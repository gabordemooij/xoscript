Server init.

>> GG := Maria-DB nýtt hýsill: ['localhost'],
	notandanafn: ['xo'],
	lykilorð: ['pass123'],
	nafn-gagnagrunns: ['xobase'],
	tengjast.
	
>> SQL := ['SELECT "hello" AS "world" '].

# fljótlegri leið, sækja fyrirspurn úr GG:
>> fyrirspurn2 := GG fyrirspurn: SQL.

# nú þarftu ekki að stilla GG
fyrirspurn2 sækja: { :röð
	Úttak skrifa: röð world, ný-lína.
}.
