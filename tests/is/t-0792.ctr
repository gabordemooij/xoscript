Server init.

>> DB := Maria-DB nýtt hýsill: ['localhost'],
	notandanafn: ['xo'],
	lykilorð: ['pass123'],
	nafn-gagnagrunns: ['xobase'],
	tengjast.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB fyrirspurn: SQL.

# now you don't have to set DB
query2 sækja: { :row
	Úttak skrifa: row world, ný-lína.
}.
