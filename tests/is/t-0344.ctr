# grípa-allt-próf (hagnýtt)
>> HTML := Texti nýtt.
HTML við: ['encode:'] gera: { :tekst
	sjálfur bæta-aftast: (tekst
	skipta: ['&'] fyrir: ['&amp;'], 
	skipta: ['<'] fyrir: ['&lt;'],
	skipta: ['>'] fyrir: ['&gt;'],
	skipta: ['"'] fyrir: ['&quot;']).
}.
>> blogg := HTML nýtt.
blogg bæta-aftast: ['<h1>'],
     encode: ['Koffie & Thee'],
     bæta-aftast: ['</h1>'].
Úttak skrifa: blogg, ný-lína.


>> Rómversk := Tala nýtt.
Rómversk við: ['textalegur'] gera: {
	>> a := [''].
	{ a bæta-aftast: ['I']. } × sjálfur. <- a.
}.

>> x := Rómversk nýtt.
x leggja-við: 3.
Úttak skrifa: x textalegur, ný-lína.

>> Skammti := Rökgildi nýtt.
Skammti við: ['true?'] gera: { <- ['kannski Satt']. }.
Úttak skrifa: (Skammti nýtt true?), ný-lína.

>> Nihil := Ekkert nýtt.
Nihil við: ['texti'] gera: { <- ['Nihil']. }.
Úttak skrifa: (Nihil nýtt), ný-lína.
