# catch-all test (practical)
>> HTML := Texti nýtt.
HTML við: ['encode:'] gera: { :tekst
	sjálfur bæta-aftast: (tekst
	skipta: ['&'] fyrir: ['&amp;'], 
	skipta: ['<'] fyrir: ['&lt;'],
	skipta: ['>'] fyrir: ['&gt;'],
	skipta: ['"'] fyrir: ['&quot;']).
}.
>> blog := HTML nýtt.
blog bæta-aftast: ['<h1>'],
     encode: ['Koffie & Thee'],
     bæta-aftast: ['</h1>'].
Úttak skrifa: blog, ný-lína.


>> Roman := Tala nýtt.
Roman við: ['stringy'] gera: {
	>> a := [''].
	{ a bæta-aftast: ['I']. } × sjálfur. <- a.
}.

>> x := Roman nýtt.
x leggja-við: 3.
Úttak skrifa: x stringy, ný-lína.

>> Quantum := Rökgildi nýtt.
Quantum við: ['true?'] gera: { <- ['maybe True']. }.
Úttak skrifa: (Quantum nýtt true?), ný-lína.

>> Nihil := Ekkert nýtt.
Nihil við: ['texti'] gera: { <- ['Nihil']. }.
Úttak skrifa: (Nihil nýtt), ný-lína.
