>> smíðaLeggjara := { :x
	>> f := { :y <- (eigin x + y). } setja: ['x'] gildi: x. <- f.
}.
>> varpari := { :fylki :fll
	>> vörpunin := { :i eigin q setja: (eigin f beita: (eigin q ? i)) við: i. } 
	setja: ['q'] gildi: fylki,
	setja: ['f'] gildi: fll.
	{ :i vörpunin beita: i. } × (fylki fjöldi).
}.

>> a := Listi ← 1; 2; 3.
varpari beita: a og: (smíðaLeggjara beita: 100).
Úttak skrifa: (a staða: 0), ný-lína.
Úttak skrifa: (a ? 1), ný-lína.
Úttak skrifa: (a ? 2), ný-lína.
