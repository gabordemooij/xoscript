>> makeAdder := { :x
	>> f := { :y <- (eigin x + y). } setja: ['x'] gildi: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i eigin q setja: (eigin f beita: (eigin q ? i)) við: i. } 
	setja: ['q'] gildi: array,
	setja: ['f'] gildi: func.
	{ :i mapping beita: i. } × (array fjöldi).
}.

>> a := Listi ← 1; 2; 3.
mapper beita: a og: (makeAdder beita: 100).
Úttak skrifa: (a staða: 0), ný-lína.
Úttak skrifa: (a ? 1), ný-lína.
Úttak skrifa: (a ? 2), ný-lína.
