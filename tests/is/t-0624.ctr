# Þetta próf athugar hvort string_fill_in tapi ekki hólfinu sínu (gc'ed) í ham 4
# tilvísun í world.c
>> Annáll := Hlutur nýtt.

Annáll við: ['say:'] gera: { :str
	Úttak skrifa: str, ný-lína.
}.

>> Liður := Hlutur nýtt.

Liður við: ['nýtt:'] gera: { :id
	<- sjálfur nýtt id: id.
}.

Liður við: ['id:'] gera: { :id
	eigin id := id.
}.

Liður við: ['id'] gera: { <- eigin id. }.


Liður við: ['texti'] gera: {
	>> str := ['Item#~no'].
	str ~no: eigin id.
	<- str.
}.


>> Print := Hlutur nýtt.

Print við: ['items'] gera: { 
	
	eigin liður := Liður nýtt: 1.
	
	# annaðhvort segfault eða rangur str hér
	Annáll say: (
		['~item printed.'] ~item: eigin liður
	).
	
	
}.

Print items.