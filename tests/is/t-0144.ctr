



>> CoffeeGrounds := Hlutur nýtt.
CoffeeGrounds við: ['extract'] gera: { <- ['coffee']. }.

>> CoffeeMachine := Hlutur nýtt.
CoffeeMachine við: ['init'] gera: {
	eigin coffeegrounds := CoffeeGrounds nýtt.
}.
CoffeeMachine við: ['nýtt'] gera: { <- CoffeeMachine `new init.
}.

CoffeeMachine við: ['makeTea'] gera: { <- (eigin tealeaves extract). }.
CoffeeMachine við: ['makeCoffee'] gera: { <- (eigin coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine nýtt.

Úttak skrifa:
	coffeeDream 
	makeCoffee.

Úttak skrifa:
	coffeeDream 
	makeTea.
