>> Heilsari := Hlutur nýtt.
Heilsari við: ['smíða'] gera: {
	>> heilsari := Hlutur nýtt.
	heilsari við: ['name:'] gera: { :nafn
		Úttak skrifa: ['set nafn'].
		eigin nafnMitt := nafn.
	}.
	heilsari við: ['framkvæmaKveðju'] gera: {
		Úttak skrifa: ['Hello'].
		Úttak skrifa: eigin nafnMitt.
	}.
	heilsari við: ['heilsa'] gera: {
		sjálfur framkvæmaKveðju.
	}. <- heilsari.
}.
>> heilsari := Heilsari smíða.
heilsari name: ['sólskin!'].
heilsari heilsa.
