>> Greeter := Hlutur nýtt.
Greeter við: ['make'] gera: {
	>> greeter := Hlutur nýtt.
	greeter við: ['name:'] gera: { :nafn
		Úttak skrifa: ['setting a name'].
		eigin myName := nafn.
	}.
	greeter við: ['performGreeting'] gera: {
		Úttak skrifa: ['Hello'].
		Úttak skrifa: eigin myName.
	}.
	greeter við: ['greet'] gera: {
		sjálfur performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
