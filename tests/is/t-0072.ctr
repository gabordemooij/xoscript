>> echo := Hlutur nýtt.
echo við: ['svara:'] gera: { :sound
	{ Úttak skrifa: sound. } × 2.
}.
echo ho!. 


echo := Hlutur nýtt.
echo við: ['svara:og:'] gera: { :sound :x
	{ Úttak skrifa: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := Hlutur nýtt.
echo við: ['svara:og:og:'] gera: { :operation :sound :x
	{ Úttak skrifa: sound. } × x.
}.
echo shout: ['la'] times: 4. 


