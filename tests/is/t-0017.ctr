Tala við: ['factorial'] gera: {
	>> total := 1.
	{ :index total margfalda-með: (sjálfur - (index)). } × sjálfur. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Úttak skrifa: a.
>> b := 2 + 3 factorial.
Úttak skrifa: b.
>> c := 3 factorial + 2.
Úttak skrifa: c.
>> d := 2 + (3 factorial).
Úttak skrifa: d.
Úttak skrifa: 2 + 3 factorial + 1.
