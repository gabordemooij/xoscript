Tala við: ['aðfeldi'] gera: {
	>> samtals := 1.
	{ :vísir samtals margfalda-með: (sjálfur - (vísir)). } × sjálfur. <- samtals.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Úttak skrifa: a.
>> b := 2 + 3 aðfeldi.
Úttak skrifa: b.
>> c := 3 aðfeldi + 2.
Úttak skrifa: c.
>> d := 2 + (3 aðfeldi).
Úttak skrifa: d.
Úttak skrifa: 2 + 3 aðfeldi + 1.
