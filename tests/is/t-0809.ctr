# backslashes must survive code serialization, strings must not end early
>> gildi := Listi nýtt
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

gildi hver: { :i :value
	>> d := Orðabók nýtt.
	d setja: value við: ['k'].
	>> r := d kóði hlutur.
	Úttak skrifa: r fjöldi, ný-lína.
	Úttak skrifa: ( (r við: ['k']) = value ), ný-lína.
}.
