# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> slóð := ['/tmp/dat.csv'].
>> csv := Skrá nýtt: slóð.
csv skrifa: s.

# accepts CRLF LF CR, varying row length
csv afmarkari: [';'] gæsalöpp: ['"'] línur: { :line
	Forrit taka-til.
	Úttak skrifa: line, ný-lína.
	Forrit taka-til.
}.

# unequal lines
s bæta-aftast: ['\njustone'].
csv skrifa: s.
{
	csv afmarkari: [';'] gæsalöpp: ['"'] línur: { :line
		Úttak skrifa: line, ný-lína.
	}.
} grípa: { :e 
	Úttak skrifa: e, ný-lína.
}, ræsa.

# invalid format
s := ['"he"llo";world'].
csv skrifa: s.
{
	csv afmarkari: [';'] gæsalöpp: ['"'] línur: { :line
		Úttak skrifa: line, ný-lína.
	}.
} grípa: { :e 
	Úttak skrifa: e, ný-lína.
}, ræsa.
