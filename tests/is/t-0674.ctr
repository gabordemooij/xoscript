# eðlilegt flæði
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> slóð := ['/tmp/dat.csv'].
>> csv := Skrá nýtt: slóð.
csv skrifa: s.

# tekur við CRLF LF CR, mislöngum röðum
csv afmarkari: [';'] gæsalöpp: ['"'] línur: { :line
	Forrit taka-til.
	Úttak skrifa: line, ný-lína.
	Forrit taka-til.
}.

# ójafnar línur
s bæta-aftast: ['\njustone'].
csv skrifa: s.
{
	csv afmarkari: [';'] gæsalöpp: ['"'] línur: { :line
		Úttak skrifa: line, ný-lína.
	}.
} grípa: { :e 
	Úttak skrifa: e, ný-lína.
}, ræsa.

# ógilt snið
s := ['"he"llo";world'].
csv skrifa: s.
{
	csv afmarkari: [';'] gæsalöpp: ['"'] línur: { :line
		Úttak skrifa: line, ný-lína.
	}.
} grípa: { :e 
	Úttak skrifa: e, ný-lína.
}, ræsa.
