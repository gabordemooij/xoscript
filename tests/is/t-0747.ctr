Úttak skrifa: ['Test object'], ný-lína.
>> a := Hlutur nýtt. 

a við: ['item:'] gera: { :num
	eigin num := num. 
}.

a við: ['item'] gera: { <- eigin num.
}.

a item: 123.

Úttak skrifa: a item, ný-lína.

>> old-num-address := a item frumgerð minnisvistfang.
a save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== RELOADING SNAP:'], ný-lína.

>> b := Hlutur load-from: ['/tmp/a.bin'].

(b item frumgerð minnisvistfang = old-num-address) satt: {
	Úttak skrifa: ['Object link re-attached.'], ný-lína.
}.

Úttak skrifa: b item, ný-lína.
