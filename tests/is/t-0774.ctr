Úttak skrifa: ['Test object'], ný-lína.
>> a := Hlutur nýtt. 
a við: ['item:'] gera: { :lst
	eigin lst := lst. 
}.
a við: ['item'] gera: { <- eigin lst.
}.
a item: (
	Listi nýtt ; 1 ; (
		Listi nýtt ; ['a'] ; (
			Listi nýtt ; ( Stund nýtt: 1 )
		) ; ( Int64 úr-texta: ['321'] )
	)
).
Úttak skrifa: a item, ný-lína.
>> old-lst-address := a item frumgerð minnisvistfang.
a save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== RELOADING SNAP:'], ný-lína.
>> b := Hlutur load-from: ['/tmp/a.bin'].
(b item frumgerð minnisvistfang = old-lst-address) satt: {
	Úttak skrifa: ['Object link re-attached.'], ný-lína.
}.
Úttak skrifa: ( b item ), ný-lína.
