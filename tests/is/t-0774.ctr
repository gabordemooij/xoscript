Úttak skrifa: ['Prófunarhlutur'], ný-lína.
>> a := Hlutur nýtt. 
a við: ['item:'] gera: { :lst
	eigin lst := lst. 
}.
a við: ['liður'] gera: {
	<- eigin lst.
}.
a item: (
	Listi nýtt ; 1 ; (
		Listi nýtt ; ['a'] ; (
			Listi nýtt ; ( Stund nýtt: 1 )
		) ; ( Int64 úr-texta: ['321'] )
	)
).
Úttak skrifa: a liður, ný-lína.
>> gamalt-lst-vistfang := a liður frumgerð minnisvistfang.
a save-as: ['/tmp/a.bin'].
Úttak skrifa: ['========== ENDURHLEÐ SNAP:'], ný-lína.
>> b := Hlutur load-from: ['/tmp/a.bin'].
(b liður frumgerð minnisvistfang = gamalt-lst-vistfang) satt: {
	Úttak skrifa: ['Hlutartengill tengdur aftur.'], ný-lína.
}.
Úttak skrifa: ( b liður ), ný-lína.
