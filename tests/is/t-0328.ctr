Forrit minnisstjórnun: 4.

>> Tvöfaldari := Hlutur nýtt.
>> Margfaldari := Hlutur nýtt.
Tvöfaldari við: ['tvöfalda:og:'] gera: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Margfaldari við: ['margfalda:og:'] gera: { :x :y <- (x × y).
}.

Úttak skrifa: (
	Tvöfaldari tvöfalda:
		(Tvöfaldari tvöfalda: 
			(Margfaldari margfalda: 2 og: 3)
		og:
			(Margfaldari margfalda: 3 og: 4)
		)
	og:
		(Tvöfaldari tvöfalda: 
			(Margfaldari margfalda: 2 og: 3)
		og:
			(Margfaldari margfalda: 3 og: 4)
		)
), ný-lína.
