Forrit minnisstjórnun: 4.

>> Doubler := Hlutur nýtt.
>> Multiplier := Hlutur nýtt.
Doubler við: ['double:and:'] gera: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier við: ['multiply:and:'] gera: { :x :y <- (x × y).
}.

Úttak skrifa: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), ný-lína.
