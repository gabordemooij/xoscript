


>> wine := Hlutur nýtt.


wine við: ['toString'] gera: { <- ['merlot'].
}.

wine við: ['naarTekst'] gera: { <- ['merlot'].
}.


wine við: ['='] gera: { :other wine <- ( sjálfur toString = other wine ).
}.

wine við: ['=='] gera: { :other wine <- ( sjálfur toString = other wine ).
}.



wine
	tilvik: ['cabernet'] gera: { Úttak skrifa: ['it's a Cabernet!']. },
	tilvik: ['syrah']    gera: { Úttak skrifa: ['it's a Syrah!'].    },
	tilvik: ['merlot']   gera: { Úttak skrifa: ['it's a Merlot!'].   },
	tilvik: ['malbec']   gera: { Úttak skrifa: ['it's a Malbec!'].   }.

Úttak ný-lína.
