


>> vín := Hlutur nýtt.


vín við: ['íTexta'] gera: { <- ['merlot'].
}.

vín við: ['naarTekst'] gera: { <- ['merlot'].
}.


vín við: ['='] gera: { :other wine <- ( sjálfur íTexta = other wine ).
}.

vín við: ['=='] gera: { :other wine <- ( sjálfur íTexta = other wine ).
}.



vín
	tilvik: ['cabernet'] gera: { Úttak skrifa: ['þetta er Cabernet!']. },
	tilvik: ['syrah']    gera: { Úttak skrifa: ['þetta er Syrah!'].    },
	tilvik: ['merlot']   gera: { Úttak skrifa: ['þetta er Merlot!'].   },
	tilvik: ['malbec']   gera: { Úttak skrifa: ['þetta er Malbec!'].   }.

Úttak ný-lína.
