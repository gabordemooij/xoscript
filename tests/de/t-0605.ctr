>> rechnung := Objekt neu.
rechnung wenn: ['starten'] tun: {
        eigen zahl := 0.
}.

rechnung wenn: ['zahl'] tun: {
        eigen zahl hinzufügen: 1.
        <- eigen zahl kopieren.
}.

>> jahres-rechnung := rechnung neu.
jahres-rechnung wenn: ['start:'] tun: { :jahr
	eigen zahl := jahr.
}.

jahres-rechnung start: 202000.
Ausgabe schreiben: jahres-rechnung zahl, stopp.
Ausgabe schreiben: jahres-rechnung zahl, stopp.
