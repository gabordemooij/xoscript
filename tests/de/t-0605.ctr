>> invoice := Objekt neu.
invoice wenn: ['starten'] tun: {
        eigen zahl := 0.
}.

invoice wenn: ['zahl'] tun: {
        eigen zahl hinzufügen: 1. <- eigen zahl kopieren.
}.

>> year-invoice := invoice neu.
year-invoice wenn: ['start:'] tun: { :jahr
	eigen zahl := jahr.
}.

year-invoice start: 202000.
Ausgabe schreiben: year-invoice zahl, stopp.
Ausgabe schreiben: year-invoice zahl, stopp.
