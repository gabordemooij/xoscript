>> q := Liste ← 1 ; 2 ; 3.
{ q ? ['1']. } abfangen: { Ausgabe schreiben: ['erwischt!'], stopp. }, starten.
{ q ? Ja. } abfangen: { Ausgabe schreiben: ['erwischt!'], stopp. }, starten.
{ q ? Nein. } abfangen: { Ausgabe schreiben: ['erwischt!'], stopp. }, starten.
{ q ? Nichts. } abfangen: { Ausgabe schreiben: ['erwischt!'], stopp. }, starten.
{ q ? (Liste neu). } abfangen: { Ausgabe schreiben: ['erwischt!'], stopp. }, starten.
{ q ? (Objekt neu). } abfangen: { Ausgabe schreiben: ['erwischt!'], stopp. }, starten.
{ q ? ({ ['Leer']. }). } abfangen: { Ausgabe schreiben: ['erwischt!'], stopp. }, starten.
Ausgabe schreiben: ['alle erwischt'], stopp.
