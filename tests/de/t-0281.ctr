>> q := Liste ← 1 ; 2 ; 3.
{ q ? ['1']. } abfangen: { Ausgabe schreiben: ['caught!'], stopp. }, starten.
{ q ? Ja. } abfangen: { Ausgabe schreiben: ['caught!'], stopp. }, starten.
{ q ? Nein. } abfangen: { Ausgabe schreiben: ['caught!'], stopp. }, starten.
{ q ? Nichts. } abfangen: { Ausgabe schreiben: ['caught!'], stopp. }, starten.
{ q ? (Liste neu). } abfangen: { Ausgabe schreiben: ['caught!'], stopp. }, starten.
{ q ? (Objekt neu). } abfangen: { Ausgabe schreiben: ['caught!'], stopp. }, starten.
{ q ? ({ ['Empty']. }). } abfangen: { Ausgabe schreiben: ['caught!'], stopp. }, starten.
Ausgabe schreiben: ['caught them all'], stopp.
