Server init.
>> fmt := Format neu: ['%#3x'].

>> blob := Blob neu: 4.
blob bytes: ( 
	Liste neu ; 0 ; 1 ; 2 ; 3
).

>> file := Datei neu: ['/tmp/blob'].
file blob: blob.
blob freigeben.

>> lesen := file blob.
lesen 
von: 0 
länge: 4, 
tun jedes: { :i :b 
	Ausgabe
	schreiben: (fmt anwenden-int: b),
	stopp.
}.
lesen freigeben.
