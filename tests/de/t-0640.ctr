
Server init.
Ausgabe schreiben: ['Datenbanktest'], stopp.

>> db := Maria-DB neu host: ['localhost'],
	benutzername: ['xo'], 
	passwort: ['pass123'],
	datenbankname: ['xobase'],
	verbinden.

>> suchparameter :=
db abfrage: ['SELECT UNHEX('CAFE') AS blobby'],
abrufen: { :reihe
	Ausgabe schreiben: ( reihe blobby von: 0 länge: 2 ), stopp.
	reihe blobby freigeben.
}.
