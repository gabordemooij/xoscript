
Server init.
Ausgabe schreiben: ['Database test'], stopp.

>> db := Maria-DB neu host: ['localhost'],
	benutzername: ['xo'], 
	passwort: ['pass123'],
	datenbankname: ['xobase'],
	verbinden.

>> suchparameter :=
db abfrage: ['SELECT UNHEX('CAFE') AS blobby'],
abrufen: { :row
	Ausgabe schreiben: ( row blobby von: 0 länge: 2 ), stopp.
	row blobby freigeben.
}.
