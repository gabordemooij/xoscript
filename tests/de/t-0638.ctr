
Server init.
>> anf := HTTP-Anfrage neu.
Ausgabe schreiben: ['HTTP-GET d[]=']  + ( anf get-liste: ['d[]'] ), stopp. # GET
Ausgabe schreiben: ['HTTP-GET f[]=']  + ( anf get-liste: ['f[]'] ), stopp. # GET
Ausgabe schreiben: ['HTTP-POST e[]='] + ( anf post-liste: ['e[]'] ), stopp. # GET
Ausgabe schreiben: ['HTTP-POST c=']   + ( anf post: ['c'] ), stopp. # GET
Ausgabe schreiben: ['HTTP-POST xx=']  + ( anf post: ['xx'] ), stopp. # GET
