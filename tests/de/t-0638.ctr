
Server init.
>> rq := HTTP-Anfrage neu.
Ausgabe schreiben: ['HTTP-GET d[]=']  + ( rq get-liste: ['d[]'] ), stopp. # GET
Ausgabe schreiben: ['HTTP-GET f[]=']  + ( rq get-liste: ['f[]'] ), stopp. # GET
Ausgabe schreiben: ['HTTP-POST e[]='] + ( rq post-liste: ['e[]'] ), stopp. # GET
Ausgabe schreiben: ['HTTP-POST c=']   + ( rq post: ['c'] ), stopp. # GET
Ausgabe schreiben: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), stopp. # GET
