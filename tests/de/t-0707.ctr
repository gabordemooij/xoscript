# Typumwandlungen / Konvertierungen / Bindungen testen
Programm speicherverwaltung: 4.
Server init.

>> zähler := 0.
>> db := Maria-DB neu host: ['localhost'],
	benutzername: ['xo'], passwort: ['pass123'], datenbankname: ['xobase'], verbinden.

>> ZweiZiffernFormat := Format neu: ['%02d'].

# Datum und Zeit
{
	>> jahr     := Zahl zwischen: 1995 und: 2050, text.
	>> monat    := ZweiZiffernFormat anwenden-int: (Zahl zwischen: 1 und: 12), text.
	>> tag      := ZweiZiffernFormat anwenden-int: (Zahl zwischen: 1 und: 28), text.
	>> stunde     := ZweiZiffernFormat anwenden-int: (Zahl zwischen: 1 und: 23), text.
	>> minute   := ZweiZiffernFormat anwenden-int: (Zahl zwischen: 1 und: 59), text.
	>> sekunde   := ZweiZiffernFormat anwenden-int: (Zahl zwischen: 1 und: 59), text.
	>> datumzeit := ['YYYY-MM-DD HH:II:SS'].	
	datumzeit
		YYYY: jahr,
		MM: monat,
		DD: tag,
		HH: stunde,
		II: minute,
		SS: sekunde.
	>> suchparameter :=
	db abfrage: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: datumzeit),
	abrufen: { :reihe
		(reihe mydatetime = datumzeit) nein: {
			diese-aufgabe fehler: (
				['Erwartet: <expected>, aber erhalten: <observation>']
				<expected>: datumzeit,
				<observation>: reihe mydatetime
			).
		}.
	
	}.
	zähler hinzufügen: 1.
} * 100.

# Datum
{
	>> jahr     := Zahl zwischen: 1995 und: 2050, text.
	>> monat    := ZweiZiffernFormat anwenden-int: (Zahl zwischen: 1 und: 12), text.
	>> tag      := ZweiZiffernFormat anwenden-int: (Zahl zwischen: 1 und: 28), text.
	>> datum     := ['YYYY-MM-DD'].
	datum
		YYYY: jahr,
		MM: monat,
		DD: tag.
	>> suchparameter :=
	db abfrage: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: datum),
	abrufen: { :reihe
		(reihe mydate = datum) nein: {
			diese-aufgabe fehler: (
				['Erwartet: <expected>, aber erhalten: <observation>']
				<expected>: datum,
				<observation>: reihe mydate
			).
		}.
	}.
	zähler hinzufügen: 1.
} * 100.


# Zeit
{
	>> stunde     := ZweiZiffernFormat anwenden-int: (Zahl zwischen: 1 und: 23), text.
	>> minute   := ZweiZiffernFormat anwenden-int: (Zahl zwischen: 1 und: 59), text.
	>> sekunde   := ZweiZiffernFormat anwenden-int: (Zahl zwischen: 1 und: 59), text.
	>> zeit := ['HH:II:SS'].
	zeit
		HH: stunde,
		II: minute,
		SS: sekunde.
	>> suchparameter :=
	db abfrage: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: zeit),
	abrufen: { :reihe
		(reihe mytime = zeit) nein: {
			diese-aufgabe fehler: (
				['Erwartet: <expected>, aber erhalten: <observation>']
				<expected>: datumzeit,
				<observation>: reihe mytime
			).
		}.
	}.
	zähler hinzufügen: 1.
} * 100.


# Texte (varchar/text)
>> str1 := Liste neu füllen: 100000 mit: ['x'], zusammenfügen: [''].
{
	>> str2 := Tresor token: 40.
	>> suchparameter :=
	db abfrage: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	abrufen: { :reihe
		(reihe str1 = str1 und: reihe str2 = str2) nein: {
			diese-aufgabe fehler: (
				['Erwartet: <expected>, aber erhalten: <observation>']
				<expected>: datumzeit,
				<observation>: reihe mytime
			).
		}.
	}.
	zähler hinzufügen: 1.
} * 100.


# Zahlen
{
	>> n1  := Zahl zwischen: 1 und: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 aus-text: ['9223372036854775807'] ) -
		( Int64 aus-text: ['99999'] ) +
		( Int64 aus-text: n1 text )
	).
	>> suchparameter :=
	db abfrage: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	abrufen: { :reihe
		(reihe n1 = n1) nein: {
			diese-aufgabe fehler: (
				['Erwartet: <expected>, aber erhalten: <observation>']
				<expected>: n1,
				<observation>: reihe n1
			).
		}.
		(reihe n2 = n2) nein: {
			diese-aufgabe fehler: (
				['Erwartet: <expected>, aber erhalten: <observation>']
				<expected>: n1,
				<observation>: reihe n2
			).
		}.
		(reihe n3 = n2 gerundet) nein: {
			diese-aufgabe fehler: (
				['Erwartet: <expected>, aber erhalten: <observation>']
				<expected>: n1,
				<observation>: reihe n3
			).
		}.
		(reihe big = big) nein: {
			diese-aufgabe fehler: (
				['Erwartet: <expected>, aber erhalten: <observation>']
				<expected>: big,
				<observation>: reihe big
			).
		}.
		
	}.
	zähler hinzufügen: 1.
} * 100.


Ausgabe schreiben: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: zähler
), stopp.