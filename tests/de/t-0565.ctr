Server init.

>> message := ['this is a string to be encrypted!'].
>> key := ['secret123!'].
>> vault := Tresor neu: ['myvault'].

>> encrypted := vault verschlüsseln: message schlüssel: key.
>> decrypted := vault entschlüsseln: encrypted schlüssel: key.

Ausgabe 
schreiben: ['Message:'], stopp
schreiben: message, stopp
schreiben: ['Decrypted:'], stopp
schreiben: decrypted, stopp.
