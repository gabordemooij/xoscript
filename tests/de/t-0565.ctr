Server init.

>> nachricht := ['dies ist ein zu verschlüsselnder Text!'].
>> key := ['geheim123!'].
>> geldschrank := Tresor neu: ['myvault'].

>> verschlüsselt := geldschrank verschlüsseln: nachricht schlüssel: key.
>> entschlüsselt := geldschrank entschlüsseln: verschlüsselt schlüssel: key.

Ausgabe 
schreiben: ['Message:'], stopp
schreiben: nachricht, stopp
schreiben: ['Decrypted:'], stopp
schreiben: entschlüsselt, stopp.
