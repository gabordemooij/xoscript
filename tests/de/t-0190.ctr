#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm speicherverwaltung: 0.

{
Moment zeit.
Moment warten: 1.
Ausgabe schreiben: Programm argumente, stopp.
Programm argument: 0.
Zahl random.
Ausgabe schreiben: (Programm system: ['echo 'Hello'']).
} starten.

Programm aufräumen.
usedMemory1 := (Programm speicher ? 0).

{
Moment zeit.
Moment warten: 1.
Ausgabe schreiben: Programm argumente, stopp.
Programm argument: 0.
Zahl random.
Ausgabe schreiben: (Programm system: ['echo 'Hello'']).
} starten.

Programm aufräumen.
usedMemory2 := (Programm speicher ? 0).

{
Moment zeit.
Moment warten: 1.
Ausgabe schreiben: Programm argumente, stopp.
Programm argument: 0.
Zahl random.
Ausgabe schreiben: (Programm system: ['echo 'Hello'']).
} starten.

Programm aufräumen.
usedMemory3 := (Programm speicher ? 0).



( usedMemory1 = usedMemory2 und: usedMemory1 = usedMemory3, und: usedMemory2 = usedMemory3 ) ja: {
	Ausgabe schreiben: ['No memory leaks here'].
}, nein: {
	Ausgabe schreiben: ['Leaking memory...'].
}.
