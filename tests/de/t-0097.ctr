
Text wenn: ['html'] tun: { <- (
		selbst
		ersetzen: ['&'] mit: ['&amp;'],
		ersetzen: ['<'] mit: ['&lt;'],
		ersetzen: ['>'] mit: ['&gt;'],
		ersetzen: ['"'] mit: ['&quot;']
	).
}.

>> HtmlPinsel := Objekt neu.

HtmlPinsel wenn: ['antworten:'] tun: { :tagname
	Ausgabe schreiben: (['<tag>↵'] tag: tagname ).
}.

HtmlPinsel wenn: ['antworten:und:'] tun: { :tagname :content
	tagname := ( tagname von: 0 länge: (tagname länge - 1) ).
	Ausgabe schreiben: (['<tag content>↵'] tag: tagname, content: content).
}.

HtmlPinsel wenn: ['content:'] tun: { :textinhalt
	Ausgabe schreiben: textinhalt html, stopp.
}.

HtmlPinsel wenn: ['attr:wert:'] tun: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlPinsel neu.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] wert: ['bold']),
		/span
	/body
/html.
		
