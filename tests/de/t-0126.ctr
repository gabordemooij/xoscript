#Linux
>> Slurp := Objekt neu.

Slurp wenn: ['neu'] tun: {
	eigen str := [''].
}.

Slurp wenn: ['nieuw'] tun: {
	eigen str := [''].
}.

Slurp wenn: ['antworten:'] tun: { :blah
		eigen str anhängen: blah.
}.

Slurp wenn: ['antworten:und:'] tun: { :blah :blahah
		eigen str anhängen: (blah von: 0 länge: (blah länge - 1)).
		eigen str anhängen: [' '].
		eigen str anhängen: blahah.
}.

Slurp wenn: ['beschaffen'] tun: {
	>> puffer := eigen str.
	eigen str := ['']. <- puffer.
}.


Ausgabe schreiben: (Programm system: (Slurp neu echo: ['Hallo, ich kann mit der fluiden API auf die Konsole schreiben!'], beschaffen)).


{ Datei neu: ['/tmp/from.txt'], löschen. } abfangen: { ['Leer']. }, starten.
{ Datei neu: ['/tmp/to.txt'], löschen. } abfangen: { ['Leer']. }, starten.


Datei neu: ['/tmp/to.txt'], existiert nein: {
	Ausgabe schreiben: ['Confirmed. Target file does not exist.\
'].
}.
Datei neu: ['/tmp/from.txt'], existiert nein: {
	Ausgabe schreiben: ['Confirmed. Source file does not exist.\
'].
}.



Programm system: (Slurp neu touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], beschaffen).



Programm system: (Slurp neu cp: ['/tmp/from.txt /tmp/to.txt'], beschaffen).

Datei neu: ['/tmp/to.txt'], existiert ja: {
	Ausgabe schreiben: ['Confirmed. Target file has been created by shell.\
'].
}.


Ausgabe schreiben: ['Inhalt der Datei ist:'] + (Datei neu: ['/tmp/to.txt'], lesen), stopp.
