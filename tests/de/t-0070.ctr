>> numbers := ['1,2,3'] teilen: [','].
Ausgabe schreiben: ['I got: '] + numbers anzahl + [' numbers.'],stopp.
{ :i Ausgabe schreiben: ['number #'] + i + [':'] + (numbers position: i), stopp.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages teilen: [' Or '].
Ausgabe schreiben: ['We serve'], stopp.
{ :i Ausgabe schreiben: ['->'] + (beverages position: i), stopp. } × (beverages anzahl).
Ausgabe schreiben: (beverages zusammenfügen: [',']), stopp.
Ausgabe schreiben: (numbers zusammenfügen: ['||']).
