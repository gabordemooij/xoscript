>> zahlen := ['1,2,3'] teilen: [','].
Ausgabe schreiben: ['Ich habe: '] + zahlen anzahl + [' Zahlen.'],stopp.
{ :i Ausgabe schreiben: ['number #'] + i + [':'] + (zahlen position: i), stopp.} × 3.
>> getränke := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
getränke := getränke teilen: [' Or '].
Ausgabe schreiben: ['Wir servieren'], stopp.
{ :i Ausgabe schreiben: ['->'] + (getränke position: i), stopp. } × (getränke anzahl).
Ausgabe schreiben: (getränke zusammenfügen: [',']), stopp.
Ausgabe schreiben: (zahlen zusammenfügen: ['||']).
