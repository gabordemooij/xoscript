
Ausgabe schreiben: ['For-Schleife abbrechen, 0-4.'], stopp.
{ :i
	Ausgabe schreiben: ['iteration #'] + i, stopp.
	(i = 4) abbrechen.
} × 10.

>> x := 0.
>> xIstKleinerAls10 := { <- ( x < 10 ). }.

Ausgabe schreiben: ['While-True-Schleife abbrechen, 0-4.'], stopp.
{
	Ausgabe schreiben: ['iteration #'] + x, stopp.
	x hinzufügen: 1.
	((x < 5) nicht) abbrechen.
} solange: xIstKleinerAls10.

Ausgabe schreiben: ['While-False-Schleife abbrechen, 5,4.'], stopp.
{
	Ausgabe schreiben: ['iteration #'] + x, stopp.
	x subtrahieren: 1.
	(x = 3) abbrechen.
} solange: { <- (x > 0). }.

Ausgabe schreiben: ['Mal-Schleife abbrechen, 1-4.'], stopp.
{ :i
	Ausgabe schreiben: ['iteration #'] + i, stopp.
	(i = 4) abbrechen.
} × 5.

Ausgabe schreiben: ['Block abbrechen, Zeile nicht ausgeben.'], stopp.
{ Ja abbrechen. Ausgabe schreiben: ['das nicht schreiben!'], stopp. } starten.

Ausgabe schreiben: ['Block abbrechen, catch nicht auslösen...'], stopp.
{ Ja abbrechen. Ausgabe schreiben: ['das nicht schreiben!'], stopp. } abfangen: { Ausgabe schreiben: ['Das nicht fangen!']. }, starten.

Ausgabe schreiben: ['Test Liste jedes-Schleife: 0,1'], stopp.
(Liste ← 1 ; 2 ; 3) abbilden: { :i
	Ausgabe schreiben: ['iteration #'] + i, stopp.
	(i = 1) abbrechen.
}.

Ausgabe schreiben: ['Test Tabelle jedes-Schleife: nur c'], stopp.
>> m := Wörterbuch neu.
m setzen: ['first'] auf: ['a'], setzen: ['second'] auf: ['b'], setzen: ['dritter'] auf: ['c'].
m jedes: { :k :v
	Ausgabe schreiben: ['iteration'] + v + k, stopp.
	Ja abbrechen.
}.

