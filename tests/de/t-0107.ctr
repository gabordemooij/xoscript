
Ausgabe schreiben: ['Break for-loop, 0-4.'], stopp.
{ :i
	Ausgabe schreiben: ['iteration #'] + i, stopp.
	(i = 4) abbrechen.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Ausgabe schreiben: ['Break while-true loop, 0-4.'], stopp.
{
	Ausgabe schreiben: ['iteration #'] + x, stopp.
	x hinzufügen: 1.
	((x < 5) nicht) abbrechen.
} solange: xIsLessThan10.

Ausgabe schreiben: ['Break while-false loop, 5,4.'], stopp.
{
	Ausgabe schreiben: ['iteration #'] + x, stopp.
	x subtrahieren: 1.
	(x = 3) abbrechen.
} solange: { <- (x > 0). }.

Ausgabe schreiben: ['Break times loop, 1-4.'], stopp.
{ :i
	Ausgabe schreiben: ['iteration #'] + i, stopp.
	(i = 4) abbrechen.
} × 5.

Ausgabe schreiben: ['Break block, dont print line.'], stopp.
{ Ja abbrechen. Ausgabe schreiben: ['dont write this!'], stopp. } starten.

Ausgabe schreiben: ['Break block, dont fire catch...'], stopp.
{ Ja abbrechen. Ausgabe schreiben: ['dont write this!'], stopp. } abfangen: { Ausgabe schreiben: ['Dont catch this!']. }, starten.

Ausgabe schreiben: ['Test Array each-loop: 0,1'], stopp.
(Liste ← 1 ; 2 ; 3) abbilden: { :i
	Ausgabe schreiben: ['iteration #'] + i, stopp.
	(i = 1) abbrechen.
}.

Ausgabe schreiben: ['Test Map each-loop: c only'], stopp.
>> m := Wörterbuch neu.
m setzen: ['first'] auf: ['a'], setzen: ['second'] auf: ['b'], setzen: ['third'] auf: ['c'].
m jedes: { :k :v
	Ausgabe schreiben: ['iteration'] + v + k, stopp.
	Ja abbrechen.
}.

