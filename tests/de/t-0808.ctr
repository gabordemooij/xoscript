# Tresor-Schlüssel und Signaturen, die zu lang dekodieren, dürfen den Stack nicht überlaufen lassen
Server init.

>> schlüsselpaar := Tresor schlüssel-erzeugen.
>> sk := schlüsselpaar erstes.
>> pk := schlüsselpaar letztes.
>> sig := Tresor signieren: ['abc'] mit: sk.

# 88 Zeichen ohne Padding dekodieren zu 66 Bytes
>> lang := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 Zeichen ohne Padding dekodieren zu 33 Bytes
>> kurz := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Tresor signieren: ['abc'] mit: lang. } abfangen: { :e
	Ausgabe schreiben: e, stopp.
}, starten.

{ Tresor prüfen: ['abc'] signatur: lang mit: pk. } abfangen: { :e
	Ausgabe schreiben: e, stopp.
}, starten.

{ Tresor prüfen: ['abc'] signatur: sig mit: kurz. } abfangen: { :e
	Ausgabe schreiben: e, stopp.
}, starten.
