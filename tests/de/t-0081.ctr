>> tabelle1 := Wörterbuch neu.
>> schlüssel1 := Liste neu.
>> schlüssel2 := Liste neu.

tabelle1
	setzen: ['hello'] auf: schlüssel1,
	setzen: ['world'] auf: schlüssel2.


Ausgabe
	schreiben: ['Map #1 contains: '] + (tabelle1 bei: schlüssel1),
	schreiben: [' und '] + (tabelle1 bei: schlüssel2), stopp.

>> SchlüsselbareListe := Liste neu.
SchlüsselbareListe wenn: ['alsText'] tun: { <- (selbst anzahl) alsText.
}.

>> map2 := Wörterbuch neu.
schlüssel1 := SchlüsselbareListe neu.
schlüssel2 := SchlüsselbareListe neu.

schlüssel1 anhängen: 1.

map2
	setzen: ['hello'] auf: schlüssel1,
	setzen: ['world'] auf: schlüssel2.

Ausgabe
	schreiben: ['Map #2 contains: '] + (map2 bei: schlüssel1),
	schreiben: [' und '] + (map2 bei: schlüssel2), stopp.
