>> map1 := Wörterbuch neu.
>> key1 := Liste neu.
>> key2 := Liste neu.

map1
	setzen: ['hello'] auf: key1,
	setzen: ['world'] auf: key2.


Ausgabe
	schreiben: ['Map #1 contains: '] + (map1 bei: key1),
	schreiben: [' and '] + (map1 bei: key2), stopp.

>> KeyeableArray := Liste neu.
KeyeableArray wenn: ['toString'] tun: { <- (selbst anzahl) toString.
}.

>> map2 := Wörterbuch neu.
key1 := KeyeableArray neu.
key2 := KeyeableArray neu.

key1 anhängen: 1.

map2
	setzen: ['hello'] auf: key1,
	setzen: ['world'] auf: key2.

Ausgabe
	schreiben: ['Map #2 contains: '] + (map2 bei: key1),
	schreiben: [' and '] + (map2 bei: key2), stopp.
