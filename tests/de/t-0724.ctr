Ausgabe schreiben: ['Testobjekt'], stopp.
>> a := Objekt neu. 

a wenn: ['item:'] tun: { :file
	eigen file := file. 
}.

a wenn: ['posten'] tun: {
	<- eigen file.
}.

>> f := Datei neu: ['/tmp/aaa.txt'].
a item: f.
Ausgabe schreiben: a posten, stopp.
a save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== SNAP NEU LADEN:'], stopp.
>> b := Objekt load-from: ['/tmp/a.bin'].
Ausgabe schreiben: b posten, stopp.
