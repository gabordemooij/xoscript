Server init.
>> f := Format neu: ['%d'].
>> a := Blob neu: 4.
a bytes: ( Liste neu ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob neu: 4.
b bytes: ( Liste neu ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a von: 0 länge: 3, jedes: { :i :byte
	Ausgabe schreiben: ( f anwenden-int: byte ) , stopp.
}.
a ^ b.
a von: 0 länge: 3, jedes: { :i :byte
	Ausgabe schreiben: ( f anwenden-int: byte ) , stopp.
}.
a ^ b.
a von: 0 länge: 3, jedes: { :i :byte
	Ausgabe schreiben: ( f anwenden-int: byte ) , stopp.
}.
a freigeben.
b freigeben.

{ a ^ Objekt. } abfangen: { :e Ausgabe schreiben: e, stopp. }, starten.
