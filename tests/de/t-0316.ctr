>> Grandfather := Objekt neu.
Grandfather wenn: ['greet'] tun: {
	Ausgabe schreiben: ['Ave!'], stopp.
}.
>> Father := Grandfather neu.
Father wenn: ['greet'] tun: {
	Ausgabe schreiben: ['Hello'], stopp.
	selbst greet.
}.
>> Son := Father neu.
Son wenn: ['greet'] tun: {
	Ausgabe schreiben: ['Hi'], stopp.
	selbst greet.
}.

Son greet.

>> Roundabout := Objekt neu.
Roundabout wenn: ['circle:'] tun: { :x
	Ausgabe schreiben: x, stopp.
	(x < 3) ja: { selbst rekursiv circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) ja: { Ausgabe schreiben: x, stopp. x hinzufügen: 1.  increment starten. }. }.
increment starten.