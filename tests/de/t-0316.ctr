>> Großvater := Objekt neu.
Großvater wenn: ['grüßen'] tun: {
	Ausgabe schreiben: ['Ave!'], stopp.
}.
>> Vater := Großvater neu.
Vater wenn: ['grüßen'] tun: {
	Ausgabe schreiben: ['Hello'], stopp.
	selbst grüßen.
}.
>> Sohn := Vater neu.
Sohn wenn: ['grüßen'] tun: {
	Ausgabe schreiben: ['Hallo'], stopp.
	selbst grüßen.
}.

Sohn grüßen.

>> Kreisverkehr := Objekt neu.
Kreisverkehr wenn: ['circle:'] tun: { :x
	Ausgabe schreiben: x, stopp.
	(x < 3) ja: { selbst rekursiv circle: x + 1. }.
}.

Kreisverkehr circle: 1.

>> x := 1.
>> erhöhen := { (x ≤ 3) ja: { Ausgabe schreiben: x, stopp. x hinzufügen: 1.  erhöhen starten. }. }.
erhöhen starten.