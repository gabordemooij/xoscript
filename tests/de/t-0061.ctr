>> a := ['hello'].
>> b := ['hello'].
>> z := a.
>> c := Nichts.
>> q := Objekt neu.
>> p := q.
(a gleich: a) ja: { Ausgabe schreiben: ['Y1']. }.
(a gleich: b) ja: { Ausgabe schreiben: ['Y2']. }.
(a gleich: c) ja: { Ausgabe schreiben: ['Y3']. }.
(a gleich: z) ja: { Ausgabe schreiben: ['Y4']. }.
(z gleich: a) ja: { Ausgabe schreiben: ['Y5']. }.
(q gleich: q) ja: { Ausgabe schreiben: ['Y6']. }.
(p gleich: q) ja: { Ausgabe schreiben: ['Y7']. }.
(p gleich: a) ja: { Ausgabe schreiben: ['Y8']. }.
(p gleich: Nichts) ja: { Ausgabe schreiben: ['Y9']. }.
