# test Program version

# this feature is disabled by default
Ausgabe schreiben: (
	Programm merkmal: 
	['RECURSIVE_STRINTPOL']
), stopp.


# but if we set the time back
>> today := Moment 
zone: ['CEST'],
aus: ['2026-02-15 10:00:00'].
Programm version: today.

# it will be enabled like it used to be (from now on)
Ausgabe schreiben: (
	Programm merkmal: 
	['RECURSIVE_STRINTPOL']
), stopp.