Ausgabe schreiben: ['Test object'], stopp.
>> l := Liste neu ; 1 ; ( Liste neu ; (Moment neu: 1) ; (Int64 aus-text: ['321']) ; (Liste neu ; 3)).
Ausgabe schreiben: l, stopp.
>> old-lst-address := l prototyp speicheradresse.
l save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== RELOADING SNAP:'], stopp.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b prototyp speicheradresse = old-lst-address) ja: {
	Ausgabe schreiben: ['Object link re-attached.'], stopp.
}.
Ausgabe schreiben: b, stopp.
