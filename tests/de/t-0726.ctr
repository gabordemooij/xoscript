# Puffer testen PKI/Signatur 
Server init.

>> lang := ( Liste neu füllen: 1000 mit: ['a'] ) zusammenfügen: [''].

# eine Nachricht signieren
Ausgabe schreiben: ( 
	Tresor signieren: ['abc'] mit: lang
), stopp.

Ausgabe schreiben: ( 
	Tresor
		prüfen: ['abc'] 
		signatur: lang 
		mit: lang
), stopp.

Ausgabe schreiben: (
	Tresor passwort-hash: lang prüfen: lang
), stopp.
