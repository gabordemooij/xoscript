# test buffers PKI/Sign 
Server init.

>> long := ( Liste neu füllen: 1000 mit: ['a'] ) zusammenfügen: [''].

# sign a message
Ausgabe schreiben: ( 
	Tresor signieren: ['abc'] mit: long
), stopp.

Ausgabe schreiben: ( 
	Tresor
		prüfen: ['abc'] 
		signatur: long 
		mit: long
), stopp.

Ausgabe schreiben: (
	Tresor passwort-hash: long prüfen: long
), stopp.
