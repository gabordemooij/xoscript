Text wenn: ['html'] tun: { <- (
		selbst
		ersetzen: ['&'] mit: ['&amp;'],
		ersetzen: ['<'] mit: ['&lt;'],
		ersetzen: ['>'] mit: ['&gt;'],
		ersetzen: ['''] mit: ['&apos;'],
		ersetzen: ['"'] mit: ['&quot;']
	).
}.

>> belegterSpeicher1 := 0.
>> belegterSpeicher2 := 0.
>> belegterSpeicher3 := 0.
>> belegterSpeicher4 := 0.

Programm speicherverwaltung: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Ausgabe schreiben: txt kopieren html, stopp.
Ausgabe schreiben: txt kopieren kleinbuchstaben, stopp.
Ausgabe schreiben: txt kopieren großbuchstaben, stopp.
} starten.

Programm aufräumen.

belegterSpeicher1 := (Programm speicher ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Ausgabe schreiben: txt kopieren html, stopp.
Ausgabe schreiben: txt kopieren kleinbuchstaben, stopp.
Ausgabe schreiben: txt kopieren großbuchstaben, stopp.
} starten.

Programm aufräumen.
belegterSpeicher2 := (Programm speicher ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Ausgabe schreiben: txt kopieren html, stopp.
Ausgabe schreiben: txt kopieren kleinbuchstaben, stopp.
Ausgabe schreiben: txt kopieren großbuchstaben, stopp.
} starten.

Programm aufräumen.
belegterSpeicher3 := (Programm speicher ? 0).



( belegterSpeicher1 = belegterSpeicher2 und: belegterSpeicher1 = belegterSpeicher3, und: belegterSpeicher2 = belegterSpeicher3 ) ja: {
	Ausgabe schreiben: ['Hier keine Speicherlecks'].
}, nein: {
	Ausgabe schreiben: ['Speicherleck...'].
}.
