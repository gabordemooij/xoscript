Text wenn: ['html'] tun: { <- (
		selbst
		ersetzen: ['&'] mit: ['&amp;'],
		ersetzen: ['<'] mit: ['&lt;'],
		ersetzen: ['>'] mit: ['&gt;'],
		ersetzen: ['''] mit: ['&apos;'],
		ersetzen: ['"'] mit: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm speicherverwaltung: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Ausgabe schreiben: txt kopieren html, stopp.
Ausgabe schreiben: txt kopieren kleinbuchstaben, stopp.
Ausgabe schreiben: txt kopieren großbuchstaben, stopp.
} starten.

Programm aufräumen.

usedMemory1 := (Programm speicher ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Ausgabe schreiben: txt kopieren html, stopp.
Ausgabe schreiben: txt kopieren kleinbuchstaben, stopp.
Ausgabe schreiben: txt kopieren großbuchstaben, stopp.
} starten.

Programm aufräumen.
usedMemory2 := (Programm speicher ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Ausgabe schreiben: txt kopieren html, stopp.
Ausgabe schreiben: txt kopieren kleinbuchstaben, stopp.
Ausgabe schreiben: txt kopieren großbuchstaben, stopp.
} starten.

Programm aufräumen.
usedMemory3 := (Programm speicher ? 0).



( usedMemory1 = usedMemory2 und: usedMemory1 = usedMemory3, und: usedMemory2 = usedMemory3 ) ja: {
	Ausgabe schreiben: ['No memory leaks here'].
}, nein: {
	Ausgabe schreiben: ['Leaking memory...'].
}.
