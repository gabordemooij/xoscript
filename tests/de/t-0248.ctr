

Text wenn: ['auswerten'] tun: {
	>> code := Datei neu: ['/tmp/eval.ctr'].
	code schreiben: selbst text + ['.'].
	Programm verwenden: ['/tmp/eval.ctr'].
}.

>> a := (Liste ← (
	(Wörterbuch neu)
		setzen: ['Domain'] auf: ['mywebsite.com'],
		setzen: (Liste ←
			((Wörterbuch neu)
				setzen: ['Startseite'] auf: ['title'],
				setzen: ['<html></html>'] auf: ['body'],
				setzen: ['2017-01-01'] auf: ['erstellt']
			) ;
			((Wörterbuch neu)
				setzen: ['überuns(c)'] auf: ['title'],
				setzen: ['<credits>Author Inc.</credits>'] auf: ['body']
			)
		) auf: ['seiten']
	)
) text.

Ausgabe schreiben: a typ, stopp.
Ausgabe schreiben: a, stopp.

>> b := Nichts.
(['b := '] + a) auswerten.
Ausgabe schreiben: b ? 0 ? ['seiten'] ? 1 ? ['body'], stopp.

>> c := b ? 0.
>> d := c text.
Ausgabe schreiben: d typ, stopp.

>> e := Nichts.
(['e := '] + d) auswerten.
Ausgabe schreiben: e ? ['seiten'] ? 0, stopp.
