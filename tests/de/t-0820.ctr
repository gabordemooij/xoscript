# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Muster neu: pattern.
	p treffer: subject tun: { :m :g
		Ausgabe schreiben: g anzahl, schreiben: [' '], schreiben: (g zusammenfügen: ['|']), stopp. <- m.
	}.
}.
show anwenden: ['(a)|(b)'] und: ['b'].
show anwenden: ['(a)|(b)'] und: ['a'].
show anwenden: ['(x)?y'] und: ['y'].
show anwenden: ['(x)?(y)(z)?'] und: ['xy'].
