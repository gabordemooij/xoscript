# eine Gruppe, die nicht Teil des Treffers ist, darf nicht abstürzen und muss die Gruppennummern behalten
Server init.
>> zeigen := { :suchmuster :subject
	>> p := Muster neu: suchmuster.
	p treffer: subject tun: { :m :g
		Ausgabe schreiben: g anzahl, schreiben: [' '], schreiben: (g zusammenfügen: ['|']), stopp.
		<- m.
	}.
}.
zeigen anwenden: ['(a)|(b)'] und: ['b'].
zeigen anwenden: ['(a)|(b)'] und: ['a'].
zeigen anwenden: ['(x)?y'] und: ['y'].
zeigen anwenden: ['(x)?(y)(z)?'] und: ['xy'].
