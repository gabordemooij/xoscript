


>> wein := Objekt neu.


wein wenn: ['alsText'] tun: { <- ['merlot'].
}.

wein wenn: ['naarTekst'] tun: { <- ['merlot'].
}.


wein wenn: ['='] tun: { :other wine <- ( selbst alsText = other wine ).
}.

wein wenn: ['=='] tun: { :other wine <- ( selbst alsText = other wine ).
}.



wein
	fall: ['cabernet'] tun: { Ausgabe schreiben: ['das ist ein Cabernet!']. },
	fall: ['syrah']    tun: { Ausgabe schreiben: ['das ist ein Syrah!'].    },
	fall: ['merlot']   tun: { Ausgabe schreiben: ['das ist ein Merlot!'].   },
	fall: ['malbec']   tun: { Ausgabe schreiben: ['das ist ein Malbec!'].   }.

Ausgabe stopp.
