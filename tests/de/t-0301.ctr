


>> wine := Objekt neu.


wine wenn: ['toString'] tun: { <- ['merlot'].
}.

wine wenn: ['naarTekst'] tun: { <- ['merlot'].
}.


wine wenn: ['='] tun: { :other wine <- ( selbst toString = other wine ).
}.

wine wenn: ['=='] tun: { :other wine <- ( selbst toString = other wine ).
}.



wine
	fall: ['cabernet'] tun: { Ausgabe schreiben: ['it's a Cabernet!']. },
	fall: ['syrah']    tun: { Ausgabe schreiben: ['it's a Syrah!'].    },
	fall: ['merlot']   tun: { Ausgabe schreiben: ['it's a Merlot!'].   },
	fall: ['malbec']   tun: { Ausgabe schreiben: ['it's a Malbec!'].   }.

Ausgabe stopp.
