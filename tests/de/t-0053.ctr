60 × {
	>> x := (Zahl zufällig % 6) + 1.
	(x ≤ 6) nein: { Ausgabe schreiben: ['FEHLGESCHLAGEN']. }.
	(x ≥0) nein: { Ausgabe schreiben: ['FEHLGESCHLAGEN']. }.
	x := (Zahl zufällig % 3) + 1.
	(x < 3) nein: { Ausgabe schreiben: ['FEHLGESCHLAGEN']. }.
	(x>-1) nein: { Ausgabe schreiben: ['FEHLGESCHLAGEN']. }.
	x := ((Wahrheitswert münzwurf) zahl).
	(x = 0 oder: x = 1) nein: { Ausgabe schreiben: ['FEHLGESCHLAGEN']. }.
	x := ((Ja münzwurf) zahl).
	(x = 0 oder: x = 1) nein: { Ausgabe schreiben: ['FEHLGESCHLAGEN']. }.
	x := (Wahrheitswert münzwurf entweder: ['KOPF'] oder: ['ZAHL']).
	((x = ['KOPF']) oder: (x = ['ZAHL'])) nein: { Ausgabe schreiben: ['FEHLGESCHLAGEN']. }.
}.
