60 × {
	>> x := (Zahl random % 6) + 1.
	(x ≤ 6) nein: { Ausgabe schreiben: ['FAIL']. }.
	(x ≥0) nein: { Ausgabe schreiben: ['FAIL']. }.
	x := (Zahl random % 3) + 1.
	(x < 3) nein: { Ausgabe schreiben: ['FAIL']. }.
	(x>-1) nein: { Ausgabe schreiben: ['FAIL']. }.
	x := ((Wahrheitswert flip) zahl).
	(x = 0 oder: x = 1) nein: { Ausgabe schreiben: ['FAIL']. }.
	x := ((Ja flip) zahl).
	(x = 0 oder: x = 1) nein: { Ausgabe schreiben: ['FAIL']. }.
	x := (Wahrheitswert flip entweder: ['HEAD'] oder: ['TAIL']).
	((x = ['HEAD']) oder: (x = ['TAIL'])) nein: { Ausgabe schreiben: ['FAIL']. }.
}.
Ausgabe schreiben: ['DONE'].

