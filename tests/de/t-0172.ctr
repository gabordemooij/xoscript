

>> belegterSpeicher1 := 0.
>> belegterSpeicher2 := 0.
>> belegterSpeicher3 := 0.
>> belegterSpeicher4 := 0.

Programm speicherverwaltung: 0.

>> a := Liste ← ['hello'] ; ['world'] ; Ja ; Nichts ; 666.
>> b := a von: 2 länge: 2.
Ausgabe schreiben: ( b zusammenfügen: ['|'] ), schreiben: b anzahl.

Programm aufräumen.
belegterSpeicher1 := (Programm speicher ? 0).


a := Liste ← ['hello'] ; ['world'] ; Ja ; Nichts ; 666.
b := a von: 2 länge: 2.
Ausgabe schreiben: ( b zusammenfügen: ['|'] ), schreiben: b anzahl.


Programm aufräumen.
belegterSpeicher2 := (Programm speicher ? 0).


a := Liste ← ['hello'] ; ['world'] ; Ja ; Nichts ; 666.
b := a von: 2 länge: 2.
Ausgabe schreiben: ( b zusammenfügen: ['|'] ), schreiben: b anzahl.


Programm aufräumen.
belegterSpeicher3 := (Programm speicher ? 0).



( belegterSpeicher1 = belegterSpeicher2 und: belegterSpeicher1 = belegterSpeicher3, und: belegterSpeicher2 = belegterSpeicher3 ) ja: {
	Ausgabe schreiben: ['Hier keine Speicherlecks'].
