# Datenbanktest
# siehe Beispiel server.xo für die nötige Konfiguration

Server init.
Ausgabe schreiben: ['Datenbanktest'], stopp.

>> db := Maria-DB neu host: ['localhost'],
	benutzername: ['xo'], passwort: ['pass123'], datenbankname: ['xobase'], verbinden.

Ausgabe schreiben: ['Können wir verbinden? '] + db verbunden?, stopp.

>> suchparameter := db abfrage: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parameter: ( Liste neu ; ['abc'] ; 12.35 ; 6 ). # parametrisierte Abfragen

{  suchparameter ausführen. db bestätigen. } abfangen: { :e db zurückrollen.  }, starten.

Ausgabe schreiben: ['Können wir einfügen? '] + ( suchparameter insert-id > 0 ), stopp.

>> x := 0.
>> suchparameter :=
db abfrage: ['SELECT * FROM book order by id desc limit 2'], 
abrufen: { :reihe 
	x hinzufügen: 1.
	Ja abbrechen. # muss aufräumen, kein 'Commands out of sync'
}.

>> suchparameter :=
db abfrage: ['SELECT * FROM book order by id desc limit 2'], 
abrufen: { :reihe
	x hinzufügen: 1.
	Ja abbrechen.
}.

(x > 0) ja: {
	Ausgabe schreiben: ['Können wir mitten in einem Abruf abbrechen? '].
}.

Ausgabe schreiben: Ja, stopp.