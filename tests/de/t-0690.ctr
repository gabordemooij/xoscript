# database test
# see example server.xo for required config

Server init.
Ausgabe schreiben: ['Database test'], stopp.

>> db := Maria-DB neu host: ['localhost'],
	benutzername: ['xo'], passwort: ['pass123'], datenbankname: ['xobase'], verbinden.

Ausgabe schreiben: ['Can we connect? '] + db verbunden?, stopp.

>> suchparameter := db abfrage: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parameter: ( Liste neu ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  suchparameter ausführen. db bestätigen. } abfangen: { :e db zurückrollen.  }, starten.

Ausgabe schreiben: ['Can we insert? '] + ( suchparameter insert-id > 0 ), stopp.

>> x := 0.
>> suchparameter :=
db abfrage: ['SELECT * FROM book order by id desc limit 2'], 
abrufen: { :row 
	x hinzufügen: 1.
	Ja abbrechen. # must clean up, no 'Commands out of sync'
}.

>> suchparameter :=
db abfrage: ['SELECT * FROM book order by id desc limit 2'], 
abrufen: { :row
	x hinzufügen: 1.
	Ja abbrechen.
}.

(x > 0) ja: {
	Ausgabe schreiben: ['Can we break in the middle of a fetch? '].
}.

Ausgabe schreiben: Ja, stopp.