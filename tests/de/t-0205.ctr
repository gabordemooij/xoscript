>> str := ['write:'].
Ausgabe nachricht: ['schreiben:'] argumente: (Liste ← ['Hello World']), stopp. 

Zahl wenn: ['isbetween:and:'] tun: { :a :b <- ((selbst ≥ a) und: (selbst ≤ b)).
}.

str := ['isbetween:and:'].
Ausgabe schreiben: (3 nachricht: str argumente: (Liste ← 2 ; 8)), stopp.
Ausgabe schreiben: (3 nachricht: str argumente: (Liste ← 1 ; 2)), stopp.


>> Kaffeemaschine := Objekt neu.
Kaffeemaschine wenn: ['makeCoffeeWithSugar:milk:'] tun: { :sugar :milk <- ( ['Bitte schön... Kaffee mit '] + 
			sugar +
			[' Löffeln Zucker und '] +
			milk +
			[' Tropfen Milch.']
	).
}.

>> bestellung := ['makeCoffeeWithSugar:milk:'].
>> kaffeeKonfiguration := Liste ← 4 ; 2.
Ausgabe schreiben: ( Kaffeemaschine nachricht: bestellung argumente: kaffeeKonfiguration ), stopp.
