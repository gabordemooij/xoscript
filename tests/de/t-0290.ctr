# Listenoperationen testen


>> kuchen := Liste ←
	['apple'] ;
	['Beere'] ;
	['Schoko'] ;
	['Käse'].


>> kaufen := kuchen ersetzen: 1 länge: 2 durch: ( Liste ← ['Zimt'] ; ['Ananas'] ).
Ausgabe schreiben: (kaufen zusammenfügen: [',']), stopp.


>> kaufen := kuchen ersetzen: 1 länge: 12 durch: ( Liste ← ['Zimt'] ; ['Ananas'] ).
Ausgabe schreiben: (kaufen zusammenfügen: [',']), stopp.


>> kaufen := kuchen ersetzen: 2 länge: 10 durch: ( Liste neu ).
Ausgabe schreiben: (kaufen zusammenfügen: [',']), stopp.


>> kaufen := kuchen ersetzen: 0 länge: 1 durch: ( Liste neu ).
Ausgabe schreiben: (kaufen zusammenfügen: [',']), stopp.


>> kaufen := kuchen ersetzen: ['0'] länge: ['1'] durch: ['x'].
Ausgabe schreiben: (kaufen zusammenfügen: [',']), stopp.
