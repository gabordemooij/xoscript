# test list operations


>> cakes := Liste ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes ersetzen: 1 länge: 2 durch: ( Liste ← ['cinnamon'] ; ['pineapple'] ).
Ausgabe schreiben: (buy zusammenfügen: [',']), stopp.


>> buy := cakes ersetzen: 1 länge: 12 durch: ( Liste ← ['cinnamon'] ; ['pineapple'] ).
Ausgabe schreiben: (buy zusammenfügen: [',']), stopp.


>> buy := cakes ersetzen: 2 länge: 10 durch: ( Liste neu ).
Ausgabe schreiben: (buy zusammenfügen: [',']), stopp.


>> buy := cakes ersetzen: 0 länge: 1 durch: ( Liste neu ).
Ausgabe schreiben: (buy zusammenfügen: [',']), stopp.


>> buy := cakes ersetzen: ['0'] länge: ['1'] durch: ['x'].
Ausgabe schreiben: (buy zusammenfügen: [',']), stopp.
