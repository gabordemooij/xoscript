

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm speicherverwaltung: 0.

>> txt := ['Word Salad'].
Ausgabe schreiben: ['Text Length: '] + txt länge, stopp.
Ausgabe schreiben: ['Character at 2:'] + ( txt zeichen: 2 ), stopp.
Ausgabe schreiben: (( txt finden: ['S'] ) - 0), stopp.

Programm aufräumen.

usedMemory1 := (Programm speicher ? 0).


txt := ['Word Salad'].
Ausgabe schreiben: ['Text Length: '] + txt länge, stopp.
Ausgabe schreiben: ['Character at 2:'] + ( txt zeichen: 2 ), stopp.
Ausgabe schreiben: (( txt finden: ['S'] ) - 0), stopp.

Programm aufräumen.
usedMemory2 := (Programm speicher ? 0).


txt := ['Word Salad'].
Ausgabe schreiben: ['Text Length: '] + txt länge, stopp.
Ausgabe schreiben: ['Character at 2:'] + ( txt zeichen: 2 ), stopp.
Ausgabe schreiben: (( txt finden: ['S'] ) - 0), stopp.

Programm aufräumen.
usedMemory3 := (Programm speicher ? 0).



( usedMemory1 = usedMemory2 und: usedMemory1 = usedMemory3, und: usedMemory2 = usedMemory3 ) ja: {
	Ausgabe schreiben: ['No memory leaks here'].
}, nein: {
	Ausgabe schreiben: ['Leaking memory...'].
}.
