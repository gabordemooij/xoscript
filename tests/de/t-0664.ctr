# rekursive Interpolation nicht erlaubt

Ausgabe schreiben: 
['rekursive Textinterolation aktiv: '] + (
	Programm merkmal: 
	['RECURSIVE_STRINTPOL']
), stopp.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Ausgabe schreiben: a, stopp.


Programm merkmal: ['RECURSIVE_STRINTPOL'] aktivieren: Ja.

Ausgabe schreiben: 
['rekursive Textinterpolation aktiviert: '] + (
	Programm merkmal: 
	['RECURSIVE_STRINTPOL']
), stopp.

>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Ausgabe schreiben: a, stopp.

Programm merkmal: ['RECURSIVE_STRINTPOL'] aktivieren: Nein.

Ausgabe schreiben: 
['rekursive Textinterpolation aktiviert: '] + (
	Programm merkmal: 
	['RECURSIVE_STRINTPOL']
), stopp.

>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Ausgabe schreiben: a, stopp.
