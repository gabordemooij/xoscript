# recursive interpolation not allowed

Ausgabe schreiben: 
['recursive string interolation enabled: '] + (
	Programm merkmal: 
	['RECURSIVE_STRINTPOL']
), stopp.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Ausgabe schreiben: a, stopp.


Programm merkmal: ['RECURSIVE_STRINTPOL'] aktivieren: Ja.

Ausgabe schreiben: 
['recursive string interpolation enabled: '] + (
	Programm merkmal: 
	['RECURSIVE_STRINTPOL']
), stopp.

>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Ausgabe schreiben: a, stopp.

Programm merkmal: ['RECURSIVE_STRINTPOL'] aktivieren: Nein.

Ausgabe schreiben: 
['recursive string interpolation enabled: '] + (
	Programm merkmal: 
	['RECURSIVE_STRINTPOL']
), stopp.

>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Ausgabe schreiben: a, stopp.
