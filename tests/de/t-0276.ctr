>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objekt neu.
⚄ wenn: ['drawFrom:length:'] tun: { :pool :anzahl
	
	>> result := [''].
	
	{
		>> index := Zahl random % (pool länge).
		result anhängen: ( pool zeichen: (index + 1) ).
		
	} × anzahl. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? länge.
Ausgabe schreiben: (['x↵'] x random länge).
Ausgabe schreiben: (['y↵'] y ?? länge).

