>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objekt neu.
⚄ wenn: ['zieheAus:länge:'] tun: { :vorrat :anzahl
	
	>> resultat := [''].
	
	{
		>> index := Zahl zufällig % (vorrat länge).
		resultat anhängen: ( vorrat zeichen: (index + 1) ).
		
	} × anzahl. <- resultat.
}.

>> zufällig := ⚄ zieheAus: ?? länge: ?? länge.
Ausgabe schreiben: (['x↵'] x zufällig länge).
Ausgabe schreiben: (['y↵'] y ?? länge).

