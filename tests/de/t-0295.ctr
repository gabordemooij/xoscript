
>> nachschlagewerk := (
	Wörterbuch neu
		setzen: ['b'] auf: ['a'],
		setzen: ['a'] auf: ['b'],
		setzen: ['z'] auf: ['x'],
		setzen: ['hello'] auf: ['hallo'],
		setzen: ['human'] auf: ['human']
).

>> vergleiche := Liste neu.
nachschlagewerk jedes: { :a :b
	vergleiche ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a vergleichen: b)
	).
}.

vergleiche sortieren: { :a :b <- ( a vergleichen: b ). }.
Ausgabe schreiben: ( vergleiche zusammenfügen: ['↵'] ), stopp.
vergleiche zusammenfügen: ['↵'].
