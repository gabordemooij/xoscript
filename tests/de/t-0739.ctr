Ausgabe schreiben: ['Testobjekt'], stopp.
>> a := Objekt neu. 

a wenn: ['item:'] tun: { :binhelfer
	eigen binhelfer := binhelfer. 
}.

a wenn: ['posten'] tun: {
	<- eigen binhelfer.
}.

a item: Bin neu.

>> alte-binhelfer-adresse := a posten prototyp speicheradresse.
a save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== SNAP NEU LADEN:'], stopp.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b posten prototyp speicheradresse = alte-binhelfer-adresse) ja: {
	Ausgabe schreiben: ['Objektverknüpfung wieder angehängt.'], stopp.
}.


