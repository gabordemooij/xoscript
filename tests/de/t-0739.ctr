Ausgabe schreiben: ['Test object'], stopp.
>> a := Objekt neu. 

a wenn: ['item:'] tun: { :binhelper
	eigen binhelper := binhelper. 
}.

a wenn: ['item'] tun: { <- eigen binhelper.
}.

a item: Bin neu.

>> old-binhelper-address := a item prototyp speicheradresse.
a save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== RELOADING SNAP:'], stopp.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp speicheradresse = old-binhelper-address) ja: {
	Ausgabe schreiben: ['Object link re-attached.'], stopp.
}.


