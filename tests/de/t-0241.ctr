

Text wenn: ['auswerten'] tun: {
	>> code := Datei neu: ['/tmp/eval.ctr'].
	code schreiben: (selbst text + ['.']).
	Programm verwenden: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Liste ← (['Anführungszeichen '] + Q + [' sind böse?']) ; 1.
>> x := q text.
Ausgabe schreiben: x, stopp.
>> y := Nichts.
(['y := '] + x ) auswerten.
Ausgabe schreiben: y ? 0, stopp.

q := Wörterbuch setzen: ['\[''] auf: ['\['quote\']'].
x := q text.
Ausgabe schreiben: x, stopp.
y := Nichts.
(['y := '] + x ) auswerten.

>> q := (Wörterbuch neu) setzen:['\[''] auf:['\['quote\[''].
Ausgabe schreiben: y ? ['\['quote\']'], stopp.
