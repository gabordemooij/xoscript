>> addiererMachen := { :x
	>> f := { :y <- (eigen x + y). } setzen: ['x'] wert: x. <- f.
}.
>> abbilder := { :feld :fkt
	>> abbildung := { :i eigen q setzen: (eigen f anwenden: (eigen q ? i)) auf: i. } 
	setzen: ['q'] wert: feld,
	setzen: ['f'] wert: fkt.
	{ :i abbildung anwenden: i. } × (feld anzahl).
}.

>> a := Liste ← 1; 2; 3.
abbilder anwenden: a und: (addiererMachen anwenden: 100).
Ausgabe schreiben: (a position: 0), stopp.
Ausgabe schreiben: (a ? 1), stopp.
Ausgabe schreiben: (a ? 2), stopp.
