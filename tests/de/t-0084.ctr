>> makeAdder := { :x
	>> f := { :y <- (eigen x + y). } setzen: ['x'] wert: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i eigen q setzen: (eigen f anwenden: (eigen q ? i)) auf: i. } 
	setzen: ['q'] wert: array,
	setzen: ['f'] wert: func.
	{ :i mapping anwenden: i. } × (array anzahl).
}.

>> a := Liste ← 1; 2; 3.
mapper anwenden: a und: (makeAdder anwenden: 100).
Ausgabe schreiben: (a position: 0), stopp.
Ausgabe schreiben: (a ? 1), stopp.
Ausgabe schreiben: (a ? 2), stopp.
