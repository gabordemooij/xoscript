# Catch-all-Test (praktisch)
>> HTML := Text neu.
HTML wenn: ['encode:'] tun: { :tekst
	selbst anhängen: (tekst
	ersetzen: ['&'] mit: ['&amp;'], 
	ersetzen: ['<'] mit: ['&lt;'],
	ersetzen: ['>'] mit: ['&gt;'],
	ersetzen: ['"'] mit: ['&quot;']).
}.
>> blog := HTML neu.
blog anhängen: ['<h1>'],
     encode: ['Koffie & Thee'],
     anhängen: ['</h1>'].
Ausgabe schreiben: blog, stopp.


>> Römisch := Zahl neu.
Römisch wenn: ['textartig'] tun: {
	>> a := [''].
	{ a anhängen: ['I']. } × selbst. <- a.
}.

>> x := Römisch neu.
x hinzufügen: 3.
Ausgabe schreiben: x textartig, stopp.

>> Quant := Wahrheitswert neu.
Quant wenn: ['true?'] tun: { <- ['vielleicht Ja']. }.
Ausgabe schreiben: (Quant neu true?), stopp.

>> Nihil := Nichts neu.
Nihil wenn: ['text'] tun: { <- ['Nihil']. }.
Ausgabe schreiben: (Nihil neu), stopp.
