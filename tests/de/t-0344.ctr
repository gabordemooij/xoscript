# catch-all test (practical)
>> HTML := Text neu.
HTML wenn: ['encode:'] tun: { :tekst
	selbst anhängen: (tekst
	ersetzen: ['&'] mit: ['&amp;'], 
	ersetzen: ['<'] mit: ['&lt;'],
	ersetzen: ['>'] mit: ['&gt;'],
	ersetzen: ['"'] mit: ['&quot;']).
}.
>> blog := HTML neu.
blog anhängen: ['<h1>'],
     encode: ['Koffie & Thee'],
     anhängen: ['</h1>'].
Ausgabe schreiben: blog, stopp.


>> Roman := Zahl neu.
Roman wenn: ['stringy'] tun: {
	>> a := [''].
	{ a anhängen: ['I']. } × selbst. <- a.
}.

>> x := Roman neu.
x hinzufügen: 3.
Ausgabe schreiben: x stringy, stopp.

>> Quantum := Wahrheitswert neu.
Quantum wenn: ['true?'] tun: { <- ['maybe True']. }.
Ausgabe schreiben: (Quantum neu true?), stopp.

>> Nihil := Nichts neu.
Nihil wenn: ['text'] tun: { <- ['Nihil']. }.
Ausgabe schreiben: (Nihil neu), stopp.
