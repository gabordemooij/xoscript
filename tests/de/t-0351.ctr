
>> belegterSpeicher1 := 0.
>> belegterSpeicher2 := 0.
>> belegterSpeicher3 := 0.
>> belegterSpeicher4 := 0.

>> code := {
	>> o := (
		Wörterbuch neu
		aa: (Liste ← 1 ; 2),
		bb: (Liste ← 3 ; 4)
	).
	>> s := o text.
	>> o2 := s objekt.
	(s  typ = Text typ) ja: { Ausgabe schreiben: ['OK1'], stopp. }.
	(o2 typ = Wörterbuch typ) ja: { Ausgabe schreiben: ['OK2'], stopp. }.
}.

Programm speicherverwaltung: 0.
['Speicher 1 wird anders sein, weil verfolgte Blöcke gebündelt hinzukommen.'].
Programm aufräumen.
belegterSpeicher1 := (Programm speicher ? 1).
code starten.
Programm aufräumen.
belegterSpeicher2 := (Programm speicher ? 1).
code starten.
Programm aufräumen.
belegterSpeicher3 := (Programm speicher ? 1).
code starten.
Programm aufräumen.
belegterSpeicher4 := (Programm speicher ? 1).

(belegterSpeicher2 = belegterSpeicher3 = belegterSpeicher4) ja: { Ausgabe schreiben: ['OK3'], stopp. }.
 
