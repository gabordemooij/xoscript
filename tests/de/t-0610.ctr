
>> Rechteck := Objekt neu.

Rechteck wenn: ['fläche'] tun: {
	<- eigen länge * eigen breite.
}.

Rechteck wenn: ['length:'] tun: { :länge
	eigen länge := länge.
}.

Rechteck wenn: ['width:'] tun: { :breite
	eigen breite := breite.
}.

Rechteck wenn: ['neu'] tun: {
	# das führt nicht zu einer Endlosschleife
	>> rechteck := selbst neu.
	rechteck length: 0, width: 0.
	<- rechteck.
}.

>> a := Rechteck neu.
Ausgabe schreiben: a fläche, stopp. #0

>> b := Rechteck neu length: 2, width: 3.
Ausgabe schreiben: b fläche, stopp. #6

