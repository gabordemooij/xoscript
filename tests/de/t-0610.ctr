
>> Rectangle := Objekt neu.

Rectangle wenn: ['area'] tun: { <- eigen länge * eigen width.
}.

Rectangle wenn: ['length:'] tun: { :länge
	eigen länge := länge.
}.

Rectangle wenn: ['width:'] tun: { :width
	eigen width := width.
}.

Rectangle wenn: ['neu'] tun: {
	# this will not result into an infinite loop
	>> rectangle := selbst neu.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle neu.
Ausgabe schreiben: a area, stopp. #0

>> b := Rectangle neu length: 2, width: 3.
Ausgabe schreiben: b area, stopp. #6

