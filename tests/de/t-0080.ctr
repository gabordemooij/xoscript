{
	>> a := Liste neu.
	a anhängen: 1.
	a anhängen: 2.
	Ausgabe schreiben: (a zusammenfügen: [',']), stopp.
	a setzen: 3 auf: 2.
	Ausgabe schreiben: (a zusammenfügen: [',']), stopp.
	a setzen: 4 auf: 10.
	Ausgabe schreiben: (a zusammenfügen: [',']), stopp.
	a erstes-entnehmen.
	a erstes-entnehmen.
	a erstes-entnehmen.
	Ausgabe schreiben: (a zusammenfügen: [',']), stopp.
	a setzen: 9 auf: 0.
	Ausgabe schreiben: (a zusammenfügen: [',']), stopp.
	a setzen: 6 auf: -1.
} abfangen: { :e
	Ausgabe schreiben: ['Uncatched error has occurred.↵'] + e, stopp.
}, starten.


