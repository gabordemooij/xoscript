Ausgabe schreiben: ['Test object'], stopp.
>> a := Objekt neu. 

a wenn: ['item:'] tun: { :nil
	eigen nil := nil. 
}.

a wenn: ['item'] tun: { <- eigen nil.
}.

a item: Nichts.

Ausgabe schreiben: a item, stopp.

>> old-nil-address := a item prototyp speicheradresse.
a save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== RELOADING SNAP:'], stopp.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp speicheradresse = old-nil-address) ja: {
	Ausgabe schreiben: ['Object link re-attached.'], stopp.
}.

Ausgabe schreiben: b item, stopp.
