


>> belegterSpeicher1 := 0.
>> belegterSpeicher2 := 0.
>> belegterSpeicher3 := 0.
>> belegterSpeicher4 := 0.

Programm speicherverwaltung: 0.
>> palette := Nichts.
>> farben := Nichts.

{
palette := Wörterbuch neu.
palette 
	setzen: ['#F00'] auf: ['rot'],
	setzen: ['#0F0'] auf: ['grün'],
	setzen: ['#00F'] auf: ['blau'].
Ausgabe schreiben: ['Anzahl der RGB-Codes in der Palette: '] + ( palette anzahl ), stopp.
Ausgabe schreiben: ['RGB-Code von Grün ist: '] + ( palette ? ['grün'] ), stopp.
farben := [''].
( palette jedes: { :name :code
		farben := farben + ( name + [':'] + code ).
} ).
Ausgabe schreiben: ['Alle Farben in der Palette: '] + farben, stopp.
} starten.
Programm aufräumen.
belegterSpeicher1 := (Programm speicher ? 0).

{
palette := Wörterbuch neu.
palette 
	setzen: ['#F00'] auf: ['rot'],
	setzen: ['#0F0'] auf: ['grün'],
	setzen: ['#00F'] auf: ['blau'].
Ausgabe schreiben: ['Anzahl der RGB-Codes in der Palette: '] + ( palette anzahl ), stopp.
Ausgabe schreiben: ['RGB-Code von Grün ist: '] + ( palette ? ['grün'] ), stopp.
farben := [''].
( palette jedes: { :name :code
		farben := farben + ( name + [':'] + code ).
} ).
Ausgabe schreiben: ['Alle Farben in der Palette: '] + farben, stopp.
} starten.
Programm aufräumen.
belegterSpeicher2 := (Programm speicher ? 0).

{
palette := Wörterbuch neu.
palette 
	setzen: ['#F00'] auf: ['rot'],
	setzen: ['#0F0'] auf: ['grün'],
	setzen: ['#00F'] auf: ['blau'].
Ausgabe schreiben: ['Anzahl der RGB-Codes in der Palette: '] + ( palette anzahl ), stopp.
Ausgabe schreiben: ['RGB-Code von Grün ist: '] + ( palette ? ['grün'] ), stopp.
farben := [''].
( palette jedes: { :name :code
		farben := farben + ( name + [':'] + code ).
} ).
Ausgabe schreiben: ['Alle Farben in der Palette: '] + farben, stopp.
} starten.
Programm aufräumen.
belegterSpeicher3 := (Programm speicher ? 0).



( belegterSpeicher1 = belegterSpeicher2 und: belegterSpeicher1 = belegterSpeicher3, und: belegterSpeicher2 = belegterSpeicher3 ) ja: {
	Ausgabe schreiben: ['Hier keine Speicherlecks'].
}, nein: {
	Ausgabe schreiben: ['Speicherleck...'].
}.
