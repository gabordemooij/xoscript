


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm speicherverwaltung: 0.
>> palette := Nichts.
>> colors := Nichts.

{
palette := Wörterbuch neu.
palette 
	setzen: ['#F00'] auf: ['red'],
	setzen: ['#0F0'] auf: ['green'],
	setzen: ['#00F'] auf: ['blue'].
Ausgabe schreiben: ['number of RGB codes in palette: '] + ( palette anzahl ), stopp.
Ausgabe schreiben: ['RGB code of green is: '] + ( palette ? ['green'] ), stopp.
colors := [''].
( palette jedes: { :name :code
		colors := colors + ( name + [':'] + code ).
} ).
Ausgabe schreiben: ['All colors in palette: '] + colors, stopp.
} starten.
Programm aufräumen.
usedMemory1 := (Programm speicher ? 0).

{
palette := Wörterbuch neu.
palette 
	setzen: ['#F00'] auf: ['red'],
	setzen: ['#0F0'] auf: ['green'],
	setzen: ['#00F'] auf: ['blue'].
Ausgabe schreiben: ['number of RGB codes in palette: '] + ( palette anzahl ), stopp.
Ausgabe schreiben: ['RGB code of green is: '] + ( palette ? ['green'] ), stopp.
colors := [''].
( palette jedes: { :name :code
		colors := colors + ( name + [':'] + code ).
} ).
Ausgabe schreiben: ['All colors in palette: '] + colors, stopp.
} starten.
Programm aufräumen.
usedMemory2 := (Programm speicher ? 0).

{
palette := Wörterbuch neu.
palette 
	setzen: ['#F00'] auf: ['red'],
	setzen: ['#0F0'] auf: ['green'],
	setzen: ['#00F'] auf: ['blue'].
Ausgabe schreiben: ['number of RGB codes in palette: '] + ( palette anzahl ), stopp.
Ausgabe schreiben: ['RGB code of green is: '] + ( palette ? ['green'] ), stopp.
colors := [''].
( palette jedes: { :name :code
		colors := colors + ( name + [':'] + code ).
} ).
Ausgabe schreiben: ['All colors in palette: '] + colors, stopp.
} starten.
Programm aufräumen.
usedMemory3 := (Programm speicher ? 0).



( usedMemory1 = usedMemory2 und: usedMemory1 = usedMemory3, und: usedMemory2 = usedMemory3 ) ja: {
	Ausgabe schreiben: ['No memory leaks here'].
}, nein: {
	Ausgabe schreiben: ['Leaking memory...'].
}.
