Zahl wenn: ['roman'] tun: {
	>> zahl := selbst kopieren.
	>> roman := [''].
	{
		{
			(zahl ≥ 1000) ja: {
				roman anhängen: ['Ⅿ'].
				zahl subtrahieren: 1000.
			}, abbrechen.
		
			(zahl ≥ 500) ja: {
				roman anhängen: ['Ⅾ'].
				zahl subtrahieren: 500.
			}, abbrechen.
		
			(zahl ≥ 100) ja: {
				roman anhängen: ['Ⅽ'].
				zahl subtrahieren: 100.
			}, abbrechen.
		
			(zahl ≥ 50) ja: {
				roman anhängen: ['Ⅼ'].
				zahl subtrahieren: 50.
			}, abbrechen.
		
			(zahl ≥ 50) ja: {
				roman anhängen: ['Ⅼ'].
				zahl subtrahieren: 50.
			}, abbrechen.
		
			(zahl ≥ 10) ja: {
				roman anhängen: ['Ⅹ'].
				zahl subtrahieren: 10.
			}, abbrechen.
			
			(zahl ≥ 9) ja: {
				roman anhängen: ['Ⅸ'].
				zahl subtrahieren: 9.
			}, abbrechen.
			
			(zahl ≥ 5) ja: {
				roman anhängen: ['Ⅴ'].
				zahl subtrahieren: 5.
			}, abbrechen.
			
			(zahl ≥ 4) ja: {
				roman anhängen: ['Ⅳ'].
				zahl subtrahieren: 4.
			}, abbrechen.
			
			(zahl ≥ 1) ja: {
				roman anhängen: ['Ⅰ'].
				zahl subtrahieren: 1.
			}, abbrechen.
		} prozedur.
	} solange: { <- zahl > 0. }. <- roman.
}.

Ausgabe schreiben: 1 roman, stopp.
Ausgabe schreiben: 2 roman, stopp.
Ausgabe schreiben: 4 roman, stopp.
