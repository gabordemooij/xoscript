Zahl wenn: ['römisch'] tun: {
	>> zahl := selbst kopieren.
	>> römisch := [''].
	{
		{
			(zahl ≥ 1000) ja: {
				römisch anhängen: ['Ⅿ'].
				zahl subtrahieren: 1000.
			}, abbrechen.
		
			(zahl ≥ 500) ja: {
				römisch anhängen: ['Ⅾ'].
				zahl subtrahieren: 500.
			}, abbrechen.
		
			(zahl ≥ 100) ja: {
				römisch anhängen: ['Ⅽ'].
				zahl subtrahieren: 100.
			}, abbrechen.
		
			(zahl ≥ 50) ja: {
				römisch anhängen: ['Ⅼ'].
				zahl subtrahieren: 50.
			}, abbrechen.
		
			(zahl ≥ 50) ja: {
				römisch anhängen: ['Ⅼ'].
				zahl subtrahieren: 50.
			}, abbrechen.
		
			(zahl ≥ 10) ja: {
				römisch anhängen: ['Ⅹ'].
				zahl subtrahieren: 10.
			}, abbrechen.
			
			(zahl ≥ 9) ja: {
				römisch anhängen: ['Ⅸ'].
				zahl subtrahieren: 9.
			}, abbrechen.
			
			(zahl ≥ 5) ja: {
				römisch anhängen: ['Ⅴ'].
				zahl subtrahieren: 5.
			}, abbrechen.
			
			(zahl ≥ 4) ja: {
				römisch anhängen: ['Ⅳ'].
				zahl subtrahieren: 4.
			}, abbrechen.
			
			(zahl ≥ 1) ja: {
				römisch anhängen: ['Ⅰ'].
				zahl subtrahieren: 1.
			}, abbrechen.
		} prozedur.
	} solange: { <- zahl > 0. }. <- römisch.
}.

Ausgabe schreiben: 1 römisch, stopp.
Ausgabe schreiben: 2 römisch, stopp.
