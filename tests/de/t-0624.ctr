# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := Objekt neu.

Log wenn: ['say:'] tun: { :str
	Ausgabe schreiben: str, stopp.
}.

>> Item := Objekt neu.

Item wenn: ['neu:'] tun: { :id <- selbst neu id: id.
}.

Item wenn: ['id:'] tun: { :id
	eigen id := id.
}.

Item wenn: ['id'] tun: { <- eigen id. }.


Item wenn: ['text'] tun: {
	>> str := ['Item#~no'].
	str ~no: eigen id. <- str.
}.


>> Print := Objekt neu.

Print wenn: ['items'] tun: { 
	
	eigen item := Item neu: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: eigen item
	).
	
	
}.

Print items.