# Dieser Test prüft, ob string_fill_in seinen Slot in Modus 4 nicht verliert (gc'ed)
# Referenz in world.c
>> Logbuch := Objekt neu.

Logbuch wenn: ['say:'] tun: { :str
	Ausgabe schreiben: str, stopp.
}.

>> Posten := Objekt neu.

Posten wenn: ['neu:'] tun: { :id
	<- selbst neu id: id.
}.

Posten wenn: ['id:'] tun: { :id
	eigen id := id.
}.

Posten wenn: ['id'] tun: { <- eigen id. }.


Posten wenn: ['text'] tun: {
	>> str := ['Item#~no'].
	str ~no: eigen id.
	<- str.
}.


>> Print := Objekt neu.

Print wenn: ['items'] tun: { 
	
	eigen posten := Posten neu: 1.
	
	# entweder Segfault oder hier falscher str
	Logbuch say: (
		['~item gedruckt.'] ~item: eigen posten
	).
	
	
}.

Print items.