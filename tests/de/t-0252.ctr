#Linux
>> uhr := Moment neu.
uhr zone: ['UTC-1'].
uhr jahr: 1981, monat: 1, tag: 5,
      stunde: 13, minute: 15, sekunde: 13.

Ausgabe schreiben: uhr, stopp.
uhr zone: ['UTC+0'].

Ausgabe schreiben: (
	(uhr jahr roh) + ['-'] + (uhr monat) + ['-'] + (uhr tag) + [' '] +
	(uhr stunde) + [':'] + (uhr minute) + [':'] + (uhr sekunde) + [' '] +
	['W'] + (uhr woche) + (uhr zone)
), stopp.


uhr zone: ['UTC-1'].
Ausgabe schreiben: (
	(uhr jahr roh) + ['-'] + (uhr monat) + ['-'] + (uhr tag) + [' '] +
	(uhr stunde) + [':'] + (uhr minute) + [':'] + (uhr sekunde) + [' '] +
	['W'] + (uhr woche) + (uhr zone)
), stopp.
