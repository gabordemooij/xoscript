#Linux
>> clock := Moment neu.
clock zone: ['UTC-1'].
clock jahr: 1981, monat: 1, tag: 5,
      stunde: 13, minute: 15, sekunde: 13.

Ausgabe schreiben: clock, stopp.
clock zone: ['UTC+0'].

Ausgabe schreiben: (
	(clock jahr roh) + ['-'] + (clock monat) + ['-'] + (clock tag) + [' '] +
	(clock stunde) + [':'] + (clock minute) + [':'] + (clock sekunde) + [' '] +
	['W'] + (clock woche) + (clock zone)
), stopp.


clock zone: ['UTC-1'].
Ausgabe schreiben: (
	(clock jahr roh) + ['-'] + (clock monat) + ['-'] + (clock tag) + [' '] +
	(clock stunde) + [':'] + (clock minute) + [':'] + (clock sekunde) + [' '] +
	['W'] + (clock woche) + (clock zone)
), stopp.
