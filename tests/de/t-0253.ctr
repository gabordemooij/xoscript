#Linux
>> OS := Programm einstellung: ['OS'].

>> clock := Moment neu.
	
(OS = ['Haiku']) ja: {
	clock zone: ['CET'],
	jahr: 2017, monat: 7, tag: 13,
	stunde: 18, minute: 0, sekunde: 0.
}, sonst: {
	clock zone: ['Europe/Amsterdam'],
	jahr: 2017, monat: 7, tag: 13,
	stunde: 18, minute: 0, sekunde: 0.
}.

clock wenn: ['tell'] tun: {
	Ausgabe schreiben: selbst, stopp.
}.


clock hinzufügen: 2    stunde, tell.
clock hinzufügen: 1    stunde, tell.
clock hinzufügen: 19 minute, tell.
clock hinzufügen: 1  minute, tell.
clock hinzufügen: 1  minute, tell.
clock hinzufügen: 19 sekunde, tell.
clock hinzufügen: 1  sekunde, tell.
clock hinzufügen: 1  sekunde, tell.
clock hinzufügen: 2    jahr, tell.
clock hinzufügen: 1    jahr, tell.

(OS = ['Haiku']) ja: {
clock hinzufügen: 5   monat.
clock zone: ['CEST'], tell.
}, sonst: {
	clock hinzufügen: 5   monat, tell.
}.

clock hinzufügen: 1   monat, tell.
clock hinzufügen: 19    tag, tell.
clock hinzufügen: 1    stunde, tell.
clock hinzufügen: 120  yard, tell.
