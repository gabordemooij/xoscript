#Linux
>> OS := Programm einstellung: ['OS'].

>> uhr := Moment neu.
	
(OS = ['Haiku']) ja: {
	uhr zone: ['CET'],
	jahr: 2017, monat: 7, tag: 13,
	stunde: 18, minute: 0, sekunde: 0.
}, sonst: {
	uhr zone: ['Europe/Amsterdam'],
	jahr: 2017, monat: 7, tag: 13,
	stunde: 18, minute: 0, sekunde: 0.
}.

uhr wenn: ['ansagen'] tun: {
	Ausgabe schreiben: selbst, stopp.
}.


uhr hinzufügen: 2    stunde, ansagen.
uhr hinzufügen: 1    stunde, ansagen.
uhr hinzufügen: 19 minute, ansagen.
uhr hinzufügen: 1  minute, ansagen.
uhr hinzufügen: 1  minute, ansagen.
uhr hinzufügen: 19 sekunde, ansagen.
uhr hinzufügen: 1  sekunde, ansagen.
uhr hinzufügen: 1  sekunde, ansagen.
uhr hinzufügen: 2    jahr, ansagen.
uhr hinzufügen: 1    jahr, ansagen.

(OS = ['Haiku']) ja: {
uhr hinzufügen: 5   monat.
uhr zone: ['CEST'], ansagen.
}, sonst: {
	uhr hinzufügen: 5   monat, ansagen.
}.

uhr hinzufügen: 1   monat, ansagen.
uhr hinzufügen: 19    tag, ansagen.
uhr hinzufügen: 1    stunde, ansagen.
uhr hinzufügen: 120  yard, ansagen.
