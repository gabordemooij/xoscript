

Liste wenn: ['column:'] tun: { :column
	>> result := Liste neu.
	selbst jedes: { :index :row
		row jedes: { :index :cell
			(index = column) ja: { result anhängen: cell. }.
		}.
	}. <- result.
}.


>> a := Liste ←
	(Liste ← 1 ; 2 ; 3) ;
	(Liste ← 4 ; 5 ; 6) ;
	(Liste ← 7 ; 8 ; 9).

>> b := a column: 1.
Ausgabe schreiben: b, stopp.

b := a column: 20.
Ausgabe schreiben: b, stopp.

b := a column: -100.
Ausgabe schreiben: b, stopp.
