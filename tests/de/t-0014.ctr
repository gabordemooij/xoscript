>> Begrüßer := Objekt neu.
Begrüßer wenn: ['machen'] tun: {
	>> gr := Objekt neu.
	gr wenn: ['setName:'] tun: { :einName
		eigen name := einName.
	}.
	gr wenn: ['grüßen'] tun: {
		Ausgabe schreiben: eigen name.
	}. <- gr.
}.
>> a := Begrüßer machen.
>> b := Begrüßer machen.
a setName: ['EINS'].
b setName: ['ZWEI'].
a grüßen.
b grüßen.
>> c := a neu.
c setName: ['DREI'].
c grüßen.
>> d := a neu.
d setName: ['VIER'].
d grüßen.
c grüßen.
