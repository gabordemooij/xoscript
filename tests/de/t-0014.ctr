>> Greeter := Objekt neu.
Greeter wenn: ['make'] tun: {
	>> gr := Objekt neu.
	gr wenn: ['setName:'] tun: { :aname
		eigen name := aname.
	}.
	gr wenn: ['greet'] tun: {
		Ausgabe schreiben: eigen name.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a neu.
c setName: ['THREE'].
c greet.
>> d := a neu.
d setName: ['FOUR'].
d greet.
c greet.
