
>> länder := Liste neu
	~ ['Schweiz']
	~ ['Italien']
	~ ['Deutschland'].

>> lebensmittel := Liste neu
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> zähler := 0.
lebensmittel durch: länder, jedes: { :key :value
	zähler hinzufügen: 1.
}.

Ausgabe schreiben: (['we serve counter dishes'] counter: zähler), stopp.

>> zähler := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] zeichen sortieren: { :v
	zähler hinzufügen: 0.
}.

Ausgabe schreiben: (['we sort counter dishes'] counter: zähler), stopp.


>> zähler := 0.
{
	{
		zähler hinzufügen: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Ausgabe schreiben: (['we calculate counter numbers.'] counter: zähler), stopp.

