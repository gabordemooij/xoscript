
>> countries := Liste neu
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Liste neu
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods durch: countries, jedes: { :key :value
	counter hinzufügen: 1.
}.

Ausgabe schreiben: (['we serve counter dishes'] counter: counter), stopp.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] zeichen sortieren: { :v
	counter hinzufügen: 0.
}.

Ausgabe schreiben: (['we sort counter dishes'] counter: counter), stopp.


>> counter := 0.
{
	{
		counter hinzufügen: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Ausgabe schreiben: (['we calculate counter numbers.'] counter: counter), stopp.

