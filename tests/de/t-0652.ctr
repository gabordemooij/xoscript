# test number -> string -> number
{

	>> x := Zahl zwischen: 0 und: 1000000.
	>> d := Zahl zwischen: 1 und: 7.
	>> e := 10 hoch: d.

	x teilen-durch: e.
	>> y := x text zahl.

	(x = y) nein: {
		Ausgabe schreiben: x, stopp.
		Ausgabe schreiben: y, stopp.
		Programm ende.
	}.

} * 1000.
Ausgabe schreiben: ['OK'], stopp.