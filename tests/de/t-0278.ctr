>> Zu-Erledigen := Objekt neu.

Zu-Erledigen wenn: ['neu'] tun: {
	eigen list := Liste neu.
}.

Zu-Erledigen wenn: ['nieuw'] tun: {
	eigen list := Liste neu.
}.

Zu-Erledigen wenn: ['+'] tun: { :aufgabe
	eigen list anhängen: aufgabe.
}.

Zu-Erledigen wenn: ['number of tasks?'] tun: { <-  eigen list anzahl.
}.

>> aufgaben := 
	Zu-Erledigen neu 
	+ ['Abendessen kochen'] 
	+ ['Zimmer aufräumen'].
	
Ausgabe schreiben: ['You have $ tasks to do'] $ aufgaben number of tasks?.
