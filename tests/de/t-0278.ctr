>> To-Do := Objekt neu.

To-Do wenn: ['neu'] tun: {
	eigen list := Liste neu.
}.

To-Do wenn: ['nieuw'] tun: {
	eigen list := Liste neu.
}.

To-Do wenn: ['+'] tun: { :task
	eigen list anhängen: task.
}.

To-Do wenn: ['number of tasks?'] tun: { <-  eigen list anzahl.
}.

>> todos := 
	To-Do neu 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Ausgabe schreiben: ['You have $ tasks to do'] $ todos number of tasks?.
