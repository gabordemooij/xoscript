>> items := Wörterbuch neu.
items setzen: ['black'] auf: ['coffee'], setzen: ['earl grey'] auf: ['tea'].
Ausgabe schreiben: (items bei: ['coffee']), schreiben: (items bei: ['tea']).
Ausgabe schreiben: ['there are'] + items anzahl + [' items in the array.'].
items setzen: ['capuccino'] auf: ['coffee'].
Ausgabe schreiben: ['Now my coffee is.. '] + (items bei: ['coffee']).
items setzen: ['aaa'] auf: ['1'].
items setzen: ['bbb'] auf: ['2'].
Ausgabe schreiben: (items bei: ['a']).
