>> items := Wörterbuch neu.
items setzen: ['schwarz'] auf: ['coffee'], setzen: ['Earl Grey'] auf: ['tee'].
Ausgabe schreiben: (items bei: ['coffee']), schreiben: (items bei: ['tee']).
Ausgabe schreiben: ['es gibt'] + items anzahl + [' Elemente in der Liste.'].
items setzen: ['capuccino'] auf: ['coffee'].
Ausgabe schreiben: ['Jetzt ist mein Kaffee.. '] + (items bei: ['coffee']).
items setzen: ['aaa'] auf: ['1'].
items setzen: ['bbb'] auf: ['2'].
Ausgabe schreiben: (items bei: ['a']).
