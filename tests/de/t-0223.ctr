>> x := Moment neu.
x zone: ['CEST'],
jahr:2017,
monat:01,
tag:10,
stunde: 10,
minute: 0,
sekunde: 0.

Ausgabe schreiben: x, stopp.

Ausgabe schreiben: x zeit, stopp.

x hinzufügen: 1 sekunde.
x hinzufügen: 2 minute.
x hinzufügen: 3 stunde.
x hinzufügen: 4 tag.
x hinzufügen: 1 monat.
x hinzufügen: 6 jahr.

Ausgabe schreiben: x, stopp.

x subtrahieren: 1 sekunde.
x subtrahieren: 2 minute.
x subtrahieren: 3 stunde.
x subtrahieren: 4 tag.
x subtrahieren: 1 monat.
x subtrahieren: 6 jahr.

Ausgabe schreiben: x, stopp.

>> y := x kopieren.
>> z := x.

Ausgabe schreiben: y, stopp.
Ausgabe schreiben: z, stopp.
Ausgabe schreiben: (x zone = y zone), stopp.
Ausgabe schreiben: (x zeit = y zeit), stopp.
Ausgabe schreiben: (x = z), stopp.
Ausgabe schreiben: x tag-des-jahres, stopp.
Ausgabe schreiben: x wochentag, stopp.
Ausgabe schreiben: x woche, stopp.
