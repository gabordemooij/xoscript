#Linux

(Datei neu: ['/tmp/testje']) existiert nein: {
	Programm system: ['mkdir /tmp/testje'].	
}.

(Datei neu: ['/tmp/testje/file1']) existiert nein: {
	Programm system: ['touch /tmp/testje/file1'].	
}.

(Datei neu: ['/tmp/testje/folder1']) existiert nein: {
	Programm system: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Datei liste: ['/tmp/testje'].

>> q := Liste neu.

l jedes: { :k :v v jedes: { :x :y q anhängen: y. }. }.

>> s := q text.

(s enthält: ['file1']) ja:   { Ausgabe schreiben: ['OK'], stopp. }.
(s enthält: ['file2']) ja:   { Ausgabe schreiben: ['XX'], stopp. }.
(s enthält: ['folder1']) ja: { Ausgabe schreiben: ['OK'], stopp. }.
