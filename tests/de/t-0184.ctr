

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm speicherverwaltung: 0.

Zahl wenn: ['addNum:'] tun: { :x
	selbst hinzufügen: x.
}.

Zahl wenn: ['subtractNum:'] tun: { :x
	selbst subtrahieren: x.
}.

Zahl wenn: ['multiplyBy:'] tun: { :x
	selbst multiplizieren-mit: x.
}.

Zahl wenn: ['divideBy:'] tun: { :x
	selbst teilen-durch: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 hoch: 8).  
a := a + (2 hoch: -1). 
a := a + (49 quadratwurzel).   
a addNum: ((Liste ← 0 ; 1) maximum).          
a addNum: ((Liste ← 2 ; 3) minimum).
Ausgabe schreiben: a.

Programm aufräumen.

usedMemory1 := (Programm speicher ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 hoch: 8).  
a := a + (2 hoch: -1). 
a := a + (49 quadratwurzel).   
a addNum: ((Liste ← 0 ; 1) maximum).          
a addNum: ((Liste ← 2 ; 3) minimum).
Ausgabe schreiben: a.

Programm aufräumen.
usedMemory2 := (Programm speicher ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 hoch: 8).  
a := a + (2 hoch: -1). 
a := a + (49 quadratwurzel).   
a addNum: ((Liste ← 0 ; 1) maximum).          
a addNum: ((Liste ← 2 ; 3) minimum).
Ausgabe schreiben: a.

Programm aufräumen.
usedMemory3 := (Programm speicher ? 0).



( usedMemory1 = usedMemory2 und: usedMemory1 = usedMemory3, und: usedMemory2 = usedMemory3 ) ja: {
	Ausgabe schreiben: ['No memory leaks here'].
}, nein: {
	Ausgabe schreiben: ['Leaking memory...'].
}.
