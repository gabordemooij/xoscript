

>> belegterSpeicher1 := 0.
>> belegterSpeicher2 := 0.
>> belegterSpeicher3 := 0.
>> belegterSpeicher4 := 0.

Programm speicherverwaltung: 0.

Zahl wenn: ['addNum:'] tun: { :x
	selbst hinzufügen: x.
}.

Zahl wenn: ['subtractNum:'] tun: { :x
	selbst subtrahieren: x.
}.

Zahl wenn: ['multiplyBy:'] tun: { :x
	selbst multiplizieren-mit: x.
}.

Zahl wenn: ['divideBy:'] tun: { :x
	selbst teilen-durch: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 hoch: 8).  
a := a + (2 hoch: -1). 
a := a + (49 quadratwurzel).   
a addNum: ((Liste ← 0 ; 1) maximum).          
a addNum: ((Liste ← 2 ; 3) minimum).
Ausgabe schreiben: a.

Programm aufräumen.

belegterSpeicher1 := (Programm speicher ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 hoch: 8).  
a := a + (2 hoch: -1). 
a := a + (49 quadratwurzel).   
a addNum: ((Liste ← 0 ; 1) maximum).          
a addNum: ((Liste ← 2 ; 3) minimum).
Ausgabe schreiben: a.

Programm aufräumen.
belegterSpeicher2 := (Programm speicher ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 hoch: 8).  
a := a + (2 hoch: -1). 
a := a + (49 quadratwurzel).   
a addNum: ((Liste ← 0 ; 1) maximum).          
a addNum: ((Liste ← 2 ; 3) minimum).
Ausgabe schreiben: a.

Programm aufräumen.
belegterSpeicher3 := (Programm speicher ? 0).



( belegterSpeicher1 = belegterSpeicher2 und: belegterSpeicher1 = belegterSpeicher3, und: belegterSpeicher2 = belegterSpeicher3 ) ja: {
	Ausgabe schreiben: ['Hier keine Speicherlecks'].
}, nein: {
	Ausgabe schreiben: ['Speicherleck...'].
}.
