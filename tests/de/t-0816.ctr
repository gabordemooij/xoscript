# ein Format muss zum Typ des Werts passen, der Typ kann von einem Client kommen
>> versuchen := { :formatierung :value
	{ Ausgabe schreiben: ( (Format neu: formatierung) anwenden: value ), stopp. } abfangen: { :e Ausgabe schreiben: e, stopp. }, starten.
}.
>> versuche-int := { :formatierung :value
	{ Ausgabe schreiben: ( (Format neu: formatierung) anwenden-int: value ), stopp. } abfangen: { :e Ausgabe schreiben: e, stopp. }, starten.
}.

# passt
versuchen anwenden: ['|%s|'] und: ['text'].
versuchen anwenden: ['%06.2f'] und: 5.5.
versuchen anwenden: ['100%% %s'] und: ['klar'].
versuche-int anwenden: ['%03d'] und: 7.
versuche-int anwenden: ['%x'] und: 255.
versuchen anwenden: ['%d'] und: (Int64 neu aus-text: ['12']).
versuchen anwenden: ['%lld'] und: (Int64 neu aus-text: ['12']).
versuchen anwenden: ['%.1lf'] und: 5.5.
versuche-int anwenden: ['%hd'] und: 7.

# passt nicht
versuchen anwenden: ['%s'] und: 12345.
versuchen anwenden: ['%d'] und: 12345.
versuchen anwenden: ['%f'] und: ['text'].
versuche-int anwenden: ['%d'] und: ['text'].
versuche-int anwenden: ['%s'] und: 5.
versuchen anwenden: ['%s %s'] und: ['text'].
versuchen anwenden: ['%n'] und: ['text'].
versuchen anwenden: ['%*s'] und: ['text'].
versuchen anwenden: ['%'] und: ['text'].

# Längenmodifikator passt nicht
versuchen anwenden: ['%ls'] und: ['text'].
versuchen anwenden: ['%Lf'] und: 5.5.
versuche-int anwenden: ['%ld'] und: 7.
versuche-int anwenden: ['%lld'] und: 7.
versuchen anwenden: ['%Ld'] und: (Int64 neu aus-text: ['12']).

# eine Breite, die nicht zu printf passt, muss einen Fehler ergeben, keinen Absturz
versuchen anwenden: ['%99999999999s'] und: ['text'].
