Server init.
Ausgabe schreiben: ['Database date test'], stopp.

>> db := Maria-DB neu host: ['localhost'],
	benutzername: ['xo'], 
	passwort: ['pass123'],
	datenbankname: ['xobase'],
	verbinden.

>> suchparameter :=
db abfrage: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
abrufen: { :row
	Ausgabe schreiben: row datetest, stopp.
}.
