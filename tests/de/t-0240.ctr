# test qualifiers

>> $ := Objekt neu.

$ wenn: ['antworten:'] tun: { :x
	
	>> operation := x zeichen: 0.
	>> valuta := x zeichen: 1.
	>> money := x versatz: 2.
	
	>> amount := 0.

	( operation = ['+'] ) ja: {
		( valuta = ['£'] ) ja: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Ausgabe schreiben: x, stopp.


>> Fruit := Objekt neu.

Fruit wenn: ['neu'] tun: {
	>> f := selbst neu.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit wenn: ['apples:'] tun: { :a eigen apples := a. }.
Fruit wenn: ['oranges:'] tun: { :p eigen oranges := p. }.
Fruit wenn: ['apples'] tun: { <- eigen apples. }.
Fruit wenn: ['oranges'] tun: { <- eigen oranges. }.

Fruit wenn: ['+'] tun: { :f
	
	>> n := Fruit neu.
	f hinzufügen: 1.
	
	n apples: (f apples + eigen apples).
	n oranges:  (f oranges  + eigen oranges). <- n.
}.

Fruit wenn: ['text'] tun: { <- ( eigen apples text + [' apples and '] + eigen oranges + [' oranges'] ).
}.

Zahl wenn: ['apples'] tun: { <- ((Fruit neu) apples: selbst).
}.

Zahl wenn: ['apple'] tun: { <- ((Fruit neu) apples: selbst).
}.

Zahl wenn: ['oranges'] tun: { <- ((Fruit neu) oranges: selbst).
}.




Ausgabe schreiben: (1 apple + 3 oranges + 4 apples), stopp.


Text wenn: ['twice'] tun: { <- ((selbst text) + (selbst text)).
}.



Ausgabe schreiben: ['❤❤❤'] twice.



