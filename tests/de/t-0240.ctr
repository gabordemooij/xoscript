# Qualifikationen testen

>> $ := Objekt neu.

$ wenn: ['antworten:'] tun: { :x
	
	>> operation := x zeichen: 0.
	>> währungszeichen := x zeichen: 1.
	>> geld := x versatz: 2.
	
	>> betrag := 0.

	( operation = ['+'] ) ja: {
		( währungszeichen = ['£'] ) ja: { betrag := 1.28 × geld. }.
	}. <- betrag.
}.



>> x := $ +£20.

Ausgabe schreiben: x, stopp.


>> Obst := Objekt neu.

Obst wenn: ['neu'] tun: {
	>> f := selbst neu.
	f apples: 0.
	f oranges: 0. <- f.
}.

Obst wenn: ['apples:'] tun: { :a eigen äpfel := a. }.
Obst wenn: ['oranges:'] tun: { :p eigen orangen := p. }.
Obst wenn: ['äpfel'] tun: { <- eigen äpfel. }.
Obst wenn: ['orangen'] tun: { <- eigen orangen. }.

Obst wenn: ['+'] tun: { :f
	
	>> n := Obst neu.
	f hinzufügen: 1.
	
	n apples: (f äpfel + eigen äpfel).
	n oranges:  (f orangen  + eigen orangen). <- n.
}.

Obst wenn: ['text'] tun: { <- ( eigen äpfel text + [' Äpfel und '] + eigen orangen + [' Orangen'] ).
}.

Zahl wenn: ['äpfel'] tun: { <- ((Obst neu) apples: selbst).
}.

Zahl wenn: ['apple'] tun: { <- ((Obst neu) apples: selbst).
}.

Zahl wenn: ['orangen'] tun: { <- ((Obst neu) oranges: selbst).
}.




Ausgabe schreiben: (1 apple + 3 orangen + 4 äpfel), stopp.


Text wenn: ['zweimal'] tun: { <- ((selbst text) + (selbst text)).
}.



Ausgabe schreiben: ['❤❤❤'] zweimal.



