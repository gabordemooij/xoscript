Server init.
Ausgabe schreiben: ['Database time test'], stopp.

>> db := Maria-DB neu host: ['localhost'],
	benutzername: ['xo'], 
	passwort: ['pass123'],
	datenbankname: ['xobase'],
	verbinden.

>> suchparameter :=
db abfrage: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
abrufen: { :row
	Ausgabe schreiben: row timetest, stopp.
}.
