# Format des Sitzungscookies, JSON-Inhaltstyp, nur Web-Protokolle, SVG wird inline angezeigt
Server initialisieren.
Programm verwenden: ['../../../src/xo/de/webtools.xo'].

>> Schein-Anfrage := Objekt neu.
Schein-Anfrage wenn: ['value:'] tun: { :wert
	eigen wert := wert.
}.
Schein-Anfrage wenn: ['cookie:'] tun: { :name
	<- eigen wert.
}.

>> Test-Sitzung := Tempdatei-Sitzung neu.
Test-Sitzung wenn: ['laden'] tun: {
	<- Wörterbuch neu.
}.
Test-Sitzung wenn: ['sitzungskennung'] tun: {
	<- eigen id.
}.

>> cookies := Liste neu
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

cookies jedes: { :i :cookie
	>> anfrage := Schein-Anfrage neu.
	anfrage value: cookie.
	>> verwalter := Test-Sitzung neu.
	>> webdok := Web-Dokument neu.
	webdok anfrage: anfrage.
	webdok sitzungsverwalter: verwalter.
	webdok sitzung-starten.
	Ausgabe schreiben: ( verwalter sitzungskennung = cookie ), stopp.
}.

>> webdok := Web-Dokument neu.
webdok json: (Wörterbuch neu setzen: ['b'] auf: ['a']).
Ausgabe schreiben: ['\n'], stopp.

{ Netz get: ['file:///etc/hostname']. } abfangen: { :e
	Ausgabe schreiben: e, stopp.
}, starten.

>> svg := Datei neu: ['/tmp/test0814.svg'].
svg schreiben: ['<svg xmlns="x"></svg>'].
Ausgabe stopp.
Server durchreichen: ['test0814.svg'] präfix: ['/tmp/'].
svg löschen.
