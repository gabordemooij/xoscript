>> t := Nichts.

# Sie können die Zeitzone für
# das Parsen so steuern:
Moment zone: ['CET'].
t := Moment aus: ['1981-02-03 04:05:06'].
Ausgabe schreiben: t, stopp.

# jetzt mit Zeitzone CEST:
Moment zone: ['CEST'].
t := Moment aus: ['1981-02-03 04:05:06'].
Ausgabe schreiben: t, stopp.

# Fehler, wenn der Text nicht geparst werden kann
{ Moment aus: ['1900']. } abfangen: { Nichts. }, starten.
