# Alarm setzen

# beendet das Programm nach 1 Sek.
Programm alarm: 1.

Ausgabe schreiben: ['max. 1 Sek.'], stopp.
Moment warten: 2.
Ausgabe schreiben: ['dauert zu lange.'], stopp.

# Hinweis:
# Das Setzen eines Alarms ist unumkehrbar,
# ein Angreifer kann ihn nicht abschalten.
# Nach dem ersten Aufruf ist der Alarm gesperrt.
# Außerdem ist der Alarm wirklich hart,
# das Programm *WIRD* nach dem
# angegebenen Zeitintervall gestoppt, auch wenn es
# gerade blockierend liest oder Ähnliches.

# Hinweis:
# Alarm ist drastisch, setzen Sie lieber einfache
# Timeouts im Webserver.



