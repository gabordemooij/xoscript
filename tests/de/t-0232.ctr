>> Slurp := Objekt neu.

Slurp wenn: ['neu'] tun: {
	eigen str := [''].
}.

Slurp wenn: ['antworten:'] tun: { :blah
		(eigen str = ['']) ja: {
			eigen str anhängen: blah.
		}, sonst: {
			eigen str anhängen: [' '].
			eigen str anhängen: blah.
		}.
}.

Slurp wenn: ['antworten:und:'] tun: { :blah :blahah
		(blah länge > 1) ja: {
			eigen str anhängen: (blah von: 0 länge: (blah länge - 1)).
		}, sonst: {
			eigen str anhängen: blah.
		}.
		eigen str anhängen: [' '].
		eigen str anhängen: blahah.
}.

Slurp wenn: ['obtain'] tun: {
	>> buffer := eigen str.
	eigen str := ['']. <- buffer.
}.


>> x := Slurp neu.
x + 3.
Ausgabe schreiben: (x obtain), stopp.
x echo: ['Hello world'].
Ausgabe schreiben: (x obtain), stopp.
x tellme: 123 and: 987.
Ausgabe schreiben: (x obtain), stopp.
