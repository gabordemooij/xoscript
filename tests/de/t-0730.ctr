Ausgabe schreiben: ['Testobjekt'], stopp.
>> a := Objekt neu. 

a wenn: ['item:'] tun: { :augenblick
	eigen augenblick := augenblick. 
}.

a wenn: ['posten'] tun: {
	<- eigen augenblick.
}.

>> heute := Moment neu zone: ['CEST'], jahr: 2026, monat: 7.
a item: heute.
Ausgabe schreiben: a posten, stopp.
a save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== SNAP NEU LADEN:'], stopp.
>> b := Objekt load-from: ['/tmp/a.bin'].
Ausgabe schreiben: b posten, stopp.
