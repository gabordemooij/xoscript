Ausgabe schreiben: ['Testobjekt'], stopp.
>> a := Objekt neu. 

a wenn: ['item:'] tun: { :ausg
	eigen ausg := ausg. 
}.

a wenn: ['posten'] tun: {
	<- eigen ausg.
}.

a wenn: ['grüßen'] tun: {
	Ausgabe schreiben: ['hallo von der originalen Ausgabe!'], stopp.
}.

a item: Ausgabe.

Ausgabe schreiben: a posten, stopp.

>> alte-ausg-adresse := a posten prototyp speicheradresse.
a save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== SNAP NEU LADEN:'], stopp.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b posten prototyp speicheradresse = alte-ausg-adresse) ja: {
	Ausgabe schreiben: ['Objektverknüpfung wieder angehängt.'], stopp.
}.

b posten schreiben: ['hallo von der geladenen Ausgabe!'], stopp.
b grüßen.
