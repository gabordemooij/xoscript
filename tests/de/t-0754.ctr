Ausgabe schreiben: ['Test object'], stopp.
>> a := Objekt neu. 

a wenn: ['item:'] tun: { :out
	eigen out := out. 
}.

a wenn: ['item'] tun: { <- eigen out.
}.

a wenn: ['greet'] tun: {
	Ausgabe schreiben: ['hi from original out!'], stopp.
}.

a item: Ausgabe.

Ausgabe schreiben: a item, stopp.

>> old-out-address := a item prototyp speicheradresse.
a save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== RELOADING SNAP:'], stopp.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp speicheradresse = old-out-address) ja: {
	Ausgabe schreiben: ['Object link re-attached.'], stopp.
}.

b item schreiben: ['hello from loaded out!'], stopp.
b greet.
