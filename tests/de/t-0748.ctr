Ausgabe schreiben: ['Test object'], stopp.
>> a := Objekt neu. 

a wenn: ['item:'] tun: { :wahrheitswert
	eigen wahrheitswert := wahrheitswert. 
}.

a wenn: ['item'] tun: { <- eigen wahrheitswert.
}.

a item: Ja.

Ausgabe schreiben: a item, stopp.

>> old-bool-address := a item prototyp speicheradresse.
a save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== RELOADING SNAP:'], stopp.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp speicheradresse = old-bool-address) ja: {
	Ausgabe schreiben: ['Object link re-attached.'], stopp.
}.

Ausgabe schreiben: b item, stopp.
