Ausgabe schreiben: ['Testobjekt'], stopp.
>> a := Objekt neu. 

a wenn: ['item:'] tun: { :wahrheitswert
	eigen wahrheitswert := wahrheitswert. 
}.

a wenn: ['posten'] tun: {
	<- eigen wahrheitswert.
}.

a item: Ja.

Ausgabe schreiben: a posten, stopp.

>> alte-bool-adresse := a posten prototyp speicheradresse.
a save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== SNAP NEU LADEN:'], stopp.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b posten prototyp speicheradresse = alte-bool-adresse) ja: {
	Ausgabe schreiben: ['Objektverknüpfung wieder angehängt.'], stopp.
}.

Ausgabe schreiben: b posten, stopp.
