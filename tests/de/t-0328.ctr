Programm speicherverwaltung: 4.

>> Verdoppler := Objekt neu.
>> Multiplizierer := Objekt neu.
Verdoppler wenn: ['verdoppeln:und:'] tun: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplizierer wenn: ['multipliziere:und:'] tun: { :x :y <- (x × y).
}.

Ausgabe schreiben: (
	Verdoppler verdoppeln:
		(Verdoppler verdoppeln: 
			(Multiplizierer multipliziere: 2 und: 3)
		und:
			(Multiplizierer multipliziere: 3 und: 4)
		)
	und:
		(Verdoppler verdoppeln: 
			(Multiplizierer multipliziere: 2 und: 3)
		und:
			(Multiplizierer multipliziere: 3 und: 4)
		)
), stopp.
