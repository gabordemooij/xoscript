Programm speicherverwaltung: 4.

>> Doubler := Objekt neu.
>> Multiplier := Objekt neu.
Doubler wenn: ['double:and:'] tun: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier wenn: ['multiply:and:'] tun: { :x :y <- (x × y).
}.

Ausgabe schreiben: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), stopp.
