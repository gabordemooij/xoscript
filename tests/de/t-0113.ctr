Ausgabe schreiben: ['Continue for-loop, No - before 6 and up.'], stopp.
{ :i
	Ausgabe schreiben: (i + 1), stopp.
	((i + 1) > 4) fortsetzen.
	Ausgabe schreiben: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Ausgabe stopp.
Ausgabe schreiben: ['Continue while-true, No --> before 5 and up.'], stopp.
{
	Ausgabe schreiben: ['iteration #'] + x, stopp.
	x hinzufügen: 1.
	((x < 5) nicht) fortsetzen.
	Ausgabe schreiben: ['-->'].
} solange: xIsLessThan10.
Ausgabe stopp.
Ausgabe schreiben: ['Continue while-false, No - before 3 only.'], stopp.
{
	Ausgabe schreiben: ['iteration #'] + x, stopp.
	x subtrahieren: 1.
	(x = 3) fortsetzen.
	Ausgabe schreiben: ['-'].
} solange: { <- ( x > 0). }.

Ausgabe stopp.
Ausgabe schreiben: ['Continue times-loop, No ||| before 3.'], stopp.
{ :i
	Ausgabe schreiben: ['iteration #'] + i, stopp.
	(i = 2) fortsetzen.
	Ausgabe schreiben: ['|||'].
} × 5.

Ausgabe stopp.

{ Ja fortsetzen. Ausgabe schreiben: ['dont write this!'], stopp. } starten.

{ Ja fortsetzen. Ausgabe schreiben: ['dont write this!'], stopp. } abfangen: { Ausgabe schreiben: ['Dont catch this!']. }, starten.

Ausgabe schreiben: ['Test Array each-loop: 0, ... ,2'], stopp.
(Liste ← 1 ; 2 ; 3) abbilden: { :i
	(i = 1) fortsetzen.
	Ausgabe schreiben: ['iteration #'] + (i - 0), stopp.
}.

Ausgabe schreiben: ['Test Map each-loop: c only'], stopp.
>> m := Wörterbuch neu.
m setzen: ['first'] auf: ['a'], setzen: ['second'] auf: ['b'], setzen: ['third'] auf: ['c'].
m jedes: { :k :v
	(k ≠ ['c']) fortsetzen.
	Ausgabe schreiben: ['iteration'] + k + v, stopp.
}.

