Ausgabe schreiben: ['For-Schleife fortsetzen, Nein - vor 6 und höher.'], stopp.
{ :i
	Ausgabe schreiben: (i + 1), stopp.
	((i + 1) > 4) fortsetzen.
	Ausgabe schreiben: ['-'].
} × 10.

>> x := 0.
>> xIstKleinerAls10 := { <- ( x < 10 ). }.
Ausgabe stopp.
Ausgabe schreiben: ['While-True fortsetzen, Nein --> vor 5 und höher.'], stopp.
{
	Ausgabe schreiben: ['iteration #'] + x, stopp.
	x hinzufügen: 1.
	((x < 5) nicht) fortsetzen.
	Ausgabe schreiben: ['-->'].
} solange: xIstKleinerAls10.
Ausgabe stopp.
Ausgabe schreiben: ['While-False fortsetzen, Nein - nur vor 3.'], stopp.
{
	Ausgabe schreiben: ['iteration #'] + x, stopp.
	x subtrahieren: 1.
	(x = 3) fortsetzen.
	Ausgabe schreiben: ['-'].
} solange: { <- ( x > 0). }.

Ausgabe stopp.
Ausgabe schreiben: ['Mal-Schleife fortsetzen, Nein ||| vor 3.'], stopp.
{ :i
	Ausgabe schreiben: ['iteration #'] + i, stopp.
	(i = 2) fortsetzen.
	Ausgabe schreiben: ['|||'].
} × 5.

Ausgabe stopp.

{ Ja fortsetzen. Ausgabe schreiben: ['das nicht schreiben!'], stopp. } starten.

{ Ja fortsetzen. Ausgabe schreiben: ['das nicht schreiben!'], stopp. } abfangen: { Ausgabe schreiben: ['Das nicht fangen!']. }, starten.

Ausgabe schreiben: ['Test Liste jedes-Schleife: 0, ... ,2'], stopp.
(Liste ← 1 ; 2 ; 3) abbilden: { :i
	(i = 1) fortsetzen.
	Ausgabe schreiben: ['iteration #'] + (i - 0), stopp.
}.

Ausgabe schreiben: ['Test Tabelle jedes-Schleife: nur c'], stopp.
>> m := Wörterbuch neu.
m setzen: ['first'] auf: ['a'], setzen: ['second'] auf: ['b'], setzen: ['dritter'] auf: ['c'].
m jedes: { :k :v
	(k ≠ ['c']) fortsetzen.
	Ausgabe schreiben: ['iteration'] + k + v, stopp.
}.

