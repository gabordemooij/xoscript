Zahl wenn: ['factorial'] tun: {
	>> total := 1.
	{ :index total multiplizieren-mit: (selbst - (index)). } × selbst. <- total.
}.
>> Printer := Objekt neu.
Printer wenn: ['print:and:'] tun: { :x :y
	Ausgabe schreiben: ['a='] + x + [', b='] + y, stopp.
}.
>> a := 4.5. >> b := a abgerundet.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a aufgerundet.
Printer print: a and: b.
a := 4.5. b := a abgerundet.
Printer print: a and: b.
a := 4.5. b := a gerundet.
Printer print: a and: b.
a := 4.2. b := a gerundet.
Printer print: a and: b.

Ausgabe schreiben: (9 modulo: 5), stopp.
Ausgabe schreiben: -666 absolut, stopp.
Ausgabe schreiben: 49 quadratwurzel, stopp.
Ausgabe schreiben: (2 hoch: 3), stopp.
>> l := (Liste ← 9 ; 6).
Ausgabe schreiben: l minimum.

