Zahl wenn: ['fakultät'] tun: {
	>> gesamt := 1.
	{ :index gesamt multiplizieren-mit: (selbst - (index)). } × selbst. <- gesamt.
}.
>> Drucker := Objekt neu.
Drucker wenn: ['drucken:und:'] tun: { :x :y
	Ausgabe schreiben: ['a='] + x + [', b='] + y, stopp.
}.
>> a := 4.5. >> b := a abgerundet.
Drucker drucken: a und: b.
a := 4. b := a fakultät.
Drucker drucken: a und: b.
a := 4.5. b := a aufgerundet.
Drucker drucken: a und: b.
a := 4.5. b := a abgerundet.
Drucker drucken: a und: b.
a := 4.5. b := a gerundet.
Drucker drucken: a und: b.
a := 4.2. b := a gerundet.
Drucker drucken: a und: b.

