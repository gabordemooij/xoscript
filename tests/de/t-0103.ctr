>> a := Liste ← Objekt ; Ja ; Nein ; Wahrheitswert ; 1 ; Zahl ; ['Str'] ; Text ; { ['Leer']. }.
Ausgabe schreiben: (a anzahl), stopp.
{ :i
	Ausgabe schreiben: 
	['a '] + 
	((a ? i) typ) +
	([' \‘this\’ '] this: (a ? i))  +
	[' ist '] +
	(((a ? i) Nichts?) entweder: [''] oder: ['NICHT']) + 
	[' Nichts.'],
	stopp.
} × (a anzahl).
Ausgabe schreiben: ['aber.. Nichts ist.. '] + ((Nichts Nichts?) entweder: ['sicher NICHTS!'] oder: ['nicht NICHTS??']), stopp.