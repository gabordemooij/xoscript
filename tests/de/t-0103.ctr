>> a := Liste ← Objekt ; Ja ; Nein ; Wahrheitswert ; 1 ; Zahl ; ['Str'] ; Text ; { ['Empty']. }.
Ausgabe schreiben: (a anzahl), stopp.
{ :i
	Ausgabe schreiben: 
	['a '] + 
	((a ? i) typ) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Nichts?) entweder: [''] oder: ['NOT']) + 
	[' Nil.'],
	stopp.
} × (a anzahl).
Ausgabe schreiben: ['but.. Nil is.. '] + ((Nichts Nichts?) entweder: ['certainly NIL!'] oder: ['not NIL??']), stopp.