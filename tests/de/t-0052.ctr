>> items := Wörterbuch neu.
items setzen: ['green'] auf: ['color-1'].
items setzen: ['orange'] auf: ['color-2'].
items setzen: ['red'] auf: ['color-3'].
>> i := 0.
>> s := [''].
items jedes: { :key :color
	Ausgabe schreiben: ['color #'] + i + [' is: '] + color + [' '].
	i hinzufügen: 1.
}.
Ausgabe schreiben: i + [' colors!'].
