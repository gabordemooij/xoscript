>> items := Wörterbuch neu.
items setzen: ['grün'] auf: ['farbe-1'].
items setzen: ['orange'] auf: ['farbe-2'].
items setzen: ['rot'] auf: ['farbe-3'].
>> i := 0.
>> s := [''].
items jedes: { :key :farbe
	Ausgabe schreiben: ['color #'] + i + [' ist: '] + farbe + [' '].
	i hinzufügen: 1.
}.
Ausgabe schreiben: i + [' Farben!'].
