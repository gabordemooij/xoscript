>> x := [' hallo '].

>> y := x großbuchstaben.
Ausgabe schreiben: x, stopp.
Ausgabe schreiben: (x gleich: y), stopp.

>> y := x kleinbuchstaben.
Ausgabe schreiben: x, stopp.
Ausgabe schreiben: (x gleich: y), stopp.

>> y := x trimmen.
Ausgabe schreiben: x, stopp.
Ausgabe schreiben: (x gleich: y), stopp.

>> y := x versatz: 1.
Ausgabe schreiben: x, stopp.
Ausgabe schreiben: (x gleich: y), stopp.

>> y := x von: 1 länge: 2.
Ausgabe schreiben: x, stopp.
Ausgabe schreiben: (x gleich: y), stopp.