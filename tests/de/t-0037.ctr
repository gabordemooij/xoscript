>> a := 3.
>> b := a kopieren.
a subtrahieren: 1.
Ausgabe schreiben: [' a = '] + a.
Ausgabe schreiben: [' b = '] + b.
a := 3.
b := a + 4.
Ausgabe schreiben: [' a = '] + a.
Ausgabe schreiben: [' b = '] + b.
>> x := 3.
>> y := x kopieren.
x hinzufügen: 10.
y subtrahieren: 1.
Ausgabe schreiben: [' x = '] + x.
Ausgabe schreiben: [' y = '] + y.
>> q := Objekt neu.
q wenn: ['setProperty:'] tun: { :x
	eigen prop := x.
}.
q wenn: ['getProperty'] tun: { <- eigen prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Ausgabe schreiben: [' p = '] + (p getProperty).
