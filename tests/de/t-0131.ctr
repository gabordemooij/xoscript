
>> a := Liste ← (Liste ← 100 ; 200 ; 300) ; (Liste ← 9 ; 8 ; 7).
Ausgabe schreiben: ['at 0,1 :'].
Ausgabe schreiben: a ? 0 ? 1, stopp. 
Ausgabe schreiben: ['at 1,2 :'].
Ausgabe schreiben: a ? 1 ? 2, stopp. 
>> menu := Wörterbuch neu.
menu setzen: (Liste ← ['pizza'] ; ['spaghetti']) auf: ['Italian Cuisine'].
menu setzen: (Liste ← ['bifteki'] ; ['suflaki']) auf: ['Greek Cuisine'].
Ausgabe schreiben: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), stopp. 
Ausgabe schreiben: ['but not on the same plate.'], stopp.
