Server init.

# Rückgabe eines Nicht-Textes aus match/do sollte ok sein
>> subject := ['abc'].
>> suchmuster := Muster neu: ['([ac])'].
>> resultat  := suchmuster treffer: subject tun: { :m :x
	Ausgabe schreiben: m, stopp.
	Ausgabe schreiben: x, stopp.
	<- Nichts.
}.
Ausgabe schreiben: resultat, stopp.