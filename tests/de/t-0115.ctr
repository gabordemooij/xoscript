{
	diese-aufgabe fehler: ['Dont fail.'].
	unknown doSomething.
} abfangen: {
	Ausgabe schreiben: ['Caught!'].
}, starten.

{
	diese-aufgabe fehler: ['Dont fail.'].
	eigen unknown doSomething.
} abfangen: {
	Ausgabe schreiben: ['Caught!'].
}, starten.

{
	diese-aufgabe fehler: ['Dont fail.'].
	unknown := 122.
} abfangen: {
	Ausgabe schreiben: ['Caught!'].
}, starten.


{
	diese-aufgabe fehler: ['Dont fail.'].
	Ja abbrechen.
	Ausgabe schreiben: ['FAIL'].
} abfangen: {
	Ausgabe schreiben: ['Caught!'].
}, starten.

{
	{
		diese-aufgabe fehler: ['Dont fail.'].
		Ja abbrechen.
		Ausgabe schreiben: ['FAIL'].
	} abfangen: { :x
		(x = ['Dont fail.']) ja: { diese-aufgabe fehler: ['Nested Caught!']. }.
	}, starten.
} abfangen: { :e
	Ausgabe schreiben: e.
}, starten.
