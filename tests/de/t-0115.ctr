{
	{
		diese-aufgabe fehler: ['Nicht scheitern.'].
		Ja abbrechen.
		Ausgabe schreiben: ['FEHLGESCHLAGEN'].
	} abfangen: { :x
		(x = ['Nicht scheitern.']) ja: { diese-aufgabe fehler: ['Verschachtelt gefangen!']. }.
	}, starten.
} abfangen: { :e
	Ausgabe schreiben: e.
}, starten.
