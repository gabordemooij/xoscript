Ausgabe schreiben: ['Testobjekt'], stopp.
>> a := Objekt neu. 

a wenn: ['item:'] tun: { :wb
	eigen wb := wb. 
}.

a wenn: ['posten'] tun: {
	<- eigen wb.
}.

a item: (
Wörterbuch neu
	hello: ['world'],
	world: (Wörterbuch neu setzen: ['a'] auf: ['b'])).

Ausgabe schreiben: a posten, stopp.

>> alte-wb-adresse := a posten prototyp speicheradresse.
a save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== SNAP NEU LADEN:'], stopp.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b posten prototyp speicheradresse = alte-wb-adresse) ja: {
	Ausgabe schreiben: ['Objektverknüpfung wieder angehängt.'], stopp.
}.

Ausgabe schreiben: b posten, stopp.
