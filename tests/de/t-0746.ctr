Ausgabe schreiben: ['Test object'], stopp.
>> a := Objekt neu. 

a wenn: ['item:'] tun: { :dict
	eigen dict := dict. 
}.

a wenn: ['item'] tun: { <- eigen dict.
}.

a item: (
Wörterbuch neu
	hello: ['world'],
	world: (Wörterbuch neu setzen: ['a'] auf: ['b'])).

Ausgabe schreiben: a item, stopp.

>> old-dict-address := a item prototyp speicheradresse.
a save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== RELOADING SNAP:'], stopp.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp speicheradresse = old-dict-address) ja: {
	Ausgabe schreiben: ['Object link re-attached.'], stopp.
}.

Ausgabe schreiben: b item, stopp.
