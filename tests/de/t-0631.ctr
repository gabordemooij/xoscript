#ffi test


Server init.

Programm speicherverwaltung: 4.

# for this test you need set a path to libc (puts)
>> libname := Programm einstellung: ['FFITESTLIB'].



Server verknüpfen: (
 Liste neu ;
 libname ;
 ['puts'] ;
 ( Liste neu ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s freigeben.

# test with struct

>> a := Blob neu: 8.
a bytes: (
	Liste <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Liste <<: ['int'], ; ['int']).

Server verknüpfen: (
	Liste <<: ['@structtest'], ;
	['@structtest'] ;
	(Liste <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Ausgabe schreiben: ['Sum test:'] + (ffitest ffisum: a), stopp.

struct struct-freigeben.
struct freigeben.
a freigeben.
