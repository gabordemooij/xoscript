

Liste wenn: ['sum'] tun: {
	>> total := 0.
	selbst jedes: { :index :element
		total hinzufügen: element.
	}. <- total.
}.

Liste wenn: ['product'] tun: {
	>> total := 1.
	selbst jedes: { :index :element
		total multiplizieren-mit: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm speicherverwaltung: 0.

{

>> a := Liste ← ['hello'] ; ['world'] ; Ja ; Nichts ; 666.
a := a + ( Liste ← 1 ).
Ausgabe schreiben: ( ['sum: '] + ( a sum ) ), stopp.
Ausgabe schreiben: ( ['min: '] + ( a minimum ) ), stopp.
Ausgabe schreiben: ( ['max: '] + ( a maximum ) ), stopp.
Ausgabe schreiben: ( ['3rd: '] + ( a ? 2 ) ), stopp.
Ausgabe schreiben: ( ['prd: '] + ( a product ) ), stopp.
a sortieren: { :a :b <- (b - a). }.
a jedes: { :i :e Ausgabe schreiben: ( i - 0 ), stopp. }.

} starten.

Programm aufräumen.
usedMemory1 := (Programm speicher ? 0).


{

>> a := Liste ← ['hello'] ; ['world'] ; Ja ; Nichts ; 666.
a := a + ( Liste ← 1 ).
Ausgabe schreiben: ( ['sum: '] + ( a sum ) ), stopp.
Ausgabe schreiben: ( ['min: '] + ( a minimum ) ), stopp.
Ausgabe schreiben: ( ['max: '] + ( a maximum ) ), stopp.
Ausgabe schreiben: ( ['3rd: '] + ( a ? 2 ) ), stopp.
Ausgabe schreiben: ( ['prd: '] + ( a product ) ), stopp.
a sortieren: { :a :b <- (b - a). }.
a jedes: { :i :e Ausgabe schreiben: ( i - 0 ), stopp. }.

} starten.



Programm aufräumen.
usedMemory2 := (Programm speicher ? 0).


{

>> a := Liste ← ['hello'] ; ['world'] ; Ja ; Nichts ; 666.
a := a + ( Liste ← 1 ).
Ausgabe schreiben: ( ['sum: '] + ( a sum ) ), stopp.
Ausgabe schreiben: ( ['min: '] + ( a minimum ) ), stopp.
Ausgabe schreiben: ( ['max: '] + ( a maximum ) ), stopp.
Ausgabe schreiben: ( ['3rd: '] + ( a ? 2 ) ), stopp.
Ausgabe schreiben: ( ['prd: '] + ( a product ) ), stopp.
a sortieren: { :a :b <- (b - a). }.
a jedes: { :i :e Ausgabe schreiben: ( i - 0 ), stopp. }.

} starten.



Programm aufräumen.
usedMemory3 := (Programm speicher ? 0).

( usedMemory1 = usedMemory2 und: usedMemory1 = usedMemory3, und: usedMemory2 = usedMemory3 ) ja: {
	Ausgabe schreiben: ['No memory leaks here'].
}, nein: {
	Ausgabe schreiben: ['Leaking memory...'].
}.
