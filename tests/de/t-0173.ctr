

Liste wenn: ['summe'] tun: {
	>> gesamt := 0.
	selbst jedes: { :index :element
		gesamt hinzufügen: element.
	}. <- gesamt.
}.

Liste wenn: ['produkt'] tun: {
	>> gesamt := 1.
	selbst jedes: { :index :element
		gesamt multiplizieren-mit: element.
	}. <- gesamt.
}.

>> belegterSpeicher1 := 0.
>> belegterSpeicher2 := 0.
>> belegterSpeicher3 := 0.
>> belegterSpeicher4 := 0.

Programm speicherverwaltung: 0.

{

>> a := Liste ← ['hello'] ; ['world'] ; Ja ; Nichts ; 666.
a := a + ( Liste ← 1 ).
Ausgabe schreiben: ( ['Summe: '] + ( a summe ) ), stopp.
Ausgabe schreiben: ( ['Min: '] + ( a minimum ) ), stopp.
Ausgabe schreiben: ( ['Max: '] + ( a maximum ) ), stopp.
Ausgabe schreiben: ( ['3.: '] + ( a ? 2 ) ), stopp.
Ausgabe schreiben: ( ['Prd: '] + ( a produkt ) ), stopp.
a sortieren: { :a :b <- (b - a). }.
a jedes: { :i :e Ausgabe schreiben: ( i - 0 ), stopp. }.

} starten.

Programm aufräumen.
belegterSpeicher1 := (Programm speicher ? 0).


{

>> a := Liste ← ['hello'] ; ['world'] ; Ja ; Nichts ; 666.
a := a + ( Liste ← 1 ).
Ausgabe schreiben: ( ['Summe: '] + ( a summe ) ), stopp.
Ausgabe schreiben: ( ['Min: '] + ( a minimum ) ), stopp.
Ausgabe schreiben: ( ['Max: '] + ( a maximum ) ), stopp.
Ausgabe schreiben: ( ['3.: '] + ( a ? 2 ) ), stopp.
Ausgabe schreiben: ( ['Prd: '] + ( a produkt ) ), stopp.
a sortieren: { :a :b <- (b - a). }.
a jedes: { :i :e Ausgabe schreiben: ( i - 0 ), stopp. }.

} starten.



Programm aufräumen.
belegterSpeicher2 := (Programm speicher ? 0).


{

>> a := Liste ← ['hello'] ; ['world'] ; Ja ; Nichts ; 666.
a := a + ( Liste ← 1 ).
Ausgabe schreiben: ( ['Summe: '] + ( a summe ) ), stopp.
Ausgabe schreiben: ( ['Min: '] + ( a minimum ) ), stopp.
Ausgabe schreiben: ( ['Max: '] + ( a maximum ) ), stopp.
Ausgabe schreiben: ( ['3.: '] + ( a ? 2 ) ), stopp.
Ausgabe schreiben: ( ['Prd: '] + ( a produkt ) ), stopp.
a sortieren: { :a :b <- (b - a). }.
a jedes: { :i :e Ausgabe schreiben: ( i - 0 ), stopp. }.

} starten.



Programm aufräumen.
belegterSpeicher3 := (Programm speicher ? 0).

( belegterSpeicher1 = belegterSpeicher2 und: belegterSpeicher1 = belegterSpeicher3, und: belegterSpeicher2 = belegterSpeicher3 ) ja: {
	Ausgabe schreiben: ['Hier keine Speicherlecks'].
}, nein: {
	Ausgabe schreiben: ['Speicherleck...'].
}.
