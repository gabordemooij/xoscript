Server init.

>> db := Maria-DB neu host: ['localhost'],
	benutzername: ['xo'],
	passwort: ['pass123'],
	datenbankname: ['xobase'],
	verbinden.

>> del := db abfrage: ['DELETE FROM book WHERE id > 0'].
{  del ausführen. db bestätigen. } abfangen: { :e db zurückrollen.  }, starten.

>> anzahl := db abfrage: ['SELECT COUNT(*) AS num FROM book'].
anzahl abrufen: { :row Ausgabe schreiben: row num, stopp. }.
