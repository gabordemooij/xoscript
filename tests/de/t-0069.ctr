

Text wenn: ['html'] tun: { <- (
		selbst
		ersetzen: ['&'] mit: ['&amp;'],
		ersetzen: ['<'] mit: ['&lt;'],
		ersetzen: ['>'] mit: ['&gt;'],
		ersetzen: ['"'] mit: ['&quot;']
	).
}.


Ausgabe schreiben: ([' links getrimmt '] trimmen) + [' '] + ( ['und rechts getrimmt'] trimmen) + ['!'], stopp.
Ausgabe schreiben: ['<html>"html & entities"</html>'] html.
