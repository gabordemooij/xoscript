
>> Animal := Objekt neu.
Animal wenn: ['neu'] tun: { <- selbst neu init.
}.

Animal wenn: ['init'] tun: {
	eigen sound := ['?'].
	eigen legs := 4.
}.

>> Dog := Animal neu.
Dog wenn: ['init'] tun: {
	selbst init.
	eigen sound := ['barks'].
}.

Animal wenn: ['text'] tun: { <- eigen legs text + eigen sound.
}.

>> poodle := Dog neu.
Ausgabe schreiben: poodle, stopp.

