
>> Tier := Objekt neu.
Tier wenn: ['neu'] tun: {
	<- selbst neu init.
}.

Tier wenn: ['init'] tun: {
	eigen laut := ['?'].
	eigen beine  := 4.
}.

>> Hund := Tier neu.
Hund wenn: ['init'] tun: {
	selbst init.
	eigen laut := ['bellt'].
}.

Tier wenn: ['text'] tun: {
	<- eigen beine text + eigen laut.
}.

>> pudel := Hund neu.
Ausgabe schreiben: pudel, stopp.

