Server init.

>> x := Blob neu: 65 typ: ['char'].
# für diesen Test muss ein Pfad zu libc (puts) gesetzt sein
>> bibname := Programm einstellung: ['FFITESTLIB'].
Server verknüpfen: (
 Liste neu ;
 bibname ;
 ['putchar'] ;
 ( Liste neu ; ['char'] ) ;
 ['void'] ;
 ['Print'] ;
 ['char:']
).
Print char: (x von: 0 länge: 1), stopp.
x freigeben.

