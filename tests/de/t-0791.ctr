Server init.

>> DB := Maria-DB neu host: ['localhost'],
	benutzername: ['xo'],
	passwort: ['pass123'],
	datenbankname: ['xobase'],
	verbinden.
	
>> SQL := ['SELECT "hello" AS "world" '].

# Abfrage manuell erstellen
>> suchparameter := Maria-Abfrage neu: SQL.

# Datenbank festlegen
suchparameter datenbank: DB.

suchparameter abrufen: { :reihe
	Ausgabe schreiben: reihe world, stopp.
}.
