Server init.

>> DB := Maria-DB neu host: ['localhost'],
	benutzername: ['xo'],
	passwort: ['pass123'],
	datenbankname: ['xobase'],
	verbinden.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> suchparameter := Maria-Abfrage neu: SQL.

# set database
suchparameter datenbank: DB.

suchparameter abrufen: { :row
	Ausgabe schreiben: row world, stopp.
}.
