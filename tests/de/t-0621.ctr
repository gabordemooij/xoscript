>> sätze := Liste neu
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> nachricht := ['Phrase: ~decoded base64: ~encoded'].
	
sätze jedes: { :_ :satz 
	>> e := Server base64-kodieren: satz.
	>> d := Server base64-dekodieren: e.
	Ausgabe schreiben: (
		nachricht kopieren ~encoded: e, ~decoded: d
	), stopp.
}.
