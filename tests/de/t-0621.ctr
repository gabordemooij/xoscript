>> phrases := Liste neu
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases jedes: { :_ :phrase 
	>> e := Server base64-kodieren: phrase.
	>> d := Server base64-dekodieren: e.
	Ausgabe schreiben: (
		message kopieren ~encoded: e, ~decoded: d
	), stopp.
}.
