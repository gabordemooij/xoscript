>> usedMemory5 := (Programm speicher ? 0).




(usedMemory1 = usedMemory2 = usedMemory3 = usedMemory4 = usedMemory5) ja: { 
	Ausgabe schreiben: ['Memory usage remains stable.'], stopp.
}, sonst: {
	Ausgabe schreiben: ['Used memory not stable.'], stopp.
}.
