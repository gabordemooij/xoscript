

Programm speicherverwaltung: 1.

>> x := 0.
>> y := ['Hello'].
>> q := { ['']. }.
>> p := Ja.
>> a := Liste ← 1 ; 2 ; 3 ; 4.
>> c := Objekt neu.
c wenn: ['greet:'] tun: { Ausgabe schreiben: ['greet!']. }.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.
>> usedMemory5 := 0.

Programm aufräumen.
>> usedMemory1 := (Programm speicher ? 0).




x := 1.
y := ['Hello'].
q := { ['']. }.
p := Ja.
a := Liste ← 1 ; 2 ; 3 ; 5.
c := Objekt neu.
c wenn: ['greet:'] tun: { Ausgabe schreiben: ['greet!']. }.


