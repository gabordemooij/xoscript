# compliance test

# use international numbers

Ausgabe schreiben: ['1000 -> '].
Ausgabe schreiben: 1000, stopp. #1000

Ausgabe schreiben: ['1.5 -> '].
Ausgabe schreiben: 1.5, stopp.  #1.5

Ausgabe schreiben: ['1001.5 -> '].
Ausgabe schreiben: 1.5 + 1000, stopp. #1001.5

# use 0-indexed arrays
>> x := Liste neu ; 1 ; 2 ; 3.
>> y := Liste neu ; ['a'] ; ['b'] ; ['c'].

Ausgabe schreiben: ['1 -> '].
Ausgabe schreiben: x ? 0, stopp. #1

Ausgabe schreiben: ['1 -> '].
Ausgabe schreiben: (x bei: 0), stopp. #1

Ausgabe schreiben: ['1 -> '].
Ausgabe schreiben: x erstes, stopp. #1

Ausgabe schreiben: ['3 -> '].
Ausgabe schreiben: x letztes, stopp. #3

Ausgabe schreiben: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Ausgabe schreiben: (x durch: y), stopp.

Ausgabe schreiben: ['1 -> '].
Ausgabe schreiben: (x von: 0 länge: 1) erstes, stopp. #1

Ausgabe schreiben: ['0 -> '].
Ausgabe schreiben: (x finden: 1), stopp. #0

x setzen: 9 auf: 0.

Ausgabe schreiben: ['9 -> '].
Ausgabe schreiben: (x bei: 0), stopp. #9

x voranstellen: 8.
Ausgabe schreiben: ['8 -> '].
Ausgabe schreiben: (x bei: 0), stopp. #9


x anhängen: 10.
Ausgabe schreiben: ['10 -> '].
Ausgabe schreiben: (x bei: 4), stopp. #10








