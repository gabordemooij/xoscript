>> echo := Objekt neu.
echo wenn: ['antworten:'] tun: { :sound
	{ Ausgabe schreiben: sound. } × 2.
}.
echo ho!. 


echo := Objekt neu.
echo wenn: ['antworten:und:'] tun: { :sound :x
	{ Ausgabe schreiben: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := Objekt neu.
echo wenn: ['antworten:und:und:'] tun: { :operation :sound :x
	{ Ausgabe schreiben: sound. } × x.
}.
echo shout: ['la'] times: 4. 


