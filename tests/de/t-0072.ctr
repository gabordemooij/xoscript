>> echo := Objekt neu.
echo wenn: ['antworten:'] tun: { :laut
	{ Ausgabe schreiben: laut. } × 2.
}.
echo ho!. 


echo := Objekt neu.
echo wenn: ['antworten:und:'] tun: { :laut :x
	{ Ausgabe schreiben: laut. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := Objekt neu.
echo wenn: ['antworten:und:und:'] tun: { :operation :laut :x
	{ Ausgabe schreiben: laut. } × x.
}.
echo shout: ['la'] times: 4. 


