>> Slurp := Objekt neu.
Slurp wenn: ['neu'] tun: {
	eigen str := [''].
}.

Slurp wenn: ['antworten:'] tun: { :blah
		(eigen str ≠ ['']) ja: {
			eigen str anhängen: [' '].
		}.
		eigen str anhängen: blah.
}.
Slurp wenn: ['antworten:und:'] tun: { :blah :blahah
		(eigen str ≠ ['']) ja: {
			eigen str anhängen: [' '].
		}.
		(blah länge > 1) ja: {
			eigen str anhängen: (blah von: 0 länge: (blah länge - 1)).
		}, sonst: {
			eigen str anhängen: blah.
		}.
		eigen str anhängen: [' '].
		eigen str anhängen: blahah.
}.
Slurp wenn: ['obtain'] tun: {
	>> buffer := eigen str.
	eigen str := ['']. <- buffer.
}.

>> s := Slurp neu.
s hello: ['world'].
Ausgabe schreiben: ( s obtain ), stopp.
