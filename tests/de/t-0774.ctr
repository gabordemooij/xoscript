Ausgabe schreiben: ['Testobjekt'], stopp.
>> a := Objekt neu. 
a wenn: ['item:'] tun: { :lst
	eigen lst := lst. 
}.
a wenn: ['posten'] tun: {
	<- eigen lst.
}.
a item: (
	Liste neu ; 1 ; (
		Liste neu ; ['a'] ; (
			Liste neu ; ( Moment neu: 1 )
		) ; ( Int64 aus-text: ['321'] )
	)
).
Ausgabe schreiben: a posten, stopp.
>> alte-lst-adresse := a posten prototyp speicheradresse.
a save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== SNAP NEU LADEN:'], stopp.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b posten prototyp speicheradresse = alte-lst-adresse) ja: {
	Ausgabe schreiben: ['Objektverknüpfung wieder angehängt.'], stopp.
}.
Ausgabe schreiben: ( b posten ), stopp.
