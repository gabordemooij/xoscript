Ausgabe schreiben: ['Test object'], stopp.
>> a := Objekt neu. 
a wenn: ['item:'] tun: { :lst
	eigen lst := lst. 
}.
a wenn: ['item'] tun: { <- eigen lst.
}.
a item: (
	Liste neu ; 1 ; (
		Liste neu ; ['a'] ; (
			Liste neu ; ( Moment neu: 1 )
		) ; ( Int64 aus-text: ['321'] )
	)
).
Ausgabe schreiben: a item, stopp.
>> old-lst-address := a item prototyp speicheradresse.
a save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== RELOADING SNAP:'], stopp.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b item prototyp speicheradresse = old-lst-address) ja: {
	Ausgabe schreiben: ['Object link re-attached.'], stopp.
}.
Ausgabe schreiben: ( b item ), stopp.
