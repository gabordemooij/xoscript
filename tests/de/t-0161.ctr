Programm speicherverwaltung: 0.
Liste wenn: ['summe'] tun: {
	>> gesamt := 0.
	selbst jedes: { :index :element
		gesamt hinzufügen: element.
	}. <- gesamt.
}.

>> belegterSpeicher1 := 0.
>> belegterSpeicher2 := 0.
>> belegterSpeicher3 := 0.
>> belegterSpeicher4 := 0.



>> f := Datei neu: ['/tmp/test.txt'].
f schreiben: ['Lorem Ipsum'].
f schließen.
  

f := Datei neu: ['/tmp/test.txt'].
>> textinhalt := f lesen.
f schließen.



Programm aufräumen.
belegterSpeicher1 := (Programm speicher ? 1).



f := Datei neu: ['/tmp/test.txt'].
textinhalt := f lesen.
f schließen.

Programm aufräumen.
belegterSpeicher2 := (Programm speicher ? 1).


f := Datei neu: ['/tmp/test.txt'].
textinhalt := f lesen.
f schließen.

Programm aufräumen.
belegterSpeicher3 := (Programm speicher ? 1).



( belegterSpeicher1 = belegterSpeicher2 und: belegterSpeicher1 = belegterSpeicher3, und: belegterSpeicher2 = belegterSpeicher3 ) ja: {
	Ausgabe schreiben: ['Hier keine Speicherlecks'].
}, nein: {
	Ausgabe schreiben: ['Speicherleck...'].
}.
