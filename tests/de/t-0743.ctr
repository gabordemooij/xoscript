>> V := Objekt.
V wenn: ['text'] tun: {
	Ausgabe schreiben: ['cast'], stopp. <- ['abc'].
}.

Ausgabe schreiben: ( Programm einstellung: ['abc'] ), stopp.

# params should not get gc'ed
Programm einstellung: ([''] + V neu) wert: ([''] + V neu).

Ausgabe schreiben: ( Programm einstellung: ['abc'] ), stopp.
