>> V := Objekt.
V wenn: ['text'] tun: {
	Ausgabe schreiben: ['cast'], stopp.
	<- ['abc'].
}.

Ausgabe schreiben: ( Programm einstellung: ['abc'] ), stopp.

# Parameter dürfen nicht vom GC eingesammelt werden
Programm einstellung: ([''] + V neu) wert: ([''] + V neu).

Ausgabe schreiben: ( Programm einstellung: ['abc'] ), stopp.
