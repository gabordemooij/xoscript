Server init.
Ausgabe schreiben: ['Database datetime test'], stopp.

>> db := Maria-DB neu host: ['localhost'],
	benutzername: ['xo'], 
	passwort: ['pass123'],
	datenbankname: ['xobase'],
	verbinden.

>> suchparameter :=
db abfrage: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
abrufen: { :row
	Ausgabe schreiben: row datetimetest, stopp.
}.
