# weniger Parameter als Platzhalter müssen einen Fehler ergeben, nicht über die Bindungen hinaus lesen
Server init.

>> db := Maria-DB neu host: ['localhost'],
	benutzername: ['xo'],
	passwort: ['pass123'],
	datenbankname: ['xobase'],
	verbinden.

>> suchparameter := db abfrage: ['SELECT ? AS a, ? AS b, ? AS c'].
suchparameter parameter: (Liste neu ; ['1']).
{ suchparameter abrufen: { :reihe Ausgabe schreiben: reihe, stopp. }. } abfangen: { :e Ausgabe schreiben: e, stopp. }, starten.

>> suchparameter := db abfrage: ['SELECT ? AS a'].
{ suchparameter abrufen: { :reihe Ausgabe schreiben: reihe, stopp. }. } abfangen: { :e Ausgabe schreiben: e, stopp. }, starten.

# die richtige Anzahl funktioniert weiterhin, zusätzliche Parameter werden wie bisher ignoriert
>> suchparameter := db abfrage: ['SELECT ? AS a, ? AS b'].
suchparameter parameter: (Liste neu ; ['1'] ; ['2']).
suchparameter abrufen: { :reihe Ausgabe schreiben: (reihe bei: ['a']), schreiben: (reihe bei: ['b']), stopp. }.
suchparameter parameter: (Liste neu ; ['1'] ; ['2'] ; ['3']).
suchparameter abrufen: { :reihe Ausgabe schreiben: (reihe bei: ['a']), schreiben: (reihe bei: ['b']), stopp. }.
