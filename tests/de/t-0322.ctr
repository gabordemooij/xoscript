

>> Matrjoschka := Objekt neu.
Matrjoschka wenn: ['double:'] tun: { :geheimnis
	eigen geheimnis := geheimnis × 2.
}.
Matrjoschka wenn: ['neu:'] tun: { :geheimnis
	>> lösung := Nichts.
	>> t := (geheimnis > 255).
	Ausgabe schreiben: (geheimnis + [' | '] + t), stopp.
	t ja: {
		lösung := geheimnis.
	}, sonst: {
		lösung := Matrjoschka rekursiv neu: (selbst double: geheimnis).
	}. <- lösung.
}.

>> x := Matrjoschka neu: 2.
