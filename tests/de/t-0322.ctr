

>> Matryoshka := Objekt neu.
Matryoshka wenn: ['double:'] tun: { :secret
	eigen secret := secret × 2.
}.
Matryoshka wenn: ['neu:'] tun: { :secret
	>> answer := Nichts.
	>> t := (secret > 255).
	Ausgabe schreiben: (secret + [' | '] + t), stopp.
	t ja: {
		answer := secret.
	}, sonst: {
		answer := Matryoshka rekursiv neu: (selbst double: secret).
	}. <- answer.
}.

>> x := Matryoshka neu: 2.
