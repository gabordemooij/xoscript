#OBSD
>> dirname := [''].
{ dirname anhängen: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Programm system: command.
Programm chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename anhängen: ['YYYYYYYY']. } * 20.
Datei neu: filename, schreiben: ['sometext'].
{ Datei liste: ['/tmp/'] + dirname. } * 1000.
Ausgabe schreiben: ['no crash'], stopp.

