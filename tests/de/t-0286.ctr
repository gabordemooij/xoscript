['Tausender und Dezimalstellen'].

>> x := 100000000.5.
>> y := 100000000.5.

Ausgabe schreiben: (x + y), stopp.

>> x := 10040.07.
>> y := 10305.60.

Ausgabe schreiben: (x + y), stopp.

['Dezimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Ausgabe schreiben: (x + y + z), stopp.

['Seltsam, aber gültig'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Ausgabe schreiben: (x + y + z), stopp.

>> q := 0.1.2.

Ausgabe schreiben: (q), stopp.

>> q := 012.

Ausgabe schreiben: (q), stopp.
