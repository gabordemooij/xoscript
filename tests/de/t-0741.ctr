Ausgabe schreiben: ['Test object'], stopp.
>> a := Objekt neu. 

a wenn: ['item:'] tun: { :octhelper
	eigen octhelper := octhelper. 
}.

a wenn: ['item'] tun: { <- eigen octhelper.
}.

a item: Oct neu.

>> old-octhelper-address := a item prototyp speicheradresse.
a save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== RELOADING SNAP:'], stopp.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp speicheradresse = old-octhelper-address) ja: {
	Ausgabe schreiben: ['Object link re-attached.'], stopp.
}.
