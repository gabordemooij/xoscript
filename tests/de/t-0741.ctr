Ausgabe schreiben: ['Testobjekt'], stopp.
>> a := Objekt neu. 

a wenn: ['item:'] tun: { :okthelfer
	eigen okthelfer := okthelfer. 
}.

a wenn: ['posten'] tun: {
	<- eigen okthelfer.
}.

a item: Oct neu.

>> alte-okthelfer-adresse := a posten prototyp speicheradresse.
a save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== SNAP NEU LADEN:'], stopp.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b posten prototyp speicheradresse = alte-okthelfer-adresse) ja: {
	Ausgabe schreiben: ['Objektverknüpfung wieder angehängt.'], stopp.
}.
