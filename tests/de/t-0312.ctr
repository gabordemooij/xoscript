>> Slurp := Objekt neu.
Slurp wenn: ['neu'] tun: {
	eigen str := [''].
}.
Slurp lernen: ['nieuw'] bedeutet: ['neu'].
Slurp wenn: ['antworten:'] tun: { :blah
		(eigen str ≠ ['']) ja: {
			eigen str anhängen: [' '].
		}.
		eigen str anhängen: blah.
}.
Slurp wenn: ['antworten:und:'] tun: { :blah :blahah
		(eigen str ≠ ['']) ja: {
			eigen str anhängen: [' '].
		}.
		(blah länge > 1) ja: {
			eigen str anhängen: (blah von: 0 länge: (blah länge - 1)).
		}, sonst: {
			eigen str anhängen: blah.
		}.
		eigen str anhängen: [' '].
		eigen str anhängen: blahah.
}.
Slurp wenn: ['beschaffen'] tun: {
	>> puffer := eigen str.
	eigen str := ['']. <- puffer.
}.


>> suchparameter := Slurp neu
	select: ['*'],
	from
		benutzer 
	where 
		user_id=: 1.

Ausgabe schreiben: suchparameter beschaffen, stopp.
