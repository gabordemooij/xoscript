>> z := Objekt neu.
z wenn: ['value:'] tun: { :v
	eigen value := v. <- selbst.
}.
z wenn: ['value'] tun: { <- eigen value. }.
(z setValue: 1) value: 2.
Ausgabe schreiben: z value.
>> x := z.
Ausgabe schreiben: x value.
z := Nichts.
Ausgabe schreiben: z value.
Ausgabe schreiben: x value.
Ausgabe schreiben: ['hello'].
Ausgabe schreiben: 3 + 2.
Ausgabe schreiben: (3 > 2).
