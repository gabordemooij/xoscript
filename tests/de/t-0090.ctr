Ausgabe schreiben: ['1,2,3,4,5,6,7,8,9,A,'], stopp.
>> Scope := Objekt neu.
Scope wenn: ['initialize:'] tun: { :x eigen property := x. }.
Scope wenn: ['confirm'] tun: { Ausgabe schreiben: [',']. }.
Scope wenn: ['test'] tun: {
	Ausgabe schreiben: eigen property.
	selbst confirm.
	( 1 = 1 ) ja: { Ausgabe schreiben: eigen property. selbst confirm. }.
	( 1 = 0 ) nein: { Ausgabe schreiben: eigen property. selbst confirm. }.
	>> y := 2. { Ausgabe schreiben: eigen property. selbst confirm. } solange: { y subtrahieren: 1. <- (y > 0). }.
	{ Ausgabe schreiben: eigen property. selbst confirm. } × 1.
	(Liste ← 1) jedes: {  Ausgabe schreiben: eigen property. selbst confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Wörterbuch neu one: ['item']) jedes: { Ausgabe schreiben: eigen property. selbst confirm. }.
	{ 1 ÷ 0. } abfangen: { Ausgabe schreiben: eigen property. selbst confirm. }, starten.
	Ausgabe stopp.
}.
>> scope1 := Scope neu.
scope1 initialize: ['X'].
scope1 test.
>> function := { 
	eigen property := ['Y'].
	Ausgabe schreiben: eigen property.
	selbst confirm.
	( 1 = 1 ) ja: { Ausgabe schreiben: eigen property. selbst confirm. }.
	( 1 = 0 ) nein: { Ausgabe schreiben: eigen property. selbst confirm. }.
	>> y := 2. { Ausgabe schreiben: eigen property. selbst confirm. } solange: { y subtrahieren: 1. <- (y > 0). }.
	{ Ausgabe schreiben: eigen property. selbst confirm. } × 1.
	(Liste ← 1) jedes: {  Ausgabe schreiben: eigen property. selbst confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Wörterbuch neu one: ['item']) jedes: { Ausgabe schreiben: eigen property. selbst confirm. }.
	{ 1 ÷ 0. } abfangen: { Ausgabe schreiben: eigen property. selbst confirm. }, starten.
	Ausgabe stopp.
}.
function wenn: ['confirm'] tun: { Ausgabe schreiben: [',']. }.
function anwenden: 1 und: 2.
