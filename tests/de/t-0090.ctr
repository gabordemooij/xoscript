Ausgabe schreiben: ['1,2,3,4,5,6,7,8,9,A,'], stopp.
>> Bereich := Objekt neu.
Bereich wenn: ['initialize:'] tun: { :x eigen eigenschaft := x. }.
Bereich wenn: ['quittieren'] tun: { Ausgabe schreiben: [',']. }.
Bereich wenn: ['test'] tun: {
	Ausgabe schreiben: eigen eigenschaft.
	selbst quittieren.
	( 1 = 1 ) ja: { Ausgabe schreiben: eigen eigenschaft. selbst quittieren. }.
	( 1 = 0 ) nein: { Ausgabe schreiben: eigen eigenschaft. selbst quittieren. }.
	>> y := 2. { Ausgabe schreiben: eigen eigenschaft. selbst quittieren. } solange: { y subtrahieren: 1. <- (y > 0). }.
	{ Ausgabe schreiben: eigen eigenschaft. selbst quittieren. } × 1.
	(Liste ← 1) jedes: {  Ausgabe schreiben: eigen eigenschaft. selbst quittieren. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo eigene Sortierung implementieren, dieser Test schlägt fehl wegen unterschiedlicher Anzahl Iterationen je Plattform
	(Wörterbuch neu one: ['item']) jedes: { Ausgabe schreiben: eigen eigenschaft. selbst quittieren. }.
	{ 1 ÷ 0. } abfangen: { Ausgabe schreiben: eigen eigenschaft. selbst quittieren. }, starten.
	Ausgabe stopp.
}.
>> bereich1 := Bereich neu.
bereich1 initialize: ['X'].
bereich1 test.
>> routine := { 
	eigen eigenschaft := ['Y'].
	Ausgabe schreiben: eigen eigenschaft.
	selbst quittieren.
	( 1 = 1 ) ja: { Ausgabe schreiben: eigen eigenschaft. selbst quittieren. }.
	( 1 = 0 ) nein: { Ausgabe schreiben: eigen eigenschaft. selbst quittieren. }.
	>> y := 2. { Ausgabe schreiben: eigen eigenschaft. selbst quittieren. } solange: { y subtrahieren: 1. <- (y > 0). }.
	{ Ausgabe schreiben: eigen eigenschaft. selbst quittieren. } × 1.
	(Liste ← 1) jedes: {  Ausgabe schreiben: eigen eigenschaft. selbst quittieren. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Wörterbuch neu one: ['item']) jedes: { Ausgabe schreiben: eigen eigenschaft. selbst quittieren. }.
	{ 1 ÷ 0. } abfangen: { Ausgabe schreiben: eigen eigenschaft. selbst quittieren. }, starten.
	Ausgabe stopp.
}.
routine wenn: ['quittieren'] tun: { Ausgabe schreiben: [',']. }.
routine anwenden: 1 und: 2.
