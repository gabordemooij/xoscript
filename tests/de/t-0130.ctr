# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Programm einstellung: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server verknüpfen: ( Liste neu ;
 libname ; ['fopen'] ;
 ( Liste neu ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
verknüpfen: ( Liste neu ;
 Nichts ; # means same lib
 ['fread'] ;
 ( Liste neu ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nichts ; # means same object (i.e. Stream)
 ['fread']
),
verknüpfen: (
 Liste neu ;
 Nichts ; # means same lib
 ['fwrite'] ;
 ( Liste neu ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nichts ; # means same lib
 ['fwrite']
),
verknüpfen: (
 Liste neu ;
 Nichts ; # means same lib
 ['rewind'] ;
 ( Liste neu ; ['pointer'] ) ;
 ['int'] ;
 Nichts ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> pfad := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: pfad mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream nachricht: ['fwrite'] argumente: (Liste neu ; str ; 1 ; 6 ; fd ).
Ausgabe schreiben: bytes-written, stopp.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob neu: 20.

# read from file
>> bytes-read := Stream nachricht: ['fread'] argumente: (Liste neu ; buf ; 1 ; 6 ; fd ).
Ausgabe schreiben: bytes-read, stopp.
Ausgabe schreiben: buf, stopp.

# free memory
str  freigeben.
pfad freigeben.
mode freigeben.
buf  freigeben.


