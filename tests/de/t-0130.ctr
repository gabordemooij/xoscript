# FFI mit dem Server-Plugin verwenden

# mit libc verbinden (plattformabhängig)
>> bibname := Programm einstellung: ['FFITESTLIB'].

# stdio-Funktionen aus C für erweiterte Dateioperationen verknüpfen
Server verknüpfen: ( Liste neu ;
 bibname ; ['fopen'] ;
 ( Liste neu ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
verknüpfen: ( Liste neu ;
 Nichts ; # bedeutet dieselbe Bibliothek
 ['fread'] ;
 ( Liste neu ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nichts ; # bedeutet dasselbe Objekt (d. h. Datenstrom)
 ['fread']
),
verknüpfen: (
 Liste neu ;
 Nichts ; # bedeutet dieselbe Bibliothek
 ['fwrite'] ;
 ( Liste neu ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nichts ; # bedeutet dieselbe Bibliothek
 ['fwrite']
),
verknüpfen: (
 Liste neu ;
 Nichts ; # bedeutet dieselbe Bibliothek
 ['rewind'] ;
 ( Liste neu ; ['pointer'] ) ;
 ['int'] ;
 Nichts ; # bedeutet dieselbe Bibliothek
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> pfad := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# eine Datei mit fopen(path, mode) öffnen
>> fd := Stream path: pfad mode: mode.

# Bytes aus dem Puffer str in die Datei schreiben
>> bytes-geschrieben := Stream nachricht: ['fwrite'] argumente: (Liste neu ; str ; 1 ; 6 ; fd ).
Ausgabe schreiben: bytes-geschrieben, stopp.

# Dateizeiger zurücksetzen
Stream rewind: fd.

# einen Puffer anlegen
>> puf := Blob neu: 20.

# aus der Datei lesen
>> bytes-gelesen := Stream nachricht: ['fread'] argumente: (Liste neu ; puf ; 1 ; 6 ; fd ).
Ausgabe schreiben: bytes-gelesen, stopp.
Ausgabe schreiben: puf, stopp.

# Speicher freigeben
str  freigeben.
pfad freigeben.
mode freigeben.
puf  freigeben.


