Server init.

>> DB := Maria-DB neu host: ['localhost'],
	benutzername: ['xo'],
	passwort: ['pass123'],
	datenbankname: ['xobase'],
	verbinden.

{
	DB abfrage:
	['DROP TABLE movies'],
	ausführen.
} abfangen: { Nichts. }, starten.

DB abfrage:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
ausführen.

DB abfrage: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parameter: ( Liste neu ; ['Halloween'] ),
ausführen.

DB abfrage: ['SELECT * FROM movies'],
abrufen: { :film
	Ausgabe schreiben: film title, stopp.
}.

