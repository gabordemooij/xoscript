
Text wenn: ['auswerten'] tun: {
	>> code := Datei neu: ['/tmp/eval.ctr'].
	code schreiben: (selbst text + ['.']).
	Programm verwenden: ['/tmp/eval.ctr'].
}.

>> map :=
	(Wörterbuch neu)
	setzen: ['Hallo Leute'] auf: ['two'],
	setzen: (Liste ← ['hello'] ; ['world'] ; (Liste ← 1 ; 2; 9) ; Nein) auf: ['eins'],
	setzen: ( (Wörterbuch neu) setzen: ['Wlt'] auf: ['falsch geschrieben'] ) auf: ['three'],
	setzen: (Liste ← ((Wörterbuch neu) setzen: ['Schatz'] auf: ['versteckt']) ; 2) auf: ['vier']. 
>> str := map text.
>> map2 := Nichts.
(['map2 := '] + str ) auswerten.
Ausgabe schreiben: map2 ? ['eins'] ? 0.
Ausgabe schreiben: map2 ? ['eins'] ? 1.
Ausgabe schreiben: map2 ? ['vier'] ? 0 ? ['versteckt'].
Ausgabe schreiben: map2 ? ['eins'] ? 2 ? 2.
