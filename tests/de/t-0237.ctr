
Text wenn: ['evaluate'] tun: {
	>> code := Datei neu: ['/tmp/eval.ctr'].
	code schreiben: (selbst text + ['.']).
	Programm verwenden: ['/tmp/eval.ctr'].
}.

>> map :=
	(Wörterbuch neu)
	setzen: ['Hi There'] auf: ['two'],
	setzen: (Liste ← ['hello'] ; ['world'] ; (Liste ← 1 ; 2; 9) ; Nein) auf: ['one'],
	setzen: ( (Wörterbuch neu) setzen: ['wrrld'] auf: ['misspelled'] ) auf: ['three'],
	setzen: (Liste ← ((Wörterbuch neu) setzen: ['treasure'] auf: ['hidden']) ; 2) auf: ['four']. 
>> str := map text.
>> map2 := Nichts.
(['map2 := '] + str ) evaluate.
Ausgabe schreiben: map2 ? ['one'] ? 0.
Ausgabe schreiben: map2 ? ['one'] ? 1.
Ausgabe schreiben: map2 ? ['four'] ? 0 ? ['hidden'].
Ausgabe schreiben: map2 ? ['one'] ? 2 ? 2.
