Programm speicherverwaltung: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } abfangen: {
		oops hinzufügen: 1.
	}, starten.
} × 1000.

{
	Ausgabe schreiben: ['hi there!'].
	diese-aufgabe fehler: ['oops'].
	Ausgabe schreiben: ['hi there!'].
	{ Ausgabe schreiben: ['dont print this']. } starten.
} abfangen: { :e 
	Ausgabe schreiben: ['got ya!']. 
	Ausgabe schreiben: e.
}, starten.
