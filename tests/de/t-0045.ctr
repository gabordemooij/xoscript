Programm speicherverwaltung: 4.

>> hoppla := 0.
{
	{ 3 ÷ 0. } abfangen: {
		hoppla hinzufügen: 1.
	}, starten.
} × 1000.

{
	Ausgabe schreiben: ['hallo zusammen!'].
	diese-aufgabe fehler: ['oops'].
	Ausgabe schreiben: ['hallo zusammen!'].
	{ Ausgabe schreiben: ['das nicht ausgeben']. } starten.
} abfangen: { :e 
	Ausgabe schreiben: ['hab dich!']. 
	Ausgabe schreiben: e.
}, starten.
