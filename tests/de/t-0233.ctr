
>> Slurp := Objekt neu.

Slurp wenn: ['neu'] tun: {
	eigen str := [''].
}.

Slurp wenn: ['antworten:'] tun: { :blah
		(eigen str = ['']) ja: {
			eigen str anhängen: blah.
		}, sonst: {
			eigen str anhängen: [' '].
			eigen str anhängen: blah.
		}.
}.

Slurp wenn: ['antworten:und:'] tun: { :blah :blahah
		(blah länge > 1) ja: {
			eigen str anhängen: (blah von: 0 länge: (blah länge - 1)).
		}, sonst: {
			eigen str anhängen: blah.
		}.
		eigen str anhängen: [' '].
		eigen str anhängen: blahah.
}.

Slurp wenn: ['beschaffen'] tun: {
	>> puffer := eigen str.
	eigen str := ['']. <- puffer.
}.

Ausgabe schreiben: ( Programm system: ( Slurp neu echo hello world beschaffen ) ).
