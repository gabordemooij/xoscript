>> randomizer := { :a :b
	>> minimum := ( a < b ) entweder: a oder: b.
	>> maximum := ( a > b ) entweder: a oder: b.
	>> x := Nichts.
	{
		x := Zahl zwischen: a und: b.
		((x < minimum) oder: (x > maximum)) ja: { 
			Ausgabe schreiben: (['Invalid value!']).
			Programm ende.
		}.
	} 
	× 100. <- x.
}.
randomizer anwenden: 0 und: 0.
