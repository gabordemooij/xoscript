>> zufallsgenerator := { :a :b
	>> minimum := ( a < b ) entweder: a oder: b.
	>> maximum := ( a > b ) entweder: a oder: b.
	>> x := Nichts.
	{
		x := Zahl zwischen: a und: b.
		((x < minimum) oder: (x > maximum)) ja: { 
			Ausgabe schreiben: (['Ungültiger Wert!']).
			Programm ende.
		}.
	} 
	× 100. <- x.
}.
zufallsgenerator anwenden: 0 und: 0.
zufallsgenerator anwenden: 1 und: 0.
