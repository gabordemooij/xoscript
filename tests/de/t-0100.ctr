Text wenn: ['html'] tun: { <- (
		selbst
		ersetzen: ['&'] mit: ['&amp;'],
		ersetzen: ['<'] mit: ['&lt;'],
		ersetzen: ['>'] mit: ['&gt;'],
		ersetzen: ['"'] mit: ['&quot;']
	).
}.

>> list := Liste neu.

['Verbatim Syntax'] zeichen jedes: { :zahl :buchstabe
	list ; ((['<li>#Number:Letter</li>']) Number: (zahl), Letter: buchstabe).
}.

Ausgabe list.





>> schablone := ['
<html>
<body>
<p>Hello this is a test!</p>
<p>The string \‘Verbatim Syntax\’ has: 15 code points...</p>
<ul>
[list]
</ul>
</body> 
</html>
'] [list]: (list zusammenfügen: ['↵']).

Ausgabe schreiben: schablone.

