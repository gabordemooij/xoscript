
>> Abmessung := Objekt neu.
Abmessung wenn: ['is:'] tun: { :zahl
	zahl wenn: ['+'] tun: { :zahl
		>> einheit := zahl qualifikation.
		>> faktor := 1.
		
		einheit
		fall: ['inch'] tun: { faktor := 0.0833. }.

		<- selbst + (zahl * faktor).
	}.
	<- zahl.
}.

# Diese Größenzahl kann so verwendet werden:

>> brett := Abmessung is: 6 foot.
>> kante := Abmessung is: 50 inch.

# Das wird angezeigt als: 10.165
Ausgabe schreiben: brett + kante, stopp.
