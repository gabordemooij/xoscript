
>> Size := Objekt neu.
Size wenn: ['is:'] tun: { :zahl
	zahl wenn: ['+'] tun: { :zahl
		>> unit := zahl qualifikation.
		>> factor := 1.
		
		unit
		fall: ['inch'] tun: { factor := 0.0833. }. <- selbst + (zahl * factor).
	}. <- zahl.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Ausgabe schreiben: plank + edge, stopp.
