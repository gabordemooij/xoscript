# test catch-all methods
>> x13 := Objekt neu.
x13 wenn: ['a'] tun: { :a Ausgabe schreiben: 0, stopp. }.
x13 wenn: ['a:'] tun: { :a Ausgabe schreiben: a, stopp. <- 5. }.
x13 wenn: ['a:b:'] tun: { :a :b Ausgabe schreiben: (a + b), stopp. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
