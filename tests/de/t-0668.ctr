# von utf16le/be oder utf32le/be nach utf8 dekodieren
Server init.
>> utf16 := Blob neu: 8, bytes: (
	Liste neu ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Ausgabe schreiben: ( utf16 dekodieren: ['utf16le'] ), stopp.

utf16 freigeben.
>> utf32 := Blob neu: 13, bytes: (
	Liste neu ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Ausgabe schreiben: ( utf32 dekodieren: ['utf32be'] ), stopp.
utf32 freigeben.