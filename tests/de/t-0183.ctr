

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm speicherverwaltung: 0.

>> o := Objekt neu.
>> o2 := Objekt neu.
Ausgabe schreiben: o Nichts?, stopp.
Ausgabe schreiben: o typ, stopp.
Ausgabe schreiben: ( o gleich: o ), stopp.
Ausgabe schreiben: ( o gleich: o2 ), stopp.
Ausgabe schreiben: o ich-selbst, stopp.
Ausgabe schreiben: ( o tun erledigt ), stopp.

Programm aufräumen.

usedMemory1 := (Programm speicher ? 0).


o := Objekt neu.
o2 := Objekt neu.
Ausgabe schreiben: o Nichts?, stopp.
Ausgabe schreiben: o typ, stopp.
Ausgabe schreiben: ( o gleich: o ), stopp.
Ausgabe schreiben: ( o gleich: o2 ), stopp.
Ausgabe schreiben: o ich-selbst, stopp.
Ausgabe schreiben: ( o tun erledigt ), stopp.

Programm aufräumen.
usedMemory2 := (Programm speicher ? 0).


o := Objekt neu.
o2 := Objekt neu.
Ausgabe schreiben: o Nichts?, stopp.
Ausgabe schreiben: o typ, stopp.
Ausgabe schreiben: ( o gleich: o ), stopp.
Ausgabe schreiben: ( o gleich: o2 ), stopp.
Ausgabe schreiben: o ich-selbst, stopp.
Ausgabe schreiben: ( o tun erledigt ), stopp.

Programm aufräumen.
usedMemory3 := (Programm speicher ? 0).



( usedMemory1 = usedMemory2 und: usedMemory1 = usedMemory3, und: usedMemory2 = usedMemory3 ) ja: {
	Ausgabe schreiben: ['No memory leaks here'].
}, nein: {
	Ausgabe schreiben: ['Leaking memory...'].
}.
