

>> belegterSpeicher1 := 0.
>> belegterSpeicher2 := 0.
>> belegterSpeicher3 := 0.
>> belegterSpeicher4 := 0.

Programm speicherverwaltung: 0.

>> o := Objekt neu.
>> o2 := Objekt neu.
Ausgabe schreiben: o Nichts?, stopp.
Ausgabe schreiben: o typ, stopp.
Ausgabe schreiben: ( o gleich: o ), stopp.
Ausgabe schreiben: ( o gleich: o2 ), stopp.
Ausgabe schreiben: o ich-selbst, stopp.
Ausgabe schreiben: ( o tun erledigt ), stopp.

Programm aufräumen.

belegterSpeicher1 := (Programm speicher ? 0).


o := Objekt neu.
o2 := Objekt neu.
Ausgabe schreiben: o Nichts?, stopp.
Ausgabe schreiben: o typ, stopp.
Ausgabe schreiben: ( o gleich: o ), stopp.
Ausgabe schreiben: ( o gleich: o2 ), stopp.
Ausgabe schreiben: o ich-selbst, stopp.
Ausgabe schreiben: ( o tun erledigt ), stopp.

Programm aufräumen.
belegterSpeicher2 := (Programm speicher ? 0).


o := Objekt neu.
o2 := Objekt neu.
Ausgabe schreiben: o Nichts?, stopp.
Ausgabe schreiben: o typ, stopp.
Ausgabe schreiben: ( o gleich: o ), stopp.
Ausgabe schreiben: ( o gleich: o2 ), stopp.
Ausgabe schreiben: o ich-selbst, stopp.
Ausgabe schreiben: ( o tun erledigt ), stopp.

Programm aufräumen.
belegterSpeicher3 := (Programm speicher ? 0).



( belegterSpeicher1 = belegterSpeicher2 und: belegterSpeicher1 = belegterSpeicher3, und: belegterSpeicher2 = belegterSpeicher3 ) ja: {
	Ausgabe schreiben: ['Hier keine Speicherlecks'].
}, nein: {
	Ausgabe schreiben: ['Speicherleck...'].
}.
