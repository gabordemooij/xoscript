>> Tier := Objekt neu.
Tier wenn: ['machen'] tun: {
	>> tier := Objekt neu.
	tier wenn: ['lautGeben'] tun: {
		Ausgabe schreiben: eigen laut.
	}. <- tier.
}.
>> Katze := Objekt neu.
Katze wenn: ['machen'] tun: {
	>> katze := Tier machen.
	katze wenn: ['init'] tun: {
		eigen laut := ['meow!'].
	}.
	katze init. <- katze.
}.
>> tom := Katze machen.
tom lautGeben.
