


>> Kaffeemaschine := Objekt neu.
Kaffeemaschine wenn: ['order:'] tun: { :id
	>> coffee := ['Americano'].
	( id = 1 ) ja: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) ja: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) ja: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> EinfacheKaffeemaschine := Objekt neu.
EinfacheKaffeemaschine wenn: ['bestellung'] tun: { <- ['Schwarz']. }.
>> roteTasse := Kaffeemaschine order: 1.
Ausgabe schreiben: roteTasse, stopp.
roteTasse := ['Tee']. 
>> grüneTasse := Kaffeemaschine order: 0.
Ausgabe schreiben: grüneTasse, stopp.
>> gelbeTasse := Kaffeemaschine order: 1.
Ausgabe schreiben: gelbeTasse, stopp.
>> blaueTasse := Kaffeemaschine order: 0.
Ausgabe schreiben: blaueTasse, stopp.
>> plastikTasse := EinfacheKaffeemaschine bestellung.
plastikTasse := ['Limonade']. 
>> schwarzeTasse := EinfacheKaffeemaschine bestellung.
Ausgabe schreiben: schwarzeTasse, stopp.
schwarzeTasse anhängen: [' neee.... Bier. '].
>> orangeTasse := EinfacheKaffeemaschine bestellung.
Ausgabe schreiben: orangeTasse, stopp.
