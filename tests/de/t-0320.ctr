


>> CoffeeMachine := Objekt neu.
CoffeeMachine wenn: ['order:'] tun: { :id
	>> coffee := ['Americano'].
	( id = 1 ) ja: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) ja: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) ja: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Objekt neu.
SimpleCoffeeMachine wenn: ['order'] tun: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Ausgabe schreiben: redCup, stopp.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Ausgabe schreiben: greenCup, stopp.
>> yellowCup := CoffeeMachine order: 1.
Ausgabe schreiben: yellowCup, stopp.
>> blueCup := CoffeeMachine order: 0.
Ausgabe schreiben: blueCup, stopp.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Ausgabe schreiben: blackCup, stopp.
blackCup anhängen: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Ausgabe schreiben: orangeCup, stopp.
