>> Tier := Objekt neu.
>> Fabrik := Objekt neu.

Tier wenn: ['neu'] tun: {
	>> tier := selbst neu.
	tier sound: ['?']. <- tier.
}.

Tier wenn: ['sound:'] tun: { :s
	eigen laut := s.
}.

Tier wenn: ['laut'] tun: { <- eigen laut.
}.

>> Hund := Objekt neu.
>> Katze := Objekt neu.

Hund wenn: ['neu'] tun: { <- Tier neu sound: ['woof!'].
}.

Katze wenn: ['neu'] tun: { <- Tier neu sound: ['meow!'].
}.

Ausgabe schreiben: Hund neu laut, stopp.
Ausgabe schreiben: Katze neu laut, stopp.

Fabrik wenn: ['mischen:und:'] tun: { :biest1 :biest2 <- Tier neu sound: (
		( biest1 laut von: 0 länge: 2 ) +
		( biest2 laut von: 2 länge: 5 )
	).
}.

Ausgabe schreiben: (Fabrik mischen: Hund neu und: Katze neu) laut, stopp.
