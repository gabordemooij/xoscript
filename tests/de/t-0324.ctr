>> Animal := Objekt neu.
>> Factory := Objekt neu.

Animal wenn: ['neu'] tun: {
	>> animal := selbst neu.
	animal sound: ['?']. <- animal.
}.

Animal wenn: ['sound:'] tun: { :s
	eigen sound := s.
}.

Animal wenn: ['sound'] tun: { <- eigen sound.
}.

>> Dog := Objekt neu.
>> Cat := Objekt neu.

Dog wenn: ['neu'] tun: { <- Animal neu sound: ['woof!'].
}.

Cat wenn: ['neu'] tun: { <- Animal neu sound: ['meow!'].
}.

Ausgabe schreiben: Dog neu sound, stopp.
Ausgabe schreiben: Cat neu sound, stopp.

Factory wenn: ['mix:and:'] tun: { :beast1 :beast2 <- Animal neu sound: (
		( beast1 sound von: 0 länge: 2 ) +
		( beast2 sound von: 2 länge: 5 )
	).
}.

Ausgabe schreiben: (Factory mix: Dog neu and: Cat neu) sound, stopp.
