Ausgabe schreiben: ['Testobjekt'], stopp.
>> a := Objekt neu. 

a wenn: ['item:'] tun: { :fmt
	eigen fmt := fmt. 
}.

a wenn: ['posten'] tun: {
	<- eigen fmt.
}.

a item: ( Format neu: ['|%s|'] ).

Ausgabe schreiben: a posten, stopp.

>> alte-fmt-adresse := a posten prototyp speicheradresse.
a save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== SNAP NEU LADEN:'], stopp.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b posten prototyp speicheradresse = alte-fmt-adresse) ja: {
	Ausgabe schreiben: ['Objektverknüpfung wieder angehängt.'], stopp.
}.

Ausgabe schreiben: ( b posten anwenden: ['hello'] ), stopp.
