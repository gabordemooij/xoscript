>> Begrüßer := Objekt neu.
Begrüßer wenn: ['machen'] tun: {
	>> begrüßer := Objekt neu.
	begrüßer wenn: ['name:'] tun: { :name
		Ausgabe schreiben: ['einen Namen setzen'].
		eigen meinName := name.
	}.
	begrüßer wenn: ['begrüßungAusführen'] tun: {
		Ausgabe schreiben: ['Hello'].
		Ausgabe schreiben: eigen meinName.
	}.
	begrüßer wenn: ['grüßen'] tun: {
		selbst begrüßungAusführen.
	}. <- begrüßer.
}.
>> begrüßer := Begrüßer machen.
begrüßer name: ['Sonnenschein!'].
begrüßer grüßen.
