>> Greeter := Objekt neu.
Greeter wenn: ['make'] tun: {
	>> greeter := Objekt neu.
	greeter wenn: ['name:'] tun: { :name
		Ausgabe schreiben: ['setting a name'].
		eigen myName := name.
	}.
	greeter wenn: ['performGreeting'] tun: {
		Ausgabe schreiben: ['Hello'].
		Ausgabe schreiben: eigen myName.
	}.
	greeter wenn: ['greet'] tun: {
		selbst performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
