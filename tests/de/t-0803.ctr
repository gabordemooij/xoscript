Server init.

>> conn1 := Maria-DB neu host: ['localhost'],
	benutzername: ['xo'],
	passwort: ['pass123'],
	datenbankname: ['xobase'],
	verbinden.

>> conn2 := Maria-DB neu host: ['localhost'],
	benutzername: ['xo'],
	passwort: ['pass123'],
	datenbankname: ['xobase'],
	verbinden.
#...
>> del := conn1 abfrage: ['DELETE FROM book WHERE id > 0'].
{  del ausführen. conn1 bestätigen. } abfangen: { :e conn1 zurückrollen.  }, starten.

>> insert := conn1 abfrage: ['INSERT INTO book (id) VALUES(null)'].
insert ausführen.

>> anzahl := conn1 abfrage: ['SELECT COUNT(*) AS num FROM book'].
anzahl abrufen: { :row Ausgabe schreiben: row num, stopp. }.

# does not show up
# insert not committed on connection 1
>> anzahl := conn2 abfrage: ['SELECT COUNT(*) AS num FROM book'].
anzahl abrufen: { :row Ausgabe schreiben: row num, stopp. }.
