>> HTML := Objekt neu.
HTML wenn: ['antworten:'] tun: { :tagname 
	Ausgabe schreiben: (['<tag>'] tag: tagname), stopp.
}.
HTML wenn: ['antworten:und:'] tun: { :tagname :html 
	Ausgabe schreiben: (
		['<tag>innerHTML</tag>']
		tag: tagname - [':'],
		innerHTML: html
	), stopp.
}.
>> html := HTML neu.
html body h1: ['header'].

