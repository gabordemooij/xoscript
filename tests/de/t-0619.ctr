>> HTML := Objekt neu.
HTML wenn: ['antworten:'] tun: { :tag 
	Ausgabe schreiben: (['<tag>'] tag: tag), stopp.
}.
HTML wenn: ['antworten:und:'] tun: { :tag :html 
	Ausgabe schreiben: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), stopp.
}.
>> html := HTML neu.
html body h1: ['header'].

