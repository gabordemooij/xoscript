

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm speicherverwaltung: 0.

>> a := -2 absolut.
a := a atan.
a := a cos.
a := a log.
a := a sin.
a := a tan.


Programm aufräumen.

usedMemory1 := (Programm speicher ? 0).


a := -2 absolut.
a := a atan.
a := a cos.
a := a log.
a := a sin.
a := a tan.


Programm aufräumen.
usedMemory2 := (Programm speicher ? 0).


a := -2 absolut.
a := a atan.
a := a cos.
a := a log.
a := a sin.
