>> t := Ja.
(t = Ja) ja: { Ausgabe schreiben: ['T']. }.
(t = Nein) ja: { Ausgabe schreiben: ['F']. }.
Ausgabe schreiben: ['|'].
>> t := Nein.
(t = Ja) ja: { Ausgabe schreiben: ['T']. }.
(t = Nein) ja: { Ausgabe schreiben: ['F']. }.
Ausgabe schreiben: ['|'].
>> f := Ja.
(t = Ja und: f = Nein) ja: { Ausgabe schreiben: ['T']. }.
(t = Nein und: f = Ja) ja: { Ausgabe schreiben: ['F']. }.
Ausgabe schreiben: ['|'].
>> n := Nichts.
(n Nichts?) ja: { Ausgabe schreiben: ['T']. }.
(n Nichts?) nein: { Ausgabe schreiben: ['F']. }.
Ausgabe schreiben: ['|'].
(f Boolean?) ja: { Ausgabe schreiben: ['T']. }.
(f Boolean?) nein: { Ausgabe schreiben: ['F']. }.



