>> wiederholer := Objekt neu.
wiederholer wenn: ['antworten:'] tun: { :was
	Ausgabe schreiben: was + [' '].
}.
wiederholer wenn: ['antworten:und:'] tun: { :was :say
	Ausgabe schreiben: was, schreiben: say + [' '].
}.
wiederholer wenn: ['antworten:und:und:'] tun: { :was :say :mehr
	Ausgabe schreiben: was, schreiben: say, schreiben: mehr.
}.
wiederholer wiederholen.
wiederholer everything: ['Ich sage.'].
wiederholer and: ['I '] everything: ['tue.'].
