# Passwort-Hashing
Server init.

# Benutzer setzt ein Passwort
>> pw := ['pass123'].

# So speichern Sie es
>> hashwert := Tresor 
	passwort-hash: pw.

# Dann meldet sich der Benutzer an
# Versuch 1
>> a1 := ['abcd123'].
# Versuch 2
>> a2 := ['pass123'].

# Prüfen
>> a := Tresor 
	passwort-hash: hashwert prüfen: a1.
	# fehlgeschlagen 
>> b := Tresor
	passwort-hash: hashwert prüfen: a2.
	# ok!

Ausgabe schreiben: a, stopp.
Ausgabe schreiben: b, stopp.

