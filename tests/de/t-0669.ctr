# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Tresor 
	passwort-hash: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Tresor 
	passwort-hash: hash prüfen: a1.
	# fail 
>> b := Tresor
	passwort-hash: hash prüfen: a2.
	# ok!

Ausgabe schreiben: a, stopp.
Ausgabe schreiben: b, stopp.

