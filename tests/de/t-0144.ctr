



>> CoffeeGrounds := Objekt neu.
CoffeeGrounds wenn: ['extract'] tun: { <- ['coffee']. }.

>> CoffeeMachine := Objekt neu.
CoffeeMachine wenn: ['init'] tun: {
	eigen coffeegrounds := CoffeeGrounds neu.
}.
CoffeeMachine wenn: ['neu'] tun: { <- CoffeeMachine `new init.
}.

CoffeeMachine wenn: ['makeTea'] tun: { <- (eigen tealeaves extract). }.
CoffeeMachine wenn: ['makeCoffee'] tun: { <- (eigen coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine neu.

Ausgabe schreiben:
	coffeeDream 
	makeCoffee.

Ausgabe schreiben:
	coffeeDream 
	makeTea.
