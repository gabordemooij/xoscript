



>> Kaffeesatz := Objekt neu.
Kaffeesatz wenn: ['extrahieren'] tun: { <- ['coffee']. }.

>> Kaffeemaschine := Objekt neu.
Kaffeemaschine wenn: ['init'] tun: {
	eigen kaffeesatz := Kaffeesatz neu.
}.
Kaffeemaschine wenn: ['neu'] tun: { <- Kaffeemaschine `new init.
}.

Kaffeemaschine wenn: ['teeKochen'] tun: { <- (eigen teeblätter extrahieren). }.
Kaffeemaschine wenn: ['kaffeeKochen'] tun: { <- (eigen kaffeesatz extrahieren). }.

>> kaffeeTraum := Kaffeemaschine neu.

Ausgabe schreiben:
	kaffeeTraum 
	kaffeeKochen.

Ausgabe schreiben:
	kaffeeTraum 
	teeKochen.
