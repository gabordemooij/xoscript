


>> Deck := Liste neu.
Deck wenn: ['print'] tun: {
        >> len := selbst anzahl - 1.
        { :i
                >> len2 := selbst anzahl - 1.
                Ausgabe schreiben: ['len: '].
                Ausgabe schreiben: len, stopp.
                Ausgabe schreiben: ['len2: '].
                Ausgabe schreiben: len2, stopp.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
