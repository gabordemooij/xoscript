


>> Kartenstapel := Liste neu.
Kartenstapel wenn: ['drucken'] tun: {
        >> len := selbst anzahl - 1.
        { :i
                >> län2 := selbst anzahl - 1.
                Ausgabe schreiben: ['län: '].
                Ausgabe schreiben: len, stopp.
                Ausgabe schreiben: ['län2: '].
                Ausgabe schreiben: län2, stopp.
        } × len.
}.

>> d := Kartenstapel ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d drucken.
