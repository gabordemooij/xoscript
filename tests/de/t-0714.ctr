>> a := Objekt neu. 
a wenn: ['grüßen'] tun: { Ausgabe schreiben: ['willkommen!'], stopp. }.
a wenn: ['grüßen2'] tun: { Ausgabe schreiben: ['willkommen2!'], stopp. }.
a save-as: ['/tmp/a.bin'].

Ausgabe schreiben: ['========== SNAP NEU LADEN:'], stopp.
>> b := Objekt load-from: ['/tmp/a.bin'].
b grüßen2.