Ausgabe schreiben: ['Test object'], stopp.
>> a := Objekt neu. 

a wenn: ['state:'] tun: { :list
	eigen list := list. 
}.

a wenn: ['state'] tun: {
	Ausgabe schreiben: eigen list, stopp.
}.

a state: ( Liste neu ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== RELOADING SNAP:'], stopp.
>> b := Objekt load-from: ['/tmp/a.bin'].
b state.