Ausgabe schreiben: ['Testobjekt'], stopp.
>> a := Objekt neu. 

a wenn: ['state:'] tun: { :list
	eigen list := list. 
}.

a wenn: ['zustand'] tun: {
	Ausgabe schreiben: eigen list, stopp.
}.

a state: ( Liste neu ; ['listenposten'] ; ['posten2'] ).
a zustand.

a save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== SNAP NEU LADEN:'], stopp.
>> b := Objekt load-from: ['/tmp/a.bin'].
b zustand.