# Datenbank-Fehlermeldungen dürfen nicht als Formatstrings behandelt werden
Server init.

>> db := Maria-DB neu host: ['localhost'],
	benutzername: ['xo'],
	passwort: ['pass123'],
	datenbankname: ['xobase'],
	verbinden.

>> suchparameter := db abfrage: ['SELECT %% FROM'].
{ suchparameter ausführen. } abfangen: { :e
	Ausgabe schreiben: ( e enthält: ['%%'] ), stopp.
}, starten.
