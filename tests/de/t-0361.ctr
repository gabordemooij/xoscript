
>> XX := Objekt neu.
>> X := Objekt neu.

XX wenn: ['QQ'] tun: { <- 1. }.
XX wenn: ['Q'] tun: { <- 1. }.
XX wenn: ['QQ:'] tun: { <- 1. }.
XX wenn: ['QQ:QQ:'] tun: { <- 1. }.

X wenn: ['QQ'] tun: { <- 1. }.
X wenn: ['Q'] tun: { <- 1. }.
X wenn: ['QQ:'] tun: { <- 1. }.
X wenn: ['QQ:QQ:'] tun: { <- 1. }.

Ausgabe schreiben: (Programm XX), stopp.
Ausgabe schreiben: (Programm finden: ['XX']), stopp.
Ausgabe schreiben: (Programm finden: ['X']), stopp.

Ausgabe schreiben: (Programm XX: ['QQ']), stopp.
Ausgabe schreiben: (Programm XX: ['Q']), stopp.
Ausgabe schreiben: (Programm XX: ['QQ:']), stopp.
Ausgabe schreiben: (Programm XX: ['QQ:QQ:']), stopp.

Ausgabe schreiben: (Programm X: ['QQ']), stopp.
Ausgabe schreiben: (Programm X: ['Q']), stopp.
Ausgabe schreiben: (Programm X: ['QQ:']), stopp.
Ausgabe schreiben: (Programm X: ['QQ:QQ:']), stopp.

Ausgabe schreiben: (Programm X ['QQ']), stopp.
Ausgabe schreiben: (Programm X ['Q']), stopp.
Ausgabe schreiben: (Programm X ['QQ:']), stopp.
Ausgabe schreiben: (Programm X ['QQ:QQ:']), stopp.

Ausgabe schreiben: (Programm YY), stopp.
Ausgabe schreiben: (Programm finden: ['YY']), stopp.
Ausgabe schreiben: (Programm finden: ['Y']), stopp.

Ausgabe schreiben: (Programm YY: ['QQ']), stopp.
Ausgabe schreiben: (Programm YY: ['Q']), stopp.
Ausgabe schreiben: (Programm YY: ['QQ:']), stopp.
Ausgabe schreiben: (Programm YY: ['QQ:QQ:']), stopp.

Ausgabe schreiben: (Programm Y: ['QQ']), stopp.
Ausgabe schreiben: (Programm Y: ['Q']), stopp.
Ausgabe schreiben: (Programm Y: ['QQ:']), stopp.
Ausgabe schreiben: (Programm Y: ['QQ:QQ:']), stopp.

Ausgabe schreiben: (Programm Y ['QQ']), stopp.
Ausgabe schreiben: (Programm Y ['Q']), stopp.
Ausgabe schreiben: (Programm Y ['QQ:']), stopp.
Ausgabe schreiben: (Programm Y ['QQ:QQ:']), stopp.

Ausgabe schreiben: (Programm X: -1), stopp.
Ausgabe schreiben: (Programm X Nichts), stopp.

