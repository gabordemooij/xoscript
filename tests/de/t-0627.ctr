

# eine 64-Bit-Ganzzahl für exakte Berechnungen erzeugen
>> a := Int64 aus-text: ['123'].

# in Text umwandeln
Ausgabe schreiben: a, stopp.

# teilen
Ausgabe schreiben: a / (Int64 aus-text: ['3']), stopp.

# multiplizieren
Ausgabe schreiben: a * (Int64 aus-text: ['2']), stopp.

# addieren
Ausgabe schreiben: a + (Int64 aus-text: ['1']), stopp.

# subtrahieren
Ausgabe schreiben: a - (Int64 aus-text: ['2']), stopp.

# vergleichen
Ausgabe schreiben: ( a =   (Int64 aus-text: ['123'])), stopp.
Ausgabe schreiben: ( a !=: (Int64 aus-text: ['124'])), stopp.
Ausgabe schreiben: ( a <   (Int64 aus-text: ['124'])), stopp.
Ausgabe schreiben: ( a >   (Int64 aus-text: ['122'])), stopp.
Ausgabe schreiben: ( a >=: (Int64 aus-text: ['123'])), stopp.
Ausgabe schreiben: ( a <=: (Int64 aus-text: ['123'])), stopp.





	