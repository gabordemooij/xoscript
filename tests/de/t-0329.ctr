Ausgabe schreiben: ((Liste neu
	wenn: ['plaque:'] tun: { :x eigen o := x. },
	wenn: ['plaque']  tun: { <- eigen o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Liste ← 1)
	~ (Liste ← 1 ; 2)
	~ (Liste ← 1 ; 2 ; 3)
	~ (Liste ← 1 ; 2 ; 3 ; 4)
	~ (Liste ← 1 ; 2 ; 3 ; 4 ; 5)
) jedes: { :i :el
	{ Ausgabe schreiben: diese-aufgabe. } × el anzahl.
	Ausgabe stopp.
}) plaque, stopp.


