# ein Wert, der mit dem ersten Teil eines öffnenden Anführungszeichens endet, muss die Serialisierung überstehen
>> werte := Liste neu
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

werte jedes: { :i :value
	>> d := Wörterbuch neu.
	d setzen: value auf: ['k'].
	d setzen: ['second'] auf: ['j'].
	>> r := d code objekt.
	Ausgabe schreiben: r anzahl, stopp.
	Ausgabe schreiben: ( (r bei: ['k']) = value ), stopp.
}.
