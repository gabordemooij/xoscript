Ausgabe schreiben: ['Test object'], stopp.
>> a := Objekt neu. 

a wenn: ['item:'] tun: { :hexhelper
	eigen hexhelper := hexhelper. 
}.

a wenn: ['item'] tun: { <- eigen hexhelper.
}.

a item: Hx neu.

>> old-hexhelper-address := a item prototyp speicheradresse.
a save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== RELOADING SNAP:'], stopp.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp speicheradresse = old-hexhelper-address) ja: {
	Ausgabe schreiben: ['Object link re-attached.'], stopp.
}.
