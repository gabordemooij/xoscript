Liste wenn: ['summe'] tun: {
	>> gesamt := 0.
	selbst jedes: { :index :element
		gesamt hinzufügen: element.
	}. <- gesamt.
}.

>> a := Ja.



a wenn: ['text'] tun: {
	>> lösung := Nichts.
	( selbst = Ja ) ja: {
		lösung := ['Jep'].
	}, sonst: {
		lösung := ['Nö'].
	}. <- lösung.
}.

a wenn: ['zahl'] tun: {
	>> lösung := Nichts.
	( selbst = Ja ) ja: {
		lösung := 10.
	}, sonst: {
		lösung := 20.
	}. <- lösung.
}.

>> b := 666.

b wenn: ['text'] tun: { <- ['Teufel'].
}.

b wenn: ['wahrheitswert'] tun: { <- Nein.
}.


Ausgabe schreiben: a, stopp.  
Ausgabe schreiben: (90 + a), stopp. 
Ausgabe schreiben: b, stopp. 
Ausgabe schreiben: (Ja und: b), stopp.

a := Liste ← ['hello'] ; ['world'] ; Ja ; Nichts ; 666. 
a := a + ( Liste ← 1 ).
Ausgabe schreiben: a, stopp.
Ausgabe schreiben: ((Wörterbuch neu) setzen: Nichts auf: Nichts), stopp.
Ausgabe schreiben: a summe, stopp. 


{
	a wenn: ['text'] tun: { <- Nichts. }.
	a := [''] + a.
} abfangen: { :fehler
	Ausgabe schreiben: ['Fehler notiert: '] + fehler, stopp.
}, starten.



