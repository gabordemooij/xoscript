Liste wenn: ['sum'] tun: {
	>> total := 0.
	selbst jedes: { :index :element
		total hinzufügen: element.
	}. <- total.
}.

>> a := Ja.



a wenn: ['text'] tun: {
	>> answer := Nichts.
	( selbst = Ja ) ja: {
		answer := ['Yep'].
	}, sonst: {
		answer := ['Nope'].
	}. <- answer.
}.

a wenn: ['zahl'] tun: {
	>> answer := Nichts.
	( selbst = Ja ) ja: {
		answer := 10.
	}, sonst: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b wenn: ['text'] tun: { <- ['Devil'].
}.

b wenn: ['wahrheitswert'] tun: { <- Nein.
}.


Ausgabe schreiben: a, stopp.  
Ausgabe schreiben: (90 + a), stopp. 
Ausgabe schreiben: b, stopp. 
Ausgabe schreiben: (Ja und: b), stopp.

a := Liste ← ['hello'] ; ['world'] ; Ja ; Nichts ; 666. 
a := a + ( Liste ← 1 ).
Ausgabe schreiben: a, stopp.
Ausgabe schreiben: ((Wörterbuch neu) setzen: Nichts auf: Nichts), stopp.
Ausgabe schreiben: a sum, stopp. 


{
	a wenn: ['text'] tun: { <- Nichts. }.
	a := [''] + a.
} abfangen: { :error
	Ausgabe schreiben: ['Error noted: '] + error, stopp.
}, starten.



{
	a wenn: ['zahl'] tun: { <- Nichts. }.
	a := 3 × a.
} abfangen: { :error
	Ausgabe schreiben: ['Error noted: '] + error, stopp.
}, starten.


{
	a wenn: ['wahrheitswert'] tun: { <- Nichts. }.
	a := Ja und: a. 
} abfangen: { :error
	Ausgabe schreiben: ['Error noted: '] + error, stopp.
}, starten.





