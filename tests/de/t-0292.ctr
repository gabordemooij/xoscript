>> weingut := { <- (	Wörterbuch neu
		setzen: 2 auf: ['merlot'],
		setzen: 3 auf: ['malbec'],
		setzen: 4 auf: ['syrah']
	).
}.

Ausgabe schreiben: (((weingut starten) - ['nichts']) anzahl), stopp.
Ausgabe schreiben: (((weingut starten) - ['merlot']) anzahl), stopp.
Ausgabe schreiben: (((weingut starten) - ['malbec']) anzahl), stopp.
Ausgabe schreiben: (((weingut starten) - ['syrah']) anzahl), stopp.
Ausgabe schreiben: (((weingut starten) - ['merlot'] - ['malbec']) anzahl), stopp.
Ausgabe schreiben: (((weingut starten) - ['merlot'] - ['syrah']) anzahl), stopp.
Ausgabe schreiben: (((weingut starten) - ['malbec'] -['syrah']) anzahl), stopp.
Ausgabe schreiben: (((weingut starten) - ['malbec'] - ['syrah'] - ['merlot']) anzahl), stopp.

