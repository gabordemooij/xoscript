# Qualifikationen testen

Programm aufräumen.

>> Obst := Objekt neu.
Obst wenn: ['neu'] tun: {
	>> f := selbst neu.
	f apples: 0. <- f.
}.
Obst wenn: ['apples:'] tun: { :a eigen äpfel := a. }.
Obst wenn: ['äpfel'] tun: { <- eigen äpfel. }.
Obst wenn: ['+'] tun: { :f
	>> n := Obst neu.
	n apples: (f äpfel + eigen äpfel). <- n.
}.
Zahl wenn: ['äpfel'] tun: { <- ((Obst neu) apples: selbst).
}.

Obst wenn: ['text'] tun: { <- eigen äpfel + [' Äpfel '].
}.

>> q := 3 äpfel + 4 äpfel.
Ausgabe schreiben: q, stopp.




q := 3 äpfel + 4 äpfel.
Ausgabe schreiben: q, stopp.



q := 3 äpfel + 4 äpfel.
Ausgabe schreiben: q, stopp.


