# test qualifiers

Programm aufräumen.

>> Fruit := Objekt neu.
Fruit wenn: ['neu'] tun: {
	>> f := selbst neu.
	f apples: 0. <- f.
}.
Fruit wenn: ['apples:'] tun: { :a eigen apples := a. }.
Fruit wenn: ['apples'] tun: { <- eigen apples. }.
Fruit wenn: ['+'] tun: { :f
	>> n := Fruit neu.
	n apples: (f apples + eigen apples). <- n.
}.
Zahl wenn: ['apples'] tun: { <- ((Fruit neu) apples: selbst).
}.

Fruit wenn: ['text'] tun: { <- eigen apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Ausgabe schreiben: q, stopp.




q := 3 apples + 4 apples.
Ausgabe schreiben: q, stopp.



q := 3 apples + 4 apples.
Ausgabe schreiben: q, stopp.


