
>> city := Liste ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Liste ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature durch: city.
>> cities := weather einträge sortieren: { :a :b <- (a vergleichen: b). }.
>> temperatures := weather werte sortieren: { :a :b <- (a vergleichen: b) negativ?. }.

Ausgabe schreiben: (cities zusammenfügen: [',']), stopp.
Ausgabe schreiben: (temperatures zusammenfügen: [',']), stopp.
