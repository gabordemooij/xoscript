
>> stadt := Liste ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperatur := Liste ← ['15'] ; ['16'] ; ['15'].
>> wetter := temperatur durch: stadt.
>> städte := wetter einträge sortieren: { :a :b <- (a vergleichen: b). }.
>> temperaturen := wetter werte sortieren: { :a :b <- (a vergleichen: b) negativ?. }.

Ausgabe schreiben: (städte zusammenfügen: [',']), stopp.
Ausgabe schreiben: (temperaturen zusammenfügen: [',']), stopp.
