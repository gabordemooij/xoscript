Zahl wenn: ['fakultät'] tun: {
	>> gesamt := 1.
	{ :index gesamt multiplizieren-mit: (selbst - (index)). } × selbst. <- gesamt.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Ausgabe schreiben: a.
>> b := 2 + 3 fakultät.
Ausgabe schreiben: b.
>> c := 3 fakultät + 2.
Ausgabe schreiben: c.
>> d := 2 + (3 fakultät).
Ausgabe schreiben: d.
Ausgabe schreiben: 2 + 3 fakultät + 1.
