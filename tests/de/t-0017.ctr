Zahl wenn: ['factorial'] tun: {
	>> total := 1.
	{ :index total multiplizieren-mit: (selbst - (index)). } × selbst. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Ausgabe schreiben: a.
>> b := 2 + 3 factorial.
Ausgabe schreiben: b.
>> c := 3 factorial + 2.
Ausgabe schreiben: c.
>> d := 2 + (3 factorial).
Ausgabe schreiben: d.
Ausgabe schreiben: 2 + 3 factorial + 1.
