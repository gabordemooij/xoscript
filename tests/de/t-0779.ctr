Ausgabe schreiben: ['Test object'], stopp.
>> p := Pfad /tmp.
Ausgabe schreiben: p, stopp.
>> old-p-address := p prototyp speicheradresse.
p save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== RELOADING SNAP:'], stopp.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b prototyp speicheradresse = old-p-address) ja: {
	Ausgabe schreiben: ['Object link re-attached.'], stopp.
}.
Ausgabe schreiben: b, stopp.
