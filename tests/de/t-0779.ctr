Ausgabe schreiben: ['Testobjekt'], stopp.
>> p := Pfad /tmp.
Ausgabe schreiben: p, stopp.
>> alte-p-adresse := p prototyp speicheradresse.
p save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== SNAP NEU LADEN:'], stopp.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b prototyp speicheradresse = alte-p-adresse) ja: {
	Ausgabe schreiben: ['Objektverknüpfung wieder angehängt.'], stopp.
}.
Ausgabe schreiben: b, stopp.
