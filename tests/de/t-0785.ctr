Ausgabe schreiben: ['Test object'], stopp.
>> a := Objekt neu. 

a wenn: ['item:'] tun: { :moment
	eigen moment := moment. 
}.

a wenn: ['item'] tun: { <- eigen moment.
}.

>> today := Liste neu ; ( Moment neu zone: ['CEST'], jahr: 2026, monat: 7 ).
a item: today.
Ausgabe schreiben: a item ? 0, stopp.
a save-as: ['/tmp/a.bin'].
