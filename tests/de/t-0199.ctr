
Programm speicherverwaltung: 4.

>> Animal := Objekt neu.
Animal wenn: ['make'] tun: {
	>> animal := Objekt neu.
	animal wenn: ['makeSound'] tun: {
		Ausgabe schreiben: eigen sound.
	}. <- animal.
}.
>> Cat := Objekt neu.
Cat wenn: ['make'] tun: {
	>> cat := Animal make.
	cat wenn: ['init'] tun: {
		eigen sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
