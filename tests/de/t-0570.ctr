#Linux

 >> t := Moment neu.
 
t zone: ['Europe/Amsterdam'].
t jahr: 2020, monat: 8, tag: 2, stunde: 21, minute: 2, sekunde: 1.

>> a := t stunde.
>> ams := t zone.

t zone: ['US/Hawaii'].
>> b := t stunde.
>> hw := t zone.

Ausgabe
schreiben: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		entweder: ['later'] oder: ['earlier']
	)
),
stopp.
 