# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Programm shell-escape: ['abc'].
Ausgabe schreiben: c, stopp.
Ausgabe schreiben: ( Programm system: ['echo '] + c ), stopp.

c := Programm shell-escape: ['a'b'c'].
Ausgabe schreiben: c, stopp.
Ausgabe schreiben: ( Programm system: ['echo '] + c ), stopp.

c := Programm shell-escape: ['a\'c'].
Ausgabe schreiben: c, stopp.
Ausgabe schreiben: ( Programm system: ['echo '] + c ), stopp.