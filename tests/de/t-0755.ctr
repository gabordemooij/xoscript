Ausgabe schreiben: ['Test object'], stopp.
>> greeter := Objekt neu.
greeter wenn: ['name:'] tun: { :name
	eigen xname := name. 
}.
greeter wenn: ['greet'] tun: {
	Ausgabe schreiben: ['Hello '] + eigen xname, stopp.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== RELOADING SNAP:'], stopp.
>> b := Objekt load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
