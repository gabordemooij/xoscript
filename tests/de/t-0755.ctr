Ausgabe schreiben: ['Testobjekt'], stopp.
>> begrüßer := Objekt neu.
begrüßer wenn: ['name:'] tun: { :name
	eigen xname := name. 
}.
begrüßer wenn: ['grüßen'] tun: {
	Ausgabe schreiben: ['Hallo '] + eigen xname, stopp.
}.
begrüßer name: ['Sherlock'].
begrüßer save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== SNAP NEU LADEN:'], stopp.
>> b := Objekt load-from: ['/tmp/a.bin'].
b grüßen.
b name: ['Watson'], grüßen.
