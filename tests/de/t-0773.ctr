Ausgabe schreiben: ['Test object'], stopp.
>> a := Objekt neu. 
a wenn: ['item:'] tun: { :int64
	eigen int64 := int64. 
}.
a wenn: ['item'] tun: { <- eigen int64.
}.
a item: ( Int64 aus-text: ['9999'] ).
Ausgabe schreiben: a item, stopp.
>> old-int64-address := a item prototyp speicheradresse.
a save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== RELOADING SNAP:'], stopp.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b item prototyp speicheradresse = old-int64-address) ja: {
	Ausgabe schreiben: ['Object link re-attached.'], stopp.
}.
Ausgabe schreiben: ( b item ), stopp.
