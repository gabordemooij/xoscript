Ausgabe schreiben: ['Testobjekt'], stopp.
>> a := Objekt neu. 
a wenn: ['item:'] tun: { :int64
	eigen int64 := int64. 
}.
a wenn: ['posten'] tun: {
	<- eigen int64.
}.
a item: ( Int64 aus-text: ['9999'] ).
Ausgabe schreiben: a posten, stopp.
>> alte-int64-adresse := a posten prototyp speicheradresse.
a save-as: ['/tmp/a.bin'].
Ausgabe schreiben: ['========== SNAP NEU LADEN:'], stopp.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b posten prototyp speicheradresse = alte-int64-adresse) ja: {
	Ausgabe schreiben: ['Objektverknüpfung wieder angehängt.'], stopp.
}.
Ausgabe schreiben: ( b posten ), stopp.
