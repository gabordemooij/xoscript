>> Point := Objekt neu.
Point wenn: ['x-coordinate:'] tun: { :x eigen x := x. }.
Point wenn: ['y-coordinate:'] tun: { :y eigen y := y. }.
Point wenn: ['x-coordinate']  tun: { <- eigen x kopieren. }.
Point wenn: ['y-coordinate']  tun: { <- eigen y kopieren. }.

Point wenn: ['='] tun: { :other <- ( eigen x = other x-coordinate
		 und: eigen y = other y-coordinate ).
}.

>> pier := Point neu x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point neu x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point neu x-coordinate: 5, y-coordinate: 6.

Ausgabe schreiben: pier = town-hall, stopp.
Ausgabe schreiben: pier = restaurant, stopp.
