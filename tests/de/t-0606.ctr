>> Punkt := Objekt neu.
Punkt wenn: ['x-coordinate:'] tun: { :x eigen x := x. }.
Punkt wenn: ['y-coordinate:'] tun: { :y eigen y := y. }.
Punkt wenn: ['x-koordinate']  tun: { <- eigen x kopieren. }.
Punkt wenn: ['y-koordinate']  tun: { <- eigen y kopieren. }.

Punkt wenn: ['='] tun: { :anderer
	<- ( eigen x = anderer x-koordinate
		 und: eigen y = anderer y-koordinate ).
}.

>> anleger := Punkt neu x-coordinate: 5, y-coordinate: 6.
>> rathaus := Punkt neu x-coordinate: 7, y-coordinate: 1.
>> restaurant := Punkt neu x-coordinate: 5, y-coordinate: 6.

Ausgabe schreiben: anleger = rathaus, stopp.
Ausgabe schreiben: anleger = restaurant, stopp.
