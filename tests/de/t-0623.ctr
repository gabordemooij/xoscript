

>> g  := Server neu.
>> v  := Tresor neu.
>> ok := 0.

>> geheimnisse := Liste neu ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> kennwörter := geheimnisse kopieren.
kennwörter jedes: { :i :p
	geheimnisse jedes: { :n :s
		{
			>> verschlüsselt := v verschlüsseln: s schlüssel: p.
			>> entschlüsselt := v entschlüsseln: verschlüsselt schlüssel: p.
			(entschlüsselt = s) ja: {
				ok hinzufügen: 1.
			}, sonst: {
				Ausgabe schreiben: ['Ver-/Entschlüsselung fehlgeschlagen: '], stopp.
				Ausgabe schreiben: s, stopp.
				Ausgabe schreiben: ['verschlüsselt: '] + verschlüsselt, stopp.
				Ausgabe schreiben: ['entschlüsselt: '] + verschlüsselt, stopp.
				Programm ende.
			}.
		} abfangen: { :err
			(s = [''] oder: p = ['']) ja: {
				ok hinzufügen: 1.
			}, sonst: {
				Ausgabe schreiben: err, stopp.
				Programm ende.
			}.
		}, starten.
	}.
}.

Ausgabe schreiben: ( ok + [' Tresor-Verschlüsselungen getestet.'] ), stopp.