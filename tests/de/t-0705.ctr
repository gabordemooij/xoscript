

>> obj := Objekt neu.

obj wenn: ['greet'] tun: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj wenn: ['task'] tun: {
	eigen property := 123.
	{
		# try binds self/own to object instead of block
		Ausgabe schreiben: selbst greet.
		Ausgabe schreiben: eigen property.
		1 / 0.
	} abfangen: {
		Ausgabe schreiben: selbst greet.
		Ausgabe schreiben: eigen property.
		Ausgabe schreiben: ['ok'].
	}, versuchen.
}.

obj task.