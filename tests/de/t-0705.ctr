

>> obj := Objekt neu.

obj wenn: ['grüßen'] tun: {
	<- ['hi'].
}.

# muss hi123hi123ok ausgeben
obj wenn: ['aufgabe'] tun: {
	eigen eigenschaft := 123.
	{
		# versuchen bindet selbst/eigen an das Objekt statt an den Block
		Ausgabe schreiben: selbst grüßen.
		Ausgabe schreiben: eigen eigenschaft.
		1 / 0.
	} abfangen: {
		Ausgabe schreiben: selbst grüßen.
		Ausgabe schreiben: eigen eigenschaft.
		Ausgabe schreiben: ['ok'].
	}, versuchen.
}.

obj aufgabe.