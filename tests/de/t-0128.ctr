
Liste wenn: ['sum'] tun: {
	>> total := 0.
	selbst jedes: { :index :element
		total hinzufügen: element.
	}. <- total.
}.

>> a := Liste ← 9 ; 8 ; 7.
Ausgabe schreiben: (a sum), stopp. 
>> a := Liste ← 1 ; 9.
Ausgabe schreiben: (a sum), stopp. 
>> a := Liste ← ['o'] ; 2.
Ausgabe schreiben: (a sum), stopp. 
Ausgabe schreiben: (Liste neu sum), stopp. 
