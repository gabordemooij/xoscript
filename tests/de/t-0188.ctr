

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm speicherverwaltung: 0.

{ :i Ausgabe schreiben: i. } × 4.
Ausgabe stopp.
{ :i Ausgabe schreiben: (4 - i). } × 4.
Ausgabe stopp.
( 1 > 2 ) nein: { Ausgabe schreiben: ['BLOCK 1'], stopp. }.
( 2 > 1 ) ja:  { Ausgabe schreiben: ['BLOCK 2'], stopp. }.

>> i := 0.
{ Ausgabe schreiben: i. i hinzufügen: 1. } solange: { <- ( i < 3). }.
Ausgabe stopp.

i := 3.
{ Ausgabe schreiben: i. i := i - 1. } solange: { <- ( i > 0). }.
Ausgabe stopp.


Programm aufräumen.

usedMemory1 := (Programm speicher ? 0).


{ :i  Ausgabe schreiben: i. } × 4.
Ausgabe stopp.
{ :i  Ausgabe schreiben: (4 - i). } × 4.
Ausgabe stopp.
( 1 > 2 ) nein: { Ausgabe schreiben: ['BLOCK 1'], stopp. }.
( 2 > 1 ) ja:  { Ausgabe schreiben: ['BLOCK 2'], stopp. }.

>> i := 0.
{ Ausgabe schreiben: i. i hinzufügen: 1. } solange: { <- ( i < 3). }.
Ausgabe stopp.

i := 3.
{ Ausgabe schreiben: i. i := i - 1. } solange: { <- ( i > 0). }.
Ausgabe stopp.



Programm aufräumen.
usedMemory2 := (Programm speicher ? 0).


{ :i Ausgabe schreiben: i. } × 4.
Ausgabe stopp.
{ :i Ausgabe schreiben: (4 - i). } × 4.
Ausgabe stopp.
( 1 > 2 ) nein: { Ausgabe schreiben: ['BLOCK 1'], stopp. }.
( 2 > 1 ) ja:  { Ausgabe schreiben: ['BLOCK 2'], stopp. }.

>> i := 0.
{ Ausgabe schreiben: i. i hinzufügen: 1. } solange: { <- ( i < 3). }.
Ausgabe stopp.

i := 3.
{ Ausgabe schreiben: i. i := i - 1. } solange: { <- ( i > 0). }.
Ausgabe stopp.

Programm aufräumen.
usedMemory3 := (Programm speicher ? 0).



( usedMemory1 = usedMemory2 und: usedMemory1 = usedMemory3, und: usedMemory2 = usedMemory3 ) ja: {
	Ausgabe schreiben: ['No memory leaks here'].
}, nein: {
	Ausgabe schreiben: ['Leaking memory...'].
}.
