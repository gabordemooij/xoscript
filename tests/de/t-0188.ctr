

>> belegterSpeicher1 := 0.
>> belegterSpeicher2 := 0.
>> belegterSpeicher3 := 0.
>> belegterSpeicher4 := 0.

Programm speicherverwaltung: 0.

{ :i Ausgabe schreiben: i. } × 4.
Ausgabe stopp.
{ :i Ausgabe schreiben: (4 - i). } × 4.
Ausgabe stopp.
( 1 > 2 ) nein: { Ausgabe schreiben: ['BLOCK 1'], stopp. }.
( 2 > 1 ) ja:  { Ausgabe schreiben: ['BLOCK 2'], stopp. }.

>> i := 0.
{ Ausgabe schreiben: i. i hinzufügen: 1. } solange: { <- ( i < 3). }.
Ausgabe stopp.

i := 3.
{ Ausgabe schreiben: i. i := i - 1. } solange: { <- ( i > 0). }.
Ausgabe stopp.


Programm aufräumen.

belegterSpeicher1 := (Programm speicher ? 0).


{ :i  Ausgabe schreiben: i. } × 4.
Ausgabe stopp.
{ :i  Ausgabe schreiben: (4 - i). } × 4.
Ausgabe stopp.
( 1 > 2 ) nein: { Ausgabe schreiben: ['BLOCK 1'], stopp. }.
( 2 > 1 ) ja:  { Ausgabe schreiben: ['BLOCK 2'], stopp. }.

>> i := 0.
{ Ausgabe schreiben: i. i hinzufügen: 1. } solange: { <- ( i < 3). }.
Ausgabe stopp.

i := 3.
{ Ausgabe schreiben: i. i := i - 1. } solange: { <- ( i > 0). }.
Ausgabe stopp.



Programm aufräumen.
belegterSpeicher2 := (Programm speicher ? 0).


{ :i Ausgabe schreiben: i. } × 4.
Ausgabe stopp.
{ :i Ausgabe schreiben: (4 - i). } × 4.
Ausgabe stopp.
( 1 > 2 ) nein: { Ausgabe schreiben: ['BLOCK 1'], stopp. }.
( 2 > 1 ) ja:  { Ausgabe schreiben: ['BLOCK 2'], stopp. }.

>> i := 0.
{ Ausgabe schreiben: i. i hinzufügen: 1. } solange: { <- ( i < 3). }.
Ausgabe stopp.

i := 3.
{ Ausgabe schreiben: i. i := i - 1. } solange: { <- ( i > 0). }.
Ausgabe stopp.

Programm aufräumen.
belegterSpeicher3 := (Programm speicher ? 0).



( belegterSpeicher1 = belegterSpeicher2 und: belegterSpeicher1 = belegterSpeicher3, und: belegterSpeicher2 = belegterSpeicher3 ) ja: {
	Ausgabe schreiben: ['Hier keine Speicherlecks'].
}, nein: {
	Ausgabe schreiben: ['Speicherleck...'].
}.
