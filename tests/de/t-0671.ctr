# öffentlicher Schlüssel (zum Absichern von APIs usw.)
Server init.

# Schlüssel erzeugen
>> schlüsselpaar := Tresor schlüssel-erzeugen.

# privater (geheimer) Schlüssel
>> sk := schlüsselpaar erstes.

# öffentlicher Schlüssel
>> pk := schlüsselpaar letztes.

# eine Nachricht signieren
>> sig := Tresor signieren: ['abc'] mit: sk.

# Nachricht prüfen (ok)
Ausgabe schreiben: ( 
	Tresor
		prüfen: ['abc'] 
		signatur: sig 
		mit: pk 
), stopp.

# Nachricht prüfen (fehlgeschlagen)
Ausgabe schreiben: ( 
	Tresor 
		prüfen: ['abd'] 
		signatur: sig 
		mit: pk 
), stopp.