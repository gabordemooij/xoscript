# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Tresor schlüssel-erzeugen.

# private (secret) key
>> sk := keys erstes.

# public key
>> pk := keys letztes.

# sign a message
>> sig := Tresor signieren: ['abc'] mit: sk.

# check message (ok)
Ausgabe schreiben: ( 
	Tresor
		prüfen: ['abc'] 
		signatur: sig 
		mit: pk 
), stopp.

# check message (fail)
Ausgabe schreiben: ( 
	Tresor 
		prüfen: ['abd'] 
		signatur: sig 
		mit: pk 
), stopp.