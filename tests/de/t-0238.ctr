Text wenn: ['auswerten'] tun: {
	>> code := Datei neu: ['/tmp/eval.ctr'].
	code schreiben: (selbst text + ['.']).
	Programm verwenden: ['/tmp/eval.ctr'].
}.

>> a := Liste ← 1 ; 2 ; 3.
>> b := (a text).

Ausgabe schreiben: b, stopp. 
(['b := '] + b) auswerten.

Ausgabe schreiben: b ? 2, stopp. 

Ausgabe schreiben: (( Liste ← 1 ; 2 ; 3 )), stopp. 

Ausgabe schreiben: ((Wörterbuch neu) setzen: 1 auf: 2), stopp. 

>> x := ( (Liste ← 1 ; ( Liste ← 9 ) ; Ja ) ) text.
Ausgabe schreiben: x, stopp. 
(['x := '] + x) auswerten.

Ausgabe schreiben: x ? 1 ? 0, stopp. 

>> y := (Wörterbuch neu) setzen: (Liste ← 1) auf: (Liste ← 2).
Ausgabe schreiben: y, stopp. 

(['y := '] + y) text auswerten.

Ausgabe schreiben: (y bei: (Liste ← 2) text ), stopp.

Ausgabe schreiben: (Liste neu), stopp. 
Ausgabe schreiben: (Wörterbuch neu), stopp. 
