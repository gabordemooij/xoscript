# Normalfall
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> pfad := ['/tmp/dat.csv'].
>> csv := Datei neu: pfad.
csv schreiben: s.

# akzeptiert CRLF LF CR, unterschiedliche Zeilenlängen
csv trennzeichen: [';'] anführungszeichen: ['"'] zeilen: { :line
	Programm aufräumen.
	Ausgabe schreiben: line, stopp.
	Programm aufräumen.
}.

# ungleiche Zeilen
s anhängen: ['\njustone'].
csv schreiben: s.
{
	csv trennzeichen: [';'] anführungszeichen: ['"'] zeilen: { :line
		Ausgabe schreiben: line, stopp.
	}.
} abfangen: { :e 
	Ausgabe schreiben: e, stopp.
}, starten.

# ungültiges Format
s := ['"he"llo";world'].
csv schreiben: s.
{
	csv trennzeichen: [';'] anführungszeichen: ['"'] zeilen: { :line
		Ausgabe schreiben: line, stopp.
	}.
} abfangen: { :e 
	Ausgabe schreiben: e, stopp.
}, starten.
