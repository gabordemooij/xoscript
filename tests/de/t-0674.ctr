# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> pfad := ['/tmp/dat.csv'].
>> csv := Datei neu: pfad.
csv schreiben: s.

# accepts CRLF LF CR, varying row length
csv trennzeichen: [';'] anführungszeichen: ['"'] zeilen: { :line
	Programm aufräumen.
	Ausgabe schreiben: line, stopp.
	Programm aufräumen.
}.

# unequal lines
s anhängen: ['\njustone'].
csv schreiben: s.
{
	csv trennzeichen: [';'] anführungszeichen: ['"'] zeilen: { :line
		Ausgabe schreiben: line, stopp.
	}.
} abfangen: { :e 
	Ausgabe schreiben: e, stopp.
}, starten.

# invalid format
s := ['"he"llo";world'].
csv schreiben: s.
{
	csv trennzeichen: [';'] anführungszeichen: ['"'] zeilen: { :line
		Ausgabe schreiben: line, stopp.
	}.
} abfangen: { :e 
	Ausgabe schreiben: e, stopp.
}, starten.
