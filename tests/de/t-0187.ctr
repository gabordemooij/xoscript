Zahl wenn: ['factorial'] tun: {
	>> total := 1.
	{ :index total multiplizieren-mit: (selbst - index). } × selbst. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm speicherverwaltung: 0.

{
2 exponent factorial.
Ausgabe schreiben: (11 modulo: 3), stopp.
Ausgabe schreiben: (3.4 gerundet), stopp.
Ausgabe schreiben: (7.1 aufgerundet), stopp.
Ausgabe schreiben: (7.9 abgerundet), stopp.
}
starten.

Programm aufräumen.

usedMemory1 := (Programm speicher ? 0).

{
2 exponent factorial.
Ausgabe schreiben: (11 modulo: 3), stopp.
Ausgabe schreiben: (3.4 gerundet), stopp.
Ausgabe schreiben: (7.1 aufgerundet), stopp.
Ausgabe schreiben: (7.9 abgerundet), stopp.
}
starten.

Programm aufräumen.
usedMemory2 := (Programm speicher ? 0).


{
2 exponent factorial.
Ausgabe schreiben: (11 modulo: 3), stopp.
Ausgabe schreiben: (3.4 gerundet), stopp.
Ausgabe schreiben: (7.1 aufgerundet), stopp.
Ausgabe schreiben: (7.9 abgerundet), stopp.
} starten.

Programm aufräumen.
usedMemory3 := (Programm speicher ? 0).



( usedMemory1 = usedMemory2 und: usedMemory1 = usedMemory3, und: usedMemory2 = usedMemory3 ) ja: {
	Ausgabe schreiben: ['No memory leaks here'].
}, nein: {
	Ausgabe schreiben: ['Leaking memory...'].
}.
