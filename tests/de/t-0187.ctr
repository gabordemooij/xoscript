Zahl wenn: ['fakultät'] tun: {
	>> gesamt := 1.
	{ :index gesamt multiplizieren-mit: (selbst - index). } × selbst. <- gesamt.
}.

>> belegterSpeicher1 := 0.
>> belegterSpeicher2 := 0.
>> belegterSpeicher3 := 0.
>> belegterSpeicher4 := 0.

Programm speicherverwaltung: 0.

{
2 exponent fakultät.
Ausgabe schreiben: (11 modulo: 3), stopp.
Ausgabe schreiben: (3.4 gerundet), stopp.
Ausgabe schreiben: (7.1 aufgerundet), stopp.
Ausgabe schreiben: (7.9 abgerundet), stopp.
}
starten.

Programm aufräumen.

belegterSpeicher1 := (Programm speicher ? 0).

{
2 exponent fakultät.
Ausgabe schreiben: (11 modulo: 3), stopp.
Ausgabe schreiben: (3.4 gerundet), stopp.
Ausgabe schreiben: (7.1 aufgerundet), stopp.
Ausgabe schreiben: (7.9 abgerundet), stopp.
}
starten.

Programm aufräumen.
belegterSpeicher2 := (Programm speicher ? 0).


{
2 exponent fakultät.
Ausgabe schreiben: (11 modulo: 3), stopp.
Ausgabe schreiben: (3.4 gerundet), stopp.
Ausgabe schreiben: (7.1 aufgerundet), stopp.
Ausgabe schreiben: (7.9 abgerundet), stopp.
} starten.

Programm aufräumen.
belegterSpeicher3 := (Programm speicher ? 0).



( belegterSpeicher1 = belegterSpeicher2 und: belegterSpeicher1 = belegterSpeicher3, und: belegterSpeicher2 = belegterSpeicher3 ) ja: {
	Ausgabe schreiben: ['Hier keine Speicherlecks'].
}, nein: {
	Ausgabe schreiben: ['Speicherleck...'].
}.
