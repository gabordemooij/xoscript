

Liste wenn: ['fixture:'] tun: { :f
	eigen fixture := f.
}.

Liste wenn: ['anzahl'] tun: { <- eigen fixture.
}.

Liste wenn: ['aantal'] tun: { <- eigen fixture.
}.


>> x := Nichts.
{

	x := ['hello'] 
	ersetzen:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] zeichen: 2)
			)
		)
	mit: (
		(['...hal'] + ['lo']) 
			großbuchstaben 
			lowecase 
			großbuchstaben 
			versatz: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Liste ← 0 ; 1 ; 4; 9 ; (Liste ← 0 ; 3; 1) ; 4
							) vorletztes
						) ? 1
					) + 
					((Liste ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					anzahl
				)
			)
	).

} × 10.
Ausgabe schreiben: x, stopp.

