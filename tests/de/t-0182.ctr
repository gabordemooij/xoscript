

>> belegterSpeicher1 := 0.
>> belegterSpeicher2 := 0.
>> belegterSpeicher3 := 0.
>> belegterSpeicher4 := 0.

Programm speicherverwaltung: 0.

>> txt := ['1.6'].
>> n := txt zahl.
>> t := txt wahrheitswert.
Ausgabe schreiben: n, stopp.
Ausgabe schreiben: t, stopp.
Ausgabe schreiben: n typ, stopp.
Ausgabe schreiben: t typ, stopp.

Programm aufräumen.

belegterSpeicher1 := (Programm speicher ? 0).


txt := ['1.6'].
n := txt zahl.
t := txt wahrheitswert.
Ausgabe schreiben: n, stopp.
Ausgabe schreiben: t, stopp.
Ausgabe schreiben: n typ, stopp.
Ausgabe schreiben: t typ, stopp.

Programm aufräumen.
belegterSpeicher2 := (Programm speicher ? 0).


txt := ['1.6'].
n := txt zahl.
t := txt wahrheitswert.
Ausgabe schreiben: n, stopp.
Ausgabe schreiben: t, stopp.
Ausgabe schreiben: n typ, stopp.
Ausgabe schreiben: t typ, stopp.

Programm aufräumen.
belegterSpeicher3 := (Programm speicher ? 0).



( belegterSpeicher1 = belegterSpeicher2 und: belegterSpeicher1 = belegterSpeicher3, und: belegterSpeicher2 = belegterSpeicher3 ) ja: {
	Ausgabe schreiben: ['Hier keine Speicherlecks'].
}, nein: {
	Ausgabe schreiben: ['Speicherleck...'].
}.
