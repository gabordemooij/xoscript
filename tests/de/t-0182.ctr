

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm speicherverwaltung: 0.

>> txt := ['1.6'].
>> n := txt zahl.
>> t := txt wahrheitswert.
Ausgabe schreiben: n, stopp.
Ausgabe schreiben: t, stopp.
Ausgabe schreiben: n typ, stopp.
Ausgabe schreiben: t typ, stopp.

Programm aufräumen.

usedMemory1 := (Programm speicher ? 0).


txt := ['1.6'].
n := txt zahl.
t := txt wahrheitswert.
Ausgabe schreiben: n, stopp.
Ausgabe schreiben: t, stopp.
Ausgabe schreiben: n typ, stopp.
Ausgabe schreiben: t typ, stopp.

Programm aufräumen.
usedMemory2 := (Programm speicher ? 0).


txt := ['1.6'].
n := txt zahl.
t := txt wahrheitswert.
Ausgabe schreiben: n, stopp.
Ausgabe schreiben: t, stopp.
Ausgabe schreiben: n typ, stopp.
Ausgabe schreiben: t typ, stopp.

Programm aufräumen.
usedMemory3 := (Programm speicher ? 0).



( usedMemory1 = usedMemory2 und: usedMemory1 = usedMemory3, und: usedMemory2 = usedMemory3 ) ja: {
	Ausgabe schreiben: ['No memory leaks here'].
}, nein: {
	Ausgabe schreiben: ['Leaking memory...'].
}.
