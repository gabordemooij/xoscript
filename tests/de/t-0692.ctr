Server init.

Ausgabe schreiben: (
	Muster neu: ['^\\w+$'],
	treffer: ['test@example.com'] 
), stopp. # 0 match, fails on @ and .

Ausgabe schreiben: (
	Muster neu: ['^[^@]+@[^\.]+\.\\w+$'],
	treffer: ['test@example.com'] 
), stopp. # 1 match

Ausgabe schreiben: (
	Muster neu: ['[^@]+@[^\.]+\.\\w+'],
	treffer: ['test@example.com'] 
), stopp. # 1 match

Ausgabe schreiben: (
	Muster neu: ['([^@]+)@([^\.]+)\.\\w+'],
	treffer: ['test@example.com'] 
), stopp. # 1 match, groups dont matter

Ausgabe schreiben: (
	Muster neu: ['[a-z]'],
	treffer: ['test@example.com'] 
), stopp. # 14 matches

Ausgabe schreiben: (
	Muster neu: ['.*'],
	treffer: ['test@example.com'] 
), stopp. # 1 match (all)

Ausgabe schreiben: (
	Muster neu: ['(.*)'],
	treffer: ['test@example.com'] 
), stopp. # 1 match (all)

Ausgabe schreiben: (
	Muster neu: ['\\s*[^@]+@[^\.]+\.\\w+'],
	treffer: ['test@example.com'] 
), stopp. # 1 match, prefix space optional, gets ignored