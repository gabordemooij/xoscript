Server init.

Ausgabe schreiben: (
	Muster neu: ['^\\w+$'],
	treffer: ['test@example.com'] 
), stopp. # 0 Treffer, scheitert an @ und .

Ausgabe schreiben: (
	Muster neu: ['^[^@]+@[^\.]+\.\\w+$'],
	treffer: ['test@example.com'] 
), stopp. # 1 Treffer

Ausgabe schreiben: (
	Muster neu: ['[^@]+@[^\.]+\.\\w+'],
	treffer: ['test@example.com'] 
), stopp. # 1 Treffer

Ausgabe schreiben: (
	Muster neu: ['([^@]+)@([^\.]+)\.\\w+'],
	treffer: ['test@example.com'] 
), stopp. # 1 Treffer, Gruppen spielen keine Rolle

Ausgabe schreiben: (
	Muster neu: ['[a-z]'],
	treffer: ['test@example.com'] 
), stopp. # 14 Treffer

Ausgabe schreiben: (
	Muster neu: ['.*'],
	treffer: ['test@example.com'] 
), stopp. # 1 Treffer (alles)

Ausgabe schreiben: (
	Muster neu: ['(.*)'],
	treffer: ['test@example.com'] 
), stopp. # 1 Treffer (alles)

Ausgabe schreiben: (
	Muster neu: ['\\s*[^@]+@[^\.]+\.\\w+'],
	treffer: ['test@example.com'] 
), stopp. # 1 Treffer, Leerzeichen davor optional, wird ignoriert