Server init.

>> DB := Maria-DB neu host: ['localhost'],
	benutzername: ['xo'],
	passwort: ['pass123'],
	datenbankname: ['xobase'],
	verbinden.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB abfrage: SQL.

# now you don't have to set DB
query2 abrufen: { :row
	Ausgabe schreiben: row world, stopp.
}.
