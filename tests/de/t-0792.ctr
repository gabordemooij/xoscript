Server init.

>> DB := Maria-DB neu host: ['localhost'],
	benutzername: ['xo'],
	passwort: ['pass123'],
	datenbankname: ['xobase'],
	verbinden.
	
>> SQL := ['SELECT "hello" AS "world" '].

# ein schnellerer Weg, Abfrage aus DB holen:
>> abfrage2 := DB abfrage: SQL.

# jetzt müssen Sie DB nicht festlegen
abfrage2 abrufen: { :reihe
	Ausgabe schreiben: reihe world, stopp.
}.
