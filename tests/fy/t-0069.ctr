

Tekst by: ['html'] dwaan: { <- (
		sels
		ferfange: ['&'] troch: ['&amp;'],
		ferfange: ['<'] troch: ['&lt;'],
		ferfange: ['>'] troch: ['&gt;'],
		ferfange: ['"'] troch: ['&quot;']
	).
}.


Utfier skriuwe: ([' links ôfknipt '] ynkoartsje) + [' '] + ( ['en rjochts ôfknipt'] ynkoartsje) + ['!'], nije-rigel.
Utfier skriuwe: ['<html>"html & entities"</html>'] html.
