Server init.
>> f := Formaat nĳ: ['%d'].
>> a := Blob nĳ: 4.
a bytes: ( Rige nĳ ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob nĳ: 4.
b bytes: ( Rige nĳ ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a fan: 0 lingte: 3, elk: { :i :byte
	Utfier skriuwe: ( f tapasse-int: byte ), nije-rigel.
}.
a ^ b.
a fan: 0 lingte: 3, elk: { :i :byte
	Utfier skriuwe: ( f tapasse-int: byte ), nije-rigel.
}.
a ^ b.
a fan: 0 lingte: 3, elk: { :i :byte
	Utfier skriuwe: ( f tapasse-int: byte ), nije-rigel.
}.
a frijjaan.
b frijjaan.

{ a ^ Objekt. } fange: { :e Utfier skriuwe: e, nije-rigel. }, begjinne.
