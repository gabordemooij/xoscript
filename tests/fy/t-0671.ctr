# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Klûs kaaien-oanmeitsje.

# private (secret) key
>> sk := keys earste.

# public key
>> pk := keys lêste.

# sign a message
>> sig := Klûs ûndertekenje: ['abc'] mei: sk.

# check message (ok)
Utfier skriuwe: ( 
	Klûs
		kontrolearje: ['abc'] 
		ûndertekening: sig 
		mei: pk 
), nije-rigel.

# check message (fail)
Utfier skriuwe: ( 
	Klûs 
		kontrolearje: ['abd'] 
		ûndertekening: sig 
		mei: pk 
), nije-rigel.