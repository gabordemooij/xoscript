# publike kaai (om API's ensfh. te befeiligjen)
Server init.

# kaaien oanmeitsje
>> kaaien := Klûs kaaien-oanmeitsje.

# privee (geheime) kaai
>> gk := kaaien earste.

# publike kaai
>> pk := kaaien lêste.

# in berjocht ûndertekenje
>> ûndt := Klûs ûndertekenje: ['abc'] mei: gk.

# berjocht kontrolearje (ok)
Utfier skriuwe: ( 
	Klûs
		kontrolearje: ['abc'] 
		ûndertekening: ûndt 
		mei: pk 
), nije-rigel.

# berjocht kontrolearje (mislearre)
Utfier skriuwe: ( 
	Klûs 
		kontrolearje: ['abd'] 
		ûndertekening: ûndt 
		mei: pk 
), nije-rigel.