# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Patroan nĳ: pattern.
	p oerienkomst: subject dwaan: { :m :g
		Utfier skriuwe: g telle, skriuwe: [' '], skriuwe: (g gearfoegje: ['|']), nije-rigel. <- m.
	}.
}.
show tapasse: ['(a)|(b)'] en: ['b'].
show tapasse: ['(a)|(b)'] en: ['a'].
show tapasse: ['(x)?y'] en: ['y'].
show tapasse: ['(x)?(y)(z)?'] en: ['xy'].
