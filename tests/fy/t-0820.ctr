# in groep dy't gjin diel fan de oerienkomst is moat net crashe en moat de groepsnûmers hâlde
Server init.
>> toane := { :sykpatroan :subject
	>> p := Patroan nĳ: sykpatroan.
	p oerienkomst: subject dwaan: { :m :g
		Utfier skriuwe: g telle, skriuwe: [' '], skriuwe: (g gearfoegje: ['|']), nije-rigel.
		<- m.
	}.
}.
toane tapasse: ['(a)|(b)'] en: ['b'].
toane tapasse: ['(a)|(b)'] en: ['a'].
toane tapasse: ['(x)?y'] en: ['y'].
toane tapasse: ['(x)?(y)(z)?'] en: ['xy'].
