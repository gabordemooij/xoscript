>> randomizer := { :a :b
	>> minimum := ( a < b ) of: a of: b.
	>> maksimum := ( a > b ) of: a of: b.
	>> x := Neat.
	{
		x := Getal tusken: a en: b.
		((x < minimum) of: (x > maksimum)) ja: { 
			Utfier skriuwe: (['Invalid value!']).
			Programma ein.
		}.
	} 
	× 100. <- x.
}.
