Utfier skriuwe: ['1,2,3,4,5,6,7,8,9,A,'], nije-rigel.
>> Berik := Objekt nĳ.
Berik by: ['initialize:'] dwaan: { :x eigen eigenskip := x. }.
Berik by: ['bekrêftigje'] dwaan: { Utfier skriuwe: [',']. }.
Berik by: ['test'] dwaan: {
	Utfier skriuwe: eigen eigenskip.
	sels bekrêftigje.
	( 1 = 1 ) ja: { Utfier skriuwe: eigen eigenskip. sels bekrêftigje. }.
	( 1 = 0 ) nee: { Utfier skriuwe: eigen eigenskip. sels bekrêftigje. }.
	>> y := 2. { Utfier skriuwe: eigen eigenskip. sels bekrêftigje. } wylst: { y ôflûke: 1. <- (y > 0). }.
	{ Utfier skriuwe: eigen eigenskip. sels bekrêftigje. } × 1.
	(Rige ← 1) elk: {  Utfier skriuwe: eigen eigenskip. sels bekrêftigje. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo eigen sortearring ymplemintearje, dizze test mislearret troch ferskillend oantal iteraasjes per platfoarm
	(List nĳ one: ['item']) elk: { Utfier skriuwe: eigen eigenskip. sels bekrêftigje. }.
	{ 1 ÷ 0. } fange: { Utfier skriuwe: eigen eigenskip. sels bekrêftigje. }, begjinne.
	Utfier nije-rigel.
}.
>> berik1 := Berik nĳ.
berik1 initialize: ['X'].
berik1 test.
>> funksjeblok := { 
	eigen eigenskip := ['Y'].
	Utfier skriuwe: eigen eigenskip.
	sels bekrêftigje.
	( 1 = 1 ) ja: { Utfier skriuwe: eigen eigenskip. sels bekrêftigje. }.
	( 1 = 0 ) nee: { Utfier skriuwe: eigen eigenskip. sels bekrêftigje. }.
	>> y := 2. { Utfier skriuwe: eigen eigenskip. sels bekrêftigje. } wylst: { y ôflûke: 1. <- (y > 0). }.
	{ Utfier skriuwe: eigen eigenskip. sels bekrêftigje. } × 1.
	(Rige ← 1) elk: {  Utfier skriuwe: eigen eigenskip. sels bekrêftigje. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(List nĳ one: ['item']) elk: { Utfier skriuwe: eigen eigenskip. sels bekrêftigje. }.
	{ 1 ÷ 0. } fange: { Utfier skriuwe: eigen eigenskip. sels bekrêftigje. }, begjinne.
	Utfier nije-rigel.
}.
funksjeblok by: ['bekrêftigje'] dwaan: { Utfier skriuwe: [',']. }.
funksjeblok tapasse: 1 en: 2.
