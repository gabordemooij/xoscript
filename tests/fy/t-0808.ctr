# klûskaaien en ûndertekeningen dy't te lang dekodearje meie de stack net oerrinne litte
Server init.

>> kaaien := Klûs kaaien-oanmeitsje.
>> gk := kaaien earste.
>> pk := kaaien lêste.
>> ûndt := Klûs ûndertekenje: ['abc'] mei: gk.

# 88 tekens sûnder padding dekodearje nei 66 bytes
>> lang := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 tekens sûnder padding dekodearje nei 33 bytes
>> koart := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Klûs ûndertekenje: ['abc'] mei: lang. } fange: { :e
	Utfier skriuwe: e, nije-rigel.
}, begjinne.

{ Klûs kontrolearje: ['abc'] ûndertekening: lang mei: pk. } fange: { :e
	Utfier skriuwe: e, nije-rigel.
}, begjinne.

{ Klûs kontrolearje: ['abc'] ûndertekening: ûndt mei: koart. } fange: { :e
	Utfier skriuwe: e, nije-rigel.
}, begjinne.
