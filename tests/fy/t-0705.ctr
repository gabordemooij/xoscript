

>> obj := Objekt nĳ.

obj by: ['greet'] dwaan: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj by: ['task'] dwaan: {
	eigen property := 123.
	{
		# try binds self/own to object instead of block
		Utfier skriuwe: sels greet.
		Utfier skriuwe: eigen property.
		1 / 0.
	} fange: {
		Utfier skriuwe: sels greet.
		Utfier skriuwe: eigen property.
		Utfier skriuwe: ['ok'].
	}, besykje.
}.

obj task.