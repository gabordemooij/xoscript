

>> obj := Objekt nĳ.

obj by: ['groetsje'] dwaan: {
	<- ['hoi'].
}.

# moat hi123hi123ok útfiere
obj by: ['taak'] dwaan: {
	eigen eigenskip := 123.
	{
		# besykje bynt sels/eigen oan it objekt ynstee fan oan it blok
		Utfier skriuwe: sels groetsje.
		Utfier skriuwe: eigen eigenskip.
		1 / 0.
	} fange: {
		Utfier skriuwe: sels groetsje.
		Utfier skriuwe: eigen eigenskip.
		Utfier skriuwe: ['ok'].
	}, besykje.
}.

obj taak.