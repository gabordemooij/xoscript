#Linux
>> clock := Momint nĳ.
clock sône: ['UTC-1'].
clock jier: 1981, moanne: 1, dei: 5,
      oere: 13, minút: 15, sekonde: 13.

Utfier skriuwe: clock, nije-rigel.
clock sône: ['UTC+0'].

Utfier skriuwe: (
	(clock jier gewoan) + ['-'] + (clock moanne) + ['-'] + (clock dei) + [' '] +
	(clock oere) + [':'] + (clock minút) + [':'] + (clock sekonde) + [' '] +
	['W'] + (clock wike) + (clock sône)
), nije-rigel.


clock sône: ['UTC-1'].
Utfier skriuwe: (
	(clock jier gewoan) + ['-'] + (clock moanne) + ['-'] + (clock dei) + [' '] +
	(clock oere) + [':'] + (clock minút) + [':'] + (clock sekonde) + [' '] +
	['W'] + (clock wike) + (clock sône)
), nije-rigel.
