#Linux
>> klok := Momint nĳ.
klok sône: ['UTC-1'].
klok jier: 1981, moanne: 1, dei: 5,
      oere: 13, minút: 15, sekonde: 13.

Utfier skriuwe: klok, nije-rigel.
klok sône: ['UTC+0'].

Utfier skriuwe: (
	(klok jier gewoan) + ['-'] + (klok moanne) + ['-'] + (klok dei) + [' '] +
	(klok oere) + [':'] + (klok minút) + [':'] + (klok sekonde) + [' '] +
	['W'] + (klok wike) + (klok sône)
), nije-rigel.


klok sône: ['UTC-1'].
Utfier skriuwe: (
	(klok jier gewoan) + ['-'] + (klok moanne) + ['-'] + (klok dei) + [' '] +
	(klok oere) + [':'] + (klok minút) + [':'] + (klok sekonde) + [' '] +
	['W'] + (klok wike) + (klok sône)
), nije-rigel.
