>> keppeling1 := List nĳ.
>> kaai1 := Rige nĳ.
>> kaai2 := Rige nĳ.

keppeling1
	set: ['hello'] by: kaai1,
	set: ['world'] by: kaai2.


Utfier
	skriuwe: ['Map #1 contains: '] + (keppeling1 by: kaai1),
	skriuwe: [' en '] + (keppeling1 by: kaai2), nije-rigel.

>> KaaiberRige := Rige nĳ.
KaaiberRige by: ['neiTekst'] dwaan: { <- (sels telle) neiTekst.
}.

>> map2 := List nĳ.
kaai1 := KaaiberRige nĳ.
kaai2 := KaaiberRige nĳ.

kaai1 tafoegje: 1.

map2
	set: ['hello'] by: kaai1,
	set: ['world'] by: kaai2.

Utfier
	skriuwe: ['Map #2 contains: '] + (map2 by: kaai1),
	skriuwe: [' en '] + (map2 by: kaai2), nije-rigel.
