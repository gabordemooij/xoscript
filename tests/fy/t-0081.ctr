>> map1 := List nĳ.
>> key1 := Rige nĳ.
>> key2 := Rige nĳ.

map1
	set: ['hello'] by: key1,
	set: ['world'] by: key2.


Utfier
	skriuwe: ['Map #1 contains: '] + (map1 by: key1),
	skriuwe: [' and '] + (map1 by: key2), nije-rigel.

>> KeyeableArray := Rige nĳ.
KeyeableArray by: ['toString'] dwaan: { <- (sels telle) toString.
}.

>> map2 := List nĳ.
key1 := KeyeableArray nĳ.
key2 := KeyeableArray nĳ.

key1 tafoegje: 1.

map2
	set: ['hello'] by: key1,
	set: ['world'] by: key2.

Utfier
	skriuwe: ['Map #2 contains: '] + (map2 by: key1),
	skriuwe: [' and '] + (map2 by: key2), nije-rigel.
