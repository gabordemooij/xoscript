>> faktuer := Objekt nĳ.
faktuer by: ['begjinne'] dwaan: {
        eigen getal := 0.
}.

faktuer by: ['getal'] dwaan: {
        eigen getal optelle: 1.
        <- eigen getal kopiearje.
}.

>> jierfaktuer := faktuer nĳ.
jierfaktuer by: ['start:'] dwaan: { :jier
	eigen getal := jier.
}.

jierfaktuer start: 202000.
Utfier skriuwe: jierfaktuer getal, nije-rigel.
Utfier skriuwe: jierfaktuer getal, nije-rigel.
