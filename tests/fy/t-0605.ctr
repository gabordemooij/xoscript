>> invoice := Objekt nĳ.
invoice by: ['begjinne'] dwaan: {
        eigen getal := 0.
}.

invoice by: ['getal'] dwaan: {
        eigen getal optelle: 1. <- eigen getal kopiearje.
}.

>> year-invoice := invoice nĳ.
year-invoice by: ['start:'] dwaan: { :jier
	eigen getal := jier.
}.

year-invoice start: 202000.
Utfier skriuwe: year-invoice getal, nije-rigel.
Utfier skriuwe: year-invoice getal, nije-rigel.
