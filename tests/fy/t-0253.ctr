#Linux
>> OS := Programma ynstelling: ['OS'].

>> klok := Momint nĳ.
	
(OS = ['Haiku']) ja: {
	klok sône: ['CET'],
	jier: 2017, moanne: 7, dei: 13,
	oere: 18, minút: 0, sekonde: 0.
