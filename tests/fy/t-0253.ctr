#Linux
>> OS := Programma ynstelling: ['OS'].

>> clock := Momint nĳ.
	
(OS = ['Haiku']) ja: {
	clock sône: ['CET'],
	jier: 2017, moanne: 7, dei: 13,
	oere: 18, minút: 0, sekonde: 0.
}, oars: {
	clock sône: ['Europe/Amsterdam'],
	jier: 2017, moanne: 7, dei: 13,
	oere: 18, minút: 0, sekonde: 0.
}.

clock by: ['tell'] dwaan: {
	Utfier skriuwe: sels, nije-rigel.
}.


clock optelle: 2    oere, tell.
clock optelle: 1    oere, tell.
clock optelle: 19 minút, tell.
clock optelle: 1  minút, tell.
clock optelle: 1  minút, tell.
clock optelle: 19 sekonde, tell.
clock optelle: 1  sekonde, tell.
clock optelle: 1  sekonde, tell.
clock optelle: 2    jier, tell.
clock optelle: 1    jier, tell.

(OS = ['Haiku']) ja: {
clock optelle: 5   moanne.
clock sône: ['CEST'], tell.
}, oars: {
	clock optelle: 5   moanne, tell.
}.

