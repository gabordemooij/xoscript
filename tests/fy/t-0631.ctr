#ffi-test


Server init.

Programma geheugenbehear: 4.

# foar dizze test moatte jo in paad nei libc (puts) ynstelle
>> bibnamme := Programma ynstelling: ['FFITESTLIB'].



Server keppelje: (
 Rige nĳ ;
 bibnamme ;
 ['puts'] ;
 ( Rige nĳ ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s frijjaan.

# test mei struct

>> a := Blob nĳ: 8.
a bytes: (
	Rige <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Rige <<: ['int'], ; ['int']).

Server keppelje: (
	Rige <<: ['@structtest'], ;
	['@structtest'] ;
	(Rige <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Utfier skriuwe: ['Somtest:'] + (ffitest ffisum: a), nije-rigel.

struct struct-frijjaan.
struct frijjaan.
a frijjaan.
