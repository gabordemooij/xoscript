>> Grandfather := Objekt nĳ.
Grandfather by: ['greet'] dwaan: {
	Utfier skriuwe: ['Ave!'], nije-rigel.
}.
>> Father := Grandfather nĳ.
Father by: ['greet'] dwaan: {
	Utfier skriuwe: ['Hello'], nije-rigel.
	sels greet.
}.
>> Son := Father nĳ.
Son by: ['greet'] dwaan: {
	Utfier skriuwe: ['Hi'], nije-rigel.
	sels greet.
}.

Son greet.

>> Roundabout := Objekt nĳ.
Roundabout by: ['circle:'] dwaan: { :x
	Utfier skriuwe: x, nije-rigel.
	(x < 3) ja: { sels rekursyf circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) ja: { Utfier skriuwe: x, nije-rigel. x optelle: 1.  increment begjinne. }. }.
increment begjinne.