# test buffers PKI/Sign 
Server init.

>> long := ( Rige nĳ folje: 1000 mei: ['a'] ) gearfoegje: [''].

# sign a message
Utfier skriuwe: ( 
	Klûs ûndertekenje: ['abc'] mei: long
), nije-rigel.

Utfier skriuwe: ( 
	Klûs
		kontrolearje: ['abc'] 
