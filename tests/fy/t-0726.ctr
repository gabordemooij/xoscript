# test buffers PKI/Sign 
Server init.

>> lang := ( Rige nĳ folje: 1000 mei: ['a'] ) gearfoegje: [''].

# in berjocht ûndertekenje
Utfier skriuwe: ( 
	Klûs ûndertekenje: ['abc'] mei: lang
), nije-rigel.

Utfier skriuwe: ( 
	Klûs
		kontrolearje: ['abc'] 
		ûndertekening: lang 
		mei: lang
), nije-rigel.

Utfier skriuwe: (
	Klûs wachtwurd-hash: lang kontrolearje: lang
), nije-rigel.
