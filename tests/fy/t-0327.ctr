

Rige by: ['fixture:'] dwaan: { :f
	eigen fixture := f.
}.

Rige by: ['telle'] dwaan: { <- eigen fixture.
}.

Rige by: ['aantal'] dwaan: { <- eigen fixture.
}.


>> x := Neat.
{

	x := ['hello'] 
	ferfange:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] letter: 2)
			)
		)
	troch: (
		(['...hal'] + ['lo']) 
			haadletters 
			lowecase 
			haadletters 
			ferskowing: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Rige ← 0 ; 1 ; 4; 9 ; (Rige ← 0 ; 3; 1) ; 4
							) foarlêste
						) ? 1
					) + 
					((Rige ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
