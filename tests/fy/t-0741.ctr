Utfier skriuwe: ['Test object'], nije-rigel.
>> a := Objekt nĳ. 

a by: ['item:'] dwaan: { :octhelper
	eigen octhelper := octhelper. 
}.

a by: ['item'] dwaan: { <- eigen octhelper.
}.

a item: Oct nĳ.

>> old-octhelper-address := a item prototype ûnthâldadres.
a save-as: ['/tmp/a.bin'].
Utfier skriuwe: ['========== RELOADING SNAP:'], nije-rigel.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototype ûnthâldadres = old-octhelper-address) ja: {
	Utfier skriuwe: ['Object link re-attached.'], nije-rigel.
}.
