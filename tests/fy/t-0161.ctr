Programma geheugenbehear: 0.
Rige by: ['som'] dwaan: {
	>> totaal := 0.
	sels elk: { :yndeks :elemint
		totaal optelle: elemint.
	}. <- totaal.
}.

>> brûkt-ûnthâld1 := 0.
>> brûkt-ûnthâld2 := 0.
>> brûkt-ûnthâld3 := 0.
>> brûkt-ûnthâld4 := 0.



>> f := Bestand nĳ: ['/tmp/test.txt'].
f skriuwe: ['Lorem Ipsum'].
f slute.
  

f := Bestand nĳ: ['/tmp/test.txt'].
>> tekststik := f lêze.
f slute.



Programma opromje.
brûkt-ûnthâld1 := (Programma ûnthâld ? 1).



f := Bestand nĳ: ['/tmp/test.txt'].
tekststik := f lêze.
f slute.

Programma opromje.
brûkt-ûnthâld2 := (Programma ûnthâld ? 1).


f := Bestand nĳ: ['/tmp/test.txt'].
tekststik := f lêze.
f slute.

Programma opromje.
brûkt-ûnthâld3 := (Programma ûnthâld ? 1).



( brûkt-ûnthâld1 = brûkt-ûnthâld2 en: brûkt-ûnthâld1 = brûkt-ûnthâld3, en: brûkt-ûnthâld2 = brûkt-ûnthâld3 ) ja: {
	Utfier skriuwe: ['Gjin ûnthâldlekken hjir'].
}, nee: {
