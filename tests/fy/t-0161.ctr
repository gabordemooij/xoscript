Programma geheugenbehear: 0.
Rige by: ['sum'] dwaan: {
	>> total := 0.
	sels elk: { :index :element
		total optelle: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Bestand nĳ: ['/tmp/test.txt'].
f skriuwe: ['Lorem Ipsum'].
f slute.
  

f := Bestand nĳ: ['/tmp/test.txt'].
>> text := f lêze.
f slute.



Programma opromje.
usedMemory1 := (Programma ûnthâld ? 1).



f := Bestand nĳ: ['/tmp/test.txt'].
text := f lêze.
f slute.

Programma opromje.
usedMemory2 := (Programma ûnthâld ? 1).


f := Bestand nĳ: ['/tmp/test.txt'].
text := f lêze.
f slute.

Programma opromje.
usedMemory3 := (Programma ûnthâld ? 1).



( usedMemory1 = usedMemory2 en: usedMemory1 = usedMemory3, en: usedMemory2 = usedMemory3 ) ja: {
	Utfier skriuwe: ['No memory leaks here'].
}, nee: {
	Utfier skriuwe: ['Leaking memory...'].
}.
