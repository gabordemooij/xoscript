Tekst by: ['html'] dwaan: { <- (
		sels
		ferfange: ['&'] troch: ['&amp;'],
		ferfange: ['<'] troch: ['&lt;'],
		ferfange: ['>'] troch: ['&gt;'],
		ferfange: ['''] troch: ['&apos;'],
		ferfange: ['"'] troch: ['&quot;']
	).
}.

>> brûkt-ûnthâld1 := 0.
>> brûkt-ûnthâld2 := 0.
>> brûkt-ûnthâld3 := 0.
>> brûkt-ûnthâld4 := 0.

Programma geheugenbehear: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Utfier skriuwe: txt kopiearje html, nije-rigel.
Utfier skriuwe: txt kopiearje lytse-letters, nije-rigel.
Utfier skriuwe: txt kopiearje haadletters, nije-rigel.
} begjinne.

Programma opromje.

brûkt-ûnthâld1 := (Programma ûnthâld ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Utfier skriuwe: txt kopiearje html, nije-rigel.
Utfier skriuwe: txt kopiearje lytse-letters, nije-rigel.
Utfier skriuwe: txt kopiearje haadletters, nije-rigel.
} begjinne.

Programma opromje.
brûkt-ûnthâld2 := (Programma ûnthâld ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Utfier skriuwe: txt kopiearje html, nije-rigel.
Utfier skriuwe: txt kopiearje lytse-letters, nije-rigel.
Utfier skriuwe: txt kopiearje haadletters, nije-rigel.
} begjinne.

Programma opromje.
brûkt-ûnthâld3 := (Programma ûnthâld ? 0).



( brûkt-ûnthâld1 = brûkt-ûnthâld2 en: brûkt-ûnthâld1 = brûkt-ûnthâld3, en: brûkt-ûnthâld2 = brûkt-ûnthâld3 ) ja: {
	Utfier skriuwe: ['Gjin ûnthâldlekken hjir'].
}, nee: {
