Tekst by: ['html'] dwaan: { <- (
		sels
		ferfange: ['&'] troch: ['&amp;'],
		ferfange: ['<'] troch: ['&lt;'],
		ferfange: ['>'] troch: ['&gt;'],
		ferfange: ['''] troch: ['&apos;'],
		ferfange: ['"'] troch: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programma geheugenbehear: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Utfier skriuwe: txt kopiearje html, nije-rigel.
Utfier skriuwe: txt kopiearje lytse-letters, nije-rigel.
Utfier skriuwe: txt kopiearje haadletters, nije-rigel.
} begjinne.

Programma opromje.

usedMemory1 := (Programma ûnthâld ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Utfier skriuwe: txt kopiearje html, nije-rigel.
Utfier skriuwe: txt kopiearje lytse-letters, nije-rigel.
Utfier skriuwe: txt kopiearje haadletters, nije-rigel.
} begjinne.

Programma opromje.
usedMemory2 := (Programma ûnthâld ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Utfier skriuwe: txt kopiearje html, nije-rigel.
Utfier skriuwe: txt kopiearje lytse-letters, nije-rigel.
Utfier skriuwe: txt kopiearje haadletters, nije-rigel.
} begjinne.

Programma opromje.
usedMemory3 := (Programma ûnthâld ? 0).



( usedMemory1 = usedMemory2 en: usedMemory1 = usedMemory3, en: usedMemory2 = usedMemory3 ) ja: {
	Utfier skriuwe: ['No memory leaks here'].
}, nee: {
	Utfier skriuwe: ['Leaking memory...'].
}.
