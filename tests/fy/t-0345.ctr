# test catch-all methods
>> x13 := Objekt nĳ.
x13 by: ['a'] dwaan: { :a Utfier skriuwe: 0, nije-rigel. }.
x13 by: ['a:'] dwaan: { :a Utfier skriuwe: a, nije-rigel. <- 5. }.
x13 by: ['a:b:'] dwaan: { :a :b Utfier skriuwe: (a + b), nije-rigel. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
