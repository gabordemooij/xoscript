Server init.
>> fmt := Formaat nĳ: ['%#3x'].

>> blob := Blob nĳ: 4.
blob bytes: ( 
	Rige nĳ ; 0 ; 1 ; 2 ; 3
).

>> file := Bestand nĳ: ['/tmp/blob'].
file blob: blob.
blob frijjaan.

>> lêze := file blob.
lêze 
fan: 0 
lingte: 4, 
dwaan elk: { :i :b 
	Utfier
	skriuwe: (fmt tapasse-int: b),
	nije-rigel.
}.
lêze frijjaan.
