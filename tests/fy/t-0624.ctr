# Dizze test kontrolearret oft string_fill_in syn plak net kwyt rekket (gc'ed) yn modus 4
# ferwizing yn world.c
>> Logboek := Objekt nĳ.

Logboek by: ['say:'] dwaan: { :str
	Utfier skriuwe: str, nije-rigel.
}.

>> Ûnderdiel := Objekt nĳ.

Ûnderdiel by: ['nĳ:'] dwaan: { :id
	<- sels nĳ id: id.
}.

Ûnderdiel by: ['id:'] dwaan: { :id
	eigen id := id.
}.

Ûnderdiel by: ['id'] dwaan: { <- eigen id. }.


Ûnderdiel by: ['tekst'] dwaan: {
	>> str := ['Item#~no'].
	str ~no: eigen id.
	<- str.
}.


>> Print := Objekt nĳ.

Print by: ['items'] dwaan: { 
	
	eigen ûnderdiel := Ûnderdiel nĳ: 1.
	
	# of in segfault of hjir in ferkearde str
	Logboek say: (
		['~item printed.'] ~item: eigen ûnderdiel
	).
	
	
}.

Print items.