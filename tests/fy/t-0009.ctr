>> Groeter := Objekt nĳ.
Groeter by: ['meitsje'] dwaan: {
	>> groeter := Objekt nĳ.
	groeter by: ['name:'] dwaan: { :namme
		Utfier skriuwe: ['in namme ynstelle'].
		eigen myNamme := namme.
	}.
	groeter by: ['groetBringe'] dwaan: {
		Utfier skriuwe: ['Hello'].
		Utfier skriuwe: eigen myNamme.
	}.
	groeter by: ['groetsje'] dwaan: {
		sels groetBringe.
	}. <- groeter.
}.
>> groeter := Groeter meitsje.
groeter name: ['sinneskyn!'].
groeter groetsje.
