Getal by: ['fakulteit'] dwaan: {
	>> totaal := 1.
	{ :yndeks totaal fermannichfâldigje-mei: (sels - yndeks). } × sels. <- totaal.
}.

>> brûkt-ûnthâld1 := 0.
>> brûkt-ûnthâld2 := 0.
>> brûkt-ûnthâld3 := 0.
>> brûkt-ûnthâld4 := 0.

Programma geheugenbehear: 0.

{
2 eksponint fakulteit.
Utfier skriuwe: (11 modulo: 3), nije-rigel.
Utfier skriuwe: (3.4 ôfrûne), nije-rigel.
Utfier skriuwe: (7.1 ôfrûnje-op), nije-rigel.
Utfier skriuwe: (7.9 ôfrûnje-del), nije-rigel.
}
begjinne.

Programma opromje.

brûkt-ûnthâld1 := (Programma ûnthâld ? 0).

{
2 eksponint fakulteit.
Utfier skriuwe: (11 modulo: 3), nije-rigel.
Utfier skriuwe: (3.4 ôfrûne), nije-rigel.
Utfier skriuwe: (7.1 ôfrûnje-op), nije-rigel.
Utfier skriuwe: (7.9 ôfrûnje-del), nije-rigel.
}
begjinne.

Programma opromje.
brûkt-ûnthâld2 := (Programma ûnthâld ? 0).


{
2 eksponint fakulteit.
Utfier skriuwe: (11 modulo: 3), nije-rigel.
Utfier skriuwe: (3.4 ôfrûne), nije-rigel.
Utfier skriuwe: (7.1 ôfrûnje-op), nije-rigel.
Utfier skriuwe: (7.9 ôfrûnje-del), nije-rigel.
} begjinne.

Programma opromje.
brûkt-ûnthâld3 := (Programma ûnthâld ? 0).



( brûkt-ûnthâld1 = brûkt-ûnthâld2 en: brûkt-ûnthâld1 = brûkt-ûnthâld3, en: brûkt-ûnthâld2 = brûkt-ûnthâld3 ) ja: {
	Utfier skriuwe: ['Gjin ûnthâldlekken hjir'].
}, nee: {
	Utfier skriuwe: ['Ûnthâld lekt...'].
}.
