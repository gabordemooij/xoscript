Utfier skriuwe: ['Test object'], nije-rigel.
>> a := Objekt nĳ. 

a by: ['item:'] dwaan: { :file
	eigen file := file. 
}.

a by: ['item'] dwaan: { <- eigen file.
}.

>> f := Bestand nĳ: ['/tmp/aaa.txt'].
a item: f.
Utfier skriuwe: a item, nije-rigel.
a save-as: ['/tmp/a.bin'].
Utfier skriuwe: ['========== RELOADING SNAP:'], nije-rigel.
>> b := Objekt load-from: ['/tmp/a.bin'].
Utfier skriuwe: b item, nije-rigel.
