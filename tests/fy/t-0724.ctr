Utfier skriuwe: ['Testobjekt'], nije-rigel.
>> a := Objekt nĳ. 

a by: ['item:'] dwaan: { :file
	eigen file := file. 
}.

a by: ['ûnderdiel'] dwaan: {
	<- eigen file.
}.

>> f := Bestand nĳ: ['/tmp/aaa.txt'].
a item: f.
Utfier skriuwe: a ûnderdiel, nije-rigel.
a save-as: ['/tmp/a.bin'].
Utfier skriuwe: ['========== SNAP OPNIJ LADE:'], nije-rigel.
>> b := Objekt load-from: ['/tmp/a.bin'].
Utfier skriuwe: b ûnderdiel, nije-rigel.
