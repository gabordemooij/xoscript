>> getallen := ['1,2,3'] splitse: [','].
Utfier skriuwe: ['Ik krige: '] + getallen telle + [' getallen.'],nije-rigel.
{ :i Utfier skriuwe: ['number #'] + i + [':'] + (getallen posysje: i), nije-rigel.} × 3.
>> dranken := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
dranken := dranken splitse: [' Or '].
Utfier skriuwe: ['Wy servearje'], nije-rigel.
{ :i Utfier skriuwe: ['->'] + (dranken posysje: i), nije-rigel. } × (dranken telle).
Utfier skriuwe: (dranken gearfoegje: [',']), nije-rigel.
Utfier skriuwe: (getallen gearfoegje: ['||']).
