# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := Maria-DB nĳ host: ['localhost'],
	brûkersnamme: ['xo'],
	wachtwurd: ['pass123'],
	databanknamme: ['xobase'],
	ferbine.

>> sykparameters := db fraach: ['SELECT ? AS a, ? AS b, ? AS c'].
sykparameters parameters: (Rige nĳ ; ['1']).
{ sykparameters ophelje: { :row Utfier skriuwe: row, nije-rigel. }. } fange: { :e Utfier skriuwe: e, nije-rigel. }, begjinne.

>> sykparameters := db fraach: ['SELECT ? AS a'].
{ sykparameters ophelje: { :row Utfier skriuwe: row, nije-rigel. }. } fange: { :e Utfier skriuwe: e, nije-rigel. }, begjinne.

# the right number still works, more parameters are ignored as before
>> sykparameters := db fraach: ['SELECT ? AS a, ? AS b'].
sykparameters parameters: (Rige nĳ ; ['1'] ; ['2']).
sykparameters ophelje: { :row Utfier skriuwe: (row by: ['a']), skriuwe: (row by: ['b']), nije-rigel. }.
sykparameters parameters: (Rige nĳ ; ['1'] ; ['2'] ; ['3']).
sykparameters ophelje: { :row Utfier skriuwe: (row by: ['a']), skriuwe: (row by: ['b']), nije-rigel. }.
