# minder parameters as plakhâlders moat in flater jaan, net foarby de bindingen lêze
Server init.

>> db := Maria-DB nĳ host: ['localhost'],
	brûkersnamme: ['xo'],
	wachtwurd: ['pass123'],
	databanknamme: ['xobase'],
	ferbine.

>> sykparameters := db fraach: ['SELECT ? AS a, ? AS b, ? AS c'].
sykparameters parameters: (Rige nĳ ; ['1']).
{ sykparameters ophelje: { :tabelrige Utfier skriuwe: tabelrige, nije-rigel. }. } fange: { :e Utfier skriuwe: e, nije-rigel. }, begjinne.

>> sykparameters := db fraach: ['SELECT ? AS a'].
{ sykparameters ophelje: { :tabelrige Utfier skriuwe: tabelrige, nije-rigel. }. } fange: { :e Utfier skriuwe: e, nije-rigel. }, begjinne.

# it goede oantal wurket noch, mear parameters wurde lykas earder negearre
>> sykparameters := db fraach: ['SELECT ? AS a, ? AS b'].
sykparameters parameters: (Rige nĳ ; ['1'] ; ['2']).
sykparameters ophelje: { :tabelrige Utfier skriuwe: (tabelrige by: ['a']), skriuwe: (tabelrige by: ['b']), nije-rigel. }.
sykparameters parameters: (Rige nĳ ; ['1'] ; ['2'] ; ['3']).
sykparameters ophelje: { :tabelrige Utfier skriuwe: (tabelrige by: ['a']), skriuwe: (tabelrige by: ['b']), nije-rigel. }.
