# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Klûs 
	wachtwurd-hash: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Klûs 
	wachtwurd-hash: hash kontrolearje: a1.
	# fail 
>> b := Klûs
	wachtwurd-hash: hash kontrolearje: a2.
	# ok!

Utfier skriuwe: a, nije-rigel.
Utfier skriuwe: b, nije-rigel.

