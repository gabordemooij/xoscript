# Wachtwurd-hashing
Server init.

# Brûker stelt in wachtwurd yn
>> wachtw := ['pass123'].

# Jo bewarje it sa
>> hashwearde := Klûs 
	wachtwurd-hash: wachtw.

# Dan logt de brûker yn
# Besykjen 1
>> a1 := ['abcd123'].
# Besykjen 2
>> a2 := ['pass123'].

# Kontrolearje
>> a := Klûs 
	wachtwurd-hash: hashwearde kontrolearje: a1.
	# mislearre 
>> b := Klûs
	wachtwurd-hash: hashwearde kontrolearje: a2.
	# ok!

Utfier skriuwe: a, nije-rigel.
Utfier skriuwe: b, nije-rigel.

