# databanktest
# sjoch foarbyld server.xo foar de nedige konfiguraasje

Server init.
Utfier skriuwe: ['Databanktest'], nije-rigel.

>> db := Maria-DB nĳ host: ['localhost'],
	brûkersnamme: ['xo'], wachtwurd: ['pass123'], databanknamme: ['xobase'], ferbine.

Utfier skriuwe: ['Kinne wy ferbine? '] + db ferbûn?, nije-rigel.

>> sykparameters := db fraach: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parameters: ( Rige nĳ ; ['abc'] ; 12.35 ; 6 ). # parametrisearre fragen

{  sykparameters útfiere. db befêstigje. } fange: { :e db weromdraaie.  }, begjinne.

Utfier skriuwe: ['Kinne wy ynfoegje? '] + ( sykparameters insert-id > 0 ), nije-rigel.

>> Obj := Objekt nĳ.
Obj by: ['rigen-ophelje'] dwaan: {
	eigen telle := 0.
	>> sykparameters :=
	db fraach: ['SELECT * FROM book order by id desc limit 2'], 
	ophelje: { :tabelrige 
		eigen telle optelle: 1.
		Ja ôfbrekke.
	}. # rigen ophelje
	<- eigen telle kopiearje.
}.

Utfier skriuwe: ['Kinne wy opfreegje? '] + ( Obj rigen-ophelje > 0 ), nije-rigel.
