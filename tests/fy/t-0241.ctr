

Tekst by: ['evaluearje'] dwaan: {
	>> koade := Bestand nĳ: ['/tmp/eval.ctr'].
	koade skriuwe: (sels tekst + ['.']).
	Programma brûke: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Rige ← (['Oanhalingstekens '] + Q + [' binne kwea?']) ; 1.
>> x := q tekst.
Utfier skriuwe: x, nije-rigel.
>> y := Neat.
(['y := '] + x ) evaluearje.
Utfier skriuwe: y ? 0, nije-rigel.

q := List set: ['\[''] by: ['\['quote\']'].
x := q tekst.
Utfier skriuwe: x, nije-rigel.
y := Neat.
(['y := '] + x ) evaluearje.

>> q := (List nĳ) set:['\[''] by:['\['quote\[''].
Utfier skriuwe: y ? ['\['quote\']'], nije-rigel.
