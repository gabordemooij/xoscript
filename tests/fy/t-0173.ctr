

Rige by: ['som'] dwaan: {
	>> totaal := 0.
	sels elk: { :yndeks :elemint
		totaal optelle: elemint.
	}. <- totaal.
}.

Rige by: ['produkt'] dwaan: {
	>> totaal := 1.
	sels elk: { :yndeks :elemint
		totaal fermannichfâldigje-mei: elemint.
	}. <- totaal.
}.

