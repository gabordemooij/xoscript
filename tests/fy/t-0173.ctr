

Rige by: ['sum'] dwaan: {
	>> total := 0.
	sels elk: { :index :element
		total optelle: element.
	}. <- total.
}.

Rige by: ['product'] dwaan: {
	>> total := 1.
	sels elk: { :index :element
		total fermannichfâldigje-mei: element.
	}. <- total.
}.

>> usedMemory1 := 0.
