Programma geheugenbehear: 0.

{

>> a := Rige ← ['hello'] ; ['world'] ; Ja ; Neat ; 666.
a := a + ( Rige ← 1 ).
Utfier skriuwe: ( ['sum: '] + ( a sum ) ), nije-rigel.
Utfier skriuwe: ( ['min: '] + ( a minimum ) ), nije-rigel.
Utfier skriuwe: ( ['max: '] + ( a maksimum ) ), nije-rigel.
Utfier skriuwe: ( ['3rd: '] + ( a ? 2 ) ), nije-rigel.
Utfier skriuwe: ( ['prd: '] + ( a product ) ), nije-rigel.
a sortearje: { :a :b <- (b - a). }.
a elk: { :i :e Utfier skriuwe: ( i - 0 ), nije-rigel. }.

} begjinne.

