
>> countries := Rige nĳ
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Rige nĳ
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods per: countries, elk: { :key :value
	counter optelle: 1.
}.

Utfier skriuwe: (['we serve counter dishes'] counter: counter), nije-rigel.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] karakters sortearje: { :v
	counter optelle: 0.
}.

Utfier skriuwe: (['we sort counter dishes'] counter: counter), nije-rigel.


>> counter := 0.
{
	{
		counter optelle: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Utfier skriuwe: (['we calculate counter numbers.'] counter: counter), nije-rigel.

