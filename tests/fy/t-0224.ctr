
>> lannen := Rige nĳ
	~ ['Switserlân']
	~ ['Itaalje']
	~ ['Dútslân'].

>> itenswaren := Rige nĳ
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> teller := 0.
itenswaren per: lannen, elk: { :key :value
	teller optelle: 1.
}.

Utfier skriuwe: (['we serve counter dishes'] counter: teller), nije-rigel.

>> teller := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] karakters sortearje: { :v
	teller optelle: 0.
}.

Utfier skriuwe: (['we sort counter dishes'] counter: teller), nije-rigel.


>> teller := 0.
{
	{
		teller optelle: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Utfier skriuwe: (['we calculate counter numbers.'] counter: teller), nije-rigel.

