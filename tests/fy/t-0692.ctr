Server init.

Utfier skriuwe: (
	Patroan nĳ: ['^\\w+$'],
	oerienkomst: ['test@example.com'] 
), nije-rigel. # 0 oerienkomsten, mislearret op @ en .

Utfier skriuwe: (
	Patroan nĳ: ['^[^@]+@[^\.]+\.\\w+$'],
	oerienkomst: ['test@example.com'] 
), nije-rigel. # 1 oerienkomst

Utfier skriuwe: (
	Patroan nĳ: ['[^@]+@[^\.]+\.\\w+'],
	oerienkomst: ['test@example.com'] 
), nije-rigel. # 1 oerienkomst

Utfier skriuwe: (
	Patroan nĳ: ['([^@]+)@([^\.]+)\.\\w+'],
	oerienkomst: ['test@example.com'] 
), nije-rigel. # 1 oerienkomst, groepen meitsje neat út

Utfier skriuwe: (
	Patroan nĳ: ['[a-z]'],
	oerienkomst: ['test@example.com'] 
), nije-rigel. # 14 oerienkomsten

Utfier skriuwe: (
	Patroan nĳ: ['.*'],
	oerienkomst: ['test@example.com'] 
), nije-rigel. # 1 oerienkomst (alles)

Utfier skriuwe: (
	Patroan nĳ: ['(.*)'],
	oerienkomst: ['test@example.com'] 
), nije-rigel. # 1 oerienkomst (alles)

Utfier skriuwe: (
	Patroan nĳ: ['\\s*[^@]+@[^\.]+\.\\w+'],
	oerienkomst: ['test@example.com'] 
), nije-rigel. # 1 oerienkomst, spaasje foarôf is opsjoneel, wurdt negearre