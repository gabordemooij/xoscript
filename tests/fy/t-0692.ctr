Server init.

Utfier skriuwe: (
	Patroan nĳ: ['^\\w+$'],
	oerienkomst: ['test@example.com'] 
), nije-rigel. # 0 match, fails on @ and .

Utfier skriuwe: (
	Patroan nĳ: ['^[^@]+@[^\.]+\.\\w+$'],
	oerienkomst: ['test@example.com'] 
), nije-rigel. # 1 match

Utfier skriuwe: (
	Patroan nĳ: ['[^@]+@[^\.]+\.\\w+'],
	oerienkomst: ['test@example.com'] 
), nije-rigel. # 1 match

Utfier skriuwe: (
	Patroan nĳ: ['([^@]+)@([^\.]+)\.\\w+'],
	oerienkomst: ['test@example.com'] 
), nije-rigel. # 1 match, groups dont matter

Utfier skriuwe: (
	Patroan nĳ: ['[a-z]'],
	oerienkomst: ['test@example.com'] 
), nije-rigel. # 14 matches

Utfier skriuwe: (
	Patroan nĳ: ['.*'],
	oerienkomst: ['test@example.com'] 
), nije-rigel. # 1 match (all)

Utfier skriuwe: (
	Patroan nĳ: ['(.*)'],
	oerienkomst: ['test@example.com'] 
), nije-rigel. # 1 match (all)

Utfier skriuwe: (
	Patroan nĳ: ['\\s*[^@]+@[^\.]+\.\\w+'],
	oerienkomst: ['test@example.com'] 
), nije-rigel. # 1 match, prefix space optional, gets ignored