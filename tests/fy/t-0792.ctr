Server init.

>> DB := Maria-DB nĳ host: ['localhost'],
	brûkersnamme: ['xo'],
	wachtwurd: ['pass123'],
	databanknamme: ['xobase'],
	ferbine.
	
>> SQL := ['SELECT "hello" AS "world" '].

# in fluggere manier, fraach ophelje fan DB:
