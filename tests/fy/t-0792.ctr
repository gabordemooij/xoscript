Server init.

>> DB := Maria-DB nĳ host: ['localhost'],
	brûkersnamme: ['xo'],
	wachtwurd: ['pass123'],
	databanknamme: ['xobase'],
	ferbine.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB fraach: SQL.

# now you don't have to set DB
query2 ophelje: { :row
	Utfier skriuwe: row world, nije-rigel.
}.
