
>> Slurp := Objekt nĳ.

Slurp by: ['nĳ'] dwaan: {
	eigen str := [''].
}.

Slurp by: ['reagearje:'] dwaan: { :blah
		(eigen str = ['']) ja: {
			eigen str tafoegje: blah.
		}, oars: {
			eigen str tafoegje: [' '].
			eigen str tafoegje: blah.
		}.
}.

Slurp by: ['reagearje:en:'] dwaan: { :blah :blahah
		(blah lingte > 1) ja: {
			eigen str tafoegje: (blah fan: 0 lingte: (blah lingte - 1)).
		}, oars: {
			eigen str tafoegje: blah.
		}.
		eigen str tafoegje: [' '].
		eigen str tafoegje: blahah.
}.

Slurp by: ['krije'] dwaan: {
	>> buffer := eigen str.
	eigen str := ['']. <- buffer.
}.

Utfier skriuwe: ( Programma systeem: ( Slurp nĳ echo hello world krije ) ).
