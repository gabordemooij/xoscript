{
	dizze-taak flater: ['Dont fail.'].
	unknown doSomething.
} fange: {
	Utfier skriuwe: ['Caught!'].
}, begjinne.

{
	dizze-taak flater: ['Dont fail.'].
	eigen unknown doSomething.
} fange: {
	Utfier skriuwe: ['Caught!'].
}, begjinne.

{
	dizze-taak flater: ['Dont fail.'].
	unknown := 122.
} fange: {
	Utfier skriuwe: ['Caught!'].
}, begjinne.


{
	dizze-taak flater: ['Dont fail.'].
	Ja ôfbrekke.
	Utfier skriuwe: ['FAIL'].
} fange: {
	Utfier skriuwe: ['Caught!'].
}, begjinne.

{
	{
		dizze-taak flater: ['Dont fail.'].
		Ja ôfbrekke.
		Utfier skriuwe: ['FAIL'].
	} fange: { :x
		(x = ['Dont fail.']) ja: { dizze-taak flater: ['Nested Caught!']. }.
	}, begjinne.
} fange: { :e
	Utfier skriuwe: e.
}, begjinne.
