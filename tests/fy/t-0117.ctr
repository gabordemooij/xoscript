>> t := Ja.
(t = Ja) ja: { Utfier skriuwe: ['T']. }.
(t = Nee) ja: { Utfier skriuwe: ['F']. }.
Utfier skriuwe: ['|'].
>> t := Nee.
(t = Ja) ja: { Utfier skriuwe: ['T']. }.
(t = Nee) ja: { Utfier skriuwe: ['F']. }.
Utfier skriuwe: ['|'].
>> f := Ja.
(t = Ja en: f = Nee) ja: { Utfier skriuwe: ['T']. }.
(t = Nee en: f = Ja) ja: { Utfier skriuwe: ['F']. }.
Utfier skriuwe: ['|'].
>> n := Neat.
(n Neat?) ja: { Utfier skriuwe: ['T']. }.
(n Neat?) nee: { Utfier skriuwe: ['F']. }.
Utfier skriuwe: ['|'].
(f Boolean?) ja: { Utfier skriuwe: ['T']. }.
(f Boolean?) nee: { Utfier skriuwe: ['F']. }.



