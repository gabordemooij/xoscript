>> t := Neat.

# you can control the time zone for
# parsing like this:
Momint sône: ['CET'].
t := Momint út: ['1981-02-03 04:05:06'].
Utfier skriuwe: t, nije-rigel.

# now using CEST time zone:
Momint sône: ['CEST'].
t := Momint út: ['1981-02-03 04:05:06'].
Utfier skriuwe: t, nije-rigel.

# error if string cannot be parsed
{ Momint út: ['1900']. } fange: { Neat. }, begjinne.
