>> t := Neat.

# jo kinne de tiidsône bepale foar
# it parsen, sa:
Momint sône: ['CET'].
t := Momint út: ['1981-02-03 04:05:06'].
Utfier skriuwe: t, nije-rigel.

# no mei CEST-tiidsône:
Momint sône: ['CEST'].
t := Momint út: ['1981-02-03 04:05:06'].
Utfier skriuwe: t, nije-rigel.

# flater as de tekst net parsed wurde kin
{ Momint út: ['1900']. } fange: { Neat. }, begjinne.
