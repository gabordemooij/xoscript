>> x := [' hallo '].

>> y := x haadletters.
Utfier skriuwe: x, nije-rigel.
Utfier skriuwe: (x gelyk: y), nije-rigel.

>> y := x lytse-letters.
Utfier skriuwe: x, nije-rigel.
Utfier skriuwe: (x gelyk: y), nije-rigel.

>> y := x ynkoartsje.
Utfier skriuwe: x, nije-rigel.
Utfier skriuwe: (x gelyk: y), nije-rigel.

>> y := x ferskowing: 1.
Utfier skriuwe: x, nije-rigel.
Utfier skriuwe: (x gelyk: y), nije-rigel.

>> y := x fan: 1 lingte: 2.
Utfier skriuwe: x, nije-rigel.
Utfier skriuwe: (x gelyk: y), nije-rigel.