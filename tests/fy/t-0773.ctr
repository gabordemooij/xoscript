>> a := Objekt nĳ. 
a by: ['item:'] dwaan: { :i64
	eigen i64 := i64. 
}.
a by: ['ûnderdiel'] dwaan: {
	<- eigen i64.
}.
a item: ( Int64 út-tekst: ['9999'] ).
