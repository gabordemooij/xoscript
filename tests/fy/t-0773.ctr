Utfier skriuwe: ['Test object'], nije-rigel.
>> a := Objekt nĳ. 
a by: ['item:'] dwaan: { :int64
	eigen int64 := int64. 
}.
a by: ['item'] dwaan: { <- eigen int64.
}.
a item: ( Int64 út-tekst: ['9999'] ).
Utfier skriuwe: a item, nije-rigel.
>> old-int64-address := a item prototype ûnthâldadres.
a save-as: ['/tmp/a.bin'].
Utfier skriuwe: ['========== RELOADING SNAP:'], nije-rigel.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b item prototype ûnthâldadres = old-int64-address) ja: {
	Utfier skriuwe: ['Object link re-attached.'], nije-rigel.
}.
Utfier skriuwe: ( b item ), nije-rigel.
