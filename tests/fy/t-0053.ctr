60 × {
	>> x := (Getal tafal % 6) + 1.
	(x ≤ 6) nee: { Utfier skriuwe: ['MIS']. }.
	(x ≥0) nee: { Utfier skriuwe: ['MIS']. }.
	x := (Getal tafal % 3) + 1.
	(x < 3) nee: { Utfier skriuwe: ['MIS']. }.
	(x>-1) nee: { Utfier skriuwe: ['MIS']. }.
	x := ((Boolean omsmite) getal).
	(x = 0 of: x = 1) nee: { Utfier skriuwe: ['MIS']. }.
	x := ((Ja omsmite) getal).
	(x = 0 of: x = 1) nee: { Utfier skriuwe: ['MIS']. }.
	x := (Boolean omsmite of: ['KOP'] of: ['MUNT']).
	((x = ['KOP']) of: (x = ['MUNT'])) nee: { Utfier skriuwe: ['MIS']. }.
}.
Utfier skriuwe: ['KLEAR'].

