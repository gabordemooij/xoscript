Utfier skriuwe: ['Test object'], nije-rigel.
>> a := Objekt nĳ. 

a by: ['item:'] dwaan: { :hexhelper
	eigen hexhelper := hexhelper. 
}.

a by: ['item'] dwaan: { <- eigen hexhelper.
}.

a item: Hx nĳ.

>> old-hexhelper-address := a item prototype ûnthâldadres.
a save-as: ['/tmp/a.bin'].
Utfier skriuwe: ['========== RELOADING SNAP:'], nije-rigel.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototype ûnthâldadres = old-hexhelper-address) ja: {
	Utfier skriuwe: ['Object link re-attached.'], nije-rigel.
}.
