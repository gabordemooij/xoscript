# in opmaak moat passe by it type fan de wearde, it type kin fan in client komme
>> besykje := { :opmaak :value
	{ Utfier skriuwe: ( (Formaat nĳ: opmaak) tapasse: value ), nije-rigel. } fange: { :e Utfier skriuwe: e, nije-rigel. }, begjinne.
}.
>> besykje-int := { :opmaak :value
	{ Utfier skriuwe: ( (Formaat nĳ: opmaak) tapasse-int: value ), nije-rigel. } fange: { :e Utfier skriuwe: e, nije-rigel. }, begjinne.
}.

# past
besykje tapasse: ['|%s|'] en: ['text'].
besykje tapasse: ['%06.2f'] en: 5.5.
besykje tapasse: ['100%% %s'] en: ['wis'].
besykje-int tapasse: ['%03d'] en: 7.
besykje-int tapasse: ['%x'] en: 255.
besykje tapasse: ['%d'] en: (Int64 nĳ út-tekst: ['12']).
besykje tapasse: ['%lld'] en: (Int64 nĳ út-tekst: ['12']).
besykje tapasse: ['%.1lf'] en: 5.5.
besykje-int tapasse: ['%hd'] en: 7.

# past net
besykje tapasse: ['%s'] en: 12345.
besykje tapasse: ['%d'] en: 12345.
besykje tapasse: ['%f'] en: ['text'].
besykje-int tapasse: ['%d'] en: ['text'].
besykje-int tapasse: ['%s'] en: 5.
besykje tapasse: ['%s %s'] en: ['text'].
besykje tapasse: ['%n'] en: ['text'].
besykje tapasse: ['%*s'] en: ['text'].
besykje tapasse: ['%'] en: ['text'].

# lingtemodifikaasje past net
besykje tapasse: ['%ls'] en: ['text'].
besykje tapasse: ['%Lf'] en: 5.5.
besykje-int tapasse: ['%ld'] en: 7.
besykje-int tapasse: ['%lld'] en: 7.
besykje tapasse: ['%Ld'] en: (Int64 nĳ út-tekst: ['12']).

# in breedte dy't net yn printf past moat in flater jaan, gjin crash
besykje tapasse: ['%99999999999s'] en: ['text'].
