>> repeater := Objekt nĳ.
repeater by: ['reagearje:'] dwaan: { :what
	Utfier skriuwe: what + [' '].
}.
repeater by: ['reagearje:en:'] dwaan: { :what :say
	Utfier skriuwe: what, skriuwe: say + [' '].
}.
repeater by: ['reagearje:en:en:'] dwaan: { :what :say :more
	Utfier skriuwe: what, skriuwe: say, skriuwe: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
