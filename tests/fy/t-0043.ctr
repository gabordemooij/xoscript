>> werhelder := Objekt nĳ.
werhelder by: ['reagearje:'] dwaan: { :wat
	Utfier skriuwe: wat + [' '].
}.
werhelder by: ['reagearje:en:'] dwaan: { :wat :say
	Utfier skriuwe: wat, skriuwe: say + [' '].
}.
werhelder by: ['reagearje:en:en:'] dwaan: { :wat :say :mear
	Utfier skriuwe: wat, skriuwe: say, skriuwe: mear.
}.
werhelder werhelje.
werhelder everything: ['Ik sis.'].
werhelder and: ['I '] everything: ['doch.'].
