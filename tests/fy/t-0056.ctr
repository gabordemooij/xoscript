>> z := Objekt nĳ.
z by: ['value:'] dwaan: { :v
	eigen value := v. <- sels.
}.
z by: ['value'] dwaan: { <- eigen value. }.
(z setValue: 1) value: 2.
Utfier skriuwe: z value.
>> x := z.
Utfier skriuwe: x value.
z := Neat.
Utfier skriuwe: z value.
Utfier skriuwe: x value.
