# test list operations


>> cakes := Rige ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes ferfange: 1 lingte: 2 troch: ( Rige ← ['cinnamon'] ; ['pineapple'] ).
Utfier skriuwe: (buy gearfoegje: [',']), nije-rigel.


>> buy := cakes ferfange: 1 lingte: 12 troch: ( Rige ← ['cinnamon'] ; ['pineapple'] ).
Utfier skriuwe: (buy gearfoegje: [',']), nije-rigel.


>> buy := cakes ferfange: 2 lingte: 10 troch: ( Rige nĳ ).
Utfier skriuwe: (buy gearfoegje: [',']), nije-rigel.


>> buy := cakes ferfange: 0 lingte: 1 troch: ( Rige nĳ ).
Utfier skriuwe: (buy gearfoegje: [',']), nije-rigel.


>> buy := cakes ferfange: ['0'] lingte: ['1'] troch: ['x'].
Utfier skriuwe: (buy gearfoegje: [',']), nije-rigel.
