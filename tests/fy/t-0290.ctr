# test listoperaasjes


>> koeken := Rige ←
	['apple'] ;
	['bei'] ;
	['sjoko'] ;
	['tsiis'].


>> keapje := koeken ferfange: 1 lingte: 2 troch: ( Rige ← ['kaniel'] ; ['ananas'] ).
Utfier skriuwe: (keapje gearfoegje: [',']), nije-rigel.


>> keapje := koeken ferfange: 1 lingte: 12 troch: ( Rige ← ['kaniel'] ; ['ananas'] ).
Utfier skriuwe: (keapje gearfoegje: [',']), nije-rigel.


>> keapje := koeken ferfange: 2 lingte: 10 troch: ( Rige nĳ ).
Utfier skriuwe: (keapje gearfoegje: [',']), nije-rigel.


>> keapje := koeken ferfange: 0 lingte: 1 troch: ( Rige nĳ ).
Utfier skriuwe: (keapje gearfoegje: [',']), nije-rigel.


>> keapje := koeken ferfange: ['0'] lingte: ['1'] troch: ['x'].
Utfier skriuwe: (keapje gearfoegje: [',']), nije-rigel.
