# lokkich paad
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> paad := ['/tmp/dat.csv'].
>> csv := Bestand nĳ: paad.
csv skriuwe: s.

# akseptearret CRLF LF CR, wikseljende rigellingte
csv skiedingsteken: [';'] oanhellingsteken: ['"'] rigels: { :line
	Programma opromje.
	Utfier skriuwe: line, nije-rigel.
	Programma opromje.
}.

# ûngelikense rigels
s tafoegje: ['\njustone'].
csv skriuwe: s.
{
	csv skiedingsteken: [';'] oanhellingsteken: ['"'] rigels: { :line
		Utfier skriuwe: line, nije-rigel.
	}.
} fange: { :e 
	Utfier skriuwe: e, nije-rigel.
}, begjinne.

# ûnjildich formaat
s := ['"he"llo";world'].
csv skriuwe: s.
{
	csv skiedingsteken: [';'] oanhellingsteken: ['"'] rigels: { :line
		Utfier skriuwe: line, nije-rigel.
	}.
} fange: { :e 
	Utfier skriuwe: e, nije-rigel.
}, begjinne.
