# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> paad := ['/tmp/dat.csv'].
>> csv := Bestand nĳ: paad.
csv skriuwe: s.

# accepts CRLF LF CR, varying row length
csv skiedingsteken: [';'] oanhellingsteken: ['"'] rigels: { :line
	Programma opromje.
	Utfier skriuwe: line, nije-rigel.
	Programma opromje.
}.

# unequal lines
s tafoegje: ['\njustone'].
csv skriuwe: s.
{
	csv skiedingsteken: [';'] oanhellingsteken: ['"'] rigels: { :line
		Utfier skriuwe: line, nije-rigel.
	}.
} fange: { :e 
	Utfier skriuwe: e, nije-rigel.
}, begjinne.

# invalid format
s := ['"he"llo";world'].
csv skriuwe: s.
{
	csv skiedingsteken: [';'] oanhellingsteken: ['"'] rigels: { :line
		Utfier skriuwe: line, nije-rigel.
	}.
} fange: { :e 
	Utfier skriuwe: e, nije-rigel.
}, begjinne.
