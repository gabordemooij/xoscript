>> items := List nĳ.
items set: ['grien'] by: ['color-1'].
items set: ['oranje'] by: ['color-2'].
items set: ['read'] by: ['color-3'].
>> i := 0.
>> s := [''].
items elk: { :key :kleur
	Utfier skriuwe: ['color #'] + i + [' is: '] + kleur + [' '].
	i optelle: 1.
}.
Utfier skriuwe: i + [' kleuren!'].
