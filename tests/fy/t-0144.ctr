



>> Kofjedrab := Objekt nĳ.
Kofjedrab by: ['trekke'] dwaan: { <- ['coffee']. }.

>> Kofjemasine := Objekt nĳ.
Kofjemasine by: ['init'] dwaan: {
	eigen kofjedrab := Kofjedrab nĳ.
}.
Kofjemasine by: ['nĳ'] dwaan: { <- Kofjemasine `new init.
}.

Kofjemasine by: ['meitsjeTee'] dwaan: { <- (eigen teeblêden trekke). }.
Kofjemasine by: ['meitsjeKofje'] dwaan: { <- (eigen kofjedrab trekke). }.

>> kofjedream := Kofjemasine nĳ.

Utfier skriuwe:
	kofjedream 
	meitsjeKofje.

Utfier skriuwe:
	kofjedream 
	meitsjeTee.
