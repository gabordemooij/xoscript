



>> CoffeeGrounds := Objekt nĳ.
CoffeeGrounds by: ['extract'] dwaan: { <- ['coffee']. }.

>> CoffeeMachine := Objekt nĳ.
CoffeeMachine by: ['init'] dwaan: {
	eigen coffeegrounds := CoffeeGrounds nĳ.
}.
CoffeeMachine by: ['nĳ'] dwaan: { <- CoffeeMachine `new init.
}.

CoffeeMachine by: ['makeTea'] dwaan: { <- (eigen tealeaves extract). }.
CoffeeMachine by: ['makeCoffee'] dwaan: { <- (eigen coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine nĳ.

Utfier skriuwe:
	coffeeDream 
	makeCoffee.

Utfier skriuwe:
	coffeeDream 
	makeTea.
