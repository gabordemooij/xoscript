>> Slurp := Objekt nĳ.

Slurp by: ['nĳ'] dwaan: {
	eigen str := [''].
}.

Slurp by: ['reagearje:'] dwaan: { :blah
		(eigen str = ['']) ja: {
			eigen str tafoegje: blah.
		}, oars: {
			eigen str tafoegje: [' '].
			eigen str tafoegje: blah.
		}.
}.

Slurp by: ['reagearje:en:'] dwaan: { :blah :blahah
		(blah lingte > 1) ja: {
			eigen str tafoegje: (blah fan: 0 lingte: (blah lingte - 1)).
		}, oars: {
			eigen str tafoegje: blah.
		}.
		eigen str tafoegje: [' '].
		eigen str tafoegje: blahah.
}.

Slurp by: ['krije'] dwaan: {
	>> buffer := eigen str.
	eigen str := ['']. <- buffer.
}.


>> x := Slurp nĳ.
x + 3.
Utfier skriuwe: (x krije), nije-rigel.
x echo: ['Hallo wrâld'].
Utfier skriuwe: (x krije), nije-rigel.
x tellme: 123 and: 987.
Utfier skriuwe: (x krije), nije-rigel.
