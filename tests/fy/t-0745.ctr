Utfier skriuwe: ['Test object'], nije-rigel.
>> a := Objekt nĳ. 

a by: ['item:'] dwaan: { :dict
	eigen dict := dict. 
}.

a by: ['item'] dwaan: { <- eigen dict.
}.

a item: (
List nĳ
	hello: ['world']).

>> old-dict-address := a item prototype ûnthâldadres.
a save-as: ['/tmp/a.bin'].
Utfier skriuwe: ['========== RELOADING SNAP:'], nije-rigel.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototype ûnthâldadres = old-dict-address) ja: {
	Utfier skriuwe: ['Object link re-attached.'], nije-rigel.
}.

Utfier skriuwe: b item, nije-rigel.
