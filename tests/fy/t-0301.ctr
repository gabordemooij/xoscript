


>> wyn := Objekt nĳ.


wyn by: ['neiTekst'] dwaan: { <- ['merlot'].
}.

wyn by: ['naarTekst'] dwaan: { <- ['merlot'].
}.


wyn by: ['='] dwaan: { :other wine <- ( sels neiTekst = other wine ).
}.

wyn by: ['=='] dwaan: { :other wine <- ( sels neiTekst = other wine ).
}.



wyn
	gefal: ['cabernet'] dwaan: { Utfier skriuwe: ['it is in Cabernet!']. },
	gefal: ['syrah']    dwaan: { Utfier skriuwe: ['it is in Syrah!'].    },
	gefal: ['merlot']   dwaan: { Utfier skriuwe: ['it is in Merlot!'].   },
	gefal: ['malbec']   dwaan: { Utfier skriuwe: ['it is in Malbec!'].   }.

Utfier nije-rigel.
