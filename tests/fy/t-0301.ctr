}.



wine
	gefal: ['cabernet'] dwaan: { Utfier skriuwe: ['it's a Cabernet!']. },
	gefal: ['syrah']    dwaan: { Utfier skriuwe: ['it's a Syrah!'].    },
	gefal: ['merlot']   dwaan: { Utfier skriuwe: ['it's a Merlot!'].   },
