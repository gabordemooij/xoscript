#Linux

(Bestand nĳ: ['/tmp/testje']) bestiet nee: {
	Programma systeem: ['mkdir /tmp/testje'].	
}.

(Bestand nĳ: ['/tmp/testje/file1']) bestiet nee: {
	Programma systeem: ['touch /tmp/testje/file1'].	
}.

(Bestand nĳ: ['/tmp/testje/folder1']) bestiet nee: {
	Programma systeem: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Bestand rige: ['/tmp/testje'].

>> q := Rige nĳ.

l elk: { :k :v v elk: { :x :y q tafoegje: y. }. }.

>> s := q tekst.

(s befettet: ['file1']) ja:   { Utfier skriuwe: ['OK'], nije-rigel. }.
(s befettet: ['file2']) ja:   { Utfier skriuwe: ['XX'], nije-rigel. }.
(s befettet: ['folder1']) ja: { Utfier skriuwe: ['OK'], nije-rigel. }.
