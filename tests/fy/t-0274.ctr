

Rige by: ['column:'] dwaan: { :kolom
	>> útkomst := Rige nĳ.
	sels elk: { :yndeks :tabelrige
		tabelrige elk: { :yndeks :sel
			(yndeks = kolom) ja: { útkomst tafoegje: sel. }.
		}.
	}. <- útkomst.
}.


>> a := Rige ←
	(Rige ← 1 ; 2 ; 3) ;
	(Rige ← 4 ; 5 ; 6) ;
	(Rige ← 7 ; 8 ; 9).

>> b := a column: 1.
Utfier skriuwe: b, nije-rigel.

b := a column: 20.
Utfier skriuwe: b, nije-rigel.

b := a column: -100.
Utfier skriuwe: b, nije-rigel.
