

Rige by: ['column:'] dwaan: { :column
	>> result := Rige nĳ.
	sels elk: { :index :row
		row elk: { :index :cell
			(index = column) ja: { result tafoegje: cell. }.
		}.
	}. <- result.
}.


>> a := Rige ←
	(Rige ← 1 ; 2 ; 3) ;
	(Rige ← 4 ; 5 ; 6) ;
	(Rige ← 7 ; 8 ; 9).

>> b := a column: 1.
Utfier skriuwe: b, nije-rigel.

b := a column: 20.
Utfier skriuwe: b, nije-rigel.

b := a column: -100.
Utfier skriuwe: b, nije-rigel.
