>> Punt := Objekt nĳ.
Punt by: ['x-coordinate:'] dwaan: { :x eigen x := x. }.
Punt by: ['y-coordinate:'] dwaan: { :y eigen y := y. }.
Punt by: ['x-koördinaat']  dwaan: { <- eigen x kopiearje. }.
Punt by: ['y-koördinaat']  dwaan: { <- eigen y kopiearje. }.

Punt by: ['='] dwaan: { :oar
	<- ( eigen x = oar x-koördinaat
		 en: eigen y = oar y-koördinaat ).
}.

>> steiger := Punt nĳ x-coordinate: 5, y-coordinate: 6.
>> stedhûs := Punt nĳ x-coordinate: 7, y-coordinate: 1.
>> restaurant := Punt nĳ x-coordinate: 5, y-coordinate: 6.

Utfier skriuwe: steiger = stedhûs, nije-rigel.
Utfier skriuwe: steiger = restaurant, nije-rigel.
