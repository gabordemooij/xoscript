>> Point := Objekt nĳ.
Point by: ['x-coordinate:'] dwaan: { :x eigen x := x. }.
Point by: ['y-coordinate:'] dwaan: { :y eigen y := y. }.
Point by: ['x-coordinate']  dwaan: { <- eigen x kopiearje. }.
Point by: ['y-coordinate']  dwaan: { <- eigen y kopiearje. }.

Point by: ['='] dwaan: { :other <- ( eigen x = other x-coordinate
		 en: eigen y = other y-coordinate ).
}.

>> pier := Point nĳ x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point nĳ x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point nĳ x-coordinate: 5, y-coordinate: 6.

Utfier skriuwe: pier = town-hall, nije-rigel.
Utfier skriuwe: pier = restaurant, nije-rigel.
