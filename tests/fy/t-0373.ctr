# konformiteitstest

# ynternasjonale getallen brûke

Utfier skriuwe: ['1000 -> '].
Utfier skriuwe: 1000, nije-rigel. #1000

Utfier skriuwe: ['1.5 -> '].
Utfier skriuwe: 1.5, nije-rigel.  #1.5

Utfier skriuwe: ['1001.5 -> '].
Utfier skriuwe: 1.5 + 1000, nije-rigel. #1001.5

# arrays brûke dy't by 0 begjinne
>> x := Rige nĳ ; 1 ; 2 ; 3.
>> y := Rige nĳ ; ['a'] ; ['b'] ; ['c'].

Utfier skriuwe: ['1 -> '].
Utfier skriuwe: x ? 0, nije-rigel. #1

Utfier skriuwe: ['1 -> '].
Utfier skriuwe: (x by: 0), nije-rigel. #1

Utfier skriuwe: ['1 -> '].
Utfier skriuwe: x earste, nije-rigel. #1

Utfier skriuwe: ['3 -> '].
Utfier skriuwe: x lêste, nije-rigel. #3

Utfier skriuwe: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Utfier skriuwe: (x per: y), nije-rigel.

Utfier skriuwe: ['1 -> '].
Utfier skriuwe: (x fan: 0 lingte: 1) earste, nije-rigel. #1

Utfier skriuwe: ['0 -> '].
Utfier skriuwe: (x fine: 1), nije-rigel. #0

x set: 9 by: 0.

Utfier skriuwe: ['9 -> '].
Utfier skriuwe: (x by: 0), nije-rigel. #9

x foaroan-tafoegje: 8.
Utfier skriuwe: ['8 -> '].
Utfier skriuwe: (x by: 0), nije-rigel. #9


x tafoegje: 10.
Utfier skriuwe: ['10 -> '].
Utfier skriuwe: (x by: 4), nije-rigel. #10








