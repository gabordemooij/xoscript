Utfier skriuwe: ['Test object'], nije-rigel.
>> a := Objekt nĳ. 

a by: ['item:'] dwaan: { :binhelper
	eigen binhelper := binhelper. 
}.

a by: ['item'] dwaan: { <- eigen binhelper.
}.

a item: Bin nĳ.

>> old-binhelper-address := a item prototype ûnthâldadres.
a save-as: ['/tmp/a.bin'].
Utfier skriuwe: ['========== RELOADING SNAP:'], nije-rigel.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototype ûnthâldadres = old-binhelper-address) ja: {
	Utfier skriuwe: ['Object link re-attached.'], nije-rigel.
}.


