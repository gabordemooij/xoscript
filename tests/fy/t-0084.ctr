>> meitsjeOptieler := { :x
	>> f := { :y <- (eigen x + y). } ynstelle: ['x'] wearde: x. <- f.
}.
>> ôfbylder := { :reeks :fnk
	>> ôfbylding := { :i eigen q set: (eigen f tapasse: (eigen q ? i)) by: i. } 
	ynstelle: ['q'] wearde: reeks,
	ynstelle: ['f'] wearde: fnk.
	{ :i ôfbylding tapasse: i. } × (reeks telle).
}.

>> a := Rige ← 1; 2; 3.
ôfbylder tapasse: a en: (meitsjeOptieler tapasse: 100).
Utfier skriuwe: (a posysje: 0), nije-rigel.
Utfier skriuwe: (a ? 1), nije-rigel.
Utfier skriuwe: (a ? 2), nije-rigel.
