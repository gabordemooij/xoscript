>> makeAdder := { :x
	>> f := { :y <- (eigen x + y). } ynstelle: ['x'] wearde: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i eigen q set: (eigen f tapasse: (eigen q ? i)) by: i. } 
	ynstelle: ['q'] wearde: array,
	ynstelle: ['f'] wearde: func.
	{ :i mapping tapasse: i. } × (array telle).
}.

>> a := Rige ← 1; 2; 3.
mapper tapasse: a en: (makeAdder tapasse: 100).
Utfier skriuwe: (a posysje: 0), nije-rigel.
Utfier skriuwe: (a ? 1), nije-rigel.
Utfier skriuwe: (a ? 2), nije-rigel.
