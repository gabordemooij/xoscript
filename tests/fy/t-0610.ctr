
>> Rjochthoek := Objekt nĳ.

Rjochthoek by: ['oerflak'] dwaan: {
	<- eigen lingte * eigen breedte.
}.

Rjochthoek by: ['length:'] dwaan: { :lingte
	eigen lingte := lingte.
}.

Rjochthoek by: ['width:'] dwaan: { :breedte
	eigen breedte := breedte.
}.

Rjochthoek by: ['nĳ'] dwaan: {
	# dit liedt net ta in ûneinige lus
	>> rjochthoek := sels nĳ.
	rjochthoek length: 0, width: 0.
	<- rjochthoek.
}.

>> a := Rjochthoek nĳ.
Utfier skriuwe: a oerflak, nije-rigel. #0

>> b := Rjochthoek nĳ length: 2, width: 3.
Utfier skriuwe: b oerflak, nije-rigel. #6

