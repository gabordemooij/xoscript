
>> Rectangle := Objekt nĳ.

Rectangle by: ['area'] dwaan: { <- eigen lingte * eigen width.
}.

Rectangle by: ['length:'] dwaan: { :lingte
	eigen lingte := lingte.
}.

Rectangle by: ['width:'] dwaan: { :width
	eigen width := width.
}.

Rectangle by: ['nĳ'] dwaan: {
	# this will not result into an infinite loop
	>> rectangle := sels nĳ.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle nĳ.
Utfier skriuwe: a area, nije-rigel. #0

>> b := Rectangle nĳ length: 2, width: 3.
Utfier skriuwe: b area, nije-rigel. #6

