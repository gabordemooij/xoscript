Utfier skriuwe: ['Continue for-loop, No - before 6 and up.'], nije-rigel.
{ :i
	Utfier skriuwe: (i + 1), nije-rigel.
	((i + 1) > 4) trochgean.
	Utfier skriuwe: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Utfier nije-rigel.
Utfier skriuwe: ['Continue while-true, No --> before 5 and up.'], nije-rigel.
{
	Utfier skriuwe: ['iteration #'] + x, nije-rigel.
	x optelle: 1.
	((x < 5) net) trochgean.
	Utfier skriuwe: ['-->'].
} wylst: xIsLessThan10.
Utfier nije-rigel.
Utfier skriuwe: ['Continue while-false, No - before 3 only.'], nije-rigel.
{
	Utfier skriuwe: ['iteration #'] + x, nije-rigel.
	x ôflûke: 1.
	(x = 3) trochgean.
	Utfier skriuwe: ['-'].
} wylst: { <- ( x > 0). }.

Utfier nije-rigel.
Utfier skriuwe: ['Continue times-loop, No ||| before 3.'], nije-rigel.
{ :i
	Utfier skriuwe: ['iteration #'] + i, nije-rigel.
	(i = 2) trochgean.
	Utfier skriuwe: ['|||'].
} × 5.

Utfier nije-rigel.

{ Ja trochgean. Utfier skriuwe: ['dont write this!'], nije-rigel. } begjinne.

{ Ja trochgean. Utfier skriuwe: ['dont write this!'], nije-rigel. } fange: { Utfier skriuwe: ['Dont catch this!']. }, begjinne.

Utfier skriuwe: ['Test Array each-loop: 0, ... ,2'], nije-rigel.
(Rige ← 1 ; 2 ; 3) ôfbyldzje: { :i
	(i = 1) trochgean.
	Utfier skriuwe: ['iteration #'] + (i - 0), nije-rigel.
}.

Utfier skriuwe: ['Test Map each-loop: c only'], nije-rigel.
>> m := List nĳ.
m set: ['first'] by: ['a'], set: ['second'] by: ['b'], set: ['third'] by: ['c'].
m elk: { :k :v
	(k ≠ ['c']) trochgean.
	Utfier skriuwe: ['iteration'] + k + v, nije-rigel.
}.

