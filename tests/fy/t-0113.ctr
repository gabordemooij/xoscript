Utfier skriuwe: ['Trochgean for-lus, Gjin - foar 6 en heger.'], nije-rigel.
{ :i
	Utfier skriuwe: (i + 1), nije-rigel.
	((i + 1) > 4) trochgean.
	Utfier skriuwe: ['-'].
} × 10.

>> x := 0.
>> xIsLytserAs10 := { <- ( x < 10 ). }.
Utfier nije-rigel.
Utfier skriuwe: ['Trochgean while-true, Gjin --> foar 5 en heger.'], nije-rigel.
{
	Utfier skriuwe: ['iteration #'] + x, nije-rigel.
	x optelle: 1.
	((x < 5) net) trochgean.
	Utfier skriuwe: ['-->'].
} wylst: xIsLytserAs10.
Utfier nije-rigel.
Utfier skriuwe: ['Trochgean while-false, Gjin - allinne foar 3.'], nije-rigel.
{
	Utfier skriuwe: ['iteration #'] + x, nije-rigel.
	x ôflûke: 1.
	(x = 3) trochgean.
	Utfier skriuwe: ['-'].
} wylst: { <- ( x > 0). }.

Utfier nije-rigel.
Utfier skriuwe: ['Trochgean times-lus, Gjin ||| foar 3.'], nije-rigel.
{ :i
	Utfier skriuwe: ['iteration #'] + i, nije-rigel.
	(i = 2) trochgean.
	Utfier skriuwe: ['|||'].
} × 5.

Utfier nije-rigel.

{ Ja trochgean. Utfier skriuwe: ['skriuw dit net!'], nije-rigel. } begjinne.

{ Ja trochgean. Utfier skriuwe: ['skriuw dit net!'], nije-rigel. } fange: { Utfier skriuwe: ['Fang dit net!']. }, begjinne.

Utfier skriuwe: ['Test Rige elk-lus: 0, ... ,2'], nije-rigel.
(Rige ← 1 ; 2 ; 3) ôfbyldzje: { :i
	(i = 1) trochgean.
	Utfier skriuwe: ['iteration #'] + (i - 0), nije-rigel.
}.

Utfier skriuwe: ['Test Keppeling elk-lus: allinne c'], nije-rigel.
>> m := List nĳ.
m set: ['first'] by: ['a'], set: ['second'] by: ['b'], set: ['tredde'] by: ['c'].
m elk: { :k :v
	(k ≠ ['c']) trochgean.
	Utfier skriuwe: ['iteration'] + k + v, nije-rigel.
}.

