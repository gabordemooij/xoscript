


>> brûkt-ûnthâld1 := 0.
>> brûkt-ûnthâld2 := 0.
>> brûkt-ûnthâld3 := 0.
>> brûkt-ûnthâld4 := 0.

Programma geheugenbehear: 0.
>> palet := Neat.
>> kleuren := Neat.

{
palet := List nĳ.
palet 
	set: ['#F00'] by: ['read'],
	set: ['#0F0'] by: ['grien'],
	set: ['#00F'] by: ['blau'].
Utfier skriuwe: ['oantal RGB-koades yn palet: '] + ( palet telle ), nije-rigel.
Utfier skriuwe: ['RGB-koade fan grien is: '] + ( palet ? ['grien'] ), nije-rigel.
kleuren := [''].
( palet elk: { :namme :koade
		kleuren := kleuren + ( namme + [':'] + koade ).
} ).
Utfier skriuwe: ['Alle kleuren yn palet: '] + kleuren, nije-rigel.
} begjinne.
Programma opromje.
brûkt-ûnthâld1 := (Programma ûnthâld ? 0).

