{
palette := List nĳ.
palette 
	set: ['#F00'] by: ['red'],
	set: ['#0F0'] by: ['green'],
	set: ['#00F'] by: ['blue'].
Utfier skriuwe: ['number of RGB codes in palette: '] + ( palette telle ), nije-rigel.
Utfier skriuwe: ['RGB code of green is: '] + ( palette ? ['green'] ), nije-rigel.
colors := [''].
( palette elk: { :namme :koade
		colors := colors + ( namme + [':'] + koade ).
} ).
Utfier skriuwe: ['All colors in palette: '] + colors, nije-rigel.
} begjinne.
Programma opromje.
usedMemory1 := (Programma ûnthâld ? 0).

