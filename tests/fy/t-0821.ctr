# in oanhellingsteken dat nea sluten wurdt moat in flater jaan, gjin ûneinige lus
>> paad := ['/tmp/test0821.csv'].
>> file := Bestand nĳ: paad.

file skriuwe: ['a,b\n"1,2\n'].
{
	file skiedingsteken: [','] oanhellingsteken: ['"'] rigels: { :line
		Utfier skriuwe: line, nije-rigel.
	}.
} fange: { :e Utfier skriuwe: e, nije-rigel. }, begjinne.

# in sluten oanhellingsteken wurket noch
file skriuwe: ['a,b\n"1,2",3'].
file skiedingsteken: [','] oanhellingsteken: ['"'] rigels: { :line
	Utfier skriuwe: line, nije-rigel.
}.
file wiskje.
