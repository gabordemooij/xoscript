Programma geheugenbehear: 4.

>> Doubler := Objekt nĳ.
>> Multiplier := Objekt nĳ.
Doubler by: ['double:and:'] dwaan: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier by: ['multiply:and:'] dwaan: { :x :y <- (x × y).
}.

Utfier skriuwe: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), nije-rigel.
