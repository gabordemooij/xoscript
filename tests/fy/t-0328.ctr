Programma geheugenbehear: 4.

>> Ferdûbeler := Objekt nĳ.
>> Fermannichfâldiger := Objekt nĳ.
Ferdûbeler by: ['ferdûbelje:en:'] dwaan: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Fermannichfâldiger by: ['fermannichfâldigje:mei:'] dwaan: { :x :y <- (x × y).
}.

Utfier skriuwe: (
	Ferdûbeler ferdûbelje:
		(Ferdûbeler ferdûbelje: 
			(Fermannichfâldiger fermannichfâldigje: 2 mei: 3)
		en:
			(Fermannichfâldiger fermannichfâldigje: 3 mei: 4)
		)
	en:
		(Ferdûbeler ferdûbelje: 
			(Fermannichfâldiger fermannichfâldigje: 2 mei: 3)
		en:
			(Fermannichfâldiger fermannichfâldigje: 3 mei: 4)
		)
), nije-rigel.
