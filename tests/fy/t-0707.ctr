# test typekonversjes / omsettingen / bindingen
Programma geheugenbehear: 4.
Server init.

>> teller := 0.
>> db := Maria-DB nĳ host: ['localhost'],
	brûkersnamme: ['xo'], wachtwurd: ['pass123'], databanknamme: ['xobase'], ferbine.

>> TwaSifersFormaat := Formaat nĳ: ['%02d'].

# Datumtiid
{
	>> jier     := Getal tusken: 1995 en: 2050, tekst.
	>> moanne    := TwaSifersFormaat tapasse-int: (Getal tusken: 1 en: 12), tekst.
	>> dei      := TwaSifersFormaat tapasse-int: (Getal tusken: 1 en: 28), tekst.
	>> oere     := TwaSifersFormaat tapasse-int: (Getal tusken: 1 en: 23), tekst.
	>> minút   := TwaSifersFormaat tapasse-int: (Getal tusken: 1 en: 59), tekst.
	>> sekonde   := TwaSifersFormaat tapasse-int: (Getal tusken: 1 en: 59), tekst.
	>> datumtiid := ['YYYY-MM-DD HH:II:SS'].	
	datumtiid
		YYYY: jier,
		MM: moanne,
		DD: dei,
		HH: oere,
		II: minút,
		SS: sekonde.
	>> sykparameters :=
	db fraach: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: datumtiid),
	ophelje: { :tabelrige
		(tabelrige mydatetime = datumtiid) nee: {
			dizze-taak flater: (
				['Ferwachte: <expected> mar krigen: <observation>']
				<expected>: datumtiid,
				<observation>: tabelrige mydatetime
			).
		}.
	
	}.
	teller optelle: 1.
} * 100.

# Datum
{
	>> jier     := Getal tusken: 1995 en: 2050, tekst.
	>> moanne    := TwaSifersFormaat tapasse-int: (Getal tusken: 1 en: 12), tekst.
	>> dei      := TwaSifersFormaat tapasse-int: (Getal tusken: 1 en: 28), tekst.
	>> datum     := ['YYYY-MM-DD'].
	datum
		YYYY: jier,
		MM: moanne,
		DD: dei.
	>> sykparameters :=
	db fraach: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: datum),
	ophelje: { :tabelrige
		(tabelrige mydate = datum) nee: {
			dizze-taak flater: (
				['Ferwachte: <expected> mar krigen: <observation>']
				<expected>: datum,
				<observation>: tabelrige mydate
			).
		}.
	}.
	teller optelle: 1.
} * 100.


# Tiid
{
	>> oere     := TwaSifersFormaat tapasse-int: (Getal tusken: 1 en: 23), tekst.
	>> minút   := TwaSifersFormaat tapasse-int: (Getal tusken: 1 en: 59), tekst.
	>> sekonde   := TwaSifersFormaat tapasse-int: (Getal tusken: 1 en: 59), tekst.
	>> tiid := ['HH:II:SS'].
	tiid
		HH: oere,
		II: minút,
		SS: sekonde.
	>> sykparameters :=
	db fraach: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: tiid),
	ophelje: { :tabelrige
		(tabelrige mytime = tiid) nee: {
			dizze-taak flater: (
				['Ferwachte: <expected> mar krigen: <observation>']
				<expected>: datumtiid,
				<observation>: tabelrige mytime
			).
		}.
	}.
	teller optelle: 1.
} * 100.


# Teksten (varchar/text)
>> str1 := Rige nĳ folje: 100000 mei: ['x'], gearfoegje: [''].
{
	>> str2 := Klûs token: 40.
	>> sykparameters :=
	db fraach: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	ophelje: { :tabelrige
		(tabelrige str1 = str1 en: tabelrige str2 = str2) nee: {
			dizze-taak flater: (
				['Ferwachte: <expected> mar krigen: <observation>']
				<expected>: datumtiid,
				<observation>: tabelrige mytime
			).
		}.
	}.
	teller optelle: 1.
} * 100.


# Getallen
{
	>> n1  := Getal tusken: 1 en: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 út-tekst: ['9223372036854775807'] ) -
		( Int64 út-tekst: ['99999'] ) +
		( Int64 út-tekst: n1 tekst )
	).
	>> sykparameters :=
	db fraach: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	ophelje: { :tabelrige
		(tabelrige n1 = n1) nee: {
			dizze-taak flater: (
				['Ferwachte: <expected> mar krigen: <observation>']
				<expected>: n1,
				<observation>: tabelrige n1
			).
		}.
		(tabelrige n2 = n2) nee: {
			dizze-taak flater: (
				['Ferwachte: <expected> mar krigen: <observation>']
				<expected>: n1,
				<observation>: tabelrige n2
			).
		}.
		(tabelrige n3 = n2 ôfrûne) nee: {
			dizze-taak flater: (
				['Ferwachte: <expected> mar krigen: <observation>']
				<expected>: n1,
				<observation>: tabelrige n3
			).
		}.
		(tabelrige big = big) nee: {
			dizze-taak flater: (
				['Ferwachte: <expected> mar krigen: <observation>']
				<expected>: big,
				<observation>: tabelrige big
			).
		}.
		
	}.
	teller optelle: 1.
} * 100.


Utfier skriuwe: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: teller
), nije-rigel.