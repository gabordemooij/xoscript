Tekst by: ['evaluearje'] dwaan: {
	>> koade := Bestand nĳ: ['/tmp/eval.ctr'].
	koade skriuwe: (sels tekst + ['.']).
	Programma brûke: ['/tmp/eval.ctr'].
}.

>> a := Rige ← 1 ; 2 ; 3.
>> b := (a tekst).

Utfier skriuwe: b, nije-rigel. 
(['b := '] + b) evaluearje.

Utfier skriuwe: b ? 2, nije-rigel. 

Utfier skriuwe: (( Rige ← 1 ; 2 ; 3 )), nije-rigel. 

Utfier skriuwe: ((List nĳ) set: 1 by: 2), nije-rigel. 

>> x := ( (Rige ← 1 ; ( Rige ← 9 ) ; Ja ) ) tekst.
Utfier skriuwe: x, nije-rigel. 
(['x := '] + x) evaluearje.

Utfier skriuwe: x ? 1 ? 0, nije-rigel. 

>> y := (List nĳ) set: (Rige ← 1) by: (Rige ← 2).
Utfier skriuwe: y, nije-rigel. 

(['y := '] + y) tekst evaluearje.

Utfier skriuwe: (y by: (Rige ← 2) tekst ), nije-rigel.

Utfier skriuwe: (Rige nĳ), nije-rigel. 
Utfier skriuwe: (List nĳ), nije-rigel. 
