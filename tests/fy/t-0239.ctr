Rige by: ['sum'] dwaan: {
	>> total := 0.
	sels elk: { :index :element
		total optelle: element.
	}. <- total.
}.

>> a := Ja.



a by: ['tekst'] dwaan: {
	>> answer := Neat.
	( sels = Ja ) ja: {
		answer := ['Yep'].
	}, oars: {
		answer := ['Nope'].
	}. <- answer.
}.

a by: ['getal'] dwaan: {
	>> answer := Neat.
	( sels = Ja ) ja: {
		answer := 10.
	}, oars: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b by: ['tekst'] dwaan: { <- ['Devil'].
}.

b by: ['boolean'] dwaan: { <- Nee.
}.


Utfier skriuwe: a, nije-rigel.  
Utfier skriuwe: (90 + a), nije-rigel. 
Utfier skriuwe: b, nije-rigel. 
Utfier skriuwe: (Ja en: b), nije-rigel.

a := Rige ← ['hello'] ; ['world'] ; Ja ; Neat ; 666. 
a := a + ( Rige ← 1 ).
Utfier skriuwe: a, nije-rigel.
Utfier skriuwe: ((List nĳ) set: Neat by: Neat), nije-rigel.
Utfier skriuwe: a sum, nije-rigel. 


{
	a by: ['tekst'] dwaan: { <- Neat. }.
	a := [''] + a.
} fange: { :error
	Utfier skriuwe: ['Error noted: '] + error, nije-rigel.
}, begjinne.



{
	a by: ['getal'] dwaan: { <- Neat. }.
	a := 3 × a.
} fange: { :error
	Utfier skriuwe: ['Error noted: '] + error, nije-rigel.
}, begjinne.


