Rige by: ['som'] dwaan: {
	>> totaal := 0.
	sels elk: { :yndeks :elemint
		totaal optelle: elemint.
	}. <- totaal.
}.

>> a := Ja.



a by: ['tekst'] dwaan: {
	>> antwurd := Neat.
	( sels = Ja ) ja: {
		antwurd := ['Jep'].
	}, oars: {
		antwurd := ['Nee hear'].
	}. <- antwurd.
}.

a by: ['getal'] dwaan: {
	>> antwurd := Neat.
	( sels = Ja ) ja: {
		antwurd := 10.
	}, oars: {
		antwurd := 20.
	}. <- antwurd.
}.

>> b := 666.

b by: ['tekst'] dwaan: { <- ['Duvel'].
}.

b by: ['boolean'] dwaan: { <- Nee.
}.


Utfier skriuwe: a, nije-rigel.  
Utfier skriuwe: (90 + a), nije-rigel. 
Utfier skriuwe: b, nije-rigel. 
Utfier skriuwe: (Ja en: b), nije-rigel.

a := Rige ← ['hello'] ; ['world'] ; Ja ; Neat ; 666. 
a := a + ( Rige ← 1 ).
Utfier skriuwe: a, nije-rigel.
Utfier skriuwe: ((List nĳ) set: Neat by: Neat), nije-rigel.
Utfier skriuwe: a som, nije-rigel. 


{
	a by: ['tekst'] dwaan: { <- Neat. }.
	a := [''] + a.
} fange: { :fout
	Utfier skriuwe: ['Flater notearre: '] + fout, nije-rigel.
}, begjinne.



{
	a by: ['getal'] dwaan: { <- Neat. }.
	a := 3 × a.
} fange: { :fout
	Utfier skriuwe: ['Flater notearre: '] + fout, nije-rigel.
}, begjinne.


{
	a by: ['boolean'] dwaan: { <- Neat. }.
	a := Ja en: a. 
} fange: { :fout
	Utfier skriuwe: ['Flater notearre: '] + fout, nije-rigel.
}, begjinne.





