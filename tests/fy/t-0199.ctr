
Programma geheugenbehear: 4.

>> Dier := Objekt nĳ.
Dier by: ['meitsje'] dwaan: {
	>> dier := Objekt nĳ.
	dier by: ['meitsjeLûd'] dwaan: {
		Utfier skriuwe: eigen lûd.
	}. <- dier.
}.
>> Kat := Objekt nĳ.
Kat by: ['meitsje'] dwaan: {
	>> kat := Dier meitsje.
	kat by: ['init'] dwaan: {
		eigen lûd := ['meow!'].
	}.
	kat init. <- kat.
}.
>> tom := Kat meitsje.
tom meitsjeLûd.
