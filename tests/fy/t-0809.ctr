# backslashes must survive code serialization, strings must not end early
>> wearden := Rige nĳ
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

wearden elk: { :i :value
	>> d := List nĳ.
	d set: value by: ['k'].
	>> r := d koade objekt.
	Utfier skriuwe: r telle, nije-rigel.
	Utfier skriuwe: ( (r by: ['k']) = value ), nije-rigel.
}.
