>> items := List nĳ.
items set: ['swart'] by: ['coffee'], set: ['earl grey'] by: ['tee'].
Utfier skriuwe: (items by: ['coffee']), skriuwe: (items by: ['tee']).
Utfier skriuwe: ['der binne'] + items telle + [' ûnderdielen yn de rige.'].
items set: ['capuccino'] by: ['coffee'].
Utfier skriuwe: ['No is myn kofje.. '] + (items by: ['coffee']).
items set: ['aaa'] by: ['1'].
items set: ['bbb'] by: ['2'].
Utfier skriuwe: (items by: ['a']).
