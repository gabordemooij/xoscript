>> items := List nĳ.
items set: ['black'] by: ['coffee'], set: ['earl grey'] by: ['tea'].
Utfier skriuwe: (items by: ['coffee']), skriuwe: (items by: ['tea']).
Utfier skriuwe: ['there are'] + items telle + [' items in the array.'].
items set: ['capuccino'] by: ['coffee'].
Utfier skriuwe: ['Now my coffee is.. '] + (items by: ['coffee']).
items set: ['aaa'] by: ['1'].
items set: ['bbb'] by: ['2'].
Utfier skriuwe: (items by: ['a']).
