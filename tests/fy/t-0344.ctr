# catch-all test (practical)
>> HTML := Tekst nĳ.
HTML by: ['encode:'] dwaan: { :tekst
	sels tafoegje: (tekst
	ferfange: ['&'] troch: ['&amp;'], 
	ferfange: ['<'] troch: ['&lt;'],
	ferfange: ['>'] troch: ['&gt;'],
	ferfange: ['"'] troch: ['&quot;']).
}.
>> blog := HTML nĳ.
blog tafoegje: ['<h1>'],
     encode: ['Koffie & Thee'],
     tafoegje: ['</h1>'].
Utfier skriuwe: blog, nije-rigel.


>> Roman := Getal nĳ.
Roman by: ['stringy'] dwaan: {
	>> a := [''].
	{ a tafoegje: ['I']. } × sels. <- a.
}.

>> x := Roman nĳ.
x optelle: 3.
Utfier skriuwe: x stringy, nije-rigel.

>> Quantum := Boolean nĳ.
Quantum by: ['true?'] dwaan: { <- ['maybe True']. }.
Utfier skriuwe: (Quantum nĳ true?), nije-rigel.

>> Nihil := Neat nĳ.
Nihil by: ['tekst'] dwaan: { <- ['Nihil']. }.
Utfier skriuwe: (Nihil nĳ), nije-rigel.
