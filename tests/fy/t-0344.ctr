# catch-all-test (praktysk)
>> HTMLTekst := Tekst nĳ.
HTMLTekst by: ['encode:'] dwaan: { :ynfiertekst
	sels tafoegje: (ynfiertekst
	ferfange: ['&'] troch: ['&amp;'], 
	ferfange: ['<'] troch: ['&lt;'],
	ferfange: ['>'] troch: ['&gt;'],
	ferfange: ['"'] troch: ['&quot;']).
}.
>> blog := HTMLTekst nĳ.
blog tafoegje: ['<h1>'],
     encode: ['Koffie & Thee'],
     tafoegje: ['</h1>'].
Utfier skriuwe: blog, nije-rigel.


>> Romeinsk := Getal nĳ.
Romeinsk by: ['tekstich'] dwaan: {
	>> a := [''].
	{ a tafoegje: ['I']. } × sels. <- a.
}.

>> x := Romeinsk nĳ.
x optelle: 3.
Utfier skriuwe: x tekstich, nije-rigel.

>> Quantum := Boolean nĳ.
Quantum by: ['true?'] dwaan: { <- ['miskien Ja']. }.
Utfier skriuwe: (Quantum nĳ true?), nije-rigel.

>> Nihil := Neat nĳ.
Nihil by: ['tekst'] dwaan: { <- ['Nihil']. }.
Utfier skriuwe: (Nihil nĳ), nije-rigel.
