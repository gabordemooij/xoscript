Getal by: ['fakulteit'] dwaan: {
	>> totaal := 1.
	{ :yndeks totaal fermannichfâldigje-mei: (sels - (yndeks)). } × sels. <- totaal.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Utfier skriuwe: a.
>> b := 2 + 3 fakulteit.
Utfier skriuwe: b.
>> c := 3 fakulteit + 2.
Utfier skriuwe: c.
>> d := 2 + (3 fakulteit).
Utfier skriuwe: d.
Utfier skriuwe: 2 + 3 fakulteit + 1.
