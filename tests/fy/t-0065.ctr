Getal by: ['fakulteit'] dwaan: {
	>> totaal := 1.
	{ :yndeks totaal fermannichfâldigje-mei: (sels - (yndeks)). } × sels. <- totaal.
}.
>> Drukker := Objekt nĳ.
Drukker by: ['printsje:en:'] dwaan: { :x :y
	Utfier skriuwe: ['a='] + x + [', b='] + y, nije-rigel.
}.
>> a := 4.5. >> b := a ôfrûnje-del.
Drukker printsje: a en: b.
a := 4. b := a fakulteit.
Drukker printsje: a en: b.
a := 4.5. b := a ôfrûnje-op.
Drukker printsje: a en: b.
a := 4.5. b := a ôfrûnje-del.
Drukker printsje: a en: b.
a := 4.5. b := a ôfrûne.
Drukker printsje: a en: b.
a := 4.2. b := a ôfrûne.
Drukker printsje: a en: b.

