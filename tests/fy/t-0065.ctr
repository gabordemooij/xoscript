Getal by: ['factorial'] dwaan: {
	>> total := 1.
	{ :index total fermannichfâldigje-mei: (sels - (index)). } × sels. <- total.
}.
>> Printer := Objekt nĳ.
Printer by: ['print:and:'] dwaan: { :x :y
	Utfier skriuwe: ['a='] + x + [', b='] + y, nije-rigel.
}.
>> a := 4.5. >> b := a ôfrûnje-del.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a ôfrûnje-op.
Printer print: a and: b.
a := 4.5. b := a ôfrûnje-del.
Printer print: a and: b.
a := 4.5. b := a ôfrûne.
Printer print: a and: b.
a := 4.2. b := a ôfrûne.
Printer print: a and: b.

