
Tekst by: ['evaluearje'] dwaan: {
	>> koade := Bestand nĳ: ['/tmp/eval.ctr'].
	koade skriuwe: (sels tekst + ['.']).
	Programma brûke: ['/tmp/eval.ctr'].
}.

>> map :=
	(List nĳ)
	set: ['Hoi Dêr'] by: ['two'],
	set: (Rige ← ['hello'] ; ['world'] ; (Rige ← 1 ; 2; 9) ; Nee) by: ['ien'],
	set: ( (List nĳ) set: ['wrrld'] by: ['ferkeard-stavere'] ) by: ['three'],
	set: (Rige ← ((List nĳ) set: ['skat'] by: ['ferstoppe']) ; 2) by: ['fjouwer']. 
>> str := map tekst.
>> map2 := Neat.
(['map2 := '] + str ) evaluearje.
Utfier skriuwe: map2 ? ['ien'] ? 0.
Utfier skriuwe: map2 ? ['ien'] ? 1.
Utfier skriuwe: map2 ? ['fjouwer'] ? 0 ? ['ferstoppe'].
Utfier skriuwe: map2 ? ['ien'] ? 2 ? 2.
