
Tekst by: ['evaluate'] dwaan: {
	>> koade := Bestand nĳ: ['/tmp/eval.ctr'].
	koade skriuwe: (sels tekst + ['.']).
	Programma brûke: ['/tmp/eval.ctr'].
}.

>> map :=
	(List nĳ)
	set: ['Hi There'] by: ['two'],
	set: (Rige ← ['hello'] ; ['world'] ; (Rige ← 1 ; 2; 9) ; Nee) by: ['one'],
	set: ( (List nĳ) set: ['wrrld'] by: ['misspelled'] ) by: ['three'],
	set: (Rige ← ((List nĳ) set: ['treasure'] by: ['hidden']) ; 2) by: ['four']. 
>> str := map tekst.
>> map2 := Neat.
(['map2 := '] + str ) evaluate.
Utfier skriuwe: map2 ? ['one'] ? 0.
Utfier skriuwe: map2 ? ['one'] ? 1.
Utfier skriuwe: map2 ? ['four'] ? 0 ? ['hidden'].
Utfier skriuwe: map2 ? ['one'] ? 2 ? 2.
