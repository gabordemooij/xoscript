
Tekst by: ['html'] dwaan: { <- (
		sels
		ferfange: ['&'] troch: ['&amp;'],
		ferfange: ['<'] troch: ['&lt;'],
		ferfange: ['>'] troch: ['&gt;'],
		ferfange: ['"'] troch: ['&quot;']
	).
}.

>> HtmlKwast := Objekt nĳ.

HtmlKwast by: ['reagearje:'] dwaan: { :tag
	Utfier skriuwe: (['<tag>↵'] tag: tag ).
}.

HtmlKwast by: ['reagearje:en:'] dwaan: { :tag :content
	tag := ( tag fan: 0 lingte: (tag lingte - 1) ).
	Utfier skriuwe: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlKwast by: ['content:'] dwaan: { :tekststik
	Utfier skriuwe: tekststik html, nije-rigel.
}.

HtmlKwast by: ['attr:wearde:'] dwaan: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlKwast nĳ.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] wearde: ['bold']),
		/span
	/body
/html.
		
