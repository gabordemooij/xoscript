

>> g  := Server nĳ.
>> v  := Klûs nĳ.
>> ok := 0.

>> geheimen := Rige nĳ ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> wachtwurden := geheimen kopiearje.
wachtwurden elk: { :i :p
	geheimen elk: { :n :s
		{
			>> fersifere := v fersiferje: s kaai: p.
			>> ûntsifere := v ûntsiferje: fersifere kaai: p.
			(ûntsifere = s) ja: {
				ok optelle: 1.
			}, oars: {
				Utfier skriuwe: ['fersiferjen/ûntsiferjen mislearre: '], nije-rigel.
				Utfier skriuwe: s, nije-rigel.
				Utfier skriuwe: ['fersifere: '] + fersifere, nije-rigel.
				Utfier skriuwe: ['ûntsifere: '] + fersifere, nije-rigel.
				Programma ein.
			}.
		} fange: { :flt
			(s = [''] of: p = ['']) ja: {
				ok optelle: 1.
			}, oars: {
				Utfier skriuwe: flt, nije-rigel.
				Programma ein.
			}.
		}, begjinne.
	}.
}.

Utfier skriuwe: ( ok + [' klûsfersiferingen hifke.'] ), nije-rigel.