Boolean by: ['xor:'] dwaan: { :a :b <- ((a en: b net) of: (a net en: b)).
}.

>> o := Objekt nĳ.
o by: ['hello'] dwaan: { ['Leech']. }.
{ o by: 2 dwaan: 3.} fange: { :e Utfier skriuwe: e, nije-rigel. }, begjinne.
{ o by: ['test'] dwaan: 3.} fange: { :e Utfier skriuwe: e, nije-rigel. }, begjinne.
{ o by: ['hello'] dwaan: { ['Leech']. }.} fange: { :e Utfier skriuwe: e, nije-rigel. }, begjinne. 
{ >> z := 4 ÷ 0. } fange: { :e Utfier skriuwe: e, nije-rigel. }, begjinne. 
{ (Ja en: Neat) ja: { Utfier skriuwe: ['X'].}. } fange: { :e Utfier skriuwe: e, nije-rigel. }, begjinne. 
{ ([''] xor: 0) ja: { Utfier skriuwe: ['X'].}. } fange: { :e Utfier skriuwe: e, nije-rigel. }, begjinne. 
{ (1 < ['2']) ja: { Utfier skriuwe: ['OK']. }. } fange: { :e Utfier skriuwe: e, nije-rigel. }, begjinne. 
{ (1 < ['2.0']) ja: { Utfier skriuwe: ['OK']. }. } fange: { :e Utfier skriuwe: e, nije-rigel. }, begjinne. 
{ (1 < ['x2.0']) ja: { Utfier skriuwe: ['NEE!']. }. } fange: { :e Utfier skriuwe: e, nije-rigel. }, begjinne. 
{ Utfier skriuwe: (['hallo OK dêr'] fan: ['6'] lingte: ['2']). } begjinne. 
