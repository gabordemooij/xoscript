
Utfier skriuwe: ['Ofbrekke for-lus, 0-4.'], nije-rigel.
{ :i
	Utfier skriuwe: ['iteration #'] + i, nije-rigel.
	(i = 4) ôfbrekke.
} × 10.

>> x := 0.
>> xIsLytserAs10 := { <- ( x < 10 ). }.

Utfier skriuwe: ['Ofbrekke while-true-lus, 0-4.'], nije-rigel.
{
	Utfier skriuwe: ['iteration #'] + x, nije-rigel.
	x optelle: 1.
	((x < 5) net) ôfbrekke.
} wylst: xIsLytserAs10.

Utfier skriuwe: ['Ofbrekke while-false-lus, 5,4.'], nije-rigel.
{
	Utfier skriuwe: ['iteration #'] + x, nije-rigel.
	x ôflûke: 1.
	(x = 3) ôfbrekke.
} wylst: { <- (x > 0). }.

Utfier skriuwe: ['Ofbrekke times-lus, 1-4.'], nije-rigel.
{ :i
	Utfier skriuwe: ['iteration #'] + i, nije-rigel.
	(i = 4) ôfbrekke.
} × 5.

Utfier skriuwe: ['Ofbrekke blok, rigel net printsje.'], nije-rigel.
{ Ja ôfbrekke. Utfier skriuwe: ['skriuw dit net!'], nije-rigel. } begjinne.

Utfier skriuwe: ['Ofbrekke blok, catch net útfiere...'], nije-rigel.
{ Ja ôfbrekke. Utfier skriuwe: ['skriuw dit net!'], nije-rigel. } fange: { Utfier skriuwe: ['Fang dit net!']. }, begjinne.

Utfier skriuwe: ['Test Rige elk-lus: 0,1'], nije-rigel.
(Rige ← 1 ; 2 ; 3) ôfbyldzje: { :i
	Utfier skriuwe: ['iteration #'] + i, nije-rigel.
	(i = 1) ôfbrekke.
}.

Utfier skriuwe: ['Test Keppeling elk-lus: allinne c'], nije-rigel.
>> m := List nĳ.
m set: ['first'] by: ['a'], set: ['second'] by: ['b'], set: ['tredde'] by: ['c'].
m elk: { :k :v
	Utfier skriuwe: ['iteration'] + v + k, nije-rigel.
	Ja ôfbrekke.
}.

