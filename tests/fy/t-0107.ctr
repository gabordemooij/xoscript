
Utfier skriuwe: ['Break for-loop, 0-4.'], nije-rigel.
{ :i
	Utfier skriuwe: ['iteration #'] + i, nije-rigel.
	(i = 4) ôfbrekke.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Utfier skriuwe: ['Break while-true loop, 0-4.'], nije-rigel.
{
	Utfier skriuwe: ['iteration #'] + x, nije-rigel.
	x optelle: 1.
	((x < 5) net) ôfbrekke.
} wylst: xIsLessThan10.

Utfier skriuwe: ['Break while-false loop, 5,4.'], nije-rigel.
{
	Utfier skriuwe: ['iteration #'] + x, nije-rigel.
	x ôflûke: 1.
	(x = 3) ôfbrekke.
} wylst: { <- (x > 0). }.

Utfier skriuwe: ['Break times loop, 1-4.'], nije-rigel.
{ :i
	Utfier skriuwe: ['iteration #'] + i, nije-rigel.
	(i = 4) ôfbrekke.
} × 5.

Utfier skriuwe: ['Break block, dont print line.'], nije-rigel.
{ Ja ôfbrekke. Utfier skriuwe: ['dont write this!'], nije-rigel. } begjinne.

Utfier skriuwe: ['Break block, dont fire catch...'], nije-rigel.
{ Ja ôfbrekke. Utfier skriuwe: ['dont write this!'], nije-rigel. } fange: { Utfier skriuwe: ['Dont catch this!']. }, begjinne.

Utfier skriuwe: ['Test Array each-loop: 0,1'], nije-rigel.
(Rige ← 1 ; 2 ; 3) ôfbyldzje: { :i
	Utfier skriuwe: ['iteration #'] + i, nije-rigel.
	(i = 1) ôfbrekke.
}.

Utfier skriuwe: ['Test Map each-loop: c only'], nije-rigel.
>> m := List nĳ.
m set: ['first'] by: ['a'], set: ['second'] by: ['b'], set: ['third'] by: ['c'].
m elk: { :k :v
	Utfier skriuwe: ['iteration'] + v + k, nije-rigel.
	Ja ôfbrekke.
}.

