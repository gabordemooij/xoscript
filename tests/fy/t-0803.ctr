>> wis := ferb1 fraach: ['DELETE FROM book WHERE id > 0'].
{  wis útfiere. ferb1 befêstigje. } fange: { :e ferb1 weromdraaie.  }, begjinne.

>> ynfoeging := ferb1 fraach: ['INSERT INTO book (id) VALUES(null)'].
ynfoeging útfiere.

>> telle := ferb1 fraach: ['SELECT COUNT(*) AS num FROM book'].
telle ophelje: { :tabelrige Utfier skriuwe: tabelrige num, nije-rigel. }.

# komt net te foarskyn
