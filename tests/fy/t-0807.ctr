# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB nĳ host: ['localhost'],
	brûkersnamme: ['xo'],
	wachtwurd: ['pass123'],
	databanknamme: ['xobase'],
	ferbine.

>> sykparameters := db fraach: ['SELECT %% FROM'].
{ sykparameters útfiere. } fange: { :e
	Utfier skriuwe: ( e befettet: ['%%'] ), nije-rigel.
}, begjinne.
