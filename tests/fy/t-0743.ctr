>> V := Objekt.
V by: ['tekst'] dwaan: {
	Utfier skriuwe: ['cast'], nije-rigel.
	<- ['abc'].
}.

Utfier skriuwe: ( Programma ynstelling: ['abc'] ), nije-rigel.

# params meie net troch gc opromme wurde
Programma ynstelling: ([''] + V nĳ) wearde: ([''] + V nĳ).

Utfier skriuwe: ( Programma ynstelling: ['abc'] ), nije-rigel.
