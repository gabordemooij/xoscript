# test qualifiers

Programma opromje.

>> Fruit := Objekt nĳ.
Fruit by: ['nĳ'] dwaan: {
	>> f := sels nĳ.
	f apples: 0. <- f.
}.
Fruit by: ['apples:'] dwaan: { :a eigen apples := a. }.
Fruit by: ['apples'] dwaan: { <- eigen apples. }.
Fruit by: ['+'] dwaan: { :f
	>> n := Fruit nĳ.
	n apples: (f apples + eigen apples). <- n.
}.
Getal by: ['apples'] dwaan: { <- ((Fruit nĳ) apples: sels).
}.

Fruit by: ['tekst'] dwaan: { <- eigen apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Utfier skriuwe: q, nije-rigel.




q := 3 apples + 4 apples.
Utfier skriuwe: q, nije-rigel.



