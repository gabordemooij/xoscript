# test kwalifikaasjes

Programma opromje.

>> Fruit := Objekt nĳ.
Fruit by: ['nĳ'] dwaan: {
	>> f := sels nĳ.
	f apples: 0. <- f.
}.
Fruit by: ['apples:'] dwaan: { :a eigen appels := a. }.
Fruit by: ['appels'] dwaan: { <- eigen appels. }.
Fruit by: ['+'] dwaan: { :f
	>> n := Fruit nĳ.
	n apples: (f appels + eigen appels). <- n.
}.
Getal by: ['appels'] dwaan: { <- ((Fruit nĳ) apples: sels).
}.

Fruit by: ['tekst'] dwaan: { <- eigen appels + [' appels '].
}.

>> q := 3 appels + 4 appels.
Utfier skriuwe: q, nije-rigel.




q := 3 appels + 4 appels.
Utfier skriuwe: q, nije-rigel.



q := 3 appels + 4 appels.
