>> Animal := Objekt nĳ.
Animal by: ['make'] dwaan: {
	>> animal := Objekt nĳ.
	animal by: ['makeSound'] dwaan: {
		Utfier skriuwe: eigen sound.
	}. <- animal.
}.
>> Cat := Objekt nĳ.
Cat by: ['make'] dwaan: {
	>> cat := Animal make.
	cat by: ['init'] dwaan: {
		eigen sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
