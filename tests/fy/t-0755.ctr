Utfier skriuwe: ['Testobjekt'], nije-rigel.
>> groeter := Objekt nĳ.
groeter by: ['name:'] dwaan: { :namme
	eigen xnamme := namme. 
}.
groeter by: ['groetsje'] dwaan: {
	Utfier skriuwe: ['Hallo '] + eigen xnamme, nije-rigel.
}.
groeter name: ['Sherlock'].
groeter save-as: ['/tmp/a.bin'].
Utfier skriuwe: ['========== SNAP OPNIJ LADE:'], nije-rigel.
>> b := Objekt load-from: ['/tmp/a.bin'].
b groetsje.
b name: ['Watson'], groetsje.
