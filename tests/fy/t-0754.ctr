Utfier skriuwe: ['Test object'], nije-rigel.
>> a := Objekt nĳ. 

a by: ['item:'] dwaan: { :out
	eigen out := out. 
}.

a by: ['item'] dwaan: { <- eigen out.
}.

a by: ['greet'] dwaan: {
	Utfier skriuwe: ['hi from original out!'], nije-rigel.
}.

a item: Utfier.

Utfier skriuwe: a item, nije-rigel.

>> old-out-address := a item prototype ûnthâldadres.
a save-as: ['/tmp/a.bin'].
Utfier skriuwe: ['========== RELOADING SNAP:'], nije-rigel.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototype ûnthâldadres = old-out-address) ja: {
	Utfier skriuwe: ['Object link re-attached.'], nije-rigel.
}.

b item skriuwe: ['hello from loaded out!'], nije-rigel.
b greet.
