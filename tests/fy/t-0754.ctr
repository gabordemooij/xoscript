Utfier skriuwe: ['Testobjekt'], nije-rigel.
>> a := Objekt nĳ. 

a by: ['item:'] dwaan: { :útf
	eigen útf := útf. 
}.

a by: ['ûnderdiel'] dwaan: {
	<- eigen útf.
}.

a by: ['groetsje'] dwaan: {
	Utfier skriuwe: ['hoi fan de orizjinele útf!'], nije-rigel.
}.

a item: Utfier.

Utfier skriuwe: a ûnderdiel, nije-rigel.

>> âld-útf-adres := a ûnderdiel prototype ûnthâldadres.
a save-as: ['/tmp/a.bin'].
Utfier skriuwe: ['========== SNAP OPNIJ LADE:'], nije-rigel.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b ûnderdiel prototype ûnthâldadres = âld-útf-adres) ja: {
	Utfier skriuwe: ['Objektkeppeling opnij ferbûn.'], nije-rigel.
}.

b ûnderdiel skriuwe: ['hallo fan de laden útf!'], nije-rigel.
b groetsje.
