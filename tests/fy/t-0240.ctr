# test qualifiers

>> $ := Objekt nĳ.

$ by: ['reagearje:'] dwaan: { :x
	
	>> operation := x letter: 0.
	>> valuta := x letter: 1.
	>> money := x ferskowing: 2.
	
	>> amount := 0.

	( operation = ['+'] ) ja: {
		( valuta = ['£'] ) ja: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Utfier skriuwe: x, nije-rigel.


>> Fruit := Objekt nĳ.

Fruit by: ['nĳ'] dwaan: {
	>> f := sels nĳ.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit by: ['apples:'] dwaan: { :a eigen apples := a. }.
Fruit by: ['oranges:'] dwaan: { :p eigen oranges := p. }.
Fruit by: ['apples'] dwaan: { <- eigen apples. }.
Fruit by: ['oranges'] dwaan: { <- eigen oranges. }.

Fruit by: ['+'] dwaan: { :f
	
	>> n := Fruit nĳ.
	f optelle: 1.
	
	n apples: (f apples + eigen apples).
	n oranges:  (f oranges  + eigen oranges). <- n.
}.

Fruit by: ['tekst'] dwaan: { <- ( eigen apples tekst + [' apples and '] + eigen oranges + [' oranges'] ).
}.

Getal by: ['apples'] dwaan: { <- ((Fruit nĳ) apples: sels).
}.

Getal by: ['apple'] dwaan: { <- ((Fruit nĳ) apples: sels).
}.

Getal by: ['oranges'] dwaan: { <- ((Fruit nĳ) oranges: sels).
}.




Utfier skriuwe: (1 apple + 3 oranges + 4 apples), nije-rigel.


Tekst by: ['twice'] dwaan: { <- ((sels tekst) + (sels tekst)).
}.



Utfier skriuwe: ['❤❤❤'] twice.



