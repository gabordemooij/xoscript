# test kwalifikaasjes

>> $ := Objekt nĳ.

$ by: ['reagearje:'] dwaan: { :x
	
	>> operaasje := x letter: 0.
	>> faluta := x letter: 1.
	>> jild := x ferskowing: 2.
	
	>> bedrach := 0.

	( operaasje = ['+'] ) ja: {
		( faluta = ['£'] ) ja: { bedrach := 1.28 × jild. }.
	}. <- bedrach.
}.



>> x := $ +£20.

Utfier skriuwe: x, nije-rigel.


>> Fruit := Objekt nĳ.

Fruit by: ['nĳ'] dwaan: {
	>> f := sels nĳ.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit by: ['apples:'] dwaan: { :a eigen appels := a. }.
Fruit by: ['oranges:'] dwaan: { :p eigen sinesappels := p. }.
Fruit by: ['appels'] dwaan: { <- eigen appels. }.
Fruit by: ['sinesappels'] dwaan: { <- eigen sinesappels. }.

Fruit by: ['+'] dwaan: { :f
	
	>> n := Fruit nĳ.
	f optelle: 1.
	
	n apples: (f appels + eigen appels).
	n oranges:  (f sinesappels  + eigen sinesappels). <- n.
}.

Fruit by: ['tekst'] dwaan: { <- ( eigen appels tekst + [' appels en '] + eigen sinesappels + [' sinesappels'] ).
}.

Getal by: ['appels'] dwaan: { <- ((Fruit nĳ) apples: sels).
}.

Getal by: ['apple'] dwaan: { <- ((Fruit nĳ) apples: sels).
}.

Getal by: ['sinesappels'] dwaan: { <- ((Fruit nĳ) oranges: sels).
}.




Utfier skriuwe: (1 apple + 3 sinesappels + 4 appels), nije-rigel.


Tekst by: ['twaris'] dwaan: { <- ((sels tekst) + (sels tekst)).
}.



Utfier skriuwe: ['❤❤❤'] twaris.



