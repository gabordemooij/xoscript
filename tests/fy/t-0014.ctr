>> Groeter := Objekt nĳ.
Groeter by: ['meitsje'] dwaan: {
	>> gr := Objekt nĳ.
	gr by: ['setName:'] dwaan: { :inNamme
		eigen namme := inNamme.
	}.
	gr by: ['groetsje'] dwaan: {
		Utfier skriuwe: eigen namme.
	}. <- gr.
}.
>> a := Groeter meitsje.
>> b := Groeter meitsje.
a setName: ['IEN'].
b setName: ['TWA'].
a groetsje.
b groetsje.
>> c := a nĳ.
c setName: ['TRIJE'].
c groetsje.
>> d := a nĳ.
d setName: ['FJOUWER'].
d groetsje.
c groetsje.
