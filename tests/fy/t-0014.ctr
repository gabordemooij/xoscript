>> Greeter := Objekt nĳ.
Greeter by: ['make'] dwaan: {
	>> gr := Objekt nĳ.
	gr by: ['setName:'] dwaan: { :aname
		eigen namme := aname.
	}.
	gr by: ['greet'] dwaan: {
		Utfier skriuwe: eigen namme.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a nĳ.
c setName: ['THREE'].
c greet.
>> d := a nĳ.
d setName: ['FOUR'].
d greet.
c greet.
