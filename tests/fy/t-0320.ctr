


>> CoffeeMachine := Objekt nĳ.
CoffeeMachine by: ['order:'] dwaan: { :id
	>> coffee := ['Americano'].
	( id = 1 ) ja: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) ja: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) ja: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Objekt nĳ.
SimpleCoffeeMachine by: ['order'] dwaan: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Utfier skriuwe: redCup, nije-rigel.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Utfier skriuwe: greenCup, nije-rigel.
>> yellowCup := CoffeeMachine order: 1.
Utfier skriuwe: yellowCup, nije-rigel.
>> blueCup := CoffeeMachine order: 0.
Utfier skriuwe: blueCup, nije-rigel.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Utfier skriuwe: blackCup, nije-rigel.
blackCup tafoegje: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Utfier skriuwe: orangeCup, nije-rigel.
