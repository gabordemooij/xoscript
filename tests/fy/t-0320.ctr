


>> Kofjemasine := Objekt nĳ.
Kofjemasine by: ['order:'] dwaan: { :id
	>> coffee := ['Americano'].
	( id = 1 ) ja: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) ja: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) ja: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> IenfâldigeKofjemasine := Objekt nĳ.
IenfâldigeKofjemasine by: ['bestelling'] dwaan: { <- ['Swart']. }.
>> readKopke := Kofjemasine order: 1.
Utfier skriuwe: readKopke, nije-rigel.
readKopke := ['Tee']. 
>> grienKopke := Kofjemasine order: 0.
Utfier skriuwe: grienKopke, nije-rigel.
>> gielKopke := Kofjemasine order: 1.
Utfier skriuwe: gielKopke, nije-rigel.
>> blauKopke := Kofjemasine order: 0.
Utfier skriuwe: blauKopke, nije-rigel.
>> plestikKopke := IenfâldigeKofjemasine bestelling.
plestikKopke := ['Limonade']. 
>> swartKopke := IenfâldigeKofjemasine bestelling.
Utfier skriuwe: swartKopke, nije-rigel.
swartKopke tafoegje: [' neeee.... bier. '].
>> oranjeKopke := IenfâldigeKofjemasine bestelling.
Utfier skriuwe: oranjeKopke, nije-rigel.
