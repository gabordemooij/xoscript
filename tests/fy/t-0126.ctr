#Linux
>> Slurp := Objekt nĳ.

Slurp by: ['nĳ'] dwaan: {
	eigen str := [''].
}.

Slurp by: ['nieuw'] dwaan: {
	eigen str := [''].
}.

Slurp by: ['reagearje:'] dwaan: { :blah
		eigen str tafoegje: blah.
}.

Slurp by: ['reagearje:en:'] dwaan: { :blah :blahah
		eigen str tafoegje: (blah fan: 0 lingte: (blah lingte - 1)).
		eigen str tafoegje: [' '].
		eigen str tafoegje: blahah.
}.

Slurp by: ['krije'] dwaan: {
	>> buffer := eigen str.
	eigen str := ['']. <- buffer.
}.


Utfier skriuwe: (Programma systeem: (Slurp nĳ echo: ['Hallo, ik kin nei de konsole skriuwe mei in floeiende API!'], krije)).


{ Bestand nĳ: ['/tmp/from.txt'], wiskje. } fange: { ['Leech']. }, begjinne.
{ Bestand nĳ: ['/tmp/to.txt'], wiskje. } fange: { ['Leech']. }, begjinne.


Bestand nĳ: ['/tmp/to.txt'], bestiet nee: {
	Utfier skriuwe: ['Confirmed. Target file does not exist.\
'].
}.
Bestand nĳ: ['/tmp/from.txt'], bestiet nee: {
	Utfier skriuwe: ['Confirmed. Source file does not exist.\
'].
}.



Programma systeem: (Slurp nĳ touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], krije).



Programma systeem: (Slurp nĳ cp: ['/tmp/from.txt /tmp/to.txt'], krije).

Bestand nĳ: ['/tmp/to.txt'], bestiet ja: {
	Utfier skriuwe: ['Confirmed. Target file has been created by shell.\
'].
}.


Utfier skriuwe: ['Ynhâld fan bestân is:'] + (Bestand nĳ: ['/tmp/to.txt'], lêze), nije-rigel.
