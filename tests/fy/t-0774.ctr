Utfier skriuwe: ['Test object'], nije-rigel.
>> a := Objekt nĳ. 
a by: ['item:'] dwaan: { :lst
	eigen lst := lst. 
}.
a by: ['item'] dwaan: { <- eigen lst.
}.
a item: (
	Rige nĳ ; 1 ; (
		Rige nĳ ; ['a'] ; (
			Rige nĳ ; ( Momint nĳ: 1 )
		) ; ( Int64 út-tekst: ['321'] )
	)
).
Utfier skriuwe: a item, nije-rigel.
>> old-lst-address := a item prototype ûnthâldadres.
a save-as: ['/tmp/a.bin'].
Utfier skriuwe: ['========== RELOADING SNAP:'], nije-rigel.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b item prototype ûnthâldadres = old-lst-address) ja: {
	Utfier skriuwe: ['Object link re-attached.'], nije-rigel.
}.
Utfier skriuwe: ( b item ), nije-rigel.
