Utfier skriuwe: ['Testobjekt'], nije-rigel.
>> a := Objekt nĳ. 
a by: ['item:'] dwaan: { :lst
	eigen lst := lst. 
}.
a by: ['ûnderdiel'] dwaan: {
	<- eigen lst.
}.
a item: (
	Rige nĳ ; 1 ; (
		Rige nĳ ; ['a'] ; (
			Rige nĳ ; ( Momint nĳ: 1 )
		) ; ( Int64 út-tekst: ['321'] )
	)
).
Utfier skriuwe: a ûnderdiel, nije-rigel.
>> âld-lst-adres := a ûnderdiel prototype ûnthâldadres.
a save-as: ['/tmp/a.bin'].
Utfier skriuwe: ['========== SNAP OPNIJ LADE:'], nije-rigel.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b ûnderdiel prototype ûnthâldadres = âld-lst-adres) ja: {
	Utfier skriuwe: ['Objektkeppeling opnij ferbûn.'], nije-rigel.
}.
Utfier skriuwe: ( b ûnderdiel ), nije-rigel.
