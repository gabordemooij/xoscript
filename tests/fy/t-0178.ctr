

>> brûkt-ûnthâld1 := 0.
>> brûkt-ûnthâld2 := 0.
>> brûkt-ûnthâld3 := 0.
>> brûkt-ûnthâld4 := 0.

Programma geheugenbehear: 0.

>> txt := ['Word Salad'].
Utfier skriuwe: ['lêste yndeks fan urd = '] + (( txt lêste: ['ord'] ) - 0), nije-rigel.
Utfier skriuwe: ['yndeks fan urd = '] + (( txt fine: ['ord'] ) - 0), nije-rigel.
Utfier skriuwe: ['yndeks fan ad = '] + (( txt fine: ['ad'] ) - 0), nije-rigel.
Utfier skriuwe: ['lêste yndeks fan W = '] + (( txt lêste: ['W'] ) - 0), nije-rigel.
Utfier skriuwe: ['lêste yndeks fan d = '] + (( txt lêste: ['d'] ) - 0), nije-rigel.
Utfier skriuwe: ['txt is gelyk oan Wurd Salade = '] + ( txt = ['Word Salad'] ), nije-rigel.
Utfier skriuwe: ['txt is gelyk oan Caesar Salade = '] + ( txt = ['Caesar Salade'] ), nije-rigel.
Utfier skriuwe: ['txt is net gelyk oan Wurd Salade = '] + ( txt ≠ ['Word Salad'] ), nije-rigel.
Utfier skriuwe: ['txt is net gelyk oan Caesar Salade = '] + ( txt ≠ ['Caesar Salade'] ), nije-rigel.

