Utfier skriuwe: ['Test object'], nije-rigel.
>> a := Objekt nĳ. 

a by: ['item:'] dwaan: { :nil
	eigen nil := nil. 
}.

a by: ['item'] dwaan: { <- eigen nil.
}.

a item: Neat.

Utfier skriuwe: a item, nije-rigel.

>> old-nil-address := a item prototype ûnthâldadres.
a save-as: ['/tmp/a.bin'].
Utfier skriuwe: ['========== RELOADING SNAP:'], nije-rigel.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototype ûnthâldadres = old-nil-address) ja: {
	Utfier skriuwe: ['Object link re-attached.'], nije-rigel.
}.

Utfier skriuwe: b item, nije-rigel.
