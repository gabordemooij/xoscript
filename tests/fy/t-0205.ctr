>> str := ['write:'].
Utfier berjocht: ['skriuwe:'] arguminten: (Rige ← ['Hello World']), nije-rigel. 

Getal by: ['isbetween:and:'] dwaan: { :a :b <- ((sels ≥ a) en: (sels ≤ b)).
}.

str := ['isbetween:and:'].
Utfier skriuwe: (3 berjocht: str arguminten: (Rige ← 2 ; 8)), nije-rigel.
Utfier skriuwe: (3 berjocht: str arguminten: (Rige ← 1 ; 2)), nije-rigel.


>> Kofjemasine := Objekt nĳ.
Kofjemasine by: ['makeCoffeeWithSugar:milk:'] dwaan: { :sugar :milk <- ( ['Asjebleaft... kofje mei '] + 
			sugar +
			[' leppels sûker en '] +
			milk +
			[' drippen molke.']
	).
}.

>> bestelling := ['makeCoffeeWithSugar:milk:'].
>> kofjeKonfiguraasje := Rige ← 4 ; 2.
Utfier skriuwe: ( Kofjemasine berjocht: bestelling arguminten: kofjeKonfiguraasje ), nije-rigel.
