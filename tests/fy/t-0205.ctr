>> str := ['write:'].
Utfier berjocht: ['skriuwe:'] arguminten: (Rige ← ['Hello World']), nije-rigel. 

Getal by: ['isbetween:and:'] dwaan: { :a :b <- ((sels ≥ a) en: (sels ≤ b)).
}.

str := ['isbetween:and:'].
Utfier skriuwe: (3 berjocht: str arguminten: (Rige ← 2 ; 8)), nije-rigel.
Utfier skriuwe: (3 berjocht: str arguminten: (Rige ← 1 ; 2)), nije-rigel.


>> CoffeeMachine := Objekt nĳ.
CoffeeMachine by: ['makeCoffeeWithSugar:milk:'] dwaan: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Rige ← 4 ; 2.
Utfier skriuwe: ( CoffeeMachine berjocht: order arguminten: coffeeConfiguration ), nije-rigel.
