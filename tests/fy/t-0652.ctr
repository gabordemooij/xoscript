# test number -> string -> number
{

	>> x := Getal tusken: 0 en: 1000000.
	>> d := Getal tusken: 1 en: 7.
	>> e := 10 ta-de-macht: d.

	x diele-troch: e.
	>> y := x tekst getal.

	(x = y) nee: {
		Utfier skriuwe: x, nije-rigel.
		Utfier skriuwe: y, nije-rigel.
		Programma ein.
	}.

} * 1000.
Utfier skriuwe: ['OK'], nije-rigel.