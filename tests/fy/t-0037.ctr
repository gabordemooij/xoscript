>> a := 3.
>> b := a kopiearje.
a ôflûke: 1.
Utfier skriuwe: [' a = '] + a.
Utfier skriuwe: [' b = '] + b.
a := 3.
b := a + 4.
Utfier skriuwe: [' a = '] + a.
Utfier skriuwe: [' b = '] + b.
>> x := 3.
>> y := x kopiearje.
x optelle: 10.
y ôflûke: 1.
Utfier skriuwe: [' x = '] + x.
Utfier skriuwe: [' y = '] + y.
>> q := Objekt nĳ.
q by: ['setProperty:'] dwaan: { :x
	eigen prop := x.
}.
q by: ['getProperty'] dwaan: { <- eigen prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Utfier skriuwe: [' p = '] + (p getProperty).
