>> sinnen := Rige nĳ
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> boadskip := ['Phrase: ~decoded base64: ~encoded'].
	
sinnen elk: { :_ :sizzen 
	>> e := Server base64-kodearje: sizzen.
	>> d := Server base64-dekodearje: e.
	Utfier skriuwe: (
		boadskip kopiearje ~encoded: e, ~decoded: d
	), nije-rigel.
}.
