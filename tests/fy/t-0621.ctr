>> phrases := Rige nĳ
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases elk: { :_ :phrase 
	>> e := Server base64-kodearje: phrase.
	>> d := Server base64-dekodearje: e.
	Utfier skriuwe: (
		message kopiearje ~encoded: e, ~decoded: d
	), nije-rigel.
}.
