# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Programma ynstelling: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server keppelje: ( Rige nĳ ;
 libname ; ['fopen'] ;
 ( Rige nĳ ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
keppelje: ( Rige nĳ ;
 Neat ; # means same lib
 ['fread'] ;
 ( Rige nĳ ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Neat ; # means same object (i.e. Stream)
 ['fread']
),
keppelje: (
 Rige nĳ ;
 Neat ; # means same lib
 ['fwrite'] ;
 ( Rige nĳ ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Neat ; # means same lib
 ['fwrite']
),
keppelje: (
 Rige nĳ ;
 Neat ; # means same lib
 ['rewind'] ;
 ( Rige nĳ ; ['pointer'] ) ;
 ['int'] ;
 Neat ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> paad := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: paad mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream berjocht: ['fwrite'] arguminten: (Rige nĳ ; str ; 1 ; 6 ; fd ).
Utfier skriuwe: bytes-written, nije-rigel.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob nĳ: 20.

# read from file
>> bytes-read := Stream berjocht: ['fread'] arguminten: (Rige nĳ ; buf ; 1 ; 6 ; fd ).
Utfier skriuwe: bytes-read, nije-rigel.
Utfier skriuwe: buf, nije-rigel.

# free memory
str  frijjaan.
paad frijjaan.
mode frijjaan.
buf  frijjaan.


