# FFI brûke mei de Server-plugin

# ferbine mei libc (ôfhinklik fan it platfoarm)
>> bibnamme := Programma ynstelling: ['FFITESTLIB'].

# stdio-funksjes út C keppelje foar avansearre bestânsoperaasjes
Server keppelje: ( Rige nĳ ;
 bibnamme ; ['fopen'] ;
 ( Rige nĳ ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
keppelje: ( Rige nĳ ;
 Neat ; # betsjut deselde bibleteek
 ['fread'] ;
 ( Rige nĳ ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Neat ; # betsjut itselde objekt (d.w.s. Stroom)
 ['fread']
),
keppelje: (
 Rige nĳ ;
 Neat ; # betsjut deselde bibleteek
 ['fwrite'] ;
 ( Rige nĳ ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Neat ; # betsjut deselde bibleteek
 ['fwrite']
),
keppelje: (
 Rige nĳ ;
 Neat ; # betsjut deselde bibleteek
 ['rewind'] ;
 ( Rige nĳ ; ['pointer'] ) ;
 ['int'] ;
 Neat ; # betsjut deselde bibleteek
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> paad := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# in bestân iepenje mei fopen(path, mode)
>> fd := Stream path: paad mode: mode.

# bytes út buffer str nei it bestân skriuwe
>> bytes-skreaun := Stream berjocht: ['fwrite'] arguminten: (Rige nĳ ; str ; 1 ; 6 ; fd ).
Utfier skriuwe: bytes-skreaun, nije-rigel.

# bestânsoanwizer werom nei it begjin
Stream rewind: fd.

# in buffer reservearje
>> buf := Blob nĳ: 20.

# út it bestân lêze
>> bytes-lêzen := Stream berjocht: ['fread'] arguminten: (Rige nĳ ; buf ; 1 ; 6 ; fd ).
Utfier skriuwe: bytes-lêzen, nije-rigel.
Utfier skriuwe: buf, nije-rigel.

# ûnthâld frijjaan
str  frijjaan.
paad frijjaan.
mode frijjaan.
buf  frijjaan.


