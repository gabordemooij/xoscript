Utfier skriuwe: ['Test object'], nije-rigel.
>> a := Objekt nĳ. 

a by: ['item:'] dwaan: { :fmt
	eigen fmt := fmt. 
}.

a by: ['item'] dwaan: { <- eigen fmt.
}.

a item: ( Formaat nĳ: ['|%s|'] ).

Utfier skriuwe: a item, nije-rigel.

>> old-fmt-address := a item prototype ûnthâldadres.
a save-as: ['/tmp/a.bin'].
Utfier skriuwe: ['========== RELOADING SNAP:'], nije-rigel.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototype ûnthâldadres = old-fmt-address) ja: {
	Utfier skriuwe: ['Object link re-attached.'], nije-rigel.
}.

Utfier skriuwe: ( b item tapasse: ['hello'] ), nije-rigel.
