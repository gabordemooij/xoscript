Utfier skriuwe: ['Testobjekt'], nije-rigel.
>> a := Objekt nĳ. 

a by: ['item:'] dwaan: { :fmt
	eigen fmt := fmt. 
}.

a by: ['ûnderdiel'] dwaan: {
	<- eigen fmt.
}.

a item: ( Formaat nĳ: ['|%s|'] ).

Utfier skriuwe: a ûnderdiel, nije-rigel.

>> âld-fmt-adres := a ûnderdiel prototype ûnthâldadres.
a save-as: ['/tmp/a.bin'].
Utfier skriuwe: ['========== SNAP OPNIJ LADE:'], nije-rigel.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b ûnderdiel prototype ûnthâldadres = âld-fmt-adres) ja: {
	Utfier skriuwe: ['Objektkeppeling opnij ferbûn.'], nije-rigel.
}.

