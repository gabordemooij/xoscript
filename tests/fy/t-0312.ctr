>> Slurp := Objekt nĳ.
Slurp by: ['nĳ'] dwaan: {
	eigen str := [''].
}.
Slurp leare: ['nieuw'] betsjut: ['nĳ'].
Slurp by: ['reagearje:'] dwaan: { :blah
		(eigen str ≠ ['']) ja: {
			eigen str tafoegje: [' '].
		}.
		eigen str tafoegje: blah.
}.
Slurp by: ['reagearje:en:'] dwaan: { :blah :blahah
		(eigen str ≠ ['']) ja: {
			eigen str tafoegje: [' '].
		}.
		(blah lingte > 1) ja: {
			eigen str tafoegje: (blah fan: 0 lingte: (blah lingte - 1)).
		}, oars: {
			eigen str tafoegje: blah.
		}.
		eigen str tafoegje: [' '].
		eigen str tafoegje: blahah.
}.
Slurp by: ['krije'] dwaan: {
	>> buffer := eigen str.
	eigen str := ['']. <- buffer.
}.


>> sykparameters := Slurp nĳ
	select: ['*'],
	from
		brûkers 
	where 
		user_id=: 1.

Utfier skriuwe: sykparameters krije, nije-rigel.
