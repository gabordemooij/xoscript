
>> wurdlist := (
	List nĳ
		set: ['b'] by: ['a'],
		set: ['a'] by: ['b'],
		set: ['z'] by: ['x'],
		set: ['hello'] by: ['hallo'],
		set: ['minske'] by: ['minske']
).

>> fergelikingen := Rige nĳ.
wurdlist elk: { :a :b
	fergelikingen ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a fergelykje: b)
	).
}.

fergelikingen sortearje: { :a :b <- ( a fergelykje: b ). }.
Utfier skriuwe: ( fergelikingen gearfoegje: ['↵'] ), nije-rigel.
fergelikingen gearfoegje: ['↵'].
