
>> dictionary := (
	List nĳ
		set: ['b'] by: ['a'],
		set: ['a'] by: ['b'],
		set: ['z'] by: ['x'],
		set: ['hello'] by: ['hallo'],
		set: ['human'] by: ['human']
).

>> comparisons := Rige nĳ.
dictionary elk: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a fergelykje: b)
	).
}.

comparisons sortearje: { :a :b <- ( a fergelykje: b ). }.
Utfier skriuwe: ( comparisons gearfoegje: ['↵'] ), nije-rigel.
comparisons gearfoegje: ['↵'].
