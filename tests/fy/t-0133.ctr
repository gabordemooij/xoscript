


>> Deck := Rige nĳ.
Deck by: ['print'] dwaan: {
        >> len := sels telle - 1.
        { :i
                >> len2 := sels telle - 1.
                Utfier skriuwe: ['len: '].
                Utfier skriuwe: len, nije-rigel.
                Utfier skriuwe: ['len2: '].
                Utfier skriuwe: len2, nije-rigel.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
