Server init.

# JSON-encoder stipet allinnich UTF-8, gjin surrogate pairs

>> wurdboeken := Rige nĳ ;
	# {"key":"normal"} gewoane ASCII
	( List nĳ set: ['normaal'] by: ['key'] ) ;
	# {"key":"hello world"} spaasjeteken
	( List nĳ set: ['hello world'] by: ['key'] ) ;
	# {"key":"quote: \""} dûbel oanhellingsteken
	( List nĳ set: ['"'] by: ['key'] ) ;
	# {"key":"backslash: \\"} backslash
	( List nĳ set: ['backslash: \\'] by: ['key'] ) ;
	# {"key":"slash: /"} slash
	( List nĳ set: ['skeanstreek: /'] by: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( List nĳ set: ['backspace: \b'] by: ['key'] ) ;
	# {"key":"formfeed: \f"} form-feed-escape
	( List nĳ set: ['formfeed: \f'] by: ['key'] ) ;
	# {"key":"newline: \n"} nije rigel
	( List nĳ set: ['newline: \n'] by: ['key'] ) ;
	( List nĳ set: ['newline: ↵'] by: ['key'] ) ;
	( List nĳ set: ['newline: 
	'] by: ['key'] ) ;
	# {"key":"carriage return: \r"} carriage-return
	( List nĳ set: ['carriage return: \r'] by: ['key'] ) ;
	# {"key":"tab: \t"} tab
	( List nĳ set: ['tab \t'] by: ['key'] ) ;
	( List nĳ set: ['tab ⇿'] by: ['key'] ) ;
	( List nĳ set: ['tab  '] by: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( List nĳ set: ['NUL \u0000'] by: ['key'] ) ;
	( List nĳ set: ['NUL \0'] by: ['key'] ) ;
	# {"key":"control: \u0001"} kontrôleteken 0x01
	( List nĳ set: ['control: \u0001'] by: ['key'] ) ;
	# {"key":"control: \u001F"} kontrôleteken 0x1F
	( List nĳ set: ['control: \u001F'] by: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-byte-teken
	( List nĳ set: ['unicode: é'] by: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-byte-teken
	( List nĳ set: ['unicode: €'] by: ['key'] ) ;
	# {"key":"unicode: 日本語"} meardere 3-byte UTF-8-tekens
	( List nĳ set: ['unicode: 日本語'] by: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-byte-teken
	( List nĳ set: ['unicode: 😀'] by: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	( List nĳ set: ['unicode: 🧑‍💻'] by: ['key'] ) ;
	# {"key":"combining: é"} kombinearjend aksint
	( List nĳ set: ['combining: e\u0301'] by: ['key'] ) ;
	# {"key":"escaped unicode: é"} Unicode-escape BMP
	( List nĳ set: ['escaped unicode: \u00e9'] by: ['key'] ) ;
	# {"key":"escaped unicode: €"} Unicode-escape BMP
	( List nĳ set: ['escaped unicode: \u20ac'] by: ['key'] ) ;
	# {"key":"escaped unicode: 😀"} UTF-16 surrogate pair
	( List nĳ set: ['escaped unicode: \ud83d\ude00'] by: ['key'] ) ;
	# {"key":""} lege wearde
	( List nĳ set: [''] by: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} spesjale ASCII-tekens
	( List nĳ set: ['@ < > & = % + ? #'] by: ['key'] ) ;
	# {"key":"single quote: '"} inkeld oanhellingsteken
	( List nĳ set: ['''] by: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} meardere JSON-escapes
	( List nĳ set: ['multiple: \" \\ \n \r \t'] by: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} langere ASCII-tekst
	( List nĳ set: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] by: ['key'] ) ;
	# {"key":" value"} spaasje foarôf
	( List nĳ set: [' wearde'] by: ['key'] ) ;
	# {"key":"value "} spaasje efteroan
	( List nĳ set: ['wearde '] by: ['key'] ) ;
	# {"key":" \t\n\r "} wytromte
	( List nĳ set: [' \t\n\r '] by: ['key'] )
	.

wurdboeken elk: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (List nĳ set: d key by: ['key']).
	>> b := JSON jsonify: (List nĳ set: ['value'] by: d key).
	>> e := JSON objekt: a.
	>> f := JSON objekt: b.
	((e key = d key en: (f ? d key = ['value'])) of: (e key = ['NUL ?'])) ja: {
		Utfier skriuwe: ['OK'], nije-rigel.
	}, oars: {
		Utfier skriuwe: ['Kin net goed kodearje/dekodearje: '] + d + j, nije-rigel.
		Programma ein.
	}.
}.
