
{ :i
	Utfier skriuwe: ['This is step #'] + ( ( i ) + 1 ), nije-rigel.
} × 6.

{ :i
	Utfier skriuwe: ['This is step #'] + ( 3 - ( i ) ), nije-rigel.
} × 6.

{ :i
	Utfier skriuwe: ['NEVER!'], nije-rigel.
} × 0.



{ :i
	Utfier skriuwe: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), nije-rigel.
} × 11.
