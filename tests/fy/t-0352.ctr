Getal by: ['roman'] dwaan: {
	>> getal := sels kopiearje.
	>> roman := [''].
	{
		{
			(getal ≥ 1000) ja: {
				roman tafoegje: ['Ⅿ'].
				getal ôflûke: 1000.
			}, ôfbrekke.
		
			(getal ≥ 500) ja: {
				roman tafoegje: ['Ⅾ'].
				getal ôflûke: 500.
			}, ôfbrekke.
		
			(getal ≥ 100) ja: {
				roman tafoegje: ['Ⅽ'].
				getal ôflûke: 100.
			}, ôfbrekke.
		
			(getal ≥ 50) ja: {
				roman tafoegje: ['Ⅼ'].
				getal ôflûke: 50.
			}, ôfbrekke.
		
			(getal ≥ 50) ja: {
				roman tafoegje: ['Ⅼ'].
				getal ôflûke: 50.
			}, ôfbrekke.
		
			(getal ≥ 10) ja: {
				roman tafoegje: ['Ⅹ'].
				getal ôflûke: 10.
			}, ôfbrekke.
			
			(getal ≥ 9) ja: {
				roman tafoegje: ['Ⅸ'].
				getal ôflûke: 9.
			}, ôfbrekke.
			
			(getal ≥ 5) ja: {
				roman tafoegje: ['Ⅴ'].
				getal ôflûke: 5.
			}, ôfbrekke.
			
			(getal ≥ 4) ja: {
				roman tafoegje: ['Ⅳ'].
				getal ôflûke: 4.
			}, ôfbrekke.
			
			(getal ≥ 1) ja: {
				roman tafoegje: ['Ⅰ'].
				getal ôflûke: 1.
			}, ôfbrekke.
		} proseduere.
	} wylst: { <- getal > 0. }. <- roman.
}.

Utfier skriuwe: 1 roman, nije-rigel.
Utfier skriuwe: 2 roman, nije-rigel.
Utfier skriuwe: 4 roman, nije-rigel.
Utfier skriuwe: 8 roman, nije-rigel.
Utfier skriuwe: 16 roman, nije-rigel.
Utfier skriuwe: 32 roman, nije-rigel.
Utfier skriuwe: 64 roman, nije-rigel.
Utfier skriuwe: 128 roman, nije-rigel.
Utfier skriuwe: 256 roman, nije-rigel.
Utfier skriuwe: 1024 roman, nije-rigel.
