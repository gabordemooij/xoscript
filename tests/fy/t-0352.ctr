Getal by: ['romeinsk'] dwaan: {
	>> getal := sels kopiearje.
	>> romeinsk := [''].
	{
		{
			(getal ≥ 1000) ja: {
				romeinsk tafoegje: ['Ⅿ'].
				getal ôflûke: 1000.
			}, ôfbrekke.
		
			(getal ≥ 500) ja: {
				romeinsk tafoegje: ['Ⅾ'].
				getal ôflûke: 500.
			}, ôfbrekke.
		
			(getal ≥ 100) ja: {
				romeinsk tafoegje: ['Ⅽ'].
				getal ôflûke: 100.
			}, ôfbrekke.
		
			(getal ≥ 50) ja: {
				romeinsk tafoegje: ['Ⅼ'].
				getal ôflûke: 50.
			}, ôfbrekke.
		
			(getal ≥ 50) ja: {
				romeinsk tafoegje: ['Ⅼ'].
				getal ôflûke: 50.
			}, ôfbrekke.
		
			(getal ≥ 10) ja: {
				romeinsk tafoegje: ['Ⅹ'].
				getal ôflûke: 10.
			}, ôfbrekke.
			
			(getal ≥ 9) ja: {
				romeinsk tafoegje: ['Ⅸ'].
				getal ôflûke: 9.
			}, ôfbrekke.
			
			(getal ≥ 5) ja: {
				romeinsk tafoegje: ['Ⅴ'].
				getal ôflûke: 5.
			}, ôfbrekke.
			
			(getal ≥ 4) ja: {
				romeinsk tafoegje: ['Ⅳ'].
				getal ôflûke: 4.
			}, ôfbrekke.
			
			(getal ≥ 1) ja: {
				romeinsk tafoegje: ['Ⅰ'].
				getal ôflûke: 1.
			}, ôfbrekke.
		} proseduere.
	} wylst: { <- getal > 0. }. <- romeinsk.
}.

Utfier skriuwe: 1 romeinsk, nije-rigel.
Utfier skriuwe: 2 romeinsk, nije-rigel.
Utfier skriuwe: 4 romeinsk, nije-rigel.
