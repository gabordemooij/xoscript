
Server init.
>> rq := HTTP-Fersyk nĳ.
Utfier skriuwe: ['HTTP-GET d[]=']  + ( rq get-list: ['d[]'] ), nije-rigel. # GET
Utfier skriuwe: ['HTTP-GET f[]=']  + ( rq get-list: ['f[]'] ), nije-rigel. # GET
Utfier skriuwe: ['HTTP-POST e[]='] + ( rq post-list: ['e[]'] ), nije-rigel. # GET
Utfier skriuwe: ['HTTP-POST c=']   + ( rq post: ['c'] ), nije-rigel. # GET
Utfier skriuwe: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), nije-rigel. # GET
