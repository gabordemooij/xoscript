>> HTML := Objekt nĳ.
HTML by: ['reagearje:'] dwaan: { :tag 
	Utfier skriuwe: (['<tag>'] tag: tag), nije-rigel.
}.
HTML by: ['reagearje:en:'] dwaan: { :tag :html 
	Utfier skriuwe: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), nije-rigel.
}.
>> html := HTML nĳ.
html body h1: ['header'].

