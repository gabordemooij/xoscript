>> HTMLTekst := Objekt nĳ.
HTMLTekst by: ['reagearje:'] dwaan: { :tag 
	Utfier skriuwe: (['<tag>'] tag: tag), nije-rigel.
}.
HTMLTekst by: ['reagearje:en:'] dwaan: { :tag :html 
	Utfier skriuwe: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), nije-rigel.
}.
>> html := HTMLTekst nĳ.
html body h1: ['header'].

