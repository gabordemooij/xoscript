# Test utf8-sanearder
Server init.

>> utf8gefallen := List nĳ
	# allinnich ASCII
	set: ( Rige nĳ ; 65 ; 65 ; 65 ; 65 ; 0 ) by: ['AAAA'],
	# jildige 2-byte-sekwinsje
	set: ( Rige nĳ ; 194 ; 162 ; 0 ) by: ['¢'],
	# Jildige 3-byte UTF-8
    set: ( Rige nĳ ; 226 ; 130 ; 172 ; 0 ) by: ['€'],
	# Jildige 4-byte UTF-8
    set: ( Rige nĳ ; 240 ; 144 ; 141 ; 136 ; 0 ) by: ['𐍈'],
	# Unjildige ferfolchbyte yn sekwinsje E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, mar heart by deselde flater
    set: ( Rige nĳ ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) by: ['A?A'],
	# Te lange kodearring fan ASCII 'A' (moat ? wurde),
    set: ( Rige nĳ ; 65 ; 193 ; 129 ; 0 ) by: ['A?'],
	# Unjildige earste byte (0xFF)
    set: ( Rige nĳ ; 255 ; 0 ) by: ['?'],
	# Unfolsleine multi-byte-sekwinsje oan it ein
    set: ( Rige nĳ ; 66 ; 226 ; 0 ) by: ['B?'],
    # Lege tekst
    #put: ( List new ) at: [''],
	# Meardere mingde sekwinsjes
    set: ( Rige nĳ ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) by: ['A€?𐍈B'].
	 
utf8gefallen elk: { :key :value
	>> blob := Blob nĳ: value telle, bytes: value.
	>> str := blob tekst.
	(str = key) ja: {
		Utfier skriuwe: ['OK'], nije-rigel.
	}, oars: {
		Utfier skriuwe: ['UTF8-sanearder mislearre by: '] + key + [' krige: '] + str, nije-rigel.
	}.
	blob frijjaan.
}.
