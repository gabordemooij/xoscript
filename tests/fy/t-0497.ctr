Server init.

# write a test file
>> f := Bestand nĳ: ['/tmp/test.gif'].
f skriuwe: ['GIF87a01234567810'].

# serve the file
Server trochjaan: ['test.gif'] foarheaksel: ['/tmp/'].

Utfier nije-rigel.

Utfier skriuwe: ['Outside container (security):'], nije-rigel.
{ Server trochjaan: ['../passwd'] foarheaksel: ['/tmp/']. }
fange: { :e Utfier skriuwe: e, nije-rigel. },
begjinne.

Utfier skriuwe: ['Invalid prefix:'], nije-rigel.
{ Server trochjaan: ['test.gif'] foarheaksel: ['z:\\']. }
fange: { :e Utfier skriuwe: e, nije-rigel. },
begjinne.

Utfier skriuwe: ['Non-existant file:'], nije-rigel.
{ Server trochjaan: ['xxx.xxx'] foarheaksel: ['/tmp/']. }
fange: { :e Utfier skriuwe: e, nije-rigel. },
begjinne.
