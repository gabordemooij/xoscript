Utfier skriuwe: ['Test object'], nije-rigel.
>> greeter := Objekt nĳ.
greeter by: ['name:'] dwaan: { :namme
	eigen xname := namme. 
}.
greeter by: ['greet'] dwaan: {
	Utfier skriuwe: ['Hello '] + eigen xname, nije-rigel.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Utfier skriuwe: ['========== RELOADING SNAP:'], nije-rigel.
>> b := Objekt load-from: ['/tmp/a.bin'].
>> c := Objekt load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
