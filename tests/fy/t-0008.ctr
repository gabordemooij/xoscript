>> Greeter := Objekt nĳ.
Greeter by: ['make'] dwaan: {
	>> greeter := Objekt nĳ.
	greeter by: ['name:'] dwaan: { :namme
		Utfier skriuwe: ['setting a name'].
		eigen myName := namme.
	}.
	greeter by: ['greet'] dwaan: {
		Utfier skriuwe: ['Hello'].
		Utfier skriuwe: eigen myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
