# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob nĳ: 8, bytes: (
	Rige nĳ ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Utfier skriuwe: ( utf16 dekodearje: ['utf16le'] ), nije-rigel.

utf16 frijjaan.
>> utf32 := Blob nĳ: 13, bytes: (
	Rige nĳ ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Utfier skriuwe: ( utf32 dekodearje: ['utf32be'] ), nije-rigel.
utf32 frijjaan.