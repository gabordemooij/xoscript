Utfier skriuwe: ['Test object'], nije-rigel.
>> a := Objekt nĳ. 

a by: ['item:'] dwaan: { :num
	eigen num := num. 
}.

a by: ['item'] dwaan: { <- eigen num.
}.

a item: 123.

Utfier skriuwe: a item, nije-rigel.

>> old-num-address := a item prototype ûnthâldadres.
a save-as: ['/tmp/a.bin'].
Utfier skriuwe: ['========== RELOADING SNAP:'], nije-rigel.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototype ûnthâldadres = old-num-address) ja: {
	Utfier skriuwe: ['Object link re-attached.'], nije-rigel.
}.

Utfier skriuwe: b item, nije-rigel.
