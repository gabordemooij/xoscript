>> To-Do := Objekt nĳ.

To-Do by: ['nĳ'] dwaan: {
	eigen list := Rige nĳ.
}.

To-Do by: ['nieuw'] dwaan: {
	eigen list := Rige nĳ.
}.

To-Do by: ['+'] dwaan: { :task
	eigen list tafoegje: task.
}.

To-Do by: ['number of tasks?'] dwaan: { <-  eigen list telle.
}.

>> todos := 
	To-Do nĳ 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Utfier skriuwe: ['You have $ tasks to do'] $ todos number of tasks?.
