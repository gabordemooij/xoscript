>> Takenlist := Objekt nĳ.

Takenlist by: ['nĳ'] dwaan: {
	eigen list := Rige nĳ.
}.

Takenlist by: ['nieuw'] dwaan: {
	eigen list := Rige nĳ.
}.

Takenlist by: ['+'] dwaan: { :taak
	eigen list tafoegje: taak.
}.

Takenlist by: ['number of tasks?'] dwaan: { <-  eigen list telle.
}.

>> taken := 
	Takenlist nĳ 
	+ ['iten koken'] 
	+ ['keamer opromje'].
	
Utfier skriuwe: ['You have $ tasks to do'] $ taken number of tasks?.
