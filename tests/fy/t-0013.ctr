
>> Dier := Objekt nĳ.
Dier by: ['nĳ'] dwaan: {
	<- sels nĳ init.
}.

Dier by: ['init'] dwaan: {
	eigen lûd := ['?'].
	eigen skonken  := 4.
}.

>> Hûn := Dier nĳ.
Hûn by: ['init'] dwaan: {
	sels init.
	eigen lûd := ['blaft'].
}.

Dier by: ['tekst'] dwaan: {
	<- eigen skonken tekst + eigen lûd.
}.

>> poedel := Hûn nĳ.
Utfier skriuwe: poedel, nije-rigel.

