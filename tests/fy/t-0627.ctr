

# in 64-bit hiel getal oanmeitsje foar krekte berekkeningen
>> a := Int64 út-tekst: ['123'].

# nei tekst
Utfier skriuwe: a, nije-rigel.

# diele
Utfier skriuwe: a / (Int64 út-tekst: ['3']), nije-rigel.

# fermannichfâldigje
Utfier skriuwe: a * (Int64 út-tekst: ['2']), nije-rigel.

# optelle
Utfier skriuwe: a + (Int64 út-tekst: ['1']), nije-rigel.

# ôflûke
Utfier skriuwe: a - (Int64 út-tekst: ['2']), nije-rigel.

# fergelykje
Utfier skriuwe: ( a =   (Int64 út-tekst: ['123'])), nije-rigel.
Utfier skriuwe: ( a !=: (Int64 út-tekst: ['124'])), nije-rigel.
Utfier skriuwe: ( a <   (Int64 út-tekst: ['124'])), nije-rigel.
Utfier skriuwe: ( a >   (Int64 út-tekst: ['122'])), nije-rigel.
Utfier skriuwe: ( a >=: (Int64 út-tekst: ['123'])), nije-rigel.
Utfier skriuwe: ( a <=: (Int64 út-tekst: ['123'])), nije-rigel.





	