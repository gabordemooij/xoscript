# sesjekoekje-opmaak, json-ynhâldstype, allinnich webprotokollen, svg ynline toand
Server inisjalisearje.
Programma brûke: ['../../../src/xo/fy/webtools.xo'].

>> Nep-Fersyk := Objekt nĳ.
Nep-Fersyk by: ['value:'] dwaan: { :wearde
	eigen wearde := wearde.
}.
Nep-Fersyk by: ['cookie:'] dwaan: { :namme
	<- eigen wearde.
}.

>> Test-Sesje := Tydlik-bestân-sesje nĳ.
Test-Sesje by: ['lade'] dwaan: {
	<- List nĳ.
}.
Test-Sesje by: ['sesjenûmer'] dwaan: {
	<- eigen id.
}.

>> koekjes := Rige nĳ
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

koekjes elk: { :i :koekje
	>> fersyk := Nep-Fersyk nĳ.
	fersyk value: koekje.
	>> behearder := Test-Sesje nĳ.
	>> web := Webdokumint nĳ.
	web fersyk: fersyk.
	web sesjebehearder: behearder.
	web sesje-begjinne.
	Utfier skriuwe: ( behearder sesjenûmer = koekje ), nije-rigel.
}.

>> web := Webdokumint nĳ.
web json: (List nĳ set: ['b'] by: ['a']).
Utfier skriuwe: ['\n'], nije-rigel.

{ Netwurk get: ['file:///etc/hostname']. } fange: { :e
	Utfier skriuwe: e, nije-rigel.
}, begjinne.

>> svg := Bestand nĳ: ['/tmp/test0814.svg'].
svg skriuwe: ['<svg xmlns="x"></svg>'].
Utfier nije-rigel.
Server trochjaan: ['test0814.svg'] foarheaksel: ['/tmp/'].
svg wiskje.
