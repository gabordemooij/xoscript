>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objekt nĳ.
⚄ by: ['lûkFan:lingte:'] dwaan: { :pool :telle
	
	>> útkomst := [''].
	
	{
		>> yndeks := Getal tafal % (pool lingte).
		útkomst tafoegje: ( pool letter: (yndeks + 1) ).
		
	} × telle. <- útkomst.
}.

>> tafal := ⚄ lûkFan: ?? lingte: ?? lingte.
Utfier skriuwe: (['x↵'] x tafal lingte).
Utfier skriuwe: (['y↵'] y ?? lingte).

