>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objekt nĳ.
⚄ by: ['drawFrom:length:'] dwaan: { :pool :telle
	
	>> result := [''].
	
	{
		>> index := Getal random % (pool lingte).
		result tafoegje: ( pool letter: (index + 1) ).
		
	} × telle. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? lingte.
Utfier skriuwe: (['x↵'] x random lingte).
Utfier skriuwe: (['y↵'] y ?? lingte).

