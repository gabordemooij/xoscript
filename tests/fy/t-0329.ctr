Utfier skriuwe: ((Rige nĳ
	by: ['plaque:'] dwaan: { :x eigen o := x. },
	by: ['plakette']  dwaan: { <- eigen o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Rige ← 1)
	~ (Rige ← 1 ; 2)
	~ (Rige ← 1 ; 2 ; 3)
	~ (Rige ← 1 ; 2 ; 3 ; 4)
	~ (Rige ← 1 ; 2 ; 3 ; 4 ; 5)
) elk: { :i :el
	{ Utfier skriuwe: dizze-taak. } × el telle.
	Utfier nije-rigel.
}) plakette, nije-rigel.


