

>> brûkt-ûnthâld1 := 0.
>> brûkt-ûnthâld2 := 0.
>> brûkt-ûnthâld3 := 0.
>> brûkt-ûnthâld4 := 0.

Programma geheugenbehear: 0.

>> txt := ['Word Salad'].
Utfier skriuwe: ['Tekstlingte: '] + txt lingte, nije-rigel.
Utfier skriuwe: ['Teken op 2:'] + ( txt letter: 2 ), nije-rigel.
Utfier skriuwe: (( txt fine: ['S'] ) - 0), nije-rigel.

Programma opromje.

brûkt-ûnthâld1 := (Programma ûnthâld ? 0).


txt := ['Word Salad'].
Utfier skriuwe: ['Tekstlingte: '] + txt lingte, nije-rigel.
Utfier skriuwe: ['Teken op 2:'] + ( txt letter: 2 ), nije-rigel.
Utfier skriuwe: (( txt fine: ['S'] ) - 0), nije-rigel.

Programma opromje.
brûkt-ûnthâld2 := (Programma ûnthâld ? 0).


txt := ['Word Salad'].
Utfier skriuwe: ['Tekstlingte: '] + txt lingte, nije-rigel.
Utfier skriuwe: ['Teken op 2:'] + ( txt letter: 2 ), nije-rigel.
Utfier skriuwe: (( txt fine: ['S'] ) - 0), nije-rigel.

Programma opromje.
brûkt-ûnthâld3 := (Programma ûnthâld ? 0).



( brûkt-ûnthâld1 = brûkt-ûnthâld2 en: brûkt-ûnthâld1 = brûkt-ûnthâld3, en: brûkt-ûnthâld2 = brûkt-ûnthâld3 ) ja: {
	Utfier skriuwe: ['Gjin ûnthâldlekken hjir'].
}, nee: {
	Utfier skriuwe: ['Ûnthâld lekt...'].
}.
