
>> city := Rige ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Rige ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature per: city.
>> cities := weather yngongen sortearje: { :a :b <- (a fergelykje: b). }.
>> temperatures := weather wearden sortearje: { :a :b <- (a fergelykje: b) negatyf?. }.

Utfier skriuwe: (cities gearfoegje: [',']), nije-rigel.
Utfier skriuwe: (temperatures gearfoegje: [',']), nije-rigel.
