
>> a := Rige ← (Rige ← 100 ; 200 ; 300) ; (Rige ← 9 ; 8 ; 7).
Utfier skriuwe: ['at 0,1 :'].
Utfier skriuwe: a ? 0 ? 1, nije-rigel. 
Utfier skriuwe: ['at 1,2 :'].
Utfier skriuwe: a ? 1 ? 2, nije-rigel. 
>> menu := List nĳ.
menu set: (Rige ← ['pizza'] ; ['spaghetti']) by: ['Italian Cuisine'].
menu set: (Rige ← ['bifteki'] ; ['suflaki']) by: ['Greek Cuisine'].
Utfier skriuwe: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), nije-rigel. 
Utfier skriuwe: ['but not on the same plate.'], nije-rigel.
