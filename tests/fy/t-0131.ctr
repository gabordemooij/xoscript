
>> a := Rige ← (Rige ← 100 ; 200 ; 300) ; (Rige ← 9 ; 8 ; 7).
Utfier skriuwe: ['by 0,1 :'].
Utfier skriuwe: a ? 0 ? 1, nije-rigel. 
Utfier skriuwe: ['by 1,2 :'].
Utfier skriuwe: a ? 1 ? 2, nije-rigel. 
>> menu := List nĳ.
menu set: (Rige ← ['pizza'] ; ['spaghetti']) by: ['Italjaanske Keuken'].
menu set: (Rige ← ['bifteki'] ; ['suflaki']) by: ['Grykske Keuken'].
Utfier skriuwe: ['Ik hâld fan '] + (menu ? ['Grykske Keuken'] ? 0) + [' en '] + (menu ? ['Italjaanske Keuken'] ? 1), nije-rigel. 
Utfier skriuwe: ['mar net op itselde boerd.'], nije-rigel.
