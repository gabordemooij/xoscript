# a value ending in the first part of an opening quote must survive serialization
>> wearden := Rige nĳ
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

wearden elk: { :i :value
	>> d := List nĳ.
	d set: value by: ['k'].
	d set: ['second'] by: ['j'].
	>> r := d koade objekt.
	Utfier skriuwe: r telle, nije-rigel.
	Utfier skriuwe: ( (r by: ['k']) = value ), nije-rigel.
}.
