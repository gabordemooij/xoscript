Programma geheugenbehear: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } fange: {
		oops optelle: 1.
	}, begjinne.
} × 1000.

{
	Utfier skriuwe: ['hi there!'].
	dizze-taak flater: ['oops'].
	Utfier skriuwe: ['hi there!'].
	{ Utfier skriuwe: ['dont print this']. } begjinne.
} fange: { :e 
	Utfier skriuwe: ['got ya!']. 
	Utfier skriuwe: e.
}, begjinne.
