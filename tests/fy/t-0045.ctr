Programma geheugenbehear: 4.

>> oeps := 0.
{
	{ 3 ÷ 0. } fange: {
		oeps optelle: 1.
	}, begjinne.
} × 1000.

{
	Utfier skriuwe: ['hoi dêr!'].
	dizze-taak flater: ['oops'].
	Utfier skriuwe: ['hoi dêr!'].
	{ Utfier skriuwe: ['printsje dit net']. } begjinne.
} fange: { :e 
	Utfier skriuwe: ['hawwe dy!']. 
	Utfier skriuwe: e.
}, begjinne.
