

Tekst by: ['evaluate'] dwaan: {
	>> koade := Bestand nĳ: ['/tmp/eval.ctr'].
	koade skriuwe: sels tekst + ['.'].
	Programma brûke: ['/tmp/eval.ctr'].
}.

>> a := (Rige ← (
	(List nĳ)
		set: ['domain'] by: ['mywebsite.com'],
		set: (Rige ←
			((List nĳ)
				set: ['home'] by: ['title'],
				set: ['<html></html>'] by: ['body'],
				set: ['2017-01-01'] by: ['created']
			) ;
			((List nĳ)
				set: ['aboutus(c)'] by: ['title'],
				set: ['<credits>Author Inc.</credits>'] by: ['body']
			)
		) by: ['pages']
	)
) tekst.

Utfier skriuwe: a type, nije-rigel.
Utfier skriuwe: a, nije-rigel.

>> b := Neat.
(['b := '] + a) evaluate.
Utfier skriuwe: b ? 0 ? ['pages'] ? 1 ? ['body'], nije-rigel.

>> c := b ? 0.
>> d := c tekst.
Utfier skriuwe: d type, nije-rigel.

>> e := Neat.
(['e := '] + d) evaluate.
Utfier skriuwe: e ? ['pages'] ? 0, nije-rigel.
