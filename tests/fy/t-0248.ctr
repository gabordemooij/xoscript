

Tekst by: ['evaluearje'] dwaan: {
	>> koade := Bestand nĳ: ['/tmp/eval.ctr'].
	koade skriuwe: sels tekst + ['.'].
	Programma brûke: ['/tmp/eval.ctr'].
}.

>> a := (Rige ← (
	(List nĳ)
		set: ['domein'] by: ['mywebsite.com'],
		set: (Rige ←
			((List nĳ)
				set: ['thús'] by: ['title'],
				set: ['<html></html>'] by: ['body'],
				set: ['2017-01-01'] by: ['makke']
			) ;
			((List nĳ)
				set: ['aboutus(c)'] by: ['title'],
				set: ['<credits>Author Inc.</credits>'] by: ['body']
			)
		) by: ['siden']
	)
) tekst.

Utfier skriuwe: a type, nije-rigel.
Utfier skriuwe: a, nije-rigel.

>> b := Neat.
(['b := '] + a) evaluearje.
Utfier skriuwe: b ? 0 ? ['siden'] ? 1 ? ['body'], nije-rigel.

>> c := b ? 0.
>> d := c tekst.
Utfier skriuwe: d type, nije-rigel.

>> e := Neat.
(['e := '] + d) evaluearje.
Utfier skriuwe: e ? ['siden'] ? 0, nije-rigel.
