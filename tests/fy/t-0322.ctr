

>> Matryoshka := Objekt nĳ.
Matryoshka by: ['double:'] dwaan: { :geheim
	eigen geheim := geheim × 2.
}.
Matryoshka by: ['nĳ:'] dwaan: { :geheim
	>> antwurd := Neat.
	>> t := (geheim > 255).
	Utfier skriuwe: (geheim + [' | '] + t), nije-rigel.
	t ja: {
		antwurd := geheim.
	}, oars: {
		antwurd := Matryoshka rekursyf nĳ: (sels double: geheim).
	}. <- antwurd.
}.

>> x := Matryoshka nĳ: 2.
