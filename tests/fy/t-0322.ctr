

>> Matryoshka := Objekt nĳ.
Matryoshka by: ['double:'] dwaan: { :secret
	eigen secret := secret × 2.
}.
Matryoshka by: ['nĳ:'] dwaan: { :secret
	>> answer := Neat.
	>> t := (secret > 255).
	Utfier skriuwe: (secret + [' | '] + t), nije-rigel.
	t ja: {
		answer := secret.
	}, oars: {
		answer := Matryoshka rekursyf nĳ: (sels double: secret).
	}. <- answer.
}.

>> x := Matryoshka nĳ: 2.
