Server init.

>> DB := Maria-DB nĳ host: ['localhost'],
	brûkersnamme: ['xo'],
	wachtwurd: ['pass123'],
	databanknamme: ['xobase'],
	ferbine.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> sykparameters := Maria-Fraach nĳ: SQL.

# set database
sykparameters databank: DB.

sykparameters ophelje: { :row
	Utfier skriuwe: row world, nije-rigel.
}.
