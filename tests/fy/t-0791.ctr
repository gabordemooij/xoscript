Server init.

>> DB := Maria-DB nĳ host: ['localhost'],
	brûkersnamme: ['xo'],
	wachtwurd: ['pass123'],
	databanknamme: ['xobase'],
	ferbine.
	
>> SQL := ['SELECT "hello" AS "world" '].

# fraach mei de hân oanmeitsje
>> sykparameters := Maria-Fraach nĳ: SQL.

# databank ynstelle
sykparameters databank: DB.

sykparameters ophelje: { :tabelrige
	Utfier skriuwe: tabelrige world, nije-rigel.
}.
