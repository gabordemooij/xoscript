>> f := Bestand nĳ: ['/tmp/citrine_test_file.txt'].
f exists: { f wiskje. }.
f skriuwe: ['hello'].
f := Bestand nĳ: ['/tmp/citrine_test_file.txt'].
f tafoegje: ['hello'].

