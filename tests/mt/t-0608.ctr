
>> Size := Oġġett ġdid.
Size meta: ['is:'] agħmel: { :numru
	numru meta: ['+'] agħmel: { :numru
		>> unit := numru kwalifikazzjoni.
		>> factor := 1.
		
		unit
		każ: ['inch'] agħmel: { factor := 0.0833. }. <- innifsu + (numru * factor).
	}. <- numru.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Ħruġ ikteb: plank + edge, linja-ġdida.
