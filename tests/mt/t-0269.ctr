#Linux

(Fajl ġdid: ['/tmp/testje']) jeżisti falz: {
	Programm sistema: ['mkdir /tmp/testje'].	
}.

(Fajl ġdid: ['/tmp/testje/file1']) jeżisti falz: {
	Programm sistema: ['touch /tmp/testje/file1'].	
}.

(Fajl ġdid: ['/tmp/testje/folder1']) jeżisti falz: {
	Programm sistema: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Fajl lista: ['/tmp/testje'].

>> q := Lista ġdid.

l kull: { :k :v v kull: { :x :y q żid-fit-tmiem: y. }. }.

>> s := q test.

(s fih: ['file1']) veru:   { Ħruġ ikteb: ['OK'], linja-ġdida. }.
(s fih: ['file2']) veru:   { Ħruġ ikteb: ['XX'], linja-ġdida. }.
(s fih: ['folder1']) veru: { Ħruġ ikteb: ['OK'], linja-ġdida. }.
