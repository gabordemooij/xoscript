Ħruġ ikteb: ((Lista ġdid
	meta: ['plaque:'] agħmel: { :x proprju o := x. },
	meta: ['plaque']  agħmel: { <- proprju o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Lista ← 1)
	~ (Lista ← 1 ; 2)
	~ (Lista ← 1 ; 2 ; 3)
	~ (Lista ← 1 ; 2 ; 3 ; 4)
	~ (Lista ← 1 ; 2 ; 3 ; 4 ; 5)
) kull: { :i :el
	{ Ħruġ ikteb: dan-il-kompitu. } × el għodd.
	Ħruġ linja-ġdida.
}) plaque, linja-ġdida.


