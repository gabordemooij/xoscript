Lista meta: ['sum'] agħmel: {
	>> total := 0.
	innifsu kull: { :index :element
		total żid: element.
	}. <- total.
}.

>> a := Veru.



a meta: ['test'] agħmel: {
	>> answer := Xejn.
	( innifsu = Veru ) veru: {
		answer := ['Yep'].
	}, inkella: {
		answer := ['Nope'].
	}. <- answer.
}.

a meta: ['numru'] agħmel: {
	>> answer := Xejn.
	( innifsu = Veru ) veru: {
		answer := 10.
	}, inkella: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b meta: ['test'] agħmel: { <- ['Devil'].
}.

b meta: ['boolean'] agħmel: { <- Falz.
}.


Ħruġ ikteb: a, linja-ġdida.  
Ħruġ ikteb: (90 + a), linja-ġdida. 
Ħruġ ikteb: b, linja-ġdida. 
Ħruġ ikteb: (Veru u: b), linja-ġdida.

a := Lista ← ['hello'] ; ['world'] ; Veru ; Xejn ; 666. 
a := a + ( Lista ← 1 ).
Ħruġ ikteb: a, linja-ġdida.
Ħruġ ikteb: ((Dizzjunarju ġdid) poġġi: Xejn fi: Xejn), linja-ġdida.
Ħruġ ikteb: a sum, linja-ġdida. 


{
	a meta: ['test'] agħmel: { <- Xejn. }.
	a := [''] + a.
} aqbad: { :error
	Ħruġ ikteb: ['Error noted: '] + error, linja-ġdida.
}, ibda.



{
	a meta: ['numru'] agħmel: { <- Xejn. }.
	a := 3 × a.
} aqbad: { :error
	Ħruġ ikteb: ['Error noted: '] + error, linja-ġdida.
}, ibda.


{
	a meta: ['boolean'] agħmel: { <- Xejn. }.
	a := Veru u: a. 
} aqbad: { :error
	Ħruġ ikteb: ['Error noted: '] + error, linja-ġdida.
}, ibda.





