# a quote that never closes must give an error, not an endless loop
>> mogħdija := ['/tmp/test0821.csv'].
>> file := Fajl ġdid: mogħdija.

file ikteb: ['a,b\n"1,2\n'].
{
	file delimitatur: [','] virgoletta: ['"'] linji: { :line
		Ħruġ ikteb: line, linja-ġdida.
	}.
} aqbad: { :e Ħruġ ikteb: e, linja-ġdida. }, ibda.

# a closed quote still works
file ikteb: ['a,b\n"1,2",3'].
file delimitatur: [','] virgoletta: ['"'] linji: { :line
	Ħruġ ikteb: line, linja-ġdida.
}.
file ħassar.
