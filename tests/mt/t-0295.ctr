
>> dictionary := (
	Dizzjunarju ġdid
		poġġi: ['b'] fi: ['a'],
		poġġi: ['a'] fi: ['b'],
		poġġi: ['z'] fi: ['x'],
		poġġi: ['hello'] fi: ['hallo'],
		poġġi: ['human'] fi: ['human']
).

>> comparisons := Lista ġdid.
dictionary kull: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a qabbel: b)
	).
}.

comparisons issortja: { :a :b <- ( a qabbel: b ). }.
Ħruġ ikteb: ( comparisons għaqqad: ['↵'] ), linja-ġdida.
comparisons għaqqad: ['↵'].
