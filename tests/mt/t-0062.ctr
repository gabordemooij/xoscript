Boolean meta: ['xor:'] agħmel: { :a :b <- ((a u: b mhux) jew: (a mhux u: b)).
}.

>> o := Oġġett ġdid.
o meta: ['hello'] agħmel: { ['Empty']. }.
{ o meta: 2 agħmel: 3.} aqbad: { :e Ħruġ ikteb: e, linja-ġdida. }, ibda.
{ o meta: ['prova'] agħmel: 3.} aqbad: { :e Ħruġ ikteb: e, linja-ġdida. }, ibda.
{ o meta: ['hello'] agħmel: { ['Empty']. }.} aqbad: { :e Ħruġ ikteb: e, linja-ġdida. }, ibda. 
{ >> z := 4 ÷ 0. } aqbad: { :e Ħruġ ikteb: e, linja-ġdida. }, ibda. 
{ (Veru u: Xejn) veru: { Ħruġ ikteb: ['X'].}. } aqbad: { :e Ħruġ ikteb: e, linja-ġdida. }, ibda. 
{ ([''] xor: 0) veru: { Ħruġ ikteb: ['X'].}. } aqbad: { :e Ħruġ ikteb: e, linja-ġdida. }, ibda. 
{ (1 < ['2']) veru: { Ħruġ ikteb: ['OK']. }. } aqbad: { :e Ħruġ ikteb: e, linja-ġdida. }, ibda. 
{ (1 < ['2.0']) veru: { Ħruġ ikteb: ['OK']. }. } aqbad: { :e Ħruġ ikteb: e, linja-ġdida. }, ibda. 
{ (1 < ['x2.0']) veru: { Ħruġ ikteb: ['NO!']. }. } aqbad: { :e Ħruġ ikteb: e, linja-ġdida. }, ibda. 
{ Ħruġ ikteb: (['hello OK there'] minn: ['6'] tul: ['2']). } ibda. 
