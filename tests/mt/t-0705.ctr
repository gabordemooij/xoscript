

>> obj := Oġġett ġdid.

obj meta: ['greet'] agħmel: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj meta: ['task'] agħmel: {
	proprju property := 123.
	{
		# try binds self/own to object instead of block
		Ħruġ ikteb: innifsu greet.
		Ħruġ ikteb: proprju property.
		1 / 0.
	} aqbad: {
		Ħruġ ikteb: innifsu greet.
		Ħruġ ikteb: proprju property.
		Ħruġ ikteb: ['ok'].
	}, ipprova.
}.

obj task.