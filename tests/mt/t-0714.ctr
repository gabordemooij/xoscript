>> a := Oġġett ġdid. 
a meta: ['greet'] agħmel: { Ħruġ ikteb: ['welcome!'], linja-ġdida. }.
a meta: ['greet2'] agħmel: { Ħruġ ikteb: ['welcome2!'], linja-ġdida. }.
a save-as: ['/tmp/a.bin'].

Ħruġ ikteb: ['========== RELOADING SNAP:'], linja-ġdida.
>> b := Oġġett load-from: ['/tmp/a.bin'].
b greet2.