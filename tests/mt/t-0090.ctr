Ħruġ ikteb: ['1,2,3,4,5,6,7,8,9,A,'], linja-ġdida.
>> Scope := Oġġett ġdid.
Scope meta: ['initialize:'] agħmel: { :x proprju property := x. }.
Scope meta: ['confirm'] agħmel: { Ħruġ ikteb: [',']. }.
Scope meta: ['prova'] agħmel: {
	Ħruġ ikteb: proprju property.
	innifsu confirm.
	( 1 = 1 ) veru: { Ħruġ ikteb: proprju property. innifsu confirm. }.
	( 1 = 0 ) falz: { Ħruġ ikteb: proprju property. innifsu confirm. }.
	>> y := 2. { Ħruġ ikteb: proprju property. innifsu confirm. } sakemm: { y naqqas: 1. <- (y > 0). }.
	{ Ħruġ ikteb: proprju property. innifsu confirm. } × 1.
	(Lista ← 1) kull: {  Ħruġ ikteb: proprju property. innifsu confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Dizzjunarju ġdid one: ['item']) kull: { Ħruġ ikteb: proprju property. innifsu confirm. }.
	{ 1 ÷ 0. } aqbad: { Ħruġ ikteb: proprju property. innifsu confirm. }, ibda.
	Ħruġ linja-ġdida.
}.
>> scope1 := Scope ġdid.
scope1 initialize: ['X'].
scope1 prova.
>> function := { 
	proprju property := ['Y'].
	Ħruġ ikteb: proprju property.
	innifsu confirm.
	( 1 = 1 ) veru: { Ħruġ ikteb: proprju property. innifsu confirm. }.
	( 1 = 0 ) falz: { Ħruġ ikteb: proprju property. innifsu confirm. }.
	>> y := 2. { Ħruġ ikteb: proprju property. innifsu confirm. } sakemm: { y naqqas: 1. <- (y > 0). }.
	{ Ħruġ ikteb: proprju property. innifsu confirm. } × 1.
	(Lista ← 1) kull: {  Ħruġ ikteb: proprju property. innifsu confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Dizzjunarju ġdid one: ['item']) kull: { Ħruġ ikteb: proprju property. innifsu confirm. }.
	{ 1 ÷ 0. } aqbad: { Ħruġ ikteb: proprju property. innifsu confirm. }, ibda.
	Ħruġ linja-ġdida.
}.
function meta: ['confirm'] agħmel: { Ħruġ ikteb: [',']. }.
function applika: 1 u: 2.
