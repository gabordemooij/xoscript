

Test meta: ['evaluate'] agħmel: {
	>> kodiċi := Fajl ġdid: ['/tmp/eval.ctr'].
	kodiċi ikteb: (innifsu test + ['.']).
	Programm uża: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Lista ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q test.
Ħruġ ikteb: x, linja-ġdida.
>> y := Xejn.
(['y := '] + x ) evaluate.
Ħruġ ikteb: y ? 0, linja-ġdida.

q := Dizzjunarju poġġi: ['\[''] fi: ['\['quote\']'].
x := q test.
Ħruġ ikteb: x, linja-ġdida.
y := Xejn.
(['y := '] + x ) evaluate.

>> q := (Dizzjunarju ġdid) poġġi:['\[''] fi:['\['quote\[''].
Ħruġ ikteb: y ? ['\['quote\']'], linja-ġdida.
