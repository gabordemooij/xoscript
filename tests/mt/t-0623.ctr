

>> g := Server ġdid.
>> v := Kaxxaforti ġdid.
>> ok := 0.

>> secrets := Lista ġdid ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> passwords := secrets ikkopja.
passwords kull: { :i :p
	secrets kull: { :n :s
		{
			>> encrypted := v ikkripta: s ċavetta: p.
			>> decrypted := v iddekripta: encrypted ċavetta: p.
			(decrypted = s) veru: {
				ok żid: 1.
			}, inkella: {
				Ħruġ ikteb: ['failed encrypting/decrypting: '], linja-ġdida.
				Ħruġ ikteb: s, linja-ġdida.
				Ħruġ ikteb: ['encrypted: '] + encrypted, linja-ġdida.
				Ħruġ ikteb: ['decrypted: '] + encrypted, linja-ġdida.
				Programm tmiem.
			}.
		} aqbad: { :err
			(s = [''] jew: p = ['']) veru: {
				ok żid: 1.
			}, inkella: {
				Ħruġ ikteb: err, linja-ġdida.
				Programm tmiem.
			}.
		}, ibda.
	}.
}.

Ħruġ ikteb: ( ok + [' vault encryptions tested.'] ), linja-ġdida.