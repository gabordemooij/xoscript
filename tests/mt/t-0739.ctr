Ħruġ ikteb: ['Test object'], linja-ġdida.
>> a := Oġġett ġdid. 

a meta: ['item:'] agħmel: { :binhelper
	proprju binhelper := binhelper. 
}.

a meta: ['item'] agħmel: { <- proprju binhelper.
}.

a item: Bin ġdid.

>> old-binhelper-address := a item prototip indirizz-memorja.
a save-as: ['/tmp/a.bin'].
Ħruġ ikteb: ['========== RELOADING SNAP:'], linja-ġdida.

>> b := Oġġett load-from: ['/tmp/a.bin'].

(b item prototip indirizz-memorja = old-binhelper-address) veru: {
	Ħruġ ikteb: ['Object link re-attached.'], linja-ġdida.
}.


