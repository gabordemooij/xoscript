>> phrases := Lista ġdid
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases kull: { :_ :phrase 
	>> e := Server base64-ikkodifika: phrase.
	>> d := Server base64-iddekodifika: e.
	Ħruġ ikteb: (
		message ikkopja ~encoded: e, ~decoded: d
	), linja-ġdida.
}.
