
Ħruġ ikteb: ['Break for-loop, 0-4.'], linja-ġdida.
{ :i
	Ħruġ ikteb: ['iteration #'] + i, linja-ġdida.
	(i = 4) waqqaf.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Ħruġ ikteb: ['Break while-true loop, 0-4.'], linja-ġdida.
{
	Ħruġ ikteb: ['iteration #'] + x, linja-ġdida.
	x żid: 1.
	((x < 5) mhux) waqqaf.
} sakemm: xIsLessThan10.

Ħruġ ikteb: ['Break while-false loop, 5,4.'], linja-ġdida.
{
	Ħruġ ikteb: ['iteration #'] + x, linja-ġdida.
	x naqqas: 1.
	(x = 3) waqqaf.
} sakemm: { <- (x > 0). }.

Ħruġ ikteb: ['Break times loop, 1-4.'], linja-ġdida.
{ :i
	Ħruġ ikteb: ['iteration #'] + i, linja-ġdida.
	(i = 4) waqqaf.
} × 5.

Ħruġ ikteb: ['Break block, dont print line.'], linja-ġdida.
{ Veru waqqaf. Ħruġ ikteb: ['dont write this!'], linja-ġdida. } ibda.

Ħruġ ikteb: ['Break block, dont fire catch...'], linja-ġdida.
{ Veru waqqaf. Ħruġ ikteb: ['dont write this!'], linja-ġdida. } aqbad: { Ħruġ ikteb: ['Dont catch this!']. }, ibda.

Ħruġ ikteb: ['Test Array each-loop: 0,1'], linja-ġdida.
(Lista ← 1 ; 2 ; 3) immappja: { :i
	Ħruġ ikteb: ['iteration #'] + i, linja-ġdida.
	(i = 1) waqqaf.
}.

Ħruġ ikteb: ['Test Map each-loop: c only'], linja-ġdida.
>> m := Dizzjunarju ġdid.
m poġġi: ['first'] fi: ['a'], poġġi: ['second'] fi: ['b'], poġġi: ['third'] fi: ['c'].
m kull: { :k :v
	Ħruġ ikteb: ['iteration'] + v + k, linja-ġdida.
	Veru waqqaf.
}.

