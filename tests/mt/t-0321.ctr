# test qualifiers

Programm naddaf.

>> Fruit := Oġġett ġdid.
Fruit meta: ['ġdid'] agħmel: {
	>> f := innifsu ġdid.
	f apples: 0. <- f.
}.
Fruit meta: ['apples:'] agħmel: { :a proprju apples := a. }.
Fruit meta: ['apples'] agħmel: { <- proprju apples. }.
Fruit meta: ['+'] agħmel: { :f
	>> n := Fruit ġdid.
	n apples: (f apples + proprju apples). <- n.
}.
Numru meta: ['apples'] agħmel: { <- ((Fruit ġdid) apples: innifsu).
}.

Fruit meta: ['test'] agħmel: { <- proprju apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Ħruġ ikteb: q, linja-ġdida.




q := 3 apples + 4 apples.
Ħruġ ikteb: q, linja-ġdida.



q := 3 apples + 4 apples.
Ħruġ ikteb: q, linja-ġdida.


