

# create a 64-bit integer for exact calculations
>> a := Int64 minn-test: ['123'].

# to string
Ħruġ ikteb: a, linja-ġdida.

# divide
Ħruġ ikteb: a / (Int64 minn-test: ['3']), linja-ġdida.

# multiply
Ħruġ ikteb: a * (Int64 minn-test: ['2']), linja-ġdida.

# add
Ħruġ ikteb: a + (Int64 minn-test: ['1']), linja-ġdida.

# subtract
Ħruġ ikteb: a - (Int64 minn-test: ['2']), linja-ġdida.

# compare
Ħruġ ikteb: ( a =   (Int64 minn-test: ['123'])), linja-ġdida.
Ħruġ ikteb: ( a !=: (Int64 minn-test: ['124'])), linja-ġdida.
Ħruġ ikteb: ( a <   (Int64 minn-test: ['124'])), linja-ġdida.
Ħruġ ikteb: ( a >   (Int64 minn-test: ['122'])), linja-ġdida.
Ħruġ ikteb: ( a >=: (Int64 minn-test: ['123'])), linja-ġdida.
Ħruġ ikteb: ( a <=: (Int64 minn-test: ['123'])), linja-ġdida.





	