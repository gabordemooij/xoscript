


>> CoffeeMachine := Oġġett ġdid.
CoffeeMachine meta: ['order:'] agħmel: { :id
	>> coffee := ['Americano'].
	( id = 1 ) veru: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) veru: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) veru: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Oġġett ġdid.
SimpleCoffeeMachine meta: ['order'] agħmel: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Ħruġ ikteb: redCup, linja-ġdida.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Ħruġ ikteb: greenCup, linja-ġdida.
>> yellowCup := CoffeeMachine order: 1.
Ħruġ ikteb: yellowCup, linja-ġdida.
>> blueCup := CoffeeMachine order: 0.
Ħruġ ikteb: blueCup, linja-ġdida.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Ħruġ ikteb: blackCup, linja-ġdida.
blackCup żid-fit-tmiem: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Ħruġ ikteb: orangeCup, linja-ġdida.
