Ħruġ ikteb: ['Test object'], linja-ġdida.
>> a := Oġġett ġdid. 
a meta: ['item:'] agħmel: { :int64
	proprju int64 := int64. 
}.
a meta: ['item'] agħmel: { <- proprju int64.
}.
a item: ( Int64 minn-test: ['9999'] ).
Ħruġ ikteb: a item, linja-ġdida.
>> old-int64-address := a item prototip indirizz-memorja.
a save-as: ['/tmp/a.bin'].
Ħruġ ikteb: ['========== RELOADING SNAP:'], linja-ġdida.
>> b := Oġġett load-from: ['/tmp/a.bin'].
(b item prototip indirizz-memorja = old-int64-address) veru: {
	Ħruġ ikteb: ['Object link re-attached.'], linja-ġdida.
}.
Ħruġ ikteb: ( b item ), linja-ġdida.
