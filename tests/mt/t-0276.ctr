>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Oġġett ġdid.
⚄ meta: ['drawFrom:length:'] agħmel: { :pool :għodd
	
	>> result := [''].
	
	{
		>> index := Numru random % (pool tul).
		result żid-fit-tmiem: ( pool karattru: (index + 1) ).
		
	} × għodd. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? tul.
Ħruġ ikteb: (['x↵'] x random tul).
Ħruġ ikteb: (['y↵'] y ?? tul).

