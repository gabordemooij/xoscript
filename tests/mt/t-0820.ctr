# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Mudell ġdid: pattern.
	p taqbila: subject agħmel: { :m :g
		Ħruġ ikteb: g għodd, ikteb: [' '], ikteb: (g għaqqad: ['|']), linja-ġdida. <- m.
	}.
}.
show applika: ['(a)|(b)'] u: ['b'].
show applika: ['(a)|(b)'] u: ['a'].
show applika: ['(x)?y'] u: ['y'].
show applika: ['(x)?(y)(z)?'] u: ['xy'].
