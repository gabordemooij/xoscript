

Lista meta: ['column:'] agħmel: { :column
	>> result := Lista ġdid.
	innifsu kull: { :index :row
		row kull: { :index :cell
			(index = column) veru: { result żid-fit-tmiem: cell. }.
		}.
	}. <- result.
}.


>> a := Lista ←
	(Lista ← 1 ; 2 ; 3) ;
	(Lista ← 4 ; 5 ; 6) ;
	(Lista ← 7 ; 8 ; 9).

>> b := a column: 1.
Ħruġ ikteb: b, linja-ġdida.

b := a column: 20.
Ħruġ ikteb: b, linja-ġdida.

b := a column: -100.
Ħruġ ikteb: b, linja-ġdida.
