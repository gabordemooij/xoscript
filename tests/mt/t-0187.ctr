Numru meta: ['factorial'] agħmel: {
	>> total := 1.
	{ :index total immoltiplika-bi: (innifsu - index). } × innifsu. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm ġestjoni-memorja: 0.

{
2 exponent factorial.
Ħruġ ikteb: (11 modulo: 3), linja-ġdida.
Ħruġ ikteb: (3.4 arrotonda), linja-ġdida.
Ħruġ ikteb: (7.1 arrotonda-fuq), linja-ġdida.
Ħruġ ikteb: (7.9 arrotonda-isfel), linja-ġdida.
}
ibda.

Programm naddaf.

usedMemory1 := (Programm memorja ? 0).

{
2 exponent factorial.
Ħruġ ikteb: (11 modulo: 3), linja-ġdida.
Ħruġ ikteb: (3.4 arrotonda), linja-ġdida.
Ħruġ ikteb: (7.1 arrotonda-fuq), linja-ġdida.
Ħruġ ikteb: (7.9 arrotonda-isfel), linja-ġdida.
}
ibda.

Programm naddaf.
usedMemory2 := (Programm memorja ? 0).


{
2 exponent factorial.
Ħruġ ikteb: (11 modulo: 3), linja-ġdida.
Ħruġ ikteb: (3.4 arrotonda), linja-ġdida.
Ħruġ ikteb: (7.1 arrotonda-fuq), linja-ġdida.
Ħruġ ikteb: (7.9 arrotonda-isfel), linja-ġdida.
} ibda.

Programm naddaf.
usedMemory3 := (Programm memorja ? 0).



( usedMemory1 = usedMemory2 u: usedMemory1 = usedMemory3, u: usedMemory2 = usedMemory3 ) veru: {
	Ħruġ ikteb: ['No memory leaks here'].
}, falz: {
	Ħruġ ikteb: ['Leaking memory...'].
}.
