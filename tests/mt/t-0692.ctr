Server init.

Ħruġ ikteb: (
	Mudell ġdid: ['^\\w+$'],
	taqbila: ['test@example.com'] 
), linja-ġdida. # 0 match, fails on @ and .

Ħruġ ikteb: (
	Mudell ġdid: ['^[^@]+@[^\.]+\.\\w+$'],
	taqbila: ['test@example.com'] 
), linja-ġdida. # 1 match

Ħruġ ikteb: (
	Mudell ġdid: ['[^@]+@[^\.]+\.\\w+'],
	taqbila: ['test@example.com'] 
), linja-ġdida. # 1 match

Ħruġ ikteb: (
	Mudell ġdid: ['([^@]+)@([^\.]+)\.\\w+'],
	taqbila: ['test@example.com'] 
), linja-ġdida. # 1 match, groups dont matter

Ħruġ ikteb: (
	Mudell ġdid: ['[a-z]'],
	taqbila: ['test@example.com'] 
), linja-ġdida. # 14 matches

Ħruġ ikteb: (
	Mudell ġdid: ['.*'],
	taqbila: ['test@example.com'] 
), linja-ġdida. # 1 match (all)

Ħruġ ikteb: (
	Mudell ġdid: ['(.*)'],
	taqbila: ['test@example.com'] 
), linja-ġdida. # 1 match (all)

Ħruġ ikteb: (
	Mudell ġdid: ['\\s*[^@]+@[^\.]+\.\\w+'],
	taqbila: ['test@example.com'] 
), linja-ġdida. # 1 match, prefix space optional, gets ignored