
Server init.
>> rq := HTTP-Talba ġdid.
Ħruġ ikteb: ['HTTP-GET d[]=']  + ( rq get-lista: ['d[]'] ), linja-ġdida. # GET
Ħruġ ikteb: ['HTTP-GET f[]=']  + ( rq get-lista: ['f[]'] ), linja-ġdida. # GET
Ħruġ ikteb: ['HTTP-POST e[]='] + ( rq post-lista: ['e[]'] ), linja-ġdida. # GET
Ħruġ ikteb: ['HTTP-POST c=']   + ( rq post: ['c'] ), linja-ġdida. # GET
Ħruġ ikteb: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), linja-ġdida. # GET
