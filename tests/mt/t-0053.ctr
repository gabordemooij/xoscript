60 × {
	>> x := (Numru random % 6) + 1.
	(x ≤ 6) falz: { Ħruġ ikteb: ['FAIL']. }.
	(x ≥0) falz: { Ħruġ ikteb: ['FAIL']. }.
	x := (Numru random % 3) + 1.
	(x < 3) falz: { Ħruġ ikteb: ['FAIL']. }.
	(x>-1) falz: { Ħruġ ikteb: ['FAIL']. }.
	x := ((Boolean flip) numru).
	(x = 0 jew: x = 1) falz: { Ħruġ ikteb: ['FAIL']. }.
	x := ((Veru flip) numru).
	(x = 0 jew: x = 1) falz: { Ħruġ ikteb: ['FAIL']. }.
	x := (Boolean flip jew: ['HEAD'] jew: ['TAIL']).
	((x = ['HEAD']) jew: (x = ['TAIL'])) falz: { Ħruġ ikteb: ['FAIL']. }.
}.
Ħruġ ikteb: ['DONE'].

