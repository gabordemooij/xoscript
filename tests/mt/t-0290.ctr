# test list operations


>> cakes := Lista ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes ibdel: 1 tul: 2 bi: ( Lista ← ['cinnamon'] ; ['pineapple'] ).
Ħruġ ikteb: (buy għaqqad: [',']), linja-ġdida.


>> buy := cakes ibdel: 1 tul: 12 bi: ( Lista ← ['cinnamon'] ; ['pineapple'] ).
Ħruġ ikteb: (buy għaqqad: [',']), linja-ġdida.


>> buy := cakes ibdel: 2 tul: 10 bi: ( Lista ġdid ).
Ħruġ ikteb: (buy għaqqad: [',']), linja-ġdida.


>> buy := cakes ibdel: 0 tul: 1 bi: ( Lista ġdid ).
Ħruġ ikteb: (buy għaqqad: [',']), linja-ġdida.


>> buy := cakes ibdel: ['0'] tul: ['1'] bi: ['x'].
Ħruġ ikteb: (buy għaqqad: [',']), linja-ġdida.
