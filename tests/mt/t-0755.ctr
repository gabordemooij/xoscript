Ħruġ ikteb: ['Test object'], linja-ġdida.
>> greeter := Oġġett ġdid.
greeter meta: ['name:'] agħmel: { :isem
	proprju xname := isem. 
}.
greeter meta: ['greet'] agħmel: {
	Ħruġ ikteb: ['Hello '] + proprju xname, linja-ġdida.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Ħruġ ikteb: ['========== RELOADING SNAP:'], linja-ġdida.
>> b := Oġġett load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
