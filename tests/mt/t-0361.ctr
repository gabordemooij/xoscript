
>> XX := Oġġett ġdid.
>> X := Oġġett ġdid.

XX meta: ['QQ'] agħmel: { <- 1. }.
XX meta: ['Q'] agħmel: { <- 1. }.
XX meta: ['QQ:'] agħmel: { <- 1. }.
XX meta: ['QQ:QQ:'] agħmel: { <- 1. }.

