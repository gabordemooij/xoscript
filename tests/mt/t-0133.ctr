


>> Deck := Lista ġdid.
Deck meta: ['print'] agħmel: {
        >> len := innifsu għodd - 1.
        { :i
                >> len2 := innifsu għodd - 1.
                Ħruġ ikteb: ['len: '].
                Ħruġ ikteb: len, linja-ġdida.
                Ħruġ ikteb: ['len2: '].
                Ħruġ ikteb: len2, linja-ġdida.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
