


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm ġestjoni-memorja: 0.
>> palette := Xejn.
>> colors := Xejn.

{
palette := Dizzjunarju ġdid.
palette 
	poġġi: ['#F00'] fi: ['red'],
	poġġi: ['#0F0'] fi: ['green'],
	poġġi: ['#00F'] fi: ['blue'].
Ħruġ ikteb: ['number of RGB codes in palette: '] + ( palette għodd ), linja-ġdida.
Ħruġ ikteb: ['RGB code of green is: '] + ( palette ? ['green'] ), linja-ġdida.
colors := [''].
( palette kull: { :isem :kodiċi
		colors := colors + ( isem + [':'] + kodiċi ).
} ).
Ħruġ ikteb: ['All colors in palette: '] + colors, linja-ġdida.
} ibda.
Programm naddaf.
usedMemory1 := (Programm memorja ? 0).

{
palette := Dizzjunarju ġdid.
palette 
	poġġi: ['#F00'] fi: ['red'],
	poġġi: ['#0F0'] fi: ['green'],
	poġġi: ['#00F'] fi: ['blue'].
Ħruġ ikteb: ['number of RGB codes in palette: '] + ( palette għodd ), linja-ġdida.
Ħruġ ikteb: ['RGB code of green is: '] + ( palette ? ['green'] ), linja-ġdida.
colors := [''].
( palette kull: { :isem :kodiċi
		colors := colors + ( isem + [':'] + kodiċi ).
} ).
Ħruġ ikteb: ['All colors in palette: '] + colors, linja-ġdida.
} ibda.
Programm naddaf.
usedMemory2 := (Programm memorja ? 0).

{
palette := Dizzjunarju ġdid.
palette 
	poġġi: ['#F00'] fi: ['red'],
	poġġi: ['#0F0'] fi: ['green'],
	poġġi: ['#00F'] fi: ['blue'].
Ħruġ ikteb: ['number of RGB codes in palette: '] + ( palette għodd ), linja-ġdida.
Ħruġ ikteb: ['RGB code of green is: '] + ( palette ? ['green'] ), linja-ġdida.
colors := [''].
( palette kull: { :isem :kodiċi
		colors := colors + ( isem + [':'] + kodiċi ).
} ).
Ħruġ ikteb: ['All colors in palette: '] + colors, linja-ġdida.
} ibda.
Programm naddaf.
usedMemory3 := (Programm memorja ? 0).



( usedMemory1 = usedMemory2 u: usedMemory1 = usedMemory3, u: usedMemory2 = usedMemory3 ) veru: {
	Ħruġ ikteb: ['No memory leaks here'].
}, falz: {
	Ħruġ ikteb: ['Leaking memory...'].
}.
