Ħruġ ikteb: ['Test object'], linja-ġdida.
>> a := Oġġett ġdid. 

a meta: ['item:'] agħmel: { :hexhelper
	proprju hexhelper := hexhelper. 
}.

a meta: ['item'] agħmel: { <- proprju hexhelper.
}.

a item: Hx ġdid.

>> old-hexhelper-address := a item prototip indirizz-memorja.
a save-as: ['/tmp/a.bin'].
Ħruġ ikteb: ['========== RELOADING SNAP:'], linja-ġdida.

>> b := Oġġett load-from: ['/tmp/a.bin'].

(b item prototip indirizz-memorja = old-hexhelper-address) veru: {
	Ħruġ ikteb: ['Object link re-attached.'], linja-ġdida.
}.
