	>> massimu := ( a > b ) jew: a jew: b.
	>> x := Xejn.
	{
		x := Numru bejn: a u: b.
		((x < minimu) jew: (x > massimu)) veru: { 
			Ħruġ ikteb: (['Invalid value!']).
			Programm tmiem.
		}.
	} 
	× 100. <- x.
}.
