#Linux
>> clock := Mument ġdid.
clock żona: ['UTC-1'].
clock sena: 1981, xahar: 1, jum: 5,
      siegħa: 13, minuta: 15, sekonda: 13.

Ħruġ ikteb: clock, linja-ġdida.
clock żona: ['UTC+0'].

Ħruġ ikteb: (
	(clock sena sempliċi) + ['-'] + (clock xahar) + ['-'] + (clock jum) + [' '] +
	(clock siegħa) + [':'] + (clock minuta) + [':'] + (clock sekonda) + [' '] +
	['W'] + (clock ġimgħa) + (clock żona)
), linja-ġdida.


clock żona: ['UTC-1'].
Ħruġ ikteb: (
	(clock sena sempliċi) + ['-'] + (clock xahar) + ['-'] + (clock jum) + [' '] +
	(clock siegħa) + [':'] + (clock minuta) + [':'] + (clock sekonda) + [' '] +
	['W'] + (clock ġimgħa) + (clock żona)
), linja-ġdida.
