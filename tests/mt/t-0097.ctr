
Test meta: ['html'] agħmel: { <- (
		innifsu
		ibdel: ['&'] bi: ['&amp;'],
		ibdel: ['<'] bi: ['&lt;'],
		ibdel: ['>'] bi: ['&gt;'],
		ibdel: ['"'] bi: ['&quot;']
	).
}.

>> HtmlBrush := Oġġett ġdid.

HtmlBrush meta: ['wieġeb:'] agħmel: { :tag
	Ħruġ ikteb: (['<tag>↵'] tag: tag ).
}.

HtmlBrush meta: ['wieġeb:u:'] agħmel: { :tag :content
	tag := ( tag minn: 0 tul: (tag tul - 1) ).
	Ħruġ ikteb: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush meta: ['content:'] agħmel: { :text
	Ħruġ ikteb: text html, linja-ġdida.
}.

HtmlBrush meta: ['attr:value:'] agħmel: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush ġdid.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
