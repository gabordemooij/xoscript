Ħruġ ikteb: ['Test object'], linja-ġdida.
>> a := Oġġett ġdid. 

a meta: ['item:'] agħmel: { :num
	proprju num := num. 
}.

a meta: ['item'] agħmel: { <- proprju num.
}.

a item: 123.

Ħruġ ikteb: a item, linja-ġdida.

>> old-num-address := a item prototip indirizz-memorja.
a save-as: ['/tmp/a.bin'].
Ħruġ ikteb: ['========== RELOADING SNAP:'], linja-ġdida.

>> b := Oġġett load-from: ['/tmp/a.bin'].

(b item prototip indirizz-memorja = old-num-address) veru: {
	Ħruġ ikteb: ['Object link re-attached.'], linja-ġdida.
}.

Ħruġ ikteb: b item, linja-ġdida.
