# test buffers PKI/Sign 
Server init.

>> long := ( Lista ġdid imla: 1000 bi: ['a'] ) għaqqad: [''].

# sign a message
Ħruġ ikteb: ( 
	Kaxxaforti iffirma: ['abc'] bi: long
), linja-ġdida.

Ħruġ ikteb: ( 
	Kaxxaforti
		iċċekkja: ['abc'] 
		firma: long 
		bi: long
), linja-ġdida.

Ħruġ ikteb: (
	Kaxxaforti hash-password: long ivverifika: long
), linja-ġdida.
