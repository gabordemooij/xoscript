
>> Greeter := Oġġett ġdid.
Greeter meta: ['ġdid'] agħmel: {
	proprju isem := ['?'].
}.
Greeter meta: ['name:'] agħmel: { :isem
	proprju isem := isem.
}.
Greeter meta: ['greet'] agħmel: {
	Ħruġ ikteb: (['hello[you]'] [you]: proprju isem).
}.
>> friend := Greeter ġdid.
friend name: ['1'].
friend greet.
