

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm ġestjoni-memorja: 0.

Numru meta: ['addNum:'] agħmel: { :x
	innifsu żid: x.
}.

Numru meta: ['subtractNum:'] agħmel: { :x
	innifsu naqqas: x.
}.

Numru meta: ['multiplyBy:'] agħmel: { :x
	innifsu immoltiplika-bi: x.
}.

Numru meta: ['divideBy:'] agħmel: { :x
	innifsu aqsam-bi: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 qawwa: 8).  
a := a + (2 qawwa: -1). 
a := a + (49 għerq-kwadru).   
a addNum: ((Lista ← 0 ; 1) massimu).          
a addNum: ((Lista ← 2 ; 3) minimu).
Ħruġ ikteb: a.

Programm naddaf.

usedMemory1 := (Programm memorja ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 qawwa: 8).  
a := a + (2 qawwa: -1). 
a := a + (49 għerq-kwadru).   
a addNum: ((Lista ← 0 ; 1) massimu).          
a addNum: ((Lista ← 2 ; 3) minimu).
Ħruġ ikteb: a.

Programm naddaf.
usedMemory2 := (Programm memorja ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 qawwa: 8).  
a := a + (2 qawwa: -1). 
a := a + (49 għerq-kwadru).   
a addNum: ((Lista ← 0 ; 1) massimu).          
a addNum: ((Lista ← 2 ; 3) minimu).
Ħruġ ikteb: a.

Programm naddaf.
usedMemory3 := (Programm memorja ? 0).



( usedMemory1 = usedMemory2 u: usedMemory1 = usedMemory3, u: usedMemory2 = usedMemory3 ) veru: {
	Ħruġ ikteb: ['No memory leaks here'].
}, falz: {
	Ħruġ ikteb: ['Leaking memory...'].
}.
