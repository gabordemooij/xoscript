>> To-Do := Oġġett ġdid.

To-Do meta: ['ġdid'] agħmel: {
	proprju list := Lista ġdid.
}.

To-Do meta: ['nieuw'] agħmel: {
	proprju list := Lista ġdid.
}.

To-Do meta: ['+'] agħmel: { :task
	proprju list żid-fit-tmiem: task.
}.

To-Do meta: ['number of tasks?'] agħmel: { <-  proprju list għodd.
}.

>> todos := 
	To-Do ġdid 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Ħruġ ikteb: ['You have $ tasks to do'] $ todos number of tasks?.
