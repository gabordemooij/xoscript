Programm ġestjoni-memorja: 4.

>> Doubler := Oġġett ġdid.
>> Multiplier := Oġġett ġdid.
Doubler meta: ['double:and:'] agħmel: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier meta: ['multiply:and:'] agħmel: { :x :y <- (x × y).
}.

Ħruġ ikteb: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), linja-ġdida.
