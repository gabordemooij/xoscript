#ffi test


Server init.

Programm ġestjoni-memorja: 4.

# for this test you need set a path to libc (puts)
>> libname := Programm issettjar: ['FFITESTLIB'].



Server għaqqad-ma: (
 Lista ġdid ;
 libname ;
 ['puts'] ;
 ( Lista ġdid ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s eħles.

# test with struct

>> a := Blob ġdid: 8.
a bytes: (
	Lista <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Lista <<: ['int'], ; ['int']).

Server għaqqad-ma: (
	Lista <<: ['@structtest'], ;
	['@structtest'] ;
	(Lista <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Ħruġ ikteb: ['Sum test:'] + (ffitest ffisum: a), linja-ġdida.

struct eħles-struct.
struct eħles.
a eħles.
