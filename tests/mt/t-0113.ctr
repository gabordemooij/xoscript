Ħruġ ikteb: ['Continue for-loop, No - before 6 and up.'], linja-ġdida.
{ :i
	Ħruġ ikteb: (i + 1), linja-ġdida.
	((i + 1) > 4) kompli.
	Ħruġ ikteb: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Ħruġ linja-ġdida.
Ħruġ ikteb: ['Continue while-true, No --> before 5 and up.'], linja-ġdida.
{
	Ħruġ ikteb: ['iteration #'] + x, linja-ġdida.
	x żid: 1.
	((x < 5) mhux) kompli.
	Ħruġ ikteb: ['-->'].
} sakemm: xIsLessThan10.
Ħruġ linja-ġdida.
Ħruġ ikteb: ['Continue while-false, No - before 3 only.'], linja-ġdida.
{
	Ħruġ ikteb: ['iteration #'] + x, linja-ġdida.
	x naqqas: 1.
	(x = 3) kompli.
	Ħruġ ikteb: ['-'].
} sakemm: { <- ( x > 0). }.

Ħruġ linja-ġdida.
Ħruġ ikteb: ['Continue times-loop, No ||| before 3.'], linja-ġdida.
{ :i
	Ħruġ ikteb: ['iteration #'] + i, linja-ġdida.
	(i = 2) kompli.
	Ħruġ ikteb: ['|||'].
} × 5.

Ħruġ linja-ġdida.

{ Veru kompli. Ħruġ ikteb: ['dont write this!'], linja-ġdida. } ibda.

{ Veru kompli. Ħruġ ikteb: ['dont write this!'], linja-ġdida. } aqbad: { Ħruġ ikteb: ['Dont catch this!']. }, ibda.

Ħruġ ikteb: ['Test Array each-loop: 0, ... ,2'], linja-ġdida.
(Lista ← 1 ; 2 ; 3) immappja: { :i
	(i = 1) kompli.
	Ħruġ ikteb: ['iteration #'] + (i - 0), linja-ġdida.
}.

Ħruġ ikteb: ['Test Map each-loop: c only'], linja-ġdida.
>> m := Dizzjunarju ġdid.
m poġġi: ['first'] fi: ['a'], poġġi: ['second'] fi: ['b'], poġġi: ['third'] fi: ['c'].
m kull: { :k :v
	(k ≠ ['c']) kompli.
	Ħruġ ikteb: ['iteration'] + k + v, linja-ġdida.
}.

