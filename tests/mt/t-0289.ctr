#Linux
>> OS := Programm sistema: (Kmand uname -s), aqta-spazji.

>> Slurp := Oġġett ġdid.
Slurp meta: ['ġdid'] agħmel: {
	proprju str := [''].
}.
Slurp meta: ['wieġeb:'] agħmel: { :blah
		(proprju str ≠ ['']) veru: {
			proprju str żid-fit-tmiem: [' '].
		}.
		proprju str żid-fit-tmiem: blah.
}.
Slurp meta: ['wieġeb:u:'] agħmel: { :blah :blahah
		(proprju str ≠ ['']) veru: {
			proprju str żid-fit-tmiem: [' '].
		}.
		(blah tul > 1) veru: {
			proprju str żid-fit-tmiem: (blah minn: 0 tul: (blah tul - 1)).
		}, inkella: {
			proprju str żid-fit-tmiem: blah.
		}.
		proprju str żid-fit-tmiem: [' '].
		proprju str żid-fit-tmiem: blahah.
}.
Slurp meta: ['obtain'] agħmel: {
	>> buffer := proprju str.
	proprju str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text żid-fit-tmiem: ['hello'].
} × 1000.


Ħruġ ikteb: (
	Programm sistema: (
		Slurp ġdid
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

