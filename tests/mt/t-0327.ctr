

Lista meta: ['fixture:'] agħmel: { :f
	proprju fixture := f.
}.

Lista meta: ['għodd'] agħmel: { <- proprju fixture.
}.

Lista meta: ['aantal'] agħmel: { <- proprju fixture.
}.


>> x := Xejn.
{

	x := ['hello'] 
	ibdel:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] karattru: 2)
			)
		)
	bi: (
		(['...hal'] + ['lo']) 
			majuskoli 
			lowecase 
			majuskoli 
			spostament: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Lista ← 0 ; 1 ; 4; 9 ; (Lista ← 0 ; 3; 1) ; 4
							) ta-qabel-aħħar
						) ? 1
					) + 
					((Lista ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					għodd
				)
			)
	).

} × 10.
Ħruġ ikteb: x, linja-ġdida.

