#Linux
>> OS := Programm issettjar: ['OS'].

>> clock := Mument ġdid.
	
(OS = ['Haiku']) veru: {
	clock żona: ['CET'],
	sena: 2017, xahar: 7, jum: 13,
	siegħa: 18, minuta: 0, sekonda: 0.
}, inkella: {
	clock żona: ['Europe/Amsterdam'],
	sena: 2017, xahar: 7, jum: 13,
	siegħa: 18, minuta: 0, sekonda: 0.
}.

clock meta: ['tell'] agħmel: {
	Ħruġ ikteb: innifsu, linja-ġdida.
}.


clock żid: 2    siegħa, tell.
clock żid: 1    siegħa, tell.
clock żid: 19 minuta, tell.
clock żid: 1  minuta, tell.
clock żid: 1  minuta, tell.
clock żid: 19 sekonda, tell.
clock żid: 1  sekonda, tell.
clock żid: 1  sekonda, tell.
clock żid: 2    sena, tell.
clock żid: 1    sena, tell.

(OS = ['Haiku']) veru: {
clock żid: 5   xahar.
clock żona: ['CEST'], tell.
}, inkella: {
	clock żid: 5   xahar, tell.
}.

clock żid: 1   xahar, tell.
clock żid: 19    jum, tell.
clock żid: 1    siegħa, tell.
clock żid: 120  yard, tell.
