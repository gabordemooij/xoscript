Ħruġ ikteb: ['Test object'], linja-ġdida.
>> a := Oġġett ġdid. 

a meta: ['item:'] agħmel: { :fmt
	proprju fmt := fmt. 
}.

a meta: ['item'] agħmel: { <- proprju fmt.
}.

a item: ( Format ġdid: ['|%s|'] ).

Ħruġ ikteb: a item, linja-ġdida.

>> old-fmt-address := a item prototip indirizz-memorja.
a save-as: ['/tmp/a.bin'].
Ħruġ ikteb: ['========== RELOADING SNAP:'], linja-ġdida.

>> b := Oġġett load-from: ['/tmp/a.bin'].

(b item prototip indirizz-memorja = old-fmt-address) veru: {
	Ħruġ ikteb: ['Object link re-attached.'], linja-ġdida.
}.

Ħruġ ikteb: ( b item applika: ['hello'] ), linja-ġdida.
