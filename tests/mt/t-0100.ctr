Test meta: ['html'] agħmel: { <- (
		innifsu
		ibdel: ['&'] bi: ['&amp;'],
		ibdel: ['<'] bi: ['&lt;'],
		ibdel: ['>'] bi: ['&gt;'],
		ibdel: ['"'] bi: ['&quot;']
	).
}.

>> list := Lista ġdid.

['Verbatim Syntax'] karattri kull: { :numru :letter
	list ; ((['<li>#Number:Letter</li>']) Number: (numru), Letter: letter).
}.

Ħruġ list.





>> template := ['
<html>
<body>
<p>Hello this is a test!</p>
<p>The string \‘Verbatim Syntax\’ has: 15 code points...</p>
<ul>
[list]
</ul>
</body> 
</html>
'] [list]: (list għaqqad: ['↵']).

Ħruġ ikteb: template.

