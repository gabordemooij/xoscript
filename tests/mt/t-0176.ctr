

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm ġestjoni-memorja: 0.

>> txt := ['Word Salad'].
Ħruġ ikteb: ['Text Length: '] + txt tul, linja-ġdida.
Ħruġ ikteb: ['Character at 2:'] + ( txt karattru: 2 ), linja-ġdida.
Ħruġ ikteb: (( txt sib: ['S'] ) - 0), linja-ġdida.

Programm naddaf.

usedMemory1 := (Programm memorja ? 0).


txt := ['Word Salad'].
Ħruġ ikteb: ['Text Length: '] + txt tul, linja-ġdida.
Ħruġ ikteb: ['Character at 2:'] + ( txt karattru: 2 ), linja-ġdida.
Ħruġ ikteb: (( txt sib: ['S'] ) - 0), linja-ġdida.

Programm naddaf.
usedMemory2 := (Programm memorja ? 0).


txt := ['Word Salad'].
Ħruġ ikteb: ['Text Length: '] + txt tul, linja-ġdida.
Ħruġ ikteb: ['Character at 2:'] + ( txt karattru: 2 ), linja-ġdida.
Ħruġ ikteb: (( txt sib: ['S'] ) - 0), linja-ġdida.

Programm naddaf.
usedMemory3 := (Programm memorja ? 0).



( usedMemory1 = usedMemory2 u: usedMemory1 = usedMemory3, u: usedMemory2 = usedMemory3 ) veru: {
	Ħruġ ikteb: ['No memory leaks here'].
}, falz: {
	Ħruġ ikteb: ['Leaking memory...'].
}.
