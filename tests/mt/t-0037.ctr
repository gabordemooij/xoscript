>> a := 3.
>> b := a ikkopja.
a naqqas: 1.
Ħruġ ikteb: [' a = '] + a.
Ħruġ ikteb: [' b = '] + b.
a := 3.
b := a + 4.
Ħruġ ikteb: [' a = '] + a.
Ħruġ ikteb: [' b = '] + b.
>> x := 3.
>> y := x ikkopja.
x żid: 10.
y naqqas: 1.
Ħruġ ikteb: [' x = '] + x.
Ħruġ ikteb: [' y = '] + y.
>> q := Oġġett ġdid.
q meta: ['setProperty:'] agħmel: { :x
	proprju prop := x.
}.
q meta: ['getProperty'] agħmel: { <- proprju prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Ħruġ ikteb: [' p = '] + (p getProperty).
