# test number -> string -> number
{

	>> x := Numru bejn: 0 u: 1000000.
	>> d := Numru bejn: 1 u: 7.
	>> e := 10 qawwa: d.

	x aqsam-bi: e.
	>> y := x test numru.

	(x = y) falz: {
		Ħruġ ikteb: x, linja-ġdida.
		Ħruġ ikteb: y, linja-ġdida.
		Programm tmiem.
	}.

} * 1000.
Ħruġ ikteb: ['OK'], linja-ġdida.