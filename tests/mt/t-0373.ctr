# compliance test

# use international numbers

Ħruġ ikteb: ['1000 -> '].
Ħruġ ikteb: 1000, linja-ġdida. #1000

Ħruġ ikteb: ['1.5 -> '].
Ħruġ ikteb: 1.5, linja-ġdida.  #1.5

Ħruġ ikteb: ['1001.5 -> '].
Ħruġ ikteb: 1.5 + 1000, linja-ġdida. #1001.5

# use 0-indexed arrays
>> x := Lista ġdid ; 1 ; 2 ; 3.
>> y := Lista ġdid ; ['a'] ; ['b'] ; ['c'].

Ħruġ ikteb: ['1 -> '].
Ħruġ ikteb: x ? 0, linja-ġdida. #1

Ħruġ ikteb: ['1 -> '].
Ħruġ ikteb: (x fi: 0), linja-ġdida. #1

Ħruġ ikteb: ['1 -> '].
Ħruġ ikteb: x ewwel, linja-ġdida. #1

Ħruġ ikteb: ['3 -> '].
Ħruġ ikteb: x aħħar, linja-ġdida. #3

Ħruġ ikteb: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Ħruġ ikteb: (x skont: y), linja-ġdida.

Ħruġ ikteb: ['1 -> '].
Ħruġ ikteb: (x minn: 0 tul: 1) ewwel, linja-ġdida. #1

Ħruġ ikteb: ['0 -> '].
Ħruġ ikteb: (x sib: 1), linja-ġdida. #0

x poġġi: 9 fi: 0.

Ħruġ ikteb: ['9 -> '].
Ħruġ ikteb: (x fi: 0), linja-ġdida. #9

x żid-fil-bidu: 8.
Ħruġ ikteb: ['8 -> '].
Ħruġ ikteb: (x fi: 0), linja-ġdida. #9


x żid-fit-tmiem: 10.
Ħruġ ikteb: ['10 -> '].
Ħruġ ikteb: (x fi: 4), linja-ġdida. #10








