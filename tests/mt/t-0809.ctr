# backslashes must survive code serialization, strings must not end early
>> valuri := Lista ġdid
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

valuri kull: { :i :value
	>> d := Dizzjunarju ġdid.
	d poġġi: value fi: ['k'].
	>> r := d kodiċi oġġett.
	Ħruġ ikteb: r għodd, linja-ġdida.
	Ħruġ ikteb: ( (r fi: ['k']) = value ), linja-ġdida.
}.
