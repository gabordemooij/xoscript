Test meta: ['html'] agħmel: { <- (
		innifsu
		ibdel: ['&'] bi: ['&amp;'],
		ibdel: ['<'] bi: ['&lt;'],
		ibdel: ['>'] bi: ['&gt;'],
		ibdel: ['''] bi: ['&apos;'],
		ibdel: ['"'] bi: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm ġestjoni-memorja: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Ħruġ ikteb: txt ikkopja html, linja-ġdida.
Ħruġ ikteb: txt ikkopja minuskoli, linja-ġdida.
Ħruġ ikteb: txt ikkopja majuskoli, linja-ġdida.
} ibda.

Programm naddaf.

usedMemory1 := (Programm memorja ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Ħruġ ikteb: txt ikkopja html, linja-ġdida.
Ħruġ ikteb: txt ikkopja minuskoli, linja-ġdida.
Ħruġ ikteb: txt ikkopja majuskoli, linja-ġdida.
} ibda.

Programm naddaf.
usedMemory2 := (Programm memorja ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Ħruġ ikteb: txt ikkopja html, linja-ġdida.
Ħruġ ikteb: txt ikkopja minuskoli, linja-ġdida.
Ħruġ ikteb: txt ikkopja majuskoli, linja-ġdida.
} ibda.

Programm naddaf.
usedMemory3 := (Programm memorja ? 0).



( usedMemory1 = usedMemory2 u: usedMemory1 = usedMemory3, u: usedMemory2 = usedMemory3 ) veru: {
	Ħruġ ikteb: ['No memory leaks here'].
}, falz: {
	Ħruġ ikteb: ['Leaking memory...'].
}.
