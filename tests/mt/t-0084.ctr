>> makeAdder := { :x
	>> f := { :y <- (proprju x + y). } issettja: ['x'] valur: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i proprju q poġġi: (proprju f applika: (proprju q ? i)) fi: i. } 
	issettja: ['q'] valur: array,
	issettja: ['f'] valur: func.
	{ :i mapping applika: i. } × (array għodd).
}.

>> a := Lista ← 1; 2; 3.
mapper applika: a u: (makeAdder applika: 100).
Ħruġ ikteb: (a pożizzjoni: 0), linja-ġdida.
Ħruġ ikteb: (a ? 1), linja-ġdida.
Ħruġ ikteb: (a ? 2), linja-ġdida.
