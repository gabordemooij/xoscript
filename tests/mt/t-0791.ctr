Server init.

>> DB := Maria-DB ġdid host: ['localhost'],
	isem-utent: ['xo'],
	password: ['pass123'],
	isem-database: ['xobase'],
	qabbad.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> parametri-tfittxija := Maria-Mistoqsija ġdid: SQL.

# set database
parametri-tfittxija database: DB.

parametri-tfittxija ġib: { :row
	Ħruġ ikteb: row world, linja-ġdida.
}.
