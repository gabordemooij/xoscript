Numru meta: ['roman'] agħmel: {
	>> numru := innifsu ikkopja.
	>> roman := [''].
	{
		{
			(numru ≥ 1000) veru: {
				roman żid-fit-tmiem: ['Ⅿ'].
				numru naqqas: 1000.
			}, waqqaf.
		
			(numru ≥ 500) veru: {
				roman żid-fit-tmiem: ['Ⅾ'].
				numru naqqas: 500.
			}, waqqaf.
		
			(numru ≥ 100) veru: {
				roman żid-fit-tmiem: ['Ⅽ'].
				numru naqqas: 100.
			}, waqqaf.
		
			(numru ≥ 50) veru: {
				roman żid-fit-tmiem: ['Ⅼ'].
				numru naqqas: 50.
			}, waqqaf.
		
			(numru ≥ 50) veru: {
				roman żid-fit-tmiem: ['Ⅼ'].
				numru naqqas: 50.
			}, waqqaf.
		
			(numru ≥ 10) veru: {
				roman żid-fit-tmiem: ['Ⅹ'].
				numru naqqas: 10.
			}, waqqaf.
			
			(numru ≥ 9) veru: {
				roman żid-fit-tmiem: ['Ⅸ'].
				numru naqqas: 9.
			}, waqqaf.
			
			(numru ≥ 5) veru: {
				roman żid-fit-tmiem: ['Ⅴ'].
				numru naqqas: 5.
			}, waqqaf.
			
			(numru ≥ 4) veru: {
				roman żid-fit-tmiem: ['Ⅳ'].
				numru naqqas: 4.
			}, waqqaf.
			
			(numru ≥ 1) veru: {
				roman żid-fit-tmiem: ['Ⅰ'].
				numru naqqas: 1.
			}, waqqaf.
		} proċedura.
	} sakemm: { <- numru > 0. }. <- roman.
}.

Ħruġ ikteb: 1 roman, linja-ġdida.
Ħruġ ikteb: 2 roman, linja-ġdida.
Ħruġ ikteb: 4 roman, linja-ġdida.
Ħruġ ikteb: 8 roman, linja-ġdida.
Ħruġ ikteb: 16 roman, linja-ġdida.
Ħruġ ikteb: 32 roman, linja-ġdida.
Ħruġ ikteb: 64 roman, linja-ġdida.
Ħruġ ikteb: 128 roman, linja-ġdida.
Ħruġ ikteb: 256 roman, linja-ġdida.
Ħruġ ikteb: 1024 roman, linja-ġdida.
