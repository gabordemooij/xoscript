Numru meta: ['factorial'] agħmel: {
	>> total := 1.
	{ :index total immoltiplika-bi: (innifsu - (index)). } × innifsu. <- total.
}.
>> Printer := Oġġett ġdid.
Printer meta: ['print:and:'] agħmel: { :x :y
	Ħruġ ikteb: ['a='] + x + [', b='] + y, linja-ġdida.
}.
>> a := 4.5. >> b := a arrotonda-isfel.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a arrotonda-fuq.
Printer print: a and: b.
a := 4.5. b := a arrotonda-isfel.
Printer print: a and: b.
a := 4.5. b := a arrotonda.
Printer print: a and: b.
a := 4.2. b := a arrotonda.
Printer print: a and: b.

Ħruġ ikteb: (9 modulo: 5), linja-ġdida.
Ħruġ ikteb: -666 valur-assolut, linja-ġdida.
Ħruġ ikteb: 49 għerq-kwadru, linja-ġdida.
Ħruġ ikteb: (2 qawwa: 3), linja-ġdida.
>> l := (Lista ← 9 ; 6).
Ħruġ ikteb: l minimu.

