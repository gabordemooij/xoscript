Ħruġ ikteb: ['Test object'], linja-ġdida.
>> cmd := Kmand ġdid.
Ħruġ ikteb: cmd ls /tmp, linja-ġdida.
>> old-cmd-address := cmd prototip indirizz-memorja.
cmd save-as: ['/tmp/a.bin'].
Ħruġ ikteb: ['========== RELOADING SNAP:'], linja-ġdida.
>> b := Oġġett load-from: ['/tmp/a.bin'].
(b prototip indirizz-memorja = old-cmd-address) veru: {
	Ħruġ ikteb: ['Object link re-attached.'], linja-ġdida.
}.
Ħruġ ikteb: b ls, linja-ġdida.


