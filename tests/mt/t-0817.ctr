# a value ending in the first part of an opening quote must survive serialization
>> valuri := Lista ġdid
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

valuri kull: { :i :value
	>> d := Dizzjunarju ġdid.
	d poġġi: value fi: ['k'].
	d poġġi: ['second'] fi: ['j'].
	>> r := d kodiċi oġġett.
	Ħruġ ikteb: r għodd, linja-ġdida.
	Ħruġ ikteb: ( (r fi: ['k']) = value ), linja-ġdida.
}.
