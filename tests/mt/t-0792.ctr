Server init.

>> DB := Maria-DB ġdid host: ['localhost'],
	isem-utent: ['xo'],
	password: ['pass123'],
	isem-database: ['xobase'],
	qabbad.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB mistoqsija: SQL.

# now you don't have to set DB
query2 ġib: { :row
	Ħruġ ikteb: row world, linja-ġdida.
}.
