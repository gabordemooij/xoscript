# test url parsing

Server init.
>> url := URL minn-sors: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Ħruġ ikteb: ['scheme = '] + url skema, linja-ġdida.
Ħruġ ikteb: ['host = '] + url host, linja-ġdida.
Ħruġ ikteb: ['port = '] + url port, linja-ġdida.
Ħruġ ikteb: ['path = '] + url mogħdija, linja-ġdida.
Ħruġ ikteb: ['query = '] + url parametri-tfittxija, linja-ġdida.
Ħruġ ikteb: ['fragment = '] + url framment, linja-ġdida.
