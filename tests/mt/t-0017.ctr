Numru meta: ['factorial'] agħmel: {
	>> total := 1.
	{ :index total immoltiplika-bi: (innifsu - (index)). } × innifsu. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Ħruġ ikteb: a.
>> b := 2 + 3 factorial.
Ħruġ ikteb: b.
>> c := 3 factorial + 2.
Ħruġ ikteb: c.
>> d := 2 + (3 factorial).
Ħruġ ikteb: d.
Ħruġ ikteb: 2 + 3 factorial + 1.
