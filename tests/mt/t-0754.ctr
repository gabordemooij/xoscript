Ħruġ ikteb: ['Test object'], linja-ġdida.
>> a := Oġġett ġdid. 

a meta: ['item:'] agħmel: { :out
	proprju out := out. 
}.

a meta: ['item'] agħmel: { <- proprju out.
}.

a meta: ['greet'] agħmel: {
	Ħruġ ikteb: ['hi from original out!'], linja-ġdida.
}.

a item: Ħruġ.

Ħruġ ikteb: a item, linja-ġdida.

>> old-out-address := a item prototip indirizz-memorja.
a save-as: ['/tmp/a.bin'].
Ħruġ ikteb: ['========== RELOADING SNAP:'], linja-ġdida.

>> b := Oġġett load-from: ['/tmp/a.bin'].

(b item prototip indirizz-memorja = old-out-address) veru: {
	Ħruġ ikteb: ['Object link re-attached.'], linja-ġdida.
}.

b item ikteb: ['hello from loaded out!'], linja-ġdida.
b greet.
