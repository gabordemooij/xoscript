>> items := Dizzjunarju ġdid.
items poġġi: ['green'] fi: ['color-1'].
items poġġi: ['orange'] fi: ['color-2'].
items poġġi: ['red'] fi: ['color-3'].
>> i := 0.
>> s := [''].
items kull: { :key :color
	Ħruġ ikteb: ['color #'] + i + [' is: '] + color + [' '].
	i żid: 1.
}.
Ħruġ ikteb: i + [' colors!'].
