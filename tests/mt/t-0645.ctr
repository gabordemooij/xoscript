Server init.
Ħruġ ikteb: ['Database date test'], linja-ġdida.

>> db := Maria-DB ġdid host: ['localhost'],
	isem-utent: ['xo'], 
	password: ['pass123'],
	isem-database: ['xobase'],
	qabbad.

>> parametri-tfittxija :=
db mistoqsija: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
ġib: { :row
	Ħruġ ikteb: row datetest, linja-ġdida.
}.
