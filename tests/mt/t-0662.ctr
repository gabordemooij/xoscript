>> t := Xejn.

# you can control the time zone for
# parsing like this:
Mument żona: ['CET'].
t := Mument minn-sors: ['1981-02-03 04:05:06'].
Ħruġ ikteb: t, linja-ġdida.

# now using CEST time zone:
Mument żona: ['CEST'].
t := Mument minn-sors: ['1981-02-03 04:05:06'].
Ħruġ ikteb: t, linja-ġdida.

# error if string cannot be parsed
{ Mument minn-sors: ['1900']. } aqbad: { Xejn. }, ibda.
