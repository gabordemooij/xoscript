>> map1 := Dizzjunarju ġdid.
>> key1 := Lista ġdid.
>> key2 := Lista ġdid.

map1
	poġġi: ['hello'] fi: key1,
	poġġi: ['world'] fi: key2.


Ħruġ
	ikteb: ['Map #1 contains: '] + (map1 fi: key1),
	ikteb: [' and '] + (map1 fi: key2), linja-ġdida.

>> KeyeableArray := Lista ġdid.
KeyeableArray meta: ['toString'] agħmel: { <- (innifsu għodd) toString.
}.

>> map2 := Dizzjunarju ġdid.
key1 := KeyeableArray ġdid.
key2 := KeyeableArray ġdid.

key1 żid-fit-tmiem: 1.

map2
	poġġi: ['hello'] fi: key1,
	poġġi: ['world'] fi: key2.

Ħruġ
	ikteb: ['Map #2 contains: '] + (map2 fi: key1),
	ikteb: [' and '] + (map2 fi: key2), linja-ġdida.
