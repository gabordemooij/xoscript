Server init.
>> fmt := Format ġdid: ['%#3x'].

>> blob := Blob ġdid: 4.
blob bytes: ( 
	Lista ġdid ; 0 ; 1 ; 2 ; 3
).

>> file := Fajl ġdid: ['/tmp/blob'].
file blob: blob.
blob eħles.

>> aqra := file blob.
aqra 
minn: 0 
tul: 4, 
agħmel kull: { :i :b 
	Ħruġ
	ikteb: (fmt applika-sħiħ: b),
	linja-ġdida.
}.
aqra eħles.
