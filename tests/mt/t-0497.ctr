Server init.

# write a test file
>> f := Fajl ġdid: ['/tmp/test.gif'].
f ikteb: ['GIF87a01234567810'].

# serve the file
Server għaddi: ['test.gif'] prefiss: ['/tmp/'].

Ħruġ linja-ġdida.

Ħruġ ikteb: ['Outside container (security):'], linja-ġdida.
{ Server għaddi: ['../passwd'] prefiss: ['/tmp/']. }
aqbad: { :e Ħruġ ikteb: e, linja-ġdida. },
ibda.

Ħruġ ikteb: ['Invalid prefix:'], linja-ġdida.
{ Server għaddi: ['test.gif'] prefiss: ['z:\\']. }
aqbad: { :e Ħruġ ikteb: e, linja-ġdida. },
ibda.

Ħruġ ikteb: ['Non-existant file:'], linja-ġdida.
{ Server għaddi: ['xxx.xxx'] prefiss: ['/tmp/']. }
aqbad: { :e Ħruġ ikteb: e, linja-ġdida. },
ibda.
