



>> CoffeeGrounds := Oġġett ġdid.
CoffeeGrounds meta: ['extract'] agħmel: { <- ['coffee']. }.

>> CoffeeMachine := Oġġett ġdid.
CoffeeMachine meta: ['init'] agħmel: {
	proprju coffeegrounds := CoffeeGrounds ġdid.
}.
CoffeeMachine meta: ['ġdid'] agħmel: { <- CoffeeMachine `new init.
}.

CoffeeMachine meta: ['makeTea'] agħmel: { <- (proprju tealeaves extract). }.
CoffeeMachine meta: ['makeCoffee'] agħmel: { <- (proprju coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine ġdid.

Ħruġ ikteb:
	coffeeDream 
	makeCoffee.

Ħruġ ikteb:
	coffeeDream 
	makeTea.
