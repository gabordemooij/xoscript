Server init.
Ħruġ ikteb: ['Database time test'], linja-ġdida.

>> db := Maria-DB ġdid host: ['localhost'],
	isem-utent: ['xo'], 
	password: ['pass123'],
	isem-database: ['xobase'],
	qabbad.

>> parametri-tfittxija :=
db mistoqsija: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
ġib: { :row
	Ħruġ ikteb: row timetest, linja-ġdida.
}.
