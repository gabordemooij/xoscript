#Linux
>> Slurp := Oġġett ġdid.

Slurp meta: ['ġdid'] agħmel: {
	proprju str := [''].
}.

Slurp meta: ['nieuw'] agħmel: {
	proprju str := [''].
}.

Slurp meta: ['wieġeb:'] agħmel: { :blah
		proprju str żid-fit-tmiem: blah.
}.

Slurp meta: ['wieġeb:u:'] agħmel: { :blah :blahah
		proprju str żid-fit-tmiem: (blah minn: 0 tul: (blah tul - 1)).
		proprju str żid-fit-tmiem: [' '].
		proprju str żid-fit-tmiem: blahah.
}.

Slurp meta: ['obtain'] agħmel: {
	>> buffer := proprju str.
	proprju str := ['']. <- buffer.
}.


Ħruġ ikteb: (Programm sistema: (Slurp ġdid echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Fajl ġdid: ['/tmp/from.txt'], ħassar. } aqbad: { ['Empty']. }, ibda.
{ Fajl ġdid: ['/tmp/to.txt'], ħassar. } aqbad: { ['Empty']. }, ibda.


Fajl ġdid: ['/tmp/to.txt'], jeżisti falz: {
	Ħruġ ikteb: ['Confirmed. Target file does not exist.\
'].
}.
Fajl ġdid: ['/tmp/from.txt'], jeżisti falz: {
	Ħruġ ikteb: ['Confirmed. Source file does not exist.\
'].
}.



Programm sistema: (Slurp ġdid touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Programm sistema: (Slurp ġdid cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Fajl ġdid: ['/tmp/to.txt'], jeżisti veru: {
	Ħruġ ikteb: ['Confirmed. Target file has been created by shell.\
'].
}.


Ħruġ ikteb: ['Contents of file is:'] + (Fajl ġdid: ['/tmp/to.txt'], aqra), linja-ġdida.
