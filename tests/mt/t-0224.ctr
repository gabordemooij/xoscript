
>> countries := Lista ġdid
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Lista ġdid
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods skont: countries, kull: { :key :value
	counter żid: 1.
}.

Ħruġ ikteb: (['we serve counter dishes'] counter: counter), linja-ġdida.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] karattri issortja: { :v
	counter żid: 0.
}.

Ħruġ ikteb: (['we sort counter dishes'] counter: counter), linja-ġdida.


>> counter := 0.
{
	{
		counter żid: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Ħruġ ikteb: (['we calculate counter numbers.'] counter: counter), linja-ġdida.

