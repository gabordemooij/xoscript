# test Program version

# this feature is disabled by default
Ħruġ ikteb: (
	Programm karatteristika: 
	['RECURSIVE_STRINTPOL']
), linja-ġdida.


# but if we set the time back
>> today := Mument 
żona: ['CEST'],
minn-sors: ['2026-02-15 10:00:00'].
Programm verżjoni: today.

# it will be enabled like it used to be (from now on)
Ħruġ ikteb: (
	Programm karatteristika: 
	['RECURSIVE_STRINTPOL']
), linja-ġdida.