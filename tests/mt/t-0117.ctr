>> t := Veru.
(t = Veru) veru: { Ħruġ ikteb: ['T']. }.
(t = Falz) veru: { Ħruġ ikteb: ['F']. }.
Ħruġ ikteb: ['|'].
>> t := Falz.
(t = Veru) veru: { Ħruġ ikteb: ['T']. }.
(t = Falz) veru: { Ħruġ ikteb: ['F']. }.
Ħruġ ikteb: ['|'].
>> f := Veru.
(t = Veru u: f = Falz) veru: { Ħruġ ikteb: ['T']. }.
(t = Falz u: f = Veru) veru: { Ħruġ ikteb: ['F']. }.
Ħruġ ikteb: ['|'].
>> n := Xejn.
(n Xejn?) veru: { Ħruġ ikteb: ['T']. }.
(n Xejn?) falz: { Ħruġ ikteb: ['F']. }.
Ħruġ ikteb: ['|'].
(f Boolean?) veru: { Ħruġ ikteb: ['T']. }.
(f Boolean?) falz: { Ħruġ ikteb: ['F']. }.



