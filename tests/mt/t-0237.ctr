
Test meta: ['evaluate'] agħmel: {
	>> kodiċi := Fajl ġdid: ['/tmp/eval.ctr'].
	kodiċi ikteb: (innifsu test + ['.']).
	Programm uża: ['/tmp/eval.ctr'].
}.

>> map :=
	(Dizzjunarju ġdid)
	poġġi: ['Hi There'] fi: ['two'],
	poġġi: (Lista ← ['hello'] ; ['world'] ; (Lista ← 1 ; 2; 9) ; Falz) fi: ['one'],
	poġġi: ( (Dizzjunarju ġdid) poġġi: ['wrrld'] fi: ['misspelled'] ) fi: ['three'],
	poġġi: (Lista ← ((Dizzjunarju ġdid) poġġi: ['treasure'] fi: ['hidden']) ; 2) fi: ['four']. 
>> str := map test.
>> map2 := Xejn.
(['map2 := '] + str ) evaluate.
Ħruġ ikteb: map2 ? ['one'] ? 0.
Ħruġ ikteb: map2 ? ['one'] ? 1.
Ħruġ ikteb: map2 ? ['four'] ? 0 ? ['hidden'].
Ħruġ ikteb: map2 ? ['one'] ? 2 ? 2.
