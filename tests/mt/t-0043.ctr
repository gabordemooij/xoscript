>> repeater := Oġġett ġdid.
repeater meta: ['wieġeb:'] agħmel: { :what
	Ħruġ ikteb: what + [' '].
}.
repeater meta: ['wieġeb:u:'] agħmel: { :what :say
	Ħruġ ikteb: what, ikteb: say + [' '].
}.
repeater meta: ['wieġeb:u:u:'] agħmel: { :what :say :more
	Ħruġ ikteb: what, ikteb: say, ikteb: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
