
Numru tgħallem: ['plus:'] tfisser: ['+'].
Numru meta: ['+'] agħmel: { :x
	>> rate := 1.
	>> currency := x kwalifikazzjoni.
	(currency = ['euros']) veru: {
		rate := 2.
	}. <- (innifsu plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars ikkwalifika: ['dollars'].
euros ikkwalifika: ['euros'].
>> money := dollars + euros.
Ħruġ ikteb: money, linja-ġdida.
