

Test meta: ['html'] agħmel: { <- (
		innifsu
		ibdel: ['&'] bi: ['&amp;'],
		ibdel: ['<'] bi: ['&lt;'],
		ibdel: ['>'] bi: ['&gt;'],
		ibdel: ['"'] bi: ['&quot;']
	).
}.


Ħruġ ikteb: ([' left trimmed '] aqta-spazji) + [' '] + ( ['and right trimmed'] aqta-spazji) + ['!'], linja-ġdida.
Ħruġ ikteb: ['<html>"html & entities"</html>'] html.
