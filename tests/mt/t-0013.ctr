
>> Animal := Oġġett ġdid.
Animal meta: ['ġdid'] agħmel: { <- innifsu ġdid init.
}.

Animal meta: ['init'] agħmel: {
	proprju sound := ['?'].
	proprju legs := 4.
}.

>> Dog := Animal ġdid.
Dog meta: ['init'] agħmel: {
	innifsu init.
	proprju sound := ['barks'].
}.

Animal meta: ['test'] agħmel: { <- proprju legs test + proprju sound.
}.

>> poodle := Dog ġdid.
Ħruġ ikteb: poodle, linja-ġdida.

