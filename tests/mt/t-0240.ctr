# test qualifiers

>> $ := Oġġett ġdid.

$ meta: ['wieġeb:'] agħmel: { :x
	
	>> operation := x karattru: 0.
	>> valuta := x karattru: 1.
	>> money := x spostament: 2.
	
	>> amount := 0.

	( operation = ['+'] ) veru: {
		( valuta = ['£'] ) veru: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Ħruġ ikteb: x, linja-ġdida.


>> Fruit := Oġġett ġdid.

Fruit meta: ['ġdid'] agħmel: {
	>> f := innifsu ġdid.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit meta: ['apples:'] agħmel: { :a proprju apples := a. }.
Fruit meta: ['oranges:'] agħmel: { :p proprju oranges := p. }.
Fruit meta: ['apples'] agħmel: { <- proprju apples. }.
Fruit meta: ['oranges'] agħmel: { <- proprju oranges. }.

Fruit meta: ['+'] agħmel: { :f
	
	>> n := Fruit ġdid.
	f żid: 1.
	
	n apples: (f apples + proprju apples).
	n oranges:  (f oranges  + proprju oranges). <- n.
}.

Fruit meta: ['test'] agħmel: { <- ( proprju apples test + [' apples and '] + proprju oranges + [' oranges'] ).
}.

Numru meta: ['apples'] agħmel: { <- ((Fruit ġdid) apples: innifsu).
}.

Numru meta: ['apple'] agħmel: { <- ((Fruit ġdid) apples: innifsu).
}.

Numru meta: ['oranges'] agħmel: { <- ((Fruit ġdid) oranges: innifsu).
}.




Ħruġ ikteb: (1 apple + 3 oranges + 4 apples), linja-ġdida.


Test meta: ['twice'] agħmel: { <- ((innifsu test) + (innifsu test)).
}.



Ħruġ ikteb: ['❤❤❤'] twice.



