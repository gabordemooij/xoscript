>> str := ['write:'].
Ħruġ messaġġ: ['ikteb:'] argumenti: (Lista ← ['Hello World']), linja-ġdida. 

Numru meta: ['isbetween:and:'] agħmel: { :a :b <- ((innifsu ≥ a) u: (innifsu ≤ b)).
}.

str := ['isbetween:and:'].
Ħruġ ikteb: (3 messaġġ: str argumenti: (Lista ← 2 ; 8)), linja-ġdida.
Ħruġ ikteb: (3 messaġġ: str argumenti: (Lista ← 1 ; 2)), linja-ġdida.


>> CoffeeMachine := Oġġett ġdid.
CoffeeMachine meta: ['makeCoffeeWithSugar:milk:'] agħmel: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Lista ← 4 ; 2.
Ħruġ ikteb: ( CoffeeMachine messaġġ: order argumenti: coffeeConfiguration ), linja-ġdida.
