>> q := Lista ← 1 ; 2 ; 3.
{ q ? ['1']. } aqbad: { Ħruġ ikteb: ['caught!'], linja-ġdida. }, ibda.
{ q ? Veru. } aqbad: { Ħruġ ikteb: ['caught!'], linja-ġdida. }, ibda.
{ q ? Falz. } aqbad: { Ħruġ ikteb: ['caught!'], linja-ġdida. }, ibda.
{ q ? Xejn. } aqbad: { Ħruġ ikteb: ['caught!'], linja-ġdida. }, ibda.
{ q ? (Lista ġdid). } aqbad: { Ħruġ ikteb: ['caught!'], linja-ġdida. }, ibda.
{ q ? (Oġġett ġdid). } aqbad: { Ħruġ ikteb: ['caught!'], linja-ġdida. }, ibda.
{ q ? ({ ['Empty']. }). } aqbad: { Ħruġ ikteb: ['caught!'], linja-ġdida. }, ibda.
Ħruġ ikteb: ['caught them all'], linja-ġdida.
