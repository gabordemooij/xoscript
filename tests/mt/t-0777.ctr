#OBSD
>> dirname := [''].
{ dirname żid-fit-tmiem: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Programm sistema: command.
Programm chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename żid-fit-tmiem: ['YYYYYYYY']. } * 20.
Fajl ġdid: filename, ikteb: ['sometext'].
{ Fajl lista: ['/tmp/'] + dirname. } * 1000.
Ħruġ ikteb: ['no crash'], linja-ġdida.

