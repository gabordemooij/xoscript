# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Kaxxaforti 
	hash-password: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Kaxxaforti 
	hash-password: hash ivverifika: a1.
	# fail 
>> b := Kaxxaforti
	hash-password: hash ivverifika: a2.
	# ok!

Ħruġ ikteb: a, linja-ġdida.
Ħruġ ikteb: b, linja-ġdida.

