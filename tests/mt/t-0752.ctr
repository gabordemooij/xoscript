Ħruġ ikteb: ['Test object'], linja-ġdida.
>> a := Oġġett ġdid. 

a meta: ['item:'] agħmel: { :boolean
	proprju boolean := boolean. 
}.

a meta: ['item'] agħmel: { <- proprju boolean.
}.

a item: Boolean.

Ħruġ ikteb: a item, linja-ġdida.

>> old-bool-address := a item prototip indirizz-memorja.
a save-as: ['/tmp/a.bin'].
Ħruġ ikteb: ['========== RELOADING SNAP:'], linja-ġdida.

>> b := Oġġett load-from: ['/tmp/a.bin'].

(b item prototip indirizz-memorja = old-bool-address) veru: {
	Ħruġ ikteb: ['Object link re-attached.'], linja-ġdida.
}.

Ħruġ ikteb: b item, linja-ġdida.
