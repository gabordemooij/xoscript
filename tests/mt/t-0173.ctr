

Lista meta: ['sum'] agħmel: {
	>> total := 0.
	innifsu kull: { :index :element
		total żid: element.
	}. <- total.
}.

Lista meta: ['product'] agħmel: {
	>> total := 1.
	innifsu kull: { :index :element
		total immoltiplika-bi: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm ġestjoni-memorja: 0.

{

>> a := Lista ← ['hello'] ; ['world'] ; Veru ; Xejn ; 666.
a := a + ( Lista ← 1 ).
Ħruġ ikteb: ( ['sum: '] + ( a sum ) ), linja-ġdida.
Ħruġ ikteb: ( ['min: '] + ( a minimu ) ), linja-ġdida.
Ħruġ ikteb: ( ['max: '] + ( a massimu ) ), linja-ġdida.
Ħruġ ikteb: ( ['3rd: '] + ( a ? 2 ) ), linja-ġdida.
Ħruġ ikteb: ( ['prd: '] + ( a product ) ), linja-ġdida.
a issortja: { :a :b <- (b - a). }.
a kull: { :i :e Ħruġ ikteb: ( i - 0 ), linja-ġdida. }.

} ibda.

Programm naddaf.
usedMemory1 := (Programm memorja ? 0).


{

>> a := Lista ← ['hello'] ; ['world'] ; Veru ; Xejn ; 666.
a := a + ( Lista ← 1 ).
Ħruġ ikteb: ( ['sum: '] + ( a sum ) ), linja-ġdida.
Ħruġ ikteb: ( ['min: '] + ( a minimu ) ), linja-ġdida.
Ħruġ ikteb: ( ['max: '] + ( a massimu ) ), linja-ġdida.
Ħruġ ikteb: ( ['3rd: '] + ( a ? 2 ) ), linja-ġdida.
Ħruġ ikteb: ( ['prd: '] + ( a product ) ), linja-ġdida.
a issortja: { :a :b <- (b - a). }.
a kull: { :i :e Ħruġ ikteb: ( i - 0 ), linja-ġdida. }.

} ibda.



Programm naddaf.
usedMemory2 := (Programm memorja ? 0).


{

>> a := Lista ← ['hello'] ; ['world'] ; Veru ; Xejn ; 666.
a := a + ( Lista ← 1 ).
Ħruġ ikteb: ( ['sum: '] + ( a sum ) ), linja-ġdida.
Ħruġ ikteb: ( ['min: '] + ( a minimu ) ), linja-ġdida.
Ħruġ ikteb: ( ['max: '] + ( a massimu ) ), linja-ġdida.
Ħruġ ikteb: ( ['3rd: '] + ( a ? 2 ) ), linja-ġdida.
Ħruġ ikteb: ( ['prd: '] + ( a product ) ), linja-ġdida.
a issortja: { :a :b <- (b - a). }.
a kull: { :i :e Ħruġ ikteb: ( i - 0 ), linja-ġdida. }.

} ibda.



Programm naddaf.
usedMemory3 := (Programm memorja ? 0).

( usedMemory1 = usedMemory2 u: usedMemory1 = usedMemory3, u: usedMemory2 = usedMemory3 ) veru: {
	Ħruġ ikteb: ['No memory leaks here'].
}, falz: {
	Ħruġ ikteb: ['Leaking memory...'].
}.
