Server init.

>> DB := Maria-DB ġdid host: ['localhost'],
	isem-utent: ['xo'],
	password: ['pass123'],
	isem-database: ['xobase'],
	qabbad.

{
	DB mistoqsija:
	['DROP TABLE movies'],
	esegwixxi.
} aqbad: { Xejn. }, ibda.

DB mistoqsija:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
esegwixxi.

DB mistoqsija: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parametri: ( Lista ġdid ; ['Halloween'] ),
esegwixxi.

DB mistoqsija: ['SELECT * FROM movies'],
ġib: { :movie
	Ħruġ ikteb: movie title, linja-ġdida.
}.

