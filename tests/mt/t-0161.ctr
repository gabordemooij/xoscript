Programm ġestjoni-memorja: 0.
Lista meta: ['sum'] agħmel: {
	>> total := 0.
	innifsu kull: { :index :element
		total żid: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Fajl ġdid: ['/tmp/test.txt'].
f ikteb: ['Lorem Ipsum'].
f agħlaq.
  

f := Fajl ġdid: ['/tmp/test.txt'].
>> text := f aqra.
f agħlaq.



Programm naddaf.
usedMemory1 := (Programm memorja ? 1).



f := Fajl ġdid: ['/tmp/test.txt'].
text := f aqra.
f agħlaq.

Programm naddaf.
usedMemory2 := (Programm memorja ? 1).


f := Fajl ġdid: ['/tmp/test.txt'].
text := f aqra.
f agħlaq.

Programm naddaf.
usedMemory3 := (Programm memorja ? 1).



( usedMemory1 = usedMemory2 u: usedMemory1 = usedMemory3, u: usedMemory2 = usedMemory3 ) veru: {
	Ħruġ ikteb: ['No memory leaks here'].
}, falz: {
	Ħruġ ikteb: ['Leaking memory...'].
}.
