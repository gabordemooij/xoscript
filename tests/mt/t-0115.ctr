{
	dan-il-kompitu żball: ['Dont fail.'].
	unknown doSomething.
} aqbad: {
	Ħruġ ikteb: ['Caught!'].
}, ibda.

{
	dan-il-kompitu żball: ['Dont fail.'].
	proprju unknown doSomething.
} aqbad: {
	Ħruġ ikteb: ['Caught!'].
}, ibda.

{
	dan-il-kompitu żball: ['Dont fail.'].
	unknown := 122.
} aqbad: {
	Ħruġ ikteb: ['Caught!'].
}, ibda.


{
	dan-il-kompitu żball: ['Dont fail.'].
	Veru waqqaf.
	Ħruġ ikteb: ['FAIL'].
} aqbad: {
	Ħruġ ikteb: ['Caught!'].
}, ibda.

{
	{
		dan-il-kompitu żball: ['Dont fail.'].
		Veru waqqaf.
		Ħruġ ikteb: ['FAIL'].
	} aqbad: { :x
		(x = ['Dont fail.']) veru: { dan-il-kompitu żball: ['Nested Caught!']. }.
	}, ibda.
} aqbad: { :e
	Ħruġ ikteb: e.
}, ibda.
