Ħruġ ikteb: ['Test object'], linja-ġdida.
>> a := Oġġett ġdid. 

a meta: ['item:'] agħmel: { :moment
	proprju moment := moment. 
}.

a meta: ['item'] agħmel: { <- proprju moment.
}.

>> today := Lista ġdid ; ( Mument ġdid żona: ['CEST'], sena: 2026, xahar: 7 ).
a item: today.
Ħruġ ikteb: a item ? 0, linja-ġdida.
a save-as: ['/tmp/a.bin'].
