Server init.
>> f := Format ġdid: ['%d'].
>> a := Blob ġdid: 4.
a bytes: ( Lista ġdid ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob ġdid: 4.
b bytes: ( Lista ġdid ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a minn: 0 tul: 3, kull: { :i :byte
	Ħruġ ikteb: ( f applika-sħiħ: byte ), linja-ġdida.
}.
a ^ b.
a minn: 0 tul: 3, kull: { :i :byte
	Ħruġ ikteb: ( f applika-sħiħ: byte ), linja-ġdida.
}.
a ^ b.
a minn: 0 tul: 3, kull: { :i :byte
	Ħruġ ikteb: ( f applika-sħiħ: byte ), linja-ġdida.
}.
a eħles.
b eħles.

{ a ^ Oġġett. } aqbad: { :e Ħruġ ikteb: e, linja-ġdida. }, ibda.
