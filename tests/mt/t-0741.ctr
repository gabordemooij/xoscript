Ħruġ ikteb: ['Test object'], linja-ġdida.
>> a := Oġġett ġdid. 

a meta: ['item:'] agħmel: { :octhelper
	proprju octhelper := octhelper. 
}.

a meta: ['item'] agħmel: { <- proprju octhelper.
}.

a item: Oct ġdid.

>> old-octhelper-address := a item prototip indirizz-memorja.
a save-as: ['/tmp/a.bin'].
Ħruġ ikteb: ['========== RELOADING SNAP:'], linja-ġdida.

>> b := Oġġett load-from: ['/tmp/a.bin'].

(b item prototip indirizz-memorja = old-octhelper-address) veru: {
	Ħruġ ikteb: ['Object link re-attached.'], linja-ġdida.
}.
