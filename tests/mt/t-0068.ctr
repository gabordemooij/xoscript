>> w := ['A_bottle_of_Whisky and a rare steak.'].
Ħruġ ikteb: ['=== Basic test, grab the bottle! ==='], linja-ġdida.
Ħruġ ikteb: ['>']+(w ikkopja minn:2 tul: 6), linja-ġdida.
Ħruġ ikteb: ['>']+(w ikkopja minn:8 tul: -6), linja-ġdida.
Ħruġ ikteb: ['>']+(w ikkopja minn:2 tul: 6), linja-ġdida.
Ħruġ ikteb: ['>']+(w ikkopja minn:8 tul: -6), linja-ġdida.
Ħruġ ikteb: ['=== Take a single char ==='], linja-ġdida.
Ħruġ ikteb: ['>']+(w ikkopja minn:7 tul: 1), linja-ġdida.
Ħruġ ikteb: ['>']+(w ikkopja minn:7 tul: 1), linja-ġdida.
Ħruġ ikteb: ['=== The 0 case, empty string ==='], linja-ġdida.
Ħruġ ikteb: ['>']+(w ikkopja minn:7 tul: 0), linja-ġdida.
Ħruġ ikteb: ['>']+(w ikkopja minn:7 tul: 0), linja-ġdida.
Ħruġ ikteb: ['=== Edge case, first character only ==='], linja-ġdida.
Ħruġ ikteb: ['>']+(w ikkopja minn:0 tul: 1), linja-ġdida.
Ħruġ ikteb: ['>']+(w ikkopja minn:0 tul: 1), linja-ġdida.
Ħruġ ikteb: ['>']+(w ikkopja minn:1 tul: -1), linja-ġdida.
Ħruġ ikteb: ['>']+(w ikkopja minn:1 tul: -1), linja-ġdida.
Ħruġ ikteb: ['=== Edge case, last character only ==='], linja-ġdida.
Ħruġ ikteb: ['>']+(w ikkopja minn:35 tul: 1), linja-ġdida.
Ħruġ ikteb: ['>']+(w ikkopja minn:35 tul: 1), linja-ġdida.
Ħruġ ikteb: ['>']+(w ikkopja minn:36 tul: -1), linja-ġdida.
Ħruġ ikteb: ['>']+(w ikkopja minn:36 tul: -1), linja-ġdida.
Ħruġ ikteb: ['=== Out of bounds, empty string ==='], linja-ġdida.
Ħruġ ikteb: ['>']+(w ikkopja minn:36 tul: 37), linja-ġdida.
Ħruġ ikteb: ['>']+(w ikkopja minn:36 tul: 47), linja-ġdida.
Ħruġ ikteb: ['>']+(w ikkopja minn:-1 tul: -2), linja-ġdida.
Ħruġ ikteb: ['>']+(w ikkopja minn:-2 tul: -1), linja-ġdida.
Ħruġ ikteb: ['=== Part out of bounds, full string ==='], linja-ġdida.
Ħruġ ikteb: ['>']+(w ikkopja minn:-20 tul: 90), linja-ġdida.
Ħruġ ikteb: ['>']+(w ikkopja minn:90 tul: -20), linja-ġdida.
Ħruġ ikteb: ['>']+(w ikkopja minn:-20 tul: 90), linja-ġdida.
Ħruġ ikteb: ['>']+(w ikkopja minn:90 tul: -120), linja-ġdida.
