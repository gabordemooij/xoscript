>> HTML := Oġġett ġdid.
HTML meta: ['wieġeb:'] agħmel: { :tag 
	Ħruġ ikteb: (['<tag>'] tag: tag), linja-ġdida.
}.
HTML meta: ['wieġeb:u:'] agħmel: { :tag :html 
	Ħruġ ikteb: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), linja-ġdida.
}.
>> html := HTML ġdid.
html body h1: ['header'].

