
>> Rectangle := Oġġett ġdid.

Rectangle meta: ['area'] agħmel: { <- proprju tul * proprju width.
}.

Rectangle meta: ['length:'] agħmel: { :tul
	proprju tul := tul.
}.

Rectangle meta: ['width:'] agħmel: { :width
	proprju width := width.
}.

Rectangle meta: ['ġdid'] agħmel: {
	# this will not result into an infinite loop
	>> rectangle := innifsu ġdid.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle ġdid.
Ħruġ ikteb: a area, linja-ġdida. #0

>> b := Rectangle ġdid length: 2, width: 3.
Ħruġ ikteb: b area, linja-ġdida. #6

