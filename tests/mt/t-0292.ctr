>> winery := { <- (	Dizzjunarju ġdid
		poġġi: 2 fi: ['merlot'],
		poġġi: 3 fi: ['malbec'],
		poġġi: 4 fi: ['syrah']
	).
}.

Ħruġ ikteb: (((winery ibda) - ['nothing']) għodd), linja-ġdida.
Ħruġ ikteb: (((winery ibda) - ['merlot']) għodd), linja-ġdida.
Ħruġ ikteb: (((winery ibda) - ['malbec']) għodd), linja-ġdida.
Ħruġ ikteb: (((winery ibda) - ['syrah']) għodd), linja-ġdida.
Ħruġ ikteb: (((winery ibda) - ['merlot'] - ['malbec']) għodd), linja-ġdida.
Ħruġ ikteb: (((winery ibda) - ['merlot'] - ['syrah']) għodd), linja-ġdida.
Ħruġ ikteb: (((winery ibda) - ['malbec'] -['syrah']) għodd), linja-ġdida.
Ħruġ ikteb: (((winery ibda) - ['malbec'] - ['syrah'] - ['merlot']) għodd), linja-ġdida.

