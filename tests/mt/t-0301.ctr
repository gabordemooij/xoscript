


>> wine := Oġġett ġdid.


wine meta: ['toString'] agħmel: { <- ['merlot'].
}.

wine meta: ['naarTekst'] agħmel: { <- ['merlot'].
}.


wine meta: ['='] agħmel: { :other wine <- ( innifsu toString = other wine ).
}.

wine meta: ['=='] agħmel: { :other wine <- ( innifsu toString = other wine ).
}.



wine
	każ: ['cabernet'] agħmel: { Ħruġ ikteb: ['it's a Cabernet!']. },
	każ: ['syrah']    agħmel: { Ħruġ ikteb: ['it's a Syrah!'].    },
	każ: ['merlot']   agħmel: { Ħruġ ikteb: ['it's a Merlot!'].   },
	każ: ['malbec']   agħmel: { Ħruġ ikteb: ['it's a Malbec!'].   }.

Ħruġ linja-ġdida.
