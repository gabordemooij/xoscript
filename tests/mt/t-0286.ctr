['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Ħruġ ikteb: (x + y), linja-ġdida.

>> x := 10040.07.
>> y := 10305.60.

Ħruġ ikteb: (x + y), linja-ġdida.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Ħruġ ikteb: (x + y + z), linja-ġdida.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Ħruġ ikteb: (x + y + z), linja-ġdida.

>> q := 0.1.2.

Ħruġ ikteb: (q), linja-ġdida.

>> q := 012.

Ħruġ ikteb: (q), linja-ġdida.
