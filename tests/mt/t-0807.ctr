# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB ġdid host: ['localhost'],
	isem-utent: ['xo'],
	password: ['pass123'],
	isem-database: ['xobase'],
	qabbad.

>> parametri-tfittxija := db mistoqsija: ['SELECT %% FROM'].
{ parametri-tfittxija esegwixxi. } aqbad: { :e
	Ħruġ ikteb: ( e fih: ['%%'] ), linja-ġdida.
}, ibda.
