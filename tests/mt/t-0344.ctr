# catch-all test (practical)
>> HTML := Test ġdid.
HTML meta: ['encode:'] agħmel: { :tekst
	innifsu żid-fit-tmiem: (tekst
	ibdel: ['&'] bi: ['&amp;'], 
	ibdel: ['<'] bi: ['&lt;'],
	ibdel: ['>'] bi: ['&gt;'],
	ibdel: ['"'] bi: ['&quot;']).
}.
>> blog := HTML ġdid.
blog żid-fit-tmiem: ['<h1>'],
     encode: ['Koffie & Thee'],
     żid-fit-tmiem: ['</h1>'].
Ħruġ ikteb: blog, linja-ġdida.


>> Roman := Numru ġdid.
Roman meta: ['stringy'] agħmel: {
	>> a := [''].
	{ a żid-fit-tmiem: ['I']. } × innifsu. <- a.
}.

>> x := Roman ġdid.
x żid: 3.
Ħruġ ikteb: x stringy, linja-ġdida.

>> Quantum := Boolean ġdid.
Quantum meta: ['true?'] agħmel: { <- ['maybe True']. }.
Ħruġ ikteb: (Quantum ġdid true?), linja-ġdida.

>> Nihil := Xejn ġdid.
Nihil meta: ['test'] agħmel: { <- ['Nihil']. }.
Ħruġ ikteb: (Nihil ġdid), linja-ġdida.
