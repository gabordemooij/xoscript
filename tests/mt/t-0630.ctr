#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Mudell ġdid: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern taqbila: subject agħmel: { :m :x
	Ħruġ ikteb: m, linja-ġdida.
	Ħruġ ikteb: x, linja-ġdida. <- ['XXX'].
}.
Ħruġ ikteb: result, linja-ġdida.