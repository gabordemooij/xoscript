>> items := Dizzjunarju ġdid.
items poġġi: ['black'] fi: ['coffee'], poġġi: ['earl grey'] fi: ['tea'].
Ħruġ ikteb: (items fi: ['coffee']), ikteb: (items fi: ['tea']).
Ħruġ ikteb: ['there are'] + items għodd + [' items in the array.'].
items poġġi: ['capuccino'] fi: ['coffee'].
Ħruġ ikteb: ['Now my coffee is.. '] + (items fi: ['coffee']).
items poġġi: ['aaa'] fi: ['1'].
items poġġi: ['bbb'] fi: ['2'].
Ħruġ ikteb: (items fi: ['a']).
