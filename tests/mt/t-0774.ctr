Ħruġ ikteb: ['Test object'], linja-ġdida.
>> a := Oġġett ġdid. 
a meta: ['item:'] agħmel: { :lst
	proprju lst := lst. 
}.
a meta: ['item'] agħmel: { <- proprju lst.
}.
a item: (
	Lista ġdid ; 1 ; (
		Lista ġdid ; ['a'] ; (
			Lista ġdid ; ( Mument ġdid: 1 )
		) ; ( Int64 minn-test: ['321'] )
	)
).
Ħruġ ikteb: a item, linja-ġdida.
>> old-lst-address := a item prototip indirizz-memorja.
a save-as: ['/tmp/a.bin'].
Ħruġ ikteb: ['========== RELOADING SNAP:'], linja-ġdida.
>> b := Oġġett load-from: ['/tmp/a.bin'].
(b item prototip indirizz-memorja = old-lst-address) veru: {
	Ħruġ ikteb: ['Object link re-attached.'], linja-ġdida.
}.
Ħruġ ikteb: ( b item ), linja-ġdida.
