# recursive interpolation not allowed

Ħruġ ikteb: 
['recursive string interolation enabled: '] + (
	Programm karatteristika: 
	['RECURSIVE_STRINTPOL']
), linja-ġdida.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Ħruġ ikteb: a, linja-ġdida.


Programm karatteristika: ['RECURSIVE_STRINTPOL'] attiva: Veru.

Ħruġ ikteb: 
['recursive string interpolation enabled: '] + (
	Programm karatteristika: 
	['RECURSIVE_STRINTPOL']
), linja-ġdida.

>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

