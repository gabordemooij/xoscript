>> Point := Oġġett ġdid.
Point meta: ['x-coordinate:'] agħmel: { :x proprju x := x. }.
Point meta: ['y-coordinate:'] agħmel: { :y proprju y := y. }.
Point meta: ['x-coordinate']  agħmel: { <- proprju x ikkopja. }.
Point meta: ['y-coordinate']  agħmel: { <- proprju y ikkopja. }.

Point meta: ['='] agħmel: { :other <- ( proprju x = other x-coordinate
		 u: proprju y = other y-coordinate ).
}.

>> pier := Point ġdid x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point ġdid x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point ġdid x-coordinate: 5, y-coordinate: 6.

Ħruġ ikteb: pier = town-hall, linja-ġdida.
Ħruġ ikteb: pier = restaurant, linja-ġdida.
