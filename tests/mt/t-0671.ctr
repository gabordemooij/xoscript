# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Kaxxaforti iġġenera-ċwievet.

# private (secret) key
>> sk := keys ewwel.

# public key
>> pk := keys aħħar.

# sign a message
>> sig := Kaxxaforti iffirma: ['abc'] bi: sk.

# check message (ok)
Ħruġ ikteb: ( 
	Kaxxaforti
		iċċekkja: ['abc'] 
		firma: sig 
		bi: pk 
), linja-ġdida.

# check message (fail)
Ħruġ ikteb: ( 
	Kaxxaforti 
		iċċekkja: ['abd'] 
		firma: sig 
		bi: pk 
), linja-ġdida.