>> Animal := Oġġett ġdid.
Animal meta: ['make'] agħmel: {
	>> animal := Oġġett ġdid.
	animal meta: ['makeSound'] agħmel: {
		Ħruġ ikteb: proprju sound.
	}. <- animal.
}.
>> Cat := Oġġett ġdid.
Cat meta: ['make'] agħmel: {
	>> cat := Animal make.
	cat meta: ['init'] agħmel: {
		proprju sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
