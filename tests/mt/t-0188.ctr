

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm ġestjoni-memorja: 0.

{ :i Ħruġ ikteb: i. } × 4.
Ħruġ linja-ġdida.
{ :i Ħruġ ikteb: (4 - i). } × 4.
Ħruġ linja-ġdida.
( 1 > 2 ) falz: { Ħruġ ikteb: ['BLOCK 1'], linja-ġdida. }.
( 2 > 1 ) veru:  { Ħruġ ikteb: ['BLOCK 2'], linja-ġdida. }.

>> i := 0.
{ Ħruġ ikteb: i. i żid: 1. } sakemm: { <- ( i < 3). }.
Ħruġ linja-ġdida.

i := 3.
{ Ħruġ ikteb: i. i := i - 1. } sakemm: { <- ( i > 0). }.
Ħruġ linja-ġdida.


Programm naddaf.

usedMemory1 := (Programm memorja ? 0).


{ :i  Ħruġ ikteb: i. } × 4.
Ħruġ linja-ġdida.
{ :i  Ħruġ ikteb: (4 - i). } × 4.
Ħruġ linja-ġdida.
( 1 > 2 ) falz: { Ħruġ ikteb: ['BLOCK 1'], linja-ġdida. }.
( 2 > 1 ) veru:  { Ħruġ ikteb: ['BLOCK 2'], linja-ġdida. }.

>> i := 0.
{ Ħruġ ikteb: i. i żid: 1. } sakemm: { <- ( i < 3). }.
Ħruġ linja-ġdida.

i := 3.
{ Ħruġ ikteb: i. i := i - 1. } sakemm: { <- ( i > 0). }.
Ħruġ linja-ġdida.



Programm naddaf.
usedMemory2 := (Programm memorja ? 0).


{ :i Ħruġ ikteb: i. } × 4.
Ħruġ linja-ġdida.
{ :i Ħruġ ikteb: (4 - i). } × 4.
Ħruġ linja-ġdida.
( 1 > 2 ) falz: { Ħruġ ikteb: ['BLOCK 1'], linja-ġdida. }.
( 2 > 1 ) veru:  { Ħruġ ikteb: ['BLOCK 2'], linja-ġdida. }.

>> i := 0.
{ Ħruġ ikteb: i. i żid: 1. } sakemm: { <- ( i < 3). }.
Ħruġ linja-ġdida.

i := 3.
{ Ħruġ ikteb: i. i := i - 1. } sakemm: { <- ( i > 0). }.
Ħruġ linja-ġdida.

Programm naddaf.
usedMemory3 := (Programm memorja ? 0).



( usedMemory1 = usedMemory2 u: usedMemory1 = usedMemory3, u: usedMemory2 = usedMemory3 ) veru: {
	Ħruġ ikteb: ['No memory leaks here'].
}, falz: {
	Ħruġ ikteb: ['Leaking memory...'].
}.
