>> Grandfather := Oġġett ġdid.
Grandfather meta: ['greet'] agħmel: {
	Ħruġ ikteb: ['Ave!'], linja-ġdida.
}.
>> Father := Grandfather ġdid.
Father meta: ['greet'] agħmel: {
	Ħruġ ikteb: ['Hello'], linja-ġdida.
	innifsu greet.
}.
>> Son := Father ġdid.
Son meta: ['greet'] agħmel: {
	Ħruġ ikteb: ['Hi'], linja-ġdida.
	innifsu greet.
}.

Son greet.

>> Roundabout := Oġġett ġdid.
Roundabout meta: ['circle:'] agħmel: { :x
	Ħruġ ikteb: x, linja-ġdida.
	(x < 3) veru: { innifsu rikursiv circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) veru: { Ħruġ ikteb: x, linja-ġdida. x żid: 1.  increment ibda. }. }.
increment ibda.