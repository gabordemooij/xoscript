>> invoice := Oġġett ġdid.
invoice meta: ['ibda'] agħmel: {
        proprju numru := 0.
}.

invoice meta: ['numru'] agħmel: {
        proprju numru żid: 1. <- proprju numru ikkopja.
}.

>> year-invoice := invoice ġdid.
year-invoice meta: ['start:'] agħmel: { :sena
	proprju numru := sena.
}.

year-invoice start: 202000.
Ħruġ ikteb: year-invoice numru, linja-ġdida.
Ħruġ ikteb: year-invoice numru, linja-ġdida.
