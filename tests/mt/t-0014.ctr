>> Greeter := Oġġett ġdid.
Greeter meta: ['make'] agħmel: {
	>> gr := Oġġett ġdid.
	gr meta: ['setName:'] agħmel: { :aname
		proprju isem := aname.
	}.
	gr meta: ['greet'] agħmel: {
		Ħruġ ikteb: proprju isem.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a ġdid.
c setName: ['THREE'].
c greet.
>> d := a ġdid.
d setName: ['FOUR'].
d greet.
c greet.
