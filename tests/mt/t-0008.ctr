>> Greeter := Oġġett ġdid.
Greeter meta: ['make'] agħmel: {
	>> greeter := Oġġett ġdid.
	greeter meta: ['name:'] agħmel: { :isem
		Ħruġ ikteb: ['setting a name'].
		proprju myName := isem.
	}.
	greeter meta: ['greet'] agħmel: {
		Ħruġ ikteb: ['Hello'].
		Ħruġ ikteb: proprju myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
