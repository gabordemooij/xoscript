

>> Matryoshka := Oġġett ġdid.
Matryoshka meta: ['double:'] agħmel: { :secret
	proprju secret := secret × 2.
}.
Matryoshka meta: ['ġdid:'] agħmel: { :secret
	>> answer := Xejn.
	>> t := (secret > 255).
	Ħruġ ikteb: (secret + [' | '] + t), linja-ġdida.
	t veru: {
		answer := secret.
	}, inkella: {
		answer := Matryoshka rikursiv ġdid: (innifsu double: secret).
	}. <- answer.
}.

>> x := Matryoshka ġdid: 2.
