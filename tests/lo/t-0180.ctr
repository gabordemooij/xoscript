ຂໍ້ຄວາມ ເມື່ອ: ['html'] ເຮັດ: { <- (
		ຕົນເອງ
		ແທນທີ່: ['&'] ດ້ວຍ: ['&amp;'],
		ແທນທີ່: ['<'] ດ້ວຍ: ['&lt;'],
		ແທນທີ່: ['>'] ດ້ວຍ: ['&gt;'],
		ແທນທີ່: ['''] ດ້ວຍ: ['&apos;'],
		ແທນທີ່: ['"'] ດ້ວຍ: ['&quot;']
	).
}.

