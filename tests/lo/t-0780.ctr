Server init.

# JSON encoder only supports UTF-8, no surrogate pairs

>> dicts := ລິສ ໃໝ່ ;
	# {"key":"normal"} normal ASCII
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['normal'] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"hello world"} space character
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['hello world'] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"quote: \""} double quote
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['"'] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"backslash: \\"} backslash
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['backslash: \\'] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"slash: /"} slash
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['slash: /'] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['backspace: \b'] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"formfeed: \f"} form-feed escape
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['formfeed: \f'] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"newline: \n"} newline
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['newline: \n'] ທີ່ກະແຈ: ['key'] ) ;
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['newline: ↵'] ທີ່ກະແຈ: ['key'] ) ;
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['newline: 
	'] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"carriage return: \r"} carriage-return
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['carriage return: \r'] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"tab: \t"} tab
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['tab \t'] ທີ່ກະແຈ: ['key'] ) ;
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['tab ⇿'] ທີ່ກະແຈ: ['key'] ) ;
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['tab  '] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['NUL \u0000'] ທີ່ກະແຈ: ['key'] ) ;
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['NUL \0'] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"control: \u0001"} control character 0x01
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['control: \u0001'] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"control: \u001F"} control character 0x1F
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['control: \u001F'] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-byte char
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['unicode: é'] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-byte char
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['unicode: €'] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"unicode: 日本語"} multiple 3-byte UTF-8 chars
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['unicode: 日本語'] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-byte char
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['unicode: 😀'] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['unicode: 🧑‍💻'] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"combining: e\u0301"} combining accent
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['combining: e\u0301'] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"escaped unicode: \u00e9"} Unicode escape BMP
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['escaped unicode: \u00e9'] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"escaped unicode: \u20ac"} Unicode escape BMP
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['escaped unicode: \u20ac'] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"escaped unicode: \ud83d\ude00"} UTF-16 surrogate pair
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['escaped unicode: \ud83d\ude00'] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":""} empty value
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: [''] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} special ASCII chars
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['@ < > & = % + ? #'] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"single quote: '"} single quote
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['''] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} multiple JSON escapes
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['multiple: \" \\ \n \r \t'] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} longer ASCII-string
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":" value"} leading space
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: [' value'] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":"value "} trailing space
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['value '] ທີ່ກະແຈ: ['key'] ) ;
	# {"key":" \t\n\r "} whitespace
	( ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: [' \t\n\r '] ທີ່ກະແຈ: ['key'] ).

dicts ແຕ່ລະຕົວ: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: d key ທີ່ກະແຈ: ['key']).
	>> b := JSON jsonify: (ວັດຈະນານຸກົມ ໃໝ່ ໃສ່: ['value'] ທີ່ກະແຈ: d key).
	>> e := JSON ວັດຖຸ: a.
	>> f := JSON ວັດຖຸ: b.
	((e key = d key ແລະ: (f ? d key = ['value'])) ຫຼື: (e key = ['NUL ?'])) ຖ້າຈິງ: {
		ຜົນອອກ ຂຽນ: ['OK'], ຂຶ້ນແຖວໃໝ່.
	}, ຖ້າບໍ່ດັ່ງນັ້ນ: {
		ຜົນອອກ ຂຽນ: ['Unable to properly encode/decode: '] + d + j, ຂຶ້ນແຖວໃໝ່.
		ໂປຣແກຣມ ຈົບ.
	}.
}.
