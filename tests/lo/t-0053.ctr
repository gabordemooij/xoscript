60 × {
	>> x := (ຕົວເລກ random % 6) + 1.
	(x ≤ 6) ຖ້າເທັດ: { ຜົນອອກ ຂຽນ: ['FAIL']. }.
	(x ≥0) ຖ້າເທັດ: { ຜົນອອກ ຂຽນ: ['FAIL']. }.
	x := (ຕົວເລກ random % 3) + 1.
	(x < 3) ຖ້າເທັດ: { ຜົນອອກ ຂຽນ: ['FAIL']. }.
	(x>-1) ຖ້າເທັດ: { ຜົນອອກ ຂຽນ: ['FAIL']. }.
	x := ((ບູລີນ flip) ເປັນຕົວເລກ).
	(x = 0 ຫຼື: x = 1) ຖ້າເທັດ: { ຜົນອອກ ຂຽນ: ['FAIL']. }.
	x := ((ຈິງ flip) ເປັນຕົວເລກ).
	(x = 0 ຫຼື: x = 1) ຖ້າເທັດ: { ຜົນອອກ ຂຽນ: ['FAIL']. }.
	x := (ບູລີນ flip ເລືອກ: ['HEAD'] ຫຼືອັນນີ້: ['TAIL']).
	((x = ['HEAD']) ຫຼື: (x = ['TAIL'])) ຖ້າເທັດ: { ຜົນອອກ ຂຽນ: ['FAIL']. }.
}.
ຜົນອອກ ຂຽນ: ['DONE'].

