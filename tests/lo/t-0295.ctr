
>> dictionary := (
	ວັດຈະນານຸກົມ ໃໝ່
		ໃສ່: ['b'] ທີ່ກະແຈ: ['a'],
		ໃສ່: ['a'] ທີ່ກະແຈ: ['b'],
		ໃສ່: ['z'] ທີ່ກະແຈ: ['x'],
		ໃສ່: ['hello'] ທີ່ກະແຈ: ['hallo'],
		ໃສ່: ['human'] ທີ່ກະແຈ: ['human']
).

>> comparisons := ລິສ ໃໝ່.
dictionary ແຕ່ລະຕົວ: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a ປຽບທຽບ: b)
	).
}.

comparisons ຈັດລຽງ: { :a :b <- ( a ປຽບທຽບ: b ). }.
ຜົນອອກ ຂຽນ: ( comparisons ລວມ: ['↵'] ), ຂຶ້ນແຖວໃໝ່.
comparisons ລວມ: ['↵'].
