


>> wine := ວັດຖຸ ໃໝ່.


wine ເມື່ອ: ['toString'] ເຮັດ: { <- ['merlot'].
}.

wine ເມື່ອ: ['naarTekst'] ເຮັດ: { <- ['merlot'].
}.


wine ເມື່ອ: ['='] ເຮັດ: { :other wine <- ( ຕົນເອງ toString = other wine ).
}.

wine ເມື່ອ: ['=='] ເຮັດ: { :other wine <- ( ຕົນເອງ toString = other wine ).
}.



wine
	ກໍລະນີ: ['cabernet'] ເຮັດ: { ຜົນອອກ ຂຽນ: ['it's a Cabernet!']. },
	ກໍລະນີ: ['syrah']    ເຮັດ: { ຜົນອອກ ຂຽນ: ['it's a Syrah!'].    },
	ກໍລະນີ: ['merlot']   ເຮັດ: { ຜົນອອກ ຂຽນ: ['it's a Merlot!'].   },
	ກໍລະນີ: ['malbec']   ເຮັດ: { ຜົນອອກ ຂຽນ: ['it's a Malbec!'].   }.

ຜົນອອກ ຂຶ້ນແຖວໃໝ່.
