>> phrases := ລິສ ໃໝ່
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases ແຕ່ລະຕົວ: { :_ :phrase 
	>> e := Server base64-ເຂົ້າລະຫັດ: phrase.
	>> d := Server base64-ຖອດລະຫັດ: e.
	ຜົນອອກ ຂຽນ: (
		message ສຳເນົາ ~encoded: e, ~decoded: d
	), ຂຶ້ນແຖວໃໝ່.
}.
