Server init.

>> DB := Maria-DB ໃໝ່ ໂຮສ: ['localhost'],
	ຊື່ຜູ້ໃຊ້: ['xo'],
	ລະຫັດຜ່ານ: ['pass123'],
	ຊື່ຖານຂໍ້ມູນ: ['xobase'],
	ເຊື່ອມຕໍ່.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB ຄິວຣີ: SQL.

# now you don't have to set DB
query2 ດຶງຂໍ້ມູນ: { :row
	ຜົນອອກ ຂຽນ: row world, ຂຶ້ນແຖວໃໝ່.
}.
