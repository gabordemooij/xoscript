>> echo := ວັດຖຸ ໃໝ່.
echo ເມື່ອ: ['ຕອບ:'] ເຮັດ: { :sound
	{ ຜົນອອກ ຂຽນ: sound. } × 2.
}.
echo ho!. 


echo := ວັດຖຸ ໃໝ່.
echo ເມື່ອ: ['ຕອບ:ແລະ:'] ເຮັດ: { :sound :x
	{ ຜົນອອກ ຂຽນ: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := ວັດຖຸ ໃໝ່.
echo ເມື່ອ: ['ຕອບ:ແລະ:ແລະ:'] ເຮັດ: { :operation :sound :x
	{ ຜົນອອກ ຂຽນ: sound. } × x.
}.
echo shout: ['la'] times: 4. 


