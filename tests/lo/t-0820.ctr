# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := ແພັດເທີນ ໃໝ່: pattern.
	p ກົງກັບ: subject ເຮັດ: { :m :g
		ຜົນອອກ ຂຽນ: g ຈຳນວນ, ຂຽນ: [' '], ຂຽນ: (g ລວມ: ['|']), ຂຶ້ນແຖວໃໝ່. <- m.
	}.
}.
show ນຳໃຊ້ກັບ: ['(a)|(b)'] ແລະ: ['b'].
show ນຳໃຊ້ກັບ: ['(a)|(b)'] ແລະ: ['a'].
show ນຳໃຊ້ກັບ: ['(x)?y'] ແລະ: ['y'].
show ນຳໃຊ້ກັບ: ['(x)?(y)(z)?'] ແລະ: ['xy'].
