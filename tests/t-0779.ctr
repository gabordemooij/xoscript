Out write: ['Test object'], stop.
>> p := Path /tmp.
Out write: p, stop.
>> old-p-address := p prototype memory-address.
p save-as: ['/tmp/a.bin'].
Out write: ['========== RELOADING SNAP:'], stop.
>> b := Object load-from: ['/tmp/a.bin'].
(b prototype memory-address = old-p-address) true: {
	Out write: ['Object link re-attached.'], stop.
}.
Out write: b, stop.
