>> phrases := ሰልፍ አዲስ
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases እያንዳንዱ: { :_ :phrase 
	>> e := Server base64-ኮድ-አድርግ: phrase.
	>> d := Server base64-ኮድ-ፍታ: e.
	ውጤት ፃፍ: (
		message ቅዳ ~encoded: e, ~decoded: d
	), አዲስ-መስመር.
}.
