# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> የፋይል-መንገድ := ['/tmp/dat.csv'].
>> csv := ፋይል አዲስ: የፋይል-መንገድ.
csv ፃፍ: s.

# accepts CRLF LF CR, varying row length
csv መለያ: [';'] ትእምርተ-ጥቅስ: ['"'] መስመሮች: { :line
	ፕሮግራም አጽዳ.
	ውጤት ፃፍ: line, አዲስ-መስመር.
	ፕሮግራም አጽዳ.
}.

# unequal lines
s መጨረሻ-ላይ-ጨምር: ['\njustone'].
csv ፃፍ: s.
{
	csv መለያ: [';'] ትእምርተ-ጥቅስ: ['"'] መስመሮች: { :line
		ውጤት ፃፍ: line, አዲስ-መስመር.
	}.
} ያዝ: { :e 
	ውጤት ፃፍ: e, አዲስ-መስመር.
}, ጀምር.

# invalid format
s := ['"he"llo";world'].
csv ፃፍ: s.
{
	csv መለያ: [';'] ትእምርተ-ጥቅስ: ['"'] መስመሮች: { :line
		ውጤት ፃፍ: line, አዲስ-መስመር.
	}.
} ያዝ: { :e 
	ውጤት ፃፍ: e, አዲስ-መስመር.
}, ጀምር.
