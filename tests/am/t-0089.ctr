>> randomizer := { :a :b
	>> ዝቅተኛ := ( a < b ) ይህ: a ወይም-ያ: b.
	>> ከፍተኛ := ( a > b ) ይህ: a ወይም-ያ: b.
	>> x := ባዶ.
	{
		x := ቁጥር መካከል: a እስከ: b.
		((x < ዝቅተኛ) ወይም: (x > ከፍተኛ)) እውነት-ከሆነ: { 
			ውጤት ፃፍ: (['Invalid value!']).
			ፕሮግራም ጨርስ.
		}.
	} 
	× 100. <- x.
}.
randomizer ተግብር: 0 እና: 0.
