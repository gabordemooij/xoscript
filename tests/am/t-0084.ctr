>> makeAdder := { :x
	>> f := { :y <- (የራሱ x + y). } አስቀምጥ: ['x'] ዋጋ: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i የራሱ q አኑር: (የራሱ f ተግብር: (የራሱ q ? i)) ቁልፍ: i. } 
	አስቀምጥ: ['q'] ዋጋ: array,
	አስቀምጥ: ['f'] ዋጋ: func.
	{ :i mapping ተግብር: i. } × (array ብዛት).
}.

>> a := ሰልፍ ← 1; 2; 3.
mapper ተግብር: a እና: (makeAdder ተግብር: 100).
ውጤት ፃፍ: (a ቦታ: 0), አዲስ-መስመር.
ውጤት ፃፍ: (a ? 1), አዲስ-መስመር.
ውጤት ፃፍ: (a ? 2), አዲስ-መስመር.
