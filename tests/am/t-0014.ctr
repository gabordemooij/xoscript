>> Greeter := ነገር አዲስ.
Greeter ሲደርስ: ['make'] አድርግ: {
	>> gr := ነገር አዲስ.
	gr ሲደርስ: ['setName:'] አድርግ: { :aname
		የራሱ ስም := aname.
	}.
	gr ሲደርስ: ['greet'] አድርግ: {
		ውጤት ፃፍ: የራሱ ስም.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a አዲስ.
c setName: ['THREE'].
c greet.
>> d := a አዲስ.
d setName: ['FOUR'].
d greet.
c greet.
