>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> ኮድ := {
	>> o := (
		መዝገበ-ቃላት አዲስ
		aa: (ሰልፍ ← 1 ; 2),
		bb: (ሰልፍ ← 3 ; 4)
	).
	>> s := o በጽሑፍ.
	>> o2 := s እንደ-ነገር.
	(s  ዓይነት = ጽሑፍ ዓይነት) እውነት-ከሆነ: { ውጤት ፃፍ: ['OK1'], አዲስ-መስመር. }.
	(o2 ዓይነት = መዝገበ-ቃላት ዓይነት) እውነት-ከሆነ: { ውጤት ፃፍ: ['OK2'], አዲስ-መስመር. }.
}.

ፕሮግራም የትውስታ-አስተዳደር: 0.
