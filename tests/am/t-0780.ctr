Server init.

# JSON encoder only supports UTF-8, no surrogate pairs

>> dicts := ሰልፍ አዲስ ;
	# {"key":"normal"} normal ASCII
	( መዝገበ-ቃላት አዲስ አኑር: ['normal'] ቁልፍ: ['key'] ) ;
	# {"key":"hello world"} space character
	( መዝገበ-ቃላት አዲስ አኑር: ['hello world'] ቁልፍ: ['key'] ) ;
	# {"key":"quote: \""} double quote
	( መዝገበ-ቃላት አዲስ አኑር: ['"'] ቁልፍ: ['key'] ) ;
	# {"key":"backslash: \\"} backslash
	( መዝገበ-ቃላት አዲስ አኑር: ['backslash: \\'] ቁልፍ: ['key'] ) ;
	# {"key":"slash: /"} slash
	( መዝገበ-ቃላት አዲስ አኑር: ['slash: /'] ቁልፍ: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( መዝገበ-ቃላት አዲስ አኑር: ['backspace: \b'] ቁልፍ: ['key'] ) ;
	# {"key":"formfeed: \f"} form-feed escape
	( መዝገበ-ቃላት አዲስ አኑር: ['formfeed: \f'] ቁልፍ: ['key'] ) ;
	# {"key":"newline: \n"} newline
	( መዝገበ-ቃላት አዲስ አኑር: ['newline: \n'] ቁልፍ: ['key'] ) ;
	( መዝገበ-ቃላት አዲስ አኑር: ['newline: ↵'] ቁልፍ: ['key'] ) ;
	( መዝገበ-ቃላት አዲስ አኑር: ['newline: 
	'] ቁልፍ: ['key'] ) ;
	# {"key":"carriage return: \r"} carriage-return
	( መዝገበ-ቃላት አዲስ አኑር: ['carriage return: \r'] ቁልፍ: ['key'] ) ;
	# {"key":"tab: \t"} tab
	( መዝገበ-ቃላት አዲስ አኑር: ['tab \t'] ቁልፍ: ['key'] ) ;
	( መዝገበ-ቃላት አዲስ አኑር: ['tab ⇿'] ቁልፍ: ['key'] ) ;
	( መዝገበ-ቃላት አዲስ አኑር: ['tab  '] ቁልፍ: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( መዝገበ-ቃላት አዲስ አኑር: ['NUL \u0000'] ቁልፍ: ['key'] ) ;
	( መዝገበ-ቃላት አዲስ አኑር: ['NUL \0'] ቁልፍ: ['key'] ) ;
	# {"key":"control: \u0001"} control character 0x01
	( መዝገበ-ቃላት አዲስ አኑር: ['control: \u0001'] ቁልፍ: ['key'] ) ;
	# {"key":"control: \u001F"} control character 0x1F
	( መዝገበ-ቃላት አዲስ አኑር: ['control: \u001F'] ቁልፍ: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-byte char
	( መዝገበ-ቃላት አዲስ አኑር: ['unicode: é'] ቁልፍ: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-byte char
	( መዝገበ-ቃላት አዲስ አኑር: ['unicode: €'] ቁልፍ: ['key'] ) ;
	# {"key":"unicode: 日本語"} multiple 3-byte UTF-8 chars
	( መዝገበ-ቃላት አዲስ አኑር: ['unicode: 日本語'] ቁልፍ: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-byte char
	( መዝገበ-ቃላት አዲስ አኑር: ['unicode: 😀'] ቁልፍ: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	( መዝገበ-ቃላት አዲስ አኑር: ['unicode: 🧑‍💻'] ቁልፍ: ['key'] ) ;
	# {"key":"combining: e\u0301"} combining accent
	( መዝገበ-ቃላት አዲስ አኑር: ['combining: e\u0301'] ቁልፍ: ['key'] ) ;
	# {"key":"escaped unicode: \u00e9"} Unicode escape BMP
	( መዝገበ-ቃላት አዲስ አኑር: ['escaped unicode: \u00e9'] ቁልፍ: ['key'] ) ;
	# {"key":"escaped unicode: \u20ac"} Unicode escape BMP
	( መዝገበ-ቃላት አዲስ አኑር: ['escaped unicode: \u20ac'] ቁልፍ: ['key'] ) ;
	# {"key":"escaped unicode: \ud83d\ude00"} UTF-16 surrogate pair
	( መዝገበ-ቃላት አዲስ አኑር: ['escaped unicode: \ud83d\ude00'] ቁልፍ: ['key'] ) ;
	# {"key":""} empty value
	( መዝገበ-ቃላት አዲስ አኑር: [''] ቁልፍ: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} special ASCII chars
	( መዝገበ-ቃላት አዲስ አኑር: ['@ < > & = % + ? #'] ቁልፍ: ['key'] ) ;
	# {"key":"single quote: '"} single quote
	( መዝገበ-ቃላት አዲስ አኑር: ['''] ቁልፍ: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} multiple JSON escapes
	( መዝገበ-ቃላት አዲስ አኑር: ['multiple: \" \\ \n \r \t'] ቁልፍ: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} longer ASCII-string
	( መዝገበ-ቃላት አዲስ አኑር: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] ቁልፍ: ['key'] ) ;
	# {"key":" value"} leading space
	( መዝገበ-ቃላት አዲስ አኑር: [' value'] ቁልፍ: ['key'] ) ;
	# {"key":"value "} trailing space
	( መዝገበ-ቃላት አዲስ አኑር: ['value '] ቁልፍ: ['key'] ) ;
	# {"key":" \t\n\r "} whitespace
	( መዝገበ-ቃላት አዲስ አኑር: [' \t\n\r '] ቁልፍ: ['key'] ).

dicts እያንዳንዱ: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (መዝገበ-ቃላት አዲስ አኑር: d key ቁልፍ: ['key']).
	>> b := JSON jsonify: (መዝገበ-ቃላት አዲስ አኑር: ['value'] ቁልፍ: d key).
	>> e := JSON ነገር: a.
	>> f := JSON ነገር: b.
	((e key = d key እና: (f ? d key = ['value'])) ወይም: (e key = ['NUL ?'])) እውነት-ከሆነ: {
		ውጤት ፃፍ: ['OK'], አዲስ-መስመር.
	}, አለበለዚያ: {
		ውጤት ፃፍ: ['Unable to properly encode/decode: '] + d + j, አዲስ-መስመር.
		ፕሮግራም ጨርስ.
	}.
}.
