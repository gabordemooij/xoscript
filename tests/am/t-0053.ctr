60 × {
	>> x := (ቁጥር random % 6) + 1.
	(x ≤ 6) ሐሰት-ከሆነ: { ውጤት ፃፍ: ['FAIL']. }.
	(x ≥0) ሐሰት-ከሆነ: { ውጤት ፃፍ: ['FAIL']. }.
	x := (ቁጥር random % 3) + 1.
	(x < 3) ሐሰት-ከሆነ: { ውጤት ፃፍ: ['FAIL']. }.
	(x>-1) ሐሰት-ከሆነ: { ውጤት ፃፍ: ['FAIL']. }.
	x := ((ቡሊያን flip) በቁጥር).
	(x = 0 ወይም: x = 1) ሐሰት-ከሆነ: { ውጤት ፃፍ: ['FAIL']. }.
	x := ((እውነት flip) በቁጥር).
	(x = 0 ወይም: x = 1) ሐሰት-ከሆነ: { ውጤት ፃፍ: ['FAIL']. }.
	x := (ቡሊያን flip ይህ: ['HEAD'] ወይም-ያ: ['TAIL']).
	((x = ['HEAD']) ወይም: (x = ['TAIL'])) ሐሰት-ከሆነ: { ውጤት ፃፍ: ['FAIL']. }.
}.
ውጤት ፃፍ: ['DONE'].

