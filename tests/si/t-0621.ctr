>> phrases := ලේඛනය නව
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases එකිනෙක: { :_ :phrase 
	>> e := Server base64-කේතනය: phrase.
	>> d := Server base64-විකේතනය: e.
	නිමැවුම ලියන්න: (
		message පිටපත ~encoded: e, ~decoded: d
	), නව-පේළිය.
}.
