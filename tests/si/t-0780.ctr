Server init.

# JSON encoder only supports UTF-8, no surrogate pairs

>> dicts := ලේඛනය නව ;
	# {"key":"normal"} normal ASCII
	( ශබ්දකෝෂය නව තබන්න: ['normal'] යතුර: ['key'] ) ;
	# {"key":"hello world"} space character
	( ශබ්දකෝෂය නව තබන්න: ['hello world'] යතුර: ['key'] ) ;
	# {"key":"quote: \""} double quote
	( ශබ්දකෝෂය නව තබන්න: ['"'] යතුර: ['key'] ) ;
	# {"key":"backslash: \\"} backslash
	( ශබ්දකෝෂය නව තබන්න: ['backslash: \\'] යතුර: ['key'] ) ;
	# {"key":"slash: /"} slash
	( ශබ්දකෝෂය නව තබන්න: ['slash: /'] යතුර: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( ශබ්දකෝෂය නව තබන්න: ['backspace: \b'] යතුර: ['key'] ) ;
	# {"key":"formfeed: \f"} form-feed escape
	( ශබ්දකෝෂය නව තබන්න: ['formfeed: \f'] යතුර: ['key'] ) ;
	# {"key":"newline: \n"} newline
	( ශබ්දකෝෂය නව තබන්න: ['newline: \n'] යතුර: ['key'] ) ;
	( ශබ්දකෝෂය නව තබන්න: ['newline: ↵'] යතුර: ['key'] ) ;
	( ශබ්දකෝෂය නව තබන්න: ['newline: 
	'] යතුර: ['key'] ) ;
	# {"key":"carriage return: \r"} carriage-return
	( ශබ්දකෝෂය නව තබන්න: ['carriage return: \r'] යතුර: ['key'] ) ;
	# {"key":"tab: \t"} tab
	( ශබ්දකෝෂය නව තබන්න: ['tab \t'] යතුර: ['key'] ) ;
	( ශබ්දකෝෂය නව තබන්න: ['tab ⇿'] යතුර: ['key'] ) ;
	( ශබ්දකෝෂය නව තබන්න: ['tab  '] යතුර: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( ශබ්දකෝෂය නව තබන්න: ['NUL \u0000'] යතුර: ['key'] ) ;
	( ශබ්දකෝෂය නව තබන්න: ['NUL \0'] යතුර: ['key'] ) ;
	# {"key":"control: \u0001"} control character 0x01
	( ශබ්දකෝෂය නව තබන්න: ['control: \u0001'] යතුර: ['key'] ) ;
	# {"key":"control: \u001F"} control character 0x1F
	( ශබ්දකෝෂය නව තබන්න: ['control: \u001F'] යතුර: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-byte char
	( ශබ්දකෝෂය නව තබන්න: ['unicode: é'] යතුර: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-byte char
	( ශබ්දකෝෂය නව තබන්න: ['unicode: €'] යතුර: ['key'] ) ;
	# {"key":"unicode: 日本語"} multiple 3-byte UTF-8 chars
	( ශබ්දකෝෂය නව තබන්න: ['unicode: 日本語'] යතුර: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-byte char
	( ශබ්දකෝෂය නව තබන්න: ['unicode: 😀'] යතුර: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	( ශබ්දකෝෂය නව තබන්න: ['unicode: 🧑‍💻'] යතුර: ['key'] ) ;
	# {"key":"combining: e\u0301"} combining accent
	( ශබ්දකෝෂය නව තබන්න: ['combining: e\u0301'] යතුර: ['key'] ) ;
	# {"key":"escaped unicode: \u00e9"} Unicode escape BMP
	( ශබ්දකෝෂය නව තබන්න: ['escaped unicode: \u00e9'] යතුර: ['key'] ) ;
	# {"key":"escaped unicode: \u20ac"} Unicode escape BMP
	( ශබ්දකෝෂය නව තබන්න: ['escaped unicode: \u20ac'] යතුර: ['key'] ) ;
	# {"key":"escaped unicode: \ud83d\ude00"} UTF-16 surrogate pair
	( ශබ්දකෝෂය නව තබන්න: ['escaped unicode: \ud83d\ude00'] යතුර: ['key'] ) ;
	# {"key":""} empty value
	( ශබ්දකෝෂය නව තබන්න: [''] යතුර: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} special ASCII chars
	( ශබ්දකෝෂය නව තබන්න: ['@ < > & = % + ? #'] යතුර: ['key'] ) ;
	# {"key":"single quote: '"} single quote
	( ශබ්දකෝෂය නව තබන්න: ['''] යතුර: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} multiple JSON escapes
	( ශබ්දකෝෂය නව තබන්න: ['multiple: \" \\ \n \r \t'] යතුර: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} longer ASCII-string
	( ශබ්දකෝෂය නව තබන්න: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] යතුර: ['key'] ) ;
	# {"key":" value"} leading space
	( ශබ්දකෝෂය නව තබන්න: [' value'] යතුර: ['key'] ) ;
	# {"key":"value "} trailing space
	( ශබ්දකෝෂය නව තබන්න: ['value '] යතුර: ['key'] ) ;
	# {"key":" \t\n\r "} whitespace
	( ශබ්දකෝෂය නව තබන්න: [' \t\n\r '] යතුර: ['key'] ).

dicts එකිනෙක: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (ශබ්දකෝෂය නව තබන්න: d key යතුර: ['key']).
	>> b := JSON jsonify: (ශබ්දකෝෂය නව තබන්න: ['value'] යතුර: d key).
	>> e := JSON වස්තුව: a.
	>> f := JSON වස්තුව: b.
	((e key = d key සහ: (f ? d key = ['value'])) හෝ: (e key = ['NUL ?'])) ඇත්ත-නම්: {
		නිමැවුම ලියන්න: ['OK'], නව-පේළිය.
	}, නැතිනම්: {
		නිමැවුම ලියන්න: ['Unable to properly encode/decode: '] + d + j, නව-පේළිය.
		වැඩසටහන අවසන්.
	}.
}.
