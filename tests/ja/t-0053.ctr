60 × {
	>> x := (数値 乱数 % 6) + 1.
	(x ≤ 6) 偽なら: { 出力 書く: ['失敗']. }.
	(x ≥0) 偽なら: { 出力 書く: ['失敗']. }.
	x := (数値 乱数 % 3) + 1.
	(x < 3) 偽なら: { 出力 書く: ['失敗']. }.
	(x>-1) 偽なら: { 出力 書く: ['失敗']. }.
	x := ((真偽値 裏返す) 数値化).
	(x = 0 または: x = 1) 偽なら: { 出力 書く: ['失敗']. }.
	x := ((真 裏返す) 数値化).
	(x = 0 または: x = 1) 偽なら: { 出力 書く: ['失敗']. }.
	x := (真偽値 裏返す どちらか: ['表'] または: ['裏']).
	((x = ['表']) または: (x = ['裏'])) 偽なら: { 出力 書く: ['失敗']. }.
}.
出力 書く: ['完了'].

