60 × {
	>> x := (数値 random % 6) + 1.
	(x ≤ 6) 偽なら: { 出力 書く: ['FAIL']. }.
	(x ≥0) 偽なら: { 出力 書く: ['FAIL']. }.
	x := (数値 random % 3) + 1.
	(x < 3) 偽なら: { 出力 書く: ['FAIL']. }.
	(x>-1) 偽なら: { 出力 書く: ['FAIL']. }.
	x := ((真偽値 flip) 数値化).
	(x = 0 または: x = 1) 偽なら: { 出力 書く: ['FAIL']. }.
	x := ((真 flip) 数値化).
	(x = 0 または: x = 1) 偽なら: { 出力 書く: ['FAIL']. }.
	x := (真偽値 flip どちらか: ['HEAD'] または: ['TAIL']).
	((x = ['HEAD']) または: (x = ['TAIL'])) 偽なら: { 出力 書く: ['FAIL']. }.
}.
出力 書く: ['DONE'].

