

>> obj := オブジェクト 新規.

obj 受信時: ['greet'] 実行: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj 受信時: ['task'] 実行: {
	自分の property := 123.
	{
		# try binds self/own to object instead of block
		出力 書く: 自身 greet.
		出力 書く: 自分の property.
		1 / 0.
	} 例外時: {
		出力 書く: 自身 greet.
		出力 書く: 自分の property.
		出力 書く: ['ok'].
	}, 試行.
}.

obj task.