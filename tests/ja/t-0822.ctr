# プレースホルダーより少ないパラメーターは、バインドの範囲外を読まずにエラーにならなければならない
Server init.

>> db := Maria-DB 新規 ホスト: ['localhost'],
	ユーザー名: ['xo'],
	パスワード: ['pass123'],
	データベース名: ['xobase'],
	接続.

>> 検索パラメータ := db クエリ: ['SELECT ? AS a, ? AS b, ? AS c'].
検索パラメータ パラメータ: (リスト 新規 ; ['1']).
{ 検索パラメータ 取得: { :行 出力 書く: 行, 改行. }. } 例外時: { :e 出力 書く: e, 改行. }, 開始.

>> 検索パラメータ := db クエリ: ['SELECT ? AS a'].
{ 検索パラメータ 取得: { :行 出力 書く: 行, 改行. }. } 例外時: { :e 出力 書く: e, 改行. }, 開始.

# 正しい数なら今まで通り動き、多すぎるパラメーターは以前と同じく無視される
>> 検索パラメータ := db クエリ: ['SELECT ? AS a, ? AS b'].
検索パラメータ パラメータ: (リスト 新規 ; ['1'] ; ['2']).
検索パラメータ 取得: { :行 出力 書く: (行 位置で: ['a']), 書く: (行 位置で: ['b']), 改行. }.
検索パラメータ パラメータ: (リスト 新規 ; ['1'] ; ['2'] ; ['3']).
検索パラメータ 取得: { :行 出力 書く: (行 位置で: ['a']), 書く: (行 位置で: ['b']), 改行. }.
