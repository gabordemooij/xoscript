# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := Maria-DB 新規 ホスト: ['localhost'],
	ユーザー名: ['xo'],
	パスワード: ['pass123'],
	データベース名: ['xobase'],
	接続.

>> 検索パラメータ := db クエリ: ['SELECT ? AS a, ? AS b, ? AS c'].
検索パラメータ パラメータ: (リスト 新規 ; ['1']).
{ 検索パラメータ 取得: { :row 出力 書く: row, 改行. }. } 例外時: { :e 出力 書く: e, 改行. }, 開始.

>> 検索パラメータ := db クエリ: ['SELECT ? AS a'].
{ 検索パラメータ 取得: { :row 出力 書く: row, 改行. }. } 例外時: { :e 出力 書く: e, 改行. }, 開始.

# the right number still works, more parameters are ignored as before
>> 検索パラメータ := db クエリ: ['SELECT ? AS a, ? AS b'].
検索パラメータ パラメータ: (リスト 新規 ; ['1'] ; ['2']).
検索パラメータ 取得: { :row 出力 書く: (row 位置で: ['a']), 書く: (row 位置で: ['b']), 改行. }.
検索パラメータ パラメータ: (リスト 新規 ; ['1'] ; ['2'] ; ['3']).
検索パラメータ 取得: { :row 出力 書く: (row 位置で: ['a']), 書く: (row 位置で: ['b']), 改行. }.
