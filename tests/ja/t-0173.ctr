

リスト 受信時: ['sum'] 実行: {
	>> total := 0.
	自身 各要素: { :index :element
		total 加算: element.
	}. <- total.
}.

リスト 受信時: ['product'] 実行: {
	>> total := 1.
	自身 各要素: { :index :element
		total 乗算: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

プログラム メモリ管理: 0.

{

>> a := リスト ← ['hello'] ; ['world'] ; 真 ; 無 ; 666.
a := a + ( リスト ← 1 ).
出力 書く: ( ['sum: '] + ( a sum ) ), 改行.
出力 書く: ( ['min: '] + ( a 最小 ) ), 改行.
出力 書く: ( ['max: '] + ( a 最大 ) ), 改行.
出力 書く: ( ['3rd: '] + ( a ? 2 ) ), 改行.
出力 書く: ( ['prd: '] + ( a product ) ), 改行.
a 並べ替え: { :a :b <- (b - a). }.
a 各要素: { :i :e 出力 書く: ( i - 0 ), 改行. }.

} 開始.

プログラム 掃除.
usedMemory1 := (プログラム メモリ ? 0).


{

>> a := リスト ← ['hello'] ; ['world'] ; 真 ; 無 ; 666.
a := a + ( リスト ← 1 ).
出力 書く: ( ['sum: '] + ( a sum ) ), 改行.
出力 書く: ( ['min: '] + ( a 最小 ) ), 改行.
出力 書く: ( ['max: '] + ( a 最大 ) ), 改行.
出力 書く: ( ['3rd: '] + ( a ? 2 ) ), 改行.
出力 書く: ( ['prd: '] + ( a product ) ), 改行.
a 並べ替え: { :a :b <- (b - a). }.
a 各要素: { :i :e 出力 書く: ( i - 0 ), 改行. }.

} 開始.



プログラム 掃除.
usedMemory2 := (プログラム メモリ ? 0).


{

>> a := リスト ← ['hello'] ; ['world'] ; 真 ; 無 ; 666.
a := a + ( リスト ← 1 ).
出力 書く: ( ['sum: '] + ( a sum ) ), 改行.
出力 書く: ( ['min: '] + ( a 最小 ) ), 改行.
出力 書く: ( ['max: '] + ( a 最大 ) ), 改行.
出力 書く: ( ['3rd: '] + ( a ? 2 ) ), 改行.
出力 書く: ( ['prd: '] + ( a product ) ), 改行.
a 並べ替え: { :a :b <- (b - a). }.
a 各要素: { :i :e 出力 書く: ( i - 0 ), 改行. }.

} 開始.



プログラム 掃除.
usedMemory3 := (プログラム メモリ ? 0).

( usedMemory1 = usedMemory2 かつ: usedMemory1 = usedMemory3, かつ: usedMemory2 = usedMemory3 ) 真なら: {
	出力 書く: ['No memory leaks here'].
}, 偽なら: {
	出力 書く: ['Leaking memory...'].
}.
