

リスト 受信時: ['sum'] 実行: {
	>> 合計 := 0.
	自身 各要素: { :添字 :要素
		合計 加算: 要素.
	}. <- 合計.
}.

リスト 受信時: ['product'] 実行: {
	>> 合計 := 1.
	自身 各要素: { :添字 :要素
		合計 乗算: 要素.
	}. <- 合計.
}.

>> 使用メモリ1 := 0.
>> 使用メモリ2 := 0.
>> 使用メモリ3 := 0.
>> 使用メモリ4 := 0.

プログラム メモリ管理: 0.

{

>> a := リスト ← ['hello'] ; ['world'] ; 真 ; 無 ; 666.
a := a + ( リスト ← 1 ).
出力 書く: ( ['合計: '] + ( a sum ) ), 改行.
出力 書く: ( ['最小: '] + ( a 最小 ) ), 改行.
出力 書く: ( ['最大: '] + ( a 最大 ) ), 改行.
出力 書く: ( ['3番目: '] + ( a ? 2 ) ), 改行.
出力 書く: ( ['積: '] + ( a product ) ), 改行.
a 並べ替え: { :a :b <- (b - a). }.
a 各要素: { :i :e 出力 書く: ( i - 0 ), 改行. }.

} 開始.

プログラム 掃除.
使用メモリ1 := (プログラム メモリ ? 0).


{

>> a := リスト ← ['hello'] ; ['world'] ; 真 ; 無 ; 666.
a := a + ( リスト ← 1 ).
出力 書く: ( ['合計: '] + ( a sum ) ), 改行.
出力 書く: ( ['最小: '] + ( a 最小 ) ), 改行.
出力 書く: ( ['最大: '] + ( a 最大 ) ), 改行.
出力 書く: ( ['3番目: '] + ( a ? 2 ) ), 改行.
出力 書く: ( ['積: '] + ( a product ) ), 改行.
a 並べ替え: { :a :b <- (b - a). }.
a 各要素: { :i :e 出力 書く: ( i - 0 ), 改行. }.

} 開始.



プログラム 掃除.
使用メモリ2 := (プログラム メモリ ? 0).


{

>> a := リスト ← ['hello'] ; ['world'] ; 真 ; 無 ; 666.
a := a + ( リスト ← 1 ).
出力 書く: ( ['合計: '] + ( a sum ) ), 改行.
出力 書く: ( ['最小: '] + ( a 最小 ) ), 改行.
出力 書く: ( ['最大: '] + ( a 最大 ) ), 改行.
出力 書く: ( ['3番目: '] + ( a ? 2 ) ), 改行.
出力 書く: ( ['積: '] + ( a product ) ), 改行.
a 並べ替え: { :a :b <- (b - a). }.
a 各要素: { :i :e 出力 書く: ( i - 0 ), 改行. }.

