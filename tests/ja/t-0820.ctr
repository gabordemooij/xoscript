# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := パターン 新規: pattern.
	p 一致: subject 実行: { :m :g
		出力 書く: g 個数, 書く: [' '], 書く: (g 結合: ['|']), 改行. <- m.
	}.
}.
show 適用: ['(a)|(b)'] かつ: ['b'].
show 適用: ['(a)|(b)'] かつ: ['a'].
show 適用: ['(x)?y'] かつ: ['y'].
show 適用: ['(x)?(y)(z)?'] かつ: ['xy'].
