
プログラム メモリ管理: 4.

>> Animal := オブジェクト 新規.
Animal 受信時: ['make'] 実行: {
	>> animal := オブジェクト 新規.
	animal 受信時: ['makeSound'] 実行: {
		出力 書く: 自分の sound.
	}. <- animal.
}.
>> Cat := オブジェクト 新規.
Cat 受信時: ['make'] 実行: {
	>> cat := Animal make.
	cat 受信時: ['init'] 実行: {
		自分の sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
