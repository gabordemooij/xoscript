
>> dictionary := (
	辞書 新規
		格納: ['b'] 場所: ['a'],
		格納: ['a'] 場所: ['b'],
		格納: ['z'] 場所: ['x'],
		格納: ['hello'] 場所: ['hallo'],
		格納: ['human'] 場所: ['human']
).

>> comparisons := リスト 新規.
dictionary 各要素: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a 比較: b)
	).
}.

comparisons 並べ替え: { :a :b <- ( a 比較: b ). }.
出力 書く: ( comparisons 結合: ['↵'] ), 改行.
comparisons 結合: ['↵'].
