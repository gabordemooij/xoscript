#OBSD
>> dirname := [''].
{ dirname 末尾に追加: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
プログラム システム: command.
プログラム chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename 末尾に追加: ['YYYYYYYY']. } * 20.
ファイル 新規: filename, 書く: ['sometext'].
{ ファイル 一覧: ['/tmp/'] + dirname. } * 1000.
出力 書く: ['no crash'], 改行.

