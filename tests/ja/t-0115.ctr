{
	このタスク エラー: ['Dont fail.'].
	unknown doSomething.
} 例外時: {
	出力 書く: ['Caught!'].
}, 開始.

{
	このタスク エラー: ['Dont fail.'].
	自分の unknown doSomething.
} 例外時: {
	出力 書く: ['Caught!'].
}, 開始.

{
	このタスク エラー: ['Dont fail.'].
	unknown := 122.
} 例外時: {
	出力 書く: ['Caught!'].
}, 開始.


{
	このタスク エラー: ['Dont fail.'].
	真 中断.
	出力 書く: ['FAIL'].
} 例外時: {
	出力 書く: ['Caught!'].
}, 開始.

{
	{
		このタスク エラー: ['Dont fail.'].
		真 中断.
		出力 書く: ['FAIL'].
	} 例外時: { :x
		(x = ['Dont fail.']) 真なら: { このタスク エラー: ['Nested Caught!']. }.
	}, 開始.
} 例外時: { :e
	出力 書く: e.
}, 開始.
