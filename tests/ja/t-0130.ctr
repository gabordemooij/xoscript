# Server プラグインで FFI を使う

# libc に接続する（プラットフォーム依存）
>> ライブラリ名 := プログラム 設定値: ['FFITESTLIB'].

# 高度なファイル操作のために C の stdio 関数をリンクする
Server リンク: ( リスト 新規 ;
 ライブラリ名 ; ['fopen'] ;
 ( リスト 新規 ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
リンク: ( リスト 新規 ;
 無 ; # 同じライブラリという意味
 ['fread'] ;
 ( リスト 新規 ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 無 ; # 同じオブジェクトという意味（つまり ストリーム）
 ['fread']
),
リンク: (
 リスト 新規 ;
 無 ; # 同じライブラリという意味
 ['fwrite'] ;
 ( リスト 新規 ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 無 ; # 同じライブラリという意味
 ['fwrite']
),
リンク: (
 リスト 新規 ;
 無 ; # 同じライブラリという意味
 ['rewind'] ;
 ( リスト 新規 ; ['pointer'] ) ;
 ['int'] ;
 無 ; # 同じライブラリという意味
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> 経路 := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# fopen(path, mode) でファイルを開く
>> fd := Stream path: 経路 mode: mode.

# バッファ str のバイトをファイルに書き込む
>> 書込バイト数 := Stream メッセージ: ['fwrite'] 引数: (リスト 新規 ; str ; 1 ; 6 ; fd ).
出力 書く: 書込バイト数, 改行.

# ファイルポインターを先頭に戻す
Stream rewind: fd.

# バッファを確保する
>> バッファ領域 := Blob 新規: 20.

# ファイルから読み込む
>> 読込バイト数 := Stream メッセージ: ['fread'] 引数: (リスト 新規 ; バッファ領域 ; 1 ; 6 ; fd ).
出力 書く: 読込バイト数, 改行.
出力 書く: バッファ領域, 改行.

# メモリを解放する
str  解放.
経路 解放.
mode 解放.
バッファ領域  解放.


