


>> CoffeeMachine := オブジェクト 新規.
CoffeeMachine 受信時: ['order:'] 実行: { :id
	>> coffee := ['Americano'].
	( id = 1 ) 真なら: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) 真なら: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) 真なら: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := オブジェクト 新規.
SimpleCoffeeMachine 受信時: ['order'] 実行: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
出力 書く: redCup, 改行.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
出力 書く: greenCup, 改行.
>> yellowCup := CoffeeMachine order: 1.
出力 書く: yellowCup, 改行.
>> blueCup := CoffeeMachine order: 0.
出力 書く: blueCup, 改行.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
出力 書く: blackCup, 改行.
blackCup 末尾に追加: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
出力 書く: orangeCup, 改行.
