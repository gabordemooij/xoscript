# test qualifiers

>> $ := オブジェクト 新規.

$ 受信時: ['応答:'] 実行: { :x
	
	>> operation := x 文字: 0.
	>> valuta := x 文字: 1.
	>> money := x オフセット: 2.
	
	>> amount := 0.

	( operation = ['+'] ) 真なら: {
		( valuta = ['£'] ) 真なら: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

出力 書く: x, 改行.


>> Fruit := オブジェクト 新規.

Fruit 受信時: ['新規'] 実行: {
	>> f := 自身 新規.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit 受信時: ['apples:'] 実行: { :a 自分の apples := a. }.
Fruit 受信時: ['oranges:'] 実行: { :p 自分の oranges := p. }.
Fruit 受信時: ['apples'] 実行: { <- 自分の apples. }.
Fruit 受信時: ['oranges'] 実行: { <- 自分の oranges. }.

Fruit 受信時: ['+'] 実行: { :f
	
	>> n := Fruit 新規.
	f 加算: 1.
	
	n apples: (f apples + 自分の apples).
	n oranges:  (f oranges  + 自分の oranges). <- n.
}.

Fruit 受信時: ['文字列化'] 実行: { <- ( 自分の apples 文字列化 + [' apples and '] + 自分の oranges + [' oranges'] ).
}.

数値 受信時: ['apples'] 実行: { <- ((Fruit 新規) apples: 自身).
}.

数値 受信時: ['apple'] 実行: { <- ((Fruit 新規) apples: 自身).
}.

数値 受信時: ['oranges'] 実行: { <- ((Fruit 新規) oranges: 自身).
}.




出力 書く: (1 apple + 3 oranges + 4 apples), 改行.


文字列 受信時: ['twice'] 実行: { <- ((自身 文字列化) + (自身 文字列化)).
}.



出力 書く: ['❤❤❤'] twice.



