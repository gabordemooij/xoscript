# 単位のテスト

>> $ := オブジェクト 新規.

$ 受信時: ['応答:'] 実行: { :x
	
	>> 演算 := x 文字: 0.
	>> 通貨記号 := x 文字: 1.
	>> お金 := x オフセット: 2.
	
	>> 金額 := 0.

	( 演算 = ['+'] ) 真なら: {
		( 通貨記号 = ['£'] ) 真なら: { 金額 := 1.28 × お金. }.
	}. <- 金額.
}.



>> x := $ +£20.

出力 書く: x, 改行.


>> 果物 := オブジェクト 新規.

果物 受信時: ['新規'] 実行: {
	>> f := 自身 新規.
	f apples: 0.
	f oranges: 0. <- f.
}.

果物 受信時: ['apples:'] 実行: { :a 自分の リンゴ := a. }.
果物 受信時: ['oranges:'] 実行: { :p 自分の オレンジ := p. }.
果物 受信時: ['リンゴ'] 実行: { <- 自分の リンゴ. }.
果物 受信時: ['オレンジ'] 実行: { <- 自分の オレンジ. }.

果物 受信時: ['+'] 実行: { :f
	
	>> n := 果物 新規.
	f 加算: 1.
	
	n apples: (f リンゴ + 自分の リンゴ).
	n oranges:  (f オレンジ  + 自分の オレンジ). <- n.
}.

果物 受信時: ['文字列化'] 実行: { <- ( 自分の リンゴ 文字列化 + [' 個のリンゴと '] + 自分の オレンジ + [' 個のオレンジ'] ).
}.

数値 受信時: ['リンゴ'] 実行: { <- ((果物 新規) apples: 自身).
}.

数値 受信時: ['apple'] 実行: { <- ((果物 新規) apples: 自身).
}.

数値 受信時: ['オレンジ'] 実行: { <- ((果物 新規) oranges: 自身).
}.




出力 書く: (1 apple + 3 オレンジ + 4 リンゴ), 改行.


文字列 受信時: ['二回'] 実行: { <- ((自身 文字列化) + (自身 文字列化)).
}.



出力 書く: ['❤❤❤'] 二回.



