

>> g  := Server 新規.
>> v  := 金庫 新規.
>> ok := 0.

>> 秘密一覧 := リスト 新規 ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> パスワード一覧 := 秘密一覧 複製.
パスワード一覧 各要素: { :i :p
	秘密一覧 各要素: { :n :s
		{
			>> 暗号文 := v 暗号化: s 鍵: p.
			>> 復号文 := v 復号: 暗号文 鍵: p.
			(復号文 = s) 真なら: {
				ok 加算: 1.
			}, さもなければ: {
				出力 書く: ['暗号化/復号に失敗: '], 改行.
				出力 書く: s, 改行.
				出力 書く: ['暗号化: '] + 暗号文, 改行.
				出力 書く: ['復号: '] + 暗号文, 改行.
				プログラム 終了.
			}.
		} 例外時: { :err
			(s = [''] または: p = ['']) 真なら: {
				ok 加算: 1.
			}, さもなければ: {
				出力 書く: err, 改行.
				プログラム 終了.
			}.
		}, 開始.
	}.
}.

出力 書く: ( ok + [' 件の金庫暗号化をテストしました。'] ), 改行.