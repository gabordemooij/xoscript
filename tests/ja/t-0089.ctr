>> randomizer := { :a :b
	>> 最小 := ( a < b ) どちらか: a または: b.
	>> 最大 := ( a > b ) どちらか: a または: b.
	>> x := 無.
	{
		x := 数値 範囲: a から: b.
		((x < 最小) または: (x > 最大)) 真なら: { 
			出力 書く: (['Invalid value!']).
			プログラム 終了.
		}.
	} 
	× 100. <- x.
}.
