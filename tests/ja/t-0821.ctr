# a quote that never closes must give an error, not an endless loop
>> 経路 := ['/tmp/test0821.csv'].
>> file := ファイル 新規: 経路.

file 書く: ['a,b\n"1,2\n'].
{
	file 区切り: [','] 引用符: ['"'] 各行: { :line
		出力 書く: line, 改行.
	}.
} 例外時: { :e 出力 書く: e, 改行. }, 開始.

# a closed quote still works
file 書く: ['a,b\n"1,2",3'].
file 区切り: [','] 引用符: ['"'] 各行: { :line
	出力 書く: line, 改行.
}.
file 削除.
