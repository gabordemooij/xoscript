# utf8 サニタイザーのテスト
Server init.

>> utf8事例 := 辞書 新規
	# ASCII のみ
	格納: ( リスト 新規 ; 65 ; 65 ; 65 ; 65 ; 0 ) 場所: ['AAAA'],
	# 有効な 2 バイト列
	格納: ( リスト 新規 ; 194 ; 162 ; 0 ) 場所: ['¢'],
	# 有効な 3 バイト UTF-8
    格納: ( リスト 新規 ; 226 ; 130 ; 172 ; 0 ) 場所: ['€'],
	# 有効な 4 バイト UTF-8
    格納: ( リスト 新規 ; 240 ; 144 ; 141 ; 136 ; 0 ) 場所: ['𐍈'],
	# シーケンス E2 28 AC 内の不正な継続バイト -> 3b シーケンス開始 + 28 不正カウント + AC 継続バイト、ただし同じエラーに属する
    格納: ( リスト 新規 ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) 場所: ['A?A'],
	# ASCII 'A' の冗長エンコーディング（? になるべき）、
    格納: ( リスト 新規 ; 65 ; 193 ; 129 ; 0 ) 場所: ['A?'],
	# 不正な先頭バイト (0xFF)
    格納: ( リスト 新規 ; 255 ; 0 ) 場所: ['?'],
	# 末尾の不完全なマルチバイト列
    格納: ( リスト 新規 ; 66 ; 226 ; 0 ) 場所: ['B?'],
    # 空文字列
    #put: ( List new ) at: [''],
	# 複数の混在したシーケンス
    格納: ( リスト 新規 ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) 場所: ['A€?𐍈B'].
	 
utf8事例 各要素: { :key :value
	>> blob := Blob 新規: value 個数, bytes: value.
	>> str := blob 文字列化.
	(str = key) 真なら: {
		出力 書く: ['OK'], 改行.
	}, さもなければ: {
		出力 書く: ['UTF8 サニタイザーが失敗: '] + key + [' 結果: '] + str, 改行.
	}.
	blob 解放.
}.
