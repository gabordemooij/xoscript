# Test utf8 sanitizer
Server init.

>> utf8cases := 辞書 新規
	# ASCII only
	格納: ( リスト 新規 ; 65 ; 65 ; 65 ; 65 ; 0 ) 場所: ['AAAA'],
	# valid 2 byte sequence
	格納: ( リスト 新規 ; 194 ; 162 ; 0 ) 場所: ['¢'],
	# Valid 3-byte UTF-8
    格納: ( リスト 新規 ; 226 ; 130 ; 172 ; 0 ) 場所: ['€'],
	# Valid 4-byte UTF-8
    格納: ( リスト 新規 ; 240 ; 144 ; 141 ; 136 ; 0 ) 場所: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    格納: ( リスト 新規 ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) 場所: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    格納: ( リスト 新規 ; 65 ; 193 ; 129 ; 0 ) 場所: ['A?'],
	# Invalid first byte (0xFF)
    格納: ( リスト 新規 ; 255 ; 0 ) 場所: ['?'],
	# Incomplete multi-byte sequence at end
    格納: ( リスト 新規 ; 66 ; 226 ; 0 ) 場所: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    格納: ( リスト 新規 ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) 場所: ['A€?𐍈B'].
	 
utf8cases 各要素: { :key :value
	>> blob := Blob 新規: value 個数, bytes: value.
	>> str := blob 文字列化.
	(str = key) 真なら: {
		出力 書く: ['OK'], 改行.
	}, さもなければ: {
		出力 書く: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, 改行.
	}.
	blob 解放.
}.
