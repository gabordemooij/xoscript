>> やること := オブジェクト 新規.

やること 受信時: ['新規'] 実行: {
	自分の list := リスト 新規.
}.

やること 受信時: ['nieuw'] 実行: {
	自分の list := リスト 新規.
}.

やること 受信時: ['+'] 実行: { :タスク
	自分の list 末尾に追加: タスク.
}.

やること 受信時: ['number of tasks?'] 実行: { <-  自分の list 個数.
}.

>> やること一覧 := 
	やること 新規 
	+ ['夕食を作る'] 
	+ ['部屋を掃除する'].
	
出力 書く: ['You have $ tasks to do'] $ やること一覧 number of tasks?.
