#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := パターン 新規: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern 一致: subject 実行: { :m :x
	出力 書く: m, 改行.
	出力 書く: x, 改行. <- ['XXX'].
}.
出力 書く: result, 改行.