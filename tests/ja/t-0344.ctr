# catch-all test (practical)
>> HTML := 文字列 新規.
HTML 受信時: ['encode:'] 実行: { :tekst
	自身 末尾に追加: (tekst
	置換: ['&'] 新: ['&amp;'], 
	置換: ['<'] 新: ['&lt;'],
	置換: ['>'] 新: ['&gt;'],
	置換: ['"'] 新: ['&quot;']).
}.
>> blog := HTML 新規.
blog 末尾に追加: ['<h1>'],
     encode: ['Koffie & Thee'],
     末尾に追加: ['</h1>'].
出力 書く: blog, 改行.


>> Roman := 数値 新規.
Roman 受信時: ['stringy'] 実行: {
	>> a := [''].
	{ a 末尾に追加: ['I']. } × 自身. <- a.
}.

>> x := Roman 新規.
x 加算: 3.
出力 書く: x stringy, 改行.

>> Quantum := 真偽値 新規.
Quantum 受信時: ['true?'] 実行: { <- ['maybe True']. }.
出力 書く: (Quantum 新規 true?), 改行.

>> Nihil := 無 新規.
Nihil 受信時: ['文字列化'] 実行: { <- ['Nihil']. }.
出力 書く: (Nihil 新規), 改行.
