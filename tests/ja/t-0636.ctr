# test url parsing

Server init.
>> url := URL 元: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

出力 書く: ['scheme = '] + url スキーム, 改行.
出力 書く: ['host = '] + url ホスト, 改行.
出力 書く: ['port = '] + url ポート, 改行.
出力 書く: ['path = '] + url 経路, 改行.
出力 書く: ['query = '] + url 検索パラメータ, 改行.
出力 書く: ['fragment = '] + url フラグメント, 改行.
