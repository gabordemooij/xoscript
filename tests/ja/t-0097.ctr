
文字列 受信時: ['html'] 実行: { <- (
		自身
		置換: ['&'] 新: ['&amp;'],
		置換: ['<'] 新: ['&lt;'],
		置換: ['>'] 新: ['&gt;'],
		置換: ['"'] 新: ['&quot;']
	).
}.

>> HTMLブラシ := オブジェクト 新規.

HTMLブラシ 受信時: ['応答:'] 実行: { :タグ
	出力 書く: (['<tag>↵'] tag: タグ ).
}.

HTMLブラシ 受信時: ['応答:かつ:'] 実行: { :タグ :content
	タグ := ( タグ 開始: 0 長さ: (タグ 長さ - 1) ).
	出力 書く: (['<tag content>↵'] tag: タグ, content: content).
}.

HTMLブラシ 受信時: ['content:'] 実行: { :テキスト
	出力 書く: テキスト html, 改行.
}.

HTMLブラシ 受信時: ['属性:値:'] 実行: { :属性名 :value <- ['attr="value"'] attr: 属性名, value: value.
}.

>> h := HTMLブラシ 新規.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h 属性: ['class'] 値: ['bold']),
		/span
	/body
/html.
		
