# 単位のテスト

プログラム 掃除.

>> 果物 := オブジェクト 新規.
果物 受信時: ['新規'] 実行: {
	>> f := 自身 新規.
	f apples: 0. <- f.
}.
果物 受信時: ['apples:'] 実行: { :a 自分の リンゴ := a. }.
果物 受信時: ['リンゴ'] 実行: { <- 自分の リンゴ. }.
果物 受信時: ['+'] 実行: { :f
	>> n := 果物 新規.
	n apples: (f リンゴ + 自分の リンゴ). <- n.
}.
数値 受信時: ['リンゴ'] 実行: { <- ((果物 新規) apples: 自身).
}.

果物 受信時: ['文字列化'] 実行: { <- 自分の リンゴ + [' 個のリンゴ '].
}.

>> q := 3 リンゴ + 4 リンゴ.
出力 書く: q, 改行.




q := 3 リンゴ + 4 リンゴ.
出力 書く: q, 改行.



q := 3 リンゴ + 4 リンゴ.
出力 書く: q, 改行.


