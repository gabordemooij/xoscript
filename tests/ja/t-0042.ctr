>> items := 辞書 新規.
items 格納: ['ブラック'] 場所: ['coffee'], 格納: ['アールグレイ'] 場所: ['紅茶'].
出力 書く: (items 位置で: ['coffee']), 書く: (items 位置で: ['紅茶']).
出力 書く: ['配列の項目数は'] + items 個数 + [' 個です。'].
items 格納: ['カプチーノ'] 場所: ['coffee'].
出力 書く: ['今の私のコーヒーは.. '] + (items 位置で: ['coffee']).
items 格納: ['aaa'] 場所: ['1'].
items 格納: ['bbb'] 場所: ['2'].
出力 書く: (items 位置で: ['a']).
