>> items := 辞書 新規.
items 格納: ['black'] 場所: ['coffee'], 格納: ['earl grey'] 場所: ['tea'].
出力 書く: (items 位置で: ['coffee']), 書く: (items 位置で: ['tea']).
出力 書く: ['there are'] + items 個数 + [' items in the array.'].
items 格納: ['capuccino'] 場所: ['coffee'].
出力 書く: ['Now my coffee is.. '] + (items 位置で: ['coffee']).
items 格納: ['aaa'] 場所: ['1'].
items 格納: ['bbb'] 場所: ['2'].
出力 書く: (items 位置で: ['a']).
