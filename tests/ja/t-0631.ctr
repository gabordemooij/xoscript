#ffi test


Server init.

プログラム メモリ管理: 4.

# for this test you need set a path to libc (puts)
>> libname := プログラム 設定値: ['FFITESTLIB'].



Server リンク: (
 リスト 新規 ;
 libname ;
 ['puts'] ;
 ( リスト 新規 ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s 解放.

# test with struct

>> a := Blob 新規: 8.
a bytes: (
	リスト <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (リスト <<: ['int'], ; ['int']).

Server リンク: (
	リスト <<: ['@structtest'], ;
	['@structtest'] ;
	(リスト <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
出力 書く: ['Sum test:'] + (ffitest ffisum: a), 改行.

struct struct-解放.
struct 解放.
a 解放.
