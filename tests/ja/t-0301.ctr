


>> wine := オブジェクト 新規.


wine 受信時: ['toString'] 実行: { <- ['merlot'].
}.

wine 受信時: ['naarTekst'] 実行: { <- ['merlot'].
}.


wine 受信時: ['='] 実行: { :other wine <- ( 自身 toString = other wine ).
}.

wine 受信時: ['=='] 実行: { :other wine <- ( 自身 toString = other wine ).
}.



wine
	場合: ['cabernet'] 実行: { 出力 書く: ['it's a Cabernet!']. },
	場合: ['syrah']    実行: { 出力 書く: ['it's a Syrah!'].    },
	場合: ['merlot']   実行: { 出力 書く: ['it's a Merlot!'].   },
	場合: ['malbec']   実行: { 出力 書く: ['it's a Malbec!'].   }.

出力 改行.
