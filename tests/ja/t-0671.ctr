# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := 金庫 鍵生成.

# private (secret) key
>> sk := keys 最初.

# public key
>> pk := keys 最後.

# sign a message
>> sig := 金庫 署名: ['abc'] 鍵: sk.

# check message (ok)
出力 書く: ( 
	金庫
		確認: ['abc'] 
		署名: sig 
		鍵: pk 
), 改行.

# check message (fail)
出力 書く: ( 
	金庫 
		確認: ['abd'] 
		署名: sig 
		鍵: pk 
), 改行.