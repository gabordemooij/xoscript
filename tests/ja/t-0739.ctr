出力 書く: ['Test object'], 改行.
>> a := オブジェクト 新規. 

a 受信時: ['item:'] 実行: { :binhelper
	自分の binhelper := binhelper. 
}.

a 受信時: ['item'] 実行: { <- 自分の binhelper.
}.

a item: Bin 新規.

>> old-binhelper-address := a item プロトタイプ メモリアドレス.
a save-as: ['/tmp/a.bin'].
出力 書く: ['========== RELOADING SNAP:'], 改行.

>> b := オブジェクト load-from: ['/tmp/a.bin'].

(b item プロトタイプ メモリアドレス = old-binhelper-address) 真なら: {
	出力 書く: ['Object link re-attached.'], 改行.
}.


