

リスト 受信時: ['fixture:'] 実行: { :f
	自分の fixture := f.
}.

リスト 受信時: ['個数'] 実行: { <- 自分の fixture.
}.

リスト 受信時: ['aantal'] 実行: { <- 自分の fixture.
}.


>> x := 無.
{

	x := ['hello'] 
	置換:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] 文字: 2)
			)
		)
	新: (
		(['...hal'] + ['lo']) 
			大文字 
			lowecase 
			大文字 
			オフセット: -1 + ( 
				11 - 12 + (
					(
						(
							(
								リスト ← 0 ; 1 ; 4; 9 ; (リスト ← 0 ; 3; 1) ; 4
							) 最後から二番目
						) ? 1
					) + 
					((リスト ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					個数
				)
			)
	).

} × 10.
