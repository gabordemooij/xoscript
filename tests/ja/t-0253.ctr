#Linux
>> OS := プログラム 設定値: ['OS'].

>> clock := 時点 新規.
	
(OS = ['Haiku']) 真なら: {
	clock タイムゾーン: ['CET'],
	年値: 2017, 月値: 7, 日値: 13,
	時値: 18, 分値: 0, 秒値: 0.
}, さもなければ: {
	clock タイムゾーン: ['Europe/Amsterdam'],
	年値: 2017, 月値: 7, 日値: 13,
	時値: 18, 分値: 0, 秒値: 0.
}.

clock 受信時: ['tell'] 実行: {
	出力 書く: 自身, 改行.
}.


clock 加算: 2    時値, tell.
clock 加算: 1    時値, tell.
clock 加算: 19 分値, tell.
clock 加算: 1  分値, tell.
clock 加算: 1  分値, tell.
clock 加算: 19 秒値, tell.
clock 加算: 1  秒値, tell.
clock 加算: 1  秒値, tell.
clock 加算: 2    年値, tell.
clock 加算: 1    年値, tell.

(OS = ['Haiku']) 真なら: {
clock 加算: 5   月値.
clock タイムゾーン: ['CEST'], tell.
}, さもなければ: {
	clock 加算: 5   月値, tell.
}.

clock 加算: 1   月値, tell.
clock 加算: 19    日値, tell.
clock 加算: 1    時値, tell.
clock 加算: 120  yard, tell.
