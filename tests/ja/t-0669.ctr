# パスワードのハッシュ化
Server init.

# ユーザーがパスワードを設定する
>> 暗証 := ['pass123'].

# このように保存する
>> ハッシュ値 := 金庫 
	パスワードハッシュ: 暗証.

# 次に、ユーザーがログインする
# 試行 1
>> a1 := ['abcd123'].
# 試行 2
>> a2 := ['pass123'].

# 検証
>> a := 金庫 
	パスワードハッシュ: ハッシュ値 検証: a1.
	# 失敗 
>> b := 金庫
	パスワードハッシュ: ハッシュ値 検証: a2.
	# OK!

出力 書く: a, 改行.
出力 書く: b, 改行.

