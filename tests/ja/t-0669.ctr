# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := 金庫 
	パスワードハッシュ: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := 金庫 
	パスワードハッシュ: hash 検証: a1.
	# fail 
>> b := 金庫
	パスワードハッシュ: hash 検証: a2.
	# ok!

出力 書く: a, 改行.
出力 書く: b, 改行.

