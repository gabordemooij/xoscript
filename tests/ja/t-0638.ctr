
Server init.
>> rq := HTTP-リクエスト 新規.
出力 書く: ['HTTP-GET d[]=']  + ( rq get-リスト: ['d[]'] ), 改行. # GET
出力 書く: ['HTTP-GET f[]=']  + ( rq get-リスト: ['f[]'] ), 改行. # GET
出力 書く: ['HTTP-POST e[]='] + ( rq post-リスト: ['e[]'] ), 改行. # GET
出力 書く: ['HTTP-POST c=']   + ( rq post: ['c'] ), 改行. # GET
出力 書く: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), 改行. # GET
