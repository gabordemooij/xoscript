# デコードすると長すぎる金庫の鍵や署名でスタックがあふれてはならない
Server init.

>> 鍵一覧 := 金庫 鍵生成.
>> sk := 鍵一覧 最初.
>> pk := 鍵一覧 最後.
>> sig := 金庫 署名: ['abc'] 鍵: sk.

# パディングなしの 88 文字は 66 バイトにデコードされる
>> 長文 := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# パディングなしの 44 文字は 33 バイトにデコードされる
>> 短文 := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ 金庫 署名: ['abc'] 鍵: 長文. } 例外時: { :e
	出力 書く: e, 改行.
}, 開始.

{ 金庫 確認: ['abc'] 署名: 長文 鍵: pk. } 例外時: { :e
	出力 書く: e, 改行.
}, 開始.

{ 金庫 確認: ['abc'] 署名: sig 鍵: 短文. } 例外時: { :e
	出力 書く: e, 改行.
}, 開始.
