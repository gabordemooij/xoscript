>> map1 := 辞書 新規.
>> key1 := リスト 新規.
>> key2 := リスト 新規.

map1
	格納: ['hello'] 場所: key1,
	格納: ['world'] 場所: key2.


出力
	書く: ['Map #1 contains: '] + (map1 位置で: key1),
	書く: [' and '] + (map1 位置で: key2), 改行.

>> KeyeableArray := リスト 新規.
KeyeableArray 受信時: ['toString'] 実行: { <- (自身 個数) toString.
}.

>> map2 := 辞書 新規.
key1 := KeyeableArray 新規.
key2 := KeyeableArray 新規.

key1 末尾に追加: 1.

map2
	格納: ['hello'] 場所: key1,
	格納: ['world'] 場所: key2.

出力
	書く: ['Map #2 contains: '] + (map2 位置で: key1),
	書く: [' and '] + (map2 位置で: key2), 改行.
