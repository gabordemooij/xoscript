>> 対応1 := 辞書 新規.
>> キー1 := リスト 新規.
>> キー2 := リスト 新規.

対応1
	格納: ['hello'] 場所: キー1,
	格納: ['world'] 場所: キー2.


出力
	書く: ['Map #1 contains: '] + (対応1 位置で: キー1),
	書く: [' と '] + (対応1 位置で: キー2), 改行.

>> キー付き配列 := リスト 新規.
キー付き配列 受信時: ['文字列へ'] 実行: { <- (自身 個数) 文字列へ.
}.

>> map2 := 辞書 新規.
キー1 := キー付き配列 新規.
キー2 := キー付き配列 新規.

キー1 末尾に追加: 1.

map2
	格納: ['hello'] 場所: キー1,
	格納: ['world'] 場所: キー2.

出力
	書く: ['Map #2 contains: '] + (map2 位置で: キー1),
	書く: [' と '] + (map2 位置で: キー2), 改行.
