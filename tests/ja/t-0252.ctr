#Linux
>> clock := 時点 新規.
clock タイムゾーン: ['UTC-1'].
clock 年値: 1981, 月値: 1, 日値: 5,
      時値: 13, 分値: 15, 秒値: 13.

出力 書く: clock, 改行.
clock タイムゾーン: ['UTC+0'].

出力 書く: (
	(clock 年値 素の値) + ['-'] + (clock 月値) + ['-'] + (clock 日値) + [' '] +
	(clock 時値) + [':'] + (clock 分値) + [':'] + (clock 秒値) + [' '] +
	['W'] + (clock 週番号) + (clock タイムゾーン)
), 改行.


clock タイムゾーン: ['UTC-1'].
出力 書く: (
	(clock 年値 素の値) + ['-'] + (clock 月値) + ['-'] + (clock 日値) + [' '] +
	(clock 時値) + [':'] + (clock 分値) + [':'] + (clock 秒値) + [' '] +
	['W'] + (clock 週番号) + (clock タイムゾーン)
), 改行.
