# 型キャスト / 変換 / バインドのテスト
プログラム メモリ管理: 4.
Server init.

>> カウンター := 0.
>> db := Maria-DB 新規 ホスト: ['localhost'],
	ユーザー名: ['xo'], パスワード: ['pass123'], データベース名: ['xobase'], 接続.

>> 二桁書式 := 書式 新規: ['%02d'].

# 日時
{
	>> 年値     := 数値 範囲: 1995 から: 2050, 文字列化.
	>> 月値    := 二桁書式 整数に適用: (数値 範囲: 1 から: 12), 文字列化.
	>> 日値      := 二桁書式 整数に適用: (数値 範囲: 1 から: 28), 文字列化.
	>> 時値     := 二桁書式 整数に適用: (数値 範囲: 1 から: 23), 文字列化.
	>> 分値   := 二桁書式 整数に適用: (数値 範囲: 1 から: 59), 文字列化.
	>> 秒値   := 二桁書式 整数に適用: (数値 範囲: 1 から: 59), 文字列化.
	>> 日時 := ['YYYY-MM-DD HH:II:SS'].	
	日時
		YYYY: 年値,
		MM: 月値,
		DD: 日値,
		HH: 時値,
		II: 分値,
		SS: 秒値.
	>> 検索パラメータ :=
	db クエリ: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: 日時),
	取得: { :行
		(行 mydatetime = 日時) 偽なら: {
			このタスク エラー: (
				['期待値: <expected> だが結果: <observation>']
				<expected>: 日時,
				<observation>: 行 mydatetime
			).
		}.
	
	}.
	カウンター 加算: 1.
} * 100.

# 日付
{
	>> 年値     := 数値 範囲: 1995 から: 2050, 文字列化.
	>> 月値    := 二桁書式 整数に適用: (数値 範囲: 1 から: 12), 文字列化.
	>> 日値      := 二桁書式 整数に適用: (数値 範囲: 1 から: 28), 文字列化.
	>> 日付     := ['YYYY-MM-DD'].
	日付
		YYYY: 年値,
		MM: 月値,
		DD: 日値.
	>> 検索パラメータ :=
	db クエリ: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: 日付),
	取得: { :行
		(行 mydate = 日付) 偽なら: {
			このタスク エラー: (
				['期待値: <expected> だが結果: <observation>']
				<expected>: 日付,
				<observation>: 行 mydate
			).
		}.
	}.
	カウンター 加算: 1.
} * 100.


# 時刻
{
	>> 時値     := 二桁書式 整数に適用: (数値 範囲: 1 から: 23), 文字列化.
	>> 分値   := 二桁書式 整数に適用: (数値 範囲: 1 から: 59), 文字列化.
	>> 秒値   := 二桁書式 整数に適用: (数値 範囲: 1 から: 59), 文字列化.
	>> 時刻 := ['HH:II:SS'].
	時刻
		HH: 時値,
		II: 分値,
		SS: 秒値.
	>> 検索パラメータ :=
	db クエリ: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: 時刻),
	取得: { :行
		(行 mytime = 時刻) 偽なら: {
			このタスク エラー: (
				['期待値: <expected> だが結果: <observation>']
				<expected>: 日時,
				<observation>: 行 mytime
			).
		}.
	}.
	カウンター 加算: 1.
} * 100.


# 文字列 (varchar/text)
>> str1 := リスト 新規 埋める: 100000 値: ['x'], 結合: [''].
{
	>> str2 := 金庫 トークン: 40.
	>> 検索パラメータ :=
	db クエリ: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	取得: { :行
		(行 str1 = str1 かつ: 行 str2 = str2) 偽なら: {
			このタスク エラー: (
				['期待値: <expected> だが結果: <observation>']
				<expected>: 日時,
				<observation>: 行 mytime
			).
		}.
	}.
	カウンター 加算: 1.
} * 100.


# 数値
{
	>> n1  := 数値 範囲: 1 から: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 文字列から: ['9223372036854775807'] ) -
		( Int64 文字列から: ['99999'] ) +
		( Int64 文字列から: n1 文字列化 )
	).
	>> 検索パラメータ :=
	db クエリ: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	取得: { :行
		(行 n1 = n1) 偽なら: {
			このタスク エラー: (
				['期待値: <expected> だが結果: <observation>']
				<expected>: n1,
				<observation>: 行 n1
			).
		}.
		(行 n2 = n2) 偽なら: {
			このタスク エラー: (
				['期待値: <expected> だが結果: <observation>']
				<expected>: n1,
				<observation>: 行 n2
			).
		}.
		(行 n3 = n2 四捨五入) 偽なら: {
			このタスク エラー: (
				['期待値: <expected> だが結果: <observation>']
				<expected>: n1,
				<observation>: 行 n3
			).
		}.
		(行 big = big) 偽なら: {
			このタスク エラー: (
				['期待値: <expected> だが結果: <observation>']
				<expected>: big,
				<observation>: 行 big
			).
		}.
		
	}.
	カウンター 加算: 1.
} * 100.


出力 書く: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: カウンター
), 改行.