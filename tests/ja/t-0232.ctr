>> Slurp := オブジェクト 新規.

Slurp 受信時: ['新規'] 実行: {
	自分の str := [''].
}.

Slurp 受信時: ['応答:'] 実行: { :blah
		(自分の str = ['']) 真なら: {
			自分の str 末尾に追加: blah.
		}, さもなければ: {
			自分の str 末尾に追加: [' '].
			自分の str 末尾に追加: blah.
		}.
}.

Slurp 受信時: ['応答:かつ:'] 実行: { :blah :blahah
		(blah 長さ > 1) 真なら: {
			自分の str 末尾に追加: (blah 開始: 0 長さ: (blah 長さ - 1)).
		}, さもなければ: {
			自分の str 末尾に追加: blah.
		}.
		自分の str 末尾に追加: [' '].
		自分の str 末尾に追加: blahah.
}.

Slurp 受信時: ['入手する'] 実行: {
	>> バッファ := 自分の str.
	自分の str := ['']. <- バッファ.
}.


>> x := Slurp 新規.
x + 3.
出力 書く: (x 入手する), 改行.
x echo: ['ハローワールド'].
出力 書く: (x 入手する), 改行.
x tellme: 123 and: 987.
出力 書く: (x 入手する), 改行.
