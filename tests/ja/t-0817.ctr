# a value ending in the first part of an opening quote must survive serialization
>> 値一覧 := リスト 新規
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

値一覧 各要素: { :i :value
	>> d := 辞書 新規.
	d 格納: value 場所: ['k'].
	d 格納: ['second'] 場所: ['j'].
	>> r := d コード オブジェクト化.
	出力 書く: r 個数, 改行.
	出力 書く: ( (r 位置で: ['k']) = value ), 改行.
}.
