>> usedMemory5 := (プログラム メモリ ? 0).




(usedMemory1 = usedMemory2 = usedMemory3 = usedMemory4 = usedMemory5) 真なら: { 
	出力 書く: ['Memory usage remains stable.'], 改行.
}, さもなければ: {
	出力 書く: ['Used memory not stable.'], 改行.
}.
