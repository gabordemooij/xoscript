>> usedMemory3 := (プログラム メモリ ? 0).




x := 3.
y := ['Hello'].
q := { ['']. }.
p := 真.
a := リスト ← 1 ; 2 ; 3 ; 5.
c := オブジェクト 新規.
c 受信時: ['greet:'] 実行: { 出力 書く: ['greet!']. }.
c := オブジェクト 新規.
c 受信時: ['greet:'] 実行: { 出力 書く: ['a different greet!'], 改行. }.


プログラム 掃除.
>> usedMemory4 := (プログラム メモリ ? 0).





x := 4.
y := ['Hello'].
q := { ['']. }.
p := 真.
