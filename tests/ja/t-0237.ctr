
文字列 受信時: ['evaluate'] 実行: {
	>> コード := ファイル 新規: ['/tmp/eval.ctr'].
	コード 書く: (自身 文字列化 + ['.']).
	プログラム 使用: ['/tmp/eval.ctr'].
}.

>> map :=
	(辞書 新規)
	格納: ['Hi There'] 場所: ['two'],
	格納: (リスト ← ['hello'] ; ['world'] ; (リスト ← 1 ; 2; 9) ; 偽) 場所: ['one'],
	格納: ( (辞書 新規) 格納: ['wrrld'] 場所: ['misspelled'] ) 場所: ['three'],
	格納: (リスト ← ((辞書 新規) 格納: ['treasure'] 場所: ['hidden']) ; 2) 場所: ['four']. 
>> str := map 文字列化.
>> map2 := 無.
(['map2 := '] + str ) evaluate.
出力 書く: map2 ? ['one'] ? 0.
出力 書く: map2 ? ['one'] ? 1.
出力 書く: map2 ? ['four'] ? 0 ? ['hidden'].
出力 書く: map2 ? ['one'] ? 2 ? 2.
