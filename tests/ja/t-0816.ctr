# 書式は値の型に合っていなければならない、型はクライアントから来ることもある
>> 試行 := { :書式値 :value
	{ 出力 書く: ( (書式 新規: 書式値) 適用: value ), 改行. } 例外時: { :e 出力 書く: e, 改行. }, 開始.
}.
>> 整数を試す := { :書式値 :value
	{ 出力 書く: ( (書式 新規: 書式値) 整数に適用: value ), 改行. } 例外時: { :e 出力 書く: e, 改行. }, 開始.
}.

# 合う
試行 適用: ['|%s|'] かつ: ['text'].
試行 適用: ['%06.2f'] かつ: 5.5.
試行 適用: ['100%% %s'] かつ: ['もちろん'].
整数を試す 適用: ['%03d'] かつ: 7.
整数を試す 適用: ['%x'] かつ: 255.
試行 適用: ['%d'] かつ: (Int64 新規 文字列から: ['12']).
試行 適用: ['%lld'] かつ: (Int64 新規 文字列から: ['12']).
試行 適用: ['%.1lf'] かつ: 5.5.
整数を試す 適用: ['%hd'] かつ: 7.

# 合わない
試行 適用: ['%s'] かつ: 12345.
試行 適用: ['%d'] かつ: 12345.
試行 適用: ['%f'] かつ: ['text'].
整数を試す 適用: ['%d'] かつ: ['text'].
整数を試す 適用: ['%s'] かつ: 5.
試行 適用: ['%s %s'] かつ: ['text'].
試行 適用: ['%n'] かつ: ['text'].
試行 適用: ['%*s'] かつ: ['text'].
試行 適用: ['%'] かつ: ['text'].

# 長さ修飾子が合わない
試行 適用: ['%ls'] かつ: ['text'].
試行 適用: ['%Lf'] かつ: 5.5.
整数を試す 適用: ['%ld'] かつ: 7.
整数を試す 適用: ['%lld'] かつ: 7.
試行 適用: ['%Ld'] かつ: (Int64 新規 文字列から: ['12']).

# printf に合わない幅はクラッシュではなくエラーにならなければならない
試行 適用: ['%99999999999s'] かつ: ['text'].
