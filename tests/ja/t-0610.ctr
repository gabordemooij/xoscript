
>> Rectangle := オブジェクト 新規.

Rectangle 受信時: ['area'] 実行: { <- 自分の 長さ * 自分の width.
}.

Rectangle 受信時: ['length:'] 実行: { :長さ
	自分の 長さ := 長さ.
}.

Rectangle 受信時: ['width:'] 実行: { :width
	自分の width := width.
}.

Rectangle 受信時: ['新規'] 実行: {
	# this will not result into an infinite loop
	>> rectangle := 自身 新規.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle 新規.
出力 書く: a area, 改行. #0

>> b := Rectangle 新規 length: 2, width: 3.
出力 書く: b area, 改行. #6

