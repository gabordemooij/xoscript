
>> 長方形型 := オブジェクト 新規.

長方形型 受信時: ['面積'] 実行: {
	<- 自分の 長さ * 自分の 幅.
}.

長方形型 受信時: ['length:'] 実行: { :長さ
	自分の 長さ := 長さ.
}.

長方形型 受信時: ['width:'] 実行: { :幅
	自分の 幅 := 幅.
}.

長方形型 受信時: ['新規'] 実行: {
	# これは無限ループにはなりません
	>> 長方形 := 自身 新規.
	長方形 length: 0, width: 0.
	<- 長方形.
}.

>> a := 長方形型 新規.
出力 書く: a 面積, 改行. #0

>> b := 長方形型 新規 length: 2, width: 3.
出力 書く: b 面積, 改行. #6

