# compliance test

# use international numbers

出力 書く: ['1000 -> '].
出力 書く: 1000, 改行. #1000

出力 書く: ['1.5 -> '].
出力 書く: 1.5, 改行.  #1.5

出力 書く: ['1001.5 -> '].
出力 書く: 1.5 + 1000, 改行. #1001.5

# use 0-indexed arrays
>> x := リスト 新規 ; 1 ; 2 ; 3.
>> y := リスト 新規 ; ['a'] ; ['b'] ; ['c'].

出力 書く: ['1 -> '].
出力 書く: x ? 0, 改行. #1

出力 書く: ['1 -> '].
出力 書く: (x 位置で: 0), 改行. #1

出力 書く: ['1 -> '].
出力 書く: x 最初, 改行. #1

出力 書く: ['3 -> '].
出力 書く: x 最後, 改行. #3

出力 書く: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
出力 書く: (x キーで: y), 改行.

出力 書く: ['1 -> '].
出力 書く: (x 開始: 0 長さ: 1) 最初, 改行. #1

出力 書く: ['0 -> '].
出力 書く: (x 検索: 1), 改行. #0

x 格納: 9 場所: 0.

出力 書く: ['9 -> '].
出力 書く: (x 位置で: 0), 改行. #9

x 先頭に追加: 8.
出力 書く: ['8 -> '].
出力 書く: (x 位置で: 0), 改行. #9


x 末尾に追加: 10.
出力 書く: ['10 -> '].
出力 書く: (x 位置で: 4), 改行. #10








