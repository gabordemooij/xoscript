# recursive interpolation not allowed

出力 書く: 
['recursive string interolation enabled: '] + (
	プログラム 機能: 
	['RECURSIVE_STRINTPOL']
), 改行.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

出力 書く: a, 改行.


プログラム 機能: ['RECURSIVE_STRINTPOL'] 有効: 真.

出力 書く: 
['recursive string interpolation enabled: '] + (
	プログラム 機能: 
	['RECURSIVE_STRINTPOL']
), 改行.

>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

出力 書く: a, 改行.

プログラム 機能: ['RECURSIVE_STRINTPOL'] 有効: 偽.

出力 書く: 
['recursive string interpolation enabled: '] + (
	プログラム 機能: 
	['RECURSIVE_STRINTPOL']
), 改行.

>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

出力 書く: a, 改行.
