# test list operations


>> cakes := リスト ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes 置換: 1 長さ: 2 新: ( リスト ← ['cinnamon'] ; ['pineapple'] ).
出力 書く: (buy 結合: [',']), 改行.


>> buy := cakes 置換: 1 長さ: 12 新: ( リスト ← ['cinnamon'] ; ['pineapple'] ).
出力 書く: (buy 結合: [',']), 改行.


>> buy := cakes 置換: 2 長さ: 10 新: ( リスト 新規 ).
出力 書く: (buy 結合: [',']), 改行.


>> buy := cakes 置換: 0 長さ: 1 新: ( リスト 新規 ).
出力 書く: (buy 結合: [',']), 改行.


>> buy := cakes 置換: ['0'] 長さ: ['1'] 新: ['x'].
出力 書く: (buy 結合: [',']), 改行.
