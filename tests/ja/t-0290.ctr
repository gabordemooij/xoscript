# リスト操作のテスト


>> ケーキ := リスト ←
	['apple'] ;
	['ベリー'] ;
	['チョコ'] ;
	['チーズ'].


>> 購入 := ケーキ 置換: 1 長さ: 2 新: ( リスト ← ['シナモン'] ; ['パイナップル'] ).
出力 書く: (購入 結合: [',']), 改行.


>> 購入 := ケーキ 置換: 1 長さ: 12 新: ( リスト ← ['シナモン'] ; ['パイナップル'] ).
出力 書く: (購入 結合: [',']), 改行.


>> 購入 := ケーキ 置換: 2 長さ: 10 新: ( リスト 新規 ).
出力 書く: (購入 結合: [',']), 改行.


>> 購入 := ケーキ 置換: 0 長さ: 1 新: ( リスト 新規 ).
出力 書く: (購入 結合: [',']), 改行.


>> 購入 := ケーキ 置換: ['0'] 長さ: ['1'] 新: ['x'].
出力 書く: (購入 結合: [',']), 改行.
