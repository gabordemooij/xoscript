

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

プログラム メモリ管理: 0.

数値 受信時: ['addNum:'] 実行: { :x
	自身 加算: x.
}.

数値 受信時: ['subtractNum:'] 実行: { :x
	自身 減算: x.
}.

数値 受信時: ['multiplyBy:'] 実行: { :x
	自身 乗算: x.
}.

数値 受信時: ['divideBy:'] 実行: { :x
	自身 除算: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 累乗: 8).  
a := a + (2 累乗: -1). 
a := a + (49 平方根).   
a addNum: ((リスト ← 0 ; 1) 最大).          
a addNum: ((リスト ← 2 ; 3) 最小).
出力 書く: a.

プログラム 掃除.

usedMemory1 := (プログラム メモリ ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 累乗: 8).  
a := a + (2 累乗: -1). 
a := a + (49 平方根).   
a addNum: ((リスト ← 0 ; 1) 最大).          
a addNum: ((リスト ← 2 ; 3) 最小).
出力 書く: a.

プログラム 掃除.
usedMemory2 := (プログラム メモリ ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 累乗: 8).  
a := a + (2 累乗: -1). 
a := a + (49 平方根).   
a addNum: ((リスト ← 0 ; 1) 最大).          
a addNum: ((リスト ← 2 ; 3) 最小).
出力 書く: a.

プログラム 掃除.
usedMemory3 := (プログラム メモリ ? 0).



( usedMemory1 = usedMemory2 かつ: usedMemory1 = usedMemory3, かつ: usedMemory2 = usedMemory3 ) 真なら: {
	出力 書く: ['No memory leaks here'].
}, 偽なら: {
	出力 書く: ['Leaking memory...'].
}.
