Server init.

>> DB := Maria-DB 新規 ホスト: ['localhost'],
	ユーザー名: ['xo'],
	パスワード: ['pass123'],
	データベース名: ['xobase'],
	接続.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB クエリ: SQL.

# now you don't have to set DB
query2 取得: { :row
	出力 書く: row world, 改行.
}.
