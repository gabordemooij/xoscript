['千の位と小数'].

>> x := 100000000.5.
>> y := 100000000.5.

出力 書く: (x + y), 改行.

>> x := 10040.07.
>> y := 10305.60.

出力 書く: (x + y), 改行.

['小数'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

出力 書く: (x + y + z), 改行.

['変だが有効'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

出力 書く: (x + y + z), 改行.

>> q := 0.1.2.

出力 書く: (q), 改行.

>> q := 012.

出力 書く: (q), 改行.
