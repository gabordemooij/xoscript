Server init.

出力 書く: (
	パターン 新規: ['^\\w+$'],
	一致: ['test@example.com'] 
), 改行. # 0 match, fails on @ and .

出力 書く: (
	パターン 新規: ['^[^@]+@[^\.]+\.\\w+$'],
	一致: ['test@example.com'] 
), 改行. # 1 match

出力 書く: (
	パターン 新規: ['[^@]+@[^\.]+\.\\w+'],
	一致: ['test@example.com'] 
), 改行. # 1 match

出力 書く: (
	パターン 新規: ['([^@]+)@([^\.]+)\.\\w+'],
	一致: ['test@example.com'] 
), 改行. # 1 match, groups dont matter

出力 書く: (
	パターン 新規: ['[a-z]'],
	一致: ['test@example.com'] 
), 改行. # 14 matches

出力 書く: (
	パターン 新規: ['.*'],
	一致: ['test@example.com'] 
), 改行. # 1 match (all)

出力 書く: (
	パターン 新規: ['(.*)'],
	一致: ['test@example.com'] 
), 改行. # 1 match (all)

出力 書く: (
	パターン 新規: ['\\s*[^@]+@[^\.]+\.\\w+'],
	一致: ['test@example.com'] 
), 改行. # 1 match, prefix space optional, gets ignored