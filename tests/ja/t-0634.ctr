# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := プログラム shell-escape: ['abc'].
出力 書く: c, 改行.
出力 書く: ( プログラム システム: ['echo '] + c ), 改行.

c := プログラム shell-escape: ['a'b'c'].
出力 書く: c, 改行.
出力 書く: ( プログラム システム: ['echo '] + c ), 改行.

c := プログラム shell-escape: ['a\'c'].
出力 書く: c, 改行.
出力 書く: ( プログラム システム: ['echo '] + c ), 改行.