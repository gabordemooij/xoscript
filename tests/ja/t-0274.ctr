

リスト 受信時: ['column:'] 実行: { :列
	>> 結果 := リスト 新規.
	自身 各要素: { :添字 :行
		行 各要素: { :添字 :セル
			(添字 = 列) 真なら: { 結果 末尾に追加: セル. }.
		}.
	}. <- 結果.
}.


>> a := リスト ←
	(リスト ← 1 ; 2 ; 3) ;
	(リスト ← 4 ; 5 ; 6) ;
	(リスト ← 7 ; 8 ; 9).

>> b := a column: 1.
出力 書く: b, 改行.

b := a column: 20.
出力 書く: b, 改行.

b := a column: -100.
出力 書く: b, 改行.
