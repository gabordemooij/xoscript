

リスト 受信時: ['column:'] 実行: { :column
	>> result := リスト 新規.
	自身 各要素: { :index :row
		row 各要素: { :index :cell
			(index = column) 真なら: { result 末尾に追加: cell. }.
		}.
	}. <- result.
}.


>> a := リスト ←
	(リスト ← 1 ; 2 ; 3) ;
	(リスト ← 4 ; 5 ; 6) ;
	(リスト ← 7 ; 8 ; 9).

>> b := a column: 1.
出力 書く: b, 改行.

b := a column: 20.
出力 書く: b, 改行.

b := a column: -100.
出力 書く: b, 改行.
