
出力 書く: ['Break for-loop, 0-4.'], 改行.
{ :i
	出力 書く: ['iteration #'] + i, 改行.
	(i = 4) 中断.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

出力 書く: ['Break while-true loop, 0-4.'], 改行.
{
	出力 書く: ['iteration #'] + x, 改行.
	x 加算: 1.
	((x < 5) 否定) 中断.
} 繰り返す間: xIsLessThan10.

出力 書く: ['Break while-false loop, 5,4.'], 改行.
{
	出力 書く: ['iteration #'] + x, 改行.
	x 減算: 1.
	(x = 3) 中断.
} 繰り返す間: { <- (x > 0). }.

出力 書く: ['Break times loop, 1-4.'], 改行.
{ :i
	出力 書く: ['iteration #'] + i, 改行.
	(i = 4) 中断.
} × 5.

出力 書く: ['Break block, dont print line.'], 改行.
{ 真 中断. 出力 書く: ['dont write this!'], 改行. } 開始.

出力 書く: ['Break block, dont fire catch...'], 改行.
{ 真 中断. 出力 書く: ['dont write this!'], 改行. } 例外時: { 出力 書く: ['Dont catch this!']. }, 開始.

出力 書く: ['Test Array each-loop: 0,1'], 改行.
(リスト ← 1 ; 2 ; 3) 写像: { :i
	出力 書く: ['iteration #'] + i, 改行.
	(i = 1) 中断.
}.

出力 書く: ['Test Map each-loop: c only'], 改行.
>> m := 辞書 新規.
m 格納: ['first'] 場所: ['a'], 格納: ['second'] 場所: ['b'], 格納: ['third'] 場所: ['c'].
m 各要素: { :k :v
	出力 書く: ['iteration'] + v + k, 改行.
	真 中断.
}.

