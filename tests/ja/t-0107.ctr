
出力 書く: ['for ループを中断、0-4。'], 改行.
{ :i
	出力 書く: ['iteration #'] + i, 改行.
	(i = 4) 中断.
} × 10.

>> x := 0.
>> xは10未満 := { <- ( x < 10 ). }.

出力 書く: ['while-true ループを中断、0-4。'], 改行.
{
	出力 書く: ['iteration #'] + x, 改行.
	x 加算: 1.
	((x < 5) 否定) 中断.
} 繰り返す間: xは10未満.

出力 書く: ['while-false ループを中断、5,4。'], 改行.
{
	出力 書く: ['iteration #'] + x, 改行.
	x 減算: 1.
	(x = 3) 中断.
} 繰り返す間: { <- (x > 0). }.

出力 書く: ['times ループを中断、1-4。'], 改行.
{ :i
	出力 書く: ['iteration #'] + i, 改行.
	(i = 4) 中断.
} × 5.

出力 書く: ['ブロックを中断、行は表示しない。'], 改行.
{ 真 中断. 出力 書く: ['これは書かない!'], 改行. } 開始.

出力 書く: ['ブロックを中断、catch は発火しない...'], 改行.
{ 真 中断. 出力 書く: ['これは書かない!'], 改行. } 例外時: { 出力 書く: ['これは捕捉しない!']. }, 開始.

出力 書く: ['配列の each ループのテスト: 0,1'], 改行.
(リスト ← 1 ; 2 ; 3) 写像: { :i
	出力 書く: ['iteration #'] + i, 改行.
	(i = 1) 中断.
}.

出力 書く: ['マップの each ループのテスト: c のみ'], 改行.
>> m := 辞書 新規.
m 格納: ['first'] 場所: ['a'], 格納: ['second'] 場所: ['b'], 格納: ['三番目'] 場所: ['c'].
m 各要素: { :k :v
	出力 書く: ['iteration'] + v + k, 改行.
	真 中断.
}.

