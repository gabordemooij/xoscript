>> a := 3.
>> b := a 複製.
a 減算: 1.
出力 書く: [' a = '] + a.
出力 書く: [' b = '] + b.
a := 3.
b := a + 4.
出力 書く: [' a = '] + a.
出力 書く: [' b = '] + b.
>> x := 3.
>> y := x 複製.
x 加算: 10.
y 減算: 1.
出力 書く: [' x = '] + x.
出力 書く: [' y = '] + y.
>> q := オブジェクト 新規.
q 受信時: ['setProperty:'] 実行: { :x
	自分の 属性 := x.
}.
q 受信時: ['属性を取得'] 実行: { <- 自分の 属性.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
出力 書く: [' p = '] + (p 属性を取得).
