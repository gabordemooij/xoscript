数値 受信時: ['roman'] 実行: {
	>> 数値化 := 自身 複製.
	>> roman := [''].
	{
		{
			(数値化 ≥ 1000) 真なら: {
				roman 末尾に追加: ['Ⅿ'].
				数値化 減算: 1000.
			}, 中断.
		
			(数値化 ≥ 500) 真なら: {
				roman 末尾に追加: ['Ⅾ'].
				数値化 減算: 500.
			}, 中断.
		
			(数値化 ≥ 100) 真なら: {
				roman 末尾に追加: ['Ⅽ'].
				数値化 減算: 100.
			}, 中断.
		
			(数値化 ≥ 50) 真なら: {
				roman 末尾に追加: ['Ⅼ'].
				数値化 減算: 50.
			}, 中断.
		
			(数値化 ≥ 50) 真なら: {
				roman 末尾に追加: ['Ⅼ'].
				数値化 減算: 50.
			}, 中断.
		
			(数値化 ≥ 10) 真なら: {
				roman 末尾に追加: ['Ⅹ'].
				数値化 減算: 10.
			}, 中断.
			
			(数値化 ≥ 9) 真なら: {
				roman 末尾に追加: ['Ⅸ'].
				数値化 減算: 9.
			}, 中断.
			
			(数値化 ≥ 5) 真なら: {
				roman 末尾に追加: ['Ⅴ'].
				数値化 減算: 5.
			}, 中断.
			
			(数値化 ≥ 4) 真なら: {
				roman 末尾に追加: ['Ⅳ'].
				数値化 減算: 4.
			}, 中断.
			
			(数値化 ≥ 1) 真なら: {
				roman 末尾に追加: ['Ⅰ'].
				数値化 減算: 1.
			}, 中断.
		} 手続き.
	} 繰り返す間: { <- 数値化 > 0. }. <- roman.
}.

