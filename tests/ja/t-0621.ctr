>> 語句一覧 := リスト 新規
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> メッセージ := ['Phrase: ~decoded base64: ~encoded'].
	
語句一覧 各要素: { :_ :語句 
	>> e := Server base64-エンコード: 語句.
	>> d := Server base64-デコード: e.
	出力 書く: (
		メッセージ 複製 ~encoded: e, ~decoded: d
	), 改行.
}.
