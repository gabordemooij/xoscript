>> phrases := リスト 新規
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases 各要素: { :_ :phrase 
	>> e := Server base64-エンコード: phrase.
	>> d := Server base64-デコード: e.
	出力 書く: (
		message 複製 ~encoded: e, ~decoded: d
	), 改行.
}.
