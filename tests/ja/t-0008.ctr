>> Greeter := オブジェクト 新規.
Greeter 受信時: ['make'] 実行: {
	>> greeter := オブジェクト 新規.
	greeter 受信時: ['name:'] 実行: { :名前
		出力 書く: ['setting a name'].
		自分の myName := 名前.
	}.
	greeter 受信時: ['greet'] 実行: {
		出力 書く: ['Hello'].
		出力 書く: 自分の myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
