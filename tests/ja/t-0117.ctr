>> t := 真.
(t = 真) 真なら: { 出力 書く: ['T']. }.
(t = 偽) 真なら: { 出力 書く: ['F']. }.
出力 書く: ['|'].
>> t := 偽.
(t = 真) 真なら: { 出力 書く: ['T']. }.
(t = 偽) 真なら: { 出力 書く: ['F']. }.
出力 書く: ['|'].
>> f := 真.
(t = 真 かつ: f = 偽) 真なら: { 出力 書く: ['T']. }.
(t = 偽 かつ: f = 真) 真なら: { 出力 書く: ['F']. }.
出力 書く: ['|'].
>> n := 無.
(n 無か?) 真なら: { 出力 書く: ['T']. }.
(n 無か?) 偽なら: { 出力 書く: ['F']. }.
出力 書く: ['|'].
(f Boolean?) 真なら: { 出力 書く: ['T']. }.
(f Boolean?) 偽なら: { 出力 書く: ['F']. }.



