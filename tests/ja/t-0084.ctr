>> makeAdder := { :x
	>> f := { :y <- (自分の x + y). } 設定: ['x'] 値: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i 自分の q 格納: (自分の f 適用: (自分の q ? i)) 場所: i. } 
	設定: ['q'] 値: array,
	設定: ['f'] 値: func.
	{ :i mapping 適用: i. } × (array 個数).
}.

>> a := リスト ← 1; 2; 3.
mapper 適用: a かつ: (makeAdder 適用: 100).
出力 書く: (a 番目: 0), 改行.
出力 書く: (a ? 1), 改行.
出力 書く: (a ? 2), 改行.
