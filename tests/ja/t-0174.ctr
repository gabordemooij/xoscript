( usedMemory1 = usedMemory2 かつ: usedMemory1 = usedMemory3, かつ: usedMemory2 = usedMemory3 ) 真なら: {
	出力 書く: ['No memory leaks here'].
}, 偽なら: {
	出力 書く: ['Leaking memory...'].
}.
