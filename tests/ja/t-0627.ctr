

# create a 64-bit integer for exact calculations
>> a := Int64 文字列から: ['123'].

# to string
出力 書く: a, 改行.

# divide
出力 書く: a / (Int64 文字列から: ['3']), 改行.

# multiply
出力 書く: a * (Int64 文字列から: ['2']), 改行.

# add
出力 書く: a + (Int64 文字列から: ['1']), 改行.

# subtract
出力 書く: a - (Int64 文字列から: ['2']), 改行.

# compare
出力 書く: ( a =   (Int64 文字列から: ['123'])), 改行.
出力 書く: ( a !=: (Int64 文字列から: ['124'])), 改行.
出力 書く: ( a <   (Int64 文字列から: ['124'])), 改行.
出力 書く: ( a >   (Int64 文字列から: ['122'])), 改行.
出力 書く: ( a >=: (Int64 文字列から: ['123'])), 改行.
出力 書く: ( a <=: (Int64 文字列から: ['123'])), 改行.





	