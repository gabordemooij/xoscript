>> Greeter := オブジェクト 新規.
Greeter 受信時: ['make'] 実行: {
	>> gr := オブジェクト 新規.
	gr 受信時: ['setName:'] 実行: { :aname
		自分の 名前 := aname.
	}.
	gr 受信時: ['greet'] 実行: {
		出力 書く: 自分の 名前.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a 新規.
c setName: ['THREE'].
c greet.
>> d := a 新規.
d setName: ['FOUR'].
d greet.
c greet.
