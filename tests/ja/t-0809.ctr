# backslashes must survive code serialization, strings must not end early
>> 値一覧 := リスト 新規
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

値一覧 各要素: { :i :value
	>> d := 辞書 新規.
	d 格納: value 場所: ['k'].
	>> r := d コード オブジェクト化.
	出力 書く: r 個数, 改行.
	出力 書く: ( (r 位置で: ['k']) = value ), 改行.
}.
