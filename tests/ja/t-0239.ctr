リスト 受信時: ['sum'] 実行: {
	>> 合計 := 0.
	自身 各要素: { :添字 :要素
		合計 加算: 要素.
	}. <- 合計.
}.

>> a := 真.



a 受信時: ['文字列化'] 実行: {
	>> 答え := 無.
	( 自身 = 真 ) 真なら: {
		答え := ['うん'].
	}, さもなければ: {
		答え := ['ちがう'].
	}. <- 答え.
}.

a 受信時: ['数値化'] 実行: {
	>> 答え := 無.
	( 自身 = 真 ) 真なら: {
		答え := 10.
	}, さもなければ: {
		答え := 20.
	}. <- 答え.
}.

>> b := 666.

b 受信時: ['文字列化'] 実行: { <- ['悪魔'].
}.

b 受信時: ['真偽値化'] 実行: { <- 偽.
}.


出力 書く: a, 改行.  
出力 書く: (90 + a), 改行. 
出力 書く: b, 改行. 
出力 書く: (真 かつ: b), 改行.

a := リスト ← ['hello'] ; ['world'] ; 真 ; 無 ; 666. 
a := a + ( リスト ← 1 ).
出力 書く: a, 改行.
出力 書く: ((辞書 新規) 格納: 無 場所: 無), 改行.
出力 書く: a sum, 改行. 


{
	a 受信時: ['文字列化'] 実行: { <- 無. }.
	a := [''] + a.
} 例外時: { :エラー
	出力 書く: ['記録されたエラー: '] + エラー, 改行.
}, 開始.



