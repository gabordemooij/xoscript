リスト 受信時: ['sum'] 実行: {
	>> total := 0.
	自身 各要素: { :index :element
		total 加算: element.
	}. <- total.
}.

>> a := 真.



a 受信時: ['文字列化'] 実行: {
	>> answer := 無.
	( 自身 = 真 ) 真なら: {
		answer := ['Yep'].
	}, さもなければ: {
		answer := ['Nope'].
	}. <- answer.
}.

a 受信時: ['数値化'] 実行: {
	>> answer := 無.
	( 自身 = 真 ) 真なら: {
		answer := 10.
	}, さもなければ: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b 受信時: ['文字列化'] 実行: { <- ['Devil'].
}.

b 受信時: ['真偽値化'] 実行: { <- 偽.
}.


出力 書く: a, 改行.  
出力 書く: (90 + a), 改行. 
出力 書く: b, 改行. 
出力 書く: (真 かつ: b), 改行.

a := リスト ← ['hello'] ; ['world'] ; 真 ; 無 ; 666. 
a := a + ( リスト ← 1 ).
出力 書く: a, 改行.
出力 書く: ((辞書 新規) 格納: 無 場所: 無), 改行.
出力 書く: a sum, 改行. 


{
	a 受信時: ['文字列化'] 実行: { <- 無. }.
