>> a := ['hello'].
>> b := ['hello'].
>> z := a.
>> c := 無.
>> q := オブジェクト 新規.
>> p := q.
(a 同一: a) 真なら: { 出力 書く: ['Y1']. }.
(a 同一: b) 真なら: { 出力 書く: ['Y2']. }.
(a 同一: c) 真なら: { 出力 書く: ['Y3']. }.
(a 同一: z) 真なら: { 出力 書く: ['Y4']. }.
(z 同一: a) 真なら: { 出力 書く: ['Y5']. }.
(q 同一: q) 真なら: { 出力 書く: ['Y6']. }.
(p 同一: q) 真なら: { 出力 書く: ['Y7']. }.
(p 同一: a) 真なら: { 出力 書く: ['Y8']. }.
(p 同一: 無) 真なら: { 出力 書く: ['Y9']. }.
