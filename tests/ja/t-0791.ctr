Server init.

>> DB := Maria-DB 新規 ホスト: ['localhost'],
	ユーザー名: ['xo'],
	パスワード: ['pass123'],
	データベース名: ['xobase'],
	接続.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> 検索パラメータ := Maria-クエリ 新規: SQL.

# set database
検索パラメータ データベース: DB.

検索パラメータ 取得: { :row
	出力 書く: row world, 改行.
}.
