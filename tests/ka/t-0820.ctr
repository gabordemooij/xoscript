# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := შაბლონი ახალი: pattern.
	p დამთხვევა: subject გააკეთე: { :m :g
		გამოტანა დაწერე: g რაოდენობა, დაწერე: [' '], დაწერე: (g გაერთიანება: ['|']), ახალი-ხაზი. <- m.
	}.
}.
show გამოყენება-ზე: ['(a)|(b)'] და: ['b'].
show გამოყენება-ზე: ['(a)|(b)'] და: ['a'].
show გამოყენება-ზე: ['(x)?y'] და: ['y'].
show გამოყენება-ზე: ['(x)?(y)(z)?'] და: ['xy'].
