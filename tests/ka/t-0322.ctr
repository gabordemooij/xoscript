

>> Matryoshka := ობიექტი ახალი.
Matryoshka როცა: ['double:'] გააკეთე: { :secret
	საკუთარი secret := secret × 2.
}.
Matryoshka როცა: ['ახალი:'] გააკეთე: { :secret
	>> answer := არაფერი.
	>> t := (secret > 255).
	გამოტანა დაწერე: (secret + [' | '] + t), ახალი-ხაზი.
	t ჭეშმარიტი: {
		answer := secret.
	}, თორემ: {
		answer := Matryoshka რეკურსიული ახალი: (თავად double: secret).
	}. <- answer.
}.

>> x := Matryoshka ახალი: 2.
