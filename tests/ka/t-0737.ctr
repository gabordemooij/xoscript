#regex test, with positive look around
Server init.
>> subject := ['bacabcca'].
>> pattern := შაბლონი ახალი: ['(\\w{2})(?=ca)'].
>> result := pattern დამთხვევა: subject გააკეთე: { :m :x
	გამოტანა დაწერე: m, ახალი-ხაზი.
	გამოტანა დაწერე: x, ახალი-ხაზი. <- ['XXX'].
}.
გამოტანა დაწერე: result, ახალი-ხაზი.
