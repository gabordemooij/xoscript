# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := სეიფი 
	პაროლის-ჰეში: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := სეიფი 
	პაროლის-ჰეში: hash შემოწმება: a1.
	# fail 
>> b := სეიფი
	პაროლის-ჰეში: hash შემოწმება: a2.
	# ok!

გამოტანა დაწერე: a, ახალი-ხაზი.
გამოტანა დაწერე: b, ახალი-ხაზი.

