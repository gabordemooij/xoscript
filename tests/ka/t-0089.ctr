>> randomizer := { :a :b
	>> მინიმუმი := ( a < b ) ან: a ან: b.
	>> მაქსიმუმი := ( a > b ) ან: a ან: b.
	>> x := არაფერი.
	{
		x := რიცხვი შორის: a და: b.
		((x < მინიმუმი) ან: (x > მაქსიმუმი)) ჭეშმარიტი: { 
			გამოტანა დაწერე: (['Invalid value!']).
			პროგრამა დასასრული.
		}.
	} 
	× 100. <- x.
}.
