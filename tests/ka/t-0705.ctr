

>> obj := ობიექტი ახალი.

obj როცა: ['greet'] გააკეთე: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj როცა: ['task'] გააკეთე: {
	საკუთარი property := 123.
	{
		# try binds self/own to object instead of block
		გამოტანა დაწერე: თავად greet.
		გამოტანა დაწერე: საკუთარი property.
		1 / 0.
	} დაჭერა: {
		გამოტანა დაწერე: თავად greet.
		გამოტანა დაწერე: საკუთარი property.
		გამოტანა დაწერე: ['ok'].
	}, სცადე.
}.

obj task.