Server init.

# JSON encoder only supports UTF-8, no surrogate pairs

>> dicts := სია ახალი ;
	# {"key":"normal"} normal ASCII
	( ლექსიკონი ახალი ჩასმა: ['normal'] ადგილზე: ['key'] ) ;
	# {"key":"hello world"} space character
	( ლექსიკონი ახალი ჩასმა: ['hello world'] ადგილზე: ['key'] ) ;
	# {"key":"quote: \""} double quote
	( ლექსიკონი ახალი ჩასმა: ['"'] ადგილზე: ['key'] ) ;
	# {"key":"backslash: \\"} backslash
	( ლექსიკონი ახალი ჩასმა: ['backslash: \\'] ადგილზე: ['key'] ) ;
	# {"key":"slash: /"} slash
	( ლექსიკონი ახალი ჩასმა: ['slash: /'] ადგილზე: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( ლექსიკონი ახალი ჩასმა: ['backspace: \b'] ადგილზე: ['key'] ) ;
	# {"key":"formfeed: \f"} form-feed escape
	( ლექსიკონი ახალი ჩასმა: ['formfeed: \f'] ადგილზე: ['key'] ) ;
	# {"key":"newline: \n"} newline
	( ლექსიკონი ახალი ჩასმა: ['newline: \n'] ადგილზე: ['key'] ) ;
	( ლექსიკონი ახალი ჩასმა: ['newline: ↵'] ადგილზე: ['key'] ) ;
	( ლექსიკონი ახალი ჩასმა: ['newline: 
	'] ადგილზე: ['key'] ) ;
	# {"key":"carriage return: \r"} carriage-return
	( ლექსიკონი ახალი ჩასმა: ['carriage return: \r'] ადგილზე: ['key'] ) ;
	# {"key":"tab: \t"} tab
	( ლექსიკონი ახალი ჩასმა: ['tab \t'] ადგილზე: ['key'] ) ;
	( ლექსიკონი ახალი ჩასმა: ['tab ⇿'] ადგილზე: ['key'] ) ;
	( ლექსიკონი ახალი ჩასმა: ['tab  '] ადგილზე: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( ლექსიკონი ახალი ჩასმა: ['NUL \u0000'] ადგილზე: ['key'] ) ;
	( ლექსიკონი ახალი ჩასმა: ['NUL \0'] ადგილზე: ['key'] ) ;
	# {"key":"control: \u0001"} control character 0x01
	( ლექსიკონი ახალი ჩასმა: ['control: \u0001'] ადგილზე: ['key'] ) ;
	# {"key":"control: \u001F"} control character 0x1F
	( ლექსიკონი ახალი ჩასმა: ['control: \u001F'] ადგილზე: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-byte char
	( ლექსიკონი ახალი ჩასმა: ['unicode: é'] ადგილზე: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-byte char
	( ლექსიკონი ახალი ჩასმა: ['unicode: €'] ადგილზე: ['key'] ) ;
	# {"key":"unicode: 日本語"} multiple 3-byte UTF-8 chars
	( ლექსიკონი ახალი ჩასმა: ['unicode: 日本語'] ადგილზე: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-byte char
	( ლექსიკონი ახალი ჩასმა: ['unicode: 😀'] ადგილზე: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	( ლექსიკონი ახალი ჩასმა: ['unicode: 🧑‍💻'] ადგილზე: ['key'] ) ;
	# {"key":"combining: e\u0301"} combining accent
	( ლექსიკონი ახალი ჩასმა: ['combining: e\u0301'] ადგილზე: ['key'] ) ;
	# {"key":"escaped unicode: \u00e9"} Unicode escape BMP
	( ლექსიკონი ახალი ჩასმა: ['escaped unicode: \u00e9'] ადგილზე: ['key'] ) ;
	# {"key":"escaped unicode: \u20ac"} Unicode escape BMP
	( ლექსიკონი ახალი ჩასმა: ['escaped unicode: \u20ac'] ადგილზე: ['key'] ) ;
	# {"key":"escaped unicode: \ud83d\ude00"} UTF-16 surrogate pair
	( ლექსიკონი ახალი ჩასმა: ['escaped unicode: \ud83d\ude00'] ადგილზე: ['key'] ) ;
	# {"key":""} empty value
	( ლექსიკონი ახალი ჩასმა: [''] ადგილზე: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} special ASCII chars
	( ლექსიკონი ახალი ჩასმა: ['@ < > & = % + ? #'] ადგილზე: ['key'] ) ;
	# {"key":"single quote: '"} single quote
	( ლექსიკონი ახალი ჩასმა: ['''] ადგილზე: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} multiple JSON escapes
	( ლექსიკონი ახალი ჩასმა: ['multiple: \" \\ \n \r \t'] ადგილზე: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} longer ASCII-string
	( ლექსიკონი ახალი ჩასმა: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] ადგილზე: ['key'] ) ;
	# {"key":" value"} leading space
	( ლექსიკონი ახალი ჩასმა: [' value'] ადგილზე: ['key'] ) ;
	# {"key":"value "} trailing space
	( ლექსიკონი ახალი ჩასმა: ['value '] ადგილზე: ['key'] ) ;
	# {"key":" \t\n\r "} whitespace
	( ლექსიკონი ახალი ჩასმა: [' \t\n\r '] ადგილზე: ['key'] ).

dicts თითოეული: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (ლექსიკონი ახალი ჩასმა: d key ადგილზე: ['key']).
	>> b := JSON jsonify: (ლექსიკონი ახალი ჩასმა: ['value'] ადგილზე: d key).
	>> e := JSON ობიექტი: a.
	>> f := JSON ობიექტი: b.
	((e key = d key და: (f ? d key = ['value'])) ან: (e key = ['NUL ?'])) ჭეშმარიტი: {
		გამოტანა დაწერე: ['OK'], ახალი-ხაზი.
	}, თორემ: {
		გამოტანა დაწერე: ['Unable to properly encode/decode: '] + d + j, ახალი-ხაზი.
		პროგრამა დასასრული.
	}.
}.
