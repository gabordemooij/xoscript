
ტექსტი როცა: ['html'] გააკეთე: { <- (
		თავად
		შეცვლა: ['&'] ახლით: ['&amp;'],
		შეცვლა: ['<'] ახლით: ['&lt;'],
		შეცვლა: ['>'] ახლით: ['&gt;'],
		შეცვლა: ['"'] ახლით: ['&quot;']
	).
}.

>> HtmlBrush := ობიექტი ახალი.

HtmlBrush როცა: ['უპასუხე:'] გააკეთე: { :tag
	გამოტანა დაწერე: (['<tag>↵'] tag: tag ).
}.

HtmlBrush როცა: ['უპასუხე:და:'] გააკეთე: { :tag :content
	tag := ( tag საიდან: 0 სიგრძე: (tag სიგრძე - 1) ).
	გამოტანა დაწერე: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush როცა: ['content:'] გააკეთე: { :text
	გამოტანა დაწერე: text html, ახალი-ხაზი.
}.

HtmlBrush როცა: ['attr:value:'] გააკეთე: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush ახალი.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
