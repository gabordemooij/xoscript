# test qualifiers

>> $ := ობიექტი ახალი.

$ როცა: ['უპასუხე:'] გააკეთე: { :x
	
	>> operation := x სიმბოლო: 0.
	>> valuta := x სიმბოლო: 1.
	>> money := x წანაცვლება: 2.
	
	>> amount := 0.

	( operation = ['+'] ) ჭეშმარიტი: {
		( valuta = ['£'] ) ჭეშმარიტი: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

გამოტანა დაწერე: x, ახალი-ხაზი.


>> Fruit := ობიექტი ახალი.

Fruit როცა: ['ახალი'] გააკეთე: {
	>> f := თავად ახალი.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit როცა: ['apples:'] გააკეთე: { :a საკუთარი apples := a. }.
Fruit როცა: ['oranges:'] გააკეთე: { :p საკუთარი oranges := p. }.
Fruit როცა: ['apples'] გააკეთე: { <- საკუთარი apples. }.
Fruit როცა: ['oranges'] გააკეთე: { <- საკუთარი oranges. }.

Fruit როცა: ['+'] გააკეთე: { :f
	
	>> n := Fruit ახალი.
	f დამატება: 1.
	
	n apples: (f apples + საკუთარი apples).
	n oranges:  (f oranges  + საკუთარი oranges). <- n.
}.

Fruit როცა: ['ტექსტად'] გააკეთე: { <- ( საკუთარი apples ტექსტად + [' apples and '] + საკუთარი oranges + [' oranges'] ).
}.

რიცხვი როცა: ['apples'] გააკეთე: { <- ((Fruit ახალი) apples: თავად).
}.

რიცხვი როცა: ['apple'] გააკეთე: { <- ((Fruit ახალი) apples: თავად).
}.

რიცხვი როცა: ['oranges'] გააკეთე: { <- ((Fruit ახალი) oranges: თავად).
}.




გამოტანა დაწერე: (1 apple + 3 oranges + 4 apples), ახალი-ხაზი.


ტექსტი როცა: ['twice'] გააკეთე: { <- ((თავად ტექსტად) + (თავად ტექსტად)).
}.



გამოტანა დაწერე: ['❤❤❤'] twice.



