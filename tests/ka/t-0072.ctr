>> echo := ობიექტი ახალი.
echo როცა: ['უპასუხე:'] გააკეთე: { :sound
	{ გამოტანა დაწერე: sound. } × 2.
}.
echo ho!. 


echo := ობიექტი ახალი.
echo როცა: ['უპასუხე:და:'] გააკეთე: { :sound :x
	{ გამოტანა დაწერე: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := ობიექტი ახალი.
echo როცა: ['უპასუხე:და:და:'] გააკეთე: { :operation :sound :x
	{ გამოტანა დაწერე: sound. } × x.
}.
echo shout: ['la'] times: 4. 


