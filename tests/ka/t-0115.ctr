{
	ეს-ამოცანა შეცდომა: ['Dont fail.'].
	unknown doSomething.
} დაჭერა: {
	გამოტანა დაწერე: ['Caught!'].
}, გაშვება.

{
	ეს-ამოცანა შეცდომა: ['Dont fail.'].
	საკუთარი unknown doSomething.
} დაჭერა: {
	გამოტანა დაწერე: ['Caught!'].
}, გაშვება.

{
	ეს-ამოცანა შეცდომა: ['Dont fail.'].
	unknown := 122.
} დაჭერა: {
	გამოტანა დაწერე: ['Caught!'].
}, გაშვება.


{
	ეს-ამოცანა შეცდომა: ['Dont fail.'].
	ჭეშმარიტი შეწყვეტა.
	გამოტანა დაწერე: ['FAIL'].
} დაჭერა: {
	გამოტანა დაწერე: ['Caught!'].
}, გაშვება.

{
	{
		ეს-ამოცანა შეცდომა: ['Dont fail.'].
		ჭეშმარიტი შეწყვეტა.
		გამოტანა დაწერე: ['FAIL'].
	} დაჭერა: { :x
		(x = ['Dont fail.']) ჭეშმარიტი: { ეს-ამოცანა შეცდომა: ['Nested Caught!']. }.
	}, გაშვება.
} დაჭერა: { :e
	გამოტანა დაწერე: e.
}, გაშვება.
