>> Slurp := ობიექტი ახალი.
Slurp როცა: ['ახალი'] გააკეთე: {
	საკუთარი str := [''].
}.
Slurp ისწავლეთ: ['nieuw'] ნიშნავს: ['ახალი'].
Slurp როცა: ['უპასუხე:'] გააკეთე: { :blah
		(საკუთარი str ≠ ['']) ჭეშმარიტი: {
			საკუთარი str ბოლოში-დამატება: [' '].
		}.
		საკუთარი str ბოლოში-დამატება: blah.
}.
Slurp როცა: ['უპასუხე:და:'] გააკეთე: { :blah :blahah
		(საკუთარი str ≠ ['']) ჭეშმარიტი: {
			საკუთარი str ბოლოში-დამატება: [' '].
		}.
		(blah სიგრძე > 1) ჭეშმარიტი: {
			საკუთარი str ბოლოში-დამატება: (blah საიდან: 0 სიგრძე: (blah სიგრძე - 1)).
		}, თორემ: {
			საკუთარი str ბოლოში-დამატება: blah.
		}.
		საკუთარი str ბოლოში-დამატება: [' '].
		საკუთარი str ბოლოში-დამატება: blahah.
}.
Slurp როცა: ['obtain'] გააკეთე: {
	>> buffer := საკუთარი str.
	საკუთარი str := ['']. <- buffer.
}.


>> ძიების-პარამეტრები := Slurp ახალი
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

გამოტანა დაწერე: ძიების-პარამეტრები obtain, ახალი-ხაზი.
