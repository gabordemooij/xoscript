>> Greeter := ობიექტი ახალი.
Greeter როცა: ['make'] გააკეთე: {
	>> greeter := ობიექტი ახალი.
	greeter როცა: ['name:'] გააკეთე: { :სახელი
		გამოტანა დაწერე: ['setting a name'].
		საკუთარი myName := სახელი.
	}.
	greeter როცა: ['greet'] გააკეთე: {
		გამოტანა დაწერე: ['Hello'].
		გამოტანა დაწერე: საკუთარი myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
