


>> wine := ობიექტი ახალი.


wine როცა: ['toString'] გააკეთე: { <- ['merlot'].
}.

wine როცა: ['naarTekst'] გააკეთე: { <- ['merlot'].
}.


wine როცა: ['='] გააკეთე: { :other wine <- ( თავად toString = other wine ).
}.

wine როცა: ['=='] გააკეთე: { :other wine <- ( თავად toString = other wine ).
}.



wine
	შემთხვევა: ['cabernet'] გააკეთე: { გამოტანა დაწერე: ['it's a Cabernet!']. },
	შემთხვევა: ['syrah']    გააკეთე: { გამოტანა დაწერე: ['it's a Syrah!'].    },
	შემთხვევა: ['merlot']   გააკეთე: { გამოტანა დაწერე: ['it's a Merlot!'].   },
	შემთხვევა: ['malbec']   გააკეთე: { გამოტანა დაწერე: ['it's a Malbec!'].   }.

გამოტანა ახალი-ხაზი.
