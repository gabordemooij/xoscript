60 × {
	>> x := (რიცხვი random % 6) + 1.
	(x ≤ 6) მცდარი: { გამოტანა დაწერე: ['FAIL']. }.
	(x ≥0) მცდარი: { გამოტანა დაწერე: ['FAIL']. }.
	x := (რიცხვი random % 3) + 1.
	(x < 3) მცდარი: { გამოტანა დაწერე: ['FAIL']. }.
	(x>-1) მცდარი: { გამოტანა დაწერე: ['FAIL']. }.
	x := ((ლოგიკური flip) რიცხვად).
	(x = 0 ან: x = 1) მცდარი: { გამოტანა დაწერე: ['FAIL']. }.
	x := ((ჭეშმარიტი flip) რიცხვად).
	(x = 0 ან: x = 1) მცდარი: { გამოტანა დაწერე: ['FAIL']. }.
	x := (ლოგიკური flip ან: ['HEAD'] ან: ['TAIL']).
	((x = ['HEAD']) ან: (x = ['TAIL'])) მცდარი: { გამოტანა დაწერე: ['FAIL']. }.
}.
გამოტანა დაწერე: ['DONE'].

