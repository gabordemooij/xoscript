>> phrases := სია ახალი
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases თითოეული: { :_ :phrase 
	>> e := Server base64-კოდირება: phrase.
	>> d := Server base64-დეკოდირება: e.
	გამოტანა დაწერე: (
		message კოპირება ~encoded: e, ~decoded: d
	), ახალი-ხაზი.
}.
