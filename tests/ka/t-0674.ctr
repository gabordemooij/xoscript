# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> ბილიკი := ['/tmp/dat.csv'].
>> csv := ფაილი ახალი: ბილიკი.
csv დაწერე: s.

# accepts CRLF LF CR, varying row length
csv გამყოფი: [';'] ბრჭყალი: ['"'] ხაზები: { :line
	პროგრამა დასუფთავება.
	გამოტანა დაწერე: line, ახალი-ხაზი.
	პროგრამა დასუფთავება.
}.

# unequal lines
s ბოლოში-დამატება: ['\njustone'].
csv დაწერე: s.
{
	csv გამყოფი: [';'] ბრჭყალი: ['"'] ხაზები: { :line
		გამოტანა დაწერე: line, ახალი-ხაზი.
	}.
} დაჭერა: { :e 
	გამოტანა დაწერე: e, ახალი-ხაზი.
}, გაშვება.

# invalid format
s := ['"he"llo";world'].
csv დაწერე: s.
{
	csv გამყოფი: [';'] ბრჭყალი: ['"'] ხაზები: { :line
		გამოტანა დაწერე: line, ახალი-ხაზი.
	}.
} დაჭერა: { :e 
	გამოტანა დაწერე: e, ახალი-ხაზი.
}, გაშვება.
