>> To-Do := ობიექტი ახალი.

To-Do როცა: ['ახალი'] გააკეთე: {
	საკუთარი list := სია ახალი.
}.

To-Do როცა: ['nieuw'] გააკეთე: {
	საკუთარი list := სია ახალი.
}.

To-Do როცა: ['+'] გააკეთე: { :task
	საკუთარი list ბოლოში-დამატება: task.
}.

To-Do როცა: ['number of tasks?'] გააკეთე: { <-  საკუთარი list რაოდენობა.
}.

>> todos := 
	To-Do ახალი 
	+ ['cook dinner'] 
	+ ['clean room'].
	
გამოტანა დაწერე: ['You have $ tasks to do'] $ todos number of tasks?.
