# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := პროგრამა პარამეტრი: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server დაკავშირება: ( სია ახალი ;
 libname ; ['fopen'] ;
 ( სია ახალი ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
დაკავშირება: ( სია ახალი ;
 არაფერი ; # means same lib
 ['fread'] ;
 ( სია ახალი ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 არაფერი ; # means same object (i.e. Stream)
 ['fread']
),
დაკავშირება: (
 სია ახალი ;
 არაფერი ; # means same lib
 ['fwrite'] ;
 ( სია ახალი ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 არაფერი ; # means same lib
 ['fwrite']
),
დაკავშირება: (
 სია ახალი ;
 არაფერი ; # means same lib
 ['rewind'] ;
 ( სია ახალი ; ['pointer'] ) ;
 ['int'] ;
 არაფერი ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> ბილიკი := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: ბილიკი mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream შეტყობინება: ['fwrite'] არგუმენტები: (სია ახალი ; str ; 1 ; 6 ; fd ).
გამოტანა დაწერე: bytes-written, ახალი-ხაზი.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob ახალი: 20.

# read from file
>> bytes-read := Stream შეტყობინება: ['fread'] არგუმენტები: (სია ახალი ; buf ; 1 ; 6 ; fd ).
გამოტანა დაწერე: bytes-read, ახალი-ხაზი.
გამოტანა დაწერე: buf, ახალი-ხაზი.

# free memory
str  გათავისუფლება.
ბილიკი გათავისუფლება.
mode გათავისუფლება.
buf  გათავისუფლება.


