# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := ობიექტი ახალი.

Log როცა: ['say:'] გააკეთე: { :str
	გამოტანა დაწერე: str, ახალი-ხაზი.
}.

>> Item := ობიექტი ახალი.

Item როცა: ['ახალი:'] გააკეთე: { :id <- თავად ახალი id: id.
}.

Item როცა: ['id:'] გააკეთე: { :id
	საკუთარი id := id.
}.

Item როცა: ['id'] გააკეთე: { <- საკუთარი id. }.


Item როცა: ['ტექსტად'] გააკეთე: {
	>> str := ['Item#~no'].
	str ~no: საკუთარი id. <- str.
}.


>> Print := ობიექტი ახალი.

Print როცა: ['items'] გააკეთე: { 
	
	საკუთარი item := Item ახალი: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: საკუთარი item
	).
	
	
}.

Print items.