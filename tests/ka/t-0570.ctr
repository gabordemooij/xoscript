#Linux

 >> t := მომენტი ახალი.
 
t ზონა: ['Europe/Amsterdam'].
t წელი: 2020, თვე: 8, დღე: 2, საათი: 21, წუთი: 2, წამი: 1.

>> a := t საათი.
>> ams := t ზონა.

t ზონა: ['US/Hawaii'].
>> b := t საათი.
>> hw := t ზონა.

გამოტანა
დაწერე: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		ან: ['later'] ან: ['earlier']
	)
),
ახალი-ხაზი.
 