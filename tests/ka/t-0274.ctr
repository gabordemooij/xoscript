

სია როცა: ['column:'] გააკეთე: { :column
	>> result := სია ახალი.
	თავად თითოეული: { :index :row
		row თითოეული: { :index :cell
			(index = column) ჭეშმარიტი: { result ბოლოში-დამატება: cell. }.
		}.
	}. <- result.
}.


>> a := სია ←
	(სია ← 1 ; 2 ; 3) ;
	(სია ← 4 ; 5 ; 6) ;
	(სია ← 7 ; 8 ; 9).

>> b := a column: 1.
გამოტანა დაწერე: b, ახალი-ხაზი.

b := a column: 20.
გამოტანა დაწერე: b, ახალი-ხაზი.

b := a column: -100.
გამოტანა დაწერე: b, ახალი-ხაზი.
