Server init.

>> DB := Maria-DB ახალი ჰოსტი: ['localhost'],
	მომხმარებელი: ['xo'],
	პაროლი: ['pass123'],
	ბაზის-სახელი: ['xobase'],
	მიერთება.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB მოთხოვნა: SQL.

# now you don't have to set DB
query2 მიღება: { :row
	გამოტანა დაწერე: row world, ახალი-ხაზი.
}.
