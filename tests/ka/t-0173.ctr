

სია როცა: ['sum'] გააკეთე: {
	>> total := 0.
	თავად თითოეული: { :index :element
		total დამატება: element.
	}. <- total.
}.

სია როცა: ['product'] გააკეთე: {
	>> total := 1.
	თავად თითოეული: { :index :element
		total გამრავლება: element.
	}. <- total.
}.

>> usedMemory1 := 0.
