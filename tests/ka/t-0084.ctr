>> makeAdder := { :x
	>> f := { :y <- (საკუთარი x + y). } დაყენება: ['x'] მნიშვნელობა: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i საკუთარი q ჩასმა: (საკუთარი f გამოყენება-ზე: (საკუთარი q ? i)) ადგილზე: i. } 
	დაყენება: ['q'] მნიშვნელობა: array,
	დაყენება: ['f'] მნიშვნელობა: func.
	{ :i mapping გამოყენება-ზე: i. } × (array რაოდენობა).
}.

>> a := სია ← 1; 2; 3.
mapper გამოყენება-ზე: a და: (makeAdder გამოყენება-ზე: 100).
გამოტანა დაწერე: (a პოზიცია: 0), ახალი-ხაზი.
გამოტანა დაწერე: (a ? 1), ახალი-ხაზი.
გამოტანა დაწერე: (a ? 2), ახალი-ხაზი.
