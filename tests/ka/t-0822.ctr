# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := Maria-DB ახალი ჰოსტი: ['localhost'],
	მომხმარებელი: ['xo'],
	პაროლი: ['pass123'],
	ბაზის-სახელი: ['xobase'],
	მიერთება.

>> ძიების-პარამეტრები := db მოთხოვნა: ['SELECT ? AS a, ? AS b, ? AS c'].
ძიების-პარამეტრები პარამეტრები: (სია ახალი ; ['1']).
{ ძიების-პარამეტრები მიღება: { :row გამოტანა დაწერე: row, ახალი-ხაზი. }. } დაჭერა: { :e გამოტანა დაწერე: e, ახალი-ხაზი. }, გაშვება.

>> ძიების-პარამეტრები := db მოთხოვნა: ['SELECT ? AS a'].
{ ძიების-პარამეტრები მიღება: { :row გამოტანა დაწერე: row, ახალი-ხაზი. }. } დაჭერა: { :e გამოტანა დაწერე: e, ახალი-ხაზი. }, გაშვება.

# the right number still works, more parameters are ignored as before
>> ძიების-პარამეტრები := db მოთხოვნა: ['SELECT ? AS a, ? AS b'].
ძიების-პარამეტრები პარამეტრები: (სია ახალი ; ['1'] ; ['2']).
ძიების-პარამეტრები მიღება: { :row გამოტანა დაწერე: (row ადგილზე: ['a']), დაწერე: (row ადგილზე: ['b']), ახალი-ხაზი. }.
ძიების-პარამეტრები პარამეტრები: (სია ახალი ; ['1'] ; ['2'] ; ['3']).
ძიების-პარამეტრები მიღება: { :row გამოტანა დაწერე: (row ადგილზე: ['a']), დაწერე: (row ადგილზე: ['b']), ახალი-ხაზი. }.
