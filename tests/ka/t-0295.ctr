
>> dictionary := (
	ლექსიკონი ახალი
		ჩასმა: ['b'] ადგილზე: ['a'],
		ჩასმა: ['a'] ადგილზე: ['b'],
		ჩასმა: ['z'] ადგილზე: ['x'],
		ჩასმა: ['hello'] ადგილზე: ['hallo'],
		ჩასმა: ['human'] ადგილზე: ['human']
).

>> comparisons := სია ახალი.
dictionary თითოეული: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a შედარება: b)
	).
}.

comparisons დალაგება: { :a :b <- ( a შედარება: b ). }.
გამოტანა დაწერე: ( comparisons გაერთიანება: ['↵'] ), ახალი-ხაზი.
comparisons გაერთიანება: ['↵'].
