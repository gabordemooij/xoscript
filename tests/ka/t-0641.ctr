# Test utf8 sanitizer
Server init.

>> utf8cases := ლექსიკონი ახალი
	# ASCII only
	ჩასმა: ( სია ახალი ; 65 ; 65 ; 65 ; 65 ; 0 ) ადგილზე: ['AAAA'],
	# valid 2 byte sequence
	ჩასმა: ( სია ახალი ; 194 ; 162 ; 0 ) ადგილზე: ['¢'],
	# Valid 3-byte UTF-8
    ჩასმა: ( სია ახალი ; 226 ; 130 ; 172 ; 0 ) ადგილზე: ['€'],
	# Valid 4-byte UTF-8
    ჩასმა: ( სია ახალი ; 240 ; 144 ; 141 ; 136 ; 0 ) ადგილზე: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    ჩასმა: ( სია ახალი ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) ადგილზე: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    ჩასმა: ( სია ახალი ; 65 ; 193 ; 129 ; 0 ) ადგილზე: ['A?'],
	# Invalid first byte (0xFF)
    ჩასმა: ( სია ახალი ; 255 ; 0 ) ადგილზე: ['?'],
	# Incomplete multi-byte sequence at end
    ჩასმა: ( სია ახალი ; 66 ; 226 ; 0 ) ადგილზე: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    ჩასმა: ( სია ახალი ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) ადგილზე: ['A€?𐍈B'].
	 
utf8cases თითოეული: { :key :value
	>> blob := Blob ახალი: value რაოდენობა, bytes: value.
	>> str := blob ტექსტად.
	(str = key) ჭეშმარიტი: {
		გამოტანა დაწერე: ['OK'], ახალი-ხაზი.
	}, თორემ: {
		გამოტანა დაწერე: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, ახალი-ხაზი.
	}.
	blob გათავისუფლება.
}.
