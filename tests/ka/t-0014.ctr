>> Greeter := ობიექტი ახალი.
Greeter როცა: ['make'] გააკეთე: {
	>> gr := ობიექტი ახალი.
	gr როცა: ['setName:'] გააკეთე: { :aname
		საკუთარი სახელი := aname.
	}.
	gr როცა: ['greet'] გააკეთე: {
		გამოტანა დაწერე: საკუთარი სახელი.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a ახალი.
c setName: ['THREE'].
c greet.
>> d := a ახალი.
d setName: ['FOUR'].
d greet.
c greet.
