Έξοδος γράψε: ['Test object'], νέα-γραμμή.
>> a := Αντικείμενο νέο. 

a όταν: ['item:'] κάνε: { :octhelper
	δικό octhelper := octhelper. 
}.

a όταν: ['item'] κάνε: { <- δικό octhelper.
}.

a item: Oct νέο.

>> old-octhelper-address := a item πρωτότυπο διεύθυνση-μνήμης.
a save-as: ['/tmp/a.bin'].
Έξοδος γράψε: ['========== RELOADING SNAP:'], νέα-γραμμή.

>> b := Αντικείμενο load-from: ['/tmp/a.bin'].

(b item πρωτότυπο διεύθυνση-μνήμης = old-octhelper-address) αληθές: {
	Έξοδος γράψε: ['Object link re-attached.'], νέα-γραμμή.
}.
