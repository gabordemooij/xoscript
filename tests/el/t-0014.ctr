>> Χαιρετιστής := Αντικείμενο νέο.
Χαιρετιστής όταν: ['φτιάξε'] κάνε: {
	>> χρ := Αντικείμενο νέο.
	χρ όταν: ['setName:'] κάνε: { :έναόνομα
		δικό όνομα := έναόνομα.
	}.
	χρ όταν: ['χαιρέτα'] κάνε: {
		Έξοδος γράψε: δικό όνομα.
	}. <- χρ.
}.
>> a := Χαιρετιστής φτιάξε.
>> b := Χαιρετιστής φτιάξε.
a setName: ['ΕΝΑ'].
b setName: ['ΔΥΟ'].
a χαιρέτα.
b χαιρέτα.
>> c := a νέο.
c setName: ['ΤΡΙΑ'].
c χαιρέτα.
>> d := a νέο.
d setName: ['ΤΕΣΣΕΡΑ'].
d χαιρέτα.
c χαιρέτα.
