>> Greeter := Αντικείμενο νέο.
Greeter όταν: ['make'] κάνε: {
	>> gr := Αντικείμενο νέο.
	gr όταν: ['setName:'] κάνε: { :aname
		δικό όνομα := aname.
	}.
	gr όταν: ['greet'] κάνε: {
		Έξοδος γράψε: δικό όνομα.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a νέο.
c setName: ['THREE'].
c greet.
>> d := a νέο.
d setName: ['FOUR'].
d greet.
c greet.
