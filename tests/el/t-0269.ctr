#Linux

(Αρχείο νέο: ['/tmp/testje']) υπάρχει ψευδές: {
	Πρόγραμμα σύστημα: ['mkdir /tmp/testje'].	
}.

(Αρχείο νέο: ['/tmp/testje/file1']) υπάρχει ψευδές: {
	Πρόγραμμα σύστημα: ['touch /tmp/testje/file1'].	
}.

(Αρχείο νέο: ['/tmp/testje/folder1']) υπάρχει ψευδές: {
	Πρόγραμμα σύστημα: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Αρχείο λίστα: ['/tmp/testje'].

>> q := Λίστα νέο.

l κάθε: { :k :v v κάθε: { :x :y q προσθήκη-στο-τέλος: y. }. }.

>> s := q κείμενο.

(s περιέχει: ['file1']) αληθές:   { Έξοδος γράψε: ['OK'], νέα-γραμμή. }.
(s περιέχει: ['file2']) αληθές:   { Έξοδος γράψε: ['XX'], νέα-γραμμή. }.
(s περιέχει: ['folder1']) αληθές: { Έξοδος γράψε: ['OK'], νέα-γραμμή. }.
