#Linux
>> OS := Πρόγραμμα ρύθμιση: ['OS'].

>> ρολόι := Στιγμή νέο.
	
(OS = ['Haiku']) αληθές: {
	ρολόι ζώνη: ['CET'],
	έτος: 2017, μήνας: 7, ημέρα: 13,
	ώρα: 18, λεπτό: 0, δευτερόλεπτο: 0.
}, αλλιώς: {
	ρολόι ζώνη: ['Europe/Amsterdam'],
	έτος: 2017, μήνας: 7, ημέρα: 13,
	ώρα: 18, λεπτό: 0, δευτερόλεπτο: 0.
}.

ρολόι όταν: ['ανάφερε'] κάνε: {
	Έξοδος γράψε: εαυτός, νέα-γραμμή.
}.


ρολόι πρόσθεση: 2    ώρα, ανάφερε.
ρολόι πρόσθεση: 1    ώρα, ανάφερε.
ρολόι πρόσθεση: 19 λεπτό, ανάφερε.
ρολόι πρόσθεση: 1  λεπτό, ανάφερε.
ρολόι πρόσθεση: 1  λεπτό, ανάφερε.
ρολόι πρόσθεση: 19 δευτερόλεπτο, ανάφερε.
ρολόι πρόσθεση: 1  δευτερόλεπτο, ανάφερε.
ρολόι πρόσθεση: 1  δευτερόλεπτο, ανάφερε.
ρολόι πρόσθεση: 2    έτος, ανάφερε.
ρολόι πρόσθεση: 1    έτος, ανάφερε.

(OS = ['Haiku']) αληθές: {
ρολόι πρόσθεση: 5   μήνας.
ρολόι ζώνη: ['CEST'], ανάφερε.
}, αλλιώς: {
	ρολόι πρόσθεση: 5   μήνας, ανάφερε.
}.

ρολόι πρόσθεση: 1   μήνας, ανάφερε.
ρολόι πρόσθεση: 19    ημέρα, ανάφερε.
ρολόι πρόσθεση: 1    ώρα, ανάφερε.
ρολόι πρόσθεση: 120  γιάρδα, ανάφερε.
