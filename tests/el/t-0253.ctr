#Linux
>> OS := Πρόγραμμα ρύθμιση: ['OS'].

>> clock := Στιγμή νέο.
	
(OS = ['Haiku']) αληθές: {
	clock ζώνη: ['CET'],
	έτος: 2017, μήνας: 7, ημέρα: 13,
	ώρα: 18, λεπτό: 0, δευτερόλεπτο: 0.
}, αλλιώς: {
	clock ζώνη: ['Europe/Amsterdam'],
	έτος: 2017, μήνας: 7, ημέρα: 13,
	ώρα: 18, λεπτό: 0, δευτερόλεπτο: 0.
}.

clock όταν: ['tell'] κάνε: {
	Έξοδος γράψε: εαυτός, νέα-γραμμή.
}.


clock πρόσθεση: 2    ώρα, tell.
clock πρόσθεση: 1    ώρα, tell.
clock πρόσθεση: 19 λεπτό, tell.
clock πρόσθεση: 1  λεπτό, tell.
clock πρόσθεση: 1  λεπτό, tell.
clock πρόσθεση: 19 δευτερόλεπτο, tell.
clock πρόσθεση: 1  δευτερόλεπτο, tell.
clock πρόσθεση: 1  δευτερόλεπτο, tell.
clock πρόσθεση: 2    έτος, tell.
clock πρόσθεση: 1    έτος, tell.

(OS = ['Haiku']) αληθές: {
clock πρόσθεση: 5   μήνας.
clock ζώνη: ['CEST'], tell.
}, αλλιώς: {
	clock πρόσθεση: 5   μήνας, tell.
}.

clock πρόσθεση: 1   μήνας, tell.
clock πρόσθεση: 19    ημέρα, tell.
clock πρόσθεση: 1    ώρα, tell.
clock πρόσθεση: 120  yard, tell.
