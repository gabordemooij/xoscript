

>> g  := Server νέο.
>> v  := Θησαυροφυλάκιο νέο.
>> εντάξει := 0.

>> μυστικά := Λίστα νέο ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> συνθηματικά := μυστικά αντιγραφή.
συνθηματικά κάθε: { :i :p
	μυστικά κάθε: { :n :s
		{
			>> κρυπτογραφημένο := v κρυπτογράφηση: s κλειδί: p.
			>> αποκρυπτογραφημένο := v αποκρυπτογράφηση: κρυπτογραφημένο κλειδί: p.
			(αποκρυπτογραφημένο = s) αληθές: {
				εντάξει πρόσθεση: 1.
			}, αλλιώς: {
				Έξοδος γράψε: ['αποτυχία κρυπτογράφησης/αποκρυπτογράφησης: '], νέα-γραμμή.
				Έξοδος γράψε: s, νέα-γραμμή.
				Έξοδος γράψε: ['κρυπτογραφημένο: '] + κρυπτογραφημένο, νέα-γραμμή.
				Έξοδος γράψε: ['αποκρυπτογραφημένο: '] + κρυπτογραφημένο, νέα-γραμμή.
				Πρόγραμμα τέλος.
			}.
		} σύλληψη: { :σφ
			(s = [''] ή: p = ['']) αληθές: {
				εντάξει πρόσθεση: 1.
			}, αλλιώς: {
				Έξοδος γράψε: σφ, νέα-γραμμή.
				Πρόγραμμα τέλος.
			}.
		}, εκκίνηση.
	}.
}.

Έξοδος γράψε: ( εντάξει + [' κρυπτογραφήσεις θησαυροφυλακίου ελέγχθηκαν.'] ), νέα-γραμμή.