

Κείμενο όταν: ['αποτίμησε'] κάνε: {
	>> κώδικας := Αρχείο νέο: ['/tmp/eval.ctr'].
	κώδικας γράψε: (εαυτός κείμενο + ['.']).
	Πρόγραμμα χρήση: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Λίστα ← (['Τα εισαγωγικά '] + Q + [' είναι κακά?']) ; 1.
>> x := q κείμενο.
Έξοδος γράψε: x, νέα-γραμμή.
>> y := Κενό.
(['y := '] + x ) αποτίμησε.
Έξοδος γράψε: y ? 0, νέα-γραμμή.

q := Λεξικό τοποθέτηση: ['\[''] στο: ['\['quote\']'].
x := q κείμενο.
Έξοδος γράψε: x, νέα-γραμμή.
y := Κενό.
(['y := '] + x ) αποτίμησε.

>> q := (Λεξικό νέο) τοποθέτηση:['\[''] στο:['\['quote\[''].
Έξοδος γράψε: y ? ['\['quote\']'], νέα-γραμμή.
