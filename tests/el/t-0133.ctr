


>> Τράπουλα := Λίστα νέο.
Τράπουλα όταν: ['τύπωσε'] κάνε: {
        >> len := εαυτός πλήθος - 1.
        { :i
                >> μήκ2 := εαυτός πλήθος - 1.
                Έξοδος γράψε: ['μήκος: '].
                Έξοδος γράψε: len, νέα-γραμμή.
                Έξοδος γράψε: ['μήκος2: '].
                Έξοδος γράψε: μήκ2, νέα-γραμμή.
        } × len.
}.

>> d := Τράπουλα ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d τύπωσε.
