


>> Deck := Λίστα νέο.
Deck όταν: ['print'] κάνε: {
        >> len := εαυτός πλήθος - 1.
        { :i
                >> len2 := εαυτός πλήθος - 1.
                Έξοδος γράψε: ['len: '].
                Έξοδος γράψε: len, νέα-γραμμή.
                Έξοδος γράψε: ['len2: '].
                Έξοδος γράψε: len2, νέα-γραμμή.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
