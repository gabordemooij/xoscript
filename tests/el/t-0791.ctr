Server init.

>> DB := Maria-DB νέο κόμβος: ['localhost'],
	χρήστης: ['xo'],
	κωδικός: ['pass123'],
	όνομα-βάσης: ['xobase'],
	συνδέσου.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> παράμετροι-αναζήτησης := Maria-Ερώτημα νέο: SQL.

# set database
παράμετροι-αναζήτησης βάση-δεδομένων: DB.

παράμετροι-αναζήτησης ανάκτηση: { :row
	Έξοδος γράψε: row world, νέα-γραμμή.
}.
