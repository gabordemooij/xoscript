Server init.

>> ΒΔ := Maria-DB νέο κόμβος: ['localhost'],
	χρήστης: ['xo'],
	κωδικός: ['pass123'],
	όνομα-βάσης: ['xobase'],
	συνδέσου.
	
>> SQL := ['SELECT "hello" AS "world" '].

# χειροκίνητη δημιουργία ερωτήματος
>> παράμετροι-αναζήτησης := Maria-Ερώτημα νέο: SQL.

# ορισμός βάσης δεδομένων
παράμετροι-αναζήτησης βάση-δεδομένων: ΒΔ.

παράμετροι-αναζήτησης ανάκτηση: { :σειρά
	Έξοδος γράψε: σειρά world, νέα-γραμμή.
}.
