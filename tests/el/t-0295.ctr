
>> λεξιλόγιο := (
	Λεξικό νέο
		τοποθέτηση: ['b'] στο: ['a'],
		τοποθέτηση: ['a'] στο: ['b'],
		τοποθέτηση: ['z'] στο: ['x'],
		τοποθέτηση: ['hello'] στο: ['hallo'],
		τοποθέτηση: ['human'] στο: ['human']
).

>> συγκρίσεις := Λίστα νέο.
λεξιλόγιο κάθε: { :a :b
	συγκρίσεις ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a σύγκριση: b)
	).
}.

συγκρίσεις ταξινόμηση: { :a :b <- ( a σύγκριση: b ). }.
Έξοδος γράψε: ( συγκρίσεις συνένωση: ['↵'] ), νέα-γραμμή.
συγκρίσεις συνένωση: ['↵'].
