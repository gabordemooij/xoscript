
>> dictionary := (
	Λεξικό νέο
		τοποθέτηση: ['b'] στο: ['a'],
		τοποθέτηση: ['a'] στο: ['b'],
		τοποθέτηση: ['z'] στο: ['x'],
		τοποθέτηση: ['hello'] στο: ['hallo'],
		τοποθέτηση: ['human'] στο: ['human']
).

>> comparisons := Λίστα νέο.
dictionary κάθε: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a σύγκριση: b)
	).
}.

comparisons ταξινόμηση: { :a :b <- ( a σύγκριση: b ). }.
Έξοδος γράψε: ( comparisons συνένωση: ['↵'] ), νέα-γραμμή.
comparisons συνένωση: ['↵'].
