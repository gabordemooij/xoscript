# test catch-all methods
>> x13 := Αντικείμενο νέο.
x13 όταν: ['a'] κάνε: { :a Έξοδος γράψε: 0, νέα-γραμμή. }.
x13 όταν: ['a:'] κάνε: { :a Έξοδος γράψε: a, νέα-γραμμή. <- 5. }.
x13 όταν: ['a:b:'] κάνε: { :a :b Έξοδος γράψε: (a + b), νέα-γραμμή. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
