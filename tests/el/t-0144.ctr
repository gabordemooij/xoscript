



>> CoffeeGrounds := Αντικείμενο νέο.
CoffeeGrounds όταν: ['extract'] κάνε: { <- ['coffee']. }.

>> CoffeeMachine := Αντικείμενο νέο.
CoffeeMachine όταν: ['init'] κάνε: {
	δικό coffeegrounds := CoffeeGrounds νέο.
}.
CoffeeMachine όταν: ['νέο'] κάνε: { <- CoffeeMachine `new init.
}.

CoffeeMachine όταν: ['makeTea'] κάνε: { <- (δικό tealeaves extract). }.
CoffeeMachine όταν: ['makeCoffee'] κάνε: { <- (δικό coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine νέο.

Έξοδος γράψε:
	coffeeDream 
	makeCoffee.

Έξοδος γράψε:
	coffeeDream 
	makeTea.
