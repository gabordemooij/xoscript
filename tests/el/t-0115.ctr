{
	αυτή-η-εργασία λάθος: ['Dont fail.'].
	unknown doSomething.
} σύλληψη: {
	Έξοδος γράψε: ['Caught!'].
}, εκκίνηση.

{
	αυτή-η-εργασία λάθος: ['Dont fail.'].
	δικό unknown doSomething.
} σύλληψη: {
	Έξοδος γράψε: ['Caught!'].
}, εκκίνηση.

{
	αυτή-η-εργασία λάθος: ['Dont fail.'].
	unknown := 122.
} σύλληψη: {
	Έξοδος γράψε: ['Caught!'].
}, εκκίνηση.


{
	αυτή-η-εργασία λάθος: ['Dont fail.'].
	Αληθές διακοπή.
	Έξοδος γράψε: ['FAIL'].
} σύλληψη: {
	Έξοδος γράψε: ['Caught!'].
}, εκκίνηση.

{
	{
		αυτή-η-εργασία λάθος: ['Dont fail.'].
		Αληθές διακοπή.
		Έξοδος γράψε: ['FAIL'].
	} σύλληψη: { :x
		(x = ['Dont fail.']) αληθές: { αυτή-η-εργασία λάθος: ['Nested Caught!']. }.
	}, εκκίνηση.
} σύλληψη: { :e
	Έξοδος γράψε: e.
}, εκκίνηση.
