# a value ending in the first part of an opening quote must survive serialization
>> τιμές := Λίστα νέο
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

τιμές κάθε: { :i :value
	>> d := Λεξικό νέο.
	d τοποθέτηση: value στο: ['k'].
	d τοποθέτηση: ['second'] στο: ['j'].
	>> r := d κώδικας αντικείμενο.
	Έξοδος γράψε: r πλήθος, νέα-γραμμή.
	Έξοδος γράψε: ( (r στο: ['k']) = value ), νέα-γραμμή.
}.
