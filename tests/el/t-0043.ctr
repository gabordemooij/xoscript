>> repeater := Αντικείμενο νέο.
repeater όταν: ['απάντηση:'] κάνε: { :what
	Έξοδος γράψε: what + [' '].
}.
repeater όταν: ['απάντηση:και:'] κάνε: { :what :say
	Έξοδος γράψε: what, γράψε: say + [' '].
}.
repeater όταν: ['απάντηση:και:και:'] κάνε: { :what :say :more
	Έξοδος γράψε: what, γράψε: say, γράψε: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
