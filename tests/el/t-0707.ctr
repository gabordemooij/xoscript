# test type casts / conversions / bindings
Πρόγραμμα διαχείριση-μνήμης: 4.
Server init.

>> counter := 0.
>> db := Maria-DB νέο κόμβος: ['localhost'],
	χρήστης: ['xo'], κωδικός: ['pass123'], όνομα-βάσης: ['xobase'], συνδέσου.

>> TwoDigitFormat := Μορφή νέο: ['%02d'].

# Datetime
{
	>> έτος := Αριθμός μεταξύ: 1995 και: 2050, κείμενο.
	>> μήνας := TwoDigitFormat εφαρμογή-ακεραίου: (Αριθμός μεταξύ: 1 και: 12), κείμενο.
	>> ημέρα := TwoDigitFormat εφαρμογή-ακεραίου: (Αριθμός μεταξύ: 1 και: 28), κείμενο.
	>> ώρα := TwoDigitFormat εφαρμογή-ακεραίου: (Αριθμός μεταξύ: 1 και: 23), κείμενο.
	>> λεπτό := TwoDigitFormat εφαρμογή-ακεραίου: (Αριθμός μεταξύ: 1 και: 59), κείμενο.
	>> δευτερόλεπτο := TwoDigitFormat εφαρμογή-ακεραίου: (Αριθμός μεταξύ: 1 και: 59), κείμενο.
	>> datetime := ['YYYY-MM-DD HH:II:SS'].	
	datetime
		YYYY: έτος,
		MM: μήνας,
		DD: ημέρα,
		HH: ώρα,
		II: λεπτό,
		SS: δευτερόλεπτο.
	>> παράμετροι-αναζήτησης :=
	db ερώτημα: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: datetime),
	ανάκτηση: { :row
		(row mydatetime = datetime) ψευδές: {
			αυτή-η-εργασία λάθος: (
				['Expected: <expected> but got: <observation>']
				<expected>: datetime,
				<observation>: row mydatetime
			).
		}.
	
	}.
	counter πρόσθεση: 1.
} * 100.

# Date
{
	>> έτος := Αριθμός μεταξύ: 1995 και: 2050, κείμενο.
	>> μήνας := TwoDigitFormat εφαρμογή-ακεραίου: (Αριθμός μεταξύ: 1 και: 12), κείμενο.
	>> ημέρα := TwoDigitFormat εφαρμογή-ακεραίου: (Αριθμός μεταξύ: 1 και: 28), κείμενο.
	>> date := ['YYYY-MM-DD'].
	date
		YYYY: έτος,
		MM: μήνας,
		DD: ημέρα.
	>> παράμετροι-αναζήτησης :=
	db ερώτημα: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: date),
	ανάκτηση: { :row
		(row mydate = date) ψευδές: {
			αυτή-η-εργασία λάθος: (
				['Expected: <expected> but got: <observation>']
				<expected>: date,
				<observation>: row mydate
			).
		}.
	}.
	counter πρόσθεση: 1.
} * 100.


# Time
{
	>> ώρα := TwoDigitFormat εφαρμογή-ακεραίου: (Αριθμός μεταξύ: 1 και: 23), κείμενο.
	>> λεπτό := TwoDigitFormat εφαρμογή-ακεραίου: (Αριθμός μεταξύ: 1 και: 59), κείμενο.
	>> δευτερόλεπτο := TwoDigitFormat εφαρμογή-ακεραίου: (Αριθμός μεταξύ: 1 και: 59), κείμενο.
	>> χρόνος := ['HH:II:SS'].
	χρόνος
		HH: ώρα,
		II: λεπτό,
		SS: δευτερόλεπτο.
	>> παράμετροι-αναζήτησης :=
	db ερώτημα: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: χρόνος),
	ανάκτηση: { :row
		(row mytime = χρόνος) ψευδές: {
			αυτή-η-εργασία λάθος: (
				['Expected: <expected> but got: <observation>']
				<expected>: datetime,
				<observation>: row mytime
			).
		}.
	}.
	counter πρόσθεση: 1.
} * 100.


# Strings (varchar/text)
>> str1 := Λίστα νέο γέμισμα: 100000 με: ['x'], συνένωση: [''].
{
	>> str2 := Θησαυροφυλάκιο διακριτικό: 40.
	>> παράμετροι-αναζήτησης :=
	db ερώτημα: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	ανάκτηση: { :row
		(row str1 = str1 και: row str2 = str2) ψευδές: {
			αυτή-η-εργασία λάθος: (
				['Expected: <expected> but got: <observation>']
				<expected>: datetime,
				<observation>: row mytime
			).
		}.
	}.
	counter πρόσθεση: 1.
} * 100.


# Numbers
{
	>> n1 := Αριθμός μεταξύ: 1 και: 99999.
	>> n2 := n1 / 1000.
	>> big := (
		( Int64 από-κείμενο: ['9223372036854775807'] ) -
		( Int64 από-κείμενο: ['99999'] ) +
		( Int64 από-κείμενο: n1 κείμενο )
	).
	>> παράμετροι-αναζήτησης :=
	db ερώτημα: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	ανάκτηση: { :row
		(row n1 = n1) ψευδές: {
			αυτή-η-εργασία λάθος: (
				['Expected: <expected> but got: <observation>']
				<expected>: n1,
				<observation>: row n1
			).
		}.
		(row n2 = n2) ψευδές: {
			αυτή-η-εργασία λάθος: (
				['Expected: <expected> but got: <observation>']
				<expected>: n1,
				<observation>: row n2
			).
		}.
		(row n3 = n2 στρογγύλευση) ψευδές: {
			αυτή-η-εργασία λάθος: (
				['Expected: <expected> but got: <observation>']
				<expected>: n1,
				<observation>: row n3
			).
		}.
		(row big = big) ψευδές: {
			αυτή-η-εργασία λάθος: (
				['Expected: <expected> but got: <observation>']
				<expected>: big,
				<observation>: row big
			).
		}.
		
	}.
	counter πρόσθεση: 1.
} * 100.


Έξοδος γράψε: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: counter
), νέα-γραμμή.