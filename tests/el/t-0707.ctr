# δοκιμή μετατροπών τύπων / συνδέσεων
Πρόγραμμα διαχείριση-μνήμης: 4.
Server init.

>> μετρητής := 0.
>> βδ := Maria-DB νέο κόμβος: ['localhost'],
	χρήστης: ['xo'], κωδικός: ['pass123'], όνομα-βάσης: ['xobase'], συνδέσου.

>> ΜορφήΔύοΨηφίων := Μορφή νέο: ['%02d'].

# Ημερομηνία-ώρα
{
	>> έτος     := Αριθμός μεταξύ: 1995 και: 2050, κείμενο.
	>> μήνας    := ΜορφήΔύοΨηφίων εφαρμογή-ακεραίου: (Αριθμός μεταξύ: 1 και: 12), κείμενο.
	>> ημέρα      := ΜορφήΔύοΨηφίων εφαρμογή-ακεραίου: (Αριθμός μεταξύ: 1 και: 28), κείμενο.
	>> ώρα     := ΜορφήΔύοΨηφίων εφαρμογή-ακεραίου: (Αριθμός μεταξύ: 1 και: 23), κείμενο.
	>> λεπτό   := ΜορφήΔύοΨηφίων εφαρμογή-ακεραίου: (Αριθμός μεταξύ: 1 και: 59), κείμενο.
	>> δευτερόλεπτο   := ΜορφήΔύοΨηφίων εφαρμογή-ακεραίου: (Αριθμός μεταξύ: 1 και: 59), κείμενο.
	>> datetime := ['YYYY-MM-DD HH:II:SS'].	
	datetime
		YYYY: έτος,
		MM: μήνας,
		DD: ημέρα,
		HH: ώρα,
		II: λεπτό,
		SS: δευτερόλεπτο.
	>> παράμετροι-αναζήτησης :=
	βδ ερώτημα: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: datetime),
	ανάκτηση: { :σειρά
		(σειρά mydatetime = datetime) ψευδές: {
			αυτή-η-εργασία λάθος: (
				['Αναμενόταν: <expected> αλλά πήραμε: <observation>']
				<expected>: datetime,
				<observation>: σειρά mydatetime
			).
		}.
	
	}.
	μετρητής πρόσθεση: 1.
} * 100.

# Ημερομηνία
{
	>> έτος     := Αριθμός μεταξύ: 1995 και: 2050, κείμενο.
	>> μήνας    := ΜορφήΔύοΨηφίων εφαρμογή-ακεραίου: (Αριθμός μεταξύ: 1 και: 12), κείμενο.
	>> ημέρα      := ΜορφήΔύοΨηφίων εφαρμογή-ακεραίου: (Αριθμός μεταξύ: 1 και: 28), κείμενο.
	>> date     := ['YYYY-MM-DD'].
	date
		YYYY: έτος,
		MM: μήνας,
		DD: ημέρα.
	>> παράμετροι-αναζήτησης :=
	βδ ερώτημα: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: date),
	ανάκτηση: { :σειρά
		(σειρά mydate = date) ψευδές: {
			αυτή-η-εργασία λάθος: (
				['Αναμενόταν: <expected> αλλά πήραμε: <observation>']
				<expected>: date,
				<observation>: σειρά mydate
			).
		}.
	}.
	μετρητής πρόσθεση: 1.
} * 100.


# Ώρα
{
	>> ώρα     := ΜορφήΔύοΨηφίων εφαρμογή-ακεραίου: (Αριθμός μεταξύ: 1 και: 23), κείμενο.
	>> λεπτό   := ΜορφήΔύοΨηφίων εφαρμογή-ακεραίου: (Αριθμός μεταξύ: 1 και: 59), κείμενο.
	>> δευτερόλεπτο   := ΜορφήΔύοΨηφίων εφαρμογή-ακεραίου: (Αριθμός μεταξύ: 1 και: 59), κείμενο.
	>> χρόνος := ['HH:II:SS'].
	χρόνος
		HH: ώρα,
		II: λεπτό,
		SS: δευτερόλεπτο.
	>> παράμετροι-αναζήτησης :=
	βδ ερώτημα: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: χρόνος),
	ανάκτηση: { :σειρά
		(σειρά mytime = χρόνος) ψευδές: {
			αυτή-η-εργασία λάθος: (
				['Αναμενόταν: <expected> αλλά πήραμε: <observation>']
				<expected>: datetime,
				<observation>: σειρά mytime
			).
		}.
	}.
	μετρητής πρόσθεση: 1.
} * 100.


# Κείμενα (varchar/text)
>> str1 := Λίστα νέο γέμισμα: 100000 με: ['x'], συνένωση: [''].
{
	>> str2 := Θησαυροφυλάκιο διακριτικό: 40.
	>> παράμετροι-αναζήτησης :=
	βδ ερώτημα: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	ανάκτηση: { :σειρά
		(σειρά str1 = str1 και: σειρά str2 = str2) ψευδές: {
			αυτή-η-εργασία λάθος: (
				['Αναμενόταν: <expected> αλλά πήραμε: <observation>']
				<expected>: datetime,
				<observation>: σειρά mytime
			).
		}.
	}.
	μετρητής πρόσθεση: 1.
} * 100.


# Αριθμοί
{
	>> n1  := Αριθμός μεταξύ: 1 και: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 από-κείμενο: ['9223372036854775807'] ) -
		( Int64 από-κείμενο: ['99999'] ) +
		( Int64 από-κείμενο: n1 κείμενο )
	).
	>> παράμετροι-αναζήτησης :=
	βδ ερώτημα: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	ανάκτηση: { :σειρά
		(σειρά n1 = n1) ψευδές: {
			αυτή-η-εργασία λάθος: (
				['Αναμενόταν: <expected> αλλά πήραμε: <observation>']
				<expected>: n1,
				<observation>: σειρά n1
			).
		}.
		(σειρά n2 = n2) ψευδές: {
			αυτή-η-εργασία λάθος: (
				['Αναμενόταν: <expected> αλλά πήραμε: <observation>']
				<expected>: n1,
				<observation>: σειρά n2
			).
		}.
		(σειρά n3 = n2 στρογγύλευση) ψευδές: {
			αυτή-η-εργασία λάθος: (
				['Αναμενόταν: <expected> αλλά πήραμε: <observation>']
				<expected>: n1,
				<observation>: σειρά n3
			).
		}.
		(σειρά big = big) ψευδές: {
			αυτή-η-εργασία λάθος: (
				['Αναμενόταν: <expected> αλλά πήραμε: <observation>']
				<expected>: big,
				<observation>: σειρά big
			).
		}.
		
	}.
	μετρητής πρόσθεση: 1.
} * 100.


Έξοδος γράψε: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: μετρητής
), νέα-γραμμή.