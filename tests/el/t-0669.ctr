# Κατακερματισμός συνθηματικού
Server init.

# Ο χρήστης ορίζει συνθηματικό
>> συνθ := ['pass123'].

# Το αποθηκεύετε έτσι
>> κατακερματισμένο := Θησαυροφυλάκιο 
	κατακερματισμός-κωδικού: συνθ.

# Μετά, ο χρήστης συνδέεται
# Προσπάθεια 1
>> a1 := ['abcd123'].
# Προσπάθεια 2
>> a2 := ['pass123'].

# Επαλήθευση
>> a := Θησαυροφυλάκιο 
	κατακερματισμός-κωδικού: κατακερματισμένο επαλήθευση: a1.
	# αποτυχία 
>> b := Θησαυροφυλάκιο
	κατακερματισμός-κωδικού: κατακερματισμένο επαλήθευση: a2.
	# εντάξει!

Έξοδος γράψε: a, νέα-γραμμή.
Έξοδος γράψε: b, νέα-γραμμή.

