# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Θησαυροφυλάκιο 
	κατακερματισμός-κωδικού: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Θησαυροφυλάκιο 
	κατακερματισμός-κωδικού: hash επαλήθευση: a1.
	# fail 
>> b := Θησαυροφυλάκιο
	κατακερματισμός-κωδικού: hash επαλήθευση: a2.
	# ok!

Έξοδος γράψε: a, νέα-γραμμή.
Έξοδος γράψε: b, νέα-γραμμή.

