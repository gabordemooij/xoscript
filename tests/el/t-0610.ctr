
>> Rectangle := Αντικείμενο νέο.

Rectangle όταν: ['area'] κάνε: { <- δικό μήκος * δικό width.
}.

Rectangle όταν: ['length:'] κάνε: { :μήκος
	δικό μήκος := μήκος.
}.

Rectangle όταν: ['width:'] κάνε: { :width
	δικό width := width.
}.

Rectangle όταν: ['νέο'] κάνε: {
	# this will not result into an infinite loop
	>> rectangle := εαυτός νέο.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle νέο.
Έξοδος γράψε: a area, νέα-γραμμή. #0

>> b := Rectangle νέο length: 2, width: 3.
Έξοδος γράψε: b area, νέα-γραμμή. #6

