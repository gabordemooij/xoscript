# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Μοτίβο νέο: pattern.
	p ταίριασμα: subject κάνε: { :m :g
		Έξοδος γράψε: g πλήθος, γράψε: [' '], γράψε: (g συνένωση: ['|']), νέα-γραμμή. <- m.
	}.
}.
show εφαρμογή: ['(a)|(b)'] και: ['b'].
show εφαρμογή: ['(a)|(b)'] και: ['a'].
show εφαρμογή: ['(x)?y'] και: ['y'].
show εφαρμογή: ['(x)?(y)(z)?'] και: ['xy'].
