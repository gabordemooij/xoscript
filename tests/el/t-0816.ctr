# μια μορφή πρέπει να ταιριάζει στον τύπο της τιμής, ο τύπος μπορεί να έρχεται από έναν πελάτη
>> δοκίμασε := { :διάταξη :value
	{ Έξοδος γράψε: ( (Μορφή νέο: διάταξη) εφαρμογή: value ), νέα-γραμμή. } σύλληψη: { :e Έξοδος γράψε: e, νέα-γραμμή. }, εκκίνηση.
}.
>> δοκίμασε-ακέραιο := { :διάταξη :value
	{ Έξοδος γράψε: ( (Μορφή νέο: διάταξη) εφαρμογή-ακεραίου: value ), νέα-γραμμή. } σύλληψη: { :e Έξοδος γράψε: e, νέα-γραμμή. }, εκκίνηση.
}.

# ταιριάζει
δοκίμασε εφαρμογή: ['|%s|'] και: ['text'].
δοκίμασε εφαρμογή: ['%06.2f'] και: 5.5.
δοκίμασε εφαρμογή: ['100%% %s'] και: ['σίγουρα'].
δοκίμασε-ακέραιο εφαρμογή: ['%03d'] και: 7.
δοκίμασε-ακέραιο εφαρμογή: ['%x'] και: 255.
δοκίμασε εφαρμογή: ['%d'] και: (Int64 νέο από-κείμενο: ['12']).
δοκίμασε εφαρμογή: ['%lld'] και: (Int64 νέο από-κείμενο: ['12']).
δοκίμασε εφαρμογή: ['%.1lf'] και: 5.5.
δοκίμασε-ακέραιο εφαρμογή: ['%hd'] και: 7.

# δεν ταιριάζει
δοκίμασε εφαρμογή: ['%s'] και: 12345.
δοκίμασε εφαρμογή: ['%d'] και: 12345.
δοκίμασε εφαρμογή: ['%f'] και: ['text'].
δοκίμασε-ακέραιο εφαρμογή: ['%d'] και: ['text'].
δοκίμασε-ακέραιο εφαρμογή: ['%s'] και: 5.
δοκίμασε εφαρμογή: ['%s %s'] και: ['text'].
δοκίμασε εφαρμογή: ['%n'] και: ['text'].
δοκίμασε εφαρμογή: ['%*s'] και: ['text'].
δοκίμασε εφαρμογή: ['%'] και: ['text'].

# ο τροποποιητής μήκους δεν ταιριάζει
δοκίμασε εφαρμογή: ['%ls'] και: ['text'].
δοκίμασε εφαρμογή: ['%Lf'] και: 5.5.
δοκίμασε-ακέραιο εφαρμογή: ['%ld'] και: 7.
δοκίμασε-ακέραιο εφαρμογή: ['%lld'] και: 7.
δοκίμασε εφαρμογή: ['%Ld'] και: (Int64 νέο από-κείμενο: ['12']).

# ένα πλάτος που δεν ταιριάζει στο printf πρέπει να δίνει σφάλμα, όχι κατάρρευση
δοκίμασε εφαρμογή: ['%99999999999s'] και: ['text'].
