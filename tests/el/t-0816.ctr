# a format must fit the type of the value, the type can come from a client
>> δοκίμασε := { :format :value
	{ Έξοδος γράψε: ( (Μορφή νέο: format) εφαρμογή: value ), νέα-γραμμή. } σύλληψη: { :e Έξοδος γράψε: e, νέα-γραμμή. }, εκκίνηση.
}.
>> try-int := { :format :value
	{ Έξοδος γράψε: ( (Μορφή νέο: format) εφαρμογή-ακεραίου: value ), νέα-γραμμή. } σύλληψη: { :e Έξοδος γράψε: e, νέα-γραμμή. }, εκκίνηση.
}.

# fits
δοκίμασε εφαρμογή: ['|%s|'] και: ['text'].
δοκίμασε εφαρμογή: ['%06.2f'] και: 5.5.
δοκίμασε εφαρμογή: ['100%% %s'] και: ['sure'].
try-int εφαρμογή: ['%03d'] και: 7.
try-int εφαρμογή: ['%x'] και: 255.
δοκίμασε εφαρμογή: ['%d'] και: (Int64 νέο από-κείμενο: ['12']).
δοκίμασε εφαρμογή: ['%lld'] και: (Int64 νέο από-κείμενο: ['12']).
δοκίμασε εφαρμογή: ['%.1lf'] και: 5.5.
try-int εφαρμογή: ['%hd'] και: 7.

# does not fit
δοκίμασε εφαρμογή: ['%s'] και: 12345.
δοκίμασε εφαρμογή: ['%d'] και: 12345.
δοκίμασε εφαρμογή: ['%f'] και: ['text'].
try-int εφαρμογή: ['%d'] και: ['text'].
try-int εφαρμογή: ['%s'] και: 5.
δοκίμασε εφαρμογή: ['%s %s'] και: ['text'].
δοκίμασε εφαρμογή: ['%n'] και: ['text'].
δοκίμασε εφαρμογή: ['%*s'] και: ['text'].
δοκίμασε εφαρμογή: ['%'] και: ['text'].

# length modifier does not fit
δοκίμασε εφαρμογή: ['%ls'] και: ['text'].
δοκίμασε εφαρμογή: ['%Lf'] και: 5.5.
try-int εφαρμογή: ['%ld'] και: 7.
try-int εφαρμογή: ['%lld'] και: 7.
δοκίμασε εφαρμογή: ['%Ld'] και: (Int64 νέο από-κείμενο: ['12']).

# a width that does not fit printf must give an error, not a crash
δοκίμασε εφαρμογή: ['%99999999999s'] και: ['text'].
