# Αυτή η δοκιμή ελέγχει αν το string_fill_in δεν χάνει τη θέση του (gc'ed) στη λειτουργία 4
# αναφορά στο world.c
>> Ημερολόγιο := Αντικείμενο νέο.

Ημερολόγιο όταν: ['say:'] κάνε: { :str
	Έξοδος γράψε: str, νέα-γραμμή.
}.

>> Είδος := Αντικείμενο νέο.

Είδος όταν: ['νέο:'] κάνε: { :id
	<- εαυτός νέο id: id.
}.

Είδος όταν: ['id:'] κάνε: { :id
	δικό id := id.
}.

Είδος όταν: ['id'] κάνε: { <- δικό id. }.


Είδος όταν: ['κείμενο'] κάνε: {
	>> str := ['Item#~no'].
	str ~no: δικό id.
	<- str.
}.


>> Print := Αντικείμενο νέο.

Print όταν: ['items'] κάνε: { 
	
	δικό είδος := Είδος νέο: 1.
	
	# είτε segfault είτε λάθος str εδώ
	Ημερολόγιο say: (
		['~item printed.'] ~item: δικό είδος
	).
	
	
}.

Print items.