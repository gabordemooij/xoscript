Έξοδος γράψε: ['Test object'], νέα-γραμμή.
>> a := Αντικείμενο νέο. 

a όταν: ['item:'] κάνε: { :out
	δικό out := out. 
}.

a όταν: ['item'] κάνε: { <- δικό out.
}.

a όταν: ['greet'] κάνε: {
	Έξοδος γράψε: ['hi from original out!'], νέα-γραμμή.
}.

a item: Έξοδος.

Έξοδος γράψε: a item, νέα-γραμμή.

>> old-out-address := a item πρωτότυπο διεύθυνση-μνήμης.
a save-as: ['/tmp/a.bin'].
Έξοδος γράψε: ['========== RELOADING SNAP:'], νέα-γραμμή.

>> b := Αντικείμενο load-from: ['/tmp/a.bin'].

(b item πρωτότυπο διεύθυνση-μνήμης = old-out-address) αληθές: {
	Έξοδος γράψε: ['Object link re-attached.'], νέα-γραμμή.
}.

b item γράψε: ['hello from loaded out!'], νέα-γραμμή.
b greet.
