#Linux

 >> t := Στιγμή νέο.
 
t ζώνη: ['Europe/Amsterdam'].
t έτος: 2020, μήνας: 8, ημέρα: 2, ώρα: 21, λεπτό: 2, δευτερόλεπτο: 1.

>> a := t ώρα.
>> ams := t ζώνη.

t ζώνη: ['US/Hawaii'].
>> b := t ώρα.
>> hw := t ζώνη.

Έξοδος
γράψε: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		είτε: ['later'] είτε: ['earlier']
	)
),
νέα-γραμμή.
 