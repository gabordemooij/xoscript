Έξοδος γράψε: ['Test object'], νέα-γραμμή.
>> greeter := Αντικείμενο νέο.
greeter όταν: ['name:'] κάνε: { :όνομα
	δικό xname := όνομα. 
}.
greeter όταν: ['greet'] κάνε: {
	Έξοδος γράψε: ['Hello '] + δικό xname, νέα-γραμμή.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Έξοδος γράψε: ['========== RELOADING SNAP:'], νέα-γραμμή.
>> b := Αντικείμενο load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
