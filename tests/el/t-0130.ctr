# χρήση FFI με το πρόσθετο Server

# σύνδεση με τη libc (εξαρτάται από την πλατφόρμα)
>> όνομα-βιβλιοθήκης := Πρόγραμμα ρύθμιση: ['FFITESTLIB'].

# σύνδεση συναρτήσεων stdio από τη C για προχωρημένες λειτουργίες αρχείων
Server σύνδεση: ( Λίστα νέο ;
 όνομα-βιβλιοθήκης ; ['fopen'] ;
 ( Λίστα νέο ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
σύνδεση: ( Λίστα νέο ;
 Κενό ; # σημαίνει την ίδια βιβλιοθήκη
 ['fread'] ;
 ( Λίστα νέο ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Κενό ; # σημαίνει το ίδιο αντικείμενο (δηλ. Ροή)
 ['fread']
),
σύνδεση: (
 Λίστα νέο ;
 Κενό ; # σημαίνει την ίδια βιβλιοθήκη
 ['fwrite'] ;
 ( Λίστα νέο ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Κενό ; # σημαίνει την ίδια βιβλιοθήκη
 ['fwrite']
),
σύνδεση: (
 Λίστα νέο ;
 Κενό ; # σημαίνει την ίδια βιβλιοθήκη
 ['rewind'] ;
 ( Λίστα νέο ; ['pointer'] ) ;
 ['int'] ;
 Κενό ; # σημαίνει την ίδια βιβλιοθήκη
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> διαδρομή := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# άνοιγμα αρχείου με fopen(path, mode)
>> fd := Stream path: διαδρομή mode: mode.

# εγγραφή bytes από το ενδιάμεσο str στο αρχείο
>> γραμμένα-bytes := Stream μήνυμα: ['fwrite'] ορίσματα: (Λίστα νέο ; str ; 1 ; 6 ; fd ).
Έξοδος γράψε: γραμμένα-bytes, νέα-γραμμή.

# επαναφορά του δείκτη αρχείου στην αρχή
Stream rewind: fd.

# δέσμευση ενδιάμεσης μνήμης
>> ενδ := Blob νέο: 20.

# ανάγνωση από αρχείο
>> διαβασμένα-bytes := Stream μήνυμα: ['fread'] ορίσματα: (Λίστα νέο ; ενδ ; 1 ; 6 ; fd ).
Έξοδος γράψε: διαβασμένα-bytes, νέα-γραμμή.
Έξοδος γράψε: ενδ, νέα-γραμμή.

# αποδέσμευση μνήμης
str  αποδέσμευση.
διαδρομή αποδέσμευση.
mode αποδέσμευση.
ενδ  αποδέσμευση.


