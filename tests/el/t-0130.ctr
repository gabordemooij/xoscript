# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Πρόγραμμα ρύθμιση: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server σύνδεση: ( Λίστα νέο ;
 libname ; ['fopen'] ;
 ( Λίστα νέο ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
σύνδεση: ( Λίστα νέο ;
 Κενό ; # means same lib
 ['fread'] ;
 ( Λίστα νέο ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Κενό ; # means same object (i.e. Stream)
 ['fread']
),
σύνδεση: (
 Λίστα νέο ;
 Κενό ; # means same lib
 ['fwrite'] ;
 ( Λίστα νέο ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Κενό ; # means same lib
 ['fwrite']
),
σύνδεση: (
 Λίστα νέο ;
 Κενό ; # means same lib
 ['rewind'] ;
 ( Λίστα νέο ; ['pointer'] ) ;
 ['int'] ;
 Κενό ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> διαδρομή := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: διαδρομή mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream μήνυμα: ['fwrite'] ορίσματα: (Λίστα νέο ; str ; 1 ; 6 ; fd ).
Έξοδος γράψε: bytes-written, νέα-γραμμή.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob νέο: 20.

# read from file
>> bytes-read := Stream μήνυμα: ['fread'] ορίσματα: (Λίστα νέο ; buf ; 1 ; 6 ; fd ).
Έξοδος γράψε: bytes-read, νέα-γραμμή.
Έξοδος γράψε: buf, νέα-γραμμή.

# free memory
str  αποδέσμευση.
διαδρομή αποδέσμευση.
mode αποδέσμευση.
buf  αποδέσμευση.


