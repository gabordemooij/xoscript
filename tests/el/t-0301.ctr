


>> κρασί := Αντικείμενο νέο.


κρασί όταν: ['σεΚείμενο'] κάνε: { <- ['merlot'].
}.

κρασί όταν: ['naarTekst'] κάνε: { <- ['merlot'].
}.


κρασί όταν: ['='] κάνε: { :other wine <- ( εαυτός σεΚείμενο = other wine ).
}.

κρασί όταν: ['=='] κάνε: { :other wine <- ( εαυτός σεΚείμενο = other wine ).
}.



κρασί
	περίπτωση: ['cabernet'] κάνε: { Έξοδος γράψε: ['είναι Cabernet!']. },
	περίπτωση: ['syrah']    κάνε: { Έξοδος γράψε: ['είναι Syrah!'].    },
	περίπτωση: ['merlot']   κάνε: { Έξοδος γράψε: ['είναι Merlot!'].   },
	περίπτωση: ['malbec']   κάνε: { Έξοδος γράψε: ['είναι Malbec!'].   }.

Έξοδος νέα-γραμμή.
