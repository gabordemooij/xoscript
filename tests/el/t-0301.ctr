


>> wine := Αντικείμενο νέο.


wine όταν: ['toString'] κάνε: { <- ['merlot'].
}.

wine όταν: ['naarTekst'] κάνε: { <- ['merlot'].
}.


wine όταν: ['='] κάνε: { :other wine <- ( εαυτός toString = other wine ).
}.

wine όταν: ['=='] κάνε: { :other wine <- ( εαυτός toString = other wine ).
}.



wine
	περίπτωση: ['cabernet'] κάνε: { Έξοδος γράψε: ['it's a Cabernet!']. },
	περίπτωση: ['syrah']    κάνε: { Έξοδος γράψε: ['it's a Syrah!'].    },
	περίπτωση: ['merlot']   κάνε: { Έξοδος γράψε: ['it's a Merlot!'].   },
	περίπτωση: ['malbec']   κάνε: { Έξοδος γράψε: ['it's a Malbec!'].   }.

Έξοδος νέα-γραμμή.
