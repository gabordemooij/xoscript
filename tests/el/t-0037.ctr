>> a := 3.
>> b := a αντιγραφή.
a αφαίρεση: 1.
Έξοδος γράψε: [' a = '] + a.
Έξοδος γράψε: [' b = '] + b.
a := 3.
b := a + 4.
Έξοδος γράψε: [' a = '] + a.
Έξοδος γράψε: [' b = '] + b.
>> x := 3.
>> y := x αντιγραφή.
x πρόσθεση: 10.
y αφαίρεση: 1.
Έξοδος γράψε: [' x = '] + x.
Έξοδος γράψε: [' y = '] + y.
>> q := Αντικείμενο νέο.
q όταν: ['setProperty:'] κάνε: { :x
	δικό ιδιοτ := x.
}.
q όταν: ['πάρεΙδιότητα'] κάνε: { <- δικό ιδιοτ.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Έξοδος γράψε: [' p = '] + (p πάρεΙδιότητα).
