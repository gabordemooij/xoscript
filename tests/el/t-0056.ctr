>> z := Αντικείμενο νέο.
z όταν: ['value:'] κάνε: { :v
	δικό value := v. <- εαυτός.
}.
z όταν: ['value'] κάνε: { <- δικό value. }.
(z setValue: 1) value: 2.
Έξοδος γράψε: z value.
>> x := z.
Έξοδος γράψε: x value.
z := Κενό.
Έξοδος γράψε: z value.
Έξοδος γράψε: x value.
Έξοδος γράψε: ['hello'].
Έξοδος γράψε: 3 + 2.
Έξοδος γράψε: (3 > 2).
