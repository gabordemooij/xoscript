>> items := Λεξικό νέο.
items τοποθέτηση: ['σκέτος'] στο: ['coffee'], τοποθέτηση: ['earl grey'] στο: ['τσάι'].
Έξοδος γράψε: (items στο: ['coffee']), γράψε: (items στο: ['τσάι']).
Έξοδος γράψε: ['υπάρχουν'] + items πλήθος + [' στοιχεία στη λίστα.'].
items τοποθέτηση: ['καπουτσίνο'] στο: ['coffee'].
Έξοδος γράψε: ['Τώρα ο καφές μου είναι.. '] + (items στο: ['coffee']).
items τοποθέτηση: ['aaa'] στο: ['1'].
items τοποθέτηση: ['bbb'] στο: ['2'].
Έξοδος γράψε: (items στο: ['a']).
