>> items := Λεξικό νέο.
items τοποθέτηση: ['black'] στο: ['coffee'], τοποθέτηση: ['earl grey'] στο: ['tea'].
Έξοδος γράψε: (items στο: ['coffee']), γράψε: (items στο: ['tea']).
Έξοδος γράψε: ['there are'] + items πλήθος + [' items in the array.'].
items τοποθέτηση: ['capuccino'] στο: ['coffee'].
Έξοδος γράψε: ['Now my coffee is.. '] + (items στο: ['coffee']).
items τοποθέτηση: ['aaa'] στο: ['1'].
items τοποθέτηση: ['bbb'] στο: ['2'].
Έξοδος γράψε: (items στο: ['a']).
