>> οινοποιείο := { <- (	Λεξικό νέο
		τοποθέτηση: 2 στο: ['merlot'],
		τοποθέτηση: 3 στο: ['malbec'],
		τοποθέτηση: 4 στο: ['syrah']
	).
}.

