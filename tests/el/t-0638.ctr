
Server init.
>> rq := HTTP-Αίτημα νέο.
Έξοδος γράψε: ['HTTP-GET d[]=']  + ( rq get-λίστα: ['d[]'] ), νέα-γραμμή. # GET
Έξοδος γράψε: ['HTTP-GET f[]=']  + ( rq get-λίστα: ['f[]'] ), νέα-γραμμή. # GET
Έξοδος γράψε: ['HTTP-POST e[]='] + ( rq post-λίστα: ['e[]'] ), νέα-γραμμή. # GET
Έξοδος γράψε: ['HTTP-POST c=']   + ( rq post: ['c'] ), νέα-γραμμή. # GET
Έξοδος γράψε: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), νέα-γραμμή. # GET
