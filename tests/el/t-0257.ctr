
>> Χαιρετιστής := Αντικείμενο νέο.
Χαιρετιστής όταν: ['νέο'] κάνε: {
	δικό όνομα := ['?'].
}.
Χαιρετιστής όταν: ['name:'] κάνε: { :όνομα
	δικό όνομα := όνομα.
}.
Χαιρετιστής όταν: ['χαιρέτα'] κάνε: {
	Έξοδος γράψε: (['hello[you]'] [you]: δικό όνομα).
}.
>> φίλος := Χαιρετιστής νέο.
φίλος name: ['1'].
φίλος χαιρέτα.
