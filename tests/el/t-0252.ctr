#Linux
>> clock := Στιγμή νέο.
clock ζώνη: ['UTC-1'].
clock έτος: 1981, μήνας: 1, ημέρα: 5,
      ώρα: 13, λεπτό: 15, δευτερόλεπτο: 13.

Έξοδος γράψε: clock, νέα-γραμμή.
clock ζώνη: ['UTC+0'].

Έξοδος γράψε: (
	(clock έτος απλό) + ['-'] + (clock μήνας) + ['-'] + (clock ημέρα) + [' '] +
	(clock ώρα) + [':'] + (clock λεπτό) + [':'] + (clock δευτερόλεπτο) + [' '] +
	['W'] + (clock εβδομάδα) + (clock ζώνη)
), νέα-γραμμή.


clock ζώνη: ['UTC-1'].
Έξοδος γράψε: (
	(clock έτος απλό) + ['-'] + (clock μήνας) + ['-'] + (clock ημέρα) + [' '] +
	(clock ώρα) + [':'] + (clock λεπτό) + [':'] + (clock δευτερόλεπτο) + [' '] +
	['W'] + (clock εβδομάδα) + (clock ζώνη)
), νέα-γραμμή.
