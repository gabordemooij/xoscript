

Λίστα όταν: ['column:'] κάνε: { :column
	>> result := Λίστα νέο.
	εαυτός κάθε: { :index :row
		row κάθε: { :index :cell
			(index = column) αληθές: { result προσθήκη-στο-τέλος: cell. }.
		}.
	}. <- result.
}.


>> a := Λίστα ←
	(Λίστα ← 1 ; 2 ; 3) ;
	(Λίστα ← 4 ; 5 ; 6) ;
	(Λίστα ← 7 ; 8 ; 9).

>> b := a column: 1.
Έξοδος γράψε: b, νέα-γραμμή.

b := a column: 20.
Έξοδος γράψε: b, νέα-γραμμή.

b := a column: -100.
Έξοδος γράψε: b, νέα-γραμμή.
