

Λίστα όταν: ['column:'] κάνε: { :στήλη
	>> έκβαση := Λίστα νέο.
	εαυτός κάθε: { :αύξων :σειρά
		σειρά κάθε: { :αύξων :κελί
			(αύξων = στήλη) αληθές: { έκβαση προσθήκη-στο-τέλος: κελί. }.
		}.
	}. <- έκβαση.
}.


>> a := Λίστα ←
	(Λίστα ← 1 ; 2 ; 3) ;
	(Λίστα ← 4 ; 5 ; 6) ;
	(Λίστα ← 7 ; 8 ; 9).

>> b := a column: 1.
Έξοδος γράψε: b, νέα-γραμμή.

b := a column: 20.
Έξοδος γράψε: b, νέα-γραμμή.

b := a column: -100.
Έξοδος γράψε: b, νέα-γραμμή.
