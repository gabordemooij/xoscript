

>> χρησιμοποιημένηΜνήμη1 := 0.
>> χρησιμοποιημένηΜνήμη2 := 0.
>> χρησιμοποιημένηΜνήμη3 := 0.
>> χρησιμοποιημένηΜνήμη4 := 0.

Πρόγραμμα διαχείριση-μνήμης: 0.

Αριθμός όταν: ['addNum:'] κάνε: { :x
	εαυτός πρόσθεση: x.
}.

Αριθμός όταν: ['subtractNum:'] κάνε: { :x
	εαυτός αφαίρεση: x.
}.

Αριθμός όταν: ['multiplyBy:'] κάνε: { :x
	εαυτός πολλαπλασιασμός-με: x.
}.

Αριθμός όταν: ['divideBy:'] κάνε: { :x
	εαυτός διαίρεση-με: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 δύναμη: 8).  
a := a + (2 δύναμη: -1). 
a := a + (49 τετραγωνική-ρίζα).   
a addNum: ((Λίστα ← 0 ; 1) μέγιστο).          
a addNum: ((Λίστα ← 2 ; 3) ελάχιστο).
Έξοδος γράψε: a.

