

Λίστα όταν: ['άθροισμα'] κάνε: {
	>> σύνολο := 0.
	εαυτός κάθε: { :αύξων :στοιχείο
		σύνολο πρόσθεση: στοιχείο.
	}. <- σύνολο.
}.

Λίστα όταν: ['γινόμενο'] κάνε: {
	>> σύνολο := 1.
	εαυτός κάθε: { :αύξων :στοιχείο
		σύνολο πολλαπλασιασμός-με: στοιχείο.
	}. <- σύνολο.
}.

>> χρησιμοποιημένηΜνήμη1 := 0.
>> χρησιμοποιημένηΜνήμη2 := 0.
>> χρησιμοποιημένηΜνήμη3 := 0.
>> χρησιμοποιημένηΜνήμη4 := 0.

Πρόγραμμα διαχείριση-μνήμης: 0.

{

>> a := Λίστα ← ['hello'] ; ['world'] ; Αληθές ; Κενό ; 666.
a := a + ( Λίστα ← 1 ).
Έξοδος γράψε: ( ['άθροισμα: '] + ( a άθροισμα ) ), νέα-γραμμή.
Έξοδος γράψε: ( ['ελάχ: '] + ( a ελάχιστο ) ), νέα-γραμμή.
Έξοδος γράψε: ( ['μέγ: '] + ( a μέγιστο ) ), νέα-γραμμή.
Έξοδος γράψε: ( ['3ο: '] + ( a ? 2 ) ), νέα-γραμμή.
Έξοδος γράψε: ( ['γιν: '] + ( a γινόμενο ) ), νέα-γραμμή.
a ταξινόμηση: { :a :b <- (b - a). }.
a κάθε: { :i :e Έξοδος γράψε: ( i - 0 ), νέα-γραμμή. }.

} εκκίνηση.

Πρόγραμμα καθαρισμός.
χρησιμοποιημένηΜνήμη1 := (Πρόγραμμα μνήμη ? 0).


