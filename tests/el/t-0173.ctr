

Λίστα όταν: ['sum'] κάνε: {
	>> total := 0.
	εαυτός κάθε: { :index :element
		total πρόσθεση: element.
	}. <- total.
}.

Λίστα όταν: ['product'] κάνε: {
	>> total := 1.
	εαυτός κάθε: { :index :element
		total πολλαπλασιασμός-με: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Πρόγραμμα διαχείριση-μνήμης: 0.

{

>> a := Λίστα ← ['hello'] ; ['world'] ; Αληθές ; Κενό ; 666.
a := a + ( Λίστα ← 1 ).
Έξοδος γράψε: ( ['sum: '] + ( a sum ) ), νέα-γραμμή.
Έξοδος γράψε: ( ['min: '] + ( a ελάχιστο ) ), νέα-γραμμή.
Έξοδος γράψε: ( ['max: '] + ( a μέγιστο ) ), νέα-γραμμή.
Έξοδος γράψε: ( ['3rd: '] + ( a ? 2 ) ), νέα-γραμμή.
Έξοδος γράψε: ( ['prd: '] + ( a product ) ), νέα-γραμμή.
a ταξινόμηση: { :a :b <- (b - a). }.
a κάθε: { :i :e Έξοδος γράψε: ( i - 0 ), νέα-γραμμή. }.

} εκκίνηση.

Πρόγραμμα καθαρισμός.
usedMemory1 := (Πρόγραμμα μνήμη ? 0).


{

>> a := Λίστα ← ['hello'] ; ['world'] ; Αληθές ; Κενό ; 666.
a := a + ( Λίστα ← 1 ).
Έξοδος γράψε: ( ['sum: '] + ( a sum ) ), νέα-γραμμή.
Έξοδος γράψε: ( ['min: '] + ( a ελάχιστο ) ), νέα-γραμμή.
Έξοδος γράψε: ( ['max: '] + ( a μέγιστο ) ), νέα-γραμμή.
Έξοδος γράψε: ( ['3rd: '] + ( a ? 2 ) ), νέα-γραμμή.
Έξοδος γράψε: ( ['prd: '] + ( a product ) ), νέα-γραμμή.
a ταξινόμηση: { :a :b <- (b - a). }.
a κάθε: { :i :e Έξοδος γράψε: ( i - 0 ), νέα-γραμμή. }.

} εκκίνηση.



Πρόγραμμα καθαρισμός.
usedMemory2 := (Πρόγραμμα μνήμη ? 0).


{

>> a := Λίστα ← ['hello'] ; ['world'] ; Αληθές ; Κενό ; 666.
a := a + ( Λίστα ← 1 ).
Έξοδος γράψε: ( ['sum: '] + ( a sum ) ), νέα-γραμμή.
Έξοδος γράψε: ( ['min: '] + ( a ελάχιστο ) ), νέα-γραμμή.
Έξοδος γράψε: ( ['max: '] + ( a μέγιστο ) ), νέα-γραμμή.
Έξοδος γράψε: ( ['3rd: '] + ( a ? 2 ) ), νέα-γραμμή.
Έξοδος γράψε: ( ['prd: '] + ( a product ) ), νέα-γραμμή.
a ταξινόμηση: { :a :b <- (b - a). }.
a κάθε: { :i :e Έξοδος γράψε: ( i - 0 ), νέα-γραμμή. }.

} εκκίνηση.



Πρόγραμμα καθαρισμός.
usedMemory3 := (Πρόγραμμα μνήμη ? 0).

( usedMemory1 = usedMemory2 και: usedMemory1 = usedMemory3, και: usedMemory2 = usedMemory3 ) αληθές: {
	Έξοδος γράψε: ['No memory leaks here'].
}, ψευδές: {
	Έξοδος γράψε: ['Leaking memory...'].
}.
