Server init.

Έξοδος γράψε: (
	Μοτίβο νέο: ['^\\w+$'],
	ταίριασμα: ['test@example.com'] 
), νέα-γραμμή. # 0 match, fails on @ and .

Έξοδος γράψε: (
	Μοτίβο νέο: ['^[^@]+@[^\.]+\.\\w+$'],
	ταίριασμα: ['test@example.com'] 
), νέα-γραμμή. # 1 match

Έξοδος γράψε: (
	Μοτίβο νέο: ['[^@]+@[^\.]+\.\\w+'],
	ταίριασμα: ['test@example.com'] 
), νέα-γραμμή. # 1 match

Έξοδος γράψε: (
	Μοτίβο νέο: ['([^@]+)@([^\.]+)\.\\w+'],
	ταίριασμα: ['test@example.com'] 
), νέα-γραμμή. # 1 match, groups dont matter

Έξοδος γράψε: (
	Μοτίβο νέο: ['[a-z]'],
	ταίριασμα: ['test@example.com'] 
), νέα-γραμμή. # 14 matches

Έξοδος γράψε: (
	Μοτίβο νέο: ['.*'],
	ταίριασμα: ['test@example.com'] 
), νέα-γραμμή. # 1 match (all)

Έξοδος γράψε: (
	Μοτίβο νέο: ['(.*)'],
	ταίριασμα: ['test@example.com'] 
), νέα-γραμμή. # 1 match (all)

Έξοδος γράψε: (
	Μοτίβο νέο: ['\\s*[^@]+@[^\.]+\.\\w+'],
	ταίριασμα: ['test@example.com'] 
), νέα-γραμμή. # 1 match, prefix space optional, gets ignored