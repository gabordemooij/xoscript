>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Αντικείμενο νέο.
⚄ όταν: ['drawFrom:length:'] κάνε: { :pool :πλήθος
	
	>> result := [''].
	
	{
		>> index := Αριθμός random % (pool μήκος).
		result προσθήκη-στο-τέλος: ( pool χαρακτήρας: (index + 1) ).
		
	} × πλήθος. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? μήκος.
Έξοδος γράψε: (['x↵'] x random μήκος).
Έξοδος γράψε: (['y↵'] y ?? μήκος).

