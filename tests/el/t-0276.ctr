>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Αντικείμενο νέο.
⚄ όταν: ['τράβηξεΑπό:μήκος:'] κάνε: { :δεξαμενή :πλήθος
	
	>> έκβαση := [''].
	
	{
		>> αύξων := Αριθμός τυχαίο % (δεξαμενή μήκος).
		έκβαση προσθήκη-στο-τέλος: ( δεξαμενή χαρακτήρας: (αύξων + 1) ).
		
	} × πλήθος. <- έκβαση.
}.

>> τυχαίο := ⚄ τράβηξεΑπό: ?? μήκος: ?? μήκος.
Έξοδος γράψε: (['x↵'] x τυχαίο μήκος).
Έξοδος γράψε: (['y↵'] y ?? μήκος).

