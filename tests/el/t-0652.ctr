# test number -> string -> number
{

	>> x := Αριθμός μεταξύ: 0 και: 1000000.
	>> d := Αριθμός μεταξύ: 1 και: 7.
	>> e := 10 δύναμη: d.

	x διαίρεση-με: e.
	>> y := x κείμενο αριθμός.

	(x = y) ψευδές: {
		Έξοδος γράψε: x, νέα-γραμμή.
		Έξοδος γράψε: y, νέα-γραμμή.
		Πρόγραμμα τέλος.
	}.

} * 1000.
Έξοδος γράψε: ['OK'], νέα-γραμμή.