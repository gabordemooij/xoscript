Αριθμός όταν: ['ρωμαϊκό'] κάνε: {
	>> αριθμός := εαυτός αντιγραφή.
	>> ρωμαϊκό := [''].
	{
		{
			(αριθμός ≥ 1000) αληθές: {
				ρωμαϊκό προσθήκη-στο-τέλος: ['Ⅿ'].
				αριθμός αφαίρεση: 1000.
			}, διακοπή.
		
			(αριθμός ≥ 500) αληθές: {
				ρωμαϊκό προσθήκη-στο-τέλος: ['Ⅾ'].
				αριθμός αφαίρεση: 500.
			}, διακοπή.
		
			(αριθμός ≥ 100) αληθές: {
				ρωμαϊκό προσθήκη-στο-τέλος: ['Ⅽ'].
				αριθμός αφαίρεση: 100.
			}, διακοπή.
		
			(αριθμός ≥ 50) αληθές: {
				ρωμαϊκό προσθήκη-στο-τέλος: ['Ⅼ'].
				αριθμός αφαίρεση: 50.
			}, διακοπή.
		
			(αριθμός ≥ 50) αληθές: {
				ρωμαϊκό προσθήκη-στο-τέλος: ['Ⅼ'].
				αριθμός αφαίρεση: 50.
			}, διακοπή.
		
			(αριθμός ≥ 10) αληθές: {
				ρωμαϊκό προσθήκη-στο-τέλος: ['Ⅹ'].
				αριθμός αφαίρεση: 10.
			}, διακοπή.
			
			(αριθμός ≥ 9) αληθές: {
				ρωμαϊκό προσθήκη-στο-τέλος: ['Ⅸ'].
				αριθμός αφαίρεση: 9.
			}, διακοπή.
			
			(αριθμός ≥ 5) αληθές: {
				ρωμαϊκό προσθήκη-στο-τέλος: ['Ⅴ'].
				αριθμός αφαίρεση: 5.
			}, διακοπή.
			
			(αριθμός ≥ 4) αληθές: {
				ρωμαϊκό προσθήκη-στο-τέλος: ['Ⅳ'].
				αριθμός αφαίρεση: 4.
			}, διακοπή.
			
			(αριθμός ≥ 1) αληθές: {
				ρωμαϊκό προσθήκη-στο-τέλος: ['Ⅰ'].
				αριθμός αφαίρεση: 1.
			}, διακοπή.
		} διαδικασία.
	} ενώ: { <- αριθμός > 0. }. <- ρωμαϊκό.
}.

Έξοδος γράψε: 1 ρωμαϊκό, νέα-γραμμή.
Έξοδος γράψε: 2 ρωμαϊκό, νέα-γραμμή.
