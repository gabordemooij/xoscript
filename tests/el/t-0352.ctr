Αριθμός όταν: ['roman'] κάνε: {
	>> αριθμός := εαυτός αντιγραφή.
	>> roman := [''].
	{
		{
			(αριθμός ≥ 1000) αληθές: {
				roman προσθήκη-στο-τέλος: ['Ⅿ'].
				αριθμός αφαίρεση: 1000.
			}, διακοπή.
		
			(αριθμός ≥ 500) αληθές: {
				roman προσθήκη-στο-τέλος: ['Ⅾ'].
				αριθμός αφαίρεση: 500.
			}, διακοπή.
		
			(αριθμός ≥ 100) αληθές: {
				roman προσθήκη-στο-τέλος: ['Ⅽ'].
				αριθμός αφαίρεση: 100.
			}, διακοπή.
		
			(αριθμός ≥ 50) αληθές: {
				roman προσθήκη-στο-τέλος: ['Ⅼ'].
				αριθμός αφαίρεση: 50.
			}, διακοπή.
		
			(αριθμός ≥ 50) αληθές: {
				roman προσθήκη-στο-τέλος: ['Ⅼ'].
				αριθμός αφαίρεση: 50.
			}, διακοπή.
		
			(αριθμός ≥ 10) αληθές: {
				roman προσθήκη-στο-τέλος: ['Ⅹ'].
				αριθμός αφαίρεση: 10.
			}, διακοπή.
			
			(αριθμός ≥ 9) αληθές: {
				roman προσθήκη-στο-τέλος: ['Ⅸ'].
				αριθμός αφαίρεση: 9.
			}, διακοπή.
			
			(αριθμός ≥ 5) αληθές: {
				roman προσθήκη-στο-τέλος: ['Ⅴ'].
				αριθμός αφαίρεση: 5.
			}, διακοπή.
			
			(αριθμός ≥ 4) αληθές: {
				roman προσθήκη-στο-τέλος: ['Ⅳ'].
				αριθμός αφαίρεση: 4.
			}, διακοπή.
			
			(αριθμός ≥ 1) αληθές: {
				roman προσθήκη-στο-τέλος: ['Ⅰ'].
				αριθμός αφαίρεση: 1.
			}, διακοπή.
		} διαδικασία.
	} ενώ: { <- αριθμός > 0. }. <- roman.
}.

Έξοδος γράψε: 1 roman, νέα-γραμμή.
Έξοδος γράψε: 2 roman, νέα-γραμμή.
Έξοδος γράψε: 4 roman, νέα-γραμμή.
Έξοδος γράψε: 8 roman, νέα-γραμμή.
Έξοδος γράψε: 16 roman, νέα-γραμμή.
Έξοδος γράψε: 32 roman, νέα-γραμμή.
Έξοδος γράψε: 64 roman, νέα-γραμμή.
Έξοδος γράψε: 128 roman, νέα-γραμμή.
Έξοδος γράψε: 256 roman, νέα-γραμμή.
Έξοδος γράψε: 1024 roman, νέα-γραμμή.
