
Πρόγραμμα διαχείριση-μνήμης: 4.

>> Animal := Αντικείμενο νέο.
Animal όταν: ['make'] κάνε: {
	>> animal := Αντικείμενο νέο.
	animal όταν: ['makeSound'] κάνε: {
		Έξοδος γράψε: δικό sound.
	}. <- animal.
}.
>> Cat := Αντικείμενο νέο.
Cat όταν: ['make'] κάνε: {
	>> cat := Animal make.
	cat όταν: ['init'] κάνε: {
		δικό sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
