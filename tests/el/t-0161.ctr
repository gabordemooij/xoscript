	>> σύνολο := 0.
	εαυτός κάθε: { :αύξων :στοιχείο
		σύνολο πρόσθεση: στοιχείο.
	}. <- σύνολο.
}.

>> χρησιμοποιημένηΜνήμη1 := 0.
