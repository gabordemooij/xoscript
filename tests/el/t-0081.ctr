>> map1 := Λεξικό νέο.
>> key1 := Λίστα νέο.
>> key2 := Λίστα νέο.

map1
	τοποθέτηση: ['hello'] στο: key1,
	τοποθέτηση: ['world'] στο: key2.


Έξοδος
	γράψε: ['Map #1 contains: '] + (map1 στο: key1),
	γράψε: [' and '] + (map1 στο: key2), νέα-γραμμή.

>> KeyeableArray := Λίστα νέο.
KeyeableArray όταν: ['toString'] κάνε: { <- (εαυτός πλήθος) toString.
}.

>> map2 := Λεξικό νέο.
key1 := KeyeableArray νέο.
key2 := KeyeableArray νέο.

key1 προσθήκη-στο-τέλος: 1.

map2
	τοποθέτηση: ['hello'] στο: key1,
	τοποθέτηση: ['world'] στο: key2.

Έξοδος
	γράψε: ['Map #2 contains: '] + (map2 στο: key1),
	γράψε: [' and '] + (map2 στο: key2), νέα-γραμμή.
