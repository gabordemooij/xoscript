# Δοκιμή εξυγίανσης utf8
Server init.

>> περιπτώσεις-utf8 := Λεξικό νέο
	# Μόνο ASCII
	τοποθέτηση: ( Λίστα νέο ; 65 ; 65 ; 65 ; 65 ; 0 ) στο: ['AAAA'],
	# έγκυρη ακολουθία 2 bytes
	τοποθέτηση: ( Λίστα νέο ; 194 ; 162 ; 0 ) στο: ['¢'],
	# Έγκυρο UTF-8 3 bytes
    τοποθέτηση: ( Λίστα νέο ; 226 ; 130 ; 172 ; 0 ) στο: ['€'],
	# Έγκυρο UTF-8 4 bytes
    τοποθέτηση: ( Λίστα νέο ; 240 ; 144 ; 141 ; 136 ; 0 ) στο: ['𐍈'],
	# Άκυρο byte συνέχειας στην ακολουθία E2 28 AC -> αρχή ακολουθίας 3b + 28 λάθος συνέχεια + AC byte συνέχειας, αλλά ανήκει στο ίδιο σφάλμα
    τοποθέτηση: ( Λίστα νέο ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) στο: ['A?A'],
	# Υπερβολικά μακριά κωδικοποίηση του ASCII 'A' (πρέπει να γίνει ?),
    τοποθέτηση: ( Λίστα νέο ; 65 ; 193 ; 129 ; 0 ) στο: ['A?'],
	# Άκυρο πρώτο byte (0xFF)
    τοποθέτηση: ( Λίστα νέο ; 255 ; 0 ) στο: ['?'],
	# Ημιτελής ακολουθία πολλών bytes στο τέλος
    τοποθέτηση: ( Λίστα νέο ; 66 ; 226 ; 0 ) στο: ['B?'],
    # Κενό κείμενο
    #put: ( List new ) at: [''],
	# Πολλαπλές μικτές ακολουθίες
    τοποθέτηση: ( Λίστα νέο ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) στο: ['A€?𐍈B'].
	 
περιπτώσεις-utf8 κάθε: { :key :value
	>> blob := Blob νέο: value πλήθος, bytes: value.
	>> str := blob κείμενο.
	(str = key) αληθές: {
		Έξοδος γράψε: ['OK'], νέα-γραμμή.
	}, αλλιώς: {
		Έξοδος γράψε: ['Ο καθαριστής UTF8 απέτυχε σε: '] + key + [' έδωσε: '] + str, νέα-γραμμή.
	}.
	blob αποδέσμευση.
}.
