>> a := Αντικείμενο νέο. 
a όταν: ['greet'] κάνε: { Έξοδος γράψε: ['welcome!'], νέα-γραμμή. }.
a όταν: ['greet2'] κάνε: { Έξοδος γράψε: ['welcome2!'], νέα-γραμμή. }.
a save-as: ['/tmp/a.bin'].

Έξοδος γράψε: ['========== RELOADING SNAP:'], νέα-γραμμή.
>> b := Αντικείμενο load-from: ['/tmp/a.bin'].
b greet2.