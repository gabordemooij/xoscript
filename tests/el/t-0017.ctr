Αριθμός όταν: ['factorial'] κάνε: {
	>> total := 1.
	{ :index total πολλαπλασιασμός-με: (εαυτός - (index)). } × εαυτός. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Έξοδος γράψε: a.
>> b := 2 + 3 factorial.
Έξοδος γράψε: b.
>> c := 3 factorial + 2.
Έξοδος γράψε: c.
>> d := 2 + (3 factorial).
Έξοδος γράψε: d.
Έξοδος γράψε: 2 + 3 factorial + 1.
