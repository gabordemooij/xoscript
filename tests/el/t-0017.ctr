Αριθμός όταν: ['παραγοντικό'] κάνε: {
	>> σύνολο := 1.
	{ :αύξων σύνολο πολλαπλασιασμός-με: (εαυτός - (αύξων)). } × εαυτός. <- σύνολο.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Έξοδος γράψε: a.
>> b := 2 + 3 παραγοντικό.
Έξοδος γράψε: b.
>> c := 3 παραγοντικό + 2.
Έξοδος γράψε: c.
>> d := 2 + (3 παραγοντικό).
Έξοδος γράψε: d.
Έξοδος γράψε: 2 + 3 παραγοντικό + 1.
