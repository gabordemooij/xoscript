60 × {
	>> x := (Αριθμός random % 6) + 1.
	(x ≤ 6) ψευδές: { Έξοδος γράψε: ['FAIL']. }.
	(x ≥0) ψευδές: { Έξοδος γράψε: ['FAIL']. }.
	x := (Αριθμός random % 3) + 1.
	(x < 3) ψευδές: { Έξοδος γράψε: ['FAIL']. }.
	(x>-1) ψευδές: { Έξοδος γράψε: ['FAIL']. }.
	x := ((Λογικό flip) αριθμός).
	(x = 0 ή: x = 1) ψευδές: { Έξοδος γράψε: ['FAIL']. }.
	x := ((Αληθές flip) αριθμός).
	(x = 0 ή: x = 1) ψευδές: { Έξοδος γράψε: ['FAIL']. }.
	x := (Λογικό flip είτε: ['HEAD'] είτε: ['TAIL']).
	((x = ['HEAD']) ή: (x = ['TAIL'])) ψευδές: { Έξοδος γράψε: ['FAIL']. }.
}.
Έξοδος γράψε: ['DONE'].

