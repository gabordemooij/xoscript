60 × {
	>> x := (Αριθμός τυχαίο % 6) + 1.
	(x ≤ 6) ψευδές: { Έξοδος γράψε: ['ΑΠΟΤΥΧΙΑ']. }.
	(x ≥0) ψευδές: { Έξοδος γράψε: ['ΑΠΟΤΥΧΙΑ']. }.
	x := (Αριθμός τυχαίο % 3) + 1.
	(x < 3) ψευδές: { Έξοδος γράψε: ['ΑΠΟΤΥΧΙΑ']. }.
	(x>-1) ψευδές: { Έξοδος γράψε: ['ΑΠΟΤΥΧΙΑ']. }.
	x := ((Λογικό στρίψε) αριθμός).
	(x = 0 ή: x = 1) ψευδές: { Έξοδος γράψε: ['ΑΠΟΤΥΧΙΑ']. }.
	x := ((Αληθές στρίψε) αριθμός).
	(x = 0 ή: x = 1) ψευδές: { Έξοδος γράψε: ['ΑΠΟΤΥΧΙΑ']. }.
	x := (Λογικό στρίψε είτε: ['ΚΟΡΩΝΑ'] είτε: ['ΓΡΑΜΜΑΤΑ']).
	((x = ['ΚΟΡΩΝΑ']) ή: (x = ['ΓΡΑΜΜΑΤΑ'])) ψευδές: { Έξοδος γράψε: ['ΑΠΟΤΥΧΙΑ']. }.
}.
Έξοδος γράψε: ['ΕΤΟΙΜΟ'].

