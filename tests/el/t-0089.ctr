>> τυχαιοποιητής := { :a :b
	>> ελάχιστο := ( a < b ) είτε: a είτε: b.
	>> μέγιστο := ( a > b ) είτε: a είτε: b.
	>> x := Κενό.
	{
		x := Αριθμός μεταξύ: a και: b.
		((x < ελάχιστο) ή: (x > μέγιστο)) αληθές: { 
			Έξοδος γράψε: (['Μη έγκυρη τιμή!']).
			Πρόγραμμα τέλος.
		}.
	} 
	× 100. <- x.
}.
τυχαιοποιητής εφαρμογή: 0 και: 0.
τυχαιοποιητής εφαρμογή: 1 και: 0.
τυχαιοποιητής εφαρμογή: 1 και: 1.
