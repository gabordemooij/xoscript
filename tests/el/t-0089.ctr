>> randomizer := { :a :b
	>> ελάχιστο := ( a < b ) είτε: a είτε: b.
	>> μέγιστο := ( a > b ) είτε: a είτε: b.
	>> x := Κενό.
	{
		x := Αριθμός μεταξύ: a και: b.
		((x < ελάχιστο) ή: (x > μέγιστο)) αληθές: { 
			Έξοδος γράψε: (['Invalid value!']).
			Πρόγραμμα τέλος.
		}.
	} 
	× 100. <- x.
}.
