# catch-all test (practical)
>> HTML := Κείμενο νέο.
HTML όταν: ['encode:'] κάνε: { :tekst
	εαυτός προσθήκη-στο-τέλος: (tekst
	αντικατάσταση: ['&'] με: ['&amp;'], 
	αντικατάσταση: ['<'] με: ['&lt;'],
	αντικατάσταση: ['>'] με: ['&gt;'],
	αντικατάσταση: ['"'] με: ['&quot;']).
}.
>> blog := HTML νέο.
blog προσθήκη-στο-τέλος: ['<h1>'],
     encode: ['Koffie & Thee'],
     προσθήκη-στο-τέλος: ['</h1>'].
Έξοδος γράψε: blog, νέα-γραμμή.


>> Roman := Αριθμός νέο.
Roman όταν: ['stringy'] κάνε: {
	>> a := [''].
	{ a προσθήκη-στο-τέλος: ['I']. } × εαυτός. <- a.
}.

>> x := Roman νέο.
x πρόσθεση: 3.
Έξοδος γράψε: x stringy, νέα-γραμμή.

>> Quantum := Λογικό νέο.
Quantum όταν: ['true?'] κάνε: { <- ['maybe True']. }.
Έξοδος γράψε: (Quantum νέο true?), νέα-γραμμή.

>> Nihil := Κενό νέο.
Nihil όταν: ['κείμενο'] κάνε: { <- ['Nihil']. }.
Έξοδος γράψε: (Nihil νέο), νέα-γραμμή.
