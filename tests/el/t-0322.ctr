

>> Matryoshka := Αντικείμενο νέο.
Matryoshka όταν: ['double:'] κάνε: { :secret
	δικό secret := secret × 2.
}.
Matryoshka όταν: ['νέο:'] κάνε: { :secret
	>> answer := Κενό.
	>> t := (secret > 255).
	Έξοδος γράψε: (secret + [' | '] + t), νέα-γραμμή.
	t αληθές: {
		answer := secret.
	}, αλλιώς: {
		answer := Matryoshka αναδρομικό νέο: (εαυτός double: secret).
	}. <- answer.
}.

>> x := Matryoshka νέο: 2.
