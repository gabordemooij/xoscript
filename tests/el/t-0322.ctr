

>> Ματριόσκα := Αντικείμενο νέο.
Ματριόσκα όταν: ['double:'] κάνε: { :μυστικό
	δικό μυστικό := μυστικό × 2.
}.
Ματριόσκα όταν: ['νέο:'] κάνε: { :μυστικό
	>> απάντηση := Κενό.
	>> t := (μυστικό > 255).
	Έξοδος γράψε: (μυστικό + [' | '] + t), νέα-γραμμή.
	t αληθές: {
		απάντηση := μυστικό.
	}, αλλιώς: {
		απάντηση := Ματριόσκα αναδρομικό νέο: (εαυτός double: μυστικό).
	}. <- απάντηση.
}.

>> x := Ματριόσκα νέο: 2.
