>> φτιάξεΑθροιστή := { :x
	>> f := { :y <- (δικό x + y). } ορισμός: ['x'] τιμή: x. <- f.
}.
>> χαρτογράφος := { :πίνακας :συνάρτ
	>> χαρτογράφηση := { :i δικό q τοποθέτηση: (δικό f εφαρμογή: (δικό q ? i)) στο: i. } 
	ορισμός: ['q'] τιμή: πίνακας,
	ορισμός: ['f'] τιμή: συνάρτ.
	{ :i χαρτογράφηση εφαρμογή: i. } × (πίνακας πλήθος).
}.

>> a := Λίστα ← 1; 2; 3.
χαρτογράφος εφαρμογή: a και: (φτιάξεΑθροιστή εφαρμογή: 100).
Έξοδος γράψε: (a θέση: 0), νέα-γραμμή.
Έξοδος γράψε: (a ? 1), νέα-γραμμή.
Έξοδος γράψε: (a ? 2), νέα-γραμμή.
