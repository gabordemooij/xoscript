>> makeAdder := { :x
	>> f := { :y <- (δικό x + y). } ορισμός: ['x'] τιμή: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i δικό q τοποθέτηση: (δικό f εφαρμογή: (δικό q ? i)) στο: i. } 
	ορισμός: ['q'] τιμή: array,
	ορισμός: ['f'] τιμή: func.
	{ :i mapping εφαρμογή: i. } × (array πλήθος).
}.

>> a := Λίστα ← 1; 2; 3.
mapper εφαρμογή: a και: (makeAdder εφαρμογή: 100).
Έξοδος γράψε: (a θέση: 0), νέα-γραμμή.
Έξοδος γράψε: (a ? 1), νέα-γραμμή.
Έξοδος γράψε: (a ? 2), νέα-γραμμή.
