>> invoice := Αντικείμενο νέο.
invoice όταν: ['εκκίνηση'] κάνε: {
        δικό αριθμός := 0.
}.

invoice όταν: ['αριθμός'] κάνε: {
        δικό αριθμός πρόσθεση: 1. <- δικό αριθμός αντιγραφή.
}.

>> year-invoice := invoice νέο.
year-invoice όταν: ['start:'] κάνε: { :έτος
	δικό αριθμός := έτος.
}.

year-invoice start: 202000.
Έξοδος γράψε: year-invoice αριθμός, νέα-γραμμή.
Έξοδος γράψε: year-invoice αριθμός, νέα-γραμμή.
