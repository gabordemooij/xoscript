Server init.
Έξοδος γράψε: ['Database date test'], νέα-γραμμή.

>> db := Maria-DB νέο κόμβος: ['localhost'],
	χρήστης: ['xo'], 
	κωδικός: ['pass123'],
	όνομα-βάσης: ['xobase'],
	συνδέσου.

>> παράμετροι-αναζήτησης :=
db ερώτημα: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
ανάκτηση: { :row
	Έξοδος γράψε: row datetest, νέα-γραμμή.
}.
