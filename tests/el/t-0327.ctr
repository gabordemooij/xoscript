

Λίστα όταν: ['fixture:'] κάνε: { :f
	δικό σταθερό := f.
}.

Λίστα όταν: ['πλήθος'] κάνε: { <- δικό σταθερό.
}.

Λίστα όταν: ['aantal'] κάνε: { <- δικό σταθερό.
}.


>> x := Κενό.
{

	x := ['hello'] 
	αντικατάσταση:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] χαρακτήρας: 2)
			)
		)
	με: (
		(['...hal'] + ['lo']) 
			κεφαλαία 
			lowecase 
			κεφαλαία 
			μετατόπιση: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Λίστα ← 0 ; 1 ; 4; 9 ; (Λίστα ← 0 ; 3; 1) ; 4
							) προτελευταίο
						) ? 1
					) + 
					((Λίστα ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					πλήθος
				)
			)
	).

} × 10.
Έξοδος γράψε: x, νέα-γραμμή.

