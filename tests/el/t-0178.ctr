

>> χρησιμοποιημένηΜνήμη1 := 0.
>> χρησιμοποιημένηΜνήμη2 := 0.
>> χρησιμοποιημένηΜνήμη3 := 0.
>> χρησιμοποιημένηΜνήμη4 := 0.

Πρόγραμμα διαχείριση-μνήμης: 0.

>> txt := ['Word Salad'].
Έξοδος γράψε: ['τελευταία θέση του ord = '] + (( txt τελευταίο: ['ord'] ) - 0), νέα-γραμμή.
Έξοδος γράψε: ['θέση του ord = '] + (( txt εύρεση: ['ord'] ) - 0), νέα-γραμμή.
Έξοδος γράψε: ['θέση του ad = '] + (( txt εύρεση: ['ad'] ) - 0), νέα-γραμμή.
Έξοδος γράψε: ['τελευταία θέση του W = '] + (( txt τελευταίο: ['W'] ) - 0), νέα-γραμμή.
Έξοδος γράψε: ['τελευταία θέση του d = '] + (( txt τελευταίο: ['d'] ) - 0), νέα-γραμμή.
Έξοδος γράψε: ['κμ ίσο με Σαλάτα Λέξεων = '] + ( txt = ['Word Salad'] ), νέα-γραμμή.
Έξοδος γράψε: ['κμ ίσο με Σαλάτα Καίσαρα = '] + ( txt = ['Σαλάτα Καίσαρα'] ), νέα-γραμμή.
Έξοδος γράψε: ['κμ διάφορο από Σαλάτα Λέξεων = '] + ( txt ≠ ['Word Salad'] ), νέα-γραμμή.
Έξοδος γράψε: ['κμ διάφορο από Σαλάτα Καίσαρα = '] + ( txt ≠ ['Σαλάτα Καίσαρα'] ), νέα-γραμμή.

