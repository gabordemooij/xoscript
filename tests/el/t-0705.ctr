

>> obj := Αντικείμενο νέο.

obj όταν: ['greet'] κάνε: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj όταν: ['task'] κάνε: {
	δικό property := 123.
	{
		# try binds self/own to object instead of block
		Έξοδος γράψε: εαυτός greet.
		Έξοδος γράψε: δικό property.
		1 / 0.
	} σύλληψη: {
		Έξοδος γράψε: εαυτός greet.
		Έξοδος γράψε: δικό property.
		Έξοδος γράψε: ['ok'].
	}, δοκίμασε.
}.

obj task.