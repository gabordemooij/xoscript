

>> αντ := Αντικείμενο νέο.

αντ όταν: ['χαιρέτα'] κάνε: {
	<- ['γεια'].
}.

# πρέπει να εμφανίσει hi123hi123ok
αντ όταν: ['εργασία'] κάνε: {
	δικό ιδιότητα := 123.
	{
		# το try δένει τα εαυτός/δικό στο αντικείμενο αντί για το μπλοκ
		Έξοδος γράψε: εαυτός χαιρέτα.
		Έξοδος γράψε: δικό ιδιότητα.
		1 / 0.
	} σύλληψη: {
		Έξοδος γράψε: εαυτός χαιρέτα.
		Έξοδος γράψε: δικό ιδιότητα.
		Έξοδος γράψε: ['ok'].
	}, δοκίμασε.
}.

αντ εργασία.