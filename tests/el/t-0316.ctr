>> Grandfather := Αντικείμενο νέο.
Grandfather όταν: ['greet'] κάνε: {
	Έξοδος γράψε: ['Ave!'], νέα-γραμμή.
}.
>> Father := Grandfather νέο.
Father όταν: ['greet'] κάνε: {
	Έξοδος γράψε: ['Hello'], νέα-γραμμή.
	εαυτός greet.
}.
>> Son := Father νέο.
Son όταν: ['greet'] κάνε: {
	Έξοδος γράψε: ['Hi'], νέα-γραμμή.
	εαυτός greet.
}.

Son greet.

>> Roundabout := Αντικείμενο νέο.
Roundabout όταν: ['circle:'] κάνε: { :x
	Έξοδος γράψε: x, νέα-γραμμή.
	(x < 3) αληθές: { εαυτός αναδρομικό circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) αληθές: { Έξοδος γράψε: x, νέα-γραμμή. x πρόσθεση: 1.  increment εκκίνηση. }. }.
increment εκκίνηση.