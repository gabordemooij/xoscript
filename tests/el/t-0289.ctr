#Linux
>> OS := Πρόγραμμα σύστημα: (Εντολή uname -s), περικοπή.

>> Slurp := Αντικείμενο νέο.
Slurp όταν: ['νέο'] κάνε: {
	δικό str := [''].
}.
Slurp όταν: ['απάντηση:'] κάνε: { :blah
		(δικό str ≠ ['']) αληθές: {
			δικό str προσθήκη-στο-τέλος: [' '].
		}.
		δικό str προσθήκη-στο-τέλος: blah.
}.
Slurp όταν: ['απάντηση:και:'] κάνε: { :blah :blahah
		(δικό str ≠ ['']) αληθές: {
			δικό str προσθήκη-στο-τέλος: [' '].
		}.
		(blah μήκος > 1) αληθές: {
			δικό str προσθήκη-στο-τέλος: (blah από: 0 μήκος: (blah μήκος - 1)).
		}, αλλιώς: {
			δικό str προσθήκη-στο-τέλος: blah.
		}.
		δικό str προσθήκη-στο-τέλος: [' '].
		δικό str προσθήκη-στο-τέλος: blahah.
}.
Slurp όταν: ['απόκτησε'] κάνε: {
	>> ενδιάμεσο := δικό str.
	δικό str := ['']. <- ενδιάμεσο.
}.
>> large text := [''].
{
	large text προσθήκη-στο-τέλος: ['hello'].
} × 1000.


Έξοδος γράψε: (
	Πρόγραμμα σύστημα: (
		Slurp νέο
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) απόκτησε
).

