


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Πρόγραμμα διαχείριση-μνήμης: 0.
>> palette := Κενό.
>> colors := Κενό.

{
palette := Λεξικό νέο.
palette 
	τοποθέτηση: ['#F00'] στο: ['red'],
	τοποθέτηση: ['#0F0'] στο: ['green'],
	τοποθέτηση: ['#00F'] στο: ['blue'].
Έξοδος γράψε: ['number of RGB codes in palette: '] + ( palette πλήθος ), νέα-γραμμή.
Έξοδος γράψε: ['RGB code of green is: '] + ( palette ? ['green'] ), νέα-γραμμή.
colors := [''].
( palette κάθε: { :όνομα :κώδικας
		colors := colors + ( όνομα + [':'] + κώδικας ).
} ).
Έξοδος γράψε: ['All colors in palette: '] + colors, νέα-γραμμή.
} εκκίνηση.
Πρόγραμμα καθαρισμός.
usedMemory1 := (Πρόγραμμα μνήμη ? 0).

