


>> χρησιμοποιημένηΜνήμη1 := 0.
>> χρησιμοποιημένηΜνήμη2 := 0.
>> χρησιμοποιημένηΜνήμη3 := 0.
>> χρησιμοποιημένηΜνήμη4 := 0.

Πρόγραμμα διαχείριση-μνήμης: 0.
>> παλέτα := Κενό.
>> χρώματα := Κενό.

{
παλέτα := Λεξικό νέο.
παλέτα 
	τοποθέτηση: ['#F00'] στο: ['κόκκινο'],
	τοποθέτηση: ['#0F0'] στο: ['πράσινο'],
	τοποθέτηση: ['#00F'] στο: ['μπλε'].
Έξοδος γράψε: ['πλήθος κωδικών RGB στην παλέτα: '] + ( παλέτα πλήθος ), νέα-γραμμή.
Έξοδος γράψε: ['ο κωδικός RGB του πράσινου είναι: '] + ( παλέτα ? ['πράσινο'] ), νέα-γραμμή.
χρώματα := [''].
( παλέτα κάθε: { :όνομα :κώδικας
		χρώματα := χρώματα + ( όνομα + [':'] + κώδικας ).
} ).
Έξοδος γράψε: ['Όλα τα χρώματα της παλέτας: '] + χρώματα, νέα-γραμμή.
} εκκίνηση.
Πρόγραμμα καθαρισμός.
χρησιμοποιημένηΜνήμη1 := (Πρόγραμμα μνήμη ? 0).

{
παλέτα := Λεξικό νέο.
