Server init.
Έξοδος γράψε: ['Database time test'], νέα-γραμμή.

>> db := Maria-DB νέο κόμβος: ['localhost'],
	χρήστης: ['xo'], 
	κωδικός: ['pass123'],
	όνομα-βάσης: ['xobase'],
	συνδέσου.

>> παράμετροι-αναζήτησης :=
db ερώτημα: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
ανάκτηση: { :row
	Έξοδος γράψε: row timetest, νέα-γραμμή.
}.
