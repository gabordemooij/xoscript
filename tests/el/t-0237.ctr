
Κείμενο όταν: ['αποτίμησε'] κάνε: {
	>> κώδικας := Αρχείο νέο: ['/tmp/eval.ctr'].
	κώδικας γράψε: (εαυτός κείμενο + ['.']).
	Πρόγραμμα χρήση: ['/tmp/eval.ctr'].
}.

>> map :=
	(Λεξικό νέο)
	τοποθέτηση: ['Γεια Χαρά'] στο: ['two'],
	τοποθέτηση: (Λίστα ← ['hello'] ; ['world'] ; (Λίστα ← 1 ; 2; 9) ; Ψευδές) στο: ['ένα'],
	τοποθέτηση: ( (Λεξικό νέο) τοποθέτηση: ['wrrld'] στο: ['ανορθόγραφο'] ) στο: ['three'],
	τοποθέτηση: (Λίστα ← ((Λεξικό νέο) τοποθέτηση: ['θησαυρός'] στο: ['κρυμμένο']) ; 2) στο: ['τέσσερα']. 
>> str := map κείμενο.
>> map2 := Κενό.
(['map2 := '] + str ) αποτίμησε.
Έξοδος γράψε: map2 ? ['ένα'] ? 0.
Έξοδος γράψε: map2 ? ['ένα'] ? 1.
Έξοδος γράψε: map2 ? ['τέσσερα'] ? 0 ? ['κρυμμένο'].
Έξοδος γράψε: map2 ? ['ένα'] ? 2 ? 2.
