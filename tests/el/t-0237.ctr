
Κείμενο όταν: ['evaluate'] κάνε: {
	>> κώδικας := Αρχείο νέο: ['/tmp/eval.ctr'].
	κώδικας γράψε: (εαυτός κείμενο + ['.']).
	Πρόγραμμα χρήση: ['/tmp/eval.ctr'].
}.

>> map :=
	(Λεξικό νέο)
	τοποθέτηση: ['Hi There'] στο: ['two'],
	τοποθέτηση: (Λίστα ← ['hello'] ; ['world'] ; (Λίστα ← 1 ; 2; 9) ; Ψευδές) στο: ['one'],
	τοποθέτηση: ( (Λεξικό νέο) τοποθέτηση: ['wrrld'] στο: ['misspelled'] ) στο: ['three'],
	τοποθέτηση: (Λίστα ← ((Λεξικό νέο) τοποθέτηση: ['treasure'] στο: ['hidden']) ; 2) στο: ['four']. 
>> str := map κείμενο.
>> map2 := Κενό.
(['map2 := '] + str ) evaluate.
Έξοδος γράψε: map2 ? ['one'] ? 0.
Έξοδος γράψε: map2 ? ['one'] ? 1.
Έξοδος γράψε: map2 ? ['four'] ? 0 ? ['hidden'].
Έξοδος γράψε: map2 ? ['one'] ? 2 ? 2.
