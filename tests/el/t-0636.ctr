# test url parsing

Server init.
>> url := URL από: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Έξοδος γράψε: ['scheme = '] + url σχήμα, νέα-γραμμή.
Έξοδος γράψε: ['host = '] + url κόμβος, νέα-γραμμή.
Έξοδος γράψε: ['port = '] + url θύρα, νέα-γραμμή.
Έξοδος γράψε: ['path = '] + url διαδρομή, νέα-γραμμή.
Έξοδος γράψε: ['query = '] + url παράμετροι-αναζήτησης, νέα-γραμμή.
Έξοδος γράψε: ['fragment = '] + url τμήμα, νέα-γραμμή.
