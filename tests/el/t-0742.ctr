Έξοδος γράψε: ['Test object'], νέα-γραμμή.
>> a := Αντικείμενο νέο. 

a όταν: ['item:'] κάνε: { :hexhelper
	δικό hexhelper := hexhelper. 
}.

a όταν: ['item'] κάνε: { <- δικό hexhelper.
}.

a item: Hx νέο.

>> old-hexhelper-address := a item πρωτότυπο διεύθυνση-μνήμης.
a save-as: ['/tmp/a.bin'].
Έξοδος γράψε: ['========== RELOADING SNAP:'], νέα-γραμμή.

>> b := Αντικείμενο load-from: ['/tmp/a.bin'].

(b item πρωτότυπο διεύθυνση-μνήμης = old-hexhelper-address) αληθές: {
	Έξοδος γράψε: ['Object link re-attached.'], νέα-γραμμή.
}.
