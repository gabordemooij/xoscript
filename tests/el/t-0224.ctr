
>> χώρες := Λίστα νέο
	~ ['Ελβετία']
	~ ['Ιταλία']
	~ ['Γερμανία'].

>> τρόφιμα := Λίστα νέο
	~ ['Rösti']
	~ ['Σπαγγέτι']
	~ ['Ξινολάχανο'].


>> μετρητής := 0.
τρόφιμα κατά: χώρες, κάθε: { :key :value
	μετρητής πρόσθεση: 1.
}.

Έξοδος γράψε: (['we serve counter dishes'] counter: μετρητής), νέα-γραμμή.

>> μετρητής := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] χαρακτήρες ταξινόμηση: { :v
	μετρητής πρόσθεση: 0.
}.

Έξοδος γράψε: (['we sort counter dishes'] counter: μετρητής), νέα-γραμμή.


>> μετρητής := 0.
{
	{
		μετρητής πρόσθεση: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Έξοδος γράψε: (['we calculate counter numbers.'] counter: μετρητής), νέα-γραμμή.

