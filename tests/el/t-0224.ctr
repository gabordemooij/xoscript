
>> countries := Λίστα νέο
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Λίστα νέο
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods κατά: countries, κάθε: { :key :value
	counter πρόσθεση: 1.
}.

Έξοδος γράψε: (['we serve counter dishes'] counter: counter), νέα-γραμμή.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] χαρακτήρες ταξινόμηση: { :v
	counter πρόσθεση: 0.
}.

Έξοδος γράψε: (['we sort counter dishes'] counter: counter), νέα-γραμμή.


>> counter := 0.
{
	{
		counter πρόσθεση: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Έξοδος γράψε: (['we calculate counter numbers.'] counter: counter), νέα-γραμμή.

