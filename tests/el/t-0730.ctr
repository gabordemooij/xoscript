Έξοδος γράψε: ['Test object'], νέα-γραμμή.
>> a := Αντικείμενο νέο. 

a όταν: ['item:'] κάνε: { :moment
	δικό moment := moment. 
}.

a όταν: ['item'] κάνε: { <- δικό moment.
}.

>> today := Στιγμή νέο ζώνη: ['CEST'], έτος: 2026, μήνας: 7.
a item: today.
Έξοδος γράψε: a item, νέα-γραμμή.
a save-as: ['/tmp/a.bin'].
Έξοδος γράψε: ['========== RELOADING SNAP:'], νέα-γραμμή.
>> b := Αντικείμενο load-from: ['/tmp/a.bin'].
Έξοδος γράψε: b item, νέα-γραμμή.
