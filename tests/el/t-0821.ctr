# ένα εισαγωγικό που δεν κλείνει ποτέ πρέπει να δίνει σφάλμα, όχι ατέρμονο βρόχο
>> διαδρομή := ['/tmp/test0821.csv'].
>> file := Αρχείο νέο: διαδρομή.

file γράψε: ['a,b\n"1,2\n'].
{
	file διαχωριστικό: [','] εισαγωγικό: ['"'] γραμμές: { :line
		Έξοδος γράψε: line, νέα-γραμμή.
	}.
} σύλληψη: { :e Έξοδος γράψε: e, νέα-γραμμή. }, εκκίνηση.

# ένα κλειστό εισαγωγικό εξακολουθεί να λειτουργεί
file γράψε: ['a,b\n"1,2",3'].
file διαχωριστικό: [','] εισαγωγικό: ['"'] γραμμές: { :line
	Έξοδος γράψε: line, νέα-γραμμή.
}.
file διαγραφή.
