>> t := Αληθές.
(t = Αληθές) αληθές: { Έξοδος γράψε: ['T']. }.
(t = Ψευδές) αληθές: { Έξοδος γράψε: ['F']. }.
Έξοδος γράψε: ['|'].
>> t := Ψευδές.
(t = Αληθές) αληθές: { Έξοδος γράψε: ['T']. }.
(t = Ψευδές) αληθές: { Έξοδος γράψε: ['F']. }.
Έξοδος γράψε: ['|'].
>> f := Αληθές.
(t = Αληθές και: f = Ψευδές) αληθές: { Έξοδος γράψε: ['T']. }.
(t = Ψευδές και: f = Αληθές) αληθές: { Έξοδος γράψε: ['F']. }.
Έξοδος γράψε: ['|'].
>> n := Κενό.
(n Κενό?) αληθές: { Έξοδος γράψε: ['T']. }.
(n Κενό?) ψευδές: { Έξοδος γράψε: ['F']. }.
Έξοδος γράψε: ['|'].
