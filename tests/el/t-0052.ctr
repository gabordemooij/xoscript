>> items := Λεξικό νέο.
items τοποθέτηση: ['green'] στο: ['color-1'].
items τοποθέτηση: ['orange'] στο: ['color-2'].
items τοποθέτηση: ['red'] στο: ['color-3'].
>> i := 0.
>> s := [''].
items κάθε: { :key :color
	Έξοδος γράψε: ['color #'] + i + [' is: '] + color + [' '].
	i πρόσθεση: 1.
}.
Έξοδος γράψε: i + [' colors!'].
