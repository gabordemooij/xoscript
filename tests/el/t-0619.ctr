>> HTML := Αντικείμενο νέο.
HTML όταν: ['απάντηση:'] κάνε: { :tag 
	Έξοδος γράψε: (['<tag>'] tag: tag), νέα-γραμμή.
}.
HTML όταν: ['απάντηση:και:'] κάνε: { :tag :html 
	Έξοδος γράψε: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), νέα-γραμμή.
}.
>> html := HTML νέο.
html body h1: ['header'].

