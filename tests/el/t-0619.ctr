>> HTML := Αντικείμενο νέο.
HTML όταν: ['απάντηση:'] κάνε: { :ετικέτα 
	Έξοδος γράψε: (['<tag>'] tag: ετικέτα), νέα-γραμμή.
}.
HTML όταν: ['απάντηση:και:'] κάνε: { :ετικέτα :html 
	Έξοδος γράψε: (
		['<tag>innerHTML</tag>']
		tag: ετικέτα - [':'],
		innerHTML: html
	), νέα-γραμμή.
}.
>> html := HTML νέο.
html body h1: ['header'].

