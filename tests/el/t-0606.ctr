>> Point := Αντικείμενο νέο.
Point όταν: ['x-coordinate:'] κάνε: { :x δικό x := x. }.
Point όταν: ['y-coordinate:'] κάνε: { :y δικό y := y. }.
Point όταν: ['x-coordinate']  κάνε: { <- δικό x αντιγραφή. }.
Point όταν: ['y-coordinate']  κάνε: { <- δικό y αντιγραφή. }.

Point όταν: ['='] κάνε: { :other <- ( δικό x = other x-coordinate
		 και: δικό y = other y-coordinate ).
}.

>> pier := Point νέο x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point νέο x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point νέο x-coordinate: 5, y-coordinate: 6.

Έξοδος γράψε: pier = town-hall, νέα-γραμμή.
Έξοδος γράψε: pier = restaurant, νέα-γραμμή.
