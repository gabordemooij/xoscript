>> Ζώο := Αντικείμενο νέο.
Ζώο όταν: ['φτιάξε'] κάνε: {
	>> ζώο := Αντικείμενο νέο.
	ζώο όταν: ['κάνεΉχο'] κάνε: {
		Έξοδος γράψε: δικό ήχος.
	}. <- ζώο.
}.
>> Γάτα := Αντικείμενο νέο.
Γάτα όταν: ['φτιάξε'] κάνε: {
	>> γάτα := Ζώο φτιάξε.
	γάτα όταν: ['init'] κάνε: {
		δικό ήχος := ['meow!'].
	}.
	γάτα init. <- γάτα.
}.
>> tom := Γάτα φτιάξε.
tom κάνεΉχο.
