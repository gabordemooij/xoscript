# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Θησαυροφυλάκιο δημιουργία-κλειδιών.

# private (secret) key
>> sk := keys πρώτο.

# public key
>> pk := keys τελευταίο.

# sign a message
>> sig := Θησαυροφυλάκιο υπογραφή: ['abc'] με: sk.

# check message (ok)
Έξοδος γράψε: ( 
	Θησαυροφυλάκιο
		έλεγχος: ['abc'] 
		υπογραφή: sig 
		με: pk 
), νέα-γραμμή.

# check message (fail)
Έξοδος γράψε: ( 
	Θησαυροφυλάκιο 
		έλεγχος: ['abd'] 
		υπογραφή: sig 
		με: pk 
), νέα-γραμμή.