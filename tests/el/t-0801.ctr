Server init.

>> db := Maria-DB νέο κόμβος: ['localhost'],
	χρήστης: ['xo'],
	κωδικός: ['pass123'],
	όνομα-βάσης: ['xobase'],
	συνδέσου.

>> del := db ερώτημα: ['DELETE FROM book WHERE id > 0'].
{  del εκτέλεση. db επικύρωση. } σύλληψη: { :e db αναίρεση.  }, εκκίνηση.

>> πλήθος := db ερώτημα: ['SELECT COUNT(*) AS num FROM book'].
πλήθος ανάκτηση: { :row Έξοδος γράψε: row num, νέα-γραμμή. }.
