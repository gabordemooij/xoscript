# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := Maria-DB νέο κόμβος: ['localhost'],
	χρήστης: ['xo'],
	κωδικός: ['pass123'],
	όνομα-βάσης: ['xobase'],
	συνδέσου.

>> παράμετροι-αναζήτησης := db ερώτημα: ['SELECT ? AS a, ? AS b, ? AS c'].
παράμετροι-αναζήτησης παράμετροι: (Λίστα νέο ; ['1']).
{ παράμετροι-αναζήτησης ανάκτηση: { :row Έξοδος γράψε: row, νέα-γραμμή. }. } σύλληψη: { :e Έξοδος γράψε: e, νέα-γραμμή. }, εκκίνηση.

>> παράμετροι-αναζήτησης := db ερώτημα: ['SELECT ? AS a'].
{ παράμετροι-αναζήτησης ανάκτηση: { :row Έξοδος γράψε: row, νέα-γραμμή. }. } σύλληψη: { :e Έξοδος γράψε: e, νέα-γραμμή. }, εκκίνηση.

# the right number still works, more parameters are ignored as before
>> παράμετροι-αναζήτησης := db ερώτημα: ['SELECT ? AS a, ? AS b'].
παράμετροι-αναζήτησης παράμετροι: (Λίστα νέο ; ['1'] ; ['2']).
παράμετροι-αναζήτησης ανάκτηση: { :row Έξοδος γράψε: (row στο: ['a']), γράψε: (row στο: ['b']), νέα-γραμμή. }.
παράμετροι-αναζήτησης παράμετροι: (Λίστα νέο ; ['1'] ; ['2'] ; ['3']).
παράμετροι-αναζήτησης ανάκτηση: { :row Έξοδος γράψε: (row στο: ['a']), γράψε: (row στο: ['b']), νέα-γραμμή. }.
