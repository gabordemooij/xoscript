>> To-Do := Αντικείμενο νέο.

To-Do όταν: ['νέο'] κάνε: {
	δικό list := Λίστα νέο.
}.

To-Do όταν: ['nieuw'] κάνε: {
	δικό list := Λίστα νέο.
}.

To-Do όταν: ['+'] κάνε: { :task
	δικό list προσθήκη-στο-τέλος: task.
}.

To-Do όταν: ['number of tasks?'] κάνε: { <-  δικό list πλήθος.
}.

>> todos := 
	To-Do νέο 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Έξοδος γράψε: ['You have $ tasks to do'] $ todos number of tasks?.
