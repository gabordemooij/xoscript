>> Εκκρεμότητες := Αντικείμενο νέο.

Εκκρεμότητες όταν: ['νέο'] κάνε: {
	δικό list := Λίστα νέο.
}.

Εκκρεμότητες όταν: ['nieuw'] κάνε: {
	δικό list := Λίστα νέο.
}.

Εκκρεμότητες όταν: ['+'] κάνε: { :εργασία
	δικό list προσθήκη-στο-τέλος: εργασία.
}.

Εκκρεμότητες όταν: ['number of tasks?'] κάνε: { <-  δικό list πλήθος.
}.

>> εκκρεμότητες := 
	Εκκρεμότητες νέο 
	+ ['μαγείρεμα δείπνου'] 
	+ ['καθάρισμα δωματίου'].
	
Έξοδος γράψε: ['You have $ tasks to do'] $ εκκρεμότητες number of tasks?.
