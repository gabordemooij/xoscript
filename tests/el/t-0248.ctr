

Κείμενο όταν: ['αποτίμησε'] κάνε: {
	>> κώδικας := Αρχείο νέο: ['/tmp/eval.ctr'].
	κώδικας γράψε: εαυτός κείμενο + ['.'].
	Πρόγραμμα χρήση: ['/tmp/eval.ctr'].
}.

>> a := (Λίστα ← (
	(Λεξικό νέο)
		τοποθέτηση: ['τομέας'] στο: ['mywebsite.com'],
		τοποθέτηση: (Λίστα ←
			((Λεξικό νέο)
				τοποθέτηση: ['αρχική'] στο: ['title'],
				τοποθέτηση: ['<html></html>'] στο: ['body'],
				τοποθέτηση: ['2017-01-01'] στο: ['created']
			) ;
			((Λεξικό νέο)
				τοποθέτηση: ['aboutus(c)'] στο: ['title'],
				τοποθέτηση: ['<credits>Author Inc.</credits>'] στο: ['body']
			)
		) στο: ['pages']
	)
) κείμενο.

Έξοδος γράψε: a τύπος, νέα-γραμμή.
Έξοδος γράψε: a, νέα-γραμμή.

>> b := Κενό.
(['b := '] + a) αποτίμησε.
Έξοδος γράψε: b ? 0 ? ['pages'] ? 1 ? ['body'], νέα-γραμμή.

>> c := b ? 0.
>> d := c κείμενο.
Έξοδος γράψε: d τύπος, νέα-γραμμή.

>> e := Κενό.
(['e := '] + d) αποτίμησε.
Έξοδος γράψε: e ? ['pages'] ? 0, νέα-γραμμή.
