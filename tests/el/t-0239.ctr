Λίστα όταν: ['άθροισμα'] κάνε: {
	>> σύνολο := 0.
	εαυτός κάθε: { :αύξων :στοιχείο
		σύνολο πρόσθεση: στοιχείο.
	}. <- σύνολο.
}.

>> a := Αληθές.



a όταν: ['κείμενο'] κάνε: {
	>> απάντηση := Κενό.
	( εαυτός = Αληθές ) αληθές: {
		απάντηση := ['Μάλιστα'].
	}, αλλιώς: {
		απάντηση := ['Μπα'].
	}. <- απάντηση.
}.

a όταν: ['αριθμός'] κάνε: {
	>> απάντηση := Κενό.
	( εαυτός = Αληθές ) αληθές: {
		απάντηση := 10.
	}, αλλιώς: {
		απάντηση := 20.
	}. <- απάντηση.
}.

>> b := 666.

b όταν: ['κείμενο'] κάνε: { <- ['Διάβολος'].
}.

b όταν: ['λογικό'] κάνε: { <- Ψευδές.
}.


Έξοδος γράψε: a, νέα-γραμμή.  
Έξοδος γράψε: (90 + a), νέα-γραμμή. 
Έξοδος γράψε: b, νέα-γραμμή. 
Έξοδος γράψε: (Αληθές και: b), νέα-γραμμή.

a := Λίστα ← ['hello'] ; ['world'] ; Αληθές ; Κενό ; 666. 
a := a + ( Λίστα ← 1 ).
Έξοδος γράψε: a, νέα-γραμμή.
Έξοδος γράψε: ((Λεξικό νέο) τοποθέτηση: Κενό στο: Κενό), νέα-γραμμή.
Έξοδος γράψε: a άθροισμα, νέα-γραμμή. 


{
	a όταν: ['κείμενο'] κάνε: { <- Κενό. }.
	a := [''] + a.
} σύλληψη: { :σφάλμα
	Έξοδος γράψε: ['Σφάλμα καταγράφηκε: '] + σφάλμα, νέα-γραμμή.
}, εκκίνηση.



{
	a όταν: ['αριθμός'] κάνε: { <- Κενό. }.
	a := 3 × a.
} σύλληψη: { :σφάλμα
	Έξοδος γράψε: ['Σφάλμα καταγράφηκε: '] + σφάλμα, νέα-γραμμή.
}, εκκίνηση.


{
	a όταν: ['λογικό'] κάνε: { <- Κενό. }.
	a := Αληθές και: a. 
} σύλληψη: { :σφάλμα
	Έξοδος γράψε: ['Σφάλμα καταγράφηκε: '] + σφάλμα, νέα-γραμμή.
}, εκκίνηση.





