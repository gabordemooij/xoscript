Λίστα όταν: ['sum'] κάνε: {
	>> total := 0.
	εαυτός κάθε: { :index :element
		total πρόσθεση: element.
	}. <- total.
}.

>> a := Αληθές.



a όταν: ['κείμενο'] κάνε: {
	>> answer := Κενό.
	( εαυτός = Αληθές ) αληθές: {
		answer := ['Yep'].
	}, αλλιώς: {
		answer := ['Nope'].
	}. <- answer.
}.

a όταν: ['αριθμός'] κάνε: {
	>> answer := Κενό.
	( εαυτός = Αληθές ) αληθές: {
		answer := 10.
	}, αλλιώς: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b όταν: ['κείμενο'] κάνε: { <- ['Devil'].
}.

b όταν: ['λογικό'] κάνε: { <- Ψευδές.
}.


Έξοδος γράψε: a, νέα-γραμμή.  
Έξοδος γράψε: (90 + a), νέα-γραμμή. 
Έξοδος γράψε: b, νέα-γραμμή. 
Έξοδος γράψε: (Αληθές και: b), νέα-γραμμή.

a := Λίστα ← ['hello'] ; ['world'] ; Αληθές ; Κενό ; 666. 
a := a + ( Λίστα ← 1 ).
Έξοδος γράψε: a, νέα-γραμμή.
Έξοδος γράψε: ((Λεξικό νέο) τοποθέτηση: Κενό στο: Κενό), νέα-γραμμή.
Έξοδος γράψε: a sum, νέα-γραμμή. 


{
	a όταν: ['κείμενο'] κάνε: { <- Κενό. }.
	a := [''] + a.
} σύλληψη: { :error
	Έξοδος γράψε: ['Error noted: '] + error, νέα-γραμμή.
}, εκκίνηση.



{
	a όταν: ['αριθμός'] κάνε: { <- Κενό. }.
	a := 3 × a.
} σύλληψη: { :error
	Έξοδος γράψε: ['Error noted: '] + error, νέα-γραμμή.
}, εκκίνηση.


{
	a όταν: ['λογικό'] κάνε: { <- Κενό. }.
	a := Αληθές και: a. 
} σύλληψη: { :error
	Έξοδος γράψε: ['Error noted: '] + error, νέα-γραμμή.
}, εκκίνηση.





