>> t := Κενό.

# μπορείτε να ελέγξετε τη ζώνη ώρας για
# την ανάλυση ως εξής:
Στιγμή ζώνη: ['CET'].
t := Στιγμή από: ['1981-02-03 04:05:06'].
Έξοδος γράψε: t, νέα-γραμμή.

# τώρα με τη ζώνη ώρας CEST:
Στιγμή ζώνη: ['CEST'].
t := Στιγμή από: ['1981-02-03 04:05:06'].
Έξοδος γράψε: t, νέα-γραμμή.

# σφάλμα αν το κείμενο δεν μπορεί να αναλυθεί
{ Στιγμή από: ['1900']. } σύλληψη: { Κενό. }, εκκίνηση.
