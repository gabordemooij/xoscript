>> t := Κενό.

# you can control the time zone for
# parsing like this:
Στιγμή ζώνη: ['CET'].
t := Στιγμή από: ['1981-02-03 04:05:06'].
Έξοδος γράψε: t, νέα-γραμμή.

# now using CEST time zone:
Στιγμή ζώνη: ['CEST'].
t := Στιγμή από: ['1981-02-03 04:05:06'].
Έξοδος γράψε: t, νέα-γραμμή.

# error if string cannot be parsed
{ Στιγμή από: ['1900']. } σύλληψη: { Κενό. }, εκκίνηση.
