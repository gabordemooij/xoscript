
Έξοδος γράψε: ['Break for-loop, 0-4.'], νέα-γραμμή.
{ :i
	Έξοδος γράψε: ['iteration #'] + i, νέα-γραμμή.
	(i = 4) διακοπή.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Έξοδος γράψε: ['Break while-true loop, 0-4.'], νέα-γραμμή.
{
	Έξοδος γράψε: ['iteration #'] + x, νέα-γραμμή.
	x πρόσθεση: 1.
	((x < 5) όχι) διακοπή.
} ενώ: xIsLessThan10.

Έξοδος γράψε: ['Break while-false loop, 5,4.'], νέα-γραμμή.
{
	Έξοδος γράψε: ['iteration #'] + x, νέα-γραμμή.
	x αφαίρεση: 1.
	(x = 3) διακοπή.
} ενώ: { <- (x > 0). }.

Έξοδος γράψε: ['Break times loop, 1-4.'], νέα-γραμμή.
{ :i
	Έξοδος γράψε: ['iteration #'] + i, νέα-γραμμή.
	(i = 4) διακοπή.
} × 5.

Έξοδος γράψε: ['Break block, dont print line.'], νέα-γραμμή.
{ Αληθές διακοπή. Έξοδος γράψε: ['dont write this!'], νέα-γραμμή. } εκκίνηση.

Έξοδος γράψε: ['Break block, dont fire catch...'], νέα-γραμμή.
{ Αληθές διακοπή. Έξοδος γράψε: ['dont write this!'], νέα-γραμμή. } σύλληψη: { Έξοδος γράψε: ['Dont catch this!']. }, εκκίνηση.

Έξοδος γράψε: ['Test Array each-loop: 0,1'], νέα-γραμμή.
(Λίστα ← 1 ; 2 ; 3) απεικόνιση: { :i
	Έξοδος γράψε: ['iteration #'] + i, νέα-γραμμή.
	(i = 1) διακοπή.
}.

Έξοδος γράψε: ['Test Map each-loop: c only'], νέα-γραμμή.
>> m := Λεξικό νέο.
m τοποθέτηση: ['first'] στο: ['a'], τοποθέτηση: ['second'] στο: ['b'], τοποθέτηση: ['third'] στο: ['c'].
m κάθε: { :k :v
	Έξοδος γράψε: ['iteration'] + v + k, νέα-γραμμή.
	Αληθές διακοπή.
}.

