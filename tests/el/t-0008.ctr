>> Χαιρετιστής := Αντικείμενο νέο.
Χαιρετιστής όταν: ['φτιάξε'] κάνε: {
	>> χαιρετιστής := Αντικείμενο νέο.
	χαιρετιστής όταν: ['name:'] κάνε: { :όνομα
		Έξοδος γράψε: ['ορίζω ένα όνομα'].
		δικό τοΌνομάΜου := όνομα.
	}.
	χαιρετιστής όταν: ['χαιρέτα'] κάνε: {
		Έξοδος γράψε: ['Hello'].
		Έξοδος γράψε: δικό τοΌνομάΜου.
	}. <- χαιρετιστής.
}.
>> χαιρετιστής := Χαιρετιστής φτιάξε.
χαιρετιστής name: ['λιακάδα!'].
χαιρετιστής χαιρέτα.
