# δοκιμή προσδιοριστικών

>> $ := Αντικείμενο νέο.

$ όταν: ['απάντηση:'] κάνε: { :x
	
	>> πράξη := x χαρακτήρας: 0.
	>> νόμισμα := x χαρακτήρας: 1.
	>> χρήματα := x μετατόπιση: 2.
	
	>> ποσό := 0.

	( πράξη = ['+'] ) αληθές: {
		( νόμισμα = ['£'] ) αληθές: { ποσό := 1.28 × χρήματα. }.
	}. <- ποσό.
}.



>> x := $ +£20.

Έξοδος γράψε: x, νέα-γραμμή.


>> Φρούτο := Αντικείμενο νέο.

Φρούτο όταν: ['νέο'] κάνε: {
	>> f := εαυτός νέο.
	f apples: 0.
	f oranges: 0. <- f.
}.

Φρούτο όταν: ['apples:'] κάνε: { :a δικό μήλα := a. }.
Φρούτο όταν: ['oranges:'] κάνε: { :p δικό πορτοκάλια := p. }.
Φρούτο όταν: ['μήλα'] κάνε: { <- δικό μήλα. }.
Φρούτο όταν: ['πορτοκάλια'] κάνε: { <- δικό πορτοκάλια. }.

Φρούτο όταν: ['+'] κάνε: { :f
	
	>> n := Φρούτο νέο.
	f πρόσθεση: 1.
	
	n apples: (f μήλα + δικό μήλα).
	n oranges:  (f πορτοκάλια  + δικό πορτοκάλια). <- n.
}.

Φρούτο όταν: ['κείμενο'] κάνε: { <- ( δικό μήλα κείμενο + [' μήλα και '] + δικό πορτοκάλια + [' πορτοκάλια'] ).
}.

Αριθμός όταν: ['μήλα'] κάνε: { <- ((Φρούτο νέο) apples: εαυτός).
}.

Αριθμός όταν: ['apple'] κάνε: { <- ((Φρούτο νέο) apples: εαυτός).
}.

Αριθμός όταν: ['πορτοκάλια'] κάνε: { <- ((Φρούτο νέο) oranges: εαυτός).
}.




Έξοδος γράψε: (1 apple + 3 πορτοκάλια + 4 μήλα), νέα-γραμμή.


Κείμενο όταν: ['δύοΦορές'] κάνε: { <- ((εαυτός κείμενο) + (εαυτός κείμενο)).
}.



Έξοδος γράψε: ['❤❤❤'] δύοΦορές.



