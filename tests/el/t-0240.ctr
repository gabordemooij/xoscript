# test qualifiers

>> $ := Αντικείμενο νέο.

$ όταν: ['απάντηση:'] κάνε: { :x
	
	>> operation := x χαρακτήρας: 0.
	>> valuta := x χαρακτήρας: 1.
	>> money := x μετατόπιση: 2.
	
	>> amount := 0.

	( operation = ['+'] ) αληθές: {
		( valuta = ['£'] ) αληθές: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Έξοδος γράψε: x, νέα-γραμμή.


>> Fruit := Αντικείμενο νέο.

Fruit όταν: ['νέο'] κάνε: {
	>> f := εαυτός νέο.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit όταν: ['apples:'] κάνε: { :a δικό apples := a. }.
Fruit όταν: ['oranges:'] κάνε: { :p δικό oranges := p. }.
Fruit όταν: ['apples'] κάνε: { <- δικό apples. }.
Fruit όταν: ['oranges'] κάνε: { <- δικό oranges. }.

Fruit όταν: ['+'] κάνε: { :f
	
	>> n := Fruit νέο.
	f πρόσθεση: 1.
	
	n apples: (f apples + δικό apples).
	n oranges:  (f oranges  + δικό oranges). <- n.
}.

Fruit όταν: ['κείμενο'] κάνε: { <- ( δικό apples κείμενο + [' apples and '] + δικό oranges + [' oranges'] ).
}.

Αριθμός όταν: ['apples'] κάνε: { <- ((Fruit νέο) apples: εαυτός).
}.

Αριθμός όταν: ['apple'] κάνε: { <- ((Fruit νέο) apples: εαυτός).
}.

Αριθμός όταν: ['oranges'] κάνε: { <- ((Fruit νέο) oranges: εαυτός).
}.




Έξοδος γράψε: (1 apple + 3 oranges + 4 apples), νέα-γραμμή.


Κείμενο όταν: ['twice'] κάνε: { <- ((εαυτός κείμενο) + (εαυτός κείμενο)).
}.



Έξοδος γράψε: ['❤❤❤'] twice.



