>> Greeter := Αντικείμενο νέο.
Greeter όταν: ['make'] κάνε: {
	>> greeter := Αντικείμενο νέο.
	greeter όταν: ['name:'] κάνε: { :όνομα
		Έξοδος γράψε: ['setting a name'].
		δικό myName := όνομα.
	}.
	greeter όταν: ['performGreeting'] κάνε: {
		Έξοδος γράψε: ['Hello'].
		Έξοδος γράψε: δικό myName.
	}.
	greeter όταν: ['greet'] κάνε: {
		εαυτός performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
