


>> CoffeeMachine := Αντικείμενο νέο.
CoffeeMachine όταν: ['order:'] κάνε: { :id
	>> coffee := ['Americano'].
	( id = 1 ) αληθές: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) αληθές: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) αληθές: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Αντικείμενο νέο.
SimpleCoffeeMachine όταν: ['order'] κάνε: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Έξοδος γράψε: redCup, νέα-γραμμή.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Έξοδος γράψε: greenCup, νέα-γραμμή.
>> yellowCup := CoffeeMachine order: 1.
Έξοδος γράψε: yellowCup, νέα-γραμμή.
>> blueCup := CoffeeMachine order: 0.
Έξοδος γράψε: blueCup, νέα-γραμμή.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Έξοδος γράψε: blackCup, νέα-γραμμή.
blackCup προσθήκη-στο-τέλος: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Έξοδος γράψε: orangeCup, νέα-γραμμή.
