# test qualifiers

Πρόγραμμα καθαρισμός.

>> Fruit := Αντικείμενο νέο.
Fruit όταν: ['νέο'] κάνε: {
	>> f := εαυτός νέο.
	f apples: 0. <- f.
}.
Fruit όταν: ['apples:'] κάνε: { :a δικό apples := a. }.
Fruit όταν: ['apples'] κάνε: { <- δικό apples. }.
Fruit όταν: ['+'] κάνε: { :f
	>> n := Fruit νέο.
	n apples: (f apples + δικό apples). <- n.
}.
Αριθμός όταν: ['apples'] κάνε: { <- ((Fruit νέο) apples: εαυτός).
}.

Fruit όταν: ['κείμενο'] κάνε: { <- δικό apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Έξοδος γράψε: q, νέα-γραμμή.




q := 3 apples + 4 apples.
Έξοδος γράψε: q, νέα-γραμμή.



q := 3 apples + 4 apples.
Έξοδος γράψε: q, νέα-γραμμή.


