
Κείμενο όταν: ['html'] κάνε: { <- (
		εαυτός
		αντικατάσταση: ['&'] με: ['&amp;'],
		αντικατάσταση: ['<'] με: ['&lt;'],
		αντικατάσταση: ['>'] με: ['&gt;'],
		αντικατάσταση: ['"'] με: ['&quot;']
	).
}.

>> ΠινέλοHtml := Αντικείμενο νέο.

ΠινέλοHtml όταν: ['απάντηση:'] κάνε: { :ετικέτα
	Έξοδος γράψε: (['<tag>↵'] tag: ετικέτα ).
}.

ΠινέλοHtml όταν: ['απάντηση:και:'] κάνε: { :ετικέτα :content
	ετικέτα := ( ετικέτα από: 0 μήκος: (ετικέτα μήκος - 1) ).
	Έξοδος γράψε: (['<tag content>↵'] tag: ετικέτα, content: content).
}.

ΠινέλοHtml όταν: ['content:'] κάνε: { :κείμ
	Έξοδος γράψε: κείμ html, νέα-γραμμή.
}.

ΠινέλοHtml όταν: ['χαρακτηριστικό:τιμή:'] κάνε: { :χαρακτηριστικό :value <- ['attr="value"'] attr: χαρακτηριστικό, value: value.
}.

>> h := ΠινέλοHtml νέο.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h χαρακτηριστικό: ['class'] τιμή: ['bold']),
		/span
	/body
/html.
		
