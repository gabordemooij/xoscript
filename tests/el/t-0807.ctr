# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB νέο κόμβος: ['localhost'],
	χρήστης: ['xo'],
	κωδικός: ['pass123'],
	όνομα-βάσης: ['xobase'],
	συνδέσου.

>> παράμετροι-αναζήτησης := db ερώτημα: ['SELECT %% FROM'].
{ παράμετροι-αναζήτησης εκτέλεση. } σύλληψη: { :e
	Έξοδος γράψε: ( e περιέχει: ['%%'] ), νέα-γραμμή.
}, εκκίνηση.
