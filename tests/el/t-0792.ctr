Server init.

>> DB := Maria-DB νέο κόμβος: ['localhost'],
	χρήστης: ['xo'],
	κωδικός: ['pass123'],
	όνομα-βάσης: ['xobase'],
	συνδέσου.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB ερώτημα: SQL.

# now you don't have to set DB
query2 ανάκτηση: { :row
	Έξοδος γράψε: row world, νέα-γραμμή.
}.
