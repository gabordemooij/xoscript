Server init.

>> ΒΔ := Maria-DB νέο κόμβος: ['localhost'],
	χρήστης: ['xo'],
	κωδικός: ['pass123'],
	όνομα-βάσης: ['xobase'],
	συνδέσου.
	
>> SQL := ['SELECT "hello" AS "world" '].

# πιο γρήγορος τρόπος, πάρε το ερώτημα από τη ΒΔ:
>> ερώτημα2 := ΒΔ ερώτημα: SQL.

# τώρα δεν χρειάζεται να ορίσετε τη ΒΔ
ερώτημα2 ανάκτηση: { :σειρά
	Έξοδος γράψε: σειρά world, νέα-γραμμή.
}.
