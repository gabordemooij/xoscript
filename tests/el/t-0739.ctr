Έξοδος γράψε: ['Test object'], νέα-γραμμή.
>> a := Αντικείμενο νέο. 

a όταν: ['item:'] κάνε: { :binhelper
	δικό binhelper := binhelper. 
}.

a όταν: ['item'] κάνε: { <- δικό binhelper.
}.

a item: Bin νέο.

>> old-binhelper-address := a item πρωτότυπο διεύθυνση-μνήμης.
a save-as: ['/tmp/a.bin'].
Έξοδος γράψε: ['========== RELOADING SNAP:'], νέα-γραμμή.

>> b := Αντικείμενο load-from: ['/tmp/a.bin'].

(b item πρωτότυπο διεύθυνση-μνήμης = old-binhelper-address) αληθές: {
	Έξοδος γράψε: ['Object link re-attached.'], νέα-γραμμή.
}.


