# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Πρόγραμμα shell-escape: ['abc'].
Έξοδος γράψε: c, νέα-γραμμή.
Έξοδος γράψε: ( Πρόγραμμα σύστημα: ['echo '] + c ), νέα-γραμμή.

c := Πρόγραμμα shell-escape: ['a'b'c'].
Έξοδος γράψε: c, νέα-γραμμή.
Έξοδος γράψε: ( Πρόγραμμα σύστημα: ['echo '] + c ), νέα-γραμμή.

c := Πρόγραμμα shell-escape: ['a\'c'].
Έξοδος γράψε: c, νέα-γραμμή.
Έξοδος γράψε: ( Πρόγραμμα σύστημα: ['echo '] + c ), νέα-γραμμή.