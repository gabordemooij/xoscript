>> phrases := Λίστα νέο
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases κάθε: { :_ :phrase 
	>> e := Server base64-κωδικοποίηση: phrase.
	>> d := Server base64-αποκωδικοποίηση: e.
	Έξοδος γράψε: (
		message αντιγραφή ~encoded: e, ~decoded: d
	), νέα-γραμμή.
}.
