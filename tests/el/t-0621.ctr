>> φράσεις := Λίστα νέο
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> μήνυμα := ['Phrase: ~decoded base64: ~encoded'].
	
φράσεις κάθε: { :_ :φράση 
	>> e := Server base64-κωδικοποίηση: φράση.
	>> d := Server base64-αποκωδικοποίηση: e.
	Έξοδος γράψε: (
		μήνυμα αντιγραφή ~encoded: e, ~decoded: d
	), νέα-γραμμή.
}.
