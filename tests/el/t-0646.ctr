Server init.
Έξοδος γράψε: ['Database datetime test'], νέα-γραμμή.

>> db := Maria-DB νέο κόμβος: ['localhost'],
	χρήστης: ['xo'], 
	κωδικός: ['pass123'],
	όνομα-βάσης: ['xobase'],
	συνδέσου.

>> παράμετροι-αναζήτησης :=
db ερώτημα: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
ανάκτηση: { :row
	Έξοδος γράψε: row datetimetest, νέα-γραμμή.
}.
