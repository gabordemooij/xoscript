# αποκωδικοποίηση από utf16le/be ή utf32le/be σε utf8
Server init.
>> utf16 := Blob νέο: 8, bytes: (
	Λίστα νέο ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Έξοδος γράψε: ( utf16 αποκωδικοποίηση: ['utf16le'] ), νέα-γραμμή.

utf16 αποδέσμευση.
>> utf32 := Blob νέο: 13, bytes: (
	Λίστα νέο ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Έξοδος γράψε: ( utf32 αποκωδικοποίηση: ['utf32be'] ), νέα-γραμμή.
utf32 αποδέσμευση.