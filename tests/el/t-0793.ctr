Server init.

>> DB := Maria-DB νέο κόμβος: ['localhost'],
	χρήστης: ['xo'],
	κωδικός: ['pass123'],
	όνομα-βάσης: ['xobase'],
	συνδέσου.

{
	DB ερώτημα:
	['DROP TABLE movies'],
	εκτέλεση.
} σύλληψη: { Κενό. }, εκκίνηση.

DB ερώτημα:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
εκτέλεση.

DB ερώτημα: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
παράμετροι: ( Λίστα νέο ; ['Halloween'] ),
εκτέλεση.

DB ερώτημα: ['SELECT * FROM movies'],
ανάκτηση: { :movie
	Έξοδος γράψε: movie title, νέα-γραμμή.
}.

