# κανονική ροή
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> διαδρομή := ['/tmp/dat.csv'].
>> csv := Αρχείο νέο: διαδρομή.
csv γράψε: s.

# δέχεται CRLF LF CR, μεταβλητό μήκος γραμμής
csv διαχωριστικό: [';'] εισαγωγικό: ['"'] γραμμές: { :line
	Πρόγραμμα καθαρισμός.
	Έξοδος γράψε: line, νέα-γραμμή.
	Πρόγραμμα καθαρισμός.
}.

# άνισες γραμμές
s προσθήκη-στο-τέλος: ['\njustone'].
csv γράψε: s.
{
	csv διαχωριστικό: [';'] εισαγωγικό: ['"'] γραμμές: { :line
		Έξοδος γράψε: line, νέα-γραμμή.
	}.
} σύλληψη: { :e 
	Έξοδος γράψε: e, νέα-γραμμή.
}, εκκίνηση.

# άκυρη μορφή
s := ['"he"llo";world'].
csv γράψε: s.
{
	csv διαχωριστικό: [';'] εισαγωγικό: ['"'] γραμμές: { :line
		Έξοδος γράψε: line, νέα-γραμμή.
	}.
} σύλληψη: { :e 
	Έξοδος γράψε: e, νέα-γραμμή.
}, εκκίνηση.
