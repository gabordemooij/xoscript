#OBSD
>> dirname := [''].
{ dirname προσθήκη-στο-τέλος: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Πρόγραμμα σύστημα: command.
Πρόγραμμα chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename προσθήκη-στο-τέλος: ['YYYYYYYY']. } * 20.
Αρχείο νέο: filename, γράψε: ['sometext'].
{ Αρχείο λίστα: ['/tmp/'] + dirname. } * 1000.
Έξοδος γράψε: ['no crash'], νέα-γραμμή.

