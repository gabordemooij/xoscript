# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Lub-thawv-ruaj-ntseg 
	hash-lo-lus-zais: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Lub-thawv-ruaj-ntseg 
	hash-lo-lus-zais: hash txheeb-xyuas: a1.
	# fail 
>> b := Lub-thawv-ruaj-ntseg
	hash-lo-lus-zais: hash txheeb-xyuas: a2.
	# ok!

Tawm sau-ntawv: a, kab-tshiab.
Tawm sau-ntawv: b, kab-tshiab.

