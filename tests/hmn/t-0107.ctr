
Tawm sau-ntawv: ['Break for-loop, 0-4.'], kab-tshiab.
{ :i
	Tawm sau-ntawv: ['iteration #'] + i, kab-tshiab.
	(i = 4) tso-tseg.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Tawm sau-ntawv: ['Break while-true loop, 0-4.'], kab-tshiab.
{
	Tawm sau-ntawv: ['iteration #'] + x, kab-tshiab.
	x ntxiv: 1.
	((x < 5) rov-qab) tso-tseg.
} thaum-lub-sij-hawm: xIsLessThan10.

Tawm sau-ntawv: ['Break while-false loop, 5,4.'], kab-tshiab.
{
	Tawm sau-ntawv: ['iteration #'] + x, kab-tshiab.
	x rho: 1.
	(x = 3) tso-tseg.
} thaum-lub-sij-hawm: { <- (x > 0). }.

Tawm sau-ntawv: ['Break times loop, 1-4.'], kab-tshiab.
{ :i
	Tawm sau-ntawv: ['iteration #'] + i, kab-tshiab.
	(i = 4) tso-tseg.
} × 5.

Tawm sau-ntawv: ['Break block, dont print line.'], kab-tshiab.
{ Tseeb tso-tseg. Tawm sau-ntawv: ['dont write this!'], kab-tshiab. } pib.

Tawm sau-ntawv: ['Break block, dont fire catch...'], kab-tshiab.
{ Tseeb tso-tseg. Tawm sau-ntawv: ['dont write this!'], kab-tshiab. } txhom: { Tawm sau-ntawv: ['Dont catch this!']. }, pib.

Tawm sau-ntawv: ['Test Array each-loop: 0,1'], kab-tshiab.
(Daim-teev ← 1 ; 2 ; 3) hloov-txhua-yam: { :i
	Tawm sau-ntawv: ['iteration #'] + i, kab-tshiab.
	(i = 1) tso-tseg.
}.

Tawm sau-ntawv: ['Test Map each-loop: c only'], kab-tshiab.
>> m := Phau-txhais-lus tshiab.
m muab: ['first'] rau: ['a'], muab: ['second'] rau: ['b'], muab: ['third'] rau: ['c'].
m txhua: { :k :v
	Tawm sau-ntawv: ['iteration'] + v + k, kab-tshiab.
	Tseeb tso-tseg.
}.

