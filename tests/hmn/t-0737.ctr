#regex test, with positive look around
Server init.
>> subject := ['bacabcca'].
>> pattern := Qauv-nrhiav tshiab: ['(\\w{2})(?=ca)'].
>> result := pattern sib-phim: subject ua: { :m :x
	Tawm sau-ntawv: m, kab-tshiab.
	Tawm sau-ntawv: x, kab-tshiab. <- ['XXX'].
}.
Tawm sau-ntawv: result, kab-tshiab.
