

Kev-pab-cuam-khoos-phis-tawj tswj-chaw-nco: 4.
{
	>> cat := Yam-khoom tshiab.
	cat thaum-tuaj: ['work'] ua: {
		txoj-haujlwm-no yuam-kev: ['Uncatched error has occurred.↵Cats have personel for that!'].
		Tawm sau-ntawv: ['dont print this!'].
	}.
	{ cat work. } pib.
} txhom: { :e
	Tawm sau-ntawv: e.
}, pib.
