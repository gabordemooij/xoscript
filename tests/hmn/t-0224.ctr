
>> countries := Daim-teev tshiab
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Daim-teev tshiab
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods raws-li: countries, txhua: { :key :value
	counter ntxiv: 1.
}.

Tawm sau-ntawv: (['we serve counter dishes'] counter: counter), kab-tshiab.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] cov-tus-ntawv txheeb: { :v
	counter ntxiv: 0.
}.

Tawm sau-ntawv: (['we sort counter dishes'] counter: counter), kab-tshiab.


>> counter := 0.
{
	{
		counter ntxiv: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Tawm sau-ntawv: (['we calculate counter numbers.'] counter: counter), kab-tshiab.

