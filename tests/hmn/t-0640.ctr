
Server init.
Tawm sau-ntawv: ['Database test'], kab-tshiab.

>> db := Maria-DB tshiab tus-tswv-tsev: ['localhost'],
	npe-neeg-siv: ['xo'], 
	lo-lus-zais: ['pass123'],
	npe-chaw-khaws-ntaub-ntawv: ['xobase'],
	txuas-mus.

>> cov-nqe-nrhiav :=
db lus-nug: ['SELECT UNHEX('CAFE') AS blobby'],
mus-nqa: { :row
	Tawm sau-ntawv: ( row blobby los-ntawm: 0 ntev: 2 ), kab-tshiab.
	row blobby tso-tawm.
}.
