(usedMemory1 = usedMemory2 = usedMemory3 = usedMemory4 = usedMemory5) tseeb: {
	Tawm sau-ntawv: ['Memory usage remains stable.'], kab-tshiab.
}, lwm-yam: {
	Tawm sau-ntawv: ['Used memory not stable.'], kab-tshiab.
	Tawm sau-ntawv: usedMemory1, kab-tshiab.
