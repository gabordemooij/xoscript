{
	>> a := ['First'].
	>> b := ['Second'].
	a := b.
	>> garbageMaker := Yam-khoom tshiab.
	garbageMaker method: ['putGarbageOnScreen'] does: {
		>> x := 1.
		>> y := 2.
		Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.
	}.
	garbageMaker putGarbageOnScreen.
	Tawm sau-ntawv: a.
	Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.
} × 1000.
