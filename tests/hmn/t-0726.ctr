# test buffers PKI/Sign 
Server init.

>> long := ( Daim-teev tshiab sau-kom-puv: 1000 nrog: ['a'] ) muab-sib-txuas: [''].

# sign a message
Tawm sau-ntawv: ( 
	Lub-thawv-ruaj-ntseg kos-npe: ['abc'] nrog: long
), kab-tshiab.

Tawm sau-ntawv: ( 
	Lub-thawv-ruaj-ntseg
		kuaj: ['abc'] 
		kos-npe-cim: long 
		nrog: long
), kab-tshiab.

Tawm sau-ntawv: (
	Lub-thawv-ruaj-ntseg hash-lo-lus-zais: long txheeb-xyuas: long
), kab-tshiab.
