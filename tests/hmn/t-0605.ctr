>> invoice := Yam-khoom tshiab.
invoice thaum-tuaj: ['pib'] ua: {
        nws-li lej := 0.
}.

invoice thaum-tuaj: ['lej'] ua: {
        nws-li lej ntxiv: 1. <- nws-li lej luam.
}.

>> year-invoice := invoice tshiab.
year-invoice thaum-tuaj: ['start:'] ua: { :xyoo
	nws-li lej := xyoo.
}.

year-invoice start: 202000.
Tawm sau-ntawv: year-invoice lej, kab-tshiab.
Tawm sau-ntawv: year-invoice lej, kab-tshiab.
