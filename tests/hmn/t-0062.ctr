Tseeb-los-cuav thaum-tuaj: ['xor:'] ua: { :a :b <- ((a thiab: b rov-qab) lossis: (a rov-qab thiab: b)).
}.

>> o := Yam-khoom tshiab.
o thaum-tuaj: ['hello'] ua: { ['Empty']. }.
{ o thaum-tuaj: 2 ua: 3.} txhom: { :e Tawm sau-ntawv: e, kab-tshiab. }, pib.
{ o thaum-tuaj: ['kev-sim'] ua: 3.} txhom: { :e Tawm sau-ntawv: e, kab-tshiab. }, pib.
{ o thaum-tuaj: ['hello'] ua: { ['Empty']. }.} txhom: { :e Tawm sau-ntawv: e, kab-tshiab. }, pib. 
{ >> z := 4 ÷ 0. } txhom: { :e Tawm sau-ntawv: e, kab-tshiab. }, pib. 
{ (Tseeb thiab: Tsis-muaj-dabtsi) tseeb: { Tawm sau-ntawv: ['X'].}. } txhom: { :e Tawm sau-ntawv: e, kab-tshiab. }, pib. 
{ ([''] xor: 0) tseeb: { Tawm sau-ntawv: ['X'].}. } txhom: { :e Tawm sau-ntawv: e, kab-tshiab. }, pib. 
{ (1 < ['2']) tseeb: { Tawm sau-ntawv: ['OK']. }. } txhom: { :e Tawm sau-ntawv: e, kab-tshiab. }, pib. 
{ (1 < ['2.0']) tseeb: { Tawm sau-ntawv: ['OK']. }. } txhom: { :e Tawm sau-ntawv: e, kab-tshiab. }, pib. 
{ (1 < ['x2.0']) tseeb: { Tawm sau-ntawv: ['NO!']. }. } txhom: { :e Tawm sau-ntawv: e, kab-tshiab. }, pib. 
{ Tawm sau-ntawv: (['hello OK there'] los-ntawm: ['6'] ntev: ['2']). } pib. 
