Server init.

# write a test file
>> f := Ntaub-ntawv tshiab: ['/tmp/test.gif'].
f sau-ntawv: ['GIF87a01234567810'].

# serve the file
Server xa-dhau: ['test.gif'] lus-ua-ntej: ['/tmp/'].

Tawm kab-tshiab.

Tawm sau-ntawv: ['Outside container (security):'], kab-tshiab.
{ Server xa-dhau: ['../passwd'] lus-ua-ntej: ['/tmp/']. }
txhom: { :e Tawm sau-ntawv: e, kab-tshiab. },
pib.

Tawm sau-ntawv: ['Invalid prefix:'], kab-tshiab.
{ Server xa-dhau: ['test.gif'] lus-ua-ntej: ['z:\\']. }
txhom: { :e Tawm sau-ntawv: e, kab-tshiab. },
pib.

Tawm sau-ntawv: ['Non-existant file:'], kab-tshiab.
{ Server xa-dhau: ['xxx.xxx'] lus-ua-ntej: ['/tmp/']. }
txhom: { :e Tawm sau-ntawv: e, kab-tshiab. },
pib.
