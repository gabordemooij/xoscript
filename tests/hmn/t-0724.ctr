Tawm sau-ntawv: ['Test object'], kab-tshiab.
>> a := Yam-khoom tshiab. 

a thaum-tuaj: ['item:'] ua: { :file
	nws-li file := file. 
}.

a thaum-tuaj: ['item'] ua: { <- nws-li file.
}.

>> f := Ntaub-ntawv tshiab: ['/tmp/aaa.txt'].
a item: f.
Tawm sau-ntawv: a item, kab-tshiab.
a save-as: ['/tmp/a.bin'].
Tawm sau-ntawv: ['========== RELOADING SNAP:'], kab-tshiab.
>> b := Yam-khoom load-from: ['/tmp/a.bin'].
Tawm sau-ntawv: b item, kab-tshiab.
