

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Kev-pab-cuam-khoos-phis-tawj tswj-chaw-nco: 0.

>> o := Yam-khoom tshiab.
>> o2 := Yam-khoom tshiab.
Tawm sau-ntawv: o Tsis-muaj-dabtsi?, kab-tshiab.
Tawm sau-ntawv: o hom, kab-tshiab.
Tawm sau-ntawv: ( o zoo-ib-yam: o ), kab-tshiab.
Tawm sau-ntawv: ( o zoo-ib-yam: o2 ), kab-tshiab.
Tawm sau-ntawv: o kuv-tus-kheej, kab-tshiab.
Tawm sau-ntawv: ( o ua tiav ), kab-tshiab.

Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.

usedMemory1 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 0).


o := Yam-khoom tshiab.
o2 := Yam-khoom tshiab.
Tawm sau-ntawv: o Tsis-muaj-dabtsi?, kab-tshiab.
Tawm sau-ntawv: o hom, kab-tshiab.
Tawm sau-ntawv: ( o zoo-ib-yam: o ), kab-tshiab.
Tawm sau-ntawv: ( o zoo-ib-yam: o2 ), kab-tshiab.
Tawm sau-ntawv: o kuv-tus-kheej, kab-tshiab.
Tawm sau-ntawv: ( o ua tiav ), kab-tshiab.

Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.
usedMemory2 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 0).


o := Yam-khoom tshiab.
o2 := Yam-khoom tshiab.
Tawm sau-ntawv: o Tsis-muaj-dabtsi?, kab-tshiab.
Tawm sau-ntawv: o hom, kab-tshiab.
Tawm sau-ntawv: ( o zoo-ib-yam: o ), kab-tshiab.
Tawm sau-ntawv: ( o zoo-ib-yam: o2 ), kab-tshiab.
Tawm sau-ntawv: o kuv-tus-kheej, kab-tshiab.
Tawm sau-ntawv: ( o ua tiav ), kab-tshiab.

Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.
usedMemory3 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 0).



( usedMemory1 = usedMemory2 thiab: usedMemory1 = usedMemory3, thiab: usedMemory2 = usedMemory3 ) tseeb: {
	Tawm sau-ntawv: ['No memory leaks here'].
}, cuav: {
	Tawm sau-ntawv: ['Leaking memory...'].
}.
