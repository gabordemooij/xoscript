Tawm sau-ntawv: ['Test object'], kab-tshiab.
>> a := Yam-khoom tshiab. 

a thaum-tuaj: ['item:'] ua: { :out
	nws-li out := out. 
}.

a thaum-tuaj: ['item'] ua: { <- nws-li out.
}.

a thaum-tuaj: ['greet'] ua: {
	Tawm sau-ntawv: ['hi from original out!'], kab-tshiab.
}.

a item: Tawm.

Tawm sau-ntawv: a item, kab-tshiab.

>> old-out-address := a item qauv-thawj chaw-nyob-nco.
a save-as: ['/tmp/a.bin'].
Tawm sau-ntawv: ['========== RELOADING SNAP:'], kab-tshiab.

>> b := Yam-khoom load-from: ['/tmp/a.bin'].

(b item qauv-thawj chaw-nyob-nco = old-out-address) tseeb: {
	Tawm sau-ntawv: ['Object link re-attached.'], kab-tshiab.
}.

b item sau-ntawv: ['hello from loaded out!'], kab-tshiab.
b greet.
