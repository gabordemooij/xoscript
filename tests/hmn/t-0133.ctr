


>> Deck := Daim-teev tshiab.
Deck thaum-tuaj: ['print'] ua: {
        >> len := tus-kheej tus-lej-suav - 1.
        { :i
                >> len2 := tus-kheej tus-lej-suav - 1.
                Tawm sau-ntawv: ['len: '].
                Tawm sau-ntawv: len, kab-tshiab.
                Tawm sau-ntawv: ['len2: '].
                Tawm sau-ntawv: len2, kab-tshiab.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
