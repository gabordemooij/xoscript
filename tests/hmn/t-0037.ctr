>> a := 3.
>> b := a luam.
a rho: 1.
Tawm sau-ntawv: [' a = '] + a.
Tawm sau-ntawv: [' b = '] + b.
a := 3.
b := a + 4.
Tawm sau-ntawv: [' a = '] + a.
Tawm sau-ntawv: [' b = '] + b.
>> x := 3.
>> y := x luam.
x ntxiv: 10.
y rho: 1.
Tawm sau-ntawv: [' x = '] + x.
Tawm sau-ntawv: [' y = '] + y.
>> q := Yam-khoom tshiab.
q thaum-tuaj: ['setProperty:'] ua: { :x
	nws-li prop := x.
}.
q thaum-tuaj: ['getProperty'] ua: { <- nws-li prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Tawm sau-ntawv: [' p = '] + (p getProperty).
