# catch-all test (practical)
>> HTML := Kab-ntawv tshiab.
HTML thaum-tuaj: ['encode:'] ua: { :tekst
	tus-kheej ntxiv-tom-kawg: (tekst
	hloov: ['&'] nrog: ['&amp;'], 
	hloov: ['<'] nrog: ['&lt;'],
	hloov: ['>'] nrog: ['&gt;'],
	hloov: ['"'] nrog: ['&quot;']).
}.
>> blog := HTML tshiab.
blog ntxiv-tom-kawg: ['<h1>'],
     encode: ['Koffie & Thee'],
     ntxiv-tom-kawg: ['</h1>'].
Tawm sau-ntawv: blog, kab-tshiab.


>> Roman := Lej tshiab.
Roman thaum-tuaj: ['stringy'] ua: {
	>> a := [''].
	{ a ntxiv-tom-kawg: ['I']. } × tus-kheej. <- a.
}.

>> x := Roman tshiab.
x ntxiv: 3.
Tawm sau-ntawv: x stringy, kab-tshiab.

>> Quantum := Tseeb-los-cuav tshiab.
Quantum thaum-tuaj: ['true?'] ua: { <- ['maybe True']. }.
Tawm sau-ntawv: (Quantum tshiab true?), kab-tshiab.

>> Nihil := Tsis-muaj-dabtsi tshiab.
Nihil thaum-tuaj: ['kab-ntawv'] ua: { <- ['Nihil']. }.
Tawm sau-ntawv: (Nihil tshiab), kab-tshiab.
