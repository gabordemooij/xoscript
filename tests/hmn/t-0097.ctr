
Kab-ntawv thaum-tuaj: ['html'] ua: { <- (
		tus-kheej
		hloov: ['&'] nrog: ['&amp;'],
		hloov: ['<'] nrog: ['&lt;'],
		hloov: ['>'] nrog: ['&gt;'],
		hloov: ['"'] nrog: ['&quot;']
	).
}.

>> HtmlBrush := Yam-khoom tshiab.

HtmlBrush thaum-tuaj: ['teb:'] ua: { :tag
	Tawm sau-ntawv: (['<tag>↵'] tag: tag ).
}.

HtmlBrush thaum-tuaj: ['teb:thiab:'] ua: { :tag :content
	tag := ( tag los-ntawm: 0 ntev: (tag qhov-ntev - 1) ).
	Tawm sau-ntawv: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush thaum-tuaj: ['content:'] ua: { :text
	Tawm sau-ntawv: text html, kab-tshiab.
}.

HtmlBrush thaum-tuaj: ['attr:value:'] ua: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush tshiab.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
