

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Kev-pab-cuam-khoos-phis-tawj tswj-chaw-nco: 0.

>> txt := ['Word Salad'].
Tawm sau-ntawv: ['last index of ord = '] + (( txt qhov-chaw-kawg: ['ord'] ) - 0), kab-tshiab.
Tawm sau-ntawv: ['index of ord = '] + (( txt nrhiav: ['ord'] ) - 0), kab-tshiab.
Tawm sau-ntawv: ['index of ad = '] + (( txt nrhiav: ['ad'] ) - 0), kab-tshiab.
Tawm sau-ntawv: ['last index of W = '] + (( txt qhov-chaw-kawg: ['W'] ) - 0), kab-tshiab.
Tawm sau-ntawv: ['last index of d = '] + (( txt qhov-chaw-kawg: ['d'] ) - 0), kab-tshiab.
Tawm sau-ntawv: ['txt equals Word Salad = '] + ( txt = ['Word Salad'] ), kab-tshiab.
Tawm sau-ntawv: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), kab-tshiab.
Tawm sau-ntawv: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), kab-tshiab.
Tawm sau-ntawv: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), kab-tshiab.

Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.

