Kev-pab-cuam-khoos-phis-tawj tswj-chaw-nco: 0.
Daim-teev thaum-tuaj: ['sum'] ua: {
	>> total := 0.
	tus-kheej txhua: { :index :element
		total ntxiv: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Ntaub-ntawv tshiab: ['/tmp/test.txt'].
f sau-ntawv: ['Lorem Ipsum'].
f kaw.
  

f := Ntaub-ntawv tshiab: ['/tmp/test.txt'].
>> text := f nyeem.
f kaw.



Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.
usedMemory1 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 1).



f := Ntaub-ntawv tshiab: ['/tmp/test.txt'].
text := f nyeem.
f kaw.

Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.
usedMemory2 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 1).


f := Ntaub-ntawv tshiab: ['/tmp/test.txt'].
text := f nyeem.
f kaw.

Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.
usedMemory3 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 1).



( usedMemory1 = usedMemory2 thiab: usedMemory1 = usedMemory3, thiab: usedMemory2 = usedMemory3 ) tseeb: {
	Tawm sau-ntawv: ['No memory leaks here'].
}, cuav: {
	Tawm sau-ntawv: ['Leaking memory...'].
}.
