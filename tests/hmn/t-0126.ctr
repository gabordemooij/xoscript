#Linux
>> Slurp := Yam-khoom tshiab.

Slurp thaum-tuaj: ['tshiab'] ua: {
	nws-li str := [''].
}.

Slurp thaum-tuaj: ['nieuw'] ua: {
	nws-li str := [''].
}.

Slurp thaum-tuaj: ['teb:'] ua: { :blah
		nws-li str ntxiv-tom-kawg: blah.
}.

Slurp thaum-tuaj: ['teb:thiab:'] ua: { :blah :blahah
		nws-li str ntxiv-tom-kawg: (blah los-ntawm: 0 ntev: (blah qhov-ntev - 1)).
		nws-li str ntxiv-tom-kawg: [' '].
		nws-li str ntxiv-tom-kawg: blahah.
}.

Slurp thaum-tuaj: ['obtain'] ua: {
	>> buffer := nws-li str.
	nws-li str := ['']. <- buffer.
}.


Tawm sau-ntawv: (Kev-pab-cuam-khoos-phis-tawj txheej-txheem-tshuab: (Slurp tshiab echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Ntaub-ntawv tshiab: ['/tmp/from.txt'], rho-tawm. } txhom: { ['Empty']. }, pib.
{ Ntaub-ntawv tshiab: ['/tmp/to.txt'], rho-tawm. } txhom: { ['Empty']. }, pib.


Ntaub-ntawv tshiab: ['/tmp/to.txt'], muaj-nyob cuav: {
	Tawm sau-ntawv: ['Confirmed. Target file does not exist.\
'].
}.
Ntaub-ntawv tshiab: ['/tmp/from.txt'], muaj-nyob cuav: {
	Tawm sau-ntawv: ['Confirmed. Source file does not exist.\
'].
}.



Kev-pab-cuam-khoos-phis-tawj txheej-txheem-tshuab: (Slurp tshiab touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Kev-pab-cuam-khoos-phis-tawj txheej-txheem-tshuab: (Slurp tshiab cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Ntaub-ntawv tshiab: ['/tmp/to.txt'], muaj-nyob tseeb: {
	Tawm sau-ntawv: ['Confirmed. Target file has been created by shell.\
'].
}.


Tawm sau-ntawv: ['Contents of file is:'] + (Ntaub-ntawv tshiab: ['/tmp/to.txt'], nyeem), kab-tshiab.
