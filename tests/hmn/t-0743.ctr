>> V := Yam-khoom.
V thaum-tuaj: ['kab-ntawv'] ua: {
	Tawm sau-ntawv: ['cast'], kab-tshiab. <- ['abc'].
}.

Tawm sau-ntawv: ( Kev-pab-cuam-khoos-phis-tawj kev-teeb-tsa: ['abc'] ), kab-tshiab.

# params should not get gc'ed
Kev-pab-cuam-khoos-phis-tawj kev-teeb-tsa: ([''] + V tshiab) tus-nqi: ([''] + V tshiab).

Tawm sau-ntawv: ( Kev-pab-cuam-khoos-phis-tawj kev-teeb-tsa: ['abc'] ), kab-tshiab.
