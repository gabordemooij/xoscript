Server init.

>> DB := Maria-DB tshiab tus-tswv-tsev: ['localhost'],
	npe-neeg-siv: ['xo'],
	lo-lus-zais: ['pass123'],
	npe-chaw-khaws-ntaub-ntawv: ['xobase'],
	txuas-mus.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> cov-nqe-nrhiav := Lus-nug-Maria tshiab: SQL.

# set database
cov-nqe-nrhiav chaw-khaws-ntaub-ntawv: DB.

cov-nqe-nrhiav mus-nqa: { :row
	Tawm sau-ntawv: row world, kab-tshiab.
}.
