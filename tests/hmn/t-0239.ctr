Daim-teev thaum-tuaj: ['sum'] ua: {
	>> total := 0.
	tus-kheej txhua: { :index :element
		total ntxiv: element.
	}. <- total.
}.

>> a := Tseeb.



a thaum-tuaj: ['kab-ntawv'] ua: {
	>> answer := Tsis-muaj-dabtsi.
	( tus-kheej = Tseeb ) tseeb: {
		answer := ['Yep'].
	}, lwm-yam: {
		answer := ['Nope'].
	}. <- answer.
}.

a thaum-tuaj: ['lej'] ua: {
	>> answer := Tsis-muaj-dabtsi.
	( tus-kheej = Tseeb ) tseeb: {
		answer := 10.
	}, lwm-yam: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b thaum-tuaj: ['kab-ntawv'] ua: { <- ['Devil'].
}.

b thaum-tuaj: ['tseeb-los-cuav'] ua: { <- Cuav.
}.


Tawm sau-ntawv: a, kab-tshiab.  
Tawm sau-ntawv: (90 + a), kab-tshiab. 
Tawm sau-ntawv: b, kab-tshiab. 
Tawm sau-ntawv: (Tseeb thiab: b), kab-tshiab.

a := Daim-teev ← ['hello'] ; ['world'] ; Tseeb ; Tsis-muaj-dabtsi ; 666. 
a := a + ( Daim-teev ← 1 ).
Tawm sau-ntawv: a, kab-tshiab.
Tawm sau-ntawv: ((Phau-txhais-lus tshiab) muab: Tsis-muaj-dabtsi rau: Tsis-muaj-dabtsi), kab-tshiab.
Tawm sau-ntawv: a sum, kab-tshiab. 


{
	a thaum-tuaj: ['kab-ntawv'] ua: { <- Tsis-muaj-dabtsi. }.
	a := [''] + a.
} txhom: { :error
	Tawm sau-ntawv: ['Error noted: '] + error, kab-tshiab.
}, pib.



{
	a thaum-tuaj: ['lej'] ua: { <- Tsis-muaj-dabtsi. }.
	a := 3 × a.
} txhom: { :error
	Tawm sau-ntawv: ['Error noted: '] + error, kab-tshiab.
}, pib.


{
	a thaum-tuaj: ['tseeb-los-cuav'] ua: { <- Tsis-muaj-dabtsi. }.
	a := Tseeb thiab: a. 
} txhom: { :error
	Tawm sau-ntawv: ['Error noted: '] + error, kab-tshiab.
}, pib.





{
	a thaum-tuaj: ['kab-ntawv'] ua: { <- Cuav. }.
	a := [''] + a.
} txhom: { :error
	Tawm sau-ntawv: ['Error noted: '] + error, kab-tshiab.
}, pib.



{
	a thaum-tuaj: ['lej'] ua: { <- Tseeb. }.
	a := 3 × a.
} txhom: { :error
	Tawm sau-ntawv: ['Error noted: '] + error, kab-tshiab.
}, pib.


{
	a thaum-tuaj: ['boolean'] ua: { <- 1. }.
	a := Tseeb thiab: a.
} txhom: { :error
	Tawm sau-ntawv: ['Error noted: '] + error, kab-tshiab.
}, pib.





