Server init.

>> x := Blob tshiab: 65 hom: ['char'].
# for this test you need set a path to libc (puts)
>> libname := Kev-pab-cuam-khoos-phis-tawj kev-teeb-tsa: ['FFITESTLIB'].
Server txuas: (
 Daim-teev tshiab ;
 libname ;
 ['putchar'] ;
 ( Daim-teev tshiab ; ['char'] ) ;
 ['void'] ;
 ['Print'] ;
 ['char:']
).
Print char: (x los-ntawm: 0 ntev: 1), kab-tshiab.
x tso-tawm.

