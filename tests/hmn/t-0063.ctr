>> Product := Yam-khoom tshiab.
Product thaum-tuaj: ['a'] ua: { :price
	Tawm sau-ntawv: ['cost ']+ price.
}.
>> Apples := Product tshiab.
Tawm sau-ntawv: ['Apples cost: '].
Apples a 60.
Tawm sau-ntawv: [' cent a piece.'].
Lej thaum-tuaj: ['X'] ua: { :b
	b × tus-kheej.
}.
7 X { :i Tawm sau-ntawv: i. }.
