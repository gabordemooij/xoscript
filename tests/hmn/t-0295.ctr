
>> dictionary := (
	Phau-txhais-lus tshiab
		muab: ['b'] rau: ['a'],
		muab: ['a'] rau: ['b'],
		muab: ['z'] rau: ['x'],
		muab: ['hello'] rau: ['hallo'],
		muab: ['human'] rau: ['human']
).

>> comparisons := Daim-teev tshiab.
dictionary txhua: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a piv: b)
	).
}.

comparisons txheeb: { :a :b <- ( a piv: b ). }.
Tawm sau-ntawv: ( comparisons muab-sib-txuas: ['↵'] ), kab-tshiab.
comparisons muab-sib-txuas: ['↵'].
