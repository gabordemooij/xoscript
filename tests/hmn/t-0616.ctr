Daim-teev thaum-tuaj: ['luam'] ua: {
	>> luam := Daim-teev tshiab.
	tus-kheej txhua: { :lej :section
		luam ntxiv-tom-kawg: section hu-nws-tus-kheej luam.
	}. <- luam.
}.

>> sheep := Daim-teev tshiab ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep luam.
clones txhua: { :lej :sheep
	sheep ntxiv-tom-kawg: ['2'].
}.

Tawm sau-ntawv: sheep, kab-tshiab.
Tawm sau-ntawv: clones, kab-tshiab.
