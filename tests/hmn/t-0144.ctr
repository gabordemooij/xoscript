



>> CoffeeGrounds := Yam-khoom tshiab.
CoffeeGrounds thaum-tuaj: ['extract'] ua: { <- ['coffee']. }.

>> CoffeeMachine := Yam-khoom tshiab.
CoffeeMachine thaum-tuaj: ['init'] ua: {
	nws-li coffeegrounds := CoffeeGrounds tshiab.
}.
CoffeeMachine thaum-tuaj: ['tshiab'] ua: { <- CoffeeMachine `new init.
}.

CoffeeMachine thaum-tuaj: ['makeTea'] ua: { <- (nws-li tealeaves extract). }.
CoffeeMachine thaum-tuaj: ['makeCoffee'] ua: { <- (nws-li coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine tshiab.

Tawm sau-ntawv:
	coffeeDream 
	makeCoffee.

Tawm sau-ntawv:
	coffeeDream 
	makeTea.
