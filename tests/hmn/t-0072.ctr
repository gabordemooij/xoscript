>> echo := Yam-khoom tshiab.
echo thaum-tuaj: ['teb:'] ua: { :sound
	{ Tawm sau-ntawv: sound. } × 2.
}.
echo ho!. 


echo := Yam-khoom tshiab.
echo thaum-tuaj: ['teb:thiab:'] ua: { :sound :x
	{ Tawm sau-ntawv: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := Yam-khoom tshiab.
echo thaum-tuaj: ['teb:thiab:thiab:'] ua: { :operation :sound :x
	{ Tawm sau-ntawv: sound. } × x.
}.
echo shout: ['la'] times: 4. 


