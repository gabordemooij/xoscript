
>> a := Daim-teev ← (Daim-teev ← 100 ; 200 ; 300) ; (Daim-teev ← 9 ; 8 ; 7).
Tawm sau-ntawv: ['at 0,1 :'].
Tawm sau-ntawv: a ? 0 ? 1, kab-tshiab. 
Tawm sau-ntawv: ['at 1,2 :'].
Tawm sau-ntawv: a ? 1 ? 2, kab-tshiab. 
>> menu := Phau-txhais-lus tshiab.
menu muab: (Daim-teev ← ['pizza'] ; ['spaghetti']) rau: ['Italian Cuisine'].
menu muab: (Daim-teev ← ['bifteki'] ; ['suflaki']) rau: ['Greek Cuisine'].
Tawm sau-ntawv: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), kab-tshiab. 
Tawm sau-ntawv: ['but not on the same plate.'], kab-tshiab.
