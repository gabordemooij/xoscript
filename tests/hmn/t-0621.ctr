>> phrases := Daim-teev tshiab
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases txhua: { :_ :phrase 
	>> e := Server base64-ua-cim: phrase.
	>> d := Server base64-daws-cim: e.
	Tawm sau-ntawv: (
		message luam ~encoded: e, ~decoded: d
	), kab-tshiab.
}.
