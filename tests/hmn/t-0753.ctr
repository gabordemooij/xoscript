Tawm sau-ntawv: ['Test object'], kab-tshiab.
>> a := Yam-khoom tshiab. 

a thaum-tuaj: ['item:'] ua: { :fmt
	nws-li fmt := fmt. 
}.

a thaum-tuaj: ['item'] ua: { <- nws-li fmt.
}.

a item: ( Hom-ntawv tshiab: ['|%s|'] ).

Tawm sau-ntawv: a item, kab-tshiab.

>> old-fmt-address := a item qauv-thawj chaw-nyob-nco.
a save-as: ['/tmp/a.bin'].
Tawm sau-ntawv: ['========== RELOADING SNAP:'], kab-tshiab.

>> b := Yam-khoom load-from: ['/tmp/a.bin'].

(b item qauv-thawj chaw-nyob-nco = old-fmt-address) tseeb: {
	Tawm sau-ntawv: ['Object link re-attached.'], kab-tshiab.
}.

Tawm sau-ntawv: ( b item siv-rau: ['hello'] ), kab-tshiab.
