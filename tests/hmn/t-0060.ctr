>> a := Daim-teev tshiab.
a ntxiv-tom-ntej: ['Hello'].
a ntxiv-tom-ntej: ['World'].
Tawm sau-ntawv: (a qhov-chaw: 1), sau-ntawv: (a qhov-chaw: 0), kab-tshiab.
Tawm sau-ntawv: (a tus-lej-suav) + [' left in array.'], kab-tshiab.
Tawm sau-ntawv: (a rho-thawj), sau-ntawv: (a rho-thawj), sau-ntawv: a rho-thawj, kab-tshiab.
Tawm sau-ntawv: (a tus-lej-suav) + [' left in array.'], kab-tshiab.
Tawm sau-ntawv: (a rho-kawg), kab-tshiab.
a ntxiv-tom-ntej: ['Hi'], ntxiv-tom-ntej: ['There'].
Tawm sau-ntawv: (a tus-lej-suav) + [' left in array.'], kab-tshiab.
Tawm sau-ntawv: (a qhov-chaw: 1), sau-ntawv: (a qhov-chaw: 0), kab-tshiab.
{ a rho-thawj. } × 4.
Tawm sau-ntawv: (a tus-lej-suav) + [' left in array.'], kab-tshiab.
Tawm sau-ntawv: a rho-thawj.
