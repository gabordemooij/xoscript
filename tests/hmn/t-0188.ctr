

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Kev-pab-cuam-khoos-phis-tawj tswj-chaw-nco: 0.

{ :i Tawm sau-ntawv: i. } × 4.
Tawm kab-tshiab.
{ :i Tawm sau-ntawv: (4 - i). } × 4.
Tawm kab-tshiab.
( 1 > 2 ) cuav: { Tawm sau-ntawv: ['BLOCK 1'], kab-tshiab. }.
( 2 > 1 ) tseeb:  { Tawm sau-ntawv: ['BLOCK 2'], kab-tshiab. }.

>> i := 0.
{ Tawm sau-ntawv: i. i ntxiv: 1. } thaum-lub-sij-hawm: { <- ( i < 3). }.
Tawm kab-tshiab.

i := 3.
{ Tawm sau-ntawv: i. i := i - 1. } thaum-lub-sij-hawm: { <- ( i > 0). }.
Tawm kab-tshiab.


Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.

usedMemory1 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 0).


{ :i  Tawm sau-ntawv: i. } × 4.
Tawm kab-tshiab.
{ :i  Tawm sau-ntawv: (4 - i). } × 4.
Tawm kab-tshiab.
( 1 > 2 ) cuav: { Tawm sau-ntawv: ['BLOCK 1'], kab-tshiab. }.
( 2 > 1 ) tseeb:  { Tawm sau-ntawv: ['BLOCK 2'], kab-tshiab. }.

>> i := 0.
{ Tawm sau-ntawv: i. i ntxiv: 1. } thaum-lub-sij-hawm: { <- ( i < 3). }.
Tawm kab-tshiab.

i := 3.
{ Tawm sau-ntawv: i. i := i - 1. } thaum-lub-sij-hawm: { <- ( i > 0). }.
Tawm kab-tshiab.



Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.
usedMemory2 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 0).


{ :i Tawm sau-ntawv: i. } × 4.
Tawm kab-tshiab.
{ :i Tawm sau-ntawv: (4 - i). } × 4.
Tawm kab-tshiab.
( 1 > 2 ) cuav: { Tawm sau-ntawv: ['BLOCK 1'], kab-tshiab. }.
( 2 > 1 ) tseeb:  { Tawm sau-ntawv: ['BLOCK 2'], kab-tshiab. }.

>> i := 0.
{ Tawm sau-ntawv: i. i ntxiv: 1. } thaum-lub-sij-hawm: { <- ( i < 3). }.
Tawm kab-tshiab.

i := 3.
{ Tawm sau-ntawv: i. i := i - 1. } thaum-lub-sij-hawm: { <- ( i > 0). }.
Tawm kab-tshiab.

Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.
usedMemory3 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 0).



( usedMemory1 = usedMemory2 thiab: usedMemory1 = usedMemory3, thiab: usedMemory2 = usedMemory3 ) tseeb: {
	Tawm sau-ntawv: ['No memory leaks here'].
}, cuav: {
	Tawm sau-ntawv: ['Leaking memory...'].
}.
