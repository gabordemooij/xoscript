Server init.

>> DB := Maria-DB tshiab tus-tswv-tsev: ['localhost'],
	npe-neeg-siv: ['xo'],
	lo-lus-zais: ['pass123'],
	npe-chaw-khaws-ntaub-ntawv: ['xobase'],
	txuas-mus.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB lus-nug: SQL.

# now you don't have to set DB
query2 mus-nqa: { :row
	Tawm sau-ntawv: row world, kab-tshiab.
}.
