>> t := Tseeb.
(t = Tseeb) tseeb: { Tawm sau-ntawv: ['T']. }.
(t = Cuav) tseeb: { Tawm sau-ntawv: ['F']. }.
Tawm sau-ntawv: ['|'].
>> t := Cuav.
(t = Tseeb) tseeb: { Tawm sau-ntawv: ['T']. }.
(t = Cuav) tseeb: { Tawm sau-ntawv: ['F']. }.
Tawm sau-ntawv: ['|'].
>> f := Tseeb.
(t = Tseeb thiab: f = Cuav) tseeb: { Tawm sau-ntawv: ['T']. }.
(t = Cuav thiab: f = Tseeb) tseeb: { Tawm sau-ntawv: ['F']. }.
Tawm sau-ntawv: ['|'].
>> n := Tsis-muaj-dabtsi.
(n Tsis-muaj-dabtsi?) tseeb: { Tawm sau-ntawv: ['T']. }.
(n Tsis-muaj-dabtsi?) cuav: { Tawm sau-ntawv: ['F']. }.
Tawm sau-ntawv: ['|'].
(f Boolean?) tseeb: { Tawm sau-ntawv: ['T']. }.
(f Boolean?) cuav: { Tawm sau-ntawv: ['F']. }.



