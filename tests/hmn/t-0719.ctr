Server init.
>> fmt := Hom-ntawv tshiab: ['%#3x'].

>> blob := Blob tshiab: 4.
blob bytes: ( 
	Daim-teev tshiab ; 0 ; 1 ; 2 ; 3
).

>> file := Ntaub-ntawv tshiab: ['/tmp/blob'].
file blob: blob.
blob tso-tawm.

>> nyeem := file blob.
nyeem 
los-ntawm: 0 
ntev: 4, 
ua txhua: { :i :b 
	Tawm
	sau-ntawv: (fmt siv-rau-lej-tag-nrho: b),
	kab-tshiab.
}.
nyeem tso-tawm.
