# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> txoj-kev-ntaub-ntawv := ['/tmp/dat.csv'].
>> csv := Ntaub-ntawv tshiab: txoj-kev-ntaub-ntawv.
csv sau-ntawv: s.

# accepts CRLF LF CR, varying row length
csv tus-cais: [';'] cim-hais-lus: ['"'] cov-kab: { :line
	Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.
	Tawm sau-ntawv: line, kab-tshiab.
	Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.
}.

# unequal lines
s ntxiv-tom-kawg: ['\njustone'].
csv sau-ntawv: s.
{
	csv tus-cais: [';'] cim-hais-lus: ['"'] cov-kab: { :line
		Tawm sau-ntawv: line, kab-tshiab.
	}.
} txhom: { :e 
	Tawm sau-ntawv: e, kab-tshiab.
}, pib.

# invalid format
s := ['"he"llo";world'].
csv sau-ntawv: s.
{
	csv tus-cais: [';'] cim-hais-lus: ['"'] cov-kab: { :line
		Tawm sau-ntawv: line, kab-tshiab.
	}.
} txhom: { :e 
	Tawm sau-ntawv: e, kab-tshiab.
}, pib.
