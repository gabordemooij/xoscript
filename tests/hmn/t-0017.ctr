Lej thaum-tuaj: ['factorial'] ua: {
	>> total := 1.
	{ :index total khoo-nrog: (tus-kheej - (index)). } × tus-kheej. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Tawm sau-ntawv: a.
>> b := 2 + 3 factorial.
Tawm sau-ntawv: b.
>> c := 3 factorial + 2.
Tawm sau-ntawv: c.
>> d := 2 + (3 factorial).
Tawm sau-ntawv: d.
Tawm sau-ntawv: 2 + 3 factorial + 1.
