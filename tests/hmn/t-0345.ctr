# test catch-all methods
>> x13 := Yam-khoom tshiab.
x13 thaum-tuaj: ['a'] ua: { :a Tawm sau-ntawv: 0, kab-tshiab. }.
x13 thaum-tuaj: ['a:'] ua: { :a Tawm sau-ntawv: a, kab-tshiab. <- 5. }.
x13 thaum-tuaj: ['a:b:'] ua: { :a :b Tawm sau-ntawv: (a + b), kab-tshiab. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
