Kev-pab-cuam-khoos-phis-tawj tswj-chaw-nco: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } txhom: {
		oops ntxiv: 1.
	}, pib.
} × 1000.

{
	Tawm sau-ntawv: ['hi there!'].
	txoj-haujlwm-no yuam-kev: ['oops'].
	Tawm sau-ntawv: ['hi there!'].
	{ Tawm sau-ntawv: ['dont print this']. } pib.
} txhom: { :e 
	Tawm sau-ntawv: ['got ya!']. 
	Tawm sau-ntawv: e.
}, pib.
