Tawm sau-ntawv: ((Daim-teev tshiab
	thaum-tuaj: ['plaque:'] ua: { :x nws-li o := x. },
	thaum-tuaj: ['plaque']  ua: { <- nws-li o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Daim-teev ← 1)
	~ (Daim-teev ← 1 ; 2)
	~ (Daim-teev ← 1 ; 2 ; 3)
	~ (Daim-teev ← 1 ; 2 ; 3 ; 4)
	~ (Daim-teev ← 1 ; 2 ; 3 ; 4 ; 5)
) txhua: { :i :el
	{ Tawm sau-ntawv: txoj-haujlwm-no. } × el tus-lej-suav.
	Tawm kab-tshiab.
}) plaque, kab-tshiab.


