Tawm sau-ntawv: ['Test object'], kab-tshiab.
>> greeter := Yam-khoom tshiab.
greeter thaum-tuaj: ['name:'] ua: { :npe
	nws-li xname := npe. 
}.
greeter thaum-tuaj: ['greet'] ua: {
	Tawm sau-ntawv: ['Hello '] + nws-li xname, kab-tshiab.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Tawm sau-ntawv: ['========== RELOADING SNAP:'], kab-tshiab.
>> b := Yam-khoom load-from: ['/tmp/a.bin'].
>> c := Yam-khoom load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
