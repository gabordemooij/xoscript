
Kev-pab-cuam-khoos-phis-tawj tswj-chaw-nco: 1.
Kev-pab-cuam-khoos-phis-tawj chaw-nco: 16000000.
>> tokens := ['{}↲.:,x() '].
{ :i
	>> cim-khoos-phis-tawj := [''].
	>> x := Lej ntawm: 1 thiab: 10.
	{
		>> y := Lej ntawm: 1 thiab: (tokens qhov-ntev).
		cim-khoos-phis-tawj ntxiv-tom-kawg: (tokens tus-ntawv: y).
	} × x.
	{ Haujlwm tshiab: cim-khoos-phis-tawj. } txhom: { ['Empty']. }, pib.

} × 10000.
Tawm sau-ntawv: ['OK'], kab-tshiab.
