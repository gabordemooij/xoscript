Server init.

>> db := Maria-DB tshiab tus-tswv-tsev: ['localhost'],
	npe-neeg-siv: ['xo'],
	lo-lus-zais: ['pass123'],
	npe-chaw-khaws-ntaub-ntawv: ['xobase'],
	txuas-mus.

>> del := db lus-nug: ['DELETE FROM book WHERE id > 0'].
{  del ua-raws-lus-txib. db lees-paub. } txhom: { :e db thim-rov-qab.  }, pib.

>> tus-lej-suav := db lus-nug: ['SELECT COUNT(*) AS num FROM book'].
tus-lej-suav mus-nqa: { :row Tawm sau-ntawv: row num, kab-tshiab. }.
