>> z := Yam-khoom tshiab.
z thaum-tuaj: ['value:'] ua: { :v
	nws-li value := v. <- tus-kheej.
}.
z thaum-tuaj: ['value'] ua: { <- nws-li value. }.
(z setValue: 1) value: 2.
Tawm sau-ntawv: z value.
>> x := z.
Tawm sau-ntawv: x value.
z := Tsis-muaj-dabtsi.
Tawm sau-ntawv: z value.
Tawm sau-ntawv: x value.
Tawm sau-ntawv: ['hello'].
Tawm sau-ntawv: 3 + 2.
Tawm sau-ntawv: (3 > 2).
