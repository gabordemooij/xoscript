Tawm sau-ntawv: ['Test object'], kab-tshiab.
>> a := Yam-khoom tshiab. 

a thaum-tuaj: ['state:'] ua: { :list
	nws-li list := list. 
}.

a thaum-tuaj: ['state'] ua: {
	Tawm sau-ntawv: nws-li list, kab-tshiab.
}.

a state: ( Daim-teev tshiab ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
Tawm sau-ntawv: ['========== RELOADING SNAP:'], kab-tshiab.
>> b := Yam-khoom load-from: ['/tmp/a.bin'].
b state.