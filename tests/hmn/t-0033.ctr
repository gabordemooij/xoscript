>> x := Yam-khoom tshiab.
x thaum-tuaj: ['set:'] ua: { :v nws-li val := v. }.
x thaum-tuaj: ['get'] ua: { <- nws-li val. }.
>> a := Yam-khoom tshiab.
a thaum-tuaj: ['init'] ua: {
	>> y := x tshiab.
	y set: 123.
	>> q := x tshiab.
	q set: 666.
	Tawm sau-ntawv: (y get), sau-ntawv: (q get).
}.
a init.
