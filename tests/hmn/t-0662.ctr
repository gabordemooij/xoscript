>> t := Tsis-muaj-dabtsi.

# you can control the time zone for
# parsing like this:
Lub-sijhawm cheeb-tsam-sijhawm: ['CET'].
t := Lub-sijhawm qhov-pib: ['1981-02-03 04:05:06'].
Tawm sau-ntawv: t, kab-tshiab.

# now using CEST time zone:
Lub-sijhawm cheeb-tsam-sijhawm: ['CEST'].
t := Lub-sijhawm qhov-pib: ['1981-02-03 04:05:06'].
Tawm sau-ntawv: t, kab-tshiab.

# error if string cannot be parsed
{ Lub-sijhawm qhov-pib: ['1900']. } txhom: { Tsis-muaj-dabtsi. }, pib.
