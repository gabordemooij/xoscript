Server init.
Tawm sau-ntawv: ['Database time test'], kab-tshiab.

>> db := Maria-DB tshiab tus-tswv-tsev: ['localhost'],
	npe-neeg-siv: ['xo'], 
	lo-lus-zais: ['pass123'],
	npe-chaw-khaws-ntaub-ntawv: ['xobase'],
	txuas-mus.

>> cov-nqe-nrhiav :=
db lus-nug: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
mus-nqa: { :row
	Tawm sau-ntawv: row timetest, kab-tshiab.
}.
