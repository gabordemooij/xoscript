Tawm sau-ntawv: (['a:b:'] - [':']), kab-tshiab.
Tawm sau-ntawv: (['Lorem Ipsum'] - ['Ipsum']), kab-tshiab.
Tawm sau-ntawv: (['a.................b.......................c...........'] - ['.']), kab-tshiab.
Tawm sau-ntawv: (['a--b--c---d'] - ['--']), kab-tshiab.
Tawm sau-ntawv: (['-'] - ['--']), kab-tshiab.
Tawm sau-ntawv: ([''] - ['--']), kab-tshiab.
Tawm sau-ntawv: (['--'] - ['']), kab-tshiab.
Tawm sau-ntawv: ([''] - ['']), kab-tshiab.
>> x := ['xx'].
>> y := x - ['x'].
Tawm sau-ntawv: x, kab-tshiab.
Tawm sau-ntawv: y, kab-tshiab.
>> x := ['a,bb,c'].
>> y := x hloov: [''] nrog: ['xx'].
Tawm sau-ntawv: ((x zoo-ib-yam: y) qhov-no: ['OK'] lossis-qhov-ntawd: ['BUG! Did return a copy by accident!']), kab-tshiab.