# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Lub-thawv-ruaj-ntseg tsim-yuam-sij.

# private (secret) key
>> sk := keys thawj-zaug.

# public key
>> pk := keys kawg.

# sign a message
>> sig := Lub-thawv-ruaj-ntseg kos-npe: ['abc'] nrog: sk.

# check message (ok)
Tawm sau-ntawv: ( 
	Lub-thawv-ruaj-ntseg
		kuaj: ['abc'] 
		kos-npe-cim: sig 
		nrog: pk 
), kab-tshiab.

# check message (fail)
Tawm sau-ntawv: ( 
	Lub-thawv-ruaj-ntseg 
		kuaj: ['abd'] 
		kos-npe-cim: sig 
		nrog: pk 
), kab-tshiab.