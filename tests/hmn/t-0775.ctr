Tawm sau-ntawv: ['Test object'], kab-tshiab.
>> l := Daim-teev tshiab ; 1 ; ( Daim-teev tshiab ; (Lub-sijhawm tshiab: 1) ; (Int64 los-ntawm-kab-ntawv: ['321']) ; (Daim-teev tshiab ; 3)).
Tawm sau-ntawv: l, kab-tshiab.
>> old-lst-address := l qauv-thawj chaw-nyob-nco.
l save-as: ['/tmp/a.bin'].
Tawm sau-ntawv: ['========== RELOADING SNAP:'], kab-tshiab.
>> b := Yam-khoom load-from: ['/tmp/a.bin'].
(b qauv-thawj chaw-nyob-nco = old-lst-address) tseeb: {
	Tawm sau-ntawv: ['Object link re-attached.'], kab-tshiab.
}.
Tawm sau-ntawv: b, kab-tshiab.
