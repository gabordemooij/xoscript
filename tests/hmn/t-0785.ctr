Tawm sau-ntawv: ['Test object'], kab-tshiab.
>> a := Yam-khoom tshiab. 

a thaum-tuaj: ['item:'] ua: { :moment
	nws-li moment := moment. 
}.

a thaum-tuaj: ['item'] ua: { <- nws-li moment.
}.

>> today := Daim-teev tshiab ; ( Lub-sijhawm tshiab cheeb-tsam-sijhawm: ['CEST'], xyoo: 2026, lub-hli: 7 ).
a item: today.
Tawm sau-ntawv: a item ? 0, kab-tshiab.
a save-as: ['/tmp/a.bin'].
