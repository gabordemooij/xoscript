Tawm sau-ntawv: ['Test object'], kab-tshiab.
>> p := Txoj-kev /tmp.
Tawm sau-ntawv: p, kab-tshiab.
>> old-p-address := p qauv-thawj chaw-nyob-nco.
p save-as: ['/tmp/a.bin'].
Tawm sau-ntawv: ['========== RELOADING SNAP:'], kab-tshiab.
>> b := Yam-khoom load-from: ['/tmp/a.bin'].
(b qauv-thawj chaw-nyob-nco = old-p-address) tseeb: {
	Tawm sau-ntawv: ['Object link re-attached.'], kab-tshiab.
}.
Tawm sau-ntawv: b, kab-tshiab.
