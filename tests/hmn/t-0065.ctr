Lej thaum-tuaj: ['factorial'] ua: {
	>> total := 1.
	{ :index total khoo-nrog: (tus-kheej - (index)). } × tus-kheej. <- total.
}.
>> Printer := Yam-khoom tshiab.
Printer thaum-tuaj: ['print:and:'] ua: { :x :y
	Tawm sau-ntawv: ['a='] + x + [', b='] + y, kab-tshiab.
}.
>> a := 4.5. >> b := a puag-ncig-nqes.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a puag-ncig-nce.
Printer print: a and: b.
a := 4.5. b := a puag-ncig-nqes.
Printer print: a and: b.
a := 4.5. b := a puag-ncig.
Printer print: a and: b.
a := 4.2. b := a puag-ncig.
Printer print: a and: b.

Tawm sau-ntawv: (9 seem: 5), kab-tshiab.
Tawm sau-ntawv: -666 tus-nqi-tiag, kab-tshiab.
Tawm sau-ntawv: 49 cag-plaub-fab, kab-tshiab.
Tawm sau-ntawv: (2 lej-zog: 3), kab-tshiab.
>> l := (Daim-teev ← 9 ; 6).
Tawm sau-ntawv: l yam-tsawg.

