#Linux
>> OS := Kev-pab-cuam-khoos-phis-tawj kev-teeb-tsa: ['OS'].

>> clock := Lub-sijhawm tshiab.
	
(OS = ['Haiku']) tseeb: {
	clock cheeb-tsam-sijhawm: ['CET'],
	xyoo: 2017, lub-hli: 7, hnub: 13,
	teev: 18, feeb: 0, vib-nas-this: 0.
}, lwm-yam: {
	clock cheeb-tsam-sijhawm: ['Europe/Amsterdam'],
	xyoo: 2017, lub-hli: 7, hnub: 13,
	teev: 18, feeb: 0, vib-nas-this: 0.
}.

clock thaum-tuaj: ['tell'] ua: {
	Tawm sau-ntawv: tus-kheej, kab-tshiab.
}.


clock ntxiv: 2    teev, tell.
clock ntxiv: 1    teev, tell.
clock ntxiv: 19 feeb, tell.
clock ntxiv: 1  feeb, tell.
clock ntxiv: 1  feeb, tell.
clock ntxiv: 19 vib-nas-this, tell.
clock ntxiv: 1  vib-nas-this, tell.
clock ntxiv: 1  vib-nas-this, tell.
clock ntxiv: 2    xyoo, tell.
clock ntxiv: 1    xyoo, tell.

(OS = ['Haiku']) tseeb: {
clock ntxiv: 5   lub-hli.
clock cheeb-tsam-sijhawm: ['CEST'], tell.
}, lwm-yam: {
	clock ntxiv: 5   lub-hli, tell.
}.

clock ntxiv: 1   lub-hli, tell.
clock ntxiv: 19    hnub, tell.
clock ntxiv: 1    teev, tell.
clock ntxiv: 120  yard, tell.
