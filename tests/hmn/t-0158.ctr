>> x := [' hallo '].

>> y := x tus-ntawv-loj.
Tawm sau-ntawv: x, kab-tshiab.
Tawm sau-ntawv: (x zoo-ib-yam: y), kab-tshiab.

>> y := x tus-ntawv-me.
Tawm sau-ntawv: x, kab-tshiab.
Tawm sau-ntawv: (x zoo-ib-yam: y), kab-tshiab.

>> y := x txiav-qhov-khoob.
Tawm sau-ntawv: x, kab-tshiab.
Tawm sau-ntawv: (x zoo-ib-yam: y), kab-tshiab.

>> y := x hla: 1.
Tawm sau-ntawv: x, kab-tshiab.
Tawm sau-ntawv: (x zoo-ib-yam: y), kab-tshiab.

>> y := x los-ntawm: 1 ntev: 2.
Tawm sau-ntawv: x, kab-tshiab.
Tawm sau-ntawv: (x zoo-ib-yam: y), kab-tshiab.