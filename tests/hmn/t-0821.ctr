# a quote that never closes must give an error, not an endless loop
>> txoj-kev-ntaub-ntawv := ['/tmp/test0821.csv'].
>> file := Ntaub-ntawv tshiab: txoj-kev-ntaub-ntawv.

file sau-ntawv: ['a,b\n"1,2\n'].
{
	file tus-cais: [','] cim-hais-lus: ['"'] cov-kab: { :line
		Tawm sau-ntawv: line, kab-tshiab.
	}.
} txhom: { :e Tawm sau-ntawv: e, kab-tshiab. }, pib.

# a closed quote still works
file sau-ntawv: ['a,b\n"1,2",3'].
file tus-cais: [','] cim-hais-lus: ['"'] cov-kab: { :line
	Tawm sau-ntawv: line, kab-tshiab.
}.
file rho-tawm.
