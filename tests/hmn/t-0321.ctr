# test qualifiers

Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.

>> Fruit := Yam-khoom tshiab.
Fruit thaum-tuaj: ['tshiab'] ua: {
	>> f := tus-kheej tshiab.
	f apples: 0. <- f.
}.
Fruit thaum-tuaj: ['apples:'] ua: { :a nws-li apples := a. }.
Fruit thaum-tuaj: ['apples'] ua: { <- nws-li apples. }.
Fruit thaum-tuaj: ['+'] ua: { :f
	>> n := Fruit tshiab.
	n apples: (f apples + nws-li apples). <- n.
}.
Lej thaum-tuaj: ['apples'] ua: { <- ((Fruit tshiab) apples: tus-kheej).
}.

Fruit thaum-tuaj: ['kab-ntawv'] ua: { <- nws-li apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Tawm sau-ntawv: q, kab-tshiab.




q := 3 apples + 4 apples.
Tawm sau-ntawv: q, kab-tshiab.



q := 3 apples + 4 apples.
Tawm sau-ntawv: q, kab-tshiab.


