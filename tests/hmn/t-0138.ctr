

Kev-pab-cuam-khoos-phis-tawj tswj-chaw-nco: 1.

>> x := 0.
>> y := ['Hello'].
>> q := { ['']. }.
>> p := Tseeb.
>> a := Daim-teev ← 1 ; 2 ; 3 ; 4.
>> c := Yam-khoom tshiab.
c thaum-tuaj: ['greet:'] ua: { Tawm sau-ntawv: ['greet!']. }.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.
>> usedMemory5 := 0.

Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.
>> usedMemory1 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 0).




