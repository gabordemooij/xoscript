>> randomizer := { :a :b
	>> yam-tsawg := ( a < b ) qhov-no: a lossis-qhov-ntawd: b.
	>> siab-tshaj-plaws := ( a > b ) qhov-no: a lossis-qhov-ntawd: b.
	>> x := Tsis-muaj-dabtsi.
	{
		x := Lej ntawm: a thiab: b.
		((x < yam-tsawg) lossis: (x > siab-tshaj-plaws)) tseeb: { 
			Tawm sau-ntawv: (['Invalid value!']).
			Kev-pab-cuam-khoos-phis-tawj ua-tiav.
		}.
	} 
	× 100. <- x.
}.
randomizer siv-rau: 0 thiab: 0.
randomizer siv-rau: 1 thiab: 0.
randomizer siv-rau: 1 thiab: 1.
randomizer siv-rau: 0 thiab: 1.
randomizer siv-rau: -1 thiab: 0.
randomizer siv-rau: -1 thiab: -1.
randomizer siv-rau: 0 thiab: -1.
randomizer siv-rau: 100 thiab: 200.
randomizer siv-rau: 999999999999998 thiab: 999999999999999.
randomizer siv-rau: 999999999999999 thiab: 999999999999998.
randomizer siv-rau: 999999999999999 thiab: 999999999999999.
randomizer siv-rau: -999999999999998 thiab: -999999999999999.
randomizer siv-rau: -999999999999999 thiab: -999999999999998.
randomizer siv-rau: -999999999999999 thiab: -999999999999999.
randomizer siv-rau: 999999999999998 thiab: -999999999999999.
