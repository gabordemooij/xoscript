Tawm sau-ntawv: ['Test object'], kab-tshiab.
>> a := Yam-khoom tshiab. 

a thaum-tuaj: ['item:'] ua: { :binhelper
	nws-li binhelper := binhelper. 
}.

a thaum-tuaj: ['item'] ua: { <- nws-li binhelper.
}.

a item: Bin tshiab.

>> old-binhelper-address := a item qauv-thawj chaw-nyob-nco.
a save-as: ['/tmp/a.bin'].
Tawm sau-ntawv: ['========== RELOADING SNAP:'], kab-tshiab.

>> b := Yam-khoom load-from: ['/tmp/a.bin'].

(b item qauv-thawj chaw-nyob-nco = old-binhelper-address) tseeb: {
	Tawm sau-ntawv: ['Object link re-attached.'], kab-tshiab.
}.


