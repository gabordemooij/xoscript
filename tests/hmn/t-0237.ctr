
Kab-ntawv thaum-tuaj: ['evaluate'] ua: {
	>> cim-khoos-phis-tawj := Ntaub-ntawv tshiab: ['/tmp/eval.ctr'].
	cim-khoos-phis-tawj sau-ntawv: (tus-kheej kab-ntawv + ['.']).
	Kev-pab-cuam-khoos-phis-tawj siv: ['/tmp/eval.ctr'].
}.

>> map :=
	(Phau-txhais-lus tshiab)
	muab: ['Hi There'] rau: ['two'],
	muab: (Daim-teev ← ['hello'] ; ['world'] ; (Daim-teev ← 1 ; 2; 9) ; Cuav) rau: ['one'],
	muab: ( (Phau-txhais-lus tshiab) muab: ['wrrld'] rau: ['misspelled'] ) rau: ['three'],
	muab: (Daim-teev ← ((Phau-txhais-lus tshiab) muab: ['treasure'] rau: ['hidden']) ; 2) rau: ['four']. 
>> str := map kab-ntawv.
>> map2 := Tsis-muaj-dabtsi.
(['map2 := '] + str ) evaluate.
Tawm sau-ntawv: map2 ? ['one'] ? 0.
Tawm sau-ntawv: map2 ? ['one'] ? 1.
Tawm sau-ntawv: map2 ? ['four'] ? 0 ? ['hidden'].
Tawm sau-ntawv: map2 ? ['one'] ? 2 ? 2.
