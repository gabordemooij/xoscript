# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Kev-pab-cuam-khoos-phis-tawj shell-escape: ['abc'].
Tawm sau-ntawv: c, kab-tshiab.
Tawm sau-ntawv: ( Kev-pab-cuam-khoos-phis-tawj txheej-txheem-tshuab: ['echo '] + c ), kab-tshiab.

c := Kev-pab-cuam-khoos-phis-tawj shell-escape: ['a'b'c'].
Tawm sau-ntawv: c, kab-tshiab.
Tawm sau-ntawv: ( Kev-pab-cuam-khoos-phis-tawj txheej-txheem-tshuab: ['echo '] + c ), kab-tshiab.

c := Kev-pab-cuam-khoos-phis-tawj shell-escape: ['a\'c'].
Tawm sau-ntawv: c, kab-tshiab.
Tawm sau-ntawv: ( Kev-pab-cuam-khoos-phis-tawj txheej-txheem-tshuab: ['echo '] + c ), kab-tshiab.