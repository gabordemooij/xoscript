
>> Size := Yam-khoom tshiab.
Size thaum-tuaj: ['is:'] ua: { :lej
	lej thaum-tuaj: ['+'] ua: { :lej
		>> unit := lej chav-ntsuas-lej.
		>> factor := 1.
		
		unit
		yog-li: ['inch'] ua: { factor := 0.0833. }. <- tus-kheej + (lej * factor).
	}. <- lej.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Tawm sau-ntawv: plank + edge, kab-tshiab.
