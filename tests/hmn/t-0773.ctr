Tawm sau-ntawv: ['Test object'], kab-tshiab.
>> a := Yam-khoom tshiab. 
a thaum-tuaj: ['item:'] ua: { :int64
	nws-li int64 := int64. 
}.
a thaum-tuaj: ['item'] ua: { <- nws-li int64.
}.
a item: ( Int64 los-ntawm-kab-ntawv: ['9999'] ).
Tawm sau-ntawv: a item, kab-tshiab.
>> old-int64-address := a item qauv-thawj chaw-nyob-nco.
a save-as: ['/tmp/a.bin'].
Tawm sau-ntawv: ['========== RELOADING SNAP:'], kab-tshiab.
>> b := Yam-khoom load-from: ['/tmp/a.bin'].
(b item qauv-thawj chaw-nyob-nco = old-int64-address) tseeb: {
	Tawm sau-ntawv: ['Object link re-attached.'], kab-tshiab.
}.
Tawm sau-ntawv: ( b item ), kab-tshiab.
