>> a := Yam-khoom tshiab. 
a thaum-tuaj: ['greet'] ua: { Tawm sau-ntawv: ['welcome!'], kab-tshiab. }.
a thaum-tuaj: ['greet2'] ua: { Tawm sau-ntawv: ['welcome2!'], kab-tshiab. }.
a save-as: ['/tmp/a.bin'].

Tawm sau-ntawv: ['========== RELOADING SNAP:'], kab-tshiab.
>> b := Yam-khoom load-from: ['/tmp/a.bin'].
b greet2.