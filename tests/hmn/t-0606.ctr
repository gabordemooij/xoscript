>> Point := Yam-khoom tshiab.
Point thaum-tuaj: ['x-coordinate:'] ua: { :x nws-li x := x. }.
Point thaum-tuaj: ['y-coordinate:'] ua: { :y nws-li y := y. }.
Point thaum-tuaj: ['x-coordinate']  ua: { <- nws-li x luam. }.
Point thaum-tuaj: ['y-coordinate']  ua: { <- nws-li y luam. }.

Point thaum-tuaj: ['='] ua: { :other <- ( nws-li x = other x-coordinate
		 thiab: nws-li y = other y-coordinate ).
}.

>> pier := Point tshiab x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point tshiab x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point tshiab x-coordinate: 5, y-coordinate: 6.

Tawm sau-ntawv: pier = town-hall, kab-tshiab.
Tawm sau-ntawv: pier = restaurant, kab-tshiab.
