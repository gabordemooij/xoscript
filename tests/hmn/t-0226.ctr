# Test ASCII variants

# Numbers

Tawm sau-ntawv: (2 !=: 3), kab-tshiab.
Tawm sau-ntawv: (2 <=: 2), kab-tshiab.
Tawm sau-ntawv: (2 >=: 2), kab-tshiab.

# Strings

Tawm sau-ntawv: (['b'] >=: ['a']), kab-tshiab.
Tawm sau-ntawv: (['b'] !=: ['a']), kab-tshiab.
Tawm sau-ntawv: (['b'] <=: ['c']), kab-tshiab.

# Bools

Tawm sau-ntawv: (Tseeb !=: Cuav), kab-tshiab.

# Objects

Tawm sau-ntawv: (Yam-khoom tshiab !=: Yam-khoom tshiab), kab-tshiab.

# ASCII list symbol <-:

Tawm sau-ntawv: (Daim-teev <<: 1, ; 2 ; 3) tus-lej-suav = 3, kab-tshiab.

