# a value ending in the first part of an opening quote must survive serialization
>> cov-nqi := Daim-teev tshiab
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

cov-nqi txhua: { :i :value
	>> d := Phau-txhais-lus tshiab.
	d muab: value rau: ['k'].
	d muab: ['second'] rau: ['j'].
	>> r := d cim-khoos-phis-tawj yam-khoom.
	Tawm sau-ntawv: r tus-lej-suav, kab-tshiab.
	Tawm sau-ntawv: ( (r ntawm: ['k']) = value ), kab-tshiab.
}.
