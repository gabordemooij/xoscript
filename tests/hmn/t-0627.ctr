

# create a 64-bit integer for exact calculations
>> a := Int64 los-ntawm-kab-ntawv: ['123'].

# to string
Tawm sau-ntawv: a, kab-tshiab.

# divide
Tawm sau-ntawv: a / (Int64 los-ntawm-kab-ntawv: ['3']), kab-tshiab.

# multiply
Tawm sau-ntawv: a * (Int64 los-ntawm-kab-ntawv: ['2']), kab-tshiab.

# add
Tawm sau-ntawv: a + (Int64 los-ntawm-kab-ntawv: ['1']), kab-tshiab.

# subtract
Tawm sau-ntawv: a - (Int64 los-ntawm-kab-ntawv: ['2']), kab-tshiab.

# compare
Tawm sau-ntawv: ( a =   (Int64 los-ntawm-kab-ntawv: ['123'])), kab-tshiab.
Tawm sau-ntawv: ( a !=: (Int64 los-ntawm-kab-ntawv: ['124'])), kab-tshiab.
Tawm sau-ntawv: ( a <   (Int64 los-ntawm-kab-ntawv: ['124'])), kab-tshiab.
Tawm sau-ntawv: ( a >   (Int64 los-ntawm-kab-ntawv: ['122'])), kab-tshiab.
Tawm sau-ntawv: ( a >=: (Int64 los-ntawm-kab-ntawv: ['123'])), kab-tshiab.
Tawm sau-ntawv: ( a <=: (Int64 los-ntawm-kab-ntawv: ['123'])), kab-tshiab.





	