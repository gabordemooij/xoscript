

Daim-teev thaum-tuaj: ['fixture:'] ua: { :f
	nws-li fixture := f.
}.

Daim-teev thaum-tuaj: ['tus-lej-suav'] ua: { <- nws-li fixture.
}.

Daim-teev thaum-tuaj: ['aantal'] ua: { <- nws-li fixture.
}.


>> x := Tsis-muaj-dabtsi.
{

	x := ['hello'] 
	hloov:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] tus-ntawv: 2)
			)
		)
	nrog: (
		(['...hal'] + ['lo']) 
			tus-ntawv-loj 
			lowecase 
			tus-ntawv-loj 
			hla: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Daim-teev ← 0 ; 1 ; 4; 9 ; (Daim-teev ← 0 ; 3; 1) ; 4
							) zaum-ob-kawg
						) ? 1
					) + 
					((Daim-teev ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					tus-lej-suav
				)
			)
	).

} × 10.
Tawm sau-ntawv: x, kab-tshiab.

