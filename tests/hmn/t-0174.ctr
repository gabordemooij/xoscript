


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Kev-pab-cuam-khoos-phis-tawj tswj-chaw-nco: 0.
>> palette := Tsis-muaj-dabtsi.
>> colors := Tsis-muaj-dabtsi.

{
palette := Phau-txhais-lus tshiab.
palette 
	muab: ['#F00'] rau: ['red'],
	muab: ['#0F0'] rau: ['green'],
	muab: ['#00F'] rau: ['blue'].
Tawm sau-ntawv: ['number of RGB codes in palette: '] + ( palette tus-lej-suav ), kab-tshiab.
Tawm sau-ntawv: ['RGB code of green is: '] + ( palette ? ['green'] ), kab-tshiab.
colors := [''].
( palette txhua: { :npe :cim-khoos-phis-tawj
		colors := colors + ( npe + [':'] + cim-khoos-phis-tawj ).
} ).
Tawm sau-ntawv: ['All colors in palette: '] + colors, kab-tshiab.
} pib.
Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.
usedMemory1 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 0).

{
palette := Phau-txhais-lus tshiab.
palette 
	muab: ['#F00'] rau: ['red'],
	muab: ['#0F0'] rau: ['green'],
	muab: ['#00F'] rau: ['blue'].
Tawm sau-ntawv: ['number of RGB codes in palette: '] + ( palette tus-lej-suav ), kab-tshiab.
Tawm sau-ntawv: ['RGB code of green is: '] + ( palette ? ['green'] ), kab-tshiab.
colors := [''].
( palette txhua: { :npe :cim-khoos-phis-tawj
		colors := colors + ( npe + [':'] + cim-khoos-phis-tawj ).
} ).
Tawm sau-ntawv: ['All colors in palette: '] + colors, kab-tshiab.
} pib.
Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.
usedMemory2 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 0).

{
palette := Phau-txhais-lus tshiab.
palette 
	muab: ['#F00'] rau: ['red'],
	muab: ['#0F0'] rau: ['green'],
	muab: ['#00F'] rau: ['blue'].
Tawm sau-ntawv: ['number of RGB codes in palette: '] + ( palette tus-lej-suav ), kab-tshiab.
Tawm sau-ntawv: ['RGB code of green is: '] + ( palette ? ['green'] ), kab-tshiab.
colors := [''].
( palette txhua: { :npe :cim-khoos-phis-tawj
		colors := colors + ( npe + [':'] + cim-khoos-phis-tawj ).
} ).
Tawm sau-ntawv: ['All colors in palette: '] + colors, kab-tshiab.
} pib.
Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.
usedMemory3 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 0).



( usedMemory1 = usedMemory2 thiab: usedMemory1 = usedMemory3, thiab: usedMemory2 = usedMemory3 ) tseeb: {
	Tawm sau-ntawv: ['No memory leaks here'].
}, cuav: {
	Tawm sau-ntawv: ['Leaking memory...'].
}.
