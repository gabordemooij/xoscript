
>> Rectangle := Yam-khoom tshiab.

Rectangle thaum-tuaj: ['area'] ua: { <- nws-li qhov-ntev * nws-li width.
}.

Rectangle thaum-tuaj: ['length:'] ua: { :qhov-ntev
	nws-li qhov-ntev := qhov-ntev.
}.

Rectangle thaum-tuaj: ['width:'] ua: { :width
	nws-li width := width.
}.

Rectangle thaum-tuaj: ['tshiab'] ua: {
	# this will not result into an infinite loop
	>> rectangle := tus-kheej tshiab.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle tshiab.
Tawm sau-ntawv: a area, kab-tshiab. #0

>> b := Rectangle tshiab length: 2, width: 3.
Tawm sau-ntawv: b area, kab-tshiab. #6

