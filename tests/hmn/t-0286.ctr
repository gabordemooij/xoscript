['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Tawm sau-ntawv: (x + y), kab-tshiab.

>> x := 10040.07.
>> y := 10305.60.

Tawm sau-ntawv: (x + y), kab-tshiab.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Tawm sau-ntawv: (x + y + z), kab-tshiab.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Tawm sau-ntawv: (x + y + z), kab-tshiab.

>> q := 0.1.2.

Tawm sau-ntawv: (q), kab-tshiab.

>> q := 012.

Tawm sau-ntawv: (q), kab-tshiab.
