# vault keys and signatures that decode too long must not overflow the stack
Server init.

>> keys := Lub-thawv-ruaj-ntseg tsim-yuam-sij.
>> sk := keys thawj-zaug.
>> pk := keys kawg.
>> sig := Lub-thawv-ruaj-ntseg kos-npe: ['abc'] nrog: sk.

# 88 characters without padding decode to 66 bytes
>> long := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 characters without padding decode to 33 bytes
>> short := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Lub-thawv-ruaj-ntseg kos-npe: ['abc'] nrog: long. } txhom: { :e
	Tawm sau-ntawv: e, kab-tshiab.
}, pib.

{ Lub-thawv-ruaj-ntseg kuaj: ['abc'] kos-npe-cim: long nrog: pk. } txhom: { :e
	Tawm sau-ntawv: e, kab-tshiab.
}, pib.

{ Lub-thawv-ruaj-ntseg kuaj: ['abc'] kos-npe-cim: sig nrog: short. } txhom: { :e
	Tawm sau-ntawv: e, kab-tshiab.
}, pib.
