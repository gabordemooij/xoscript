>> map1 := Phau-txhais-lus tshiab.
>> key1 := Daim-teev tshiab.
>> key2 := Daim-teev tshiab.

map1
	muab: ['hello'] rau: key1,
	muab: ['world'] rau: key2.


Tawm
	sau-ntawv: ['Map #1 contains: '] + (map1 ntawm: key1),
	sau-ntawv: [' and '] + (map1 ntawm: key2), kab-tshiab.

>> KeyeableArray := Daim-teev tshiab.
KeyeableArray thaum-tuaj: ['toString'] ua: { <- (tus-kheej tus-lej-suav) toString.
}.

>> map2 := Phau-txhais-lus tshiab.
key1 := KeyeableArray tshiab.
key2 := KeyeableArray tshiab.

key1 ntxiv-tom-kawg: 1.

map2
	muab: ['hello'] rau: key1,
	muab: ['world'] rau: key2.

Tawm
	sau-ntawv: ['Map #2 contains: '] + (map2 ntawm: key1),
	sau-ntawv: [' and '] + (map2 ntawm: key2), kab-tshiab.
