
Daim-teev thaum-tuaj: ['sum'] ua: {
	>> total := 0.
	tus-kheej txhua: { :index :element
		total ntxiv: element.
	}. <- total.
}.

>> a := Daim-teev ← 9 ; 8 ; 7.
Tawm sau-ntawv: (a sum), kab-tshiab. 
>> a := Daim-teev ← 1 ; 9.
Tawm sau-ntawv: (a sum), kab-tshiab. 
>> a := Daim-teev ← ['o'] ; 2.
Tawm sau-ntawv: (a sum), kab-tshiab. 
Tawm sau-ntawv: (Daim-teev tshiab sum), kab-tshiab. 
