Kab-ntawv thaum-tuaj: ['evaluate'] ua: {
	>> cim-khoos-phis-tawj := Ntaub-ntawv tshiab: ['/tmp/eval.ctr'].
	cim-khoos-phis-tawj sau-ntawv: (tus-kheej kab-ntawv + ['.']).
	Kev-pab-cuam-khoos-phis-tawj siv: ['/tmp/eval.ctr'].
}.

>> a := Daim-teev ← 1 ; 2 ; 3.
>> b := (a kab-ntawv).

Tawm sau-ntawv: b, kab-tshiab. 
(['b := '] + b) evaluate.

Tawm sau-ntawv: b ? 2, kab-tshiab. 

Tawm sau-ntawv: (( Daim-teev ← 1 ; 2 ; 3 )), kab-tshiab. 

Tawm sau-ntawv: ((Phau-txhais-lus tshiab) muab: 1 rau: 2), kab-tshiab. 

>> x := ( (Daim-teev ← 1 ; ( Daim-teev ← 9 ) ; Tseeb ) ) kab-ntawv.
Tawm sau-ntawv: x, kab-tshiab. 
(['x := '] + x) evaluate.

Tawm sau-ntawv: x ? 1 ? 0, kab-tshiab. 

>> y := (Phau-txhais-lus tshiab) muab: (Daim-teev ← 1) rau: (Daim-teev ← 2).
Tawm sau-ntawv: y, kab-tshiab. 

(['y := '] + y) kab-ntawv evaluate.

Tawm sau-ntawv: (y ntawm: (Daim-teev ← 2) kab-ntawv ), kab-tshiab.

Tawm sau-ntawv: (Daim-teev tshiab), kab-tshiab. 
Tawm sau-ntawv: (Phau-txhais-lus tshiab), kab-tshiab. 
