

Kab-ntawv thaum-tuaj: ['evaluate'] ua: {
	>> cim-khoos-phis-tawj := Ntaub-ntawv tshiab: ['/tmp/eval.ctr'].
	cim-khoos-phis-tawj sau-ntawv: (tus-kheej kab-ntawv + ['.']).
	Kev-pab-cuam-khoos-phis-tawj siv: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Daim-teev ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q kab-ntawv.
Tawm sau-ntawv: x, kab-tshiab.
>> y := Tsis-muaj-dabtsi.
(['y := '] + x ) evaluate.
Tawm sau-ntawv: y ? 0, kab-tshiab.

q := Phau-txhais-lus muab: ['\[''] rau: ['\['quote\']'].
x := q kab-ntawv.
Tawm sau-ntawv: x, kab-tshiab.
y := Tsis-muaj-dabtsi.
(['y := '] + x ) evaluate.

>> q := (Phau-txhais-lus tshiab) muab:['\[''] rau:['\['quote\[''].
Tawm sau-ntawv: y ? ['\['quote\']'], kab-tshiab.
