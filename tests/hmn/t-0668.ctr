# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob tshiab: 8, bytes: (
	Daim-teev tshiab ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Tawm sau-ntawv: ( utf16 daws-cim: ['utf16le'] ), kab-tshiab.

utf16 tso-tawm.
>> utf32 := Blob tshiab: 13, bytes: (
	Daim-teev tshiab ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Tawm sau-ntawv: ( utf32 daws-cim: ['utf32be'] ), kab-tshiab.
utf32 tso-tawm.