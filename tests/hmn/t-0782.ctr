Tawm sau-ntawv: ['Test object'], kab-tshiab.
>> cmd := Lus-txib tshiab.
Tawm sau-ntawv: cmd ls /tmp, kab-tshiab.
>> old-cmd-address := cmd qauv-thawj chaw-nyob-nco.
cmd save-as: ['/tmp/a.bin'].
Tawm sau-ntawv: ['========== RELOADING SNAP:'], kab-tshiab.
>> b := Yam-khoom load-from: ['/tmp/a.bin'].
(b qauv-thawj chaw-nyob-nco = old-cmd-address) tseeb: {
	Tawm sau-ntawv: ['Object link re-attached.'], kab-tshiab.
}.
Tawm sau-ntawv: b ls, kab-tshiab.


