Tawm sau-ntawv: ['Test object'], kab-tshiab.
>> a := Yam-khoom tshiab. 
a thaum-tuaj: ['item:'] ua: { :lst
	nws-li lst := lst. 
}.
a thaum-tuaj: ['item'] ua: { <- nws-li lst.
}.
a item: (
	Daim-teev tshiab ; 1 ; (
		Daim-teev tshiab ; ['a'] ; (
			Daim-teev tshiab ; ( Lub-sijhawm tshiab: 1 )
		) ; ( Int64 los-ntawm-kab-ntawv: ['321'] )
	)
).
Tawm sau-ntawv: a item, kab-tshiab.
>> old-lst-address := a item qauv-thawj chaw-nyob-nco.
a save-as: ['/tmp/a.bin'].
Tawm sau-ntawv: ['========== RELOADING SNAP:'], kab-tshiab.
>> b := Yam-khoom load-from: ['/tmp/a.bin'].
(b item qauv-thawj chaw-nyob-nco = old-lst-address) tseeb: {
	Tawm sau-ntawv: ['Object link re-attached.'], kab-tshiab.
}.
Tawm sau-ntawv: ( b item ), kab-tshiab.
