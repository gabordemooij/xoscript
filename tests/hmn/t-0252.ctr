#Linux
>> clock := Lub-sijhawm tshiab.
clock cheeb-tsam-sijhawm: ['UTC-1'].
clock xyoo: 1981, lub-hli: 1, hnub: 5,
      teev: 13, feeb: 15, vib-nas-this: 13.

Tawm sau-ntawv: clock, kab-tshiab.
clock cheeb-tsam-sijhawm: ['UTC+0'].

Tawm sau-ntawv: (
	(clock xyoo yooj-yim) + ['-'] + (clock lub-hli) + ['-'] + (clock hnub) + [' '] +
	(clock teev) + [':'] + (clock feeb) + [':'] + (clock vib-nas-this) + [' '] +
	['W'] + (clock lub-lim-tiam) + (clock cheeb-tsam-sijhawm)
), kab-tshiab.


clock cheeb-tsam-sijhawm: ['UTC-1'].
Tawm sau-ntawv: (
	(clock xyoo yooj-yim) + ['-'] + (clock lub-hli) + ['-'] + (clock hnub) + [' '] +
	(clock teev) + [':'] + (clock feeb) + [':'] + (clock vib-nas-this) + [' '] +
	['W'] + (clock lub-lim-tiam) + (clock cheeb-tsam-sijhawm)
), kab-tshiab.
