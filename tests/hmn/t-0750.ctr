Tawm sau-ntawv: ['Test object'], kab-tshiab.
>> a := Yam-khoom tshiab. 

a thaum-tuaj: ['item:'] ua: { :nil
	nws-li nil := nil. 
}.

a thaum-tuaj: ['item'] ua: { <- nws-li nil.
}.

a item: Tsis-muaj-dabtsi.

Tawm sau-ntawv: a item, kab-tshiab.

>> old-nil-address := a item qauv-thawj chaw-nyob-nco.
a save-as: ['/tmp/a.bin'].
Tawm sau-ntawv: ['========== RELOADING SNAP:'], kab-tshiab.

>> b := Yam-khoom load-from: ['/tmp/a.bin'].

(b item qauv-thawj chaw-nyob-nco = old-nil-address) tseeb: {
	Tawm sau-ntawv: ['Object link re-attached.'], kab-tshiab.
}.

Tawm sau-ntawv: b item, kab-tshiab.
