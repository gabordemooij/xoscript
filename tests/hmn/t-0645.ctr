Server init.
Tawm sau-ntawv: ['Database date test'], kab-tshiab.

>> db := Maria-DB tshiab tus-tswv-tsev: ['localhost'],
	npe-neeg-siv: ['xo'], 
	lo-lus-zais: ['pass123'],
	npe-chaw-khaws-ntaub-ntawv: ['xobase'],
	txuas-mus.

>> cov-nqe-nrhiav :=
db lus-nug: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
mus-nqa: { :row
	Tawm sau-ntawv: row datetest, kab-tshiab.
}.
