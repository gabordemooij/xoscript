>> str := ['write:'].
Tawm lus: ['sau-ntawv:'] cov-nkag: (Daim-teev ← ['Hello World']), kab-tshiab. 

Lej thaum-tuaj: ['isbetween:and:'] ua: { :a :b <- ((tus-kheej ≥ a) thiab: (tus-kheej ≤ b)).
}.

str := ['isbetween:and:'].
Tawm sau-ntawv: (3 lus: str cov-nkag: (Daim-teev ← 2 ; 8)), kab-tshiab.
Tawm sau-ntawv: (3 lus: str cov-nkag: (Daim-teev ← 1 ; 2)), kab-tshiab.


>> CoffeeMachine := Yam-khoom tshiab.
CoffeeMachine thaum-tuaj: ['makeCoffeeWithSugar:milk:'] ua: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Daim-teev ← 4 ; 2.
Tawm sau-ntawv: ( CoffeeMachine lus: order cov-nkag: coffeeConfiguration ), kab-tshiab.
