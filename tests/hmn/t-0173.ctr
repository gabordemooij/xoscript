

Daim-teev thaum-tuaj: ['sum'] ua: {
	>> total := 0.
	tus-kheej txhua: { :index :element
		total ntxiv: element.
	}. <- total.
}.

Daim-teev thaum-tuaj: ['product'] ua: {
	>> total := 1.
	tus-kheej txhua: { :index :element
		total khoo-nrog: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Kev-pab-cuam-khoos-phis-tawj tswj-chaw-nco: 0.

{

>> a := Daim-teev ← ['hello'] ; ['world'] ; Tseeb ; Tsis-muaj-dabtsi ; 666.
a := a + ( Daim-teev ← 1 ).
Tawm sau-ntawv: ( ['sum: '] + ( a sum ) ), kab-tshiab.
Tawm sau-ntawv: ( ['min: '] + ( a yam-tsawg ) ), kab-tshiab.
Tawm sau-ntawv: ( ['max: '] + ( a siab-tshaj-plaws ) ), kab-tshiab.
Tawm sau-ntawv: ( ['3rd: '] + ( a ? 2 ) ), kab-tshiab.
Tawm sau-ntawv: ( ['prd: '] + ( a product ) ), kab-tshiab.
a txheeb: { :a :b <- (b - a). }.
a txhua: { :i :e Tawm sau-ntawv: ( i - 0 ), kab-tshiab. }.

} pib.

Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.
usedMemory1 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 0).


{

>> a := Daim-teev ← ['hello'] ; ['world'] ; Tseeb ; Tsis-muaj-dabtsi ; 666.
a := a + ( Daim-teev ← 1 ).
Tawm sau-ntawv: ( ['sum: '] + ( a sum ) ), kab-tshiab.
Tawm sau-ntawv: ( ['min: '] + ( a yam-tsawg ) ), kab-tshiab.
Tawm sau-ntawv: ( ['max: '] + ( a siab-tshaj-plaws ) ), kab-tshiab.
Tawm sau-ntawv: ( ['3rd: '] + ( a ? 2 ) ), kab-tshiab.
Tawm sau-ntawv: ( ['prd: '] + ( a product ) ), kab-tshiab.
a txheeb: { :a :b <- (b - a). }.
a txhua: { :i :e Tawm sau-ntawv: ( i - 0 ), kab-tshiab. }.

} pib.



Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.
usedMemory2 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 0).


{

>> a := Daim-teev ← ['hello'] ; ['world'] ; Tseeb ; Tsis-muaj-dabtsi ; 666.
a := a + ( Daim-teev ← 1 ).
Tawm sau-ntawv: ( ['sum: '] + ( a sum ) ), kab-tshiab.
Tawm sau-ntawv: ( ['min: '] + ( a yam-tsawg ) ), kab-tshiab.
Tawm sau-ntawv: ( ['max: '] + ( a siab-tshaj-plaws ) ), kab-tshiab.
Tawm sau-ntawv: ( ['3rd: '] + ( a ? 2 ) ), kab-tshiab.
Tawm sau-ntawv: ( ['prd: '] + ( a product ) ), kab-tshiab.
a txheeb: { :a :b <- (b - a). }.
a txhua: { :i :e Tawm sau-ntawv: ( i - 0 ), kab-tshiab. }.

} pib.



Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.
usedMemory3 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 0).

( usedMemory1 = usedMemory2 thiab: usedMemory1 = usedMemory3, thiab: usedMemory2 = usedMemory3 ) tseeb: {
	Tawm sau-ntawv: ['No memory leaks here'].
}, cuav: {
	Tawm sau-ntawv: ['Leaking memory...'].
}.
