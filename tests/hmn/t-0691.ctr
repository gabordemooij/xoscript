Server init.

# returning non-str from match/do should be ok
>> subject := ['abc'].
>> pattern := Qauv-nrhiav tshiab: ['([ac])'].
>> result := pattern sib-phim: subject ua: { :m :x
	Tawm sau-ntawv: m, kab-tshiab.
	Tawm sau-ntawv: x, kab-tshiab. <- Tsis-muaj-dabtsi.
}.
Tawm sau-ntawv: result, kab-tshiab.