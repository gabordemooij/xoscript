

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Kev-pab-cuam-khoos-phis-tawj tswj-chaw-nco: 0.

Lej thaum-tuaj: ['addNum:'] ua: { :x
	tus-kheej ntxiv: x.
}.

Lej thaum-tuaj: ['subtractNum:'] ua: { :x
	tus-kheej rho: x.
}.

Lej thaum-tuaj: ['multiplyBy:'] ua: { :x
	tus-kheej khoo-nrog: x.
}.

Lej thaum-tuaj: ['divideBy:'] ua: { :x
	tus-kheej faib-nrog: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 lej-zog: 8).  
a := a + (2 lej-zog: -1). 
a := a + (49 cag-plaub-fab).   
a addNum: ((Daim-teev ← 0 ; 1) siab-tshaj-plaws).          
a addNum: ((Daim-teev ← 2 ; 3) yam-tsawg).
Tawm sau-ntawv: a.

Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.

usedMemory1 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 lej-zog: 8).  
a := a + (2 lej-zog: -1). 
a := a + (49 cag-plaub-fab).   
a addNum: ((Daim-teev ← 0 ; 1) siab-tshaj-plaws).          
a addNum: ((Daim-teev ← 2 ; 3) yam-tsawg).
Tawm sau-ntawv: a.

Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.
usedMemory2 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 lej-zog: 8).  
a := a + (2 lej-zog: -1). 
a := a + (49 cag-plaub-fab).   
a addNum: ((Daim-teev ← 0 ; 1) siab-tshaj-plaws).          
a addNum: ((Daim-teev ← 2 ; 3) yam-tsawg).
Tawm sau-ntawv: a.

Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.
usedMemory3 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 0).



( usedMemory1 = usedMemory2 thiab: usedMemory1 = usedMemory3, thiab: usedMemory2 = usedMemory3 ) tseeb: {
	Tawm sau-ntawv: ['No memory leaks here'].
}, cuav: {
	Tawm sau-ntawv: ['Leaking memory...'].
}.
