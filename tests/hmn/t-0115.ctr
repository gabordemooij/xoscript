{
	txoj-haujlwm-no yuam-kev: ['Dont fail.'].
	unknown doSomething.
} txhom: {
	Tawm sau-ntawv: ['Caught!'].
}, pib.

{
	txoj-haujlwm-no yuam-kev: ['Dont fail.'].
	nws-li unknown doSomething.
} txhom: {
	Tawm sau-ntawv: ['Caught!'].
}, pib.

{
	txoj-haujlwm-no yuam-kev: ['Dont fail.'].
	unknown := 122.
} txhom: {
	Tawm sau-ntawv: ['Caught!'].
}, pib.


{
	txoj-haujlwm-no yuam-kev: ['Dont fail.'].
	Tseeb tso-tseg.
	Tawm sau-ntawv: ['FAIL'].
} txhom: {
	Tawm sau-ntawv: ['Caught!'].
}, pib.

{
	{
		txoj-haujlwm-no yuam-kev: ['Dont fail.'].
		Tseeb tso-tseg.
		Tawm sau-ntawv: ['FAIL'].
	} txhom: { :x
		(x = ['Dont fail.']) tseeb: { txoj-haujlwm-no yuam-kev: ['Nested Caught!']. }.
	}, pib.
} txhom: { :e
	Tawm sau-ntawv: e.
}, pib.
