# compliance test

# use international numbers

Tawm sau-ntawv: ['1000 -> '].
Tawm sau-ntawv: 1000, kab-tshiab. #1000

Tawm sau-ntawv: ['1.5 -> '].
Tawm sau-ntawv: 1.5, kab-tshiab.  #1.5

Tawm sau-ntawv: ['1001.5 -> '].
Tawm sau-ntawv: 1.5 + 1000, kab-tshiab. #1001.5

# use 0-indexed arrays
>> x := Daim-teev tshiab ; 1 ; 2 ; 3.
>> y := Daim-teev tshiab ; ['a'] ; ['b'] ; ['c'].

Tawm sau-ntawv: ['1 -> '].
Tawm sau-ntawv: x ? 0, kab-tshiab. #1

Tawm sau-ntawv: ['1 -> '].
Tawm sau-ntawv: (x ntawm: 0), kab-tshiab. #1

Tawm sau-ntawv: ['1 -> '].
Tawm sau-ntawv: x thawj-zaug, kab-tshiab. #1

Tawm sau-ntawv: ['3 -> '].
Tawm sau-ntawv: x kawg, kab-tshiab. #3

Tawm sau-ntawv: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Tawm sau-ntawv: (x raws-li: y), kab-tshiab.

Tawm sau-ntawv: ['1 -> '].
Tawm sau-ntawv: (x los-ntawm: 0 ntev: 1) thawj-zaug, kab-tshiab. #1

Tawm sau-ntawv: ['0 -> '].
Tawm sau-ntawv: (x nrhiav: 1), kab-tshiab. #0

x muab: 9 rau: 0.

Tawm sau-ntawv: ['9 -> '].
Tawm sau-ntawv: (x ntawm: 0), kab-tshiab. #9

x ntxiv-tom-ntej: 8.
Tawm sau-ntawv: ['8 -> '].
Tawm sau-ntawv: (x ntawm: 0), kab-tshiab. #9


x ntxiv-tom-kawg: 10.
Tawm sau-ntawv: ['10 -> '].
Tawm sau-ntawv: (x ntawm: 4), kab-tshiab. #10








