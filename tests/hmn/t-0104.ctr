
{ :i
	Tawm sau-ntawv: ['This is step #'] + ( ( i ) + 1 ), kab-tshiab.
} × 6.

{ :i
	Tawm sau-ntawv: ['This is step #'] + ( 3 - ( i ) ), kab-tshiab.
} × 6.

{ :i
	Tawm sau-ntawv: ['NEVER!'], kab-tshiab.
} × 0.



{ :i
	Tawm sau-ntawv: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), kab-tshiab.
} × 11.
