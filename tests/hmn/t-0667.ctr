# test Program version

# this feature is disabled by default
Tawm sau-ntawv: (
	Kev-pab-cuam-khoos-phis-tawj yam-ntxwv: 
	['RECURSIVE_STRINTPOL']
), kab-tshiab.


# but if we set the time back
>> today := Lub-sijhawm 
cheeb-tsam-sijhawm: ['CEST'],
qhov-pib: ['2026-02-15 10:00:00'].
Kev-pab-cuam-khoos-phis-tawj tsab-tso-tawm: today.

# it will be enabled like it used to be (from now on)
Tawm sau-ntawv: (
	Kev-pab-cuam-khoos-phis-tawj yam-ntxwv: 
	['RECURSIVE_STRINTPOL']
), kab-tshiab.