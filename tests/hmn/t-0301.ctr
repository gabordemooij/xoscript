


>> wine := Yam-khoom tshiab.


wine thaum-tuaj: ['toString'] ua: { <- ['merlot'].
}.

wine thaum-tuaj: ['naarTekst'] ua: { <- ['merlot'].
}.


wine thaum-tuaj: ['='] ua: { :other wine <- ( tus-kheej toString = other wine ).
}.

wine thaum-tuaj: ['=='] ua: { :other wine <- ( tus-kheej toString = other wine ).
}.



wine
	yog-li: ['cabernet'] ua: { Tawm sau-ntawv: ['it's a Cabernet!']. },
	yog-li: ['syrah']    ua: { Tawm sau-ntawv: ['it's a Syrah!'].    },
	yog-li: ['merlot']   ua: { Tawm sau-ntawv: ['it's a Merlot!'].   },
	yog-li: ['malbec']   ua: { Tawm sau-ntawv: ['it's a Malbec!'].   }.

Tawm kab-tshiab.
