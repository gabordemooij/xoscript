# edge cases from a request must give an error or a result, not a crash
Server init.

Tawm sau-ntawv: ['<'] + (['abc'] los-ntawm: 0 ntev: 0, tus-ntawv-loj) + ['>'], kab-tshiab.
Tawm sau-ntawv: ['<'] + (['abc'] los-ntawm: 0 ntev: 0, tus-ntawv-me) + ['>'], kab-tshiab.
Tawm sau-ntawv: ['<'] + (['abc'] hla: 3, tus-ntawv-loj) + ['>'], kab-tshiab.
Tawm sau-ntawv: [''] tus-ntawv-loj bytes, kab-tshiab.
Tawm sau-ntawv: ['aB'] tus-ntawv-loj, kab-tshiab.
Tawm sau-ntawv: ['aB'] tus-ntawv-me, kab-tshiab.

Tawm sau-ntawv: (Lub-sijhawm tshiab: 0) xyoo, kab-tshiab.
{ Lub-sijhawm tshiab: ['9e300'] lej. } txhom: { :e Tawm sau-ntawv: e, kab-tshiab. }, pib.
{ Lub-sijhawm tshiab: ['-9e300'] lej. } txhom: { :e Tawm sau-ntawv: e, kab-tshiab. }, pib.
{ Lub-sijhawm tshiab: ['nan'] lej. } txhom: { :e Tawm sau-ntawv: e, kab-tshiab. }, pib.
{ Lub-sijhawm tshiab: 9000000000000000000. } txhom: { :e Tawm sau-ntawv: e, kab-tshiab. }, pib.
