>> cov-nqe-nrhiav := db lus-nug: ['SELECT %% FROM'].
{ cov-nqe-nrhiav ua-raws-lus-txib. } txhom: { :e
	Tawm sau-ntawv: ( e muaj: ['%%'] ), kab-tshiab.
}, pib.
