
>> city := Daim-teev ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Daim-teev ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature raws-li: city.
>> cities := weather cov-yuam-sij txheeb: { :a :b <- (a piv: b). }.
>> temperatures := weather cov-nqi txheeb: { :a :b <- (a piv: b) qis-dua-xoom?. }.

Tawm sau-ntawv: (cities muab-sib-txuas: [',']), kab-tshiab.
Tawm sau-ntawv: (temperatures muab-sib-txuas: [',']), kab-tshiab.
