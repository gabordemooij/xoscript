# from:length: counts characters and survives very large numbers
>> s := ['ééééééééééééééé'].
Tawm sau-ntawv: (s luam los-ntawm: 0 ntev: 20), kab-tshiab.
Tawm sau-ntawv: (s luam los-ntawm: 10 ntev: 20), kab-tshiab.
Tawm sau-ntawv: (s luam los-ntawm: 14 ntev: 1), kab-tshiab.
Tawm sau-ntawv: (s luam hla: 20), kab-tshiab.
Tawm sau-ntawv: ['-'], kab-tshiab.
Tawm sau-ntawv: (['abcdef'] los-ntawm: 2 ntev: 2), kab-tshiab.
Tawm sau-ntawv: (['abc'] los-ntawm: 1 ntev: ['9e300'] lej), kab-tshiab.
Tawm sau-ntawv: (['abc'] los-ntawm: 1 ntev: ['-9e300'] lej), kab-tshiab.
Tawm sau-ntawv: (['abc'] los-ntawm: ['9e300'] lej ntev: 1), kab-tshiab.
Tawm sau-ntawv: ['-'], kab-tshiab.
Tawm sau-ntawv: (['abc'] los-ntawm: ['-9e300'] lej ntev: 2), kab-tshiab.
Tawm sau-ntawv: (['abc'] los-ntawm: ['nan'] lej ntev: 2), kab-tshiab.
Tawm sau-ntawv: (['abc'] los-ntawm: 0 ntev: ['nan'] lej), kab-tshiab.
Tawm sau-ntawv: ['-'], kab-tshiab.
