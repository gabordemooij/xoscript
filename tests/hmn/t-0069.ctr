

Kab-ntawv thaum-tuaj: ['html'] ua: { <- (
		tus-kheej
		hloov: ['&'] nrog: ['&amp;'],
		hloov: ['<'] nrog: ['&lt;'],
		hloov: ['>'] nrog: ['&gt;'],
		hloov: ['"'] nrog: ['&quot;']
	).
}.


Tawm sau-ntawv: ([' left trimmed '] txiav-qhov-khoob) + [' '] + ( ['and right trimmed'] txiav-qhov-khoob) + ['!'], kab-tshiab.
Tawm sau-ntawv: ['<html>"html & entities"</html>'] html.
