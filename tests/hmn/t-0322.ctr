

>> Matryoshka := Yam-khoom tshiab.
Matryoshka thaum-tuaj: ['double:'] ua: { :secret
	nws-li secret := secret × 2.
}.
Matryoshka thaum-tuaj: ['tshiab:'] ua: { :secret
	>> answer := Tsis-muaj-dabtsi.
	>> t := (secret > 255).
	Tawm sau-ntawv: (secret + [' | '] + t), kab-tshiab.
	t tseeb: {
		answer := secret.
	}, lwm-yam: {
		answer := Matryoshka hu-nws-tus-kheej tshiab: (tus-kheej double: secret).
	}. <- answer.
}.

>> x := Matryoshka tshiab: 2.
