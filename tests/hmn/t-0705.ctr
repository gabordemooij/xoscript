

>> obj := Yam-khoom tshiab.

obj thaum-tuaj: ['greet'] ua: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj thaum-tuaj: ['task'] ua: {
	nws-li property := 123.
	{
		# try binds self/own to object instead of block
		Tawm sau-ntawv: tus-kheej greet.
		Tawm sau-ntawv: nws-li property.
		1 / 0.
	} txhom: {
		Tawm sau-ntawv: tus-kheej greet.
		Tawm sau-ntawv: nws-li property.
		Tawm sau-ntawv: ['ok'].
	}, sim.
}.

obj task.