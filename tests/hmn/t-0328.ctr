Kev-pab-cuam-khoos-phis-tawj tswj-chaw-nco: 4.

>> Doubler := Yam-khoom tshiab.
>> Multiplier := Yam-khoom tshiab.
Doubler thaum-tuaj: ['double:and:'] ua: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier thaum-tuaj: ['multiply:and:'] ua: { :x :y <- (x × y).
}.

Tawm sau-ntawv: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), kab-tshiab.
