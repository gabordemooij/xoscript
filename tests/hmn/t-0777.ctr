#OBSD
>> dirname := [''].
{ dirname ntxiv-tom-kawg: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Kev-pab-cuam-khoos-phis-tawj txheej-txheem-tshuab: command.
Kev-pab-cuam-khoos-phis-tawj chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename ntxiv-tom-kawg: ['YYYYYYYY']. } * 20.
Ntaub-ntawv tshiab: filename, sau-ntawv: ['sometext'].
{ Ntaub-ntawv daim-teev: ['/tmp/'] + dirname. } * 1000.
Tawm sau-ntawv: ['no crash'], kab-tshiab.

