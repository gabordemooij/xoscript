>> makeAdder := { :x
	>> f := { :y <- (nws-li x + y). } teem: ['x'] tus-nqi: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i nws-li q muab: (nws-li f siv-rau: (nws-li q ? i)) rau: i. } 
	teem: ['q'] tus-nqi: array,
	teem: ['f'] tus-nqi: func.
	{ :i mapping siv-rau: i. } × (array tus-lej-suav).
}.

>> a := Daim-teev ← 1; 2; 3.
mapper siv-rau: a thiab: (makeAdder siv-rau: 100).
Tawm sau-ntawv: (a qhov-chaw: 0), kab-tshiab.
Tawm sau-ntawv: (a ? 1), kab-tshiab.
Tawm sau-ntawv: (a ? 2), kab-tshiab.
