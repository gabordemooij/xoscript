Tawm sau-ntawv: ['Continue for-loop, No - before 6 and up.'], kab-tshiab.
{ :i
	Tawm sau-ntawv: (i + 1), kab-tshiab.
	((i + 1) > 4) mus-txuas-ntxiv.
	Tawm sau-ntawv: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Tawm kab-tshiab.
Tawm sau-ntawv: ['Continue while-true, No --> before 5 and up.'], kab-tshiab.
{
	Tawm sau-ntawv: ['iteration #'] + x, kab-tshiab.
	x ntxiv: 1.
	((x < 5) rov-qab) mus-txuas-ntxiv.
	Tawm sau-ntawv: ['-->'].
} thaum-lub-sij-hawm: xIsLessThan10.
Tawm kab-tshiab.
Tawm sau-ntawv: ['Continue while-false, No - before 3 only.'], kab-tshiab.
{
	Tawm sau-ntawv: ['iteration #'] + x, kab-tshiab.
	x rho: 1.
	(x = 3) mus-txuas-ntxiv.
	Tawm sau-ntawv: ['-'].
} thaum-lub-sij-hawm: { <- ( x > 0). }.

Tawm kab-tshiab.
Tawm sau-ntawv: ['Continue times-loop, No ||| before 3.'], kab-tshiab.
{ :i
	Tawm sau-ntawv: ['iteration #'] + i, kab-tshiab.
	(i = 2) mus-txuas-ntxiv.
	Tawm sau-ntawv: ['|||'].
} × 5.

Tawm kab-tshiab.

{ Tseeb mus-txuas-ntxiv. Tawm sau-ntawv: ['dont write this!'], kab-tshiab. } pib.

{ Tseeb mus-txuas-ntxiv. Tawm sau-ntawv: ['dont write this!'], kab-tshiab. } txhom: { Tawm sau-ntawv: ['Dont catch this!']. }, pib.

Tawm sau-ntawv: ['Test Array each-loop: 0, ... ,2'], kab-tshiab.
(Daim-teev ← 1 ; 2 ; 3) hloov-txhua-yam: { :i
	(i = 1) mus-txuas-ntxiv.
	Tawm sau-ntawv: ['iteration #'] + (i - 0), kab-tshiab.
}.

Tawm sau-ntawv: ['Test Map each-loop: c only'], kab-tshiab.
>> m := Phau-txhais-lus tshiab.
m muab: ['first'] rau: ['a'], muab: ['second'] rau: ['b'], muab: ['third'] rau: ['c'].
m txhua: { :k :v
	(k ≠ ['c']) mus-txuas-ntxiv.
	Tawm sau-ntawv: ['iteration'] + k + v, kab-tshiab.
}.

