60 × {
	>> x := (Lej random % 6) + 1.
	(x ≤ 6) cuav: { Tawm sau-ntawv: ['FAIL']. }.
	(x ≥0) cuav: { Tawm sau-ntawv: ['FAIL']. }.
	x := (Lej random % 3) + 1.
	(x < 3) cuav: { Tawm sau-ntawv: ['FAIL']. }.
	(x>-1) cuav: { Tawm sau-ntawv: ['FAIL']. }.
	x := ((Tseeb-los-cuav flip) lej).
	(x = 0 lossis: x = 1) cuav: { Tawm sau-ntawv: ['FAIL']. }.
	x := ((Tseeb flip) lej).
	(x = 0 lossis: x = 1) cuav: { Tawm sau-ntawv: ['FAIL']. }.
	x := (Tseeb-los-cuav flip qhov-no: ['HEAD'] lossis-qhov-ntawd: ['TAIL']).
	((x = ['HEAD']) lossis: (x = ['TAIL'])) cuav: { Tawm sau-ntawv: ['FAIL']. }.
}.
Tawm sau-ntawv: ['DONE'].

