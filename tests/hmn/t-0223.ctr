>> x := Lub-sijhawm tshiab.
x cheeb-tsam-sijhawm: ['CEST'],
xyoo:2017,
lub-hli:01,
hnub:10,
teev: 10,
feeb: 0,
vib-nas-this: 0.

Tawm sau-ntawv: x, kab-tshiab.

Tawm sau-ntawv: x sijhawm, kab-tshiab.

x ntxiv: 1 vib-nas-this.
x ntxiv: 2 feeb.
x ntxiv: 3 teev.
x ntxiv: 4 hnub.
x ntxiv: 1 lub-hli.
x ntxiv: 6 xyoo.

Tawm sau-ntawv: x, kab-tshiab.

x rho: 1 vib-nas-this.
x rho: 2 feeb.
x rho: 3 teev.
x rho: 4 hnub.
x rho: 1 lub-hli.
x rho: 6 xyoo.

Tawm sau-ntawv: x, kab-tshiab.

>> y := x luam.
>> z := x.

Tawm sau-ntawv: y, kab-tshiab.
Tawm sau-ntawv: z, kab-tshiab.
Tawm sau-ntawv: (x cheeb-tsam-sijhawm = y cheeb-tsam-sijhawm), kab-tshiab.
Tawm sau-ntawv: (x sijhawm = y sijhawm), kab-tshiab.
Tawm sau-ntawv: (x = z), kab-tshiab.
Tawm sau-ntawv: x hnub-ntawm-lub-xyoo, kab-tshiab.
Tawm sau-ntawv: x hnub-hauv-lim-tiam, kab-tshiab.
Tawm sau-ntawv: x lub-lim-tiam, kab-tshiab.
