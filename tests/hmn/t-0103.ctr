>> a := Daim-teev ← Yam-khoom ; Tseeb ; Cuav ; Tseeb-los-cuav ; 1 ; Lej ; ['Str'] ; Kab-ntawv ; { ['Empty']. }.
Tawm sau-ntawv: (a tus-lej-suav), kab-tshiab.
{ :i
	Tawm sau-ntawv: 
	['a '] + 
	((a ? i) hom) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Tsis-muaj-dabtsi?) qhov-no: [''] lossis-qhov-ntawd: ['NOT']) + 
	[' Nil.'],
	kab-tshiab.
} × (a tus-lej-suav).
Tawm sau-ntawv: ['but.. Nil is.. '] + ((Tsis-muaj-dabtsi Tsis-muaj-dabtsi?) qhov-no: ['certainly NIL!'] lossis-qhov-ntawd: ['not NIL??']), kab-tshiab.