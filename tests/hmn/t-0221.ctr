>> x := Yam-khoom tshiab.
>> y := Yam-khoom tshiab.
>> z := x.
Tawm sau-ntawv: (x = z), kab-tshiab.
Tawm sau-ntawv: (x = y), kab-tshiab.
Tawm sau-ntawv: (x ≠ y), kab-tshiab.
Tawm sau-ntawv: (x ≠ z), kab-tshiab.
>> m := Lub-sijhawm tshiab xyoo: 2070, lub-hli: 11.
>> n := m luam.
Tawm sau-ntawv: (m = n), kab-tshiab.
Tawm sau-ntawv: (m ≠ n), kab-tshiab.
Tawm sau-ntawv: (m zoo-ib-yam: m), kab-tshiab.
Tawm sau-ntawv: (m zoo-ib-yam: n), kab-tshiab.
n lub-hli: 12.
Tawm sau-ntawv: (m ≠ n), kab-tshiab.
Tawm sau-ntawv: (m = n), kab-tshiab.


