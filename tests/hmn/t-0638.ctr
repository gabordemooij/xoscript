
Server init.
>> rq := Kev-thov-HTTP tshiab.
Tawm sau-ntawv: ['HTTP-GET d[]=']  + ( rq get-daim-teev: ['d[]'] ), kab-tshiab. # GET
Tawm sau-ntawv: ['HTTP-GET f[]=']  + ( rq get-daim-teev: ['f[]'] ), kab-tshiab. # GET
Tawm sau-ntawv: ['HTTP-POST e[]='] + ( rq post-daim-teev: ['e[]'] ), kab-tshiab. # GET
Tawm sau-ntawv: ['HTTP-POST c=']   + ( rq post: ['c'] ), kab-tshiab. # GET
Tawm sau-ntawv: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), kab-tshiab. # GET
