>> winery := { <- (	Phau-txhais-lus tshiab
		muab: 2 rau: ['merlot'],
		muab: 3 rau: ['malbec'],
		muab: 4 rau: ['syrah']
	).
}.

Tawm sau-ntawv: (((winery pib) - ['nothing']) tus-lej-suav), kab-tshiab.
Tawm sau-ntawv: (((winery pib) - ['merlot']) tus-lej-suav), kab-tshiab.
Tawm sau-ntawv: (((winery pib) - ['malbec']) tus-lej-suav), kab-tshiab.
Tawm sau-ntawv: (((winery pib) - ['syrah']) tus-lej-suav), kab-tshiab.
Tawm sau-ntawv: (((winery pib) - ['merlot'] - ['malbec']) tus-lej-suav), kab-tshiab.
Tawm sau-ntawv: (((winery pib) - ['merlot'] - ['syrah']) tus-lej-suav), kab-tshiab.
Tawm sau-ntawv: (((winery pib) - ['malbec'] -['syrah']) tus-lej-suav), kab-tshiab.
Tawm sau-ntawv: (((winery pib) - ['malbec'] - ['syrah'] - ['merlot']) tus-lej-suav), kab-tshiab.

