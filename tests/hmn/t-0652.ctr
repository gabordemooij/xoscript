# test number -> string -> number
{

	>> x := Lej ntawm: 0 thiab: 1000000.
	>> d := Lej ntawm: 1 thiab: 7.
	>> e := 10 lej-zog: d.

	x faib-nrog: e.
	>> y := x kab-ntawv lej.

	(x = y) cuav: {
		Tawm sau-ntawv: x, kab-tshiab.
		Tawm sau-ntawv: y, kab-tshiab.
		Kev-pab-cuam-khoos-phis-tawj ua-tiav.
	}.

} * 1000.
Tawm sau-ntawv: ['OK'], kab-tshiab.