#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Qauv-nrhiav tshiab: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern sib-phim: subject ua: { :m :x
	Tawm sau-ntawv: m, kab-tshiab.
	Tawm sau-ntawv: x, kab-tshiab. <- ['XXX'].
}.
Tawm sau-ntawv: result, kab-tshiab.