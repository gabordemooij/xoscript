Server init.
>> a := Blob tshiab: 4.
a bytes: ( Daim-teev tshiab ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob tshiab: 4.
b bytes: ( Daim-teev tshiab ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
# inherited blob does not get the buffer, so it's useless
# it will pass ctr_accept() but since buffer ptr == null, it will retur
>> c := a tshiab.
{ 
>> n := a ^ c.
Tawm sau-ntawv: ['xorred:'], kab-tshiab. 
Tawm sau-ntawv: n, kab-tshiab. 
} txhom: { :e Tawm sau-ntawv: e, kab-tshiab. }, pib.
a tso-tawm.
b tso-tawm.
