>> i := 0.
Tawm sau-ntawv: ['Can we count to 10 using a whileTrue loop ?'], kab-tshiab.
{ Tawm sau-ntawv: i, kab-tshiab. } thaum-lub-sij-hawm: { i ntxiv: 1. <- (i ≤ 10). }.
Tawm sau-ntawv: ['Can we count back from 10 to 0 using a whileFalse loop ?'], kab-tshiab.
{ Tawm sau-ntawv: i, kab-tshiab. } thaum-lub-sij-hawm: { i rho: 1. <- (i ≥ 0). }.
