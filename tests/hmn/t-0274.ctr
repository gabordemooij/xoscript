

Daim-teev thaum-tuaj: ['column:'] ua: { :column
	>> result := Daim-teev tshiab.
	tus-kheej txhua: { :index :row
		row txhua: { :index :cell
			(index = column) tseeb: { result ntxiv-tom-kawg: cell. }.
		}.
	}. <- result.
}.


>> a := Daim-teev ←
	(Daim-teev ← 1 ; 2 ; 3) ;
	(Daim-teev ← 4 ; 5 ; 6) ;
	(Daim-teev ← 7 ; 8 ; 9).

>> b := a column: 1.
Tawm sau-ntawv: b, kab-tshiab.

b := a column: 20.
Tawm sau-ntawv: b, kab-tshiab.

b := a column: -100.
Tawm sau-ntawv: b, kab-tshiab.
