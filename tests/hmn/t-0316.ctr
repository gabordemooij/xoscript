>> Grandfather := Yam-khoom tshiab.
Grandfather thaum-tuaj: ['greet'] ua: {
	Tawm sau-ntawv: ['Ave!'], kab-tshiab.
}.
>> Father := Grandfather tshiab.
Father thaum-tuaj: ['greet'] ua: {
	Tawm sau-ntawv: ['Hello'], kab-tshiab.
	tus-kheej greet.
}.
>> Son := Father tshiab.
Son thaum-tuaj: ['greet'] ua: {
	Tawm sau-ntawv: ['Hi'], kab-tshiab.
	tus-kheej greet.
}.

Son greet.

>> Roundabout := Yam-khoom tshiab.
Roundabout thaum-tuaj: ['circle:'] ua: { :x
	Tawm sau-ntawv: x, kab-tshiab.
	(x < 3) tseeb: { tus-kheej hu-nws-tus-kheej circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) tseeb: { Tawm sau-ntawv: x, kab-tshiab. x ntxiv: 1.  increment pib. }. }.
increment pib.