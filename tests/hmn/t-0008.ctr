>> Greeter := Yam-khoom tshiab.
Greeter thaum-tuaj: ['make'] ua: {
	>> greeter := Yam-khoom tshiab.
	greeter thaum-tuaj: ['name:'] ua: { :npe
		Tawm sau-ntawv: ['setting a name'].
		nws-li myName := npe.
	}.
	greeter thaum-tuaj: ['greet'] ua: {
		Tawm sau-ntawv: ['Hello'].
		Tawm sau-ntawv: nws-li myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
