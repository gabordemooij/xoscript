Server init.

Tawm sau-ntawv: (
	Qauv-nrhiav tshiab: ['^\\w+$'],
	sib-phim: ['test@example.com'] 
), kab-tshiab. # 0 match, fails on @ and .

Tawm sau-ntawv: (
	Qauv-nrhiav tshiab: ['^[^@]+@[^\.]+\.\\w+$'],
	sib-phim: ['test@example.com'] 
), kab-tshiab. # 1 match

Tawm sau-ntawv: (
	Qauv-nrhiav tshiab: ['[^@]+@[^\.]+\.\\w+'],
	sib-phim: ['test@example.com'] 
), kab-tshiab. # 1 match

Tawm sau-ntawv: (
	Qauv-nrhiav tshiab: ['([^@]+)@([^\.]+)\.\\w+'],
	sib-phim: ['test@example.com'] 
), kab-tshiab. # 1 match, groups dont matter

Tawm sau-ntawv: (
	Qauv-nrhiav tshiab: ['[a-z]'],
	sib-phim: ['test@example.com'] 
), kab-tshiab. # 14 matches

Tawm sau-ntawv: (
	Qauv-nrhiav tshiab: ['.*'],
	sib-phim: ['test@example.com'] 
), kab-tshiab. # 1 match (all)

Tawm sau-ntawv: (
	Qauv-nrhiav tshiab: ['(.*)'],
	sib-phim: ['test@example.com'] 
), kab-tshiab. # 1 match (all)

Tawm sau-ntawv: (
	Qauv-nrhiav tshiab: ['\\s*[^@]+@[^\.]+\.\\w+'],
	sib-phim: ['test@example.com'] 
), kab-tshiab. # 1 match, prefix space optional, gets ignored