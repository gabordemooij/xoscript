>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Yam-khoom tshiab.
⚄ thaum-tuaj: ['drawFrom:length:'] ua: { :pool :tus-lej-suav
	
	>> result := [''].
	
	{
		>> index := Lej random % (pool qhov-ntev).
		result ntxiv-tom-kawg: ( pool tus-ntawv: (index + 1) ).
		
	} × tus-lej-suav. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? qhov-ntev.
Tawm sau-ntawv: (['x↵'] x random qhov-ntev).
Tawm sau-ntawv: (['y↵'] y ?? qhov-ntev).

