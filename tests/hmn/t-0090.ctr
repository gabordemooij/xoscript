Tawm sau-ntawv: ['1,2,3,4,5,6,7,8,9,A,'], kab-tshiab.
>> Scope := Yam-khoom tshiab.
Scope thaum-tuaj: ['initialize:'] ua: { :x nws-li property := x. }.
Scope thaum-tuaj: ['confirm'] ua: { Tawm sau-ntawv: [',']. }.
Scope thaum-tuaj: ['kev-sim'] ua: {
	Tawm sau-ntawv: nws-li property.
	tus-kheej confirm.
	( 1 = 1 ) tseeb: { Tawm sau-ntawv: nws-li property. tus-kheej confirm. }.
	( 1 = 0 ) cuav: { Tawm sau-ntawv: nws-li property. tus-kheej confirm. }.
	>> y := 2. { Tawm sau-ntawv: nws-li property. tus-kheej confirm. } thaum-lub-sij-hawm: { y rho: 1. <- (y > 0). }.
	{ Tawm sau-ntawv: nws-li property. tus-kheej confirm. } × 1.
	(Daim-teev ← 1) txhua: {  Tawm sau-ntawv: nws-li property. tus-kheej confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Phau-txhais-lus tshiab one: ['item']) txhua: { Tawm sau-ntawv: nws-li property. tus-kheej confirm. }.
	{ 1 ÷ 0. } txhom: { Tawm sau-ntawv: nws-li property. tus-kheej confirm. }, pib.
	Tawm kab-tshiab.
}.
>> scope1 := Scope tshiab.
scope1 initialize: ['X'].
scope1 kev-sim.
>> function := { 
	nws-li property := ['Y'].
	Tawm sau-ntawv: nws-li property.
	tus-kheej confirm.
	( 1 = 1 ) tseeb: { Tawm sau-ntawv: nws-li property. tus-kheej confirm. }.
	( 1 = 0 ) cuav: { Tawm sau-ntawv: nws-li property. tus-kheej confirm. }.
	>> y := 2. { Tawm sau-ntawv: nws-li property. tus-kheej confirm. } thaum-lub-sij-hawm: { y rho: 1. <- (y > 0). }.
	{ Tawm sau-ntawv: nws-li property. tus-kheej confirm. } × 1.
	(Daim-teev ← 1) txhua: {  Tawm sau-ntawv: nws-li property. tus-kheej confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Phau-txhais-lus tshiab one: ['item']) txhua: { Tawm sau-ntawv: nws-li property. tus-kheej confirm. }.
	{ 1 ÷ 0. } txhom: { Tawm sau-ntawv: nws-li property. tus-kheej confirm. }, pib.
	Tawm kab-tshiab.
}.
function thaum-tuaj: ['confirm'] ua: { Tawm sau-ntawv: [',']. }.
function siv-rau: 1 thiab: 2.
