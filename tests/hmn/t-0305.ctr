
Lej kawm: ['plus:'] txhais-tau-tias: ['+'].
Lej thaum-tuaj: ['+'] ua: { :x
	>> rate := 1.
	>> currency := x chav-ntsuas-lej.
	(currency = ['euros']) tseeb: {
		rate := 2.
	}. <- (tus-kheej plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars chav-ntsuas: ['dollars'].
euros chav-ntsuas: ['euros'].
>> money := dollars + euros.
Tawm sau-ntawv: money, kab-tshiab.
