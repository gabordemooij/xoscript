

Kab-ntawv thaum-tuaj: ['evaluate'] ua: {
	>> cim-khoos-phis-tawj := Ntaub-ntawv tshiab: ['/tmp/eval.ctr'].
	cim-khoos-phis-tawj sau-ntawv: tus-kheej kab-ntawv + ['.'].
	Kev-pab-cuam-khoos-phis-tawj siv: ['/tmp/eval.ctr'].
}.

>> a := (Daim-teev ← (
	(Phau-txhais-lus tshiab)
		muab: ['domain'] rau: ['mywebsite.com'],
		muab: (Daim-teev ←
			((Phau-txhais-lus tshiab)
				muab: ['home'] rau: ['title'],
				muab: ['<html></html>'] rau: ['body'],
				muab: ['2017-01-01'] rau: ['created']
			) ;
			((Phau-txhais-lus tshiab)
				muab: ['aboutus(c)'] rau: ['title'],
				muab: ['<credits>Author Inc.</credits>'] rau: ['body']
			)
		) rau: ['pages']
	)
) kab-ntawv.

Tawm sau-ntawv: a hom, kab-tshiab.
Tawm sau-ntawv: a, kab-tshiab.

>> b := Tsis-muaj-dabtsi.
(['b := '] + a) evaluate.
Tawm sau-ntawv: b ? 0 ? ['pages'] ? 1 ? ['body'], kab-tshiab.

>> c := b ? 0.
>> d := c kab-ntawv.
Tawm sau-ntawv: d hom, kab-tshiab.

>> e := Tsis-muaj-dabtsi.
(['e := '] + d) evaluate.
Tawm sau-ntawv: e ? ['pages'] ? 0, kab-tshiab.
