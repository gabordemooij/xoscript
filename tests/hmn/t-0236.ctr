>> Slurp := Yam-khoom tshiab.
Slurp thaum-tuaj: ['tshiab'] ua: {
	nws-li str := [''].
}.


Slurp thaum-tuaj: ['teb:'] ua: { :blah
		(nws-li str ≠ ['']) tseeb: {
			nws-li str ntxiv-tom-kawg: [' '].
		}.
		nws-li str ntxiv-tom-kawg: blah.
}.
Slurp thaum-tuaj: ['teb:thiab:'] ua: { :blah :blahah
		(nws-li str ≠ ['']) tseeb: {
			nws-li str ntxiv-tom-kawg: [' '].
		}.
		(blah qhov-ntev > 1) tseeb: {
			nws-li str ntxiv-tom-kawg: (blah los-ntawm: 0 ntev: (blah qhov-ntev - 1)).
		}, lwm-yam: {
			nws-li str ntxiv-tom-kawg: blah.
		}.
		nws-li str ntxiv-tom-kawg: [' '].
		nws-li str ntxiv-tom-kawg: blahah.
}.
Slurp thaum-tuaj: ['obtain'] ua: {
	>> buffer := nws-li str.
	nws-li str := ['']. <- buffer.
}.

>> cov-nqe-nrhiav := Slurp tshiab.
cov-nqe-nrhiav select: ['*'], from users where: ['id = 2'].
Tawm sau-ntawv: (cov-nqe-nrhiav obtain), kab-tshiab.
