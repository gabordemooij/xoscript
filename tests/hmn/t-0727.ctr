Server init.
>> f := Hom-ntawv tshiab: ['%d'].
>> a := Blob tshiab: 4.
a bytes: ( Daim-teev tshiab ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob tshiab: 4.
b bytes: ( Daim-teev tshiab ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a los-ntawm: 0 ntev: 3, txhua: { :i :byte
	Tawm sau-ntawv: ( f siv-rau-lej-tag-nrho: byte ), kab-tshiab.
}.
a ^ b.
a los-ntawm: 0 ntev: 3, txhua: { :i :byte
	Tawm sau-ntawv: ( f siv-rau-lej-tag-nrho: byte ), kab-tshiab.
}.
a ^ b.
a los-ntawm: 0 ntev: 3, txhua: { :i :byte
	Tawm sau-ntawv: ( f siv-rau-lej-tag-nrho: byte ), kab-tshiab.
}.
a tso-tawm.
b tso-tawm.

{ a ^ Yam-khoom. } txhom: { :e Tawm sau-ntawv: e, kab-tshiab. }, pib.
