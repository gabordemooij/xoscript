Server init.
>> a := Blob tshiab: 4.
a bytes: ( Daim-teev tshiab ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob tshiab: 4.
b bytes: ( Daim-teev tshiab ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a ^ b.
{
	a ^ ( Ntaub-ntawv tshiab: ['noblob???'] ).
} txhom: { :e Tawm sau-ntawv: e, kab-tshiab. }, pib.
a tso-tawm.
b tso-tawm.
