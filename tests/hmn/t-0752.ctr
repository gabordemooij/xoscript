Tawm sau-ntawv: ['Test object'], kab-tshiab.
>> a := Yam-khoom tshiab. 

a thaum-tuaj: ['item:'] ua: { :tseeb-los-cuav
	nws-li tseeb-los-cuav := tseeb-los-cuav. 
}.

a thaum-tuaj: ['item'] ua: { <- nws-li tseeb-los-cuav.
}.

a item: Tseeb-los-cuav.

Tawm sau-ntawv: a item, kab-tshiab.

>> old-bool-address := a item qauv-thawj chaw-nyob-nco.
a save-as: ['/tmp/a.bin'].
Tawm sau-ntawv: ['========== RELOADING SNAP:'], kab-tshiab.

>> b := Yam-khoom load-from: ['/tmp/a.bin'].

(b item qauv-thawj chaw-nyob-nco = old-bool-address) tseeb: {
	Tawm sau-ntawv: ['Object link re-attached.'], kab-tshiab.
}.

Tawm sau-ntawv: b item, kab-tshiab.
