
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> cim-khoos-phis-tawj := {
	>> o := (
		Phau-txhais-lus tshiab
		aa: (Daim-teev ← 1 ; 2),
		bb: (Daim-teev ← 3 ; 4)
	).
	>> s := o kab-ntawv.
	>> o2 := s yam-khoom.
	(s  hom = Kab-ntawv hom) tseeb: { Tawm sau-ntawv: ['OK1'], kab-tshiab. }.
	(o2 hom = Phau-txhais-lus hom) tseeb: { Tawm sau-ntawv: ['OK2'], kab-tshiab. }.
}.

Kev-pab-cuam-khoos-phis-tawj tswj-chaw-nco: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.
usedMemory1 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 1).
cim-khoos-phis-tawj pib.
Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.
usedMemory2 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 1).
cim-khoos-phis-tawj pib.
Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.
usedMemory3 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 1).
cim-khoos-phis-tawj pib.
Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.
usedMemory4 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 1).

(usedMemory2 = usedMemory3 = usedMemory4) tseeb: { Tawm sau-ntawv: ['OK3'], kab-tshiab. }.
 
