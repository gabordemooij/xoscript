>> To-Do := Yam-khoom tshiab.

To-Do thaum-tuaj: ['tshiab'] ua: {
	nws-li list := Daim-teev tshiab.
}.

To-Do thaum-tuaj: ['nieuw'] ua: {
	nws-li list := Daim-teev tshiab.
}.

To-Do thaum-tuaj: ['+'] ua: { :task
	nws-li list ntxiv-tom-kawg: task.
}.

To-Do thaum-tuaj: ['number of tasks?'] ua: { <-  nws-li list tus-lej-suav.
}.

>> todos := 
	To-Do tshiab 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Tawm sau-ntawv: ['You have $ tasks to do'] $ todos number of tasks?.
