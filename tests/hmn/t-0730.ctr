Tawm sau-ntawv: ['Test object'], kab-tshiab.
>> a := Yam-khoom tshiab. 

a thaum-tuaj: ['item:'] ua: { :moment
	nws-li moment := moment. 
}.

a thaum-tuaj: ['item'] ua: { <- nws-li moment.
}.

>> today := Lub-sijhawm tshiab cheeb-tsam-sijhawm: ['CEST'], xyoo: 2026, lub-hli: 7.
a item: today.
Tawm sau-ntawv: a item, kab-tshiab.
a save-as: ['/tmp/a.bin'].
Tawm sau-ntawv: ['========== RELOADING SNAP:'], kab-tshiab.
>> b := Yam-khoom load-from: ['/tmp/a.bin'].
Tawm sau-ntawv: b item, kab-tshiab.
