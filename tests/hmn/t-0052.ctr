>> items := Phau-txhais-lus tshiab.
items muab: ['green'] rau: ['color-1'].
items muab: ['orange'] rau: ['color-2'].
items muab: ['red'] rau: ['color-3'].
>> i := 0.
>> s := [''].
items txhua: { :key :color
	Tawm sau-ntawv: ['color #'] + i + [' is: '] + color + [' '].
	i ntxiv: 1.
}.
Tawm sau-ntawv: i + [' colors!'].
