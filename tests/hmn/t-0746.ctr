Tawm sau-ntawv: ['Test object'], kab-tshiab.
>> a := Yam-khoom tshiab. 

a thaum-tuaj: ['item:'] ua: { :dict
	nws-li dict := dict. 
}.

a thaum-tuaj: ['item'] ua: { <- nws-li dict.
}.

a item: (
Phau-txhais-lus tshiab
	hello: ['world'],
	world: (Phau-txhais-lus tshiab muab: ['a'] rau: ['b'])).

Tawm sau-ntawv: a item, kab-tshiab.

>> old-dict-address := a item qauv-thawj chaw-nyob-nco.
a save-as: ['/tmp/a.bin'].
Tawm sau-ntawv: ['========== RELOADING SNAP:'], kab-tshiab.

>> b := Yam-khoom load-from: ['/tmp/a.bin'].

(b item qauv-thawj chaw-nyob-nco = old-dict-address) tseeb: {
	Tawm sau-ntawv: ['Object link re-attached.'], kab-tshiab.
}.

Tawm sau-ntawv: b item, kab-tshiab.
