

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> x := 100.

Kev-pab-cuam-khoos-phis-tawj tswj-chaw-nco: 0.

{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt ntxiv-tom-kawg: ['!!'].
Tawm sau-ntawv: txt.
} pib.

Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.

usedMemory1 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 0).


{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt ntxiv-tom-kawg: ['!!'].
Tawm sau-ntawv: txt.
} pib.

Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.
usedMemory2 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 0).


{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt ntxiv-tom-kawg: ['!!'].
