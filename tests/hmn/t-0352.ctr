Lej thaum-tuaj: ['roman'] ua: {
	>> lej := tus-kheej luam.
	>> roman := [''].
	{
		{
			(lej ≥ 1000) tseeb: {
				roman ntxiv-tom-kawg: ['Ⅿ'].
				lej rho: 1000.
			}, tso-tseg.
		
			(lej ≥ 500) tseeb: {
				roman ntxiv-tom-kawg: ['Ⅾ'].
				lej rho: 500.
			}, tso-tseg.
		
			(lej ≥ 100) tseeb: {
				roman ntxiv-tom-kawg: ['Ⅽ'].
				lej rho: 100.
			}, tso-tseg.
		
			(lej ≥ 50) tseeb: {
				roman ntxiv-tom-kawg: ['Ⅼ'].
				lej rho: 50.
			}, tso-tseg.
		
			(lej ≥ 50) tseeb: {
				roman ntxiv-tom-kawg: ['Ⅼ'].
				lej rho: 50.
			}, tso-tseg.
		
			(lej ≥ 10) tseeb: {
				roman ntxiv-tom-kawg: ['Ⅹ'].
				lej rho: 10.
			}, tso-tseg.
			
			(lej ≥ 9) tseeb: {
				roman ntxiv-tom-kawg: ['Ⅸ'].
				lej rho: 9.
			}, tso-tseg.
			
			(lej ≥ 5) tseeb: {
				roman ntxiv-tom-kawg: ['Ⅴ'].
				lej rho: 5.
			}, tso-tseg.
			
			(lej ≥ 4) tseeb: {
				roman ntxiv-tom-kawg: ['Ⅳ'].
				lej rho: 4.
			}, tso-tseg.
			
			(lej ≥ 1) tseeb: {
				roman ntxiv-tom-kawg: ['Ⅰ'].
				lej rho: 1.
			}, tso-tseg.
		} cov-txheej-txheem.
	} thaum-lub-sij-hawm: { <- lej > 0. }. <- roman.
}.

Tawm sau-ntawv: 1 roman, kab-tshiab.
Tawm sau-ntawv: 2 roman, kab-tshiab.
Tawm sau-ntawv: 4 roman, kab-tshiab.
Tawm sau-ntawv: 8 roman, kab-tshiab.
Tawm sau-ntawv: 16 roman, kab-tshiab.
Tawm sau-ntawv: 32 roman, kab-tshiab.
Tawm sau-ntawv: 64 roman, kab-tshiab.
Tawm sau-ntawv: 128 roman, kab-tshiab.
Tawm sau-ntawv: 256 roman, kab-tshiab.
Tawm sau-ntawv: 1024 roman, kab-tshiab.
