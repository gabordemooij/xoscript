>> HTML := Yam-khoom tshiab.
HTML thaum-tuaj: ['teb:'] ua: { :tag 
	Tawm sau-ntawv: (['<tag>'] tag: tag), kab-tshiab.
}.
HTML thaum-tuaj: ['teb:thiab:'] ua: { :tag :html 
	Tawm sau-ntawv: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), kab-tshiab.
}.
>> html := HTML tshiab.
html body h1: ['header'].

