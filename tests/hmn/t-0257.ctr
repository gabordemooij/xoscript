
>> Greeter := Yam-khoom tshiab.
Greeter thaum-tuaj: ['tshiab'] ua: {
	nws-li npe := ['?'].
}.
Greeter thaum-tuaj: ['name:'] ua: { :npe
	nws-li npe := npe.
}.
Greeter thaum-tuaj: ['greet'] ua: {
	Tawm sau-ntawv: (['hello[you]'] [you]: nws-li npe).
}.
>> friend := Greeter tshiab.
friend name: ['1'].
friend greet.
