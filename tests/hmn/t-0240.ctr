# test qualifiers

>> $ := Yam-khoom tshiab.

$ thaum-tuaj: ['teb:'] ua: { :x
	
	>> operation := x tus-ntawv: 0.
	>> valuta := x tus-ntawv: 1.
	>> money := x hla: 2.
	
	>> amount := 0.

	( operation = ['+'] ) tseeb: {
		( valuta = ['£'] ) tseeb: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Tawm sau-ntawv: x, kab-tshiab.


>> Fruit := Yam-khoom tshiab.

Fruit thaum-tuaj: ['tshiab'] ua: {
	>> f := tus-kheej tshiab.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit thaum-tuaj: ['apples:'] ua: { :a nws-li apples := a. }.
Fruit thaum-tuaj: ['oranges:'] ua: { :p nws-li oranges := p. }.
Fruit thaum-tuaj: ['apples'] ua: { <- nws-li apples. }.
Fruit thaum-tuaj: ['oranges'] ua: { <- nws-li oranges. }.

Fruit thaum-tuaj: ['+'] ua: { :f
	
	>> n := Fruit tshiab.
	f ntxiv: 1.
	
	n apples: (f apples + nws-li apples).
	n oranges:  (f oranges  + nws-li oranges). <- n.
}.

Fruit thaum-tuaj: ['kab-ntawv'] ua: { <- ( nws-li apples kab-ntawv + [' apples and '] + nws-li oranges + [' oranges'] ).
}.

Lej thaum-tuaj: ['apples'] ua: { <- ((Fruit tshiab) apples: tus-kheej).
}.

Lej thaum-tuaj: ['apple'] ua: { <- ((Fruit tshiab) apples: tus-kheej).
}.

Lej thaum-tuaj: ['oranges'] ua: { <- ((Fruit tshiab) oranges: tus-kheej).
}.




Tawm sau-ntawv: (1 apple + 3 oranges + 4 apples), kab-tshiab.


Kab-ntawv thaum-tuaj: ['twice'] ua: { <- ((tus-kheej kab-ntawv) + (tus-kheej kab-ntawv)).
}.



Tawm sau-ntawv: ['❤❤❤'] twice.



