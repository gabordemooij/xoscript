>> items := Phau-txhais-lus tshiab.
items muab: ['black'] rau: ['coffee'], muab: ['earl grey'] rau: ['tea'].
Tawm sau-ntawv: (items ntawm: ['coffee']), sau-ntawv: (items ntawm: ['tea']).
Tawm sau-ntawv: ['there are'] + items tus-lej-suav + [' items in the array.'].
items muab: ['capuccino'] rau: ['coffee'].
Tawm sau-ntawv: ['Now my coffee is.. '] + (items ntawm: ['coffee']).
items muab: ['aaa'] rau: ['1'].
items muab: ['bbb'] rau: ['2'].
Tawm sau-ntawv: (items ntawm: ['a']).
