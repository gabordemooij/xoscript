


>> CoffeeMachine := Yam-khoom tshiab.
CoffeeMachine thaum-tuaj: ['order:'] ua: { :id
	>> coffee := ['Americano'].
	( id = 1 ) tseeb: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) tseeb: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) tseeb: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Yam-khoom tshiab.
SimpleCoffeeMachine thaum-tuaj: ['order'] ua: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Tawm sau-ntawv: redCup, kab-tshiab.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Tawm sau-ntawv: greenCup, kab-tshiab.
>> yellowCup := CoffeeMachine order: 1.
Tawm sau-ntawv: yellowCup, kab-tshiab.
>> blueCup := CoffeeMachine order: 0.
Tawm sau-ntawv: blueCup, kab-tshiab.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Tawm sau-ntawv: blackCup, kab-tshiab.
blackCup ntxiv-tom-kawg: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Tawm sau-ntawv: orangeCup, kab-tshiab.
