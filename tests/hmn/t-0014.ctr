>> Greeter := Yam-khoom tshiab.
Greeter thaum-tuaj: ['make'] ua: {
	>> gr := Yam-khoom tshiab.
	gr thaum-tuaj: ['setName:'] ua: { :aname
		nws-li npe := aname.
	}.
	gr thaum-tuaj: ['greet'] ua: {
		Tawm sau-ntawv: nws-li npe.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a tshiab.
c setName: ['THREE'].
c greet.
>> d := a tshiab.
d setName: ['FOUR'].
d greet.
c greet.
