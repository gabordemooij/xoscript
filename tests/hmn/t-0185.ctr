

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Kev-pab-cuam-khoos-phis-tawj tswj-chaw-nco: 0.

>> a := -2 tus-nqi-tiag.
a := a atan.
a := a cos.
a := a log.
a := a sin.
a := a tan.


Kev-pab-cuam-khoos-phis-tawj tu-kom-huv.

usedMemory1 := (Kev-pab-cuam-khoos-phis-tawj chaw-nco ? 0).


a := -2 tus-nqi-tiag.
a := a atan.
a := a cos.
a := a log.
a := a sin.
a := a tan.


