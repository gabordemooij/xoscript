
Kev-pab-cuam-khoos-phis-tawj tswj-chaw-nco: 4.

>> Animal := Yam-khoom tshiab.
Animal thaum-tuaj: ['make'] ua: {
	>> animal := Yam-khoom tshiab.
	animal thaum-tuaj: ['makeSound'] ua: {
		Tawm sau-ntawv: nws-li sound.
	}. <- animal.
}.
>> Cat := Yam-khoom tshiab.
Cat thaum-tuaj: ['make'] ua: {
	>> cat := Animal make.
	cat thaum-tuaj: ['init'] ua: {
		nws-li sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
