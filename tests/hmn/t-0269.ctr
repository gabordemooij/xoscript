#Linux

(Ntaub-ntawv tshiab: ['/tmp/testje']) muaj-nyob cuav: {
	Kev-pab-cuam-khoos-phis-tawj txheej-txheem-tshuab: ['mkdir /tmp/testje'].	
}.

(Ntaub-ntawv tshiab: ['/tmp/testje/file1']) muaj-nyob cuav: {
	Kev-pab-cuam-khoos-phis-tawj txheej-txheem-tshuab: ['touch /tmp/testje/file1'].	
}.

(Ntaub-ntawv tshiab: ['/tmp/testje/folder1']) muaj-nyob cuav: {
	Kev-pab-cuam-khoos-phis-tawj txheej-txheem-tshuab: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Ntaub-ntawv daim-teev: ['/tmp/testje'].

>> q := Daim-teev tshiab.

l txhua: { :k :v v txhua: { :x :y q ntxiv-tom-kawg: y. }. }.

>> s := q kab-ntawv.

(s muaj: ['file1']) tseeb:   { Tawm sau-ntawv: ['OK'], kab-tshiab. }.
(s muaj: ['file2']) tseeb:   { Tawm sau-ntawv: ['XX'], kab-tshiab. }.
(s muaj: ['folder1']) tseeb: { Tawm sau-ntawv: ['OK'], kab-tshiab. }.
