


Tawm sau-ntawv: ['Number:'].
>> a := Lej + Lej + 1.
a := Lej - 2.
a := Lej × 2.
a := Lej ÷ 2.
Tawm sau-ntawv: a.
Tawm kab-tshiab.

Tawm sau-ntawv: ['String:'].
Tawm sau-ntawv: Kab-ntawv qhov-ntev.
Tawm kab-tshiab.

Tawm sau-ntawv: ['File:'].
Tawm sau-ntawv: Ntaub-ntawv nyeem.
Tawm sau-ntawv: (Ntaub-ntawv sau-ntawv: ['test']).
Tawm sau-ntawv: (Ntaub-ntawv ntxiv-tom-kawg: ['test']).
Tawm sau-ntawv: Ntaub-ntawv rho-tawm.
Tawm sau-ntawv: Ntaub-ntawv muaj-nyob.
Tawm sau-ntawv: Ntaub-ntawv include.
Tawm sau-ntawv: Ntaub-ntawv pib.
Tawm kab-tshiab.


Tawm sau-ntawv: ['Array:'].
Tawm sau-ntawv: Daim-teev rho-kawg.
Tawm sau-ntawv: Daim-teev tus-lej-suav.
Tawm sau-ntawv: (((Daim-teev ntxiv-tom-kawg: 999) kab-ntawv) hloov: ['Lĳst'] nrog: ['List']).
Tawm sau-ntawv: Daim-teev tus-lej-suav.
Tawm sau-ntawv: Daim-teev rho-thawj.
Tawm sau-ntawv: (Daim-teev muab-sib-txuas: [',']).
>> f := Daim-teev tshiab.
Tawm sau-ntawv: f tus-lej-suav. 
Tawm kab-tshiab.

Tawm sau-ntawv: ['Map:'].
Tawm sau-ntawv: Phau-txhais-lus tus-lej-suav.
Tawm sau-ntawv: (Phau-txhais-lus muab: ['a'] rau: ['b'])  tus-lej-suav. 
Tawm kab-tshiab.




