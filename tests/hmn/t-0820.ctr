# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Qauv-nrhiav tshiab: pattern.
	p sib-phim: subject ua: { :m :g
		Tawm sau-ntawv: g tus-lej-suav, sau-ntawv: [' '], sau-ntawv: (g muab-sib-txuas: ['|']), kab-tshiab. <- m.
	}.
}.
show siv-rau: ['(a)|(b)'] thiab: ['b'].
show siv-rau: ['(a)|(b)'] thiab: ['a'].
show siv-rau: ['(x)?y'] thiab: ['y'].
show siv-rau: ['(x)?(y)(z)?'] thiab: ['xy'].
