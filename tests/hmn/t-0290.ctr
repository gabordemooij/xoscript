# test list operations


>> cakes := Daim-teev ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes hloov: 1 ntev: 2 nrog: ( Daim-teev ← ['cinnamon'] ; ['pineapple'] ).
Tawm sau-ntawv: (buy muab-sib-txuas: [',']), kab-tshiab.


>> buy := cakes hloov: 1 ntev: 12 nrog: ( Daim-teev ← ['cinnamon'] ; ['pineapple'] ).
Tawm sau-ntawv: (buy muab-sib-txuas: [',']), kab-tshiab.


>> buy := cakes hloov: 2 ntev: 10 nrog: ( Daim-teev tshiab ).
Tawm sau-ntawv: (buy muab-sib-txuas: [',']), kab-tshiab.


>> buy := cakes hloov: 0 ntev: 1 nrog: ( Daim-teev tshiab ).
Tawm sau-ntawv: (buy muab-sib-txuas: [',']), kab-tshiab.


>> buy := cakes hloov: ['0'] ntev: ['1'] nrog: ['x'].
Tawm sau-ntawv: (buy muab-sib-txuas: [',']), kab-tshiab.
