>> repeater := Yam-khoom tshiab.
repeater thaum-tuaj: ['teb:'] ua: { :what
	Tawm sau-ntawv: what + [' '].
}.
repeater thaum-tuaj: ['teb:thiab:'] ua: { :what :say
	Tawm sau-ntawv: what, sau-ntawv: say + [' '].
}.
repeater thaum-tuaj: ['teb:thiab:thiab:'] ua: { :what :say :more
	Tawm sau-ntawv: what, sau-ntawv: say, sau-ntawv: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
