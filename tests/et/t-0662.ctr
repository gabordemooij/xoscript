>> t := Tühi.

# you can control the time zone for
# parsing like this:
Hetk tsoon: ['CET'].
t := Hetk allikast: ['1981-02-03 04:05:06'].
Väljund kirjuta: t, reavahetus.

# now using CEST time zone:
Hetk tsoon: ['CEST'].
t := Hetk allikast: ['1981-02-03 04:05:06'].
Väljund kirjuta: t, reavahetus.

# error if string cannot be parsed
{ Hetk allikast: ['1900']. } püüa: { Tühi. }, käivita.
