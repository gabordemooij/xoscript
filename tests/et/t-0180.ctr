Tekst kui: ['html'] tee: { <- (
		ise
		asenda: ['&'] väärtusega: ['&amp;'],
		asenda: ['<'] väärtusega: ['&lt;'],
		asenda: ['>'] väärtusega: ['&gt;'],
		asenda: ['''] väärtusega: ['&apos;'],
		asenda: ['"'] väärtusega: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm mäluhaldus: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Väljund kirjuta: txt kopeeri html, reavahetus.
Väljund kirjuta: txt kopeeri väiketähed, reavahetus.
Väljund kirjuta: txt kopeeri suurtähed, reavahetus.
} käivita.

Programm korista.

usedMemory1 := (Programm mälu ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Väljund kirjuta: txt kopeeri html, reavahetus.
Väljund kirjuta: txt kopeeri väiketähed, reavahetus.
Väljund kirjuta: txt kopeeri suurtähed, reavahetus.
} käivita.

Programm korista.
usedMemory2 := (Programm mälu ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Väljund kirjuta: txt kopeeri html, reavahetus.
Väljund kirjuta: txt kopeeri väiketähed, reavahetus.
Väljund kirjuta: txt kopeeri suurtähed, reavahetus.
} käivita.

Programm korista.
usedMemory3 := (Programm mälu ? 0).



( usedMemory1 = usedMemory2 ja: usedMemory1 = usedMemory3, ja: usedMemory2 = usedMemory3 ) tõsi: {
	Väljund kirjuta: ['No memory leaks here'].
}, vale: {
	Väljund kirjuta: ['Leaking memory...'].
}.
