


>> CoffeeMachine := Objekt uus.
CoffeeMachine kui: ['order:'] tee: { :id
	>> coffee := ['Americano'].
	( id = 1 ) tõsi: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) tõsi: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) tõsi: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Objekt uus.
SimpleCoffeeMachine kui: ['order'] tee: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Väljund kirjuta: redCup, reavahetus.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Väljund kirjuta: greenCup, reavahetus.
>> yellowCup := CoffeeMachine order: 1.
Väljund kirjuta: yellowCup, reavahetus.
>> blueCup := CoffeeMachine order: 0.
Väljund kirjuta: blueCup, reavahetus.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Väljund kirjuta: blackCup, reavahetus.
blackCup lisa-lõppu: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Väljund kirjuta: orangeCup, reavahetus.
