Arv kui: ['factorial'] tee: {
	>> total := 1.
	{ :index total korruta: (ise - (index)). } × ise. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Väljund kirjuta: a.
>> b := 2 + 3 factorial.
Väljund kirjuta: b.
>> c := 3 factorial + 2.
Väljund kirjuta: c.
>> d := 2 + (3 factorial).
Väljund kirjuta: d.
Väljund kirjuta: 2 + 3 factorial + 1.
