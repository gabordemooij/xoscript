Väljund kirjuta: ['Continue for-loop, No - before 6 and up.'], reavahetus.
{ :i
	Väljund kirjuta: (i + 1), reavahetus.
	((i + 1) > 4) jätka.
	Väljund kirjuta: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Väljund reavahetus.
Väljund kirjuta: ['Continue while-true, No --> before 5 and up.'], reavahetus.
{
	Väljund kirjuta: ['iteration #'] + x, reavahetus.
	x liida: 1.
	((x < 5) mitte) jätka.
	Väljund kirjuta: ['-->'].
} kuni: xIsLessThan10.
Väljund reavahetus.
Väljund kirjuta: ['Continue while-false, No - before 3 only.'], reavahetus.
{
	Väljund kirjuta: ['iteration #'] + x, reavahetus.
	x lahuta: 1.
	(x = 3) jätka.
	Väljund kirjuta: ['-'].
} kuni: { <- ( x > 0). }.

Väljund reavahetus.
Väljund kirjuta: ['Continue times-loop, No ||| before 3.'], reavahetus.
{ :i
	Väljund kirjuta: ['iteration #'] + i, reavahetus.
	(i = 2) jätka.
	Väljund kirjuta: ['|||'].
} × 5.

Väljund reavahetus.

{ Tõsi jätka. Väljund kirjuta: ['dont write this!'], reavahetus. } käivita.

{ Tõsi jätka. Väljund kirjuta: ['dont write this!'], reavahetus. } püüa: { Väljund kirjuta: ['Dont catch this!']. }, käivita.

Väljund kirjuta: ['Test Array each-loop: 0, ... ,2'], reavahetus.
(Loend ← 1 ; 2 ; 3) kujuta: { :i
	(i = 1) jätka.
	Väljund kirjuta: ['iteration #'] + (i - 0), reavahetus.
}.

Väljund kirjuta: ['Test Map each-loop: c only'], reavahetus.
>> m := Sõnastik uus.
m pane: ['first'] kohale: ['a'], pane: ['second'] kohale: ['b'], pane: ['third'] kohale: ['c'].
m iga: { :k :v
	(k ≠ ['c']) jätka.
	Väljund kirjuta: ['iteration'] + k + v, reavahetus.
}.

