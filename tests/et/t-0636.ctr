# test url parsing

Server init.
>> url := URL allikast: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Väljund kirjuta: ['scheme = '] + url skeem, reavahetus.
Väljund kirjuta: ['host = '] + url host, reavahetus.
Väljund kirjuta: ['port = '] + url port, reavahetus.
Väljund kirjuta: ['path = '] + url rada, reavahetus.
Väljund kirjuta: ['query = '] + url otsinguparameetrid, reavahetus.
Väljund kirjuta: ['fragment = '] + url fragment, reavahetus.
