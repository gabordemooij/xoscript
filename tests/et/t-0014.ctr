>> Greeter := Objekt uus.
Greeter kui: ['make'] tee: {
	>> gr := Objekt uus.
	gr kui: ['setName:'] tee: { :aname
		oma nimi := aname.
	}.
	gr kui: ['greet'] tee: {
		Väljund kirjuta: oma nimi.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a uus.
c setName: ['THREE'].
c greet.
>> d := a uus.
d setName: ['FOUR'].
d greet.
c greet.
