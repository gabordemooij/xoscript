Arv kui: ['factorial'] tee: {
	>> total := 1.
	{ :index total korruta: (ise - index). } × ise. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm mäluhaldus: 0.

{
2 exponent factorial.
Väljund kirjuta: (11 jääk: 3), reavahetus.
Väljund kirjuta: (3.4 ümarda), reavahetus.
Väljund kirjuta: (7.1 ümarda-üles), reavahetus.
Väljund kirjuta: (7.9 ümarda-alla), reavahetus.
}
käivita.

Programm korista.

usedMemory1 := (Programm mälu ? 0).

{
2 exponent factorial.
Väljund kirjuta: (11 jääk: 3), reavahetus.
Väljund kirjuta: (3.4 ümarda), reavahetus.
Väljund kirjuta: (7.1 ümarda-üles), reavahetus.
Väljund kirjuta: (7.9 ümarda-alla), reavahetus.
}
käivita.

Programm korista.
usedMemory2 := (Programm mälu ? 0).


{
2 exponent factorial.
Väljund kirjuta: (11 jääk: 3), reavahetus.
Väljund kirjuta: (3.4 ümarda), reavahetus.
Väljund kirjuta: (7.1 ümarda-üles), reavahetus.
Väljund kirjuta: (7.9 ümarda-alla), reavahetus.
} käivita.

Programm korista.
usedMemory3 := (Programm mälu ? 0).



( usedMemory1 = usedMemory2 ja: usedMemory1 = usedMemory3, ja: usedMemory2 = usedMemory3 ) tõsi: {
	Väljund kirjuta: ['No memory leaks here'].
}, vale: {
	Väljund kirjuta: ['Leaking memory...'].
}.
