

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm mäluhaldus: 0.

>> txt := ['1.6'].
>> n := txt arv.
>> t := txt tõeväärtus.
Väljund kirjuta: n, reavahetus.
Väljund kirjuta: t, reavahetus.
Väljund kirjuta: n tüüp, reavahetus.
Väljund kirjuta: t tüüp, reavahetus.

Programm korista.

usedMemory1 := (Programm mälu ? 0).


txt := ['1.6'].
n := txt arv.
t := txt tõeväärtus.
Väljund kirjuta: n, reavahetus.
Väljund kirjuta: t, reavahetus.
Väljund kirjuta: n tüüp, reavahetus.
Väljund kirjuta: t tüüp, reavahetus.

Programm korista.
usedMemory2 := (Programm mälu ? 0).


txt := ['1.6'].
n := txt arv.
t := txt tõeväärtus.
Väljund kirjuta: n, reavahetus.
Väljund kirjuta: t, reavahetus.
Väljund kirjuta: n tüüp, reavahetus.
Väljund kirjuta: t tüüp, reavahetus.

Programm korista.
usedMemory3 := (Programm mälu ? 0).



( usedMemory1 = usedMemory2 ja: usedMemory1 = usedMemory3, ja: usedMemory2 = usedMemory3 ) tõsi: {
	Väljund kirjuta: ['No memory leaks here'].
}, vale: {
	Väljund kirjuta: ['Leaking memory...'].
}.
