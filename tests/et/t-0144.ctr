



>> CoffeeGrounds := Objekt uus.
CoffeeGrounds kui: ['extract'] tee: { <- ['coffee']. }.

>> CoffeeMachine := Objekt uus.
CoffeeMachine kui: ['init'] tee: {
	oma coffeegrounds := CoffeeGrounds uus.
}.
CoffeeMachine kui: ['uus'] tee: { <- CoffeeMachine `new init.
}.

CoffeeMachine kui: ['makeTea'] tee: { <- (oma tealeaves extract). }.
CoffeeMachine kui: ['makeCoffee'] tee: { <- (oma coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine uus.

Väljund kirjuta:
	coffeeDream 
	makeCoffee.

Väljund kirjuta:
	coffeeDream 
	makeTea.
