# compliance test

# use international numbers

Väljund kirjuta: ['1000 -> '].
Väljund kirjuta: 1000, reavahetus. #1000

Väljund kirjuta: ['1.5 -> '].
Väljund kirjuta: 1.5, reavahetus.  #1.5

Väljund kirjuta: ['1001.5 -> '].
Väljund kirjuta: 1.5 + 1000, reavahetus. #1001.5

# use 0-indexed arrays
>> x := Loend uus ; 1 ; 2 ; 3.
>> y := Loend uus ; ['a'] ; ['b'] ; ['c'].

Väljund kirjuta: ['1 -> '].
Väljund kirjuta: x ? 0, reavahetus. #1

Väljund kirjuta: ['1 -> '].
Väljund kirjuta: (x kohal: 0), reavahetus. #1

Väljund kirjuta: ['1 -> '].
Väljund kirjuta: x esimene, reavahetus. #1

Väljund kirjuta: ['3 -> '].
Väljund kirjuta: x viimane, reavahetus. #3

Väljund kirjuta: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Väljund kirjuta: (x järgi: y), reavahetus.

Väljund kirjuta: ['1 -> '].
Väljund kirjuta: (x alates: 0 pikkus: 1) esimene, reavahetus. #1

Väljund kirjuta: ['0 -> '].
Väljund kirjuta: (x leia: 1), reavahetus. #0

x pane: 9 kohale: 0.

Väljund kirjuta: ['9 -> '].
Väljund kirjuta: (x kohal: 0), reavahetus. #9

x lisa-algusse: 8.
Väljund kirjuta: ['8 -> '].
Väljund kirjuta: (x kohal: 0), reavahetus. #9


x lisa-lõppu: 10.
Väljund kirjuta: ['10 -> '].
Väljund kirjuta: (x kohal: 4), reavahetus. #10








