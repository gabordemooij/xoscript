Programm mäluhaldus: 4.

>> Doubler := Objekt uus.
>> Multiplier := Objekt uus.
Doubler kui: ['double:and:'] tee: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier kui: ['multiply:and:'] tee: { :x :y <- (x × y).
}.

Väljund kirjuta: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), reavahetus.
