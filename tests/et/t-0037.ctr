>> a := 3.
>> b := a kopeeri.
a lahuta: 1.
Väljund kirjuta: [' a = '] + a.
Väljund kirjuta: [' b = '] + b.
a := 3.
b := a + 4.
Väljund kirjuta: [' a = '] + a.
Väljund kirjuta: [' b = '] + b.
>> x := 3.
>> y := x kopeeri.
x liida: 10.
y lahuta: 1.
Väljund kirjuta: [' x = '] + x.
Väljund kirjuta: [' y = '] + y.
>> q := Objekt uus.
q kui: ['setProperty:'] tee: { :x
	oma prop := x.
}.
q kui: ['getProperty'] tee: { <- oma prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Väljund kirjuta: [' p = '] + (p getProperty).
