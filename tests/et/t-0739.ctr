Väljund kirjuta: ['Test object'], reavahetus.
>> a := Objekt uus. 

a kui: ['item:'] tee: { :binhelper
	oma binhelper := binhelper. 
}.

a kui: ['item'] tee: { <- oma binhelper.
}.

a item: Bin uus.

>> old-binhelper-address := a item prototüüp mäluaadress.
a save-as: ['/tmp/a.bin'].
Väljund kirjuta: ['========== RELOADING SNAP:'], reavahetus.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototüüp mäluaadress = old-binhelper-address) tõsi: {
	Väljund kirjuta: ['Object link re-attached.'], reavahetus.
}.


