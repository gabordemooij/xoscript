Väljund kirjuta: ( ['3rd: '] + ( a ? 2 ) ), reavahetus.
Väljund kirjuta: ( ['prd: '] + ( a product ) ), reavahetus.
a sorteeri: { :a :b <- (b - a). }.
a iga: { :i :e Väljund kirjuta: ( i - 0 ), reavahetus. }.

} käivita.



Programm korista.
usedMemory2 := (Programm mälu ? 0).


{

>> a := Loend ← ['hello'] ; ['world'] ; Tõsi ; Tühi ; 666.
a := a + ( Loend ← 1 ).
Väljund kirjuta: ( ['sum: '] + ( a sum ) ), reavahetus.
Väljund kirjuta: ( ['min: '] + ( a miinimum ) ), reavahetus.
Väljund kirjuta: ( ['max: '] + ( a maksimum ) ), reavahetus.
Väljund kirjuta: ( ['3rd: '] + ( a ? 2 ) ), reavahetus.
