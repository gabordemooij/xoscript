Väljund kirjuta: ['Test object'], reavahetus.
>> l := Loend uus ; 1 ; ( Loend uus ; (Hetk uus: 1) ; (Int64 tekstist: ['321']) ; (Loend uus ; 3)).
Väljund kirjuta: l, reavahetus.
>> old-lst-address := l prototüüp mäluaadress.
l save-as: ['/tmp/a.bin'].
Väljund kirjuta: ['========== RELOADING SNAP:'], reavahetus.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b prototüüp mäluaadress = old-lst-address) tõsi: {
	Väljund kirjuta: ['Object link re-attached.'], reavahetus.
}.
Väljund kirjuta: b, reavahetus.
