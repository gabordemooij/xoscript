>> numbers := ['1,2,3'] tükelda: [','].
Väljund kirjuta: ['I got: '] + numbers arvuta + [' numbers.'],reavahetus.
{ :i Väljund kirjuta: ['number #'] + i + [':'] + (numbers positsioon: i), reavahetus.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages tükelda: [' Or '].
Väljund kirjuta: ['We serve'], reavahetus.
{ :i Väljund kirjuta: ['->'] + (beverages positsioon: i), reavahetus. } × (beverages arvuta).
Väljund kirjuta: (beverages ühenda: [',']), reavahetus.
Väljund kirjuta: (numbers ühenda: ['||']).
