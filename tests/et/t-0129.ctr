
Loend kui: ['product'] tee: {
	>> total := 1.
	ise iga: { :index :element
		total korruta: element.
	}. <- total.
}.

>> a := Loend ← 1 ; 2 ; 3.
Väljund kirjuta: a product, reavahetus.
Väljund kirjuta: (Loend ← 2 ; 4 ; 8) product, reavahetus. 
Väljund kirjuta: (Loend ← -2 ; 10) product, reavahetus. 
Väljund kirjuta: (Loend ← 0.5 ; -2) product, reavahetus. 
