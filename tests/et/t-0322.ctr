

>> Matryoshka := Objekt uus.
Matryoshka kui: ['double:'] tee: { :secret
	oma secret := secret × 2.
}.
Matryoshka kui: ['uus:'] tee: { :secret
	>> answer := Tühi.
	>> t := (secret > 255).
	Väljund kirjuta: (secret + [' | '] + t), reavahetus.
	t tõsi: {
		answer := secret.
	}, muidu: {
		answer := Matryoshka rekursiivne uus: (ise double: secret).
	}. <- answer.
}.

>> x := Matryoshka uus: 2.
