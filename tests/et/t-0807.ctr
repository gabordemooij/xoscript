# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB uus host: ['localhost'],
	kasutajanimi: ['xo'],
	parool: ['pass123'],
	andmebaasi-nimi: ['xobase'],
	ühendu.

>> otsinguparameetrid := db päring: ['SELECT %% FROM'].
{ otsinguparameetrid täida. } püüa: { :e
	Väljund kirjuta: ( e hõlmab: ['%%'] ), reavahetus.
}, käivita.
