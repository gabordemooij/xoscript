Väljund kirjuta: ['1,2,3,4,5,6,7,8,9,A,'], reavahetus.
>> Scope := Objekt uus.
Scope kui: ['initialize:'] tee: { :x oma property := x. }.
Scope kui: ['confirm'] tee: { Väljund kirjuta: [',']. }.
Scope kui: ['test'] tee: {
	Väljund kirjuta: oma property.
	ise confirm.
	( 1 = 1 ) tõsi: { Väljund kirjuta: oma property. ise confirm. }.
	( 1 = 0 ) vale: { Väljund kirjuta: oma property. ise confirm. }.
	>> y := 2. { Väljund kirjuta: oma property. ise confirm. } kuni: { y lahuta: 1. <- (y > 0). }.
	{ Väljund kirjuta: oma property. ise confirm. } × 1.
	(Loend ← 1) iga: {  Väljund kirjuta: oma property. ise confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Sõnastik uus one: ['item']) iga: { Väljund kirjuta: oma property. ise confirm. }.
	{ 1 ÷ 0. } püüa: { Väljund kirjuta: oma property. ise confirm. }, käivita.
	Väljund reavahetus.
}.
>> scope1 := Scope uus.
scope1 initialize: ['X'].
scope1 test.
>> function := { 
	oma property := ['Y'].
	Väljund kirjuta: oma property.
	ise confirm.
	( 1 = 1 ) tõsi: { Väljund kirjuta: oma property. ise confirm. }.
	( 1 = 0 ) vale: { Väljund kirjuta: oma property. ise confirm. }.
	>> y := 2. { Väljund kirjuta: oma property. ise confirm. } kuni: { y lahuta: 1. <- (y > 0). }.
	{ Väljund kirjuta: oma property. ise confirm. } × 1.
	(Loend ← 1) iga: {  Väljund kirjuta: oma property. ise confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Sõnastik uus one: ['item']) iga: { Väljund kirjuta: oma property. ise confirm. }.
	{ 1 ÷ 0. } püüa: { Väljund kirjuta: oma property. ise confirm. }, käivita.
	Väljund reavahetus.
}.
function kui: ['confirm'] tee: { Väljund kirjuta: [',']. }.
function rakenda: 1 ja: 2.
