>> V := Objekt.
V kui: ['tekst'] tee: {
	Väljund kirjuta: ['cast'], reavahetus. <- ['abc'].
}.

Väljund kirjuta: ( Programm seade: ['abc'] ), reavahetus.

# params should not get gc'ed
Programm seade: ([''] + V uus) väärtus: ([''] + V uus).

Väljund kirjuta: ( Programm seade: ['abc'] ), reavahetus.
