Arv kui: ['roman'] tee: {
	>> arv := ise kopeeri.
	>> roman := [''].
	{
		{
			(arv ≥ 1000) tõsi: {
				roman lisa-lõppu: ['Ⅿ'].
				arv lahuta: 1000.
			}, katkesta.
		
			(arv ≥ 500) tõsi: {
				roman lisa-lõppu: ['Ⅾ'].
				arv lahuta: 500.
			}, katkesta.
		
			(arv ≥ 100) tõsi: {
				roman lisa-lõppu: ['Ⅽ'].
				arv lahuta: 100.
			}, katkesta.
		
			(arv ≥ 50) tõsi: {
				roman lisa-lõppu: ['Ⅼ'].
				arv lahuta: 50.
			}, katkesta.
		
			(arv ≥ 50) tõsi: {
				roman lisa-lõppu: ['Ⅼ'].
				arv lahuta: 50.
			}, katkesta.
		
			(arv ≥ 10) tõsi: {
				roman lisa-lõppu: ['Ⅹ'].
				arv lahuta: 10.
			}, katkesta.
			
			(arv ≥ 9) tõsi: {
				roman lisa-lõppu: ['Ⅸ'].
				arv lahuta: 9.
			}, katkesta.
			
			(arv ≥ 5) tõsi: {
				roman lisa-lõppu: ['Ⅴ'].
				arv lahuta: 5.
			}, katkesta.
			
			(arv ≥ 4) tõsi: {
				roman lisa-lõppu: ['Ⅳ'].
				arv lahuta: 4.
			}, katkesta.
			
			(arv ≥ 1) tõsi: {
				roman lisa-lõppu: ['Ⅰ'].
				arv lahuta: 1.
			}, katkesta.
		} protseduur.
	} kuni: { <- arv > 0. }. <- roman.
}.

Väljund kirjuta: 1 roman, reavahetus.
Väljund kirjuta: 2 roman, reavahetus.
Väljund kirjuta: 4 roman, reavahetus.
Väljund kirjuta: 8 roman, reavahetus.
Väljund kirjuta: 16 roman, reavahetus.
Väljund kirjuta: 32 roman, reavahetus.
Väljund kirjuta: 64 roman, reavahetus.
Väljund kirjuta: 128 roman, reavahetus.
Väljund kirjuta: 256 roman, reavahetus.
Väljund kirjuta: 1024 roman, reavahetus.
