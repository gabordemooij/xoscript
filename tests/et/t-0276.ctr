>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objekt uus.
⚄ kui: ['drawFrom:length:'] tee: { :pool :arvuta
	
	>> result := [''].
	
	{
		>> index := Arv random % (pool pikkus).
		result lisa-lõppu: ( pool märk: (index + 1) ).
		
	} × arvuta. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? pikkus.
Väljund kirjuta: (['x↵'] x random pikkus).
Väljund kirjuta: (['y↵'] y ?? pikkus).

