#Linux
>> clock := Hetk uus.
clock tsoon: ['UTC-1'].
clock aasta: 1981, kuu: 1, päev: 5,
      tund: 13, minut: 15, sekund: 13.

Väljund kirjuta: clock, reavahetus.
clock tsoon: ['UTC+0'].

Väljund kirjuta: (
	(clock aasta lihtne) + ['-'] + (clock kuu) + ['-'] + (clock päev) + [' '] +
	(clock tund) + [':'] + (clock minut) + [':'] + (clock sekund) + [' '] +
	['W'] + (clock nädal) + (clock tsoon)
), reavahetus.


clock tsoon: ['UTC-1'].
Väljund kirjuta: (
	(clock aasta lihtne) + ['-'] + (clock kuu) + ['-'] + (clock päev) + [' '] +
	(clock tund) + [':'] + (clock minut) + [':'] + (clock sekund) + [' '] +
	['W'] + (clock nädal) + (clock tsoon)
), reavahetus.
