>> winery := { <- (	Sõnastik uus
		pane: 2 kohale: ['merlot'],
		pane: 3 kohale: ['malbec'],
		pane: 4 kohale: ['syrah']
	).
}.

Väljund kirjuta: (((winery käivita) - ['nothing']) arvuta), reavahetus.
Väljund kirjuta: (((winery käivita) - ['merlot']) arvuta), reavahetus.
Väljund kirjuta: (((winery käivita) - ['malbec']) arvuta), reavahetus.
Väljund kirjuta: (((winery käivita) - ['syrah']) arvuta), reavahetus.
Väljund kirjuta: (((winery käivita) - ['merlot'] - ['malbec']) arvuta), reavahetus.
Väljund kirjuta: (((winery käivita) - ['merlot'] - ['syrah']) arvuta), reavahetus.
Väljund kirjuta: (((winery käivita) - ['malbec'] -['syrah']) arvuta), reavahetus.
Väljund kirjuta: (((winery käivita) - ['malbec'] - ['syrah'] - ['merlot']) arvuta), reavahetus.

