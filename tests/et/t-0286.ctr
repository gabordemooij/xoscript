['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Väljund kirjuta: (x + y), reavahetus.

>> x := 10040.07.
>> y := 10305.60.

Väljund kirjuta: (x + y), reavahetus.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Väljund kirjuta: (x + y + z), reavahetus.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Väljund kirjuta: (x + y + z), reavahetus.

>> q := 0.1.2.

Väljund kirjuta: (q), reavahetus.

>> q := 012.

Väljund kirjuta: (q), reavahetus.
