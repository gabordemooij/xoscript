>> To-Do := Objekt uus.

To-Do kui: ['uus'] tee: {
	oma list := Loend uus.
}.

To-Do kui: ['nieuw'] tee: {
	oma list := Loend uus.
}.

To-Do kui: ['+'] tee: { :task
	oma list lisa-lõppu: task.
}.

To-Do kui: ['number of tasks?'] tee: { <-  oma list arvuta.
}.

>> todos := 
	To-Do uus 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Väljund kirjuta: ['You have $ tasks to do'] $ todos number of tasks?.
