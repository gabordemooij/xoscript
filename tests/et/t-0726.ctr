# test buffers PKI/Sign 
Server init.

>> long := ( Loend uus täida: 1000 väärtusega: ['a'] ) ühenda: [''].

# sign a message
Väljund kirjuta: ( 
	Seif allkirjasta: ['abc'] võtmega: long
), reavahetus.

Väljund kirjuta: ( 
	Seif
		kontrolli: ['abc'] 
		allkiri: long 
		võtmega: long
), reavahetus.

Väljund kirjuta: (
	Seif parooliräsi: long kontrolli: long
), reavahetus.
