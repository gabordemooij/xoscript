>> str := ['write:'].
Väljund teade: ['kirjuta:'] argumendid: (Loend ← ['Hello World']), reavahetus. 

Arv kui: ['isbetween:and:'] tee: { :a :b <- ((ise ≥ a) ja: (ise ≤ b)).
}.

str := ['isbetween:and:'].
Väljund kirjuta: (3 teade: str argumendid: (Loend ← 2 ; 8)), reavahetus.
Väljund kirjuta: (3 teade: str argumendid: (Loend ← 1 ; 2)), reavahetus.


>> CoffeeMachine := Objekt uus.
CoffeeMachine kui: ['makeCoffeeWithSugar:milk:'] tee: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Loend ← 4 ; 2.
Väljund kirjuta: ( CoffeeMachine teade: order argumendid: coffeeConfiguration ), reavahetus.
