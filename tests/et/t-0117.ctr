>> t := Tõsi.
(t = Tõsi) tõsi: { Väljund kirjuta: ['T']. }.
(t = Vale) tõsi: { Väljund kirjuta: ['F']. }.
Väljund kirjuta: ['|'].
>> t := Vale.
(t = Tõsi) tõsi: { Väljund kirjuta: ['T']. }.
(t = Vale) tõsi: { Väljund kirjuta: ['F']. }.
Väljund kirjuta: ['|'].
>> f := Tõsi.
(t = Tõsi ja: f = Vale) tõsi: { Väljund kirjuta: ['T']. }.
(t = Vale ja: f = Tõsi) tõsi: { Väljund kirjuta: ['F']. }.
Väljund kirjuta: ['|'].
>> n := Tühi.
(n Tühi?) tõsi: { Väljund kirjuta: ['T']. }.
(n Tühi?) vale: { Väljund kirjuta: ['F']. }.
Väljund kirjuta: ['|'].
(f Boolean?) tõsi: { Väljund kirjuta: ['T']. }.
(f Boolean?) vale: { Väljund kirjuta: ['F']. }.



