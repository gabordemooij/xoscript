Väljund kirjuta: ((Loend uus
	kui: ['plaque:'] tee: { :x oma o := x. },
	kui: ['plaque']  tee: { <- oma o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Loend ← 1)
	~ (Loend ← 1 ; 2)
	~ (Loend ← 1 ; 2 ; 3)
	~ (Loend ← 1 ; 2 ; 3 ; 4)
	~ (Loend ← 1 ; 2 ; 3 ; 4 ; 5)
) iga: { :i :el
	{ Väljund kirjuta: see-ülesanne. } × el arvuta.
	Väljund reavahetus.
}) plaque, reavahetus.


