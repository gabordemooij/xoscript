#Linux
>> Slurp := Objekt uus.

Slurp kui: ['uus'] tee: {
	oma str := [''].
}.

Slurp kui: ['nieuw'] tee: {
	oma str := [''].
}.

Slurp kui: ['vasta:'] tee: { :blah
		oma str lisa-lõppu: blah.
}.

Slurp kui: ['vasta:ja:'] tee: { :blah :blahah
		oma str lisa-lõppu: (blah alates: 0 pikkus: (blah pikkus - 1)).
		oma str lisa-lõppu: [' '].
		oma str lisa-lõppu: blahah.
}.

Slurp kui: ['obtain'] tee: {
	>> buffer := oma str.
	oma str := ['']. <- buffer.
}.


Väljund kirjuta: (Programm süsteem: (Slurp uus echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Fail uus: ['/tmp/from.txt'], kustuta. } püüa: { ['Empty']. }, käivita.
{ Fail uus: ['/tmp/to.txt'], kustuta. } püüa: { ['Empty']. }, käivita.


Fail uus: ['/tmp/to.txt'], olemas vale: {
	Väljund kirjuta: ['Confirmed. Target file does not exist.\
'].
}.
Fail uus: ['/tmp/from.txt'], olemas vale: {
	Väljund kirjuta: ['Confirmed. Source file does not exist.\
'].
}.



Programm süsteem: (Slurp uus touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Programm süsteem: (Slurp uus cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Fail uus: ['/tmp/to.txt'], olemas tõsi: {
	Väljund kirjuta: ['Confirmed. Target file has been created by shell.\
'].
}.


Väljund kirjuta: ['Contents of file is:'] + (Fail uus: ['/tmp/to.txt'], loe), reavahetus.
