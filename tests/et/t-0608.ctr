
>> Size := Objekt uus.
Size kui: ['is:'] tee: { :arv
	arv kui: ['+'] tee: { :arv
		>> unit := arv määratlus.
		>> factor := 1.
		
		unit
		juhtum: ['inch'] tee: { factor := 0.0833. }. <- ise + (arv * factor).
	}. <- arv.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Väljund kirjuta: plank + edge, reavahetus.
