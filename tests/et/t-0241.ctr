

Tekst kui: ['evaluate'] tee: {
	>> kood := Fail uus: ['/tmp/eval.ctr'].
	kood kirjuta: (ise tekst + ['.']).
	Programm kasuta: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Loend ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q tekst.
Väljund kirjuta: x, reavahetus.
>> y := Tühi.
(['y := '] + x ) evaluate.
Väljund kirjuta: y ? 0, reavahetus.

q := Sõnastik pane: ['\[''] kohale: ['\['quote\']'].
x := q tekst.
Väljund kirjuta: x, reavahetus.
y := Tühi.
(['y := '] + x ) evaluate.

>> q := (Sõnastik uus) pane:['\[''] kohale:['\['quote\[''].
Väljund kirjuta: y ? ['\['quote\']'], reavahetus.
