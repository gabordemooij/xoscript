

Loend kui: ['fixture:'] tee: { :f
	oma fixture := f.
}.

Loend kui: ['arvuta'] tee: { <- oma fixture.
}.

Loend kui: ['aantal'] tee: { <- oma fixture.
}.


>> x := Tühi.
{

	x := ['hello'] 
	asenda:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] märk: 2)
			)
		)
	väärtusega: (
		(['...hal'] + ['lo']) 
			suurtähed 
			lowecase 
			suurtähed 
			nihe: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Loend ← 0 ; 1 ; 4; 9 ; (Loend ← 0 ; 3; 1) ; 4
							) eelviimane
						) ? 1
					) + 
					((Loend ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					arvuta
				)
			)
	).

} × 10.
Väljund kirjuta: x, reavahetus.

