

Loend kui: ['column:'] tee: { :column
	>> result := Loend uus.
	ise iga: { :index :row
		row iga: { :index :cell
			(index = column) tõsi: { result lisa-lõppu: cell. }.
		}.
	}. <- result.
}.


>> a := Loend ←
	(Loend ← 1 ; 2 ; 3) ;
	(Loend ← 4 ; 5 ; 6) ;
	(Loend ← 7 ; 8 ; 9).

>> b := a column: 1.
Väljund kirjuta: b, reavahetus.

b := a column: 20.
Väljund kirjuta: b, reavahetus.

b := a column: -100.
Väljund kirjuta: b, reavahetus.
