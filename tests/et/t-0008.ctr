>> Greeter := Objekt uus.
Greeter kui: ['make'] tee: {
	>> greeter := Objekt uus.
	greeter kui: ['name:'] tee: { :nimi
		Väljund kirjuta: ['setting a name'].
		oma myName := nimi.
	}.
	greeter kui: ['greet'] tee: {
		Väljund kirjuta: ['Hello'].
		Väljund kirjuta: oma myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
