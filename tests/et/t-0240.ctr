# test qualifiers

>> $ := Objekt uus.

$ kui: ['vasta:'] tee: { :x
	
	>> operation := x märk: 0.
	>> valuta := x märk: 1.
	>> money := x nihe: 2.
	
	>> amount := 0.

	( operation = ['+'] ) tõsi: {
		( valuta = ['£'] ) tõsi: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Väljund kirjuta: x, reavahetus.


>> Fruit := Objekt uus.

Fruit kui: ['uus'] tee: {
	>> f := ise uus.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit kui: ['apples:'] tee: { :a oma apples := a. }.
Fruit kui: ['oranges:'] tee: { :p oma oranges := p. }.
Fruit kui: ['apples'] tee: { <- oma apples. }.
Fruit kui: ['oranges'] tee: { <- oma oranges. }.

Fruit kui: ['+'] tee: { :f
	
	>> n := Fruit uus.
	f liida: 1.
	
	n apples: (f apples + oma apples).
	n oranges:  (f oranges  + oma oranges). <- n.
}.

Fruit kui: ['tekst'] tee: { <- ( oma apples tekst + [' apples and '] + oma oranges + [' oranges'] ).
}.

Arv kui: ['apples'] tee: { <- ((Fruit uus) apples: ise).
}.

Arv kui: ['apple'] tee: { <- ((Fruit uus) apples: ise).
}.

Arv kui: ['oranges'] tee: { <- ((Fruit uus) oranges: ise).
}.




Väljund kirjuta: (1 apple + 3 oranges + 4 apples), reavahetus.


Tekst kui: ['twice'] tee: { <- ((ise tekst) + (ise tekst)).
}.



Väljund kirjuta: ['❤❤❤'] twice.



