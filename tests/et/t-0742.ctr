Väljund kirjuta: ['Test object'], reavahetus.
>> a := Objekt uus. 

a kui: ['item:'] tee: { :hexhelper
	oma hexhelper := hexhelper. 
}.

a kui: ['item'] tee: { <- oma hexhelper.
}.

a item: Hx uus.

>> old-hexhelper-address := a item prototüüp mäluaadress.
a save-as: ['/tmp/a.bin'].
Väljund kirjuta: ['========== RELOADING SNAP:'], reavahetus.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototüüp mäluaadress = old-hexhelper-address) tõsi: {
	Väljund kirjuta: ['Object link re-attached.'], reavahetus.
}.
