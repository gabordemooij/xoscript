>> x := Objekt uus.
>> y := Objekt uus.
>> z := x.
Väljund kirjuta: (x = z), reavahetus.
Väljund kirjuta: (x = y), reavahetus.
Väljund kirjuta: (x ≠ y), reavahetus.
Väljund kirjuta: (x ≠ z), reavahetus.
>> m := Hetk uus aasta: 2070, kuu: 11.
>> n := m kopeeri.
Väljund kirjuta: (m = n), reavahetus.
Väljund kirjuta: (m ≠ n), reavahetus.
Väljund kirjuta: (m võrdub: m), reavahetus.
Väljund kirjuta: (m võrdub: n), reavahetus.
n kuu: 12.
Väljund kirjuta: (m ≠ n), reavahetus.
Väljund kirjuta: (m = n), reavahetus.


