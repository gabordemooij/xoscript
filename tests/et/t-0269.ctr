#Linux

(Fail uus: ['/tmp/testje']) olemas vale: {
	Programm süsteem: ['mkdir /tmp/testje'].	
}.

(Fail uus: ['/tmp/testje/file1']) olemas vale: {
	Programm süsteem: ['touch /tmp/testje/file1'].	
}.

(Fail uus: ['/tmp/testje/folder1']) olemas vale: {
	Programm süsteem: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Fail loend: ['/tmp/testje'].

>> q := Loend uus.

l iga: { :k :v v iga: { :x :y q lisa-lõppu: y. }. }.

>> s := q tekst.

(s hõlmab: ['file1']) tõsi:   { Väljund kirjuta: ['OK'], reavahetus. }.
(s hõlmab: ['file2']) tõsi:   { Väljund kirjuta: ['XX'], reavahetus. }.
(s hõlmab: ['folder1']) tõsi: { Väljund kirjuta: ['OK'], reavahetus. }.
