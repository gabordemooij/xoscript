# test list operations


>> cakes := Loend ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes asenda: 1 pikkus: 2 väärtusega: ( Loend ← ['cinnamon'] ; ['pineapple'] ).
Väljund kirjuta: (buy ühenda: [',']), reavahetus.


>> buy := cakes asenda: 1 pikkus: 12 väärtusega: ( Loend ← ['cinnamon'] ; ['pineapple'] ).
Väljund kirjuta: (buy ühenda: [',']), reavahetus.


>> buy := cakes asenda: 2 pikkus: 10 väärtusega: ( Loend uus ).
Väljund kirjuta: (buy ühenda: [',']), reavahetus.


>> buy := cakes asenda: 0 pikkus: 1 väärtusega: ( Loend uus ).
Väljund kirjuta: (buy ühenda: [',']), reavahetus.


>> buy := cakes asenda: ['0'] pikkus: ['1'] väärtusega: ['x'].
Väljund kirjuta: (buy ühenda: [',']), reavahetus.
