

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm mäluhaldus: 0.

{ :i Väljund kirjuta: i. } × 4.
Väljund reavahetus.
{ :i Väljund kirjuta: (4 - i). } × 4.
Väljund reavahetus.
( 1 > 2 ) vale: { Väljund kirjuta: ['BLOCK 1'], reavahetus. }.
( 2 > 1 ) tõsi:  { Väljund kirjuta: ['BLOCK 2'], reavahetus. }.

>> i := 0.
{ Väljund kirjuta: i. i liida: 1. } kuni: { <- ( i < 3). }.
Väljund reavahetus.

i := 3.
{ Väljund kirjuta: i. i := i - 1. } kuni: { <- ( i > 0). }.
Väljund reavahetus.


Programm korista.

usedMemory1 := (Programm mälu ? 0).


{ :i  Väljund kirjuta: i. } × 4.
Väljund reavahetus.
{ :i  Väljund kirjuta: (4 - i). } × 4.
Väljund reavahetus.
( 1 > 2 ) vale: { Väljund kirjuta: ['BLOCK 1'], reavahetus. }.
( 2 > 1 ) tõsi:  { Väljund kirjuta: ['BLOCK 2'], reavahetus. }.

>> i := 0.
{ Väljund kirjuta: i. i liida: 1. } kuni: { <- ( i < 3). }.
Väljund reavahetus.

i := 3.
{ Väljund kirjuta: i. i := i - 1. } kuni: { <- ( i > 0). }.
Väljund reavahetus.



Programm korista.
usedMemory2 := (Programm mälu ? 0).


{ :i Väljund kirjuta: i. } × 4.
Väljund reavahetus.
{ :i Väljund kirjuta: (4 - i). } × 4.
Väljund reavahetus.
( 1 > 2 ) vale: { Väljund kirjuta: ['BLOCK 1'], reavahetus. }.
( 2 > 1 ) tõsi:  { Väljund kirjuta: ['BLOCK 2'], reavahetus. }.

>> i := 0.
{ Väljund kirjuta: i. i liida: 1. } kuni: { <- ( i < 3). }.
Väljund reavahetus.

i := 3.
{ Väljund kirjuta: i. i := i - 1. } kuni: { <- ( i > 0). }.
Väljund reavahetus.

Programm korista.
usedMemory3 := (Programm mälu ? 0).



( usedMemory1 = usedMemory2 ja: usedMemory1 = usedMemory3, ja: usedMemory2 = usedMemory3 ) tõsi: {
	Väljund kirjuta: ['No memory leaks here'].
}, vale: {
	Väljund kirjuta: ['Leaking memory...'].
}.
