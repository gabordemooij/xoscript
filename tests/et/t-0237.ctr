
Tekst kui: ['evaluate'] tee: {
	>> kood := Fail uus: ['/tmp/eval.ctr'].
	kood kirjuta: (ise tekst + ['.']).
	Programm kasuta: ['/tmp/eval.ctr'].
}.

>> map :=
	(Sõnastik uus)
	pane: ['Hi There'] kohale: ['two'],
	pane: (Loend ← ['hello'] ; ['world'] ; (Loend ← 1 ; 2; 9) ; Vale) kohale: ['one'],
	pane: ( (Sõnastik uus) pane: ['wrrld'] kohale: ['misspelled'] ) kohale: ['three'],
	pane: (Loend ← ((Sõnastik uus) pane: ['treasure'] kohale: ['hidden']) ; 2) kohale: ['four']. 
>> str := map tekst.
>> map2 := Tühi.
(['map2 := '] + str ) evaluate.
Väljund kirjuta: map2 ? ['one'] ? 0.
Väljund kirjuta: map2 ? ['one'] ? 1.
Väljund kirjuta: map2 ? ['four'] ? 0 ? ['hidden'].
Väljund kirjuta: map2 ? ['one'] ? 2 ? 2.
