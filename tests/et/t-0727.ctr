Server init.
>> f := Vorming uus: ['%d'].
>> a := Blob uus: 4.
a bytes: ( Loend uus ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob uus: 4.
b bytes: ( Loend uus ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a alates: 0 pikkus: 3, iga: { :i :byte
	Väljund kirjuta: ( f rakenda-täisarvule: byte ), reavahetus.
}.
a ^ b.
a alates: 0 pikkus: 3, iga: { :i :byte
	Väljund kirjuta: ( f rakenda-täisarvule: byte ), reavahetus.
}.
a ^ b.
a alates: 0 pikkus: 3, iga: { :i :byte
	Väljund kirjuta: ( f rakenda-täisarvule: byte ), reavahetus.
}.
a vabasta.
b vabasta.

{ a ^ Objekt. } püüa: { :e Väljund kirjuta: e, reavahetus. }, käivita.
