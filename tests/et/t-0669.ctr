# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Seif 
	parooliräsi: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Seif 
	parooliräsi: hash kontrolli: a1.
	# fail 
>> b := Seif
	parooliräsi: hash kontrolli: a2.
	# ok!

Väljund kirjuta: a, reavahetus.
Väljund kirjuta: b, reavahetus.

