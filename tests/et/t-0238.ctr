Tekst kui: ['evaluate'] tee: {
	>> kood := Fail uus: ['/tmp/eval.ctr'].
	kood kirjuta: (ise tekst + ['.']).
	Programm kasuta: ['/tmp/eval.ctr'].
}.

>> a := Loend ← 1 ; 2 ; 3.
>> b := (a tekst).

Väljund kirjuta: b, reavahetus. 
(['b := '] + b) evaluate.

Väljund kirjuta: b ? 2, reavahetus. 

Väljund kirjuta: (( Loend ← 1 ; 2 ; 3 )), reavahetus. 

Väljund kirjuta: ((Sõnastik uus) pane: 1 kohale: 2), reavahetus. 

>> x := ( (Loend ← 1 ; ( Loend ← 9 ) ; Tõsi ) ) tekst.
Väljund kirjuta: x, reavahetus. 
(['x := '] + x) evaluate.

Väljund kirjuta: x ? 1 ? 0, reavahetus. 

>> y := (Sõnastik uus) pane: (Loend ← 1) kohale: (Loend ← 2).
Väljund kirjuta: y, reavahetus. 

(['y := '] + y) tekst evaluate.

Väljund kirjuta: (y kohal: (Loend ← 2) tekst ), reavahetus.

Väljund kirjuta: (Loend uus), reavahetus. 
Väljund kirjuta: (Sõnastik uus), reavahetus. 
