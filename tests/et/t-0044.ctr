>> list := Loend uus.
list ~ ['hello'].
Väljund kirjuta: list arvuta.
list lisa-lõppu: ['world'].
Väljund kirjuta: list arvuta.
Väljund kirjuta: list võta-viimane, kirjuta: list arvuta.
list lisa-lõppu: ['there'].
Väljund kirjuta: list arvuta.
Väljund kirjuta: (list positsioon: 0), kirjuta: (list positsioon: 1).
list pane: ['xmas'] kohale: 1.
list pane: ['merry'] kohale: 0.
Väljund kirjuta: list arvuta.
Väljund kirjuta: (list positsioon: 0), kirjuta: (list positsioon: 1).
