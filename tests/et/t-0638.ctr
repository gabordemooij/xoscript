
Server init.
>> rq := HTTP-Päring uus.
Väljund kirjuta: ['HTTP-GET d[]=']  + ( rq get-loend: ['d[]'] ), reavahetus. # GET
Väljund kirjuta: ['HTTP-GET f[]=']  + ( rq get-loend: ['f[]'] ), reavahetus. # GET
Väljund kirjuta: ['HTTP-POST e[]='] + ( rq post-loend: ['e[]'] ), reavahetus. # GET
Väljund kirjuta: ['HTTP-POST c=']   + ( rq post: ['c'] ), reavahetus. # GET
Väljund kirjuta: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), reavahetus. # GET
