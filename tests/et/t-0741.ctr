Väljund kirjuta: ['Test object'], reavahetus.
>> a := Objekt uus. 

a kui: ['item:'] tee: { :octhelper
	oma octhelper := octhelper. 
}.

a kui: ['item'] tee: { <- oma octhelper.
}.

a item: Oct uus.

>> old-octhelper-address := a item prototüüp mäluaadress.
a save-as: ['/tmp/a.bin'].
Väljund kirjuta: ['========== RELOADING SNAP:'], reavahetus.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototüüp mäluaadress = old-octhelper-address) tõsi: {
	Väljund kirjuta: ['Object link re-attached.'], reavahetus.
}.
