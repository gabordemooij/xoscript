>> a := Objekt uus. 
a kui: ['greet'] tee: { Väljund kirjuta: ['welcome!'], reavahetus. }.
a kui: ['greet2'] tee: { Väljund kirjuta: ['welcome2!'], reavahetus. }.
a save-as: ['/tmp/a.bin'].

Väljund kirjuta: ['========== RELOADING SNAP:'], reavahetus.
>> b := Objekt load-from: ['/tmp/a.bin'].
b greet2.