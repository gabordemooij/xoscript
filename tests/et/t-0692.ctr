Server init.

Väljund kirjuta: (
	Muster uus: ['^\\w+$'],
	vaste: ['test@example.com'] 
), reavahetus. # 0 match, fails on @ and .

Väljund kirjuta: (
	Muster uus: ['^[^@]+@[^\.]+\.\\w+$'],
	vaste: ['test@example.com'] 
), reavahetus. # 1 match

Väljund kirjuta: (
	Muster uus: ['[^@]+@[^\.]+\.\\w+'],
	vaste: ['test@example.com'] 
), reavahetus. # 1 match

Väljund kirjuta: (
	Muster uus: ['([^@]+)@([^\.]+)\.\\w+'],
	vaste: ['test@example.com'] 
), reavahetus. # 1 match, groups dont matter

Väljund kirjuta: (
	Muster uus: ['[a-z]'],
	vaste: ['test@example.com'] 
), reavahetus. # 14 matches

Väljund kirjuta: (
	Muster uus: ['.*'],
	vaste: ['test@example.com'] 
), reavahetus. # 1 match (all)

Väljund kirjuta: (
	Muster uus: ['(.*)'],
	vaste: ['test@example.com'] 
), reavahetus. # 1 match (all)

Väljund kirjuta: (
	Muster uus: ['\\s*[^@]+@[^\.]+\.\\w+'],
	vaste: ['test@example.com'] 
), reavahetus. # 1 match, prefix space optional, gets ignored