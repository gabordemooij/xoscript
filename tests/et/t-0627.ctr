

# create a 64-bit integer for exact calculations
>> a := Int64 tekstist: ['123'].

# to string
Väljund kirjuta: a, reavahetus.

# divide
Väljund kirjuta: a / (Int64 tekstist: ['3']), reavahetus.

# multiply
Väljund kirjuta: a * (Int64 tekstist: ['2']), reavahetus.

# add
Väljund kirjuta: a + (Int64 tekstist: ['1']), reavahetus.

# subtract
Väljund kirjuta: a - (Int64 tekstist: ['2']), reavahetus.

# compare
Väljund kirjuta: ( a =   (Int64 tekstist: ['123'])), reavahetus.
Väljund kirjuta: ( a !=: (Int64 tekstist: ['124'])), reavahetus.
Väljund kirjuta: ( a <   (Int64 tekstist: ['124'])), reavahetus.
Väljund kirjuta: ( a >   (Int64 tekstist: ['122'])), reavahetus.
Väljund kirjuta: ( a >=: (Int64 tekstist: ['123'])), reavahetus.
Väljund kirjuta: ( a <=: (Int64 tekstist: ['123'])), reavahetus.





	