>> x := [' hallo '].

>> y := x suurtähed.
Väljund kirjuta: x, reavahetus.
Väljund kirjuta: (x võrdub: y), reavahetus.

>> y := x väiketähed.
Väljund kirjuta: x, reavahetus.
Väljund kirjuta: (x võrdub: y), reavahetus.

>> y := x kärbi.
Väljund kirjuta: x, reavahetus.
Väljund kirjuta: (x võrdub: y), reavahetus.

>> y := x nihe: 1.
Väljund kirjuta: x, reavahetus.
Väljund kirjuta: (x võrdub: y), reavahetus.

>> y := x alates: 1 pikkus: 2.
Väljund kirjuta: x, reavahetus.
Väljund kirjuta: (x võrdub: y), reavahetus.