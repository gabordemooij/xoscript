# test Program version

# this feature is disabled by default
Väljund kirjuta: (
	Programm võimalus: 
	['RECURSIVE_STRINTPOL']
), reavahetus.


# but if we set the time back
>> today := Hetk 
tsoon: ['CEST'],
allikast: ['2026-02-15 10:00:00'].
Programm versioon: today.

# it will be enabled like it used to be (from now on)
Väljund kirjuta: (
	Programm võimalus: 
	['RECURSIVE_STRINTPOL']
), reavahetus.