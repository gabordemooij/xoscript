60 × {
	>> x := (Arv random % 6) + 1.
	(x ≤ 6) vale: { Väljund kirjuta: ['FAIL']. }.
	(x ≥0) vale: { Väljund kirjuta: ['FAIL']. }.
	x := (Arv random % 3) + 1.
	(x < 3) vale: { Väljund kirjuta: ['FAIL']. }.
	(x>-1) vale: { Väljund kirjuta: ['FAIL']. }.
	x := ((Tõeväärtus flip) arv).
	(x = 0 või: x = 1) vale: { Väljund kirjuta: ['FAIL']. }.
	x := ((Tõsi flip) arv).
	(x = 0 või: x = 1) vale: { Väljund kirjuta: ['FAIL']. }.
	x := (Tõeväärtus flip kas: ['HEAD'] või: ['TAIL']).
	((x = ['HEAD']) või: (x = ['TAIL'])) vale: { Väljund kirjuta: ['FAIL']. }.
}.
Väljund kirjuta: ['DONE'].

