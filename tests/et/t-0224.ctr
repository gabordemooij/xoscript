
>> countries := Loend uus
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Loend uus
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods järgi: countries, iga: { :key :value
	counter liida: 1.
}.

Väljund kirjuta: (['we serve counter dishes'] counter: counter), reavahetus.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] märgid sorteeri: { :v
	counter liida: 0.
}.

Väljund kirjuta: (['we sort counter dishes'] counter: counter), reavahetus.


>> counter := 0.
{
	{
		counter liida: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Väljund kirjuta: (['we calculate counter numbers.'] counter: counter), reavahetus.

