
Väljund kirjuta: ['Break for-loop, 0-4.'], reavahetus.
{ :i
	Väljund kirjuta: ['iteration #'] + i, reavahetus.
	(i = 4) katkesta.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Väljund kirjuta: ['Break while-true loop, 0-4.'], reavahetus.
{
	Väljund kirjuta: ['iteration #'] + x, reavahetus.
	x liida: 1.
	((x < 5) mitte) katkesta.
} kuni: xIsLessThan10.

Väljund kirjuta: ['Break while-false loop, 5,4.'], reavahetus.
{
	Väljund kirjuta: ['iteration #'] + x, reavahetus.
	x lahuta: 1.
	(x = 3) katkesta.
} kuni: { <- (x > 0). }.

Väljund kirjuta: ['Break times loop, 1-4.'], reavahetus.
{ :i
	Väljund kirjuta: ['iteration #'] + i, reavahetus.
	(i = 4) katkesta.
} × 5.

Väljund kirjuta: ['Break block, dont print line.'], reavahetus.
{ Tõsi katkesta. Väljund kirjuta: ['dont write this!'], reavahetus. } käivita.

Väljund kirjuta: ['Break block, dont fire catch...'], reavahetus.
{ Tõsi katkesta. Väljund kirjuta: ['dont write this!'], reavahetus. } püüa: { Väljund kirjuta: ['Dont catch this!']. }, käivita.

Väljund kirjuta: ['Test Array each-loop: 0,1'], reavahetus.
(Loend ← 1 ; 2 ; 3) kujuta: { :i
	Väljund kirjuta: ['iteration #'] + i, reavahetus.
	(i = 1) katkesta.
}.

Väljund kirjuta: ['Test Map each-loop: c only'], reavahetus.
>> m := Sõnastik uus.
m pane: ['first'] kohale: ['a'], pane: ['second'] kohale: ['b'], pane: ['third'] kohale: ['c'].
m iga: { :k :v
	Väljund kirjuta: ['iteration'] + v + k, reavahetus.
	Tõsi katkesta.
}.

