

Programm korista.


>> Veggy := Objekt uus.
Veggy kui: ['uus'] tee: {
	>> v := ise uus.
	v init. <- v.
}.

Veggy kui: ['init'] tee: { oma veggies := 0. }.

Veggy kui: ['carrots:'] tee: { :a oma veggies := a. <- Tühi. }.
Veggy kui: ['carrots'] tee: { <- oma veggies. }.
Veggy kui: ['+'] tee: { :f
	>> n := Veggy uus.
	n carrots: (f carrots + oma veggies). <- n.
}.

Veggy kui: ['tekst'] tee: { <- oma veggies tekst.
}.

Arv kui: ['carrots'] tee: {
	>> x := Veggy uus.
	x carrots: ise. <- x.
}.

Arv kui: ['add:and:'] tee: { :a :b <- (a + b).
}.

>> q := 0 add: (3 carrots + 2 carrots) and: 4 carrots.
Väljund kirjuta: q, reavahetus.
