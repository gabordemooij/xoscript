Väljund kirjuta: ['Test object'], reavahetus.
>> a := Objekt uus. 

a kui: ['item:'] tee: { :dict
	oma dict := dict. 
}.

a kui: ['item'] tee: { <- oma dict.
}.

a item: (
Sõnastik uus
	hello: ['world']).

>> old-dict-address := a item prototüüp mäluaadress.
a save-as: ['/tmp/a.bin'].
Väljund kirjuta: ['========== RELOADING SNAP:'], reavahetus.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototüüp mäluaadress = old-dict-address) tõsi: {
	Väljund kirjuta: ['Object link re-attached.'], reavahetus.
}.

Väljund kirjuta: b item, reavahetus.
