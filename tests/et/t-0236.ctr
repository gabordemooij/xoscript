>> Slurp := Objekt uus.
Slurp kui: ['uus'] tee: {
	oma str := [''].
}.


Slurp kui: ['vasta:'] tee: { :blah
		(oma str ≠ ['']) tõsi: {
			oma str lisa-lõppu: [' '].
		}.
		oma str lisa-lõppu: blah.
}.
Slurp kui: ['vasta:ja:'] tee: { :blah :blahah
		(oma str ≠ ['']) tõsi: {
			oma str lisa-lõppu: [' '].
		}.
		(blah pikkus > 1) tõsi: {
			oma str lisa-lõppu: (blah alates: 0 pikkus: (blah pikkus - 1)).
		}, muidu: {
			oma str lisa-lõppu: blah.
		}.
		oma str lisa-lõppu: [' '].
		oma str lisa-lõppu: blahah.
}.
Slurp kui: ['obtain'] tee: {
	>> buffer := oma str.
	oma str := ['']. <- buffer.
}.

>> otsinguparameetrid := Slurp uus.
otsinguparameetrid select: ['*'], from users where: ['id = 2'].
Väljund kirjuta: (otsinguparameetrid obtain), reavahetus.
