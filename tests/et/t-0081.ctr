>> map1 := Sõnastik uus.
>> key1 := Loend uus.
>> key2 := Loend uus.

map1
	pane: ['hello'] kohale: key1,
	pane: ['world'] kohale: key2.


Väljund
	kirjuta: ['Map #1 contains: '] + (map1 kohal: key1),
	kirjuta: [' and '] + (map1 kohal: key2), reavahetus.

>> KeyeableArray := Loend uus.
KeyeableArray kui: ['toString'] tee: { <- (ise arvuta) toString.
}.

>> map2 := Sõnastik uus.
key1 := KeyeableArray uus.
key2 := KeyeableArray uus.

key1 lisa-lõppu: 1.

map2
	pane: ['hello'] kohale: key1,
	pane: ['world'] kohale: key2.

Väljund
	kirjuta: ['Map #2 contains: '] + (map2 kohal: key1),
	kirjuta: [' and '] + (map2 kohal: key2), reavahetus.
