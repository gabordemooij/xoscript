a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 astmes: 8).  
a := a + (2 astmes: -1). 
a := a + (49 ruutjuur).   
a addNum: ((Loend ← 0 ; 1) maksimum).          
a addNum: ((Loend ← 2 ; 3) miinimum).
Väljund kirjuta: a.

Programm korista.
usedMemory2 := (Programm mälu ? 0).


a := 1.
