

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm mäluhaldus: 0.

Arv kui: ['addNum:'] tee: { :x
	ise liida: x.
}.

Arv kui: ['subtractNum:'] tee: { :x
	ise lahuta: x.
}.

Arv kui: ['multiplyBy:'] tee: { :x
	ise korruta: x.
}.

Arv kui: ['divideBy:'] tee: { :x
	ise jaga: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 astmes: 8).  
a := a + (2 astmes: -1). 
a := a + (49 ruutjuur).   
a addNum: ((Loend ← 0 ; 1) maksimum).          
a addNum: ((Loend ← 2 ; 3) miinimum).
Väljund kirjuta: a.

Programm korista.

usedMemory1 := (Programm mälu ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
