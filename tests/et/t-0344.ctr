# catch-all test (practical)
>> HTML := Tekst uus.
HTML kui: ['encode:'] tee: { :tekst
	ise lisa-lõppu: (tekst
	asenda: ['&'] väärtusega: ['&amp;'], 
	asenda: ['<'] väärtusega: ['&lt;'],
	asenda: ['>'] väärtusega: ['&gt;'],
	asenda: ['"'] väärtusega: ['&quot;']).
}.
>> blog := HTML uus.
blog lisa-lõppu: ['<h1>'],
     encode: ['Koffie & Thee'],
     lisa-lõppu: ['</h1>'].
Väljund kirjuta: blog, reavahetus.


>> Roman := Arv uus.
Roman kui: ['stringy'] tee: {
	>> a := [''].
	{ a lisa-lõppu: ['I']. } × ise. <- a.
}.

>> x := Roman uus.
x liida: 3.
Väljund kirjuta: x stringy, reavahetus.

>> Quantum := Tõeväärtus uus.
Quantum kui: ['true?'] tee: { <- ['maybe True']. }.
Väljund kirjuta: (Quantum uus true?), reavahetus.

>> Nihil := Tühi uus.
Nihil kui: ['tekst'] tee: { <- ['Nihil']. }.
Väljund kirjuta: (Nihil uus), reavahetus.
