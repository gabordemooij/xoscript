Loend kui: ['kopeeri'] tee: {
	>> kopeeri := Loend uus.
	ise iga: { :arv :section
		kopeeri lisa-lõppu: section rekursiivne kopeeri.
	}. <- kopeeri.
}.

>> sheep := Loend uus ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep kopeeri.
clones iga: { :arv :sheep
	sheep lisa-lõppu: ['2'].
}.

Väljund kirjuta: sheep, reavahetus.
Väljund kirjuta: clones, reavahetus.
