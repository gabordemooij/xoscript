Väljund kirjuta: ['Test object'], reavahetus.
>> greeter := Objekt uus.
greeter kui: ['name:'] tee: { :nimi
	oma xname := nimi. 
}.
greeter kui: ['greet'] tee: {
	Väljund kirjuta: ['Hello '] + oma xname, reavahetus.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Väljund kirjuta: ['========== RELOADING SNAP:'], reavahetus.
>> b := Objekt load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
