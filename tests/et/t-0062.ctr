Tõeväärtus kui: ['xor:'] tee: { :a :b <- ((a ja: b mitte) või: (a mitte ja: b)).
}.

>> o := Objekt uus.
o kui: ['hello'] tee: { ['Empty']. }.
{ o kui: 2 tee: 3.} püüa: { :e Väljund kirjuta: e, reavahetus. }, käivita.
{ o kui: ['test'] tee: 3.} püüa: { :e Väljund kirjuta: e, reavahetus. }, käivita.
{ o kui: ['hello'] tee: { ['Empty']. }.} püüa: { :e Väljund kirjuta: e, reavahetus. }, käivita. 
{ >> z := 4 ÷ 0. } püüa: { :e Väljund kirjuta: e, reavahetus. }, käivita. 
{ (Tõsi ja: Tühi) tõsi: { Väljund kirjuta: ['X'].}. } püüa: { :e Väljund kirjuta: e, reavahetus. }, käivita. 
{ ([''] xor: 0) tõsi: { Väljund kirjuta: ['X'].}. } püüa: { :e Väljund kirjuta: e, reavahetus. }, käivita. 
{ (1 < ['2']) tõsi: { Väljund kirjuta: ['OK']. }. } püüa: { :e Väljund kirjuta: e, reavahetus. }, käivita. 
{ (1 < ['2.0']) tõsi: { Väljund kirjuta: ['OK']. }. } püüa: { :e Väljund kirjuta: e, reavahetus. }, käivita. 
{ (1 < ['x2.0']) tõsi: { Väljund kirjuta: ['NO!']. }. } püüa: { :e Väljund kirjuta: e, reavahetus. }, käivita. 
{ Väljund kirjuta: (['hello OK there'] alates: ['6'] pikkus: ['2']). } käivita. 
