>> del := conn1 päring: ['DELETE FROM book WHERE id > 0'].
{  del täida. conn1 kinnita. } püüa: { :e conn1 tühista.  }, käivita.

>> insert := conn1 päring: ['INSERT INTO book (id) VALUES(null)'].
insert täida.

>> arvuta := conn1 päring: ['SELECT COUNT(*) AS num FROM book'].
arvuta too: { :row Väljund kirjuta: row num, reavahetus. }.

# does not show up
