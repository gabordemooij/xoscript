


>> Deck := Loend uus.
Deck kui: ['print'] tee: {
        >> len := ise arvuta - 1.
        { :i
                >> len2 := ise arvuta - 1.
                Väljund kirjuta: ['len: '].
                Väljund kirjuta: len, reavahetus.
                Väljund kirjuta: ['len2: '].
                Väljund kirjuta: len2, reavahetus.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
