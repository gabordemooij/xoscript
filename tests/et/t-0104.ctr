
{ :i
	Väljund kirjuta: ['This is step #'] + ( ( i ) + 1 ), reavahetus.
} × 6.

{ :i
	Väljund kirjuta: ['This is step #'] + ( 3 - ( i ) ), reavahetus.
} × 6.

{ :i
	Väljund kirjuta: ['NEVER!'], reavahetus.
} × 0.



{ :i
	Väljund kirjuta: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), reavahetus.
} × 11.
