# test number -> string -> number
{

	>> x := Arv vahel: 0 ja: 1000000.
	>> d := Arv vahel: 1 ja: 7.
	>> e := 10 astmes: d.

	x jaga: e.
	>> y := x tekst arv.

	(x = y) vale: {
		Väljund kirjuta: x, reavahetus.
		Väljund kirjuta: y, reavahetus.
		Programm lõpp.
	}.

} * 1000.
Väljund kirjuta: ['OK'], reavahetus.