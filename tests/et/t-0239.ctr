Loend kui: ['sum'] tee: {
	>> total := 0.
	ise iga: { :index :element
		total liida: element.
	}. <- total.
}.

>> a := Tõsi.



a kui: ['tekst'] tee: {
	>> answer := Tühi.
	( ise = Tõsi ) tõsi: {
		answer := ['Yep'].
	}, muidu: {
		answer := ['Nope'].
	}. <- answer.
}.

a kui: ['arv'] tee: {
	>> answer := Tühi.
	( ise = Tõsi ) tõsi: {
		answer := 10.
	}, muidu: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b kui: ['tekst'] tee: { <- ['Devil'].
}.

b kui: ['tõeväärtus'] tee: { <- Vale.
}.


Väljund kirjuta: a, reavahetus.  
Väljund kirjuta: (90 + a), reavahetus. 
Väljund kirjuta: b, reavahetus. 
Väljund kirjuta: (Tõsi ja: b), reavahetus.

a := Loend ← ['hello'] ; ['world'] ; Tõsi ; Tühi ; 666. 
a := a + ( Loend ← 1 ).
Väljund kirjuta: a, reavahetus.
Väljund kirjuta: ((Sõnastik uus) pane: Tühi kohale: Tühi), reavahetus.
Väljund kirjuta: a sum, reavahetus. 


{
	a kui: ['tekst'] tee: { <- Tühi. }.
	a := [''] + a.
} püüa: { :error
	Väljund kirjuta: ['Error noted: '] + error, reavahetus.
}, käivita.



{
	a kui: ['arv'] tee: { <- Tühi. }.
	a := 3 × a.
} püüa: { :error
	Väljund kirjuta: ['Error noted: '] + error, reavahetus.
}, käivita.


{
	a kui: ['tõeväärtus'] tee: { <- Tühi. }.
	a := Tõsi ja: a. 
} püüa: { :error
	Väljund kirjuta: ['Error noted: '] + error, reavahetus.
}, käivita.





