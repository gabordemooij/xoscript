#Linux

 >> t := Hetk uus.
 
t tsoon: ['Europe/Amsterdam'].
t aasta: 2020, kuu: 8, päev: 2, tund: 21, minut: 2, sekund: 1.

>> a := t tund.
>> ams := t tsoon.

t tsoon: ['US/Hawaii'].
>> b := t tund.
>> hw := t tsoon.

Väljund
kirjuta: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		kas: ['later'] või: ['earlier']
	)
),
reavahetus.
 