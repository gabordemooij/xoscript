
>> a := Loend ← (Loend ← 100 ; 200 ; 300) ; (Loend ← 9 ; 8 ; 7).
Väljund kirjuta: ['at 0,1 :'].
Väljund kirjuta: a ? 0 ? 1, reavahetus. 
Väljund kirjuta: ['at 1,2 :'].
Väljund kirjuta: a ? 1 ? 2, reavahetus. 
>> menu := Sõnastik uus.
menu pane: (Loend ← ['pizza'] ; ['spaghetti']) kohale: ['Italian Cuisine'].
menu pane: (Loend ← ['bifteki'] ; ['suflaki']) kohale: ['Greek Cuisine'].
Väljund kirjuta: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), reavahetus. 
Väljund kirjuta: ['but not on the same plate.'], reavahetus.
