
>> dictionary := (
	Sõnastik uus
		pane: ['b'] kohale: ['a'],
		pane: ['a'] kohale: ['b'],
		pane: ['z'] kohale: ['x'],
		pane: ['hello'] kohale: ['hallo'],
		pane: ['human'] kohale: ['human']
).

>> comparisons := Loend uus.
dictionary iga: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a võrdle: b)
	).
}.

comparisons sorteeri: { :a :b <- ( a võrdle: b ). }.
Väljund kirjuta: ( comparisons ühenda: ['↵'] ), reavahetus.
comparisons ühenda: ['↵'].
