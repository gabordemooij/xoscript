>> Slurp := Objekt uus.

Slurp kui: ['uus'] tee: {
	oma str := [''].
}.

Slurp kui: ['vasta:'] tee: { :blah
		(oma str = ['']) tõsi: {
			oma str lisa-lõppu: blah.
		}, muidu: {
			oma str lisa-lõppu: [' '].
			oma str lisa-lõppu: blah.
		}.
}.

Slurp kui: ['vasta:ja:'] tee: { :blah :blahah
		(blah pikkus > 1) tõsi: {
			oma str lisa-lõppu: (blah alates: 0 pikkus: (blah pikkus - 1)).
		}, muidu: {
			oma str lisa-lõppu: blah.
		}.
		oma str lisa-lõppu: [' '].
		oma str lisa-lõppu: blahah.
}.

Slurp kui: ['obtain'] tee: {
	>> buffer := oma str.
	oma str := ['']. <- buffer.
}.


>> x := Slurp uus.
x + 3.
Väljund kirjuta: (x obtain), reavahetus.
x echo: ['Hello world'].
Väljund kirjuta: (x obtain), reavahetus.
x tellme: 123 and: 987.
Väljund kirjuta: (x obtain), reavahetus.
