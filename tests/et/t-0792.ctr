Server init.

>> DB := Maria-DB uus host: ['localhost'],
	kasutajanimi: ['xo'],
	parool: ['pass123'],
	andmebaasi-nimi: ['xobase'],
	ühendu.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB päring: SQL.

# now you don't have to set DB
query2 too: { :row
	Väljund kirjuta: row world, reavahetus.
}.
