>> randomizer := { :a :b
	>> miinimum := ( a < b ) kas: a või: b.
	>> maksimum := ( a > b ) kas: a või: b.
	>> x := Tühi.
	{
		x := Arv vahel: a ja: b.
		((x < miinimum) või: (x > maksimum)) tõsi: { 
			Väljund kirjuta: (['Invalid value!']).
			Programm lõpp.
		}.
	} 
	× 100. <- x.
}.
randomizer rakenda: 0 ja: 0.
