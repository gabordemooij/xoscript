{
	see-ülesanne viga: ['Dont fail.'].
	unknown doSomething.
} püüa: {
	Väljund kirjuta: ['Caught!'].
}, käivita.

{
	see-ülesanne viga: ['Dont fail.'].
	oma unknown doSomething.
} püüa: {
	Väljund kirjuta: ['Caught!'].
}, käivita.

{
	see-ülesanne viga: ['Dont fail.'].
	unknown := 122.
} püüa: {
	Väljund kirjuta: ['Caught!'].
}, käivita.


{
	see-ülesanne viga: ['Dont fail.'].
	Tõsi katkesta.
	Väljund kirjuta: ['FAIL'].
} püüa: {
	Väljund kirjuta: ['Caught!'].
}, käivita.

{
	{
		see-ülesanne viga: ['Dont fail.'].
		Tõsi katkesta.
		Väljund kirjuta: ['FAIL'].
	} püüa: { :x
		(x = ['Dont fail.']) tõsi: { see-ülesanne viga: ['Nested Caught!']. }.
	}, käivita.
} püüa: { :e
	Väljund kirjuta: e.
}, käivita.
