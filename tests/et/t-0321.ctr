# test qualifiers

Programm korista.

>> Fruit := Objekt uus.
Fruit kui: ['uus'] tee: {
	>> f := ise uus.
	f apples: 0. <- f.
}.
Fruit kui: ['apples:'] tee: { :a oma apples := a. }.
Fruit kui: ['apples'] tee: { <- oma apples. }.
Fruit kui: ['+'] tee: { :f
	>> n := Fruit uus.
	n apples: (f apples + oma apples). <- n.
}.
Arv kui: ['apples'] tee: { <- ((Fruit uus) apples: ise).
}.

Fruit kui: ['tekst'] tee: { <- oma apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Väljund kirjuta: q, reavahetus.




q := 3 apples + 4 apples.
Väljund kirjuta: q, reavahetus.



