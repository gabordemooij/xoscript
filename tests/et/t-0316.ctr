>> Grandfather := Objekt uus.
Grandfather kui: ['greet'] tee: {
	Väljund kirjuta: ['Ave!'], reavahetus.
}.
>> Father := Grandfather uus.
Father kui: ['greet'] tee: {
	Väljund kirjuta: ['Hello'], reavahetus.
	ise greet.
}.
>> Son := Father uus.
Son kui: ['greet'] tee: {
	Väljund kirjuta: ['Hi'], reavahetus.
	ise greet.
}.

Son greet.

>> Roundabout := Objekt uus.
Roundabout kui: ['circle:'] tee: { :x
	Väljund kirjuta: x, reavahetus.
	(x < 3) tõsi: { ise rekursiivne circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) tõsi: { Väljund kirjuta: x, reavahetus. x liida: 1.  increment käivita. }. }.
increment käivita.