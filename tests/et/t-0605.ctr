>> invoice := Objekt uus.
invoice kui: ['käivita'] tee: {
        oma arv := 0.
}.

invoice kui: ['arv'] tee: {
        oma arv liida: 1. <- oma arv kopeeri.
}.

>> year-invoice := invoice uus.
year-invoice kui: ['start:'] tee: { :aasta
	oma arv := aasta.
}.

year-invoice start: 202000.
Väljund kirjuta: year-invoice arv, reavahetus.
Väljund kirjuta: year-invoice arv, reavahetus.
