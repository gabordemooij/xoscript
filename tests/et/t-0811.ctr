# from:length: counts characters and survives very large numbers
>> s := ['ééééééééééééééé'].
Väljund kirjuta: (s kopeeri alates: 0 pikkus: 20), reavahetus.
Väljund kirjuta: (s kopeeri alates: 10 pikkus: 20), reavahetus.
Väljund kirjuta: (s kopeeri alates: 14 pikkus: 1), reavahetus.
Väljund kirjuta: (s kopeeri nihe: 20), reavahetus.
Väljund kirjuta: ['-'], reavahetus.
Väljund kirjuta: (['abcdef'] alates: 2 pikkus: 2), reavahetus.
Väljund kirjuta: (['abc'] alates: 1 pikkus: ['9e300'] arv), reavahetus.
Väljund kirjuta: (['abc'] alates: 1 pikkus: ['-9e300'] arv), reavahetus.
Väljund kirjuta: (['abc'] alates: ['9e300'] arv pikkus: 1), reavahetus.
Väljund kirjuta: ['-'], reavahetus.
Väljund kirjuta: (['abc'] alates: ['-9e300'] arv pikkus: 2), reavahetus.
Väljund kirjuta: (['abc'] alates: ['nan'] arv pikkus: 2), reavahetus.
Väljund kirjuta: (['abc'] alates: 0 pikkus: ['nan'] arv), reavahetus.
Väljund kirjuta: ['-'], reavahetus.
