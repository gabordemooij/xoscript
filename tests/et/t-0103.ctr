>> a := Loend ← Objekt ; Tõsi ; Vale ; Tõeväärtus ; 1 ; Arv ; ['Str'] ; Tekst ; { ['Empty']. }.
Väljund kirjuta: (a arvuta), reavahetus.
{ :i
	Väljund kirjuta: 
	['a '] + 
	((a ? i) tüüp) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Tühi?) kas: [''] või: ['NOT']) + 
	[' Nil.'],
	reavahetus.
} × (a arvuta).
Väljund kirjuta: ['but.. Nil is.. '] + ((Tühi Tühi?) kas: ['certainly NIL!'] või: ['not NIL??']), reavahetus.