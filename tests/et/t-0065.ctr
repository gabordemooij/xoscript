Arv kui: ['factorial'] tee: {
	>> total := 1.
	{ :index total korruta: (ise - (index)). } × ise. <- total.
}.
>> Printer := Objekt uus.
Printer kui: ['print:and:'] tee: { :x :y
	Väljund kirjuta: ['a='] + x + [', b='] + y, reavahetus.
}.
>> a := 4.5. >> b := a ümarda-alla.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a ümarda-üles.
Printer print: a and: b.
a := 4.5. b := a ümarda-alla.
Printer print: a and: b.
a := 4.5. b := a ümarda.
Printer print: a and: b.
a := 4.2. b := a ümarda.
Printer print: a and: b.

Väljund kirjuta: (9 jääk: 5), reavahetus.
Väljund kirjuta: -666 absoluutväärtus, reavahetus.
Väljund kirjuta: 49 ruutjuur, reavahetus.
Väljund kirjuta: (2 astmes: 3), reavahetus.
>> l := (Loend ← 9 ; 6).
Väljund kirjuta: l miinimum.

