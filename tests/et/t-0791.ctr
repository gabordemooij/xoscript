Server init.

>> DB := Maria-DB uus host: ['localhost'],
	kasutajanimi: ['xo'],
	parool: ['pass123'],
	andmebaasi-nimi: ['xobase'],
	ühendu.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> otsinguparameetrid := Maria-Päring uus: SQL.

# set database
otsinguparameetrid andmebaas: DB.

otsinguparameetrid too: { :row
	Väljund kirjuta: row world, reavahetus.
}.
