Väljund kirjuta: ['Test object'], reavahetus.
>> a := Objekt uus. 

a kui: ['item:'] tee: { :out
	oma out := out. 
}.

a kui: ['item'] tee: { <- oma out.
}.

a kui: ['greet'] tee: {
	Väljund kirjuta: ['hi from original out!'], reavahetus.
}.

a item: Väljund.

Väljund kirjuta: a item, reavahetus.

>> old-out-address := a item prototüüp mäluaadress.
a save-as: ['/tmp/a.bin'].
Väljund kirjuta: ['========== RELOADING SNAP:'], reavahetus.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototüüp mäluaadress = old-out-address) tõsi: {
	Väljund kirjuta: ['Object link re-attached.'], reavahetus.
}.

b item kirjuta: ['hello from loaded out!'], reavahetus.
b greet.
