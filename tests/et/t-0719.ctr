Server init.
>> fmt := Vorming uus: ['%#3x'].

>> blob := Blob uus: 4.
blob bytes: ( 
	Loend uus ; 0 ; 1 ; 2 ; 3
).

>> file := Fail uus: ['/tmp/blob'].
file blob: blob.
blob vabasta.

>> loe := file blob.
loe 
alates: 0 
pikkus: 4, 
tee iga: { :i :b 
	Väljund
	kirjuta: (fmt rakenda-täisarvule: b),
	reavahetus.
}.
loe vabasta.
