
Loend kui: ['sum'] tee: {
	>> total := 0.
	ise iga: { :index :element
		total liida: element.
	}. <- total.
}.

>> a := Loend ← 9 ; 8 ; 7.
Väljund kirjuta: (a sum), reavahetus. 
>> a := Loend ← 1 ; 9.
Väljund kirjuta: (a sum), reavahetus. 
>> a := Loend ← ['o'] ; 2.
Väljund kirjuta: (a sum), reavahetus. 
Väljund kirjuta: (Loend uus sum), reavahetus. 
