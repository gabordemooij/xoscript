>> repeater := Objekt uus.
repeater kui: ['vasta:'] tee: { :what
	Väljund kirjuta: what + [' '].
}.
repeater kui: ['vasta:ja:'] tee: { :what :say
	Väljund kirjuta: what, kirjuta: say + [' '].
}.
repeater kui: ['vasta:ja:ja:'] tee: { :what :say :more
	Väljund kirjuta: what, kirjuta: say, kirjuta: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
