# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Seif loo-võtmed.

# private (secret) key
>> sk := keys esimene.

# public key
>> pk := keys viimane.

# sign a message
>> sig := Seif allkirjasta: ['abc'] võtmega: sk.

# check message (ok)
Väljund kirjuta: ( 
	Seif
		kontrolli: ['abc'] 
		allkiri: sig 
		võtmega: pk 
), reavahetus.

# check message (fail)
Väljund kirjuta: ( 
	Seif 
		kontrolli: ['abd'] 
		allkiri: sig 
		võtmega: pk 
), reavahetus.