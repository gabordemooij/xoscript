
>> Rectangle := Objekt uus.

Rectangle kui: ['area'] tee: { <- oma pikkus * oma width.
}.

Rectangle kui: ['length:'] tee: { :pikkus
	oma pikkus := pikkus.
}.

Rectangle kui: ['width:'] tee: { :width
	oma width := width.
}.

Rectangle kui: ['uus'] tee: {
	# this will not result into an infinite loop
	>> rectangle := ise uus.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle uus.
Väljund kirjuta: a area, reavahetus. #0

>> b := Rectangle uus length: 2, width: 3.
Väljund kirjuta: b area, reavahetus. #6

