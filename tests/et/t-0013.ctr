
>> Animal := Objekt uus.
Animal kui: ['uus'] tee: { <- ise uus init.
}.

Animal kui: ['init'] tee: {
	oma sound := ['?'].
	oma legs := 4.
}.

>> Dog := Animal uus.
Dog kui: ['init'] tee: {
	ise init.
	oma sound := ['barks'].
}.

Animal kui: ['tekst'] tee: { <- oma legs tekst + oma sound.
}.

>> poodle := Dog uus.
Väljund kirjuta: poodle, reavahetus.

