# recursive interpolation not allowed

Väljund kirjuta: 
['recursive string interolation enabled: '] + (
	Programm võimalus: 
	['RECURSIVE_STRINTPOL']
), reavahetus.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Väljund kirjuta: a, reavahetus.


Programm võimalus: ['RECURSIVE_STRINTPOL'] luba: Tõsi.

