>> Animal := Objekt uus.
>> Factory := Objekt uus.

Animal kui: ['uus'] tee: {
	>> animal := ise uus.
	animal sound: ['?']. <- animal.
}.

Animal kui: ['sound:'] tee: { :s
	oma sound := s.
}.

Animal kui: ['sound'] tee: { <- oma sound.
}.

>> Dog := Objekt uus.
>> Cat := Objekt uus.

Dog kui: ['uus'] tee: { <- Animal uus sound: ['woof!'].
}.

Cat kui: ['uus'] tee: { <- Animal uus sound: ['meow!'].
}.

Väljund kirjuta: Dog uus sound, reavahetus.
Väljund kirjuta: Cat uus sound, reavahetus.

Factory kui: ['mix:and:'] tee: { :beast1 :beast2 <- Animal uus sound: (
		( beast1 sound alates: 0 pikkus: 2 ) +
		( beast2 sound alates: 2 pikkus: 5 )
	).
}.

Väljund kirjuta: (Factory mix: Dog uus and: Cat uus) sound, reavahetus.
