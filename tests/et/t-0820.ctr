# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Muster uus: pattern.
	p vaste: subject tee: { :m :g
		Väljund kirjuta: g arvuta, kirjuta: [' '], kirjuta: (g ühenda: ['|']), reavahetus. <- m.
	}.
}.
show rakenda: ['(a)|(b)'] ja: ['b'].
show rakenda: ['(a)|(b)'] ja: ['a'].
show rakenda: ['(x)?y'] ja: ['y'].
show rakenda: ['(x)?(y)(z)?'] ja: ['xy'].
