#Linux
>> OS := Programm seade: ['OS'].

>> clock := Hetk uus.
	
(OS = ['Haiku']) tõsi: {
	clock tsoon: ['CET'],
	aasta: 2017, kuu: 7, päev: 13,
	tund: 18, minut: 0, sekund: 0.
}, muidu: {
	clock tsoon: ['Europe/Amsterdam'],
	aasta: 2017, kuu: 7, päev: 13,
	tund: 18, minut: 0, sekund: 0.
}.

clock kui: ['tell'] tee: {
	Väljund kirjuta: ise, reavahetus.
}.


clock liida: 2    tund, tell.
clock liida: 1    tund, tell.
clock liida: 19 minut, tell.
clock liida: 1  minut, tell.
clock liida: 1  minut, tell.
clock liida: 19 sekund, tell.
clock liida: 1  sekund, tell.
clock liida: 1  sekund, tell.
clock liida: 2    aasta, tell.
clock liida: 1    aasta, tell.

(OS = ['Haiku']) tõsi: {
clock liida: 5   kuu.
clock tsoon: ['CEST'], tell.
}, muidu: {
	clock liida: 5   kuu, tell.
}.

clock liida: 1   kuu, tell.
clock liida: 19    päev, tell.
clock liida: 1    tund, tell.
clock liida: 120  yard, tell.
