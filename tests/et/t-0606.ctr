>> Point := Objekt uus.
Point kui: ['x-coordinate:'] tee: { :x oma x := x. }.
Point kui: ['y-coordinate:'] tee: { :y oma y := y. }.
Point kui: ['x-coordinate']  tee: { <- oma x kopeeri. }.
Point kui: ['y-coordinate']  tee: { <- oma y kopeeri. }.

Point kui: ['='] tee: { :other <- ( oma x = other x-coordinate
		 ja: oma y = other y-coordinate ).
}.

>> pier := Point uus x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point uus x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point uus x-coordinate: 5, y-coordinate: 6.

Väljund kirjuta: pier = town-hall, reavahetus.
Väljund kirjuta: pier = restaurant, reavahetus.
