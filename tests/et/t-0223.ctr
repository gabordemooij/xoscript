>> x := Hetk uus.
x tsoon: ['CEST'],
aasta:2017,
kuu:01,
päev:10,
tund: 10,
minut: 0,
sekund: 0.

Väljund kirjuta: x, reavahetus.

Väljund kirjuta: x aeg, reavahetus.

x liida: 1 sekund.
x liida: 2 minut.
x liida: 3 tund.
x liida: 4 päev.
x liida: 1 kuu.
x liida: 6 aasta.

Väljund kirjuta: x, reavahetus.

x lahuta: 1 sekund.
x lahuta: 2 minut.
x lahuta: 3 tund.
x lahuta: 4 päev.
x lahuta: 1 kuu.
x lahuta: 6 aasta.

Väljund kirjuta: x, reavahetus.

>> y := x kopeeri.
>> z := x.

Väljund kirjuta: y, reavahetus.
Väljund kirjuta: z, reavahetus.
Väljund kirjuta: (x tsoon = y tsoon), reavahetus.
Väljund kirjuta: (x aeg = y aeg), reavahetus.
Väljund kirjuta: (x = z), reavahetus.
Väljund kirjuta: x aasta-päev, reavahetus.
Väljund kirjuta: x nädalapäev, reavahetus.
Väljund kirjuta: x nädal, reavahetus.
