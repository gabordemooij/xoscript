# test catch-all methods
>> x13 := Objekt uus.
x13 kui: ['a'] tee: { :a Väljund kirjuta: 0, reavahetus. }.
x13 kui: ['a:'] tee: { :a Väljund kirjuta: a, reavahetus. <- 5. }.
x13 kui: ['a:b:'] tee: { :a :b Väljund kirjuta: (a + b), reavahetus. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
