


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programm mäluhaldus: 0.
>> palette := Tühi.
>> colors := Tühi.

{
palette := Sõnastik uus.
palette 
	pane: ['#F00'] kohale: ['red'],
	pane: ['#0F0'] kohale: ['green'],
	pane: ['#00F'] kohale: ['blue'].
Väljund kirjuta: ['number of RGB codes in palette: '] + ( palette arvuta ), reavahetus.
Väljund kirjuta: ['RGB code of green is: '] + ( palette ? ['green'] ), reavahetus.
colors := [''].
( palette iga: { :nimi :kood
		colors := colors + ( nimi + [':'] + kood ).
} ).
Väljund kirjuta: ['All colors in palette: '] + colors, reavahetus.
} käivita.
Programm korista.
usedMemory1 := (Programm mälu ? 0).

{
palette := Sõnastik uus.
palette 
	pane: ['#F00'] kohale: ['red'],
	pane: ['#0F0'] kohale: ['green'],
