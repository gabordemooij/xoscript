>> phrases := Loend uus
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases iga: { :_ :phrase 
	>> e := Server base64-kodeeri: phrase.
	>> d := Server base64-dekodeeri: e.
	Väljund kirjuta: (
		message kopeeri ~encoded: e, ~decoded: d
	), reavahetus.
}.
