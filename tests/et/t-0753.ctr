Väljund kirjuta: ['Test object'], reavahetus.
>> a := Objekt uus. 

a kui: ['item:'] tee: { :fmt
	oma fmt := fmt. 
}.

a kui: ['item'] tee: { <- oma fmt.
}.

a item: ( Vorming uus: ['|%s|'] ).

Väljund kirjuta: a item, reavahetus.

>> old-fmt-address := a item prototüüp mäluaadress.
a save-as: ['/tmp/a.bin'].
Väljund kirjuta: ['========== RELOADING SNAP:'], reavahetus.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototüüp mäluaadress = old-fmt-address) tõsi: {
	Väljund kirjuta: ['Object link re-attached.'], reavahetus.
}.

Väljund kirjuta: ( b item rakenda: ['hello'] ), reavahetus.
