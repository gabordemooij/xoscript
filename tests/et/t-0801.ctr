Server init.

>> db := Maria-DB uus host: ['localhost'],
	kasutajanimi: ['xo'],
	parool: ['pass123'],
	andmebaasi-nimi: ['xobase'],
	ühendu.

>> del := db päring: ['DELETE FROM book WHERE id > 0'].
{  del täida. db kinnita. } püüa: { :e db tühista.  }, käivita.

>> arvuta := db päring: ['SELECT COUNT(*) AS num FROM book'].
arvuta too: { :row Väljund kirjuta: row num, reavahetus. }.
