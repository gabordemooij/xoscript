# Test ASCII variants

# Numbers

Väljund kirjuta: (2 !=: 3), reavahetus.
Väljund kirjuta: (2 <=: 2), reavahetus.
Väljund kirjuta: (2 >=: 2), reavahetus.

# Strings

Väljund kirjuta: (['b'] >=: ['a']), reavahetus.
Väljund kirjuta: (['b'] !=: ['a']), reavahetus.
Väljund kirjuta: (['b'] <=: ['c']), reavahetus.

# Bools

Väljund kirjuta: (Tõsi !=: Vale), reavahetus.

# Objects

Väljund kirjuta: (Objekt uus !=: Objekt uus), reavahetus.

# ASCII list symbol <-:

Väljund kirjuta: (Loend <<: 1, ; 2 ; 3) arvuta = 3, reavahetus.

