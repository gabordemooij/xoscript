>> items := Sõnastik uus.
items pane: ['green'] kohale: ['color-1'].
items pane: ['orange'] kohale: ['color-2'].
items pane: ['red'] kohale: ['color-3'].
>> i := 0.
>> s := [''].
items iga: { :key :color
	Väljund kirjuta: ['color #'] + i + [' is: '] + color + [' '].
	i liida: 1.
}.
Väljund kirjuta: i + [' colors!'].
