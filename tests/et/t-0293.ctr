
>> city := Loend ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Loend ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature järgi: city.
>> cities := weather sissekanded sorteeri: { :a :b <- (a võrdle: b). }.
>> temperatures := weather väärtused sorteeri: { :a :b <- (a võrdle: b) negatiivne?. }.

Väljund kirjuta: (cities ühenda: [',']), reavahetus.
Väljund kirjuta: (temperatures ühenda: [',']), reavahetus.
