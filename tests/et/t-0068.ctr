>> w := ['A_bottle_of_Whisky and a rare steak.'].
Väljund kirjuta: ['=== Basic test, grab the bottle! ==='], reavahetus.
Väljund kirjuta: ['>']+(w kopeeri alates:2 pikkus: 6), reavahetus.
Väljund kirjuta: ['>']+(w kopeeri alates:8 pikkus: -6), reavahetus.
Väljund kirjuta: ['>']+(w kopeeri alates:2 pikkus: 6), reavahetus.
