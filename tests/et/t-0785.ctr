Väljund kirjuta: ['Test object'], reavahetus.
>> a := Objekt uus. 

a kui: ['item:'] tee: { :moment
	oma moment := moment. 
}.

a kui: ['item'] tee: { <- oma moment.
}.

>> today := Loend uus ; ( Hetk uus tsoon: ['CEST'], aasta: 2026, kuu: 7 ).
a item: today.
Väljund kirjuta: a item ? 0, reavahetus.
a save-as: ['/tmp/a.bin'].
