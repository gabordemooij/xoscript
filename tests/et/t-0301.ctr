


>> wine := Objekt uus.


wine kui: ['toString'] tee: { <- ['merlot'].
}.

wine kui: ['naarTekst'] tee: { <- ['merlot'].
}.


wine kui: ['='] tee: { :other wine <- ( ise toString = other wine ).
}.

wine kui: ['=='] tee: { :other wine <- ( ise toString = other wine ).
}.



wine
	juhtum: ['cabernet'] tee: { Väljund kirjuta: ['it's a Cabernet!']. },
	juhtum: ['syrah']    tee: { Väljund kirjuta: ['it's a Syrah!'].    },
	juhtum: ['merlot']   tee: { Väljund kirjuta: ['it's a Merlot!'].   },
	juhtum: ['malbec']   tee: { Väljund kirjuta: ['it's a Malbec!'].   }.

Väljund reavahetus.
