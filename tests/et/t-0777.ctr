#OBSD
>> dirname := [''].
{ dirname lisa-lõppu: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Programm süsteem: command.
Programm chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename lisa-lõppu: ['YYYYYYYY']. } * 20.
Fail uus: filename, kirjuta: ['sometext'].
{ Fail loend: ['/tmp/'] + dirname. } * 1000.
Väljund kirjuta: ['no crash'], reavahetus.

