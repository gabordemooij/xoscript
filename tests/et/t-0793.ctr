Server init.

>> DB := Maria-DB uus host: ['localhost'],
	kasutajanimi: ['xo'],
	parool: ['pass123'],
	andmebaasi-nimi: ['xobase'],
	ühendu.

{
	DB päring:
	['DROP TABLE movies'],
	täida.
} püüa: { Tühi. }, käivita.

DB päring:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
täida.

DB päring: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parameetrid: ( Loend uus ; ['Halloween'] ),
täida.

DB päring: ['SELECT * FROM movies'],
too: { :movie
	Väljund kirjuta: movie title, reavahetus.
}.

