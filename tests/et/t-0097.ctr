
Tekst kui: ['html'] tee: { <- (
		ise
		asenda: ['&'] väärtusega: ['&amp;'],
		asenda: ['<'] väärtusega: ['&lt;'],
		asenda: ['>'] väärtusega: ['&gt;'],
		asenda: ['"'] väärtusega: ['&quot;']
	).
}.

>> HtmlBrush := Objekt uus.

HtmlBrush kui: ['vasta:'] tee: { :tag
	Väljund kirjuta: (['<tag>↵'] tag: tag ).
}.

HtmlBrush kui: ['vasta:ja:'] tee: { :tag :content
	tag := ( tag alates: 0 pikkus: (tag pikkus - 1) ).
	Väljund kirjuta: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush kui: ['content:'] tee: { :text
	Väljund kirjuta: text html, reavahetus.
}.

HtmlBrush kui: ['attr:value:'] tee: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush uus.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
