Väljund kirjuta: ['Test object'], reavahetus.
>> cmd := Käsk uus.
Väljund kirjuta: cmd ls /tmp, reavahetus.
>> old-cmd-address := cmd prototüüp mäluaadress.
cmd save-as: ['/tmp/a.bin'].
Väljund kirjuta: ['========== RELOADING SNAP:'], reavahetus.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b prototüüp mäluaadress = old-cmd-address) tõsi: {
	Väljund kirjuta: ['Object link re-attached.'], reavahetus.
}.
Väljund kirjuta: b ls, reavahetus.


