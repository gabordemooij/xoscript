Väljund kirjuta: ['Test object'], reavahetus.
>> p := Rada /tmp.
Väljund kirjuta: p, reavahetus.
>> old-p-address := p prototüüp mäluaadress.
p save-as: ['/tmp/a.bin'].
Väljund kirjuta: ['========== RELOADING SNAP:'], reavahetus.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b prototüüp mäluaadress = old-p-address) tõsi: {
	Väljund kirjuta: ['Object link re-attached.'], reavahetus.
}.
Väljund kirjuta: b, reavahetus.
