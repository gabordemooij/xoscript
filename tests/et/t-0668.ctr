# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob uus: 8, bytes: (
	Loend uus ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Väljund kirjuta: ( utf16 dekodeeri: ['utf16le'] ), reavahetus.

utf16 vabasta.
>> utf32 := Blob uus: 13, bytes: (
	Loend uus ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Väljund kirjuta: ( utf32 dekodeeri: ['utf32be'] ), reavahetus.
utf32 vabasta.