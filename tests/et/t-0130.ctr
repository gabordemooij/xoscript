# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Programm seade: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server seo: ( Loend uus ;
 libname ; ['fopen'] ;
 ( Loend uus ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
seo: ( Loend uus ;
 Tühi ; # means same lib
 ['fread'] ;
 ( Loend uus ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Tühi ; # means same object (i.e. Stream)
 ['fread']
),
seo: (
 Loend uus ;
 Tühi ; # means same lib
 ['fwrite'] ;
 ( Loend uus ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Tühi ; # means same lib
 ['fwrite']
),
seo: (
 Loend uus ;
 Tühi ; # means same lib
 ['rewind'] ;
 ( Loend uus ; ['pointer'] ) ;
 ['int'] ;
 Tühi ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> rada := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: rada mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream teade: ['fwrite'] argumendid: (Loend uus ; str ; 1 ; 6 ; fd ).
Väljund kirjuta: bytes-written, reavahetus.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob uus: 20.

# read from file
>> bytes-read := Stream teade: ['fread'] argumendid: (Loend uus ; buf ; 1 ; 6 ; fd ).
Väljund kirjuta: bytes-read, reavahetus.
Väljund kirjuta: buf, reavahetus.

# free memory
str  vabasta.
rada vabasta.
mode vabasta.
buf  vabasta.


