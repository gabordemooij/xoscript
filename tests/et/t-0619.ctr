>> HTML := Objekt uus.
HTML kui: ['vasta:'] tee: { :tag 
	Väljund kirjuta: (['<tag>'] tag: tag), reavahetus.
}.
HTML kui: ['vasta:ja:'] tee: { :tag :html 
	Väljund kirjuta: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), reavahetus.
}.
>> html := HTML uus.
html body h1: ['header'].

