>> Animal := Objekt uus.
Animal kui: ['make'] tee: {
	>> animal := Objekt uus.
	animal kui: ['makeSound'] tee: {
		Väljund kirjuta: oma sound.
	}. <- animal.
}.
>> Cat := Objekt uus.
Cat kui: ['make'] tee: {
	>> cat := Animal make.
	cat kui: ['init'] tee: {
		oma sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
