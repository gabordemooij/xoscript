#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Muster uus: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern vaste: subject tee: { :m :x
	Väljund kirjuta: m, reavahetus.
	Väljund kirjuta: x, reavahetus. <- ['XXX'].
}.
Väljund kirjuta: result, reavahetus.