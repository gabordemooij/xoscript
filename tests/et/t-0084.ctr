>> makeAdder := { :x
	>> f := { :y <- (oma x + y). } sea: ['x'] väärtus: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i oma q pane: (oma f rakenda: (oma q ? i)) kohale: i. } 
	sea: ['q'] väärtus: array,
	sea: ['f'] väärtus: func.
	{ :i mapping rakenda: i. } × (array arvuta).
}.

>> a := Loend ← 1; 2; 3.
mapper rakenda: a ja: (makeAdder rakenda: 100).
Väljund kirjuta: (a positsioon: 0), reavahetus.
Väljund kirjuta: (a ? 1), reavahetus.
Väljund kirjuta: (a ? 2), reavahetus.
