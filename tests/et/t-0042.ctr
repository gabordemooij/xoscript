>> items := Sõnastik uus.
items pane: ['black'] kohale: ['coffee'], pane: ['earl grey'] kohale: ['tea'].
Väljund kirjuta: (items kohal: ['coffee']), kirjuta: (items kohal: ['tea']).
Väljund kirjuta: ['there are'] + items arvuta + [' items in the array.'].
items pane: ['capuccino'] kohale: ['coffee'].
Väljund kirjuta: ['Now my coffee is.. '] + (items kohal: ['coffee']).
items pane: ['aaa'] kohale: ['1'].
items pane: ['bbb'] kohale: ['2'].
Väljund kirjuta: (items kohal: ['a']).
