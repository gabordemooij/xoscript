#Linux

(Schedariu novu: ['/tmp/testje']) esiste falsu: {
	Prugramma sistema: ['mkdir /tmp/testje'].	
}.

(Schedariu novu: ['/tmp/testje/file1']) esiste falsu: {
	Prugramma sistema: ['touch /tmp/testje/file1'].	
}.

(Schedariu novu: ['/tmp/testje/folder1']) esiste falsu: {
	Prugramma sistema: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Schedariu lista: ['/tmp/testje'].

>> q := Lista novu.

l ognunu: { :k :v v ognunu: { :x :y q aghjunghje-à-a-fine: y. }. }.

>> s := q testu.

(s cuntene: ['file1']) veru:   { Esciuta scrive: ['OK'], linea-nova. }.
(s cuntene: ['file2']) veru:   { Esciuta scrive: ['XX'], linea-nova. }.
(s cuntene: ['folder1']) veru: { Esciuta scrive: ['OK'], linea-nova. }.
