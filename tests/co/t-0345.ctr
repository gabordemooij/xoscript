# test catch-all methods
>> x13 := Ughjettu novu.
x13 quandu: ['a'] fà: { :a Esciuta scrive: 0, linea-nova. }.
x13 quandu: ['a:'] fà: { :a Esciuta scrive: a, linea-nova. <- 5. }.
x13 quandu: ['a:b:'] fà: { :a :b Esciuta scrive: (a + b), linea-nova. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
