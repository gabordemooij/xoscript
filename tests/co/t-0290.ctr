# test list operations


>> cakes := Lista ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes rimpiazzà: 1 lunghezza: 2 cù: ( Lista ← ['cinnamon'] ; ['pineapple'] ).
Esciuta scrive: (buy unisce: [',']), linea-nova.


>> buy := cakes rimpiazzà: 1 lunghezza: 12 cù: ( Lista ← ['cinnamon'] ; ['pineapple'] ).
Esciuta scrive: (buy unisce: [',']), linea-nova.


>> buy := cakes rimpiazzà: 2 lunghezza: 10 cù: ( Lista novu ).
Esciuta scrive: (buy unisce: [',']), linea-nova.


>> buy := cakes rimpiazzà: 0 lunghezza: 1 cù: ( Lista novu ).
Esciuta scrive: (buy unisce: [',']), linea-nova.


>> buy := cakes rimpiazzà: ['0'] lunghezza: ['1'] cù: ['x'].
Esciuta scrive: (buy unisce: [',']), linea-nova.
