

Lista quandu: ['column:'] fà: { :column
	>> result := Lista novu.
	sè ognunu: { :index :row
		row ognunu: { :index :cell
			(index = column) veru: { result aghjunghje-à-a-fine: cell. }.
		}.
	}. <- result.
}.


>> a := Lista ←
	(Lista ← 1 ; 2 ; 3) ;
	(Lista ← 4 ; 5 ; 6) ;
	(Lista ← 7 ; 8 ; 9).

>> b := a column: 1.
Esciuta scrive: b, linea-nova.

b := a column: 20.
Esciuta scrive: b, linea-nova.

b := a column: -100.
Esciuta scrive: b, linea-nova.
