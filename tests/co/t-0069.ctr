

Testu quandu: ['html'] fà: { <- (
		sè
		rimpiazzà: ['&'] cù: ['&amp;'],
		rimpiazzà: ['<'] cù: ['&lt;'],
		rimpiazzà: ['>'] cù: ['&gt;'],
		rimpiazzà: ['"'] cù: ['&quot;']
	).
}.


Esciuta scrive: ([' left trimmed '] taglià-spazii) + [' '] + ( ['and right trimmed'] taglià-spazii) + ['!'], linea-nova.
Esciuta scrive: ['<html>"html & entities"</html>'] html.
