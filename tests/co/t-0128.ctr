
Lista quandu: ['sum'] fà: {
	>> total := 0.
	sè ognunu: { :index :element
		total aghjunghje: element.
	}. <- total.
}.

>> a := Lista ← 9 ; 8 ; 7.
Esciuta scrive: (a sum), linea-nova. 
>> a := Lista ← 1 ; 9.
Esciuta scrive: (a sum), linea-nova. 
>> a := Lista ← ['o'] ; 2.
Esciuta scrive: (a sum), linea-nova. 
Esciuta scrive: (Lista novu sum), linea-nova. 
