

Lista quandu: ['sum'] fà: {
	>> total := 0.
	sè ognunu: { :index :element
		total aghjunghje: element.
	}. <- total.
}.

Lista quandu: ['product'] fà: {
	>> total := 1.
	sè ognunu: { :index :element
		total multiplicà-per: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prugramma gestione-memoria: 0.

{

>> a := Lista ← ['hello'] ; ['world'] ; Veru ; Nunda ; 666.
a := a + ( Lista ← 1 ).
Esciuta scrive: ( ['sum: '] + ( a sum ) ), linea-nova.
Esciuta scrive: ( ['min: '] + ( a minimu ) ), linea-nova.
Esciuta scrive: ( ['max: '] + ( a massimu ) ), linea-nova.
Esciuta scrive: ( ['3rd: '] + ( a ? 2 ) ), linea-nova.
Esciuta scrive: ( ['prd: '] + ( a product ) ), linea-nova.
a urdinà: { :a :b <- (b - a). }.
a ognunu: { :i :e Esciuta scrive: ( i - 0 ), linea-nova. }.

} lancià.

Prugramma pulisce.
usedMemory1 := (Prugramma memoria ? 0).


{

>> a := Lista ← ['hello'] ; ['world'] ; Veru ; Nunda ; 666.
a := a + ( Lista ← 1 ).
Esciuta scrive: ( ['sum: '] + ( a sum ) ), linea-nova.
Esciuta scrive: ( ['min: '] + ( a minimu ) ), linea-nova.
Esciuta scrive: ( ['max: '] + ( a massimu ) ), linea-nova.
Esciuta scrive: ( ['3rd: '] + ( a ? 2 ) ), linea-nova.
Esciuta scrive: ( ['prd: '] + ( a product ) ), linea-nova.
a urdinà: { :a :b <- (b - a). }.
a ognunu: { :i :e Esciuta scrive: ( i - 0 ), linea-nova. }.

} lancià.



Prugramma pulisce.
usedMemory2 := (Prugramma memoria ? 0).


{

>> a := Lista ← ['hello'] ; ['world'] ; Veru ; Nunda ; 666.
a := a + ( Lista ← 1 ).
Esciuta scrive: ( ['sum: '] + ( a sum ) ), linea-nova.
Esciuta scrive: ( ['min: '] + ( a minimu ) ), linea-nova.
Esciuta scrive: ( ['max: '] + ( a massimu ) ), linea-nova.
Esciuta scrive: ( ['3rd: '] + ( a ? 2 ) ), linea-nova.
Esciuta scrive: ( ['prd: '] + ( a product ) ), linea-nova.
a urdinà: { :a :b <- (b - a). }.
a ognunu: { :i :e Esciuta scrive: ( i - 0 ), linea-nova. }.

} lancià.



Prugramma pulisce.
usedMemory3 := (Prugramma memoria ? 0).

( usedMemory1 = usedMemory2 è: usedMemory1 = usedMemory3, è: usedMemory2 = usedMemory3 ) veru: {
	Esciuta scrive: ['No memory leaks here'].
}, falsu: {
	Esciuta scrive: ['Leaking memory...'].
}.
