>> a := Lista ← Ughjettu ; Veru ; Falsu ; Booleanu ; 1 ; Numeru ; ['Str'] ; Testu ; { ['Empty']. }.
Esciuta scrive: (a cuntà), linea-nova.
{ :i
	Esciuta scrive: 
	['a '] + 
	((a ? i) tipu) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Nunda?) o: [''] o: ['NOT']) + 
	[' Nil.'],
	linea-nova.
} × (a cuntà).
Esciuta scrive: ['but.. Nil is.. '] + ((Nunda Nunda?) o: ['certainly NIL!'] o: ['not NIL??']), linea-nova.