>> x := 9.2.
Esciuta scrive: x codice ughjettu tipu, linea-nova.
Esciuta scrive: x codice ughjettu testu, linea-nova.

>> x := -9.2.
Esciuta scrive: x codice ughjettu tipu, linea-nova.
Esciuta scrive: x codice ughjettu testu, linea-nova.

>> x := Lista novu.
Esciuta scrive: x codice ughjettu tipu, linea-nova.
Esciuta scrive: x codice ughjettu testu, linea-nova.

>> x := Lista ← 1 ; 2.
Esciuta scrive: x codice ughjettu tipu, linea-nova.
Esciuta scrive: x codice ughjettu testu, linea-nova.

>> x := Lista ← 1 ; (Lista ← 2).
Esciuta scrive: x codice ughjettu tipu, linea-nova.
Esciuta scrive: x codice ughjettu testu, linea-nova.

>> x := Lista ← 1 ; (Lista ← 2) ; 3.
Esciuta scrive: x codice ughjettu tipu, linea-nova.
Esciuta scrive: x codice ughjettu testu, linea-nova.

>> x := Lista ← 1 ; ((Dizziunariu novu) mette:['a'] à:['b']) ; 3.
Esciuta scrive: x codice ughjettu tipu, linea-nova.
Esciuta scrive: x codice ughjettu testu, linea-nova.

>> x := Lista ← 1 ; ((Dizziunariu novu) mette:(Lista ← 9) à:['b']) ; 3.
Esciuta scrive: x codice ughjettu tipu, linea-nova.
Esciuta scrive: x codice ughjettu testu, linea-nova.

>> x := (Dizziunariu novu) mette:2 à:['1'].
Esciuta scrive: x codice ughjettu tipu, linea-nova.
Esciuta scrive: x codice ughjettu testu, linea-nova.

>> x := (Dizziunariu novu) mette:2 à:['x'].
Esciuta scrive: x codice ughjettu tipu, linea-nova.
Esciuta scrive: x codice ughjettu testu, linea-nova.

>> x := (Dizziunariu novu) mette:(Lista ← 1 ; 2) à:['x'].
Esciuta scrive: x codice ughjettu tipu, linea-nova.
Esciuta scrive: x codice ughjettu testu, linea-nova.

>> x := (Dizziunariu novu) mette:(Lista ← ((Dizziunariu novu) mette:['q'] à:['y']) ; 2) à:['x'].
Esciuta scrive: x codice ughjettu tipu, linea-nova.
Esciuta scrive: x codice ughjettu testu, linea-nova.

Esciuta scrive: ['2 + 3'] ughjettu, linea-nova.
