Esciuta scrive: ['Test object'], linea-nova.
>> a := Ughjettu novu. 

a quandu: ['item:'] fà: { :moment
	propiu moment := moment. 
}.

a quandu: ['item'] fà: { <- propiu moment.
}.

>> today := Lista novu ; ( Mumentu novu zona: ['CEST'], annu: 2026, mese: 7 ).
a item: today.
Esciuta scrive: a item ? 0, linea-nova.
a save-as: ['/tmp/a.bin'].
