# catch-all test (practical)
>> HTML := Testu novu.
HTML quandu: ['encode:'] fà: { :tekst
	sè aghjunghje-à-a-fine: (tekst
	rimpiazzà: ['&'] cù: ['&amp;'], 
	rimpiazzà: ['<'] cù: ['&lt;'],
	rimpiazzà: ['>'] cù: ['&gt;'],
	rimpiazzà: ['"'] cù: ['&quot;']).
}.
>> blog := HTML novu.
blog aghjunghje-à-a-fine: ['<h1>'],
     encode: ['Koffie & Thee'],
     aghjunghje-à-a-fine: ['</h1>'].
Esciuta scrive: blog, linea-nova.


>> Roman := Numeru novu.
Roman quandu: ['stringy'] fà: {
	>> a := [''].
	{ a aghjunghje-à-a-fine: ['I']. } × sè. <- a.
}.

>> x := Roman novu.
x aghjunghje: 3.
Esciuta scrive: x stringy, linea-nova.

>> Quantum := Booleanu novu.
Quantum quandu: ['true?'] fà: { <- ['maybe True']. }.
Esciuta scrive: (Quantum novu true?), linea-nova.

>> Nihil := Nunda novu.
Nihil quandu: ['testu'] fà: { <- ['Nihil']. }.
Esciuta scrive: (Nihil novu), linea-nova.
