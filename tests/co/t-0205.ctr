>> str := ['write:'].
Esciuta messaghju: ['scrive:'] argumenti: (Lista ← ['Hello World']), linea-nova. 

Numeru quandu: ['isbetween:and:'] fà: { :a :b <- ((sè ≥ a) è: (sè ≤ b)).
}.

str := ['isbetween:and:'].
Esciuta scrive: (3 messaghju: str argumenti: (Lista ← 2 ; 8)), linea-nova.
Esciuta scrive: (3 messaghju: str argumenti: (Lista ← 1 ; 2)), linea-nova.


>> CoffeeMachine := Ughjettu novu.
CoffeeMachine quandu: ['makeCoffeeWithSugar:milk:'] fà: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Lista ← 4 ; 2.
Esciuta scrive: ( CoffeeMachine messaghju: order argumenti: coffeeConfiguration ), linea-nova.
