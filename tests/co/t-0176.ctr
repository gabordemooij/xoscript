

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prugramma gestione-memoria: 0.

>> txt := ['Word Salad'].
Esciuta scrive: ['Text Length: '] + txt lunghezza, linea-nova.
Esciuta scrive: ['Character at 2:'] + ( txt caratteru: 2 ), linea-nova.
Esciuta scrive: (( txt truvà: ['S'] ) - 0), linea-nova.

Prugramma pulisce.

usedMemory1 := (Prugramma memoria ? 0).


txt := ['Word Salad'].
Esciuta scrive: ['Text Length: '] + txt lunghezza, linea-nova.
Esciuta scrive: ['Character at 2:'] + ( txt caratteru: 2 ), linea-nova.
Esciuta scrive: (( txt truvà: ['S'] ) - 0), linea-nova.

Prugramma pulisce.
usedMemory2 := (Prugramma memoria ? 0).


txt := ['Word Salad'].
Esciuta scrive: ['Text Length: '] + txt lunghezza, linea-nova.
Esciuta scrive: ['Character at 2:'] + ( txt caratteru: 2 ), linea-nova.
Esciuta scrive: (( txt truvà: ['S'] ) - 0), linea-nova.

Prugramma pulisce.
usedMemory3 := (Prugramma memoria ? 0).



( usedMemory1 = usedMemory2 è: usedMemory1 = usedMemory3, è: usedMemory2 = usedMemory3 ) veru: {
	Esciuta scrive: ['No memory leaks here'].
}, falsu: {
	Esciuta scrive: ['Leaking memory...'].
}.
