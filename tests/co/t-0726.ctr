# test buffers PKI/Sign 
Server init.

>> long := ( Lista novu empie: 1000 cù: ['a'] ) unisce: [''].

# sign a message
Esciuta scrive: ( 
	Cascia-forte firmà: ['abc'] cù: long
), linea-nova.

Esciuta scrive: ( 
	Cascia-forte
		verificà: ['abc'] 
		firma: long 
		cù: long
), linea-nova.

Esciuta scrive: (
	Cascia-forte riassuntu-parolla-secreta: long verificà: long
), linea-nova.
