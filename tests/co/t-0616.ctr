Lista quandu: ['cupià'] fà: {
	>> cupià := Lista novu.
	sè ognunu: { :numeru :section
		cupià aghjunghje-à-a-fine: section ricursivu cupià.
	}. <- cupià.
}.

>> sheep := Lista novu ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep cupià.
clones ognunu: { :numeru :sheep
	sheep aghjunghje-à-a-fine: ['2'].
}.

Esciuta scrive: sheep, linea-nova.
Esciuta scrive: clones, linea-nova.
