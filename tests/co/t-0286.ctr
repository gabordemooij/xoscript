['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Esciuta scrive: (x + y), linea-nova.

>> x := 10040.07.
>> y := 10305.60.

Esciuta scrive: (x + y), linea-nova.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Esciuta scrive: (x + y + z), linea-nova.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Esciuta scrive: (x + y + z), linea-nova.

>> q := 0.1.2.

Esciuta scrive: (q), linea-nova.

>> q := 012.

Esciuta scrive: (q), linea-nova.
