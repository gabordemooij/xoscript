Esciuta scrive: ['Test object'], linea-nova.
>> a := Ughjettu novu. 
a quandu: ['item:'] fà: { :int64
	propiu int64 := int64. 
}.
a quandu: ['item'] fà: { <- propiu int64.
}.
a item: ( Int64 da-testu: ['9999'] ).
Esciuta scrive: a item, linea-nova.
>> old-int64-address := a item prototipu indirizzu-di-memoria.
a save-as: ['/tmp/a.bin'].
Esciuta scrive: ['========== RELOADING SNAP:'], linea-nova.
>> b := Ughjettu load-from: ['/tmp/a.bin'].
(b item prototipu indirizzu-di-memoria = old-int64-address) veru: {
	Esciuta scrive: ['Object link re-attached.'], linea-nova.
}.
Esciuta scrive: ( b item ), linea-nova.
