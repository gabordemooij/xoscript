>> HTML := Ughjettu novu.
HTML quandu: ['risponde:'] fà: { :tag 
	Esciuta scrive: (['<tag>'] tag: tag), linea-nova.
}.
HTML quandu: ['risponde:è:'] fà: { :tag :html 
	Esciuta scrive: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), linea-nova.
}.
>> html := HTML novu.
html body h1: ['header'].

