>> Slurp := Ughjettu novu.
Slurp quandu: ['novu'] fà: {
	propiu str := [''].
}.

Slurp quandu: ['risponde:'] fà: { :blah
		(propiu str ≠ ['']) veru: {
			propiu str aghjunghje-à-a-fine: [' '].
		}.
		propiu str aghjunghje-à-a-fine: blah.
}.
Slurp quandu: ['risponde:è:'] fà: { :blah :blahah
		(propiu str ≠ ['']) veru: {
			propiu str aghjunghje-à-a-fine: [' '].
		}.
		(blah lunghezza > 1) veru: {
			propiu str aghjunghje-à-a-fine: (blah da: 0 lunghezza: (blah lunghezza - 1)).
		}, altrimenti: {
			propiu str aghjunghje-à-a-fine: blah.
		}.
		propiu str aghjunghje-à-a-fine: [' '].
		propiu str aghjunghje-à-a-fine: blahah.
}.
Slurp quandu: ['obtain'] fà: {
	>> buffer := propiu str.
	propiu str := ['']. <- buffer.
}.

>> s := Slurp novu.
s hello: ['world'].
Esciuta scrive: ( s obtain ), linea-nova.
