# database test
# see example server.xo for required config

Server init.
Esciuta scrive: ['Database test'], linea-nova.

>> db := Maria-DB novu ospite: ['localhost'],
	nome-di-utilizatore: ['xo'], parolla-secreta: ['pass123'], nome-di-basa: ['xobase'], cunnette.

Esciuta scrive: ['Can we connect? '] + db cunnessu?, linea-nova.

>> parametri-di-ricerca := db richiesta: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parametri: ( Lista novu ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  parametri-di-ricerca eseguisce. db cunfirmà. } catturà: { :e db annullà.  }, lancià.

Esciuta scrive: ['Can we insert? '] + ( parametri-di-ricerca insert-id > 0 ), linea-nova.

>> Obj := Ughjettu novu.
Obj quandu: ['retrieve-rows'] fà: {
	propiu cuntà := 0.
	>> parametri-di-ricerca :=
	db richiesta: ['SELECT * FROM book order by id desc limit 2'], 
	ricuperà: { :row 
		propiu cuntà aghjunghje: 1.
		Veru interrompe.
	}. <- propiu cuntà cupià.
}.

Esciuta scrive: ['Can we query? '] + ( Obj retrieve-rows > 0 ), linea-nova.
