>> numbers := ['1,2,3'] sparte: [','].
Esciuta scrive: ['I got: '] + numbers cuntà + [' numbers.'],linea-nova.
{ :i Esciuta scrive: ['number #'] + i + [':'] + (numbers pusizione: i), linea-nova.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages sparte: [' Or '].
Esciuta scrive: ['We serve'], linea-nova.
{ :i Esciuta scrive: ['->'] + (beverages pusizione: i), linea-nova. } × (beverages cuntà).
Esciuta scrive: (beverages unisce: [',']), linea-nova.
Esciuta scrive: (numbers unisce: ['||']).
