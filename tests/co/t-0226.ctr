# Test ASCII variants

# Numbers

Esciuta scrive: (2 !=: 3), linea-nova.
Esciuta scrive: (2 <=: 2), linea-nova.
Esciuta scrive: (2 >=: 2), linea-nova.

# Strings

Esciuta scrive: (['b'] >=: ['a']), linea-nova.
Esciuta scrive: (['b'] !=: ['a']), linea-nova.
Esciuta scrive: (['b'] <=: ['c']), linea-nova.

# Bools

Esciuta scrive: (Veru !=: Falsu), linea-nova.

# Objects

Esciuta scrive: (Ughjettu novu !=: Ughjettu novu), linea-nova.

# ASCII list symbol <-:

Esciuta scrive: (Lista <<: 1, ; 2 ; 3) cuntà = 3, linea-nova.

