
>> city := Lista ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Lista ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature à-secondu: city.
>> cities := weather entrate urdinà: { :a :b <- (a paragunà: b). }.
>> temperatures := weather valori urdinà: { :a :b <- (a paragunà: b) negativu?. }.

Esciuta scrive: (cities unisce: [',']), linea-nova.
Esciuta scrive: (temperatures unisce: [',']), linea-nova.
