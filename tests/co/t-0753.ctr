Esciuta scrive: ['Test object'], linea-nova.
>> a := Ughjettu novu. 

a quandu: ['item:'] fà: { :fmt
	propiu fmt := fmt. 
}.

a quandu: ['item'] fà: { <- propiu fmt.
}.

a item: ( Furmatu novu: ['|%s|'] ).

Esciuta scrive: a item, linea-nova.

>> old-fmt-address := a item prototipu indirizzu-di-memoria.
a save-as: ['/tmp/a.bin'].
Esciuta scrive: ['========== RELOADING SNAP:'], linea-nova.

>> b := Ughjettu load-from: ['/tmp/a.bin'].

(b item prototipu indirizzu-di-memoria = old-fmt-address) veru: {
	Esciuta scrive: ['Object link re-attached.'], linea-nova.
}.

Esciuta scrive: ( b item applicà: ['hello'] ), linea-nova.
