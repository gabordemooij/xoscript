>> Grandfather := Ughjettu novu.
Grandfather quandu: ['greet'] fà: {
	Esciuta scrive: ['Ave!'], linea-nova.
}.
>> Father := Grandfather novu.
Father quandu: ['greet'] fà: {
	Esciuta scrive: ['Hello'], linea-nova.
	sè greet.
}.
>> Son := Father novu.
Son quandu: ['greet'] fà: {
	Esciuta scrive: ['Hi'], linea-nova.
	sè greet.
}.

Son greet.

>> Roundabout := Ughjettu novu.
Roundabout quandu: ['circle:'] fà: { :x
	Esciuta scrive: x, linea-nova.
	(x < 3) veru: { sè ricursivu circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) veru: { Esciuta scrive: x, linea-nova. x aghjunghje: 1.  increment lancià. }. }.
increment lancià.