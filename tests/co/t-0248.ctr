

Testu quandu: ['evaluate'] fà: {
	>> codice := Schedariu novu: ['/tmp/eval.ctr'].
	codice scrive: sè testu + ['.'].
	Prugramma aduprà: ['/tmp/eval.ctr'].
}.

>> a := (Lista ← (
	(Dizziunariu novu)
		mette: ['domain'] à: ['mywebsite.com'],
		mette: (Lista ←
			((Dizziunariu novu)
				mette: ['home'] à: ['title'],
				mette: ['<html></html>'] à: ['body'],
				mette: ['2017-01-01'] à: ['created']
			) ;
			((Dizziunariu novu)
				mette: ['aboutus(c)'] à: ['title'],
				mette: ['<credits>Author Inc.</credits>'] à: ['body']
			)
		) à: ['pages']
	)
) testu.

Esciuta scrive: a tipu, linea-nova.
Esciuta scrive: a, linea-nova.

>> b := Nunda.
(['b := '] + a) evaluate.
Esciuta scrive: b ? 0 ? ['pages'] ? 1 ? ['body'], linea-nova.

>> c := b ? 0.
>> d := c testu.
Esciuta scrive: d tipu, linea-nova.

>> e := Nunda.
(['e := '] + d) evaluate.
Esciuta scrive: e ? ['pages'] ? 0, linea-nova.
