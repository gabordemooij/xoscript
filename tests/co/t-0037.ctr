>> a := 3.
>> b := a cupià.
a sottrae: 1.
Esciuta scrive: [' a = '] + a.
Esciuta scrive: [' b = '] + b.
a := 3.
b := a + 4.
Esciuta scrive: [' a = '] + a.
Esciuta scrive: [' b = '] + b.
>> x := 3.
>> y := x cupià.
x aghjunghje: 10.
y sottrae: 1.
Esciuta scrive: [' x = '] + x.
Esciuta scrive: [' y = '] + y.
>> q := Ughjettu novu.
q quandu: ['setProperty:'] fà: { :x
	propiu prop := x.
}.
q quandu: ['getProperty'] fà: { <- propiu prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Esciuta scrive: [' p = '] + (p getProperty).
