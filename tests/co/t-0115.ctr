{
	sta-faccenda errore: ['Dont fail.'].
	unknown doSomething.
} catturà: {
	Esciuta scrive: ['Caught!'].
}, lancià.

{
	sta-faccenda errore: ['Dont fail.'].
	propiu unknown doSomething.
} catturà: {
	Esciuta scrive: ['Caught!'].
}, lancià.

{
	sta-faccenda errore: ['Dont fail.'].
	unknown := 122.
} catturà: {
	Esciuta scrive: ['Caught!'].
}, lancià.


{
	sta-faccenda errore: ['Dont fail.'].
	Veru interrompe.
	Esciuta scrive: ['FAIL'].
} catturà: {
	Esciuta scrive: ['Caught!'].
}, lancià.

{
	{
		sta-faccenda errore: ['Dont fail.'].
		Veru interrompe.
		Esciuta scrive: ['FAIL'].
	} catturà: { :x
		(x = ['Dont fail.']) veru: { sta-faccenda errore: ['Nested Caught!']. }.
	}, lancià.
} catturà: { :e
	Esciuta scrive: e.
}, lancià.
