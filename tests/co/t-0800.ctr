Server init.

>> db := Maria-DB novu ospite: ['localhost'],
	nome-di-utilizatore: ['xo'],
	parolla-secreta: ['pass123'],
	nome-di-basa: ['xobase'],
	cunnette.

>> parametri-di-ricerca := db richiesta: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parametri: ( Lista novu ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  parametri-di-ricerca eseguisce. db cunfirmà. } catturà: { :e db annullà.  }, lancià.

Esciuta scrive: ['Can we insert? '] + ( parametri-di-ricerca insert-id > 0 ), linea-nova.
