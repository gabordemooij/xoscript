#Linux
>> OS := Prugramma parametru: ['OS'].

>> clock := Mumentu novu.
	
(OS = ['Haiku']) veru: {
	clock zona: ['CET'],
	annu: 2017, mese: 7, ghjornu: 13,
	ora: 18, minutu: 0, secondu: 0.
}, altrimenti: {
	clock zona: ['Europe/Amsterdam'],
	annu: 2017, mese: 7, ghjornu: 13,
	ora: 18, minutu: 0, secondu: 0.
}.

clock quandu: ['tell'] fà: {
	Esciuta scrive: sè, linea-nova.
}.


clock aghjunghje: 2    ora, tell.
clock aghjunghje: 1    ora, tell.
clock aghjunghje: 19 minutu, tell.
clock aghjunghje: 1  minutu, tell.
clock aghjunghje: 1  minutu, tell.
clock aghjunghje: 19 secondu, tell.
clock aghjunghje: 1  secondu, tell.
clock aghjunghje: 1  secondu, tell.
clock aghjunghje: 2    annu, tell.
clock aghjunghje: 1    annu, tell.

(OS = ['Haiku']) veru: {
clock aghjunghje: 5   mese.
clock zona: ['CEST'], tell.
}, altrimenti: {
	clock aghjunghje: 5   mese, tell.
}.

clock aghjunghje: 1   mese, tell.
clock aghjunghje: 19    ghjornu, tell.
clock aghjunghje: 1    ora, tell.
clock aghjunghje: 120  yard, tell.
