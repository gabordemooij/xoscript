Numeru quandu: ['factorial'] fà: {
	>> total := 1.
	{ :index total multiplicà-per: (sè - (index)). } × sè. <- total.
}.
>> Printer := Ughjettu novu.
Printer quandu: ['print:and:'] fà: { :x :y
	Esciuta scrive: ['a='] + x + [', b='] + y, linea-nova.
}.
>> a := 4.5. >> b := a arrutundà-inghjò.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a arrutundà-insù.
Printer print: a and: b.
a := 4.5. b := a arrutundà-inghjò.
Printer print: a and: b.
a := 4.5. b := a arrutundà.
Printer print: a and: b.
a := 4.2. b := a arrutundà.
Printer print: a and: b.

Esciuta scrive: (9 modulu: 5), linea-nova.
Esciuta scrive: -666 valore-assulutu, linea-nova.
Esciuta scrive: 49 radice-quadrata, linea-nova.
Esciuta scrive: (2 putenza: 3), linea-nova.
>> l := (Lista ← 9 ; 6).
Esciuta scrive: l minimu.

