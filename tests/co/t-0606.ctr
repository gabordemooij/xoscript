>> Point := Ughjettu novu.
Point quandu: ['x-coordinate:'] fà: { :x propiu x := x. }.
Point quandu: ['y-coordinate:'] fà: { :y propiu y := y. }.
Point quandu: ['x-coordinate']  fà: { <- propiu x cupià. }.
Point quandu: ['y-coordinate']  fà: { <- propiu y cupià. }.

Point quandu: ['='] fà: { :other <- ( propiu x = other x-coordinate
		 è: propiu y = other y-coordinate ).
}.

>> pier := Point novu x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point novu x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point novu x-coordinate: 5, y-coordinate: 6.

Esciuta scrive: pier = town-hall, linea-nova.
Esciuta scrive: pier = restaurant, linea-nova.
