
{ :i
	Esciuta scrive: ['This is step #'] + ( ( i ) + 1 ), linea-nova.
} × 6.

{ :i
	Esciuta scrive: ['This is step #'] + ( 3 - ( i ) ), linea-nova.
} × 6.

{ :i
	Esciuta scrive: ['NEVER!'], linea-nova.
} × 0.



{ :i
	Esciuta scrive: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), linea-nova.
} × 11.
