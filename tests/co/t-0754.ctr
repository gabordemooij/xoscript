Esciuta scrive: ['Test object'], linea-nova.
>> a := Ughjettu novu. 

a quandu: ['item:'] fà: { :out
	propiu out := out. 
}.

a quandu: ['item'] fà: { <- propiu out.
}.

a quandu: ['greet'] fà: {
	Esciuta scrive: ['hi from original out!'], linea-nova.
}.

a item: Esciuta.

Esciuta scrive: a item, linea-nova.

>> old-out-address := a item prototipu indirizzu-di-memoria.
a save-as: ['/tmp/a.bin'].
Esciuta scrive: ['========== RELOADING SNAP:'], linea-nova.

>> b := Ughjettu load-from: ['/tmp/a.bin'].

(b item prototipu indirizzu-di-memoria = old-out-address) veru: {
	Esciuta scrive: ['Object link re-attached.'], linea-nova.
}.

b item scrive: ['hello from loaded out!'], linea-nova.
b greet.
