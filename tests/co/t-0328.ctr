Prugramma gestione-memoria: 4.

>> Doubler := Ughjettu novu.
>> Multiplier := Ughjettu novu.
Doubler quandu: ['double:and:'] fà: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier quandu: ['multiply:and:'] fà: { :x :y <- (x × y).
}.

Esciuta scrive: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), linea-nova.
