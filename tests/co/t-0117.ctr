>> t := Veru.
(t = Veru) veru: { Esciuta scrive: ['T']. }.
(t = Falsu) veru: { Esciuta scrive: ['F']. }.
Esciuta scrive: ['|'].
>> t := Falsu.
(t = Veru) veru: { Esciuta scrive: ['T']. }.
(t = Falsu) veru: { Esciuta scrive: ['F']. }.
Esciuta scrive: ['|'].
>> f := Veru.
(t = Veru è: f = Falsu) veru: { Esciuta scrive: ['T']. }.
(t = Falsu è: f = Veru) veru: { Esciuta scrive: ['F']. }.
Esciuta scrive: ['|'].
>> n := Nunda.
(n Nunda?) veru: { Esciuta scrive: ['T']. }.
(n Nunda?) falsu: { Esciuta scrive: ['F']. }.
Esciuta scrive: ['|'].
(f Boolean?) veru: { Esciuta scrive: ['T']. }.
(f Boolean?) falsu: { Esciuta scrive: ['F']. }.



