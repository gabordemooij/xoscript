Server init.
Esciuta scrive: ['Database datetime test'], linea-nova.

>> db := Maria-DB novu ospite: ['localhost'],
	nome-di-utilizatore: ['xo'], 
	parolla-secreta: ['pass123'],
	nome-di-basa: ['xobase'],
	cunnette.

>> parametri-di-ricerca :=
db richiesta: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
ricuperà: { :row
	Esciuta scrive: row datetimetest, linea-nova.
}.
