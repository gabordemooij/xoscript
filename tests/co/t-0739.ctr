Esciuta scrive: ['Test object'], linea-nova.
>> a := Ughjettu novu. 

a quandu: ['item:'] fà: { :binhelper
	propiu binhelper := binhelper. 
}.

a quandu: ['item'] fà: { <- propiu binhelper.
}.

a item: Bin novu.

>> old-binhelper-address := a item prototipu indirizzu-di-memoria.
a save-as: ['/tmp/a.bin'].
Esciuta scrive: ['========== RELOADING SNAP:'], linea-nova.

>> b := Ughjettu load-from: ['/tmp/a.bin'].

(b item prototipu indirizzu-di-memoria = old-binhelper-address) veru: {
	Esciuta scrive: ['Object link re-attached.'], linea-nova.
}.


