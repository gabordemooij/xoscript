Esciuta scrive: ['Test object'], linea-nova.
>> cmd := Cumanda novu.
Esciuta scrive: cmd ls /tmp, linea-nova.
>> old-cmd-address := cmd prototipu indirizzu-di-memoria.
cmd save-as: ['/tmp/a.bin'].
Esciuta scrive: ['========== RELOADING SNAP:'], linea-nova.
>> b := Ughjettu load-from: ['/tmp/a.bin'].
(b prototipu indirizzu-di-memoria = old-cmd-address) veru: {
	Esciuta scrive: ['Object link re-attached.'], linea-nova.
}.
Esciuta scrive: b ls, linea-nova.


