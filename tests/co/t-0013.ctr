
>> Animal := Ughjettu novu.
Animal quandu: ['novu'] fà: { <- sè novu init.
}.

Animal quandu: ['init'] fà: {
	propiu sound := ['?'].
	propiu legs := 4.
}.

>> Dog := Animal novu.
Dog quandu: ['init'] fà: {
	sè init.
	propiu sound := ['barks'].
}.

Animal quandu: ['testu'] fà: { <- propiu legs testu + propiu sound.
}.

>> poodle := Dog novu.
Esciuta scrive: poodle, linea-nova.

