Esciuta scrive: ['Test object'], linea-nova.
>> greeter := Ughjettu novu.
greeter quandu: ['name:'] fà: { :nome
	propiu xname := nome. 
}.
greeter quandu: ['greet'] fà: {
	Esciuta scrive: ['Hello '] + propiu xname, linea-nova.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Esciuta scrive: ['========== RELOADING SNAP:'], linea-nova.
>> b := Ughjettu load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
