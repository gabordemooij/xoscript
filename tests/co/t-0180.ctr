Testu quandu: ['html'] fà: { <- (
		sè
		rimpiazzà: ['&'] cù: ['&amp;'],
		rimpiazzà: ['<'] cù: ['&lt;'],
		rimpiazzà: ['>'] cù: ['&gt;'],
		rimpiazzà: ['''] cù: ['&apos;'],
		rimpiazzà: ['"'] cù: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prugramma gestione-memoria: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Esciuta scrive: txt cupià html, linea-nova.
Esciuta scrive: txt cupià minuscule, linea-nova.
Esciuta scrive: txt cupià maiuscule, linea-nova.
} lancià.

Prugramma pulisce.

usedMemory1 := (Prugramma memoria ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Esciuta scrive: txt cupià html, linea-nova.
Esciuta scrive: txt cupià minuscule, linea-nova.
Esciuta scrive: txt cupià maiuscule, linea-nova.
} lancià.

Prugramma pulisce.
usedMemory2 := (Prugramma memoria ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Esciuta scrive: txt cupià html, linea-nova.
Esciuta scrive: txt cupià minuscule, linea-nova.
Esciuta scrive: txt cupià maiuscule, linea-nova.
} lancià.

Prugramma pulisce.
usedMemory3 := (Prugramma memoria ? 0).



( usedMemory1 = usedMemory2 è: usedMemory1 = usedMemory3, è: usedMemory2 = usedMemory3 ) veru: {
	Esciuta scrive: ['No memory leaks here'].
}, falsu: {
	Esciuta scrive: ['Leaking memory...'].
}.
