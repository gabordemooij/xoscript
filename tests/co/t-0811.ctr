# from:length: counts characters and survives very large numbers
>> s := ['ééééééééééééééé'].
Esciuta scrive: (s cupià da: 0 lunghezza: 20), linea-nova.
Esciuta scrive: (s cupià da: 10 lunghezza: 20), linea-nova.
Esciuta scrive: (s cupià da: 14 lunghezza: 1), linea-nova.
Esciuta scrive: (s cupià saltà: 20), linea-nova.
Esciuta scrive: ['-'], linea-nova.
Esciuta scrive: (['abcdef'] da: 2 lunghezza: 2), linea-nova.
Esciuta scrive: (['abc'] da: 1 lunghezza: ['9e300'] numeru), linea-nova.
Esciuta scrive: (['abc'] da: 1 lunghezza: ['-9e300'] numeru), linea-nova.
Esciuta scrive: (['abc'] da: ['9e300'] numeru lunghezza: 1), linea-nova.
Esciuta scrive: ['-'], linea-nova.
Esciuta scrive: (['abc'] da: ['-9e300'] numeru lunghezza: 2), linea-nova.
Esciuta scrive: (['abc'] da: ['nan'] numeru lunghezza: 2), linea-nova.
Esciuta scrive: (['abc'] da: 0 lunghezza: ['nan'] numeru), linea-nova.
Esciuta scrive: ['-'], linea-nova.
