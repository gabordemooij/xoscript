

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prugramma gestione-memoria: 0.

>> o := Ughjettu novu.
>> o2 := Ughjettu novu.
Esciuta scrive: o Nunda?, linea-nova.
Esciuta scrive: o tipu, linea-nova.
Esciuta scrive: ( o listessu: o ), linea-nova.
Esciuta scrive: ( o listessu: o2 ), linea-nova.
Esciuta scrive: o mè-stessu, linea-nova.
Esciuta scrive: ( o fà fattu ), linea-nova.

Prugramma pulisce.

usedMemory1 := (Prugramma memoria ? 0).


o := Ughjettu novu.
o2 := Ughjettu novu.
Esciuta scrive: o Nunda?, linea-nova.
Esciuta scrive: o tipu, linea-nova.
Esciuta scrive: ( o listessu: o ), linea-nova.
Esciuta scrive: ( o listessu: o2 ), linea-nova.
Esciuta scrive: o mè-stessu, linea-nova.
Esciuta scrive: ( o fà fattu ), linea-nova.

Prugramma pulisce.
usedMemory2 := (Prugramma memoria ? 0).


o := Ughjettu novu.
o2 := Ughjettu novu.
Esciuta scrive: o Nunda?, linea-nova.
Esciuta scrive: o tipu, linea-nova.
Esciuta scrive: ( o listessu: o ), linea-nova.
Esciuta scrive: ( o listessu: o2 ), linea-nova.
Esciuta scrive: o mè-stessu, linea-nova.
Esciuta scrive: ( o fà fattu ), linea-nova.

Prugramma pulisce.
usedMemory3 := (Prugramma memoria ? 0).



( usedMemory1 = usedMemory2 è: usedMemory1 = usedMemory3, è: usedMemory2 = usedMemory3 ) veru: {
	Esciuta scrive: ['No memory leaks here'].
}, falsu: {
	Esciuta scrive: ['Leaking memory...'].
}.
