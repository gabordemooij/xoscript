# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Mudellu novu: pattern.
	p currispundenza: subject fà: { :m :g
		Esciuta scrive: g cuntà, scrive: [' '], scrive: (g unisce: ['|']), linea-nova. <- m.
	}.
}.
show applicà: ['(a)|(b)'] è: ['b'].
show applicà: ['(a)|(b)'] è: ['a'].
show applicà: ['(x)?y'] è: ['y'].
show applicà: ['(x)?(y)(z)?'] è: ['xy'].
