# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Prugramma shell-escape: ['abc'].
Esciuta scrive: c, linea-nova.
Esciuta scrive: ( Prugramma sistema: ['echo '] + c ), linea-nova.

c := Prugramma shell-escape: ['a'b'c'].
Esciuta scrive: c, linea-nova.
Esciuta scrive: ( Prugramma sistema: ['echo '] + c ), linea-nova.

c := Prugramma shell-escape: ['a\'c'].
Esciuta scrive: c, linea-nova.
Esciuta scrive: ( Prugramma sistema: ['echo '] + c ), linea-nova.