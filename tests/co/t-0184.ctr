

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prugramma gestione-memoria: 0.

Numeru quandu: ['addNum:'] fà: { :x
	sè aghjunghje: x.
}.

Numeru quandu: ['subtractNum:'] fà: { :x
	sè sottrae: x.
}.

Numeru quandu: ['multiplyBy:'] fà: { :x
	sè multiplicà-per: x.
}.

Numeru quandu: ['divideBy:'] fà: { :x
	sè divide-per: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 putenza: 8).  
a := a + (2 putenza: -1). 
a := a + (49 radice-quadrata).   
a addNum: ((Lista ← 0 ; 1) massimu).          
a addNum: ((Lista ← 2 ; 3) minimu).
Esciuta scrive: a.

Prugramma pulisce.

usedMemory1 := (Prugramma memoria ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 putenza: 8).  
a := a + (2 putenza: -1). 
a := a + (49 radice-quadrata).   
a addNum: ((Lista ← 0 ; 1) massimu).          
a addNum: ((Lista ← 2 ; 3) minimu).
Esciuta scrive: a.

Prugramma pulisce.
usedMemory2 := (Prugramma memoria ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 putenza: 8).  
a := a + (2 putenza: -1). 
a := a + (49 radice-quadrata).   
a addNum: ((Lista ← 0 ; 1) massimu).          
a addNum: ((Lista ← 2 ; 3) minimu).
Esciuta scrive: a.

Prugramma pulisce.
usedMemory3 := (Prugramma memoria ? 0).



( usedMemory1 = usedMemory2 è: usedMemory1 = usedMemory3, è: usedMemory2 = usedMemory3 ) veru: {
	Esciuta scrive: ['No memory leaks here'].
}, falsu: {
	Esciuta scrive: ['Leaking memory...'].
}.
