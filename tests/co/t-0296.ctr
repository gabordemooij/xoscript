
>> shop := (Dizziunariu novu
	mette: ['magazine'] à: ['books'],
	mette: ['computer'] à: ['electronics'],
	mette: ['lipstick'] à: ['cosmetics']
).
Esciuta scrive: (shop hà: ['computer']), linea-nova. 
Esciuta scrive: (shop hà: ['sausage']), linea-nova. 
Esciuta scrive: (shop hà: ['computers']), linea-nova. 
Esciuta scrive: (shop hà: ['compute']), linea-nova. 
Esciuta scrive: (shop hà: ['2computer']), linea-nova. 
