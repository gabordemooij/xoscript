
>> dictionary := (
	Dizziunariu novu
		mette: ['b'] à: ['a'],
		mette: ['a'] à: ['b'],
		mette: ['z'] à: ['x'],
		mette: ['hello'] à: ['hallo'],
		mette: ['human'] à: ['human']
).

>> comparisons := Lista novu.
dictionary ognunu: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a paragunà: b)
	).
}.

comparisons urdinà: { :a :b <- ( a paragunà: b ). }.
Esciuta scrive: ( comparisons unisce: ['↵'] ), linea-nova.
comparisons unisce: ['↵'].
