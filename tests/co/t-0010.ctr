>> Animal := Ughjettu novu.
Animal quandu: ['make'] fà: {
	>> animal := Ughjettu novu.
	animal quandu: ['makeSound'] fà: {
		Esciuta scrive: propiu sound.
	}. <- animal.
}.
>> Cat := Ughjettu novu.
Cat quandu: ['make'] fà: {
	>> cat := Animal make.
	cat quandu: ['init'] fà: {
		propiu sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
