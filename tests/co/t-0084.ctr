>> makeAdder := { :x
	>> f := { :y <- (propiu x + y). } definisce: ['x'] valore: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i propiu q mette: (propiu f applicà: (propiu q ? i)) à: i. } 
	definisce: ['q'] valore: array,
	definisce: ['f'] valore: func.
	{ :i mapping applicà: i. } × (array cuntà).
}.

>> a := Lista ← 1; 2; 3.
mapper applicà: a è: (makeAdder applicà: 100).
Esciuta scrive: (a pusizione: 0), linea-nova.
Esciuta scrive: (a ? 1), linea-nova.
Esciuta scrive: (a ? 2), linea-nova.
