Numeru quandu: ['roman'] fà: {
	>> numeru := sè cupià.
	>> roman := [''].
	{
		{
			(numeru ≥ 1000) veru: {
				roman aghjunghje-à-a-fine: ['Ⅿ'].
				numeru sottrae: 1000.
			}, interrompe.
		
			(numeru ≥ 500) veru: {
				roman aghjunghje-à-a-fine: ['Ⅾ'].
				numeru sottrae: 500.
			}, interrompe.
		
			(numeru ≥ 100) veru: {
				roman aghjunghje-à-a-fine: ['Ⅽ'].
				numeru sottrae: 100.
			}, interrompe.
		
			(numeru ≥ 50) veru: {
				roman aghjunghje-à-a-fine: ['Ⅼ'].
				numeru sottrae: 50.
			}, interrompe.
		
			(numeru ≥ 50) veru: {
				roman aghjunghje-à-a-fine: ['Ⅼ'].
				numeru sottrae: 50.
			}, interrompe.
		
			(numeru ≥ 10) veru: {
				roman aghjunghje-à-a-fine: ['Ⅹ'].
				numeru sottrae: 10.
			}, interrompe.
			
			(numeru ≥ 9) veru: {
				roman aghjunghje-à-a-fine: ['Ⅸ'].
				numeru sottrae: 9.
			}, interrompe.
			
			(numeru ≥ 5) veru: {
				roman aghjunghje-à-a-fine: ['Ⅴ'].
				numeru sottrae: 5.
			}, interrompe.
			
			(numeru ≥ 4) veru: {
				roman aghjunghje-à-a-fine: ['Ⅳ'].
				numeru sottrae: 4.
			}, interrompe.
			
			(numeru ≥ 1) veru: {
				roman aghjunghje-à-a-fine: ['Ⅰ'].
				numeru sottrae: 1.
			}, interrompe.
		} prucedura.
	} mentre: { <- numeru > 0. }. <- roman.
}.

Esciuta scrive: 1 roman, linea-nova.
Esciuta scrive: 2 roman, linea-nova.
Esciuta scrive: 4 roman, linea-nova.
Esciuta scrive: 8 roman, linea-nova.
Esciuta scrive: 16 roman, linea-nova.
Esciuta scrive: 32 roman, linea-nova.
Esciuta scrive: 64 roman, linea-nova.
Esciuta scrive: 128 roman, linea-nova.
Esciuta scrive: 256 roman, linea-nova.
Esciuta scrive: 1024 roman, linea-nova.
