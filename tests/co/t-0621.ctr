>> phrases := Lista novu
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases ognunu: { :_ :phrase 
	>> e := Server base64-cudificà: phrase.
	>> d := Server base64-decudificà: e.
	Esciuta scrive: (
		message cupià ~encoded: e, ~decoded: d
	), linea-nova.
}.
