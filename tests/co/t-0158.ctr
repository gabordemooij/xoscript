>> x := [' hallo '].

>> y := x maiuscule.
Esciuta scrive: x, linea-nova.
Esciuta scrive: (x listessu: y), linea-nova.

>> y := x minuscule.
Esciuta scrive: x, linea-nova.
Esciuta scrive: (x listessu: y), linea-nova.

>> y := x taglià-spazii.
Esciuta scrive: x, linea-nova.
Esciuta scrive: (x listessu: y), linea-nova.

>> y := x saltà: 1.
Esciuta scrive: x, linea-nova.
Esciuta scrive: (x listessu: y), linea-nova.

>> y := x da: 1 lunghezza: 2.
Esciuta scrive: x, linea-nova.
Esciuta scrive: (x listessu: y), linea-nova.