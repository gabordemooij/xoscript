

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prugramma gestione-memoria: 0.

>> a := Lista ← ['hello'] ; ['world'] ; Veru ; Nunda ; 666.
a fà caccià-ultimu caccià-primu aghjunghje-à-u-principiu: ['hi'], aghjunghje-à-a-fine: 999, fattu.
Esciuta scrive: ( a unisce: [','] ), linea-nova.

Prugramma pulisce.
usedMemory1 := (Prugramma memoria ? 0).


a := Lista ← ['hello'] ; ['world'] ; Veru ; Nunda ; 666.
a caccià-ultimu. a caccià-primu. a aghjunghje-à-u-principiu: ['hi'], aghjunghje-à-a-fine: 999.
Esciuta scrive: ( a unisce: [','] ), linea-nova.


Prugramma pulisce.
usedMemory2 := (Prugramma memoria ? 0).


a := Lista ← ['hello'] ; ['world'] ; Veru ; Nunda ; 666.
a fà caccià-ultimu caccià-primu aghjunghje-à-u-principiu: ['hi'], aghjunghje-à-a-fine: 999, fattu.
Esciuta scrive: ( a unisce: [','] ), linea-nova.


Prugramma pulisce.
usedMemory3 := (Prugramma memoria ? 0).



( usedMemory1 = usedMemory2 è: usedMemory1 = usedMemory3, è: usedMemory2 = usedMemory3 ) veru: {
	Esciuta scrive: ['No memory leaks here'].
}, falsu: {
	Esciuta scrive: ['Leaking memory...'].
}.
