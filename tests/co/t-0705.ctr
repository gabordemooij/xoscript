

>> obj := Ughjettu novu.

obj quandu: ['greet'] fà: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj quandu: ['task'] fà: {
	propiu property := 123.
	{
		# try binds self/own to object instead of block
		Esciuta scrive: sè greet.
		Esciuta scrive: propiu property.
		1 / 0.
	} catturà: {
		Esciuta scrive: sè greet.
		Esciuta scrive: propiu property.
		Esciuta scrive: ['ok'].
	}, pruvà.
}.

obj task.