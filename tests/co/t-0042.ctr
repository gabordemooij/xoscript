>> items := Dizziunariu novu.
items mette: ['black'] à: ['coffee'], mette: ['earl grey'] à: ['tea'].
Esciuta scrive: (items à: ['coffee']), scrive: (items à: ['tea']).
Esciuta scrive: ['there are'] + items cuntà + [' items in the array.'].
items mette: ['capuccino'] à: ['coffee'].
Esciuta scrive: ['Now my coffee is.. '] + (items à: ['coffee']).
items mette: ['aaa'] à: ['1'].
items mette: ['bbb'] à: ['2'].
Esciuta scrive: (items à: ['a']).
