# compliance test

# use international numbers

Esciuta scrive: ['1000 -> '].
Esciuta scrive: 1000, linea-nova. #1000

Esciuta scrive: ['1.5 -> '].
Esciuta scrive: 1.5, linea-nova.  #1.5

Esciuta scrive: ['1001.5 -> '].
Esciuta scrive: 1.5 + 1000, linea-nova. #1001.5

# use 0-indexed arrays
>> x := Lista novu ; 1 ; 2 ; 3.
>> y := Lista novu ; ['a'] ; ['b'] ; ['c'].

Esciuta scrive: ['1 -> '].
Esciuta scrive: x ? 0, linea-nova. #1

Esciuta scrive: ['1 -> '].
Esciuta scrive: (x à: 0), linea-nova. #1

Esciuta scrive: ['1 -> '].
Esciuta scrive: x primu, linea-nova. #1

Esciuta scrive: ['3 -> '].
Esciuta scrive: x ultimu, linea-nova. #3

Esciuta scrive: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Esciuta scrive: (x à-secondu: y), linea-nova.

Esciuta scrive: ['1 -> '].
Esciuta scrive: (x da: 0 lunghezza: 1) primu, linea-nova. #1

Esciuta scrive: ['0 -> '].
Esciuta scrive: (x truvà: 1), linea-nova. #0

x mette: 9 à: 0.

Esciuta scrive: ['9 -> '].
Esciuta scrive: (x à: 0), linea-nova. #9

x aghjunghje-à-u-principiu: 8.
Esciuta scrive: ['8 -> '].
Esciuta scrive: (x à: 0), linea-nova. #9


x aghjunghje-à-a-fine: 10.
Esciuta scrive: ['10 -> '].
Esciuta scrive: (x à: 4), linea-nova. #10








