

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prugramma gestione-memoria: 0.

>> txt := ['Word Salad'].
Esciuta scrive: ( txt cupià da: 5 lunghezza: 5 ).
Esciuta scrive: ( txt cupià saltà: 5, taglià-spazii ), linea-nova.

Prugramma pulisce.

usedMemory1 := (Prugramma memoria ? 0).


txt := ['Word Salad'].
Esciuta scrive: ( txt cupià da: 5 lunghezza: 5 ).
Esciuta scrive: ( txt cupià saltà: 5, taglià-spazii ), linea-nova.

