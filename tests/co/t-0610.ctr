
>> Rectangle := Ughjettu novu.

Rectangle quandu: ['area'] fà: { <- propiu lunghezza * propiu width.
}.

Rectangle quandu: ['length:'] fà: { :lunghezza
	propiu lunghezza := lunghezza.
}.

Rectangle quandu: ['width:'] fà: { :width
	propiu width := width.
}.

Rectangle quandu: ['novu'] fà: {
	# this will not result into an infinite loop
	>> rectangle := sè novu.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle novu.
Esciuta scrive: a area, linea-nova. #0

>> b := Rectangle novu length: 2, width: 3.
Esciuta scrive: b area, linea-nova. #6

