Esciuta scrive: ['Test object'], linea-nova.
>> a := Ughjettu novu. 

a quandu: ['item:'] fà: { :hexhelper
	propiu hexhelper := hexhelper. 
}.

a quandu: ['item'] fà: { <- propiu hexhelper.
}.

a item: Hx novu.

>> old-hexhelper-address := a item prototipu indirizzu-di-memoria.
a save-as: ['/tmp/a.bin'].
Esciuta scrive: ['========== RELOADING SNAP:'], linea-nova.

>> b := Ughjettu load-from: ['/tmp/a.bin'].

(b item prototipu indirizzu-di-memoria = old-hexhelper-address) veru: {
	Esciuta scrive: ['Object link re-attached.'], linea-nova.
}.
