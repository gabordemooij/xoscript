# test qualifiers

>> $ := Ughjettu novu.

$ quandu: ['risponde:'] fà: { :x
	
	>> operation := x caratteru: 0.
	>> valuta := x caratteru: 1.
	>> money := x saltà: 2.
	
	>> amount := 0.

	( operation = ['+'] ) veru: {
		( valuta = ['£'] ) veru: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Esciuta scrive: x, linea-nova.


>> Fruit := Ughjettu novu.

Fruit quandu: ['novu'] fà: {
	>> f := sè novu.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit quandu: ['apples:'] fà: { :a propiu apples := a. }.
Fruit quandu: ['oranges:'] fà: { :p propiu oranges := p. }.
Fruit quandu: ['apples'] fà: { <- propiu apples. }.
Fruit quandu: ['oranges'] fà: { <- propiu oranges. }.

Fruit quandu: ['+'] fà: { :f
	
	>> n := Fruit novu.
	f aghjunghje: 1.
	
	n apples: (f apples + propiu apples).
	n oranges:  (f oranges  + propiu oranges). <- n.
}.

Fruit quandu: ['testu'] fà: { <- ( propiu apples testu + [' apples and '] + propiu oranges + [' oranges'] ).
}.

Numeru quandu: ['apples'] fà: { <- ((Fruit novu) apples: sè).
}.

Numeru quandu: ['apple'] fà: { <- ((Fruit novu) apples: sè).
}.

Numeru quandu: ['oranges'] fà: { <- ((Fruit novu) oranges: sè).
}.




Esciuta scrive: (1 apple + 3 oranges + 4 apples), linea-nova.


Testu quandu: ['twice'] fà: { <- ((sè testu) + (sè testu)).
}.



Esciuta scrive: ['❤❤❤'] twice.



