Server init.

>> x := Blob novu: 65 tipu: ['char'].
# for this test you need set a path to libc (puts)
>> libname := Prugramma parametru: ['FFITESTLIB'].
Server ligà: (
 Lista novu ;
 libname ;
 ['putchar'] ;
 ( Lista novu ; ['char'] ) ;
 ['void'] ;
 ['Print'] ;
 ['char:']
).
Print char: (x da: 0 lunghezza: 1), linea-nova.
x liberà.

