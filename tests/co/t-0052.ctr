>> items := Dizziunariu novu.
items mette: ['green'] à: ['color-1'].
items mette: ['orange'] à: ['color-2'].
items mette: ['red'] à: ['color-3'].
>> i := 0.
>> s := [''].
items ognunu: { :key :color
	Esciuta scrive: ['color #'] + i + [' is: '] + color + [' '].
	i aghjunghje: 1.
}.
Esciuta scrive: i + [' colors!'].
