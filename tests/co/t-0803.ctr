Server init.

>> conn1 := Maria-DB novu ospite: ['localhost'],
	nome-di-utilizatore: ['xo'],
	parolla-secreta: ['pass123'],
	nome-di-basa: ['xobase'],
	cunnette.

>> conn2 := Maria-DB novu ospite: ['localhost'],
	nome-di-utilizatore: ['xo'],
	parolla-secreta: ['pass123'],
	nome-di-basa: ['xobase'],
	cunnette.
#...
>> del := conn1 richiesta: ['DELETE FROM book WHERE id > 0'].
{  del eseguisce. conn1 cunfirmà. } catturà: { :e conn1 annullà.  }, lancià.

>> insert := conn1 richiesta: ['INSERT INTO book (id) VALUES(null)'].
insert eseguisce.

>> cuntà := conn1 richiesta: ['SELECT COUNT(*) AS num FROM book'].
cuntà ricuperà: { :row Esciuta scrive: row num, linea-nova. }.

# does not show up
# insert not committed on connection 1
>> cuntà := conn2 richiesta: ['SELECT COUNT(*) AS num FROM book'].
cuntà ricuperà: { :row Esciuta scrive: row num, linea-nova. }.
