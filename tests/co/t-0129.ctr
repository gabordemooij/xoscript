
Lista quandu: ['product'] fà: {
	>> total := 1.
	sè ognunu: { :index :element
		total multiplicà-per: element.
	}. <- total.
}.

>> a := Lista ← 1 ; 2 ; 3.
Esciuta scrive: a product, linea-nova.
Esciuta scrive: (Lista ← 2 ; 4 ; 8) product, linea-nova. 
Esciuta scrive: (Lista ← -2 ; 10) product, linea-nova. 
Esciuta scrive: (Lista ← 0.5 ; -2) product, linea-nova. 
