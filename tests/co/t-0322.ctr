

>> Matryoshka := Ughjettu novu.
Matryoshka quandu: ['double:'] fà: { :secret
	propiu secret := secret × 2.
}.
Matryoshka quandu: ['novu:'] fà: { :secret
	>> answer := Nunda.
	>> t := (secret > 255).
	Esciuta scrive: (secret + [' | '] + t), linea-nova.
	t veru: {
		answer := secret.
	}, altrimenti: {
		answer := Matryoshka ricursivu novu: (sè double: secret).
	}. <- answer.
}.

>> x := Matryoshka novu: 2.
