>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Ughjettu novu.
⚄ quandu: ['drawFrom:length:'] fà: { :pool :cuntà
	
	>> result := [''].
	
	{
		>> index := Numeru random % (pool lunghezza).
		result aghjunghje-à-a-fine: ( pool caratteru: (index + 1) ).
		
	} × cuntà. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? lunghezza.
Esciuta scrive: (['x↵'] x random lunghezza).
Esciuta scrive: (['y↵'] y ?? lunghezza).

