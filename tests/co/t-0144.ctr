



>> CoffeeGrounds := Ughjettu novu.
CoffeeGrounds quandu: ['extract'] fà: { <- ['coffee']. }.

>> CoffeeMachine := Ughjettu novu.
CoffeeMachine quandu: ['init'] fà: {
	propiu coffeegrounds := CoffeeGrounds novu.
}.
CoffeeMachine quandu: ['novu'] fà: { <- CoffeeMachine `new init.
}.

CoffeeMachine quandu: ['makeTea'] fà: { <- (propiu tealeaves extract). }.
CoffeeMachine quandu: ['makeCoffee'] fà: { <- (propiu coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine novu.

Esciuta scrive:
	coffeeDream 
	makeCoffee.

Esciuta scrive:
	coffeeDream 
	makeTea.
