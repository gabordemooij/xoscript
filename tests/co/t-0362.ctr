Esciuta scrive: (['a:b:'] - [':']), linea-nova.
Esciuta scrive: (['Lorem Ipsum'] - ['Ipsum']), linea-nova.
Esciuta scrive: (['a.................b.......................c...........'] - ['.']), linea-nova.
Esciuta scrive: (['a--b--c---d'] - ['--']), linea-nova.
Esciuta scrive: (['-'] - ['--']), linea-nova.
Esciuta scrive: ([''] - ['--']), linea-nova.
Esciuta scrive: (['--'] - ['']), linea-nova.
Esciuta scrive: ([''] - ['']), linea-nova.
>> x := ['xx'].
>> y := x - ['x'].
Esciuta scrive: x, linea-nova.
Esciuta scrive: y, linea-nova.
>> x := ['a,bb,c'].
>> y := x rimpiazzà: [''] cù: ['xx'].
Esciuta scrive: ((x listessu: y) o: ['OK'] o: ['BUG! Did return a copy by accident!']), linea-nova.