#Linux
>> clock := Mumentu novu.
clock zona: ['UTC-1'].
clock annu: 1981, mese: 1, ghjornu: 5,
      ora: 13, minutu: 15, secondu: 13.

Esciuta scrive: clock, linea-nova.
clock zona: ['UTC+0'].

Esciuta scrive: (
	(clock annu simplice) + ['-'] + (clock mese) + ['-'] + (clock ghjornu) + [' '] +
	(clock ora) + [':'] + (clock minutu) + [':'] + (clock secondu) + [' '] +
	['W'] + (clock settimana) + (clock zona)
), linea-nova.


clock zona: ['UTC-1'].
Esciuta scrive: (
	(clock annu simplice) + ['-'] + (clock mese) + ['-'] + (clock ghjornu) + [' '] +
	(clock ora) + [':'] + (clock minutu) + [':'] + (clock secondu) + [' '] +
	['W'] + (clock settimana) + (clock zona)
), linea-nova.
