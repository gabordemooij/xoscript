


>> CoffeeMachine := Ughjettu novu.
CoffeeMachine quandu: ['order:'] fà: { :id
	>> coffee := ['Americano'].
	( id = 1 ) veru: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) veru: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) veru: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Ughjettu novu.
SimpleCoffeeMachine quandu: ['order'] fà: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Esciuta scrive: redCup, linea-nova.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Esciuta scrive: greenCup, linea-nova.
>> yellowCup := CoffeeMachine order: 1.
Esciuta scrive: yellowCup, linea-nova.
>> blueCup := CoffeeMachine order: 0.
Esciuta scrive: blueCup, linea-nova.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Esciuta scrive: blackCup, linea-nova.
blackCup aghjunghje-à-a-fine: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Esciuta scrive: orangeCup, linea-nova.
