

Prugramma gestione-memoria: 1.

>> x := 0.
>> y := ['Hello'].
>> q := { ['']. }.
>> p := Veru.
>> a := Lista ← 1 ; 2 ; 3 ; 4.
>> c := Ughjettu novu.
c quandu: ['greet:'] fà: { Esciuta scrive: ['greet!']. }.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.
>> usedMemory5 := 0.

Prugramma pulisce.
>> usedMemory1 := (Prugramma memoria ? 0).




x := 1.
y := ['Hello'].
q := { ['']. }.
p := Veru.
a := Lista ← 1 ; 2 ; 3 ; 5.
c := Ughjettu novu.
c quandu: ['greet:'] fà: { Esciuta scrive: ['greet!']. }.


Prugramma pulisce.
>> usedMemory2 := (Prugramma memoria ? 0).




