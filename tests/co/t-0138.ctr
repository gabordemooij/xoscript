(usedMemory1 = usedMemory2 = usedMemory3 = usedMemory4 = usedMemory5) veru: { 
	Esciuta scrive: ['Memory usage remains stable.'], linea-nova.
}, altrimenti: {
	Esciuta scrive: ['Used memory not stable.'], linea-nova.
}.
