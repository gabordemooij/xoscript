

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prugramma gestione-memoria: 0.

>> txt := [' Word Salad '].
txt := txt rimpiazzà: ['Word'] cù: ['Ceasar'].
txt := txt taglià-spazii.
Esciuta scrive: txt, linea-nova.

Prugramma pulisce.

usedMemory1 := (Prugramma memoria ? 0).


txt := [' Word Salad '].
txt := txt rimpiazzà: ['Word'] cù: ['Ceasar'].
txt := txt taglià-spazii.
Esciuta scrive: txt, linea-nova.

Prugramma pulisce.
usedMemory2 := (Prugramma memoria ? 0).


txt := [' Word Salad '].
txt := txt rimpiazzà: ['Word'] cù: ['Ceasar'].
txt := txt taglià-spazii.
