Server init.
>> f := Furmatu novu: ['%d'].
>> a := Blob novu: 4.
a bytes: ( Lista novu ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob novu: 4.
b bytes: ( Lista novu ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a da: 0 lunghezza: 3, ognunu: { :i :byte
	Esciuta scrive: ( f applicà-interu: byte ), linea-nova.
}.
a ^ b.
a da: 0 lunghezza: 3, ognunu: { :i :byte
	Esciuta scrive: ( f applicà-interu: byte ), linea-nova.
}.
a ^ b.
a da: 0 lunghezza: 3, ognunu: { :i :byte
	Esciuta scrive: ( f applicà-interu: byte ), linea-nova.
}.
a liberà.
b liberà.

{ a ^ Ughjettu. } catturà: { :e Esciuta scrive: e, linea-nova. }, lancià.
