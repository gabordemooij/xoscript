Esciuta scrive: ['Test object'], linea-nova.
>> a := Ughjettu novu. 

a quandu: ['item:'] fà: { :num
	propiu num := num. 
}.

a quandu: ['item'] fà: { <- propiu num.
}.

a item: 123.

Esciuta scrive: a item, linea-nova.

>> old-num-address := a item prototipu indirizzu-di-memoria.
a save-as: ['/tmp/a.bin'].
Esciuta scrive: ['========== RELOADING SNAP:'], linea-nova.

>> b := Ughjettu load-from: ['/tmp/a.bin'].

(b item prototipu indirizzu-di-memoria = old-num-address) veru: {
	Esciuta scrive: ['Object link re-attached.'], linea-nova.
}.

Esciuta scrive: b item, linea-nova.
