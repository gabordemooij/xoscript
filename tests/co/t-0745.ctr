Esciuta scrive: ['Test object'], linea-nova.
>> a := Ughjettu novu. 

a quandu: ['item:'] fà: { :dict
	propiu dict := dict. 
}.

a quandu: ['item'] fà: { <- propiu dict.
}.

a item: (
Dizziunariu novu
	hello: ['world']).

>> old-dict-address := a item prototipu indirizzu-di-memoria.
a save-as: ['/tmp/a.bin'].
Esciuta scrive: ['========== RELOADING SNAP:'], linea-nova.

>> b := Ughjettu load-from: ['/tmp/a.bin'].

(b item prototipu indirizzu-di-memoria = old-dict-address) veru: {
	Esciuta scrive: ['Object link re-attached.'], linea-nova.
}.

Esciuta scrive: b item, linea-nova.
