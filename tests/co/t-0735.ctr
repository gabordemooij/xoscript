Server init.
>> a := Blob novu: 4.
a bytes: ( Lista novu ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob novu: 4.
b bytes: ( Lista novu ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
# inherited blob does not get the buffer, so it's useless
# it will pass ctr_accept() but since buffer ptr == null, it will retur
>> c := a novu.
{ 
>> n := a ^ c.
Esciuta scrive: ['xorred:'], linea-nova. 
Esciuta scrive: n, linea-nova. 
} catturà: { :e Esciuta scrive: e, linea-nova. }, lancià.
a liberà.
b liberà.
