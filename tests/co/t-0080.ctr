{
	>> a := Lista novu.
	a aghjunghje-à-a-fine: 1.
	a aghjunghje-à-a-fine: 2.
	Esciuta scrive: (a unisce: [',']), linea-nova.
	a mette: 3 à: 2.
	Esciuta scrive: (a unisce: [',']), linea-nova.
	a mette: 4 à: 10.
	Esciuta scrive: (a unisce: [',']), linea-nova.
	a caccià-primu.
	a caccià-primu.
	a caccià-primu.
	Esciuta scrive: (a unisce: [',']), linea-nova.
	a mette: 9 à: 0.
	Esciuta scrive: (a unisce: [',']), linea-nova.
