
>> a := Lista ← (Lista ← 100 ; 200 ; 300) ; (Lista ← 9 ; 8 ; 7).
Esciuta scrive: ['at 0,1 :'].
Esciuta scrive: a ? 0 ? 1, linea-nova. 
Esciuta scrive: ['at 1,2 :'].
Esciuta scrive: a ? 1 ? 2, linea-nova. 
>> menu := Dizziunariu novu.
menu mette: (Lista ← ['pizza'] ; ['spaghetti']) à: ['Italian Cuisine'].
menu mette: (Lista ← ['bifteki'] ; ['suflaki']) à: ['Greek Cuisine'].
Esciuta scrive: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), linea-nova. 
Esciuta scrive: ['but not on the same plate.'], linea-nova.
