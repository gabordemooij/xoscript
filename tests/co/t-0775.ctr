Esciuta scrive: ['Test object'], linea-nova.
>> l := Lista novu ; 1 ; ( Lista novu ; (Mumentu novu: 1) ; (Int64 da-testu: ['321']) ; (Lista novu ; 3)).
Esciuta scrive: l, linea-nova.
>> old-lst-address := l prototipu indirizzu-di-memoria.
l save-as: ['/tmp/a.bin'].
Esciuta scrive: ['========== RELOADING SNAP:'], linea-nova.
>> b := Ughjettu load-from: ['/tmp/a.bin'].
(b prototipu indirizzu-di-memoria = old-lst-address) veru: {
	Esciuta scrive: ['Object link re-attached.'], linea-nova.
}.
Esciuta scrive: b, linea-nova.
