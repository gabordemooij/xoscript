

Lista quandu: ['fixture:'] fà: { :f
	propiu fixture := f.
}.

Lista quandu: ['cuntà'] fà: { <- propiu fixture.
}.

Lista quandu: ['aantal'] fà: { <- propiu fixture.
}.


>> x := Nunda.
{

	x := ['hello'] 
	rimpiazzà:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] caratteru: 2)
			)
		)
	cù: (
		(['...hal'] + ['lo']) 
			maiuscule 
			lowecase 
			maiuscule 
			saltà: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Lista ← 0 ; 1 ; 4; 9 ; (Lista ← 0 ; 3; 1) ; 4
							) penultimu
						) ? 1
					) + 
					((Lista ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					cuntà
				)
			)
	).

} × 10.
Esciuta scrive: x, linea-nova.

