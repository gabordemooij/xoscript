# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Cascia-forte generà-chjavi.

# private (secret) key
>> sk := keys primu.

# public key
>> pk := keys ultimu.

# sign a message
>> sig := Cascia-forte firmà: ['abc'] cù: sk.

# check message (ok)
Esciuta scrive: ( 
	Cascia-forte
		verificà: ['abc'] 
		firma: sig 
		cù: pk 
), linea-nova.

# check message (fail)
Esciuta scrive: ( 
	Cascia-forte 
		verificà: ['abd'] 
		firma: sig 
		cù: pk 
), linea-nova.