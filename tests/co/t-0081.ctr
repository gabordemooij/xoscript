>> map1 := Dizziunariu novu.
>> key1 := Lista novu.
>> key2 := Lista novu.

map1
	mette: ['hello'] à: key1,
	mette: ['world'] à: key2.


Esciuta
	scrive: ['Map #1 contains: '] + (map1 à: key1),
	scrive: [' and '] + (map1 à: key2), linea-nova.

>> KeyeableArray := Lista novu.
KeyeableArray quandu: ['toString'] fà: { <- (sè cuntà) toString.
}.

>> map2 := Dizziunariu novu.
key1 := KeyeableArray novu.
key2 := KeyeableArray novu.

key1 aghjunghje-à-a-fine: 1.

map2
	mette: ['hello'] à: key1,
	mette: ['world'] à: key2.

Esciuta
	scrive: ['Map #2 contains: '] + (map2 à: key1),
	scrive: [' and '] + (map2 à: key2), linea-nova.
