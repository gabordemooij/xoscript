Booleanu quandu: ['xor:'] fà: { :a :b <- ((a è: b nò) o: (a nò è: b)).
}.

>> o := Ughjettu novu.
o quandu: ['hello'] fà: { ['Empty']. }.
{ o quandu: 2 fà: 3.} catturà: { :e Esciuta scrive: e, linea-nova. }, lancià.
{ o quandu: ['prova'] fà: 3.} catturà: { :e Esciuta scrive: e, linea-nova. }, lancià.
{ o quandu: ['hello'] fà: { ['Empty']. }.} catturà: { :e Esciuta scrive: e, linea-nova. }, lancià. 
{ >> z := 4 ÷ 0. } catturà: { :e Esciuta scrive: e, linea-nova. }, lancià. 
{ (Veru è: Nunda) veru: { Esciuta scrive: ['X'].}. } catturà: { :e Esciuta scrive: e, linea-nova. }, lancià. 
{ ([''] xor: 0) veru: { Esciuta scrive: ['X'].}. } catturà: { :e Esciuta scrive: e, linea-nova. }, lancià. 
{ (1 < ['2']) veru: { Esciuta scrive: ['OK']. }. } catturà: { :e Esciuta scrive: e, linea-nova. }, lancià. 
{ (1 < ['2.0']) veru: { Esciuta scrive: ['OK']. }. } catturà: { :e Esciuta scrive: e, linea-nova. }, lancià. 
{ (1 < ['x2.0']) veru: { Esciuta scrive: ['NO!']. }. } catturà: { :e Esciuta scrive: e, linea-nova. }, lancià. 
{ Esciuta scrive: (['hello OK there'] da: ['6'] lunghezza: ['2']). } lancià. 
