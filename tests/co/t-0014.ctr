>> Greeter := Ughjettu novu.
Greeter quandu: ['make'] fà: {
	>> gr := Ughjettu novu.
	gr quandu: ['setName:'] fà: { :aname
		propiu nome := aname.
	}.
	gr quandu: ['greet'] fà: {
		Esciuta scrive: propiu nome.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a novu.
c setName: ['THREE'].
c greet.
>> d := a novu.
d setName: ['FOUR'].
d greet.
c greet.
