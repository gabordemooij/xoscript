>> a := Ughjettu novu. 
a quandu: ['greet'] fà: { Esciuta scrive: ['welcome!'], linea-nova. }.
a quandu: ['greet2'] fà: { Esciuta scrive: ['welcome2!'], linea-nova. }.
a save-as: ['/tmp/a.bin'].

Esciuta scrive: ['========== RELOADING SNAP:'], linea-nova.
>> b := Ughjettu load-from: ['/tmp/a.bin'].
b greet2.