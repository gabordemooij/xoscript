#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Mudellu novu: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern currispundenza: subject fà: { :m :x
	Esciuta scrive: m, linea-nova.
	Esciuta scrive: x, linea-nova. <- ['XXX'].
}.
Esciuta scrive: result, linea-nova.