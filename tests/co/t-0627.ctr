

# create a 64-bit integer for exact calculations
>> a := Int64 da-testu: ['123'].

# to string
Esciuta scrive: a, linea-nova.

# divide
Esciuta scrive: a / (Int64 da-testu: ['3']), linea-nova.

# multiply
Esciuta scrive: a * (Int64 da-testu: ['2']), linea-nova.

# add
Esciuta scrive: a + (Int64 da-testu: ['1']), linea-nova.

# subtract
Esciuta scrive: a - (Int64 da-testu: ['2']), linea-nova.

# compare
Esciuta scrive: ( a =   (Int64 da-testu: ['123'])), linea-nova.
Esciuta scrive: ( a !=: (Int64 da-testu: ['124'])), linea-nova.
Esciuta scrive: ( a <   (Int64 da-testu: ['124'])), linea-nova.
Esciuta scrive: ( a >   (Int64 da-testu: ['122'])), linea-nova.
Esciuta scrive: ( a >=: (Int64 da-testu: ['123'])), linea-nova.
Esciuta scrive: ( a <=: (Int64 da-testu: ['123'])), linea-nova.





	