
>> Size := Ughjettu novu.
Size quandu: ['is:'] fà: { :numeru
	numeru quandu: ['+'] fà: { :numeru
		>> unit := numeru qualificativu.
		>> factor := 1.
		
		unit
		casu: ['inch'] fà: { factor := 0.0833. }. <- sè + (numeru * factor).
	}. <- numeru.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Esciuta scrive: plank + edge, linea-nova.
