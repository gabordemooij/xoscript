
>> countries := Lista novu
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Lista novu
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods à-secondu: countries, ognunu: { :key :value
	counter aghjunghje: 1.
}.

Esciuta scrive: (['we serve counter dishes'] counter: counter), linea-nova.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] caratteri urdinà: { :v
	counter aghjunghje: 0.
}.

Esciuta scrive: (['we sort counter dishes'] counter: counter), linea-nova.


>> counter := 0.
{
	{
		counter aghjunghje: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Esciuta scrive: (['we calculate counter numbers.'] counter: counter), linea-nova.

