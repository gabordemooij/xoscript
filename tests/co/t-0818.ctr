# edge cases from a request must give an error or a result, not a crash
Server init.

Esciuta scrive: ['<'] + (['abc'] da: 0 lunghezza: 0, maiuscule) + ['>'], linea-nova.
Esciuta scrive: ['<'] + (['abc'] da: 0 lunghezza: 0, minuscule) + ['>'], linea-nova.
Esciuta scrive: ['<'] + (['abc'] saltà: 3, maiuscule) + ['>'], linea-nova.
Esciuta scrive: [''] maiuscule bytes, linea-nova.
Esciuta scrive: ['aB'] maiuscule, linea-nova.
Esciuta scrive: ['aB'] minuscule, linea-nova.

Esciuta scrive: (Mumentu novu: 0) annu, linea-nova.
{ Mumentu novu: ['9e300'] numeru. } catturà: { :e Esciuta scrive: e, linea-nova. }, lancià.
{ Mumentu novu: ['-9e300'] numeru. } catturà: { :e Esciuta scrive: e, linea-nova. }, lancià.
{ Mumentu novu: ['nan'] numeru. } catturà: { :e Esciuta scrive: e, linea-nova. }, lancià.
{ Mumentu novu: 9000000000000000000. } catturà: { :e Esciuta scrive: e, linea-nova. }, lancià.
