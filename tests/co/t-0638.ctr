
Server init.
>> rq := Dumanda-HTTP novu.
Esciuta scrive: ['HTTP-GET d[]=']  + ( rq get-lista: ['d[]'] ), linea-nova. # GET
Esciuta scrive: ['HTTP-GET f[]=']  + ( rq get-lista: ['f[]'] ), linea-nova. # GET
Esciuta scrive: ['HTTP-POST e[]='] + ( rq post-lista: ['e[]'] ), linea-nova. # GET
Esciuta scrive: ['HTTP-POST c=']   + ( rq post: ['c'] ), linea-nova. # GET
Esciuta scrive: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), linea-nova. # GET
