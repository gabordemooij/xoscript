Server init.
Esciuta scrive: ['Database time test'], linea-nova.

>> db := Maria-DB novu ospite: ['localhost'],
	nome-di-utilizatore: ['xo'], 
	parolla-secreta: ['pass123'],
	nome-di-basa: ['xobase'],
	cunnette.

>> parametri-di-ricerca :=
db richiesta: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
ricuperà: { :row
	Esciuta scrive: row timetest, linea-nova.
}.
