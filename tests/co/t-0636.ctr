# test url parsing

Server init.
>> url := URL da: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Esciuta scrive: ['scheme = '] + url schema, linea-nova.
Esciuta scrive: ['host = '] + url ospite, linea-nova.
Esciuta scrive: ['port = '] + url portu, linea-nova.
Esciuta scrive: ['path = '] + url caminu-di-schedariu, linea-nova.
Esciuta scrive: ['query = '] + url parametri-di-ricerca, linea-nova.
Esciuta scrive: ['fragment = '] + url frammentu, linea-nova.
