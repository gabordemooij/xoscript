Esciuta scrive: ((Lista novu
	quandu: ['plaque:'] fà: { :x propiu o := x. },
	quandu: ['plaque']  fà: { <- propiu o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Lista ← 1)
	~ (Lista ← 1 ; 2)
	~ (Lista ← 1 ; 2 ; 3)
	~ (Lista ← 1 ; 2 ; 3 ; 4)
	~ (Lista ← 1 ; 2 ; 3 ; 4 ; 5)
) ognunu: { :i :el
	{ Esciuta scrive: sta-faccenda. } × el cuntà.
	Esciuta linea-nova.
}) plaque, linea-nova.


