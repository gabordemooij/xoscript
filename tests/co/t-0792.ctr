Server init.

>> DB := Maria-DB novu ospite: ['localhost'],
	nome-di-utilizatore: ['xo'],
	parolla-secreta: ['pass123'],
	nome-di-basa: ['xobase'],
	cunnette.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB richiesta: SQL.

# now you don't have to set DB
query2 ricuperà: { :row
	Esciuta scrive: row world, linea-nova.
}.
