Server init.

>> DB := Maria-DB novu ospite: ['localhost'],
	nome-di-utilizatore: ['xo'],
	parolla-secreta: ['pass123'],
	nome-di-basa: ['xobase'],
	cunnette.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> parametri-di-ricerca := Maria-Richiesta novu: SQL.

# set database
parametri-di-ricerca basa-di-dati: DB.

parametri-di-ricerca ricuperà: { :row
	Esciuta scrive: row world, linea-nova.
}.
