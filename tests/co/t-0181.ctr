

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prugramma gestione-memoria: 0.

>> txt := ['World Salad'].
Esciuta scrive: ['this text contains: '] + ( ( txt sparte: [' '] ) cuntà ) + [' words.'], linea-nova.
txt := txt da: 6 lunghezza: 4.
Esciuta scrive: txt, linea-nova.

Prugramma pulisce.

usedMemory1 := (Prugramma memoria ? 0).


txt := ['World Salad'].
Esciuta scrive: ['this text contains: '] + ( ( txt sparte: [' '] ) cuntà ) + [' words.'], linea-nova.
txt := txt da: 6 lunghezza: 4.
Esciuta scrive: txt, linea-nova.

Prugramma pulisce.
usedMemory2 := (Prugramma memoria ? 0).


txt := ['World Salad'].
Esciuta scrive: ['this text contains: '] + ( ( txt sparte: [' '] ) cuntà ) + [' words.'], linea-nova.
txt := txt da: 6 lunghezza: 4.
Esciuta scrive: txt, linea-nova.

Prugramma pulisce.
usedMemory3 := (Prugramma memoria ? 0).



( usedMemory1 = usedMemory2 è: usedMemory1 = usedMemory3, è: usedMemory2 = usedMemory3 ) veru: {
	Esciuta scrive: ['No memory leaks here'].
}, falsu: {
	Esciuta scrive: ['Leaking memory...'].
}.
