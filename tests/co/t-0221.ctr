>> x := Ughjettu novu.
>> y := Ughjettu novu.
>> z := x.
Esciuta scrive: (x = z), linea-nova.
Esciuta scrive: (x = y), linea-nova.
Esciuta scrive: (x ≠ y), linea-nova.
Esciuta scrive: (x ≠ z), linea-nova.
>> m := Mumentu novu annu: 2070, mese: 11.
>> n := m cupià.
Esciuta scrive: (m = n), linea-nova.
Esciuta scrive: (m ≠ n), linea-nova.
Esciuta scrive: (m listessu: m), linea-nova.
Esciuta scrive: (m listessu: n), linea-nova.
n mese: 12.
Esciuta scrive: (m ≠ n), linea-nova.
Esciuta scrive: (m = n), linea-nova.


