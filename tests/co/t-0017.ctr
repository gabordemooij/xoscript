Numeru quandu: ['factorial'] fà: {
	>> total := 1.
	{ :index total multiplicà-per: (sè - (index)). } × sè. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Esciuta scrive: a.
>> b := 2 + 3 factorial.
Esciuta scrive: b.
>> c := 3 factorial + 2.
Esciuta scrive: c.
>> d := 2 + (3 factorial).
Esciuta scrive: d.
Esciuta scrive: 2 + 3 factorial + 1.
