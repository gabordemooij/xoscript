Lista quandu: ['sum'] fà: {
	>> total := 0.
	sè ognunu: { :index :element
		total aghjunghje: element.
	}. <- total.
}.

>> a := Veru.



a quandu: ['testu'] fà: {
	>> answer := Nunda.
	( sè = Veru ) veru: {
		answer := ['Yep'].
	}, altrimenti: {
		answer := ['Nope'].
	}. <- answer.
}.

a quandu: ['numeru'] fà: {
	>> answer := Nunda.
	( sè = Veru ) veru: {
		answer := 10.
	}, altrimenti: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b quandu: ['testu'] fà: { <- ['Devil'].
}.

b quandu: ['booleanu'] fà: { <- Falsu.
}.


Esciuta scrive: a, linea-nova.  
Esciuta scrive: (90 + a), linea-nova. 
Esciuta scrive: b, linea-nova. 
Esciuta scrive: (Veru è: b), linea-nova.

a := Lista ← ['hello'] ; ['world'] ; Veru ; Nunda ; 666. 
a := a + ( Lista ← 1 ).
Esciuta scrive: a, linea-nova.
Esciuta scrive: ((Dizziunariu novu) mette: Nunda à: Nunda), linea-nova.
Esciuta scrive: a sum, linea-nova. 


{
	a quandu: ['testu'] fà: { <- Nunda. }.
	a := [''] + a.
} catturà: { :error
	Esciuta scrive: ['Error noted: '] + error, linea-nova.
}, lancià.



{
	a quandu: ['numeru'] fà: { <- Nunda. }.
	a := 3 × a.
} catturà: { :error
	Esciuta scrive: ['Error noted: '] + error, linea-nova.
}, lancià.


{
	a quandu: ['booleanu'] fà: { <- Nunda. }.
	a := Veru è: a. 
} catturà: { :error
	Esciuta scrive: ['Error noted: '] + error, linea-nova.
}, lancià.





{
	a quandu: ['testu'] fà: { <- Falsu. }.
	a := [''] + a.
} catturà: { :error
	Esciuta scrive: ['Error noted: '] + error, linea-nova.
}, lancià.



{
	a quandu: ['numeru'] fà: { <- Veru. }.
	a := 3 × a.
} catturà: { :error
	Esciuta scrive: ['Error noted: '] + error, linea-nova.
}, lancià.


{
	a quandu: ['boolean'] fà: { <- 1. }.
	a := Veru è: a.
} catturà: { :error
	Esciuta scrive: ['Error noted: '] + error, linea-nova.
}, lancià.





{
	a quandu: ['testu'] fà: { <- 1. }.
	a := [''] + a.
} catturà: { :error
	Esciuta scrive: ['Error noted: '] + error, linea-nova.
}, lancià.



{
	a quandu: ['numeru'] fà: { <- ['']. }.
	a := 3 × a.
} catturà: { :error
	Esciuta scrive: ['Error noted: '] + error, linea-nova.
}, lancià.


{
	a quandu: ['boolean'] fà: { <- ['']. }.
	a := Veru è: a.
} catturà: { :error
	Esciuta scrive: ['Error noted: '] + error, linea-nova.
}, lancià.






{
	a quandu: ['testu'] fà: { <- (Dizziunariu novu). }.
	a := [''] + a. 
} catturà: { :error
	Esciuta scrive: ['Error noted: '] + error, linea-nova.
}, lancià.



{
	a quandu: ['numeru'] fà: { <- (Ughjettu novu). }.
	a := 3 × a. 
} catturà: { :error
	Esciuta scrive: ['Error noted: '] + error, linea-nova.
}, lancià.


