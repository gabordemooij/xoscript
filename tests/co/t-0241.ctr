

Testu quandu: ['evaluate'] fà: {
	>> codice := Schedariu novu: ['/tmp/eval.ctr'].
	codice scrive: (sè testu + ['.']).
	Prugramma aduprà: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Lista ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q testu.
Esciuta scrive: x, linea-nova.
>> y := Nunda.
(['y := '] + x ) evaluate.
Esciuta scrive: y ? 0, linea-nova.

q := Dizziunariu mette: ['\[''] à: ['\['quote\']'].
x := q testu.
Esciuta scrive: x, linea-nova.
y := Nunda.
(['y := '] + x ) evaluate.

>> q := (Dizziunariu novu) mette:['\[''] à:['\['quote\[''].
Esciuta scrive: y ? ['\['quote\']'], linea-nova.
