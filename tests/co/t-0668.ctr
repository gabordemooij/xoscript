# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob novu: 8, bytes: (
	Lista novu ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Esciuta scrive: ( utf16 decudificà: ['utf16le'] ), linea-nova.

utf16 liberà.
>> utf32 := Blob novu: 13, bytes: (
	Lista novu ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Esciuta scrive: ( utf32 decudificà: ['utf32be'] ), linea-nova.
utf32 liberà.