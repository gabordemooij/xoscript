# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB novu ospite: ['localhost'],
	nome-di-utilizatore: ['xo'],
	parolla-secreta: ['pass123'],
	nome-di-basa: ['xobase'],
	cunnette.

>> parametri-di-ricerca := db richiesta: ['SELECT %% FROM'].
{ parametri-di-ricerca eseguisce. } catturà: { :e
	Esciuta scrive: ( e cuntene: ['%%'] ), linea-nova.
}, lancià.
