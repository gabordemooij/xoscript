>> q := Lista ← 1 ; 2 ; 3.
{ q ? ['1']. } catturà: { Esciuta scrive: ['caught!'], linea-nova. }, lancià.
{ q ? Veru. } catturà: { Esciuta scrive: ['caught!'], linea-nova. }, lancià.
{ q ? Falsu. } catturà: { Esciuta scrive: ['caught!'], linea-nova. }, lancià.
{ q ? Nunda. } catturà: { Esciuta scrive: ['caught!'], linea-nova. }, lancià.
{ q ? (Lista novu). } catturà: { Esciuta scrive: ['caught!'], linea-nova. }, lancià.
{ q ? (Ughjettu novu). } catturà: { Esciuta scrive: ['caught!'], linea-nova. }, lancià.
{ q ? ({ ['Empty']. }). } catturà: { Esciuta scrive: ['caught!'], linea-nova. }, lancià.
Esciuta scrive: ['caught them all'], linea-nova.
