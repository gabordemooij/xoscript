Server init.

Esciuta scrive: (
	Mudellu novu: ['^\\w+$'],
	currispundenza: ['test@example.com'] 
), linea-nova. # 0 match, fails on @ and .

Esciuta scrive: (
	Mudellu novu: ['^[^@]+@[^\.]+\.\\w+$'],
	currispundenza: ['test@example.com'] 
), linea-nova. # 1 match

Esciuta scrive: (
	Mudellu novu: ['[^@]+@[^\.]+\.\\w+'],
	currispundenza: ['test@example.com'] 
), linea-nova. # 1 match

Esciuta scrive: (
	Mudellu novu: ['([^@]+)@([^\.]+)\.\\w+'],
	currispundenza: ['test@example.com'] 
), linea-nova. # 1 match, groups dont matter

Esciuta scrive: (
	Mudellu novu: ['[a-z]'],
	currispundenza: ['test@example.com'] 
), linea-nova. # 14 matches

Esciuta scrive: (
	Mudellu novu: ['.*'],
	currispundenza: ['test@example.com'] 
), linea-nova. # 1 match (all)

Esciuta scrive: (
	Mudellu novu: ['(.*)'],
	currispundenza: ['test@example.com'] 
), linea-nova. # 1 match (all)

Esciuta scrive: (
	Mudellu novu: ['\\s*[^@]+@[^\.]+\.\\w+'],
	currispundenza: ['test@example.com'] 
), linea-nova. # 1 match, prefix space optional, gets ignored