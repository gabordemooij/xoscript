

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prugramma gestione-memoria: 0.

>> f := Schedariu novu: ['/tmp/citrine_test_file.txt'].
f exists: { f eliminà. }.
f scrive: ['hello world'].
>> q := f caminu-di-schedariu.

f := Schedariu novu: ['/tmp/citrine_test_file.txt'].
q := f caminu-di-schedariu.

Prugramma pulisce.
usedMemory1 := (Prugramma memoria ? 0).


f := Schedariu novu: ['/tmp/citrine_test_file.txt'].
q := f caminu-di-schedariu.

Prugramma pulisce.
usedMemory2 := (Prugramma memoria ? 0).


f := Schedariu novu: ['/tmp/citrine_test_file.txt'].
q := f caminu-di-schedariu.

Prugramma pulisce.
