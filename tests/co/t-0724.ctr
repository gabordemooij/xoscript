Esciuta scrive: ['Test object'], linea-nova.
>> a := Ughjettu novu. 

a quandu: ['item:'] fà: { :file
	propiu file := file. 
}.

a quandu: ['item'] fà: { <- propiu file.
}.

>> f := Schedariu novu: ['/tmp/aaa.txt'].
a item: f.
Esciuta scrive: a item, linea-nova.
a save-as: ['/tmp/a.bin'].
Esciuta scrive: ['========== RELOADING SNAP:'], linea-nova.
>> b := Ughjettu load-from: ['/tmp/a.bin'].
Esciuta scrive: b item, linea-nova.
