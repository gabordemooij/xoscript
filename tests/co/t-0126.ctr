#Linux
>> Slurp := Ughjettu novu.

Slurp quandu: ['novu'] fà: {
	propiu str := [''].
}.

Slurp quandu: ['nieuw'] fà: {
	propiu str := [''].
}.

Slurp quandu: ['risponde:'] fà: { :blah
		propiu str aghjunghje-à-a-fine: blah.
}.

Slurp quandu: ['risponde:è:'] fà: { :blah :blahah
		propiu str aghjunghje-à-a-fine: (blah da: 0 lunghezza: (blah lunghezza - 1)).
		propiu str aghjunghje-à-a-fine: [' '].
		propiu str aghjunghje-à-a-fine: blahah.
}.

Slurp quandu: ['obtain'] fà: {
	>> buffer := propiu str.
	propiu str := ['']. <- buffer.
}.


Esciuta scrive: (Prugramma sistema: (Slurp novu echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Schedariu novu: ['/tmp/from.txt'], eliminà. } catturà: { ['Empty']. }, lancià.
{ Schedariu novu: ['/tmp/to.txt'], eliminà. } catturà: { ['Empty']. }, lancià.


Schedariu novu: ['/tmp/to.txt'], esiste falsu: {
	Esciuta scrive: ['Confirmed. Target file does not exist.\
'].
}.
Schedariu novu: ['/tmp/from.txt'], esiste falsu: {
	Esciuta scrive: ['Confirmed. Source file does not exist.\
'].
}.



Prugramma sistema: (Slurp novu touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Prugramma sistema: (Slurp novu cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Schedariu novu: ['/tmp/to.txt'], esiste veru: {
	Esciuta scrive: ['Confirmed. Target file has been created by shell.\
'].
}.


Esciuta scrive: ['Contents of file is:'] + (Schedariu novu: ['/tmp/to.txt'], leghje), linea-nova.
