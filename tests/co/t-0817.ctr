# a value ending in the first part of an opening quote must survive serialization
>> valori := Lista novu
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

valori ognunu: { :i :value
	>> d := Dizziunariu novu.
	d mette: value à: ['k'].
	d mette: ['second'] à: ['j'].
	>> r := d codice ughjettu.
	Esciuta scrive: r cuntà, linea-nova.
	Esciuta scrive: ( (r à: ['k']) = value ), linea-nova.
}.
