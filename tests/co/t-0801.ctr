Server init.

>> db := Maria-DB novu ospite: ['localhost'],
	nome-di-utilizatore: ['xo'],
	parolla-secreta: ['pass123'],
	nome-di-basa: ['xobase'],
	cunnette.

>> del := db richiesta: ['DELETE FROM book WHERE id > 0'].
{  del eseguisce. db cunfirmà. } catturà: { :e db annullà.  }, lancià.

>> cuntà := db richiesta: ['SELECT COUNT(*) AS num FROM book'].
cuntà ricuperà: { :row Esciuta scrive: row num, linea-nova. }.
