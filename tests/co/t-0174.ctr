


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prugramma gestione-memoria: 0.
>> palette := Nunda.
>> colors := Nunda.

{
palette := Dizziunariu novu.
palette 
	mette: ['#F00'] à: ['red'],
	mette: ['#0F0'] à: ['green'],
	mette: ['#00F'] à: ['blue'].
Esciuta scrive: ['number of RGB codes in palette: '] + ( palette cuntà ), linea-nova.
Esciuta scrive: ['RGB code of green is: '] + ( palette ? ['green'] ), linea-nova.
colors := [''].
( palette ognunu: { :nome :codice
		colors := colors + ( nome + [':'] + codice ).
} ).
Esciuta scrive: ['All colors in palette: '] + colors, linea-nova.
} lancià.
Prugramma pulisce.
usedMemory1 := (Prugramma memoria ? 0).

{
palette := Dizziunariu novu.
palette 
	mette: ['#F00'] à: ['red'],
	mette: ['#0F0'] à: ['green'],
	mette: ['#00F'] à: ['blue'].
Esciuta scrive: ['number of RGB codes in palette: '] + ( palette cuntà ), linea-nova.
Esciuta scrive: ['RGB code of green is: '] + ( palette ? ['green'] ), linea-nova.
colors := [''].
( palette ognunu: { :nome :codice
		colors := colors + ( nome + [':'] + codice ).
} ).
Esciuta scrive: ['All colors in palette: '] + colors, linea-nova.
} lancià.
Prugramma pulisce.
usedMemory2 := (Prugramma memoria ? 0).

{
palette := Dizziunariu novu.
palette 
	mette: ['#F00'] à: ['red'],
	mette: ['#0F0'] à: ['green'],
	mette: ['#00F'] à: ['blue'].
Esciuta scrive: ['number of RGB codes in palette: '] + ( palette cuntà ), linea-nova.
Esciuta scrive: ['RGB code of green is: '] + ( palette ? ['green'] ), linea-nova.
colors := [''].
( palette ognunu: { :nome :codice
		colors := colors + ( nome + [':'] + codice ).
} ).
Esciuta scrive: ['All colors in palette: '] + colors, linea-nova.
} lancià.
Prugramma pulisce.
usedMemory3 := (Prugramma memoria ? 0).



( usedMemory1 = usedMemory2 è: usedMemory1 = usedMemory3, è: usedMemory2 = usedMemory3 ) veru: {
	Esciuta scrive: ['No memory leaks here'].
}, falsu: {
	Esciuta scrive: ['Leaking memory...'].
}.
