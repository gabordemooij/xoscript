>> To-Do := Ughjettu novu.

To-Do quandu: ['novu'] fà: {
	propiu list := Lista novu.
}.

To-Do quandu: ['nieuw'] fà: {
	propiu list := Lista novu.
}.

To-Do quandu: ['+'] fà: { :task
	propiu list aghjunghje-à-a-fine: task.
}.

To-Do quandu: ['number of tasks?'] fà: { <-  propiu list cuntà.
}.

>> todos := 
	To-Do novu 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Esciuta scrive: ['You have $ tasks to do'] $ todos number of tasks?.
