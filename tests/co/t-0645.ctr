Server init.
Esciuta scrive: ['Database date test'], linea-nova.

>> db := Maria-DB novu ospite: ['localhost'],
	nome-di-utilizatore: ['xo'], 
	parolla-secreta: ['pass123'],
	nome-di-basa: ['xobase'],
	cunnette.

>> parametri-di-ricerca :=
db richiesta: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
ricuperà: { :row
	Esciuta scrive: row datetest, linea-nova.
}.
