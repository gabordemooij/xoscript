Numeru quandu: ['factorial'] fà: {
	>> total := 1.
	{ :index total multiplicà-per: (sè - index). } × sè. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prugramma gestione-memoria: 0.

{
2 exponent factorial.
Esciuta scrive: (11 modulu: 3), linea-nova.
Esciuta scrive: (3.4 arrutundà), linea-nova.
Esciuta scrive: (7.1 arrutundà-insù), linea-nova.
Esciuta scrive: (7.9 arrutundà-inghjò), linea-nova.
}
lancià.

Prugramma pulisce.

usedMemory1 := (Prugramma memoria ? 0).

{
2 exponent factorial.
Esciuta scrive: (11 modulu: 3), linea-nova.
Esciuta scrive: (3.4 arrutundà), linea-nova.
Esciuta scrive: (7.1 arrutundà-insù), linea-nova.
Esciuta scrive: (7.9 arrutundà-inghjò), linea-nova.
}
lancià.

Prugramma pulisce.
usedMemory2 := (Prugramma memoria ? 0).


{
2 exponent factorial.
Esciuta scrive: (11 modulu: 3), linea-nova.
Esciuta scrive: (3.4 arrutundà), linea-nova.
Esciuta scrive: (7.1 arrutundà-insù), linea-nova.
Esciuta scrive: (7.9 arrutundà-inghjò), linea-nova.
} lancià.

Prugramma pulisce.
usedMemory3 := (Prugramma memoria ? 0).



( usedMemory1 = usedMemory2 è: usedMemory1 = usedMemory3, è: usedMemory2 = usedMemory3 ) veru: {
	Esciuta scrive: ['No memory leaks here'].
}, falsu: {
	Esciuta scrive: ['Leaking memory...'].
}.
