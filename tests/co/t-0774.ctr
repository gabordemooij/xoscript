Esciuta scrive: ['Test object'], linea-nova.
>> a := Ughjettu novu. 
a quandu: ['item:'] fà: { :lst
	propiu lst := lst. 
}.
a quandu: ['item'] fà: { <- propiu lst.
}.
a item: (
	Lista novu ; 1 ; (
		Lista novu ; ['a'] ; (
			Lista novu ; ( Mumentu novu: 1 )
		) ; ( Int64 da-testu: ['321'] )
	)
).
Esciuta scrive: a item, linea-nova.
>> old-lst-address := a item prototipu indirizzu-di-memoria.
a save-as: ['/tmp/a.bin'].
Esciuta scrive: ['========== RELOADING SNAP:'], linea-nova.
>> b := Ughjettu load-from: ['/tmp/a.bin'].
(b item prototipu indirizzu-di-memoria = old-lst-address) veru: {
	Esciuta scrive: ['Object link re-attached.'], linea-nova.
}.
Esciuta scrive: ( b item ), linea-nova.
