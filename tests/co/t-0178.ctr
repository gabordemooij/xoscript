

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Prugramma gestione-memoria: 0.

>> txt := ['Word Salad'].
Esciuta scrive: ['last index of ord = '] + (( txt ultima-pusizione: ['ord'] ) - 0), linea-nova.
Esciuta scrive: ['index of ord = '] + (( txt truvà: ['ord'] ) - 0), linea-nova.
Esciuta scrive: ['index of ad = '] + (( txt truvà: ['ad'] ) - 0), linea-nova.
Esciuta scrive: ['last index of W = '] + (( txt ultima-pusizione: ['W'] ) - 0), linea-nova.
Esciuta scrive: ['last index of d = '] + (( txt ultima-pusizione: ['d'] ) - 0), linea-nova.
Esciuta scrive: ['txt equals Word Salad = '] + ( txt = ['Word Salad'] ), linea-nova.
Esciuta scrive: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), linea-nova.
Esciuta scrive: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), linea-nova.
Esciuta scrive: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), linea-nova.

