
Numeru amparà: ['plus:'] significa: ['+'].
Numeru quandu: ['+'] fà: { :x
	>> rate := 1.
	>> currency := x qualificativu.
	(currency = ['euros']) veru: {
		rate := 2.
	}. <- (sè plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars qualificà: ['dollars'].
euros qualificà: ['euros'].
>> money := dollars + euros.
Esciuta scrive: money, linea-nova.
