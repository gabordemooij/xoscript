#OBSD
>> dirname := [''].
{ dirname aghjunghje-à-a-fine: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Prugramma sistema: command.
Prugramma chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename aghjunghje-à-a-fine: ['YYYYYYYY']. } * 20.
Schedariu novu: filename, scrive: ['sometext'].
{ Schedariu lista: ['/tmp/'] + dirname. } * 1000.
Esciuta scrive: ['no crash'], linea-nova.

