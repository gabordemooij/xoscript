Server init.
>> fmt := Furmatu novu: ['%#3x'].

>> blob := Blob novu: 4.
blob bytes: ( 
	Lista novu ; 0 ; 1 ; 2 ; 3
).

>> file := Schedariu novu: ['/tmp/blob'].
file blob: blob.
blob liberà.

>> leghje := file blob.
leghje 
da: 0 
lunghezza: 4, 
fà ognunu: { :i :b 
	Esciuta
	scrive: (fmt applicà-interu: b),
	linea-nova.
}.
leghje liberà.
