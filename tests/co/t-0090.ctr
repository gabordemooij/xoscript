Esciuta scrive: ['1,2,3,4,5,6,7,8,9,A,'], linea-nova.
>> Scope := Ughjettu novu.
Scope quandu: ['initialize:'] fà: { :x propiu property := x. }.
Scope quandu: ['confirm'] fà: { Esciuta scrive: [',']. }.
Scope quandu: ['prova'] fà: {
	Esciuta scrive: propiu property.
	sè confirm.
	( 1 = 1 ) veru: { Esciuta scrive: propiu property. sè confirm. }.
	( 1 = 0 ) falsu: { Esciuta scrive: propiu property. sè confirm. }.
	>> y := 2. { Esciuta scrive: propiu property. sè confirm. } mentre: { y sottrae: 1. <- (y > 0). }.
	{ Esciuta scrive: propiu property. sè confirm. } × 1.
	(Lista ← 1) ognunu: {  Esciuta scrive: propiu property. sè confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Dizziunariu novu one: ['item']) ognunu: { Esciuta scrive: propiu property. sè confirm. }.
	{ 1 ÷ 0. } catturà: { Esciuta scrive: propiu property. sè confirm. }, lancià.
	Esciuta linea-nova.
}.
>> scope1 := Scope novu.
scope1 initialize: ['X'].
scope1 prova.
>> function := { 
	propiu property := ['Y'].
	Esciuta scrive: propiu property.
	sè confirm.
	( 1 = 1 ) veru: { Esciuta scrive: propiu property. sè confirm. }.
	( 1 = 0 ) falsu: { Esciuta scrive: propiu property. sè confirm. }.
	>> y := 2. { Esciuta scrive: propiu property. sè confirm. } mentre: { y sottrae: 1. <- (y > 0). }.
	{ Esciuta scrive: propiu property. sè confirm. } × 1.
	(Lista ← 1) ognunu: {  Esciuta scrive: propiu property. sè confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Dizziunariu novu one: ['item']) ognunu: { Esciuta scrive: propiu property. sè confirm. }.
	{ 1 ÷ 0. } catturà: { Esciuta scrive: propiu property. sè confirm. }, lancià.
	Esciuta linea-nova.
}.
function quandu: ['confirm'] fà: { Esciuta scrive: [',']. }.
