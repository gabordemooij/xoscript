Esciuta scrive: ['Test object'], linea-nova.
>> a := Ughjettu novu. 

a quandu: ['item:'] fà: { :octhelper
	propiu octhelper := octhelper. 
}.

a quandu: ['item'] fà: { <- propiu octhelper.
}.

a item: Oct novu.

>> old-octhelper-address := a item prototipu indirizzu-di-memoria.
a save-as: ['/tmp/a.bin'].
Esciuta scrive: ['========== RELOADING SNAP:'], linea-nova.

>> b := Ughjettu load-from: ['/tmp/a.bin'].

(b item prototipu indirizzu-di-memoria = old-octhelper-address) veru: {
	Esciuta scrive: ['Object link re-attached.'], linea-nova.
}.
