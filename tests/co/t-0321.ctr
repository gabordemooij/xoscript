# test qualifiers

Prugramma pulisce.

>> Fruit := Ughjettu novu.
Fruit quandu: ['novu'] fà: {
	>> f := sè novu.
	f apples: 0. <- f.
}.
Fruit quandu: ['apples:'] fà: { :a propiu apples := a. }.
Fruit quandu: ['apples'] fà: { <- propiu apples. }.
Fruit quandu: ['+'] fà: { :f
	>> n := Fruit novu.
	n apples: (f apples + propiu apples). <- n.
}.
Numeru quandu: ['apples'] fà: { <- ((Fruit novu) apples: sè).
}.

Fruit quandu: ['testu'] fà: { <- propiu apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Esciuta scrive: q, linea-nova.




q := 3 apples + 4 apples.
Esciuta scrive: q, linea-nova.



q := 3 apples + 4 apples.
Esciuta scrive: q, linea-nova.


