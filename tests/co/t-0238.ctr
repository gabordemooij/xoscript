Testu quandu: ['evaluate'] fà: {
	>> codice := Schedariu novu: ['/tmp/eval.ctr'].
	codice scrive: (sè testu + ['.']).
	Prugramma aduprà: ['/tmp/eval.ctr'].
}.

>> a := Lista ← 1 ; 2 ; 3.
>> b := (a testu).

Esciuta scrive: b, linea-nova. 
(['b := '] + b) evaluate.

Esciuta scrive: b ? 2, linea-nova. 

Esciuta scrive: (( Lista ← 1 ; 2 ; 3 )), linea-nova. 

Esciuta scrive: ((Dizziunariu novu) mette: 1 à: 2), linea-nova. 

>> x := ( (Lista ← 1 ; ( Lista ← 9 ) ; Veru ) ) testu.
Esciuta scrive: x, linea-nova. 
(['x := '] + x) evaluate.

Esciuta scrive: x ? 1 ? 0, linea-nova. 

>> y := (Dizziunariu novu) mette: (Lista ← 1) à: (Lista ← 2).
Esciuta scrive: y, linea-nova. 

(['y := '] + y) testu evaluate.

Esciuta scrive: (y à: (Lista ← 2) testu ), linea-nova.

Esciuta scrive: (Lista novu), linea-nova. 
Esciuta scrive: (Dizziunariu novu), linea-nova. 
