>> t := Nunda.

# you can control the time zone for
# parsing like this:
Mumentu zona: ['CET'].
t := Mumentu da: ['1981-02-03 04:05:06'].
Esciuta scrive: t, linea-nova.

# now using CEST time zone:
Mumentu zona: ['CEST'].
t := Mumentu da: ['1981-02-03 04:05:06'].
Esciuta scrive: t, linea-nova.

# error if string cannot be parsed
{ Mumentu da: ['1900']. } catturà: { Nunda. }, lancià.
