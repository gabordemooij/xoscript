
Testu quandu: ['html'] fà: { <- (
		sè
		rimpiazzà: ['&'] cù: ['&amp;'],
		rimpiazzà: ['<'] cù: ['&lt;'],
		rimpiazzà: ['>'] cù: ['&gt;'],
		rimpiazzà: ['"'] cù: ['&quot;']
	).
}.

>> HtmlBrush := Ughjettu novu.

HtmlBrush quandu: ['risponde:'] fà: { :tag
	Esciuta scrive: (['<tag>↵'] tag: tag ).
}.

HtmlBrush quandu: ['risponde:è:'] fà: { :tag :content
	tag := ( tag da: 0 lunghezza: (tag lunghezza - 1) ).
	Esciuta scrive: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush quandu: ['content:'] fà: { :text
	Esciuta scrive: text html, linea-nova.
}.

HtmlBrush quandu: ['attr:value:'] fà: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush novu.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
