>> Greeter := Ughjettu novu.
Greeter quandu: ['make'] fà: {
	>> greeter := Ughjettu novu.
	greeter quandu: ['name:'] fà: { :nome
		Esciuta scrive: ['setting a name'].
		propiu myName := nome.
	}.
	greeter quandu: ['greet'] fà: {
		Esciuta scrive: ['Hello'].
		Esciuta scrive: propiu myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
