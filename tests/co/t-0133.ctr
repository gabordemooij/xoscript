


>> Deck := Lista novu.
Deck quandu: ['print'] fà: {
        >> len := sè cuntà - 1.
        { :i
                >> len2 := sè cuntà - 1.
                Esciuta scrive: ['len: '].
                Esciuta scrive: len, linea-nova.
                Esciuta scrive: ['len2: '].
                Esciuta scrive: len2, linea-nova.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
