# test number -> string -> number
{

	>> x := Numeru trà: 0 è: 1000000.
	>> d := Numeru trà: 1 è: 7.
	>> e := 10 putenza: d.

	x divide-per: e.
	>> y := x testu numeru.

	(x = y) falsu: {
		Esciuta scrive: x, linea-nova.
		Esciuta scrive: y, linea-nova.
		Prugramma finisci.
	}.

} * 1000.
Esciuta scrive: ['OK'], linea-nova.