
Testu quandu: ['evaluate'] fà: {
	>> codice := Schedariu novu: ['/tmp/eval.ctr'].
	codice scrive: (sè testu + ['.']).
	Prugramma aduprà: ['/tmp/eval.ctr'].
}.

>> map :=
	(Dizziunariu novu)
	mette: ['Hi There'] à: ['two'],
	mette: (Lista ← ['hello'] ; ['world'] ; (Lista ← 1 ; 2; 9) ; Falsu) à: ['one'],
	mette: ( (Dizziunariu novu) mette: ['wrrld'] à: ['misspelled'] ) à: ['three'],
	mette: (Lista ← ((Dizziunariu novu) mette: ['treasure'] à: ['hidden']) ; 2) à: ['four']. 
>> str := map testu.
>> map2 := Nunda.
(['map2 := '] + str ) evaluate.
Esciuta scrive: map2 ? ['one'] ? 0.
Esciuta scrive: map2 ? ['one'] ? 1.
Esciuta scrive: map2 ? ['four'] ? 0 ? ['hidden'].
Esciuta scrive: map2 ? ['one'] ? 2 ? 2.
