Esciuta scrive: ['Test object'], linea-nova.
>> a := Ughjettu novu. 

a quandu: ['item:'] fà: { :booleanu
	propiu booleanu := booleanu. 
}.

a quandu: ['item'] fà: { <- propiu booleanu.
}.

a item: Veru.

Esciuta scrive: a item, linea-nova.

>> old-bool-address := a item prototipu indirizzu-di-memoria.
a save-as: ['/tmp/a.bin'].
Esciuta scrive: ['========== RELOADING SNAP:'], linea-nova.

>> b := Ughjettu load-from: ['/tmp/a.bin'].

(b item prototipu indirizzu-di-memoria = old-bool-address) veru: {
	Esciuta scrive: ['Object link re-attached.'], linea-nova.
}.

Esciuta scrive: b item, linea-nova.
