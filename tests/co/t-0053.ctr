60 × {
	>> x := (Numeru random % 6) + 1.
	(x ≤ 6) falsu: { Esciuta scrive: ['FAIL']. }.
	(x ≥0) falsu: { Esciuta scrive: ['FAIL']. }.
	x := (Numeru random % 3) + 1.
	(x < 3) falsu: { Esciuta scrive: ['FAIL']. }.
	(x>-1) falsu: { Esciuta scrive: ['FAIL']. }.
	x := ((Booleanu flip) numeru).
	(x = 0 o: x = 1) falsu: { Esciuta scrive: ['FAIL']. }.
	x := ((Veru flip) numeru).
	(x = 0 o: x = 1) falsu: { Esciuta scrive: ['FAIL']. }.
	x := (Booleanu flip o: ['HEAD'] o: ['TAIL']).
	((x = ['HEAD']) o: (x = ['TAIL'])) falsu: { Esciuta scrive: ['FAIL']. }.
}.
Esciuta scrive: ['DONE'].

