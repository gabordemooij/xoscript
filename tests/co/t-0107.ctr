
Esciuta scrive: ['Break for-loop, 0-4.'], linea-nova.
{ :i
	Esciuta scrive: ['iteration #'] + i, linea-nova.
	(i = 4) interrompe.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Esciuta scrive: ['Break while-true loop, 0-4.'], linea-nova.
{
	Esciuta scrive: ['iteration #'] + x, linea-nova.
	x aghjunghje: 1.
	((x < 5) nò) interrompe.
} mentre: xIsLessThan10.

Esciuta scrive: ['Break while-false loop, 5,4.'], linea-nova.
{
	Esciuta scrive: ['iteration #'] + x, linea-nova.
	x sottrae: 1.
	(x = 3) interrompe.
} mentre: { <- (x > 0). }.

Esciuta scrive: ['Break times loop, 1-4.'], linea-nova.
{ :i
	Esciuta scrive: ['iteration #'] + i, linea-nova.
	(i = 4) interrompe.
} × 5.

Esciuta scrive: ['Break block, dont print line.'], linea-nova.
{ Veru interrompe. Esciuta scrive: ['dont write this!'], linea-nova. } lancià.

Esciuta scrive: ['Break block, dont fire catch...'], linea-nova.
{ Veru interrompe. Esciuta scrive: ['dont write this!'], linea-nova. } catturà: { Esciuta scrive: ['Dont catch this!']. }, lancià.

Esciuta scrive: ['Test Array each-loop: 0,1'], linea-nova.
(Lista ← 1 ; 2 ; 3) trasfurmà: { :i
	Esciuta scrive: ['iteration #'] + i, linea-nova.
	(i = 1) interrompe.
}.

Esciuta scrive: ['Test Map each-loop: c only'], linea-nova.
>> m := Dizziunariu novu.
m mette: ['first'] à: ['a'], mette: ['second'] à: ['b'], mette: ['third'] à: ['c'].
m ognunu: { :k :v
	Esciuta scrive: ['iteration'] + v + k, linea-nova.
	Veru interrompe.
}.

