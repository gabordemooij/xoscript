Esciuta scrive: ['Continue for-loop, No - before 6 and up.'], linea-nova.
{ :i
	Esciuta scrive: (i + 1), linea-nova.
	((i + 1) > 4) cuntinuà.
	Esciuta scrive: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Esciuta linea-nova.
Esciuta scrive: ['Continue while-true, No --> before 5 and up.'], linea-nova.
{
	Esciuta scrive: ['iteration #'] + x, linea-nova.
	x aghjunghje: 1.
	((x < 5) nò) cuntinuà.
	Esciuta scrive: ['-->'].
} mentre: xIsLessThan10.
Esciuta linea-nova.
Esciuta scrive: ['Continue while-false, No - before 3 only.'], linea-nova.
{
	Esciuta scrive: ['iteration #'] + x, linea-nova.
	x sottrae: 1.
	(x = 3) cuntinuà.
	Esciuta scrive: ['-'].
} mentre: { <- ( x > 0). }.

Esciuta linea-nova.
Esciuta scrive: ['Continue times-loop, No ||| before 3.'], linea-nova.
{ :i
	Esciuta scrive: ['iteration #'] + i, linea-nova.
	(i = 2) cuntinuà.
	Esciuta scrive: ['|||'].
} × 5.

Esciuta linea-nova.

{ Veru cuntinuà. Esciuta scrive: ['dont write this!'], linea-nova. } lancià.

{ Veru cuntinuà. Esciuta scrive: ['dont write this!'], linea-nova. } catturà: { Esciuta scrive: ['Dont catch this!']. }, lancià.

Esciuta scrive: ['Test Array each-loop: 0, ... ,2'], linea-nova.
(Lista ← 1 ; 2 ; 3) trasfurmà: { :i
	(i = 1) cuntinuà.
	Esciuta scrive: ['iteration #'] + (i - 0), linea-nova.
}.

Esciuta scrive: ['Test Map each-loop: c only'], linea-nova.
>> m := Dizziunariu novu.
m mette: ['first'] à: ['a'], mette: ['second'] à: ['b'], mette: ['third'] à: ['c'].
m ognunu: { :k :v
	(k ≠ ['c']) cuntinuà.
	Esciuta scrive: ['iteration'] + k + v, linea-nova.
}.

