Server init.

>> DB := Maria-DB novu ospite: ['localhost'],
	nome-di-utilizatore: ['xo'],
	parolla-secreta: ['pass123'],
	nome-di-basa: ['xobase'],
	cunnette.

{
	DB richiesta:
	['DROP TABLE movies'],
	eseguisce.
} catturà: { Nunda. }, lancià.

DB richiesta:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
eseguisce.

DB richiesta: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parametri: ( Lista novu ; ['Halloween'] ),
eseguisce.

DB richiesta: ['SELECT * FROM movies'],
ricuperà: { :movie
	Esciuta scrive: movie title, linea-nova.
}.

