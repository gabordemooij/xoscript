
>> Greeter := Ughjettu novu.
Greeter quandu: ['novu'] fà: {
	propiu nome := ['?'].
}.
Greeter quandu: ['name:'] fà: { :nome
	propiu nome := nome.
}.
Greeter quandu: ['greet'] fà: {
	Esciuta scrive: (['hello[you]'] [you]: propiu nome).
}.
>> friend := Greeter novu.
friend name: ['1'].
friend greet.
