# Can we use UTF8 in regex?
Server init.
>> p := Mudellu novu: ['\\w'].
Esciuta scrive: ( p currispundenza: ['x'] ), linea-nova.
Esciuta scrive: ( p currispundenza: ['é'] ), linea-nova.
>> p := Mudellu novu: ['(*UTF)(*UCP)\\w'].
Esciuta scrive: ( p currispundenza: ['é'] ), linea-nova.
# should give 101