>> winery := { <- (	Dizziunariu novu
		mette: 2 à: ['merlot'],
		mette: 3 à: ['malbec'],
		mette: 4 à: ['syrah']
	).
}.

Esciuta scrive: (((winery lancià) - ['nothing']) cuntà), linea-nova.
Esciuta scrive: (((winery lancià) - ['merlot']) cuntà), linea-nova.
Esciuta scrive: (((winery lancià) - ['malbec']) cuntà), linea-nova.
Esciuta scrive: (((winery lancià) - ['syrah']) cuntà), linea-nova.
Esciuta scrive: (((winery lancià) - ['merlot'] - ['malbec']) cuntà), linea-nova.
Esciuta scrive: (((winery lancià) - ['merlot'] - ['syrah']) cuntà), linea-nova.
Esciuta scrive: (((winery lancià) - ['malbec'] -['syrah']) cuntà), linea-nova.
Esciuta scrive: (((winery lancià) - ['malbec'] - ['syrah'] - ['merlot']) cuntà), linea-nova.

