# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Cascia-forte 
	riassuntu-parolla-secreta: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Cascia-forte 
	riassuntu-parolla-secreta: hash verificà: a1.
	# fail 
>> b := Cascia-forte
	riassuntu-parolla-secreta: hash verificà: a2.
	# ok!

Esciuta scrive: a, linea-nova.
Esciuta scrive: b, linea-nova.

