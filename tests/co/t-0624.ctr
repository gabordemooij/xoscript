# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := Ughjettu novu.

Log quandu: ['say:'] fà: { :str
	Esciuta scrive: str, linea-nova.
}.

>> Item := Ughjettu novu.

Item quandu: ['novu:'] fà: { :id <- sè novu id: id.
}.

Item quandu: ['id:'] fà: { :id
	propiu id := id.
}.

Item quandu: ['id'] fà: { <- propiu id. }.


Item quandu: ['testu'] fà: {
	>> str := ['Item#~no'].
	str ~no: propiu id. <- str.
}.


>> Print := Ughjettu novu.

Print quandu: ['items'] fà: { 
	
	propiu item := Item novu: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: propiu item
	).
	
	
}.

Print items.