# backslashes must survive code serialization, strings must not end early
>> valori := Lista novu
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

valori ognunu: { :i :value
	>> d := Dizziunariu novu.
	d mette: value à: ['k'].
	>> r := d codice ughjettu.
	Esciuta scrive: r cuntà, linea-nova.
	Esciuta scrive: ( (r à: ['k']) = value ), linea-nova.
}.
