# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> caminu-di-schedariu := ['/tmp/dat.csv'].
>> csv := Schedariu novu: caminu-di-schedariu.
csv scrive: s.

# accepts CRLF LF CR, varying row length
csv separatore: [';'] virgulette: ['"'] linee: { :line
	Prugramma pulisce.
	Esciuta scrive: line, linea-nova.
	Prugramma pulisce.
}.

# unequal lines
s aghjunghje-à-a-fine: ['\njustone'].
csv scrive: s.
{
	csv separatore: [';'] virgulette: ['"'] linee: { :line
		Esciuta scrive: line, linea-nova.
	}.
} catturà: { :e 
	Esciuta scrive: e, linea-nova.
}, lancià.

# invalid format
s := ['"he"llo";world'].
csv scrive: s.
{
	csv separatore: [';'] virgulette: ['"'] linee: { :line
		Esciuta scrive: line, linea-nova.
	}.
} catturà: { :e 
	Esciuta scrive: e, linea-nova.
}, lancià.
