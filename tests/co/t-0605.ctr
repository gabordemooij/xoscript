>> invoice := Ughjettu novu.
invoice quandu: ['lancià'] fà: {
        propiu numeru := 0.
}.

invoice quandu: ['numeru'] fà: {
        propiu numeru aghjunghje: 1. <- propiu numeru cupià.
}.

>> year-invoice := invoice novu.
year-invoice quandu: ['start:'] fà: { :annu
	propiu numeru := annu.
}.

year-invoice start: 202000.
Esciuta scrive: year-invoice numeru, linea-nova.
Esciuta scrive: year-invoice numeru, linea-nova.
