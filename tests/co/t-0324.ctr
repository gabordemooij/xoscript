>> Animal := Ughjettu novu.
>> Factory := Ughjettu novu.

Animal quandu: ['novu'] fà: {
	>> animal := sè novu.
	animal sound: ['?']. <- animal.
}.

Animal quandu: ['sound:'] fà: { :s
	propiu sound := s.
}.

Animal quandu: ['sound'] fà: { <- propiu sound.
}.

>> Dog := Ughjettu novu.
>> Cat := Ughjettu novu.

Dog quandu: ['novu'] fà: { <- Animal novu sound: ['woof!'].
}.

Cat quandu: ['novu'] fà: { <- Animal novu sound: ['meow!'].
}.

Esciuta scrive: Dog novu sound, linea-nova.
Esciuta scrive: Cat novu sound, linea-nova.

Factory quandu: ['mix:and:'] fà: { :beast1 :beast2 <- Animal novu sound: (
		( beast1 sound da: 0 lunghezza: 2 ) +
		( beast2 sound da: 2 lunghezza: 5 )
	).
}.

Esciuta scrive: (Factory mix: Dog novu and: Cat novu) sound, linea-nova.
