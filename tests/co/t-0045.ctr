Prugramma gestione-memoria: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } catturà: {
		oops aghjunghje: 1.
	}, lancià.
} × 1000.

{
	Esciuta scrive: ['hi there!'].
	sta-faccenda errore: ['oops'].
	Esciuta scrive: ['hi there!'].
	{ Esciuta scrive: ['dont print this']. } lancià.
} catturà: { :e 
	Esciuta scrive: ['got ya!']. 
	Esciuta scrive: e.
}, lancià.
