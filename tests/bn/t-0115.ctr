{
	এই-কাজ ত্রুটি: ['Dont fail.'].
	unknown doSomething.
} ধরো: {
	আউটপুট লেখো: ['Caught!'].
}, চালাও.

{
	এই-কাজ ত্রুটি: ['Dont fail.'].
	নিজের unknown doSomething.
} ধরো: {
	আউটপুট লেখো: ['Caught!'].
}, চালাও.

{
	এই-কাজ ত্রুটি: ['Dont fail.'].
	unknown := 122.
} ধরো: {
	আউটপুট লেখো: ['Caught!'].
}, চালাও.


{
	এই-কাজ ত্রুটি: ['Dont fail.'].
	সত্য থামাও.
	আউটপুট লেখো: ['FAIL'].
} ধরো: {
	আউটপুট লেখো: ['Caught!'].
}, চালাও.

{
	{
		এই-কাজ ত্রুটি: ['Dont fail.'].
		সত্য থামাও.
		আউটপুট লেখো: ['FAIL'].
	} ধরো: { :x
		(x = ['Dont fail.']) সত্য-হলে: { এই-কাজ ত্রুটি: ['Nested Caught!']. }.
	}, চালাও.
} ধরো: { :e
	আউটপুট লেখো: e.
}, চালাও.
