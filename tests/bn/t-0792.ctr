Server init.

>> ডিবি-সংযোগ := Maria-DB নতুন হোস্ট: ['localhost'],
	ব্যবহারকারী-নাম: ['xo'],
	পাসওয়ার্ড: ['pass123'],
	ডেটাবেস-নাম: ['xobase'],
	যুক্ত-হও.
	
>> SQL := ['SELECT "hello" AS "world" '].

# দ্রুততর উপায়, ডিবি-সংযোগ থেকে কোয়েরি নাও:
>> কোয়েরি2 := ডিবি-সংযোগ কোয়েরি: SQL.

# এখন আর ডিবি-সংযোগ সেট করতে হবে না
কোয়েরি2 আনো: { :সারি
	আউটপুট লেখো: সারি world, নতুন-লাইন.
}.
