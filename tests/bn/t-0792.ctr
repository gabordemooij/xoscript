Server init.

>> DB := Maria-DB নতুন হোস্ট: ['localhost'],
	ব্যবহারকারী-নাম: ['xo'],
	পাসওয়ার্ড: ['pass123'],
	ডেটাবেস-নাম: ['xobase'],
	যুক্ত-হও.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB কোয়েরি: SQL.

# now you don't have to set DB
query2 আনো: { :row
	আউটপুট লেখো: row world, নতুন-লাইন.
}.
