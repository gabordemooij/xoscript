>> echo := বস্তু নতুন.
echo যখন: ['উত্তর:'] করো: { :sound
	{ আউটপুট লেখো: sound. } × 2.
}.
echo ho!. 


echo := বস্তু নতুন.
echo যখন: ['উত্তর:এবং:'] করো: { :sound :x
	{ আউটপুট লেখো: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := বস্তু নতুন.
echo যখন: ['উত্তর:এবং:এবং:'] করো: { :operation :sound :x
	{ আউটপুট লেখো: sound. } × x.
}.
echo shout: ['la'] times: 4. 


