পাঠ যখন: ['html'] করো: { <- (
		নিজে
		বদলাও: ['&'] দিয়ে: ['&amp;'],
		বদলাও: ['<'] দিয়ে: ['&lt;'],
		বদলাও: ['>'] দিয়ে: ['&gt;'],
		বদলাও: ['''] দিয়ে: ['&apos;'],
		বদলাও: ['"'] দিয়ে: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

প্রোগ্রাম মেমরি-ব্যবস্থাপনা: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
আউটপুট লেখো: txt অনুলিপি html, নতুন-লাইন.
আউটপুট লেখো: txt অনুলিপি ছোট-হাতের, নতুন-লাইন.
আউটপুট লেখো: txt অনুলিপি বড়-হাতের, নতুন-লাইন.
} চালাও.

প্রোগ্রাম পরিষ্কার.

usedMemory1 := (প্রোগ্রাম মেমরি ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
আউটপুট লেখো: txt অনুলিপি html, নতুন-লাইন.
আউটপুট লেখো: txt অনুলিপি ছোট-হাতের, নতুন-লাইন.
আউটপুট লেখো: txt অনুলিপি বড়-হাতের, নতুন-লাইন.
} চালাও.

প্রোগ্রাম পরিষ্কার.
usedMemory2 := (প্রোগ্রাম মেমরি ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
আউটপুট লেখো: txt অনুলিপি html, নতুন-লাইন.
আউটপুট লেখো: txt অনুলিপি ছোট-হাতের, নতুন-লাইন.
আউটপুট লেখো: txt অনুলিপি বড়-হাতের, নতুন-লাইন.
} চালাও.

প্রোগ্রাম পরিষ্কার.
usedMemory3 := (প্রোগ্রাম মেমরি ? 0).



( usedMemory1 = usedMemory2 এবং: usedMemory1 = usedMemory3, এবং: usedMemory2 = usedMemory3 ) সত্য-হলে: {
	আউটপুট লেখো: ['No memory leaks here'].
}, মিথ্যা-হলে: {
	আউটপুট লেখো: ['Leaking memory...'].
}.
