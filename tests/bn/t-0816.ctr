# a format must fit the type of the value, the type can come from a client
>> চেষ্টা := { :format :value
	{ আউটপুট লেখো: ( (বিন্যাস নতুন: format) প্রয়োগ: value ), নতুন-লাইন. } ধরো: { :e আউটপুট লেখো: e, নতুন-লাইন. }, চালাও.
}.
>> try-int := { :format :value
	{ আউটপুট লেখো: ( (বিন্যাস নতুন: format) প্রয়োগ-পূর্ণসংখ্যা: value ), নতুন-লাইন. } ধরো: { :e আউটপুট লেখো: e, নতুন-লাইন. }, চালাও.
}.

# fits
চেষ্টা প্রয়োগ: ['|%s|'] এবং: ['text'].
চেষ্টা প্রয়োগ: ['%06.2f'] এবং: 5.5.
চেষ্টা প্রয়োগ: ['100%% %s'] এবং: ['sure'].
try-int প্রয়োগ: ['%03d'] এবং: 7.
try-int প্রয়োগ: ['%x'] এবং: 255.
চেষ্টা প্রয়োগ: ['%d'] এবং: (Int64 নতুন পাঠ-থেকে: ['12']).
চেষ্টা প্রয়োগ: ['%lld'] এবং: (Int64 নতুন পাঠ-থেকে: ['12']).
চেষ্টা প্রয়োগ: ['%.1lf'] এবং: 5.5.
try-int প্রয়োগ: ['%hd'] এবং: 7.

# does not fit
চেষ্টা প্রয়োগ: ['%s'] এবং: 12345.
চেষ্টা প্রয়োগ: ['%d'] এবং: 12345.
চেষ্টা প্রয়োগ: ['%f'] এবং: ['text'].
try-int প্রয়োগ: ['%d'] এবং: ['text'].
try-int প্রয়োগ: ['%s'] এবং: 5.
চেষ্টা প্রয়োগ: ['%s %s'] এবং: ['text'].
চেষ্টা প্রয়োগ: ['%n'] এবং: ['text'].
চেষ্টা প্রয়োগ: ['%*s'] এবং: ['text'].
চেষ্টা প্রয়োগ: ['%'] এবং: ['text'].

# length modifier does not fit
চেষ্টা প্রয়োগ: ['%ls'] এবং: ['text'].
চেষ্টা প্রয়োগ: ['%Lf'] এবং: 5.5.
try-int প্রয়োগ: ['%ld'] এবং: 7.
try-int প্রয়োগ: ['%lld'] এবং: 7.
চেষ্টা প্রয়োগ: ['%Ld'] এবং: (Int64 নতুন পাঠ-থেকে: ['12']).

# a width that does not fit printf must give an error, not a crash
চেষ্টা প্রয়োগ: ['%99999999999s'] এবং: ['text'].
