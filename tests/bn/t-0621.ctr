>> phrases := লিস্ট নতুন
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases প্রতিটি: { :_ :phrase 
	>> e := Server base64-এনকোড: phrase.
	>> d := Server base64-ডিকোড: e.
	আউটপুট লেখো: (
		message অনুলিপি ~encoded: e, ~decoded: d
	), নতুন-লাইন.
}.
