>> বাক্যাংশগুলো := লিস্ট নতুন
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> বার্তাটি := ['Phrase: ~decoded base64: ~encoded'].
	
বাক্যাংশগুলো প্রতিটি: { :_ :বাক্যাংশ 
	>> e := Server base64-এনকোড: বাক্যাংশ.
	>> d := Server base64-ডিকোড: e.
	আউটপুট লেখো: (
		বার্তাটি অনুলিপি ~encoded: e, ~decoded: d
	), নতুন-লাইন.
}.
