

>> obj := বস্তু নতুন.

obj যখন: ['greet'] করো: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj যখন: ['task'] করো: {
	নিজের property := 123.
	{
		# try binds self/own to object instead of block
		আউটপুট লেখো: নিজে greet.
		আউটপুট লেখো: নিজের property.
		1 / 0.
	} ধরো: {
		আউটপুট লেখো: নিজে greet.
		আউটপুট লেখো: নিজের property.
		আউটপুট লেখো: ['ok'].
	}, চেষ্টা.
}.

obj task.