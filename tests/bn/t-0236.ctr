>> চুমুক := বস্তু নতুন.
চুমুক যখন: ['নতুন'] করো: {
	নিজের str := [''].
}.


চুমুক যখন: ['উত্তর:'] করো: { :blah
		(নিজের str ≠ ['']) সত্য-হলে: {
			নিজের str শেষে-যোগ: [' '].
		}.
		নিজের str শেষে-যোগ: blah.
}.
চুমুক যখন: ['উত্তর:এবং:'] করো: { :blah :blahah
		(নিজের str ≠ ['']) সত্য-হলে: {
			নিজের str শেষে-যোগ: [' '].
		}.
		(blah দৈর্ঘ্য > 1) সত্য-হলে: {
			নিজের str শেষে-যোগ: (blah শুরু: 0 দৈর্ঘ্য: (blah দৈর্ঘ্য - 1)).
		}, নতুবা: {
			নিজের str শেষে-যোগ: blah.
		}.
		নিজের str শেষে-যোগ: [' '].
		নিজের str শেষে-যোগ: blahah.
}.
চুমুক যখন: ['সংগ্রহ-করো'] করো: {
	>> বাফার := নিজের str.
	নিজের str := ['']. <- বাফার.
}.

>> অনুসন্ধান-প্যারামিটার := চুমুক নতুন.
অনুসন্ধান-প্যারামিটার select: ['*'], from ব্যবহারকারীরা where: ['id = 2'].
আউটপুট লেখো: (অনুসন্ধান-প্যারামিটার সংগ্রহ-করো), নতুন-লাইন.
