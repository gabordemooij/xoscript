>> Greeter := বস্তু নতুন.
Greeter যখন: ['make'] করো: {
	>> gr := বস্তু নতুন.
	gr যখন: ['setName:'] করো: { :aname
		নিজের নাম := aname.
	}.
	gr যখন: ['greet'] করো: {
		আউটপুট লেখো: নিজের নাম.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a নতুন.
c setName: ['THREE'].
c greet.
>> d := a নতুন.
d setName: ['FOUR'].
d greet.
c greet.
