# test qualifiers

>> $ := বস্তু নতুন.

$ যখন: ['উত্তর:'] করো: { :x
	
	>> operation := x অক্ষর: 0.
	>> valuta := x অক্ষর: 1.
	>> money := x বাদ-দাও: 2.
	
	>> amount := 0.

	( operation = ['+'] ) সত্য-হলে: {
		( valuta = ['£'] ) সত্য-হলে: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

আউটপুট লেখো: x, নতুন-লাইন.


>> Fruit := বস্তু নতুন.

Fruit যখন: ['নতুন'] করো: {
	>> f := নিজে নতুন.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit যখন: ['apples:'] করো: { :a নিজের apples := a. }.
Fruit যখন: ['oranges:'] করো: { :p নিজের oranges := p. }.
Fruit যখন: ['apples'] করো: { <- নিজের apples. }.
Fruit যখন: ['oranges'] করো: { <- নিজের oranges. }.

Fruit যখন: ['+'] করো: { :f
	
	>> n := Fruit নতুন.
	f যোগ: 1.
	
	n apples: (f apples + নিজের apples).
	n oranges:  (f oranges  + নিজের oranges). <- n.
}.

Fruit যখন: ['পাঠে'] করো: { <- ( নিজের apples পাঠে + [' apples and '] + নিজের oranges + [' oranges'] ).
}.

সংখ্যা যখন: ['apples'] করো: { <- ((Fruit নতুন) apples: নিজে).
}.

সংখ্যা যখন: ['apple'] করো: { <- ((Fruit নতুন) apples: নিজে).
}.

সংখ্যা যখন: ['oranges'] করো: { <- ((Fruit নতুন) oranges: নিজে).
}.




আউটপুট লেখো: (1 apple + 3 oranges + 4 apples), নতুন-লাইন.


পাঠ যখন: ['twice'] করো: { <- ((নিজে পাঠে) + (নিজে পাঠে)).
}.



আউটপুট লেখো: ['❤❤❤'] twice.



