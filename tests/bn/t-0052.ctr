>> items := অভিধান নতুন.
items রাখো: ['green'] চাবিতে: ['color-1'].
items রাখো: ['orange'] চাবিতে: ['color-2'].
items রাখো: ['red'] চাবিতে: ['color-3'].
>> i := 0.
>> s := [''].
items প্রতিটি: { :key :color
	আউটপুট লেখো: ['color #'] + i + [' is: '] + color + [' '].
	i যোগ: 1.
}.
আউটপুট লেখো: i + [' colors!'].
