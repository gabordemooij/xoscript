>> items := অভিধান নতুন.
items রাখো: ['সবুজ'] চাবিতে: ['color-1'].
items রাখো: ['কমলা'] চাবিতে: ['color-2'].
items রাখো: ['লাল'] চাবিতে: ['color-3'].
>> i := 0.
>> s := [''].
items প্রতিটি: { :key :রং
	আউটপুট লেখো: ['color #'] + i + [' হলো: '] + রং + [' '].
	i যোগ: 1.
}.
আউটপুট লেখো: i + [' টি রং!'].
