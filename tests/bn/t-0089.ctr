>> randomizer := { :a :b
	>> সর্বনিম্ন := ( a < b ) এটি: a নয়তো: b.
	>> সর্বোচ্চ := ( a > b ) এটি: a নয়তো: b.
	>> x := শূন্য.
	{
		x := সংখ্যা মধ্যে: a থেকে: b.
		((x < সর্বনিম্ন) অথবা: (x > সর্বোচ্চ)) সত্য-হলে: { 
			আউটপুট লেখো: (['Invalid value!']).
			প্রোগ্রাম শেষ.
		}.
	} 
	× 100. <- x.
}.
