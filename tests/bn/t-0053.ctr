60 × {
	>> x := (সংখ্যা random % 6) + 1.
	(x ≤ 6) মিথ্যা-হলে: { আউটপুট লেখো: ['FAIL']. }.
	(x ≥0) মিথ্যা-হলে: { আউটপুট লেখো: ['FAIL']. }.
	x := (সংখ্যা random % 3) + 1.
	(x < 3) মিথ্যা-হলে: { আউটপুট লেখো: ['FAIL']. }.
	(x>-1) মিথ্যা-হলে: { আউটপুট লেখো: ['FAIL']. }.
	x := ((বুলিয়ান flip) সংখ্যায়).
	(x = 0 অথবা: x = 1) মিথ্যা-হলে: { আউটপুট লেখো: ['FAIL']. }.
	x := ((সত্য flip) সংখ্যায়).
	(x = 0 অথবা: x = 1) মিথ্যা-হলে: { আউটপুট লেখো: ['FAIL']. }.
	x := (বুলিয়ান flip এটি: ['HEAD'] নয়তো: ['TAIL']).
	((x = ['HEAD']) অথবা: (x = ['TAIL'])) মিথ্যা-হলে: { আউটপুট লেখো: ['FAIL']. }.
}.
আউটপুট লেখো: ['DONE'].

