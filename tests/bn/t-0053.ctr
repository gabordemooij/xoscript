60 × {
	>> x := (সংখ্যা এলোমেলো-সংখ্যা % 6) + 1.
	(x ≤ 6) মিথ্যা-হলে: { আউটপুট লেখো: ['ব্যর্থ']. }.
	(x ≥0) মিথ্যা-হলে: { আউটপুট লেখো: ['ব্যর্থ']. }.
	x := (সংখ্যা এলোমেলো-সংখ্যা % 3) + 1.
	(x < 3) মিথ্যা-হলে: { আউটপুট লেখো: ['ব্যর্থ']. }.
	(x>-1) মিথ্যা-হলে: { আউটপুট লেখো: ['ব্যর্থ']. }.
	x := ((বুলিয়ান উল্টাও) সংখ্যায়).
	(x = 0 অথবা: x = 1) মিথ্যা-হলে: { আউটপুট লেখো: ['ব্যর্থ']. }.
	x := ((সত্য উল্টাও) সংখ্যায়).
	(x = 0 অথবা: x = 1) মিথ্যা-হলে: { আউটপুট লেখো: ['ব্যর্থ']. }.
	x := (বুলিয়ান উল্টাও এটি: ['হেড'] নয়তো: ['টেল']).
	((x = ['হেড']) অথবা: (x = ['টেল'])) মিথ্যা-হলে: { আউটপুট লেখো: ['ব্যর্থ']. }.
}.
আউটপুট লেখো: ['সম্পন্ন'].

