# পরীক্ষা সংখ্যা -> পাঠ -> সংখ্যা
{

	>> x := সংখ্যা মধ্যে: 0 থেকে: 1000000.
	>> d := সংখ্যা মধ্যে: 1 থেকে: 7.
	>> e := 10 ঘাত: d.

	x ভাগ: e.
	>> y := x পাঠে সংখ্যায়.

	(x = y) মিথ্যা-হলে: {
		আউটপুট লেখো: x, নতুন-লাইন.
		আউটপুট লেখো: y, নতুন-লাইন.
		প্রোগ্রাম শেষ.
	}.

} * 1000.
আউটপুট লেখো: ['OK'], নতুন-লাইন.