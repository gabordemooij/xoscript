# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> ফাইল-পথ := ['/tmp/dat.csv'].
>> csv := ফাইল নতুন: ফাইল-পথ.
csv লেখো: s.

# accepts CRLF LF CR, varying row length
csv বিভাজক: [';'] উদ্ধৃতি: ['"'] লাইনগুলো: { :line
	প্রোগ্রাম পরিষ্কার.
	আউটপুট লেখো: line, নতুন-লাইন.
	প্রোগ্রাম পরিষ্কার.
}.

# unequal lines
s শেষে-যোগ: ['\njustone'].
csv লেখো: s.
{
	csv বিভাজক: [';'] উদ্ধৃতি: ['"'] লাইনগুলো: { :line
		আউটপুট লেখো: line, নতুন-লাইন.
	}.
} ধরো: { :e 
	আউটপুট লেখো: e, নতুন-লাইন.
}, চালাও.

# invalid format
s := ['"he"llo";world'].
csv লেখো: s.
{
	csv বিভাজক: [';'] উদ্ধৃতি: ['"'] লাইনগুলো: { :line
		আউটপুট লেখো: line, নতুন-লাইন.
	}.
} ধরো: { :e 
	আউটপুট লেখো: e, নতুন-লাইন.
}, চালাও.
