# স্বাভাবিক প্রবাহ
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> ফাইল-পথ := ['/tmp/dat.csv'].
>> csv := ফাইল নতুন: ফাইল-পথ.
csv লেখো: s.

# CRLF LF CR গ্রহণ করে, সারির দৈর্ঘ্য ভিন্ন হতে পারে
csv বিভাজক: [';'] উদ্ধৃতি: ['"'] লাইনগুলো: { :line
	প্রোগ্রাম পরিষ্কার.
	আউটপুট লেখো: line, নতুন-লাইন.
	প্রোগ্রাম পরিষ্কার.
}.

# অসমান লাইন
s শেষে-যোগ: ['\njustone'].
csv লেখো: s.
{
	csv বিভাজক: [';'] উদ্ধৃতি: ['"'] লাইনগুলো: { :line
		আউটপুট লেখো: line, নতুন-লাইন.
	}.
} ধরো: { :e 
	আউটপুট লেখো: e, নতুন-লাইন.
}, চালাও.

# অবৈধ বিন্যাস
s := ['"he"llo";world'].
csv লেখো: s.
{
	csv বিভাজক: [';'] উদ্ধৃতি: ['"'] লাইনগুলো: { :line
		আউটপুট লেখো: line, নতুন-লাইন.
	}.
} ধরো: { :e 
	আউটপুট লেখো: e, নতুন-লাইন.
}, চালাও.
