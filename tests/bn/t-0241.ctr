

পাঠ যখন: ['মূল্যায়ন-করো'] করো: {
	>> কোড := ফাইল নতুন: ['/tmp/eval.ctr'].
	কোড লেখো: (নিজে পাঠে + ['.']).
	প্রোগ্রাম ব্যবহার: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := লিস্ট ← (['উদ্ধৃতি '] + Q + [' কি খারাপ?']) ; 1.
>> x := q পাঠে.
আউটপুট লেখো: x, নতুন-লাইন.
>> y := শূন্য.
(['y := '] + x ) মূল্যায়ন-করো.
আউটপুট লেখো: y ? 0, নতুন-লাইন.

q := অভিধান রাখো: ['\[''] চাবিতে: ['\['quote\']'].
x := q পাঠে.
আউটপুট লেখো: x, নতুন-লাইন.
y := শূন্য.
(['y := '] + x ) মূল্যায়ন-করো.

>> q := (অভিধান নতুন) রাখো:['\[''] চাবিতে:['\['quote\[''].
আউটপুট লেখো: y ? ['\['quote\']'], নতুন-লাইন.
