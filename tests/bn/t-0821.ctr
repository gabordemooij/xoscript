# a quote that never closes must give an error, not an endless loop
>> ফাইল-পথ := ['/tmp/test0821.csv'].
>> file := ফাইল নতুন: ফাইল-পথ.

file লেখো: ['a,b\n"1,2\n'].
{
	file বিভাজক: [','] উদ্ধৃতি: ['"'] লাইনগুলো: { :line
		আউটপুট লেখো: line, নতুন-লাইন.
	}.
} ধরো: { :e আউটপুট লেখো: e, নতুন-লাইন. }, চালাও.

# a closed quote still works
file লেখো: ['a,b\n"1,2",3'].
file বিভাজক: [','] উদ্ধৃতি: ['"'] লাইনগুলো: { :line
	আউটপুট লেখো: line, নতুন-লাইন.
}.
file মুছো.
