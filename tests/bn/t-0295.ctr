
>> dictionary := (
	অভিধান নতুন
		রাখো: ['b'] চাবিতে: ['a'],
		রাখো: ['a'] চাবিতে: ['b'],
		রাখো: ['z'] চাবিতে: ['x'],
		রাখো: ['hello'] চাবিতে: ['hallo'],
		রাখো: ['human'] চাবিতে: ['human']
).

>> comparisons := লিস্ট নতুন.
dictionary প্রতিটি: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a তুলনা: b)
	).
}.

comparisons সাজাও: { :a :b <- ( a তুলনা: b ). }.
আউটপুট লেখো: ( comparisons জোড়া-দাও: ['↵'] ), নতুন-লাইন.
comparisons জোড়া-দাও: ['↵'].
