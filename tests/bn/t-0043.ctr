>> repeater := বস্তু নতুন.
repeater যখন: ['উত্তর:'] করো: { :what
	আউটপুট লেখো: what + [' '].
}.
repeater যখন: ['উত্তর:এবং:'] করো: { :what :say
	আউটপুট লেখো: what, লেখো: say + [' '].
}.
repeater যখন: ['উত্তর:এবং:এবং:'] করো: { :what :say :more
	আউটপুট লেখো: what, লেখো: say, লেখো: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
