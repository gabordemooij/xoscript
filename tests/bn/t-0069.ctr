

পাঠ যখন: ['html'] করো: { <- (
		নিজে
		বদলাও: ['&'] দিয়ে: ['&amp;'],
		বদলাও: ['<'] দিয়ে: ['&lt;'],
		বদলাও: ['>'] দিয়ে: ['&gt;'],
		বদলাও: ['"'] দিয়ে: ['&quot;']
	).
}.


আউটপুট লেখো: ([' left trimmed '] ছাঁটো) + [' '] + ( ['and right trimmed'] ছাঁটো) + ['!'], নতুন-লাইন.
আউটপুট লেখো: ['<html>"html & entities"</html>'] html.
