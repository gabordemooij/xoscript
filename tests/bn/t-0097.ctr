
পাঠ যখন: ['html'] করো: { <- (
		নিজে
		বদলাও: ['&'] দিয়ে: ['&amp;'],
		বদলাও: ['<'] দিয়ে: ['&lt;'],
		বদলাও: ['>'] দিয়ে: ['&gt;'],
		বদলাও: ['"'] দিয়ে: ['&quot;']
	).
}.

>> HtmlBrush := বস্তু নতুন.

HtmlBrush যখন: ['উত্তর:'] করো: { :tag
	আউটপুট লেখো: (['<tag>↵'] tag: tag ).
}.

HtmlBrush যখন: ['উত্তর:এবং:'] করো: { :tag :content
	tag := ( tag শুরু: 0 দৈর্ঘ্য: (tag দৈর্ঘ্য - 1) ).
	আউটপুট লেখো: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush যখন: ['content:'] করো: { :text
	আউটপুট লেখো: text html, নতুন-লাইন.
}.

HtmlBrush যখন: ['attr:value:'] করো: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush নতুন.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
