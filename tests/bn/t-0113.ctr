আউটপুট লেখো: ['for-লুপ চালাও, না - 6 ও তার পরে.'], নতুন-লাইন.
{ :i
	আউটপুট লেখো: (i + 1), নতুন-লাইন.
	((i + 1) > 4) চালিয়ে-যাও.
	আউটপুট লেখো: ['-'].
} × 10.

>> x := 0.
>> x-কি-কম10 := { <- ( x < 10 ). }.
আউটপুট নতুন-লাইন.
আউটপুট লেখো: ['while-true চালাও, না --> 5 ও তার পরে.'], নতুন-লাইন.
{
	আউটপুট লেখো: ['iteration #'] + x, নতুন-লাইন.
	x যোগ: 1.
	((x < 5) বিপরীত) চালিয়ে-যাও.
	আউটপুট লেখো: ['-->'].
} যতক্ষণ: x-কি-কম10.
আউটপুট নতুন-লাইন.
আউটপুট লেখো: ['while-false চালাও, না - শুধু 3 এর আগে.'], নতুন-লাইন.
{
	আউটপুট লেখো: ['iteration #'] + x, নতুন-লাইন.
	x বিয়োগ: 1.
	(x = 3) চালিয়ে-যাও.
	আউটপুট লেখো: ['-'].
} যতক্ষণ: { <- ( x > 0). }.

আউটপুট নতুন-লাইন.
আউটপুট লেখো: ['times-লুপ চালাও, না ||| 3 এর আগে.'], নতুন-লাইন.
{ :i
	আউটপুট লেখো: ['iteration #'] + i, নতুন-লাইন.
	(i = 2) চালিয়ে-যাও.
	আউটপুট লেখো: ['|||'].
} × 5.

আউটপুট নতুন-লাইন.

{ সত্য চালিয়ে-যাও. আউটপুট লেখো: ['এটা লিখো না!'], নতুন-লাইন. } চালাও.

{ সত্য চালিয়ে-যাও. আউটপুট লেখো: ['এটা লিখো না!'], নতুন-লাইন. } ধরো: { আউটপুট লেখো: ['এটা ধরো না!']. }, চালাও.

আউটপুট লেখো: ['অ্যারে each-লুপ পরীক্ষা: 0, ... ,2'], নতুন-লাইন.
(লিস্ট ← 1 ; 2 ; 3) রূপান্তর: { :i
	(i = 1) চালিয়ে-যাও.
	আউটপুট লেখো: ['iteration #'] + (i - 0), নতুন-লাইন.
}.

আউটপুট লেখো: ['ম্যাপ each-লুপ পরীক্ষা: শুধু c'], নতুন-লাইন.
>> m := অভিধান নতুন.
m রাখো: ['first'] চাবিতে: ['a'], রাখো: ['second'] চাবিতে: ['b'], রাখো: ['তৃতীয়'] চাবিতে: ['c'].
m প্রতিটি: { :k :v
	(k ≠ ['c']) চালিয়ে-যাও.
	আউটপুট লেখো: ['iteration'] + k + v, নতুন-লাইন.
}.

