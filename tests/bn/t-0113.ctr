আউটপুট লেখো: ['Continue for-loop, No - before 6 and up.'], নতুন-লাইন.
{ :i
	আউটপুট লেখো: (i + 1), নতুন-লাইন.
	((i + 1) > 4) চালিয়ে-যাও.
	আউটপুট লেখো: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
আউটপুট নতুন-লাইন.
আউটপুট লেখো: ['Continue while-true, No --> before 5 and up.'], নতুন-লাইন.
{
	আউটপুট লেখো: ['iteration #'] + x, নতুন-লাইন.
	x যোগ: 1.
	((x < 5) বিপরীত) চালিয়ে-যাও.
	আউটপুট লেখো: ['-->'].
} যতক্ষণ: xIsLessThan10.
আউটপুট নতুন-লাইন.
আউটপুট লেখো: ['Continue while-false, No - before 3 only.'], নতুন-লাইন.
{
	আউটপুট লেখো: ['iteration #'] + x, নতুন-লাইন.
	x বিয়োগ: 1.
	(x = 3) চালিয়ে-যাও.
	আউটপুট লেখো: ['-'].
} যতক্ষণ: { <- ( x > 0). }.

আউটপুট নতুন-লাইন.
আউটপুট লেখো: ['Continue times-loop, No ||| before 3.'], নতুন-লাইন.
{ :i
	আউটপুট লেখো: ['iteration #'] + i, নতুন-লাইন.
	(i = 2) চালিয়ে-যাও.
	আউটপুট লেখো: ['|||'].
} × 5.

আউটপুট নতুন-লাইন.

{ সত্য চালিয়ে-যাও. আউটপুট লেখো: ['dont write this!'], নতুন-লাইন. } চালাও.

{ সত্য চালিয়ে-যাও. আউটপুট লেখো: ['dont write this!'], নতুন-লাইন. } ধরো: { আউটপুট লেখো: ['Dont catch this!']. }, চালাও.

আউটপুট লেখো: ['Test Array each-loop: 0, ... ,2'], নতুন-লাইন.
(লিস্ট ← 1 ; 2 ; 3) রূপান্তর: { :i
	(i = 1) চালিয়ে-যাও.
	আউটপুট লেখো: ['iteration #'] + (i - 0), নতুন-লাইন.
}.

আউটপুট লেখো: ['Test Map each-loop: c only'], নতুন-লাইন.
>> m := অভিধান নতুন.
m রাখো: ['first'] চাবিতে: ['a'], রাখো: ['second'] চাবিতে: ['b'], রাখো: ['third'] চাবিতে: ['c'].
m প্রতিটি: { :k :v
	(k ≠ ['c']) চালিয়ে-যাও.
	আউটপুট লেখো: ['iteration'] + k + v, নতুন-লাইন.
}.

