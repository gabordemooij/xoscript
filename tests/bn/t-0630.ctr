#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := প্যাটার্ন নতুন: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern মিল: subject করো: { :m :x
	আউটপুট লেখো: m, নতুন-লাইন.
	আউটপুট লেখো: x, নতুন-লাইন. <- ['XXX'].
}.
আউটপুট লেখো: result, নতুন-লাইন.