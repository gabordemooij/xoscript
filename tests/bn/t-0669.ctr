# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := সিন্দুক 
	পাসওয়ার্ড-হ্যাশ: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := সিন্দুক 
	পাসওয়ার্ড-হ্যাশ: hash যাচাই: a1.
	# fail 
>> b := সিন্দুক
	পাসওয়ার্ড-হ্যাশ: hash যাচাই: a2.
	# ok!

আউটপুট লেখো: a, নতুন-লাইন.
আউটপুট লেখো: b, নতুন-লাইন.

