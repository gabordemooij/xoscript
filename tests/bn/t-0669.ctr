# পাসওয়ার্ড হ্যাশিং
Server init.

# ব্যবহারকারী একটি পাসওয়ার্ড সেট করে
>> পাস := ['pass123'].

# তুমি এটি এভাবে সংরক্ষণ করো
>> হ্যাশ-মান := সিন্দুক 
	পাসওয়ার্ড-হ্যাশ: পাস.

# তারপর ব্যবহারকারী লগ ইন করে
# চেষ্টা 1
>> a1 := ['abcd123'].
# চেষ্টা 2
>> a2 := ['pass123'].

# যাচাই
>> a := সিন্দুক 
	পাসওয়ার্ড-হ্যাশ: হ্যাশ-মান যাচাই: a1.
	# ব্যর্থ 
>> b := সিন্দুক
	পাসওয়ার্ড-হ্যাশ: হ্যাশ-মান যাচাই: a2.
	# ঠিক আছে!

আউটপুট লেখো: a, নতুন-লাইন.
আউটপুট লেখো: b, নতুন-লাইন.

