

>> ব্যবহৃত-মেমরি1 := 0.
>> ব্যবহৃত-মেমরি2 := 0.
>> ব্যবহৃত-মেমরি3 := 0.
>> ব্যবহৃত-মেমরি4 := 0.

>> x := 100.

প্রোগ্রাম মেমরি-ব্যবস্থাপনা: 0.

{
>> txt := ['ওহে '] + ['world'].
txt := txt + [' - পাঠ কি ব্যবহার করা যায়.. '].
txt := txt + ['লিক না করে '] + x + ['টি বাইট ?'].
txt শেষে-যোগ: ['!!'].
আউটপুট লেখো: txt.
} চালাও.

প্রোগ্রাম পরিষ্কার.

ব্যবহৃত-মেমরি1 := (প্রোগ্রাম মেমরি ? 0).


{
>> txt := ['ওহে '] + ['world'].
txt := txt + [' - পাঠ কি ব্যবহার করা যায়.. '].
txt := txt + ['লিক না করে '] + x + ['টি বাইট ?'].
txt শেষে-যোগ: ['!!'].
আউটপুট লেখো: txt.
} চালাও.

প্রোগ্রাম পরিষ্কার.
ব্যবহৃত-মেমরি2 := (প্রোগ্রাম মেমরি ? 0).


{
>> txt := ['ওহে '] + ['world'].
txt := txt + [' - পাঠ কি ব্যবহার করা যায়.. '].
txt := txt + ['লিক না করে '] + x + ['টি বাইট ?'].
txt শেষে-যোগ: ['!!'].
আউটপুট লেখো: txt.
} চালাও.

প্রোগ্রাম পরিষ্কার.
ব্যবহৃত-মেমরি3 := (প্রোগ্রাম মেমরি ? 0).



( ব্যবহৃত-মেমরি1 = ব্যবহৃত-মেমরি2 এবং: ব্যবহৃত-মেমরি1 = ব্যবহৃত-মেমরি3, এবং: ব্যবহৃত-মেমরি2 = ব্যবহৃত-মেমরি3 ) সত্য-হলে: {
	আউটপুট লেখো: ['এখানে মেমরি লিক নেই'].
}, মিথ্যা-হলে: {
	আউটপুট লেখো: ['মেমরি লিক হচ্ছে...'].
}.
