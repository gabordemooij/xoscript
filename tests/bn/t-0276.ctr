>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := বস্তু নতুন.
⚄ যখন: ['drawFrom:length:'] করো: { :pool :গণনা
	
	>> result := [''].
	
	{
		>> index := সংখ্যা random % (pool দৈর্ঘ্য).
		result শেষে-যোগ: ( pool অক্ষর: (index + 1) ).
		
	} × গণনা. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? দৈর্ঘ্য.
আউটপুট লেখো: (['x↵'] x random দৈর্ঘ্য).
আউটপুট লেখো: (['y↵'] y ?? দৈর্ঘ্য).

