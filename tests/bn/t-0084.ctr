>> makeAdder := { :x
	>> f := { :y <- (নিজের x + y). } নির্ধারণ: ['x'] মান: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i নিজের q রাখো: (নিজের f প্রয়োগ: (নিজের q ? i)) চাবিতে: i. } 
	নির্ধারণ: ['q'] মান: array,
	নির্ধারণ: ['f'] মান: func.
	{ :i mapping প্রয়োগ: i. } × (array গণনা).
}.

>> a := লিস্ট ← 1; 2; 3.
mapper প্রয়োগ: a এবং: (makeAdder প্রয়োগ: 100).
আউটপুট লেখো: (a অবস্থান: 0), নতুন-লাইন.
আউটপুট লেখো: (a ? 1), নতুন-লাইন.
আউটপুট লেখো: (a ? 2), নতুন-লাইন.
