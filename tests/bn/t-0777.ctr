#OBSD
>> dirname := [''].
{ dirname শেষে-যোগ: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
প্রোগ্রাম সিস্টেম: command.
প্রোগ্রাম chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename শেষে-যোগ: ['YYYYYYYY']. } * 20.
ফাইল নতুন: filename, লেখো: ['sometext'].
{ ফাইল তালিকা: ['/tmp/'] + dirname. } * 1000.
আউটপুট লেখো: ['no crash'], নতুন-লাইন.

