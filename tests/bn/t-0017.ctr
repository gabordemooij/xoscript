সংখ্যা যখন: ['ফ্যাক্টরিয়াল'] করো: {
	>> মোট := 1.
	{ :সূচক মোট গুণ: (নিজে - (সূচক)). } × নিজে. <- মোট.
}.

>> a := 3 + 2 + 10 + 1 - 3.
আউটপুট লেখো: a.
>> b := 2 + 3 ফ্যাক্টরিয়াল.
আউটপুট লেখো: b.
>> c := 3 ফ্যাক্টরিয়াল + 2.
আউটপুট লেখো: c.
>> d := 2 + (3 ফ্যাক্টরিয়াল).
আউটপুট লেখো: d.
আউটপুট লেখো: 2 + 3 ফ্যাক্টরিয়াল + 1.
