>> চুমুক := বস্তু নতুন.

চুমুক যখন: ['নতুন'] করো: {
	নিজের str := [''].
}.

চুমুক যখন: ['উত্তর:'] করো: { :blah
		(নিজের str = ['']) সত্য-হলে: {
			নিজের str শেষে-যোগ: blah.
		}, নতুবা: {
			নিজের str শেষে-যোগ: [' '].
			নিজের str শেষে-যোগ: blah.
		}.
}.

চুমুক যখন: ['উত্তর:এবং:'] করো: { :blah :blahah
		(blah দৈর্ঘ্য > 1) সত্য-হলে: {
			নিজের str শেষে-যোগ: (blah শুরু: 0 দৈর্ঘ্য: (blah দৈর্ঘ্য - 1)).
		}, নতুবা: {
			নিজের str শেষে-যোগ: blah.
		}.
		নিজের str শেষে-যোগ: [' '].
		নিজের str শেষে-যোগ: blahah.
}.

চুমুক যখন: ['সংগ্রহ-করো'] করো: {
	>> বাফার := নিজের str.
	নিজের str := ['']. <- বাফার.
}.


>> x := চুমুক নতুন.
x + 3.
আউটপুট লেখো: (x সংগ্রহ-করো), নতুন-লাইন.
x echo: ['হ্যালো জগৎ'].
আউটপুট লেখো: (x সংগ্রহ-করো), নতুন-লাইন.
x tellme: 123 and: 987.
আউটপুট লেখো: (x সংগ্রহ-করো), নতুন-লাইন.
