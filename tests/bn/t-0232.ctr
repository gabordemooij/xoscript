>> Slurp := বস্তু নতুন.

Slurp যখন: ['নতুন'] করো: {
	নিজের str := [''].
}.

Slurp যখন: ['উত্তর:'] করো: { :blah
		(নিজের str = ['']) সত্য-হলে: {
			নিজের str শেষে-যোগ: blah.
		}, নতুবা: {
			নিজের str শেষে-যোগ: [' '].
			নিজের str শেষে-যোগ: blah.
		}.
}.

Slurp যখন: ['উত্তর:এবং:'] করো: { :blah :blahah
		(blah দৈর্ঘ্য > 1) সত্য-হলে: {
			নিজের str শেষে-যোগ: (blah শুরু: 0 দৈর্ঘ্য: (blah দৈর্ঘ্য - 1)).
		}, নতুবা: {
			নিজের str শেষে-যোগ: blah.
		}.
		নিজের str শেষে-যোগ: [' '].
		নিজের str শেষে-যোগ: blahah.
}.

Slurp যখন: ['obtain'] করো: {
	>> buffer := নিজের str.
	নিজের str := ['']. <- buffer.
}.


>> x := Slurp নতুন.
x + 3.
আউটপুট লেখো: (x obtain), নতুন-লাইন.
x echo: ['Hello world'].
আউটপুট লেখো: (x obtain), নতুন-লাইন.
x tellme: 123 and: 987.
আউটপুট লেখো: (x obtain), নতুন-লাইন.
