

লিস্ট যখন: ['column:'] করো: { :কলাম
	>> ফল := লিস্ট নতুন.
	নিজে প্রতিটি: { :সূচক :সারি
		সারি প্রতিটি: { :সূচক :ঘর
			(সূচক = কলাম) সত্য-হলে: { ফল শেষে-যোগ: ঘর. }.
		}.
	}. <- ফল.
}.


>> a := লিস্ট ←
	(লিস্ট ← 1 ; 2 ; 3) ;
	(লিস্ট ← 4 ; 5 ; 6) ;
	(লিস্ট ← 7 ; 8 ; 9).

>> b := a column: 1.
আউটপুট লেখো: b, নতুন-লাইন.

b := a column: 20.
আউটপুট লেখো: b, নতুন-লাইন.

b := a column: -100.
আউটপুট লেখো: b, নতুন-লাইন.
