>> Slurp := বস্তু নতুন.
Slurp যখন: ['নতুন'] করো: {
	নিজের str := [''].
}.
Slurp শেখো: ['nieuw'] অর্থ: ['নতুন'].
Slurp যখন: ['উত্তর:'] করো: { :blah
		(নিজের str ≠ ['']) সত্য-হলে: {
			নিজের str শেষে-যোগ: [' '].
		}.
		নিজের str শেষে-যোগ: blah.
}.
Slurp যখন: ['উত্তর:এবং:'] করো: { :blah :blahah
		(নিজের str ≠ ['']) সত্য-হলে: {
			নিজের str শেষে-যোগ: [' '].
		}.
		(blah দৈর্ঘ্য > 1) সত্য-হলে: {
			নিজের str শেষে-যোগ: (blah শুরু: 0 দৈর্ঘ্য: (blah দৈর্ঘ্য - 1)).
		}, নতুবা: {
			নিজের str শেষে-যোগ: blah.
		}.
		নিজের str শেষে-যোগ: [' '].
		নিজের str শেষে-যোগ: blahah.
}.
Slurp যখন: ['obtain'] করো: {
	>> buffer := নিজের str.
	নিজের str := ['']. <- buffer.
}.


>> অনুসন্ধান-প্যারামিটার := Slurp নতুন
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

আউটপুট লেখো: অনুসন্ধান-প্যারামিটার obtain, নতুন-লাইন.
