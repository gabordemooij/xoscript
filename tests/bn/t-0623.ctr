

>> g  := Server নতুন.
>> v  := সিন্দুক নতুন.
>> ঠিক := 0.

>> গোপনগুলো := লিস্ট নতুন ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> পাসওয়ার্ডগুলো := গোপনগুলো অনুলিপি.
পাসওয়ার্ডগুলো প্রতিটি: { :i :p
	গোপনগুলো প্রতিটি: { :n :s
		{
			>> এনক্রিপ্টকৃত := v এনক্রিপ্ট: s চাবি: p.
			>> ডিক্রিপ্টকৃত := v ডিক্রিপ্ট: এনক্রিপ্টকৃত চাবি: p.
			(ডিক্রিপ্টকৃত = s) সত্য-হলে: {
				ঠিক যোগ: 1.
			}, নতুবা: {
				আউটপুট লেখো: ['এনক্রিপ্ট/ডিক্রিপ্ট ব্যর্থ: '], নতুন-লাইন.
				আউটপুট লেখো: s, নতুন-লাইন.
				আউটপুট লেখো: ['এনক্রিপ্টকৃত: '] + এনক্রিপ্টকৃত, নতুন-লাইন.
				আউটপুট লেখো: ['ডিক্রিপ্টকৃত: '] + এনক্রিপ্টকৃত, নতুন-লাইন.
				প্রোগ্রাম শেষ.
			}.
		} ধরো: { :ত্রু
			(s = [''] অথবা: p = ['']) সত্য-হলে: {
				ঠিক যোগ: 1.
			}, নতুবা: {
				আউটপুট লেখো: ত্রু, নতুন-লাইন.
				প্রোগ্রাম শেষ.
			}.
		}, চালাও.
	}.
}.

আউটপুট লেখো: ( ঠিক + [' টি সিন্দুক এনক্রিপশন পরীক্ষিত.'] ), নতুন-লাইন.