

>> g := Server নতুন.
>> v := সিন্দুক নতুন.
>> ok := 0.

>> secrets := লিস্ট নতুন ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> passwords := secrets অনুলিপি.
passwords প্রতিটি: { :i :p
	secrets প্রতিটি: { :n :s
		{
			>> encrypted := v এনক্রিপ্ট: s চাবি: p.
			>> decrypted := v ডিক্রিপ্ট: encrypted চাবি: p.
			(decrypted = s) সত্য-হলে: {
				ok যোগ: 1.
			}, নতুবা: {
				আউটপুট লেখো: ['failed encrypting/decrypting: '], নতুন-লাইন.
				আউটপুট লেখো: s, নতুন-লাইন.
				আউটপুট লেখো: ['encrypted: '] + encrypted, নতুন-লাইন.
				আউটপুট লেখো: ['decrypted: '] + encrypted, নতুন-লাইন.
				প্রোগ্রাম শেষ.
			}.
		} ধরো: { :err
			(s = [''] অথবা: p = ['']) সত্য-হলে: {
				ok যোগ: 1.
			}, নতুবা: {
				আউটপুট লেখো: err, নতুন-লাইন.
				প্রোগ্রাম শেষ.
			}.
		}, চালাও.
	}.
}.

আউটপুট লেখো: ( ok + [' vault encryptions tested.'] ), নতুন-লাইন.