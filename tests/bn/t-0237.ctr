
পাঠ যখন: ['evaluate'] করো: {
	>> কোড := ফাইল নতুন: ['/tmp/eval.ctr'].
	কোড লেখো: (নিজে পাঠে + ['.']).
	প্রোগ্রাম ব্যবহার: ['/tmp/eval.ctr'].
}.

>> map :=
	(অভিধান নতুন)
	রাখো: ['Hi There'] চাবিতে: ['two'],
	রাখো: (লিস্ট ← ['hello'] ; ['world'] ; (লিস্ট ← 1 ; 2; 9) ; মিথ্যা) চাবিতে: ['one'],
	রাখো: ( (অভিধান নতুন) রাখো: ['wrrld'] চাবিতে: ['misspelled'] ) চাবিতে: ['three'],
	রাখো: (লিস্ট ← ((অভিধান নতুন) রাখো: ['treasure'] চাবিতে: ['hidden']) ; 2) চাবিতে: ['four']. 
>> str := map পাঠে.
>> map2 := শূন্য.
(['map2 := '] + str ) evaluate.
আউটপুট লেখো: map2 ? ['one'] ? 0.
আউটপুট লেখো: map2 ? ['one'] ? 1.
আউটপুট লেখো: map2 ? ['four'] ? 0 ? ['hidden'].
আউটপুট লেখো: map2 ? ['one'] ? 2 ? 2.
