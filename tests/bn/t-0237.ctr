
পাঠ যখন: ['মূল্যায়ন-করো'] করো: {
	>> কোড := ফাইল নতুন: ['/tmp/eval.ctr'].
	কোড লেখো: (নিজে পাঠে + ['.']).
	প্রোগ্রাম ব্যবহার: ['/tmp/eval.ctr'].
}.

>> map :=
	(অভিধান নতুন)
	রাখো: ['ওহে, হাই'] চাবিতে: ['two'],
	রাখো: (লিস্ট ← ['hello'] ; ['world'] ; (লিস্ট ← 1 ; 2; 9) ; মিথ্যা) চাবিতে: ['এক'],
	রাখো: ( (অভিধান নতুন) রাখো: ['দুনিয়ে'] চাবিতে: ['ভুল-বানান'] ) চাবিতে: ['three'],
	রাখো: (লিস্ট ← ((অভিধান নতুন) রাখো: ['গুপ্তধন'] চাবিতে: ['লুকানো']) ; 2) চাবিতে: ['চার']. 
>> str := map পাঠে.
>> map2 := শূন্য.
(['map2 := '] + str ) মূল্যায়ন-করো.
আউটপুট লেখো: map2 ? ['এক'] ? 0.
আউটপুট লেখো: map2 ? ['এক'] ? 1.
আউটপুট লেখো: map2 ? ['চার'] ? 0 ? ['লুকানো'].
আউটপুট লেখো: map2 ? ['এক'] ? 2 ? 2.
