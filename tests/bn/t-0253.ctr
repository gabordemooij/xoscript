#Linux
>> OS := প্রোগ্রাম সেটিং: ['OS'].

>> clock := মুহূর্ত নতুন.
	
(OS = ['Haiku']) সত্য-হলে: {
	clock সময়-অঞ্চল: ['CET'],
	বছর: 2017, মাস: 7, দিন: 13,
	ঘণ্টা: 18, মিনিট: 0, সেকেন্ড: 0.
}, নতুবা: {
	clock সময়-অঞ্চল: ['Europe/Amsterdam'],
	বছর: 2017, মাস: 7, দিন: 13,
	ঘণ্টা: 18, মিনিট: 0, সেকেন্ড: 0.
}.

clock যখন: ['tell'] করো: {
	আউটপুট লেখো: নিজে, নতুন-লাইন.
}.


clock যোগ: 2    ঘণ্টা, tell.
clock যোগ: 1    ঘণ্টা, tell.
clock যোগ: 19 মিনিট, tell.
clock যোগ: 1  মিনিট, tell.
clock যোগ: 1  মিনিট, tell.
clock যোগ: 19 সেকেন্ড, tell.
clock যোগ: 1  সেকেন্ড, tell.
clock যোগ: 1  সেকেন্ড, tell.
clock যোগ: 2    বছর, tell.
clock যোগ: 1    বছর, tell.

(OS = ['Haiku']) সত্য-হলে: {
clock যোগ: 5   মাস.
clock সময়-অঞ্চল: ['CEST'], tell.
}, নতুবা: {
	clock যোগ: 5   মাস, tell.
}.

clock যোগ: 1   মাস, tell.
clock যোগ: 19    দিন, tell.
clock যোগ: 1    ঘণ্টা, tell.
clock যোগ: 120  yard, tell.
