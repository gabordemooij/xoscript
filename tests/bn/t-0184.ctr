

>> ব্যবহৃত-মেমরি1 := 0.
>> ব্যবহৃত-মেমরি2 := 0.
>> ব্যবহৃত-মেমরি3 := 0.
>> ব্যবহৃত-মেমরি4 := 0.

প্রোগ্রাম মেমরি-ব্যবস্থাপনা: 0.

সংখ্যা যখন: ['addNum:'] করো: { :x
	নিজে যোগ: x.
}.

সংখ্যা যখন: ['subtractNum:'] করো: { :x
	নিজে বিয়োগ: x.
}.

সংখ্যা যখন: ['multiplyBy:'] করো: { :x
	নিজে গুণ: x.
}.

সংখ্যা যখন: ['divideBy:'] করো: { :x
	নিজে ভাগ: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 ঘাত: 8).  
a := a + (2 ঘাত: -1). 
a := a + (49 বর্গমূল).   
a addNum: ((লিস্ট ← 0 ; 1) সর্বোচ্চ).          
a addNum: ((লিস্ট ← 2 ; 3) সর্বনিম্ন).
আউটপুট লেখো: a.

প্রোগ্রাম পরিষ্কার.

ব্যবহৃত-মেমরি1 := (প্রোগ্রাম মেমরি ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 ঘাত: 8).  
a := a + (2 ঘাত: -1). 
a := a + (49 বর্গমূল).   
a addNum: ((লিস্ট ← 0 ; 1) সর্বোচ্চ).          
a addNum: ((লিস্ট ← 2 ; 3) সর্বনিম্ন).
আউটপুট লেখো: a.

প্রোগ্রাম পরিষ্কার.
ব্যবহৃত-মেমরি2 := (প্রোগ্রাম মেমরি ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 ঘাত: 8).  
a := a + (2 ঘাত: -1). 
a := a + (49 বর্গমূল).   
a addNum: ((লিস্ট ← 0 ; 1) সর্বোচ্চ).          
a addNum: ((লিস্ট ← 2 ; 3) সর্বনিম্ন).
আউটপুট লেখো: a.

প্রোগ্রাম পরিষ্কার.
ব্যবহৃত-মেমরি3 := (প্রোগ্রাম মেমরি ? 0).



( ব্যবহৃত-মেমরি1 = ব্যবহৃত-মেমরি2 এবং: ব্যবহৃত-মেমরি1 = ব্যবহৃত-মেমরি3, এবং: ব্যবহৃত-মেমরি2 = ব্যবহৃত-মেমরি3 ) সত্য-হলে: {
	আউটপুট লেখো: ['এখানে মেমরি লিক নেই'].
}, মিথ্যা-হলে: {
	আউটপুট লেখো: ['মেমরি লিক হচ্ছে...'].
}.
