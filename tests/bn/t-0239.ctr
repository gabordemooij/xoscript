লিস্ট যখন: ['sum'] করো: {
	>> total := 0.
	নিজে প্রতিটি: { :index :element
		total যোগ: element.
	}. <- total.
}.

>> a := সত্য.



a যখন: ['পাঠে'] করো: {
	>> answer := শূন্য.
	( নিজে = সত্য ) সত্য-হলে: {
		answer := ['Yep'].
	}, নতুবা: {
		answer := ['Nope'].
	}. <- answer.
}.

a যখন: ['সংখ্যায়'] করো: {
	>> answer := শূন্য.
	( নিজে = সত্য ) সত্য-হলে: {
		answer := 10.
	}, নতুবা: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b যখন: ['পাঠে'] করো: { <- ['Devil'].
}.

b যখন: ['বুলিয়ানে'] করো: { <- মিথ্যা.
}.


আউটপুট লেখো: a, নতুন-লাইন.  
আউটপুট লেখো: (90 + a), নতুন-লাইন. 
আউটপুট লেখো: b, নতুন-লাইন. 
আউটপুট লেখো: (সত্য এবং: b), নতুন-লাইন.

a := লিস্ট ← ['hello'] ; ['world'] ; সত্য ; শূন্য ; 666. 
a := a + ( লিস্ট ← 1 ).
আউটপুট লেখো: a, নতুন-লাইন.
আউটপুট লেখো: ((অভিধান নতুন) রাখো: শূন্য চাবিতে: শূন্য), নতুন-লাইন.
আউটপুট লেখো: a sum, নতুন-লাইন. 


{
	a যখন: ['পাঠে'] করো: { <- শূন্য. }.
	a := [''] + a.
} ধরো: { :error
	আউটপুট লেখো: ['Error noted: '] + error, নতুন-লাইন.
}, চালাও.



{
	a যখন: ['সংখ্যায়'] করো: { <- শূন্য. }.
	a := 3 × a.
} ধরো: { :error
	আউটপুট লেখো: ['Error noted: '] + error, নতুন-লাইন.
}, চালাও.


{
	a যখন: ['বুলিয়ানে'] করো: { <- শূন্য. }.
	a := সত্য এবং: a. 
} ধরো: { :error
	আউটপুট লেখো: ['Error noted: '] + error, নতুন-লাইন.
}, চালাও.





