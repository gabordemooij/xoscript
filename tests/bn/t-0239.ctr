লিস্ট যখন: ['যোগফল'] করো: {
	>> মোট := 0.
	নিজে প্রতিটি: { :সূচক :উপাদান
		মোট যোগ: উপাদান.
	}. <- মোট.
}.

>> a := সত্য.



a যখন: ['পাঠে'] করো: {
	>> উত্তরটি := শূন্য.
	( নিজে = সত্য ) সত্য-হলে: {
		উত্তরটি := ['হুঁ'].
	}, নতুবা: {
		উত্তরটি := ['উঁহু'].
	}. <- উত্তরটি.
}.

a যখন: ['সংখ্যায়'] করো: {
	>> উত্তরটি := শূন্য.
	( নিজে = সত্য ) সত্য-হলে: {
		উত্তরটি := 10.
	}, নতুবা: {
		উত্তরটি := 20.
	}. <- উত্তরটি.
}.

>> b := 666.

b যখন: ['পাঠে'] করো: { <- ['শয়তান'].
}.

b যখন: ['বুলিয়ানে'] করো: { <- মিথ্যা.
}.


আউটপুট লেখো: a, নতুন-লাইন.  
আউটপুট লেখো: (90 + a), নতুন-লাইন. 
আউটপুট লেখো: b, নতুন-লাইন. 
আউটপুট লেখো: (সত্য এবং: b), নতুন-লাইন.

a := লিস্ট ← ['hello'] ; ['world'] ; সত্য ; শূন্য ; 666. 
a := a + ( লিস্ট ← 1 ).
আউটপুট লেখো: a, নতুন-লাইন.
আউটপুট লেখো: ((অভিধান নতুন) রাখো: শূন্য চাবিতে: শূন্য), নতুন-লাইন.
আউটপুট লেখো: a যোগফল, নতুন-লাইন. 


{
	a যখন: ['পাঠে'] করো: { <- শূন্য. }.
	a := [''] + a.
} ধরো: { :ত্রুটি
	আউটপুট লেখো: ['ত্রুটি লেখা হলো: '] + ত্রুটি, নতুন-লাইন.
}, চালাও.



{
	a যখন: ['সংখ্যায়'] করো: { <- শূন্য. }.
	a := 3 × a.
} ধরো: { :ত্রুটি
	আউটপুট লেখো: ['ত্রুটি লেখা হলো: '] + ত্রুটি, নতুন-লাইন.
}, চালাও.


{
	a যখন: ['বুলিয়ানে'] করো: { <- শূন্য. }.
	a := সত্য এবং: a. 
} ধরো: { :ত্রুটি
	আউটপুট লেখো: ['ত্রুটি লেখা হলো: '] + ত্রুটি, নতুন-লাইন.
}, চালাও.





{
	a যখন: ['পাঠে'] করো: { <- মিথ্যা. }.
	a := [''] + a.
} ধরো: { :ত্রুটি
	আউটপুট লেখো: ['ত্রুটি লেখা হলো: '] + ত্রুটি, নতুন-লাইন.
}, চালাও.



{
	a যখন: ['সংখ্যায়'] করো: { <- সত্য. }.
	a := 3 × a.
} ধরো: { :ত্রুটি
	আউটপুট লেখো: ['ত্রুটি লেখা হলো: '] + ত্রুটি, নতুন-লাইন.
}, চালাও.


{
	a যখন: ['boolean'] করো: { <- 1. }.
	a := সত্য এবং: a.
} ধরো: { :ত্রুটি
	আউটপুট লেখো: ['ত্রুটি লেখা হলো: '] + ত্রুটি, নতুন-লাইন.
}, চালাও.





{
	a যখন: ['পাঠে'] করো: { <- 1. }.
	a := [''] + a.
} ধরো: { :ত্রুটি
	আউটপুট লেখো: ['ত্রুটি লেখা হলো: '] + ত্রুটি, নতুন-লাইন.
}, চালাও.



{
	a যখন: ['সংখ্যায়'] করো: { <- ['']. }.
	a := 3 × a.
} ধরো: { :ত্রুটি
	আউটপুট লেখো: ['ত্রুটি লেখা হলো: '] + ত্রুটি, নতুন-লাইন.
}, চালাও.


{
	a যখন: ['boolean'] করো: { <- ['']. }.
	a := সত্য এবং: a.
} ধরো: { :ত্রুটি
	আউটপুট লেখো: ['ত্রুটি লেখা হলো: '] + ত্রুটি, নতুন-লাইন.
}, চালাও.






{
	a যখন: ['পাঠে'] করো: { <- (অভিধান নতুন). }.
	a := [''] + a. 
} ধরো: { :ত্রুটি
	আউটপুট লেখো: ['ত্রুটি লেখা হলো: '] + ত্রুটি, নতুন-লাইন.
}, চালাও.



{
	a যখন: ['সংখ্যায়'] করো: { <- (বস্তু নতুন). }.
	a := 3 × a. 
} ধরো: { :ত্রুটি
	আউটপুট লেখো: ['ত্রুটি লেখা হলো: '] + ত্রুটি, নতুন-লাইন.
}, চালাও.


{
	a যখন: ['boolean'] করো: { <- (বস্তু নতুন). }.
	a := সত্য এবং: a.
} ধরো: { :ত্রুটি
	আউটপুট লেখো: ['ত্রুটি লেখা হলো: '] + ত্রুটি, নতুন-লাইন.
}, চালাও.

