>> map1 := অভিধান নতুন.
>> key1 := লিস্ট নতুন.
>> key2 := লিস্ট নতুন.

map1
	রাখো: ['hello'] চাবিতে: key1,
	রাখো: ['world'] চাবিতে: key2.


আউটপুট
	লেখো: ['Map #1 contains: '] + (map1 এ: key1),
	লেখো: [' and '] + (map1 এ: key2), নতুন-লাইন.

>> KeyeableArray := লিস্ট নতুন.
KeyeableArray যখন: ['toString'] করো: { <- (নিজে গণনা) toString.
}.

>> map2 := অভিধান নতুন.
key1 := KeyeableArray নতুন.
key2 := KeyeableArray নতুন.

key1 শেষে-যোগ: 1.

map2
	রাখো: ['hello'] চাবিতে: key1,
	রাখো: ['world'] চাবিতে: key2.

আউটপুট
	লেখো: ['Map #2 contains: '] + (map2 এ: key1),
	লেখো: [' and '] + (map2 এ: key2), নতুন-লাইন.
