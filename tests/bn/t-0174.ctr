usedMemory3 := (প্রোগ্রাম মেমরি ? 0).



( usedMemory1 = usedMemory2 এবং: usedMemory1 = usedMemory3, এবং: usedMemory2 = usedMemory3 ) সত্য-হলে: {
	আউটপুট লেখো: ['No memory leaks here'].
}, মিথ্যা-হলে: {
	আউটপুট লেখো: ['Leaking memory...'].
}.
