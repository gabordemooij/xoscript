


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

প্রোগ্রাম মেমরি-ব্যবস্থাপনা: 0.
>> palette := শূন্য.
>> colors := শূন্য.

{
palette := অভিধান নতুন.
palette 
	রাখো: ['#F00'] চাবিতে: ['red'],
	রাখো: ['#0F0'] চাবিতে: ['green'],
	রাখো: ['#00F'] চাবিতে: ['blue'].
আউটপুট লেখো: ['number of RGB codes in palette: '] + ( palette গণনা ), নতুন-লাইন.
আউটপুট লেখো: ['RGB code of green is: '] + ( palette ? ['green'] ), নতুন-লাইন.
colors := [''].
( palette প্রতিটি: { :নাম :কোড
		colors := colors + ( নাম + [':'] + কোড ).
} ).
আউটপুট লেখো: ['All colors in palette: '] + colors, নতুন-লাইন.
} চালাও.
প্রোগ্রাম পরিষ্কার.
usedMemory1 := (প্রোগ্রাম মেমরি ? 0).

