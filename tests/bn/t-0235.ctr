>> চুমুক := বস্তু নতুন.
চুমুক যখন: ['নতুন'] করো: {
	নিজের str := [''].
}.

চুমুক যখন: ['উত্তর:'] করো: { :blah
		(নিজের str ≠ ['']) সত্য-হলে: {
			নিজের str শেষে-যোগ: [' '].
		}.
		নিজের str শেষে-যোগ: blah.
}.
চুমুক যখন: ['উত্তর:এবং:'] করো: { :blah :blahah
		(নিজের str ≠ ['']) সত্য-হলে: {
			নিজের str শেষে-যোগ: [' '].
		}.
		(blah দৈর্ঘ্য > 1) সত্য-হলে: {
			নিজের str শেষে-যোগ: (blah শুরু: 0 দৈর্ঘ্য: (blah দৈর্ঘ্য - 1)).
		}, নতুবা: {
			নিজের str শেষে-যোগ: blah.
		}.
		নিজের str শেষে-যোগ: [' '].
		নিজের str শেষে-যোগ: blahah.
}.
চুমুক যখন: ['সংগ্রহ-করো'] করো: {
	>> বাফার := নিজের str.
	নিজের str := ['']. <- বাফার.
}.

>> s := চুমুক নতুন.
s hello: ['world'].
আউটপুট লেখো: ( s সংগ্রহ-করো ), নতুন-লাইন.
