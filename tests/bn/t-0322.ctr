

>> Matryoshka := বস্তু নতুন.
Matryoshka যখন: ['double:'] করো: { :secret
	নিজের secret := secret × 2.
}.
Matryoshka যখন: ['নতুন:'] করো: { :secret
	>> answer := শূন্য.
	>> t := (secret > 255).
	আউটপুট লেখো: (secret + [' | '] + t), নতুন-লাইন.
	t সত্য-হলে: {
		answer := secret.
	}, নতুবা: {
		answer := Matryoshka পুনরাবৃত্ত নতুন: (নিজে double: secret).
	}. <- answer.
}.

>> x := Matryoshka নতুন: 2.
