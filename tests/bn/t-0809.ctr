# backslashes must survive code serialization, strings must not end early
>> মানগুলো := লিস্ট নতুন
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

মানগুলো প্রতিটি: { :i :value
	>> d := অভিধান নতুন.
	d রাখো: value চাবিতে: ['k'].
	>> r := d কোড বস্তুতে.
	আউটপুট লেখো: r গণনা, নতুন-লাইন.
	আউটপুট লেখো: ( (r এ: ['k']) = value ), নতুন-লাইন.
}.
