
>> g := ['বৈশ্বিক'].
{ >> g := ['স্থানীয়']. আউটপুট লেখো: g, নতুন-লাইন. } চালাও. 
আউটপুট লেখো: g, নতুন-লাইন. 
>> বার্তাটি := ['বিদায়'].
>> গোপন-শ্রেণি := বস্তু নতুন.
গোপন-শ্রেণি যখন: ['পরীক্ষা'] করো: {
	>> বার্তাটি := ['Hello'].
	নিজের বার্তাটি := ['World'].
	আউটপুট লেখো: বার্তাটি + [' '] + নিজের বার্তাটি, নতুন-লাইন.
}.
গোপন-শ্রেণি পরীক্ষা.
আউটপুট লেখো: বার্তাটি.
