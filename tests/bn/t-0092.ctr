
>> g := ['global'].
{ >> g := ['local']. আউটপুট লেখো: g, নতুন-লাইন. } চালাও. 
আউটপুট লেখো: g, নতুন-লাইন. 
>> message := ['Bye'].
>> Secret := বস্তু নতুন.
Secret যখন: ['পরীক্ষা'] করো: {
	>> message := ['Hello'].
	নিজের message := ['World'].
	আউটপুট লেখো: message + [' '] + নিজের message, নতুন-লাইন.
}.
Secret পরীক্ষা.
আউটপুট লেখো: message.
