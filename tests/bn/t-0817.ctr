# a value ending in the first part of an opening quote must survive serialization
>> মানগুলো := লিস্ট নতুন
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

মানগুলো প্রতিটি: { :i :value
	>> d := অভিধান নতুন.
	d রাখো: value চাবিতে: ['k'].
	d রাখো: ['second'] চাবিতে: ['j'].
	>> r := d কোড বস্তুতে.
	আউটপুট লেখো: r গণনা, নতুন-লাইন.
	আউটপুট লেখো: ( (r এ: ['k']) = value ), নতুন-লাইন.
}.
