# test catch-all methods
>> x13 := বস্তু নতুন.
x13 যখন: ['a'] করো: { :a আউটপুট লেখো: 0, নতুন-লাইন. }.
x13 যখন: ['a:'] করো: { :a আউটপুট লেখো: a, নতুন-লাইন. <- 5. }.
x13 যখন: ['a:b:'] করো: { :a :b আউটপুট লেখো: (a + b), নতুন-লাইন. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
