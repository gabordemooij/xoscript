#Linux
>> OS := প্রোগ্রাম সিস্টেম: (আদেশ uname -s), ছাঁটো.

>> চুমুক := বস্তু নতুন.
চুমুক যখন: ['নতুন'] করো: {
	নিজের str := [''].
}.
চুমুক যখন: ['উত্তর:'] করো: { :blah
		(নিজের str ≠ ['']) সত্য-হলে: {
			নিজের str শেষে-যোগ: [' '].
		}.
		নিজের str শেষে-যোগ: blah.
}.
চুমুক যখন: ['উত্তর:এবং:'] করো: { :blah :blahah
		(নিজের str ≠ ['']) সত্য-হলে: {
			নিজের str শেষে-যোগ: [' '].
		}.
		(blah দৈর্ঘ্য > 1) সত্য-হলে: {
			নিজের str শেষে-যোগ: (blah শুরু: 0 দৈর্ঘ্য: (blah দৈর্ঘ্য - 1)).
		}, নতুবা: {
			নিজের str শেষে-যোগ: blah.
		}.
		নিজের str শেষে-যোগ: [' '].
		নিজের str শেষে-যোগ: blahah.
}.
চুমুক যখন: ['সংগ্রহ-করো'] করো: {
	>> বাফার := নিজের str.
	নিজের str := ['']. <- বাফার.
}.
>> large text := [''].
{
	large text শেষে-যোগ: ['hello'].
} × 1000.


আউটপুট লেখো: (
	প্রোগ্রাম সিস্টেম: (
		চুমুক নতুন
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) সংগ্রহ-করো
).

