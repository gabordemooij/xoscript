#Linux
>> OS := প্রোগ্রাম সিস্টেম: (আদেশ uname -s), ছাঁটো.

>> Slurp := বস্তু নতুন.
Slurp যখন: ['নতুন'] করো: {
	নিজের str := [''].
}.
Slurp যখন: ['উত্তর:'] করো: { :blah
		(নিজের str ≠ ['']) সত্য-হলে: {
			নিজের str শেষে-যোগ: [' '].
		}.
		নিজের str শেষে-যোগ: blah.
}.
Slurp যখন: ['উত্তর:এবং:'] করো: { :blah :blahah
		(নিজের str ≠ ['']) সত্য-হলে: {
			নিজের str শেষে-যোগ: [' '].
		}.
		(blah দৈর্ঘ্য > 1) সত্য-হলে: {
			নিজের str শেষে-যোগ: (blah শুরু: 0 দৈর্ঘ্য: (blah দৈর্ঘ্য - 1)).
		}, নতুবা: {
			নিজের str শেষে-যোগ: blah.
		}.
		নিজের str শেষে-যোগ: [' '].
		নিজের str শেষে-যোগ: blahah.
}.
Slurp যখন: ['obtain'] করো: {
	>> buffer := নিজের str.
	নিজের str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text শেষে-যোগ: ['hello'].
} × 1000.


আউটপুট লেখো: (
	প্রোগ্রাম সিস্টেম: (
		Slurp নতুন
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

