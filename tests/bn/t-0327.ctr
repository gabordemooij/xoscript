

লিস্ট যখন: ['fixture:'] করো: { :f
	নিজের fixture := f.
}.

লিস্ট যখন: ['গণনা'] করো: { <- নিজের fixture.
}.

লিস্ট যখন: ['aantal'] করো: { <- নিজের fixture.
}.


>> x := শূন্য.
{

	x := ['hello'] 
	বদলাও:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] অক্ষর: 2)
			)
		)
	দিয়ে: (
		(['...hal'] + ['lo']) 
			বড়-হাতের 
			lowecase 
			বড়-হাতের 
			বাদ-দাও: -1 + ( 
				11 - 12 + (
					(
						(
							(
								লিস্ট ← 0 ; 1 ; 4; 9 ; (লিস্ট ← 0 ; 3; 1) ; 4
							) শেষের-আগের
						) ? 1
					) + 
					((লিস্ট ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					গণনা
				)
			)
	).

} × 10.
আউটপুট লেখো: x, নতুন-লাইন.

