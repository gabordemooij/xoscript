Server init.

>> DB := Maria-DB নতুন হোস্ট: ['localhost'],
	ব্যবহারকারী-নাম: ['xo'],
	পাসওয়ার্ড: ['pass123'],
	ডেটাবেস-নাম: ['xobase'],
	যুক্ত-হও.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> অনুসন্ধান-প্যারামিটার := Maria-কোয়েরি নতুন: SQL.

# set database
অনুসন্ধান-প্যারামিটার ডেটাবেস: DB.

অনুসন্ধান-প্যারামিটার আনো: { :row
	আউটপুট লেখো: row world, নতুন-লাইন.
}.
