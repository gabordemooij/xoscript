# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob নতুন: 8, bytes: (
	লিস্ট নতুন ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

আউটপুট লেখো: ( utf16 ডিকোড: ['utf16le'] ), নতুন-লাইন.

utf16 মুক্ত.
>> utf32 := Blob নতুন: 13, bytes: (
	লিস্ট নতুন ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

আউটপুট লেখো: ( utf32 ডিকোড: ['utf32be'] ), নতুন-লাইন.
utf32 মুক্ত.