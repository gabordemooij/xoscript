

লিস্ট যখন: ['sum'] করো: {
	>> total := 0.
	নিজে প্রতিটি: { :index :element
		total যোগ: element.
	}. <- total.
}.

লিস্ট যখন: ['product'] করো: {
	>> total := 1.
	নিজে প্রতিটি: { :index :element
		total গুণ: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

প্রোগ্রাম মেমরি-ব্যবস্থাপনা: 0.

{

>> a := লিস্ট ← ['hello'] ; ['world'] ; সত্য ; শূন্য ; 666.
a := a + ( লিস্ট ← 1 ).
আউটপুট লেখো: ( ['sum: '] + ( a sum ) ), নতুন-লাইন.
আউটপুট লেখো: ( ['min: '] + ( a সর্বনিম্ন ) ), নতুন-লাইন.
আউটপুট লেখো: ( ['max: '] + ( a সর্বোচ্চ ) ), নতুন-লাইন.
আউটপুট লেখো: ( ['3rd: '] + ( a ? 2 ) ), নতুন-লাইন.
আউটপুট লেখো: ( ['prd: '] + ( a product ) ), নতুন-লাইন.
a সাজাও: { :a :b <- (b - a). }.
a প্রতিটি: { :i :e আউটপুট লেখো: ( i - 0 ), নতুন-লাইন. }.

} চালাও.

প্রোগ্রাম পরিষ্কার.
usedMemory1 := (প্রোগ্রাম মেমরি ? 0).


{

>> a := লিস্ট ← ['hello'] ; ['world'] ; সত্য ; শূন্য ; 666.
a := a + ( লিস্ট ← 1 ).
আউটপুট লেখো: ( ['sum: '] + ( a sum ) ), নতুন-লাইন.
আউটপুট লেখো: ( ['min: '] + ( a সর্বনিম্ন ) ), নতুন-লাইন.
আউটপুট লেখো: ( ['max: '] + ( a সর্বোচ্চ ) ), নতুন-লাইন.
আউটপুট লেখো: ( ['3rd: '] + ( a ? 2 ) ), নতুন-লাইন.
আউটপুট লেখো: ( ['prd: '] + ( a product ) ), নতুন-লাইন.
a সাজাও: { :a :b <- (b - a). }.
a প্রতিটি: { :i :e আউটপুট লেখো: ( i - 0 ), নতুন-লাইন. }.

} চালাও.



প্রোগ্রাম পরিষ্কার.
usedMemory2 := (প্রোগ্রাম মেমরি ? 0).


{

>> a := লিস্ট ← ['hello'] ; ['world'] ; সত্য ; শূন্য ; 666.
a := a + ( লিস্ট ← 1 ).
আউটপুট লেখো: ( ['sum: '] + ( a sum ) ), নতুন-লাইন.
আউটপুট লেখো: ( ['min: '] + ( a সর্বনিম্ন ) ), নতুন-লাইন.
আউটপুট লেখো: ( ['max: '] + ( a সর্বোচ্চ ) ), নতুন-লাইন.
আউটপুট লেখো: ( ['3rd: '] + ( a ? 2 ) ), নতুন-লাইন.
