

লিস্ট যখন: ['যোগফল'] করো: {
	>> মোট := 0.
	নিজে প্রতিটি: { :সূচক :উপাদান
		মোট যোগ: উপাদান.
	}. <- মোট.
}.

লিস্ট যখন: ['গুণফল'] করো: {
	>> মোট := 1.
	নিজে প্রতিটি: { :সূচক :উপাদান
		মোট গুণ: উপাদান.
	}. <- মোট.
}.

>> ব্যবহৃত-মেমরি1 := 0.
>> ব্যবহৃত-মেমরি2 := 0.
>> ব্যবহৃত-মেমরি3 := 0.
>> ব্যবহৃত-মেমরি4 := 0.

প্রোগ্রাম মেমরি-ব্যবস্থাপনা: 0.

{

>> a := লিস্ট ← ['hello'] ; ['world'] ; সত্য ; শূন্য ; 666.
a := a + ( লিস্ট ← 1 ).
আউটপুট লেখো: ( ['যোগফল: '] + ( a যোগফল ) ), নতুন-লাইন.
আউটপুট লেখো: ( ['ন্যূনতম: '] + ( a সর্বনিম্ন ) ), নতুন-লাইন.
আউটপুট লেখো: ( ['সর্বোচ্চ: '] + ( a সর্বোচ্চ ) ), নতুন-লাইন.
আউটপুট লেখো: ( ['3য়: '] + ( a ? 2 ) ), নতুন-লাইন.
আউটপুট লেখো: ( ['গুণফল: '] + ( a গুণফল ) ), নতুন-লাইন.
a সাজাও: { :a :b <- (b - a). }.
a প্রতিটি: { :i :e আউটপুট লেখো: ( i - 0 ), নতুন-লাইন. }.

} চালাও.

প্রোগ্রাম পরিষ্কার.
ব্যবহৃত-মেমরি1 := (প্রোগ্রাম মেমরি ? 0).


{

>> a := লিস্ট ← ['hello'] ; ['world'] ; সত্য ; শূন্য ; 666.
a := a + ( লিস্ট ← 1 ).
আউটপুট লেখো: ( ['যোগফল: '] + ( a যোগফল ) ), নতুন-লাইন.
আউটপুট লেখো: ( ['ন্যূনতম: '] + ( a সর্বনিম্ন ) ), নতুন-লাইন.
আউটপুট লেখো: ( ['সর্বোচ্চ: '] + ( a সর্বোচ্চ ) ), নতুন-লাইন.
আউটপুট লেখো: ( ['3য়: '] + ( a ? 2 ) ), নতুন-লাইন.
আউটপুট লেখো: ( ['গুণফল: '] + ( a গুণফল ) ), নতুন-লাইন.
a সাজাও: { :a :b <- (b - a). }.
a প্রতিটি: { :i :e আউটপুট লেখো: ( i - 0 ), নতুন-লাইন. }.

} চালাও.



প্রোগ্রাম পরিষ্কার.
ব্যবহৃত-মেমরি2 := (প্রোগ্রাম মেমরি ? 0).


{

>> a := লিস্ট ← ['hello'] ; ['world'] ; সত্য ; শূন্য ; 666.
a := a + ( লিস্ট ← 1 ).
আউটপুট লেখো: ( ['যোগফল: '] + ( a যোগফল ) ), নতুন-লাইন.
আউটপুট লেখো: ( ['ন্যূনতম: '] + ( a সর্বনিম্ন ) ), নতুন-লাইন.
আউটপুট লেখো: ( ['সর্বোচ্চ: '] + ( a সর্বোচ্চ ) ), নতুন-লাইন.
আউটপুট লেখো: ( ['3য়: '] + ( a ? 2 ) ), নতুন-লাইন.
আউটপুট লেখো: ( ['গুণফল: '] + ( a গুণফল ) ), নতুন-লাইন.
a সাজাও: { :a :b <- (b - a). }.
a প্রতিটি: { :i :e আউটপুট লেখো: ( i - 0 ), নতুন-লাইন. }.

} চালাও.



প্রোগ্রাম পরিষ্কার.
ব্যবহৃত-মেমরি3 := (প্রোগ্রাম মেমরি ? 0).

( ব্যবহৃত-মেমরি1 = ব্যবহৃত-মেমরি2 এবং: ব্যবহৃত-মেমরি1 = ব্যবহৃত-মেমরি3, এবং: ব্যবহৃত-মেমরি2 = ব্যবহৃত-মেমরি3 ) সত্য-হলে: {
	আউটপুট লেখো: ['এখানে মেমরি লিক নেই'].
}, মিথ্যা-হলে: {
	আউটপুট লেখো: ['মেমরি লিক হচ্ছে...'].
}.
