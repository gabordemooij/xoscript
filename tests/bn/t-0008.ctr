>> Greeter := বস্তু নতুন.
Greeter যখন: ['make'] করো: {
	>> greeter := বস্তু নতুন.
	greeter যখন: ['name:'] করো: { :নাম
		আউটপুট লেখো: ['setting a name'].
		নিজের myName := নাম.
	}.
	greeter যখন: ['greet'] করো: {
		আউটপুট লেখো: ['Hello'].
		আউটপুট লেখো: নিজের myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
