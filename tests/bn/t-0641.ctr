# utf8 শোধক পরীক্ষা
Server init.

>> utf8-ক্ষেত্রগুলো := অভিধান নতুন
	# শুধু ASCII
	রাখো: ( লিস্ট নতুন ; 65 ; 65 ; 65 ; 65 ; 0 ) চাবিতে: ['AAAA'],
	# বৈধ 2 বাইটের ক্রম
	রাখো: ( লিস্ট নতুন ; 194 ; 162 ; 0 ) চাবিতে: ['¢'],
	# বৈধ 3-বাইট UTF-8
    রাখো: ( লিস্ট নতুন ; 226 ; 130 ; 172 ; 0 ) চাবিতে: ['€'],
	# বৈধ 4-বাইট UTF-8
    রাখো: ( লিস্ট নতুন ; 240 ; 144 ; 141 ; 136 ; 0 ) চাবিতে: ['𐍈'],
	# E2 28 AC ক্রমে অবৈধ ধারাবাহিক বাইট -> 3b ক্রমের শুরু + 28 ভুল cnt + AC cnt বাইট, তবে একই ত্রুটির অংশ
    রাখো: ( লিস্ট নতুন ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) চাবিতে: ['A?A'],
	# ASCII 'A'-এর অতিদীর্ঘ এনকোডিং (? হওয়া উচিত),
    রাখো: ( লিস্ট নতুন ; 65 ; 193 ; 129 ; 0 ) চাবিতে: ['A?'],
	# অবৈধ প্রথম বাইট (0xFF)
    রাখো: ( লিস্ট নতুন ; 255 ; 0 ) চাবিতে: ['?'],
	# শেষে অসম্পূর্ণ বহু-বাইট ক্রম
    রাখো: ( লিস্ট নতুন ; 66 ; 226 ; 0 ) চাবিতে: ['B?'],
    # খালি পাঠ
    #রাখো: ( লিস্ট নতুন ) চাবিতে: [''],
	# একাধিক মিশ্র ক্রম
    রাখো: ( লিস্ট নতুন ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) চাবিতে: ['A€?𐍈B'].
	 
utf8-ক্ষেত্রগুলো প্রতিটি: { :key :value
	>> blob := Blob নতুন: value গণনা, bytes: value.
	>> str := blob পাঠে.
	(str = key) সত্য-হলে: {
		আউটপুট লেখো: ['OK'], নতুন-লাইন.
	}, নতুবা: {
		আউটপুট লেখো: ['UTF8 শোধক ব্যর্থ: '] + key + [' পাওয়া গেল: '] + str, নতুন-লাইন.
	}.
	blob মুক্ত.
}.
