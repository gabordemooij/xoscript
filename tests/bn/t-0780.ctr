Server init.

# JSON এনকোডার শুধু UTF-8 সমর্থন করে, কোনো সারোগেট জোড়া নয়

>> অভিধানগুলো := লিস্ট নতুন ;
	# {"key":"normal"} সাধারণ ASCII
	( অভিধান নতুন রাখো: ['সাধারণ'] চাবিতে: ['key'] ) ;
	# {"key":"hello world"} ফাঁকা অক্ষর
	( অভিধান নতুন রাখো: ['hello world'] চাবিতে: ['key'] ) ;
	# {"key":"quote: \""} দ্বৈত উদ্ধৃতিচিহ্ন
	( অভিধান নতুন রাখো: ['"'] চাবিতে: ['key'] ) ;
	# {"key":"backslash: \\"} ব্যাকস্ল্যাশ
	( অভিধান নতুন রাখো: ['backslash: \\'] চাবিতে: ['key'] ) ;
	# {"key":"slash: /"} স্ল্যাশ
	( অভিধান নতুন রাখো: ['স্ল্যাশ: /'] চাবিতে: ['key'] ) ;
	# {"key":"backspace: \b"} ব্যাকস্পেস
	( অভিধান নতুন রাখো: ['backspace: \b'] চাবিতে: ['key'] ) ;
	# {"key":"formfeed: \f"} ফর্ম-ফিড এস্কেপ
	( অভিধান নতুন রাখো: ['formfeed: \f'] চাবিতে: ['key'] ) ;
	# {"key":"newline: \n"} নতুন লাইন
	( অভিধান নতুন রাখো: ['newline: \n'] চাবিতে: ['key'] ) ;
	( অভিধান নতুন রাখো: ['newline: ↵'] চাবিতে: ['key'] ) ;
	( অভিধান নতুন রাখো: ['newline: 
	'] চাবিতে: ['key'] ) ;
	# {"key":"carriage return: \r"} ক্যারেজ-রিটার্ন
	( অভিধান নতুন রাখো: ['carriage return: \r'] চাবিতে: ['key'] ) ;
	# {"key":"tab: \t"} ট্যাব
	( অভিধান নতুন রাখো: ['tab \t'] চাবিতে: ['key'] ) ;
	( অভিধান নতুন রাখো: ['tab ⇿'] চাবিতে: ['key'] ) ;
	( অভিধান নতুন রাখো: ['ট্যাব  '] চাবিতে: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( অভিধান নতুন রাখো: ['NUL \u0000'] চাবিতে: ['key'] ) ;
	( অভিধান নতুন রাখো: ['NUL \0'] চাবিতে: ['key'] ) ;
	# {"key":"control: \u0001"} নিয়ন্ত্রণ অক্ষর 0x01
	( অভিধান নতুন রাখো: ['control: \u0001'] চাবিতে: ['key'] ) ;
	# {"key":"control: \u001F"} নিয়ন্ত্রণ অক্ষর 0x1F
	( অভিধান নতুন রাখো: ['control: \u001F'] চাবিতে: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-বাইট অক্ষর
	( অভিধান নতুন রাখো: ['ইউনিকোড: é'] চাবিতে: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-বাইট অক্ষর
	( অভিধান নতুন রাখো: ['ইউনিকোড: €'] চাবিতে: ['key'] ) ;
	# {"key":"unicode: 日本語"} একাধিক 3-বাইট UTF-8 অক্ষর
	( অভিধান নতুন রাখো: ['ইউনিকোড: 日本語'] চাবিতে: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-বাইট অক্ষর
	( অভিধান নতুন রাখো: ['ইউনিকোড: 😀'] চাবিতে: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} ইমোজি + zero-width joiner
	( অভিধান নতুন রাখো: ['ইউনিকোড: 🧑‍💻'] চাবিতে: ['key'] ) ;
	# {"key":"combining: e\u0301"} সংযুক্ত উচ্চারণচিহ্ন
	( অভিধান নতুন রাখো: ['combining: e\u0301'] চাবিতে: ['key'] ) ;
	# {"key":"escaped unicode: \u00e9"} ইউনিকোড এস্কেপ BMP
	( অভিধান নতুন রাখো: ['escaped unicode: \u00e9'] চাবিতে: ['key'] ) ;
	# {"key":"escaped unicode: \u20ac"} ইউনিকোড এস্কেপ BMP
	( অভিধান নতুন রাখো: ['escaped unicode: \u20ac'] চাবিতে: ['key'] ) ;
	# {"key":"escaped unicode: \ud83d\ude00"} UTF-16 সারোগেট জোড়া
	( অভিধান নতুন রাখো: ['escaped unicode: \ud83d\ude00'] চাবিতে: ['key'] ) ;
	# {"key":""} খালি মান
	( অভিধান নতুন রাখো: [''] চাবিতে: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} বিশেষ ASCII অক্ষর
	( অভিধান নতুন রাখো: ['@ < > & = % + ? #'] চাবিতে: ['key'] ) ;
	# {"key":"single quote: '"} একক উদ্ধৃতিচিহ্ন
	( অভিধান নতুন রাখো: ['''] চাবিতে: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} একাধিক JSON এস্কেপ
	( অভিধান নতুন রাখো: ['multiple: \" \\ \n \r \t'] চাবিতে: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} দীর্ঘতর ASCII-পাঠ
	( অভিধান নতুন রাখো: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] চাবিতে: ['key'] ) ;
	# {"key":" value"} সামনের ফাঁকা
	( অভিধান নতুন রাখো: [' মান'] চাবিতে: ['key'] ) ;
	# {"key":"value "} পেছনের ফাঁকা
	( অভিধান নতুন রাখো: ['মান '] চাবিতে: ['key'] ) ;
	# {"key":" \t\n\r "} হোয়াইটস্পেস
	( অভিধান নতুন রাখো: [' \t\n\r '] চাবিতে: ['key'] )
	.

অভিধানগুলো প্রতিটি: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (অভিধান নতুন রাখো: d key চাবিতে: ['key']).
	>> b := JSON jsonify: (অভিধান নতুন রাখো: ['value'] চাবিতে: d key).
	>> e := JSON বস্তু: a.
	>> f := JSON বস্তু: b.
	((e key = d key এবং: (f ? d key = ['value'])) অথবা: (e key = ['NUL ?'])) সত্য-হলে: {
		আউটপুট লেখো: ['OK'], নতুন-লাইন.
	}, নতুবা: {
		আউটপুট লেখো: ['ঠিকভাবে এনকোড/ডিকোড করা গেল না: '] + d + j, নতুন-লাইন.
		প্রোগ্রাম শেষ.
	}.
}.
