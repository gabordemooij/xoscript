>> Animal := বস্তু নতুন.
Animal যখন: ['make'] করো: {
	>> animal := বস্তু নতুন.
	animal যখন: ['makeSound'] করো: {
		আউটপুট লেখো: নিজের sound.
	}. <- animal.
}.
>> Cat := বস্তু নতুন.
Cat যখন: ['make'] করো: {
	>> cat := Animal make.
	cat যখন: ['init'] করো: {
		নিজের sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
