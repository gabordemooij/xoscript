# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := প্যাটার্ন নতুন: pattern.
	p মিল: subject করো: { :m :g
		আউটপুট লেখো: g গণনা, লেখো: [' '], লেখো: (g জোড়া-দাও: ['|']), নতুন-লাইন. <- m.
	}.
}.
show প্রয়োগ: ['(a)|(b)'] এবং: ['b'].
show প্রয়োগ: ['(a)|(b)'] এবং: ['a'].
show প্রয়োগ: ['(x)?y'] এবং: ['y'].
show প্রয়োগ: ['(x)?(y)(z)?'] এবং: ['xy'].
