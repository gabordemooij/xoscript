# test type casts / conversions / bindings
প্রোগ্রাম মেমরি-ব্যবস্থাপনা: 4.
Server init.

>> counter := 0.
>> db := Maria-DB নতুন হোস্ট: ['localhost'],
	ব্যবহারকারী-নাম: ['xo'], পাসওয়ার্ড: ['pass123'], ডেটাবেস-নাম: ['xobase'], যুক্ত-হও.

>> TwoDigitFormat := বিন্যাস নতুন: ['%02d'].

# Datetime
{
	>> বছর := সংখ্যা মধ্যে: 1995 থেকে: 2050, পাঠে.
	>> মাস := TwoDigitFormat প্রয়োগ-পূর্ণসংখ্যা: (সংখ্যা মধ্যে: 1 থেকে: 12), পাঠে.
	>> দিন := TwoDigitFormat প্রয়োগ-পূর্ণসংখ্যা: (সংখ্যা মধ্যে: 1 থেকে: 28), পাঠে.
	>> ঘণ্টা := TwoDigitFormat প্রয়োগ-পূর্ণসংখ্যা: (সংখ্যা মধ্যে: 1 থেকে: 23), পাঠে.
	>> মিনিট := TwoDigitFormat প্রয়োগ-পূর্ণসংখ্যা: (সংখ্যা মধ্যে: 1 থেকে: 59), পাঠে.
	>> সেকেন্ড := TwoDigitFormat প্রয়োগ-পূর্ণসংখ্যা: (সংখ্যা মধ্যে: 1 থেকে: 59), পাঠে.
	>> datetime := ['YYYY-MM-DD HH:II:SS'].	
	datetime
		YYYY: বছর,
		MM: মাস,
		DD: দিন,
		HH: ঘণ্টা,
		II: মিনিট,
		SS: সেকেন্ড.
	>> অনুসন্ধান-প্যারামিটার :=
	db কোয়েরি: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: datetime),
	আনো: { :row
		(row mydatetime = datetime) মিথ্যা-হলে: {
			এই-কাজ ত্রুটি: (
				['Expected: <expected> but got: <observation>']
				<expected>: datetime,
				<observation>: row mydatetime
			).
		}.
	
	}.
	counter যোগ: 1.
} * 100.

# Date
{
	>> বছর := সংখ্যা মধ্যে: 1995 থেকে: 2050, পাঠে.
	>> মাস := TwoDigitFormat প্রয়োগ-পূর্ণসংখ্যা: (সংখ্যা মধ্যে: 1 থেকে: 12), পাঠে.
	>> দিন := TwoDigitFormat প্রয়োগ-পূর্ণসংখ্যা: (সংখ্যা মধ্যে: 1 থেকে: 28), পাঠে.
	>> date := ['YYYY-MM-DD'].
	date
		YYYY: বছর,
		MM: মাস,
		DD: দিন.
	>> অনুসন্ধান-প্যারামিটার :=
	db কোয়েরি: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: date),
	আনো: { :row
		(row mydate = date) মিথ্যা-হলে: {
			এই-কাজ ত্রুটি: (
				['Expected: <expected> but got: <observation>']
				<expected>: date,
				<observation>: row mydate
			).
		}.
	}.
	counter যোগ: 1.
} * 100.


# Time
{
	>> ঘণ্টা := TwoDigitFormat প্রয়োগ-পূর্ণসংখ্যা: (সংখ্যা মধ্যে: 1 থেকে: 23), পাঠে.
	>> মিনিট := TwoDigitFormat প্রয়োগ-পূর্ণসংখ্যা: (সংখ্যা মধ্যে: 1 থেকে: 59), পাঠে.
	>> সেকেন্ড := TwoDigitFormat প্রয়োগ-পূর্ণসংখ্যা: (সংখ্যা মধ্যে: 1 থেকে: 59), পাঠে.
	>> সময় := ['HH:II:SS'].
	সময়
		HH: ঘণ্টা,
		II: মিনিট,
		SS: সেকেন্ড.
	>> অনুসন্ধান-প্যারামিটার :=
	db কোয়েরি: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: সময়),
	আনো: { :row
		(row mytime = সময়) মিথ্যা-হলে: {
			এই-কাজ ত্রুটি: (
				['Expected: <expected> but got: <observation>']
				<expected>: datetime,
				<observation>: row mytime
			).
		}.
	}.
	counter যোগ: 1.
} * 100.


# Strings (varchar/text)
>> str1 := লিস্ট নতুন ভরো: 100000 দিয়ে: ['x'], জোড়া-দাও: [''].
{
	>> str2 := সিন্দুক টোকেন: 40.
	>> অনুসন্ধান-প্যারামিটার :=
	db কোয়েরি: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	আনো: { :row
		(row str1 = str1 এবং: row str2 = str2) মিথ্যা-হলে: {
			এই-কাজ ত্রুটি: (
				['Expected: <expected> but got: <observation>']
				<expected>: datetime,
				<observation>: row mytime
			).
		}.
	}.
	counter যোগ: 1.
} * 100.


# Numbers
{
	>> n1 := সংখ্যা মধ্যে: 1 থেকে: 99999.
	>> n2 := n1 / 1000.
	>> big := (
		( Int64 পাঠ-থেকে: ['9223372036854775807'] ) -
		( Int64 পাঠ-থেকে: ['99999'] ) +
		( Int64 পাঠ-থেকে: n1 পাঠে )
	).
	>> অনুসন্ধান-প্যারামিটার :=
	db কোয়েরি: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	আনো: { :row
		(row n1 = n1) মিথ্যা-হলে: {
			এই-কাজ ত্রুটি: (
				['Expected: <expected> but got: <observation>']
				<expected>: n1,
				<observation>: row n1
			).
		}.
		(row n2 = n2) মিথ্যা-হলে: {
			এই-কাজ ত্রুটি: (
				['Expected: <expected> but got: <observation>']
				<expected>: n1,
				<observation>: row n2
			).
		}.
		(row n3 = n2 পূর্ণ-করো) মিথ্যা-হলে: {
			এই-কাজ ত্রুটি: (
				['Expected: <expected> but got: <observation>']
				<expected>: n1,
				<observation>: row n3
			).
		}.
		(row big = big) মিথ্যা-হলে: {
			এই-কাজ ত্রুটি: (
				['Expected: <expected> but got: <observation>']
				<expected>: big,
				<observation>: row big
			).
		}.
		
	}.
	counter যোগ: 1.
} * 100.


আউটপুট লেখো: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: counter
), নতুন-লাইন.