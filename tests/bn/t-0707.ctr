# টাইপ কাস্ট / রূপান্তর / বাইন্ডিং পরীক্ষা
প্রোগ্রাম মেমরি-ব্যবস্থাপনা: 4.
Server init.

>> গণক := 0.
>> ডিবি := Maria-DB নতুন হোস্ট: ['localhost'],
	ব্যবহারকারী-নাম: ['xo'], পাসওয়ার্ড: ['pass123'], ডেটাবেস-নাম: ['xobase'], যুক্ত-হও.

>> দুই-অঙ্কের-বিন্যাস := বিন্যাস নতুন: ['%02d'].

# তারিখ-সময়
{
	>> বছর     := সংখ্যা মধ্যে: 1995 থেকে: 2050, পাঠে.
	>> মাস    := দুই-অঙ্কের-বিন্যাস প্রয়োগ-পূর্ণসংখ্যা: (সংখ্যা মধ্যে: 1 থেকে: 12), পাঠে.
	>> দিন      := দুই-অঙ্কের-বিন্যাস প্রয়োগ-পূর্ণসংখ্যা: (সংখ্যা মধ্যে: 1 থেকে: 28), পাঠে.
	>> ঘণ্টা     := দুই-অঙ্কের-বিন্যাস প্রয়োগ-পূর্ণসংখ্যা: (সংখ্যা মধ্যে: 1 থেকে: 23), পাঠে.
	>> মিনিট   := দুই-অঙ্কের-বিন্যাস প্রয়োগ-পূর্ণসংখ্যা: (সংখ্যা মধ্যে: 1 থেকে: 59), পাঠে.
	>> সেকেন্ড   := দুই-অঙ্কের-বিন্যাস প্রয়োগ-পূর্ণসংখ্যা: (সংখ্যা মধ্যে: 1 থেকে: 59), পাঠে.
	>> তারিখ-সময় := ['YYYY-MM-DD HH:II:SS'].	
	তারিখ-সময়
		YYYY: বছর,
		MM: মাস,
		DD: দিন,
		HH: ঘণ্টা,
		II: মিনিট,
		SS: সেকেন্ড.
	>> অনুসন্ধান-প্যারামিটার :=
	ডিবি কোয়েরি: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: তারিখ-সময়),
	আনো: { :সারি
		(সারি mydatetime = তারিখ-সময়) মিথ্যা-হলে: {
			এই-কাজ ত্রুটি: (
				['প্রত্যাশিত: <expected> কিন্তু পেলাম: <observation>']
				<expected>: তারিখ-সময়,
				<observation>: সারি mydatetime
			).
		}.
	
	}.
	গণক যোগ: 1.
} * 100.

# তারিখ
{
	>> বছর     := সংখ্যা মধ্যে: 1995 থেকে: 2050, পাঠে.
	>> মাস    := দুই-অঙ্কের-বিন্যাস প্রয়োগ-পূর্ণসংখ্যা: (সংখ্যা মধ্যে: 1 থেকে: 12), পাঠে.
	>> দিন      := দুই-অঙ্কের-বিন্যাস প্রয়োগ-পূর্ণসংখ্যা: (সংখ্যা মধ্যে: 1 থেকে: 28), পাঠে.
	>> তারিখ     := ['YYYY-MM-DD'].
	তারিখ
		YYYY: বছর,
		MM: মাস,
		DD: দিন.
	>> অনুসন্ধান-প্যারামিটার :=
	ডিবি কোয়েরি: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: তারিখ),
	আনো: { :সারি
		(সারি mydate = তারিখ) মিথ্যা-হলে: {
			এই-কাজ ত্রুটি: (
				['প্রত্যাশিত: <expected> কিন্তু পেলাম: <observation>']
				<expected>: তারিখ,
				<observation>: সারি mydate
			).
		}.
	}.
	গণক যোগ: 1.
} * 100.


# সময়
{
	>> ঘণ্টা     := দুই-অঙ্কের-বিন্যাস প্রয়োগ-পূর্ণসংখ্যা: (সংখ্যা মধ্যে: 1 থেকে: 23), পাঠে.
	>> মিনিট   := দুই-অঙ্কের-বিন্যাস প্রয়োগ-পূর্ণসংখ্যা: (সংখ্যা মধ্যে: 1 থেকে: 59), পাঠে.
	>> সেকেন্ড   := দুই-অঙ্কের-বিন্যাস প্রয়োগ-পূর্ণসংখ্যা: (সংখ্যা মধ্যে: 1 থেকে: 59), পাঠে.
	>> সময় := ['HH:II:SS'].
	সময়
		HH: ঘণ্টা,
		II: মিনিট,
		SS: সেকেন্ড.
	>> অনুসন্ধান-প্যারামিটার :=
	ডিবি কোয়েরি: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: সময়),
	আনো: { :সারি
		(সারি mytime = সময়) মিথ্যা-হলে: {
			এই-কাজ ত্রুটি: (
				['প্রত্যাশিত: <expected> কিন্তু পেলাম: <observation>']
				<expected>: তারিখ-সময়,
				<observation>: সারি mytime
			).
		}.
	}.
	গণক যোগ: 1.
} * 100.


# পাঠ (varchar/text)
>> str1 := লিস্ট নতুন ভরো: 100000 দিয়ে: ['x'], জোড়া-দাও: [''].
{
	>> str2 := সিন্দুক টোকেন: 40.
	>> অনুসন্ধান-প্যারামিটার :=
	ডিবি কোয়েরি: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	আনো: { :সারি
		(সারি str1 = str1 এবং: সারি str2 = str2) মিথ্যা-হলে: {
			এই-কাজ ত্রুটি: (
				['প্রত্যাশিত: <expected> কিন্তু পেলাম: <observation>']
				<expected>: তারিখ-সময়,
				<observation>: সারি mytime
			).
		}.
	}.
	গণক যোগ: 1.
} * 100.


# সংখ্যা
{
	>> n1  := সংখ্যা মধ্যে: 1 থেকে: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 পাঠ-থেকে: ['9223372036854775807'] ) -
		( Int64 পাঠ-থেকে: ['99999'] ) +
		( Int64 পাঠ-থেকে: n1 পাঠে )
	).
	>> অনুসন্ধান-প্যারামিটার :=
	ডিবি কোয়েরি: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	আনো: { :সারি
		(সারি n1 = n1) মিথ্যা-হলে: {
			এই-কাজ ত্রুটি: (
				['প্রত্যাশিত: <expected> কিন্তু পেলাম: <observation>']
				<expected>: n1,
				<observation>: সারি n1
			).
		}.
		(সারি n2 = n2) মিথ্যা-হলে: {
			এই-কাজ ত্রুটি: (
				['প্রত্যাশিত: <expected> কিন্তু পেলাম: <observation>']
				<expected>: n1,
				<observation>: সারি n2
			).
		}.
		(সারি n3 = n2 পূর্ণ-করো) মিথ্যা-হলে: {
			এই-কাজ ত্রুটি: (
				['প্রত্যাশিত: <expected> কিন্তু পেলাম: <observation>']
				<expected>: n1,
				<observation>: সারি n3
			).
		}.
		(সারি big = big) মিথ্যা-হলে: {
			এই-কাজ ত্রুটি: (
				['প্রত্যাশিত: <expected> কিন্তু পেলাম: <observation>']
				<expected>: big,
				<observation>: সারি big
			).
		}.
		
	}.
	গণক যোগ: 1.
} * 100.


আউটপুট লেখো: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: গণক
), নতুন-লাইন.