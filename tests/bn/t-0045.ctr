প্রোগ্রাম মেমরি-ব্যবস্থাপনা: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } ধরো: {
		oops যোগ: 1.
	}, চালাও.
} × 1000.

{
	আউটপুট লেখো: ['hi there!'].
	এই-কাজ ত্রুটি: ['oops'].
	আউটপুট লেখো: ['hi there!'].
	{ আউটপুট লেখো: ['dont print this']. } চালাও.
} ধরো: { :e 
	আউটপুট লেখো: ['got ya!']. 
	আউটপুট লেখো: e.
}, চালাও.
