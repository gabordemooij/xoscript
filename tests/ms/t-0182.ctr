

>> ingatanDigunakan1 := 0.
>> ingatanDigunakan2 := 0.
>> ingatanDigunakan3 := 0.
>> ingatanDigunakan4 := 0.

Atur-cara pengurusan-ingatan: 0.

>> txt := ['1.6'].
>> n := txt nombor.
>> t := txt boolean.
Keluaran tulis: n, baris-baharu.
Keluaran tulis: t, baris-baharu.
Keluaran tulis: n jenis, baris-baharu.
Keluaran tulis: t jenis, baris-baharu.

Atur-cara kemaskan.

ingatanDigunakan1 := (Atur-cara ingatan ? 0).


