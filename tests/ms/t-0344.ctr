# ujian tangkap-semua (praktikal)
>> TeksHTML := Teks baharu.
TeksHTML apabila: ['encode:'] lakukan: { :tekst
	diri tambah-di-hujung: (tekst
	ganti: ['&'] dengan: ['&amp;'], 
	ganti: ['<'] dengan: ['&lt;'],
	ganti: ['>'] dengan: ['&gt;'],
	ganti: ['"'] dengan: ['&quot;']).
}.
>> blog := TeksHTML baharu.
blog tambah-di-hujung: ['<h1>'],
     encode: ['Koffie & Thee'],
     tambah-di-hujung: ['</h1>'].
Keluaran tulis: blog, baris-baharu.


>> Rumawi := Nombor baharu.
Rumawi apabila: ['keteksan'] lakukan: {
	>> a := [''].
	{ a tambah-di-hujung: ['I']. } × diri. <- a.
}.

>> x := Rumawi baharu.
x tambah: 3.
Keluaran tulis: x keteksan, baris-baharu.

>> Kuantum := Boolean baharu.
Kuantum apabila: ['true?'] lakukan: { <- ['mungkin Benar']. }.
Keluaran tulis: (Kuantum baharu true?), baris-baharu.

>> Nihil := Tiada baharu.
Nihil apabila: ['teks'] lakukan: { <- ['Nihil']. }.
Keluaran tulis: (Nihil baharu), baris-baharu.
