# catch-all test (practical)
>> HTML := Teks baharu.
HTML apabila: ['encode:'] lakukan: { :tekst
	diri tambah-di-hujung: (tekst
	ganti: ['&'] dengan: ['&amp;'], 
	ganti: ['<'] dengan: ['&lt;'],
	ganti: ['>'] dengan: ['&gt;'],
	ganti: ['"'] dengan: ['&quot;']).
}.
>> blog := HTML baharu.
blog tambah-di-hujung: ['<h1>'],
     encode: ['Koffie & Thee'],
     tambah-di-hujung: ['</h1>'].
Keluaran tulis: blog, baris-baharu.


>> Roman := Nombor baharu.
Roman apabila: ['stringy'] lakukan: {
	>> a := [''].
	{ a tambah-di-hujung: ['I']. } × diri. <- a.
}.

>> x := Roman baharu.
x tambah: 3.
Keluaran tulis: x stringy, baris-baharu.

>> Quantum := Boolean baharu.
Quantum apabila: ['true?'] lakukan: { <- ['maybe True']. }.
Keluaran tulis: (Quantum baharu true?), baris-baharu.

>> Nihil := Tiada baharu.
Nihil apabila: ['teks'] lakukan: { <- ['Nihil']. }.
Keluaran tulis: (Nihil baharu), baris-baharu.
