
>> Penyapa := Objek baharu.
Penyapa apabila: ['baharu'] lakukan: {
	milik nama := ['?'].
}.
Penyapa apabila: ['name:'] lakukan: { :nama
	milik nama := nama.
}.
Penyapa apabila: ['sapa'] lakukan: {
	Keluaran tulis: (['hello[you]'] [you]: milik nama).
}.
>> kawan := Penyapa baharu.
kawan name: ['1'].
kawan sapa.
