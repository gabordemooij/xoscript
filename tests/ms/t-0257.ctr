
>> Greeter := Objek baharu.
Greeter apabila: ['baharu'] lakukan: {
	milik nama := ['?'].
}.
Greeter apabila: ['name:'] lakukan: { :nama
	milik nama := nama.
}.
Greeter apabila: ['greet'] lakukan: {
	Keluaran tulis: (['hello[you]'] [you]: milik nama).
}.
>> friend := Greeter baharu.
friend name: ['1'].
friend greet.
