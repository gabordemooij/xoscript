
>> city := Senarai ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Senarai ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature mengikut: city.
>> cities := weather kunci-kunci isih: { :a :b <- (a bandingkan: b). }.
>> temperatures := weather nilai-nilai isih: { :a :b <- (a bandingkan: b) negatif?. }.

Keluaran tulis: (cities gabungkan: [',']), baris-baharu.
Keluaran tulis: (temperatures gabungkan: [',']), baris-baharu.
