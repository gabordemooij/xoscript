
>> bandar := Senarai ← ['London'] ; ['Paris'] ; ['Berlin'].
>> suhu := Senarai ← ['15'] ; ['16'] ; ['15'].
>> cuaca := suhu mengikut: bandar.
>> bandar-bandar := cuaca kunci-kunci isih: { :a :b <- (a bandingkan: b). }.
>> suhu-suhu := cuaca nilai-nilai isih: { :a :b <- (a bandingkan: b) negatif?. }.

Keluaran tulis: (bandar-bandar gabungkan: [',']), baris-baharu.
Keluaran tulis: (suhu-suhu gabungkan: [',']), baris-baharu.
