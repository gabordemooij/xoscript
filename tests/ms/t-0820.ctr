# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Corak baharu: pattern.
	p padan: subject lakukan: { :m :g
		Keluaran tulis: g bilangan, tulis: [' '], tulis: (g gabungkan: ['|']), baris-baharu. <- m.
	}.
}.
show gunakan-pada: ['(a)|(b)'] dan: ['b'].
show gunakan-pada: ['(a)|(b)'] dan: ['a'].
show gunakan-pada: ['(x)?y'] dan: ['y'].
show gunakan-pada: ['(x)?(y)(z)?'] dan: ['xy'].
