# kumpulan yang bukan sebahagian daripada padanan tidak boleh ranap dan mesti mengekalkan nombor kumpulan
Server init.
>> tunjuk := { :corak-cari :subject
	>> p := Corak baharu: corak-cari.
	p padan: subject lakukan: { :m :g
		Keluaran tulis: g bilangan, tulis: [' '], tulis: (g gabungkan: ['|']), baris-baharu.
		<- m.
	}.
}.
tunjuk gunakan-pada: ['(a)|(b)'] dan: ['b'].
tunjuk gunakan-pada: ['(a)|(b)'] dan: ['a'].
tunjuk gunakan-pada: ['(x)?y'] dan: ['y'].
tunjuk gunakan-pada: ['(x)?(y)(z)?'] dan: ['xy'].
