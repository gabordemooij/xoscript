#Linux

(Fail baharu: ['/tmp/testje']) wujud palsu: {
	Atur-cara sistem: ['mkdir /tmp/testje'].	
}.

(Fail baharu: ['/tmp/testje/file1']) wujud palsu: {
	Atur-cara sistem: ['touch /tmp/testje/file1'].	
}.

(Fail baharu: ['/tmp/testje/folder1']) wujud palsu: {
	Atur-cara sistem: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Fail senarai: ['/tmp/testje'].

>> q := Senarai baharu.

l setiap: { :k :v v setiap: { :x :y q tambah-di-hujung: y. }. }.

>> s := q teks.

(s mengandungi: ['file1']) benar:   { Keluaran tulis: ['OK'], baris-baharu. }.
(s mengandungi: ['file2']) benar:   { Keluaran tulis: ['XX'], baris-baharu. }.
(s mengandungi: ['folder1']) benar: { Keluaran tulis: ['OK'], baris-baharu. }.
