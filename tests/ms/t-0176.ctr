

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Atur-cara pengurusan-ingatan: 0.

>> txt := ['Word Salad'].
Keluaran tulis: ['Text Length: '] + txt panjang, baris-baharu.
Keluaran tulis: ['Character at 2:'] + ( txt aksara: 2 ), baris-baharu.
Keluaran tulis: (( txt cari: ['S'] ) - 0), baris-baharu.

Atur-cara kemaskan.

usedMemory1 := (Atur-cara ingatan ? 0).


txt := ['Word Salad'].
Keluaran tulis: ['Text Length: '] + txt panjang, baris-baharu.
Keluaran tulis: ['Character at 2:'] + ( txt aksara: 2 ), baris-baharu.
Keluaran tulis: (( txt cari: ['S'] ) - 0), baris-baharu.

Atur-cara kemaskan.
usedMemory2 := (Atur-cara ingatan ? 0).


txt := ['Word Salad'].
Keluaran tulis: ['Text Length: '] + txt panjang, baris-baharu.
Keluaran tulis: ['Character at 2:'] + ( txt aksara: 2 ), baris-baharu.
Keluaran tulis: (( txt cari: ['S'] ) - 0), baris-baharu.

Atur-cara kemaskan.
usedMemory3 := (Atur-cara ingatan ? 0).



( usedMemory1 = usedMemory2 dan: usedMemory1 = usedMemory3, dan: usedMemory2 = usedMemory3 ) benar: {
	Keluaran tulis: ['No memory leaks here'].
}, palsu: {
	Keluaran tulis: ['Leaking memory...'].
}.
