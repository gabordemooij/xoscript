

>> Matryoshka := Objek baharu.
Matryoshka apabila: ['double:'] lakukan: { :rahsia
	milik rahsia := rahsia × 2.
}.
Matryoshka apabila: ['baharu:'] lakukan: { :rahsia
	>> jawapan := Tiada.
	>> t := (rahsia > 255).
	Keluaran tulis: (rahsia + [' | '] + t), baris-baharu.
	t benar: {
		jawapan := rahsia.
	}, jika-tidak: {
		jawapan := Matryoshka rekursif baharu: (diri double: rahsia).
	}. <- jawapan.
}.

>> x := Matryoshka baharu: 2.
