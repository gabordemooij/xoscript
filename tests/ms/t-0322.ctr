

>> Matryoshka := Objek baharu.
Matryoshka apabila: ['double:'] lakukan: { :secret
	milik secret := secret × 2.
}.
Matryoshka apabila: ['baharu:'] lakukan: { :secret
	>> answer := Tiada.
	>> t := (secret > 255).
	Keluaran tulis: (secret + [' | '] + t), baris-baharu.
	t benar: {
		answer := secret.
	}, jika-tidak: {
		answer := Matryoshka rekursif baharu: (diri double: secret).
	}. <- answer.
}.

>> x := Matryoshka baharu: 2.
