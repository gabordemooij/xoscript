# Ujian ini menyemak sama ada string_fill_in tidak kehilangan slotnya (di-gc) dalam mod 4
# rujukan dalam world.c
>> Jurnal := Objek baharu.

Jurnal apabila: ['say:'] lakukan: { :str
	Keluaran tulis: str, baris-baharu.
}.

>> Barang := Objek baharu.

Barang apabila: ['baharu:'] lakukan: { :id
	<- diri baharu id: id.
}.

Barang apabila: ['id:'] lakukan: { :id
	milik id := id.
}.

Barang apabila: ['id'] lakukan: { <- milik id. }.


Barang apabila: ['teks'] lakukan: {
	>> str := ['Item#~no'].
	str ~no: milik id.
	<- str.
}.


>> Print := Objek baharu.

Print apabila: ['items'] lakukan: { 
	
	milik barang := Barang baharu: 1.
	
	# sama ada segfault atau str yang salah di sini
	Jurnal say: (
		['~item printed.'] ~item: milik barang
	).
	
	
}.

Print items.