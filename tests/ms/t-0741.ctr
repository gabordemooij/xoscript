Keluaran tulis: ['Test object'], baris-baharu.
>> a := Objek baharu. 

a apabila: ['item:'] lakukan: { :octhelper
	milik octhelper := octhelper. 
}.

a apabila: ['item'] lakukan: { <- milik octhelper.
}.

a item: Oct baharu.

>> old-octhelper-address := a item prototaip alamat-ingatan.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baharu.

>> b := Objek load-from: ['/tmp/a.bin'].

(b item prototaip alamat-ingatan = old-octhelper-address) benar: {
	Keluaran tulis: ['Object link re-attached.'], baris-baharu.
}.
