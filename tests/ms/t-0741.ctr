Keluaran tulis: ['Objek ujian'], baris-baharu.
>> a := Objek baharu. 

a apabila: ['item:'] lakukan: { :pembantuokt
	milik pembantuokt := pembantuokt. 
}.

a apabila: ['barang'] lakukan: {
	<- milik pembantuokt.
}.

a item: Oct baharu.

>> alamat-lama-pembantuokt := a barang prototaip alamat-ingatan.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== MEMUAT SEMULA SNAP:'], baris-baharu.

>> b := Objek load-from: ['/tmp/a.bin'].

(b barang prototaip alamat-ingatan = alamat-lama-pembantuokt) benar: {
	Keluaran tulis: ['Pautan objek dipasang semula.'], baris-baharu.
}.
