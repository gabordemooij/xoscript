# uji penukaran jenis / penukaran / pengikatan
Atur-cara pengurusan-ingatan: 4.
Server init.

>> pembilang := 0.
>> pd := Maria-DB baharu hos: ['localhost'],
	nama-pengguna: ['xo'], kata-laluan: ['pass123'], nama-pangkalan-data: ['xobase'], sambung.

>> FormatDuaDigit := Format baharu: ['%02d'].

# Tarikh-masa
{
	>> tahun     := Nombor antara: 1995 dan: 2050, teks.
	>> bulan    := FormatDuaDigit gunakan-pada-integer: (Nombor antara: 1 dan: 12), teks.
	>> hari      := FormatDuaDigit gunakan-pada-integer: (Nombor antara: 1 dan: 28), teks.
	>> jam     := FormatDuaDigit gunakan-pada-integer: (Nombor antara: 1 dan: 23), teks.
	>> minit   := FormatDuaDigit gunakan-pada-integer: (Nombor antara: 1 dan: 59), teks.
	>> saat   := FormatDuaDigit gunakan-pada-integer: (Nombor antara: 1 dan: 59), teks.
	>> tarikhmasa := ['YYYY-MM-DD HH:II:SS'].	
	tarikhmasa
		YYYY: tahun,
		MM: bulan,
		DD: hari,
		HH: jam,
		II: minit,
		SS: saat.
	>> parameter-carian :=
	pd pertanyaan: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: tarikhmasa),
	dapatkan: { :barisan
		(barisan mydatetime = tarikhmasa) palsu: {
			tugas-ini ralat: (
				['Dijangka: <expected> tetapi dapat: <observation>']
				<expected>: tarikhmasa,
				<observation>: barisan mydatetime
			).
		}.
	
	}.
	pembilang tambah: 1.
} * 100.

# Tarikh
{
	>> tahun     := Nombor antara: 1995 dan: 2050, teks.
	>> bulan    := FormatDuaDigit gunakan-pada-integer: (Nombor antara: 1 dan: 12), teks.
	>> hari      := FormatDuaDigit gunakan-pada-integer: (Nombor antara: 1 dan: 28), teks.
	>> tarikh     := ['YYYY-MM-DD'].
	tarikh
		YYYY: tahun,
		MM: bulan,
		DD: hari.
	>> parameter-carian :=
	pd pertanyaan: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: tarikh),
	dapatkan: { :barisan
		(barisan mydate = tarikh) palsu: {
			tugas-ini ralat: (
				['Dijangka: <expected> tetapi dapat: <observation>']
				<expected>: tarikh,
				<observation>: barisan mydate
			).
		}.
	}.
	pembilang tambah: 1.
} * 100.


# Masa
{
	>> jam     := FormatDuaDigit gunakan-pada-integer: (Nombor antara: 1 dan: 23), teks.
	>> minit   := FormatDuaDigit gunakan-pada-integer: (Nombor antara: 1 dan: 59), teks.
	>> saat   := FormatDuaDigit gunakan-pada-integer: (Nombor antara: 1 dan: 59), teks.
	>> masa := ['HH:II:SS'].
	masa
		HH: jam,
		II: minit,
		SS: saat.
	>> parameter-carian :=
	pd pertanyaan: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: masa),
	dapatkan: { :barisan
		(barisan mytime = masa) palsu: {
			tugas-ini ralat: (
				['Dijangka: <expected> tetapi dapat: <observation>']
				<expected>: tarikhmasa,
				<observation>: barisan mytime
			).
		}.
	}.
	pembilang tambah: 1.
} * 100.


# Teks (varchar/text)
>> str1 := Senarai baharu isi: 100000 dengan: ['x'], gabungkan: [''].
{
	>> str2 := Peti-besi token: 40.
	>> parameter-carian :=
	pd pertanyaan: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	dapatkan: { :barisan
		(barisan str1 = str1 dan: barisan str2 = str2) palsu: {
			tugas-ini ralat: (
				['Dijangka: <expected> tetapi dapat: <observation>']
				<expected>: tarikhmasa,
				<observation>: barisan mytime
			).
		}.
	}.
	pembilang tambah: 1.
} * 100.


# Nombor
{
	>> n1  := Nombor antara: 1 dan: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 daripada-teks: ['9223372036854775807'] ) -
		( Int64 daripada-teks: ['99999'] ) +
		( Int64 daripada-teks: n1 teks )
	).
	>> parameter-carian :=
	pd pertanyaan: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	dapatkan: { :barisan
		(barisan n1 = n1) palsu: {
			tugas-ini ralat: (
				['Dijangka: <expected> tetapi dapat: <observation>']
				<expected>: n1,
				<observation>: barisan n1
			).
		}.
		(barisan n2 = n2) palsu: {
			tugas-ini ralat: (
				['Dijangka: <expected> tetapi dapat: <observation>']
				<expected>: n1,
				<observation>: barisan n2
			).
		}.
		(barisan n3 = n2 bundarkan) palsu: {
			tugas-ini ralat: (
				['Dijangka: <expected> tetapi dapat: <observation>']
				<expected>: n1,
				<observation>: barisan n3
			).
		}.
		(barisan big = big) palsu: {
			tugas-ini ralat: (
				['Dijangka: <expected> tetapi dapat: <observation>']
				<expected>: big,
				<observation>: barisan big
			).
		}.
		
	}.
	pembilang tambah: 1.
} * 100.


Keluaran tulis: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: pembilang
), baris-baharu.