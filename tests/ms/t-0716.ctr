Keluaran tulis: ['Objek ujian'], baris-baharu.
>> a := Objek baharu. 

a apabila: ['state:'] lakukan: { :list
	milik list := list. 
}.

a apabila: ['keadaan'] lakukan: {
	Keluaran tulis: milik list, baris-baharu.
}.

a state: ( Senarai baharu ; ['itemsenarai'] ; ['item2'] ).
a keadaan.

a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== MEMUAT SEMULA SNAP:'], baris-baharu.
>> b := Objek load-from: ['/tmp/a.bin'].
b keadaan.