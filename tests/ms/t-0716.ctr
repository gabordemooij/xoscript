Keluaran tulis: ['Test object'], baris-baharu.
>> a := Objek baharu. 

a apabila: ['state:'] lakukan: { :list
	milik list := list. 
}.

a apabila: ['state'] lakukan: {
	Keluaran tulis: milik list, baris-baharu.
}.

a state: ( Senarai baharu ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baharu.
>> b := Objek load-from: ['/tmp/a.bin'].
b state.