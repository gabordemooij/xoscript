

Teks apabila: ['evaluate'] lakukan: {
	>> kod := Fail baharu: ['/tmp/eval.ctr'].
	kod tulis: (diri teks + ['.']).
	Atur-cara guna: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Senarai ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q teks.
Keluaran tulis: x, baris-baharu.
>> y := Tiada.
(['y := '] + x ) evaluate.
Keluaran tulis: y ? 0, baris-baharu.

q := Kamus letak: ['\[''] di: ['\['quote\']'].
x := q teks.
Keluaran tulis: x, baris-baharu.
y := Tiada.
(['y := '] + x ) evaluate.

>> q := (Kamus baharu) letak:['\[''] di:['\['quote\[''].
Keluaran tulis: y ? ['\['quote\']'], baris-baharu.
