>> str := ['write:'].
Keluaran mesej: ['tulis:'] argumen: (Senarai ← ['Hello World']), baris-baharu. 

Nombor apabila: ['isbetween:and:'] lakukan: { :a :b <- ((diri ≥ a) dan: (diri ≤ b)).
}.

str := ['isbetween:and:'].
Keluaran tulis: (3 mesej: str argumen: (Senarai ← 2 ; 8)), baris-baharu.
Keluaran tulis: (3 mesej: str argumen: (Senarai ← 1 ; 2)), baris-baharu.


>> CoffeeMachine := Objek baharu.
CoffeeMachine apabila: ['makeCoffeeWithSugar:milk:'] lakukan: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Senarai ← 4 ; 2.
Keluaran tulis: ( CoffeeMachine mesej: order argumen: coffeeConfiguration ), baris-baharu.
