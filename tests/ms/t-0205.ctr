>> str := ['write:'].
Keluaran mesej: ['tulis:'] argumen: (Senarai ← ['Hello World']), baris-baharu. 

Nombor apabila: ['isbetween:and:'] lakukan: { :a :b <- ((diri ≥ a) dan: (diri ≤ b)).
}.

str := ['isbetween:and:'].
Keluaran tulis: (3 mesej: str argumen: (Senarai ← 2 ; 8)), baris-baharu.
Keluaran tulis: (3 mesej: str argumen: (Senarai ← 1 ; 2)), baris-baharu.


>> MesinKopi := Objek baharu.
MesinKopi apabila: ['makeCoffeeWithSugar:milk:'] lakukan: { :sugar :milk <- ( ['Nah, ambillah... kopi dengan '] + 
			sugar +
			[' sudu gula dan '] +
			milk +
			[' titis susu.']
	).
}.

>> tempahan := ['makeCoffeeWithSugar:milk:'].
>> konfigurasiKopi := Senarai ← 4 ; 2.
Keluaran tulis: ( MesinKopi mesej: tempahan argumen: konfigurasiKopi ), baris-baharu.
