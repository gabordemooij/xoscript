Server init.
>> f := Format baharu: ['%d'].
>> a := Blob baharu: 4.
a bytes: ( Senarai baharu ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob baharu: 4.
b bytes: ( Senarai baharu ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a dari: 0 panjang: 3, setiap: { :i :byte
	Keluaran tulis: ( f gunakan-pada-integer: byte ), baris-baharu.
}.
a ^ b.
a dari: 0 panjang: 3, setiap: { :i :byte
	Keluaran tulis: ( f gunakan-pada-integer: byte ), baris-baharu.
}.
a ^ b.
a dari: 0 panjang: 3, setiap: { :i :byte
	Keluaran tulis: ( f gunakan-pada-integer: byte ), baris-baharu.
}.
a bebaskan.
b bebaskan.

{ a ^ Objek. } tangkap: { :e Keluaran tulis: e, baris-baharu. }, mula.
