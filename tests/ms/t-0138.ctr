>> y := ['Hello'].
>> q := { ['']. }.
>> p := Benar.
>> a := Senarai ← 1 ; 2 ; 3 ; 4.
>> c := Objek baharu.
c apabila: ['greet:'] lakukan: { Keluaran tulis: ['sapa!']. }.

>> ingatanDigunakan1 := 0.
>> ingatanDigunakan2 := 0.
>> ingatanDigunakan3 := 0.
>> ingatanDigunakan4 := 0.
>> ingatanDigunakan5 := 0.

Atur-cara kemaskan.
>> ingatanDigunakan1 := (Atur-cara ingatan ? 0).




