(usedMemory1 = usedMemory2 = usedMemory3 = usedMemory4 = usedMemory5) benar: { 
	Keluaran tulis: ['Memory usage remains stable.'], baris-baharu.
}, jika-tidak: {
	Keluaran tulis: ['Used memory not stable.'], baris-baharu.
}.
