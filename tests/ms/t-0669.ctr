# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Peti-besi 
	cincang-kata-laluan: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Peti-besi 
	cincang-kata-laluan: hash sahkan: a1.
	# fail 
>> b := Peti-besi
	cincang-kata-laluan: hash sahkan: a2.
	# ok!

Keluaran tulis: a, baris-baharu.
Keluaran tulis: b, baris-baharu.

