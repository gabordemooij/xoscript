# Pencincangan kata laluan
Server init.

# Pengguna menetapkan kata laluan
>> klaluan := ['pass123'].

# Anda menyimpannya seperti ini
>> cincangan := Peti-besi 
	cincang-kata-laluan: klaluan.

# Kemudian, pengguna log masuk
# Cubaan 1
>> a1 := ['abcd123'].
# Cubaan 2
>> a2 := ['pass123'].

# Sahkan
>> a := Peti-besi 
	cincang-kata-laluan: cincangan sahkan: a1.
	# gagal 
>> b := Peti-besi
	cincang-kata-laluan: cincangan sahkan: a2.
	# ok!

Keluaran tulis: a, baris-baharu.
Keluaran tulis: b, baris-baharu.

