>> frasa-frasa := Senarai baharu
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> pesanan := ['Phrase: ~decoded base64: ~encoded'].
	
frasa-frasa setiap: { :_ :frasa 
	>> e := Server base64-kodkan: frasa.
	>> d := Server base64-nyahkod: e.
	Keluaran tulis: (
		pesanan salin ~encoded: e, ~decoded: d
	), baris-baharu.
}.
