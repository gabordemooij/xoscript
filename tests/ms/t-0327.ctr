

Senarai apabila: ['fixture:'] lakukan: { :f
	milik kelengkapan := f.
}.

Senarai apabila: ['bilangan'] lakukan: { <- milik kelengkapan.
}.

Senarai apabila: ['aantal'] lakukan: { <- milik kelengkapan.
}.


>> x := Tiada.
{

	x := ['hello'] 
	ganti:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] aksara: 2)
			)
		)
	dengan: (
		(['...hal'] + ['lo']) 
			huruf-besar 
			lowecase 
			huruf-besar 
			langkau: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Senarai ← 0 ; 1 ; 4; 9 ; (Senarai ← 0 ; 3; 1) ; 4
							) kedua-terakhir
						) ? 1
					) + 
					((Senarai ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					bilangan
				)
			)
	).

} × 10.
Keluaran tulis: x, baris-baharu.

