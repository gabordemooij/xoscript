


>> wine := Objek baharu.


wine apabila: ['toString'] lakukan: { <- ['merlot'].
}.

wine apabila: ['naarTekst'] lakukan: { <- ['merlot'].
}.


wine apabila: ['='] lakukan: { :other wine <- ( diri toString = other wine ).
}.

wine apabila: ['=='] lakukan: { :other wine <- ( diri toString = other wine ).
}.



wine
	kes: ['cabernet'] lakukan: { Keluaran tulis: ['it's a Cabernet!']. },
	kes: ['syrah']    lakukan: { Keluaran tulis: ['it's a Syrah!'].    },
	kes: ['merlot']   lakukan: { Keluaran tulis: ['it's a Merlot!'].   },
	kes: ['malbec']   lakukan: { Keluaran tulis: ['it's a Malbec!'].   }.

Keluaran baris-baharu.
