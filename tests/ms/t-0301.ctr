


>> wain := Objek baharu.


wain apabila: ['keTeks'] lakukan: { <- ['merlot'].
}.

wain apabila: ['naarTekst'] lakukan: { <- ['merlot'].
}.


wain apabila: ['='] lakukan: { :other wine <- ( diri keTeks = other wine ).
}.

wain apabila: ['=='] lakukan: { :other wine <- ( diri keTeks = other wine ).
}.



wain
	kes: ['cabernet'] lakukan: { Keluaran tulis: ['ini Cabernet!']. },
	kes: ['syrah']    lakukan: { Keluaran tulis: ['ini Syrah!'].    },
	kes: ['merlot']   lakukan: { Keluaran tulis: ['ini Merlot!'].   },
	kes: ['malbec']   lakukan: { Keluaran tulis: ['ini Malbec!'].   }.

Keluaran baris-baharu.
