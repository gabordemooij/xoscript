Keluaran tulis: ((Senarai baharu
	apabila: ['plaque:'] lakukan: { :x milik o := x. },
	apabila: ['plaque']  lakukan: { <- milik o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Senarai ← 1)
	~ (Senarai ← 1 ; 2)
	~ (Senarai ← 1 ; 2 ; 3)
	~ (Senarai ← 1 ; 2 ; 3 ; 4)
	~ (Senarai ← 1 ; 2 ; 3 ; 4 ; 5)
) setiap: { :i :el
	{ Keluaran tulis: tugas-ini. } × el bilangan.
	Keluaran baris-baharu.
}) plaque, baris-baharu.


