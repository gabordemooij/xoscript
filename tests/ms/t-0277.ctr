

>> Kucing := Objek baharu.

Kucing apabila: ['baharu'] lakukan: {
	milik bunyi := ['meow!'].
}.

Kucing apabila: ['nieuw'] lakukan: {
	milik bunyi := ['meow!'].
}.

Kucing apabila: ['buatBunyi'] lakukan: { <- milik bunyi.
}.

Kucing apabila: ['sapa'] lakukan: { <- diri buatBunyi.
}.

>> kucing := Kucing baharu.
Keluaran tulis: kucing sapa.
