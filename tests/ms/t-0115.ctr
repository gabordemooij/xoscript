{
	tugas-ini ralat: ['Dont fail.'].
	unknown doSomething.
} tangkap: {
	Keluaran tulis: ['Caught!'].
}, mula.

{
	tugas-ini ralat: ['Dont fail.'].
	milik unknown doSomething.
} tangkap: {
	Keluaran tulis: ['Caught!'].
}, mula.

{
	tugas-ini ralat: ['Dont fail.'].
	unknown := 122.
} tangkap: {
	Keluaran tulis: ['Caught!'].
}, mula.


{
	tugas-ini ralat: ['Dont fail.'].
	Benar henti.
	Keluaran tulis: ['FAIL'].
} tangkap: {
	Keluaran tulis: ['Caught!'].
}, mula.

{
	{
		tugas-ini ralat: ['Dont fail.'].
		Benar henti.
		Keluaran tulis: ['FAIL'].
	} tangkap: { :x
		(x = ['Dont fail.']) benar: { tugas-ini ralat: ['Nested Caught!']. }.
	}, mula.
} tangkap: { :e
	Keluaran tulis: e.
}, mula.
