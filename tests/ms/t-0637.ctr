# Menetapkan penggera

# menamatkan atur cara selepas 1 saat.
Atur-cara had-masa: 1.

Keluaran tulis: ['maks 1 saat.'], baris-baharu.
Detik tunggu: 2.
Keluaran tulis: ['terlalu lama.'], baris-baharu.

# nota:
# Menetapkan penggera tidak boleh dibatalkan,
# penyerang tidak boleh melumpuhkannya.
# Selepas panggilan pertama, penggera dikunci.
# Penggera ini juga sangat keras,
# atur cara *AKAN* dihentikan selepas
# selang masa yang ditetapkan, walaupun ia
# sedang dalam bacaan yang menyekat atau sebagainya.

# nota:
# Penggera itu berat, pertimbangkan untuk menetapkan
# had masa asas dalam pelayan web sahaja.



