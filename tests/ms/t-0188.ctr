

>> ingatanDigunakan1 := 0.
>> ingatanDigunakan2 := 0.
>> ingatanDigunakan3 := 0.
>> ingatanDigunakan4 := 0.

Atur-cara pengurusan-ingatan: 0.

{ :i Keluaran tulis: i. } × 4.
Keluaran baris-baharu.
{ :i Keluaran tulis: (4 - i). } × 4.
Keluaran baris-baharu.
( 1 > 2 ) palsu: { Keluaran tulis: ['BLOK 1'], baris-baharu. }.
( 2 > 1 ) benar:  { Keluaran tulis: ['BLOK 2'], baris-baharu. }.

>> i := 0.
{ Keluaran tulis: i. i tambah: 1. } selagi: { <- ( i < 3). }.
Keluaran baris-baharu.

i := 3.
{ Keluaran tulis: i. i := i - 1. } selagi: { <- ( i > 0). }.
Keluaran baris-baharu.


Atur-cara kemaskan.

ingatanDigunakan1 := (Atur-cara ingatan ? 0).


{ :i  Keluaran tulis: i. } × 4.
Keluaran baris-baharu.
{ :i  Keluaran tulis: (4 - i). } × 4.
Keluaran baris-baharu.
( 1 > 2 ) palsu: { Keluaran tulis: ['BLOK 1'], baris-baharu. }.
( 2 > 1 ) benar:  { Keluaran tulis: ['BLOK 2'], baris-baharu. }.

>> i := 0.
{ Keluaran tulis: i. i tambah: 1. } selagi: { <- ( i < 3). }.
Keluaran baris-baharu.

i := 3.
{ Keluaran tulis: i. i := i - 1. } selagi: { <- ( i > 0). }.
Keluaran baris-baharu.



Atur-cara kemaskan.
ingatanDigunakan2 := (Atur-cara ingatan ? 0).


{ :i Keluaran tulis: i. } × 4.
Keluaran baris-baharu.
{ :i Keluaran tulis: (4 - i). } × 4.
Keluaran baris-baharu.
( 1 > 2 ) palsu: { Keluaran tulis: ['BLOK 1'], baris-baharu. }.
( 2 > 1 ) benar:  { Keluaran tulis: ['BLOK 2'], baris-baharu. }.

>> i := 0.
{ Keluaran tulis: i. i tambah: 1. } selagi: { <- ( i < 3). }.
Keluaran baris-baharu.

i := 3.
{ Keluaran tulis: i. i := i - 1. } selagi: { <- ( i > 0). }.
Keluaran baris-baharu.

Atur-cara kemaskan.
ingatanDigunakan3 := (Atur-cara ingatan ? 0).



( ingatanDigunakan1 = ingatanDigunakan2 dan: ingatanDigunakan1 = ingatanDigunakan3, dan: ingatanDigunakan2 = ingatanDigunakan3 ) benar: {
	Keluaran tulis: ['Tiada kebocoran ingatan di sini'].
}, palsu: {
	Keluaran tulis: ['Ingatan bocor...'].
}.
