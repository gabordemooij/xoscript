

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Atur-cara pengurusan-ingatan: 0.

{ :i Keluaran tulis: i. } × 4.
Keluaran baris-baharu.
{ :i Keluaran tulis: (4 - i). } × 4.
Keluaran baris-baharu.
( 1 > 2 ) palsu: { Keluaran tulis: ['BLOCK 1'], baris-baharu. }.
( 2 > 1 ) benar:  { Keluaran tulis: ['BLOCK 2'], baris-baharu. }.

>> i := 0.
{ Keluaran tulis: i. i tambah: 1. } selagi: { <- ( i < 3). }.
Keluaran baris-baharu.

i := 3.
{ Keluaran tulis: i. i := i - 1. } selagi: { <- ( i > 0). }.
Keluaran baris-baharu.


Atur-cara kemaskan.

usedMemory1 := (Atur-cara ingatan ? 0).


{ :i  Keluaran tulis: i. } × 4.
Keluaran baris-baharu.
{ :i  Keluaran tulis: (4 - i). } × 4.
