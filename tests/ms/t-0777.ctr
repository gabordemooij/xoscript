#OBSD
>> dirname := [''].
{ dirname tambah-di-hujung: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Atur-cara sistem: command.
Atur-cara chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename tambah-di-hujung: ['YYYYYYYY']. } * 20.
Fail baharu: filename, tulis: ['sometext'].
{ Fail senarai: ['/tmp/'] + dirname. } * 1000.
Keluaran tulis: ['no crash'], baris-baharu.

