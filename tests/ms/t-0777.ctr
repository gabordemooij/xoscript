#OBSD
>> namadir := [''].
{ namadir tambah-di-hujung: ['X/']. } * (1024 / 2 - 4).
>> baris-arahan := ['mkdir -p /tmp/'] + namadir.
Atur-cara sistem: baris-arahan.
Atur-cara chdir: ['/tmp/'] + namadir.
>> namafail := [''].
{ namafail tambah-di-hujung: ['YYYYYYYY']. } * 20.
Fail baharu: namafail, tulis: ['sometext'].
{ Fail senarai: ['/tmp/'] + namadir. } * 1000.
Keluaran tulis: ['tiada ranap'], baris-baharu.

