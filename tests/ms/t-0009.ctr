>> Penyapa := Objek baharu.
Penyapa apabila: ['cipta'] lakukan: {
	>> penyapa := Objek baharu.
	penyapa apabila: ['name:'] lakukan: { :nama
		Keluaran tulis: ['menetapkan nama'].
		milik namaSaya := nama.
	}.
	penyapa apabila: ['lakukanSapaan'] lakukan: {
		Keluaran tulis: ['Hello'].
		Keluaran tulis: milik namaSaya.
	}.
	penyapa apabila: ['sapa'] lakukan: {
		diri lakukanSapaan.
	}. <- penyapa.
}.
>> penyapa := Penyapa cipta.
penyapa name: ['cahaya mentari!'].
penyapa sapa.
