>> a := 3.
>> b := a salin.
a tolak: 1.
Keluaran tulis: [' a = '] + a.
Keluaran tulis: [' b = '] + b.
a := 3.
b := a + 4.
Keluaran tulis: [' a = '] + a.
Keluaran tulis: [' b = '] + b.
>> x := 3.
>> y := x salin.
x tambah: 10.
y tolak: 1.
Keluaran tulis: [' x = '] + x.
Keluaran tulis: [' y = '] + y.
>> q := Objek baharu.
q apabila: ['setProperty:'] lakukan: { :x
	milik prop := x.
}.
q apabila: ['getProperty'] lakukan: { <- milik prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Keluaran tulis: [' p = '] + (p getProperty).
