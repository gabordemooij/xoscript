# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Peti-besi jana-kunci.

# private (secret) key
>> sk := keys pertama.

# public key
>> pk := keys terakhir.

# sign a message
>> sig := Peti-besi tandatangan: ['abc'] dengan: sk.

# check message (ok)
Keluaran tulis: ( 
	Peti-besi
		semak: ['abc'] 
		tandatangan: sig 
		dengan: pk 
), baris-baharu.

# check message (fail)
Keluaran tulis: ( 
	Peti-besi 
		semak: ['abd'] 
		tandatangan: sig 
		dengan: pk 
), baris-baharu.