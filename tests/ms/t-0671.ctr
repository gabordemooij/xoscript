# kunci awam (untuk melindungi API dan sebagainya)
Server init.

# jana pasangan kunci
>> pasangan-kunci := Peti-besi jana-kunci.

# kunci peribadi (rahsia)
>> kp := pasangan-kunci pertama.

# kunci awam
>> ku := pasangan-kunci terakhir.

# tandatangani mesej
>> ttd := Peti-besi tandatangan: ['abc'] dengan: kp.

# semak mesej (ok)
Keluaran tulis: ( 
	Peti-besi
		semak: ['abc'] 
		tandatangan: ttd 
		dengan: ku 
), baris-baharu.

# semak mesej (gagal)
Keluaran tulis: ( 
	Peti-besi 
		semak: ['abd'] 
		tandatangan: ttd 
		dengan: ku 
), baris-baharu.