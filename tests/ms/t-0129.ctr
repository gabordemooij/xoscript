
Senarai apabila: ['product'] lakukan: {
	>> total := 1.
	diri setiap: { :index :element
		total darab-dengan: element.
	}. <- total.
}.

>> a := Senarai ← 1 ; 2 ; 3.
Keluaran tulis: a product, baris-baharu.
Keluaran tulis: (Senarai ← 2 ; 4 ; 8) product, baris-baharu. 
Keluaran tulis: (Senarai ← -2 ; 10) product, baris-baharu. 
Keluaran tulis: (Senarai ← 0.5 ; -2) product, baris-baharu. 
