
Senarai apabila: ['hasil-darab'] lakukan: {
	>> jumlah := 1.
	diri setiap: { :indeks :unsur
		jumlah darab-dengan: unsur.
	}. <- jumlah.
}.

>> a := Senarai ← 1 ; 2 ; 3.
Keluaran tulis: a hasil-darab, baris-baharu.
Keluaran tulis: (Senarai ← 2 ; 4 ; 8) hasil-darab, baris-baharu. 
Keluaran tulis: (Senarai ← -2 ; 10) hasil-darab, baris-baharu. 
Keluaran tulis: (Senarai ← 0.5 ; -2) hasil-darab, baris-baharu. 
