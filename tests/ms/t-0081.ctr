>> peta1 := Kamus baharu.
>> kunci1 := Senarai baharu.
>> kunci2 := Senarai baharu.

peta1
	letak: ['hello'] di: kunci1,
	letak: ['world'] di: kunci2.


Keluaran
	tulis: ['Map #1 contains: '] + (peta1 di: kunci1),
	tulis: [' dan '] + (peta1 di: kunci2), baris-baharu.

>> TatasusunanBerkunci := Senarai baharu.
TatasusunanBerkunci apabila: ['keTeks'] lakukan: { <- (diri bilangan) keTeks.
}.

>> map2 := Kamus baharu.
kunci1 := TatasusunanBerkunci baharu.
kunci2 := TatasusunanBerkunci baharu.

kunci1 tambah-di-hujung: 1.

map2
	letak: ['hello'] di: kunci1,
	letak: ['world'] di: kunci2.

Keluaran
	tulis: ['Map #2 contains: '] + (map2 di: kunci1),
	tulis: [' dan '] + (map2 di: kunci2), baris-baharu.
