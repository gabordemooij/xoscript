>> map1 := Kamus baharu.
>> key1 := Senarai baharu.
>> key2 := Senarai baharu.

map1
	letak: ['hello'] di: key1,
	letak: ['world'] di: key2.


Keluaran
	tulis: ['Map #1 contains: '] + (map1 di: key1),
	tulis: [' and '] + (map1 di: key2), baris-baharu.

>> KeyeableArray := Senarai baharu.
KeyeableArray apabila: ['toString'] lakukan: { <- (diri bilangan) toString.
}.

>> map2 := Kamus baharu.
key1 := KeyeableArray baharu.
key2 := KeyeableArray baharu.

key1 tambah-di-hujung: 1.

map2
	letak: ['hello'] di: key1,
	letak: ['world'] di: key2.

Keluaran
	tulis: ['Map #2 contains: '] + (map2 di: key1),
	tulis: [' and '] + (map2 di: key2), baris-baharu.
