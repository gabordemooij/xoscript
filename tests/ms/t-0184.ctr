a multiplyBy: 0.5.
a := a + (2 kuasa: 8).  
a := a + (2 kuasa: -1). 
a := a + (49 punca-kuasa-dua).   
a addNum: ((Senarai ← 0 ; 1) maksimum).          
a addNum: ((Senarai ← 2 ; 3) minimum).
Keluaran tulis: a.

Atur-cara kemaskan.
ingatanDigunakan2 := (Atur-cara ingatan ? 0).


a := 1.
