

>> ingatanDigunakan1 := 0.
>> ingatanDigunakan2 := 0.
>> ingatanDigunakan3 := 0.
>> ingatanDigunakan4 := 0.

Atur-cara pengurusan-ingatan: 0.

Nombor apabila: ['addNum:'] lakukan: { :x
	diri tambah: x.
}.

Nombor apabila: ['subtractNum:'] lakukan: { :x
	diri tolak: x.
}.

Nombor apabila: ['multiplyBy:'] lakukan: { :x
	diri darab-dengan: x.
}.

Nombor apabila: ['divideBy:'] lakukan: { :x
	diri bahagi-dengan: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 kuasa: 8).  
a := a + (2 kuasa: -1). 
a := a + (49 punca-kuasa-dua).   
a addNum: ((Senarai ← 0 ; 1) maksimum).          
a addNum: ((Senarai ← 2 ; 3) minimum).
Keluaran tulis: a.

Atur-cara kemaskan.

ingatanDigunakan1 := (Atur-cara ingatan ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
