Keluaran tulis: ['Test object'], baris-baharu.
>> a := Objek baharu. 

a apabila: ['item:'] lakukan: { :moment
	milik moment := moment. 
}.

a apabila: ['item'] lakukan: { <- milik moment.
}.

>> today := Senarai baharu ; ( Detik baharu zon: ['CEST'], tahun: 2026, bulan: 7 ).
a item: today.
Keluaran tulis: a item ? 0, baris-baharu.
a save-as: ['/tmp/a.bin'].
