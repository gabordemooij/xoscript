Keluaran tulis: ['Objek ujian'], baris-baharu.
>> a := Objek baharu. 

a apabila: ['item:'] lakukan: { :dtk
	milik dtk := dtk. 
}.

a apabila: ['barang'] lakukan: {
	<- milik dtk.
}.

>> hari-ini := Senarai baharu ; ( Detik baharu zon: ['CEST'], tahun: 2026, bulan: 7 ).
a item: hari-ini.
Keluaran tulis: a barang ? 0, baris-baharu.
a save-as: ['/tmp/a.bin'].
