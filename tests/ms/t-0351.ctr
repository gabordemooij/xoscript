
>> ingatanDigunakan1 := 0.
>> ingatanDigunakan2 := 0.
>> ingatanDigunakan3 := 0.
>> ingatanDigunakan4 := 0.

>> kod := {
	>> o := (
		Kamus baharu
		aa: (Senarai ← 1 ; 2),
		bb: (Senarai ← 3 ; 4)
	).
	>> s := o teks.
	>> o2 := s objek.
	(s  jenis = Teks jenis) benar: { Keluaran tulis: ['OK1'], baris-baharu. }.
	(o2 jenis = Kamus jenis) benar: { Keluaran tulis: ['OK2'], baris-baharu. }.
}.

Atur-cara pengurusan-ingatan: 0.
['Ingatan 1 akan berbeza kerana blok yang dijejak ditambah secara pukal.'].
Atur-cara kemaskan.
ingatanDigunakan1 := (Atur-cara ingatan ? 1).
kod mula.
Atur-cara kemaskan.
ingatanDigunakan2 := (Atur-cara ingatan ? 1).
kod mula.
Atur-cara kemaskan.
ingatanDigunakan3 := (Atur-cara ingatan ? 1).
kod mula.
Atur-cara kemaskan.
ingatanDigunakan4 := (Atur-cara ingatan ? 1).

(ingatanDigunakan2 = ingatanDigunakan3 = ingatanDigunakan4) benar: { Keluaran tulis: ['OK3'], baris-baharu. }.
 
