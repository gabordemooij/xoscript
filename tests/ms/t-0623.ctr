

>> g  := Server baharu.
>> v  := Peti-besi baharu.
>> ok := 0.

>> rahsia-rahsia := Senarai baharu ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> senarai-katalaluan := rahsia-rahsia salin.
senarai-katalaluan setiap: { :i :p
	rahsia-rahsia setiap: { :n :s
		{
			>> disulitkan := v sulitkan: s kunci: p.
			>> dinyahsulit := v nyahsulit: disulitkan kunci: p.
			(dinyahsulit = s) benar: {
				ok tambah: 1.
			}, jika-tidak: {
				Keluaran tulis: ['gagal menyulit/menyahsulit: '], baris-baharu.
				Keluaran tulis: s, baris-baharu.
				Keluaran tulis: ['disulitkan: '] + disulitkan, baris-baharu.
				Keluaran tulis: ['dinyahsulit: '] + disulitkan, baris-baharu.
				Atur-cara tamat.
			}.
		} tangkap: { :rlt
			(s = [''] atau: p = ['']) benar: {
				ok tambah: 1.
			}, jika-tidak: {
				Keluaran tulis: rlt, baris-baharu.
				Atur-cara tamat.
			}.
		}, mula.
	}.
}.

Keluaran tulis: ( ok + [' penyulitan peti kebal telah diuji.'] ), baris-baharu.