# Uji varian ASCII

# Nombor

Keluaran tulis: (2 !=: 3), baris-baharu.
Keluaran tulis: (2 <=: 2), baris-baharu.
Keluaran tulis: (2 >=: 2), baris-baharu.

# Teks

Keluaran tulis: (['b'] >=: ['a']), baris-baharu.
Keluaran tulis: (['b'] !=: ['a']), baris-baharu.
Keluaran tulis: (['b'] <=: ['c']), baris-baharu.

# Boolean

Keluaran tulis: (Benar !=: Palsu), baris-baharu.

# Objek

Keluaran tulis: (Objek baharu !=: Objek baharu), baris-baharu.

# simbol senarai ASCII <-:

Keluaran tulis: (Senarai <<: 1, ; 2 ; 3) bilangan = 3, baris-baharu.

