Keluaran tulis: ['Objek ujian'], baris-baharu.
>> a := Objek baharu. 
a apabila: ['item:'] lakukan: { :snr
	milik snr := snr. 
}.
a apabila: ['barang'] lakukan: {
	<- milik snr.
}.
a item: (
	Senarai baharu ; 1 ; (
		Senarai baharu ; ['a'] ; (
			Senarai baharu ; ( Detik baharu: 1 )
		) ; ( Int64 daripada-teks: ['321'] )
	)
).
Keluaran tulis: a barang, baris-baharu.
>> alamat-lama-snr := a barang prototaip alamat-ingatan.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== MEMUAT SEMULA SNAP:'], baris-baharu.
>> b := Objek load-from: ['/tmp/a.bin'].
(b barang prototaip alamat-ingatan = alamat-lama-snr) benar: {
	Keluaran tulis: ['Pautan objek dipasang semula.'], baris-baharu.
}.
Keluaran tulis: ( b barang ), baris-baharu.
