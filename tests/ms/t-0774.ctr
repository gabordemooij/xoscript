Keluaran tulis: ['Test object'], baris-baharu.
>> a := Objek baharu. 
a apabila: ['item:'] lakukan: { :lst
	milik lst := lst. 
}.
a apabila: ['item'] lakukan: { <- milik lst.
}.
a item: (
	Senarai baharu ; 1 ; (
		Senarai baharu ; ['a'] ; (
			Senarai baharu ; ( Detik baharu: 1 )
		) ; ( Int64 daripada-teks: ['321'] )
	)
).
Keluaran tulis: a item, baris-baharu.
>> old-lst-address := a item prototaip alamat-ingatan.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baharu.
>> b := Objek load-from: ['/tmp/a.bin'].
(b item prototaip alamat-ingatan = old-lst-address) benar: {
	Keluaran tulis: ['Object link re-attached.'], baris-baharu.
}.
Keluaran tulis: ( b item ), baris-baharu.
