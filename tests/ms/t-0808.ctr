# kunci dan tandatangan Peti-besi yang dinyahkod terlalu panjang tidak boleh melimpahkan tindanan
Server init.

>> pasangan-kunci := Peti-besi jana-kunci.
>> kp := pasangan-kunci pertama.
>> ku := pasangan-kunci terakhir.
>> ttd := Peti-besi tandatangan: ['abc'] dengan: kp.

# 88 aksara tanpa pelapik dinyahkod kepada 66 bait
>> panjang-sekali := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 aksara tanpa pelapik dinyahkod kepada 33 bait
>> pendek := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Peti-besi tandatangan: ['abc'] dengan: panjang-sekali. } tangkap: { :e
	Keluaran tulis: e, baris-baharu.
}, mula.

{ Peti-besi semak: ['abc'] tandatangan: panjang-sekali dengan: ku. } tangkap: { :e
	Keluaran tulis: e, baris-baharu.
}, mula.

{ Peti-besi semak: ['abc'] tandatangan: ttd dengan: pendek. } tangkap: { :e
	Keluaran tulis: e, baris-baharu.
}, mula.
