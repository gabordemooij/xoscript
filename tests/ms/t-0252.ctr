#Linux
>> clock := Detik baharu.
clock zon: ['UTC-1'].
clock tahun: 1981, bulan: 1, hari: 5,
      jam: 13, minit: 15, saat: 13.

Keluaran tulis: clock, baris-baharu.
clock zon: ['UTC+0'].

Keluaran tulis: (
	(clock tahun biasa) + ['-'] + (clock bulan) + ['-'] + (clock hari) + [' '] +
	(clock jam) + [':'] + (clock minit) + [':'] + (clock saat) + [' '] +
	['W'] + (clock minggu) + (clock zon)
), baris-baharu.


clock zon: ['UTC-1'].
Keluaran tulis: (
	(clock tahun biasa) + ['-'] + (clock bulan) + ['-'] + (clock hari) + [' '] +
	(clock jam) + [':'] + (clock minit) + [':'] + (clock saat) + [' '] +
	['W'] + (clock minggu) + (clock zon)
), baris-baharu.
