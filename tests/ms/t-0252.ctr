#Linux
>> jam-dinding := Detik baharu.
jam-dinding zon: ['UTC-1'].
jam-dinding tahun: 1981, bulan: 1, hari: 5,
      jam: 13, minit: 15, saat: 13.

Keluaran tulis: jam-dinding, baris-baharu.
jam-dinding zon: ['UTC+0'].

Keluaran tulis: (
	(jam-dinding tahun biasa) + ['-'] + (jam-dinding bulan) + ['-'] + (jam-dinding hari) + [' '] +
	(jam-dinding jam) + [':'] + (jam-dinding minit) + [':'] + (jam-dinding saat) + [' '] +
	['W'] + (jam-dinding minggu) + (jam-dinding zon)
), baris-baharu.


jam-dinding zon: ['UTC-1'].
Keluaran tulis: (
	(jam-dinding tahun biasa) + ['-'] + (jam-dinding bulan) + ['-'] + (jam-dinding hari) + [' '] +
	(jam-dinding jam) + [':'] + (jam-dinding minit) + [':'] + (jam-dinding saat) + [' '] +
	['W'] + (jam-dinding minggu) + (jam-dinding zon)
), baris-baharu.
