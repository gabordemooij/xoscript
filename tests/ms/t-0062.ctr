Boolean apabila: ['xor:'] lakukan: { :a :b <- ((a dan: b bukan) atau: (a bukan dan: b)).
}.

>> o := Objek baharu.
o apabila: ['hello'] lakukan: { ['Empty']. }.
{ o apabila: 2 lakukan: 3.} tangkap: { :e Keluaran tulis: e, baris-baharu. }, mula.
{ o apabila: ['uji'] lakukan: 3.} tangkap: { :e Keluaran tulis: e, baris-baharu. }, mula.
{ o apabila: ['hello'] lakukan: { ['Empty']. }.} tangkap: { :e Keluaran tulis: e, baris-baharu. }, mula. 
{ >> z := 4 ÷ 0. } tangkap: { :e Keluaran tulis: e, baris-baharu. }, mula. 
{ (Benar dan: Tiada) benar: { Keluaran tulis: ['X'].}. } tangkap: { :e Keluaran tulis: e, baris-baharu. }, mula. 
{ ([''] xor: 0) benar: { Keluaran tulis: ['X'].}. } tangkap: { :e Keluaran tulis: e, baris-baharu. }, mula. 
{ (1 < ['2']) benar: { Keluaran tulis: ['OK']. }. } tangkap: { :e Keluaran tulis: e, baris-baharu. }, mula. 
{ (1 < ['2.0']) benar: { Keluaran tulis: ['OK']. }. } tangkap: { :e Keluaran tulis: e, baris-baharu. }, mula. 
{ (1 < ['x2.0']) benar: { Keluaran tulis: ['NO!']. }. } tangkap: { :e Keluaran tulis: e, baris-baharu. }, mula. 
{ Keluaran tulis: (['hello OK there'] dari: ['6'] panjang: ['2']). } mula. 
