# uji kaedah tangkap-semua
>> x13 := Objek baharu.
x13 apabila: ['a'] lakukan: { :a Keluaran tulis: 0, baris-baharu. }.
x13 apabila: ['a:'] lakukan: { :a Keluaran tulis: a, baris-baharu. <- 5. }.
x13 apabila: ['a:b:'] lakukan: { :a :b Keluaran tulis: (a + b), baris-baharu. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
