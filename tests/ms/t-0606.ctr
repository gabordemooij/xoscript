>> Point := Objek baharu.
Point apabila: ['x-coordinate:'] lakukan: { :x milik x := x. }.
Point apabila: ['y-coordinate:'] lakukan: { :y milik y := y. }.
Point apabila: ['x-coordinate']  lakukan: { <- milik x salin. }.
Point apabila: ['y-coordinate']  lakukan: { <- milik y salin. }.

Point apabila: ['='] lakukan: { :other <- ( milik x = other x-coordinate
		 dan: milik y = other y-coordinate ).
}.

>> pier := Point baharu x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point baharu x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point baharu x-coordinate: 5, y-coordinate: 6.

Keluaran tulis: pier = town-hall, baris-baharu.
Keluaran tulis: pier = restaurant, baris-baharu.
