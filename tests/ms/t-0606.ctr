>> Titik := Objek baharu.
Titik apabila: ['x-coordinate:'] lakukan: { :x milik x := x. }.
Titik apabila: ['y-coordinate:'] lakukan: { :y milik y := y. }.
Titik apabila: ['koordinat-x']  lakukan: { <- milik x salin. }.
Titik apabila: ['koordinat-y']  lakukan: { <- milik y salin. }.

Titik apabila: ['='] lakukan: { :yang-lain
	<- ( milik x = yang-lain koordinat-x
		 dan: milik y = yang-lain koordinat-y ).
}.

>> jeti := Titik baharu x-coordinate: 5, y-coordinate: 6.
>> dewan-bandaran := Titik baharu x-coordinate: 7, y-coordinate: 1.
>> restoran := Titik baharu x-coordinate: 5, y-coordinate: 6.

Keluaran tulis: jeti = dewan-bandaran, baris-baharu.
Keluaran tulis: jeti = restoran, baris-baharu.
