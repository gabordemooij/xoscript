#ujian regex, dengan look around positif
Server init.
>> subject := ['bacabcca'].
>> corak-cari := Corak baharu: ['(\\w{2})(?=ca)'].
>> hasil  := corak-cari padan: subject lakukan: { :m :x
	Keluaran tulis: m, baris-baharu.
	Keluaran tulis: x, baris-baharu.
	<- ['XXX'].
}.
Keluaran tulis: hasil, baris-baharu.
