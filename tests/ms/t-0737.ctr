#regex test, with positive look around
Server init.
>> subject := ['bacabcca'].
>> pattern := Corak baharu: ['(\\w{2})(?=ca)'].
>> result := pattern padan: subject lakukan: { :m :x
	Keluaran tulis: m, baris-baharu.
	Keluaran tulis: x, baris-baharu. <- ['XXX'].
}.
Keluaran tulis: result, baris-baharu.
