# format mesti sesuai dengan jenis nilai, jenis itu boleh datang daripada klien
>> cuba := { :bentuk :value
	{ Keluaran tulis: ( (Format baharu: bentuk) gunakan-pada: value ), baris-baharu. } tangkap: { :e Keluaran tulis: e, baris-baharu. }, mula.
}.
>> cuba-int := { :bentuk :value
	{ Keluaran tulis: ( (Format baharu: bentuk) gunakan-pada-integer: value ), baris-baharu. } tangkap: { :e Keluaran tulis: e, baris-baharu. }, mula.
}.

# sesuai
cuba gunakan-pada: ['|%s|'] dan: ['text'].
cuba gunakan-pada: ['%06.2f'] dan: 5.5.
cuba gunakan-pada: ['100%% %s'] dan: ['pasti'].
cuba-int gunakan-pada: ['%03d'] dan: 7.
cuba-int gunakan-pada: ['%x'] dan: 255.
cuba gunakan-pada: ['%d'] dan: (Int64 baharu daripada-teks: ['12']).
cuba gunakan-pada: ['%lld'] dan: (Int64 baharu daripada-teks: ['12']).
cuba gunakan-pada: ['%.1lf'] dan: 5.5.
cuba-int gunakan-pada: ['%hd'] dan: 7.

# tidak sesuai
cuba gunakan-pada: ['%s'] dan: 12345.
cuba gunakan-pada: ['%d'] dan: 12345.
cuba gunakan-pada: ['%f'] dan: ['text'].
cuba-int gunakan-pada: ['%d'] dan: ['text'].
cuba-int gunakan-pada: ['%s'] dan: 5.
cuba gunakan-pada: ['%s %s'] dan: ['text'].
cuba gunakan-pada: ['%n'] dan: ['text'].
cuba gunakan-pada: ['%*s'] dan: ['text'].
cuba gunakan-pada: ['%'] dan: ['text'].

# pengubah suai panjang tidak sesuai
cuba gunakan-pada: ['%ls'] dan: ['text'].
cuba gunakan-pada: ['%Lf'] dan: 5.5.
cuba-int gunakan-pada: ['%ld'] dan: 7.
cuba-int gunakan-pada: ['%lld'] dan: 7.
cuba gunakan-pada: ['%Ld'] dan: (Int64 baharu daripada-teks: ['12']).

# lebar yang tidak sesuai untuk printf mesti memberi ralat, bukan ranap
cuba gunakan-pada: ['%99999999999s'] dan: ['text'].
