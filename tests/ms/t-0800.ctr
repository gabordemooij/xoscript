Server init.

>> pd := Maria-DB baharu hos: ['localhost'],
	nama-pengguna: ['xo'],
	kata-laluan: ['pass123'],
	nama-pangkalan-data: ['xobase'],
	sambung.

>> parameter-carian := pd pertanyaan: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parameter: ( Senarai baharu ; ['abc'] ; 12.35 ; 6 ). # pertanyaan berparameter

{  parameter-carian laksana. pd sahkan. } tangkap: { :e pd batalkan.  }, mula.

Keluaran tulis: ['Bolehkah kita sisip? '] + ( parameter-carian insert-id > 0 ), baris-baharu.
