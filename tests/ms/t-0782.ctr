Keluaran tulis: ['Test object'], baris-baharu.
>> cmd := Arahan baharu.
Keluaran tulis: cmd ls /tmp, baris-baharu.
>> old-cmd-address := cmd prototaip alamat-ingatan.
cmd save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baharu.
>> b := Objek load-from: ['/tmp/a.bin'].
(b prototaip alamat-ingatan = old-cmd-address) benar: {
	Keluaran tulis: ['Object link re-attached.'], baris-baharu.
}.
Keluaran tulis: b ls, baris-baharu.


