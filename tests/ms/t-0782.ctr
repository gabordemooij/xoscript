Keluaran tulis: ['Objek ujian'], baris-baharu.
>> arh := Arahan baharu.
Keluaran tulis: arh ls /tmp, baris-baharu.
>> alamat-lama-arh := arh prototaip alamat-ingatan.
arh save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== MEMUAT SEMULA SNAP:'], baris-baharu.
>> b := Objek load-from: ['/tmp/a.bin'].
(b prototaip alamat-ingatan = alamat-lama-arh) benar: {
	Keluaran tulis: ['Pautan objek dipasang semula.'], baris-baharu.
}.
Keluaran tulis: b ls, baris-baharu.


