Server init.
Keluaran tulis: ['Database time test'], baris-baharu.

>> db := Maria-DB baharu hos: ['localhost'],
	nama-pengguna: ['xo'], 
	kata-laluan: ['pass123'],
	nama-pangkalan-data: ['xobase'],
	sambung.

>> parameter-carian :=
db pertanyaan: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
dapatkan: { :row
	Keluaran tulis: row timetest, baris-baharu.
}.
