# uji unit

>> $ := Objek baharu.

$ apabila: ['balas:'] lakukan: { :x
	
	>> operasi := x aksara: 0.
	>> valuta := x aksara: 1.
	>> wang := x langkau: 2.
	
	>> amaun := 0.

	( operasi = ['+'] ) benar: {
		( valuta = ['£'] ) benar: { amaun := 1.28 × wang. }.
	}. <- amaun.
}.



>> x := $ +£20.

Keluaran tulis: x, baris-baharu.


>> Buah := Objek baharu.

Buah apabila: ['baharu'] lakukan: {
	>> f := diri baharu.
	f apples: 0.
	f oranges: 0. <- f.
}.

Buah apabila: ['apples:'] lakukan: { :a milik epal := a. }.
Buah apabila: ['oranges:'] lakukan: { :p milik oren := p. }.
Buah apabila: ['epal'] lakukan: { <- milik epal. }.
Buah apabila: ['oren'] lakukan: { <- milik oren. }.

Buah apabila: ['+'] lakukan: { :f
	
	>> n := Buah baharu.
	f tambah: 1.
	
	n apples: (f epal + milik epal).
	n oranges:  (f oren  + milik oren). <- n.
}.

Buah apabila: ['teks'] lakukan: { <- ( milik epal teks + [' epal dan '] + milik oren + [' oren'] ).
}.

Nombor apabila: ['epal'] lakukan: { <- ((Buah baharu) apples: diri).
}.

Nombor apabila: ['apple'] lakukan: { <- ((Buah baharu) apples: diri).
}.

Nombor apabila: ['oren'] lakukan: { <- ((Buah baharu) oranges: diri).
}.




Keluaran tulis: (1 apple + 3 oren + 4 epal), baris-baharu.


Teks apabila: ['dua-kali'] lakukan: { <- ((diri teks) + (diri teks)).
}.



Keluaran tulis: ['❤❤❤'] dua-kali.



