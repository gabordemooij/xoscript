# test qualifiers

>> $ := Objek baharu.

$ apabila: ['balas:'] lakukan: { :x
	
	>> operation := x aksara: 0.
	>> valuta := x aksara: 1.
	>> money := x langkau: 2.
	
	>> amount := 0.

	( operation = ['+'] ) benar: {
		( valuta = ['£'] ) benar: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Keluaran tulis: x, baris-baharu.


>> Fruit := Objek baharu.

Fruit apabila: ['baharu'] lakukan: {
	>> f := diri baharu.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit apabila: ['apples:'] lakukan: { :a milik apples := a. }.
Fruit apabila: ['oranges:'] lakukan: { :p milik oranges := p. }.
Fruit apabila: ['apples'] lakukan: { <- milik apples. }.
Fruit apabila: ['oranges'] lakukan: { <- milik oranges. }.

Fruit apabila: ['+'] lakukan: { :f
	
	>> n := Fruit baharu.
	f tambah: 1.
	
	n apples: (f apples + milik apples).
	n oranges:  (f oranges  + milik oranges). <- n.
}.

Fruit apabila: ['teks'] lakukan: { <- ( milik apples teks + [' apples and '] + milik oranges + [' oranges'] ).
}.

Nombor apabila: ['apples'] lakukan: { <- ((Fruit baharu) apples: diri).
}.

Nombor apabila: ['apple'] lakukan: { <- ((Fruit baharu) apples: diri).
}.

Nombor apabila: ['oranges'] lakukan: { <- ((Fruit baharu) oranges: diri).
}.




Keluaran tulis: (1 apple + 3 oranges + 4 apples), baris-baharu.


Teks apabila: ['twice'] lakukan: { <- ((diri teks) + (diri teks)).
}.



Keluaran tulis: ['❤❤❤'] twice.



