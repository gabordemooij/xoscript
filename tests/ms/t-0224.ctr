
>> negara-negara := Senarai baharu
	~ ['Switzerland']
	~ ['Itali']
	~ ['Jerman'].

>> makanan := Senarai baharu
	~ ['Rösti']
	~ ['Spageti']
	~ ['Sauerkraut'].


>> pembilang := 0.
makanan mengikut: negara-negara, setiap: { :key :value
	pembilang tambah: 1.
}.

Keluaran tulis: (['we serve counter dishes'] counter: pembilang), baris-baharu.

>> pembilang := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] senarai-aksara isih: { :v
	pembilang tambah: 0.
}.

Keluaran tulis: (['we sort counter dishes'] counter: pembilang), baris-baharu.


>> pembilang := 0.
{
	{
		pembilang tambah: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Keluaran tulis: (['we calculate counter numbers.'] counter: pembilang), baris-baharu.

