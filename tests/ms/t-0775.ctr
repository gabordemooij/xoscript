Keluaran tulis: ['Objek ujian'], baris-baharu.
>> l := Senarai baharu ; 1 ; ( Senarai baharu ; (Detik baharu: 1) ; (Int64 daripada-teks: ['321']) ; (Senarai baharu ; 3)).
Keluaran tulis: l, baris-baharu.
>> alamat-lama-snr := l prototaip alamat-ingatan.
l save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== MEMUAT SEMULA SNAP:'], baris-baharu.
>> b := Objek load-from: ['/tmp/a.bin'].
(b prototaip alamat-ingatan = alamat-lama-snr) benar: {
	Keluaran tulis: ['Pautan objek dipasang semula.'], baris-baharu.
}.
Keluaran tulis: b, baris-baharu.
