Teks apabila: ['nilaikan'] lakukan: {
	>> kod := Fail baharu: ['/tmp/eval.ctr'].
	kod tulis: (diri teks + ['.']).
	Atur-cara guna: ['/tmp/eval.ctr'].
}.

>> a := Senarai ← 1 ; 2 ; 3.
>> b := (a teks).

Keluaran tulis: b, baris-baharu. 
(['b := '] + b) nilaikan.

Keluaran tulis: b ? 2, baris-baharu. 

Keluaran tulis: (( Senarai ← 1 ; 2 ; 3 )), baris-baharu. 

Keluaran tulis: ((Kamus baharu) letak: 1 di: 2), baris-baharu. 

>> x := ( (Senarai ← 1 ; ( Senarai ← 9 ) ; Benar ) ) teks.
Keluaran tulis: x, baris-baharu. 
(['x := '] + x) nilaikan.

Keluaran tulis: x ? 1 ? 0, baris-baharu. 

>> y := (Kamus baharu) letak: (Senarai ← 1) di: (Senarai ← 2).
Keluaran tulis: y, baris-baharu. 

(['y := '] + y) teks nilaikan.

Keluaran tulis: (y di: (Senarai ← 2) teks ), baris-baharu.

Keluaran tulis: (Senarai baharu), baris-baharu. 
Keluaran tulis: (Kamus baharu), baris-baharu. 
