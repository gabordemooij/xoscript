Server init.

# Pengekod JSON hanya menyokong UTF-8, tiada pasangan pengganti

>> kamus-kamus := Senarai baharu ;
	# {"key":"normal"} ASCII biasa
	( Kamus baharu letak: ['biasa'] di: ['key'] ) ;
	# {"key":"hello world"} aksara ruang
	( Kamus baharu letak: ['hello world'] di: ['key'] ) ;
	# {"key":"quote: \""} tanda petik berganda
	( Kamus baharu letak: ['"'] di: ['key'] ) ;
	# {"key":"backslash: \\"} garis condong terbalik
	( Kamus baharu letak: ['backslash: \\'] di: ['key'] ) ;
	# {"key":"slash: /"} garis condong
	( Kamus baharu letak: ['garis miring: /'] di: ['key'] ) ;
	# {"key":"backspace: \b"} undur ruang
	( Kamus baharu letak: ['backspace: \b'] di: ['key'] ) ;
	# {"key":"formfeed: \f"} escape suapan borang
	( Kamus baharu letak: ['formfeed: \f'] di: ['key'] ) ;
	# {"key":"newline: \n"} baris baharu
	( Kamus baharu letak: ['newline: \n'] di: ['key'] ) ;
	( Kamus baharu letak: ['newline: ↵'] di: ['key'] ) ;
	( Kamus baharu letak: ['newline: 
	'] di: ['key'] ) ;
	# {"key":"carriage return: \r"} pulangan kereta
	( Kamus baharu letak: ['carriage return: \r'] di: ['key'] ) ;
	# {"key":"tab: \t"} tab
	( Kamus baharu letak: ['tab \t'] di: ['key'] ) ;
	( Kamus baharu letak: ['tab ⇿'] di: ['key'] ) ;
	( Kamus baharu letak: ['tab  '] di: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( Kamus baharu letak: ['NUL \u0000'] di: ['key'] ) ;
	( Kamus baharu letak: ['NUL \0'] di: ['key'] ) ;
	# {"key":"control: \u0001"} aksara kawalan 0x01
	( Kamus baharu letak: ['control: \u0001'] di: ['key'] ) ;
	# {"key":"control: \u001F"} aksara kawalan 0x1F
	( Kamus baharu letak: ['control: \u001F'] di: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, aksara 2-bait
	( Kamus baharu letak: ['unikod: é'] di: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, aksara 3-bait
	( Kamus baharu letak: ['unikod: €'] di: ['key'] ) ;
	# {"key":"unicode: 日本語"} berbilang aksara UTF-8 3-bait
	( Kamus baharu letak: ['unikod: 日本語'] di: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, aksara 4-bait
	( Kamus baharu letak: ['unikod: 😀'] di: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + penyambung lebar-sifar
	( Kamus baharu letak: ['unikod: 🧑‍💻'] di: ['key'] ) ;
	# {"key":"combining: é"} aksen gabungan
	( Kamus baharu letak: ['combining: e\u0301'] di: ['key'] ) ;
	# {"key":"escaped unicode: é"} escape Unicode BMP
	( Kamus baharu letak: ['escaped unicode: \u00e9'] di: ['key'] ) ;
	# {"key":"escaped unicode: €"} escape Unicode BMP
	( Kamus baharu letak: ['escaped unicode: \u20ac'] di: ['key'] ) ;
	# {"key":"escaped unicode: 😀"} pasangan pengganti UTF-16
	( Kamus baharu letak: ['escaped unicode: \ud83d\ude00'] di: ['key'] ) ;
	# {"key":""} nilai kosong
	( Kamus baharu letak: [''] di: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} aksara ASCII khas
	( Kamus baharu letak: ['@ < > & = % + ? #'] di: ['key'] ) ;
	# {"key":"single quote: '"} tanda petik tunggal
	( Kamus baharu letak: ['''] di: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} berbilang escape JSON
	( Kamus baharu letak: ['multiple: \" \\ \n \r \t'] di: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} teks ASCII yang lebih panjang
	( Kamus baharu letak: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] di: ['key'] ) ;
	# {"key":" value"} ruang di hadapan
	( Kamus baharu letak: [' nilai'] di: ['key'] ) ;
	# {"key":"value "} ruang di belakang
	( Kamus baharu letak: ['nilai '] di: ['key'] ) ;
	# {"key":" \t\n\r "} ruang putih
	( Kamus baharu letak: [' \t\n\r '] di: ['key'] )
	.

kamus-kamus setiap: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (Kamus baharu letak: d key di: ['key']).
	>> b := JSON jsonify: (Kamus baharu letak: ['value'] di: d key).
	>> e := JSON objek: a.
	>> f := JSON objek: b.
	((e key = d key dan: (f ? d key = ['value'])) atau: (e key = ['NUL ?'])) benar: {
		Keluaran tulis: ['OK'], baris-baharu.
	}, jika-tidak: {
		Keluaran tulis: ['Tidak dapat mengekod/menyahkod dengan betul: '] + d + j, baris-baharu.
		Atur-cara tamat.
	}.
}.
