Server init.

>> smb1 := Maria-DB baharu hos: ['localhost'],
	nama-pengguna: ['xo'],
	kata-laluan: ['pass123'],
	nama-pangkalan-data: ['xobase'],
	sambung.

>> smb2 := Maria-DB baharu hos: ['localhost'],
	nama-pengguna: ['xo'],
	kata-laluan: ['pass123'],
	nama-pangkalan-data: ['xobase'],
	sambung.
#...
>> pdm := smb1 pertanyaan: ['DELETE FROM book WHERE id > 0'].
{  pdm laksana. smb1 sahkan. } tangkap: { :e smb1 batalkan.  }, mula.

>> sisipan := smb1 pertanyaan: ['INSERT INTO book (id) VALUES(null)'].
sisipan laksana.

>> bilangan := smb1 pertanyaan: ['SELECT COUNT(*) AS num FROM book'].
bilangan dapatkan: { :barisan Keluaran tulis: barisan num, baris-baharu. }.

# tidak kelihatan
# sisipan tidak disahkan pada sambungan 1
>> bilangan := smb2 pertanyaan: ['SELECT COUNT(*) AS num FROM book'].
bilangan dapatkan: { :barisan Keluaran tulis: barisan num, baris-baharu. }.
