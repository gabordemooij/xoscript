Atur-cara pengurusan-ingatan: 0.
Senarai apabila: ['sum'] lakukan: {
	>> total := 0.
	diri setiap: { :index :element
		total tambah: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Fail baharu: ['/tmp/test.txt'].
f tulis: ['Lorem Ipsum'].
f tutup.
  

f := Fail baharu: ['/tmp/test.txt'].
>> text := f baca.
f tutup.



Atur-cara kemaskan.
usedMemory1 := (Atur-cara ingatan ? 1).



f := Fail baharu: ['/tmp/test.txt'].
text := f baca.
f tutup.

Atur-cara kemaskan.
usedMemory2 := (Atur-cara ingatan ? 1).


f := Fail baharu: ['/tmp/test.txt'].
text := f baca.
f tutup.

Atur-cara kemaskan.
usedMemory3 := (Atur-cara ingatan ? 1).



( usedMemory1 = usedMemory2 dan: usedMemory1 = usedMemory3, dan: usedMemory2 = usedMemory3 ) benar: {
	Keluaran tulis: ['No memory leaks here'].
}, palsu: {
	Keluaran tulis: ['Leaking memory...'].
}.
