Atur-cara pengurusan-ingatan: 0.
Senarai apabila: ['jumlahkan'] lakukan: {
	>> jumlah := 0.
	diri setiap: { :indeks :unsur
		jumlah tambah: unsur.
	}. <- jumlah.
}.

>> ingatanDigunakan1 := 0.
>> ingatanDigunakan2 := 0.
>> ingatanDigunakan3 := 0.
>> ingatanDigunakan4 := 0.



>> f := Fail baharu: ['/tmp/test.txt'].
f tulis: ['Lorem Ipsum'].
f tutup.
  

f := Fail baharu: ['/tmp/test.txt'].
>> tulisan := f baca.
f tutup.



Atur-cara kemaskan.
ingatanDigunakan1 := (Atur-cara ingatan ? 1).



f := Fail baharu: ['/tmp/test.txt'].
tulisan := f baca.
f tutup.

Atur-cara kemaskan.
ingatanDigunakan2 := (Atur-cara ingatan ? 1).


f := Fail baharu: ['/tmp/test.txt'].
tulisan := f baca.
f tutup.

Atur-cara kemaskan.
ingatanDigunakan3 := (Atur-cara ingatan ? 1).



( ingatanDigunakan1 = ingatanDigunakan2 dan: ingatanDigunakan1 = ingatanDigunakan3, dan: ingatanDigunakan2 = ingatanDigunakan3 ) benar: {
	Keluaran tulis: ['Tiada kebocoran ingatan di sini'].
}, palsu: {
	Keluaran tulis: ['Ingatan bocor...'].
}.
