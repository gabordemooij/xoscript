# format kuki sesi, jenis kandungan json, protokol web sahaja, svg dipaparkan sebaris
Server mulakan-awal.
Atur-cara guna: ['../../../src/xo/ms/webtools.xo'].

>> Permintaan-Palsu := Objek baharu.
Permintaan-Palsu apabila: ['value:'] lakukan: { :nilai
	milik nilai := nilai.
}.
Permintaan-Palsu apabila: ['cookie:'] lakukan: { :nama
	<- milik nilai.
}.

>> Sesi-Ujian := Sesi-fail-sementara baharu.
Sesi-Ujian apabila: ['muatkan'] lakukan: {
	<- Kamus baharu.
}.
Sesi-Ujian apabila: ['pengenal-sesi'] lakukan: {
	<- milik id.
}.

>> kuki-kuki := Senarai baharu
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

kuki-kuki setiap: { :i :kuki
	>> permintaan-http := Permintaan-Palsu baharu.
	permintaan-http value: kuki.
	>> pengurus := Sesi-Ujian baharu.
	>> web := Dokumen-Web baharu.
	web permintaan-http: permintaan-http.
	web pengurus-sesi: pengurus.
	web mulakan-sesi.
	Keluaran tulis: ( pengurus pengenal-sesi = kuki ), baris-baharu.
}.

>> web := Dokumen-Web baharu.
web json: (Kamus baharu letak: ['b'] di: ['a']).
Keluaran tulis: ['\n'], baris-baharu.

{ Rangkaian get: ['file:///etc/hostname']. } tangkap: { :e
	Keluaran tulis: e, baris-baharu.
}, mula.

>> svg := Fail baharu: ['/tmp/test0814.svg'].
svg tulis: ['<svg xmlns="x"></svg>'].
Keluaran baris-baharu.
Server teruskan: ['test0814.svg'] awalan: ['/tmp/'].
svg padam.
