
>> Hirup := Objek baharu.

Hirup apabila: ['baharu'] lakukan: {
	milik str := [''].
}.

Hirup apabila: ['balas:'] lakukan: { :blah
		(milik str = ['']) benar: {
			milik str tambah-di-hujung: blah.
		}, jika-tidak: {
			milik str tambah-di-hujung: [' '].
			milik str tambah-di-hujung: blah.
		}.
}.

Hirup apabila: ['balas:dan:'] lakukan: { :blah :blahah
		(blah panjang > 1) benar: {
			milik str tambah-di-hujung: (blah dari: 0 panjang: (blah panjang - 1)).
		}, jika-tidak: {
			milik str tambah-di-hujung: blah.
		}.
		milik str tambah-di-hujung: [' '].
		milik str tambah-di-hujung: blahah.
}.

Hirup apabila: ['peroleh'] lakukan: {
	>> penimbal := milik str.
	milik str := ['']. <- penimbal.
}.

Keluaran tulis: ( Atur-cara sistem: ( Hirup baharu echo hello world peroleh ) ).
