#Linux
>> Hirup := Objek baharu.

Hirup apabila: ['baharu'] lakukan: {
	milik str := [''].
}.

Hirup apabila: ['nieuw'] lakukan: {
	milik str := [''].
}.

Hirup apabila: ['balas:'] lakukan: { :blah
		milik str tambah-di-hujung: blah.
}.

Hirup apabila: ['balas:dan:'] lakukan: { :blah :blahah
		milik str tambah-di-hujung: (blah dari: 0 panjang: (blah panjang - 1)).
		milik str tambah-di-hujung: [' '].
		milik str tambah-di-hujung: blahah.
}.

Hirup apabila: ['peroleh'] lakukan: {
	>> penimbal := milik str.
	milik str := ['']. <- penimbal.
}.


Keluaran tulis: (Atur-cara sistem: (Hirup baharu echo: ['Helo saya boleh menulis ke konsol menggunakan API lancar!'], peroleh)).


{ Fail baharu: ['/tmp/from.txt'], padam. } tangkap: { ['Kosong']. }, mula.
{ Fail baharu: ['/tmp/to.txt'], padam. } tangkap: { ['Kosong']. }, mula.


Fail baharu: ['/tmp/to.txt'], wujud palsu: {
	Keluaran tulis: ['Confirmed. Target file does not exist.\
'].
}.
Fail baharu: ['/tmp/from.txt'], wujud palsu: {
	Keluaran tulis: ['Confirmed. Source file does not exist.\
'].
}.



Atur-cara sistem: (Hirup baharu touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], peroleh).



Atur-cara sistem: (Hirup baharu cp: ['/tmp/from.txt /tmp/to.txt'], peroleh).

Fail baharu: ['/tmp/to.txt'], wujud benar: {
	Keluaran tulis: ['Confirmed. Target file has been created by shell.\
'].
}.


Keluaran tulis: ['Kandungan fail ialah:'] + (Fail baharu: ['/tmp/to.txt'], baca), baris-baharu.
