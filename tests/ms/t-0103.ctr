>> a := Senarai ← Objek ; Benar ; Palsu ; Boolean ; 1 ; Nombor ; ['Str'] ; Teks ; { ['Kosong']. }.
Keluaran tulis: (a bilangan), baris-baharu.
{ :i
	Keluaran tulis: 
	['a '] + 
	((a ? i) jenis) +
	([' \‘this\’ '] this: (a ? i))  +
	[' ialah '] +
	(((a ? i) Tiada?) pilih: [''] atau: ['BUKAN']) + 
	[' Tiada.'],
	baris-baharu.
} × (a bilangan).
Keluaran tulis: ['tetapi.. Tiada ialah.. '] + ((Tiada Tiada?) pilih: ['pasti TIADA!'] atau: ['bukan TIADA??']), baris-baharu.