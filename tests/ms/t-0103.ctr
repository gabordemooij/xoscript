>> a := Senarai ← Objek ; Benar ; Palsu ; Boolean ; 1 ; Nombor ; ['Str'] ; Teks ; { ['Empty']. }.
Keluaran tulis: (a bilangan), baris-baharu.
{ :i
	Keluaran tulis: 
	['a '] + 
	((a ? i) jenis) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Tiada?) pilih: [''] atau: ['NOT']) + 
	[' Nil.'],
	baris-baharu.
} × (a bilangan).
Keluaran tulis: ['but.. Nil is.. '] + ((Tiada Tiada?) pilih: ['certainly NIL!'] atau: ['not NIL??']), baris-baharu.