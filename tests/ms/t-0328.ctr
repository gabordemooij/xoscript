Atur-cara pengurusan-ingatan: 4.

>> PenggandaDua := Objek baharu.
>> Pendarab := Objek baharu.
PenggandaDua apabila: ['gandakan:dan:'] lakukan: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Pendarab apabila: ['darab:dan:'] lakukan: { :x :y <- (x × y).
}.

Keluaran tulis: (
	PenggandaDua gandakan:
		(PenggandaDua gandakan: 
			(Pendarab darab: 2 dan: 3)
		dan:
			(Pendarab darab: 3 dan: 4)
		)
	dan:
		(PenggandaDua gandakan: 
			(Pendarab darab: 2 dan: 3)
		dan:
			(Pendarab darab: 3 dan: 4)
		)
), baris-baharu.
