Atur-cara pengurusan-ingatan: 4.

>> Doubler := Objek baharu.
>> Multiplier := Objek baharu.
Doubler apabila: ['double:and:'] lakukan: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier apabila: ['multiply:and:'] lakukan: { :x :y <- (x × y).
}.

Keluaran tulis: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), baris-baharu.
