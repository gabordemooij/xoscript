>> HTML := Objek baharu.
HTML apabila: ['balas:'] lakukan: { :tag 
	Keluaran tulis: (['<tag>'] tag: tag), baris-baharu.
}.
HTML apabila: ['balas:dan:'] lakukan: { :tag :html 
	Keluaran tulis: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), baris-baharu.
}.
>> html := HTML baharu.
html body h1: ['header'].

