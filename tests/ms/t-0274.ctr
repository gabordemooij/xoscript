

Senarai apabila: ['column:'] lakukan: { :lajur
	>> hasil := Senarai baharu.
	diri setiap: { :indeks :barisan
		barisan setiap: { :indeks :sel
			(indeks = lajur) benar: { hasil tambah-di-hujung: sel. }.
		}.
	}. <- hasil.
}.


>> a := Senarai ←
	(Senarai ← 1 ; 2 ; 3) ;
	(Senarai ← 4 ; 5 ; 6) ;
	(Senarai ← 7 ; 8 ; 9).

>> b := a column: 1.
Keluaran tulis: b, baris-baharu.

b := a column: 20.
Keluaran tulis: b, baris-baharu.

b := a column: -100.
Keluaran tulis: b, baris-baharu.
