

Senarai apabila: ['column:'] lakukan: { :column
	>> result := Senarai baharu.
	diri setiap: { :index :row
		row setiap: { :index :cell
			(index = column) benar: { result tambah-di-hujung: cell. }.
		}.
	}. <- result.
}.


>> a := Senarai ←
	(Senarai ← 1 ; 2 ; 3) ;
	(Senarai ← 4 ; 5 ; 6) ;
	(Senarai ← 7 ; 8 ; 9).

>> b := a column: 1.
Keluaran tulis: b, baris-baharu.

b := a column: 20.
Keluaran tulis: b, baris-baharu.

b := a column: -100.
Keluaran tulis: b, baris-baharu.
