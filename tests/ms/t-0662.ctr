>> t := Tiada.

# anda boleh mengawal zon waktu untuk
# penghuraian seperti ini:
Detik zon: ['CET'].
t := Detik daripada: ['1981-02-03 04:05:06'].
Keluaran tulis: t, baris-baharu.

# kini menggunakan zon waktu CEST:
Detik zon: ['CEST'].
t := Detik daripada: ['1981-02-03 04:05:06'].
Keluaran tulis: t, baris-baharu.

# ralat jika teks tidak dapat dihuraikan
{ Detik daripada: ['1900']. } tangkap: { Tiada. }, mula.
