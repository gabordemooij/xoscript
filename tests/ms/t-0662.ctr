>> t := Tiada.

# you can control the time zone for
# parsing like this:
Detik zon: ['CET'].
t := Detik daripada: ['1981-02-03 04:05:06'].
Keluaran tulis: t, baris-baharu.

# now using CEST time zone:
Detik zon: ['CEST'].
t := Detik daripada: ['1981-02-03 04:05:06'].
Keluaran tulis: t, baris-baharu.

# error if string cannot be parsed
{ Detik daripada: ['1900']. } tangkap: { Tiada. }, mula.
