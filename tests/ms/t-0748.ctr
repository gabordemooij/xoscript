Keluaran tulis: ['Test object'], baris-baharu.
>> a := Objek baharu. 

a apabila: ['item:'] lakukan: { :boolean
	milik boolean := boolean. 
}.

a apabila: ['item'] lakukan: { <- milik boolean.
}.

a item: Benar.

Keluaran tulis: a item, baris-baharu.

>> old-bool-address := a item prototaip alamat-ingatan.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baharu.

>> b := Objek load-from: ['/tmp/a.bin'].

(b item prototaip alamat-ingatan = old-bool-address) benar: {
	Keluaran tulis: ['Object link re-attached.'], baris-baharu.
}.

Keluaran tulis: b item, baris-baharu.
