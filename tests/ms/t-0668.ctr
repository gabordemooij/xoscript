# nyahkod daripada utf16le/be atau utf32le/be ke utf8
Server init.
>> utf16 := Blob baharu: 8, bytes: (
	Senarai baharu ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Keluaran tulis: ( utf16 nyahkod: ['utf16le'] ), baris-baharu.

utf16 bebaskan.
>> utf32 := Blob baharu: 13, bytes: (
	Senarai baharu ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Keluaran tulis: ( utf32 nyahkod: ['utf32be'] ), baris-baharu.
utf32 bebaskan.