Server init.

>> pd := Maria-DB baharu hos: ['localhost'],
	nama-pengguna: ['xo'],
	kata-laluan: ['pass123'],
	nama-pangkalan-data: ['xobase'],
	sambung.

>> pdm := pd pertanyaan: ['DELETE FROM book WHERE id > 0'].
{  pdm laksana. pd sahkan. } tangkap: { :e pd batalkan.  }, mula.

>> bilangan := pd pertanyaan: ['SELECT COUNT(*) AS num FROM book'].
bilangan dapatkan: { :barisan Keluaran tulis: barisan num, baris-baharu. }.
