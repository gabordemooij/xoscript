Server init.

>> db := Maria-DB baharu hos: ['localhost'],
	nama-pengguna: ['xo'],
	kata-laluan: ['pass123'],
	nama-pangkalan-data: ['xobase'],
	sambung.

>> del := db pertanyaan: ['DELETE FROM book WHERE id > 0'].
{  del laksana. db sahkan. } tangkap: { :e db batalkan.  }, mula.

>> bilangan := db pertanyaan: ['SELECT COUNT(*) AS num FROM book'].
bilangan dapatkan: { :row Keluaran tulis: row num, baris-baharu. }.
