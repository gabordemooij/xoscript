

>> ingatanDigunakan1 := 0.
>> ingatanDigunakan2 := 0.
>> ingatanDigunakan3 := 0.
>> ingatanDigunakan4 := 0.

Atur-cara pengurusan-ingatan: 0.

>> txt := ['Word Salad'].
Keluaran tulis: ( txt salin dari: 5 panjang: 5 ).
Keluaran tulis: ( txt salin langkau: 5, pangkas ), baris-baharu.

Atur-cara kemaskan.

ingatanDigunakan1 := (Atur-cara ingatan ? 0).


txt := ['Word Salad'].
Keluaran tulis: ( txt salin dari: 5 panjang: 5 ).
Keluaran tulis: ( txt salin langkau: 5, pangkas ), baris-baharu.

Atur-cara kemaskan.
ingatanDigunakan2 := (Atur-cara ingatan ? 0).


txt := ['Word Salad'].
Keluaran tulis: ( txt salin dari: 5 panjang: 5 ).
Keluaran tulis: ( txt salin langkau: 5, pangkas ), baris-baharu.

Atur-cara kemaskan.
ingatanDigunakan3 := (Atur-cara ingatan ? 0).



( ingatanDigunakan1 = ingatanDigunakan2 dan: ingatanDigunakan1 = ingatanDigunakan3, dan: ingatanDigunakan2 = ingatanDigunakan3 ) benar: {
	Keluaran tulis: ['Tiada kebocoran ingatan di sini'].
}, palsu: {
	Keluaran tulis: ['Ingatan bocor...'].
}.
