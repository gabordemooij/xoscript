# backslashes must survive code serialization, strings must not end early
>> nilai-nilai := Senarai baharu
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

nilai-nilai setiap: { :i :value
	>> d := Kamus baharu.
	d letak: value di: ['k'].
	>> r := d kod objek.
	Keluaran tulis: r bilangan, baris-baharu.
	Keluaran tulis: ( (r di: ['k']) = value ), baris-baharu.
}.
