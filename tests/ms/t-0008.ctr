>> Greeter := Objek baharu.
Greeter apabila: ['make'] lakukan: {
	>> greeter := Objek baharu.
	greeter apabila: ['name:'] lakukan: { :nama
		Keluaran tulis: ['setting a name'].
		milik myName := nama.
	}.
	greeter apabila: ['greet'] lakukan: {
		Keluaran tulis: ['Hello'].
		Keluaran tulis: milik myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
