Senarai apabila: ['salin'] lakukan: {
	>> salin := Senarai baharu.
	diri setiap: { :nombor :seksyen
		salin tambah-di-hujung: seksyen rekursif salin.
	}.
	<- salin.
}.

>> biri-biri := Senarai baharu ; ['Dolly'] ; ['Shaun']. 
>> klon-klon := biri-biri salin.
klon-klon setiap: { :nombor :biri-biri
	biri-biri tambah-di-hujung: ['2'].
}.

Keluaran tulis: biri-biri, baris-baharu.
Keluaran tulis: klon-klon, baris-baharu.
