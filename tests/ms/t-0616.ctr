Senarai apabila: ['salin'] lakukan: {
	>> salin := Senarai baharu.
	diri setiap: { :nombor :section
		salin tambah-di-hujung: section rekursif salin.
	}. <- salin.
}.

>> sheep := Senarai baharu ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep salin.
clones setiap: { :nombor :sheep
	sheep tambah-di-hujung: ['2'].
}.

Keluaran tulis: sheep, baris-baharu.
Keluaran tulis: clones, baris-baharu.
