# ujian pangkalan data
# lihat contoh server.xo untuk konfigurasi yang diperlukan

Server init.
Keluaran tulis: ['Ujian pangkalan data'], baris-baharu.

>> pd := Maria-DB baharu hos: ['localhost'],
	nama-pengguna: ['xo'], kata-laluan: ['pass123'], nama-pangkalan-data: ['xobase'], sambung.

Keluaran tulis: ['Bolehkah kita sambung? '] + pd bersambung?, baris-baharu.

>> parameter-carian := pd pertanyaan: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parameter: ( Senarai baharu ; ['abc'] ; 12.35 ; 6 ). # pertanyaan berparameter

{  parameter-carian laksana. pd sahkan. } tangkap: { :e pd batalkan.  }, mula.

Keluaran tulis: ['Bolehkah kita sisip? '] + ( parameter-carian insert-id > 0 ), baris-baharu.

>> x := 0.
>> parameter-carian :=
pd pertanyaan: ['SELECT * FROM book order by id desc limit 2'], 
dapatkan: { :barisan 
	x tambah: 1.
	Benar henti. # mesti dikemaskan, tiada 'Commands out of sync'
}.

>> parameter-carian :=
pd pertanyaan: ['SELECT * FROM book order by id desc limit 2'], 
dapatkan: { :barisan
	x tambah: 1.
	Benar henti.
}.

(x > 0) benar: {
	Keluaran tulis: ['Bolehkah kita henti di tengah-tengah pengambilan? '].
}.

Keluaran tulis: Benar, baris-baharu.