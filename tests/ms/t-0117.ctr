>> t := Benar.
(t = Benar) benar: { Keluaran tulis: ['T']. }.
(t = Palsu) benar: { Keluaran tulis: ['F']. }.
Keluaran tulis: ['|'].
>> t := Palsu.
(t = Benar) benar: { Keluaran tulis: ['T']. }.
(t = Palsu) benar: { Keluaran tulis: ['F']. }.
Keluaran tulis: ['|'].
>> f := Benar.
(t = Benar dan: f = Palsu) benar: { Keluaran tulis: ['T']. }.
(t = Palsu dan: f = Benar) benar: { Keluaran tulis: ['F']. }.
Keluaran tulis: ['|'].
>> n := Tiada.
(n Tiada?) benar: { Keluaran tulis: ['T']. }.
(n Tiada?) palsu: { Keluaran tulis: ['F']. }.
Keluaran tulis: ['|'].
(f Boolean?) benar: { Keluaran tulis: ['T']. }.
(f Boolean?) palsu: { Keluaran tulis: ['F']. }.



