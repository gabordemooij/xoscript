Nombor apabila: ['rumawi'] lakukan: {
	>> nombor := diri salin.
	>> rumawi := [''].
	{
		{
			(nombor ≥ 1000) benar: {
				rumawi tambah-di-hujung: ['Ⅿ'].
				nombor tolak: 1000.
			}, henti.
		
			(nombor ≥ 500) benar: {
				rumawi tambah-di-hujung: ['Ⅾ'].
				nombor tolak: 500.
			}, henti.
		
			(nombor ≥ 100) benar: {
				rumawi tambah-di-hujung: ['Ⅽ'].
				nombor tolak: 100.
			}, henti.
		
			(nombor ≥ 50) benar: {
				rumawi tambah-di-hujung: ['Ⅼ'].
				nombor tolak: 50.
			}, henti.
		
			(nombor ≥ 50) benar: {
				rumawi tambah-di-hujung: ['Ⅼ'].
				nombor tolak: 50.
			}, henti.
		
			(nombor ≥ 10) benar: {
				rumawi tambah-di-hujung: ['Ⅹ'].
				nombor tolak: 10.
			}, henti.
			
			(nombor ≥ 9) benar: {
				rumawi tambah-di-hujung: ['Ⅸ'].
				nombor tolak: 9.
			}, henti.
			
			(nombor ≥ 5) benar: {
				rumawi tambah-di-hujung: ['Ⅴ'].
				nombor tolak: 5.
			}, henti.
			
			(nombor ≥ 4) benar: {
				rumawi tambah-di-hujung: ['Ⅳ'].
				nombor tolak: 4.
			}, henti.
			
			(nombor ≥ 1) benar: {
				rumawi tambah-di-hujung: ['Ⅰ'].
				nombor tolak: 1.
			}, henti.
		} prosedur.
	} selagi: { <- nombor > 0. }. <- rumawi.
}.

Keluaran tulis: 1 rumawi, baris-baharu.
Keluaran tulis: 2 rumawi, baris-baharu.
Keluaran tulis: 4 rumawi, baris-baharu.
Keluaran tulis: 8 rumawi, baris-baharu.
Keluaran tulis: 16 rumawi, baris-baharu.
Keluaran tulis: 32 rumawi, baris-baharu.
Keluaran tulis: 64 rumawi, baris-baharu.
Keluaran tulis: 128 rumawi, baris-baharu.
Keluaran tulis: 256 rumawi, baris-baharu.
Keluaran tulis: 1024 rumawi, baris-baharu.
