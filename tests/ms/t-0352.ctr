Nombor apabila: ['roman'] lakukan: {
	>> nombor := diri salin.
	>> roman := [''].
	{
		{
			(nombor ≥ 1000) benar: {
				roman tambah-di-hujung: ['Ⅿ'].
				nombor tolak: 1000.
			}, henti.
		
			(nombor ≥ 500) benar: {
				roman tambah-di-hujung: ['Ⅾ'].
				nombor tolak: 500.
			}, henti.
		
			(nombor ≥ 100) benar: {
				roman tambah-di-hujung: ['Ⅽ'].
				nombor tolak: 100.
			}, henti.
		
			(nombor ≥ 50) benar: {
				roman tambah-di-hujung: ['Ⅼ'].
				nombor tolak: 50.
			}, henti.
		
			(nombor ≥ 50) benar: {
				roman tambah-di-hujung: ['Ⅼ'].
				nombor tolak: 50.
			}, henti.
		
			(nombor ≥ 10) benar: {
				roman tambah-di-hujung: ['Ⅹ'].
				nombor tolak: 10.
			}, henti.
			
			(nombor ≥ 9) benar: {
				roman tambah-di-hujung: ['Ⅸ'].
				nombor tolak: 9.
			}, henti.
			
			(nombor ≥ 5) benar: {
				roman tambah-di-hujung: ['Ⅴ'].
				nombor tolak: 5.
			}, henti.
			
			(nombor ≥ 4) benar: {
				roman tambah-di-hujung: ['Ⅳ'].
				nombor tolak: 4.
			}, henti.
			
			(nombor ≥ 1) benar: {
				roman tambah-di-hujung: ['Ⅰ'].
				nombor tolak: 1.
			}, henti.
		} prosedur.
	} selagi: { <- nombor > 0. }. <- roman.
}.

Keluaran tulis: 1 roman, baris-baharu.
Keluaran tulis: 2 roman, baris-baharu.
Keluaran tulis: 4 roman, baris-baharu.
Keluaran tulis: 8 roman, baris-baharu.
Keluaran tulis: 16 roman, baris-baharu.
Keluaran tulis: 32 roman, baris-baharu.
Keluaran tulis: 64 roman, baris-baharu.
Keluaran tulis: 128 roman, baris-baharu.
Keluaran tulis: 256 roman, baris-baharu.
Keluaran tulis: 1024 roman, baris-baharu.
