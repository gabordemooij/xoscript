# pemisah baris dalam nilai tidak boleh mencipta pengepala tambahan
Server mulakan-awal.
Atur-cara guna: ['../../../src/xo/ms/webtools.xo'].
Atur-cara guna: ['../../../src/xo/ms/mailtools.xo'].

>> pengepala := Pengepala-HTTP baharu kunci-pengepala: ['Location'] nilai: ['/ok\r\nX-Injected: yes'].
Keluaran tulis: pengepala.

>> web := Dokumen-Web baharu.
web pergi-ke: ['/ok\r\nX-Injected: yes'].
Keluaran tulis: ['\n'], baris-baharu.

>> mel := E-mel baharu.
mel kepada: (Senarai baharu ; ['a@example.invalid\r\nX-To: yes']).
mel cc: (Senarai baharu ; ['b@example.invalid\r\nX-Cc: yes']).
mel bcc: (Senarai baharu ; ['c@example.invalid\r\nX-Bcc: yes']).
mel pengirim: ['d@example.invalid\r\nX-From: yes'] nama: ['site\r\nX-Name: yes'].
mel subjek: ['hello\r\nX-Subject: yes'].
mel badan: ['line1\r\nline2'].
Keluaran tulis: mel jana.

>> html := E-mel-HTML baharu.
html kepada: (Senarai baharu ; ['a@example.invalid\r\nX-To: yes']).
html pengirim: ['d@example.invalid'] nama: ['laman'].
html subjek: ['hello\r\nX-Subject: yes'].
html badan: ['body'].
Keluaran tulis: ( html jana mengandungi: ['\nX-'] ), baris-baharu.
Keluaran tulis: ( html jana mengandungi: ['X-To: yes'] ), baris-baharu.
