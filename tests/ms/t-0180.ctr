Teks apabila: ['html'] lakukan: { <- (
		diri
		ganti: ['&'] dengan: ['&amp;'],
		ganti: ['<'] dengan: ['&lt;'],
		ganti: ['>'] dengan: ['&gt;'],
		ganti: ['''] dengan: ['&apos;'],
		ganti: ['"'] dengan: ['&quot;']
	).
}.

>> ingatanDigunakan1 := 0.
>> ingatanDigunakan2 := 0.
>> ingatanDigunakan3 := 0.
>> ingatanDigunakan4 := 0.

Atur-cara pengurusan-ingatan: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Keluaran tulis: txt salin html, baris-baharu.
Keluaran tulis: txt salin huruf-kecil, baris-baharu.
Keluaran tulis: txt salin huruf-besar, baris-baharu.
} mula.

Atur-cara kemaskan.

ingatanDigunakan1 := (Atur-cara ingatan ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Keluaran tulis: txt salin html, baris-baharu.
Keluaran tulis: txt salin huruf-kecil, baris-baharu.
Keluaran tulis: txt salin huruf-besar, baris-baharu.
} mula.

Atur-cara kemaskan.
ingatanDigunakan2 := (Atur-cara ingatan ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Keluaran tulis: txt salin html, baris-baharu.
Keluaran tulis: txt salin huruf-kecil, baris-baharu.
Keluaran tulis: txt salin huruf-besar, baris-baharu.
} mula.

Atur-cara kemaskan.
ingatanDigunakan3 := (Atur-cara ingatan ? 0).



( ingatanDigunakan1 = ingatanDigunakan2 dan: ingatanDigunakan1 = ingatanDigunakan3, dan: ingatanDigunakan2 = ingatanDigunakan3 ) benar: {
	Keluaran tulis: ['Tiada kebocoran ingatan di sini'].
}, palsu: {
	Keluaran tulis: ['Ingatan bocor...'].
}.
