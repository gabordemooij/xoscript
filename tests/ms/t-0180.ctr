Teks apabila: ['html'] lakukan: { <- (
		diri
		ganti: ['&'] dengan: ['&amp;'],
		ganti: ['<'] dengan: ['&lt;'],
		ganti: ['>'] dengan: ['&gt;'],
		ganti: ['''] dengan: ['&apos;'],
		ganti: ['"'] dengan: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Atur-cara pengurusan-ingatan: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Keluaran tulis: txt salin html, baris-baharu.
Keluaran tulis: txt salin huruf-kecil, baris-baharu.
Keluaran tulis: txt salin huruf-besar, baris-baharu.
} mula.

Atur-cara kemaskan.

usedMemory1 := (Atur-cara ingatan ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Keluaran tulis: txt salin html, baris-baharu.
Keluaran tulis: txt salin huruf-kecil, baris-baharu.
Keluaran tulis: txt salin huruf-besar, baris-baharu.
} mula.

Atur-cara kemaskan.
usedMemory2 := (Atur-cara ingatan ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Keluaran tulis: txt salin html, baris-baharu.
Keluaran tulis: txt salin huruf-kecil, baris-baharu.
Keluaran tulis: txt salin huruf-besar, baris-baharu.
} mula.

Atur-cara kemaskan.
usedMemory3 := (Atur-cara ingatan ? 0).



( usedMemory1 = usedMemory2 dan: usedMemory1 = usedMemory3, dan: usedMemory2 = usedMemory3 ) benar: {
	Keluaran tulis: ['No memory leaks here'].
}, palsu: {
	Keluaran tulis: ['Leaking memory...'].
}.
