Server init.
>> fmt := Format baharu: ['%#3x'].

>> blob := Blob baharu: 4.
blob bytes: ( 
	Senarai baharu ; 0 ; 1 ; 2 ; 3
).

>> file := Fail baharu: ['/tmp/blob'].
file blob: blob.
blob bebaskan.

>> baca := file blob.
baca 
dari: 0 
panjang: 4, 
lakukan setiap: { :i :b 
	Keluaran
	tulis: (fmt gunakan-pada-integer: b),
	baris-baharu.
}.
baca bebaskan.
