Keluaran tulis: ['Teruskan gelung for, Tidak - sebelum 6 dan ke atas.'], baris-baharu.
{ :i
	Keluaran tulis: (i + 1), baris-baharu.
	((i + 1) > 4) teruskan.
	Keluaran tulis: ['-'].
} × 10.

>> x := 0.
>> xKurangDaripada10 := { <- ( x < 10 ). }.
Keluaran baris-baharu.
Keluaran tulis: ['Teruskan while-true, Tidak --> sebelum 5 dan ke atas.'], baris-baharu.
{
	Keluaran tulis: ['iteration #'] + x, baris-baharu.
	x tambah: 1.
	((x < 5) bukan) teruskan.
	Keluaran tulis: ['-->'].
} selagi: xKurangDaripada10.
Keluaran baris-baharu.
Keluaran tulis: ['Teruskan while-false, Tidak - sebelum 3 sahaja.'], baris-baharu.
{
	Keluaran tulis: ['iteration #'] + x, baris-baharu.
	x tolak: 1.
	(x = 3) teruskan.
	Keluaran tulis: ['-'].
} selagi: { <- ( x > 0). }.

Keluaran baris-baharu.
Keluaran tulis: ['Teruskan gelung times, Tidak ||| sebelum 3.'], baris-baharu.
{ :i
	Keluaran tulis: ['iteration #'] + i, baris-baharu.
	(i = 2) teruskan.
	Keluaran tulis: ['|||'].
} × 5.

Keluaran baris-baharu.

{ Benar teruskan. Keluaran tulis: ['jangan tulis ini!'], baris-baharu. } mula.

{ Benar teruskan. Keluaran tulis: ['jangan tulis ini!'], baris-baharu. } tangkap: { Keluaran tulis: ['Jangan tangkap ini!']. }, mula.

Keluaran tulis: ['Uji gelung each Tatasusunan: 0, ... ,2'], baris-baharu.
(Senarai ← 1 ; 2 ; 3) petakan: { :i
	(i = 1) teruskan.
	Keluaran tulis: ['iteration #'] + (i - 0), baris-baharu.
}.

Keluaran tulis: ['Uji gelung each Peta: c sahaja'], baris-baharu.
>> m := Kamus baharu.
m letak: ['first'] di: ['a'], letak: ['second'] di: ['b'], letak: ['ketiga'] di: ['c'].
m setiap: { :k :v
	(k ≠ ['c']) teruskan.
	Keluaran tulis: ['iteration'] + k + v, baris-baharu.
}.

