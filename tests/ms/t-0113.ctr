Keluaran tulis: ['Continue for-loop, No - before 6 and up.'], baris-baharu.
{ :i
	Keluaran tulis: (i + 1), baris-baharu.
	((i + 1) > 4) teruskan.
	Keluaran tulis: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Keluaran baris-baharu.
Keluaran tulis: ['Continue while-true, No --> before 5 and up.'], baris-baharu.
{
	Keluaran tulis: ['iteration #'] + x, baris-baharu.
	x tambah: 1.
	((x < 5) bukan) teruskan.
	Keluaran tulis: ['-->'].
} selagi: xIsLessThan10.
Keluaran baris-baharu.
Keluaran tulis: ['Continue while-false, No - before 3 only.'], baris-baharu.
{
	Keluaran tulis: ['iteration #'] + x, baris-baharu.
	x tolak: 1.
	(x = 3) teruskan.
	Keluaran tulis: ['-'].
} selagi: { <- ( x > 0). }.

Keluaran baris-baharu.
Keluaran tulis: ['Continue times-loop, No ||| before 3.'], baris-baharu.
{ :i
	Keluaran tulis: ['iteration #'] + i, baris-baharu.
	(i = 2) teruskan.
	Keluaran tulis: ['|||'].
} × 5.

Keluaran baris-baharu.

{ Benar teruskan. Keluaran tulis: ['dont write this!'], baris-baharu. } mula.

{ Benar teruskan. Keluaran tulis: ['dont write this!'], baris-baharu. } tangkap: { Keluaran tulis: ['Dont catch this!']. }, mula.

Keluaran tulis: ['Test Array each-loop: 0, ... ,2'], baris-baharu.
(Senarai ← 1 ; 2 ; 3) petakan: { :i
	(i = 1) teruskan.
	Keluaran tulis: ['iteration #'] + (i - 0), baris-baharu.
}.

Keluaran tulis: ['Test Map each-loop: c only'], baris-baharu.
>> m := Kamus baharu.
m letak: ['first'] di: ['a'], letak: ['second'] di: ['b'], letak: ['third'] di: ['c'].
m setiap: { :k :v
	(k ≠ ['c']) teruskan.
	Keluaran tulis: ['iteration'] + k + v, baris-baharu.
}.

