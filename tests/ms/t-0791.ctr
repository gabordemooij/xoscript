Server init.

>> DB := Maria-DB baharu hos: ['localhost'],
	nama-pengguna: ['xo'],
	kata-laluan: ['pass123'],
	nama-pangkalan-data: ['xobase'],
	sambung.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> parameter-carian := Maria-Pertanyaan baharu: SQL.

# set database
parameter-carian pangkalan-data: DB.

parameter-carian dapatkan: { :row
	Keluaran tulis: row world, baris-baharu.
}.
