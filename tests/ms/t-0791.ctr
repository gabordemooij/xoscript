Server init.

>> PD := Maria-DB baharu hos: ['localhost'],
	nama-pengguna: ['xo'],
	kata-laluan: ['pass123'],
	nama-pangkalan-data: ['xobase'],
	sambung.
	
>> SQL := ['SELECT "hello" AS "world" '].

# cipta pertanyaan secara manual
>> parameter-carian := Maria-Pertanyaan baharu: SQL.

# tetapkan pangkalan data
parameter-carian pangkalan-data: PD.

parameter-carian dapatkan: { :barisan
	Keluaran tulis: barisan world, baris-baharu.
}.
