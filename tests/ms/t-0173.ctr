

Senarai apabila: ['jumlahkan'] lakukan: {
	>> jumlah := 0.
	diri setiap: { :indeks :unsur
		jumlah tambah: unsur.
	}. <- jumlah.
}.

Senarai apabila: ['hasil-darab'] lakukan: {
	>> jumlah := 1.
	diri setiap: { :indeks :unsur
		jumlah darab-dengan: unsur.
	}. <- jumlah.
}.

>> ingatanDigunakan1 := 0.
>> ingatanDigunakan2 := 0.
>> ingatanDigunakan3 := 0.
>> ingatanDigunakan4 := 0.

Atur-cara pengurusan-ingatan: 0.

{

>> a := Senarai ← ['hello'] ; ['world'] ; Benar ; Tiada ; 666.
a := a + ( Senarai ← 1 ).
Keluaran tulis: ( ['jumlah: '] + ( a jumlahkan ) ), baris-baharu.
Keluaran tulis: ( ['min: '] + ( a minimum ) ), baris-baharu.
Keluaran tulis: ( ['maks: '] + ( a maksimum ) ), baris-baharu.
Keluaran tulis: ( ['ke-3: '] + ( a ? 2 ) ), baris-baharu.
Keluaran tulis: ( ['hsd: '] + ( a hasil-darab ) ), baris-baharu.
a isih: { :a :b <- (b - a). }.
a setiap: { :i :e Keluaran tulis: ( i - 0 ), baris-baharu. }.

} mula.

Atur-cara kemaskan.
ingatanDigunakan1 := (Atur-cara ingatan ? 0).


{

>> a := Senarai ← ['hello'] ; ['world'] ; Benar ; Tiada ; 666.
a := a + ( Senarai ← 1 ).
Keluaran tulis: ( ['jumlah: '] + ( a jumlahkan ) ), baris-baharu.
