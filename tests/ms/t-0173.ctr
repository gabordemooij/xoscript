

Senarai apabila: ['sum'] lakukan: {
	>> total := 0.
	diri setiap: { :index :element
		total tambah: element.
	}. <- total.
}.

Senarai apabila: ['product'] lakukan: {
	>> total := 1.
	diri setiap: { :index :element
		total darab-dengan: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Atur-cara pengurusan-ingatan: 0.

{

>> a := Senarai ← ['hello'] ; ['world'] ; Benar ; Tiada ; 666.
a := a + ( Senarai ← 1 ).
Keluaran tulis: ( ['sum: '] + ( a sum ) ), baris-baharu.
Keluaran tulis: ( ['min: '] + ( a minimum ) ), baris-baharu.
Keluaran tulis: ( ['max: '] + ( a maksimum ) ), baris-baharu.
Keluaran tulis: ( ['3rd: '] + ( a ? 2 ) ), baris-baharu.
Keluaran tulis: ( ['prd: '] + ( a product ) ), baris-baharu.
a isih: { :a :b <- (b - a). }.
a setiap: { :i :e Keluaran tulis: ( i - 0 ), baris-baharu. }.

} mula.

Atur-cara kemaskan.
usedMemory1 := (Atur-cara ingatan ? 0).


{

>> a := Senarai ← ['hello'] ; ['world'] ; Benar ; Tiada ; 666.
a := a + ( Senarai ← 1 ).
Keluaran tulis: ( ['sum: '] + ( a sum ) ), baris-baharu.
Keluaran tulis: ( ['min: '] + ( a minimum ) ), baris-baharu.
Keluaran tulis: ( ['max: '] + ( a maksimum ) ), baris-baharu.
Keluaran tulis: ( ['3rd: '] + ( a ? 2 ) ), baris-baharu.
Keluaran tulis: ( ['prd: '] + ( a product ) ), baris-baharu.
a isih: { :a :b <- (b - a). }.
a setiap: { :i :e Keluaran tulis: ( i - 0 ), baris-baharu. }.

} mula.



Atur-cara kemaskan.
usedMemory2 := (Atur-cara ingatan ? 0).


{

>> a := Senarai ← ['hello'] ; ['world'] ; Benar ; Tiada ; 666.
a := a + ( Senarai ← 1 ).
Keluaran tulis: ( ['sum: '] + ( a sum ) ), baris-baharu.
Keluaran tulis: ( ['min: '] + ( a minimum ) ), baris-baharu.
Keluaran tulis: ( ['max: '] + ( a maksimum ) ), baris-baharu.
Keluaran tulis: ( ['3rd: '] + ( a ? 2 ) ), baris-baharu.
Keluaran tulis: ( ['prd: '] + ( a product ) ), baris-baharu.
a isih: { :a :b <- (b - a). }.
a setiap: { :i :e Keluaran tulis: ( i - 0 ), baris-baharu. }.

} mula.



Atur-cara kemaskan.
usedMemory3 := (Atur-cara ingatan ? 0).

( usedMemory1 = usedMemory2 dan: usedMemory1 = usedMemory3, dan: usedMemory2 = usedMemory3 ) benar: {
	Keluaran tulis: ['No memory leaks here'].
}, palsu: {
	Keluaran tulis: ['Leaking memory...'].
}.
