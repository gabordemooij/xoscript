
Keluaran tulis: ['Henti gelung for, 0-4.'], baris-baharu.
{ :i
	Keluaran tulis: ['iteration #'] + i, baris-baharu.
	(i = 4) henti.
} × 10.

>> x := 0.
>> xKurangDaripada10 := { <- ( x < 10 ). }.

Keluaran tulis: ['Henti gelung while-true, 0-4.'], baris-baharu.
{
	Keluaran tulis: ['iteration #'] + x, baris-baharu.
	x tambah: 1.
	((x < 5) bukan) henti.
} selagi: xKurangDaripada10.

Keluaran tulis: ['Henti gelung while-false, 5,4.'], baris-baharu.
{
	Keluaran tulis: ['iteration #'] + x, baris-baharu.
	x tolak: 1.
	(x = 3) henti.
} selagi: { <- (x > 0). }.

Keluaran tulis: ['Henti gelung times, 1-4.'], baris-baharu.
{ :i
	Keluaran tulis: ['iteration #'] + i, baris-baharu.
	(i = 4) henti.
} × 5.

Keluaran tulis: ['Henti blok, jangan cetak baris.'], baris-baharu.
{ Benar henti. Keluaran tulis: ['jangan tulis ini!'], baris-baharu. } mula.

Keluaran tulis: ['Henti blok, jangan cetuskan tangkapan...'], baris-baharu.
{ Benar henti. Keluaran tulis: ['jangan tulis ini!'], baris-baharu. } tangkap: { Keluaran tulis: ['Jangan tangkap ini!']. }, mula.

Keluaran tulis: ['Uji gelung each Tatasusunan: 0,1'], baris-baharu.
(Senarai ← 1 ; 2 ; 3) petakan: { :i
	Keluaran tulis: ['iteration #'] + i, baris-baharu.
	(i = 1) henti.
}.

Keluaran tulis: ['Uji gelung each Peta: c sahaja'], baris-baharu.
>> m := Kamus baharu.
m letak: ['first'] di: ['a'], letak: ['second'] di: ['b'], letak: ['ketiga'] di: ['c'].
m setiap: { :k :v
	Keluaran tulis: ['iteration'] + v + k, baris-baharu.
	Benar henti.
}.

