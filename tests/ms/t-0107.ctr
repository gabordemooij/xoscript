
Keluaran tulis: ['Break for-loop, 0-4.'], baris-baharu.
{ :i
	Keluaran tulis: ['iteration #'] + i, baris-baharu.
	(i = 4) henti.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Keluaran tulis: ['Break while-true loop, 0-4.'], baris-baharu.
{
	Keluaran tulis: ['iteration #'] + x, baris-baharu.
	x tambah: 1.
	((x < 5) bukan) henti.
} selagi: xIsLessThan10.

Keluaran tulis: ['Break while-false loop, 5,4.'], baris-baharu.
{
	Keluaran tulis: ['iteration #'] + x, baris-baharu.
	x tolak: 1.
	(x = 3) henti.
} selagi: { <- (x > 0). }.

Keluaran tulis: ['Break times loop, 1-4.'], baris-baharu.
{ :i
	Keluaran tulis: ['iteration #'] + i, baris-baharu.
	(i = 4) henti.
} × 5.

Keluaran tulis: ['Break block, dont print line.'], baris-baharu.
{ Benar henti. Keluaran tulis: ['dont write this!'], baris-baharu. } mula.

Keluaran tulis: ['Break block, dont fire catch...'], baris-baharu.
{ Benar henti. Keluaran tulis: ['dont write this!'], baris-baharu. } tangkap: { Keluaran tulis: ['Dont catch this!']. }, mula.

Keluaran tulis: ['Test Array each-loop: 0,1'], baris-baharu.
(Senarai ← 1 ; 2 ; 3) petakan: { :i
	Keluaran tulis: ['iteration #'] + i, baris-baharu.
	(i = 1) henti.
}.

Keluaran tulis: ['Test Map each-loop: c only'], baris-baharu.
>> m := Kamus baharu.
m letak: ['first'] di: ['a'], letak: ['second'] di: ['b'], letak: ['third'] di: ['c'].
m setiap: { :k :v
	Keluaran tulis: ['iteration'] + v + k, baris-baharu.
	Benar henti.
}.

