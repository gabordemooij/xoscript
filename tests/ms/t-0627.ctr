

# cipta integer 64-bit untuk pengiraan yang tepat
>> a := Int64 daripada-teks: ['123'].

# ke teks
Keluaran tulis: a, baris-baharu.

# bahagi
Keluaran tulis: a / (Int64 daripada-teks: ['3']), baris-baharu.

# darab
Keluaran tulis: a * (Int64 daripada-teks: ['2']), baris-baharu.

# tambah
Keluaran tulis: a + (Int64 daripada-teks: ['1']), baris-baharu.

# tolak
Keluaran tulis: a - (Int64 daripada-teks: ['2']), baris-baharu.

# bandingkan
Keluaran tulis: ( a =   (Int64 daripada-teks: ['123'])), baris-baharu.
Keluaran tulis: ( a !=: (Int64 daripada-teks: ['124'])), baris-baharu.
Keluaran tulis: ( a <   (Int64 daripada-teks: ['124'])), baris-baharu.
Keluaran tulis: ( a >   (Int64 daripada-teks: ['122'])), baris-baharu.
Keluaran tulis: ( a >=: (Int64 daripada-teks: ['123'])), baris-baharu.
Keluaran tulis: ( a <=: (Int64 daripada-teks: ['123'])), baris-baharu.





	