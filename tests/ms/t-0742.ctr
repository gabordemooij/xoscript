Keluaran tulis: ['Objek ujian'], baris-baharu.
>> a := Objek baharu. 

a apabila: ['item:'] lakukan: { :pembantuheks
	milik pembantuheks := pembantuheks. 
}.

a apabila: ['barang'] lakukan: {
	<- milik pembantuheks.
}.

a item: Hx baharu.

>> alamat-lama-pembantuheks := a barang prototaip alamat-ingatan.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== MEMUAT SEMULA SNAP:'], baris-baharu.

>> b := Objek load-from: ['/tmp/a.bin'].

(b barang prototaip alamat-ingatan = alamat-lama-pembantuheks) benar: {
	Keluaran tulis: ['Pautan objek dipasang semula.'], baris-baharu.
}.
