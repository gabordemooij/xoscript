Keluaran tulis: ['Test object'], baris-baharu.
>> a := Objek baharu. 

a apabila: ['item:'] lakukan: { :hexhelper
	milik hexhelper := hexhelper. 
}.

a apabila: ['item'] lakukan: { <- milik hexhelper.
}.

a item: Hx baharu.

>> old-hexhelper-address := a item prototaip alamat-ingatan.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baharu.

>> b := Objek load-from: ['/tmp/a.bin'].

(b item prototaip alamat-ingatan = old-hexhelper-address) benar: {
	Keluaran tulis: ['Object link re-attached.'], baris-baharu.
}.
