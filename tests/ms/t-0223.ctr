>> x := Detik baharu.
x zon: ['CEST'],
tahun:2017,
bulan:01,
hari:10,
jam: 10,
minit: 0,
saat: 0.

Keluaran tulis: x, baris-baharu.

Keluaran tulis: x masa, baris-baharu.

x tambah: 1 saat.
x tambah: 2 minit.
x tambah: 3 jam.
x tambah: 4 hari.
x tambah: 1 bulan.
x tambah: 6 tahun.

Keluaran tulis: x, baris-baharu.

x tolak: 1 saat.
x tolak: 2 minit.
x tolak: 3 jam.
x tolak: 4 hari.
x tolak: 1 bulan.
x tolak: 6 tahun.

Keluaran tulis: x, baris-baharu.

>> y := x salin.
>> z := x.

Keluaran tulis: y, baris-baharu.
Keluaran tulis: z, baris-baharu.
Keluaran tulis: (x zon = y zon), baris-baharu.
Keluaran tulis: (x masa = y masa), baris-baharu.
Keluaran tulis: (x = z), baris-baharu.
Keluaran tulis: x hari-dalam-tahun, baris-baharu.
Keluaran tulis: x hari-dalam-minggu, baris-baharu.
Keluaran tulis: x minggu, baris-baharu.
