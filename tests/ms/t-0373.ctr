# ujian pematuhan

# guna nombor antarabangsa

Keluaran tulis: ['1000 -> '].
Keluaran tulis: 1000, baris-baharu. #1000

Keluaran tulis: ['1.5 -> '].
Keluaran tulis: 1.5, baris-baharu.  #1.5

Keluaran tulis: ['1001.5 -> '].
Keluaran tulis: 1.5 + 1000, baris-baharu. #1001.5

# guna tatasusunan berindeks-0
>> x := Senarai baharu ; 1 ; 2 ; 3.
>> y := Senarai baharu ; ['a'] ; ['b'] ; ['c'].

Keluaran tulis: ['1 -> '].
Keluaran tulis: x ? 0, baris-baharu. #1

Keluaran tulis: ['1 -> '].
Keluaran tulis: (x di: 0), baris-baharu. #1

Keluaran tulis: ['1 -> '].
Keluaran tulis: x pertama, baris-baharu. #1

Keluaran tulis: ['3 -> '].
Keluaran tulis: x terakhir, baris-baharu. #3

Keluaran tulis: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Keluaran tulis: (x mengikut: y), baris-baharu.

Keluaran tulis: ['1 -> '].
Keluaran tulis: (x dari: 0 panjang: 1) pertama, baris-baharu. #1

Keluaran tulis: ['0 -> '].
Keluaran tulis: (x cari: 1), baris-baharu. #0

x letak: 9 di: 0.

Keluaran tulis: ['9 -> '].
Keluaran tulis: (x di: 0), baris-baharu. #9

x tambah-di-depan: 8.
Keluaran tulis: ['8 -> '].
Keluaran tulis: (x di: 0), baris-baharu. #9


x tambah-di-hujung: 10.
Keluaran tulis: ['10 -> '].
Keluaran tulis: (x di: 4), baris-baharu. #10








