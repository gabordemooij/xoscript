Server init.

>> DB := Maria-DB baharu hos: ['localhost'],
	nama-pengguna: ['xo'],
	kata-laluan: ['pass123'],
	nama-pangkalan-data: ['xobase'],
	sambung.

{
	DB pertanyaan:
	['DROP TABLE movies'],
	laksana.
} tangkap: { Tiada. }, mula.

DB pertanyaan:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
laksana.

DB pertanyaan: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parameter: ( Senarai baharu ; ['Halloween'] ),
laksana.

DB pertanyaan: ['SELECT * FROM movies'],
dapatkan: { :movie
	Keluaran tulis: movie title, baris-baharu.
}.

