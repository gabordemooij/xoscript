Server init.

>> PD := Maria-DB baharu hos: ['localhost'],
	nama-pengguna: ['xo'],
	kata-laluan: ['pass123'],
	nama-pangkalan-data: ['xobase'],
	sambung.

{
	PD pertanyaan:
	['DROP TABLE movies'],
	laksana.
} tangkap: { Tiada. }, mula.

PD pertanyaan:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
laksana.

PD pertanyaan: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parameter: ( Senarai baharu ; ['Halloween'] ),
laksana.

PD pertanyaan: ['SELECT * FROM movies'],
dapatkan: { :filem
	Keluaran tulis: filem title, baris-baharu.
}.

