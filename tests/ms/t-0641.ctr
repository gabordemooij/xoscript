# Uji pembersih utf8
Server init.

>> kes-utf8 := Kamus baharu
	# ASCII sahaja
	letak: ( Senarai baharu ; 65 ; 65 ; 65 ; 65 ; 0 ) di: ['AAAA'],
	# jujukan 2 bait yang sah
	letak: ( Senarai baharu ; 194 ; 162 ; 0 ) di: ['¢'],
	# UTF-8 3-bait yang sah
    letak: ( Senarai baharu ; 226 ; 130 ; 172 ; 0 ) di: ['€'],
	# UTF-8 4-bait yang sah
    letak: ( Senarai baharu ; 240 ; 144 ; 141 ; 136 ; 0 ) di: ['𐍈'],
	# Bait sambungan tidak sah dalam jujukan E2 28 AC -> mula jujukan 3b + 28 sambungan salah + bait sambungan AC, tetapi tergolong dalam ralat yang sama
    letak: ( Senarai baharu ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) di: ['A?A'],
	# Pengekodan terlalu panjang bagi ASCII 'A' (sepatutnya menjadi ?),
    letak: ( Senarai baharu ; 65 ; 193 ; 129 ; 0 ) di: ['A?'],
	# Bait pertama tidak sah (0xFF)
    letak: ( Senarai baharu ; 255 ; 0 ) di: ['?'],
	# Jujukan berbilang bait tidak lengkap di hujung
    letak: ( Senarai baharu ; 66 ; 226 ; 0 ) di: ['B?'],
    # Teks kosong
    #put: ( List new ) at: [''],
	# Berbilang jujukan bercampur
    letak: ( Senarai baharu ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) di: ['A€?𐍈B'].
	 
kes-utf8 setiap: { :key :value
	>> blob := Blob baharu: value bilangan, bytes: value.
	>> str := blob teks.
	(str = key) benar: {
		Keluaran tulis: ['OK'], baris-baharu.
	}, jika-tidak: {
		Keluaran tulis: ['Pembersih UTF8 gagal pada: '] + key + [' dapat: '] + str, baris-baharu.
	}.
	blob bebaskan.
}.
