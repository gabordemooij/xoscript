
Teks apabila: ['nilaikan'] lakukan: {
	>> kod := Fail baharu: ['/tmp/eval.ctr'].
	kod tulis: (diri teks + ['.']).
	Atur-cara guna: ['/tmp/eval.ctr'].
}.

>> map :=
	(Kamus baharu)
	letak: ['Hai Semua'] di: ['two'],
	letak: (Senarai ← ['hello'] ; ['world'] ; (Senarai ← 1 ; 2; 9) ; Palsu) di: ['satu'],
	letak: ( (Kamus baharu) letak: ['dnia'] di: ['salah-eja'] ) di: ['three'],
	letak: (Senarai ← ((Kamus baharu) letak: ['harta karun'] di: ['tersembunyi']) ; 2) di: ['empat']. 
>> str := map teks.
>> map2 := Tiada.
(['map2 := '] + str ) nilaikan.
Keluaran tulis: map2 ? ['satu'] ? 0.
Keluaran tulis: map2 ? ['satu'] ? 1.
Keluaran tulis: map2 ? ['empat'] ? 0 ? ['tersembunyi'].
Keluaran tulis: map2 ? ['satu'] ? 2 ? 2.
