
Teks apabila: ['evaluate'] lakukan: {
	>> kod := Fail baharu: ['/tmp/eval.ctr'].
	kod tulis: (diri teks + ['.']).
	Atur-cara guna: ['/tmp/eval.ctr'].
}.

>> map :=
	(Kamus baharu)
	letak: ['Hi There'] di: ['two'],
	letak: (Senarai ← ['hello'] ; ['world'] ; (Senarai ← 1 ; 2; 9) ; Palsu) di: ['one'],
	letak: ( (Kamus baharu) letak: ['wrrld'] di: ['misspelled'] ) di: ['three'],
	letak: (Senarai ← ((Kamus baharu) letak: ['treasure'] di: ['hidden']) ; 2) di: ['four']. 
>> str := map teks.
>> map2 := Tiada.
(['map2 := '] + str ) evaluate.
Keluaran tulis: map2 ? ['one'] ? 0.
Keluaran tulis: map2 ? ['one'] ? 1.
Keluaran tulis: map2 ? ['four'] ? 0 ? ['hidden'].
Keluaran tulis: map2 ? ['one'] ? 2 ? 2.
