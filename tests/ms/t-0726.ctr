# test buffers PKI/Sign 
Server init.

>> long := ( Senarai baharu isi: 1000 dengan: ['a'] ) gabungkan: [''].

# sign a message
Keluaran tulis: ( 
	Peti-besi tandatangan: ['abc'] dengan: long
), baris-baharu.

Keluaran tulis: ( 
	Peti-besi
		semak: ['abc'] 
		tandatangan: long 
		dengan: long
), baris-baharu.

Keluaran tulis: (
	Peti-besi cincang-kata-laluan: long sahkan: long
), baris-baharu.
