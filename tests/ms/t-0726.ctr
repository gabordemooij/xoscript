# uji penimbal PKI/Tandatangan 
Server init.

>> panjang-sekali := ( Senarai baharu isi: 1000 dengan: ['a'] ) gabungkan: [''].

# tandatangani mesej
Keluaran tulis: ( 
	Peti-besi tandatangan: ['abc'] dengan: panjang-sekali
), baris-baharu.

Keluaran tulis: ( 
	Peti-besi
		semak: ['abc'] 
		tandatangan: panjang-sekali 
		dengan: panjang-sekali
), baris-baharu.

Keluaran tulis: (
	Peti-besi cincang-kata-laluan: panjang-sekali sahkan: panjang-sekali
), baris-baharu.
