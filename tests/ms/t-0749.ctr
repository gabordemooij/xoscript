Keluaran tulis: ['Objek ujian'], baris-baharu.
>> a := Objek baharu. 

a apabila: ['item:'] lakukan: { :boolean
	milik boolean := boolean. 
}.

a apabila: ['barang'] lakukan: {
	<- milik boolean.
}.

a item: Palsu.

Keluaran tulis: a barang, baris-baharu.

>> alamat-lama-bool := a barang prototaip alamat-ingatan.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== MEMUAT SEMULA SNAP:'], baris-baharu.

>> b := Objek load-from: ['/tmp/a.bin'].

(b barang prototaip alamat-ingatan = alamat-lama-bool) benar: {
	Keluaran tulis: ['Pautan objek dipasang semula.'], baris-baharu.
}.

Keluaran tulis: b barang, baris-baharu.
