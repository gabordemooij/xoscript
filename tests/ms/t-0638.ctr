
Server init.
>> rq := Permintaan-HTTP baharu.
Keluaran tulis: ['HTTP-GET d[]=']  + ( rq get-senarai: ['d[]'] ), baris-baharu. # GET
Keluaran tulis: ['HTTP-GET f[]=']  + ( rq get-senarai: ['f[]'] ), baris-baharu. # GET
Keluaran tulis: ['HTTP-POST e[]='] + ( rq post-senarai: ['e[]'] ), baris-baharu. # GET
Keluaran tulis: ['HTTP-POST c=']   + ( rq post: ['c'] ), baris-baharu. # GET
Keluaran tulis: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), baris-baharu. # GET
