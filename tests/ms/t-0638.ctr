
Server init.
>> pmt := Permintaan-HTTP baharu.
Keluaran tulis: ['HTTP-GET d[]=']  + ( pmt get-senarai: ['d[]'] ), baris-baharu. # GET
Keluaran tulis: ['HTTP-GET f[]=']  + ( pmt get-senarai: ['f[]'] ), baris-baharu. # GET
Keluaran tulis: ['HTTP-POST e[]='] + ( pmt post-senarai: ['e[]'] ), baris-baharu. # GET
Keluaran tulis: ['HTTP-POST c=']   + ( pmt post: ['c'] ), baris-baharu. # GET
Keluaran tulis: ['HTTP-POST xx=']  + ( pmt post: ['xx'] ), baris-baharu. # GET
