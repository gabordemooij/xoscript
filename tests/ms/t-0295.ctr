
>> dictionary := (
	Kamus baharu
		letak: ['b'] di: ['a'],
		letak: ['a'] di: ['b'],
		letak: ['z'] di: ['x'],
		letak: ['hello'] di: ['hallo'],
		letak: ['human'] di: ['human']
).

>> comparisons := Senarai baharu.
dictionary setiap: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a bandingkan: b)
	).
}.

comparisons isih: { :a :b <- ( a bandingkan: b ). }.
Keluaran tulis: ( comparisons gabungkan: ['↵'] ), baris-baharu.
comparisons gabungkan: ['↵'].
