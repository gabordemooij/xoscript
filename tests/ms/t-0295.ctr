
>> kamus-kata := (
	Kamus baharu
		letak: ['b'] di: ['a'],
		letak: ['a'] di: ['b'],
		letak: ['z'] di: ['x'],
		letak: ['hello'] di: ['hallo'],
		letak: ['manusia'] di: ['manusia']
).

>> perbandingan := Senarai baharu.
kamus-kata setiap: { :a :b
	perbandingan ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a bandingkan: b)
	).
}.

perbandingan isih: { :a :b <- ( a bandingkan: b ). }.
Keluaran tulis: ( perbandingan gabungkan: ['↵'] ), baris-baharu.
perbandingan gabungkan: ['↵'].
