>> Greeter := Objek baharu.
Greeter apabila: ['make'] lakukan: {
	>> gr := Objek baharu.
	gr apabila: ['setName:'] lakukan: { :aname
		milik nama := aname.
	}.
	gr apabila: ['greet'] lakukan: {
		Keluaran tulis: milik nama.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a baharu.
c setName: ['THREE'].
c greet.
>> d := a baharu.
d setName: ['FOUR'].
d greet.
c greet.
