>> Penyapa := Objek baharu.
Penyapa apabila: ['cipta'] lakukan: {
	>> pny := Objek baharu.
	pny apabila: ['setName:'] lakukan: { :suatuNama
		milik nama := suatuNama.
	}.
	pny apabila: ['sapa'] lakukan: {
		Keluaran tulis: milik nama.
	}. <- pny.
}.
>> a := Penyapa cipta.
>> b := Penyapa cipta.
a setName: ['SATU'].
b setName: ['DUA'].
a sapa.
b sapa.
>> c := a baharu.
c setName: ['TIGA'].
c sapa.
>> d := a baharu.
d setName: ['EMPAT'].
d sapa.
c sapa.
