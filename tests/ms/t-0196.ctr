
>> animal := Objek baharu. 
 
 animal apabila: ['name:'] lakukan: { :n
milik nama := n.
}. 


animal name: ['Diva']. 
 
animal apabila: ['nama'] lakukan: { <- nama.
}.

>> cat := animal baharu.
 
 cat name: ['Diva']. 
 
 cat apabila: ['nama'] lakukan: { <- ['your royal highness ']
+ (diri nama).
}.

Keluaran tulis: cat nama.
