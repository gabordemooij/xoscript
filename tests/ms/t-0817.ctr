# a value ending in the first part of an opening quote must survive serialization
>> nilai-nilai := Senarai baharu
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

nilai-nilai setiap: { :i :value
	>> d := Kamus baharu.
	d letak: value di: ['k'].
	d letak: ['second'] di: ['j'].
	>> r := d kod objek.
	Keluaran tulis: r bilangan, baris-baharu.
	Keluaran tulis: ( (r di: ['k']) = value ), baris-baharu.
}.
