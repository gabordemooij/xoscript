>> nombor-nombor := ['1,2,3'] pisahkan: [','].
Keluaran tulis: ['Saya dapat: '] + nombor-nombor bilangan + [' nombor.'],baris-baharu.
{ :i Keluaran tulis: ['number #'] + i + [':'] + (nombor-nombor kedudukan: i), baris-baharu.} × 3.
>> minuman := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
minuman := minuman pisahkan: [' Or '].
Keluaran tulis: ['Kami hidangkan'], baris-baharu.
{ :i Keluaran tulis: ['->'] + (minuman kedudukan: i), baris-baharu. } × (minuman bilangan).
Keluaran tulis: (minuman gabungkan: [',']), baris-baharu.
Keluaran tulis: (nombor-nombor gabungkan: ['||']).
