>> numbers := ['1,2,3'] pisahkan: [','].
Keluaran tulis: ['I got: '] + numbers bilangan + [' numbers.'],baris-baharu.
{ :i Keluaran tulis: ['number #'] + i + [':'] + (numbers kedudukan: i), baris-baharu.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages pisahkan: [' Or '].
Keluaran tulis: ['We serve'], baris-baharu.
{ :i Keluaran tulis: ['->'] + (beverages kedudukan: i), baris-baharu. } × (beverages bilangan).
Keluaran tulis: (beverages gabungkan: [',']), baris-baharu.
Keluaran tulis: (numbers gabungkan: ['||']).
