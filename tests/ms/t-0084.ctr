>> makeAdder := { :x
	>> f := { :y <- (milik x + y). } tetapkan: ['x'] nilai: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i milik q letak: (milik f gunakan-pada: (milik q ? i)) di: i. } 
	tetapkan: ['q'] nilai: array,
	tetapkan: ['f'] nilai: func.
	{ :i mapping gunakan-pada: i. } × (array bilangan).
}.

>> a := Senarai ← 1; 2; 3.
mapper gunakan-pada: a dan: (makeAdder gunakan-pada: 100).
Keluaran tulis: (a kedudukan: 0), baris-baharu.
Keluaran tulis: (a ? 1), baris-baharu.
Keluaran tulis: (a ? 2), baris-baharu.
