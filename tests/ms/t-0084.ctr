>> ciptaPenambah := { :x
	>> f := { :y <- (milik x + y). } tetapkan: ['x'] nilai: x. <- f.
}.
>> pemeta := { :tatasusunan :fn
	>> fungsiPeta := { :i milik q letak: (milik f gunakan-pada: (milik q ? i)) di: i. } 
	tetapkan: ['q'] nilai: tatasusunan,
	tetapkan: ['f'] nilai: fn.
	{ :i fungsiPeta gunakan-pada: i. } × (tatasusunan bilangan).
}.

>> a := Senarai ← 1; 2; 3.
pemeta gunakan-pada: a dan: (ciptaPenambah gunakan-pada: 100).
Keluaran tulis: (a kedudukan: 0), baris-baharu.
Keluaran tulis: (a ? 1), baris-baharu.
Keluaran tulis: (a ? 2), baris-baharu.
