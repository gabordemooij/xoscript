Nombor apabila: ['factorial'] lakukan: {
	>> total := 1.
	{ :index total darab-dengan: (diri - index). } × diri. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Atur-cara pengurusan-ingatan: 0.

{
2 exponent factorial.
Keluaran tulis: (11 baki-bahagi: 3), baris-baharu.
Keluaran tulis: (3.4 bundarkan), baris-baharu.
Keluaran tulis: (7.1 bundar-ke-atas), baris-baharu.
Keluaran tulis: (7.9 bundar-ke-bawah), baris-baharu.
}
mula.

Atur-cara kemaskan.

usedMemory1 := (Atur-cara ingatan ? 0).

{
2 exponent factorial.
Keluaran tulis: (11 baki-bahagi: 3), baris-baharu.
Keluaran tulis: (3.4 bundarkan), baris-baharu.
Keluaran tulis: (7.1 bundar-ke-atas), baris-baharu.
Keluaran tulis: (7.9 bundar-ke-bawah), baris-baharu.
}
mula.

Atur-cara kemaskan.
usedMemory2 := (Atur-cara ingatan ? 0).


{
2 exponent factorial.
Keluaran tulis: (11 baki-bahagi: 3), baris-baharu.
Keluaran tulis: (3.4 bundarkan), baris-baharu.
Keluaran tulis: (7.1 bundar-ke-atas), baris-baharu.
Keluaran tulis: (7.9 bundar-ke-bawah), baris-baharu.
} mula.

Atur-cara kemaskan.
usedMemory3 := (Atur-cara ingatan ? 0).



( usedMemory1 = usedMemory2 dan: usedMemory1 = usedMemory3, dan: usedMemory2 = usedMemory3 ) benar: {
	Keluaran tulis: ['No memory leaks here'].
}, palsu: {
	Keluaran tulis: ['Leaking memory...'].
}.
