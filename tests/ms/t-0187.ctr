Nombor apabila: ['faktorial'] lakukan: {
	>> jumlah := 1.
	{ :indeks jumlah darab-dengan: (diri - indeks). } × diri. <- jumlah.
}.

>> ingatanDigunakan1 := 0.
>> ingatanDigunakan2 := 0.
>> ingatanDigunakan3 := 0.
>> ingatanDigunakan4 := 0.

Atur-cara pengurusan-ingatan: 0.

{
2 eksponen faktorial.
Keluaran tulis: (11 baki-bahagi: 3), baris-baharu.
Keluaran tulis: (3.4 bundarkan), baris-baharu.
Keluaran tulis: (7.1 bundar-ke-atas), baris-baharu.
Keluaran tulis: (7.9 bundar-ke-bawah), baris-baharu.
}
mula.

Atur-cara kemaskan.

ingatanDigunakan1 := (Atur-cara ingatan ? 0).

{
2 eksponen faktorial.
Keluaran tulis: (11 baki-bahagi: 3), baris-baharu.
Keluaran tulis: (3.4 bundarkan), baris-baharu.
Keluaran tulis: (7.1 bundar-ke-atas), baris-baharu.
Keluaran tulis: (7.9 bundar-ke-bawah), baris-baharu.
}
mula.

Atur-cara kemaskan.
ingatanDigunakan2 := (Atur-cara ingatan ? 0).


{
2 eksponen faktorial.
Keluaran tulis: (11 baki-bahagi: 3), baris-baharu.
Keluaran tulis: (3.4 bundarkan), baris-baharu.
Keluaran tulis: (7.1 bundar-ke-atas), baris-baharu.
Keluaran tulis: (7.9 bundar-ke-bawah), baris-baharu.
} mula.

Atur-cara kemaskan.
ingatanDigunakan3 := (Atur-cara ingatan ? 0).



( ingatanDigunakan1 = ingatanDigunakan2 dan: ingatanDigunakan1 = ingatanDigunakan3, dan: ingatanDigunakan2 = ingatanDigunakan3 ) benar: {
	Keluaran tulis: ['Tiada kebocoran ingatan di sini'].
}, palsu: {
	Keluaran tulis: ['Ingatan bocor...'].
}.
