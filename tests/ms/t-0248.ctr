

Teks apabila: ['nilaikan'] lakukan: {
	>> kod := Fail baharu: ['/tmp/eval.ctr'].
	kod tulis: diri teks + ['.'].
	Atur-cara guna: ['/tmp/eval.ctr'].
}.

>> a := (Senarai ← (
	(Kamus baharu)
		letak: ['domain'] di: ['mywebsite.com'],
		letak: (Senarai ←
			((Kamus baharu)
				letak: ['laman utama'] di: ['title'],
				letak: ['<html></html>'] di: ['body'],
				letak: ['2017-01-01'] di: ['created']
			) ;
			((Kamus baharu)
				letak: ['aboutus(c)'] di: ['title'],
				letak: ['<credits>Author Inc.</credits>'] di: ['body']
			)
		) di: ['pages']
	)
) teks.

Keluaran tulis: a jenis, baris-baharu.
Keluaran tulis: a, baris-baharu.

>> b := Tiada.
(['b := '] + a) nilaikan.
Keluaran tulis: b ? 0 ? ['pages'] ? 1 ? ['body'], baris-baharu.

>> c := b ? 0.
>> d := c teks.
Keluaran tulis: d jenis, baris-baharu.

>> e := Tiada.
(['e := '] + d) nilaikan.
Keluaran tulis: e ? ['pages'] ? 0, baris-baharu.
