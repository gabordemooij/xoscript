

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Atur-cara pengurusan-ingatan: 0.

>> a := -2 mutlak.
a := a atan.
a := a cos.
a := a log.
a := a sin.
a := a tan.


Atur-cara kemaskan.

usedMemory1 := (Atur-cara ingatan ? 0).


a := -2 mutlak.
a := a atan.
a := a cos.
a := a log.
a := a sin.
a := a tan.


Atur-cara kemaskan.
usedMemory2 := (Atur-cara ingatan ? 0).


a := -2 mutlak.
a := a atan.
a := a cos.
a := a log.
a := a sin.
a := a tan.


Atur-cara kemaskan.
usedMemory3 := (Atur-cara ingatan ? 0).



( usedMemory1 = usedMemory2 dan: usedMemory1 = usedMemory3, dan: usedMemory2 = usedMemory3 ) benar: {
	Keluaran tulis: ['No memory leaks here'].
}, palsu: {
