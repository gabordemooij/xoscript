#ujian ffi


Server init.

Atur-cara pengurusan-ingatan: 4.

# untuk ujian ini anda perlu menetapkan laluan ke libc (puts)
>> namapustaka := Atur-cara tetapan: ['FFITESTLIB'].



Server pautkan: (
 Senarai baharu ;
 namapustaka ;
 ['puts'] ;
 ( Senarai baharu ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s bebaskan.

# ujian dengan struct

>> a := Blob baharu: 8.
a bytes: (
	Senarai <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struktur := Blob struct: (Senarai <<: ['int'], ; ['int']).

Server pautkan: (
	Senarai <<: ['@structtest'], ;
	['@structtest'] ;
	(Senarai <<: struktur) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Keluaran tulis: ['Ujian jumlah:'] + (ffitest ffisum: a), baris-baharu.

struktur bebaskan-struct.
struktur bebaskan.
a bebaskan.
