


>> Deck := Senarai baharu.
Deck apabila: ['print'] lakukan: {
        >> len := diri bilangan - 1.
        { :i
                >> len2 := diri bilangan - 1.
                Keluaran tulis: ['len: '].
                Keluaran tulis: len, baris-baharu.
                Keluaran tulis: ['len2: '].
                Keluaran tulis: len2, baris-baharu.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
