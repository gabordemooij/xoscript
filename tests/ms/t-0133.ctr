


>> Dek := Senarai baharu.
Dek apabila: ['cetak'] lakukan: {
        >> len := diri bilangan - 1.
        { :i
                >> pjg2 := diri bilangan - 1.
                Keluaran tulis: ['pjg: '].
                Keluaran tulis: len, baris-baharu.
                Keluaran tulis: ['pjg2: '].
                Keluaran tulis: pjg2, baris-baharu.
        } × len.
}.

>> d := Dek ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d cetak.
