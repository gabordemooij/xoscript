60 × {
	>> x := (Nombor rawak % 6) + 1.
	(x ≤ 6) palsu: { Keluaran tulis: ['GAGAL']. }.
	(x ≥0) palsu: { Keluaran tulis: ['GAGAL']. }.
	x := (Nombor rawak % 3) + 1.
	(x < 3) palsu: { Keluaran tulis: ['GAGAL']. }.
	(x>-1) palsu: { Keluaran tulis: ['GAGAL']. }.
	x := ((Boolean lambung) nombor).
	(x = 0 atau: x = 1) palsu: { Keluaran tulis: ['GAGAL']. }.
	x := ((Benar lambung) nombor).
	(x = 0 atau: x = 1) palsu: { Keluaran tulis: ['GAGAL']. }.
	x := (Boolean lambung pilih: ['KEPALA'] atau: ['EKOR']).
	((x = ['KEPALA']) atau: (x = ['EKOR'])) palsu: { Keluaran tulis: ['GAGAL']. }.
}.
Keluaran tulis: ['SIAP'].

