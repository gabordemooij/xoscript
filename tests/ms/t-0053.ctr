60 × {
	>> x := (Nombor random % 6) + 1.
	(x ≤ 6) palsu: { Keluaran tulis: ['FAIL']. }.
	(x ≥0) palsu: { Keluaran tulis: ['FAIL']. }.
	x := (Nombor random % 3) + 1.
	(x < 3) palsu: { Keluaran tulis: ['FAIL']. }.
	(x>-1) palsu: { Keluaran tulis: ['FAIL']. }.
	x := ((Boolean flip) nombor).
	(x = 0 atau: x = 1) palsu: { Keluaran tulis: ['FAIL']. }.
	x := ((Benar flip) nombor).
	(x = 0 atau: x = 1) palsu: { Keluaran tulis: ['FAIL']. }.
	x := (Boolean flip pilih: ['HEAD'] atau: ['TAIL']).
	((x = ['HEAD']) atau: (x = ['TAIL'])) palsu: { Keluaran tulis: ['FAIL']. }.
}.
Keluaran tulis: ['DONE'].

