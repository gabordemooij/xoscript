Keluaran tulis: ['1,2,3,4,5,6,7,8,9,A,'], baris-baharu.
>> Scope := Objek baharu.
Scope apabila: ['initialize:'] lakukan: { :x milik property := x. }.
Scope apabila: ['confirm'] lakukan: { Keluaran tulis: [',']. }.
Scope apabila: ['uji'] lakukan: {
	Keluaran tulis: milik property.
	diri confirm.
	( 1 = 1 ) benar: { Keluaran tulis: milik property. diri confirm. }.
	( 1 = 0 ) palsu: { Keluaran tulis: milik property. diri confirm. }.
	>> y := 2. { Keluaran tulis: milik property. diri confirm. } selagi: { y tolak: 1. <- (y > 0). }.
	{ Keluaran tulis: milik property. diri confirm. } × 1.
	(Senarai ← 1) setiap: {  Keluaran tulis: milik property. diri confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Kamus baharu one: ['item']) setiap: { Keluaran tulis: milik property. diri confirm. }.
	{ 1 ÷ 0. } tangkap: { Keluaran tulis: milik property. diri confirm. }, mula.
	Keluaran baris-baharu.
}.
>> scope1 := Scope baharu.
scope1 initialize: ['X'].
scope1 uji.
>> function := { 
	milik property := ['Y'].
	Keluaran tulis: milik property.
	diri confirm.
	( 1 = 1 ) benar: { Keluaran tulis: milik property. diri confirm. }.
	( 1 = 0 ) palsu: { Keluaran tulis: milik property. diri confirm. }.
	>> y := 2. { Keluaran tulis: milik property. diri confirm. } selagi: { y tolak: 1. <- (y > 0). }.
	{ Keluaran tulis: milik property. diri confirm. } × 1.
	(Senarai ← 1) setiap: {  Keluaran tulis: milik property. diri confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Kamus baharu one: ['item']) setiap: { Keluaran tulis: milik property. diri confirm. }.
	{ 1 ÷ 0. } tangkap: { Keluaran tulis: milik property. diri confirm. }, mula.
	Keluaran baris-baharu.
}.
function apabila: ['confirm'] lakukan: { Keluaran tulis: [',']. }.
function gunakan-pada: 1 dan: 2.
