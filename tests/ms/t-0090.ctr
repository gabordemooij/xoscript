Keluaran tulis: ['1,2,3,4,5,6,7,8,9,A,'], baris-baharu.
>> Skop := Objek baharu.
Skop apabila: ['initialize:'] lakukan: { :x milik sifat := x. }.
Skop apabila: ['pastikan'] lakukan: { Keluaran tulis: [',']. }.
Skop apabila: ['uji'] lakukan: {
	Keluaran tulis: milik sifat.
	diri pastikan.
	( 1 = 1 ) benar: { Keluaran tulis: milik sifat. diri pastikan. }.
	( 1 = 0 ) palsu: { Keluaran tulis: milik sifat. diri pastikan. }.
	>> y := 2. { Keluaran tulis: milik sifat. diri pastikan. } selagi: { y tolak: 1. <- (y > 0). }.
	{ Keluaran tulis: milik sifat. diri pastikan. } × 1.
	(Senarai ← 1) setiap: {  Keluaran tulis: milik sifat. diri pastikan. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo laksanakan pengisihan sendiri, ujian ini gagal kerana bil. lelaran berbeza mengikut platform
	(Kamus baharu one: ['item']) setiap: { Keluaran tulis: milik sifat. diri pastikan. }.
	{ 1 ÷ 0. } tangkap: { Keluaran tulis: milik sifat. diri pastikan. }, mula.
	Keluaran baris-baharu.
}.
>> skop1 := Skop baharu.
skop1 initialize: ['X'].
skop1 uji.
>> fungsiSaya := { 
	milik sifat := ['Y'].
	Keluaran tulis: milik sifat.
	diri pastikan.
	( 1 = 1 ) benar: { Keluaran tulis: milik sifat. diri pastikan. }.
	( 1 = 0 ) palsu: { Keluaran tulis: milik sifat. diri pastikan. }.
	>> y := 2. { Keluaran tulis: milik sifat. diri pastikan. } selagi: { y tolak: 1. <- (y > 0). }.
	{ Keluaran tulis: milik sifat. diri pastikan. } × 1.
	(Senarai ← 1) setiap: {  Keluaran tulis: milik sifat. diri pastikan. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Kamus baharu one: ['item']) setiap: { Keluaran tulis: milik sifat. diri pastikan. }.
	{ 1 ÷ 0. } tangkap: { Keluaran tulis: milik sifat. diri pastikan. }, mula.
	Keluaran baris-baharu.
}.
fungsiSaya apabila: ['pastikan'] lakukan: { Keluaran tulis: [',']. }.
fungsiSaya gunakan-pada: 1 dan: 2.
