# test url parsing

Server init.
>> url := URL daripada: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Keluaran tulis: ['scheme = '] + url skema, baris-baharu.
Keluaran tulis: ['host = '] + url hos, baris-baharu.
Keluaran tulis: ['port = '] + url port, baris-baharu.
Keluaran tulis: ['path = '] + url laluan, baris-baharu.
Keluaran tulis: ['query = '] + url parameter-carian, baris-baharu.
Keluaran tulis: ['fragment = '] + url serpihan, baris-baharu.
