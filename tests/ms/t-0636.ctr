# uji penghuraian url

Server init.
>> url := URL daripada: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Keluaran tulis: ['skema = '] + url skema, baris-baharu.
Keluaran tulis: ['hos = '] + url hos, baris-baharu.
Keluaran tulis: ['port = '] + url port, baris-baharu.
Keluaran tulis: ['laluan = '] + url laluan, baris-baharu.
Keluaran tulis: ['pertanyaan = '] + url parameter-carian, baris-baharu.
Keluaran tulis: ['serpihan = '] + url serpihan, baris-baharu.
