# kunci awam (untuk melindungi API dan sebagainya)
Server init.

# jana pasangan kunci
>> pasangan-kunci := Peti-besi jana-kunci.

# kunci peribadi (rahsia)
>> kp := pasangan-kunci pertama.

# kunci awam
>> ku := pasangan-kunci terakhir.

# tandatangani mesej
>> ttd := Peti-besi tandatangan: ['abc'] dengan: kp.

Keluaran tulis: ttd panjang, baris-baharu.