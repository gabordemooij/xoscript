# test number -> string -> number
{

	>> x := Nombor antara: 0 dan: 1000000.
	>> d := Nombor antara: 1 dan: 7.
	>> e := 10 kuasa: d.

	x bahagi-dengan: e.
	>> y := x teks nombor.

	(x = y) palsu: {
		Keluaran tulis: x, baris-baharu.
		Keluaran tulis: y, baris-baharu.
		Atur-cara tamat.
	}.

} * 1000.
Keluaran tulis: ['OK'], baris-baharu.