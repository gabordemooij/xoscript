

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Atur-cara pengurusan-ingatan: 0.

>> o := Objek baharu.
>> o2 := Objek baharu.
Keluaran tulis: o Tiada?, baris-baharu.
Keluaran tulis: o jenis, baris-baharu.
Keluaran tulis: ( o sama-dengan: o ), baris-baharu.
Keluaran tulis: ( o sama-dengan: o2 ), baris-baharu.
Keluaran tulis: o diri-sendiri, baris-baharu.
Keluaran tulis: ( o lakukan selesai ), baris-baharu.

Atur-cara kemaskan.

usedMemory1 := (Atur-cara ingatan ? 0).


o := Objek baharu.
o2 := Objek baharu.
Keluaran tulis: o Tiada?, baris-baharu.
Keluaran tulis: o jenis, baris-baharu.
Keluaran tulis: ( o sama-dengan: o ), baris-baharu.
Keluaran tulis: ( o sama-dengan: o2 ), baris-baharu.
Keluaran tulis: o diri-sendiri, baris-baharu.
Keluaran tulis: ( o lakukan selesai ), baris-baharu.

Atur-cara kemaskan.
usedMemory2 := (Atur-cara ingatan ? 0).


o := Objek baharu.
o2 := Objek baharu.
Keluaran tulis: o Tiada?, baris-baharu.
Keluaran tulis: o jenis, baris-baharu.
Keluaran tulis: ( o sama-dengan: o ), baris-baharu.
Keluaran tulis: ( o sama-dengan: o2 ), baris-baharu.
