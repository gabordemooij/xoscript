


>> ingatanDigunakan1 := 0.
>> ingatanDigunakan2 := 0.
>> ingatanDigunakan3 := 0.
>> ingatanDigunakan4 := 0.

Atur-cara pengurusan-ingatan: 0.
>> palet := Tiada.
>> warna-warna := Tiada.

{
palet := Kamus baharu.
palet 
	letak: ['#F00'] di: ['merah'],
	letak: ['#0F0'] di: ['hijau'],
	letak: ['#00F'] di: ['biru'].
Keluaran tulis: ['bilangan kod RGB dalam palet: '] + ( palet bilangan ), baris-baharu.
Keluaran tulis: ['Kod RGB bagi hijau ialah: '] + ( palet ? ['hijau'] ), baris-baharu.
warna-warna := [''].
( palet setiap: { :nama :kod
		warna-warna := warna-warna + ( nama + [':'] + kod ).
} ).
Keluaran tulis: ['Semua warna dalam palet: '] + warna-warna, baris-baharu.
} mula.
Atur-cara kemaskan.
ingatanDigunakan1 := (Atur-cara ingatan ? 0).

{
