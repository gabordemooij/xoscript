


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Atur-cara pengurusan-ingatan: 0.
>> palette := Tiada.
>> colors := Tiada.

{
palette := Kamus baharu.
palette 
	letak: ['#F00'] di: ['red'],
	letak: ['#0F0'] di: ['green'],
	letak: ['#00F'] di: ['blue'].
Keluaran tulis: ['number of RGB codes in palette: '] + ( palette bilangan ), baris-baharu.
Keluaran tulis: ['RGB code of green is: '] + ( palette ? ['green'] ), baris-baharu.
colors := [''].
( palette setiap: { :nama :kod
		colors := colors + ( nama + [':'] + kod ).
} ).
Keluaran tulis: ['All colors in palette: '] + colors, baris-baharu.
} mula.
Atur-cara kemaskan.
usedMemory1 := (Atur-cara ingatan ? 0).

{
