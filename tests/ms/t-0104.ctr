
{ :i
	Keluaran tulis: ['This is step #'] + ( ( i ) + 1 ), baris-baharu.
} × 6.

{ :i
	Keluaran tulis: ['This is step #'] + ( 3 - ( i ) ), baris-baharu.
} × 6.

{ :i
	Keluaran tulis: ['NEVER!'], baris-baharu.
} × 0.



{ :i
	Keluaran tulis: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), baris-baharu.
} × 11.
