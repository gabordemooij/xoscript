>> To-Do := Objek baharu.

To-Do apabila: ['baharu'] lakukan: {
	milik list := Senarai baharu.
}.

To-Do apabila: ['nieuw'] lakukan: {
	milik list := Senarai baharu.
}.

To-Do apabila: ['+'] lakukan: { :task
	milik list tambah-di-hujung: task.
}.

To-Do apabila: ['number of tasks?'] lakukan: { <-  milik list bilangan.
}.

>> todos := 
	To-Do baharu 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Keluaran tulis: ['You have $ tasks to do'] $ todos number of tasks?.
