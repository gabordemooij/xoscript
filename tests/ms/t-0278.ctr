>> Senarai-Tugas := Objek baharu.

Senarai-Tugas apabila: ['baharu'] lakukan: {
	milik list := Senarai baharu.
}.

Senarai-Tugas apabila: ['nieuw'] lakukan: {
	milik list := Senarai baharu.
}.

Senarai-Tugas apabila: ['+'] lakukan: { :tugas
	milik list tambah-di-hujung: tugas.
}.

Senarai-Tugas apabila: ['number of tasks?'] lakukan: { <-  milik list bilangan.
}.

>> tugas-tugas := 
	Senarai-Tugas baharu 
	+ ['masak makan malam'] 
	+ ['kemas bilik'].
	
Keluaran tulis: ['You have $ tasks to do'] $ tugas-tugas number of tasks?.
