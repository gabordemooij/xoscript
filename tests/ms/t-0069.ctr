

Teks apabila: ['html'] lakukan: { <- (
		diri
		ganti: ['&'] dengan: ['&amp;'],
		ganti: ['<'] dengan: ['&lt;'],
		ganti: ['>'] dengan: ['&gt;'],
		ganti: ['"'] dengan: ['&quot;']
	).
}.


Keluaran tulis: ([' dipangkas kiri '] pangkas) + [' '] + ( ['dan dipangkas kanan'] pangkas) + ['!'], baris-baharu.
Keluaran tulis: ['<html>"html & entities"</html>'] html.
