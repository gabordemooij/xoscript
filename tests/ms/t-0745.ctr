Keluaran tulis: ['Test object'], baris-baharu.
>> a := Objek baharu. 

a apabila: ['item:'] lakukan: { :dict
	milik dict := dict. 
}.

a apabila: ['item'] lakukan: { <- milik dict.
}.

a item: (
Kamus baharu
	hello: ['world']).

>> old-dict-address := a item prototaip alamat-ingatan.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baharu.

>> b := Objek load-from: ['/tmp/a.bin'].

(b item prototaip alamat-ingatan = old-dict-address) benar: {
	Keluaran tulis: ['Object link re-attached.'], baris-baharu.
}.

Keluaran tulis: b item, baris-baharu.
