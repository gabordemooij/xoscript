#Linux

 >> t := Detik baharu.
 
t zon: ['Europe/Amsterdam'].
t tahun: 2020, bulan: 8, hari: 2, jam: 21, minit: 2, saat: 1.

>> a := t jam.
>> ams := t zon.

t zon: ['US/Hawaii'].
>> b := t jam.
>> hw := t zon.

Keluaran
tulis: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		pilih: ['later'] atau: ['earlier']
	)
),
baris-baharu.
 