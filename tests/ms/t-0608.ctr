
>> Size := Objek baharu.
Size apabila: ['is:'] lakukan: { :nombor
	nombor apabila: ['+'] lakukan: { :nombor
		>> unit := nombor unit.
		>> factor := 1.
		
		unit
		kes: ['inch'] lakukan: { factor := 0.0833. }. <- diri + (nombor * factor).
	}. <- nombor.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Keluaran tulis: plank + edge, baris-baharu.
