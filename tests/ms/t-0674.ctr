# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> laluan := ['/tmp/dat.csv'].
>> csv := Fail baharu: laluan.
csv tulis: s.

# accepts CRLF LF CR, varying row length
csv pembatas: [';'] tanda-petik: ['"'] baris: { :line
	Atur-cara kemaskan.
	Keluaran tulis: line, baris-baharu.
	Atur-cara kemaskan.
}.

# unequal lines
s tambah-di-hujung: ['\njustone'].
csv tulis: s.
{
	csv pembatas: [';'] tanda-petik: ['"'] baris: { :line
		Keluaran tulis: line, baris-baharu.
	}.
} tangkap: { :e 
	Keluaran tulis: e, baris-baharu.
}, mula.

# invalid format
s := ['"he"llo";world'].
csv tulis: s.
{
	csv pembatas: [';'] tanda-petik: ['"'] baris: { :line
		Keluaran tulis: line, baris-baharu.
	}.
} tangkap: { :e 
	Keluaran tulis: e, baris-baharu.
}, mula.
