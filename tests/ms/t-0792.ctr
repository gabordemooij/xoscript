Server init.

>> DB := Maria-DB baharu hos: ['localhost'],
	nama-pengguna: ['xo'],
	kata-laluan: ['pass123'],
	nama-pangkalan-data: ['xobase'],
	sambung.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB pertanyaan: SQL.

# now you don't have to set DB
query2 dapatkan: { :row
	Keluaran tulis: row world, baris-baharu.
}.
