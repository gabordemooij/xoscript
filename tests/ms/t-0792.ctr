Server init.

>> PD := Maria-DB baharu hos: ['localhost'],
	nama-pengguna: ['xo'],
	kata-laluan: ['pass123'],
	nama-pangkalan-data: ['xobase'],
	sambung.
	
>> SQL := ['SELECT "hello" AS "world" '].

# cara yang lebih pantas, dapatkan pertanyaan daripada PD:
>> pertanyaan2 := PD pertanyaan: SQL.

# kini anda tidak perlu menetapkan PD
pertanyaan2 dapatkan: { :barisan
	Keluaran tulis: barisan world, baris-baharu.
}.
