Server init.

# tulis fail ujian
>> f := Fail baharu: ['/tmp/test.gif'].
f tulis: ['GIF87a01234567810'].

# sajikan fail itu
Server teruskan: ['test.gif'] awalan: ['/tmp/'].

Keluaran baris-baharu.

Keluaran tulis: ['Di luar bekas (keselamatan):'], baris-baharu.
{ Server teruskan: ['../passwd'] awalan: ['/tmp/']. }
tangkap: { :e Keluaran tulis: e, baris-baharu. },
mula.

Keluaran tulis: ['Awalan tidak sah:'], baris-baharu.
{ Server teruskan: ['test.gif'] awalan: ['z:\\']. }
tangkap: { :e Keluaran tulis: e, baris-baharu. },
mula.

Keluaran tulis: ['Fail tidak wujud:'], baris-baharu.
{ Server teruskan: ['xxx.xxx'] awalan: ['/tmp/']. }
tangkap: { :e Keluaran tulis: e, baris-baharu. },
mula.
