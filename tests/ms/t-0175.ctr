

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> x := 100.

Atur-cara pengurusan-ingatan: 0.

{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt tambah-di-hujung: ['!!'].
Keluaran tulis: txt.
} mula.

Atur-cara kemaskan.

usedMemory1 := (Atur-cara ingatan ? 0).


{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt tambah-di-hujung: ['!!'].
