

>> ingatanDigunakan1 := 0.
>> ingatanDigunakan2 := 0.
>> ingatanDigunakan3 := 0.
>> ingatanDigunakan4 := 0.

>> x := 100.

Atur-cara pengurusan-ingatan: 0.

{
>> txt := ['helo '] + ['world'].
txt := txt + [' - bolehkah kita guna teks.. '].
txt := txt + ['tanpa membocorkan '] + x + ['-an bait ?'].
txt tambah-di-hujung: ['!!'].
Keluaran tulis: txt.
} mula.

Atur-cara kemaskan.

ingatanDigunakan1 := (Atur-cara ingatan ? 0).


{
>> txt := ['helo '] + ['world'].
