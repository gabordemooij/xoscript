
>> Rectangle := Objek baharu.

Rectangle apabila: ['area'] lakukan: { <- milik panjang * milik width.
}.

Rectangle apabila: ['length:'] lakukan: { :panjang
	milik panjang := panjang.
}.

Rectangle apabila: ['width:'] lakukan: { :width
	milik width := width.
}.

Rectangle apabila: ['baharu'] lakukan: {
	# this will not result into an infinite loop
	>> rectangle := diri baharu.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle baharu.
Keluaran tulis: a area, baris-baharu. #0

>> b := Rectangle baharu length: 2, width: 3.
Keluaran tulis: b area, baris-baharu. #6

