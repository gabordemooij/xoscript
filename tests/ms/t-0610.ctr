
>> SegiEmpat := Objek baharu.

SegiEmpat apabila: ['luas'] lakukan: {
	<- milik panjang * milik lebar.
}.

SegiEmpat apabila: ['length:'] lakukan: { :panjang
	milik panjang := panjang.
}.

SegiEmpat apabila: ['width:'] lakukan: { :lebar
	milik lebar := lebar.
}.

SegiEmpat apabila: ['baharu'] lakukan: {
	# ini tidak akan menghasilkan gelung tanpa henti
	>> segiEmpat := diri baharu.
	segiEmpat length: 0, width: 0.
	<- segiEmpat.
}.

>> a := SegiEmpat baharu.
Keluaran tulis: a luas, baris-baharu. #0

>> b := SegiEmpat baharu length: 2, width: 3.
Keluaran tulis: b luas, baris-baharu. #6

