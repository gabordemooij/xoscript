Server init.
Keluaran tulis: ['Database datetime test'], baris-baharu.

>> db := Maria-DB baharu hos: ['localhost'],
	nama-pengguna: ['xo'], 
	kata-laluan: ['pass123'],
	nama-pangkalan-data: ['xobase'],
	sambung.

>> parameter-carian :=
db pertanyaan: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
dapatkan: { :row
	Keluaran tulis: row datetimetest, baris-baharu.
}.
