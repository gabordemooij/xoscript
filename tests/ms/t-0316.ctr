>> Grandfather := Objek baharu.
Grandfather apabila: ['greet'] lakukan: {
	Keluaran tulis: ['Ave!'], baris-baharu.
}.
>> Father := Grandfather baharu.
Father apabila: ['greet'] lakukan: {
	Keluaran tulis: ['Hello'], baris-baharu.
	diri greet.
}.
>> Son := Father baharu.
Son apabila: ['greet'] lakukan: {
	Keluaran tulis: ['Hi'], baris-baharu.
	diri greet.
}.

Son greet.

>> Roundabout := Objek baharu.
Roundabout apabila: ['circle:'] lakukan: { :x
	Keluaran tulis: x, baris-baharu.
	(x < 3) benar: { diri rekursif circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) benar: { Keluaran tulis: x, baris-baharu. x tambah: 1.  increment mula. }. }.
increment mula.