Server init.
Keluaran tulis: ['Database date test'], baris-baharu.

>> db := Maria-DB baharu hos: ['localhost'],
	nama-pengguna: ['xo'], 
	kata-laluan: ['pass123'],
	nama-pangkalan-data: ['xobase'],
	sambung.

>> parameter-carian :=
db pertanyaan: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
dapatkan: { :row
	Keluaran tulis: row datetest, baris-baharu.
}.
