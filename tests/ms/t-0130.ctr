# menggunakan FFI dengan pemalam Server

# sambung ke libc (khusus platform)
>> namapustaka := Atur-cara tetapan: ['FFITESTLIB'].

# pautkan fungsi stdio daripada c untuk operasi fail lanjutan
Server pautkan: ( Senarai baharu ;
 namapustaka ; ['fopen'] ;
 ( Senarai baharu ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
pautkan: ( Senarai baharu ;
 Tiada ; # bermaksud pustaka yang sama
 ['fread'] ;
 ( Senarai baharu ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Tiada ; # bermaksud objek yang sama (iaitu Strim)
 ['fread']
),
pautkan: (
 Senarai baharu ;
 Tiada ; # bermaksud pustaka yang sama
 ['fwrite'] ;
 ( Senarai baharu ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Tiada ; # bermaksud pustaka yang sama
 ['fwrite']
),
pautkan: (
 Senarai baharu ;
 Tiada ; # bermaksud pustaka yang sama
 ['rewind'] ;
 ( Senarai baharu ; ['pointer'] ) ;
 ['int'] ;
 Tiada ; # bermaksud pustaka yang sama
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> laluan := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# buka fail dengan fopen(path, mode)
>> fd := Stream path: laluan mode: mode.

# tulis bait daripada penimbal str ke fail
>> bait-ditulis := Stream mesej: ['fwrite'] argumen: (Senarai baharu ; str ; 1 ; 6 ; fd ).
Keluaran tulis: bait-ditulis, baris-baharu.

# putar balik penuding fail
Stream rewind: fd.

# peruntukkan penimbal
>> pnb := Blob baharu: 20.

# baca daripada fail
>> bait-dibaca := Stream mesej: ['fread'] argumen: (Senarai baharu ; pnb ; 1 ; 6 ; fd ).
Keluaran tulis: bait-dibaca, baris-baharu.
Keluaran tulis: pnb, baris-baharu.

# bebaskan ingatan
str  bebaskan.
laluan bebaskan.
mode bebaskan.
pnb  bebaskan.


