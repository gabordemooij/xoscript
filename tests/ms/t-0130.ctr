# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Atur-cara tetapan: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server pautkan: ( Senarai baharu ;
 libname ; ['fopen'] ;
 ( Senarai baharu ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
pautkan: ( Senarai baharu ;
 Tiada ; # means same lib
 ['fread'] ;
 ( Senarai baharu ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Tiada ; # means same object (i.e. Stream)
 ['fread']
),
pautkan: (
 Senarai baharu ;
 Tiada ; # means same lib
 ['fwrite'] ;
 ( Senarai baharu ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Tiada ; # means same lib
 ['fwrite']
),
pautkan: (
 Senarai baharu ;
 Tiada ; # means same lib
 ['rewind'] ;
 ( Senarai baharu ; ['pointer'] ) ;
 ['int'] ;
 Tiada ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> laluan := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: laluan mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream mesej: ['fwrite'] argumen: (Senarai baharu ; str ; 1 ; 6 ; fd ).
Keluaran tulis: bytes-written, baris-baharu.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob baharu: 20.

# read from file
>> bytes-read := Stream mesej: ['fread'] argumen: (Senarai baharu ; buf ; 1 ; 6 ; fd ).
Keluaran tulis: bytes-read, baris-baharu.
Keluaran tulis: buf, baris-baharu.

# free memory
str  bebaskan.
laluan bebaskan.
mode bebaskan.
buf  bebaskan.


