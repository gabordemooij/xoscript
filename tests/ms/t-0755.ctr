Keluaran tulis: ['Test object'], baris-baharu.
>> greeter := Objek baharu.
greeter apabila: ['name:'] lakukan: { :nama
	milik xname := nama. 
}.
greeter apabila: ['greet'] lakukan: {
	Keluaran tulis: ['Hello '] + milik xname, baris-baharu.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baharu.
>> b := Objek load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
