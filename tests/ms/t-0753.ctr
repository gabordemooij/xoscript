Keluaran tulis: ['Objek ujian'], baris-baharu.
>> a := Objek baharu. 

a apabila: ['item:'] lakukan: { :fmt
	milik fmt := fmt. 
}.

a apabila: ['barang'] lakukan: {
	<- milik fmt.
}.

a item: ( Format baharu: ['|%s|'] ).

Keluaran tulis: a barang, baris-baharu.

>> alamat-lama-fmt := a barang prototaip alamat-ingatan.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== MEMUAT SEMULA SNAP:'], baris-baharu.

>> b := Objek load-from: ['/tmp/a.bin'].

(b barang prototaip alamat-ingatan = alamat-lama-fmt) benar: {
	Keluaran tulis: ['Pautan objek dipasang semula.'], baris-baharu.
}.

Keluaran tulis: ( b barang gunakan-pada: ['hello'] ), baris-baharu.
