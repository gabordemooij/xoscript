Keluaran tulis: ['Test object'], baris-baharu.
>> a := Objek baharu. 

a apabila: ['item:'] lakukan: { :fmt
	milik fmt := fmt. 
}.

a apabila: ['item'] lakukan: { <- milik fmt.
}.

a item: ( Format baharu: ['|%s|'] ).

Keluaran tulis: a item, baris-baharu.

>> old-fmt-address := a item prototaip alamat-ingatan.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baharu.

>> b := Objek load-from: ['/tmp/a.bin'].

(b item prototaip alamat-ingatan = old-fmt-address) benar: {
	Keluaran tulis: ['Object link re-attached.'], baris-baharu.
}.

Keluaran tulis: ( b item gunakan-pada: ['hello'] ), baris-baharu.
