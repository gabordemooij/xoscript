

# rujukan dalam world.c

>> ingatanDigunakan1 := 0.
>> ingatanDigunakan2 := 0.
>> ingatanDigunakan3 := 0.
>> ingatanDigunakan4 := 0.
>> kod := {
	>> a := Kamus baharu.
	>> b := Kamus baharu.
	a pautkan: b.
	b pautkan: a.
}.
Atur-cara pengurusan-ingatan: 0.
Atur-cara kemaskan.
ingatanDigunakan1 := (Atur-cara ingatan ? 0).
kod mula.
Atur-cara kemaskan.
ingatanDigunakan2 := (Atur-cara ingatan ? 0).
kod mula.
Atur-cara kemaskan.
ingatanDigunakan3 := (Atur-cara ingatan ? 0).
