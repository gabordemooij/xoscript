>> a := Objek baharu. 
a apabila: ['sapa'] lakukan: { Keluaran tulis: ['selamat datang!'], baris-baharu. }.
a apabila: ['sapa2'] lakukan: { Keluaran tulis: ['selamat datang2!'], baris-baharu. }.
a save-as: ['/tmp/a.bin'].

Keluaran tulis: ['========== MEMUAT SEMULA SNAP:'], baris-baharu.
>> b := Objek load-from: ['/tmp/a.bin'].
b sapa2.