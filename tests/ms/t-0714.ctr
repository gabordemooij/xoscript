>> a := Objek baharu. 
a apabila: ['greet'] lakukan: { Keluaran tulis: ['welcome!'], baris-baharu. }.
a apabila: ['greet2'] lakukan: { Keluaran tulis: ['welcome2!'], baris-baharu. }.
a save-as: ['/tmp/a.bin'].

Keluaran tulis: ['========== RELOADING SNAP:'], baris-baharu.
>> b := Objek load-from: ['/tmp/a.bin'].
b greet2.