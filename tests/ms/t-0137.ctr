>> ingatanDigunakan5 := (Atur-cara ingatan ? 0).




(ingatanDigunakan1 = ingatanDigunakan2 = ingatanDigunakan3 = ingatanDigunakan4 = ingatanDigunakan5) benar: {
	Keluaran tulis: ['Penggunaan ingatan kekal stabil.'], baris-baharu.
}, jika-tidak: {
	Keluaran tulis: ['Ingatan yang digunakan tidak stabil.'], baris-baharu.
	Keluaran tulis: ingatanDigunakan1, baris-baharu.
	Keluaran tulis: ingatanDigunakan2, baris-baharu.
