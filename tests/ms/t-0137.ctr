


Atur-cara pengurusan-ingatan: 0.

>> x := 0.
>> y := ['Hello'].
>> q := { ['Kosong']. }.
>> p := Benar.
>> a := Senarai ← 1 ; 2 ; 3 ; 4.

>> ingatanDigunakan1 := 0.
>> ingatanDigunakan2 := 0.
>> ingatanDigunakan3 := 0.
>> ingatanDigunakan4 := 0.

Atur-cara kemaskan.
ingatanDigunakan1 := (Atur-cara ingatan ? 0).




x := 1.
y := ['Hello'].
q := { ['Kosong']. }.
p := Benar.
a := Senarai ← 1 ; 2 ; 3 ; 5.

Atur-cara kemaskan.
ingatanDigunakan2 := (Atur-cara ingatan ? 0).




x := 2.
y := ['Hello'].
