
Atur-cara pengurusan-ingatan: 4.

>> Haiwan := Objek baharu.
Haiwan apabila: ['cipta'] lakukan: {
	>> haiwan := Objek baharu.
	haiwan apabila: ['buatBunyi'] lakukan: {
		Keluaran tulis: milik bunyi.
	}. <- haiwan.
}.
>> Kucing := Objek baharu.
Kucing apabila: ['cipta'] lakukan: {
	>> kucing := Haiwan cipta.
	kucing apabila: ['init'] lakukan: {
		milik bunyi := ['meow!'].
	}.
	kucing init. <- kucing.
}.
>> tom := Kucing cipta.
tom buatBunyi.
