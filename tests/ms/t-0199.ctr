
Atur-cara pengurusan-ingatan: 4.

>> Animal := Objek baharu.
Animal apabila: ['make'] lakukan: {
	>> animal := Objek baharu.
	animal apabila: ['makeSound'] lakukan: {
		Keluaran tulis: milik sound.
	}. <- animal.
}.
>> Cat := Objek baharu.
Cat apabila: ['make'] lakukan: {
	>> cat := Animal make.
	cat apabila: ['init'] lakukan: {
		milik sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
