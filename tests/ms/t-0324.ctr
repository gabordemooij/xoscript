>> Haiwan := Objek baharu.
>> Kilang := Objek baharu.

Haiwan apabila: ['baharu'] lakukan: {
	>> haiwan := diri baharu.
	haiwan sound: ['?']. <- haiwan.
}.

Haiwan apabila: ['sound:'] lakukan: { :s
	milik bunyi := s.
}.

Haiwan apabila: ['bunyi'] lakukan: { <- milik bunyi.
}.

>> Anjing := Objek baharu.
>> Kucing := Objek baharu.

Anjing apabila: ['baharu'] lakukan: { <- Haiwan baharu sound: ['woof!'].
}.

Kucing apabila: ['baharu'] lakukan: { <- Haiwan baharu sound: ['meow!'].
}.

Keluaran tulis: Anjing baharu bunyi, baris-baharu.
Keluaran tulis: Kucing baharu bunyi, baris-baharu.

Kilang apabila: ['campur:dan:'] lakukan: { :binatang1 :binatang2 <- Haiwan baharu sound: (
		( binatang1 bunyi dari: 0 panjang: 2 ) +
		( binatang2 bunyi dari: 2 panjang: 5 )
	).
}.

Keluaran tulis: (Kilang campur: Anjing baharu dan: Kucing baharu) bunyi, baris-baharu.
