# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Atur-cara shell-escape: ['abc'].
Keluaran tulis: c, baris-baharu.
Keluaran tulis: ( Atur-cara sistem: ['echo '] + c ), baris-baharu.

c := Atur-cara shell-escape: ['a'b'c'].
Keluaran tulis: c, baris-baharu.
Keluaran tulis: ( Atur-cara sistem: ['echo '] + c ), baris-baharu.

c := Atur-cara shell-escape: ['a\'c'].
Keluaran tulis: c, baris-baharu.
Keluaran tulis: ( Atur-cara sistem: ['echo '] + c ), baris-baharu.