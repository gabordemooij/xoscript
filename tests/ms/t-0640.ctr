
Server init.
Keluaran tulis: ['Ujian pangkalan data'], baris-baharu.

>> pd := Maria-DB baharu hos: ['localhost'],
	nama-pengguna: ['xo'], 
	kata-laluan: ['pass123'],
	nama-pangkalan-data: ['xobase'],
	sambung.

>> parameter-carian :=
pd pertanyaan: ['SELECT UNHEX('CAFE') AS blobby'],
dapatkan: { :barisan
	Keluaran tulis: ( barisan blobby dari: 0 panjang: 2 ), baris-baharu.
	barisan blobby bebaskan.
}.
