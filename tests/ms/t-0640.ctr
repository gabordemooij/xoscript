
Server init.
Keluaran tulis: ['Database test'], baris-baharu.

>> db := Maria-DB baharu hos: ['localhost'],
	nama-pengguna: ['xo'], 
	kata-laluan: ['pass123'],
	nama-pangkalan-data: ['xobase'],
	sambung.

>> parameter-carian :=
db pertanyaan: ['SELECT UNHEX('CAFE') AS blobby'],
dapatkan: { :row
	Keluaran tulis: ( row blobby dari: 0 panjang: 2 ), baris-baharu.
	row blobby bebaskan.
}.
