# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB baharu hos: ['localhost'],
	nama-pengguna: ['xo'],
	kata-laluan: ['pass123'],
	nama-pangkalan-data: ['xobase'],
	sambung.

>> parameter-carian := db pertanyaan: ['SELECT %% FROM'].
{ parameter-carian laksana. } tangkap: { :e
	Keluaran tulis: ( e mengandungi: ['%%'] ), baris-baharu.
}, mula.
