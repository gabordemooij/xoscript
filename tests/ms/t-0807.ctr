# mesej ralat pangkalan data tidak boleh dianggap sebagai teks format
Server init.

>> pd := Maria-DB baharu hos: ['localhost'],
	nama-pengguna: ['xo'],
	kata-laluan: ['pass123'],
	nama-pangkalan-data: ['xobase'],
	sambung.

>> parameter-carian := pd pertanyaan: ['SELECT %% FROM'].
{ parameter-carian laksana. } tangkap: { :e
	Keluaran tulis: ( e mengandungi: ['%%'] ), baris-baharu.
}, mula.
