

>> obj := Objek baharu.

obj apabila: ['sapa'] lakukan: {
	<- ['hai'].
}.

# perlu mengeluarkan hi123hi123ok
obj apabila: ['tugas'] lakukan: {
	milik sifat := 123.
	{
		# cuba mengikat diri/milik kepada objek dan bukan kepada blok
		Keluaran tulis: diri sapa.
		Keluaran tulis: milik sifat.
		1 / 0.
	} tangkap: {
		Keluaran tulis: diri sapa.
		Keluaran tulis: milik sifat.
		Keluaran tulis: ['ok'].
	}, cuba.
}.

obj tugas.