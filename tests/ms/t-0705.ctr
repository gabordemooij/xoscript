

>> obj := Objek baharu.

obj apabila: ['greet'] lakukan: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj apabila: ['task'] lakukan: {
	milik property := 123.
	{
		# try binds self/own to object instead of block
		Keluaran tulis: diri greet.
		Keluaran tulis: milik property.
		1 / 0.
	} tangkap: {
		Keluaran tulis: diri greet.
		Keluaran tulis: milik property.
		Keluaran tulis: ['ok'].
	}, cuba.
}.

obj task.