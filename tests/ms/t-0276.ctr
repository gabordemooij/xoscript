>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objek baharu.
⚄ apabila: ['drawFrom:length:'] lakukan: { :pool :bilangan
	
	>> result := [''].
	
	{
		>> index := Nombor random % (pool panjang).
		result tambah-di-hujung: ( pool aksara: (index + 1) ).
		
	} × bilangan. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? panjang.
Keluaran tulis: (['x↵'] x random panjang).
Keluaran tulis: (['y↵'] y ?? panjang).

