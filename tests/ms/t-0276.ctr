>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objek baharu.
⚄ apabila: ['ambilDari:panjang:'] lakukan: { :takungan :bilangan
	
	>> hasil := [''].
	
	{
		>> indeks := Nombor rawak % (takungan panjang).
		hasil tambah-di-hujung: ( takungan aksara: (indeks + 1) ).
		
	} × bilangan. <- hasil.
}.

>> rawak := ⚄ ambilDari: ?? panjang: ?? panjang.
Keluaran tulis: (['x↵'] x rawak panjang).
Keluaran tulis: (['y↵'] y ?? panjang).

