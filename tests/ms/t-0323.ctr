

Atur-cara kemaskan.


>> Veggy := Objek baharu.
Veggy apabila: ['baharu'] lakukan: {
	>> v := diri baharu.
	v init. <- v.
}.

Veggy apabila: ['init'] lakukan: { milik veggies := 0. }.

Veggy apabila: ['carrots:'] lakukan: { :a milik veggies := a. <- Tiada. }.
Veggy apabila: ['carrots'] lakukan: { <- milik veggies. }.
Veggy apabila: ['+'] lakukan: { :f
	>> n := Veggy baharu.
	n carrots: (f carrots + milik veggies). <- n.
}.

Veggy apabila: ['teks'] lakukan: { <- milik veggies teks.
}.

Nombor apabila: ['carrots'] lakukan: {
	>> x := Veggy baharu.
	x carrots: diri. <- x.
}.

Nombor apabila: ['add:and:'] lakukan: { :a :b <- (a + b).
}.

>> q := 0 add: (3 carrots + 2 carrots) and: 4 carrots.
Keluaran tulis: q, baris-baharu.
