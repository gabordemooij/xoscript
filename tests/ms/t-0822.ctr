# parameter yang kurang daripada pemegang tempat mesti memberi ralat, bukan membaca melepasi pengikatan
Server init.

>> pd := Maria-DB baharu hos: ['localhost'],
	nama-pengguna: ['xo'],
	kata-laluan: ['pass123'],
	nama-pangkalan-data: ['xobase'],
	sambung.

>> parameter-carian := pd pertanyaan: ['SELECT ? AS a, ? AS b, ? AS c'].
parameter-carian parameter: (Senarai baharu ; ['1']).
{ parameter-carian dapatkan: { :barisan Keluaran tulis: barisan, baris-baharu. }. } tangkap: { :e Keluaran tulis: e, baris-baharu. }, mula.

>> parameter-carian := pd pertanyaan: ['SELECT ? AS a'].
{ parameter-carian dapatkan: { :barisan Keluaran tulis: barisan, baris-baharu. }. } tangkap: { :e Keluaran tulis: e, baris-baharu. }, mula.

# bilangan yang betul masih berfungsi, parameter tambahan diabaikan seperti sebelum ini
>> parameter-carian := pd pertanyaan: ['SELECT ? AS a, ? AS b'].
parameter-carian parameter: (Senarai baharu ; ['1'] ; ['2']).
parameter-carian dapatkan: { :barisan Keluaran tulis: (barisan di: ['a']), tulis: (barisan di: ['b']), baris-baharu. }.
parameter-carian parameter: (Senarai baharu ; ['1'] ; ['2'] ; ['3']).
parameter-carian dapatkan: { :barisan Keluaran tulis: (barisan di: ['a']), tulis: (barisan di: ['b']), baris-baharu. }.
