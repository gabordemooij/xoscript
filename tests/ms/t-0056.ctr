>> z := Objek baharu.
z apabila: ['value:'] lakukan: { :v
	milik value := v. <- diri.
}.
z apabila: ['value'] lakukan: { <- milik value. }.
(z setValue: 1) value: 2.
Keluaran tulis: z value.
>> x := z.
Keluaran tulis: x value.
z := Tiada.
Keluaran tulis: z value.
Keluaran tulis: x value.
Keluaran tulis: ['hello'].
Keluaran tulis: 3 + 2.
Keluaran tulis: (3 > 2).
