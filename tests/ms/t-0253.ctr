#Linux
>> OS := Atur-cara tetapan: ['OS'].

>> jam-dinding := Detik baharu.
	
(OS = ['Haiku']) benar: {
	jam-dinding zon: ['CET'],
	tahun: 2017, bulan: 7, hari: 13,
	jam: 18, minit: 0, saat: 0.
}, jika-tidak: {
	jam-dinding zon: ['Europe/Amsterdam'],
	tahun: 2017, bulan: 7, hari: 13,
	jam: 18, minit: 0, saat: 0.
}.

jam-dinding apabila: ['beritahu'] lakukan: {
	Keluaran tulis: diri, baris-baharu.
}.


jam-dinding tambah: 2    jam, beritahu.
jam-dinding tambah: 1    jam, beritahu.
jam-dinding tambah: 19 minit, beritahu.
jam-dinding tambah: 1  minit, beritahu.
jam-dinding tambah: 1  minit, beritahu.
jam-dinding tambah: 19 saat, beritahu.
jam-dinding tambah: 1  saat, beritahu.
jam-dinding tambah: 1  saat, beritahu.
jam-dinding tambah: 2    tahun, beritahu.
jam-dinding tambah: 1    tahun, beritahu.

(OS = ['Haiku']) benar: {
jam-dinding tambah: 5   bulan.
jam-dinding zon: ['CEST'], beritahu.
}, jika-tidak: {
	jam-dinding tambah: 5   bulan, beritahu.
}.

jam-dinding tambah: 1   bulan, beritahu.
jam-dinding tambah: 19    hari, beritahu.
jam-dinding tambah: 1    jam, beritahu.
jam-dinding tambah: 120  ela, beritahu.
