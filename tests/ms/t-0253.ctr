#Linux
>> OS := Atur-cara tetapan: ['OS'].

>> clock := Detik baharu.
	
(OS = ['Haiku']) benar: {
	clock zon: ['CET'],
	tahun: 2017, bulan: 7, hari: 13,
	jam: 18, minit: 0, saat: 0.
}, jika-tidak: {
	clock zon: ['Europe/Amsterdam'],
	tahun: 2017, bulan: 7, hari: 13,
	jam: 18, minit: 0, saat: 0.
}.

clock apabila: ['tell'] lakukan: {
	Keluaran tulis: diri, baris-baharu.
}.


clock tambah: 2    jam, tell.
clock tambah: 1    jam, tell.
clock tambah: 19 minit, tell.
clock tambah: 1  minit, tell.
clock tambah: 1  minit, tell.
clock tambah: 19 saat, tell.
clock tambah: 1  saat, tell.
clock tambah: 1  saat, tell.
clock tambah: 2    tahun, tell.
clock tambah: 1    tahun, tell.

(OS = ['Haiku']) benar: {
clock tambah: 5   bulan.
clock zon: ['CEST'], tell.
}, jika-tidak: {
	clock tambah: 5   bulan, tell.
}.

clock tambah: 1   bulan, tell.
clock tambah: 19    hari, tell.
clock tambah: 1    jam, tell.
clock tambah: 120  yard, tell.
