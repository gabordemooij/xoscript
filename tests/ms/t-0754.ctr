Keluaran tulis: ['Objek ujian'], baris-baharu.
>> a := Objek baharu. 

a apabila: ['item:'] lakukan: { :klr
	milik klr := klr. 
}.

a apabila: ['barang'] lakukan: {
	<- milik klr.
}.

a apabila: ['sapa'] lakukan: {
	Keluaran tulis: ['hai dari keluaran asal!'], baris-baharu.
}.

a item: Keluaran.

Keluaran tulis: a barang, baris-baharu.

>> alamat-lama-klr := a barang prototaip alamat-ingatan.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== MEMUAT SEMULA SNAP:'], baris-baharu.

>> b := Objek load-from: ['/tmp/a.bin'].

(b barang prototaip alamat-ingatan = alamat-lama-klr) benar: {
	Keluaran tulis: ['Pautan objek dipasang semula.'], baris-baharu.
}.

b barang tulis: ['helo dari keluaran yang dimuat!'], baris-baharu.
b sapa.
