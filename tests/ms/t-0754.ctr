Keluaran tulis: ['Test object'], baris-baharu.
>> a := Objek baharu. 

a apabila: ['item:'] lakukan: { :out
	milik out := out. 
}.

a apabila: ['item'] lakukan: { <- milik out.
}.

a apabila: ['greet'] lakukan: {
	Keluaran tulis: ['hi from original out!'], baris-baharu.
}.

a item: Keluaran.

Keluaran tulis: a item, baris-baharu.

>> old-out-address := a item prototaip alamat-ingatan.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baharu.

>> b := Objek load-from: ['/tmp/a.bin'].

(b item prototaip alamat-ingatan = old-out-address) benar: {
	Keluaran tulis: ['Object link re-attached.'], baris-baharu.
}.

b item tulis: ['hello from loaded out!'], baris-baharu.
b greet.
