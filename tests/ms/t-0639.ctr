
Server init.
Keluaran tulis: ['Database test'], baris-baharu.

>> db := Maria-DB baharu hos: ['localhost'],
	nama-pengguna: ['xo'], 
	kata-laluan: ['pass123'],
	nama-pangkalan-data: ['xobase'],
	sambung.

>> parameter-carian :=
db pertanyaan: ['SELECT REPEAT('Blah',1000) AS blah'], 
dapatkan: { :row 
	Keluaran tulis: row blah panjang, baris-baharu.
}.
