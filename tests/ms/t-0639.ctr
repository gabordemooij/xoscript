
Server init.
Keluaran tulis: ['Ujian pangkalan data'], baris-baharu.

>> pd := Maria-DB baharu hos: ['localhost'],
	nama-pengguna: ['xo'], 
	kata-laluan: ['pass123'],
	nama-pangkalan-data: ['xobase'],
	sambung.

>> parameter-carian :=
pd pertanyaan: ['SELECT REPEAT('Blah',1000) AS blah'], 
dapatkan: { :barisan 
	Keluaran tulis: barisan blah panjang, baris-baharu.
}.
