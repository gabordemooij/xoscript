# uji operasi senarai


>> kek-kek := Senarai ←
	['apple'] ;
	['beri'] ;
	['coklat'] ;
	['keju'].


>> beli := kek-kek ganti: 1 panjang: 2 dengan: ( Senarai ← ['kayu manis'] ; ['nanas'] ).
Keluaran tulis: (beli gabungkan: [',']), baris-baharu.


>> beli := kek-kek ganti: 1 panjang: 12 dengan: ( Senarai ← ['kayu manis'] ; ['nanas'] ).
Keluaran tulis: (beli gabungkan: [',']), baris-baharu.


>> beli := kek-kek ganti: 2 panjang: 10 dengan: ( Senarai baharu ).
Keluaran tulis: (beli gabungkan: [',']), baris-baharu.


>> beli := kek-kek ganti: 0 panjang: 1 dengan: ( Senarai baharu ).
Keluaran tulis: (beli gabungkan: [',']), baris-baharu.


>> beli := kek-kek ganti: ['0'] panjang: ['1'] dengan: ['x'].
Keluaran tulis: (beli gabungkan: [',']), baris-baharu.
