>> x := [' hallo '].

>> y := x huruf-besar.
Keluaran tulis: x, baris-baharu.
Keluaran tulis: (x sama-dengan: y), baris-baharu.

>> y := x huruf-kecil.
Keluaran tulis: x, baris-baharu.
Keluaran tulis: (x sama-dengan: y), baris-baharu.

>> y := x pangkas.
Keluaran tulis: x, baris-baharu.
Keluaran tulis: (x sama-dengan: y), baris-baharu.

>> y := x langkau: 1.
Keluaran tulis: x, baris-baharu.
Keluaran tulis: (x sama-dengan: y), baris-baharu.

>> y := x dari: 1 panjang: 2.
Keluaran tulis: x, baris-baharu.
Keluaran tulis: (x sama-dengan: y), baris-baharu.