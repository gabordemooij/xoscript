Keluaran tulis: ['Objek ujian'], baris-baharu.
>> penyapa := Objek baharu.
penyapa apabila: ['name:'] lakukan: { :nama
	milik xnama := nama. 
}.
penyapa apabila: ['sapa'] lakukan: {
	Keluaran tulis: ['Helo '] + milik xnama, baris-baharu.
}.
penyapa name: ['Sherlock'].
penyapa save-as: ['/tmp/a.bin'].
penyapa save-as: ['/tmp/b.bin'].
Keluaran tulis: ['========== MEMUAT SEMULA SNAP:'], baris-baharu.
>> b := Objek load-from: ['/tmp/a.bin'].
>> c := Objek load-from: ['/tmp/b.bin'].
b sapa.
b name: ['Watson'], sapa.
c name: ['Moriarty'], sapa.
