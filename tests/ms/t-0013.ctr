
>> Animal := Objek baharu.
Animal apabila: ['baharu'] lakukan: { <- diri baharu init.
}.

Animal apabila: ['init'] lakukan: {
	milik sound := ['?'].
	milik legs := 4.
}.

>> Dog := Animal baharu.
Dog apabila: ['init'] lakukan: {
	diri init.
	milik sound := ['barks'].
}.

Animal apabila: ['teks'] lakukan: { <- milik legs teks + milik sound.
}.

>> poodle := Dog baharu.
Keluaran tulis: poodle, baris-baharu.

