
>> Haiwan := Objek baharu.
Haiwan apabila: ['baharu'] lakukan: {
	<- diri baharu init.
}.

Haiwan apabila: ['init'] lakukan: {
	milik bunyi := ['?'].
	milik kaki  := 4.
}.

>> Anjing := Haiwan baharu.
Anjing apabila: ['init'] lakukan: {
	diri init.
	milik bunyi := ['menyalak'].
}.

Haiwan apabila: ['teks'] lakukan: {
	<- milik kaki teks + milik bunyi.
}.

>> pudel := Anjing baharu.
Keluaran tulis: pudel, baris-baharu.

