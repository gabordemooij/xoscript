>> randomizer := { :a :b
	>> minimum := ( a < b ) pilih: a atau: b.
	>> maksimum := ( a > b ) pilih: a atau: b.
	>> x := Tiada.
	{
		x := Nombor antara: a dan: b.
		((x < minimum) atau: (x > maksimum)) benar: { 
			Keluaran tulis: (['Invalid value!']).
			Atur-cara tamat.
		}.
	} 
	× 100. <- x.
}.
