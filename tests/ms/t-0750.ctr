Keluaran tulis: ['Test object'], baris-baharu.
>> a := Objek baharu. 

a apabila: ['item:'] lakukan: { :nil
	milik nil := nil. 
}.

a apabila: ['item'] lakukan: { <- milik nil.
}.

a item: Tiada.

Keluaran tulis: a item, baris-baharu.

>> old-nil-address := a item prototaip alamat-ingatan.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baharu.

>> b := Objek load-from: ['/tmp/a.bin'].

(b item prototaip alamat-ingatan = old-nil-address) benar: {
	Keluaran tulis: ['Object link re-attached.'], baris-baharu.
}.

Keluaran tulis: b item, baris-baharu.
