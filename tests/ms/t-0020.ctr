(Tiada = Tiada) benar: { Keluaran tulis: ['Nil is Nil!'].}.
(2 > 1) benar: { Keluaran tulis: ['YES']. }.
(2 > 3) benar: { Keluaran tulis: ['NO']. }.
(2 > 3) palsu: { Keluaran tulis: ['Nonono..'].}.
Benar benar: { Keluaran tulis: ['TRUE is TRUE!']. }.
(Benar) benar: { Keluaran tulis: ['TRUE is TRUE!']. }.
Palsu palsu: { Keluaran tulis: ['FALSE is FALSE!']. }.
(Palsu) palsu: { Keluaran tulis: ['FALSE is FALSE!']. }.
