['Ribuan dan perpuluhan'].

>> x := 100000000.5.
>> y := 100000000.5.

Keluaran tulis: (x + y), baris-baharu.

>> x := 10040.07.
>> y := 10305.60.

Keluaran tulis: (x + y), baris-baharu.

['Perpuluhan'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Keluaran tulis: (x + y + z), baris-baharu.

['Pelik tetapi sah'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Keluaran tulis: (x + y + z), baris-baharu.

>> q := 0.1.2.

Keluaran tulis: (q), baris-baharu.

>> q := 012.

Keluaran tulis: (q), baris-baharu.
