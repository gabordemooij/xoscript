Keluaran tulis: ['Test object'], baris-baharu.
>> a := Objek baharu. 
a apabila: ['item:'] lakukan: { :int64
	milik int64 := int64. 
}.
a apabila: ['item'] lakukan: { <- milik int64.
}.
a item: ( Int64 daripada-teks: ['9999'] ).
Keluaran tulis: a item, baris-baharu.
>> old-int64-address := a item prototaip alamat-ingatan.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baharu.
>> b := Objek load-from: ['/tmp/a.bin'].
(b item prototaip alamat-ingatan = old-int64-address) benar: {
	Keluaran tulis: ['Object link re-attached.'], baris-baharu.
}.
Keluaran tulis: ( b item ), baris-baharu.
