Server init.

Keluaran tulis: (
	Corak baharu: ['^\\w+$'],
	padan: ['test@example.com'] 
), baris-baharu. # 0 padanan, gagal pada @ dan .

Keluaran tulis: (
	Corak baharu: ['^[^@]+@[^\.]+\.\\w+$'],
	padan: ['test@example.com'] 
), baris-baharu. # 1 padanan

Keluaran tulis: (
	Corak baharu: ['[^@]+@[^\.]+\.\\w+'],
	padan: ['test@example.com'] 
), baris-baharu. # 1 padanan

Keluaran tulis: (
	Corak baharu: ['([^@]+)@([^\.]+)\.\\w+'],
	padan: ['test@example.com'] 
), baris-baharu. # 1 padanan, kumpulan tidak penting

Keluaran tulis: (
	Corak baharu: ['[a-z]'],
	padan: ['test@example.com'] 
), baris-baharu. # 14 padanan

Keluaran tulis: (
	Corak baharu: ['.*'],
	padan: ['test@example.com'] 
), baris-baharu. # 1 padanan (semua)

Keluaran tulis: (
	Corak baharu: ['(.*)'],
	padan: ['test@example.com'] 
), baris-baharu. # 1 padanan (semua)

Keluaran tulis: (
	Corak baharu: ['\\s*[^@]+@[^\.]+\.\\w+'],
	padan: ['test@example.com'] 
), baris-baharu. # 1 padanan, ruang awalan adalah pilihan, diabaikan