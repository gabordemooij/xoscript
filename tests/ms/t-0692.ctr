Server init.

Keluaran tulis: (
	Corak baharu: ['^\\w+$'],
	padan: ['test@example.com'] 
), baris-baharu. # 0 match, fails on @ and .

Keluaran tulis: (
	Corak baharu: ['^[^@]+@[^\.]+\.\\w+$'],
	padan: ['test@example.com'] 
), baris-baharu. # 1 match

Keluaran tulis: (
	Corak baharu: ['[^@]+@[^\.]+\.\\w+'],
	padan: ['test@example.com'] 
), baris-baharu. # 1 match

Keluaran tulis: (
	Corak baharu: ['([^@]+)@([^\.]+)\.\\w+'],
	padan: ['test@example.com'] 
), baris-baharu. # 1 match, groups dont matter

Keluaran tulis: (
	Corak baharu: ['[a-z]'],
	padan: ['test@example.com'] 
), baris-baharu. # 14 matches

Keluaran tulis: (
	Corak baharu: ['.*'],
	padan: ['test@example.com'] 
), baris-baharu. # 1 match (all)

Keluaran tulis: (
	Corak baharu: ['(.*)'],
	padan: ['test@example.com'] 
), baris-baharu. # 1 match (all)

Keluaran tulis: (
	Corak baharu: ['\\s*[^@]+@[^\.]+\.\\w+'],
	padan: ['test@example.com'] 
), baris-baharu. # 1 match, prefix space optional, gets ignored