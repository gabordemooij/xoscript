>> items := Kamus baharu.
items letak: ['black'] di: ['coffee'], letak: ['earl grey'] di: ['tea'].
Keluaran tulis: (items di: ['coffee']), tulis: (items di: ['tea']).
Keluaran tulis: ['there are'] + items bilangan + [' items in the array.'].
items letak: ['capuccino'] di: ['coffee'].
Keluaran tulis: ['Now my coffee is.. '] + (items di: ['coffee']).
items letak: ['aaa'] di: ['1'].
items letak: ['bbb'] di: ['2'].
Keluaran tulis: (items di: ['a']).
