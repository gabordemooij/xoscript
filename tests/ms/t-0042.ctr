>> items := Kamus baharu.
items letak: ['hitam'] di: ['coffee'], letak: ['earl grey'] di: ['teh'].
Keluaran tulis: (items di: ['coffee']), tulis: (items di: ['teh']).
Keluaran tulis: ['ada'] + items bilangan + [' item dalam tatasusunan.'].
items letak: ['capuccino'] di: ['coffee'].
Keluaran tulis: ['Sekarang kopi saya ialah.. '] + (items di: ['coffee']).
items letak: ['aaa'] di: ['1'].
items letak: ['bbb'] di: ['2'].
Keluaran tulis: (items di: ['a']).
