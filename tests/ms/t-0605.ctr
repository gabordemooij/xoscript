>> invois := Objek baharu.
invois apabila: ['mula'] lakukan: {
        milik nombor := 0.
}.

invois apabila: ['nombor'] lakukan: {
        milik nombor tambah: 1.
        <- milik nombor salin.
}.

>> invois-tahunan := invois baharu.
invois-tahunan apabila: ['start:'] lakukan: { :tahun
	milik nombor := tahun.
}.

invois-tahunan start: 202000.
Keluaran tulis: invois-tahunan nombor, baris-baharu.
Keluaran tulis: invois-tahunan nombor, baris-baharu.
