>> invoice := Objek baharu.
invoice apabila: ['mula'] lakukan: {
        milik nombor := 0.
}.

invoice apabila: ['nombor'] lakukan: {
        milik nombor tambah: 1. <- milik nombor salin.
}.

>> year-invoice := invoice baharu.
year-invoice apabila: ['start:'] lakukan: { :tahun
	milik nombor := tahun.
}.

year-invoice start: 202000.
Keluaran tulis: year-invoice nombor, baris-baharu.
Keluaran tulis: year-invoice nombor, baris-baharu.
