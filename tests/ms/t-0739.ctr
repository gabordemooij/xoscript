Keluaran tulis: ['Objek ujian'], baris-baharu.
>> a := Objek baharu. 

a apabila: ['item:'] lakukan: { :pembantubin
	milik pembantubin := pembantubin. 
}.

a apabila: ['barang'] lakukan: {
	<- milik pembantubin.
}.

a item: Bin baharu.

>> alamat-lama-pembantubin := a barang prototaip alamat-ingatan.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== MEMUAT SEMULA SNAP:'], baris-baharu.

>> b := Objek load-from: ['/tmp/a.bin'].

(b barang prototaip alamat-ingatan = alamat-lama-pembantubin) benar: {
	Keluaran tulis: ['Pautan objek dipasang semula.'], baris-baharu.
}.


