Keluaran tulis: ['Test object'], baris-baharu.
>> a := Objek baharu. 

a apabila: ['item:'] lakukan: { :binhelper
	milik binhelper := binhelper. 
}.

a apabila: ['item'] lakukan: { <- milik binhelper.
}.

a item: Bin baharu.

>> old-binhelper-address := a item prototaip alamat-ingatan.
a save-as: ['/tmp/a.bin'].
Keluaran tulis: ['========== RELOADING SNAP:'], baris-baharu.

>> b := Objek load-from: ['/tmp/a.bin'].

(b item prototaip alamat-ingatan = old-binhelper-address) benar: {
	Keluaran tulis: ['Object link re-attached.'], baris-baharu.
}.


