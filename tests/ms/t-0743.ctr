>> V := Objek.
V apabila: ['teks'] lakukan: {
	Keluaran tulis: ['tukar jenis'], baris-baharu.
	<- ['abc'].
}.

Keluaran tulis: ( Atur-cara tetapan: ['abc'] ), baris-baharu.

# params tidak sepatutnya di-gc
Atur-cara tetapan: ([''] + V baharu) nilai: ([''] + V baharu).

Keluaran tulis: ( Atur-cara tetapan: ['abc'] ), baris-baharu.
