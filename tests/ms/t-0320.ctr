


>> CoffeeMachine := Objek baharu.
CoffeeMachine apabila: ['order:'] lakukan: { :id
	>> coffee := ['Americano'].
	( id = 1 ) benar: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) benar: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) benar: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Objek baharu.
SimpleCoffeeMachine apabila: ['order'] lakukan: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Keluaran tulis: redCup, baris-baharu.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Keluaran tulis: greenCup, baris-baharu.
>> yellowCup := CoffeeMachine order: 1.
Keluaran tulis: yellowCup, baris-baharu.
>> blueCup := CoffeeMachine order: 0.
Keluaran tulis: blueCup, baris-baharu.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Keluaran tulis: blackCup, baris-baharu.
blackCup tambah-di-hujung: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Keluaran tulis: orangeCup, baris-baharu.
