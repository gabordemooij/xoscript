


>> MesinKopi := Objek baharu.
MesinKopi apabila: ['order:'] lakukan: { :id
	>> coffee := ['Americano'].
	( id = 1 ) benar: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) benar: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) benar: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> MesinKopiRingkas := Objek baharu.
MesinKopiRingkas apabila: ['tempahan'] lakukan: { <- ['Hitam']. }.
>> cawanMerah := MesinKopi order: 1.
Keluaran tulis: cawanMerah, baris-baharu.
cawanMerah := ['Teh']. 
>> cawanHijau := MesinKopi order: 0.
Keluaran tulis: cawanHijau, baris-baharu.
>> cawanKuning := MesinKopi order: 1.
Keluaran tulis: cawanKuning, baris-baharu.
>> cawanBiru := MesinKopi order: 0.
Keluaran tulis: cawanBiru, baris-baharu.
>> cawanPlastik := MesinKopiRingkas tempahan.
cawanPlastik := ['Limau']. 
>> cawanHitam := MesinKopiRingkas tempahan.
Keluaran tulis: cawanHitam, baris-baharu.
cawanHitam tambah-di-hujung: [' tidakkk.... bir. '].
>> cawanOren := MesinKopiRingkas tempahan.
Keluaran tulis: cawanOren, baris-baharu.
