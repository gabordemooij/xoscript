
Nombor pelajari: ['plus:'] bermaksud: ['+'].
Nombor apabila: ['+'] lakukan: { :x
	>> rate := 1.
	>> currency := x unit.
	(currency = ['euros']) benar: {
		rate := 2.
	}. <- (diri plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars beri-unit: ['dollars'].
euros beri-unit: ['euros'].
>> money := dollars + euros.
Keluaran tulis: money, baris-baharu.
