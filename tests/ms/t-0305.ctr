
Nombor pelajari: ['plus:'] bermaksud: ['+'].
Nombor apabila: ['+'] lakukan: { :x
	>> kadar := 1.
	>> mata-wang := x unit.
	(mata-wang = ['euros']) benar: {
		kadar := 2.
	}. <- (diri plus: (x × kadar)).
}.
>> dolar := 3.
>> euros := 2.
dolar beri-unit: ['dollars'].
euros beri-unit: ['euros'].
>> wang := dolar + euros.
Keluaran tulis: wang, baris-baharu.
