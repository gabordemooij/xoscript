Nombor apabila: ['faktorial'] lakukan: {
	>> jumlah := 1.
	{ :indeks jumlah darab-dengan: (diri - (indeks)). } × diri. <- jumlah.
}.
>> Pencetak := Objek baharu.
Pencetak apabila: ['cetak:dan:'] lakukan: { :x :y
	Keluaran tulis: ['a='] + x + [', b='] + y, baris-baharu.
}.
>> a := 4.5. >> b := a bundar-ke-bawah.
Pencetak cetak: a dan: b.
