Nombor apabila: ['factorial'] lakukan: {
	>> total := 1.
	{ :index total darab-dengan: (diri - (index)). } × diri. <- total.
}.
>> Printer := Objek baharu.
Printer apabila: ['print:and:'] lakukan: { :x :y
	Keluaran tulis: ['a='] + x + [', b='] + y, baris-baharu.
}.
>> a := 4.5. >> b := a bundar-ke-bawah.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a bundar-ke-atas.
Printer print: a and: b.
a := 4.5. b := a bundar-ke-bawah.
Printer print: a and: b.
a := 4.5. b := a bundarkan.
Printer print: a and: b.
a := 4.2. b := a bundarkan.
Printer print: a and: b.

Keluaran tulis: (9 baki-bahagi: 5), baris-baharu.
Keluaran tulis: -666 mutlak, baris-baharu.
Keluaran tulis: 49 punca-kuasa-dua, baris-baharu.
Keluaran tulis: (2 kuasa: 3), baris-baharu.
>> l := (Senarai ← 9 ; 6).
Keluaran tulis: l minimum.

