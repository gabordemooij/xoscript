
>> a := Senarai ← (Senarai ← 100 ; 200 ; 300) ; (Senarai ← 9 ; 8 ; 7).
Keluaran tulis: ['pada 0,1 :'].
Keluaran tulis: a ? 0 ? 1, baris-baharu. 
Keluaran tulis: ['pada 1,2 :'].
Keluaran tulis: a ? 1 ? 2, baris-baharu. 
>> menu := Kamus baharu.
menu letak: (Senarai ← ['piza'] ; ['spageti']) di: ['Masakan Itali'].
menu letak: (Senarai ← ['bifteki'] ; ['suflaki']) di: ['Masakan Greek'].
Keluaran tulis: ['Saya suka '] + (menu ? ['Masakan Greek'] ? 0) + [' dan '] + (menu ? ['Masakan Itali'] ? 1), baris-baharu. 
Keluaran tulis: ['tetapi bukan di pinggan yang sama.'], baris-baharu.
