
>> a := Senarai ← (Senarai ← 100 ; 200 ; 300) ; (Senarai ← 9 ; 8 ; 7).
Keluaran tulis: ['at 0,1 :'].
Keluaran tulis: a ? 0 ? 1, baris-baharu. 
Keluaran tulis: ['at 1,2 :'].
Keluaran tulis: a ? 1 ? 2, baris-baharu. 
>> menu := Kamus baharu.
menu letak: (Senarai ← ['pizza'] ; ['spaghetti']) di: ['Italian Cuisine'].
menu letak: (Senarai ← ['bifteki'] ; ['suflaki']) di: ['Greek Cuisine'].
Keluaran tulis: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), baris-baharu. 
Keluaran tulis: ['but not on the same plate.'], baris-baharu.
