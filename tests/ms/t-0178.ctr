

>> ingatanDigunakan1 := 0.
>> ingatanDigunakan2 := 0.
>> ingatanDigunakan3 := 0.
>> ingatanDigunakan4 := 0.

Atur-cara pengurusan-ingatan: 0.

>> txt := ['Word Salad'].
Keluaran tulis: ['indeks terakhir ord = '] + (( txt kedudukan-terakhir: ['ord'] ) - 0), baris-baharu.
Keluaran tulis: ['indeks ord = '] + (( txt cari: ['ord'] ) - 0), baris-baharu.
Keluaran tulis: ['indeks ad = '] + (( txt cari: ['ad'] ) - 0), baris-baharu.
Keluaran tulis: ['indeks terakhir W = '] + (( txt kedudukan-terakhir: ['W'] ) - 0), baris-baharu.
Keluaran tulis: ['indeks terakhir d = '] + (( txt kedudukan-terakhir: ['d'] ) - 0), baris-baharu.
Keluaran tulis: ['tks sama dengan Word Salad = '] + ( txt = ['Word Salad'] ), baris-baharu.
Keluaran tulis: ['tks sama dengan Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), baris-baharu.
Keluaran tulis: ['tks tidak sama dengan Word Salad = '] + ( txt ≠ ['Word Salad'] ), baris-baharu.
Keluaran tulis: ['tks tidak sama dengan Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), baris-baharu.

Atur-cara kemaskan.

ingatanDigunakan1 := (Atur-cara ingatan ? 0).


