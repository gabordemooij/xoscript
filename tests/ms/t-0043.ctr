>> pengulang := Objek baharu.
pengulang apabila: ['balas:'] lakukan: { :apa
	Keluaran tulis: apa + [' '].
}.
pengulang apabila: ['balas:dan:'] lakukan: { :apa :say
	Keluaran tulis: apa, tulis: say + [' '].
}.
pengulang apabila: ['balas:dan:dan:'] lakukan: { :apa :say :lagi
	Keluaran tulis: apa, tulis: say, tulis: lagi.
}.
pengulang ulang.
pengulang everything: ['Saya kata.'].
pengulang and: ['I '] everything: ['lakukan.'].
