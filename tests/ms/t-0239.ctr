Senarai apabila: ['jumlahkan'] lakukan: {
	>> jumlah := 0.
	diri setiap: { :indeks :unsur
		jumlah tambah: unsur.
	}. <- jumlah.
}.

>> a := Benar.



a apabila: ['teks'] lakukan: {
	>> jawapan := Tiada.
	( diri = Benar ) benar: {
		jawapan := ['Yup'].
	}, jika-tidak: {
		jawapan := ['Tak'].
	}. <- jawapan.
}.

a apabila: ['nombor'] lakukan: {
	>> jawapan := Tiada.
	( diri = Benar ) benar: {
		jawapan := 10.
	}, jika-tidak: {
		jawapan := 20.
	}. <- jawapan.
}.

>> b := 666.

b apabila: ['teks'] lakukan: { <- ['Syaitan'].
}.

b apabila: ['boolean'] lakukan: { <- Palsu.
}.


Keluaran tulis: a, baris-baharu.  
Keluaran tulis: (90 + a), baris-baharu. 
Keluaran tulis: b, baris-baharu. 
Keluaran tulis: (Benar dan: b), baris-baharu.

a := Senarai ← ['hello'] ; ['world'] ; Benar ; Tiada ; 666. 
a := a + ( Senarai ← 1 ).
Keluaran tulis: a, baris-baharu.
Keluaran tulis: ((Kamus baharu) letak: Tiada di: Tiada), baris-baharu.
Keluaran tulis: a jumlahkan, baris-baharu. 


{
	a apabila: ['teks'] lakukan: { <- Tiada. }.
	a := [''] + a.
} tangkap: { :kesilapan
	Keluaran tulis: ['Ralat dicatat: '] + kesilapan, baris-baharu.
}, mula.



{
	a apabila: ['nombor'] lakukan: { <- Tiada. }.
	a := 3 × a.
} tangkap: { :kesilapan
	Keluaran tulis: ['Ralat dicatat: '] + kesilapan, baris-baharu.
}, mula.


{
	a apabila: ['boolean'] lakukan: { <- Tiada. }.
	a := Benar dan: a. 
} tangkap: { :kesilapan
	Keluaran tulis: ['Ralat dicatat: '] + kesilapan, baris-baharu.
}, mula.





