Senarai apabila: ['sum'] lakukan: {
	>> total := 0.
	diri setiap: { :index :element
		total tambah: element.
	}. <- total.
}.

>> a := Benar.



a apabila: ['teks'] lakukan: {
	>> answer := Tiada.
	( diri = Benar ) benar: {
		answer := ['Yep'].
	}, jika-tidak: {
		answer := ['Nope'].
	}. <- answer.
}.

a apabila: ['nombor'] lakukan: {
	>> answer := Tiada.
	( diri = Benar ) benar: {
		answer := 10.
	}, jika-tidak: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b apabila: ['teks'] lakukan: { <- ['Devil'].
}.

b apabila: ['boolean'] lakukan: { <- Palsu.
}.


Keluaran tulis: a, baris-baharu.  
Keluaran tulis: (90 + a), baris-baharu. 
Keluaran tulis: b, baris-baharu. 
Keluaran tulis: (Benar dan: b), baris-baharu.

a := Senarai ← ['hello'] ; ['world'] ; Benar ; Tiada ; 666. 
a := a + ( Senarai ← 1 ).
Keluaran tulis: a, baris-baharu.
Keluaran tulis: ((Kamus baharu) letak: Tiada di: Tiada), baris-baharu.
Keluaran tulis: a sum, baris-baharu. 


{
	a apabila: ['teks'] lakukan: { <- Tiada. }.
	a := [''] + a.
} tangkap: { :error
	Keluaran tulis: ['Error noted: '] + error, baris-baharu.
}, mula.



{
	a apabila: ['nombor'] lakukan: { <- Tiada. }.
	a := 3 × a.
} tangkap: { :error
	Keluaran tulis: ['Error noted: '] + error, baris-baharu.
}, mula.


{
	a apabila: ['boolean'] lakukan: { <- Tiada. }.
	a := Benar dan: a. 
} tangkap: { :error
	Keluaran tulis: ['Error noted: '] + error, baris-baharu.
}, mula.





