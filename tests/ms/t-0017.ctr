Nombor apabila: ['factorial'] lakukan: {
	>> total := 1.
	{ :index total darab-dengan: (diri - (index)). } × diri. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Keluaran tulis: a.
>> b := 2 + 3 factorial.
Keluaran tulis: b.
>> c := 3 factorial + 2.
Keluaran tulis: c.
>> d := 2 + (3 factorial).
Keluaran tulis: d.
Keluaran tulis: 2 + 3 factorial + 1.
