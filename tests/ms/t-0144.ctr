



>> CoffeeGrounds := Objek baharu.
CoffeeGrounds apabila: ['extract'] lakukan: { <- ['coffee']. }.

>> CoffeeMachine := Objek baharu.
CoffeeMachine apabila: ['init'] lakukan: {
	milik coffeegrounds := CoffeeGrounds baharu.
}.
CoffeeMachine apabila: ['baharu'] lakukan: { <- CoffeeMachine `new init.
}.

CoffeeMachine apabila: ['makeTea'] lakukan: { <- (milik tealeaves extract). }.
CoffeeMachine apabila: ['makeCoffee'] lakukan: { <- (milik coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine baharu.

Keluaran tulis:
	coffeeDream 
	makeCoffee.

Keluaran tulis:
	coffeeDream 
	makeTea.
