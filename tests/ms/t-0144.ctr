



>> SerbukKopi := Objek baharu.
SerbukKopi apabila: ['ekstrak'] lakukan: { <- ['coffee']. }.

>> MesinKopi := Objek baharu.
MesinKopi apabila: ['init'] lakukan: {
	milik serbukkopi := SerbukKopi baharu.
}.
MesinKopi apabila: ['baharu'] lakukan: { <- MesinKopi `new init.
}.

MesinKopi apabila: ['buatTeh'] lakukan: { <- (milik daunteh ekstrak). }.
MesinKopi apabila: ['buatKopi'] lakukan: { <- (milik serbukkopi ekstrak). }.

>> impianKopi := MesinKopi baharu.

Keluaran tulis:
	impianKopi 
	buatKopi.

Keluaran tulis:
	impianKopi 
	buatTeh.
