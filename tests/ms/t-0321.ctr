# test qualifiers

Atur-cara kemaskan.

>> Fruit := Objek baharu.
Fruit apabila: ['baharu'] lakukan: {
	>> f := diri baharu.
	f apples: 0. <- f.
}.
Fruit apabila: ['apples:'] lakukan: { :a milik apples := a. }.
Fruit apabila: ['apples'] lakukan: { <- milik apples. }.
Fruit apabila: ['+'] lakukan: { :f
	>> n := Fruit baharu.
	n apples: (f apples + milik apples). <- n.
}.
Nombor apabila: ['apples'] lakukan: { <- ((Fruit baharu) apples: diri).
}.

Fruit apabila: ['teks'] lakukan: { <- milik apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Keluaran tulis: q, baris-baharu.




q := 3 apples + 4 apples.
Keluaran tulis: q, baris-baharu.



q := 3 apples + 4 apples.
Keluaran tulis: q, baris-baharu.


