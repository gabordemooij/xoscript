# uji unit

Atur-cara kemaskan.

>> Buah := Objek baharu.
Buah apabila: ['baharu'] lakukan: {
	>> f := diri baharu.
	f apples: 0. <- f.
}.
Buah apabila: ['apples:'] lakukan: { :a milik epal := a. }.
Buah apabila: ['epal'] lakukan: { <- milik epal. }.
Buah apabila: ['+'] lakukan: { :f
	>> n := Buah baharu.
	n apples: (f epal + milik epal). <- n.
}.
Nombor apabila: ['epal'] lakukan: { <- ((Buah baharu) apples: diri).
}.

Buah apabila: ['teks'] lakukan: { <- milik epal + [' epal '].
}.

>> q := 3 epal + 4 epal.
Keluaran tulis: q, baris-baharu.




q := 3 epal + 4 epal.
Keluaran tulis: q, baris-baharu.



q := 3 epal + 4 epal.
Keluaran tulis: q, baris-baharu.


