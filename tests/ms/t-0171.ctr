

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Atur-cara pengurusan-ingatan: 0.

>> a := Senarai ← ['hello'] ; ['world'] ; Benar ; Tiada ; 666.
a lakukan ambil-terakhir ambil-pertama tambah-di-depan: ['hi'], tambah-di-hujung: 999, selesai.
Keluaran tulis: ( a gabungkan: [','] ), baris-baharu.

Atur-cara kemaskan.
usedMemory1 := (Atur-cara ingatan ? 0).


a := Senarai ← ['hello'] ; ['world'] ; Benar ; Tiada ; 666.
a ambil-terakhir. a ambil-pertama. a tambah-di-depan: ['hi'], tambah-di-hujung: 999.
Keluaran tulis: ( a gabungkan: [','] ), baris-baharu.


Atur-cara kemaskan.
usedMemory2 := (Atur-cara ingatan ? 0).


a := Senarai ← ['hello'] ; ['world'] ; Benar ; Tiada ; 666.
a lakukan ambil-terakhir ambil-pertama tambah-di-depan: ['hi'], tambah-di-hujung: 999, selesai.
Keluaran tulis: ( a gabungkan: [','] ), baris-baharu.


Atur-cara kemaskan.
usedMemory3 := (Atur-cara ingatan ? 0).



( usedMemory1 = usedMemory2 dan: usedMemory1 = usedMemory3, dan: usedMemory2 = usedMemory3 ) benar: {
	Keluaran tulis: ['No memory leaks here'].
}, palsu: {
	Keluaran tulis: ['Leaking memory...'].
}.
