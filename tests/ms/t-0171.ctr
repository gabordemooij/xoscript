

>> ingatanDigunakan1 := 0.
>> ingatanDigunakan2 := 0.
>> ingatanDigunakan3 := 0.
>> ingatanDigunakan4 := 0.

Atur-cara pengurusan-ingatan: 0.

>> a := Senarai ← ['hello'] ; ['world'] ; Benar ; Tiada ; 666.
a lakukan ambil-terakhir ambil-pertama tambah-di-depan: ['hai'], tambah-di-hujung: 999, selesai.
Keluaran tulis: ( a gabungkan: [','] ), baris-baharu.

Atur-cara kemaskan.
ingatanDigunakan1 := (Atur-cara ingatan ? 0).


a := Senarai ← ['hello'] ; ['world'] ; Benar ; Tiada ; 666.
a ambil-terakhir. a ambil-pertama. a tambah-di-depan: ['hai'], tambah-di-hujung: 999.
Keluaran tulis: ( a gabungkan: [','] ), baris-baharu.


Atur-cara kemaskan.
ingatanDigunakan2 := (Atur-cara ingatan ? 0).


a := Senarai ← ['hello'] ; ['world'] ; Benar ; Tiada ; 666.
a lakukan ambil-terakhir ambil-pertama tambah-di-depan: ['hai'], tambah-di-hujung: 999, selesai.
Keluaran tulis: ( a gabungkan: [','] ), baris-baharu.


Atur-cara kemaskan.
ingatanDigunakan3 := (Atur-cara ingatan ? 0).



( ingatanDigunakan1 = ingatanDigunakan2 dan: ingatanDigunakan1 = ingatanDigunakan3, dan: ingatanDigunakan2 = ingatanDigunakan3 ) benar: {
	Keluaran tulis: ['Tiada kebocoran ingatan di sini'].
}, palsu: {
	Keluaran tulis: ['Ingatan bocor...'].
}.
