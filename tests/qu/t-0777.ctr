#OBSD
>> dirname := [''].
{ dirname yapay-qhepaman: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Programa karacha: command.
Programa chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename yapay-qhepaman: ['YYYYYYYY']. } * 20.
Khipu musuq: filename, qillqay: ['sometext'].
{ Khipu katiray: ['/tmp/'] + dirname. } * 1000.
Lluqsiy qillqay: ['no crash'], sayay.

