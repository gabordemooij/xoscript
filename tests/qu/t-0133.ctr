


>> Deck := Katiray musuq.
Deck patapi: ['print'] ruway: {
        >> len := kikin hayka? - 1.
        { :i
                >> len2 := kikin hayka? - 1.
                Lluqsiy qillqay: ['len: '].
                Lluqsiy qillqay: len, sayay.
                Lluqsiy qillqay: ['len2: '].
                Lluqsiy qillqay: len2, sayay.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
