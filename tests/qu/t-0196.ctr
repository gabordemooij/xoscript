
>> animal := Ima musuq. 
 
 animal patapi: ['name:'] ruway: { :n
ñuqap suti := n.
}. 


animal name: ['Diva']. 
 
animal patapi: ['suti'] ruway: { <- suti.
}.

>> cat := animal musuq.
 
 cat name: ['Diva']. 
 
 cat patapi: ['suti'] ruway: { <- ['your royal highness ']
+ (kikin suti).
}.

Lluqsiy qillqay: cat suti.
