Katiray patapi: ['sum'] ruway: {
	>> total := 0.
	kikin sapallanpaq: { :index :element
		total yapay: element.
	}. <- total.
}.

>> a := Chiqap.



a patapi: ['qillqaman'] ruway: {
	>> answer := Mana.
	( kikin = Chiqap ) chiqapqtin: {
		answer := ['Yep'].
	}, manahinaqa: {
		answer := ['Nope'].
	}. <- answer.
}.

a patapi: ['yupayman'] ruway: {
	>> answer := Mana.
	( kikin = Chiqap ) chiqapqtin: {
		answer := 10.
	}, manahinaqa: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b patapi: ['qillqaman'] ruway: { <- ['Devil'].
}.

b patapi: ['chiqapchaman'] ruway: { <- Llulla.
}.


Lluqsiy qillqay: a, sayay.  
Lluqsiy qillqay: (90 + a), sayay. 
Lluqsiy qillqay: b, sayay. 
Lluqsiy qillqay: (Chiqap wan: b), sayay.

a := Katiray ← ['hello'] ; ['world'] ; Chiqap ; Mana ; 666. 
a := a + ( Katiray ← 1 ).
Lluqsiy qillqay: a, sayay.
Lluqsiy qillqay: ((Simi-taqi musuq) churay: Mana maypi: Mana), sayay.
Lluqsiy qillqay: a sum, sayay. 


{
	a patapi: ['qillqaman'] ruway: { <- Mana. }.
	a := [''] + a.
} hapiy: { :error
	Lluqsiy qillqay: ['Error noted: '] + error, sayay.
}, kallpay.



{
	a patapi: ['yupayman'] ruway: { <- Mana. }.
	a := 3 × a.
} hapiy: { :error
	Lluqsiy qillqay: ['Error noted: '] + error, sayay.
}, kallpay.


{
	a patapi: ['chiqapchaman'] ruway: { <- Mana. }.
	a := Chiqap wan: a. 
} hapiy: { :error
	Lluqsiy qillqay: ['Error noted: '] + error, sayay.
}, kallpay.





{
	a patapi: ['qillqaman'] ruway: { <- Llulla. }.
	a := [''] + a.
} hapiy: { :error
	Lluqsiy qillqay: ['Error noted: '] + error, sayay.
}, kallpay.



{
	a patapi: ['yupayman'] ruway: { <- Chiqap. }.
	a := 3 × a.
} hapiy: { :error
	Lluqsiy qillqay: ['Error noted: '] + error, sayay.
}, kallpay.


{
	a patapi: ['boolean'] ruway: { <- 1. }.
	a := Chiqap wan: a.
} hapiy: { :error
	Lluqsiy qillqay: ['Error noted: '] + error, sayay.
}, kallpay.





