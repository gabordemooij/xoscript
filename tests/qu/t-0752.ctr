Lluqsiy qillqay: ['Test object'], sayay.
>> a := Ima musuq. 

a patapi: ['item:'] ruway: { :chiqapchaman
	ñuqap chiqapchaman := chiqapchaman. 
}.

a patapi: ['item'] ruway: { <- ñuqap chiqapchaman.
}.

a item: Chiqapcha.

Lluqsiy qillqay: a item, sayay.

>> old-bool-address := a item ñawpaq-rikchʼay yuyay-tiyanan.
a save-as: ['/tmp/a.bin'].
Lluqsiy qillqay: ['========== RELOADING SNAP:'], sayay.

>> b := Ima load-from: ['/tmp/a.bin'].

(b item ñawpaq-rikchʼay yuyay-tiyanan = old-bool-address) chiqapqtin: {
	Lluqsiy qillqay: ['Object link re-attached.'], sayay.
}.

Lluqsiy qillqay: b item, sayay.
