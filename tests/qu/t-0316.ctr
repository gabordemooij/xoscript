>> Grandfather := Ima musuq.
Grandfather patapi: ['greet'] ruway: {
	Lluqsiy qillqay: ['Ave!'], sayay.
}.
>> Father := Grandfather musuq.
Father patapi: ['greet'] ruway: {
	Lluqsiy qillqay: ['Hello'], sayay.
	kikin greet.
}.
>> Son := Father musuq.
Son patapi: ['greet'] ruway: {
	Lluqsiy qillqay: ['Hi'], sayay.
	kikin greet.
}.

Son greet.

>> Roundabout := Ima musuq.
Roundabout patapi: ['circle:'] ruway: { :x
	Lluqsiy qillqay: x, sayay.
	(x < 3) chiqapqtin: { kikin kutipari circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) chiqapqtin: { Lluqsiy qillqay: x, sayay. x yapay: 1.  increment kallpay. }. }.
increment kallpay.