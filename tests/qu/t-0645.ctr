Server init.
Lluqsiy qillqay: ['Database date test'], sayay.

>> db := Maria-DB musuq samachiq: ['localhost'],
	ruraqpa-sutin: ['xo'], 
	pakasqa-simi: ['pass123'],
	willay-waqaychanap-sutin: ['xobase'],
	tinkiy.

>> maskana-tupukuna :=
db tapuy: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
apamuy: { :row
	Lluqsiy qillqay: row datetest, sayay.
}.
