>> makeAdder := { :x
	>> f := { :y <- (ñuqap x + y). } churay: ['x'] chanin: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i ñuqap q churay: (ñuqap f rurachiy: (ñuqap q ? i)) maypi: i. } 
	churay: ['q'] chanin: array,
	churay: ['f'] chanin: func.
	{ :i mapping rurachiy: i. } × (array hayka?).
}.

>> a := Katiray ← 1; 2; 3.
mapper rurachiy: a wan: (makeAdder rurachiy: 100).
Lluqsiy qillqay: (a tarikuy: 0), sayay.
Lluqsiy qillqay: (a ? 1), sayay.
Lluqsiy qillqay: (a ? 2), sayay.
