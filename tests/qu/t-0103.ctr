>> a := Katiray ← Ima ; Chiqap ; Llulla ; Chiqapcha ; 1 ; Yupay ; ['Str'] ; Qillqa ; { ['Empty']. }.
Lluqsiy qillqay: (a hayka?), sayay.
{ :i
	Lluqsiy qillqay: 
	['a '] + 
	((a ? i) laya) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Manachu?) kaypas: [''] chaypas: ['NOT']) + 
	[' Nil.'],
	sayay.
} × (a hayka?).
Lluqsiy qillqay: ['but.. Nil is.. '] + ((Mana Manachu?) kaypas: ['certainly NIL!'] chaypas: ['not NIL??']), sayay.