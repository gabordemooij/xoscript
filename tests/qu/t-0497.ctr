Server init.

# write a test file
>> f := Khipu musuq: ['/tmp/test.gif'].
f qillqay: ['GIF87a01234567810'].

# serve the file
Server pasachiy: ['test.gif'] ñawpaq-kʼaskaq: ['/tmp/'].

Lluqsiy sayay.

Lluqsiy qillqay: ['Outside container (security):'], sayay.
{ Server pasachiy: ['../passwd'] ñawpaq-kʼaskaq: ['/tmp/']. }
hapiy: { :e Lluqsiy qillqay: e, sayay. },
kallpay.

Lluqsiy qillqay: ['Invalid prefix:'], sayay.
{ Server pasachiy: ['test.gif'] ñawpaq-kʼaskaq: ['z:\\']. }
hapiy: { :e Lluqsiy qillqay: e, sayay. },
kallpay.

Lluqsiy qillqay: ['Non-existant file:'], sayay.
{ Server pasachiy: ['xxx.xxx'] ñawpaq-kʼaskaq: ['/tmp/']. }
hapiy: { :e Lluqsiy qillqay: e, sayay. },
kallpay.
