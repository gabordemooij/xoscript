
Lluqsiy qillqay: ['Break for-loop, 0-4.'], sayay.
{ :i
	Lluqsiy qillqay: ['iteration #'] + i, sayay.
	(i = 4) kuchuy.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Lluqsiy qillqay: ['Break while-true loop, 0-4.'], sayay.
{
	Lluqsiy qillqay: ['iteration #'] + x, sayay.
	x yapay: 1.
	((x < 5) mana) kuchuy.
} chaykama: xIsLessThan10.

Lluqsiy qillqay: ['Break while-false loop, 5,4.'], sayay.
{
	Lluqsiy qillqay: ['iteration #'] + x, sayay.
	x qichuy: 1.
	(x = 3) kuchuy.
} chaykama: { <- (x > 0). }.

Lluqsiy qillqay: ['Break times loop, 1-4.'], sayay.
{ :i
	Lluqsiy qillqay: ['iteration #'] + i, sayay.
	(i = 4) kuchuy.
} × 5.

Lluqsiy qillqay: ['Break block, dont print line.'], sayay.
{ Chiqap kuchuy. Lluqsiy qillqay: ['dont write this!'], sayay. } kallpay.

Lluqsiy qillqay: ['Break block, dont fire catch...'], sayay.
{ Chiqap kuchuy. Lluqsiy qillqay: ['dont write this!'], sayay. } hapiy: { Lluqsiy qillqay: ['Dont catch this!']. }, kallpay.

Lluqsiy qillqay: ['Test Array each-loop: 0,1'], sayay.
(Katiray ← 1 ; 2 ; 3) mapa: { :i
	Lluqsiy qillqay: ['iteration #'] + i, sayay.
	(i = 1) kuchuy.
}.

Lluqsiy qillqay: ['Test Map each-loop: c only'], sayay.
>> m := Simi-taqi musuq.
m churay: ['first'] maypi: ['a'], churay: ['second'] maypi: ['b'], churay: ['third'] maypi: ['c'].
m sapallanpaq: { :k :v
	Lluqsiy qillqay: ['iteration'] + v + k, sayay.
	Chiqap kuchuy.
}.

