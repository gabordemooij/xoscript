Lluqsiy qillqay: ['Test object'], sayay.
>> a := Ima musuq. 
a patapi: ['item:'] ruway: { :lst
	ñuqap lst := lst. 
}.
a patapi: ['item'] ruway: { <- ñuqap lst.
}.
a item: (
	Katiray musuq ; 1 ; (
		Katiray musuq ; ['a'] ; (
			Katiray musuq ; ( Pacha musuq: 1 )
		) ; ( Int64 qillqamanta: ['321'] )
	)
).
Lluqsiy qillqay: a item, sayay.
>> old-lst-address := a item ñawpaq-rikchʼay yuyay-tiyanan.
a save-as: ['/tmp/a.bin'].
Lluqsiy qillqay: ['========== RELOADING SNAP:'], sayay.
>> b := Ima load-from: ['/tmp/a.bin'].
(b item ñawpaq-rikchʼay yuyay-tiyanan = old-lst-address) chiqapqtin: {
	Lluqsiy qillqay: ['Object link re-attached.'], sayay.
}.
Lluqsiy qillqay: ( b item ), sayay.
