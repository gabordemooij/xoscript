Lluqsiy qillqay: ['Test object'], sayay.
>> a := Ima musuq. 

a patapi: ['item:'] ruway: { :out
	ñuqap out := out. 
}.

a patapi: ['item'] ruway: { <- ñuqap out.
}.

a patapi: ['greet'] ruway: {
	Lluqsiy qillqay: ['hi from original out!'], sayay.
}.

a item: Lluqsiy.

Lluqsiy qillqay: a item, sayay.

>> old-out-address := a item ñawpaq-rikchʼay yuyay-tiyanan.
a save-as: ['/tmp/a.bin'].
Lluqsiy qillqay: ['========== RELOADING SNAP:'], sayay.

>> b := Ima load-from: ['/tmp/a.bin'].

(b item ñawpaq-rikchʼay yuyay-tiyanan = old-out-address) chiqapqtin: {
	Lluqsiy qillqay: ['Object link re-attached.'], sayay.
}.

b item qillqay: ['hello from loaded out!'], sayay.
b greet.
