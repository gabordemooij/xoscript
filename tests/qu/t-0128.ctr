
Katiray patapi: ['sum'] ruway: {
	>> total := 0.
	kikin sapallanpaq: { :index :element
		total yapay: element.
	}. <- total.
}.

>> a := Katiray ← 9 ; 8 ; 7.
Lluqsiy qillqay: (a sum), sayay. 
>> a := Katiray ← 1 ; 9.
Lluqsiy qillqay: (a sum), sayay. 
>> a := Katiray ← ['o'] ; 2.
Lluqsiy qillqay: (a sum), sayay. 
Lluqsiy qillqay: (Katiray musuq sum), sayay. 
