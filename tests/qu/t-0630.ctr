#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Rikchʼaq musuq: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern tinkuy: subject ruway: { :m :x
	Lluqsiy qillqay: m, sayay.
	Lluqsiy qillqay: x, sayay. <- ['XXX'].
}.
Lluqsiy qillqay: result, sayay.