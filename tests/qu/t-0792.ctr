Server init.

>> DB := Maria-DB musuq samachiq: ['localhost'],
	ruraqpa-sutin: ['xo'],
	pakasqa-simi: ['pass123'],
	willay-waqaychanap-sutin: ['xobase'],
	tinkiy.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB tapuy: SQL.

# now you don't have to set DB
query2 apamuy: { :row
	Lluqsiy qillqay: row world, sayay.
}.
