# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Rikchʼaq musuq: pattern.
	p tinkuy: subject ruway: { :m :g
		Lluqsiy qillqay: g hayka?, qillqay: [' '], qillqay: (g huñuy: ['|']), sayay. <- m.
	}.
}.
show rurachiy: ['(a)|(b)'] wan: ['b'].
show rurachiy: ['(a)|(b)'] wan: ['a'].
show rurachiy: ['(x)?y'] wan: ['y'].
show rurachiy: ['(x)?(y)(z)?'] wan: ['xy'].
