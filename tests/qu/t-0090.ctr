Lluqsiy qillqay: ['1,2,3,4,5,6,7,8,9,A,'], sayay.
>> Scope := Ima musuq.
Scope patapi: ['initialize:'] ruway: { :x ñuqap property := x. }.
Scope patapi: ['confirm'] ruway: { Lluqsiy qillqay: [',']. }.
Scope patapi: ['pruebay'] ruway: {
	Lluqsiy qillqay: ñuqap property.
	kikin confirm.
	( 1 = 1 ) chiqapqtin: { Lluqsiy qillqay: ñuqap property. kikin confirm. }.
	( 1 = 0 ) llullaqtin: { Lluqsiy qillqay: ñuqap property. kikin confirm. }.
	>> y := 2. { Lluqsiy qillqay: ñuqap property. kikin confirm. } chaykama: { y qichuy: 1. <- (y > 0). }.
	{ Lluqsiy qillqay: ñuqap property. kikin confirm. } × 1.
	(Katiray ← 1) sapallanpaq: {  Lluqsiy qillqay: ñuqap property. kikin confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Simi-taqi musuq one: ['item']) sapallanpaq: { Lluqsiy qillqay: ñuqap property. kikin confirm. }.
	{ 1 ÷ 0. } hapiy: { Lluqsiy qillqay: ñuqap property. kikin confirm. }, kallpay.
	Lluqsiy sayay.
}.
>> scope1 := Scope musuq.
scope1 initialize: ['X'].
scope1 pruebay.
>> function := { 
	ñuqap property := ['Y'].
	Lluqsiy qillqay: ñuqap property.
	kikin confirm.
	( 1 = 1 ) chiqapqtin: { Lluqsiy qillqay: ñuqap property. kikin confirm. }.
	( 1 = 0 ) llullaqtin: { Lluqsiy qillqay: ñuqap property. kikin confirm. }.
	>> y := 2. { Lluqsiy qillqay: ñuqap property. kikin confirm. } chaykama: { y qichuy: 1. <- (y > 0). }.
	{ Lluqsiy qillqay: ñuqap property. kikin confirm. } × 1.
	(Katiray ← 1) sapallanpaq: {  Lluqsiy qillqay: ñuqap property. kikin confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Simi-taqi musuq one: ['item']) sapallanpaq: { Lluqsiy qillqay: ñuqap property. kikin confirm. }.
	{ 1 ÷ 0. } hapiy: { Lluqsiy qillqay: ñuqap property. kikin confirm. }, kallpay.
	Lluqsiy sayay.
}.
function patapi: ['confirm'] ruway: { Lluqsiy qillqay: [',']. }.
function rurachiy: 1 wan: 2.
