

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa chʼuya: 0.

{ :i Lluqsiy qillqay: i. } × 4.
Lluqsiy sayay.
{ :i Lluqsiy qillqay: (4 - i). } × 4.
Lluqsiy sayay.
( 1 > 2 ) llullaqtin: { Lluqsiy qillqay: ['BLOCK 1'], sayay. }.
( 2 > 1 ) chiqapqtin:  { Lluqsiy qillqay: ['BLOCK 2'], sayay. }.

>> i := 0.
{ Lluqsiy qillqay: i. i yapay: 1. } chaykama: { <- ( i < 3). }.
Lluqsiy sayay.

i := 3.
{ Lluqsiy qillqay: i. i := i - 1. } chaykama: { <- ( i > 0). }.
Lluqsiy sayay.


Programa yuyay-pichay.

usedMemory1 := (Programa yuyay ? 0).


{ :i  Lluqsiy qillqay: i. } × 4.
Lluqsiy sayay.
{ :i  Lluqsiy qillqay: (4 - i). } × 4.
Lluqsiy sayay.
( 1 > 2 ) llullaqtin: { Lluqsiy qillqay: ['BLOCK 1'], sayay. }.
( 2 > 1 ) chiqapqtin:  { Lluqsiy qillqay: ['BLOCK 2'], sayay. }.

>> i := 0.
{ Lluqsiy qillqay: i. i yapay: 1. } chaykama: { <- ( i < 3). }.
Lluqsiy sayay.

i := 3.
{ Lluqsiy qillqay: i. i := i - 1. } chaykama: { <- ( i > 0). }.
Lluqsiy sayay.



Programa yuyay-pichay.
usedMemory2 := (Programa yuyay ? 0).


{ :i Lluqsiy qillqay: i. } × 4.
Lluqsiy sayay.
{ :i Lluqsiy qillqay: (4 - i). } × 4.
Lluqsiy sayay.
( 1 > 2 ) llullaqtin: { Lluqsiy qillqay: ['BLOCK 1'], sayay. }.
( 2 > 1 ) chiqapqtin:  { Lluqsiy qillqay: ['BLOCK 2'], sayay. }.

>> i := 0.
{ Lluqsiy qillqay: i. i yapay: 1. } chaykama: { <- ( i < 3). }.
Lluqsiy sayay.

i := 3.
{ Lluqsiy qillqay: i. i := i - 1. } chaykama: { <- ( i > 0). }.
Lluqsiy sayay.

Programa yuyay-pichay.
usedMemory3 := (Programa yuyay ? 0).



( usedMemory1 = usedMemory2 wan: usedMemory1 = usedMemory3, wan: usedMemory2 = usedMemory3 ) chiqapqtin: {
	Lluqsiy qillqay: ['No memory leaks here'].
}, llullaqtin: {
	Lluqsiy qillqay: ['Leaking memory...'].
}.
