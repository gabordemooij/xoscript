Yupay patapi: ['factorial'] ruway: {
	>> total := 1.
	{ :index total mirachiy-rayku: (kikin - (index)). } × kikin. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Lluqsiy qillqay: a.
>> b := 2 + 3 factorial.
Lluqsiy qillqay: b.
>> c := 3 factorial + 2.
Lluqsiy qillqay: c.
>> d := 2 + (3 factorial).
Lluqsiy qillqay: d.
Lluqsiy qillqay: 2 + 3 factorial + 1.
