# test catch-all methods
>> x13 := Ima musuq.
x13 patapi: ['a'] ruway: { :a Lluqsiy qillqay: 0, sayay. }.
x13 patapi: ['a:'] ruway: { :a Lluqsiy qillqay: a, sayay. <- 5. }.
x13 patapi: ['a:b:'] ruway: { :a :b Lluqsiy qillqay: (a + b), sayay. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
