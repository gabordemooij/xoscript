>> winery := { <- (	Simi-taqi musuq
		churay: 2 maypi: ['merlot'],
		churay: 3 maypi: ['malbec'],
		churay: 4 maypi: ['syrah']
	).
}.

Lluqsiy qillqay: (((winery kallpay) - ['nothing']) hayka?), sayay.
Lluqsiy qillqay: (((winery kallpay) - ['merlot']) hayka?), sayay.
Lluqsiy qillqay: (((winery kallpay) - ['malbec']) hayka?), sayay.
Lluqsiy qillqay: (((winery kallpay) - ['syrah']) hayka?), sayay.
Lluqsiy qillqay: (((winery kallpay) - ['merlot'] - ['malbec']) hayka?), sayay.
Lluqsiy qillqay: (((winery kallpay) - ['merlot'] - ['syrah']) hayka?), sayay.
Lluqsiy qillqay: (((winery kallpay) - ['malbec'] -['syrah']) hayka?), sayay.
Lluqsiy qillqay: (((winery kallpay) - ['malbec'] - ['syrah'] - ['merlot']) hayka?), sayay.

