Lluqsiy qillqay: ['Test object'], sayay.
>> greeter := Ima musuq.
greeter patapi: ['name:'] ruway: { :suti
	ñuqap xname := suti. 
}.
greeter patapi: ['greet'] ruway: {
	Lluqsiy qillqay: ['Hello '] + ñuqap xname, sayay.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Lluqsiy qillqay: ['========== RELOADING SNAP:'], sayay.
>> b := Ima load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
