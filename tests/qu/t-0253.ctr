#Linux
>> OS := Programa wakichina: ['OS'].

>> clock := Pacha musuq.
	
(OS = ['Haiku']) chiqapqtin: {
	clock suyu: ['CET'],
	wata: 2017, killa: 7, pʼunchaw: 13,
	hora: 18, minuto: 0, segundo: 0.
}, manahinaqa: {
	clock suyu: ['Europe/Amsterdam'],
	wata: 2017, killa: 7, pʼunchaw: 13,
	hora: 18, minuto: 0, segundo: 0.
}.

clock patapi: ['tell'] ruway: {
	Lluqsiy qillqay: kikin, sayay.
}.


clock yapay: 2    hora, tell.
clock yapay: 1    hora, tell.
clock yapay: 19 minuto, tell.
clock yapay: 1  minuto, tell.
clock yapay: 1  minuto, tell.
clock yapay: 19 segundo, tell.
clock yapay: 1  segundo, tell.
clock yapay: 1  segundo, tell.
clock yapay: 2    wata, tell.
clock yapay: 1    wata, tell.

(OS = ['Haiku']) chiqapqtin: {
clock yapay: 5   killa.
clock suyu: ['CEST'], tell.
}, manahinaqa: {
	clock yapay: 5   killa, tell.
}.

clock yapay: 1   killa, tell.
clock yapay: 19    pʼunchaw, tell.
clock yapay: 1    hora, tell.
clock yapay: 120  yard, tell.
