Yupay patapi: ['factorial'] ruway: {
	>> total := 1.
	{ :index total mirachiy-rayku: (kikin - (index)). } × kikin. <- total.
}.
>> Printer := Ima musuq.
Printer patapi: ['print:and:'] ruway: { :x :y
	Lluqsiy qillqay: ['a='] + x + [', b='] + y, sayay.
}.
>> a := 4.5. >> b := a ura.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a hana.
Printer print: a and: b.
a := 4.5. b := a ura.
Printer print: a and: b.
a := 4.5. b := a muyuriq.
Printer print: a and: b.
a := 4.2. b := a muyuriq.
Printer print: a and: b.

Lluqsiy qillqay: (9 puchu: 5), sayay.
Lluqsiy qillqay: -666 kayqilla, sayay.
Lluqsiy qillqay: 49 iskay-saphi, sayay.
Lluqsiy qillqay: (2 atiy: 3), sayay.
>> l := (Katiray ← 9 ; 6).
Lluqsiy qillqay: l aswan-pisi.

