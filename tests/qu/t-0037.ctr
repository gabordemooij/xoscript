>> a := 3.
>> b := a kikinchasqa.
a qichuy: 1.
Lluqsiy qillqay: [' a = '] + a.
Lluqsiy qillqay: [' b = '] + b.
a := 3.
b := a + 4.
Lluqsiy qillqay: [' a = '] + a.
Lluqsiy qillqay: [' b = '] + b.
>> x := 3.
>> y := x kikinchasqa.
x yapay: 10.
y qichuy: 1.
Lluqsiy qillqay: [' x = '] + x.
Lluqsiy qillqay: [' y = '] + y.
>> q := Ima musuq.
q patapi: ['setProperty:'] ruway: { :x
	ñuqap prop := x.
}.
q patapi: ['getProperty'] ruway: { <- ñuqap prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Lluqsiy qillqay: [' p = '] + (p getProperty).
