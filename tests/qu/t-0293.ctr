
>> city := Katiray ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Katiray ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature rayku: city.
>> cities := weather yaykuykunata kamachiy: { :a :b <- (a tupachiy: b). }.
>> temperatures := weather chaninkunata kamachiy: { :a :b <- (a tupachiy: b) mana-alli?. }.

Lluqsiy qillqay: (cities huñuy: [',']), sayay.
Lluqsiy qillqay: (temperatures huñuy: [',']), sayay.
