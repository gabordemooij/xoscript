#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa chʼuya: 0.

{
Pacha pacha.
Pacha suyay: 1.
Lluqsiy qillqay: Programa hapina-yupay, sayay.
Programa hapina: 0.
Yupay random.
Lluqsiy qillqay: (Programa karacha: ['echo 'Hello'']).
} kallpay.

Programa yuyay-pichay.
usedMemory1 := (Programa yuyay ? 0).

{
Pacha pacha.
Pacha suyay: 1.
Lluqsiy qillqay: Programa hapina-yupay, sayay.
Programa hapina: 0.
Yupay random.
Lluqsiy qillqay: (Programa karacha: ['echo 'Hello'']).
} kallpay.

Programa yuyay-pichay.
usedMemory2 := (Programa yuyay ? 0).

{
Pacha pacha.
Pacha suyay: 1.
Lluqsiy qillqay: Programa hapina-yupay, sayay.
Programa hapina: 0.
Yupay random.
Lluqsiy qillqay: (Programa karacha: ['echo 'Hello'']).
} kallpay.

Programa yuyay-pichay.
usedMemory3 := (Programa yuyay ? 0).



( usedMemory1 = usedMemory2 wan: usedMemory1 = usedMemory3, wan: usedMemory2 = usedMemory3 ) chiqapqtin: {
	Lluqsiy qillqay: ['No memory leaks here'].
}, llullaqtin: {
	Lluqsiy qillqay: ['Leaking memory...'].
}.
