Lluqsiy qillqay: ((Katiray musuq
	patapi: ['plaque:'] ruway: { :x ñuqap o := x. },
	patapi: ['plaque']  ruway: { <- ñuqap o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Katiray ← 1)
	~ (Katiray ← 1 ; 2)
	~ (Katiray ← 1 ; 2 ; 3)
	~ (Katiray ← 1 ; 2 ; 3 ; 4)
	~ (Katiray ← 1 ; 2 ; 3 ; 4 ; 5)
) sapallanpaq: { :i :el
	{ Lluqsiy qillqay: kay-ruway. } × el hayka?.
	Lluqsiy sayay.
}) plaque, sayay.


