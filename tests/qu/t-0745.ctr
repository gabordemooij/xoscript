Lluqsiy qillqay: ['Test object'], sayay.
>> a := Ima musuq. 

a patapi: ['item:'] ruway: { :dict
	ñuqap dict := dict. 
}.

a patapi: ['item'] ruway: { <- ñuqap dict.
}.

a item: (
Simi-taqi musuq
	hello: ['world']).

>> old-dict-address := a item ñawpaq-rikchʼay yuyay-tiyanan.
a save-as: ['/tmp/a.bin'].
Lluqsiy qillqay: ['========== RELOADING SNAP:'], sayay.

>> b := Ima load-from: ['/tmp/a.bin'].

(b item ñawpaq-rikchʼay yuyay-tiyanan = old-dict-address) chiqapqtin: {
	Lluqsiy qillqay: ['Object link re-attached.'], sayay.
}.

Lluqsiy qillqay: b item, sayay.
