# a value ending in the first part of an opening quote must survive serialization
>> chaninkunata := Katiray musuq
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

chaninkunata sapallanpaq: { :i :value
	>> d := Simi-taqi musuq.
	d churay: value maypi: ['k'].
	d churay: ['second'] maypi: ['j'].
	>> r := d codigo imaman.
	Lluqsiy qillqay: r hayka?, sayay.
	Lluqsiy qillqay: ( (r maypi: ['k']) = value ), sayay.
}.
