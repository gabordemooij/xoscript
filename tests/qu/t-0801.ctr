Server init.

>> db := Maria-DB musuq samachiq: ['localhost'],
	ruraqpa-sutin: ['xo'],
	pakasqa-simi: ['pass123'],
	willay-waqaychanap-sutin: ['xobase'],
	tinkiy.

>> del := db tapuy: ['DELETE FROM book WHERE id > 0'].
{  del huntʼachiy. db takyachiy. } hapiy: { :e db kutichipuy.  }, kallpay.

>> hayka? := db tapuy: ['SELECT COUNT(*) AS num FROM book'].
hayka? apamuy: { :row Lluqsiy qillqay: row num, sayay. }.
