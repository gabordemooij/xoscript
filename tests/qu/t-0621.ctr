>> phrases := Katiray musuq
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases sapallanpaq: { :_ :phrase 
	>> e := Server base64-kodificay: phrase.
	>> d := Server base64-dekodificay: e.
	Lluqsiy qillqay: (
		message kikinchasqa ~encoded: e, ~decoded: d
	), sayay.
}.
