Lluqsiy qillqay: ['Test object'], sayay.
>> p := Ñanpuni /tmp.
Lluqsiy qillqay: p, sayay.
>> old-p-address := p ñawpaq-rikchʼay yuyay-tiyanan.
p save-as: ['/tmp/a.bin'].
Lluqsiy qillqay: ['========== RELOADING SNAP:'], sayay.
>> b := Ima load-from: ['/tmp/a.bin'].
(b ñawpaq-rikchʼay yuyay-tiyanan = old-p-address) chiqapqtin: {
	Lluqsiy qillqay: ['Object link re-attached.'], sayay.
}.
Lluqsiy qillqay: b, sayay.
