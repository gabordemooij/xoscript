Chiqapcha patapi: ['xor:'] ruway: { :a :b <- ((a wan: b mana) utaq: (a mana wan: b)).
}.

>> o := Ima musuq.
o patapi: ['hello'] ruway: { ['Empty']. }.
{ o patapi: 2 ruway: 3.} hapiy: { :e Lluqsiy qillqay: e, sayay. }, kallpay.
{ o patapi: ['pruebay'] ruway: 3.} hapiy: { :e Lluqsiy qillqay: e, sayay. }, kallpay.
{ o patapi: ['hello'] ruway: { ['Empty']. }.} hapiy: { :e Lluqsiy qillqay: e, sayay. }, kallpay. 
{ >> z := 4 ÷ 0. } hapiy: { :e Lluqsiy qillqay: e, sayay. }, kallpay. 
{ (Chiqap wan: Mana) chiqapqtin: { Lluqsiy qillqay: ['X'].}. } hapiy: { :e Lluqsiy qillqay: e, sayay. }, kallpay. 
{ ([''] xor: 0) chiqapqtin: { Lluqsiy qillqay: ['X'].}. } hapiy: { :e Lluqsiy qillqay: e, sayay. }, kallpay. 
{ (1 < ['2']) chiqapqtin: { Lluqsiy qillqay: ['OK']. }. } hapiy: { :e Lluqsiy qillqay: e, sayay. }, kallpay. 
{ (1 < ['2.0']) chiqapqtin: { Lluqsiy qillqay: ['OK']. }. } hapiy: { :e Lluqsiy qillqay: e, sayay. }, kallpay. 
{ (1 < ['x2.0']) chiqapqtin: { Lluqsiy qillqay: ['NO!']. }. } hapiy: { :e Lluqsiy qillqay: e, sayay. }, kallpay. 
{ Lluqsiy qillqay: (['hello OK there'] manta: ['6'] suni: ['2']). } kallpay. 
