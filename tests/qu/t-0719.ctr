Server init.
>> fmt := Formato musuq: ['%#3x'].

>> blob := Blob musuq: 4.
blob bytes: ( 
	Katiray musuq ; 0 ; 1 ; 2 ; 3
).

>> file := Khipu musuq: ['/tmp/blob'].
file blob: blob.
blob kacharichiy.

>> ñawiy := file blob.
ñawiy 
manta: 0 
suni: 4, 
ruway sapallanpaq: { :i :b 
	Lluqsiy
	qillqay: (fmt rurachiy-yupay-huntasqa: b),
	sayay.
}.
ñawiy kacharichiy.
