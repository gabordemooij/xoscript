
>> XX := Ima musuq.
>> X := Ima musuq.

XX patapi: ['QQ'] ruway: { <- 1. }.
XX patapi: ['Q'] ruway: { <- 1. }.
XX patapi: ['QQ:'] ruway: { <- 1. }.
XX patapi: ['QQ:QQ:'] ruway: { <- 1. }.

X patapi: ['QQ'] ruway: { <- 1. }.
X patapi: ['Q'] ruway: { <- 1. }.
X patapi: ['QQ:'] ruway: { <- 1. }.
X patapi: ['QQ:QQ:'] ruway: { <- 1. }.

Lluqsiy qillqay: (Programa XX), sayay.
Lluqsiy qillqay: (Programa maskay: ['XX']), sayay.
Lluqsiy qillqay: (Programa maskay: ['X']), sayay.

Lluqsiy qillqay: (Programa XX: ['QQ']), sayay.
Lluqsiy qillqay: (Programa XX: ['Q']), sayay.
Lluqsiy qillqay: (Programa XX: ['QQ:']), sayay.
Lluqsiy qillqay: (Programa XX: ['QQ:QQ:']), sayay.

Lluqsiy qillqay: (Programa X: ['QQ']), sayay.
Lluqsiy qillqay: (Programa X: ['Q']), sayay.
Lluqsiy qillqay: (Programa X: ['QQ:']), sayay.
Lluqsiy qillqay: (Programa X: ['QQ:QQ:']), sayay.

Lluqsiy qillqay: (Programa X ['QQ']), sayay.
Lluqsiy qillqay: (Programa X ['Q']), sayay.
Lluqsiy qillqay: (Programa X ['QQ:']), sayay.
Lluqsiy qillqay: (Programa X ['QQ:QQ:']), sayay.

Lluqsiy qillqay: (Programa YY), sayay.
Lluqsiy qillqay: (Programa maskay: ['YY']), sayay.
Lluqsiy qillqay: (Programa maskay: ['Y']), sayay.

Lluqsiy qillqay: (Programa YY: ['QQ']), sayay.
Lluqsiy qillqay: (Programa YY: ['Q']), sayay.
Lluqsiy qillqay: (Programa YY: ['QQ:']), sayay.
Lluqsiy qillqay: (Programa YY: ['QQ:QQ:']), sayay.

Lluqsiy qillqay: (Programa Y: ['QQ']), sayay.
Lluqsiy qillqay: (Programa Y: ['Q']), sayay.
Lluqsiy qillqay: (Programa Y: ['QQ:']), sayay.
Lluqsiy qillqay: (Programa Y: ['QQ:QQ:']), sayay.

Lluqsiy qillqay: (Programa Y ['QQ']), sayay.
Lluqsiy qillqay: (Programa Y ['Q']), sayay.
Lluqsiy qillqay: (Programa Y ['QQ:']), sayay.
Lluqsiy qillqay: (Programa Y ['QQ:QQ:']), sayay.

Lluqsiy qillqay: (Programa X: -1), sayay.
Lluqsiy qillqay: (Programa X Mana), sayay.

