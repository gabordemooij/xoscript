# recursive interpolation not allowed

Lluqsiy qillqay: 
['recursive string interolation enabled: '] + (
	Programa atiynin: 
	['RECURSIVE_STRINTPOL']
), sayay.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Lluqsiy qillqay: a, sayay.


