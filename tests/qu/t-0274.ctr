

Katiray patapi: ['column:'] ruway: { :column
	>> result := Katiray musuq.
	kikin sapallanpaq: { :index :row
		row sapallanpaq: { :index :cell
			(index = column) chiqapqtin: { result yapay-qhepaman: cell. }.
		}.
	}. <- result.
}.


>> a := Katiray ←
	(Katiray ← 1 ; 2 ; 3) ;
	(Katiray ← 4 ; 5 ; 6) ;
	(Katiray ← 7 ; 8 ; 9).

>> b := a column: 1.
Lluqsiy qillqay: b, sayay.

b := a column: 20.
Lluqsiy qillqay: b, sayay.

b := a column: -100.
Lluqsiy qillqay: b, sayay.
