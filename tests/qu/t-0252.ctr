#Linux
>> clock := Pacha musuq.
clock suyu: ['UTC-1'].
clock wata: 1981, killa: 1, pʼunchaw: 5,
      hora: 13, minuto: 15, segundo: 13.

Lluqsiy qillqay: clock, sayay.
clock suyu: ['UTC+0'].

Lluqsiy qillqay: (
	(clock wata chawa) + ['-'] + (clock killa) + ['-'] + (clock pʼunchaw) + [' '] +
	(clock hora) + [':'] + (clock minuto) + [':'] + (clock segundo) + [' '] +
	['W'] + (clock semana) + (clock suyu)
), sayay.


clock suyu: ['UTC-1'].
Lluqsiy qillqay: (
	(clock wata chawa) + ['-'] + (clock killa) + ['-'] + (clock pʼunchaw) + [' '] +
	(clock hora) + [':'] + (clock minuto) + [':'] + (clock segundo) + [' '] +
	['W'] + (clock semana) + (clock suyu)
), sayay.
