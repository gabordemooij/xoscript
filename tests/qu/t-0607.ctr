>> Combination := Katiray musuq.

Combination patapi: ['yapay-qhepaman:'] ruway: { :el
	kikin 
	maskay: el, Manachu? chiqapqtin: { kikin yapay-qhepaman: el. }.
}.

>> colours := Combination musuq.
colours
	yapay-qhepaman: ['red'],
	yapay-qhepaman: ['green'],
