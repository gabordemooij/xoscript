
>> dictionary := (
	Simi-taqi musuq
		churay: ['b'] maypi: ['a'],
		churay: ['a'] maypi: ['b'],
		churay: ['z'] maypi: ['x'],
		churay: ['hello'] maypi: ['hallo'],
		churay: ['human'] maypi: ['human']
).

>> comparisons := Katiray musuq.
dictionary sapallanpaq: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a tupachiy: b)
	).
}.

comparisons kamachiy: { :a :b <- ( a tupachiy: b ). }.
Lluqsiy qillqay: ( comparisons huñuy: ['↵'] ), sayay.
comparisons huñuy: ['↵'].
