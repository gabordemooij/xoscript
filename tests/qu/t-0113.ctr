Lluqsiy qillqay: ['Continue for-loop, No - before 6 and up.'], sayay.
{ :i
	Lluqsiy qillqay: (i + 1), sayay.
	((i + 1) > 4) qatiy.
	Lluqsiy qillqay: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Lluqsiy sayay.
Lluqsiy qillqay: ['Continue while-true, No --> before 5 and up.'], sayay.
{
	Lluqsiy qillqay: ['iteration #'] + x, sayay.
	x yapay: 1.
	((x < 5) mana) qatiy.
	Lluqsiy qillqay: ['-->'].
} chaykama: xIsLessThan10.
Lluqsiy sayay.
Lluqsiy qillqay: ['Continue while-false, No - before 3 only.'], sayay.
{
	Lluqsiy qillqay: ['iteration #'] + x, sayay.
	x qichuy: 1.
	(x = 3) qatiy.
	Lluqsiy qillqay: ['-'].
} chaykama: { <- ( x > 0). }.

Lluqsiy sayay.
Lluqsiy qillqay: ['Continue times-loop, No ||| before 3.'], sayay.
{ :i
	Lluqsiy qillqay: ['iteration #'] + i, sayay.
	(i = 2) qatiy.
	Lluqsiy qillqay: ['|||'].
} × 5.

Lluqsiy sayay.

{ Chiqap qatiy. Lluqsiy qillqay: ['dont write this!'], sayay. } kallpay.

{ Chiqap qatiy. Lluqsiy qillqay: ['dont write this!'], sayay. } hapiy: { Lluqsiy qillqay: ['Dont catch this!']. }, kallpay.

Lluqsiy qillqay: ['Test Array each-loop: 0, ... ,2'], sayay.
(Katiray ← 1 ; 2 ; 3) mapa: { :i
	(i = 1) qatiy.
	Lluqsiy qillqay: ['iteration #'] + (i - 0), sayay.
}.

Lluqsiy qillqay: ['Test Map each-loop: c only'], sayay.
>> m := Simi-taqi musuq.
m churay: ['first'] maypi: ['a'], churay: ['second'] maypi: ['b'], churay: ['third'] maypi: ['c'].
m sapallanpaq: { :k :v
	(k ≠ ['c']) qatiy.
	Lluqsiy qillqay: ['iteration'] + k + v, sayay.
}.

