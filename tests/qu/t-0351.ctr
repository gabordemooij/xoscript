
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> codigo := {
	>> o := (
		Simi-taqi musuq
		aa: (Katiray ← 1 ; 2),
		bb: (Katiray ← 3 ; 4)
	).
	>> s := o qillqaman.
	>> o2 := s imaman.
	(s  laya = Qillqa laya) chiqapqtin: { Lluqsiy qillqay: ['OK1'], sayay. }.
	(o2 laya = Simi-taqi laya) chiqapqtin: { Lluqsiy qillqay: ['OK2'], sayay. }.
}.

Programa chʼuya: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Programa yuyay-pichay.
usedMemory1 := (Programa yuyay ? 1).
codigo kallpay.
Programa yuyay-pichay.
usedMemory2 := (Programa yuyay ? 1).
codigo kallpay.
Programa yuyay-pichay.
usedMemory3 := (Programa yuyay ? 1).
codigo kallpay.
Programa yuyay-pichay.
usedMemory4 := (Programa yuyay ? 1).

(usedMemory2 = usedMemory3 = usedMemory4) chiqapqtin: { Lluqsiy qillqay: ['OK3'], sayay. }.
 
