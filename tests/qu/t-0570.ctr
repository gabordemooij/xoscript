#Linux

 >> t := Pacha musuq.
 
t suyu: ['Europe/Amsterdam'].
t wata: 2020, killa: 8, pʼunchaw: 2, hora: 21, minuto: 2, segundo: 1.

>> a := t hora.
>> ams := t suyu.

t suyu: ['US/Hawaii'].
>> b := t hora.
>> hw := t suyu.

Lluqsiy
qillqay: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		kaypas: ['later'] chaypas: ['earlier']
	)
),
sayay.
 