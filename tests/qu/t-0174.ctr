


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa chʼuya: 0.
>> palette := Mana.
>> colors := Mana.

{
palette := Simi-taqi musuq.
palette 
	churay: ['#F00'] maypi: ['red'],
	churay: ['#0F0'] maypi: ['green'],
	churay: ['#00F'] maypi: ['blue'].
Lluqsiy qillqay: ['number of RGB codes in palette: '] + ( palette hayka? ), sayay.
Lluqsiy qillqay: ['RGB code of green is: '] + ( palette ? ['green'] ), sayay.
colors := [''].
( palette sapallanpaq: { :suti :codigo
		colors := colors + ( suti + [':'] + codigo ).
} ).
Lluqsiy qillqay: ['All colors in palette: '] + colors, sayay.
} kallpay.
Programa yuyay-pichay.
usedMemory1 := (Programa yuyay ? 0).

{
palette := Simi-taqi musuq.
palette 
	churay: ['#F00'] maypi: ['red'],
	churay: ['#0F0'] maypi: ['green'],
	churay: ['#00F'] maypi: ['blue'].
Lluqsiy qillqay: ['number of RGB codes in palette: '] + ( palette hayka? ), sayay.
Lluqsiy qillqay: ['RGB code of green is: '] + ( palette ? ['green'] ), sayay.
colors := [''].
( palette sapallanpaq: { :suti :codigo
		colors := colors + ( suti + [':'] + codigo ).
} ).
Lluqsiy qillqay: ['All colors in palette: '] + colors, sayay.
} kallpay.
Programa yuyay-pichay.
usedMemory2 := (Programa yuyay ? 0).

{
palette := Simi-taqi musuq.
palette 
	churay: ['#F00'] maypi: ['red'],
	churay: ['#0F0'] maypi: ['green'],
	churay: ['#00F'] maypi: ['blue'].
Lluqsiy qillqay: ['number of RGB codes in palette: '] + ( palette hayka? ), sayay.
Lluqsiy qillqay: ['RGB code of green is: '] + ( palette ? ['green'] ), sayay.
colors := [''].
( palette sapallanpaq: { :suti :codigo
		colors := colors + ( suti + [':'] + codigo ).
} ).
Lluqsiy qillqay: ['All colors in palette: '] + colors, sayay.
} kallpay.
Programa yuyay-pichay.
usedMemory3 := (Programa yuyay ? 0).



( usedMemory1 = usedMemory2 wan: usedMemory1 = usedMemory3, wan: usedMemory2 = usedMemory3 ) chiqapqtin: {
	Lluqsiy qillqay: ['No memory leaks here'].
}, llullaqtin: {
	Lluqsiy qillqay: ['Leaking memory...'].
}.
