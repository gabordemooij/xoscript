>> t := Mana.

# you can control the time zone for
# parsing like this:
Pacha suyu: ['CET'].
t := Pacha kaymanta: ['1981-02-03 04:05:06'].
Lluqsiy qillqay: t, sayay.

# now using CEST time zone:
Pacha suyu: ['CEST'].
t := Pacha kaymanta: ['1981-02-03 04:05:06'].
Lluqsiy qillqay: t, sayay.

# error if string cannot be parsed
{ Pacha kaymanta: ['1900']. } hapiy: { Mana. }, kallpay.
