Katiray patapi: ['kikinchasqa'] ruway: {
	>> kikinchasqa := Katiray musuq.
	kikin sapallanpaq: { :yupayman :section
		kikinchasqa yapay-qhepaman: section kutipari kikinchasqa.
	}. <- kikinchasqa.
}.

>> sheep := Katiray musuq ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep kikinchasqa.
clones sapallanpaq: { :yupayman :sheep
	sheep yapay-qhepaman: ['2'].
}.

Lluqsiy qillqay: sheep, sayay.
Lluqsiy qillqay: clones, sayay.
