

>> g := Server musuq.
>> v := Waqaychana musuq.
>> ok := 0.

>> secrets := Katiray musuq ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> passwords := secrets kikinchasqa.
passwords sapallanpaq: { :i :p
	secrets sapallanpaq: { :n :s
		{
			>> encrypted := v pakay: s llawi: p.
			>> decrypted := v pakasqata-qhaway: encrypted llawi: p.
			(decrypted = s) chiqapqtin: {
				ok yapay: 1.
			}, manahinaqa: {
				Lluqsiy qillqay: ['failed encrypting/decrypting: '], sayay.
				Lluqsiy qillqay: s, sayay.
				Lluqsiy qillqay: ['encrypted: '] + encrypted, sayay.
				Lluqsiy qillqay: ['decrypted: '] + encrypted, sayay.
				Programa tukukuy.
			}.
		} hapiy: { :err
			(s = [''] utaq: p = ['']) chiqapqtin: {
				ok yapay: 1.
			}, manahinaqa: {
				Lluqsiy qillqay: err, sayay.
				Programa tukukuy.
			}.
		}, kallpay.
	}.
}.

Lluqsiy qillqay: ( ok + [' vault encryptions tested.'] ), sayay.