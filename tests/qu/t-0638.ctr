
Server init.
>> rq := Mañakuy-HTTP musuq.
Lluqsiy qillqay: ['HTTP-GET d[]=']  + ( rq get-lista: ['d[]'] ), sayay. # GET
Lluqsiy qillqay: ['HTTP-GET f[]=']  + ( rq get-lista: ['f[]'] ), sayay. # GET
Lluqsiy qillqay: ['HTTP-POST e[]='] + ( rq post-lista: ['e[]'] ), sayay. # GET
Lluqsiy qillqay: ['HTTP-POST c=']   + ( rq post: ['c'] ), sayay. # GET
Lluqsiy qillqay: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), sayay. # GET
