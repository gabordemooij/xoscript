Qillqa patapi: ['evaluate'] ruway: {
	>> codigo := Khipu musuq: ['/tmp/eval.ctr'].
	codigo qillqay: (kikin qillqaman + ['.']).
	Programa llamkʼachiy: ['/tmp/eval.ctr'].
}.

>> a := Katiray ← 1 ; 2 ; 3.
>> b := (a qillqaman).

Lluqsiy qillqay: b, sayay. 
(['b := '] + b) evaluate.

Lluqsiy qillqay: b ? 2, sayay. 

Lluqsiy qillqay: (( Katiray ← 1 ; 2 ; 3 )), sayay. 

Lluqsiy qillqay: ((Simi-taqi musuq) churay: 1 maypi: 2), sayay. 

>> x := ( (Katiray ← 1 ; ( Katiray ← 9 ) ; Chiqap ) ) qillqaman.
Lluqsiy qillqay: x, sayay. 
(['x := '] + x) evaluate.

Lluqsiy qillqay: x ? 1 ? 0, sayay. 

>> y := (Simi-taqi musuq) churay: (Katiray ← 1) maypi: (Katiray ← 2).
Lluqsiy qillqay: y, sayay. 

(['y := '] + y) qillqaman evaluate.

Lluqsiy qillqay: (y maypi: (Katiray ← 2) qillqaman ), sayay.

Lluqsiy qillqay: (Katiray musuq), sayay. 
Lluqsiy qillqay: (Simi-taqi musuq), sayay. 
