

Qillqa patapi: ['html'] ruway: { <- (
		kikin
		rantinpay: ['&'] kayta: ['&amp;'],
		rantinpay: ['<'] kayta: ['&lt;'],
		rantinpay: ['>'] kayta: ['&gt;'],
		rantinpay: ['"'] kayta: ['&quot;']
	).
}.


Lluqsiy qillqay: ([' left trimmed '] muyuriq-kʼichiykuna-qichuy) + [' '] + ( ['and right trimmed'] muyuriq-kʼichiykuna-qichuy) + ['!'], sayay.
Lluqsiy qillqay: ['<html>"html & entities"</html>'] html.
