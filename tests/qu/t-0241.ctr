

Qillqa patapi: ['evaluate'] ruway: {
	>> codigo := Khipu musuq: ['/tmp/eval.ctr'].
	codigo qillqay: (kikin qillqaman + ['.']).
	Programa llamkʼachiy: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Katiray ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q qillqaman.
Lluqsiy qillqay: x, sayay.
>> y := Mana.
(['y := '] + x ) evaluate.
Lluqsiy qillqay: y ? 0, sayay.

q := Simi-taqi churay: ['\[''] maypi: ['\['quote\']'].
x := q qillqaman.
Lluqsiy qillqay: x, sayay.
y := Mana.
(['y := '] + x ) evaluate.

>> q := (Simi-taqi musuq) churay:['\[''] maypi:['\['quote\[''].
Lluqsiy qillqay: y ? ['\['quote\']'], sayay.
