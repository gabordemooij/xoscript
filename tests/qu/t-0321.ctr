# test qualifiers

Programa yuyay-pichay.

>> Fruit := Ima musuq.
Fruit patapi: ['musuq'] ruway: {
	>> f := kikin musuq.
	f apples: 0. <- f.
}.
Fruit patapi: ['apples:'] ruway: { :a ñuqap apples := a. }.
Fruit patapi: ['apples'] ruway: { <- ñuqap apples. }.
Fruit patapi: ['+'] ruway: { :f
	>> n := Fruit musuq.
	n apples: (f apples + ñuqap apples). <- n.
}.
Yupay patapi: ['apples'] ruway: { <- ((Fruit musuq) apples: kikin).
}.

Fruit patapi: ['qillqaman'] ruway: { <- ñuqap apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Lluqsiy qillqay: q, sayay.




q := 3 apples + 4 apples.
Lluqsiy qillqay: q, sayay.



q := 3 apples + 4 apples.
Lluqsiy qillqay: q, sayay.


