>> Animal := Ima musuq.
Animal patapi: ['make'] ruway: {
	>> animal := Ima musuq.
	animal patapi: ['makeSound'] ruway: {
		Lluqsiy qillqay: ñuqap sound.
	}. <- animal.
}.
>> Cat := Ima musuq.
Cat patapi: ['make'] ruway: {
	>> cat := Animal make.
	cat patapi: ['init'] ruway: {
		ñuqap sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
