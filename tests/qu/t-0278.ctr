>> To-Do := Ima musuq.

To-Do patapi: ['musuq'] ruway: {
	ñuqap list := Katiray musuq.
}.

To-Do patapi: ['nieuw'] ruway: {
	ñuqap list := Katiray musuq.
}.

To-Do patapi: ['+'] ruway: { :task
	ñuqap list yapay-qhepaman: task.
}.

To-Do patapi: ['number of tasks?'] ruway: { <-  ñuqap list hayka?.
}.

>> todos := 
	To-Do musuq 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Lluqsiy qillqay: ['You have $ tasks to do'] $ todos number of tasks?.
