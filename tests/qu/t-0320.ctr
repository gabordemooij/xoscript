


>> CoffeeMachine := Ima musuq.
CoffeeMachine patapi: ['order:'] ruway: { :id
	>> coffee := ['Americano'].
	( id = 1 ) chiqapqtin: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) chiqapqtin: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) chiqapqtin: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Ima musuq.
SimpleCoffeeMachine patapi: ['order'] ruway: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Lluqsiy qillqay: redCup, sayay.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Lluqsiy qillqay: greenCup, sayay.
>> yellowCup := CoffeeMachine order: 1.
Lluqsiy qillqay: yellowCup, sayay.
>> blueCup := CoffeeMachine order: 0.
Lluqsiy qillqay: blueCup, sayay.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Lluqsiy qillqay: blackCup, sayay.
blackCup yapay-qhepaman: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Lluqsiy qillqay: orangeCup, sayay.
