

# create a 64-bit integer for exact calculations
>> a := Int64 qillqamanta: ['123'].

# to string
Lluqsiy qillqay: a, sayay.

# divide
Lluqsiy qillqay: a / (Int64 qillqamanta: ['3']), sayay.

# multiply
Lluqsiy qillqay: a * (Int64 qillqamanta: ['2']), sayay.

# add
Lluqsiy qillqay: a + (Int64 qillqamanta: ['1']), sayay.

# subtract
Lluqsiy qillqay: a - (Int64 qillqamanta: ['2']), sayay.

# compare
Lluqsiy qillqay: ( a =   (Int64 qillqamanta: ['123'])), sayay.
Lluqsiy qillqay: ( a !=: (Int64 qillqamanta: ['124'])), sayay.
Lluqsiy qillqay: ( a <   (Int64 qillqamanta: ['124'])), sayay.
Lluqsiy qillqay: ( a >   (Int64 qillqamanta: ['122'])), sayay.
Lluqsiy qillqay: ( a >=: (Int64 qillqamanta: ['123'])), sayay.
Lluqsiy qillqay: ( a <=: (Int64 qillqamanta: ['123'])), sayay.





	