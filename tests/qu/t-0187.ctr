Yupay patapi: ['factorial'] ruway: {
	>> total := 1.
	{ :index total mirachiy-rayku: (kikin - index). } × kikin. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa chʼuya: 0.

{
2 exponent factorial.
Lluqsiy qillqay: (11 puchu: 3), sayay.
Lluqsiy qillqay: (3.4 muyuriq), sayay.
Lluqsiy qillqay: (7.1 hana), sayay.
Lluqsiy qillqay: (7.9 ura), sayay.
}
kallpay.

Programa yuyay-pichay.

usedMemory1 := (Programa yuyay ? 0).

{
2 exponent factorial.
Lluqsiy qillqay: (11 puchu: 3), sayay.
Lluqsiy qillqay: (3.4 muyuriq), sayay.
Lluqsiy qillqay: (7.1 hana), sayay.
Lluqsiy qillqay: (7.9 ura), sayay.
}
kallpay.

Programa yuyay-pichay.
usedMemory2 := (Programa yuyay ? 0).


{
2 exponent factorial.
Lluqsiy qillqay: (11 puchu: 3), sayay.
Lluqsiy qillqay: (3.4 muyuriq), sayay.
Lluqsiy qillqay: (7.1 hana), sayay.
Lluqsiy qillqay: (7.9 ura), sayay.
} kallpay.

Programa yuyay-pichay.
usedMemory3 := (Programa yuyay ? 0).



( usedMemory1 = usedMemory2 wan: usedMemory1 = usedMemory3, wan: usedMemory2 = usedMemory3 ) chiqapqtin: {
	Lluqsiy qillqay: ['No memory leaks here'].
}, llullaqtin: {
	Lluqsiy qillqay: ['Leaking memory...'].
}.
