#ffi test


Server init.

Programa chʼuya: 4.

# for this test you need set a path to libc (puts)
>> libname := Programa wakichina: ['FFITESTLIB'].



Server tinkichiy: (
 Katiray musuq ;
 libname ;
 ['puts'] ;
 ( Katiray musuq ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s kacharichiy.

# test with struct

>> a := Blob musuq: 8.
a bytes: (
	Katiray <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Katiray <<: ['int'], ; ['int']).

Server tinkichiy: (
	Katiray <<: ['@structtest'], ;
	['@structtest'] ;
	(Katiray <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Lluqsiy qillqay: ['Sum test:'] + (ffitest ffisum: a), sayay.

struct kacharichiy-struct.
struct kacharichiy.
a kacharichiy.
