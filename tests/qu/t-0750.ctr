Lluqsiy qillqay: ['Test object'], sayay.
>> a := Ima musuq. 

a patapi: ['item:'] ruway: { :nil
	ñuqap nil := nil. 
}.

a patapi: ['item'] ruway: { <- ñuqap nil.
}.

a item: Mana.

Lluqsiy qillqay: a item, sayay.

>> old-nil-address := a item ñawpaq-rikchʼay yuyay-tiyanan.
a save-as: ['/tmp/a.bin'].
Lluqsiy qillqay: ['========== RELOADING SNAP:'], sayay.

>> b := Ima load-from: ['/tmp/a.bin'].

(b item ñawpaq-rikchʼay yuyay-tiyanan = old-nil-address) chiqapqtin: {
	Lluqsiy qillqay: ['Object link re-attached.'], sayay.
}.

Lluqsiy qillqay: b item, sayay.
