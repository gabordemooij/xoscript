Server init.

Lluqsiy qillqay: (
	Rikchʼaq musuq: ['^\\w+$'],
	tinkuy: ['test@example.com'] 
), sayay. # 0 match, fails on @ and .

Lluqsiy qillqay: (
	Rikchʼaq musuq: ['^[^@]+@[^\.]+\.\\w+$'],
	tinkuy: ['test@example.com'] 
), sayay. # 1 match

Lluqsiy qillqay: (
	Rikchʼaq musuq: ['[^@]+@[^\.]+\.\\w+'],
	tinkuy: ['test@example.com'] 
), sayay. # 1 match

Lluqsiy qillqay: (
	Rikchʼaq musuq: ['([^@]+)@([^\.]+)\.\\w+'],
	tinkuy: ['test@example.com'] 
), sayay. # 1 match, groups dont matter

Lluqsiy qillqay: (
	Rikchʼaq musuq: ['[a-z]'],
	tinkuy: ['test@example.com'] 
), sayay. # 14 matches

Lluqsiy qillqay: (
	Rikchʼaq musuq: ['.*'],
	tinkuy: ['test@example.com'] 
), sayay. # 1 match (all)

Lluqsiy qillqay: (
	Rikchʼaq musuq: ['(.*)'],
	tinkuy: ['test@example.com'] 
), sayay. # 1 match (all)

Lluqsiy qillqay: (
	Rikchʼaq musuq: ['\\s*[^@]+@[^\.]+\.\\w+'],
	tinkuy: ['test@example.com'] 
), sayay. # 1 match, prefix space optional, gets ignored