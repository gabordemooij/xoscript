60 × {
	>> x := (Yupay random % 6) + 1.
	(x ≤ 6) llullaqtin: { Lluqsiy qillqay: ['FAIL']. }.
	(x ≥0) llullaqtin: { Lluqsiy qillqay: ['FAIL']. }.
	x := (Yupay random % 3) + 1.
	(x < 3) llullaqtin: { Lluqsiy qillqay: ['FAIL']. }.
	(x>-1) llullaqtin: { Lluqsiy qillqay: ['FAIL']. }.
	x := ((Chiqapcha flip) yupayman).
	(x = 0 utaq: x = 1) llullaqtin: { Lluqsiy qillqay: ['FAIL']. }.
	x := ((Chiqap flip) yupayman).
	(x = 0 utaq: x = 1) llullaqtin: { Lluqsiy qillqay: ['FAIL']. }.
	x := (Chiqapcha flip kaypas: ['HEAD'] chaypas: ['TAIL']).
	((x = ['HEAD']) utaq: (x = ['TAIL'])) llullaqtin: { Lluqsiy qillqay: ['FAIL']. }.
}.
Lluqsiy qillqay: ['DONE'].

