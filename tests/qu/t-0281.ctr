>> q := Katiray ← 1 ; 2 ; 3.
{ q ? ['1']. } hapiy: { Lluqsiy qillqay: ['caught!'], sayay. }, kallpay.
{ q ? Chiqap. } hapiy: { Lluqsiy qillqay: ['caught!'], sayay. }, kallpay.
{ q ? Llulla. } hapiy: { Lluqsiy qillqay: ['caught!'], sayay. }, kallpay.
{ q ? Mana. } hapiy: { Lluqsiy qillqay: ['caught!'], sayay. }, kallpay.
{ q ? (Katiray musuq). } hapiy: { Lluqsiy qillqay: ['caught!'], sayay. }, kallpay.
{ q ? (Ima musuq). } hapiy: { Lluqsiy qillqay: ['caught!'], sayay. }, kallpay.
{ q ? ({ ['Empty']. }). } hapiy: { Lluqsiy qillqay: ['caught!'], sayay. }, kallpay.
Lluqsiy qillqay: ['caught them all'], sayay.
