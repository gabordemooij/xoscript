>> map1 := Simi-taqi musuq.
>> key1 := Katiray musuq.
>> key2 := Katiray musuq.

map1
	churay: ['hello'] maypi: key1,
	churay: ['world'] maypi: key2.


Lluqsiy
	qillqay: ['Map #1 contains: '] + (map1 maypi: key1),
	qillqay: [' and '] + (map1 maypi: key2), sayay.

>> KeyeableArray := Katiray musuq.
KeyeableArray patapi: ['toString'] ruway: { <- (kikin hayka?) toString.
}.

>> map2 := Simi-taqi musuq.
key1 := KeyeableArray musuq.
key2 := KeyeableArray musuq.

key1 yapay-qhepaman: 1.

map2
	churay: ['hello'] maypi: key1,
	churay: ['world'] maypi: key2.

Lluqsiy
	qillqay: ['Map #2 contains: '] + (map2 maypi: key1),
	qillqay: [' and '] + (map2 maypi: key2), sayay.
