

>> Matryoshka := Ima musuq.
Matryoshka patapi: ['double:'] ruway: { :secret
	ñuqap secret := secret × 2.
}.
Matryoshka patapi: ['musuq:'] ruway: { :secret
	>> answer := Mana.
	>> t := (secret > 255).
	Lluqsiy qillqay: (secret + [' | '] + t), sayay.
	t chiqapqtin: {
		answer := secret.
	}, manahinaqa: {
		answer := Matryoshka kutipari musuq: (kikin double: secret).
	}. <- answer.
}.

>> x := Matryoshka musuq: 2.
