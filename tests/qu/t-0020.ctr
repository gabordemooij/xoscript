(Mana = Mana) chiqapqtin: { Lluqsiy qillqay: ['Nil is Nil!'].}.
(2 > 1) chiqapqtin: { Lluqsiy qillqay: ['YES']. }.
(2 > 3) chiqapqtin: { Lluqsiy qillqay: ['NO']. }.
(2 > 3) llullaqtin: { Lluqsiy qillqay: ['Nonono..'].}.
Chiqap chiqapqtin: { Lluqsiy qillqay: ['TRUE is TRUE!']. }.
(Chiqap) chiqapqtin: { Lluqsiy qillqay: ['TRUE is TRUE!']. }.
Llulla llullaqtin: { Lluqsiy qillqay: ['FALSE is FALSE!']. }.
(Llulla) llullaqtin: { Lluqsiy qillqay: ['FALSE is FALSE!']. }.
