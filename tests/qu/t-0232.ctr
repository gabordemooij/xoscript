>> Slurp := Ima musuq.

Slurp patapi: ['musuq'] ruway: {
	ñuqap str := [''].
}.

Slurp patapi: ['kutichiy:'] ruway: { :blah
		(ñuqap str = ['']) chiqapqtin: {
			ñuqap str yapay-qhepaman: blah.
		}, manahinaqa: {
			ñuqap str yapay-qhepaman: [' '].
			ñuqap str yapay-qhepaman: blah.
		}.
}.

Slurp patapi: ['kutichiy:wan:'] ruway: { :blah :blahah
		(blah suni > 1) chiqapqtin: {
			ñuqap str yapay-qhepaman: (blah manta: 0 suni: (blah suni - 1)).
		}, manahinaqa: {
			ñuqap str yapay-qhepaman: blah.
		}.
		ñuqap str yapay-qhepaman: [' '].
		ñuqap str yapay-qhepaman: blahah.
}.

Slurp patapi: ['obtain'] ruway: {
	>> buffer := ñuqap str.
	ñuqap str := ['']. <- buffer.
}.


>> x := Slurp musuq.
x + 3.
Lluqsiy qillqay: (x obtain), sayay.
x echo: ['Hello world'].
Lluqsiy qillqay: (x obtain), sayay.
x tellme: 123 and: 987.
Lluqsiy qillqay: (x obtain), sayay.
