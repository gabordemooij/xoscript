Lluqsiy qillqay: ['Test object'], sayay.
>> cmd := Kamachina musuq.
Lluqsiy qillqay: cmd ls /tmp, sayay.
>> old-cmd-address := cmd ñawpaq-rikchʼay yuyay-tiyanan.
cmd save-as: ['/tmp/a.bin'].
Lluqsiy qillqay: ['========== RELOADING SNAP:'], sayay.
>> b := Ima load-from: ['/tmp/a.bin'].
(b ñawpaq-rikchʼay yuyay-tiyanan = old-cmd-address) chiqapqtin: {
	Lluqsiy qillqay: ['Object link re-attached.'], sayay.
}.
Lluqsiy qillqay: b ls, sayay.


