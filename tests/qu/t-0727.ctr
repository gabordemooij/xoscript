Server init.
>> f := Formato musuq: ['%d'].
>> a := Blob musuq: 4.
a bytes: ( Katiray musuq ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob musuq: 4.
b bytes: ( Katiray musuq ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a manta: 0 suni: 3, sapallanpaq: { :i :byte
	Lluqsiy qillqay: ( f rurachiy-yupay-huntasqa: byte ), sayay.
}.
a ^ b.
a manta: 0 suni: 3, sapallanpaq: { :i :byte
	Lluqsiy qillqay: ( f rurachiy-yupay-huntasqa: byte ), sayay.
}.
a ^ b.
a manta: 0 suni: 3, sapallanpaq: { :i :byte
	Lluqsiy qillqay: ( f rurachiy-yupay-huntasqa: byte ), sayay.
}.
a kacharichiy.
b kacharichiy.

{ a ^ Ima. } hapiy: { :e Lluqsiy qillqay: e, sayay. }, kallpay.
