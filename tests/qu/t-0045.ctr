Programa chʼuya: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } hapiy: {
		oops yapay: 1.
	}, kallpay.
} × 1000.

{
	Lluqsiy qillqay: ['hi there!'].
	kay-ruway pantay: ['oops'].
	Lluqsiy qillqay: ['hi there!'].
	{ Lluqsiy qillqay: ['dont print this']. } kallpay.
} hapiy: { :e 
	Lluqsiy qillqay: ['got ya!']. 
	Lluqsiy qillqay: e.
}, kallpay.
