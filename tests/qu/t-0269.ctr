#Linux

(Khipu musuq: ['/tmp/testje']) kan llullaqtin: {
	Programa karacha: ['mkdir /tmp/testje'].	
}.

(Khipu musuq: ['/tmp/testje/file1']) kan llullaqtin: {
	Programa karacha: ['touch /tmp/testje/file1'].	
}.

(Khipu musuq: ['/tmp/testje/folder1']) kan llullaqtin: {
	Programa karacha: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Khipu katiray: ['/tmp/testje'].

>> q := Katiray musuq.

l sapallanpaq: { :k :v v sapallanpaq: { :x :y q yapay-qhepaman: y. }. }.

>> s := q qillqaman.

(s kapun: ['file1']) chiqapqtin:   { Lluqsiy qillqay: ['OK'], sayay. }.
(s kapun: ['file2']) chiqapqtin:   { Lluqsiy qillqay: ['XX'], sayay. }.
(s kapun: ['folder1']) chiqapqtin: { Lluqsiy qillqay: ['OK'], sayay. }.
