>> x := [' hallo '].

>> y := x hatunman.
Lluqsiy qillqay: x, sayay.
Lluqsiy qillqay: (x kikinlla: y), sayay.

>> y := x huchʼuyman.
Lluqsiy qillqay: x, sayay.
Lluqsiy qillqay: (x kikinlla: y), sayay.

>> y := x muyuriq-kʼichiykuna-qichuy.
Lluqsiy qillqay: x, sayay.
Lluqsiy qillqay: (x kikinlla: y), sayay.

>> y := x pasay: 1.
Lluqsiy qillqay: x, sayay.
Lluqsiy qillqay: (x kikinlla: y), sayay.

>> y := x manta: 1 suni: 2.
Lluqsiy qillqay: x, sayay.
Lluqsiy qillqay: (x kikinlla: y), sayay.