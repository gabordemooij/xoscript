>> str := ['write:'].
Lluqsiy willay: ['qillqay:'] hapina: (Katiray ← ['Hello World']), sayay. 

Yupay patapi: ['isbetween:and:'] ruway: { :a :b <- ((kikin ≥ a) wan: (kikin ≤ b)).
}.

str := ['isbetween:and:'].
Lluqsiy qillqay: (3 willay: str hapina: (Katiray ← 2 ; 8)), sayay.
Lluqsiy qillqay: (3 willay: str hapina: (Katiray ← 1 ; 2)), sayay.


>> CoffeeMachine := Ima musuq.
CoffeeMachine patapi: ['makeCoffeeWithSugar:milk:'] ruway: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Katiray ← 4 ; 2.
Lluqsiy qillqay: ( CoffeeMachine willay: order hapina: coffeeConfiguration ), sayay.
