>> t := Chiqap.
(t = Chiqap) chiqapqtin: { Lluqsiy qillqay: ['T']. }.
(t = Llulla) chiqapqtin: { Lluqsiy qillqay: ['F']. }.
Lluqsiy qillqay: ['|'].
>> t := Llulla.
(t = Chiqap) chiqapqtin: { Lluqsiy qillqay: ['T']. }.
(t = Llulla) chiqapqtin: { Lluqsiy qillqay: ['F']. }.
Lluqsiy qillqay: ['|'].
>> f := Chiqap.
(t = Chiqap wan: f = Llulla) chiqapqtin: { Lluqsiy qillqay: ['T']. }.
(t = Llulla wan: f = Chiqap) chiqapqtin: { Lluqsiy qillqay: ['F']. }.
Lluqsiy qillqay: ['|'].
>> n := Mana.
(n Manachu?) chiqapqtin: { Lluqsiy qillqay: ['T']. }.
(n Manachu?) llullaqtin: { Lluqsiy qillqay: ['F']. }.
Lluqsiy qillqay: ['|'].
(f Boolean?) chiqapqtin: { Lluqsiy qillqay: ['T']. }.
(f Boolean?) llullaqtin: { Lluqsiy qillqay: ['F']. }.



