

# reference in world.c

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.
>> codigo := {
	>> a := Simi-taqi musuq.
	>> b := Simi-taqi musuq.
	a tinkichiy: b.
	b tinkichiy: a.
}.
Programa chʼuya: 0.
Programa yuyay-pichay.
usedMemory1 := (Programa yuyay ? 0).
codigo kallpay.
Programa yuyay-pichay.
usedMemory2 := (Programa yuyay ? 0).
codigo kallpay.
Programa yuyay-pichay.
usedMemory3 := (Programa yuyay ? 0).
( usedMemory1 = usedMemory2 wan: usedMemory1 = usedMemory3, wan: usedMemory2 = usedMemory3 ) chiqapqtin: {
	Lluqsiy qillqay: ['No memory leaks here'].
}, llullaqtin: {
	Lluqsiy qillqay: ['Leaking memory...'].
}.
