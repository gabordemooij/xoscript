Server init.

>> DB := Maria-DB musuq samachiq: ['localhost'],
	ruraqpa-sutin: ['xo'],
	pakasqa-simi: ['pass123'],
	willay-waqaychanap-sutin: ['xobase'],
	tinkiy.

{
	DB tapuy:
	['DROP TABLE movies'],
	huntʼachiy.
} hapiy: { Mana. }, kallpay.

DB tapuy:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
huntʼachiy.

DB tapuy: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
tupukuna: ( Katiray musuq ; ['Halloween'] ),
huntʼachiy.

DB tapuy: ['SELECT * FROM movies'],
apamuy: { :movie
	Lluqsiy qillqay: movie title, sayay.
}.

