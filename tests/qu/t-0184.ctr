

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa chʼuya: 0.

Yupay patapi: ['addNum:'] ruway: { :x
	kikin yapay: x.
}.

Yupay patapi: ['subtractNum:'] ruway: { :x
	kikin qichuy: x.
}.

Yupay patapi: ['multiplyBy:'] ruway: { :x
	kikin mirachiy-rayku: x.
}.

Yupay patapi: ['divideBy:'] ruway: { :x
	kikin rakiy-rayku: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 atiy: 8).  
a := a + (2 atiy: -1). 
a := a + (49 iskay-saphi).   
a addNum: ((Katiray ← 0 ; 1) aswan-achka).          
a addNum: ((Katiray ← 2 ; 3) aswan-pisi).
Lluqsiy qillqay: a.

Programa yuyay-pichay.

usedMemory1 := (Programa yuyay ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 atiy: 8).  
a := a + (2 atiy: -1). 
a := a + (49 iskay-saphi).   
a addNum: ((Katiray ← 0 ; 1) aswan-achka).          
a addNum: ((Katiray ← 2 ; 3) aswan-pisi).
Lluqsiy qillqay: a.

Programa yuyay-pichay.
usedMemory2 := (Programa yuyay ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 atiy: 8).  
a := a + (2 atiy: -1). 
a := a + (49 iskay-saphi).   
a addNum: ((Katiray ← 0 ; 1) aswan-achka).          
a addNum: ((Katiray ← 2 ; 3) aswan-pisi).
Lluqsiy qillqay: a.

Programa yuyay-pichay.
usedMemory3 := (Programa yuyay ? 0).



( usedMemory1 = usedMemory2 wan: usedMemory1 = usedMemory3, wan: usedMemory2 = usedMemory3 ) chiqapqtin: {
	Lluqsiy qillqay: ['No memory leaks here'].
}, llullaqtin: {
	Lluqsiy qillqay: ['Leaking memory...'].
}.
