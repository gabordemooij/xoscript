Qillqa patapi: ['html'] ruway: { <- (
		kikin
		rantinpay: ['&'] kayta: ['&amp;'],
		rantinpay: ['<'] kayta: ['&lt;'],
		rantinpay: ['>'] kayta: ['&gt;'],
		rantinpay: ['''] kayta: ['&apos;'],
		rantinpay: ['"'] kayta: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa chʼuya: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Lluqsiy qillqay: txt kikinchasqa html, sayay.
Lluqsiy qillqay: txt kikinchasqa huchʼuyman, sayay.
Lluqsiy qillqay: txt kikinchasqa hatunman, sayay.
} kallpay.

Programa yuyay-pichay.

usedMemory1 := (Programa yuyay ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Lluqsiy qillqay: txt kikinchasqa html, sayay.
Lluqsiy qillqay: txt kikinchasqa huchʼuyman, sayay.
Lluqsiy qillqay: txt kikinchasqa hatunman, sayay.
} kallpay.

Programa yuyay-pichay.
usedMemory2 := (Programa yuyay ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Lluqsiy qillqay: txt kikinchasqa html, sayay.
Lluqsiy qillqay: txt kikinchasqa huchʼuyman, sayay.
Lluqsiy qillqay: txt kikinchasqa hatunman, sayay.
} kallpay.

Programa yuyay-pichay.
usedMemory3 := (Programa yuyay ? 0).



( usedMemory1 = usedMemory2 wan: usedMemory1 = usedMemory3, wan: usedMemory2 = usedMemory3 ) chiqapqtin: {
	Lluqsiy qillqay: ['No memory leaks here'].
}, llullaqtin: {
	Lluqsiy qillqay: ['Leaking memory...'].
}.
