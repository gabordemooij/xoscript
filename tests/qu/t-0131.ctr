
>> a := Katiray ← (Katiray ← 100 ; 200 ; 300) ; (Katiray ← 9 ; 8 ; 7).
Lluqsiy qillqay: ['at 0,1 :'].
Lluqsiy qillqay: a ? 0 ? 1, sayay. 
Lluqsiy qillqay: ['at 1,2 :'].
Lluqsiy qillqay: a ? 1 ? 2, sayay. 
>> menu := Simi-taqi musuq.
menu churay: (Katiray ← ['pizza'] ; ['spaghetti']) maypi: ['Italian Cuisine'].
menu churay: (Katiray ← ['bifteki'] ; ['suflaki']) maypi: ['Greek Cuisine'].
Lluqsiy qillqay: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), sayay. 
Lluqsiy qillqay: ['but not on the same plate.'], sayay.
