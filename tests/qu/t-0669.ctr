# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Waqaychana 
	pakasqa-simi-hash: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Waqaychana 
	pakasqa-simi-hash: hash chiqapchay: a1.
	# fail 
>> b := Waqaychana
	pakasqa-simi-hash: hash chiqapchay: a2.
	# ok!

Lluqsiy qillqay: a, sayay.
Lluqsiy qillqay: b, sayay.

