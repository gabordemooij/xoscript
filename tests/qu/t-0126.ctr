#Linux
>> Slurp := Ima musuq.

Slurp patapi: ['musuq'] ruway: {
	ñuqap str := [''].
}.

Slurp patapi: ['nieuw'] ruway: {
	ñuqap str := [''].
}.

Slurp patapi: ['kutichiy:'] ruway: { :blah
		ñuqap str yapay-qhepaman: blah.
}.

Slurp patapi: ['kutichiy:wan:'] ruway: { :blah :blahah
		ñuqap str yapay-qhepaman: (blah manta: 0 suni: (blah suni - 1)).
		ñuqap str yapay-qhepaman: [' '].
		ñuqap str yapay-qhepaman: blahah.
}.

Slurp patapi: ['obtain'] ruway: {
	>> buffer := ñuqap str.
	ñuqap str := ['']. <- buffer.
}.


Lluqsiy qillqay: (Programa karacha: (Slurp musuq echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Khipu musuq: ['/tmp/from.txt'], pichay. } hapiy: { ['Empty']. }, kallpay.
{ Khipu musuq: ['/tmp/to.txt'], pichay. } hapiy: { ['Empty']. }, kallpay.


Khipu musuq: ['/tmp/to.txt'], kan llullaqtin: {
	Lluqsiy qillqay: ['Confirmed. Target file does not exist.\
'].
}.
Khipu musuq: ['/tmp/from.txt'], kan llullaqtin: {
	Lluqsiy qillqay: ['Confirmed. Source file does not exist.\
'].
}.



Programa karacha: (Slurp musuq touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Programa karacha: (Slurp musuq cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Khipu musuq: ['/tmp/to.txt'], kan chiqapqtin: {
	Lluqsiy qillqay: ['Confirmed. Target file has been created by shell.\
'].
}.


Lluqsiy qillqay: ['Contents of file is:'] + (Khipu musuq: ['/tmp/to.txt'], ñawiy), sayay.
