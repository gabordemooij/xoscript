>> items := Simi-taqi musuq.
items churay: ['black'] maypi: ['coffee'], churay: ['earl grey'] maypi: ['tea'].
Lluqsiy qillqay: (items maypi: ['coffee']), qillqay: (items maypi: ['tea']).
Lluqsiy qillqay: ['there are'] + items hayka? + [' items in the array.'].
items churay: ['capuccino'] maypi: ['coffee'].
Lluqsiy qillqay: ['Now my coffee is.. '] + (items maypi: ['coffee']).
items churay: ['aaa'] maypi: ['1'].
items churay: ['bbb'] maypi: ['2'].
Lluqsiy qillqay: (items maypi: ['a']).
