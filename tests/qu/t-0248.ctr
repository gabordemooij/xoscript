

Qillqa patapi: ['evaluate'] ruway: {
	>> codigo := Khipu musuq: ['/tmp/eval.ctr'].
	codigo qillqay: kikin qillqaman + ['.'].
	Programa llamkʼachiy: ['/tmp/eval.ctr'].
}.

>> a := (Katiray ← (
	(Simi-taqi musuq)
		churay: ['domain'] maypi: ['mywebsite.com'],
		churay: (Katiray ←
			((Simi-taqi musuq)
				churay: ['home'] maypi: ['title'],
				churay: ['<html></html>'] maypi: ['body'],
				churay: ['2017-01-01'] maypi: ['created']
			) ;
			((Simi-taqi musuq)
				churay: ['aboutus(c)'] maypi: ['title'],
				churay: ['<credits>Author Inc.</credits>'] maypi: ['body']
			)
		) maypi: ['pages']
	)
) qillqaman.

Lluqsiy qillqay: a laya, sayay.
Lluqsiy qillqay: a, sayay.

>> b := Mana.
(['b := '] + a) evaluate.
Lluqsiy qillqay: b ? 0 ? ['pages'] ? 1 ? ['body'], sayay.

>> c := b ? 0.
>> d := c qillqaman.
Lluqsiy qillqay: d laya, sayay.

>> e := Mana.
(['e := '] + d) evaluate.
Lluqsiy qillqay: e ? ['pages'] ? 0, sayay.
