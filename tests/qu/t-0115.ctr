{
	kay-ruway pantay: ['Dont fail.'].
	unknown doSomething.
} hapiy: {
	Lluqsiy qillqay: ['Caught!'].
}, kallpay.

{
	kay-ruway pantay: ['Dont fail.'].
	ñuqap unknown doSomething.
} hapiy: {
	Lluqsiy qillqay: ['Caught!'].
}, kallpay.

{
	kay-ruway pantay: ['Dont fail.'].
	unknown := 122.
} hapiy: {
	Lluqsiy qillqay: ['Caught!'].
}, kallpay.


{
	kay-ruway pantay: ['Dont fail.'].
	Chiqap kuchuy.
	Lluqsiy qillqay: ['FAIL'].
} hapiy: {
	Lluqsiy qillqay: ['Caught!'].
}, kallpay.

{
	{
		kay-ruway pantay: ['Dont fail.'].
		Chiqap kuchuy.
		Lluqsiy qillqay: ['FAIL'].
	} hapiy: { :x
		(x = ['Dont fail.']) chiqapqtin: { kay-ruway pantay: ['Nested Caught!']. }.
	}, kallpay.
} hapiy: { :e
	Lluqsiy qillqay: e.
}, kallpay.
