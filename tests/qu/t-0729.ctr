Server init.
>> a := Blob musuq: 4.
a bytes: ( Katiray musuq ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob musuq: 4.
b bytes: ( Katiray musuq ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a ^ b.
{
	a ^ ( Khipu musuq: ['noblob???'] ).
} hapiy: { :e Lluqsiy qillqay: e, sayay. }, kallpay.
a kacharichiy.
b kacharichiy.
