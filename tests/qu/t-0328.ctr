Programa chʼuya: 4.

>> Doubler := Ima musuq.
>> Multiplier := Ima musuq.
Doubler patapi: ['double:and:'] ruway: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier patapi: ['multiply:and:'] ruway: { :x :y <- (x × y).
}.

Lluqsiy qillqay: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), sayay.
