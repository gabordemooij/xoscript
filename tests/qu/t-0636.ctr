# test url parsing

Server init.
>> url := URL kaymanta: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Lluqsiy qillqay: ['scheme = '] + url esquema, sayay.
Lluqsiy qillqay: ['host = '] + url samachiq, sayay.
Lluqsiy qillqay: ['port = '] + url punku, sayay.
Lluqsiy qillqay: ['path = '] + url ñan, sayay.
Lluqsiy qillqay: ['query = '] + url maskana-tupukuna, sayay.
Lluqsiy qillqay: ['fragment = '] + url phatmi, sayay.
