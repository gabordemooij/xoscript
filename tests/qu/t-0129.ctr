
Katiray patapi: ['product'] ruway: {
	>> total := 1.
	kikin sapallanpaq: { :index :element
		total mirachiy-rayku: element.
	}. <- total.
}.

>> a := Katiray ← 1 ; 2 ; 3.
Lluqsiy qillqay: a product, sayay.
Lluqsiy qillqay: (Katiray ← 2 ; 4 ; 8) product, sayay. 
Lluqsiy qillqay: (Katiray ← -2 ; 10) product, sayay. 
Lluqsiy qillqay: (Katiray ← 0.5 ; -2) product, sayay. 
