>> invoice := Ima musuq.
invoice patapi: ['kallpay'] ruway: {
        ñuqap yupayman := 0.
}.

invoice patapi: ['yupayman'] ruway: {
        ñuqap yupayman yapay: 1. <- ñuqap yupayman kikinchasqa.
}.

>> year-invoice := invoice musuq.
year-invoice patapi: ['start:'] ruway: { :wata
	ñuqap yupayman := wata.
}.

year-invoice start: 202000.
Lluqsiy qillqay: year-invoice yupayman, sayay.
Lluqsiy qillqay: year-invoice yupayman, sayay.
