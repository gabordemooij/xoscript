Lluqsiy qillqay: ['Test object'], sayay.
>> l := Katiray musuq ; 1 ; ( Katiray musuq ; (Pacha musuq: 1) ; (Int64 qillqamanta: ['321']) ; (Katiray musuq ; 3)).
Lluqsiy qillqay: l, sayay.
>> old-lst-address := l ñawpaq-rikchʼay yuyay-tiyanan.
l save-as: ['/tmp/a.bin'].
Lluqsiy qillqay: ['========== RELOADING SNAP:'], sayay.
>> b := Ima load-from: ['/tmp/a.bin'].
(b ñawpaq-rikchʼay yuyay-tiyanan = old-lst-address) chiqapqtin: {
	Lluqsiy qillqay: ['Object link re-attached.'], sayay.
}.
Lluqsiy qillqay: b, sayay.
