
>> Rectangle := Ima musuq.

Rectangle patapi: ['area'] ruway: { <- ñuqap suni * ñuqap width.
}.

Rectangle patapi: ['length:'] ruway: { :suni
	ñuqap suni := suni.
}.

Rectangle patapi: ['width:'] ruway: { :width
	ñuqap width := width.
}.

Rectangle patapi: ['musuq'] ruway: {
	# this will not result into an infinite loop
	>> rectangle := kikin musuq.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle musuq.
Lluqsiy qillqay: a area, sayay. #0

>> b := Rectangle musuq length: 2, width: 3.
Lluqsiy qillqay: b area, sayay. #6

