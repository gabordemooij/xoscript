

Katiray patapi: ['sum'] ruway: {
	>> total := 0.
	kikin sapallanpaq: { :index :element
		total yapay: element.
	}. <- total.
}.

Katiray patapi: ['product'] ruway: {
	>> total := 1.
	kikin sapallanpaq: { :index :element
		total mirachiy-rayku: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa chʼuya: 0.

{

>> a := Katiray ← ['hello'] ; ['world'] ; Chiqap ; Mana ; 666.
a := a + ( Katiray ← 1 ).
Lluqsiy qillqay: ( ['sum: '] + ( a sum ) ), sayay.
Lluqsiy qillqay: ( ['min: '] + ( a aswan-pisi ) ), sayay.
Lluqsiy qillqay: ( ['max: '] + ( a aswan-achka ) ), sayay.
Lluqsiy qillqay: ( ['3rd: '] + ( a ? 2 ) ), sayay.
Lluqsiy qillqay: ( ['prd: '] + ( a product ) ), sayay.
a kamachiy: { :a :b <- (b - a). }.
a sapallanpaq: { :i :e Lluqsiy qillqay: ( i - 0 ), sayay. }.

} kallpay.

Programa yuyay-pichay.
usedMemory1 := (Programa yuyay ? 0).


{

>> a := Katiray ← ['hello'] ; ['world'] ; Chiqap ; Mana ; 666.
a := a + ( Katiray ← 1 ).
Lluqsiy qillqay: ( ['sum: '] + ( a sum ) ), sayay.
Lluqsiy qillqay: ( ['min: '] + ( a aswan-pisi ) ), sayay.
Lluqsiy qillqay: ( ['max: '] + ( a aswan-achka ) ), sayay.
Lluqsiy qillqay: ( ['3rd: '] + ( a ? 2 ) ), sayay.
Lluqsiy qillqay: ( ['prd: '] + ( a product ) ), sayay.
a kamachiy: { :a :b <- (b - a). }.
a sapallanpaq: { :i :e Lluqsiy qillqay: ( i - 0 ), sayay. }.

} kallpay.



Programa yuyay-pichay.
usedMemory2 := (Programa yuyay ? 0).


{

>> a := Katiray ← ['hello'] ; ['world'] ; Chiqap ; Mana ; 666.
a := a + ( Katiray ← 1 ).
Lluqsiy qillqay: ( ['sum: '] + ( a sum ) ), sayay.
Lluqsiy qillqay: ( ['min: '] + ( a aswan-pisi ) ), sayay.
Lluqsiy qillqay: ( ['max: '] + ( a aswan-achka ) ), sayay.
Lluqsiy qillqay: ( ['3rd: '] + ( a ? 2 ) ), sayay.
Lluqsiy qillqay: ( ['prd: '] + ( a product ) ), sayay.
a kamachiy: { :a :b <- (b - a). }.
a sapallanpaq: { :i :e Lluqsiy qillqay: ( i - 0 ), sayay. }.

} kallpay.



Programa yuyay-pichay.
usedMemory3 := (Programa yuyay ? 0).

( usedMemory1 = usedMemory2 wan: usedMemory1 = usedMemory3, wan: usedMemory2 = usedMemory3 ) chiqapqtin: {
	Lluqsiy qillqay: ['No memory leaks here'].
}, llullaqtin: {
	Lluqsiy qillqay: ['Leaking memory...'].
}.
