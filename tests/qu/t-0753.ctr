Lluqsiy qillqay: ['Test object'], sayay.
>> a := Ima musuq. 

a patapi: ['item:'] ruway: { :fmt
	ñuqap fmt := fmt. 
}.

a patapi: ['item'] ruway: { <- ñuqap fmt.
}.

a item: ( Formato musuq: ['|%s|'] ).

Lluqsiy qillqay: a item, sayay.

>> old-fmt-address := a item ñawpaq-rikchʼay yuyay-tiyanan.
a save-as: ['/tmp/a.bin'].
Lluqsiy qillqay: ['========== RELOADING SNAP:'], sayay.

>> b := Ima load-from: ['/tmp/a.bin'].

(b item ñawpaq-rikchʼay yuyay-tiyanan = old-fmt-address) chiqapqtin: {
	Lluqsiy qillqay: ['Object link re-attached.'], sayay.
}.

Lluqsiy qillqay: ( b item rurachiy: ['hello'] ), sayay.
