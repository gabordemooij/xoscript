# Test ASCII variants

# Numbers

Lluqsiy qillqay: (2 !=: 3), sayay.
Lluqsiy qillqay: (2 <=: 2), sayay.
Lluqsiy qillqay: (2 >=: 2), sayay.

# Strings

Lluqsiy qillqay: (['b'] >=: ['a']), sayay.
Lluqsiy qillqay: (['b'] !=: ['a']), sayay.
Lluqsiy qillqay: (['b'] <=: ['c']), sayay.

# Bools

Lluqsiy qillqay: (Chiqap !=: Llulla), sayay.

# Objects

Lluqsiy qillqay: (Ima musuq !=: Ima musuq), sayay.

# ASCII list symbol <-:

Lluqsiy qillqay: (Katiray <<: 1, ; 2 ; 3) hayka? = 3, sayay.

