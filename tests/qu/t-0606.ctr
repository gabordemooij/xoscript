>> Point := Ima musuq.
Point patapi: ['x-coordinate:'] ruway: { :x ñuqap x := x. }.
Point patapi: ['y-coordinate:'] ruway: { :y ñuqap y := y. }.
Point patapi: ['x-coordinate']  ruway: { <- ñuqap x kikinchasqa. }.
Point patapi: ['y-coordinate']  ruway: { <- ñuqap y kikinchasqa. }.

Point patapi: ['='] ruway: { :other <- ( ñuqap x = other x-coordinate
		 wan: ñuqap y = other y-coordinate ).
}.

>> pier := Point musuq x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point musuq x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point musuq x-coordinate: 5, y-coordinate: 6.

Lluqsiy qillqay: pier = town-hall, sayay.
Lluqsiy qillqay: pier = restaurant, sayay.
