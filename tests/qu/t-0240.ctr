# test qualifiers

>> $ := Ima musuq.

$ patapi: ['kutichiy:'] ruway: { :x
	
	>> operation := x simi: 0.
	>> valuta := x simi: 1.
	>> money := x pasay: 2.
	
	>> amount := 0.

	( operation = ['+'] ) chiqapqtin: {
		( valuta = ['£'] ) chiqapqtin: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Lluqsiy qillqay: x, sayay.


>> Fruit := Ima musuq.

Fruit patapi: ['musuq'] ruway: {
	>> f := kikin musuq.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit patapi: ['apples:'] ruway: { :a ñuqap apples := a. }.
Fruit patapi: ['oranges:'] ruway: { :p ñuqap oranges := p. }.
Fruit patapi: ['apples'] ruway: { <- ñuqap apples. }.
Fruit patapi: ['oranges'] ruway: { <- ñuqap oranges. }.

Fruit patapi: ['+'] ruway: { :f
	
	>> n := Fruit musuq.
	f yapay: 1.
	
	n apples: (f apples + ñuqap apples).
	n oranges:  (f oranges  + ñuqap oranges). <- n.
}.

Fruit patapi: ['qillqaman'] ruway: { <- ( ñuqap apples qillqaman + [' apples and '] + ñuqap oranges + [' oranges'] ).
}.

Yupay patapi: ['apples'] ruway: { <- ((Fruit musuq) apples: kikin).
}.

Yupay patapi: ['apple'] ruway: { <- ((Fruit musuq) apples: kikin).
}.

Yupay patapi: ['oranges'] ruway: { <- ((Fruit musuq) oranges: kikin).
}.




Lluqsiy qillqay: (1 apple + 3 oranges + 4 apples), sayay.


Qillqa patapi: ['twice'] ruway: { <- ((kikin qillqaman) + (kikin qillqaman)).
}.



Lluqsiy qillqay: ['❤❤❤'] twice.



