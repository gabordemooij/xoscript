
>> Animal := Ima musuq.
Animal patapi: ['musuq'] ruway: { <- kikin musuq init.
}.

Animal patapi: ['init'] ruway: {
	ñuqap sound := ['?'].
	ñuqap legs := 4.
}.

>> Dog := Animal musuq.
Dog patapi: ['init'] ruway: {
	kikin init.
	ñuqap sound := ['barks'].
}.

Animal patapi: ['qillqaman'] ruway: { <- ñuqap legs qillqaman + ñuqap sound.
}.

>> poodle := Dog musuq.
Lluqsiy qillqay: poodle, sayay.

