


>> wine := Ima musuq.


wine patapi: ['toString'] ruway: { <- ['merlot'].
}.

wine patapi: ['naarTekst'] ruway: { <- ['merlot'].
}.


wine patapi: ['='] ruway: { :other wine <- ( kikin toString = other wine ).
}.

wine patapi: ['=='] ruway: { :other wine <- ( kikin toString = other wine ).
}.



wine
	chayqa: ['cabernet'] ruway: { Lluqsiy qillqay: ['it's a Cabernet!']. },
	chayqa: ['syrah']    ruway: { Lluqsiy qillqay: ['it's a Syrah!'].    },
	chayqa: ['merlot']   ruway: { Lluqsiy qillqay: ['it's a Merlot!'].   },
	chayqa: ['malbec']   ruway: { Lluqsiy qillqay: ['it's a Malbec!'].   }.

Lluqsiy sayay.
