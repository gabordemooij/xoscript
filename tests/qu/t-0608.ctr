
>> Size := Ima musuq.
Size patapi: ['is:'] ruway: { :yupayman
	yupayman patapi: ['+'] ruway: { :yupayman
		>> unit := yupayman suti-quy.
		>> factor := 1.
		
		unit
		chayqa: ['inch'] ruway: { factor := 0.0833. }. <- kikin + (yupayman * factor).
	}. <- yupayman.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Lluqsiy qillqay: plank + edge, sayay.
