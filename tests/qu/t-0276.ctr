>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Ima musuq.
⚄ patapi: ['drawFrom:length:'] ruway: { :pool :hayka?
	
	>> result := [''].
	
	{
		>> index := Yupay random % (pool suni).
		result yapay-qhepaman: ( pool simi: (index + 1) ).
		
	} × hayka?. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? suni.
Lluqsiy qillqay: (['x↵'] x random suni).
Lluqsiy qillqay: (['y↵'] y ?? suni).

