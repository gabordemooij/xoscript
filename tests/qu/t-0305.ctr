
Yupay yachay: ['plus:'] nispa: ['+'].
Yupay patapi: ['+'] ruway: { :x
	>> rate := 1.
	>> currency := x suti-quy.
	(currency = ['euros']) chiqapqtin: {
		rate := 2.
	}. <- (kikin plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars suti-quy: ['dollars'].
euros suti-quy: ['euros'].
>> money := dollars + euros.
Lluqsiy qillqay: money, sayay.
