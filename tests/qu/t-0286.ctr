['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Lluqsiy qillqay: (x + y), sayay.

>> x := 10040.07.
>> y := 10305.60.

Lluqsiy qillqay: (x + y), sayay.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Lluqsiy qillqay: (x + y + z), sayay.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Lluqsiy qillqay: (x + y + z), sayay.

>> q := 0.1.2.

Lluqsiy qillqay: (q), sayay.

>> q := 012.

Lluqsiy qillqay: (q), sayay.
