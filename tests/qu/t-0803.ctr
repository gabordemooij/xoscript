>> del := conn1 tapuy: ['DELETE FROM book WHERE id > 0'].
{  del huntʼachiy. conn1 takyachiy. } hapiy: { :e conn1 kutichipuy.  }, kallpay.

>> insert := conn1 tapuy: ['INSERT INTO book (id) VALUES(null)'].
insert huntʼachiy.

>> hayka? := conn1 tapuy: ['SELECT COUNT(*) AS num FROM book'].
hayka? apamuy: { :row Lluqsiy qillqay: row num, sayay. }.

# does not show up
