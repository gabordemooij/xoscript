
>> Greeter := Ima musuq.
Greeter patapi: ['musuq'] ruway: {
	ñuqap suti := ['?'].
}.
Greeter patapi: ['name:'] ruway: { :suti
	ñuqap suti := suti.
}.
Greeter patapi: ['greet'] ruway: {
	Lluqsiy qillqay: (['hello[you]'] [you]: ñuqap suti).
}.
>> friend := Greeter musuq.
friend name: ['1'].
friend greet.
