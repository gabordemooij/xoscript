# compliance test

# use international numbers

Lluqsiy qillqay: ['1000 -> '].
Lluqsiy qillqay: 1000, sayay. #1000

Lluqsiy qillqay: ['1.5 -> '].
Lluqsiy qillqay: 1.5, sayay.  #1.5

Lluqsiy qillqay: ['1001.5 -> '].
Lluqsiy qillqay: 1.5 + 1000, sayay. #1001.5

# use 0-indexed arrays
>> x := Katiray musuq ; 1 ; 2 ; 3.
>> y := Katiray musuq ; ['a'] ; ['b'] ; ['c'].

Lluqsiy qillqay: ['1 -> '].
Lluqsiy qillqay: x ? 0, sayay. #1

Lluqsiy qillqay: ['1 -> '].
Lluqsiy qillqay: (x maypi: 0), sayay. #1

Lluqsiy qillqay: ['1 -> '].
Lluqsiy qillqay: x ñawpaq, sayay. #1

Lluqsiy qillqay: ['3 -> '].
Lluqsiy qillqay: x qhepa, sayay. #3

Lluqsiy qillqay: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Lluqsiy qillqay: (x rayku: y), sayay.

Lluqsiy qillqay: ['1 -> '].
Lluqsiy qillqay: (x manta: 0 suni: 1) ñawpaq, sayay. #1

Lluqsiy qillqay: ['0 -> '].
Lluqsiy qillqay: (x maskay: 1), sayay. #0

x churay: 9 maypi: 0.

Lluqsiy qillqay: ['9 -> '].
Lluqsiy qillqay: (x maypi: 0), sayay. #9

x yapay-ñawpaqman: 8.
Lluqsiy qillqay: ['8 -> '].
Lluqsiy qillqay: (x maypi: 0), sayay. #9


x yapay-qhepaman: 10.
Lluqsiy qillqay: ['10 -> '].
Lluqsiy qillqay: (x maypi: 4), sayay. #10








