
Qillqa patapi: ['evaluate'] ruway: {
	>> codigo := Khipu musuq: ['/tmp/eval.ctr'].
	codigo qillqay: (kikin qillqaman + ['.']).
	Programa llamkʼachiy: ['/tmp/eval.ctr'].
}.

>> map :=
	(Simi-taqi musuq)
	churay: ['Hi There'] maypi: ['two'],
	churay: (Katiray ← ['hello'] ; ['world'] ; (Katiray ← 1 ; 2; 9) ; Llulla) maypi: ['one'],
	churay: ( (Simi-taqi musuq) churay: ['wrrld'] maypi: ['misspelled'] ) maypi: ['three'],
	churay: (Katiray ← ((Simi-taqi musuq) churay: ['treasure'] maypi: ['hidden']) ; 2) maypi: ['four']. 
>> str := map qillqaman.
>> map2 := Mana.
(['map2 := '] + str ) evaluate.
Lluqsiy qillqay: map2 ? ['one'] ? 0.
Lluqsiy qillqay: map2 ? ['one'] ? 1.
Lluqsiy qillqay: map2 ? ['four'] ? 0 ? ['hidden'].
Lluqsiy qillqay: map2 ? ['one'] ? 2 ? 2.
