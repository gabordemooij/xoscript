>> items := Simi-taqi musuq.
items churay: ['green'] maypi: ['color-1'].
items churay: ['orange'] maypi: ['color-2'].
items churay: ['red'] maypi: ['color-3'].
>> i := 0.
>> s := [''].
items sapallanpaq: { :key :color
	Lluqsiy qillqay: ['color #'] + i + [' is: '] + color + [' '].
	i yapay: 1.
}.
Lluqsiy qillqay: i + [' colors!'].
