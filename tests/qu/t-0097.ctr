
Qillqa patapi: ['html'] ruway: { <- (
		kikin
		rantinpay: ['&'] kayta: ['&amp;'],
		rantinpay: ['<'] kayta: ['&lt;'],
		rantinpay: ['>'] kayta: ['&gt;'],
		rantinpay: ['"'] kayta: ['&quot;']
	).
}.

>> HtmlBrush := Ima musuq.

HtmlBrush patapi: ['kutichiy:'] ruway: { :tag
	Lluqsiy qillqay: (['<tag>↵'] tag: tag ).
}.

HtmlBrush patapi: ['kutichiy:wan:'] ruway: { :tag :content
	tag := ( tag manta: 0 suni: (tag suni - 1) ).
	Lluqsiy qillqay: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush patapi: ['content:'] ruway: { :text
	Lluqsiy qillqay: text html, sayay.
}.

HtmlBrush patapi: ['attr:value:'] ruway: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush musuq.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
