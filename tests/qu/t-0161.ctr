Programa chʼuya: 0.
Katiray patapi: ['sum'] ruway: {
	>> total := 0.
	kikin sapallanpaq: { :index :element
		total yapay: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Khipu musuq: ['/tmp/test.txt'].
f qillqay: ['Lorem Ipsum'].
f wichqaykuy.
  

f := Khipu musuq: ['/tmp/test.txt'].
>> text := f ñawiy.
f wichqaykuy.



Programa yuyay-pichay.
usedMemory1 := (Programa yuyay ? 1).



f := Khipu musuq: ['/tmp/test.txt'].
text := f ñawiy.
f wichqaykuy.

Programa yuyay-pichay.
usedMemory2 := (Programa yuyay ? 1).


f := Khipu musuq: ['/tmp/test.txt'].
text := f ñawiy.
f wichqaykuy.

Programa yuyay-pichay.
usedMemory3 := (Programa yuyay ? 1).



( usedMemory1 = usedMemory2 wan: usedMemory1 = usedMemory3, wan: usedMemory2 = usedMemory3 ) chiqapqtin: {
	Lluqsiy qillqay: ['No memory leaks here'].
}, llullaqtin: {
	Lluqsiy qillqay: ['Leaking memory...'].
}.
