Lluqsiy qillqay: ['Test object'], sayay.
>> a := Ima musuq. 

a patapi: ['item:'] ruway: { :moment
	ñuqap moment := moment. 
}.

a patapi: ['item'] ruway: { <- ñuqap moment.
}.

>> today := Katiray musuq ; ( Pacha musuq suyu: ['CEST'], wata: 2026, killa: 7 ).
a item: today.
Lluqsiy qillqay: a item ? 0, sayay.
a save-as: ['/tmp/a.bin'].
