Yupay patapi: ['roman'] ruway: {
	>> yupayman := kikin kikinchasqa.
	>> roman := [''].
	{
		{
			(yupayman ≥ 1000) chiqapqtin: {
				roman yapay-qhepaman: ['Ⅿ'].
				yupayman qichuy: 1000.
			}, kuchuy.
		
			(yupayman ≥ 500) chiqapqtin: {
				roman yapay-qhepaman: ['Ⅾ'].
				yupayman qichuy: 500.
			}, kuchuy.
		
			(yupayman ≥ 100) chiqapqtin: {
				roman yapay-qhepaman: ['Ⅽ'].
				yupayman qichuy: 100.
			}, kuchuy.
		
			(yupayman ≥ 50) chiqapqtin: {
				roman yapay-qhepaman: ['Ⅼ'].
				yupayman qichuy: 50.
			}, kuchuy.
		
			(yupayman ≥ 50) chiqapqtin: {
				roman yapay-qhepaman: ['Ⅼ'].
				yupayman qichuy: 50.
			}, kuchuy.
		
			(yupayman ≥ 10) chiqapqtin: {
				roman yapay-qhepaman: ['Ⅹ'].
				yupayman qichuy: 10.
			}, kuchuy.
			
			(yupayman ≥ 9) chiqapqtin: {
				roman yapay-qhepaman: ['Ⅸ'].
				yupayman qichuy: 9.
			}, kuchuy.
			
			(yupayman ≥ 5) chiqapqtin: {
				roman yapay-qhepaman: ['Ⅴ'].
				yupayman qichuy: 5.
			}, kuchuy.
			
			(yupayman ≥ 4) chiqapqtin: {
				roman yapay-qhepaman: ['Ⅳ'].
				yupayman qichuy: 4.
			}, kuchuy.
			
			(yupayman ≥ 1) chiqapqtin: {
				roman yapay-qhepaman: ['Ⅰ'].
				yupayman qichuy: 1.
			}, kuchuy.
		} ñawincha.
	} chaykama: { <- yupayman > 0. }. <- roman.
}.

Lluqsiy qillqay: 1 roman, sayay.
Lluqsiy qillqay: 2 roman, sayay.
Lluqsiy qillqay: 4 roman, sayay.
Lluqsiy qillqay: 8 roman, sayay.
Lluqsiy qillqay: 16 roman, sayay.
Lluqsiy qillqay: 32 roman, sayay.
Lluqsiy qillqay: 64 roman, sayay.
Lluqsiy qillqay: 128 roman, sayay.
Lluqsiy qillqay: 256 roman, sayay.
Lluqsiy qillqay: 1024 roman, sayay.
