

Programa yuyay-pichay.


>> Veggy := Ima musuq.
Veggy patapi: ['musuq'] ruway: {
	>> v := kikin musuq.
	v init. <- v.
}.

Veggy patapi: ['init'] ruway: { ñuqap veggies := 0. }.

Veggy patapi: ['carrots:'] ruway: { :a ñuqap veggies := a. <- Mana. }.
Veggy patapi: ['carrots'] ruway: { <- ñuqap veggies. }.
Veggy patapi: ['+'] ruway: { :f
	>> n := Veggy musuq.
	n carrots: (f carrots + ñuqap veggies). <- n.
}.

Veggy patapi: ['qillqaman'] ruway: { <- ñuqap veggies qillqaman.
}.

Yupay patapi: ['carrots'] ruway: {
	>> x := Veggy musuq.
	x carrots: kikin. <- x.
}.

Yupay patapi: ['add:and:'] ruway: { :a :b <- (a + b).
}.

>> q := 0 add: (3 carrots + 2 carrots) and: 4 carrots.
Lluqsiy qillqay: q, sayay.
