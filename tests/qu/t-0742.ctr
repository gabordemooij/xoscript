Lluqsiy qillqay: ['Test object'], sayay.
>> a := Ima musuq. 

a patapi: ['item:'] ruway: { :hexhelper
	ñuqap hexhelper := hexhelper. 
}.

a patapi: ['item'] ruway: { <- ñuqap hexhelper.
}.

a item: Hx musuq.

>> old-hexhelper-address := a item ñawpaq-rikchʼay yuyay-tiyanan.
a save-as: ['/tmp/a.bin'].
Lluqsiy qillqay: ['========== RELOADING SNAP:'], sayay.

>> b := Ima load-from: ['/tmp/a.bin'].

(b item ñawpaq-rikchʼay yuyay-tiyanan = old-hexhelper-address) chiqapqtin: {
	Lluqsiy qillqay: ['Object link re-attached.'], sayay.
}.
