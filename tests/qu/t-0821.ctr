# a quote that never closes must give an error, not an endless loop
>> ñan := ['/tmp/test0821.csv'].
>> file := Khipu musuq: ñan.

file qillqay: ['a,b\n"1,2\n'].
{
	file rakiq: [','] chimlli: ['"'] siqikuna: { :line
		Lluqsiy qillqay: line, sayay.
	}.
} hapiy: { :e Lluqsiy qillqay: e, sayay. }, kallpay.

# a closed quote still works
file qillqay: ['a,b\n"1,2",3'].
file rakiq: [','] chimlli: ['"'] siqikuna: { :line
	Lluqsiy qillqay: line, sayay.
}.
file pichay.
