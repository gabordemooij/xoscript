# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Waqaychana llawikunata-ruray.

# private (secret) key
>> sk := keys ñawpaq.

# public key
>> pk := keys qhepa.

# sign a message
>> sig := Waqaychana firmay: ['abc'] kaywan: sk.

# check message (ok)
Lluqsiy qillqay: ( 
	Waqaychana
		qhawariy: ['abc'] 
		firma: sig 
		kaywan: pk 
), sayay.

# check message (fail)
Lluqsiy qillqay: ( 
	Waqaychana 
		qhawariy: ['abd'] 
		firma: sig 
		kaywan: pk 
), sayay.