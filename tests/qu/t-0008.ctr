>> Greeter := Ima musuq.
Greeter patapi: ['make'] ruway: {
	>> greeter := Ima musuq.
	greeter patapi: ['name:'] ruway: { :suti
		Lluqsiy qillqay: ['setting a name'].
		ñuqap myName := suti.
	}.
	greeter patapi: ['greet'] ruway: {
		Lluqsiy qillqay: ['Hello'].
		Lluqsiy qillqay: ñuqap myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
