Server init.
Lluqsiy qillqay: ['Database time test'], sayay.

>> db := Maria-DB musuq samachiq: ['localhost'],
	ruraqpa-sutin: ['xo'], 
	pakasqa-simi: ['pass123'],
	willay-waqaychanap-sutin: ['xobase'],
	tinkiy.

>> maskana-tupukuna :=
db tapuy: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
apamuy: { :row
	Lluqsiy qillqay: row timetest, sayay.
}.
