# test list operations


>> cakes := Katiray ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes rantinpay: 1 suni: 2 kaywan: ( Katiray ← ['cinnamon'] ; ['pineapple'] ).
Lluqsiy qillqay: (buy huñuy: [',']), sayay.


>> buy := cakes rantinpay: 1 suni: 12 kaywan: ( Katiray ← ['cinnamon'] ; ['pineapple'] ).
Lluqsiy qillqay: (buy huñuy: [',']), sayay.


>> buy := cakes rantinpay: 2 suni: 10 kaywan: ( Katiray musuq ).
Lluqsiy qillqay: (buy huñuy: [',']), sayay.


>> buy := cakes rantinpay: 0 suni: 1 kaywan: ( Katiray musuq ).
Lluqsiy qillqay: (buy huñuy: [',']), sayay.


>> buy := cakes rantinpay: ['0'] suni: ['1'] kaywan: ['x'].
Lluqsiy qillqay: (buy huñuy: [',']), sayay.
