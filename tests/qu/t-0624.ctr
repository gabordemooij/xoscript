# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := Ima musuq.

Log patapi: ['say:'] ruway: { :str
	Lluqsiy qillqay: str, sayay.
}.

>> Item := Ima musuq.

Item patapi: ['musuq:'] ruway: { :id <- kikin musuq id: id.
}.

Item patapi: ['id:'] ruway: { :id
	ñuqap id := id.
}.

Item patapi: ['id'] ruway: { <- ñuqap id. }.


Item patapi: ['qillqaman'] ruway: {
	>> str := ['Item#~no'].
	str ~no: ñuqap id. <- str.
}.


>> Print := Ima musuq.

Print patapi: ['items'] ruway: { 
	
	ñuqap item := Item musuq: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: ñuqap item
	).
	
	
}.

Print items.