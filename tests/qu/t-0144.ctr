



>> CoffeeGrounds := Ima musuq.
CoffeeGrounds patapi: ['extract'] ruway: { <- ['coffee']. }.

>> CoffeeMachine := Ima musuq.
CoffeeMachine patapi: ['init'] ruway: {
	ñuqap coffeegrounds := CoffeeGrounds musuq.
}.
CoffeeMachine patapi: ['musuq'] ruway: { <- CoffeeMachine `new init.
}.

CoffeeMachine patapi: ['makeTea'] ruway: { <- (ñuqap tealeaves extract). }.
CoffeeMachine patapi: ['makeCoffee'] ruway: { <- (ñuqap coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine musuq.

Lluqsiy qillqay:
	coffeeDream 
	makeCoffee.

Lluqsiy qillqay:
	coffeeDream 
	makeTea.
