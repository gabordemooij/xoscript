

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa chʼuya: 0.

>> txt := ['1.6'].
>> n := txt yupayman.
>> t := txt chiqapchaman.
Lluqsiy qillqay: n, sayay.
Lluqsiy qillqay: t, sayay.
Lluqsiy qillqay: n laya, sayay.
Lluqsiy qillqay: t laya, sayay.

Programa yuyay-pichay.

usedMemory1 := (Programa yuyay ? 0).


txt := ['1.6'].
n := txt yupayman.
t := txt chiqapchaman.
Lluqsiy qillqay: n, sayay.
Lluqsiy qillqay: t, sayay.
Lluqsiy qillqay: n laya, sayay.
Lluqsiy qillqay: t laya, sayay.

Programa yuyay-pichay.
usedMemory2 := (Programa yuyay ? 0).


txt := ['1.6'].
n := txt yupayman.
t := txt chiqapchaman.
Lluqsiy qillqay: n, sayay.
Lluqsiy qillqay: t, sayay.
Lluqsiy qillqay: n laya, sayay.
Lluqsiy qillqay: t laya, sayay.

Programa yuyay-pichay.
usedMemory3 := (Programa yuyay ? 0).



( usedMemory1 = usedMemory2 wan: usedMemory1 = usedMemory3, wan: usedMemory2 = usedMemory3 ) chiqapqtin: {
	Lluqsiy qillqay: ['No memory leaks here'].
}, llullaqtin: {
	Lluqsiy qillqay: ['Leaking memory...'].
}.
