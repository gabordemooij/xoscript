# catch-all test (practical)
>> HTML := Qillqa musuq.
HTML patapi: ['encode:'] ruway: { :tekst
	kikin yapay-qhepaman: (tekst
	rantinpay: ['&'] kayta: ['&amp;'], 
	rantinpay: ['<'] kayta: ['&lt;'],
	rantinpay: ['>'] kayta: ['&gt;'],
	rantinpay: ['"'] kayta: ['&quot;']).
}.
>> blog := HTML musuq.
blog yapay-qhepaman: ['<h1>'],
     encode: ['Koffie & Thee'],
     yapay-qhepaman: ['</h1>'].
Lluqsiy qillqay: blog, sayay.


>> Roman := Yupay musuq.
Roman patapi: ['stringy'] ruway: {
	>> a := [''].
	{ a yapay-qhepaman: ['I']. } × kikin. <- a.
}.

>> x := Roman musuq.
x yapay: 3.
Lluqsiy qillqay: x stringy, sayay.

>> Quantum := Chiqapcha musuq.
Quantum patapi: ['true?'] ruway: { <- ['maybe True']. }.
Lluqsiy qillqay: (Quantum musuq true?), sayay.

>> Nihil := Mana musuq.
Nihil patapi: ['qillqaman'] ruway: { <- ['Nihil']. }.
Lluqsiy qillqay: (Nihil musuq), sayay.
