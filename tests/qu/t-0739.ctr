Lluqsiy qillqay: ['Test object'], sayay.
>> a := Ima musuq. 

a patapi: ['item:'] ruway: { :binhelper
	ñuqap binhelper := binhelper. 
}.

a patapi: ['item'] ruway: { <- ñuqap binhelper.
}.

a item: Bin musuq.

>> old-binhelper-address := a item ñawpaq-rikchʼay yuyay-tiyanan.
a save-as: ['/tmp/a.bin'].
Lluqsiy qillqay: ['========== RELOADING SNAP:'], sayay.

>> b := Ima load-from: ['/tmp/a.bin'].

(b item ñawpaq-rikchʼay yuyay-tiyanan = old-binhelper-address) chiqapqtin: {
	Lluqsiy qillqay: ['Object link re-attached.'], sayay.
}.


