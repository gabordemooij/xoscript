>> Greeter := Ima musuq.
Greeter patapi: ['make'] ruway: {
	>> gr := Ima musuq.
	gr patapi: ['setName:'] ruway: { :aname
		ñuqap suti := aname.
	}.
	gr patapi: ['greet'] ruway: {
		Lluqsiy qillqay: ñuqap suti.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a musuq.
c setName: ['THREE'].
c greet.
>> d := a musuq.
d setName: ['FOUR'].
d greet.
c greet.
