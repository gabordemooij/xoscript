Server init.
Lluqsiy qillqay: ['Database datetime test'], sayay.

>> db := Maria-DB musuq samachiq: ['localhost'],
	ruraqpa-sutin: ['xo'], 
	pakasqa-simi: ['pass123'],
	willay-waqaychanap-sutin: ['xobase'],
	tinkiy.

>> maskana-tupukuna :=
db tapuy: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
apamuy: { :row
	Lluqsiy qillqay: row datetimetest, sayay.
}.
