

Katiray patapi: ['fixture:'] ruway: { :f
	ñuqap fixture := f.
}.

Katiray patapi: ['hayka?'] ruway: { <- ñuqap fixture.
}.

Katiray patapi: ['aantal'] ruway: { <- ñuqap fixture.
}.


>> x := Mana.
{

	x := ['hello'] 
	rantinpay:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] simi: 2)
			)
		)
	kayta: (
		(['...hal'] + ['lo']) 
			hatunman 
			lowecase 
			hatunman 
			pasay: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Katiray ← 0 ; 1 ; 4; 9 ; (Katiray ← 0 ; 3; 1) ; 4
							) qhepa-iskay
						) ? 1
					) + 
					((Katiray ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					hayka?
				)
			)
	).

} × 10.
Lluqsiy qillqay: x, sayay.

