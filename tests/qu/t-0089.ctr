>> randomizer := { :a :b
	>> aswan-pisi := ( a < b ) kaypas: a chaypas: b.
	>> aswan-achka := ( a > b ) kaypas: a chaypas: b.
	>> x := Mana.
	{
		x := Yupay chawpi: a wan: b.
		((x < aswan-pisi) utaq: (x > aswan-achka)) chiqapqtin: { 
			Lluqsiy qillqay: (['Invalid value!']).
			Programa tukukuy.
		}.
	} 
	× 100. <- x.
}.
randomizer rurachiy: 0 wan: 0.
randomizer rurachiy: 1 wan: 0.
randomizer rurachiy: 1 wan: 1.
randomizer rurachiy: 0 wan: 1.
randomizer rurachiy: -1 wan: 0.
randomizer rurachiy: -1 wan: -1.
randomizer rurachiy: 0 wan: -1.
randomizer rurachiy: 100 wan: 200.
randomizer rurachiy: 999999999999998 wan: 999999999999999.
randomizer rurachiy: 999999999999999 wan: 999999999999998.
randomizer rurachiy: 999999999999999 wan: 999999999999999.
randomizer rurachiy: -999999999999998 wan: -999999999999999.
randomizer rurachiy: -999999999999999 wan: -999999999999998.
randomizer rurachiy: -999999999999999 wan: -999999999999999.
randomizer rurachiy: 999999999999998 wan: -999999999999999.
randomizer rurachiy: 999999999999999 wan: -999999999999998.
randomizer rurachiy: 999999999999999 wan: -999999999999999.
randomizer rurachiy: -999999999999998 wan: 999999999999999.
randomizer rurachiy: -999999999999999 wan: 999999999999998.
randomizer rurachiy: -999999999999999 wan: 999999999999999.
Lluqsiy qillqay: ['OK'].


