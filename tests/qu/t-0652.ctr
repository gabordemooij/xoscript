# test number -> string -> number
{

	>> x := Yupay chawpi: 0 wan: 1000000.
	>> d := Yupay chawpi: 1 wan: 7.
	>> e := 10 atiy: d.

	x rakiy-rayku: e.
	>> y := x qillqaman yupayman.

	(x = y) llullaqtin: {
		Lluqsiy qillqay: x, sayay.
		Lluqsiy qillqay: y, sayay.
		Programa tukukuy.
	}.

} * 1000.
Lluqsiy qillqay: ['OK'], sayay.