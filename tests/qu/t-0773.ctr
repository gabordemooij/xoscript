Lluqsiy qillqay: ['Test object'], sayay.
>> a := Ima musuq. 
a patapi: ['item:'] ruway: { :int64
	ñuqap int64 := int64. 
}.
a patapi: ['item'] ruway: { <- ñuqap int64.
}.
a item: ( Int64 qillqamanta: ['9999'] ).
Lluqsiy qillqay: a item, sayay.
>> old-int64-address := a item ñawpaq-rikchʼay yuyay-tiyanan.
a save-as: ['/tmp/a.bin'].
Lluqsiy qillqay: ['========== RELOADING SNAP:'], sayay.
>> b := Ima load-from: ['/tmp/a.bin'].
(b item ñawpaq-rikchʼay yuyay-tiyanan = old-int64-address) chiqapqtin: {
	Lluqsiy qillqay: ['Object link re-attached.'], sayay.
}.
Lluqsiy qillqay: ( b item ), sayay.
