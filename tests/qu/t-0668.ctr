# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob musuq: 8, bytes: (
	Katiray musuq ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Lluqsiy qillqay: ( utf16 dekodificay: ['utf16le'] ), sayay.

utf16 kacharichiy.
>> utf32 := Blob musuq: 13, bytes: (
	Katiray musuq ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Lluqsiy qillqay: ( utf32 dekodificay: ['utf32be'] ), sayay.
utf32 kacharichiy.