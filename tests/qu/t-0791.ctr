Server init.

>> DB := Maria-DB musuq samachiq: ['localhost'],
	ruraqpa-sutin: ['xo'],
	pakasqa-simi: ['pass123'],
	willay-waqaychanap-sutin: ['xobase'],
	tinkiy.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> maskana-tupukuna := Tapuy-Maria musuq: SQL.

# set database
maskana-tupukuna willay-waqaychana: DB.

maskana-tupukuna apamuy: { :row
	Lluqsiy qillqay: row world, sayay.
}.
