>> HTML := Ima musuq.
HTML patapi: ['kutichiy:'] ruway: { :tag 
	Lluqsiy qillqay: (['<tag>'] tag: tag), sayay.
}.
HTML patapi: ['kutichiy:wan:'] ruway: { :tag :html 
	Lluqsiy qillqay: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), sayay.
}.
>> html := HTML musuq.
html body h1: ['header'].

