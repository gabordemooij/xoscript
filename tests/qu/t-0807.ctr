# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB musuq samachiq: ['localhost'],
	ruraqpa-sutin: ['xo'],
	pakasqa-simi: ['pass123'],
	willay-waqaychanap-sutin: ['xobase'],
	tinkiy.

>> maskana-tupukuna := db tapuy: ['SELECT %% FROM'].
{ maskana-tupukuna huntʼachiy. } hapiy: { :e
	Lluqsiy qillqay: ( e kapun: ['%%'] ), sayay.
}, kallpay.
