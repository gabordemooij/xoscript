
>> countries := Katiray musuq
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Katiray musuq
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods rayku: countries, sapallanpaq: { :key :value
	counter yapay: 1.
}.

Lluqsiy qillqay: (['we serve counter dishes'] counter: counter), sayay.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] simikuna kamachiy: { :v
	counter yapay: 0.
}.

Lluqsiy qillqay: (['we sort counter dishes'] counter: counter), sayay.


>> counter := 0.
{
	{
		counter yapay: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Lluqsiy qillqay: (['we calculate counter numbers.'] counter: counter), sayay.

