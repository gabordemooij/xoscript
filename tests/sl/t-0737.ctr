#test regularnih izrazov s pozitivnim pogledom naokoli
Server init.
>> subject := ['bacabcca'].
>> regIzraz := Vzorec nov: ['(\\w{2})(?=ca)'].
>> rezultat  := regIzraz ujemanje: subject izvedi: { :m :x
	Izhod piši: m, nova-vrstica.
	Izhod piši: x, nova-vrstica.
	<- ['XXX'].
}.
Izhod piši: rezultat, nova-vrstica.
