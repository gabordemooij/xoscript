Server init.
>> f := Format nov: ['%d'].
>> a := Blob nov: 4.
a bytes: ( Seznam nov ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob nov: 4.
b bytes: ( Seznam nov ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a od: 0 dolžina: 3, vsak: { :i :byte
	Izhod piši: ( f uporabi-celo: byte ) , nova-vrstica.
}.
a ^ b.
a od: 0 dolžina: 3, vsak: { :i :byte
	Izhod piši: ( f uporabi-celo: byte ) , nova-vrstica.
}.
a ^ b.
a od: 0 dolžina: 3, vsak: { :i :byte
	Izhod piši: ( f uporabi-celo: byte ) , nova-vrstica.
}.
a sprosti.
b sprosti.

{ a ^ Objekt. } ujemi: { :e Izhod piši: e, nova-vrstica. }, zaženi.
