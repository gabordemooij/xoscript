# Nastavljanje alarma

# konča program po 1 sek.
Program alarm: 1.

Izhod piši: ['največ 1 sek.'], nova-vrstica.
Trenutek počakaj: 2.
Izhod piši: ['traja predolgo.'], nova-vrstica.

# opomba:
# Nastavitve alarma ni mogoče razveljaviti,
# napadalec ga ne more izklopiti.
# Po prvem klicu je alarm zaklenjen.
# Poleg tega je alarm zares strog,
# program *BO* ustavljen po
# določenem časovnem intervalu, tudi če je
# sredi blokirajočega branja ali česa podobnega.

# opomba:
# Alarm je težko orožje, raje razmislite o osnovnih
# časovnih omejitvah v spletnem strežniku.



