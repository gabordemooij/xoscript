

Besedilo ob: ['evaluate'] izvedi: {
	>> koda := Datoteka nov: ['/tmp/eval.ctr'].
	koda piši: (sebe besedilo + ['.']).
	Program uporabljaj: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Seznam ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q besedilo.
Izhod piši: x, nova-vrstica.
>> y := Nič.
(['y := '] + x ) evaluate.
Izhod piši: y ? 0, nova-vrstica.

q := Slovar postavi: ['\[''] na: ['\['quote\']'].
x := q besedilo.
Izhod piši: x, nova-vrstica.
y := Nič.
(['y := '] + x ) evaluate.

>> q := (Slovar nov) postavi:['\[''] na:['\['quote\[''].
Izhod piši: y ? ['\['quote\']'], nova-vrstica.
