>> V := Objekt.
V ob: ['besedilo'] izvedi: {
	Izhod piši: ['pretvorba'], nova-vrstica.
	<- ['abc'].
}.

Izhod piši: ( Program nastavitev: ['abc'] ), nova-vrstica.

# parametri ne smejo biti pobrani z gc
Program nastavitev: ([''] + V nov) vrednost: ([''] + V nov).

Izhod piši: ( Program nastavitev: ['abc'] ), nova-vrstica.
