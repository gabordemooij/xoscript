Število ob: ['fakulteta'] izvedi: {
	>> skupaj := 1.
	{ :indeks skupaj pomnoži-z: (sebe - (indeks)). } × sebe. <- skupaj.
}.
>> Tiskalnik := Objekt nov.
Tiskalnik ob: ['tiskaj:in:'] izvedi: { :x :y
	Izhod piši: ['a='] + x + [', b='] + y, nova-vrstica.
}.
>> a := 4.5. >> b := a zaokroži-navzdol.
Tiskalnik tiskaj: a in: b.
a := 4. b := a fakulteta.
Tiskalnik tiskaj: a in: b.
a := 4.5. b := a zaokroži-navzgor.
Tiskalnik tiskaj: a in: b.
a := 4.5. b := a zaokroži-navzdol.
Tiskalnik tiskaj: a in: b.
a := 4.5. b := a zaokroži.
Tiskalnik tiskaj: a in: b.
a := 4.2. b := a zaokroži.
Tiskalnik tiskaj: a in: b.

Izhod piši: (9 modulo: 5), nova-vrstica.
Izhod piši: -666 absolutna-vrednost, nova-vrstica.
Izhod piši: 49 kvadratni-koren, nova-vrstica.
Izhod piši: (2 potenca: 3), nova-vrstica.
>> l := (Seznam ← 9 ; 6).
Izhod piši: l minimum.

