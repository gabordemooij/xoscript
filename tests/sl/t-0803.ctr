Server init.

>> pov1 := Maria-DB nov gostitelj: ['localhost'],
	uporabnik: ['xo'],
	geslo: ['pass123'],
	ime-baze: ['xobase'],
	poveži-se.

>> pov2 := Maria-DB nov gostitelj: ['localhost'],
	uporabnik: ['xo'],
	geslo: ['pass123'],
	ime-baze: ['xobase'],
	poveži-se.
#...
>> izbr := pov1 poizvedba: ['DELETE FROM book WHERE id > 0'].
{  izbr izvedi. pov1 potrdi. } ujemi: { :e pov1 razveljavi.  }, zaženi.

>> vstavi := pov1 poizvedba: ['INSERT INTO book (id) VALUES(null)'].
vstavi izvedi.

>> število-elementov := pov1 poizvedba: ['SELECT COUNT(*) AS num FROM book'].
število-elementov pridobi: { :vrsta Izhod piši: vrsta num, nova-vrstica. }.

# se ne prikaže
# vstavljanje ni potrjeno na povezavi 1
>> število-elementov := pov2 poizvedba: ['SELECT COUNT(*) AS num FROM book'].
število-elementov pridobi: { :vrsta Izhod piši: vrsta num, nova-vrstica. }.
