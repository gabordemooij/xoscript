# test qualifiers

Program počisti.

>> Fruit := Objekt nov.
Fruit ob: ['nov'] izvedi: {
	>> f := sebe nov.
	f apples: 0. <- f.
}.
Fruit ob: ['apples:'] izvedi: { :a svoj apples := a. }.
Fruit ob: ['apples'] izvedi: { <- svoj apples. }.
Fruit ob: ['+'] izvedi: { :f
	>> n := Fruit nov.
	n apples: (f apples + svoj apples). <- n.
}.
Število ob: ['apples'] izvedi: { <- ((Fruit nov) apples: sebe).
}.

Fruit ob: ['besedilo'] izvedi: { <- svoj apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Izhod piši: q, nova-vrstica.




q := 3 apples + 4 apples.
Izhod piši: q, nova-vrstica.



q := 3 apples + 4 apples.
Izhod piši: q, nova-vrstica.


