

Besedilo ob: ['html'] izvedi: { <- (
		sebe
		zamenjaj: ['&'] z: ['&amp;'],
		zamenjaj: ['<'] z: ['&lt;'],
		zamenjaj: ['>'] z: ['&gt;'],
		zamenjaj: ['"'] z: ['&quot;']
	).
}.


Izhod piši: ([' levo obrezano '] obreži) + [' '] + ( ['in desno obrezano'] obreži) + ['!'], nova-vrstica.
Izhod piši: ['<html>"html & entities"</html>'] html.
