Število ob: ['rimsko'] izvedi: {
	>> število := sebe kopiraj.
	>> rimsko := [''].
	{
		{
			(število ≥ 1000) resnično: {
				rimsko dodaj-na-konec: ['Ⅿ'].
				število odštej: 1000.
			}, prekini.
		
			(število ≥ 500) resnično: {
				rimsko dodaj-na-konec: ['Ⅾ'].
				število odštej: 500.
			}, prekini.
		
			(število ≥ 100) resnično: {
				rimsko dodaj-na-konec: ['Ⅽ'].
				število odštej: 100.
			}, prekini.
		
			(število ≥ 50) resnično: {
				rimsko dodaj-na-konec: ['Ⅼ'].
				število odštej: 50.
			}, prekini.
		
			(število ≥ 50) resnično: {
				rimsko dodaj-na-konec: ['Ⅼ'].
				število odštej: 50.
			}, prekini.
		
			(število ≥ 10) resnično: {
				rimsko dodaj-na-konec: ['Ⅹ'].
				število odštej: 10.
			}, prekini.
			
			(število ≥ 9) resnično: {
				rimsko dodaj-na-konec: ['Ⅸ'].
				število odštej: 9.
			}, prekini.
			
			(število ≥ 5) resnično: {
				rimsko dodaj-na-konec: ['Ⅴ'].
				število odštej: 5.
			}, prekini.
			
			(število ≥ 4) resnično: {
				rimsko dodaj-na-konec: ['Ⅳ'].
				število odštej: 4.
			}, prekini.
			
			(število ≥ 1) resnično: {
				rimsko dodaj-na-konec: ['Ⅰ'].
				število odštej: 1.
			}, prekini.
		} postopek.
	} dokler: { <- število > 0. }. <- rimsko.
}.

Izhod piši: 1 rimsko, nova-vrstica.
Izhod piši: 2 rimsko, nova-vrstica.
Izhod piši: 4 rimsko, nova-vrstica.
Izhod piši: 8 rimsko, nova-vrstica.
Izhod piši: 16 rimsko, nova-vrstica.
Izhod piši: 32 rimsko, nova-vrstica.
Izhod piši: 64 rimsko, nova-vrstica.
Izhod piši: 128 rimsko, nova-vrstica.
Izhod piši: 256 rimsko, nova-vrstica.
Izhod piši: 1024 rimsko, nova-vrstica.
