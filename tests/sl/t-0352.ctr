Število ob: ['roman'] izvedi: {
	>> število := sebe kopiraj.
	>> roman := [''].
	{
		{
			(število ≥ 1000) resnično: {
				roman dodaj-na-konec: ['Ⅿ'].
				število odštej: 1000.
			}, prekini.
		
			(število ≥ 500) resnično: {
				roman dodaj-na-konec: ['Ⅾ'].
				število odštej: 500.
			}, prekini.
		
			(število ≥ 100) resnično: {
				roman dodaj-na-konec: ['Ⅽ'].
				število odštej: 100.
			}, prekini.
		
			(število ≥ 50) resnično: {
				roman dodaj-na-konec: ['Ⅼ'].
				število odštej: 50.
			}, prekini.
		
			(število ≥ 50) resnično: {
				roman dodaj-na-konec: ['Ⅼ'].
				število odštej: 50.
			}, prekini.
		
			(število ≥ 10) resnično: {
				roman dodaj-na-konec: ['Ⅹ'].
				število odštej: 10.
			}, prekini.
			
			(število ≥ 9) resnično: {
				roman dodaj-na-konec: ['Ⅸ'].
				število odštej: 9.
			}, prekini.
			
			(število ≥ 5) resnično: {
				roman dodaj-na-konec: ['Ⅴ'].
				število odštej: 5.
			}, prekini.
			
			(število ≥ 4) resnično: {
				roman dodaj-na-konec: ['Ⅳ'].
				število odštej: 4.
			}, prekini.
			
			(število ≥ 1) resnično: {
				roman dodaj-na-konec: ['Ⅰ'].
				število odštej: 1.
			}, prekini.
		} postopek.
	} dokler: { <- število > 0. }. <- roman.
}.

Izhod piši: 1 roman, nova-vrstica.
Izhod piši: 2 roman, nova-vrstica.
Izhod piši: 4 roman, nova-vrstica.
Izhod piši: 8 roman, nova-vrstica.
Izhod piši: 16 roman, nova-vrstica.
Izhod piši: 32 roman, nova-vrstica.
Izhod piši: 64 roman, nova-vrstica.
Izhod piši: 128 roman, nova-vrstica.
Izhod piši: 256 roman, nova-vrstica.
Izhod piši: 1024 roman, nova-vrstica.
