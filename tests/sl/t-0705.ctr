

>> obj := Objekt nov.

obj ob: ['pozdravi'] izvedi: {
	<- ['živjo'].
}.

# mora izpisati hi123hi123ok
obj ob: ['opravilo'] izvedi: {
	svoj lastnost := 123.
	{
		# poskusi veže sebe/svoj na objekt namesto na blok
		Izhod piši: sebe pozdravi.
		Izhod piši: svoj lastnost.
		1 / 0.
	} ujemi: {
		Izhod piši: sebe pozdravi.
		Izhod piši: svoj lastnost.
		Izhod piši: ['ok'].
	}, poskusi.
}.

obj opravilo.