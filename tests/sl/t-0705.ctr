

>> obj := Objekt nov.

obj ob: ['greet'] izvedi: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj ob: ['task'] izvedi: {
	svoj property := 123.
	{
		# try binds self/own to object instead of block
		Izhod piši: sebe greet.
		Izhod piši: svoj property.
		1 / 0.
	} ujemi: {
		Izhod piši: sebe greet.
		Izhod piši: svoj property.
		Izhod piši: ['ok'].
	}, poskusi.
}.

obj task.