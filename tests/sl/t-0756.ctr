Izhod piši: ['Testni objekt'], nova-vrstica.
>> pozdravljalec := Objekt nov.
pozdravljalec ob: ['name:'] izvedi: { :ime
	svoj xime := ime. 
}.
pozdravljalec ob: ['pozdravi'] izvedi: {
	Izhod piši: ['Zdravo '] + svoj xime, nova-vrstica.
}.
pozdravljalec name: ['Sherlock'].
pozdravljalec save-as: ['/tmp/a.bin'].
pozdravljalec save-as: ['/tmp/b.bin'].
Izhod piši: ['========== PONOVNO NALAGANJE POSNETKA:'], nova-vrstica.
>> b := Objekt load-from: ['/tmp/a.bin'].
>> c := Objekt load-from: ['/tmp/b.bin'].
b pozdravi.
b name: ['Watson'], pozdravi.
c name: ['Moriarty'], pozdravi.
