Izhod piši: ['Test object'], nova-vrstica.
>> l := Seznam nov ; 1 ; ( Seznam nov ; (Trenutek nov: 1) ; (Int64 iz-besedila: ['321']) ; (Seznam nov ; 3)).
Izhod piši: l, nova-vrstica.
>> old-lst-address := l prototip pomnilniški-naslov.
l save-as: ['/tmp/a.bin'].
Izhod piši: ['========== RELOADING SNAP:'], nova-vrstica.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b prototip pomnilniški-naslov = old-lst-address) resnično: {
	Izhod piši: ['Object link re-attached.'], nova-vrstica.
}.
Izhod piši: b, nova-vrstica.
