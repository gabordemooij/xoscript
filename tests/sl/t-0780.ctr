Server init.

# Kodirnik JSON podpira samo UTF-8, brez nadomestnih parov

>> slovarji := Seznam nov ;
	# {"key":"normal"} navaden ASCII
	( Slovar nov postavi: ['običajno'] na: ['key'] ) ;
	# {"key":"hello world"} znak za presledek
	( Slovar nov postavi: ['hello world'] na: ['key'] ) ;
	# {"key":"quote: \""} dvojni narekovaj
	( Slovar nov postavi: ['"'] na: ['key'] ) ;
	# {"key":"backslash: \\"} poševnica nazaj
	( Slovar nov postavi: ['backslash: \\'] na: ['key'] ) ;
	# {"key":"slash: /"} poševnica
	( Slovar nov postavi: ['poševnica: /'] na: ['key'] ) ;
	# {"key":"backspace: \b"} vračalka
	( Slovar nov postavi: ['backspace: \b'] na: ['key'] ) ;
	# {"key":"formfeed: \f"} ubežno zaporedje za pomik strani
	( Slovar nov postavi: ['formfeed: \f'] na: ['key'] ) ;
	# {"key":"newline: \n"} nova vrstica
	( Slovar nov postavi: ['newline: \n'] na: ['key'] ) ;
	( Slovar nov postavi: ['newline: ↵'] na: ['key'] ) ;
	( Slovar nov postavi: ['newline: 
	'] na: ['key'] ) ;
	# {"key":"carriage return: \r"} pomik na začetek vrstice
	( Slovar nov postavi: ['carriage return: \r'] na: ['key'] ) ;
	# {"key":"tab: \t"} tabulator
	( Slovar nov postavi: ['tab \t'] na: ['key'] ) ;
	( Slovar nov postavi: ['tab ⇿'] na: ['key'] ) ;
	( Slovar nov postavi: ['tabulator  '] na: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( Slovar nov postavi: ['NUL \u0000'] na: ['key'] ) ;
	( Slovar nov postavi: ['NUL \0'] na: ['key'] ) ;
	# {"key":"control: \u0001"} krmilni znak 0x01
	( Slovar nov postavi: ['control: \u0001'] na: ['key'] ) ;
	# {"key":"control: \u001F"} krmilni znak 0x1F
	( Slovar nov postavi: ['control: \u001F'] na: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-bajtni znak
	( Slovar nov postavi: ['unicode: é'] na: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-bajtni znak
	( Slovar nov postavi: ['unicode: €'] na: ['key'] ) ;
	# {"key":"unicode: 日本語"} več 3-bajtnih znakov UTF-8
	( Slovar nov postavi: ['unicode: 日本語'] na: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-bajtni znak
	( Slovar nov postavi: ['unicode: 😀'] na: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emodži + spojnik ničelne širine
	( Slovar nov postavi: ['unicode: 🧑‍💻'] na: ['key'] ) ;
	# {"key":"combining: é"} kombinirani naglas
	( Slovar nov postavi: ['combining: e\u0301'] na: ['key'] ) ;
	# {"key":"escaped unicode: é"} ubežni zapis Unicode BMP
	( Slovar nov postavi: ['escaped unicode: \u00e9'] na: ['key'] ) ;
	# {"key":"escaped unicode: €"} ubežni zapis Unicode BMP
	( Slovar nov postavi: ['escaped unicode: \u20ac'] na: ['key'] ) ;
	# {"key":"escaped unicode: 😀"} nadomestni par UTF-16
	( Slovar nov postavi: ['escaped unicode: \ud83d\ude00'] na: ['key'] ) ;
	# {"key":""} prazna vrednost
	( Slovar nov postavi: [''] na: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} posebni znaki ASCII
	( Slovar nov postavi: ['@ < > & = % + ? #'] na: ['key'] ) ;
	# {"key":"single quote: '"} enojni narekovaj
	( Slovar nov postavi: ['''] na: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} več ubežnih zaporedij JSON
	( Slovar nov postavi: ['multiple: \" \\ \n \r \t'] na: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} daljši ASCII-niz
	( Slovar nov postavi: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] na: ['key'] ) ;
	# {"key":" value"} presledek na začetku
	( Slovar nov postavi: [' vrednost'] na: ['key'] ) ;
	# {"key":"value "} presledek na koncu
	( Slovar nov postavi: ['vrednost '] na: ['key'] ) ;
	# {"key":" \t\n\r "} beli prostor
	( Slovar nov postavi: [' \t\n\r '] na: ['key'] )
	.

slovarji vsak: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (Slovar nov postavi: d key na: ['key']).
	>> b := JSON jsonify: (Slovar nov postavi: ['value'] na: d key).
	>> e := JSON objekt: a.
	>> f := JSON objekt: b.
	((e key = d key in: (f ? d key = ['value'])) ali: (e key = ['NUL ?'])) resnično: {
		Izhod piši: ['OK'], nova-vrstica.
	}, sicer: {
		Izhod piši: ['Ni mogoče pravilno kodirati/dekodirati: '] + d + j, nova-vrstica.
		Program konec.
	}.
}.
