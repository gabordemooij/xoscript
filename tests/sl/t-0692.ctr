Server init.

Izhod piši: (
	Vzorec nov: ['^\\w+$'],
	ujemanje: ['test@example.com'] 
), nova-vrstica. # 0 match, fails on @ and .

Izhod piši: (
	Vzorec nov: ['^[^@]+@[^\.]+\.\\w+$'],
	ujemanje: ['test@example.com'] 
), nova-vrstica. # 1 match

Izhod piši: (
	Vzorec nov: ['[^@]+@[^\.]+\.\\w+'],
	ujemanje: ['test@example.com'] 
), nova-vrstica. # 1 match

Izhod piši: (
	Vzorec nov: ['([^@]+)@([^\.]+)\.\\w+'],
	ujemanje: ['test@example.com'] 
), nova-vrstica. # 1 match, groups dont matter

Izhod piši: (
	Vzorec nov: ['[a-z]'],
	ujemanje: ['test@example.com'] 
), nova-vrstica. # 14 matches

Izhod piši: (
	Vzorec nov: ['.*'],
	ujemanje: ['test@example.com'] 
), nova-vrstica. # 1 match (all)

Izhod piši: (
	Vzorec nov: ['(.*)'],
	ujemanje: ['test@example.com'] 
), nova-vrstica. # 1 match (all)

Izhod piši: (
	Vzorec nov: ['\\s*[^@]+@[^\.]+\.\\w+'],
	ujemanje: ['test@example.com'] 
), nova-vrstica. # 1 match, prefix space optional, gets ignored