Server init.

Izhod piši: (
	Vzorec nov: ['^\\w+$'],
	ujemanje: ['test@example.com'] 
), nova-vrstica. # 0 ujemanj, ne uspe pri @ in .

Izhod piši: (
	Vzorec nov: ['^[^@]+@[^\.]+\.\\w+$'],
	ujemanje: ['test@example.com'] 
), nova-vrstica. # 1 ujemanje

Izhod piši: (
	Vzorec nov: ['[^@]+@[^\.]+\.\\w+'],
	ujemanje: ['test@example.com'] 
), nova-vrstica. # 1 ujemanje

Izhod piši: (
	Vzorec nov: ['([^@]+)@([^\.]+)\.\\w+'],
	ujemanje: ['test@example.com'] 
), nova-vrstica. # 1 ujemanje, skupine niso pomembne

Izhod piši: (
	Vzorec nov: ['[a-z]'],
	ujemanje: ['test@example.com'] 
), nova-vrstica. # 14 ujemanj

Izhod piši: (
	Vzorec nov: ['.*'],
	ujemanje: ['test@example.com'] 
), nova-vrstica. # 1 ujemanje (vse)

Izhod piši: (
	Vzorec nov: ['(.*)'],
	ujemanje: ['test@example.com'] 
), nova-vrstica. # 1 ujemanje (vse)

Izhod piši: (
	Vzorec nov: ['\\s*[^@]+@[^\.]+\.\\w+'],
	ujemanje: ['test@example.com'] 
), nova-vrstica. # 1 ujemanje, presledek pred njim je neobvezen in se prezre