Izhod piši: ['Test object'], nova-vrstica.
>> p := Pot /tmp.
Izhod piši: p, nova-vrstica.
>> old-p-address := p prototip pomnilniški-naslov.
p save-as: ['/tmp/a.bin'].
Izhod piši: ['========== RELOADING SNAP:'], nova-vrstica.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b prototip pomnilniški-naslov = old-p-address) resnično: {
	Izhod piši: ['Object link re-attached.'], nova-vrstica.
}.
Izhod piši: b, nova-vrstica.
