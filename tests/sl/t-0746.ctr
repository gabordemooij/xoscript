Izhod piši: ['Test object'], nova-vrstica.
>> a := Objekt nov. 

a ob: ['item:'] izvedi: { :dict
	svoj dict := dict. 
}.

a ob: ['item'] izvedi: { <- svoj dict.
}.

a item: (
Slovar nov
	hello: ['world'],
	world: (Slovar nov postavi: ['a'] na: ['b'])).

Izhod piši: a item, nova-vrstica.

>> old-dict-address := a item prototip pomnilniški-naslov.
a save-as: ['/tmp/a.bin'].
Izhod piši: ['========== RELOADING SNAP:'], nova-vrstica.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototip pomnilniški-naslov = old-dict-address) resnično: {
	Izhod piši: ['Object link re-attached.'], nova-vrstica.
}.

Izhod piši: b item, nova-vrstica.
