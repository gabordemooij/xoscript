Seznam ob: ['vsota'] izvedi: {
	>> skupaj := 0.
	sebe vsak: { :indeks :element
		skupaj prištej: element.
	}. <- skupaj.
}.

>> a := Resnično.



a ob: ['besedilo'] izvedi: {
	>> odgovor := Nič.
	( sebe = Resnično ) resnično: {
		odgovor := ['Aha'].
	}, sicer: {
		odgovor := ['Kje pa'].
	}. <- odgovor.
}.

a ob: ['število'] izvedi: {
	>> odgovor := Nič.
	( sebe = Resnično ) resnično: {
		odgovor := 10.
	}, sicer: {
		odgovor := 20.
	}. <- odgovor.
}.

>> b := 666.

b ob: ['besedilo'] izvedi: { <- ['Hudič'].
}.

b ob: ['logični'] izvedi: { <- Neresnično.
}.


Izhod piši: a, nova-vrstica.  
Izhod piši: (90 + a), nova-vrstica. 
Izhod piši: b, nova-vrstica. 
Izhod piši: (Resnično in: b), nova-vrstica.

a := Seznam ← ['hello'] ; ['world'] ; Resnično ; Nič ; 666. 
a := a + ( Seznam ← 1 ).
Izhod piši: a, nova-vrstica.
Izhod piši: ((Slovar nov) postavi: Nič na: Nič), nova-vrstica.
Izhod piši: a vsota, nova-vrstica. 


