Seznam ob: ['sum'] izvedi: {
	>> total := 0.
	sebe vsak: { :index :element
		total prištej: element.
	}. <- total.
}.

>> a := Resnično.



a ob: ['besedilo'] izvedi: {
	>> answer := Nič.
	( sebe = Resnično ) resnično: {
		answer := ['Yep'].
	}, sicer: {
		answer := ['Nope'].
	}. <- answer.
}.

a ob: ['število'] izvedi: {
	>> answer := Nič.
	( sebe = Resnično ) resnično: {
		answer := 10.
	}, sicer: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b ob: ['besedilo'] izvedi: { <- ['Devil'].
}.

b ob: ['logični'] izvedi: { <- Neresnično.
}.


Izhod piši: a, nova-vrstica.  
Izhod piši: (90 + a), nova-vrstica. 
Izhod piši: b, nova-vrstica. 
Izhod piši: (Resnično in: b), nova-vrstica.

a := Seznam ← ['hello'] ; ['world'] ; Resnično ; Nič ; 666. 
a := a + ( Seznam ← 1 ).
Izhod piši: a, nova-vrstica.
Izhod piši: ((Slovar nov) postavi: Nič na: Nič), nova-vrstica.
Izhod piši: a sum, nova-vrstica. 


{
	a ob: ['besedilo'] izvedi: { <- Nič. }.
	a := [''] + a.
} ujemi: { :error
	Izhod piši: ['Error noted: '] + error, nova-vrstica.
}, zaženi.



{
	a ob: ['število'] izvedi: { <- Nič. }.
	a := 3 × a.
} ujemi: { :error
	Izhod piši: ['Error noted: '] + error, nova-vrstica.
}, zaženi.


{
	a ob: ['logični'] izvedi: { <- Nič. }.
	a := Resnično in: a. 
} ujemi: { :error
	Izhod piši: ['Error noted: '] + error, nova-vrstica.
}, zaženi.





