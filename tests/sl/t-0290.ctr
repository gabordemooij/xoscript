# test list operations


>> cakes := Seznam ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes zamenjaj: 1 dolžina: 2 z: ( Seznam ← ['cinnamon'] ; ['pineapple'] ).
Izhod piši: (buy združi: [',']), nova-vrstica.


>> buy := cakes zamenjaj: 1 dolžina: 12 z: ( Seznam ← ['cinnamon'] ; ['pineapple'] ).
Izhod piši: (buy združi: [',']), nova-vrstica.


>> buy := cakes zamenjaj: 2 dolžina: 10 z: ( Seznam nov ).
Izhod piši: (buy združi: [',']), nova-vrstica.


>> buy := cakes zamenjaj: 0 dolžina: 1 z: ( Seznam nov ).
Izhod piši: (buy združi: [',']), nova-vrstica.


>> buy := cakes zamenjaj: ['0'] dolžina: ['1'] z: ['x'].
Izhod piši: (buy združi: [',']), nova-vrstica.
