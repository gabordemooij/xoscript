# test operacij s seznami


>> torte := Seznam ←
	['apple'] ;
	['jagoda'] ;
	['čokolada'] ;
	['sir'].


>> kupi := torte zamenjaj: 1 dolžina: 2 z: ( Seznam ← ['cimet'] ; ['ananas'] ).
Izhod piši: (kupi združi: [',']), nova-vrstica.


>> kupi := torte zamenjaj: 1 dolžina: 12 z: ( Seznam ← ['cimet'] ; ['ananas'] ).
Izhod piši: (kupi združi: [',']), nova-vrstica.


>> kupi := torte zamenjaj: 2 dolžina: 10 z: ( Seznam nov ).
Izhod piši: (kupi združi: [',']), nova-vrstica.


>> kupi := torte zamenjaj: 0 dolžina: 1 z: ( Seznam nov ).
Izhod piši: (kupi združi: [',']), nova-vrstica.


>> kupi := torte zamenjaj: ['0'] dolžina: ['1'] z: ['x'].
Izhod piši: (kupi združi: [',']), nova-vrstica.
