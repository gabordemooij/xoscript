
Besedilo ob: ['html'] izvedi: { <- (
		sebe
		zamenjaj: ['&'] z: ['&amp;'],
		zamenjaj: ['<'] z: ['&lt;'],
		zamenjaj: ['>'] z: ['&gt;'],
		zamenjaj: ['"'] z: ['&quot;']
	).
}.

>> HtmlČopič := Objekt nov.

HtmlČopič ob: ['odgovori:'] izvedi: { :značka
	Izhod piši: (['<tag>↵'] tag: značka ).
}.

HtmlČopič ob: ['odgovori:in:'] izvedi: { :značka :content
	značka := ( značka od: 0 dolžina: (značka dolžina - 1) ).
	Izhod piši: (['<tag content>↵'] tag: značka, content: content).
}.

HtmlČopič ob: ['content:'] izvedi: { :napis
	Izhod piši: napis html, nova-vrstica.
}.

HtmlČopič ob: ['atr:vrednost:'] izvedi: { :atr :value <- ['attr="value"'] attr: atr, value: value.
}.

>> h := HtmlČopič nov.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h atr: ['class'] vrednost: ['krepko']),
		/span
	/body
/html.
		
