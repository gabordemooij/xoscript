Izhod piši: ['1,2,3,4,5,6,7,8,9,A,'], nova-vrstica.
>> Obseg := Objekt nov.
Obseg ob: ['initialize:'] izvedi: { :x svoj lastnost := x. }.
Obseg ob: ['pritrdi'] izvedi: { Izhod piši: [',']. }.
Obseg ob: ['test'] izvedi: {
	Izhod piši: svoj lastnost.
	sebe pritrdi.
	( 1 = 1 ) resnično: { Izhod piši: svoj lastnost. sebe pritrdi. }.
	( 1 = 0 ) neresnično: { Izhod piši: svoj lastnost. sebe pritrdi. }.
	>> y := 2. { Izhod piši: svoj lastnost. sebe pritrdi. } dokler: { y odštej: 1. <- (y > 0). }.
	{ Izhod piši: svoj lastnost. sebe pritrdi. } × 1.
	(Seznam ← 1) vsak: {  Izhod piši: svoj lastnost. sebe pritrdi. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo implementiraj lastno razvrščanje, ta test ne uspe zaradi različnega števila iteracij na posameznih platformah
	(Slovar nov one: ['item']) vsak: { Izhod piši: svoj lastnost. sebe pritrdi. }.
	{ 1 ÷ 0. } ujemi: { Izhod piši: svoj lastnost. sebe pritrdi. }, zaženi.
	Izhod nova-vrstica.
}.
>> obseg1 := Obseg nov.
obseg1 initialize: ['X'].
obseg1 test.
>> mojaFunkcija := { 
	svoj lastnost := ['Y'].
	Izhod piši: svoj lastnost.
	sebe pritrdi.
	( 1 = 1 ) resnično: { Izhod piši: svoj lastnost. sebe pritrdi. }.
	( 1 = 0 ) neresnično: { Izhod piši: svoj lastnost. sebe pritrdi. }.
	>> y := 2. { Izhod piši: svoj lastnost. sebe pritrdi. } dokler: { y odštej: 1. <- (y > 0). }.
	{ Izhod piši: svoj lastnost. sebe pritrdi. } × 1.
	(Seznam ← 1) vsak: {  Izhod piši: svoj lastnost. sebe pritrdi. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Slovar nov one: ['item']) vsak: { Izhod piši: svoj lastnost. sebe pritrdi. }.
	{ 1 ÷ 0. } ujemi: { Izhod piši: svoj lastnost. sebe pritrdi. }, zaženi.
	Izhod nova-vrstica.
}.
mojaFunkcija ob: ['pritrdi'] izvedi: { Izhod piši: [',']. }.
mojaFunkcija uporabi: 1 in: 2.
