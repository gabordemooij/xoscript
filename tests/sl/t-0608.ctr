
>> Size := Objekt nov.
Size ob: ['is:'] izvedi: { :število
	število ob: ['+'] izvedi: { :število
		>> unit := število določilo.
		>> factor := 1.
		
		unit
		primer: ['inch'] izvedi: { factor := 0.0833. }. <- sebe + (število * factor).
	}. <- število.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Izhod piši: plank + edge, nova-vrstica.
