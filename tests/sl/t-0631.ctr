#test ffi


Server init.

Program upravljanje-pomnilnika: 4.

# za ta test moraš nastaviti pot do libc (puts)
>> imeKnjižnice := Program nastavitev: ['FFITESTLIB'].



Server poveži: (
 Seznam nov ;
 imeKnjižnice ;
 ['puts'] ;
 ( Seznam nov ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s sprosti.

# test s strukturo

>> a := Blob nov: 8.
a bytes: (
	Seznam <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struktura := Blob struct: (Seznam <<: ['int'], ; ['int']).

Server poveži: (
	Seznam <<: ['@structtest'], ;
	['@structtest'] ;
	(Seznam <<: struktura) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Izhod piši: ['Test vsote:'] + (ffitest ffisum: a), nova-vrstica.

struktura sprosti-struct.
struktura sprosti.
a sprosti.
