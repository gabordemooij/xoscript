Server init.

>> PB := Maria-DB nov gostitelj: ['localhost'],
	uporabnik: ['xo'],
	geslo: ['pass123'],
	ime-baze: ['xobase'],
	poveži-se.
	
>> SQL := ['SELECT "hello" AS "world" '].

# hitrejši način, dobi poizvedbo iz PB:
>> poizvedba2 := PB poizvedba: SQL.

# zdaj ti ni treba nastaviti PB
poizvedba2 pridobi: { :vrsta
	Izhod piši: vrsta world, nova-vrstica.
}.
