Server init.

>> DB := Maria-DB nov gostitelj: ['localhost'],
	uporabnik: ['xo'],
	geslo: ['pass123'],
	ime-baze: ['xobase'],
	poveži-se.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB poizvedba: SQL.

# now you don't have to set DB
query2 pridobi: { :row
	Izhod piši: row world, nova-vrstica.
}.
