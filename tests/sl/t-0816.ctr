# oblika se mora ujemati s tipom vrednosti, tip lahko pride od odjemalca
>> poskusi := { :oblika :value
	{ Izhod piši: ( (Format nov: oblika) uporabi: value ), nova-vrstica. } ujemi: { :e Izhod piši: e, nova-vrstica. }, zaženi.
}.
>> poskusi-celo := { :oblika :value
	{ Izhod piši: ( (Format nov: oblika) uporabi-celo: value ), nova-vrstica. } ujemi: { :e Izhod piši: e, nova-vrstica. }, zaženi.
}.

# ustreza
poskusi uporabi: ['|%s|'] in: ['text'].
poskusi uporabi: ['%06.2f'] in: 5.5.
poskusi uporabi: ['100%% %s'] in: ['seveda'].
poskusi-celo uporabi: ['%03d'] in: 7.
poskusi-celo uporabi: ['%x'] in: 255.
poskusi uporabi: ['%d'] in: (Int64 nov iz-besedila: ['12']).
poskusi uporabi: ['%lld'] in: (Int64 nov iz-besedila: ['12']).
poskusi uporabi: ['%.1lf'] in: 5.5.
poskusi-celo uporabi: ['%hd'] in: 7.

# ne ustreza
poskusi uporabi: ['%s'] in: 12345.
poskusi uporabi: ['%d'] in: 12345.
poskusi uporabi: ['%f'] in: ['text'].
poskusi-celo uporabi: ['%d'] in: ['text'].
poskusi-celo uporabi: ['%s'] in: 5.
poskusi uporabi: ['%s %s'] in: ['text'].
poskusi uporabi: ['%n'] in: ['text'].
poskusi uporabi: ['%*s'] in: ['text'].
poskusi uporabi: ['%'] in: ['text'].

# modifikator dolžine ne ustreza
poskusi uporabi: ['%ls'] in: ['text'].
poskusi uporabi: ['%Lf'] in: 5.5.
poskusi-celo uporabi: ['%ld'] in: 7.
poskusi-celo uporabi: ['%lld'] in: 7.
poskusi uporabi: ['%Ld'] in: (Int64 nov iz-besedila: ['12']).

# širina, ki ne ustreza printf, mora dati napako, ne sesutja
poskusi uporabi: ['%99999999999s'] in: ['text'].
