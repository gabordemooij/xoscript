
>> besednjak := (
	Slovar nov
		postavi: ['b'] na: ['a'],
		postavi: ['a'] na: ['b'],
		postavi: ['z'] na: ['x'],
		postavi: ['hello'] na: ['hallo'],
		postavi: ['human'] na: ['human']
).

>> primerjave := Seznam nov.
besednjak vsak: { :a :b
	primerjave ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a primerjaj: b)
	).
}.

primerjave razvrsti: { :a :b <- ( a primerjaj: b ). }.
Izhod piši: ( primerjave združi: ['↵'] ), nova-vrstica.
primerjave združi: ['↵'].
