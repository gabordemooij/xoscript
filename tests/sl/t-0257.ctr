
>> Pozdravljalec := Objekt nov.
Pozdravljalec ob: ['nov'] izvedi: {
	svoj ime := ['?'].
}.
Pozdravljalec ob: ['name:'] izvedi: { :ime
	svoj ime := ime.
}.
Pozdravljalec ob: ['pozdravi'] izvedi: {
	Izhod piši: (['hello[you]'] [you]: svoj ime).
}.
>> prijatelj := Pozdravljalec nov.
prijatelj name: ['1'].
prijatelj pozdravi.
