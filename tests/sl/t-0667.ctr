# test Program version

# this feature is disabled by default
Izhod piši: (
	Program zmožnost: 
	['RECURSIVE_STRINTPOL']
), nova-vrstica.


# but if we set the time back
>> today := Trenutek 
cona: ['CEST'],
iz: ['2026-02-15 10:00:00'].
Program različica: today.

# it will be enabled like it used to be (from now on)
Izhod piši: (
	Program zmožnost: 
	['RECURSIVE_STRINTPOL']
), nova-vrstica.