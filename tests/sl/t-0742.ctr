Izhod piši: ['Testni objekt'], nova-vrstica.
>> a := Objekt nov. 

a ob: ['item:'] izvedi: { :hekspomočnik
	svoj hekspomočnik := hekspomočnik. 
}.

a ob: ['predmet'] izvedi: {
	<- svoj hekspomočnik.
}.

a item: Hx nov.

>> stari-hekspomočnik-naslov := a predmet prototip pomnilniški-naslov.
a save-as: ['/tmp/a.bin'].
Izhod piši: ['========== PONOVNO NALAGANJE POSNETKA:'], nova-vrstica.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b predmet prototip pomnilniški-naslov = stari-hekspomočnik-naslov) resnično: {
	Izhod piši: ['Povezava objekta ponovno priključena.'], nova-vrstica.
}.
