Izhod piši: ['Test object'], nova-vrstica.
>> a := Objekt nov. 

a ob: ['item:'] izvedi: { :hexhelper
	svoj hexhelper := hexhelper. 
}.

a ob: ['item'] izvedi: { <- svoj hexhelper.
}.

a item: Hx nov.

>> old-hexhelper-address := a item prototip pomnilniški-naslov.
a save-as: ['/tmp/a.bin'].
Izhod piši: ['========== RELOADING SNAP:'], nova-vrstica.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototip pomnilniški-naslov = old-hexhelper-address) resnično: {
	Izhod piši: ['Object link re-attached.'], nova-vrstica.
}.
