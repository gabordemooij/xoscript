>> Grandfather := Objekt nov.
Grandfather ob: ['greet'] izvedi: {
	Izhod piši: ['Ave!'], nova-vrstica.
}.
>> Father := Grandfather nov.
Father ob: ['greet'] izvedi: {
	Izhod piši: ['Hello'], nova-vrstica.
	sebe greet.
}.
>> Son := Father nov.
Son ob: ['greet'] izvedi: {
	Izhod piši: ['Hi'], nova-vrstica.
	sebe greet.
}.

Son greet.

>> Roundabout := Objekt nov.
Roundabout ob: ['circle:'] izvedi: { :x
	Izhod piši: x, nova-vrstica.
	(x < 3) resnično: { sebe rekurziven circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) resnično: { Izhod piši: x, nova-vrstica. x prištej: 1.  increment zaženi. }. }.
increment zaženi.