# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB nov gostitelj: ['localhost'],
	uporabnik: ['xo'],
	geslo: ['pass123'],
	ime-baze: ['xobase'],
	poveži-se.

>> iskalni-parametri := db poizvedba: ['SELECT %% FROM'].
{ iskalni-parametri izvedi. } ujemi: { :e
	Izhod piši: ( e vsebuje: ['%%'] ), nova-vrstica.
}, zaženi.
