Server init.
Izhod piši: ['Database date test'], nova-vrstica.

>> db := Maria-DB nov gostitelj: ['localhost'],
	uporabnik: ['xo'], 
	geslo: ['pass123'],
	ime-baze: ['xobase'],
	poveži-se.

>> iskalni-parametri :=
db poizvedba: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
pridobi: { :row
	Izhod piši: row datetest, nova-vrstica.
}.
