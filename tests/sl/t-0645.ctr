Server init.
Izhod piši: ['Test datuma v podatkovni bazi'], nova-vrstica.

>> pb := Maria-DB nov gostitelj: ['localhost'],
	uporabnik: ['xo'], 
	geslo: ['pass123'],
	ime-baze: ['xobase'],
	poveži-se.

>> iskalni-parametri :=
pb poizvedba: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
pridobi: { :vrsta
	Izhod piši: vrsta datetest, nova-vrstica.
}.
