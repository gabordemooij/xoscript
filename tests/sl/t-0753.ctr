Izhod piši: ['Testni objekt'], nova-vrstica.
>> a := Objekt nov. 

a ob: ['item:'] izvedi: { :fmt
	svoj fmt := fmt. 
}.

a ob: ['predmet'] izvedi: {
	<- svoj fmt.
}.

a item: ( Format nov: ['|%s|'] ).

Izhod piši: a predmet, nova-vrstica.

>> stari-fmt-naslov := a predmet prototip pomnilniški-naslov.
a save-as: ['/tmp/a.bin'].
Izhod piši: ['========== PONOVNO NALAGANJE POSNETKA:'], nova-vrstica.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b predmet prototip pomnilniški-naslov = stari-fmt-naslov) resnično: {
	Izhod piši: ['Povezava objekta ponovno priključena.'], nova-vrstica.
}.

Izhod piši: ( b predmet uporabi: ['hello'] ), nova-vrstica.
