Izhod piši: ['Test object'], nova-vrstica.
>> a := Objekt nov. 

a ob: ['item:'] izvedi: { :fmt
	svoj fmt := fmt. 
}.

a ob: ['item'] izvedi: { <- svoj fmt.
}.

a item: ( Format nov: ['|%s|'] ).

Izhod piši: a item, nova-vrstica.

>> old-fmt-address := a item prototip pomnilniški-naslov.
a save-as: ['/tmp/a.bin'].
Izhod piši: ['========== RELOADING SNAP:'], nova-vrstica.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototip pomnilniški-naslov = old-fmt-address) resnično: {
	Izhod piši: ['Object link re-attached.'], nova-vrstica.
}.

Izhod piši: ( b item uporabi: ['hello'] ), nova-vrstica.
