# test number -> string -> number
{

	>> x := Število med: 0 in: 1000000.
	>> d := Število med: 1 in: 7.
	>> e := 10 potenca: d.

	x deli-z: e.
	>> y := x besedilo število.

	(x = y) neresnično: {
		Izhod piši: x, nova-vrstica.
		Izhod piši: y, nova-vrstica.
		Program konec.
	}.

} * 1000.
Izhod piši: ['OK'], nova-vrstica.