Izhod piši: ['Test object'], nova-vrstica.
>> a := Objekt nov. 

a ob: ['item:'] izvedi: { :octhelper
	svoj octhelper := octhelper. 
}.

a ob: ['item'] izvedi: { <- svoj octhelper.
}.

a item: Oct nov.

>> old-octhelper-address := a item prototip pomnilniški-naslov.
a save-as: ['/tmp/a.bin'].
Izhod piši: ['========== RELOADING SNAP:'], nova-vrstica.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototip pomnilniški-naslov = old-octhelper-address) resnično: {
	Izhod piši: ['Object link re-attached.'], nova-vrstica.
}.
