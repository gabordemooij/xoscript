Izhod piši: ['Testni objekt'], nova-vrstica.
>> a := Objekt nov. 

a ob: ['item:'] izvedi: { :oktpomočnik
	svoj oktpomočnik := oktpomočnik. 
}.

a ob: ['predmet'] izvedi: {
	<- svoj oktpomočnik.
}.

a item: Oct nov.

>> stari-oktpomočnik-naslov := a predmet prototip pomnilniški-naslov.
a save-as: ['/tmp/a.bin'].
Izhod piši: ['========== PONOVNO NALAGANJE POSNETKA:'], nova-vrstica.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b predmet prototip pomnilniški-naslov = stari-oktpomočnik-naslov) resnično: {
	Izhod piši: ['Povezava objekta ponovno priključena.'], nova-vrstica.
}.
