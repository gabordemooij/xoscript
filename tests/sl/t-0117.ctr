>> t := Resnično.
(t = Resnično) resnično: { Izhod piši: ['T']. }.
(t = Neresnično) resnično: { Izhod piši: ['F']. }.
Izhod piši: ['|'].
>> t := Neresnično.
(t = Resnično) resnično: { Izhod piši: ['T']. }.
(t = Neresnično) resnično: { Izhod piši: ['F']. }.
Izhod piši: ['|'].
>> f := Resnično.
(t = Resnično in: f = Neresnično) resnično: { Izhod piši: ['T']. }.
(t = Neresnično in: f = Resnično) resnično: { Izhod piši: ['F']. }.
Izhod piši: ['|'].
>> n := Nič.
(n Nič?) resnično: { Izhod piši: ['T']. }.
(n Nič?) neresnično: { Izhod piši: ['F']. }.
Izhod piši: ['|'].
(f Boolean?) resnično: { Izhod piši: ['T']. }.
(f Boolean?) neresnično: { Izhod piši: ['F']. }.



