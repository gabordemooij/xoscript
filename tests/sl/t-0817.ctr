# a value ending in the first part of an opening quote must survive serialization
>> vrednosti := Seznam nov
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

vrednosti vsak: { :i :value
	>> d := Slovar nov.
	d postavi: value na: ['k'].
	d postavi: ['second'] na: ['j'].
	>> r := d koda objekt.
	Izhod piši: r število-elementov, nova-vrstica.
	Izhod piši: ( (r na: ['k']) = value ), nova-vrstica.
}.
