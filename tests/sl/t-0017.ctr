Število ob: ['fakulteta'] izvedi: {
	>> skupaj := 1.
	{ :indeks skupaj pomnoži-z: (sebe - (indeks)). } × sebe. <- skupaj.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Izhod piši: a.
>> b := 2 + 3 fakulteta.
Izhod piši: b.
>> c := 3 fakulteta + 2.
Izhod piši: c.
>> d := 2 + (3 fakulteta).
Izhod piši: d.
Izhod piši: 2 + 3 fakulteta + 1.
