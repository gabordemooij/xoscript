Število ob: ['factorial'] izvedi: {
	>> total := 1.
	{ :index total pomnoži-z: (sebe - (index)). } × sebe. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Izhod piši: a.
>> b := 2 + 3 factorial.
Izhod piši: b.
>> c := 3 factorial + 2.
Izhod piši: c.
>> d := 2 + (3 factorial).
Izhod piši: d.
Izhod piši: 2 + 3 factorial + 1.
