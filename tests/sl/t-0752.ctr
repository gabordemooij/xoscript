Izhod piši: ['Test object'], nova-vrstica.
>> a := Objekt nov. 

a ob: ['item:'] izvedi: { :logični
	svoj logični := logični. 
}.

a ob: ['item'] izvedi: { <- svoj logični.
}.

a item: Logični.

Izhod piši: a item, nova-vrstica.

>> old-bool-address := a item prototip pomnilniški-naslov.
a save-as: ['/tmp/a.bin'].
Izhod piši: ['========== RELOADING SNAP:'], nova-vrstica.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototip pomnilniški-naslov = old-bool-address) resnično: {
	Izhod piši: ['Object link re-attached.'], nova-vrstica.
}.

Izhod piši: b item, nova-vrstica.
