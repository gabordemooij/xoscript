# test pretvorb tipov / pretvorb / vezav
Program upravljanje-pomnilnika: 4.
Server init.

>> števec := 0.
>> pb := Maria-DB nov gostitelj: ['localhost'],
	uporabnik: ['xo'], geslo: ['pass123'], ime-baze: ['xobase'], poveži-se.

>> DvomestniFormat := Format nov: ['%02d'].

# Datum in čas
{
	>> leto     := Število med: 1995 in: 2050, besedilo.
	>> mesec    := DvomestniFormat uporabi-celo: (Število med: 1 in: 12), besedilo.
	>> dan      := DvomestniFormat uporabi-celo: (Število med: 1 in: 28), besedilo.
	>> ura     := DvomestniFormat uporabi-celo: (Število med: 1 in: 23), besedilo.
	>> minuta   := DvomestniFormat uporabi-celo: (Število med: 1 in: 59), besedilo.
	>> sekunda   := DvomestniFormat uporabi-celo: (Število med: 1 in: 59), besedilo.
	>> datetime := ['YYYY-MM-DD HH:II:SS'].	
	datetime
		YYYY: leto,
		MM: mesec,
		DD: dan,
		HH: ura,
		II: minuta,
		SS: sekunda.
	>> iskalni-parametri :=
	pb poizvedba: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: datetime),
	pridobi: { :vrsta
		(vrsta mydatetime = datetime) neresnično: {
			ta-naloga napaka: (
				['Pričakovano: <expected>, dobljeno pa: <observation>']
				<expected>: datetime,
				<observation>: vrsta mydatetime
			).
		}.
	
	}.
	števec prištej: 1.
} * 100.

# Datum
{
	>> leto     := Število med: 1995 in: 2050, besedilo.
	>> mesec    := DvomestniFormat uporabi-celo: (Število med: 1 in: 12), besedilo.
	>> dan      := DvomestniFormat uporabi-celo: (Število med: 1 in: 28), besedilo.
	>> date     := ['YYYY-MM-DD'].
	date
		YYYY: leto,
		MM: mesec,
		DD: dan.
	>> iskalni-parametri :=
	pb poizvedba: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: date),
	pridobi: { :vrsta
		(vrsta mydate = date) neresnično: {
			ta-naloga napaka: (
				['Pričakovano: <expected>, dobljeno pa: <observation>']
				<expected>: date,
				<observation>: vrsta mydate
			).
		}.
	}.
	števec prištej: 1.
} * 100.


# Čas
{
	>> ura     := DvomestniFormat uporabi-celo: (Število med: 1 in: 23), besedilo.
	>> minuta   := DvomestniFormat uporabi-celo: (Število med: 1 in: 59), besedilo.
	>> sekunda   := DvomestniFormat uporabi-celo: (Število med: 1 in: 59), besedilo.
	>> čas := ['HH:II:SS'].
	čas
		HH: ura,
		II: minuta,
		SS: sekunda.
	>> iskalni-parametri :=
	pb poizvedba: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: čas),
	pridobi: { :vrsta
		(vrsta mytime = čas) neresnično: {
			ta-naloga napaka: (
				['Pričakovano: <expected>, dobljeno pa: <observation>']
				<expected>: datetime,
				<observation>: vrsta mytime
			).
		}.
	}.
	števec prištej: 1.
} * 100.


# Besedila (varchar/text)
>> str1 := Seznam nov napolni: 100000 z: ['x'], združi: [''].
{
	>> str2 := Sef žeton: 40.
	>> iskalni-parametri :=
	pb poizvedba: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	pridobi: { :vrsta
		(vrsta str1 = str1 in: vrsta str2 = str2) neresnično: {
			ta-naloga napaka: (
				['Pričakovano: <expected>, dobljeno pa: <observation>']
				<expected>: datetime,
				<observation>: vrsta mytime
			).
		}.
	}.
	števec prištej: 1.
} * 100.


# Števila
{
	>> n1  := Število med: 1 in: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 iz-besedila: ['9223372036854775807'] ) -
		( Int64 iz-besedila: ['99999'] ) +
		( Int64 iz-besedila: n1 besedilo )
	).
	>> iskalni-parametri :=
	pb poizvedba: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	pridobi: { :vrsta
		(vrsta n1 = n1) neresnično: {
			ta-naloga napaka: (
				['Pričakovano: <expected>, dobljeno pa: <observation>']
				<expected>: n1,
				<observation>: vrsta n1
			).
		}.
		(vrsta n2 = n2) neresnično: {
			ta-naloga napaka: (
				['Pričakovano: <expected>, dobljeno pa: <observation>']
				<expected>: n1,
				<observation>: vrsta n2
			).
		}.
		(vrsta n3 = n2 zaokroži) neresnično: {
			ta-naloga napaka: (
				['Pričakovano: <expected>, dobljeno pa: <observation>']
				<expected>: n1,
				<observation>: vrsta n3
			).
		}.
		(vrsta big = big) neresnično: {
			ta-naloga napaka: (
				['Pričakovano: <expected>, dobljeno pa: <observation>']
				<expected>: big,
				<observation>: vrsta big
			).
		}.
		
	}.
	števec prištej: 1.
} * 100.


Izhod piši: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: števec
), nova-vrstica.