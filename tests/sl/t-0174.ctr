


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program upravljanje-pomnilnika: 0.
>> palette := Nič.
>> colors := Nič.

{
palette := Slovar nov.
palette 
	postavi: ['#F00'] na: ['red'],
	postavi: ['#0F0'] na: ['green'],
	postavi: ['#00F'] na: ['blue'].
Izhod piši: ['number of RGB codes in palette: '] + ( palette število-elementov ), nova-vrstica.
Izhod piši: ['RGB code of green is: '] + ( palette ? ['green'] ), nova-vrstica.
colors := [''].
( palette vsak: { :ime :koda
		colors := colors + ( ime + [':'] + koda ).
} ).
Izhod piši: ['All colors in palette: '] + colors, nova-vrstica.
} zaženi.
Program počisti.
usedMemory1 := (Program pomnilnik ? 0).

