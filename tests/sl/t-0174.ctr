


>> porabljenPomnilnik1 := 0.
>> porabljenPomnilnik2 := 0.
>> porabljenPomnilnik3 := 0.
>> porabljenPomnilnik4 := 0.

Program upravljanje-pomnilnika: 0.
>> paleta := Nič.
>> barve := Nič.

{
paleta := Slovar nov.
paleta 
	postavi: ['#F00'] na: ['rdeča'],
	postavi: ['#0F0'] na: ['zelena'],
	postavi: ['#00F'] na: ['modra'].
Izhod piši: ['število RGB kod v paleti: '] + ( paleta število-elementov ), nova-vrstica.
Izhod piši: ['RGB koda zelene je: '] + ( paleta ? ['zelena'] ), nova-vrstica.
barve := [''].
( paleta vsak: { :ime :koda
		barve := barve + ( ime + [':'] + koda ).
} ).
Izhod piši: ['Vse barve v paleti: '] + barve, nova-vrstica.
} zaženi.
Program počisti.
porabljenPomnilnik1 := (Program pomnilnik ? 0).

