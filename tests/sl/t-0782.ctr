Izhod piši: ['Test object'], nova-vrstica.
>> cmd := Ukaz nov.
Izhod piši: cmd ls /tmp, nova-vrstica.
>> old-cmd-address := cmd prototip pomnilniški-naslov.
cmd save-as: ['/tmp/a.bin'].
Izhod piši: ['========== RELOADING SNAP:'], nova-vrstica.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b prototip pomnilniški-naslov = old-cmd-address) resnično: {
	Izhod piši: ['Object link re-attached.'], nova-vrstica.
}.
Izhod piši: b ls, nova-vrstica.


