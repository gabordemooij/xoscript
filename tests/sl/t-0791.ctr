Server init.

>> DB := Maria-DB nov gostitelj: ['localhost'],
	uporabnik: ['xo'],
	geslo: ['pass123'],
	ime-baze: ['xobase'],
	poveži-se.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> iskalni-parametri := Maria-Poizvedba nov: SQL.

# set database
iskalni-parametri podatkovna-baza: DB.

iskalni-parametri pridobi: { :row
	Izhod piši: row world, nova-vrstica.
}.
