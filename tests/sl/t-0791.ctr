Server init.

>> PB := Maria-DB nov gostitelj: ['localhost'],
	uporabnik: ['xo'],
	geslo: ['pass123'],
	ime-baze: ['xobase'],
	poveži-se.
	
>> SQL := ['SELECT "hello" AS "world" '].

# ročno ustvari poizvedbo
>> iskalni-parametri := Maria-Poizvedba nov: SQL.

# nastavi podatkovno bazo
iskalni-parametri podatkovna-baza: PB.

iskalni-parametri pridobi: { :vrsta
	Izhod piši: vrsta world, nova-vrstica.
}.
