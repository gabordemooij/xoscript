


>> Deck := Seznam nov.
Deck ob: ['print'] izvedi: {
        >> len := sebe število-elementov - 1.
        { :i
                >> len2 := sebe število-elementov - 1.
                Izhod piši: ['len: '].
                Izhod piši: len, nova-vrstica.
                Izhod piši: ['len2: '].
                Izhod piši: len2, nova-vrstica.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
