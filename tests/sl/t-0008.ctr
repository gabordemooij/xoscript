>> Greeter := Objekt nov.
Greeter ob: ['make'] izvedi: {
	>> greeter := Objekt nov.
	greeter ob: ['name:'] izvedi: { :ime
		Izhod piši: ['setting a name'].
		svoj myName := ime.
	}.
	greeter ob: ['greet'] izvedi: {
		Izhod piši: ['Hello'].
		Izhod piši: svoj myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
