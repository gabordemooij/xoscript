Besedilo ob: ['html'] izvedi: { <- (
		sebe
		zamenjaj: ['&'] z: ['&amp;'],
		zamenjaj: ['<'] z: ['&lt;'],
		zamenjaj: ['>'] z: ['&gt;'],
		zamenjaj: ['''] z: ['&apos;'],
		zamenjaj: ['"'] z: ['&quot;']
	).
}.

>> porabljenPomnilnik1 := 0.
>> porabljenPomnilnik2 := 0.
>> porabljenPomnilnik3 := 0.
>> porabljenPomnilnik4 := 0.

Program upravljanje-pomnilnika: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Izhod piši: txt kopiraj html, nova-vrstica.
Izhod piši: txt kopiraj male-črke, nova-vrstica.
Izhod piši: txt kopiraj velike-črke, nova-vrstica.
} zaženi.

Program počisti.

porabljenPomnilnik1 := (Program pomnilnik ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Izhod piši: txt kopiraj html, nova-vrstica.
Izhod piši: txt kopiraj male-črke, nova-vrstica.
Izhod piši: txt kopiraj velike-črke, nova-vrstica.
} zaženi.

Program počisti.
porabljenPomnilnik2 := (Program pomnilnik ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Izhod piši: txt kopiraj html, nova-vrstica.
Izhod piši: txt kopiraj male-črke, nova-vrstica.
Izhod piši: txt kopiraj velike-črke, nova-vrstica.
} zaženi.

Program počisti.
porabljenPomnilnik3 := (Program pomnilnik ? 0).



( porabljenPomnilnik1 = porabljenPomnilnik2 in: porabljenPomnilnik1 = porabljenPomnilnik3, in: porabljenPomnilnik2 = porabljenPomnilnik3 ) resnično: {
	Izhod piši: ['Tukaj ni puščanja pomnilnika'].
}, neresnično: {
	Izhod piši: ['Pomnilnik pušča...'].
}.
