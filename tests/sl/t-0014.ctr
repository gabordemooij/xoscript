>> Greeter := Objekt nov.
Greeter ob: ['make'] izvedi: {
	>> gr := Objekt nov.
	gr ob: ['setName:'] izvedi: { :aname
		svoj ime := aname.
	}.
	gr ob: ['greet'] izvedi: {
		Izhod piši: svoj ime.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a nov.
c setName: ['THREE'].
c greet.
>> d := a nov.
d setName: ['FOUR'].
d greet.
c greet.
