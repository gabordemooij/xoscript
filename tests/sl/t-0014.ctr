>> Pozdravljalec := Objekt nov.
Pozdravljalec ob: ['naredi'] izvedi: {
	>> pz := Objekt nov.
	pz ob: ['setName:'] izvedi: { :nekoIme
		svoj ime := nekoIme.
	}.
	pz ob: ['pozdravi'] izvedi: {
		Izhod piši: svoj ime.
	}. <- pz.
}.
>> a := Pozdravljalec naredi.
>> b := Pozdravljalec naredi.
a setName: ['ENA'].
b setName: ['DVA'].
a pozdravi.
b pozdravi.
>> c := a nov.
c setName: ['TRI'].
c pozdravi.
>> d := a nov.
d setName: ['ŠTIRI'].
d pozdravi.
c pozdravi.
