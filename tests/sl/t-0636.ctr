# test razčlenjevanja url

Server init.
>> url := URL iz: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Izhod piši: ['shema = '] + url shema, nova-vrstica.
Izhod piši: ['gostitelj = '] + url gostitelj, nova-vrstica.
Izhod piši: ['vrata = '] + url vrata, nova-vrstica.
Izhod piši: ['pot = '] + url pot, nova-vrstica.
Izhod piši: ['poizvedba = '] + url iskalni-parametri, nova-vrstica.
Izhod piši: ['fragment = '] + url fragment, nova-vrstica.
