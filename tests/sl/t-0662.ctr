>> t := Nič.

# you can control the time zone for
# parsing like this:
Trenutek cona: ['CET'].
t := Trenutek iz: ['1981-02-03 04:05:06'].
Izhod piši: t, nova-vrstica.

# now using CEST time zone:
Trenutek cona: ['CEST'].
t := Trenutek iz: ['1981-02-03 04:05:06'].
Izhod piši: t, nova-vrstica.

# error if string cannot be parsed
{ Trenutek iz: ['1900']. } ujemi: { Nič. }, zaženi.
