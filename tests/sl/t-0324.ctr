>> Animal := Objekt nov.
>> Factory := Objekt nov.

Animal ob: ['nov'] izvedi: {
	>> animal := sebe nov.
	animal sound: ['?']. <- animal.
}.

Animal ob: ['sound:'] izvedi: { :s
	svoj sound := s.
}.

Animal ob: ['sound'] izvedi: { <- svoj sound.
}.

>> Dog := Objekt nov.
>> Cat := Objekt nov.

Dog ob: ['nov'] izvedi: { <- Animal nov sound: ['woof!'].
}.

Cat ob: ['nov'] izvedi: { <- Animal nov sound: ['meow!'].
}.

Izhod piši: Dog nov sound, nova-vrstica.
Izhod piši: Cat nov sound, nova-vrstica.

Factory ob: ['mix:and:'] izvedi: { :beast1 :beast2 <- Animal nov sound: (
		( beast1 sound od: 0 dolžina: 2 ) +
		( beast2 sound od: 2 dolžina: 5 )
	).
}.

Izhod piši: (Factory mix: Dog nov and: Cat nov) sound, nova-vrstica.
