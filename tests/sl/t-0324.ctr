>> Žival := Objekt nov.
>> Tovarna := Objekt nov.

Žival ob: ['nov'] izvedi: {
	>> žival := sebe nov.
	žival sound: ['?']. <- žival.
}.

Žival ob: ['sound:'] izvedi: { :s
	svoj zvok := s.
}.

Žival ob: ['zvok'] izvedi: { <- svoj zvok.
}.

>> Pes := Objekt nov.
>> Mačka := Objekt nov.

Pes ob: ['nov'] izvedi: { <- Žival nov sound: ['woof!'].
}.

Mačka ob: ['nov'] izvedi: { <- Žival nov sound: ['meow!'].
}.

Izhod piši: Pes nov zvok, nova-vrstica.
Izhod piši: Mačka nov zvok, nova-vrstica.

Tovarna ob: ['zmešaj:in:'] izvedi: { :zver1 :zver2 <- Žival nov sound: (
		( zver1 zvok od: 0 dolžina: 2 ) +
		( zver2 zvok od: 2 dolžina: 5 )
	).
}.

Izhod piši: (Tovarna zmešaj: Pes nov in: Mačka nov) zvok, nova-vrstica.
