>> a := Seznam ← Objekt ; Resnično ; Neresnično ; Logični ; 1 ; Število ; ['Str'] ; Besedilo ; { ['Empty']. }.
Izhod piši: (a število-elementov), nova-vrstica.
{ :i
	Izhod piši: 
	['a '] + 
	((a ? i) tip) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Nič?) ali: [''] ali: ['NOT']) + 
	[' Nil.'],
	nova-vrstica.
} × (a število-elementov).
Izhod piši: ['but.. Nil is.. '] + ((Nič Nič?) ali: ['certainly NIL!'] ali: ['not NIL??']), nova-vrstica.