# compliance test

# use international numbers

Izhod piši: ['1000 -> '].
Izhod piši: 1000, nova-vrstica. #1000

Izhod piši: ['1.5 -> '].
Izhod piši: 1.5, nova-vrstica.  #1.5

Izhod piši: ['1001.5 -> '].
Izhod piši: 1.5 + 1000, nova-vrstica. #1001.5

# use 0-indexed arrays
>> x := Seznam nov ; 1 ; 2 ; 3.
>> y := Seznam nov ; ['a'] ; ['b'] ; ['c'].

Izhod piši: ['1 -> '].
Izhod piši: x ? 0, nova-vrstica. #1

Izhod piši: ['1 -> '].
Izhod piši: (x na: 0), nova-vrstica. #1

Izhod piši: ['1 -> '].
Izhod piši: x prvi, nova-vrstica. #1

Izhod piši: ['3 -> '].
Izhod piši: x zadnji, nova-vrstica. #3

Izhod piši: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Izhod piši: (x po: y), nova-vrstica.

Izhod piši: ['1 -> '].
Izhod piši: (x od: 0 dolžina: 1) prvi, nova-vrstica. #1

Izhod piši: ['0 -> '].
Izhod piši: (x najdi: 1), nova-vrstica. #0

x postavi: 9 na: 0.

Izhod piši: ['9 -> '].
Izhod piši: (x na: 0), nova-vrstica. #9

x dodaj-na-začetek: 8.
Izhod piši: ['8 -> '].
Izhod piši: (x na: 0), nova-vrstica. #9


x dodaj-na-konec: 10.
Izhod piši: ['10 -> '].
Izhod piši: (x na: 4), nova-vrstica. #10








