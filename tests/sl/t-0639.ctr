
Server init.
Izhod piši: ['Database test'], nova-vrstica.

>> db := Maria-DB nov gostitelj: ['localhost'],
	uporabnik: ['xo'], 
	geslo: ['pass123'],
	ime-baze: ['xobase'],
	poveži-se.

>> iskalni-parametri :=
db poizvedba: ['SELECT REPEAT('Blah',1000) AS blah'], 
pridobi: { :row 
	Izhod piši: row blah dolžina, nova-vrstica.
}.
