
Server init.
Izhod piši: ['Test podatkovne baze'], nova-vrstica.

>> pb := Maria-DB nov gostitelj: ['localhost'],
	uporabnik: ['xo'], 
	geslo: ['pass123'],
	ime-baze: ['xobase'],
	poveži-se.

>> iskalni-parametri :=
pb poizvedba: ['SELECT REPEAT('Blah',1000) AS blah'], 
pridobi: { :vrsta 
	Izhod piši: vrsta blah dolžina, nova-vrstica.
}.
