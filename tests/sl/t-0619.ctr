>> HTML := Objekt nov.
HTML ob: ['odgovori:'] izvedi: { :značka 
	Izhod piši: (['<tag>'] tag: značka), nova-vrstica.
}.
HTML ob: ['odgovori:in:'] izvedi: { :značka :html 
	Izhod piši: (
		['<tag>innerHTML</tag>']
		tag: značka - [':'],
		innerHTML: html
	), nova-vrstica.
}.
>> html := HTML nov.
html body h1: ['header'].

