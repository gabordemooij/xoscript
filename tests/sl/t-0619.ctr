>> HTML := Objekt nov.
HTML ob: ['odgovori:'] izvedi: { :tag 
	Izhod piši: (['<tag>'] tag: tag), nova-vrstica.
}.
HTML ob: ['odgovori:in:'] izvedi: { :tag :html 
	Izhod piši: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), nova-vrstica.
}.
>> html := HTML nov.
html body h1: ['header'].

