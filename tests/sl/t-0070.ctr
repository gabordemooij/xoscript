>> števila := ['1,2,3'] razdeli: [','].
Izhod piši: ['Dobil sem: '] + števila število-elementov + [' števil.'],nova-vrstica.
{ :i Izhod piši: ['number #'] + i + [':'] + (števila položaj: i), nova-vrstica.} × 3.
>> pijače := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
pijače := pijače razdeli: [' Or '].
Izhod piši: ['Strežemo'], nova-vrstica.
{ :i Izhod piši: ['->'] + (pijače položaj: i), nova-vrstica. } × (pijače število-elementov).
Izhod piši: (pijače združi: [',']), nova-vrstica.
Izhod piši: (števila združi: ['||']).
