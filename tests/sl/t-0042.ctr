>> items := Slovar nov.
items postavi: ['black'] na: ['coffee'], postavi: ['earl grey'] na: ['tea'].
Izhod piši: (items na: ['coffee']), piši: (items na: ['tea']).
Izhod piši: ['there are'] + items število-elementov + [' items in the array.'].
items postavi: ['capuccino'] na: ['coffee'].
Izhod piši: ['Now my coffee is.. '] + (items na: ['coffee']).
items postavi: ['aaa'] na: ['1'].
items postavi: ['bbb'] na: ['2'].
Izhod piši: (items na: ['a']).
