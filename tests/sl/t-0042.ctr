>> items := Slovar nov.
items postavi: ['črna'] na: ['coffee'], postavi: ['earl grey'] na: ['čaj'].
Izhod piši: (items na: ['coffee']), piši: (items na: ['čaj']).
Izhod piši: ['tukaj je'] + items število-elementov + [' elementov v seznamu.'].
items postavi: ['kapučino'] na: ['coffee'].
Izhod piši: ['Zdaj je moja kava.. '] + (items na: ['coffee']).
items postavi: ['aaa'] na: ['1'].
items postavi: ['bbb'] na: ['2'].
Izhod piši: (items na: ['a']).
