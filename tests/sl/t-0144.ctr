



>> CoffeeGrounds := Objekt nov.
CoffeeGrounds ob: ['extract'] izvedi: { <- ['coffee']. }.

>> CoffeeMachine := Objekt nov.
CoffeeMachine ob: ['init'] izvedi: {
	svoj coffeegrounds := CoffeeGrounds nov.
}.
CoffeeMachine ob: ['nov'] izvedi: { <- CoffeeMachine `new init.
}.

CoffeeMachine ob: ['makeTea'] izvedi: { <- (svoj tealeaves extract). }.
CoffeeMachine ob: ['makeCoffee'] izvedi: { <- (svoj coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine nov.

Izhod piši:
	coffeeDream 
	makeCoffee.

Izhod piši:
	coffeeDream 
	makeTea.
