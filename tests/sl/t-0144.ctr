



>> KavnaUsedlina := Objekt nov.
KavnaUsedlina ob: ['izvleci'] izvedi: { <- ['coffee']. }.

>> KavniAvtomat := Objekt nov.
KavniAvtomat ob: ['init'] izvedi: {
	svoj kavnausedlina := KavnaUsedlina nov.
}.
KavniAvtomat ob: ['nov'] izvedi: { <- KavniAvtomat `new init.
}.

KavniAvtomat ob: ['skuhajČaj'] izvedi: { <- (svoj čajnilisti izvleci). }.
KavniAvtomat ob: ['skuhajKavo'] izvedi: { <- (svoj kavnausedlina izvleci). }.

>> kavneSanje := KavniAvtomat nov.

Izhod piši:
	kavneSanje 
	skuhajKavo.

Izhod piši:
	kavneSanje 
	skuhajČaj.
