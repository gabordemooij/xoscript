

>> g  := Server nov.
>> v  := Sef nov.
>> ok := 0.

>> skrivnosti := Seznam nov ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> gesla := skrivnosti kopiraj.
gesla vsak: { :i :p
	skrivnosti vsak: { :n :s
		{
			>> šifrirano := v šifriraj: s ključ: p.
			>> dešifrirano := v dešifriraj: šifrirano ključ: p.
			(dešifrirano = s) resnično: {
				ok prištej: 1.
			}, sicer: {
				Izhod piši: ['šifriranje/dešifriranje ni uspelo: '], nova-vrstica.
				Izhod piši: s, nova-vrstica.
				Izhod piši: ['šifrirano: '] + šifrirano, nova-vrstica.
				Izhod piši: ['dešifrirano: '] + šifrirano, nova-vrstica.
				Program konec.
			}.
		} ujemi: { :nap
			(s = [''] ali: p = ['']) resnično: {
				ok prištej: 1.
			}, sicer: {
				Izhod piši: nap, nova-vrstica.
				Program konec.
			}.
		}, zaženi.
	}.
}.

Izhod piši: ( ok + [' šifriranj sefa preizkušenih.'] ), nova-vrstica.