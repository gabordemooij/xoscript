Izhod piši: ['Testni objekt'], nova-vrstica.
>> a := Objekt nov. 

a ob: ['state:'] izvedi: { :list
	svoj list := list. 
}.

a ob: ['stanje'] izvedi: {
	Izhod piši: svoj list, nova-vrstica.
}.

a state: ( Seznam nov ; ['elementseznama'] ; ['predmet2'] ).
a stanje.

a save-as: ['/tmp/a.bin'].
Izhod piši: ['========== PONOVNO NALAGANJE POSNETKA:'], nova-vrstica.
>> b := Objekt load-from: ['/tmp/a.bin'].
b stanje.