>> Pozdravljalec := Objekt nov.
Pozdravljalec ob: ['naredi'] izvedi: {
	>> pozdravljalec := Objekt nov.
	pozdravljalec ob: ['name:'] izvedi: { :ime
		Izhod piši: ['nastavljam ime'].
		svoj mojeIme := ime.
	}.
	pozdravljalec ob: ['izvediPozdrav'] izvedi: {
		Izhod piši: ['Hello'].
		Izhod piši: svoj mojeIme.
	}.
	pozdravljalec ob: ['pozdravi'] izvedi: {
		sebe izvediPozdrav.
	}. <- pozdravljalec.
}.
>> pozdravljalec := Pozdravljalec naredi.
pozdravljalec name: ['sonček!'].
pozdravljalec pozdravi.
