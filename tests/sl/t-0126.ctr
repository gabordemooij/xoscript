#Linux
>> Srk := Objekt nov.

Srk ob: ['nov'] izvedi: {
	svoj str := [''].
}.

Srk ob: ['nieuw'] izvedi: {
	svoj str := [''].
}.

Srk ob: ['odgovori:'] izvedi: { :blah
		svoj str dodaj-na-konec: blah.
}.

Srk ob: ['odgovori:in:'] izvedi: { :blah :blahah
		svoj str dodaj-na-konec: (blah od: 0 dolžina: (blah dolžina - 1)).
		svoj str dodaj-na-konec: [' '].
		svoj str dodaj-na-konec: blahah.
}.

Srk ob: ['dobiVse'] izvedi: {
	>> medpomnilnik := svoj str.
	svoj str := ['']. <- medpomnilnik.
}.


Izhod piši: (Program sistem: (Srk nov echo: ['Zdravo, na konzolo lahko pišem s tekočim API-jem!'], dobiVse)).


{ Datoteka nov: ['/tmp/from.txt'], izbriši. } ujemi: { ['Prazno']. }, zaženi.
{ Datoteka nov: ['/tmp/to.txt'], izbriši. } ujemi: { ['Prazno']. }, zaženi.


Datoteka nov: ['/tmp/to.txt'], obstaja neresnično: {
	Izhod piši: ['Confirmed. Target file does not exist.\
'].
}.
Datoteka nov: ['/tmp/from.txt'], obstaja neresnično: {
	Izhod piši: ['Confirmed. Source file does not exist.\
'].
}.



Program sistem: (Srk nov touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], dobiVse).



Program sistem: (Srk nov cp: ['/tmp/from.txt /tmp/to.txt'], dobiVse).

Datoteka nov: ['/tmp/to.txt'], obstaja resnično: {
	Izhod piši: ['Confirmed. Target file has been created by shell.\
'].
}.


Izhod piši: ['Vsebina datoteke je:'] + (Datoteka nov: ['/tmp/to.txt'], beri), nova-vrstica.
