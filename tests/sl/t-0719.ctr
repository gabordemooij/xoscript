Server init.
>> fmt := Format nov: ['%#3x'].

>> blob := Blob nov: 4.
blob bytes: ( 
	Seznam nov ; 0 ; 1 ; 2 ; 3
).

>> file := Datoteka nov: ['/tmp/blob'].
file blob: blob.
blob sprosti.

>> beri := file blob.
beri 
od: 0 
dolžina: 4, 
stori vsak: { :i :b 
	Izhod
	piši: (fmt uporabi-celo: b),
	nova-vrstica.
}.
beri sprosti.
