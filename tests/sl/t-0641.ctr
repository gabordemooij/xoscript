# Test utf8 sanitizer
Server init.

>> utf8cases := Slovar nov
	# ASCII only
	postavi: ( Seznam nov ; 65 ; 65 ; 65 ; 65 ; 0 ) na: ['AAAA'],
	# valid 2 byte sequence
	postavi: ( Seznam nov ; 194 ; 162 ; 0 ) na: ['¢'],
	# Valid 3-byte UTF-8
    postavi: ( Seznam nov ; 226 ; 130 ; 172 ; 0 ) na: ['€'],
	# Valid 4-byte UTF-8
    postavi: ( Seznam nov ; 240 ; 144 ; 141 ; 136 ; 0 ) na: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    postavi: ( Seznam nov ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) na: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    postavi: ( Seznam nov ; 65 ; 193 ; 129 ; 0 ) na: ['A?'],
	# Invalid first byte (0xFF)
    postavi: ( Seznam nov ; 255 ; 0 ) na: ['?'],
	# Incomplete multi-byte sequence at end
    postavi: ( Seznam nov ; 66 ; 226 ; 0 ) na: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    postavi: ( Seznam nov ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) na: ['A€?𐍈B'].
	 
utf8cases vsak: { :key :value
	>> blob := Blob nov: value število-elementov, bytes: value.
	>> str := blob besedilo.
	(str = key) resnično: {
		Izhod piši: ['OK'], nova-vrstica.
	}, sicer: {
		Izhod piši: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, nova-vrstica.
	}.
	blob sprosti.
}.
