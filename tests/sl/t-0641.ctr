# Test čistilnika utf8
Server init.

>> utf8primeri := Slovar nov
	# Samo ASCII
	postavi: ( Seznam nov ; 65 ; 65 ; 65 ; 65 ; 0 ) na: ['AAAA'],
	# veljavno 2-bajtno zaporedje
	postavi: ( Seznam nov ; 194 ; 162 ; 0 ) na: ['¢'],
	# Veljaven 3-bajtni UTF-8
    postavi: ( Seznam nov ; 226 ; 130 ; 172 ; 0 ) na: ['€'],
	# Veljaven 4-bajtni UTF-8
    postavi: ( Seznam nov ; 240 ; 144 ; 141 ; 136 ; 0 ) na: ['𐍈'],
	# Neveljaven nadaljevalni bajt v zaporedju E2 28 AC -> začetek 3b zap. + 28 napačen nad. + AC nad. bajt, a spada k isti napaki
    postavi: ( Seznam nov ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) na: ['A?A'],
	# Predolgo kodiranje ASCII 'A' (bi moralo postati ?),
    postavi: ( Seznam nov ; 65 ; 193 ; 129 ; 0 ) na: ['A?'],
	# Neveljaven prvi bajt (0xFF)
    postavi: ( Seznam nov ; 255 ; 0 ) na: ['?'],
	# Nepopolno večbajtno zaporedje na koncu
    postavi: ( Seznam nov ; 66 ; 226 ; 0 ) na: ['B?'],
    # Prazno besedilo
    #put: ( List new ) at: [''],
	# Več mešanih zaporedij
    postavi: ( Seznam nov ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) na: ['A€?𐍈B'].
	 
utf8primeri vsak: { :key :value
	>> blob := Blob nov: value število-elementov, bytes: value.
	>> str := blob besedilo.
	(str = key) resnično: {
		Izhod piši: ['OK'], nova-vrstica.
	}, sicer: {
		Izhod piši: ['Čistilnik UTF8 ni uspel pri: '] + key + [' dobil: '] + str, nova-vrstica.
	}.
	blob sprosti.
}.
