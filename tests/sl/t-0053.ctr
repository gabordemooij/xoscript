60 × {
	>> x := (Število random % 6) + 1.
	(x ≤ 6) neresnično: { Izhod piši: ['FAIL']. }.
	(x ≥0) neresnično: { Izhod piši: ['FAIL']. }.
	x := (Število random % 3) + 1.
	(x < 3) neresnično: { Izhod piši: ['FAIL']. }.
	(x>-1) neresnično: { Izhod piši: ['FAIL']. }.
	x := ((Logični flip) število).
	(x = 0 ali: x = 1) neresnično: { Izhod piši: ['FAIL']. }.
	x := ((Resnično flip) število).
	(x = 0 ali: x = 1) neresnično: { Izhod piši: ['FAIL']. }.
	x := (Logični flip ali: ['HEAD'] ali: ['TAIL']).
	((x = ['HEAD']) ali: (x = ['TAIL'])) neresnično: { Izhod piši: ['FAIL']. }.
}.
Izhod piši: ['DONE'].

