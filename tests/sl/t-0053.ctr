60 × {
	>> x := (Število naključen % 6) + 1.
	(x ≤ 6) neresnično: { Izhod piši: ['NAPAKA']. }.
	(x ≥0) neresnično: { Izhod piši: ['NAPAKA']. }.
	x := (Število naključen % 3) + 1.
	(x < 3) neresnično: { Izhod piši: ['NAPAKA']. }.
	(x>-1) neresnično: { Izhod piši: ['NAPAKA']. }.
	x := ((Logični obrni) število).
	(x = 0 ali: x = 1) neresnično: { Izhod piši: ['NAPAKA']. }.
	x := ((Resnično obrni) število).
	(x = 0 ali: x = 1) neresnično: { Izhod piši: ['NAPAKA']. }.
	x := (Logični obrni ali: ['GLAVA'] ali: ['CIFRA']).
	((x = ['GLAVA']) ali: (x = ['CIFRA'])) neresnično: { Izhod piši: ['NAPAKA']. }.
}.
Izhod piši: ['KONČANO'].

