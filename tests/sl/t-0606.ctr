>> Točka := Objekt nov.
Točka ob: ['x-coordinate:'] izvedi: { :x svoj x := x. }.
Točka ob: ['y-coordinate:'] izvedi: { :y svoj y := y. }.
Točka ob: ['x-koordinata']  izvedi: { <- svoj x kopiraj. }.
Točka ob: ['y-koordinata']  izvedi: { <- svoj y kopiraj. }.

Točka ob: ['='] izvedi: { :drugi
	<- ( svoj x = drugi x-koordinata
		 in: svoj y = drugi y-koordinata ).
}.

>> pomol := Točka nov x-coordinate: 5, y-coordinate: 6.
>> mestna-hiša := Točka nov x-coordinate: 7, y-coordinate: 1.
>> restavracija := Točka nov x-coordinate: 5, y-coordinate: 6.

Izhod piši: pomol = mestna-hiša, nova-vrstica.
Izhod piši: pomol = restavracija, nova-vrstica.
