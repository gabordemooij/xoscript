>> Point := Objekt nov.
Point ob: ['x-coordinate:'] izvedi: { :x svoj x := x. }.
Point ob: ['y-coordinate:'] izvedi: { :y svoj y := y. }.
Point ob: ['x-coordinate']  izvedi: { <- svoj x kopiraj. }.
Point ob: ['y-coordinate']  izvedi: { <- svoj y kopiraj. }.

Point ob: ['='] izvedi: { :other <- ( svoj x = other x-coordinate
		 in: svoj y = other y-coordinate ).
}.

>> pier := Point nov x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point nov x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point nov x-coordinate: 5, y-coordinate: 6.

Izhod piši: pier = town-hall, nova-vrstica.
Izhod piši: pier = restaurant, nova-vrstica.
