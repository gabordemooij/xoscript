Besedilo ob: ['html'] izvedi: { <- (
		sebe
		zamenjaj: ['&'] z: ['&amp;'],
		zamenjaj: ['<'] z: ['&lt;'],
		zamenjaj: ['>'] z: ['&gt;'],
		zamenjaj: ['"'] z: ['&quot;']
	).
}.

>> list := Seznam nov.

['Verbatim Syntax'] znaki vsak: { :število :letter
	list ; ((['<li>#Number:Letter</li>']) Number: (število), Letter: letter).
}.

Izhod list.





>> template := ['
<html>
<body>
<p>Hello this is a test!</p>
<p>The string \‘Verbatim Syntax\’ has: 15 code points...</p>
