# skupina, ki ni del ujemanja, ne sme povzročiti sesutja in mora ohraniti številke skupin
Server init.
>> prikaži := { :regIzraz :subject
	>> p := Vzorec nov: regIzraz.
	p ujemanje: subject izvedi: { :m :g
		Izhod piši: g število-elementov, piši: [' '], piši: (g združi: ['|']), nova-vrstica.
		<- m.
	}.
}.
prikaži uporabi: ['(a)|(b)'] in: ['b'].
prikaži uporabi: ['(a)|(b)'] in: ['a'].
prikaži uporabi: ['(x)?y'] in: ['y'].
prikaži uporabi: ['(x)?(y)(z)?'] in: ['xy'].
