# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Vzorec nov: pattern.
	p ujemanje: subject izvedi: { :m :g
		Izhod piši: g število-elementov, piši: [' '], piši: (g združi: ['|']), nova-vrstica. <- m.
	}.
}.
show uporabi: ['(a)|(b)'] in: ['b'].
show uporabi: ['(a)|(b)'] in: ['a'].
show uporabi: ['(x)?y'] in: ['y'].
show uporabi: ['(x)?(y)(z)?'] in: ['xy'].
