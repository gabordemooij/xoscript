
Server init.
Izhod piši: ['Database test'], nova-vrstica.

>> db := Maria-DB nov gostitelj: ['localhost'],
	uporabnik: ['xo'], 
	geslo: ['pass123'],
	ime-baze: ['xobase'],
	poveži-se.

>> iskalni-parametri :=
db poizvedba: ['SELECT UNHEX('CAFE') AS blobby'],
pridobi: { :row
	Izhod piši: ( row blobby od: 0 dolžina: 2 ), nova-vrstica.
	row blobby sprosti.
}.
