
>> države := Seznam nov
	~ ['Švica']
	~ ['Italija']
	~ ['Nemčija'].

>> jedi := Seznam nov
	~ ['Rösti']
	~ ['Špageti']
	~ ['Kislo zelje'].


>> števec := 0.
jedi po: države, vsak: { :key :value
	števec prištej: 1.
}.

Izhod piši: (['we serve counter dishes'] counter: števec), nova-vrstica.

>> števec := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] znaki razvrsti: { :v
	števec prištej: 0.
}.

Izhod piši: (['we sort counter dishes'] counter: števec), nova-vrstica.


>> števec := 0.
{
	{
		števec prištej: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Izhod piši: (['we calculate counter numbers.'] counter: števec), nova-vrstica.

