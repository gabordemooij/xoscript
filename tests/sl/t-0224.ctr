
>> countries := Seznam nov
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Seznam nov
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods po: countries, vsak: { :key :value
	counter prištej: 1.
}.

Izhod piši: (['we serve counter dishes'] counter: counter), nova-vrstica.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] znaki razvrsti: { :v
	counter prištej: 0.
}.

Izhod piši: (['we sort counter dishes'] counter: counter), nova-vrstica.


>> counter := 0.
{
	{
		counter prištej: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Izhod piši: (['we calculate counter numbers.'] counter: counter), nova-vrstica.

