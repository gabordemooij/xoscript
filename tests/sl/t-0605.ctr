>> invoice := Objekt nov.
invoice ob: ['zaženi'] izvedi: {
        svoj število := 0.
}.

invoice ob: ['število'] izvedi: {
        svoj število prištej: 1. <- svoj število kopiraj.
}.

>> year-invoice := invoice nov.
year-invoice ob: ['start:'] izvedi: { :leto
	svoj število := leto.
}.

year-invoice start: 202000.
Izhod piši: year-invoice število, nova-vrstica.
Izhod piši: year-invoice število, nova-vrstica.
