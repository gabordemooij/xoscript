>> račun := Objekt nov.
račun ob: ['zaženi'] izvedi: {
        svoj število := 0.
}.

račun ob: ['število'] izvedi: {
        svoj število prištej: 1.
        <- svoj število kopiraj.
}.

>> letni-račun := račun nov.
letni-račun ob: ['start:'] izvedi: { :leto
	svoj število := leto.
}.

letni-račun start: 202000.
Izhod piši: letni-račun število, nova-vrstica.
Izhod piši: letni-račun število, nova-vrstica.
