#Linux
>> budilka := Trenutek nov.
budilka cona: ['UTC-1'].
budilka leto: 1981, mesec: 1, dan: 5,
      ura: 13, minuta: 15, sekunda: 13.

Izhod piši: budilka, nova-vrstica.
budilka cona: ['UTC+0'].

Izhod piši: (
	(budilka leto navaden) + ['-'] + (budilka mesec) + ['-'] + (budilka dan) + [' '] +
	(budilka ura) + [':'] + (budilka minuta) + [':'] + (budilka sekunda) + [' '] +
	['W'] + (budilka teden) + (budilka cona)
), nova-vrstica.


budilka cona: ['UTC-1'].
Izhod piši: (
	(budilka leto navaden) + ['-'] + (budilka mesec) + ['-'] + (budilka dan) + [' '] +
	(budilka ura) + [':'] + (budilka minuta) + [':'] + (budilka sekunda) + [' '] +
	['W'] + (budilka teden) + (budilka cona)
), nova-vrstica.
