#Linux
>> clock := Trenutek nov.
clock cona: ['UTC-1'].
clock leto: 1981, mesec: 1, dan: 5,
      ura: 13, minuta: 15, sekunda: 13.

Izhod piši: clock, nova-vrstica.
clock cona: ['UTC+0'].

Izhod piši: (
	(clock leto navaden) + ['-'] + (clock mesec) + ['-'] + (clock dan) + [' '] +
	(clock ura) + [':'] + (clock minuta) + [':'] + (clock sekunda) + [' '] +
	['W'] + (clock teden) + (clock cona)
), nova-vrstica.


clock cona: ['UTC-1'].
Izhod piši: (
	(clock leto navaden) + ['-'] + (clock mesec) + ['-'] + (clock dan) + [' '] +
	(clock ura) + [':'] + (clock minuta) + [':'] + (clock sekunda) + [' '] +
	['W'] + (clock teden) + (clock cona)
), nova-vrstica.
