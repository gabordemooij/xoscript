>> repeater := Objekt nov.
repeater ob: ['odgovori:'] izvedi: { :what
	Izhod piši: what + [' '].
}.
repeater ob: ['odgovori:in:'] izvedi: { :what :say
	Izhod piši: what, piši: say + [' '].
}.
repeater ob: ['odgovori:in:in:'] izvedi: { :what :say :more
	Izhod piši: what, piši: say, piši: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
