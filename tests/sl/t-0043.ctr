>> ponavljalnik := Objekt nov.
ponavljalnik ob: ['odgovori:'] izvedi: { :kaj
	Izhod piši: kaj + [' '].
}.
ponavljalnik ob: ['odgovori:in:'] izvedi: { :kaj :say
	Izhod piši: kaj, piši: say + [' '].
}.
ponavljalnik ob: ['odgovori:in:in:'] izvedi: { :kaj :say :več
	Izhod piši: kaj, piši: say, piši: več.
}.
ponavljalnik ponovi.
ponavljalnik everything: ['Jaz pravim.'].
ponavljalnik and: ['I '] everything: ['delam.'].
