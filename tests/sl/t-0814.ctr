# oblika piškotka seje, tip vsebine json, samo spletni protokoli, svg prikazan v vrstici
Server inicializiraj.
Program uporabljaj: ['../../../src/xo/sl/webtools.xo'].

>> Lažna-Zahteva := Objekt nov.
Lažna-Zahteva ob: ['value:'] izvedi: { :vrednost
	svoj vrednost := vrednost.
}.
Lažna-Zahteva ob: ['cookie:'] izvedi: { :ime
	<- svoj vrednost.
}.

>> Testna-Seja := Seja-začasna-datoteka nov.
Testna-Seja ob: ['naloži'] izvedi: {
	<- Slovar nov.
}.
Testna-Seja ob: ['ident-seje'] izvedi: {
	<- svoj id.
}.

>> piškotki := Seznam nov
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

piškotki vsak: { :i :piškotek
	>> zahteva := Lažna-Zahteva nov.
	zahteva value: piškotek.
	>> upravitelj := Testna-Seja nov.
	>> splet := Spletni-dokument nov.
	splet zahteva: zahteva.
	splet upravitelj-sej: upravitelj.
	splet začni-sejo.
	Izhod piši: ( upravitelj ident-seje = piškotek ), nova-vrstica.
}.

>> splet := Spletni-dokument nov.
splet json: (Slovar nov postavi: ['b'] na: ['a']).
Izhod piši: ['\n'], nova-vrstica.

{ Omrežje get: ['file:///etc/hostname']. } ujemi: { :e
	Izhod piši: e, nova-vrstica.
}, zaženi.

>> svg := Datoteka nov: ['/tmp/test0814.svg'].
svg piši: ['<svg xmlns="x"></svg>'].
Izhod nova-vrstica.
Server posreduj: ['test0814.svg'] predpona: ['/tmp/'].
svg izbriši.
