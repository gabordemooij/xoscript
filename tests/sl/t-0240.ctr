# test določil

>> $ := Objekt nov.

$ ob: ['odgovori:'] izvedi: { :x
	
	>> operacija := x znak: 0.
	>> valuta := x znak: 1.
	>> denar := x odmik: 2.
	
	>> znesek := 0.

	( operacija = ['+'] ) resnično: {
		( valuta = ['£'] ) resnično: { znesek := 1.28 × denar. }.
	}. <- znesek.
}.



>> x := $ +£20.

Izhod piši: x, nova-vrstica.


>> Sadje := Objekt nov.

Sadje ob: ['nov'] izvedi: {
	>> f := sebe nov.
	f apples: 0.
	f oranges: 0. <- f.
}.

Sadje ob: ['apples:'] izvedi: { :a svoj jabolka := a. }.
Sadje ob: ['oranges:'] izvedi: { :p svoj pomaranče := p. }.
Sadje ob: ['jabolka'] izvedi: { <- svoj jabolka. }.
Sadje ob: ['pomaranče'] izvedi: { <- svoj pomaranče. }.

Sadje ob: ['+'] izvedi: { :f
	
	>> n := Sadje nov.
	f prištej: 1.
	
	n apples: (f jabolka + svoj jabolka).
	n oranges:  (f pomaranče  + svoj pomaranče). <- n.
}.

Sadje ob: ['besedilo'] izvedi: { <- ( svoj jabolka besedilo + [' jabolk in '] + svoj pomaranče + [' pomaranč'] ).
}.

Število ob: ['jabolka'] izvedi: { <- ((Sadje nov) apples: sebe).
}.

Število ob: ['apple'] izvedi: { <- ((Sadje nov) apples: sebe).
}.

Število ob: ['pomaranče'] izvedi: { <- ((Sadje nov) oranges: sebe).
}.




Izhod piši: (1 apple + 3 pomaranče + 4 jabolka), nova-vrstica.


Besedilo ob: ['dvakrat'] izvedi: { <- ((sebe besedilo) + (sebe besedilo)).
}.



Izhod piši: ['❤❤❤'] dvakrat.



