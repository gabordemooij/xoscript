# test qualifiers

>> $ := Objekt nov.

$ ob: ['odgovori:'] izvedi: { :x
	
	>> operation := x znak: 0.
	>> valuta := x znak: 1.
	>> money := x odmik: 2.
	
	>> amount := 0.

	( operation = ['+'] ) resnično: {
		( valuta = ['£'] ) resnično: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Izhod piši: x, nova-vrstica.


>> Fruit := Objekt nov.

Fruit ob: ['nov'] izvedi: {
	>> f := sebe nov.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit ob: ['apples:'] izvedi: { :a svoj apples := a. }.
Fruit ob: ['oranges:'] izvedi: { :p svoj oranges := p. }.
Fruit ob: ['apples'] izvedi: { <- svoj apples. }.
Fruit ob: ['oranges'] izvedi: { <- svoj oranges. }.

Fruit ob: ['+'] izvedi: { :f
	
	>> n := Fruit nov.
	f prištej: 1.
	
	n apples: (f apples + svoj apples).
	n oranges:  (f oranges  + svoj oranges). <- n.
}.

Fruit ob: ['besedilo'] izvedi: { <- ( svoj apples besedilo + [' apples and '] + svoj oranges + [' oranges'] ).
}.

Število ob: ['apples'] izvedi: { <- ((Fruit nov) apples: sebe).
}.

Število ob: ['apple'] izvedi: { <- ((Fruit nov) apples: sebe).
}.

Število ob: ['oranges'] izvedi: { <- ((Fruit nov) oranges: sebe).
}.




Izhod piši: (1 apple + 3 oranges + 4 apples), nova-vrstica.


Besedilo ob: ['twice'] izvedi: { <- ((sebe besedilo) + (sebe besedilo)).
}.



Izhod piši: ['❤❤❤'] twice.



