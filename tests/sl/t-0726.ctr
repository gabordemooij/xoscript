# test medpomnilnikov PKI/Sign 
Server init.

>> dolg := ( Seznam nov napolni: 1000 z: ['a'] ) združi: [''].

# podpiši sporočilo
Izhod piši: ( 
	Sef podpiši: ['abc'] s: dolg
), nova-vrstica.

Izhod piši: ( 
	Sef
		preveri: ['abc'] 
		podpis: dolg 
		s: dolg
), nova-vrstica.

Izhod piši: (
	Sef zgoščeno-geslo: dolg preveri: dolg
), nova-vrstica.
