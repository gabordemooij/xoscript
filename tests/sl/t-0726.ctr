# test buffers PKI/Sign 
Server init.

>> long := ( Seznam nov napolni: 1000 z: ['a'] ) združi: [''].

# sign a message
Izhod piši: ( 
	Sef podpiši: ['abc'] s: long
), nova-vrstica.

Izhod piši: ( 
	Sef
		preveri: ['abc'] 
		podpis: long 
		s: long
), nova-vrstica.

Izhod piši: (
	Sef zgoščeno-geslo: long preveri: long
), nova-vrstica.
