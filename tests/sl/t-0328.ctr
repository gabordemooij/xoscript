Program upravljanje-pomnilnika: 4.

>> Podvajalec := Objekt nov.
>> Množilnik := Objekt nov.
Podvajalec ob: ['podvoji:in:'] izvedi: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Množilnik ob: ['pomnoži:in:'] izvedi: { :x :y <- (x × y).
}.

Izhod piši: (
	Podvajalec podvoji:
		(Podvajalec podvoji: 
			(Množilnik pomnoži: 2 in: 3)
		in:
			(Množilnik pomnoži: 3 in: 4)
		)
	in:
		(Podvajalec podvoji: 
			(Množilnik pomnoži: 2 in: 3)
		in:
			(Množilnik pomnoži: 3 in: 4)
		)
), nova-vrstica.
