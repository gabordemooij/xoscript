Program upravljanje-pomnilnika: 4.

>> Doubler := Objekt nov.
>> Multiplier := Objekt nov.
Doubler ob: ['double:and:'] izvedi: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier ob: ['multiply:and:'] izvedi: { :x :y <- (x × y).
}.

Izhod piši: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), nova-vrstica.
