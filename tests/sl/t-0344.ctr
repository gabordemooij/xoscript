# test lovljenja vseh sporočil (praktično)
>> HTML := Besedilo nov.
HTML ob: ['encode:'] izvedi: { :tekst
	sebe dodaj-na-konec: (tekst
	zamenjaj: ['&'] z: ['&amp;'], 
	zamenjaj: ['<'] z: ['&lt;'],
	zamenjaj: ['>'] z: ['&gt;'],
	zamenjaj: ['"'] z: ['&quot;']).
}.
>> blog := HTML nov.
blog dodaj-na-konec: ['<h1>'],
     encode: ['Koffie & Thee'],
     dodaj-na-konec: ['</h1>'].
Izhod piši: blog, nova-vrstica.


>> Rimsko := Število nov.
Rimsko ob: ['nizasto'] izvedi: {
	>> a := [''].
	{ a dodaj-na-konec: ['I']. } × sebe. <- a.
}.

>> x := Rimsko nov.
x prištej: 3.
Izhod piši: x nizasto, nova-vrstica.

>> Kvant := Logični nov.
Kvant ob: ['true?'] izvedi: { <- ['morda Resnično']. }.
Izhod piši: (Kvant nov true?), nova-vrstica.

>> Nihil := Nič nov.
Nihil ob: ['besedilo'] izvedi: { <- ['Nihil']. }.
Izhod piši: (Nihil nov), nova-vrstica.
