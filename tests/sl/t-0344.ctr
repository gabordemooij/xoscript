# catch-all test (practical)
>> HTML := Besedilo nov.
HTML ob: ['encode:'] izvedi: { :tekst
	sebe dodaj-na-konec: (tekst
	zamenjaj: ['&'] z: ['&amp;'], 
	zamenjaj: ['<'] z: ['&lt;'],
	zamenjaj: ['>'] z: ['&gt;'],
	zamenjaj: ['"'] z: ['&quot;']).
}.
>> blog := HTML nov.
blog dodaj-na-konec: ['<h1>'],
     encode: ['Koffie & Thee'],
     dodaj-na-konec: ['</h1>'].
Izhod piši: blog, nova-vrstica.


>> Roman := Število nov.
Roman ob: ['stringy'] izvedi: {
	>> a := [''].
	{ a dodaj-na-konec: ['I']. } × sebe. <- a.
}.

>> x := Roman nov.
x prištej: 3.
Izhod piši: x stringy, nova-vrstica.

>> Quantum := Logični nov.
Quantum ob: ['true?'] izvedi: { <- ['maybe True']. }.
Izhod piši: (Quantum nov true?), nova-vrstica.

>> Nihil := Nič nov.
Nihil ob: ['besedilo'] izvedi: { <- ['Nihil']. }.
Izhod piši: (Nihil nov), nova-vrstica.
