>> To-Do := Objekt nov.

To-Do ob: ['nov'] izvedi: {
	svoj list := Seznam nov.
}.

To-Do ob: ['nieuw'] izvedi: {
	svoj list := Seznam nov.
}.

To-Do ob: ['+'] izvedi: { :task
	svoj list dodaj-na-konec: task.
}.

To-Do ob: ['number of tasks?'] izvedi: { <-  svoj list število-elementov.
}.

>> todos := 
	To-Do nov 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Izhod piši: ['You have $ tasks to do'] $ todos number of tasks?.
