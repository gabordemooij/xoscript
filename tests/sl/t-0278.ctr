>> Opravila := Objekt nov.

Opravila ob: ['nov'] izvedi: {
	svoj list := Seznam nov.
}.

Opravila ob: ['nieuw'] izvedi: {
	svoj list := Seznam nov.
}.

Opravila ob: ['+'] izvedi: { :opravilo
	svoj list dodaj-na-konec: opravilo.
}.

Opravila ob: ['number of tasks?'] izvedi: { <-  svoj list število-elementov.
}.

>> seznamOpravil := 
	Opravila nov 
	+ ['skuhaj večerjo'] 
	+ ['pospravi sobo'].
	
Izhod piši: ['You have $ tasks to do'] $ seznamOpravil number of tasks?.
