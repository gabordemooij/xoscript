{
	ta-naloga napaka: ['Dont fail.'].
	unknown doSomething.
} ujemi: {
	Izhod piši: ['Caught!'].
}, zaženi.

{
	ta-naloga napaka: ['Dont fail.'].
	svoj unknown doSomething.
} ujemi: {
	Izhod piši: ['Caught!'].
}, zaženi.

{
	ta-naloga napaka: ['Dont fail.'].
	unknown := 122.
} ujemi: {
	Izhod piši: ['Caught!'].
}, zaženi.


{
	ta-naloga napaka: ['Dont fail.'].
	Resnično prekini.
	Izhod piši: ['FAIL'].
} ujemi: {
	Izhod piši: ['Caught!'].
}, zaženi.

{
	{
		ta-naloga napaka: ['Dont fail.'].
		Resnično prekini.
		Izhod piši: ['FAIL'].
	} ujemi: { :x
		(x = ['Dont fail.']) resnično: { ta-naloga napaka: ['Nested Caught!']. }.
	}, zaženi.
} ujemi: { :e
	Izhod piši: e.
}, zaženi.
