{
	ta-naloga napaka: ['Ne odpovej.'].
	neznanec narediNekaj.
} ujemi: {
	Izhod piši: ['Ujeto!'].
}, zaženi.

{
	ta-naloga napaka: ['Ne odpovej.'].
	svoj neznanec narediNekaj.
} ujemi: {
	Izhod piši: ['Ujeto!'].
}, zaženi.

{
	ta-naloga napaka: ['Ne odpovej.'].
	neznanec := 122.
} ujemi: {
	Izhod piši: ['Ujeto!'].
}, zaženi.


{
	ta-naloga napaka: ['Ne odpovej.'].
	Resnično prekini.
	Izhod piši: ['NAPAKA'].
} ujemi: {
	Izhod piši: ['Ujeto!'].
}, zaženi.

{
	{
		ta-naloga napaka: ['Ne odpovej.'].
		Resnično prekini.
		Izhod piši: ['NAPAKA'].
	} ujemi: { :x
		(x = ['Ne odpovej.']) resnično: { ta-naloga napaka: ['Gnezdeno Ujeto!']. }.
	}, zaženi.
} ujemi: { :e
	Izhod piši: e.
}, zaženi.
