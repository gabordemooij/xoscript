>> fraze := Seznam nov
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> obvestilo := ['Phrase: ~decoded base64: ~encoded'].
	
fraze vsak: { :_ :fraza 
	>> e := Server base64-kodiraj: fraza.
	>> d := Server base64-dekodiraj: e.
	Izhod piši: (
		obvestilo kopiraj ~encoded: e, ~decoded: d
	), nova-vrstica.
}.
