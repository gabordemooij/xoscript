
>> Žival := Objekt nov.
Žival ob: ['nov'] izvedi: {
	<- sebe nov init.
}.

Žival ob: ['init'] izvedi: {
	svoj zvok := ['?'].
	svoj noge  := 4.
}.

>> Pes := Žival nov.
Pes ob: ['init'] izvedi: {
	sebe init.
	svoj zvok := ['laja'].
}.

Žival ob: ['besedilo'] izvedi: {
	<- svoj noge besedilo + svoj zvok.
}.

>> pudelj := Pes nov.
Izhod piši: pudelj, nova-vrstica.

