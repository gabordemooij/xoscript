Izhod piši: ['Test object'], nova-vrstica.
>> a := Objekt nov. 

a ob: ['item:'] izvedi: { :binhelper
	svoj binhelper := binhelper. 
}.

a ob: ['item'] izvedi: { <- svoj binhelper.
}.

a item: Bin nov.

>> old-binhelper-address := a item prototip pomnilniški-naslov.
a save-as: ['/tmp/a.bin'].
Izhod piši: ['========== RELOADING SNAP:'], nova-vrstica.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototip pomnilniški-naslov = old-binhelper-address) resnično: {
	Izhod piši: ['Object link re-attached.'], nova-vrstica.
}.


