Izhod piši: ['Testni objekt'], nova-vrstica.
>> a := Objekt nov. 

a ob: ['item:'] izvedi: { :binpomočnik
	svoj binpomočnik := binpomočnik. 
}.

a ob: ['predmet'] izvedi: {
	<- svoj binpomočnik.
}.

a item: Bin nov.

>> stari-binpomočnik-naslov := a predmet prototip pomnilniški-naslov.
a save-as: ['/tmp/a.bin'].
Izhod piši: ['========== PONOVNO NALAGANJE POSNETKA:'], nova-vrstica.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b predmet prototip pomnilniški-naslov = stari-binpomočnik-naslov) resnično: {
	Izhod piši: ['Povezava objekta ponovno priključena.'], nova-vrstica.
}.


