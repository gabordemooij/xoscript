

Seznam ob: ['column:'] izvedi: { :column
	>> result := Seznam nov.
	sebe vsak: { :index :row
		row vsak: { :index :cell
			(index = column) resnično: { result dodaj-na-konec: cell. }.
		}.
	}. <- result.
}.


>> a := Seznam ←
	(Seznam ← 1 ; 2 ; 3) ;
	(Seznam ← 4 ; 5 ; 6) ;
	(Seznam ← 7 ; 8 ; 9).

>> b := a column: 1.
Izhod piši: b, nova-vrstica.

b := a column: 20.
Izhod piši: b, nova-vrstica.

b := a column: -100.
Izhod piši: b, nova-vrstica.
