

Seznam ob: ['column:'] izvedi: { :stolpec
	>> rezultat := Seznam nov.
	sebe vsak: { :indeks :vrsta
		vrsta vsak: { :indeks :celica
			(indeks = stolpec) resnično: { rezultat dodaj-na-konec: celica. }.
		}.
	}. <- rezultat.
}.


>> a := Seznam ←
	(Seznam ← 1 ; 2 ; 3) ;
	(Seznam ← 4 ; 5 ; 6) ;
	(Seznam ← 7 ; 8 ; 9).

>> b := a column: 1.
Izhod piši: b, nova-vrstica.

b := a column: 20.
Izhod piši: b, nova-vrstica.

b := a column: -100.
Izhod piši: b, nova-vrstica.
