# manj parametrov kot ograd mora dati napako, ne branja čez vezave
Server init.

>> pb := Maria-DB nov gostitelj: ['localhost'],
	uporabnik: ['xo'],
	geslo: ['pass123'],
	ime-baze: ['xobase'],
	poveži-se.

>> iskalni-parametri := pb poizvedba: ['SELECT ? AS a, ? AS b, ? AS c'].
iskalni-parametri parametri: (Seznam nov ; ['1']).
{ iskalni-parametri pridobi: { :vrsta Izhod piši: vrsta, nova-vrstica. }. } ujemi: { :e Izhod piši: e, nova-vrstica. }, zaženi.

>> iskalni-parametri := pb poizvedba: ['SELECT ? AS a'].
{ iskalni-parametri pridobi: { :vrsta Izhod piši: vrsta, nova-vrstica. }. } ujemi: { :e Izhod piši: e, nova-vrstica. }, zaženi.

# pravo število še vedno deluje, odvečni parametri se kot prej prezrejo
>> iskalni-parametri := pb poizvedba: ['SELECT ? AS a, ? AS b'].
iskalni-parametri parametri: (Seznam nov ; ['1'] ; ['2']).
iskalni-parametri pridobi: { :vrsta Izhod piši: (vrsta na: ['a']), piši: (vrsta na: ['b']), nova-vrstica. }.
iskalni-parametri parametri: (Seznam nov ; ['1'] ; ['2'] ; ['3']).
iskalni-parametri pridobi: { :vrsta Izhod piši: (vrsta na: ['a']), piši: (vrsta na: ['b']), nova-vrstica. }.
