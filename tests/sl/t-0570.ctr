#Linux

 >> t := Trenutek nov.
 
t cona: ['Europe/Amsterdam'].
t leto: 2020, mesec: 8, dan: 2, ura: 21, minuta: 2, sekunda: 1.

>> a := t ura.
>> ams := t cona.

t cona: ['US/Hawaii'].
>> b := t ura.
>> hw := t cona.

Izhod
piši: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		ali: ['kasneje'] ali: ['prej']
	)
),
nova-vrstica.
 