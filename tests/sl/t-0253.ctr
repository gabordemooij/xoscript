#Linux
>> OS := Program nastavitev: ['OS'].

>> budilka := Trenutek nov.
	
(OS = ['Haiku']) resnično: {
	budilka cona: ['CET'],
	leto: 2017, mesec: 7, dan: 13,
	ura: 18, minuta: 0, sekunda: 0.
}, sicer: {
	budilka cona: ['Europe/Amsterdam'],
	leto: 2017, mesec: 7, dan: 13,
	ura: 18, minuta: 0, sekunda: 0.
}.

budilka ob: ['povej'] izvedi: {
	Izhod piši: sebe, nova-vrstica.
}.


budilka prištej: 2    ura, povej.
budilka prištej: 1    ura, povej.
budilka prištej: 19 minuta, povej.
budilka prištej: 1  minuta, povej.
budilka prištej: 1  minuta, povej.
budilka prištej: 19 sekunda, povej.
budilka prištej: 1  sekunda, povej.
budilka prištej: 1  sekunda, povej.
budilka prištej: 2    leto, povej.
budilka prištej: 1    leto, povej.

(OS = ['Haiku']) resnično: {
budilka prištej: 5   mesec.
budilka cona: ['CEST'], povej.
}, sicer: {
	budilka prištej: 5   mesec, povej.
}.

