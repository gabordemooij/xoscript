#Linux
>> OS := Program nastavitev: ['OS'].

>> clock := Trenutek nov.
	
(OS = ['Haiku']) resnično: {
	clock cona: ['CET'],
	leto: 2017, mesec: 7, dan: 13,
	ura: 18, minuta: 0, sekunda: 0.
}, sicer: {
	clock cona: ['Europe/Amsterdam'],
	leto: 2017, mesec: 7, dan: 13,
	ura: 18, minuta: 0, sekunda: 0.
}.

clock ob: ['tell'] izvedi: {
	Izhod piši: sebe, nova-vrstica.
}.


clock prištej: 2    ura, tell.
clock prištej: 1    ura, tell.
clock prištej: 19 minuta, tell.
clock prištej: 1  minuta, tell.
clock prištej: 1  minuta, tell.
clock prištej: 19 sekunda, tell.
clock prištej: 1  sekunda, tell.
clock prištej: 1  sekunda, tell.
clock prištej: 2    leto, tell.
clock prištej: 1    leto, tell.

(OS = ['Haiku']) resnično: {
clock prištej: 5   mesec.
clock cona: ['CEST'], tell.
}, sicer: {
	clock prištej: 5   mesec, tell.
}.

clock prištej: 1   mesec, tell.
clock prištej: 19    dan, tell.
clock prištej: 1    ura, tell.
clock prištej: 120  yard, tell.
