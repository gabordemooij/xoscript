Izhod piši: ['Testni objekt'], nova-vrstica.
>> a := Objekt nov. 

a ob: ['item:'] izvedi: { :izh
	svoj izh := izh. 
}.

a ob: ['predmet'] izvedi: {
	<- svoj izh.
}.

a ob: ['pozdravi'] izvedi: {
	Izhod piši: ['živjo od izvirnega izhoda!'], nova-vrstica.
}.

a item: Izhod.

Izhod piši: a predmet, nova-vrstica.

>> stari-izh-naslov := a predmet prototip pomnilniški-naslov.
a save-as: ['/tmp/a.bin'].
Izhod piši: ['========== PONOVNO NALAGANJE POSNETKA:'], nova-vrstica.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b predmet prototip pomnilniški-naslov = stari-izh-naslov) resnično: {
	Izhod piši: ['Povezava objekta ponovno priključena.'], nova-vrstica.
}.

b predmet piši: ['zdravo od naloženega izhoda!'], nova-vrstica.
b pozdravi.
