Izhod piši: ['Test object'], nova-vrstica.
>> a := Objekt nov. 

a ob: ['item:'] izvedi: { :out
	svoj out := out. 
}.

a ob: ['item'] izvedi: { <- svoj out.
}.

a ob: ['greet'] izvedi: {
	Izhod piši: ['hi from original out!'], nova-vrstica.
}.

a item: Izhod.

Izhod piši: a item, nova-vrstica.

>> old-out-address := a item prototip pomnilniški-naslov.
a save-as: ['/tmp/a.bin'].
Izhod piši: ['========== RELOADING SNAP:'], nova-vrstica.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototip pomnilniški-naslov = old-out-address) resnično: {
	Izhod piši: ['Object link re-attached.'], nova-vrstica.
}.

b item piši: ['hello from loaded out!'], nova-vrstica.
b greet.
