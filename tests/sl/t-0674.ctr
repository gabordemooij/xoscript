# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> pot := ['/tmp/dat.csv'].
>> csv := Datoteka nov: pot.
csv piši: s.

# accepts CRLF LF CR, varying row length
csv ločilo: [';'] narekovaj: ['"'] vrstice: { :line
	Program počisti.
	Izhod piši: line, nova-vrstica.
	Program počisti.
}.

# unequal lines
s dodaj-na-konec: ['\njustone'].
csv piši: s.
{
	csv ločilo: [';'] narekovaj: ['"'] vrstice: { :line
		Izhod piši: line, nova-vrstica.
	}.
} ujemi: { :e 
	Izhod piši: e, nova-vrstica.
}, zaženi.

# invalid format
s := ['"he"llo";world'].
csv piši: s.
{
	csv ločilo: [';'] narekovaj: ['"'] vrstice: { :line
		Izhod piši: line, nova-vrstica.
	}.
} ujemi: { :e 
	Izhod piši: e, nova-vrstica.
}, zaženi.
