
Besedilo ob: ['ovrednoti'] izvedi: {
	>> koda := Datoteka nov: ['/tmp/eval.ctr'].
	koda piši: (sebe besedilo + ['.']).
	Program uporabljaj: ['/tmp/eval.ctr'].
}.

>> map :=
	(Slovar nov)
	postavi: ['Živjo Vsem'] na: ['two'],
	postavi: (Seznam ← ['hello'] ; ['world'] ; (Seznam ← 1 ; 2; 9) ; Neresnično) na: ['ena'],
	postavi: ( (Slovar nov) postavi: ['svte'] na: ['napačno napisano'] ) na: ['three'],
	postavi: (Seznam ← ((Slovar nov) postavi: ['zaklad'] na: ['skrito']) ; 2) na: ['štiri']. 
>> str := map besedilo.
>> map2 := Nič.
(['map2 := '] + str ) ovrednoti.
Izhod piši: map2 ? ['ena'] ? 0.
Izhod piši: map2 ? ['ena'] ? 1.
Izhod piši: map2 ? ['štiri'] ? 0 ? ['skrito'].
Izhod piši: map2 ? ['ena'] ? 2 ? 2.
