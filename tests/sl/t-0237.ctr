
Besedilo ob: ['evaluate'] izvedi: {
	>> koda := Datoteka nov: ['/tmp/eval.ctr'].
	koda piši: (sebe besedilo + ['.']).
	Program uporabljaj: ['/tmp/eval.ctr'].
}.

>> map :=
	(Slovar nov)
	postavi: ['Hi There'] na: ['two'],
	postavi: (Seznam ← ['hello'] ; ['world'] ; (Seznam ← 1 ; 2; 9) ; Neresnično) na: ['one'],
	postavi: ( (Slovar nov) postavi: ['wrrld'] na: ['misspelled'] ) na: ['three'],
	postavi: (Seznam ← ((Slovar nov) postavi: ['treasure'] na: ['hidden']) ; 2) na: ['four']. 
>> str := map besedilo.
>> map2 := Nič.
(['map2 := '] + str ) evaluate.
Izhod piši: map2 ? ['one'] ? 0.
Izhod piši: map2 ? ['one'] ? 1.
Izhod piši: map2 ? ['four'] ? 0 ? ['hidden'].
Izhod piši: map2 ? ['one'] ? 2 ? 2.
