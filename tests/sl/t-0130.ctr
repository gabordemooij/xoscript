# uporaba FFI z vtičnikom Server

# poveži se z libc (odvisno od platforme)
>> imeKnjižnice := Program nastavitev: ['FFITESTLIB'].

# poveži funkcije stdio iz C za napredne operacije z datotekami
Server poveži: ( Seznam nov ;
 imeKnjižnice ; ['fopen'] ;
 ( Seznam nov ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
poveži: ( Seznam nov ;
 Nič ; # pomeni isto knjižnico
 ['fread'] ;
 ( Seznam nov ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nič ; # pomeni isti objekt (tj. Tok)
 ['fread']
),
poveži: (
 Seznam nov ;
 Nič ; # pomeni isto knjižnico
 ['fwrite'] ;
 ( Seznam nov ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nič ; # pomeni isto knjižnico
 ['fwrite']
),
poveži: (
 Seznam nov ;
 Nič ; # pomeni isto knjižnico
 ['rewind'] ;
 ( Seznam nov ; ['pointer'] ) ;
 ['int'] ;
 Nič ; # pomeni isto knjižnico
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> pot := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# odpri datoteko s fopen(path, mode)
>> fd := Stream path: pot mode: mode.

# zapiši bajte iz medpomnilnika niz v datoteko
>> zapisani-bajti := Stream sporočilo: ['fwrite'] argumenti: (Seznam nov ; str ; 1 ; 6 ; fd ).
Izhod piši: zapisani-bajti, nova-vrstica.

# previj kazalec datoteke na začetek
Stream rewind: fd.

# dodeli medpomnilnik
>> mp := Blob nov: 20.

# beri iz datoteke
>> prebrani-bajti := Stream sporočilo: ['fread'] argumenti: (Seznam nov ; mp ; 1 ; 6 ; fd ).
Izhod piši: prebrani-bajti, nova-vrstica.
Izhod piši: mp, nova-vrstica.

# sprosti pomnilnik
str  sprosti.
pot sprosti.
mode sprosti.
mp  sprosti.


