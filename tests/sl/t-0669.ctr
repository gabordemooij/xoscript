# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Sef 
	zgoščeno-geslo: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Sef 
	zgoščeno-geslo: hash preveri: a1.
	# fail 
>> b := Sef
	zgoščeno-geslo: hash preveri: a2.
	# ok!

Izhod piši: a, nova-vrstica.
Izhod piši: b, nova-vrstica.

