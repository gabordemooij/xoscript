# Zgoščevanje gesel
Server init.

# Uporabnik nastavi geslo
>> gsl := ['pass123'].

# Shraniš ga takole
>> zgoščenka := Sef 
	zgoščeno-geslo: gsl.

# Nato se uporabnik prijavi
# Poskus 1
>> a1 := ['abcd123'].
# Poskus 2
>> a2 := ['pass123'].

# Preveri
>> a := Sef 
	zgoščeno-geslo: zgoščenka preveri: a1.
	# neuspeh 
>> b := Sef
	zgoščeno-geslo: zgoščenka preveri: a2.
	# v redu!

Izhod piši: a, nova-vrstica.
Izhod piši: b, nova-vrstica.

