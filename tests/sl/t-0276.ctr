>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objekt nov.
⚄ ob: ['drawFrom:length:'] izvedi: { :pool :število-elementov
	
	>> result := [''].
	
	{
		>> index := Število random % (pool dolžina).
		result dodaj-na-konec: ( pool znak: (index + 1) ).
		
	} × število-elementov. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? dolžina.
Izhod piši: (['x↵'] x random dolžina).
Izhod piši: (['y↵'] y ?? dolžina).

