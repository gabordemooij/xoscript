>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objekt nov.
⚄ ob: ['izžrebaj:dolžina:'] izvedi: { :nabor :število-elementov
	
	>> rezultat := [''].
	
	{
		>> indeks := Število naključen % (nabor dolžina).
		rezultat dodaj-na-konec: ( nabor znak: (indeks + 1) ).
		
	} × število-elementov. <- rezultat.
}.

>> naključen := ⚄ izžrebaj: ?? dolžina: ?? dolžina.
Izhod piši: (['x↵'] x naključen dolžina).
Izhod piši: (['y↵'] y ?? dolžina).

