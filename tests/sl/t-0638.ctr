
Server init.
>> zht := HTTP-Zahteva nov.
Izhod piši: ['HTTP-GET d[]=']  + ( zht get-seznam: ['d[]'] ), nova-vrstica. # GET
Izhod piši: ['HTTP-GET f[]=']  + ( zht get-seznam: ['f[]'] ), nova-vrstica. # GET
Izhod piši: ['HTTP-POST e[]='] + ( zht post-seznam: ['e[]'] ), nova-vrstica. # GET
Izhod piši: ['HTTP-POST c=']   + ( zht post: ['c'] ), nova-vrstica. # GET
Izhod piši: ['HTTP-POST xx=']  + ( zht post: ['xx'] ), nova-vrstica. # GET
