
Server init.
>> rq := HTTP-Zahteva nov.
Izhod piši: ['HTTP-GET d[]=']  + ( rq get-seznam: ['d[]'] ), nova-vrstica. # GET
Izhod piši: ['HTTP-GET f[]=']  + ( rq get-seznam: ['f[]'] ), nova-vrstica. # GET
Izhod piši: ['HTTP-POST e[]='] + ( rq post-seznam: ['e[]'] ), nova-vrstica. # GET
Izhod piši: ['HTTP-POST c=']   + ( rq post: ['c'] ), nova-vrstica. # GET
Izhod piši: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), nova-vrstica. # GET
