


>> CoffeeMachine := Objekt nov.
CoffeeMachine ob: ['order:'] izvedi: { :id
	>> coffee := ['Americano'].
	( id = 1 ) resnično: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) resnično: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) resnično: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Objekt nov.
SimpleCoffeeMachine ob: ['order'] izvedi: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Izhod piši: redCup, nova-vrstica.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Izhod piši: greenCup, nova-vrstica.
>> yellowCup := CoffeeMachine order: 1.
Izhod piši: yellowCup, nova-vrstica.
>> blueCup := CoffeeMachine order: 0.
Izhod piši: blueCup, nova-vrstica.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Izhod piši: blackCup, nova-vrstica.
blackCup dodaj-na-konec: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Izhod piši: orangeCup, nova-vrstica.
