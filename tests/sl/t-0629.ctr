# test podatkovne baze
# za potrebno konfiguracijo glej primer server.xo

Server init.
Izhod piši: ['Test podatkovne baze'], nova-vrstica.

>> pb := Maria-DB nov gostitelj: ['localhost'],
	uporabnik: ['xo'], geslo: ['pass123'], ime-baze: ['xobase'], poveži-se.

Izhod piši: ['Se lahko povežemo? '] + pb povezano?, nova-vrstica.

>> iskalni-parametri := pb poizvedba: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parametri: ( Seznam nov ; ['abc'] ; 12.35 ; 6 ). # parametrizirane poizvedbe

{  iskalni-parametri izvedi. pb potrdi. } ujemi: { :e pb razveljavi.  }, zaženi.

Izhod piši: ['Lahko vstavimo? '] + ( iskalni-parametri insert-id > 0 ), nova-vrstica.

>> Obj := Objekt nov.
Obj ob: ['pridobi-vrstice'] izvedi: {
	svoj število-elementov := 0.
	>> iskalni-parametri :=
	pb poizvedba: ['SELECT * FROM book order by id desc limit 2'], 
	pridobi: { :vrsta 
		svoj število-elementov prištej: 1.
		Resnično prekini.
	}. # pridobivanje vrstic
	<- svoj število-elementov kopiraj.
}.

Izhod piši: ['Lahko poizvedujemo? '] + ( Obj pridobi-vrstice > 0 ), nova-vrstica.
