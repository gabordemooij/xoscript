Server init.
Izhod piši: ['Test datuma in časa v podatkovni bazi'], nova-vrstica.

>> pb := Maria-DB nov gostitelj: ['localhost'],
	uporabnik: ['xo'], 
	geslo: ['pass123'],
	ime-baze: ['xobase'],
	poveži-se.

>> iskalni-parametri :=
pb poizvedba: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
pridobi: { :vrsta
	Izhod piši: vrsta datetimetest, nova-vrstica.
}.
