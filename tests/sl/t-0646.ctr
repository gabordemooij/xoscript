Server init.
Izhod piši: ['Database datetime test'], nova-vrstica.

>> db := Maria-DB nov gostitelj: ['localhost'],
	uporabnik: ['xo'], 
	geslo: ['pass123'],
	ime-baze: ['xobase'],
	poveži-se.

>> iskalni-parametri :=
db poizvedba: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
pridobi: { :row
	Izhod piši: row datetimetest, nova-vrstica.
}.
