Izhod piši: ['Test object'], nova-vrstica.
>> greeter := Objekt nov.
greeter ob: ['name:'] izvedi: { :ime
	svoj xname := ime. 
}.
greeter ob: ['greet'] izvedi: {
	Izhod piši: ['Hello '] + svoj xname, nova-vrstica.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Izhod piši: ['========== RELOADING SNAP:'], nova-vrstica.
>> b := Objekt load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
