# ključi in podpisi trezorja, ki se dekodirajo predolgi, ne smejo prekoračiti sklada
Server init.

>> ključi := Sef ustvari-ključe.
>> zk := ključi prvi.
>> jk := ključi zadnji.
>> podp := Sef podpiši: ['abc'] s: zk.

# 88 znakov brez zapolnitve se dekodira v 66 bajtov
>> dolg := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 znakov brez zapolnitve se dekodira v 33 bajtov
>> kratko := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Sef podpiši: ['abc'] s: dolg. } ujemi: { :e
	Izhod piši: e, nova-vrstica.
}, zaženi.

{ Sef preveri: ['abc'] podpis: dolg s: jk. } ujemi: { :e
	Izhod piši: e, nova-vrstica.
}, zaženi.

{ Sef preveri: ['abc'] podpis: podp s: kratko. } ujemi: { :e
	Izhod piši: e, nova-vrstica.
}, zaženi.
