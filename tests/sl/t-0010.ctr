>> Žival := Objekt nov.
Žival ob: ['naredi'] izvedi: {
	>> žival := Objekt nov.
	žival ob: ['oglasiSe'] izvedi: {
		Izhod piši: svoj zvok.
	}. <- žival.
}.
>> Mačka := Objekt nov.
Mačka ob: ['naredi'] izvedi: {
	>> mačka := Žival naredi.
	mačka ob: ['init'] izvedi: {
		svoj zvok := ['meow!'].
	}.
	mačka init. <- mačka.
}.
>> tom := Mačka naredi.
tom oglasiSe.
