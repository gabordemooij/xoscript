>> Animal := Objekt nov.
Animal ob: ['make'] izvedi: {
	>> animal := Objekt nov.
	animal ob: ['makeSound'] izvedi: {
		Izhod piši: svoj sound.
	}. <- animal.
}.
>> Cat := Objekt nov.
Cat ob: ['make'] izvedi: {
	>> cat := Animal make.
	cat ob: ['init'] izvedi: {
		svoj sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
