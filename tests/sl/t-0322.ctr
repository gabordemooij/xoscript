

>> Matrjoška := Objekt nov.
Matrjoška ob: ['double:'] izvedi: { :skrivnost
	svoj skrivnost := skrivnost × 2.
}.
Matrjoška ob: ['nov:'] izvedi: { :skrivnost
	>> odgovor := Nič.
	>> t := (skrivnost > 255).
	Izhod piši: (skrivnost + [' | '] + t), nova-vrstica.
	t resnično: {
		odgovor := skrivnost.
	}, sicer: {
		odgovor := Matrjoška rekurziven nov: (sebe double: skrivnost).
	}. <- odgovor.
}.

>> x := Matrjoška nov: 2.
