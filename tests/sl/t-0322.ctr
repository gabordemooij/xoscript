

>> Matryoshka := Objekt nov.
Matryoshka ob: ['double:'] izvedi: { :secret
	svoj secret := secret × 2.
}.
Matryoshka ob: ['nov:'] izvedi: { :secret
	>> answer := Nič.
	>> t := (secret > 255).
	Izhod piši: (secret + [' | '] + t), nova-vrstica.
	t resnično: {
		answer := secret.
	}, sicer: {
		answer := Matryoshka rekurziven nov: (sebe double: secret).
	}. <- answer.
}.

>> x := Matryoshka nov: 2.
