


>> vino := Objekt nov.


vino ob: ['vBesedilo'] izvedi: { <- ['merlot'].
}.

vino ob: ['naarTekst'] izvedi: { <- ['merlot'].
}.


vino ob: ['='] izvedi: { :other wine <- ( sebe vBesedilo = other wine ).
}.

vino ob: ['=='] izvedi: { :other wine <- ( sebe vBesedilo = other wine ).
}.



vino
	primer: ['cabernet'] izvedi: { Izhod piši: ['to je Cabernet!']. },
	primer: ['syrah']    izvedi: { Izhod piši: ['to je Syrah!'].    },
	primer: ['merlot']   izvedi: { Izhod piši: ['to je Merlot!'].   },
	primer: ['malbec']   izvedi: { Izhod piši: ['to je Malbec!'].   }.

Izhod nova-vrstica.
