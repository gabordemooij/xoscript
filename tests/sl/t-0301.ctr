


>> wine := Objekt nov.


wine ob: ['toString'] izvedi: { <- ['merlot'].
}.

wine ob: ['naarTekst'] izvedi: { <- ['merlot'].
}.


wine ob: ['='] izvedi: { :other wine <- ( sebe toString = other wine ).
}.

wine ob: ['=='] izvedi: { :other wine <- ( sebe toString = other wine ).
}.



wine
	primer: ['cabernet'] izvedi: { Izhod piši: ['it's a Cabernet!']. },
	primer: ['syrah']    izvedi: { Izhod piši: ['it's a Syrah!'].    },
	primer: ['merlot']   izvedi: { Izhod piši: ['it's a Merlot!'].   },
	primer: ['malbec']   izvedi: { Izhod piši: ['it's a Malbec!'].   }.

