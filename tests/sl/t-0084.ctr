>> narediSeštevalnik := { :x
	>> f := { :y <- (svoj x + y). } nastavi: ['x'] vrednost: x. <- f.
}.
>> preslikovalnik := { :tabela :fn
	>> preslikovanje := { :i svoj q postavi: (svoj f uporabi: (svoj q ? i)) na: i. } 
	nastavi: ['q'] vrednost: tabela,
	nastavi: ['f'] vrednost: fn.
	{ :i preslikovanje uporabi: i. } × (tabela število-elementov).
}.

>> a := Seznam ← 1; 2; 3.
preslikovalnik uporabi: a in: (narediSeštevalnik uporabi: 100).
Izhod piši: (a položaj: 0), nova-vrstica.
Izhod piši: (a ? 1), nova-vrstica.
Izhod piši: (a ? 2), nova-vrstica.
