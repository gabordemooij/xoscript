>> makeAdder := { :x
	>> f := { :y <- (svoj x + y). } nastavi: ['x'] vrednost: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i svoj q postavi: (svoj f uporabi: (svoj q ? i)) na: i. } 
	nastavi: ['q'] vrednost: array,
	nastavi: ['f'] vrednost: func.
	{ :i mapping uporabi: i. } × (array število-elementov).
}.

>> a := Seznam ← 1; 2; 3.
mapper uporabi: a in: (makeAdder uporabi: 100).
Izhod piši: (a položaj: 0), nova-vrstica.
Izhod piši: (a ? 1), nova-vrstica.
Izhod piši: (a ? 2), nova-vrstica.
