
Seznam ob: ['sum'] izvedi: {
	>> total := 0.
	sebe vsak: { :index :element
		total prištej: element.
	}. <- total.
}.

>> a := Seznam ← 9 ; 8 ; 7.
Izhod piši: (a sum), nova-vrstica. 
>> a := Seznam ← 1 ; 9.
Izhod piši: (a sum), nova-vrstica. 
>> a := Seznam ← ['o'] ; 2.
Izhod piši: (a sum), nova-vrstica. 
Izhod piši: (Seznam nov sum), nova-vrstica. 
