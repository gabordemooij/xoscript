
>> Pravokotnik := Objekt nov.

Pravokotnik ob: ['ploščina'] izvedi: {
	<- svoj dolžina * svoj širina.
}.

Pravokotnik ob: ['length:'] izvedi: { :dolžina
	svoj dolžina := dolžina.
}.

Pravokotnik ob: ['width:'] izvedi: { :širina
	svoj širina := širina.
}.

Pravokotnik ob: ['nov'] izvedi: {
	# to ne povzroči neskončne zanke
	>> pravokotnik := sebe nov.
	pravokotnik length: 0, width: 0.
	<- pravokotnik.
}.

>> a := Pravokotnik nov.
Izhod piši: a ploščina, nova-vrstica. #0

>> b := Pravokotnik nov length: 2, width: 3.
Izhod piši: b ploščina, nova-vrstica. #6

