
>> Rectangle := Objekt nov.

Rectangle ob: ['area'] izvedi: { <- svoj dolžina * svoj width.
}.

Rectangle ob: ['length:'] izvedi: { :dolžina
	svoj dolžina := dolžina.
}.

Rectangle ob: ['width:'] izvedi: { :width
	svoj width := width.
}.

Rectangle ob: ['nov'] izvedi: {
	# this will not result into an infinite loop
	>> rectangle := sebe nov.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle nov.
Izhod piši: a area, nova-vrstica. #0

>> b := Rectangle nov length: 2, width: 3.
Izhod piši: b area, nova-vrstica. #6

