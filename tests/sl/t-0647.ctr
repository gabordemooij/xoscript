Server init.
Izhod piši: ['Test časa v podatkovni bazi'], nova-vrstica.

>> pb := Maria-DB nov gostitelj: ['localhost'],
	uporabnik: ['xo'], 
	geslo: ['pass123'],
	ime-baze: ['xobase'],
	poveži-se.

>> iskalni-parametri :=
pb poizvedba: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
pridobi: { :vrsta
	Izhod piši: vrsta timetest, nova-vrstica.
}.
