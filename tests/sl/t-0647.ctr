Server init.
Izhod piši: ['Database time test'], nova-vrstica.

>> db := Maria-DB nov gostitelj: ['localhost'],
	uporabnik: ['xo'], 
	geslo: ['pass123'],
	ime-baze: ['xobase'],
	poveži-se.

>> iskalni-parametri :=
db poizvedba: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
pridobi: { :row
	Izhod piši: row timetest, nova-vrstica.
}.
