>> a := 3.
>> b := a kopiraj.
a odštej: 1.
Izhod piši: [' a = '] + a.
Izhod piši: [' b = '] + b.
a := 3.
b := a + 4.
Izhod piši: [' a = '] + a.
Izhod piši: [' b = '] + b.
>> x := 3.
>> y := x kopiraj.
x prištej: 10.
y odštej: 1.
Izhod piši: [' x = '] + x.
Izhod piši: [' y = '] + y.
>> q := Objekt nov.
q ob: ['setProperty:'] izvedi: { :x
	svoj lastn := x.
}.
q ob: ['dobiLastnost'] izvedi: { <- svoj lastn.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Izhod piši: [' p = '] + (p dobiLastnost).
