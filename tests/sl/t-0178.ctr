Program upravljanje-pomnilnika: 0.

>> txt := ['Word Salad'].
Izhod piši: ['zadnji indeks od sed = '] + (( txt zadnji: ['ord'] ) - 0), nova-vrstica.
Izhod piši: ['indeks od sed = '] + (( txt najdi: ['ord'] ) - 0), nova-vrstica.
Izhod piši: ['indeks od ta = '] + (( txt najdi: ['ad'] ) - 0), nova-vrstica.
Izhod piši: ['zadnji indeks od B = '] + (( txt zadnji: ['W'] ) - 0), nova-vrstica.
Izhod piši: ['zadnji indeks od a = '] + (( txt zadnji: ['d'] ) - 0), nova-vrstica.
Izhod piši: ['txt je enako Besedna Solata = '] + ( txt = ['Word Salad'] ), nova-vrstica.
Izhod piši: ['txt je enako Cezarjeva Solata = '] + ( txt = ['Cezarjeva Solata'] ), nova-vrstica.
Izhod piši: ['txt ni enako Besedna Solata = '] + ( txt ≠ ['Word Salad'] ), nova-vrstica.
Izhod piši: ['txt ni enako Cezarjeva Solata = '] + ( txt ≠ ['Cezarjeva Solata'] ), nova-vrstica.

