

Seznam ob: ['fixture:'] izvedi: { :f
	svoj stalnica := f.
}.

Seznam ob: ['število-elementov'] izvedi: { <- svoj stalnica.
}.

Seznam ob: ['aantal'] izvedi: { <- svoj stalnica.
}.


>> x := Nič.
{

	x := ['hello'] 
	zamenjaj:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] znak: 2)
			)
		)
	z: (
		(['...hal'] + ['lo']) 
			velike-črke 
			lowecase 
			velike-črke 
			odmik: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Seznam ← 0 ; 1 ; 4; 9 ; (Seznam ← 0 ; 3; 1) ; 4
							) predzadnji
						) ? 1
					) + 
					((Seznam ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					število-elementov
				)
			)
	).

} × 10.
Izhod piši: x, nova-vrstica.

