# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Sef ustvari-ključe.

# private (secret) key
>> sk := keys prvi.

# public key
>> pk := keys zadnji.

# sign a message
>> sig := Sef podpiši: ['abc'] s: sk.

# check message (ok)
Izhod piši: ( 
	Sef
		preveri: ['abc'] 
		podpis: sig 
		s: pk 
), nova-vrstica.

# check message (fail)
Izhod piši: ( 
	Sef 
		preveri: ['abd'] 
		podpis: sig 
		s: pk 
), nova-vrstica.