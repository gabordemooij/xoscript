# javni ključ (za zaščito API-jev itd.)
Server init.

# ustvari ključe
>> ključi := Sef ustvari-ključe.

# zasebni (skrivni) ključ
>> zk := ključi prvi.

# javni ključ
>> jk := ključi zadnji.

# podpiši sporočilo
>> podp := Sef podpiši: ['abc'] s: zk.

# preveri sporočilo (v redu)
Izhod piši: ( 
	Sef
		preveri: ['abc'] 
		podpis: podp 
		s: jk 
), nova-vrstica.

# preveri sporočilo (neuspeh)
Izhod piši: ( 
	Sef 
		preveri: ['abd'] 
		podpis: podp 
		s: jk 
), nova-vrstica.