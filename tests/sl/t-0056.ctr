>> z := Objekt nov.
z ob: ['value:'] izvedi: { :v
	svoj value := v. <- sebe.
}.
z ob: ['value'] izvedi: { <- svoj value. }.
(z setValue: 1) value: 2.
Izhod piši: z value.
>> x := z.
Izhod piši: x value.
z := Nič.
Izhod piši: z value.
Izhod piši: x value.
Izhod piši: ['hello'].
Izhod piši: 3 + 2.
Izhod piši: (3 > 2).
