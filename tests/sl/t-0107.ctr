
Izhod piši: ['Prekini for-zanko, 0-4.'], nova-vrstica.
{ :i
	Izhod piši: ['iteration #'] + i, nova-vrstica.
	(i = 4) prekini.
} × 10.

>> x := 0.
>> xJeManjšiOd10 := { <- ( x < 10 ). }.

Izhod piši: ['Prekini while-true zanko, 0-4.'], nova-vrstica.
{
	Izhod piši: ['iteration #'] + x, nova-vrstica.
	x prištej: 1.
	((x < 5) ne) prekini.
} dokler: xJeManjšiOd10.

Izhod piši: ['Prekini while-false zanko, 5,4.'], nova-vrstica.
{
	Izhod piši: ['iteration #'] + x, nova-vrstica.
	x odštej: 1.
	(x = 3) prekini.
} dokler: { <- (x > 0). }.

Izhod piši: ['Prekini times zanko, 1-4.'], nova-vrstica.
{ :i
	Izhod piši: ['iteration #'] + i, nova-vrstica.
	(i = 4) prekini.
} × 5.

Izhod piši: ['Prekini blok, ne izpiši vrstice.'], nova-vrstica.
{ Resnično prekini. Izhod piši: ['tega ne zapiši!'], nova-vrstica. } zaženi.

Izhod piši: ['Prekini blok, ne sproži lovljenja...'], nova-vrstica.
{ Resnično prekini. Izhod piši: ['tega ne zapiši!'], nova-vrstica. } ujemi: { Izhod piši: ['Tega ne ujemi!']. }, zaženi.

Izhod piši: ['Test each-zanke Seznama: 0,1'], nova-vrstica.
(Seznam ← 1 ; 2 ; 3) preslikaj: { :i
	Izhod piši: ['iteration #'] + i, nova-vrstica.
	(i = 1) prekini.
}.

Izhod piši: ['Test each-zanke Slovarja: samo c'], nova-vrstica.
>> m := Slovar nov.
m postavi: ['first'] na: ['a'], postavi: ['second'] na: ['b'], postavi: ['tretji'] na: ['c'].
m vsak: { :k :v
	Izhod piši: ['iteration'] + v + k, nova-vrstica.
	Resnično prekini.
}.

