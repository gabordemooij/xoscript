
Izhod piši: ['Break for-loop, 0-4.'], nova-vrstica.
{ :i
	Izhod piši: ['iteration #'] + i, nova-vrstica.
	(i = 4) prekini.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Izhod piši: ['Break while-true loop, 0-4.'], nova-vrstica.
{
	Izhod piši: ['iteration #'] + x, nova-vrstica.
	x prištej: 1.
	((x < 5) ne) prekini.
} dokler: xIsLessThan10.

Izhod piši: ['Break while-false loop, 5,4.'], nova-vrstica.
{
	Izhod piši: ['iteration #'] + x, nova-vrstica.
	x odštej: 1.
	(x = 3) prekini.
} dokler: { <- (x > 0). }.

Izhod piši: ['Break times loop, 1-4.'], nova-vrstica.
{ :i
	Izhod piši: ['iteration #'] + i, nova-vrstica.
	(i = 4) prekini.
} × 5.

Izhod piši: ['Break block, dont print line.'], nova-vrstica.
{ Resnično prekini. Izhod piši: ['dont write this!'], nova-vrstica. } zaženi.

Izhod piši: ['Break block, dont fire catch...'], nova-vrstica.
{ Resnično prekini. Izhod piši: ['dont write this!'], nova-vrstica. } ujemi: { Izhod piši: ['Dont catch this!']. }, zaženi.

Izhod piši: ['Test Array each-loop: 0,1'], nova-vrstica.
(Seznam ← 1 ; 2 ; 3) preslikaj: { :i
	Izhod piši: ['iteration #'] + i, nova-vrstica.
	(i = 1) prekini.
}.

Izhod piši: ['Test Map each-loop: c only'], nova-vrstica.
>> m := Slovar nov.
m postavi: ['first'] na: ['a'], postavi: ['second'] na: ['b'], postavi: ['third'] na: ['c'].
m vsak: { :k :v
	Izhod piši: ['iteration'] + v + k, nova-vrstica.
	Resnično prekini.
}.

