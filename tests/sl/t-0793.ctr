Server init.

>> DB := Maria-DB nov gostitelj: ['localhost'],
	uporabnik: ['xo'],
	geslo: ['pass123'],
	ime-baze: ['xobase'],
	poveži-se.

{
	DB poizvedba:
	['DROP TABLE movies'],
	izvedi.
} ujemi: { Nič. }, zaženi.

DB poizvedba:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
izvedi.

DB poizvedba: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parametri: ( Seznam nov ; ['Halloween'] ),
izvedi.

DB poizvedba: ['SELECT * FROM movies'],
pridobi: { :movie
	Izhod piši: movie title, nova-vrstica.
}.

