Server init.

>> PB := Maria-DB nov gostitelj: ['localhost'],
	uporabnik: ['xo'],
	geslo: ['pass123'],
	ime-baze: ['xobase'],
	poveži-se.

{
	PB poizvedba:
	['DROP TABLE movies'],
	izvedi.
} ujemi: { Nič. }, zaženi.

PB poizvedba:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
izvedi.

PB poizvedba: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parametri: ( Seznam nov ; ['Noč čarovnic'] ),
izvedi.

PB poizvedba: ['SELECT * FROM movies'],
pridobi: { :film
	Izhod piši: film title, nova-vrstica.
}.

