>> Slurp := Objekt nov.
Slurp ob: ['nov'] izvedi: {
	svoj str := [''].
}.

Slurp ob: ['odgovori:'] izvedi: { :blah
		(svoj str ≠ ['']) resnično: {
			svoj str dodaj-na-konec: [' '].
		}.
		svoj str dodaj-na-konec: blah.
}.
Slurp ob: ['odgovori:in:'] izvedi: { :blah :blahah
		(svoj str ≠ ['']) resnično: {
			svoj str dodaj-na-konec: [' '].
		}.
		(blah dolžina > 1) resnično: {
			svoj str dodaj-na-konec: (blah od: 0 dolžina: (blah dolžina - 1)).
		}, sicer: {
			svoj str dodaj-na-konec: blah.
		}.
		svoj str dodaj-na-konec: [' '].
		svoj str dodaj-na-konec: blahah.
}.
Slurp ob: ['obtain'] izvedi: {
	>> buffer := svoj str.
	svoj str := ['']. <- buffer.
}.

>> s := Slurp nov.
s hello: ['world'].
Izhod piši: ( s obtain ), nova-vrstica.
