>> randomizer := { :a :b
	>> minimum := ( a < b ) ali: a ali: b.
	>> maksimum := ( a > b ) ali: a ali: b.
	>> x := Nič.
	{
		x := Število med: a in: b.
		((x < minimum) ali: (x > maksimum)) resnično: { 
			Izhod piši: (['Invalid value!']).
			Program konec.
		}.
	} 
	× 100. <- x.
}.
randomizer uporabi: 0 in: 0.
randomizer uporabi: 1 in: 0.
randomizer uporabi: 1 in: 1.
randomizer uporabi: 0 in: 1.
randomizer uporabi: -1 in: 0.
randomizer uporabi: -1 in: -1.
randomizer uporabi: 0 in: -1.
randomizer uporabi: 100 in: 200.
randomizer uporabi: 999999999999998 in: 999999999999999.
randomizer uporabi: 999999999999999 in: 999999999999998.
randomizer uporabi: 999999999999999 in: 999999999999999.
randomizer uporabi: -999999999999998 in: -999999999999999.
randomizer uporabi: -999999999999999 in: -999999999999998.
randomizer uporabi: -999999999999999 in: -999999999999999.
