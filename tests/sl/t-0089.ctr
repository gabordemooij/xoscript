>> naključnik := { :a :b
	>> minimum := ( a < b ) ali: a ali: b.
	>> maksimum := ( a > b ) ali: a ali: b.
	>> x := Nič.
	{
		x := Število med: a in: b.
		((x < minimum) ali: (x > maksimum)) resnično: { 
			Izhod piši: (['Neveljavna vrednost!']).
			Program konec.
		}.
	} 
	× 100. <- x.
}.
naključnik uporabi: 0 in: 0.
naključnik uporabi: 1 in: 0.
naključnik uporabi: 1 in: 1.
naključnik uporabi: 0 in: 1.
naključnik uporabi: -1 in: 0.
naključnik uporabi: -1 in: -1.
naključnik uporabi: 0 in: -1.
naključnik uporabi: 100 in: 200.
