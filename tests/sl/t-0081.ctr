>> map1 := Slovar nov.
>> key1 := Seznam nov.
>> key2 := Seznam nov.

map1
	postavi: ['hello'] na: key1,
	postavi: ['world'] na: key2.


Izhod
	piši: ['Map #1 contains: '] + (map1 na: key1),
	piši: [' and '] + (map1 na: key2), nova-vrstica.

>> KeyeableArray := Seznam nov.
KeyeableArray ob: ['toString'] izvedi: { <- (sebe število-elementov) toString.
}.

>> map2 := Slovar nov.
key1 := KeyeableArray nov.
key2 := KeyeableArray nov.

key1 dodaj-na-konec: 1.

map2
	postavi: ['hello'] na: key1,
	postavi: ['world'] na: key2.

Izhod
	piši: ['Map #2 contains: '] + (map2 na: key1),
	piši: [' and '] + (map2 na: key2), nova-vrstica.
