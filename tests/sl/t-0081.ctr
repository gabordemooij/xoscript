>> slovar1 := Slovar nov.
>> ključ1 := Seznam nov.
>> ključ2 := Seznam nov.

slovar1
	postavi: ['hello'] na: ključ1,
	postavi: ['world'] na: ključ2.


Izhod
	piši: ['Map #1 contains: '] + (slovar1 na: ključ1),
	piši: [' in '] + (slovar1 na: ključ2), nova-vrstica.

>> KljučevSeznam := Seznam nov.
KljučevSeznam ob: ['vBesedilo'] izvedi: { <- (sebe število-elementov) vBesedilo.
}.

>> map2 := Slovar nov.
ključ1 := KljučevSeznam nov.
ključ2 := KljučevSeznam nov.

ključ1 dodaj-na-konec: 1.

map2
	postavi: ['hello'] na: ključ1,
	postavi: ['world'] na: ključ2.

Izhod
	piši: ['Map #2 contains: '] + (map2 na: ključ1),
	piši: [' in '] + (map2 na: ključ2), nova-vrstica.
