#Linux

(Datoteka nov: ['/tmp/testje']) obstaja neresnično: {
	Program sistem: ['mkdir /tmp/testje'].	
}.

(Datoteka nov: ['/tmp/testje/file1']) obstaja neresnično: {
	Program sistem: ['touch /tmp/testje/file1'].	
}.

(Datoteka nov: ['/tmp/testje/folder1']) obstaja neresnično: {
	Program sistem: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Datoteka seznam: ['/tmp/testje'].

>> q := Seznam nov.

l vsak: { :k :v v vsak: { :x :y q dodaj-na-konec: y. }. }.

>> s := q besedilo.

(s vsebuje: ['file1']) resnično:   { Izhod piši: ['OK'], nova-vrstica. }.
(s vsebuje: ['file2']) resnično:   { Izhod piši: ['XX'], nova-vrstica. }.
(s vsebuje: ['folder1']) resnično: { Izhod piši: ['OK'], nova-vrstica. }.
