Število ob: ['fakulteta'] izvedi: {
	>> skupaj := 1.
	{ :indeks skupaj pomnoži-z: (sebe - indeks). } × sebe. <- skupaj.
}.

>> porabljenPomnilnik1 := 0.
>> porabljenPomnilnik2 := 0.
>> porabljenPomnilnik3 := 0.
>> porabljenPomnilnik4 := 0.

Program upravljanje-pomnilnika: 0.

{
2 eksponent fakulteta.
Izhod piši: (11 modulo: 3), nova-vrstica.
Izhod piši: (3.4 zaokroži), nova-vrstica.
Izhod piši: (7.1 zaokroži-navzgor), nova-vrstica.
Izhod piši: (7.9 zaokroži-navzdol), nova-vrstica.
}
zaženi.

Program počisti.

porabljenPomnilnik1 := (Program pomnilnik ? 0).

{
2 eksponent fakulteta.
Izhod piši: (11 modulo: 3), nova-vrstica.
Izhod piši: (3.4 zaokroži), nova-vrstica.
Izhod piši: (7.1 zaokroži-navzgor), nova-vrstica.
Izhod piši: (7.9 zaokroži-navzdol), nova-vrstica.
}
zaženi.

Program počisti.
porabljenPomnilnik2 := (Program pomnilnik ? 0).


{
