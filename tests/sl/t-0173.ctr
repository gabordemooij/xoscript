

Seznam ob: ['vsota'] izvedi: {
	>> skupaj := 0.
	sebe vsak: { :indeks :element
		skupaj prištej: element.
	}. <- skupaj.
}.

Seznam ob: ['zmnožek'] izvedi: {
	>> skupaj := 1.
	sebe vsak: { :indeks :element
		skupaj pomnoži-z: element.
	}. <- skupaj.
}.

>> porabljenPomnilnik1 := 0.
>> porabljenPomnilnik2 := 0.
>> porabljenPomnilnik3 := 0.
>> porabljenPomnilnik4 := 0.

Program upravljanje-pomnilnika: 0.

{

>> a := Seznam ← ['hello'] ; ['world'] ; Resnično ; Nič ; 666.
a := a + ( Seznam ← 1 ).
Izhod piši: ( ['vsota: '] + ( a vsota ) ), nova-vrstica.
Izhod piši: ( ['min: '] + ( a minimum ) ), nova-vrstica.
Izhod piši: ( ['maks: '] + ( a maksimum ) ), nova-vrstica.
Izhod piši: ( ['3.: '] + ( a ? 2 ) ), nova-vrstica.
Izhod piši: ( ['zmn: '] + ( a zmnožek ) ), nova-vrstica.
a razvrsti: { :a :b <- (b - a). }.
a vsak: { :i :e Izhod piši: ( i - 0 ), nova-vrstica. }.

} zaženi.

Program počisti.
porabljenPomnilnik1 := (Program pomnilnik ? 0).


