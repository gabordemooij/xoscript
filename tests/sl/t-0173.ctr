

Seznam ob: ['sum'] izvedi: {
	>> total := 0.
	sebe vsak: { :index :element
		total prištej: element.
	}. <- total.
}.

Seznam ob: ['product'] izvedi: {
	>> total := 1.
	sebe vsak: { :index :element
		total pomnoži-z: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program upravljanje-pomnilnika: 0.

{

>> a := Seznam ← ['hello'] ; ['world'] ; Resnično ; Nič ; 666.
a := a + ( Seznam ← 1 ).
Izhod piši: ( ['sum: '] + ( a sum ) ), nova-vrstica.
Izhod piši: ( ['min: '] + ( a minimum ) ), nova-vrstica.
Izhod piši: ( ['max: '] + ( a maksimum ) ), nova-vrstica.
Izhod piši: ( ['3rd: '] + ( a ? 2 ) ), nova-vrstica.
Izhod piši: ( ['prd: '] + ( a product ) ), nova-vrstica.
a razvrsti: { :a :b <- (b - a). }.
a vsak: { :i :e Izhod piši: ( i - 0 ), nova-vrstica. }.

} zaženi.

Program počisti.
usedMemory1 := (Program pomnilnik ? 0).


