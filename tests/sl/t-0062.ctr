Logični ob: ['xor:'] izvedi: { :a :b <- ((a in: b ne) ali: (a ne in: b)).
}.

>> o := Objekt nov.
o ob: ['hello'] izvedi: { ['Empty']. }.
{ o ob: 2 izvedi: 3.} ujemi: { :e Izhod piši: e, nova-vrstica. }, zaženi.
{ o ob: ['test'] izvedi: 3.} ujemi: { :e Izhod piši: e, nova-vrstica. }, zaženi.
{ o ob: ['hello'] izvedi: { ['Empty']. }.} ujemi: { :e Izhod piši: e, nova-vrstica. }, zaženi. 
{ >> z := 4 ÷ 0. } ujemi: { :e Izhod piši: e, nova-vrstica. }, zaženi. 
{ (Resnično in: Nič) resnično: { Izhod piši: ['X'].}. } ujemi: { :e Izhod piši: e, nova-vrstica. }, zaženi. 
{ ([''] xor: 0) resnično: { Izhod piši: ['X'].}. } ujemi: { :e Izhod piši: e, nova-vrstica. }, zaženi. 
{ (1 < ['2']) resnično: { Izhod piši: ['OK']. }. } ujemi: { :e Izhod piši: e, nova-vrstica. }, zaženi. 
{ (1 < ['2.0']) resnično: { Izhod piši: ['OK']. }. } ujemi: { :e Izhod piši: e, nova-vrstica. }, zaženi. 
{ (1 < ['x2.0']) resnično: { Izhod piši: ['NO!']. }. } ujemi: { :e Izhod piši: e, nova-vrstica. }, zaženi. 
{ Izhod piši: (['hello OK there'] od: ['6'] dolžina: ['2']). } zaženi. 
