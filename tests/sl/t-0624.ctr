# Ta test preveri, ali string_fill_in ne izgubi svoje reže (gc'ed) v načinu 4
# sklic v world.c
>> Dnevnik := Objekt nov.

Dnevnik ob: ['say:'] izvedi: { :str
	Izhod piši: str, nova-vrstica.
}.

>> Predmet := Objekt nov.

Predmet ob: ['nov:'] izvedi: { :id
	<- sebe nov id: id.
}.

Predmet ob: ['id:'] izvedi: { :id
	svoj id := id.
}.

Predmet ob: ['id'] izvedi: { <- svoj id. }.


Predmet ob: ['besedilo'] izvedi: {
	>> str := ['Item#~no'].
	str ~no: svoj id.
	<- str.
}.


>> Print := Objekt nov.

Print ob: ['items'] izvedi: { 
	
	svoj predmet := Predmet nov: 1.
	
	# tu bodisi segfault bodisi napačen niz
	Dnevnik say: (
		['~item printed.'] ~item: svoj predmet
	).
	
	
}.

Print items.