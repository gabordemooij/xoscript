# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := Objekt nov.

Log ob: ['say:'] izvedi: { :str
	Izhod piši: str, nova-vrstica.
}.

>> Item := Objekt nov.

Item ob: ['nov:'] izvedi: { :id <- sebe nov id: id.
}.

Item ob: ['id:'] izvedi: { :id
	svoj id := id.
}.

Item ob: ['id'] izvedi: { <- svoj id. }.


Item ob: ['besedilo'] izvedi: {
	>> str := ['Item#~no'].
	str ~no: svoj id. <- str.
}.


>> Print := Objekt nov.

Print ob: ['items'] izvedi: { 
	
	svoj item := Item nov: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: svoj item
	).
	
	
}.

Print items.