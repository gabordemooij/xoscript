Izhod piši: ['Continue for-loop, No - before 6 and up.'], nova-vrstica.
{ :i
	Izhod piši: (i + 1), nova-vrstica.
	((i + 1) > 4) nadaljuj.
	Izhod piši: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Izhod nova-vrstica.
Izhod piši: ['Continue while-true, No --> before 5 and up.'], nova-vrstica.
{
	Izhod piši: ['iteration #'] + x, nova-vrstica.
	x prištej: 1.
	((x < 5) ne) nadaljuj.
	Izhod piši: ['-->'].
} dokler: xIsLessThan10.
Izhod nova-vrstica.
Izhod piši: ['Continue while-false, No - before 3 only.'], nova-vrstica.
{
	Izhod piši: ['iteration #'] + x, nova-vrstica.
	x odštej: 1.
	(x = 3) nadaljuj.
	Izhod piši: ['-'].
} dokler: { <- ( x > 0). }.

Izhod nova-vrstica.
Izhod piši: ['Continue times-loop, No ||| before 3.'], nova-vrstica.
{ :i
	Izhod piši: ['iteration #'] + i, nova-vrstica.
	(i = 2) nadaljuj.
	Izhod piši: ['|||'].
} × 5.

Izhod nova-vrstica.

{ Resnično nadaljuj. Izhod piši: ['dont write this!'], nova-vrstica. } zaženi.

{ Resnično nadaljuj. Izhod piši: ['dont write this!'], nova-vrstica. } ujemi: { Izhod piši: ['Dont catch this!']. }, zaženi.

Izhod piši: ['Test Array each-loop: 0, ... ,2'], nova-vrstica.
(Seznam ← 1 ; 2 ; 3) preslikaj: { :i
	(i = 1) nadaljuj.
	Izhod piši: ['iteration #'] + (i - 0), nova-vrstica.
}.

Izhod piši: ['Test Map each-loop: c only'], nova-vrstica.
>> m := Slovar nov.
m postavi: ['first'] na: ['a'], postavi: ['second'] na: ['b'], postavi: ['third'] na: ['c'].
m vsak: { :k :v
	(k ≠ ['c']) nadaljuj.
	Izhod piši: ['iteration'] + k + v, nova-vrstica.
}.

