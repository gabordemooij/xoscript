Izhod piši: ['Nadaljuj for-zanko, Ne - pred 6 in več.'], nova-vrstica.
{ :i
	Izhod piši: (i + 1), nova-vrstica.
	((i + 1) > 4) nadaljuj.
	Izhod piši: ['-'].
} × 10.

>> x := 0.
>> xJeManjšiOd10 := { <- ( x < 10 ). }.
Izhod nova-vrstica.
Izhod piši: ['Nadaljuj while-true, Ne --> pred 5 in več.'], nova-vrstica.
{
	Izhod piši: ['iteration #'] + x, nova-vrstica.
	x prištej: 1.
	((x < 5) ne) nadaljuj.
	Izhod piši: ['-->'].
} dokler: xJeManjšiOd10.
Izhod nova-vrstica.
Izhod piši: ['Nadaljuj while-false, Ne - samo pred 3.'], nova-vrstica.
{
	Izhod piši: ['iteration #'] + x, nova-vrstica.
	x odštej: 1.
	(x = 3) nadaljuj.
	Izhod piši: ['-'].
} dokler: { <- ( x > 0). }.

Izhod nova-vrstica.
Izhod piši: ['Nadaljuj times-zanko, Ne ||| pred 3.'], nova-vrstica.
{ :i
	Izhod piši: ['iteration #'] + i, nova-vrstica.
	(i = 2) nadaljuj.
	Izhod piši: ['|||'].
} × 5.

Izhod nova-vrstica.

{ Resnično nadaljuj. Izhod piši: ['tega ne zapiši!'], nova-vrstica. } zaženi.

{ Resnično nadaljuj. Izhod piši: ['tega ne zapiši!'], nova-vrstica. } ujemi: { Izhod piši: ['Tega ne ujemi!']. }, zaženi.

Izhod piši: ['Test each-zanke Seznama: 0, ... ,2'], nova-vrstica.
(Seznam ← 1 ; 2 ; 3) preslikaj: { :i
	(i = 1) nadaljuj.
	Izhod piši: ['iteration #'] + (i - 0), nova-vrstica.
}.

Izhod piši: ['Test each-zanke Slovarja: samo c'], nova-vrstica.
>> m := Slovar nov.
m postavi: ['first'] na: ['a'], postavi: ['second'] na: ['b'], postavi: ['tretji'] na: ['c'].
m vsak: { :k :v
	(k ≠ ['c']) nadaljuj.
	Izhod piši: ['iteration'] + k + v, nova-vrstica.
}.

