Izhod piši: ['Test object'], nova-vrstica.
>> a := Objekt nov. 
a ob: ['item:'] izvedi: { :int64
	svoj int64 := int64. 
}.
a ob: ['item'] izvedi: { <- svoj int64.
}.
a item: ( Int64 iz-besedila: ['9999'] ).
Izhod piši: a item, nova-vrstica.
>> old-int64-address := a item prototip pomnilniški-naslov.
a save-as: ['/tmp/a.bin'].
Izhod piši: ['========== RELOADING SNAP:'], nova-vrstica.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b item prototip pomnilniški-naslov = old-int64-address) resnično: {
	Izhod piši: ['Object link re-attached.'], nova-vrstica.
}.
Izhod piši: ( b item ), nova-vrstica.
