Izhod piši: ((Seznam nov
	ob: ['plaque:'] izvedi: { :x svoj o := x. },
	ob: ['plaque']  izvedi: { <- svoj o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Seznam ← 1)
	~ (Seznam ← 1 ; 2)
	~ (Seznam ← 1 ; 2 ; 3)
	~ (Seznam ← 1 ; 2 ; 3 ; 4)
	~ (Seznam ← 1 ; 2 ; 3 ; 4 ; 5)
) vsak: { :i :el
	{ Izhod piši: ta-naloga. } × el število-elementov.
	Izhod nova-vrstica.
}) plaque, nova-vrstica.


