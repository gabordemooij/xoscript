# test catch-all methods
>> x13 := Objekt nov.
x13 ob: ['a'] izvedi: { :a Izhod piši: 0, nova-vrstica. }.
x13 ob: ['a:'] izvedi: { :a Izhod piši: a, nova-vrstica. <- 5. }.
x13 ob: ['a:b:'] izvedi: { :a :b Izhod piši: (a + b), nova-vrstica. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
