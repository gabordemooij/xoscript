

# create a 64-bit integer for exact calculations
>> a := Int64 iz-besedila: ['123'].

# to string
Izhod piši: a, nova-vrstica.

# divide
Izhod piši: a / (Int64 iz-besedila: ['3']), nova-vrstica.

# multiply
Izhod piši: a * (Int64 iz-besedila: ['2']), nova-vrstica.

# add
Izhod piši: a + (Int64 iz-besedila: ['1']), nova-vrstica.

# subtract
Izhod piši: a - (Int64 iz-besedila: ['2']), nova-vrstica.

# compare
Izhod piši: ( a =   (Int64 iz-besedila: ['123'])), nova-vrstica.
Izhod piši: ( a !=: (Int64 iz-besedila: ['124'])), nova-vrstica.
Izhod piši: ( a <   (Int64 iz-besedila: ['124'])), nova-vrstica.
Izhod piši: ( a >   (Int64 iz-besedila: ['122'])), nova-vrstica.
Izhod piši: ( a >=: (Int64 iz-besedila: ['123'])), nova-vrstica.
Izhod piši: ( a <=: (Int64 iz-besedila: ['123'])), nova-vrstica.





	