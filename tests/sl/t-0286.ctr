['Tisočice in decimalke'].

>> x := 100000000.5.
>> y := 100000000.5.

Izhod piši: (x + y), nova-vrstica.

>> x := 10040.07.
>> y := 10305.60.

Izhod piši: (x + y), nova-vrstica.

['Decimalno'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Izhod piši: (x + y + z), nova-vrstica.

['Čudno, a veljavno'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Izhod piši: (x + y + z), nova-vrstica.

>> q := 0.1.2.

Izhod piši: (q), nova-vrstica.

>> q := 012.

Izhod piši: (q), nova-vrstica.
