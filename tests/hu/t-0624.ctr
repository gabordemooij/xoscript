# Ez a teszt ellenőrzi, hogy a string_fill_in nem veszíti-e el a helyét (gc'ed) 4-es módban
# hivatkozás a world.c-ben
>> Napló := Objektum új.

Napló ha: ['say:'] tedd: { :str
	Kimenet ír: str, újsor.
}.

>> Tétel := Objektum új.

Tétel ha: ['új:'] tedd: { :id
	<- maga új id: id.
}.

Tétel ha: ['id:'] tedd: { :id
	saját id := id.
}.

Tétel ha: ['id'] tedd: { <- saját id. }.


Tétel ha: ['szöveg'] tedd: {
	>> str := ['Item#~no'].
	str ~no: saját id.
	<- str.
}.


>> Print := Objektum új.

Print ha: ['items'] tedd: { 
	
	saját tétel := Tétel új: 1.
	
	# vagy segfault, vagy hibás str itt
	Napló say: (
		['~item printed.'] ~item: saját tétel
	).
	
	
}.

Print items.