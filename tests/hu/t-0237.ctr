
Szöveg ha: ['kiértékel'] tedd: {
	>> kód := Fájl új: ['/tmp/eval.ctr'].
	kód ír: (maga szöveg + ['.']).
	Program használ: ['/tmp/eval.ctr'].
}.

>> map :=
	(Szótár új)
	tesz: ['Szia Mindenki'] ide: ['two'],
	tesz: (Lista ← ['hello'] ; ['world'] ; (Lista ← 1 ; 2; 9) ; Hamis) ide: ['egy'],
	tesz: ( (Szótár új) tesz: ['vilg'] ide: ['elírva'] ) ide: ['three'],
	tesz: (Lista ← ((Szótár új) tesz: ['kincs'] ide: ['rejtett']) ; 2) ide: ['négy']. 
>> str := map szöveg.
>> map2 := Semmi.
(['map2 := '] + str ) kiértékel.
Kimenet ír: map2 ? ['egy'] ? 0.
Kimenet ír: map2 ? ['egy'] ? 1.
Kimenet ír: map2 ? ['négy'] ? 0 ? ['rejtett'].
Kimenet ír: map2 ? ['egy'] ? 2 ? 2.
