
Szöveg ha: ['evaluate'] tedd: {
	>> kód := Fájl új: ['/tmp/eval.ctr'].
	kód ír: (maga szöveg + ['.']).
	Program használ: ['/tmp/eval.ctr'].
}.

>> map :=
	(Szótár új)
	tesz: ['Hi There'] ide: ['two'],
	tesz: (Lista ← ['hello'] ; ['world'] ; (Lista ← 1 ; 2; 9) ; Hamis) ide: ['one'],
	tesz: ( (Szótár új) tesz: ['wrrld'] ide: ['misspelled'] ) ide: ['three'],
	tesz: (Lista ← ((Szótár új) tesz: ['treasure'] ide: ['hidden']) ; 2) ide: ['four']. 
>> str := map szöveg.
>> map2 := Semmi.
(['map2 := '] + str ) evaluate.
Kimenet ír: map2 ? ['one'] ? 0.
Kimenet ír: map2 ? ['one'] ? 1.
Kimenet ír: map2 ? ['four'] ? 0 ? ['hidden'].
Kimenet ír: map2 ? ['one'] ? 2 ? 2.
