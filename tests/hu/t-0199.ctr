
Program memóriakezelés: 4.

>> Animal := Objektum új.
Animal ha: ['make'] tedd: {
	>> animal := Objektum új.
	animal ha: ['makeSound'] tedd: {
		Kimenet ír: saját sound.
	}. <- animal.
}.
>> Cat := Objektum új.
Cat ha: ['make'] tedd: {
	>> cat := Animal make.
	cat ha: ['init'] tedd: {
		saját sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
