#Linux

(Fájl új: ['/tmp/testje']) létezik hamis: {
	Program rendszer: ['mkdir /tmp/testje'].	
}.

(Fájl új: ['/tmp/testje/file1']) létezik hamis: {
	Program rendszer: ['touch /tmp/testje/file1'].	
}.

(Fájl új: ['/tmp/testje/folder1']) létezik hamis: {
	Program rendszer: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Fájl lista: ['/tmp/testje'].

>> q := Lista új.

l mindegyik: { :k :v v mindegyik: { :x :y q hozzáfűz: y. }. }.

>> s := q szöveg.

(s tartalmazza: ['file1']) igaz:   { Kimenet ír: ['OK'], újsor. }.
(s tartalmazza: ['file2']) igaz:   { Kimenet ír: ['XX'], újsor. }.
(s tartalmazza: ['folder1']) igaz: { Kimenet ír: ['OK'], újsor. }.
