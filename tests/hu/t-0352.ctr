Szám ha: ['roman'] tedd: {
	>> szám := maga másol.
	>> roman := [''].
	{
		{
			(szám ≥ 1000) igaz: {
				roman hozzáfűz: ['Ⅿ'].
				szám kivon: 1000.
			}, megszakít.
		
			(szám ≥ 500) igaz: {
				roman hozzáfűz: ['Ⅾ'].
				szám kivon: 500.
			}, megszakít.
		
			(szám ≥ 100) igaz: {
				roman hozzáfűz: ['Ⅽ'].
				szám kivon: 100.
			}, megszakít.
		
			(szám ≥ 50) igaz: {
				roman hozzáfűz: ['Ⅼ'].
				szám kivon: 50.
			}, megszakít.
		
			(szám ≥ 50) igaz: {
				roman hozzáfűz: ['Ⅼ'].
				szám kivon: 50.
			}, megszakít.
		
			(szám ≥ 10) igaz: {
				roman hozzáfűz: ['Ⅹ'].
				szám kivon: 10.
			}, megszakít.
			
			(szám ≥ 9) igaz: {
				roman hozzáfűz: ['Ⅸ'].
				szám kivon: 9.
			}, megszakít.
			
			(szám ≥ 5) igaz: {
				roman hozzáfűz: ['Ⅴ'].
				szám kivon: 5.
			}, megszakít.
			
			(szám ≥ 4) igaz: {
				roman hozzáfűz: ['Ⅳ'].
				szám kivon: 4.
			}, megszakít.
			
			(szám ≥ 1) igaz: {
				roman hozzáfűz: ['Ⅰ'].
				szám kivon: 1.
			}, megszakít.
		} eljárás.
	} míg: { <- szám > 0. }. <- roman.
}.

Kimenet ír: 1 roman, újsor.
Kimenet ír: 2 roman, újsor.
Kimenet ír: 4 roman, újsor.
Kimenet ír: 8 roman, újsor.
Kimenet ír: 16 roman, újsor.
Kimenet ír: 32 roman, újsor.
Kimenet ír: 64 roman, újsor.
Kimenet ír: 128 roman, újsor.
Kimenet ír: 256 roman, újsor.
Kimenet ír: 1024 roman, újsor.
