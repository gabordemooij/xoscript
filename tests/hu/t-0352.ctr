Szám ha: ['római'] tedd: {
	>> szám := maga másol.
	>> római := [''].
	{
		{
			(szám ≥ 1000) igaz: {
				római hozzáfűz: ['Ⅿ'].
				szám kivon: 1000.
			}, megszakít.
		
			(szám ≥ 500) igaz: {
				római hozzáfűz: ['Ⅾ'].
				szám kivon: 500.
			}, megszakít.
		
			(szám ≥ 100) igaz: {
				római hozzáfűz: ['Ⅽ'].
				szám kivon: 100.
			}, megszakít.
		
			(szám ≥ 50) igaz: {
				római hozzáfűz: ['Ⅼ'].
				szám kivon: 50.
			}, megszakít.
		
			(szám ≥ 50) igaz: {
				római hozzáfűz: ['Ⅼ'].
				szám kivon: 50.
			}, megszakít.
		
			(szám ≥ 10) igaz: {
				római hozzáfűz: ['Ⅹ'].
				szám kivon: 10.
			}, megszakít.
			
			(szám ≥ 9) igaz: {
				római hozzáfűz: ['Ⅸ'].
				szám kivon: 9.
			}, megszakít.
			
			(szám ≥ 5) igaz: {
				római hozzáfűz: ['Ⅴ'].
				szám kivon: 5.
			}, megszakít.
			
			(szám ≥ 4) igaz: {
				római hozzáfűz: ['Ⅳ'].
				szám kivon: 4.
			}, megszakít.
			
			(szám ≥ 1) igaz: {
				római hozzáfűz: ['Ⅰ'].
				szám kivon: 1.
			}, megszakít.
		} eljárás.
	} míg: { <- szám > 0. }. <- római.
}.

Kimenet ír: 1 római, újsor.
Kimenet ír: 2 római, újsor.
Kimenet ír: 4 római, újsor.
Kimenet ír: 8 római, újsor.
Kimenet ír: 16 római, újsor.
Kimenet ír: 32 római, újsor.
Kimenet ír: 64 római, újsor.
Kimenet ír: 128 római, újsor.
Kimenet ír: 256 római, újsor.
Kimenet ír: 1024 római, újsor.
