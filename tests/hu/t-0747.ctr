Kimenet ír: ['Test object'], újsor.
>> a := Objektum új. 

a ha: ['item:'] tedd: { :num
	saját num := num. 
}.

a ha: ['item'] tedd: { <- saját num.
}.

a item: 123.

Kimenet ír: a item, újsor.

>> old-num-address := a item prototípus memóriacím.
a save-as: ['/tmp/a.bin'].
Kimenet ír: ['========== RELOADING SNAP:'], újsor.

>> b := Objektum load-from: ['/tmp/a.bin'].

(b item prototípus memóriacím = old-num-address) igaz: {
	Kimenet ír: ['Object link re-attached.'], újsor.
}.

Kimenet ír: b item, újsor.
