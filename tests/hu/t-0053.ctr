60 × {
	>> x := (Szám véletlenszerű % 6) + 1.
	(x ≤ 6) hamis: { Kimenet ír: ['HIBA']. }.
	(x ≥0) hamis: { Kimenet ír: ['HIBA']. }.
	x := (Szám véletlenszerű % 3) + 1.
	(x < 3) hamis: { Kimenet ír: ['HIBA']. }.
	(x>-1) hamis: { Kimenet ír: ['HIBA']. }.
	x := ((Logikai feldob) szám).
	(x = 0 vagy: x = 1) hamis: { Kimenet ír: ['HIBA']. }.
	x := ((Igaz feldob) szám).
	(x = 0 vagy: x = 1) hamis: { Kimenet ír: ['HIBA']. }.
	x := (Logikai feldob vagy: ['FEJ'] vagy: ['ÍRÁS']).
	((x = ['FEJ']) vagy: (x = ['ÍRÁS'])) hamis: { Kimenet ír: ['HIBA']. }.
}.
Kimenet ír: ['KÉSZ'].

