60 × {
	>> x := (Szám random % 6) + 1.
	(x ≤ 6) hamis: { Kimenet ír: ['FAIL']. }.
	(x ≥0) hamis: { Kimenet ír: ['FAIL']. }.
	x := (Szám random % 3) + 1.
	(x < 3) hamis: { Kimenet ír: ['FAIL']. }.
	(x>-1) hamis: { Kimenet ír: ['FAIL']. }.
	x := ((Logikai flip) szám).
	(x = 0 vagy: x = 1) hamis: { Kimenet ír: ['FAIL']. }.
	x := ((Igaz flip) szám).
	(x = 0 vagy: x = 1) hamis: { Kimenet ír: ['FAIL']. }.
	x := (Logikai flip vagy: ['HEAD'] vagy: ['TAIL']).
	((x = ['HEAD']) vagy: (x = ['TAIL'])) hamis: { Kimenet ír: ['FAIL']. }.
}.
Kimenet ír: ['DONE'].

