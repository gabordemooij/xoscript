Szám ha: ['factorial'] tedd: {
	>> total := 1.
	{ :index total szoroz: (maga - (index)). } × maga. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Kimenet ír: a.
>> b := 2 + 3 factorial.
Kimenet ír: b.
>> c := 3 factorial + 2.
Kimenet ír: c.
>> d := 2 + (3 factorial).
Kimenet ír: d.
Kimenet ír: 2 + 3 factorial + 1.
