Szám ha: ['faktoriális'] tedd: {
	>> végösszeg := 1.
	{ :index végösszeg szoroz: (maga - (index)). } × maga. <- végösszeg.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Kimenet ír: a.
>> b := 2 + 3 faktoriális.
Kimenet ír: b.
>> c := 3 faktoriális + 2.
Kimenet ír: c.
>> d := 2 + (3 faktoriális).
Kimenet ír: d.
Kimenet ír: 2 + 3 faktoriális + 1.
