Server init.

Kimenet ír: (
	Minta új: ['^\\w+$'],
	egyezés: ['test@example.com'] 
), újsor. # 0 match, fails on @ and .

Kimenet ír: (
	Minta új: ['^[^@]+@[^\.]+\.\\w+$'],
	egyezés: ['test@example.com'] 
), újsor. # 1 match

Kimenet ír: (
	Minta új: ['[^@]+@[^\.]+\.\\w+'],
	egyezés: ['test@example.com'] 
), újsor. # 1 match

Kimenet ír: (
	Minta új: ['([^@]+)@([^\.]+)\.\\w+'],
	egyezés: ['test@example.com'] 
), újsor. # 1 match, groups dont matter

Kimenet ír: (
	Minta új: ['[a-z]'],
	egyezés: ['test@example.com'] 
), újsor. # 14 matches

Kimenet ír: (
	Minta új: ['.*'],
	egyezés: ['test@example.com'] 
), újsor. # 1 match (all)

Kimenet ír: (
	Minta új: ['(.*)'],
	egyezés: ['test@example.com'] 
), újsor. # 1 match (all)

Kimenet ír: (
	Minta új: ['\\s*[^@]+@[^\.]+\.\\w+'],
	egyezés: ['test@example.com'] 
), újsor. # 1 match, prefix space optional, gets ignored