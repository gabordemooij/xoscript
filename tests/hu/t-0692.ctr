Server init.

Kimenet ír: (
	Minta új: ['^\\w+$'],
	egyezés: ['test@example.com'] 
), újsor. # 0 egyezés, elbukik a @ és a . karakteren

Kimenet ír: (
	Minta új: ['^[^@]+@[^\.]+\.\\w+$'],
	egyezés: ['test@example.com'] 
), újsor. # 1 egyezés

Kimenet ír: (
	Minta új: ['[^@]+@[^\.]+\.\\w+'],
	egyezés: ['test@example.com'] 
), újsor. # 1 egyezés

Kimenet ír: (
	Minta új: ['([^@]+)@([^\.]+)\.\\w+'],
	egyezés: ['test@example.com'] 
), újsor. # 1 egyezés, a csoportok nem számítanak

Kimenet ír: (
	Minta új: ['[a-z]'],
	egyezés: ['test@example.com'] 
), újsor. # 14 egyezés

Kimenet ír: (
	Minta új: ['.*'],
	egyezés: ['test@example.com'] 
), újsor. # 1 egyezés (mind)

Kimenet ír: (
	Minta új: ['(.*)'],
	egyezés: ['test@example.com'] 
), újsor. # 1 egyezés (mind)

Kimenet ír: (
	Minta új: ['\\s*[^@]+@[^\.]+\.\\w+'],
	egyezés: ['test@example.com'] 
), újsor. # 1 egyezés, az előtag-szóköz opcionális, figyelmen kívül marad