# test catch-all methods
>> x13 := Objektum új.
x13 ha: ['a'] tedd: { :a Kimenet ír: 0, újsor. }.
x13 ha: ['a:'] tedd: { :a Kimenet ír: a, újsor. <- 5. }.
x13 ha: ['a:b:'] tedd: { :a :b Kimenet ír: (a + b), újsor. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
