

>> obj := Objektum új.

obj ha: ['üdvözöl'] tedd: {
	<- ['szia'].
}.

# a kimenetnek hi123hi123ok kell lennie
obj ha: ['feladat'] tedd: {
	saját tulajdonság := 123.
	{
		# a try a self/own-t az objektumhoz köti a blokk helyett
		Kimenet ír: maga üdvözöl.
		Kimenet ír: saját tulajdonság.
		1 / 0.
	} elkap: {
		Kimenet ír: maga üdvözöl.
		Kimenet ír: saját tulajdonság.
		Kimenet ír: ['ok'].
	}, próbál.
}.

obj feladat.