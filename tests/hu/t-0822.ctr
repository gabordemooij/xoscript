# a helyőrzőknél kevesebb paraméter hibát kell adjon, nem olvashat a kötéseken túl
Server init.

>> adb := Maria-DB új gazdagép: ['localhost'],
	felhasználónév: ['xo'],
	jelszó: ['pass123'],
	adatbázisnév: ['xobase'],
	csatlakozik.

>> keresőparaméterek := adb lekérdezés: ['SELECT ? AS a, ? AS b, ? AS c'].
keresőparaméterek paraméterek: (Lista új ; ['1']).
{ keresőparaméterek lekér: { :sorAdat Kimenet ír: sorAdat, újsor. }. } elkap: { :e Kimenet ír: e, újsor. }, indít.

>> keresőparaméterek := adb lekérdezés: ['SELECT ? AS a'].
{ keresőparaméterek lekér: { :sorAdat Kimenet ír: sorAdat, újsor. }. } elkap: { :e Kimenet ír: e, újsor. }, indít.

# a megfelelő szám továbbra is működik, a több paramétert a korábbiakhoz hasonlóan figyelmen kívül hagyja
>> keresőparaméterek := adb lekérdezés: ['SELECT ? AS a, ? AS b'].
keresőparaméterek paraméterek: (Lista új ; ['1'] ; ['2']).
keresőparaméterek lekér: { :sorAdat Kimenet ír: (sorAdat itt: ['a']), ír: (sorAdat itt: ['b']), újsor. }.
keresőparaméterek paraméterek: (Lista új ; ['1'] ; ['2'] ; ['3']).
keresőparaméterek lekér: { :sorAdat Kimenet ír: (sorAdat itt: ['a']), ír: (sorAdat itt: ['b']), újsor. }.
