#Linux
>> Slurp := Objektum új.

Slurp ha: ['új'] tedd: {
	saját str := [''].
}.

Slurp ha: ['nieuw'] tedd: {
	saját str := [''].
}.

Slurp ha: ['válaszol:'] tedd: { :blah
		saját str hozzáfűz: blah.
}.

Slurp ha: ['válaszol:és:'] tedd: { :blah :blahah
		saját str hozzáfűz: (blah ettől: 0 hossz: (blah hossz - 1)).
		saját str hozzáfűz: [' '].
		saját str hozzáfűz: blahah.
}.

Slurp ha: ['obtain'] tedd: {
	>> buffer := saját str.
	saját str := ['']. <- buffer.
}.


Kimenet ír: (Program rendszer: (Slurp új echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Fájl új: ['/tmp/from.txt'], töröl. } elkap: { ['Empty']. }, indít.
{ Fájl új: ['/tmp/to.txt'], töröl. } elkap: { ['Empty']. }, indít.


Fájl új: ['/tmp/to.txt'], létezik hamis: {
	Kimenet ír: ['Confirmed. Target file does not exist.\
'].
}.
Fájl új: ['/tmp/from.txt'], létezik hamis: {
	Kimenet ír: ['Confirmed. Source file does not exist.\
'].
}.



Program rendszer: (Slurp új touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Program rendszer: (Slurp új cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Fájl új: ['/tmp/to.txt'], létezik igaz: {
	Kimenet ír: ['Confirmed. Target file has been created by shell.\
'].
}.


Kimenet ír: ['Contents of file is:'] + (Fájl új: ['/tmp/to.txt'], olvas), újsor.
