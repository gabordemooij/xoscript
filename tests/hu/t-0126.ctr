#Linux
>> Szürcsölő := Objektum új.

Szürcsölő ha: ['új'] tedd: {
	saját str := [''].
}.

Szürcsölő ha: ['nieuw'] tedd: {
	saját str := [''].
}.

Szürcsölő ha: ['válaszol:'] tedd: { :blah
		saját str hozzáfűz: blah.
}.

Szürcsölő ha: ['válaszol:és:'] tedd: { :blah :blahah
		saját str hozzáfűz: (blah ettől: 0 hossz: (blah hossz - 1)).
		saját str hozzáfűz: [' '].
		saját str hozzáfűz: blahah.
}.

Szürcsölő ha: ['megszerez'] tedd: {
	>> puffer := saját str.
	saját str := ['']. <- puffer.
}.


Kimenet ír: (Program rendszer: (Szürcsölő új echo: ['Helló, tudok írni a konzolra fluid API-val!'], megszerez)).


{ Fájl új: ['/tmp/from.txt'], töröl. } elkap: { ['Üres']. }, indít.
{ Fájl új: ['/tmp/to.txt'], töröl. } elkap: { ['Üres']. }, indít.


Fájl új: ['/tmp/to.txt'], létezik hamis: {
	Kimenet ír: ['Confirmed. Target file does not exist.\
'].
}.
Fájl új: ['/tmp/from.txt'], létezik hamis: {
	Kimenet ír: ['Confirmed. Source file does not exist.\
'].
}.



Program rendszer: (Szürcsölő új touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], megszerez).



Program rendszer: (Szürcsölő új cp: ['/tmp/from.txt /tmp/to.txt'], megszerez).

Fájl új: ['/tmp/to.txt'], létezik igaz: {
	Kimenet ír: ['Confirmed. Target file has been created by shell.\
'].
}.


Kimenet ír: ['A fájl tartalma:'] + (Fájl új: ['/tmp/to.txt'], olvas), újsor.
