#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Minta új: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern egyezés: subject tedd: { :m :x
	Kimenet ír: m, újsor.
	Kimenet ír: x, újsor. <- ['XXX'].
}.
Kimenet ír: result, újsor.