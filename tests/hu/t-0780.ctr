Server init.

# a JSON-kódoló csak UTF-8-at támogat, helyettesítő párokat nem

>> szótárak := Lista új ;
	# {"key":"normal"} normál ASCII
	( Szótár új tesz: ['normál'] ide: ['key'] ) ;
	# {"key":"hello world"} szóköz karakter
	( Szótár új tesz: ['hello world'] ide: ['key'] ) ;
	# {"key":"quote: \""} dupla idézőjel
	( Szótár új tesz: ['"'] ide: ['key'] ) ;
	# {"key":"backslash: \\"} fordított perjel
	( Szótár új tesz: ['backslash: \\'] ide: ['key'] ) ;
	# {"key":"slash: /"} perjel
	( Szótár új tesz: ['perjel: /'] ide: ['key'] ) ;
	# {"key":"backspace: \b"} visszatörlés
	( Szótár új tesz: ['backspace: \b'] ide: ['key'] ) ;
	# {"key":"formfeed: \f"} lapdobás escape
	( Szótár új tesz: ['formfeed: \f'] ide: ['key'] ) ;
	# {"key":"newline: \n"} újsor
	( Szótár új tesz: ['newline: \n'] ide: ['key'] ) ;
	( Szótár új tesz: ['newline: ↵'] ide: ['key'] ) ;
	( Szótár új tesz: ['newline: 
	'] ide: ['key'] ) ;
	# {"key":"carriage return: \r"} kocsivissza
	( Szótár új tesz: ['carriage return: \r'] ide: ['key'] ) ;
	# {"key":"tab: \t"} tabulátor
	( Szótár új tesz: ['tab \t'] ide: ['key'] ) ;
	( Szótár új tesz: ['tab ⇿'] ide: ['key'] ) ;
	( Szótár új tesz: ['tabulátor  '] ide: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( Szótár új tesz: ['NUL \u0000'] ide: ['key'] ) ;
	( Szótár új tesz: ['NUL \0'] ide: ['key'] ) ;
	# {"key":"control: \u0001"} 0x01 vezérlőkarakter
	( Szótár új tesz: ['control: \u0001'] ide: ['key'] ) ;
	# {"key":"control: \u001F"} 0x1F vezérlőkarakter
	( Szótár új tesz: ['control: \u001F'] ide: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2 bájtos karakter
	( Szótár új tesz: ['unicode: é'] ide: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3 bájtos karakter
	( Szótár új tesz: ['unicode: €'] ide: ['key'] ) ;
	# {"key":"unicode: 日本語"} több 3 bájtos UTF-8 karakter
	( Szótár új tesz: ['unicode: 日本語'] ide: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4 bájtos karakter
	( Szótár új tesz: ['unicode: 😀'] ide: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + nulla szélességű összekötő
	( Szótár új tesz: ['unicode: 🧑‍💻'] ide: ['key'] ) ;
	# {"key":"combining: é"} kombináló ékezet
	( Szótár új tesz: ['combining: e\u0301'] ide: ['key'] ) ;
	# {"key":"escaped unicode: é"} Unicode escape BMP
	( Szótár új tesz: ['escaped unicode: \u00e9'] ide: ['key'] ) ;
	# {"key":"escaped unicode: €"} Unicode escape BMP
	( Szótár új tesz: ['escaped unicode: \u20ac'] ide: ['key'] ) ;
	# {"key":"escaped unicode: 😀"} UTF-16 helyettesítő pár
	( Szótár új tesz: ['escaped unicode: \ud83d\ude00'] ide: ['key'] ) ;
	# {"key":""} üres érték
	( Szótár új tesz: [''] ide: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} speciális ASCII karakterek
	( Szótár új tesz: ['@ < > & = % + ? #'] ide: ['key'] ) ;
	# {"key":"single quote: '"} szimpla idézőjel
	( Szótár új tesz: ['''] ide: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} több JSON escape
	( Szótár új tesz: ['multiple: \" \\ \n \r \t'] ide: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} hosszabb ASCII szöveg
	( Szótár új tesz: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] ide: ['key'] ) ;
	# {"key":" value"} kezdő szóköz
	( Szótár új tesz: [' érték'] ide: ['key'] ) ;
	# {"key":"value "} záró szóköz
	( Szótár új tesz: ['érték '] ide: ['key'] ) ;
	# {"key":" \t\n\r "} szóköz jellegű karakterek
	( Szótár új tesz: [' \t\n\r '] ide: ['key'] )
	.

szótárak mindegyik: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (Szótár új tesz: d key ide: ['key']).
	>> b := JSON jsonify: (Szótár új tesz: ['value'] ide: d key).
	>> e := JSON objektum: a.
	>> f := JSON objektum: b.
	((e key = d key és: (f ? d key = ['value'])) vagy: (e key = ['NUL ?'])) igaz: {
		Kimenet ír: ['OK'], újsor.
	}, különben: {
		Kimenet ír: ['Nem sikerült helyesen kódolni/dekódolni: '] + d + j, újsor.
		Program vége.
	}.
}.
