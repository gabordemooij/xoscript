# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Program beállítás: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server összekapcsol: ( Lista új ;
 libname ; ['fopen'] ;
 ( Lista új ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
összekapcsol: ( Lista új ;
 Semmi ; # means same lib
 ['fread'] ;
 ( Lista új ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Semmi ; # means same object (i.e. Stream)
 ['fread']
),
összekapcsol: (
 Lista új ;
 Semmi ; # means same lib
 ['fwrite'] ;
 ( Lista új ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Semmi ; # means same lib
 ['fwrite']
),
összekapcsol: (
 Lista új ;
 Semmi ; # means same lib
 ['rewind'] ;
 ( Lista új ; ['pointer'] ) ;
 ['int'] ;
 Semmi ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> útvonal := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: útvonal mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream üzenet: ['fwrite'] érvek: (Lista új ; str ; 1 ; 6 ; fd ).
Kimenet ír: bytes-written, újsor.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob új: 20.

# read from file
>> bytes-read := Stream üzenet: ['fread'] érvek: (Lista új ; buf ; 1 ; 6 ; fd ).
Kimenet ír: bytes-read, újsor.
Kimenet ír: buf, újsor.

# free memory
str  felszabadít.
útvonal felszabadít.
mode felszabadít.
buf  felszabadít.


