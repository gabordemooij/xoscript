# FFI használata a Server bővítménnyel

# csatlakozás a libc-hez (platformfüggő)
>> könyvtárfájlnév := Program beállítás: ['FFITESTLIB'].

# stdio függvények összekapcsolása C-ből haladó fájlműveletekhez
Server összekapcsol: ( Lista új ;
 könyvtárfájlnév ; ['fopen'] ;
 ( Lista új ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
összekapcsol: ( Lista új ;
 Semmi ; # ugyanaz a könyvtár
 ['fread'] ;
 ( Lista új ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Semmi ; # ugyanaz az objektum (azaz Stream)
 ['fread']
),
összekapcsol: (
 Lista új ;
 Semmi ; # ugyanaz a könyvtár
 ['fwrite'] ;
 ( Lista új ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Semmi ; # ugyanaz a könyvtár
 ['fwrite']
),
összekapcsol: (
 Lista új ;
 Semmi ; # ugyanaz a könyvtár
 ['rewind'] ;
 ( Lista új ; ['pointer'] ) ;
 ['int'] ;
 Semmi ; # ugyanaz a könyvtár
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> útvonal := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# fájl megnyitása fopen(path, mode) hívással
>> fd := Stream path: útvonal mode: mode.

# bájtok írása a str pufferből a fájlba
>> kiírt-bájtok := Stream üzenet: ['fwrite'] érvek: (Lista új ; str ; 1 ; 6 ; fd ).
Kimenet ír: kiírt-bájtok, újsor.

# fájlmutató visszatekerése
Stream rewind: fd.

# puffer lefoglalása
>> puf := Blob új: 20.

# olvasás a fájlból
>> olvasott-bájtok := Stream üzenet: ['fread'] érvek: (Lista új ; puf ; 1 ; 6 ; fd ).
Kimenet ír: olvasott-bájtok, újsor.
Kimenet ír: puf, újsor.

# memória felszabadítása
str  felszabadít.
útvonal felszabadít.
mode felszabadít.
puf  felszabadít.


