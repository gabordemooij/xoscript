Kimenet ír: ['Test object'], újsor.
>> a := Objektum új. 

a ha: ['item:'] tedd: { :logikai
	saját logikai := logikai. 
}.

a ha: ['item'] tedd: { <- saját logikai.
}.

a item: Igaz.

Kimenet ír: a item, újsor.

>> old-bool-address := a item prototípus memóriacím.
a save-as: ['/tmp/a.bin'].
Kimenet ír: ['========== RELOADING SNAP:'], újsor.

>> b := Objektum load-from: ['/tmp/a.bin'].

(b item prototípus memóriacím = old-bool-address) igaz: {
	Kimenet ír: ['Object link re-attached.'], újsor.
}.

Kimenet ír: b item, újsor.
