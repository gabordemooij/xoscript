# listaműveletek tesztje


>> sütemények := Lista ←
	['apple'] ;
	['gyümölcsös'] ;
	['csokis'] ;
	['sajtos'].


>> vétel := sütemények csere: 1 hossz: 2 erre: ( Lista ← ['fahéjas'] ; ['ananászos'] ).
Kimenet ír: (vétel összefűz: [',']), újsor.


>> vétel := sütemények csere: 1 hossz: 12 erre: ( Lista ← ['fahéjas'] ; ['ananászos'] ).
Kimenet ír: (vétel összefűz: [',']), újsor.


>> vétel := sütemények csere: 2 hossz: 10 erre: ( Lista új ).
Kimenet ír: (vétel összefűz: [',']), újsor.


>> vétel := sütemények csere: 0 hossz: 1 erre: ( Lista új ).
Kimenet ír: (vétel összefűz: [',']), újsor.


>> vétel := sütemények csere: ['0'] hossz: ['1'] erre: ['x'].
Kimenet ír: (vétel összefűz: [',']), újsor.
