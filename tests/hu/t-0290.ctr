# test list operations


>> cakes := Lista ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes csere: 1 hossz: 2 erre: ( Lista ← ['cinnamon'] ; ['pineapple'] ).
Kimenet ír: (buy összefűz: [',']), újsor.


>> buy := cakes csere: 1 hossz: 12 erre: ( Lista ← ['cinnamon'] ; ['pineapple'] ).
Kimenet ír: (buy összefűz: [',']), újsor.


>> buy := cakes csere: 2 hossz: 10 erre: ( Lista új ).
Kimenet ír: (buy összefűz: [',']), újsor.


>> buy := cakes csere: 0 hossz: 1 erre: ( Lista új ).
Kimenet ír: (buy összefűz: [',']), újsor.


>> buy := cakes csere: ['0'] hossz: ['1'] erre: ['x'].
Kimenet ír: (buy összefűz: [',']), újsor.
