# a túl hosszúra dekódolódó széfkulcsok és aláírások nem csordulhatnak túl a vermen
Server init.

>> kulcsok := Széf kulcsokat-generál.
>> tk := kulcsok első.
>> nk := kulcsok utolsó.
>> aláírás := Széf aláír: ['abc'] kulccsal: tk.

# 88 karakter kitöltés nélkül 66 bájtra dekódolódik
>> hosszú := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 karakter kitöltés nélkül 33 bájtra dekódolódik
>> rövid := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Széf aláír: ['abc'] kulccsal: hosszú. } elkap: { :e
	Kimenet ír: e, újsor.
}, indít.

{ Széf ellenőriz: ['abc'] aláírás: hosszú kulccsal: nk. } elkap: { :e
	Kimenet ír: e, újsor.
}, indít.

{ Széf ellenőriz: ['abc'] aláírás: aláírás kulccsal: rövid. } elkap: { :e
	Kimenet ír: e, újsor.
}, indít.
