#Linux
>> clock := Pillanat új.
clock zóna: ['UTC-1'].
clock év: 1981, hónap: 1, nap: 5,
      óra: 13, perc: 15, másodperc: 13.

Kimenet ír: clock, újsor.
clock zóna: ['UTC+0'].

Kimenet ír: (
	(clock év nyers) + ['-'] + (clock hónap) + ['-'] + (clock nap) + [' '] +
	(clock óra) + [':'] + (clock perc) + [':'] + (clock másodperc) + [' '] +
	['W'] + (clock hét) + (clock zóna)
), újsor.


clock zóna: ['UTC-1'].
Kimenet ír: (
	(clock év nyers) + ['-'] + (clock hónap) + ['-'] + (clock nap) + [' '] +
	(clock óra) + [':'] + (clock perc) + [':'] + (clock másodperc) + [' '] +
	['W'] + (clock hét) + (clock zóna)
), újsor.
