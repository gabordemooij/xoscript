#Linux
>> falióra := Pillanat új.
falióra zóna: ['UTC-1'].
falióra év: 1981, hónap: 1, nap: 5,
      óra: 13, perc: 15, másodperc: 13.

Kimenet ír: falióra, újsor.
falióra zóna: ['UTC+0'].

Kimenet ír: (
	(falióra év nyers) + ['-'] + (falióra hónap) + ['-'] + (falióra nap) + [' '] +
	(falióra óra) + [':'] + (falióra perc) + [':'] + (falióra másodperc) + [' '] +
	['W'] + (falióra hét) + (falióra zóna)
), újsor.


falióra zóna: ['UTC-1'].
Kimenet ír: (
	(falióra év nyers) + ['-'] + (falióra hónap) + ['-'] + (falióra nap) + [' '] +
	(falióra óra) + [':'] + (falióra perc) + [':'] + (falióra másodperc) + [' '] +
	['W'] + (falióra hét) + (falióra zóna)
), újsor.
