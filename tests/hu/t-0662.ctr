>> t := Semmi.

# you can control the time zone for
# parsing like this:
Pillanat zóna: ['CET'].
t := Pillanat ebből: ['1981-02-03 04:05:06'].
Kimenet ír: t, újsor.

# now using CEST time zone:
Pillanat zóna: ['CEST'].
t := Pillanat ebből: ['1981-02-03 04:05:06'].
Kimenet ír: t, újsor.

# error if string cannot be parsed
{ Pillanat ebből: ['1900']. } elkap: { Semmi. }, indít.
