>> Greeter := Objektum új.
Greeter ha: ['make'] tedd: {
	>> greeter := Objektum új.
	greeter ha: ['name:'] tedd: { :név
		Kimenet ír: ['setting a name'].
		saját myName := név.
	}.
	greeter ha: ['greet'] tedd: {
		Kimenet ír: ['Hello'].
		Kimenet ír: saját myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
