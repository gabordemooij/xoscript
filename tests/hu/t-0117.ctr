>> t := Igaz.
(t = Igaz) igaz: { Kimenet ír: ['T']. }.
(t = Hamis) igaz: { Kimenet ír: ['F']. }.
Kimenet ír: ['|'].
>> t := Hamis.
(t = Igaz) igaz: { Kimenet ír: ['T']. }.
(t = Hamis) igaz: { Kimenet ír: ['F']. }.
Kimenet ír: ['|'].
>> f := Igaz.
(t = Igaz és: f = Hamis) igaz: { Kimenet ír: ['T']. }.
(t = Hamis és: f = Igaz) igaz: { Kimenet ír: ['F']. }.
Kimenet ír: ['|'].
>> n := Semmi.
(n Semmi?) igaz: { Kimenet ír: ['T']. }.
(n Semmi?) hamis: { Kimenet ír: ['F']. }.
Kimenet ír: ['|'].
(f Boolean?) igaz: { Kimenet ír: ['T']. }.
(f Boolean?) hamis: { Kimenet ír: ['F']. }.



