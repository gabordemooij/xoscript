
>> Rectangle := Objektum új.

Rectangle ha: ['area'] tedd: { <- saját hossz * saját width.
}.

Rectangle ha: ['length:'] tedd: { :hossz
	saját hossz := hossz.
}.

Rectangle ha: ['width:'] tedd: { :width
	saját width := width.
}.

Rectangle ha: ['új'] tedd: {
	# this will not result into an infinite loop
	>> rectangle := maga új.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle új.
Kimenet ír: a area, újsor. #0

>> b := Rectangle új length: 2, width: 3.
Kimenet ír: b area, újsor. #6

