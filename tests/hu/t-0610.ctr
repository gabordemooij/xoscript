
>> Téglalap := Objektum új.

Téglalap ha: ['terület'] tedd: {
	<- saját hossz * saját szélesség.
}.

Téglalap ha: ['length:'] tedd: { :hossz
	saját hossz := hossz.
}.

Téglalap ha: ['width:'] tedd: { :szélesség
	saját szélesség := szélesség.
}.

Téglalap ha: ['új'] tedd: {
	# ez nem okoz végtelen ciklust
	>> téglalap := maga új.
	téglalap length: 0, width: 0.
	<- téglalap.
}.

>> a := Téglalap új.
Kimenet ír: a terület, újsor. #0

>> b := Téglalap új length: 2, width: 3.
Kimenet ír: b terület, újsor. #6

