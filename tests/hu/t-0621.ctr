>> phrases := Lista új
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases mindegyik: { :_ :phrase 
	>> e := Server base64-kódolás: phrase.
	>> d := Server base64-dekódolás: e.
	Kimenet ír: (
		message másol ~encoded: e, ~decoded: d
	), újsor.
}.
