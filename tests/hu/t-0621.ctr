>> kifejezések := Lista új
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> üzenetem := ['Phrase: ~decoded base64: ~encoded'].
	
kifejezések mindegyik: { :_ :kifejezés 
	>> e := Server base64-kódolás: kifejezés.
	>> d := Server base64-dekódolás: e.
	Kimenet ír: (
		üzenetem másol ~encoded: e, ~decoded: d
	), újsor.
}.
