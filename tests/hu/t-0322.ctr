

>> Matrjoska := Objektum új.
Matrjoska ha: ['double:'] tedd: { :titkos
	saját titkos := titkos × 2.
}.
Matrjoska ha: ['új:'] tedd: { :titkos
	>> felelet := Semmi.
	>> t := (titkos > 255).
	Kimenet ír: (titkos + [' | '] + t), újsor.
	t igaz: {
		felelet := titkos.
	}, különben: {
		felelet := Matrjoska rekurzív új: (maga double: titkos).
	}. <- felelet.
}.

>> x := Matrjoska új: 2.
