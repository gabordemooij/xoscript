

>> Matryoshka := Objektum új.
Matryoshka ha: ['double:'] tedd: { :secret
	saját secret := secret × 2.
}.
Matryoshka ha: ['új:'] tedd: { :secret
	>> answer := Semmi.
	>> t := (secret > 255).
	Kimenet ír: (secret + [' | '] + t), újsor.
	t igaz: {
		answer := secret.
	}, különben: {
		answer := Matryoshka rekurzív új: (maga double: secret).
	}. <- answer.
}.

>> x := Matryoshka új: 2.
