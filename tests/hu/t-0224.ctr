
>> countries := Lista új
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Lista új
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods szerint: countries, mindegyik: { :key :value
	counter hozzáad: 1.
}.

Kimenet ír: (['we serve counter dishes'] counter: counter), újsor.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] karakterek rendez: { :v
	counter hozzáad: 0.
}.

Kimenet ír: (['we sort counter dishes'] counter: counter), újsor.


>> counter := 0.
{
	{
		counter hozzáad: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Kimenet ír: (['we calculate counter numbers.'] counter: counter), újsor.

