>> Greeter := Objektum új.
Greeter ha: ['make'] tedd: {
	>> gr := Objektum új.
	gr ha: ['setName:'] tedd: { :aname
		saját név := aname.
	}.
	gr ha: ['greet'] tedd: {
		Kimenet ír: saját név.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a új.
c setName: ['THREE'].
c greet.
>> d := a új.
d setName: ['FOUR'].
d greet.
c greet.
