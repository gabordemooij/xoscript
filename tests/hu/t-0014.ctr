>> Üdvözlő := Objektum új.
Üdvözlő ha: ['készít'] tedd: {
	>> üdv := Objektum új.
	üdv ha: ['setName:'] tedd: { :egyNév
		saját név := egyNév.
	}.
	üdv ha: ['üdvözöl'] tedd: {
		Kimenet ír: saját név.
	}. <- üdv.
}.
>> a := Üdvözlő készít.
>> b := Üdvözlő készít.
a setName: ['EGY'].
b setName: ['KETTŐ'].
a üdvözöl.
b üdvözöl.
>> c := a új.
c setName: ['HÁROM'].
c üdvözöl.
>> d := a új.
d setName: ['NÉGY'].
d üdvözöl.
c üdvözöl.
