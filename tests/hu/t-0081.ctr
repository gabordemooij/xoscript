>> map1 := Szótár új.
>> key1 := Lista új.
>> key2 := Lista új.

map1
	tesz: ['hello'] ide: key1,
	tesz: ['world'] ide: key2.


Kimenet
	ír: ['Map #1 contains: '] + (map1 itt: key1),
	ír: [' and '] + (map1 itt: key2), újsor.

>> KeyeableArray := Lista új.
KeyeableArray ha: ['toString'] tedd: { <- (maga darabszám) toString.
}.

>> map2 := Szótár új.
key1 := KeyeableArray új.
key2 := KeyeableArray új.

key1 hozzáfűz: 1.

map2
	tesz: ['hello'] ide: key1,
	tesz: ['world'] ide: key2.

Kimenet
	ír: ['Map #2 contains: '] + (map2 itt: key1),
	ír: [' and '] + (map2 itt: key2), újsor.
