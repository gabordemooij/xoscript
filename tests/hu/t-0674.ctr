# szabályos eset
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> útvonal := ['/tmp/dat.csv'].
>> csv := Fájl új: útvonal.
csv ír: s.

# elfogad CRLF LF CR sorvégeket, változó sorhosszal
csv elválasztó: [';'] idézőjel: ['"'] sorok: { :line
	Program takarít.
	Kimenet ír: line, újsor.
	Program takarít.
}.

# egyenlőtlen sorok
s hozzáfűz: ['\njustone'].
csv ír: s.
{
	csv elválasztó: [';'] idézőjel: ['"'] sorok: { :line
		Kimenet ír: line, újsor.
	}.
} elkap: { :e 
	Kimenet ír: e, újsor.
}, indít.

# érvénytelen formátum
s := ['"he"llo";world'].
csv ír: s.
{
	csv elválasztó: [';'] idézőjel: ['"'] sorok: { :line
		Kimenet ír: line, újsor.
	}.
} elkap: { :e 
	Kimenet ír: e, újsor.
}, indít.
