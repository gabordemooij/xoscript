>> Szürcsölő := Objektum új.
Szürcsölő ha: ['új'] tedd: {
	saját str := [''].
}.


Szürcsölő ha: ['válaszol:'] tedd: { :blah
		(saját str ≠ ['']) igaz: {
			saját str hozzáfűz: [' '].
		}.
		saját str hozzáfűz: blah.
}.
Szürcsölő ha: ['válaszol:és:'] tedd: { :blah :blahah
		(saját str ≠ ['']) igaz: {
			saját str hozzáfűz: [' '].
		}.
		(blah hossz > 1) igaz: {
			saját str hozzáfűz: (blah ettől: 0 hossz: (blah hossz - 1)).
		}, különben: {
			saját str hozzáfűz: blah.
		}.
		saját str hozzáfűz: [' '].
		saját str hozzáfűz: blahah.
}.
Szürcsölő ha: ['megszerez'] tedd: {
	>> puffer := saját str.
	saját str := ['']. <- puffer.
}.

>> keresőparaméterek := Szürcsölő új.
keresőparaméterek select: ['*'], from users where: ['id = 2'].
Kimenet ír: (keresőparaméterek megszerez), újsor.
