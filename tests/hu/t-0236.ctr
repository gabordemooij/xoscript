>> Slurp := Objektum új.
Slurp ha: ['új'] tedd: {
	saját str := [''].
}.


Slurp ha: ['válaszol:'] tedd: { :blah
		(saját str ≠ ['']) igaz: {
			saját str hozzáfűz: [' '].
		}.
		saját str hozzáfűz: blah.
}.
Slurp ha: ['válaszol:és:'] tedd: { :blah :blahah
		(saját str ≠ ['']) igaz: {
			saját str hozzáfűz: [' '].
		}.
		(blah hossz > 1) igaz: {
			saját str hozzáfűz: (blah ettől: 0 hossz: (blah hossz - 1)).
		}, különben: {
			saját str hozzáfűz: blah.
		}.
		saját str hozzáfűz: [' '].
		saját str hozzáfűz: blahah.
}.
Slurp ha: ['obtain'] tedd: {
	>> buffer := saját str.
	saját str := ['']. <- buffer.
}.

>> keresőparaméterek := Slurp új.
keresőparaméterek select: ['*'], from users where: ['id = 2'].
Kimenet ír: (keresőparaméterek obtain), újsor.
