>> x := [' hallo '].

>> y := x nagybetűs.
Kimenet ír: x, újsor.
Kimenet ír: (x egyenlő: y), újsor.

>> y := x kisbetűs.
Kimenet ír: x, újsor.
Kimenet ír: (x egyenlő: y), újsor.

>> y := x levág.
Kimenet ír: x, újsor.
Kimenet ír: (x egyenlő: y), újsor.

>> y := x eltolás: 1.
Kimenet ír: x, újsor.
Kimenet ír: (x egyenlő: y), újsor.

>> y := x ettől: 1 hossz: 2.
Kimenet ír: x, újsor.
Kimenet ír: (x egyenlő: y), újsor.