Program memóriakezelés: 0.
>> palette := Semmi.
>> colors := Semmi.

{
palette := Szótár új.
palette 
	tesz: ['#F00'] ide: ['red'],
	tesz: ['#0F0'] ide: ['green'],
	tesz: ['#00F'] ide: ['blue'].
Kimenet ír: ['number of RGB codes in palette: '] + ( palette darabszám ), újsor.
Kimenet ír: ['RGB code of green is: '] + ( palette ? ['green'] ), újsor.
colors := [''].
( palette mindegyik: { :név :kód
		colors := colors + ( név + [':'] + kód ).
} ).
Kimenet ír: ['All colors in palette: '] + colors, újsor.
} indít.
Program takarít.
usedMemory1 := (Program memória ? 0).

