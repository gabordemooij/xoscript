	Kimenet ír: (a összefűz: [',']), újsor.
	a tesz: 3 ide: 2.
	Kimenet ír: (a összefűz: [',']), újsor.
	a tesz: 4 ide: 10.
	Kimenet ír: (a összefűz: [',']), újsor.
	a első-kivétele.
	a első-kivétele.
	a első-kivétele.
	Kimenet ír: (a összefűz: [',']), újsor.
	a tesz: 9 ide: 0.
	Kimenet ír: (a összefűz: [',']), újsor.
	a tesz: 6 ide: -1.
