>> makeAdder := { :x
	>> f := { :y <- (saját x + y). } beállít: ['x'] érték: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i saját q tesz: (saját f alkalmaz: (saját q ? i)) ide: i. } 
	beállít: ['q'] érték: array,
	beállít: ['f'] érték: func.
	{ :i mapping alkalmaz: i. } × (array darabszám).
}.

>> a := Lista ← 1; 2; 3.
mapper alkalmaz: a és: (makeAdder alkalmaz: 100).
Kimenet ír: (a pozíció: 0), újsor.
Kimenet ír: (a ? 1), újsor.
Kimenet ír: (a ? 2), újsor.
