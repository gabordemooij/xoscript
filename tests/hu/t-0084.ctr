>> összeadóKészítő := { :x
	>> f := { :y <- (saját x + y). } beállít: ['x'] érték: x. <- f.
}.
>> leképező := { :tömb :fv
	>> hozzárendelés := { :i saját q tesz: (saját f alkalmaz: (saját q ? i)) ide: i. } 
	beállít: ['q'] érték: tömb,
	beállít: ['f'] érték: fv.
	{ :i hozzárendelés alkalmaz: i. } × (tömb darabszám).
}.

>> a := Lista ← 1; 2; 3.
leképező alkalmaz: a és: (összeadóKészítő alkalmaz: 100).
Kimenet ír: (a pozíció: 0), újsor.
Kimenet ír: (a ? 1), újsor.
Kimenet ír: (a ? 2), újsor.
