Server init.

>> kapcs1 := Maria-DB új gazdagép: ['localhost'],
	felhasználónév: ['xo'],
	jelszó: ['pass123'],
	adatbázisnév: ['xobase'],
	csatlakozik.

>> kapcs2 := Maria-DB új gazdagép: ['localhost'],
	felhasználónév: ['xo'],
	jelszó: ['pass123'],
	adatbázisnév: ['xobase'],
	csatlakozik.
#...
>> törl := kapcs1 lekérdezés: ['DELETE FROM book WHERE id > 0'].
{  törl végrehajt. kapcs1 véglegesít. } elkap: { :e kapcs1 visszavon.  }, indít.

>> beszúrás := kapcs1 lekérdezés: ['INSERT INTO book (id) VALUES(null)'].
beszúrás végrehajt.

>> darabszám := kapcs1 lekérdezés: ['SELECT COUNT(*) AS num FROM book'].
darabszám lekér: { :sorAdat Kimenet ír: sorAdat num, újsor. }.

# nem jelenik meg
# a beszúrás nincs véglegesítve az 1. kapcsolaton
>> darabszám := kapcs2 lekérdezés: ['SELECT COUNT(*) AS num FROM book'].
darabszám lekér: { :sorAdat Kimenet ír: sorAdat num, újsor. }.
