
>> a := Lista ← (Lista ← 100 ; 200 ; 300) ; (Lista ← 9 ; 8 ; 7).
Kimenet ír: ['at 0,1 :'].
Kimenet ír: a ? 0 ? 1, újsor. 
Kimenet ír: ['at 1,2 :'].
Kimenet ír: a ? 1 ? 2, újsor. 
>> menu := Szótár új.
menu tesz: (Lista ← ['pizza'] ; ['spaghetti']) ide: ['Italian Cuisine'].
menu tesz: (Lista ← ['bifteki'] ; ['suflaki']) ide: ['Greek Cuisine'].
Kimenet ír: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), újsor. 
Kimenet ír: ['but not on the same plate.'], újsor.
