# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Széf 
	jelszó-hash: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Széf 
	jelszó-hash: hash ellenőriz: a1.
	# fail 
>> b := Széf
	jelszó-hash: hash ellenőriz: a2.
	# ok!

Kimenet ír: a, újsor.
Kimenet ír: b, újsor.

