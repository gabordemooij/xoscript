# Jelszó-hasítás
Server init.

# A felhasználó megad egy jelszót
>> jlsz := ['pass123'].

# Így tárolja el
>> hasítóérték := Széf 
	jelszó-hash: jlsz.

# Aztán a felhasználó bejelentkezik
# 1. próbálkozás
>> a1 := ['abcd123'].
# 2. próbálkozás
>> a2 := ['pass123'].

# Ellenőrzés
>> a := Széf 
	jelszó-hash: hasítóérték ellenőriz: a1.
	# sikertelen 
>> b := Széf
	jelszó-hash: hasítóérték ellenőriz: a2.
	# rendben!

Kimenet ír: a, újsor.
Kimenet ír: b, újsor.

