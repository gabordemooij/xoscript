# test qualifiers

Program takarít.

>> Fruit := Objektum új.
Fruit ha: ['új'] tedd: {
	>> f := maga új.
	f apples: 0. <- f.
}.
Fruit ha: ['apples:'] tedd: { :a saját apples := a. }.
Fruit ha: ['apples'] tedd: { <- saját apples. }.
Fruit ha: ['+'] tedd: { :f
	>> n := Fruit új.
	n apples: (f apples + saját apples). <- n.
}.
Szám ha: ['apples'] tedd: { <- ((Fruit új) apples: maga).
}.

Fruit ha: ['szöveg'] tedd: { <- saját apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Kimenet ír: q, újsor.




q := 3 apples + 4 apples.
Kimenet ír: q, újsor.



q := 3 apples + 4 apples.
Kimenet ír: q, újsor.


