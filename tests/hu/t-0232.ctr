>> Slurp := Objektum új.

Slurp ha: ['új'] tedd: {
	saját str := [''].
}.

Slurp ha: ['válaszol:'] tedd: { :blah
		(saját str = ['']) igaz: {
			saját str hozzáfűz: blah.
		}, különben: {
			saját str hozzáfűz: [' '].
			saját str hozzáfűz: blah.
		}.
}.

Slurp ha: ['válaszol:és:'] tedd: { :blah :blahah
		(blah hossz > 1) igaz: {
			saját str hozzáfűz: (blah ettől: 0 hossz: (blah hossz - 1)).
		}, különben: {
			saját str hozzáfűz: blah.
		}.
		saját str hozzáfűz: [' '].
		saját str hozzáfűz: blahah.
}.

Slurp ha: ['obtain'] tedd: {
	>> buffer := saját str.
	saját str := ['']. <- buffer.
}.


>> x := Slurp új.
x + 3.
Kimenet ír: (x obtain), újsor.
x echo: ['Hello world'].
Kimenet ír: (x obtain), újsor.
x tellme: 123 and: 987.
Kimenet ír: (x obtain), újsor.
