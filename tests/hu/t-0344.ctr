# catch-all test (practical)
>> HTML := Szöveg új.
HTML ha: ['encode:'] tedd: { :tekst
	maga hozzáfűz: (tekst
	csere: ['&'] erre: ['&amp;'], 
	csere: ['<'] erre: ['&lt;'],
	csere: ['>'] erre: ['&gt;'],
	csere: ['"'] erre: ['&quot;']).
}.
>> blog := HTML új.
blog hozzáfűz: ['<h1>'],
     encode: ['Koffie & Thee'],
     hozzáfűz: ['</h1>'].
Kimenet ír: blog, újsor.


>> Roman := Szám új.
Roman ha: ['stringy'] tedd: {
	>> a := [''].
	{ a hozzáfűz: ['I']. } × maga. <- a.
}.

>> x := Roman új.
x hozzáad: 3.
Kimenet ír: x stringy, újsor.

>> Quantum := Logikai új.
Quantum ha: ['true?'] tedd: { <- ['maybe True']. }.
Kimenet ír: (Quantum új true?), újsor.

>> Nihil := Semmi új.
Nihil ha: ['szöveg'] tedd: { <- ['Nihil']. }.
Kimenet ír: (Nihil új), újsor.
