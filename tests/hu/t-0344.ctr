# mindent elkapó teszt (gyakorlati)
>> HTMLSzöveg := Szöveg új.
HTMLSzöveg ha: ['encode:'] tedd: { :szövegem
	maga hozzáfűz: (szövegem
	csere: ['&'] erre: ['&amp;'], 
	csere: ['<'] erre: ['&lt;'],
	csere: ['>'] erre: ['&gt;'],
	csere: ['"'] erre: ['&quot;']).
}.
>> blog := HTMLSzöveg új.
blog hozzáfűz: ['<h1>'],
     encode: ['Koffie & Thee'],
     hozzáfűz: ['</h1>'].
Kimenet ír: blog, újsor.


>> Római := Szám új.
Római ha: ['szövegszerű'] tedd: {
	>> a := [''].
	{ a hozzáfűz: ['I']. } × maga. <- a.
}.

>> x := Római új.
x hozzáad: 3.
Kimenet ír: x szövegszerű, újsor.

>> Kvantum := Logikai új.
Kvantum ha: ['true?'] tedd: { <- ['talán Igaz']. }.
Kimenet ír: (Kvantum új true?), újsor.

>> Nihil := Semmi új.
Nihil ha: ['szöveg'] tedd: { <- ['Nihil']. }.
Kimenet ír: (Nihil új), újsor.
