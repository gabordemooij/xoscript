# a nyitó idézőjel első részére végződő értéknek túl kell élnie a szerializálást
>> értékek := Lista új
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

értékek mindegyik: { :i :value
	>> d := Szótár új.
	d tesz: value ide: ['k'].
	d tesz: ['second'] ide: ['j'].
	>> r := d kód objektum.
	Kimenet ír: r darabszám, újsor.
	Kimenet ír: ( (r itt: ['k']) = value ), újsor.
}.
