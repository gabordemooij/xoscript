# megfelelőségi teszt

# nemzetközi számok használata

Kimenet ír: ['1000 -> '].
Kimenet ír: 1000, újsor. #1000

Kimenet ír: ['1.5 -> '].
Kimenet ír: 1.5, újsor.  #1.5

Kimenet ír: ['1001.5 -> '].
Kimenet ír: 1.5 + 1000, újsor. #1001.5

# 0-tól indexelt tömbök használata
>> x := Lista új ; 1 ; 2 ; 3.
>> y := Lista új ; ['a'] ; ['b'] ; ['c'].

Kimenet ír: ['1 -> '].
Kimenet ír: x ? 0, újsor. #1

Kimenet ír: ['1 -> '].
Kimenet ír: (x itt: 0), újsor. #1

Kimenet ír: ['1 -> '].
Kimenet ír: x első, újsor. #1

Kimenet ír: ['3 -> '].
Kimenet ír: x utolsó, újsor. #3

Kimenet ír: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Kimenet ír: (x szerint: y), újsor.

Kimenet ír: ['1 -> '].
Kimenet ír: (x ettől: 0 hossz: 1) első, újsor. #1

Kimenet ír: ['0 -> '].
Kimenet ír: (x keres: 1), újsor. #0

x tesz: 9 ide: 0.

Kimenet ír: ['9 -> '].
Kimenet ír: (x itt: 0), újsor. #9

x elé-fűz: 8.
Kimenet ír: ['8 -> '].
Kimenet ír: (x itt: 0), újsor. #9


x hozzáfűz: 10.
Kimenet ír: ['10 -> '].
Kimenet ír: (x itt: 4), újsor. #10








