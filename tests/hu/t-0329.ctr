Kimenet ír: ((Lista új
	ha: ['plaque:'] tedd: { :x saját o := x. },
	ha: ['plaque']  tedd: { <- saját o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Lista ← 1)
	~ (Lista ← 1 ; 2)
	~ (Lista ← 1 ; 2 ; 3)
	~ (Lista ← 1 ; 2 ; 3 ; 4)
	~ (Lista ← 1 ; 2 ; 3 ; 4 ; 5)
) mindegyik: { :i :el
	{ Kimenet ír: ez-a-feladat. } × el darabszám.
	Kimenet újsor.
}) plaque, újsor.


