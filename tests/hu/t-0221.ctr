>> x := Objektum új.
>> y := Objektum új.
>> z := x.
Kimenet ír: (x = z), újsor.
Kimenet ír: (x = y), újsor.
Kimenet ír: (x ≠ y), újsor.
Kimenet ír: (x ≠ z), újsor.
>> m := Pillanat új év: 2070, hónap: 11.
>> n := m másol.
Kimenet ír: (m = n), újsor.
Kimenet ír: (m ≠ n), újsor.
Kimenet ír: (m egyenlő: m), újsor.
Kimenet ír: (m egyenlő: n), újsor.
n hónap: 12.
Kimenet ír: (m ≠ n), újsor.
Kimenet ír: (m = n), újsor.


