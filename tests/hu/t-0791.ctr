Server init.

>> ADB := Maria-DB új gazdagép: ['localhost'],
	felhasználónév: ['xo'],
	jelszó: ['pass123'],
	adatbázisnév: ['xobase'],
	csatlakozik.
	
>> SQL := ['SELECT "hello" AS "world" '].

# lekérdezés kézi létrehozása
>> keresőparaméterek := Maria-Lekérdezés új: SQL.

# adatbázis beállítása
keresőparaméterek adatbázis: ADB.

keresőparaméterek lekér: { :sorAdat
	Kimenet ír: sorAdat world, újsor.
}.
