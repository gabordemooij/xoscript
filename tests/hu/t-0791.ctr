Server init.

>> DB := Maria-DB új gazdagép: ['localhost'],
	felhasználónév: ['xo'],
	jelszó: ['pass123'],
	adatbázisnév: ['xobase'],
	csatlakozik.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> keresőparaméterek := Maria-Lekérdezés új: SQL.

# set database
keresőparaméterek adatbázis: DB.

keresőparaméterek lekér: { :row
	Kimenet ír: row world, újsor.
}.
