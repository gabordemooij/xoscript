Kimenet ír: ['Tesztobjektum'], újsor.
>> a := Objektum új. 

a ha: ['item:'] tedd: { :binsegéd
	saját binsegéd := binsegéd. 
}.

a ha: ['tétel'] tedd: {
	<- saját binsegéd.
}.

a item: Bin új.

>> régi-binsegéd-cím := a tétel prototípus memóriacím.
a save-as: ['/tmp/a.bin'].
Kimenet ír: ['========== PILLANATKÉP ÚJRATÖLTÉSE:'], újsor.

>> b := Objektum load-from: ['/tmp/a.bin'].

(b tétel prototípus memóriacím = régi-binsegéd-cím) igaz: {
	Kimenet ír: ['Objektumhivatkozás újracsatolva.'], újsor.
}.


