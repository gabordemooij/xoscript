Kimenet ír: ['Test object'], újsor.
>> a := Objektum új. 

a ha: ['item:'] tedd: { :binhelper
	saját binhelper := binhelper. 
}.

a ha: ['item'] tedd: { <- saját binhelper.
}.

a item: Bin új.

>> old-binhelper-address := a item prototípus memóriacím.
a save-as: ['/tmp/a.bin'].
Kimenet ír: ['========== RELOADING SNAP:'], újsor.

>> b := Objektum load-from: ['/tmp/a.bin'].

(b item prototípus memóriacím = old-binhelper-address) igaz: {
	Kimenet ír: ['Object link re-attached.'], újsor.
}.


