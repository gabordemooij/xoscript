>> items := Szótár új.
items tesz: ['black'] ide: ['coffee'], tesz: ['earl grey'] ide: ['tea'].
Kimenet ír: (items itt: ['coffee']), ír: (items itt: ['tea']).
Kimenet ír: ['there are'] + items darabszám + [' items in the array.'].
items tesz: ['capuccino'] ide: ['coffee'].
Kimenet ír: ['Now my coffee is.. '] + (items itt: ['coffee']).
items tesz: ['aaa'] ide: ['1'].
items tesz: ['bbb'] ide: ['2'].
Kimenet ír: (items itt: ['a']).
