>> items := Szótár új.
items tesz: ['fekete'] ide: ['coffee'], tesz: ['earl grey'] ide: ['tea'].
Kimenet ír: (items itt: ['coffee']), ír: (items itt: ['tea']).
Kimenet ír: ['összesen'] + items darabszám + [' elem van a tömbben.'].
items tesz: ['kapucsínó'] ide: ['coffee'].
Kimenet ír: ['Most a kávém.. '] + (items itt: ['coffee']).
items tesz: ['aaa'] ide: ['1'].
items tesz: ['bbb'] ide: ['2'].
Kimenet ír: (items itt: ['a']).
