Server init.
Kimenet ír: ['Database date test'], újsor.

>> db := Maria-DB új gazdagép: ['localhost'],
	felhasználónév: ['xo'], 
	jelszó: ['pass123'],
	adatbázisnév: ['xobase'],
	csatlakozik.

>> keresőparaméterek :=
db lekérdezés: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
lekér: { :row
	Kimenet ír: row datetest, újsor.
}.
