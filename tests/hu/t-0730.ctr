Kimenet ír: ['Test object'], újsor.
>> a := Objektum új. 

a ha: ['item:'] tedd: { :moment
	saját moment := moment. 
}.

a ha: ['item'] tedd: { <- saját moment.
}.

>> today := Pillanat új zóna: ['CEST'], év: 2026, hónap: 7.
a item: today.
Kimenet ír: a item, újsor.
a save-as: ['/tmp/a.bin'].
Kimenet ír: ['========== RELOADING SNAP:'], újsor.
>> b := Objektum load-from: ['/tmp/a.bin'].
Kimenet ír: b item, újsor.
