
Szöveg ha: ['html'] tedd: { <- (
		maga
		csere: ['&'] erre: ['&amp;'],
		csere: ['<'] erre: ['&lt;'],
		csere: ['>'] erre: ['&gt;'],
		csere: ['"'] erre: ['&quot;']
	).
}.

>> HtmlEcset := Objektum új.

HtmlEcset ha: ['válaszol:'] tedd: { :címke
	Kimenet ír: (['<tag>↵'] tag: címke ).
}.

HtmlEcset ha: ['válaszol:és:'] tedd: { :címke :content
	címke := ( címke ettől: 0 hossz: (címke hossz - 1) ).
	Kimenet ír: (['<tag content>↵'] tag: címke, content: content).
}.

HtmlEcset ha: ['content:'] tedd: { :szövegrész
	Kimenet ír: szövegrész html, újsor.
}.

HtmlEcset ha: ['attr:value:'] tedd: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlEcset új.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
