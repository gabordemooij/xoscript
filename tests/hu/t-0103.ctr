>> a := Lista ← Objektum ; Igaz ; Hamis ; Logikai ; 1 ; Szám ; ['Szöv'] ; Szöveg ; { ['Üres']. }.
Kimenet ír: (a darabszám), újsor.
{ :i
	Kimenet ír: 
	['a '] + 
	((a ? i) típus) +
	([' \‘this\’ '] this: (a ? i))  +
	[' értéke '] +
	(((a ? i) Semmi?) vagy: [''] vagy: ['NEM IS']) + 
	[' Semmi.'],
	újsor.
} × (a darabszám).
Kimenet ír: ['de.. a Semmi.. '] + ((Semmi Semmi?) vagy: ['biztosan SEMMI!'] vagy: ['nem SEMMI??']), újsor.