>> a := Lista ← Objektum ; Igaz ; Hamis ; Logikai ; 1 ; Szám ; ['Str'] ; Szöveg ; { ['Empty']. }.
Kimenet ír: (a darabszám), újsor.
{ :i
	Kimenet ír: 
	['a '] + 
	((a ? i) típus) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Semmi?) vagy: [''] vagy: ['NOT']) + 
	[' Nil.'],
	újsor.
} × (a darabszám).
Kimenet ír: ['but.. Nil is.. '] + ((Semmi Semmi?) vagy: ['certainly NIL!'] vagy: ['not NIL??']), újsor.