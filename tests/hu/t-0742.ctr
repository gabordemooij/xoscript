Kimenet ír: ['Test object'], újsor.
>> a := Objektum új. 

a ha: ['item:'] tedd: { :hexhelper
	saját hexhelper := hexhelper. 
}.

a ha: ['item'] tedd: { <- saját hexhelper.
}.

a item: Hx új.

>> old-hexhelper-address := a item prototípus memóriacím.
a save-as: ['/tmp/a.bin'].
Kimenet ír: ['========== RELOADING SNAP:'], újsor.

>> b := Objektum load-from: ['/tmp/a.bin'].

(b item prototípus memóriacím = old-hexhelper-address) igaz: {
	Kimenet ír: ['Object link re-attached.'], újsor.
}.
