Kimenet ír: ['Tesztobjektum'], újsor.
>> a := Objektum új. 

a ha: ['item:'] tedd: { :hexsegéd
	saját hexsegéd := hexsegéd. 
}.

a ha: ['tétel'] tedd: {
	<- saját hexsegéd.
}.

a item: Hx új.

>> régi-hexsegéd-cím := a tétel prototípus memóriacím.
a save-as: ['/tmp/a.bin'].
Kimenet ír: ['========== PILLANATKÉP ÚJRATÖLTÉSE:'], újsor.

>> b := Objektum load-from: ['/tmp/a.bin'].

(b tétel prototípus memóriacím = régi-hexsegéd-cím) igaz: {
	Kimenet ír: ['Objektumhivatkozás újracsatolva.'], újsor.
}.
