


>> CoffeeMachine := Objektum új.
CoffeeMachine ha: ['order:'] tedd: { :id
	>> coffee := ['Americano'].
	( id = 1 ) igaz: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) igaz: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) igaz: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Objektum új.
SimpleCoffeeMachine ha: ['order'] tedd: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Kimenet ír: redCup, újsor.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Kimenet ír: greenCup, újsor.
>> yellowCup := CoffeeMachine order: 1.
Kimenet ír: yellowCup, újsor.
>> blueCup := CoffeeMachine order: 0.
Kimenet ír: blueCup, újsor.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Kimenet ír: blackCup, újsor.
blackCup hozzáfűz: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Kimenet ír: orangeCup, újsor.
