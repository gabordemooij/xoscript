


>> Deck := Lista új.
Deck ha: ['print'] tedd: {
        >> len := maga darabszám - 1.
        { :i
                >> len2 := maga darabszám - 1.
                Kimenet ír: ['len: '].
                Kimenet ír: len, újsor.
                Kimenet ír: ['len2: '].
                Kimenet ír: len2, újsor.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
