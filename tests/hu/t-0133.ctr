


>> Pakli := Lista új.
Pakli ha: ['nyomtat'] tedd: {
        >> len := maga darabszám - 1.
        { :i
                >> hossz2 := maga darabszám - 1.
                Kimenet ír: ['hossz: '].
                Kimenet ír: len, újsor.
                Kimenet ír: ['hossz2: '].
                Kimenet ír: hossz2, újsor.
        } × len.
}.

>> d := Pakli ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d nyomtat.
