>> Point := Objektum új.
Point ha: ['x-coordinate:'] tedd: { :x saját x := x. }.
Point ha: ['y-coordinate:'] tedd: { :y saját y := y. }.
Point ha: ['x-coordinate']  tedd: { <- saját x másol. }.
Point ha: ['y-coordinate']  tedd: { <- saját y másol. }.

Point ha: ['='] tedd: { :other <- ( saját x = other x-coordinate
		 és: saját y = other y-coordinate ).
}.

>> pier := Point új x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point új x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point új x-coordinate: 5, y-coordinate: 6.

Kimenet ír: pier = town-hall, újsor.
Kimenet ír: pier = restaurant, újsor.
