>> z := Objektum új.
z ha: ['value:'] tedd: { :v
	saját value := v. <- maga.
}.
z ha: ['value'] tedd: { <- saját value. }.
(z setValue: 1) value: 2.
Kimenet ír: z value.
>> x := z.
Kimenet ír: x value.
z := Semmi.
Kimenet ír: z value.
