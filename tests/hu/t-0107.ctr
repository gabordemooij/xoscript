
Kimenet ír: ['Kilépés a for-ciklusból, 0-4.'], újsor.
{ :i
	Kimenet ír: ['iteration #'] + i, újsor.
	(i = 4) megszakít.
} × 10.

>> x := 0.
>> xKisebbMint10 := { <- ( x < 10 ). }.

Kimenet ír: ['Kilépés a while-true ciklusból, 0-4.'], újsor.
{
	Kimenet ír: ['iteration #'] + x, újsor.
	x hozzáad: 1.
	((x < 5) nem) megszakít.
} míg: xKisebbMint10.

Kimenet ír: ['Kilépés a while-false ciklusból, 5,4.'], újsor.
{
	Kimenet ír: ['iteration #'] + x, újsor.
	x kivon: 1.
	(x = 3) megszakít.
} míg: { <- (x > 0). }.

Kimenet ír: ['Kilépés a times ciklusból, 1-4.'], újsor.
{ :i
	Kimenet ír: ['iteration #'] + i, újsor.
	(i = 4) megszakít.
} × 5.

Kimenet ír: ['Kilépés a blokkból, ne írd ki a sort.'], újsor.
{ Igaz megszakít. Kimenet ír: ['ezt ne írd le!'], újsor. } indít.

Kimenet ír: ['Kilépés a blokkból, ne fusson a catch...'], újsor.
{ Igaz megszakít. Kimenet ír: ['ezt ne írd le!'], újsor. } elkap: { Kimenet ír: ['Ezt ne kapd el!']. }, indít.

Kimenet ír: ['Tömb each-ciklus teszt: 0,1'], újsor.
(Lista ← 1 ; 2 ; 3) leképez: { :i
	Kimenet ír: ['iteration #'] + i, újsor.
	(i = 1) megszakít.
}.

Kimenet ír: ['Térkép each-ciklus teszt: csak c'], újsor.
>> m := Szótár új.
m tesz: ['first'] ide: ['a'], tesz: ['second'] ide: ['b'], tesz: ['harmadik'] ide: ['c'].
m mindegyik: { :k :v
	Kimenet ír: ['iteration'] + v + k, újsor.
	Igaz megszakít.
}.

