
Kimenet ír: ['Break for-loop, 0-4.'], újsor.
{ :i
	Kimenet ír: ['iteration #'] + i, újsor.
	(i = 4) megszakít.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Kimenet ír: ['Break while-true loop, 0-4.'], újsor.
{
	Kimenet ír: ['iteration #'] + x, újsor.
	x hozzáad: 1.
	((x < 5) nem) megszakít.
} míg: xIsLessThan10.

Kimenet ír: ['Break while-false loop, 5,4.'], újsor.
{
	Kimenet ír: ['iteration #'] + x, újsor.
	x kivon: 1.
	(x = 3) megszakít.
} míg: { <- (x > 0). }.

Kimenet ír: ['Break times loop, 1-4.'], újsor.
{ :i
	Kimenet ír: ['iteration #'] + i, újsor.
	(i = 4) megszakít.
} × 5.

Kimenet ír: ['Break block, dont print line.'], újsor.
{ Igaz megszakít. Kimenet ír: ['dont write this!'], újsor. } indít.

Kimenet ír: ['Break block, dont fire catch...'], újsor.
{ Igaz megszakít. Kimenet ír: ['dont write this!'], újsor. } elkap: { Kimenet ír: ['Dont catch this!']. }, indít.

Kimenet ír: ['Test Array each-loop: 0,1'], újsor.
(Lista ← 1 ; 2 ; 3) leképez: { :i
	Kimenet ír: ['iteration #'] + i, újsor.
	(i = 1) megszakít.
}.

Kimenet ír: ['Test Map each-loop: c only'], újsor.
>> m := Szótár új.
m tesz: ['first'] ide: ['a'], tesz: ['second'] ide: ['b'], tesz: ['third'] ide: ['c'].
m mindegyik: { :k :v
	Kimenet ír: ['iteration'] + v + k, újsor.
	Igaz megszakít.
}.

