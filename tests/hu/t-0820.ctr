# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Minta új: pattern.
	p egyezés: subject tedd: { :m :g
		Kimenet ír: g darabszám, ír: [' '], ír: (g összefűz: ['|']), újsor. <- m.
	}.
}.
show alkalmaz: ['(a)|(b)'] és: ['b'].
show alkalmaz: ['(a)|(b)'] és: ['a'].
show alkalmaz: ['(x)?y'] és: ['y'].
show alkalmaz: ['(x)?(y)(z)?'] és: ['xy'].
