# a találaton kívüli csoport nem okozhat összeomlást, és meg kell tartani a csoportszámokat
Server init.
>> mutat := { :mintázat :subject
	>> p := Minta új: mintázat.
	p egyezés: subject tedd: { :m :g
		Kimenet ír: g darabszám, ír: [' '], ír: (g összefűz: ['|']), újsor.
		<- m.
	}.
}.
mutat alkalmaz: ['(a)|(b)'] és: ['b'].
mutat alkalmaz: ['(a)|(b)'] és: ['a'].
mutat alkalmaz: ['(x)?y'] és: ['y'].
mutat alkalmaz: ['(x)?(y)(z)?'] és: ['xy'].
