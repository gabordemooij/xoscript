

Szöveg ha: ['evaluate'] tedd: {
	>> kód := Fájl új: ['/tmp/eval.ctr'].
	kód ír: (maga szöveg + ['.']).
	Program használ: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Lista ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q szöveg.
Kimenet ír: x, újsor.
>> y := Semmi.
(['y := '] + x ) evaluate.
Kimenet ír: y ? 0, újsor.

q := Szótár tesz: ['\[''] ide: ['\['quote\']'].
x := q szöveg.
Kimenet ír: x, újsor.
y := Semmi.
(['y := '] + x ) evaluate.

>> q := (Szótár új) tesz:['\[''] ide:['\['quote\[''].
Kimenet ír: y ? ['\['quote\']'], újsor.
