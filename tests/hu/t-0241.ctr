

Szöveg ha: ['kiértékel'] tedd: {
	>> kód := Fájl új: ['/tmp/eval.ctr'].
	kód ír: (maga szöveg + ['.']).
	Program használ: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Lista ← (['Az idézőjelek '] + Q + [' gonoszak?']) ; 1.
>> x := q szöveg.
Kimenet ír: x, újsor.
>> y := Semmi.
(['y := '] + x ) kiértékel.
Kimenet ír: y ? 0, újsor.

q := Szótár tesz: ['\[''] ide: ['\['quote\']'].
x := q szöveg.
Kimenet ír: x, újsor.
y := Semmi.
(['y := '] + x ) kiértékel.

>> q := (Szótár új) tesz:['\[''] ide:['\['quote\[''].
Kimenet ír: y ? ['\['quote\']'], újsor.
