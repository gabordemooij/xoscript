

Lista ha: ['sum'] tedd: {
	>> total := 0.
	maga mindegyik: { :index :element
		total hozzáad: element.
	}. <- total.
}.

Lista ha: ['product'] tedd: {
	>> total := 1.
	maga mindegyik: { :index :element
		total szoroz: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program memóriakezelés: 0.

{

>> a := Lista ← ['hello'] ; ['world'] ; Igaz ; Semmi ; 666.
a := a + ( Lista ← 1 ).
Kimenet ír: ( ['sum: '] + ( a sum ) ), újsor.
Kimenet ír: ( ['min: '] + ( a minimum ) ), újsor.
Kimenet ír: ( ['max: '] + ( a maximum ) ), újsor.
Kimenet ír: ( ['3rd: '] + ( a ? 2 ) ), újsor.
Kimenet ír: ( ['prd: '] + ( a product ) ), újsor.
a rendez: { :a :b <- (b - a). }.
a mindegyik: { :i :e Kimenet ír: ( i - 0 ), újsor. }.

} indít.

Program takarít.
usedMemory1 := (Program memória ? 0).


