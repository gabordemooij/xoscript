Szám ha: ['factorial'] tedd: {
	>> total := 1.
	{ :index total szoroz: (maga - (index)). } × maga. <- total.
}.
>> Printer := Objektum új.
Printer ha: ['print:and:'] tedd: { :x :y
	Kimenet ír: ['a='] + x + [', b='] + y, újsor.
}.
>> a := 4.5. >> b := a lefelé-kerekít.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a felfelé-kerekít.
Printer print: a and: b.
a := 4.5. b := a lefelé-kerekít.
Printer print: a and: b.
a := 4.5. b := a kerekít.
Printer print: a and: b.
a := 4.2. b := a kerekít.
Printer print: a and: b.

Kimenet ír: (9 modulo: 5), újsor.
Kimenet ír: -666 abszolút, újsor.
Kimenet ír: 49 négyzetgyök, újsor.
Kimenet ír: (2 hatvány: 3), újsor.
>> l := (Lista ← 9 ; 6).
Kimenet ír: l minimum.

