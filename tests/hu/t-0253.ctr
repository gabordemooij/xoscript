#Linux
>> OS := Program beállítás: ['OS'].

>> clock := Pillanat új.
	
(OS = ['Haiku']) igaz: {
	clock zóna: ['CET'],
	év: 2017, hónap: 7, nap: 13,
	óra: 18, perc: 0, másodperc: 0.
}, különben: {
	clock zóna: ['Europe/Amsterdam'],
	év: 2017, hónap: 7, nap: 13,
	óra: 18, perc: 0, másodperc: 0.
}.

clock ha: ['tell'] tedd: {
	Kimenet ír: maga, újsor.
}.


clock hozzáad: 2    óra, tell.
clock hozzáad: 1    óra, tell.
clock hozzáad: 19 perc, tell.
clock hozzáad: 1  perc, tell.
clock hozzáad: 1  perc, tell.
clock hozzáad: 19 másodperc, tell.
clock hozzáad: 1  másodperc, tell.
clock hozzáad: 1  másodperc, tell.
clock hozzáad: 2    év, tell.
clock hozzáad: 1    év, tell.

(OS = ['Haiku']) igaz: {
clock hozzáad: 5   hónap.
clock zóna: ['CEST'], tell.
}, különben: {
	clock hozzáad: 5   hónap, tell.
}.

clock hozzáad: 1   hónap, tell.
clock hozzáad: 19    nap, tell.
clock hozzáad: 1    óra, tell.
clock hozzáad: 120  yard, tell.
