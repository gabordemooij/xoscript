#Linux
>> OS := Program beállítás: ['OS'].

>> falióra := Pillanat új.
	
(OS = ['Haiku']) igaz: {
	falióra zóna: ['CET'],
	év: 2017, hónap: 7, nap: 13,
	óra: 18, perc: 0, másodperc: 0.
}, különben: {
	falióra zóna: ['Europe/Amsterdam'],
	év: 2017, hónap: 7, nap: 13,
	óra: 18, perc: 0, másodperc: 0.
}.

falióra ha: ['közöl'] tedd: {
	Kimenet ír: maga, újsor.
}.


falióra hozzáad: 2    óra, közöl.
falióra hozzáad: 1    óra, közöl.
falióra hozzáad: 19 perc, közöl.
falióra hozzáad: 1  perc, közöl.
falióra hozzáad: 1  perc, közöl.
falióra hozzáad: 19 másodperc, közöl.
falióra hozzáad: 1  másodperc, közöl.
falióra hozzáad: 1  másodperc, közöl.
falióra hozzáad: 2    év, közöl.
falióra hozzáad: 1    év, közöl.

(OS = ['Haiku']) igaz: {
falióra hozzáad: 5   hónap.
falióra zóna: ['CEST'], közöl.
}, különben: {
	falióra hozzáad: 5   hónap, közöl.
}.

falióra hozzáad: 1   hónap, közöl.
falióra hozzáad: 19    nap, közöl.
falióra hozzáad: 1    óra, közöl.
falióra hozzáad: 120  yard, közöl.
