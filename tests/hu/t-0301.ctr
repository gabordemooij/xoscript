


>> wine := Objektum új.


wine ha: ['toString'] tedd: { <- ['merlot'].
}.

wine ha: ['naarTekst'] tedd: { <- ['merlot'].
}.


wine ha: ['='] tedd: { :other wine <- ( maga toString = other wine ).
}.

wine ha: ['=='] tedd: { :other wine <- ( maga toString = other wine ).
}.



wine
	eset: ['cabernet'] tedd: { Kimenet ír: ['it's a Cabernet!']. },
	eset: ['syrah']    tedd: { Kimenet ír: ['it's a Syrah!'].    },
	eset: ['merlot']   tedd: { Kimenet ír: ['it's a Merlot!'].   },
	eset: ['malbec']   tedd: { Kimenet ír: ['it's a Malbec!'].   }.

