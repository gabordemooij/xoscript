


>> bor := Objektum új.


bor ha: ['szöveggé'] tedd: { <- ['merlot'].
}.

bor ha: ['naarTekst'] tedd: { <- ['merlot'].
}.


bor ha: ['='] tedd: { :other wine <- ( maga szöveggé = other wine ).
}.

bor ha: ['=='] tedd: { :other wine <- ( maga szöveggé = other wine ).
}.



bor
	eset: ['cabernet'] tedd: { Kimenet ír: ['ez egy Cabernet!']. },
	eset: ['syrah']    tedd: { Kimenet ír: ['ez egy Syrah!'].    },
	eset: ['merlot']   tedd: { Kimenet ír: ['ez egy Merlot!'].   },
	eset: ['malbec']   tedd: { Kimenet ír: ['ez egy Malbec!'].   }.

Kimenet újsor.
