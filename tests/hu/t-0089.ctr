>> randomizer := { :a :b
	>> minimum := ( a < b ) vagy: a vagy: b.
	>> maximum := ( a > b ) vagy: a vagy: b.
	>> x := Semmi.
	{
		x := Szám között: a és: b.
		((x < minimum) vagy: (x > maximum)) igaz: { 
			Kimenet ír: (['Invalid value!']).
			Program vége.
		}.
	} 
	× 100. <- x.
}.
