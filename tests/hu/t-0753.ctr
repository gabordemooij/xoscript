Kimenet ír: ['Test object'], újsor.
>> a := Objektum új. 

a ha: ['item:'] tedd: { :fmt
	saját fmt := fmt. 
}.

a ha: ['item'] tedd: { <- saját fmt.
}.

a item: ( Formátum új: ['|%s|'] ).

Kimenet ír: a item, újsor.

>> old-fmt-address := a item prototípus memóriacím.
a save-as: ['/tmp/a.bin'].
Kimenet ír: ['========== RELOADING SNAP:'], újsor.

>> b := Objektum load-from: ['/tmp/a.bin'].

(b item prototípus memóriacím = old-fmt-address) igaz: {
	Kimenet ír: ['Object link re-attached.'], újsor.
}.

Kimenet ír: ( b item alkalmaz: ['hello'] ), újsor.
