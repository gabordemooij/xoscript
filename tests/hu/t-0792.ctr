Server init.

>> DB := Maria-DB új gazdagép: ['localhost'],
	felhasználónév: ['xo'],
	jelszó: ['pass123'],
	adatbázisnév: ['xobase'],
	csatlakozik.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB lekérdezés: SQL.

# now you don't have to set DB
query2 lekér: { :row
	Kimenet ír: row world, újsor.
}.
