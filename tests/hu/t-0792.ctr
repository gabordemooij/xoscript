Server init.

>> ADB := Maria-DB új gazdagép: ['localhost'],
	felhasználónév: ['xo'],
	jelszó: ['pass123'],
	adatbázisnév: ['xobase'],
	csatlakozik.
	
>> SQL := ['SELECT "hello" AS "world" '].

# gyorsabb mód, a lekérdezés lekérése az ADB-től:
>> lekérdezés2 := ADB lekérdezés: SQL.

# most már nem kell beállítani az ADB-t
lekérdezés2 lekér: { :sorAdat
	Kimenet ír: sorAdat world, újsor.
}.
