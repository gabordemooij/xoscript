



>> CoffeeGrounds := Objektum új.
CoffeeGrounds ha: ['extract'] tedd: { <- ['coffee']. }.

>> CoffeeMachine := Objektum új.
CoffeeMachine ha: ['init'] tedd: {
	saját coffeegrounds := CoffeeGrounds új.
}.
CoffeeMachine ha: ['új'] tedd: { <- CoffeeMachine `new init.
}.

CoffeeMachine ha: ['makeTea'] tedd: { <- (saját tealeaves extract). }.
CoffeeMachine ha: ['makeCoffee'] tedd: { <- (saját coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine új.

Kimenet ír:
	coffeeDream 
	makeCoffee.

Kimenet ír:
	coffeeDream 
	makeTea.
