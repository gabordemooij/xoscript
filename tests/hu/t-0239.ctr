Lista ha: ['sum'] tedd: {
	>> total := 0.
	maga mindegyik: { :index :element
		total hozzáad: element.
	}. <- total.
}.

>> a := Igaz.



a ha: ['szöveg'] tedd: {
	>> answer := Semmi.
	( maga = Igaz ) igaz: {
		answer := ['Yep'].
	}, különben: {
		answer := ['Nope'].
	}. <- answer.
}.

a ha: ['szám'] tedd: {
	>> answer := Semmi.
	( maga = Igaz ) igaz: {
		answer := 10.
	}, különben: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b ha: ['szöveg'] tedd: { <- ['Devil'].
}.

b ha: ['logikai'] tedd: { <- Hamis.
}.


Kimenet ír: a, újsor.  
Kimenet ír: (90 + a), újsor. 
Kimenet ír: b, újsor. 
Kimenet ír: (Igaz és: b), újsor.

a := Lista ← ['hello'] ; ['world'] ; Igaz ; Semmi ; 666. 
a := a + ( Lista ← 1 ).
Kimenet ír: a, újsor.
Kimenet ír: ((Szótár új) tesz: Semmi ide: Semmi), újsor.
Kimenet ír: a sum, újsor. 


{
	a ha: ['szöveg'] tedd: { <- Semmi. }.
	a := [''] + a.
} elkap: { :error
	Kimenet ír: ['Error noted: '] + error, újsor.
}, indít.



{
	a ha: ['szám'] tedd: { <- Semmi. }.
	a := 3 × a.
} elkap: { :error
	Kimenet ír: ['Error noted: '] + error, újsor.
}, indít.


{
	a ha: ['logikai'] tedd: { <- Semmi. }.
	a := Igaz és: a. 
} elkap: { :error
	Kimenet ír: ['Error noted: '] + error, újsor.
}, indít.





