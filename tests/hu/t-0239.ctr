Lista ha: ['összeg'] tedd: {
	>> végösszeg := 0.
	maga mindegyik: { :index :elem
		végösszeg hozzáad: elem.
	}. <- végösszeg.
}.

>> a := Igaz.



a ha: ['szöveg'] tedd: {
	>> felelet := Semmi.
	( maga = Igaz ) igaz: {
		felelet := ['Aha'].
	}, különben: {
		felelet := ['Dehogy'].
	}. <- felelet.
}.

a ha: ['szám'] tedd: {
	>> felelet := Semmi.
	( maga = Igaz ) igaz: {
		felelet := 10.
	}, különben: {
		felelet := 20.
	}. <- felelet.
}.

>> b := 666.

b ha: ['szöveg'] tedd: { <- ['Ördög'].
}.

b ha: ['logikai'] tedd: { <- Hamis.
}.


Kimenet ír: a, újsor.  
Kimenet ír: (90 + a), újsor. 
Kimenet ír: b, újsor. 
Kimenet ír: (Igaz és: b), újsor.

a := Lista ← ['hello'] ; ['world'] ; Igaz ; Semmi ; 666. 
a := a + ( Lista ← 1 ).
Kimenet ír: a, újsor.
Kimenet ír: ((Szótár új) tesz: Semmi ide: Semmi), újsor.
Kimenet ír: a összeg, újsor. 


{
	a ha: ['szöveg'] tedd: { <- Semmi. }.
	a := [''] + a.
} elkap: { :kivétel
	Kimenet ír: ['Hiba feljegyezve: '] + kivétel, újsor.
}, indít.



