# a soha be nem záródó idézőjel hibát kell adjon, nem végtelen ciklust
>> útvonal := ['/tmp/test0821.csv'].
>> file := Fájl új: útvonal.

file ír: ['a,b\n"1,2\n'].
{
	file elválasztó: [','] idézőjel: ['"'] sorok: { :line
		Kimenet ír: line, újsor.
	}.
} elkap: { :e Kimenet ír: e, újsor. }, indít.

# a lezárt idézőjel továbbra is működik
file ír: ['a,b\n"1,2",3'].
file elválasztó: [','] idézőjel: ['"'] sorok: { :line
	Kimenet ír: line, újsor.
}.
file töröl.
