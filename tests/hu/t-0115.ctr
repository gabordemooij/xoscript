{
	ez-a-feladat hiba: ['Ne bukj el.'].
	ismeretlen csináljValamit.
} elkap: {
	Kimenet ír: ['Elkapva!'].
}, indít.

{
	ez-a-feladat hiba: ['Ne bukj el.'].
	saját ismeretlen csináljValamit.
} elkap: {
	Kimenet ír: ['Elkapva!'].
}, indít.

{
	ez-a-feladat hiba: ['Ne bukj el.'].
	ismeretlen := 122.
} elkap: {
	Kimenet ír: ['Elkapva!'].
}, indít.


{
	ez-a-feladat hiba: ['Ne bukj el.'].
	Igaz megszakít.
	Kimenet ír: ['HIBA'].
} elkap: {
	Kimenet ír: ['Elkapva!'].
}, indít.

{
	{
		ez-a-feladat hiba: ['Ne bukj el.'].
		Igaz megszakít.
		Kimenet ír: ['HIBA'].
	} elkap: { :x
		(x = ['Ne bukj el.']) igaz: { ez-a-feladat hiba: ['Beágyazottan elkapva!']. }.
	}, indít.
} elkap: { :e
	Kimenet ír: e.
}, indít.
