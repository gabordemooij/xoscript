{
	ez-a-feladat hiba: ['Dont fail.'].
	unknown doSomething.
} elkap: {
	Kimenet ír: ['Caught!'].
}, indít.

{
	ez-a-feladat hiba: ['Dont fail.'].
	saját unknown doSomething.
} elkap: {
	Kimenet ír: ['Caught!'].
}, indít.

{
	ez-a-feladat hiba: ['Dont fail.'].
	unknown := 122.
} elkap: {
	Kimenet ír: ['Caught!'].
}, indít.


{
	ez-a-feladat hiba: ['Dont fail.'].
	Igaz megszakít.
	Kimenet ír: ['FAIL'].
} elkap: {
	Kimenet ír: ['Caught!'].
}, indít.

{
	{
		ez-a-feladat hiba: ['Dont fail.'].
		Igaz megszakít.
		Kimenet ír: ['FAIL'].
	} elkap: { :x
		(x = ['Dont fail.']) igaz: { ez-a-feladat hiba: ['Nested Caught!']. }.
	}, indít.
} elkap: { :e
	Kimenet ír: e.
}, indít.
