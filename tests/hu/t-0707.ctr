# típuskonverziók / átalakítások / kötések tesztje
Program memóriakezelés: 4.
Server init.

>> számláló := 0.
>> adb := Maria-DB új gazdagép: ['localhost'],
	felhasználónév: ['xo'], jelszó: ['pass123'], adatbázisnév: ['xobase'], csatlakozik.

>> KétjegyűFormátum := Formátum új: ['%02d'].

# Dátumidő
{
	>> év     := Szám között: 1995 és: 2050, szöveg.
	>> hónap    := KétjegyűFormátum alkalmaz-egész: (Szám között: 1 és: 12), szöveg.
	>> nap      := KétjegyűFormátum alkalmaz-egész: (Szám között: 1 és: 28), szöveg.
	>> óra     := KétjegyűFormátum alkalmaz-egész: (Szám között: 1 és: 23), szöveg.
	>> perc   := KétjegyűFormátum alkalmaz-egész: (Szám között: 1 és: 59), szöveg.
	>> másodperc   := KétjegyűFormátum alkalmaz-egész: (Szám között: 1 és: 59), szöveg.
	>> dátumidő := ['YYYY-MM-DD HH:II:SS'].	
	dátumidő
		YYYY: év,
		MM: hónap,
		DD: nap,
		HH: óra,
		II: perc,
		SS: másodperc.
	>> keresőparaméterek :=
	adb lekérdezés: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: dátumidő),
	lekér: { :sorAdat
		(sorAdat mydatetime = dátumidő) hamis: {
			ez-a-feladat hiba: (
				['Várt: <expected>, de kapott: <observation>']
				<expected>: dátumidő,
				<observation>: sorAdat mydatetime
			).
		}.
	
	}.
	számláló hozzáad: 1.
} * 100.

# Dátum
{
	>> év     := Szám között: 1995 és: 2050, szöveg.
	>> hónap    := KétjegyűFormátum alkalmaz-egész: (Szám között: 1 és: 12), szöveg.
	>> nap      := KétjegyűFormátum alkalmaz-egész: (Szám között: 1 és: 28), szöveg.
	>> dátum     := ['YYYY-MM-DD'].
	dátum
		YYYY: év,
		MM: hónap,
		DD: nap.
	>> keresőparaméterek :=
	adb lekérdezés: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: dátum),
	lekér: { :sorAdat
		(sorAdat mydate = dátum) hamis: {
			ez-a-feladat hiba: (
				['Várt: <expected>, de kapott: <observation>']
				<expected>: dátum,
				<observation>: sorAdat mydate
			).
		}.
	}.
	számláló hozzáad: 1.
} * 100.


# Idő
{
	>> óra     := KétjegyűFormátum alkalmaz-egész: (Szám között: 1 és: 23), szöveg.
	>> perc   := KétjegyűFormátum alkalmaz-egész: (Szám között: 1 és: 59), szöveg.
	>> másodperc   := KétjegyűFormátum alkalmaz-egész: (Szám között: 1 és: 59), szöveg.
	>> idő := ['HH:II:SS'].
	idő
		HH: óra,
		II: perc,
		SS: másodperc.
	>> keresőparaméterek :=
	adb lekérdezés: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: idő),
	lekér: { :sorAdat
		(sorAdat mytime = idő) hamis: {
			ez-a-feladat hiba: (
				['Várt: <expected>, de kapott: <observation>']
				<expected>: dátumidő,
				<observation>: sorAdat mytime
			).
		}.
	}.
	számláló hozzáad: 1.
} * 100.


# Szövegek (varchar/text)
>> str1 := Lista új feltölt: 100000 ezzel: ['x'], összefűz: [''].
{
	>> str2 := Széf token: 40.
	>> keresőparaméterek :=
	adb lekérdezés: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	lekér: { :sorAdat
		(sorAdat str1 = str1 és: sorAdat str2 = str2) hamis: {
			ez-a-feladat hiba: (
				['Várt: <expected>, de kapott: <observation>']
				<expected>: dátumidő,
				<observation>: sorAdat mytime
			).
		}.
	}.
	számláló hozzáad: 1.
} * 100.


# Számok
{
	>> n1  := Szám között: 1 és: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 szövegből: ['9223372036854775807'] ) -
		( Int64 szövegből: ['99999'] ) +
		( Int64 szövegből: n1 szöveg )
	).
	>> keresőparaméterek :=
	adb lekérdezés: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	lekér: { :sorAdat
		(sorAdat n1 = n1) hamis: {
			ez-a-feladat hiba: (
				['Várt: <expected>, de kapott: <observation>']
				<expected>: n1,
				<observation>: sorAdat n1
			).
		}.
		(sorAdat n2 = n2) hamis: {
			ez-a-feladat hiba: (
				['Várt: <expected>, de kapott: <observation>']
				<expected>: n1,
				<observation>: sorAdat n2
			).
		}.
		(sorAdat n3 = n2 kerekít) hamis: {
			ez-a-feladat hiba: (
				['Várt: <expected>, de kapott: <observation>']
				<expected>: n1,
				<observation>: sorAdat n3
			).
		}.
		(sorAdat big = big) hamis: {
			ez-a-feladat hiba: (
				['Várt: <expected>, de kapott: <observation>']
				<expected>: big,
				<observation>: sorAdat big
			).
		}.
		
	}.
	számláló hozzáad: 1.
} * 100.


Kimenet ír: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: számláló
), újsor.