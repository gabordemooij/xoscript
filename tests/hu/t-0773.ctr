Kimenet ír: ['Test object'], újsor.
>> a := Objektum új. 
a ha: ['item:'] tedd: { :int64
	saját int64 := int64. 
}.
a ha: ['item'] tedd: { <- saját int64.
}.
a item: ( Int64 szövegből: ['9999'] ).
Kimenet ír: a item, újsor.
>> old-int64-address := a item prototípus memóriacím.
a save-as: ['/tmp/a.bin'].
Kimenet ír: ['========== RELOADING SNAP:'], újsor.
>> b := Objektum load-from: ['/tmp/a.bin'].
(b item prototípus memóriacím = old-int64-address) igaz: {
	Kimenet ír: ['Object link re-attached.'], újsor.
}.
Kimenet ír: ( b item ), újsor.
