
Lista ha: ['sum'] tedd: {
	>> total := 0.
	maga mindegyik: { :index :element
		total hozzáad: element.
	}. <- total.
}.

>> a := Lista ← 9 ; 8 ; 7.
Kimenet ír: (a sum), újsor. 
>> a := Lista ← 1 ; 9.
Kimenet ír: (a sum), újsor. 
>> a := Lista ← ['o'] ; 2.
Kimenet ír: (a sum), újsor. 
Kimenet ír: (Lista új sum), újsor. 
