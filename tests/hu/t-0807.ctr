# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB új gazdagép: ['localhost'],
	felhasználónév: ['xo'],
	jelszó: ['pass123'],
	adatbázisnév: ['xobase'],
	csatlakozik.

>> keresőparaméterek := db lekérdezés: ['SELECT %% FROM'].
{ keresőparaméterek végrehajt. } elkap: { :e
	Kimenet ír: ( e tartalmazza: ['%%'] ), újsor.
}, indít.
