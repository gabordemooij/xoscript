>> Teendő := Objektum új.

Teendő ha: ['új'] tedd: {
	saját list := Lista új.
}.

Teendő ha: ['nieuw'] tedd: {
	saját list := Lista új.
}.

Teendő ha: ['+'] tedd: { :feladat
	saját list hozzáfűz: feladat.
}.

Teendő ha: ['number of tasks?'] tedd: { <-  saját list darabszám.
}.

>> teendők := 
	Teendő új 
	+ ['vacsorát főzni'] 
	+ ['szobát takarítani'].
	
Kimenet ír: ['You have $ tasks to do'] $ teendők number of tasks?.
