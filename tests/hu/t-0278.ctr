>> To-Do := Objektum új.

To-Do ha: ['új'] tedd: {
	saját list := Lista új.
}.

To-Do ha: ['nieuw'] tedd: {
	saját list := Lista új.
}.

To-Do ha: ['+'] tedd: { :task
	saját list hozzáfűz: task.
}.

To-Do ha: ['number of tasks?'] tedd: { <-  saját list darabszám.
}.

>> todos := 
	To-Do új 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Kimenet ír: ['You have $ tasks to do'] $ todos number of tasks?.
