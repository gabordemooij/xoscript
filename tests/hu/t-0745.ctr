Kimenet ír: ['Test object'], újsor.
>> a := Objektum új. 

a ha: ['item:'] tedd: { :dict
	saját dict := dict. 
}.

a ha: ['item'] tedd: { <- saját dict.
}.

a item: (
Szótár új
	hello: ['world']).

>> old-dict-address := a item prototípus memóriacím.
a save-as: ['/tmp/a.bin'].
Kimenet ír: ['========== RELOADING SNAP:'], újsor.

>> b := Objektum load-from: ['/tmp/a.bin'].

(b item prototípus memóriacím = old-dict-address) igaz: {
	Kimenet ír: ['Object link re-attached.'], újsor.
}.

Kimenet ír: b item, újsor.
