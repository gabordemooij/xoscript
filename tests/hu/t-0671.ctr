# nyilvános kulcs (API-k védelméhez stb.)
Server init.

# kulcsok generálása
>> kulcsok := Széf kulcsokat-generál.

# privát (titkos) kulcs
>> tk := kulcsok első.

# nyilvános kulcs
>> nk := kulcsok utolsó.

# üzenet aláírása
>> aláírás := Széf aláír: ['abc'] kulccsal: tk.

# üzenet ellenőrzése (rendben)
Kimenet ír: ( 
	Széf
		ellenőriz: ['abc'] 
		aláírás: aláírás 
		kulccsal: nk 
), újsor.

# üzenet ellenőrzése (sikertelen)
Kimenet ír: ( 
	Széf 
		ellenőriz: ['abd'] 
		aláírás: aláírás 
		kulccsal: nk 
), újsor.