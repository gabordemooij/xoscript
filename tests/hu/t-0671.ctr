# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Széf kulcsokat-generál.

# private (secret) key
>> sk := keys első.

# public key
>> pk := keys utolsó.

# sign a message
>> sig := Széf aláír: ['abc'] kulccsal: sk.

# check message (ok)
Kimenet ír: ( 
	Széf
		ellenőriz: ['abc'] 
		aláírás: sig 
		kulccsal: pk 
), újsor.

# check message (fail)
Kimenet ír: ( 
	Széf 
		ellenőriz: ['abd'] 
		aláírás: sig 
		kulccsal: pk 
), újsor.