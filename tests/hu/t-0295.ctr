
>> dictionary := (
	Szótár új
		tesz: ['b'] ide: ['a'],
		tesz: ['a'] ide: ['b'],
		tesz: ['z'] ide: ['x'],
		tesz: ['hello'] ide: ['hallo'],
		tesz: ['human'] ide: ['human']
).

>> comparisons := Lista új.
dictionary mindegyik: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a összehasonlít: b)
	).
}.

comparisons rendez: { :a :b <- ( a összehasonlít: b ). }.
Kimenet ír: ( comparisons összefűz: ['↵'] ), újsor.
comparisons összefűz: ['↵'].
