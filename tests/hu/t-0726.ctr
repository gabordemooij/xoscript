# test buffers PKI/Sign 
Server init.

>> long := ( Lista új feltölt: 1000 ezzel: ['a'] ) összefűz: [''].

# sign a message
Kimenet ír: ( 
	Széf aláír: ['abc'] kulccsal: long
), újsor.

Kimenet ír: ( 
	Széf
		ellenőriz: ['abc'] 
		aláírás: long 
		kulccsal: long
), újsor.

Kimenet ír: (
	Széf jelszó-hash: long ellenőriz: long
), újsor.
