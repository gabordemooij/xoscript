>> Üdvözlő := Objektum új.
Üdvözlő ha: ['készít'] tedd: {
	>> üdvözlő := Objektum új.
	üdvözlő ha: ['name:'] tedd: { :név
		Kimenet ír: ['név beállítása'].
		saját nevem := név.
	}.
	üdvözlő ha: ['üdvözlésVégrehajtása'] tedd: {
		Kimenet ír: ['Hello'].
		Kimenet ír: saját nevem.
	}.
	üdvözlő ha: ['üdvözöl'] tedd: {
		maga üdvözlésVégrehajtása.
	}. <- üdvözlő.
}.
>> üdvözlő := Üdvözlő készít.
üdvözlő name: ['napsugár!'].
üdvözlő üdvözöl.
