Program memóriakezelés: 4.

>> Doubler := Objektum új.
>> Multiplier := Objektum új.
Doubler ha: ['double:and:'] tedd: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier ha: ['multiply:and:'] tedd: { :x :y <- (x × y).
}.

Kimenet ír: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), újsor.
