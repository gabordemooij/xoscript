
Server init.
>> rq := HTTP-Kérés új.
Kimenet ír: ['HTTP-GET d[]=']  + ( rq get-lista: ['d[]'] ), újsor. # GET
Kimenet ír: ['HTTP-GET f[]=']  + ( rq get-lista: ['f[]'] ), újsor. # GET
Kimenet ír: ['HTTP-POST e[]='] + ( rq post-lista: ['e[]'] ), újsor. # GET
Kimenet ír: ['HTTP-POST c=']   + ( rq post: ['c'] ), újsor. # GET
Kimenet ír: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), újsor. # GET
