
Server init.
>> kr := HTTP-Kérés új.
Kimenet ír: ['HTTP-GET d[]=']  + ( kr get-lista: ['d[]'] ), újsor. # GET
Kimenet ír: ['HTTP-GET f[]=']  + ( kr get-lista: ['f[]'] ), újsor. # GET
Kimenet ír: ['HTTP-POST e[]='] + ( kr post-lista: ['e[]'] ), újsor. # GET
Kimenet ír: ['HTTP-POST c=']   + ( kr post: ['c'] ), újsor. # GET
Kimenet ír: ['HTTP-POST xx=']  + ( kr post: ['xx'] ), újsor. # GET
