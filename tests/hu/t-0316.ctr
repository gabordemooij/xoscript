>> Grandfather := Objektum új.
Grandfather ha: ['greet'] tedd: {
	Kimenet ír: ['Ave!'], újsor.
}.
>> Father := Grandfather új.
Father ha: ['greet'] tedd: {
	Kimenet ír: ['Hello'], újsor.
	maga greet.
}.
>> Son := Father új.
Son ha: ['greet'] tedd: {
	Kimenet ír: ['Hi'], újsor.
	maga greet.
}.

Son greet.

>> Roundabout := Objektum új.
Roundabout ha: ['circle:'] tedd: { :x
	Kimenet ír: x, újsor.
	(x < 3) igaz: { maga rekurzív circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) igaz: { Kimenet ír: x, újsor. x hozzáad: 1.  increment indít. }. }.
increment indít.