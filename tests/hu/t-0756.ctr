Kimenet ír: ['Test object'], újsor.
>> greeter := Objektum új.
greeter ha: ['name:'] tedd: { :név
	saját xname := név. 
}.
greeter ha: ['greet'] tedd: {
	Kimenet ír: ['Hello '] + saját xname, újsor.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Kimenet ír: ['========== RELOADING SNAP:'], újsor.
>> b := Objektum load-from: ['/tmp/a.bin'].
>> c := Objektum load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
