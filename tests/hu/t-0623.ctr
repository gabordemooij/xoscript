

>> g  := Server új.
>> v  := Széf új.
>> rendben := 0.

>> titkok := Lista új ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> jelszavak := titkok másol.
jelszavak mindegyik: { :i :p
	titkok mindegyik: { :n :s
		{
			>> titkosított := v titkosít: s kulcs: p.
			>> visszafejtett := v visszafejt: titkosított kulcs: p.
			(visszafejtett = s) igaz: {
				rendben hozzáad: 1.
			}, különben: {
				Kimenet ír: ['titkosítás/visszafejtés sikertelen: '], újsor.
				Kimenet ír: s, újsor.
				Kimenet ír: ['titkosítva: '] + titkosított, újsor.
				Kimenet ír: ['visszafejtve: '] + titkosított, újsor.
				Program vége.
			}.
		} elkap: { :hb
			(s = [''] vagy: p = ['']) igaz: {
				rendben hozzáad: 1.
			}, különben: {
				Kimenet ír: hb, újsor.
				Program vége.
			}.
		}, indít.
	}.
}.

Kimenet ír: ( rendben + [' széftitkosítás tesztelve.'] ), újsor.