>> HTMLSzöveg := Objektum új.
HTMLSzöveg ha: ['válaszol:'] tedd: { :címke 
	Kimenet ír: (['<tag>'] tag: címke), újsor.
}.
HTMLSzöveg ha: ['válaszol:és:'] tedd: { :címke :html 
	Kimenet ír: (
		['<tag>innerHTML</tag>']
		tag: címke - [':'],
		innerHTML: html
	), újsor.
}.
>> html := HTMLSzöveg új.
html body h1: ['header'].

