>> Állat := Objektum új.
Állat ha: ['készít'] tedd: {
	>> állat := Objektum új.
	állat ha: ['hangotAd'] tedd: {
		Kimenet ír: saját hang.
	}. <- állat.
}.
>> Macska := Objektum új.
Macska ha: ['készít'] tedd: {
	>> macska := Állat készít.
	macska ha: ['init'] tedd: {
		saját hang := ['meow!'].
	}.
	macska init. <- macska.
}.
>> tom := Macska készít.
tom hangotAd.
