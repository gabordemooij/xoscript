Kimenet ír: ['Test object'], újsor.
>> a := Objektum új. 

a ha: ['item:'] tedd: { :nil
	saját nil := nil. 
}.

a ha: ['item'] tedd: { <- saját nil.
}.

a item: Semmi.

Kimenet ír: a item, újsor.

>> old-nil-address := a item prototípus memóriacím.
a save-as: ['/tmp/a.bin'].
Kimenet ír: ['========== RELOADING SNAP:'], újsor.

>> b := Objektum load-from: ['/tmp/a.bin'].

(b item prototípus memóriacím = old-nil-address) igaz: {
	Kimenet ír: ['Object link re-attached.'], újsor.
}.

Kimenet ír: b item, újsor.
