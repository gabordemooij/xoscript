['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Kimenet ír: (x + y), újsor.

>> x := 10040.07.
>> y := 10305.60.

Kimenet ír: (x + y), újsor.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Kimenet ír: (x + y + z), újsor.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Kimenet ír: (x + y + z), újsor.

>> q := 0.1.2.

Kimenet ír: (q), újsor.

>> q := 012.

Kimenet ír: (q), újsor.
