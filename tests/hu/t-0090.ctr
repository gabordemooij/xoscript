Kimenet ír: ['1,2,3,4,5,6,7,8,9,A,'], újsor.
>> Hatókör := Objektum új.
Hatókör ha: ['initialize:'] tedd: { :x saját tulajdonság := x. }.
Hatókör ha: ['megerősít'] tedd: { Kimenet ír: [',']. }.
Hatókör ha: ['teszt'] tedd: {
	Kimenet ír: saját tulajdonság.
	maga megerősít.
	( 1 = 1 ) igaz: { Kimenet ír: saját tulajdonság. maga megerősít. }.
	( 1 = 0 ) hamis: { Kimenet ír: saját tulajdonság. maga megerősít. }.
	>> y := 2. { Kimenet ír: saját tulajdonság. maga megerősít. } míg: { y kivon: 1. <- (y > 0). }.
	{ Kimenet ír: saját tulajdonság. maga megerősít. } × 1.
	(Lista ← 1) mindegyik: {  Kimenet ír: saját tulajdonság. maga megerősít. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo saját rendezés megvalósítása, ez a teszt elbukik, mert platformonként eltér az iterációk száma
	(Szótár új one: ['item']) mindegyik: { Kimenet ír: saját tulajdonság. maga megerősít. }.
	{ 1 ÷ 0. } elkap: { Kimenet ír: saját tulajdonság. maga megerősít. }, indít.
	Kimenet újsor.
}.
>> hatókör1 := Hatókör új.
hatókör1 initialize: ['X'].
hatókör1 teszt.
>> függvényem := { 
	saját tulajdonság := ['Y'].
	Kimenet ír: saját tulajdonság.
	maga megerősít.
	( 1 = 1 ) igaz: { Kimenet ír: saját tulajdonság. maga megerősít. }.
	( 1 = 0 ) hamis: { Kimenet ír: saját tulajdonság. maga megerősít. }.
	>> y := 2. { Kimenet ír: saját tulajdonság. maga megerősít. } míg: { y kivon: 1. <- (y > 0). }.
	{ Kimenet ír: saját tulajdonság. maga megerősít. } × 1.
	(Lista ← 1) mindegyik: {  Kimenet ír: saját tulajdonság. maga megerősít. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Szótár új one: ['item']) mindegyik: { Kimenet ír: saját tulajdonság. maga megerősít. }.
	{ 1 ÷ 0. } elkap: { Kimenet ír: saját tulajdonság. maga megerősít. }, indít.
	Kimenet újsor.
}.
függvényem ha: ['megerősít'] tedd: { Kimenet ír: [',']. }.
függvényem alkalmaz: 1 és: 2.
