		maga
		csere: ['&'] erre: ['&amp;'],
		csere: ['<'] erre: ['&lt;'],
		csere: ['>'] erre: ['&gt;'],
		csere: ['''] erre: ['&apos;'],
		csere: ['"'] erre: ['&quot;']
	).
}.

