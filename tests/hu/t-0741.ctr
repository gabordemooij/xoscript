Kimenet ír: ['Tesztobjektum'], újsor.
>> a := Objektum új. 

a ha: ['item:'] tedd: { :oktsegéd
	saját oktsegéd := oktsegéd. 
}.

a ha: ['tétel'] tedd: {
	<- saját oktsegéd.
}.

a item: Oct új.

>> régi-oktsegéd-cím := a tétel prototípus memóriacím.
a save-as: ['/tmp/a.bin'].
Kimenet ír: ['========== PILLANATKÉP ÚJRATÖLTÉSE:'], újsor.

>> b := Objektum load-from: ['/tmp/a.bin'].

(b tétel prototípus memóriacím = régi-oktsegéd-cím) igaz: {
	Kimenet ír: ['Objektumhivatkozás újracsatolva.'], újsor.
}.
