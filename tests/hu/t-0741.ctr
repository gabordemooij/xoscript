Kimenet ír: ['Test object'], újsor.
>> a := Objektum új. 

a ha: ['item:'] tedd: { :octhelper
	saját octhelper := octhelper. 
}.

a ha: ['item'] tedd: { <- saját octhelper.
}.

a item: Oct új.

>> old-octhelper-address := a item prototípus memóriacím.
a save-as: ['/tmp/a.bin'].
Kimenet ír: ['========== RELOADING SNAP:'], újsor.

>> b := Objektum load-from: ['/tmp/a.bin'].

(b item prototípus memóriacím = old-octhelper-address) igaz: {
	Kimenet ír: ['Object link re-attached.'], újsor.
}.
