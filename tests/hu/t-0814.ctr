# munkamenet-süti formátuma, json tartalomtípus, csak webes protokollok, svg beágyazva megjelenítve
Server inicializál.
Program használ: ['../../../src/xo/hu/webtools.xo'].

>> Ál-Kérés := Objektum új.
Ál-Kérés ha: ['value:'] tedd: { :érték
	saját érték := érték.
}.
Ál-Kérés ha: ['cookie:'] tedd: { :név
	<- saját érték.
}.

>> Teszt-Munkamenet := Ideiglenes-fájl-munkamenet új.
Teszt-Munkamenet ha: ['betölt'] tedd: {
	<- Szótár új.
}.
Teszt-Munkamenet ha: ['munkamenet-id'] tedd: {
	<- saját id.
}.

>> sütik := Lista új
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

sütik mindegyik: { :i :süti
	>> kérés := Ál-Kérés új.
	kérés value: süti.
	>> kezelő := Teszt-Munkamenet új.
	>> weblap := Webdokumentum új.
	weblap kérés: kérés.
	weblap munkamenet-kezelő: kezelő.
	weblap munkamenet-indítása.
	Kimenet ír: ( kezelő munkamenet-id = süti ), újsor.
}.

>> weblap := Webdokumentum új.
weblap json: (Szótár új tesz: ['b'] ide: ['a']).
Kimenet ír: ['\n'], újsor.

{ Hálózat get: ['file:///etc/hostname']. } elkap: { :e
	Kimenet ír: e, újsor.
}, indít.

>> svg := Fájl új: ['/tmp/test0814.svg'].
svg ír: ['<svg xmlns="x"></svg>'].
Kimenet újsor.
Server továbbít: ['test0814.svg'] előtag: ['/tmp/'].
svg töröl.
