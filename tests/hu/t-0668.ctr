# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob új: 8, bytes: (
	Lista új ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Kimenet ír: ( utf16 dekódol: ['utf16le'] ), újsor.

utf16 felszabadít.
>> utf32 := Blob új: 13, bytes: (
	Lista új ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Kimenet ír: ( utf32 dekódol: ['utf32be'] ), újsor.
utf32 felszabadít.