# test qualifiers

>> $ := Objektum új.

$ ha: ['válaszol:'] tedd: { :x
	
	>> operation := x karakter: 0.
	>> valuta := x karakter: 1.
	>> money := x eltolás: 2.
	
	>> amount := 0.

	( operation = ['+'] ) igaz: {
		( valuta = ['£'] ) igaz: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Kimenet ír: x, újsor.


>> Fruit := Objektum új.

Fruit ha: ['új'] tedd: {
	>> f := maga új.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit ha: ['apples:'] tedd: { :a saját apples := a. }.
Fruit ha: ['oranges:'] tedd: { :p saját oranges := p. }.
Fruit ha: ['apples'] tedd: { <- saját apples. }.
Fruit ha: ['oranges'] tedd: { <- saját oranges. }.

Fruit ha: ['+'] tedd: { :f
	
	>> n := Fruit új.
	f hozzáad: 1.
	
	n apples: (f apples + saját apples).
	n oranges:  (f oranges  + saját oranges). <- n.
}.

Fruit ha: ['szöveg'] tedd: { <- ( saját apples szöveg + [' apples and '] + saját oranges + [' oranges'] ).
}.

Szám ha: ['apples'] tedd: { <- ((Fruit új) apples: maga).
}.

Szám ha: ['apple'] tedd: { <- ((Fruit új) apples: maga).
}.

Szám ha: ['oranges'] tedd: { <- ((Fruit új) oranges: maga).
}.




Kimenet ír: (1 apple + 3 oranges + 4 apples), újsor.


Szöveg ha: ['twice'] tedd: { <- ((maga szöveg) + (maga szöveg)).
}.



Kimenet ír: ['❤❤❤'] twice.



