# minősítők tesztje

>> $ := Objektum új.

$ ha: ['válaszol:'] tedd: { :x
	
	>> művelet := x karakter: 0.
	>> valuta := x karakter: 1.
	>> pénz := x eltolás: 2.
	
	>> pénzösszeg := 0.

	( művelet = ['+'] ) igaz: {
		( valuta = ['£'] ) igaz: { pénzösszeg := 1.28 × pénz. }.
	}. <- pénzösszeg.
}.



>> x := $ +£20.

Kimenet ír: x, újsor.


>> Gyümölcs := Objektum új.

Gyümölcs ha: ['új'] tedd: {
	>> f := maga új.
	f apples: 0.
	f oranges: 0. <- f.
}.

Gyümölcs ha: ['apples:'] tedd: { :a saját almák := a. }.
Gyümölcs ha: ['oranges:'] tedd: { :p saját narancsok := p. }.
Gyümölcs ha: ['almák'] tedd: { <- saját almák. }.
Gyümölcs ha: ['narancsok'] tedd: { <- saját narancsok. }.

Gyümölcs ha: ['+'] tedd: { :f
	
	>> n := Gyümölcs új.
	f hozzáad: 1.
	
	n apples: (f almák + saját almák).
	n oranges:  (f narancsok  + saját narancsok). <- n.
}.

Gyümölcs ha: ['szöveg'] tedd: { <- ( saját almák szöveg + [' alma és '] + saját narancsok + [' narancs'] ).
}.

Szám ha: ['almák'] tedd: { <- ((Gyümölcs új) apples: maga).
}.

Szám ha: ['apple'] tedd: { <- ((Gyümölcs új) apples: maga).
}.

Szám ha: ['narancsok'] tedd: { <- ((Gyümölcs új) oranges: maga).
}.




Kimenet ír: (1 apple + 3 narancsok + 4 almák), újsor.


Szöveg ha: ['kétszer'] tedd: { <- ((maga szöveg) + (maga szöveg)).
}.



Kimenet ír: ['❤❤❤'] kétszer.



