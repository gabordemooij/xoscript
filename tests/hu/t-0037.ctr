>> a := 3.
>> b := a másol.
a kivon: 1.
Kimenet ír: [' a = '] + a.
Kimenet ír: [' b = '] + b.
a := 3.
b := a + 4.
Kimenet ír: [' a = '] + a.
Kimenet ír: [' b = '] + b.
>> x := 3.
>> y := x másol.
x hozzáad: 10.
y kivon: 1.
Kimenet ír: [' x = '] + x.
Kimenet ír: [' y = '] + y.
>> q := Objektum új.
q ha: ['setProperty:'] tedd: { :x
	saját prop := x.
}.
q ha: ['getProperty'] tedd: { <- saját prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Kimenet ír: [' p = '] + (p getProperty).
