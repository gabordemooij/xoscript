#ffi test


Server init.

Program memóriakezelés: 4.

# for this test you need set a path to libc (puts)
>> libname := Program beállítás: ['FFITESTLIB'].



Server összekapcsol: (
 Lista új ;
 libname ;
 ['puts'] ;
 ( Lista új ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s felszabadít.

# test with struct

>> a := Blob új: 8.
a bytes: (
	Lista <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Lista <<: ['int'], ; ['int']).

Server összekapcsol: (
	Lista <<: ['@structtest'], ;
	['@structtest'] ;
	(Lista <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Kimenet ír: ['Sum test:'] + (ffitest ffisum: a), újsor.

struct struct-felszabadít.
struct felszabadít.
a felszabadít.
