#ffi-teszt


Server init.

Program memóriakezelés: 4.

# ehhez a teszthez meg kell adni a libc útvonalát (puts)
>> könyvtárfájlnév := Program beállítás: ['FFITESTLIB'].



Server összekapcsol: (
 Lista új ;
 könyvtárfájlnév ;
 ['puts'] ;
 ( Lista új ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s felszabadít.

# teszt struct-tal

>> a := Blob új: 8.
a bytes: (
	Lista <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> szerkezet := Blob struct: (Lista <<: ['int'], ; ['int']).

Server összekapcsol: (
	Lista <<: ['@structtest'], ;
	['@structtest'] ;
	(Lista <<: szerkezet) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Kimenet ír: ['Összeg teszt:'] + (ffitest ffisum: a), újsor.

szerkezet struct-felszabadít.
szerkezet felszabadít.
a felszabadít.
