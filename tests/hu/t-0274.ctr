

Lista ha: ['column:'] tedd: { :column
	>> result := Lista új.
	maga mindegyik: { :index :row
		row mindegyik: { :index :cell
			(index = column) igaz: { result hozzáfűz: cell. }.
		}.
	}. <- result.
}.


>> a := Lista ←
	(Lista ← 1 ; 2 ; 3) ;
	(Lista ← 4 ; 5 ; 6) ;
	(Lista ← 7 ; 8 ; 9).

>> b := a column: 1.
Kimenet ír: b, újsor.

b := a column: 20.
Kimenet ír: b, újsor.

b := a column: -100.
Kimenet ír: b, újsor.
