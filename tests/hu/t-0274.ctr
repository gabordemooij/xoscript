

Lista ha: ['column:'] tedd: { :oszlop
	>> eredmény := Lista új.
	maga mindegyik: { :index :sorAdat
		sorAdat mindegyik: { :index :cella
			(index = oszlop) igaz: { eredmény hozzáfűz: cella. }.
		}.
	}. <- eredmény.
}.


>> a := Lista ←
	(Lista ← 1 ; 2 ; 3) ;
	(Lista ← 4 ; 5 ; 6) ;
	(Lista ← 7 ; 8 ; 9).

>> b := a column: 1.
Kimenet ír: b, újsor.

b := a column: 20.
Kimenet ír: b, újsor.

b := a column: -100.
Kimenet ír: b, újsor.
