>> ismétlő := Objektum új.
ismétlő ha: ['válaszol:'] tedd: { :mit
	Kimenet ír: mit + [' '].
}.
ismétlő ha: ['válaszol:és:'] tedd: { :mit :say
	Kimenet ír: mit, ír: say + [' '].
}.
ismétlő ha: ['válaszol:és:és:'] tedd: { :mit :say :több
	Kimenet ír: mit, ír: say, ír: több.
}.
ismétlő ismétel.
ismétlő everything: ['Mondom.'].
ismétlő and: ['I '] everything: ['teszem.'].
