>> repeater := Objektum új.
repeater ha: ['válaszol:'] tedd: { :what
	Kimenet ír: what + [' '].
}.
repeater ha: ['válaszol:és:'] tedd: { :what :say
	Kimenet ír: what, ír: say + [' '].
}.
repeater ha: ['válaszol:és:és:'] tedd: { :what :say :more
	Kimenet ír: what, ír: say, ír: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
