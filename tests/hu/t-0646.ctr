Server init.
Kimenet ír: ['Database datetime test'], újsor.

>> db := Maria-DB új gazdagép: ['localhost'],
	felhasználónév: ['xo'], 
	jelszó: ['pass123'],
	adatbázisnév: ['xobase'],
	csatlakozik.

>> keresőparaméterek :=
db lekérdezés: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
lekér: { :row
	Kimenet ír: row datetimetest, újsor.
}.
