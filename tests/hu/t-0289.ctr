#Linux
>> OS := Program rendszer: (Parancs uname -s), levág.

>> Slurp := Objektum új.
Slurp ha: ['új'] tedd: {
	saját str := [''].
}.
Slurp ha: ['válaszol:'] tedd: { :blah
		(saját str ≠ ['']) igaz: {
			saját str hozzáfűz: [' '].
		}.
		saját str hozzáfűz: blah.
}.
Slurp ha: ['válaszol:és:'] tedd: { :blah :blahah
		(saját str ≠ ['']) igaz: {
			saját str hozzáfűz: [' '].
		}.
		(blah hossz > 1) igaz: {
			saját str hozzáfűz: (blah ettől: 0 hossz: (blah hossz - 1)).
		}, különben: {
			saját str hozzáfűz: blah.
		}.
		saját str hozzáfűz: [' '].
		saját str hozzáfűz: blahah.
}.
Slurp ha: ['obtain'] tedd: {
	>> buffer := saját str.
	saját str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text hozzáfűz: ['hello'].
} × 1000.


Kimenet ír: (
	Program rendszer: (
		Slurp új
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

