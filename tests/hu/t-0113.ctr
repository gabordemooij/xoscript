Kimenet ír: ['Continue for-loop, No - before 6 and up.'], újsor.
{ :i
	Kimenet ír: (i + 1), újsor.
	((i + 1) > 4) folytat.
	Kimenet ír: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Kimenet újsor.
Kimenet ír: ['Continue while-true, No --> before 5 and up.'], újsor.
{
	Kimenet ír: ['iteration #'] + x, újsor.
	x hozzáad: 1.
	((x < 5) nem) folytat.
	Kimenet ír: ['-->'].
} míg: xIsLessThan10.
Kimenet újsor.
Kimenet ír: ['Continue while-false, No - before 3 only.'], újsor.
{
	Kimenet ír: ['iteration #'] + x, újsor.
	x kivon: 1.
	(x = 3) folytat.
	Kimenet ír: ['-'].
} míg: { <- ( x > 0). }.

Kimenet újsor.
Kimenet ír: ['Continue times-loop, No ||| before 3.'], újsor.
{ :i
	Kimenet ír: ['iteration #'] + i, újsor.
	(i = 2) folytat.
	Kimenet ír: ['|||'].
} × 5.

Kimenet újsor.

{ Igaz folytat. Kimenet ír: ['dont write this!'], újsor. } indít.

{ Igaz folytat. Kimenet ír: ['dont write this!'], újsor. } elkap: { Kimenet ír: ['Dont catch this!']. }, indít.

Kimenet ír: ['Test Array each-loop: 0, ... ,2'], újsor.
(Lista ← 1 ; 2 ; 3) leképez: { :i
	(i = 1) folytat.
	Kimenet ír: ['iteration #'] + (i - 0), újsor.
}.

Kimenet ír: ['Test Map each-loop: c only'], újsor.
>> m := Szótár új.
m tesz: ['first'] ide: ['a'], tesz: ['second'] ide: ['b'], tesz: ['third'] ide: ['c'].
m mindegyik: { :k :v
	(k ≠ ['c']) folytat.
	Kimenet ír: ['iteration'] + k + v, újsor.
}.

