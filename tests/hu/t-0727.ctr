Server init.
>> f := Formátum új: ['%d'].
>> a := Blob új: 4.
a bytes: ( Lista új ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob új: 4.
b bytes: ( Lista új ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a ettől: 0 hossz: 3, mindegyik: { :i :byte
	Kimenet ír: ( f alkalmaz-egész: byte ) , újsor.
}.
a ^ b.
a ettől: 0 hossz: 3, mindegyik: { :i :byte
	Kimenet ír: ( f alkalmaz-egész: byte ) , újsor.
}.
a ^ b.
a ettől: 0 hossz: 3, mindegyik: { :i :byte
	Kimenet ír: ( f alkalmaz-egész: byte ) , újsor.
}.
a felszabadít.
b felszabadít.

{ a ^ Objektum. } elkap: { :e Kimenet ír: e, újsor. }, indít.
