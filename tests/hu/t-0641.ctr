# utf8-tisztító tesztje
Server init.

>> utf8esetek := Szótár új
	# csak ASCII
	tesz: ( Lista új ; 65 ; 65 ; 65 ; 65 ; 0 ) ide: ['AAAA'],
	# érvényes 2 bájtos sorozat
	tesz: ( Lista új ; 194 ; 162 ; 0 ) ide: ['¢'],
	# Érvényes 3 bájtos UTF-8
    tesz: ( Lista új ; 226 ; 130 ; 172 ; 0 ) ide: ['€'],
	# Érvényes 4 bájtos UTF-8
    tesz: ( Lista új ; 240 ; 144 ; 141 ; 136 ; 0 ) ide: ['𐍈'],
	# Érvénytelen folytatóbájt az E2 28 AC sorozatban -> 3 bájtos sorozat kezdete + 28 hibás folytatás + AC folytatóbájt, de ugyanahhoz a hibához tartozik
    tesz: ( Lista új ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) ide: ['A?A'],
	# Az ASCII 'A' túl hosszú kódolása (? lesz belőle),
    tesz: ( Lista új ; 65 ; 193 ; 129 ; 0 ) ide: ['A?'],
	# Érvénytelen első bájt (0xFF)
    tesz: ( Lista új ; 255 ; 0 ) ide: ['?'],
	# Befejezetlen többbájtos sorozat a végén
    tesz: ( Lista új ; 66 ; 226 ; 0 ) ide: ['B?'],
    # Üres szöveg
    #put: ( List new ) at: [''],
	# Több vegyes sorozat
    tesz: ( Lista új ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) ide: ['A€?𐍈B'].
	 
utf8esetek mindegyik: { :key :value
	>> blob := Blob új: value darabszám, bytes: value.
	>> str := blob szöveg.
	(str = key) igaz: {
		Kimenet ír: ['OK'], újsor.
	}, különben: {
		Kimenet ír: ['Az UTF8-tisztító hibázott ennél: '] + key + [' kapott: '] + str, újsor.
	}.
	blob felszabadít.
}.
