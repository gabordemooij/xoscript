>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objektum új.
⚄ ha: ['drawFrom:length:'] tedd: { :pool :darabszám
	
	>> result := [''].
	
	{
		>> index := Szám random % (pool hossz).
		result hozzáfűz: ( pool karakter: (index + 1) ).
		
	} × darabszám. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? hossz.
Kimenet ír: (['x↵'] x random hossz).
Kimenet ír: (['y↵'] y ?? hossz).

