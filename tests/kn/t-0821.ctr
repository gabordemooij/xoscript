# a quote that never closes must give an error, not an endless loop
>> ಕಡತ-ಮಾರ್ಗ := ['/tmp/test0821.csv'].
>> file := ಕಡತ ಹೊಸ: ಕಡತ-ಮಾರ್ಗ.

file ಬರೆ: ['a,b\n"1,2\n'].
{
	file ವಿಭಜಕ: [','] ಉದ್ಧರಣ: ['"'] ಸಾಲುಗಳು: { :line
		ಔಟ್-ಪುಟ್ ಬರೆ: line, ಹೊಸ-ಸಾಲು.
	}.
} ಹಿಡಿ: { :e ಔಟ್-ಪುಟ್ ಬರೆ: e, ಹೊಸ-ಸಾಲು. }, ಚಲಾಯಿಸು.

# a closed quote still works
file ಬರೆ: ['a,b\n"1,2",3'].
file ವಿಭಜಕ: [','] ಉದ್ಧರಣ: ['"'] ಸಾಲುಗಳು: { :line
	ಔಟ್-ಪುಟ್ ಬರೆ: line, ಹೊಸ-ಸಾಲು.
}.
file ಅಳಿಸು.
