ಸಂಖ್ಯೆ ಬಂದಾಗ: ['roman'] ಮಾಡು: {
	>> ಸಂಖ್ಯೆಯಾಗಿ := ತಾನು ನಕಲು.
	>> roman := [''].
	{
		{
			(ಸಂಖ್ಯೆಯಾಗಿ ≥ 1000) ಸತ್ಯವಾದರೆ: {
				roman ಕೊನೆಗೆ-ಸೇರಿಸು: ['Ⅿ'].
				ಸಂಖ್ಯೆಯಾಗಿ ಕಳೆ: 1000.
			}, ನಿಲ್ಲಿಸು.
		
			(ಸಂಖ್ಯೆಯಾಗಿ ≥ 500) ಸತ್ಯವಾದರೆ: {
				roman ಕೊನೆಗೆ-ಸೇರಿಸು: ['Ⅾ'].
				ಸಂಖ್ಯೆಯಾಗಿ ಕಳೆ: 500.
			}, ನಿಲ್ಲಿಸು.
		
			(ಸಂಖ್ಯೆಯಾಗಿ ≥ 100) ಸತ್ಯವಾದರೆ: {
				roman ಕೊನೆಗೆ-ಸೇರಿಸು: ['Ⅽ'].
				ಸಂಖ್ಯೆಯಾಗಿ ಕಳೆ: 100.
			}, ನಿಲ್ಲಿಸು.
		
			(ಸಂಖ್ಯೆಯಾಗಿ ≥ 50) ಸತ್ಯವಾದರೆ: {
				roman ಕೊನೆಗೆ-ಸೇರಿಸು: ['Ⅼ'].
				ಸಂಖ್ಯೆಯಾಗಿ ಕಳೆ: 50.
			}, ನಿಲ್ಲಿಸು.
		
			(ಸಂಖ್ಯೆಯಾಗಿ ≥ 50) ಸತ್ಯವಾದರೆ: {
				roman ಕೊನೆಗೆ-ಸೇರಿಸು: ['Ⅼ'].
				ಸಂಖ್ಯೆಯಾಗಿ ಕಳೆ: 50.
			}, ನಿಲ್ಲಿಸು.
		
			(ಸಂಖ್ಯೆಯಾಗಿ ≥ 10) ಸತ್ಯವಾದರೆ: {
				roman ಕೊನೆಗೆ-ಸೇರಿಸು: ['Ⅹ'].
				ಸಂಖ್ಯೆಯಾಗಿ ಕಳೆ: 10.
			}, ನಿಲ್ಲಿಸು.
			
			(ಸಂಖ್ಯೆಯಾಗಿ ≥ 9) ಸತ್ಯವಾದರೆ: {
				roman ಕೊನೆಗೆ-ಸೇರಿಸು: ['Ⅸ'].
				ಸಂಖ್ಯೆಯಾಗಿ ಕಳೆ: 9.
			}, ನಿಲ್ಲಿಸು.
			
			(ಸಂಖ್ಯೆಯಾಗಿ ≥ 5) ಸತ್ಯವಾದರೆ: {
				roman ಕೊನೆಗೆ-ಸೇರಿಸು: ['Ⅴ'].
				ಸಂಖ್ಯೆಯಾಗಿ ಕಳೆ: 5.
			}, ನಿಲ್ಲಿಸು.
			
			(ಸಂಖ್ಯೆಯಾಗಿ ≥ 4) ಸತ್ಯವಾದರೆ: {
				roman ಕೊನೆಗೆ-ಸೇರಿಸು: ['Ⅳ'].
				ಸಂಖ್ಯೆಯಾಗಿ ಕಳೆ: 4.
			}, ನಿಲ್ಲಿಸು.
			
			(ಸಂಖ್ಯೆಯಾಗಿ ≥ 1) ಸತ್ಯವಾದರೆ: {
				roman ಕೊನೆಗೆ-ಸೇರಿಸು: ['Ⅰ'].
				ಸಂಖ್ಯೆಯಾಗಿ ಕಳೆ: 1.
			}, ನಿಲ್ಲಿಸು.
		} ಕಾರ್ಯವಿಧಾನ.
	} ಇರುವವರೆಗೆ: { <- ಸಂಖ್ಯೆಯಾಗಿ > 0. }. <- roman.
}.

