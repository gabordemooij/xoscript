# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> ಕಡತ-ಮಾರ್ಗ := ['/tmp/dat.csv'].
>> csv := ಕಡತ ಹೊಸ: ಕಡತ-ಮಾರ್ಗ.
csv ಬರೆ: s.

# accepts CRLF LF CR, varying row length
csv ವಿಭಜಕ: [';'] ಉದ್ಧರಣ: ['"'] ಸಾಲುಗಳು: { :line
	ಪ್ರೋಗ್ರಾಂ ಸ್ವಚ್ಛಗೊಳಿಸು.
	ಔಟ್-ಪುಟ್ ಬರೆ: line, ಹೊಸ-ಸಾಲು.
	ಪ್ರೋಗ್ರಾಂ ಸ್ವಚ್ಛಗೊಳಿಸು.
}.

# unequal lines
s ಕೊನೆಗೆ-ಸೇರಿಸು: ['\njustone'].
csv ಬರೆ: s.
{
	csv ವಿಭಜಕ: [';'] ಉದ್ಧರಣ: ['"'] ಸಾಲುಗಳು: { :line
		ಔಟ್-ಪುಟ್ ಬರೆ: line, ಹೊಸ-ಸಾಲು.
	}.
} ಹಿಡಿ: { :e 
	ಔಟ್-ಪುಟ್ ಬರೆ: e, ಹೊಸ-ಸಾಲು.
}, ಚಲಾಯಿಸು.

# invalid format
s := ['"he"llo";world'].
csv ಬರೆ: s.
{
	csv ವಿಭಜಕ: [';'] ಉದ್ಧರಣ: ['"'] ಸಾಲುಗಳು: { :line
		ಔಟ್-ಪುಟ್ ಬರೆ: line, ಹೊಸ-ಸಾಲು.
	}.
} ಹಿಡಿ: { :e 
	ಔಟ್-ಪುಟ್ ಬರೆ: e, ಹೊಸ-ಸಾಲು.
}, ಚಲಾಯಿಸು.
