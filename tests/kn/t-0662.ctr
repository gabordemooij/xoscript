>> t := ಶೂನ್ಯ.

# you can control the time zone for
# parsing like this:
ಕ್ಷಣ ಸಮಯ-ವಲಯ: ['CET'].
t := ಕ್ಷಣ ಮೂಲ: ['1981-02-03 04:05:06'].
ಔಟ್-ಪುಟ್ ಬರೆ: t, ಹೊಸ-ಸಾಲು.

# now using CEST time zone:
ಕ್ಷಣ ಸಮಯ-ವಲಯ: ['CEST'].
t := ಕ್ಷಣ ಮೂಲ: ['1981-02-03 04:05:06'].
ಔಟ್-ಪುಟ್ ಬರೆ: t, ಹೊಸ-ಸಾಲು.

# error if string cannot be parsed
{ ಕ್ಷಣ ಮೂಲ: ['1900']. } ಹಿಡಿ: { ಶೂನ್ಯ. }, ಚಲಾಯಿಸು.
