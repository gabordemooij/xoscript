Server init.

# JSON encoder only supports UTF-8, no surrogate pairs

>> dicts := ಸರಣಿ ಹೊಸ ;
	# {"key":"normal"} normal ASCII
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['normal'] ಕೀಲಿ: ['key'] ) ;
	# {"key":"hello world"} space character
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['hello world'] ಕೀಲಿ: ['key'] ) ;
	# {"key":"quote: \""} double quote
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['"'] ಕೀಲಿ: ['key'] ) ;
	# {"key":"backslash: \\"} backslash
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['backslash: \\'] ಕೀಲಿ: ['key'] ) ;
	# {"key":"slash: /"} slash
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['slash: /'] ಕೀಲಿ: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['backspace: \b'] ಕೀಲಿ: ['key'] ) ;
	# {"key":"formfeed: \f"} form-feed escape
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['formfeed: \f'] ಕೀಲಿ: ['key'] ) ;
	# {"key":"newline: \n"} newline
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['newline: \n'] ಕೀಲಿ: ['key'] ) ;
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['newline: ↵'] ಕೀಲಿ: ['key'] ) ;
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['newline: 
	'] ಕೀಲಿ: ['key'] ) ;
	# {"key":"carriage return: \r"} carriage-return
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['carriage return: \r'] ಕೀಲಿ: ['key'] ) ;
	# {"key":"tab: \t"} tab
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['tab \t'] ಕೀಲಿ: ['key'] ) ;
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['tab ⇿'] ಕೀಲಿ: ['key'] ) ;
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['tab  '] ಕೀಲಿ: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['NUL \u0000'] ಕೀಲಿ: ['key'] ) ;
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['NUL \0'] ಕೀಲಿ: ['key'] ) ;
	# {"key":"control: \u0001"} control character 0x01
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['control: \u0001'] ಕೀಲಿ: ['key'] ) ;
	# {"key":"control: \u001F"} control character 0x1F
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['control: \u001F'] ಕೀಲಿ: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-byte char
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['unicode: é'] ಕೀಲಿ: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-byte char
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['unicode: €'] ಕೀಲಿ: ['key'] ) ;
	# {"key":"unicode: 日本語"} multiple 3-byte UTF-8 chars
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['unicode: 日本語'] ಕೀಲಿ: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-byte char
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['unicode: 😀'] ಕೀಲಿ: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['unicode: 🧑‍💻'] ಕೀಲಿ: ['key'] ) ;
	# {"key":"combining: e\u0301"} combining accent
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['combining: e\u0301'] ಕೀಲಿ: ['key'] ) ;
	# {"key":"escaped unicode: \u00e9"} Unicode escape BMP
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['escaped unicode: \u00e9'] ಕೀಲಿ: ['key'] ) ;
	# {"key":"escaped unicode: \u20ac"} Unicode escape BMP
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['escaped unicode: \u20ac'] ಕೀಲಿ: ['key'] ) ;
	# {"key":"escaped unicode: \ud83d\ude00"} UTF-16 surrogate pair
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['escaped unicode: \ud83d\ude00'] ಕೀಲಿ: ['key'] ) ;
	# {"key":""} empty value
	( ನಿಘಂಟು ಹೊಸ ಇಡು: [''] ಕೀಲಿ: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} special ASCII chars
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['@ < > & = % + ? #'] ಕೀಲಿ: ['key'] ) ;
	# {"key":"single quote: '"} single quote
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['''] ಕೀಲಿ: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} multiple JSON escapes
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['multiple: \" \\ \n \r \t'] ಕೀಲಿ: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} longer ASCII-string
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] ಕೀಲಿ: ['key'] ) ;
	# {"key":" value"} leading space
	( ನಿಘಂಟು ಹೊಸ ಇಡು: [' value'] ಕೀಲಿ: ['key'] ) ;
	# {"key":"value "} trailing space
	( ನಿಘಂಟು ಹೊಸ ಇಡು: ['value '] ಕೀಲಿ: ['key'] ) ;
	# {"key":" \t\n\r "} whitespace
	( ನಿಘಂಟು ಹೊಸ ಇಡು: [' \t\n\r '] ಕೀಲಿ: ['key'] ).

dicts ಪ್ರತಿಯೊಂದು: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (ನಿಘಂಟು ಹೊಸ ಇಡು: d key ಕೀಲಿ: ['key']).
	>> b := JSON jsonify: (ನಿಘಂಟು ಹೊಸ ಇಡು: ['value'] ಕೀಲಿ: d key).
	>> e := JSON ವಸ್ತು: a.
	>> f := JSON ವಸ್ತು: b.
	((e key = d key ಮತ್ತು: (f ? d key = ['value'])) ಅಥವಾ: (e key = ['NUL ?'])) ಸತ್ಯವಾದರೆ: {
		ಔಟ್-ಪುಟ್ ಬರೆ: ['OK'], ಹೊಸ-ಸಾಲು.
	}, ಇಲ್ಲದಿದ್ದರೆ: {
		ಔಟ್-ಪುಟ್ ಬರೆ: ['Unable to properly encode/decode: '] + d + j, ಹೊಸ-ಸಾಲು.
		ಪ್ರೋಗ್ರಾಂ ಮುಗಿಸು.
	}.
}.
