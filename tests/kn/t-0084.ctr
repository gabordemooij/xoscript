>> makeAdder := { :x
	>> f := { :y <- (ತನ್ನ x + y). } ನಿಗದಿಪಡಿಸು: ['x'] ಮೌಲ್ಯ: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i ತನ್ನ q ಇಡು: (ತನ್ನ f ಅನ್ವಯಿಸು: (ತನ್ನ q ? i)) ಕೀಲಿ: i. } 
	ನಿಗದಿಪಡಿಸು: ['q'] ಮೌಲ್ಯ: array,
	ನಿಗದಿಪಡಿಸು: ['f'] ಮೌಲ್ಯ: func.
	{ :i mapping ಅನ್ವಯಿಸು: i. } × (array ಎಣಿಕೆ).
}.

>> a := ಸರಣಿ ← 1; 2; 3.
mapper ಅನ್ವಯಿಸು: a ಮತ್ತು: (makeAdder ಅನ್ವಯಿಸು: 100).
ಔಟ್-ಪುಟ್ ಬರೆ: (a ಸ್ಥಾನ: 0), ಹೊಸ-ಸಾಲು.
ಔಟ್-ಪುಟ್ ಬರೆ: (a ? 1), ಹೊಸ-ಸಾಲು.
ಔಟ್-ಪುಟ್ ಬರೆ: (a ? 2), ಹೊಸ-ಸಾಲು.
