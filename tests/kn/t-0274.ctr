

ಸರಣಿ ಬಂದಾಗ: ['column:'] ಮಾಡು: { :column
	>> result := ಸರಣಿ ಹೊಸ.
	ತಾನು ಪ್ರತಿಯೊಂದು: { :index :row
		row ಪ್ರತಿಯೊಂದು: { :index :cell
			(index = column) ಸತ್ಯವಾದರೆ: { result ಕೊನೆಗೆ-ಸೇರಿಸು: cell. }.
		}.
	}. <- result.
}.


>> a := ಸರಣಿ ←
	(ಸರಣಿ ← 1 ; 2 ; 3) ;
	(ಸರಣಿ ← 4 ; 5 ; 6) ;
	(ಸರಣಿ ← 7 ; 8 ; 9).

>> b := a column: 1.
ಔಟ್-ಪುಟ್ ಬರೆ: b, ಹೊಸ-ಸಾಲು.

b := a column: 20.
ಔಟ್-ಪುಟ್ ಬರೆ: b, ಹೊಸ-ಸಾಲು.

b := a column: -100.
ಔಟ್-ಪುಟ್ ಬರೆ: b, ಹೊಸ-ಸಾಲು.
