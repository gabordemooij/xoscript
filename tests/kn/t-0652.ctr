# test number -> string -> number
{

	>> x := ಸಂಖ್ಯೆ ನಡುವೆ: 0 ಇಂದ: 1000000.
	>> d := ಸಂಖ್ಯೆ ನಡುವೆ: 1 ಇಂದ: 7.
	>> e := 10 ಘಾತ: d.

	x ಭಾಗಿಸು: e.
	>> y := x ಪಠ್ಯವಾಗಿ ಸಂಖ್ಯೆಯಾಗಿ.

	(x = y) ಸುಳ್ಳಾದರೆ: {
		ಔಟ್-ಪುಟ್ ಬರೆ: x, ಹೊಸ-ಸಾಲು.
		ಔಟ್-ಪುಟ್ ಬರೆ: y, ಹೊಸ-ಸಾಲು.
		ಪ್ರೋಗ್ರಾಂ ಮುಗಿಸು.
	}.

} * 1000.
ಔಟ್-ಪುಟ್ ಬರೆ: ['OK'], ಹೊಸ-ಸಾಲು.