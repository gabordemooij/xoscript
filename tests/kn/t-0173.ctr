

ಸರಣಿ ಬಂದಾಗ: ['sum'] ಮಾಡು: {
	>> total := 0.
	ತಾನು ಪ್ರತಿಯೊಂದು: { :index :element
		total ಕೂಡಿಸು: element.
	}. <- total.
}.

ಸರಣಿ ಬಂದಾಗ: ['product'] ಮಾಡು: {
	>> total := 1.
	ತಾನು ಪ್ರತಿಯೊಂದು: { :index :element
		total ಗುಣಿಸು: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

ಪ್ರೋಗ್ರಾಂ ಮೆಮೊರಿ-ನಿರ್ವಹಣೆ: 0.

{

>> a := ಸರಣಿ ← ['hello'] ; ['world'] ; ಸತ್ಯ ; ಶೂನ್ಯ ; 666.
a := a + ( ಸರಣಿ ← 1 ).
ಔಟ್-ಪುಟ್ ಬರೆ: ( ['sum: '] + ( a sum ) ), ಹೊಸ-ಸಾಲು.
ಔಟ್-ಪುಟ್ ಬರೆ: ( ['min: '] + ( a ಕನಿಷ್ಠ ) ), ಹೊಸ-ಸಾಲು.
ಔಟ್-ಪುಟ್ ಬರೆ: ( ['max: '] + ( a ಗರಿಷ್ಠ ) ), ಹೊಸ-ಸಾಲು.
ಔಟ್-ಪುಟ್ ಬರೆ: ( ['3rd: '] + ( a ? 2 ) ), ಹೊಸ-ಸಾಲು.
ಔಟ್-ಪುಟ್ ಬರೆ: ( ['prd: '] + ( a product ) ), ಹೊಸ-ಸಾಲು.
a ವಿಂಗಡಿಸು: { :a :b <- (b - a). }.
a ಪ್ರತಿಯೊಂದು: { :i :e ಔಟ್-ಪುಟ್ ಬರೆ: ( i - 0 ), ಹೊಸ-ಸಾಲು. }.

} ಚಲಾಯಿಸು.

ಪ್ರೋಗ್ರಾಂ ಸ್ವಚ್ಛಗೊಳಿಸು.
usedMemory1 := (ಪ್ರೋಗ್ರಾಂ ಮೆಮೊರಿ ? 0).


