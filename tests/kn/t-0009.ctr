>> Greeter := ವಸ್ತು ಹೊಸ.
Greeter ಬಂದಾಗ: ['make'] ಮಾಡು: {
	>> greeter := ವಸ್ತು ಹೊಸ.
	greeter ಬಂದಾಗ: ['name:'] ಮಾಡು: { :ಹೆಸರು
		ಔಟ್-ಪುಟ್ ಬರೆ: ['setting a name'].
		ತನ್ನ myName := ಹೆಸರು.
	}.
	greeter ಬಂದಾಗ: ['performGreeting'] ಮಾಡು: {
		ಔಟ್-ಪುಟ್ ಬರೆ: ['Hello'].
		ಔಟ್-ಪುಟ್ ಬರೆ: ತನ್ನ myName.
	}.
	greeter ಬಂದಾಗ: ['greet'] ಮಾಡು: {
		ತಾನು performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
