# a format must fit the type of the value, the type can come from a client
>> ಪ್ರಯತ್ನಿಸು := { :format :value
	{ ಔಟ್-ಪುಟ್ ಬರೆ: ( (ಸ್ವರೂಪ ಹೊಸ: format) ಅನ್ವಯಿಸು: value ), ಹೊಸ-ಸಾಲು. } ಹಿಡಿ: { :e ಔಟ್-ಪುಟ್ ಬರೆ: e, ಹೊಸ-ಸಾಲು. }, ಚಲಾಯಿಸು.
}.
>> try-int := { :format :value
	{ ಔಟ್-ಪುಟ್ ಬರೆ: ( (ಸ್ವರೂಪ ಹೊಸ: format) ಅನ್ವಯಿಸು-ಪೂರ್ಣಾಂಕ: value ), ಹೊಸ-ಸಾಲು. } ಹಿಡಿ: { :e ಔಟ್-ಪುಟ್ ಬರೆ: e, ಹೊಸ-ಸಾಲು. }, ಚಲಾಯಿಸು.
}.

# fits
ಪ್ರಯತ್ನಿಸು ಅನ್ವಯಿಸು: ['|%s|'] ಮತ್ತು: ['text'].
ಪ್ರಯತ್ನಿಸು ಅನ್ವಯಿಸು: ['%06.2f'] ಮತ್ತು: 5.5.
ಪ್ರಯತ್ನಿಸು ಅನ್ವಯಿಸು: ['100%% %s'] ಮತ್ತು: ['sure'].
try-int ಅನ್ವಯಿಸು: ['%03d'] ಮತ್ತು: 7.
try-int ಅನ್ವಯಿಸು: ['%x'] ಮತ್ತು: 255.
ಪ್ರಯತ್ನಿಸು ಅನ್ವಯಿಸು: ['%d'] ಮತ್ತು: (Int64 ಹೊಸ ಪಠ್ಯದಿಂದ: ['12']).
ಪ್ರಯತ್ನಿಸು ಅನ್ವಯಿಸು: ['%lld'] ಮತ್ತು: (Int64 ಹೊಸ ಪಠ್ಯದಿಂದ: ['12']).
ಪ್ರಯತ್ನಿಸು ಅನ್ವಯಿಸು: ['%.1lf'] ಮತ್ತು: 5.5.
try-int ಅನ್ವಯಿಸು: ['%hd'] ಮತ್ತು: 7.

# does not fit
ಪ್ರಯತ್ನಿಸು ಅನ್ವಯಿಸು: ['%s'] ಮತ್ತು: 12345.
ಪ್ರಯತ್ನಿಸು ಅನ್ವಯಿಸು: ['%d'] ಮತ್ತು: 12345.
ಪ್ರಯತ್ನಿಸು ಅನ್ವಯಿಸು: ['%f'] ಮತ್ತು: ['text'].
try-int ಅನ್ವಯಿಸು: ['%d'] ಮತ್ತು: ['text'].
try-int ಅನ್ವಯಿಸು: ['%s'] ಮತ್ತು: 5.
ಪ್ರಯತ್ನಿಸು ಅನ್ವಯಿಸು: ['%s %s'] ಮತ್ತು: ['text'].
ಪ್ರಯತ್ನಿಸು ಅನ್ವಯಿಸು: ['%n'] ಮತ್ತು: ['text'].
ಪ್ರಯತ್ನಿಸು ಅನ್ವಯಿಸು: ['%*s'] ಮತ್ತು: ['text'].
ಪ್ರಯತ್ನಿಸು ಅನ್ವಯಿಸು: ['%'] ಮತ್ತು: ['text'].

# length modifier does not fit
ಪ್ರಯತ್ನಿಸು ಅನ್ವಯಿಸು: ['%ls'] ಮತ್ತು: ['text'].
ಪ್ರಯತ್ನಿಸು ಅನ್ವಯಿಸು: ['%Lf'] ಮತ್ತು: 5.5.
try-int ಅನ್ವಯಿಸು: ['%ld'] ಮತ್ತು: 7.
try-int ಅನ್ವಯಿಸು: ['%lld'] ಮತ್ತು: 7.
ಪ್ರಯತ್ನಿಸು ಅನ್ವಯಿಸು: ['%Ld'] ಮತ್ತು: (Int64 ಹೊಸ ಪಠ್ಯದಿಂದ: ['12']).

# a width that does not fit printf must give an error, not a crash
ಪ್ರಯತ್ನಿಸು ಅನ್ವಯಿಸು: ['%99999999999s'] ಮತ್ತು: ['text'].
