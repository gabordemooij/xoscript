#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := ಮಾದರಿ ಹೊಸ: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern ಹೊಂದಿಕೆ: subject ಮಾಡು: { :m :x
	ಔಟ್-ಪುಟ್ ಬರೆ: m, ಹೊಸ-ಸಾಲು.
	ಔಟ್-ಪುಟ್ ಬರೆ: x, ಹೊಸ-ಸಾಲು. <- ['XXX'].
}.
ಔಟ್-ಪುಟ್ ಬರೆ: result, ಹೊಸ-ಸಾಲು.