Server init.

>> DB := Maria-DB ಹೊಸ ಹೋಸ್ಟ್: ['localhost'],
	ಬಳಕೆದಾರ-ಹೆಸರು: ['xo'],
	ಗುಪ್ತಪದ: ['pass123'],
	ದತ್ತಸಂಚಯ-ಹೆಸರು: ['xobase'],
	ಸಂಪರ್ಕಿಸು.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB ಪ್ರಶ್ನೆ: SQL.

# now you don't have to set DB
query2 ತರು: { :row
	ಔಟ್-ಪುಟ್ ಬರೆ: row world, ಹೊಸ-ಸಾಲು.
}.
