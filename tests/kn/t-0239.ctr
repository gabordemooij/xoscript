ಸರಣಿ ಬಂದಾಗ: ['sum'] ಮಾಡು: {
	>> total := 0.
	ತಾನು ಪ್ರತಿಯೊಂದು: { :index :element
		total ಕೂಡಿಸು: element.
	}. <- total.
}.

>> a := ಸತ್ಯ.



a ಬಂದಾಗ: ['ಪಠ್ಯವಾಗಿ'] ಮಾಡು: {
	>> answer := ಶೂನ್ಯ.
	( ತಾನು = ಸತ್ಯ ) ಸತ್ಯವಾದರೆ: {
		answer := ['Yep'].
	}, ಇಲ್ಲದಿದ್ದರೆ: {
		answer := ['Nope'].
	}. <- answer.
}.

a ಬಂದಾಗ: ['ಸಂಖ್ಯೆಯಾಗಿ'] ಮಾಡು: {
	>> answer := ಶೂನ್ಯ.
	( ತಾನು = ಸತ್ಯ ) ಸತ್ಯವಾದರೆ: {
		answer := 10.
	}, ಇಲ್ಲದಿದ್ದರೆ: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b ಬಂದಾಗ: ['ಪಠ್ಯವಾಗಿ'] ಮಾಡು: { <- ['Devil'].
}.

b ಬಂದಾಗ: ['ಬೂಲಿಯನ್-ಆಗಿ'] ಮಾಡು: { <- ಸುಳ್ಳು.
}.


ಔಟ್-ಪುಟ್ ಬರೆ: a, ಹೊಸ-ಸಾಲು.  
ಔಟ್-ಪುಟ್ ಬರೆ: (90 + a), ಹೊಸ-ಸಾಲು. 
ಔಟ್-ಪುಟ್ ಬರೆ: b, ಹೊಸ-ಸಾಲು. 
ಔಟ್-ಪುಟ್ ಬರೆ: (ಸತ್ಯ ಮತ್ತು: b), ಹೊಸ-ಸಾಲು.

a := ಸರಣಿ ← ['hello'] ; ['world'] ; ಸತ್ಯ ; ಶೂನ್ಯ ; 666. 
a := a + ( ಸರಣಿ ← 1 ).
ಔಟ್-ಪುಟ್ ಬರೆ: a, ಹೊಸ-ಸಾಲು.
ಔಟ್-ಪುಟ್ ಬರೆ: ((ನಿಘಂಟು ಹೊಸ) ಇಡು: ಶೂನ್ಯ ಕೀಲಿ: ಶೂನ್ಯ), ಹೊಸ-ಸಾಲು.
ಔಟ್-ಪುಟ್ ಬರೆ: a sum, ಹೊಸ-ಸಾಲು. 


{
	a ಬಂದಾಗ: ['ಪಠ್ಯವಾಗಿ'] ಮಾಡು: { <- ಶೂನ್ಯ. }.
	a := [''] + a.
} ಹಿಡಿ: { :error
	ಔಟ್-ಪುಟ್ ಬರೆ: ['Error noted: '] + error, ಹೊಸ-ಸಾಲು.
}, ಚಲಾಯಿಸು.



{
	a ಬಂದಾಗ: ['ಸಂಖ್ಯೆಯಾಗಿ'] ಮಾಡು: { <- ಶೂನ್ಯ. }.
	a := 3 × a.
} ಹಿಡಿ: { :error
	ಔಟ್-ಪುಟ್ ಬರೆ: ['Error noted: '] + error, ಹೊಸ-ಸಾಲು.
}, ಚಲಾಯಿಸು.


