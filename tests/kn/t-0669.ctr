# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := ತಿಜೋರಿ 
	ಗುಪ್ತಪದ-ಹ್ಯಾಶ್: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := ತಿಜೋರಿ 
	ಗುಪ್ತಪದ-ಹ್ಯಾಶ್: hash ಪರಿಶೀಲಿಸು: a1.
	# fail 
>> b := ತಿಜೋರಿ
	ಗುಪ್ತಪದ-ಹ್ಯಾಶ್: hash ಪರಿಶೀಲಿಸು: a2.
	# ok!

ಔಟ್-ಪುಟ್ ಬರೆ: a, ಹೊಸ-ಸಾಲು.
ಔಟ್-ಪುಟ್ ಬರೆ: b, ಹೊಸ-ಸಾಲು.

