60 × {
	>> x := (ಸಂಖ್ಯೆ random % 6) + 1.
	(x ≤ 6) ಸುಳ್ಳಾದರೆ: { ಔಟ್-ಪುಟ್ ಬರೆ: ['FAIL']. }.
	(x ≥0) ಸುಳ್ಳಾದರೆ: { ಔಟ್-ಪುಟ್ ಬರೆ: ['FAIL']. }.
	x := (ಸಂಖ್ಯೆ random % 3) + 1.
	(x < 3) ಸುಳ್ಳಾದರೆ: { ಔಟ್-ಪುಟ್ ಬರೆ: ['FAIL']. }.
	(x>-1) ಸುಳ್ಳಾದರೆ: { ಔಟ್-ಪುಟ್ ಬರೆ: ['FAIL']. }.
	x := ((ಬೂಲಿಯನ್ flip) ಸಂಖ್ಯೆಯಾಗಿ).
	(x = 0 ಅಥವಾ: x = 1) ಸುಳ್ಳಾದರೆ: { ಔಟ್-ಪುಟ್ ಬರೆ: ['FAIL']. }.
	x := ((ಸತ್ಯ flip) ಸಂಖ್ಯೆಯಾಗಿ).
	(x = 0 ಅಥವಾ: x = 1) ಸುಳ್ಳಾದರೆ: { ಔಟ್-ಪುಟ್ ಬರೆ: ['FAIL']. }.
	x := (ಬೂಲಿಯನ್ flip ಇದು: ['HEAD'] ಇಲ್ಲವೇ: ['TAIL']).
	((x = ['HEAD']) ಅಥವಾ: (x = ['TAIL'])) ಸುಳ್ಳಾದರೆ: { ಔಟ್-ಪುಟ್ ಬರೆ: ['FAIL']. }.
}.
ಔಟ್-ಪುಟ್ ಬರೆ: ['DONE'].

