# a value ending in the first part of an opening quote must survive serialization
>> ಮೌಲ್ಯಗಳು := ಸರಣಿ ಹೊಸ
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

ಮೌಲ್ಯಗಳು ಪ್ರತಿಯೊಂದು: { :i :value
	>> d := ನಿಘಂಟು ಹೊಸ.
	d ಇಡು: value ಕೀಲಿ: ['k'].
	d ಇಡು: ['second'] ಕೀಲಿ: ['j'].
	>> r := d ಕೋಡ್ ವಸ್ತುವಾಗಿ.
	ಔಟ್-ಪುಟ್ ಬರೆ: r ಎಣಿಕೆ, ಹೊಸ-ಸಾಲು.
	ಔಟ್-ಪುಟ್ ಬರೆ: ( (r ಅಲ್ಲಿ: ['k']) = value ), ಹೊಸ-ಸಾಲು.
}.
