#Linux

 >> t := ಕ್ಷಣ ಹೊಸ.
 
t ಸಮಯ-ವಲಯ: ['Europe/Amsterdam'].
t ವರ್ಷ: 2020, ತಿಂಗಳು: 8, ದಿನ: 2, ಗಂಟೆ: 21, ನಿಮಿಷ: 2, ಸೆಕೆಂಡು: 1.

>> a := t ಗಂಟೆ.
>> ams := t ಸಮಯ-ವಲಯ.

t ಸಮಯ-ವಲಯ: ['US/Hawaii'].
>> b := t ಗಂಟೆ.
>> hw := t ಸಮಯ-ವಲಯ.

ಔಟ್-ಪುಟ್
ಬರೆ: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		ಇದು: ['later'] ಇಲ್ಲವೇ: ['earlier']
	)
),
ಹೊಸ-ಸಾಲು.
 