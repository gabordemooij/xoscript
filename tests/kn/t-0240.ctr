# test qualifiers

>> $ := ವಸ್ತು ಹೊಸ.

$ ಬಂದಾಗ: ['ಉತ್ತರಿಸು:'] ಮಾಡು: { :x
	
	>> operation := x ಅಕ್ಷರ: 0.
	>> valuta := x ಅಕ್ಷರ: 1.
	>> money := x ಬಿಟ್ಟುಬಿಡು: 2.
	
	>> amount := 0.

	( operation = ['+'] ) ಸತ್ಯವಾದರೆ: {
		( valuta = ['£'] ) ಸತ್ಯವಾದರೆ: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

ಔಟ್-ಪುಟ್ ಬರೆ: x, ಹೊಸ-ಸಾಲು.


>> Fruit := ವಸ್ತು ಹೊಸ.

Fruit ಬಂದಾಗ: ['ಹೊಸ'] ಮಾಡು: {
	>> f := ತಾನು ಹೊಸ.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit ಬಂದಾಗ: ['apples:'] ಮಾಡು: { :a ತನ್ನ apples := a. }.
Fruit ಬಂದಾಗ: ['oranges:'] ಮಾಡು: { :p ತನ್ನ oranges := p. }.
Fruit ಬಂದಾಗ: ['apples'] ಮಾಡು: { <- ತನ್ನ apples. }.
Fruit ಬಂದಾಗ: ['oranges'] ಮಾಡು: { <- ತನ್ನ oranges. }.

Fruit ಬಂದಾಗ: ['+'] ಮಾಡು: { :f
	
	>> n := Fruit ಹೊಸ.
	f ಕೂಡಿಸು: 1.
	
	n apples: (f apples + ತನ್ನ apples).
	n oranges:  (f oranges  + ತನ್ನ oranges). <- n.
}.

Fruit ಬಂದಾಗ: ['ಪಠ್ಯವಾಗಿ'] ಮಾಡು: { <- ( ತನ್ನ apples ಪಠ್ಯವಾಗಿ + [' apples and '] + ತನ್ನ oranges + [' oranges'] ).
}.

ಸಂಖ್ಯೆ ಬಂದಾಗ: ['apples'] ಮಾಡು: { <- ((Fruit ಹೊಸ) apples: ತಾನು).
}.

ಸಂಖ್ಯೆ ಬಂದಾಗ: ['apple'] ಮಾಡು: { <- ((Fruit ಹೊಸ) apples: ತಾನು).
}.

ಸಂಖ್ಯೆ ಬಂದಾಗ: ['oranges'] ಮಾಡು: { <- ((Fruit ಹೊಸ) oranges: ತಾನು).
}.




ಔಟ್-ಪುಟ್ ಬರೆ: (1 apple + 3 oranges + 4 apples), ಹೊಸ-ಸಾಲು.


ಪಠ್ಯ ಬಂದಾಗ: ['twice'] ಮಾಡು: { <- ((ತಾನು ಪಠ್ಯವಾಗಿ) + (ತಾನು ಪಠ್ಯವಾಗಿ)).
}.



ಔಟ್-ಪುಟ್ ಬರೆ: ['❤❤❤'] twice.



