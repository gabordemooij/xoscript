# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := ಮಾದರಿ ಹೊಸ: pattern.
	p ಹೊಂದಿಕೆ: subject ಮಾಡು: { :m :g
		ಔಟ್-ಪುಟ್ ಬರೆ: g ಎಣಿಕೆ, ಬರೆ: [' '], ಬರೆ: (g ಸೇರಿಸು: ['|']), ಹೊಸ-ಸಾಲು. <- m.
	}.
}.
show ಅನ್ವಯಿಸು: ['(a)|(b)'] ಮತ್ತು: ['b'].
show ಅನ್ವಯಿಸು: ['(a)|(b)'] ಮತ್ತು: ['a'].
show ಅನ್ವಯಿಸು: ['(x)?y'] ಮತ್ತು: ['y'].
show ಅನ್ವಯಿಸು: ['(x)?(y)(z)?'] ಮತ್ತು: ['xy'].
