>> phrases := ಸರಣಿ ಹೊಸ
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases ಪ್ರತಿಯೊಂದು: { :_ :phrase 
	>> e := Server base64-ಎನ್-ಕೋಡ್: phrase.
	>> d := Server base64-ಡಿಕೋಡ್: e.
	ಔಟ್-ಪುಟ್ ಬರೆ: (
		message ನಕಲು ~encoded: e, ~decoded: d
	), ಹೊಸ-ಸಾಲು.
}.
