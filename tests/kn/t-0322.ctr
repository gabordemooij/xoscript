

>> Matryoshka := ವಸ್ತು ಹೊಸ.
Matryoshka ಬಂದಾಗ: ['double:'] ಮಾಡು: { :secret
	ತನ್ನ secret := secret × 2.
}.
Matryoshka ಬಂದಾಗ: ['ಹೊಸ:'] ಮಾಡು: { :secret
	>> answer := ಶೂನ್ಯ.
	>> t := (secret > 255).
	ಔಟ್-ಪುಟ್ ಬರೆ: (secret + [' | '] + t), ಹೊಸ-ಸಾಲು.
	t ಸತ್ಯವಾದರೆ: {
		answer := secret.
	}, ಇಲ್ಲದಿದ್ದರೆ: {
		answer := Matryoshka ಪುನರಾವರ್ತಿತ ಹೊಸ: (ತಾನು double: secret).
	}. <- answer.
}.

>> x := Matryoshka ಹೊಸ: 2.
