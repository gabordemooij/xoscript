
>> dictionary := (
	ನಿಘಂಟು ಹೊಸ
		ಇಡು: ['b'] ಕೀಲಿ: ['a'],
		ಇಡು: ['a'] ಕೀಲಿ: ['b'],
		ಇಡು: ['z'] ಕೀಲಿ: ['x'],
		ಇಡು: ['hello'] ಕೀಲಿ: ['hallo'],
		ಇಡು: ['human'] ಕೀಲಿ: ['human']
).

>> comparisons := ಸರಣಿ ಹೊಸ.
dictionary ಪ್ರತಿಯೊಂದು: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a ಹೋಲಿಸು: b)
	).
}.

comparisons ವಿಂಗಡಿಸು: { :a :b <- ( a ಹೋಲಿಸು: b ). }.
ಔಟ್-ಪುಟ್ ಬರೆ: ( comparisons ಸೇರಿಸು: ['↵'] ), ಹೊಸ-ಸಾಲು.
comparisons ಸೇರಿಸು: ['↵'].
