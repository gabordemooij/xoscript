

>> obj := ವಸ್ತು ಹೊಸ.

obj ಬಂದಾಗ: ['greet'] ಮಾಡು: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj ಬಂದಾಗ: ['task'] ಮಾಡು: {
	ತನ್ನ property := 123.
	{
		# try binds self/own to object instead of block
		ಔಟ್-ಪುಟ್ ಬರೆ: ತಾನು greet.
		ಔಟ್-ಪುಟ್ ಬರೆ: ತನ್ನ property.
		1 / 0.
	} ಹಿಡಿ: {
		ಔಟ್-ಪುಟ್ ಬರೆ: ತಾನು greet.
		ಔಟ್-ಪುಟ್ ಬರೆ: ತನ್ನ property.
		ಔಟ್-ಪುಟ್ ಬರೆ: ['ok'].
	}, ಪ್ರಯತ್ನಿಸು.
}.

obj task.