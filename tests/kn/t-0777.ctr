#OBSD
>> dirname := [''].
{ dirname ಕೊನೆಗೆ-ಸೇರಿಸು: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
ಪ್ರೋಗ್ರಾಂ ವ್ಯವಸ್ಥೆ: command.
ಪ್ರೋಗ್ರಾಂ chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename ಕೊನೆಗೆ-ಸೇರಿಸು: ['YYYYYYYY']. } * 20.
ಕಡತ ಹೊಸ: filename, ಬರೆ: ['sometext'].
{ ಕಡತ ಪಟ್ಟಿ: ['/tmp/'] + dirname. } * 1000.
ಔಟ್-ಪುಟ್ ಬರೆ: ['no crash'], ಹೊಸ-ಸಾಲು.

