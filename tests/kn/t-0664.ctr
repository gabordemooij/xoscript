# recursive interpolation not allowed

ಔಟ್-ಪುಟ್ ಬರೆ: 
['recursive string interolation enabled: '] + (
	ಪ್ರೋಗ್ರಾಂ ಸೌಲಭ್ಯ: 
	['RECURSIVE_STRINTPOL']
), ಹೊಸ-ಸಾಲು.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

ಔಟ್-ಪುಟ್ ಬರೆ: a, ಹೊಸ-ಸಾಲು.


ಪ್ರೋಗ್ರಾಂ ಸೌಲಭ್ಯ: ['RECURSIVE_STRINTPOL'] ಸಕ್ರಿಯ: ಸತ್ಯ.

ಔಟ್-ಪುಟ್ ಬರೆ: 
['recursive string interpolation enabled: '] + (
	ಪ್ರೋಗ್ರಾಂ ಸೌಲಭ್ಯ: 
	['RECURSIVE_STRINTPOL']
), ಹೊಸ-ಸಾಲು.

>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

ಔಟ್-ಪುಟ್ ಬರೆ: a, ಹೊಸ-ಸಾಲು.

ಪ್ರೋಗ್ರಾಂ ಸೌಲಭ್ಯ: ['RECURSIVE_STRINTPOL'] ಸಕ್ರಿಯ: ಸುಳ್ಳು.

ಔಟ್-ಪುಟ್ ಬರೆ: 
['recursive string interpolation enabled: '] + (
	ಪ್ರೋಗ್ರಾಂ ಸೌಲಭ್ಯ: 
	['RECURSIVE_STRINTPOL']
), ಹೊಸ-ಸಾಲು.

>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

ಔಟ್-ಪುಟ್ ಬರೆ: a, ಹೊಸ-ಸಾಲು.
