	ಈ-ಕಾರ್ಯ ದೋಷ: ['Dont fail.'].
	ತನ್ನ unknown doSomething.
} ಹಿಡಿ: {
	ಔಟ್-ಪುಟ್ ಬರೆ: ['Caught!'].
}, ಚಲಾಯಿಸು.

{
	ಈ-ಕಾರ್ಯ ದೋಷ: ['Dont fail.'].
	unknown := 122.
} ಹಿಡಿ: {
	ಔಟ್-ಪುಟ್ ಬರೆ: ['Caught!'].
}, ಚಲಾಯಿಸು.


{
	ಈ-ಕಾರ್ಯ ದೋಷ: ['Dont fail.'].
	ಸತ್ಯ ನಿಲ್ಲಿಸು.
	ಔಟ್-ಪುಟ್ ಬರೆ: ['FAIL'].
} ಹಿಡಿ: {
	ಔಟ್-ಪುಟ್ ಬರೆ: ['Caught!'].
}, ಚಲಾಯಿಸು.

{
	{
		ಈ-ಕಾರ್ಯ ದೋಷ: ['Dont fail.'].
		ಸತ್ಯ ನಿಲ್ಲಿಸು.
		ಔಟ್-ಪುಟ್ ಬರೆ: ['FAIL'].
	} ಹಿಡಿ: { :x
		(x = ['Dont fail.']) ಸತ್ಯವಾದರೆ: { ಈ-ಕಾರ್ಯ ದೋಷ: ['Nested Caught!']. }.
	}, ಚಲಾಯಿಸು.
} ಹಿಡಿ: { :e
	ಔಟ್-ಪುಟ್ ಬರೆ: e.
}, ಚಲಾಯಿಸು.
