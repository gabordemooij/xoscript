>> items := ನಿಘಂಟು ಹೊಸ.
items ಇಡು: ['green'] ಕೀಲಿ: ['color-1'].
items ಇಡು: ['orange'] ಕೀಲಿ: ['color-2'].
items ಇಡು: ['red'] ಕೀಲಿ: ['color-3'].
>> i := 0.
>> s := [''].
items ಪ್ರತಿಯೊಂದು: { :key :color
	ಔಟ್-ಪುಟ್ ಬರೆ: ['color #'] + i + [' is: '] + color + [' '].
	i ಕೂಡಿಸು: 1.
}.
ಔಟ್-ಪುಟ್ ಬರೆ: i + [' colors!'].
