>> randomizer := { :a :b
	>> ಕನಿಷ್ಠ := ( a < b ) ಇದು: a ಇಲ್ಲವೇ: b.
	>> ಗರಿಷ್ಠ := ( a > b ) ಇದು: a ಇಲ್ಲವೇ: b.
	>> x := ಶೂನ್ಯ.
	{
		x := ಸಂಖ್ಯೆ ನಡುವೆ: a ಇಂದ: b.
		((x < ಕನಿಷ್ಠ) ಅಥವಾ: (x > ಗರಿಷ್ಠ)) ಸತ್ಯವಾದರೆ: { 
			ಔಟ್-ಪುಟ್ ಬರೆ: (['Invalid value!']).
			ಪ್ರೋಗ್ರಾಂ ಮುಗಿಸು.
		}.
	} 
	× 100. <- x.
}.
