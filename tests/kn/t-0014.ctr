>> Greeter := ವಸ್ತು ಹೊಸ.
Greeter ಬಂದಾಗ: ['make'] ಮಾಡು: {
	>> gr := ವಸ್ತು ಹೊಸ.
	gr ಬಂದಾಗ: ['setName:'] ಮಾಡು: { :aname
		ತನ್ನ ಹೆಸರು := aname.
	}.
	gr ಬಂದಾಗ: ['greet'] ಮಾಡು: {
		ಔಟ್-ಪುಟ್ ಬರೆ: ತನ್ನ ಹೆಸರು.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a ಹೊಸ.
c setName: ['THREE'].
c greet.
>> d := a ಹೊಸ.
d setName: ['FOUR'].
d greet.
c greet.
