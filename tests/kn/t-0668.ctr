# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob ಹೊಸ: 8, bytes: (
	ಸರಣಿ ಹೊಸ ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

ಔಟ್-ಪುಟ್ ಬರೆ: ( utf16 ಡಿಕೋಡ್: ['utf16le'] ), ಹೊಸ-ಸಾಲು.

utf16 ಬಿಡುಗಡೆ.
>> utf32 := Blob ಹೊಸ: 13, bytes: (
	ಸರಣಿ ಹೊಸ ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

ಔಟ್-ಪುಟ್ ಬರೆ: ( utf32 ಡಿಕೋಡ್: ['utf32be'] ), ಹೊಸ-ಸಾಲು.
utf32 ಬಿಡುಗಡೆ.