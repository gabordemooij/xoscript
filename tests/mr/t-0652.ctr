# test number -> string -> number
{

	>> x := संख्या दरम्यान: 0 आणि: 1000000.
	>> d := संख्या दरम्यान: 1 आणि: 7.
	>> e := 10 घात: d.

	x भागा: e.
	>> y := x मजकुरात संख्येत.

	(x = y) खोटे-असल्यास: {
		आउटपुट लिहा: x, नवी-ओळ.
		आउटपुट लिहा: y, नवी-ओळ.
		प्रोग्राम समाप्त.
	}.

} * 1000.
आउटपुट लिहा: ['OK'], नवी-ओळ.