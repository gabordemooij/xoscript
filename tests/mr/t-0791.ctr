Server init.

>> DB := Maria-DB नवीन होस्ट: ['localhost'],
	वापरकर्ता-नाव: ['xo'],
	पासवर्ड: ['pass123'],
	डेटाबेस-नाव: ['xobase'],
	जोडणी.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> शोध-पॅरामीटर := Maria-क्वेरी नवीन: SQL.

# set database
शोध-पॅरामीटर डेटाबेस: DB.

शोध-पॅरामीटर आणा: { :row
	आउटपुट लिहा: row world, नवी-ओळ.
}.
