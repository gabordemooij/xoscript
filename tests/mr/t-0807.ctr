# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB नवीन होस्ट: ['localhost'],
	वापरकर्ता-नाव: ['xo'],
	पासवर्ड: ['pass123'],
	डेटाबेस-नाव: ['xobase'],
	जोडणी.

>> शोध-पॅरामीटर := db क्वेरी: ['SELECT %% FROM'].
{ शोध-पॅरामीटर कार्यान्वित. } पकडा: { :e
	आउटपुट लिहा: ( e समाविष्ट: ['%%'] ), नवी-ओळ.
}, चालवा.
