>> t := शून्य.

# you can control the time zone for
# parsing like this:
क्षण वेळ-क्षेत्र: ['CET'].
t := क्षण पासून: ['1981-02-03 04:05:06'].
आउटपुट लिहा: t, नवी-ओळ.

# now using CEST time zone:
क्षण वेळ-क्षेत्र: ['CEST'].
t := क्षण पासून: ['1981-02-03 04:05:06'].
आउटपुट लिहा: t, नवी-ओळ.

# error if string cannot be parsed
{ क्षण पासून: ['1900']. } पकडा: { शून्य. }, चालवा.
