# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> फाइल-मार्ग := ['/tmp/dat.csv'].
>> csv := फाइल नवीन: फाइल-मार्ग.
csv लिहा: s.

# accepts CRLF LF CR, varying row length
csv विभाजक: [';'] अवतरण: ['"'] ओळी: { :line
	प्रोग्राम साफसफाई.
	आउटपुट लिहा: line, नवी-ओळ.
	प्रोग्राम साफसफाई.
}.

# unequal lines
s शेवटी-जोडा: ['\njustone'].
csv लिहा: s.
{
	csv विभाजक: [';'] अवतरण: ['"'] ओळी: { :line
		आउटपुट लिहा: line, नवी-ओळ.
	}.
} पकडा: { :e 
	आउटपुट लिहा: e, नवी-ओळ.
}, चालवा.

# invalid format
s := ['"he"llo";world'].
csv लिहा: s.
{
	csv विभाजक: [';'] अवतरण: ['"'] ओळी: { :line
		आउटपुट लिहा: line, नवी-ओळ.
	}.
} पकडा: { :e 
	आउटपुट लिहा: e, नवी-ओळ.
}, चालवा.
