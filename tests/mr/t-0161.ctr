प्रोग्राम मेमरी-व्यवस्थापन: 0.
सूची जेव्हा: ['sum'] करा: {
	>> total := 0.
	स्वतः प्रत्येक: { :index :element
		total बेरीज: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := फाइल नवीन: ['/tmp/test.txt'].
f लिहा: ['Lorem Ipsum'].
f बंद.
  

f := फाइल नवीन: ['/tmp/test.txt'].
>> text := f वाचा.
f बंद.



प्रोग्राम साफसफाई.
usedMemory1 := (प्रोग्राम मेमरी ? 1).



f := फाइल नवीन: ['/tmp/test.txt'].
text := f वाचा.
f बंद.

प्रोग्राम साफसफाई.
usedMemory2 := (प्रोग्राम मेमरी ? 1).


f := फाइल नवीन: ['/tmp/test.txt'].
text := f वाचा.
f बंद.

प्रोग्राम साफसफाई.
usedMemory3 := (प्रोग्राम मेमरी ? 1).



( usedMemory1 = usedMemory2 आणि: usedMemory1 = usedMemory3, आणि: usedMemory2 = usedMemory3 ) खरे-असल्यास: {
	आउटपुट लिहा: ['No memory leaks here'].
}, खोटे-असल्यास: {
	आउटपुट लिहा: ['Leaking memory...'].
