>> Greeter := वस्तू नवीन.
Greeter जेव्हा: ['make'] करा: {
	>> gr := वस्तू नवीन.
	gr जेव्हा: ['setName:'] करा: { :aname
		स्वतःचे नाव := aname.
	}.
	gr जेव्हा: ['greet'] करा: {
		आउटपुट लिहा: स्वतःचे नाव.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a नवीन.
c setName: ['THREE'].
c greet.
>> d := a नवीन.
d setName: ['FOUR'].
d greet.
c greet.
