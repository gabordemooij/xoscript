# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := तिजोरी 
	पासवर्ड-हॅश: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := तिजोरी 
	पासवर्ड-हॅश: hash पडताळा: a1.
	# fail 
>> b := तिजोरी
	पासवर्ड-हॅश: hash पडताळा: a2.
	# ok!

आउटपुट लिहा: a, नवी-ओळ.
आउटपुट लिहा: b, नवी-ओळ.

