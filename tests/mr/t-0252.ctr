#Linux
>> clock := क्षण नवीन.
clock वेळ-क्षेत्र: ['UTC-1'].
clock वर्ष: 1981, महिना: 1, दिवस: 5,
      तास: 13, मिनिट: 15, सेकंद: 13.

आउटपुट लिहा: clock, नवी-ओळ.
clock वेळ-क्षेत्र: ['UTC+0'].

आउटपुट लिहा: (
	(clock वर्ष साधे) + ['-'] + (clock महिना) + ['-'] + (clock दिवस) + [' '] +
	(clock तास) + [':'] + (clock मिनिट) + [':'] + (clock सेकंद) + [' '] +
	['W'] + (clock आठवडा) + (clock वेळ-क्षेत्र)
), नवी-ओळ.


clock वेळ-क्षेत्र: ['UTC-1'].
आउटपुट लिहा: (
	(clock वर्ष साधे) + ['-'] + (clock महिना) + ['-'] + (clock दिवस) + [' '] +
	(clock तास) + [':'] + (clock मिनिट) + [':'] + (clock सेकंद) + [' '] +
	['W'] + (clock आठवडा) + (clock वेळ-क्षेत्र)
), नवी-ओळ.
