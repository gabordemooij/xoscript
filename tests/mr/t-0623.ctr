

>> g := Server नवीन.
>> v := तिजोरी नवीन.
>> ok := 0.

>> secrets := सूची नवीन ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> passwords := secrets प्रत.
passwords प्रत्येक: { :i :p
	secrets प्रत्येक: { :n :s
		{
			>> encrypted := v एन्क्रिप्ट: s किल्ली: p.
			>> decrypted := v डिक्रिप्ट: encrypted किल्ली: p.
			(decrypted = s) खरे-असल्यास: {
				ok बेरीज: 1.
			}, अन्यथा: {
				आउटपुट लिहा: ['failed encrypting/decrypting: '], नवी-ओळ.
				आउटपुट लिहा: s, नवी-ओळ.
				आउटपुट लिहा: ['encrypted: '] + encrypted, नवी-ओळ.
				आउटपुट लिहा: ['decrypted: '] + encrypted, नवी-ओळ.
				प्रोग्राम समाप्त.
			}.
		} पकडा: { :err
			(s = [''] किंवा: p = ['']) खरे-असल्यास: {
				ok बेरीज: 1.
			}, अन्यथा: {
				आउटपुट लिहा: err, नवी-ओळ.
				प्रोग्राम समाप्त.
			}.
		}, चालवा.
	}.
}.

आउटपुट लिहा: ( ok + [' vault encryptions tested.'] ), नवी-ओळ.