
मजकूर जेव्हा: ['html'] करा: { <- (
		स्वतः
		बदला: ['&'] ने: ['&amp;'],
		बदला: ['<'] ने: ['&lt;'],
		बदला: ['>'] ने: ['&gt;'],
		बदला: ['"'] ने: ['&quot;']
	).
}.

>> HtmlBrush := वस्तू नवीन.

HtmlBrush जेव्हा: ['उत्तर:'] करा: { :tag
	आउटपुट लिहा: (['<tag>↵'] tag: tag ).
}.

HtmlBrush जेव्हा: ['उत्तर:आणि:'] करा: { :tag :content
	tag := ( tag सुरुवात: 0 लांबी: (tag लांबी - 1) ).
	आउटपुट लिहा: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush जेव्हा: ['content:'] करा: { :text
	आउटपुट लिहा: text html, नवी-ओळ.
}.

HtmlBrush जेव्हा: ['attr:value:'] करा: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush नवीन.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
