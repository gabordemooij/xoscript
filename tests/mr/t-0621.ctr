>> phrases := सूची नवीन
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases प्रत्येक: { :_ :phrase 
	>> e := Server base64-एनकोड: phrase.
	>> d := Server base64-डिकोड: e.
	आउटपुट लिहा: (
		message प्रत ~encoded: e, ~decoded: d
	), नवी-ओळ.
}.
