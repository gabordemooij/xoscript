>> repeater := वस्तू नवीन.
repeater जेव्हा: ['उत्तर:'] करा: { :what
	आउटपुट लिहा: what + [' '].
}.
repeater जेव्हा: ['उत्तर:आणि:'] करा: { :what :say
	आउटपुट लिहा: what, लिहा: say + [' '].
}.
repeater जेव्हा: ['उत्तर:आणि:आणि:'] करा: { :what :say :more
	आउटपुट लिहा: what, लिहा: say, लिहा: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
