# a quote that never closes must give an error, not an endless loop
>> फाइल-मार्ग := ['/tmp/test0821.csv'].
>> file := फाइल नवीन: फाइल-मार्ग.

file लिहा: ['a,b\n"1,2\n'].
{
	file विभाजक: [','] अवतरण: ['"'] ओळी: { :line
		आउटपुट लिहा: line, नवी-ओळ.
	}.
} पकडा: { :e आउटपुट लिहा: e, नवी-ओळ. }, चालवा.

# a closed quote still works
file लिहा: ['a,b\n"1,2",3'].
file विभाजक: [','] अवतरण: ['"'] ओळी: { :line
	आउटपुट लिहा: line, नवी-ओळ.
}.
file हटवा.
