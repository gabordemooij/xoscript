# test qualifiers

>> $ := वस्तू नवीन.

$ जेव्हा: ['उत्तर:'] करा: { :x
	
	>> operation := x अक्षर: 0.
	>> valuta := x अक्षर: 1.
	>> money := x वगळा: 2.
	
	>> amount := 0.

	( operation = ['+'] ) खरे-असल्यास: {
		( valuta = ['£'] ) खरे-असल्यास: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

आउटपुट लिहा: x, नवी-ओळ.


>> Fruit := वस्तू नवीन.

Fruit जेव्हा: ['नवीन'] करा: {
	>> f := स्वतः नवीन.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit जेव्हा: ['apples:'] करा: { :a स्वतःचे apples := a. }.
Fruit जेव्हा: ['oranges:'] करा: { :p स्वतःचे oranges := p. }.
Fruit जेव्हा: ['apples'] करा: { <- स्वतःचे apples. }.
Fruit जेव्हा: ['oranges'] करा: { <- स्वतःचे oranges. }.

Fruit जेव्हा: ['+'] करा: { :f
	
	>> n := Fruit नवीन.
	f बेरीज: 1.
	
	n apples: (f apples + स्वतःचे apples).
	n oranges:  (f oranges  + स्वतःचे oranges). <- n.
}.

Fruit जेव्हा: ['मजकुरात'] करा: { <- ( स्वतःचे apples मजकुरात + [' apples and '] + स्वतःचे oranges + [' oranges'] ).
}.

संख्या जेव्हा: ['apples'] करा: { <- ((Fruit नवीन) apples: स्वतः).
}.

संख्या जेव्हा: ['apple'] करा: { <- ((Fruit नवीन) apples: स्वतः).
}.

संख्या जेव्हा: ['oranges'] करा: { <- ((Fruit नवीन) oranges: स्वतः).
}.




आउटपुट लिहा: (1 apple + 3 oranges + 4 apples), नवी-ओळ.


मजकूर जेव्हा: ['twice'] करा: { <- ((स्वतः मजकुरात) + (स्वतः मजकुरात)).
}.



आउटपुट लिहा: ['❤❤❤'] twice.



