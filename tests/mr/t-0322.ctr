

>> Matryoshka := वस्तू नवीन.
Matryoshka जेव्हा: ['double:'] करा: { :secret
	स्वतःचे secret := secret × 2.
}.
Matryoshka जेव्हा: ['नवीन:'] करा: { :secret
	>> answer := शून्य.
	>> t := (secret > 255).
	आउटपुट लिहा: (secret + [' | '] + t), नवी-ओळ.
	t खरे-असल्यास: {
		answer := secret.
	}, अन्यथा: {
		answer := Matryoshka पुनरावर्ती नवीन: (स्वतः double: secret).
	}. <- answer.
}.

>> x := Matryoshka नवीन: 2.
