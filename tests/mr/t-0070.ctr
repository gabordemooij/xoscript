>> numbers := ['1,2,3'] विभाजित: [','].
आउटपुट लिहा: ['I got: '] + numbers मोजणी + [' numbers.'],नवी-ओळ.
{ :i आउटपुट लिहा: ['number #'] + i + [':'] + (numbers स्थान: i), नवी-ओळ.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages विभाजित: [' Or '].
आउटपुट लिहा: ['We serve'], नवी-ओळ.
{ :i आउटपुट लिहा: ['->'] + (beverages स्थान: i), नवी-ओळ. } × (beverages मोजणी).
आउटपुट लिहा: (beverages जोडा: [',']), नवी-ओळ.
आउटपुट लिहा: (numbers जोडा: ['||']).
