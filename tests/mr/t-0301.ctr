


>> wine := वस्तू नवीन.


wine जेव्हा: ['toString'] करा: { <- ['merlot'].
}.

wine जेव्हा: ['naarTekst'] करा: { <- ['merlot'].
}.


wine जेव्हा: ['='] करा: { :other wine <- ( स्वतः toString = other wine ).
}.

wine जेव्हा: ['=='] करा: { :other wine <- ( स्वतः toString = other wine ).
}.



wine
	बाबतीत: ['cabernet'] करा: { आउटपुट लिहा: ['it's a Cabernet!']. },
	बाबतीत: ['syrah']    करा: { आउटपुट लिहा: ['it's a Syrah!'].    },
	बाबतीत: ['merlot']   करा: { आउटपुट लिहा: ['it's a Merlot!'].   },
	बाबतीत: ['malbec']   करा: { आउटपुट लिहा: ['it's a Malbec!'].   }.

आउटपुट नवी-ओळ.
