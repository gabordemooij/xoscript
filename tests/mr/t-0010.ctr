>> Animal := वस्तू नवीन.
Animal जेव्हा: ['make'] करा: {
	>> animal := वस्तू नवीन.
	animal जेव्हा: ['makeSound'] करा: {
		आउटपुट लिहा: स्वतःचे sound.
	}. <- animal.
}.
>> Cat := वस्तू नवीन.
Cat जेव्हा: ['make'] करा: {
	>> cat := Animal make.
	cat जेव्हा: ['init'] करा: {
		स्वतःचे sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
