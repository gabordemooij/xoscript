>> makeAdder := { :x
	>> f := { :y <- (स्वतःचे x + y). } निश्चित: ['x'] मूल्य: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i स्वतःचे q ठेवा: (स्वतःचे f लागू: (स्वतःचे q ? i)) किल्ली: i. } 
	निश्चित: ['q'] मूल्य: array,
	निश्चित: ['f'] मूल्य: func.
	{ :i mapping लागू: i. } × (array मोजणी).
}.

>> a := सूची ← 1; 2; 3.
mapper लागू: a आणि: (makeAdder लागू: 100).
आउटपुट लिहा: (a स्थान: 0), नवी-ओळ.
आउटपुट लिहा: (a ? 1), नवी-ओळ.
आउटपुट लिहा: (a ? 2), नवी-ओळ.
