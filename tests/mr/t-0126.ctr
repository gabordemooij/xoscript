#Linux
>> Slurp := वस्तू नवीन.

Slurp जेव्हा: ['नवीन'] करा: {
	स्वतःचे str := [''].
}.

Slurp जेव्हा: ['nieuw'] करा: {
	स्वतःचे str := [''].
}.

Slurp जेव्हा: ['उत्तर:'] करा: { :blah
		स्वतःचे str शेवटी-जोडा: blah.
}.

Slurp जेव्हा: ['उत्तर:आणि:'] करा: { :blah :blahah
		स्वतःचे str शेवटी-जोडा: (blah सुरुवात: 0 लांबी: (blah लांबी - 1)).
		स्वतःचे str शेवटी-जोडा: [' '].
		स्वतःचे str शेवटी-जोडा: blahah.
}.

Slurp जेव्हा: ['obtain'] करा: {
	>> buffer := स्वतःचे str.
	स्वतःचे str := ['']. <- buffer.
}.


आउटपुट लिहा: (प्रोग्राम सिस्टम: (Slurp नवीन echo: ['Hello I can write to console using fluid API!'], obtain)).


{ फाइल नवीन: ['/tmp/from.txt'], हटवा. } पकडा: { ['Empty']. }, चालवा.
{ फाइल नवीन: ['/tmp/to.txt'], हटवा. } पकडा: { ['Empty']. }, चालवा.


फाइल नवीन: ['/tmp/to.txt'], अस्तित्वात खोटे-असल्यास: {
	आउटपुट लिहा: ['Confirmed. Target file does not exist.\
'].
}.
फाइल नवीन: ['/tmp/from.txt'], अस्तित्वात खोटे-असल्यास: {
	आउटपुट लिहा: ['Confirmed. Source file does not exist.\
'].
}.



प्रोग्राम सिस्टम: (Slurp नवीन touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



प्रोग्राम सिस्टम: (Slurp नवीन cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

फाइल नवीन: ['/tmp/to.txt'], अस्तित्वात खरे-असल्यास: {
	आउटपुट लिहा: ['Confirmed. Target file has been created by shell.\
'].
}.


आउटपुट लिहा: ['Contents of file is:'] + (फाइल नवीन: ['/tmp/to.txt'], वाचा), नवी-ओळ.
