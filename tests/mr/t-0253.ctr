#Linux
>> OS := प्रोग्राम सेटिंग: ['OS'].

>> clock := क्षण नवीन.
	
(OS = ['Haiku']) खरे-असल्यास: {
	clock वेळ-क्षेत्र: ['CET'],
	वर्ष: 2017, महिना: 7, दिवस: 13,
	तास: 18, मिनिट: 0, सेकंद: 0.
}, अन्यथा: {
	clock वेळ-क्षेत्र: ['Europe/Amsterdam'],
	वर्ष: 2017, महिना: 7, दिवस: 13,
	तास: 18, मिनिट: 0, सेकंद: 0.
}.

clock जेव्हा: ['tell'] करा: {
	आउटपुट लिहा: स्वतः, नवी-ओळ.
}.


clock बेरीज: 2    तास, tell.
clock बेरीज: 1    तास, tell.
clock बेरीज: 19 मिनिट, tell.
clock बेरीज: 1  मिनिट, tell.
clock बेरीज: 1  मिनिट, tell.
clock बेरीज: 19 सेकंद, tell.
clock बेरीज: 1  सेकंद, tell.
clock बेरीज: 1  सेकंद, tell.
clock बेरीज: 2    वर्ष, tell.
clock बेरीज: 1    वर्ष, tell.

(OS = ['Haiku']) खरे-असल्यास: {
clock बेरीज: 5   महिना.
clock वेळ-क्षेत्र: ['CEST'], tell.
}, अन्यथा: {
	clock बेरीज: 5   महिना, tell.
}.

clock बेरीज: 1   महिना, tell.
clock बेरीज: 19    दिवस, tell.
clock बेरीज: 1    तास, tell.
clock बेरीज: 120  yard, tell.
