Server init.
>> f := स्वरूप नवीन: ['%d'].
>> a := Blob नवीन: 4.
a bytes: ( सूची नवीन ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob नवीन: 4.
b bytes: ( सूची नवीन ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a सुरुवात: 0 लांबी: 3, प्रत्येक: { :i :byte
	आउटपुट लिहा: ( f लागू-पूर्णांक: byte ), नवी-ओळ.
}.
a ^ b.
a सुरुवात: 0 लांबी: 3, प्रत्येक: { :i :byte
	आउटपुट लिहा: ( f लागू-पूर्णांक: byte ), नवी-ओळ.
}.
a ^ b.
a सुरुवात: 0 लांबी: 3, प्रत्येक: { :i :byte
	आउटपुट लिहा: ( f लागू-पूर्णांक: byte ), नवी-ओळ.
}.
a मुक्त.
b मुक्त.

{ a ^ वस्तू. } पकडा: { :e आउटपुट लिहा: e, नवी-ओळ. }, चालवा.
