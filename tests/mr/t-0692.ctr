Server init.

आउटपुट लिहा: (
	पॅटर्न नवीन: ['^\\w+$'],
	जुळणी: ['test@example.com'] 
), नवी-ओळ. # 0 match, fails on @ and .

आउटपुट लिहा: (
	पॅटर्न नवीन: ['^[^@]+@[^\.]+\.\\w+$'],
	जुळणी: ['test@example.com'] 
), नवी-ओळ. # 1 match

आउटपुट लिहा: (
	पॅटर्न नवीन: ['[^@]+@[^\.]+\.\\w+'],
	जुळणी: ['test@example.com'] 
), नवी-ओळ. # 1 match

आउटपुट लिहा: (
	पॅटर्न नवीन: ['([^@]+)@([^\.]+)\.\\w+'],
	जुळणी: ['test@example.com'] 
), नवी-ओळ. # 1 match, groups dont matter

आउटपुट लिहा: (
	पॅटर्न नवीन: ['[a-z]'],
	जुळणी: ['test@example.com'] 
), नवी-ओळ. # 14 matches

आउटपुट लिहा: (
	पॅटर्न नवीन: ['.*'],
	जुळणी: ['test@example.com'] 
), नवी-ओळ. # 1 match (all)

आउटपुट लिहा: (
	पॅटर्न नवीन: ['(.*)'],
	जुळणी: ['test@example.com'] 
), नवी-ओळ. # 1 match (all)

आउटपुट लिहा: (
	पॅटर्न नवीन: ['\\s*[^@]+@[^\.]+\.\\w+'],
	जुळणी: ['test@example.com'] 
), नवी-ओळ. # 1 match, prefix space optional, gets ignored