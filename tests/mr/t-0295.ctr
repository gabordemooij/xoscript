
>> dictionary := (
	शब्दकोश नवीन
		ठेवा: ['b'] किल्ली: ['a'],
		ठेवा: ['a'] किल्ली: ['b'],
		ठेवा: ['z'] किल्ली: ['x'],
		ठेवा: ['hello'] किल्ली: ['hallo'],
		ठेवा: ['human'] किल्ली: ['human']
).

>> comparisons := सूची नवीन.
dictionary प्रत्येक: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a तुलना: b)
	).
}.

comparisons क्रम-लावा: { :a :b <- ( a तुलना: b ). }.
आउटपुट लिहा: ( comparisons जोडा: ['↵'] ), नवी-ओळ.
comparisons जोडा: ['↵'].
