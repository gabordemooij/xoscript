#OBSD
>> dirname := [''].
{ dirname शेवटी-जोडा: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
प्रोग्राम सिस्टम: command.
प्रोग्राम chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename शेवटी-जोडा: ['YYYYYYYY']. } * 20.
फाइल नवीन: filename, लिहा: ['sometext'].
{ फाइल यादी: ['/tmp/'] + dirname. } * 1000.
आउटपुट लिहा: ['no crash'], नवी-ओळ.

