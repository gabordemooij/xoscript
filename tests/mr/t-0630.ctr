#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := पॅटर्न नवीन: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern जुळणी: subject करा: { :m :x
	आउटपुट लिहा: m, नवी-ओळ.
	आउटपुट लिहा: x, नवी-ओळ. <- ['XXX'].
}.
आउटपुट लिहा: result, नवी-ओळ.