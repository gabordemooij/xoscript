# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob नवीन: 8, bytes: (
	सूची नवीन ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

आउटपुट लिहा: ( utf16 डिकोड: ['utf16le'] ), नवी-ओळ.

utf16 मुक्त.
>> utf32 := Blob नवीन: 13, bytes: (
	सूची नवीन ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

आउटपुट लिहा: ( utf32 डिकोड: ['utf32be'] ), नवी-ओळ.
utf32 मुक्त.