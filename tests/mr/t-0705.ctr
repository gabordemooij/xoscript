

>> obj := वस्तू नवीन.

obj जेव्हा: ['greet'] करा: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj जेव्हा: ['task'] करा: {
	स्वतःचे property := 123.
	{
		# try binds self/own to object instead of block
		आउटपुट लिहा: स्वतः greet.
		आउटपुट लिहा: स्वतःचे property.
		1 / 0.
	} पकडा: {
		आउटपुट लिहा: स्वतः greet.
		आउटपुट लिहा: स्वतःचे property.
		आउटपुट लिहा: ['ok'].
	}, प्रयत्न.
}.

obj task.