>> Greeter := वस्तू नवीन.
Greeter जेव्हा: ['make'] करा: {
	>> greeter := वस्तू नवीन.
	greeter जेव्हा: ['name:'] करा: { :नाव
		आउटपुट लिहा: ['setting a name'].
		स्वतःचे myName := नाव.
	}.
	greeter जेव्हा: ['performGreeting'] करा: {
		आउटपुट लिहा: ['Hello'].
		आउटपुट लिहा: स्वतःचे myName.
	}.
	greeter जेव्हा: ['greet'] करा: {
		स्वतः performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
