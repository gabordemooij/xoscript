Server init.

>> conn1 := Maria-DB नवीन होस्ट: ['localhost'],
	वापरकर्ता-नाव: ['xo'],
	पासवर्ड: ['pass123'],
	डेटाबेस-नाव: ['xobase'],
	जोडणी.

>> conn2 := Maria-DB नवीन होस्ट: ['localhost'],
	वापरकर्ता-नाव: ['xo'],
	पासवर्ड: ['pass123'],
	डेटाबेस-नाव: ['xobase'],
	जोडणी.
#...
>> del := conn1 क्वेरी: ['DELETE FROM book WHERE id > 0'].
{  del कार्यान्वित. conn1 पुष्टी. } पकडा: { :e conn1 मागे-घ्या.  }, चालवा.

>> insert := conn1 क्वेरी: ['INSERT INTO book (id) VALUES(null)'].
insert कार्यान्वित.

>> मोजणी := conn1 क्वेरी: ['SELECT COUNT(*) AS num FROM book'].
मोजणी आणा: { :row आउटपुट लिहा: row num, नवी-ओळ. }.

# does not show up
# insert not committed on connection 1
>> मोजणी := conn2 क्वेरी: ['SELECT COUNT(*) AS num FROM book'].
मोजणी आणा: { :row आउटपुट लिहा: row num, नवी-ओळ. }.
