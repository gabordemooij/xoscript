# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := Maria-DB नवीन होस्ट: ['localhost'],
	वापरकर्ता-नाव: ['xo'],
	पासवर्ड: ['pass123'],
	डेटाबेस-नाव: ['xobase'],
	जोडणी.

>> शोध-पॅरामीटर := db क्वेरी: ['SELECT ? AS a, ? AS b, ? AS c'].
शोध-पॅरामीटर पॅरामीटर: (सूची नवीन ; ['1']).
{ शोध-पॅरामीटर आणा: { :row आउटपुट लिहा: row, नवी-ओळ. }. } पकडा: { :e आउटपुट लिहा: e, नवी-ओळ. }, चालवा.

>> शोध-पॅरामीटर := db क्वेरी: ['SELECT ? AS a'].
{ शोध-पॅरामीटर आणा: { :row आउटपुट लिहा: row, नवी-ओळ. }. } पकडा: { :e आउटपुट लिहा: e, नवी-ओळ. }, चालवा.

# the right number still works, more parameters are ignored as before
>> शोध-पॅरामीटर := db क्वेरी: ['SELECT ? AS a, ? AS b'].
शोध-पॅरामीटर पॅरामीटर: (सूची नवीन ; ['1'] ; ['2']).
शोध-पॅरामीटर आणा: { :row आउटपुट लिहा: (row येथे: ['a']), लिहा: (row येथे: ['b']), नवी-ओळ. }.
शोध-पॅरामीटर पॅरामीटर: (सूची नवीन ; ['1'] ; ['2'] ; ['3']).
शोध-पॅरामीटर आणा: { :row आउटपुट लिहा: (row येथे: ['a']), लिहा: (row येथे: ['b']), नवी-ओळ. }.
