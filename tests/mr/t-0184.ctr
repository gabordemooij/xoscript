>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 घात: 8).  
a := a + (2 घात: -1). 
a := a + (49 वर्गमूळ).   
a addNum: ((सूची ← 0 ; 1) कमाल).          
a addNum: ((सूची ← 2 ; 3) किमान).
आउटपुट लिहा: a.

