#Linux

 >> t := क्षण नवीन.
 
t वेळ-क्षेत्र: ['Europe/Amsterdam'].
t वर्ष: 2020, महिना: 8, दिवस: 2, तास: 21, मिनिट: 2, सेकंद: 1.

>> a := t तास.
>> ams := t वेळ-क्षेत्र.

t वेळ-क्षेत्र: ['US/Hawaii'].
>> b := t तास.
>> hw := t वेळ-क्षेत्र.

आउटपुट
लिहा: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		हे: ['later'] नाहीतर: ['earlier']
	)
),
नवी-ओळ.
 