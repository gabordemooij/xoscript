# test list operations


>> cakes := सूची ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes बदला: 1 लांबी: 2 ने: ( सूची ← ['cinnamon'] ; ['pineapple'] ).
आउटपुट लिहा: (buy जोडा: [',']), नवी-ओळ.


>> buy := cakes बदला: 1 लांबी: 12 ने: ( सूची ← ['cinnamon'] ; ['pineapple'] ).
आउटपुट लिहा: (buy जोडा: [',']), नवी-ओळ.


