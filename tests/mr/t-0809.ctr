# backslashes must survive code serialization, strings must not end early
>> मूल्ये := सूची नवीन
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

मूल्ये प्रत्येक: { :i :value
	>> d := शब्दकोश नवीन.
	d ठेवा: value किल्ली: ['k'].
	>> r := d कोड वस्तूमध्ये.
	आउटपुट लिहा: r मोजणी, नवी-ओळ.
	आउटपुट लिहा: ( (r येथे: ['k']) = value ), नवी-ओळ.
}.
