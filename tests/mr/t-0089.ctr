>> randomizer := { :a :b
	>> किमान := ( a < b ) हे: a नाहीतर: b.
	>> कमाल := ( a > b ) हे: a नाहीतर: b.
	>> x := शून्य.
	{
		x := संख्या दरम्यान: a आणि: b.
		((x < किमान) किंवा: (x > कमाल)) खरे-असल्यास: { 
			आउटपुट लिहा: (['Invalid value!']).
			प्रोग्राम समाप्त.
		}.
	} 
	× 100. <- x.
}.
