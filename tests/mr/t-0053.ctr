60 × {
	>> x := (संख्या random % 6) + 1.
	(x ≤ 6) खोटे-असल्यास: { आउटपुट लिहा: ['FAIL']. }.
	(x ≥0) खोटे-असल्यास: { आउटपुट लिहा: ['FAIL']. }.
	x := (संख्या random % 3) + 1.
	(x < 3) खोटे-असल्यास: { आउटपुट लिहा: ['FAIL']. }.
	(x>-1) खोटे-असल्यास: { आउटपुट लिहा: ['FAIL']. }.
	x := ((बूलियन flip) संख्येत).
	(x = 0 किंवा: x = 1) खोटे-असल्यास: { आउटपुट लिहा: ['FAIL']. }.
	x := ((खरे flip) संख्येत).
	(x = 0 किंवा: x = 1) खोटे-असल्यास: { आउटपुट लिहा: ['FAIL']. }.
	x := (बूलियन flip हे: ['HEAD'] नाहीतर: ['TAIL']).
	((x = ['HEAD']) किंवा: (x = ['TAIL'])) खोटे-असल्यास: { आउटपुट लिहा: ['FAIL']. }.
}.
आउटपुट लिहा: ['DONE'].

