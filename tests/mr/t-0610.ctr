
>> Rectangle := वस्तू नवीन.

Rectangle जेव्हा: ['area'] करा: { <- स्वतःचे लांबी * स्वतःचे width.
}.

Rectangle जेव्हा: ['length:'] करा: { :लांबी
	स्वतःचे लांबी := लांबी.
}.

Rectangle जेव्हा: ['width:'] करा: { :width
	स्वतःचे width := width.
}.

Rectangle जेव्हा: ['नवीन'] करा: {
	# this will not result into an infinite loop
	>> rectangle := स्वतः नवीन.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle नवीन.
आउटपुट लिहा: a area, नवी-ओळ. #0

>> b := Rectangle नवीन length: 2, width: 3.
आउटपुट लिहा: b area, नवी-ओळ. #6

