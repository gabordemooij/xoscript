Server init.

>> DB := Maria-DB नवीन होस्ट: ['localhost'],
	वापरकर्ता-नाव: ['xo'],
	पासवर्ड: ['pass123'],
	डेटाबेस-नाव: ['xobase'],
	जोडणी.

{
	DB क्वेरी:
	['DROP TABLE movies'],
	कार्यान्वित.
} पकडा: { शून्य. }, चालवा.

DB क्वेरी:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
कार्यान्वित.

DB क्वेरी: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
पॅरामीटर: ( सूची नवीन ; ['Halloween'] ),
कार्यान्वित.

DB क्वेरी: ['SELECT * FROM movies'],
आणा: { :movie
	आउटपुट लिहा: movie title, नवी-ओळ.
}.

