>> items := शब्दकोश नवीन.
items ठेवा: ['green'] किल्ली: ['color-1'].
items ठेवा: ['orange'] किल्ली: ['color-2'].
items ठेवा: ['red'] किल्ली: ['color-3'].
>> i := 0.
>> s := [''].
items प्रत्येक: { :key :color
	आउटपुट लिहा: ['color #'] + i + [' is: '] + color + [' '].
	i बेरीज: 1.
}.
आउटपुट लिहा: i + [' colors!'].
