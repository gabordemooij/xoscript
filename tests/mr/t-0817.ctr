# a value ending in the first part of an opening quote must survive serialization
>> मूल्ये := सूची नवीन
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

मूल्ये प्रत्येक: { :i :value
	>> d := शब्दकोश नवीन.
	d ठेवा: value किल्ली: ['k'].
	d ठेवा: ['second'] किल्ली: ['j'].
	>> r := d कोड वस्तूमध्ये.
	आउटपुट लिहा: r मोजणी, नवी-ओळ.
	आउटपुट लिहा: ( (r येथे: ['k']) = value ), नवी-ओळ.
}.
