{
	हे-कार्य त्रुटी: ['Dont fail.'].
	unknown doSomething.
} पकडा: {
	आउटपुट लिहा: ['Caught!'].
}, चालवा.

{
	हे-कार्य त्रुटी: ['Dont fail.'].
	स्वतःचे unknown doSomething.
} पकडा: {
	आउटपुट लिहा: ['Caught!'].
}, चालवा.

{
	हे-कार्य त्रुटी: ['Dont fail.'].
	unknown := 122.
} पकडा: {
	आउटपुट लिहा: ['Caught!'].
}, चालवा.


{
	हे-कार्य त्रुटी: ['Dont fail.'].
	खरे थांबवा.
	आउटपुट लिहा: ['FAIL'].
} पकडा: {
	आउटपुट लिहा: ['Caught!'].
}, चालवा.

{
	{
		हे-कार्य त्रुटी: ['Dont fail.'].
		खरे थांबवा.
		आउटपुट लिहा: ['FAIL'].
	} पकडा: { :x
		(x = ['Dont fail.']) खरे-असल्यास: { हे-कार्य त्रुटी: ['Nested Caught!']. }.
	}, चालवा.
} पकडा: { :e
	आउटपुट लिहा: e.
}, चालवा.
