# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := पॅटर्न नवीन: pattern.
	p जुळणी: subject करा: { :m :g
		आउटपुट लिहा: g मोजणी, लिहा: [' '], लिहा: (g जोडा: ['|']), नवी-ओळ. <- m.
	}.
}.
show लागू: ['(a)|(b)'] आणि: ['b'].
show लागू: ['(a)|(b)'] आणि: ['a'].
show लागू: ['(x)?y'] आणि: ['y'].
show लागू: ['(x)?(y)(z)?'] आणि: ['xy'].
