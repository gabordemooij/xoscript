>> To-Do := वस्तू नवीन.

To-Do जेव्हा: ['नवीन'] करा: {
	स्वतःचे list := सूची नवीन.
}.

To-Do जेव्हा: ['nieuw'] करा: {
	स्वतःचे list := सूची नवीन.
}.

To-Do जेव्हा: ['+'] करा: { :task
	स्वतःचे list शेवटी-जोडा: task.
}.

To-Do जेव्हा: ['number of tasks?'] करा: { <-  स्वतःचे list मोजणी.
}.

>> todos := 
	To-Do नवीन 
	+ ['cook dinner'] 
	+ ['clean room'].
	
आउटपुट लिहा: ['You have $ tasks to do'] $ todos number of tasks?.
