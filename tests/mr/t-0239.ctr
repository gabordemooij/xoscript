सूची जेव्हा: ['sum'] करा: {
	>> total := 0.
	स्वतः प्रत्येक: { :index :element
		total बेरीज: element.
	}. <- total.
}.

>> a := खरे.



a जेव्हा: ['मजकुरात'] करा: {
	>> answer := शून्य.
	( स्वतः = खरे ) खरे-असल्यास: {
		answer := ['Yep'].
	}, अन्यथा: {
		answer := ['Nope'].
	}. <- answer.
}.

a जेव्हा: ['संख्येत'] करा: {
	>> answer := शून्य.
	( स्वतः = खरे ) खरे-असल्यास: {
		answer := 10.
	}, अन्यथा: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b जेव्हा: ['मजकुरात'] करा: { <- ['Devil'].
}.

b जेव्हा: ['बूलियनमध्ये'] करा: { <- खोटे.
}.


आउटपुट लिहा: a, नवी-ओळ.  
आउटपुट लिहा: (90 + a), नवी-ओळ. 
आउटपुट लिहा: b, नवी-ओळ. 
आउटपुट लिहा: (खरे आणि: b), नवी-ओळ.

a := सूची ← ['hello'] ; ['world'] ; खरे ; शून्य ; 666. 
a := a + ( सूची ← 1 ).
आउटपुट लिहा: a, नवी-ओळ.
आउटपुट लिहा: ((शब्दकोश नवीन) ठेवा: शून्य किल्ली: शून्य), नवी-ओळ.
आउटपुट लिहा: a sum, नवी-ओळ. 


{
	a जेव्हा: ['मजकुरात'] करा: { <- शून्य. }.
