>> map1 := शब्दकोश नवीन.
>> key1 := सूची नवीन.
>> key2 := सूची नवीन.

map1
	ठेवा: ['hello'] किल्ली: key1,
	ठेवा: ['world'] किल्ली: key2.


आउटपुट
	लिहा: ['Map #1 contains: '] + (map1 येथे: key1),
	लिहा: [' and '] + (map1 येथे: key2), नवी-ओळ.

>> KeyeableArray := सूची नवीन.
KeyeableArray जेव्हा: ['toString'] करा: { <- (स्वतः मोजणी) toString.
}.

>> map2 := शब्दकोश नवीन.
key1 := KeyeableArray नवीन.
key2 := KeyeableArray नवीन.

key1 शेवटी-जोडा: 1.

map2
	ठेवा: ['hello'] किल्ली: key1,
	ठेवा: ['world'] किल्ली: key2.

आउटपुट
	लिहा: ['Map #2 contains: '] + (map2 येथे: key1),
	लिहा: [' and '] + (map2 येथे: key2), नवी-ओळ.
