

सूची जेव्हा: ['column:'] करा: { :column
	>> result := सूची नवीन.
	स्वतः प्रत्येक: { :index :row
		row प्रत्येक: { :index :cell
			(index = column) खरे-असल्यास: { result शेवटी-जोडा: cell. }.
		}.
	}. <- result.
}.


>> a := सूची ←
	(सूची ← 1 ; 2 ; 3) ;
	(सूची ← 4 ; 5 ; 6) ;
	(सूची ← 7 ; 8 ; 9).

>> b := a column: 1.
आउटपुट लिहा: b, नवी-ओळ.

b := a column: 20.
आउटपुट लिहा: b, नवी-ओळ.

b := a column: -100.
आउटपुट लिहा: b, नवी-ओळ.
