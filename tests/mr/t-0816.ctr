# a format must fit the type of the value, the type can come from a client
>> प्रयत्न := { :format :value
	{ आउटपुट लिहा: ( (स्वरूप नवीन: format) लागू: value ), नवी-ओळ. } पकडा: { :e आउटपुट लिहा: e, नवी-ओळ. }, चालवा.
}.
>> try-int := { :format :value
	{ आउटपुट लिहा: ( (स्वरूप नवीन: format) लागू-पूर्णांक: value ), नवी-ओळ. } पकडा: { :e आउटपुट लिहा: e, नवी-ओळ. }, चालवा.
}.

# fits
प्रयत्न लागू: ['|%s|'] आणि: ['text'].
प्रयत्न लागू: ['%06.2f'] आणि: 5.5.
प्रयत्न लागू: ['100%% %s'] आणि: ['sure'].
try-int लागू: ['%03d'] आणि: 7.
try-int लागू: ['%x'] आणि: 255.
प्रयत्न लागू: ['%d'] आणि: (Int64 नवीन मजकुरातून: ['12']).
प्रयत्न लागू: ['%lld'] आणि: (Int64 नवीन मजकुरातून: ['12']).
प्रयत्न लागू: ['%.1lf'] आणि: 5.5.
try-int लागू: ['%hd'] आणि: 7.

# does not fit
प्रयत्न लागू: ['%s'] आणि: 12345.
प्रयत्न लागू: ['%d'] आणि: 12345.
प्रयत्न लागू: ['%f'] आणि: ['text'].
try-int लागू: ['%d'] आणि: ['text'].
try-int लागू: ['%s'] आणि: 5.
प्रयत्न लागू: ['%s %s'] आणि: ['text'].
प्रयत्न लागू: ['%n'] आणि: ['text'].
प्रयत्न लागू: ['%*s'] आणि: ['text'].
प्रयत्न लागू: ['%'] आणि: ['text'].

# length modifier does not fit
प्रयत्न लागू: ['%ls'] आणि: ['text'].
प्रयत्न लागू: ['%Lf'] आणि: 5.5.
try-int लागू: ['%ld'] आणि: 7.
try-int लागू: ['%lld'] आणि: 7.
प्रयत्न लागू: ['%Ld'] आणि: (Int64 नवीन मजकुरातून: ['12']).

# a width that does not fit printf must give an error, not a crash
प्रयत्न लागू: ['%99999999999s'] आणि: ['text'].
