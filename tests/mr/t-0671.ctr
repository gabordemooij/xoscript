# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := तिजोरी किल्ल्या-तयार-करा.

# private (secret) key
>> sk := keys पहिला.

# public key
>> pk := keys शेवटचा.

# sign a message
>> sig := तिजोरी स्वाक्षरी: ['abc'] किल्लीने: sk.

# check message (ok)
आउटपुट लिहा: ( 
	तिजोरी
		तपासा: ['abc'] 
		स्वाक्षरी: sig 
		किल्लीने: pk 
), नवी-ओळ.

# check message (fail)
आउटपुट लिहा: ( 
	तिजोरी 
		तपासा: ['abd'] 
		स्वाक्षरी: sig 
		किल्लीने: pk 
), नवी-ओळ.