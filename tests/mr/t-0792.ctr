Server init.

>> DB := Maria-DB नवीन होस्ट: ['localhost'],
	वापरकर्ता-नाव: ['xo'],
	पासवर्ड: ['pass123'],
	डेटाबेस-नाव: ['xobase'],
	जोडणी.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB क्वेरी: SQL.

# now you don't have to set DB
query2 आणा: { :row
	आउटपुट लिहा: row world, नवी-ओळ.
}.
