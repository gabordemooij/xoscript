संख्या जेव्हा: ['roman'] करा: {
	>> संख्येत := स्वतः प्रत.
	>> roman := [''].
	{
		{
			(संख्येत ≥ 1000) खरे-असल्यास: {
				roman शेवटी-जोडा: ['Ⅿ'].
				संख्येत वजा: 1000.
			}, थांबवा.
		
			(संख्येत ≥ 500) खरे-असल्यास: {
				roman शेवटी-जोडा: ['Ⅾ'].
				संख्येत वजा: 500.
			}, थांबवा.
		
			(संख्येत ≥ 100) खरे-असल्यास: {
				roman शेवटी-जोडा: ['Ⅽ'].
				संख्येत वजा: 100.
			}, थांबवा.
		
			(संख्येत ≥ 50) खरे-असल्यास: {
				roman शेवटी-जोडा: ['Ⅼ'].
				संख्येत वजा: 50.
			}, थांबवा.
		
			(संख्येत ≥ 50) खरे-असल्यास: {
				roman शेवटी-जोडा: ['Ⅼ'].
				संख्येत वजा: 50.
			}, थांबवा.
		
			(संख्येत ≥ 10) खरे-असल्यास: {
				roman शेवटी-जोडा: ['Ⅹ'].
				संख्येत वजा: 10.
			}, थांबवा.
			
			(संख्येत ≥ 9) खरे-असल्यास: {
				roman शेवटी-जोडा: ['Ⅸ'].
				संख्येत वजा: 9.
			}, थांबवा.
			
			(संख्येत ≥ 5) खरे-असल्यास: {
				roman शेवटी-जोडा: ['Ⅴ'].
				संख्येत वजा: 5.
			}, थांबवा.
			
			(संख्येत ≥ 4) खरे-असल्यास: {
				roman शेवटी-जोडा: ['Ⅳ'].
				संख्येत वजा: 4.
			}, थांबवा.
			
			(संख्येत ≥ 1) खरे-असल्यास: {
				roman शेवटी-जोडा: ['Ⅰ'].
				संख्येत वजा: 1.
			}, थांबवा.
		} कार्यपद्धती.
	} जोपर्यंत: { <- संख्येत > 0. }. <- roman.
}.

