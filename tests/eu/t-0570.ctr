#Linux

 >> t := Unea berria.
 
t zona: ['Europe/Amsterdam'].
t urtea: 2020, hilabetea: 8, eguna: 2, ordua: 21, minutua: 2, segundoa: 1.

>> a := t ordua.
>> ams := t zona.

t zona: ['US/Hawaii'].
>> b := t ordua.
>> hw := t zona.

Irteera
idatzi: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		edo: ['later'] edo: ['earlier']
	)
),
lerro-jauzia.
 