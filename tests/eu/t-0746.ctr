Irteera idatzi: ['Test object'], lerro-jauzia.
>> a := Objektua berria. 

a noiz: ['item:'] egin: { :dict
	berezko dict := dict. 
}.

a noiz: ['item'] egin: { <- berezko dict.
}.

a item: (
Hiztegia berria
	hello: ['world'],
	world: (Hiztegia berria jarri: ['a'] non: ['b'])).

Irteera idatzi: a item, lerro-jauzia.

>> old-dict-address := a item prototipoa memoria-helbidea.
a save-as: ['/tmp/a.bin'].
Irteera idatzi: ['========== RELOADING SNAP:'], lerro-jauzia.

>> b := Objektua load-from: ['/tmp/a.bin'].

(b item prototipoa memoria-helbidea = old-dict-address) egia: {
	Irteera idatzi: ['Object link re-attached.'], lerro-jauzia.
}.

Irteera idatzi: b item, lerro-jauzia.
