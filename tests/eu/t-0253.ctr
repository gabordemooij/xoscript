#Linux
>> OS := Programa ezarpena: ['OS'].

>> clock := Unea berria.
	
(OS = ['Haiku']) egia: {
	clock zona: ['CET'],
	urtea: 2017, hilabetea: 7, eguna: 13,
	ordua: 18, minutua: 0, segundoa: 0.
}, bestela: {
	clock zona: ['Europe/Amsterdam'],
	urtea: 2017, hilabetea: 7, eguna: 13,
	ordua: 18, minutua: 0, segundoa: 0.
}.

clock noiz: ['tell'] egin: {
	Irteera idatzi: norbera, lerro-jauzia.
}.


clock gehitu: 2    ordua, tell.
clock gehitu: 1    ordua, tell.
clock gehitu: 19 minutua, tell.
clock gehitu: 1  minutua, tell.
clock gehitu: 1  minutua, tell.
clock gehitu: 19 segundoa, tell.
clock gehitu: 1  segundoa, tell.
clock gehitu: 1  segundoa, tell.
clock gehitu: 2    urtea, tell.
clock gehitu: 1    urtea, tell.

(OS = ['Haiku']) egia: {
clock gehitu: 5   hilabetea.
clock zona: ['CEST'], tell.
}, bestela: {
	clock gehitu: 5   hilabetea, tell.
}.

clock gehitu: 1   hilabetea, tell.
clock gehitu: 19    eguna, tell.
clock gehitu: 1    ordua, tell.
clock gehitu: 120  yard, tell.
