# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Kutxa-gotorra sortu-gakoak.

# private (secret) key
>> sk := keys lehena.

# public key
>> pk := keys azkena.

# sign a message
>> sig := Kutxa-gotorra sinatu: ['abc'] gakoarekin: sk.

# check message (ok)
Irteera idatzi: ( 
	Kutxa-gotorra
		egiaztatu: ['abc'] 
		sinadura: sig 
		gakoarekin: pk 
), lerro-jauzia.

# check message (fail)
Irteera idatzi: ( 
	Kutxa-gotorra 
		egiaztatu: ['abd'] 
		sinadura: sig 
		gakoarekin: pk 
), lerro-jauzia.