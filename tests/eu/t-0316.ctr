>> Grandfather := Objektua berria.
Grandfather noiz: ['greet'] egin: {
	Irteera idatzi: ['Ave!'], lerro-jauzia.
}.
>> Father := Grandfather berria.
Father noiz: ['greet'] egin: {
	Irteera idatzi: ['Hello'], lerro-jauzia.
	norbera greet.
}.
>> Son := Father berria.
Son noiz: ['greet'] egin: {
	Irteera idatzi: ['Hi'], lerro-jauzia.
	norbera greet.
}.

Son greet.

>> Roundabout := Objektua berria.
Roundabout noiz: ['circle:'] egin: { :x
	Irteera idatzi: x, lerro-jauzia.
	(x < 3) egia: { norbera errekurtsiboa circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) egia: { Irteera idatzi: x, lerro-jauzia. x gehitu: 1.  increment hasi. }. }.
increment hasi.