

Zerrenda noiz: ['column:'] egin: { :column
	>> result := Zerrenda berria.
	norbera bakoitza: { :index :row
		row bakoitza: { :index :cell
			(index = column) egia: { result erantsi: cell. }.
		}.
	}. <- result.
}.


>> a := Zerrenda ←
	(Zerrenda ← 1 ; 2 ; 3) ;
	(Zerrenda ← 4 ; 5 ; 6) ;
	(Zerrenda ← 7 ; 8 ; 9).

>> b := a column: 1.
Irteera idatzi: b, lerro-jauzia.

b := a column: 20.
Irteera idatzi: b, lerro-jauzia.

b := a column: -100.
Irteera idatzi: b, lerro-jauzia.
