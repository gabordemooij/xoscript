Server init.
>> fmt := Formatua berria: ['%#3x'].

>> blob := Blob berria: 4.
blob bytes: ( 
	Zerrenda berria ; 0 ; 1 ; 2 ; 3
).

>> file := Fitxategia berria: ['/tmp/blob'].
file blob: blob.
blob askatu.

>> irakurri := file blob.
irakurri 
nondik: 0 
luzera: 4, 
egin bakoitza: { :i :b 
	Irteera
	idatzi: (fmt aplikatu-osoa: b),
	lerro-jauzia.
}.
irakurri askatu.
