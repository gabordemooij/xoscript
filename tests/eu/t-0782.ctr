Irteera idatzi: ['Test object'], lerro-jauzia.
>> cmd := Komandoa berria.
Irteera idatzi: cmd ls /tmp, lerro-jauzia.
>> old-cmd-address := cmd prototipoa memoria-helbidea.
cmd save-as: ['/tmp/a.bin'].
Irteera idatzi: ['========== RELOADING SNAP:'], lerro-jauzia.
>> b := Objektua load-from: ['/tmp/a.bin'].
(b prototipoa memoria-helbidea = old-cmd-address) egia: {
	Irteera idatzi: ['Object link re-attached.'], lerro-jauzia.
}.
Irteera idatzi: b ls, lerro-jauzia.


