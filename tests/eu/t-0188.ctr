

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa memoria-kudeaketa: 0.

{ :i Irteera idatzi: i. } × 4.
Irteera lerro-jauzia.
{ :i Irteera idatzi: (4 - i). } × 4.
Irteera lerro-jauzia.
( 1 > 2 ) faltsua: { Irteera idatzi: ['BLOCK 1'], lerro-jauzia. }.
( 2 > 1 ) egia:  { Irteera idatzi: ['BLOCK 2'], lerro-jauzia. }.

>> i := 0.
{ Irteera idatzi: i. i gehitu: 1. } bitartean: { <- ( i < 3). }.
Irteera lerro-jauzia.

i := 3.
{ Irteera idatzi: i. i := i - 1. } bitartean: { <- ( i > 0). }.
Irteera lerro-jauzia.


Programa garbitu.

usedMemory1 := (Programa memoria ? 0).


{ :i  Irteera idatzi: i. } × 4.
Irteera lerro-jauzia.
{ :i  Irteera idatzi: (4 - i). } × 4.
Irteera lerro-jauzia.
( 1 > 2 ) faltsua: { Irteera idatzi: ['BLOCK 1'], lerro-jauzia. }.
( 2 > 1 ) egia:  { Irteera idatzi: ['BLOCK 2'], lerro-jauzia. }.

>> i := 0.
{ Irteera idatzi: i. i gehitu: 1. } bitartean: { <- ( i < 3). }.
Irteera lerro-jauzia.

i := 3.
{ Irteera idatzi: i. i := i - 1. } bitartean: { <- ( i > 0). }.
Irteera lerro-jauzia.



Programa garbitu.
usedMemory2 := (Programa memoria ? 0).


{ :i Irteera idatzi: i. } × 4.
Irteera lerro-jauzia.
{ :i Irteera idatzi: (4 - i). } × 4.
Irteera lerro-jauzia.
( 1 > 2 ) faltsua: { Irteera idatzi: ['BLOCK 1'], lerro-jauzia. }.
( 2 > 1 ) egia:  { Irteera idatzi: ['BLOCK 2'], lerro-jauzia. }.

>> i := 0.
{ Irteera idatzi: i. i gehitu: 1. } bitartean: { <- ( i < 3). }.
Irteera lerro-jauzia.

i := 3.
{ Irteera idatzi: i. i := i - 1. } bitartean: { <- ( i > 0). }.
Irteera lerro-jauzia.

Programa garbitu.
usedMemory3 := (Programa memoria ? 0).



( usedMemory1 = usedMemory2 eta: usedMemory1 = usedMemory3, eta: usedMemory2 = usedMemory3 ) egia: {
	Irteera idatzi: ['No memory leaks here'].
}, faltsua: {
	Irteera idatzi: ['Leaking memory...'].
}.
