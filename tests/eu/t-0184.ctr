

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa memoria-kudeaketa: 0.

Zenbakia noiz: ['addNum:'] egin: { :x
	norbera gehitu: x.
}.

Zenbakia noiz: ['subtractNum:'] egin: { :x
	norbera kendu: x.
}.

Zenbakia noiz: ['multiplyBy:'] egin: { :x
	norbera biderkatu: x.
}.

Zenbakia noiz: ['divideBy:'] egin: { :x
	norbera zatitu-honekin: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 berretura: 8).  
a := a + (2 berretura: -1). 
a := a + (49 erro-karratua).   
a addNum: ((Zerrenda ← 0 ; 1) maximoa).          
a addNum: ((Zerrenda ← 2 ; 3) minimoa).
Irteera idatzi: a.

Programa garbitu.

usedMemory1 := (Programa memoria ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 berretura: 8).  
a := a + (2 berretura: -1). 
a := a + (49 erro-karratua).   
a addNum: ((Zerrenda ← 0 ; 1) maximoa).          
a addNum: ((Zerrenda ← 2 ; 3) minimoa).
Irteera idatzi: a.

Programa garbitu.
usedMemory2 := (Programa memoria ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 berretura: 8).  
a := a + (2 berretura: -1). 
a := a + (49 erro-karratua).   
a addNum: ((Zerrenda ← 0 ; 1) maximoa).          
a addNum: ((Zerrenda ← 2 ; 3) minimoa).
Irteera idatzi: a.

Programa garbitu.
usedMemory3 := (Programa memoria ? 0).



( usedMemory1 = usedMemory2 eta: usedMemory1 = usedMemory3, eta: usedMemory2 = usedMemory3 ) egia: {
	Irteera idatzi: ['No memory leaks here'].
}, faltsua: {
	Irteera idatzi: ['Leaking memory...'].
}.
