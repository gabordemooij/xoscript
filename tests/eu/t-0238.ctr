Testua noiz: ['evaluate'] egin: {
	>> kodea := Fitxategia berria: ['/tmp/eval.ctr'].
	kodea idatzi: (norbera testua + ['.']).
	Programa erabili: ['/tmp/eval.ctr'].
}.

>> a := Zerrenda ← 1 ; 2 ; 3.
>> b := (a testua).

Irteera idatzi: b, lerro-jauzia. 
(['b := '] + b) evaluate.

Irteera idatzi: b ? 2, lerro-jauzia. 

Irteera idatzi: (( Zerrenda ← 1 ; 2 ; 3 )), lerro-jauzia. 

Irteera idatzi: ((Hiztegia berria) jarri: 1 non: 2), lerro-jauzia. 

>> x := ( (Zerrenda ← 1 ; ( Zerrenda ← 9 ) ; Egia ) ) testua.
Irteera idatzi: x, lerro-jauzia. 
(['x := '] + x) evaluate.

Irteera idatzi: x ? 1 ? 0, lerro-jauzia. 

>> y := (Hiztegia berria) jarri: (Zerrenda ← 1) non: (Zerrenda ← 2).
Irteera idatzi: y, lerro-jauzia. 

(['y := '] + y) testua evaluate.

Irteera idatzi: (y non: (Zerrenda ← 2) testua ), lerro-jauzia.

Irteera idatzi: (Zerrenda berria), lerro-jauzia. 
Irteera idatzi: (Hiztegia berria), lerro-jauzia. 
