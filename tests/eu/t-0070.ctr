>> numbers := ['1,2,3'] zatitu: [','].
Irteera idatzi: ['I got: '] + numbers zenbatu + [' numbers.'],lerro-jauzia.
{ :i Irteera idatzi: ['number #'] + i + [':'] + (numbers posizioa: i), lerro-jauzia.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages zatitu: [' Or '].
Irteera idatzi: ['We serve'], lerro-jauzia.
{ :i Irteera idatzi: ['->'] + (beverages posizioa: i), lerro-jauzia. } × (beverages zenbatu).
Irteera idatzi: (beverages batu: [',']), lerro-jauzia.
Irteera idatzi: (numbers batu: ['||']).
