#Linux

(Fitxategia berria: ['/tmp/testje']) badago faltsua: {
	Programa sistema: ['mkdir /tmp/testje'].	
}.

(Fitxategia berria: ['/tmp/testje/file1']) badago faltsua: {
	Programa sistema: ['touch /tmp/testje/file1'].	
}.

(Fitxategia berria: ['/tmp/testje/folder1']) badago faltsua: {
	Programa sistema: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Fitxategia zerrenda: ['/tmp/testje'].

>> q := Zerrenda berria.

l bakoitza: { :k :v v bakoitza: { :x :y q erantsi: y. }. }.

>> s := q testua.

(s barne-dauka: ['file1']) egia:   { Irteera idatzi: ['OK'], lerro-jauzia. }.
(s barne-dauka: ['file2']) egia:   { Irteera idatzi: ['XX'], lerro-jauzia. }.
(s barne-dauka: ['folder1']) egia: { Irteera idatzi: ['OK'], lerro-jauzia. }.
