#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa memoria-kudeaketa: 0.

{
Unea denbora.
Unea itxaron: 1.
Irteera idatzi: Programa argumentuak, lerro-jauzia.
Programa argumentua: 0.
Zenbakia random.
Irteera idatzi: (Programa sistema: ['echo 'Hello'']).
} hasi.

Programa garbitu.
usedMemory1 := (Programa memoria ? 0).

{
Unea denbora.
Unea itxaron: 1.
Irteera idatzi: Programa argumentuak, lerro-jauzia.
Programa argumentua: 0.
Zenbakia random.
Irteera idatzi: (Programa sistema: ['echo 'Hello'']).
