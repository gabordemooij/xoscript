>> Greeter := Objektua berria.
Greeter noiz: ['make'] egin: {
	>> greeter := Objektua berria.
	greeter noiz: ['name:'] egin: { :izena
		Irteera idatzi: ['setting a name'].
		berezko myName := izena.
	}.
	greeter noiz: ['greet'] egin: {
		Irteera idatzi: ['Hello'].
		Irteera idatzi: berezko myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
