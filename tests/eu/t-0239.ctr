Zerrenda noiz: ['sum'] egin: {
	>> total := 0.
	norbera bakoitza: { :index :element
		total gehitu: element.
	}. <- total.
}.

>> a := Egia.



a noiz: ['testua'] egin: {
	>> answer := Ezer.
	( norbera = Egia ) egia: {
		answer := ['Yep'].
	}, bestela: {
		answer := ['Nope'].
	}. <- answer.
}.

a noiz: ['zenbakia'] egin: {
	>> answer := Ezer.
	( norbera = Egia ) egia: {
		answer := 10.
	}, bestela: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b noiz: ['testua'] egin: { <- ['Devil'].
}.

b noiz: ['boolearra'] egin: { <- Faltsua.
}.


Irteera idatzi: a, lerro-jauzia.  
Irteera idatzi: (90 + a), lerro-jauzia. 
Irteera idatzi: b, lerro-jauzia. 
Irteera idatzi: (Egia eta: b), lerro-jauzia.

a := Zerrenda ← ['hello'] ; ['world'] ; Egia ; Ezer ; 666. 
a := a + ( Zerrenda ← 1 ).
Irteera idatzi: a, lerro-jauzia.
Irteera idatzi: ((Hiztegia berria) jarri: Ezer non: Ezer), lerro-jauzia.
Irteera idatzi: a sum, lerro-jauzia. 


{
	a noiz: ['testua'] egin: { <- Ezer. }.
	a := [''] + a.
} harrapatu: { :error
	Irteera idatzi: ['Error noted: '] + error, lerro-jauzia.
}, hasi.



{
	a noiz: ['zenbakia'] egin: { <- Ezer. }.
	a := 3 × a.
} harrapatu: { :error
	Irteera idatzi: ['Error noted: '] + error, lerro-jauzia.
}, hasi.


{
	a noiz: ['boolearra'] egin: { <- Ezer. }.
	a := Egia eta: a. 
} harrapatu: { :error
	Irteera idatzi: ['Error noted: '] + error, lerro-jauzia.
}, hasi.





