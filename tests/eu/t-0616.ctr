Zerrenda noiz: ['kopiatu'] egin: {
	>> kopiatu := Zerrenda berria.
	norbera bakoitza: { :zenbakia :section
		kopiatu erantsi: section errekurtsiboa kopiatu.
	}. <- kopiatu.
}.

>> sheep := Zerrenda berria ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep kopiatu.
clones bakoitza: { :zenbakia :sheep
	sheep erantsi: ['2'].
}.

Irteera idatzi: sheep, lerro-jauzia.
Irteera idatzi: clones, lerro-jauzia.
