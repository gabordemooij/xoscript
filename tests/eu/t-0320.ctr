


>> CoffeeMachine := Objektua berria.
CoffeeMachine noiz: ['order:'] egin: { :id
	>> coffee := ['Americano'].
	( id = 1 ) egia: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) egia: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) egia: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Objektua berria.
SimpleCoffeeMachine noiz: ['order'] egin: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Irteera idatzi: redCup, lerro-jauzia.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Irteera idatzi: greenCup, lerro-jauzia.
>> yellowCup := CoffeeMachine order: 1.
Irteera idatzi: yellowCup, lerro-jauzia.
>> blueCup := CoffeeMachine order: 0.
Irteera idatzi: blueCup, lerro-jauzia.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Irteera idatzi: blackCup, lerro-jauzia.
blackCup erantsi: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Irteera idatzi: orangeCup, lerro-jauzia.
