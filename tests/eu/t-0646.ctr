Server init.
Irteera idatzi: ['Database datetime test'], lerro-jauzia.

>> db := Maria-DB berria ostalaria: ['localhost'],
	erabiltzailea: ['xo'], 
	pasahitza: ['pass123'],
	datu-base-izena: ['xobase'],
	konektatu.

>> bilaketa-parametroak :=
db kontsulta: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
eskuratu: { :row
	Irteera idatzi: row datetimetest, lerro-jauzia.
}.
