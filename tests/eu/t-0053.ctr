60 × {
	>> x := (Zenbakia random % 6) + 1.
	(x ≤ 6) faltsua: { Irteera idatzi: ['FAIL']. }.
	(x ≥0) faltsua: { Irteera idatzi: ['FAIL']. }.
	x := (Zenbakia random % 3) + 1.
	(x < 3) faltsua: { Irteera idatzi: ['FAIL']. }.
	(x>-1) faltsua: { Irteera idatzi: ['FAIL']. }.
	x := ((Boolearra flip) zenbakia).
	(x = 0 edo: x = 1) faltsua: { Irteera idatzi: ['FAIL']. }.
	x := ((Egia flip) zenbakia).
	(x = 0 edo: x = 1) faltsua: { Irteera idatzi: ['FAIL']. }.
	x := (Boolearra flip edo: ['HEAD'] edo: ['TAIL']).
	((x = ['HEAD']) edo: (x = ['TAIL'])) faltsua: { Irteera idatzi: ['FAIL']. }.
}.
Irteera idatzi: ['DONE'].

