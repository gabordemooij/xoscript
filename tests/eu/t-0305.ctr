
Zenbakia ikasi: ['plus:'] esanahia: ['+'].
Zenbakia noiz: ['+'] egin: { :x
	>> rate := 1.
	>> currency := x kalifikatzailea.
	(currency = ['euros']) egia: {
		rate := 2.
	}. <- (norbera plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars kalifikatu: ['dollars'].
euros kalifikatu: ['euros'].
>> money := dollars + euros.
Irteera idatzi: money, lerro-jauzia.
