>> Greeter := Objektua berria.
Greeter noiz: ['make'] egin: {
	>> gr := Objektua berria.
	gr noiz: ['setName:'] egin: { :aname
		berezko izena := aname.
	}.
	gr noiz: ['greet'] egin: {
		Irteera idatzi: berezko izena.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a berria.
c setName: ['THREE'].
c greet.
>> d := a berria.
d setName: ['FOUR'].
d greet.
c greet.
