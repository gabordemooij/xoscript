>> Animal := Objektua berria.
>> Factory := Objektua berria.

Animal noiz: ['berria'] egin: {
	>> animal := norbera berria.
	animal sound: ['?']. <- animal.
}.

Animal noiz: ['sound:'] egin: { :s
	berezko sound := s.
}.

Animal noiz: ['sound'] egin: { <- berezko sound.
}.

>> Dog := Objektua berria.
>> Cat := Objektua berria.

Dog noiz: ['berria'] egin: { <- Animal berria sound: ['woof!'].
}.

Cat noiz: ['berria'] egin: { <- Animal berria sound: ['meow!'].
}.

Irteera idatzi: Dog berria sound, lerro-jauzia.
Irteera idatzi: Cat berria sound, lerro-jauzia.

Factory noiz: ['mix:and:'] egin: { :beast1 :beast2 <- Animal berria sound: (
		( beast1 sound nondik: 0 luzera: 2 ) +
		( beast2 sound nondik: 2 luzera: 5 )
	).
}.

Irteera idatzi: (Factory mix: Dog berria and: Cat berria) sound, lerro-jauzia.
