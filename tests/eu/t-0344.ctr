# catch-all test (practical)
>> HTML := Testua berria.
HTML noiz: ['encode:'] egin: { :tekst
	norbera erantsi: (tekst
	ordeztu: ['&'] honekin: ['&amp;'], 
	ordeztu: ['<'] honekin: ['&lt;'],
	ordeztu: ['>'] honekin: ['&gt;'],
	ordeztu: ['"'] honekin: ['&quot;']).
}.
>> blog := HTML berria.
blog erantsi: ['<h1>'],
     encode: ['Koffie & Thee'],
     erantsi: ['</h1>'].
Irteera idatzi: blog, lerro-jauzia.


>> Roman := Zenbakia berria.
Roman noiz: ['stringy'] egin: {
	>> a := [''].
	{ a erantsi: ['I']. } × norbera. <- a.
}.

>> x := Roman berria.
x gehitu: 3.
Irteera idatzi: x stringy, lerro-jauzia.

>> Quantum := Boolearra berria.
Quantum noiz: ['true?'] egin: { <- ['maybe True']. }.
Irteera idatzi: (Quantum berria true?), lerro-jauzia.

>> Nihil := Ezer berria.
Nihil noiz: ['testua'] egin: { <- ['Nihil']. }.
Irteera idatzi: (Nihil berria), lerro-jauzia.
