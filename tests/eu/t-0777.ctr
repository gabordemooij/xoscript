#OBSD
>> dirname := [''].
{ dirname erantsi: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Programa sistema: command.
Programa chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename erantsi: ['YYYYYYYY']. } * 20.
Fitxategia berria: filename, idatzi: ['sometext'].
{ Fitxategia zerrenda: ['/tmp/'] + dirname. } * 1000.
Irteera idatzi: ['no crash'], lerro-jauzia.

