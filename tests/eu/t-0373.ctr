# compliance test

# use international numbers

Irteera idatzi: ['1000 -> '].
Irteera idatzi: 1000, lerro-jauzia. #1000

Irteera idatzi: ['1.5 -> '].
Irteera idatzi: 1.5, lerro-jauzia.  #1.5

Irteera idatzi: ['1001.5 -> '].
Irteera idatzi: 1.5 + 1000, lerro-jauzia. #1001.5

# use 0-indexed arrays
>> x := Zerrenda berria ; 1 ; 2 ; 3.
>> y := Zerrenda berria ; ['a'] ; ['b'] ; ['c'].

Irteera idatzi: ['1 -> '].
Irteera idatzi: x ? 0, lerro-jauzia. #1

Irteera idatzi: ['1 -> '].
Irteera idatzi: (x non: 0), lerro-jauzia. #1

Irteera idatzi: ['1 -> '].
Irteera idatzi: x lehena, lerro-jauzia. #1

Irteera idatzi: ['3 -> '].
Irteera idatzi: x azkena, lerro-jauzia. #3

Irteera idatzi: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Irteera idatzi: (x arabera: y), lerro-jauzia.

Irteera idatzi: ['1 -> '].
Irteera idatzi: (x nondik: 0 luzera: 1) lehena, lerro-jauzia. #1

Irteera idatzi: ['0 -> '].
Irteera idatzi: (x aurkitu: 1), lerro-jauzia. #0

x jarri: 9 non: 0.

Irteera idatzi: ['9 -> '].
Irteera idatzi: (x non: 0), lerro-jauzia. #9

x aurretik-gehitu: 8.
Irteera idatzi: ['8 -> '].
Irteera idatzi: (x non: 0), lerro-jauzia. #9


x erantsi: 10.
Irteera idatzi: ['10 -> '].
Irteera idatzi: (x non: 4), lerro-jauzia. #10








