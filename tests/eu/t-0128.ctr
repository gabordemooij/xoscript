
Zerrenda noiz: ['sum'] egin: {
	>> total := 0.
	norbera bakoitza: { :index :element
		total gehitu: element.
	}. <- total.
}.

>> a := Zerrenda ← 9 ; 8 ; 7.
Irteera idatzi: (a sum), lerro-jauzia. 
>> a := Zerrenda ← 1 ; 9.
Irteera idatzi: (a sum), lerro-jauzia. 
>> a := Zerrenda ← ['o'] ; 2.
Irteera idatzi: (a sum), lerro-jauzia. 
Irteera idatzi: (Zerrenda berria sum), lerro-jauzia. 
