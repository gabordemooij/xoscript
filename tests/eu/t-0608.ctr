
>> Size := Objektua berria.
Size noiz: ['is:'] egin: { :zenbakia
	zenbakia noiz: ['+'] egin: { :zenbakia
		>> unit := zenbakia kalifikatzailea.
		>> factor := 1.
		
		unit
		kasu: ['inch'] egin: { factor := 0.0833. }. <- norbera + (zenbakia * factor).
	}. <- zenbakia.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Irteera idatzi: plank + edge, lerro-jauzia.
