# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Eredua berria: pattern.
	p bat-etortzea: subject egin: { :m :g
		Irteera idatzi: g zenbatu, idatzi: [' '], idatzi: (g batu: ['|']), lerro-jauzia. <- m.
	}.
}.
show aplikatu: ['(a)|(b)'] eta: ['b'].
show aplikatu: ['(a)|(b)'] eta: ['a'].
show aplikatu: ['(x)?y'] eta: ['y'].
show aplikatu: ['(x)?(y)(z)?'] eta: ['xy'].
