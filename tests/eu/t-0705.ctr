

>> obj := Objektua berria.

obj noiz: ['greet'] egin: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj noiz: ['task'] egin: {
	berezko property := 123.
	{
		# try binds self/own to object instead of block
		Irteera idatzi: norbera greet.
		Irteera idatzi: berezko property.
		1 / 0.
	} harrapatu: {
		Irteera idatzi: norbera greet.
		Irteera idatzi: berezko property.
		Irteera idatzi: ['ok'].
	}, saiatu.
}.

obj task.