>> a := 3.
>> b := a kopiatu.
a kendu: 1.
Irteera idatzi: [' a = '] + a.
Irteera idatzi: [' b = '] + b.
a := 3.
b := a + 4.
Irteera idatzi: [' a = '] + a.
Irteera idatzi: [' b = '] + b.
>> x := 3.
>> y := x kopiatu.
x gehitu: 10.
y kendu: 1.
Irteera idatzi: [' x = '] + x.
Irteera idatzi: [' y = '] + y.
>> q := Objektua berria.
q noiz: ['setProperty:'] egin: { :x
	berezko prop := x.
}.
q noiz: ['getProperty'] egin: { <- berezko prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Irteera idatzi: [' p = '] + (p getProperty).
