

Zerrenda noiz: ['fixture:'] egin: { :f
	berezko fixture := f.
}.

Zerrenda noiz: ['zenbatu'] egin: { <- berezko fixture.
}.

Zerrenda noiz: ['aantal'] egin: { <- berezko fixture.
}.


>> x := Ezer.
{

	x := ['hello'] 
	ordeztu:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] karakterea: 2)
			)
		)
	honekin: (
		(['...hal'] + ['lo']) 
			maiuskulak 
			lowecase 
			maiuskulak 
			desplazamendua: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Zerrenda ← 0 ; 1 ; 4; 9 ; (Zerrenda ← 0 ; 3; 1) ; 4
							) azkenaurrekoa
						) ? 1
					) + 
					((Zerrenda ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					zenbatu
				)
			)
	).

} × 10.
Irteera idatzi: x, lerro-jauzia.

