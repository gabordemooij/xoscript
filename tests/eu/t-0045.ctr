Programa memoria-kudeaketa: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } harrapatu: {
		oops gehitu: 1.
	}, hasi.
} × 1000.

{
	Irteera idatzi: ['hi there!'].
	ataza-hau errorea: ['oops'].
	Irteera idatzi: ['hi there!'].
	{ Irteera idatzi: ['dont print this']. } hasi.
} harrapatu: { :e 
	Irteera idatzi: ['got ya!']. 
	Irteera idatzi: e.
}, hasi.
