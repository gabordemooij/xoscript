
{ :i
	Irteera idatzi: ['This is step #'] + ( ( i ) + 1 ), lerro-jauzia.
} × 6.

{ :i
	Irteera idatzi: ['This is step #'] + ( 3 - ( i ) ), lerro-jauzia.
} × 6.

{ :i
	Irteera idatzi: ['NEVER!'], lerro-jauzia.
} × 0.



{ :i
	Irteera idatzi: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), lerro-jauzia.
} × 11.
