Irteera idatzi: ['Test object'], lerro-jauzia.
>> a := Objektua berria. 

a noiz: ['item:'] egin: { :hexhelper
	berezko hexhelper := hexhelper. 
}.

a noiz: ['item'] egin: { <- berezko hexhelper.
}.

a item: Hx berria.

>> old-hexhelper-address := a item prototipoa memoria-helbidea.
a save-as: ['/tmp/a.bin'].
Irteera idatzi: ['========== RELOADING SNAP:'], lerro-jauzia.

>> b := Objektua load-from: ['/tmp/a.bin'].

(b item prototipoa memoria-helbidea = old-hexhelper-address) egia: {
	Irteera idatzi: ['Object link re-attached.'], lerro-jauzia.
}.
