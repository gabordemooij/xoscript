

Testua noiz: ['evaluate'] egin: {
	>> kodea := Fitxategia berria: ['/tmp/eval.ctr'].
	kodea idatzi: (norbera testua + ['.']).
	Programa erabili: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Zerrenda ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q testua.
Irteera idatzi: x, lerro-jauzia.
>> y := Ezer.
(['y := '] + x ) evaluate.
Irteera idatzi: y ? 0, lerro-jauzia.

q := Hiztegia jarri: ['\[''] non: ['\['quote\']'].
x := q testua.
Irteera idatzi: x, lerro-jauzia.
y := Ezer.
(['y := '] + x ) evaluate.

>> q := (Hiztegia berria) jarri:['\[''] non:['\['quote\[''].
Irteera idatzi: y ? ['\['quote\']'], lerro-jauzia.
