
>> countries := Zerrenda berria
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Zerrenda berria
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods arabera: countries, bakoitza: { :key :value
	counter gehitu: 1.
}.

Irteera idatzi: (['we serve counter dishes'] counter: counter), lerro-jauzia.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] karaktereak ordenatu: { :v
	counter gehitu: 0.
}.

Irteera idatzi: (['we sort counter dishes'] counter: counter), lerro-jauzia.


>> counter := 0.
{
	{
		counter gehitu: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Irteera idatzi: (['we calculate counter numbers.'] counter: counter), lerro-jauzia.

