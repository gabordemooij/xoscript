>> z := Objektua berria.
z noiz: ['value:'] egin: { :v
	berezko value := v. <- norbera.
}.
z noiz: ['value'] egin: { <- berezko value. }.
(z setValue: 1) value: 2.
Irteera idatzi: z value.
>> x := z.
Irteera idatzi: x value.
z := Ezer.
Irteera idatzi: z value.
Irteera idatzi: x value.
Irteera idatzi: ['hello'].
Irteera idatzi: 3 + 2.
Irteera idatzi: (3 > 2).
