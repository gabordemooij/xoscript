# test qualifiers

>> $ := Objektua berria.

$ noiz: ['erantzun:'] egin: { :x
	
	>> operation := x karakterea: 0.
	>> valuta := x karakterea: 1.
	>> money := x desplazamendua: 2.
	
	>> amount := 0.

	( operation = ['+'] ) egia: {
		( valuta = ['£'] ) egia: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Irteera idatzi: x, lerro-jauzia.


>> Fruit := Objektua berria.

Fruit noiz: ['berria'] egin: {
	>> f := norbera berria.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit noiz: ['apples:'] egin: { :a berezko apples := a. }.
Fruit noiz: ['oranges:'] egin: { :p berezko oranges := p. }.
Fruit noiz: ['apples'] egin: { <- berezko apples. }.
Fruit noiz: ['oranges'] egin: { <- berezko oranges. }.

Fruit noiz: ['+'] egin: { :f
	
	>> n := Fruit berria.
	f gehitu: 1.
	
	n apples: (f apples + berezko apples).
	n oranges:  (f oranges  + berezko oranges). <- n.
}.

Fruit noiz: ['testua'] egin: { <- ( berezko apples testua + [' apples and '] + berezko oranges + [' oranges'] ).
}.

Zenbakia noiz: ['apples'] egin: { <- ((Fruit berria) apples: norbera).
}.

Zenbakia noiz: ['apple'] egin: { <- ((Fruit berria) apples: norbera).
}.

Zenbakia noiz: ['oranges'] egin: { <- ((Fruit berria) oranges: norbera).
}.




Irteera idatzi: (1 apple + 3 oranges + 4 apples), lerro-jauzia.


Testua noiz: ['twice'] egin: { <- ((norbera testua) + (norbera testua)).
}.



Irteera idatzi: ['❤❤❤'] twice.



