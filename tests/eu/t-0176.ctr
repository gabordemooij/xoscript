

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa memoria-kudeaketa: 0.

>> txt := ['Word Salad'].
Irteera idatzi: ['Text Length: '] + txt luzera, lerro-jauzia.
Irteera idatzi: ['Character at 2:'] + ( txt karakterea: 2 ), lerro-jauzia.
Irteera idatzi: (( txt aurkitu: ['S'] ) - 0), lerro-jauzia.

Programa garbitu.

usedMemory1 := (Programa memoria ? 0).


txt := ['Word Salad'].
Irteera idatzi: ['Text Length: '] + txt luzera, lerro-jauzia.
Irteera idatzi: ['Character at 2:'] + ( txt karakterea: 2 ), lerro-jauzia.
Irteera idatzi: (( txt aurkitu: ['S'] ) - 0), lerro-jauzia.

Programa garbitu.
usedMemory2 := (Programa memoria ? 0).


txt := ['Word Salad'].
Irteera idatzi: ['Text Length: '] + txt luzera, lerro-jauzia.
Irteera idatzi: ['Character at 2:'] + ( txt karakterea: 2 ), lerro-jauzia.
Irteera idatzi: (( txt aurkitu: ['S'] ) - 0), lerro-jauzia.

Programa garbitu.
usedMemory3 := (Programa memoria ? 0).



( usedMemory1 = usedMemory2 eta: usedMemory1 = usedMemory3, eta: usedMemory2 = usedMemory3 ) egia: {
	Irteera idatzi: ['No memory leaks here'].
}, faltsua: {
	Irteera idatzi: ['Leaking memory...'].
}.
