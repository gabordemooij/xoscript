

>> Matryoshka := Objektua berria.
Matryoshka noiz: ['double:'] egin: { :secret
	berezko secret := secret × 2.
}.
Matryoshka noiz: ['berria:'] egin: { :secret
	>> answer := Ezer.
	>> t := (secret > 255).
	Irteera idatzi: (secret + [' | '] + t), lerro-jauzia.
	t egia: {
		answer := secret.
	}, bestela: {
		answer := Matryoshka errekurtsiboa berria: (norbera double: secret).
	}. <- answer.
}.

>> x := Matryoshka berria: 2.
