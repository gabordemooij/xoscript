



>> CoffeeGrounds := Objektua berria.
CoffeeGrounds noiz: ['extract'] egin: { <- ['coffee']. }.

>> CoffeeMachine := Objektua berria.
CoffeeMachine noiz: ['init'] egin: {
	berezko coffeegrounds := CoffeeGrounds berria.
}.
CoffeeMachine noiz: ['berria'] egin: { <- CoffeeMachine `new init.
}.

CoffeeMachine noiz: ['makeTea'] egin: { <- (berezko tealeaves extract). }.
CoffeeMachine noiz: ['makeCoffee'] egin: { <- (berezko coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine berria.

Irteera idatzi:
	coffeeDream 
	makeCoffee.

Irteera idatzi:
	coffeeDream 
	makeTea.
