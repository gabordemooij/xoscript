>> x := [' hallo '].

>> y := x maiuskulak.
Irteera idatzi: x, lerro-jauzia.
Irteera idatzi: (x berdin: y), lerro-jauzia.

>> y := x minuskulak.
Irteera idatzi: x, lerro-jauzia.
Irteera idatzi: (x berdin: y), lerro-jauzia.

>> y := x moztu.
Irteera idatzi: x, lerro-jauzia.
Irteera idatzi: (x berdin: y), lerro-jauzia.

>> y := x desplazamendua: 1.
Irteera idatzi: x, lerro-jauzia.
Irteera idatzi: (x berdin: y), lerro-jauzia.

>> y := x nondik: 1 luzera: 2.
Irteera idatzi: x, lerro-jauzia.
Irteera idatzi: (x berdin: y), lerro-jauzia.