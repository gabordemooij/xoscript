>> To-Do := Objektua berria.

To-Do noiz: ['berria'] egin: {
	berezko list := Zerrenda berria.
}.

To-Do noiz: ['nieuw'] egin: {
	berezko list := Zerrenda berria.
}.

To-Do noiz: ['+'] egin: { :task
	berezko list erantsi: task.
}.

To-Do noiz: ['number of tasks?'] egin: { <-  berezko list zenbatu.
}.

>> todos := 
	To-Do berria 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Irteera idatzi: ['You have $ tasks to do'] $ todos number of tasks?.
