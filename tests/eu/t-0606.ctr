>> Point := Objektua berria.
Point noiz: ['x-coordinate:'] egin: { :x berezko x := x. }.
Point noiz: ['y-coordinate:'] egin: { :y berezko y := y. }.
Point noiz: ['x-coordinate']  egin: { <- berezko x kopiatu. }.
Point noiz: ['y-coordinate']  egin: { <- berezko y kopiatu. }.

Point noiz: ['='] egin: { :other <- ( berezko x = other x-coordinate
		 eta: berezko y = other y-coordinate ).
}.

>> pier := Point berria x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point berria x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point berria x-coordinate: 5, y-coordinate: 6.

Irteera idatzi: pier = town-hall, lerro-jauzia.
Irteera idatzi: pier = restaurant, lerro-jauzia.
