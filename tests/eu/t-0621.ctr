>> phrases := Zerrenda berria
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases bakoitza: { :_ :phrase 
	>> e := Server base64-kodetu: phrase.
	>> d := Server base64-deskodetu: e.
	Irteera idatzi: (
		message kopiatu ~encoded: e, ~decoded: d
	), lerro-jauzia.
}.
