Irteera idatzi: ['Test object'], lerro-jauzia.
>> a := Objektua berria. 

a noiz: ['item:'] egin: { :fmt
	berezko fmt := fmt. 
}.

a noiz: ['item'] egin: { <- berezko fmt.
}.

a item: ( Formatua berria: ['|%s|'] ).

Irteera idatzi: a item, lerro-jauzia.

>> old-fmt-address := a item prototipoa memoria-helbidea.
a save-as: ['/tmp/a.bin'].
Irteera idatzi: ['========== RELOADING SNAP:'], lerro-jauzia.

>> b := Objektua load-from: ['/tmp/a.bin'].

(b item prototipoa memoria-helbidea = old-fmt-address) egia: {
	Irteera idatzi: ['Object link re-attached.'], lerro-jauzia.
}.

Irteera idatzi: ( b item aplikatu: ['hello'] ), lerro-jauzia.
