>> makeAdder := { :x
	>> f := { :y <- (berezko x + y). } ezarri: ['x'] balioa: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i berezko q jarri: (berezko f aplikatu: (berezko q ? i)) non: i. } 
	ezarri: ['q'] balioa: array,
	ezarri: ['f'] balioa: func.
	{ :i mapping aplikatu: i. } × (array zenbatu).
}.

>> a := Zerrenda ← 1; 2; 3.
mapper aplikatu: a eta: (makeAdder aplikatu: 100).
Irteera idatzi: (a posizioa: 0), lerro-jauzia.
Irteera idatzi: (a ? 1), lerro-jauzia.
Irteera idatzi: (a ? 2), lerro-jauzia.
