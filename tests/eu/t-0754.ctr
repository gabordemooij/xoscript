Irteera idatzi: ['Test object'], lerro-jauzia.
>> a := Objektua berria. 

a noiz: ['item:'] egin: { :out
	berezko out := out. 
}.

a noiz: ['item'] egin: { <- berezko out.
}.

a noiz: ['greet'] egin: {
	Irteera idatzi: ['hi from original out!'], lerro-jauzia.
}.

a item: Irteera.

Irteera idatzi: a item, lerro-jauzia.

>> old-out-address := a item prototipoa memoria-helbidea.
a save-as: ['/tmp/a.bin'].
Irteera idatzi: ['========== RELOADING SNAP:'], lerro-jauzia.

>> b := Objektua load-from: ['/tmp/a.bin'].

(b item prototipoa memoria-helbidea = old-out-address) egia: {
	Irteera idatzi: ['Object link re-attached.'], lerro-jauzia.
}.

b item idatzi: ['hello from loaded out!'], lerro-jauzia.
b greet.
