
>> Animal := Objektua berria.
Animal noiz: ['berria'] egin: { <- norbera berria init.
}.

Animal noiz: ['init'] egin: {
	berezko sound := ['?'].
	berezko legs := 4.
}.

>> Dog := Animal berria.
Dog noiz: ['init'] egin: {
	norbera init.
	berezko sound := ['barks'].
}.

Animal noiz: ['testua'] egin: { <- berezko legs testua + berezko sound.
}.

>> poodle := Dog berria.
Irteera idatzi: poodle, lerro-jauzia.

