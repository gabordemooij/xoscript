Irteera idatzi: ['Test object'], lerro-jauzia.
>> a := Objektua berria. 
a noiz: ['item:'] egin: { :lst
	berezko lst := lst. 
}.
a noiz: ['item'] egin: { <- berezko lst.
}.
a item: (
	Zerrenda berria ; 1 ; (
		Zerrenda berria ; ['a'] ; (
			Zerrenda berria ; ( Unea berria: 1 )
		) ; ( Int64 testutik: ['321'] )
	)
).
Irteera idatzi: a item, lerro-jauzia.
>> old-lst-address := a item prototipoa memoria-helbidea.
a save-as: ['/tmp/a.bin'].
Irteera idatzi: ['========== RELOADING SNAP:'], lerro-jauzia.
>> b := Objektua load-from: ['/tmp/a.bin'].
(b item prototipoa memoria-helbidea = old-lst-address) egia: {
	Irteera idatzi: ['Object link re-attached.'], lerro-jauzia.
}.
Irteera idatzi: ( b item ), lerro-jauzia.
