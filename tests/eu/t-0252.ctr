#Linux
>> clock := Unea berria.
clock zona: ['UTC-1'].
clock urtea: 1981, hilabetea: 1, eguna: 5,
      ordua: 13, minutua: 15, segundoa: 13.

Irteera idatzi: clock, lerro-jauzia.
clock zona: ['UTC+0'].

Irteera idatzi: (
	(clock urtea soila) + ['-'] + (clock hilabetea) + ['-'] + (clock eguna) + [' '] +
	(clock ordua) + [':'] + (clock minutua) + [':'] + (clock segundoa) + [' '] +
	['W'] + (clock astea) + (clock zona)
), lerro-jauzia.


clock zona: ['UTC-1'].
Irteera idatzi: (
	(clock urtea soila) + ['-'] + (clock hilabetea) + ['-'] + (clock eguna) + [' '] +
	(clock ordua) + [':'] + (clock minutua) + [':'] + (clock segundoa) + [' '] +
	['W'] + (clock astea) + (clock zona)
), lerro-jauzia.
