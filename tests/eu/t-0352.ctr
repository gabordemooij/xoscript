Zenbakia noiz: ['roman'] egin: {
	>> zenbakia := norbera kopiatu.
	>> roman := [''].
	{
		{
			(zenbakia ≥ 1000) egia: {
				roman erantsi: ['Ⅿ'].
				zenbakia kendu: 1000.
			}, eten.
		
			(zenbakia ≥ 500) egia: {
				roman erantsi: ['Ⅾ'].
				zenbakia kendu: 500.
			}, eten.
		
			(zenbakia ≥ 100) egia: {
				roman erantsi: ['Ⅽ'].
				zenbakia kendu: 100.
			}, eten.
		
			(zenbakia ≥ 50) egia: {
				roman erantsi: ['Ⅼ'].
				zenbakia kendu: 50.
			}, eten.
		
			(zenbakia ≥ 50) egia: {
				roman erantsi: ['Ⅼ'].
				zenbakia kendu: 50.
			}, eten.
		
			(zenbakia ≥ 10) egia: {
				roman erantsi: ['Ⅹ'].
				zenbakia kendu: 10.
			}, eten.
			
			(zenbakia ≥ 9) egia: {
				roman erantsi: ['Ⅸ'].
				zenbakia kendu: 9.
			}, eten.
			
			(zenbakia ≥ 5) egia: {
				roman erantsi: ['Ⅴ'].
				zenbakia kendu: 5.
			}, eten.
			
			(zenbakia ≥ 4) egia: {
				roman erantsi: ['Ⅳ'].
				zenbakia kendu: 4.
			}, eten.
			
			(zenbakia ≥ 1) egia: {
				roman erantsi: ['Ⅰ'].
				zenbakia kendu: 1.
			}, eten.
		} prozedura.
	} bitartean: { <- zenbakia > 0. }. <- roman.
}.

Irteera idatzi: 1 roman, lerro-jauzia.
Irteera idatzi: 2 roman, lerro-jauzia.
Irteera idatzi: 4 roman, lerro-jauzia.
Irteera idatzi: 8 roman, lerro-jauzia.
Irteera idatzi: 16 roman, lerro-jauzia.
Irteera idatzi: 32 roman, lerro-jauzia.
Irteera idatzi: 64 roman, lerro-jauzia.
Irteera idatzi: 128 roman, lerro-jauzia.
Irteera idatzi: 256 roman, lerro-jauzia.
Irteera idatzi: 1024 roman, lerro-jauzia.
