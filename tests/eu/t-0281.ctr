>> q := Zerrenda ← 1 ; 2 ; 3.
{ q ? ['1']. } harrapatu: { Irteera idatzi: ['caught!'], lerro-jauzia. }, hasi.
{ q ? Egia. } harrapatu: { Irteera idatzi: ['caught!'], lerro-jauzia. }, hasi.
{ q ? Faltsua. } harrapatu: { Irteera idatzi: ['caught!'], lerro-jauzia. }, hasi.
{ q ? Ezer. } harrapatu: { Irteera idatzi: ['caught!'], lerro-jauzia. }, hasi.
{ q ? (Zerrenda berria). } harrapatu: { Irteera idatzi: ['caught!'], lerro-jauzia. }, hasi.
{ q ? (Objektua berria). } harrapatu: { Irteera idatzi: ['caught!'], lerro-jauzia. }, hasi.
{ q ? ({ ['Empty']. }). } harrapatu: { Irteera idatzi: ['caught!'], lerro-jauzia. }, hasi.
Irteera idatzi: ['caught them all'], lerro-jauzia.
