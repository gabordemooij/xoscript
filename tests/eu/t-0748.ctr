Irteera idatzi: ['Test object'], lerro-jauzia.
>> a := Objektua berria. 

a noiz: ['item:'] egin: { :boolearra
	berezko boolearra := boolearra. 
}.

a noiz: ['item'] egin: { <- berezko boolearra.
}.

a item: Egia.

Irteera idatzi: a item, lerro-jauzia.

>> old-bool-address := a item prototipoa memoria-helbidea.
a save-as: ['/tmp/a.bin'].
Irteera idatzi: ['========== RELOADING SNAP:'], lerro-jauzia.

>> b := Objektua load-from: ['/tmp/a.bin'].

(b item prototipoa memoria-helbidea = old-bool-address) egia: {
	Irteera idatzi: ['Object link re-attached.'], lerro-jauzia.
}.

Irteera idatzi: b item, lerro-jauzia.
