['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Irteera idatzi: (x + y), lerro-jauzia.

>> x := 10040.07.
>> y := 10305.60.

Irteera idatzi: (x + y), lerro-jauzia.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Irteera idatzi: (x + y + z), lerro-jauzia.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Irteera idatzi: (x + y + z), lerro-jauzia.

>> q := 0.1.2.

Irteera idatzi: (q), lerro-jauzia.

>> q := 012.

Irteera idatzi: (q), lerro-jauzia.
