Server init.
>> f := Formatua berria: ['%d'].
>> a := Blob berria: 4.
a bytes: ( Zerrenda berria ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob berria: 4.
b bytes: ( Zerrenda berria ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a nondik: 0 luzera: 3, bakoitza: { :i :byte
	Irteera idatzi: ( f aplikatu-osoa: byte ), lerro-jauzia.
}.
a ^ b.
a nondik: 0 luzera: 3, bakoitza: { :i :byte
	Irteera idatzi: ( f aplikatu-osoa: byte ), lerro-jauzia.
}.
a ^ b.
a nondik: 0 luzera: 3, bakoitza: { :i :byte
	Irteera idatzi: ( f aplikatu-osoa: byte ), lerro-jauzia.
}.
a askatu.
b askatu.

{ a ^ Objektua. } harrapatu: { :e Irteera idatzi: e, lerro-jauzia. }, hasi.
