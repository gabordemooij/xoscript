
>> a := Zerrenda ← (Zerrenda ← 100 ; 200 ; 300) ; (Zerrenda ← 9 ; 8 ; 7).
Irteera idatzi: ['at 0,1 :'].
Irteera idatzi: a ? 0 ? 1, lerro-jauzia. 
Irteera idatzi: ['at 1,2 :'].
Irteera idatzi: a ? 1 ? 2, lerro-jauzia. 
>> menu := Hiztegia berria.
menu jarri: (Zerrenda ← ['pizza'] ; ['spaghetti']) non: ['Italian Cuisine'].
menu jarri: (Zerrenda ← ['bifteki'] ; ['suflaki']) non: ['Greek Cuisine'].
Irteera idatzi: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), lerro-jauzia. 
Irteera idatzi: ['but not on the same plate.'], lerro-jauzia.
