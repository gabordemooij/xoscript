>> Combination := Zerrenda berria.

Combination noiz: ['erantsi:'] egin: { :el
	norbera 
	aurkitu: el, Ezer? egia: { norbera erantsi: el. }.
}.

>> colours := Combination berria.
colours
	erantsi: ['red'],
	erantsi: ['green'],
	erantsi: ['blue'],
	erantsi: ['red'].

Irteera idatzi: colours, lerro-jauzia.
