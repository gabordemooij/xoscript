

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa memoria-kudeaketa: 0.

>> txt := ['World Salad'].
Irteera idatzi: ['this text contains: '] + ( ( txt zatitu: [' '] ) zenbatu ) + [' words.'], lerro-jauzia.
txt := txt nondik: 6 luzera: 4.
Irteera idatzi: txt, lerro-jauzia.

Programa garbitu.

usedMemory1 := (Programa memoria ? 0).


txt := ['World Salad'].
Irteera idatzi: ['this text contains: '] + ( ( txt zatitu: [' '] ) zenbatu ) + [' words.'], lerro-jauzia.
