Programa memoria-kudeaketa: 4.

>> Doubler := Objektua berria.
>> Multiplier := Objektua berria.
Doubler noiz: ['double:and:'] egin: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier noiz: ['multiply:and:'] egin: { :x :y <- (x × y).
}.

Irteera idatzi: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), lerro-jauzia.
