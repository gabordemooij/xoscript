>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objektua berria.
⚄ noiz: ['drawFrom:length:'] egin: { :pool :zenbatu
	
	>> result := [''].
	
	{
		>> index := Zenbakia random % (pool luzera).
		result erantsi: ( pool karakterea: (index + 1) ).
		
	} × zenbatu. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? luzera.
Irteera idatzi: (['x↵'] x random luzera).
Irteera idatzi: (['y↵'] y ?? luzera).

