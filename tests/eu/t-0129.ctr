
Zerrenda noiz: ['product'] egin: {
	>> total := 1.
	norbera bakoitza: { :index :element
		total biderkatu: element.
	}. <- total.
}.

>> a := Zerrenda ← 1 ; 2 ; 3.
Irteera idatzi: a product, lerro-jauzia.
Irteera idatzi: (Zerrenda ← 2 ; 4 ; 8) product, lerro-jauzia. 
Irteera idatzi: (Zerrenda ← -2 ; 10) product, lerro-jauzia. 
Irteera idatzi: (Zerrenda ← 0.5 ; -2) product, lerro-jauzia. 
