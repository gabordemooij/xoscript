
Server init.
Irteera idatzi: ['Database test'], lerro-jauzia.

>> db := Maria-DB berria ostalaria: ['localhost'],
	erabiltzailea: ['xo'], 
	pasahitza: ['pass123'],
	datu-base-izena: ['xobase'],
	konektatu.

>> bilaketa-parametroak :=
db kontsulta: ['SELECT REPEAT('Blah',1000) AS blah'], 
eskuratu: { :row 
	Irteera idatzi: row blah luzera, lerro-jauzia.
}.
