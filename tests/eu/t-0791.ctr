Server init.

>> DB := Maria-DB berria ostalaria: ['localhost'],
	erabiltzailea: ['xo'],
	pasahitza: ['pass123'],
	datu-base-izena: ['xobase'],
	konektatu.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> bilaketa-parametroak := Maria-Kontsulta berria: SQL.

# set database
bilaketa-parametroak datu-basea: DB.

bilaketa-parametroak eskuratu: { :row
	Irteera idatzi: row world, lerro-jauzia.
}.
