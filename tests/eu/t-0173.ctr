

Zerrenda noiz: ['sum'] egin: {
	>> total := 0.
	norbera bakoitza: { :index :element
		total gehitu: element.
	}. <- total.
}.

Zerrenda noiz: ['product'] egin: {
	>> total := 1.
	norbera bakoitza: { :index :element
		total biderkatu: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa memoria-kudeaketa: 0.

{

>> a := Zerrenda ← ['hello'] ; ['world'] ; Egia ; Ezer ; 666.
a := a + ( Zerrenda ← 1 ).
Irteera idatzi: ( ['sum: '] + ( a sum ) ), lerro-jauzia.
Irteera idatzi: ( ['min: '] + ( a minimoa ) ), lerro-jauzia.
Irteera idatzi: ( ['max: '] + ( a maximoa ) ), lerro-jauzia.
Irteera idatzi: ( ['3rd: '] + ( a ? 2 ) ), lerro-jauzia.
Irteera idatzi: ( ['prd: '] + ( a product ) ), lerro-jauzia.
a ordenatu: { :a :b <- (b - a). }.
a bakoitza: { :i :e Irteera idatzi: ( i - 0 ), lerro-jauzia. }.

} hasi.

Programa garbitu.
usedMemory1 := (Programa memoria ? 0).


{

>> a := Zerrenda ← ['hello'] ; ['world'] ; Egia ; Ezer ; 666.
a := a + ( Zerrenda ← 1 ).
Irteera idatzi: ( ['sum: '] + ( a sum ) ), lerro-jauzia.
Irteera idatzi: ( ['min: '] + ( a minimoa ) ), lerro-jauzia.
Irteera idatzi: ( ['max: '] + ( a maximoa ) ), lerro-jauzia.
Irteera idatzi: ( ['3rd: '] + ( a ? 2 ) ), lerro-jauzia.
Irteera idatzi: ( ['prd: '] + ( a product ) ), lerro-jauzia.
a ordenatu: { :a :b <- (b - a). }.
a bakoitza: { :i :e Irteera idatzi: ( i - 0 ), lerro-jauzia. }.

} hasi.



Programa garbitu.
usedMemory2 := (Programa memoria ? 0).


{

>> a := Zerrenda ← ['hello'] ; ['world'] ; Egia ; Ezer ; 666.
a := a + ( Zerrenda ← 1 ).
Irteera idatzi: ( ['sum: '] + ( a sum ) ), lerro-jauzia.
Irteera idatzi: ( ['min: '] + ( a minimoa ) ), lerro-jauzia.
Irteera idatzi: ( ['max: '] + ( a maximoa ) ), lerro-jauzia.
Irteera idatzi: ( ['3rd: '] + ( a ? 2 ) ), lerro-jauzia.
Irteera idatzi: ( ['prd: '] + ( a product ) ), lerro-jauzia.
a ordenatu: { :a :b <- (b - a). }.
a bakoitza: { :i :e Irteera idatzi: ( i - 0 ), lerro-jauzia. }.

} hasi.



Programa garbitu.
usedMemory3 := (Programa memoria ? 0).

( usedMemory1 = usedMemory2 eta: usedMemory1 = usedMemory3, eta: usedMemory2 = usedMemory3 ) egia: {
	Irteera idatzi: ['No memory leaks here'].
}, faltsua: {
	Irteera idatzi: ['Leaking memory...'].
}.
