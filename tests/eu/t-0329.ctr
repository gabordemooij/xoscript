Irteera idatzi: ((Zerrenda berria
	noiz: ['plaque:'] egin: { :x berezko o := x. },
	noiz: ['plaque']  egin: { <- berezko o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Zerrenda ← 1)
	~ (Zerrenda ← 1 ; 2)
	~ (Zerrenda ← 1 ; 2 ; 3)
	~ (Zerrenda ← 1 ; 2 ; 3 ; 4)
	~ (Zerrenda ← 1 ; 2 ; 3 ; 4 ; 5)
) bakoitza: { :i :el
	{ Irteera idatzi: ataza-hau. } × el zenbatu.
	Irteera lerro-jauzia.
}) plaque, lerro-jauzia.


