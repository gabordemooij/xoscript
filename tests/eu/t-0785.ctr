Irteera idatzi: ['Test object'], lerro-jauzia.
>> a := Objektua berria. 

a noiz: ['item:'] egin: { :moment
	berezko moment := moment. 
}.

a noiz: ['item'] egin: { <- berezko moment.
}.

>> today := Zerrenda berria ; ( Unea berria zona: ['CEST'], urtea: 2026, hilabetea: 7 ).
a item: today.
Irteera idatzi: a item ? 0, lerro-jauzia.
a save-as: ['/tmp/a.bin'].
