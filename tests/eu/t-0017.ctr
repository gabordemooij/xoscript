Zenbakia noiz: ['factorial'] egin: {
	>> total := 1.
	{ :index total biderkatu: (norbera - (index)). } × norbera. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Irteera idatzi: a.
>> b := 2 + 3 factorial.
Irteera idatzi: b.
>> c := 3 factorial + 2.
Irteera idatzi: c.
>> d := 2 + (3 factorial).
Irteera idatzi: d.
Irteera idatzi: 2 + 3 factorial + 1.
