{
	ataza-hau errorea: ['Dont fail.'].
	unknown doSomething.
} harrapatu: {
	Irteera idatzi: ['Caught!'].
}, hasi.

{
	ataza-hau errorea: ['Dont fail.'].
	berezko unknown doSomething.
} harrapatu: {
	Irteera idatzi: ['Caught!'].
}, hasi.

{
	ataza-hau errorea: ['Dont fail.'].
	unknown := 122.
} harrapatu: {
	Irteera idatzi: ['Caught!'].
}, hasi.


{
	ataza-hau errorea: ['Dont fail.'].
	Egia eten.
	Irteera idatzi: ['FAIL'].
} harrapatu: {
	Irteera idatzi: ['Caught!'].
}, hasi.

{
	{
		ataza-hau errorea: ['Dont fail.'].
		Egia eten.
		Irteera idatzi: ['FAIL'].
	} harrapatu: { :x
		(x = ['Dont fail.']) egia: { ataza-hau errorea: ['Nested Caught!']. }.
	}, hasi.
} harrapatu: { :e
	Irteera idatzi: e.
}, hasi.
