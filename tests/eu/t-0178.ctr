

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa memoria-kudeaketa: 0.

>> txt := ['Word Salad'].
Irteera idatzi: ['last index of ord = '] + (( txt azkena: ['ord'] ) - 0), lerro-jauzia.
Irteera idatzi: ['index of ord = '] + (( txt aurkitu: ['ord'] ) - 0), lerro-jauzia.
Irteera idatzi: ['index of ad = '] + (( txt aurkitu: ['ad'] ) - 0), lerro-jauzia.
Irteera idatzi: ['last index of W = '] + (( txt azkena: ['W'] ) - 0), lerro-jauzia.
Irteera idatzi: ['last index of d = '] + (( txt azkena: ['d'] ) - 0), lerro-jauzia.
Irteera idatzi: ['txt equals Word Salad = '] + ( txt = ['Word Salad'] ), lerro-jauzia.
Irteera idatzi: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), lerro-jauzia.
Irteera idatzi: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), lerro-jauzia.
Irteera idatzi: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), lerro-jauzia.

