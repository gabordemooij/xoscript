Irteera idatzi: ['1,2,3,4,5,6,7,8,9,A,'], lerro-jauzia.
>> Scope := Objektua berria.
Scope noiz: ['initialize:'] egin: { :x berezko property := x. }.
Scope noiz: ['confirm'] egin: { Irteera idatzi: [',']. }.
Scope noiz: ['proba'] egin: {
	Irteera idatzi: berezko property.
	norbera confirm.
	( 1 = 1 ) egia: { Irteera idatzi: berezko property. norbera confirm. }.
	( 1 = 0 ) faltsua: { Irteera idatzi: berezko property. norbera confirm. }.
	>> y := 2. { Irteera idatzi: berezko property. norbera confirm. } bitartean: { y kendu: 1. <- (y > 0). }.
	{ Irteera idatzi: berezko property. norbera confirm. } × 1.
	(Zerrenda ← 1) bakoitza: {  Irteera idatzi: berezko property. norbera confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Hiztegia berria one: ['item']) bakoitza: { Irteera idatzi: berezko property. norbera confirm. }.
	{ 1 ÷ 0. } harrapatu: { Irteera idatzi: berezko property. norbera confirm. }, hasi.
	Irteera lerro-jauzia.
}.
>> scope1 := Scope berria.
scope1 initialize: ['X'].
scope1 proba.
>> function := { 
	berezko property := ['Y'].
	Irteera idatzi: berezko property.
	norbera confirm.
	( 1 = 1 ) egia: { Irteera idatzi: berezko property. norbera confirm. }.
	( 1 = 0 ) faltsua: { Irteera idatzi: berezko property. norbera confirm. }.
	>> y := 2. { Irteera idatzi: berezko property. norbera confirm. } bitartean: { y kendu: 1. <- (y > 0). }.
	{ Irteera idatzi: berezko property. norbera confirm. } × 1.
	(Zerrenda ← 1) bakoitza: {  Irteera idatzi: berezko property. norbera confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Hiztegia berria one: ['item']) bakoitza: { Irteera idatzi: berezko property. norbera confirm. }.
	{ 1 ÷ 0. } harrapatu: { Irteera idatzi: berezko property. norbera confirm. }, hasi.
	Irteera lerro-jauzia.
}.
function noiz: ['confirm'] egin: { Irteera idatzi: [',']. }.
function aplikatu: 1 eta: 2.
