Testua noiz: ['html'] egin: { <- (
		norbera
		ordeztu: ['&'] honekin: ['&amp;'],
		ordeztu: ['<'] honekin: ['&lt;'],
		ordeztu: ['>'] honekin: ['&gt;'],
		ordeztu: ['''] honekin: ['&apos;'],
		ordeztu: ['"'] honekin: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa memoria-kudeaketa: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Irteera idatzi: txt kopiatu html, lerro-jauzia.
Irteera idatzi: txt kopiatu minuskulak, lerro-jauzia.
Irteera idatzi: txt kopiatu maiuskulak, lerro-jauzia.
} hasi.

Programa garbitu.

usedMemory1 := (Programa memoria ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Irteera idatzi: txt kopiatu html, lerro-jauzia.
Irteera idatzi: txt kopiatu minuskulak, lerro-jauzia.
Irteera idatzi: txt kopiatu maiuskulak, lerro-jauzia.
} hasi.

Programa garbitu.
usedMemory2 := (Programa memoria ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Irteera idatzi: txt kopiatu html, lerro-jauzia.
Irteera idatzi: txt kopiatu minuskulak, lerro-jauzia.
Irteera idatzi: txt kopiatu maiuskulak, lerro-jauzia.
} hasi.

Programa garbitu.
usedMemory3 := (Programa memoria ? 0).



( usedMemory1 = usedMemory2 eta: usedMemory1 = usedMemory3, eta: usedMemory2 = usedMemory3 ) egia: {
	Irteera idatzi: ['No memory leaks here'].
}, faltsua: {
	Irteera idatzi: ['Leaking memory...'].
}.
