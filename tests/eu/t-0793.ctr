Server init.

>> DB := Maria-DB berria ostalaria: ['localhost'],
	erabiltzailea: ['xo'],
	pasahitza: ['pass123'],
	datu-base-izena: ['xobase'],
	konektatu.

{
	DB kontsulta:
	['DROP TABLE movies'],
	exekutatu.
} harrapatu: { Ezer. }, hasi.

DB kontsulta:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
exekutatu.

DB kontsulta: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parametroak: ( Zerrenda berria ; ['Halloween'] ),
exekutatu.

DB kontsulta: ['SELECT * FROM movies'],
eskuratu: { :movie
	Irteera idatzi: movie title, lerro-jauzia.
}.

