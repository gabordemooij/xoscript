# Can we use UTF8 in regex?
Server init.
>> p := Eredua berria: ['\\w'].
Irteera idatzi: ( p bat-etortzea: ['x'] ), lerro-jauzia.
Irteera idatzi: ( p bat-etortzea: ['é'] ), lerro-jauzia.
>> p := Eredua berria: ['(*UTF)(*UCP)\\w'].
Irteera idatzi: ( p bat-etortzea: ['é'] ), lerro-jauzia.
# should give 101