Irteera idatzi: ['Continue for-loop, No - before 6 and up.'], lerro-jauzia.
{ :i
	Irteera idatzi: (i + 1), lerro-jauzia.
	((i + 1) > 4) jarraitu.
	Irteera idatzi: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Irteera lerro-jauzia.
Irteera idatzi: ['Continue while-true, No --> before 5 and up.'], lerro-jauzia.
{
	Irteera idatzi: ['iteration #'] + x, lerro-jauzia.
	x gehitu: 1.
	((x < 5) ez) jarraitu.
	Irteera idatzi: ['-->'].
} bitartean: xIsLessThan10.
Irteera lerro-jauzia.
Irteera idatzi: ['Continue while-false, No - before 3 only.'], lerro-jauzia.
{
	Irteera idatzi: ['iteration #'] + x, lerro-jauzia.
	x kendu: 1.
	(x = 3) jarraitu.
	Irteera idatzi: ['-'].
} bitartean: { <- ( x > 0). }.

Irteera lerro-jauzia.
Irteera idatzi: ['Continue times-loop, No ||| before 3.'], lerro-jauzia.
{ :i
	Irteera idatzi: ['iteration #'] + i, lerro-jauzia.
	(i = 2) jarraitu.
	Irteera idatzi: ['|||'].
} × 5.

Irteera lerro-jauzia.

{ Egia jarraitu. Irteera idatzi: ['dont write this!'], lerro-jauzia. } hasi.

{ Egia jarraitu. Irteera idatzi: ['dont write this!'], lerro-jauzia. } harrapatu: { Irteera idatzi: ['Dont catch this!']. }, hasi.

Irteera idatzi: ['Test Array each-loop: 0, ... ,2'], lerro-jauzia.
(Zerrenda ← 1 ; 2 ; 3) bihurtu: { :i
	(i = 1) jarraitu.
	Irteera idatzi: ['iteration #'] + (i - 0), lerro-jauzia.
}.

Irteera idatzi: ['Test Map each-loop: c only'], lerro-jauzia.
>> m := Hiztegia berria.
m jarri: ['first'] non: ['a'], jarri: ['second'] non: ['b'], jarri: ['third'] non: ['c'].
m bakoitza: { :k :v
	(k ≠ ['c']) jarraitu.
	Irteera idatzi: ['iteration'] + k + v, lerro-jauzia.
}.

