>> t := Egia.
(t = Egia) egia: { Irteera idatzi: ['T']. }.
(t = Faltsua) egia: { Irteera idatzi: ['F']. }.
Irteera idatzi: ['|'].
>> t := Faltsua.
(t = Egia) egia: { Irteera idatzi: ['T']. }.
(t = Faltsua) egia: { Irteera idatzi: ['F']. }.
Irteera idatzi: ['|'].
>> f := Egia.
(t = Egia eta: f = Faltsua) egia: { Irteera idatzi: ['T']. }.
(t = Faltsua eta: f = Egia) egia: { Irteera idatzi: ['F']. }.
Irteera idatzi: ['|'].
>> n := Ezer.
(n Ezer?) egia: { Irteera idatzi: ['T']. }.
(n Ezer?) faltsua: { Irteera idatzi: ['F']. }.
Irteera idatzi: ['|'].
(f Boolean?) egia: { Irteera idatzi: ['T']. }.
(f Boolean?) faltsua: { Irteera idatzi: ['F']. }.



