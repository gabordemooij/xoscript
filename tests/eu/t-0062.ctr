Boolearra noiz: ['xor:'] egin: { :a :b <- ((a eta: b ez) edo: (a ez eta: b)).
}.

>> o := Objektua berria.
o noiz: ['hello'] egin: { ['Empty']. }.
{ o noiz: 2 egin: 3.} harrapatu: { :e Irteera idatzi: e, lerro-jauzia. }, hasi.
{ o noiz: ['proba'] egin: 3.} harrapatu: { :e Irteera idatzi: e, lerro-jauzia. }, hasi.
{ o noiz: ['hello'] egin: { ['Empty']. }.} harrapatu: { :e Irteera idatzi: e, lerro-jauzia. }, hasi. 
{ >> z := 4 ÷ 0. } harrapatu: { :e Irteera idatzi: e, lerro-jauzia. }, hasi. 
{ (Egia eta: Ezer) egia: { Irteera idatzi: ['X'].}. } harrapatu: { :e Irteera idatzi: e, lerro-jauzia. }, hasi. 
{ ([''] xor: 0) egia: { Irteera idatzi: ['X'].}. } harrapatu: { :e Irteera idatzi: e, lerro-jauzia. }, hasi. 
{ (1 < ['2']) egia: { Irteera idatzi: ['OK']. }. } harrapatu: { :e Irteera idatzi: e, lerro-jauzia. }, hasi. 
{ (1 < ['2.0']) egia: { Irteera idatzi: ['OK']. }. } harrapatu: { :e Irteera idatzi: e, lerro-jauzia. }, hasi. 
{ (1 < ['x2.0']) egia: { Irteera idatzi: ['NO!']. }. } harrapatu: { :e Irteera idatzi: e, lerro-jauzia. }, hasi. 
{ Irteera idatzi: (['hello OK there'] nondik: ['6'] luzera: ['2']). } hasi. 
