
Testua noiz: ['evaluate'] egin: {
	>> kodea := Fitxategia berria: ['/tmp/eval.ctr'].
	kodea idatzi: (norbera testua + ['.']).
	Programa erabili: ['/tmp/eval.ctr'].
}.

>> map :=
	(Hiztegia berria)
	jarri: ['Hi There'] non: ['two'],
	jarri: (Zerrenda ← ['hello'] ; ['world'] ; (Zerrenda ← 1 ; 2; 9) ; Faltsua) non: ['one'],
	jarri: ( (Hiztegia berria) jarri: ['wrrld'] non: ['misspelled'] ) non: ['three'],
	jarri: (Zerrenda ← ((Hiztegia berria) jarri: ['treasure'] non: ['hidden']) ; 2) non: ['four']. 
>> str := map testua.
>> map2 := Ezer.
(['map2 := '] + str ) evaluate.
Irteera idatzi: map2 ? ['one'] ? 0.
Irteera idatzi: map2 ? ['one'] ? 1.
Irteera idatzi: map2 ? ['four'] ? 0 ? ['hidden'].
Irteera idatzi: map2 ? ['one'] ? 2 ? 2.
