Irteera idatzi: ['Test object'], lerro-jauzia.
>> a := Objektua berria. 

a noiz: ['item:'] egin: { :binhelper
	berezko binhelper := binhelper. 
}.

a noiz: ['item'] egin: { <- berezko binhelper.
}.

a item: Bin berria.

>> old-binhelper-address := a item prototipoa memoria-helbidea.
a save-as: ['/tmp/a.bin'].
Irteera idatzi: ['========== RELOADING SNAP:'], lerro-jauzia.

>> b := Objektua load-from: ['/tmp/a.bin'].

(b item prototipoa memoria-helbidea = old-binhelper-address) egia: {
	Irteera idatzi: ['Object link re-attached.'], lerro-jauzia.
}.


