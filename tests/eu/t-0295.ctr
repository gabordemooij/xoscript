
>> dictionary := (
	Hiztegia berria
		jarri: ['b'] non: ['a'],
		jarri: ['a'] non: ['b'],
		jarri: ['z'] non: ['x'],
		jarri: ['hello'] non: ['hallo'],
		jarri: ['human'] non: ['human']
).

>> comparisons := Zerrenda berria.
dictionary bakoitza: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a konparatu: b)
	).
}.

comparisons ordenatu: { :a :b <- ( a konparatu: b ). }.
Irteera idatzi: ( comparisons batu: ['↵'] ), lerro-jauzia.
comparisons batu: ['↵'].
