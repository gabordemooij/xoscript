
>> city := Zerrenda ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Zerrenda ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature arabera: city.
>> cities := weather sarrerak ordenatu: { :a :b <- (a konparatu: b). }.
>> temperatures := weather balioak ordenatu: { :a :b <- (a konparatu: b) negatiboa?. }.

Irteera idatzi: (cities batu: [',']), lerro-jauzia.
Irteera idatzi: (temperatures batu: [',']), lerro-jauzia.
