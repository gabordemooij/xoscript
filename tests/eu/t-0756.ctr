Irteera idatzi: ['Test object'], lerro-jauzia.
>> greeter := Objektua berria.
greeter noiz: ['name:'] egin: { :izena
	berezko xname := izena. 
}.
greeter noiz: ['greet'] egin: {
	Irteera idatzi: ['Hello '] + berezko xname, lerro-jauzia.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Irteera idatzi: ['========== RELOADING SNAP:'], lerro-jauzia.
>> b := Objektua load-from: ['/tmp/a.bin'].
>> c := Objektua load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
