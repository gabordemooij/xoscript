# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Programa ezarpena: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server lotu: ( Zerrenda berria ;
 libname ; ['fopen'] ;
 ( Zerrenda berria ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
lotu: ( Zerrenda berria ;
 Ezer ; # means same lib
 ['fread'] ;
 ( Zerrenda berria ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Ezer ; # means same object (i.e. Stream)
 ['fread']
),
lotu: (
 Zerrenda berria ;
 Ezer ; # means same lib
 ['fwrite'] ;
 ( Zerrenda berria ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Ezer ; # means same lib
 ['fwrite']
),
lotu: (
 Zerrenda berria ;
 Ezer ; # means same lib
 ['rewind'] ;
 ( Zerrenda berria ; ['pointer'] ) ;
 ['int'] ;
 Ezer ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> bidea := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: bidea mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream mezua: ['fwrite'] argumentuak: (Zerrenda berria ; str ; 1 ; 6 ; fd ).
Irteera idatzi: bytes-written, lerro-jauzia.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob berria: 20.

# read from file
>> bytes-read := Stream mezua: ['fread'] argumentuak: (Zerrenda berria ; buf ; 1 ; 6 ; fd ).
Irteera idatzi: bytes-read, lerro-jauzia.
Irteera idatzi: buf, lerro-jauzia.

# free memory
str  askatu.
bidea askatu.
mode askatu.
buf  askatu.


