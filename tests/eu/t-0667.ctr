# test Program version

# this feature is disabled by default
Irteera idatzi: (
	Programa ezaugarria: 
	['RECURSIVE_STRINTPOL']
), lerro-jauzia.


# but if we set the time back
>> today := Unea 
zona: ['CEST'],
iturria: ['2026-02-15 10:00:00'].
Programa bertsioa: today.

# it will be enabled like it used to be (from now on)
Irteera idatzi: (
	Programa ezaugarria: 
	['RECURSIVE_STRINTPOL']
), lerro-jauzia.