# test catch-all methods
>> x13 := Objektua berria.
x13 noiz: ['a'] egin: { :a Irteera idatzi: 0, lerro-jauzia. }.
x13 noiz: ['a:'] egin: { :a Irteera idatzi: a, lerro-jauzia. <- 5. }.
x13 noiz: ['a:b:'] egin: { :a :b Irteera idatzi: (a + b), lerro-jauzia. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
