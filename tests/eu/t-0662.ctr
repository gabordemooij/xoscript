>> t := Ezer.

# you can control the time zone for
# parsing like this:
Unea zona: ['CET'].
t := Unea iturria: ['1981-02-03 04:05:06'].
Irteera idatzi: t, lerro-jauzia.

# now using CEST time zone:
Unea zona: ['CEST'].
t := Unea iturria: ['1981-02-03 04:05:06'].
Irteera idatzi: t, lerro-jauzia.

# error if string cannot be parsed
{ Unea iturria: ['1900']. } harrapatu: { Ezer. }, hasi.
