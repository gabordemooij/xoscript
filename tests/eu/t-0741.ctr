Irteera idatzi: ['Test object'], lerro-jauzia.
>> a := Objektua berria. 

a noiz: ['item:'] egin: { :octhelper
	berezko octhelper := octhelper. 
}.

a noiz: ['item'] egin: { <- berezko octhelper.
}.

a item: Oct berria.

>> old-octhelper-address := a item prototipoa memoria-helbidea.
a save-as: ['/tmp/a.bin'].
Irteera idatzi: ['========== RELOADING SNAP:'], lerro-jauzia.

>> b := Objektua load-from: ['/tmp/a.bin'].

(b item prototipoa memoria-helbidea = old-octhelper-address) egia: {
	Irteera idatzi: ['Object link re-attached.'], lerro-jauzia.
}.
