


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa memoria-kudeaketa: 0.
>> palette := Ezer.
>> colors := Ezer.

{
palette := Hiztegia berria.
palette 
	jarri: ['#F00'] non: ['red'],
	jarri: ['#0F0'] non: ['green'],
	jarri: ['#00F'] non: ['blue'].
Irteera idatzi: ['number of RGB codes in palette: '] + ( palette zenbatu ), lerro-jauzia.
Irteera idatzi: ['RGB code of green is: '] + ( palette ? ['green'] ), lerro-jauzia.
colors := [''].
( palette bakoitza: { :izena :kodea
		colors := colors + ( izena + [':'] + kodea ).
} ).
Irteera idatzi: ['All colors in palette: '] + colors, lerro-jauzia.
} hasi.
Programa garbitu.
usedMemory1 := (Programa memoria ? 0).

{
palette := Hiztegia berria.
palette 
	jarri: ['#F00'] non: ['red'],
	jarri: ['#0F0'] non: ['green'],
