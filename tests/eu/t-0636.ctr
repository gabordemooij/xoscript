# test url parsing

Server init.
>> url := URL iturria: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Irteera idatzi: ['scheme = '] + url eskema, lerro-jauzia.
Irteera idatzi: ['host = '] + url ostalaria, lerro-jauzia.
Irteera idatzi: ['port = '] + url ataka, lerro-jauzia.
Irteera idatzi: ['path = '] + url bidea, lerro-jauzia.
Irteera idatzi: ['query = '] + url bilaketa-parametroak, lerro-jauzia.
Irteera idatzi: ['fragment = '] + url zatia, lerro-jauzia.
