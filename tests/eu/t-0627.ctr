

# create a 64-bit integer for exact calculations
>> a := Int64 testutik: ['123'].

# to string
Irteera idatzi: a, lerro-jauzia.

# divide
Irteera idatzi: a / (Int64 testutik: ['3']), lerro-jauzia.

# multiply
Irteera idatzi: a * (Int64 testutik: ['2']), lerro-jauzia.

# add
Irteera idatzi: a + (Int64 testutik: ['1']), lerro-jauzia.

# subtract
Irteera idatzi: a - (Int64 testutik: ['2']), lerro-jauzia.

# compare
Irteera idatzi: ( a =   (Int64 testutik: ['123'])), lerro-jauzia.
Irteera idatzi: ( a !=: (Int64 testutik: ['124'])), lerro-jauzia.
Irteera idatzi: ( a <   (Int64 testutik: ['124'])), lerro-jauzia.
Irteera idatzi: ( a >   (Int64 testutik: ['122'])), lerro-jauzia.
Irteera idatzi: ( a >=: (Int64 testutik: ['123'])), lerro-jauzia.
Irteera idatzi: ( a <=: (Int64 testutik: ['123'])), lerro-jauzia.





	