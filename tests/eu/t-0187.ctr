Zenbakia noiz: ['factorial'] egin: {
	>> total := 1.
	{ :index total biderkatu: (norbera - index). } × norbera. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa memoria-kudeaketa: 0.

{
2 exponent factorial.
Irteera idatzi: (11 hondarra: 3), lerro-jauzia.
Irteera idatzi: (3.4 biribildu), lerro-jauzia.
Irteera idatzi: (7.1 gora-biribildu), lerro-jauzia.
Irteera idatzi: (7.9 behera-biribildu), lerro-jauzia.
}
hasi.

Programa garbitu.

usedMemory1 := (Programa memoria ? 0).

