Server init.
Irteera idatzi: ['Database date test'], lerro-jauzia.

>> db := Maria-DB berria ostalaria: ['localhost'],
	erabiltzailea: ['xo'], 
	pasahitza: ['pass123'],
	datu-base-izena: ['xobase'],
	konektatu.

>> bilaketa-parametroak :=
db kontsulta: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
eskuratu: { :row
	Irteera idatzi: row datetest, lerro-jauzia.
}.
