
>> Rectangle := Objektua berria.

Rectangle noiz: ['area'] egin: { <- berezko luzera * berezko width.
}.

Rectangle noiz: ['length:'] egin: { :luzera
	berezko luzera := luzera.
}.

Rectangle noiz: ['width:'] egin: { :width
	berezko width := width.
}.

Rectangle noiz: ['berria'] egin: {
	# this will not result into an infinite loop
	>> rectangle := norbera berria.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle berria.
Irteera idatzi: a area, lerro-jauzia. #0

>> b := Rectangle berria length: 2, width: 3.
Irteera idatzi: b area, lerro-jauzia. #6

