
>> Greeter := Objektua berria.
Greeter noiz: ['berria'] egin: {
	berezko izena := ['?'].
}.
Greeter noiz: ['name:'] egin: { :izena
	berezko izena := izena.
}.
Greeter noiz: ['greet'] egin: {
	Irteera idatzi: (['hello[you]'] [you]: berezko izena).
}.
>> friend := Greeter berria.
friend name: ['1'].
friend greet.
