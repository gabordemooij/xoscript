

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa memoria-kudeaketa: 0.

>> a := Zerrenda ← ['hello'] ; ['world'] ; Egia ; Ezer ; 666.
a egin kendu-azkena kendu-lehena aurretik-gehitu: ['hi'], erantsi: 999, prest.
Irteera idatzi: ( a batu: [','] ), lerro-jauzia.

Programa garbitu.
usedMemory1 := (Programa memoria ? 0).


a := Zerrenda ← ['hello'] ; ['world'] ; Egia ; Ezer ; 666.
a kendu-azkena. a kendu-lehena. a aurretik-gehitu: ['hi'], erantsi: 999.
Irteera idatzi: ( a batu: [','] ), lerro-jauzia.


Programa garbitu.
usedMemory2 := (Programa memoria ? 0).


a := Zerrenda ← ['hello'] ; ['world'] ; Egia ; Ezer ; 666.
a egin kendu-azkena kendu-lehena aurretik-gehitu: ['hi'], erantsi: 999, prest.
Irteera idatzi: ( a batu: [','] ), lerro-jauzia.


Programa garbitu.
usedMemory3 := (Programa memoria ? 0).



( usedMemory1 = usedMemory2 eta: usedMemory1 = usedMemory3, eta: usedMemory2 = usedMemory3 ) egia: {
