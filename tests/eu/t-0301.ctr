


>> wine := Objektua berria.


wine noiz: ['toString'] egin: { <- ['merlot'].
}.

wine noiz: ['naarTekst'] egin: { <- ['merlot'].
}.


wine noiz: ['='] egin: { :other wine <- ( norbera toString = other wine ).
}.

wine noiz: ['=='] egin: { :other wine <- ( norbera toString = other wine ).
}.



wine
	kasu: ['cabernet'] egin: { Irteera idatzi: ['it's a Cabernet!']. },
	kasu: ['syrah']    egin: { Irteera idatzi: ['it's a Syrah!'].    },
	kasu: ['merlot']   egin: { Irteera idatzi: ['it's a Merlot!'].   },
	kasu: ['malbec']   egin: { Irteera idatzi: ['it's a Malbec!'].   }.

Irteera lerro-jauzia.
