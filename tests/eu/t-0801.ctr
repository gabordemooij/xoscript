Server init.

>> db := Maria-DB berria ostalaria: ['localhost'],
	erabiltzailea: ['xo'],
	pasahitza: ['pass123'],
	datu-base-izena: ['xobase'],
	konektatu.

>> del := db kontsulta: ['DELETE FROM book WHERE id > 0'].
{  del exekutatu. db berretsi. } harrapatu: { :e db desegin.  }, hasi.

>> zenbatu := db kontsulta: ['SELECT COUNT(*) AS num FROM book'].
zenbatu eskuratu: { :row Irteera idatzi: row num, lerro-jauzia. }.
