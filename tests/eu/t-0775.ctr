Irteera idatzi: ['Test object'], lerro-jauzia.
>> l := Zerrenda berria ; 1 ; ( Zerrenda berria ; (Unea berria: 1) ; (Int64 testutik: ['321']) ; (Zerrenda berria ; 3)).
Irteera idatzi: l, lerro-jauzia.
>> old-lst-address := l prototipoa memoria-helbidea.
l save-as: ['/tmp/a.bin'].
Irteera idatzi: ['========== RELOADING SNAP:'], lerro-jauzia.
>> b := Objektua load-from: ['/tmp/a.bin'].
(b prototipoa memoria-helbidea = old-lst-address) egia: {
	Irteera idatzi: ['Object link re-attached.'], lerro-jauzia.
}.
Irteera idatzi: b, lerro-jauzia.
