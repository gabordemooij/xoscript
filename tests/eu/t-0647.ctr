Server init.
Irteera idatzi: ['Database time test'], lerro-jauzia.

>> db := Maria-DB berria ostalaria: ['localhost'],
	erabiltzailea: ['xo'], 
	pasahitza: ['pass123'],
	datu-base-izena: ['xobase'],
	konektatu.

>> bilaketa-parametroak :=
db kontsulta: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
eskuratu: { :row
	Irteera idatzi: row timetest, lerro-jauzia.
}.
