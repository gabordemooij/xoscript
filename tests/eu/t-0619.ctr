>> HTML := Objektua berria.
HTML noiz: ['erantzun:'] egin: { :tag 
	Irteera idatzi: (['<tag>'] tag: tag), lerro-jauzia.
}.
HTML noiz: ['erantzun:eta:'] egin: { :tag :html 
	Irteera idatzi: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), lerro-jauzia.
}.
>> html := HTML berria.
html body h1: ['header'].

