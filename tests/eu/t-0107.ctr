
Irteera idatzi: ['Break for-loop, 0-4.'], lerro-jauzia.
{ :i
	Irteera idatzi: ['iteration #'] + i, lerro-jauzia.
	(i = 4) eten.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Irteera idatzi: ['Break while-true loop, 0-4.'], lerro-jauzia.
{
	Irteera idatzi: ['iteration #'] + x, lerro-jauzia.
	x gehitu: 1.
	((x < 5) ez) eten.
} bitartean: xIsLessThan10.

Irteera idatzi: ['Break while-false loop, 5,4.'], lerro-jauzia.
{
	Irteera idatzi: ['iteration #'] + x, lerro-jauzia.
	x kendu: 1.
	(x = 3) eten.
} bitartean: { <- (x > 0). }.

Irteera idatzi: ['Break times loop, 1-4.'], lerro-jauzia.
{ :i
	Irteera idatzi: ['iteration #'] + i, lerro-jauzia.
	(i = 4) eten.
} × 5.

Irteera idatzi: ['Break block, dont print line.'], lerro-jauzia.
{ Egia eten. Irteera idatzi: ['dont write this!'], lerro-jauzia. } hasi.

Irteera idatzi: ['Break block, dont fire catch...'], lerro-jauzia.
{ Egia eten. Irteera idatzi: ['dont write this!'], lerro-jauzia. } harrapatu: { Irteera idatzi: ['Dont catch this!']. }, hasi.

Irteera idatzi: ['Test Array each-loop: 0,1'], lerro-jauzia.
(Zerrenda ← 1 ; 2 ; 3) bihurtu: { :i
	Irteera idatzi: ['iteration #'] + i, lerro-jauzia.
	(i = 1) eten.
}.

Irteera idatzi: ['Test Map each-loop: c only'], lerro-jauzia.
>> m := Hiztegia berria.
m jarri: ['first'] non: ['a'], jarri: ['second'] non: ['b'], jarri: ['third'] non: ['c'].
m bakoitza: { :k :v
	Irteera idatzi: ['iteration'] + v + k, lerro-jauzia.
	Egia eten.
}.

