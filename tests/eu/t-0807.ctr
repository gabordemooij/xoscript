# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB berria ostalaria: ['localhost'],
	erabiltzailea: ['xo'],
	pasahitza: ['pass123'],
	datu-base-izena: ['xobase'],
	konektatu.

>> bilaketa-parametroak := db kontsulta: ['SELECT %% FROM'].
{ bilaketa-parametroak exekutatu. } harrapatu: { :e
	Irteera idatzi: ( e barne-dauka: ['%%'] ), lerro-jauzia.
}, hasi.
