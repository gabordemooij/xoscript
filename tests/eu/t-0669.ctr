# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Kutxa-gotorra 
	pasahitz-laburpena: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Kutxa-gotorra 
	pasahitz-laburpena: hash egiaztatu: a1.
	# fail 
>> b := Kutxa-gotorra
	pasahitz-laburpena: hash egiaztatu: a2.
	# ok!

Irteera idatzi: a, lerro-jauzia.
Irteera idatzi: b, lerro-jauzia.

