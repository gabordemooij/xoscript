
Server init.
Irteera idatzi: ['Database test'], lerro-jauzia.

>> db := Maria-DB berria ostalaria: ['localhost'],
	erabiltzailea: ['xo'], 
	pasahitza: ['pass123'],
	datu-base-izena: ['xobase'],
	konektatu.

>> bilaketa-parametroak :=
db kontsulta: ['SELECT UNHEX('CAFE') AS blobby'],
eskuratu: { :row
	Irteera idatzi: ( row blobby nondik: 0 luzera: 2 ), lerro-jauzia.
	row blobby askatu.
}.
