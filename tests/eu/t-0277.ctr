

>> Cat := Objektua berria.

Cat noiz: ['berria'] egin: {
	berezko sound := ['meow!'].
}.

Cat noiz: ['nieuw'] egin: {
	berezko sound := ['meow!'].
}.

Cat noiz: ['makeSound'] egin: { <- berezko sound.
}.

Cat noiz: ['greet'] egin: { <- norbera makeSound.
}.

>> cat := Cat berria.
Irteera idatzi: cat greet.
