# Test ASCII variants

# Numbers

Irteera idatzi: (2 !=: 3), lerro-jauzia.
Irteera idatzi: (2 <=: 2), lerro-jauzia.
Irteera idatzi: (2 >=: 2), lerro-jauzia.

# Strings

Irteera idatzi: (['b'] >=: ['a']), lerro-jauzia.
Irteera idatzi: (['b'] !=: ['a']), lerro-jauzia.
Irteera idatzi: (['b'] <=: ['c']), lerro-jauzia.

# Bools

Irteera idatzi: (Egia !=: Faltsua), lerro-jauzia.

# Objects

Irteera idatzi: (Objektua berria !=: Objektua berria), lerro-jauzia.

# ASCII list symbol <-:

Irteera idatzi: (Zerrenda <<: 1, ; 2 ; 3) zenbatu = 3, lerro-jauzia.

