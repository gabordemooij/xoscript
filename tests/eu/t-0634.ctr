# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Programa shell-escape: ['abc'].
Irteera idatzi: c, lerro-jauzia.
Irteera idatzi: ( Programa sistema: ['echo '] + c ), lerro-jauzia.

c := Programa shell-escape: ['a'b'c'].
Irteera idatzi: c, lerro-jauzia.
Irteera idatzi: ( Programa sistema: ['echo '] + c ), lerro-jauzia.

c := Programa shell-escape: ['a\'c'].
Irteera idatzi: c, lerro-jauzia.
Irteera idatzi: ( Programa sistema: ['echo '] + c ), lerro-jauzia.