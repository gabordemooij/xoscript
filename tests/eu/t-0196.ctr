
>> animal := Objektua berria. 
 
 animal noiz: ['name:'] egin: { :n
berezko izena := n.
}. 


animal name: ['Diva']. 
 
animal noiz: ['izena'] egin: { <- izena.
}.

>> cat := animal berria.
 
 cat name: ['Diva']. 
 
 cat noiz: ['izena'] egin: { <- ['your royal highness ']
+ (norbera izena).
}.

Irteera idatzi: cat izena.
