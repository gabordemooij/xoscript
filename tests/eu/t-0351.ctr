	).
	>> s := o testua.
	>> o2 := s objektua.
	(s  mota = Testua mota) egia: { Irteera idatzi: ['OK1'], lerro-jauzia. }.
	(o2 mota = Hiztegia mota) egia: { Irteera idatzi: ['OK2'], lerro-jauzia. }.
}.

Programa memoria-kudeaketa: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Programa garbitu.
