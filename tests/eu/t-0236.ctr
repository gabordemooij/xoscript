>> Slurp := Objektua berria.
Slurp noiz: ['berria'] egin: {
	berezko str := [''].
}.


Slurp noiz: ['erantzun:'] egin: { :blah
		(berezko str ≠ ['']) egia: {
			berezko str erantsi: [' '].
		}.
		berezko str erantsi: blah.
}.
Slurp noiz: ['erantzun:eta:'] egin: { :blah :blahah
		(berezko str ≠ ['']) egia: {
			berezko str erantsi: [' '].
		}.
		(blah luzera > 1) egia: {
			berezko str erantsi: (blah nondik: 0 luzera: (blah luzera - 1)).
		}, bestela: {
			berezko str erantsi: blah.
		}.
		berezko str erantsi: [' '].
		berezko str erantsi: blahah.
}.
Slurp noiz: ['obtain'] egin: {
	>> buffer := berezko str.
	berezko str := ['']. <- buffer.
}.

>> bilaketa-parametroak := Slurp berria.
bilaketa-parametroak select: ['*'], from users where: ['id = 2'].
Irteera idatzi: (bilaketa-parametroak obtain), lerro-jauzia.
