# test qualifiers

Programa garbitu.

>> Fruit := Objektua berria.
Fruit noiz: ['berria'] egin: {
	>> f := norbera berria.
	f apples: 0. <- f.
}.
Fruit noiz: ['apples:'] egin: { :a berezko apples := a. }.
Fruit noiz: ['apples'] egin: { <- berezko apples. }.
Fruit noiz: ['+'] egin: { :f
	>> n := Fruit berria.
	n apples: (f apples + berezko apples). <- n.
}.
Zenbakia noiz: ['apples'] egin: { <- ((Fruit berria) apples: norbera).
}.

Fruit noiz: ['testua'] egin: { <- berezko apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Irteera idatzi: q, lerro-jauzia.




q := 3 apples + 4 apples.
Irteera idatzi: q, lerro-jauzia.



q := 3 apples + 4 apples.
Irteera idatzi: q, lerro-jauzia.


