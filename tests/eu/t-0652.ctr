# test number -> string -> number
{

	>> x := Zenbakia artean: 0 eta: 1000000.
	>> d := Zenbakia artean: 1 eta: 7.
	>> e := 10 berretura: d.

	x zatitu-honekin: e.
	>> y := x testua zenbakia.

	(x = y) faltsua: {
		Irteera idatzi: x, lerro-jauzia.
		Irteera idatzi: y, lerro-jauzia.
		Programa amaitu.
	}.

} * 1000.
Irteera idatzi: ['OK'], lerro-jauzia.