

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa memoria-kudeaketa: 0.

>> txt := ['1.6'].
>> n := txt zenbakia.
>> t := txt boolearra.
Irteera idatzi: n, lerro-jauzia.
Irteera idatzi: t, lerro-jauzia.
Irteera idatzi: n mota, lerro-jauzia.
Irteera idatzi: t mota, lerro-jauzia.

Programa garbitu.

usedMemory1 := (Programa memoria ? 0).


txt := ['1.6'].
n := txt zenbakia.
t := txt boolearra.
Irteera idatzi: n, lerro-jauzia.
Irteera idatzi: t, lerro-jauzia.
Irteera idatzi: n mota, lerro-jauzia.
Irteera idatzi: t mota, lerro-jauzia.

Programa garbitu.
usedMemory2 := (Programa memoria ? 0).


txt := ['1.6'].
n := txt zenbakia.
t := txt boolearra.
Irteera idatzi: n, lerro-jauzia.
Irteera idatzi: t, lerro-jauzia.
Irteera idatzi: n mota, lerro-jauzia.
Irteera idatzi: t mota, lerro-jauzia.

Programa garbitu.
usedMemory3 := (Programa memoria ? 0).



( usedMemory1 = usedMemory2 eta: usedMemory1 = usedMemory3, eta: usedMemory2 = usedMemory3 ) egia: {
	Irteera idatzi: ['No memory leaks here'].
}, faltsua: {
	Irteera idatzi: ['Leaking memory...'].
}.
