


>> Deck := Zerrenda berria.
Deck noiz: ['print'] egin: {
        >> len := norbera zenbatu - 1.
        { :i
                >> len2 := norbera zenbatu - 1.
                Irteera idatzi: ['len: '].
                Irteera idatzi: len, lerro-jauzia.
                Irteera idatzi: ['len2: '].
                Irteera idatzi: len2, lerro-jauzia.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
