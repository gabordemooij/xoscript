# test list operations


>> cakes := Zerrenda ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes ordeztu: 1 luzera: 2 honekin: ( Zerrenda ← ['cinnamon'] ; ['pineapple'] ).
Irteera idatzi: (buy batu: [',']), lerro-jauzia.


>> buy := cakes ordeztu: 1 luzera: 12 honekin: ( Zerrenda ← ['cinnamon'] ; ['pineapple'] ).
Irteera idatzi: (buy batu: [',']), lerro-jauzia.


>> buy := cakes ordeztu: 2 luzera: 10 honekin: ( Zerrenda berria ).
Irteera idatzi: (buy batu: [',']), lerro-jauzia.


>> buy := cakes ordeztu: 0 luzera: 1 honekin: ( Zerrenda berria ).
Irteera idatzi: (buy batu: [',']), lerro-jauzia.


>> buy := cakes ordeztu: ['0'] luzera: ['1'] honekin: ['x'].
Irteera idatzi: (buy batu: [',']), lerro-jauzia.
