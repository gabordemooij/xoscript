>> randomizer := { :a :b
	>> minimoa := ( a < b ) edo: a edo: b.
	>> maximoa := ( a > b ) edo: a edo: b.
	>> x := Ezer.
	{
		x := Zenbakia artean: a eta: b.
		((x < minimoa) edo: (x > maximoa)) egia: { 
			Irteera idatzi: (['Invalid value!']).
			Programa amaitu.
		}.
	} 
	× 100. <- x.
}.
randomizer aplikatu: 0 eta: 0.
