Irteera idatzi: ['Test object'], lerro-jauzia.
>> a := Objektua berria. 
a noiz: ['item:'] egin: { :int64
	berezko int64 := int64. 
}.
a noiz: ['item'] egin: { <- berezko int64.
}.
a item: ( Int64 testutik: ['9999'] ).
Irteera idatzi: a item, lerro-jauzia.
>> old-int64-address := a item prototipoa memoria-helbidea.
a save-as: ['/tmp/a.bin'].
Irteera idatzi: ['========== RELOADING SNAP:'], lerro-jauzia.
>> b := Objektua load-from: ['/tmp/a.bin'].
(b item prototipoa memoria-helbidea = old-int64-address) egia: {
	Irteera idatzi: ['Object link re-attached.'], lerro-jauzia.
}.
Irteera idatzi: ( b item ), lerro-jauzia.
