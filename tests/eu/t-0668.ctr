# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob berria: 8, bytes: (
	Zerrenda berria ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Irteera idatzi: ( utf16 deskodetu: ['utf16le'] ), lerro-jauzia.

utf16 askatu.
>> utf32 := Blob berria: 13, bytes: (
	Zerrenda berria ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Irteera idatzi: ( utf32 deskodetu: ['utf32be'] ), lerro-jauzia.
utf32 askatu.