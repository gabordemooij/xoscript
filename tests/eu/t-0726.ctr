# test buffers PKI/Sign 
Server init.

>> long := ( Zerrenda berria bete: 1000 honekin: ['a'] ) batu: [''].

# sign a message
Irteera idatzi: ( 
	Kutxa-gotorra sinatu: ['abc'] gakoarekin: long
), lerro-jauzia.

Irteera idatzi: ( 
	Kutxa-gotorra
		egiaztatu: ['abc'] 
		sinadura: long 
		gakoarekin: long
), lerro-jauzia.

Irteera idatzi: (
	Kutxa-gotorra pasahitz-laburpena: long egiaztatu: long
), lerro-jauzia.
