
Server init.
>> rq := HTTP-Eskaera berria.
Irteera idatzi: ['HTTP-GET d[]=']  + ( rq get-zerrenda: ['d[]'] ), lerro-jauzia. # GET
Irteera idatzi: ['HTTP-GET f[]=']  + ( rq get-zerrenda: ['f[]'] ), lerro-jauzia. # GET
Irteera idatzi: ['HTTP-POST e[]='] + ( rq post-zerrenda: ['e[]'] ), lerro-jauzia. # GET
Irteera idatzi: ['HTTP-POST c=']   + ( rq post: ['c'] ), lerro-jauzia. # GET
Irteera idatzi: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), lerro-jauzia. # GET
