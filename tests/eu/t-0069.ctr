

Testua noiz: ['html'] egin: { <- (
		norbera
		ordeztu: ['&'] honekin: ['&amp;'],
		ordeztu: ['<'] honekin: ['&lt;'],
		ordeztu: ['>'] honekin: ['&gt;'],
		ordeztu: ['"'] honekin: ['&quot;']
	).
}.


Irteera idatzi: ([' left trimmed '] moztu) + [' '] + ( ['and right trimmed'] moztu) + ['!'], lerro-jauzia.
Irteera idatzi: ['<html>"html & entities"</html>'] html.
