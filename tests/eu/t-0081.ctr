>> map1 := Hiztegia berria.
>> key1 := Zerrenda berria.
>> key2 := Zerrenda berria.

map1
	jarri: ['hello'] non: key1,
	jarri: ['world'] non: key2.


Irteera
	idatzi: ['Map #1 contains: '] + (map1 non: key1),
	idatzi: [' and '] + (map1 non: key2), lerro-jauzia.

>> KeyeableArray := Zerrenda berria.
KeyeableArray noiz: ['toString'] egin: { <- (norbera zenbatu) toString.
}.

>> map2 := Hiztegia berria.
key1 := KeyeableArray berria.
key2 := KeyeableArray berria.

key1 erantsi: 1.

map2
	jarri: ['hello'] non: key1,
	jarri: ['world'] non: key2.

Irteera
	idatzi: ['Map #2 contains: '] + (map2 non: key1),
	idatzi: [' and '] + (map2 non: key2), lerro-jauzia.
