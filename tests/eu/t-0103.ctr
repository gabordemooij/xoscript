>> a := Zerrenda ← Objektua ; Egia ; Faltsua ; Boolearra ; 1 ; Zenbakia ; ['Str'] ; Testua ; { ['Empty']. }.
Irteera idatzi: (a zenbatu), lerro-jauzia.
{ :i
	Irteera idatzi: 
	['a '] + 
	((a ? i) mota) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Ezer?) edo: [''] edo: ['NOT']) + 
	[' Nil.'],
	lerro-jauzia.
} × (a zenbatu).
Irteera idatzi: ['but.. Nil is.. '] + ((Ezer Ezer?) edo: ['certainly NIL!'] edo: ['not NIL??']), lerro-jauzia.