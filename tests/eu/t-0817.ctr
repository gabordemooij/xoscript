# a value ending in the first part of an opening quote must survive serialization
>> balioak := Zerrenda berria
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

balioak bakoitza: { :i :value
	>> d := Hiztegia berria.
	d jarri: value non: ['k'].
	d jarri: ['second'] non: ['j'].
	>> r := d kodea objektua.
	Irteera idatzi: r zenbatu, lerro-jauzia.
	Irteera idatzi: ( (r non: ['k']) = value ), lerro-jauzia.
}.
