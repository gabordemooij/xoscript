>> invoice := Objektua berria.
invoice noiz: ['hasi'] egin: {
        berezko zenbakia := 0.
}.

invoice noiz: ['zenbakia'] egin: {
        berezko zenbakia gehitu: 1. <- berezko zenbakia kopiatu.
}.

>> year-invoice := invoice berria.
year-invoice noiz: ['start:'] egin: { :urtea
	berezko zenbakia := urtea.
}.

year-invoice start: 202000.
Irteera idatzi: year-invoice zenbakia, lerro-jauzia.
Irteera idatzi: year-invoice zenbakia, lerro-jauzia.
