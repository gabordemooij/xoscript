Server init.

>> DB := Maria-DB berria ostalaria: ['localhost'],
	erabiltzailea: ['xo'],
	pasahitza: ['pass123'],
	datu-base-izena: ['xobase'],
	konektatu.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB kontsulta: SQL.

# now you don't have to set DB
query2 eskuratu: { :row
	Irteera idatzi: row world, lerro-jauzia.
}.
