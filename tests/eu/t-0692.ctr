Server init.

Irteera idatzi: (
	Eredua berria: ['^\\w+$'],
	bat-etortzea: ['test@example.com'] 
), lerro-jauzia. # 0 match, fails on @ and .

Irteera idatzi: (
	Eredua berria: ['^[^@]+@[^\.]+\.\\w+$'],
	bat-etortzea: ['test@example.com'] 
), lerro-jauzia. # 1 match

Irteera idatzi: (
	Eredua berria: ['[^@]+@[^\.]+\.\\w+'],
	bat-etortzea: ['test@example.com'] 
), lerro-jauzia. # 1 match

Irteera idatzi: (
	Eredua berria: ['([^@]+)@([^\.]+)\.\\w+'],
	bat-etortzea: ['test@example.com'] 
), lerro-jauzia. # 1 match, groups dont matter

Irteera idatzi: (
	Eredua berria: ['[a-z]'],
	bat-etortzea: ['test@example.com'] 
), lerro-jauzia. # 14 matches

Irteera idatzi: (
	Eredua berria: ['.*'],
	bat-etortzea: ['test@example.com'] 
), lerro-jauzia. # 1 match (all)

Irteera idatzi: (
	Eredua berria: ['(.*)'],
	bat-etortzea: ['test@example.com'] 
), lerro-jauzia. # 1 match (all)

Irteera idatzi: (
	Eredua berria: ['\\s*[^@]+@[^\.]+\.\\w+'],
	bat-etortzea: ['test@example.com'] 
), lerro-jauzia. # 1 match, prefix space optional, gets ignored