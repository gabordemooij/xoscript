>> str := ['write:'].
Irteera mezua: ['idatzi:'] argumentuak: (Zerrenda ← ['Hello World']), lerro-jauzia. 

Zenbakia noiz: ['isbetween:and:'] egin: { :a :b <- ((norbera ≥ a) eta: (norbera ≤ b)).
}.

str := ['isbetween:and:'].
Irteera idatzi: (3 mezua: str argumentuak: (Zerrenda ← 2 ; 8)), lerro-jauzia.
Irteera idatzi: (3 mezua: str argumentuak: (Zerrenda ← 1 ; 2)), lerro-jauzia.


>> CoffeeMachine := Objektua berria.
CoffeeMachine noiz: ['makeCoffeeWithSugar:milk:'] egin: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Zerrenda ← 4 ; 2.
Irteera idatzi: ( CoffeeMachine mezua: order argumentuak: coffeeConfiguration ), lerro-jauzia.
