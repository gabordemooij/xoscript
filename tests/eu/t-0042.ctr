>> items := Hiztegia berria.
items jarri: ['black'] non: ['coffee'], jarri: ['earl grey'] non: ['tea'].
Irteera idatzi: (items non: ['coffee']), idatzi: (items non: ['tea']).
Irteera idatzi: ['there are'] + items zenbatu + [' items in the array.'].
items jarri: ['capuccino'] non: ['coffee'].
Irteera idatzi: ['Now my coffee is.. '] + (items non: ['coffee']).
items jarri: ['aaa'] non: ['1'].
items jarri: ['bbb'] non: ['2'].
Irteera idatzi: (items non: ['a']).
