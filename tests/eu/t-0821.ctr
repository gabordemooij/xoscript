# a quote that never closes must give an error, not an endless loop
>> bidea := ['/tmp/test0821.csv'].
>> file := Fitxategia berria: bidea.

file idatzi: ['a,b\n"1,2\n'].
{
	file mugatzailea: [','] komatxoa: ['"'] lerroak: { :line
		Irteera idatzi: line, lerro-jauzia.
	}.
} harrapatu: { :e Irteera idatzi: e, lerro-jauzia. }, hasi.

# a closed quote still works
file idatzi: ['a,b\n"1,2",3'].
file mugatzailea: [','] komatxoa: ['"'] lerroak: { :line
	Irteera idatzi: line, lerro-jauzia.
}.
file ezabatu.
