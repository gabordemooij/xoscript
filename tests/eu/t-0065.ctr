Zenbakia noiz: ['factorial'] egin: {
	>> total := 1.
	{ :index total biderkatu: (norbera - (index)). } × norbera. <- total.
}.
>> Printer := Objektua berria.
Printer noiz: ['print:and:'] egin: { :x :y
	Irteera idatzi: ['a='] + x + [', b='] + y, lerro-jauzia.
}.
>> a := 4.5. >> b := a behera-biribildu.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a gora-biribildu.
Printer print: a and: b.
a := 4.5. b := a behera-biribildu.
Printer print: a and: b.
a := 4.5. b := a biribildu.
Printer print: a and: b.
a := 4.2. b := a biribildu.
Printer print: a and: b.

