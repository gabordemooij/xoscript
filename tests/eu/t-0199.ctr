
Programa memoria-kudeaketa: 4.

>> Animal := Objektua berria.
Animal noiz: ['make'] egin: {
	>> animal := Objektua berria.
	animal noiz: ['makeSound'] egin: {
		Irteera idatzi: berezko sound.
	}. <- animal.
}.
>> Cat := Objektua berria.
Cat noiz: ['make'] egin: {
	>> cat := Animal make.
	cat noiz: ['init'] egin: {
		berezko sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
