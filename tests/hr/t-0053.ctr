60 × {
	>> x := (Broj nasumičan % 6) + 1.
	(x ≤ 6) laž: { Izlaz piši: ['NEUSPJEH']. }.
	(x ≥0) laž: { Izlaz piši: ['NEUSPJEH']. }.
	x := (Broj nasumičan % 3) + 1.
	(x < 3) laž: { Izlaz piši: ['NEUSPJEH']. }.
	(x>-1) laž: { Izlaz piši: ['NEUSPJEH']. }.
	x := ((Logički preokreni) broj).
	(x = 0 ili: x = 1) laž: { Izlaz piši: ['NEUSPJEH']. }.
	x := ((Istina preokreni) broj).
	(x = 0 ili: x = 1) laž: { Izlaz piši: ['NEUSPJEH']. }.
	x := (Logički preokreni ili: ['GLAVA'] ili: ['PISMO']).
	((x = ['GLAVA']) ili: (x = ['PISMO'])) laž: { Izlaz piši: ['NEUSPJEH']. }.
}.
Izlaz piši: ['GOTOVO'].

