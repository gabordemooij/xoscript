60 × {
	>> x := (Broj random % 6) + 1.
	(x ≤ 6) laž: { Izlaz piši: ['FAIL']. }.
	(x ≥0) laž: { Izlaz piši: ['FAIL']. }.
	x := (Broj random % 3) + 1.
	(x < 3) laž: { Izlaz piši: ['FAIL']. }.
	(x>-1) laž: { Izlaz piši: ['FAIL']. }.
	x := ((Logički flip) broj).
	(x = 0 ili: x = 1) laž: { Izlaz piši: ['FAIL']. }.
	x := ((Istina flip) broj).
	(x = 0 ili: x = 1) laž: { Izlaz piši: ['FAIL']. }.
	x := (Logički flip ili: ['HEAD'] ili: ['TAIL']).
	((x = ['HEAD']) ili: (x = ['TAIL'])) laž: { Izlaz piši: ['FAIL']. }.
}.
Izlaz piši: ['DONE'].

