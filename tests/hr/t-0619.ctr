>> HTML := Objekt novi.
HTML na: ['odgovori:'] učini: { :tag 
	Izlaz piši: (['<tag>'] tag: tag), novi-red.
}.
HTML na: ['odgovori:i:'] učini: { :tag :html 
	Izlaz piši: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), novi-red.
}.
>> html := HTML novi.
html body h1: ['header'].

