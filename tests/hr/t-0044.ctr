>> list := Popis novi.
list ~ ['hello'].
Izlaz piši: list broj-elemenata.
list dodaj-na-kraj: ['world'].
Izlaz piši: list broj-elemenata.
Izlaz piši: list izvadi-zadnji, piši: list broj-elemenata.
list dodaj-na-kraj: ['there'].
Izlaz piši: list broj-elemenata.
Izlaz piši: (list položaj: 0), piši: (list položaj: 1).
list stavi: ['xmas'] na: 1.
list stavi: ['merry'] na: 0.
Izlaz piši: list broj-elemenata.
Izlaz piši: (list položaj: 0), piši: (list položaj: 1).
