# test buffers PKI/Sign 
Server init.

>> long := ( Popis novi ispuni: 1000 s: ['a'] ) spoji: [''].

# sign a message
Izlaz piši: ( 
	Sef potpiši: ['abc'] ključem: long
), novi-red.

Izlaz piši: ( 
	Sef
		provjeri: ['abc'] 
		potpis: long 
		ključem: long
), novi-red.

Izlaz piši: (
	Sef sažetak-lozinke: long provjeri: long
), novi-red.
