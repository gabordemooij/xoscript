

Popis na: ['fixture:'] učini: { :f
	svoj učvršćenje := f.
}.

Popis na: ['broj-elemenata'] učini: { <- svoj učvršćenje.
}.

Popis na: ['aantal'] učini: { <- svoj učvršćenje.
}.


>> x := Ništa.
{

	x := ['hello'] 
	zamijeni:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] znak: 2)
			)
		)
	s: (
		(['...hal'] + ['lo']) 
			velika-slova 
			lowecase 
			velika-slova 
			pomak: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Popis ← 0 ; 1 ; 4; 9 ; (Popis ← 0 ; 3; 1) ; 4
							) predzadnji
						) ? 1
					) + 
					((Popis ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					broj-elemenata
				)
			)
	).

} × 10.
Izlaz piši: x, novi-red.

