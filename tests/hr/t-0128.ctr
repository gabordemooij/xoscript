
Popis na: ['sum'] učini: {
	>> total := 0.
	sebe svaki: { :index :element
		total dodaj: element.
	}. <- total.
}.

>> a := Popis ← 9 ; 8 ; 7.
Izlaz piši: (a sum), novi-red. 
>> a := Popis ← 1 ; 9.
Izlaz piši: (a sum), novi-red. 
>> a := Popis ← ['o'] ; 2.
Izlaz piši: (a sum), novi-red. 
Izlaz piši: (Popis novi sum), novi-red. 
