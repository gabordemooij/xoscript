
Popis na: ['zbroj'] učini: {
	>> ukupno := 0.
	sebe svaki: { :indeks :element
		ukupno dodaj: element.
	}. <- ukupno.
}.

>> a := Popis ← 9 ; 8 ; 7.
Izlaz piši: (a zbroj), novi-red. 
>> a := Popis ← 1 ; 9.
Izlaz piši: (a zbroj), novi-red. 
>> a := Popis ← ['o'] ; 2.
Izlaz piši: (a zbroj), novi-red. 
Izlaz piši: (Popis novi zbroj), novi-red. 
