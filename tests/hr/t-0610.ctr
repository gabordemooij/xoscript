
>> Rectangle := Objekt novi.

Rectangle na: ['area'] učini: { <- svoj duljina * svoj width.
}.

Rectangle na: ['length:'] učini: { :duljina
	svoj duljina := duljina.
}.

Rectangle na: ['width:'] učini: { :width
	svoj width := width.
}.

Rectangle na: ['novi'] učini: {
	# this will not result into an infinite loop
	>> rectangle := sebe novi.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle novi.
Izlaz piši: a area, novi-red. #0

>> b := Rectangle novi length: 2, width: 3.
Izlaz piši: b area, novi-red. #6

