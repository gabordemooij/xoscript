
>> Pravokutnik := Objekt novi.

Pravokutnik na: ['površina'] učini: {
	<- svoj duljina * svoj širina.
}.

Pravokutnik na: ['length:'] učini: { :duljina
	svoj duljina := duljina.
}.

Pravokutnik na: ['width:'] učini: { :širina
	svoj širina := širina.
}.

Pravokutnik na: ['novi'] učini: {
	# ovo neće dovesti do beskonačne petlje
	>> pravokutnik := sebe novi.
	pravokutnik length: 0, width: 0.
	<- pravokutnik.
}.

>> a := Pravokutnik novi.
Izlaz piši: a površina, novi-red. #0

>> b := Pravokutnik novi length: 2, width: 3.
Izlaz piši: b površina, novi-red. #6

