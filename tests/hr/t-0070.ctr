>> brojevi := ['1,2,3'] podijeli: [','].
Izlaz piši: ['Dobio sam: '] + brojevi broj-elemenata + [' brojeva.'],novi-red.
{ :i Izlaz piši: ['number #'] + i + [':'] + (brojevi položaj: i), novi-red.} × 3.
>> pića := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
pića := pića podijeli: [' Or '].
Izlaz piši: ['Poslužujemo'], novi-red.
{ :i Izlaz piši: ['->'] + (pića položaj: i), novi-red. } × (pića broj-elemenata).
Izlaz piši: (pića spoji: [',']), novi-red.
Izlaz piši: (brojevi spoji: ['||']).
