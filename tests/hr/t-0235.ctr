>> Slurp := Objekt novi.
Slurp na: ['novi'] učini: {
	svoj str := [''].
}.

Slurp na: ['odgovori:'] učini: { :blah
		(svoj str ≠ ['']) istina: {
			svoj str dodaj-na-kraj: [' '].
		}.
		svoj str dodaj-na-kraj: blah.
}.
Slurp na: ['odgovori:i:'] učini: { :blah :blahah
		(svoj str ≠ ['']) istina: {
			svoj str dodaj-na-kraj: [' '].
		}.
		(blah duljina > 1) istina: {
			svoj str dodaj-na-kraj: (blah od: 0 duljina: (blah duljina - 1)).
		}, inače: {
			svoj str dodaj-na-kraj: blah.
		}.
		svoj str dodaj-na-kraj: [' '].
		svoj str dodaj-na-kraj: blahah.
}.
Slurp na: ['obtain'] učini: {
	>> buffer := svoj str.
	svoj str := ['']. <- buffer.
}.

>> s := Slurp novi.
s hello: ['world'].
Izlaz piši: ( s obtain ), novi-red.
