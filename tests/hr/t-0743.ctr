>> V := Objekt.
V na: ['tekst'] učini: {
	Izlaz piši: ['pretvorba'], novi-red.
	<- ['abc'].
}.

Izlaz piši: ( Program postavka: ['abc'] ), novi-red.

# params ne bi smjeli biti gc'ed
Program postavka: ([''] + V novi) vrijednost: ([''] + V novi).

Izlaz piši: ( Program postavka: ['abc'] ), novi-red.
