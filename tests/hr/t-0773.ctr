Izlaz piši: ['Test object'], novi-red.
>> a := Objekt novi. 
a na: ['item:'] učini: { :int64
	svoj int64 := int64. 
}.
a na: ['item'] učini: { <- svoj int64.
}.
a item: ( Int64 iz-teksta: ['9999'] ).
Izlaz piši: a item, novi-red.
>> old-int64-address := a item prototip memorijska-adresa.
a save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== RELOADING SNAP:'], novi-red.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b item prototip memorijska-adresa = old-int64-address) istina: {
	Izlaz piši: ['Object link re-attached.'], novi-red.
}.
Izlaz piši: ( b item ), novi-red.
