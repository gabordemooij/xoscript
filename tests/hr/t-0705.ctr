

>> obj := Objekt novi.

obj na: ['pozdravi'] učini: {
	<- ['bok'].
}.

# mora ispisati hi123hi123ok
obj na: ['zadatak'] učini: {
	svoj svojstvo := 123.
	{
		# try veže self/own na objekt umjesto na blok
		Izlaz piši: sebe pozdravi.
		Izlaz piši: svoj svojstvo.
		1 / 0.
	} uhvati: {
		Izlaz piši: sebe pozdravi.
		Izlaz piši: svoj svojstvo.
		Izlaz piši: ['ok'].
	}, pokušaj.
}.

obj zadatak.