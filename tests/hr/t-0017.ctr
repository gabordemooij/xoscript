Broj na: ['factorial'] učini: {
	>> total := 1.
	{ :index total pomnoži-s: (sebe - (index)). } × sebe. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Izlaz piši: a.
>> b := 2 + 3 factorial.
Izlaz piši: b.
>> c := 3 factorial + 2.
Izlaz piši: c.
>> d := 2 + (3 factorial).
Izlaz piši: d.
Izlaz piši: 2 + 3 factorial + 1.
