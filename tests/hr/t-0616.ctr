Popis na: ['kopiraj'] učini: {
	>> kopiraj := Popis novi.
	sebe svaki: { :broj :odjeljak
		kopiraj dodaj-na-kraj: odjeljak rekurzivan kopiraj.
	}.
	<- kopiraj.
}.

>> ovca := Popis novi ; ['Dolly'] ; ['Shaun']. 
>> klonovi := ovca kopiraj.
klonovi svaki: { :broj :ovca
	ovca dodaj-na-kraj: ['2'].
}.

Izlaz piši: ovca, novi-red.
Izlaz piši: klonovi, novi-red.
