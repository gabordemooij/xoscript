>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objekt novi.
⚄ na: ['drawFrom:length:'] učini: { :pool :broj-elemenata
	
	>> result := [''].
	
	{
		>> index := Broj random % (pool duljina).
		result dodaj-na-kraj: ( pool znak: (index + 1) ).
		
	} × broj-elemenata. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? duljina.
Izlaz piši: (['x↵'] x random duljina).
Izlaz piši: (['y↵'] y ?? duljina).

