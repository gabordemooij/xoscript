>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objekt novi.
⚄ na: ['izvuciIz:duljina:'] učini: { :skup :broj-elemenata
	
	>> rezultat := [''].
	
	{
		>> indeks := Broj nasumičan % (skup duljina).
		rezultat dodaj-na-kraj: ( skup znak: (indeks + 1) ).
		
	} × broj-elemenata. <- rezultat.
}.

>> nasumičan := ⚄ izvuciIz: ?? duljina: ?? duljina.
Izlaz piši: (['x↵'] x nasumičan duljina).
Izlaz piši: (['y↵'] y ?? duljina).

