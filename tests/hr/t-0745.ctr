Izlaz piši: ['Test object'], novi-red.
>> a := Objekt novi. 

a na: ['item:'] učini: { :dict
	svoj dict := dict. 
}.

a na: ['item'] učini: { <- svoj dict.
}.

a item: (
Rječnik novi
	hello: ['world']).

>> old-dict-address := a item prototip memorijska-adresa.
a save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== RELOADING SNAP:'], novi-red.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototip memorijska-adresa = old-dict-address) istina: {
	Izlaz piši: ['Object link re-attached.'], novi-red.
}.

Izlaz piši: b item, novi-red.
