Tekst na: ['html'] učini: { <- (
		sebe
		zamijeni: ['&'] s: ['&amp;'],
		zamijeni: ['<'] s: ['&lt;'],
		zamijeni: ['>'] s: ['&gt;'],
		zamijeni: ['''] s: ['&apos;'],
		zamijeni: ['"'] s: ['&quot;']
	).
}.

