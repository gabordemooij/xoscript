# test parsiranja url-a

Server init.
>> url := URL iz: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Izlaz piši: ['shema = '] + url shema, novi-red.
Izlaz piši: ['domaćin = '] + url domaćin, novi-red.
Izlaz piši: ['priključak = '] + url port, novi-red.
Izlaz piši: ['putanja = '] + url putanja, novi-red.
Izlaz piši: ['upit = '] + url parametri-pretrage, novi-red.
Izlaz piši: ['fragment = '] + url fragment, novi-red.
