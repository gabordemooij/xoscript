Izlaz piši: ['Testni objekt'], novi-red.
>> l := Popis novi ; 1 ; ( Popis novi ; (Trenutak novi: 1) ; (Int64 iz-teksta: ['321']) ; (Popis novi ; 3)).
Izlaz piši: l, novi-red.
>> stara-pps-adresa := l prototip memorijska-adresa.
l save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== PONOVNO UČITAVANJE SNIMKE:'], novi-red.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b prototip memorijska-adresa = stara-pps-adresa) istina: {
	Izlaz piši: ['Veza objekta ponovno pridružena.'], novi-red.
}.
Izlaz piši: b, novi-red.
