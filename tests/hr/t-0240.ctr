# test odrednica

>> $ := Objekt novi.

$ na: ['odgovori:'] učini: { :x
	
	>> operacija := x znak: 0.
	>> valuta := x znak: 1.
	>> novac := x pomak: 2.
	
	>> iznos := 0.

	( operacija = ['+'] ) istina: {
		( valuta = ['£'] ) istina: { iznos := 1.28 × novac. }.
	}. <- iznos.
}.



>> x := $ +£20.

Izlaz piši: x, novi-red.


>> Voće := Objekt novi.

Voće na: ['novi'] učini: {
	>> f := sebe novi.
	f apples: 0.
	f oranges: 0. <- f.
}.

Voće na: ['apples:'] učini: { :a svoj jabuke := a. }.
Voće na: ['oranges:'] učini: { :p svoj naranče := p. }.
Voće na: ['jabuke'] učini: { <- svoj jabuke. }.
Voće na: ['naranče'] učini: { <- svoj naranče. }.

Voće na: ['+'] učini: { :f
	
	>> n := Voće novi.
	f dodaj: 1.
	
	n apples: (f jabuke + svoj jabuke).
	n oranges:  (f naranče  + svoj naranče). <- n.
}.

Voće na: ['tekst'] učini: { <- ( svoj jabuke tekst + [' jabuka i '] + svoj naranče + [' naranči'] ).
}.

Broj na: ['jabuke'] učini: { <- ((Voće novi) apples: sebe).
}.

Broj na: ['apple'] učini: { <- ((Voće novi) apples: sebe).
}.

Broj na: ['naranče'] učini: { <- ((Voće novi) oranges: sebe).
}.




Izlaz piši: (1 apple + 3 naranče + 4 jabuke), novi-red.


Tekst na: ['dvaput'] učini: { <- ((sebe tekst) + (sebe tekst)).
}.



Izlaz piši: ['❤❤❤'] dvaput.



