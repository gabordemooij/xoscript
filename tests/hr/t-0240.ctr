# test qualifiers

>> $ := Objekt novi.

$ na: ['odgovori:'] učini: { :x
	
	>> operation := x znak: 0.
	>> valuta := x znak: 1.
	>> money := x pomak: 2.
	
	>> amount := 0.

	( operation = ['+'] ) istina: {
		( valuta = ['£'] ) istina: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Izlaz piši: x, novi-red.


>> Fruit := Objekt novi.

Fruit na: ['novi'] učini: {
	>> f := sebe novi.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit na: ['apples:'] učini: { :a svoj apples := a. }.
Fruit na: ['oranges:'] učini: { :p svoj oranges := p. }.
Fruit na: ['apples'] učini: { <- svoj apples. }.
Fruit na: ['oranges'] učini: { <- svoj oranges. }.

Fruit na: ['+'] učini: { :f
	
	>> n := Fruit novi.
	f dodaj: 1.
	
	n apples: (f apples + svoj apples).
	n oranges:  (f oranges  + svoj oranges). <- n.
}.

Fruit na: ['tekst'] učini: { <- ( svoj apples tekst + [' apples and '] + svoj oranges + [' oranges'] ).
}.

Broj na: ['apples'] učini: { <- ((Fruit novi) apples: sebe).
}.

Broj na: ['apple'] učini: { <- ((Fruit novi) apples: sebe).
}.

Broj na: ['oranges'] učini: { <- ((Fruit novi) oranges: sebe).
}.




Izlaz piši: (1 apple + 3 oranges + 4 apples), novi-red.


Tekst na: ['twice'] učini: { <- ((sebe tekst) + (sebe tekst)).
}.



Izlaz piši: ['❤❤❤'] twice.



