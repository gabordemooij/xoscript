

Tekst na: ['izračunaj'] učini: {
	>> kod := Datoteka novi: ['/tmp/eval.ctr'].
	kod piši: sebe tekst + ['.'].
	Program koristi: ['/tmp/eval.ctr'].
}.

>> a := (Popis ← (
	(Rječnik novi)
		stavi: ['domena'] na: ['mywebsite.com'],
		stavi: (Popis ←
			((Rječnik novi)
				stavi: ['početna'] na: ['title'],
				stavi: ['<html></html>'] na: ['body'],
				stavi: ['2017-01-01'] na: ['stvoreno']
			) ;
			((Rječnik novi)
				stavi: ['onama(c)'] na: ['title'],
				stavi: ['<credits>Autor d.o.o.</credits>'] na: ['body']
			)
		) na: ['stranice']
	)
) tekst.

Izlaz piši: a tip, novi-red.
Izlaz piši: a, novi-red.

>> b := Ništa.
(['b := '] + a) izračunaj.
Izlaz piši: b ? 0 ? ['stranice'] ? 1 ? ['body'], novi-red.

>> c := b ? 0.
>> d := c tekst.
Izlaz piši: d tip, novi-red.

>> e := Ništa.
(['e := '] + d) izračunaj.
Izlaz piši: e ? ['stranice'] ? 0, novi-red.
