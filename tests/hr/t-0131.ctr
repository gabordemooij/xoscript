>> jelovnik := Rječnik novi.
jelovnik stavi: (Popis ← ['pizza'] ; ['špageti']) na: ['Talijanska kuhinja'].
jelovnik stavi: (Popis ← ['bifteki'] ; ['suflaki']) na: ['Grčka kuhinja'].
