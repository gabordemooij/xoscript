Program upravljanje-memorijom: 0.

>> txt := ['Word Salad'].
Izlaz piši: ['zadnji indeks od ječ = '] + (( txt posljednji: ['ord'] ) - 0), novi-red.
Izlaz piši: ['indeks od ječ = '] + (( txt pronađi: ['ord'] ) - 0), novi-red.
Izlaz piši: ['indeks od ta = '] + (( txt pronađi: ['ad'] ) - 0), novi-red.
Izlaz piši: ['zadnji indeks od R = '] + (( txt posljednji: ['W'] ) - 0), novi-red.
Izlaz piši: ['zadnji indeks od i = '] + (( txt posljednji: ['d'] ) - 0), novi-red.
Izlaz piši: ['txt jednako Salata Riječi = '] + ( txt = ['Word Salad'] ), novi-red.
Izlaz piši: ['txt jednako Salata Cezar = '] + ( txt = ['Salata Cezar'] ), novi-red.
Izlaz piši: ['txt nije jednako Salata Riječi = '] + ( txt ≠ ['Word Salad'] ), novi-red.
Izlaz piši: ['txt nije jednako Salata Cezar = '] + ( txt ≠ ['Salata Cezar'] ), novi-red.

