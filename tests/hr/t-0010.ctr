>> Animal := Objekt novi.
Animal na: ['make'] učini: {
	>> animal := Objekt novi.
	animal na: ['makeSound'] učini: {
		Izlaz piši: svoj sound.
	}. <- animal.
}.
>> Cat := Objekt novi.
Cat na: ['make'] učini: {
	>> cat := Animal make.
	cat na: ['init'] učini: {
		svoj sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
