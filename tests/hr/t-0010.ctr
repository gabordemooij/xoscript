>> Životinja := Objekt novi.
Životinja na: ['napravi'] učini: {
	>> životinja := Objekt novi.
	životinja na: ['proizvediZvuk'] učini: {
		Izlaz piši: svoj zvuk.
	}. <- životinja.
}.
>> Mačka := Objekt novi.
Mačka na: ['napravi'] učini: {
	>> mačka := Životinja napravi.
	mačka na: ['init'] učini: {
		svoj zvuk := ['meow!'].
	}.
	mačka init. <- mačka.
}.
>> tom := Mačka napravi.
tom proizvediZvuk.
