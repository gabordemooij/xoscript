>> x := Objekt novi.
>> y := Objekt novi.
>> z := x.
Izlaz piši: (x = z), novi-red.
Izlaz piši: (x = y), novi-red.
Izlaz piši: (x ≠ y), novi-red.
Izlaz piši: (x ≠ z), novi-red.
>> m := Trenutak novi godina: 2070, mjesec: 11.
>> n := m kopiraj.
Izlaz piši: (m = n), novi-red.
Izlaz piši: (m ≠ n), novi-red.
Izlaz piši: (m jednako: m), novi-red.
Izlaz piši: (m jednako: n), novi-red.
n mjesec: 12.
Izlaz piši: (m ≠ n), novi-red.
Izlaz piši: (m = n), novi-red.


