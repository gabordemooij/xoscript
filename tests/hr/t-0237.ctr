
Tekst na: ['evaluate'] učini: {
	>> kod := Datoteka novi: ['/tmp/eval.ctr'].
	kod piši: (sebe tekst + ['.']).
	Program koristi: ['/tmp/eval.ctr'].
}.

>> map :=
	(Rječnik novi)
	stavi: ['Hi There'] na: ['two'],
	stavi: (Popis ← ['hello'] ; ['world'] ; (Popis ← 1 ; 2; 9) ; Laž) na: ['one'],
	stavi: ( (Rječnik novi) stavi: ['wrrld'] na: ['misspelled'] ) na: ['three'],
	stavi: (Popis ← ((Rječnik novi) stavi: ['treasure'] na: ['hidden']) ; 2) na: ['four']. 
>> str := map tekst.
>> map2 := Ništa.
(['map2 := '] + str ) evaluate.
Izlaz piši: map2 ? ['one'] ? 0.
Izlaz piši: map2 ? ['one'] ? 1.
Izlaz piši: map2 ? ['four'] ? 0 ? ['hidden'].
Izlaz piši: map2 ? ['one'] ? 2 ? 2.
