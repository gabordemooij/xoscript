
Tekst na: ['izračunaj'] učini: {
	>> kod := Datoteka novi: ['/tmp/eval.ctr'].
	kod piši: (sebe tekst + ['.']).
	Program koristi: ['/tmp/eval.ctr'].
}.

>> map :=
	(Rječnik novi)
	stavi: ['Bok Svima'] na: ['two'],
	stavi: (Popis ← ['hello'] ; ['world'] ; (Popis ← 1 ; 2; 9) ; Laž) na: ['jedan'],
	stavi: ( (Rječnik novi) stavi: ['svjiet'] na: ['pogrešno napisano'] ) na: ['three'],
	stavi: (Popis ← ((Rječnik novi) stavi: ['blago'] na: ['skriveno']) ; 2) na: ['četiri']. 
>> str := map tekst.
>> map2 := Ništa.
(['map2 := '] + str ) izračunaj.
Izlaz piši: map2 ? ['jedan'] ? 0.
Izlaz piši: map2 ? ['jedan'] ? 1.
Izlaz piši: map2 ? ['četiri'] ? 0 ? ['skriveno'].
Izlaz piši: map2 ? ['jedan'] ? 2 ? 2.
