# Ovaj test provjerava da string_fill_in ne gubi svoj utor (gc'ed) u načinu 4
# referenca u world.c
>> Dnevnik := Objekt novi.

Dnevnik na: ['say:'] učini: { :str
	Izlaz piši: str, novi-red.
}.

>> Stavka := Objekt novi.

Stavka na: ['novi:'] učini: { :id
	<- sebe novi id: id.
}.

Stavka na: ['id:'] učini: { :id
	svoj id := id.
}.

Stavka na: ['id'] učini: { <- svoj id. }.


Stavka na: ['tekst'] učini: {
	>> str := ['Item#~no'].
	str ~no: svoj id.
	<- str.
}.


>> Print := Objekt novi.

Print na: ['items'] učini: { 
	
	svoj stavka := Stavka novi: 1.
	
	# ovdje ili segfault ili pogrešan niz
	Dnevnik say: (
		['~item printed.'] ~item: svoj stavka
	).
	
	
}.

Print items.