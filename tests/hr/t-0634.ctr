# Program shell-escape proizvodi kanonsku posix shell sintaksu
# kompatibilno s: bash/dash, zsh, ksh

>> c := Program shell-escape: ['abc'].
Izlaz piši: c, novi-red.
Izlaz piši: ( Program sustav: ['echo '] + c ), novi-red.

c := Program shell-escape: ['a'b'c'].
Izlaz piši: c, novi-red.
Izlaz piši: ( Program sustav: ['echo '] + c ), novi-red.

c := Program shell-escape: ['a\'c'].
Izlaz piši: c, novi-red.
Izlaz piši: ( Program sustav: ['echo '] + c ), novi-red.