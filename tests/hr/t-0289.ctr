#Linux
>> OS := Program sustav: (Naredba uname -s), skrati.

>> Srkač := Objekt novi.
Srkač na: ['novi'] učini: {
	svoj str := [''].
}.
Srkač na: ['odgovori:'] učini: { :blah
		(svoj str ≠ ['']) istina: {
			svoj str dodaj-na-kraj: [' '].
		}.
		svoj str dodaj-na-kraj: blah.
}.
Srkač na: ['odgovori:i:'] učini: { :blah :blahah
		(svoj str ≠ ['']) istina: {
			svoj str dodaj-na-kraj: [' '].
		}.
		(blah duljina > 1) istina: {
			svoj str dodaj-na-kraj: (blah od: 0 duljina: (blah duljina - 1)).
		}, inače: {
			svoj str dodaj-na-kraj: blah.
		}.
		svoj str dodaj-na-kraj: [' '].
		svoj str dodaj-na-kraj: blahah.
}.
Srkač na: ['dobavi'] učini: {
	>> međuspremnik := svoj str.
	svoj str := ['']. <- međuspremnik.
}.
>> large text := [''].
{
	large text dodaj-na-kraj: ['hello'].
} × 1000.


Izlaz piši: (
	Program sustav: (
		Srkač novi
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) dobavi
).

