>> ponavljač := Objekt novi.
ponavljač na: ['odgovori:'] učini: { :što
	Izlaz piši: što + [' '].
}.
ponavljač na: ['odgovori:i:'] učini: { :što :say
	Izlaz piši: što, piši: say + [' '].
}.
ponavljač na: ['odgovori:i:i:'] učini: { :što :say :više
	Izlaz piši: što, piši: say, piši: više.
}.
ponavljač ponovi.
ponavljač everything: ['Ja kažem.'].
ponavljač and: ['I '] everything: ['radim.'].
