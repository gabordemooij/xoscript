>> z := Objekt novi.
z na: ['value:'] učini: { :v
	svoj value := v. <- sebe.
}.
z na: ['value'] učini: { <- svoj value. }.
(z setValue: 1) value: 2.
Izlaz piši: z value.
>> x := z.
Izlaz piši: x value.
z := Ništa.
Izlaz piši: z value.
Izlaz piši: x value.
Izlaz piši: ['hello'].
Izlaz piši: 3 + 2.
Izlaz piši: (3 > 2).
