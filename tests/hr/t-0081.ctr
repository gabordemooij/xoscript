>> map1 := Rječnik novi.
>> key1 := Popis novi.
>> key2 := Popis novi.

map1
	stavi: ['hello'] na: key1,
	stavi: ['world'] na: key2.


Izlaz
	piši: ['Map #1 contains: '] + (map1 na: key1),
	piši: [' and '] + (map1 na: key2), novi-red.

>> KeyeableArray := Popis novi.
KeyeableArray na: ['toString'] učini: { <- (sebe broj-elemenata) toString.
}.

>> map2 := Rječnik novi.
key1 := KeyeableArray novi.
key2 := KeyeableArray novi.

key1 dodaj-na-kraj: 1.

map2
	stavi: ['hello'] na: key1,
	stavi: ['world'] na: key2.

Izlaz
	piši: ['Map #2 contains: '] + (map2 na: key1),
	piši: [' and '] + (map2 na: key2), novi-red.
