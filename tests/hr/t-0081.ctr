>> mapa1 := Rječnik novi.
>> ključ1 := Popis novi.
>> ključ2 := Popis novi.

mapa1
	stavi: ['hello'] na: ključ1,
	stavi: ['world'] na: ključ2.


Izlaz
	piši: ['Map #1 contains: '] + (mapa1 na: ključ1),
	piši: [' i '] + (mapa1 na: ključ2), novi-red.

>> KljučniNiz := Popis novi.
KljučniNiz na: ['uTekst'] učini: { <- (sebe broj-elemenata) uTekst.
}.

>> map2 := Rječnik novi.
ključ1 := KljučniNiz novi.
ključ2 := KljučniNiz novi.

ključ1 dodaj-na-kraj: 1.

map2
	stavi: ['hello'] na: ključ1,
	stavi: ['world'] na: ključ2.

Izlaz
	piši: ['Map #2 contains: '] + (map2 na: ključ1),
	piši: [' i '] + (map2 na: ključ2), novi-red.
