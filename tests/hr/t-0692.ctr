Server init.

Izlaz piši: (
	Uzorak novi: ['^\\w+$'],
	podudaranje: ['test@example.com'] 
), novi-red. # 0 podudaranja, ne uspijeva na @ i .

Izlaz piši: (
	Uzorak novi: ['^[^@]+@[^\.]+\.\\w+$'],
	podudaranje: ['test@example.com'] 
), novi-red. # 1 podudaranje

Izlaz piši: (
	Uzorak novi: ['[^@]+@[^\.]+\.\\w+'],
	podudaranje: ['test@example.com'] 
), novi-red. # 1 podudaranje

Izlaz piši: (
	Uzorak novi: ['([^@]+)@([^\.]+)\.\\w+'],
	podudaranje: ['test@example.com'] 
), novi-red. # 1 podudaranje, grupe nisu bitne

Izlaz piši: (
	Uzorak novi: ['[a-z]'],
	podudaranje: ['test@example.com'] 
), novi-red. # 14 podudaranja

Izlaz piši: (
	Uzorak novi: ['.*'],
	podudaranje: ['test@example.com'] 
), novi-red. # 1 podudaranje (sve)

Izlaz piši: (
	Uzorak novi: ['(.*)'],
	podudaranje: ['test@example.com'] 
), novi-red. # 1 podudaranje (sve)

Izlaz piši: (
	Uzorak novi: ['\\s*[^@]+@[^\.]+\.\\w+'],
	podudaranje: ['test@example.com'] 
), novi-red. # 1 podudaranje, razmak ispred neobavezan, zanemaruje se