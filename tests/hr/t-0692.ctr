Server init.

Izlaz piši: (
	Uzorak novi: ['^\\w+$'],
	podudaranje: ['test@example.com'] 
), novi-red. # 0 match, fails on @ and .

Izlaz piši: (
	Uzorak novi: ['^[^@]+@[^\.]+\.\\w+$'],
	podudaranje: ['test@example.com'] 
), novi-red. # 1 match

Izlaz piši: (
	Uzorak novi: ['[^@]+@[^\.]+\.\\w+'],
	podudaranje: ['test@example.com'] 
), novi-red. # 1 match

Izlaz piši: (
	Uzorak novi: ['([^@]+)@([^\.]+)\.\\w+'],
	podudaranje: ['test@example.com'] 
), novi-red. # 1 match, groups dont matter

Izlaz piši: (
	Uzorak novi: ['[a-z]'],
	podudaranje: ['test@example.com'] 
), novi-red. # 14 matches

Izlaz piši: (
	Uzorak novi: ['.*'],
	podudaranje: ['test@example.com'] 
), novi-red. # 1 match (all)

Izlaz piši: (
	Uzorak novi: ['(.*)'],
	podudaranje: ['test@example.com'] 
), novi-red. # 1 match (all)

Izlaz piši: (
	Uzorak novi: ['\\s*[^@]+@[^\.]+\.\\w+'],
	podudaranje: ['test@example.com'] 
), novi-red. # 1 match, prefix space optional, gets ignored