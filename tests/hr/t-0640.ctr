
Server init.
Izlaz piši: ['Test baze podataka'], novi-red.

>> bp := Maria-DB novi domaćin: ['localhost'],
	korisnik: ['xo'], 
	lozinka: ['pass123'],
	naziv-baze: ['xobase'],
	poveži-se.

>> parametri-pretrage :=
bp upit: ['SELECT UNHEX('CAFE') AS blobby'],
dohvati: { :red
	Izlaz piši: ( red blobby od: 0 duljina: 2 ), novi-red.
	red blobby oslobodi.
}.
