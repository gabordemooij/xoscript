
Server init.
Izlaz piši: ['Database test'], novi-red.

>> db := Maria-DB novi domaćin: ['localhost'],
	korisnik: ['xo'], 
	lozinka: ['pass123'],
	naziv-baze: ['xobase'],
	poveži-se.

>> parametri-pretrage :=
db upit: ['SELECT UNHEX('CAFE') AS blobby'],
dohvati: { :row
	Izlaz piši: ( row blobby od: 0 duljina: 2 ), novi-red.
	row blobby oslobodi.
}.
