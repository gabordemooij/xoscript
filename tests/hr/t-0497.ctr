Server init.

# write a test file
>> f := Datoteka novi: ['/tmp/test.gif'].
f piši: ['GIF87a01234567810'].

# serve the file
Server proslijedi: ['test.gif'] prefiks: ['/tmp/'].

Izlaz novi-red.

Izlaz piši: ['Outside container (security):'], novi-red.
{ Server proslijedi: ['../passwd'] prefiks: ['/tmp/']. }
uhvati: { :e Izlaz piši: e, novi-red. },
pokreni.

Izlaz piši: ['Invalid prefix:'], novi-red.
{ Server proslijedi: ['test.gif'] prefiks: ['z:\\']. }
uhvati: { :e Izlaz piši: e, novi-red. },
pokreni.

Izlaz piši: ['Non-existant file:'], novi-red.
{ Server proslijedi: ['xxx.xxx'] prefiks: ['/tmp/']. }
uhvati: { :e Izlaz piši: e, novi-red. },
pokreni.
