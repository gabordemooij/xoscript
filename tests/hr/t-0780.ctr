Server init.

# JSON enkoder podržava samo UTF-8, bez surogatnih parova

>> rječnici := Popis novi ;
	# {"key":"normal"} običan ASCII
	( Rječnik novi stavi: ['normalno'] na: ['key'] ) ;
	# {"key":"hello world"} znak razmaka
	( Rječnik novi stavi: ['hello world'] na: ['key'] ) ;
	# {"key":"quote: \""} dvostruki navodnik
	( Rječnik novi stavi: ['"'] na: ['key'] ) ;
	# {"key":"backslash: \\"} obrnuta kosa crta
	( Rječnik novi stavi: ['backslash: \\'] na: ['key'] ) ;
	# {"key":"slash: /"} kosa crta
	( Rječnik novi stavi: ['kosa crta: /'] na: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( Rječnik novi stavi: ['backspace: \b'] na: ['key'] ) ;
	# {"key":"formfeed: \f"} form-feed escape
	( Rječnik novi stavi: ['formfeed: \f'] na: ['key'] ) ;
	# {"key":"newline: \n"} novi redak
	( Rječnik novi stavi: ['newline: \n'] na: ['key'] ) ;
	( Rječnik novi stavi: ['newline: ↵'] na: ['key'] ) ;
	( Rječnik novi stavi: ['newline: 
	'] na: ['key'] ) ;
	# {"key":"carriage return: \r"} povrat na početak retka
	( Rječnik novi stavi: ['carriage return: \r'] na: ['key'] ) ;
	# {"key":"tab: \t"} tabulator
	( Rječnik novi stavi: ['tab \t'] na: ['key'] ) ;
	( Rječnik novi stavi: ['tab ⇿'] na: ['key'] ) ;
	( Rječnik novi stavi: ['tabulator  '] na: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( Rječnik novi stavi: ['NUL \u0000'] na: ['key'] ) ;
	( Rječnik novi stavi: ['NUL \0'] na: ['key'] ) ;
	# {"key":"control: \u0001"} kontrolni znak 0x01
	( Rječnik novi stavi: ['control: \u0001'] na: ['key'] ) ;
	# {"key":"control: \u001F"} kontrolni znak 0x1F
	( Rječnik novi stavi: ['control: \u001F'] na: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-bajtni znak
	( Rječnik novi stavi: ['unicode: é'] na: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-bajtni znak
	( Rječnik novi stavi: ['unicode: €'] na: ['key'] ) ;
	# {"key":"unicode: 日本語"} više 3-bajtnih UTF-8 znakova
	( Rječnik novi stavi: ['unicode: 日本語'] na: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-bajtni znak
	( Rječnik novi stavi: ['unicode: 😀'] na: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	( Rječnik novi stavi: ['unicode: 🧑‍💻'] na: ['key'] ) ;
	# {"key":"combining: é"} kombinirajući naglasak
	( Rječnik novi stavi: ['combining: e\u0301'] na: ['key'] ) ;
	# {"key":"escaped unicode: é"} Unicode escape BMP
	( Rječnik novi stavi: ['escaped unicode: \u00e9'] na: ['key'] ) ;
	# {"key":"escaped unicode: €"} Unicode escape BMP
	( Rječnik novi stavi: ['escaped unicode: \u20ac'] na: ['key'] ) ;
	# {"key":"escaped unicode: 😀"} UTF-16 surogatni par
	( Rječnik novi stavi: ['escaped unicode: \ud83d\ude00'] na: ['key'] ) ;
	# {"key":""} prazna vrijednost
	( Rječnik novi stavi: [''] na: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} posebni ASCII znakovi
	( Rječnik novi stavi: ['@ < > & = % + ? #'] na: ['key'] ) ;
	# {"key":"single quote: '"} jednostruki navodnik
	( Rječnik novi stavi: ['''] na: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} više JSON escape sekvenci
	( Rječnik novi stavi: ['multiple: \" \\ \n \r \t'] na: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} dulji ASCII tekst
	( Rječnik novi stavi: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] na: ['key'] ) ;
	# {"key":" value"} razmak na početku
	( Rječnik novi stavi: [' vrijednost'] na: ['key'] ) ;
	# {"key":"value "} razmak na kraju
	( Rječnik novi stavi: ['vrijednost '] na: ['key'] ) ;
	# {"key":" \t\n\r "} bjeline
	( Rječnik novi stavi: [' \t\n\r '] na: ['key'] )
	.

rječnici svaki: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (Rječnik novi stavi: d key na: ['key']).
	>> b := JSON jsonify: (Rječnik novi stavi: ['value'] na: d key).
	>> e := JSON objekt: a.
	>> f := JSON objekt: b.
	((e key = d key i: (f ? d key = ['value'])) ili: (e key = ['NUL ?'])) istina: {
		Izlaz piši: ['OK'], novi-red.
	}, inače: {
		Izlaz piši: ['Nije moguće ispravno kodirati/dekodirati: '] + d + j, novi-red.
		Program kraj.
	}.
}.
