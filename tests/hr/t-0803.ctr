Server init.

>> conn1 := Maria-DB novi domaćin: ['localhost'],
	korisnik: ['xo'],
	lozinka: ['pass123'],
	naziv-baze: ['xobase'],
	poveži-se.

>> conn2 := Maria-DB novi domaćin: ['localhost'],
	korisnik: ['xo'],
	lozinka: ['pass123'],
	naziv-baze: ['xobase'],
	poveži-se.
#...
>> del := conn1 upit: ['DELETE FROM book WHERE id > 0'].
{  del izvrši. conn1 potvrdi. } uhvati: { :e conn1 poništi.  }, pokreni.

>> insert := conn1 upit: ['INSERT INTO book (id) VALUES(null)'].
insert izvrši.

>> broj-elemenata := conn1 upit: ['SELECT COUNT(*) AS num FROM book'].
broj-elemenata dohvati: { :row Izlaz piši: row num, novi-red. }.

# does not show up
# insert not committed on connection 1
>> broj-elemenata := conn2 upit: ['SELECT COUNT(*) AS num FROM book'].
broj-elemenata dohvati: { :row Izlaz piši: row num, novi-red. }.
