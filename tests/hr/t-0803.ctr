Server init.

>> veza1 := Maria-DB novi domaćin: ['localhost'],
	korisnik: ['xo'],
	lozinka: ['pass123'],
	naziv-baze: ['xobase'],
	poveži-se.

>> veza2 := Maria-DB novi domaćin: ['localhost'],
	korisnik: ['xo'],
	lozinka: ['pass123'],
	naziv-baze: ['xobase'],
	poveži-se.
#...
>> bris := veza1 upit: ['DELETE FROM book WHERE id > 0'].
{  bris izvrši. veza1 potvrdi. } uhvati: { :e veza1 poništi.  }, pokreni.

>> umetni := veza1 upit: ['INSERT INTO book (id) VALUES(null)'].
umetni izvrši.

>> broj-elemenata := veza1 upit: ['SELECT COUNT(*) AS num FROM book'].
broj-elemenata dohvati: { :red Izlaz piši: red num, novi-red. }.

# ne prikazuje se
# umetanje nije potvrđeno na vezi 1
>> broj-elemenata := veza2 upit: ['SELECT COUNT(*) AS num FROM book'].
broj-elemenata dohvati: { :red Izlaz piši: red num, novi-red. }.
