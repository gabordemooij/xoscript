# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob novi: 8, bytes: (
	Popis novi ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Izlaz piši: ( utf16 dekodiraj: ['utf16le'] ), novi-red.

utf16 oslobodi.
>> utf32 := Blob novi: 13, bytes: (
	Popis novi ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Izlaz piši: ( utf32 dekodiraj: ['utf32be'] ), novi-red.
utf32 oslobodi.