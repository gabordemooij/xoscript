#Linux
>> clock := Trenutak novi.
clock zona: ['UTC-1'].
clock godina: 1981, mjesec: 1, dan: 5,
      sat: 13, minuta: 15, sekunda: 13.

Izlaz piši: clock, novi-red.
clock zona: ['UTC+0'].

Izlaz piši: (
	(clock godina običan) + ['-'] + (clock mjesec) + ['-'] + (clock dan) + [' '] +
	(clock sat) + [':'] + (clock minuta) + [':'] + (clock sekunda) + [' '] +
	['W'] + (clock tjedan) + (clock zona)
), novi-red.


clock zona: ['UTC-1'].
Izlaz piši: (
	(clock godina običan) + ['-'] + (clock mjesec) + ['-'] + (clock dan) + [' '] +
	(clock sat) + [':'] + (clock minuta) + [':'] + (clock sekunda) + [' '] +
	['W'] + (clock tjedan) + (clock zona)
), novi-red.
