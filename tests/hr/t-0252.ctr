#Linux
>> ura := Trenutak novi.
ura zona: ['UTC-1'].
ura godina: 1981, mjesec: 1, dan: 5,
      sat: 13, minuta: 15, sekunda: 13.

Izlaz piši: ura, novi-red.
ura zona: ['UTC+0'].

Izlaz piši: (
	(ura godina običan) + ['-'] + (ura mjesec) + ['-'] + (ura dan) + [' '] +
	(ura sat) + [':'] + (ura minuta) + [':'] + (ura sekunda) + [' '] +
	['W'] + (ura tjedan) + (ura zona)
), novi-red.


ura zona: ['UTC-1'].
Izlaz piši: (
	(ura godina običan) + ['-'] + (ura mjesec) + ['-'] + (ura dan) + [' '] +
	(ura sat) + [':'] + (ura minuta) + [':'] + (ura sekunda) + [' '] +
	['W'] + (ura tjedan) + (ura zona)
), novi-red.
