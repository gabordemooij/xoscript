>> makeAdder := { :x
	>> f := { :y <- (svoj x + y). } postavi: ['x'] vrijednost: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i svoj q stavi: (svoj f primijeni: (svoj q ? i)) na: i. } 
	postavi: ['q'] vrijednost: array,
	postavi: ['f'] vrijednost: func.
	{ :i mapping primijeni: i. } × (array broj-elemenata).
}.

>> a := Popis ← 1; 2; 3.
mapper primijeni: a i: (makeAdder primijeni: 100).
Izlaz piši: (a položaj: 0), novi-red.
Izlaz piši: (a ? 1), novi-red.
Izlaz piši: (a ? 2), novi-red.
