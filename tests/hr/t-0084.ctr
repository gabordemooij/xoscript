>> napraviZbrajalo := { :x
	>> f := { :y <- (svoj x + y). } postavi: ['x'] vrijednost: x. <- f.
}.
>> preslikač := { :polje :fja
	>> pridruživanje := { :i svoj q stavi: (svoj f primijeni: (svoj q ? i)) na: i. } 
	postavi: ['q'] vrijednost: polje,
	postavi: ['f'] vrijednost: fja.
	{ :i pridruživanje primijeni: i. } × (polje broj-elemenata).
}.

>> a := Popis ← 1; 2; 3.
preslikač primijeni: a i: (napraviZbrajalo primijeni: 100).
Izlaz piši: (a položaj: 0), novi-red.
Izlaz piši: (a ? 1), novi-red.
Izlaz piši: (a ? 2), novi-red.
