{
	ovaj-zadatak pogreška: ['Dont fail.'].
	unknown doSomething.
} uhvati: {
	Izlaz piši: ['Caught!'].
}, pokreni.

{
	ovaj-zadatak pogreška: ['Dont fail.'].
	svoj unknown doSomething.
} uhvati: {
	Izlaz piši: ['Caught!'].
}, pokreni.

{
	ovaj-zadatak pogreška: ['Dont fail.'].
	unknown := 122.
} uhvati: {
	Izlaz piši: ['Caught!'].
}, pokreni.


{
	ovaj-zadatak pogreška: ['Dont fail.'].
	Istina prekini.
	Izlaz piši: ['FAIL'].
} uhvati: {
	Izlaz piši: ['Caught!'].
}, pokreni.

{
	{
		ovaj-zadatak pogreška: ['Dont fail.'].
		Istina prekini.
		Izlaz piši: ['FAIL'].
	} uhvati: { :x
		(x = ['Dont fail.']) istina: { ovaj-zadatak pogreška: ['Nested Caught!']. }.
	}, pokreni.
} uhvati: { :e
	Izlaz piši: e.
}, pokreni.
