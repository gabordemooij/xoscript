{
	ovaj-zadatak pogreška: ['Nemoj pasti.'].
	nepoznato učiniNešto.
} uhvati: {
	Izlaz piši: ['Uhvaćeno!'].
}, pokreni.

{
	ovaj-zadatak pogreška: ['Nemoj pasti.'].
	svoj nepoznato učiniNešto.
} uhvati: {
	Izlaz piši: ['Uhvaćeno!'].
}, pokreni.

{
	ovaj-zadatak pogreška: ['Nemoj pasti.'].
	nepoznato := 122.
} uhvati: {
	Izlaz piši: ['Uhvaćeno!'].
}, pokreni.


{
	ovaj-zadatak pogreška: ['Nemoj pasti.'].
	Istina prekini.
	Izlaz piši: ['NEUSPJEH'].
} uhvati: {
	Izlaz piši: ['Uhvaćeno!'].
}, pokreni.

{
	{
		ovaj-zadatak pogreška: ['Nemoj pasti.'].
		Istina prekini.
		Izlaz piši: ['NEUSPJEH'].
	} uhvati: { :x
		(x = ['Nemoj pasti.']) istina: { ovaj-zadatak pogreška: ['Ugniježđeno Uhvaćeno!']. }.
	}, pokreni.
} uhvati: { :e
	Izlaz piši: e.
}, pokreni.
