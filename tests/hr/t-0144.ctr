



>> CoffeeGrounds := Objekt novi.
CoffeeGrounds na: ['extract'] učini: { <- ['coffee']. }.

>> CoffeeMachine := Objekt novi.
CoffeeMachine na: ['init'] učini: {
	svoj coffeegrounds := CoffeeGrounds novi.
}.
CoffeeMachine na: ['novi'] učini: { <- CoffeeMachine `new init.
}.

CoffeeMachine na: ['makeTea'] učini: { <- (svoj tealeaves extract). }.
CoffeeMachine na: ['makeCoffee'] učini: { <- (svoj coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine novi.

Izlaz piši:
	coffeeDream 
	makeCoffee.

Izlaz piši:
	coffeeDream 
	makeTea.
