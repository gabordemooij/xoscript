



>> TalogKave := Objekt novi.
TalogKave na: ['izvuci'] učini: { <- ['coffee']. }.

>> AparatZaKavu := Objekt novi.
AparatZaKavu na: ['init'] učini: {
	svoj talogKave := TalogKave novi.
}.
AparatZaKavu na: ['novi'] učini: { <- AparatZaKavu `new init.
}.

AparatZaKavu na: ['skuhajČaj'] učini: { <- (svoj listićiČaja izvuci). }.
AparatZaKavu na: ['skuhajKavu'] učini: { <- (svoj talogKave izvuci). }.

>> kavaIzSna := AparatZaKavu novi.

Izlaz piši:
	kavaIzSna 
	skuhajKavu.

Izlaz piši:
	kavaIzSna 
	skuhajČaj.
