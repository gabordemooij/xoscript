#Linux

(Datoteka novi: ['/tmp/testje']) postoji laž: {
	Program sustav: ['mkdir /tmp/testje'].	
}.

(Datoteka novi: ['/tmp/testje/file1']) postoji laž: {
	Program sustav: ['touch /tmp/testje/file1'].	
}.

(Datoteka novi: ['/tmp/testje/folder1']) postoji laž: {
	Program sustav: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Datoteka popis: ['/tmp/testje'].

>> q := Popis novi.

l svaki: { :k :v v svaki: { :x :y q dodaj-na-kraj: y. }. }.

>> s := q tekst.

(s sadrži: ['file1']) istina:   { Izlaz piši: ['OK'], novi-red. }.
(s sadrži: ['file2']) istina:   { Izlaz piši: ['XX'], novi-red. }.
(s sadrži: ['folder1']) istina: { Izlaz piši: ['OK'], novi-red. }.
