# test operacija s popisima


>> kolači := Popis ←
	['apple'] ;
	['bobica'] ;
	['čokolada'] ;
	['sir'].


>> kupi := kolači zamijeni: 1 duljina: 2 s: ( Popis ← ['cimet'] ; ['ananas'] ).
Izlaz piši: (kupi spoji: [',']), novi-red.


>> kupi := kolači zamijeni: 1 duljina: 12 s: ( Popis ← ['cimet'] ; ['ananas'] ).
Izlaz piši: (kupi spoji: [',']), novi-red.


>> kupi := kolači zamijeni: 2 duljina: 10 s: ( Popis novi ).
Izlaz piši: (kupi spoji: [',']), novi-red.


>> kupi := kolači zamijeni: 0 duljina: 1 s: ( Popis novi ).
Izlaz piši: (kupi spoji: [',']), novi-red.


>> kupi := kolači zamijeni: ['0'] duljina: ['1'] s: ['x'].
Izlaz piši: (kupi spoji: [',']), novi-red.
