# test list operations


>> cakes := Popis ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes zamijeni: 1 duljina: 2 s: ( Popis ← ['cinnamon'] ; ['pineapple'] ).
Izlaz piši: (buy spoji: [',']), novi-red.


>> buy := cakes zamijeni: 1 duljina: 12 s: ( Popis ← ['cinnamon'] ; ['pineapple'] ).
Izlaz piši: (buy spoji: [',']), novi-red.


>> buy := cakes zamijeni: 2 duljina: 10 s: ( Popis novi ).
Izlaz piši: (buy spoji: [',']), novi-red.


>> buy := cakes zamijeni: 0 duljina: 1 s: ( Popis novi ).
Izlaz piši: (buy spoji: [',']), novi-red.


>> buy := cakes zamijeni: ['0'] duljina: ['1'] s: ['x'].
Izlaz piši: (buy spoji: [',']), novi-red.
