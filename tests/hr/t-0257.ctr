
>> Pozdravljač := Objekt novi.
Pozdravljač na: ['novi'] učini: {
	svoj naziv := ['?'].
}.
Pozdravljač na: ['name:'] učini: { :naziv
	svoj naziv := naziv.
}.
Pozdravljač na: ['pozdravi'] učini: {
	Izlaz piši: (['hello[you]'] [you]: svoj naziv).
}.
>> prijatelj := Pozdravljač novi.
prijatelj name: ['1'].
prijatelj pozdravi.
