# Test ASCII varijanti

# Brojevi

Izlaz piši: (2 !=: 3), novi-red.
Izlaz piši: (2 <=: 2), novi-red.
Izlaz piši: (2 >=: 2), novi-red.

# Tekstovi

Izlaz piši: (['b'] >=: ['a']), novi-red.
Izlaz piši: (['b'] !=: ['a']), novi-red.
Izlaz piši: (['b'] <=: ['c']), novi-red.

# Logičke vrijednosti

Izlaz piši: (Istina !=: Laž), novi-red.

# Objekti

Izlaz piši: (Objekt novi !=: Objekt novi), novi-red.

# ASCII simbol popisa <-:

Izlaz piši: (Popis <<: 1, ; 2 ; 3) broj-elemenata = 3, novi-red.

