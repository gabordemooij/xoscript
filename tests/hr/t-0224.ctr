
>> zemlje := Popis novi
	~ ['Švicarska']
	~ ['Italija']
	~ ['Njemačka'].

>> namirnice := Popis novi
	~ ['Rösti']
	~ ['Špageti']
	~ ['Kiseli kupus'].


>> brojač := 0.
namirnice prema: zemlje, svaki: { :key :value
	brojač dodaj: 1.
}.

Izlaz piši: (['we serve counter dishes'] counter: brojač), novi-red.

>> brojač := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] znakovi sortiraj: { :v
	brojač dodaj: 0.
}.

Izlaz piši: (['we sort counter dishes'] counter: brojač), novi-red.


>> brojač := 0.
{
	{
		brojač dodaj: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Izlaz piši: (['we calculate counter numbers.'] counter: brojač), novi-red.

