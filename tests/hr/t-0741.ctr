Izlaz piši: ['Test object'], novi-red.
>> a := Objekt novi. 

a na: ['item:'] učini: { :octhelper
	svoj octhelper := octhelper. 
}.

a na: ['item'] učini: { <- svoj octhelper.
}.

a item: Oct novi.

>> old-octhelper-address := a item prototip memorijska-adresa.
a save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== RELOADING SNAP:'], novi-red.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototip memorijska-adresa = old-octhelper-address) istina: {
	Izlaz piši: ['Object link re-attached.'], novi-red.
}.
