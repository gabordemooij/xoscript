Izlaz piši: ['Testni objekt'], novi-red.
>> a := Objekt novi. 

a na: ['item:'] učini: { :oktpomoćnik
	svoj oktpomoćnik := oktpomoćnik. 
}.

a na: ['stavka'] učini: {
	<- svoj oktpomoćnik.
}.

a item: Oct novi.

>> stara-oktpomoćnik-adresa := a stavka prototip memorijska-adresa.
a save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== PONOVNO UČITAVANJE SNIMKE:'], novi-red.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b stavka prototip memorijska-adresa = stara-oktpomoćnik-adresa) istina: {
	Izlaz piši: ['Veza objekta ponovno pridružena.'], novi-red.
}.
