>> t := Istina.
(t = Istina) istina: { Izlaz piši: ['T']. }.
(t = Laž) istina: { Izlaz piši: ['F']. }.
Izlaz piši: ['|'].
>> t := Laž.
(t = Istina) istina: { Izlaz piši: ['T']. }.
(t = Laž) istina: { Izlaz piši: ['F']. }.
Izlaz piši: ['|'].
>> f := Istina.
(t = Istina i: f = Laž) istina: { Izlaz piši: ['T']. }.
(t = Laž i: f = Istina) istina: { Izlaz piši: ['F']. }.
Izlaz piši: ['|'].
>> n := Ništa.
(n Ništa?) istina: { Izlaz piši: ['T']. }.
(n Ništa?) laž: { Izlaz piši: ['F']. }.
Izlaz piši: ['|'].
(f Boolean?) istina: { Izlaz piši: ['T']. }.
(f Boolean?) laž: { Izlaz piši: ['F']. }.



