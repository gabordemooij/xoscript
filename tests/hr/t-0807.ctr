# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB novi domaćin: ['localhost'],
	korisnik: ['xo'],
	lozinka: ['pass123'],
	naziv-baze: ['xobase'],
	poveži-se.

>> parametri-pretrage := db upit: ['SELECT %% FROM'].
{ parametri-pretrage izvrši. } uhvati: { :e
	Izlaz piši: ( e sadrži: ['%%'] ), novi-red.
}, pokreni.
