>> Greeter := Objekt novi.
Greeter na: ['make'] učini: {
	>> greeter := Objekt novi.
	greeter na: ['name:'] učini: { :naziv
		Izlaz piši: ['setting a name'].
		svoj myName := naziv.
	}.
	greeter na: ['performGreeting'] učini: {
		Izlaz piši: ['Hello'].
		Izlaz piši: svoj myName.
	}.
	greeter na: ['greet'] učini: {
		sebe performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
