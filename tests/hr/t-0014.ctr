>> Pozdravljač := Objekt novi.
Pozdravljač na: ['napravi'] učini: {
	>> pz := Objekt novi.
	pz na: ['setName:'] učini: { :ime
		svoj naziv := ime.
	}.
	pz na: ['pozdravi'] učini: {
		Izlaz piši: svoj naziv.
	}. <- pz.
}.
>> a := Pozdravljač napravi.
>> b := Pozdravljač napravi.
a setName: ['JEDAN'].
b setName: ['DVA'].
a pozdravi.
b pozdravi.
>> c := a novi.
c setName: ['TRI'].
c pozdravi.
>> d := a novi.
d setName: ['ČETIRI'].
d pozdravi.
c pozdravi.
