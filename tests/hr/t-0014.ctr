>> Greeter := Objekt novi.
Greeter na: ['make'] učini: {
	>> gr := Objekt novi.
	gr na: ['setName:'] učini: { :aname
		svoj naziv := aname.
	}.
	gr na: ['greet'] učini: {
		Izlaz piši: svoj naziv.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a novi.
c setName: ['THREE'].
c greet.
>> d := a novi.
d setName: ['FOUR'].
d greet.
c greet.
