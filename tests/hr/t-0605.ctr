>> invoice := Objekt novi.
invoice na: ['pokreni'] učini: {
        svoj broj := 0.
}.

invoice na: ['broj'] učini: {
        svoj broj dodaj: 1. <- svoj broj kopiraj.
}.

>> year-invoice := invoice novi.
year-invoice na: ['start:'] učini: { :godina
	svoj broj := godina.
}.

year-invoice start: 202000.
Izlaz piši: year-invoice broj, novi-red.
Izlaz piši: year-invoice broj, novi-red.
