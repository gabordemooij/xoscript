>> račun := Objekt novi.
račun na: ['pokreni'] učini: {
        svoj broj := 0.
}.

račun na: ['broj'] učini: {
        svoj broj dodaj: 1.
        <- svoj broj kopiraj.
}.

>> godišnji-račun := račun novi.
godišnji-račun na: ['start:'] učini: { :godina
	svoj broj := godina.
}.

godišnji-račun start: 202000.
Izlaz piši: godišnji-račun broj, novi-red.
Izlaz piši: godišnji-račun broj, novi-red.
