Server init.
>> f := Format novi: ['%d'].
>> a := Blob novi: 4.
a bytes: ( Popis novi ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob novi: 4.
b bytes: ( Popis novi ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a od: 0 duljina: 3, svaki: { :i :byte
	Izlaz piši: ( f primijeni-cijeli: byte ), novi-red.
}.
a ^ b.
a od: 0 duljina: 3, svaki: { :i :byte
	Izlaz piši: ( f primijeni-cijeli: byte ), novi-red.
}.
a ^ b.
a od: 0 duljina: 3, svaki: { :i :byte
	Izlaz piši: ( f primijeni-cijeli: byte ), novi-red.
}.
a oslobodi.
b oslobodi.

{ a ^ Objekt. } uhvati: { :e Izlaz piši: e, novi-red. }, pokreni.
