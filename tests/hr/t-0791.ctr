Server init.

>> BP := Maria-DB novi domaćin: ['localhost'],
	korisnik: ['xo'],
	lozinka: ['pass123'],
	naziv-baze: ['xobase'],
	poveži-se.
	
>> SQL := ['SELECT "hello" AS "world" '].

# ručno izradi upit
>> parametri-pretrage := Maria-Upit novi: SQL.

# postavi bazu podataka
parametri-pretrage baza-podataka: BP.

parametri-pretrage dohvati: { :red
	Izlaz piši: red world, novi-red.
}.
