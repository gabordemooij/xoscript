# catch-all test (practical)
>> HTML := Tekst novi.
HTML na: ['encode:'] učini: { :tekst
	sebe dodaj-na-kraj: (tekst
	zamijeni: ['&'] s: ['&amp;'], 
	zamijeni: ['<'] s: ['&lt;'],
	zamijeni: ['>'] s: ['&gt;'],
	zamijeni: ['"'] s: ['&quot;']).
}.
>> blog := HTML novi.
blog dodaj-na-kraj: ['<h1>'],
     encode: ['Koffie & Thee'],
     dodaj-na-kraj: ['</h1>'].
Izlaz piši: blog, novi-red.


>> Roman := Broj novi.
Roman na: ['stringy'] učini: {
	>> a := [''].
	{ a dodaj-na-kraj: ['I']. } × sebe. <- a.
}.

>> x := Roman novi.
x dodaj: 3.
Izlaz piši: x stringy, novi-red.

>> Quantum := Logički novi.
Quantum na: ['true?'] učini: { <- ['maybe True']. }.
Izlaz piši: (Quantum novi true?), novi-red.

>> Nihil := Ništa novi.
Nihil na: ['tekst'] učini: { <- ['Nihil']. }.
Izlaz piši: (Nihil novi), novi-red.
