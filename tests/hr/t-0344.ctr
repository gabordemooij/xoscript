# catch-all test (praktični)
>> HTML := Tekst novi.
HTML na: ['encode:'] učini: { :izvorniTekst
	sebe dodaj-na-kraj: (izvorniTekst
	zamijeni: ['&'] s: ['&amp;'], 
	zamijeni: ['<'] s: ['&lt;'],
	zamijeni: ['>'] s: ['&gt;'],
	zamijeni: ['"'] s: ['&quot;']).
}.
>> blog := HTML novi.
blog dodaj-na-kraj: ['<h1>'],
     encode: ['Koffie & Thee'],
     dodaj-na-kraj: ['</h1>'].
Izlaz piši: blog, novi-red.


>> Rimski := Broj novi.
Rimski na: ['tekstualno'] učini: {
	>> a := [''].
	{ a dodaj-na-kraj: ['I']. } × sebe. <- a.
}.

>> x := Rimski novi.
x dodaj: 3.
Izlaz piši: x tekstualno, novi-red.

>> Kvant := Logički novi.
Kvant na: ['true?'] učini: { <- ['možda Istina']. }.
Izlaz piši: (Kvant novi true?), novi-red.

>> Nihil := Ništa novi.
Nihil na: ['tekst'] učini: { <- ['Nihil']. }.
Izlaz piši: (Nihil novi), novi-red.
