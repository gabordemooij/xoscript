Program upravljanje-memorijom: 4.

>> ups := 0.
{
	{ 3 ÷ 0. } uhvati: {
		ups dodaj: 1.
	}, pokreni.
} × 1000.

{
	Izlaz piši: ['bok svima!'].
	ovaj-zadatak pogreška: ['oops'].
