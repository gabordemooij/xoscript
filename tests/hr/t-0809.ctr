# backslashes must survive code serialization, strings must not end early
>> vrijednosti := Popis novi
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

vrijednosti svaki: { :i :value
	>> d := Rječnik novi.
	d stavi: value na: ['k'].
	>> r := d kod objekt.
	Izlaz piši: r broj-elemenata, novi-red.
	Izlaz piši: ( (r na: ['k']) = value ), novi-red.
}.
