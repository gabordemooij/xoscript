# navodnik koji se nikad ne zatvara mora dati pogrešku, a ne beskonačnu petlju
>> putanja := ['/tmp/test0821.csv'].
>> file := Datoteka novi: putanja.

file piši: ['a,b\n"1,2\n'].
{
	file razdjelnik: [','] navodnik: ['"'] retci: { :line
		Izlaz piši: line, novi-red.
	}.
} uhvati: { :e Izlaz piši: e, novi-red. }, pokreni.

# zatvoreni navodnik i dalje radi
file piši: ['a,b\n"1,2",3'].
file razdjelnik: [','] navodnik: ['"'] retci: { :line
	Izlaz piši: line, novi-red.
}.
file izbriši.
