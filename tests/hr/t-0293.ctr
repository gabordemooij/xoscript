
>> city := Popis ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Popis ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature prema: city.
>> cities := weather unosi sortiraj: { :a :b <- (a usporedi: b). }.
>> temperatures := weather vrijednosti sortiraj: { :a :b <- (a usporedi: b) negativan?. }.

Izlaz piši: (cities spoji: [',']), novi-red.
Izlaz piši: (temperatures spoji: [',']), novi-red.
