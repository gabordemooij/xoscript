
>> grad := Popis ← ['London'] ; ['Pariz'] ; ['Berlin'].
>> temperatura := Popis ← ['15'] ; ['16'] ; ['15'].
>> prognoza := temperatura prema: grad.
>> gradovi := prognoza unosi sortiraj: { :a :b <- (a usporedi: b). }.
>> temperature := prognoza vrijednosti sortiraj: { :a :b <- (a usporedi: b) negativan?. }.

Izlaz piši: (gradovi spoji: [',']), novi-red.
Izlaz piši: (temperature spoji: [',']), novi-red.
