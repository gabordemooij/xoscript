# format kolačića sesije, json tip sadržaja, samo web protokoli, svg prikazan inline
Server inicijaliziraj.
Program koristi: ['../../../src/xo/hr/webtools.xo'].

>> Lažni-Zahtjev := Objekt novi.
Lažni-Zahtjev na: ['value:'] učini: { :vrijednost
	svoj vrijednost := vrijednost.
}.
Lažni-Zahtjev na: ['cookie:'] učini: { :naziv
	<- svoj vrijednost.
}.

>> Testna-Sesija := Sesija-privremena-datoteka novi.
Testna-Sesija na: ['učitaj'] učini: {
	<- Rječnik novi.
}.
Testna-Sesija na: ['sesija-id'] učini: {
	<- svoj id.
}.

>> kolačići := Popis novi
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

kolačići svaki: { :i :kolačić
	>> zahtjev := Lažni-Zahtjev novi.
	zahtjev value: kolačić.
	>> upravitelj := Testna-Sesija novi.
	>> web := Web-dokument novi.
	web zahtjev: zahtjev.
	web upravitelj-sesija: upravitelj.
	web pokreni-sesiju.
	Izlaz piši: ( upravitelj sesija-id = kolačić ), novi-red.
}.

>> web := Web-dokument novi.
web json: (Rječnik novi stavi: ['b'] na: ['a']).
Izlaz piši: ['\n'], novi-red.

{ Mreža get: ['file:///etc/hostname']. } uhvati: { :e
	Izlaz piši: e, novi-red.
}, pokreni.

>> svg := Datoteka novi: ['/tmp/test0814.svg'].
svg piši: ['<svg xmlns="x"></svg>'].
Izlaz novi-red.
Server proslijedi: ['test0814.svg'] prefiks: ['/tmp/'].
svg izbriši.
