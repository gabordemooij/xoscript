Izlaz piši: ((Popis novi
	na: ['plaque:'] učini: { :x svoj o := x. },
	na: ['plaque']  učini: { <- svoj o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Popis ← 1)
	~ (Popis ← 1 ; 2)
	~ (Popis ← 1 ; 2 ; 3)
	~ (Popis ← 1 ; 2 ; 3 ; 4)
	~ (Popis ← 1 ; 2 ; 3 ; 4 ; 5)
) svaki: { :i :el
	{ Izlaz piši: ovaj-zadatak. } × el broj-elemenata.
	Izlaz novi-red.
}) plaque, novi-red.


