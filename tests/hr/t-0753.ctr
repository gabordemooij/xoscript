Izlaz piši: ['Testni objekt'], novi-red.
>> a := Objekt novi. 

a na: ['item:'] učini: { :fmt
	svoj fmt := fmt. 
}.

a na: ['stavka'] učini: {
	<- svoj fmt.
}.

a item: ( Format novi: ['|%s|'] ).

Izlaz piši: a stavka, novi-red.

>> stara-fmt-adresa := a stavka prototip memorijska-adresa.
a save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== PONOVNO UČITAVANJE SNIMKE:'], novi-red.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b stavka prototip memorijska-adresa = stara-fmt-adresa) istina: {
	Izlaz piši: ['Veza objekta ponovno pridružena.'], novi-red.
}.

Izlaz piši: ( b stavka primijeni: ['hello'] ), novi-red.
