Izlaz piši: ['Test object'], novi-red.
>> a := Objekt novi. 

a na: ['item:'] učini: { :fmt
	svoj fmt := fmt. 
}.

a na: ['item'] učini: { <- svoj fmt.
}.

a item: ( Format novi: ['|%s|'] ).

Izlaz piši: a item, novi-red.

>> old-fmt-address := a item prototip memorijska-adresa.
a save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== RELOADING SNAP:'], novi-red.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototip memorijska-adresa = old-fmt-address) istina: {
	Izlaz piši: ['Object link re-attached.'], novi-red.
}.

Izlaz piši: ( b item primijeni: ['hello'] ), novi-red.
