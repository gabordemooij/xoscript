# grupa koja nije dio podudaranja ne smije srušiti program i mora zadržati brojeve grupa
Server init.
>> prikaži := { :obrazac :subject
	>> p := Uzorak novi: obrazac.
	p podudaranje: subject učini: { :m :g
		Izlaz piši: g broj-elemenata, piši: [' '], piši: (g spoji: ['|']), novi-red.
		<- m.
	}.
}.
prikaži primijeni: ['(a)|(b)'] i: ['b'].
prikaži primijeni: ['(a)|(b)'] i: ['a'].
prikaži primijeni: ['(x)?y'] i: ['y'].
prikaži primijeni: ['(x)?(y)(z)?'] i: ['xy'].
