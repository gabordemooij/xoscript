>> items := Rječnik novi.
items stavi: ['crna'] na: ['coffee'], stavi: ['earl grey'] na: ['čaj'].
Izlaz piši: (items na: ['coffee']), piši: (items na: ['čaj']).
Izlaz piši: ['ima'] + items broj-elemenata + [' stavki u polju.'].
items stavi: ['kapučino'] na: ['coffee'].
Izlaz piši: ['Sad je moja kava.. '] + (items na: ['coffee']).
items stavi: ['aaa'] na: ['1'].
items stavi: ['bbb'] na: ['2'].
Izlaz piši: (items na: ['a']).
