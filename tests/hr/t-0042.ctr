>> items := Rječnik novi.
items stavi: ['black'] na: ['coffee'], stavi: ['earl grey'] na: ['tea'].
Izlaz piši: (items na: ['coffee']), piši: (items na: ['tea']).
Izlaz piši: ['there are'] + items broj-elemenata + [' items in the array.'].
items stavi: ['capuccino'] na: ['coffee'].
Izlaz piši: ['Now my coffee is.. '] + (items na: ['coffee']).
items stavi: ['aaa'] na: ['1'].
items stavi: ['bbb'] na: ['2'].
Izlaz piši: (items na: ['a']).
