#ffi test


Server init.

Program upravljanje-memorijom: 4.

# za ovaj test morate postaviti putanju do libc (puts)
>> nazivBiblioteke := Program postavka: ['FFITESTLIB'].



Server poveži: (
 Popis novi ;
 nazivBiblioteke ;
 ['puts'] ;
 ( Popis novi ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s oslobodi.

# test sa struct

>> a := Blob novi: 8.
a bytes: (
	Popis <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struktura := Blob struct: (Popis <<: ['int'], ; ['int']).

Server poveži: (
	Popis <<: ['@structtest'], ;
	['@structtest'] ;
	(Popis <<: struktura) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Izlaz piši: ['Test zbroja:'] + (ffitest ffisum: a), novi-red.

struktura oslobodi-struct.
struktura oslobodi.
a oslobodi.
