Logički na: ['xor:'] učini: { :a :b <- ((a i: b ne) ili: (a ne i: b)).
}.

>> o := Objekt novi.
o na: ['hello'] učini: { ['Empty']. }.
{ o na: 2 učini: 3.} uhvati: { :e Izlaz piši: e, novi-red. }, pokreni.
{ o na: ['test'] učini: 3.} uhvati: { :e Izlaz piši: e, novi-red. }, pokreni.
{ o na: ['hello'] učini: { ['Empty']. }.} uhvati: { :e Izlaz piši: e, novi-red. }, pokreni. 
{ >> z := 4 ÷ 0. } uhvati: { :e Izlaz piši: e, novi-red. }, pokreni. 
{ (Istina i: Ništa) istina: { Izlaz piši: ['X'].}. } uhvati: { :e Izlaz piši: e, novi-red. }, pokreni. 
{ ([''] xor: 0) istina: { Izlaz piši: ['X'].}. } uhvati: { :e Izlaz piši: e, novi-red. }, pokreni. 
{ (1 < ['2']) istina: { Izlaz piši: ['OK']. }. } uhvati: { :e Izlaz piši: e, novi-red. }, pokreni. 
{ (1 < ['2.0']) istina: { Izlaz piši: ['OK']. }. } uhvati: { :e Izlaz piši: e, novi-red. }, pokreni. 
{ (1 < ['x2.0']) istina: { Izlaz piši: ['NO!']. }. } uhvati: { :e Izlaz piši: e, novi-red. }, pokreni. 
{ Izlaz piši: (['hello OK there'] od: ['6'] duljina: ['2']). } pokreni. 
