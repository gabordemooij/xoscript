# Test utf8 sanitizera
Server init.

>> utf8slučajevi := Rječnik novi
	# Samo ASCII
	stavi: ( Popis novi ; 65 ; 65 ; 65 ; 65 ; 0 ) na: ['AAAA'],
	# valjana sekvenca od 2 bajta
	stavi: ( Popis novi ; 194 ; 162 ; 0 ) na: ['¢'],
	# Valjani 3-bajtni UTF-8
    stavi: ( Popis novi ; 226 ; 130 ; 172 ; 0 ) na: ['€'],
	# Valjani 4-bajtni UTF-8
    stavi: ( Popis novi ; 240 ; 144 ; 141 ; 136 ; 0 ) na: ['𐍈'],
	# Neispravan bajt nastavka u sekvenci E2 28 AC -> početak 3b seq + 28 pogrešan nastavak + AC bajt nastavka, ali pripada istoj pogrešci
    stavi: ( Popis novi ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) na: ['A?A'],
	# Predugo kodiranje ASCII 'A' (treba postati ?),
    stavi: ( Popis novi ; 65 ; 193 ; 129 ; 0 ) na: ['A?'],
	# Neispravan prvi bajt (0xFF)
    stavi: ( Popis novi ; 255 ; 0 ) na: ['?'],
	# Nepotpuna višebajtna sekvenca na kraju
    stavi: ( Popis novi ; 66 ; 226 ; 0 ) na: ['B?'],
    # Prazan tekst
    #put: ( List new ) at: [''],
	# Više mješovitih sekvenci
    stavi: ( Popis novi ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) na: ['A€?𐍈B'].
	 
utf8slučajevi svaki: { :key :value
	>> blob := Blob novi: value broj-elemenata, bytes: value.
	>> str := blob tekst.
	(str = key) istina: {
		Izlaz piši: ['OK'], novi-red.
	}, inače: {
		Izlaz piši: ['UTF8 čistač nije uspio na: '] + key + [' dobiveno: '] + str, novi-red.
	}.
	blob oslobodi.
}.
