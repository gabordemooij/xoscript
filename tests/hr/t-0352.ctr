Broj na: ['roman'] učini: {
	>> broj := sebe kopiraj.
	>> roman := [''].
	{
		{
			(broj ≥ 1000) istina: {
				roman dodaj-na-kraj: ['Ⅿ'].
				broj oduzmi: 1000.
			}, prekini.
		
			(broj ≥ 500) istina: {
				roman dodaj-na-kraj: ['Ⅾ'].
				broj oduzmi: 500.
			}, prekini.
		
			(broj ≥ 100) istina: {
				roman dodaj-na-kraj: ['Ⅽ'].
				broj oduzmi: 100.
			}, prekini.
		
			(broj ≥ 50) istina: {
				roman dodaj-na-kraj: ['Ⅼ'].
				broj oduzmi: 50.
			}, prekini.
		
			(broj ≥ 50) istina: {
				roman dodaj-na-kraj: ['Ⅼ'].
				broj oduzmi: 50.
			}, prekini.
		
			(broj ≥ 10) istina: {
				roman dodaj-na-kraj: ['Ⅹ'].
				broj oduzmi: 10.
			}, prekini.
			
			(broj ≥ 9) istina: {
				roman dodaj-na-kraj: ['Ⅸ'].
				broj oduzmi: 9.
			}, prekini.
			
			(broj ≥ 5) istina: {
				roman dodaj-na-kraj: ['Ⅴ'].
				broj oduzmi: 5.
			}, prekini.
			
			(broj ≥ 4) istina: {
				roman dodaj-na-kraj: ['Ⅳ'].
				broj oduzmi: 4.
			}, prekini.
			
			(broj ≥ 1) istina: {
				roman dodaj-na-kraj: ['Ⅰ'].
				broj oduzmi: 1.
			}, prekini.
		} postupak.
	} dok: { <- broj > 0. }. <- roman.
}.

Izlaz piši: 1 roman, novi-red.
Izlaz piši: 2 roman, novi-red.
Izlaz piši: 4 roman, novi-red.
Izlaz piši: 8 roman, novi-red.
Izlaz piši: 16 roman, novi-red.
Izlaz piši: 32 roman, novi-red.
Izlaz piši: 64 roman, novi-red.
Izlaz piši: 128 roman, novi-red.
Izlaz piši: 256 roman, novi-red.
Izlaz piši: 1024 roman, novi-red.
