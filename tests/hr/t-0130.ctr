# korištenje FFI-ja s dodatkom Server

# poveži se s libc (ovisno o platformi)
>> nazivBiblioteke := Program postavka: ['FFITESTLIB'].

# poveži stdio funkcije iz C-a za napredne operacije s datotekama
Server poveži: ( Popis novi ;
 nazivBiblioteke ; ['fopen'] ;
 ( Popis novi ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
poveži: ( Popis novi ;
 Ništa ; # znači ista biblioteka
 ['fread'] ;
 ( Popis novi ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Ništa ; # znači isti objekt (tj. Stream)
 ['fread']
),
poveži: (
 Popis novi ;
 Ništa ; # znači ista biblioteka
 ['fwrite'] ;
 ( Popis novi ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Ništa ; # znači ista biblioteka
 ['fwrite']
),
poveži: (
 Popis novi ;
 Ništa ; # znači ista biblioteka
 ['rewind'] ;
 ( Popis novi ; ['pointer'] ) ;
 ['int'] ;
 Ništa ; # znači ista biblioteka
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> putanja := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# otvori datoteku s fopen(path, mode)
>> fd := Stream path: putanja mode: mode.

# zapiši bajtove iz međuspremnika niz u datoteku
>> zapisani-bajtovi := Stream poruka: ['fwrite'] argumenti: (Popis novi ; str ; 1 ; 6 ; fd ).
Izlaz piši: zapisani-bajtovi, novi-red.

# vrati pokazivač datoteke na početak
Stream rewind: fd.

# alociraj međuspremnik
>> msp := Blob novi: 20.

# čitaj iz datoteke
>> pročitani-bajtovi := Stream poruka: ['fread'] argumenti: (Popis novi ; msp ; 1 ; 6 ; fd ).
Izlaz piši: pročitani-bajtovi, novi-red.
Izlaz piši: msp, novi-red.

# oslobodi memoriju
str  oslobodi.
putanja oslobodi.
mode oslobodi.
msp  oslobodi.


