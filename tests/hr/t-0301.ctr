


>> wine := Objekt novi.


wine na: ['toString'] učini: { <- ['merlot'].
}.

wine na: ['naarTekst'] učini: { <- ['merlot'].
}.


wine na: ['='] učini: { :other wine <- ( sebe toString = other wine ).
}.

wine na: ['=='] učini: { :other wine <- ( sebe toString = other wine ).
}.



wine
	slučaj: ['cabernet'] učini: { Izlaz piši: ['it's a Cabernet!']. },
	slučaj: ['syrah']    učini: { Izlaz piši: ['it's a Syrah!'].    },
	slučaj: ['merlot']   učini: { Izlaz piši: ['it's a Merlot!'].   },
	slučaj: ['malbec']   učini: { Izlaz piši: ['it's a Malbec!'].   }.

Izlaz novi-red.
