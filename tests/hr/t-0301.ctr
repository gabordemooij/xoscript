


>> vino := Objekt novi.


vino na: ['uTekst'] učini: { <- ['merlot'].
}.

vino na: ['naarTekst'] učini: { <- ['merlot'].
}.


vino na: ['='] učini: { :other wine <- ( sebe uTekst = other wine ).
}.

vino na: ['=='] učini: { :other wine <- ( sebe uTekst = other wine ).
}.



vino
	slučaj: ['cabernet'] učini: { Izlaz piši: ['to je Cabernet!']. },
	slučaj: ['syrah']    učini: { Izlaz piši: ['to je Syrah!'].    },
	slučaj: ['merlot']   učini: { Izlaz piši: ['to je Merlot!'].   },
	slučaj: ['malbec']   učini: { Izlaz piši: ['to je Malbec!'].   }.

Izlaz novi-red.
