
>> pojmovnik := (
	Rječnik novi
		stavi: ['b'] na: ['a'],
		stavi: ['a'] na: ['b'],
		stavi: ['z'] na: ['x'],
		stavi: ['hello'] na: ['halo'],
		stavi: ['human'] na: ['human']
).

>> usporedbe := Popis novi.
pojmovnik svaki: { :a :b
	usporedbe ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a usporedi: b)
	).
}.

usporedbe sortiraj: { :a :b <- ( a usporedi: b ). }.
Izlaz piši: ( usporedbe spoji: ['↵'] ), novi-red.
usporedbe spoji: ['↵'].
