# ključevi i potpisi trezora koji se dekodiraju predugo ne smiju preliti stog
Server init.

>> ključevi := Sef generiraj-ključeve.
>> tk := ključevi prvi.
>> jk := ključevi posljednji.
>> potp := Sef potpiši: ['abc'] ključem: tk.

# 88 znakova bez paddinga dekodira se u 66 bajtova
>> dugo := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 znaka bez paddinga dekodira se u 33 bajta
>> kratko := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Sef potpiši: ['abc'] ključem: dugo. } uhvati: { :e
	Izlaz piši: e, novi-red.
}, pokreni.

{ Sef provjeri: ['abc'] potpis: dugo ključem: jk. } uhvati: { :e
	Izlaz piši: e, novi-red.
}, pokreni.

{ Sef provjeri: ['abc'] potpis: potp ključem: kratko. } uhvati: { :e
	Izlaz piši: e, novi-red.
}, pokreni.
