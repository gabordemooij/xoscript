Server init.

>> x := Blob novi: 65 tip: ['char'].
# for this test you need set a path to libc (puts)
>> libname := Program postavka: ['FFITESTLIB'].
Server poveži: (
 Popis novi ;
 libname ;
 ['putchar'] ;
 ( Popis novi ; ['char'] ) ;
 ['void'] ;
 ['Print'] ;
 ['char:']
).
Print char: (x od: 0 duljina: 1), novi-red.
x oslobodi.

