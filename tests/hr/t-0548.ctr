Server init.

>> x := Blob novi: 65 tip: ['char'].
# za ovaj test morate postaviti putanju do libc (puts)
>> nazivBiblioteke := Program postavka: ['FFITESTLIB'].
Server poveži: (
 Popis novi ;
 nazivBiblioteke ;
 ['putchar'] ;
 ( Popis novi ; ['char'] ) ;
 ['void'] ;
 ['Print'] ;
 ['char:']
).
Print char: (x od: 0 duljina: 1), novi-red.
x oslobodi.

