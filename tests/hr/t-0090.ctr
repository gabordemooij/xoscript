Izlaz piši: ['1,2,3,4,5,6,7,8,9,A,'], novi-red.
>> Doseg := Objekt novi.
Doseg na: ['initialize:'] učini: { :x svoj svojstvo := x. }.
Doseg na: ['odobri'] učini: { Izlaz piši: [',']. }.
Doseg na: ['test'] učini: {
	Izlaz piši: svoj svojstvo.
	sebe odobri.
	( 1 = 1 ) istina: { Izlaz piši: svoj svojstvo. sebe odobri. }.
	( 1 = 0 ) laž: { Izlaz piši: svoj svojstvo. sebe odobri. }.
	>> y := 2. { Izlaz piši: svoj svojstvo. sebe odobri. } dok: { y oduzmi: 1. <- (y > 0). }.
	{ Izlaz piši: svoj svojstvo. sebe odobri. } × 1.
	(Popis ← 1) svaki: {  Izlaz piši: svoj svojstvo. sebe odobri. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo implementirati vlastito sortiranje, ovaj test ne prolazi jer se broj iteracija razlikuje po platformi
	(Rječnik novi one: ['item']) svaki: { Izlaz piši: svoj svojstvo. sebe odobri. }.
	{ 1 ÷ 0. } uhvati: { Izlaz piši: svoj svojstvo. sebe odobri. }, pokreni.
	Izlaz novi-red.
}.
>> doseg1 := Doseg novi.
doseg1 initialize: ['X'].
doseg1 test.
>> radnja := { 
	svoj svojstvo := ['Y'].
	Izlaz piši: svoj svojstvo.
	sebe odobri.
	( 1 = 1 ) istina: { Izlaz piši: svoj svojstvo. sebe odobri. }.
	( 1 = 0 ) laž: { Izlaz piši: svoj svojstvo. sebe odobri. }.
	>> y := 2. { Izlaz piši: svoj svojstvo. sebe odobri. } dok: { y oduzmi: 1. <- (y > 0). }.
	{ Izlaz piši: svoj svojstvo. sebe odobri. } × 1.
	(Popis ← 1) svaki: {  Izlaz piši: svoj svojstvo. sebe odobri. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Rječnik novi one: ['item']) svaki: { Izlaz piši: svoj svojstvo. sebe odobri. }.
	{ 1 ÷ 0. } uhvati: { Izlaz piši: svoj svojstvo. sebe odobri. }, pokreni.
	Izlaz novi-red.
}.
radnja na: ['odobri'] učini: { Izlaz piši: [',']. }.
radnja primijeni: 1 i: 2.
