	(Rječnik novi one: ['item']) svaki: { Izlaz piši: svoj property. sebe confirm. }.
	{ 1 ÷ 0. } uhvati: { Izlaz piši: svoj property. sebe confirm. }, pokreni.
	Izlaz novi-red.
}.
>> scope1 := Scope novi.
scope1 initialize: ['X'].
scope1 test.
>> function := { 
	svoj property := ['Y'].
	Izlaz piši: svoj property.
	sebe confirm.
	( 1 = 1 ) istina: { Izlaz piši: svoj property. sebe confirm. }.
