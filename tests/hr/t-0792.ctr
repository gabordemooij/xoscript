Server init.

>> BP := Maria-DB novi domaćin: ['localhost'],
	korisnik: ['xo'],
	lozinka: ['pass123'],
	naziv-baze: ['xobase'],
	poveži-se.
	
>> SQL := ['SELECT "hello" AS "world" '].

# brži način, dohvati upit iz BP:
>> upit2 := BP upit: SQL.

# sada ne morate postavljati BP
upit2 dohvati: { :red
	Izlaz piši: red world, novi-red.
}.
