Server init.

>> DB := Maria-DB novi domaćin: ['localhost'],
	korisnik: ['xo'],
	lozinka: ['pass123'],
	naziv-baze: ['xobase'],
	poveži-se.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB upit: SQL.

# now you don't have to set DB
query2 dohvati: { :row
	Izlaz piši: row world, novi-red.
}.
