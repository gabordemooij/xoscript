# test pretvorbi tipova / konverzija / vezanja
Program upravljanje-memorijom: 4.
Server init.

>> brojač := 0.
>> bp := Maria-DB novi domaćin: ['localhost'],
	korisnik: ['xo'], lozinka: ['pass123'], naziv-baze: ['xobase'], poveži-se.

>> DvoznamenkastiFormat := Format novi: ['%02d'].

# Datum i vrijeme
{
	>> godina     := Broj između: 1995 i: 2050, tekst.
	>> mjesec    := DvoznamenkastiFormat primijeni-cijeli: (Broj između: 1 i: 12), tekst.
	>> dan      := DvoznamenkastiFormat primijeni-cijeli: (Broj između: 1 i: 28), tekst.
	>> sat     := DvoznamenkastiFormat primijeni-cijeli: (Broj između: 1 i: 23), tekst.
	>> minuta   := DvoznamenkastiFormat primijeni-cijeli: (Broj između: 1 i: 59), tekst.
	>> sekunda   := DvoznamenkastiFormat primijeni-cijeli: (Broj između: 1 i: 59), tekst.
	>> datumvrijeme := ['YYYY-MM-DD HH:II:SS'].	
	datumvrijeme
		YYYY: godina,
		MM: mjesec,
		DD: dan,
		HH: sat,
		II: minuta,
		SS: sekunda.
	>> parametri-pretrage :=
	bp upit: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: datumvrijeme),
	dohvati: { :red
		(red mydatetime = datumvrijeme) laž: {
			ovaj-zadatak pogreška: (
				['Očekivano: <expected> ali dobiveno: <observation>']
				<expected>: datumvrijeme,
				<observation>: red mydatetime
			).
		}.
	
	}.
	brojač dodaj: 1.
} * 100.

# Datum
{
	>> godina     := Broj između: 1995 i: 2050, tekst.
	>> mjesec    := DvoznamenkastiFormat primijeni-cijeli: (Broj između: 1 i: 12), tekst.
	>> dan      := DvoznamenkastiFormat primijeni-cijeli: (Broj između: 1 i: 28), tekst.
	>> datum     := ['YYYY-MM-DD'].
	datum
		YYYY: godina,
		MM: mjesec,
		DD: dan.
	>> parametri-pretrage :=
	bp upit: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: datum),
	dohvati: { :red
		(red mydate = datum) laž: {
			ovaj-zadatak pogreška: (
				['Očekivano: <expected> ali dobiveno: <observation>']
				<expected>: datum,
				<observation>: red mydate
			).
		}.
	}.
	brojač dodaj: 1.
} * 100.


# Vrijeme
{
	>> sat     := DvoznamenkastiFormat primijeni-cijeli: (Broj između: 1 i: 23), tekst.
	>> minuta   := DvoznamenkastiFormat primijeni-cijeli: (Broj između: 1 i: 59), tekst.
	>> sekunda   := DvoznamenkastiFormat primijeni-cijeli: (Broj između: 1 i: 59), tekst.
	>> vrijeme := ['HH:II:SS'].
	vrijeme
		HH: sat,
		II: minuta,
		SS: sekunda.
	>> parametri-pretrage :=
	bp upit: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: vrijeme),
	dohvati: { :red
		(red mytime = vrijeme) laž: {
			ovaj-zadatak pogreška: (
				['Očekivano: <expected> ali dobiveno: <observation>']
				<expected>: datumvrijeme,
				<observation>: red mytime
			).
		}.
	}.
	brojač dodaj: 1.
} * 100.


# Tekstovi (varchar/text)
>> str1 := Popis novi ispuni: 100000 s: ['x'], spoji: [''].
{
	>> str2 := Sef token: 40.
	>> parametri-pretrage :=
	bp upit: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	dohvati: { :red
		(red str1 = str1 i: red str2 = str2) laž: {
			ovaj-zadatak pogreška: (
				['Očekivano: <expected> ali dobiveno: <observation>']
				<expected>: datumvrijeme,
				<observation>: red mytime
			).
		}.
	}.
	brojač dodaj: 1.
} * 100.


# Brojevi
{
	>> n1  := Broj između: 1 i: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 iz-teksta: ['9223372036854775807'] ) -
		( Int64 iz-teksta: ['99999'] ) +
		( Int64 iz-teksta: n1 tekst )
	).
	>> parametri-pretrage :=
	bp upit: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	dohvati: { :red
		(red n1 = n1) laž: {
			ovaj-zadatak pogreška: (
				['Očekivano: <expected> ali dobiveno: <observation>']
				<expected>: n1,
				<observation>: red n1
			).
		}.
		(red n2 = n2) laž: {
			ovaj-zadatak pogreška: (
				['Očekivano: <expected> ali dobiveno: <observation>']
				<expected>: n1,
				<observation>: red n2
			).
		}.
		(red n3 = n2 zaokruži) laž: {
			ovaj-zadatak pogreška: (
				['Očekivano: <expected> ali dobiveno: <observation>']
				<expected>: n1,
				<observation>: red n3
			).
		}.
		(red big = big) laž: {
			ovaj-zadatak pogreška: (
				['Očekivano: <expected> ali dobiveno: <observation>']
				<expected>: big,
				<observation>: red big
			).
		}.
		
	}.
	brojač dodaj: 1.
} * 100.


Izlaz piši: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: brojač
), novi-red.