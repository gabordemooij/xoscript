Server init.

>> db := Maria-DB novi domaćin: ['localhost'],
	korisnik: ['xo'],
	lozinka: ['pass123'],
	naziv-baze: ['xobase'],
	poveži-se.

>> parametri-pretrage := db upit: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parametri: ( Popis novi ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  parametri-pretrage izvrši. db potvrdi. } uhvati: { :e db poništi.  }, pokreni.

Izlaz piši: ['Can we insert? '] + ( parametri-pretrage insert-id > 0 ), novi-red.
