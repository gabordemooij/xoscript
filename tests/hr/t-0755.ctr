Izlaz piši: ['Testni objekt'], novi-red.
>> pozdravljač := Objekt novi.
pozdravljač na: ['name:'] učini: { :naziv
	svoj xime := naziv. 
}.
pozdravljač na: ['pozdravi'] učini: {
	Izlaz piši: ['Zdravo '] + svoj xime, novi-red.
}.
pozdravljač name: ['Sherlock'].
pozdravljač save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== PONOVNO UČITAVANJE SNIMKE:'], novi-red.
>> b := Objekt load-from: ['/tmp/a.bin'].
b pozdravi.
b name: ['Watson'], pozdravi.
