

>> g  := Server novi.
>> v  := Sef novi.
>> ok := 0.

>> tajne := Popis novi ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> lozinke := tajne kopiraj.
lozinke svaki: { :i :p
	tajne svaki: { :n :s
		{
			>> šifrirano := v šifriraj: s ključ: p.
			>> dešifrirano := v dešifriraj: šifrirano ključ: p.
			(dešifrirano = s) istina: {
				ok dodaj: 1.
			}, inače: {
				Izlaz piši: ['neuspjelo šifriranje/dešifriranje: '], novi-red.
				Izlaz piši: s, novi-red.
				Izlaz piši: ['šifrirano: '] + šifrirano, novi-red.
				Izlaz piši: ['dešifrirano: '] + šifrirano, novi-red.
				Program kraj.
			}.
		} uhvati: { :pgr
			(s = [''] ili: p = ['']) istina: {
				ok dodaj: 1.
			}, inače: {
				Izlaz piši: pgr, novi-red.
				Program kraj.
			}.
		}, pokreni.
	}.
}.

Izlaz piši: ( ok + [' šifriranja trezora testirano.'] ), novi-red.