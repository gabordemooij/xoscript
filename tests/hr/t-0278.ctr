>> To-Do := Objekt novi.

To-Do na: ['novi'] učini: {
	svoj list := Popis novi.
}.

To-Do na: ['nieuw'] učini: {
	svoj list := Popis novi.
}.

To-Do na: ['+'] učini: { :task
	svoj list dodaj-na-kraj: task.
}.

To-Do na: ['number of tasks?'] učini: { <-  svoj list broj-elemenata.
}.

>> todos := 
	To-Do novi 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Izlaz piši: ['You have $ tasks to do'] $ todos number of tasks?.
