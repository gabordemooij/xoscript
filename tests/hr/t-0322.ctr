

>> Babuška := Objekt novi.
Babuška na: ['double:'] učini: { :tajna
	svoj tajna := tajna × 2.
}.
Babuška na: ['novi:'] učini: { :tajna
	>> odgovor := Ništa.
	>> t := (tajna > 255).
	Izlaz piši: (tajna + [' | '] + t), novi-red.
	t istina: {
		odgovor := tajna.
	}, inače: {
		odgovor := Babuška rekurzivan novi: (sebe double: tajna).
	}. <- odgovor.
}.

>> x := Babuška novi: 2.
