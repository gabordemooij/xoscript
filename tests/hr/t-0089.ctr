>> nasumičnik := { :a :b
	>> minimum := ( a < b ) ili: a ili: b.
	>> maksimum := ( a > b ) ili: a ili: b.
	>> x := Ništa.
	{
		x := Broj između: a i: b.
		((x < minimum) ili: (x > maksimum)) istina: { 
			Izlaz piši: (['Neispravna vrijednost!']).
			Program kraj.
		}.
	} 
	× 100. <- x.
}.
