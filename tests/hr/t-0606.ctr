>> Točka := Objekt novi.
Točka na: ['x-coordinate:'] učini: { :x svoj x := x. }.
Točka na: ['y-coordinate:'] učini: { :y svoj y := y. }.
Točka na: ['x-koordinata']  učini: { <- svoj x kopiraj. }.
Točka na: ['y-koordinata']  učini: { <- svoj y kopiraj. }.

Točka na: ['='] učini: { :drugi
	<- ( svoj x = drugi x-koordinata
		 i: svoj y = drugi y-koordinata ).
}.

>> mol := Točka novi x-coordinate: 5, y-coordinate: 6.
>> gradska-vijećnica := Točka novi x-coordinate: 7, y-coordinate: 1.
>> restoran := Točka novi x-coordinate: 5, y-coordinate: 6.

Izlaz piši: mol = gradska-vijećnica, novi-red.
Izlaz piši: mol = restoran, novi-red.
