
Tekst na: ['html'] učini: { <- (
		sebe
		zamijeni: ['&'] s: ['&amp;'],
		zamijeni: ['<'] s: ['&lt;'],
		zamijeni: ['>'] s: ['&gt;'],
		zamijeni: ['"'] s: ['&quot;']
	).
}.

>> HtmlKist := Objekt novi.

HtmlKist na: ['odgovori:'] učini: { :tag
	Izlaz piši: (['<tag>↵'] tag: tag ).
}.

HtmlKist na: ['odgovori:i:'] učini: { :tag :content
	tag := ( tag od: 0 duljina: (tag duljina - 1) ).
	Izlaz piši: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlKist na: ['content:'] učini: { :zapis
	Izlaz piši: zapis html, novi-red.
}.

HtmlKist na: ['atr:vrijednost:'] učini: { :atr :value <- ['attr="value"'] attr: atr, value: value.
}.

>> h := HtmlKist novi.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h atr: ['class'] vrijednost: ['podebljano']),
		/span
	/body
/html.
		
