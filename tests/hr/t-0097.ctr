
Tekst na: ['html'] učini: { <- (
		sebe
		zamijeni: ['&'] s: ['&amp;'],
		zamijeni: ['<'] s: ['&lt;'],
		zamijeni: ['>'] s: ['&gt;'],
		zamijeni: ['"'] s: ['&quot;']
	).
}.

>> HtmlBrush := Objekt novi.

HtmlBrush na: ['odgovori:'] učini: { :tag
	Izlaz piši: (['<tag>↵'] tag: tag ).
}.

HtmlBrush na: ['odgovori:i:'] učini: { :tag :content
	tag := ( tag od: 0 duljina: (tag duljina - 1) ).
	Izlaz piši: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush na: ['content:'] učini: { :text
	Izlaz piši: text html, novi-red.
}.

HtmlBrush na: ['attr:value:'] učini: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush novi.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
