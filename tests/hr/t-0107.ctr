
Izlaz piši: ['Break for-loop, 0-4.'], novi-red.
{ :i
	Izlaz piši: ['iteration #'] + i, novi-red.
	(i = 4) prekini.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Izlaz piši: ['Break while-true loop, 0-4.'], novi-red.
{
	Izlaz piši: ['iteration #'] + x, novi-red.
	x dodaj: 1.
	((x < 5) ne) prekini.
} dok: xIsLessThan10.

Izlaz piši: ['Break while-false loop, 5,4.'], novi-red.
{
	Izlaz piši: ['iteration #'] + x, novi-red.
	x oduzmi: 1.
	(x = 3) prekini.
} dok: { <- (x > 0). }.

Izlaz piši: ['Break times loop, 1-4.'], novi-red.
{ :i
	Izlaz piši: ['iteration #'] + i, novi-red.
	(i = 4) prekini.
} × 5.

Izlaz piši: ['Break block, dont print line.'], novi-red.
{ Istina prekini. Izlaz piši: ['dont write this!'], novi-red. } pokreni.

Izlaz piši: ['Break block, dont fire catch...'], novi-red.
{ Istina prekini. Izlaz piši: ['dont write this!'], novi-red. } uhvati: { Izlaz piši: ['Dont catch this!']. }, pokreni.

Izlaz piši: ['Test Array each-loop: 0,1'], novi-red.
(Popis ← 1 ; 2 ; 3) preslikaj: { :i
	Izlaz piši: ['iteration #'] + i, novi-red.
	(i = 1) prekini.
}.

Izlaz piši: ['Test Map each-loop: c only'], novi-red.
>> m := Rječnik novi.
m stavi: ['first'] na: ['a'], stavi: ['second'] na: ['b'], stavi: ['third'] na: ['c'].
m svaki: { :k :v
	Izlaz piši: ['iteration'] + v + k, novi-red.
	Istina prekini.
}.

