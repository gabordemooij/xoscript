
Izlaz piši: ['Prekini for-petlju, 0-4.'], novi-red.
{ :i
	Izlaz piši: ['iteration #'] + i, novi-red.
	(i = 4) prekini.
} × 10.

>> x := 0.
>> xJeManjiOd10 := { <- ( x < 10 ). }.

Izlaz piši: ['Prekini while-true petlju, 0-4.'], novi-red.
{
	Izlaz piši: ['iteration #'] + x, novi-red.
	x dodaj: 1.
	((x < 5) ne) prekini.
} dok: xJeManjiOd10.

Izlaz piši: ['Prekini while-false petlju, 5,4.'], novi-red.
{
	Izlaz piši: ['iteration #'] + x, novi-red.
	x oduzmi: 1.
	(x = 3) prekini.
} dok: { <- (x > 0). }.

Izlaz piši: ['Prekini times petlju, 1-4.'], novi-red.
{ :i
	Izlaz piši: ['iteration #'] + i, novi-red.
	(i = 4) prekini.
} × 5.

Izlaz piši: ['Prekini blok, ne ispisuj redak.'], novi-red.
{ Istina prekini. Izlaz piši: ['nemoj ovo zapisati!'], novi-red. } pokreni.

Izlaz piši: ['Prekini blok, ne pokreći hvatanje...'], novi-red.
{ Istina prekini. Izlaz piši: ['nemoj ovo zapisati!'], novi-red. } uhvati: { Izlaz piši: ['Nemoj ovo uhvatiti!']. }, pokreni.

Izlaz piši: ['Test each-petlje Polja: 0,1'], novi-red.
(Popis ← 1 ; 2 ; 3) preslikaj: { :i
	Izlaz piši: ['iteration #'] + i, novi-red.
	(i = 1) prekini.
}.

Izlaz piši: ['Test each-petlje Mape: samo c'], novi-red.
>> m := Rječnik novi.
m stavi: ['first'] na: ['a'], stavi: ['second'] na: ['b'], stavi: ['treći'] na: ['c'].
m svaki: { :k :v
	Izlaz piši: ['iteration'] + v + k, novi-red.
	Istina prekini.
}.

