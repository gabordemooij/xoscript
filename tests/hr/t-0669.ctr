# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Sef 
	sažetak-lozinke: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Sef 
	sažetak-lozinke: hash provjeri: a1.
	# fail 
>> b := Sef
	sažetak-lozinke: hash provjeri: a2.
	# ok!

Izlaz piši: a, novi-red.
Izlaz piši: b, novi-red.

