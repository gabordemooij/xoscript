# Sažimanje lozinki
Server init.

# Korisnik postavlja lozinku
>> lozin := ['pass123'].

# Spremite je ovako
>> otisak := Sef 
	sažetak-lozinke: lozin.

# Zatim se korisnik prijavljuje
# Pokušaj 1
>> a1 := ['abcd123'].
# Pokušaj 2
>> a2 := ['pass123'].

# Provjera
>> a := Sef 
	sažetak-lozinke: otisak provjeri: a1.
	# neuspjeh 
>> b := Sef
	sažetak-lozinke: otisak provjeri: a2.
	# u redu!

Izlaz piši: a, novi-red.
Izlaz piši: b, novi-red.

