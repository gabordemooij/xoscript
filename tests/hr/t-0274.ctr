

Popis na: ['column:'] učini: { :stupac
	>> rezultat := Popis novi.
	sebe svaki: { :indeks :red
		red svaki: { :indeks :ćelija
			(indeks = stupac) istina: { rezultat dodaj-na-kraj: ćelija. }.
		}.
	}. <- rezultat.
}.


>> a := Popis ←
	(Popis ← 1 ; 2 ; 3) ;
	(Popis ← 4 ; 5 ; 6) ;
	(Popis ← 7 ; 8 ; 9).

>> b := a column: 1.
Izlaz piši: b, novi-red.

b := a column: 20.
Izlaz piši: b, novi-red.

b := a column: -100.
Izlaz piši: b, novi-red.
