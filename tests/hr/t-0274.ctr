

Popis na: ['column:'] učini: { :column
	>> result := Popis novi.
	sebe svaki: { :index :row
		row svaki: { :index :cell
			(index = column) istina: { result dodaj-na-kraj: cell. }.
		}.
	}. <- result.
}.


>> a := Popis ←
	(Popis ← 1 ; 2 ; 3) ;
	(Popis ← 4 ; 5 ; 6) ;
	(Popis ← 7 ; 8 ; 9).

>> b := a column: 1.
Izlaz piši: b, novi-red.

b := a column: 20.
Izlaz piši: b, novi-red.

b := a column: -100.
Izlaz piši: b, novi-red.
