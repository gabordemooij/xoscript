#Linux
>> OS := Program postavka: ['OS'].

>> clock := Trenutak novi.
	
(OS = ['Haiku']) istina: {
	clock zona: ['CET'],
	godina: 2017, mjesec: 7, dan: 13,
	sat: 18, minuta: 0, sekunda: 0.
}, inače: {
	clock zona: ['Europe/Amsterdam'],
	godina: 2017, mjesec: 7, dan: 13,
	sat: 18, minuta: 0, sekunda: 0.
}.

clock na: ['tell'] učini: {
	Izlaz piši: sebe, novi-red.
}.


clock dodaj: 2    sat, tell.
clock dodaj: 1    sat, tell.
clock dodaj: 19 minuta, tell.
clock dodaj: 1  minuta, tell.
clock dodaj: 1  minuta, tell.
clock dodaj: 19 sekunda, tell.
clock dodaj: 1  sekunda, tell.
clock dodaj: 1  sekunda, tell.
clock dodaj: 2    godina, tell.
clock dodaj: 1    godina, tell.

(OS = ['Haiku']) istina: {
clock dodaj: 5   mjesec.
clock zona: ['CEST'], tell.
}, inače: {
	clock dodaj: 5   mjesec, tell.
}.

clock dodaj: 1   mjesec, tell.
clock dodaj: 19    dan, tell.
clock dodaj: 1    sat, tell.
clock dodaj: 120  yard, tell.
