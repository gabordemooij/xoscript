>> Pozdravljač := Objekt novi.
Pozdravljač na: ['napravi'] učini: {
	>> pozdravljač := Objekt novi.
	pozdravljač na: ['name:'] učini: { :naziv
		Izlaz piši: ['postavljam ime'].
		svoj mojeIme := naziv.
	}.
	pozdravljač na: ['pozdravi'] učini: {
		Izlaz piši: ['Hello'].
		Izlaz piši: svoj mojeIme.
	}. <- pozdravljač.
}.
>> pozdravljač := Pozdravljač napravi.
pozdravljač name: ['sunce!'].
pozdravljač pozdravi.
