
Server init.
>> zht := HTTP-Zahtjev novi.
Izlaz piši: ['HTTP-GET d[]=']  + ( zht get-popis: ['d[]'] ), novi-red. # GET
Izlaz piši: ['HTTP-GET f[]=']  + ( zht get-popis: ['f[]'] ), novi-red. # GET
Izlaz piši: ['HTTP-POST e[]='] + ( zht post-popis: ['e[]'] ), novi-red. # GET
Izlaz piši: ['HTTP-POST c=']   + ( zht post: ['c'] ), novi-red. # GET
Izlaz piši: ['HTTP-POST xx=']  + ( zht post: ['xx'] ), novi-red. # GET
