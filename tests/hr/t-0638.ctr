
Server init.
>> rq := HTTP-Zahtjev novi.
Izlaz piši: ['HTTP-GET d[]=']  + ( rq get-popis: ['d[]'] ), novi-red. # GET
Izlaz piši: ['HTTP-GET f[]=']  + ( rq get-popis: ['f[]'] ), novi-red. # GET
Izlaz piši: ['HTTP-POST e[]='] + ( rq post-popis: ['e[]'] ), novi-red. # GET
Izlaz piši: ['HTTP-POST c=']   + ( rq post: ['c'] ), novi-red. # GET
Izlaz piši: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), novi-red. # GET
