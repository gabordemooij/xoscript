Izlaz piši: ['Testni objekt'], novi-red.
>> a := Objekt novi. 
a na: ['item:'] učini: { :pps
	svoj pps := pps. 
}.
a na: ['stavka'] učini: {
	<- svoj pps.
}.
a item: (
	Popis novi ; 1 ; (
		Popis novi ; ['a'] ; (
			Popis novi ; ( Trenutak novi: 1 )
		) ; ( Int64 iz-teksta: ['321'] )
	)
).
Izlaz piši: a stavka, novi-red.
>> stara-pps-adresa := a stavka prototip memorijska-adresa.
a save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== PONOVNO UČITAVANJE SNIMKE:'], novi-red.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b stavka prototip memorijska-adresa = stara-pps-adresa) istina: {
	Izlaz piši: ['Veza objekta ponovno pridružena.'], novi-red.
}.
Izlaz piši: ( b stavka ), novi-red.
