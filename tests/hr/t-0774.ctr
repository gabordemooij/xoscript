Izlaz piši: ['Test object'], novi-red.
>> a := Objekt novi. 
a na: ['item:'] učini: { :lst
	svoj lst := lst. 
}.
a na: ['item'] učini: { <- svoj lst.
}.
a item: (
	Popis novi ; 1 ; (
		Popis novi ; ['a'] ; (
			Popis novi ; ( Trenutak novi: 1 )
		) ; ( Int64 iz-teksta: ['321'] )
	)
).
Izlaz piši: a item, novi-red.
>> old-lst-address := a item prototip memorijska-adresa.
a save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== RELOADING SNAP:'], novi-red.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b item prototip memorijska-adresa = old-lst-address) istina: {
	Izlaz piši: ['Object link re-attached.'], novi-red.
}.
Izlaz piši: ( b item ), novi-red.
