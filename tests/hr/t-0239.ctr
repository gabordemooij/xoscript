Popis na: ['sum'] učini: {
	>> total := 0.
	sebe svaki: { :index :element
		total dodaj: element.
	}. <- total.
}.

>> a := Istina.



a na: ['tekst'] učini: {
	>> answer := Ništa.
	( sebe = Istina ) istina: {
		answer := ['Yep'].
	}, inače: {
		answer := ['Nope'].
	}. <- answer.
}.

a na: ['broj'] učini: {
	>> answer := Ništa.
	( sebe = Istina ) istina: {
		answer := 10.
	}, inače: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b na: ['tekst'] učini: { <- ['Devil'].
}.

b na: ['logički'] učini: { <- Laž.
}.


Izlaz piši: a, novi-red.  
Izlaz piši: (90 + a), novi-red. 
Izlaz piši: b, novi-red. 
Izlaz piši: (Istina i: b), novi-red.

a := Popis ← ['hello'] ; ['world'] ; Istina ; Ništa ; 666. 
a := a + ( Popis ← 1 ).
Izlaz piši: a, novi-red.
Izlaz piši: ((Rječnik novi) stavi: Ništa na: Ništa), novi-red.
Izlaz piši: a sum, novi-red. 


{
	a na: ['tekst'] učini: { <- Ništa. }.
	a := [''] + a.
} uhvati: { :error
	Izlaz piši: ['Error noted: '] + error, novi-red.
}, pokreni.



{
	a na: ['broj'] učini: { <- Ništa. }.
	a := 3 × a.
} uhvati: { :error
	Izlaz piši: ['Error noted: '] + error, novi-red.
}, pokreni.


{
	a na: ['logički'] učini: { <- Ništa. }.
	a := Istina i: a. 
} uhvati: { :error
	Izlaz piši: ['Error noted: '] + error, novi-red.
}, pokreni.





