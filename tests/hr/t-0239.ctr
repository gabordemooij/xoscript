Popis na: ['zbroj'] učini: {
	>> ukupno := 0.
	sebe svaki: { :indeks :element
		ukupno dodaj: element.
	}. <- ukupno.
}.

>> a := Istina.



a na: ['tekst'] učini: {
	>> odgovor := Ništa.
	( sebe = Istina ) istina: {
		odgovor := ['Aha'].
	}, inače: {
		odgovor := ['Ma ne'].
	}. <- odgovor.
}.

a na: ['broj'] učini: {
	>> odgovor := Ništa.
	( sebe = Istina ) istina: {
		odgovor := 10.
	}, inače: {
		odgovor := 20.
	}. <- odgovor.
}.

>> b := 666.

b na: ['tekst'] učini: { <- ['Vrag'].
}.

b na: ['logički'] učini: { <- Laž.
}.


Izlaz piši: a, novi-red.  
Izlaz piši: (90 + a), novi-red. 
Izlaz piši: b, novi-red. 
Izlaz piši: (Istina i: b), novi-red.

a := Popis ← ['hello'] ; ['world'] ; Istina ; Ništa ; 666. 
a := a + ( Popis ← 1 ).
Izlaz piši: a, novi-red.
Izlaz piši: ((Rječnik novi) stavi: Ništa na: Ništa), novi-red.
Izlaz piši: a zbroj, novi-red. 


{
	a na: ['tekst'] učini: { <- Ništa. }.
	a := [''] + a.
} uhvati: { :greška
	Izlaz piši: ['Greška zabilježena: '] + greška, novi-red.
}, pokreni.



{
	a na: ['broj'] učini: { <- Ništa. }.
	a := 3 × a.
} uhvati: { :greška
	Izlaz piši: ['Greška zabilježena: '] + greška, novi-red.
}, pokreni.


