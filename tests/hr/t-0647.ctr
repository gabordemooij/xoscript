Server init.
Izlaz piši: ['Database time test'], novi-red.

>> db := Maria-DB novi domaćin: ['localhost'],
	korisnik: ['xo'], 
	lozinka: ['pass123'],
	naziv-baze: ['xobase'],
	poveži-se.

>> parametri-pretrage :=
db upit: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
dohvati: { :row
	Izlaz piši: row timetest, novi-red.
}.
