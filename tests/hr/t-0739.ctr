Izlaz piši: ['Testni objekt'], novi-red.
>> a := Objekt novi. 

a na: ['item:'] učini: { :binpomoćnik
	svoj binpomoćnik := binpomoćnik. 
}.

a na: ['stavka'] učini: {
	<- svoj binpomoćnik.
}.

a item: Bin novi.

>> stara-binpomoćnik-adresa := a stavka prototip memorijska-adresa.
a save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== PONOVNO UČITAVANJE SNIMKE:'], novi-red.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b stavka prototip memorijska-adresa = stara-binpomoćnik-adresa) istina: {
	Izlaz piši: ['Veza objekta ponovno pridružena.'], novi-red.
}.


