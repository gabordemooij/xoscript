


>> AparatZaKavu := Objekt novi.
AparatZaKavu na: ['order:'] učini: { :id
	>> coffee := ['Americano'].
	( id = 1 ) istina: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) istina: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) istina: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> JednostavniAparatZaKavu := Objekt novi.
JednostavniAparatZaKavu na: ['narudžba'] učini: { <- ['Crna']. }.
>> crvenaŠalica := AparatZaKavu order: 1.
Izlaz piši: crvenaŠalica, novi-red.
crvenaŠalica := ['Čaj']. 
>> zelenaŠalica := AparatZaKavu order: 0.
Izlaz piši: zelenaŠalica, novi-red.
>> žutaŠalica := AparatZaKavu order: 1.
Izlaz piši: žutaŠalica, novi-red.
>> plavaŠalica := AparatZaKavu order: 0.
Izlaz piši: plavaŠalica, novi-red.
>> plastičnaŠalica := JednostavniAparatZaKavu narudžba.
plastičnaŠalica := ['Limunada']. 
>> crnaŠalica := JednostavniAparatZaKavu narudžba.
Izlaz piši: crnaŠalica, novi-red.
crnaŠalica dodaj-na-kraj: [' neee.... pivo. '].
>> narančastaŠalica := JednostavniAparatZaKavu narudžba.
Izlaz piši: narančastaŠalica, novi-red.
