


>> CoffeeMachine := Objekt novi.
CoffeeMachine na: ['order:'] učini: { :id
	>> coffee := ['Americano'].
	( id = 1 ) istina: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) istina: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) istina: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Objekt novi.
SimpleCoffeeMachine na: ['order'] učini: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Izlaz piši: redCup, novi-red.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Izlaz piši: greenCup, novi-red.
>> yellowCup := CoffeeMachine order: 1.
Izlaz piši: yellowCup, novi-red.
>> blueCup := CoffeeMachine order: 0.
Izlaz piši: blueCup, novi-red.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Izlaz piši: blackCup, novi-red.
blackCup dodaj-na-kraj: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Izlaz piši: orangeCup, novi-red.
