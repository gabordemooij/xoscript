# javni ključ (za zaštitu API-ja itd.)
Server init.

# generiraj ključeve
>> ključevi := Sef generiraj-ključeve.

# privatni (tajni) ključ
>> tk := ključevi prvi.

# javni ključ
>> jk := ključevi posljednji.

# potpiši poruku
>> potp := Sef potpiši: ['abc'] ključem: tk.

# provjeri poruku (u redu)
Izlaz piši: ( 
	Sef
		provjeri: ['abc'] 
		potpis: potp 
		ključem: jk 
), novi-red.

# provjeri poruku (neuspjeh)
Izlaz piši: ( 
	Sef 
		provjeri: ['abd'] 
		potpis: potp 
		ključem: jk 
), novi-red.