>> Djed := Objekt novi.
Djed na: ['pozdravi'] učini: {
	Izlaz piši: ['Ave!'], novi-red.
}.
>> Otac := Djed novi.
Otac na: ['pozdravi'] učini: {
	Izlaz piši: ['Hello'], novi-red.
	sebe pozdravi.
}.
>> Sin := Otac novi.
Sin na: ['pozdravi'] učini: {
	Izlaz piši: ['Bok'], novi-red.
	sebe pozdravi.
}.

Sin pozdravi.

>> KružniTok := Objekt novi.
KružniTok na: ['circle:'] učini: { :x
	Izlaz piši: x, novi-red.
	(x < 3) istina: { sebe rekurzivan circle: x + 1. }.
}.

KružniTok circle: 1.

>> x := 1.
>> povećaj := { (x ≤ 3) istina: { Izlaz piši: x, novi-red. x dodaj: 1.  povećaj pokreni. }. }.
povećaj pokreni.