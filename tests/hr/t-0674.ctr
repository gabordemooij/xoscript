# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> putanja := ['/tmp/dat.csv'].
>> csv := Datoteka novi: putanja.
csv piši: s.

# accepts CRLF LF CR, varying row length
csv razdjelnik: [';'] navodnik: ['"'] retci: { :line
	Program počisti.
	Izlaz piši: line, novi-red.
	Program počisti.
}.

# unequal lines
s dodaj-na-kraj: ['\njustone'].
csv piši: s.
{
	csv razdjelnik: [';'] navodnik: ['"'] retci: { :line
		Izlaz piši: line, novi-red.
	}.
} uhvati: { :e 
	Izlaz piši: e, novi-red.
}, pokreni.

# invalid format
s := ['"he"llo";world'].
csv piši: s.
{
	csv razdjelnik: [';'] navodnik: ['"'] retci: { :line
		Izlaz piši: line, novi-red.
	}.
} uhvati: { :e 
	Izlaz piši: e, novi-red.
}, pokreni.
