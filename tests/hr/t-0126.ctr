#Linux
>> Srkač := Objekt novi.

Srkač na: ['novi'] učini: {
	svoj str := [''].
}.

Srkač na: ['nieuw'] učini: {
	svoj str := [''].
}.

Srkač na: ['odgovori:'] učini: { :blah
		svoj str dodaj-na-kraj: blah.
}.

Srkač na: ['odgovori:i:'] učini: { :blah :blahah
		svoj str dodaj-na-kraj: (blah od: 0 duljina: (blah duljina - 1)).
		svoj str dodaj-na-kraj: [' '].
		svoj str dodaj-na-kraj: blahah.
}.

Srkač na: ['dobavi'] učini: {
	>> međuspremnik := svoj str.
	svoj str := ['']. <- međuspremnik.
}.


Izlaz piši: (Program sustav: (Srkač novi echo: ['Zdravo, mogu pisati na konzolu pomoću fluidnog API-ja!'], dobavi)).


{ Datoteka novi: ['/tmp/from.txt'], izbriši. } uhvati: { ['Prazno']. }, pokreni.
{ Datoteka novi: ['/tmp/to.txt'], izbriši. } uhvati: { ['Prazno']. }, pokreni.


Datoteka novi: ['/tmp/to.txt'], postoji laž: {
	Izlaz piši: ['Confirmed. Target file does not exist.\
'].
}.
Datoteka novi: ['/tmp/from.txt'], postoji laž: {
	Izlaz piši: ['Confirmed. Source file does not exist.\
'].
}.



Program sustav: (Srkač novi touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], dobavi).



Program sustav: (Srkač novi cp: ['/tmp/from.txt /tmp/to.txt'], dobavi).

Datoteka novi: ['/tmp/to.txt'], postoji istina: {
	Izlaz piši: ['Confirmed. Target file has been created by shell.\
'].
}.


Izlaz piši: ['Sadržaj datoteke je:'] + (Datoteka novi: ['/tmp/to.txt'], čitaj), novi-red.
