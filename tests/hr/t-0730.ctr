Izlaz piši: ['Test object'], novi-red.
>> a := Objekt novi. 

a na: ['item:'] učini: { :moment
	svoj moment := moment. 
}.

a na: ['item'] učini: { <- svoj moment.
}.

>> today := Trenutak novi zona: ['CEST'], godina: 2026, mjesec: 7.
a item: today.
Izlaz piši: a item, novi-red.
a save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== RELOADING SNAP:'], novi-red.
>> b := Objekt load-from: ['/tmp/a.bin'].
Izlaz piši: b item, novi-red.
