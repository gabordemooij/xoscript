>> t := Ništa.

# vremensku zonu za parsiranje
# možete odrediti ovako:
Trenutak zona: ['CET'].
t := Trenutak iz: ['1981-02-03 04:05:06'].
Izlaz piši: t, novi-red.

# sada koristimo vremensku zonu CEST:
Trenutak zona: ['CEST'].
t := Trenutak iz: ['1981-02-03 04:05:06'].
Izlaz piši: t, novi-red.

# pogreška ako se tekst ne može parsirati
{ Trenutak iz: ['1900']. } uhvati: { Ništa. }, pokreni.
