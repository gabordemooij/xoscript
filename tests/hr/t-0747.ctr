Izlaz piši: ['Test object'], novi-red.
>> a := Objekt novi. 

a na: ['item:'] učini: { :num
	svoj num := num. 
}.

a na: ['item'] učini: { <- svoj num.
}.

a item: 123.

Izlaz piši: a item, novi-red.

>> old-num-address := a item prototip memorijska-adresa.
a save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== RELOADING SNAP:'], novi-red.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototip memorijska-adresa = old-num-address) istina: {
	Izlaz piši: ['Object link re-attached.'], novi-red.
}.

Izlaz piši: b item, novi-red.
