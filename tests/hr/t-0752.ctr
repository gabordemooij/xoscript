Izlaz piši: ['Test object'], novi-red.
>> a := Objekt novi. 

a na: ['item:'] učini: { :logički
	svoj logički := logički. 
}.

a na: ['item'] učini: { <- svoj logički.
}.

a item: Logički.

Izlaz piši: a item, novi-red.

>> old-bool-address := a item prototip memorijska-adresa.
a save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== RELOADING SNAP:'], novi-red.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototip memorijska-adresa = old-bool-address) istina: {
	Izlaz piši: ['Object link re-attached.'], novi-red.
}.

Izlaz piši: b item, novi-red.
