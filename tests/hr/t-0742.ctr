Izlaz piši: ['Test object'], novi-red.
>> a := Objekt novi. 

a na: ['item:'] učini: { :hexhelper
	svoj hexhelper := hexhelper. 
}.

a na: ['item'] učini: { <- svoj hexhelper.
}.

a item: Hx novi.

>> old-hexhelper-address := a item prototip memorijska-adresa.
a save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== RELOADING SNAP:'], novi-red.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototip memorijska-adresa = old-hexhelper-address) istina: {
	Izlaz piši: ['Object link re-attached.'], novi-red.
}.
