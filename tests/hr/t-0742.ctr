Izlaz piši: ['Testni objekt'], novi-red.
>> a := Objekt novi. 

a na: ['item:'] učini: { :hekspomoćnik
	svoj hekspomoćnik := hekspomoćnik. 
}.

a na: ['stavka'] učini: {
	<- svoj hekspomoćnik.
}.

a item: Hx novi.

>> stara-hekspomoćnik-adresa := a stavka prototip memorijska-adresa.
a save-as: ['/tmp/a.bin'].
Izlaz piši: ['========== PONOVNO UČITAVANJE SNIMKE:'], novi-red.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b stavka prototip memorijska-adresa = stara-hekspomoćnik-adresa) istina: {
	Izlaz piši: ['Veza objekta ponovno pridružena.'], novi-red.
}.
