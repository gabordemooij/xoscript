Umbhalo uma-kufika: ['html'] yenza: { <- (
		uqobo
		buyisela: ['&'] nge: ['&amp;'],
		buyisela: ['<'] nge: ['&lt;'],
		buyisela: ['>'] nge: ['&gt;'],
		buyisela: ['''] nge: ['&apos;'],
		buyisela: ['"'] nge: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Uhlelo ukuphathwa-kwenkumbulo: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Okuphumayo bhala: txt kopisha html, umugqa-omusha.
Okuphumayo bhala: txt kopisha izinhlamvu-ezincane, umugqa-omusha.
Okuphumayo bhala: txt kopisha osonhlamvukazi, umugqa-omusha.
} qala.

Uhlelo hlanza.

usedMemory1 := (Uhlelo inkumbulo ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Okuphumayo bhala: txt kopisha html, umugqa-omusha.
Okuphumayo bhala: txt kopisha izinhlamvu-ezincane, umugqa-omusha.
Okuphumayo bhala: txt kopisha osonhlamvukazi, umugqa-omusha.
} qala.

Uhlelo hlanza.
usedMemory2 := (Uhlelo inkumbulo ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Okuphumayo bhala: txt kopisha html, umugqa-omusha.
Okuphumayo bhala: txt kopisha izinhlamvu-ezincane, umugqa-omusha.
Okuphumayo bhala: txt kopisha osonhlamvukazi, umugqa-omusha.
} qala.

Uhlelo hlanza.
usedMemory3 := (Uhlelo inkumbulo ? 0).



( usedMemory1 = usedMemory2 futhi: usedMemory1 = usedMemory3, futhi: usedMemory2 = usedMemory3 ) iqiniso: {
	Okuphumayo bhala: ['No memory leaks here'].
}, amanga: {
	Okuphumayo bhala: ['Leaking memory...'].
}.
