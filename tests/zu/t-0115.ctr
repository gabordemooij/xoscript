{
	lo-msebenzi iphutha: ['Dont fail.'].
	unknown doSomething.
} bamba: {
	Okuphumayo bhala: ['Caught!'].
}, qala.

{
	lo-msebenzi iphutha: ['Dont fail.'].
	okwakho unknown doSomething.
} bamba: {
	Okuphumayo bhala: ['Caught!'].
}, qala.

{
	lo-msebenzi iphutha: ['Dont fail.'].
	unknown := 122.
} bamba: {
	Okuphumayo bhala: ['Caught!'].
}, qala.


{
	lo-msebenzi iphutha: ['Dont fail.'].
	Iqiniso nqamula.
	Okuphumayo bhala: ['FAIL'].
} bamba: {
	Okuphumayo bhala: ['Caught!'].
}, qala.

{
	{
		lo-msebenzi iphutha: ['Dont fail.'].
		Iqiniso nqamula.
		Okuphumayo bhala: ['FAIL'].
	} bamba: { :x
		(x = ['Dont fail.']) iqiniso: { lo-msebenzi iphutha: ['Nested Caught!']. }.
	}, qala.
} bamba: { :e
	Okuphumayo bhala: e.
}, qala.
