
Inombolo funda: ['plus:'] kusho: ['+'].
Inombolo uma-kufika: ['+'] yenza: { :x
	>> rate := 1.
	>> currency := x iyunithi-yenombolo.
	(currency = ['euros']) iqiniso: {
		rate := 2.
	}. <- (uqobo plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars iyunithi: ['dollars'].
euros iyunithi: ['euros'].
>> money := dollars + euros.
Okuphumayo bhala: money, umugqa-omusha.
