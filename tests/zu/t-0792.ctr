Server init.

>> DB := Maria-DB okusha umsingathi: ['localhost'],
	igama-lomsebenzisi: ['xo'],
	iphasiwedi: ['pass123'],
	igama-lesizindalwazi: ['xobase'],
	xhumana.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB umbuzo: SQL.

# now you don't have to set DB
query2 landa: { :row
	Okuphumayo bhala: row world, umugqa-omusha.
}.
