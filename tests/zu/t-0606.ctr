>> Point := Into okusha.
Point uma-kufika: ['x-coordinate:'] yenza: { :x okwakho x := x. }.
Point uma-kufika: ['y-coordinate:'] yenza: { :y okwakho y := y. }.
Point uma-kufika: ['x-coordinate']  yenza: { <- okwakho x kopisha. }.
Point uma-kufika: ['y-coordinate']  yenza: { <- okwakho y kopisha. }.

Point uma-kufika: ['='] yenza: { :other <- ( okwakho x = other x-coordinate
		 futhi: okwakho y = other y-coordinate ).
}.

>> pier := Point okusha x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point okusha x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point okusha x-coordinate: 5, y-coordinate: 6.

Okuphumayo bhala: pier = town-hall, umugqa-omusha.
Okuphumayo bhala: pier = restaurant, umugqa-omusha.
