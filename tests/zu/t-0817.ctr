# a value ending in the first part of an opening quote must survive serialization
>> amanani := Uhlu okusha
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

amanani ngamunye: { :i :value
	>> d := Isichazamazwi okusha.
	d beka: value endaweni: ['k'].
	d beka: ['second'] endaweni: ['j'].
	>> r := d ikhodi into.
	Okuphumayo bhala: r inani, umugqa-omusha.
	Okuphumayo bhala: ( (r endaweni: ['k']) = value ), umugqa-omusha.
}.
