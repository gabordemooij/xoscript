# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB okusha umsingathi: ['localhost'],
	igama-lomsebenzisi: ['xo'],
	iphasiwedi: ['pass123'],
	igama-lesizindalwazi: ['xobase'],
	xhumana.

>> amapharamitha-okusesha := db umbuzo: ['SELECT %% FROM'].
{ amapharamitha-okusesha enza-umyalo. } bamba: { :e
	Okuphumayo bhala: ( e iqukethe: ['%%'] ), umugqa-omusha.
}, qala.
