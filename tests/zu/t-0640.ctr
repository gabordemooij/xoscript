
Server init.
Okuphumayo bhala: ['Database test'], umugqa-omusha.

>> db := Maria-DB okusha umsingathi: ['localhost'],
	igama-lomsebenzisi: ['xo'], 
	iphasiwedi: ['pass123'],
	igama-lesizindalwazi: ['xobase'],
	xhumana.

>> amapharamitha-okusesha :=
db umbuzo: ['SELECT UNHEX('CAFE') AS blobby'],
landa: { :row
	Okuphumayo bhala: ( row blobby kusuka: 0 ubude: 2 ), umugqa-omusha.
	row blobby khulula.
}.
