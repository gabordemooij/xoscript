
>> Rectangle := Into okusha.

Rectangle uma-kufika: ['area'] yenza: { <- okwakho ubude * okwakho width.
}.

Rectangle uma-kufika: ['length:'] yenza: { :ubude
	okwakho ubude := ubude.
}.

Rectangle uma-kufika: ['width:'] yenza: { :width
	okwakho width := width.
}.

Rectangle uma-kufika: ['okusha'] yenza: {
	# this will not result into an infinite loop
	>> rectangle := uqobo okusha.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle okusha.
Okuphumayo bhala: a area, umugqa-omusha. #0

>> b := Rectangle okusha length: 2, width: 3.
Okuphumayo bhala: b area, umugqa-omusha. #6

