Okuphumayo bhala: ['Test object'], umugqa-omusha.
>> a := Into okusha. 
a uma-kufika: ['item:'] yenza: { :int64
	okwakho int64 := int64. 
}.
a uma-kufika: ['item'] yenza: { <- okwakho int64.
}.
a item: ( Int64 kusuka-embhalweni: ['9999'] ).
Okuphumayo bhala: a item, umugqa-omusha.
>> old-int64-address := a item isibonelo-sokuqala ikheli-lenkumbulo.
a save-as: ['/tmp/a.bin'].
Okuphumayo bhala: ['========== RELOADING SNAP:'], umugqa-omusha.
>> b := Into load-from: ['/tmp/a.bin'].
(b item isibonelo-sokuqala ikheli-lenkumbulo = old-int64-address) iqiniso: {
	Okuphumayo bhala: ['Object link re-attached.'], umugqa-omusha.
}.
Okuphumayo bhala: ( b item ), umugqa-omusha.
