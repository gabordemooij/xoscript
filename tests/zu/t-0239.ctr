Uhlu uma-kufika: ['sum'] yenza: {
	>> total := 0.
	uqobo ngamunye: { :index :element
		total engeza: element.
	}. <- total.
}.

>> a := Iqiniso.



a uma-kufika: ['umbhalo'] yenza: {
	>> answer := Lutho.
	( uqobo = Iqiniso ) iqiniso: {
		answer := ['Yep'].
	}, uma-kungenjalo: {
		answer := ['Nope'].
	}. <- answer.
}.

a uma-kufika: ['inombolo'] yenza: {
	>> answer := Lutho.
	( uqobo = Iqiniso ) iqiniso: {
		answer := 10.
	}, uma-kungenjalo: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b uma-kufika: ['umbhalo'] yenza: { <- ['Devil'].
}.

b uma-kufika: ['ibhuliyeni'] yenza: { <- Amanga.
}.


Okuphumayo bhala: a, umugqa-omusha.  
Okuphumayo bhala: (90 + a), umugqa-omusha. 
Okuphumayo bhala: b, umugqa-omusha. 
Okuphumayo bhala: (Iqiniso futhi: b), umugqa-omusha.

a := Uhlu ← ['hello'] ; ['world'] ; Iqiniso ; Lutho ; 666. 
a := a + ( Uhlu ← 1 ).
Okuphumayo bhala: a, umugqa-omusha.
Okuphumayo bhala: ((Isichazamazwi okusha) beka: Lutho endaweni: Lutho), umugqa-omusha.
Okuphumayo bhala: a sum, umugqa-omusha. 


{
	a uma-kufika: ['umbhalo'] yenza: { <- Lutho. }.
	a := [''] + a.
} bamba: { :error
	Okuphumayo bhala: ['Error noted: '] + error, umugqa-omusha.
}, qala.



{
	a uma-kufika: ['inombolo'] yenza: { <- Lutho. }.
	a := 3 × a.
} bamba: { :error
	Okuphumayo bhala: ['Error noted: '] + error, umugqa-omusha.
}, qala.


{
	a uma-kufika: ['ibhuliyeni'] yenza: { <- Lutho. }.
	a := Iqiniso futhi: a. 
} bamba: { :error
	Okuphumayo bhala: ['Error noted: '] + error, umugqa-omusha.
}, qala.





{
	a uma-kufika: ['umbhalo'] yenza: { <- Amanga. }.
