} bamba: { :error
	Okuphumayo bhala: ['Error noted: '] + error, umugqa-omusha.
}, qala.


{
	a uma-kufika: ['boolean'] yenza: { <- 1. }.
	a := Iqiniso futhi: a.
} bamba: { :error
	Okuphumayo bhala: ['Error noted: '] + error, umugqa-omusha.
}, qala.





