>> map1 := Isichazamazwi okusha.
>> key1 := Uhlu okusha.
>> key2 := Uhlu okusha.

map1
	beka: ['hello'] endaweni: key1,
	beka: ['world'] endaweni: key2.


Okuphumayo
	bhala: ['Map #1 contains: '] + (map1 endaweni: key1),
	bhala: [' and '] + (map1 endaweni: key2), umugqa-omusha.

>> KeyeableArray := Uhlu okusha.
KeyeableArray uma-kufika: ['toString'] yenza: { <- (uqobo inani) toString.
}.

>> map2 := Isichazamazwi okusha.
key1 := KeyeableArray okusha.
key2 := KeyeableArray okusha.

key1 engeza-ekugcineni: 1.

map2
	beka: ['hello'] endaweni: key1,
	beka: ['world'] endaweni: key2.

Okuphumayo
	bhala: ['Map #2 contains: '] + (map2 endaweni: key1),
	bhala: [' and '] + (map2 endaweni: key2), umugqa-omusha.
