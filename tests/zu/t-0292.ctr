>> winery := { <- (	Isichazamazwi okusha
		beka: 2 endaweni: ['merlot'],
		beka: 3 endaweni: ['malbec'],
		beka: 4 endaweni: ['syrah']
	).
}.

Okuphumayo bhala: (((winery qala) - ['nothing']) inani), umugqa-omusha.
Okuphumayo bhala: (((winery qala) - ['merlot']) inani), umugqa-omusha.
Okuphumayo bhala: (((winery qala) - ['malbec']) inani), umugqa-omusha.
Okuphumayo bhala: (((winery qala) - ['syrah']) inani), umugqa-omusha.
Okuphumayo bhala: (((winery qala) - ['merlot'] - ['malbec']) inani), umugqa-omusha.
Okuphumayo bhala: (((winery qala) - ['merlot'] - ['syrah']) inani), umugqa-omusha.
Okuphumayo bhala: (((winery qala) - ['malbec'] -['syrah']) inani), umugqa-omusha.
Okuphumayo bhala: (((winery qala) - ['malbec'] - ['syrah'] - ['merlot']) inani), umugqa-omusha.

