# test Program version

# this feature is disabled by default
Okuphumayo bhala: (
	Uhlelo isici: 
	['RECURSIVE_STRINTPOL']
), umugqa-omusha.


# but if we set the time back
>> today := Isikhathi 
indawo-yesikhathi: ['CEST'],
umthombo: ['2026-02-15 10:00:00'].
Uhlelo inguqulo: today.

# it will be enabled like it used to be (from now on)
Okuphumayo bhala: (
	Uhlelo isici: 
	['RECURSIVE_STRINTPOL']
), umugqa-omusha.