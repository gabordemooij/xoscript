>> Grandfather := Into okusha.
Grandfather uma-kufika: ['greet'] yenza: {
	Okuphumayo bhala: ['Ave!'], umugqa-omusha.
}.
>> Father := Grandfather okusha.
Father uma-kufika: ['greet'] yenza: {
	Okuphumayo bhala: ['Hello'], umugqa-omusha.
	uqobo greet.
}.
>> Son := Father okusha.
Son uma-kufika: ['greet'] yenza: {
	Okuphumayo bhala: ['Hi'], umugqa-omusha.
	uqobo greet.
}.

Son greet.

>> Roundabout := Into okusha.
Roundabout uma-kufika: ['circle:'] yenza: { :x
	Okuphumayo bhala: x, umugqa-omusha.
	(x < 3) iqiniso: { uqobo ukuziphinda circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) iqiniso: { Okuphumayo bhala: x, umugqa-omusha. x engeza: 1.  increment qala. }. }.
increment qala.