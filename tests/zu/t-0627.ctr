

# create a 64-bit integer for exact calculations
>> a := Int64 kusuka-embhalweni: ['123'].

# to string
Okuphumayo bhala: a, umugqa-omusha.

# divide
Okuphumayo bhala: a / (Int64 kusuka-embhalweni: ['3']), umugqa-omusha.

# multiply
Okuphumayo bhala: a * (Int64 kusuka-embhalweni: ['2']), umugqa-omusha.

# add
Okuphumayo bhala: a + (Int64 kusuka-embhalweni: ['1']), umugqa-omusha.

# subtract
Okuphumayo bhala: a - (Int64 kusuka-embhalweni: ['2']), umugqa-omusha.

# compare
Okuphumayo bhala: ( a =   (Int64 kusuka-embhalweni: ['123'])), umugqa-omusha.
Okuphumayo bhala: ( a !=: (Int64 kusuka-embhalweni: ['124'])), umugqa-omusha.
Okuphumayo bhala: ( a <   (Int64 kusuka-embhalweni: ['124'])), umugqa-omusha.
Okuphumayo bhala: ( a >   (Int64 kusuka-embhalweni: ['122'])), umugqa-omusha.
Okuphumayo bhala: ( a >=: (Int64 kusuka-embhalweni: ['123'])), umugqa-omusha.
Okuphumayo bhala: ( a <=: (Int64 kusuka-embhalweni: ['123'])), umugqa-omusha.





	