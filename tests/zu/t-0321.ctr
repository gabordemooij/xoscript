# test qualifiers

Uhlelo hlanza.

>> Fruit := Into okusha.
Fruit uma-kufika: ['okusha'] yenza: {
	>> f := uqobo okusha.
	f apples: 0. <- f.
}.
Fruit uma-kufika: ['apples:'] yenza: { :a okwakho apples := a. }.
Fruit uma-kufika: ['apples'] yenza: { <- okwakho apples. }.
Fruit uma-kufika: ['+'] yenza: { :f
	>> n := Fruit okusha.
	n apples: (f apples + okwakho apples). <- n.
}.
Inombolo uma-kufika: ['apples'] yenza: { <- ((Fruit okusha) apples: uqobo).
}.

Fruit uma-kufika: ['umbhalo'] yenza: { <- okwakho apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Okuphumayo bhala: q, umugqa-omusha.




q := 3 apples + 4 apples.
Okuphumayo bhala: q, umugqa-omusha.



q := 3 apples + 4 apples.
Okuphumayo bhala: q, umugqa-omusha.


