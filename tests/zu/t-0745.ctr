Okuphumayo bhala: ['Test object'], umugqa-omusha.
>> a := Into okusha. 

a uma-kufika: ['item:'] yenza: { :dict
	okwakho dict := dict. 
}.

a uma-kufika: ['item'] yenza: { <- okwakho dict.
}.

a item: (
Isichazamazwi okusha
	hello: ['world']).

>> old-dict-address := a item isibonelo-sokuqala ikheli-lenkumbulo.
a save-as: ['/tmp/a.bin'].
Okuphumayo bhala: ['========== RELOADING SNAP:'], umugqa-omusha.

>> b := Into load-from: ['/tmp/a.bin'].

(b item isibonelo-sokuqala ikheli-lenkumbulo = old-dict-address) iqiniso: {
	Okuphumayo bhala: ['Object link re-attached.'], umugqa-omusha.
}.

Okuphumayo bhala: b item, umugqa-omusha.
