


>> wine := Into okusha.


wine uma-kufika: ['toString'] yenza: { <- ['merlot'].
}.

wine uma-kufika: ['naarTekst'] yenza: { <- ['merlot'].
}.


wine uma-kufika: ['='] yenza: { :other wine <- ( uqobo toString = other wine ).
}.

wine uma-kufika: ['=='] yenza: { :other wine <- ( uqobo toString = other wine ).
}.



wine
	uma-kunjalo: ['cabernet'] yenza: { Okuphumayo bhala: ['it's a Cabernet!']. },
	uma-kunjalo: ['syrah']    yenza: { Okuphumayo bhala: ['it's a Syrah!'].    },
	uma-kunjalo: ['merlot']   yenza: { Okuphumayo bhala: ['it's a Merlot!'].   },
	uma-kunjalo: ['malbec']   yenza: { Okuphumayo bhala: ['it's a Malbec!'].   }.

Okuphumayo umugqa-omusha.
