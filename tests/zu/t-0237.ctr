
Umbhalo uma-kufika: ['evaluate'] yenza: {
	>> ikhodi := Ifayela okusha: ['/tmp/eval.ctr'].
	ikhodi bhala: (uqobo umbhalo + ['.']).
	Uhlelo sebenzisa: ['/tmp/eval.ctr'].
}.

>> map :=
	(Isichazamazwi okusha)
	beka: ['Hi There'] endaweni: ['two'],
	beka: (Uhlu ← ['hello'] ; ['world'] ; (Uhlu ← 1 ; 2; 9) ; Amanga) endaweni: ['one'],
	beka: ( (Isichazamazwi okusha) beka: ['wrrld'] endaweni: ['misspelled'] ) endaweni: ['three'],
	beka: (Uhlu ← ((Isichazamazwi okusha) beka: ['treasure'] endaweni: ['hidden']) ; 2) endaweni: ['four']. 
>> str := map umbhalo.
>> map2 := Lutho.
(['map2 := '] + str ) evaluate.
Okuphumayo bhala: map2 ? ['one'] ? 0.
Okuphumayo bhala: map2 ? ['one'] ? 1.
Okuphumayo bhala: map2 ? ['four'] ? 0 ? ['hidden'].
Okuphumayo bhala: map2 ? ['one'] ? 2 ? 2.
