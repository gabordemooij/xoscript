>> Slurp := Into okusha.
Slurp uma-kufika: ['okusha'] yenza: {
	okwakho str := [''].
}.
Slurp funda: ['nieuw'] kusho: ['okusha'].
Slurp uma-kufika: ['phendula:'] yenza: { :blah
		(okwakho str ≠ ['']) iqiniso: {
			okwakho str engeza-ekugcineni: [' '].
		}.
		okwakho str engeza-ekugcineni: blah.
}.
Slurp uma-kufika: ['phendula:futhi:'] yenza: { :blah :blahah
		(okwakho str ≠ ['']) iqiniso: {
			okwakho str engeza-ekugcineni: [' '].
		}.
		(blah ubude > 1) iqiniso: {
			okwakho str engeza-ekugcineni: (blah kusuka: 0 ubude: (blah ubude - 1)).
		}, uma-kungenjalo: {
			okwakho str engeza-ekugcineni: blah.
		}.
		okwakho str engeza-ekugcineni: [' '].
		okwakho str engeza-ekugcineni: blahah.
}.
Slurp uma-kufika: ['obtain'] yenza: {
	>> buffer := okwakho str.
	okwakho str := ['']. <- buffer.
}.


>> amapharamitha-okusesha := Slurp okusha
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

Okuphumayo bhala: amapharamitha-okusesha obtain, umugqa-omusha.
