

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Uhlelo ukuphathwa-kwenkumbulo: 0.

Inombolo uma-kufika: ['addNum:'] yenza: { :x
	uqobo engeza: x.
}.

Inombolo uma-kufika: ['subtractNum:'] yenza: { :x
	uqobo khipha: x.
}.

Inombolo uma-kufika: ['multiplyBy:'] yenza: { :x
	uqobo phindaphinda-ngo: x.
}.

Inombolo uma-kufika: ['divideBy:'] yenza: { :x
	uqobo hlukanisa-ngo: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 amandla-enombolo: 8).  
a := a + (2 amandla-enombolo: -1). 
a := a + (49 impande-yesikwele).   
a addNum: ((Uhlu ← 0 ; 1) ubukhulu).          
a addNum: ((Uhlu ← 2 ; 3) ubuncane).
Okuphumayo bhala: a.

Uhlelo hlanza.

usedMemory1 := (Uhlelo inkumbulo ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 amandla-enombolo: 8).  
a := a + (2 amandla-enombolo: -1). 
a := a + (49 impande-yesikwele).   
a addNum: ((Uhlu ← 0 ; 1) ubukhulu).          
a addNum: ((Uhlu ← 2 ; 3) ubuncane).
Okuphumayo bhala: a.

Uhlelo hlanza.
usedMemory2 := (Uhlelo inkumbulo ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 amandla-enombolo: 8).  
a := a + (2 amandla-enombolo: -1). 
a := a + (49 impande-yesikwele).   
a addNum: ((Uhlu ← 0 ; 1) ubukhulu).          
a addNum: ((Uhlu ← 2 ; 3) ubuncane).
Okuphumayo bhala: a.

Uhlelo hlanza.
usedMemory3 := (Uhlelo inkumbulo ? 0).



( usedMemory1 = usedMemory2 futhi: usedMemory1 = usedMemory3, futhi: usedMemory2 = usedMemory3 ) iqiniso: {
	Okuphumayo bhala: ['No memory leaks here'].
}, amanga: {
	Okuphumayo bhala: ['Leaking memory...'].
}.
