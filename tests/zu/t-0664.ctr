# recursive interpolation not allowed

Okuphumayo bhala: 
['recursive string interolation enabled: '] + (
	Uhlelo isici: 
	['RECURSIVE_STRINTPOL']
), umugqa-omusha.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Okuphumayo bhala: a, umugqa-omusha.


