
>> a := Uhlu ← (Uhlu ← 100 ; 200 ; 300) ; (Uhlu ← 9 ; 8 ; 7).
Okuphumayo bhala: ['at 0,1 :'].
Okuphumayo bhala: a ? 0 ? 1, umugqa-omusha. 
Okuphumayo bhala: ['at 1,2 :'].
Okuphumayo bhala: a ? 1 ? 2, umugqa-omusha. 
>> menu := Isichazamazwi okusha.
menu beka: (Uhlu ← ['pizza'] ; ['spaghetti']) endaweni: ['Italian Cuisine'].
menu beka: (Uhlu ← ['bifteki'] ; ['suflaki']) endaweni: ['Greek Cuisine'].
Okuphumayo bhala: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), umugqa-omusha. 
Okuphumayo bhala: ['but not on the same plate.'], umugqa-omusha.
