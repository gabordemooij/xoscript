# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Uhlelo shell-escape: ['abc'].
Okuphumayo bhala: c, umugqa-omusha.
Okuphumayo bhala: ( Uhlelo isistimu: ['echo '] + c ), umugqa-omusha.

c := Uhlelo shell-escape: ['a'b'c'].
Okuphumayo bhala: c, umugqa-omusha.
Okuphumayo bhala: ( Uhlelo isistimu: ['echo '] + c ), umugqa-omusha.

c := Uhlelo shell-escape: ['a\'c'].
Okuphumayo bhala: c, umugqa-omusha.
Okuphumayo bhala: ( Uhlelo isistimu: ['echo '] + c ), umugqa-omusha.