# test list operations


>> cakes := Uhlu ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes buyisela: 1 ubude: 2 nge: ( Uhlu ← ['cinnamon'] ; ['pineapple'] ).
Okuphumayo bhala: (buy hlanganisa: [',']), umugqa-omusha.


>> buy := cakes buyisela: 1 ubude: 12 nge: ( Uhlu ← ['cinnamon'] ; ['pineapple'] ).
Okuphumayo bhala: (buy hlanganisa: [',']), umugqa-omusha.


>> buy := cakes buyisela: 2 ubude: 10 nge: ( Uhlu okusha ).
Okuphumayo bhala: (buy hlanganisa: [',']), umugqa-omusha.


>> buy := cakes buyisela: 0 ubude: 1 nge: ( Uhlu okusha ).
Okuphumayo bhala: (buy hlanganisa: [',']), umugqa-omusha.


>> buy := cakes buyisela: ['0'] ubude: ['1'] nge: ['x'].
Okuphumayo bhala: (buy hlanganisa: [',']), umugqa-omusha.
