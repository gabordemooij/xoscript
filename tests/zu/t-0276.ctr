>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Into okusha.
⚄ uma-kufika: ['drawFrom:length:'] yenza: { :pool :inani
	
	>> result := [''].
	
	{
		>> index := Inombolo random % (pool ubude).
		result engeza-ekugcineni: ( pool uhlamvu: (index + 1) ).
		
	} × inani. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? ubude.
Okuphumayo bhala: (['x↵'] x random ubude).
Okuphumayo bhala: (['y↵'] y ?? ubude).

