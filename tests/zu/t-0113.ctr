Okuphumayo bhala: ['Continue for-loop, No - before 6 and up.'], umugqa-omusha.
{ :i
	Okuphumayo bhala: (i + 1), umugqa-omusha.
	((i + 1) > 4) qhubeka.
	Okuphumayo bhala: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Okuphumayo umugqa-omusha.
Okuphumayo bhala: ['Continue while-true, No --> before 5 and up.'], umugqa-omusha.
{
	Okuphumayo bhala: ['iteration #'] + x, umugqa-omusha.
	x engeza: 1.
	((x < 5) hhayi) qhubeka.
	Okuphumayo bhala: ['-->'].
} ngenkathi: xIsLessThan10.
Okuphumayo umugqa-omusha.
Okuphumayo bhala: ['Continue while-false, No - before 3 only.'], umugqa-omusha.
{
	Okuphumayo bhala: ['iteration #'] + x, umugqa-omusha.
	x khipha: 1.
	(x = 3) qhubeka.
	Okuphumayo bhala: ['-'].
} ngenkathi: { <- ( x > 0). }.

Okuphumayo umugqa-omusha.
Okuphumayo bhala: ['Continue times-loop, No ||| before 3.'], umugqa-omusha.
{ :i
	Okuphumayo bhala: ['iteration #'] + i, umugqa-omusha.
	(i = 2) qhubeka.
	Okuphumayo bhala: ['|||'].
} × 5.

Okuphumayo umugqa-omusha.

{ Iqiniso qhubeka. Okuphumayo bhala: ['dont write this!'], umugqa-omusha. } qala.

{ Iqiniso qhubeka. Okuphumayo bhala: ['dont write this!'], umugqa-omusha. } bamba: { Okuphumayo bhala: ['Dont catch this!']. }, qala.

Okuphumayo bhala: ['Test Array each-loop: 0, ... ,2'], umugqa-omusha.
(Uhlu ← 1 ; 2 ; 3) guqula-ngakunye: { :i
	(i = 1) qhubeka.
	Okuphumayo bhala: ['iteration #'] + (i - 0), umugqa-omusha.
}.

Okuphumayo bhala: ['Test Map each-loop: c only'], umugqa-omusha.
>> m := Isichazamazwi okusha.
m beka: ['first'] endaweni: ['a'], beka: ['second'] endaweni: ['b'], beka: ['third'] endaweni: ['c'].
m ngamunye: { :k :v
	(k ≠ ['c']) qhubeka.
	Okuphumayo bhala: ['iteration'] + k + v, umugqa-omusha.
}.

