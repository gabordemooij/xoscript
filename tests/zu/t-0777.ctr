#OBSD
>> dirname := [''].
{ dirname engeza-ekugcineni: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Uhlelo isistimu: command.
Uhlelo chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename engeza-ekugcineni: ['YYYYYYYY']. } * 20.
Ifayela okusha: filename, bhala: ['sometext'].
{ Ifayela uhlu: ['/tmp/'] + dirname. } * 1000.
Okuphumayo bhala: ['no crash'], umugqa-omusha.

