Server init.

>> DB := Maria-DB okusha umsingathi: ['localhost'],
	igama-lomsebenzisi: ['xo'],
	iphasiwedi: ['pass123'],
	igama-lesizindalwazi: ['xobase'],
	xhumana.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> amapharamitha-okusesha := Umbuzo-Maria okusha: SQL.

# set database
amapharamitha-okusesha isizindalwazi: DB.

amapharamitha-okusesha landa: { :row
	Okuphumayo bhala: row world, umugqa-omusha.
}.
