Server init.
>> fmt := Ifomethi okusha: ['%#3x'].

>> blob := Blob okusha: 4.
blob bytes: ( 
	Uhlu okusha ; 0 ; 1 ; 2 ; 3
).

>> file := Ifayela okusha: ['/tmp/blob'].
file blob: blob.
blob khulula.

>> funda := file blob.
funda 
kusuka: 0 
ubude: 4, 
yenza ngamunye: { :i :b 
	Okuphumayo
	bhala: (fmt sebenzisa-kunombolo-ephelele: b),
	umugqa-omusha.
}.
funda khulula.
