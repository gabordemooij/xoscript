# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Uhlelo isilungiselelo: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server xhuma: ( Uhlu okusha ;
 libname ; ['fopen'] ;
 ( Uhlu okusha ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
xhuma: ( Uhlu okusha ;
 Lutho ; # means same lib
 ['fread'] ;
 ( Uhlu okusha ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Lutho ; # means same object (i.e. Stream)
 ['fread']
),
xhuma: (
 Uhlu okusha ;
 Lutho ; # means same lib
 ['fwrite'] ;
 ( Uhlu okusha ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Lutho ; # means same lib
 ['fwrite']
),
xhuma: (
 Uhlu okusha ;
 Lutho ; # means same lib
 ['rewind'] ;
 ( Uhlu okusha ; ['pointer'] ) ;
 ['int'] ;
 Lutho ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> indlela-yefayela := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: indlela-yefayela mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream umyalezo: ['fwrite'] okufakwayo: (Uhlu okusha ; str ; 1 ; 6 ; fd ).
Okuphumayo bhala: bytes-written, umugqa-omusha.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob okusha: 20.

# read from file
>> bytes-read := Stream umyalezo: ['fread'] okufakwayo: (Uhlu okusha ; buf ; 1 ; 6 ; fd ).
Okuphumayo bhala: bytes-read, umugqa-omusha.
Okuphumayo bhala: buf, umugqa-omusha.

# free memory
str  khulula.
indlela-yefayela khulula.
mode khulula.
buf  khulula.


