


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Uhlelo ukuphathwa-kwenkumbulo: 0.
>> palette := Lutho.
>> colors := Lutho.

{
palette := Isichazamazwi okusha.
palette 
	beka: ['#F00'] endaweni: ['red'],
	beka: ['#0F0'] endaweni: ['green'],
	beka: ['#00F'] endaweni: ['blue'].
Okuphumayo bhala: ['number of RGB codes in palette: '] + ( palette inani ), umugqa-omusha.
Okuphumayo bhala: ['RGB code of green is: '] + ( palette ? ['green'] ), umugqa-omusha.
colors := [''].
( palette ngamunye: { :igama :ikhodi
		colors := colors + ( igama + [':'] + ikhodi ).
} ).
Okuphumayo bhala: ['All colors in palette: '] + colors, umugqa-omusha.
} qala.
Uhlelo hlanza.
usedMemory1 := (Uhlelo inkumbulo ? 0).

