

Uhlelo ukuphathwa-kwenkumbulo: 1.

>> x := 0.
>> y := ['Hello'].
>> q := { ['']. }.
>> p := Iqiniso.
>> a := Uhlu ← 1 ; 2 ; 3 ; 4.
>> c := Into okusha.
c uma-kufika: ['greet:'] yenza: { Okuphumayo bhala: ['greet!']. }.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.
>> usedMemory5 := 0.

Uhlelo hlanza.
>> usedMemory1 := (Uhlelo inkumbulo ? 0).




x := 1.
y := ['Hello'].
q := { ['']. }.
p := Iqiniso.
a := Uhlu ← 1 ; 2 ; 3 ; 5.
c := Into okusha.
c uma-kufika: ['greet:'] yenza: { Okuphumayo bhala: ['greet!']. }.


Uhlelo hlanza.
>> usedMemory2 := (Uhlelo inkumbulo ? 0).




