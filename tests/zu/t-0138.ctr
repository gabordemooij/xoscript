x := 3.
y := ['Hello'].
q := { ['']. }.
p := Iqiniso.
a := Uhlu ← 1 ; 2 ; 3 ; 5.
c := Into okusha.
c uma-kufika: ['greet:'] yenza: { Okuphumayo bhala: ['greet!']. }.
c := Into okusha.
c uma-kufika: ['greet:'] yenza: { Okuphumayo bhala: ['a different greet!'], umugqa-omusha. }.


Uhlelo hlanza.
>> usedMemory4 := (Uhlelo inkumbulo ? 0).





x := 4.
y := ['Hello'].
q := { ['']. }.
p := Iqiniso.
