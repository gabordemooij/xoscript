# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> indlela-yefayela := ['/tmp/dat.csv'].
>> csv := Ifayela okusha: indlela-yefayela.
csv bhala: s.

# accepts CRLF LF CR, varying row length
csv isihlukanisi: [';'] isicaphuni: ['"'] imigqa: { :line
	Uhlelo hlanza.
	Okuphumayo bhala: line, umugqa-omusha.
	Uhlelo hlanza.
}.

# unequal lines
s engeza-ekugcineni: ['\njustone'].
csv bhala: s.
{
	csv isihlukanisi: [';'] isicaphuni: ['"'] imigqa: { :line
		Okuphumayo bhala: line, umugqa-omusha.
	}.
} bamba: { :e 
	Okuphumayo bhala: e, umugqa-omusha.
}, qala.

# invalid format
s := ['"he"llo";world'].
csv bhala: s.
{
	csv isihlukanisi: [';'] isicaphuni: ['"'] imigqa: { :line
		Okuphumayo bhala: line, umugqa-omusha.
	}.
} bamba: { :e 
	Okuphumayo bhala: e, umugqa-omusha.
}, qala.
