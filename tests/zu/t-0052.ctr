>> items := Isichazamazwi okusha.
items beka: ['green'] endaweni: ['color-1'].
items beka: ['orange'] endaweni: ['color-2'].
items beka: ['red'] endaweni: ['color-3'].
>> i := 0.
>> s := [''].
items ngamunye: { :key :color
	Okuphumayo bhala: ['color #'] + i + [' is: '] + color + [' '].
	i engeza: 1.
}.
Okuphumayo bhala: i + [' colors!'].
