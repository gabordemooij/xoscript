# test url parsing

Server init.
>> url := URL umthombo: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Okuphumayo bhala: ['scheme = '] + url isikimu, umugqa-omusha.
Okuphumayo bhala: ['host = '] + url umsingathi, umugqa-omusha.
Okuphumayo bhala: ['port = '] + url imbobo, umugqa-omusha.
Okuphumayo bhala: ['path = '] + url indlela-yefayela, umugqa-omusha.
Okuphumayo bhala: ['query = '] + url amapharamitha-okusesha, umugqa-omusha.
Okuphumayo bhala: ['fragment = '] + url isiqephu, umugqa-omusha.
