(Lutho = Lutho) iqiniso: { Okuphumayo bhala: ['Nil is Nil!'].}.
(2 > 1) iqiniso: { Okuphumayo bhala: ['YES']. }.
(2 > 3) iqiniso: { Okuphumayo bhala: ['NO']. }.
(2 > 3) amanga: { Okuphumayo bhala: ['Nonono..'].}.
Iqiniso iqiniso: { Okuphumayo bhala: ['TRUE is TRUE!']. }.
(Iqiniso) iqiniso: { Okuphumayo bhala: ['TRUE is TRUE!']. }.
Amanga amanga: { Okuphumayo bhala: ['FALSE is FALSE!']. }.
(Amanga) amanga: { Okuphumayo bhala: ['FALSE is FALSE!']. }.
