
>> countries := Uhlu okusha
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Uhlu okusha
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods ngokwe: countries, ngamunye: { :key :value
	counter engeza: 1.
}.

Okuphumayo bhala: (['we serve counter dishes'] counter: counter), umugqa-omusha.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] izinhlamvu hlela: { :v
	counter engeza: 0.
}.

Okuphumayo bhala: (['we sort counter dishes'] counter: counter), umugqa-omusha.


>> counter := 0.
{
	{
		counter engeza: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Okuphumayo bhala: (['we calculate counter numbers.'] counter: counter), umugqa-omusha.

