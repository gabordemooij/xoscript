
Okuphumayo bhala: ['Break for-loop, 0-4.'], umugqa-omusha.
{ :i
	Okuphumayo bhala: ['iteration #'] + i, umugqa-omusha.
	(i = 4) nqamula.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Okuphumayo bhala: ['Break while-true loop, 0-4.'], umugqa-omusha.
{
	Okuphumayo bhala: ['iteration #'] + x, umugqa-omusha.
	x engeza: 1.
	((x < 5) hhayi) nqamula.
} ngenkathi: xIsLessThan10.

Okuphumayo bhala: ['Break while-false loop, 5,4.'], umugqa-omusha.
{
	Okuphumayo bhala: ['iteration #'] + x, umugqa-omusha.
	x khipha: 1.
	(x = 3) nqamula.
} ngenkathi: { <- (x > 0). }.

Okuphumayo bhala: ['Break times loop, 1-4.'], umugqa-omusha.
{ :i
	Okuphumayo bhala: ['iteration #'] + i, umugqa-omusha.
	(i = 4) nqamula.
} × 5.

Okuphumayo bhala: ['Break block, dont print line.'], umugqa-omusha.
{ Iqiniso nqamula. Okuphumayo bhala: ['dont write this!'], umugqa-omusha. } qala.

Okuphumayo bhala: ['Break block, dont fire catch...'], umugqa-omusha.
{ Iqiniso nqamula. Okuphumayo bhala: ['dont write this!'], umugqa-omusha. } bamba: { Okuphumayo bhala: ['Dont catch this!']. }, qala.

Okuphumayo bhala: ['Test Array each-loop: 0,1'], umugqa-omusha.
(Uhlu ← 1 ; 2 ; 3) guqula-ngakunye: { :i
	Okuphumayo bhala: ['iteration #'] + i, umugqa-omusha.
	(i = 1) nqamula.
}.

Okuphumayo bhala: ['Test Map each-loop: c only'], umugqa-omusha.
>> m := Isichazamazwi okusha.
m beka: ['first'] endaweni: ['a'], beka: ['second'] endaweni: ['b'], beka: ['third'] endaweni: ['c'].
m ngamunye: { :k :v
	Okuphumayo bhala: ['iteration'] + v + k, umugqa-omusha.
	Iqiniso nqamula.
}.

