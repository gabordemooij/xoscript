Okuphumayo bhala: ['Test object'], umugqa-omusha.
>> cmd := Umyalo okusha.
Okuphumayo bhala: cmd ls /tmp, umugqa-omusha.
>> old-cmd-address := cmd isibonelo-sokuqala ikheli-lenkumbulo.
cmd save-as: ['/tmp/a.bin'].
Okuphumayo bhala: ['========== RELOADING SNAP:'], umugqa-omusha.
>> b := Into load-from: ['/tmp/a.bin'].
(b isibonelo-sokuqala ikheli-lenkumbulo = old-cmd-address) iqiniso: {
	Okuphumayo bhala: ['Object link re-attached.'], umugqa-omusha.
}.
Okuphumayo bhala: b ls, umugqa-omusha.


