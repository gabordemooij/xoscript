
>> Size := Into okusha.
Size uma-kufika: ['is:'] yenza: { :inombolo
	inombolo uma-kufika: ['+'] yenza: { :inombolo
		>> unit := inombolo iyunithi-yenombolo.
		>> factor := 1.
		
		unit
		uma-kunjalo: ['inch'] yenza: { factor := 0.0833. }. <- uqobo + (inombolo * factor).
	}. <- inombolo.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Okuphumayo bhala: plank + edge, umugqa-omusha.
