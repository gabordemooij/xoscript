>> To-Do := Into okusha.

To-Do uma-kufika: ['okusha'] yenza: {
	okwakho list := Uhlu okusha.
}.

To-Do uma-kufika: ['nieuw'] yenza: {
	okwakho list := Uhlu okusha.
}.

To-Do uma-kufika: ['+'] yenza: { :task
	okwakho list engeza-ekugcineni: task.
}.

To-Do uma-kufika: ['number of tasks?'] yenza: { <-  okwakho list inani.
}.

>> todos := 
	To-Do okusha 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Okuphumayo bhala: ['You have $ tasks to do'] $ todos number of tasks?.
