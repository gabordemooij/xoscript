Server init.

>> db := Maria-DB okusha umsingathi: ['localhost'],
	igama-lomsebenzisi: ['xo'],
	iphasiwedi: ['pass123'],
	igama-lesizindalwazi: ['xobase'],
	xhumana.

>> del := db umbuzo: ['DELETE FROM book WHERE id > 0'].
{  del enza-umyalo. db qinisekisa. } bamba: { :e db buyisela-emuva.  }, qala.

>> inani := db umbuzo: ['SELECT COUNT(*) AS num FROM book'].
inani landa: { :row Okuphumayo bhala: row num, umugqa-omusha. }.
