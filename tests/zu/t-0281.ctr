>> q := Uhlu ← 1 ; 2 ; 3.
{ q ? ['1']. } bamba: { Okuphumayo bhala: ['caught!'], umugqa-omusha. }, qala.
{ q ? Iqiniso. } bamba: { Okuphumayo bhala: ['caught!'], umugqa-omusha. }, qala.
{ q ? Amanga. } bamba: { Okuphumayo bhala: ['caught!'], umugqa-omusha. }, qala.
{ q ? Lutho. } bamba: { Okuphumayo bhala: ['caught!'], umugqa-omusha. }, qala.
{ q ? (Uhlu okusha). } bamba: { Okuphumayo bhala: ['caught!'], umugqa-omusha. }, qala.
{ q ? (Into okusha). } bamba: { Okuphumayo bhala: ['caught!'], umugqa-omusha. }, qala.
{ q ? ({ ['Empty']. }). } bamba: { Okuphumayo bhala: ['caught!'], umugqa-omusha. }, qala.
Okuphumayo bhala: ['caught them all'], umugqa-omusha.
