

Uhlu uma-kufika: ['fixture:'] yenza: { :f
	okwakho fixture := f.
}.

Uhlu uma-kufika: ['inani'] yenza: { <- okwakho fixture.
}.

Uhlu uma-kufika: ['aantal'] yenza: { <- okwakho fixture.
}.


>> x := Lutho.
{

	x := ['hello'] 
	buyisela:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] uhlamvu: 2)
			)
		)
	nge: (
		(['...hal'] + ['lo']) 
			osonhlamvukazi 
			lowecase 
			osonhlamvukazi 
			yeqa: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Uhlu ← 0 ; 1 ; 4; 9 ; (Uhlu ← 0 ; 3; 1) ; 4
							) ngaphambi-kokokugcina
						) ? 1
					) + 
					((Uhlu ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					inani
				)
			)
	).

} × 10.
Okuphumayo bhala: x, umugqa-omusha.

