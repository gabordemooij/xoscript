

>> Matryoshka := Into okusha.
Matryoshka uma-kufika: ['double:'] yenza: { :secret
	okwakho secret := secret × 2.
}.
Matryoshka uma-kufika: ['okusha:'] yenza: { :secret
	>> answer := Lutho.
	>> t := (secret > 255).
	Okuphumayo bhala: (secret + [' | '] + t), umugqa-omusha.
	t iqiniso: {
		answer := secret.
	}, uma-kungenjalo: {
		answer := Matryoshka ukuziphinda okusha: (uqobo double: secret).
	}. <- answer.
}.

>> x := Matryoshka okusha: 2.
