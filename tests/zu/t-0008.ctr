>> Greeter := Into okusha.
Greeter uma-kufika: ['make'] yenza: {
	>> greeter := Into okusha.
	greeter uma-kufika: ['name:'] yenza: { :igama
		Okuphumayo bhala: ['setting a name'].
		okwakho myName := igama.
	}.
	greeter uma-kufika: ['greet'] yenza: {
		Okuphumayo bhala: ['Hello'].
		Okuphumayo bhala: okwakho myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
