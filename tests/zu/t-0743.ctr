>> V := Into.
V uma-kufika: ['umbhalo'] yenza: {
	Okuphumayo bhala: ['cast'], umugqa-omusha. <- ['abc'].
}.

Okuphumayo bhala: ( Uhlelo isilungiselelo: ['abc'] ), umugqa-omusha.

# params should not get gc'ed
Uhlelo isilungiselelo: ([''] + V okusha) inani: ([''] + V okusha).

Okuphumayo bhala: ( Uhlelo isilungiselelo: ['abc'] ), umugqa-omusha.
