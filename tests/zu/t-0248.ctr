

Umbhalo uma-kufika: ['evaluate'] yenza: {
	>> ikhodi := Ifayela okusha: ['/tmp/eval.ctr'].
	ikhodi bhala: uqobo umbhalo + ['.'].
	Uhlelo sebenzisa: ['/tmp/eval.ctr'].
}.

>> a := (Uhlu ← (
	(Isichazamazwi okusha)
		beka: ['domain'] endaweni: ['mywebsite.com'],
		beka: (Uhlu ←
			((Isichazamazwi okusha)
				beka: ['home'] endaweni: ['title'],
				beka: ['<html></html>'] endaweni: ['body'],
				beka: ['2017-01-01'] endaweni: ['created']
			) ;
			((Isichazamazwi okusha)
				beka: ['aboutus(c)'] endaweni: ['title'],
				beka: ['<credits>Author Inc.</credits>'] endaweni: ['body']
			)
		) endaweni: ['pages']
	)
) umbhalo.

Okuphumayo bhala: a uhlobo, umugqa-omusha.
Okuphumayo bhala: a, umugqa-omusha.

>> b := Lutho.
(['b := '] + a) evaluate.
Okuphumayo bhala: b ? 0 ? ['pages'] ? 1 ? ['body'], umugqa-omusha.

>> c := b ? 0.
>> d := c umbhalo.
Okuphumayo bhala: d uhlobo, umugqa-omusha.

>> e := Lutho.
(['e := '] + d) evaluate.
Okuphumayo bhala: e ? ['pages'] ? 0, umugqa-omusha.
