


>> CoffeeMachine := Into okusha.
CoffeeMachine uma-kufika: ['order:'] yenza: { :id
	>> coffee := ['Americano'].
	( id = 1 ) iqiniso: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) iqiniso: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) iqiniso: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Into okusha.
SimpleCoffeeMachine uma-kufika: ['order'] yenza: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Okuphumayo bhala: redCup, umugqa-omusha.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Okuphumayo bhala: greenCup, umugqa-omusha.
>> yellowCup := CoffeeMachine order: 1.
Okuphumayo bhala: yellowCup, umugqa-omusha.
>> blueCup := CoffeeMachine order: 0.
Okuphumayo bhala: blueCup, umugqa-omusha.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Okuphumayo bhala: blackCup, umugqa-omusha.
blackCup engeza-ekugcineni: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Okuphumayo bhala: orangeCup, umugqa-omusha.
