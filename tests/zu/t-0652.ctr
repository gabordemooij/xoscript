# test number -> string -> number
{

	>> x := Inombolo phakathi: 0 no: 1000000.
	>> d := Inombolo phakathi: 1 no: 7.
	>> e := 10 amandla-enombolo: d.

	x hlukanisa-ngo: e.
	>> y := x umbhalo inombolo.

	(x = y) amanga: {
		Okuphumayo bhala: x, umugqa-omusha.
		Okuphumayo bhala: y, umugqa-omusha.
		Uhlelo qeda.
	}.

} * 1000.
Okuphumayo bhala: ['OK'], umugqa-omusha.