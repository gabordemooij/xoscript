Server init.

Okuphumayo bhala: (
	Iphethini okusha: ['^\\w+$'],
	ukufana: ['test@example.com'] 
), umugqa-omusha. # 0 match, fails on @ and .

Okuphumayo bhala: (
	Iphethini okusha: ['^[^@]+@[^\.]+\.\\w+$'],
	ukufana: ['test@example.com'] 
), umugqa-omusha. # 1 match

Okuphumayo bhala: (
	Iphethini okusha: ['[^@]+@[^\.]+\.\\w+'],
	ukufana: ['test@example.com'] 
), umugqa-omusha. # 1 match

Okuphumayo bhala: (
	Iphethini okusha: ['([^@]+)@([^\.]+)\.\\w+'],
	ukufana: ['test@example.com'] 
), umugqa-omusha. # 1 match, groups dont matter

Okuphumayo bhala: (
	Iphethini okusha: ['[a-z]'],
	ukufana: ['test@example.com'] 
), umugqa-omusha. # 14 matches

Okuphumayo bhala: (
	Iphethini okusha: ['.*'],
	ukufana: ['test@example.com'] 
), umugqa-omusha. # 1 match (all)

Okuphumayo bhala: (
	Iphethini okusha: ['(.*)'],
	ukufana: ['test@example.com'] 
), umugqa-omusha. # 1 match (all)

Okuphumayo bhala: (
	Iphethini okusha: ['\\s*[^@]+@[^\.]+\.\\w+'],
	ukufana: ['test@example.com'] 
), umugqa-omusha. # 1 match, prefix space optional, gets ignored