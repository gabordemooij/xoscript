>> invoice := Into okusha.
invoice uma-kufika: ['qala'] yenza: {
	okwakho inombolo := 0.
}.

invoice uma-kufika: ['inombolo'] yenza: {
	okwakho inombolo engeza: 1. <- okwakho inombolo kopisha.
}.


invoice qala.
Okuphumayo bhala: invoice inombolo, umugqa-omusha.
Okuphumayo bhala: invoice inombolo, umugqa-omusha.
