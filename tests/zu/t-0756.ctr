Okuphumayo bhala: ['Test object'], umugqa-omusha.
>> greeter := Into okusha.
greeter uma-kufika: ['name:'] yenza: { :igama
	okwakho xname := igama. 
}.
greeter uma-kufika: ['greet'] yenza: {
	Okuphumayo bhala: ['Hello '] + okwakho xname, umugqa-omusha.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Okuphumayo bhala: ['========== RELOADING SNAP:'], umugqa-omusha.
>> b := Into load-from: ['/tmp/a.bin'].
>> c := Into load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
