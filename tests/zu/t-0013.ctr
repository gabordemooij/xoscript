
>> Animal := Into okusha.
Animal uma-kufika: ['okusha'] yenza: { <- uqobo okusha init.
}.

Animal uma-kufika: ['init'] yenza: {
	okwakho sound := ['?'].
	okwakho legs := 4.
}.

>> Dog := Animal okusha.
Dog uma-kufika: ['init'] yenza: {
	uqobo init.
	okwakho sound := ['barks'].
}.

Animal uma-kufika: ['umbhalo'] yenza: { <- okwakho legs umbhalo + okwakho sound.
}.

>> poodle := Dog okusha.
Okuphumayo bhala: poodle, umugqa-omusha.

