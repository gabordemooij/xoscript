# test qualifiers

>> $ := Into okusha.

$ uma-kufika: ['phendula:'] yenza: { :x
	
	>> operation := x uhlamvu: 0.
	>> valuta := x uhlamvu: 1.
	>> money := x yeqa: 2.
	
	>> amount := 0.

	( operation = ['+'] ) iqiniso: {
		( valuta = ['£'] ) iqiniso: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Okuphumayo bhala: x, umugqa-omusha.


>> Fruit := Into okusha.

Fruit uma-kufika: ['okusha'] yenza: {
	>> f := uqobo okusha.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit uma-kufika: ['apples:'] yenza: { :a okwakho apples := a. }.
Fruit uma-kufika: ['oranges:'] yenza: { :p okwakho oranges := p. }.
Fruit uma-kufika: ['apples'] yenza: { <- okwakho apples. }.
Fruit uma-kufika: ['oranges'] yenza: { <- okwakho oranges. }.

Fruit uma-kufika: ['+'] yenza: { :f
	
	>> n := Fruit okusha.
	f engeza: 1.
	
	n apples: (f apples + okwakho apples).
	n oranges:  (f oranges  + okwakho oranges). <- n.
}.

Fruit uma-kufika: ['umbhalo'] yenza: { <- ( okwakho apples umbhalo + [' apples and '] + okwakho oranges + [' oranges'] ).
}.

Inombolo uma-kufika: ['apples'] yenza: { <- ((Fruit okusha) apples: uqobo).
}.

Inombolo uma-kufika: ['apple'] yenza: { <- ((Fruit okusha) apples: uqobo).
}.

Inombolo uma-kufika: ['oranges'] yenza: { <- ((Fruit okusha) oranges: uqobo).
}.




Okuphumayo bhala: (1 apple + 3 oranges + 4 apples), umugqa-omusha.


Umbhalo uma-kufika: ['twice'] yenza: { <- ((uqobo umbhalo) + (uqobo umbhalo)).
}.



Okuphumayo bhala: ['❤❤❤'] twice.



