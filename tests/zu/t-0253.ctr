#Linux
>> OS := Uhlelo isilungiselelo: ['OS'].

>> clock := Isikhathi okusha.
	
(OS = ['Haiku']) iqiniso: {
	clock indawo-yesikhathi: ['CET'],
	unyaka: 2017, inyanga: 7, usuku: 13,
	ihora: 18, umzuzu: 0, isekhondi: 0.
}, uma-kungenjalo: {
	clock indawo-yesikhathi: ['Europe/Amsterdam'],
	unyaka: 2017, inyanga: 7, usuku: 13,
	ihora: 18, umzuzu: 0, isekhondi: 0.
}.

clock uma-kufika: ['tell'] yenza: {
	Okuphumayo bhala: uqobo, umugqa-omusha.
}.


clock engeza: 2    ihora, tell.
clock engeza: 1    ihora, tell.
clock engeza: 19 umzuzu, tell.
clock engeza: 1  umzuzu, tell.
clock engeza: 1  umzuzu, tell.
clock engeza: 19 isekhondi, tell.
clock engeza: 1  isekhondi, tell.
clock engeza: 1  isekhondi, tell.
clock engeza: 2    unyaka, tell.
clock engeza: 1    unyaka, tell.

(OS = ['Haiku']) iqiniso: {
clock engeza: 5   inyanga.
clock indawo-yesikhathi: ['CEST'], tell.
}, uma-kungenjalo: {
	clock engeza: 5   inyanga, tell.
}.

clock engeza: 1   inyanga, tell.
clock engeza: 19    usuku, tell.
clock engeza: 1    ihora, tell.
clock engeza: 120  yard, tell.
