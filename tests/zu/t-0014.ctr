>> Greeter := Into okusha.
Greeter uma-kufika: ['make'] yenza: {
	>> gr := Into okusha.
	gr uma-kufika: ['setName:'] yenza: { :aname
		okwakho igama := aname.
	}.
	gr uma-kufika: ['greet'] yenza: {
		Okuphumayo bhala: okwakho igama.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a okusha.
c setName: ['THREE'].
c greet.
>> d := a okusha.
d setName: ['FOUR'].
d greet.
c greet.
