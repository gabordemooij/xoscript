#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Uhlelo ukuphathwa-kwenkumbulo: 0.

{
Isikhathi isikhathi.
Isikhathi linda: 1.
Okuphumayo bhala: Uhlelo inani-lokufakwayo, umugqa-omusha.
Uhlelo okufakwayo: 0.
Inombolo random.
Okuphumayo bhala: (Uhlelo isistimu: ['echo 'Hello'']).
} qala.

Uhlelo hlanza.
usedMemory1 := (Uhlelo inkumbulo ? 0).

{
Isikhathi isikhathi.
Isikhathi linda: 1.
Okuphumayo bhala: Uhlelo inani-lokufakwayo, umugqa-omusha.
Uhlelo okufakwayo: 0.
Inombolo random.
Okuphumayo bhala: (Uhlelo isistimu: ['echo 'Hello'']).
} qala.

Uhlelo hlanza.
usedMemory2 := (Uhlelo inkumbulo ? 0).

{
Isikhathi isikhathi.
Isikhathi linda: 1.
Okuphumayo bhala: Uhlelo inani-lokufakwayo, umugqa-omusha.
Uhlelo okufakwayo: 0.
Inombolo random.
Okuphumayo bhala: (Uhlelo isistimu: ['echo 'Hello'']).
} qala.

Uhlelo hlanza.
usedMemory3 := (Uhlelo inkumbulo ? 0).



( usedMemory1 = usedMemory2 futhi: usedMemory1 = usedMemory3, futhi: usedMemory2 = usedMemory3 ) iqiniso: {
	Okuphumayo bhala: ['No memory leaks here'].
}, amanga: {
	Okuphumayo bhala: ['Leaking memory...'].
}.
