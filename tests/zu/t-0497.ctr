Server init.

# write a test file
>> f := Ifayela okusha: ['/tmp/test.gif'].
f bhala: ['GIF87a01234567810'].

# serve the file
Server dlulisa: ['test.gif'] isiqalo: ['/tmp/'].

Okuphumayo umugqa-omusha.

Okuphumayo bhala: ['Outside container (security):'], umugqa-omusha.
{ Server dlulisa: ['../passwd'] isiqalo: ['/tmp/']. }
bamba: { :e Okuphumayo bhala: e, umugqa-omusha. },
qala.

Okuphumayo bhala: ['Invalid prefix:'], umugqa-omusha.
{ Server dlulisa: ['test.gif'] isiqalo: ['z:\\']. }
bamba: { :e Okuphumayo bhala: e, umugqa-omusha. },
qala.

Okuphumayo bhala: ['Non-existant file:'], umugqa-omusha.
{ Server dlulisa: ['xxx.xxx'] isiqalo: ['/tmp/']. }
bamba: { :e Okuphumayo bhala: e, umugqa-omusha. },
qala.
