# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := Into okusha.

Log uma-kufika: ['say:'] yenza: { :str
	Okuphumayo bhala: str, umugqa-omusha.
}.

>> Item := Into okusha.

Item uma-kufika: ['okusha:'] yenza: { :id <- uqobo okusha id: id.
}.

Item uma-kufika: ['id:'] yenza: { :id
	okwakho id := id.
}.

Item uma-kufika: ['id'] yenza: { <- okwakho id. }.


Item uma-kufika: ['umbhalo'] yenza: {
	>> str := ['Item#~no'].
	str ~no: okwakho id. <- str.
}.


>> Print := Into okusha.

Print uma-kufika: ['items'] yenza: { 
	
	okwakho item := Item okusha: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: okwakho item
	).
	
	
}.

Print items.