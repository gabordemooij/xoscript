
>> dictionary := (
	Isichazamazwi okusha
		beka: ['b'] endaweni: ['a'],
		beka: ['a'] endaweni: ['b'],
		beka: ['z'] endaweni: ['x'],
		beka: ['hello'] endaweni: ['hallo'],
		beka: ['human'] endaweni: ['human']
).

>> comparisons := Uhlu okusha.
dictionary ngamunye: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a qhathanisa: b)
	).
}.

comparisons hlela: { :a :b <- ( a qhathanisa: b ). }.
Okuphumayo bhala: ( comparisons hlanganisa: ['↵'] ), umugqa-omusha.
comparisons hlanganisa: ['↵'].
