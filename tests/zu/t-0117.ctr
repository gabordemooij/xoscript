>> t := Iqiniso.
(t = Iqiniso) iqiniso: { Okuphumayo bhala: ['T']. }.
(t = Amanga) iqiniso: { Okuphumayo bhala: ['F']. }.
Okuphumayo bhala: ['|'].
>> t := Amanga.
(t = Iqiniso) iqiniso: { Okuphumayo bhala: ['T']. }.
(t = Amanga) iqiniso: { Okuphumayo bhala: ['F']. }.
Okuphumayo bhala: ['|'].
>> f := Iqiniso.
(t = Iqiniso futhi: f = Amanga) iqiniso: { Okuphumayo bhala: ['T']. }.
(t = Amanga futhi: f = Iqiniso) iqiniso: { Okuphumayo bhala: ['F']. }.
Okuphumayo bhala: ['|'].
>> n := Lutho.
(n Lutho?) iqiniso: { Okuphumayo bhala: ['T']. }.
(n Lutho?) amanga: { Okuphumayo bhala: ['F']. }.
Okuphumayo bhala: ['|'].
(f Boolean?) iqiniso: { Okuphumayo bhala: ['T']. }.
(f Boolean?) amanga: { Okuphumayo bhala: ['F']. }.



