['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Okuphumayo bhala: (x + y), umugqa-omusha.

>> x := 10040.07.
>> y := 10305.60.

Okuphumayo bhala: (x + y), umugqa-omusha.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Okuphumayo bhala: (x + y + z), umugqa-omusha.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Okuphumayo bhala: (x + y + z), umugqa-omusha.

>> q := 0.1.2.

Okuphumayo bhala: (q), umugqa-omusha.

>> q := 012.

Okuphumayo bhala: (q), umugqa-omusha.
