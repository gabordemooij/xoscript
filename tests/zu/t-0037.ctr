>> a := 3.
>> b := a kopisha.
a khipha: 1.
Okuphumayo bhala: [' a = '] + a.
Okuphumayo bhala: [' b = '] + b.
a := 3.
b := a + 4.
Okuphumayo bhala: [' a = '] + a.
Okuphumayo bhala: [' b = '] + b.
>> x := 3.
>> y := x kopisha.
x engeza: 10.
y khipha: 1.
Okuphumayo bhala: [' x = '] + x.
Okuphumayo bhala: [' y = '] + y.
>> q := Into okusha.
q uma-kufika: ['setProperty:'] yenza: { :x
	okwakho prop := x.
}.
q uma-kufika: ['getProperty'] yenza: { <- okwakho prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Okuphumayo bhala: [' p = '] + (p getProperty).
