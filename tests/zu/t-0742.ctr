Okuphumayo bhala: ['Test object'], umugqa-omusha.
>> a := Into okusha. 

a uma-kufika: ['item:'] yenza: { :hexhelper
	okwakho hexhelper := hexhelper. 
}.

a uma-kufika: ['item'] yenza: { <- okwakho hexhelper.
}.

a item: Hx okusha.

>> old-hexhelper-address := a item isibonelo-sokuqala ikheli-lenkumbulo.
a save-as: ['/tmp/a.bin'].
Okuphumayo bhala: ['========== RELOADING SNAP:'], umugqa-omusha.

>> b := Into load-from: ['/tmp/a.bin'].

(b item isibonelo-sokuqala ikheli-lenkumbulo = old-hexhelper-address) iqiniso: {
	Okuphumayo bhala: ['Object link re-attached.'], umugqa-omusha.
}.
