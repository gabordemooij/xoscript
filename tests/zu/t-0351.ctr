
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> ikhodi := {
	>> o := (
		Isichazamazwi okusha
		aa: (Uhlu ← 1 ; 2),
		bb: (Uhlu ← 3 ; 4)
	).
	>> s := o umbhalo.
	>> o2 := s into.
	(s  uhlobo = Umbhalo uhlobo) iqiniso: { Okuphumayo bhala: ['OK1'], umugqa-omusha. }.
	(o2 uhlobo = Isichazamazwi uhlobo) iqiniso: { Okuphumayo bhala: ['OK2'], umugqa-omusha. }.
}.

Uhlelo ukuphathwa-kwenkumbulo: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Uhlelo hlanza.
usedMemory1 := (Uhlelo inkumbulo ? 1).
ikhodi qala.
Uhlelo hlanza.
usedMemory2 := (Uhlelo inkumbulo ? 1).
ikhodi qala.
Uhlelo hlanza.
usedMemory3 := (Uhlelo inkumbulo ? 1).
ikhodi qala.
Uhlelo hlanza.
usedMemory4 := (Uhlelo inkumbulo ? 1).

(usedMemory2 = usedMemory3 = usedMemory4) iqiniso: { Okuphumayo bhala: ['OK3'], umugqa-omusha. }.
 
