
{ :i
	Okuphumayo bhala: ['This is step #'] + ( ( i ) + 1 ), umugqa-omusha.
} × 6.

{ :i
	Okuphumayo bhala: ['This is step #'] + ( 3 - ( i ) ), umugqa-omusha.
} × 6.

{ :i
	Okuphumayo bhala: ['NEVER!'], umugqa-omusha.
} × 0.



{ :i
	Okuphumayo bhala: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), umugqa-omusha.
} × 11.
