# a quote that never closes must give an error, not an endless loop
>> indlela-yefayela := ['/tmp/test0821.csv'].
>> file := Ifayela okusha: indlela-yefayela.

file bhala: ['a,b\n"1,2\n'].
{
	file isihlukanisi: [','] isicaphuni: ['"'] imigqa: { :line
		Okuphumayo bhala: line, umugqa-omusha.
	}.
} bamba: { :e Okuphumayo bhala: e, umugqa-omusha. }, qala.

# a closed quote still works
file bhala: ['a,b\n"1,2",3'].
file isihlukanisi: [','] isicaphuni: ['"'] imigqa: { :line
	Okuphumayo bhala: line, umugqa-omusha.
}.
file susa.
