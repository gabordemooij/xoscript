Inombolo uma-kufika: ['factorial'] yenza: {
	>> total := 1.
	{ :index total phindaphinda-ngo: (uqobo - (index)). } × uqobo. <- total.
}.
>> Printer := Into okusha.
Printer uma-kufika: ['print:and:'] yenza: { :x :y
	Okuphumayo bhala: ['a='] + x + [', b='] + y, umugqa-omusha.
}.
>> a := 4.5. >> b := a yehlisa-inani.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a khuphula-inani.
Printer print: a and: b.
a := 4.5. b := a yehlisa-inani.
Printer print: a and: b.
a := 4.5. b := a sondeza-inani.
Printer print: a and: b.
a := 4.2. b := a sondeza-inani.
Printer print: a and: b.

Okuphumayo bhala: (9 insalela: 5), umugqa-omusha.
Okuphumayo bhala: -666 inani-eliphelele, umugqa-omusha.
Okuphumayo bhala: 49 impande-yesikwele, umugqa-omusha.
Okuphumayo bhala: (2 amandla-enombolo: 3), umugqa-omusha.
>> l := (Uhlu ← 9 ; 6).
Okuphumayo bhala: l ubuncane.

