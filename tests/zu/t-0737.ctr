#regex test, with positive look around
Server init.
>> subject := ['bacabcca'].
>> pattern := Iphethini okusha: ['(\\w{2})(?=ca)'].
>> result := pattern ukufana: subject yenza: { :m :x
	Okuphumayo bhala: m, umugqa-omusha.
	Okuphumayo bhala: x, umugqa-omusha. <- ['XXX'].
}.
Okuphumayo bhala: result, umugqa-omusha.
