Uhlelo ukuphathwa-kwenkumbulo: 0.
Uhlu uma-kufika: ['sum'] yenza: {
	>> total := 0.
	uqobo ngamunye: { :index :element
		total engeza: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Ifayela okusha: ['/tmp/test.txt'].
f bhala: ['Lorem Ipsum'].
f vala.
  

f := Ifayela okusha: ['/tmp/test.txt'].
>> text := f funda.
f vala.



Uhlelo hlanza.
usedMemory1 := (Uhlelo inkumbulo ? 1).



f := Ifayela okusha: ['/tmp/test.txt'].
text := f funda.
f vala.

Uhlelo hlanza.
usedMemory2 := (Uhlelo inkumbulo ? 1).


f := Ifayela okusha: ['/tmp/test.txt'].
text := f funda.
f vala.

Uhlelo hlanza.
usedMemory3 := (Uhlelo inkumbulo ? 1).



( usedMemory1 = usedMemory2 futhi: usedMemory1 = usedMemory3, futhi: usedMemory2 = usedMemory3 ) iqiniso: {
	Okuphumayo bhala: ['No memory leaks here'].
}, amanga: {
	Okuphumayo bhala: ['Leaking memory...'].
}.
