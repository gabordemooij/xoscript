>> usedMemory3 := 0.
>> usedMemory4 := 0.

Uhlelo ukuphathwa-kwenkumbulo: 0.

>> f := Ifayela okusha: ['/tmp/citrine_test_file.txt'].
f exists: { f susa. }.
f bhala: ['hello world'].
>> q := f indlela-yefayela.

f := Ifayela okusha: ['/tmp/citrine_test_file.txt'].
