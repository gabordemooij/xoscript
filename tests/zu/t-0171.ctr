

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Uhlelo ukuphathwa-kwenkumbulo: 0.

>> a := Uhlu ← ['hello'] ; ['world'] ; Iqiniso ; Lutho ; 666.
a yenza thatha-yokugcina thatha-yokuqala engeza-ekuqaleni: ['hi'], engeza-ekugcineni: 999, kwenziwe.
Okuphumayo bhala: ( a hlanganisa: [','] ), umugqa-omusha.

Uhlelo hlanza.
usedMemory1 := (Uhlelo inkumbulo ? 0).


a := Uhlu ← ['hello'] ; ['world'] ; Iqiniso ; Lutho ; 666.
a thatha-yokugcina. a thatha-yokuqala. a engeza-ekuqaleni: ['hi'], engeza-ekugcineni: 999.
Okuphumayo bhala: ( a hlanganisa: [','] ), umugqa-omusha.


Uhlelo hlanza.
usedMemory2 := (Uhlelo inkumbulo ? 0).


a := Uhlu ← ['hello'] ; ['world'] ; Iqiniso ; Lutho ; 666.
a yenza thatha-yokugcina thatha-yokuqala engeza-ekuqaleni: ['hi'], engeza-ekugcineni: 999, kwenziwe.
Okuphumayo bhala: ( a hlanganisa: [','] ), umugqa-omusha.


Uhlelo hlanza.
usedMemory3 := (Uhlelo inkumbulo ? 0).



( usedMemory1 = usedMemory2 futhi: usedMemory1 = usedMemory3, futhi: usedMemory2 = usedMemory3 ) iqiniso: {
	Okuphumayo bhala: ['No memory leaks here'].
}, amanga: {
	Okuphumayo bhala: ['Leaking memory...'].
}.
