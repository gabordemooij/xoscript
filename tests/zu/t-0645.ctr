Server init.
Okuphumayo bhala: ['Database date test'], umugqa-omusha.

>> db := Maria-DB okusha umsingathi: ['localhost'],
	igama-lomsebenzisi: ['xo'], 
	iphasiwedi: ['pass123'],
	igama-lesizindalwazi: ['xobase'],
	xhumana.

>> amapharamitha-okusesha :=
db umbuzo: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
landa: { :row
	Okuphumayo bhala: row datetest, umugqa-omusha.
}.
