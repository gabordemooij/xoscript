Server init.
>> f := Ifomethi okusha: ['%d'].
>> a := Blob okusha: 4.
a bytes: ( Uhlu okusha ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob okusha: 4.
b bytes: ( Uhlu okusha ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a kusuka: 0 ubude: 3, ngamunye: { :i :byte
	Okuphumayo bhala: ( f sebenzisa-kunombolo-ephelele: byte ), umugqa-omusha.
}.
a ^ b.
a kusuka: 0 ubude: 3, ngamunye: { :i :byte
	Okuphumayo bhala: ( f sebenzisa-kunombolo-ephelele: byte ), umugqa-omusha.
}.
a ^ b.
a kusuka: 0 ubude: 3, ngamunye: { :i :byte
	Okuphumayo bhala: ( f sebenzisa-kunombolo-ephelele: byte ), umugqa-omusha.
}.
a khulula.
b khulula.

{ a ^ Into. } bamba: { :e Okuphumayo bhala: e, umugqa-omusha. }, qala.
