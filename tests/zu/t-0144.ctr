



>> CoffeeGrounds := Into okusha.
CoffeeGrounds uma-kufika: ['extract'] yenza: { <- ['coffee']. }.

>> CoffeeMachine := Into okusha.
CoffeeMachine uma-kufika: ['init'] yenza: {
	okwakho coffeegrounds := CoffeeGrounds okusha.
}.
CoffeeMachine uma-kufika: ['okusha'] yenza: { <- CoffeeMachine `new init.
}.

CoffeeMachine uma-kufika: ['makeTea'] yenza: { <- (okwakho tealeaves extract). }.
CoffeeMachine uma-kufika: ['makeCoffee'] yenza: { <- (okwakho coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine okusha.

Okuphumayo bhala:
	coffeeDream 
	makeCoffee.

Okuphumayo bhala:
	coffeeDream 
	makeTea.
