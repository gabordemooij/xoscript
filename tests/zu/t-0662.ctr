>> t := Lutho.

# you can control the time zone for
# parsing like this:
Isikhathi indawo-yesikhathi: ['CET'].
t := Isikhathi umthombo: ['1981-02-03 04:05:06'].
Okuphumayo bhala: t, umugqa-omusha.

# now using CEST time zone:
Isikhathi indawo-yesikhathi: ['CEST'].
t := Isikhathi umthombo: ['1981-02-03 04:05:06'].
Okuphumayo bhala: t, umugqa-omusha.

# error if string cannot be parsed
{ Isikhathi umthombo: ['1900']. } bamba: { Lutho. }, qala.
