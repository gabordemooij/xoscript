Okuphumayo bhala: ['Test object'], umugqa-omusha.
>> a := Into okusha. 

a uma-kufika: ['item:'] yenza: { :fmt
	okwakho fmt := fmt. 
}.

a uma-kufika: ['item'] yenza: { <- okwakho fmt.
}.

a item: ( Ifomethi okusha: ['|%s|'] ).

Okuphumayo bhala: a item, umugqa-omusha.

>> old-fmt-address := a item isibonelo-sokuqala ikheli-lenkumbulo.
a save-as: ['/tmp/a.bin'].
Okuphumayo bhala: ['========== RELOADING SNAP:'], umugqa-omusha.

>> b := Into load-from: ['/tmp/a.bin'].

(b item isibonelo-sokuqala ikheli-lenkumbulo = old-fmt-address) iqiniso: {
	Okuphumayo bhala: ['Object link re-attached.'], umugqa-omusha.
}.

Okuphumayo bhala: ( b item sebenzisa-ku: ['hello'] ), umugqa-omusha.
