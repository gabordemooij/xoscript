Server init.
Okuphumayo bhala: ['Database datetime test'], umugqa-omusha.

>> db := Maria-DB okusha umsingathi: ['localhost'],
	igama-lomsebenzisi: ['xo'], 
	iphasiwedi: ['pass123'],
	igama-lesizindalwazi: ['xobase'],
	xhumana.

>> amapharamitha-okusesha :=
db umbuzo: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
landa: { :row
	Okuphumayo bhala: row datetimetest, umugqa-omusha.
}.
