


>> Deck := Uhlu okusha.
Deck uma-kufika: ['print'] yenza: {
        >> len := uqobo inani - 1.
        { :i
                >> len2 := uqobo inani - 1.
                Okuphumayo bhala: ['len: '].
                Okuphumayo bhala: len, umugqa-omusha.
                Okuphumayo bhala: ['len2: '].
                Okuphumayo bhala: len2, umugqa-omusha.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
