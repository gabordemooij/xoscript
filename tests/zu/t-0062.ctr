Ibhuliyeni uma-kufika: ['xor:'] yenza: { :a :b <- ((a futhi: b hhayi) noma: (a hhayi futhi: b)).
}.

>> o := Into okusha.
o uma-kufika: ['hello'] yenza: { ['Empty']. }.
{ o uma-kufika: 2 yenza: 3.} bamba: { :e Okuphumayo bhala: e, umugqa-omusha. }, qala.
{ o uma-kufika: ['ukuhlola'] yenza: 3.} bamba: { :e Okuphumayo bhala: e, umugqa-omusha. }, qala.
{ o uma-kufika: ['hello'] yenza: { ['Empty']. }.} bamba: { :e Okuphumayo bhala: e, umugqa-omusha. }, qala. 
{ >> z := 4 ÷ 0. } bamba: { :e Okuphumayo bhala: e, umugqa-omusha. }, qala. 
{ (Iqiniso futhi: Lutho) iqiniso: { Okuphumayo bhala: ['X'].}. } bamba: { :e Okuphumayo bhala: e, umugqa-omusha. }, qala. 
{ ([''] xor: 0) iqiniso: { Okuphumayo bhala: ['X'].}. } bamba: { :e Okuphumayo bhala: e, umugqa-omusha. }, qala. 
{ (1 < ['2']) iqiniso: { Okuphumayo bhala: ['OK']. }. } bamba: { :e Okuphumayo bhala: e, umugqa-omusha. }, qala. 
{ (1 < ['2.0']) iqiniso: { Okuphumayo bhala: ['OK']. }. } bamba: { :e Okuphumayo bhala: e, umugqa-omusha. }, qala. 
{ (1 < ['x2.0']) iqiniso: { Okuphumayo bhala: ['NO!']. }. } bamba: { :e Okuphumayo bhala: e, umugqa-omusha. }, qala. 
{ Okuphumayo bhala: (['hello OK there'] kusuka: ['6'] ubude: ['2']). } qala. 
