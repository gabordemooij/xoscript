

Umbhalo uma-kufika: ['html'] yenza: { <- (
		uqobo
		buyisela: ['&'] nge: ['&amp;'],
		buyisela: ['<'] nge: ['&lt;'],
		buyisela: ['>'] nge: ['&gt;'],
		buyisela: ['"'] nge: ['&quot;']
	).
}.


Okuphumayo bhala: ([' left trimmed '] sika-izikhala) + [' '] + ( ['and right trimmed'] sika-izikhala) + ['!'], umugqa-omusha.
Okuphumayo bhala: ['<html>"html & entities"</html>'] html.
