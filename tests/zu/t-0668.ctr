# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob okusha: 8, bytes: (
	Uhlu okusha ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Okuphumayo bhala: ( utf16 khipha-ikhodi: ['utf16le'] ), umugqa-omusha.

utf16 khulula.
>> utf32 := Blob okusha: 13, bytes: (
	Uhlu okusha ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Okuphumayo bhala: ( utf32 khipha-ikhodi: ['utf32be'] ), umugqa-omusha.
utf32 khulula.