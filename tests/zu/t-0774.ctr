Okuphumayo bhala: ['Test object'], umugqa-omusha.
>> a := Into okusha. 
a uma-kufika: ['item:'] yenza: { :lst
	okwakho lst := lst. 
}.
a uma-kufika: ['item'] yenza: { <- okwakho lst.
}.
a item: (
	Uhlu okusha ; 1 ; (
		Uhlu okusha ; ['a'] ; (
			Uhlu okusha ; ( Isikhathi okusha: 1 )
		) ; ( Int64 kusuka-embhalweni: ['321'] )
	)
).
Okuphumayo bhala: a item, umugqa-omusha.
>> old-lst-address := a item isibonelo-sokuqala ikheli-lenkumbulo.
a save-as: ['/tmp/a.bin'].
Okuphumayo bhala: ['========== RELOADING SNAP:'], umugqa-omusha.
>> b := Into load-from: ['/tmp/a.bin'].
(b item isibonelo-sokuqala ikheli-lenkumbulo = old-lst-address) iqiniso: {
	Okuphumayo bhala: ['Object link re-attached.'], umugqa-omusha.
}.
Okuphumayo bhala: ( b item ), umugqa-omusha.
