
>> motive := Amanga.
>> opportunity := Amanga.
Okuphumayo bhala: (motive akukho-kokubili: opportunity).
Okuphumayo bhala: (motive hhayi & opportunity hhayi).

Okuphumayo bhala: (Iqiniso = Iqiniso).
Okuphumayo bhala: (Iqiniso ≠ Iqiniso).
Okuphumayo bhala: (Iqiniso ≠ Amanga).
Okuphumayo bhala: (Iqiniso = Amanga).
