# catch-all test (practical)
>> HTML := Umbhalo okusha.
HTML uma-kufika: ['encode:'] yenza: { :tekst
	uqobo engeza-ekugcineni: (tekst
	buyisela: ['&'] nge: ['&amp;'], 
	buyisela: ['<'] nge: ['&lt;'],
	buyisela: ['>'] nge: ['&gt;'],
	buyisela: ['"'] nge: ['&quot;']).
}.
>> blog := HTML okusha.
blog engeza-ekugcineni: ['<h1>'],
     encode: ['Koffie & Thee'],
     engeza-ekugcineni: ['</h1>'].
Okuphumayo bhala: blog, umugqa-omusha.


>> Roman := Inombolo okusha.
Roman uma-kufika: ['stringy'] yenza: {
	>> a := [''].
	{ a engeza-ekugcineni: ['I']. } × uqobo. <- a.
}.

>> x := Roman okusha.
x engeza: 3.
Okuphumayo bhala: x stringy, umugqa-omusha.

>> Quantum := Ibhuliyeni okusha.
Quantum uma-kufika: ['true?'] yenza: { <- ['maybe True']. }.
Okuphumayo bhala: (Quantum okusha true?), umugqa-omusha.

>> Nihil := Lutho okusha.
Nihil uma-kufika: ['umbhalo'] yenza: { <- ['Nihil']. }.
Okuphumayo bhala: (Nihil okusha), umugqa-omusha.
