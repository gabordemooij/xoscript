>> repeater := Into okusha.
repeater uma-kufika: ['phendula:'] yenza: { :what
	Okuphumayo bhala: what + [' '].
}.
repeater uma-kufika: ['phendula:futhi:'] yenza: { :what :say
	Okuphumayo bhala: what, bhala: say + [' '].
}.
repeater uma-kufika: ['phendula:futhi:futhi:'] yenza: { :what :say :more
	Okuphumayo bhala: what, bhala: say, bhala: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
