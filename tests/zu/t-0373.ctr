# compliance test

# use international numbers

Okuphumayo bhala: ['1000 -> '].
Okuphumayo bhala: 1000, umugqa-omusha. #1000

Okuphumayo bhala: ['1.5 -> '].
Okuphumayo bhala: 1.5, umugqa-omusha.  #1.5

Okuphumayo bhala: ['1001.5 -> '].
Okuphumayo bhala: 1.5 + 1000, umugqa-omusha. #1001.5

# use 0-indexed arrays
>> x := Uhlu okusha ; 1 ; 2 ; 3.
>> y := Uhlu okusha ; ['a'] ; ['b'] ; ['c'].

Okuphumayo bhala: ['1 -> '].
Okuphumayo bhala: x ? 0, umugqa-omusha. #1

Okuphumayo bhala: ['1 -> '].
Okuphumayo bhala: (x endaweni: 0), umugqa-omusha. #1

Okuphumayo bhala: ['1 -> '].
Okuphumayo bhala: x okokuqala, umugqa-omusha. #1

Okuphumayo bhala: ['3 -> '].
Okuphumayo bhala: x okokugcina, umugqa-omusha. #3

Okuphumayo bhala: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Okuphumayo bhala: (x ngokwe: y), umugqa-omusha.

Okuphumayo bhala: ['1 -> '].
Okuphumayo bhala: (x kusuka: 0 ubude: 1) okokuqala, umugqa-omusha. #1

Okuphumayo bhala: ['0 -> '].
Okuphumayo bhala: (x thola: 1), umugqa-omusha. #0

x beka: 9 endaweni: 0.

Okuphumayo bhala: ['9 -> '].
Okuphumayo bhala: (x endaweni: 0), umugqa-omusha. #9

x engeza-ekuqaleni: 8.
Okuphumayo bhala: ['8 -> '].
Okuphumayo bhala: (x endaweni: 0), umugqa-omusha. #9


x engeza-ekugcineni: 10.
Okuphumayo bhala: ['10 -> '].
Okuphumayo bhala: (x endaweni: 4), umugqa-omusha. #10








