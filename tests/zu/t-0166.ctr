

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Uhlelo ukuphathwa-kwenkumbulo: 0.

{
>> q := ['You should be able'].
q engeza-ekugcineni: ([' to append something to a string']+['!']).
Okuphumayo bhala: q.
} qala.

Uhlelo hlanza.
usedMemory1 := (Uhlelo inkumbulo ? 0).


