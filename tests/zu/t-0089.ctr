>> randomizer := { :a :b
	>> ubuncane := ( a < b ) lokhu: a noma-lokho: b.
	>> ubukhulu := ( a > b ) lokhu: a noma-lokho: b.
	>> x := Lutho.
	{
		x := Inombolo phakathi: a no: b.
		((x < ubuncane) noma: (x > ubukhulu)) iqiniso: { 
			Okuphumayo bhala: (['Invalid value!']).
			Uhlelo qeda.
		}.
	} 
	× 100. <- x.
}.
randomizer sebenzisa-ku: 0 futhi: 0.
