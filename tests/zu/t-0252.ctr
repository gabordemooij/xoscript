#Linux
>> clock := Isikhathi okusha.
clock indawo-yesikhathi: ['UTC-1'].
clock unyaka: 1981, inyanga: 1, usuku: 5,
      ihora: 13, umzuzu: 15, isekhondi: 13.

Okuphumayo bhala: clock, umugqa-omusha.
clock indawo-yesikhathi: ['UTC+0'].

Okuphumayo bhala: (
	(clock unyaka okulula) + ['-'] + (clock inyanga) + ['-'] + (clock usuku) + [' '] +
	(clock ihora) + [':'] + (clock umzuzu) + [':'] + (clock isekhondi) + [' '] +
	['W'] + (clock isonto) + (clock indawo-yesikhathi)
), umugqa-omusha.


clock indawo-yesikhathi: ['UTC-1'].
Okuphumayo bhala: (
	(clock unyaka okulula) + ['-'] + (clock inyanga) + ['-'] + (clock usuku) + [' '] +
	(clock ihora) + [':'] + (clock umzuzu) + [':'] + (clock isekhondi) + [' '] +
	['W'] + (clock isonto) + (clock indawo-yesikhathi)
), umugqa-omusha.
