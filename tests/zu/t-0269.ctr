#Linux

(Ifayela okusha: ['/tmp/testje']) ikhona amanga: {
	Uhlelo isistimu: ['mkdir /tmp/testje'].	
}.

(Ifayela okusha: ['/tmp/testje/file1']) ikhona amanga: {
	Uhlelo isistimu: ['touch /tmp/testje/file1'].	
}.

(Ifayela okusha: ['/tmp/testje/folder1']) ikhona amanga: {
	Uhlelo isistimu: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Ifayela uhlu: ['/tmp/testje'].

>> q := Uhlu okusha.

l ngamunye: { :k :v v ngamunye: { :x :y q engeza-ekugcineni: y. }. }.

>> s := q umbhalo.

(s iqukethe: ['file1']) iqiniso:   { Okuphumayo bhala: ['OK'], umugqa-omusha. }.
(s iqukethe: ['file2']) iqiniso:   { Okuphumayo bhala: ['XX'], umugqa-omusha. }.
(s iqukethe: ['folder1']) iqiniso: { Okuphumayo bhala: ['OK'], umugqa-omusha. }.
