# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Iphethini okusha: pattern.
	p ukufana: subject yenza: { :m :g
		Okuphumayo bhala: g inani, bhala: [' '], bhala: (g hlanganisa: ['|']), umugqa-omusha. <- m.
	}.
}.
show sebenzisa-ku: ['(a)|(b)'] futhi: ['b'].
show sebenzisa-ku: ['(a)|(b)'] futhi: ['a'].
show sebenzisa-ku: ['(x)?y'] futhi: ['y'].
show sebenzisa-ku: ['(x)?(y)(z)?'] futhi: ['xy'].
