>> makeAdder := { :x
	>> f := { :y <- (okwakho x + y). } setha: ['x'] inani: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i okwakho q beka: (okwakho f sebenzisa-ku: (okwakho q ? i)) endaweni: i. } 
	setha: ['q'] inani: array,
	setha: ['f'] inani: func.
	{ :i mapping sebenzisa-ku: i. } × (array inani).
}.

>> a := Uhlu ← 1; 2; 3.
mapper sebenzisa-ku: a futhi: (makeAdder sebenzisa-ku: 100).
Okuphumayo bhala: (a indawo: 0), umugqa-omusha.
Okuphumayo bhala: (a ? 1), umugqa-omusha.
Okuphumayo bhala: (a ? 2), umugqa-omusha.
