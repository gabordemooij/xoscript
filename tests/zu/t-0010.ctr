>> Animal := Into okusha.
Animal uma-kufika: ['make'] yenza: {
	>> animal := Into okusha.
	animal uma-kufika: ['makeSound'] yenza: {
		Okuphumayo bhala: okwakho sound.
	}. <- animal.
}.
>> Cat := Into okusha.
Cat uma-kufika: ['make'] yenza: {
	>> cat := Animal make.
	cat uma-kufika: ['init'] yenza: {
		okwakho sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
