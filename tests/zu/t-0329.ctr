Okuphumayo bhala: ((Uhlu okusha
	uma-kufika: ['plaque:'] yenza: { :x okwakho o := x. },
	uma-kufika: ['plaque']  yenza: { <- okwakho o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Uhlu ← 1)
	~ (Uhlu ← 1 ; 2)
	~ (Uhlu ← 1 ; 2 ; 3)
	~ (Uhlu ← 1 ; 2 ; 3 ; 4)
	~ (Uhlu ← 1 ; 2 ; 3 ; 4 ; 5)
) ngamunye: { :i :el
	{ Okuphumayo bhala: lo-msebenzi. } × el inani.
	Okuphumayo umugqa-omusha.
}) plaque, umugqa-omusha.


