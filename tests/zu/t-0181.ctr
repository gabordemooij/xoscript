

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Uhlelo ukuphathwa-kwenkumbulo: 0.

>> txt := ['World Salad'].
Okuphumayo bhala: ['this text contains: '] + ( ( txt hlukanisa: [' '] ) inani ) + [' words.'], umugqa-omusha.
txt := txt kusuka: 6 ubude: 4.
Okuphumayo bhala: txt, umugqa-omusha.

Uhlelo hlanza.

usedMemory1 := (Uhlelo inkumbulo ? 0).


