

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Uhlelo ukuphathwa-kwenkumbulo: 0.

{ :i Okuphumayo bhala: i. } × 4.
Okuphumayo umugqa-omusha.
{ :i Okuphumayo bhala: (4 - i). } × 4.
Okuphumayo umugqa-omusha.
( 1 > 2 ) amanga: { Okuphumayo bhala: ['BLOCK 1'], umugqa-omusha. }.
( 2 > 1 ) iqiniso:  { Okuphumayo bhala: ['BLOCK 2'], umugqa-omusha. }.

>> i := 0.
{ Okuphumayo bhala: i. i engeza: 1. } ngenkathi: { <- ( i < 3). }.
Okuphumayo umugqa-omusha.

i := 3.
{ Okuphumayo bhala: i. i := i - 1. } ngenkathi: { <- ( i > 0). }.
Okuphumayo umugqa-omusha.


Uhlelo hlanza.

usedMemory1 := (Uhlelo inkumbulo ? 0).


{ :i  Okuphumayo bhala: i. } × 4.
Okuphumayo umugqa-omusha.
{ :i  Okuphumayo bhala: (4 - i). } × 4.
Okuphumayo umugqa-omusha.
( 1 > 2 ) amanga: { Okuphumayo bhala: ['BLOCK 1'], umugqa-omusha. }.
( 2 > 1 ) iqiniso:  { Okuphumayo bhala: ['BLOCK 2'], umugqa-omusha. }.

>> i := 0.
{ Okuphumayo bhala: i. i engeza: 1. } ngenkathi: { <- ( i < 3). }.
Okuphumayo umugqa-omusha.

i := 3.
{ Okuphumayo bhala: i. i := i - 1. } ngenkathi: { <- ( i > 0). }.
Okuphumayo umugqa-omusha.



Uhlelo hlanza.
usedMemory2 := (Uhlelo inkumbulo ? 0).


{ :i Okuphumayo bhala: i. } × 4.
Okuphumayo umugqa-omusha.
{ :i Okuphumayo bhala: (4 - i). } × 4.
Okuphumayo umugqa-omusha.
( 1 > 2 ) amanga: { Okuphumayo bhala: ['BLOCK 1'], umugqa-omusha. }.
( 2 > 1 ) iqiniso:  { Okuphumayo bhala: ['BLOCK 2'], umugqa-omusha. }.

>> i := 0.
{ Okuphumayo bhala: i. i engeza: 1. } ngenkathi: { <- ( i < 3). }.
Okuphumayo umugqa-omusha.

i := 3.
{ Okuphumayo bhala: i. i := i - 1. } ngenkathi: { <- ( i > 0). }.
Okuphumayo umugqa-omusha.

Uhlelo hlanza.
usedMemory3 := (Uhlelo inkumbulo ? 0).



( usedMemory1 = usedMemory2 futhi: usedMemory1 = usedMemory3, futhi: usedMemory2 = usedMemory3 ) iqiniso: {
	Okuphumayo bhala: ['No memory leaks here'].
}, amanga: {
	Okuphumayo bhala: ['Leaking memory...'].
}.
