>> invoice := Into okusha.
invoice uma-kufika: ['qala'] yenza: {
        okwakho inombolo := 0.
}.

invoice uma-kufika: ['inombolo'] yenza: {
        okwakho inombolo engeza: 1. <- okwakho inombolo kopisha.
}.

>> year-invoice := invoice okusha.
year-invoice uma-kufika: ['start:'] yenza: { :unyaka
	okwakho inombolo := unyaka.
}.

year-invoice start: 202000.
Okuphumayo bhala: year-invoice inombolo, umugqa-omusha.
Okuphumayo bhala: year-invoice inombolo, umugqa-omusha.
