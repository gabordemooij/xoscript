Uhlu uma-kufika: ['kopisha'] yenza: {
	>> kopisha := Uhlu okusha.
	uqobo ngamunye: { :inombolo :section
		kopisha engeza-ekugcineni: section ukuziphinda kopisha.
	}. <- kopisha.
}.

>> sheep := Uhlu okusha ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep kopisha.
clones ngamunye: { :inombolo :sheep
	sheep engeza-ekugcineni: ['2'].
}.

Okuphumayo bhala: sheep, umugqa-omusha.
Okuphumayo bhala: clones, umugqa-omusha.
