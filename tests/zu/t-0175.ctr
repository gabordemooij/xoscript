

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> x := 100.

Uhlelo ukuphathwa-kwenkumbulo: 0.

{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt engeza-ekugcineni: ['!!'].
Okuphumayo bhala: txt.
} qala.

Uhlelo hlanza.

usedMemory1 := (Uhlelo inkumbulo ? 0).


