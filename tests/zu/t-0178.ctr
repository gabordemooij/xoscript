

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Uhlelo ukuphathwa-kwenkumbulo: 0.

>> txt := ['Word Salad'].
Okuphumayo bhala: ['last index of ord = '] + (( txt indawo-yokugcina: ['ord'] ) - 0), umugqa-omusha.
Okuphumayo bhala: ['index of ord = '] + (( txt thola: ['ord'] ) - 0), umugqa-omusha.
Okuphumayo bhala: ['index of ad = '] + (( txt thola: ['ad'] ) - 0), umugqa-omusha.
Okuphumayo bhala: ['last index of W = '] + (( txt indawo-yokugcina: ['W'] ) - 0), umugqa-omusha.
Okuphumayo bhala: ['last index of d = '] + (( txt indawo-yokugcina: ['d'] ) - 0), umugqa-omusha.
Okuphumayo bhala: ['txt equals Word Salad = '] + ( txt = ['Word Salad'] ), umugqa-omusha.
Okuphumayo bhala: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), umugqa-omusha.
Okuphumayo bhala: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), umugqa-omusha.
Okuphumayo bhala: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), umugqa-omusha.

Uhlelo hlanza.

usedMemory1 := (Uhlelo inkumbulo ? 0).


