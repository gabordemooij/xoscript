

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Uhlelo ukuphathwa-kwenkumbulo: 0.

>> txt := ['Word Salad'].
Okuphumayo bhala: ['Text Length: '] + txt ubude, umugqa-omusha.
Okuphumayo bhala: ['Character at 2:'] + ( txt uhlamvu: 2 ), umugqa-omusha.
Okuphumayo bhala: (( txt thola: ['S'] ) - 0), umugqa-omusha.

Uhlelo hlanza.

usedMemory1 := (Uhlelo inkumbulo ? 0).


txt := ['Word Salad'].
Okuphumayo bhala: ['Text Length: '] + txt ubude, umugqa-omusha.
Okuphumayo bhala: ['Character at 2:'] + ( txt uhlamvu: 2 ), umugqa-omusha.
Okuphumayo bhala: (( txt thola: ['S'] ) - 0), umugqa-omusha.

Uhlelo hlanza.
usedMemory2 := (Uhlelo inkumbulo ? 0).


txt := ['Word Salad'].
Okuphumayo bhala: ['Text Length: '] + txt ubude, umugqa-omusha.
Okuphumayo bhala: ['Character at 2:'] + ( txt uhlamvu: 2 ), umugqa-omusha.
Okuphumayo bhala: (( txt thola: ['S'] ) - 0), umugqa-omusha.

Uhlelo hlanza.
usedMemory3 := (Uhlelo inkumbulo ? 0).



( usedMemory1 = usedMemory2 futhi: usedMemory1 = usedMemory3, futhi: usedMemory2 = usedMemory3 ) iqiniso: {
	Okuphumayo bhala: ['No memory leaks here'].
}, amanga: {
	Okuphumayo bhala: ['Leaking memory...'].
}.
