Inombolo uma-kufika: ['factorial'] yenza: {
	>> total := 1.
	{ :index total phindaphinda-ngo: (uqobo - (index)). } × uqobo. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Okuphumayo bhala: a.
>> b := 2 + 3 factorial.
Okuphumayo bhala: b.
>> c := 3 factorial + 2.
Okuphumayo bhala: c.
>> d := 2 + (3 factorial).
Okuphumayo bhala: d.
Okuphumayo bhala: 2 + 3 factorial + 1.
