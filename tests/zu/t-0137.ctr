


Uhlelo ukuphathwa-kwenkumbulo: 0.

>> x := 0.
>> y := ['Hello'].
>> q := { ['Empty']. }.
>> p := Iqiniso.
>> a := Uhlu ← 1 ; 2 ; 3 ; 4.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Uhlelo hlanza.
usedMemory1 := (Uhlelo inkumbulo ? 0).




x := 1.
y := ['Hello'].
q := { ['Empty']. }.
p := Iqiniso.
a := Uhlu ← 1 ; 2 ; 3 ; 5.

Uhlelo hlanza.
usedMemory2 := (Uhlelo inkumbulo ? 0).




