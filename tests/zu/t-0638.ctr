
Server init.
>> rq := Isicelo-HTTP okusha.
Okuphumayo bhala: ['HTTP-GET d[]=']  + ( rq get-uhlu: ['d[]'] ), umugqa-omusha. # GET
Okuphumayo bhala: ['HTTP-GET f[]=']  + ( rq get-uhlu: ['f[]'] ), umugqa-omusha. # GET
Okuphumayo bhala: ['HTTP-POST e[]='] + ( rq post-uhlu: ['e[]'] ), umugqa-omusha. # GET
Okuphumayo bhala: ['HTTP-POST c=']   + ( rq post: ['c'] ), umugqa-omusha. # GET
Okuphumayo bhala: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), umugqa-omusha. # GET
