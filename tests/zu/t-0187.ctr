Inombolo uma-kufika: ['factorial'] yenza: {
	>> total := 1.
	{ :index total phindaphinda-ngo: (uqobo - index). } × uqobo. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Uhlelo ukuphathwa-kwenkumbulo: 0.

{
2 exponent factorial.
Okuphumayo bhala: (11 insalela: 3), umugqa-omusha.
Okuphumayo bhala: (3.4 sondeza-inani), umugqa-omusha.
Okuphumayo bhala: (7.1 khuphula-inani), umugqa-omusha.
Okuphumayo bhala: (7.9 yehlisa-inani), umugqa-omusha.
}
qala.

Uhlelo hlanza.

usedMemory1 := (Uhlelo inkumbulo ? 0).

{
2 exponent factorial.
Okuphumayo bhala: (11 insalela: 3), umugqa-omusha.
Okuphumayo bhala: (3.4 sondeza-inani), umugqa-omusha.
Okuphumayo bhala: (7.1 khuphula-inani), umugqa-omusha.
Okuphumayo bhala: (7.9 yehlisa-inani), umugqa-omusha.
}
qala.

Uhlelo hlanza.
usedMemory2 := (Uhlelo inkumbulo ? 0).


{
2 exponent factorial.
Okuphumayo bhala: (11 insalela: 3), umugqa-omusha.
Okuphumayo bhala: (3.4 sondeza-inani), umugqa-omusha.
Okuphumayo bhala: (7.1 khuphula-inani), umugqa-omusha.
Okuphumayo bhala: (7.9 yehlisa-inani), umugqa-omusha.
} qala.

Uhlelo hlanza.
usedMemory3 := (Uhlelo inkumbulo ? 0).



( usedMemory1 = usedMemory2 futhi: usedMemory1 = usedMemory3, futhi: usedMemory2 = usedMemory3 ) iqiniso: {
	Okuphumayo bhala: ['No memory leaks here'].
}, amanga: {
	Okuphumayo bhala: ['Leaking memory...'].
}.
