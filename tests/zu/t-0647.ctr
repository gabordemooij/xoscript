Server init.
Okuphumayo bhala: ['Database time test'], umugqa-omusha.

>> db := Maria-DB okusha umsingathi: ['localhost'],
	igama-lomsebenzisi: ['xo'], 
	iphasiwedi: ['pass123'],
	igama-lesizindalwazi: ['xobase'],
	xhumana.

>> amapharamitha-okusesha :=
db umbuzo: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
landa: { :row
	Okuphumayo bhala: row timetest, umugqa-omusha.
}.
