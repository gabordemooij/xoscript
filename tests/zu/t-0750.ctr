Okuphumayo bhala: ['Test object'], umugqa-omusha.
>> a := Into okusha. 

a uma-kufika: ['item:'] yenza: { :nil
	okwakho nil := nil. 
}.

a uma-kufika: ['item'] yenza: { <- okwakho nil.
}.

a item: Lutho.

Okuphumayo bhala: a item, umugqa-omusha.

>> old-nil-address := a item isibonelo-sokuqala ikheli-lenkumbulo.
a save-as: ['/tmp/a.bin'].
Okuphumayo bhala: ['========== RELOADING SNAP:'], umugqa-omusha.

>> b := Into load-from: ['/tmp/a.bin'].

(b item isibonelo-sokuqala ikheli-lenkumbulo = old-nil-address) iqiniso: {
	Okuphumayo bhala: ['Object link re-attached.'], umugqa-omusha.
}.

Okuphumayo bhala: b item, umugqa-omusha.
