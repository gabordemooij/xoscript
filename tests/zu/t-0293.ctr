
>> city := Uhlu ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Uhlu ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature ngokwe: city.
>> cities := weather okhiye hlela: { :a :b <- (a qhathanisa: b). }.
>> temperatures := weather amanani hlela: { :a :b <- (a qhathanisa: b) ngaphansi-kukaziro?. }.

Okuphumayo bhala: (cities hlanganisa: [',']), umugqa-omusha.
Okuphumayo bhala: (temperatures hlanganisa: [',']), umugqa-omusha.
