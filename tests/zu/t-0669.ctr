# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Isisefo 
	ihashi-lephasiwedi: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Isisefo 
	ihashi-lephasiwedi: hash qinisekisa: a1.
	# fail 
>> b := Isisefo
	ihashi-lephasiwedi: hash qinisekisa: a2.
	# ok!

Okuphumayo bhala: a, umugqa-omusha.
Okuphumayo bhala: b, umugqa-omusha.

