Server init.

# returning non-str from match/do should be ok
>> subject := ['abc'].
>> pattern := Iphethini okusha: ['([ac])'].
>> result := pattern ukufana: subject yenza: { :m :x
	Okuphumayo bhala: m, umugqa-omusha.
	Okuphumayo bhala: x, umugqa-omusha. <- Lutho.
}.
Okuphumayo bhala: result, umugqa-omusha.