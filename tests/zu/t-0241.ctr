

Umbhalo uma-kufika: ['evaluate'] yenza: {
	>> ikhodi := Ifayela okusha: ['/tmp/eval.ctr'].
	ikhodi bhala: (uqobo umbhalo + ['.']).
	Uhlelo sebenzisa: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Uhlu ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q umbhalo.
Okuphumayo bhala: x, umugqa-omusha.
>> y := Lutho.
(['y := '] + x ) evaluate.
Okuphumayo bhala: y ? 0, umugqa-omusha.

q := Isichazamazwi beka: ['\[''] endaweni: ['\['quote\']'].
x := q umbhalo.
Okuphumayo bhala: x, umugqa-omusha.
y := Lutho.
(['y := '] + x ) evaluate.

>> q := (Isichazamazwi okusha) beka:['\[''] endaweni:['\['quote\[''].
Okuphumayo bhala: y ? ['\['quote\']'], umugqa-omusha.
