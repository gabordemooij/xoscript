Okuphumayo bhala: ['1,2,3,4,5,6,7,8,9,A,'], umugqa-omusha.
>> Scope := Into okusha.
Scope uma-kufika: ['initialize:'] yenza: { :x okwakho property := x. }.
Scope uma-kufika: ['confirm'] yenza: { Okuphumayo bhala: [',']. }.
Scope uma-kufika: ['ukuhlola'] yenza: {
	Okuphumayo bhala: okwakho property.
	uqobo confirm.
	( 1 = 1 ) iqiniso: { Okuphumayo bhala: okwakho property. uqobo confirm. }.
	( 1 = 0 ) amanga: { Okuphumayo bhala: okwakho property. uqobo confirm. }.
	>> y := 2. { Okuphumayo bhala: okwakho property. uqobo confirm. } ngenkathi: { y khipha: 1. <- (y > 0). }.
	{ Okuphumayo bhala: okwakho property. uqobo confirm. } × 1.
	(Uhlu ← 1) ngamunye: {  Okuphumayo bhala: okwakho property. uqobo confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Isichazamazwi okusha one: ['item']) ngamunye: { Okuphumayo bhala: okwakho property. uqobo confirm. }.
	{ 1 ÷ 0. } bamba: { Okuphumayo bhala: okwakho property. uqobo confirm. }, qala.
	Okuphumayo umugqa-omusha.
}.
>> scope1 := Scope okusha.
scope1 initialize: ['X'].
scope1 ukuhlola.
>> function := { 
	okwakho property := ['Y'].
	Okuphumayo bhala: okwakho property.
	uqobo confirm.
	( 1 = 1 ) iqiniso: { Okuphumayo bhala: okwakho property. uqobo confirm. }.
	( 1 = 0 ) amanga: { Okuphumayo bhala: okwakho property. uqobo confirm. }.
	>> y := 2. { Okuphumayo bhala: okwakho property. uqobo confirm. } ngenkathi: { y khipha: 1. <- (y > 0). }.
	{ Okuphumayo bhala: okwakho property. uqobo confirm. } × 1.
	(Uhlu ← 1) ngamunye: {  Okuphumayo bhala: okwakho property. uqobo confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Isichazamazwi okusha one: ['item']) ngamunye: { Okuphumayo bhala: okwakho property. uqobo confirm. }.
	{ 1 ÷ 0. } bamba: { Okuphumayo bhala: okwakho property. uqobo confirm. }, qala.
	Okuphumayo umugqa-omusha.
}.
function uma-kufika: ['confirm'] yenza: { Okuphumayo bhala: [',']. }.
function sebenzisa-ku: 1 futhi: 2.
