60 × {
	>> x := (Inombolo random % 6) + 1.
	(x ≤ 6) amanga: { Okuphumayo bhala: ['FAIL']. }.
	(x ≥0) amanga: { Okuphumayo bhala: ['FAIL']. }.
	x := (Inombolo random % 3) + 1.
	(x < 3) amanga: { Okuphumayo bhala: ['FAIL']. }.
	(x>-1) amanga: { Okuphumayo bhala: ['FAIL']. }.
	x := ((Ibhuliyeni flip) inombolo).
	(x = 0 noma: x = 1) amanga: { Okuphumayo bhala: ['FAIL']. }.
	x := ((Iqiniso flip) inombolo).
	(x = 0 noma: x = 1) amanga: { Okuphumayo bhala: ['FAIL']. }.
	x := (Ibhuliyeni flip lokhu: ['HEAD'] noma-lokho: ['TAIL']).
	((x = ['HEAD']) noma: (x = ['TAIL'])) amanga: { Okuphumayo bhala: ['FAIL']. }.
}.
Okuphumayo bhala: ['DONE'].

