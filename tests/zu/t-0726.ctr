# test buffers PKI/Sign 
Server init.

>> long := ( Uhlu okusha gcwalisa: 1000 nge: ['a'] ) hlanganisa: [''].

# sign a message
Okuphumayo bhala: ( 
	Isisefo sayina: ['abc'] nge: long
), umugqa-omusha.

Okuphumayo bhala: ( 
	Isisefo
		hlola: ['abc'] 
		isiginesha: long 
		nge: long
), umugqa-omusha.

Okuphumayo bhala: (
	Isisefo ihashi-lephasiwedi: long qinisekisa: long
), umugqa-omusha.
