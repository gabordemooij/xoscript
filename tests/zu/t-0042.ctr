>> items := Isichazamazwi okusha.
items beka: ['black'] endaweni: ['coffee'], beka: ['earl grey'] endaweni: ['tea'].
Okuphumayo bhala: (items endaweni: ['coffee']), bhala: (items endaweni: ['tea']).
Okuphumayo bhala: ['there are'] + items inani + [' items in the array.'].
items beka: ['capuccino'] endaweni: ['coffee'].
Okuphumayo bhala: ['Now my coffee is.. '] + (items endaweni: ['coffee']).
items beka: ['aaa'] endaweni: ['1'].
items beka: ['bbb'] endaweni: ['2'].
Okuphumayo bhala: (items endaweni: ['a']).
