

>> obj := Into okusha.

obj uma-kufika: ['greet'] yenza: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj uma-kufika: ['task'] yenza: {
	okwakho property := 123.
	{
		# try binds self/own to object instead of block
		Okuphumayo bhala: uqobo greet.
		Okuphumayo bhala: okwakho property.
		1 / 0.
	} bamba: {
		Okuphumayo bhala: uqobo greet.
		Okuphumayo bhala: okwakho property.
		Okuphumayo bhala: ['ok'].
	}, zama.
}.

obj task.