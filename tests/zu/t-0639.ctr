
Server init.
Okuphumayo bhala: ['Database test'], umugqa-omusha.

>> db := Maria-DB okusha umsingathi: ['localhost'],
	igama-lomsebenzisi: ['xo'], 
	iphasiwedi: ['pass123'],
	igama-lesizindalwazi: ['xobase'],
	xhumana.

>> amapharamitha-okusesha :=
db umbuzo: ['SELECT REPEAT('Blah',1000) AS blah'], 
landa: { :row 
	Okuphumayo bhala: row blah ubude, umugqa-omusha.
}.
