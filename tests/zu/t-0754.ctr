Okuphumayo bhala: ['Test object'], umugqa-omusha.
>> a := Into okusha. 

a uma-kufika: ['item:'] yenza: { :out
	okwakho out := out. 
}.

a uma-kufika: ['item'] yenza: { <- okwakho out.
}.

a uma-kufika: ['greet'] yenza: {
	Okuphumayo bhala: ['hi from original out!'], umugqa-omusha.
}.

a item: Okuphumayo.

Okuphumayo bhala: a item, umugqa-omusha.

>> old-out-address := a item isibonelo-sokuqala ikheli-lenkumbulo.
a save-as: ['/tmp/a.bin'].
Okuphumayo bhala: ['========== RELOADING SNAP:'], umugqa-omusha.

>> b := Into load-from: ['/tmp/a.bin'].

(b item isibonelo-sokuqala ikheli-lenkumbulo = old-out-address) iqiniso: {
	Okuphumayo bhala: ['Object link re-attached.'], umugqa-omusha.
}.

b item bhala: ['hello from loaded out!'], umugqa-omusha.
b greet.
