Server init.

>> DB := Maria-DB okusha umsingathi: ['localhost'],
	igama-lomsebenzisi: ['xo'],
	iphasiwedi: ['pass123'],
	igama-lesizindalwazi: ['xobase'],
	xhumana.

{
	DB umbuzo:
	['DROP TABLE movies'],
	enza-umyalo.
} bamba: { Lutho. }, qala.

DB umbuzo:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
enza-umyalo.

DB umbuzo: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
amapharamitha: ( Uhlu okusha ; ['Halloween'] ),
enza-umyalo.

DB umbuzo: ['SELECT * FROM movies'],
landa: { :movie
	Okuphumayo bhala: movie title, umugqa-omusha.
}.

