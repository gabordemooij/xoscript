Inombolo uma-kufika: ['roman'] yenza: {
	>> inombolo := uqobo kopisha.
	>> roman := [''].
	{
		{
			(inombolo ≥ 1000) iqiniso: {
				roman engeza-ekugcineni: ['Ⅿ'].
				inombolo khipha: 1000.
			}, nqamula.
		
			(inombolo ≥ 500) iqiniso: {
				roman engeza-ekugcineni: ['Ⅾ'].
				inombolo khipha: 500.
			}, nqamula.
		
			(inombolo ≥ 100) iqiniso: {
				roman engeza-ekugcineni: ['Ⅽ'].
				inombolo khipha: 100.
			}, nqamula.
		
			(inombolo ≥ 50) iqiniso: {
				roman engeza-ekugcineni: ['Ⅼ'].
				inombolo khipha: 50.
			}, nqamula.
		
			(inombolo ≥ 50) iqiniso: {
				roman engeza-ekugcineni: ['Ⅼ'].
				inombolo khipha: 50.
			}, nqamula.
		
			(inombolo ≥ 10) iqiniso: {
				roman engeza-ekugcineni: ['Ⅹ'].
				inombolo khipha: 10.
			}, nqamula.
			
			(inombolo ≥ 9) iqiniso: {
				roman engeza-ekugcineni: ['Ⅸ'].
				inombolo khipha: 9.
			}, nqamula.
			
			(inombolo ≥ 5) iqiniso: {
				roman engeza-ekugcineni: ['Ⅴ'].
				inombolo khipha: 5.
			}, nqamula.
			
			(inombolo ≥ 4) iqiniso: {
				roman engeza-ekugcineni: ['Ⅳ'].
				inombolo khipha: 4.
			}, nqamula.
			
			(inombolo ≥ 1) iqiniso: {
				roman engeza-ekugcineni: ['Ⅰ'].
				inombolo khipha: 1.
			}, nqamula.
		} inqubo.
	} ngenkathi: { <- inombolo > 0. }. <- roman.
}.

Okuphumayo bhala: 1 roman, umugqa-omusha.
Okuphumayo bhala: 2 roman, umugqa-omusha.
Okuphumayo bhala: 4 roman, umugqa-omusha.
Okuphumayo bhala: 8 roman, umugqa-omusha.
Okuphumayo bhala: 16 roman, umugqa-omusha.
Okuphumayo bhala: 32 roman, umugqa-omusha.
Okuphumayo bhala: 64 roman, umugqa-omusha.
Okuphumayo bhala: 128 roman, umugqa-omusha.
Okuphumayo bhala: 256 roman, umugqa-omusha.
Okuphumayo bhala: 1024 roman, umugqa-omusha.
