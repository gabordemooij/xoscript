# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Isisefo dala-okhiye.

# private (secret) key
>> sk := keys okokuqala.

# public key
>> pk := keys okokugcina.

# sign a message
>> sig := Isisefo sayina: ['abc'] nge: sk.

# check message (ok)
Okuphumayo bhala: ( 
	Isisefo
		hlola: ['abc'] 
		isiginesha: sig 
		nge: pk 
), umugqa-omusha.

# check message (fail)
Okuphumayo bhala: ( 
	Isisefo 
		hlola: ['abd'] 
		isiginesha: sig 
		nge: pk 
), umugqa-omusha.