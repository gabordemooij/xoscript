
Umbhalo uma-kufika: ['html'] yenza: { <- (
		uqobo
		buyisela: ['&'] nge: ['&amp;'],
		buyisela: ['<'] nge: ['&lt;'],
		buyisela: ['>'] nge: ['&gt;'],
		buyisela: ['"'] nge: ['&quot;']
	).
}.

>> HtmlBrush := Into okusha.

HtmlBrush uma-kufika: ['phendula:'] yenza: { :tag
	Okuphumayo bhala: (['<tag>↵'] tag: tag ).
}.

HtmlBrush uma-kufika: ['phendula:futhi:'] yenza: { :tag :content
	tag := ( tag kusuka: 0 ubude: (tag ubude - 1) ).
	Okuphumayo bhala: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush uma-kufika: ['content:'] yenza: { :text
	Okuphumayo bhala: text html, umugqa-omusha.
}.

HtmlBrush uma-kufika: ['attr:value:'] yenza: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush okusha.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
