

Uhlu uma-kufika: ['column:'] yenza: { :column
	>> result := Uhlu okusha.
	uqobo ngamunye: { :index :row
		row ngamunye: { :index :cell
			(index = column) iqiniso: { result engeza-ekugcineni: cell. }.
		}.
	}. <- result.
}.


>> a := Uhlu ←
	(Uhlu ← 1 ; 2 ; 3) ;
	(Uhlu ← 4 ; 5 ; 6) ;
	(Uhlu ← 7 ; 8 ; 9).

>> b := a column: 1.
Okuphumayo bhala: b, umugqa-omusha.

b := a column: 20.
Okuphumayo bhala: b, umugqa-omusha.

b := a column: -100.
Okuphumayo bhala: b, umugqa-omusha.
