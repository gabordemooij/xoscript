#Linux

 >> t := Isikhathi okusha.
 
t indawo-yesikhathi: ['Europe/Amsterdam'].
t unyaka: 2020, inyanga: 8, usuku: 2, ihora: 21, umzuzu: 2, isekhondi: 1.

>> a := t ihora.
>> ams := t indawo-yesikhathi.

t indawo-yesikhathi: ['US/Hawaii'].
>> b := t ihora.
>> hw := t indawo-yesikhathi.

Okuphumayo
bhala: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		lokhu: ['later'] noma-lokho: ['earlier']
	)
),
umugqa-omusha.
 