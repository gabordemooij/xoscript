>> phrases := Uhlu okusha
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases ngamunye: { :_ :phrase 
	>> e := Server base64-faka-ikhodi: phrase.
	>> d := Server base64-khipha-ikhodi: e.
	Okuphumayo bhala: (
		message kopisha ~encoded: e, ~decoded: d
	), umugqa-omusha.
}.
