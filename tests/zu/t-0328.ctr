Uhlelo ukuphathwa-kwenkumbulo: 4.

>> Doubler := Into okusha.
>> Multiplier := Into okusha.
Doubler uma-kufika: ['double:and:'] yenza: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier uma-kufika: ['multiply:and:'] yenza: { :x :y <- (x × y).
}.

Okuphumayo bhala: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), umugqa-omusha.
