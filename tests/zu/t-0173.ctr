

Uhlu uma-kufika: ['sum'] yenza: {
	>> total := 0.
	uqobo ngamunye: { :index :element
		total engeza: element.
	}. <- total.
}.

Uhlu uma-kufika: ['product'] yenza: {
	>> total := 1.
	uqobo ngamunye: { :index :element
		total phindaphinda-ngo: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Uhlelo ukuphathwa-kwenkumbulo: 0.

{

>> a := Uhlu ← ['hello'] ; ['world'] ; Iqiniso ; Lutho ; 666.
a := a + ( Uhlu ← 1 ).
Okuphumayo bhala: ( ['sum: '] + ( a sum ) ), umugqa-omusha.
Okuphumayo bhala: ( ['min: '] + ( a ubuncane ) ), umugqa-omusha.
Okuphumayo bhala: ( ['max: '] + ( a ubukhulu ) ), umugqa-omusha.
Okuphumayo bhala: ( ['3rd: '] + ( a ? 2 ) ), umugqa-omusha.
Okuphumayo bhala: ( ['prd: '] + ( a product ) ), umugqa-omusha.
a hlela: { :a :b <- (b - a). }.
a ngamunye: { :i :e Okuphumayo bhala: ( i - 0 ), umugqa-omusha. }.

} qala.

Uhlelo hlanza.
usedMemory1 := (Uhlelo inkumbulo ? 0).


{

>> a := Uhlu ← ['hello'] ; ['world'] ; Iqiniso ; Lutho ; 666.
a := a + ( Uhlu ← 1 ).
Okuphumayo bhala: ( ['sum: '] + ( a sum ) ), umugqa-omusha.
Okuphumayo bhala: ( ['min: '] + ( a ubuncane ) ), umugqa-omusha.
Okuphumayo bhala: ( ['max: '] + ( a ubukhulu ) ), umugqa-omusha.
Okuphumayo bhala: ( ['3rd: '] + ( a ? 2 ) ), umugqa-omusha.
Okuphumayo bhala: ( ['prd: '] + ( a product ) ), umugqa-omusha.
a hlela: { :a :b <- (b - a). }.
a ngamunye: { :i :e Okuphumayo bhala: ( i - 0 ), umugqa-omusha. }.

} qala.



Uhlelo hlanza.
usedMemory2 := (Uhlelo inkumbulo ? 0).


{

>> a := Uhlu ← ['hello'] ; ['world'] ; Iqiniso ; Lutho ; 666.
a := a + ( Uhlu ← 1 ).
Okuphumayo bhala: ( ['sum: '] + ( a sum ) ), umugqa-omusha.
Okuphumayo bhala: ( ['min: '] + ( a ubuncane ) ), umugqa-omusha.
Okuphumayo bhala: ( ['max: '] + ( a ubukhulu ) ), umugqa-omusha.
Okuphumayo bhala: ( ['3rd: '] + ( a ? 2 ) ), umugqa-omusha.
Okuphumayo bhala: ( ['prd: '] + ( a product ) ), umugqa-omusha.
a hlela: { :a :b <- (b - a). }.
a ngamunye: { :i :e Okuphumayo bhala: ( i - 0 ), umugqa-omusha. }.

} qala.



Uhlelo hlanza.
usedMemory3 := (Uhlelo inkumbulo ? 0).

( usedMemory1 = usedMemory2 futhi: usedMemory1 = usedMemory3, futhi: usedMemory2 = usedMemory3 ) iqiniso: {
	Okuphumayo bhala: ['No memory leaks here'].
}, amanga: {
	Okuphumayo bhala: ['Leaking memory...'].
}.
