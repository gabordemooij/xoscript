>> HTML := Into okusha.
HTML uma-kufika: ['phendula:'] yenza: { :tag 
	Okuphumayo bhala: (['<tag>'] tag: tag), umugqa-omusha.
}.
HTML uma-kufika: ['phendula:futhi:'] yenza: { :tag :html 
	Okuphumayo bhala: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), umugqa-omusha.
}.
>> html := HTML okusha.
html body h1: ['header'].

