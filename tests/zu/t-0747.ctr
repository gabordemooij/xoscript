Okuphumayo bhala: ['Test object'], umugqa-omusha.
>> a := Into okusha. 

a uma-kufika: ['item:'] yenza: { :num
	okwakho num := num. 
}.

a uma-kufika: ['item'] yenza: { <- okwakho num.
}.

a item: 123.

Okuphumayo bhala: a item, umugqa-omusha.

>> old-num-address := a item isibonelo-sokuqala ikheli-lenkumbulo.
a save-as: ['/tmp/a.bin'].
Okuphumayo bhala: ['========== RELOADING SNAP:'], umugqa-omusha.

>> b := Into load-from: ['/tmp/a.bin'].

(b item isibonelo-sokuqala ikheli-lenkumbulo = old-num-address) iqiniso: {
	Okuphumayo bhala: ['Object link re-attached.'], umugqa-omusha.
}.

Okuphumayo bhala: b item, umugqa-omusha.
