>> str := ['write:'].
Okuphumayo umyalezo: ['bhala:'] okufakwayo: (Uhlu ← ['Hello World']), umugqa-omusha. 

Inombolo uma-kufika: ['isbetween:and:'] yenza: { :a :b <- ((uqobo ≥ a) futhi: (uqobo ≤ b)).
}.

str := ['isbetween:and:'].
Okuphumayo bhala: (3 umyalezo: str okufakwayo: (Uhlu ← 2 ; 8)), umugqa-omusha.
Okuphumayo bhala: (3 umyalezo: str okufakwayo: (Uhlu ← 1 ; 2)), umugqa-omusha.


>> CoffeeMachine := Into okusha.
CoffeeMachine uma-kufika: ['makeCoffeeWithSugar:milk:'] yenza: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Uhlu ← 4 ; 2.
Okuphumayo bhala: ( CoffeeMachine umyalezo: order okufakwayo: coffeeConfiguration ), umugqa-omusha.
