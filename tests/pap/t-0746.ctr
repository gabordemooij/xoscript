Salida skirbi: ['Test object'], liña-nobo.
>> a := Opheto nobo. 

a ora: ['item:'] hasi: { :dict
	propio dict := dict. 
}.

a ora: ['item'] hasi: { <- propio dict.
}.

a item: (
Dikshonario nobo
	hello: ['world'],
	world: (Dikshonario nobo pone: ['a'] na: ['b'])).

Salida skirbi: a item, liña-nobo.

>> old-dict-address := a item prototipo adrès-di-memoria.
a save-as: ['/tmp/a.bin'].
Salida skirbi: ['========== RELOADING SNAP:'], liña-nobo.

>> b := Opheto load-from: ['/tmp/a.bin'].

(b item prototipo adrès-di-memoria = old-dict-address) bèrdat: {
	Salida skirbi: ['Object link re-attached.'], liña-nobo.
}.

Salida skirbi: b item, liña-nobo.
