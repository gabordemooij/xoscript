Server init.
Salida skirbi: ['Database date test'], liña-nobo.

>> db := Maria-DB nobo anfitrion: ['localhost'],
	nòmber-di-usuario: ['xo'], 
	kontraseña: ['pass123'],
	nòmber-di-base: ['xobase'],
	konektá.

>> parameternan-di-buskeda :=
db konsulta: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
trese: { :row
	Salida skirbi: row datetest, liña-nobo.
}.
