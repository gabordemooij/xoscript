

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> x := 100.

Programa maneho-di-memoria: 0.

{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt agregá-na-fin: ['!!'].
Salida skirbi: txt.
} kuminsá.

Programa limpia.

usedMemory1 := (Programa memoria ? 0).


