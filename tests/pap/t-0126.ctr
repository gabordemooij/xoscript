#Linux
>> Slurp := Opheto nobo.

Slurp ora: ['nobo'] hasi: {
	propio str := [''].
}.

Slurp ora: ['nieuw'] hasi: {
	propio str := [''].
}.

Slurp ora: ['kontestá:'] hasi: { :blah
		propio str agregá-na-fin: blah.
}.

Slurp ora: ['kontestá:i:'] hasi: { :blah :blahah
		propio str agregá-na-fin: (blah kuminsá: 0 largura: (blah largura - 1)).
		propio str agregá-na-fin: [' '].
		propio str agregá-na-fin: blahah.
}.

Slurp ora: ['obtain'] hasi: {
	>> buffer := propio str.
	propio str := ['']. <- buffer.
}.


Salida skirbi: (Programa sistema: (Slurp nobo echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Archivo nobo: ['/tmp/from.txt'], kita-for-di-disko. } kapta: { ['Empty']. }, kuminsá.
{ Archivo nobo: ['/tmp/to.txt'], kita-for-di-disko. } kapta: { ['Empty']. }, kuminsá.


Archivo nobo: ['/tmp/to.txt'], ta-eksistí falsu: {
	Salida skirbi: ['Confirmed. Target file does not exist.\
'].
}.
Archivo nobo: ['/tmp/from.txt'], ta-eksistí falsu: {
	Salida skirbi: ['Confirmed. Source file does not exist.\
'].
}.



Programa sistema: (Slurp nobo touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Programa sistema: (Slurp nobo cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Archivo nobo: ['/tmp/to.txt'], ta-eksistí bèrdat: {
	Salida skirbi: ['Confirmed. Target file has been created by shell.\
'].
}.


Salida skirbi: ['Contents of file is:'] + (Archivo nobo: ['/tmp/to.txt'], lesa), liña-nobo.
