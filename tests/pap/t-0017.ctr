Number ora: ['factorial'] hasi: {
	>> total := 1.
	{ :index total multipliká-ku: (mes - (index)). } × mes. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Salida skirbi: a.
>> b := 2 + 3 factorial.
Salida skirbi: b.
>> c := 3 factorial + 2.
Salida skirbi: c.
>> d := 2 + (3 factorial).
Salida skirbi: d.
Salida skirbi: 2 + 3 factorial + 1.
