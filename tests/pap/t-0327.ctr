

Lista ora: ['fixture:'] hasi: { :f
	propio fixture := f.
}.

Lista ora: ['konta'] hasi: { <- propio fixture.
}.

Lista ora: ['aantal'] hasi: { <- propio fixture.
}.


>> x := Nada.
{

	x := ['hello'] 
	remplasá:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] lèter: 2)
			)
		)
	ku: (
		(['...hal'] + ['lo']) 
			lèter-grandi 
			lowecase 
			lèter-grandi 
			salta: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Lista ← 0 ; 1 ; 4; 9 ; (Lista ← 0 ; 3; 1) ; 4
							) penúltimo
						) ? 1
					) + 
					((Lista ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					konta
				)
			)
	).

} × 10.
Salida skirbi: x, liña-nobo.

