

Programa maneho-di-memoria: 1.

>> x := 0.
>> y := ['Hello'].
>> q := { ['']. }.
>> p := Bèrdat.
>> a := Lista ← 1 ; 2 ; 3 ; 4.
>> c := Opheto nobo.
c ora: ['greet:'] hasi: { Salida skirbi: ['greet!']. }.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.
>> usedMemory5 := 0.

Programa limpia.
>> usedMemory1 := (Programa memoria ? 0).




x := 1.
y := ['Hello'].
q := { ['']. }.
p := Bèrdat.
a := Lista ← 1 ; 2 ; 3 ; 5.
c := Opheto nobo.
c ora: ['greet:'] hasi: { Salida skirbi: ['greet!']. }.


Programa limpia.
>> usedMemory2 := (Programa memoria ? 0).




x := 2.
y := ['Hello'].
q := { ['']. }.
p := Bèrdat.
a := Lista ← 1 ; 2 ; 3 ; 4.
c := Opheto nobo.
c ora: ['greet:'] hasi: { Salida skirbi: ['greet!']. }.

Programa limpia.
>> usedMemory3 := (Programa memoria ? 0).




x := 3.
y := ['Hello'].
q := { ['']. }.
p := Bèrdat.
a := Lista ← 1 ; 2 ; 3 ; 5.
c := Opheto nobo.
c ora: ['greet:'] hasi: { Salida skirbi: ['greet!']. }.
c := Opheto nobo.
c ora: ['greet:'] hasi: { Salida skirbi: ['a different greet!'], liña-nobo. }.


Programa limpia.
>> usedMemory4 := (Programa memoria ? 0).





x := 4.
y := ['Hello'].
q := { ['']. }.
p := Bèrdat.
a := Lista ← 1 ; 2 ; 3 ; 4.
c := Opheto nobo.
c ora: ['greet:'] hasi: { Salida skirbi: ['greet!']. }.


Programa limpia.
>> usedMemory5 := (Programa memoria ? 0).




(usedMemory1 = usedMemory2 = usedMemory3 = usedMemory4 = usedMemory5) bèrdat: { 
	Salida skirbi: ['Memory usage remains stable.'], liña-nobo.
}, sino: {
	Salida skirbi: ['Used memory not stable.'], liña-nobo.
}.
