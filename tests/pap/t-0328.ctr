Programa maneho-di-memoria: 4.

>> Doubler := Opheto nobo.
>> Multiplier := Opheto nobo.
Doubler ora: ['double:and:'] hasi: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier ora: ['multiply:and:'] hasi: { :x :y <- (x × y).
}.

Salida skirbi: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), liña-nobo.
