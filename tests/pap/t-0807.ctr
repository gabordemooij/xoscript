# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB nobo anfitrion: ['localhost'],
	nòmber-di-usuario: ['xo'],
	kontraseña: ['pass123'],
	nòmber-di-base: ['xobase'],
	konektá.

>> parameternan-di-buskeda := db konsulta: ['SELECT %% FROM'].
{ parameternan-di-buskeda ehekutá. } kapta: { :e
	Salida skirbi: ( e ta-kontené: ['%%'] ), liña-nobo.
}, kuminsá.
