Salida skirbi: ['index of ord = '] + (( txt buska: ['ord'] ) - 0), liña-nobo.
Salida skirbi: ['index of ad = '] + (( txt buska: ['ad'] ) - 0), liña-nobo.
Salida skirbi: ['last index of W = '] + (( txt último-posishon: ['W'] ) - 0), liña-nobo.
Salida skirbi: ['last index of d = '] + (( txt último-posishon: ['d'] ) - 0), liña-nobo.
Salida skirbi: ['txt equals Word Salad = '] + ( txt = ['Word Salad'] ), liña-nobo.
Salida skirbi: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), liña-nobo.
Salida skirbi: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), liña-nobo.
Salida skirbi: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), liña-nobo.

