>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Opheto nobo.
⚄ ora: ['drawFrom:length:'] hasi: { :pool :konta
	
	>> result := [''].
	
	{
		>> index := Number random % (pool largura).
		result agregá-na-fin: ( pool lèter: (index + 1) ).
		
	} × konta. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? largura.
Salida skirbi: (['x↵'] x random largura).
Salida skirbi: (['y↵'] y ?? largura).

