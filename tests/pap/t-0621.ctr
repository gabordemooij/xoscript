>> phrases := Lista nobo
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases kada: { :_ :phrase 
	>> e := Server base64-kodifiká: phrase.
	>> d := Server base64-dekodifiká: e.
	Salida skirbi: (
		message kopia ~encoded: e, ~decoded: d
	), liña-nobo.
}.
