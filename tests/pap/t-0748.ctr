Salida skirbi: ['Test object'], liña-nobo.
>> a := Opheto nobo. 

a ora: ['item:'] hasi: { :boleano
	propio boleano := boleano. 
}.

a ora: ['item'] hasi: { <- propio boleano.
}.

a item: Bèrdat.

Salida skirbi: a item, liña-nobo.

>> old-bool-address := a item prototipo adrès-di-memoria.
a save-as: ['/tmp/a.bin'].
Salida skirbi: ['========== RELOADING SNAP:'], liña-nobo.

>> b := Opheto load-from: ['/tmp/a.bin'].

(b item prototipo adrès-di-memoria = old-bool-address) bèrdat: {
	Salida skirbi: ['Object link re-attached.'], liña-nobo.
}.

Salida skirbi: b item, liña-nobo.
