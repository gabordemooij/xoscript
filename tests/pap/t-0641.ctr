# Test utf8 sanitizer
Server init.

>> utf8cases := Dikshonario nobo
	# ASCII only
	pone: ( Lista nobo ; 65 ; 65 ; 65 ; 65 ; 0 ) na: ['AAAA'],
	# valid 2 byte sequence
	pone: ( Lista nobo ; 194 ; 162 ; 0 ) na: ['¢'],
	# Valid 3-byte UTF-8
    pone: ( Lista nobo ; 226 ; 130 ; 172 ; 0 ) na: ['€'],
	# Valid 4-byte UTF-8
    pone: ( Lista nobo ; 240 ; 144 ; 141 ; 136 ; 0 ) na: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    pone: ( Lista nobo ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) na: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    pone: ( Lista nobo ; 65 ; 193 ; 129 ; 0 ) na: ['A?'],
	# Invalid first byte (0xFF)
    pone: ( Lista nobo ; 255 ; 0 ) na: ['?'],
	# Incomplete multi-byte sequence at end
    pone: ( Lista nobo ; 66 ; 226 ; 0 ) na: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    pone: ( Lista nobo ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) na: ['A€?𐍈B'].
	 
utf8cases kada: { :key :value
	>> blob := Blob nobo: value konta, bytes: value.
	>> str := blob teksto.
	(str = key) bèrdat: {
		Salida skirbi: ['OK'], liña-nobo.
	}, sino: {
		Salida skirbi: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, liña-nobo.
	}.
	blob libra.
}.
