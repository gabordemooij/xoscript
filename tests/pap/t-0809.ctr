# backslashes must survive code serialization, strings must not end early
>> balornan := Lista nobo
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

balornan kada: { :i :value
	>> d := Dikshonario nobo.
	d pone: value na: ['k'].
	>> r := d kódigo opheto.
	Salida skirbi: r konta, liña-nobo.
	Salida skirbi: ( (r na: ['k']) = value ), liña-nobo.
}.
