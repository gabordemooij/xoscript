# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Kaha-fuerte 
	hash-di-kontraseña: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Kaha-fuerte 
	hash-di-kontraseña: hash verifiká: a1.
	# fail 
>> b := Kaha-fuerte
	hash-di-kontraseña: hash verifiká: a2.
	# ok!

Salida skirbi: a, liña-nobo.
Salida skirbi: b, liña-nobo.

