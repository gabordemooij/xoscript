# catch-all test (practical)
>> HTML := Teksto nobo.
HTML ora: ['encode:'] hasi: { :tekst
	mes agregá-na-fin: (tekst
	remplasá: ['&'] ku: ['&amp;'], 
	remplasá: ['<'] ku: ['&lt;'],
	remplasá: ['>'] ku: ['&gt;'],
	remplasá: ['"'] ku: ['&quot;']).
}.
>> blog := HTML nobo.
blog agregá-na-fin: ['<h1>'],
     encode: ['Koffie & Thee'],
     agregá-na-fin: ['</h1>'].
Salida skirbi: blog, liña-nobo.


>> Roman := Number nobo.
Roman ora: ['stringy'] hasi: {
	>> a := [''].
	{ a agregá-na-fin: ['I']. } × mes. <- a.
}.

>> x := Roman nobo.
x suma: 3.
Salida skirbi: x stringy, liña-nobo.

>> Quantum := Boleano nobo.
Quantum ora: ['true?'] hasi: { <- ['maybe True']. }.
Salida skirbi: (Quantum nobo true?), liña-nobo.

>> Nihil := Nada nobo.
Nihil ora: ['teksto'] hasi: { <- ['Nihil']. }.
Salida skirbi: (Nihil nobo), liña-nobo.
