

Programa limpia.


>> Veggy := Opheto nobo.
Veggy ora: ['nobo'] hasi: {
	>> v := mes nobo.
	v init. <- v.
}.

Veggy ora: ['init'] hasi: { propio veggies := 0. }.

Veggy ora: ['carrots:'] hasi: { :a propio veggies := a. <- Nada. }.
Veggy ora: ['carrots'] hasi: { <- propio veggies. }.
Veggy ora: ['+'] hasi: { :f
	>> n := Veggy nobo.
	n carrots: (f carrots + propio veggies). <- n.
}.

Veggy ora: ['teksto'] hasi: { <- propio veggies teksto.
}.

Number ora: ['carrots'] hasi: {
	>> x := Veggy nobo.
	x carrots: mes. <- x.
}.

Number ora: ['add:and:'] hasi: { :a :b <- (a + b).
}.

>> q := 0 add: (3 carrots + 2 carrots) and: 4 carrots.
Salida skirbi: q, liña-nobo.
