Server init.

# write a test file
>> f := Archivo nobo: ['/tmp/test.gif'].
f skirbi: ['GIF87a01234567810'].

# serve the file
Server pasa: ['test.gif'] prefiho: ['/tmp/'].

Salida liña-nobo.

Salida skirbi: ['Outside container (security):'], liña-nobo.
{ Server pasa: ['../passwd'] prefiho: ['/tmp/']. }
kapta: { :e Salida skirbi: e, liña-nobo. },
kuminsá.

Salida skirbi: ['Invalid prefix:'], liña-nobo.
{ Server pasa: ['test.gif'] prefiho: ['z:\\']. }
kapta: { :e Salida skirbi: e, liña-nobo. },
kuminsá.

Salida skirbi: ['Non-existant file:'], liña-nobo.
{ Server pasa: ['xxx.xxx'] prefiho: ['/tmp/']. }
kapta: { :e Salida skirbi: e, liña-nobo. },
kuminsá.
