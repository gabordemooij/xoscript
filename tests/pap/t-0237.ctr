
Teksto ora: ['evaluate'] hasi: {
	>> kódigo := Archivo nobo: ['/tmp/eval.ctr'].
	kódigo skirbi: (mes teksto + ['.']).
	Programa usa: ['/tmp/eval.ctr'].
}.

>> map :=
	(Dikshonario nobo)
	pone: ['Hi There'] na: ['two'],
	pone: (Lista ← ['hello'] ; ['world'] ; (Lista ← 1 ; 2; 9) ; Falsu) na: ['one'],
	pone: ( (Dikshonario nobo) pone: ['wrrld'] na: ['misspelled'] ) na: ['three'],
	pone: (Lista ← ((Dikshonario nobo) pone: ['treasure'] na: ['hidden']) ; 2) na: ['four']. 
>> str := map teksto.
>> map2 := Nada.
(['map2 := '] + str ) evaluate.
Salida skirbi: map2 ? ['one'] ? 0.
Salida skirbi: map2 ? ['one'] ? 1.
Salida skirbi: map2 ? ['four'] ? 0 ? ['hidden'].
Salida skirbi: map2 ? ['one'] ? 2 ? 2.
