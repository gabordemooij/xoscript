
>> a := Lista ← (Lista ← 100 ; 200 ; 300) ; (Lista ← 9 ; 8 ; 7).
Salida skirbi: ['at 0,1 :'].
Salida skirbi: a ? 0 ? 1, liña-nobo. 
Salida skirbi: ['at 1,2 :'].
Salida skirbi: a ? 1 ? 2, liña-nobo. 
>> menu := Dikshonario nobo.
menu pone: (Lista ← ['pizza'] ; ['spaghetti']) na: ['Italian Cuisine'].
menu pone: (Lista ← ['bifteki'] ; ['suflaki']) na: ['Greek Cuisine'].
Salida skirbi: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), liña-nobo. 
Salida skirbi: ['but not on the same plate.'], liña-nobo.
