>> randomizer := { :a :b
	>> mínimo := ( a < b ) esaki: a òf-esei: b.
	>> máksimo := ( a > b ) esaki: a òf-esei: b.
	>> x := Nada.
	{
		x := Number entre: a ku: b.
		((x < mínimo) òf: (x > máksimo)) bèrdat: { 
			Salida skirbi: (['Invalid value!']).
			Programa terminá.
		}.
	} 
	× 100. <- x.
}.
randomizer apliká: 0 i: 0.
randomizer apliká: 1 i: 0.
randomizer apliká: 1 i: 1.
randomizer apliká: 0 i: 1.
randomizer apliká: -1 i: 0.
randomizer apliká: -1 i: -1.
randomizer apliká: 0 i: -1.
randomizer apliká: 100 i: 200.
randomizer apliká: 999999999999998 i: 999999999999999.
