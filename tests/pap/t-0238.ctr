Teksto ora: ['evaluate'] hasi: {
	>> kódigo := Archivo nobo: ['/tmp/eval.ctr'].
	kódigo skirbi: (mes teksto + ['.']).
	Programa usa: ['/tmp/eval.ctr'].
}.

>> a := Lista ← 1 ; 2 ; 3.
>> b := (a teksto).

Salida skirbi: b, liña-nobo. 
(['b := '] + b) evaluate.

Salida skirbi: b ? 2, liña-nobo. 

Salida skirbi: (( Lista ← 1 ; 2 ; 3 )), liña-nobo. 

Salida skirbi: ((Dikshonario nobo) pone: 1 na: 2), liña-nobo. 

>> x := ( (Lista ← 1 ; ( Lista ← 9 ) ; Bèrdat ) ) teksto.
Salida skirbi: x, liña-nobo. 
(['x := '] + x) evaluate.

Salida skirbi: x ? 1 ? 0, liña-nobo. 

>> y := (Dikshonario nobo) pone: (Lista ← 1) na: (Lista ← 2).
Salida skirbi: y, liña-nobo. 

(['y := '] + y) teksto evaluate.

Salida skirbi: (y na: (Lista ← 2) teksto ), liña-nobo.

Salida skirbi: (Lista nobo), liña-nobo. 
Salida skirbi: (Dikshonario nobo), liña-nobo. 
