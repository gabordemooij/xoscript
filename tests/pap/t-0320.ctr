


>> CoffeeMachine := Opheto nobo.
CoffeeMachine ora: ['order:'] hasi: { :id
	>> coffee := ['Americano'].
	( id = 1 ) bèrdat: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) bèrdat: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) bèrdat: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Opheto nobo.
SimpleCoffeeMachine ora: ['order'] hasi: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Salida skirbi: redCup, liña-nobo.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Salida skirbi: greenCup, liña-nobo.
>> yellowCup := CoffeeMachine order: 1.
Salida skirbi: yellowCup, liña-nobo.
>> blueCup := CoffeeMachine order: 0.
Salida skirbi: blueCup, liña-nobo.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Salida skirbi: blackCup, liña-nobo.
blackCup agregá-na-fin: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Salida skirbi: orangeCup, liña-nobo.
