
Lista ora: ['sum'] hasi: {
	>> total := 0.
	mes kada: { :index :element
		total suma: element.
	}. <- total.
}.

>> a := Lista ← 9 ; 8 ; 7.
Salida skirbi: (a sum), liña-nobo. 
>> a := Lista ← 1 ; 9.
Salida skirbi: (a sum), liña-nobo. 
>> a := Lista ← ['o'] ; 2.
Salida skirbi: (a sum), liña-nobo. 
Salida skirbi: (Lista nobo sum), liña-nobo. 
