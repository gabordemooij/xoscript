Number ora: ['roman'] hasi: {
	>> number := mes kopia.
	>> roman := [''].
	{
		{
			(number ≥ 1000) bèrdat: {
				roman agregá-na-fin: ['Ⅿ'].
				number resta: 1000.
			}, stòp-lus.
		
			(number ≥ 500) bèrdat: {
				roman agregá-na-fin: ['Ⅾ'].
				number resta: 500.
			}, stòp-lus.
		
			(number ≥ 100) bèrdat: {
				roman agregá-na-fin: ['Ⅽ'].
				number resta: 100.
			}, stòp-lus.
		
			(number ≥ 50) bèrdat: {
				roman agregá-na-fin: ['Ⅼ'].
				number resta: 50.
			}, stòp-lus.
		
			(number ≥ 50) bèrdat: {
				roman agregá-na-fin: ['Ⅼ'].
				number resta: 50.
			}, stòp-lus.
		
			(number ≥ 10) bèrdat: {
				roman agregá-na-fin: ['Ⅹ'].
				number resta: 10.
			}, stòp-lus.
			
			(number ≥ 9) bèrdat: {
				roman agregá-na-fin: ['Ⅸ'].
				number resta: 9.
			}, stòp-lus.
			
			(number ≥ 5) bèrdat: {
				roman agregá-na-fin: ['Ⅴ'].
				number resta: 5.
			}, stòp-lus.
			
			(number ≥ 4) bèrdat: {
				roman agregá-na-fin: ['Ⅳ'].
				number resta: 4.
			}, stòp-lus.
			
			(number ≥ 1) bèrdat: {
				roman agregá-na-fin: ['Ⅰ'].
				number resta: 1.
			}, stòp-lus.
		} prosedura.
	} mientras: { <- number > 0. }. <- roman.
}.

Salida skirbi: 1 roman, liña-nobo.
Salida skirbi: 2 roman, liña-nobo.
Salida skirbi: 4 roman, liña-nobo.
Salida skirbi: 8 roman, liña-nobo.
Salida skirbi: 16 roman, liña-nobo.
Salida skirbi: 32 roman, liña-nobo.
Salida skirbi: 64 roman, liña-nobo.
Salida skirbi: 128 roman, liña-nobo.
Salida skirbi: 256 roman, liña-nobo.
Salida skirbi: 1024 roman, liña-nobo.
