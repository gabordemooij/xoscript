Salida skirbi: ['Test object'], liña-nobo.
>> a := Opheto nobo. 

a ora: ['item:'] hasi: { :moment
	propio moment := moment. 
}.

a ora: ['item'] hasi: { <- propio moment.
}.

>> today := Momento nobo zona-di-tempu: ['CEST'], aña: 2026, luna: 7.
a item: today.
Salida skirbi: a item, liña-nobo.
a save-as: ['/tmp/a.bin'].

