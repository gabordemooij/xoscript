Salida skirbi: ['Test object'], liña-nobo.
>> a := Opheto nobo. 

a ora: ['item:'] hasi: { :out
	propio out := out. 
}.

a ora: ['item'] hasi: { <- propio out.
}.

a ora: ['greet'] hasi: {
	Salida skirbi: ['hi from original out!'], liña-nobo.
}.

a item: Salida.

Salida skirbi: a item, liña-nobo.

>> old-out-address := a item prototipo adrès-di-memoria.
a save-as: ['/tmp/a.bin'].
Salida skirbi: ['========== RELOADING SNAP:'], liña-nobo.

>> b := Opheto load-from: ['/tmp/a.bin'].

(b item prototipo adrès-di-memoria = old-out-address) bèrdat: {
	Salida skirbi: ['Object link re-attached.'], liña-nobo.
}.

b item skirbi: ['hello from loaded out!'], liña-nobo.
b greet.
