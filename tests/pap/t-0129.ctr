
Lista ora: ['product'] hasi: {
	>> total := 1.
	mes kada: { :index :element
		total multipliká-ku: element.
	}. <- total.
}.

>> a := Lista ← 1 ; 2 ; 3.
Salida skirbi: a product, liña-nobo.
Salida skirbi: (Lista ← 2 ; 4 ; 8) product, liña-nobo. 
Salida skirbi: (Lista ← -2 ; 10) product, liña-nobo. 
Salida skirbi: (Lista ← 0.5 ; -2) product, liña-nobo. 
