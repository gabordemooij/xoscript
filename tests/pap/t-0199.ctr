
Programa maneho-di-memoria: 4.

>> Animal := Opheto nobo.
Animal ora: ['make'] hasi: {
	>> animal := Opheto nobo.
	animal ora: ['makeSound'] hasi: {
		Salida skirbi: propio sound.
	}. <- animal.
}.
>> Cat := Opheto nobo.
Cat ora: ['make'] hasi: {
	>> cat := Animal make.
	cat ora: ['init'] hasi: {
		propio sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
