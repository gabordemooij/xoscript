>> x := Opheto nobo.
>> y := Opheto nobo.
>> z := x.
Salida skirbi: (x = z), liña-nobo.
Salida skirbi: (x = y), liña-nobo.
Salida skirbi: (x ≠ y), liña-nobo.
Salida skirbi: (x ≠ z), liña-nobo.
>> m := Momento nobo aña: 2070, luna: 11.
>> n := m kopia.
Salida skirbi: (m = n), liña-nobo.
Salida skirbi: (m ≠ n), liña-nobo.
Salida skirbi: (m meskos: m), liña-nobo.
Salida skirbi: (m meskos: n), liña-nobo.
n luna: 12.
Salida skirbi: (m ≠ n), liña-nobo.
Salida skirbi: (m = n), liña-nobo.


