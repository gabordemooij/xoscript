
>> countries := Lista nobo
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Lista nobo
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods segun: countries, kada: { :key :value
	counter suma: 1.
}.

Salida skirbi: (['we serve counter dishes'] counter: counter), liña-nobo.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] lèternan ordená: { :v
	counter suma: 0.
}.

Salida skirbi: (['we sort counter dishes'] counter: counter), liña-nobo.


>> counter := 0.
{
	{
		counter suma: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Salida skirbi: (['we calculate counter numbers.'] counter: counter), liña-nobo.

