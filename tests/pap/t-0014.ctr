>> Greeter := Opheto nobo.
Greeter ora: ['make'] hasi: {
	>> gr := Opheto nobo.
	gr ora: ['setName:'] hasi: { :aname
		propio nòmber := aname.
	}.
	gr ora: ['greet'] hasi: {
		Salida skirbi: propio nòmber.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a nobo.
c setName: ['THREE'].
c greet.
>> d := a nobo.
d setName: ['FOUR'].
d greet.
c greet.
