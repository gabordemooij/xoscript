Server init.
>> fmt := Formato nobo: ['%#3x'].

>> blob := Blob nobo: 4.
blob bytes: ( 
	Lista nobo ; 0 ; 1 ; 2 ; 3
).

>> file := Archivo nobo: ['/tmp/blob'].
file blob: blob.
blob libra.

>> lesa := file blob.
lesa 
kuminsá: 0 
largura: 4, 
hasi kada: { :i :b 
	Salida
	skirbi: (fmt apliká-number-entero: b),
	liña-nobo.
}.
lesa libra.
