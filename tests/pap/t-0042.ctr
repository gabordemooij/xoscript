>> items := Dikshonario nobo.
items pone: ['black'] na: ['coffee'], pone: ['earl grey'] na: ['tea'].
Salida skirbi: (items na: ['coffee']), skirbi: (items na: ['tea']).
Salida skirbi: ['there are'] + items konta + [' items in the array.'].
items pone: ['capuccino'] na: ['coffee'].
Salida skirbi: ['Now my coffee is.. '] + (items na: ['coffee']).
items pone: ['aaa'] na: ['1'].
items pone: ['bbb'] na: ['2'].
Salida skirbi: (items na: ['a']).
