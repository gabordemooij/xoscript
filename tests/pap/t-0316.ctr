>> Grandfather := Opheto nobo.
Grandfather ora: ['greet'] hasi: {
	Salida skirbi: ['Ave!'], liña-nobo.
}.
>> Father := Grandfather nobo.
Father ora: ['greet'] hasi: {
	Salida skirbi: ['Hello'], liña-nobo.
	mes greet.
}.
>> Son := Father nobo.
Son ora: ['greet'] hasi: {
	Salida skirbi: ['Hi'], liña-nobo.
	mes greet.
}.

Son greet.

>> Roundabout := Opheto nobo.
Roundabout ora: ['circle:'] hasi: { :x
	Salida skirbi: x, liña-nobo.
	(x < 3) bèrdat: { mes rekursivo circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) bèrdat: { Salida skirbi: x, liña-nobo. x suma: 1.  increment kuminsá. }. }.
increment kuminsá.