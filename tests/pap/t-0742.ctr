Salida skirbi: ['Test object'], liña-nobo.
>> a := Opheto nobo. 

a ora: ['item:'] hasi: { :hexhelper
	propio hexhelper := hexhelper. 
}.

a ora: ['item'] hasi: { <- propio hexhelper.
}.

a item: Hx nobo.

>> old-hexhelper-address := a item prototipo adrès-di-memoria.
a save-as: ['/tmp/a.bin'].
Salida skirbi: ['========== RELOADING SNAP:'], liña-nobo.

>> b := Opheto load-from: ['/tmp/a.bin'].

(b item prototipo adrès-di-memoria = old-hexhelper-address) bèrdat: {
	Salida skirbi: ['Object link re-attached.'], liña-nobo.
}.
