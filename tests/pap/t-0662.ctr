>> t := Nada.

# you can control the time zone for
# parsing like this:
Momento zona-di-tempu: ['CET'].
t := Momento for-di: ['1981-02-03 04:05:06'].
Salida skirbi: t, liña-nobo.

# now using CEST time zone:
Momento zona-di-tempu: ['CEST'].
t := Momento for-di: ['1981-02-03 04:05:06'].
Salida skirbi: t, liña-nobo.

# error if string cannot be parsed
{ Momento for-di: ['1900']. } kapta: { Nada. }, kuminsá.
