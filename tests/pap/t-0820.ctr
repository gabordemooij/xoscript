# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Patronchi nobo: pattern.
	p kuadra: subject hasi: { :m :g
		Salida skirbi: g konta, skirbi: [' '], skirbi: (g uni: ['|']), liña-nobo. <- m.
	}.
}.
show apliká: ['(a)|(b)'] i: ['b'].
show apliká: ['(a)|(b)'] i: ['a'].
show apliká: ['(x)?y'] i: ['y'].
show apliká: ['(x)?(y)(z)?'] i: ['xy'].
