>> Point := Opheto nobo.
Point ora: ['x-coordinate:'] hasi: { :x propio x := x. }.
Point ora: ['y-coordinate:'] hasi: { :y propio y := y. }.
Point ora: ['x-coordinate']  hasi: { <- propio x kopia. }.
Point ora: ['y-coordinate']  hasi: { <- propio y kopia. }.

Point ora: ['='] hasi: { :other <- ( propio x = other x-coordinate
		 i: propio y = other y-coordinate ).
}.

>> pier := Point nobo x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point nobo x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point nobo x-coordinate: 5, y-coordinate: 6.

Salida skirbi: pier = town-hall, liña-nobo.
Salida skirbi: pier = restaurant, liña-nobo.
