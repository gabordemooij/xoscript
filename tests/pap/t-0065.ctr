Number ora: ['factorial'] hasi: {
	>> total := 1.
	{ :index total multipliká-ku: (mes - (index)). } × mes. <- total.
}.
>> Printer := Opheto nobo.
Printer ora: ['print:and:'] hasi: { :x :y
	Salida skirbi: ['a='] + x + [', b='] + y, liña-nobo.
}.
>> a := 4.5. >> b := a rondia-abou.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a rondia-ariba.
Printer print: a and: b.
a := 4.5. b := a rondia-abou.
Printer print: a and: b.
a := 4.5. b := a rondia.
Printer print: a and: b.
a := 4.2. b := a rondia.
Printer print: a and: b.

Salida skirbi: (9 sobrá: 5), liña-nobo.
Salida skirbi: -666 balor-apsoluto, liña-nobo.
Salida skirbi: 49 rais-kuadrá, liña-nobo.
Salida skirbi: (2 potensia: 3), liña-nobo.
>> l := (Lista ← 9 ; 6).
Salida skirbi: l mínimo.

