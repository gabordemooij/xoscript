
>> Animal := Opheto nobo.
Animal ora: ['nobo'] hasi: { <- mes nobo init.
}.

Animal ora: ['init'] hasi: {
	propio sound := ['?'].
	propio legs := 4.
}.

>> Dog := Animal nobo.
Dog ora: ['init'] hasi: {
	mes init.
	propio sound := ['barks'].
}.

Animal ora: ['teksto'] hasi: { <- propio legs teksto + propio sound.
}.

>> poodle := Dog nobo.
Salida skirbi: poodle, liña-nobo.

