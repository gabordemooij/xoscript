# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Kaha-fuerte generá-yabi.

# private (secret) key
>> sk := keys promé.

# public key
>> pk := keys último.

# sign a message
>> sig := Kaha-fuerte firma: ['abc'] ku: sk.

# check message (ok)
Salida skirbi: ( 
	Kaha-fuerte
		kontrolá: ['abc'] 
		firma: sig 
		ku: pk 
), liña-nobo.

# check message (fail)
Salida skirbi: ( 
	Kaha-fuerte 
		kontrolá: ['abd'] 
		firma: sig 
		ku: pk 
), liña-nobo.