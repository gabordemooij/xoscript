
>> Rectangle := Opheto nobo.

Rectangle ora: ['area'] hasi: { <- propio largura * propio width.
}.

Rectangle ora: ['length:'] hasi: { :largura
	propio largura := largura.
}.

Rectangle ora: ['width:'] hasi: { :width
	propio width := width.
}.

Rectangle ora: ['nobo'] hasi: {
	# this will not result into an infinite loop
	>> rectangle := mes nobo.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle nobo.
Salida skirbi: a area, liña-nobo. #0

>> b := Rectangle nobo length: 2, width: 3.
Salida skirbi: b area, liña-nobo. #6

