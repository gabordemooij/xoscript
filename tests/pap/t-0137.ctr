>> usedMemory5 := (Programa memoria ? 0).




(usedMemory1 = usedMemory2 = usedMemory3 = usedMemory4 = usedMemory5) bèrdat: {
	Salida skirbi: ['Memory usage remains stable.'], liña-nobo.
}, sino: {
	Salida skirbi: ['Used memory not stable.'], liña-nobo.
	Salida skirbi: usedMemory1, liña-nobo.
	Salida skirbi: usedMemory2, liña-nobo.
	Salida skirbi: usedMemory3, liña-nobo.
	Salida skirbi: usedMemory4, liña-nobo.
	Salida skirbi: usedMemory5, liña-nobo.
}.
