


Programa maneho-di-memoria: 0.

>> x := 0.
>> y := ['Hello'].
>> q := { ['Empty']. }.
>> p := Bèrdat.
>> a := Lista ← 1 ; 2 ; 3 ; 4.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa limpia.
usedMemory1 := (Programa memoria ? 0).




x := 1.
y := ['Hello'].
q := { ['Empty']. }.
p := Bèrdat.
a := Lista ← 1 ; 2 ; 3 ; 5.

Programa limpia.
usedMemory2 := (Programa memoria ? 0).




x := 2.
y := ['Hello'].
q := { ['Empty']. }.
p := Bèrdat.
a := Lista ← 1 ; 2 ; 3 ; 4.

Programa limpia.
usedMemory3 := (Programa memoria ? 0).




x := 3.
y := ['Hello'].
q := { ['Empty']. }.
p := Bèrdat.
a := Lista ← 1 ; 2 ; 3 ; 5.


Programa limpia.
usedMemory4 := (Programa memoria ? 0).





x := 4.
y := ['Hello'].
q := { ['Empty']. }.
p := Bèrdat.
