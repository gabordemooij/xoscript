# test qualifiers

Programa limpia.

>> Fruit := Opheto nobo.
Fruit ora: ['nobo'] hasi: {
	>> f := mes nobo.
	f apples: 0. <- f.
}.
Fruit ora: ['apples:'] hasi: { :a propio apples := a. }.
Fruit ora: ['apples'] hasi: { <- propio apples. }.
Fruit ora: ['+'] hasi: { :f
	>> n := Fruit nobo.
	n apples: (f apples + propio apples). <- n.
}.
Number ora: ['apples'] hasi: { <- ((Fruit nobo) apples: mes).
}.

Fruit ora: ['teksto'] hasi: { <- propio apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Salida skirbi: q, liña-nobo.




q := 3 apples + 4 apples.
