
Number siña: ['plus:'] ta-nifiká: ['+'].
Number ora: ['+'] hasi: { :x
	>> rate := 1.
	>> currency := x unidat-di-number.
	(currency = ['euros']) bèrdat: {
		rate := 2.
	}. <- (mes plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars unidat: ['dollars'].
euros unidat: ['euros'].
>> money := dollars + euros.
Salida skirbi: money, liña-nobo.
