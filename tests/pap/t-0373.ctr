# compliance test

# use international numbers

Salida skirbi: ['1000 -> '].
Salida skirbi: 1000, liña-nobo. #1000

Salida skirbi: ['1.5 -> '].
Salida skirbi: 1.5, liña-nobo.  #1.5

Salida skirbi: ['1001.5 -> '].
Salida skirbi: 1.5 + 1000, liña-nobo. #1001.5

# use 0-indexed arrays
>> x := Lista nobo ; 1 ; 2 ; 3.
>> y := Lista nobo ; ['a'] ; ['b'] ; ['c'].

Salida skirbi: ['1 -> '].
Salida skirbi: x ? 0, liña-nobo. #1

Salida skirbi: ['1 -> '].
Salida skirbi: (x na: 0), liña-nobo. #1

Salida skirbi: ['1 -> '].
Salida skirbi: x promé, liña-nobo. #1

Salida skirbi: ['3 -> '].
Salida skirbi: x último, liña-nobo. #3

Salida skirbi: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Salida skirbi: (x segun: y), liña-nobo.

Salida skirbi: ['1 -> '].
Salida skirbi: (x kuminsá: 0 largura: 1) promé, liña-nobo. #1

Salida skirbi: ['0 -> '].
Salida skirbi: (x buska: 1), liña-nobo. #0

x pone: 9 na: 0.

Salida skirbi: ['9 -> '].
Salida skirbi: (x na: 0), liña-nobo. #9

x agregá-na-kuminsamentu: 8.
Salida skirbi: ['8 -> '].
Salida skirbi: (x na: 0), liña-nobo. #9


x agregá-na-fin: 10.
Salida skirbi: ['10 -> '].
Salida skirbi: (x na: 4), liña-nobo. #10








