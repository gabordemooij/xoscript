

Lista ora: ['column:'] hasi: { :column
	>> result := Lista nobo.
	mes kada: { :index :row
		row kada: { :index :cell
			(index = column) bèrdat: { result agregá-na-fin: cell. }.
		}.
	}. <- result.
}.


>> a := Lista ←
	(Lista ← 1 ; 2 ; 3) ;
	(Lista ← 4 ; 5 ; 6) ;
	(Lista ← 7 ; 8 ; 9).

>> b := a column: 1.
Salida skirbi: b, liña-nobo.

b := a column: 20.
Salida skirbi: b, liña-nobo.

b := a column: -100.
Salida skirbi: b, liña-nobo.
