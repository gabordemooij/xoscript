(Nada = Nada) bèrdat: { Salida skirbi: ['Nil is Nil!'].}.
(2 > 1) bèrdat: { Salida skirbi: ['YES']. }.
(2 > 3) bèrdat: { Salida skirbi: ['NO']. }.
(2 > 3) falsu: { Salida skirbi: ['Nonono..'].}.
Bèrdat bèrdat: { Salida skirbi: ['TRUE is TRUE!']. }.
(Bèrdat) bèrdat: { Salida skirbi: ['TRUE is TRUE!']. }.
Falsu falsu: { Salida skirbi: ['FALSE is FALSE!']. }.
(Falsu) falsu: { Salida skirbi: ['FALSE is FALSE!']. }.
