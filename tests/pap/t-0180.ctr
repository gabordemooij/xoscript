Teksto ora: ['html'] hasi: { <- (
		mes
		remplasá: ['&'] ku: ['&amp;'],
		remplasá: ['<'] ku: ['&lt;'],
		remplasá: ['>'] ku: ['&gt;'],
		remplasá: ['''] ku: ['&apos;'],
		remplasá: ['"'] ku: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa maneho-di-memoria: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Salida skirbi: txt kopia html, liña-nobo.
Salida skirbi: txt kopia lèter-chikí, liña-nobo.
Salida skirbi: txt kopia lèter-grandi, liña-nobo.
} kuminsá.

Programa limpia.

usedMemory1 := (Programa memoria ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Salida skirbi: txt kopia html, liña-nobo.
Salida skirbi: txt kopia lèter-chikí, liña-nobo.
Salida skirbi: txt kopia lèter-grandi, liña-nobo.
} kuminsá.

Programa limpia.
usedMemory2 := (Programa memoria ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Salida skirbi: txt kopia html, liña-nobo.
Salida skirbi: txt kopia lèter-chikí, liña-nobo.
Salida skirbi: txt kopia lèter-grandi, liña-nobo.
} kuminsá.

Programa limpia.
usedMemory3 := (Programa memoria ? 0).



( usedMemory1 = usedMemory2 i: usedMemory1 = usedMemory3, i: usedMemory2 = usedMemory3 ) bèrdat: {
	Salida skirbi: ['No memory leaks here'].
}, falsu: {
	Salida skirbi: ['Leaking memory...'].
}.
