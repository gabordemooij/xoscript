>> To-Do := Opheto nobo.

To-Do ora: ['nobo'] hasi: {
	propio list := Lista nobo.
}.

To-Do ora: ['nieuw'] hasi: {
	propio list := Lista nobo.
}.

To-Do ora: ['+'] hasi: { :task
	propio list agregá-na-fin: task.
}.

To-Do ora: ['number of tasks?'] hasi: { <-  propio list konta.
}.

>> todos := 
	To-Do nobo 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Salida skirbi: ['You have $ tasks to do'] $ todos number of tasks?.
