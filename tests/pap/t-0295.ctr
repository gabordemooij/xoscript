
>> dictionary := (
	Dikshonario nobo
		pone: ['b'] na: ['a'],
		pone: ['a'] na: ['b'],
		pone: ['z'] na: ['x'],
		pone: ['hello'] na: ['hallo'],
		pone: ['human'] na: ['human']
).

>> comparisons := Lista nobo.
dictionary kada: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a kompará: b)
	).
}.

comparisons ordená: { :a :b <- ( a kompará: b ). }.
Salida skirbi: ( comparisons uni: ['↵'] ), liña-nobo.
comparisons uni: ['↵'].
