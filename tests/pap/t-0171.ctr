

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa maneho-di-memoria: 0.

>> a := Lista ← ['hello'] ; ['world'] ; Bèrdat ; Nada ; 666.
a hasi kita-último kita-promé agregá-na-kuminsamentu: ['hi'], agregá-na-fin: 999, kla.
Salida skirbi: ( a uni: [','] ), liña-nobo.

Programa limpia.
usedMemory1 := (Programa memoria ? 0).


a := Lista ← ['hello'] ; ['world'] ; Bèrdat ; Nada ; 666.
a kita-último. a kita-promé. a agregá-na-kuminsamentu: ['hi'], agregá-na-fin: 999.
Salida skirbi: ( a uni: [','] ), liña-nobo.


Programa limpia.
usedMemory2 := (Programa memoria ? 0).


a := Lista ← ['hello'] ; ['world'] ; Bèrdat ; Nada ; 666.
a hasi kita-último kita-promé agregá-na-kuminsamentu: ['hi'], agregá-na-fin: 999, kla.
Salida skirbi: ( a uni: [','] ), liña-nobo.


Programa limpia.
usedMemory3 := (Programa memoria ? 0).



( usedMemory1 = usedMemory2 i: usedMemory1 = usedMemory3, i: usedMemory2 = usedMemory3 ) bèrdat: {
	Salida skirbi: ['No memory leaks here'].
}, falsu: {
	Salida skirbi: ['Leaking memory...'].
}.
