#OBSD
>> dirname := [''].
{ dirname agregá-na-fin: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Programa sistema: command.
Programa chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename agregá-na-fin: ['YYYYYYYY']. } * 20.
Archivo nobo: filename, skirbi: ['sometext'].
{ Archivo lista: ['/tmp/'] + dirname. } * 1000.
Salida skirbi: ['no crash'], liña-nobo.

