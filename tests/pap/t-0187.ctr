Number ora: ['factorial'] hasi: {
	>> total := 1.
	{ :index total multipliká-ku: (mes - index). } × mes. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa maneho-di-memoria: 0.

{
2 exponent factorial.
Salida skirbi: (11 sobrá: 3), liña-nobo.
Salida skirbi: (3.4 rondia), liña-nobo.
Salida skirbi: (7.1 rondia-ariba), liña-nobo.
Salida skirbi: (7.9 rondia-abou), liña-nobo.
}
kuminsá.

Programa limpia.

usedMemory1 := (Programa memoria ? 0).

{
2 exponent factorial.
Salida skirbi: (11 sobrá: 3), liña-nobo.
Salida skirbi: (3.4 rondia), liña-nobo.
Salida skirbi: (7.1 rondia-ariba), liña-nobo.
Salida skirbi: (7.9 rondia-abou), liña-nobo.
}
kuminsá.

Programa limpia.
usedMemory2 := (Programa memoria ? 0).


{
2 exponent factorial.
Salida skirbi: (11 sobrá: 3), liña-nobo.
Salida skirbi: (3.4 rondia), liña-nobo.
Salida skirbi: (7.1 rondia-ariba), liña-nobo.
Salida skirbi: (7.9 rondia-abou), liña-nobo.
} kuminsá.

Programa limpia.
usedMemory3 := (Programa memoria ? 0).



( usedMemory1 = usedMemory2 i: usedMemory1 = usedMemory3, i: usedMemory2 = usedMemory3 ) bèrdat: {
	Salida skirbi: ['No memory leaks here'].
}, falsu: {
	Salida skirbi: ['Leaking memory...'].
}.
