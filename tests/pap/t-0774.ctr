Salida skirbi: ['Test object'], liña-nobo.
>> a := Opheto nobo. 
a ora: ['item:'] hasi: { :lst
	propio lst := lst. 
}.
a ora: ['item'] hasi: { <- propio lst.
}.
a item: (
	Lista nobo ; 1 ; (
		Lista nobo ; ['a'] ; (
			Lista nobo ; ( Momento nobo: 1 )
		) ; ( Int64 for-di-teksto: ['321'] )
	)
).
Salida skirbi: a item, liña-nobo.
>> old-lst-address := a item prototipo adrès-di-memoria.
a save-as: ['/tmp/a.bin'].
Salida skirbi: ['========== RELOADING SNAP:'], liña-nobo.
>> b := Opheto load-from: ['/tmp/a.bin'].
(b item prototipo adrès-di-memoria = old-lst-address) bèrdat: {
	Salida skirbi: ['Object link re-attached.'], liña-nobo.
}.
Salida skirbi: ( b item ), liña-nobo.
