#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa maneho-di-memoria: 0.

{
Momento tempu.
Momento warda: 1.
Salida skirbi: Programa kantidat-di-argumento, liña-nobo.
Programa argumento: 0.
Number random.
Salida skirbi: (Programa sistema: ['echo 'Hello'']).
} kuminsá.

Programa limpia.
usedMemory1 := (Programa memoria ? 0).

{
Momento tempu.
Momento warda: 1.
Salida skirbi: Programa kantidat-di-argumento, liña-nobo.
Programa argumento: 0.
Number random.
Salida skirbi: (Programa sistema: ['echo 'Hello'']).
} kuminsá.

Programa limpia.
usedMemory2 := (Programa memoria ? 0).

{
Momento tempu.
Momento warda: 1.
Salida skirbi: Programa kantidat-di-argumento, liña-nobo.
Programa argumento: 0.
Number random.
Salida skirbi: (Programa sistema: ['echo 'Hello'']).
} kuminsá.

Programa limpia.
usedMemory3 := (Programa memoria ? 0).



( usedMemory1 = usedMemory2 i: usedMemory1 = usedMemory3, i: usedMemory2 = usedMemory3 ) bèrdat: {
	Salida skirbi: ['No memory leaks here'].
}, falsu: {
	Salida skirbi: ['Leaking memory...'].
}.
