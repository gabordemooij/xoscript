Salida skirbi: ['Test object'], liña-nobo.
>> a := Opheto nobo. 

a ora: ['item:'] hasi: { :binhelper
	propio binhelper := binhelper. 
}.

a ora: ['item'] hasi: { <- propio binhelper.
}.

a item: Bin nobo.

>> old-binhelper-address := a item prototipo adrès-di-memoria.
a save-as: ['/tmp/a.bin'].
Salida skirbi: ['========== RELOADING SNAP:'], liña-nobo.

>> b := Opheto load-from: ['/tmp/a.bin'].

(b item prototipo adrès-di-memoria = old-binhelper-address) bèrdat: {
	Salida skirbi: ['Object link re-attached.'], liña-nobo.
}.


