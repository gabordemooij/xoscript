

Teksto ora: ['html'] hasi: { <- (
		mes
		remplasá: ['&'] ku: ['&amp;'],
		remplasá: ['<'] ku: ['&lt;'],
		remplasá: ['>'] ku: ['&gt;'],
		remplasá: ['"'] ku: ['&quot;']
	).
}.


Salida skirbi: ([' left trimmed '] kita-espasio) + [' '] + ( ['and right trimmed'] kita-espasio) + ['!'], liña-nobo.
Salida skirbi: ['<html>"html & entities"</html>'] html.
