#Linux
>> OS := Programa konfigurashon: ['OS'].

>> clock := Momento nobo.
	
(OS = ['Haiku']) bèrdat: {
	clock zona-di-tempu: ['CET'],
	aña: 2017, luna: 7, dia: 13,
	ora: 18, minüt: 0, sekònde: 0.
}, sino: {
	clock zona-di-tempu: ['Europe/Amsterdam'],
	aña: 2017, luna: 7, dia: 13,
	ora: 18, minüt: 0, sekònde: 0.
}.

clock ora: ['tell'] hasi: {
	Salida skirbi: mes, liña-nobo.
}.


clock suma: 2    ora, tell.
clock suma: 1    ora, tell.
clock suma: 19 minüt, tell.
clock suma: 1  minüt, tell.
clock suma: 1  minüt, tell.
clock suma: 19 sekònde, tell.
clock suma: 1  sekònde, tell.
clock suma: 1  sekònde, tell.
clock suma: 2    aña, tell.
clock suma: 1    aña, tell.

(OS = ['Haiku']) bèrdat: {
clock suma: 5   luna.
clock zona-di-tempu: ['CEST'], tell.
}, sino: {
	clock suma: 5   luna, tell.
}.

clock suma: 1   luna, tell.
clock suma: 19    dia, tell.
clock suma: 1    ora, tell.
clock suma: 120  yard, tell.
