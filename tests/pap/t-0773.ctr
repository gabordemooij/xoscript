Salida skirbi: ['Test object'], liña-nobo.
>> a := Opheto nobo. 
a ora: ['item:'] hasi: { :int64
	propio int64 := int64. 
}.
a ora: ['item'] hasi: { <- propio int64.
}.
a item: ( Int64 for-di-teksto: ['9999'] ).
Salida skirbi: a item, liña-nobo.
>> old-int64-address := a item prototipo adrès-di-memoria.
a save-as: ['/tmp/a.bin'].
Salida skirbi: ['========== RELOADING SNAP:'], liña-nobo.
>> b := Opheto load-from: ['/tmp/a.bin'].
(b item prototipo adrès-di-memoria = old-int64-address) bèrdat: {
	Salida skirbi: ['Object link re-attached.'], liña-nobo.
}.
Salida skirbi: ( b item ), liña-nobo.
