>> t := Bèrdat.
(t = Bèrdat) bèrdat: { Salida skirbi: ['T']. }.
(t = Falsu) bèrdat: { Salida skirbi: ['F']. }.
Salida skirbi: ['|'].
>> t := Falsu.
(t = Bèrdat) bèrdat: { Salida skirbi: ['T']. }.
(t = Falsu) bèrdat: { Salida skirbi: ['F']. }.
Salida skirbi: ['|'].
>> f := Bèrdat.
(t = Bèrdat i: f = Falsu) bèrdat: { Salida skirbi: ['T']. }.
(t = Falsu i: f = Bèrdat) bèrdat: { Salida skirbi: ['F']. }.
Salida skirbi: ['|'].
>> n := Nada.
(n Nada?) bèrdat: { Salida skirbi: ['T']. }.
(n Nada?) falsu: { Salida skirbi: ['F']. }.
Salida skirbi: ['|'].
(f Boolean?) bèrdat: { Salida skirbi: ['T']. }.
(f Boolean?) falsu: { Salida skirbi: ['F']. }.



