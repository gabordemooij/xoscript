



>> CoffeeGrounds := Opheto nobo.
CoffeeGrounds ora: ['extract'] hasi: { <- ['coffee']. }.

>> CoffeeMachine := Opheto nobo.
CoffeeMachine ora: ['init'] hasi: {
	propio coffeegrounds := CoffeeGrounds nobo.
}.
CoffeeMachine ora: ['nobo'] hasi: { <- CoffeeMachine `new init.
}.

CoffeeMachine ora: ['makeTea'] hasi: { <- (propio tealeaves extract). }.
CoffeeMachine ora: ['makeCoffee'] hasi: { <- (propio coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine nobo.

Salida skirbi:
	coffeeDream 
	makeCoffee.

Salida skirbi:
	coffeeDream 
	makeTea.
