# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> ruta := ['/tmp/dat.csv'].
>> csv := Archivo nobo: ruta.
csv skirbi: s.

# accepts CRLF LF CR, varying row length
csv separadó: [';'] komia: ['"'] liñanan: { :line
	Programa limpia.
	Salida skirbi: line, liña-nobo.
	Programa limpia.
}.

# unequal lines
s agregá-na-fin: ['\njustone'].
csv skirbi: s.
{
	csv separadó: [';'] komia: ['"'] liñanan: { :line
		Salida skirbi: line, liña-nobo.
	}.
} kapta: { :e 
	Salida skirbi: e, liña-nobo.
}, kuminsá.

# invalid format
s := ['"he"llo";world'].
csv skirbi: s.
{
	csv separadó: [';'] komia: ['"'] liñanan: { :line
		Salida skirbi: line, liña-nobo.
	}.
} kapta: { :e 
	Salida skirbi: e, liña-nobo.
}, kuminsá.
