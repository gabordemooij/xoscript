# test qualifiers

>> $ := Opheto nobo.

$ ora: ['kontestá:'] hasi: { :x
	
	>> operation := x lèter: 0.
	>> valuta := x lèter: 1.
	>> money := x salta: 2.
	
	>> amount := 0.

	( operation = ['+'] ) bèrdat: {
		( valuta = ['£'] ) bèrdat: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Salida skirbi: x, liña-nobo.


>> Fruit := Opheto nobo.

Fruit ora: ['nobo'] hasi: {
	>> f := mes nobo.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit ora: ['apples:'] hasi: { :a propio apples := a. }.
Fruit ora: ['oranges:'] hasi: { :p propio oranges := p. }.
Fruit ora: ['apples'] hasi: { <- propio apples. }.
Fruit ora: ['oranges'] hasi: { <- propio oranges. }.

Fruit ora: ['+'] hasi: { :f
	
	>> n := Fruit nobo.
	f suma: 1.
	
	n apples: (f apples + propio apples).
	n oranges:  (f oranges  + propio oranges). <- n.
}.

Fruit ora: ['teksto'] hasi: { <- ( propio apples teksto + [' apples and '] + propio oranges + [' oranges'] ).
}.

Number ora: ['apples'] hasi: { <- ((Fruit nobo) apples: mes).
}.

Number ora: ['apple'] hasi: { <- ((Fruit nobo) apples: mes).
}.

Number ora: ['oranges'] hasi: { <- ((Fruit nobo) oranges: mes).
}.




Salida skirbi: (1 apple + 3 oranges + 4 apples), liña-nobo.


Teksto ora: ['twice'] hasi: { <- ((mes teksto) + (mes teksto)).
}.



Salida skirbi: ['❤❤❤'] twice.



