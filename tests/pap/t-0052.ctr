>> items := Dikshonario nobo.
items pone: ['green'] na: ['color-1'].
items pone: ['orange'] na: ['color-2'].
items pone: ['red'] na: ['color-3'].
>> i := 0.
>> s := [''].
items kada: { :key :color
	Salida skirbi: ['color #'] + i + [' is: '] + color + [' '].
	i suma: 1.
}.
Salida skirbi: i + [' colors!'].
