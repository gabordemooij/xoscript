# test list operations


>> cakes := Lista ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes remplasá: 1 largura: 2 ku: ( Lista ← ['cinnamon'] ; ['pineapple'] ).
Salida skirbi: (buy uni: [',']), liña-nobo.


>> buy := cakes remplasá: 1 largura: 12 ku: ( Lista ← ['cinnamon'] ; ['pineapple'] ).
Salida skirbi: (buy uni: [',']), liña-nobo.


>> buy := cakes remplasá: 2 largura: 10 ku: ( Lista nobo ).
Salida skirbi: (buy uni: [',']), liña-nobo.


>> buy := cakes remplasá: 0 largura: 1 ku: ( Lista nobo ).
Salida skirbi: (buy uni: [',']), liña-nobo.


>> buy := cakes remplasá: ['0'] largura: ['1'] ku: ['x'].
Salida skirbi: (buy uni: [',']), liña-nobo.
