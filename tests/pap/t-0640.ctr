
Server init.
Salida skirbi: ['Database test'], liña-nobo.

>> db := Maria-DB nobo anfitrion: ['localhost'],
	nòmber-di-usuario: ['xo'], 
	kontraseña: ['pass123'],
	nòmber-di-base: ['xobase'],
	konektá.

>> parameternan-di-buskeda :=
db konsulta: ['SELECT UNHEX('CAFE') AS blobby'],
trese: { :row
	Salida skirbi: ( row blobby kuminsá: 0 largura: 2 ), liña-nobo.
	row blobby libra.
}.
