>> makeAdder := { :x
	>> f := { :y <- (propio x + y). } pone: ['x'] balor: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i propio q pone: (propio f apliká: (propio q ? i)) na: i. } 
	pone: ['q'] balor: array,
	pone: ['f'] balor: func.
	{ :i mapping apliká: i. } × (array konta).
}.

>> a := Lista ← 1; 2; 3.
mapper apliká: a i: (makeAdder apliká: 100).
Salida skirbi: (a posishon: 0), liña-nobo.
Salida skirbi: (a ? 1), liña-nobo.
Salida skirbi: (a ? 2), liña-nobo.
