Salida skirbi: ['Continue for-loop, No - before 6 and up.'], liña-nobo.
{ :i
	Salida skirbi: (i + 1), liña-nobo.
	((i + 1) > 4) sigui.
	Salida skirbi: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Salida liña-nobo.
Salida skirbi: ['Continue while-true, No --> before 5 and up.'], liña-nobo.
{
	Salida skirbi: ['iteration #'] + x, liña-nobo.
	x suma: 1.
	((x < 5) kontrali) sigui.
	Salida skirbi: ['-->'].
} mientras: xIsLessThan10.
Salida liña-nobo.
Salida skirbi: ['Continue while-false, No - before 3 only.'], liña-nobo.
{
	Salida skirbi: ['iteration #'] + x, liña-nobo.
	x resta: 1.
	(x = 3) sigui.
	Salida skirbi: ['-'].
} mientras: { <- ( x > 0). }.

Salida liña-nobo.
Salida skirbi: ['Continue times-loop, No ||| before 3.'], liña-nobo.
{ :i
	Salida skirbi: ['iteration #'] + i, liña-nobo.
	(i = 2) sigui.
	Salida skirbi: ['|||'].
} × 5.

Salida liña-nobo.

{ Bèrdat sigui. Salida skirbi: ['dont write this!'], liña-nobo. } kuminsá.

{ Bèrdat sigui. Salida skirbi: ['dont write this!'], liña-nobo. } kapta: { Salida skirbi: ['Dont catch this!']. }, kuminsá.

Salida skirbi: ['Test Array each-loop: 0, ... ,2'], liña-nobo.
(Lista ← 1 ; 2 ; 3) transformá: { :i
	(i = 1) sigui.
	Salida skirbi: ['iteration #'] + (i - 0), liña-nobo.
}.

Salida skirbi: ['Test Map each-loop: c only'], liña-nobo.
>> m := Dikshonario nobo.
m pone: ['first'] na: ['a'], pone: ['second'] na: ['b'], pone: ['third'] na: ['c'].
m kada: { :k :v
	(k ≠ ['c']) sigui.
	Salida skirbi: ['iteration'] + k + v, liña-nobo.
}.

