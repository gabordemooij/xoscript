Server init.

>> db := Maria-DB nobo anfitrion: ['localhost'],
	nòmber-di-usuario: ['xo'],
	kontraseña: ['pass123'],
	nòmber-di-base: ['xobase'],
	konektá.

>> del := db konsulta: ['DELETE FROM book WHERE id > 0'].
{  del ehekutá. db konfirmá. } kapta: { :e db bolbe-atras.  }, kuminsá.

>> konta := db konsulta: ['SELECT COUNT(*) AS num FROM book'].
konta trese: { :row Salida skirbi: row num, liña-nobo. }.
