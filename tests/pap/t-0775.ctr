Salida skirbi: ['Test object'], liña-nobo.
>> l := Lista nobo ; 1 ; ( Lista nobo ; (Momento nobo: 1) ; (Int64 for-di-teksto: ['321']) ; (Lista nobo ; 3)).
Salida skirbi: l, liña-nobo.
>> old-lst-address := l prototipo adrès-di-memoria.
l save-as: ['/tmp/a.bin'].
Salida skirbi: ['========== RELOADING SNAP:'], liña-nobo.
>> b := Opheto load-from: ['/tmp/a.bin'].
(b prototipo adrès-di-memoria = old-lst-address) bèrdat: {
	Salida skirbi: ['Object link re-attached.'], liña-nobo.
}.
Salida skirbi: b, liña-nobo.
