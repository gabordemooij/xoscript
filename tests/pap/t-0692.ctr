Server init.

Salida skirbi: (
	Patronchi nobo: ['^\\w+$'],
	kuadra: ['test@example.com'] 
), liña-nobo. # 0 match, fails on @ and .

Salida skirbi: (
	Patronchi nobo: ['^[^@]+@[^\.]+\.\\w+$'],
	kuadra: ['test@example.com'] 
), liña-nobo. # 1 match

Salida skirbi: (
	Patronchi nobo: ['[^@]+@[^\.]+\.\\w+'],
	kuadra: ['test@example.com'] 
), liña-nobo. # 1 match

Salida skirbi: (
	Patronchi nobo: ['([^@]+)@([^\.]+)\.\\w+'],
	kuadra: ['test@example.com'] 
), liña-nobo. # 1 match, groups dont matter

Salida skirbi: (
	Patronchi nobo: ['[a-z]'],
	kuadra: ['test@example.com'] 
), liña-nobo. # 14 matches

Salida skirbi: (
	Patronchi nobo: ['.*'],
	kuadra: ['test@example.com'] 
), liña-nobo. # 1 match (all)

Salida skirbi: (
	Patronchi nobo: ['(.*)'],
	kuadra: ['test@example.com'] 
), liña-nobo. # 1 match (all)

Salida skirbi: (
	Patronchi nobo: ['\\s*[^@]+@[^\.]+\.\\w+'],
	kuadra: ['test@example.com'] 
), liña-nobo. # 1 match, prefix space optional, gets ignored