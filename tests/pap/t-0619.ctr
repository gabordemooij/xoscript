>> HTML := Opheto nobo.
HTML ora: ['kontestá:'] hasi: { :tag 
	Salida skirbi: (['<tag>'] tag: tag), liña-nobo.
}.
HTML ora: ['kontestá:i:'] hasi: { :tag :html 
	Salida skirbi: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), liña-nobo.
}.
>> html := HTML nobo.
html body h1: ['header'].

