Salida skirbi: ['1,2,3,4,5,6,7,8,9,A,'], liña-nobo.
>> Scope := Opheto nobo.
Scope ora: ['initialize:'] hasi: { :x propio property := x. }.
Scope ora: ['confirm'] hasi: { Salida skirbi: [',']. }.
Scope ora: ['prueba'] hasi: {
	Salida skirbi: propio property.
	mes confirm.
	( 1 = 1 ) bèrdat: { Salida skirbi: propio property. mes confirm. }.
	( 1 = 0 ) falsu: { Salida skirbi: propio property. mes confirm. }.
	>> y := 2. { Salida skirbi: propio property. mes confirm. } mientras: { y resta: 1. <- (y > 0). }.
	{ Salida skirbi: propio property. mes confirm. } × 1.
	(Lista ← 1) kada: {  Salida skirbi: propio property. mes confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Dikshonario nobo one: ['item']) kada: { Salida skirbi: propio property. mes confirm. }.
	{ 1 ÷ 0. } kapta: { Salida skirbi: propio property. mes confirm. }, kuminsá.
	Salida liña-nobo.
}.
>> scope1 := Scope nobo.
scope1 initialize: ['X'].
scope1 prueba.
>> function := { 
	propio property := ['Y'].
	Salida skirbi: propio property.
	mes confirm.
	( 1 = 1 ) bèrdat: { Salida skirbi: propio property. mes confirm. }.
