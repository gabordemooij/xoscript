# a value ending in the first part of an opening quote must survive serialization
>> balornan := Lista nobo
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

balornan kada: { :i :value
	>> d := Dikshonario nobo.
	d pone: value na: ['k'].
	d pone: ['second'] na: ['j'].
	>> r := d kódigo opheto.
	Salida skirbi: r konta, liña-nobo.
	Salida skirbi: ( (r na: ['k']) = value ), liña-nobo.
}.
