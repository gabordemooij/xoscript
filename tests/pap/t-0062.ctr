Boleano ora: ['xor:'] hasi: { :a :b <- ((a i: b kontrali) òf: (a kontrali i: b)).
}.

>> o := Opheto nobo.
o ora: ['hello'] hasi: { ['Empty']. }.
{ o ora: 2 hasi: 3.} kapta: { :e Salida skirbi: e, liña-nobo. }, kuminsá.
{ o ora: ['prueba'] hasi: 3.} kapta: { :e Salida skirbi: e, liña-nobo. }, kuminsá.
{ o ora: ['hello'] hasi: { ['Empty']. }.} kapta: { :e Salida skirbi: e, liña-nobo. }, kuminsá. 
{ >> z := 4 ÷ 0. } kapta: { :e Salida skirbi: e, liña-nobo. }, kuminsá. 
{ (Bèrdat i: Nada) bèrdat: { Salida skirbi: ['X'].}. } kapta: { :e Salida skirbi: e, liña-nobo. }, kuminsá. 
{ ([''] xor: 0) bèrdat: { Salida skirbi: ['X'].}. } kapta: { :e Salida skirbi: e, liña-nobo. }, kuminsá. 
{ (1 < ['2']) bèrdat: { Salida skirbi: ['OK']. }. } kapta: { :e Salida skirbi: e, liña-nobo. }, kuminsá. 
{ (1 < ['2.0']) bèrdat: { Salida skirbi: ['OK']. }. } kapta: { :e Salida skirbi: e, liña-nobo. }, kuminsá. 
{ (1 < ['x2.0']) bèrdat: { Salida skirbi: ['NO!']. }. } kapta: { :e Salida skirbi: e, liña-nobo. }, kuminsá. 
{ Salida skirbi: (['hello OK there'] kuminsá: ['6'] largura: ['2']). } kuminsá. 
