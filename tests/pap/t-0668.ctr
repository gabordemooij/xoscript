# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob nobo: 8, bytes: (
	Lista nobo ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Salida skirbi: ( utf16 dekodifiká: ['utf16le'] ), liña-nobo.

utf16 libra.
>> utf32 := Blob nobo: 13, bytes: (
	Lista nobo ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Salida skirbi: ( utf32 dekodifiká: ['utf32be'] ), liña-nobo.
utf32 libra.