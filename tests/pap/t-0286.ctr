['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Salida skirbi: (x + y), liña-nobo.

>> x := 10040.07.
>> y := 10305.60.

Salida skirbi: (x + y), liña-nobo.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Salida skirbi: (x + y + z), liña-nobo.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Salida skirbi: (x + y + z), liña-nobo.

>> q := 0.1.2.

Salida skirbi: (q), liña-nobo.

>> q := 012.

Salida skirbi: (q), liña-nobo.
