Server init.
Salida skirbi: ['Database datetime test'], liña-nobo.

>> db := Maria-DB nobo anfitrion: ['localhost'],
	nòmber-di-usuario: ['xo'], 
	kontraseña: ['pass123'],
	nòmber-di-base: ['xobase'],
	konektá.

>> parameternan-di-buskeda :=
db konsulta: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
trese: { :row
	Salida skirbi: row datetimetest, liña-nobo.
}.
