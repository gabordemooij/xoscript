Server init.

>> DB := Maria-DB nobo anfitrion: ['localhost'],
	nòmber-di-usuario: ['xo'],
	kontraseña: ['pass123'],
	nòmber-di-base: ['xobase'],
	konektá.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB konsulta: SQL.

# now you don't have to set DB
query2 trese: { :row
	Salida skirbi: row world, liña-nobo.
}.
