Salida skirbi: ['Test object'], liña-nobo.
>> a := Opheto nobo. 

a ora: ['item:'] hasi: { :fmt
	propio fmt := fmt. 
}.

a ora: ['item'] hasi: { <- propio fmt.
}.

a item: ( Formato nobo: ['|%s|'] ).

Salida skirbi: a item, liña-nobo.

>> old-fmt-address := a item prototipo adrès-di-memoria.
a save-as: ['/tmp/a.bin'].
Salida skirbi: ['========== RELOADING SNAP:'], liña-nobo.

>> b := Opheto load-from: ['/tmp/a.bin'].

(b item prototipo adrès-di-memoria = old-fmt-address) bèrdat: {
	Salida skirbi: ['Object link re-attached.'], liña-nobo.
}.

Salida skirbi: ( b item apliká: ['hello'] ), liña-nobo.
