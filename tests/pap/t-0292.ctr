>> winery := { <- (	Dikshonario nobo
		pone: 2 na: ['merlot'],
		pone: 3 na: ['malbec'],
		pone: 4 na: ['syrah']
	).
}.

Salida skirbi: (((winery kuminsá) - ['nothing']) konta), liña-nobo.
Salida skirbi: (((winery kuminsá) - ['merlot']) konta), liña-nobo.
Salida skirbi: (((winery kuminsá) - ['malbec']) konta), liña-nobo.
Salida skirbi: (((winery kuminsá) - ['syrah']) konta), liña-nobo.
Salida skirbi: (((winery kuminsá) - ['merlot'] - ['malbec']) konta), liña-nobo.
Salida skirbi: (((winery kuminsá) - ['merlot'] - ['syrah']) konta), liña-nobo.
Salida skirbi: (((winery kuminsá) - ['malbec'] -['syrah']) konta), liña-nobo.
Salida skirbi: (((winery kuminsá) - ['malbec'] - ['syrah'] - ['merlot']) konta), liña-nobo.

