>> Slurp := Opheto nobo.
Slurp ora: ['nobo'] hasi: {
	propio str := [''].
}.

Slurp ora: ['kontestá:'] hasi: { :blah
		(propio str ≠ ['']) bèrdat: {
			propio str agregá-na-fin: [' '].
		}.
		propio str agregá-na-fin: blah.
}.
Slurp ora: ['kontestá:i:'] hasi: { :blah :blahah
		(propio str ≠ ['']) bèrdat: {
			propio str agregá-na-fin: [' '].
		}.
		(blah largura > 1) bèrdat: {
			propio str agregá-na-fin: (blah kuminsá: 0 largura: (blah largura - 1)).
		}, sino: {
			propio str agregá-na-fin: blah.
		}.
		propio str agregá-na-fin: [' '].
		propio str agregá-na-fin: blahah.
}.
Slurp ora: ['obtain'] hasi: {
	>> buffer := propio str.
	propio str := ['']. <- buffer.
}.

>> s := Slurp nobo.
s hello: ['world'].
Salida skirbi: ( s obtain ), liña-nobo.
