{
	e-tarea-aki eror: ['Dont fail.'].
	unknown doSomething.
} kapta: {
	Salida skirbi: ['Caught!'].
}, kuminsá.

{
	e-tarea-aki eror: ['Dont fail.'].
	propio unknown doSomething.
} kapta: {
	Salida skirbi: ['Caught!'].
}, kuminsá.

{
	e-tarea-aki eror: ['Dont fail.'].
	unknown := 122.
} kapta: {
	Salida skirbi: ['Caught!'].
}, kuminsá.


{
	e-tarea-aki eror: ['Dont fail.'].
	Bèrdat stòp-lus.
	Salida skirbi: ['FAIL'].
} kapta: {
	Salida skirbi: ['Caught!'].
}, kuminsá.

{
	{
		e-tarea-aki eror: ['Dont fail.'].
		Bèrdat stòp-lus.
		Salida skirbi: ['FAIL'].
	} kapta: { :x
		(x = ['Dont fail.']) bèrdat: { e-tarea-aki eror: ['Nested Caught!']. }.
	}, kuminsá.
} kapta: { :e
	Salida skirbi: e.
}, kuminsá.
