#Linux

(Archivo nobo: ['/tmp/testje']) ta-eksistí falsu: {
	Programa sistema: ['mkdir /tmp/testje'].	
}.

(Archivo nobo: ['/tmp/testje/file1']) ta-eksistí falsu: {
	Programa sistema: ['touch /tmp/testje/file1'].	
}.

(Archivo nobo: ['/tmp/testje/folder1']) ta-eksistí falsu: {
	Programa sistema: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Archivo lista: ['/tmp/testje'].

>> q := Lista nobo.

l kada: { :k :v v kada: { :x :y q agregá-na-fin: y. }. }.

>> s := q teksto.

(s ta-kontené: ['file1']) bèrdat:   { Salida skirbi: ['OK'], liña-nobo. }.
(s ta-kontené: ['file2']) bèrdat:   { Salida skirbi: ['XX'], liña-nobo. }.
(s ta-kontené: ['folder1']) bèrdat: { Salida skirbi: ['OK'], liña-nobo. }.
