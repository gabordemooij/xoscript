# test Program version

# this feature is disabled by default
Salida skirbi: (
	Programa funshonalidat: 
	['RECURSIVE_STRINTPOL']
), liña-nobo.


# but if we set the time back
>> today := Momento 
zona-di-tempu: ['CEST'],
for-di: ['2026-02-15 10:00:00'].
