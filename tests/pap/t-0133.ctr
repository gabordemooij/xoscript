


>> Deck := Lista nobo.
Deck ora: ['print'] hasi: {
        >> len := mes konta - 1.
        { :i
                >> len2 := mes konta - 1.
                Salida skirbi: ['len: '].
                Salida skirbi: len, liña-nobo.
                Salida skirbi: ['len2: '].
                Salida skirbi: len2, liña-nobo.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
