Lista ora: ['sum'] hasi: {
	>> total := 0.
	mes kada: { :index :element
		total suma: element.
	}. <- total.
}.

>> a := Bèrdat.



a ora: ['teksto'] hasi: {
	>> answer := Nada.
	( mes = Bèrdat ) bèrdat: {
		answer := ['Yep'].
	}, sino: {
		answer := ['Nope'].
	}. <- answer.
}.

a ora: ['number'] hasi: {
	>> answer := Nada.
	( mes = Bèrdat ) bèrdat: {
		answer := 10.
	}, sino: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b ora: ['teksto'] hasi: { <- ['Devil'].
}.

b ora: ['boleano'] hasi: { <- Falsu.
}.


Salida skirbi: a, liña-nobo.  
Salida skirbi: (90 + a), liña-nobo. 
Salida skirbi: b, liña-nobo. 
Salida skirbi: (Bèrdat i: b), liña-nobo.

a := Lista ← ['hello'] ; ['world'] ; Bèrdat ; Nada ; 666. 
a := a + ( Lista ← 1 ).
Salida skirbi: a, liña-nobo.
Salida skirbi: ((Dikshonario nobo) pone: Nada na: Nada), liña-nobo.
Salida skirbi: a sum, liña-nobo. 


{
	a ora: ['teksto'] hasi: { <- Nada. }.
	a := [''] + a.
} kapta: { :error
	Salida skirbi: ['Error noted: '] + error, liña-nobo.
}, kuminsá.



{
	a ora: ['number'] hasi: { <- Nada. }.
	a := 3 × a.
} kapta: { :error
	Salida skirbi: ['Error noted: '] + error, liña-nobo.
}, kuminsá.


{
	a ora: ['boleano'] hasi: { <- Nada. }.
	a := Bèrdat i: a. 
} kapta: { :error
	Salida skirbi: ['Error noted: '] + error, liña-nobo.
}, kuminsá.





{
	a ora: ['teksto'] hasi: { <- Falsu. }.
	a := [''] + a.
} kapta: { :error
	Salida skirbi: ['Error noted: '] + error, liña-nobo.
}, kuminsá.



{
	a ora: ['number'] hasi: { <- Bèrdat. }.
	a := 3 × a.
} kapta: { :error
	Salida skirbi: ['Error noted: '] + error, liña-nobo.
}, kuminsá.


{
	a ora: ['boolean'] hasi: { <- 1. }.
	a := Bèrdat i: a.
} kapta: { :error
	Salida skirbi: ['Error noted: '] + error, liña-nobo.
}, kuminsá.





