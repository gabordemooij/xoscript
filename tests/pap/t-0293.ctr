
>> city := Lista ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Lista ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature segun: city.
>> cities := weather yabinan ordená: { :a :b <- (a kompará: b). }.
>> temperatures := weather balornan ordená: { :a :b <- (a kompará: b) negativo?. }.

Salida skirbi: (cities uni: [',']), liña-nobo.
Salida skirbi: (temperatures uni: [',']), liña-nobo.
