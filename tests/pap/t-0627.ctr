

# create a 64-bit integer for exact calculations
>> a := Int64 for-di-teksto: ['123'].

# to string
Salida skirbi: a, liña-nobo.

# divide
Salida skirbi: a / (Int64 for-di-teksto: ['3']), liña-nobo.

# multiply
Salida skirbi: a * (Int64 for-di-teksto: ['2']), liña-nobo.

# add
Salida skirbi: a + (Int64 for-di-teksto: ['1']), liña-nobo.

# subtract
Salida skirbi: a - (Int64 for-di-teksto: ['2']), liña-nobo.

# compare
Salida skirbi: ( a =   (Int64 for-di-teksto: ['123'])), liña-nobo.
Salida skirbi: ( a !=: (Int64 for-di-teksto: ['124'])), liña-nobo.
Salida skirbi: ( a <   (Int64 for-di-teksto: ['124'])), liña-nobo.
Salida skirbi: ( a >   (Int64 for-di-teksto: ['122'])), liña-nobo.
Salida skirbi: ( a >=: (Int64 for-di-teksto: ['123'])), liña-nobo.
Salida skirbi: ( a <=: (Int64 for-di-teksto: ['123'])), liña-nobo.





	