>> map1 := Dikshonario nobo.
>> key1 := Lista nobo.
>> key2 := Lista nobo.

map1
	pone: ['hello'] na: key1,
	pone: ['world'] na: key2.


Salida
	skirbi: ['Map #1 contains: '] + (map1 na: key1),
	skirbi: [' and '] + (map1 na: key2), liña-nobo.

>> KeyeableArray := Lista nobo.
KeyeableArray ora: ['toString'] hasi: { <- (mes konta) toString.
}.

>> map2 := Dikshonario nobo.
key1 := KeyeableArray nobo.
key2 := KeyeableArray nobo.

key1 agregá-na-fin: 1.

map2
	pone: ['hello'] na: key1,
	pone: ['world'] na: key2.

Salida
	skirbi: ['Map #2 contains: '] + (map2 na: key1),
	skirbi: [' and '] + (map2 na: key2), liña-nobo.
