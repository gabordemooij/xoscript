

Teksto ora: ['evaluate'] hasi: {
	>> kódigo := Archivo nobo: ['/tmp/eval.ctr'].
	kódigo skirbi: (mes teksto + ['.']).
	Programa usa: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Lista ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q teksto.
Salida skirbi: x, liña-nobo.
>> y := Nada.
(['y := '] + x ) evaluate.
Salida skirbi: y ? 0, liña-nobo.

q := Dikshonario pone: ['\[''] na: ['\['quote\']'].
x := q teksto.
Salida skirbi: x, liña-nobo.
y := Nada.
(['y := '] + x ) evaluate.

>> q := (Dikshonario nobo) pone:['\[''] na:['\['quote\[''].
Salida skirbi: y ? ['\['quote\']'], liña-nobo.
