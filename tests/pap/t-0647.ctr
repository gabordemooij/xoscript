Server init.
Salida skirbi: ['Database time test'], liña-nobo.

>> db := Maria-DB nobo anfitrion: ['localhost'],
	nòmber-di-usuario: ['xo'], 
	kontraseña: ['pass123'],
	nòmber-di-base: ['xobase'],
	konektá.

>> parameternan-di-buskeda :=
db konsulta: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
trese: { :row
	Salida skirbi: row timetest, liña-nobo.
}.
