# test catch-all methods
>> x13 := Opheto nobo.
x13 ora: ['a'] hasi: { :a Salida skirbi: 0, liña-nobo. }.
x13 ora: ['a:'] hasi: { :a Salida skirbi: a, liña-nobo. <- 5. }.
x13 ora: ['a:b:'] hasi: { :a :b Salida skirbi: (a + b), liña-nobo. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
