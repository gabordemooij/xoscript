Salida skirbi: ['Test object'], liña-nobo.
>> cmd := Komando nobo.
Salida skirbi: cmd ls /tmp, liña-nobo.
>> old-cmd-address := cmd prototipo adrès-di-memoria.
cmd save-as: ['/tmp/a.bin'].
Salida skirbi: ['========== RELOADING SNAP:'], liña-nobo.
>> b := Opheto load-from: ['/tmp/a.bin'].
(b prototipo adrès-di-memoria = old-cmd-address) bèrdat: {
	Salida skirbi: ['Object link re-attached.'], liña-nobo.
}.
Salida skirbi: b ls, liña-nobo.


