>> Greeter := Opheto nobo.
Greeter ora: ['make'] hasi: {
	>> greeter := Opheto nobo.
	greeter ora: ['name:'] hasi: { :nòmber
		Salida skirbi: ['setting a name'].
		propio myName := nòmber.
	}.
	greeter ora: ['performGreeting'] hasi: {
		Salida skirbi: ['Hello'].
		Salida skirbi: propio myName.
	}.
	greeter ora: ['greet'] hasi: {
		mes performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
