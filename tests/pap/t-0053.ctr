60 × {
	>> x := (Number random % 6) + 1.
	(x ≤ 6) falsu: { Salida skirbi: ['FAIL']. }.
	(x ≥0) falsu: { Salida skirbi: ['FAIL']. }.
	x := (Number random % 3) + 1.
	(x < 3) falsu: { Salida skirbi: ['FAIL']. }.
	(x>-1) falsu: { Salida skirbi: ['FAIL']. }.
	x := ((Boleano flip) number).
	(x = 0 òf: x = 1) falsu: { Salida skirbi: ['FAIL']. }.
	x := ((Bèrdat flip) number).
	(x = 0 òf: x = 1) falsu: { Salida skirbi: ['FAIL']. }.
	x := (Boleano flip esaki: ['HEAD'] òf-esei: ['TAIL']).
	((x = ['HEAD']) òf: (x = ['TAIL'])) falsu: { Salida skirbi: ['FAIL']. }.
}.
Salida skirbi: ['DONE'].

