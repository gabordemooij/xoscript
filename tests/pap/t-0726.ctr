# test buffers PKI/Sign 
Server init.

>> long := ( Lista nobo yena: 1000 ku: ['a'] ) uni: [''].

# sign a message
Salida skirbi: ( 
	Kaha-fuerte firma: ['abc'] ku: long
), liña-nobo.

Salida skirbi: ( 
	Kaha-fuerte
		kontrolá: ['abc'] 
		firma: long 
		ku: long
), liña-nobo.

Salida skirbi: (
	Kaha-fuerte hash-di-kontraseña: long verifiká: long
), liña-nobo.
