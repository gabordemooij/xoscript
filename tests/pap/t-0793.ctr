Server init.

>> DB := Maria-DB nobo anfitrion: ['localhost'],
	nòmber-di-usuario: ['xo'],
	kontraseña: ['pass123'],
	nòmber-di-base: ['xobase'],
	konektá.

{
	DB konsulta:
	['DROP TABLE movies'],
	ehekutá.
} kapta: { Nada. }, kuminsá.

DB konsulta:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
ehekutá.

DB konsulta: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parameternan: ( Lista nobo ; ['Halloween'] ),
ehekutá.

DB konsulta: ['SELECT * FROM movies'],
trese: { :movie
	Salida skirbi: movie title, liña-nobo.
}.

