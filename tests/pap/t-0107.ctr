
Salida skirbi: ['Break for-loop, 0-4.'], liña-nobo.
{ :i
	Salida skirbi: ['iteration #'] + i, liña-nobo.
	(i = 4) stòp-lus.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Salida skirbi: ['Break while-true loop, 0-4.'], liña-nobo.
{
	Salida skirbi: ['iteration #'] + x, liña-nobo.
	x suma: 1.
	((x < 5) kontrali) stòp-lus.
} mientras: xIsLessThan10.

Salida skirbi: ['Break while-false loop, 5,4.'], liña-nobo.
{
	Salida skirbi: ['iteration #'] + x, liña-nobo.
	x resta: 1.
	(x = 3) stòp-lus.
} mientras: { <- (x > 0). }.

Salida skirbi: ['Break times loop, 1-4.'], liña-nobo.
{ :i
	Salida skirbi: ['iteration #'] + i, liña-nobo.
	(i = 4) stòp-lus.
} × 5.

Salida skirbi: ['Break block, dont print line.'], liña-nobo.
{ Bèrdat stòp-lus. Salida skirbi: ['dont write this!'], liña-nobo. } kuminsá.

Salida skirbi: ['Break block, dont fire catch...'], liña-nobo.
{ Bèrdat stòp-lus. Salida skirbi: ['dont write this!'], liña-nobo. } kapta: { Salida skirbi: ['Dont catch this!']. }, kuminsá.

Salida skirbi: ['Test Array each-loop: 0,1'], liña-nobo.
(Lista ← 1 ; 2 ; 3) transformá: { :i
	Salida skirbi: ['iteration #'] + i, liña-nobo.
	(i = 1) stòp-lus.
}.

Salida skirbi: ['Test Map each-loop: c only'], liña-nobo.
>> m := Dikshonario nobo.
m pone: ['first'] na: ['a'], pone: ['second'] na: ['b'], pone: ['third'] na: ['c'].
m kada: { :k :v
	Salida skirbi: ['iteration'] + v + k, liña-nobo.
	Bèrdat stòp-lus.
}.

