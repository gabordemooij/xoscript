

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa maneho-di-memoria: 0.

Number ora: ['addNum:'] hasi: { :x
	mes suma: x.
}.

Number ora: ['subtractNum:'] hasi: { :x
	mes resta: x.
}.

Number ora: ['multiplyBy:'] hasi: { :x
	mes multipliká-ku: x.
}.

Number ora: ['divideBy:'] hasi: { :x
	mes dividí-pa: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 potensia: 8).  
a := a + (2 potensia: -1). 
a := a + (49 rais-kuadrá).   
a addNum: ((Lista ← 0 ; 1) máksimo).          
a addNum: ((Lista ← 2 ; 3) mínimo).
Salida skirbi: a.

Programa limpia.

usedMemory1 := (Programa memoria ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 potensia: 8).  
a := a + (2 potensia: -1). 
a := a + (49 rais-kuadrá).   
a addNum: ((Lista ← 0 ; 1) máksimo).          
a addNum: ((Lista ← 2 ; 3) mínimo).
Salida skirbi: a.

Programa limpia.
usedMemory2 := (Programa memoria ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 potensia: 8).  
a := a + (2 potensia: -1). 
a := a + (49 rais-kuadrá).   
a addNum: ((Lista ← 0 ; 1) máksimo).          
a addNum: ((Lista ← 2 ; 3) mínimo).
Salida skirbi: a.

Programa limpia.
usedMemory3 := (Programa memoria ? 0).



( usedMemory1 = usedMemory2 i: usedMemory1 = usedMemory3, i: usedMemory2 = usedMemory3 ) bèrdat: {
	Salida skirbi: ['No memory leaks here'].
}, falsu: {
	Salida skirbi: ['Leaking memory...'].
}.
