
>> Size := Opheto nobo.
Size ora: ['is:'] hasi: { :number
	number ora: ['+'] hasi: { :number
		>> unit := number unidat-di-number.
		>> factor := 1.
		
		unit
		kaso: ['inch'] hasi: { factor := 0.0833. }. <- mes + (number * factor).
	}. <- number.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Salida skirbi: plank + edge, liña-nobo.
