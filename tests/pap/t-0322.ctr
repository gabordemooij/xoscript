

>> Matryoshka := Opheto nobo.
Matryoshka ora: ['double:'] hasi: { :secret
	propio secret := secret × 2.
}.
Matryoshka ora: ['nobo:'] hasi: { :secret
	>> answer := Nada.
	>> t := (secret > 255).
	Salida skirbi: (secret + [' | '] + t), liña-nobo.
	t bèrdat: {
		answer := secret.
	}, sino: {
		answer := Matryoshka rekursivo nobo: (mes double: secret).
	}. <- answer.
}.

>> x := Matryoshka nobo: 2.
