>> a := Lista ← Opheto ; Bèrdat ; Falsu ; Boleano ; 1 ; Number ; ['Str'] ; Teksto ; { ['Empty']. }.
Salida skirbi: (a konta), liña-nobo.
{ :i
	Salida skirbi: 
	['a '] + 
	((a ? i) tipo) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Nada?) esaki: [''] òf-esei: ['NOT']) + 
	[' Nil.'],
	liña-nobo.
} × (a konta).
Salida skirbi: ['but.. Nil is.. '] + ((Nada Nada?) esaki: ['certainly NIL!'] òf-esei: ['not NIL??']), liña-nobo.