

Lista ora: ['sum'] hasi: {
	>> total := 0.
	mes kada: { :index :element
		total suma: element.
	}. <- total.
}.

Lista ora: ['product'] hasi: {
	>> total := 1.
	mes kada: { :index :element
		total multipliká-ku: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa maneho-di-memoria: 0.

{

>> a := Lista ← ['hello'] ; ['world'] ; Bèrdat ; Nada ; 666.
a := a + ( Lista ← 1 ).
Salida skirbi: ( ['sum: '] + ( a sum ) ), liña-nobo.
Salida skirbi: ( ['min: '] + ( a mínimo ) ), liña-nobo.
Salida skirbi: ( ['max: '] + ( a máksimo ) ), liña-nobo.
Salida skirbi: ( ['3rd: '] + ( a ? 2 ) ), liña-nobo.
Salida skirbi: ( ['prd: '] + ( a product ) ), liña-nobo.
a ordená: { :a :b <- (b - a). }.
a kada: { :i :e Salida skirbi: ( i - 0 ), liña-nobo. }.

} kuminsá.

Programa limpia.
usedMemory1 := (Programa memoria ? 0).


{

>> a := Lista ← ['hello'] ; ['world'] ; Bèrdat ; Nada ; 666.
a := a + ( Lista ← 1 ).
Salida skirbi: ( ['sum: '] + ( a sum ) ), liña-nobo.
Salida skirbi: ( ['min: '] + ( a mínimo ) ), liña-nobo.
Salida skirbi: ( ['max: '] + ( a máksimo ) ), liña-nobo.
Salida skirbi: ( ['3rd: '] + ( a ? 2 ) ), liña-nobo.
Salida skirbi: ( ['prd: '] + ( a product ) ), liña-nobo.
a ordená: { :a :b <- (b - a). }.
a kada: { :i :e Salida skirbi: ( i - 0 ), liña-nobo. }.

} kuminsá.



Programa limpia.
usedMemory2 := (Programa memoria ? 0).


{

>> a := Lista ← ['hello'] ; ['world'] ; Bèrdat ; Nada ; 666.
a := a + ( Lista ← 1 ).
Salida skirbi: ( ['sum: '] + ( a sum ) ), liña-nobo.
Salida skirbi: ( ['min: '] + ( a mínimo ) ), liña-nobo.
Salida skirbi: ( ['max: '] + ( a máksimo ) ), liña-nobo.
Salida skirbi: ( ['3rd: '] + ( a ? 2 ) ), liña-nobo.
Salida skirbi: ( ['prd: '] + ( a product ) ), liña-nobo.
a ordená: { :a :b <- (b - a). }.
a kada: { :i :e Salida skirbi: ( i - 0 ), liña-nobo. }.

} kuminsá.



Programa limpia.
usedMemory3 := (Programa memoria ? 0).

( usedMemory1 = usedMemory2 i: usedMemory1 = usedMemory3, i: usedMemory2 = usedMemory3 ) bèrdat: {
	Salida skirbi: ['No memory leaks here'].
}, falsu: {
	Salida skirbi: ['Leaking memory...'].
}.
