Salida skirbi: ((Lista nobo
	ora: ['plaque:'] hasi: { :x propio o := x. },
	ora: ['plaque']  hasi: { <- propio o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Lista ← 1)
	~ (Lista ← 1 ; 2)
	~ (Lista ← 1 ; 2 ; 3)
	~ (Lista ← 1 ; 2 ; 3 ; 4)
	~ (Lista ← 1 ; 2 ; 3 ; 4 ; 5)
) kada: { :i :el
	{ Salida skirbi: e-tarea-aki. } × el konta.
	Salida liña-nobo.
}) plaque, liña-nobo.


