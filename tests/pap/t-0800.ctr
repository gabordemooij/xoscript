Server init.

>> db := Maria-DB nobo anfitrion: ['localhost'],
	nòmber-di-usuario: ['xo'],
	kontraseña: ['pass123'],
	nòmber-di-base: ['xobase'],
	konektá.

>> parameternan-di-buskeda := db konsulta: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parameternan: ( Lista nobo ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  parameternan-di-buskeda ehekutá. db konfirmá. } kapta: { :e db bolbe-atras.  }, kuminsá.

Salida skirbi: ['Can we insert? '] + ( parameternan-di-buskeda insert-id > 0 ), liña-nobo.
