Server init.
>> f := Formato nobo: ['%d'].
>> a := Blob nobo: 4.
a bytes: ( Lista nobo ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob nobo: 4.
b bytes: ( Lista nobo ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a kuminsá: 0 largura: 3, kada: { :i :byte
	Salida skirbi: ( f apliká-number-entero: byte ), liña-nobo.
}.
a ^ b.
a kuminsá: 0 largura: 3, kada: { :i :byte
	Salida skirbi: ( f apliká-number-entero: byte ), liña-nobo.
}.
a ^ b.
a kuminsá: 0 largura: 3, kada: { :i :byte
	Salida skirbi: ( f apliká-number-entero: byte ), liña-nobo.
}.
a libra.
b libra.

{ a ^ Opheto. } kapta: { :e Salida skirbi: e, liña-nobo. }, kuminsá.
