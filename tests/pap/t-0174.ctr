


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa maneho-di-memoria: 0.
>> palette := Nada.
>> colors := Nada.

{
palette := Dikshonario nobo.
palette 
	pone: ['#F00'] na: ['red'],
	pone: ['#0F0'] na: ['green'],
	pone: ['#00F'] na: ['blue'].
Salida skirbi: ['number of RGB codes in palette: '] + ( palette konta ), liña-nobo.
Salida skirbi: ['RGB code of green is: '] + ( palette ? ['green'] ), liña-nobo.
colors := [''].
( palette kada: { :nòmber :kódigo
		colors := colors + ( nòmber + [':'] + kódigo ).
} ).
Salida skirbi: ['All colors in palette: '] + colors, liña-nobo.
} kuminsá.
Programa limpia.
usedMemory1 := (Programa memoria ? 0).

{
palette := Dikshonario nobo.
palette 
	pone: ['#F00'] na: ['red'],
	pone: ['#0F0'] na: ['green'],
	pone: ['#00F'] na: ['blue'].
Salida skirbi: ['number of RGB codes in palette: '] + ( palette konta ), liña-nobo.
Salida skirbi: ['RGB code of green is: '] + ( palette ? ['green'] ), liña-nobo.
colors := [''].
( palette kada: { :nòmber :kódigo
		colors := colors + ( nòmber + [':'] + kódigo ).
} ).
Salida skirbi: ['All colors in palette: '] + colors, liña-nobo.
} kuminsá.
Programa limpia.
usedMemory2 := (Programa memoria ? 0).

{
palette := Dikshonario nobo.
palette 
	pone: ['#F00'] na: ['red'],
	pone: ['#0F0'] na: ['green'],
	pone: ['#00F'] na: ['blue'].
Salida skirbi: ['number of RGB codes in palette: '] + ( palette konta ), liña-nobo.
Salida skirbi: ['RGB code of green is: '] + ( palette ? ['green'] ), liña-nobo.
colors := [''].
( palette kada: { :nòmber :kódigo
		colors := colors + ( nòmber + [':'] + kódigo ).
} ).
Salida skirbi: ['All colors in palette: '] + colors, liña-nobo.
} kuminsá.
Programa limpia.
usedMemory3 := (Programa memoria ? 0).



( usedMemory1 = usedMemory2 i: usedMemory1 = usedMemory3, i: usedMemory2 = usedMemory3 ) bèrdat: {
	Salida skirbi: ['No memory leaks here'].
}, falsu: {
	Salida skirbi: ['Leaking memory...'].
}.
