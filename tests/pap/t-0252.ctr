#Linux
>> clock := Momento nobo.
clock zona-di-tempu: ['UTC-1'].
clock aña: 1981, luna: 1, dia: 5,
      ora: 13, minüt: 15, sekònde: 13.

Salida skirbi: clock, liña-nobo.
clock zona-di-tempu: ['UTC+0'].

Salida skirbi: (
	(clock aña simpel) + ['-'] + (clock luna) + ['-'] + (clock dia) + [' '] +
	(clock ora) + [':'] + (clock minüt) + [':'] + (clock sekònde) + [' '] +
	['W'] + (clock siman) + (clock zona-di-tempu)
), liña-nobo.


clock zona-di-tempu: ['UTC-1'].
Salida skirbi: (
	(clock aña simpel) + ['-'] + (clock luna) + ['-'] + (clock dia) + [' '] +
	(clock ora) + [':'] + (clock minüt) + [':'] + (clock sekònde) + [' '] +
	['W'] + (clock siman) + (clock zona-di-tempu)
), liña-nobo.
