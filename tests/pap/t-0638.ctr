
Server init.
>> rq := Petishon-HTTP nobo.
Salida skirbi: ['HTTP-GET d[]=']  + ( rq get-lista: ['d[]'] ), liña-nobo. # GET
Salida skirbi: ['HTTP-GET f[]=']  + ( rq get-lista: ['f[]'] ), liña-nobo. # GET
Salida skirbi: ['HTTP-POST e[]='] + ( rq post-lista: ['e[]'] ), liña-nobo. # GET
Salida skirbi: ['HTTP-POST c=']   + ( rq post: ['c'] ), liña-nobo. # GET
Salida skirbi: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), liña-nobo. # GET
