>> str := ['write:'].
Salida mensahe: ['skirbi:'] argumentonan: (Lista ← ['Hello World']), liña-nobo. 

Number ora: ['isbetween:and:'] hasi: { :a :b <- ((mes ≥ a) i: (mes ≤ b)).
}.

str := ['isbetween:and:'].
Salida skirbi: (3 mensahe: str argumentonan: (Lista ← 2 ; 8)), liña-nobo.
Salida skirbi: (3 mensahe: str argumentonan: (Lista ← 1 ; 2)), liña-nobo.


>> CoffeeMachine := Opheto nobo.
CoffeeMachine ora: ['makeCoffeeWithSugar:milk:'] hasi: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Lista ← 4 ; 2.
Salida skirbi: ( CoffeeMachine mensahe: order argumentonan: coffeeConfiguration ), liña-nobo.
