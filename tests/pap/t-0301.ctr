}.



wine
	kaso: ['cabernet'] hasi: { Salida skirbi: ['it's a Cabernet!']. },
	kaso: ['syrah']    hasi: { Salida skirbi: ['it's a Syrah!'].    },
	kaso: ['merlot']   hasi: { Salida skirbi: ['it's a Merlot!'].   },
	kaso: ['malbec']   hasi: { Salida skirbi: ['it's a Malbec!'].   }.

