

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa maneho-di-memoria: 0.

>> txt := ['Word Salad'].
Salida skirbi: ['Text Length: '] + txt largura, liña-nobo.
Salida skirbi: ['Character at 2:'] + ( txt lèter: 2 ), liña-nobo.
Salida skirbi: (( txt buska: ['S'] ) - 0), liña-nobo.

Programa limpia.

usedMemory1 := (Programa memoria ? 0).


txt := ['Word Salad'].
Salida skirbi: ['Text Length: '] + txt largura, liña-nobo.
Salida skirbi: ['Character at 2:'] + ( txt lèter: 2 ), liña-nobo.
Salida skirbi: (( txt buska: ['S'] ) - 0), liña-nobo.

Programa limpia.
usedMemory2 := (Programa memoria ? 0).


txt := ['Word Salad'].
Salida skirbi: ['Text Length: '] + txt largura, liña-nobo.
Salida skirbi: ['Character at 2:'] + ( txt lèter: 2 ), liña-nobo.
Salida skirbi: (( txt buska: ['S'] ) - 0), liña-nobo.

Programa limpia.
usedMemory3 := (Programa memoria ? 0).



( usedMemory1 = usedMemory2 i: usedMemory1 = usedMemory3, i: usedMemory2 = usedMemory3 ) bèrdat: {
	Salida skirbi: ['No memory leaks here'].
}, falsu: {
	Salida skirbi: ['Leaking memory...'].
}.
