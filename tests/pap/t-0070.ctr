>> numbers := ['1,2,3'] parti: [','].
Salida skirbi: ['I got: '] + numbers konta + [' numbers.'],liña-nobo.
{ :i Salida skirbi: ['number #'] + i + [':'] + (numbers posishon: i), liña-nobo.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages parti: [' Or '].
Salida skirbi: ['We serve'], liña-nobo.
{ :i Salida skirbi: ['->'] + (beverages posishon: i), liña-nobo. } × (beverages konta).
Salida skirbi: (beverages uni: [',']), liña-nobo.
Salida skirbi: (numbers uni: ['||']).
