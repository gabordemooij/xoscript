Salida skirbi: ['Test object'], liña-nobo.
>> a := Opheto nobo. 

a ora: ['item:'] hasi: { :octhelper
	propio octhelper := octhelper. 
}.

a ora: ['item'] hasi: { <- propio octhelper.
}.

a item: Oct nobo.

>> old-octhelper-address := a item prototipo adrès-di-memoria.
a save-as: ['/tmp/a.bin'].
Salida skirbi: ['========== RELOADING SNAP:'], liña-nobo.

>> b := Opheto load-from: ['/tmp/a.bin'].

(b item prototipo adrès-di-memoria = old-octhelper-address) bèrdat: {
	Salida skirbi: ['Object link re-attached.'], liña-nobo.
}.
