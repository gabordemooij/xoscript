

# reference in world.c

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.
>> kódigo := {
	>> a := Dikshonario nobo.
	>> b := Dikshonario nobo.
	a konektá-ku: b.
	b konektá-ku: a.
}.
Programa maneho-di-memoria: 0.
Programa limpia.
usedMemory1 := (Programa memoria ? 0).
kódigo kuminsá.
Programa limpia.
usedMemory2 := (Programa memoria ? 0).
kódigo kuminsá.
Programa limpia.
usedMemory3 := (Programa memoria ? 0).
( usedMemory1 = usedMemory2 i: usedMemory1 = usedMemory3, i: usedMemory2 = usedMemory3 ) bèrdat: {
	Salida skirbi: ['No memory leaks here'].
}, falsu: {
	Salida skirbi: ['Leaking memory...'].
}.
