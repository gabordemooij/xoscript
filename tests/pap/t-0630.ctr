#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Patronchi nobo: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern kuadra: subject hasi: { :m :x
	Salida skirbi: m, liña-nobo.
	Salida skirbi: x, liña-nobo. <- ['XXX'].
}.
Salida skirbi: result, liña-nobo.