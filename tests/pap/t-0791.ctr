Server init.

>> DB := Maria-DB nobo anfitrion: ['localhost'],
	nòmber-di-usuario: ['xo'],
	kontraseña: ['pass123'],
	nòmber-di-base: ['xobase'],
	konektá.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> parameternan-di-buskeda := Maria-Konsulta nobo: SQL.

# set database
parameternan-di-buskeda base-di-dato: DB.

parameternan-di-buskeda trese: { :row
	Salida skirbi: row world, liña-nobo.
}.
