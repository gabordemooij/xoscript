
>> Greeter := Opheto nobo.
Greeter ora: ['nobo'] hasi: {
	propio nòmber := ['?'].
}.
Greeter ora: ['name:'] hasi: { :nòmber
	propio nòmber := nòmber.
}.
Greeter ora: ['greet'] hasi: {
	Salida skirbi: (['hello[you]'] [you]: propio nòmber).
}.
>> friend := Greeter nobo.
friend name: ['1'].
friend greet.
