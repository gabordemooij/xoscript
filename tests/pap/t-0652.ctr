# test number -> string -> number
{

	>> x := Number entre: 0 ku: 1000000.
	>> d := Number entre: 1 ku: 7.
	>> e := 10 potensia: d.

	x dividí-pa: e.
	>> y := x teksto number.

	(x = y) falsu: {
		Salida skirbi: x, liña-nobo.
		Salida skirbi: y, liña-nobo.
		Programa terminá.
	}.

} * 1000.
Salida skirbi: ['OK'], liña-nobo.