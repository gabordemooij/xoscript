Salida skirbi: ['Test object'], liña-nobo.
>> greeter := Opheto nobo.
greeter ora: ['name:'] hasi: { :nòmber
	propio xname := nòmber. 
}.
greeter ora: ['greet'] hasi: {
	Salida skirbi: ['Hello '] + propio xname, liña-nobo.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Salida skirbi: ['========== RELOADING SNAP:'], liña-nobo.
>> b := Opheto load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
