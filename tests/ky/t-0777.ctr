#OBSD
>> dirname := [''].
{ dirname аягына-кошуу: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Программа система: command.
Программа chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename аягына-кошуу: ['YYYYYYYY']. } * 20.
Файл жаңы: filename, жазуу: ['sometext'].
{ Файл тизме: ['/tmp/'] + dirname. } * 1000.
Чыгаруу жазуу: ['no crash'], жаңы-сап.

