Чыгаруу жазуу: ['Test object'], жаңы-сап.
>> a := Объект жаңы. 
a келгенде: ['item:'] аткар: { :lst
	өзүнүн lst := lst. 
}.
a келгенде: ['item'] аткар: { <- өзүнүн lst.
}.
a item: (
	Тизме жаңы ; 1 ; (
		Тизме жаңы ; ['a'] ; (
			Тизме жаңы ; ( Учур жаңы: 1 )
		) ; ( Int64 тексттен: ['321'] )
	)
).
Чыгаруу жазуу: a item, жаңы-сап.
>> old-lst-address := a item прототип эс-дареги.
a save-as: ['/tmp/a.bin'].
Чыгаруу жазуу: ['========== RELOADING SNAP:'], жаңы-сап.
>> b := Объект load-from: ['/tmp/a.bin'].
(b item прототип эс-дареги = old-lst-address) чын-болсо: {
	Чыгаруу жазуу: ['Object link re-attached.'], жаңы-сап.
}.
Чыгаруу жазуу: ( b item ), жаңы-сап.
