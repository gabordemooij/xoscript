>> z := Объект жаңы.
z келгенде: ['value:'] аткар: { :v
	өзүнүн value := v. <- өзү.
}.
z келгенде: ['value'] аткар: { <- өзүнүн value. }.
(z setValue: 1) value: 2.
Чыгаруу жазуу: z value.
>> x := z.
Чыгаруу жазуу: x value.
z := Бош.
Чыгаруу жазуу: z value.
Чыгаруу жазуу: x value.
Чыгаруу жазуу: ['hello'].
Чыгаруу жазуу: 3 + 2.
Чыгаруу жазуу: (3 > 2).
