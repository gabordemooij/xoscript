


>> Deck := Тизме жаңы.
Deck келгенде: ['print'] аткар: {
        >> len := өзү саны - 1.
        { :i
                >> len2 := өзү саны - 1.
                Чыгаруу жазуу: ['len: '].
                Чыгаруу жазуу: len, жаңы-сап.
                Чыгаруу жазуу: ['len2: '].
                Чыгаруу жазуу: len2, жаңы-сап.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
