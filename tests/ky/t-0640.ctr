
Server init.
Чыгаруу жазуу: ['Database test'], жаңы-сап.

>> db := Maria-DB жаңы хост: ['localhost'],
	колдонуучу-аты: ['xo'], 
	сырсөз: ['pass123'],
	маалымат-базасынын-аты: ['xobase'],
	туташуу.

>> издөө-параметрлери :=
db суроо-талап: ['SELECT UNHEX('CAFE') AS blobby'],
алуу: { :row
	Чыгаруу жазуу: ( row blobby баштап: 0 узундук: 2 ), жаңы-сап.
	row blobby бошотуу.
}.
