

Текст келгенде: ['evaluate'] аткар: {
	>> код := Файл жаңы: ['/tmp/eval.ctr'].
	код жазуу: өзү текст + ['.'].
	Программа пайдалануу: ['/tmp/eval.ctr'].
}.

>> a := (Тизме ← (
	(Сөздүк жаңы)
		салуу: ['domain'] ачкыч: ['mywebsite.com'],
		салуу: (Тизме ←
			((Сөздүк жаңы)
				салуу: ['home'] ачкыч: ['title'],
				салуу: ['<html></html>'] ачкыч: ['body'],
				салуу: ['2017-01-01'] ачкыч: ['created']
			) ;
			((Сөздүк жаңы)
				салуу: ['aboutus(c)'] ачкыч: ['title'],
				салуу: ['<credits>Author Inc.</credits>'] ачкыч: ['body']
			)
		) ачкыч: ['pages']
	)
) текст.

Чыгаруу жазуу: a түр, жаңы-сап.
Чыгаруу жазуу: a, жаңы-сап.

>> b := Бош.
(['b := '] + a) evaluate.
Чыгаруу жазуу: b ? 0 ? ['pages'] ? 1 ? ['body'], жаңы-сап.

>> c := b ? 0.
>> d := c текст.
Чыгаруу жазуу: d түр, жаңы-сап.

>> e := Бош.
(['e := '] + d) evaluate.
Чыгаруу жазуу: e ? ['pages'] ? 0, жаңы-сап.
