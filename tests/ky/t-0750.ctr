Чыгаруу жазуу: ['Test object'], жаңы-сап.
>> a := Объект жаңы. 

a келгенде: ['item:'] аткар: { :nil
	өзүнүн nil := nil. 
}.

a келгенде: ['item'] аткар: { <- өзүнүн nil.
}.

a item: Бош.

Чыгаруу жазуу: a item, жаңы-сап.

>> old-nil-address := a item прототип эс-дареги.
a save-as: ['/tmp/a.bin'].
Чыгаруу жазуу: ['========== RELOADING SNAP:'], жаңы-сап.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип эс-дареги = old-nil-address) чын-болсо: {
	Чыгаруу жазуу: ['Object link re-attached.'], жаңы-сап.
}.

Чыгаруу жазуу: b item, жаңы-сап.
