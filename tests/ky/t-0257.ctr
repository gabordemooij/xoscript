
>> Greeter := Объект жаңы.
Greeter келгенде: ['жаңы'] аткар: {
	өзүнүн аталыш := ['?'].
}.
Greeter келгенде: ['name:'] аткар: { :аталыш
	өзүнүн аталыш := аталыш.
}.
Greeter келгенде: ['greet'] аткар: {
	Чыгаруу жазуу: (['hello[you]'] [you]: өзүнүн аталыш).
}.
>> friend := Greeter жаңы.
friend name: ['1'].
friend greet.
