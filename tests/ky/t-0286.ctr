['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Чыгаруу жазуу: (x + y), жаңы-сап.

>> x := 10040.07.
>> y := 10305.60.

Чыгаруу жазуу: (x + y), жаңы-сап.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Чыгаруу жазуу: (x + y + z), жаңы-сап.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Чыгаруу жазуу: (x + y + z), жаңы-сап.

>> q := 0.1.2.

Чыгаруу жазуу: (q), жаңы-сап.

>> q := 012.

Чыгаруу жазуу: (q), жаңы-сап.
