>> items := Сөздүк жаңы.
items салуу: ['black'] ачкыч: ['coffee'], салуу: ['earl grey'] ачкыч: ['tea'].
Чыгаруу жазуу: (items ордунда: ['coffee']), жазуу: (items ордунда: ['tea']).
Чыгаруу жазуу: ['there are'] + items саны + [' items in the array.'].
items салуу: ['capuccino'] ачкыч: ['coffee'].
Чыгаруу жазуу: ['Now my coffee is.. '] + (items ордунда: ['coffee']).
items салуу: ['aaa'] ачкыч: ['1'].
items салуу: ['bbb'] ачкыч: ['2'].
Чыгаруу жазуу: (items ордунда: ['a']).
