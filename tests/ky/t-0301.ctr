


>> wine := Объект жаңы.


wine келгенде: ['toString'] аткар: { <- ['merlot'].
}.

wine келгенде: ['naarTekst'] аткар: { <- ['merlot'].
}.


wine келгенде: ['='] аткар: { :other wine <- ( өзү toString = other wine ).
}.

wine келгенде: ['=='] аткар: { :other wine <- ( өзү toString = other wine ).
}.



wine
	учур: ['cabernet'] аткар: { Чыгаруу жазуу: ['it's a Cabernet!']. },
	учур: ['syrah']    аткар: { Чыгаруу жазуу: ['it's a Syrah!'].    },
	учур: ['merlot']   аткар: { Чыгаруу жазуу: ['it's a Merlot!'].   },
	учур: ['malbec']   аткар: { Чыгаруу жазуу: ['it's a Malbec!'].   }.

Чыгаруу жаңы-сап.
