Server init.

>> DB := Maria-DB жаңы хост: ['localhost'],
	колдонуучу-аты: ['xo'],
	сырсөз: ['pass123'],
	маалымат-базасынын-аты: ['xobase'],
	туташуу.

{
	DB суроо-талап:
	['DROP TABLE movies'],
	аткаруу.
} кармоо: { Бош. }, иштетүү.

DB суроо-талап:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
аткаруу.

DB суроо-талап: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
параметрлер: ( Тизме жаңы ; ['Halloween'] ),
аткаруу.

DB суроо-талап: ['SELECT * FROM movies'],
алуу: { :movie
	Чыгаруу жазуу: movie title, жаңы-сап.
}.

