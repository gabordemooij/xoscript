>> repeater := Объект жаңы.
repeater келгенде: ['жооп:'] аткар: { :what
	Чыгаруу жазуу: what + [' '].
}.
repeater келгенде: ['жооп:жана:'] аткар: { :what :say
	Чыгаруу жазуу: what, жазуу: say + [' '].
}.
repeater келгенде: ['жооп:жана:жана:'] аткар: { :what :say :more
	Чыгаруу жазуу: what, жазуу: say, жазуу: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
