Сан келгенде: ['roman'] аткар: {
	>> сан := өзү көчүрүү.
	>> roman := [''].
	{
		{
			(сан ≥ 1000) чын-болсо: {
				roman аягына-кошуу: ['Ⅿ'].
				сан кемитүү: 1000.
			}, үзүү.
		
			(сан ≥ 500) чын-болсо: {
				roman аягына-кошуу: ['Ⅾ'].
				сан кемитүү: 500.
			}, үзүү.
		
			(сан ≥ 100) чын-болсо: {
				roman аягына-кошуу: ['Ⅽ'].
				сан кемитүү: 100.
			}, үзүү.
		
			(сан ≥ 50) чын-болсо: {
				roman аягына-кошуу: ['Ⅼ'].
				сан кемитүү: 50.
			}, үзүү.
		
			(сан ≥ 50) чын-болсо: {
				roman аягына-кошуу: ['Ⅼ'].
				сан кемитүү: 50.
			}, үзүү.
		
			(сан ≥ 10) чын-болсо: {
				roman аягына-кошуу: ['Ⅹ'].
				сан кемитүү: 10.
			}, үзүү.
			
			(сан ≥ 9) чын-болсо: {
				roman аягына-кошуу: ['Ⅸ'].
				сан кемитүү: 9.
			}, үзүү.
			
			(сан ≥ 5) чын-болсо: {
				roman аягына-кошуу: ['Ⅴ'].
				сан кемитүү: 5.
			}, үзүү.
			
			(сан ≥ 4) чын-болсо: {
				roman аягына-кошуу: ['Ⅳ'].
				сан кемитүү: 4.
			}, үзүү.
			
			(сан ≥ 1) чын-болсо: {
				roman аягына-кошуу: ['Ⅰ'].
				сан кемитүү: 1.
			}, үзүү.
		} процедура.
	} азырынча: { <- сан > 0. }. <- roman.
}.

Чыгаруу жазуу: 1 roman, жаңы-сап.
Чыгаруу жазуу: 2 roman, жаңы-сап.
Чыгаруу жазуу: 4 roman, жаңы-сап.
Чыгаруу жазуу: 8 roman, жаңы-сап.
Чыгаруу жазуу: 16 roman, жаңы-сап.
Чыгаруу жазуу: 32 roman, жаңы-сап.
Чыгаруу жазуу: 64 roman, жаңы-сап.
Чыгаруу жазуу: 128 roman, жаңы-сап.
Чыгаруу жазуу: 256 roman, жаңы-сап.
Чыгаруу жазуу: 1024 roman, жаңы-сап.
