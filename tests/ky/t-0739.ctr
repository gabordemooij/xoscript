Чыгаруу жазуу: ['Test object'], жаңы-сап.
>> a := Объект жаңы. 

a келгенде: ['item:'] аткар: { :binhelper
	өзүнүн binhelper := binhelper. 
}.

a келгенде: ['item'] аткар: { <- өзүнүн binhelper.
}.

a item: Bin жаңы.

>> old-binhelper-address := a item прототип эс-дареги.
a save-as: ['/tmp/a.bin'].
Чыгаруу жазуу: ['========== RELOADING SNAP:'], жаңы-сап.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип эс-дареги = old-binhelper-address) чын-болсо: {
	Чыгаруу жазуу: ['Object link re-attached.'], жаңы-сап.
}.


