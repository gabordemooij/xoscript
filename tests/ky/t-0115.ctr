{
	ушул-тапшырма ката: ['Dont fail.'].
	unknown doSomething.
} кармоо: {
	Чыгаруу жазуу: ['Caught!'].
}, иштетүү.

{
	ушул-тапшырма ката: ['Dont fail.'].
	өзүнүн unknown doSomething.
} кармоо: {
	Чыгаруу жазуу: ['Caught!'].
}, иштетүү.

{
	ушул-тапшырма ката: ['Dont fail.'].
	unknown := 122.
} кармоо: {
	Чыгаруу жазуу: ['Caught!'].
}, иштетүү.


{
	ушул-тапшырма ката: ['Dont fail.'].
	Чын үзүү.
	Чыгаруу жазуу: ['FAIL'].
} кармоо: {
	Чыгаруу жазуу: ['Caught!'].
}, иштетүү.

{
	{
		ушул-тапшырма ката: ['Dont fail.'].
		Чын үзүү.
		Чыгаруу жазуу: ['FAIL'].
	} кармоо: { :x
		(x = ['Dont fail.']) чын-болсо: { ушул-тапшырма ката: ['Nested Caught!']. }.
	}, иштетүү.
} кармоо: { :e
	Чыгаруу жазуу: e.
}, иштетүү.
