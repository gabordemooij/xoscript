60 × {
	>> x := (Сан random % 6) + 1.
	(x ≤ 6) жалган-болсо: { Чыгаруу жазуу: ['FAIL']. }.
	(x ≥0) жалган-болсо: { Чыгаруу жазуу: ['FAIL']. }.
	x := (Сан random % 3) + 1.
	(x < 3) жалган-болсо: { Чыгаруу жазуу: ['FAIL']. }.
	(x>-1) жалган-болсо: { Чыгаруу жазуу: ['FAIL']. }.
	x := ((Логикалык flip) сан).
	(x = 0 же: x = 1) жалган-болсо: { Чыгаруу жазуу: ['FAIL']. }.
	x := ((Чын flip) сан).
	(x = 0 же: x = 1) жалган-болсо: { Чыгаруу жазуу: ['FAIL']. }.
	x := (Логикалык flip бул: ['HEAD'] же-тиги: ['TAIL']).
	((x = ['HEAD']) же: (x = ['TAIL'])) жалган-болсо: { Чыгаруу жазуу: ['FAIL']. }.
}.
Чыгаруу жазуу: ['DONE'].

