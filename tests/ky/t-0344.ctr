# catch-all test (practical)
>> HTML := Текст жаңы.
HTML келгенде: ['encode:'] аткар: { :tekst
	өзү аягына-кошуу: (tekst
	алмаштыруу: ['&'] буга: ['&amp;'], 
	алмаштыруу: ['<'] буга: ['&lt;'],
	алмаштыруу: ['>'] буга: ['&gt;'],
	алмаштыруу: ['"'] буга: ['&quot;']).
}.
>> blog := HTML жаңы.
blog аягына-кошуу: ['<h1>'],
     encode: ['Koffie & Thee'],
     аягына-кошуу: ['</h1>'].
Чыгаруу жазуу: blog, жаңы-сап.


>> Roman := Сан жаңы.
Roman келгенде: ['stringy'] аткар: {
	>> a := [''].
	{ a аягына-кошуу: ['I']. } × өзү. <- a.
}.

>> x := Roman жаңы.
x кошуу: 3.
Чыгаруу жазуу: x stringy, жаңы-сап.

>> Quantum := Логикалык жаңы.
Quantum келгенде: ['true?'] аткар: { <- ['maybe True']. }.
Чыгаруу жазуу: (Quantum жаңы true?), жаңы-сап.

>> Nihil := Бош жаңы.
Nihil келгенде: ['текст'] аткар: { <- ['Nihil']. }.
Чыгаруу жазуу: (Nihil жаңы), жаңы-сап.
