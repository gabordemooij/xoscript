>> makeAdder := { :x
	>> f := { :y <- (өзүнүн x + y). } коюу: ['x'] маани: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i өзүнүн q салуу: (өзүнүн f колдонуу: (өзүнүн q ? i)) ачкыч: i. } 
	коюу: ['q'] маани: array,
	коюу: ['f'] маани: func.
	{ :i mapping колдонуу: i. } × (array саны).
}.

>> a := Тизме ← 1; 2; 3.
mapper колдонуу: a жана: (makeAdder колдонуу: 100).
Чыгаруу жазуу: (a орун: 0), жаңы-сап.
Чыгаруу жазуу: (a ? 1), жаңы-сап.
Чыгаруу жазуу: (a ? 2), жаңы-сап.
