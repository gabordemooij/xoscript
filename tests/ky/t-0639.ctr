
Server init.
Чыгаруу жазуу: ['Database test'], жаңы-сап.

>> db := Maria-DB жаңы хост: ['localhost'],
	колдонуучу-аты: ['xo'], 
	сырсөз: ['pass123'],
	маалымат-базасынын-аты: ['xobase'],
	туташуу.

>> издөө-параметрлери :=
db суроо-талап: ['SELECT REPEAT('Blah',1000) AS blah'], 
алуу: { :row 
	Чыгаруу жазуу: row blah узундук, жаңы-сап.
}.
