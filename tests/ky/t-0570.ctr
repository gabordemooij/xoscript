#Linux

 >> t := Учур жаңы.
 
t убакыт-алкагы: ['Europe/Amsterdam'].
t жыл: 2020, ай: 8, күн: 2, саат: 21, мүнөт: 2, секунд: 1.

>> a := t саат.
>> ams := t убакыт-алкагы.

t убакыт-алкагы: ['US/Hawaii'].
>> b := t саат.
>> hw := t убакыт-алкагы.

Чыгаруу
жазуу: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		бул: ['later'] же-тиги: ['earlier']
	)
),
жаңы-сап.
 