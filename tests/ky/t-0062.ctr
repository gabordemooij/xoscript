Логикалык келгенде: ['xor:'] аткар: { :a :b <- ((a жана: b тескери) же: (a тескери жана: b)).
}.

>> o := Объект жаңы.
o келгенде: ['hello'] аткар: { ['Empty']. }.
{ o келгенде: 2 аткар: 3.} кармоо: { :e Чыгаруу жазуу: e, жаңы-сап. }, иштетүү.
{ o келгенде: ['сыноо'] аткар: 3.} кармоо: { :e Чыгаруу жазуу: e, жаңы-сап. }, иштетүү.
{ o келгенде: ['hello'] аткар: { ['Empty']. }.} кармоо: { :e Чыгаруу жазуу: e, жаңы-сап. }, иштетүү. 
{ >> z := 4 ÷ 0. } кармоо: { :e Чыгаруу жазуу: e, жаңы-сап. }, иштетүү. 
{ (Чын жана: Бош) чын-болсо: { Чыгаруу жазуу: ['X'].}. } кармоо: { :e Чыгаруу жазуу: e, жаңы-сап. }, иштетүү. 
{ ([''] xor: 0) чын-болсо: { Чыгаруу жазуу: ['X'].}. } кармоо: { :e Чыгаруу жазуу: e, жаңы-сап. }, иштетүү. 
{ (1 < ['2']) чын-болсо: { Чыгаруу жазуу: ['OK']. }. } кармоо: { :e Чыгаруу жазуу: e, жаңы-сап. }, иштетүү. 
{ (1 < ['2.0']) чын-болсо: { Чыгаруу жазуу: ['OK']. }. } кармоо: { :e Чыгаруу жазуу: e, жаңы-сап. }, иштетүү. 
{ (1 < ['x2.0']) чын-болсо: { Чыгаруу жазуу: ['NO!']. }. } кармоо: { :e Чыгаруу жазуу: e, жаңы-сап. }, иштетүү. 
{ Чыгаруу жазуу: (['hello OK there'] баштап: ['6'] узундук: ['2']). } иштетүү. 
