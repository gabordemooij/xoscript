Чыгаруу жазуу: ['Test object'], жаңы-сап.
>> a := Объект жаңы. 

a келгенде: ['state:'] аткар: { :list
	өзүнүн list := list. 
}.

a келгенде: ['state'] аткар: {
	Чыгаруу жазуу: өзүнүн list, жаңы-сап.
}.

a state: ( Тизме жаңы ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
Чыгаруу жазуу: ['========== RELOADING SNAP:'], жаңы-сап.
>> b := Объект load-from: ['/tmp/a.bin'].
b state.