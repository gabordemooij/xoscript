>> t := Бош.

# you can control the time zone for
# parsing like this:
Учур убакыт-алкагы: ['CET'].
t := Учур булак: ['1981-02-03 04:05:06'].
Чыгаруу жазуу: t, жаңы-сап.

# now using CEST time zone:
Учур убакыт-алкагы: ['CEST'].
t := Учур булак: ['1981-02-03 04:05:06'].
Чыгаруу жазуу: t, жаңы-сап.

# error if string cannot be parsed
{ Учур булак: ['1900']. } кармоо: { Бош. }, иштетүү.
