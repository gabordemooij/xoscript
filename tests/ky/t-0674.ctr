# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> жол := ['/tmp/dat.csv'].
>> csv := Файл жаңы: жол.
csv жазуу: s.

# accepts CRLF LF CR, varying row length
csv бөлгүч: [';'] тырмакча: ['"'] саптар: { :line
	Программа тазалоо.
	Чыгаруу жазуу: line, жаңы-сап.
	Программа тазалоо.
}.

# unequal lines
s аягына-кошуу: ['\njustone'].
csv жазуу: s.
{
	csv бөлгүч: [';'] тырмакча: ['"'] саптар: { :line
		Чыгаруу жазуу: line, жаңы-сап.
	}.
} кармоо: { :e 
	Чыгаруу жазуу: e, жаңы-сап.
}, иштетүү.

# invalid format
s := ['"he"llo";world'].
csv жазуу: s.
{
	csv бөлгүч: [';'] тырмакча: ['"'] саптар: { :line
		Чыгаруу жазуу: line, жаңы-сап.
	}.
} кармоо: { :e 
	Чыгаруу жазуу: e, жаңы-сап.
}, иштетүү.
