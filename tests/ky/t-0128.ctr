
Тизме келгенде: ['sum'] аткар: {
	>> total := 0.
	өзү ар-бир: { :index :element
		total кошуу: element.
	}. <- total.
}.

>> a := Тизме ← 9 ; 8 ; 7.
Чыгаруу жазуу: (a sum), жаңы-сап. 
>> a := Тизме ← 1 ; 9.
Чыгаруу жазуу: (a sum), жаңы-сап. 
>> a := Тизме ← ['o'] ; 2.
Чыгаруу жазуу: (a sum), жаңы-сап. 
Чыгаруу жазуу: (Тизме жаңы sum), жаңы-сап. 
