>> map1 := Сөздүк жаңы.
>> key1 := Тизме жаңы.
>> key2 := Тизме жаңы.

map1
	салуу: ['hello'] ачкыч: key1,
	салуу: ['world'] ачкыч: key2.


Чыгаруу
	жазуу: ['Map #1 contains: '] + (map1 ордунда: key1),
	жазуу: [' and '] + (map1 ордунда: key2), жаңы-сап.

>> KeyeableArray := Тизме жаңы.
KeyeableArray келгенде: ['toString'] аткар: { <- (өзү саны) toString.
}.

>> map2 := Сөздүк жаңы.
key1 := KeyeableArray жаңы.
key2 := KeyeableArray жаңы.

key1 аягына-кошуу: 1.

map2
	салуу: ['hello'] ачкыч: key1,
	салуу: ['world'] ачкыч: key2.

Чыгаруу
	жазуу: ['Map #2 contains: '] + (map2 ордунда: key1),
	жазуу: [' and '] + (map2 ордунда: key2), жаңы-сап.
