Server init.
>> fmt := Формат жаңы: ['%#3x'].

>> blob := Blob жаңы: 4.
blob bytes: ( 
	Тизме жаңы ; 0 ; 1 ; 2 ; 3
).

>> file := Файл жаңы: ['/tmp/blob'].
file blob: blob.
blob бошотуу.

>> окуу := file blob.
окуу 
баштап: 0 
узундук: 4, 
чынжыр-башы ар-бир: { :i :b 
	Чыгаруу
	жазуу: (fmt колдонуу-бүтүн: b),
	жаңы-сап.
}.
окуу бошотуу.
