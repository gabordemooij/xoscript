>> a := Тизме ← Объект ; Чын ; Жалган ; Логикалык ; 1 ; Сан ; ['Str'] ; Текст ; { ['Empty']. }.
Чыгаруу жазуу: (a саны), жаңы-сап.
{ :i
	Чыгаруу жазуу: 
	['a '] + 
	((a ? i) түр) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Бош?) бул: [''] же-тиги: ['NOT']) + 
	[' Nil.'],
	жаңы-сап.
} × (a саны).
Чыгаруу жазуу: ['but.. Nil is.. '] + ((Бош Бош?) бул: ['certainly NIL!'] же-тиги: ['not NIL??']), жаңы-сап.