>> To-Do := Объект жаңы.

To-Do келгенде: ['жаңы'] аткар: {
	өзүнүн list := Тизме жаңы.
}.

To-Do келгенде: ['nieuw'] аткар: {
	өзүнүн list := Тизме жаңы.
}.

To-Do келгенде: ['+'] аткар: { :task
	өзүнүн list аягына-кошуу: task.
}.

To-Do келгенде: ['number of tasks?'] аткар: { <-  өзүнүн list саны.
}.

>> todos := 
	To-Do жаңы 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Чыгаруу жазуу: ['You have $ tasks to do'] $ todos number of tasks?.
