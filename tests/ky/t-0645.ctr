Server init.
Чыгаруу жазуу: ['Database date test'], жаңы-сап.

>> db := Maria-DB жаңы хост: ['localhost'],
	колдонуучу-аты: ['xo'], 
	сырсөз: ['pass123'],
	маалымат-базасынын-аты: ['xobase'],
	туташуу.

>> издөө-параметрлери :=
db суроо-талап: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
алуу: { :row
	Чыгаруу жазуу: row datetest, жаңы-сап.
}.
