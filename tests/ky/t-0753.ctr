Чыгаруу жазуу: ['Test object'], жаңы-сап.
>> a := Объект жаңы. 

a келгенде: ['item:'] аткар: { :fmt
	өзүнүн fmt := fmt. 
}.

a келгенде: ['item'] аткар: { <- өзүнүн fmt.
}.

a item: ( Формат жаңы: ['|%s|'] ).

Чыгаруу жазуу: a item, жаңы-сап.

>> old-fmt-address := a item прототип эс-дареги.
a save-as: ['/tmp/a.bin'].
Чыгаруу жазуу: ['========== RELOADING SNAP:'], жаңы-сап.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип эс-дареги = old-fmt-address) чын-болсо: {
	Чыгаруу жазуу: ['Object link re-attached.'], жаңы-сап.
}.

Чыгаруу жазуу: ( b item колдонуу: ['hello'] ), жаңы-сап.
