Server init.
Чыгаруу жазуу: ['Database time test'], жаңы-сап.

>> db := Maria-DB жаңы хост: ['localhost'],
	колдонуучу-аты: ['xo'], 
	сырсөз: ['pass123'],
	маалымат-базасынын-аты: ['xobase'],
	туташуу.

>> издөө-параметрлери :=
db суроо-талап: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
алуу: { :row
	Чыгаруу жазуу: row timetest, жаңы-сап.
}.
