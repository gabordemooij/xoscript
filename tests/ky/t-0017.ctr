Сан келгенде: ['factorial'] аткар: {
	>> total := 1.
	{ :index total көбөйтүү: (өзү - (index)). } × өзү. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Чыгаруу жазуу: a.
>> b := 2 + 3 factorial.
Чыгаруу жазуу: b.
>> c := 3 factorial + 2.
Чыгаруу жазуу: c.
>> d := 2 + (3 factorial).
Чыгаруу жазуу: d.
Чыгаруу жазуу: 2 + 3 factorial + 1.
