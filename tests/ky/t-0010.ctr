>> Animal := Объект жаңы.
Animal келгенде: ['make'] аткар: {
	>> animal := Объект жаңы.
	animal келгенде: ['makeSound'] аткар: {
		Чыгаруу жазуу: өзүнүн sound.
	}. <- animal.
}.
>> Cat := Объект жаңы.
Cat келгенде: ['make'] аткар: {
	>> cat := Animal make.
	cat келгенде: ['init'] аткар: {
		өзүнүн sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
