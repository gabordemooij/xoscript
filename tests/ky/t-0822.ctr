# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := Maria-DB жаңы хост: ['localhost'],
	колдонуучу-аты: ['xo'],
	сырсөз: ['pass123'],
	маалымат-базасынын-аты: ['xobase'],
	туташуу.

>> издөө-параметрлери := db суроо-талап: ['SELECT ? AS a, ? AS b, ? AS c'].
издөө-параметрлери параметрлер: (Тизме жаңы ; ['1']).
{ издөө-параметрлери алуу: { :row Чыгаруу жазуу: row, жаңы-сап. }. } кармоо: { :e Чыгаруу жазуу: e, жаңы-сап. }, иштетүү.

>> издөө-параметрлери := db суроо-талап: ['SELECT ? AS a'].
{ издөө-параметрлери алуу: { :row Чыгаруу жазуу: row, жаңы-сап. }. } кармоо: { :e Чыгаруу жазуу: e, жаңы-сап. }, иштетүү.

# the right number still works, more parameters are ignored as before
>> издөө-параметрлери := db суроо-талап: ['SELECT ? AS a, ? AS b'].
издөө-параметрлери параметрлер: (Тизме жаңы ; ['1'] ; ['2']).
издөө-параметрлери алуу: { :row Чыгаруу жазуу: (row ордунда: ['a']), жазуу: (row ордунда: ['b']), жаңы-сап. }.
издөө-параметрлери параметрлер: (Тизме жаңы ; ['1'] ; ['2'] ; ['3']).
издөө-параметрлери алуу: { :row Чыгаруу жазуу: (row ордунда: ['a']), жазуу: (row ордунда: ['b']), жаңы-сап. }.
