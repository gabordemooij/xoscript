>> echo := Объект жаңы.
echo келгенде: ['жооп:'] аткар: { :sound
	{ Чыгаруу жазуу: sound. } × 2.
}.
echo ho!. 


echo := Объект жаңы.
echo келгенде: ['жооп:жана:'] аткар: { :sound :x
	{ Чыгаруу жазуу: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := Объект жаңы.
echo келгенде: ['жооп:жана:жана:'] аткар: { :operation :sound :x
	{ Чыгаруу жазуу: sound. } × x.
}.
echo shout: ['la'] times: 4. 


