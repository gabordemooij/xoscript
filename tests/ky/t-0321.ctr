# test qualifiers

Программа тазалоо.

>> Fruit := Объект жаңы.
Fruit келгенде: ['жаңы'] аткар: {
	>> f := өзү жаңы.
	f apples: 0. <- f.
}.
Fruit келгенде: ['apples:'] аткар: { :a өзүнүн apples := a. }.
Fruit келгенде: ['apples'] аткар: { <- өзүнүн apples. }.
Fruit келгенде: ['+'] аткар: { :f
	>> n := Fruit жаңы.
	n apples: (f apples + өзүнүн apples). <- n.
}.
Сан келгенде: ['apples'] аткар: { <- ((Fruit жаңы) apples: өзү).
}.

Fruit келгенде: ['текст'] аткар: { <- өзүнүн apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Чыгаруу жазуу: q, жаңы-сап.




q := 3 apples + 4 apples.
Чыгаруу жазуу: q, жаңы-сап.



q := 3 apples + 4 apples.
Чыгаруу жазуу: q, жаңы-сап.


