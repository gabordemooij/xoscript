Server init.
>> f := Формат жаңы: ['%d'].
>> a := Blob жаңы: 4.
a bytes: ( Тизме жаңы ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob жаңы: 4.
b bytes: ( Тизме жаңы ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a баштап: 0 узундук: 3, ар-бир: { :i :byte
	Чыгаруу жазуу: ( f колдонуу-бүтүн: byte ), жаңы-сап.
}.
a ^ b.
a баштап: 0 узундук: 3, ар-бир: { :i :byte
	Чыгаруу жазуу: ( f колдонуу-бүтүн: byte ), жаңы-сап.
}.
a ^ b.
a баштап: 0 узундук: 3, ар-бир: { :i :byte
	Чыгаруу жазуу: ( f колдонуу-бүтүн: byte ), жаңы-сап.
}.
a бошотуу.
b бошотуу.

{ a ^ Объект. } кармоо: { :e Чыгаруу жазуу: e, жаңы-сап. }, иштетүү.
