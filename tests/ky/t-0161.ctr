Программа эсти-башкаруу: 0.
Тизме келгенде: ['sum'] аткар: {
	>> total := 0.
	өзү ар-бир: { :index :element
		total кошуу: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Файл жаңы: ['/tmp/test.txt'].
f жазуу: ['Lorem Ipsum'].
f жабуу.
  

f := Файл жаңы: ['/tmp/test.txt'].
>> text := f окуу.
f жабуу.



Программа тазалоо.
usedMemory1 := (Программа эс ? 1).



f := Файл жаңы: ['/tmp/test.txt'].
text := f окуу.
f жабуу.

Программа тазалоо.
usedMemory2 := (Программа эс ? 1).


f := Файл жаңы: ['/tmp/test.txt'].
text := f окуу.
f жабуу.

Программа тазалоо.
usedMemory3 := (Программа эс ? 1).



( usedMemory1 = usedMemory2 жана: usedMemory1 = usedMemory3, жана: usedMemory2 = usedMemory3 ) чын-болсо: {
	Чыгаруу жазуу: ['No memory leaks here'].
}, жалган-болсо: {
	Чыгаруу жазуу: ['Leaking memory...'].
