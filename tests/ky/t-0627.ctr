

# create a 64-bit integer for exact calculations
>> a := Int64 тексттен: ['123'].

# to string
Чыгаруу жазуу: a, жаңы-сап.

# divide
Чыгаруу жазуу: a / (Int64 тексттен: ['3']), жаңы-сап.

# multiply
Чыгаруу жазуу: a * (Int64 тексттен: ['2']), жаңы-сап.

# add
Чыгаруу жазуу: a + (Int64 тексттен: ['1']), жаңы-сап.

# subtract
Чыгаруу жазуу: a - (Int64 тексттен: ['2']), жаңы-сап.

# compare
Чыгаруу жазуу: ( a =   (Int64 тексттен: ['123'])), жаңы-сап.
Чыгаруу жазуу: ( a !=: (Int64 тексттен: ['124'])), жаңы-сап.
Чыгаруу жазуу: ( a <   (Int64 тексттен: ['124'])), жаңы-сап.
Чыгаруу жазуу: ( a >   (Int64 тексттен: ['122'])), жаңы-сап.
Чыгаруу жазуу: ( a >=: (Int64 тексттен: ['123'])), жаңы-сап.
Чыгаруу жазуу: ( a <=: (Int64 тексттен: ['123'])), жаңы-сап.





	