# a value ending in the first part of an opening quote must survive serialization
>> маанилер := Тизме жаңы
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

маанилер ар-бир: { :i :value
	>> d := Сөздүк жаңы.
	d салуу: value ачкыч: ['k'].
	d салуу: ['second'] ачкыч: ['j'].
	>> r := d код объект.
	Чыгаруу жазуу: r саны, жаңы-сап.
	Чыгаруу жазуу: ( (r ордунда: ['k']) = value ), жаңы-сап.
}.
