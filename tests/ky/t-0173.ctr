

Тизме келгенде: ['sum'] аткар: {
	>> total := 0.
	өзү ар-бир: { :index :element
		total кошуу: element.
	}. <- total.
}.

Тизме келгенде: ['product'] аткар: {
	>> total := 1.
	өзү ар-бир: { :index :element
		total көбөйтүү: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Программа эсти-башкаруу: 0.

{

>> a := Тизме ← ['hello'] ; ['world'] ; Чын ; Бош ; 666.
a := a + ( Тизме ← 1 ).
Чыгаруу жазуу: ( ['sum: '] + ( a sum ) ), жаңы-сап.
Чыгаруу жазуу: ( ['min: '] + ( a эң-кичине ) ), жаңы-сап.
Чыгаруу жазуу: ( ['max: '] + ( a эң-чоң ) ), жаңы-сап.
Чыгаруу жазуу: ( ['3rd: '] + ( a ? 2 ) ), жаңы-сап.
Чыгаруу жазуу: ( ['prd: '] + ( a product ) ), жаңы-сап.
a иреттөө: { :a :b <- (b - a). }.
a ар-бир: { :i :e Чыгаруу жазуу: ( i - 0 ), жаңы-сап. }.

} иштетүү.

Программа тазалоо.
usedMemory1 := (Программа эс ? 0).


