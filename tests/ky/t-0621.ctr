>> phrases := Тизме жаңы
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases ар-бир: { :_ :phrase 
	>> e := Server base64-коддоо: phrase.
	>> d := Server base64-декоддоо: e.
	Чыгаруу жазуу: (
		message көчүрүү ~encoded: e, ~decoded: d
	), жаңы-сап.
}.
