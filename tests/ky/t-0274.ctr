

Тизме келгенде: ['column:'] аткар: { :column
	>> result := Тизме жаңы.
	өзү ар-бир: { :index :row
		row ар-бир: { :index :cell
			(index = column) чын-болсо: { result аягына-кошуу: cell. }.
		}.
	}. <- result.
}.


>> a := Тизме ←
	(Тизме ← 1 ; 2 ; 3) ;
	(Тизме ← 4 ; 5 ; 6) ;
	(Тизме ← 7 ; 8 ; 9).

>> b := a column: 1.
Чыгаруу жазуу: b, жаңы-сап.

b := a column: 20.
Чыгаруу жазуу: b, жаңы-сап.

b := a column: -100.
Чыгаруу жазуу: b, жаңы-сап.
