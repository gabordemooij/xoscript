Чыгаруу жазуу: ['Test object'], жаңы-сап.
>> a := Объект жаңы. 

a келгенде: ['item:'] аткар: { :out
	өзүнүн out := out. 
}.

a келгенде: ['item'] аткар: { <- өзүнүн out.
}.

a келгенде: ['greet'] аткар: {
	Чыгаруу жазуу: ['hi from original out!'], жаңы-сап.
}.

a item: Чыгаруу.

Чыгаруу жазуу: a item, жаңы-сап.

>> old-out-address := a item прототип эс-дареги.
a save-as: ['/tmp/a.bin'].
Чыгаруу жазуу: ['========== RELOADING SNAP:'], жаңы-сап.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип эс-дареги = old-out-address) чын-болсо: {
	Чыгаруу жазуу: ['Object link re-attached.'], жаңы-сап.
}.

b item жазуу: ['hello from loaded out!'], жаңы-сап.
b greet.
