
Текст келгенде: ['evaluate'] аткар: {
	>> код := Файл жаңы: ['/tmp/eval.ctr'].
	код жазуу: (өзү текст + ['.']).
	Программа пайдалануу: ['/tmp/eval.ctr'].
}.

>> map :=
	(Сөздүк жаңы)
	салуу: ['Hi There'] ачкыч: ['two'],
	салуу: (Тизме ← ['hello'] ; ['world'] ; (Тизме ← 1 ; 2; 9) ; Жалган) ачкыч: ['one'],
	салуу: ( (Сөздүк жаңы) салуу: ['wrrld'] ачкыч: ['misspelled'] ) ачкыч: ['three'],
	салуу: (Тизме ← ((Сөздүк жаңы) салуу: ['treasure'] ачкыч: ['hidden']) ; 2) ачкыч: ['four']. 
>> str := map текст.
>> map2 := Бош.
(['map2 := '] + str ) evaluate.
Чыгаруу жазуу: map2 ? ['one'] ? 0.
Чыгаруу жазуу: map2 ? ['one'] ? 1.
Чыгаруу жазуу: map2 ? ['four'] ? 0 ? ['hidden'].
Чыгаруу жазуу: map2 ? ['one'] ? 2 ? 2.
