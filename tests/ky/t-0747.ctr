Чыгаруу жазуу: ['Test object'], жаңы-сап.
>> a := Объект жаңы. 

a келгенде: ['item:'] аткар: { :num
	өзүнүн num := num. 
}.

a келгенде: ['item'] аткар: { <- өзүнүн num.
}.

a item: 123.

Чыгаруу жазуу: a item, жаңы-сап.

>> old-num-address := a item прототип эс-дареги.
a save-as: ['/tmp/a.bin'].
Чыгаруу жазуу: ['========== RELOADING SNAP:'], жаңы-сап.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип эс-дареги = old-num-address) чын-болсо: {
	Чыгаруу жазуу: ['Object link re-attached.'], жаңы-сап.
}.

Чыгаруу жазуу: b item, жаңы-сап.
