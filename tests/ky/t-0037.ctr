>> a := 3.
>> b := a көчүрүү.
a кемитүү: 1.
Чыгаруу жазуу: [' a = '] + a.
Чыгаруу жазуу: [' b = '] + b.
a := 3.
b := a + 4.
Чыгаруу жазуу: [' a = '] + a.
Чыгаруу жазуу: [' b = '] + b.
>> x := 3.
>> y := x көчүрүү.
x кошуу: 10.
y кемитүү: 1.
Чыгаруу жазуу: [' x = '] + x.
Чыгаруу жазуу: [' y = '] + y.
>> q := Объект жаңы.
q келгенде: ['setProperty:'] аткар: { :x
	өзүнүн prop := x.
}.
q келгенде: ['getProperty'] аткар: { <- өзүнүн prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Чыгаруу жазуу: [' p = '] + (p getProperty).
