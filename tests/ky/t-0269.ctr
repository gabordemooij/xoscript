#Linux

(Файл жаңы: ['/tmp/testje']) бар жалган-болсо: {
	Программа система: ['mkdir /tmp/testje'].	
}.

(Файл жаңы: ['/tmp/testje/file1']) бар жалган-болсо: {
	Программа система: ['touch /tmp/testje/file1'].	
}.

(Файл жаңы: ['/tmp/testje/folder1']) бар жалган-болсо: {
	Программа система: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Файл тизме: ['/tmp/testje'].

>> q := Тизме жаңы.

l ар-бир: { :k :v v ар-бир: { :x :y q аягына-кошуу: y. }. }.

>> s := q текст.

(s камтыйт: ['file1']) чын-болсо:   { Чыгаруу жазуу: ['OK'], жаңы-сап. }.
(s камтыйт: ['file2']) чын-болсо:   { Чыгаруу жазуу: ['XX'], жаңы-сап. }.
(s камтыйт: ['folder1']) чын-болсо: { Чыгаруу жазуу: ['OK'], жаңы-сап. }.
