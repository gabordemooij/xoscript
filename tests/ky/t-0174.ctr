


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Программа эсти-башкаруу: 0.
>> palette := Бош.
>> colors := Бош.

{
palette := Сөздүк жаңы.
palette 
	салуу: ['#F00'] ачкыч: ['red'],
	салуу: ['#0F0'] ачкыч: ['green'],
	салуу: ['#00F'] ачкыч: ['blue'].
Чыгаруу жазуу: ['number of RGB codes in palette: '] + ( palette саны ), жаңы-сап.
Чыгаруу жазуу: ['RGB code of green is: '] + ( palette ? ['green'] ), жаңы-сап.
colors := [''].
( palette ар-бир: { :аталыш :код
		colors := colors + ( аталыш + [':'] + код ).
} ).
Чыгаруу жазуу: ['All colors in palette: '] + colors, жаңы-сап.
} иштетүү.
Программа тазалоо.
usedMemory1 := (Программа эс ? 0).

{
palette := Сөздүк жаңы.
palette 
	салуу: ['#F00'] ачкыч: ['red'],
