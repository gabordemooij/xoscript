Программа эсти-башкаруу: 4.

>> Doubler := Объект жаңы.
>> Multiplier := Объект жаңы.
Doubler келгенде: ['double:and:'] аткар: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier келгенде: ['multiply:and:'] аткар: { :x :y <- (x × y).
}.

Чыгаруу жазуу: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), жаңы-сап.
