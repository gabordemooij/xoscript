Сан келгенде: ['factorial'] аткар: {
	>> total := 1.
	{ :index total көбөйтүү: (өзү - (index)). } × өзү. <- total.
}.
>> Printer := Объект жаңы.
Printer келгенде: ['print:and:'] аткар: { :x :y
	Чыгаруу жазуу: ['a='] + x + [', b='] + y, жаңы-сап.
}.
>> a := 4.5. >> b := a төмөн-тегеректөө.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a жогору-тегеректөө.
Printer print: a and: b.
a := 4.5. b := a төмөн-тегеректөө.
Printer print: a and: b.
a := 4.5. b := a тегеректөө.
Printer print: a and: b.
a := 4.2. b := a тегеректөө.
Printer print: a and: b.

