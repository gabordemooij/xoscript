
>> Size := Объект жаңы.
Size келгенде: ['is:'] аткар: { :сан
	сан келгенде: ['+'] аткар: { :сан
		>> unit := сан өлчөө-бирдиги.
		>> factor := 1.
		
		unit
		учур: ['inch'] аткар: { factor := 0.0833. }. <- өзү + (сан * factor).
	}. <- сан.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Чыгаруу жазуу: plank + edge, жаңы-сап.
