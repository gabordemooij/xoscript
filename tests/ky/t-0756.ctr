Чыгаруу жазуу: ['Test object'], жаңы-сап.
>> greeter := Объект жаңы.
greeter келгенде: ['name:'] аткар: { :аталыш
	өзүнүн xname := аталыш. 
}.
greeter келгенде: ['greet'] аткар: {
	Чыгаруу жазуу: ['Hello '] + өзүнүн xname, жаңы-сап.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Чыгаруу жазуу: ['========== RELOADING SNAP:'], жаңы-сап.
>> b := Объект load-from: ['/tmp/a.bin'].
>> c := Объект load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
