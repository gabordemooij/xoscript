# backslashes must survive code serialization, strings must not end early
>> маанилер := Тизме жаңы
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

маанилер ар-бир: { :i :value
	>> d := Сөздүк жаңы.
	d салуу: value ачкыч: ['k'].
	>> r := d код объект.
	Чыгаруу жазуу: r саны, жаңы-сап.
	Чыгаруу жазуу: ( (r ордунда: ['k']) = value ), жаңы-сап.
}.
