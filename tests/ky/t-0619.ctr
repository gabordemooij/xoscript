>> HTML := Объект жаңы.
HTML келгенде: ['жооп:'] аткар: { :tag 
	Чыгаруу жазуу: (['<tag>'] tag: tag), жаңы-сап.
}.
HTML келгенде: ['жооп:жана:'] аткар: { :tag :html 
	Чыгаруу жазуу: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), жаңы-сап.
}.
>> html := HTML жаңы.
html body h1: ['header'].

