# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Үлгү жаңы: pattern.
	p дал-келүү: subject аткар: { :m :g
		Чыгаруу жазуу: g саны, жазуу: [' '], жазуу: (g бириктирүү: ['|']), жаңы-сап. <- m.
	}.
}.
show колдонуу: ['(a)|(b)'] жана: ['b'].
show колдонуу: ['(a)|(b)'] жана: ['a'].
show колдонуу: ['(x)?y'] жана: ['y'].
show колдонуу: ['(x)?(y)(z)?'] жана: ['xy'].
