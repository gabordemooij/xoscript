# test url parsing

Server init.
>> url := URL булак: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Чыгаруу жазуу: ['scheme = '] + url схема, жаңы-сап.
Чыгаруу жазуу: ['host = '] + url хост, жаңы-сап.
Чыгаруу жазуу: ['port = '] + url порт, жаңы-сап.
Чыгаруу жазуу: ['path = '] + url жол, жаңы-сап.
Чыгаруу жазуу: ['query = '] + url издөө-параметрлери, жаңы-сап.
Чыгаруу жазуу: ['fragment = '] + url фрагмент, жаңы-сап.
