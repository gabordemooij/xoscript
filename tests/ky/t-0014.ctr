>> Greeter := Объект жаңы.
Greeter келгенде: ['make'] аткар: {
	>> gr := Объект жаңы.
	gr келгенде: ['setName:'] аткар: { :aname
		өзүнүн аталыш := aname.
	}.
	gr келгенде: ['greet'] аткар: {
		Чыгаруу жазуу: өзүнүн аталыш.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a жаңы.
c setName: ['THREE'].
c greet.
>> d := a жаңы.
d setName: ['FOUR'].
d greet.
c greet.
