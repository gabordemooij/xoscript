>> Greeter := Объект жаңы.
Greeter келгенде: ['make'] аткар: {
	>> greeter := Объект жаңы.
	greeter келгенде: ['name:'] аткар: { :аталыш
		Чыгаруу жазуу: ['setting a name'].
		өзүнүн myName := аталыш.
	}.
	greeter келгенде: ['performGreeting'] аткар: {
		Чыгаруу жазуу: ['Hello'].
		Чыгаруу жазуу: өзүнүн myName.
	}.
	greeter келгенде: ['greet'] аткар: {
		өзү performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
