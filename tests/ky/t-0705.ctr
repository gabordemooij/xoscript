

>> obj := Объект жаңы.

obj келгенде: ['greet'] аткар: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj келгенде: ['task'] аткар: {
	өзүнүн property := 123.
	{
		# try binds self/own to object instead of block
		Чыгаруу жазуу: өзү greet.
		Чыгаруу жазуу: өзүнүн property.
		1 / 0.
	} кармоо: {
		Чыгаруу жазуу: өзү greet.
		Чыгаруу жазуу: өзүнүн property.
		Чыгаруу жазуу: ['ok'].
	}, аракет.
}.

obj task.