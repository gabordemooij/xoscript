

Тизме келгенде: ['fixture:'] аткар: { :f
	өзүнүн fixture := f.
}.

Тизме келгенде: ['саны'] аткар: { <- өзүнүн fixture.
}.

Тизме келгенде: ['aantal'] аткар: { <- өзүнүн fixture.
}.


>> x := Бош.
{

	x := ['hello'] 
	алмаштыруу:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] белги: 2)
			)
		)
	буга: (
		(['...hal'] + ['lo']) 
			баш-тамгалар 
			lowecase 
			баш-тамгалар 
			жылдыруу: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Тизме ← 0 ; 1 ; 4; 9 ; (Тизме ← 0 ; 3; 1) ; 4
							) акыркынын-алдындагы
						) ? 1
					) + 
					((Тизме ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					саны
				)
			)
	).

} × 10.
Чыгаруу жазуу: x, жаңы-сап.

