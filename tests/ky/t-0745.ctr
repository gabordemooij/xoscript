Чыгаруу жазуу: ['Test object'], жаңы-сап.
>> a := Объект жаңы. 

a келгенде: ['item:'] аткар: { :dict
	өзүнүн dict := dict. 
}.

a келгенде: ['item'] аткар: { <- өзүнүн dict.
}.

a item: (
Сөздүк жаңы
	hello: ['world']).

>> old-dict-address := a item прототип эс-дареги.
a save-as: ['/tmp/a.bin'].
Чыгаруу жазуу: ['========== RELOADING SNAP:'], жаңы-сап.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип эс-дареги = old-dict-address) чын-болсо: {
	Чыгаруу жазуу: ['Object link re-attached.'], жаңы-сап.
}.

Чыгаруу жазуу: b item, жаңы-сап.
