Программа эсти-башкаруу: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } кармоо: {
		oops кошуу: 1.
	}, иштетүү.
} × 1000.

{
	Чыгаруу жазуу: ['hi there!'].
	ушул-тапшырма ката: ['oops'].
	Чыгаруу жазуу: ['hi there!'].
	{ Чыгаруу жазуу: ['dont print this']. } иштетүү.
} кармоо: { :e 
	Чыгаруу жазуу: ['got ya!']. 
	Чыгаруу жазуу: e.
}, иштетүү.
