>> randomizer := { :a :b
	>> эң-кичине := ( a < b ) бул: a же-тиги: b.
	>> эң-чоң := ( a > b ) бул: a же-тиги: b.
	>> x := Бош.
	{
		x := Сан арасында: a менен: b.
		((x < эң-кичине) же: (x > эң-чоң)) чын-болсо: { 
			Чыгаруу жазуу: (['Invalid value!']).
			Программа бүтүрүү.
		}.
	} 
	× 100. <- x.
}.
randomizer колдонуу: 0 жана: 0.
