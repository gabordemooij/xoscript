

Текст келгенде: ['html'] аткар: { <- (
		өзү
		алмаштыруу: ['&'] буга: ['&amp;'],
		алмаштыруу: ['<'] буга: ['&lt;'],
		алмаштыруу: ['>'] буга: ['&gt;'],
		алмаштыруу: ['"'] буга: ['&quot;']
	).
}.


Чыгаруу жазуу: ([' left trimmed '] кыркуу) + [' '] + ( ['and right trimmed'] кыркуу) + ['!'], жаңы-сап.
Чыгаруу жазуу: ['<html>"html & entities"</html>'] html.
