# a format must fit the type of the value, the type can come from a client
>> аракет := { :format :value
	{ Чыгаруу жазуу: ( (Формат жаңы: format) колдонуу: value ), жаңы-сап. } кармоо: { :e Чыгаруу жазуу: e, жаңы-сап. }, иштетүү.
}.
>> try-int := { :format :value
	{ Чыгаруу жазуу: ( (Формат жаңы: format) колдонуу-бүтүн: value ), жаңы-сап. } кармоо: { :e Чыгаруу жазуу: e, жаңы-сап. }, иштетүү.
}.

# fits
аракет колдонуу: ['|%s|'] жана: ['text'].
аракет колдонуу: ['%06.2f'] жана: 5.5.
аракет колдонуу: ['100%% %s'] жана: ['sure'].
try-int колдонуу: ['%03d'] жана: 7.
try-int колдонуу: ['%x'] жана: 255.
аракет колдонуу: ['%d'] жана: (Int64 жаңы тексттен: ['12']).
аракет колдонуу: ['%lld'] жана: (Int64 жаңы тексттен: ['12']).
аракет колдонуу: ['%.1lf'] жана: 5.5.
try-int колдонуу: ['%hd'] жана: 7.

# does not fit
аракет колдонуу: ['%s'] жана: 12345.
аракет колдонуу: ['%d'] жана: 12345.
аракет колдонуу: ['%f'] жана: ['text'].
try-int колдонуу: ['%d'] жана: ['text'].
try-int колдонуу: ['%s'] жана: 5.
аракет колдонуу: ['%s %s'] жана: ['text'].
аракет колдонуу: ['%n'] жана: ['text'].
аракет колдонуу: ['%*s'] жана: ['text'].
аракет колдонуу: ['%'] жана: ['text'].

# length modifier does not fit
аракет колдонуу: ['%ls'] жана: ['text'].
аракет колдонуу: ['%Lf'] жана: 5.5.
try-int колдонуу: ['%ld'] жана: 7.
try-int колдонуу: ['%lld'] жана: 7.
аракет колдонуу: ['%Ld'] жана: (Int64 жаңы тексттен: ['12']).

# a width that does not fit printf must give an error, not a crash
аракет колдонуу: ['%99999999999s'] жана: ['text'].
