>> items := Сөздүк жаңы.
items салуу: ['green'] ачкыч: ['color-1'].
items салуу: ['orange'] ачкыч: ['color-2'].
items салуу: ['red'] ачкыч: ['color-3'].
>> i := 0.
>> s := [''].
items ар-бир: { :key :color
	Чыгаруу жазуу: ['color #'] + i + [' is: '] + color + [' '].
	i кошуу: 1.
}.
Чыгаруу жазуу: i + [' colors!'].
