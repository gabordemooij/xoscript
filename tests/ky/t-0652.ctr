# test number -> string -> number
{

	>> x := Сан арасында: 0 менен: 1000000.
	>> d := Сан арасында: 1 менен: 7.
	>> e := 10 даража: d.

	x бөлүү-санга: e.
	>> y := x текст сан.

	(x = y) жалган-болсо: {
		Чыгаруу жазуу: x, жаңы-сап.
		Чыгаруу жазуу: y, жаңы-сап.
		Программа бүтүрүү.
	}.

} * 1000.
Чыгаруу жазуу: ['OK'], жаңы-сап.