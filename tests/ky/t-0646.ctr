Server init.
Чыгаруу жазуу: ['Database datetime test'], жаңы-сап.

>> db := Maria-DB жаңы хост: ['localhost'],
	колдонуучу-аты: ['xo'], 
	сырсөз: ['pass123'],
	маалымат-базасынын-аты: ['xobase'],
	туташуу.

>> издөө-параметрлери :=
db суроо-талап: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
алуу: { :row
	Чыгаруу жазуу: row datetimetest, жаңы-сап.
}.
