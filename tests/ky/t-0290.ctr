# test list operations


>> cakes := Тизме ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes алмаштыруу: 1 узундук: 2 буга: ( Тизме ← ['cinnamon'] ; ['pineapple'] ).
Чыгаруу жазуу: (buy бириктирүү: [',']), жаңы-сап.


>> buy := cakes алмаштыруу: 1 узундук: 12 буга: ( Тизме ← ['cinnamon'] ; ['pineapple'] ).
Чыгаруу жазуу: (buy бириктирүү: [',']), жаңы-сап.


>> buy := cakes алмаштыруу: 2 узундук: 10 буга: ( Тизме жаңы ).
Чыгаруу жазуу: (buy бириктирүү: [',']), жаңы-сап.


>> buy := cakes алмаштыруу: 0 узундук: 1 буга: ( Тизме жаңы ).
Чыгаруу жазуу: (buy бириктирүү: [',']), жаңы-сап.


>> buy := cakes алмаштыруу: ['0'] узундук: ['1'] буга: ['x'].
Чыгаруу жазуу: (buy бириктирүү: [',']), жаңы-сап.
