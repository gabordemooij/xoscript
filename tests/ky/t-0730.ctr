Чыгаруу жазуу: ['Test object'], жаңы-сап.
>> a := Объект жаңы. 

a келгенде: ['item:'] аткар: { :moment
	өзүнүн moment := moment. 
}.

a келгенде: ['item'] аткар: { <- өзүнүн moment.
}.

>> today := Учур жаңы убакыт-алкагы: ['CEST'], жыл: 2026, ай: 7.
a item: today.
Чыгаруу жазуу: a item, жаңы-сап.
a save-as: ['/tmp/a.bin'].
Чыгаруу жазуу: ['========== RELOADING SNAP:'], жаңы-сап.
>> b := Объект load-from: ['/tmp/a.bin'].
Чыгаруу жазуу: b item, жаңы-сап.
