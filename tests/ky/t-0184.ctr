

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Программа эсти-башкаруу: 0.

Сан келгенде: ['addNum:'] аткар: { :x
	өзү кошуу: x.
}.

Сан келгенде: ['subtractNum:'] аткар: { :x
	өзү кемитүү: x.
}.

Сан келгенде: ['multiplyBy:'] аткар: { :x
	өзү көбөйтүү: x.
}.

Сан келгенде: ['divideBy:'] аткар: { :x
	өзү бөлүү-санга: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 даража: 8).  
a := a + (2 даража: -1). 
a := a + (49 квадраттык-тамыр).   
a addNum: ((Тизме ← 0 ; 1) эң-чоң).          
a addNum: ((Тизме ← 2 ; 3) эң-кичине).
Чыгаруу жазуу: a.

Программа тазалоо.

usedMemory1 := (Программа эс ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
