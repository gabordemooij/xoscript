#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Үлгү жаңы: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern дал-келүү: subject аткар: { :m :x
	Чыгаруу жазуу: m, жаңы-сап.
	Чыгаруу жазуу: x, жаңы-сап. <- ['XXX'].
}.
Чыгаруу жазуу: result, жаңы-сап.