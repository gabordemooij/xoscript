>> invoice := Объект жаңы.
invoice келгенде: ['иштетүү'] аткар: {
        өзүнүн сан := 0.
}.

invoice келгенде: ['сан'] аткар: {
        өзүнүн сан кошуу: 1. <- өзүнүн сан көчүрүү.
}.

>> year-invoice := invoice жаңы.
year-invoice келгенде: ['start:'] аткар: { :жыл
	өзүнүн сан := жыл.
}.

year-invoice start: 202000.
Чыгаруу жазуу: year-invoice сан, жаңы-сап.
Чыгаруу жазуу: year-invoice сан, жаңы-сап.
