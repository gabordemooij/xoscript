


>> CoffeeMachine := Объект жаңы.
CoffeeMachine келгенде: ['order:'] аткар: { :id
	>> coffee := ['Americano'].
	( id = 1 ) чын-болсо: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) чын-болсо: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) чын-болсо: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Объект жаңы.
SimpleCoffeeMachine келгенде: ['order'] аткар: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Чыгаруу жазуу: redCup, жаңы-сап.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Чыгаруу жазуу: greenCup, жаңы-сап.
>> yellowCup := CoffeeMachine order: 1.
Чыгаруу жазуу: yellowCup, жаңы-сап.
>> blueCup := CoffeeMachine order: 0.
Чыгаруу жазуу: blueCup, жаңы-сап.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Чыгаруу жазуу: blackCup, жаңы-сап.
blackCup аягына-кошуу: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Чыгаруу жазуу: orangeCup, жаңы-сап.
