# a quote that never closes must give an error, not an endless loop
>> жол := ['/tmp/test0821.csv'].
>> file := Файл жаңы: жол.

file жазуу: ['a,b\n"1,2\n'].
{
	file бөлгүч: [','] тырмакча: ['"'] саптар: { :line
		Чыгаруу жазуу: line, жаңы-сап.
	}.
} кармоо: { :e Чыгаруу жазуу: e, жаңы-сап. }, иштетүү.

# a closed quote still works
file жазуу: ['a,b\n"1,2",3'].
file бөлгүч: [','] тырмакча: ['"'] саптар: { :line
	Чыгаруу жазуу: line, жаңы-сап.
}.
file өчүрүү.
