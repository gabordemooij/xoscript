>> Slurp := Объект жаңы.

Slurp келгенде: ['жаңы'] аткар: {
	өзүнүн str := [''].
}.

Slurp келгенде: ['жооп:'] аткар: { :blah
		(өзүнүн str = ['']) чын-болсо: {
			өзүнүн str аягына-кошуу: blah.
		}, антпесе: {
			өзүнүн str аягына-кошуу: [' '].
			өзүнүн str аягына-кошуу: blah.
		}.
}.

Slurp келгенде: ['жооп:жана:'] аткар: { :blah :blahah
		(blah узундук > 1) чын-болсо: {
			өзүнүн str аягына-кошуу: (blah баштап: 0 узундук: (blah узундук - 1)).
		}, антпесе: {
			өзүнүн str аягына-кошуу: blah.
		}.
		өзүнүн str аягына-кошуу: [' '].
		өзүнүн str аягына-кошуу: blahah.
}.

Slurp келгенде: ['obtain'] аткар: {
	>> buffer := өзүнүн str.
	өзүнүн str := ['']. <- buffer.
}.


>> x := Slurp жаңы.
x + 3.
Чыгаруу жазуу: (x obtain), жаңы-сап.
x echo: ['Hello world'].
Чыгаруу жазуу: (x obtain), жаңы-сап.
x tellme: 123 and: 987.
Чыгаруу жазуу: (x obtain), жаңы-сап.
