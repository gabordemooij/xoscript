

Текст келгенде: ['evaluate'] аткар: {
	>> код := Файл жаңы: ['/tmp/eval.ctr'].
	код жазуу: (өзү текст + ['.']).
	Программа пайдалануу: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Тизме ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q текст.
Чыгаруу жазуу: x, жаңы-сап.
>> y := Бош.
(['y := '] + x ) evaluate.
Чыгаруу жазуу: y ? 0, жаңы-сап.

q := Сөздүк салуу: ['\[''] ачкыч: ['\['quote\']'].
x := q текст.
Чыгаруу жазуу: x, жаңы-сап.
y := Бош.
(['y := '] + x ) evaluate.

>> q := (Сөздүк жаңы) салуу:['\[''] ачкыч:['\['quote\[''].
Чыгаруу жазуу: y ? ['\['quote\']'], жаңы-сап.
