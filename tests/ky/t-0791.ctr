Server init.

>> DB := Maria-DB жаңы хост: ['localhost'],
	колдонуучу-аты: ['xo'],
	сырсөз: ['pass123'],
	маалымат-базасынын-аты: ['xobase'],
	туташуу.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> издөө-параметрлери := Maria-Суроо жаңы: SQL.

# set database
издөө-параметрлери маалымат-базасы: DB.

издөө-параметрлери алуу: { :row
	Чыгаруу жазуу: row world, жаңы-сап.
}.
