Server init.

>> DB := Maria-DB жаңы хост: ['localhost'],
	колдонуучу-аты: ['xo'],
	сырсөз: ['pass123'],
	маалымат-базасынын-аты: ['xobase'],
	туташуу.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB суроо-талап: SQL.

# now you don't have to set DB
query2 алуу: { :row
	Чыгаруу жазуу: row world, жаңы-сап.
}.
