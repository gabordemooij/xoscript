
>> dictionary := (
	Сөздүк жаңы
		салуу: ['b'] ачкыч: ['a'],
		салуу: ['a'] ачкыч: ['b'],
		салуу: ['z'] ачкыч: ['x'],
		салуу: ['hello'] ачкыч: ['hallo'],
		салуу: ['human'] ачкыч: ['human']
).

>> comparisons := Тизме жаңы.
dictionary ар-бир: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a салыштыруу: b)
	).
}.

comparisons иреттөө: { :a :b <- ( a салыштыруу: b ). }.
Чыгаруу жазуу: ( comparisons бириктирүү: ['↵'] ), жаңы-сап.
comparisons бириктирүү: ['↵'].
