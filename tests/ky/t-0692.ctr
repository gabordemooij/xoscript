Server init.

Чыгаруу жазуу: (
	Үлгү жаңы: ['^\\w+$'],
	дал-келүү: ['test@example.com'] 
), жаңы-сап. # 0 match, fails on @ and .

Чыгаруу жазуу: (
	Үлгү жаңы: ['^[^@]+@[^\.]+\.\\w+$'],
	дал-келүү: ['test@example.com'] 
), жаңы-сап. # 1 match

Чыгаруу жазуу: (
	Үлгү жаңы: ['[^@]+@[^\.]+\.\\w+'],
	дал-келүү: ['test@example.com'] 
), жаңы-сап. # 1 match

Чыгаруу жазуу: (
	Үлгү жаңы: ['([^@]+)@([^\.]+)\.\\w+'],
	дал-келүү: ['test@example.com'] 
), жаңы-сап. # 1 match, groups dont matter

Чыгаруу жазуу: (
	Үлгү жаңы: ['[a-z]'],
	дал-келүү: ['test@example.com'] 
), жаңы-сап. # 14 matches

Чыгаруу жазуу: (
	Үлгү жаңы: ['.*'],
	дал-келүү: ['test@example.com'] 
), жаңы-сап. # 1 match (all)

Чыгаруу жазуу: (
	Үлгү жаңы: ['(.*)'],
	дал-келүү: ['test@example.com'] 
), жаңы-сап. # 1 match (all)

Чыгаруу жазуу: (
	Үлгү жаңы: ['\\s*[^@]+@[^\.]+\.\\w+'],
	дал-келүү: ['test@example.com'] 
), жаңы-сап. # 1 match, prefix space optional, gets ignored