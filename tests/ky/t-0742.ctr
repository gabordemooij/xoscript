Чыгаруу жазуу: ['Test object'], жаңы-сап.
>> a := Объект жаңы. 

a келгенде: ['item:'] аткар: { :hexhelper
	өзүнүн hexhelper := hexhelper. 
}.

a келгенде: ['item'] аткар: { <- өзүнүн hexhelper.
}.

a item: Hx жаңы.

>> old-hexhelper-address := a item прототип эс-дареги.
a save-as: ['/tmp/a.bin'].
Чыгаруу жазуу: ['========== RELOADING SNAP:'], жаңы-сап.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип эс-дареги = old-hexhelper-address) чын-болсо: {
	Чыгаруу жазуу: ['Object link re-attached.'], жаңы-сап.
}.
