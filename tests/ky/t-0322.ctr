

>> Matryoshka := Объект жаңы.
Matryoshka келгенде: ['double:'] аткар: { :secret
	өзүнүн secret := secret × 2.
}.
Matryoshka келгенде: ['жаңы:'] аткар: { :secret
	>> answer := Бош.
	>> t := (secret > 255).
	Чыгаруу жазуу: (secret + [' | '] + t), жаңы-сап.
	t чын-болсо: {
		answer := secret.
	}, антпесе: {
		answer := Matryoshka рекурсивдүү жаңы: (өзү double: secret).
	}. <- answer.
}.

>> x := Matryoshka жаңы: 2.
