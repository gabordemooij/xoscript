Server init.

>> db := Maria-DB жаңы хост: ['localhost'],
	колдонуучу-аты: ['xo'],
	сырсөз: ['pass123'],
	маалымат-базасынын-аты: ['xobase'],
	туташуу.

>> del := db суроо-талап: ['DELETE FROM book WHERE id > 0'].
{  del аткаруу. db бекитүү. } кармоо: { :e db артка-кайтаруу.  }, иштетүү.

>> саны := db суроо-талап: ['SELECT COUNT(*) AS num FROM book'].
саны алуу: { :row Чыгаруу жазуу: row num, жаңы-сап. }.
