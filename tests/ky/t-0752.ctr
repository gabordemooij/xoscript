Чыгаруу жазуу: ['Test object'], жаңы-сап.
>> a := Объект жаңы. 

a келгенде: ['item:'] аткар: { :логикалык
	өзүнүн логикалык := логикалык. 
}.

a келгенде: ['item'] аткар: { <- өзүнүн логикалык.
}.

a item: Логикалык.

Чыгаруу жазуу: a item, жаңы-сап.

>> old-bool-address := a item прототип эс-дареги.
a save-as: ['/tmp/a.bin'].
Чыгаруу жазуу: ['========== RELOADING SNAP:'], жаңы-сап.

>> b := Объект load-from: ['/tmp/a.bin'].

(b item прототип эс-дареги = old-bool-address) чын-болсо: {
	Чыгаруу жазуу: ['Object link re-attached.'], жаңы-сап.
}.

Чыгаруу жазуу: b item, жаңы-сап.
