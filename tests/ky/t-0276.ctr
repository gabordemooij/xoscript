>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Объект жаңы.
⚄ келгенде: ['drawFrom:length:'] аткар: { :pool :саны
	
	>> result := [''].
	
	{
		>> index := Сан random % (pool узундук).
		result аягына-кошуу: ( pool белги: (index + 1) ).
		
	} × саны. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? узундук.
Чыгаруу жазуу: (['x↵'] x random узундук).
Чыгаруу жазуу: (['y↵'] y ?? узундук).

