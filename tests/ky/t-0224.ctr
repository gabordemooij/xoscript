
>> countries := Тизме жаңы
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Тизме жаңы
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods боюнча: countries, ар-бир: { :key :value
	counter кошуу: 1.
}.

Чыгаруу жазуу: (['we serve counter dishes'] counter: counter), жаңы-сап.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] белгилер иреттөө: { :v
	counter кошуу: 0.
}.

Чыгаруу жазуу: (['we sort counter dishes'] counter: counter), жаңы-сап.


>> counter := 0.
{
	{
		counter кошуу: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Чыгаруу жазуу: (['we calculate counter numbers.'] counter: counter), жаңы-сап.

