#Linux
>> clock := Учур жаңы.
clock убакыт-алкагы: ['UTC-1'].
clock жыл: 1981, ай: 1, күн: 5,
      саат: 13, мүнөт: 15, секунд: 13.

Чыгаруу жазуу: clock, жаңы-сап.
clock убакыт-алкагы: ['UTC+0'].

Чыгаруу жазуу: (
	(clock жыл жөнөкөй) + ['-'] + (clock ай) + ['-'] + (clock күн) + [' '] +
	(clock саат) + [':'] + (clock мүнөт) + [':'] + (clock секунд) + [' '] +
	['W'] + (clock жума) + (clock убакыт-алкагы)
), жаңы-сап.


clock убакыт-алкагы: ['UTC-1'].
Чыгаруу жазуу: (
	(clock жыл жөнөкөй) + ['-'] + (clock ай) + ['-'] + (clock күн) + [' '] +
	(clock саат) + [':'] + (clock мүнөт) + [':'] + (clock секунд) + [' '] +
	['W'] + (clock жума) + (clock убакыт-алкагы)
), жаңы-сап.
