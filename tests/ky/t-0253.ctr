#Linux
>> OS := Программа жөндөө: ['OS'].

>> clock := Учур жаңы.
	
(OS = ['Haiku']) чын-болсо: {
	clock убакыт-алкагы: ['CET'],
	жыл: 2017, ай: 7, күн: 13,
	саат: 18, мүнөт: 0, секунд: 0.
}, антпесе: {
	clock убакыт-алкагы: ['Europe/Amsterdam'],
	жыл: 2017, ай: 7, күн: 13,
	саат: 18, мүнөт: 0, секунд: 0.
}.

clock келгенде: ['tell'] аткар: {
	Чыгаруу жазуу: өзү, жаңы-сап.
}.


clock кошуу: 2    саат, tell.
clock кошуу: 1    саат, tell.
clock кошуу: 19 мүнөт, tell.
clock кошуу: 1  мүнөт, tell.
clock кошуу: 1  мүнөт, tell.
clock кошуу: 19 секунд, tell.
clock кошуу: 1  секунд, tell.
clock кошуу: 1  секунд, tell.
clock кошуу: 2    жыл, tell.
clock кошуу: 1    жыл, tell.

(OS = ['Haiku']) чын-болсо: {
clock кошуу: 5   ай.
clock убакыт-алкагы: ['CEST'], tell.
}, антпесе: {
	clock кошуу: 5   ай, tell.
}.

clock кошуу: 1   ай, tell.
clock кошуу: 19    күн, tell.
clock кошуу: 1    саат, tell.
clock кошуу: 120  yard, tell.
