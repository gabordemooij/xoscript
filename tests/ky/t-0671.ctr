# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Сейф ачкычтарды-түзүү.

# private (secret) key
>> sk := keys биринчи.

# public key
>> pk := keys акыркы.

# sign a message
>> sig := Сейф кол-коюу: ['abc'] ачкыч-менен: sk.

# check message (ok)
Чыгаруу жазуу: ( 
	Сейф
		текшерүү: ['abc'] 
		колтамга: sig 
		ачкыч-менен: pk 
), жаңы-сап.

# check message (fail)
Чыгаруу жазуу: ( 
	Сейф 
		текшерүү: ['abd'] 
		колтамга: sig 
		ачкыч-менен: pk 
), жаңы-сап.