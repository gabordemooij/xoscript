# test catch-all methods
>> x13 := Объект жаңы.
x13 келгенде: ['a'] аткар: { :a Чыгаруу жазуу: 0, жаңы-сап. }.
x13 келгенде: ['a:'] аткар: { :a Чыгаруу жазуу: a, жаңы-сап. <- 5. }.
x13 келгенде: ['a:b:'] аткар: { :a :b Чыгаруу жазуу: (a + b), жаңы-сап. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
