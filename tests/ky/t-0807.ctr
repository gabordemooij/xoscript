# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB жаңы хост: ['localhost'],
	колдонуучу-аты: ['xo'],
	сырсөз: ['pass123'],
	маалымат-базасынын-аты: ['xobase'],
	туташуу.

>> издөө-параметрлери := db суроо-талап: ['SELECT %% FROM'].
{ издөө-параметрлери аткаруу. } кармоо: { :e
	Чыгаруу жазуу: ( e камтыйт: ['%%'] ), жаңы-сап.
}, иштетүү.
