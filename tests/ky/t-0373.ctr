# compliance test

# use international numbers

Чыгаруу жазуу: ['1000 -> '].
Чыгаруу жазуу: 1000, жаңы-сап. #1000

Чыгаруу жазуу: ['1.5 -> '].
Чыгаруу жазуу: 1.5, жаңы-сап.  #1.5

Чыгаруу жазуу: ['1001.5 -> '].
Чыгаруу жазуу: 1.5 + 1000, жаңы-сап. #1001.5

# use 0-indexed arrays
>> x := Тизме жаңы ; 1 ; 2 ; 3.
>> y := Тизме жаңы ; ['a'] ; ['b'] ; ['c'].

Чыгаруу жазуу: ['1 -> '].
Чыгаруу жазуу: x ? 0, жаңы-сап. #1

Чыгаруу жазуу: ['1 -> '].
Чыгаруу жазуу: (x ордунда: 0), жаңы-сап. #1

Чыгаруу жазуу: ['1 -> '].
Чыгаруу жазуу: x биринчи, жаңы-сап. #1

Чыгаруу жазуу: ['3 -> '].
Чыгаруу жазуу: x акыркы, жаңы-сап. #3

Чыгаруу жазуу: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Чыгаруу жазуу: (x боюнча: y), жаңы-сап.

Чыгаруу жазуу: ['1 -> '].
Чыгаруу жазуу: (x баштап: 0 узундук: 1) биринчи, жаңы-сап. #1

Чыгаруу жазуу: ['0 -> '].
Чыгаруу жазуу: (x табуу: 1), жаңы-сап. #0

x салуу: 9 ачкыч: 0.

Чыгаруу жазуу: ['9 -> '].
Чыгаруу жазуу: (x ордунда: 0), жаңы-сап. #9

x башына-кошуу: 8.
Чыгаруу жазуу: ['8 -> '].
Чыгаруу жазуу: (x ордунда: 0), жаңы-сап. #9


x аягына-кошуу: 10.
Чыгаруу жазуу: ['10 -> '].
Чыгаруу жазуу: (x ордунда: 4), жаңы-сап. #10








