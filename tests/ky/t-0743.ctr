>> V := Объект.
V келгенде: ['текст'] аткар: {
	Чыгаруу жазуу: ['cast'], жаңы-сап. <- ['abc'].
}.

Чыгаруу жазуу: ( Программа жөндөө: ['abc'] ), жаңы-сап.

# params should not get gc'ed
Программа жөндөө: ([''] + V жаңы) маани: ([''] + V жаңы).

Чыгаруу жазуу: ( Программа жөндөө: ['abc'] ), жаңы-сап.
