Чыгаруу жазуу: ['Continue for-loop, No - before 6 and up.'], жаңы-сап.
{ :i
	Чыгаруу жазуу: (i + 1), жаңы-сап.
	((i + 1) > 4) улантуу.
	Чыгаруу жазуу: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Чыгаруу жаңы-сап.
Чыгаруу жазуу: ['Continue while-true, No --> before 5 and up.'], жаңы-сап.
{
	Чыгаруу жазуу: ['iteration #'] + x, жаңы-сап.
	x кошуу: 1.
	((x < 5) тескери) улантуу.
	Чыгаруу жазуу: ['-->'].
} азырынча: xIsLessThan10.
Чыгаруу жаңы-сап.
Чыгаруу жазуу: ['Continue while-false, No - before 3 only.'], жаңы-сап.
{
	Чыгаруу жазуу: ['iteration #'] + x, жаңы-сап.
	x кемитүү: 1.
	(x = 3) улантуу.
	Чыгаруу жазуу: ['-'].
} азырынча: { <- ( x > 0). }.

Чыгаруу жаңы-сап.
Чыгаруу жазуу: ['Continue times-loop, No ||| before 3.'], жаңы-сап.
{ :i
	Чыгаруу жазуу: ['iteration #'] + i, жаңы-сап.
	(i = 2) улантуу.
	Чыгаруу жазуу: ['|||'].
} × 5.

Чыгаруу жаңы-сап.

{ Чын улантуу. Чыгаруу жазуу: ['dont write this!'], жаңы-сап. } иштетүү.

{ Чын улантуу. Чыгаруу жазуу: ['dont write this!'], жаңы-сап. } кармоо: { Чыгаруу жазуу: ['Dont catch this!']. }, иштетүү.

Чыгаруу жазуу: ['Test Array each-loop: 0, ... ,2'], жаңы-сап.
(Тизме ← 1 ; 2 ; 3) өзгөртүү: { :i
	(i = 1) улантуу.
	Чыгаруу жазуу: ['iteration #'] + (i - 0), жаңы-сап.
}.

Чыгаруу жазуу: ['Test Map each-loop: c only'], жаңы-сап.
>> m := Сөздүк жаңы.
m салуу: ['first'] ачкыч: ['a'], салуу: ['second'] ачкыч: ['b'], салуу: ['third'] ачкыч: ['c'].
m ар-бир: { :k :v
	(k ≠ ['c']) улантуу.
	Чыгаруу жазуу: ['iteration'] + k + v, жаңы-сап.
}.

