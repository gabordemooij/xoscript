



>> CoffeeGrounds := Объект жаңы.
CoffeeGrounds келгенде: ['extract'] аткар: { <- ['coffee']. }.

>> CoffeeMachine := Объект жаңы.
CoffeeMachine келгенде: ['init'] аткар: {
	өзүнүн coffeegrounds := CoffeeGrounds жаңы.
}.
CoffeeMachine келгенде: ['жаңы'] аткар: { <- CoffeeMachine `new init.
}.

CoffeeMachine келгенде: ['makeTea'] аткар: { <- (өзүнүн tealeaves extract). }.
CoffeeMachine келгенде: ['makeCoffee'] аткар: { <- (өзүнүн coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine жаңы.

Чыгаруу жазуу:
	coffeeDream 
	makeCoffee.

Чыгаруу жазуу:
	coffeeDream 
	makeTea.
