>> Grandfather := Объект жаңы.
Grandfather келгенде: ['greet'] аткар: {
	Чыгаруу жазуу: ['Ave!'], жаңы-сап.
}.
>> Father := Grandfather жаңы.
Father келгенде: ['greet'] аткар: {
	Чыгаруу жазуу: ['Hello'], жаңы-сап.
	өзү greet.
}.
>> Son := Father жаңы.
Son келгенде: ['greet'] аткар: {
	Чыгаруу жазуу: ['Hi'], жаңы-сап.
	өзү greet.
}.

Son greet.

>> Roundabout := Объект жаңы.
Roundabout келгенде: ['circle:'] аткар: { :x
	Чыгаруу жазуу: x, жаңы-сап.
	(x < 3) чын-болсо: { өзү рекурсивдүү circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) чын-болсо: { Чыгаруу жазуу: x, жаңы-сап. x кошуу: 1.  increment иштетүү. }. }.
increment иштетүү.