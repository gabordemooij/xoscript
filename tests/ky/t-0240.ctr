# test qualifiers

>> $ := Объект жаңы.

$ келгенде: ['жооп:'] аткар: { :x
	
	>> operation := x белги: 0.
	>> valuta := x белги: 1.
	>> money := x жылдыруу: 2.
	
	>> amount := 0.

	( operation = ['+'] ) чын-болсо: {
		( valuta = ['£'] ) чын-болсо: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Чыгаруу жазуу: x, жаңы-сап.


>> Fruit := Объект жаңы.

Fruit келгенде: ['жаңы'] аткар: {
	>> f := өзү жаңы.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit келгенде: ['apples:'] аткар: { :a өзүнүн apples := a. }.
Fruit келгенде: ['oranges:'] аткар: { :p өзүнүн oranges := p. }.
Fruit келгенде: ['apples'] аткар: { <- өзүнүн apples. }.
Fruit келгенде: ['oranges'] аткар: { <- өзүнүн oranges. }.

Fruit келгенде: ['+'] аткар: { :f
	
	>> n := Fruit жаңы.
	f кошуу: 1.
	
	n apples: (f apples + өзүнүн apples).
	n oranges:  (f oranges  + өзүнүн oranges). <- n.
}.

Fruit келгенде: ['текст'] аткар: { <- ( өзүнүн apples текст + [' apples and '] + өзүнүн oranges + [' oranges'] ).
}.

Сан келгенде: ['apples'] аткар: { <- ((Fruit жаңы) apples: өзү).
}.

Сан келгенде: ['apple'] аткар: { <- ((Fruit жаңы) apples: өзү).
}.

Сан келгенде: ['oranges'] аткар: { <- ((Fruit жаңы) oranges: өзү).
}.




Чыгаруу жазуу: (1 apple + 3 oranges + 4 apples), жаңы-сап.


Текст келгенде: ['twice'] аткар: { <- ((өзү текст) + (өзү текст)).
}.



Чыгаруу жазуу: ['❤❤❤'] twice.



