
>> Rectangle := Объект жаңы.

Rectangle келгенде: ['area'] аткар: { <- өзүнүн узундук * өзүнүн width.
}.

Rectangle келгенде: ['length:'] аткар: { :узундук
	өзүнүн узундук := узундук.
}.

Rectangle келгенде: ['width:'] аткар: { :width
	өзүнүн width := width.
}.

Rectangle келгенде: ['жаңы'] аткар: {
	# this will not result into an infinite loop
	>> rectangle := өзү жаңы.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle жаңы.
Чыгаруу жазуу: a area, жаңы-сап. #0

>> b := Rectangle жаңы length: 2, width: 3.
Чыгаруу жазуу: b area, жаңы-сап. #6

