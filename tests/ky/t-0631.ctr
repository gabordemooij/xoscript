#ffi test


Server init.

Программа эсти-башкаруу: 4.

# for this test you need set a path to libc (puts)
>> libname := Программа жөндөө: ['FFITESTLIB'].



Server байланыштыруу: (
 Тизме жаңы ;
 libname ;
 ['puts'] ;
 ( Тизме жаңы ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s бошотуу.

# test with struct

>> a := Blob жаңы: 8.
a bytes: (
	Тизме <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Тизме <<: ['int'], ; ['int']).

Server байланыштыруу: (
	Тизме <<: ['@structtest'], ;
	['@structtest'] ;
	(Тизме <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Чыгаруу жазуу: ['Sum test:'] + (ffitest ffisum: a), жаңы-сап.

struct struct-бошотуу.
struct бошотуу.
a бошотуу.
