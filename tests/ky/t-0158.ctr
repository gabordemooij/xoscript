>> x := [' hallo '].

>> y := x баш-тамгалар.
Чыгаруу жазуу: x, жаңы-сап.
Чыгаруу жазуу: (x дал-ошол: y), жаңы-сап.

>> y := x кичине-тамгалар.
Чыгаруу жазуу: x, жаңы-сап.
Чыгаруу жазуу: (x дал-ошол: y), жаңы-сап.

>> y := x кыркуу.
Чыгаруу жазуу: x, жаңы-сап.
Чыгаруу жазуу: (x дал-ошол: y), жаңы-сап.

>> y := x жылдыруу: 1.
Чыгаруу жазуу: x, жаңы-сап.
Чыгаруу жазуу: (x дал-ошол: y), жаңы-сап.

>> y := x баштап: 1 узундук: 2.
Чыгаруу жазуу: x, жаңы-сап.
Чыгаруу жазуу: (x дал-ошол: y), жаңы-сап.