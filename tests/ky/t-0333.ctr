Server init.
{ >> x := JSON объект: ['{}']. 	Чыгаруу жазуу: x, жаңы-сап. } кармоо: { :e	Чыгаруу жазуу: e, жаңы-сап. }, иштетүү.
{ >> x := JSON объект: ['""']. 	Чыгаруу жазуу: x, жаңы-сап. } кармоо: { :e	Чыгаруу жазуу: e, жаңы-сап. }, иштетүү.
