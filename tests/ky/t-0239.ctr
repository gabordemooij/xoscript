Тизме келгенде: ['sum'] аткар: {
	>> total := 0.
	өзү ар-бир: { :index :element
		total кошуу: element.
	}. <- total.
}.

>> a := Чын.



a келгенде: ['текст'] аткар: {
	>> answer := Бош.
	( өзү = Чын ) чын-болсо: {
		answer := ['Yep'].
	}, антпесе: {
		answer := ['Nope'].
	}. <- answer.
}.

a келгенде: ['сан'] аткар: {
	>> answer := Бош.
	( өзү = Чын ) чын-болсо: {
		answer := 10.
	}, антпесе: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b келгенде: ['текст'] аткар: { <- ['Devil'].
}.

b келгенде: ['логикалык'] аткар: { <- Жалган.
}.


Чыгаруу жазуу: a, жаңы-сап.  
Чыгаруу жазуу: (90 + a), жаңы-сап. 
Чыгаруу жазуу: b, жаңы-сап. 
Чыгаруу жазуу: (Чын жана: b), жаңы-сап.

a := Тизме ← ['hello'] ; ['world'] ; Чын ; Бош ; 666. 
a := a + ( Тизме ← 1 ).
Чыгаруу жазуу: a, жаңы-сап.
Чыгаруу жазуу: ((Сөздүк жаңы) салуу: Бош ачкыч: Бош), жаңы-сап.
Чыгаруу жазуу: a sum, жаңы-сап. 


{
	a келгенде: ['текст'] аткар: { <- Бош. }.
	a := [''] + a.
} кармоо: { :error
	Чыгаруу жазуу: ['Error noted: '] + error, жаңы-сап.
}, иштетүү.



{
	a келгенде: ['сан'] аткар: { <- Бош. }.
	a := 3 × a.
} кармоо: { :error
	Чыгаруу жазуу: ['Error noted: '] + error, жаңы-сап.
}, иштетүү.


{
	a келгенде: ['логикалык'] аткар: { <- Бош. }.
	a := Чын жана: a. 
} кармоо: { :error
	Чыгаруу жазуу: ['Error noted: '] + error, жаңы-сап.
}, иштетүү.





