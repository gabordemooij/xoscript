Out write: ['Test object'], stop.
>> cmd := Command new.
Out write: cmd ls /tmp, stop.
>> old-cmd-address := cmd prototype memory-address.
cmd save-as: ['/tmp/a.bin'].
Out write: ['========== RELOADING SNAP:'], stop.
>> b := Object load-from: ['/tmp/a.bin'].
(b prototype memory-address = old-cmd-address) true: {
	Out write: ['Object link re-attached.'], stop.
}.
Out write: b ls, stop.


