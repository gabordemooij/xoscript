# test url parsing

Server init.
>> url := URL de: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Saída escrever: ['scheme = '] + url esquema, stop.
Saída escrever: ['host = '] + url host, stop.
Saída escrever: ['port = '] + url porta, stop.
Saída escrever: ['path = '] + url caminho, stop.
Saída escrever: ['query = '] + url parametros, stop.
Saída escrever: ['fragment = '] + url fragmento, stop.
