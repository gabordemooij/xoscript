
String em: ['evaluate'] fazer: {
	>> code := Arquivo novo: ['/tmp/eval.ctr'].
	code escrever: (isto string + ['.']).
	Programa usar: ['/tmp/eval.ctr'].
}.

>> map :=
	(Mapa novo)
	colocar: ['Hi There'] em: ['two'],
	colocar: (Listar ← ['hello'] ; ['world'] ; (Listar ← 1 ; 2; 9) ; Não) em: ['one'],
	colocar: ( (Mapa novo) colocar: ['wrrld'] em: ['misspelled'] ) em: ['three'],
	colocar: (Listar ← ((Mapa novo) colocar: ['treasure'] em: ['hidden']) ; 2) em: ['four']. 
>> str := map string.
>> map2 := Nulo.
(['map2 := '] + str ) evaluate.
Saída escrever: map2 ? ['one'] ? 0.
Saída escrever: map2 ? ['one'] ? 1.
Saída escrever: map2 ? ['four'] ? 0 ? ['hidden'].
Saída escrever: map2 ? ['one'] ? 2 ? 2.
