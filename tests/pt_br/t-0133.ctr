


>> Deck := Listar novo.
Deck em: ['print'] fazer: {
        >> len := isto conta - 1.
        { :i
                >> len2 := isto conta - 1.
                Saída escrever: ['len: '].
                Saída escrever: len, stop.
                Saída escrever: ['len2: '].
                Saída escrever: len2, stop.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
