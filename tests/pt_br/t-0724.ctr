Saída escrever: ['Test object'], stop.
>> a := Objeto novo. 

a em: ['item:'] fazer: { :file
	prop file := file. 
}.

a em: ['item'] fazer: { <- prop file.
}.

>> f := Arquivo novo: ['/tmp/aaa.txt'].
a item: f.
Saída escrever: a item, stop.
a save-as: ['/tmp/a.bin'].
Saída escrever: ['========== RELOADING SNAP:'], stop.
>> b := Objeto load-from: ['/tmp/a.bin'].
Saída escrever: b item, stop.
