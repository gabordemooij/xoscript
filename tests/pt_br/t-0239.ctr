Listar em: ['sum'] fazer: {
	>> total := 0.
	isto cada-um: { :index :element
		total adicionar: element.
	}. <- total.
}.

>> a := Sim.



a em: ['string'] fazer: {
	>> answer := Nulo.
	( isto = Sim ) sim: {
		answer := ['Yep'].
	}, senão: {
		answer := ['Nope'].
	}. <- answer.
}.

a em: ['número'] fazer: {
	>> answer := Nulo.
	( isto = Sim ) sim: {
		answer := 10.
	}, senão: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b em: ['string'] fazer: { <- ['Devil'].
}.

b em: ['boleano'] fazer: { <- Não.
}.


Saída escrever: a, stop.  
Saída escrever: (90 + a), stop. 
Saída escrever: b, stop. 
Saída escrever: (Sim e: b), stop.

a := Listar ← ['hello'] ; ['world'] ; Sim ; Nulo ; 666. 
a := a + ( Listar ← 1 ).
Saída escrever: a, stop.
Saída escrever: ((Mapa novo) colocar: Nulo em: Nulo), stop.
Saída escrever: a sum, stop. 


{
	a em: ['string'] fazer: { <- Nulo. }.
	a := [''] + a.
} pegar: { :error
	Saída escrever: ['Error noted: '] + error, stop.
}, iniciar.



{
	a em: ['número'] fazer: { <- Nulo. }.
	a := 3 × a.
} pegar: { :error
	Saída escrever: ['Error noted: '] + error, stop.
}, iniciar.


{
	a em: ['boleano'] fazer: { <- Nulo. }.
	a := Sim e: a. 
} pegar: { :error
	Saída escrever: ['Error noted: '] + error, stop.
}, iniciar.





