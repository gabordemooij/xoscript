{
	este-bloco-de-código erro: ['Dont fail.'].
	unknown doSomething.
} pegar: {
	Saída escrever: ['Caught!'].
}, iniciar.

{
	este-bloco-de-código erro: ['Dont fail.'].
	prop unknown doSomething.
} pegar: {
	Saída escrever: ['Caught!'].
}, iniciar.

{
	este-bloco-de-código erro: ['Dont fail.'].
	unknown := 122.
} pegar: {
	Saída escrever: ['Caught!'].
}, iniciar.


{
	este-bloco-de-código erro: ['Dont fail.'].
	Sim parar.
	Saída escrever: ['FAIL'].
} pegar: {
	Saída escrever: ['Caught!'].
}, iniciar.

{
	{
		este-bloco-de-código erro: ['Dont fail.'].
		Sim parar.
		Saída escrever: ['FAIL'].
	} pegar: { :x
		(x = ['Dont fail.']) sim: { este-bloco-de-código erro: ['Nested Caught!']. }.
	}, iniciar.
} pegar: { :e
	Saída escrever: e.
}, iniciar.
