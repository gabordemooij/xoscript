Número em: ['factorial'] fazer: {
	>> total := 1.
	{ :index total multiplicar-por: (isto - (index)). } × isto. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Saída escrever: a.
>> b := 2 + 3 factorial.
Saída escrever: b.
>> c := 3 factorial + 2.
Saída escrever: c.
>> d := 2 + (3 factorial).
Saída escrever: d.
Saída escrever: 2 + 3 factorial + 1.
