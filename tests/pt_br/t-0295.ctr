
>> dictionary := (
	Mapa novo
		colocar: ['b'] em: ['a'],
		colocar: ['a'] em: ['b'],
		colocar: ['z'] em: ['x'],
		colocar: ['hello'] em: ['hallo'],
		colocar: ['human'] em: ['human']
).

>> comparisons := Listar novo.
dictionary cada-um: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a comparar: b)
	).
}.

comparisons oedenar: { :a :b <- ( a comparar: b ). }.
Saída escrever: ( comparisons juntar: ['↵'] ), stop.
comparisons juntar: ['↵'].
