# database error messages must not be treated as format strings
Server init.

>> db := MariaDB novo host: ['localhost'],
	usuário: ['xo'],
	senha: ['pass123'],
	nome-database: ['xobase'],
	conectar.

>> parametros := db consulta: ['SELECT %% FROM'].
{ parametros executar. } pegar: { :e
	Saída escrever: ( e contem: ['%%'] ), stop.
}, iniciar.
