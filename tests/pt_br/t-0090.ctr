Scope em: ['teste'] fazer: {
	Saída escrever: prop property.
	isto confirm.
	( 1 = 1 ) sim: { Saída escrever: prop property. isto confirm. }.
	( 1 = 0 ) não: { Saída escrever: prop property. isto confirm. }.
	>> y := 2. { Saída escrever: prop property. isto confirm. } enquanto: { y subtrair: 1. <- (y > 0). }.
