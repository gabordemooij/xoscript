Saída escrever: ['Test object'], stop.
>> cmd := Comando novo.
Saída escrever: cmd ls /tmp, stop.
>> old-cmd-address := cmd protótipo endereço-de-memória.
cmd save-as: ['/tmp/a.bin'].
Saída escrever: ['========== RELOADING SNAP:'], stop.
>> b := Objeto load-from: ['/tmp/a.bin'].
(b protótipo endereço-de-memória = old-cmd-address) sim: {
	Saída escrever: ['Object link re-attached.'], stop.
}.
Saída escrever: b ls, stop.


