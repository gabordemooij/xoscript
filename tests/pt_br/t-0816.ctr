# a format must fit the type of the value, the type can come from a client
>> tentar := { :format :value
	{ Saída escrever: ( (Formato novo: format) aplicar: value ), stop. } pegar: { :e Saída escrever: e, stop. }, iniciar.
}.
>> try-int := { :format :value
	{ Saída escrever: ( (Formato novo: format) aplicar-int: value ), stop. } pegar: { :e Saída escrever: e, stop. }, iniciar.
}.

# fits
tentar aplicar: ['|%s|'] e: ['text'].
tentar aplicar: ['%06.2f'] e: 5.5.
tentar aplicar: ['100%% %s'] e: ['sure'].
try-int aplicar: ['%03d'] e: 7.
try-int aplicar: ['%x'] e: 255.
tentar aplicar: ['%d'] e: (Int64 novo de-string: ['12']).
tentar aplicar: ['%lld'] e: (Int64 novo de-string: ['12']).
tentar aplicar: ['%.1lf'] e: 5.5.
try-int aplicar: ['%hd'] e: 7.

# does not fit
tentar aplicar: ['%s'] e: 12345.
tentar aplicar: ['%d'] e: 12345.
tentar aplicar: ['%f'] e: ['text'].
try-int aplicar: ['%d'] e: ['text'].
try-int aplicar: ['%s'] e: 5.
tentar aplicar: ['%s %s'] e: ['text'].
tentar aplicar: ['%n'] e: ['text'].
tentar aplicar: ['%*s'] e: ['text'].
tentar aplicar: ['%'] e: ['text'].

# length modifier does not fit
tentar aplicar: ['%ls'] e: ['text'].
tentar aplicar: ['%Lf'] e: 5.5.
try-int aplicar: ['%ld'] e: 7.
try-int aplicar: ['%lld'] e: 7.
tentar aplicar: ['%Ld'] e: (Int64 novo de-string: ['12']).

# a width that does not fit printf must give an error, not a crash
tentar aplicar: ['%99999999999s'] e: ['text'].
