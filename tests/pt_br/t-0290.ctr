# test list operations


>> cakes := Listar ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes substituir: 1 comprimento: 2 com: ( Listar ← ['cinnamon'] ; ['pineapple'] ).
Saída escrever: (buy juntar: [',']), stop.


>> buy := cakes substituir: 1 comprimento: 12 com: ( Listar ← ['cinnamon'] ; ['pineapple'] ).
Saída escrever: (buy juntar: [',']), stop.


>> buy := cakes substituir: 2 comprimento: 10 com: ( Listar novo ).
Saída escrever: (buy juntar: [',']), stop.


>> buy := cakes substituir: 0 comprimento: 1 com: ( Listar novo ).
Saída escrever: (buy juntar: [',']), stop.


>> buy := cakes substituir: ['0'] comprimento: ['1'] com: ['x'].
Saída escrever: (buy juntar: [',']), stop.
