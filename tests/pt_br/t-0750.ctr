Saída escrever: ['Test object'], stop.
>> a := Objeto novo. 

a em: ['item:'] fazer: { :nil
	prop nil := nil. 
}.

a em: ['item'] fazer: { <- prop nil.
}.

a item: Nulo.

Saída escrever: a item, stop.

>> old-nil-address := a item protótipo endereço-de-memória.
a save-as: ['/tmp/a.bin'].
Saída escrever: ['========== RELOADING SNAP:'], stop.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b item protótipo endereço-de-memória = old-nil-address) sim: {
	Saída escrever: ['Object link re-attached.'], stop.
}.

Saída escrever: b item, stop.
