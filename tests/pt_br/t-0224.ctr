
>> countries := Listar novo
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Listar novo
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods por: countries, cada-um: { :key :value
	counter adicionar: 1.
}.

Saída escrever: (['we serve counter dishes'] counter: counter), stop.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] caracteres oedenar: { :v
	counter adicionar: 0.
}.

Saída escrever: (['we sort counter dishes'] counter: counter), stop.


>> counter := 0.
{
	{
		counter adicionar: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Saída escrever: (['we calculate counter numbers.'] counter: counter), stop.

