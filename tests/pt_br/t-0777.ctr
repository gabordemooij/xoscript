#OBSD
>> dirname := [''].
{ dirname acrescentar: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Programa comando-do-sistema: command.
Programa chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename acrescentar: ['YYYYYYYY']. } * 20.
Arquivo novo: filename, escrever: ['sometext'].
{ Arquivo lista: ['/tmp/'] + dirname. } * 1000.
Saída escrever: ['no crash'], stop.

