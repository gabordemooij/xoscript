

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa arranjo: 0.

Número em: ['addNum:'] fazer: { :x
	isto adicionar: x.
}.

Número em: ['subtractNum:'] fazer: { :x
	isto subtrair: x.
}.

Número em: ['multiplyBy:'] fazer: { :x
	isto multiplicar-por: x.
}.

Número em: ['divideBy:'] fazer: { :x
	isto dividir-por: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 ao-poder: 8).  
a := a + (2 ao-poder: -1). 
a := a + (49 sqrt).   
a addNum: ((Listar ← 0 ; 1) max).          
a addNum: ((Listar ← 2 ; 3) min).
Saída escrever: a.

Programa limpa-a-memória.

usedMemory1 := (Programa memoria ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 ao-poder: 8).  
a := a + (2 ao-poder: -1). 
a := a + (49 sqrt).   
a addNum: ((Listar ← 0 ; 1) max).          
a addNum: ((Listar ← 2 ; 3) min).
Saída escrever: a.

Programa limpa-a-memória.
usedMemory2 := (Programa memoria ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 ao-poder: 8).  
a := a + (2 ao-poder: -1). 
a := a + (49 sqrt).   
a addNum: ((Listar ← 0 ; 1) max).          
a addNum: ((Listar ← 2 ; 3) min).
Saída escrever: a.

Programa limpa-a-memória.
usedMemory3 := (Programa memoria ? 0).



( usedMemory1 = usedMemory2 e: usedMemory1 = usedMemory3, e: usedMemory2 = usedMemory3 ) sim: {
	Saída escrever: ['No memory leaks here'].
}, não: {
	Saída escrever: ['Leaking memory...'].
}.
