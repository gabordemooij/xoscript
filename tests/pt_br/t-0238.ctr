String em: ['evaluate'] fazer: {
	>> code := Arquivo novo: ['/tmp/eval.ctr'].
	code escrever: (isto string + ['.']).
	Programa usar: ['/tmp/eval.ctr'].
}.

>> a := Listar ← 1 ; 2 ; 3.
>> b := (a string).

Saída escrever: b, stop. 
(['b := '] + b) evaluate.

Saída escrever: b ? 2, stop. 

Saída escrever: (( Listar ← 1 ; 2 ; 3 )), stop. 

Saída escrever: ((Mapa novo) colocar: 1 em: 2), stop. 

>> x := ( (Listar ← 1 ; ( Listar ← 9 ) ; Sim ) ) string.
Saída escrever: x, stop. 
(['x := '] + x) evaluate.

Saída escrever: x ? 1 ? 0, stop. 

>> y := (Mapa novo) colocar: (Listar ← 1) em: (Listar ← 2).
Saída escrever: y, stop. 

(['y := '] + y) string evaluate.

Saída escrever: (y em: (Listar ← 2) string ), stop.

Saída escrever: (Listar novo), stop. 
Saída escrever: (Mapa novo), stop. 
