

Listar em: ['sum'] fazer: {
	>> total := 0.
	isto cada-um: { :index :element
		total adicionar: element.
	}. <- total.
}.

Listar em: ['product'] fazer: {
	>> total := 1.
	isto cada-um: { :index :element
		total multiplicar-por: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa arranjo: 0.

{

>> a := Listar ← ['hello'] ; ['world'] ; Sim ; Nulo ; 666.
a := a + ( Listar ← 1 ).
Saída escrever: ( ['sum: '] + ( a sum ) ), stop.
Saída escrever: ( ['min: '] + ( a min ) ), stop.
Saída escrever: ( ['max: '] + ( a max ) ), stop.
Saída escrever: ( ['3rd: '] + ( a ? 2 ) ), stop.
Saída escrever: ( ['prd: '] + ( a product ) ), stop.
a oedenar: { :a :b <- (b - a). }.
a cada-um: { :i :e Saída escrever: ( i - 0 ), stop. }.

} iniciar.

Programa limpa-a-memória.
usedMemory1 := (Programa memoria ? 0).


{

>> a := Listar ← ['hello'] ; ['world'] ; Sim ; Nulo ; 666.
a := a + ( Listar ← 1 ).
Saída escrever: ( ['sum: '] + ( a sum ) ), stop.
