Programa limpa-a-memória.
usedMemory2 := (Programa memoria ? 0).


{

>> a := Listar ← ['hello'] ; ['world'] ; Sim ; Nulo ; 666.
a := a + ( Listar ← 1 ).
Saída escrever: ( ['sum: '] + ( a sum ) ), stop.
Saída escrever: ( ['min: '] + ( a min ) ), stop.
Saída escrever: ( ['max: '] + ( a max ) ), stop.
Saída escrever: ( ['3rd: '] + ( a ? 2 ) ), stop.
Saída escrever: ( ['prd: '] + ( a product ) ), stop.
