
>> a := Listar ← (Listar ← 100 ; 200 ; 300) ; (Listar ← 9 ; 8 ; 7).
Saída escrever: ['at 0,1 :'].
Saída escrever: a ? 0 ? 1, stop. 
Saída escrever: ['at 1,2 :'].
Saída escrever: a ? 1 ? 2, stop. 
>> menu := Mapa novo.
menu colocar: (Listar ← ['pizza'] ; ['spaghetti']) em: ['Italian Cuisine'].
menu colocar: (Listar ← ['bifteki'] ; ['suflaki']) em: ['Greek Cuisine'].
Saída escrever: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), stop. 
Saída escrever: ['but not on the same plate.'], stop.
