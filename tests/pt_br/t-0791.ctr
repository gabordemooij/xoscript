Server init.

>> DB := MariaDB novo host: ['localhost'],
	usuário: ['xo'],
	senha: ['pass123'],
	nome-database: ['xobase'],
	conectar.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> parametros := Maria-Consulta novo: SQL.

# set database
parametros database: DB.

parametros buscar: { :row
	Saída escrever: row world, stop.
}.
