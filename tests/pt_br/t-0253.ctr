#Linux
>> OS := Programa configurar: ['OS'].

>> clock := Momento novo.
	
(OS = ['Haiku']) sim: {
	clock zona: ['CET'],
	ano: 2017, mês: 7, dia: 13,
	hora: 18, minuto: 0, segundo: 0.
}, senão: {
	clock zona: ['Europe/Amsterdam'],
	ano: 2017, mês: 7, dia: 13,
	hora: 18, minuto: 0, segundo: 0.
}.

clock em: ['tell'] fazer: {
	Saída escrever: isto, stop.
}.


clock adicionar: 2    hora, tell.
clock adicionar: 1    hora, tell.
clock adicionar: 19 minuto, tell.
clock adicionar: 1  minuto, tell.
clock adicionar: 1  minuto, tell.
clock adicionar: 19 segundo, tell.
clock adicionar: 1  segundo, tell.
clock adicionar: 1  segundo, tell.
clock adicionar: 2    ano, tell.
clock adicionar: 1    ano, tell.

(OS = ['Haiku']) sim: {
clock adicionar: 5   mês.
clock zona: ['CEST'], tell.
}, senão: {
	clock adicionar: 5   mês, tell.
}.

clock adicionar: 1   mês, tell.
clock adicionar: 19    dia, tell.
clock adicionar: 1    hora, tell.
clock adicionar: 120  yard, tell.
