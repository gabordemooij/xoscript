
Listar em: ['product'] fazer: {
	>> total := 1.
	isto cada-um: { :index :element
		total multiplicar-por: element.
	}. <- total.
}.

>> a := Listar ← 1 ; 2 ; 3.
Saída escrever: a product, stop.
Saída escrever: (Listar ← 2 ; 4 ; 8) product, stop. 
Saída escrever: (Listar ← -2 ; 10) product, stop. 
Saída escrever: (Listar ← 0.5 ; -2) product, stop. 
