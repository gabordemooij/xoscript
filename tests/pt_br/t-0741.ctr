Saída escrever: ['Test object'], stop.
>> a := Objeto novo. 

a em: ['item:'] fazer: { :octhelper
	prop octhelper := octhelper. 
}.

a em: ['item'] fazer: { <- prop octhelper.
}.

a item: Oct novo.

>> old-octhelper-address := a item protótipo endereço-de-memória.
a save-as: ['/tmp/a.bin'].
Saída escrever: ['========== RELOADING SNAP:'], stop.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b item protótipo endereço-de-memória = old-octhelper-address) sim: {
	Saída escrever: ['Object link re-attached.'], stop.
}.
