>> Combination := Listar novo.

Combination em: ['acrescentar:'] fazer: { :el
	isto 
	encontre: el, Nulo? sim: { isto acrescentar: el. }.
}.

>> colours := Combination novo.
colours
	acrescentar: ['red'],
	acrescentar: ['green'],
	acrescentar: ['blue'],
	acrescentar: ['red'].

Saída escrever: colours, stop.
