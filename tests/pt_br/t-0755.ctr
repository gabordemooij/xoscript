Saída escrever: ['Test object'], stop.
>> greeter := Objeto novo.
greeter em: ['name:'] fazer: { :nome
	prop xname := nome. 
}.
greeter em: ['greet'] fazer: {
	Saída escrever: ['Hello '] + prop xname, stop.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Saída escrever: ['========== RELOADING SNAP:'], stop.
>> b := Objeto load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
