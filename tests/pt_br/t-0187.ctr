Número em: ['factorial'] fazer: {
	>> total := 1.
	{ :index total multiplicar-por: (isto - index). } × isto. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa arranjo: 0.

{
2 exponent factorial.
Saída escrever: (11 módulo: 3), stop.
Saída escrever: (3.4 arredondado), stop.
Saída escrever: (7.1 cima), stop.
Saída escrever: (7.9 baixo), stop.
}
iniciar.

Programa limpa-a-memória.

usedMemory1 := (Programa memoria ? 0).

{
2 exponent factorial.
Saída escrever: (11 módulo: 3), stop.
Saída escrever: (3.4 arredondado), stop.
Saída escrever: (7.1 cima), stop.
Saída escrever: (7.9 baixo), stop.
}
iniciar.

Programa limpa-a-memória.
usedMemory2 := (Programa memoria ? 0).


{
2 exponent factorial.
