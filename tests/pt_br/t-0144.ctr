



>> CoffeeGrounds := Objeto novo.
CoffeeGrounds em: ['extract'] fazer: { <- ['coffee']. }.

>> CoffeeMachine := Objeto novo.
CoffeeMachine em: ['init'] fazer: {
	prop coffeegrounds := CoffeeGrounds novo.
}.
CoffeeMachine em: ['novo'] fazer: { <- CoffeeMachine `new init.
}.

CoffeeMachine em: ['makeTea'] fazer: { <- (prop tealeaves extract). }.
CoffeeMachine em: ['makeCoffee'] fazer: { <- (prop coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine novo.

Saída escrever:
	coffeeDream 
	makeCoffee.

Saída escrever:
	coffeeDream 
	makeTea.
