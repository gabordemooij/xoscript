
Saída escrever: ['Break for-loop, 0-4.'], stop.
{ :i
	Saída escrever: ['iteration #'] + i, stop.
	(i = 4) parar.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Saída escrever: ['Break while-true loop, 0-4.'], stop.
{
	Saída escrever: ['iteration #'] + x, stop.
	x adicionar: 1.
	((x < 5) não) parar.
} enquanto: xIsLessThan10.

Saída escrever: ['Break while-false loop, 5,4.'], stop.
{
	Saída escrever: ['iteration #'] + x, stop.
	x subtrair: 1.
	(x = 3) parar.
} enquanto: { <- (x > 0). }.

Saída escrever: ['Break times loop, 1-4.'], stop.
{ :i
	Saída escrever: ['iteration #'] + i, stop.
	(i = 4) parar.
} × 5.

Saída escrever: ['Break block, dont print line.'], stop.
{ Sim parar. Saída escrever: ['dont write this!'], stop. } iniciar.

Saída escrever: ['Break block, dont fire catch...'], stop.
{ Sim parar. Saída escrever: ['dont write this!'], stop. } pegar: { Saída escrever: ['Dont catch this!']. }, iniciar.

Saída escrever: ['Test Array each-loop: 0,1'], stop.
(Listar ← 1 ; 2 ; 3) mapa: { :i
	Saída escrever: ['iteration #'] + i, stop.
	(i = 1) parar.
}.

Saída escrever: ['Test Map each-loop: c only'], stop.
>> m := Mapa novo.
m colocar: ['first'] em: ['a'], colocar: ['second'] em: ['b'], colocar: ['third'] em: ['c'].
m cada-um: { :k :v
	Saída escrever: ['iteration'] + v + k, stop.
	Sim parar.
}.

