# test buffers PKI/Sign 
Server init.

>> long := ( Listar novo preencha: 1000 elementos-com: ['a'] ) juntar: [''].

# sign a message
Saída escrever: ( 
	Cofre assinar: ['abc'] com: long
), stop.

Saída escrever: ( 
	Cofre
		verificar: ['abc'] 
		assinatura: long 
		com: long
), stop.

Saída escrever: (
	Cofre hash-senha: long verificar: long
), stop.
