Saída escrever: ['Test object'], stop.
>> l := Listar novo ; 1 ; ( Listar novo ; (Momento novo: 1) ; (Int64 de-string: ['321']) ; (Listar novo ; 3)).
Saída escrever: l, stop.
>> old-lst-address := l protótipo endereço-de-memória.
l save-as: ['/tmp/a.bin'].
Saída escrever: ['========== RELOADING SNAP:'], stop.
>> b := Objeto load-from: ['/tmp/a.bin'].
(b protótipo endereço-de-memória = old-lst-address) sim: {
	Saída escrever: ['Object link re-attached.'], stop.
}.
Saída escrever: b, stop.
