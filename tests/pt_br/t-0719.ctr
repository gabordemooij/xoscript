Server init.
>> fmt := Formato novo: ['%#3x'].

>> blob := Blob novo: 4.
blob bytes: ( 
	Listar novo ; 0 ; 1 ; 2 ; 3
).

>> file := Arquivo novo: ['/tmp/blob'].
file blob: blob.
blob livre.

>> ler := file blob.
ler 
de: 0 
comprimento: 4, 
fazer cada-um: { :i :b 
	Saída
	escrever: (fmt aplicar-int: b),
	stop.
}.
ler livre.
