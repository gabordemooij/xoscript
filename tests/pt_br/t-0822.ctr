# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := MariaDB novo host: ['localhost'],
	usuário: ['xo'],
	senha: ['pass123'],
	nome-database: ['xobase'],
	conectar.

>> parametros := db consulta: ['SELECT ? AS a, ? AS b, ? AS c'].
parametros parametros: (Listar novo ; ['1']).
{ parametros buscar: { :row Saída escrever: row, stop. }. } pegar: { :e Saída escrever: e, stop. }, iniciar.

>> parametros := db consulta: ['SELECT ? AS a'].
{ parametros buscar: { :row Saída escrever: row, stop. }. } pegar: { :e Saída escrever: e, stop. }, iniciar.

# the right number still works, more parameters are ignored as before
>> parametros := db consulta: ['SELECT ? AS a, ? AS b'].
parametros parametros: (Listar novo ; ['1'] ; ['2']).
parametros buscar: { :row Saída escrever: (row em: ['a']), escrever: (row em: ['b']), stop. }.
parametros parametros: (Listar novo ; ['1'] ; ['2'] ; ['3']).
parametros buscar: { :row Saída escrever: (row em: ['a']), escrever: (row em: ['b']), stop. }.
