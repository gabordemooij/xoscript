60 × {
	>> x := (Número random % 6) + 1.
	(x ≤ 6) não: { Saída escrever: ['FAIL']. }.
	(x ≥0) não: { Saída escrever: ['FAIL']. }.
	x := (Número random % 3) + 1.
	(x < 3) não: { Saída escrever: ['FAIL']. }.
	(x>-1) não: { Saída escrever: ['FAIL']. }.
	x := ((Boleano flip) número).
	(x = 0 ou: x = 1) não: { Saída escrever: ['FAIL']. }.
	x := ((Sim flip) número).
	(x = 0 ou: x = 1) não: { Saída escrever: ['FAIL']. }.
	x := (Boleano flip outro: ['HEAD'] ou: ['TAIL']).
	((x = ['HEAD']) ou: (x = ['TAIL'])) não: { Saída escrever: ['FAIL']. }.
}.
Saída escrever: ['DONE'].

