>> To-Do := Objeto novo.

To-Do em: ['novo'] fazer: {
	prop list := Listar novo.
}.

To-Do em: ['nieuw'] fazer: {
	prop list := Listar novo.
}.

To-Do em: ['+'] fazer: { :task
	prop list acrescentar: task.
}.

To-Do em: ['number of tasks?'] fazer: { <-  prop list conta.
}.

>> todos := 
	To-Do novo 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Saída escrever: ['You have $ tasks to do'] $ todos number of tasks?.
