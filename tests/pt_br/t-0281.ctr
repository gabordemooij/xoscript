>> q := Listar ← 1 ; 2 ; 3.
{ q ? ['1']. } pegar: { Saída escrever: ['caught!'], stop. }, iniciar.
{ q ? Sim. } pegar: { Saída escrever: ['caught!'], stop. }, iniciar.
{ q ? Não. } pegar: { Saída escrever: ['caught!'], stop. }, iniciar.
{ q ? Nulo. } pegar: { Saída escrever: ['caught!'], stop. }, iniciar.
{ q ? (Listar novo). } pegar: { Saída escrever: ['caught!'], stop. }, iniciar.
{ q ? (Objeto novo). } pegar: { Saída escrever: ['caught!'], stop. }, iniciar.
{ q ? ({ ['Empty']. }). } pegar: { Saída escrever: ['caught!'], stop. }, iniciar.
Saída escrever: ['caught them all'], stop.
