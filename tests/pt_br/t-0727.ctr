Server init.
>> f := Formato novo: ['%d'].
>> a := Blob novo: 4.
a bytes: ( Listar novo ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob novo: 4.
b bytes: ( Listar novo ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a de: 0 comprimento: 3, cada-um: { :i :byte
	Saída escrever: ( f aplicar-int: byte ), stop.
}.
a ^ b.
a de: 0 comprimento: 3, cada-um: { :i :byte
	Saída escrever: ( f aplicar-int: byte ), stop.
}.
a ^ b.
a de: 0 comprimento: 3, cada-um: { :i :byte
	Saída escrever: ( f aplicar-int: byte ), stop.
}.
a livre.
b livre.

{ a ^ Objeto. } pegar: { :e Saída escrever: e, stop. }, iniciar.
