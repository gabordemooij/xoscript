# compliance test

# use international numbers

Saída escrever: ['1000 -> '].
Saída escrever: 1000, stop. #1000

Saída escrever: ['1.5 -> '].
Saída escrever: 1.5, stop.  #1.5

Saída escrever: ['1001.5 -> '].
Saída escrever: 1.5 + 1000, stop. #1001.5

# use 0-indexed arrays
>> x := Listar novo ; 1 ; 2 ; 3.
>> y := Listar novo ; ['a'] ; ['b'] ; ['c'].

Saída escrever: ['1 -> '].
Saída escrever: x ? 0, stop. #1

Saída escrever: ['1 -> '].
Saída escrever: (x em: 0), stop. #1

Saída escrever: ['1 -> '].
Saída escrever: x primeiro, stop. #1

Saída escrever: ['3 -> '].
Saída escrever: x último, stop. #3

Saída escrever: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Saída escrever: (x por: y), stop.

Saída escrever: ['1 -> '].
Saída escrever: (x de: 0 comprimento: 1) primeiro, stop. #1

Saída escrever: ['0 -> '].
Saída escrever: (x encontre: 1), stop. #0

x colocar: 9 em: 0.

Saída escrever: ['9 -> '].
Saída escrever: (x em: 0), stop. #9

x preceder: 8.
Saída escrever: ['8 -> '].
Saída escrever: (x em: 0), stop. #9


x acrescentar: 10.
Saída escrever: ['10 -> '].
Saída escrever: (x em: 4), stop. #10








