

# create a 64-bit integer for exact calculations
>> a := Int64 de-string: ['123'].

# to string
Saída escrever: a, stop.

# divide
Saída escrever: a / (Int64 de-string: ['3']), stop.

# multiply
Saída escrever: a * (Int64 de-string: ['2']), stop.

# add
Saída escrever: a + (Int64 de-string: ['1']), stop.

# subtract
Saída escrever: a - (Int64 de-string: ['2']), stop.

# compare
Saída escrever: ( a =   (Int64 de-string: ['123'])), stop.
Saída escrever: ( a !=: (Int64 de-string: ['124'])), stop.
Saída escrever: ( a <   (Int64 de-string: ['124'])), stop.
Saída escrever: ( a >   (Int64 de-string: ['122'])), stop.
Saída escrever: ( a >=: (Int64 de-string: ['123'])), stop.
Saída escrever: ( a <=: (Int64 de-string: ['123'])), stop.





	