>> phrases := Listar novo
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases cada-um: { :_ :phrase 
	>> e := Server base64-codificar: phrase.
	>> d := Server base64-decodificar: e.
	Saída escrever: (
		message copiar ~encoded: e, ~decoded: d
	), stop.
}.
