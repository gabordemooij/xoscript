
>> Rectangle := Objeto novo.

Rectangle em: ['area'] fazer: { <- prop comprimento * prop width.
}.

Rectangle em: ['length:'] fazer: { :comprimento
	prop comprimento := comprimento.
}.

Rectangle em: ['width:'] fazer: { :width
	prop width := width.
}.

Rectangle em: ['novo'] fazer: {
	# this will not result into an infinite loop
	>> rectangle := isto novo.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle novo.
Saída escrever: a area, stop. #0

>> b := Rectangle novo length: 2, width: 3.
Saída escrever: b area, stop. #6

