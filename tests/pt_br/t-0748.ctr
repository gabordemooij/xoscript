Saída escrever: ['Test object'], stop.
>> a := Objeto novo. 

a em: ['item:'] fazer: { :boleano
	prop boleano := boleano. 
}.

a em: ['item'] fazer: { <- prop boleano.
}.

a item: Sim.

Saída escrever: a item, stop.

>> old-bool-address := a item protótipo endereço-de-memória.
a save-as: ['/tmp/a.bin'].
Saída escrever: ['========== RELOADING SNAP:'], stop.

>> b := Objeto load-from: ['/tmp/a.bin'].

(b item protótipo endereço-de-memória = old-bool-address) sim: {
	Saída escrever: ['Object link re-attached.'], stop.
}.

Saída escrever: b item, stop.
