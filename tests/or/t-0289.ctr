#Linux
>> OS := ପ୍ରୋଗ୍ରାମ୍ ସିଷ୍ଟମ୍: (ଆଦେଶ uname -s), ଛାଣ.

>> Slurp := ବସ୍ତୁ ନୂତନ.
Slurp ଯେବେ: ['ନୂତନ'] କର: {
	ନିଜର str := [''].
}.
Slurp ଯେବେ: ['ଉତ୍ତର:'] କର: { :blah
		(ନିଜର str ≠ ['']) ସତ୍ୟ-ହେଲେ: {
			ନିଜର str ଶେଷରେ-ଯୋଡ଼: [' '].
		}.
		ନିଜର str ଶେଷରେ-ଯୋଡ଼: blah.
}.
Slurp ଯେବେ: ['ଉତ୍ତର:ଏବଂ:'] କର: { :blah :blahah
		(ନିଜର str ≠ ['']) ସତ୍ୟ-ହେଲେ: {
			ନିଜର str ଶେଷରେ-ଯୋଡ଼: [' '].
		}.
		(blah ଲମ୍ବ > 1) ସତ୍ୟ-ହେଲେ: {
			ନିଜର str ଶେଷରେ-ଯୋଡ଼: (blah ଆରମ୍ଭ: 0 ଲମ୍ବ: (blah ଲମ୍ବ - 1)).
		}, ନଚେତ୍: {
			ନିଜର str ଶେଷରେ-ଯୋଡ଼: blah.
		}.
		ନିଜର str ଶେଷରେ-ଯୋଡ଼: [' '].
		ନିଜର str ଶେଷରେ-ଯୋଡ଼: blahah.
}.
Slurp ଯେବେ: ['obtain'] କର: {
	>> buffer := ନିଜର str.
	ନିଜର str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text ଶେଷରେ-ଯୋଡ଼: ['hello'].
} × 1000.


ଆଉଟପୁଟ୍ ଲେଖ: (
	ପ୍ରୋଗ୍ରାମ୍ ସିଷ୍ଟମ୍: (
		Slurp ନୂତନ
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

