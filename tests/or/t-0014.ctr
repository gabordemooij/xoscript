>> Greeter := ବସ୍ତୁ ନୂତନ.
Greeter ଯେବେ: ['make'] କର: {
	>> gr := ବସ୍ତୁ ନୂତନ.
	gr ଯେବେ: ['setName:'] କର: { :aname
		ନିଜର ନାମ := aname.
	}.
	gr ଯେବେ: ['greet'] କର: {
		ଆଉଟପୁଟ୍ ଲେଖ: ନିଜର ନାମ.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a ନୂତନ.
c setName: ['THREE'].
c greet.
>> d := a ନୂତନ.
d setName: ['FOUR'].
d greet.
c greet.
