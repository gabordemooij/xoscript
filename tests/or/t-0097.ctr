
ପାଠ୍ୟ ଯେବେ: ['html'] କର: { <- (
		ନିଜେ
		ବଦଳାଅ: ['&'] ସହିତ: ['&amp;'],
		ବଦଳାଅ: ['<'] ସହିତ: ['&lt;'],
		ବଦଳାଅ: ['>'] ସହିତ: ['&gt;'],
		ବଦଳାଅ: ['"'] ସହିତ: ['&quot;']
	).
}.

>> HtmlBrush := ବସ୍ତୁ ନୂତନ.

HtmlBrush ଯେବେ: ['ଉତ୍ତର:'] କର: { :tag
	ଆଉଟପୁଟ୍ ଲେଖ: (['<tag>↵'] tag: tag ).
}.

HtmlBrush ଯେବେ: ['ଉତ୍ତର:ଏବଂ:'] କର: { :tag :content
	tag := ( tag ଆରମ୍ଭ: 0 ଲମ୍ବ: (tag ଲମ୍ବ - 1) ).
	ଆଉଟପୁଟ୍ ଲେଖ: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush ଯେବେ: ['content:'] କର: { :text
	ଆଉଟପୁଟ୍ ଲେଖ: text html, ନୂଆ-ଧାଡ଼ି.
}.

HtmlBrush ଯେବେ: ['attr:value:'] କର: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush ନୂତନ.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
