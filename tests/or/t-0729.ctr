Server init.
>> a := Blob ନୂତନ: 4.
a bytes: ( ସାରଣୀ ନୂତନ ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob ନୂତନ: 4.
b bytes: ( ସାରଣୀ ନୂତନ ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a ^ b.
{
	a ^ ( ଫାଇଲ୍ ନୂତନ: ['noblob???'] ).
} ଧର: { :e ଆଉଟପୁଟ୍ ଲେଖ: e, ନୂଆ-ଧାଡ଼ି. }, ଚଲାଅ.
a ମୁକ୍ତ.
b ମୁକ୍ତ.
