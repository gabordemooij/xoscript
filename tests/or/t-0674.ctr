# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> ଫାଇଲ୍-ପଥ := ['/tmp/dat.csv'].
>> csv := ଫାଇଲ୍ ନୂତନ: ଫାଇଲ୍-ପଥ.
csv ଲେଖ: s.

# accepts CRLF LF CR, varying row length
csv ବିଭାଜକ: [';'] ଉଦ୍ଧୃତି: ['"'] ଧାଡ଼ିଗୁଡ଼ିକ: { :line
	ପ୍ରୋଗ୍ରାମ୍ ସଫା-କର.
	ଆଉଟପୁଟ୍ ଲେଖ: line, ନୂଆ-ଧାଡ଼ି.
	ପ୍ରୋଗ୍ରାମ୍ ସଫା-କର.
}.

# unequal lines
s ଶେଷରେ-ଯୋଡ଼: ['\njustone'].
csv ଲେଖ: s.
{
	csv ବିଭାଜକ: [';'] ଉଦ୍ଧୃତି: ['"'] ଧାଡ଼ିଗୁଡ଼ିକ: { :line
		ଆଉଟପୁଟ୍ ଲେଖ: line, ନୂଆ-ଧାଡ଼ି.
	}.
} ଧର: { :e 
	ଆଉଟପୁଟ୍ ଲେଖ: e, ନୂଆ-ଧାଡ଼ି.
}, ଚଲାଅ.

# invalid format
s := ['"he"llo";world'].
csv ଲେଖ: s.
{
	csv ବିଭାଜକ: [';'] ଉଦ୍ଧୃତି: ['"'] ଧାଡ଼ିଗୁଡ଼ିକ: { :line
		ଆଉଟପୁଟ୍ ଲେଖ: line, ନୂଆ-ଧାଡ଼ି.
	}.
} ଧର: { :e 
	ଆଉଟପୁଟ୍ ଲେଖ: e, ନୂଆ-ଧାଡ଼ି.
}, ଚଲାଅ.
