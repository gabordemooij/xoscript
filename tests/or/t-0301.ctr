


>> wine := ବସ୍ତୁ ନୂତନ.


wine ଯେବେ: ['toString'] କର: { <- ['merlot'].
}.

wine ଯେବେ: ['naarTekst'] କର: { <- ['merlot'].
}.


wine ଯେବେ: ['='] କର: { :other wine <- ( ନିଜେ toString = other wine ).
}.

wine ଯେବେ: ['=='] କର: { :other wine <- ( ନିଜେ toString = other wine ).
}.



wine
	କ୍ଷେତ୍ରରେ: ['cabernet'] କର: { ଆଉଟପୁଟ୍ ଲେଖ: ['it's a Cabernet!']. },
	କ୍ଷେତ୍ରରେ: ['syrah']    କର: { ଆଉଟପୁଟ୍ ଲେଖ: ['it's a Syrah!'].    },
	କ୍ଷେତ୍ରରେ: ['merlot']   କର: { ଆଉଟପୁଟ୍ ଲେଖ: ['it's a Merlot!'].   },
	କ୍ଷେତ୍ରରେ: ['malbec']   କର: { ଆଉଟପୁଟ୍ ଲେଖ: ['it's a Malbec!'].   }.

ଆଉଟପୁଟ୍ ନୂଆ-ଧାଡ଼ି.
