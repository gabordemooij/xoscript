# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := ପ୍ୟାଟର୍ନ ନୂତନ: pattern.
	p ମେଳ: subject କର: { :m :g
		ଆଉଟପୁଟ୍ ଲେଖ: g ଗଣନା, ଲେଖ: [' '], ଲେଖ: (g ଯୋଡ଼: ['|']), ନୂଆ-ଧାଡ଼ି. <- m.
	}.
}.
show ପ୍ରୟୋଗ: ['(a)|(b)'] ଏବଂ: ['b'].
show ପ୍ରୟୋଗ: ['(a)|(b)'] ଏବଂ: ['a'].
show ପ୍ରୟୋଗ: ['(x)?y'] ଏବଂ: ['y'].
show ପ୍ରୟୋଗ: ['(x)?(y)(z)?'] ଏବଂ: ['xy'].
