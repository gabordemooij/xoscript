>> phrases := ସାରଣୀ ନୂତନ
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases ପ୍ରତ୍ୟେକ: { :_ :phrase 
	>> e := Server base64-ଏନକୋଡ୍: phrase.
	>> d := Server base64-ଡିକୋଡ୍: e.
	ଆଉଟପୁଟ୍ ଲେଖ: (
		message ନକଲ ~encoded: e, ~decoded: d
	), ନୂଆ-ଧାଡ଼ି.
}.
