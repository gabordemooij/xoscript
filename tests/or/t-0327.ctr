

ସାରଣୀ ଯେବେ: ['fixture:'] କର: { :f
	ନିଜର fixture := f.
}.

ସାରଣୀ ଯେବେ: ['ଗଣନା'] କର: { <- ନିଜର fixture.
}.

ସାରଣୀ ଯେବେ: ['aantal'] କର: { <- ନିଜର fixture.
}.


>> x := ଶୂନ୍ୟ.
{

	x := ['hello'] 
	ବଦଳାଅ:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] ଅକ୍ଷର: 2)
			)
		)
	ସହିତ: (
		(['...hal'] + ['lo']) 
			ବଡ଼-ଅକ୍ଷର 
			lowecase 
			ବଡ଼-ଅକ୍ଷର 
			ଛାଡ଼: -1 + ( 
				11 - 12 + (
					(
						(
							(
								ସାରଣୀ ← 0 ; 1 ; 4; 9 ; (ସାରଣୀ ← 0 ; 3; 1) ; 4
							) ଶେଷ-ପୂର୍ବ
						) ? 1
					) + 
					((ସାରଣୀ ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					ଗଣନା
				)
			)
	).

} × 10.
ଆଉଟପୁଟ୍ ଲେଖ: x, ନୂଆ-ଧାଡ଼ି.

