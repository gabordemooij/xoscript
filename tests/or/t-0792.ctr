Server init.

>> DB := Maria-DB ନୂତନ ହୋଷ୍ଟ: ['localhost'],
	ଉପଯୋଗକର୍ତ୍ତା-ନାମ: ['xo'],
	ପାସୱାର୍ଡ: ['pass123'],
	ଡାଟାବେସ୍-ନାମ: ['xobase'],
	ସଂଯୋଗ.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB କ୍ୱେରୀ: SQL.

# now you don't have to set DB
query2 ଆଣ: { :row
	ଆଉଟପୁଟ୍ ଲେଖ: row world, ନୂଆ-ଧାଡ଼ି.
}.
