Server init.

# JSON encoder only supports UTF-8, no surrogate pairs

>> dicts := ସାରଣୀ ନୂତନ ;
	# {"key":"normal"} normal ASCII
	( ଅଭିଧାନ ନୂତନ ରଖ: ['normal'] ଚାବି: ['key'] ) ;
	# {"key":"hello world"} space character
	( ଅଭିଧାନ ନୂତନ ରଖ: ['hello world'] ଚାବି: ['key'] ) ;
	# {"key":"quote: \""} double quote
	( ଅଭିଧାନ ନୂତନ ରଖ: ['"'] ଚାବି: ['key'] ) ;
	# {"key":"backslash: \\"} backslash
	( ଅଭିଧାନ ନୂତନ ରଖ: ['backslash: \\'] ଚାବି: ['key'] ) ;
	# {"key":"slash: /"} slash
	( ଅଭିଧାନ ନୂତନ ରଖ: ['slash: /'] ଚାବି: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( ଅଭିଧାନ ନୂତନ ରଖ: ['backspace: \b'] ଚାବି: ['key'] ) ;
	# {"key":"formfeed: \f"} form-feed escape
	( ଅଭିଧାନ ନୂତନ ରଖ: ['formfeed: \f'] ଚାବି: ['key'] ) ;
	# {"key":"newline: \n"} newline
	( ଅଭିଧାନ ନୂତନ ରଖ: ['newline: \n'] ଚାବି: ['key'] ) ;
	( ଅଭିଧାନ ନୂତନ ରଖ: ['newline: ↵'] ଚାବି: ['key'] ) ;
	( ଅଭିଧାନ ନୂତନ ରଖ: ['newline: 
	'] ଚାବି: ['key'] ) ;
	# {"key":"carriage return: \r"} carriage-return
	( ଅଭିଧାନ ନୂତନ ରଖ: ['carriage return: \r'] ଚାବି: ['key'] ) ;
	# {"key":"tab: \t"} tab
	( ଅଭିଧାନ ନୂତନ ରଖ: ['tab \t'] ଚାବି: ['key'] ) ;
	( ଅଭିଧାନ ନୂତନ ରଖ: ['tab ⇿'] ଚାବି: ['key'] ) ;
	( ଅଭିଧାନ ନୂତନ ରଖ: ['tab  '] ଚାବି: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( ଅଭିଧାନ ନୂତନ ରଖ: ['NUL \u0000'] ଚାବି: ['key'] ) ;
	( ଅଭିଧାନ ନୂତନ ରଖ: ['NUL \0'] ଚାବି: ['key'] ) ;
	# {"key":"control: \u0001"} control character 0x01
	( ଅଭିଧାନ ନୂତନ ରଖ: ['control: \u0001'] ଚାବି: ['key'] ) ;
	# {"key":"control: \u001F"} control character 0x1F
	( ଅଭିଧାନ ନୂତନ ରଖ: ['control: \u001F'] ଚାବି: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-byte char
	( ଅଭିଧାନ ନୂତନ ରଖ: ['unicode: é'] ଚାବି: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-byte char
	( ଅଭିଧାନ ନୂତନ ରଖ: ['unicode: €'] ଚାବି: ['key'] ) ;
	# {"key":"unicode: 日本語"} multiple 3-byte UTF-8 chars
	( ଅଭିଧାନ ନୂତନ ରଖ: ['unicode: 日本語'] ଚାବି: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-byte char
	( ଅଭିଧାନ ନୂତନ ରଖ: ['unicode: 😀'] ଚାବି: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	( ଅଭିଧାନ ନୂତନ ରଖ: ['unicode: 🧑‍💻'] ଚାବି: ['key'] ) ;
	# {"key":"combining: e\u0301"} combining accent
	( ଅଭିଧାନ ନୂତନ ରଖ: ['combining: e\u0301'] ଚାବି: ['key'] ) ;
	# {"key":"escaped unicode: \u00e9"} Unicode escape BMP
	( ଅଭିଧାନ ନୂତନ ରଖ: ['escaped unicode: \u00e9'] ଚାବି: ['key'] ) ;
	# {"key":"escaped unicode: \u20ac"} Unicode escape BMP
	( ଅଭିଧାନ ନୂତନ ରଖ: ['escaped unicode: \u20ac'] ଚାବି: ['key'] ) ;
	# {"key":"escaped unicode: \ud83d\ude00"} UTF-16 surrogate pair
	( ଅଭିଧାନ ନୂତନ ରଖ: ['escaped unicode: \ud83d\ude00'] ଚାବି: ['key'] ) ;
	# {"key":""} empty value
	( ଅଭିଧାନ ନୂତନ ରଖ: [''] ଚାବି: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} special ASCII chars
	( ଅଭିଧାନ ନୂତନ ରଖ: ['@ < > & = % + ? #'] ଚାବି: ['key'] ) ;
	# {"key":"single quote: '"} single quote
	( ଅଭିଧାନ ନୂତନ ରଖ: ['''] ଚାବି: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} multiple JSON escapes
	( ଅଭିଧାନ ନୂତନ ରଖ: ['multiple: \" \\ \n \r \t'] ଚାବି: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} longer ASCII-string
	( ଅଭିଧାନ ନୂତନ ରଖ: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] ଚାବି: ['key'] ) ;
	# {"key":" value"} leading space
	( ଅଭିଧାନ ନୂତନ ରଖ: [' value'] ଚାବି: ['key'] ) ;
	# {"key":"value "} trailing space
	( ଅଭିଧାନ ନୂତନ ରଖ: ['value '] ଚାବି: ['key'] ) ;
	# {"key":" \t\n\r "} whitespace
	( ଅଭିଧାନ ନୂତନ ରଖ: [' \t\n\r '] ଚାବି: ['key'] ).

dicts ପ୍ରତ୍ୟେକ: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (ଅଭିଧାନ ନୂତନ ରଖ: d key ଚାବି: ['key']).
	>> b := JSON jsonify: (ଅଭିଧାନ ନୂତନ ରଖ: ['value'] ଚାବି: d key).
	>> e := JSON ବସ୍ତୁ: a.
	>> f := JSON ବସ୍ତୁ: b.
	((e key = d key ଏବଂ: (f ? d key = ['value'])) କିମ୍ବା: (e key = ['NUL ?'])) ସତ୍ୟ-ହେଲେ: {
		ଆଉଟପୁଟ୍ ଲେଖ: ['OK'], ନୂଆ-ଧାଡ଼ି.
	}, ନଚେତ୍: {
		ଆଉଟପୁଟ୍ ଲେଖ: ['Unable to properly encode/decode: '] + d + j, ନୂଆ-ଧାଡ଼ି.
		ପ୍ରୋଗ୍ରାମ୍ ଶେଷ.
	}.
}.
