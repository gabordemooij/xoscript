

>> obj := ବସ୍ତୁ ନୂତନ.

obj ଯେବେ: ['greet'] କର: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj ଯେବେ: ['task'] କର: {
	ନିଜର property := 123.
	{
		# try binds self/own to object instead of block
		ଆଉଟପୁଟ୍ ଲେଖ: ନିଜେ greet.
		ଆଉଟପୁଟ୍ ଲେଖ: ନିଜର property.
		1 / 0.
	} ଧର: {
		ଆଉଟପୁଟ୍ ଲେଖ: ନିଜେ greet.
		ଆଉଟପୁଟ୍ ଲେଖ: ନିଜର property.
		ଆଉଟପୁଟ୍ ଲେଖ: ['ok'].
	}, ଚେଷ୍ଟା.
}.

obj task.