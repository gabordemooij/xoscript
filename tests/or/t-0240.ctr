# test qualifiers

>> $ := ବସ୍ତୁ ନୂତନ.

$ ଯେବେ: ['ଉତ୍ତର:'] କର: { :x
	
	>> operation := x ଅକ୍ଷର: 0.
	>> valuta := x ଅକ୍ଷର: 1.
	>> money := x ଛାଡ଼: 2.
	
	>> amount := 0.

	( operation = ['+'] ) ସତ୍ୟ-ହେଲେ: {
		( valuta = ['£'] ) ସତ୍ୟ-ହେଲେ: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

ଆଉଟପୁଟ୍ ଲେଖ: x, ନୂଆ-ଧାଡ଼ି.


>> Fruit := ବସ୍ତୁ ନୂତନ.

Fruit ଯେବେ: ['ନୂତନ'] କର: {
	>> f := ନିଜେ ନୂତନ.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit ଯେବେ: ['apples:'] କର: { :a ନିଜର apples := a. }.
Fruit ଯେବେ: ['oranges:'] କର: { :p ନିଜର oranges := p. }.
Fruit ଯେବେ: ['apples'] କର: { <- ନିଜର apples. }.
Fruit ଯେବେ: ['oranges'] କର: { <- ନିଜର oranges. }.

Fruit ଯେବେ: ['+'] କର: { :f
	
	>> n := Fruit ନୂତନ.
	f ମିଶାଅ: 1.
	
	n apples: (f apples + ନିଜର apples).
	n oranges:  (f oranges  + ନିଜର oranges). <- n.
}.

Fruit ଯେବେ: ['ପାଠ୍ୟରେ'] କର: { <- ( ନିଜର apples ପାଠ୍ୟରେ + [' apples and '] + ନିଜର oranges + [' oranges'] ).
}.

ସଂଖ୍ୟା ଯେବେ: ['apples'] କର: { <- ((Fruit ନୂତନ) apples: ନିଜେ).
}.

ସଂଖ୍ୟା ଯେବେ: ['apple'] କର: { <- ((Fruit ନୂତନ) apples: ନିଜେ).
}.

ସଂଖ୍ୟା ଯେବେ: ['oranges'] କର: { <- ((Fruit ନୂତନ) oranges: ନିଜେ).
}.




ଆଉଟପୁଟ୍ ଲେଖ: (1 apple + 3 oranges + 4 apples), ନୂଆ-ଧାଡ଼ି.


ପାଠ୍ୟ ଯେବେ: ['twice'] କର: { <- ((ନିଜେ ପାଠ୍ୟରେ) + (ନିଜେ ପାଠ୍ୟରେ)).
}.



ଆଉଟପୁଟ୍ ଲେଖ: ['❤❤❤'] twice.



