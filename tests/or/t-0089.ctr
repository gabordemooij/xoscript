>> randomizer := { :a :b
	>> ସର୍ବନିମ୍ନ := ( a < b ) ଏହା: a ନହେଲେ: b.
	>> ସର୍ବାଧିକ := ( a > b ) ଏହା: a ନହେଲେ: b.
	>> x := ଶୂନ୍ୟ.
	{
		x := ସଂଖ୍ୟା ମଧ୍ୟରେ: a ଏବଂ: b.
		((x < ସର୍ବନିମ୍ନ) କିମ୍ବା: (x > ସର୍ବାଧିକ)) ସତ୍ୟ-ହେଲେ: { 
			ଆଉଟପୁଟ୍ ଲେଖ: (['Invalid value!']).
			ପ୍ରୋଗ୍ରାମ୍ ଶେଷ.
		}.
	} 
	× 100. <- x.
}.
randomizer ପ୍ରୟୋଗ: 0 ଏବଂ: 0.
