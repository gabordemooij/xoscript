>> makeAdder := { :x
	>> f := { :y <- (ନିଜର x + y). } ନିର୍ଦ୍ଧାରଣ: ['x'] ମୂଲ୍ୟ: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i ନିଜର q ରଖ: (ନିଜର f ପ୍ରୟୋଗ: (ନିଜର q ? i)) ଚାବି: i. } 
	ନିର୍ଦ୍ଧାରଣ: ['q'] ମୂଲ୍ୟ: array,
	ନିର୍ଦ୍ଧାରଣ: ['f'] ମୂଲ୍ୟ: func.
	{ :i mapping ପ୍ରୟୋଗ: i. } × (array ଗଣନା).
}.

>> a := ସାରଣୀ ← 1; 2; 3.
mapper ପ୍ରୟୋଗ: a ଏବଂ: (makeAdder ପ୍ରୟୋଗ: 100).
ଆଉଟପୁଟ୍ ଲେଖ: (a ଅବସ୍ଥାନ: 0), ନୂଆ-ଧାଡ଼ି.
ଆଉଟପୁଟ୍ ଲେଖ: (a ? 1), ନୂଆ-ଧାଡ଼ି.
ଆଉଟପୁଟ୍ ଲେଖ: (a ? 2), ନୂଆ-ଧାଡ଼ି.
