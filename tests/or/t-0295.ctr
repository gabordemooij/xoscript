
>> dictionary := (
	ଅଭିଧାନ ନୂତନ
		ରଖ: ['b'] ଚାବି: ['a'],
		ରଖ: ['a'] ଚାବି: ['b'],
		ରଖ: ['z'] ଚାବି: ['x'],
		ରଖ: ['hello'] ଚାବି: ['hallo'],
		ରଖ: ['human'] ଚାବି: ['human']
).

>> comparisons := ସାରଣୀ ନୂତନ.
dictionary ପ୍ରତ୍ୟେକ: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a ତୁଳନା: b)
	).
}.

comparisons ସଜାଅ: { :a :b <- ( a ତୁଳନା: b ). }.
ଆଉଟପୁଟ୍ ଲେଖ: ( comparisons ଯୋଡ଼: ['↵'] ), ନୂଆ-ଧାଡ଼ି.
comparisons ଯୋଡ଼: ['↵'].
