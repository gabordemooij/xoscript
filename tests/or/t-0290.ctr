# test list operations


>> cakes := ସାରଣୀ ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes ବଦଳାଅ: 1 ଲମ୍ବ: 2 ସହିତ: ( ସାରଣୀ ← ['cinnamon'] ; ['pineapple'] ).
ଆଉଟପୁଟ୍ ଲେଖ: (buy ଯୋଡ଼: [',']), ନୂଆ-ଧାଡ଼ି.


