60 × {
	>> x := (ସଂଖ୍ୟା random % 6) + 1.
	(x ≤ 6) ମିଥ୍ୟା-ହେଲେ: { ଆଉଟପୁଟ୍ ଲେଖ: ['FAIL']. }.
	(x ≥0) ମିଥ୍ୟା-ହେଲେ: { ଆଉଟପୁଟ୍ ଲେଖ: ['FAIL']. }.
	x := (ସଂଖ୍ୟା random % 3) + 1.
	(x < 3) ମିଥ୍ୟା-ହେଲେ: { ଆଉଟପୁଟ୍ ଲେଖ: ['FAIL']. }.
	(x>-1) ମିଥ୍ୟା-ହେଲେ: { ଆଉଟପୁଟ୍ ଲେଖ: ['FAIL']. }.
	x := ((ବୁଲିଆନ୍ flip) ସଂଖ୍ୟାରେ).
	(x = 0 କିମ୍ବା: x = 1) ମିଥ୍ୟା-ହେଲେ: { ଆଉଟପୁଟ୍ ଲେଖ: ['FAIL']. }.
	x := ((ସତ୍ୟ flip) ସଂଖ୍ୟାରେ).
	(x = 0 କିମ୍ବା: x = 1) ମିଥ୍ୟା-ହେଲେ: { ଆଉଟପୁଟ୍ ଲେଖ: ['FAIL']. }.
	x := (ବୁଲିଆନ୍ flip ଏହା: ['HEAD'] ନହେଲେ: ['TAIL']).
	((x = ['HEAD']) କିମ୍ବା: (x = ['TAIL'])) ମିଥ୍ୟା-ହେଲେ: { ଆଉଟପୁଟ୍ ଲେଖ: ['FAIL']. }.
}.
ଆଉଟପୁଟ୍ ଲେଖ: ['DONE'].

