>> echo := ବସ୍ତୁ ନୂତନ.
echo ଯେବେ: ['ଉତ୍ତର:'] କର: { :sound
	{ ଆଉଟପୁଟ୍ ଲେଖ: sound. } × 2.
}.
echo ho!. 


echo := ବସ୍ତୁ ନୂତନ.
echo ଯେବେ: ['ଉତ୍ତର:ଏବଂ:'] କର: { :sound :x
	{ ଆଉଟପୁଟ୍ ଲେଖ: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := ବସ୍ତୁ ନୂତନ.
echo ଯେବେ: ['ଉତ୍ତର:ଏବଂ:ଏବଂ:'] କର: { :operation :sound :x
	{ ଆଉଟପୁଟ୍ ଲେଖ: sound. } × x.
}.
echo shout: ['la'] times: 4. 


