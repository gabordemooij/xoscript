

>> Matryoshka := ବସ୍ତୁ ନୂତନ.
Matryoshka ଯେବେ: ['double:'] କର: { :secret
	ନିଜର secret := secret × 2.
}.
Matryoshka ଯେବେ: ['ନୂତନ:'] କର: { :secret
	>> answer := ଶୂନ୍ୟ.
	>> t := (secret > 255).
	ଆଉଟପୁଟ୍ ଲେଖ: (secret + [' | '] + t), ନୂଆ-ଧାଡ଼ି.
	t ସତ୍ୟ-ହେଲେ: {
		answer := secret.
	}, ନଚେତ୍: {
		answer := Matryoshka ପୁନରାବୃତ୍ତ ନୂତନ: (ନିଜେ double: secret).
	}. <- answer.
}.

>> x := Matryoshka ନୂତନ: 2.
