>> items := ଅଭିଧାନ ନୂତନ.
items ରଖ: ['green'] ଚାବି: ['color-1'].
items ରଖ: ['orange'] ଚାବି: ['color-2'].
items ରଖ: ['red'] ଚାବି: ['color-3'].
>> i := 0.
>> s := [''].
items ପ୍ରତ୍ୟେକ: { :key :color
	ଆଉଟପୁଟ୍ ଲେଖ: ['color #'] + i + [' is: '] + color + [' '].
	i ମିଶାଅ: 1.
}.
ଆଉଟପୁଟ୍ ଲେଖ: i + [' colors!'].
