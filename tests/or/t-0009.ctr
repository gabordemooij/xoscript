>> Greeter := ବସ୍ତୁ ନୂତନ.
Greeter ଯେବେ: ['make'] କର: {
	>> greeter := ବସ୍ତୁ ନୂତନ.
	greeter ଯେବେ: ['name:'] କର: { :ନାମ
		ଆଉଟପୁଟ୍ ଲେଖ: ['setting a name'].
		ନିଜର myName := ନାମ.
	}.
	greeter ଯେବେ: ['performGreeting'] କର: {
		ଆଉଟପୁଟ୍ ଲେଖ: ['Hello'].
		ଆଉଟପୁଟ୍ ଲେଖ: ନିଜର myName.
	}.
	greeter ଯେବେ: ['greet'] କର: {
		ନିଜେ performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
