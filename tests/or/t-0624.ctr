# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := ବସ୍ତୁ ନୂତନ.

Log ଯେବେ: ['say:'] କର: { :str
	ଆଉଟପୁଟ୍ ଲେଖ: str, ନୂଆ-ଧାଡ଼ି.
}.

>> Item := ବସ୍ତୁ ନୂତନ.

Item ଯେବେ: ['ନୂତନ:'] କର: { :id <- ନିଜେ ନୂତନ id: id.
}.

Item ଯେବେ: ['id:'] କର: { :id
	ନିଜର id := id.
}.

Item ଯେବେ: ['id'] କର: { <- ନିଜର id. }.


Item ଯେବେ: ['ପାଠ୍ୟରେ'] କର: {
	>> str := ['Item#~no'].
	str ~no: ନିଜର id. <- str.
}.


>> Print := ବସ୍ତୁ ନୂତନ.

Print ଯେବେ: ['items'] କର: { 
	
	ନିଜର item := Item ନୂତନ: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: ନିଜର item
	).
	
	
}.

Print items.