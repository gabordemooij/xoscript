# test buffers PKI/Sign 
Server init.

>> long := ( Uluhlu entsha zalisa: 1000 nge: ['a'] ) dibanisa: [''].

# sign a message
Imveliso bhala: ( 
	Isisefu tyikitya: ['abc'] nge: long
), umgca-omtsha.

Imveliso bhala: ( 
	Isisefu
		hlola: ['abc'] 
		utyikityo: long 
		nge: long
), umgca-omtsha.

Imveliso bhala: (
	Isisefu ihashi-lephasiwedi: long qinisekisa: long
), umgca-omtsha.
