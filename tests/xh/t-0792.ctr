Server init.

>> DB := Maria-DB entsha umamkeli: ['localhost'],
	igama-lomsebenzisi: ['xo'],
	iphasiwedi: ['pass123'],
	igama-ledatabheyisi: ['xobase'],
	qhagamshelana.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB umbuzo: SQL.

# now you don't have to set DB
query2 landa: { :row
	Imveliso bhala: row world, umgca-omtsha.
}.
