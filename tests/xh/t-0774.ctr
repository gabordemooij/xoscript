Imveliso bhala: ['Test object'], umgca-omtsha.
>> a := Into entsha. 
a xa-kufika: ['item:'] yenza: { :lst
	eyakho lst := lst. 
}.
a xa-kufika: ['item'] yenza: { <- eyakho lst.
}.
a item: (
	Uluhlu entsha ; 1 ; (
		Uluhlu entsha ; ['a'] ; (
			Uluhlu entsha ; ( Ixesha entsha: 1 )
		) ; ( Int64 ukusuka-kumbhalo: ['321'] )
	)
).
Imveliso bhala: a item, umgca-omtsha.
>> old-lst-address := a item umzekelo-wokuqala idilesi-yenkumbulo.
a save-as: ['/tmp/a.bin'].
Imveliso bhala: ['========== RELOADING SNAP:'], umgca-omtsha.
>> b := Into load-from: ['/tmp/a.bin'].
(b item umzekelo-wokuqala idilesi-yenkumbulo = old-lst-address) inyaniso: {
	Imveliso bhala: ['Object link re-attached.'], umgca-omtsha.
}.
Imveliso bhala: ( b item ), umgca-omtsha.
