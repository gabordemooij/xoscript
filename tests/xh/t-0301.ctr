


>> wine := Into entsha.


wine xa-kufika: ['toString'] yenza: { <- ['merlot'].
}.

wine xa-kufika: ['naarTekst'] yenza: { <- ['merlot'].
}.


wine xa-kufika: ['='] yenza: { :other wine <- ( ngokwakho toString = other wine ).
}.

wine xa-kufika: ['=='] yenza: { :other wine <- ( ngokwakho toString = other wine ).
}.



wine
	ukuba-kunjalo: ['cabernet'] yenza: { Imveliso bhala: ['it's a Cabernet!']. },
	ukuba-kunjalo: ['syrah']    yenza: { Imveliso bhala: ['it's a Syrah!'].    },
	ukuba-kunjalo: ['merlot']   yenza: { Imveliso bhala: ['it's a Merlot!'].   },
	ukuba-kunjalo: ['malbec']   yenza: { Imveliso bhala: ['it's a Malbec!'].   }.

Imveliso umgca-omtsha.
