# test list operations


>> cakes := Uluhlu ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes buyisela: 1 ubude: 2 nge: ( Uluhlu ← ['cinnamon'] ; ['pineapple'] ).
Imveliso bhala: (buy dibanisa: [',']), umgca-omtsha.


>> buy := cakes buyisela: 1 ubude: 12 nge: ( Uluhlu ← ['cinnamon'] ; ['pineapple'] ).
Imveliso bhala: (buy dibanisa: [',']), umgca-omtsha.


>> buy := cakes buyisela: 2 ubude: 10 nge: ( Uluhlu entsha ).
Imveliso bhala: (buy dibanisa: [',']), umgca-omtsha.


>> buy := cakes buyisela: 0 ubude: 1 nge: ( Uluhlu entsha ).
Imveliso bhala: (buy dibanisa: [',']), umgca-omtsha.


>> buy := cakes buyisela: ['0'] ubude: ['1'] nge: ['x'].
Imveliso bhala: (buy dibanisa: [',']), umgca-omtsha.
