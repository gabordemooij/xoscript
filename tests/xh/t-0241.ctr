

Umbhalo xa-kufika: ['evaluate'] yenza: {
	>> ikhowudi := Ifayile entsha: ['/tmp/eval.ctr'].
	ikhowudi bhala: (ngokwakho umbhalo + ['.']).
	Inkqubo sebenzisa: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Uluhlu ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q umbhalo.
Imveliso bhala: x, umgca-omtsha.
>> y := Engenanto.
(['y := '] + x ) evaluate.
Imveliso bhala: y ? 0, umgca-omtsha.

q := Isichazimagama beka: ['\[''] kwindawo: ['\['quote\']'].
x := q umbhalo.
Imveliso bhala: x, umgca-omtsha.
y := Engenanto.
(['y := '] + x ) evaluate.

>> q := (Isichazimagama entsha) beka:['\[''] kwindawo:['\['quote\[''].
Imveliso bhala: y ? ['\['quote\']'], umgca-omtsha.
