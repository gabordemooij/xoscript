

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Inkqubo ulawulo-lwenkumbulo: 0.

>> txt := ['1.6'].
>> n := txt inani.
>> t := txt ibhuliyeni.
Imveliso bhala: n, umgca-omtsha.
Imveliso bhala: t, umgca-omtsha.
Imveliso bhala: n uhlobo, umgca-omtsha.
Imveliso bhala: t uhlobo, umgca-omtsha.

Inkqubo coca.

usedMemory1 := (Inkqubo inkumbulo ? 0).


txt := ['1.6'].
n := txt inani.
t := txt ibhuliyeni.
Imveliso bhala: n, umgca-omtsha.
Imveliso bhala: t, umgca-omtsha.
Imveliso bhala: n uhlobo, umgca-omtsha.
Imveliso bhala: t uhlobo, umgca-omtsha.

Inkqubo coca.
usedMemory2 := (Inkqubo inkumbulo ? 0).


txt := ['1.6'].
n := txt inani.
t := txt ibhuliyeni.
Imveliso bhala: n, umgca-omtsha.
Imveliso bhala: t, umgca-omtsha.
Imveliso bhala: n uhlobo, umgca-omtsha.
Imveliso bhala: t uhlobo, umgca-omtsha.

Inkqubo coca.
usedMemory3 := (Inkqubo inkumbulo ? 0).



( usedMemory1 = usedMemory2 kwaye: usedMemory1 = usedMemory3, kwaye: usedMemory2 = usedMemory3 ) inyaniso: {
	Imveliso bhala: ['No memory leaks here'].
}, ubuxoki: {
	Imveliso bhala: ['Leaking memory...'].
}.
