Imveliso bhala: ['Test object'], umgca-omtsha.
>> greeter := Into entsha.
greeter xa-kufika: ['name:'] yenza: { :igama
	eyakho xname := igama. 
}.
greeter xa-kufika: ['greet'] yenza: {
	Imveliso bhala: ['Hello '] + eyakho xname, umgca-omtsha.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Imveliso bhala: ['========== RELOADING SNAP:'], umgca-omtsha.
>> b := Into load-from: ['/tmp/a.bin'].
>> c := Into load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
