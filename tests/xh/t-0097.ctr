
Umbhalo xa-kufika: ['html'] yenza: { <- (
		ngokwakho
		buyisela: ['&'] nge: ['&amp;'],
		buyisela: ['<'] nge: ['&lt;'],
		buyisela: ['>'] nge: ['&gt;'],
		buyisela: ['"'] nge: ['&quot;']
	).
}.

>> HtmlBrush := Into entsha.

HtmlBrush xa-kufika: ['phendula:'] yenza: { :tag
	Imveliso bhala: (['<tag>↵'] tag: tag ).
}.

HtmlBrush xa-kufika: ['phendula:kwaye:'] yenza: { :tag :content
	tag := ( tag ukusuka: 0 ubude: (tag ubude - 1) ).
	Imveliso bhala: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush xa-kufika: ['content:'] yenza: { :text
	Imveliso bhala: text html, umgca-omtsha.
}.

HtmlBrush xa-kufika: ['attr:value:'] yenza: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush entsha.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
