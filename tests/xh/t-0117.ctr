>> t := Inyaniso.
(t = Inyaniso) inyaniso: { Imveliso bhala: ['T']. }.
(t = Ubuxoki) inyaniso: { Imveliso bhala: ['F']. }.
Imveliso bhala: ['|'].
>> t := Ubuxoki.
(t = Inyaniso) inyaniso: { Imveliso bhala: ['T']. }.
(t = Ubuxoki) inyaniso: { Imveliso bhala: ['F']. }.
Imveliso bhala: ['|'].
>> f := Inyaniso.
(t = Inyaniso kwaye: f = Ubuxoki) inyaniso: { Imveliso bhala: ['T']. }.
(t = Ubuxoki kwaye: f = Inyaniso) inyaniso: { Imveliso bhala: ['F']. }.
Imveliso bhala: ['|'].
>> n := Engenanto.
(n Engenanto?) inyaniso: { Imveliso bhala: ['T']. }.
(n Engenanto?) ubuxoki: { Imveliso bhala: ['F']. }.
Imveliso bhala: ['|'].
(f Boolean?) inyaniso: { Imveliso bhala: ['T']. }.
(f Boolean?) ubuxoki: { Imveliso bhala: ['F']. }.



