Server init.
>> a := Blob entsha: 4.
a bytes: ( Uluhlu entsha ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob entsha: 4.
b bytes: ( Uluhlu entsha ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a ^ b.
{
	a ^ ( Ifayile entsha: ['noblob???'] ).
} bamba: { :e Imveliso bhala: e, umgca-omtsha. }, qala.
a khulula.
b khulula.
