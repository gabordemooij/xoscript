Server init.
Imveliso bhala: ['Database date test'], umgca-omtsha.

>> db := Maria-DB entsha umamkeli: ['localhost'],
	igama-lomsebenzisi: ['xo'], 
	iphasiwedi: ['pass123'],
	igama-ledatabheyisi: ['xobase'],
	qhagamshelana.

>> iiparamitha-zokukhangela :=
db umbuzo: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
landa: { :row
	Imveliso bhala: row datetest, umgca-omtsha.
}.
