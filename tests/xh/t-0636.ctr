# test url parsing

Server init.
>> url := URL umthombo: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Imveliso bhala: ['scheme = '] + url iskimu, umgca-omtsha.
Imveliso bhala: ['host = '] + url umamkeli, umgca-omtsha.
Imveliso bhala: ['port = '] + url izibuko, umgca-omtsha.
Imveliso bhala: ['path = '] + url indlela-yefayile, umgca-omtsha.
Imveliso bhala: ['query = '] + url iiparamitha-zokukhangela, umgca-omtsha.
Imveliso bhala: ['fragment = '] + url iqhekeza, umgca-omtsha.
