Server init.

>> db := Maria-DB entsha umamkeli: ['localhost'],
	igama-lomsebenzisi: ['xo'],
	iphasiwedi: ['pass123'],
	igama-ledatabheyisi: ['xobase'],
	qhagamshelana.

>> del := db umbuzo: ['DELETE FROM book WHERE id > 0'].
{  del phumeza. db qinisekisa. } bamba: { :e db buyisela-umva.  }, qala.

>> inani-lezinto := db umbuzo: ['SELECT COUNT(*) AS num FROM book'].
inani-lezinto landa: { :row Imveliso bhala: row num, umgca-omtsha. }.
