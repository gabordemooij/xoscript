>> str := ['write:'].
Imveliso umyalezo: ['bhala:'] izifakwa: (Uluhlu ← ['Hello World']), umgca-omtsha. 

Inani xa-kufika: ['isbetween:and:'] yenza: { :a :b <- ((ngokwakho ≥ a) kwaye: (ngokwakho ≤ b)).
}.

str := ['isbetween:and:'].
Imveliso bhala: (3 umyalezo: str izifakwa: (Uluhlu ← 2 ; 8)), umgca-omtsha.
Imveliso bhala: (3 umyalezo: str izifakwa: (Uluhlu ← 1 ; 2)), umgca-omtsha.


>> CoffeeMachine := Into entsha.
CoffeeMachine xa-kufika: ['makeCoffeeWithSugar:milk:'] yenza: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Uluhlu ← 4 ; 2.
Imveliso bhala: ( CoffeeMachine umyalezo: order izifakwa: coffeeConfiguration ), umgca-omtsha.
