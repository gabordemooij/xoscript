Imveliso bhala: ['Test object'], umgca-omtsha.
>> a := Into entsha. 

a xa-kufika: ['item:'] yenza: { :dict
	eyakho dict := dict. 
}.

a xa-kufika: ['item'] yenza: { <- eyakho dict.
}.

a item: (
Isichazimagama entsha
	hello: ['world']).

>> old-dict-address := a item umzekelo-wokuqala idilesi-yenkumbulo.
a save-as: ['/tmp/a.bin'].
Imveliso bhala: ['========== RELOADING SNAP:'], umgca-omtsha.

>> b := Into load-from: ['/tmp/a.bin'].

(b item umzekelo-wokuqala idilesi-yenkumbulo = old-dict-address) inyaniso: {
	Imveliso bhala: ['Object link re-attached.'], umgca-omtsha.
}.

Imveliso bhala: b item, umgca-omtsha.
