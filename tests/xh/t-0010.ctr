>> Animal := Into entsha.
Animal xa-kufika: ['make'] yenza: {
	>> animal := Into entsha.
	animal xa-kufika: ['makeSound'] yenza: {
		Imveliso bhala: eyakho sound.
	}. <- animal.
}.
>> Cat := Into entsha.
Cat xa-kufika: ['make'] yenza: {
	>> cat := Animal make.
	cat xa-kufika: ['init'] yenza: {
		eyakho sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
