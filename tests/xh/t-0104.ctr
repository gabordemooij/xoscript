
{ :i
	Imveliso bhala: ['This is step #'] + ( ( i ) + 1 ), umgca-omtsha.
} × 6.

{ :i
	Imveliso bhala: ['This is step #'] + ( 3 - ( i ) ), umgca-omtsha.
} × 6.

{ :i
	Imveliso bhala: ['NEVER!'], umgca-omtsha.
} × 0.



{ :i
	Imveliso bhala: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), umgca-omtsha.
} × 11.
