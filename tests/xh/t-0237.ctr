
Umbhalo xa-kufika: ['evaluate'] yenza: {
	>> ikhowudi := Ifayile entsha: ['/tmp/eval.ctr'].
	ikhowudi bhala: (ngokwakho umbhalo + ['.']).
	Inkqubo sebenzisa: ['/tmp/eval.ctr'].
}.

>> map :=
	(Isichazimagama entsha)
	beka: ['Hi There'] kwindawo: ['two'],
	beka: (Uluhlu ← ['hello'] ; ['world'] ; (Uluhlu ← 1 ; 2; 9) ; Ubuxoki) kwindawo: ['one'],
	beka: ( (Isichazimagama entsha) beka: ['wrrld'] kwindawo: ['misspelled'] ) kwindawo: ['three'],
	beka: (Uluhlu ← ((Isichazimagama entsha) beka: ['treasure'] kwindawo: ['hidden']) ; 2) kwindawo: ['four']. 
>> str := map umbhalo.
>> map2 := Engenanto.
(['map2 := '] + str ) evaluate.
Imveliso bhala: map2 ? ['one'] ? 0.
Imveliso bhala: map2 ? ['one'] ? 1.
Imveliso bhala: map2 ? ['four'] ? 0 ? ['hidden'].
Imveliso bhala: map2 ? ['one'] ? 2 ? 2.
