>> t := Engenanto.

# you can control the time zone for
# parsing like this:
Ixesha ummandla-wexesha: ['CET'].
t := Ixesha umthombo: ['1981-02-03 04:05:06'].
Imveliso bhala: t, umgca-omtsha.

# now using CEST time zone:
Ixesha ummandla-wexesha: ['CEST'].
t := Ixesha umthombo: ['1981-02-03 04:05:06'].
Imveliso bhala: t, umgca-omtsha.

# error if string cannot be parsed
{ Ixesha umthombo: ['1900']. } bamba: { Engenanto. }, qala.
