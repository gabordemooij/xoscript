#Linux
>> Slurp := Into entsha.

Slurp xa-kufika: ['entsha'] yenza: {
	eyakho str := [''].
}.

Slurp xa-kufika: ['nieuw'] yenza: {
	eyakho str := [''].
}.

Slurp xa-kufika: ['phendula:'] yenza: { :blah
		eyakho str yongeza-ekugqibeleni: blah.
}.

Slurp xa-kufika: ['phendula:kwaye:'] yenza: { :blah :blahah
		eyakho str yongeza-ekugqibeleni: (blah ukusuka: 0 ubude: (blah ubude - 1)).
		eyakho str yongeza-ekugqibeleni: [' '].
		eyakho str yongeza-ekugqibeleni: blahah.
}.

Slurp xa-kufika: ['obtain'] yenza: {
	>> buffer := eyakho str.
	eyakho str := ['']. <- buffer.
}.


Imveliso bhala: (Inkqubo isixokelelwano: (Slurp entsha echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Ifayile entsha: ['/tmp/from.txt'], cima. } bamba: { ['Empty']. }, qala.
{ Ifayile entsha: ['/tmp/to.txt'], cima. } bamba: { ['Empty']. }, qala.


Ifayile entsha: ['/tmp/to.txt'], ikhona ubuxoki: {
	Imveliso bhala: ['Confirmed. Target file does not exist.\
'].
}.
Ifayile entsha: ['/tmp/from.txt'], ikhona ubuxoki: {
	Imveliso bhala: ['Confirmed. Source file does not exist.\
'].
}.



Inkqubo isixokelelwano: (Slurp entsha touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Inkqubo isixokelelwano: (Slurp entsha cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Ifayile entsha: ['/tmp/to.txt'], ikhona inyaniso: {
	Imveliso bhala: ['Confirmed. Target file has been created by shell.\
'].
}.


Imveliso bhala: ['Contents of file is:'] + (Ifayile entsha: ['/tmp/to.txt'], funda), umgca-omtsha.
