# test Program version

# this feature is disabled by default
Imveliso bhala: (
	Inkqubo uphawu: 
	['RECURSIVE_STRINTPOL']
), umgca-omtsha.


# but if we set the time back
>> today := Ixesha 
ummandla-wexesha: ['CEST'],
umthombo: ['2026-02-15 10:00:00'].
Inkqubo inguqulelo: today.

# it will be enabled like it used to be (from now on)
Imveliso bhala: (
	Inkqubo uphawu: 
	['RECURSIVE_STRINTPOL']
), umgca-omtsha.