

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Inkqubo ulawulo-lwenkumbulo: 0.

Inani xa-kufika: ['addNum:'] yenza: { :x
	ngokwakho yongeza: x.
}.

Inani xa-kufika: ['subtractNum:'] yenza: { :x
	ngokwakho thabatha: x.
}.

Inani xa-kufika: ['multiplyBy:'] yenza: { :x
	ngokwakho phinda-ngo: x.
}.

Inani xa-kufika: ['divideBy:'] yenza: { :x
	ngokwakho yahlula-ngo: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 amandla-enani: 8).  
a := a + (2 amandla-enani: -1). 
a := a + (49 ingcambu-yesikwere).   
a addNum: ((Uluhlu ← 0 ; 1) ubuninzi).          
a addNum: ((Uluhlu ← 2 ; 3) ubuncinci).
Imveliso bhala: a.

Inkqubo coca.

usedMemory1 := (Inkqubo inkumbulo ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 amandla-enani: 8).  
a := a + (2 amandla-enani: -1). 
a := a + (49 ingcambu-yesikwere).   
a addNum: ((Uluhlu ← 0 ; 1) ubuninzi).          
a addNum: ((Uluhlu ← 2 ; 3) ubuncinci).
Imveliso bhala: a.

Inkqubo coca.
usedMemory2 := (Inkqubo inkumbulo ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 amandla-enani: 8).  
a := a + (2 amandla-enani: -1). 
a := a + (49 ingcambu-yesikwere).   
a addNum: ((Uluhlu ← 0 ; 1) ubuninzi).          
a addNum: ((Uluhlu ← 2 ; 3) ubuncinci).
Imveliso bhala: a.

Inkqubo coca.
usedMemory3 := (Inkqubo inkumbulo ? 0).



( usedMemory1 = usedMemory2 kwaye: usedMemory1 = usedMemory3, kwaye: usedMemory2 = usedMemory3 ) inyaniso: {
	Imveliso bhala: ['No memory leaks here'].
}, ubuxoki: {
	Imveliso bhala: ['Leaking memory...'].
}.
