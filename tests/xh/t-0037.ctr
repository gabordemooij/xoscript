>> a := 3.
>> b := a kopa.
a thabatha: 1.
Imveliso bhala: [' a = '] + a.
Imveliso bhala: [' b = '] + b.
a := 3.
b := a + 4.
Imveliso bhala: [' a = '] + a.
Imveliso bhala: [' b = '] + b.
>> x := 3.
>> y := x kopa.
x yongeza: 10.
y thabatha: 1.
Imveliso bhala: [' x = '] + x.
Imveliso bhala: [' y = '] + y.
>> q := Into entsha.
q xa-kufika: ['setProperty:'] yenza: { :x
	eyakho prop := x.
}.
q xa-kufika: ['getProperty'] yenza: { <- eyakho prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Imveliso bhala: [' p = '] + (p getProperty).
