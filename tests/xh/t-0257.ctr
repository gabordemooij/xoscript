
>> Greeter := Into entsha.
Greeter xa-kufika: ['entsha'] yenza: {
	eyakho igama := ['?'].
}.
Greeter xa-kufika: ['name:'] yenza: { :igama
	eyakho igama := igama.
}.
Greeter xa-kufika: ['greet'] yenza: {
	Imveliso bhala: (['hello[you]'] [you]: eyakho igama).
}.
>> friend := Greeter entsha.
friend name: ['1'].
friend greet.
