
>> a := Uluhlu ← (Uluhlu ← 100 ; 200 ; 300) ; (Uluhlu ← 9 ; 8 ; 7).
Imveliso bhala: ['at 0,1 :'].
Imveliso bhala: a ? 0 ? 1, umgca-omtsha. 
Imveliso bhala: ['at 1,2 :'].
Imveliso bhala: a ? 1 ? 2, umgca-omtsha. 
>> menu := Isichazimagama entsha.
menu beka: (Uluhlu ← ['pizza'] ; ['spaghetti']) kwindawo: ['Italian Cuisine'].
menu beka: (Uluhlu ← ['bifteki'] ; ['suflaki']) kwindawo: ['Greek Cuisine'].
Imveliso bhala: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), umgca-omtsha. 
Imveliso bhala: ['but not on the same plate.'], umgca-omtsha.
