

Uluhlu xa-kufika: ['sum'] yenza: {
	>> total := 0.
	ngokwakho nganye: { :index :element
		total yongeza: element.
	}. <- total.
}.

Uluhlu xa-kufika: ['product'] yenza: {
	>> total := 1.
	ngokwakho nganye: { :index :element
		total phinda-ngo: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Inkqubo ulawulo-lwenkumbulo: 0.

{

>> a := Uluhlu ← ['hello'] ; ['world'] ; Inyaniso ; Engenanto ; 666.
a := a + ( Uluhlu ← 1 ).
Imveliso bhala: ( ['sum: '] + ( a sum ) ), umgca-omtsha.
Imveliso bhala: ( ['min: '] + ( a ubuncinci ) ), umgca-omtsha.
Imveliso bhala: ( ['max: '] + ( a ubuninzi ) ), umgca-omtsha.
Imveliso bhala: ( ['3rd: '] + ( a ? 2 ) ), umgca-omtsha.
Imveliso bhala: ( ['prd: '] + ( a product ) ), umgca-omtsha.
a cwangcisa: { :a :b <- (b - a). }.
a nganye: { :i :e Imveliso bhala: ( i - 0 ), umgca-omtsha. }.

} qala.

Inkqubo coca.
usedMemory1 := (Inkqubo inkumbulo ? 0).


{

>> a := Uluhlu ← ['hello'] ; ['world'] ; Inyaniso ; Engenanto ; 666.
a := a + ( Uluhlu ← 1 ).
Imveliso bhala: ( ['sum: '] + ( a sum ) ), umgca-omtsha.
Imveliso bhala: ( ['min: '] + ( a ubuncinci ) ), umgca-omtsha.
Imveliso bhala: ( ['max: '] + ( a ubuninzi ) ), umgca-omtsha.
Imveliso bhala: ( ['3rd: '] + ( a ? 2 ) ), umgca-omtsha.
Imveliso bhala: ( ['prd: '] + ( a product ) ), umgca-omtsha.
a cwangcisa: { :a :b <- (b - a). }.
a nganye: { :i :e Imveliso bhala: ( i - 0 ), umgca-omtsha. }.

} qala.



Inkqubo coca.
usedMemory2 := (Inkqubo inkumbulo ? 0).


{

>> a := Uluhlu ← ['hello'] ; ['world'] ; Inyaniso ; Engenanto ; 666.
a := a + ( Uluhlu ← 1 ).
Imveliso bhala: ( ['sum: '] + ( a sum ) ), umgca-omtsha.
Imveliso bhala: ( ['min: '] + ( a ubuncinci ) ), umgca-omtsha.
Imveliso bhala: ( ['max: '] + ( a ubuninzi ) ), umgca-omtsha.
Imveliso bhala: ( ['3rd: '] + ( a ? 2 ) ), umgca-omtsha.
Imveliso bhala: ( ['prd: '] + ( a product ) ), umgca-omtsha.
a cwangcisa: { :a :b <- (b - a). }.
a nganye: { :i :e Imveliso bhala: ( i - 0 ), umgca-omtsha. }.

} qala.



Inkqubo coca.
usedMemory3 := (Inkqubo inkumbulo ? 0).

( usedMemory1 = usedMemory2 kwaye: usedMemory1 = usedMemory3, kwaye: usedMemory2 = usedMemory3 ) inyaniso: {
	Imveliso bhala: ['No memory leaks here'].
}, ubuxoki: {
	Imveliso bhala: ['Leaking memory...'].
}.
