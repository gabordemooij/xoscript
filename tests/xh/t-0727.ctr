Server init.
>> f := Ifomathi entsha: ['%d'].
>> a := Blob entsha: 4.
a bytes: ( Uluhlu entsha ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob entsha: 4.
b bytes: ( Uluhlu entsha ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a ukusuka: 0 ubude: 3, nganye: { :i :byte
	Imveliso bhala: ( f sebenzisa-kwinani-elipheleleyo: byte ), umgca-omtsha.
}.
a ^ b.
a ukusuka: 0 ubude: 3, nganye: { :i :byte
	Imveliso bhala: ( f sebenzisa-kwinani-elipheleleyo: byte ), umgca-omtsha.
}.
a ^ b.
a ukusuka: 0 ubude: 3, nganye: { :i :byte
	Imveliso bhala: ( f sebenzisa-kwinani-elipheleleyo: byte ), umgca-omtsha.
}.
a khulula.
b khulula.

{ a ^ Into. } bamba: { :e Imveliso bhala: e, umgca-omtsha. }, qala.
