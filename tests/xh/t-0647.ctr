Server init.
Imveliso bhala: ['Database time test'], umgca-omtsha.

>> db := Maria-DB entsha umamkeli: ['localhost'],
	igama-lomsebenzisi: ['xo'], 
	iphasiwedi: ['pass123'],
	igama-ledatabheyisi: ['xobase'],
	qhagamshelana.

>> iiparamitha-zokukhangela :=
db umbuzo: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
landa: { :row
	Imveliso bhala: row timetest, umgca-omtsha.
}.
