#Linux
>> OS := Inkqubo isicwangciso: ['OS'].

>> clock := Ixesha entsha.
	
(OS = ['Haiku']) inyaniso: {
	clock ummandla-wexesha: ['CET'],
	unyaka: 2017, inyanga: 7, usuku: 13,
	iyure: 18, umzuzu: 0, umzuzwana: 0.
}, kungenjalo: {
	clock ummandla-wexesha: ['Europe/Amsterdam'],
	unyaka: 2017, inyanga: 7, usuku: 13,
	iyure: 18, umzuzu: 0, umzuzwana: 0.
}.

clock xa-kufika: ['tell'] yenza: {
	Imveliso bhala: ngokwakho, umgca-omtsha.
}.


clock yongeza: 2    iyure, tell.
clock yongeza: 1    iyure, tell.
clock yongeza: 19 umzuzu, tell.
clock yongeza: 1  umzuzu, tell.
clock yongeza: 1  umzuzu, tell.
clock yongeza: 19 umzuzwana, tell.
clock yongeza: 1  umzuzwana, tell.
clock yongeza: 1  umzuzwana, tell.
clock yongeza: 2    unyaka, tell.
clock yongeza: 1    unyaka, tell.

(OS = ['Haiku']) inyaniso: {
clock yongeza: 5   inyanga.
clock ummandla-wexesha: ['CEST'], tell.
}, kungenjalo: {
	clock yongeza: 5   inyanga, tell.
}.

clock yongeza: 1   inyanga, tell.
clock yongeza: 19    usuku, tell.
clock yongeza: 1    iyure, tell.
clock yongeza: 120  yard, tell.
