Umbhalo xa-kufika: ['html'] yenza: { <- (
		ngokwakho
		buyisela: ['&'] nge: ['&amp;'],
		buyisela: ['<'] nge: ['&lt;'],
		buyisela: ['>'] nge: ['&gt;'],
		buyisela: ['''] nge: ['&apos;'],
		buyisela: ['"'] nge: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Inkqubo ulawulo-lwenkumbulo: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Imveliso bhala: txt kopa html, umgca-omtsha.
Imveliso bhala: txt kopa oonobumba-abancinci, umgca-omtsha.
Imveliso bhala: txt kopa oonobumba-abakhulu, umgca-omtsha.
} qala.

Inkqubo coca.

usedMemory1 := (Inkqubo inkumbulo ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Imveliso bhala: txt kopa html, umgca-omtsha.
Imveliso bhala: txt kopa oonobumba-abancinci, umgca-omtsha.
Imveliso bhala: txt kopa oonobumba-abakhulu, umgca-omtsha.
} qala.

Inkqubo coca.
usedMemory2 := (Inkqubo inkumbulo ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Imveliso bhala: txt kopa html, umgca-omtsha.
Imveliso bhala: txt kopa oonobumba-abancinci, umgca-omtsha.
Imveliso bhala: txt kopa oonobumba-abakhulu, umgca-omtsha.
} qala.

Inkqubo coca.
usedMemory3 := (Inkqubo inkumbulo ? 0).



( usedMemory1 = usedMemory2 kwaye: usedMemory1 = usedMemory3, kwaye: usedMemory2 = usedMemory3 ) inyaniso: {
	Imveliso bhala: ['No memory leaks here'].
}, ubuxoki: {
	Imveliso bhala: ['Leaking memory...'].
}.
