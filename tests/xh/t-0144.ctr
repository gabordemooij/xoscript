



>> CoffeeGrounds := Into entsha.
CoffeeGrounds xa-kufika: ['extract'] yenza: { <- ['coffee']. }.

>> CoffeeMachine := Into entsha.
CoffeeMachine xa-kufika: ['init'] yenza: {
	eyakho coffeegrounds := CoffeeGrounds entsha.
}.
CoffeeMachine xa-kufika: ['entsha'] yenza: { <- CoffeeMachine `new init.
}.

CoffeeMachine xa-kufika: ['makeTea'] yenza: { <- (eyakho tealeaves extract). }.
CoffeeMachine xa-kufika: ['makeCoffee'] yenza: { <- (eyakho coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine entsha.

Imveliso bhala:
	coffeeDream 
	makeCoffee.

Imveliso bhala:
	coffeeDream 
	makeTea.
