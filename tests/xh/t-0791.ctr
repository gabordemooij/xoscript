Server init.

>> DB := Maria-DB entsha umamkeli: ['localhost'],
	igama-lomsebenzisi: ['xo'],
	iphasiwedi: ['pass123'],
	igama-ledatabheyisi: ['xobase'],
	qhagamshelana.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> iiparamitha-zokukhangela := Umbuzo-Maria entsha: SQL.

# set database
iiparamitha-zokukhangela idatabheyisi: DB.

iiparamitha-zokukhangela landa: { :row
	Imveliso bhala: row world, umgca-omtsha.
}.
