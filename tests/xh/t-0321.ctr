# test qualifiers

Inkqubo coca.

>> Fruit := Into entsha.
Fruit xa-kufika: ['entsha'] yenza: {
	>> f := ngokwakho entsha.
	f apples: 0. <- f.
}.
Fruit xa-kufika: ['apples:'] yenza: { :a eyakho apples := a. }.
Fruit xa-kufika: ['apples'] yenza: { <- eyakho apples. }.
Fruit xa-kufika: ['+'] yenza: { :f
	>> n := Fruit entsha.
	n apples: (f apples + eyakho apples). <- n.
}.
Inani xa-kufika: ['apples'] yenza: { <- ((Fruit entsha) apples: ngokwakho).
}.

Fruit xa-kufika: ['umbhalo'] yenza: { <- eyakho apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Imveliso bhala: q, umgca-omtsha.




q := 3 apples + 4 apples.
Imveliso bhala: q, umgca-omtsha.



