# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB entsha umamkeli: ['localhost'],
	igama-lomsebenzisi: ['xo'],
	iphasiwedi: ['pass123'],
	igama-ledatabheyisi: ['xobase'],
	qhagamshelana.

>> iiparamitha-zokukhangela := db umbuzo: ['SELECT %% FROM'].
{ iiparamitha-zokukhangela phumeza. } bamba: { :e
	Imveliso bhala: ( e iqulethe: ['%%'] ), umgca-omtsha.
}, qala.
