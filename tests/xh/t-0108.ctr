
(7 engumnqakathi?) inyaniso: { Imveliso bhala: ['7 is an ODD NUMBER'], umgca-omtsha. }, kungenjalo: { Imveliso bhala: ['WRONG!']. }.
(4 elinganayo?) inyaniso: { Imveliso bhala: ['4 is an EVEN NUMBER'], umgca-omtsha. }, kungenjalo: { Imveliso bhala: ['WRONG!']. }.
(5 elinganayo?) inyaniso: { Imveliso bhala: ['WRONG!']. }, kungenjalo: { Imveliso bhala: ['5 is NOT AN EVEN NUMBER'], umgca-omtsha. }.
(6 engumnqakathi?) inyaniso: { Imveliso bhala: ['WRONG!']. }, kungenjalo: { Imveliso bhala: ['6 is NOT AN ODD NUMBER'], umgca-omtsha. }.
