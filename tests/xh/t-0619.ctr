>> HTML := Into entsha.
HTML xa-kufika: ['phendula:'] yenza: { :tag 
	Imveliso bhala: (['<tag>'] tag: tag), umgca-omtsha.
}.
HTML xa-kufika: ['phendula:kwaye:'] yenza: { :tag :html 
	Imveliso bhala: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), umgca-omtsha.
}.
>> html := HTML entsha.
html body h1: ['header'].

