Server init.

# returning non-str from match/do should be ok
>> subject := ['abc'].
>> pattern := Ipateni entsha: ['([ac])'].
>> result := pattern ukungqamana: subject yenza: { :m :x
	Imveliso bhala: m, umgca-omtsha.
	Imveliso bhala: x, umgca-omtsha. <- Engenanto.
}.
Imveliso bhala: result, umgca-omtsha.