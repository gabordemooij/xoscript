Inani xa-kufika: ['roman'] yenza: {
	>> inani := ngokwakho kopa.
	>> roman := [''].
	{
		{
			(inani ≥ 1000) inyaniso: {
				roman yongeza-ekugqibeleni: ['Ⅿ'].
				inani thabatha: 1000.
			}, yaphula.
		
			(inani ≥ 500) inyaniso: {
				roman yongeza-ekugqibeleni: ['Ⅾ'].
				inani thabatha: 500.
			}, yaphula.
		
			(inani ≥ 100) inyaniso: {
				roman yongeza-ekugqibeleni: ['Ⅽ'].
				inani thabatha: 100.
			}, yaphula.
		
			(inani ≥ 50) inyaniso: {
				roman yongeza-ekugqibeleni: ['Ⅼ'].
				inani thabatha: 50.
			}, yaphula.
		
			(inani ≥ 50) inyaniso: {
				roman yongeza-ekugqibeleni: ['Ⅼ'].
				inani thabatha: 50.
			}, yaphula.
		
			(inani ≥ 10) inyaniso: {
				roman yongeza-ekugqibeleni: ['Ⅹ'].
				inani thabatha: 10.
			}, yaphula.
			
			(inani ≥ 9) inyaniso: {
				roman yongeza-ekugqibeleni: ['Ⅸ'].
				inani thabatha: 9.
			}, yaphula.
			
			(inani ≥ 5) inyaniso: {
				roman yongeza-ekugqibeleni: ['Ⅴ'].
				inani thabatha: 5.
			}, yaphula.
			
			(inani ≥ 4) inyaniso: {
				roman yongeza-ekugqibeleni: ['Ⅳ'].
				inani thabatha: 4.
			}, yaphula.
			
			(inani ≥ 1) inyaniso: {
				roman yongeza-ekugqibeleni: ['Ⅰ'].
				inani thabatha: 1.
			}, yaphula.
		} inkqubo-yomsebenzi.
	} ngelixa: { <- inani > 0. }. <- roman.
}.

Imveliso bhala: 1 roman, umgca-omtsha.
Imveliso bhala: 2 roman, umgca-omtsha.
Imveliso bhala: 4 roman, umgca-omtsha.
Imveliso bhala: 8 roman, umgca-omtsha.
Imveliso bhala: 16 roman, umgca-omtsha.
Imveliso bhala: 32 roman, umgca-omtsha.
Imveliso bhala: 64 roman, umgca-omtsha.
Imveliso bhala: 128 roman, umgca-omtsha.
Imveliso bhala: 256 roman, umgca-omtsha.
Imveliso bhala: 1024 roman, umgca-omtsha.
