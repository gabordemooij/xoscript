#Linux

(Ifayile entsha: ['/tmp/testje']) ikhona ubuxoki: {
	Inkqubo isixokelelwano: ['mkdir /tmp/testje'].	
}.

(Ifayile entsha: ['/tmp/testje/file1']) ikhona ubuxoki: {
	Inkqubo isixokelelwano: ['touch /tmp/testje/file1'].	
}.

(Ifayile entsha: ['/tmp/testje/folder1']) ikhona ubuxoki: {
	Inkqubo isixokelelwano: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Ifayile uluhlu: ['/tmp/testje'].

>> q := Uluhlu entsha.

l nganye: { :k :v v nganye: { :x :y q yongeza-ekugqibeleni: y. }. }.

>> s := q umbhalo.

(s iqulethe: ['file1']) inyaniso:   { Imveliso bhala: ['OK'], umgca-omtsha. }.
(s iqulethe: ['file2']) inyaniso:   { Imveliso bhala: ['XX'], umgca-omtsha. }.
(s iqulethe: ['folder1']) inyaniso: { Imveliso bhala: ['OK'], umgca-omtsha. }.
