#Linux

 >> t := Ixesha entsha.
 
t ummandla-wexesha: ['Europe/Amsterdam'].
t unyaka: 2020, inyanga: 8, usuku: 2, iyure: 21, umzuzu: 2, umzuzwana: 1.

>> a := t iyure.
>> ams := t ummandla-wexesha.

t ummandla-wexesha: ['US/Hawaii'].
>> b := t iyure.
>> hw := t ummandla-wexesha.

Imveliso
bhala: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		oku: ['later'] okanye-oko: ['earlier']
	)
),
umgca-omtsha.
 