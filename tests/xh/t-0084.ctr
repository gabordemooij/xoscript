>> makeAdder := { :x
	>> f := { :y <- (eyakho x + y). } misela: ['x'] ixabiso: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i eyakho q beka: (eyakho f sebenzisa-ku: (eyakho q ? i)) kwindawo: i. } 
	misela: ['q'] ixabiso: array,
	misela: ['f'] ixabiso: func.
	{ :i mapping sebenzisa-ku: i. } × (array inani-lezinto).
}.

>> a := Uluhlu ← 1; 2; 3.
mapper sebenzisa-ku: a kwaye: (makeAdder sebenzisa-ku: 100).
Imveliso bhala: (a indawo: 0), umgca-omtsha.
Imveliso bhala: (a ? 1), umgca-omtsha.
Imveliso bhala: (a ? 2), umgca-omtsha.
