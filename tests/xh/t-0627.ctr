

# create a 64-bit integer for exact calculations
>> a := Int64 ukusuka-kumbhalo: ['123'].

# to string
Imveliso bhala: a, umgca-omtsha.

# divide
Imveliso bhala: a / (Int64 ukusuka-kumbhalo: ['3']), umgca-omtsha.

# multiply
Imveliso bhala: a * (Int64 ukusuka-kumbhalo: ['2']), umgca-omtsha.

# add
Imveliso bhala: a + (Int64 ukusuka-kumbhalo: ['1']), umgca-omtsha.

# subtract
Imveliso bhala: a - (Int64 ukusuka-kumbhalo: ['2']), umgca-omtsha.

# compare
Imveliso bhala: ( a =   (Int64 ukusuka-kumbhalo: ['123'])), umgca-omtsha.
Imveliso bhala: ( a !=: (Int64 ukusuka-kumbhalo: ['124'])), umgca-omtsha.
Imveliso bhala: ( a <   (Int64 ukusuka-kumbhalo: ['124'])), umgca-omtsha.
Imveliso bhala: ( a >   (Int64 ukusuka-kumbhalo: ['122'])), umgca-omtsha.
Imveliso bhala: ( a >=: (Int64 ukusuka-kumbhalo: ['123'])), umgca-omtsha.
Imveliso bhala: ( a <=: (Int64 ukusuka-kumbhalo: ['123'])), umgca-omtsha.





	