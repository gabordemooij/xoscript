Inani xa-kufika: ['factorial'] yenza: {
	>> total := 1.
	{ :index total phinda-ngo: (ngokwakho - (index)). } × ngokwakho. <- total.
}.
>> Printer := Into entsha.
Printer xa-kufika: ['print:and:'] yenza: { :x :y
	Imveliso bhala: ['a='] + x + [', b='] + y, umgca-omtsha.
}.
>> a := 4.5. >> b := a thoba-inani.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a nyusa-inani.
Printer print: a and: b.
a := 4.5. b := a thoba-inani.
Printer print: a and: b.
a := 4.5. b := a sondeza-inani.
Printer print: a and: b.
a := 4.2. b := a sondeza-inani.
Printer print: a and: b.

Imveliso bhala: (9 intsalela: 5), umgca-omtsha.
Imveliso bhala: -666 ixabiso-elipheleleyo, umgca-omtsha.
Imveliso bhala: 49 ingcambu-yesikwere, umgca-omtsha.
Imveliso bhala: (2 amandla-enani: 3), umgca-omtsha.
>> l := (Uluhlu ← 9 ; 6).
Imveliso bhala: l ubuncinci.

