>> Point := Into entsha.
Point xa-kufika: ['x-coordinate:'] yenza: { :x eyakho x := x. }.
Point xa-kufika: ['y-coordinate:'] yenza: { :y eyakho y := y. }.
Point xa-kufika: ['x-coordinate']  yenza: { <- eyakho x kopa. }.
Point xa-kufika: ['y-coordinate']  yenza: { <- eyakho y kopa. }.

Point xa-kufika: ['='] yenza: { :other <- ( eyakho x = other x-coordinate
		 kwaye: eyakho y = other y-coordinate ).
}.

>> pier := Point entsha x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point entsha x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point entsha x-coordinate: 5, y-coordinate: 6.

Imveliso bhala: pier = town-hall, umgca-omtsha.
Imveliso bhala: pier = restaurant, umgca-omtsha.
