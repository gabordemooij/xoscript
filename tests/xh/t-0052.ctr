>> items := Isichazimagama entsha.
items beka: ['green'] kwindawo: ['color-1'].
items beka: ['orange'] kwindawo: ['color-2'].
items beka: ['red'] kwindawo: ['color-3'].
>> i := 0.
>> s := [''].
items nganye: { :key :color
	Imveliso bhala: ['color #'] + i + [' is: '] + color + [' '].
	i yongeza: 1.
}.
Imveliso bhala: i + [' colors!'].
