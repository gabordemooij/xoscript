>> Greeter := Into entsha.
Greeter xa-kufika: ['make'] yenza: {
	>> gr := Into entsha.
	gr xa-kufika: ['setName:'] yenza: { :aname
		eyakho igama := aname.
	}.
	gr xa-kufika: ['greet'] yenza: {
		Imveliso bhala: eyakho igama.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a entsha.
c setName: ['THREE'].
c greet.
>> d := a entsha.
d setName: ['FOUR'].
d greet.
c greet.
