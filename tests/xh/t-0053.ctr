60 × {
	>> x := (Inani random % 6) + 1.
	(x ≤ 6) ubuxoki: { Imveliso bhala: ['FAIL']. }.
	(x ≥0) ubuxoki: { Imveliso bhala: ['FAIL']. }.
	x := (Inani random % 3) + 1.
	(x < 3) ubuxoki: { Imveliso bhala: ['FAIL']. }.
	(x>-1) ubuxoki: { Imveliso bhala: ['FAIL']. }.
	x := ((Ibhuliyeni flip) inani).
	(x = 0 okanye: x = 1) ubuxoki: { Imveliso bhala: ['FAIL']. }.
	x := ((Inyaniso flip) inani).
	(x = 0 okanye: x = 1) ubuxoki: { Imveliso bhala: ['FAIL']. }.
	x := (Ibhuliyeni flip oku: ['HEAD'] okanye-oko: ['TAIL']).
	((x = ['HEAD']) okanye: (x = ['TAIL'])) ubuxoki: { Imveliso bhala: ['FAIL']. }.
}.
Imveliso bhala: ['DONE'].

