
>> XX := Into entsha.
>> X := Into entsha.

XX xa-kufika: ['QQ'] yenza: { <- 1. }.
XX xa-kufika: ['Q'] yenza: { <- 1. }.
XX xa-kufika: ['QQ:'] yenza: { <- 1. }.
XX xa-kufika: ['QQ:QQ:'] yenza: { <- 1. }.

X xa-kufika: ['QQ'] yenza: { <- 1. }.
X xa-kufika: ['Q'] yenza: { <- 1. }.
X xa-kufika: ['QQ:'] yenza: { <- 1. }.
X xa-kufika: ['QQ:QQ:'] yenza: { <- 1. }.

Imveliso bhala: (Inkqubo XX), umgca-omtsha.
Imveliso bhala: (Inkqubo fumana: ['XX']), umgca-omtsha.
Imveliso bhala: (Inkqubo fumana: ['X']), umgca-omtsha.

Imveliso bhala: (Inkqubo XX: ['QQ']), umgca-omtsha.
Imveliso bhala: (Inkqubo XX: ['Q']), umgca-omtsha.
Imveliso bhala: (Inkqubo XX: ['QQ:']), umgca-omtsha.
Imveliso bhala: (Inkqubo XX: ['QQ:QQ:']), umgca-omtsha.

