# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Ipateni entsha: pattern.
	p ukungqamana: subject yenza: { :m :g
		Imveliso bhala: g inani-lezinto, bhala: [' '], bhala: (g dibanisa: ['|']), umgca-omtsha. <- m.
	}.
}.
show sebenzisa-ku: ['(a)|(b)'] kwaye: ['b'].
show sebenzisa-ku: ['(a)|(b)'] kwaye: ['a'].
show sebenzisa-ku: ['(x)?y'] kwaye: ['y'].
show sebenzisa-ku: ['(x)?(y)(z)?'] kwaye: ['xy'].
