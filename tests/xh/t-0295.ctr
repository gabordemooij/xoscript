
>> dictionary := (
	Isichazimagama entsha
		beka: ['b'] kwindawo: ['a'],
		beka: ['a'] kwindawo: ['b'],
		beka: ['z'] kwindawo: ['x'],
		beka: ['hello'] kwindawo: ['hallo'],
		beka: ['human'] kwindawo: ['human']
).

>> comparisons := Uluhlu entsha.
dictionary nganye: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a thelekisa: b)
	).
}.

comparisons cwangcisa: { :a :b <- ( a thelekisa: b ). }.
Imveliso bhala: ( comparisons dibanisa: ['↵'] ), umgca-omtsha.
comparisons dibanisa: ['↵'].
