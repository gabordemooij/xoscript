>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Into entsha.
⚄ xa-kufika: ['drawFrom:length:'] yenza: { :pool :inani-lezinto
	
	>> result := [''].
	
	{
		>> index := Inani random % (pool ubude).
		result yongeza-ekugqibeleni: ( pool unobumba: (index + 1) ).
		
	} × inani-lezinto. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? ubude.
Imveliso bhala: (['x↵'] x random ubude).
Imveliso bhala: (['y↵'] y ?? ubude).

