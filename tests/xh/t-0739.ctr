Imveliso bhala: ['Test object'], umgca-omtsha.
>> a := Into entsha. 

a xa-kufika: ['item:'] yenza: { :binhelper
	eyakho binhelper := binhelper. 
}.

a xa-kufika: ['item'] yenza: { <- eyakho binhelper.
}.

a item: Bin entsha.

>> old-binhelper-address := a item umzekelo-wokuqala idilesi-yenkumbulo.
a save-as: ['/tmp/a.bin'].
Imveliso bhala: ['========== RELOADING SNAP:'], umgca-omtsha.

>> b := Into load-from: ['/tmp/a.bin'].

(b item umzekelo-wokuqala idilesi-yenkumbulo = old-binhelper-address) inyaniso: {
	Imveliso bhala: ['Object link re-attached.'], umgca-omtsha.
}.


