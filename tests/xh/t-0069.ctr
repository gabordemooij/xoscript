

Umbhalo xa-kufika: ['html'] yenza: { <- (
		ngokwakho
		buyisela: ['&'] nge: ['&amp;'],
		buyisela: ['<'] nge: ['&lt;'],
		buyisela: ['>'] nge: ['&gt;'],
		buyisela: ['"'] nge: ['&quot;']
	).
}.


Imveliso bhala: ([' left trimmed '] sika-izithuba) + [' '] + ( ['and right trimmed'] sika-izithuba) + ['!'], umgca-omtsha.
Imveliso bhala: ['<html>"html & entities"</html>'] html.
