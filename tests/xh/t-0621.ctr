>> phrases := Uluhlu entsha
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases nganye: { :_ :phrase 
	>> e := Server base64-faka-ikhowudi: phrase.
	>> d := Server base64-khupha-ikhowudi: e.
	Imveliso bhala: (
		message kopa ~encoded: e, ~decoded: d
	), umgca-omtsha.
}.
