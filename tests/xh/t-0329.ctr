Imveliso bhala: ((Uluhlu entsha
	xa-kufika: ['plaque:'] yenza: { :x eyakho o := x. },
	xa-kufika: ['plaque']  yenza: { <- eyakho o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Uluhlu ← 1)
	~ (Uluhlu ← 1 ; 2)
	~ (Uluhlu ← 1 ; 2 ; 3)
	~ (Uluhlu ← 1 ; 2 ; 3 ; 4)
	~ (Uluhlu ← 1 ; 2 ; 3 ; 4 ; 5)
) nganye: { :i :el
	{ Imveliso bhala: lo-msebenzi. } × el inani-lezinto.
	Imveliso umgca-omtsha.
}) plaque, umgca-omtsha.


