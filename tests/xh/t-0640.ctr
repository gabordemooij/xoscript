
Server init.
Imveliso bhala: ['Database test'], umgca-omtsha.

>> db := Maria-DB entsha umamkeli: ['localhost'],
	igama-lomsebenzisi: ['xo'], 
	iphasiwedi: ['pass123'],
	igama-ledatabheyisi: ['xobase'],
	qhagamshelana.

>> iiparamitha-zokukhangela :=
db umbuzo: ['SELECT UNHEX('CAFE') AS blobby'],
landa: { :row
	Imveliso bhala: ( row blobby ukusuka: 0 ubude: 2 ), umgca-omtsha.
	row blobby khulula.
}.
