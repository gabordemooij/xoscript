
Inani funda: ['plus:'] kuthetha: ['+'].
Inani xa-kufika: ['+'] yenza: { :x
	>> rate := 1.
	>> currency := x iyunithi-yenani.
	(currency = ['euros']) inyaniso: {
		rate := 2.
	}. <- (ngokwakho plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars iyunithi: ['dollars'].
euros iyunithi: ['euros'].
>> money := dollars + euros.
Imveliso bhala: money, umgca-omtsha.
