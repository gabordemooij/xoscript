# Test ASCII variants

# Numbers

Imveliso bhala: (2 !=: 3), umgca-omtsha.
Imveliso bhala: (2 <=: 2), umgca-omtsha.
Imveliso bhala: (2 >=: 2), umgca-omtsha.

# Strings

Imveliso bhala: (['b'] >=: ['a']), umgca-omtsha.
Imveliso bhala: (['b'] !=: ['a']), umgca-omtsha.
Imveliso bhala: (['b'] <=: ['c']), umgca-omtsha.

# Bools

Imveliso bhala: (Inyaniso !=: Ubuxoki), umgca-omtsha.

# Objects

Imveliso bhala: (Into entsha !=: Into entsha), umgca-omtsha.

# ASCII list symbol <-:

Imveliso bhala: (Uluhlu <<: 1, ; 2 ; 3) inani-lezinto = 3, umgca-omtsha.

