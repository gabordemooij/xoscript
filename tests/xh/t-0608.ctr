
>> Size := Into entsha.
Size xa-kufika: ['is:'] yenza: { :inani
	inani xa-kufika: ['+'] yenza: { :inani
		>> unit := inani iyunithi-yenani.
		>> factor := 1.
		
		unit
		ukuba-kunjalo: ['inch'] yenza: { factor := 0.0833. }. <- ngokwakho + (inani * factor).
	}. <- inani.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Imveliso bhala: plank + edge, umgca-omtsha.
