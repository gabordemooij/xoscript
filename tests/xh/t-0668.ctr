# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob entsha: 8, bytes: (
	Uluhlu entsha ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Imveliso bhala: ( utf16 khupha-ikhowudi: ['utf16le'] ), umgca-omtsha.

utf16 khulula.
>> utf32 := Blob entsha: 13, bytes: (
	Uluhlu entsha ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Imveliso bhala: ( utf32 khupha-ikhowudi: ['utf32be'] ), umgca-omtsha.
utf32 khulula.