# compliance test

# use international numbers

Imveliso bhala: ['1000 -> '].
Imveliso bhala: 1000, umgca-omtsha. #1000

Imveliso bhala: ['1.5 -> '].
Imveliso bhala: 1.5, umgca-omtsha.  #1.5

Imveliso bhala: ['1001.5 -> '].
Imveliso bhala: 1.5 + 1000, umgca-omtsha. #1001.5

# use 0-indexed arrays
>> x := Uluhlu entsha ; 1 ; 2 ; 3.
>> y := Uluhlu entsha ; ['a'] ; ['b'] ; ['c'].

Imveliso bhala: ['1 -> '].
Imveliso bhala: x ? 0, umgca-omtsha. #1

Imveliso bhala: ['1 -> '].
Imveliso bhala: (x kwindawo: 0), umgca-omtsha. #1

Imveliso bhala: ['1 -> '].
Imveliso bhala: x eyokuqala, umgca-omtsha. #1

Imveliso bhala: ['3 -> '].
Imveliso bhala: x eyokugqibela, umgca-omtsha. #3

Imveliso bhala: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Imveliso bhala: (x ngoko: y), umgca-omtsha.

Imveliso bhala: ['1 -> '].
Imveliso bhala: (x ukusuka: 0 ubude: 1) eyokuqala, umgca-omtsha. #1

Imveliso bhala: ['0 -> '].
Imveliso bhala: (x fumana: 1), umgca-omtsha. #0

x beka: 9 kwindawo: 0.

Imveliso bhala: ['9 -> '].
Imveliso bhala: (x kwindawo: 0), umgca-omtsha. #9

x yongeza-ekuqaleni: 8.
Imveliso bhala: ['8 -> '].
Imveliso bhala: (x kwindawo: 0), umgca-omtsha. #9


x yongeza-ekugqibeleni: 10.
Imveliso bhala: ['10 -> '].
Imveliso bhala: (x kwindawo: 4), umgca-omtsha. #10








