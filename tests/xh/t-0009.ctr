>> Greeter := Into entsha.
Greeter xa-kufika: ['make'] yenza: {
	>> greeter := Into entsha.
	greeter xa-kufika: ['name:'] yenza: { :igama
		Imveliso bhala: ['setting a name'].
		eyakho myName := igama.
	}.
	greeter xa-kufika: ['performGreeting'] yenza: {
		Imveliso bhala: ['Hello'].
		Imveliso bhala: eyakho myName.
	}.
	greeter xa-kufika: ['greet'] yenza: {
		ngokwakho performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
