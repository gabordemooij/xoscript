# a value ending in the first part of an opening quote must survive serialization
>> amaxabiso := Uluhlu entsha
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

amaxabiso nganye: { :i :value
	>> d := Isichazimagama entsha.
	d beka: value kwindawo: ['k'].
	d beka: ['second'] kwindawo: ['j'].
	>> r := d ikhowudi into.
	Imveliso bhala: r inani-lezinto, umgca-omtsha.
	Imveliso bhala: ( (r kwindawo: ['k']) = value ), umgca-omtsha.
}.
