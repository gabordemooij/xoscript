
>> city := Uluhlu ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Uluhlu ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature ngoko: city.
>> cities := weather izitshixo cwangcisa: { :a :b <- (a thelekisa: b). }.
>> temperatures := weather amaxabiso cwangcisa: { :a :b <- (a thelekisa: b) ngaphantsi-kukaqanda?. }.

Imveliso bhala: (cities dibanisa: [',']), umgca-omtsha.
Imveliso bhala: (temperatures dibanisa: [',']), umgca-omtsha.
