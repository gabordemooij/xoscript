>> To-Do := Into entsha.

To-Do xa-kufika: ['entsha'] yenza: {
	eyakho list := Uluhlu entsha.
}.

To-Do xa-kufika: ['nieuw'] yenza: {
	eyakho list := Uluhlu entsha.
}.

To-Do xa-kufika: ['+'] yenza: { :task
	eyakho list yongeza-ekugqibeleni: task.
}.

To-Do xa-kufika: ['number of tasks?'] yenza: { <-  eyakho list inani-lezinto.
}.

>> todos := 
	To-Do entsha 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Imveliso bhala: ['You have $ tasks to do'] $ todos number of tasks?.
