Imveliso bhala: ['Test object'], umgca-omtsha.
>> a := Into entsha. 

a xa-kufika: ['item:'] yenza: { :octhelper
	eyakho octhelper := octhelper. 
}.

a xa-kufika: ['item'] yenza: { <- eyakho octhelper.
}.

a item: Oct entsha.

>> old-octhelper-address := a item umzekelo-wokuqala idilesi-yenkumbulo.
a save-as: ['/tmp/a.bin'].
Imveliso bhala: ['========== RELOADING SNAP:'], umgca-omtsha.

>> b := Into load-from: ['/tmp/a.bin'].

(b item umzekelo-wokuqala idilesi-yenkumbulo = old-octhelper-address) inyaniso: {
	Imveliso bhala: ['Object link re-attached.'], umgca-omtsha.
}.
