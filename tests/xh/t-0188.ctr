

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Inkqubo ulawulo-lwenkumbulo: 0.

{ :i Imveliso bhala: i. } × 4.
Imveliso umgca-omtsha.
{ :i Imveliso bhala: (4 - i). } × 4.
Imveliso umgca-omtsha.
( 1 > 2 ) ubuxoki: { Imveliso bhala: ['BLOCK 1'], umgca-omtsha. }.
( 2 > 1 ) inyaniso:  { Imveliso bhala: ['BLOCK 2'], umgca-omtsha. }.

>> i := 0.
{ Imveliso bhala: i. i yongeza: 1. } ngelixa: { <- ( i < 3). }.
Imveliso umgca-omtsha.

i := 3.
{ Imveliso bhala: i. i := i - 1. } ngelixa: { <- ( i > 0). }.
Imveliso umgca-omtsha.


Inkqubo coca.

usedMemory1 := (Inkqubo inkumbulo ? 0).


{ :i  Imveliso bhala: i. } × 4.
Imveliso umgca-omtsha.
{ :i  Imveliso bhala: (4 - i). } × 4.
Imveliso umgca-omtsha.
( 1 > 2 ) ubuxoki: { Imveliso bhala: ['BLOCK 1'], umgca-omtsha. }.
( 2 > 1 ) inyaniso:  { Imveliso bhala: ['BLOCK 2'], umgca-omtsha. }.

>> i := 0.
{ Imveliso bhala: i. i yongeza: 1. } ngelixa: { <- ( i < 3). }.
Imveliso umgca-omtsha.

i := 3.
{ Imveliso bhala: i. i := i - 1. } ngelixa: { <- ( i > 0). }.
Imveliso umgca-omtsha.



Inkqubo coca.
usedMemory2 := (Inkqubo inkumbulo ? 0).


{ :i Imveliso bhala: i. } × 4.
Imveliso umgca-omtsha.
{ :i Imveliso bhala: (4 - i). } × 4.
Imveliso umgca-omtsha.
( 1 > 2 ) ubuxoki: { Imveliso bhala: ['BLOCK 1'], umgca-omtsha. }.
( 2 > 1 ) inyaniso:  { Imveliso bhala: ['BLOCK 2'], umgca-omtsha. }.

>> i := 0.
{ Imveliso bhala: i. i yongeza: 1. } ngelixa: { <- ( i < 3). }.
Imveliso umgca-omtsha.

i := 3.
{ Imveliso bhala: i. i := i - 1. } ngelixa: { <- ( i > 0). }.
Imveliso umgca-omtsha.

Inkqubo coca.
usedMemory3 := (Inkqubo inkumbulo ? 0).



( usedMemory1 = usedMemory2 kwaye: usedMemory1 = usedMemory3, kwaye: usedMemory2 = usedMemory3 ) inyaniso: {
	Imveliso bhala: ['No memory leaks here'].
}, ubuxoki: {
	Imveliso bhala: ['Leaking memory...'].
}.
