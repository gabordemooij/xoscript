
>> Rectangle := Into entsha.

Rectangle xa-kufika: ['area'] yenza: { <- eyakho ubude * eyakho width.
}.

Rectangle xa-kufika: ['length:'] yenza: { :ubude
	eyakho ubude := ubude.
}.

Rectangle xa-kufika: ['width:'] yenza: { :width
	eyakho width := width.
}.

Rectangle xa-kufika: ['entsha'] yenza: {
	# this will not result into an infinite loop
	>> rectangle := ngokwakho entsha.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle entsha.
Imveliso bhala: a area, umgca-omtsha. #0

>> b := Rectangle entsha length: 2, width: 3.
Imveliso bhala: b area, umgca-omtsha. #6

