Imveliso bhala: ['1,2,3,4,5,6,7,8,9,A,'], umgca-omtsha.
>> Scope := Into entsha.
Scope xa-kufika: ['initialize:'] yenza: { :x eyakho property := x. }.
Scope xa-kufika: ['confirm'] yenza: { Imveliso bhala: [',']. }.
Scope xa-kufika: ['uvavanyo'] yenza: {
	Imveliso bhala: eyakho property.
	ngokwakho confirm.
	( 1 = 1 ) inyaniso: { Imveliso bhala: eyakho property. ngokwakho confirm. }.
	( 1 = 0 ) ubuxoki: { Imveliso bhala: eyakho property. ngokwakho confirm. }.
	>> y := 2. { Imveliso bhala: eyakho property. ngokwakho confirm. } ngelixa: { y thabatha: 1. <- (y > 0). }.
	{ Imveliso bhala: eyakho property. ngokwakho confirm. } × 1.
	(Uluhlu ← 1) nganye: {  Imveliso bhala: eyakho property. ngokwakho confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Isichazimagama entsha one: ['item']) nganye: { Imveliso bhala: eyakho property. ngokwakho confirm. }.
	{ 1 ÷ 0. } bamba: { Imveliso bhala: eyakho property. ngokwakho confirm. }, qala.
	Imveliso umgca-omtsha.
}.
>> scope1 := Scope entsha.
scope1 initialize: ['X'].
scope1 uvavanyo.
>> function := { 
	eyakho property := ['Y'].
	Imveliso bhala: eyakho property.
	ngokwakho confirm.
	( 1 = 1 ) inyaniso: { Imveliso bhala: eyakho property. ngokwakho confirm. }.
	( 1 = 0 ) ubuxoki: { Imveliso bhala: eyakho property. ngokwakho confirm. }.
	>> y := 2. { Imveliso bhala: eyakho property. ngokwakho confirm. } ngelixa: { y thabatha: 1. <- (y > 0). }.
	{ Imveliso bhala: eyakho property. ngokwakho confirm. } × 1.
	(Uluhlu ← 1) nganye: {  Imveliso bhala: eyakho property. ngokwakho confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Isichazimagama entsha one: ['item']) nganye: { Imveliso bhala: eyakho property. ngokwakho confirm. }.
	{ 1 ÷ 0. } bamba: { Imveliso bhala: eyakho property. ngokwakho confirm. }, qala.
	Imveliso umgca-omtsha.
}.
function xa-kufika: ['confirm'] yenza: { Imveliso bhala: [',']. }.
function sebenzisa-ku: 1 kwaye: 2.
