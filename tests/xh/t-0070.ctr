>> numbers := ['1,2,3'] yahlula: [','].
Imveliso bhala: ['I got: '] + numbers inani-lezinto + [' numbers.'],umgca-omtsha.
{ :i Imveliso bhala: ['number #'] + i + [':'] + (numbers indawo: i), umgca-omtsha.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages yahlula: [' Or '].
Imveliso bhala: ['We serve'], umgca-omtsha.
{ :i Imveliso bhala: ['->'] + (beverages indawo: i), umgca-omtsha. } × (beverages inani-lezinto).
Imveliso bhala: (beverages dibanisa: [',']), umgca-omtsha.
Imveliso bhala: (numbers dibanisa: ['||']).
