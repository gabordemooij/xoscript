# test number -> string -> number
{

	>> x := Inani phakathi: 0 kunye: 1000000.
	>> d := Inani phakathi: 1 kunye: 7.
	>> e := 10 amandla-enani: d.

	x yahlula-ngo: e.
	>> y := x umbhalo inani.

	(x = y) ubuxoki: {
		Imveliso bhala: x, umgca-omtsha.
		Imveliso bhala: y, umgca-omtsha.
		Inkqubo gqiba.
	}.

} * 1000.
Imveliso bhala: ['OK'], umgca-omtsha.