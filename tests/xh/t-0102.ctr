
>> motive := Ubuxoki.
>> opportunity := Ubuxoki.
Imveliso bhala: (motive akukho-zombini: opportunity).
Imveliso bhala: (motive hayi & opportunity hayi).

Imveliso bhala: (Inyaniso = Inyaniso).
Imveliso bhala: (Inyaniso ≠ Inyaniso).
Imveliso bhala: (Inyaniso ≠ Ubuxoki).
Imveliso bhala: (Inyaniso = Ubuxoki).
