
Server init.
>> rq := Isicelo-HTTP entsha.
Imveliso bhala: ['HTTP-GET d[]=']  + ( rq get-uluhlu: ['d[]'] ), umgca-omtsha. # GET
Imveliso bhala: ['HTTP-GET f[]=']  + ( rq get-uluhlu: ['f[]'] ), umgca-omtsha. # GET
Imveliso bhala: ['HTTP-POST e[]='] + ( rq post-uluhlu: ['e[]'] ), umgca-omtsha. # GET
Imveliso bhala: ['HTTP-POST c=']   + ( rq post: ['c'] ), umgca-omtsha. # GET
Imveliso bhala: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), umgca-omtsha. # GET
