


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Inkqubo ulawulo-lwenkumbulo: 0.
>> palette := Engenanto.
>> colors := Engenanto.

{
palette := Isichazimagama entsha.
palette 
	beka: ['#F00'] kwindawo: ['red'],
	beka: ['#0F0'] kwindawo: ['green'],
	beka: ['#00F'] kwindawo: ['blue'].
Imveliso bhala: ['number of RGB codes in palette: '] + ( palette inani-lezinto ), umgca-omtsha.
Imveliso bhala: ['RGB code of green is: '] + ( palette ? ['green'] ), umgca-omtsha.
colors := [''].
( palette nganye: { :igama :ikhowudi
		colors := colors + ( igama + [':'] + ikhowudi ).
} ).
Imveliso bhala: ['All colors in palette: '] + colors, umgca-omtsha.
} qala.
Inkqubo coca.
usedMemory1 := (Inkqubo inkumbulo ? 0).

