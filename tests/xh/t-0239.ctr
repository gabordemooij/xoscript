Uluhlu xa-kufika: ['sum'] yenza: {
	>> total := 0.
	ngokwakho nganye: { :index :element
		total yongeza: element.
	}. <- total.
}.

>> a := Inyaniso.



a xa-kufika: ['umbhalo'] yenza: {
	>> answer := Engenanto.
	( ngokwakho = Inyaniso ) inyaniso: {
		answer := ['Yep'].
	}, kungenjalo: {
		answer := ['Nope'].
	}. <- answer.
}.

a xa-kufika: ['inani'] yenza: {
	>> answer := Engenanto.
	( ngokwakho = Inyaniso ) inyaniso: {
		answer := 10.
	}, kungenjalo: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b xa-kufika: ['umbhalo'] yenza: { <- ['Devil'].
}.

b xa-kufika: ['ibhuliyeni'] yenza: { <- Ubuxoki.
}.


Imveliso bhala: a, umgca-omtsha.  
Imveliso bhala: (90 + a), umgca-omtsha. 
Imveliso bhala: b, umgca-omtsha. 
Imveliso bhala: (Inyaniso kwaye: b), umgca-omtsha.

a := Uluhlu ← ['hello'] ; ['world'] ; Inyaniso ; Engenanto ; 666. 
a := a + ( Uluhlu ← 1 ).
Imveliso bhala: a, umgca-omtsha.
Imveliso bhala: ((Isichazimagama entsha) beka: Engenanto kwindawo: Engenanto), umgca-omtsha.
Imveliso bhala: a sum, umgca-omtsha. 


{
	a xa-kufika: ['umbhalo'] yenza: { <- Engenanto. }.
	a := [''] + a.
} bamba: { :error
	Imveliso bhala: ['Error noted: '] + error, umgca-omtsha.
}, qala.



{
	a xa-kufika: ['inani'] yenza: { <- Engenanto. }.
	a := 3 × a.
} bamba: { :error
	Imveliso bhala: ['Error noted: '] + error, umgca-omtsha.
}, qala.


{
	a xa-kufika: ['ibhuliyeni'] yenza: { <- Engenanto. }.
	a := Inyaniso kwaye: a. 
} bamba: { :error
	Imveliso bhala: ['Error noted: '] + error, umgca-omtsha.
}, qala.





{
	a xa-kufika: ['umbhalo'] yenza: { <- Ubuxoki. }.
	a := [''] + a.
} bamba: { :error
	Imveliso bhala: ['Error noted: '] + error, umgca-omtsha.
}, qala.



{
	a xa-kufika: ['inani'] yenza: { <- Inyaniso. }.
	a := 3 × a.
} bamba: { :error
	Imveliso bhala: ['Error noted: '] + error, umgca-omtsha.
}, qala.


{
	a xa-kufika: ['boolean'] yenza: { <- 1. }.
	a := Inyaniso kwaye: a.
} bamba: { :error
	Imveliso bhala: ['Error noted: '] + error, umgca-omtsha.
}, qala.





