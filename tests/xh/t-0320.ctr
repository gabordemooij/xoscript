


>> CoffeeMachine := Into entsha.
CoffeeMachine xa-kufika: ['order:'] yenza: { :id
	>> coffee := ['Americano'].
	( id = 1 ) inyaniso: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) inyaniso: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) inyaniso: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Into entsha.
SimpleCoffeeMachine xa-kufika: ['order'] yenza: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Imveliso bhala: redCup, umgca-omtsha.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Imveliso bhala: greenCup, umgca-omtsha.
>> yellowCup := CoffeeMachine order: 1.
Imveliso bhala: yellowCup, umgca-omtsha.
>> blueCup := CoffeeMachine order: 0.
Imveliso bhala: blueCup, umgca-omtsha.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Imveliso bhala: blackCup, umgca-omtsha.
blackCup yongeza-ekugqibeleni: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Imveliso bhala: orangeCup, umgca-omtsha.
