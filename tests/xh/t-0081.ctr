>> map1 := Isichazimagama entsha.
>> key1 := Uluhlu entsha.
>> key2 := Uluhlu entsha.

map1
	beka: ['hello'] kwindawo: key1,
	beka: ['world'] kwindawo: key2.


Imveliso
	bhala: ['Map #1 contains: '] + (map1 kwindawo: key1),
	bhala: [' and '] + (map1 kwindawo: key2), umgca-omtsha.

>> KeyeableArray := Uluhlu entsha.
KeyeableArray xa-kufika: ['toString'] yenza: { <- (ngokwakho inani-lezinto) toString.
}.

>> map2 := Isichazimagama entsha.
key1 := KeyeableArray entsha.
key2 := KeyeableArray entsha.

key1 yongeza-ekugqibeleni: 1.

map2
	beka: ['hello'] kwindawo: key1,
	beka: ['world'] kwindawo: key2.

Imveliso
	bhala: ['Map #2 contains: '] + (map2 kwindawo: key1),
	bhala: [' and '] + (map2 kwindawo: key2), umgca-omtsha.
