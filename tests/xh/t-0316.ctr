>> Grandfather := Into entsha.
Grandfather xa-kufika: ['greet'] yenza: {
	Imveliso bhala: ['Ave!'], umgca-omtsha.
}.
>> Father := Grandfather entsha.
Father xa-kufika: ['greet'] yenza: {
	Imveliso bhala: ['Hello'], umgca-omtsha.
	ngokwakho greet.
}.
>> Son := Father entsha.
Son xa-kufika: ['greet'] yenza: {
	Imveliso bhala: ['Hi'], umgca-omtsha.
	ngokwakho greet.
}.

Son greet.

>> Roundabout := Into entsha.
Roundabout xa-kufika: ['circle:'] yenza: { :x
	Imveliso bhala: x, umgca-omtsha.
	(x < 3) inyaniso: { ngokwakho ephindayo circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) inyaniso: { Imveliso bhala: x, umgca-omtsha. x yongeza: 1.  increment qala. }. }.
increment qala.