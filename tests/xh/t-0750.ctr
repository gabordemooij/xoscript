Imveliso bhala: ['Test object'], umgca-omtsha.
>> a := Into entsha. 

a xa-kufika: ['item:'] yenza: { :nil
	eyakho nil := nil. 
}.

a xa-kufika: ['item'] yenza: { <- eyakho nil.
}.

a item: Engenanto.

Imveliso bhala: a item, umgca-omtsha.

>> old-nil-address := a item umzekelo-wokuqala idilesi-yenkumbulo.
a save-as: ['/tmp/a.bin'].
Imveliso bhala: ['========== RELOADING SNAP:'], umgca-omtsha.

>> b := Into load-from: ['/tmp/a.bin'].

(b item umzekelo-wokuqala idilesi-yenkumbulo = old-nil-address) inyaniso: {
	Imveliso bhala: ['Object link re-attached.'], umgca-omtsha.
}.

Imveliso bhala: b item, umgca-omtsha.
