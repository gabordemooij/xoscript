Imveliso bhala: ['Test object'], umgca-omtsha.
>> a := Into entsha. 

a xa-kufika: ['item:'] yenza: { :ibhuliyeni
	eyakho ibhuliyeni := ibhuliyeni. 
}.

a xa-kufika: ['item'] yenza: { <- eyakho ibhuliyeni.
}.

a item: Ibhuliyeni.

Imveliso bhala: a item, umgca-omtsha.

>> old-bool-address := a item umzekelo-wokuqala idilesi-yenkumbulo.
a save-as: ['/tmp/a.bin'].
Imveliso bhala: ['========== RELOADING SNAP:'], umgca-omtsha.

>> b := Into load-from: ['/tmp/a.bin'].

(b item umzekelo-wokuqala idilesi-yenkumbulo = old-bool-address) inyaniso: {
	Imveliso bhala: ['Object link re-attached.'], umgca-omtsha.
}.

Imveliso bhala: b item, umgca-omtsha.
