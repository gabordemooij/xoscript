# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Isisefu yenza-izitshixo.

# private (secret) key
>> sk := keys eyokuqala.

# public key
>> pk := keys eyokugqibela.

# sign a message
>> sig := Isisefu tyikitya: ['abc'] nge: sk.

# check message (ok)
Imveliso bhala: ( 
	Isisefu
		hlola: ['abc'] 
		utyikityo: sig 
		nge: pk 
), umgca-omtsha.

# check message (fail)
Imveliso bhala: ( 
	Isisefu 
		hlola: ['abd'] 
		utyikityo: sig 
		nge: pk 
), umgca-omtsha.