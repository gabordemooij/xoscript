
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> ikhowudi := {
	>> o := (
		Isichazimagama entsha
		aa: (Uluhlu ← 1 ; 2),
		bb: (Uluhlu ← 3 ; 4)
	).
	>> s := o umbhalo.
	>> o2 := s into.
	(s  uhlobo = Umbhalo uhlobo) inyaniso: { Imveliso bhala: ['OK1'], umgca-omtsha. }.
	(o2 uhlobo = Isichazimagama uhlobo) inyaniso: { Imveliso bhala: ['OK2'], umgca-omtsha. }.
}.

Inkqubo ulawulo-lwenkumbulo: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Inkqubo coca.
usedMemory1 := (Inkqubo inkumbulo ? 1).
ikhowudi qala.
Inkqubo coca.
usedMemory2 := (Inkqubo inkumbulo ? 1).
ikhowudi qala.
Inkqubo coca.
usedMemory3 := (Inkqubo inkumbulo ? 1).
ikhowudi qala.
Inkqubo coca.
usedMemory4 := (Inkqubo inkumbulo ? 1).

(usedMemory2 = usedMemory3 = usedMemory4) inyaniso: { Imveliso bhala: ['OK3'], umgca-omtsha. }.
 
