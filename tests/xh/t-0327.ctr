

Uluhlu xa-kufika: ['fixture:'] yenza: { :f
	eyakho fixture := f.
}.

Uluhlu xa-kufika: ['inani-lezinto'] yenza: { <- eyakho fixture.
}.

Uluhlu xa-kufika: ['aantal'] yenza: { <- eyakho fixture.
}.


>> x := Engenanto.
{

	x := ['hello'] 
	buyisela:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] unobumba: 2)
			)
		)
	nge: (
		(['...hal'] + ['lo']) 
			oonobumba-abakhulu 
			lowecase 
			oonobumba-abakhulu 
			tsiba: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Uluhlu ← 0 ; 1 ; 4; 9 ; (Uluhlu ← 0 ; 3; 1) ; 4
							) phambi-kweyokugqibela
						) ? 1
					) + 
					((Uluhlu ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					inani-lezinto
				)
			)
	).

} × 10.
Imveliso bhala: x, umgca-omtsha.

