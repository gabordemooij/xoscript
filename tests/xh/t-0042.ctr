>> items := Isichazimagama entsha.
items beka: ['black'] kwindawo: ['coffee'], beka: ['earl grey'] kwindawo: ['tea'].
Imveliso bhala: (items kwindawo: ['coffee']), bhala: (items kwindawo: ['tea']).
Imveliso bhala: ['there are'] + items inani-lezinto + [' items in the array.'].
items beka: ['capuccino'] kwindawo: ['coffee'].
Imveliso bhala: ['Now my coffee is.. '] + (items kwindawo: ['coffee']).
items beka: ['aaa'] kwindawo: ['1'].
items beka: ['bbb'] kwindawo: ['2'].
Imveliso bhala: (items kwindawo: ['a']).
