

Uluhlu xa-kufika: ['column:'] yenza: { :column
	>> result := Uluhlu entsha.
	ngokwakho nganye: { :index :row
		row nganye: { :index :cell
			(index = column) inyaniso: { result yongeza-ekugqibeleni: cell. }.
		}.
	}. <- result.
}.


>> a := Uluhlu ←
	(Uluhlu ← 1 ; 2 ; 3) ;
	(Uluhlu ← 4 ; 5 ; 6) ;
	(Uluhlu ← 7 ; 8 ; 9).

>> b := a column: 1.
Imveliso bhala: b, umgca-omtsha.

b := a column: 20.
Imveliso bhala: b, umgca-omtsha.

b := a column: -100.
Imveliso bhala: b, umgca-omtsha.
