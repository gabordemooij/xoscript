>> randomizer := { :a :b
	>> ubuncinci := ( a < b ) oku: a okanye-oko: b.
	>> ubuninzi := ( a > b ) oku: a okanye-oko: b.
	>> x := Engenanto.
	{
		x := Inani phakathi: a kunye: b.
		((x < ubuncinci) okanye: (x > ubuninzi)) inyaniso: { 
			Imveliso bhala: (['Invalid value!']).
			Inkqubo gqiba.
		}.
	} 
	× 100. <- x.
}.
randomizer sebenzisa-ku: 0 kwaye: 0.
randomizer sebenzisa-ku: 1 kwaye: 0.
randomizer sebenzisa-ku: 1 kwaye: 1.
randomizer sebenzisa-ku: 0 kwaye: 1.
