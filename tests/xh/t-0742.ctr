Imveliso bhala: ['Test object'], umgca-omtsha.
>> a := Into entsha. 

a xa-kufika: ['item:'] yenza: { :hexhelper
	eyakho hexhelper := hexhelper. 
}.

a xa-kufika: ['item'] yenza: { <- eyakho hexhelper.
}.

a item: Hx entsha.

>> old-hexhelper-address := a item umzekelo-wokuqala idilesi-yenkumbulo.
a save-as: ['/tmp/a.bin'].
Imveliso bhala: ['========== RELOADING SNAP:'], umgca-omtsha.

>> b := Into load-from: ['/tmp/a.bin'].

(b item umzekelo-wokuqala idilesi-yenkumbulo = old-hexhelper-address) inyaniso: {
	Imveliso bhala: ['Object link re-attached.'], umgca-omtsha.
}.
