# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Isisefu 
	ihashi-lephasiwedi: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Isisefu 
	ihashi-lephasiwedi: hash qinisekisa: a1.
	# fail 
>> b := Isisefu
	ihashi-lephasiwedi: hash qinisekisa: a2.
	# ok!

Imveliso bhala: a, umgca-omtsha.
Imveliso bhala: b, umgca-omtsha.

