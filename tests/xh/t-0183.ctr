

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Inkqubo ulawulo-lwenkumbulo: 0.

>> o := Into entsha.
>> o2 := Into entsha.
Imveliso bhala: o Engenanto?, umgca-omtsha.
Imveliso bhala: o uhlobo, umgca-omtsha.
Imveliso bhala: ( o iyafana: o ), umgca-omtsha.
Imveliso bhala: ( o iyafana: o2 ), umgca-omtsha.
Imveliso bhala: o mna-ngokwam, umgca-omtsha.
Imveliso bhala: ( o yenza yenziwe ), umgca-omtsha.

Inkqubo coca.

usedMemory1 := (Inkqubo inkumbulo ? 0).


o := Into entsha.
o2 := Into entsha.
Imveliso bhala: o Engenanto?, umgca-omtsha.
Imveliso bhala: o uhlobo, umgca-omtsha.
Imveliso bhala: ( o iyafana: o ), umgca-omtsha.
Imveliso bhala: ( o iyafana: o2 ), umgca-omtsha.
Imveliso bhala: o mna-ngokwam, umgca-omtsha.
Imveliso bhala: ( o yenza yenziwe ), umgca-omtsha.

Inkqubo coca.
usedMemory2 := (Inkqubo inkumbulo ? 0).


o := Into entsha.
o2 := Into entsha.
Imveliso bhala: o Engenanto?, umgca-omtsha.
Imveliso bhala: o uhlobo, umgca-omtsha.
Imveliso bhala: ( o iyafana: o ), umgca-omtsha.
Imveliso bhala: ( o iyafana: o2 ), umgca-omtsha.
Imveliso bhala: o mna-ngokwam, umgca-omtsha.
Imveliso bhala: ( o yenza yenziwe ), umgca-omtsha.

Inkqubo coca.
usedMemory3 := (Inkqubo inkumbulo ? 0).



( usedMemory1 = usedMemory2 kwaye: usedMemory1 = usedMemory3, kwaye: usedMemory2 = usedMemory3 ) inyaniso: {
	Imveliso bhala: ['No memory leaks here'].
}, ubuxoki: {
	Imveliso bhala: ['Leaking memory...'].
}.
