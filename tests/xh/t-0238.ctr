Umbhalo xa-kufika: ['evaluate'] yenza: {
	>> ikhowudi := Ifayile entsha: ['/tmp/eval.ctr'].
	ikhowudi bhala: (ngokwakho umbhalo + ['.']).
	Inkqubo sebenzisa: ['/tmp/eval.ctr'].
}.

>> a := Uluhlu ← 1 ; 2 ; 3.
>> b := (a umbhalo).

Imveliso bhala: b, umgca-omtsha. 
(['b := '] + b) evaluate.

Imveliso bhala: b ? 2, umgca-omtsha. 

Imveliso bhala: (( Uluhlu ← 1 ; 2 ; 3 )), umgca-omtsha. 

Imveliso bhala: ((Isichazimagama entsha) beka: 1 kwindawo: 2), umgca-omtsha. 

>> x := ( (Uluhlu ← 1 ; ( Uluhlu ← 9 ) ; Inyaniso ) ) umbhalo.
Imveliso bhala: x, umgca-omtsha. 
(['x := '] + x) evaluate.

Imveliso bhala: x ? 1 ? 0, umgca-omtsha. 

>> y := (Isichazimagama entsha) beka: (Uluhlu ← 1) kwindawo: (Uluhlu ← 2).
Imveliso bhala: y, umgca-omtsha. 

(['y := '] + y) umbhalo evaluate.

Imveliso bhala: (y kwindawo: (Uluhlu ← 2) umbhalo ), umgca-omtsha.

Imveliso bhala: (Uluhlu entsha), umgca-omtsha. 
Imveliso bhala: (Isichazimagama entsha), umgca-omtsha. 
