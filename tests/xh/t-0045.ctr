Inkqubo ulawulo-lwenkumbulo: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } bamba: {
		oops yongeza: 1.
	}, qala.
} × 1000.

{
	Imveliso bhala: ['hi there!'].
	lo-msebenzi impazamo: ['oops'].
	Imveliso bhala: ['hi there!'].
	{ Imveliso bhala: ['dont print this']. } qala.
} bamba: { :e 
	Imveliso bhala: ['got ya!']. 
	Imveliso bhala: e.
}, qala.
