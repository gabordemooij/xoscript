>> invoice := Into entsha.
invoice xa-kufika: ['qala'] yenza: {
        eyakho inani := 0.
}.

invoice xa-kufika: ['inani'] yenza: {
        eyakho inani yongeza: 1. <- eyakho inani kopa.
}.

>> year-invoice := invoice entsha.
year-invoice xa-kufika: ['start:'] yenza: { :unyaka
	eyakho inani := unyaka.
}.

year-invoice start: 202000.
Imveliso bhala: year-invoice inani, umgca-omtsha.
Imveliso bhala: year-invoice inani, umgca-omtsha.
