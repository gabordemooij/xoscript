Imveliso bhala: ['Test object'], umgca-omtsha.
>> a := Into entsha. 
a xa-kufika: ['item:'] yenza: { :int64
	eyakho int64 := int64. 
}.
a xa-kufika: ['item'] yenza: { <- eyakho int64.
}.
a item: ( Int64 ukusuka-kumbhalo: ['9999'] ).
Imveliso bhala: a item, umgca-omtsha.
>> old-int64-address := a item umzekelo-wokuqala idilesi-yenkumbulo.
a save-as: ['/tmp/a.bin'].
Imveliso bhala: ['========== RELOADING SNAP:'], umgca-omtsha.
>> b := Into load-from: ['/tmp/a.bin'].
(b item umzekelo-wokuqala idilesi-yenkumbulo = old-int64-address) inyaniso: {
	Imveliso bhala: ['Object link re-attached.'], umgca-omtsha.
}.
Imveliso bhala: ( b item ), umgca-omtsha.
