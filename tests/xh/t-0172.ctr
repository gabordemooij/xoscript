

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Inkqubo ulawulo-lwenkumbulo: 0.

>> a := Uluhlu ← ['hello'] ; ['world'] ; Inyaniso ; Engenanto ; 666.
>> b := a ukusuka: 2 ubude: 2.
Imveliso bhala: ( b dibanisa: ['|'] ), bhala: b inani-lezinto.

Inkqubo coca.
usedMemory1 := (Inkqubo inkumbulo ? 0).


a := Uluhlu ← ['hello'] ; ['world'] ; Inyaniso ; Engenanto ; 666.
b := a ukusuka: 2 ubude: 2.
Imveliso bhala: ( b dibanisa: ['|'] ), bhala: b inani-lezinto.


Inkqubo coca.
usedMemory2 := (Inkqubo inkumbulo ? 0).


a := Uluhlu ← ['hello'] ; ['world'] ; Inyaniso ; Engenanto ; 666.
b := a ukusuka: 2 ubude: 2.
Imveliso bhala: ( b dibanisa: ['|'] ), bhala: b inani-lezinto.


Inkqubo coca.
usedMemory3 := (Inkqubo inkumbulo ? 0).



( usedMemory1 = usedMemory2 kwaye: usedMemory1 = usedMemory3, kwaye: usedMemory2 = usedMemory3 ) inyaniso: {
	Imveliso bhala: ['No memory leaks here'].
}, ubuxoki: {
	Imveliso bhala: ['Leaking memory...'].
}.
