Imveliso bhala: ['Test object'], umgca-omtsha.
>> a := Into entsha. 

a xa-kufika: ['item:'] yenza: { :out
	eyakho out := out. 
}.

a xa-kufika: ['item'] yenza: { <- eyakho out.
}.

a xa-kufika: ['greet'] yenza: {
	Imveliso bhala: ['hi from original out!'], umgca-omtsha.
}.

a item: Imveliso.

Imveliso bhala: a item, umgca-omtsha.

>> old-out-address := a item umzekelo-wokuqala idilesi-yenkumbulo.
a save-as: ['/tmp/a.bin'].
Imveliso bhala: ['========== RELOADING SNAP:'], umgca-omtsha.

>> b := Into load-from: ['/tmp/a.bin'].

(b item umzekelo-wokuqala idilesi-yenkumbulo = old-out-address) inyaniso: {
	Imveliso bhala: ['Object link re-attached.'], umgca-omtsha.
}.

b item bhala: ['hello from loaded out!'], umgca-omtsha.
b greet.
