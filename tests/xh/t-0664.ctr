# recursive interpolation not allowed

Imveliso bhala: 
['recursive string interolation enabled: '] + (
	Inkqubo uphawu: 
	['RECURSIVE_STRINTPOL']
), umgca-omtsha.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Imveliso bhala: a, umgca-omtsha.


Inkqubo uphawu: ['RECURSIVE_STRINTPOL'] vula: Inyaniso.

