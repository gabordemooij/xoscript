Imveliso bhala: ['Test object'], umgca-omtsha.
>> l := Uluhlu entsha ; 1 ; ( Uluhlu entsha ; (Ixesha entsha: 1) ; (Int64 ukusuka-kumbhalo: ['321']) ; (Uluhlu entsha ; 3)).
Imveliso bhala: l, umgca-omtsha.
>> old-lst-address := l umzekelo-wokuqala idilesi-yenkumbulo.
l save-as: ['/tmp/a.bin'].
Imveliso bhala: ['========== RELOADING SNAP:'], umgca-omtsha.
>> b := Into load-from: ['/tmp/a.bin'].
(b umzekelo-wokuqala idilesi-yenkumbulo = old-lst-address) inyaniso: {
	Imveliso bhala: ['Object link re-attached.'], umgca-omtsha.
}.
Imveliso bhala: b, umgca-omtsha.
