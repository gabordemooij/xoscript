# test qualifiers

>> $ := Into entsha.

$ xa-kufika: ['phendula:'] yenza: { :x
	
	>> operation := x unobumba: 0.
	>> valuta := x unobumba: 1.
	>> money := x tsiba: 2.
	
	>> amount := 0.

	( operation = ['+'] ) inyaniso: {
		( valuta = ['£'] ) inyaniso: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Imveliso bhala: x, umgca-omtsha.


>> Fruit := Into entsha.

Fruit xa-kufika: ['entsha'] yenza: {
	>> f := ngokwakho entsha.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit xa-kufika: ['apples:'] yenza: { :a eyakho apples := a. }.
Fruit xa-kufika: ['oranges:'] yenza: { :p eyakho oranges := p. }.
Fruit xa-kufika: ['apples'] yenza: { <- eyakho apples. }.
Fruit xa-kufika: ['oranges'] yenza: { <- eyakho oranges. }.

Fruit xa-kufika: ['+'] yenza: { :f
	
	>> n := Fruit entsha.
	f yongeza: 1.
	
	n apples: (f apples + eyakho apples).
	n oranges:  (f oranges  + eyakho oranges). <- n.
}.

Fruit xa-kufika: ['umbhalo'] yenza: { <- ( eyakho apples umbhalo + [' apples and '] + eyakho oranges + [' oranges'] ).
}.

Inani xa-kufika: ['apples'] yenza: { <- ((Fruit entsha) apples: ngokwakho).
}.

Inani xa-kufika: ['apple'] yenza: { <- ((Fruit entsha) apples: ngokwakho).
}.

Inani xa-kufika: ['oranges'] yenza: { <- ((Fruit entsha) oranges: ngokwakho).
}.




Imveliso bhala: (1 apple + 3 oranges + 4 apples), umgca-omtsha.


Umbhalo xa-kufika: ['twice'] yenza: { <- ((ngokwakho umbhalo) + (ngokwakho umbhalo)).
}.



Imveliso bhala: ['❤❤❤'] twice.



