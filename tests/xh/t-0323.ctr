

Inkqubo coca.


>> Veggy := Into entsha.
Veggy xa-kufika: ['entsha'] yenza: {
	>> v := ngokwakho entsha.
	v init. <- v.
}.

Veggy xa-kufika: ['init'] yenza: { eyakho veggies := 0. }.

Veggy xa-kufika: ['carrots:'] yenza: { :a eyakho veggies := a. <- Engenanto. }.
Veggy xa-kufika: ['carrots'] yenza: { <- eyakho veggies. }.
Veggy xa-kufika: ['+'] yenza: { :f
	>> n := Veggy entsha.
	n carrots: (f carrots + eyakho veggies). <- n.
}.

Veggy xa-kufika: ['umbhalo'] yenza: { <- eyakho veggies umbhalo.
}.

Inani xa-kufika: ['carrots'] yenza: {
	>> x := Veggy entsha.
	x carrots: ngokwakho. <- x.
}.

Inani xa-kufika: ['add:and:'] yenza: { :a :b <- (a + b).
}.

>> q := 0 add: (3 carrots + 2 carrots) and: 4 carrots.
Imveliso bhala: q, umgca-omtsha.
