#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Inkqubo ulawulo-lwenkumbulo: 0.

{
Ixesha ixesha.
Ixesha linda: 1.
Imveliso bhala: Inkqubo inani-lezifakwa, umgca-omtsha.
Inkqubo isifakwa: 0.
Inani random.
Imveliso bhala: (Inkqubo isixokelelwano: ['echo 'Hello'']).
} qala.

Inkqubo coca.
usedMemory1 := (Inkqubo inkumbulo ? 0).

{
Ixesha ixesha.
Ixesha linda: 1.
Imveliso bhala: Inkqubo inani-lezifakwa, umgca-omtsha.
Inkqubo isifakwa: 0.
Inani random.
Imveliso bhala: (Inkqubo isixokelelwano: ['echo 'Hello'']).
} qala.

Inkqubo coca.
usedMemory2 := (Inkqubo inkumbulo ? 0).

{
Ixesha ixesha.
Ixesha linda: 1.
Imveliso bhala: Inkqubo inani-lezifakwa, umgca-omtsha.
Inkqubo isifakwa: 0.
Inani random.
Imveliso bhala: (Inkqubo isixokelelwano: ['echo 'Hello'']).
} qala.

Inkqubo coca.
usedMemory3 := (Inkqubo inkumbulo ? 0).



( usedMemory1 = usedMemory2 kwaye: usedMemory1 = usedMemory3, kwaye: usedMemory2 = usedMemory3 ) inyaniso: {
	Imveliso bhala: ['No memory leaks here'].
}, ubuxoki: {
	Imveliso bhala: ['Leaking memory...'].
}.
