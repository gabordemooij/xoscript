Ibhuliyeni xa-kufika: ['xor:'] yenza: { :a :b <- ((a kwaye: b hayi) okanye: (a hayi kwaye: b)).
}.

>> o := Into entsha.
o xa-kufika: ['hello'] yenza: { ['Empty']. }.
{ o xa-kufika: 2 yenza: 3.} bamba: { :e Imveliso bhala: e, umgca-omtsha. }, qala.
{ o xa-kufika: ['uvavanyo'] yenza: 3.} bamba: { :e Imveliso bhala: e, umgca-omtsha. }, qala.
{ o xa-kufika: ['hello'] yenza: { ['Empty']. }.} bamba: { :e Imveliso bhala: e, umgca-omtsha. }, qala. 
{ >> z := 4 ÷ 0. } bamba: { :e Imveliso bhala: e, umgca-omtsha. }, qala. 
{ (Inyaniso kwaye: Engenanto) inyaniso: { Imveliso bhala: ['X'].}. } bamba: { :e Imveliso bhala: e, umgca-omtsha. }, qala. 
{ ([''] xor: 0) inyaniso: { Imveliso bhala: ['X'].}. } bamba: { :e Imveliso bhala: e, umgca-omtsha. }, qala. 
{ (1 < ['2']) inyaniso: { Imveliso bhala: ['OK']. }. } bamba: { :e Imveliso bhala: e, umgca-omtsha. }, qala. 
{ (1 < ['2.0']) inyaniso: { Imveliso bhala: ['OK']. }. } bamba: { :e Imveliso bhala: e, umgca-omtsha. }, qala. 
{ (1 < ['x2.0']) inyaniso: { Imveliso bhala: ['NO!']. }. } bamba: { :e Imveliso bhala: e, umgca-omtsha. }, qala. 
{ Imveliso bhala: (['hello OK there'] ukusuka: ['6'] ubude: ['2']). } qala. 
