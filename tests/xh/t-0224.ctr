
>> countries := Uluhlu entsha
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Uluhlu entsha
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods ngoko: countries, nganye: { :key :value
	counter yongeza: 1.
}.

Imveliso bhala: (['we serve counter dishes'] counter: counter), umgca-omtsha.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] oonobumba cwangcisa: { :v
	counter yongeza: 0.
}.

Imveliso bhala: (['we sort counter dishes'] counter: counter), umgca-omtsha.


>> counter := 0.
{
	{
		counter yongeza: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Imveliso bhala: (['we calculate counter numbers.'] counter: counter), umgca-omtsha.

