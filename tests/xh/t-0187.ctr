Inani xa-kufika: ['factorial'] yenza: {
	>> total := 1.
	{ :index total phinda-ngo: (ngokwakho - index). } × ngokwakho. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Inkqubo ulawulo-lwenkumbulo: 0.

{
2 exponent factorial.
Imveliso bhala: (11 intsalela: 3), umgca-omtsha.
Imveliso bhala: (3.4 sondeza-inani), umgca-omtsha.
Imveliso bhala: (7.1 nyusa-inani), umgca-omtsha.
Imveliso bhala: (7.9 thoba-inani), umgca-omtsha.
}
qala.

Inkqubo coca.

usedMemory1 := (Inkqubo inkumbulo ? 0).

{
2 exponent factorial.
Imveliso bhala: (11 intsalela: 3), umgca-omtsha.
Imveliso bhala: (3.4 sondeza-inani), umgca-omtsha.
Imveliso bhala: (7.1 nyusa-inani), umgca-omtsha.
Imveliso bhala: (7.9 thoba-inani), umgca-omtsha.
}
qala.

Inkqubo coca.
usedMemory2 := (Inkqubo inkumbulo ? 0).


{
2 exponent factorial.
Imveliso bhala: (11 intsalela: 3), umgca-omtsha.
Imveliso bhala: (3.4 sondeza-inani), umgca-omtsha.
Imveliso bhala: (7.1 nyusa-inani), umgca-omtsha.
Imveliso bhala: (7.9 thoba-inani), umgca-omtsha.
} qala.

Inkqubo coca.
usedMemory3 := (Inkqubo inkumbulo ? 0).



( usedMemory1 = usedMemory2 kwaye: usedMemory1 = usedMemory3, kwaye: usedMemory2 = usedMemory3 ) inyaniso: {
	Imveliso bhala: ['No memory leaks here'].
}, ubuxoki: {
	Imveliso bhala: ['Leaking memory...'].
}.
