Imveliso bhala: ['Test object'], umgca-omtsha.
>> a := Into entsha. 

a xa-kufika: ['item:'] yenza: { :file
	eyakho file := file. 
}.

a xa-kufika: ['item'] yenza: { <- eyakho file.
}.

>> f := Ifayile entsha: ['/tmp/aaa.txt'].
a item: f.
Imveliso bhala: a item, umgca-omtsha.
a save-as: ['/tmp/a.bin'].
Imveliso bhala: ['========== RELOADING SNAP:'], umgca-omtsha.
>> b := Into load-from: ['/tmp/a.bin'].
Imveliso bhala: b item, umgca-omtsha.
