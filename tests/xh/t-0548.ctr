Server init.

>> x := Blob entsha: 65 uhlobo: ['char'].
# for this test you need set a path to libc (puts)
>> libname := Inkqubo isicwangciso: ['FFITESTLIB'].
Server qhagamshela: (
 Uluhlu entsha ;
 libname ;
 ['putchar'] ;
 ( Uluhlu entsha ; ['char'] ) ;
 ['void'] ;
 ['Print'] ;
 ['char:']
).
Print char: (x ukusuka: 0 ubude: 1), umgca-omtsha.
x khulula.

