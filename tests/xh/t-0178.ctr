

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Inkqubo ulawulo-lwenkumbulo: 0.

>> txt := ['Word Salad'].
Imveliso bhala: ['last index of ord = '] + (( txt indawo-yokugqibela: ['ord'] ) - 0), umgca-omtsha.
Imveliso bhala: ['index of ord = '] + (( txt fumana: ['ord'] ) - 0), umgca-omtsha.
Imveliso bhala: ['index of ad = '] + (( txt fumana: ['ad'] ) - 0), umgca-omtsha.
Imveliso bhala: ['last index of W = '] + (( txt indawo-yokugqibela: ['W'] ) - 0), umgca-omtsha.
Imveliso bhala: ['last index of d = '] + (( txt indawo-yokugqibela: ['d'] ) - 0), umgca-omtsha.
Imveliso bhala: ['txt equals Word Salad = '] + ( txt = ['Word Salad'] ), umgca-omtsha.
Imveliso bhala: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), umgca-omtsha.
Imveliso bhala: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), umgca-omtsha.
Imveliso bhala: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), umgca-omtsha.

Inkqubo coca.

usedMemory1 := (Inkqubo inkumbulo ? 0).


