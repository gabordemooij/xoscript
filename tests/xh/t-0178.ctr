Inkqubo coca.
usedMemory3 := (Inkqubo inkumbulo ? 0).



( usedMemory1 = usedMemory2 kwaye: usedMemory1 = usedMemory3, kwaye: usedMemory2 = usedMemory3 ) inyaniso: {
	Imveliso bhala: ['No memory leaks here'].
}, ubuxoki: {
	Imveliso bhala: ['Leaking memory...'].
}.
