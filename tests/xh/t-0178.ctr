Imveliso bhala: ['last index of d = '] + (( txt indawo-yokugqibela: ['d'] ) - 0), umgca-omtsha.
Imveliso bhala: ['txt equals Word Salad = '] + ( txt = ['Word Salad'] ), umgca-omtsha.
Imveliso bhala: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), umgca-omtsha.
Imveliso bhala: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), umgca-omtsha.
Imveliso bhala: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), umgca-omtsha.

