Imveliso bhala: ['Continue for-loop, No - before 6 and up.'], umgca-omtsha.
{ :i
	Imveliso bhala: (i + 1), umgca-omtsha.
	((i + 1) > 4) qhubeka.
	Imveliso bhala: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Imveliso umgca-omtsha.
Imveliso bhala: ['Continue while-true, No --> before 5 and up.'], umgca-omtsha.
{
	Imveliso bhala: ['iteration #'] + x, umgca-omtsha.
	x yongeza: 1.
	((x < 5) hayi) qhubeka.
	Imveliso bhala: ['-->'].
} ngelixa: xIsLessThan10.
Imveliso umgca-omtsha.
Imveliso bhala: ['Continue while-false, No - before 3 only.'], umgca-omtsha.
{
	Imveliso bhala: ['iteration #'] + x, umgca-omtsha.
	x thabatha: 1.
	(x = 3) qhubeka.
	Imveliso bhala: ['-'].
} ngelixa: { <- ( x > 0). }.

Imveliso umgca-omtsha.
Imveliso bhala: ['Continue times-loop, No ||| before 3.'], umgca-omtsha.
{ :i
	Imveliso bhala: ['iteration #'] + i, umgca-omtsha.
	(i = 2) qhubeka.
	Imveliso bhala: ['|||'].
} × 5.

Imveliso umgca-omtsha.

{ Inyaniso qhubeka. Imveliso bhala: ['dont write this!'], umgca-omtsha. } qala.

{ Inyaniso qhubeka. Imveliso bhala: ['dont write this!'], umgca-omtsha. } bamba: { Imveliso bhala: ['Dont catch this!']. }, qala.

Imveliso bhala: ['Test Array each-loop: 0, ... ,2'], umgca-omtsha.
(Uluhlu ← 1 ; 2 ; 3) guqula-nganye: { :i
	(i = 1) qhubeka.
	Imveliso bhala: ['iteration #'] + (i - 0), umgca-omtsha.
}.

Imveliso bhala: ['Test Map each-loop: c only'], umgca-omtsha.
>> m := Isichazimagama entsha.
m beka: ['first'] kwindawo: ['a'], beka: ['second'] kwindawo: ['b'], beka: ['third'] kwindawo: ['c'].
m nganye: { :k :v
	(k ≠ ['c']) qhubeka.
	Imveliso bhala: ['iteration'] + k + v, umgca-omtsha.
}.

