# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Inkqubo shell-escape: ['abc'].
Imveliso bhala: c, umgca-omtsha.
Imveliso bhala: ( Inkqubo isixokelelwano: ['echo '] + c ), umgca-omtsha.

c := Inkqubo shell-escape: ['a'b'c'].
Imveliso bhala: c, umgca-omtsha.
Imveliso bhala: ( Inkqubo isixokelelwano: ['echo '] + c ), umgca-omtsha.

c := Inkqubo shell-escape: ['a\'c'].
Imveliso bhala: c, umgca-omtsha.
Imveliso bhala: ( Inkqubo isixokelelwano: ['echo '] + c ), umgca-omtsha.