Uluhlu xa-kufika: ['kopa'] yenza: {
	>> kopa := Uluhlu entsha.
	ngokwakho nganye: { :inani :section
		kopa yongeza-ekugqibeleni: section ephindayo kopa.
	}. <- kopa.
}.

>> sheep := Uluhlu entsha ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep kopa.
clones nganye: { :inani :sheep
	sheep yongeza-ekugqibeleni: ['2'].
}.

Imveliso bhala: sheep, umgca-omtsha.
Imveliso bhala: clones, umgca-omtsha.
