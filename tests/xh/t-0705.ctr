

>> obj := Into entsha.

obj xa-kufika: ['greet'] yenza: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj xa-kufika: ['task'] yenza: {
	eyakho property := 123.
	{
		# try binds self/own to object instead of block
		Imveliso bhala: ngokwakho greet.
		Imveliso bhala: eyakho property.
		1 / 0.
	} bamba: {
		Imveliso bhala: ngokwakho greet.
		Imveliso bhala: eyakho property.
		Imveliso bhala: ['ok'].
	}, zama.
}.

obj task.