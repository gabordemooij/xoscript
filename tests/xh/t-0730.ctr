Imveliso bhala: ['Test object'], umgca-omtsha.
>> a := Into entsha. 

a xa-kufika: ['item:'] yenza: { :moment
	eyakho moment := moment. 
}.

a xa-kufika: ['item'] yenza: { <- eyakho moment.
}.

>> today := Ixesha entsha ummandla-wexesha: ['CEST'], unyaka: 2026, inyanga: 7.
a item: today.
Imveliso bhala: a item, umgca-omtsha.
a save-as: ['/tmp/a.bin'].
Imveliso bhala: ['========== RELOADING SNAP:'], umgca-omtsha.
>> b := Into load-from: ['/tmp/a.bin'].
Imveliso bhala: b item, umgca-omtsha.
