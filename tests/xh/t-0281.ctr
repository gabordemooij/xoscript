>> q := Uluhlu ← 1 ; 2 ; 3.
{ q ? ['1']. } bamba: { Imveliso bhala: ['caught!'], umgca-omtsha. }, qala.
{ q ? Inyaniso. } bamba: { Imveliso bhala: ['caught!'], umgca-omtsha. }, qala.
{ q ? Ubuxoki. } bamba: { Imveliso bhala: ['caught!'], umgca-omtsha. }, qala.
{ q ? Engenanto. } bamba: { Imveliso bhala: ['caught!'], umgca-omtsha. }, qala.
{ q ? (Uluhlu entsha). } bamba: { Imveliso bhala: ['caught!'], umgca-omtsha. }, qala.
{ q ? (Into entsha). } bamba: { Imveliso bhala: ['caught!'], umgca-omtsha. }, qala.
{ q ? ({ ['Empty']. }). } bamba: { Imveliso bhala: ['caught!'], umgca-omtsha. }, qala.
Imveliso bhala: ['caught them all'], umgca-omtsha.
