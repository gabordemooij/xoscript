
Uluhlu xa-kufika: ['sum'] yenza: {
	>> total := 0.
	ngokwakho nganye: { :index :element
		total yongeza: element.
	}. <- total.
}.

>> a := Uluhlu ← 9 ; 8 ; 7.
Imveliso bhala: (a sum), umgca-omtsha. 
>> a := Uluhlu ← 1 ; 9.
Imveliso bhala: (a sum), umgca-omtsha. 
>> a := Uluhlu ← ['o'] ; 2.
Imveliso bhala: (a sum), umgca-omtsha. 
Imveliso bhala: (Uluhlu entsha sum), umgca-omtsha. 
