
Imveliso bhala: ['Break for-loop, 0-4.'], umgca-omtsha.
{ :i
	Imveliso bhala: ['iteration #'] + i, umgca-omtsha.
	(i = 4) yaphula.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Imveliso bhala: ['Break while-true loop, 0-4.'], umgca-omtsha.
{
	Imveliso bhala: ['iteration #'] + x, umgca-omtsha.
	x yongeza: 1.
	((x < 5) hayi) yaphula.
} ngelixa: xIsLessThan10.

Imveliso bhala: ['Break while-false loop, 5,4.'], umgca-omtsha.
{
	Imveliso bhala: ['iteration #'] + x, umgca-omtsha.
	x thabatha: 1.
	(x = 3) yaphula.
} ngelixa: { <- (x > 0). }.

Imveliso bhala: ['Break times loop, 1-4.'], umgca-omtsha.
{ :i
	Imveliso bhala: ['iteration #'] + i, umgca-omtsha.
	(i = 4) yaphula.
} × 5.

Imveliso bhala: ['Break block, dont print line.'], umgca-omtsha.
{ Inyaniso yaphula. Imveliso bhala: ['dont write this!'], umgca-omtsha. } qala.

Imveliso bhala: ['Break block, dont fire catch...'], umgca-omtsha.
{ Inyaniso yaphula. Imveliso bhala: ['dont write this!'], umgca-omtsha. } bamba: { Imveliso bhala: ['Dont catch this!']. }, qala.

Imveliso bhala: ['Test Array each-loop: 0,1'], umgca-omtsha.
(Uluhlu ← 1 ; 2 ; 3) guqula-nganye: { :i
	Imveliso bhala: ['iteration #'] + i, umgca-omtsha.
	(i = 1) yaphula.
}.

Imveliso bhala: ['Test Map each-loop: c only'], umgca-omtsha.
>> m := Isichazimagama entsha.
m beka: ['first'] kwindawo: ['a'], beka: ['second'] kwindawo: ['b'], beka: ['third'] kwindawo: ['c'].
m nganye: { :k :v
	Imveliso bhala: ['iteration'] + v + k, umgca-omtsha.
	Inyaniso yaphula.
}.

