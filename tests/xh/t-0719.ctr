Server init.
>> fmt := Ifomathi entsha: ['%#3x'].

>> blob := Blob entsha: 4.
blob bytes: ( 
	Uluhlu entsha ; 0 ; 1 ; 2 ; 3
).

>> file := Ifayile entsha: ['/tmp/blob'].
file blob: blob.
blob khulula.

>> funda := file blob.
funda 
ukusuka: 0 
ubude: 4, 
yenza nganye: { :i :b 
	Imveliso
	bhala: (fmt sebenzisa-kwinani-elipheleleyo: b),
	umgca-omtsha.
}.
funda khulula.
