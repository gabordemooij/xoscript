# Can we use UTF8 in regex?
Server init.
>> p := Ipateni entsha: ['\\w'].
Imveliso bhala: ( p ukungqamana: ['x'] ), umgca-omtsha.
Imveliso bhala: ( p ukungqamana: ['é'] ), umgca-omtsha.
>> p := Ipateni entsha: ['(*UTF)(*UCP)\\w'].
Imveliso bhala: ( p ukungqamana: ['é'] ), umgca-omtsha.
# should give 101