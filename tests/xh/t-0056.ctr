>> z := Into entsha.
z xa-kufika: ['value:'] yenza: { :v
	eyakho value := v. <- ngokwakho.
}.
z xa-kufika: ['value'] yenza: { <- eyakho value. }.
(z setValue: 1) value: 2.
Imveliso bhala: z value.
>> x := z.
Imveliso bhala: x value.
z := Engenanto.
Imveliso bhala: z value.
Imveliso bhala: x value.
Imveliso bhala: ['hello'].
