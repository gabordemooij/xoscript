Imveliso bhala: ['Test object'], umgca-omtsha.
>> a := Into entsha. 

a xa-kufika: ['item:'] yenza: { :num
	eyakho num := num. 
}.

a xa-kufika: ['item'] yenza: { <- eyakho num.
}.

a item: 123.

Imveliso bhala: a item, umgca-omtsha.

>> old-num-address := a item umzekelo-wokuqala idilesi-yenkumbulo.
a save-as: ['/tmp/a.bin'].
Imveliso bhala: ['========== RELOADING SNAP:'], umgca-omtsha.

>> b := Into load-from: ['/tmp/a.bin'].

(b item umzekelo-wokuqala idilesi-yenkumbulo = old-num-address) inyaniso: {
	Imveliso bhala: ['Object link re-attached.'], umgca-omtsha.
}.

Imveliso bhala: b item, umgca-omtsha.
