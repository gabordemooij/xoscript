# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Inkqubo isicwangciso: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server qhagamshela: ( Uluhlu entsha ;
 libname ; ['fopen'] ;
 ( Uluhlu entsha ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
qhagamshela: ( Uluhlu entsha ;
 Engenanto ; # means same lib
 ['fread'] ;
 ( Uluhlu entsha ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Engenanto ; # means same object (i.e. Stream)
 ['fread']
),
qhagamshela: (
 Uluhlu entsha ;
 Engenanto ; # means same lib
 ['fwrite'] ;
 ( Uluhlu entsha ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Engenanto ; # means same lib
 ['fwrite']
),
qhagamshela: (
 Uluhlu entsha ;
 Engenanto ; # means same lib
 ['rewind'] ;
 ( Uluhlu entsha ; ['pointer'] ) ;
 ['int'] ;
 Engenanto ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> indlela-yefayile := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: indlela-yefayile mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream umyalezo: ['fwrite'] izifakwa: (Uluhlu entsha ; str ; 1 ; 6 ; fd ).
Imveliso bhala: bytes-written, umgca-omtsha.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob entsha: 20.

# read from file
>> bytes-read := Stream umyalezo: ['fread'] izifakwa: (Uluhlu entsha ; buf ; 1 ; 6 ; fd ).
Imveliso bhala: bytes-read, umgca-omtsha.
Imveliso bhala: buf, umgca-omtsha.

# free memory
str  khulula.
indlela-yefayile khulula.
mode khulula.
buf  khulula.


