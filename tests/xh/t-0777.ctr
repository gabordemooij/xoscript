#OBSD
>> dirname := [''].
{ dirname yongeza-ekugqibeleni: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Inkqubo isixokelelwano: command.
Inkqubo chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename yongeza-ekugqibeleni: ['YYYYYYYY']. } * 20.
Ifayile entsha: filename, bhala: ['sometext'].
{ Ifayile uluhlu: ['/tmp/'] + dirname. } * 1000.
Imveliso bhala: ['no crash'], umgca-omtsha.

