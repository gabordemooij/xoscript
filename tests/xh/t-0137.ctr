


Inkqubo ulawulo-lwenkumbulo: 0.

>> x := 0.
>> y := ['Hello'].
>> q := { ['Empty']. }.
>> p := Inyaniso.
>> a := Uluhlu ← 1 ; 2 ; 3 ; 4.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Inkqubo coca.
usedMemory1 := (Inkqubo inkumbulo ? 0).




x := 1.
y := ['Hello'].
q := { ['Empty']. }.
p := Inyaniso.
a := Uluhlu ← 1 ; 2 ; 3 ; 5.

Inkqubo coca.
usedMemory2 := (Inkqubo inkumbulo ? 0).




x := 2.
y := ['Hello'].
q := { ['Empty']. }.
p := Inyaniso.
a := Uluhlu ← 1 ; 2 ; 3 ; 4.

Inkqubo coca.
usedMemory3 := (Inkqubo inkumbulo ? 0).




x := 3.
y := ['Hello'].
q := { ['Empty']. }.
p := Inyaniso.
a := Uluhlu ← 1 ; 2 ; 3 ; 5.


Inkqubo coca.
usedMemory4 := (Inkqubo inkumbulo ? 0).





x := 4.
y := ['Hello'].
q := { ['Empty']. }.
p := Inyaniso.
a := Uluhlu ← 1 ; 2 ; 3 ; 4.

Inkqubo coca.
>> usedMemory5 := (Inkqubo inkumbulo ? 0).




(usedMemory1 = usedMemory2 = usedMemory3 = usedMemory4 = usedMemory5) inyaniso: {
	Imveliso bhala: ['Memory usage remains stable.'], umgca-omtsha.
}, kungenjalo: {
	Imveliso bhala: ['Used memory not stable.'], umgca-omtsha.
	Imveliso bhala: usedMemory1, umgca-omtsha.
	Imveliso bhala: usedMemory2, umgca-omtsha.
	Imveliso bhala: usedMemory3, umgca-omtsha.
	Imveliso bhala: usedMemory4, umgca-omtsha.
	Imveliso bhala: usedMemory5, umgca-omtsha.
}.
