

>> Matryoshka := Into entsha.
Matryoshka xa-kufika: ['double:'] yenza: { :secret
	eyakho secret := secret × 2.
}.
Matryoshka xa-kufika: ['entsha:'] yenza: { :secret
	>> answer := Engenanto.
	>> t := (secret > 255).
	Imveliso bhala: (secret + [' | '] + t), umgca-omtsha.
	t inyaniso: {
		answer := secret.
	}, kungenjalo: {
		answer := Matryoshka ephindayo entsha: (ngokwakho double: secret).
	}. <- answer.
}.

>> x := Matryoshka entsha: 2.
