Server init.
Imveliso bhala: ['Database datetime test'], umgca-omtsha.

>> db := Maria-DB entsha umamkeli: ['localhost'],
	igama-lomsebenzisi: ['xo'], 
	iphasiwedi: ['pass123'],
	igama-ledatabheyisi: ['xobase'],
	qhagamshelana.

>> iiparamitha-zokukhangela :=
db umbuzo: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
landa: { :row
	Imveliso bhala: row datetimetest, umgca-omtsha.
}.
