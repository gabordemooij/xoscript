Server init.

Imveliso bhala: (
	Ipateni entsha: ['^\\w+$'],
	ukungqamana: ['test@example.com'] 
), umgca-omtsha. # 0 match, fails on @ and .

Imveliso bhala: (
	Ipateni entsha: ['^[^@]+@[^\.]+\.\\w+$'],
	ukungqamana: ['test@example.com'] 
), umgca-omtsha. # 1 match

Imveliso bhala: (
	Ipateni entsha: ['[^@]+@[^\.]+\.\\w+'],
	ukungqamana: ['test@example.com'] 
), umgca-omtsha. # 1 match

Imveliso bhala: (
	Ipateni entsha: ['([^@]+)@([^\.]+)\.\\w+'],
	ukungqamana: ['test@example.com'] 
), umgca-omtsha. # 1 match, groups dont matter

Imveliso bhala: (
	Ipateni entsha: ['[a-z]'],
	ukungqamana: ['test@example.com'] 
), umgca-omtsha. # 14 matches

Imveliso bhala: (
	Ipateni entsha: ['.*'],
	ukungqamana: ['test@example.com'] 
), umgca-omtsha. # 1 match (all)

Imveliso bhala: (
	Ipateni entsha: ['(.*)'],
	ukungqamana: ['test@example.com'] 
), umgca-omtsha. # 1 match (all)

Imveliso bhala: (
	Ipateni entsha: ['\\s*[^@]+@[^\.]+\.\\w+'],
	ukungqamana: ['test@example.com'] 
), umgca-omtsha. # 1 match, prefix space optional, gets ignored