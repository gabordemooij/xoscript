['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Imveliso bhala: (x + y), umgca-omtsha.

>> x := 10040.07.
>> y := 10305.60.

Imveliso bhala: (x + y), umgca-omtsha.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Imveliso bhala: (x + y + z), umgca-omtsha.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Imveliso bhala: (x + y + z), umgca-omtsha.

>> q := 0.1.2.

Imveliso bhala: (q), umgca-omtsha.

>> q := 012.

Imveliso bhala: (q), umgca-omtsha.
