Imveliso bhala: ['Test object'], umgca-omtsha.
>> a := Into entsha. 

a xa-kufika: ['item:'] yenza: { :moment
	eyakho moment := moment. 
}.

a xa-kufika: ['item'] yenza: { <- eyakho moment.
}.

>> today := Uluhlu entsha ; ( Ixesha entsha ummandla-wexesha: ['CEST'], unyaka: 2026, inyanga: 7 ).
a item: today.
Imveliso bhala: a item ? 0, umgca-omtsha.
a save-as: ['/tmp/a.bin'].
