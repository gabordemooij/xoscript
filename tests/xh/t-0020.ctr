(Engenanto = Engenanto) inyaniso: { Imveliso bhala: ['Nil is Nil!'].}.
(2 > 1) inyaniso: { Imveliso bhala: ['YES']. }.
(2 > 3) inyaniso: { Imveliso bhala: ['NO']. }.
(2 > 3) ubuxoki: { Imveliso bhala: ['Nonono..'].}.
Inyaniso inyaniso: { Imveliso bhala: ['TRUE is TRUE!']. }.
