

Umbhalo xa-kufika: ['evaluate'] yenza: {
	>> ikhowudi := Ifayile entsha: ['/tmp/eval.ctr'].
	ikhowudi bhala: ngokwakho umbhalo + ['.'].
	Inkqubo sebenzisa: ['/tmp/eval.ctr'].
}.

>> a := (Uluhlu ← (
	(Isichazimagama entsha)
		beka: ['domain'] kwindawo: ['mywebsite.com'],
		beka: (Uluhlu ←
			((Isichazimagama entsha)
				beka: ['home'] kwindawo: ['title'],
				beka: ['<html></html>'] kwindawo: ['body'],
				beka: ['2017-01-01'] kwindawo: ['created']
			) ;
			((Isichazimagama entsha)
				beka: ['aboutus(c)'] kwindawo: ['title'],
				beka: ['<credits>Author Inc.</credits>'] kwindawo: ['body']
			)
		) kwindawo: ['pages']
	)
) umbhalo.

Imveliso bhala: a uhlobo, umgca-omtsha.
Imveliso bhala: a, umgca-omtsha.

>> b := Engenanto.
(['b := '] + a) evaluate.
Imveliso bhala: b ? 0 ? ['pages'] ? 1 ? ['body'], umgca-omtsha.

>> c := b ? 0.
>> d := c umbhalo.
Imveliso bhala: d uhlobo, umgca-omtsha.

>> e := Engenanto.
(['e := '] + d) evaluate.
Imveliso bhala: e ? ['pages'] ? 0, umgca-omtsha.
