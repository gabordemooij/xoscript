Inani xa-kufika: ['factorial'] yenza: {
	>> total := 1.
	{ :index total phinda-ngo: (ngokwakho - (index)). } × ngokwakho. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Imveliso bhala: a.
>> b := 2 + 3 factorial.
Imveliso bhala: b.
>> c := 3 factorial + 2.
Imveliso bhala: c.
>> d := 2 + (3 factorial).
Imveliso bhala: d.
Imveliso bhala: 2 + 3 factorial + 1.
