Imveliso bhala: ['Test object'], umgca-omtsha.
>> cmd := Umyalelo entsha.
Imveliso bhala: cmd ls /tmp, umgca-omtsha.
>> old-cmd-address := cmd umzekelo-wokuqala idilesi-yenkumbulo.
cmd save-as: ['/tmp/a.bin'].
Imveliso bhala: ['========== RELOADING SNAP:'], umgca-omtsha.
>> b := Into load-from: ['/tmp/a.bin'].
(b umzekelo-wokuqala idilesi-yenkumbulo = old-cmd-address) inyaniso: {
	Imveliso bhala: ['Object link re-attached.'], umgca-omtsha.
}.
Imveliso bhala: b ls, umgca-omtsha.


