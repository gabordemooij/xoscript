>> winery := { <- (	Isichazimagama entsha
		beka: 2 kwindawo: ['merlot'],
		beka: 3 kwindawo: ['malbec'],
		beka: 4 kwindawo: ['syrah']
	).
}.

Imveliso bhala: (((winery qala) - ['nothing']) inani-lezinto), umgca-omtsha.
Imveliso bhala: (((winery qala) - ['merlot']) inani-lezinto), umgca-omtsha.
Imveliso bhala: (((winery qala) - ['malbec']) inani-lezinto), umgca-omtsha.
Imveliso bhala: (((winery qala) - ['syrah']) inani-lezinto), umgca-omtsha.
Imveliso bhala: (((winery qala) - ['merlot'] - ['malbec']) inani-lezinto), umgca-omtsha.
Imveliso bhala: (((winery qala) - ['merlot'] - ['syrah']) inani-lezinto), umgca-omtsha.
Imveliso bhala: (((winery qala) - ['malbec'] -['syrah']) inani-lezinto), umgca-omtsha.
Imveliso bhala: (((winery qala) - ['malbec'] - ['syrah'] - ['merlot']) inani-lezinto), umgca-omtsha.

