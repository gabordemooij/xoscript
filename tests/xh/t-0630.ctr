#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Ipateni entsha: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern ukungqamana: subject yenza: { :m :x
	Imveliso bhala: m, umgca-omtsha.
	Imveliso bhala: x, umgca-omtsha. <- ['XXX'].
}.
Imveliso bhala: result, umgca-omtsha.