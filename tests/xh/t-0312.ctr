>> Slurp := Into entsha.
Slurp xa-kufika: ['entsha'] yenza: {
	eyakho str := [''].
}.
Slurp funda: ['nieuw'] kuthetha: ['entsha'].
Slurp xa-kufika: ['phendula:'] yenza: { :blah
		(eyakho str ≠ ['']) inyaniso: {
			eyakho str yongeza-ekugqibeleni: [' '].
		}.
		eyakho str yongeza-ekugqibeleni: blah.
}.
Slurp xa-kufika: ['phendula:kwaye:'] yenza: { :blah :blahah
		(eyakho str ≠ ['']) inyaniso: {
			eyakho str yongeza-ekugqibeleni: [' '].
		}.
		(blah ubude > 1) inyaniso: {
			eyakho str yongeza-ekugqibeleni: (blah ukusuka: 0 ubude: (blah ubude - 1)).
		}, kungenjalo: {
			eyakho str yongeza-ekugqibeleni: blah.
		}.
		eyakho str yongeza-ekugqibeleni: [' '].
		eyakho str yongeza-ekugqibeleni: blahah.
}.
Slurp xa-kufika: ['obtain'] yenza: {
	>> buffer := eyakho str.
	eyakho str := ['']. <- buffer.
}.


>> iiparamitha-zokukhangela := Slurp entsha
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

Imveliso bhala: iiparamitha-zokukhangela obtain, umgca-omtsha.
