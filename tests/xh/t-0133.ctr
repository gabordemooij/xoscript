


>> Deck := Uluhlu entsha.
Deck xa-kufika: ['print'] yenza: {
        >> len := ngokwakho inani-lezinto - 1.
        { :i
                >> len2 := ngokwakho inani-lezinto - 1.
                Imveliso bhala: ['len: '].
                Imveliso bhala: len, umgca-omtsha.
                Imveliso bhala: ['len2: '].
                Imveliso bhala: len2, umgca-omtsha.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
