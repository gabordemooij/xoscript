Inkqubo ulawulo-lwenkumbulo: 4.

>> Doubler := Into entsha.
>> Multiplier := Into entsha.
Doubler xa-kufika: ['double:and:'] yenza: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier xa-kufika: ['multiply:and:'] yenza: { :x :y <- (x × y).
}.

Imveliso bhala: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), umgca-omtsha.
