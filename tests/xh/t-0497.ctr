Server init.

# write a test file
>> f := Ifayile entsha: ['/tmp/test.gif'].
f bhala: ['GIF87a01234567810'].

# serve the file
Server gqithisa: ['test.gif'] isimaphambili: ['/tmp/'].

Imveliso umgca-omtsha.

Imveliso bhala: ['Outside container (security):'], umgca-omtsha.
{ Server gqithisa: ['../passwd'] isimaphambili: ['/tmp/']. }
bamba: { :e Imveliso bhala: e, umgca-omtsha. },
qala.

Imveliso bhala: ['Invalid prefix:'], umgca-omtsha.
{ Server gqithisa: ['test.gif'] isimaphambili: ['z:\\']. }
bamba: { :e Imveliso bhala: e, umgca-omtsha. },
qala.

Imveliso bhala: ['Non-existant file:'], umgca-omtsha.
{ Server gqithisa: ['xxx.xxx'] isimaphambili: ['/tmp/']. }
bamba: { :e Imveliso bhala: e, umgca-omtsha. },
qala.
