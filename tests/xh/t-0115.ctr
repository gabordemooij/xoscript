{
	lo-msebenzi impazamo: ['Dont fail.'].
	unknown doSomething.
} bamba: {
	Imveliso bhala: ['Caught!'].
}, qala.

{
	lo-msebenzi impazamo: ['Dont fail.'].
	eyakho unknown doSomething.
} bamba: {
	Imveliso bhala: ['Caught!'].
}, qala.

{
	lo-msebenzi impazamo: ['Dont fail.'].
	unknown := 122.
} bamba: {
	Imveliso bhala: ['Caught!'].
}, qala.


{
	lo-msebenzi impazamo: ['Dont fail.'].
	Inyaniso yaphula.
	Imveliso bhala: ['FAIL'].
} bamba: {
	Imveliso bhala: ['Caught!'].
}, qala.

{
	{
		lo-msebenzi impazamo: ['Dont fail.'].
		Inyaniso yaphula.
		Imveliso bhala: ['FAIL'].
	} bamba: { :x
		(x = ['Dont fail.']) inyaniso: { lo-msebenzi impazamo: ['Nested Caught!']. }.
	}, qala.
} bamba: { :e
	Imveliso bhala: e.
}, qala.
