Server init.

>> DB := Maria-DB entsha umamkeli: ['localhost'],
	igama-lomsebenzisi: ['xo'],
	iphasiwedi: ['pass123'],
	igama-ledatabheyisi: ['xobase'],
	qhagamshelana.

{
	DB umbuzo:
	['DROP TABLE movies'],
	phumeza.
} bamba: { Engenanto. }, qala.

DB umbuzo:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
phumeza.

DB umbuzo: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
iiparamitha: ( Uluhlu entsha ; ['Halloween'] ),
phumeza.

DB umbuzo: ['SELECT * FROM movies'],
landa: { :movie
	Imveliso bhala: movie title, umgca-omtsha.
}.

