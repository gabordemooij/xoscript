Imveliso bhala: ['Test object'], umgca-omtsha.
>> a := Into entsha. 

a xa-kufika: ['item:'] yenza: { :fmt
	eyakho fmt := fmt. 
}.

a xa-kufika: ['item'] yenza: { <- eyakho fmt.
}.

a item: ( Ifomathi entsha: ['|%s|'] ).

Imveliso bhala: a item, umgca-omtsha.

>> old-fmt-address := a item umzekelo-wokuqala idilesi-yenkumbulo.
a save-as: ['/tmp/a.bin'].
Imveliso bhala: ['========== RELOADING SNAP:'], umgca-omtsha.

>> b := Into load-from: ['/tmp/a.bin'].

(b item umzekelo-wokuqala idilesi-yenkumbulo = old-fmt-address) inyaniso: {
	Imveliso bhala: ['Object link re-attached.'], umgca-omtsha.
}.

Imveliso bhala: ( b item sebenzisa-ku: ['hello'] ), umgca-omtsha.
