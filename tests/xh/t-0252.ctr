#Linux
>> clock := Ixesha entsha.
clock ummandla-wexesha: ['UTC-1'].
clock unyaka: 1981, inyanga: 1, usuku: 5,
      iyure: 13, umzuzu: 15, umzuzwana: 13.

Imveliso bhala: clock, umgca-omtsha.
clock ummandla-wexesha: ['UTC+0'].

Imveliso bhala: (
	(clock unyaka elula) + ['-'] + (clock inyanga) + ['-'] + (clock usuku) + [' '] +
	(clock iyure) + [':'] + (clock umzuzu) + [':'] + (clock umzuzwana) + [' '] +
	['W'] + (clock iveki) + (clock ummandla-wexesha)
), umgca-omtsha.


clock ummandla-wexesha: ['UTC-1'].
Imveliso bhala: (
	(clock unyaka elula) + ['-'] + (clock inyanga) + ['-'] + (clock usuku) + [' '] +
	(clock iyure) + [':'] + (clock umzuzu) + [':'] + (clock umzuzwana) + [' '] +
	['W'] + (clock iveki) + (clock ummandla-wexesha)
), umgca-omtsha.
