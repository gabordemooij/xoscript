>> x := [' hallo '].

>> y := x oonobumba-abakhulu.
Imveliso bhala: x, umgca-omtsha.
Imveliso bhala: (x iyafana: y), umgca-omtsha.

>> y := x oonobumba-abancinci.
Imveliso bhala: x, umgca-omtsha.
Imveliso bhala: (x iyafana: y), umgca-omtsha.

>> y := x sika-izithuba.
Imveliso bhala: x, umgca-omtsha.
Imveliso bhala: (x iyafana: y), umgca-omtsha.

>> y := x tsiba: 1.
Imveliso bhala: x, umgca-omtsha.
Imveliso bhala: (x iyafana: y), umgca-omtsha.

>> y := x ukusuka: 1 ubude: 2.
Imveliso bhala: x, umgca-omtsha.
