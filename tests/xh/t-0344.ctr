# catch-all test (practical)
>> HTML := Umbhalo entsha.
HTML xa-kufika: ['encode:'] yenza: { :tekst
	ngokwakho yongeza-ekugqibeleni: (tekst
	buyisela: ['&'] nge: ['&amp;'], 
	buyisela: ['<'] nge: ['&lt;'],
	buyisela: ['>'] nge: ['&gt;'],
	buyisela: ['"'] nge: ['&quot;']).
}.
>> blog := HTML entsha.
blog yongeza-ekugqibeleni: ['<h1>'],
     encode: ['Koffie & Thee'],
     yongeza-ekugqibeleni: ['</h1>'].
Imveliso bhala: blog, umgca-omtsha.


>> Roman := Inani entsha.
Roman xa-kufika: ['stringy'] yenza: {
	>> a := [''].
	{ a yongeza-ekugqibeleni: ['I']. } × ngokwakho. <- a.
}.

>> x := Roman entsha.
x yongeza: 3.
Imveliso bhala: x stringy, umgca-omtsha.

>> Quantum := Ibhuliyeni entsha.
Quantum xa-kufika: ['true?'] yenza: { <- ['maybe True']. }.
Imveliso bhala: (Quantum entsha true?), umgca-omtsha.

>> Nihil := Engenanto entsha.
Nihil xa-kufika: ['umbhalo'] yenza: { <- ['Nihil']. }.
Imveliso bhala: (Nihil entsha), umgca-omtsha.
