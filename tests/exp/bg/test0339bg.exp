Списък ← ‘A‘ ; ['B']
(Речник нов) постави:‘A‘ на:['Обект']
Списък ← (Списък ← ‘A‘)
(Речник нов) постави:((Речник нов) постави:‘A‘ на:['Обект']) на:['(Речник нов) постави:‘A‘ на:\['Обект\']']
(Речник нов) постави:(Списък ← ‘A‘) на:['Списък ← ‘A‘']
Списък ← ((Речник нов) постави:‘A‘ на:['Обект'])
-- тест за анализ --
Списък ← ['A‘'] ; ['B']
(Речник нов) постави:['A‘'] на:['A‘']
Списък ← (Списък ← ['A‘'])
(Речник нов) постави:((Речник нов) постави:['A‘'] на:['A‘']) на:['(Речник нов) постави:\['A‘\'] на:\['A‘\']']
(Речник нов) постави:(Списък ← ['A‘']) на:['Списък ← \['A‘\']']
Списък ← ((Речник нов) постави:['A‘'] на:['A‘'])
