Llista ← ‘A‘ ; ['B']
(Diccionari nou) posa:‘A‘ a:['Objecte']
Llista ← (Llista ← ‘A‘)
(Diccionari nou) posa:((Diccionari nou) posa:‘A‘ a:['Objecte']) a:['(Diccionari nou) posa:‘A‘ a:\['Objecte\']']
(Diccionari nou) posa:(Llista ← ‘A‘) a:['Llista ← ‘A‘']
Llista ← ((Diccionari nou) posa:‘A‘ a:['Objecte'])
-- prova d'anàlisi --
Llista ← ['A‘'] ; ['B']
(Diccionari nou) posa:['A‘'] a:['A‘']
Llista ← (Llista ← ['A‘'])
(Diccionari nou) posa:((Diccionari nou) posa:['A‘'] a:['A‘']) a:['(Diccionari nou) posa:\['A‘\'] a:\['A‘\']']
(Diccionari nou) posa:(Llista ← ['A‘']) a:['Llista ← \['A‘\']']
Llista ← ((Diccionari nou) posa:['A‘'] a:['A‘'])
