Dhaptar ← ‘A‘ ; ['B']
(Kamus anyar) seleh:‘A‘ ing:['Obyek']
Dhaptar ← (Dhaptar ← ‘A‘)
(Kamus anyar) seleh:((Kamus anyar) seleh:‘A‘ ing:['Obyek']) ing:['(Kamus anyar) seleh:‘A‘ ing:\['Obyek\']']
(Kamus anyar) seleh:(Dhaptar ← ‘A‘) ing:['Dhaptar ← ‘A‘']
Dhaptar ← ((Kamus anyar) seleh:‘A‘ ing:['Obyek'])
-- parse test --
Dhaptar ← ['A‘'] ; ['B']
(Kamus anyar) seleh:['A‘'] ing:['A‘']
Dhaptar ← (Dhaptar ← ['A‘'])
(Kamus anyar) seleh:((Kamus anyar) seleh:['A‘'] ing:['A‘']) ing:['(Kamus anyar) seleh:\['A‘\'] ing:\['A‘\']']
(Kamus anyar) seleh:(Dhaptar ← ['A‘']) ing:['Dhaptar ← \['A‘\']']
Dhaptar ← ((Kamus anyar) seleh:['A‘'] ing:['A‘'])
