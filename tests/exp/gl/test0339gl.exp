Lista ← ‘A‘ ; ['B']
(Dicionario novo) poñer:‘A‘ en:['Obxecto']
Lista ← (Lista ← ‘A‘)
(Dicionario novo) poñer:((Dicionario novo) poñer:‘A‘ en:['Obxecto']) en:['(Dicionario novo) poñer:‘A‘ en:\['Obxecto\']']
(Dicionario novo) poñer:(Lista ← ‘A‘) en:['Lista ← ‘A‘']
Lista ← ((Dicionario novo) poñer:‘A‘ en:['Obxecto'])
-- parse test --
Lista ← ['A‘'] ; ['B']
(Dicionario novo) poñer:['A‘'] en:['A‘']
Lista ← (Lista ← ['A‘'])
(Dicionario novo) poñer:((Dicionario novo) poñer:['A‘'] en:['A‘']) en:['(Dicionario novo) poñer:\['A‘\'] en:\['A‘\']']
(Dicionario novo) poñer:(Lista ← ['A‘']) en:['Lista ← \['A‘\']']
Lista ← ((Dicionario novo) poñer:['A‘'] en:['A‘'])
