Listë ← ‘A‘ ; ['B']
(Fjalor ri) vendos:‘A‘ në:['Objekt']
Listë ← (Listë ← ‘A‘)
(Fjalor ri) vendos:((Fjalor ri) vendos:‘A‘ në:['Objekt']) në:['(Fjalor ri) vendos:‘A‘ në:\['Objekt\']']
(Fjalor ri) vendos:(Listë ← ‘A‘) në:['Listë ← ‘A‘']
Listë ← ((Fjalor ri) vendos:‘A‘ në:['Objekt'])
