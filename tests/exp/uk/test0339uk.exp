Список ← ‘A‘ ; ['B']
(Словник новий) поставити:‘A‘ у:['Обʼєкт']
Список ← (Список ← ‘A‘)
(Словник новий) поставити:((Словник новий) поставити:‘A‘ у:['Обʼєкт']) у:['(Словник новий) поставити:‘A‘ у:\['Обʼєкт\']']
(Словник новий) поставити:(Список ← ‘A‘) у:['Список ← ‘A‘']
Список ← ((Словник новий) поставити:‘A‘ у:['Обʼєкт'])
-- тест розбору --
Список ← ['A‘'] ; ['B']
(Словник новий) поставити:['A‘'] у:['A‘']
Список ← (Список ← ['A‘'])
(Словник новий) поставити:((Словник новий) поставити:['A‘'] у:['A‘']) у:['(Словник новий) поставити:\['A‘\'] у:\['A‘\']']
(Словник новий) поставити:(Список ← ['A‘']) у:['Список ← \['A‘\']']
Список ← ((Словник новий) поставити:['A‘'] у:['A‘'])
