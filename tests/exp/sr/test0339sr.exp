Листа ← ‘A‘ ; ['B']
(Речник нови) стави:‘A‘ на:['Објекат']
Листа ← (Листа ← ‘A‘)
(Речник нови) стави:((Речник нови) стави:‘A‘ на:['Објекат']) на:['(Речник нови) стави:‘A‘ на:\['Објекат\']']
(Речник нови) стави:(Листа ← ‘A‘) на:['Листа ← ‘A‘']
Листа ← ((Речник нови) стави:‘A‘ на:['Објекат'])
-- тест парсирања --
Листа ← ['A‘'] ; ['B']
(Речник нови) стави:['A‘'] на:['A‘']
Листа ← (Листа ← ['A‘'])
(Речник нови) стави:((Речник нови) стави:['A‘'] на:['A‘']) на:['(Речник нови) стави:\['A‘\'] на:\['A‘\']']
(Речник нови) стави:(Листа ← ['A‘']) на:['Листа ← \['A‘\']']
Листа ← ((Речник нови) стави:['A‘'] на:['A‘'])
