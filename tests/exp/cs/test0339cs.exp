Seznam ← ‘A‘ ; ['B']
(Slovník nový) umístit:‘A‘ na:['Objekt']
Seznam ← (Seznam ← ‘A‘)
(Slovník nový) umístit:((Slovník nový) umístit:‘A‘ na:['Objekt']) na:['(Slovník nový) umístit:‘A‘ na:\['Objekt\']']
(Slovník nový) umístit:(Seznam ← ‘A‘) na:['Seznam ← ‘A‘']
Seznam ← ((Slovník nový) umístit:‘A‘ na:['Objekt'])
-- test parsování --
Seznam ← ['A‘'] ; ['B']
(Slovník nový) umístit:['A‘'] na:['A‘']
Seznam ← (Seznam ← ['A‘'])
(Slovník nový) umístit:((Slovník nový) umístit:['A‘'] na:['A‘']) na:['(Slovník nový) umístit:\['A‘\'] na:\['A‘\']']
(Slovník nový) umístit:(Seznam ← ['A‘']) na:['Seznam ← \['A‘\']']
Seznam ← ((Slovník nový) umístit:['A‘'] na:['A‘'])
