Listar ← ‘A‘ ; ['B']
(Mapa novo) colocar:‘A‘ em:['Objeto']
Listar ← (Listar ← ‘A‘)
(Mapa novo) colocar:((Mapa novo) colocar:‘A‘ em:['Objeto']) em:['(Mapa novo) colocar:‘A‘ em:\['Objeto\']']
(Mapa novo) colocar:(Listar ← ‘A‘) em:['Listar ← ‘A‘']
Listar ← ((Mapa novo) colocar:‘A‘ em:['Objeto'])
-- teste de análise --
Listar ← ['A‘'] ; ['B']
(Mapa novo) colocar:['A‘'] em:['A‘']
Listar ← (Listar ← ['A‘'])
(Mapa novo) colocar:((Mapa novo) colocar:['A‘'] em:['A‘']) em:['(Mapa novo) colocar:\['A‘\'] em:\['A‘\']']
(Mapa novo) colocar:(Listar ← ['A‘']) em:['Listar ← \['A‘\']']
Listar ← ((Mapa novo) colocar:['A‘'] em:['A‘'])
