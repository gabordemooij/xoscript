Lista ← ‘A‘ ; ['B']
(Diccionario crear) poner:‘A‘ en:['Objeto']
Lista ← (Lista ← ‘A‘)
(Diccionario crear) poner:((Diccionario crear) poner:‘A‘ en:['Objeto']) en:['(Diccionario crear) poner:‘A‘ en:\['Objeto\']']
(Diccionario crear) poner:(Lista ← ‘A‘) en:['Lista ← ‘A‘']
Lista ← ((Diccionario crear) poner:‘A‘ en:['Objeto'])
-- prueba de análisis --
Lista ← ['A‘'] ; ['B']
(Diccionario crear) poner:['A‘'] en:['A‘']
Lista ← (Lista ← ['A‘'])
(Diccionario crear) poner:((Diccionario crear) poner:['A‘'] en:['A‘']) en:['(Diccionario crear) poner:\['A‘\'] en:\['A‘\']']
(Diccionario crear) poner:(Lista ← ['A‘']) en:['Lista ← \['A‘\']']
