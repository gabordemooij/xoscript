
>> dictionary := (
	அகராதி புதிய
		வை: ['b'] திறவுகோல்: ['a'],
		வை: ['a'] திறவுகோல்: ['b'],
		வை: ['z'] திறவுகோல்: ['x'],
		வை: ['hello'] திறவுகோல்: ['hallo'],
		வை: ['human'] திறவுகோல்: ['human']
).

>> comparisons := வரிசை புதிய.
dictionary ஒவ்வொன்றும்: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a ஒப்பிடு: b)
	).
}.

comparisons வரிசைப்படுத்து: { :a :b <- ( a ஒப்பிடு: b ). }.
வெளியீடு எழுது: ( comparisons இணை: ['↵'] ), புதிய-வரி.
comparisons இணை: ['↵'].
