60 × {
	>> x := (எண் random % 6) + 1.
	(x ≤ 6) பொய்யெனில்: { வெளியீடு எழுது: ['FAIL']. }.
	(x ≥0) பொய்யெனில்: { வெளியீடு எழுது: ['FAIL']. }.
	x := (எண் random % 3) + 1.
	(x < 3) பொய்யெனில்: { வெளியீடு எழுது: ['FAIL']. }.
	(x>-1) பொய்யெனில்: { வெளியீடு எழுது: ['FAIL']. }.
	x := ((பூலியன் flip) எண்ணாக).
	(x = 0 அல்லது: x = 1) பொய்யெனில்: { வெளியீடு எழுது: ['FAIL']. }.
	x := ((உண்மை flip) எண்ணாக).
	(x = 0 அல்லது: x = 1) பொய்யெனில்: { வெளியீடு எழுது: ['FAIL']. }.
	x := (பூலியன் flip இது: ['HEAD'] இல்லையேல்: ['TAIL']).
	((x = ['HEAD']) அல்லது: (x = ['TAIL'])) பொய்யெனில்: { வெளியீடு எழுது: ['FAIL']. }.
}.
வெளியீடு எழுது: ['DONE'].

