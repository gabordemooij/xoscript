# Test utf8 sanitizer
Server init.

>> utf8cases := அகராதி புதிய
	# ASCII only
	வை: ( வரிசை புதிய ; 65 ; 65 ; 65 ; 65 ; 0 ) திறவுகோல்: ['AAAA'],
	# valid 2 byte sequence
	வை: ( வரிசை புதிய ; 194 ; 162 ; 0 ) திறவுகோல்: ['¢'],
	# Valid 3-byte UTF-8
    வை: ( வரிசை புதிய ; 226 ; 130 ; 172 ; 0 ) திறவுகோல்: ['€'],
	# Valid 4-byte UTF-8
    வை: ( வரிசை புதிய ; 240 ; 144 ; 141 ; 136 ; 0 ) திறவுகோல்: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    வை: ( வரிசை புதிய ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) திறவுகோல்: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    வை: ( வரிசை புதிய ; 65 ; 193 ; 129 ; 0 ) திறவுகோல்: ['A?'],
	# Invalid first byte (0xFF)
    வை: ( வரிசை புதிய ; 255 ; 0 ) திறவுகோல்: ['?'],
	# Incomplete multi-byte sequence at end
    வை: ( வரிசை புதிய ; 66 ; 226 ; 0 ) திறவுகோல்: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    வை: ( வரிசை புதிய ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) திறவுகோல்: ['A€?𐍈B'].
	 
utf8cases ஒவ்வொன்றும்: { :key :value
	>> blob := Blob புதிய: value எண்ணிக்கை, bytes: value.
	>> str := blob சரமாக.
	(str = key) உண்மையெனில்: {
		வெளியீடு எழுது: ['OK'], புதிய-வரி.
	}, இல்லையெனில்: {
		வெளியீடு எழுது: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, புதிய-வரி.
	}.
	blob விடுவி.
}.
