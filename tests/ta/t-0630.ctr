#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := பாங்கு புதிய: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern பொருத்தம்: subject செய்: { :m :x
	வெளியீடு எழுது: m, புதிய-வரி.
	வெளியீடு எழுது: x, புதிய-வரி. <- ['XXX'].
}.
வெளியீடு எழுது: result, புதிய-வரி.