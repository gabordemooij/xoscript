# backslashes must survive code serialization, strings must not end early
>> மதிப்புகள் := வரிசை புதிய
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

மதிப்புகள் ஒவ்வொன்றும்: { :i :value
	>> d := அகராதி புதிய.
	d வை: value திறவுகோல்: ['k'].
	>> r := d குறிமுறை பொருளாக.
	வெளியீடு எழுது: r எண்ணிக்கை, புதிய-வரி.
	வெளியீடு எழுது: ( (r இடத்தில்: ['k']) = value ), புதிய-வரி.
}.
