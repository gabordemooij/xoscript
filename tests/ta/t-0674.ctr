# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> கோப்பு-பாதை := ['/tmp/dat.csv'].
>> csv := கோப்பு புதிய: கோப்பு-பாதை.
csv எழுது: s.

# accepts CRLF LF CR, varying row length
csv பிரிப்பான்: [';'] மேற்கோள்: ['"'] வரிகள்: { :line
	நிரல் சுத்தம்.
	வெளியீடு எழுது: line, புதிய-வரி.
	நிரல் சுத்தம்.
}.

# unequal lines
s இறுதியில்-சேர்: ['\njustone'].
csv எழுது: s.
{
	csv பிரிப்பான்: [';'] மேற்கோள்: ['"'] வரிகள்: { :line
		வெளியீடு எழுது: line, புதிய-வரி.
	}.
} பிடி: { :e 
	வெளியீடு எழுது: e, புதிய-வரி.
}, இயக்கு.

# invalid format
s := ['"he"llo";world'].
csv எழுது: s.
{
	csv பிரிப்பான்: [';'] மேற்கோள்: ['"'] வரிகள்: { :line
		வெளியீடு எழுது: line, புதிய-வரி.
	}.
} பிடி: { :e 
	வெளியீடு எழுது: e, புதிய-வரி.
}, இயக்கு.
