>> Greeter := பொருள் புதிய.
Greeter பெறும்போது: ['make'] செய்: {
	>> gr := பொருள் புதிய.
	gr பெறும்போது: ['setName:'] செய்: { :aname
		தனது பெயர் := aname.
	}.
	gr பெறும்போது: ['greet'] செய்: {
		வெளியீடு எழுது: தனது பெயர்.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a புதிய.
c setName: ['THREE'].
c greet.
>> d := a புதிய.
d setName: ['FOUR'].
d greet.
c greet.
