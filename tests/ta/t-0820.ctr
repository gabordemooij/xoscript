# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := பாங்கு புதிய: pattern.
	p பொருத்தம்: subject செய்: { :m :g
		வெளியீடு எழுது: g எண்ணிக்கை, எழுது: [' '], எழுது: (g இணை: ['|']), புதிய-வரி. <- m.
	}.
}.
show பயன்படுத்து: ['(a)|(b)'] மற்றும்: ['b'].
show பயன்படுத்து: ['(a)|(b)'] மற்றும்: ['a'].
show பயன்படுத்து: ['(x)?y'] மற்றும்: ['y'].
show பயன்படுத்து: ['(x)?(y)(z)?'] மற்றும்: ['xy'].
