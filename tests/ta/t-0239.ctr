வரிசை பெறும்போது: ['sum'] செய்: {
	>> total := 0.
	தான் ஒவ்வொன்றும்: { :index :element
		total கூட்டு: element.
	}. <- total.
}.

>> a := உண்மை.



a பெறும்போது: ['சரமாக'] செய்: {
	>> answer := வெற்று.
	( தான் = உண்மை ) உண்மையெனில்: {
		answer := ['Yep'].
	}, இல்லையெனில்: {
		answer := ['Nope'].
	}. <- answer.
}.

a பெறும்போது: ['எண்ணாக'] செய்: {
	>> answer := வெற்று.
	( தான் = உண்மை ) உண்மையெனில்: {
		answer := 10.
	}, இல்லையெனில்: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b பெறும்போது: ['சரமாக'] செய்: { <- ['Devil'].
}.

b பெறும்போது: ['பூலியனாக'] செய்: { <- பொய்.
}.


வெளியீடு எழுது: a, புதிய-வரி.  
