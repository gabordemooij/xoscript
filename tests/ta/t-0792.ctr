Server init.

>> DB := Maria-DB புதிய புரவலன்: ['localhost'],
	பயனர்-பெயர்: ['xo'],
	கடவுச்சொல்: ['pass123'],
	தரவுத்தள-பெயர்: ['xobase'],
	இணைந்திடு.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB வினவல்: SQL.

# now you don't have to set DB
query2 கொணர்: { :row
	வெளியீடு எழுது: row world, புதிய-வரி.
}.
