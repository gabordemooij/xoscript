>> phrases := வரிசை புதிய
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases ஒவ்வொன்றும்: { :_ :phrase 
	>> e := Server base64-குறியாக்கு: phrase.
	>> d := Server base64-குறிநீக்கு: e.
	வெளியீடு எழுது: (
		message நகல் ~encoded: e, ~decoded: d
	), புதிய-வரி.
}.
