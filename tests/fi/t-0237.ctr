
Teksti kun: ['arvioi'] tee: {
	>> koodi := Tiedosto uusi: ['/tmp/eval.ctr'].
	koodi kirjoita: (itse teksti + ['.']).
	Ohjelma käytä: ['/tmp/eval.ctr'].
}.

>> map :=
	(Sanakirja uusi)
	aseta: ['Moi Vaan'] kohtaan: ['two'],
	aseta: (Lista ← ['hello'] ; ['world'] ; (Lista ← 1 ; 2; 9) ; Epätosi) kohtaan: ['yksi'],
	aseta: ( (Sanakirja uusi) aseta: ['maaalma'] kohtaan: ['kirjoitusvirhe'] ) kohtaan: ['three'],
	aseta: (Lista ← ((Sanakirja uusi) aseta: ['aarre'] kohtaan: ['piilotettu']) ; 2) kohtaan: ['neljä']. 
>> str := map teksti.
>> map2 := Tyhjä.
(['map2 := '] + str ) arvioi.
Tuloste kirjoita: map2 ? ['yksi'] ? 0.
Tuloste kirjoita: map2 ? ['yksi'] ? 1.
Tuloste kirjoita: map2 ? ['neljä'] ? 0 ? ['piilotettu'].
Tuloste kirjoita: map2 ? ['yksi'] ? 2 ? 2.
