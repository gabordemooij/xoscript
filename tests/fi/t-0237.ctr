
Teksti kun: ['evaluate'] tee: {
	>> koodi := Tiedosto uusi: ['/tmp/eval.ctr'].
	koodi kirjoita: (itse teksti + ['.']).
	Ohjelma käytä: ['/tmp/eval.ctr'].
}.

>> map :=
	(Sanakirja uusi)
	aseta: ['Hi There'] kohtaan: ['two'],
	aseta: (Lista ← ['hello'] ; ['world'] ; (Lista ← 1 ; 2; 9) ; Epätosi) kohtaan: ['one'],
	aseta: ( (Sanakirja uusi) aseta: ['wrrld'] kohtaan: ['misspelled'] ) kohtaan: ['three'],
	aseta: (Lista ← ((Sanakirja uusi) aseta: ['treasure'] kohtaan: ['hidden']) ; 2) kohtaan: ['four']. 
>> str := map teksti.
>> map2 := Tyhjä.
(['map2 := '] + str ) evaluate.
Tuloste kirjoita: map2 ? ['one'] ? 0.
Tuloste kirjoita: map2 ? ['one'] ? 1.
Tuloste kirjoita: map2 ? ['four'] ? 0 ? ['hidden'].
Tuloste kirjoita: map2 ? ['one'] ? 2 ? 2.
