
>> Suorakulmio := Olio uusi.

Suorakulmio kun: ['pinta-ala'] tee: {
	<- oma pituus * oma leveys.
}.

Suorakulmio kun: ['length:'] tee: { :pituus
	oma pituus := pituus.
}.

Suorakulmio kun: ['width:'] tee: { :leveys
	oma leveys := leveys.
}.

Suorakulmio kun: ['uusi'] tee: {
	# tämä ei johda ikuiseen silmukkaan
	>> suorakulmio := itse uusi.
	suorakulmio length: 0, width: 0.
	<- suorakulmio.
}.

>> a := Suorakulmio uusi.
Tuloste kirjoita: a pinta-ala, rivinvaihto. #0

>> b := Suorakulmio uusi length: 2, width: 3.
Tuloste kirjoita: b pinta-ala, rivinvaihto. #6

