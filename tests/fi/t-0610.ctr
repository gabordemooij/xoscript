
>> Rectangle := Olio uusi.

Rectangle kun: ['area'] tee: { <- oma pituus * oma width.
}.

Rectangle kun: ['length:'] tee: { :pituus
	oma pituus := pituus.
}.

Rectangle kun: ['width:'] tee: { :width
	oma width := width.
}.

Rectangle kun: ['uusi'] tee: {
	# this will not result into an infinite loop
	>> rectangle := itse uusi.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle uusi.
Tuloste kirjoita: a area, rivinvaihto. #0

>> b := Rectangle uusi length: 2, width: 3.
Tuloste kirjoita: b area, rivinvaihto. #6

