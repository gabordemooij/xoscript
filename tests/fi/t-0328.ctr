Ohjelma muistinhallinta: 4.

>> Doubler := Olio uusi.
>> Multiplier := Olio uusi.
Doubler kun: ['double:and:'] tee: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier kun: ['multiply:and:'] tee: { :x :y <- (x × y).
}.

Tuloste kirjoita: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), rivinvaihto.
