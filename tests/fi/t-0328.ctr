Ohjelma muistinhallinta: 4.

>> Tuplaaja := Olio uusi.
>> Kertoja := Olio uusi.
Tuplaaja kun: ['tuplaa:sekä:'] tee: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Kertoja kun: ['kerro:sekä:'] tee: { :x :y <- (x × y).
}.

Tuloste kirjoita: (
	Tuplaaja tuplaa:
		(Tuplaaja tuplaa: 
			(Kertoja kerro: 2 sekä: 3)
		sekä:
			(Kertoja kerro: 3 sekä: 4)
		)
	sekä:
		(Tuplaaja tuplaa: 
			(Kertoja kerro: 2 sekä: 3)
		sekä:
			(Kertoja kerro: 3 sekä: 4)
		)
), rivinvaihto.
