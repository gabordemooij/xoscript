Server init.

Tuloste kirjoita: (
	Malli uusi: ['^\\w+$'],
	täsmää: ['test@example.com'] 
), rivinvaihto. # 0 match, fails on @ and .

Tuloste kirjoita: (
	Malli uusi: ['^[^@]+@[^\.]+\.\\w+$'],
	täsmää: ['test@example.com'] 
), rivinvaihto. # 1 match

Tuloste kirjoita: (
	Malli uusi: ['[^@]+@[^\.]+\.\\w+'],
	täsmää: ['test@example.com'] 
), rivinvaihto. # 1 match

Tuloste kirjoita: (
	Malli uusi: ['([^@]+)@([^\.]+)\.\\w+'],
	täsmää: ['test@example.com'] 
), rivinvaihto. # 1 match, groups dont matter

Tuloste kirjoita: (
	Malli uusi: ['[a-z]'],
	täsmää: ['test@example.com'] 
), rivinvaihto. # 14 matches

Tuloste kirjoita: (
	Malli uusi: ['.*'],
	täsmää: ['test@example.com'] 
), rivinvaihto. # 1 match (all)

Tuloste kirjoita: (
	Malli uusi: ['(.*)'],
	täsmää: ['test@example.com'] 
), rivinvaihto. # 1 match (all)

Tuloste kirjoita: (
	Malli uusi: ['\\s*[^@]+@[^\.]+\.\\w+'],
	täsmää: ['test@example.com'] 
), rivinvaihto. # 1 match, prefix space optional, gets ignored