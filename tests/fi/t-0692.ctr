Server init.

Tuloste kirjoita: (
	Malli uusi: ['^\\w+$'],
	täsmää: ['test@example.com'] 
), rivinvaihto. # 0 osumaa, epäonnistuu merkkeihin @ ja .

Tuloste kirjoita: (
	Malli uusi: ['^[^@]+@[^\.]+\.\\w+$'],
	täsmää: ['test@example.com'] 
), rivinvaihto. # 1 osuma

Tuloste kirjoita: (
	Malli uusi: ['[^@]+@[^\.]+\.\\w+'],
	täsmää: ['test@example.com'] 
), rivinvaihto. # 1 osuma

Tuloste kirjoita: (
	Malli uusi: ['([^@]+)@([^\.]+)\.\\w+'],
	täsmää: ['test@example.com'] 
), rivinvaihto. # 1 osuma, ryhmillä ei ole väliä

Tuloste kirjoita: (
	Malli uusi: ['[a-z]'],
	täsmää: ['test@example.com'] 
), rivinvaihto. # 14 osumaa

Tuloste kirjoita: (
	Malli uusi: ['.*'],
	täsmää: ['test@example.com'] 
), rivinvaihto. # 1 osuma (kaikki)

Tuloste kirjoita: (
	Malli uusi: ['(.*)'],
	täsmää: ['test@example.com'] 
), rivinvaihto. # 1 osuma (kaikki)

Tuloste kirjoita: (
	Malli uusi: ['\\s*[^@]+@[^\.]+\.\\w+'],
	täsmää: ['test@example.com'] 
), rivinvaihto. # 1 osuma, välilyönti alussa valinnainen, ohitetaan