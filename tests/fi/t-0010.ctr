>> Eläin := Olio uusi.
Eläin kun: ['tee-uusi'] tee: {
	>> eläin := Olio uusi.
	eläin kun: ['päästäÄäni'] tee: {
		Tuloste kirjoita: oma ääni.
	}. <- eläin.
}.
>> Kissa := Olio uusi.
Kissa kun: ['tee-uusi'] tee: {
	>> kisu := Eläin tee-uusi.
	kisu kun: ['init'] tee: {
		oma ääni := ['meow!'].
	}.
	kisu init. <- kisu.
}.
>> tom := Kissa tee-uusi.
tom päästäÄäni.
