>> Animal := Olio uusi.
Animal kun: ['make'] tee: {
	>> animal := Olio uusi.
	animal kun: ['makeSound'] tee: {
		Tuloste kirjoita: oma sound.
	}. <- animal.
}.
>> Cat := Olio uusi.
Cat kun: ['make'] tee: {
	>> cat := Animal make.
	cat kun: ['init'] tee: {
		oma sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
