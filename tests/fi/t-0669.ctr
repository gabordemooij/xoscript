# Salasanan tiivistys
Server init.

# Käyttäjä asettaa salasanan
>> salas := ['pass123'].

# Tallennat sen näin
>> tiivistearvo := Holvi 
	salasanatiiviste: salas.

# Sitten käyttäjä kirjautuu sisään
# Yritys 1
>> a1 := ['abcd123'].
# Yritys 2
>> a2 := ['pass123'].

# Varmista
>> a := Holvi 
	salasanatiiviste: tiivistearvo varmista: a1.
	# epäonnistuu 
>> b := Holvi
	salasanatiiviste: tiivistearvo varmista: a2.
	# ok!

Tuloste kirjoita: a, rivinvaihto.
Tuloste kirjoita: b, rivinvaihto.

