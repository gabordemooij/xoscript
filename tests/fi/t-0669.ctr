# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Holvi 
	salasanatiiviste: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Holvi 
	salasanatiiviste: hash varmista: a1.
	# fail 
>> b := Holvi
	salasanatiiviste: hash varmista: a2.
	# ok!

Tuloste kirjoita: a, rivinvaihto.
Tuloste kirjoita: b, rivinvaihto.

