Ohjelma muistinhallinta: 0.
Lista kun: ['summa'] tee: {
	>> yhteensä := 0.
	itse jokainen: { :indeksi :alkio
		yhteensä lisää: alkio.
	}. <- yhteensä.
}.

>> käytettyMuisti1 := 0.
>> käytettyMuisti2 := 0.
>> käytettyMuisti3 := 0.
>> käytettyMuisti4 := 0.



>> f := Tiedosto uusi: ['/tmp/test.txt'].
f kirjoita: ['Lorem Ipsum'].
f sulje.
  

f := Tiedosto uusi: ['/tmp/test.txt'].
>> tekstisisältö := f lue.
f sulje.



Ohjelma siivoa.
käytettyMuisti1 := (Ohjelma muisti ? 1).



f := Tiedosto uusi: ['/tmp/test.txt'].
tekstisisältö := f lue.
f sulje.

Ohjelma siivoa.
käytettyMuisti2 := (Ohjelma muisti ? 1).


f := Tiedosto uusi: ['/tmp/test.txt'].
tekstisisältö := f lue.
f sulje.

Ohjelma siivoa.
käytettyMuisti3 := (Ohjelma muisti ? 1).



( käytettyMuisti1 = käytettyMuisti2 ja: käytettyMuisti1 = käytettyMuisti3, ja: käytettyMuisti2 = käytettyMuisti3 ) tosi: {
	Tuloste kirjoita: ['Ei muistivuotoja täällä'].
}, epätosi: {
	Tuloste kirjoita: ['Muisti vuotaa...'].
}.
