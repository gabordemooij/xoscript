Tuloste kirjoita: ['Testiolio'], rivinvaihto.
>> p := Polku /tmp.
Tuloste kirjoita: p, rivinvaihto.
>> vanha-p-osoite := p prototyyppi muistiosoite.
p save-as: ['/tmp/a.bin'].
Tuloste kirjoita: ['========== LADATAAN SNAP UUDELLEEN:'], rivinvaihto.
>> b := Olio load-from: ['/tmp/a.bin'].
(b prototyyppi muistiosoite = vanha-p-osoite) tosi: {
	Tuloste kirjoita: ['Olion linkki liitetty uudelleen.'], rivinvaihto.
}.
Tuloste kirjoita: b, rivinvaihto.
