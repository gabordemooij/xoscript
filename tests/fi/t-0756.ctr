Tuloste kirjoita: ['Test object'], rivinvaihto.
>> greeter := Olio uusi.
greeter kun: ['name:'] tee: { :nimi
	oma xname := nimi. 
}.
greeter kun: ['greet'] tee: {
	Tuloste kirjoita: ['Hello '] + oma xname, rivinvaihto.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Tuloste kirjoita: ['========== RELOADING SNAP:'], rivinvaihto.
>> b := Olio load-from: ['/tmp/a.bin'].
>> c := Olio load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
