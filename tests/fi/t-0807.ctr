# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB uusi isäntä: ['localhost'],
	käyttäjänimi: ['xo'],
	salasana: ['pass123'],
	tietokannan-nimi: ['xobase'],
	yhdistä.

>> hakuparametrit := db kysely: ['SELECT %% FROM'].
{ hakuparametrit suorita. } sieppaa: { :e
	Tuloste kirjoita: ( e sisältyy: ['%%'] ), rivinvaihto.
}, käynnistä.
