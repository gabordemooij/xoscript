

>> Maatuska := Olio uusi.
Maatuska kun: ['double:'] tee: { :salaisuus
	oma salaisuus := salaisuus × 2.
}.
Maatuska kun: ['uusi:'] tee: { :salaisuus
	>> ratkaisu := Tyhjä.
	>> t := (salaisuus > 255).
	Tuloste kirjoita: (salaisuus + [' | '] + t), rivinvaihto.
	t tosi: {
		ratkaisu := salaisuus.
	}, muuten: {
		ratkaisu := Maatuska rekursiivinen uusi: (itse double: salaisuus).
	}. <- ratkaisu.
}.

>> x := Maatuska uusi: 2.
