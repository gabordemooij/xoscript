

>> Matryoshka := Olio uusi.
Matryoshka kun: ['double:'] tee: { :secret
	oma secret := secret × 2.
}.
Matryoshka kun: ['uusi:'] tee: { :secret
	>> answer := Tyhjä.
	>> t := (secret > 255).
	Tuloste kirjoita: (secret + [' | '] + t), rivinvaihto.
	t tosi: {
		answer := secret.
	}, muuten: {
		answer := Matryoshka rekursiivinen uusi: (itse double: secret).
	}. <- answer.
}.

>> x := Matryoshka uusi: 2.
