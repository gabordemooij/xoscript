


>> CoffeeMachine := Olio uusi.
CoffeeMachine kun: ['order:'] tee: { :id
	>> coffee := ['Americano'].
	( id = 1 ) tosi: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) tosi: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) tosi: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Olio uusi.
SimpleCoffeeMachine kun: ['order'] tee: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Tuloste kirjoita: redCup, rivinvaihto.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Tuloste kirjoita: greenCup, rivinvaihto.
>> yellowCup := CoffeeMachine order: 1.
Tuloste kirjoita: yellowCup, rivinvaihto.
>> blueCup := CoffeeMachine order: 0.
Tuloste kirjoita: blueCup, rivinvaihto.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Tuloste kirjoita: blackCup, rivinvaihto.
blackCup lisää-loppuun: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Tuloste kirjoita: orangeCup, rivinvaihto.
