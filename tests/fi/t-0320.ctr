


>> Kahvinkeitin := Olio uusi.
Kahvinkeitin kun: ['order:'] tee: { :id
	>> coffee := ['Americano'].
	( id = 1 ) tosi: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) tosi: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) tosi: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> YksinkertainenKahvinkeitin := Olio uusi.
YksinkertainenKahvinkeitin kun: ['tilaus'] tee: { <- ['Musta']. }.
>> punainenKuppi := Kahvinkeitin order: 1.
Tuloste kirjoita: punainenKuppi, rivinvaihto.
punainenKuppi := ['Tee']. 
>> vihreäKuppi := Kahvinkeitin order: 0.
Tuloste kirjoita: vihreäKuppi, rivinvaihto.
>> keltainenKuppi := Kahvinkeitin order: 1.
Tuloste kirjoita: keltainenKuppi, rivinvaihto.
>> sininenKuppi := Kahvinkeitin order: 0.
Tuloste kirjoita: sininenKuppi, rivinvaihto.
>> muovikuppi := YksinkertainenKahvinkeitin tilaus.
muovikuppi := ['Limonadi']. 
>> mustaKuppi := YksinkertainenKahvinkeitin tilaus.
Tuloste kirjoita: mustaKuppi, rivinvaihto.
mustaKuppi lisää-loppuun: [' eiii.... olutta. '].
>> oranssiKuppi := YksinkertainenKahvinkeitin tilaus.
Tuloste kirjoita: oranssiKuppi, rivinvaihto.
