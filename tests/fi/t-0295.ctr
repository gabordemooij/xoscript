
>> sanasto := (
	Sanakirja uusi
		aseta: ['b'] kohtaan: ['a'],
		aseta: ['a'] kohtaan: ['b'],
		aseta: ['z'] kohtaan: ['x'],
		aseta: ['hello'] kohtaan: ['hallo'],
		aseta: ['ihminen'] kohtaan: ['ihminen']
).

>> vertailut := Lista uusi.
sanasto jokainen: { :a :b
	vertailut ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a vertaa: b)
	).
}.

vertailut järjestä: { :a :b <- ( a vertaa: b ). }.
Tuloste kirjoita: ( vertailut yhdistä: ['↵'] ), rivinvaihto.
vertailut yhdistä: ['↵'].
