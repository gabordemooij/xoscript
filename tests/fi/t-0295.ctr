
>> dictionary := (
	Sanakirja uusi
		aseta: ['b'] kohtaan: ['a'],
		aseta: ['a'] kohtaan: ['b'],
		aseta: ['z'] kohtaan: ['x'],
		aseta: ['hello'] kohtaan: ['hallo'],
		aseta: ['human'] kohtaan: ['human']
).

>> comparisons := Lista uusi.
dictionary jokainen: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a vertaa: b)
	).
}.

comparisons järjestä: { :a :b <- ( a vertaa: b ). }.
Tuloste kirjoita: ( comparisons yhdistä: ['↵'] ), rivinvaihto.
comparisons yhdistä: ['↵'].
