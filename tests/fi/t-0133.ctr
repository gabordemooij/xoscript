


>> Deck := Lista uusi.
Deck kun: ['print'] tee: {
        >> len := itse lukumäärä - 1.
        { :i
                >> len2 := itse lukumäärä - 1.
                Tuloste kirjoita: ['len: '].
                Tuloste kirjoita: len, rivinvaihto.
                Tuloste kirjoita: ['len2: '].
                Tuloste kirjoita: len2, rivinvaihto.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
