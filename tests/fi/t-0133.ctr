


>> Pakka := Lista uusi.
Pakka kun: ['tulosta'] tee: {
        >> len := itse lukumäärä - 1.
        { :i
                >> pit2 := itse lukumäärä - 1.
                Tuloste kirjoita: ['pit: '].
                Tuloste kirjoita: len, rivinvaihto.
                Tuloste kirjoita: ['pit2: '].
                Tuloste kirjoita: pit2, rivinvaihto.
        } × len.
}.

>> d := Pakka ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d tulosta.
