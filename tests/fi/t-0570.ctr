#Linux

 >> t := Hetki uusi.
 
t aikavyöhyke: ['Europe/Amsterdam'].
t vuosi: 2020, kuukausi: 8, päivä: 2, tunti: 21, minuutti: 2, sekunti: 1.

>> a := t tunti.
>> ams := t aikavyöhyke.

t aikavyöhyke: ['US/Hawaii'].
>> b := t tunti.
>> hw := t aikavyöhyke.

Tuloste
kirjoita: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		joko: ['later'] tai: ['earlier']
	)
),
rivinvaihto.
 