
>> Eläin := Olio uusi.
Eläin kun: ['uusi'] tee: {
	<- itse uusi init.
}.

Eläin kun: ['init'] tee: {
	oma ääni := ['?'].
	oma jalat  := 4.
}.

>> Koira := Eläin uusi.
Koira kun: ['init'] tee: {
	itse init.
	oma ääni := ['haukkuu'].
}.

Eläin kun: ['teksti'] tee: {
	<- oma jalat teksti + oma ääni.
}.

>> villakoira := Koira uusi.
Tuloste kirjoita: villakoira, rivinvaihto.

