
>> Animal := Olio uusi.
Animal kun: ['uusi'] tee: { <- itse uusi init.
}.

Animal kun: ['init'] tee: {
	oma sound := ['?'].
	oma legs := 4.
}.

>> Dog := Animal uusi.
Dog kun: ['init'] tee: {
	itse init.
	oma sound := ['barks'].
}.

Animal kun: ['teksti'] tee: { <- oma legs teksti + oma sound.
}.

>> poodle := Dog uusi.
Tuloste kirjoita: poodle, rivinvaihto.

