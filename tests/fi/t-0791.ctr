Server init.

>> DB := Maria-DB uusi isäntä: ['localhost'],
	käyttäjänimi: ['xo'],
	salasana: ['pass123'],
	tietokannan-nimi: ['xobase'],
	yhdistä.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> hakuparametrit := Maria-Kysely uusi: SQL.

# set database
hakuparametrit tietokanta: DB.

hakuparametrit hae: { :row
	Tuloste kirjoita: row world, rivinvaihto.
}.
