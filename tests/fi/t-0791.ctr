Server init.

>> TK := Maria-DB uusi isäntä: ['localhost'],
	käyttäjänimi: ['xo'],
	salasana: ['pass123'],
	tietokannan-nimi: ['xobase'],
	yhdistä.
	
>> SQL := ['SELECT "hello" AS "world" '].

# luo kysely käsin
>> hakuparametrit := Maria-Kysely uusi: SQL.

# aseta tietokanta
hakuparametrit tietokanta: TK.

hakuparametrit hae: { :vaakarivi
	Tuloste kirjoita: vaakarivi world, rivinvaihto.
}.
