# testaa URL-osoitteen jäsennys

Server init.
>> url := URL lähteestä: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Tuloste kirjoita: ['skeema = '] + url skeema, rivinvaihto.
Tuloste kirjoita: ['isäntä = '] + url isäntä, rivinvaihto.
Tuloste kirjoita: ['portti = '] + url portti, rivinvaihto.
Tuloste kirjoita: ['polku = '] + url polku, rivinvaihto.
Tuloste kirjoita: ['kysely = '] + url hakuparametrit, rivinvaihto.
Tuloste kirjoita: ['fragmentti = '] + url ankkuri, rivinvaihto.
