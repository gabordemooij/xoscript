# test url parsing

Server init.
>> url := URL lähteestä: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Tuloste kirjoita: ['scheme = '] + url skeema, rivinvaihto.
Tuloste kirjoita: ['host = '] + url isäntä, rivinvaihto.
Tuloste kirjoita: ['port = '] + url portti, rivinvaihto.
Tuloste kirjoita: ['path = '] + url polku, rivinvaihto.
Tuloste kirjoita: ['query = '] + url hakuparametrit, rivinvaihto.
Tuloste kirjoita: ['fragment = '] + url ankkuri, rivinvaihto.
