# catch-all-testi (käytännöllinen)
>> HTML := Teksti uusi.
HTML kun: ['encode:'] tee: { :tekst
	itse lisää-loppuun: (tekst
	korvaa: ['&'] arvolla: ['&amp;'], 
	korvaa: ['<'] arvolla: ['&lt;'],
	korvaa: ['>'] arvolla: ['&gt;'],
	korvaa: ['"'] arvolla: ['&quot;']).
}.
>> blogi := HTML uusi.
blogi lisää-loppuun: ['<h1>'],
     encode: ['Koffie & Thee'],
     lisää-loppuun: ['</h1>'].
Tuloste kirjoita: blogi, rivinvaihto.


>> Roomalainen := Luku uusi.
Roomalainen kun: ['tekstimäinen'] tee: {
	>> a := [''].
	{ a lisää-loppuun: ['I']. } × itse. <- a.
}.

>> x := Roomalainen uusi.
x lisää: 3.
Tuloste kirjoita: x tekstimäinen, rivinvaihto.

>> Kvantti := Totuusarvo uusi.
Kvantti kun: ['true?'] tee: { <- ['ehkä Tosi']. }.
Tuloste kirjoita: (Kvantti uusi true?), rivinvaihto.

>> Nihil := Tyhjä uusi.
Nihil kun: ['teksti'] tee: { <- ['Nihil']. }.
Tuloste kirjoita: (Nihil uusi), rivinvaihto.
