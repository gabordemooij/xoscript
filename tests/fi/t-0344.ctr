# catch-all test (practical)
>> HTML := Teksti uusi.
HTML kun: ['encode:'] tee: { :tekst
	itse lisää-loppuun: (tekst
	korvaa: ['&'] arvolla: ['&amp;'], 
	korvaa: ['<'] arvolla: ['&lt;'],
	korvaa: ['>'] arvolla: ['&gt;'],
	korvaa: ['"'] arvolla: ['&quot;']).
}.
>> blog := HTML uusi.
blog lisää-loppuun: ['<h1>'],
     encode: ['Koffie & Thee'],
     lisää-loppuun: ['</h1>'].
Tuloste kirjoita: blog, rivinvaihto.


>> Roman := Luku uusi.
Roman kun: ['stringy'] tee: {
	>> a := [''].
	{ a lisää-loppuun: ['I']. } × itse. <- a.
}.

>> x := Roman uusi.
x lisää: 3.
Tuloste kirjoita: x stringy, rivinvaihto.

>> Quantum := Totuusarvo uusi.
Quantum kun: ['true?'] tee: { <- ['maybe True']. }.
Tuloste kirjoita: (Quantum uusi true?), rivinvaihto.

>> Nihil := Tyhjä uusi.
Nihil kun: ['teksti'] tee: { <- ['Nihil']. }.
Tuloste kirjoita: (Nihil uusi), rivinvaihto.
