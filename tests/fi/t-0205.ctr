>> str := ['write:'].
Tuloste viesti: ['kirjoita:'] argumentit: (Lista ← ['Hello World']), rivinvaihto. 

Luku kun: ['isbetween:and:'] tee: { :a :b <- ((itse ≥ a) ja: (itse ≤ b)).
}.

str := ['isbetween:and:'].
Tuloste kirjoita: (3 viesti: str argumentit: (Lista ← 2 ; 8)), rivinvaihto.
Tuloste kirjoita: (3 viesti: str argumentit: (Lista ← 1 ; 2)), rivinvaihto.


>> CoffeeMachine := Olio uusi.
CoffeeMachine kun: ['makeCoffeeWithSugar:milk:'] tee: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Lista ← 4 ; 2.
Tuloste kirjoita: ( CoffeeMachine viesti: order argumentit: coffeeConfiguration ), rivinvaihto.
