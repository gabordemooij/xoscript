>> str := ['write:'].
Tuloste viesti: ['kirjoita:'] argumentit: (Lista ← ['Hello World']), rivinvaihto. 

Luku kun: ['isbetween:and:'] tee: { :a :b <- ((itse ≥ a) ja: (itse ≤ b)).
}.

str := ['isbetween:and:'].
Tuloste kirjoita: (3 viesti: str argumentit: (Lista ← 2 ; 8)), rivinvaihto.
Tuloste kirjoita: (3 viesti: str argumentit: (Lista ← 1 ; 2)), rivinvaihto.


>> Kahvinkeitin := Olio uusi.
Kahvinkeitin kun: ['makeCoffeeWithSugar:milk:'] tee: { :sugar :milk <- ( ['Olkaa hyvä... kahvi, jossa '] + 
			sugar +
			[' lusikallista sokeria ja '] +
			milk +
			[' tippaa maitoa.']
	).
}.

>> tilaus := ['makeCoffeeWithSugar:milk:'].
>> kahviasetukset := Lista ← 4 ; 2.
Tuloste kirjoita: ( Kahvinkeitin viesti: tilaus argumentit: kahviasetukset ), rivinvaihto.
