

>> g  := Server uusi.
>> v  := Holvi uusi.
>> ok := 0.

>> salaisuudet := Lista uusi ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> salasanat := salaisuudet kopioi.
salasanat jokainen: { :i :p
	salaisuudet jokainen: { :n :s
		{
			>> salattu := v salaa: s avain: p.
			>> purettu := v pura-salaus: salattu avain: p.
			(purettu = s) tosi: {
				ok lisää: 1.
			}, muuten: {
				Tuloste kirjoita: ['salaus/purku epäonnistui: '], rivinvaihto.
				Tuloste kirjoita: s, rivinvaihto.
				Tuloste kirjoita: ['salattu: '] + salattu, rivinvaihto.
				Tuloste kirjoita: ['purettu: '] + salattu, rivinvaihto.
				Ohjelma lopeta.
			}.
		} sieppaa: { :virh
			(s = [''] tai: p = ['']) tosi: {
				ok lisää: 1.
			}, muuten: {
				Tuloste kirjoita: virh, rivinvaihto.
				Ohjelma lopeta.
			}.
		}, käynnistä.
	}.
}.

Tuloste kirjoita: ( ok + [' holvisalausta testattu.'] ), rivinvaihto.