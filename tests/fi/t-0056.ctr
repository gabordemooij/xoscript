>> z := Olio uusi.
z kun: ['value:'] tee: { :v
	oma value := v. <- itse.
}.
z kun: ['value'] tee: { <- oma value. }.
(z setValue: 1) value: 2.
Tuloste kirjoita: z value.
>> x := z.
Tuloste kirjoita: x value.
z := Tyhjä.
Tuloste kirjoita: z value.
Tuloste kirjoita: x value.
Tuloste kirjoita: ['hello'].
Tuloste kirjoita: 3 + 2.
Tuloste kirjoita: (3 > 2).
