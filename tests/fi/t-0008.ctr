>> Greeter := Olio uusi.
Greeter kun: ['make'] tee: {
	>> greeter := Olio uusi.
	greeter kun: ['name:'] tee: { :nimi
		Tuloste kirjoita: ['setting a name'].
		oma myName := nimi.
	}.
	greeter kun: ['greet'] tee: {
		Tuloste kirjoita: ['Hello'].
		Tuloste kirjoita: oma myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
