>> Tervehtijä := Olio uusi.
Tervehtijä kun: ['tee-uusi'] tee: {
	>> tervehtijä := Olio uusi.
	tervehtijä kun: ['name:'] tee: { :nimi
		Tuloste kirjoita: ['asetetaan nimi'].
		oma omaNimi := nimi.
	}.
	tervehtijä kun: ['tervehdi'] tee: {
		Tuloste kirjoita: ['Hello'].
		Tuloste kirjoita: oma omaNimi.
	}. <- tervehtijä.
}.
>> tervehtijä := Tervehtijä tee-uusi.
tervehtijä name: ['auringonpaiste!'].
tervehtijä tervehdi.
