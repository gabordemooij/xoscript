# istuntoevästeen muoto, json-sisältötyyppi, vain verkkoprotokollat, svg näytetään sivun sisällä
Server valmistele.
Ohjelma käytä: ['../../../src/xo/fi/webtools.xo'].

>> Vale-Pyyntö := Olio uusi.
Vale-Pyyntö kun: ['value:'] tee: { :arvo
	oma arvo := arvo.
}.
Vale-Pyyntö kun: ['cookie:'] tee: { :nimi
	<- oma arvo.
}.

>> Testi-Istunto := Väliaikaistiedosto-istunto uusi.
Testi-Istunto kun: ['lataa'] tee: {
	<- Sanakirja uusi.
}.
Testi-Istunto kun: ['istunnon-id'] tee: {
	<- oma id.
}.

>> evästeet := Lista uusi
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

evästeet jokainen: { :i :eväste
	>> pyyntö := Vale-Pyyntö uusi.
	pyyntö value: eväste.
	>> hallinta := Testi-Istunto uusi.
	>> verkkosivu := Verkkodokumentti uusi.
	verkkosivu pyyntö: pyyntö.
	verkkosivu istunnonhallinta: hallinta.
	verkkosivu aloita-istunto.
	Tuloste kirjoita: ( hallinta istunnon-id = eväste ), rivinvaihto.
}.

>> verkkosivu := Verkkodokumentti uusi.
verkkosivu json: (Sanakirja uusi aseta: ['b'] kohtaan: ['a']).
Tuloste kirjoita: ['\n'], rivinvaihto.

{ Verkko get: ['file:///etc/hostname']. } sieppaa: { :e
	Tuloste kirjoita: e, rivinvaihto.
}, käynnistä.

>> svg := Tiedosto uusi: ['/tmp/test0814.svg'].
svg kirjoita: ['<svg xmlns="x"></svg>'].
Tuloste rivinvaihto.
Server välitä: ['test0814.svg'] etuliite: ['/tmp/'].
svg poista.
