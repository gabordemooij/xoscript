Server init.
Tuloste kirjoita: ['Database time test'], rivinvaihto.

>> db := Maria-DB uusi isäntä: ['localhost'],
	käyttäjänimi: ['xo'], 
	salasana: ['pass123'],
	tietokannan-nimi: ['xobase'],
	yhdistä.

>> hakuparametrit :=
db kysely: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
hae: { :row
	Tuloste kirjoita: row timetest, rivinvaihto.
}.
