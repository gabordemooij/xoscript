>> t := Tosi.
(t = Tosi) tosi: { Tuloste kirjoita: ['T']. }.
(t = Epätosi) tosi: { Tuloste kirjoita: ['F']. }.
Tuloste kirjoita: ['|'].
>> t := Epätosi.
(t = Tosi) tosi: { Tuloste kirjoita: ['T']. }.
(t = Epätosi) tosi: { Tuloste kirjoita: ['F']. }.
Tuloste kirjoita: ['|'].
>> f := Tosi.
(t = Tosi ja: f = Epätosi) tosi: { Tuloste kirjoita: ['T']. }.
(t = Epätosi ja: f = Tosi) tosi: { Tuloste kirjoita: ['F']. }.
Tuloste kirjoita: ['|'].
>> n := Tyhjä.
(n Tyhjä?) tosi: { Tuloste kirjoita: ['T']. }.
(n Tyhjä?) epätosi: { Tuloste kirjoita: ['F']. }.
Tuloste kirjoita: ['|'].
(f Boolean?) tosi: { Tuloste kirjoita: ['T']. }.
(f Boolean?) epätosi: { Tuloste kirjoita: ['F']. }.



