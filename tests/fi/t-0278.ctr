>> To-Do := Olio uusi.

To-Do kun: ['uusi'] tee: {
	oma list := Lista uusi.
}.

To-Do kun: ['nieuw'] tee: {
	oma list := Lista uusi.
}.

To-Do kun: ['+'] tee: { :task
	oma list lisää-loppuun: task.
}.

To-Do kun: ['number of tasks?'] tee: { <-  oma list lukumäärä.
}.

>> todos := 
	To-Do uusi 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Tuloste kirjoita: ['You have $ tasks to do'] $ todos number of tasks?.
