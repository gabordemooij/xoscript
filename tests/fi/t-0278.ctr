>> Tehtävälista := Olio uusi.

Tehtävälista kun: ['uusi'] tee: {
	oma list := Lista uusi.
}.

Tehtävälista kun: ['nieuw'] tee: {
	oma list := Lista uusi.
}.

Tehtävälista kun: ['+'] tee: { :tehtävä
	oma list lisää-loppuun: tehtävä.
}.

Tehtävälista kun: ['number of tasks?'] tee: { <-  oma list lukumäärä.
}.

>> tehtävät := 
	Tehtävälista uusi 
	+ ['valmista illallinen'] 
	+ ['siivoa huone'].
	
Tuloste kirjoita: ['You have $ tasks to do'] $ tehtävät number of tasks?.
