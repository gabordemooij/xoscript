
Server init.
Tuloste kirjoita: ['Database test'], rivinvaihto.

>> db := Maria-DB uusi isäntä: ['localhost'],
	käyttäjänimi: ['xo'], 
	salasana: ['pass123'],
	tietokannan-nimi: ['xobase'],
	yhdistä.

>> hakuparametrit :=
db kysely: ['SELECT REPEAT('Blah',1000) AS blah'], 
hae: { :row 
	Tuloste kirjoita: row blah pituus, rivinvaihto.
}.
