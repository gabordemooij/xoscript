

Teksti kun: ['arvioi'] tee: {
	>> koodi := Tiedosto uusi: ['/tmp/eval.ctr'].
	koodi kirjoita: (itse teksti + ['.']).
	Ohjelma käytä: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Lista ← (['Lainausmerkit '] + Q + [' ovat pahoja?']) ; 1.
>> x := q teksti.
Tuloste kirjoita: x, rivinvaihto.
>> y := Tyhjä.
(['y := '] + x ) arvioi.
Tuloste kirjoita: y ? 0, rivinvaihto.

q := Sanakirja aseta: ['\[''] kohtaan: ['\['quote\']'].
x := q teksti.
Tuloste kirjoita: x, rivinvaihto.
y := Tyhjä.
(['y := '] + x ) arvioi.

>> q := (Sanakirja uusi) aseta:['\[''] kohtaan:['\['quote\[''].
Tuloste kirjoita: y ? ['\['quote\']'], rivinvaihto.
