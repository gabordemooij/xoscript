
Server init.
>> rq := HTTP-Pyyntö uusi.
Tuloste kirjoita: ['HTTP-GET d[]=']  + ( rq get-lista: ['d[]'] ), rivinvaihto. # GET
Tuloste kirjoita: ['HTTP-GET f[]=']  + ( rq get-lista: ['f[]'] ), rivinvaihto. # GET
Tuloste kirjoita: ['HTTP-POST e[]='] + ( rq post-lista: ['e[]'] ), rivinvaihto. # GET
Tuloste kirjoita: ['HTTP-POST c=']   + ( rq post: ['c'] ), rivinvaihto. # GET
Tuloste kirjoita: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), rivinvaihto. # GET
