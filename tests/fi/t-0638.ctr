
Server init.
>> pyy := HTTP-Pyyntö uusi.
Tuloste kirjoita: ['HTTP-GET d[]=']  + ( pyy get-lista: ['d[]'] ), rivinvaihto. # GET
Tuloste kirjoita: ['HTTP-GET f[]=']  + ( pyy get-lista: ['f[]'] ), rivinvaihto. # GET
Tuloste kirjoita: ['HTTP-POST e[]='] + ( pyy post-lista: ['e[]'] ), rivinvaihto. # GET
Tuloste kirjoita: ['HTTP-POST c=']   + ( pyy post: ['c'] ), rivinvaihto. # GET
Tuloste kirjoita: ['HTTP-POST xx=']  + ( pyy post: ['xx'] ), rivinvaihto. # GET
