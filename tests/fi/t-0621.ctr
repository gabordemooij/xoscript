>> phrases := Lista uusi
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases jokainen: { :_ :phrase 
	>> e := Server base64-koodaa: phrase.
	>> d := Server base64-pura: e.
	Tuloste kirjoita: (
		message kopioi ~encoded: e, ~decoded: d
	), rivinvaihto.
}.
