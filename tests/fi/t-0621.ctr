>> fraasit := Lista uusi
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> sanoma := ['Phrase: ~decoded base64: ~encoded'].
	
fraasit jokainen: { :_ :fraasi 
	>> e := Server base64-koodaa: fraasi.
	>> d := Server base64-pura: e.
	Tuloste kirjoita: (
		sanoma kopioi ~encoded: e, ~decoded: d
	), rivinvaihto.
}.
