Totuusarvo kun: ['xor:'] tee: { :a :b <- ((a ja: b ei) tai: (a ei ja: b)).
}.

>> o := Olio uusi.
o kun: ['hello'] tee: { ['Empty']. }.
{ o kun: 2 tee: 3.} sieppaa: { :e Tuloste kirjoita: e, rivinvaihto. }, käynnistä.
{ o kun: ['testi'] tee: 3.} sieppaa: { :e Tuloste kirjoita: e, rivinvaihto. }, käynnistä.
{ o kun: ['hello'] tee: { ['Empty']. }.} sieppaa: { :e Tuloste kirjoita: e, rivinvaihto. }, käynnistä. 
{ >> z := 4 ÷ 0. } sieppaa: { :e Tuloste kirjoita: e, rivinvaihto. }, käynnistä. 
