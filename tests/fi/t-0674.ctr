# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> polku := ['/tmp/dat.csv'].
>> csv := Tiedosto uusi: polku.
csv kirjoita: s.

# accepts CRLF LF CR, varying row length
csv erotin: [';'] lainausmerkki: ['"'] rivit: { :line
	Ohjelma siivoa.
	Tuloste kirjoita: line, rivinvaihto.
	Ohjelma siivoa.
}.

# unequal lines
s lisää-loppuun: ['\njustone'].
csv kirjoita: s.
{
	csv erotin: [';'] lainausmerkki: ['"'] rivit: { :line
		Tuloste kirjoita: line, rivinvaihto.
	}.
} sieppaa: { :e 
	Tuloste kirjoita: e, rivinvaihto.
}, käynnistä.

# invalid format
s := ['"he"llo";world'].
csv kirjoita: s.
{
	csv erotin: [';'] lainausmerkki: ['"'] rivit: { :line
		Tuloste kirjoita: line, rivinvaihto.
	}.
} sieppaa: { :e 
	Tuloste kirjoita: e, rivinvaihto.
}, käynnistä.
