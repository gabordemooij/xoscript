# onnistunut kulku
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> polku := ['/tmp/dat.csv'].
>> csv := Tiedosto uusi: polku.
csv kirjoita: s.

# hyväksyy CRLF LF CR, rivin pituus vaihtelee
csv erotin: [';'] lainausmerkki: ['"'] rivit: { :line
	Ohjelma siivoa.
	Tuloste kirjoita: line, rivinvaihto.
	Ohjelma siivoa.
}.

# erimittaiset rivit
s lisää-loppuun: ['\njustone'].
csv kirjoita: s.
{
	csv erotin: [';'] lainausmerkki: ['"'] rivit: { :line
		Tuloste kirjoita: line, rivinvaihto.
	}.
} sieppaa: { :e 
	Tuloste kirjoita: e, rivinvaihto.
}, käynnistä.

# virheellinen muoto
s := ['"he"llo";world'].
csv kirjoita: s.
{
	csv erotin: [';'] lainausmerkki: ['"'] rivit: { :line
		Tuloste kirjoita: line, rivinvaihto.
	}.
} sieppaa: { :e 
	Tuloste kirjoita: e, rivinvaihto.
}, käynnistä.
