# Tämä testi tarkistaa, ettei string_fill_in menetä paikkaansa (gc'ed) tilassa 4
# viittaus tiedostossa world.c
>> Loki := Olio uusi.

Loki kun: ['say:'] tee: { :str
	Tuloste kirjoita: str, rivinvaihto.
}.

>> Esine := Olio uusi.

Esine kun: ['uusi:'] tee: { :id
	<- itse uusi id: id.
}.

Esine kun: ['id:'] tee: { :id
	oma id := id.
}.

Esine kun: ['id'] tee: { <- oma id. }.


Esine kun: ['teksti'] tee: {
	>> str := ['Item#~no'].
	str ~no: oma id.
	<- str.
}.


>> Print := Olio uusi.

Print kun: ['items'] tee: { 
	
	oma esine := Esine uusi: 1.
	
	# joko segfault tai väärä merkkijono tässä
	Loki say: (
		['~item printed.'] ~item: oma esine
	).
	
	
}.

Print items.