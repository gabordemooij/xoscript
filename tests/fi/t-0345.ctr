# test catch-all methods
>> x13 := Olio uusi.
x13 kun: ['a'] tee: { :a Tuloste kirjoita: 0, rivinvaihto. }.
x13 kun: ['a:'] tee: { :a Tuloste kirjoita: a, rivinvaihto. <- 5. }.
x13 kun: ['a:b:'] tee: { :a :b Tuloste kirjoita: (a + b), rivinvaihto. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
