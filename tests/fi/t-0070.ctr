>> numbers := ['1,2,3'] jaa: [','].
Tuloste kirjoita: ['I got: '] + numbers lukumäärä + [' numbers.'],rivinvaihto.
{ :i Tuloste kirjoita: ['number #'] + i + [':'] + (numbers sijainti: i), rivinvaihto.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages jaa: [' Or '].
Tuloste kirjoita: ['We serve'], rivinvaihto.
{ :i Tuloste kirjoita: ['->'] + (beverages sijainti: i), rivinvaihto. } × (beverages lukumäärä).
Tuloste kirjoita: (beverages yhdistä: [',']), rivinvaihto.
Tuloste kirjoita: (numbers yhdistä: ['||']).
