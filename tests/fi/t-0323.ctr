

Ohjelma siivoa.


>> Veggy := Olio uusi.
Veggy kun: ['uusi'] tee: {
	>> v := itse uusi.
	v init. <- v.
}.

Veggy kun: ['init'] tee: { oma veggies := 0. }.

Veggy kun: ['carrots:'] tee: { :a oma veggies := a. <- Tyhjä. }.
Veggy kun: ['carrots'] tee: { <- oma veggies. }.
Veggy kun: ['+'] tee: { :f
	>> n := Veggy uusi.
	n carrots: (f carrots + oma veggies). <- n.
}.

Veggy kun: ['teksti'] tee: { <- oma veggies teksti.
}.

Luku kun: ['carrots'] tee: {
	>> x := Veggy uusi.
	x carrots: itse. <- x.
}.

Luku kun: ['add:and:'] tee: { :a :b <- (a + b).
}.

>> q := 0 add: (3 carrots + 2 carrots) and: 4 carrots.
Tuloste kirjoita: q, rivinvaihto.
