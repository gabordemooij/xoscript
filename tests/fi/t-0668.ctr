# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob uusi: 8, bytes: (
	Lista uusi ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Tuloste kirjoita: ( utf16 pura: ['utf16le'] ), rivinvaihto.

utf16 vapauta.
>> utf32 := Blob uusi: 13, bytes: (
	Lista uusi ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Tuloste kirjoita: ( utf32 pura: ['utf32be'] ), rivinvaihto.
utf32 vapauta.