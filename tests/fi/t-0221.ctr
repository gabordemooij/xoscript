>> x := Olio uusi.
>> y := Olio uusi.
>> z := x.
Tuloste kirjoita: (x = z), rivinvaihto.
Tuloste kirjoita: (x = y), rivinvaihto.
Tuloste kirjoita: (x ≠ y), rivinvaihto.
Tuloste kirjoita: (x ≠ z), rivinvaihto.
>> m := Hetki uusi vuosi: 2070, kuukausi: 11.
>> n := m kopioi.
Tuloste kirjoita: (m = n), rivinvaihto.
Tuloste kirjoita: (m ≠ n), rivinvaihto.
Tuloste kirjoita: (m sama-kuin: m), rivinvaihto.
Tuloste kirjoita: (m sama-kuin: n), rivinvaihto.
n kuukausi: 12.
Tuloste kirjoita: (m ≠ n), rivinvaihto.
Tuloste kirjoita: (m = n), rivinvaihto.


