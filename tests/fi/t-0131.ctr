
>> a := Lista ← (Lista ← 100 ; 200 ; 300) ; (Lista ← 9 ; 8 ; 7).
Tuloste kirjoita: ['at 0,1 :'].
Tuloste kirjoita: a ? 0 ? 1, rivinvaihto. 
Tuloste kirjoita: ['at 1,2 :'].
Tuloste kirjoita: a ? 1 ? 2, rivinvaihto. 
>> menu := Sanakirja uusi.
menu aseta: (Lista ← ['pizza'] ; ['spaghetti']) kohtaan: ['Italian Cuisine'].
menu aseta: (Lista ← ['bifteki'] ; ['suflaki']) kohtaan: ['Greek Cuisine'].
Tuloste kirjoita: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), rivinvaihto. 
Tuloste kirjoita: ['but not on the same plate.'], rivinvaihto.
