
>> a := Lista ← (Lista ← 100 ; 200 ; 300) ; (Lista ← 9 ; 8 ; 7).
Tuloste kirjoita: ['kohdassa 0,1 :'].
Tuloste kirjoita: a ? 0 ? 1, rivinvaihto. 
Tuloste kirjoita: ['kohdassa 1,2 :'].
Tuloste kirjoita: a ? 1 ? 2, rivinvaihto. 
>> ruokalista := Sanakirja uusi.
ruokalista aseta: (Lista ← ['pizza'] ; ['spagetti']) kohtaan: ['Italialainen keittiö'].
ruokalista aseta: (Lista ← ['bifteki'] ; ['suflaki']) kohtaan: ['Kreikkalainen keittiö'].
Tuloste kirjoita: ['Rakastan '] + (ruokalista ? ['Kreikkalainen keittiö'] ? 0) + [' ja '] + (ruokalista ? ['Italialainen keittiö'] ? 1), rivinvaihto. 
Tuloste kirjoita: ['mutta en samalta lautaselta.'], rivinvaihto.
