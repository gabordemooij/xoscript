# a value ending in the first part of an opening quote must survive serialization
>> arvot := Lista uusi
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

arvot jokainen: { :i :value
	>> d := Sanakirja uusi.
	d aseta: value kohtaan: ['k'].
	d aseta: ['second'] kohtaan: ['j'].
	>> r := d koodi olio.
	Tuloste kirjoita: r lukumäärä, rivinvaihto.
	Tuloste kirjoita: ( (r kohdassa: ['k']) = value ), rivinvaihto.
}.
