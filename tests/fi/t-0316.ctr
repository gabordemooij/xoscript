>> Grandfather := Olio uusi.
Grandfather kun: ['greet'] tee: {
	Tuloste kirjoita: ['Ave!'], rivinvaihto.
}.
>> Father := Grandfather uusi.
Father kun: ['greet'] tee: {
	Tuloste kirjoita: ['Hello'], rivinvaihto.
	itse greet.
}.
>> Son := Father uusi.
Son kun: ['greet'] tee: {
	Tuloste kirjoita: ['Hi'], rivinvaihto.
	itse greet.
}.

Son greet.

>> Roundabout := Olio uusi.
Roundabout kun: ['circle:'] tee: { :x
	Tuloste kirjoita: x, rivinvaihto.
	(x < 3) tosi: { itse rekursiivinen circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) tosi: { Tuloste kirjoita: x, rivinvaihto. x lisää: 1.  increment käynnistä. }. }.
increment käynnistä.