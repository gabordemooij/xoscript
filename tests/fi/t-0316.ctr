>> Isoisä := Olio uusi.
Isoisä kun: ['tervehdi'] tee: {
	Tuloste kirjoita: ['Ave!'], rivinvaihto.
}.
>> Isä := Isoisä uusi.
Isä kun: ['tervehdi'] tee: {
	Tuloste kirjoita: ['Hello'], rivinvaihto.
	itse tervehdi.
}.
>> Poika := Isä uusi.
Poika kun: ['tervehdi'] tee: {
	Tuloste kirjoita: ['Moi'], rivinvaihto.
	itse tervehdi.
}.

Poika tervehdi.

>> Liikenneympyrä := Olio uusi.
Liikenneympyrä kun: ['circle:'] tee: { :x
	Tuloste kirjoita: x, rivinvaihto.
	(x < 3) tosi: { itse rekursiivinen circle: x + 1. }.
}.

Liikenneympyrä circle: 1.

>> x := 1.
>> kasvata := { (x ≤ 3) tosi: { Tuloste kirjoita: x, rivinvaihto. x lisää: 1.  kasvata käynnistä. }. }.
kasvata käynnistä.