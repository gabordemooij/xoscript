#Linux
>> clock := Hetki uusi.
clock aikavyöhyke: ['UTC-1'].
clock vuosi: 1981, kuukausi: 1, päivä: 5,
      tunti: 13, minuutti: 15, sekunti: 13.

Tuloste kirjoita: clock, rivinvaihto.
clock aikavyöhyke: ['UTC+0'].

Tuloste kirjoita: (
	(clock vuosi pelkkä) + ['-'] + (clock kuukausi) + ['-'] + (clock päivä) + [' '] +
	(clock tunti) + [':'] + (clock minuutti) + [':'] + (clock sekunti) + [' '] +
	['W'] + (clock viikko) + (clock aikavyöhyke)
), rivinvaihto.


clock aikavyöhyke: ['UTC-1'].
Tuloste kirjoita: (
	(clock vuosi pelkkä) + ['-'] + (clock kuukausi) + ['-'] + (clock päivä) + [' '] +
	(clock tunti) + [':'] + (clock minuutti) + [':'] + (clock sekunti) + [' '] +
	['W'] + (clock viikko) + (clock aikavyöhyke)
), rivinvaihto.
