#Linux
>> kello := Hetki uusi.
kello aikavyöhyke: ['UTC-1'].
kello vuosi: 1981, kuukausi: 1, päivä: 5,
      tunti: 13, minuutti: 15, sekunti: 13.

Tuloste kirjoita: kello, rivinvaihto.
kello aikavyöhyke: ['UTC+0'].

Tuloste kirjoita: (
	(kello vuosi pelkkä) + ['-'] + (kello kuukausi) + ['-'] + (kello päivä) + [' '] +
	(kello tunti) + [':'] + (kello minuutti) + [':'] + (kello sekunti) + [' '] +
	['W'] + (kello viikko) + (kello aikavyöhyke)
), rivinvaihto.


kello aikavyöhyke: ['UTC-1'].
Tuloste kirjoita: (
	(kello vuosi pelkkä) + ['-'] + (kello kuukausi) + ['-'] + (kello päivä) + [' '] +
	(kello tunti) + [':'] + (kello minuutti) + [':'] + (kello sekunti) + [' '] +
	['W'] + (kello viikko) + (kello aikavyöhyke)
), rivinvaihto.
