>> items := Sanakirja uusi.
items aseta: ['musta'] kohtaan: ['coffee'], aseta: ['earl grey'] kohtaan: ['tee'].
Tuloste kirjoita: (items kohdassa: ['coffee']), kirjoita: (items kohdassa: ['tee']).
Tuloste kirjoita: ['yhteensä'] + items lukumäärä + [' alkiota taulukossa.'].
items aseta: ['cappuccino'] kohtaan: ['coffee'].
Tuloste kirjoita: ['Nyt kahvini on.. '] + (items kohdassa: ['coffee']).
items aseta: ['aaa'] kohtaan: ['1'].
items aseta: ['bbb'] kohtaan: ['2'].
Tuloste kirjoita: (items kohdassa: ['a']).
