>> items := Sanakirja uusi.
items aseta: ['black'] kohtaan: ['coffee'], aseta: ['earl grey'] kohtaan: ['tea'].
Tuloste kirjoita: (items kohdassa: ['coffee']), kirjoita: (items kohdassa: ['tea']).
Tuloste kirjoita: ['there are'] + items lukumäärä + [' items in the array.'].
items aseta: ['capuccino'] kohtaan: ['coffee'].
Tuloste kirjoita: ['Now my coffee is.. '] + (items kohdassa: ['coffee']).
items aseta: ['aaa'] kohtaan: ['1'].
items aseta: ['bbb'] kohtaan: ['2'].
Tuloste kirjoita: (items kohdassa: ['a']).
