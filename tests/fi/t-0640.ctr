
Server init.
Tuloste kirjoita: ['Database test'], rivinvaihto.

>> db := Maria-DB uusi isäntä: ['localhost'],
	käyttäjänimi: ['xo'], 
	salasana: ['pass123'],
	tietokannan-nimi: ['xobase'],
	yhdistä.

>> hakuparametrit :=
db kysely: ['SELECT UNHEX('CAFE') AS blobby'],
hae: { :row
	Tuloste kirjoita: ( row blobby alkaen: 0 pituus: 2 ), rivinvaihto.
	row blobby vapauta.
}.
