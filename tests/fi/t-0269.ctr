#Linux

(Tiedosto uusi: ['/tmp/testje']) on-olemassa epätosi: {
	Ohjelma järjestelmä: ['mkdir /tmp/testje'].	
}.

(Tiedosto uusi: ['/tmp/testje/file1']) on-olemassa epätosi: {
	Ohjelma järjestelmä: ['touch /tmp/testje/file1'].	
}.

(Tiedosto uusi: ['/tmp/testje/folder1']) on-olemassa epätosi: {
	Ohjelma järjestelmä: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Tiedosto lista: ['/tmp/testje'].

>> q := Lista uusi.

l jokainen: { :k :v v jokainen: { :x :y q lisää-loppuun: y. }. }.

>> s := q teksti.

(s sisältyy: ['file1']) tosi:   { Tuloste kirjoita: ['OK'], rivinvaihto. }.
(s sisältyy: ['file2']) tosi:   { Tuloste kirjoita: ['XX'], rivinvaihto. }.
(s sisältyy: ['folder1']) tosi: { Tuloste kirjoita: ['OK'], rivinvaihto. }.
