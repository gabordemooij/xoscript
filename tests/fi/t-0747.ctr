Tuloste kirjoita: ['Testiolio'], rivinvaihto.
>> a := Olio uusi. 

a kun: ['item:'] tee: { :num
	oma num := num. 
}.

a kun: ['esine'] tee: {
	<- oma num.
}.

a item: 123.

Tuloste kirjoita: a esine, rivinvaihto.

>> vanha-nro-osoite := a esine prototyyppi muistiosoite.
a save-as: ['/tmp/a.bin'].
Tuloste kirjoita: ['========== LADATAAN SNAP UUDELLEEN:'], rivinvaihto.

>> b := Olio load-from: ['/tmp/a.bin'].

(b esine prototyyppi muistiosoite = vanha-nro-osoite) tosi: {
	Tuloste kirjoita: ['Olion linkki liitetty uudelleen.'], rivinvaihto.
}.

Tuloste kirjoita: b esine, rivinvaihto.
