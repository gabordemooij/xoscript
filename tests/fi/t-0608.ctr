
>> Size := Olio uusi.
Size kun: ['is:'] tee: { :luku
	luku kun: ['+'] tee: { :luku
		>> unit := luku määrite.
		>> factor := 1.
		
		unit
		tapaus: ['inch'] tee: { factor := 0.0833. }. <- itse + (luku * factor).
	}. <- luku.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Tuloste kirjoita: plank + edge, rivinvaihto.
