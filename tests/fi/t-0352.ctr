Luku kun: ['roman'] tee: {
	>> luku := itse kopioi.
	>> roman := [''].
	{
		{
			(luku ≥ 1000) tosi: {
				roman lisää-loppuun: ['Ⅿ'].
				luku vähennä: 1000.
			}, keskeytä.
		
			(luku ≥ 500) tosi: {
				roman lisää-loppuun: ['Ⅾ'].
				luku vähennä: 500.
			}, keskeytä.
		
			(luku ≥ 100) tosi: {
				roman lisää-loppuun: ['Ⅽ'].
				luku vähennä: 100.
			}, keskeytä.
		
			(luku ≥ 50) tosi: {
				roman lisää-loppuun: ['Ⅼ'].
				luku vähennä: 50.
			}, keskeytä.
		
			(luku ≥ 50) tosi: {
				roman lisää-loppuun: ['Ⅼ'].
				luku vähennä: 50.
			}, keskeytä.
		
			(luku ≥ 10) tosi: {
				roman lisää-loppuun: ['Ⅹ'].
				luku vähennä: 10.
			}, keskeytä.
			
			(luku ≥ 9) tosi: {
				roman lisää-loppuun: ['Ⅸ'].
				luku vähennä: 9.
			}, keskeytä.
			
			(luku ≥ 5) tosi: {
				roman lisää-loppuun: ['Ⅴ'].
				luku vähennä: 5.
			}, keskeytä.
			
			(luku ≥ 4) tosi: {
				roman lisää-loppuun: ['Ⅳ'].
				luku vähennä: 4.
			}, keskeytä.
			
			(luku ≥ 1) tosi: {
				roman lisää-loppuun: ['Ⅰ'].
				luku vähennä: 1.
			}, keskeytä.
		} proseduuri.
	} kun: { <- luku > 0. }. <- roman.
}.

Tuloste kirjoita: 1 roman, rivinvaihto.
Tuloste kirjoita: 2 roman, rivinvaihto.
Tuloste kirjoita: 4 roman, rivinvaihto.
Tuloste kirjoita: 8 roman, rivinvaihto.
Tuloste kirjoita: 16 roman, rivinvaihto.
Tuloste kirjoita: 32 roman, rivinvaihto.
Tuloste kirjoita: 64 roman, rivinvaihto.
Tuloste kirjoita: 128 roman, rivinvaihto.
Tuloste kirjoita: 256 roman, rivinvaihto.
Tuloste kirjoita: 1024 roman, rivinvaihto.
