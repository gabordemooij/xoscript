Luku kun: ['roomalainen'] tee: {
	>> luku := itse kopioi.
	>> roomalainen := [''].
	{
		{
			(luku ≥ 1000) tosi: {
				roomalainen lisää-loppuun: ['Ⅿ'].
				luku vähennä: 1000.
			}, keskeytä.
		
			(luku ≥ 500) tosi: {
				roomalainen lisää-loppuun: ['Ⅾ'].
				luku vähennä: 500.
			}, keskeytä.
		
			(luku ≥ 100) tosi: {
				roomalainen lisää-loppuun: ['Ⅽ'].
				luku vähennä: 100.
			}, keskeytä.
		
			(luku ≥ 50) tosi: {
				roomalainen lisää-loppuun: ['Ⅼ'].
				luku vähennä: 50.
			}, keskeytä.
		
			(luku ≥ 50) tosi: {
				roomalainen lisää-loppuun: ['Ⅼ'].
				luku vähennä: 50.
			}, keskeytä.
		
			(luku ≥ 10) tosi: {
				roomalainen lisää-loppuun: ['Ⅹ'].
				luku vähennä: 10.
			}, keskeytä.
			
			(luku ≥ 9) tosi: {
				roomalainen lisää-loppuun: ['Ⅸ'].
				luku vähennä: 9.
			}, keskeytä.
			
			(luku ≥ 5) tosi: {
				roomalainen lisää-loppuun: ['Ⅴ'].
				luku vähennä: 5.
			}, keskeytä.
			
			(luku ≥ 4) tosi: {
				roomalainen lisää-loppuun: ['Ⅳ'].
				luku vähennä: 4.
			}, keskeytä.
			
			(luku ≥ 1) tosi: {
				roomalainen lisää-loppuun: ['Ⅰ'].
				luku vähennä: 1.
			}, keskeytä.
		} proseduuri.
	} kun: { <- luku > 0. }. <- roomalainen.
}.

Tuloste kirjoita: 1 roomalainen, rivinvaihto.
Tuloste kirjoita: 2 roomalainen, rivinvaihto.
Tuloste kirjoita: 4 roomalainen, rivinvaihto.
Tuloste kirjoita: 8 roomalainen, rivinvaihto.
Tuloste kirjoita: 16 roomalainen, rivinvaihto.
Tuloste kirjoita: 32 roomalainen, rivinvaihto.
Tuloste kirjoita: 64 roomalainen, rivinvaihto.
Tuloste kirjoita: 128 roomalainen, rivinvaihto.
Tuloste kirjoita: 256 roomalainen, rivinvaihto.
Tuloste kirjoita: 1024 roomalainen, rivinvaihto.
