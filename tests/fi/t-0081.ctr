>> kartta1 := Sanakirja uusi.
>> avain1 := Lista uusi.
>> avain2 := Lista uusi.

kartta1
	aseta: ['hello'] kohtaan: avain1,
	aseta: ['world'] kohtaan: avain2.


Tuloste
	kirjoita: ['Map #1 contains: '] + (kartta1 kohdassa: avain1),
	kirjoita: [' ja '] + (kartta1 kohdassa: avain2), rivinvaihto.

>> AvainnettavaLista := Lista uusi.
AvainnettavaLista kun: ['tekstiksi'] tee: { <- (itse lukumäärä) tekstiksi.
}.

>> map2 := Sanakirja uusi.
avain1 := AvainnettavaLista uusi.
avain2 := AvainnettavaLista uusi.

avain1 lisää-loppuun: 1.

map2
	aseta: ['hello'] kohtaan: avain1,
	aseta: ['world'] kohtaan: avain2.

Tuloste
	kirjoita: ['Map #2 contains: '] + (map2 kohdassa: avain1),
	kirjoita: [' ja '] + (map2 kohdassa: avain2), rivinvaihto.
