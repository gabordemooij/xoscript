>> map1 := Sanakirja uusi.
>> key1 := Lista uusi.
>> key2 := Lista uusi.

map1
	aseta: ['hello'] kohtaan: key1,
	aseta: ['world'] kohtaan: key2.


Tuloste
	kirjoita: ['Map #1 contains: '] + (map1 kohdassa: key1),
	kirjoita: [' and '] + (map1 kohdassa: key2), rivinvaihto.

>> KeyeableArray := Lista uusi.
KeyeableArray kun: ['toString'] tee: { <- (itse lukumäärä) toString.
}.

>> map2 := Sanakirja uusi.
key1 := KeyeableArray uusi.
key2 := KeyeableArray uusi.

key1 lisää-loppuun: 1.

map2
	aseta: ['hello'] kohtaan: key1,
	aseta: ['world'] kohtaan: key2.

Tuloste
	kirjoita: ['Map #2 contains: '] + (map2 kohdassa: key1),
	kirjoita: [' and '] + (map2 kohdassa: key2), rivinvaihto.
