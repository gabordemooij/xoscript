


>> käytettyMuisti1 := 0.
>> käytettyMuisti2 := 0.
>> käytettyMuisti3 := 0.
>> käytettyMuisti4 := 0.

Ohjelma muistinhallinta: 0.
>> paletti := Tyhjä.
>> värit := Tyhjä.

{
paletti := Sanakirja uusi.
paletti 
	aseta: ['#F00'] kohtaan: ['punainen'],
	aseta: ['#0F0'] kohtaan: ['vihreä'],
	aseta: ['#00F'] kohtaan: ['sininen'].
Tuloste kirjoita: ['RGB-koodien määrä paletissa: '] + ( paletti lukumäärä ), rivinvaihto.
Tuloste kirjoita: ['vihreän RGB-koodi on: '] + ( paletti ? ['vihreä'] ), rivinvaihto.
värit := [''].
( paletti jokainen: { :nimi :koodi
		värit := värit + ( nimi + [':'] + koodi ).
} ).
Tuloste kirjoita: ['Kaikki paletin värit: '] + värit, rivinvaihto.
} käynnistä.
Ohjelma siivoa.
käytettyMuisti1 := (Ohjelma muisti ? 0).

