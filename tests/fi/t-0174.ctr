( usedMemory1 = usedMemory2 ja: usedMemory1 = usedMemory3, ja: usedMemory2 = usedMemory3 ) tosi: {
	Tuloste kirjoita: ['No memory leaks here'].
}, epätosi: {
	Tuloste kirjoita: ['Leaking memory...'].
}.
