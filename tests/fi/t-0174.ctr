


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Ohjelma muistinhallinta: 0.
>> palette := Tyhjä.
>> colors := Tyhjä.

{
palette := Sanakirja uusi.
palette 
	aseta: ['#F00'] kohtaan: ['red'],
	aseta: ['#0F0'] kohtaan: ['green'],
	aseta: ['#00F'] kohtaan: ['blue'].
Tuloste kirjoita: ['number of RGB codes in palette: '] + ( palette lukumäärä ), rivinvaihto.
Tuloste kirjoita: ['RGB code of green is: '] + ( palette ? ['green'] ), rivinvaihto.
colors := [''].
( palette jokainen: { :nimi :koodi
		colors := colors + ( nimi + [':'] + koodi ).
} ).
Tuloste kirjoita: ['All colors in palette: '] + colors, rivinvaihto.
} käynnistä.
Ohjelma siivoa.
usedMemory1 := (Ohjelma muisti ? 0).

