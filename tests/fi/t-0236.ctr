>> Slurp := Olio uusi.
Slurp kun: ['uusi'] tee: {
	oma str := [''].
}.


Slurp kun: ['vastaa:'] tee: { :blah
		(oma str ≠ ['']) tosi: {
			oma str lisää-loppuun: [' '].
		}.
		oma str lisää-loppuun: blah.
}.
Slurp kun: ['vastaa:ja:'] tee: { :blah :blahah
		(oma str ≠ ['']) tosi: {
			oma str lisää-loppuun: [' '].
		}.
		(blah pituus > 1) tosi: {
			oma str lisää-loppuun: (blah alkaen: 0 pituus: (blah pituus - 1)).
		}, muuten: {
			oma str lisää-loppuun: blah.
		}.
		oma str lisää-loppuun: [' '].
		oma str lisää-loppuun: blahah.
}.
Slurp kun: ['obtain'] tee: {
	>> buffer := oma str.
	oma str := ['']. <- buffer.
}.

>> hakuparametrit := Slurp uusi.
hakuparametrit select: ['*'], from users where: ['id = 2'].
Tuloste kirjoita: (hakuparametrit obtain), rivinvaihto.
