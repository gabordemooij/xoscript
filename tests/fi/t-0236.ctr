>> Hörppy := Olio uusi.
Hörppy kun: ['uusi'] tee: {
	oma str := [''].
}.


Hörppy kun: ['vastaa:'] tee: { :blah
		(oma str ≠ ['']) tosi: {
			oma str lisää-loppuun: [' '].
		}.
		oma str lisää-loppuun: blah.
}.
Hörppy kun: ['vastaa:ja:'] tee: { :blah :blahah
		(oma str ≠ ['']) tosi: {
			oma str lisää-loppuun: [' '].
		}.
		(blah pituus > 1) tosi: {
			oma str lisää-loppuun: (blah alkaen: 0 pituus: (blah pituus - 1)).
		}, muuten: {
			oma str lisää-loppuun: blah.
		}.
		oma str lisää-loppuun: [' '].
		oma str lisää-loppuun: blahah.
}.
Hörppy kun: ['hanki'] tee: {
	>> puskuri := oma str.
	oma str := ['']. <- puskuri.
}.

>> hakuparametrit := Hörppy uusi.
hakuparametrit select: ['*'], from käyttäjät where: ['id = 2'].
Tuloste kirjoita: (hakuparametrit hanki), rivinvaihto.
