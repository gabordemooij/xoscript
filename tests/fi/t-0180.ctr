Teksti kun: ['html'] tee: { <- (
		itse
		korvaa: ['&'] arvolla: ['&amp;'],
		korvaa: ['<'] arvolla: ['&lt;'],
		korvaa: ['>'] arvolla: ['&gt;'],
		korvaa: ['''] arvolla: ['&apos;'],
		korvaa: ['"'] arvolla: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Ohjelma muistinhallinta: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Tuloste kirjoita: txt kopioi html, rivinvaihto.
Tuloste kirjoita: txt kopioi pienet-kirjaimet, rivinvaihto.
Tuloste kirjoita: txt kopioi isot-kirjaimet, rivinvaihto.
} käynnistä.

Ohjelma siivoa.

usedMemory1 := (Ohjelma muisti ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Tuloste kirjoita: txt kopioi html, rivinvaihto.
Tuloste kirjoita: txt kopioi pienet-kirjaimet, rivinvaihto.
Tuloste kirjoita: txt kopioi isot-kirjaimet, rivinvaihto.
} käynnistä.

Ohjelma siivoa.
usedMemory2 := (Ohjelma muisti ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Tuloste kirjoita: txt kopioi html, rivinvaihto.
Tuloste kirjoita: txt kopioi pienet-kirjaimet, rivinvaihto.
Tuloste kirjoita: txt kopioi isot-kirjaimet, rivinvaihto.
} käynnistä.

Ohjelma siivoa.
usedMemory3 := (Ohjelma muisti ? 0).



( usedMemory1 = usedMemory2 ja: usedMemory1 = usedMemory3, ja: usedMemory2 = usedMemory3 ) tosi: {
	Tuloste kirjoita: ['No memory leaks here'].
}, epätosi: {
	Tuloste kirjoita: ['Leaking memory...'].
}.
