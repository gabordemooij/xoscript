Teksti kun: ['html'] tee: { <- (
		itse
		korvaa: ['&'] arvolla: ['&amp;'],
		korvaa: ['<'] arvolla: ['&lt;'],
		korvaa: ['>'] arvolla: ['&gt;'],
		korvaa: ['''] arvolla: ['&apos;'],
		korvaa: ['"'] arvolla: ['&quot;']
	).
}.

>> käytettyMuisti1 := 0.
>> käytettyMuisti2 := 0.
>> käytettyMuisti3 := 0.
>> käytettyMuisti4 := 0.

Ohjelma muistinhallinta: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Tuloste kirjoita: txt kopioi html, rivinvaihto.
Tuloste kirjoita: txt kopioi pienet-kirjaimet, rivinvaihto.
Tuloste kirjoita: txt kopioi isot-kirjaimet, rivinvaihto.
} käynnistä.

Ohjelma siivoa.

käytettyMuisti1 := (Ohjelma muisti ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Tuloste kirjoita: txt kopioi html, rivinvaihto.
Tuloste kirjoita: txt kopioi pienet-kirjaimet, rivinvaihto.
Tuloste kirjoita: txt kopioi isot-kirjaimet, rivinvaihto.
} käynnistä.

Ohjelma siivoa.
käytettyMuisti2 := (Ohjelma muisti ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Tuloste kirjoita: txt kopioi html, rivinvaihto.
Tuloste kirjoita: txt kopioi pienet-kirjaimet, rivinvaihto.
Tuloste kirjoita: txt kopioi isot-kirjaimet, rivinvaihto.
} käynnistä.

Ohjelma siivoa.
käytettyMuisti3 := (Ohjelma muisti ? 0).



( käytettyMuisti1 = käytettyMuisti2 ja: käytettyMuisti1 = käytettyMuisti3, ja: käytettyMuisti2 = käytettyMuisti3 ) tosi: {
	Tuloste kirjoita: ['Ei muistivuotoja täällä'].
}, epätosi: {
	Tuloste kirjoita: ['Muisti vuotaa...'].
}.
