>> Hörppy := Olio uusi.

Hörppy kun: ['uusi'] tee: {
	oma str := [''].
}.


Hörppy kun: ['vastaa:'] tee: { :blah
		(oma str = ['']) tosi: {
			oma str lisää-loppuun: blah.
		}, muuten: {
			oma str lisää-loppuun: [' '].
			oma str lisää-loppuun: blah.
		}.
}.

Hörppy kun: ['vastaa:ja:'] tee: { :blah :blahah
		oma str lisää-loppuun: (blah alkaen: 0 pituus: (blah pituus - 1)).
		oma str lisää-loppuun: [' '].
		oma str lisää-loppuun: blahah.
}.

Hörppy kun: ['hanki'] tee: {
	>> puskuri := oma str.
	oma str := ['']. <- puskuri.
}.


Hörppy uusi hello world.
Tuloste kirjoita: (Hörppy hanki), rivinvaihto. 
Tuloste kirjoita: (Hörppy hanki), rivinvaihto. 
Hörppy hello world.
>> x := Hörppy uusi.
Tuloste kirjoita: (x hanki), rivinvaihto. 
x moi there.
