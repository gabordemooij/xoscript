

>> käytettyMuisti1 := 0.
>> käytettyMuisti2 := 0.
>> käytettyMuisti3 := 0.
>> käytettyMuisti4 := 0.

Ohjelma muistinhallinta: 0.

{ :i Tuloste kirjoita: i. } × 4.
Tuloste rivinvaihto.
{ :i Tuloste kirjoita: (4 - i). } × 4.
Tuloste rivinvaihto.
( 1 > 2 ) epätosi: { Tuloste kirjoita: ['LOHKO 1'], rivinvaihto. }.
( 2 > 1 ) tosi:  { Tuloste kirjoita: ['LOHKO 2'], rivinvaihto. }.

>> i := 0.
{ Tuloste kirjoita: i. i lisää: 1. } kun: { <- ( i < 3). }.
Tuloste rivinvaihto.

i := 3.
{ Tuloste kirjoita: i. i := i - 1. } kun: { <- ( i > 0). }.
Tuloste rivinvaihto.


Ohjelma siivoa.

käytettyMuisti1 := (Ohjelma muisti ? 0).


{ :i  Tuloste kirjoita: i. } × 4.
Tuloste rivinvaihto.
{ :i  Tuloste kirjoita: (4 - i). } × 4.
Tuloste rivinvaihto.
( 1 > 2 ) epätosi: { Tuloste kirjoita: ['LOHKO 1'], rivinvaihto. }.
( 2 > 1 ) tosi:  { Tuloste kirjoita: ['LOHKO 2'], rivinvaihto. }.

>> i := 0.
{ Tuloste kirjoita: i. i lisää: 1. } kun: { <- ( i < 3). }.
Tuloste rivinvaihto.

i := 3.
{ Tuloste kirjoita: i. i := i - 1. } kun: { <- ( i > 0). }.
Tuloste rivinvaihto.



Ohjelma siivoa.
käytettyMuisti2 := (Ohjelma muisti ? 0).


{ :i Tuloste kirjoita: i. } × 4.
Tuloste rivinvaihto.
{ :i Tuloste kirjoita: (4 - i). } × 4.
Tuloste rivinvaihto.
( 1 > 2 ) epätosi: { Tuloste kirjoita: ['LOHKO 1'], rivinvaihto. }.
( 2 > 1 ) tosi:  { Tuloste kirjoita: ['LOHKO 2'], rivinvaihto. }.

>> i := 0.
{ Tuloste kirjoita: i. i lisää: 1. } kun: { <- ( i < 3). }.
Tuloste rivinvaihto.

i := 3.
{ Tuloste kirjoita: i. i := i - 1. } kun: { <- ( i > 0). }.
Tuloste rivinvaihto.

Ohjelma siivoa.
käytettyMuisti3 := (Ohjelma muisti ? 0).



( käytettyMuisti1 = käytettyMuisti2 ja: käytettyMuisti1 = käytettyMuisti3, ja: käytettyMuisti2 = käytettyMuisti3 ) tosi: {
	Tuloste kirjoita: ['Ei muistivuotoja täällä'].
}, epätosi: {
	Tuloste kirjoita: ['Muisti vuotaa...'].
}.
