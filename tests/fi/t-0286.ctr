['Tuhannet ja desimaalit'].

>> x := 100000000.5.
>> y := 100000000.5.

Tuloste kirjoita: (x + y), rivinvaihto.

>> x := 10040.07.
>> y := 10305.60.

Tuloste kirjoita: (x + y), rivinvaihto.

['Desimaali'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Tuloste kirjoita: (x + y + z), rivinvaihto.

['Outo mutta kelvollinen'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Tuloste kirjoita: (x + y + z), rivinvaihto.

>> q := 0.1.2.

Tuloste kirjoita: (q), rivinvaihto.

>> q := 012.

Tuloste kirjoita: (q), rivinvaihto.
