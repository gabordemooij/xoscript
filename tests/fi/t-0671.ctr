# julkinen avain (rajapintojen ym. suojaamiseen)
Server init.

# luo avaimet
>> avaimet := Holvi luo-avaimet.

# yksityinen (salainen) avain
>> sk := avaimet ensimmäinen.

# julkinen avain
>> pk := avaimet viimeinen.

# allekirjoita viesti
>> allek := Holvi allekirjoita: ['abc'] avaimella: sk.

# tarkista viesti (ok)
Tuloste kirjoita: ( 
	Holvi
		tarkista: ['abc'] 
		allekirjoitus: allek 
		avaimella: pk 
), rivinvaihto.

# tarkista viesti (epäonnistuu)
Tuloste kirjoita: ( 
	Holvi 
		tarkista: ['abd'] 
		allekirjoitus: allek 
		avaimella: pk 
), rivinvaihto.