# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Holvi luo-avaimet.

# private (secret) key
>> sk := keys ensimmäinen.

# public key
>> pk := keys viimeinen.

# sign a message
>> sig := Holvi allekirjoita: ['abc'] avaimella: sk.

# check message (ok)
Tuloste kirjoita: ( 
	Holvi
		tarkista: ['abc'] 
		allekirjoitus: sig 
		avaimella: pk 
), rivinvaihto.

# check message (fail)
Tuloste kirjoita: ( 
	Holvi 
		tarkista: ['abd'] 
		allekirjoitus: sig 
		avaimella: pk 
), rivinvaihto.