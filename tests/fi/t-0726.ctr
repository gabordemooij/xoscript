# test buffers PKI/Sign 
Server init.

>> long := ( Lista uusi täytä: 1000 arvolla: ['a'] ) yhdistä: [''].

# sign a message
Tuloste kirjoita: ( 
	Holvi allekirjoita: ['abc'] avaimella: long
), rivinvaihto.

Tuloste kirjoita: ( 
	Holvi
		tarkista: ['abc'] 
		allekirjoitus: long 
		avaimella: long
), rivinvaihto.

Tuloste kirjoita: (
	Holvi salasanatiiviste: long varmista: long
), rivinvaihto.
