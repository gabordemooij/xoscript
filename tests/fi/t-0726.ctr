# testaa puskurit PKI/allekirjoitus 
Server init.

>> pitkä := ( Lista uusi täytä: 1000 arvolla: ['a'] ) yhdistä: [''].

# allekirjoita viesti
Tuloste kirjoita: ( 
	Holvi allekirjoita: ['abc'] avaimella: pitkä
), rivinvaihto.

Tuloste kirjoita: ( 
	Holvi
		tarkista: ['abc'] 
		allekirjoitus: pitkä 
		avaimella: pitkä
), rivinvaihto.

Tuloste kirjoita: (
	Holvi salasanatiiviste: pitkä varmista: pitkä
), rivinvaihto.
