
{ :i
	Tuloste kirjoita: ['This is step #'] + ( ( i ) + 1 ), rivinvaihto.
} × 6.

{ :i
	Tuloste kirjoita: ['This is step #'] + ( 3 - ( i ) ), rivinvaihto.
} × 6.

{ :i
	Tuloste kirjoita: ['NEVER!'], rivinvaihto.
} × 0.



{ :i
	Tuloste kirjoita: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), rivinvaihto.
} × 11.
