Tuloste kirjoita: ['Testiolio'], rivinvaihto.
>> a := Olio uusi. 

a kun: ['item:'] tee: { :muot
	oma muot := muot. 
}.

a kun: ['esine'] tee: {
	<- oma muot.
}.

a item: ( Muoto uusi: ['|%s|'] ).

Tuloste kirjoita: a esine, rivinvaihto.

>> vanha-muot-osoite := a esine prototyyppi muistiosoite.
a save-as: ['/tmp/a.bin'].
Tuloste kirjoita: ['========== LADATAAN SNAP UUDELLEEN:'], rivinvaihto.

>> b := Olio load-from: ['/tmp/a.bin'].

(b esine prototyyppi muistiosoite = vanha-muot-osoite) tosi: {
	Tuloste kirjoita: ['Olion linkki liitetty uudelleen.'], rivinvaihto.
}.

Tuloste kirjoita: ( b esine sovella: ['hello'] ), rivinvaihto.
