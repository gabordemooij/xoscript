Tuloste kirjoita: ['Test object'], rivinvaihto.
>> a := Olio uusi. 

a kun: ['item:'] tee: { :fmt
	oma fmt := fmt. 
}.

a kun: ['item'] tee: { <- oma fmt.
}.

a item: ( Muoto uusi: ['|%s|'] ).

Tuloste kirjoita: a item, rivinvaihto.

>> old-fmt-address := a item prototyyppi muistiosoite.
a save-as: ['/tmp/a.bin'].
Tuloste kirjoita: ['========== RELOADING SNAP:'], rivinvaihto.

>> b := Olio load-from: ['/tmp/a.bin'].

(b item prototyyppi muistiosoite = old-fmt-address) tosi: {
	Tuloste kirjoita: ['Object link re-attached.'], rivinvaihto.
}.

Tuloste kirjoita: ( b item sovella: ['hello'] ), rivinvaihto.
