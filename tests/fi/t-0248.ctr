

Teksti kun: ['arvioi'] tee: {
	>> koodi := Tiedosto uusi: ['/tmp/eval.ctr'].
	koodi kirjoita: itse teksti + ['.'].
	Ohjelma käytä: ['/tmp/eval.ctr'].
}.

>> a := (Lista ← (
	(Sanakirja uusi)
		aseta: ['verkkotunnus'] kohtaan: ['mywebsite.com'],
		aseta: (Lista ←
			((Sanakirja uusi)
				aseta: ['etusivu'] kohtaan: ['title'],
				aseta: ['<html></html>'] kohtaan: ['body'],
				aseta: ['2017-01-01'] kohtaan: ['luotu']
			) ;
			((Sanakirja uusi)
				aseta: ['meistä(c)'] kohtaan: ['title'],
				aseta: ['<credits>Author Inc.</credits>'] kohtaan: ['body']
			)
		) kohtaan: ['sivut']
	)
) teksti.

Tuloste kirjoita: a tyyppi, rivinvaihto.
Tuloste kirjoita: a, rivinvaihto.

>> b := Tyhjä.
(['b := '] + a) arvioi.
Tuloste kirjoita: b ? 0 ? ['sivut'] ? 1 ? ['body'], rivinvaihto.

>> c := b ? 0.
>> d := c teksti.
Tuloste kirjoita: d tyyppi, rivinvaihto.

>> e := Tyhjä.
(['e := '] + d) arvioi.
Tuloste kirjoita: e ? ['sivut'] ? 0, rivinvaihto.
