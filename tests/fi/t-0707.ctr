# testaa tyyppimuunnokset / konversiot / sidonnat
Ohjelma muistinhallinta: 4.
Server init.

>> laskuri := 0.
>> tk := Maria-DB uusi isäntä: ['localhost'],
	käyttäjänimi: ['xo'], salasana: ['pass123'], tietokannan-nimi: ['xobase'], yhdistä.

>> KaksinumeroinenMuoto := Muoto uusi: ['%02d'].

# Päiväysaika
{
	>> vuosi     := Luku väliltä: 1995 ja: 2050, teksti.
	>> kuukausi    := KaksinumeroinenMuoto sovella-kokonaisluku: (Luku väliltä: 1 ja: 12), teksti.
	>> päivä      := KaksinumeroinenMuoto sovella-kokonaisluku: (Luku väliltä: 1 ja: 28), teksti.
	>> tunti     := KaksinumeroinenMuoto sovella-kokonaisluku: (Luku väliltä: 1 ja: 23), teksti.
	>> minuutti   := KaksinumeroinenMuoto sovella-kokonaisluku: (Luku väliltä: 1 ja: 59), teksti.
	>> sekunti   := KaksinumeroinenMuoto sovella-kokonaisluku: (Luku väliltä: 1 ja: 59), teksti.
	>> päiväysaika := ['YYYY-MM-DD HH:II:SS'].	
	päiväysaika
		YYYY: vuosi,
		MM: kuukausi,
		DD: päivä,
		HH: tunti,
		II: minuutti,
		SS: sekunti.
	>> hakuparametrit :=
	tk kysely: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: päiväysaika),
	hae: { :vaakarivi
		(vaakarivi mydatetime = päiväysaika) epätosi: {
			tämä-tehtävä virhe: (
				['Odotettiin: <expected> mutta saatiin: <observation>']
				<expected>: päiväysaika,
				<observation>: vaakarivi mydatetime
			).
		}.
	
	}.
	laskuri lisää: 1.
} * 100.

# Päiväys
{
	>> vuosi     := Luku väliltä: 1995 ja: 2050, teksti.
	>> kuukausi    := KaksinumeroinenMuoto sovella-kokonaisluku: (Luku väliltä: 1 ja: 12), teksti.
	>> päivä      := KaksinumeroinenMuoto sovella-kokonaisluku: (Luku väliltä: 1 ja: 28), teksti.
	>> päiväys     := ['YYYY-MM-DD'].
	päiväys
		YYYY: vuosi,
		MM: kuukausi,
		DD: päivä.
	>> hakuparametrit :=
	tk kysely: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: päiväys),
	hae: { :vaakarivi
		(vaakarivi mydate = päiväys) epätosi: {
			tämä-tehtävä virhe: (
				['Odotettiin: <expected> mutta saatiin: <observation>']
				<expected>: päiväys,
				<observation>: vaakarivi mydate
			).
		}.
	}.
	laskuri lisää: 1.
} * 100.


# Aika
{
	>> tunti     := KaksinumeroinenMuoto sovella-kokonaisluku: (Luku väliltä: 1 ja: 23), teksti.
	>> minuutti   := KaksinumeroinenMuoto sovella-kokonaisluku: (Luku väliltä: 1 ja: 59), teksti.
	>> sekunti   := KaksinumeroinenMuoto sovella-kokonaisluku: (Luku väliltä: 1 ja: 59), teksti.
	>> aika := ['HH:II:SS'].
	aika
		HH: tunti,
		II: minuutti,
		SS: sekunti.
	>> hakuparametrit :=
	tk kysely: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: aika),
	hae: { :vaakarivi
		(vaakarivi mytime = aika) epätosi: {
			tämä-tehtävä virhe: (
				['Odotettiin: <expected> mutta saatiin: <observation>']
				<expected>: päiväysaika,
				<observation>: vaakarivi mytime
			).
		}.
	}.
	laskuri lisää: 1.
} * 100.


# Merkkijonot (varchar/text)
>> str1 := Lista uusi täytä: 100000 arvolla: ['x'], yhdistä: [''].
{
	>> str2 := Holvi tunniste: 40.
	>> hakuparametrit :=
	tk kysely: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	hae: { :vaakarivi
		(vaakarivi str1 = str1 ja: vaakarivi str2 = str2) epätosi: {
			tämä-tehtävä virhe: (
				['Odotettiin: <expected> mutta saatiin: <observation>']
				<expected>: päiväysaika,
				<observation>: vaakarivi mytime
			).
		}.
	}.
	laskuri lisää: 1.
} * 100.


# Luvut
{
	>> n1  := Luku väliltä: 1 ja: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 tekstistä: ['9223372036854775807'] ) -
		( Int64 tekstistä: ['99999'] ) +
		( Int64 tekstistä: n1 teksti )
	).
	>> hakuparametrit :=
	tk kysely: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	hae: { :vaakarivi
		(vaakarivi n1 = n1) epätosi: {
			tämä-tehtävä virhe: (
				['Odotettiin: <expected> mutta saatiin: <observation>']
				<expected>: n1,
				<observation>: vaakarivi n1
			).
		}.
		(vaakarivi n2 = n2) epätosi: {
			tämä-tehtävä virhe: (
				['Odotettiin: <expected> mutta saatiin: <observation>']
				<expected>: n1,
				<observation>: vaakarivi n2
			).
		}.
		(vaakarivi n3 = n2 pyöristä) epätosi: {
			tämä-tehtävä virhe: (
				['Odotettiin: <expected> mutta saatiin: <observation>']
				<expected>: n1,
				<observation>: vaakarivi n3
			).
		}.
		(vaakarivi big = big) epätosi: {
			tämä-tehtävä virhe: (
				['Odotettiin: <expected> mutta saatiin: <observation>']
				<expected>: big,
				<observation>: vaakarivi big
			).
		}.
		
	}.
	laskuri lisää: 1.
} * 100.


Tuloste kirjoita: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: laskuri
), rivinvaihto.