>> items := Sanakirja uusi.
items aseta: ['green'] kohtaan: ['color-1'].
items aseta: ['orange'] kohtaan: ['color-2'].
items aseta: ['red'] kohtaan: ['color-3'].
>> i := 0.
>> s := [''].
items jokainen: { :key :color
