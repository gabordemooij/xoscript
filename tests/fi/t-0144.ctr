



>> Kahvinporot := Olio uusi.
Kahvinporot kun: ['uuta'] tee: { <- ['coffee']. }.

>> Kahvinkeitin := Olio uusi.
Kahvinkeitin kun: ['init'] tee: {
	oma kahvinporot := Kahvinporot uusi.
}.
Kahvinkeitin kun: ['uusi'] tee: { <- Kahvinkeitin `new init.
}.

Kahvinkeitin kun: ['keitäTeetä'] tee: { <- (oma teenlehdet uuta). }.
Kahvinkeitin kun: ['keitäKahvia'] tee: { <- (oma kahvinporot uuta). }.

>> kahviunelma := Kahvinkeitin uusi.

Tuloste kirjoita:
	kahviunelma 
	keitäKahvia.

Tuloste kirjoita:
	kahviunelma 
	keitäTeetä.
