



>> CoffeeGrounds := Olio uusi.
CoffeeGrounds kun: ['extract'] tee: { <- ['coffee']. }.

>> CoffeeMachine := Olio uusi.
CoffeeMachine kun: ['init'] tee: {
	oma coffeegrounds := CoffeeGrounds uusi.
}.
CoffeeMachine kun: ['uusi'] tee: { <- CoffeeMachine `new init.
}.

CoffeeMachine kun: ['makeTea'] tee: { <- (oma tealeaves extract). }.
CoffeeMachine kun: ['makeCoffee'] tee: { <- (oma coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine uusi.

Tuloste kirjoita:
	coffeeDream 
	makeCoffee.

Tuloste kirjoita:
	coffeeDream 
	makeTea.
