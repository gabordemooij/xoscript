Server init.
>> f := Muoto uusi: ['%d'].
>> a := Blob uusi: 4.
a bytes: ( Lista uusi ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob uusi: 4.
b bytes: ( Lista uusi ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a alkaen: 0 pituus: 3, jokainen: { :i :byte
	Tuloste kirjoita: ( f sovella-kokonaisluku: byte ), rivinvaihto.
}.
a ^ b.
a alkaen: 0 pituus: 3, jokainen: { :i :byte
	Tuloste kirjoita: ( f sovella-kokonaisluku: byte ), rivinvaihto.
}.
a ^ b.
a alkaen: 0 pituus: 3, jokainen: { :i :byte
	Tuloste kirjoita: ( f sovella-kokonaisluku: byte ), rivinvaihto.
}.
a vapauta.
b vapauta.

{ a ^ Olio. } sieppaa: { :e Tuloste kirjoita: e, rivinvaihto. }, käynnistä.
