Tuloste kirjoita: ((Lista uusi
	kun: ['plaque:'] tee: { :x oma o := x. },
	kun: ['plaque']  tee: { <- oma o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Lista ← 1)
	~ (Lista ← 1 ; 2)
	~ (Lista ← 1 ; 2 ; 3)
	~ (Lista ← 1 ; 2 ; 3 ; 4)
	~ (Lista ← 1 ; 2 ; 3 ; 4 ; 5)
) jokainen: { :i :el
	{ Tuloste kirjoita: tämä-tehtävä. } × el lukumäärä.
	Tuloste rivinvaihto.
}) plaque, rivinvaihto.


