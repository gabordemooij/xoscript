

Lista kun: ['summa'] tee: {
	>> yhteensä := 0.
	itse jokainen: { :indeksi :alkio
		yhteensä lisää: alkio.
	}. <- yhteensä.
}.

Lista kun: ['tulo'] tee: {
	>> yhteensä := 1.
	itse jokainen: { :indeksi :alkio
		yhteensä kerro: alkio.
	}. <- yhteensä.
}.

>> käytettyMuisti1 := 0.
>> käytettyMuisti2 := 0.
>> käytettyMuisti3 := 0.
>> käytettyMuisti4 := 0.

Ohjelma muistinhallinta: 0.

{

>> a := Lista ← ['hello'] ; ['world'] ; Tosi ; Tyhjä ; 666.
a := a + ( Lista ← 1 ).
Tuloste kirjoita: ( ['summa: '] + ( a summa ) ), rivinvaihto.
Tuloste kirjoita: ( ['pienin: '] + ( a minimi ) ), rivinvaihto.
Tuloste kirjoita: ( ['suurin: '] + ( a maksimi ) ), rivinvaihto.
Tuloste kirjoita: ( ['3.: '] + ( a ? 2 ) ), rivinvaihto.
Tuloste kirjoita: ( ['tulo: '] + ( a tulo ) ), rivinvaihto.
a järjestä: { :a :b <- (b - a). }.
a jokainen: { :i :e Tuloste kirjoita: ( i - 0 ), rivinvaihto. }.

} käynnistä.

Ohjelma siivoa.
käytettyMuisti1 := (Ohjelma muisti ? 0).


{

>> a := Lista ← ['hello'] ; ['world'] ; Tosi ; Tyhjä ; 666.
a := a + ( Lista ← 1 ).
Tuloste kirjoita: ( ['summa: '] + ( a summa ) ), rivinvaihto.
Tuloste kirjoita: ( ['pienin: '] + ( a minimi ) ), rivinvaihto.
Tuloste kirjoita: ( ['suurin: '] + ( a maksimi ) ), rivinvaihto.
Tuloste kirjoita: ( ['3.: '] + ( a ? 2 ) ), rivinvaihto.
Tuloste kirjoita: ( ['tulo: '] + ( a tulo ) ), rivinvaihto.
a järjestä: { :a :b <- (b - a). }.
a jokainen: { :i :e Tuloste kirjoita: ( i - 0 ), rivinvaihto. }.

} käynnistä.



