

Lista kun: ['sum'] tee: {
	>> total := 0.
	itse jokainen: { :index :element
		total lisää: element.
	}. <- total.
}.

Lista kun: ['product'] tee: {
	>> total := 1.
	itse jokainen: { :index :element
		total kerro: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Ohjelma muistinhallinta: 0.

{

>> a := Lista ← ['hello'] ; ['world'] ; Tosi ; Tyhjä ; 666.
a := a + ( Lista ← 1 ).
Tuloste kirjoita: ( ['sum: '] + ( a sum ) ), rivinvaihto.
Tuloste kirjoita: ( ['min: '] + ( a minimi ) ), rivinvaihto.
Tuloste kirjoita: ( ['max: '] + ( a maksimi ) ), rivinvaihto.
Tuloste kirjoita: ( ['3rd: '] + ( a ? 2 ) ), rivinvaihto.
Tuloste kirjoita: ( ['prd: '] + ( a product ) ), rivinvaihto.
a järjestä: { :a :b <- (b - a). }.
a jokainen: { :i :e Tuloste kirjoita: ( i - 0 ), rivinvaihto. }.

} käynnistä.

