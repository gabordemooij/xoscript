Tuloste kirjoita: ['Test object'], rivinvaihto.
>> l := Lista uusi ; 1 ; ( Lista uusi ; (Hetki uusi: 1) ; (Int64 tekstistä: ['321']) ; (Lista uusi ; 3)).
Tuloste kirjoita: l, rivinvaihto.
>> old-lst-address := l prototyyppi muistiosoite.
l save-as: ['/tmp/a.bin'].
Tuloste kirjoita: ['========== RELOADING SNAP:'], rivinvaihto.
>> b := Olio load-from: ['/tmp/a.bin'].
(b prototyyppi muistiosoite = old-lst-address) tosi: {
	Tuloste kirjoita: ['Object link re-attached.'], rivinvaihto.
}.
Tuloste kirjoita: b, rivinvaihto.
