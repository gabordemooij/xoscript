Tuloste kirjoita: ['Testiolio'], rivinvaihto.
>> l := Lista uusi ; 1 ; ( Lista uusi ; (Hetki uusi: 1) ; (Int64 tekstistä: ['321']) ; (Lista uusi ; 3)).
Tuloste kirjoita: l, rivinvaihto.
>> vanha-lst-osoite := l prototyyppi muistiosoite.
l save-as: ['/tmp/a.bin'].
Tuloste kirjoita: ['========== LADATAAN SNAP UUDELLEEN:'], rivinvaihto.
>> b := Olio load-from: ['/tmp/a.bin'].
(b prototyyppi muistiosoite = vanha-lst-osoite) tosi: {
	Tuloste kirjoita: ['Olion linkki liitetty uudelleen.'], rivinvaihto.
}.
Tuloste kirjoita: b, rivinvaihto.
