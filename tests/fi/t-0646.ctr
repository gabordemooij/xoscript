>> hakuparametrit :=
tk kysely: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
hae: { :vaakarivi
	Tuloste kirjoita: vaakarivi datetimetest, rivinvaihto.
