Server init.
Tuloste kirjoita: ['Database datetime test'], rivinvaihto.

>> db := Maria-DB uusi isäntä: ['localhost'],
	käyttäjänimi: ['xo'], 
	salasana: ['pass123'],
	tietokannan-nimi: ['xobase'],
	yhdistä.

>> hakuparametrit :=
db kysely: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
hae: { :row
	Tuloste kirjoita: row datetimetest, rivinvaihto.
}.
