# testaa määritteet

Ohjelma siivoa.

>> Hedelmä := Olio uusi.
Hedelmä kun: ['uusi'] tee: {
	>> f := itse uusi.
	f apples: 0. <- f.
}.
Hedelmä kun: ['apples:'] tee: { :a oma omenat := a. }.
Hedelmä kun: ['omenat'] tee: { <- oma omenat. }.
Hedelmä kun: ['+'] tee: { :f
	>> n := Hedelmä uusi.
	n apples: (f omenat + oma omenat). <- n.
}.
Luku kun: ['omenat'] tee: { <- ((Hedelmä uusi) apples: itse).
}.

Hedelmä kun: ['teksti'] tee: { <- oma omenat + [' omenaa '].
}.

>> q := 3 omenat + 4 omenat.
Tuloste kirjoita: q, rivinvaihto.




q := 3 omenat + 4 omenat.
Tuloste kirjoita: q, rivinvaihto.



q := 3 omenat + 4 omenat.
Tuloste kirjoita: q, rivinvaihto.


