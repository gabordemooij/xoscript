# test qualifiers

Ohjelma siivoa.

>> Fruit := Olio uusi.
Fruit kun: ['uusi'] tee: {
	>> f := itse uusi.
	f apples: 0. <- f.
}.
Fruit kun: ['apples:'] tee: { :a oma apples := a. }.
Fruit kun: ['apples'] tee: { <- oma apples. }.
Fruit kun: ['+'] tee: { :f
	>> n := Fruit uusi.
	n apples: (f apples + oma apples). <- n.
}.
Luku kun: ['apples'] tee: { <- ((Fruit uusi) apples: itse).
}.

Fruit kun: ['teksti'] tee: { <- oma apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Tuloste kirjoita: q, rivinvaihto.




q := 3 apples + 4 apples.
Tuloste kirjoita: q, rivinvaihto.



q := 3 apples + 4 apples.
Tuloste kirjoita: q, rivinvaihto.


