Tuloste kirjoita: ['Test object'], rivinvaihto.
>> a := Olio uusi. 
a kun: ['item:'] tee: { :lst
	oma lst := lst. 
}.
a kun: ['item'] tee: { <- oma lst.
}.
a item: (
	Lista uusi ; 1 ; (
		Lista uusi ; ['a'] ; (
			Lista uusi ; ( Hetki uusi: 1 )
		) ; ( Int64 tekstistä: ['321'] )
	)
).
Tuloste kirjoita: a item, rivinvaihto.
>> old-lst-address := a item prototyyppi muistiosoite.
a save-as: ['/tmp/a.bin'].
Tuloste kirjoita: ['========== RELOADING SNAP:'], rivinvaihto.
>> b := Olio load-from: ['/tmp/a.bin'].
(b item prototyyppi muistiosoite = old-lst-address) tosi: {
	Tuloste kirjoita: ['Object link re-attached.'], rivinvaihto.
}.
Tuloste kirjoita: ( b item ), rivinvaihto.
