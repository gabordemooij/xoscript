Tuloste kirjoita: ['Testiolio'], rivinvaihto.
>> a := Olio uusi. 
a kun: ['item:'] tee: { :lst
	oma lst := lst. 
}.
a kun: ['esine'] tee: {
	<- oma lst.
}.
a item: (
	Lista uusi ; 1 ; (
		Lista uusi ; ['a'] ; (
			Lista uusi ; ( Hetki uusi: 1 )
		) ; ( Int64 tekstistä: ['321'] )
	)
).
Tuloste kirjoita: a esine, rivinvaihto.
>> vanha-lst-osoite := a esine prototyyppi muistiosoite.
a save-as: ['/tmp/a.bin'].
Tuloste kirjoita: ['========== LADATAAN SNAP UUDELLEEN:'], rivinvaihto.
>> b := Olio load-from: ['/tmp/a.bin'].
(b esine prototyyppi muistiosoite = vanha-lst-osoite) tosi: {
	Tuloste kirjoita: ['Olion linkki liitetty uudelleen.'], rivinvaihto.
}.
Tuloste kirjoita: ( b esine ), rivinvaihto.
