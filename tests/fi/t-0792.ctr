Server init.

>> TK := Maria-DB uusi isäntä: ['localhost'],
	käyttäjänimi: ['xo'],
	salasana: ['pass123'],
	tietokannan-nimi: ['xobase'],
	yhdistä.
	
>> SQL := ['SELECT "hello" AS "world" '].

# nopeampi tapa, hae kysely TK:sta:
>> kysely2 := TK kysely: SQL.

# nyt sinun ei tarvitse asettaa TK:ta
kysely2 hae: { :vaakarivi
	Tuloste kirjoita: vaakarivi world, rivinvaihto.
}.
