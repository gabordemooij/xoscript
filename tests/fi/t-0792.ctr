Server init.

>> DB := Maria-DB uusi isäntä: ['localhost'],
	käyttäjänimi: ['xo'],
	salasana: ['pass123'],
	tietokannan-nimi: ['xobase'],
	yhdistä.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB kysely: SQL.

# now you don't have to set DB
query2 hae: { :row
	Tuloste kirjoita: row world, rivinvaihto.
}.
