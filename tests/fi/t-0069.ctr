

Teksti kun: ['html'] tee: { <- (
		itse
		korvaa: ['&'] arvolla: ['&amp;'],
		korvaa: ['<'] arvolla: ['&lt;'],
		korvaa: ['>'] arvolla: ['&gt;'],
		korvaa: ['"'] arvolla: ['&quot;']
	).
}.


Tuloste kirjoita: ([' vasemmalta trimmattu '] siisti) + [' '] + ( ['ja oikealta trimmattu'] siisti) + ['!'], rivinvaihto.
Tuloste kirjoita: ['<html>"html & entities"</html>'] html.
