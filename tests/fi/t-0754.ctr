Tuloste kirjoita: ['Testiolio'], rivinvaihto.
>> a := Olio uusi. 

a kun: ['item:'] tee: { :ulos
	oma ulos := ulos. 
}.

a kun: ['esine'] tee: {
	<- oma ulos.
}.

a kun: ['tervehdi'] tee: {
	Tuloste kirjoita: ['moi alkuperäisestä tulosteesta!'], rivinvaihto.
}.

a item: Tuloste.

Tuloste kirjoita: a esine, rivinvaihto.

>> vanha-ulos-osoite := a esine prototyyppi muistiosoite.
a save-as: ['/tmp/a.bin'].
Tuloste kirjoita: ['========== LADATAAN SNAP UUDELLEEN:'], rivinvaihto.

>> b := Olio load-from: ['/tmp/a.bin'].

(b esine prototyyppi muistiosoite = vanha-ulos-osoite) tosi: {
	Tuloste kirjoita: ['Olion linkki liitetty uudelleen.'], rivinvaihto.
}.

b esine kirjoita: ['hei ladatusta tulosteesta!'], rivinvaihto.
b tervehdi.
