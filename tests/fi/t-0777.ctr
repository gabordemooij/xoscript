#OBSD
>> dirname := [''].
{ dirname lisää-loppuun: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Ohjelma järjestelmä: command.
Ohjelma chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename lisää-loppuun: ['YYYYYYYY']. } * 20.
Tiedosto uusi: filename, kirjoita: ['sometext'].
{ Tiedosto lista: ['/tmp/'] + dirname. } * 1000.
Tuloste kirjoita: ['no crash'], rivinvaihto.

