Ohjelma muistinhallinta: 0.

>> txt := ['Word Salad'].
Tuloste kirjoita: ['ana:n viimeinen indeksi = '] + (( txt viimeinen: ['ord'] ) - 0), rivinvaihto.
Tuloste kirjoita: ['ana:n indeksi = '] + (( txt etsi: ['ord'] ) - 0), rivinvaihto.
Tuloste kirjoita: ['aa:n indeksi = '] + (( txt etsi: ['ad'] ) - 0), rivinvaihto.
Tuloste kirjoita: ['W:n viimeinen indeksi = '] + (( txt viimeinen: ['W'] ) - 0), rivinvaihto.
Tuloste kirjoita: ['d:n viimeinen indeksi = '] + (( txt viimeinen: ['d'] ) - 0), rivinvaihto.
Tuloste kirjoita: ['tkst on Sanasalaatti = '] + ( txt = ['Word Salad'] ), rivinvaihto.
Tuloste kirjoita: ['tkst on Caesarsalaatti = '] + ( txt = ['Caesarsalaatti'] ), rivinvaihto.
Tuloste kirjoita: ['tkst ei ole Sanasalaatti = '] + ( txt ≠ ['Word Salad'] ), rivinvaihto.
Tuloste kirjoita: ['tkst ei ole Caesarsalaatti = '] + ( txt ≠ ['Caesarsalaatti'] ), rivinvaihto.

