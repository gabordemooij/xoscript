Tuloste kirjoita: ['Test object'], rivinvaihto.
>> a := Olio uusi. 

a kun: ['item:'] tee: { :dict
	oma dict := dict. 
}.

a kun: ['item'] tee: { <- oma dict.
}.

a item: (
Sanakirja uusi
	hello: ['world'],
	world: (Sanakirja uusi aseta: ['a'] kohtaan: ['b'])).

Tuloste kirjoita: a item, rivinvaihto.

>> old-dict-address := a item prototyyppi muistiosoite.
a save-as: ['/tmp/a.bin'].
Tuloste kirjoita: ['========== RELOADING SNAP:'], rivinvaihto.

>> b := Olio load-from: ['/tmp/a.bin'].

(b item prototyyppi muistiosoite = old-dict-address) tosi: {
	Tuloste kirjoita: ['Object link re-attached.'], rivinvaihto.
}.

Tuloste kirjoita: b item, rivinvaihto.
