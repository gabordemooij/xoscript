
Lista kun: ['product'] tee: {
	>> total := 1.
	itse jokainen: { :index :element
		total kerro: element.
	}. <- total.
}.

>> a := Lista ← 1 ; 2 ; 3.
Tuloste kirjoita: a product, rivinvaihto.
Tuloste kirjoita: (Lista ← 2 ; 4 ; 8) product, rivinvaihto. 
Tuloste kirjoita: (Lista ← -2 ; 10) product, rivinvaihto. 
Tuloste kirjoita: (Lista ← 0.5 ; -2) product, rivinvaihto. 
