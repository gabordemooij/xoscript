Tuloste kirjoita: ['Testiolio'], rivinvaihto.
>> tervehtijä := Olio uusi.
tervehtijä kun: ['name:'] tee: { :nimi
	oma xnimi := nimi. 
}.
tervehtijä kun: ['tervehdi'] tee: {
	Tuloste kirjoita: ['Hei '] + oma xnimi, rivinvaihto.
}.
tervehtijä name: ['Sherlock'].
tervehtijä save-as: ['/tmp/a.bin'].
Tuloste kirjoita: ['========== LADATAAN SNAP UUDELLEEN:'], rivinvaihto.
>> b := Olio load-from: ['/tmp/a.bin'].
b tervehdi.
b name: ['Watson'], tervehdi.
