Server init.
Tuloste kirjoita: ['Tietokannan päivämäärätesti'], rivinvaihto.

>> tk := Maria-DB uusi isäntä: ['localhost'],
	käyttäjänimi: ['xo'], 
	salasana: ['pass123'],
	tietokannan-nimi: ['xobase'],
	yhdistä.

>> hakuparametrit :=
tk kysely: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
hae: { :vaakarivi
	Tuloste kirjoita: vaakarivi datetest, rivinvaihto.
}.
