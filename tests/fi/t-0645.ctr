Server init.
Tuloste kirjoita: ['Database date test'], rivinvaihto.

>> db := Maria-DB uusi isäntä: ['localhost'],
	käyttäjänimi: ['xo'], 
	salasana: ['pass123'],
	tietokannan-nimi: ['xobase'],
	yhdistä.

>> hakuparametrit :=
db kysely: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
hae: { :row
	Tuloste kirjoita: row datetest, rivinvaihto.
}.
