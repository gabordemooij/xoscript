# line breaks in values must not create extra headers
Server valmistele.
Ohjelma käytä: ['../../../src/xo/fi/webtools.xo'].
Ohjelma käytä: ['../../../src/xo/fi/mailtools.xo'].

>> otsake := HTTP-Otsake uusi avain: ['Location'] arvo: ['/ok\r\nX-Injected: yes'].
Tuloste kirjoita: otsake.

>> web := Verkkodokumentti uusi.
web siirry: ['/ok\r\nX-Injected: yes'].
Tuloste kirjoita: ['\n'], rivinvaihto.

>> mail := Sähköposti uusi.
mail vastaanottaja: (Lista uusi ; ['a@example.invalid\r\nX-To: yes']).
mail cc: (Lista uusi ; ['b@example.invalid\r\nX-Cc: yes']).
mail bcc: (Lista uusi ; ['c@example.invalid\r\nX-Bcc: yes']).
mail lähettäjä: ['d@example.invalid\r\nX-From: yes'] nimi: ['site\r\nX-Name: yes'].
mail aihe: ['hello\r\nX-Subject: yes'].
mail viestiteksti: ['line1\r\nline2'].
Tuloste kirjoita: mail luo.

>> html := HTML-Sähköposti uusi.
html vastaanottaja: (Lista uusi ; ['a@example.invalid\r\nX-To: yes']).
html lähettäjä: ['d@example.invalid'] nimi: ['site'].
html aihe: ['hello\r\nX-Subject: yes'].
html viestiteksti: ['body'].
Tuloste kirjoita: ( html luo sisältyy: ['\nX-'] ), rivinvaihto.
Tuloste kirjoita: ( html luo sisältyy: ['X-To: yes'] ), rivinvaihto.
