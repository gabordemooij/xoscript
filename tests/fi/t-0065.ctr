Luku kun: ['kertoma'] tee: {
	>> yhteensä := 1.
	{ :indeksi yhteensä kerro: (itse - (indeksi)). } × itse. <- yhteensä.
}.
>> Tulostin := Olio uusi.
Tulostin kun: ['tulosta:sekä:'] tee: { :x :y
	Tuloste kirjoita: ['a='] + x + [', b='] + y, rivinvaihto.
}.
>> a := 4.5. >> b := a pyöristä-alas.
Tulostin tulosta: a sekä: b.
a := 4. b := a kertoma.
Tulostin tulosta: a sekä: b.
a := 4.5. b := a pyöristä-ylös.
Tulostin tulosta: a sekä: b.
a := 4.5. b := a pyöristä-alas.
Tulostin tulosta: a sekä: b.
a := 4.5. b := a pyöristä.
Tulostin tulosta: a sekä: b.
a := 4.2. b := a pyöristä.
Tulostin tulosta: a sekä: b.

Tuloste kirjoita: (9 modulo: 5), rivinvaihto.
Tuloste kirjoita: -666 itseisarvo, rivinvaihto.
Tuloste kirjoita: 49 neliöjuuri, rivinvaihto.
Tuloste kirjoita: (2 potenssiin: 3), rivinvaihto.
>> l := (Lista ← 9 ; 6).
Tuloste kirjoita: l minimi.

