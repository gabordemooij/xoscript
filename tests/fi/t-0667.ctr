# test Program version

# this feature is disabled by default
Tuloste kirjoita: (
	Ohjelma ominaisuus: 
	['RECURSIVE_STRINTPOL']
), rivinvaihto.


# but if we set the time back
>> today := Hetki 
aikavyöhyke: ['CEST'],
lähteestä: ['2026-02-15 10:00:00'].
Ohjelma versio: today.

# it will be enabled like it used to be (from now on)
Tuloste kirjoita: (
	Ohjelma ominaisuus: 
	['RECURSIVE_STRINTPOL']
), rivinvaihto.