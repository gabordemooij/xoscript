Server init.

# write a test file
>> f := Tiedosto uusi: ['/tmp/test.gif'].
f kirjoita: ['GIF87a01234567810'].

# serve the file
Server välitä: ['test.gif'] etuliite: ['/tmp/'].

Tuloste rivinvaihto.

Tuloste kirjoita: ['Outside container (security):'], rivinvaihto.
{ Server välitä: ['../passwd'] etuliite: ['/tmp/']. }
sieppaa: { :e Tuloste kirjoita: e, rivinvaihto. },
käynnistä.

Tuloste kirjoita: ['Invalid prefix:'], rivinvaihto.
{ Server välitä: ['test.gif'] etuliite: ['z:\\']. }
sieppaa: { :e Tuloste kirjoita: e, rivinvaihto. },
käynnistä.

Tuloste kirjoita: ['Non-existant file:'], rivinvaihto.
{ Server välitä: ['xxx.xxx'] etuliite: ['/tmp/']. }
sieppaa: { :e Tuloste kirjoita: e, rivinvaihto. },
käynnistä.
