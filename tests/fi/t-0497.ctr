Server init.

# kirjoita testitiedosto
>> f := Tiedosto uusi: ['/tmp/test.gif'].
f kirjoita: ['GIF87a01234567810'].

# tarjoile tiedosto
Server välitä: ['test.gif'] etuliite: ['/tmp/'].

Tuloste rivinvaihto.

Tuloste kirjoita: ['Säiliön ulkopuolella (turvallisuus):'], rivinvaihto.
{ Server välitä: ['../passwd'] etuliite: ['/tmp/']. }
sieppaa: { :e Tuloste kirjoita: e, rivinvaihto. },
käynnistä.

Tuloste kirjoita: ['Virheellinen etuliite:'], rivinvaihto.
{ Server välitä: ['test.gif'] etuliite: ['z:\\']. }
sieppaa: { :e Tuloste kirjoita: e, rivinvaihto. },
käynnistä.

Tuloste kirjoita: ['Olematon tiedosto:'], rivinvaihto.
{ Server välitä: ['xxx.xxx'] etuliite: ['/tmp/']. }
sieppaa: { :e Tuloste kirjoita: e, rivinvaihto. },
käynnistä.
