Tuloste kirjoita: ['Test object'], rivinvaihto.
>> a := Olio uusi. 

a kun: ['item:'] tee: { :binhelper
	oma binhelper := binhelper. 
}.

a kun: ['item'] tee: { <- oma binhelper.
}.

a item: Bin uusi.

>> old-binhelper-address := a item prototyyppi muistiosoite.
a save-as: ['/tmp/a.bin'].
Tuloste kirjoita: ['========== RELOADING SNAP:'], rivinvaihto.

>> b := Olio load-from: ['/tmp/a.bin'].

(b item prototyyppi muistiosoite = old-binhelper-address) tosi: {
	Tuloste kirjoita: ['Object link re-attached.'], rivinvaihto.
}.


