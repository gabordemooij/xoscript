>> invoice := Olio uusi.
invoice kun: ['käynnistä'] tee: {
        oma luku := 0.
}.

invoice kun: ['luku'] tee: {
        oma luku lisää: 1. <- oma luku kopioi.
}.

>> year-invoice := invoice uusi.
year-invoice kun: ['start:'] tee: { :vuosi
	oma luku := vuosi.
}.

year-invoice start: 202000.
Tuloste kirjoita: year-invoice luku, rivinvaihto.
