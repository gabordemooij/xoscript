>> lasku := Olio uusi.
lasku kun: ['käynnistä'] tee: {
        oma luku := 0.
}.

lasku kun: ['luku'] tee: {
        oma luku lisää: 1.
        <- oma luku kopioi.
}.

>> vuosilasku := lasku uusi.
vuosilasku kun: ['start:'] tee: { :vuosi
	oma luku := vuosi.
}.

vuosilasku start: 202000.
Tuloste kirjoita: vuosilasku luku, rivinvaihto.
Tuloste kirjoita: vuosilasku luku, rivinvaihto.
