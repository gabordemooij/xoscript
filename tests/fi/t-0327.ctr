

Lista kun: ['fixture:'] tee: { :f
	oma fixture := f.
}.

Lista kun: ['lukumäärä'] tee: { <- oma fixture.
}.

Lista kun: ['aantal'] tee: { <- oma fixture.
}.


>> x := Tyhjä.
{

	x := ['hello'] 
	korvaa:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] merkki: 2)
			)
		)
	arvolla: (
		(['...hal'] + ['lo']) 
			isot-kirjaimet 
			lowecase 
			isot-kirjaimet 
			siirtymä: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Lista ← 0 ; 1 ; 4; 9 ; (Lista ← 0 ; 3; 1) ; 4
							) toiseksi-viimeinen
						) ? 1
					) + 
					((Lista ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					lukumäärä
				)
			)
	).

} × 10.
Tuloste kirjoita: x, rivinvaihto.

