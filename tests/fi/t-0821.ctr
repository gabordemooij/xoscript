# lainausmerkin, joka ei koskaan sulkeudu, täytyy antaa virhe eikä ikuista silmukkaa
>> polku := ['/tmp/test0821.csv'].
>> file := Tiedosto uusi: polku.

file kirjoita: ['a,b\n"1,2\n'].
{
	file erotin: [','] lainausmerkki: ['"'] rivit: { :line
		Tuloste kirjoita: line, rivinvaihto.
	}.
} sieppaa: { :e Tuloste kirjoita: e, rivinvaihto. }, käynnistä.

# suljettu lainausmerkki toimii yhä
file kirjoita: ['a,b\n"1,2",3'].
file erotin: [','] lainausmerkki: ['"'] rivit: { :line
	Tuloste kirjoita: line, rivinvaihto.
}.
file poista.
