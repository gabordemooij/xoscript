>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Olio uusi.
⚄ kun: ['drawFrom:length:'] tee: { :pool :lukumäärä
	
	>> result := [''].
	
	{
		>> index := Luku random % (pool pituus).
		result lisää-loppuun: ( pool merkki: (index + 1) ).
		
	} × lukumäärä. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? pituus.
Tuloste kirjoita: (['x↵'] x random pituus).
Tuloste kirjoita: (['y↵'] y ?? pituus).

