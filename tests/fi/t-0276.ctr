>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Olio uusi.
⚄ kun: ['arvoJoukosta:määrä:'] tee: { :pool :lukumäärä
	
	>> tulos := [''].
	
	{
		>> indeksi := Luku satunnaisluku % (pool pituus).
		tulos lisää-loppuun: ( pool merkki: (indeksi + 1) ).
		
	} × lukumäärä. <- tulos.
}.

>> satunnaisluku := ⚄ arvoJoukosta: ?? määrä: ?? pituus.
Tuloste kirjoita: (['x↵'] x satunnaisluku pituus).
Tuloste kirjoita: (['y↵'] y ?? pituus).

