Luku kun: ['factorial'] tee: {
	>> total := 1.
	{ :index total kerro: (itse - (index)). } × itse. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Tuloste kirjoita: a.
>> b := 2 + 3 factorial.
Tuloste kirjoita: b.
>> c := 3 factorial + 2.
Tuloste kirjoita: c.
>> d := 2 + (3 factorial).
Tuloste kirjoita: d.
Tuloste kirjoita: 2 + 3 factorial + 1.
