Luku kun: ['kertoma'] tee: {
	>> yhteensä := 1.
	{ :indeksi yhteensä kerro: (itse - (indeksi)). } × itse. <- yhteensä.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Tuloste kirjoita: a.
>> b := 2 + 3 kertoma.
Tuloste kirjoita: b.
>> c := 3 kertoma + 2.
Tuloste kirjoita: c.
>> d := 2 + (3 kertoma).
Tuloste kirjoita: d.
Tuloste kirjoita: 2 + 3 kertoma + 1.
