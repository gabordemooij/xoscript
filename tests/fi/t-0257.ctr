
>> Tervehtijä := Olio uusi.
Tervehtijä kun: ['uusi'] tee: {
	oma nimi := ['?'].
}.
Tervehtijä kun: ['name:'] tee: { :nimi
	oma nimi := nimi.
}.
Tervehtijä kun: ['tervehdi'] tee: {
	Tuloste kirjoita: (['hello[you]'] [you]: oma nimi).
}.
>> ystävä := Tervehtijä uusi.
ystävä name: ['1'].
ystävä tervehdi.
