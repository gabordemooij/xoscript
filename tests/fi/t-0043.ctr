>> toistaja := Olio uusi.
toistaja kun: ['vastaa:'] tee: { :mitä
	Tuloste kirjoita: mitä + [' '].
}.
toistaja kun: ['vastaa:ja:'] tee: { :mitä :say
	Tuloste kirjoita: mitä, kirjoita: say + [' '].
}.
toistaja kun: ['vastaa:ja:ja:'] tee: { :mitä :say :lisäksi
	Tuloste kirjoita: mitä, kirjoita: say, kirjoita: lisäksi.
}.
toistaja toista.
toistaja everything: ['Minä sanon.'].
toistaja and: ['I '] everything: ['do.'].
