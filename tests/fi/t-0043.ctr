>> repeater := Olio uusi.
repeater kun: ['vastaa:'] tee: { :what
	Tuloste kirjoita: what + [' '].
}.
repeater kun: ['vastaa:ja:'] tee: { :what :say
	Tuloste kirjoita: what, kirjoita: say + [' '].
}.
repeater kun: ['vastaa:ja:ja:'] tee: { :what :say :more
	Tuloste kirjoita: what, kirjoita: say, kirjoita: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
