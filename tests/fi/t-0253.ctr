#Linux
>> OS := Ohjelma asetus: ['OS'].

>> clock := Hetki uusi.
	
(OS = ['Haiku']) tosi: {
	clock aikavyöhyke: ['CET'],
	vuosi: 2017, kuukausi: 7, päivä: 13,
	tunti: 18, minuutti: 0, sekunti: 0.
}, muuten: {
	clock aikavyöhyke: ['Europe/Amsterdam'],
	vuosi: 2017, kuukausi: 7, päivä: 13,
	tunti: 18, minuutti: 0, sekunti: 0.
}.

clock kun: ['tell'] tee: {
	Tuloste kirjoita: itse, rivinvaihto.
}.


clock lisää: 2    tunti, tell.
clock lisää: 1    tunti, tell.
clock lisää: 19 minuutti, tell.
clock lisää: 1  minuutti, tell.
clock lisää: 1  minuutti, tell.
clock lisää: 19 sekunti, tell.
clock lisää: 1  sekunti, tell.
clock lisää: 1  sekunti, tell.
clock lisää: 2    vuosi, tell.
clock lisää: 1    vuosi, tell.

(OS = ['Haiku']) tosi: {
clock lisää: 5   kuukausi.
clock aikavyöhyke: ['CEST'], tell.
}, muuten: {
	clock lisää: 5   kuukausi, tell.
}.

clock lisää: 1   kuukausi, tell.
clock lisää: 19    päivä, tell.
clock lisää: 1    tunti, tell.
clock lisää: 120  yard, tell.
