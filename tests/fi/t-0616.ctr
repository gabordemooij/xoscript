Lista kun: ['kopioi'] tee: {
	>> kopioi := Lista uusi.
	itse jokainen: { :luku :section
		kopioi lisää-loppuun: section rekursiivinen kopioi.
	}. <- kopioi.
}.

>> sheep := Lista uusi ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep kopioi.
clones jokainen: { :luku :sheep
	sheep lisää-loppuun: ['2'].
}.

Tuloste kirjoita: sheep, rivinvaihto.
Tuloste kirjoita: clones, rivinvaihto.
