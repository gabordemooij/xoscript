Lista kun: ['kopioi'] tee: {
	>> kopioi := Lista uusi.
	itse jokainen: { :luku :jakso
		kopioi lisää-loppuun: jakso rekursiivinen kopioi.
	}.
	<- kopioi.
}.

>> lammas := Lista uusi ; ['Dolly'] ; ['Shaun']. 
>> kloonit := lammas kopioi.
kloonit jokainen: { :luku :lammas
	lammas lisää-loppuun: ['2'].
}.

Tuloste kirjoita: lammas, rivinvaihto.
Tuloste kirjoita: kloonit, rivinvaihto.
