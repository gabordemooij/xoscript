	tuntematon teeJotain.
} sieppaa: {
	Tuloste kirjoita: ['Napattu!'].
}, käynnistä.

{
	tämä-tehtävä virhe: ['Älä epäonnistu.'].
	oma tuntematon teeJotain.
} sieppaa: {
	Tuloste kirjoita: ['Napattu!'].
}, käynnistä.

{
	tämä-tehtävä virhe: ['Älä epäonnistu.'].
	tuntematon := 122.
} sieppaa: {
	Tuloste kirjoita: ['Napattu!'].
}, käynnistä.


{
	tämä-tehtävä virhe: ['Älä epäonnistu.'].
	Tosi keskeytä.
	Tuloste kirjoita: ['EPÄONNISTUI'].
} sieppaa: {
	Tuloste kirjoita: ['Napattu!'].
}, käynnistä.

{
	{
		tämä-tehtävä virhe: ['Älä epäonnistu.'].
		Tosi keskeytä.
		Tuloste kirjoita: ['EPÄONNISTUI'].
	} sieppaa: { :x
		(x = ['Älä epäonnistu.']) tosi: { tämä-tehtävä virhe: ['Sisäkkäinen napattu!']. }.
	}, käynnistä.
} sieppaa: { :e
	Tuloste kirjoita: e.
}, käynnistä.
