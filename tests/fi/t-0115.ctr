{
	tämä-tehtävä virhe: ['Dont fail.'].
	unknown doSomething.
} sieppaa: {
	Tuloste kirjoita: ['Caught!'].
}, käynnistä.

{
	tämä-tehtävä virhe: ['Dont fail.'].
	oma unknown doSomething.
} sieppaa: {
	Tuloste kirjoita: ['Caught!'].
}, käynnistä.

{
	tämä-tehtävä virhe: ['Dont fail.'].
	unknown := 122.
} sieppaa: {
	Tuloste kirjoita: ['Caught!'].
}, käynnistä.


{
	tämä-tehtävä virhe: ['Dont fail.'].
	Tosi keskeytä.
	Tuloste kirjoita: ['FAIL'].
} sieppaa: {
	Tuloste kirjoita: ['Caught!'].
}, käynnistä.

{
	{
		tämä-tehtävä virhe: ['Dont fail.'].
		Tosi keskeytä.
		Tuloste kirjoita: ['FAIL'].
	} sieppaa: { :x
		(x = ['Dont fail.']) tosi: { tämä-tehtävä virhe: ['Nested Caught!']. }.
	}, käynnistä.
} sieppaa: { :e
	Tuloste kirjoita: e.
}, käynnistä.
