# yhteensopivuustesti

# käytä kansainvälisiä lukuja

Tuloste kirjoita: ['1000 -> '].
Tuloste kirjoita: 1000, rivinvaihto. #1000

Tuloste kirjoita: ['1.5 -> '].
Tuloste kirjoita: 1.5, rivinvaihto.  #1.5

Tuloste kirjoita: ['1001.5 -> '].
Tuloste kirjoita: 1.5 + 1000, rivinvaihto. #1001.5

# käytä 0-indeksoituja taulukoita
>> x := Lista uusi ; 1 ; 2 ; 3.
>> y := Lista uusi ; ['a'] ; ['b'] ; ['c'].

Tuloste kirjoita: ['1 -> '].
Tuloste kirjoita: x ? 0, rivinvaihto. #1

Tuloste kirjoita: ['1 -> '].
Tuloste kirjoita: (x kohdassa: 0), rivinvaihto. #1

Tuloste kirjoita: ['1 -> '].
Tuloste kirjoita: x ensimmäinen, rivinvaihto. #1

Tuloste kirjoita: ['3 -> '].
Tuloste kirjoita: x viimeinen, rivinvaihto. #3

Tuloste kirjoita: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Tuloste kirjoita: (x avaimilla: y), rivinvaihto.

Tuloste kirjoita: ['1 -> '].
Tuloste kirjoita: (x alkaen: 0 pituus: 1) ensimmäinen, rivinvaihto. #1

Tuloste kirjoita: ['0 -> '].
Tuloste kirjoita: (x etsi: 1), rivinvaihto. #0

x aseta: 9 kohtaan: 0.

Tuloste kirjoita: ['9 -> '].
Tuloste kirjoita: (x kohdassa: 0), rivinvaihto. #9

x lisää-alkuun: 8.
Tuloste kirjoita: ['8 -> '].
Tuloste kirjoita: (x kohdassa: 0), rivinvaihto. #9


x lisää-loppuun: 10.
Tuloste kirjoita: ['10 -> '].
Tuloste kirjoita: (x kohdassa: 4), rivinvaihto. #10








