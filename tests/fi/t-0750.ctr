Tuloste kirjoita: ['Test object'], rivinvaihto.
>> a := Olio uusi. 

a kun: ['item:'] tee: { :nil
	oma nil := nil. 
}.

a kun: ['item'] tee: { <- oma nil.
}.

a item: Tyhjä.

Tuloste kirjoita: a item, rivinvaihto.

>> old-nil-address := a item prototyyppi muistiosoite.
a save-as: ['/tmp/a.bin'].
Tuloste kirjoita: ['========== RELOADING SNAP:'], rivinvaihto.

>> b := Olio load-from: ['/tmp/a.bin'].

(b item prototyyppi muistiosoite = old-nil-address) tosi: {
	Tuloste kirjoita: ['Object link re-attached.'], rivinvaihto.
}.

Tuloste kirjoita: b item, rivinvaihto.
