Tuloste kirjoita: ['Continue for-loop, No - before 6 and up.'], rivinvaihto.
{ :i
	Tuloste kirjoita: (i + 1), rivinvaihto.
	((i + 1) > 4) jatka.
	Tuloste kirjoita: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Tuloste rivinvaihto.
Tuloste kirjoita: ['Continue while-true, No --> before 5 and up.'], rivinvaihto.
{
	Tuloste kirjoita: ['iteration #'] + x, rivinvaihto.
	x lisää: 1.
	((x < 5) ei) jatka.
	Tuloste kirjoita: ['-->'].
} kun: xIsLessThan10.
Tuloste rivinvaihto.
Tuloste kirjoita: ['Continue while-false, No - before 3 only.'], rivinvaihto.
{
	Tuloste kirjoita: ['iteration #'] + x, rivinvaihto.
	x vähennä: 1.
	(x = 3) jatka.
	Tuloste kirjoita: ['-'].
} kun: { <- ( x > 0). }.

Tuloste rivinvaihto.
Tuloste kirjoita: ['Continue times-loop, No ||| before 3.'], rivinvaihto.
{ :i
	Tuloste kirjoita: ['iteration #'] + i, rivinvaihto.
	(i = 2) jatka.
	Tuloste kirjoita: ['|||'].
} × 5.

Tuloste rivinvaihto.

{ Tosi jatka. Tuloste kirjoita: ['dont write this!'], rivinvaihto. } käynnistä.

{ Tosi jatka. Tuloste kirjoita: ['dont write this!'], rivinvaihto. } sieppaa: { Tuloste kirjoita: ['Dont catch this!']. }, käynnistä.

Tuloste kirjoita: ['Test Array each-loop: 0, ... ,2'], rivinvaihto.
(Lista ← 1 ; 2 ; 3) kuvaa: { :i
	(i = 1) jatka.
	Tuloste kirjoita: ['iteration #'] + (i - 0), rivinvaihto.
}.

Tuloste kirjoita: ['Test Map each-loop: c only'], rivinvaihto.
>> m := Sanakirja uusi.
m aseta: ['first'] kohtaan: ['a'], aseta: ['second'] kohtaan: ['b'], aseta: ['third'] kohtaan: ['c'].
m jokainen: { :k :v
	(k ≠ ['c']) jatka.
	Tuloste kirjoita: ['iteration'] + k + v, rivinvaihto.
}.

