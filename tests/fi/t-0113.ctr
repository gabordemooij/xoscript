Tuloste kirjoita: ['Jatka for-silmukkaa, Ei - ennen 6:ta ja siitä ylöspäin.'], rivinvaihto.
{ :i
	Tuloste kirjoita: (i + 1), rivinvaihto.
	((i + 1) > 4) jatka.
	Tuloste kirjoita: ['-'].
} × 10.

>> x := 0.
>> xOnPienempiKuin10 := { <- ( x < 10 ). }.
Tuloste rivinvaihto.
Tuloste kirjoita: ['Jatka while-true, Ei --> ennen 5:tä ja siitä ylöspäin.'], rivinvaihto.
{
	Tuloste kirjoita: ['iteration #'] + x, rivinvaihto.
	x lisää: 1.
	((x < 5) ei) jatka.
	Tuloste kirjoita: ['-->'].
} kun: xOnPienempiKuin10.
Tuloste rivinvaihto.
Tuloste kirjoita: ['Jatka while-false, Ei - vain ennen 3:a.'], rivinvaihto.
{
	Tuloste kirjoita: ['iteration #'] + x, rivinvaihto.
	x vähennä: 1.
	(x = 3) jatka.
	Tuloste kirjoita: ['-'].
} kun: { <- ( x > 0). }.

Tuloste rivinvaihto.
Tuloste kirjoita: ['Jatka times-silmukkaa, Ei ||| ennen 3:a.'], rivinvaihto.
{ :i
	Tuloste kirjoita: ['iteration #'] + i, rivinvaihto.
	(i = 2) jatka.
	Tuloste kirjoita: ['|||'].
} × 5.

Tuloste rivinvaihto.

{ Tosi jatka. Tuloste kirjoita: ['älä kirjoita tätä!'], rivinvaihto. } käynnistä.

{ Tosi jatka. Tuloste kirjoita: ['älä kirjoita tätä!'], rivinvaihto. } sieppaa: { Tuloste kirjoita: ['Älä nappaa tätä!']. }, käynnistä.

Tuloste kirjoita: ['Testaa taulukon each-silmukka: 0, ... ,2'], rivinvaihto.
(Lista ← 1 ; 2 ; 3) kuvaa: { :i
	(i = 1) jatka.
	Tuloste kirjoita: ['iteration #'] + (i - 0), rivinvaihto.
}.

Tuloste kirjoita: ['Testaa kartan each-silmukka: vain c'], rivinvaihto.
>> m := Sanakirja uusi.
m aseta: ['first'] kohtaan: ['a'], aseta: ['second'] kohtaan: ['b'], aseta: ['kolmas'] kohtaan: ['c'].
m jokainen: { :k :v
	(k ≠ ['c']) jatka.
	Tuloste kirjoita: ['iteration'] + k + v, rivinvaihto.
}.

