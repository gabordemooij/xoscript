Tuloste kirjoita: ['Test object'], rivinvaihto.
>> a := Olio uusi. 

a kun: ['item:'] tee: { :octhelper
	oma octhelper := octhelper. 
}.

a kun: ['item'] tee: { <- oma octhelper.
}.

a item: Oct uusi.

>> old-octhelper-address := a item prototyyppi muistiosoite.
a save-as: ['/tmp/a.bin'].
Tuloste kirjoita: ['========== RELOADING SNAP:'], rivinvaihto.

>> b := Olio load-from: ['/tmp/a.bin'].

(b item prototyyppi muistiosoite = old-octhelper-address) tosi: {
	Tuloste kirjoita: ['Object link re-attached.'], rivinvaihto.
}.
