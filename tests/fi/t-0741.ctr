Tuloste kirjoita: ['Testiolio'], rivinvaihto.
>> a := Olio uusi. 

a kun: ['item:'] tee: { :oktapuri
	oma oktapuri := oktapuri. 
}.

a kun: ['esine'] tee: {
	<- oma oktapuri.
}.

a item: Oct uusi.

>> vanha-oktapuri-osoite := a esine prototyyppi muistiosoite.
a save-as: ['/tmp/a.bin'].
Tuloste kirjoita: ['========== LADATAAN SNAP UUDELLEEN:'], rivinvaihto.

>> b := Olio load-from: ['/tmp/a.bin'].

(b esine prototyyppi muistiosoite = vanha-oktapuri-osoite) tosi: {
	Tuloste kirjoita: ['Olion linkki liitetty uudelleen.'], rivinvaihto.
}.
