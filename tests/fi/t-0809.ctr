# backslashes must survive code serialization, strings must not end early
>> arvot := Lista uusi
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

arvot jokainen: { :i :value
	>> d := Sanakirja uusi.
	d aseta: value kohtaan: ['k'].
	>> r := d koodi olio.
	Tuloste kirjoita: r lukumäärä, rivinvaihto.
	Tuloste kirjoita: ( (r kohdassa: ['k']) = value ), rivinvaihto.
}.
