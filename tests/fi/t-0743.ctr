>> V := Olio.
V kun: ['teksti'] tee: {
	Tuloste kirjoita: ['muunnos'], rivinvaihto.
	<- ['abc'].
}.

Tuloste kirjoita: ( Ohjelma asetus: ['abc'] ), rivinvaihto.

# parametrit eivät saa joutua roskienkeruuseen
Ohjelma asetus: ([''] + V uusi) arvo: ([''] + V uusi).

Tuloste kirjoita: ( Ohjelma asetus: ['abc'] ), rivinvaihto.
