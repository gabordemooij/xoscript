
>> countries := Lista uusi
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Lista uusi
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods avaimilla: countries, jokainen: { :key :value
	counter lisää: 1.
}.

Tuloste kirjoita: (['we serve counter dishes'] counter: counter), rivinvaihto.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] merkit järjestä: { :v
	counter lisää: 0.
}.

Tuloste kirjoita: (['we sort counter dishes'] counter: counter), rivinvaihto.


>> counter := 0.
{
	{
		counter lisää: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Tuloste kirjoita: (['we calculate counter numbers.'] counter: counter), rivinvaihto.

