
>> maat := Lista uusi
	~ ['Sveitsi']
	~ ['Italia']
	~ ['Saksa'].

>> ruoat := Lista uusi
	~ ['Rösti']
	~ ['Spagetti']
	~ ['Hapankaali'].


>> laskuri := 0.
ruoat avaimilla: maat, jokainen: { :key :value
	laskuri lisää: 1.
}.

Tuloste kirjoita: (['we serve counter dishes'] counter: laskuri), rivinvaihto.

>> laskuri := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] merkit järjestä: { :v
	laskuri lisää: 0.
}.

Tuloste kirjoita: (['we sort counter dishes'] counter: laskuri), rivinvaihto.


>> laskuri := 0.
{
	{
		laskuri lisää: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Tuloste kirjoita: (['we calculate counter numbers.'] counter: laskuri), rivinvaihto.

