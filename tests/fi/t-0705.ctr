

>> ol := Olio uusi.

ol kun: ['tervehdi'] tee: {
	<- ['moi'].
}.

# tulosteen täytyy olla hi123hi123ok
ol kun: ['tehtävä'] tee: {
	oma ominaisuus := 123.
	{
		# yritä sitoo itse/oma olioon eikä lohkoon
		Tuloste kirjoita: itse tervehdi.
		Tuloste kirjoita: oma ominaisuus.
		1 / 0.
	} sieppaa: {
		Tuloste kirjoita: itse tervehdi.
		Tuloste kirjoita: oma ominaisuus.
		Tuloste kirjoita: ['ok'].
	}, yritä.
}.

ol tehtävä.