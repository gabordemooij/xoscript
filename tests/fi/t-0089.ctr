>> arpoja := { :a :b
	>> minimi := ( a < b ) joko: a tai: b.
	>> maksimi := ( a > b ) joko: a tai: b.
	>> x := Tyhjä.
	{
		x := Luku väliltä: a ja: b.
		((x < minimi) tai: (x > maksimi)) tosi: { 
			Tuloste kirjoita: (['Virheellinen arvo!']).
			Ohjelma lopeta.
		}.
	} 
	× 100. <- x.
}.
arpoja sovella: 0 ja: 0.
arpoja sovella: 1 ja: 0.
arpoja sovella: 1 ja: 1.
arpoja sovella: 0 ja: 1.
arpoja sovella: -1 ja: 0.
arpoja sovella: -1 ja: -1.
arpoja sovella: 0 ja: -1.
