#Linux
>> Hörppy := Olio uusi.

Hörppy kun: ['uusi'] tee: {
	oma str := [''].
}.

Hörppy kun: ['nieuw'] tee: {
	oma str := [''].
}.

Hörppy kun: ['vastaa:'] tee: { :blah
		oma str lisää-loppuun: blah.
}.

Hörppy kun: ['vastaa:ja:'] tee: { :blah :blahah
		oma str lisää-loppuun: (blah alkaen: 0 pituus: (blah pituus - 1)).
		oma str lisää-loppuun: [' '].
		oma str lisää-loppuun: blahah.
}.

Hörppy kun: ['hanki'] tee: {
	>> puskuri := oma str.
	oma str := ['']. <- puskuri.
}.


Tuloste kirjoita: (Ohjelma järjestelmä: (Hörppy uusi echo: ['Hei, osaan kirjoittaa konsoliin sujuvalla API:lla!'], hanki)).


{ Tiedosto uusi: ['/tmp/from.txt'], poista. } sieppaa: { ['Tyhjä']. }, käynnistä.
{ Tiedosto uusi: ['/tmp/to.txt'], poista. } sieppaa: { ['Tyhjä']. }, käynnistä.


Tiedosto uusi: ['/tmp/to.txt'], on-olemassa epätosi: {
	Tuloste kirjoita: ['Confirmed. Target file does not exist.\
'].
}.
Tiedosto uusi: ['/tmp/from.txt'], on-olemassa epätosi: {
	Tuloste kirjoita: ['Confirmed. Source file does not exist.\
'].
}.



Ohjelma järjestelmä: (Hörppy uusi touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], hanki).



Ohjelma järjestelmä: (Hörppy uusi cp: ['/tmp/from.txt /tmp/to.txt'], hanki).

Tiedosto uusi: ['/tmp/to.txt'], on-olemassa tosi: {
	Tuloste kirjoita: ['Confirmed. Target file has been created by shell.\
'].
}.


Tuloste kirjoita: ['Tiedoston sisältö on:'] + (Tiedosto uusi: ['/tmp/to.txt'], lue), rivinvaihto.
