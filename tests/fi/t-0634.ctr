# Ohjelma shell-escape tuottaa kanonista POSIX-shellin syntaksia
# yhteensopiva: bash/dash, zsh, ksh

>> c := Ohjelma shell-escape: ['abc'].
Tuloste kirjoita: c, rivinvaihto.
Tuloste kirjoita: ( Ohjelma järjestelmä: ['echo '] + c ), rivinvaihto.

c := Ohjelma shell-escape: ['a'b'c'].
Tuloste kirjoita: c, rivinvaihto.
Tuloste kirjoita: ( Ohjelma järjestelmä: ['echo '] + c ), rivinvaihto.

c := Ohjelma shell-escape: ['a\'c'].
Tuloste kirjoita: c, rivinvaihto.
Tuloste kirjoita: ( Ohjelma järjestelmä: ['echo '] + c ), rivinvaihto.