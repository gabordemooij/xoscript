
Tuloste kirjoita: ['Keskeytä for-silmukka, 0-4.'], rivinvaihto.
{ :i
	Tuloste kirjoita: ['iteration #'] + i, rivinvaihto.
	(i = 4) keskeytä.
} × 10.

>> x := 0.
>> xOnPienempiKuin10 := { <- ( x < 10 ). }.

Tuloste kirjoita: ['Keskeytä while-true-silmukka, 0-4.'], rivinvaihto.
{
	Tuloste kirjoita: ['iteration #'] + x, rivinvaihto.
	x lisää: 1.
	((x < 5) ei) keskeytä.
} kun: xOnPienempiKuin10.

Tuloste kirjoita: ['Keskeytä while-false-silmukka, 5,4.'], rivinvaihto.
{
	Tuloste kirjoita: ['iteration #'] + x, rivinvaihto.
	x vähennä: 1.
	(x = 3) keskeytä.
} kun: { <- (x > 0). }.

Tuloste kirjoita: ['Keskeytä times-silmukka, 1-4.'], rivinvaihto.
{ :i
	Tuloste kirjoita: ['iteration #'] + i, rivinvaihto.
	(i = 4) keskeytä.
} × 5.

Tuloste kirjoita: ['Keskeytä lohko, älä tulosta riviä.'], rivinvaihto.
{ Tosi keskeytä. Tuloste kirjoita: ['älä kirjoita tätä!'], rivinvaihto. } käynnistä.

Tuloste kirjoita: ['Keskeytä lohko, älä laukaise catchia...'], rivinvaihto.
{ Tosi keskeytä. Tuloste kirjoita: ['älä kirjoita tätä!'], rivinvaihto. } sieppaa: { Tuloste kirjoita: ['Älä nappaa tätä!']. }, käynnistä.

Tuloste kirjoita: ['Testaa taulukon each-silmukka: 0,1'], rivinvaihto.
(Lista ← 1 ; 2 ; 3) kuvaa: { :i
	Tuloste kirjoita: ['iteration #'] + i, rivinvaihto.
	(i = 1) keskeytä.
}.

Tuloste kirjoita: ['Testaa kartan each-silmukka: vain c'], rivinvaihto.
>> m := Sanakirja uusi.
m aseta: ['first'] kohtaan: ['a'], aseta: ['second'] kohtaan: ['b'], aseta: ['kolmas'] kohtaan: ['c'].
m jokainen: { :k :v
	Tuloste kirjoita: ['iteration'] + v + k, rivinvaihto.
	Tosi keskeytä.
}.

