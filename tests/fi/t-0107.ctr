
Tuloste kirjoita: ['Break for-loop, 0-4.'], rivinvaihto.
{ :i
	Tuloste kirjoita: ['iteration #'] + i, rivinvaihto.
	(i = 4) keskeytä.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Tuloste kirjoita: ['Break while-true loop, 0-4.'], rivinvaihto.
{
	Tuloste kirjoita: ['iteration #'] + x, rivinvaihto.
	x lisää: 1.
	((x < 5) ei) keskeytä.
} kun: xIsLessThan10.

Tuloste kirjoita: ['Break while-false loop, 5,4.'], rivinvaihto.
{
	Tuloste kirjoita: ['iteration #'] + x, rivinvaihto.
	x vähennä: 1.
	(x = 3) keskeytä.
} kun: { <- (x > 0). }.

Tuloste kirjoita: ['Break times loop, 1-4.'], rivinvaihto.
{ :i
	Tuloste kirjoita: ['iteration #'] + i, rivinvaihto.
	(i = 4) keskeytä.
} × 5.

Tuloste kirjoita: ['Break block, dont print line.'], rivinvaihto.
{ Tosi keskeytä. Tuloste kirjoita: ['dont write this!'], rivinvaihto. } käynnistä.

Tuloste kirjoita: ['Break block, dont fire catch...'], rivinvaihto.
{ Tosi keskeytä. Tuloste kirjoita: ['dont write this!'], rivinvaihto. } sieppaa: { Tuloste kirjoita: ['Dont catch this!']. }, käynnistä.

Tuloste kirjoita: ['Test Array each-loop: 0,1'], rivinvaihto.
(Lista ← 1 ; 2 ; 3) kuvaa: { :i
	Tuloste kirjoita: ['iteration #'] + i, rivinvaihto.
	(i = 1) keskeytä.
}.

Tuloste kirjoita: ['Test Map each-loop: c only'], rivinvaihto.
>> m := Sanakirja uusi.
m aseta: ['first'] kohtaan: ['a'], aseta: ['second'] kohtaan: ['b'], aseta: ['third'] kohtaan: ['c'].
m jokainen: { :k :v
	Tuloste kirjoita: ['iteration'] + v + k, rivinvaihto.
	Tosi keskeytä.
}.

