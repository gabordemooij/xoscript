Server init.

>> DB := Maria-DB uusi isäntä: ['localhost'],
	käyttäjänimi: ['xo'],
	salasana: ['pass123'],
	tietokannan-nimi: ['xobase'],
	yhdistä.

{
	DB kysely:
	['DROP TABLE movies'],
	suorita.
} sieppaa: { Tyhjä. }, käynnistä.

DB kysely:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
suorita.

DB kysely: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parametrit: ( Lista uusi ; ['Halloween'] ),
suorita.

DB kysely: ['SELECT * FROM movies'],
hae: { :movie
	Tuloste kirjoita: movie title, rivinvaihto.
}.

