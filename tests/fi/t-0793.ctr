Server init.

>> TK := Maria-DB uusi isäntä: ['localhost'],
	käyttäjänimi: ['xo'],
	salasana: ['pass123'],
	tietokannan-nimi: ['xobase'],
	yhdistä.

{
	TK kysely:
	['DROP TABLE movies'],
	suorita.
} sieppaa: { Tyhjä. }, käynnistä.

TK kysely:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
suorita.

TK kysely: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parametrit: ( Lista uusi ; ['Halloween'] ),
suorita.

TK kysely: ['SELECT * FROM movies'],
hae: { :elokuva
	Tuloste kirjoita: elokuva title, rivinvaihto.
}.

