#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Ohjelma muistinhallinta: 0.

{
Hetki aika.
Hetki odota: 1.
Tuloste kirjoita: Ohjelma argumentit, rivinvaihto.
Ohjelma argumentti: 0.
Luku random.
Tuloste kirjoita: (Ohjelma järjestelmä: ['echo 'Hello'']).
} käynnistä.

Ohjelma siivoa.
usedMemory1 := (Ohjelma muisti ? 0).

{
Hetki aika.
Hetki odota: 1.
Tuloste kirjoita: Ohjelma argumentit, rivinvaihto.
Ohjelma argumentti: 0.
Luku random.
Tuloste kirjoita: (Ohjelma järjestelmä: ['echo 'Hello'']).
} käynnistä.

Ohjelma siivoa.
usedMemory2 := (Ohjelma muisti ? 0).

{
Hetki aika.
Hetki odota: 1.
Tuloste kirjoita: Ohjelma argumentit, rivinvaihto.
Ohjelma argumentti: 0.
Luku random.
Tuloste kirjoita: (Ohjelma järjestelmä: ['echo 'Hello'']).
} käynnistä.

Ohjelma siivoa.
