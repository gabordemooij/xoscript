
Teksti kun: ['html'] tee: { <- (
		itse
		korvaa: ['&'] arvolla: ['&amp;'],
		korvaa: ['<'] arvolla: ['&lt;'],
		korvaa: ['>'] arvolla: ['&gt;'],
		korvaa: ['"'] arvolla: ['&quot;']
	).
}.

>> HtmlBrush := Olio uusi.

HtmlBrush kun: ['vastaa:'] tee: { :tag
	Tuloste kirjoita: (['<tag>↵'] tag: tag ).
}.

HtmlBrush kun: ['vastaa:ja:'] tee: { :tag :content
	tag := ( tag alkaen: 0 pituus: (tag pituus - 1) ).
	Tuloste kirjoita: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush kun: ['content:'] tee: { :text
	Tuloste kirjoita: text html, rivinvaihto.
}.

HtmlBrush kun: ['attr:value:'] tee: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush uusi.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
