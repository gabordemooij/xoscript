
Teksti kun: ['html'] tee: { <- (
		itse
		korvaa: ['&'] arvolla: ['&amp;'],
		korvaa: ['<'] arvolla: ['&lt;'],
		korvaa: ['>'] arvolla: ['&gt;'],
		korvaa: ['"'] arvolla: ['&quot;']
	).
}.

>> HtmlSivellin := Olio uusi.

HtmlSivellin kun: ['vastaa:'] tee: { :tagi
	Tuloste kirjoita: (['<tag>↵'] tag: tagi ).
}.

HtmlSivellin kun: ['vastaa:ja:'] tee: { :tagi :content
	tagi := ( tagi alkaen: 0 pituus: (tagi pituus - 1) ).
	Tuloste kirjoita: (['<tag content>↵'] tag: tagi, content: content).
}.

HtmlSivellin kun: ['content:'] tee: { :tekstisisältö
	Tuloste kirjoita: tekstisisältö html, rivinvaihto.
}.

HtmlSivellin kun: ['attr:arvoksi:'] tee: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlSivellin uusi.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] arvoksi: ['bold']),
		/span
	/body
/html.
		
