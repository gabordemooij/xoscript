#ffi test


Server init.

Ohjelma muistinhallinta: 4.

# for this test you need set a path to libc (puts)
>> libname := Ohjelma asetus: ['FFITESTLIB'].



Server linkitä: (
 Lista uusi ;
 libname ;
 ['puts'] ;
 ( Lista uusi ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s vapauta.

# test with struct

>> a := Blob uusi: 8.
a bytes: (
	Lista <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Lista <<: ['int'], ; ['int']).

Server linkitä: (
	Lista <<: ['@structtest'], ;
	['@structtest'] ;
	(Lista <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Tuloste kirjoita: ['Sum test:'] + (ffitest ffisum: a), rivinvaihto.

struct vapauta-struct.
struct vapauta.
a vapauta.
