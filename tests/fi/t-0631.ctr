#ffi-testi


Server init.

Ohjelma muistinhallinta: 4.

# tätä testiä varten sinun on asetettava polku libc:hen (puts)
>> kirjastonimi := Ohjelma asetus: ['FFITESTLIB'].



Server linkitä: (
 Lista uusi ;
 kirjastonimi ;
 ['puts'] ;
 ( Lista uusi ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s vapauta.

# testi structilla

>> a := Blob uusi: 8.
a bytes: (
	Lista <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> rakenne := Blob struct: (Lista <<: ['int'], ; ['int']).

Server linkitä: (
	Lista <<: ['@structtest'], ;
	['@structtest'] ;
	(Lista <<: rakenne) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Tuloste kirjoita: ['Summatesti:'] + (ffitest ffisum: a), rivinvaihto.

rakenne vapauta-struct.
rakenne vapauta.
a vapauta.
