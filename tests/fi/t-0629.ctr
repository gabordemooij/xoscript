# tietokantatesti
# katso vaadittavat asetukset esimerkistä server.xo

Server init.
Tuloste kirjoita: ['Tietokantatesti'], rivinvaihto.

>> tk := Maria-DB uusi isäntä: ['localhost'],
	käyttäjänimi: ['xo'], salasana: ['pass123'], tietokannan-nimi: ['xobase'], yhdistä.

Tuloste kirjoita: ['Voimmeko yhdistää? '] + tk yhdistetty?, rivinvaihto.

>> hakuparametrit := tk kysely: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parametrit: ( Lista uusi ; ['abc'] ; 12.35 ; 6 ). # parametrisoidut kyselyt

{  hakuparametrit suorita. tk vahvista. } sieppaa: { :e tk peru.  }, käynnistä.

Tuloste kirjoita: ['Voimmeko lisätä? '] + ( hakuparametrit insert-id > 0 ), rivinvaihto.

>> Ol := Olio uusi.
Ol kun: ['hae-rivit'] tee: {
	oma lukumäärä := 0.
	>> hakuparametrit :=
	tk kysely: ['SELECT * FROM book order by id desc limit 2'], 
	hae: { :vaakarivi 
		oma lukumäärä lisää: 1.
		Tosi keskeytä.
	}. # rivien haku
	<- oma lukumäärä kopioi.
}.

Tuloste kirjoita: ['Voimmeko kysellä? '] + ( Ol hae-rivit > 0 ), rivinvaihto.
