# database test
# see example server.xo for required config

Server init.
Tuloste kirjoita: ['Database test'], rivinvaihto.

>> db := Maria-DB uusi isäntä: ['localhost'],
	käyttäjänimi: ['xo'], salasana: ['pass123'], tietokannan-nimi: ['xobase'], yhdistä.

Tuloste kirjoita: ['Can we connect? '] + db yhdistetty?, rivinvaihto.

>> hakuparametrit := db kysely: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parametrit: ( Lista uusi ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  hakuparametrit suorita. db vahvista. } sieppaa: { :e db peru.  }, käynnistä.

Tuloste kirjoita: ['Can we insert? '] + ( hakuparametrit insert-id > 0 ), rivinvaihto.

>> Obj := Olio uusi.
Obj kun: ['retrieve-rows'] tee: {
	oma lukumäärä := 0.
	>> hakuparametrit :=
	db kysely: ['SELECT * FROM book order by id desc limit 2'], 
	hae: { :row 
		oma lukumäärä lisää: 1.
		Tosi keskeytä.
	}. <- oma lukumäärä kopioi.
}.

Tuloste kirjoita: ['Can we query? '] + ( Obj retrieve-rows > 0 ), rivinvaihto.
