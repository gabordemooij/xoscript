Server init.
>> muot := Muoto uusi: ['%#3x'].

>> blob := Blob uusi: 4.
blob bytes: ( 
	Lista uusi ; 0 ; 1 ; 2 ; 3
).

>> file := Tiedosto uusi: ['/tmp/blob'].
file blob: blob.
blob vapauta.

>> lue := file blob.
lue 
alkaen: 0 
pituus: 4, 
tee jokainen: { :i :b 
	Tuloste
	kirjoita: (muot sovella-kokonaisluku: b),
	rivinvaihto.
}.
lue vapauta.
