60 × {
	>> x := (Luku random % 6) + 1.
	(x ≤ 6) epätosi: { Tuloste kirjoita: ['FAIL']. }.
	(x ≥0) epätosi: { Tuloste kirjoita: ['FAIL']. }.
	x := (Luku random % 3) + 1.
	(x < 3) epätosi: { Tuloste kirjoita: ['FAIL']. }.
	(x>-1) epätosi: { Tuloste kirjoita: ['FAIL']. }.
	x := ((Totuusarvo flip) luku).
	(x = 0 tai: x = 1) epätosi: { Tuloste kirjoita: ['FAIL']. }.
	x := ((Tosi flip) luku).
	(x = 0 tai: x = 1) epätosi: { Tuloste kirjoita: ['FAIL']. }.
	x := (Totuusarvo flip joko: ['HEAD'] tai: ['TAIL']).
	((x = ['HEAD']) tai: (x = ['TAIL'])) epätosi: { Tuloste kirjoita: ['FAIL']. }.
}.
Tuloste kirjoita: ['DONE'].

