60 × {
	>> x := (Luku satunnaisluku % 6) + 1.
	(x ≤ 6) epätosi: { Tuloste kirjoita: ['EPÄONNISTUI']. }.
	(x ≥0) epätosi: { Tuloste kirjoita: ['EPÄONNISTUI']. }.
	x := (Luku satunnaisluku % 3) + 1.
	(x < 3) epätosi: { Tuloste kirjoita: ['EPÄONNISTUI']. }.
	(x>-1) epätosi: { Tuloste kirjoita: ['EPÄONNISTUI']. }.
	x := ((Totuusarvo heitä) luku).
	(x = 0 tai: x = 1) epätosi: { Tuloste kirjoita: ['EPÄONNISTUI']. }.
	x := ((Tosi heitä) luku).
	(x = 0 tai: x = 1) epätosi: { Tuloste kirjoita: ['EPÄONNISTUI']. }.
	x := (Totuusarvo heitä joko: ['KRUUNA'] tai: ['KLAAVA']).
	((x = ['KRUUNA']) tai: (x = ['KLAAVA'])) epätosi: { Tuloste kirjoita: ['EPÄONNISTUI']. }.
}.
Tuloste kirjoita: ['VALMIS'].

