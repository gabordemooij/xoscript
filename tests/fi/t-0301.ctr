


>> viini := Olio uusi.


viini kun: ['tekstiksi'] tee: { <- ['merlot'].
}.

viini kun: ['naarTekst'] tee: { <- ['merlot'].
}.


viini kun: ['='] tee: { :other wine <- ( itse tekstiksi = other wine ).
}.

viini kun: ['=='] tee: { :other wine <- ( itse tekstiksi = other wine ).
}.



viini
	tapaus: ['cabernet'] tee: { Tuloste kirjoita: ['Tämä on Cabernet!']. },
	tapaus: ['syrah']    tee: { Tuloste kirjoita: ['Tämä on Syrah!'].    },
	tapaus: ['merlot']   tee: { Tuloste kirjoita: ['Tämä on Merlot!'].   },
	tapaus: ['malbec']   tee: { Tuloste kirjoita: ['Tämä on Malbec!'].   }.

Tuloste rivinvaihto.
