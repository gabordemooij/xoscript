>> x := [' hallo '].

>> y := x isot-kirjaimet.
Tuloste kirjoita: x, rivinvaihto.
Tuloste kirjoita: (x sama-kuin: y), rivinvaihto.

>> y := x pienet-kirjaimet.
Tuloste kirjoita: x, rivinvaihto.
Tuloste kirjoita: (x sama-kuin: y), rivinvaihto.

>> y := x siisti.
Tuloste kirjoita: x, rivinvaihto.
Tuloste kirjoita: (x sama-kuin: y), rivinvaihto.

>> y := x siirtymä: 1.
Tuloste kirjoita: x, rivinvaihto.
Tuloste kirjoita: (x sama-kuin: y), rivinvaihto.

>> y := x alkaen: 1 pituus: 2.
Tuloste kirjoita: x, rivinvaihto.
Tuloste kirjoita: (x sama-kuin: y), rivinvaihto.