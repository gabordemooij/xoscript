Tuloste kirjoita: ['1,2,3,4,5,6,7,8,9,A,'], rivinvaihto.
>> Scope := Olio uusi.
Scope kun: ['initialize:'] tee: { :x oma property := x. }.
Scope kun: ['confirm'] tee: { Tuloste kirjoita: [',']. }.
Scope kun: ['testi'] tee: {
	Tuloste kirjoita: oma property.
	itse confirm.
	( 1 = 1 ) tosi: { Tuloste kirjoita: oma property. itse confirm. }.
	( 1 = 0 ) epätosi: { Tuloste kirjoita: oma property. itse confirm. }.
	>> y := 2. { Tuloste kirjoita: oma property. itse confirm. } kun: { y vähennä: 1. <- (y > 0). }.
	{ Tuloste kirjoita: oma property. itse confirm. } × 1.
	(Lista ← 1) jokainen: {  Tuloste kirjoita: oma property. itse confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Sanakirja uusi one: ['item']) jokainen: { Tuloste kirjoita: oma property. itse confirm. }.
	{ 1 ÷ 0. } sieppaa: { Tuloste kirjoita: oma property. itse confirm. }, käynnistä.
	Tuloste rivinvaihto.
}.
>> scope1 := Scope uusi.
scope1 initialize: ['X'].
scope1 testi.
