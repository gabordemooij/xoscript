Tuloste kirjoita: ['1,2,3,4,5,6,7,8,9,A,'], rivinvaihto.
>> Näkyvyysalue := Olio uusi.
Näkyvyysalue kun: ['initialize:'] tee: { :x oma ominaisuus := x. }.
Näkyvyysalue kun: ['varmista'] tee: { Tuloste kirjoita: [',']. }.
Näkyvyysalue kun: ['testi'] tee: {
	Tuloste kirjoita: oma ominaisuus.
	itse varmista.
	( 1 = 1 ) tosi: { Tuloste kirjoita: oma ominaisuus. itse varmista. }.
	( 1 = 0 ) epätosi: { Tuloste kirjoita: oma ominaisuus. itse varmista. }.
	>> y := 2. { Tuloste kirjoita: oma ominaisuus. itse varmista. } kun: { y vähennä: 1. <- (y > 0). }.
	{ Tuloste kirjoita: oma ominaisuus. itse varmista. } × 1.
	(Lista ← 1) jokainen: {  Tuloste kirjoita: oma ominaisuus. itse varmista. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo toteuta oma järjestys, tämä testi epäonnistuu, koska iteraatioiden määrä vaihtelee alustoittain
	(Sanakirja uusi one: ['item']) jokainen: { Tuloste kirjoita: oma ominaisuus. itse varmista. }.
	{ 1 ÷ 0. } sieppaa: { Tuloste kirjoita: oma ominaisuus. itse varmista. }, käynnistä.
	Tuloste rivinvaihto.
}.
>> alue1 := Näkyvyysalue uusi.
alue1 initialize: ['X'].
alue1 testi.
>> toiminto := { 
	oma ominaisuus := ['Y'].
	Tuloste kirjoita: oma ominaisuus.
	itse varmista.
	( 1 = 1 ) tosi: { Tuloste kirjoita: oma ominaisuus. itse varmista. }.
	( 1 = 0 ) epätosi: { Tuloste kirjoita: oma ominaisuus. itse varmista. }.
	>> y := 2. { Tuloste kirjoita: oma ominaisuus. itse varmista. } kun: { y vähennä: 1. <- (y > 0). }.
	{ Tuloste kirjoita: oma ominaisuus. itse varmista. } × 1.
	(Lista ← 1) jokainen: {  Tuloste kirjoita: oma ominaisuus. itse varmista. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Sanakirja uusi one: ['item']) jokainen: { Tuloste kirjoita: oma ominaisuus. itse varmista. }.
	{ 1 ÷ 0. } sieppaa: { Tuloste kirjoita: oma ominaisuus. itse varmista. }, käynnistä.
	Tuloste rivinvaihto.
}.
toiminto kun: ['varmista'] tee: { Tuloste kirjoita: [',']. }.
toiminto sovella: 1 ja: 2.
