# testaa luku -> teksti -> luku
{

	>> x := Luku väliltä: 0 ja: 1000000.
	>> d := Luku väliltä: 1 ja: 7.
	>> e := 10 potenssiin: d.

	x jaa-luvulla: e.
	>> y := x teksti luku.

	(x = y) epätosi: {
		Tuloste kirjoita: x, rivinvaihto.
		Tuloste kirjoita: y, rivinvaihto.
		Ohjelma lopeta.
	}.

} * 1000.
Tuloste kirjoita: ['OK'], rivinvaihto.