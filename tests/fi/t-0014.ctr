>> Greeter := Olio uusi.
Greeter kun: ['make'] tee: {
	>> gr := Olio uusi.
	gr kun: ['setName:'] tee: { :aname
		oma nimi := aname.
	}.
	gr kun: ['greet'] tee: {
		Tuloste kirjoita: oma nimi.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a uusi.
c setName: ['THREE'].
c greet.
>> d := a uusi.
d setName: ['FOUR'].
d greet.
c greet.
