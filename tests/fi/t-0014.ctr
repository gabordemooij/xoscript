>> Tervehtijä := Olio uusi.
Tervehtijä kun: ['tee-uusi'] tee: {
	>> ter := Olio uusi.
	ter kun: ['setName:'] tee: { :annettuNimi
		oma nimi := annettuNimi.
	}.
	ter kun: ['tervehdi'] tee: {
		Tuloste kirjoita: oma nimi.
	}. <- ter.
}.
>> a := Tervehtijä tee-uusi.
>> b := Tervehtijä tee-uusi.
a setName: ['YKSI'].
b setName: ['KAKSI'].
a tervehdi.
b tervehdi.
>> c := a uusi.
c setName: ['KOLME'].
c tervehdi.
>> d := a uusi.
d setName: ['NELJÄ'].
d tervehdi.
c tervehdi.
