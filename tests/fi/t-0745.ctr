Tuloste kirjoita: ['Testiolio'], rivinvaihto.
>> a := Olio uusi. 

a kun: ['item:'] tee: { :sanak
	oma sanak := sanak. 
}.

a kun: ['esine'] tee: {
	<- oma sanak.
}.

a item: (
Sanakirja uusi
	hello: ['world']).

>> vanha-sanak-osoite := a esine prototyyppi muistiosoite.
a save-as: ['/tmp/a.bin'].
Tuloste kirjoita: ['========== LADATAAN SNAP UUDELLEEN:'], rivinvaihto.

>> b := Olio load-from: ['/tmp/a.bin'].

(b esine prototyyppi muistiosoite = vanha-sanak-osoite) tosi: {
	Tuloste kirjoita: ['Olion linkki liitetty uudelleen.'], rivinvaihto.
}.

Tuloste kirjoita: b esine, rivinvaihto.
