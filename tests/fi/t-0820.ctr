# ryhmä, joka ei ole osa osumaa, ei saa kaataa ohjelmaa, ja ryhmänumeroiden täytyy säilyä
Server init.
>> näytä := { :kuvio :subject
	>> p := Malli uusi: kuvio.
	p täsmää: subject tee: { :m :g
		Tuloste kirjoita: g lukumäärä, kirjoita: [' '], kirjoita: (g yhdistä: ['|']), rivinvaihto.
		<- m.
	}.
}.
näytä sovella: ['(a)|(b)'] ja: ['b'].
näytä sovella: ['(a)|(b)'] ja: ['a'].
näytä sovella: ['(x)?y'] ja: ['y'].
näytä sovella: ['(x)?(y)(z)?'] ja: ['xy'].
