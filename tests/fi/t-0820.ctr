# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Malli uusi: pattern.
	p täsmää: subject tee: { :m :g
		Tuloste kirjoita: g lukumäärä, kirjoita: [' '], kirjoita: (g yhdistä: ['|']), rivinvaihto. <- m.
	}.
}.
show sovella: ['(a)|(b)'] ja: ['b'].
show sovella: ['(a)|(b)'] ja: ['a'].
show sovella: ['(x)?y'] ja: ['y'].
show sovella: ['(x)?(y)(z)?'] ja: ['xy'].
