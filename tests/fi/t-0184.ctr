

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Ohjelma muistinhallinta: 0.

Luku kun: ['addNum:'] tee: { :x
	itse lisää: x.
}.

Luku kun: ['subtractNum:'] tee: { :x
	itse vähennä: x.
}.

Luku kun: ['multiplyBy:'] tee: { :x
	itse kerro: x.
}.

Luku kun: ['divideBy:'] tee: { :x
	itse jaa-luvulla: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 potenssiin: 8).  
a := a + (2 potenssiin: -1). 
a := a + (49 neliöjuuri).   
a addNum: ((Lista ← 0 ; 1) maksimi).          
a addNum: ((Lista ← 2 ; 3) minimi).
Tuloste kirjoita: a.

Ohjelma siivoa.

usedMemory1 := (Ohjelma muisti ? 0).


