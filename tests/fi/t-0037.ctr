>> a := 3.
>> b := a kopioi.
a vähennä: 1.
Tuloste kirjoita: [' a = '] + a.
Tuloste kirjoita: [' b = '] + b.
a := 3.
b := a + 4.
Tuloste kirjoita: [' a = '] + a.
Tuloste kirjoita: [' b = '] + b.
>> x := 3.
>> y := x kopioi.
x lisää: 10.
y vähennä: 1.
Tuloste kirjoita: [' x = '] + x.
Tuloste kirjoita: [' y = '] + y.
>> q := Olio uusi.
q kun: ['setProperty:'] tee: { :x
	oma prop := x.
}.
q kun: ['getProperty'] tee: { <- oma prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Tuloste kirjoita: [' p = '] + (p getProperty).
