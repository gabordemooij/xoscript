>> makeAdder := { :x
	>> f := { :y <- (oma x + y). } aseta: ['x'] arvo: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i oma q aseta: (oma f sovella: (oma q ? i)) kohtaan: i. } 
	aseta: ['q'] arvo: array,
	aseta: ['f'] arvo: func.
	{ :i mapping sovella: i. } × (array lukumäärä).
}.

>> a := Lista ← 1; 2; 3.
mapper sovella: a ja: (makeAdder sovella: 100).
Tuloste kirjoita: (a sijainti: 0), rivinvaihto.
Tuloste kirjoita: (a ? 1), rivinvaihto.
Tuloste kirjoita: (a ? 2), rivinvaihto.
