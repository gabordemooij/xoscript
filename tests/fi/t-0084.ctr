>> teeSummaaja := { :x
	>> f := { :y <- (oma x + y). } aseta: ['x'] arvo: x. <- f.
}.
>> kuvaaja := { :taulukko :funk
	>> kuvausfunktio := { :i oma q aseta: (oma f sovella: (oma q ? i)) kohtaan: i. } 
	aseta: ['q'] arvo: taulukko,
	aseta: ['f'] arvo: funk.
	{ :i kuvausfunktio sovella: i. } × (taulukko lukumäärä).
}.

>> a := Lista ← 1; 2; 3.
kuvaaja sovella: a ja: (teeSummaaja sovella: 100).
Tuloste kirjoita: (a sijainti: 0), rivinvaihto.
Tuloste kirjoita: (a ? 1), rivinvaihto.
Tuloste kirjoita: (a ? 2), rivinvaihto.
