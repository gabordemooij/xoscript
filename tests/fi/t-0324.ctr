>> Eläin := Olio uusi.
>> Tehdas := Olio uusi.

Eläin kun: ['uusi'] tee: {
	>> eläin := itse uusi.
	eläin sound: ['?']. <- eläin.
}.

Eläin kun: ['sound:'] tee: { :s
	oma ääni := s.
}.

Eläin kun: ['ääni'] tee: { <- oma ääni.
}.

>> Koira := Olio uusi.
>> Kissa := Olio uusi.

Koira kun: ['uusi'] tee: { <- Eläin uusi sound: ['woof!'].
}.

Kissa kun: ['uusi'] tee: { <- Eläin uusi sound: ['meow!'].
}.

Tuloste kirjoita: Koira uusi ääni, rivinvaihto.
Tuloste kirjoita: Kissa uusi ääni, rivinvaihto.

Tehdas kun: ['sekoita:sekä:'] tee: { :peto1 :peto2 <- Eläin uusi sound: (
		( peto1 ääni alkaen: 0 pituus: 2 ) +
		( peto2 ääni alkaen: 2 pituus: 5 )
	).
}.

Tuloste kirjoita: (Tehdas sekoita: Koira uusi sekä: Kissa uusi) ääni, rivinvaihto.
