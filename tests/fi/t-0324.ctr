>> Animal := Olio uusi.
>> Factory := Olio uusi.

Animal kun: ['uusi'] tee: {
	>> animal := itse uusi.
	animal sound: ['?']. <- animal.
}.

Animal kun: ['sound:'] tee: { :s
	oma sound := s.
}.

Animal kun: ['sound'] tee: { <- oma sound.
}.

>> Dog := Olio uusi.
>> Cat := Olio uusi.

Dog kun: ['uusi'] tee: { <- Animal uusi sound: ['woof!'].
}.

Cat kun: ['uusi'] tee: { <- Animal uusi sound: ['meow!'].
}.

Tuloste kirjoita: Dog uusi sound, rivinvaihto.
Tuloste kirjoita: Cat uusi sound, rivinvaihto.

Factory kun: ['mix:and:'] tee: { :beast1 :beast2 <- Animal uusi sound: (
		( beast1 sound alkaen: 0 pituus: 2 ) +
		( beast2 sound alkaen: 2 pituus: 5 )
	).
}.

Tuloste kirjoita: (Factory mix: Dog uusi and: Cat uusi) sound, rivinvaihto.
