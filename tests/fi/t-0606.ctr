>> Point := Olio uusi.
Point kun: ['x-coordinate:'] tee: { :x oma x := x. }.
Point kun: ['y-coordinate:'] tee: { :y oma y := y. }.
Point kun: ['x-coordinate']  tee: { <- oma x kopioi. }.
Point kun: ['y-coordinate']  tee: { <- oma y kopioi. }.

Point kun: ['='] tee: { :other <- ( oma x = other x-coordinate
		 ja: oma y = other y-coordinate ).
}.

>> pier := Point uusi x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point uusi x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point uusi x-coordinate: 5, y-coordinate: 6.

Tuloste kirjoita: pier = town-hall, rivinvaihto.
Tuloste kirjoita: pier = restaurant, rivinvaihto.
