>> Piste := Olio uusi.
Piste kun: ['x-coordinate:'] tee: { :x oma x := x. }.
Piste kun: ['y-coordinate:'] tee: { :y oma y := y. }.
Piste kun: ['x-koordinaatti']  tee: { <- oma x kopioi. }.
Piste kun: ['y-koordinaatti']  tee: { <- oma y kopioi. }.

Piste kun: ['='] tee: { :toinen
	<- ( oma x = toinen x-koordinaatti
		 ja: oma y = toinen y-koordinaatti ).
}.

>> laituri := Piste uusi x-coordinate: 5, y-coordinate: 6.
>> kaupungintalo := Piste uusi x-coordinate: 7, y-coordinate: 1.
>> ravintola := Piste uusi x-coordinate: 5, y-coordinate: 6.

Tuloste kirjoita: laituri = kaupungintalo, rivinvaihto.
Tuloste kirjoita: laituri = ravintola, rivinvaihto.
