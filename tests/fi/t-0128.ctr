
Lista kun: ['sum'] tee: {
	>> total := 0.
	itse jokainen: { :index :element
		total lisää: element.
	}. <- total.
}.

>> a := Lista ← 9 ; 8 ; 7.
Tuloste kirjoita: (a sum), rivinvaihto. 
>> a := Lista ← 1 ; 9.
Tuloste kirjoita: (a sum), rivinvaihto. 
>> a := Lista ← ['o'] ; 2.
Tuloste kirjoita: (a sum), rivinvaihto. 
Tuloste kirjoita: (Lista uusi sum), rivinvaihto. 
