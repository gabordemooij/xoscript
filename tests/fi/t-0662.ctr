>> t := Tyhjä.

# you can control the time zone for
# parsing like this:
Hetki aikavyöhyke: ['CET'].
t := Hetki lähteestä: ['1981-02-03 04:05:06'].
Tuloste kirjoita: t, rivinvaihto.

# now using CEST time zone:
Hetki aikavyöhyke: ['CEST'].
t := Hetki lähteestä: ['1981-02-03 04:05:06'].
Tuloste kirjoita: t, rivinvaihto.

# error if string cannot be parsed
{ Hetki lähteestä: ['1900']. } sieppaa: { Tyhjä. }, käynnistä.
