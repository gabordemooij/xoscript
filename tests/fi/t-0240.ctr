# test qualifiers

>> $ := Olio uusi.

$ kun: ['vastaa:'] tee: { :x
	
	>> operation := x merkki: 0.
	>> valuta := x merkki: 1.
	>> money := x siirtymä: 2.
	
	>> amount := 0.

	( operation = ['+'] ) tosi: {
		( valuta = ['£'] ) tosi: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Tuloste kirjoita: x, rivinvaihto.


>> Fruit := Olio uusi.

Fruit kun: ['uusi'] tee: {
	>> f := itse uusi.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit kun: ['apples:'] tee: { :a oma apples := a. }.
Fruit kun: ['oranges:'] tee: { :p oma oranges := p. }.
Fruit kun: ['apples'] tee: { <- oma apples. }.
Fruit kun: ['oranges'] tee: { <- oma oranges. }.

Fruit kun: ['+'] tee: { :f
	
	>> n := Fruit uusi.
	f lisää: 1.
	
	n apples: (f apples + oma apples).
	n oranges:  (f oranges  + oma oranges). <- n.
}.

Fruit kun: ['teksti'] tee: { <- ( oma apples teksti + [' apples and '] + oma oranges + [' oranges'] ).
}.

Luku kun: ['apples'] tee: { <- ((Fruit uusi) apples: itse).
}.

Luku kun: ['apple'] tee: { <- ((Fruit uusi) apples: itse).
}.

Luku kun: ['oranges'] tee: { <- ((Fruit uusi) oranges: itse).
}.




Tuloste kirjoita: (1 apple + 3 oranges + 4 apples), rivinvaihto.


Teksti kun: ['twice'] tee: { <- ((itse teksti) + (itse teksti)).
}.



Tuloste kirjoita: ['❤❤❤'] twice.



