# testaa määritteet

>> $ := Olio uusi.

$ kun: ['vastaa:'] tee: { :x
	
	>> operaatio := x merkki: 0.
	>> valuutta := x merkki: 1.
	>> raha := x siirtymä: 2.
	
	>> määrä := 0.

	( operaatio = ['+'] ) tosi: {
		( valuutta = ['£'] ) tosi: { määrä := 1.28 × raha. }.
	}. <- määrä.
}.



>> x := $ +£20.

Tuloste kirjoita: x, rivinvaihto.


>> Hedelmä := Olio uusi.

Hedelmä kun: ['uusi'] tee: {
	>> f := itse uusi.
	f apples: 0.
	f oranges: 0. <- f.
}.

Hedelmä kun: ['apples:'] tee: { :a oma omenat := a. }.
Hedelmä kun: ['oranges:'] tee: { :p oma appelsiinit := p. }.
Hedelmä kun: ['omenat'] tee: { <- oma omenat. }.
Hedelmä kun: ['appelsiinit'] tee: { <- oma appelsiinit. }.

Hedelmä kun: ['+'] tee: { :f
	
	>> n := Hedelmä uusi.
	f lisää: 1.
	
	n apples: (f omenat + oma omenat).
	n oranges:  (f appelsiinit  + oma appelsiinit). <- n.
}.

Hedelmä kun: ['teksti'] tee: { <- ( oma omenat teksti + [' omenaa ja '] + oma appelsiinit + [' appelsiinia'] ).
}.

Luku kun: ['omenat'] tee: { <- ((Hedelmä uusi) apples: itse).
}.

Luku kun: ['apple'] tee: { <- ((Hedelmä uusi) apples: itse).
}.

Luku kun: ['appelsiinit'] tee: { <- ((Hedelmä uusi) oranges: itse).
}.




Tuloste kirjoita: (1 apple + 3 appelsiinit + 4 omenat), rivinvaihto.


Teksti kun: ['kahdesti'] tee: { <- ((itse teksti) + (itse teksti)).
}.



Tuloste kirjoita: ['❤❤❤'] kahdesti.



