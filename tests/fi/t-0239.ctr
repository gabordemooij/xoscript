Lista kun: ['summa'] tee: {
	>> yhteensä := 0.
	itse jokainen: { :indeksi :alkio
		yhteensä lisää: alkio.
	}. <- yhteensä.
}.

>> a := Tosi.



a kun: ['teksti'] tee: {
	>> ratkaisu := Tyhjä.
	( itse = Tosi ) tosi: {
		ratkaisu := ['Jep'].
	}, muuten: {
		ratkaisu := ['Eipä'].
	}. <- ratkaisu.
}.

a kun: ['luku'] tee: {
	>> ratkaisu := Tyhjä.
	( itse = Tosi ) tosi: {
		ratkaisu := 10.
	}, muuten: {
		ratkaisu := 20.
	}. <- ratkaisu.
}.

>> b := 666.

b kun: ['teksti'] tee: { <- ['Paholainen'].
}.

b kun: ['totuusarvo'] tee: { <- Epätosi.
}.


Tuloste kirjoita: a, rivinvaihto.  
Tuloste kirjoita: (90 + a), rivinvaihto. 
Tuloste kirjoita: b, rivinvaihto. 
Tuloste kirjoita: (Tosi ja: b), rivinvaihto.

a := Lista ← ['hello'] ; ['world'] ; Tosi ; Tyhjä ; 666. 
a := a + ( Lista ← 1 ).
Tuloste kirjoita: a, rivinvaihto.
Tuloste kirjoita: ((Sanakirja uusi) aseta: Tyhjä kohtaan: Tyhjä), rivinvaihto.
Tuloste kirjoita: a summa, rivinvaihto. 


{
	a kun: ['teksti'] tee: { <- Tyhjä. }.
	a := [''] + a.
} sieppaa: { :poikkeus
	Tuloste kirjoita: ['Virhe kirjattu: '] + poikkeus, rivinvaihto.
}, käynnistä.



{
	a kun: ['luku'] tee: { <- Tyhjä. }.
	a := 3 × a.
} sieppaa: { :poikkeus
	Tuloste kirjoita: ['Virhe kirjattu: '] + poikkeus, rivinvaihto.
}, käynnistä.


{
	a kun: ['totuusarvo'] tee: { <- Tyhjä. }.
	a := Tosi ja: a. 
} sieppaa: { :poikkeus
	Tuloste kirjoita: ['Virhe kirjattu: '] + poikkeus, rivinvaihto.
}, käynnistä.





