Lista kun: ['sum'] tee: {
	>> total := 0.
	itse jokainen: { :index :element
		total lisää: element.
	}. <- total.
}.

>> a := Tosi.



a kun: ['teksti'] tee: {
	>> answer := Tyhjä.
	( itse = Tosi ) tosi: {
		answer := ['Yep'].
	}, muuten: {
		answer := ['Nope'].
	}. <- answer.
}.

a kun: ['luku'] tee: {
	>> answer := Tyhjä.
	( itse = Tosi ) tosi: {
		answer := 10.
	}, muuten: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b kun: ['teksti'] tee: { <- ['Devil'].
}.

b kun: ['totuusarvo'] tee: { <- Epätosi.
}.


Tuloste kirjoita: a, rivinvaihto.  
Tuloste kirjoita: (90 + a), rivinvaihto. 
Tuloste kirjoita: b, rivinvaihto. 
Tuloste kirjoita: (Tosi ja: b), rivinvaihto.

a := Lista ← ['hello'] ; ['world'] ; Tosi ; Tyhjä ; 666. 
a := a + ( Lista ← 1 ).
Tuloste kirjoita: a, rivinvaihto.
Tuloste kirjoita: ((Sanakirja uusi) aseta: Tyhjä kohtaan: Tyhjä), rivinvaihto.
Tuloste kirjoita: a sum, rivinvaihto. 


{
	a kun: ['teksti'] tee: { <- Tyhjä. }.
	a := [''] + a.
} sieppaa: { :error
	Tuloste kirjoita: ['Error noted: '] + error, rivinvaihto.
}, käynnistä.



{
	a kun: ['luku'] tee: { <- Tyhjä. }.
	a := 3 × a.
} sieppaa: { :error
	Tuloste kirjoita: ['Error noted: '] + error, rivinvaihto.
}, käynnistä.


