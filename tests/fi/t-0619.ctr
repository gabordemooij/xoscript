>> HTML := Olio uusi.
HTML kun: ['vastaa:'] tee: { :tagi 
	Tuloste kirjoita: (['<tag>'] tag: tagi), rivinvaihto.
}.
HTML kun: ['vastaa:ja:'] tee: { :tagi :html 
	Tuloste kirjoita: (
		['<tag>innerHTML</tag>']
		tag: tagi - [':'],
		innerHTML: html
	), rivinvaihto.
}.
>> html := HTML uusi.
html body h1: ['header'].

