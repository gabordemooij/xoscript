>> HTML := Olio uusi.
HTML kun: ['vastaa:'] tee: { :tag 
	Tuloste kirjoita: (['<tag>'] tag: tag), rivinvaihto.
}.
HTML kun: ['vastaa:ja:'] tee: { :tag :html 
	Tuloste kirjoita: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), rivinvaihto.
}.
>> html := HTML uusi.
html body h1: ['header'].

