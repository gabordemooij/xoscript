

>> käytettyMuisti1 := 0.
>> käytettyMuisti2 := 0.
>> käytettyMuisti3 := 0.
>> käytettyMuisti4 := 0.

Ohjelma muistinhallinta: 0.

>> txt := ['Word Salad'].
Tuloste kirjoita: ['Tekstin pituus: '] + txt pituus, rivinvaihto.
Tuloste kirjoita: ['Merkki kohdassa 2:'] + ( txt merkki: 2 ), rivinvaihto.
Tuloste kirjoita: (( txt etsi: ['S'] ) - 0), rivinvaihto.

Ohjelma siivoa.

käytettyMuisti1 := (Ohjelma muisti ? 0).


txt := ['Word Salad'].
Tuloste kirjoita: ['Tekstin pituus: '] + txt pituus, rivinvaihto.
Tuloste kirjoita: ['Merkki kohdassa 2:'] + ( txt merkki: 2 ), rivinvaihto.
Tuloste kirjoita: (( txt etsi: ['S'] ) - 0), rivinvaihto.

Ohjelma siivoa.
käytettyMuisti2 := (Ohjelma muisti ? 0).


txt := ['Word Salad'].
Tuloste kirjoita: ['Tekstin pituus: '] + txt pituus, rivinvaihto.
Tuloste kirjoita: ['Merkki kohdassa 2:'] + ( txt merkki: 2 ), rivinvaihto.
Tuloste kirjoita: (( txt etsi: ['S'] ) - 0), rivinvaihto.

Ohjelma siivoa.
käytettyMuisti3 := (Ohjelma muisti ? 0).



( käytettyMuisti1 = käytettyMuisti2 ja: käytettyMuisti1 = käytettyMuisti3, ja: käytettyMuisti2 = käytettyMuisti3 ) tosi: {
	Tuloste kirjoita: ['Ei muistivuotoja täällä'].
}, epätosi: {
	Tuloste kirjoita: ['Muisti vuotaa...'].
}.
