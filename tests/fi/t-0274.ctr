

Lista kun: ['column:'] tee: { :sarake
	>> tulos := Lista uusi.
	itse jokainen: { :indeksi :vaakarivi
		vaakarivi jokainen: { :indeksi :solu
			(indeksi = sarake) tosi: { tulos lisää-loppuun: solu. }.
		}.
	}. <- tulos.
}.


>> a := Lista ←
	(Lista ← 1 ; 2 ; 3) ;
	(Lista ← 4 ; 5 ; 6) ;
	(Lista ← 7 ; 8 ; 9).

>> b := a column: 1.
Tuloste kirjoita: b, rivinvaihto.

b := a column: 20.
Tuloste kirjoita: b, rivinvaihto.

b := a column: -100.
Tuloste kirjoita: b, rivinvaihto.
