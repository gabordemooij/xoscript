

Lista kun: ['column:'] tee: { :column
	>> result := Lista uusi.
	itse jokainen: { :index :row
		row jokainen: { :index :cell
			(index = column) tosi: { result lisää-loppuun: cell. }.
		}.
	}. <- result.
}.


>> a := Lista ←
	(Lista ← 1 ; 2 ; 3) ;
	(Lista ← 4 ; 5 ; 6) ;
	(Lista ← 7 ; 8 ; 9).

>> b := a column: 1.
Tuloste kirjoita: b, rivinvaihto.

b := a column: 20.
Tuloste kirjoita: b, rivinvaihto.

b := a column: -100.
Tuloste kirjoita: b, rivinvaihto.
