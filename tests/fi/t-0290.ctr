# test list operations


>> cakes := Lista ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes korvaa: 1 pituus: 2 arvolla: ( Lista ← ['cinnamon'] ; ['pineapple'] ).
Tuloste kirjoita: (buy yhdistä: [',']), rivinvaihto.


>> buy := cakes korvaa: 1 pituus: 12 arvolla: ( Lista ← ['cinnamon'] ; ['pineapple'] ).
Tuloste kirjoita: (buy yhdistä: [',']), rivinvaihto.


>> buy := cakes korvaa: 2 pituus: 10 arvolla: ( Lista uusi ).
Tuloste kirjoita: (buy yhdistä: [',']), rivinvaihto.


>> buy := cakes korvaa: 0 pituus: 1 arvolla: ( Lista uusi ).
Tuloste kirjoita: (buy yhdistä: [',']), rivinvaihto.


>> buy := cakes korvaa: ['0'] pituus: ['1'] arvolla: ['x'].
Tuloste kirjoita: (buy yhdistä: [',']), rivinvaihto.
