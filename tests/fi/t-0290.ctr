# testaa listaoperaatiot


>> kakut := Lista ←
	['apple'] ;
	['marja'] ;
	['suklaa'] ;
	['juusto'].


>> osta := kakut korvaa: 1 pituus: 2 arvolla: ( Lista ← ['kaneli'] ; ['ananas'] ).
Tuloste kirjoita: (osta yhdistä: [',']), rivinvaihto.


>> osta := kakut korvaa: 1 pituus: 12 arvolla: ( Lista ← ['kaneli'] ; ['ananas'] ).
Tuloste kirjoita: (osta yhdistä: [',']), rivinvaihto.


>> osta := kakut korvaa: 2 pituus: 10 arvolla: ( Lista uusi ).
Tuloste kirjoita: (osta yhdistä: [',']), rivinvaihto.


>> osta := kakut korvaa: 0 pituus: 1 arvolla: ( Lista uusi ).
Tuloste kirjoita: (osta yhdistä: [',']), rivinvaihto.


>> osta := kakut korvaa: ['0'] pituus: ['1'] arvolla: ['x'].
Tuloste kirjoita: (osta yhdistä: [',']), rivinvaihto.
