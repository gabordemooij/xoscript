Tuloste kirjoita: ['Test object'], rivinvaihto.
>> cmd := Komento uusi.
Tuloste kirjoita: cmd ls /tmp, rivinvaihto.
>> old-cmd-address := cmd prototyyppi muistiosoite.
cmd save-as: ['/tmp/a.bin'].
Tuloste kirjoita: ['========== RELOADING SNAP:'], rivinvaihto.
>> b := Olio load-from: ['/tmp/a.bin'].
(b prototyyppi muistiosoite = old-cmd-address) tosi: {
	Tuloste kirjoita: ['Object link re-attached.'], rivinvaihto.
}.
Tuloste kirjoita: b ls, rivinvaihto.


