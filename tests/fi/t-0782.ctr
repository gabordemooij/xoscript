Tuloste kirjoita: ['Testiolio'], rivinvaihto.
>> kmt := Komento uusi.
Tuloste kirjoita: kmt ls /tmp, rivinvaihto.
>> vanha-kmt-osoite := kmt prototyyppi muistiosoite.
kmt save-as: ['/tmp/a.bin'].
Tuloste kirjoita: ['========== LADATAAN SNAP UUDELLEEN:'], rivinvaihto.
>> b := Olio load-from: ['/tmp/a.bin'].
(b prototyyppi muistiosoite = vanha-kmt-osoite) tosi: {
	Tuloste kirjoita: ['Olion linkki liitetty uudelleen.'], rivinvaihto.
}.
Tuloste kirjoita: b ls, rivinvaihto.


