#Linux
>> OS := Ohjelma järjestelmä: (Komento uname -s), siisti.

>> Slurp := Olio uusi.
Slurp kun: ['uusi'] tee: {
	oma str := [''].
}.
Slurp kun: ['vastaa:'] tee: { :blah
		(oma str ≠ ['']) tosi: {
			oma str lisää-loppuun: [' '].
		}.
		oma str lisää-loppuun: blah.
}.
Slurp kun: ['vastaa:ja:'] tee: { :blah :blahah
		(oma str ≠ ['']) tosi: {
			oma str lisää-loppuun: [' '].
		}.
		(blah pituus > 1) tosi: {
			oma str lisää-loppuun: (blah alkaen: 0 pituus: (blah pituus - 1)).
		}, muuten: {
			oma str lisää-loppuun: blah.
		}.
		oma str lisää-loppuun: [' '].
		oma str lisää-loppuun: blahah.
}.
Slurp kun: ['obtain'] tee: {
	>> buffer := oma str.
	oma str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text lisää-loppuun: ['hello'].
} × 1000.


Tuloste kirjoita: (
	Ohjelma järjestelmä: (
		Slurp uusi
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

