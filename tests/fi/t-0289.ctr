#Linux
>> KJ := Ohjelma järjestelmä: (Komento uname -s), siisti.

>> Hörppy := Olio uusi.
Hörppy kun: ['uusi'] tee: {
	oma str := [''].
}.
Hörppy kun: ['vastaa:'] tee: { :blah
		(oma str ≠ ['']) tosi: {
			oma str lisää-loppuun: [' '].
		}.
		oma str lisää-loppuun: blah.
}.
Hörppy kun: ['vastaa:ja:'] tee: { :blah :blahah
		(oma str ≠ ['']) tosi: {
			oma str lisää-loppuun: [' '].
		}.
		(blah pituus > 1) tosi: {
			oma str lisää-loppuun: (blah alkaen: 0 pituus: (blah pituus - 1)).
		}, muuten: {
			oma str lisää-loppuun: blah.
		}.
		oma str lisää-loppuun: [' '].
		oma str lisää-loppuun: blahah.
}.
Hörppy kun: ['hanki'] tee: {
	>> puskuri := oma str.
	oma str := ['']. <- puskuri.
}.
>> large text := [''].
{
	large text lisää-loppuun: ['hello'].
} × 1000.


Tuloste kirjoita: (
	Ohjelma järjestelmä: (
		Hörppy uusi
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: KJ)
		) hanki
).

