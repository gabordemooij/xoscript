Tuloste kirjoita: ['Testiolio'], rivinvaihto.
>> a := Olio uusi. 

a kun: ['state:'] tee: { :list
	oma list := list. 
}.

a kun: ['olotila'] tee: {
	Tuloste kirjoita: oma list, rivinvaihto.
}.

a state: ( Lista uusi ; ['listaesine'] ; ['esine2'] ).
a olotila.

a save-as: ['/tmp/a.bin'].
Tuloste kirjoita: ['========== LADATAAN SNAP UUDELLEEN:'], rivinvaihto.
>> b := Olio load-from: ['/tmp/a.bin'].
b olotila.