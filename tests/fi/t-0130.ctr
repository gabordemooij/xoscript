# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Ohjelma asetus: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server linkitä: ( Lista uusi ;
 libname ; ['fopen'] ;
 ( Lista uusi ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
linkitä: ( Lista uusi ;
 Tyhjä ; # means same lib
 ['fread'] ;
 ( Lista uusi ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Tyhjä ; # means same object (i.e. Stream)
 ['fread']
),
linkitä: (
 Lista uusi ;
 Tyhjä ; # means same lib
 ['fwrite'] ;
 ( Lista uusi ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Tyhjä ; # means same lib
 ['fwrite']
),
linkitä: (
 Lista uusi ;
 Tyhjä ; # means same lib
 ['rewind'] ;
 ( Lista uusi ; ['pointer'] ) ;
 ['int'] ;
 Tyhjä ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> polku := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: polku mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream viesti: ['fwrite'] argumentit: (Lista uusi ; str ; 1 ; 6 ; fd ).
Tuloste kirjoita: bytes-written, rivinvaihto.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob uusi: 20.

# read from file
>> bytes-read := Stream viesti: ['fread'] argumentit: (Lista uusi ; buf ; 1 ; 6 ; fd ).
Tuloste kirjoita: bytes-read, rivinvaihto.
Tuloste kirjoita: buf, rivinvaihto.

# free memory
str  vapauta.
polku vapauta.
mode vapauta.
buf  vapauta.


