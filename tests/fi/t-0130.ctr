# FFI:n käyttö Server-liitännäisen kanssa

# yhdistä libc:hen (alustakohtainen)
>> kirjastonimi := Ohjelma asetus: ['FFITESTLIB'].

# linkitä C:n stdio-funktiot edistyneitä tiedosto-operaatioita varten
Server linkitä: ( Lista uusi ;
 kirjastonimi ; ['fopen'] ;
 ( Lista uusi ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
linkitä: ( Lista uusi ;
 Tyhjä ; # tarkoittaa samaa kirjastoa
 ['fread'] ;
 ( Lista uusi ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Tyhjä ; # tarkoittaa samaa oliota (eli Stream)
 ['fread']
),
linkitä: (
 Lista uusi ;
 Tyhjä ; # tarkoittaa samaa kirjastoa
 ['fwrite'] ;
 ( Lista uusi ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Tyhjä ; # tarkoittaa samaa kirjastoa
 ['fwrite']
),
linkitä: (
 Lista uusi ;
 Tyhjä ; # tarkoittaa samaa kirjastoa
 ['rewind'] ;
 ( Lista uusi ; ['pointer'] ) ;
 ['int'] ;
 Tyhjä ; # tarkoittaa samaa kirjastoa
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> polku := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# avaa tiedosto funktiolla fopen(path, mode)
>> fd := Stream path: polku mode: mode.

# kirjoita tavut puskurista merkkijono tiedostoon
>> tavuja-kirjoitettu := Stream viesti: ['fwrite'] argumentit: (Lista uusi ; str ; 1 ; 6 ; fd ).
Tuloste kirjoita: tavuja-kirjoitettu, rivinvaihto.

# kelaa tiedosto-osoitin alkuun
Stream rewind: fd.

# varaa puskuri
>> pusk := Blob uusi: 20.

# lue tiedostosta
>> tavuja-luettu := Stream viesti: ['fread'] argumentit: (Lista uusi ; pusk ; 1 ; 6 ; fd ).
Tuloste kirjoita: tavuja-luettu, rivinvaihto.
Tuloste kirjoita: pusk, rivinvaihto.

# vapauta muisti
str  vapauta.
polku vapauta.
mode vapauta.
pusk  vapauta.


