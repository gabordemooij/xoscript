
>> city := Lista ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Lista ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature avaimilla: city.
>> cities := weather merkinnät järjestä: { :a :b <- (a vertaa: b). }.
>> temperatures := weather arvot järjestä: { :a :b <- (a vertaa: b) negatiivinen?. }.

Tuloste kirjoita: (cities yhdistä: [',']), rivinvaihto.
Tuloste kirjoita: (temperatures yhdistä: [',']), rivinvaihto.
