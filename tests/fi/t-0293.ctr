
>> kaupunki := Lista ← ['Lontoo'] ; ['Pariisi'] ; ['Berliini'].
>> lämpötila := Lista ← ['15'] ; ['16'] ; ['15'].
>> sää := lämpötila avaimilla: kaupunki.
>> kaupungit := sää merkinnät järjestä: { :a :b <- (a vertaa: b). }.
>> lämpötilat := sää arvot järjestä: { :a :b <- (a vertaa: b) negatiivinen?. }.

Tuloste kirjoita: (kaupungit yhdistä: [',']), rivinvaihto.
Tuloste kirjoita: (lämpötilat yhdistä: [',']), rivinvaihto.
