Luku kun: ['kertoma'] tee: {
	>> yhteensä := 1.
	{ :indeksi yhteensä kerro: (itse - indeksi). } × itse. <- yhteensä.
}.

>> käytettyMuisti1 := 0.
>> käytettyMuisti2 := 0.
>> käytettyMuisti3 := 0.
>> käytettyMuisti4 := 0.

Ohjelma muistinhallinta: 0.

{
2 eksponentti kertoma.
Tuloste kirjoita: (11 modulo: 3), rivinvaihto.
Tuloste kirjoita: (3.4 pyöristä), rivinvaihto.
Tuloste kirjoita: (7.1 pyöristä-ylös), rivinvaihto.
Tuloste kirjoita: (7.9 pyöristä-alas), rivinvaihto.
}
käynnistä.

Ohjelma siivoa.

käytettyMuisti1 := (Ohjelma muisti ? 0).

{
2 eksponentti kertoma.
Tuloste kirjoita: (11 modulo: 3), rivinvaihto.
Tuloste kirjoita: (3.4 pyöristä), rivinvaihto.
Tuloste kirjoita: (7.1 pyöristä-ylös), rivinvaihto.
Tuloste kirjoita: (7.9 pyöristä-alas), rivinvaihto.
}
käynnistä.

Ohjelma siivoa.
käytettyMuisti2 := (Ohjelma muisti ? 0).


{
2 eksponentti kertoma.
Tuloste kirjoita: (11 modulo: 3), rivinvaihto.
Tuloste kirjoita: (3.4 pyöristä), rivinvaihto.
Tuloste kirjoita: (7.1 pyöristä-ylös), rivinvaihto.
Tuloste kirjoita: (7.9 pyöristä-alas), rivinvaihto.
} käynnistä.

Ohjelma siivoa.
käytettyMuisti3 := (Ohjelma muisti ? 0).



( käytettyMuisti1 = käytettyMuisti2 ja: käytettyMuisti1 = käytettyMuisti3, ja: käytettyMuisti2 = käytettyMuisti3 ) tosi: {
	Tuloste kirjoita: ['Ei muistivuotoja täällä'].
}, epätosi: {
	Tuloste kirjoita: ['Muisti vuotaa...'].
}.
