Luku kun: ['factorial'] tee: {
	>> total := 1.
	{ :index total kerro: (itse - index). } × itse. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Ohjelma muistinhallinta: 0.

{
2 exponent factorial.
Tuloste kirjoita: (11 modulo: 3), rivinvaihto.
Tuloste kirjoita: (3.4 pyöristä), rivinvaihto.
Tuloste kirjoita: (7.1 pyöristä-ylös), rivinvaihto.
Tuloste kirjoita: (7.9 pyöristä-alas), rivinvaihto.
}
käynnistä.

Ohjelma siivoa.

usedMemory1 := (Ohjelma muisti ? 0).

