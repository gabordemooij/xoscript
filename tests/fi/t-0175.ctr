

>> käytettyMuisti1 := 0.
>> käytettyMuisti2 := 0.
>> käytettyMuisti3 := 0.
>> käytettyMuisti4 := 0.

>> x := 100.

Ohjelma muistinhallinta: 0.

{
>> txt := ['hei '] + ['world'].
txt := txt + [' - voimmeko käyttää merkkijonoja.. '].
txt := txt + ['vuotamatta '] + x + [':ittain tavuja ?'].
txt lisää-loppuun: ['!!'].
Tuloste kirjoita: txt.
} käynnistä.

Ohjelma siivoa.

käytettyMuisti1 := (Ohjelma muisti ? 0).


{
>> txt := ['hei '] + ['world'].
txt := txt + [' - voimmeko käyttää merkkijonoja.. '].
txt := txt + ['vuotamatta '] + x + [':ittain tavuja ?'].
txt lisää-loppuun: ['!!'].
Tuloste kirjoita: txt.
} käynnistä.

Ohjelma siivoa.
käytettyMuisti2 := (Ohjelma muisti ? 0).


{
>> txt := ['hei '] + ['world'].
txt := txt + [' - voimmeko käyttää merkkijonoja.. '].
txt := txt + ['vuotamatta '] + x + [':ittain tavuja ?'].
txt lisää-loppuun: ['!!'].
Tuloste kirjoita: txt.
} käynnistä.

Ohjelma siivoa.
käytettyMuisti3 := (Ohjelma muisti ? 0).



( käytettyMuisti1 = käytettyMuisti2 ja: käytettyMuisti1 = käytettyMuisti3, ja: käytettyMuisti2 = käytettyMuisti3 ) tosi: {
	Tuloste kirjoita: ['Ei muistivuotoja täällä'].
}, epätosi: {
	Tuloste kirjoita: ['Muisti vuotaa...'].
}.
