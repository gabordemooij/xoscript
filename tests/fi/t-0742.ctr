Tuloste kirjoita: ['Test object'], rivinvaihto.
>> a := Olio uusi. 

a kun: ['item:'] tee: { :hexhelper
	oma hexhelper := hexhelper. 
}.

a kun: ['item'] tee: { <- oma hexhelper.
}.

a item: Hx uusi.

>> old-hexhelper-address := a item prototyyppi muistiosoite.
a save-as: ['/tmp/a.bin'].
Tuloste kirjoita: ['========== RELOADING SNAP:'], rivinvaihto.

>> b := Olio load-from: ['/tmp/a.bin'].

(b item prototyyppi muistiosoite = old-hexhelper-address) tosi: {
	Tuloste kirjoita: ['Object link re-attached.'], rivinvaihto.
}.
