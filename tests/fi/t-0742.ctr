Tuloste kirjoita: ['Testiolio'], rivinvaihto.
>> a := Olio uusi. 

a kun: ['item:'] tee: { :heksapuri
	oma heksapuri := heksapuri. 
}.

a kun: ['esine'] tee: {
	<- oma heksapuri.
}.

a item: Hx uusi.

>> vanha-heksapuri-osoite := a esine prototyyppi muistiosoite.
a save-as: ['/tmp/a.bin'].
Tuloste kirjoita: ['========== LADATAAN SNAP UUDELLEEN:'], rivinvaihto.

>> b := Olio load-from: ['/tmp/a.bin'].

(b esine prototyyppi muistiosoite = vanha-heksapuri-osoite) tosi: {
	Tuloste kirjoita: ['Olion linkki liitetty uudelleen.'], rivinvaihto.
}.
