# Testaa utf8-puhdistin
Server init.

>> utf8tapaukset := Sanakirja uusi
	# Vain ASCII
	aseta: ( Lista uusi ; 65 ; 65 ; 65 ; 65 ; 0 ) kohtaan: ['AAAA'],
	# kelvollinen 2 tavun jakso
	aseta: ( Lista uusi ; 194 ; 162 ; 0 ) kohtaan: ['¢'],
	# Kelvollinen 3-tavuinen UTF-8
    aseta: ( Lista uusi ; 226 ; 130 ; 172 ; 0 ) kohtaan: ['€'],
	# Kelvollinen 4-tavuinen UTF-8
    aseta: ( Lista uusi ; 240 ; 144 ; 141 ; 136 ; 0 ) kohtaan: ['𐍈'],
	# Virheellinen jatkotavu jaksossa E2 28 AC -> 3 tavun jakson alku + 28 väärä jatkotavu + AC jatkotavu, mutta kuuluu samaan virheeseen
    aseta: ( Lista uusi ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) kohtaan: ['A?A'],
	# ASCII-merkin 'A' ylipitkä koodaus (pitäisi muuttua ?:ksi),
    aseta: ( Lista uusi ; 65 ; 193 ; 129 ; 0 ) kohtaan: ['A?'],
	# Virheellinen ensimmäinen tavu (0xFF)
    aseta: ( Lista uusi ; 255 ; 0 ) kohtaan: ['?'],
	# Keskeneräinen monitavuinen jakso lopussa
    aseta: ( Lista uusi ; 66 ; 226 ; 0 ) kohtaan: ['B?'],
    # Tyhjä merkkijono
    #put: ( List new ) at: [''],
	# Useita sekalaisia jaksoja
    aseta: ( Lista uusi ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) kohtaan: ['A€?𐍈B'].
	 
utf8tapaukset jokainen: { :key :value
	>> blob := Blob uusi: value lukumäärä, bytes: value.
	>> str := blob teksti.
	(str = key) tosi: {
		Tuloste kirjoita: ['OK'], rivinvaihto.
	}, muuten: {
		Tuloste kirjoita: ['UTF8-puhdistin epäonnistui: '] + key + [' sai: '] + str, rivinvaihto.
	}.
	blob vapauta.
}.
