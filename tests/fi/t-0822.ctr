# parametrien vähyyden paikkamerkkeihin nähden täytyy antaa virhe eikä lukea sidontojen ohi
Server init.

>> tk := Maria-DB uusi isäntä: ['localhost'],
	käyttäjänimi: ['xo'],
	salasana: ['pass123'],
	tietokannan-nimi: ['xobase'],
	yhdistä.

>> hakuparametrit := tk kysely: ['SELECT ? AS a, ? AS b, ? AS c'].
hakuparametrit parametrit: (Lista uusi ; ['1']).
{ hakuparametrit hae: { :vaakarivi Tuloste kirjoita: vaakarivi, rivinvaihto. }. } sieppaa: { :e Tuloste kirjoita: e, rivinvaihto. }, käynnistä.

>> hakuparametrit := tk kysely: ['SELECT ? AS a'].
{ hakuparametrit hae: { :vaakarivi Tuloste kirjoita: vaakarivi, rivinvaihto. }. } sieppaa: { :e Tuloste kirjoita: e, rivinvaihto. }, käynnistä.

# oikea määrä toimii yhä, ylimääräiset parametrit ohitetaan kuten ennenkin
>> hakuparametrit := tk kysely: ['SELECT ? AS a, ? AS b'].
hakuparametrit parametrit: (Lista uusi ; ['1'] ; ['2']).
hakuparametrit hae: { :vaakarivi Tuloste kirjoita: (vaakarivi kohdassa: ['a']), kirjoita: (vaakarivi kohdassa: ['b']), rivinvaihto. }.
hakuparametrit parametrit: (Lista uusi ; ['1'] ; ['2'] ; ['3']).
hakuparametrit hae: { :vaakarivi Tuloste kirjoita: (vaakarivi kohdassa: ['a']), kirjoita: (vaakarivi kohdassa: ['b']), rivinvaihto. }.
