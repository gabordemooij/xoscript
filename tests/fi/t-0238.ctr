Teksti kun: ['evaluate'] tee: {
	>> koodi := Tiedosto uusi: ['/tmp/eval.ctr'].
	koodi kirjoita: (itse teksti + ['.']).
	Ohjelma käytä: ['/tmp/eval.ctr'].
}.

>> a := Lista ← 1 ; 2 ; 3.
>> b := (a teksti).

Tuloste kirjoita: b, rivinvaihto. 
(['b := '] + b) evaluate.

Tuloste kirjoita: b ? 2, rivinvaihto. 

Tuloste kirjoita: (( Lista ← 1 ; 2 ; 3 )), rivinvaihto. 

Tuloste kirjoita: ((Sanakirja uusi) aseta: 1 kohtaan: 2), rivinvaihto. 

>> x := ( (Lista ← 1 ; ( Lista ← 9 ) ; Tosi ) ) teksti.
Tuloste kirjoita: x, rivinvaihto. 
(['x := '] + x) evaluate.

Tuloste kirjoita: x ? 1 ? 0, rivinvaihto. 

>> y := (Sanakirja uusi) aseta: (Lista ← 1) kohtaan: (Lista ← 2).
Tuloste kirjoita: y, rivinvaihto. 

(['y := '] + y) teksti evaluate.

Tuloste kirjoita: (y kohdassa: (Lista ← 2) teksti ), rivinvaihto.

Tuloste kirjoita: (Lista uusi), rivinvaihto. 
Tuloste kirjoita: (Sanakirja uusi), rivinvaihto. 
