# catch-all test (practical)
>> HTML := Tekst ny.
HTML ved: ['encode:'] gjør: { :tekst
	selv legg-til-sist: (tekst
	erstatt: ['&'] med: ['&amp;'], 
	erstatt: ['<'] med: ['&lt;'],
	erstatt: ['>'] med: ['&gt;'],
	erstatt: ['"'] med: ['&quot;']).
}.
>> blog := HTML ny.
blog legg-til-sist: ['<h1>'],
     encode: ['Koffie & Thee'],
     legg-til-sist: ['</h1>'].
Utdata skriv: blog, stop.


>> Roman := Tall ny.
Roman ved: ['stringy'] gjør: {
	>> a := [''].
	{ a legg-til-sist: ['I']. } × selv. <- a.
}.

>> x := Roman ny.
x legg-til: 3.
Utdata skriv: x stringy, stop.

>> Quantum := Boolsk ny.
Quantum ved: ['true?'] gjør: { <- ['maybe True']. }.
Utdata skriv: (Quantum ny true?), stop.

>> Nihil := Ingenting ny.
Nihil ved: ['tekst'] gjør: { <- ['Nihil']. }.
Utdata skriv: (Nihil ny), stop.
