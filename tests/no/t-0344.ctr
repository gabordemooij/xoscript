# fang-alt-test (praktisk)
>> HTML := Tekst ny.
HTML ved: ['encode:'] gjør: { :teksten
	selv legg-til-sist: (teksten
	erstatt: ['&'] med: ['&amp;'], 
	erstatt: ['<'] med: ['&lt;'],
	erstatt: ['>'] med: ['&gt;'],
	erstatt: ['"'] med: ['&quot;']).
}.
>> blogg := HTML ny.
blogg legg-til-sist: ['<h1>'],
     encode: ['Koffie & Thee'],
     legg-til-sist: ['</h1>'].
Utdata skriv: blogg, stop.


>> Romertall := Tall ny.
Romertall ved: ['tekstaktig'] gjør: {
	>> a := [''].
	{ a legg-til-sist: ['I']. } × selv. <- a.
}.

>> x := Romertall ny.
x legg-til: 3.
Utdata skriv: x tekstaktig, stop.

>> Kvante := Boolsk ny.
Kvante ved: ['true?'] gjør: { <- ['kanskje Sann']. }.
Utdata skriv: (Kvante ny true?), stop.

>> Nihil := Ingenting ny.
Nihil ved: ['tekst'] gjør: { <- ['Nihil']. }.
Utdata skriv: (Nihil ny), stop.
