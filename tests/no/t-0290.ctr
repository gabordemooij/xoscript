# test listeoperasjoner


>> kaker := Liste ←
	['apple'] ;
	['bær'] ;
	['sjoko'] ;
	['ost'].


>> kjøp := kaker erstatt: 1 lengde: 2 med: ( Liste ← ['kanel'] ; ['ananas'] ).
Utdata skriv: (kjøp slå-sammen: [',']), stop.


>> kjøp := kaker erstatt: 1 lengde: 12 med: ( Liste ← ['kanel'] ; ['ananas'] ).
Utdata skriv: (kjøp slå-sammen: [',']), stop.


>> kjøp := kaker erstatt: 2 lengde: 10 med: ( Liste ny ).
Utdata skriv: (kjøp slå-sammen: [',']), stop.


>> kjøp := kaker erstatt: 0 lengde: 1 med: ( Liste ny ).
Utdata skriv: (kjøp slå-sammen: [',']), stop.


>> kjøp := kaker erstatt: ['0'] lengde: ['1'] med: ['x'].
Utdata skriv: (kjøp slå-sammen: [',']), stop.
