# test list operations


>> cakes := Liste ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes erstatt: 1 lengde: 2 med: ( Liste ← ['cinnamon'] ; ['pineapple'] ).
Utdata skriv: (buy slå-sammen: [',']), stop.


>> buy := cakes erstatt: 1 lengde: 12 med: ( Liste ← ['cinnamon'] ; ['pineapple'] ).
Utdata skriv: (buy slå-sammen: [',']), stop.


>> buy := cakes erstatt: 2 lengde: 10 med: ( Liste ny ).
Utdata skriv: (buy slå-sammen: [',']), stop.


>> buy := cakes erstatt: 0 lengde: 1 med: ( Liste ny ).
Utdata skriv: (buy slå-sammen: [',']), stop.


>> buy := cakes erstatt: ['0'] lengde: ['1'] med: ['x'].
Utdata skriv: (buy slå-sammen: [',']), stop.
