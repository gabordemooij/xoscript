>> list := Liste ny.
list ~ ['hello'].
Utdata skriv: list antall.
list legg-til-sist: ['world'].
Utdata skriv: list antall.
Utdata skriv: list ta-siste, skriv: list antall.
list legg-til-sist: ['there'].
Utdata skriv: list antall.
Utdata skriv: (list posisjon: 0), skriv: (list posisjon: 1).
list sett: ['xmas'] ved: 1.
list sett: ['merry'] ved: 0.
Utdata skriv: list antall.
Utdata skriv: (list posisjon: 0), skriv: (list posisjon: 1).
