#ffi test


Server init.

Program minnehåndtering: 4.

# for this test you need set a path to libc (puts)
>> libname := Program innstilling: ['FFITESTLIB'].



Server koble: (
 Liste ny ;
 libname ;
 ['puts'] ;
 ( Liste ny ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s frigjør.

# test with struct

>> a := Blob ny: 8.
a bytes: (
	Liste <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Liste <<: ['int'], ; ['int']).

Server koble: (
	Liste <<: ['@structtest'], ;
	['@structtest'] ;
	(Liste <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Utdata skriv: ['Sum test:'] + (ffitest ffisum: a), stop.

struct frigjør-struct.
struct frigjør.
a frigjør.
