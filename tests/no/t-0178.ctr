Program minnehåndtering: 0.

>> txt := ['Word Salad'].
Utdata skriv: ['siste indeks av rds = '] + (( txt siste: ['ord'] ) - 0), stop.
Utdata skriv: ['indeks av rds = '] + (( txt finn: ['ord'] ) - 0), stop.
Utdata skriv: ['indeks av at = '] + (( txt finn: ['ad'] ) - 0), stop.
Utdata skriv: ['siste indeks av W = '] + (( txt siste: ['W'] ) - 0), stop.
Utdata skriv: ['siste indeks av d = '] + (( txt siste: ['d'] ) - 0), stop.
Utdata skriv: ['tkst er lik Ordsalat = '] + ( txt = ['Word Salad'] ), stop.
Utdata skriv: ['tkst er lik Cæsarsalat = '] + ( txt = ['Cæsarsalat'] ), stop.
Utdata skriv: ['tkst er ikke lik Ordsalat = '] + ( txt ≠ ['Word Salad'] ), stop.
Utdata skriv: ['tkst er ikke lik Cæsarsalat = '] + ( txt ≠ ['Cæsarsalat'] ), stop.

