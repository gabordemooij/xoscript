Utdata skriv: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), stop.
Utdata skriv: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), stop.
Utdata skriv: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), stop.

Program rydd-opp.
usedMemory3 := (Program minne ? 0).



( usedMemory1 = usedMemory2 og: usedMemory1 = usedMemory3, og: usedMemory2 = usedMemory3 ) sann: {
	Utdata skriv: ['No memory leaks here'].
}, falsk: {
	Utdata skriv: ['Leaking memory...'].
}.
