

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program minnehåndtering: 0.

>> txt := ['Word Salad'].
Utdata skriv: ['last index of ord = '] + (( txt siste: ['ord'] ) - 0), stop.
Utdata skriv: ['index of ord = '] + (( txt finn: ['ord'] ) - 0), stop.
Utdata skriv: ['index of ad = '] + (( txt finn: ['ad'] ) - 0), stop.
Utdata skriv: ['last index of W = '] + (( txt siste: ['W'] ) - 0), stop.
Utdata skriv: ['last index of d = '] + (( txt siste: ['d'] ) - 0), stop.
Utdata skriv: ['txt equals Word Salad = '] + ( txt = ['Word Salad'] ), stop.
Utdata skriv: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), stop.
Utdata skriv: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), stop.
Utdata skriv: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), stop.

Program rydd-opp.

usedMemory1 := (Program minne ? 0).


txt := ['Word Salad'].
Utdata skriv: ['last index of ord = '] + (( txt siste: ['ord'] ) - 0), stop.
Utdata skriv: ['index of ord = '] + (( txt finn: ['ord'] ) - 0), stop.
Utdata skriv: ['index of ad = '] + (( txt finn: ['ad'] ) - 0), stop.
Utdata skriv: ['last index of W = '] + (( txt siste: ['W'] ) - 0), stop.
Utdata skriv: ['last index of d = '] + (( txt siste: ['d'] ) - 0), stop.
Utdata skriv: ['txt equals Word Salad = '] + ( txt = ['Word Salad'] ), stop.
Utdata skriv: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), stop.
Utdata skriv: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), stop.
Utdata skriv: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), stop.

Program rydd-opp.
usedMemory2 := (Program minne ? 0).


txt := ['Word Salad'].
Utdata skriv: ['last index of ord = '] + (( txt siste: ['ord'] ) - 0), stop.
Utdata skriv: ['index of ord = '] + (( txt finn: ['ord'] ) - 0), stop.
Utdata skriv: ['index of ad = '] + (( txt finn: ['ad'] ) - 0), stop.
Utdata skriv: ['last index of W = '] + (( txt siste: ['W'] ) - 0), stop.
Utdata skriv: ['last index of d = '] + (( txt siste: ['d'] ) - 0), stop.
