>> Grandfather := Objekt ny.
Grandfather ved: ['greet'] gjør: {
	Utdata skriv: ['Ave!'], stop.
}.
>> Father := Grandfather ny.
Father ved: ['greet'] gjør: {
	Utdata skriv: ['Hello'], stop.
	selv greet.
}.
>> Son := Father ny.
Son ved: ['greet'] gjør: {
	Utdata skriv: ['Hi'], stop.
	selv greet.
}.

Son greet.

>> Roundabout := Objekt ny.
Roundabout ved: ['circle:'] gjør: { :x
	Utdata skriv: x, stop.
	(x < 3) sann: { selv rekursiv circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) sann: { Utdata skriv: x, stop. x legg-til: 1.  increment start. }. }.
increment start.