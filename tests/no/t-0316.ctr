>> Bestefar := Objekt ny.
Bestefar ved: ['hils'] gjør: {
	Utdata skriv: ['Ave!'], stop.
}.
>> Far := Bestefar ny.
Far ved: ['hils'] gjør: {
	Utdata skriv: ['Hello'], stop.
	selv hils.
}.
>> Sønn := Far ny.
Sønn ved: ['hils'] gjør: {
	Utdata skriv: ['Heisann'], stop.
	selv hils.
}.

Sønn hils.

>> Rundkjøring := Objekt ny.
Rundkjøring ved: ['circle:'] gjør: { :x
	Utdata skriv: x, stop.
	(x < 3) sann: { selv rekursiv circle: x + 1. }.
}.

Rundkjøring circle: 1.

>> x := 1.
>> øk := { (x ≤ 3) sann: { Utdata skriv: x, stop. x legg-til: 1.  øk start. }. }.
øk start.