Tekst ved: ['html'] gjør: { <- (
		selv
		erstatt: ['&'] med: ['&amp;'],
		erstatt: ['<'] med: ['&lt;'],
		erstatt: ['>'] med: ['&gt;'],
		erstatt: ['''] med: ['&apos;'],
		erstatt: ['"'] med: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program minnehåndtering: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Utdata skriv: txt kopier html, stop.
Utdata skriv: txt kopier små-bokstaver, stop.
Utdata skriv: txt kopier store-bokstaver, stop.
} start.

Program rydd-opp.

usedMemory1 := (Program minne ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Utdata skriv: txt kopier html, stop.
Utdata skriv: txt kopier små-bokstaver, stop.
Utdata skriv: txt kopier store-bokstaver, stop.
} start.

Program rydd-opp.
usedMemory2 := (Program minne ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Utdata skriv: txt kopier html, stop.
Utdata skriv: txt kopier små-bokstaver, stop.
Utdata skriv: txt kopier store-bokstaver, stop.
} start.

Program rydd-opp.
usedMemory3 := (Program minne ? 0).



( usedMemory1 = usedMemory2 og: usedMemory1 = usedMemory3, og: usedMemory2 = usedMemory3 ) sann: {
	Utdata skriv: ['No memory leaks here'].
}, falsk: {
	Utdata skriv: ['Leaking memory...'].
}.
