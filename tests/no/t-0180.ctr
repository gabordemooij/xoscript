Tekst ved: ['html'] gjør: { <- (
		selv
		erstatt: ['&'] med: ['&amp;'],
		erstatt: ['<'] med: ['&lt;'],
		erstatt: ['>'] med: ['&gt;'],
		erstatt: ['''] med: ['&apos;'],
		erstatt: ['"'] med: ['&quot;']
	).
}.

>> bruktMinne1 := 0.
>> bruktMinne2 := 0.
>> bruktMinne3 := 0.
>> bruktMinne4 := 0.

Program minnehåndtering: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Utdata skriv: txt kopier html, stop.
Utdata skriv: txt kopier små-bokstaver, stop.
Utdata skriv: txt kopier store-bokstaver, stop.
} start.

Program rydd-opp.

bruktMinne1 := (Program minne ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Utdata skriv: txt kopier html, stop.
Utdata skriv: txt kopier små-bokstaver, stop.
Utdata skriv: txt kopier store-bokstaver, stop.
} start.

Program rydd-opp.
bruktMinne2 := (Program minne ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Utdata skriv: txt kopier html, stop.
Utdata skriv: txt kopier små-bokstaver, stop.
Utdata skriv: txt kopier store-bokstaver, stop.
} start.

Program rydd-opp.
bruktMinne3 := (Program minne ? 0).



( bruktMinne1 = bruktMinne2 og: bruktMinne1 = bruktMinne3, og: bruktMinne2 = bruktMinne3 ) sann: {
	Utdata skriv: ['Ingen minnelekkasjer her'].
}, falsk: {
	Utdata skriv: ['Lekker minne...'].
}.
