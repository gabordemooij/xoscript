# Test ASCII-varianter

# Tall

Utdata skriv: (2 !=: 3), stop.
Utdata skriv: (2 <=: 2), stop.
Utdata skriv: (2 >=: 2), stop.

# Tekster

Utdata skriv: (['b'] >=: ['a']), stop.
Utdata skriv: (['b'] !=: ['a']), stop.
Utdata skriv: (['b'] <=: ['c']), stop.

# Boolske verdier

Utdata skriv: (Sann !=: Falsk), stop.

# Objekter

Utdata skriv: (Objekt ny !=: Objekt ny), stop.

# ASCII-listesymbol <-:

Utdata skriv: (Liste <<: 1, ; 2 ; 3) antall = 3, stop.

