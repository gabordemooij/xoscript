# Hvelv-nøkler og signaturer som dekodes for lange, skal ikke få stakken til å flyte over
Server init.

>> nøkler := Hvelv generer-nøkler.
>> sk := nøkler første.
>> pk := nøkler siste.
>> sig := Hvelv signer: ['abc'] med: sk.

# 88 tegn uten utfylling dekodes til 66 bytes
>> lang := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 tegn uten utfylling dekodes til 33 bytes
>> kort := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Hvelv signer: ['abc'] med: lang. } fang: { :e
	Utdata skriv: e, stop.
}, start.

{ Hvelv kontroller: ['abc'] signatur: lang med: pk. } fang: { :e
	Utdata skriv: e, stop.
}, start.

{ Hvelv kontroller: ['abc'] signatur: sig med: kort. } fang: { :e
	Utdata skriv: e, stop.
}, start.
