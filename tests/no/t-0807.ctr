# feilmeldinger fra databasen skal ikke behandles som formatstrenger
Server init.

>> db := Maria-DB ny vert: ['localhost'],
	brukernavn: ['xo'],
	passord: ['pass123'],
	databasenavn: ['xobase'],
	koble-til.

>> søkeparametere := db spørring: ['SELECT %% FROM'].
{ søkeparametere utfør. } fang: { :e
	Utdata skriv: ( e inneholder: ['%%'] ), stop.
}, start.
