Boolsk ved: ['xor:'] gjør: { :a :b <- ((a og: b ikke) eller: (a ikke og: b)).
}.

>> o := Objekt ny.
o ved: ['hello'] gjør: { ['Empty']. }.
{ o ved: 2 gjør: 3.} fang: { :e Utdata skriv: e, stop. }, start.
{ o ved: ['test'] gjør: 3.} fang: { :e Utdata skriv: e, stop. }, start.
{ o ved: ['hello'] gjør: { ['Empty']. }.} fang: { :e Utdata skriv: e, stop. }, start. 
{ >> z := 4 ÷ 0. } fang: { :e Utdata skriv: e, stop. }, start. 
{ (Sann og: Ingenting) sann: { Utdata skriv: ['X'].}. } fang: { :e Utdata skriv: e, stop. }, start. 
{ ([''] xor: 0) sann: { Utdata skriv: ['X'].}. } fang: { :e Utdata skriv: e, stop. }, start. 
{ (1 < ['2']) sann: { Utdata skriv: ['OK']. }. } fang: { :e Utdata skriv: e, stop. }, start. 
{ (1 < ['2.0']) sann: { Utdata skriv: ['OK']. }. } fang: { :e Utdata skriv: e, stop. }, start. 
{ (1 < ['x2.0']) sann: { Utdata skriv: ['NO!']. }. } fang: { :e Utdata skriv: e, stop. }, start. 
{ Utdata skriv: (['hello OK there'] fra: ['6'] lengde: ['2']). } start. 
