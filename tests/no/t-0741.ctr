Utdata skriv: ['Test object'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gjør: { :octhelper
	egen octhelper := octhelper. 
}.

a ved: ['item'] gjør: { <- egen octhelper.
}.

a item: Oct ny.

>> old-octhelper-address := a item prototype minneadresse.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== RELOADING SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototype minneadresse = old-octhelper-address) sann: {
	Utdata skriv: ['Object link re-attached.'], stop.
}.
