Utdata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gjør: { :okthjelper
	egen okthjelper := okthjelper. 
}.

a ved: ['vare'] gjør: {
	<- egen okthjelper.
}.

a item: Oct ny.

>> gammel-okthjelper-adresse := a vare prototype minneadresse.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== LASTER INN SNAP PÅ NYTT:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b vare prototype minneadresse = gammel-okthjelper-adresse) sann: {
	Utdata skriv: ['Objektlenke koblet til igjen.'], stop.
}.
