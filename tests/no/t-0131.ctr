
>> a := Liste ← (Liste ← 100 ; 200 ; 300) ; (Liste ← 9 ; 8 ; 7).
Utdata skriv: ['at 0,1 :'].
Utdata skriv: a ? 0 ? 1, stop. 
Utdata skriv: ['at 1,2 :'].
Utdata skriv: a ? 1 ? 2, stop. 
>> menu := Ordbok ny.
menu sett: (Liste ← ['pizza'] ; ['spaghetti']) ved: ['Italian Cuisine'].
menu sett: (Liste ← ['bifteki'] ; ['suflaki']) ved: ['Greek Cuisine'].
Utdata skriv: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), stop. 
Utdata skriv: ['but not on the same plate.'], stop.
