Tall ved: ['roman'] gjør: {
	>> tall := selv kopier.
	>> roman := [''].
	{
		{
			(tall ≥ 1000) sann: {
				roman legg-til-sist: ['Ⅿ'].
				tall trekk-fra: 1000.
			}, avbryt.
		
			(tall ≥ 500) sann: {
				roman legg-til-sist: ['Ⅾ'].
				tall trekk-fra: 500.
			}, avbryt.
		
			(tall ≥ 100) sann: {
				roman legg-til-sist: ['Ⅽ'].
				tall trekk-fra: 100.
			}, avbryt.
		
			(tall ≥ 50) sann: {
				roman legg-til-sist: ['Ⅼ'].
				tall trekk-fra: 50.
			}, avbryt.
		
			(tall ≥ 50) sann: {
				roman legg-til-sist: ['Ⅼ'].
				tall trekk-fra: 50.
			}, avbryt.
		
			(tall ≥ 10) sann: {
				roman legg-til-sist: ['Ⅹ'].
				tall trekk-fra: 10.
			}, avbryt.
			
			(tall ≥ 9) sann: {
				roman legg-til-sist: ['Ⅸ'].
				tall trekk-fra: 9.
			}, avbryt.
			
			(tall ≥ 5) sann: {
				roman legg-til-sist: ['Ⅴ'].
				tall trekk-fra: 5.
			}, avbryt.
			
			(tall ≥ 4) sann: {
				roman legg-til-sist: ['Ⅳ'].
				tall trekk-fra: 4.
			}, avbryt.
			
			(tall ≥ 1) sann: {
				roman legg-til-sist: ['Ⅰ'].
				tall trekk-fra: 1.
			}, avbryt.
		} prosedyre.
	} mens: { <- tall > 0. }. <- roman.
}.

Utdata skriv: 1 roman, stop.
Utdata skriv: 2 roman, stop.
Utdata skriv: 4 roman, stop.
Utdata skriv: 8 roman, stop.
Utdata skriv: 16 roman, stop.
Utdata skriv: 32 roman, stop.
Utdata skriv: 64 roman, stop.
Utdata skriv: 128 roman, stop.
Utdata skriv: 256 roman, stop.
Utdata skriv: 1024 roman, stop.
