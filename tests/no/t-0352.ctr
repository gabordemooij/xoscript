Tall ved: ['romertall'] gjør: {
	>> tall := selv kopier.
	>> romertall := [''].
	{
		{
			(tall ≥ 1000) sann: {
				romertall legg-til-sist: ['Ⅿ'].
				tall trekk-fra: 1000.
			}, avbryt.
		
			(tall ≥ 500) sann: {
				romertall legg-til-sist: ['Ⅾ'].
				tall trekk-fra: 500.
			}, avbryt.
		
			(tall ≥ 100) sann: {
				romertall legg-til-sist: ['Ⅽ'].
				tall trekk-fra: 100.
			}, avbryt.
		
			(tall ≥ 50) sann: {
				romertall legg-til-sist: ['Ⅼ'].
				tall trekk-fra: 50.
			}, avbryt.
		
			(tall ≥ 50) sann: {
				romertall legg-til-sist: ['Ⅼ'].
				tall trekk-fra: 50.
			}, avbryt.
		
			(tall ≥ 10) sann: {
				romertall legg-til-sist: ['Ⅹ'].
				tall trekk-fra: 10.
			}, avbryt.
			
			(tall ≥ 9) sann: {
				romertall legg-til-sist: ['Ⅸ'].
				tall trekk-fra: 9.
			}, avbryt.
			
			(tall ≥ 5) sann: {
				romertall legg-til-sist: ['Ⅴ'].
				tall trekk-fra: 5.
			}, avbryt.
			
			(tall ≥ 4) sann: {
				romertall legg-til-sist: ['Ⅳ'].
				tall trekk-fra: 4.
			}, avbryt.
			
			(tall ≥ 1) sann: {
				romertall legg-til-sist: ['Ⅰ'].
				tall trekk-fra: 1.
			}, avbryt.
		} prosedyre.
	} mens: { <- tall > 0. }. <- romertall.
}.

Utdata skriv: 1 romertall, stop.
Utdata skriv: 2 romertall, stop.
Utdata skriv: 4 romertall, stop.
Utdata skriv: 8 romertall, stop.
Utdata skriv: 16 romertall, stop.
Utdata skriv: 32 romertall, stop.
Utdata skriv: 64 romertall, stop.
Utdata skriv: 128 romertall, stop.
Utdata skriv: 256 romertall, stop.
Utdata skriv: 1024 romertall, stop.
