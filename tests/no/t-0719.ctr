Server init.
>> fmt := Format ny: ['%#3x'].

>> blob := Blob ny: 4.
blob bytes: ( 
	Liste ny ; 0 ; 1 ; 2 ; 3
).

>> file := Fil ny: ['/tmp/blob'].
file blob: blob.
blob frigjør.

>> les := file blob.
les 
fra: 0 
lengde: 4, 
gjør hver: { :i :b 
	Utdata
	skriv: (fmt bruk-heltall: b),
	stop.
}.
les frigjør.
