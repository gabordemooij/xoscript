# et anførselstegn som aldri lukkes, skal gi en feil, ikke en endeløs løkke
>> sti := ['/tmp/test0821.csv'].
>> file := Fil ny: sti.

file skriv: ['a,b\n"1,2\n'].
{
	file skilletegn: [','] anførselstegn: ['"'] linjer: { :line
		Utdata skriv: line, stop.
	}.
} fang: { :e Utdata skriv: e, stop. }, start.

# et lukket anførselstegn virker fortsatt
file skriv: ['a,b\n"1,2",3'].
file skilletegn: [','] anførselstegn: ['"'] linjer: { :line
	Utdata skriv: line, stop.
}.
file slett.
