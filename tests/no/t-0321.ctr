# test betegnelser

Program rydd-opp.

>> Frukt := Objekt ny.
Frukt ved: ['ny'] gjør: {
	>> f := selv ny.
	f apples: 0. <- f.
}.
Frukt ved: ['apples:'] gjør: { :a egen epler := a. }.
Frukt ved: ['epler'] gjør: { <- egen epler. }.
Frukt ved: ['+'] gjør: { :f
	>> n := Frukt ny.
	n apples: (f epler + egen epler). <- n.
}.
Tall ved: ['epler'] gjør: { <- ((Frukt ny) apples: selv).
}.

Frukt ved: ['tekst'] gjør: { <- egen epler + [' epler '].
}.

>> q := 3 epler + 4 epler.
Utdata skriv: q, stop.




q := 3 epler + 4 epler.
Utdata skriv: q, stop.



