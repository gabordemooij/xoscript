# test qualifiers

Program rydd-opp.

>> Fruit := Objekt ny.
Fruit ved: ['ny'] gjør: {
	>> f := selv ny.
	f apples: 0. <- f.
}.
Fruit ved: ['apples:'] gjør: { :a egen apples := a. }.
Fruit ved: ['apples'] gjør: { <- egen apples. }.
Fruit ved: ['+'] gjør: { :f
	>> n := Fruit ny.
	n apples: (f apples + egen apples). <- n.
}.
Tall ved: ['apples'] gjør: { <- ((Fruit ny) apples: selv).
}.

Fruit ved: ['tekst'] gjør: { <- egen apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Utdata skriv: q, stop.




q := 3 apples + 4 apples.
Utdata skriv: q, stop.



q := 3 apples + 4 apples.
Utdata skriv: q, stop.


