Server init.

>> DB := Maria-DB ny vert: ['localhost'],
	brukernavn: ['xo'],
	passord: ['pass123'],
	databasenavn: ['xobase'],
	koble-til.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> søkeparametere := Maria-Spørring ny: SQL.

# set database
søkeparametere database: DB.

søkeparametere hent: { :row
	Utdata skriv: row world, stop.
}.
