Server init.

>> DB := Maria-DB ny vert: ['localhost'],
	brukernavn: ['xo'],
	passord: ['pass123'],
	databasenavn: ['xobase'],
	koble-til.
	
>> SQL := ['SELECT "hello" AS "world" '].

# opprett spørring manuelt
>> søkeparametere := Maria-Spørring ny: SQL.

# sett database
søkeparametere database: DB.

søkeparametere hent: { :rad
	Utdata skriv: rad world, stop.
}.
