Program minnehåndtering: 0.
Liste ved: ['sum'] gjør: {
	>> total := 0.
	selv hver: { :indeks :element
		total legg-til: element.
	}. <- total.
}.

>> bruktMinne1 := 0.
>> bruktMinne2 := 0.
>> bruktMinne3 := 0.
>> bruktMinne4 := 0.



>> f := Fil ny: ['/tmp/test.txt'].
f skriv: ['Lorem Ipsum'].
f lukk.
  

f := Fil ny: ['/tmp/test.txt'].
>> tekstbit := f les.
f lukk.



Program rydd-opp.
bruktMinne1 := (Program minne ? 1).



f := Fil ny: ['/tmp/test.txt'].
tekstbit := f les.
f lukk.

Program rydd-opp.
bruktMinne2 := (Program minne ? 1).


f := Fil ny: ['/tmp/test.txt'].
tekstbit := f les.
f lukk.

Program rydd-opp.
bruktMinne3 := (Program minne ? 1).



( bruktMinne1 = bruktMinne2 og: bruktMinne1 = bruktMinne3, og: bruktMinne2 = bruktMinne3 ) sann: {
	Utdata skriv: ['Ingen minnelekkasjer her'].
}, falsk: {
	Utdata skriv: ['Lekker minne...'].
}.
