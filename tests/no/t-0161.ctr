Program minnehåndtering: 0.
Liste ved: ['sum'] gjør: {
	>> total := 0.
	selv hver: { :index :element
		total legg-til: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Fil ny: ['/tmp/test.txt'].
f skriv: ['Lorem Ipsum'].
f lukk.
  

f := Fil ny: ['/tmp/test.txt'].
>> text := f les.
f lukk.



Program rydd-opp.
usedMemory1 := (Program minne ? 1).



f := Fil ny: ['/tmp/test.txt'].
text := f les.
f lukk.

Program rydd-opp.
usedMemory2 := (Program minne ? 1).


f := Fil ny: ['/tmp/test.txt'].
text := f les.
f lukk.

Program rydd-opp.
usedMemory3 := (Program minne ? 1).



( usedMemory1 = usedMemory2 og: usedMemory1 = usedMemory3, og: usedMemory2 = usedMemory3 ) sann: {
	Utdata skriv: ['No memory leaks here'].
}, falsk: {
	Utdata skriv: ['Leaking memory...'].
}.
