



>> Kaffegrut := Objekt ny.
Kaffegrut ved: ['trekkUt'] gjør: { <- ['coffee']. }.

>> Kaffemaskin := Objekt ny.
Kaffemaskin ved: ['init'] gjør: {
	egen kaffegrut := Kaffegrut ny.
}.
Kaffemaskin ved: ['ny'] gjør: { <- Kaffemaskin `new init.
}.

Kaffemaskin ved: ['lagTe'] gjør: { <- (egen teblader trekkUt). }.
Kaffemaskin ved: ['lagKaffe'] gjør: { <- (egen kaffegrut trekkUt). }.

>> kaffedrøm := Kaffemaskin ny.

Utdata skriv:
	kaffedrøm 
	lagKaffe.

Utdata skriv:
	kaffedrøm 
	lagTe.
