



>> CoffeeGrounds := Objekt ny.
CoffeeGrounds ved: ['extract'] gjør: { <- ['coffee']. }.

>> CoffeeMachine := Objekt ny.
CoffeeMachine ved: ['init'] gjør: {
	egen coffeegrounds := CoffeeGrounds ny.
}.
CoffeeMachine ved: ['ny'] gjør: { <- CoffeeMachine `new init.
}.

CoffeeMachine ved: ['makeTea'] gjør: { <- (egen tealeaves extract). }.
CoffeeMachine ved: ['makeCoffee'] gjør: { <- (egen coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine ny.

Utdata skriv:
	coffeeDream 
	makeCoffee.

Utdata skriv:
	coffeeDream 
	makeTea.
