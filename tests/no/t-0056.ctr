>> z := Objekt ny.
z ved: ['value:'] gjør: { :v
	egen value := v. <- selv.
}.
z ved: ['value'] gjør: { <- egen value. }.
(z setValue: 1) value: 2.
Utdata skriv: z value.
>> x := z.
Utdata skriv: x value.
z := Ingenting.
Utdata skriv: z value.
Utdata skriv: x value.
Utdata skriv: ['hello'].
Utdata skriv: 3 + 2.
Utdata skriv: (3 > 2).
