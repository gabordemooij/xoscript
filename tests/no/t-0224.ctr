
>> countries := Liste ny
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Liste ny
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods etter: countries, hver: { :key :value
	counter legg-til: 1.
}.

Utdata skriv: (['we serve counter dishes'] counter: counter), stop.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] tegn sorter: { :v
	counter legg-til: 0.
}.

Utdata skriv: (['we sort counter dishes'] counter: counter), stop.


>> counter := 0.
{
	{
		counter legg-til: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Utdata skriv: (['we calculate counter numbers.'] counter: counter), stop.

