
>> landene := Liste ny
	~ ['Sveits']
	~ ['Italia']
	~ ['Tyskland'].

>> matvarer := Liste ny
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Surkål'].


>> teller := 0.
matvarer etter: landene, hver: { :key :value
	teller legg-til: 1.
}.

Utdata skriv: (['we serve counter dishes'] counter: teller), stop.

>> teller := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] tegn sorter: { :v
	teller legg-til: 0.
}.

Utdata skriv: (['we sort counter dishes'] counter: teller), stop.


>> teller := 0.
{
	{
		teller legg-til: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Utdata skriv: (['we calculate counter numbers.'] counter: teller), stop.

