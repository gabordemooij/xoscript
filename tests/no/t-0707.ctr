# test typekonverteringer / omforminger / bindinger
Program minnehåndtering: 4.
Server init.

>> teller := 0.
>> db := Maria-DB ny vert: ['localhost'],
	brukernavn: ['xo'], passord: ['pass123'], databasenavn: ['xobase'], koble-til.

>> TosifretFormat := Format ny: ['%02d'].

# Datotid
{
	>> år     := Tall mellom: 1995 og: 2050, tekst.
	>> måned    := TosifretFormat bruk-heltall: (Tall mellom: 1 og: 12), tekst.
	>> dag      := TosifretFormat bruk-heltall: (Tall mellom: 1 og: 28), tekst.
	>> time     := TosifretFormat bruk-heltall: (Tall mellom: 1 og: 23), tekst.
	>> minutt   := TosifretFormat bruk-heltall: (Tall mellom: 1 og: 59), tekst.
	>> sekund   := TosifretFormat bruk-heltall: (Tall mellom: 1 og: 59), tekst.
	>> datotid := ['YYYY-MM-DD HH:II:SS'].	
	datotid
		YYYY: år,
		MM: måned,
		DD: dag,
		HH: time,
		II: minutt,
		SS: sekund.
	>> søkeparametere :=
	db spørring: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: datotid),
	hent: { :rad
		(rad mydatetime = datotid) falsk: {
			denne-oppgaven feil: (
				['Forventet: <expected>, men fikk: <observation>']
				<expected>: datotid,
				<observation>: rad mydatetime
			).
		}.
	
	}.
	teller legg-til: 1.
} * 100.

# Dato
{
	>> år     := Tall mellom: 1995 og: 2050, tekst.
	>> måned    := TosifretFormat bruk-heltall: (Tall mellom: 1 og: 12), tekst.
	>> dag      := TosifretFormat bruk-heltall: (Tall mellom: 1 og: 28), tekst.
	>> dato     := ['YYYY-MM-DD'].
	dato
		YYYY: år,
		MM: måned,
		DD: dag.
	>> søkeparametere :=
	db spørring: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: dato),
	hent: { :rad
		(rad mydate = dato) falsk: {
			denne-oppgaven feil: (
				['Forventet: <expected>, men fikk: <observation>']
				<expected>: dato,
				<observation>: rad mydate
			).
		}.
	}.
	teller legg-til: 1.
} * 100.


# Tid
{
	>> time     := TosifretFormat bruk-heltall: (Tall mellom: 1 og: 23), tekst.
	>> minutt   := TosifretFormat bruk-heltall: (Tall mellom: 1 og: 59), tekst.
	>> sekund   := TosifretFormat bruk-heltall: (Tall mellom: 1 og: 59), tekst.
	>> tid := ['HH:II:SS'].
	tid
		HH: time,
		II: minutt,
		SS: sekund.
	>> søkeparametere :=
	db spørring: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: tid),
	hent: { :rad
		(rad mytime = tid) falsk: {
			denne-oppgaven feil: (
				['Forventet: <expected>, men fikk: <observation>']
				<expected>: datotid,
				<observation>: rad mytime
			).
		}.
	}.
	teller legg-til: 1.
} * 100.


# Tekster (varchar/text)
>> str1 := Liste ny fyll: 100000 med: ['x'], slå-sammen: [''].
{
	>> str2 := Hvelv token: 40.
	>> søkeparametere :=
	db spørring: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	hent: { :rad
		(rad str1 = str1 og: rad str2 = str2) falsk: {
			denne-oppgaven feil: (
				['Forventet: <expected>, men fikk: <observation>']
				<expected>: datotid,
				<observation>: rad mytime
			).
		}.
	}.
	teller legg-til: 1.
} * 100.


# Tall
{
	>> n1  := Tall mellom: 1 og: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 fra-tekst: ['9223372036854775807'] ) -
		( Int64 fra-tekst: ['99999'] ) +
		( Int64 fra-tekst: n1 tekst )
	).
	>> søkeparametere :=
	db spørring: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	hent: { :rad
		(rad n1 = n1) falsk: {
			denne-oppgaven feil: (
				['Forventet: <expected>, men fikk: <observation>']
				<expected>: n1,
				<observation>: rad n1
			).
		}.
		(rad n2 = n2) falsk: {
			denne-oppgaven feil: (
				['Forventet: <expected>, men fikk: <observation>']
				<expected>: n1,
				<observation>: rad n2
			).
		}.
		(rad n3 = n2 avrund) falsk: {
			denne-oppgaven feil: (
				['Forventet: <expected>, men fikk: <observation>']
				<expected>: n1,
				<observation>: rad n3
			).
		}.
		(rad big = big) falsk: {
			denne-oppgaven feil: (
				['Forventet: <expected>, men fikk: <observation>']
				<expected>: big,
				<observation>: rad big
			).
		}.
		
	}.
	teller legg-til: 1.
} * 100.


Utdata skriv: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: teller
), stop.