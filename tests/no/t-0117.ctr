>> t := Sann.
(t = Sann) sann: { Utdata skriv: ['T']. }.
(t = Falsk) sann: { Utdata skriv: ['F']. }.
Utdata skriv: ['|'].
>> t := Falsk.
(t = Sann) sann: { Utdata skriv: ['T']. }.
(t = Falsk) sann: { Utdata skriv: ['F']. }.
Utdata skriv: ['|'].
>> f := Sann.
(t = Sann og: f = Falsk) sann: { Utdata skriv: ['T']. }.
(t = Falsk og: f = Sann) sann: { Utdata skriv: ['F']. }.
Utdata skriv: ['|'].
>> n := Ingenting.
(n Ingenting?) sann: { Utdata skriv: ['T']. }.
(n Ingenting?) falsk: { Utdata skriv: ['F']. }.
Utdata skriv: ['|'].
(f Boolean?) sann: { Utdata skriv: ['T']. }.
(f Boolean?) falsk: { Utdata skriv: ['F']. }.



