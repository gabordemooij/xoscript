
>> dictionary := (
	Ordbok ny
		sett: ['b'] ved: ['a'],
		sett: ['a'] ved: ['b'],
		sett: ['z'] ved: ['x'],
		sett: ['hello'] ved: ['hallo'],
		sett: ['human'] ved: ['human']
).

>> comparisons := Liste ny.
dictionary hver: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a sammenlign: b)
	).
}.

comparisons sorter: { :a :b <- ( a sammenlign: b ). }.
Utdata skriv: ( comparisons slå-sammen: ['↵'] ), stop.
comparisons slå-sammen: ['↵'].
