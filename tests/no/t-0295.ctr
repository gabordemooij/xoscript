
>> ordliste := (
	Ordbok ny
		sett: ['b'] ved: ['a'],
		sett: ['a'] ved: ['b'],
		sett: ['z'] ved: ['x'],
		sett: ['hello'] ved: ['hallo'],
		sett: ['menneske'] ved: ['menneske']
).

>> sammenligninger := Liste ny.
ordliste hver: { :a :b
	sammenligninger ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a sammenlign: b)
	).
}.

sammenligninger sorter: { :a :b <- ( a sammenlign: b ). }.
Utdata skriv: ( sammenligninger slå-sammen: ['↵'] ), stop.
sammenligninger slå-sammen: ['↵'].
