# test Program version

# this feature is disabled by default
Utdata skriv: (
	Program funksjonalitet: 
	['RECURSIVE_STRINTPOL']
), stop.


# but if we set the time back
>> today := Moment 
sone: ['CEST'],
fra: ['2026-02-15 10:00:00'].
Program version: today.

# it will be enabled like it used to be (from now on)
Utdata skriv: (
	Program funksjonalitet: 
	['RECURSIVE_STRINTPOL']
), stop.