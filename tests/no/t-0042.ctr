>> items := Ordbok ny.
items sett: ['black'] ved: ['coffee'], sett: ['earl grey'] ved: ['tea'].
Utdata skriv: (items ved: ['coffee']), skriv: (items ved: ['tea']).
Utdata skriv: ['there are'] + items antall + [' items in the array.'].
items sett: ['capuccino'] ved: ['coffee'].
Utdata skriv: ['Now my coffee is.. '] + (items ved: ['coffee']).
items sett: ['aaa'] ved: ['1'].
items sett: ['bbb'] ved: ['2'].
Utdata skriv: (items ved: ['a']).
