>> items := Ordbok ny.
items sett: ['svart'] ved: ['coffee'], sett: ['earl grey'] ved: ['te'].
Utdata skriv: (items ved: ['coffee']), skriv: (items ved: ['te']).
Utdata skriv: ['det er'] + items antall + [' elementer i listen.'].
items sett: ['cappuccino'] ved: ['coffee'].
Utdata skriv: ['Nå er kaffen min.. '] + (items ved: ['coffee']).
items sett: ['aaa'] ved: ['1'].
items sett: ['bbb'] ved: ['2'].
Utdata skriv: (items ved: ['a']).
