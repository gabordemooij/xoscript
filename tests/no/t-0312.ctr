>> Slurp := Objekt ny.
Slurp ved: ['ny'] gjør: {
	egen str := [''].
}.
Slurp lær: ['nieuw'] betyr: ['ny'].
Slurp ved: ['svar:'] gjør: { :blah
		(egen str ≠ ['']) sann: {
			egen str legg-til-sist: [' '].
		}.
		egen str legg-til-sist: blah.
}.
Slurp ved: ['svar:og:'] gjør: { :blah :blahah
		(egen str ≠ ['']) sann: {
			egen str legg-til-sist: [' '].
		}.
		(blah lengde > 1) sann: {
			egen str legg-til-sist: (blah fra: 0 lengde: (blah lengde - 1)).
		}, ellers: {
			egen str legg-til-sist: blah.
		}.
		egen str legg-til-sist: [' '].
		egen str legg-til-sist: blahah.
}.
Slurp ved: ['obtain'] gjør: {
	>> buffer := egen str.
	egen str := ['']. <- buffer.
}.


>> søkeparametere := Slurp ny
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

Utdata skriv: søkeparametere obtain, stop.
