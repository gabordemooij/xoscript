>> setninger := Liste ny
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> melding := ['Phrase: ~decoded base64: ~encoded'].
	
setninger hver: { :_ :setning 
	>> e := Server base64-kode: setning.
	>> d := Server base64-dekode: e.
	Utdata skriv: (
		melding kopier ~encoded: e, ~decoded: d
	), stop.
}.
