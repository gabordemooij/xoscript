# Denne testen sjekker om string_fill_in ikke mister plassen sin (gc'ed) i modus 4
# referanse i world.c
>> Loggbok := Objekt ny.

Loggbok ved: ['say:'] gjør: { :str
	Utdata skriv: str, stop.
}.

>> Vare := Objekt ny.

Vare ved: ['ny:'] gjør: { :id
	<- selv ny id: id.
}.

Vare ved: ['id:'] gjør: { :id
	egen id := id.
}.

Vare ved: ['id'] gjør: { <- egen id. }.


Vare ved: ['tekst'] gjør: {
	>> str := ['Item#~no'].
	str ~no: egen id.
	<- str.
}.


>> Print := Objekt ny.

Print ved: ['items'] gjør: { 
	
	egen vare := Vare ny: 1.
	
	# enten segfault eller feil tegnstreng her
	Loggbok say: (
		['~item printed.'] ~item: egen vare
	).
	
	
}.

Print items.