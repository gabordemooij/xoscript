>> items := Ordbok ny.
items sett: ['grønn'] ved: ['color-1'].
items sett: ['oransje'] ved: ['color-2'].
items sett: ['rød'] ved: ['color-3'].
>> i := 0.
>> s := [''].
items hver: { :key :farge
	Utdata skriv: ['color #'] + i + [' er: '] + farge + [' '].
	i legg-til: 1.
}.
Utdata skriv: i + [' farger!'].
