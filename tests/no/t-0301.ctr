


>> vin := Objekt ny.


vin ved: ['tilTekst'] gjør: { <- ['merlot'].
}.

vin ved: ['naarTekst'] gjør: { <- ['merlot'].
}.


vin ved: ['='] gjør: { :other wine <- ( selv tilTekst = other wine ).
}.

vin ved: ['=='] gjør: { :other wine <- ( selv tilTekst = other wine ).
}.



vin
	tilfelle: ['cabernet'] gjør: { Utdata skriv: ['det er en Cabernet!']. },
	tilfelle: ['syrah']    gjør: { Utdata skriv: ['det er en Syrah!'].    },
	tilfelle: ['merlot']   gjør: { Utdata skriv: ['det er en Merlot!'].   },
	tilfelle: ['malbec']   gjør: { Utdata skriv: ['det er en Malbec!'].   }.

Utdata stop.
