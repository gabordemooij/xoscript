


>> wine := Objekt ny.


wine ved: ['toString'] gjør: { <- ['merlot'].
}.

wine ved: ['naarTekst'] gjør: { <- ['merlot'].
}.


wine ved: ['='] gjør: { :other wine <- ( selv toString = other wine ).
}.

wine ved: ['=='] gjør: { :other wine <- ( selv toString = other wine ).
}.



wine
	tilfelle: ['cabernet'] gjør: { Utdata skriv: ['it's a Cabernet!']. },
	tilfelle: ['syrah']    gjør: { Utdata skriv: ['it's a Syrah!'].    },
	tilfelle: ['merlot']   gjør: { Utdata skriv: ['it's a Merlot!'].   },
	tilfelle: ['malbec']   gjør: { Utdata skriv: ['it's a Malbec!'].   }.

Utdata stop.
