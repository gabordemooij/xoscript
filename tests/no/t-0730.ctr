Utdata skriv: ['Test object'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gjør: { :moment
	egen moment := moment. 
}.

a ved: ['item'] gjør: { <- egen moment.
}.

>> today := Moment ny sone: ['CEST'], år: 2026, måned: 7.
a item: today.
Utdata skriv: a item, stop.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== RELOADING SNAP:'], stop.
>> b := Objekt load-from: ['/tmp/a.bin'].
Utdata skriv: b item, stop.
