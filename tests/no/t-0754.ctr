Utdata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gjør: { :ut
	egen ut := ut. 
}.

a ved: ['vare'] gjør: {
	<- egen ut.
}.

a ved: ['hils'] gjør: {
	Utdata skriv: ['hei fra den opprinnelige ut!'], stop.
}.

a item: Utdata.

Utdata skriv: a vare, stop.

>> gammel-ut-adresse := a vare prototype minneadresse.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== LASTER INN SNAP PÅ NYTT:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b vare prototype minneadresse = gammel-ut-adresse) sann: {
	Utdata skriv: ['Objektlenke koblet til igjen.'], stop.
}.

b vare skriv: ['hallo fra den innlastede ut!'], stop.
b hils.
