Utdata skriv: ['Test object'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gjør: { :out
	egen out := out. 
}.

a ved: ['item'] gjør: { <- egen out.
}.

a ved: ['greet'] gjør: {
	Utdata skriv: ['hi from original out!'], stop.
}.

a item: Utdata.

Utdata skriv: a item, stop.

>> old-out-address := a item prototype minneadresse.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== RELOADING SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototype minneadresse = old-out-address) sann: {
	Utdata skriv: ['Object link re-attached.'], stop.
}.

b item skriv: ['hello from loaded out!'], stop.
b greet.
