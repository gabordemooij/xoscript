# test qualifiers

>> $ := Objekt ny.

$ ved: ['svar:'] gjør: { :x
	
	>> operation := x tegn: 0.
	>> valuta := x tegn: 1.
	>> money := x offset: 2.
	
	>> amount := 0.

	( operation = ['+'] ) sann: {
		( valuta = ['£'] ) sann: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Utdata skriv: x, stop.


>> Fruit := Objekt ny.

Fruit ved: ['ny'] gjør: {
	>> f := selv ny.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit ved: ['apples:'] gjør: { :a egen apples := a. }.
Fruit ved: ['oranges:'] gjør: { :p egen oranges := p. }.
Fruit ved: ['apples'] gjør: { <- egen apples. }.
Fruit ved: ['oranges'] gjør: { <- egen oranges. }.

Fruit ved: ['+'] gjør: { :f
	
	>> n := Fruit ny.
	f legg-til: 1.
	
	n apples: (f apples + egen apples).
	n oranges:  (f oranges  + egen oranges). <- n.
}.

Fruit ved: ['tekst'] gjør: { <- ( egen apples tekst + [' apples and '] + egen oranges + [' oranges'] ).
}.

Tall ved: ['apples'] gjør: { <- ((Fruit ny) apples: selv).
}.

Tall ved: ['apple'] gjør: { <- ((Fruit ny) apples: selv).
}.

Tall ved: ['oranges'] gjør: { <- ((Fruit ny) oranges: selv).
}.




Utdata skriv: (1 apple + 3 oranges + 4 apples), stop.


Tekst ved: ['twice'] gjør: { <- ((selv tekst) + (selv tekst)).
}.



Utdata skriv: ['❤❤❤'] twice.



