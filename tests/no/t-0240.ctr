# test betegnelser

>> $ := Objekt ny.

$ ved: ['svar:'] gjør: { :x
	
	>> operasjon := x tegn: 0.
	>> valutategn := x tegn: 1.
	>> penger := x offset: 2.
	
	>> beløp := 0.

	( operasjon = ['+'] ) sann: {
		( valutategn = ['£'] ) sann: { beløp := 1.28 × penger. }.
	}. <- beløp.
}.



>> x := $ +£20.

Utdata skriv: x, stop.


>> Frukt := Objekt ny.

Frukt ved: ['ny'] gjør: {
	>> f := selv ny.
	f apples: 0.
	f oranges: 0. <- f.
}.

Frukt ved: ['apples:'] gjør: { :a egen epler := a. }.
Frukt ved: ['oranges:'] gjør: { :p egen appelsiner := p. }.
Frukt ved: ['epler'] gjør: { <- egen epler. }.
Frukt ved: ['appelsiner'] gjør: { <- egen appelsiner. }.

Frukt ved: ['+'] gjør: { :f
	
	>> n := Frukt ny.
	f legg-til: 1.
	
	n apples: (f epler + egen epler).
	n oranges:  (f appelsiner  + egen appelsiner). <- n.
}.

Frukt ved: ['tekst'] gjør: { <- ( egen epler tekst + [' epler og '] + egen appelsiner + [' appelsiner'] ).
}.

Tall ved: ['epler'] gjør: { <- ((Frukt ny) apples: selv).
}.

Tall ved: ['apple'] gjør: { <- ((Frukt ny) apples: selv).
}.

Tall ved: ['appelsiner'] gjør: { <- ((Frukt ny) oranges: selv).
}.




Utdata skriv: (1 apple + 3 appelsiner + 4 epler), stop.


Tekst ved: ['dobbelt'] gjør: { <- ((selv tekst) + (selv tekst)).
}.



Utdata skriv: ['❤❤❤'] dobbelt.



