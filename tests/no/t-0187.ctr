Tall ved: ['factorial'] gjør: {
	>> total := 1.
	{ :index total multipliser-med: (selv - index). } × selv. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program minnehåndtering: 0.

{
2 exponent factorial.
Utdata skriv: (11 modulo: 3), stop.
Utdata skriv: (3.4 avrund), stop.
Utdata skriv: (7.1 rund-opp), stop.
Utdata skriv: (7.9 rund-ned), stop.
}
start.

Program rydd-opp.

usedMemory1 := (Program minne ? 0).

{
2 exponent factorial.
