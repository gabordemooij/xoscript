Tall ved: ['fakultet'] gjør: {
	>> total := 1.
	{ :indeks total multipliser-med: (selv - indeks). } × selv. <- total.
}.

>> bruktMinne1 := 0.
>> bruktMinne2 := 0.
>> bruktMinne3 := 0.
>> bruktMinne4 := 0.

Program minnehåndtering: 0.

{
2 eksponent fakultet.
Utdata skriv: (11 modulo: 3), stop.
Utdata skriv: (3.4 avrund), stop.
Utdata skriv: (7.1 rund-opp), stop.
Utdata skriv: (7.9 rund-ned), stop.
}
start.

Program rydd-opp.

bruktMinne1 := (Program minne ? 0).

{
2 eksponent fakultet.
Utdata skriv: (11 modulo: 3), stop.
Utdata skriv: (3.4 avrund), stop.
Utdata skriv: (7.1 rund-opp), stop.
Utdata skriv: (7.9 rund-ned), stop.
}
start.

Program rydd-opp.
bruktMinne2 := (Program minne ? 0).


{
2 eksponent fakultet.
Utdata skriv: (11 modulo: 3), stop.
Utdata skriv: (3.4 avrund), stop.
Utdata skriv: (7.1 rund-opp), stop.
Utdata skriv: (7.9 rund-ned), stop.
} start.

Program rydd-opp.
bruktMinne3 := (Program minne ? 0).



( bruktMinne1 = bruktMinne2 og: bruktMinne1 = bruktMinne3, og: bruktMinne2 = bruktMinne3 ) sann: {
	Utdata skriv: ['Ingen minnelekkasjer her'].
}, falsk: {
	Utdata skriv: ['Lekker minne...'].
}.
