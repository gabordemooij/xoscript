>> invoice := Objekt ny.
invoice ved: ['start'] gjør: {
        egen tall := 0.
}.

invoice ved: ['tall'] gjør: {
        egen tall legg-til: 1. <- egen tall kopier.
}.

>> year-invoice := invoice ny.
year-invoice ved: ['start:'] gjør: { :år
	egen tall := år.
}.

year-invoice start: 202000.
Utdata skriv: year-invoice tall, stop.
Utdata skriv: year-invoice tall, stop.
