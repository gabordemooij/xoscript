>> faktura := Objekt ny.
faktura ved: ['start'] gjør: {
        egen tall := 0.
}.

faktura ved: ['tall'] gjør: {
        egen tall legg-til: 1.
        <- egen tall kopier.
}.

>> årsfaktura := faktura ny.
årsfaktura ved: ['start:'] gjør: { :år
	egen tall := år.
}.

årsfaktura start: 202000.
Utdata skriv: årsfaktura tall, stop.
Utdata skriv: årsfaktura tall, stop.
