

# opprett et 64-bit heltall for nøyaktige beregninger
>> a := Int64 fra-tekst: ['123'].

# til tekst
Utdata skriv: a, stop.

# del
Utdata skriv: a / (Int64 fra-tekst: ['3']), stop.

# multipliser
Utdata skriv: a * (Int64 fra-tekst: ['2']), stop.

# legg til
Utdata skriv: a + (Int64 fra-tekst: ['1']), stop.

# trekk fra
Utdata skriv: a - (Int64 fra-tekst: ['2']), stop.

# sammenlign
Utdata skriv: ( a =   (Int64 fra-tekst: ['123'])), stop.
Utdata skriv: ( a !=: (Int64 fra-tekst: ['124'])), stop.
Utdata skriv: ( a <   (Int64 fra-tekst: ['124'])), stop.
Utdata skriv: ( a >   (Int64 fra-tekst: ['122'])), stop.
Utdata skriv: ( a >=: (Int64 fra-tekst: ['123'])), stop.
Utdata skriv: ( a <=: (Int64 fra-tekst: ['123'])), stop.





	