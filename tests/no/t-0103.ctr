>> a := Liste ← Objekt ; Sann ; Falsk ; Boolsk ; 1 ; Tall ; ['Str'] ; Tekst ; { ['Empty']. }.
Utdata skriv: (a antall), stop.
{ :i
	Utdata skriv: 
	['a '] + 
	((a ? i) type) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Ingenting?) enten: [''] eller: ['NOT']) + 
	[' Nil.'],
	stop.
} × (a antall).
Utdata skriv: ['but.. Nil is.. '] + ((Ingenting Ingenting?) enten: ['certainly NIL!'] eller: ['not NIL??']), stop.