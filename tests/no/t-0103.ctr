>> a := Liste ← Objekt ; Sann ; Falsk ; Boolsk ; 1 ; Tall ; ['Str'] ; Tekst ; { ['Tomt']. }.
Utdata skriv: (a antall), stop.
{ :i
	Utdata skriv: 
	['a '] + 
	((a ? i) type) +
	([' \‘this\’ '] this: (a ? i))  +
	[' er '] +
	(((a ? i) Ingenting?) enten: [''] eller: ['IKKE']) + 
	[' Ingenting.'],
	stop.
} × (a antall).
Utdata skriv: ['men.. Ingenting er.. '] + ((Ingenting Ingenting?) enten: ['helt sikkert INGENTING!'] eller: ['ikke INGENTING??']), stop.