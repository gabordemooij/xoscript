# test url parsing

Server init.
>> url := URL fra: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Utdata skriv: ['scheme = '] + url skjema, stop.
Utdata skriv: ['host = '] + url vert, stop.
Utdata skriv: ['port = '] + url port, stop.
Utdata skriv: ['path = '] + url sti, stop.
Utdata skriv: ['query = '] + url søkeparametere, stop.
Utdata skriv: ['fragment = '] + url fragment, stop.
