# test url-parsing

Server init.
>> url := URL fra: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Utdata skriv: ['skjema = '] + url skjema, stop.
Utdata skriv: ['vert = '] + url vert, stop.
Utdata skriv: ['port = '] + url port, stop.
Utdata skriv: ['sti = '] + url sti, stop.
Utdata skriv: ['spørring = '] + url søkeparametere, stop.
Utdata skriv: ['fragment = '] + url fragment, stop.
