#Linux
>> OS := Program innstilling: ['OS'].

>> klokke := Moment ny.
	
(OS = ['Haiku']) sann: {
	klokke sone: ['CET'],
	år: 2017, måned: 7, dag: 13,
	time: 18, minutt: 0, sekund: 0.
}, ellers: {
	klokke sone: ['Europe/Amsterdam'],
	år: 2017, måned: 7, dag: 13,
	time: 18, minutt: 0, sekund: 0.
}.

klokke ved: ['fortell'] gjør: {
	Utdata skriv: selv, stop.
}.


klokke legg-til: 2    time, fortell.
klokke legg-til: 1    time, fortell.
klokke legg-til: 19 minutt, fortell.
klokke legg-til: 1  minutt, fortell.
klokke legg-til: 1  minutt, fortell.
klokke legg-til: 19 sekund, fortell.
klokke legg-til: 1  sekund, fortell.
klokke legg-til: 1  sekund, fortell.
klokke legg-til: 2    år, fortell.
klokke legg-til: 1    år, fortell.

(OS = ['Haiku']) sann: {
klokke legg-til: 5   måned.
klokke sone: ['CEST'], fortell.
}, ellers: {
	klokke legg-til: 5   måned, fortell.
}.

klokke legg-til: 1   måned, fortell.
klokke legg-til: 19    dag, fortell.
klokke legg-til: 1    time, fortell.
klokke legg-til: 120  yard, fortell.
