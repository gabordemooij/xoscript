#Linux
>> OS := Program innstilling: ['OS'].

>> clock := Moment ny.
	
(OS = ['Haiku']) sann: {
	clock sone: ['CET'],
	år: 2017, måned: 7, dag: 13,
	time: 18, minutt: 0, sekund: 0.
}, ellers: {
	clock sone: ['Europe/Amsterdam'],
	år: 2017, måned: 7, dag: 13,
	time: 18, minutt: 0, sekund: 0.
}.

clock ved: ['tell'] gjør: {
	Utdata skriv: selv, stop.
}.


clock legg-til: 2    time, tell.
clock legg-til: 1    time, tell.
clock legg-til: 19 minutt, tell.
clock legg-til: 1  minutt, tell.
clock legg-til: 1  minutt, tell.
clock legg-til: 19 sekund, tell.
clock legg-til: 1  sekund, tell.
clock legg-til: 1  sekund, tell.
clock legg-til: 2    år, tell.
clock legg-til: 1    år, tell.

(OS = ['Haiku']) sann: {
clock legg-til: 5   måned.
clock sone: ['CEST'], tell.
}, ellers: {
	clock legg-til: 5   måned, tell.
}.

clock legg-til: 1   måned, tell.
clock legg-til: 19    dag, tell.
clock legg-til: 1    time, tell.
clock legg-til: 120  yard, tell.
