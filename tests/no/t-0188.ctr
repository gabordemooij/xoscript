

>> bruktMinne1 := 0.
>> bruktMinne2 := 0.
>> bruktMinne3 := 0.
>> bruktMinne4 := 0.

Program minnehåndtering: 0.

{ :i Utdata skriv: i. } × 4.
Utdata stop.
{ :i Utdata skriv: (4 - i). } × 4.
Utdata stop.
( 1 > 2 ) falsk: { Utdata skriv: ['BLOKK 1'], stop. }.
( 2 > 1 ) sann:  { Utdata skriv: ['BLOKK 2'], stop. }.

>> i := 0.
{ Utdata skriv: i. i legg-til: 1. } mens: { <- ( i < 3). }.
Utdata stop.

i := 3.
{ Utdata skriv: i. i := i - 1. } mens: { <- ( i > 0). }.
Utdata stop.


Program rydd-opp.

bruktMinne1 := (Program minne ? 0).


{ :i  Utdata skriv: i. } × 4.
Utdata stop.
{ :i  Utdata skriv: (4 - i). } × 4.
Utdata stop.
( 1 > 2 ) falsk: { Utdata skriv: ['BLOKK 1'], stop. }.
( 2 > 1 ) sann:  { Utdata skriv: ['BLOKK 2'], stop. }.

>> i := 0.
{ Utdata skriv: i. i legg-til: 1. } mens: { <- ( i < 3). }.
Utdata stop.

i := 3.
{ Utdata skriv: i. i := i - 1. } mens: { <- ( i > 0). }.
Utdata stop.



Program rydd-opp.
bruktMinne2 := (Program minne ? 0).


{ :i Utdata skriv: i. } × 4.
Utdata stop.
{ :i Utdata skriv: (4 - i). } × 4.
Utdata stop.
( 1 > 2 ) falsk: { Utdata skriv: ['BLOKK 1'], stop. }.
( 2 > 1 ) sann:  { Utdata skriv: ['BLOKK 2'], stop. }.

>> i := 0.
{ Utdata skriv: i. i legg-til: 1. } mens: { <- ( i < 3). }.
Utdata stop.

i := 3.
{ Utdata skriv: i. i := i - 1. } mens: { <- ( i > 0). }.
Utdata stop.

Program rydd-opp.
bruktMinne3 := (Program minne ? 0).



( bruktMinne1 = bruktMinne2 og: bruktMinne1 = bruktMinne3, og: bruktMinne2 = bruktMinne3 ) sann: {
	Utdata skriv: ['Ingen minnelekkasjer her'].
}, falsk: {
	Utdata skriv: ['Lekker minne...'].
}.
