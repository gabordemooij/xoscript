Server init.

>> DB := Maria-DB ny vert: ['localhost'],
	brukernavn: ['xo'],
	passord: ['pass123'],
	databasenavn: ['xobase'],
	koble-til.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB spørring: SQL.

# now you don't have to set DB
query2 hent: { :row
	Utdata skriv: row world, stop.
}.
