Server init.

>> DB := Maria-DB ny vert: ['localhost'],
	brukernavn: ['xo'],
	passord: ['pass123'],
	databasenavn: ['xobase'],
	koble-til.
	
>> SQL := ['SELECT "hello" AS "world" '].

# en raskere måte, hent spørring fra DB:
>> spørring2 := DB spørring: SQL.

# nå trenger du ikke å sette DB
spørring2 hent: { :rad
	Utdata skriv: rad world, stop.
}.
