

>> bruktMinne1 := 0.
>> bruktMinne2 := 0.
>> bruktMinne3 := 0.
>> bruktMinne4 := 0.

Program minnehåndtering: 0.

Tall ved: ['addNum:'] gjør: { :x
	selv legg-til: x.
}.

Tall ved: ['subtractNum:'] gjør: { :x
	selv trekk-fra: x.
}.

Tall ved: ['multiplyBy:'] gjør: { :x
	selv multipliser-med: x.
}.

Tall ved: ['divideBy:'] gjør: { :x
	selv del-med: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 opphøyd: 8).  
a := a + (2 opphøyd: -1). 
a := a + (49 kvadratrot).   
a addNum: ((Liste ← 0 ; 1) maksimum).          
a addNum: ((Liste ← 2 ; 3) minimum).
Utdata skriv: a.

Program rydd-opp.

bruktMinne1 := (Program minne ? 0).


a := 1.
