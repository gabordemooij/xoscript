a := a + (2 opphøyd: 8).  
a := a + (2 opphøyd: -1). 
a := a + (49 kvadratrot).   
a addNum: ((Liste ← 0 ; 1) maksimum).          
a addNum: ((Liste ← 2 ; 3) minimum).
Utdata skriv: a.

Program rydd-opp.
bruktMinne2 := (Program minne ? 0).


