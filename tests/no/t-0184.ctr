

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program minnehåndtering: 0.

Tall ved: ['addNum:'] gjør: { :x
	selv legg-til: x.
}.

Tall ved: ['subtractNum:'] gjør: { :x
	selv trekk-fra: x.
}.

Tall ved: ['multiplyBy:'] gjør: { :x
	selv multipliser-med: x.
}.

Tall ved: ['divideBy:'] gjør: { :x
	selv del-med: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 opphøyd: 8).  
a := a + (2 opphøyd: -1). 
a := a + (49 kvadratrot).   
a addNum: ((Liste ← 0 ; 1) maksimum).          
a addNum: ((Liste ← 2 ; 3) minimum).
Utdata skriv: a.

Program rydd-opp.

usedMemory1 := (Program minne ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 opphøyd: 8).  
a := a + (2 opphøyd: -1). 
a := a + (49 kvadratrot).   
a addNum: ((Liste ← 0 ; 1) maksimum).          
a addNum: ((Liste ← 2 ; 3) minimum).
Utdata skriv: a.

Program rydd-opp.
usedMemory2 := (Program minne ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 opphøyd: 8).  
a := a + (2 opphøyd: -1). 
a := a + (49 kvadratrot).   
a addNum: ((Liste ← 0 ; 1) maksimum).          
a addNum: ((Liste ← 2 ; 3) minimum).
Utdata skriv: a.

Program rydd-opp.
usedMemory3 := (Program minne ? 0).



( usedMemory1 = usedMemory2 og: usedMemory1 = usedMemory3, og: usedMemory2 = usedMemory3 ) sann: {
	Utdata skriv: ['No memory leaks here'].
}, falsk: {
	Utdata skriv: ['Leaking memory...'].
}.
