#Linux
>> klokke := Moment ny.
klokke sone: ['UTC-1'].
klokke år: 1981, måned: 1, dag: 5,
      time: 13, minutt: 15, sekund: 13.

Utdata skriv: klokke, stop.
klokke sone: ['UTC+0'].

Utdata skriv: (
	(klokke år rå) + ['-'] + (klokke måned) + ['-'] + (klokke dag) + [' '] +
	(klokke time) + [':'] + (klokke minutt) + [':'] + (klokke sekund) + [' '] +
	['W'] + (klokke uke) + (klokke sone)
), stop.


klokke sone: ['UTC-1'].
Utdata skriv: (
	(klokke år rå) + ['-'] + (klokke måned) + ['-'] + (klokke dag) + [' '] +
	(klokke time) + [':'] + (klokke minutt) + [':'] + (klokke sekund) + [' '] +
	['W'] + (klokke uke) + (klokke sone)
), stop.
