#Linux
>> clock := Moment ny.
clock sone: ['UTC-1'].
clock år: 1981, måned: 1, dag: 5,
      time: 13, minutt: 15, sekund: 13.

Utdata skriv: clock, stop.
clock sone: ['UTC+0'].

Utdata skriv: (
	(clock år rå) + ['-'] + (clock måned) + ['-'] + (clock dag) + [' '] +
	(clock time) + [':'] + (clock minutt) + [':'] + (clock sekund) + [' '] +
	['W'] + (clock uke) + (clock sone)
), stop.


clock sone: ['UTC-1'].
Utdata skriv: (
	(clock år rå) + ['-'] + (clock måned) + ['-'] + (clock dag) + [' '] +
	(clock time) + [':'] + (clock minutt) + [':'] + (clock sekund) + [' '] +
	['W'] + (clock uke) + (clock sone)
), stop.
