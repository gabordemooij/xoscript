

>> obj := Objekt ny.

obj ved: ['greet'] gjør: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj ved: ['task'] gjør: {
	egen property := 123.
	{
		# try binds self/own to object instead of block
		Utdata skriv: selv greet.
		Utdata skriv: egen property.
		1 / 0.
	} fang: {
		Utdata skriv: selv greet.
		Utdata skriv: egen property.
		Utdata skriv: ['ok'].
	}, prøv.
}.

obj task.