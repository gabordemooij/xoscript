

>> obj := Objekt ny.

obj ved: ['hils'] gjør: {
	<- ['hei'].
}.

# skal skrive ut hi123hi123ok
obj ved: ['oppgave'] gjør: {
	egen egenskap := 123.
	{
		# prøv binder selv/egen til objektet i stedet for blokken
		Utdata skriv: selv hils.
		Utdata skriv: egen egenskap.
		1 / 0.
	} fang: {
		Utdata skriv: selv hils.
		Utdata skriv: egen egenskap.
		Utdata skriv: ['ok'].
	}, prøv.
}.

obj oppgave.