>> x := [' hallo '].

>> y := x store-bokstaver.
Utdata skriv: x, stop.
Utdata skriv: (x er-lik: y), stop.

>> y := x små-bokstaver.
Utdata skriv: x, stop.
Utdata skriv: (x er-lik: y), stop.

>> y := x trim.
Utdata skriv: x, stop.
Utdata skriv: (x er-lik: y), stop.

>> y := x offset: 1.
Utdata skriv: x, stop.
Utdata skriv: (x er-lik: y), stop.

>> y := x fra: 1 lengde: 2.
Utdata skriv: x, stop.
Utdata skriv: (x er-lik: y), stop.