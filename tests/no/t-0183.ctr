

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program minnehåndtering: 0.

>> o := Objekt ny.
>> o2 := Objekt ny.
Utdata skriv: o Ingenting?, stop.
Utdata skriv: o type, stop.
Utdata skriv: ( o er-lik: o ), stop.
Utdata skriv: ( o er-lik: o2 ), stop.
Utdata skriv: o meg-selv, stop.
Utdata skriv: ( o gjør ferdig ), stop.

Program rydd-opp.

usedMemory1 := (Program minne ? 0).


o := Objekt ny.
o2 := Objekt ny.
Utdata skriv: o Ingenting?, stop.
Utdata skriv: o type, stop.
Utdata skriv: ( o er-lik: o ), stop.
Utdata skriv: ( o er-lik: o2 ), stop.
Utdata skriv: o meg-selv, stop.
Utdata skriv: ( o gjør ferdig ), stop.

Program rydd-opp.
usedMemory2 := (Program minne ? 0).


o := Objekt ny.
o2 := Objekt ny.
Utdata skriv: o Ingenting?, stop.
Utdata skriv: o type, stop.
Utdata skriv: ( o er-lik: o ), stop.
Utdata skriv: ( o er-lik: o2 ), stop.
Utdata skriv: o meg-selv, stop.
Utdata skriv: ( o gjør ferdig ), stop.

Program rydd-opp.
usedMemory3 := (Program minne ? 0).



( usedMemory1 = usedMemory2 og: usedMemory1 = usedMemory3, og: usedMemory2 = usedMemory3 ) sann: {
	Utdata skriv: ['No memory leaks here'].
}, falsk: {
	Utdata skriv: ['Leaking memory...'].
}.
