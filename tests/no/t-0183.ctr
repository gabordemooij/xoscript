

>> bruktMinne1 := 0.
>> bruktMinne2 := 0.
>> bruktMinne3 := 0.
>> bruktMinne4 := 0.

Program minnehåndtering: 0.

>> o := Objekt ny.
>> o2 := Objekt ny.
Utdata skriv: o Ingenting?, stop.
Utdata skriv: o type, stop.
Utdata skriv: ( o er-lik: o ), stop.
Utdata skriv: ( o er-lik: o2 ), stop.
Utdata skriv: o meg-selv, stop.
Utdata skriv: ( o gjør ferdig ), stop.

Program rydd-opp.

bruktMinne1 := (Program minne ? 0).


o := Objekt ny.
o2 := Objekt ny.
Utdata skriv: o Ingenting?, stop.
Utdata skriv: o type, stop.
Utdata skriv: ( o er-lik: o ), stop.
Utdata skriv: ( o er-lik: o2 ), stop.
Utdata skriv: o meg-selv, stop.
Utdata skriv: ( o gjør ferdig ), stop.

Program rydd-opp.
bruktMinne2 := (Program minne ? 0).


o := Objekt ny.
o2 := Objekt ny.
Utdata skriv: o Ingenting?, stop.
Utdata skriv: o type, stop.
Utdata skriv: ( o er-lik: o ), stop.
Utdata skriv: ( o er-lik: o2 ), stop.
Utdata skriv: o meg-selv, stop.
Utdata skriv: ( o gjør ferdig ), stop.

Program rydd-opp.
bruktMinne3 := (Program minne ? 0).



( bruktMinne1 = bruktMinne2 og: bruktMinne1 = bruktMinne3, og: bruktMinne2 = bruktMinne3 ) sann: {
	Utdata skriv: ['Ingen minnelekkasjer her'].
}, falsk: {
	Utdata skriv: ['Lekker minne...'].
}.
