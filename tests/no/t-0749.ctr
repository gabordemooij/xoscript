Utdata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gjør: { :boolsk
	egen boolsk := boolsk. 
}.

a ved: ['vare'] gjør: {
	<- egen boolsk.
}.

a item: Falsk.

Utdata skriv: a vare, stop.

>> gammel-bool-adresse := a vare prototype minneadresse.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== LASTER INN SNAP PÅ NYTT:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b vare prototype minneadresse = gammel-bool-adresse) sann: {
	Utdata skriv: ['Objektlenke koblet til igjen.'], stop.
}.

Utdata skriv: b vare, stop.
