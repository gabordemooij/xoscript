>> x := Objekt ny.
>> y := Objekt ny.
>> z := x.
Utdata skriv: (x = z), stop.
Utdata skriv: (x = y), stop.
Utdata skriv: (x ≠ y), stop.
Utdata skriv: (x ≠ z), stop.
>> m := Moment ny år: 2070, måned: 11.
>> n := m kopier.
Utdata skriv: (m = n), stop.
Utdata skriv: (m ≠ n), stop.
Utdata skriv: (m er-lik: m), stop.
Utdata skriv: (m er-lik: n), stop.
n måned: 12.
Utdata skriv: (m ≠ n), stop.
Utdata skriv: (m = n), stop.


