# a value ending in the first part of an opening quote must survive serialization
>> verdier := Liste ny
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

verdier hver: { :i :value
	>> d := Ordbok ny.
	d sett: value ved: ['k'].
	d sett: ['second'] ved: ['j'].
	>> r := d code objekt.
	Utdata skriv: r antall, stop.
	Utdata skriv: ( (r ved: ['k']) = value ), stop.
}.
