>> numbers := ['1,2,3'] del: [','].
Utdata skriv: ['I got: '] + numbers antall + [' numbers.'],stop.
{ :i Utdata skriv: ['number #'] + i + [':'] + (numbers posisjon: i), stop.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages del: [' Or '].
Utdata skriv: ['We serve'], stop.
{ :i Utdata skriv: ['->'] + (beverages posisjon: i), stop. } × (beverages antall).
Utdata skriv: (beverages slå-sammen: [',']), stop.
Utdata skriv: (numbers slå-sammen: ['||']).
