>> tallene := ['1,2,3'] del: [','].
Utdata skriv: ['Jeg fikk: '] + tallene antall + [' tall.'],stop.
{ :i Utdata skriv: ['number #'] + i + [':'] + (tallene posisjon: i), stop.} × 3.
>> drikker := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
drikker := drikker del: [' Or '].
Utdata skriv: ['Vi serverer'], stop.
{ :i Utdata skriv: ['->'] + (drikker posisjon: i), stop. } × (drikker antall).
Utdata skriv: (drikker slå-sammen: [',']), stop.
Utdata skriv: (tallene slå-sammen: ['||']).
