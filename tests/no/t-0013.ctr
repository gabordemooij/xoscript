
>> Animal := Objekt ny.
Animal ved: ['ny'] gjør: { <- selv ny init.
}.

Animal ved: ['init'] gjør: {
	egen sound := ['?'].
	egen legs := 4.
}.

>> Dog := Animal ny.
Dog ved: ['init'] gjør: {
	selv init.
	egen sound := ['barks'].
}.

Animal ved: ['tekst'] gjør: { <- egen legs tekst + egen sound.
}.

>> poodle := Dog ny.
Utdata skriv: poodle, stop.

