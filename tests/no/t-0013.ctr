
>> Dyr := Objekt ny.
Dyr ved: ['ny'] gjør: {
	<- selv ny init.
}.

Dyr ved: ['init'] gjør: {
	egen lyd := ['?'].
	egen bein  := 4.
}.

>> Hund := Dyr ny.
Hund ved: ['init'] gjør: {
	selv init.
	egen lyd := ['bjeffer'].
}.

Dyr ved: ['tekst'] gjør: {
	<- egen bein tekst + egen lyd.
}.

>> puddel := Hund ny.
Utdata skriv: puddel, stop.

