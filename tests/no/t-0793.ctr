Server init.

>> DB := Maria-DB ny vert: ['localhost'],
	brukernavn: ['xo'],
	passord: ['pass123'],
	databasenavn: ['xobase'],
	koble-til.

{
	DB spørring:
	['DROP TABLE movies'],
	utfør.
} fang: { Ingenting. }, start.

DB spørring:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
utfør.

DB spørring: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parametere: ( Liste ny ; ['Halloween'] ),
utfør.

DB spørring: ['SELECT * FROM movies'],
hent: { :movie
	Utdata skriv: movie title, stop.
}.

