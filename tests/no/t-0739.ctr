Utdata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gjør: { :binhjelper
	egen binhjelper := binhjelper. 
}.

a ved: ['vare'] gjør: {
	<- egen binhjelper.
}.

a item: Bin ny.

>> gammel-binhjelper-adresse := a vare prototype minneadresse.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== LASTER INN SNAP PÅ NYTT:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b vare prototype minneadresse = gammel-binhjelper-adresse) sann: {
	Utdata skriv: ['Objektlenke koblet til igjen.'], stop.
}.


