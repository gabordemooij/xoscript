Utdata skriv: ['Test object'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gjør: { :binhelper
	egen binhelper := binhelper. 
}.

a ved: ['item'] gjør: { <- egen binhelper.
}.

a item: Bin ny.

>> old-binhelper-address := a item prototype minneadresse.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== RELOADING SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototype minneadresse = old-binhelper-address) sann: {
	Utdata skriv: ['Object link re-attached.'], stop.
}.


