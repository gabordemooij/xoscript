>> t := Ingenting.

# you can control the time zone for
# parsing like this:
Moment sone: ['CET'].
t := Moment fra: ['1981-02-03 04:05:06'].
Utdata skriv: t, stop.

# now using CEST time zone:
Moment sone: ['CEST'].
t := Moment fra: ['1981-02-03 04:05:06'].
Utdata skriv: t, stop.

# error if string cannot be parsed
{ Moment fra: ['1900']. } fang: { Ingenting. }, start.
