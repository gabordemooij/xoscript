>> t := Ingenting.

# du kan styre tidssonen for
# parsing slik:
Moment sone: ['CET'].
t := Moment fra: ['1981-02-03 04:05:06'].
Utdata skriv: t, stop.

# bruker nå tidssonen CEST:
Moment sone: ['CEST'].
t := Moment fra: ['1981-02-03 04:05:06'].
Utdata skriv: t, stop.

# feil hvis teksten ikke kan parses
{ Moment fra: ['1900']. } fang: { Ingenting. }, start.
