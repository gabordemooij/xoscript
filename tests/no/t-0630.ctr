#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Mønster ny: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern treff: subject gjør: { :m :x
	Utdata skriv: m, stop.
	Utdata skriv: x, stop. <- ['XXX'].
}.
Utdata skriv: result, stop.