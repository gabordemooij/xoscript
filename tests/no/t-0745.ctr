Utdata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gjør: { :ordboka
	egen ordboka := ordboka. 
}.

a ved: ['vare'] gjør: {
	<- egen ordboka.
}.

a item: (
Ordbok ny
	hello: ['world']).

>> gammel-ordbok-adresse := a vare prototype minneadresse.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== LASTER INN SNAP PÅ NYTT:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b vare prototype minneadresse = gammel-ordbok-adresse) sann: {
	Utdata skriv: ['Objektlenke koblet til igjen.'], stop.
}.

Utdata skriv: b vare, stop.
