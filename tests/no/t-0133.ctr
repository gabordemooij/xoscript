


>> Kortstokk := Liste ny.
Kortstokk ved: ['skrivUt'] gjør: {
        >> len := selv antall - 1.
        { :i
                >> lgd2 := selv antall - 1.
                Utdata skriv: ['lgd: '].
                Utdata skriv: len, stop.
                Utdata skriv: ['lgd2: '].
                Utdata skriv: lgd2, stop.
        } × len.
}.

>> d := Kortstokk ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d skrivUt.
