


>> Deck := Liste ny.
Deck ved: ['print'] gjør: {
        >> len := selv antall - 1.
        { :i
                >> len2 := selv antall - 1.
                Utdata skriv: ['len: '].
                Utdata skriv: len, stop.
                Utdata skriv: ['len2: '].
                Utdata skriv: len2, stop.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
