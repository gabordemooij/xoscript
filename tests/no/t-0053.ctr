60 × {
	>> x := (Tall tilfeldig % 6) + 1.
	(x ≤ 6) falsk: { Utdata skriv: ['FEIL']. }.
	(x ≥0) falsk: { Utdata skriv: ['FEIL']. }.
	x := (Tall tilfeldig % 3) + 1.
	(x < 3) falsk: { Utdata skriv: ['FEIL']. }.
	(x>-1) falsk: { Utdata skriv: ['FEIL']. }.
	x := ((Boolsk vend) tall).
	(x = 0 eller: x = 1) falsk: { Utdata skriv: ['FEIL']. }.
	x := ((Sann vend) tall).
	(x = 0 eller: x = 1) falsk: { Utdata skriv: ['FEIL']. }.
	x := (Boolsk vend enten: ['KRONE'] eller: ['MYNT']).
	((x = ['KRONE']) eller: (x = ['MYNT'])) falsk: { Utdata skriv: ['FEIL']. }.
}.
Utdata skriv: ['FERDIG'].

