60 × {
	>> x := (Tall random % 6) + 1.
	(x ≤ 6) falsk: { Utdata skriv: ['FAIL']. }.
	(x ≥0) falsk: { Utdata skriv: ['FAIL']. }.
	x := (Tall random % 3) + 1.
	(x < 3) falsk: { Utdata skriv: ['FAIL']. }.
	(x>-1) falsk: { Utdata skriv: ['FAIL']. }.
	x := ((Boolsk flip) tall).
	(x = 0 eller: x = 1) falsk: { Utdata skriv: ['FAIL']. }.
	x := ((Sann flip) tall).
	(x = 0 eller: x = 1) falsk: { Utdata skriv: ['FAIL']. }.
	x := (Boolsk flip enten: ['HEAD'] eller: ['TAIL']).
	((x = ['HEAD']) eller: (x = ['TAIL'])) falsk: { Utdata skriv: ['FAIL']. }.
}.
Utdata skriv: ['DONE'].

