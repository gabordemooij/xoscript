>> Slurp := Objekt ny.

Slurp ved: ['ny'] gjør: {
	egen str := [''].
}.

Slurp ved: ['svar:'] gjør: { :blah
		(egen str = ['']) sann: {
			egen str legg-til-sist: blah.
		}, ellers: {
			egen str legg-til-sist: [' '].
			egen str legg-til-sist: blah.
		}.
}.

Slurp ved: ['svar:og:'] gjør: { :blah :blahah
		(blah lengde > 1) sann: {
			egen str legg-til-sist: (blah fra: 0 lengde: (blah lengde - 1)).
		}, ellers: {
			egen str legg-til-sist: blah.
		}.
		egen str legg-til-sist: [' '].
		egen str legg-til-sist: blahah.
}.

Slurp ved: ['skaff'] gjør: {
	>> buffer := egen str.
	egen str := ['']. <- buffer.
}.


>> x := Slurp ny.
x + 3.
Utdata skriv: (x skaff), stop.
x echo: ['Hei, verden'].
Utdata skriv: (x skaff), stop.
x tellme: 123 and: 987.
Utdata skriv: (x skaff), stop.
