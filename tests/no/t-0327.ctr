

Liste ved: ['fixture:'] gjør: { :f
	egen fixture := f.
}.

Liste ved: ['antall'] gjør: { <- egen fixture.
}.

Liste ved: ['aantal'] gjør: { <- egen fixture.
}.


>> x := Ingenting.
{

	x := ['hello'] 
	erstatt:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] tegn: 2)
			)
		)
	med: (
		(['...hal'] + ['lo']) 
			store-bokstaver 
			lowecase 
			store-bokstaver 
			offset: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Liste ← 0 ; 1 ; 4; 9 ; (Liste ← 0 ; 3; 1) ; 4
							) nest-siste
						) ? 1
					) + 
					((Liste ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					antall
				)
			)
	).

} × 10.
Utdata skriv: x, stop.

