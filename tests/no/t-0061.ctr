>> a := ['hello'].
>> b := ['hello'].
>> z := a.
>> c := Ingenting.
>> q := Objekt ny.
>> p := q.
(a er-lik: a) sann: { Utdata skriv: ['Y1']. }.
(a er-lik: b) sann: { Utdata skriv: ['Y2']. }.
(a er-lik: c) sann: { Utdata skriv: ['Y3']. }.
(a er-lik: z) sann: { Utdata skriv: ['Y4']. }.
(z er-lik: a) sann: { Utdata skriv: ['Y5']. }.
(q er-lik: q) sann: { Utdata skriv: ['Y6']. }.
(p er-lik: q) sann: { Utdata skriv: ['Y7']. }.
(p er-lik: a) sann: { Utdata skriv: ['Y8']. }.
(p er-lik: Ingenting) sann: { Utdata skriv: ['Y9']. }.
