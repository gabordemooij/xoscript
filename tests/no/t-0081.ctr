>> map1 := Ordbok ny.
>> key1 := Liste ny.
>> key2 := Liste ny.

map1
	sett: ['hello'] ved: key1,
	sett: ['world'] ved: key2.


Utdata
	skriv: ['Map #1 contains: '] + (map1 ved: key1),
	skriv: [' and '] + (map1 ved: key2), stop.

>> KeyeableArray := Liste ny.
KeyeableArray ved: ['toString'] gjør: { <- (selv antall) toString.
}.

>> map2 := Ordbok ny.
key1 := KeyeableArray ny.
key2 := KeyeableArray ny.

key1 legg-til-sist: 1.

map2
	sett: ['hello'] ved: key1,
	sett: ['world'] ved: key2.

Utdata
	skriv: ['Map #2 contains: '] + (map2 ved: key1),
	skriv: [' and '] + (map2 ved: key2), stop.
