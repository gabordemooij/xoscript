>> tabell1 := Ordbok ny.
>> nøkkel1 := Liste ny.
>> nøkkel2 := Liste ny.

tabell1
	sett: ['hello'] ved: nøkkel1,
	sett: ['world'] ved: nøkkel2.


Utdata
	skriv: ['Map #1 contains: '] + (tabell1 ved: nøkkel1),
	skriv: [' og '] + (tabell1 ved: nøkkel2), stop.

>> NøkkelListe := Liste ny.
NøkkelListe ved: ['tilTekst'] gjør: { <- (selv antall) tilTekst.
}.

>> map2 := Ordbok ny.
nøkkel1 := NøkkelListe ny.
nøkkel2 := NøkkelListe ny.

nøkkel1 legg-til-sist: 1.

map2
	sett: ['hello'] ved: nøkkel1,
	sett: ['world'] ved: nøkkel2.

Utdata
	skriv: ['Map #2 contains: '] + (map2 ved: nøkkel1),
	skriv: [' og '] + (map2 ved: nøkkel2), stop.
