
Tekst ved: ['html'] gjør: { <- (
		selv
		erstatt: ['&'] med: ['&amp;'],
		erstatt: ['<'] med: ['&lt;'],
		erstatt: ['>'] med: ['&gt;'],
		erstatt: ['"'] med: ['&quot;']
	).
}.

>> HtmlPensel := Objekt ny.

HtmlPensel ved: ['svar:'] gjør: { :tagg
	Utdata skriv: (['<tag>↵'] tag: tagg ).
}.

HtmlPensel ved: ['svar:og:'] gjør: { :tagg :content
	tagg := ( tagg fra: 0 lengde: (tagg lengde - 1) ).
	Utdata skriv: (['<tag content>↵'] tag: tagg, content: content).
}.

HtmlPensel ved: ['content:'] gjør: { :tekstbit
	Utdata skriv: tekstbit html, stop.
}.

HtmlPensel ved: ['attr:verdi:'] gjør: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlPensel ny.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] verdi: ['bold']),
		/span
	/body
/html.
		
