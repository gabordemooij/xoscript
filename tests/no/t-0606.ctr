>> Point := Objekt ny.
Point ved: ['x-coordinate:'] gjør: { :x egen x := x. }.
Point ved: ['y-coordinate:'] gjør: { :y egen y := y. }.
Point ved: ['x-coordinate']  gjør: { <- egen x kopier. }.
Point ved: ['y-coordinate']  gjør: { <- egen y kopier. }.

Point ved: ['='] gjør: { :other <- ( egen x = other x-coordinate
		 og: egen y = other y-coordinate ).
}.

>> pier := Point ny x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point ny x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point ny x-coordinate: 5, y-coordinate: 6.

Utdata skriv: pier = town-hall, stop.
Utdata skriv: pier = restaurant, stop.
