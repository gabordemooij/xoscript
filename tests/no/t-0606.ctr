>> Punkt := Objekt ny.
Punkt ved: ['x-coordinate:'] gjør: { :x egen x := x. }.
Punkt ved: ['y-coordinate:'] gjør: { :y egen y := y. }.
Punkt ved: ['x-koordinat']  gjør: { <- egen x kopier. }.
Punkt ved: ['y-koordinat']  gjør: { <- egen y kopier. }.

Punkt ved: ['='] gjør: { :annen
	<- ( egen x = annen x-koordinat
		 og: egen y = annen y-koordinat ).
}.

>> brygge := Punkt ny x-coordinate: 5, y-coordinate: 6.
>> rådhus := Punkt ny x-coordinate: 7, y-coordinate: 1.
>> restaurant := Punkt ny x-coordinate: 5, y-coordinate: 6.

Utdata skriv: brygge = rådhus, stop.
Utdata skriv: brygge = restaurant, stop.
