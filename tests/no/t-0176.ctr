

>> bruktMinne1 := 0.
>> bruktMinne2 := 0.
>> bruktMinne3 := 0.
>> bruktMinne4 := 0.

Program minnehåndtering: 0.

>> txt := ['Word Salad'].
Utdata skriv: ['Tekstlengde: '] + txt lengde, stop.
Utdata skriv: ['Tegn ved 2:'] + ( txt tegn: 2 ), stop.
Utdata skriv: (( txt finn: ['S'] ) - 0), stop.

Program rydd-opp.

bruktMinne1 := (Program minne ? 0).


txt := ['Word Salad'].
Utdata skriv: ['Tekstlengde: '] + txt lengde, stop.
Utdata skriv: ['Tegn ved 2:'] + ( txt tegn: 2 ), stop.
Utdata skriv: (( txt finn: ['S'] ) - 0), stop.

Program rydd-opp.
bruktMinne2 := (Program minne ? 0).


txt := ['Word Salad'].
Utdata skriv: ['Tekstlengde: '] + txt lengde, stop.
Utdata skriv: ['Tegn ved 2:'] + ( txt tegn: 2 ), stop.
Utdata skriv: (( txt finn: ['S'] ) - 0), stop.

Program rydd-opp.
bruktMinne3 := (Program minne ? 0).



( bruktMinne1 = bruktMinne2 og: bruktMinne1 = bruktMinne3, og: bruktMinne2 = bruktMinne3 ) sann: {
	Utdata skriv: ['Ingen minnelekkasjer her'].
}, falsk: {
	Utdata skriv: ['Lekker minne...'].
}.
