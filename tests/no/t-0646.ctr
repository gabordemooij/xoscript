Server init.
Utdata skriv: ['Database-datotidstest'], stop.

>> db := Maria-DB ny vert: ['localhost'],
	brukernavn: ['xo'], 
	passord: ['pass123'],
	databasenavn: ['xobase'],
	koble-til.

>> søkeparametere :=
db spørring: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
hent: { :rad
	Utdata skriv: rad datetimetest, stop.
}.
