# linjeskift i verdier skal ikke lage ekstra hoder
Server initialiser.
Program benytt: ['../../../src/xo/no/webtools.xo'].
Program benytt: ['../../../src/xo/no/mailtools.xo'].

>> hode := HTTP-Hode ny nøkkel: ['Location'] verdi: ['/ok\r\nX-Injected: yes'].
Utdata skriv: hode.

>> web := Webdokument ny.
web gå-til: ['/ok\r\nX-Injected: yes'].
Utdata skriv: ['\n'], stop.

>> brev := E-post ny.
brev til: (Liste ny ; ['a@example.invalid\r\nX-To: yes']).
brev cc: (Liste ny ; ['b@example.invalid\r\nX-Cc: yes']).
brev bcc: (Liste ny ; ['c@example.invalid\r\nX-Bcc: yes']).
brev avsender: ['d@example.invalid\r\nX-From: yes'] navn: ['site\r\nX-Name: yes'].
brev emne: ['hello\r\nX-Subject: yes'].
brev meldingstekst: ['line1\r\nline2'].
Utdata skriv: brev generer.

>> html := HTML-E-post ny.
html til: (Liste ny ; ['a@example.invalid\r\nX-To: yes']).
html avsender: ['d@example.invalid'] navn: ['nettsted'].
html emne: ['hello\r\nX-Subject: yes'].
html meldingstekst: ['body'].
Utdata skriv: ( html generer inneholder: ['\nX-'] ), stop.
Utdata skriv: ( html generer inneholder: ['X-To: yes'] ), stop.
