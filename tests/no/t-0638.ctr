
Server init.
>> rq := HTTP-Forespørsel ny.
Utdata skriv: ['HTTP-GET d[]=']  + ( rq get-liste: ['d[]'] ), stop. # GET
Utdata skriv: ['HTTP-GET f[]=']  + ( rq get-liste: ['f[]'] ), stop. # GET
Utdata skriv: ['HTTP-POST e[]='] + ( rq post-liste: ['e[]'] ), stop. # GET
Utdata skriv: ['HTTP-POST c=']   + ( rq post: ['c'] ), stop. # GET
Utdata skriv: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), stop. # GET
