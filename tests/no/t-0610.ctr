
>> Rectangle := Objekt ny.

Rectangle ved: ['area'] gjør: { <- egen lengde * egen width.
}.

Rectangle ved: ['length:'] gjør: { :lengde
	egen lengde := lengde.
}.

Rectangle ved: ['width:'] gjør: { :width
	egen width := width.
}.

Rectangle ved: ['ny'] gjør: {
	# this will not result into an infinite loop
	>> rectangle := selv ny.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle ny.
Utdata skriv: a area, stop. #0

>> b := Rectangle ny length: 2, width: 3.
Utdata skriv: b area, stop. #6

