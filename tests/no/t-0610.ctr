
>> Rektangel := Objekt ny.

Rektangel ved: ['areal'] gjør: {
	<- egen lengde * egen bredde.
}.

Rektangel ved: ['length:'] gjør: { :lengde
	egen lengde := lengde.
}.

Rektangel ved: ['width:'] gjør: { :bredde
	egen bredde := bredde.
}.

Rektangel ved: ['ny'] gjør: {
	# dette fører ikke til en uendelig løkke
	>> rektangel := selv ny.
	rektangel length: 0, width: 0.
	<- rektangel.
}.

>> a := Rektangel ny.
Utdata skriv: a areal, stop. #0

>> b := Rektangel ny length: 2, width: 3.
Utdata skriv: b areal, stop. #6

