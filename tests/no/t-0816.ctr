# et format må passe til verdiens type, typen kan komme fra en klient
>> prøv := { :formatet :value
	{ Utdata skriv: ( (Format ny: formatet) bruk: value ), stop. } fang: { :e Utdata skriv: e, stop. }, start.
}.
>> prøv-heltall := { :formatet :value
	{ Utdata skriv: ( (Format ny: formatet) bruk-heltall: value ), stop. } fang: { :e Utdata skriv: e, stop. }, start.
}.

# passer
prøv bruk: ['|%s|'] og: ['text'].
prøv bruk: ['%06.2f'] og: 5.5.
prøv bruk: ['100%% %s'] og: ['sikkert'].
prøv-heltall bruk: ['%03d'] og: 7.
prøv-heltall bruk: ['%x'] og: 255.
prøv bruk: ['%d'] og: (Int64 ny fra-tekst: ['12']).
prøv bruk: ['%lld'] og: (Int64 ny fra-tekst: ['12']).
prøv bruk: ['%.1lf'] og: 5.5.
prøv-heltall bruk: ['%hd'] og: 7.

# passer ikke
prøv bruk: ['%s'] og: 12345.
prøv bruk: ['%d'] og: 12345.
prøv bruk: ['%f'] og: ['text'].
prøv-heltall bruk: ['%d'] og: ['text'].
prøv-heltall bruk: ['%s'] og: 5.
prøv bruk: ['%s %s'] og: ['text'].
prøv bruk: ['%n'] og: ['text'].
prøv bruk: ['%*s'] og: ['text'].
prøv bruk: ['%'] og: ['text'].

# lengdemodifikatoren passer ikke
prøv bruk: ['%ls'] og: ['text'].
prøv bruk: ['%Lf'] og: 5.5.
prøv-heltall bruk: ['%ld'] og: 7.
prøv-heltall bruk: ['%lld'] og: 7.
prøv bruk: ['%Ld'] og: (Int64 ny fra-tekst: ['12']).

# en bredde som ikke passer for printf, skal gi en feil, ikke et krasj
prøv bruk: ['%99999999999s'] og: ['text'].
