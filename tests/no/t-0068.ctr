>> w := ['A_bottle_of_Whisky and a rare steak.'].
Utdata skriv: ['=== Basic test, grab the bottle! ==='], stop.
Utdata skriv: ['>']+(w kopier fra:2 lengde: 6), stop.
Utdata skriv: ['>']+(w kopier fra:8 lengde: -6), stop.
Utdata skriv: ['>']+(w kopier fra:2 lengde: 6), stop.
Utdata skriv: ['>']+(w kopier fra:8 lengde: -6), stop.
Utdata skriv: ['=== Take a single char ==='], stop.
Utdata skriv: ['>']+(w kopier fra:7 lengde: 1), stop.
Utdata skriv: ['>']+(w kopier fra:7 lengde: 1), stop.
Utdata skriv: ['=== The 0 case, empty string ==='], stop.
Utdata skriv: ['>']+(w kopier fra:7 lengde: 0), stop.
Utdata skriv: ['>']+(w kopier fra:7 lengde: 0), stop.
Utdata skriv: ['=== Edge case, first character only ==='], stop.
Utdata skriv: ['>']+(w kopier fra:0 lengde: 1), stop.
Utdata skriv: ['>']+(w kopier fra:0 lengde: 1), stop.
Utdata skriv: ['>']+(w kopier fra:1 lengde: -1), stop.
Utdata skriv: ['>']+(w kopier fra:1 lengde: -1), stop.
Utdata skriv: ['=== Edge case, last character only ==='], stop.
Utdata skriv: ['>']+(w kopier fra:35 lengde: 1), stop.
Utdata skriv: ['>']+(w kopier fra:35 lengde: 1), stop.
Utdata skriv: ['>']+(w kopier fra:36 lengde: -1), stop.
Utdata skriv: ['>']+(w kopier fra:36 lengde: -1), stop.
Utdata skriv: ['=== Out of bounds, empty string ==='], stop.
Utdata skriv: ['>']+(w kopier fra:36 lengde: 37), stop.
Utdata skriv: ['>']+(w kopier fra:36 lengde: 47), stop.
Utdata skriv: ['>']+(w kopier fra:-1 lengde: -2), stop.
Utdata skriv: ['>']+(w kopier fra:-2 lengde: -1), stop.
Utdata skriv: ['=== Part out of bounds, full string ==='], stop.
Utdata skriv: ['>']+(w kopier fra:-20 lengde: 90), stop.
Utdata skriv: ['>']+(w kopier fra:90 lengde: -20), stop.
Utdata skriv: ['>']+(w kopier fra:-20 lengde: 90), stop.
Utdata skriv: ['>']+(w kopier fra:90 lengde: -120), stop.
