Utdata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 

a ved: ['state:'] gjør: { :list
	egen list := list. 
}.

a ved: ['tilstand'] gjør: {
	Utdata skriv: egen list, stop.
}.

a state: ( Liste ny ; ['listeelement'] ; ['element2'] ).
a tilstand.

a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== LASTER INN SNAP PÅ NYTT:'], stop.
>> b := Objekt load-from: ['/tmp/a.bin'].
b tilstand.