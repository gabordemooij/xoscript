Server init.

# skriv en testfil
>> f := Fil ny: ['/tmp/test.gif'].
f skriv: ['GIF87a01234567810'].

# server filen
Server videresend: ['test.gif'] prefiks: ['/tmp/'].

Utdata stop.

Utdata skriv: ['Utenfor containeren (sikkerhet):'], stop.
{ Server videresend: ['../passwd'] prefiks: ['/tmp/']. }
fang: { :e Utdata skriv: e, stop. },
start.

Utdata skriv: ['Ugyldig prefiks:'], stop.
{ Server videresend: ['test.gif'] prefiks: ['z:\\']. }
fang: { :e Utdata skriv: e, stop. },
start.

Utdata skriv: ['Ikke-eksisterende fil:'], stop.
{ Server videresend: ['xxx.xxx'] prefiks: ['/tmp/']. }
fang: { :e Utdata skriv: e, stop. },
start.
