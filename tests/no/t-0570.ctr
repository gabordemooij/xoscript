#Linux

 >> t := Moment ny.
 
t sone: ['Europe/Amsterdam'].
t år: 2020, måned: 8, dag: 2, time: 21, minutt: 2, sekund: 1.

>> a := t time.
>> ams := t sone.

t sone: ['US/Hawaii'].
>> b := t time.
>> hw := t sone.

Utdata
skriv: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		enten: ['later'] eller: ['earlier']
	)
),
stop.
 