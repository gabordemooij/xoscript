Utdata skriv: ['Testobjekt'], stop.
>> hilser := Objekt ny.
hilser ved: ['name:'] gjør: { :navn
	egen xnavn := navn. 
}.
hilser ved: ['hils'] gjør: {
	Utdata skriv: ['Hei '] + egen xnavn, stop.
}.
hilser name: ['Sherlock'].
hilser save-as: ['/tmp/a.bin'].
hilser save-as: ['/tmp/b.bin'].
Utdata skriv: ['========== LASTER INN SNAP PÅ NYTT:'], stop.
>> b := Objekt load-from: ['/tmp/a.bin'].
>> c := Objekt load-from: ['/tmp/b.bin'].
b hils.
b name: ['Watson'], hils.
c name: ['Moriarty'], hils.
