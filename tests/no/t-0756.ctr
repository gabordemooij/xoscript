Utdata skriv: ['Test object'], stop.
>> greeter := Objekt ny.
greeter ved: ['name:'] gjør: { :navn
	egen xname := navn. 
}.
greeter ved: ['greet'] gjør: {
	Utdata skriv: ['Hello '] + egen xname, stop.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Utdata skriv: ['========== RELOADING SNAP:'], stop.
>> b := Objekt load-from: ['/tmp/a.bin'].
>> c := Objekt load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
