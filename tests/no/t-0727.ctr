Server init.
>> f := Format ny: ['%d'].
>> a := Blob ny: 4.
a bytes: ( Liste ny ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob ny: 4.
b bytes: ( Liste ny ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a fra: 0 lengde: 3, hver: { :i :byte
	Utdata skriv: ( f bruk-heltall: byte ) , stop.
}.
a ^ b.
a fra: 0 lengde: 3, hver: { :i :byte
	Utdata skriv: ( f bruk-heltall: byte ) , stop.
}.
a ^ b.
a fra: 0 lengde: 3, hver: { :i :byte
	Utdata skriv: ( f bruk-heltall: byte ) , stop.
}.
a frigjør.
b frigjør.

{ a ^ Objekt. } fang: { :e Utdata skriv: e, stop. }, start.
