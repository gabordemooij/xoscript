Server init.

Utdata skriv: (
	Mønster ny: ['^\\w+$'],
	treff: ['test@example.com'] 
), stop. # 0 match, fails on @ and .

Utdata skriv: (
	Mønster ny: ['^[^@]+@[^\.]+\.\\w+$'],
	treff: ['test@example.com'] 
), stop. # 1 match

Utdata skriv: (
	Mønster ny: ['[^@]+@[^\.]+\.\\w+'],
	treff: ['test@example.com'] 
), stop. # 1 match

Utdata skriv: (
	Mønster ny: ['([^@]+)@([^\.]+)\.\\w+'],
	treff: ['test@example.com'] 
), stop. # 1 match, groups dont matter

Utdata skriv: (
	Mønster ny: ['[a-z]'],
	treff: ['test@example.com'] 
), stop. # 14 matches

Utdata skriv: (
	Mønster ny: ['.*'],
	treff: ['test@example.com'] 
), stop. # 1 match (all)

Utdata skriv: (
	Mønster ny: ['(.*)'],
	treff: ['test@example.com'] 
), stop. # 1 match (all)

Utdata skriv: (
	Mønster ny: ['\\s*[^@]+@[^\.]+\.\\w+'],
	treff: ['test@example.com'] 
), stop. # 1 match, prefix space optional, gets ignored