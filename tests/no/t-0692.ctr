Server init.

Utdata skriv: (
	Mønster ny: ['^\\w+$'],
	treff: ['test@example.com'] 
), stop. # 0 treff, feiler på @ og .

Utdata skriv: (
	Mønster ny: ['^[^@]+@[^\.]+\.\\w+$'],
	treff: ['test@example.com'] 
), stop. # 1 treff

Utdata skriv: (
	Mønster ny: ['[^@]+@[^\.]+\.\\w+'],
	treff: ['test@example.com'] 
), stop. # 1 treff

Utdata skriv: (
	Mønster ny: ['([^@]+)@([^\.]+)\.\\w+'],
	treff: ['test@example.com'] 
), stop. # 1 treff, grupper spiller ingen rolle

Utdata skriv: (
	Mønster ny: ['[a-z]'],
	treff: ['test@example.com'] 
), stop. # 14 treff

Utdata skriv: (
	Mønster ny: ['.*'],
	treff: ['test@example.com'] 
), stop. # 1 treff (alle)

Utdata skriv: (
	Mønster ny: ['(.*)'],
	treff: ['test@example.com'] 
), stop. # 1 treff (alle)

Utdata skriv: (
	Mønster ny: ['\\s*[^@]+@[^\.]+\.\\w+'],
	treff: ['test@example.com'] 
), stop. # 1 treff, mellomrom foran er valgfritt, ignoreres