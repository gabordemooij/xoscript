

>> bruktMinne1 := 0.
>> bruktMinne2 := 0.
>> bruktMinne3 := 0.
>> bruktMinne4 := 0.

Program minnehåndtering: 0.

>> a := -2 absolutt.
a := a atan.
a := a cos.
a := a log.
a := a sin.
a := a tan.


Program rydd-opp.

bruktMinne1 := (Program minne ? 0).


a := -2 absolutt.
a := a atan.
a := a cos.
a := a log.
a := a sin.
a := a tan.


Program rydd-opp.
bruktMinne2 := (Program minne ? 0).


a := -2 absolutt.
a := a atan.
a := a cos.
a := a log.
a := a sin.
a := a tan.


Program rydd-opp.
bruktMinne3 := (Program minne ? 0).



( bruktMinne1 = bruktMinne2 og: bruktMinne1 = bruktMinne3, og: bruktMinne2 = bruktMinne3 ) sann: {
	Utdata skriv: ['Ingen minnelekkasjer her'].
}, falsk: {
