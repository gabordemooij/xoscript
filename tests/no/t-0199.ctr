
Program minnehåndtering: 4.

>> Dyr := Objekt ny.
Dyr ved: ['lag'] gjør: {
	>> dyr := Objekt ny.
	dyr ved: ['lagLyd'] gjør: {
		Utdata skriv: egen lyd.
	}. <- dyr.
}.
>> Katt := Objekt ny.
Katt ved: ['lag'] gjør: {
	>> katt := Dyr lag.
	katt ved: ['init'] gjør: {
		egen lyd := ['meow!'].
	}.
	katt init. <- katt.
}.
>> tom := Katt lag.
tom lagLyd.
