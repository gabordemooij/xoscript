Utdata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gjør: { :øyeblikket
	egen øyeblikket := øyeblikket. 
}.

a ved: ['vare'] gjør: {
	<- egen øyeblikket.
}.

>> idag := Moment ny sone: ['CEST'], år: 2026, måned: 7.
a item: idag.
Utdata skriv: a vare, stop.
a save-as: ['/tmp/a.bin'].

