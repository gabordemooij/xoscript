>> makeAdder := { :x
	>> f := { :y <- (egen x + y). } sett: ['x'] verdi: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i egen q sett: (egen f bruk: (egen q ? i)) ved: i. } 
	sett: ['q'] verdi: array,
	sett: ['f'] verdi: func.
	{ :i mapping bruk: i. } × (array antall).
}.

>> a := Liste ← 1; 2; 3.
mapper bruk: a og: (makeAdder bruk: 100).
Utdata skriv: (a posisjon: 0), stop.
Utdata skriv: (a ? 1), stop.
Utdata skriv: (a ? 2), stop.
