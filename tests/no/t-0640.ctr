
Server init.
Utdata skriv: ['Databasetest'], stop.

>> db := Maria-DB ny vert: ['localhost'],
	brukernavn: ['xo'], 
	passord: ['pass123'],
	databasenavn: ['xobase'],
	koble-til.

>> søkeparametere :=
db spørring: ['SELECT UNHEX('CAFE') AS blobby'],
hent: { :rad
	Utdata skriv: ( rad blobby fra: 0 lengde: 2 ), stop.
	rad blobby frigjør.
}.
