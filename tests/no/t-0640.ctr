
Server init.
Utdata skriv: ['Database test'], stop.

>> db := Maria-DB ny vert: ['localhost'],
	brukernavn: ['xo'], 
	passord: ['pass123'],
	databasenavn: ['xobase'],
	koble-til.

>> søkeparametere :=
db spørring: ['SELECT UNHEX('CAFE') AS blobby'],
hent: { :row
	Utdata skriv: ( row blobby fra: 0 lengde: 2 ), stop.
	row blobby frigjør.
}.
