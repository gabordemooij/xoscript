# omvendte skråstreker skal overleve serialisering av kode, tekster skal ikke slutte for tidlig
>> verdier := Liste ny
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

verdier hver: { :i :value
	>> d := Ordbok ny.
	d sett: value ved: ['k'].
	>> r := d code objekt.
	Utdata skriv: r antall, stop.
	Utdata skriv: ( (r ved: ['k']) = value ), stop.
}.
