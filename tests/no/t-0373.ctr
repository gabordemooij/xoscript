# compliance test

# use international numbers

Utdata skriv: ['1000 -> '].
Utdata skriv: 1000, stop. #1000

Utdata skriv: ['1.5 -> '].
Utdata skriv: 1.5, stop.  #1.5

Utdata skriv: ['1001.5 -> '].
Utdata skriv: 1.5 + 1000, stop. #1001.5

# use 0-indexed arrays
>> x := Liste ny ; 1 ; 2 ; 3.
>> y := Liste ny ; ['a'] ; ['b'] ; ['c'].

Utdata skriv: ['1 -> '].
Utdata skriv: x ? 0, stop. #1

Utdata skriv: ['1 -> '].
Utdata skriv: (x ved: 0), stop. #1

Utdata skriv: ['1 -> '].
Utdata skriv: x første, stop. #1

Utdata skriv: ['3 -> '].
Utdata skriv: x siste, stop. #3

Utdata skriv: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Utdata skriv: (x etter: y), stop.

Utdata skriv: ['1 -> '].
Utdata skriv: (x fra: 0 lengde: 1) første, stop. #1

Utdata skriv: ['0 -> '].
Utdata skriv: (x finn: 1), stop. #0

x sett: 9 ved: 0.

Utdata skriv: ['9 -> '].
Utdata skriv: (x ved: 0), stop. #9

x legg-til-først: 8.
Utdata skriv: ['8 -> '].
Utdata skriv: (x ved: 0), stop. #9


x legg-til-sist: 10.
Utdata skriv: ['10 -> '].
Utdata skriv: (x ved: 4), stop. #10








