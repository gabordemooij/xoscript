>> Hilser := Objekt ny.
Hilser ved: ['lag'] gjør: {
	>> hilser := Objekt ny.
	hilser ved: ['name:'] gjør: { :navn
		Utdata skriv: ['setter et navn'].
		egen mittNavn := navn.
	}.
	hilser ved: ['utførHilsen'] gjør: {
		Utdata skriv: ['Hello'].
		Utdata skriv: egen mittNavn.
	}.
	hilser ved: ['hils'] gjør: {
		selv utførHilsen.
	}. <- hilser.
}.
>> hilser := Hilser lag.
hilser name: ['solskinn!'].
hilser hils.
