Server init.
Utdata skriv: ['Database date test'], stop.

>> db := Maria-DB ny vert: ['localhost'],
	brukernavn: ['xo'], 
	passord: ['pass123'],
	databasenavn: ['xobase'],
	koble-til.

>> søkeparametere :=
db spørring: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
hent: { :row
	Utdata skriv: row datetest, stop.
}.
