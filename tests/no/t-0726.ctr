# test buffers PKI/Sign 
Server init.

>> long := ( Liste ny fyll: 1000 med: ['a'] ) slå-sammen: [''].

# sign a message
Utdata skriv: ( 
	Hvelv signer: ['abc'] med: long
), stop.

Utdata skriv: ( 
	Hvelv
		kontroller: ['abc'] 
		signatur: long 
		med: long
), stop.

Utdata skriv: (
	Hvelv passord-hash: long bekreft: long
), stop.
