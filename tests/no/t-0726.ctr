# test buffere PKI/Sign 
Server init.

>> lang := ( Liste ny fyll: 1000 med: ['a'] ) slå-sammen: [''].

# signer en melding
Utdata skriv: ( 
	Hvelv signer: ['abc'] med: lang
), stop.

Utdata skriv: ( 
	Hvelv
		kontroller: ['abc'] 
		signatur: lang 
		med: lang
), stop.

Utdata skriv: (
	Hvelv passord-hash: lang bekreft: lang
), stop.
