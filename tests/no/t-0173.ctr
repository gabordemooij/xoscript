

Liste ved: ['sum'] gjør: {
	>> total := 0.
	selv hver: { :indeks :element
		total legg-til: element.
	}. <- total.
}.

Liste ved: ['produkt'] gjør: {
	>> total := 1.
	selv hver: { :indeks :element
		total multipliser-med: element.
	}. <- total.
}.

>> bruktMinne1 := 0.
>> bruktMinne2 := 0.
>> bruktMinne3 := 0.
>> bruktMinne4 := 0.

Program minnehåndtering: 0.

{

>> a := Liste ← ['hello'] ; ['world'] ; Sann ; Ingenting ; 666.
a := a + ( Liste ← 1 ).
Utdata skriv: ( ['sum: '] + ( a sum ) ), stop.
Utdata skriv: ( ['min: '] + ( a minimum ) ), stop.
Utdata skriv: ( ['maks: '] + ( a maksimum ) ), stop.
Utdata skriv: ( ['3.: '] + ( a ? 2 ) ), stop.
Utdata skriv: ( ['prd: '] + ( a produkt ) ), stop.
a sorter: { :a :b <- (b - a). }.
a hver: { :i :e Utdata skriv: ( i - 0 ), stop. }.

} start.

Program rydd-opp.
bruktMinne1 := (Program minne ? 0).


{

>> a := Liste ← ['hello'] ; ['world'] ; Sann ; Ingenting ; 666.
a := a + ( Liste ← 1 ).
Utdata skriv: ( ['sum: '] + ( a sum ) ), stop.
Utdata skriv: ( ['min: '] + ( a minimum ) ), stop.
Utdata skriv: ( ['maks: '] + ( a maksimum ) ), stop.
Utdata skriv: ( ['3.: '] + ( a ? 2 ) ), stop.
Utdata skriv: ( ['prd: '] + ( a produkt ) ), stop.
a sorter: { :a :b <- (b - a). }.
a hver: { :i :e Utdata skriv: ( i - 0 ), stop. }.

} start.



Program rydd-opp.
bruktMinne2 := (Program minne ? 0).


{

>> a := Liste ← ['hello'] ; ['world'] ; Sann ; Ingenting ; 666.
a := a + ( Liste ← 1 ).
Utdata skriv: ( ['sum: '] + ( a sum ) ), stop.
Utdata skriv: ( ['min: '] + ( a minimum ) ), stop.
Utdata skriv: ( ['maks: '] + ( a maksimum ) ), stop.
Utdata skriv: ( ['3.: '] + ( a ? 2 ) ), stop.
Utdata skriv: ( ['prd: '] + ( a produkt ) ), stop.
a sorter: { :a :b <- (b - a). }.
a hver: { :i :e Utdata skriv: ( i - 0 ), stop. }.

} start.



Program rydd-opp.
bruktMinne3 := (Program minne ? 0).

( bruktMinne1 = bruktMinne2 og: bruktMinne1 = bruktMinne3, og: bruktMinne2 = bruktMinne3 ) sann: {
	Utdata skriv: ['Ingen minnelekkasjer her'].
}, falsk: {
	Utdata skriv: ['Lekker minne...'].
}.
