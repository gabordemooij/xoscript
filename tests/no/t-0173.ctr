

Liste ved: ['sum'] gjør: {
	>> total := 0.
	selv hver: { :index :element
		total legg-til: element.
	}. <- total.
}.

Liste ved: ['product'] gjør: {
	>> total := 1.
	selv hver: { :index :element
		total multipliser-med: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program minnehåndtering: 0.

{

>> a := Liste ← ['hello'] ; ['world'] ; Sann ; Ingenting ; 666.
a := a + ( Liste ← 1 ).
Utdata skriv: ( ['sum: '] + ( a sum ) ), stop.
Utdata skriv: ( ['min: '] + ( a minimum ) ), stop.
Utdata skriv: ( ['max: '] + ( a maksimum ) ), stop.
Utdata skriv: ( ['3rd: '] + ( a ? 2 ) ), stop.
Utdata skriv: ( ['prd: '] + ( a product ) ), stop.
a sorter: { :a :b <- (b - a). }.
a hver: { :i :e Utdata skriv: ( i - 0 ), stop. }.

} start.

Program rydd-opp.
usedMemory1 := (Program minne ? 0).


{

>> a := Liste ← ['hello'] ; ['world'] ; Sann ; Ingenting ; 666.
a := a + ( Liste ← 1 ).
Utdata skriv: ( ['sum: '] + ( a sum ) ), stop.
Utdata skriv: ( ['min: '] + ( a minimum ) ), stop.
Utdata skriv: ( ['max: '] + ( a maksimum ) ), stop.
Utdata skriv: ( ['3rd: '] + ( a ? 2 ) ), stop.
Utdata skriv: ( ['prd: '] + ( a product ) ), stop.
a sorter: { :a :b <- (b - a). }.
a hver: { :i :e Utdata skriv: ( i - 0 ), stop. }.

} start.



Program rydd-opp.
usedMemory2 := (Program minne ? 0).


{

>> a := Liste ← ['hello'] ; ['world'] ; Sann ; Ingenting ; 666.
a := a + ( Liste ← 1 ).
Utdata skriv: ( ['sum: '] + ( a sum ) ), stop.
Utdata skriv: ( ['min: '] + ( a minimum ) ), stop.
Utdata skriv: ( ['max: '] + ( a maksimum ) ), stop.
Utdata skriv: ( ['3rd: '] + ( a ? 2 ) ), stop.
Utdata skriv: ( ['prd: '] + ( a product ) ), stop.
a sorter: { :a :b <- (b - a). }.
a hver: { :i :e Utdata skriv: ( i - 0 ), stop. }.

} start.



Program rydd-opp.
usedMemory3 := (Program minne ? 0).

( usedMemory1 = usedMemory2 og: usedMemory1 = usedMemory3, og: usedMemory2 = usedMemory3 ) sann: {
	Utdata skriv: ['No memory leaks here'].
}, falsk: {
	Utdata skriv: ['Leaking memory...'].
}.
