

>> Matryoshka := Objekt ny.
Matryoshka ved: ['double:'] gjør: { :hemmelighet
	egen hemmelighet := hemmelighet × 2.
}.
Matryoshka ved: ['ny:'] gjør: { :hemmelighet
	>> svar := Ingenting.
	>> t := (hemmelighet > 255).
	Utdata skriv: (hemmelighet + [' | '] + t), stop.
	t sann: {
		svar := hemmelighet.
	}, ellers: {
		svar := Matryoshka rekursiv ny: (selv double: hemmelighet).
	}. <- svar.
}.

>> x := Matryoshka ny: 2.
