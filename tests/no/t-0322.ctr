

>> Matryoshka := Objekt ny.
Matryoshka ved: ['double:'] gjør: { :secret
	egen secret := secret × 2.
}.
Matryoshka ved: ['ny:'] gjør: { :secret
	>> answer := Ingenting.
	>> t := (secret > 255).
	Utdata skriv: (secret + [' | '] + t), stop.
	t sann: {
		answer := secret.
	}, ellers: {
		answer := Matryoshka rekursiv ny: (selv double: secret).
	}. <- answer.
}.

>> x := Matryoshka ny: 2.
