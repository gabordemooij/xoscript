Server init.

>> db := Maria-DB ny vert: ['localhost'],
	brukernavn: ['xo'],
	passord: ['pass123'],
	databasenavn: ['xobase'],
	koble-til.

>> del := db spørring: ['DELETE FROM book WHERE id > 0'].
{  del utfør. db bekreft. } fang: { :e db rull-tilbake.  }, start.

>> antall := db spørring: ['SELECT COUNT(*) AS num FROM book'].
antall hent: { :row Utdata skriv: row num, stop. }.
