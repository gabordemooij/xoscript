
Tekst ved: ['evaluer'] gjør: {
	>> code := Fil ny: ['/tmp/eval.ctr'].
	code skriv: (selv tekst + ['.']).
	Program benytt: ['/tmp/eval.ctr'].
}.

>> map :=
	(Ordbok ny)
	sett: ['Hei Der'] ved: ['two'],
	sett: (Liste ← ['hello'] ; ['world'] ; (Liste ← 1 ; 2; 9) ; Falsk) ved: ['en'],
	sett: ( (Ordbok ny) sett: ['vrrden'] ved: ['feilstavet'] ) ved: ['three'],
	sett: (Liste ← ((Ordbok ny) sett: ['skatt'] ved: ['skjult']) ; 2) ved: ['fire']. 
>> str := map tekst.
>> map2 := Ingenting.
(['map2 := '] + str ) evaluer.
Utdata skriv: map2 ? ['en'] ? 0.
Utdata skriv: map2 ? ['en'] ? 1.
Utdata skriv: map2 ? ['fire'] ? 0 ? ['skjult'].
Utdata skriv: map2 ? ['en'] ? 2 ? 2.
