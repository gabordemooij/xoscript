
Tekst ved: ['evaluate'] gjør: {
	>> code := Fil ny: ['/tmp/eval.ctr'].
	code skriv: (selv tekst + ['.']).
	Program benytt: ['/tmp/eval.ctr'].
}.

>> map :=
	(Ordbok ny)
	sett: ['Hi There'] ved: ['two'],
	sett: (Liste ← ['hello'] ; ['world'] ; (Liste ← 1 ; 2; 9) ; Falsk) ved: ['one'],
	sett: ( (Ordbok ny) sett: ['wrrld'] ved: ['misspelled'] ) ved: ['three'],
	sett: (Liste ← ((Ordbok ny) sett: ['treasure'] ved: ['hidden']) ; 2) ved: ['four']. 
>> str := map tekst.
>> map2 := Ingenting.
(['map2 := '] + str ) evaluate.
Utdata skriv: map2 ? ['one'] ? 0.
Utdata skriv: map2 ? ['one'] ? 1.
Utdata skriv: map2 ? ['four'] ? 0 ? ['hidden'].
Utdata skriv: map2 ? ['one'] ? 2 ? 2.
