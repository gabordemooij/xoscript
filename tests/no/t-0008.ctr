>> Greeter := Objekt ny.
Greeter ved: ['make'] gjør: {
	>> greeter := Objekt ny.
	greeter ved: ['name:'] gjør: { :navn
		Utdata skriv: ['setting a name'].
		egen myName := navn.
	}.
	greeter ved: ['greet'] gjør: {
		Utdata skriv: ['Hello'].
		Utdata skriv: egen myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
