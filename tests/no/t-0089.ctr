>> slumpgenerator := { :a :b
	>> minimum := ( a < b ) enten: a eller: b.
	>> maksimum := ( a > b ) enten: a eller: b.
	>> x := Ingenting.
	{
		x := Tall mellom: a og: b.
		((x < minimum) eller: (x > maksimum)) sann: { 
			Utdata skriv: (['Ugyldig verdi!']).
			Program slutt.
		}.
	} 
	× 100. <- x.
}.
slumpgenerator bruk: 0 og: 0.
slumpgenerator bruk: 1 og: 0.
slumpgenerator bruk: 1 og: 1.
slumpgenerator bruk: 0 og: 1.
slumpgenerator bruk: -1 og: 0.
slumpgenerator bruk: -1 og: -1.
slumpgenerator bruk: 0 og: -1.
slumpgenerator bruk: 100 og: 200.
