>> randomizer := { :a :b
	>> minimum := ( a < b ) enten: a eller: b.
	>> maksimum := ( a > b ) enten: a eller: b.
	>> x := Ingenting.
	{
		x := Tall mellom: a og: b.
		((x < minimum) eller: (x > maksimum)) sann: { 
			Utdata skriv: (['Invalid value!']).
			Program slutt.
		}.
	} 
	× 100. <- x.
}.
randomizer bruk: 0 og: 0.
randomizer bruk: 1 og: 0.
randomizer bruk: 1 og: 1.
randomizer bruk: 0 og: 1.
randomizer bruk: -1 og: 0.
randomizer bruk: -1 og: -1.
randomizer bruk: 0 og: -1.
