
>> city := Liste ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Liste ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature etter: city.
>> cities := weather oppføringer sorter: { :a :b <- (a sammenlign: b). }.
>> temperatures := weather verdier sorter: { :a :b <- (a sammenlign: b) negativ?. }.

Utdata skriv: (cities slå-sammen: [',']), stop.
Utdata skriv: (temperatures slå-sammen: [',']), stop.
