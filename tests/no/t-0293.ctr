
>> by := Liste ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperatur := Liste ← ['15'] ; ['16'] ; ['15'].
>> vær := temperatur etter: by.
>> byer := vær oppføringer sorter: { :a :b <- (a sammenlign: b). }.
>> temperaturer := vær verdier sorter: { :a :b <- (a sammenlign: b) negativ?. }.

Utdata skriv: (byer slå-sammen: [',']), stop.
Utdata skriv: (temperaturer slå-sammen: [',']), stop.
