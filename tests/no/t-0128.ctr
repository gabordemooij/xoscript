
Liste ved: ['sum'] gjør: {
	>> total := 0.
	selv hver: { :index :element
		total legg-til: element.
	}. <- total.
}.

>> a := Liste ← 9 ; 8 ; 7.
Utdata skriv: (a sum), stop. 
>> a := Liste ← 1 ; 9.
Utdata skriv: (a sum), stop. 
>> a := Liste ← ['o'] ; 2.
Utdata skriv: (a sum), stop. 
Utdata skriv: (Liste ny sum), stop. 
