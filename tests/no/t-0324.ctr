>> Dyr := Objekt ny.
>> Fabrikk := Objekt ny.

Dyr ved: ['ny'] gjør: {
	>> dyr := selv ny.
	dyr sound: ['?']. <- dyr.
}.

Dyr ved: ['sound:'] gjør: { :s
	egen lyd := s.
}.

Dyr ved: ['lyd'] gjør: { <- egen lyd.
}.

>> Hund := Objekt ny.
>> Katt := Objekt ny.

Hund ved: ['ny'] gjør: { <- Dyr ny sound: ['woof!'].
}.

Katt ved: ['ny'] gjør: { <- Dyr ny sound: ['meow!'].
}.

Utdata skriv: Hund ny lyd, stop.
Utdata skriv: Katt ny lyd, stop.

Fabrikk ved: ['bland:og:'] gjør: { :dyr1 :dyr2 <- Dyr ny sound: (
		( dyr1 lyd fra: 0 lengde: 2 ) +
		( dyr2 lyd fra: 2 lengde: 5 )
	).
}.

Utdata skriv: (Fabrikk bland: Hund ny og: Katt ny) lyd, stop.
