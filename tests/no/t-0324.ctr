>> Animal := Objekt ny.
>> Factory := Objekt ny.

Animal ved: ['ny'] gjør: {
	>> animal := selv ny.
	animal sound: ['?']. <- animal.
}.

Animal ved: ['sound:'] gjør: { :s
	egen sound := s.
}.

Animal ved: ['sound'] gjør: { <- egen sound.
}.

>> Dog := Objekt ny.
>> Cat := Objekt ny.

Dog ved: ['ny'] gjør: { <- Animal ny sound: ['woof!'].
}.

Cat ved: ['ny'] gjør: { <- Animal ny sound: ['meow!'].
}.

Utdata skriv: Dog ny sound, stop.
Utdata skriv: Cat ny sound, stop.

Factory ved: ['mix:and:'] gjør: { :beast1 :beast2 <- Animal ny sound: (
		( beast1 sound fra: 0 lengde: 2 ) +
		( beast2 sound fra: 2 lengde: 5 )
	).
}.

Utdata skriv: (Factory mix: Dog ny and: Cat ny) sound, stop.
