

Tekst ved: ['evaluate'] gjør: {
	>> code := Fil ny: ['/tmp/eval.ctr'].
	code skriv: (selv tekst + ['.']).
	Program benytt: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Liste ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q tekst.
Utdata skriv: x, stop.
>> y := Ingenting.
(['y := '] + x ) evaluate.
Utdata skriv: y ? 0, stop.

q := Ordbok sett: ['\[''] ved: ['\['quote\']'].
x := q tekst.
Utdata skriv: x, stop.
y := Ingenting.
(['y := '] + x ) evaluate.

>> q := (Ordbok ny) sett:['\[''] ved:['\['quote\[''].
Utdata skriv: y ? ['\['quote\']'], stop.
