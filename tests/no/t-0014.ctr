>> Hilser := Objekt ny.
Hilser ved: ['lag'] gjør: {
	>> gr := Objekt ny.
	gr ved: ['setName:'] gjør: { :etNavn
		egen navn := etNavn.
	}.
	gr ved: ['hils'] gjør: {
		Utdata skriv: egen navn.
	}. <- gr.
}.
>> a := Hilser lag.
>> b := Hilser lag.
a setName: ['EN'].
b setName: ['TO'].
a hils.
b hils.
>> c := a ny.
c setName: ['TRE'].
c hils.
>> d := a ny.
d setName: ['FIRE'].
d hils.
c hils.
