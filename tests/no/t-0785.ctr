Utdata skriv: ['Test object'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gjør: { :moment
	egen moment := moment. 
}.

a ved: ['item'] gjør: { <- egen moment.
}.

>> today := Liste ny ; ( Moment ny sone: ['CEST'], år: 2026, måned: 7 ).
a item: today.
Utdata skriv: a item ? 0, stop.
a save-as: ['/tmp/a.bin'].
