>> q := Liste ← 1 ; 2 ; 3.
{ q ? ['1']. } fang: { Utdata skriv: ['caught!'], stop. }, start.
{ q ? Sann. } fang: { Utdata skriv: ['caught!'], stop. }, start.
{ q ? Falsk. } fang: { Utdata skriv: ['caught!'], stop. }, start.
{ q ? Ingenting. } fang: { Utdata skriv: ['caught!'], stop. }, start.
{ q ? (Liste ny). } fang: { Utdata skriv: ['caught!'], stop. }, start.
{ q ? (Objekt ny). } fang: { Utdata skriv: ['caught!'], stop. }, start.
{ q ? ({ ['Empty']. }). } fang: { Utdata skriv: ['caught!'], stop. }, start.
Utdata skriv: ['caught them all'], stop.
