>> q := Liste ← 1 ; 2 ; 3.
{ q ? ['1']. } fang: { Utdata skriv: ['fanget!'], stop. }, start.
{ q ? Sann. } fang: { Utdata skriv: ['fanget!'], stop. }, start.
{ q ? Falsk. } fang: { Utdata skriv: ['fanget!'], stop. }, start.
{ q ? Ingenting. } fang: { Utdata skriv: ['fanget!'], stop. }, start.
{ q ? (Liste ny). } fang: { Utdata skriv: ['fanget!'], stop. }, start.
{ q ? (Objekt ny). } fang: { Utdata skriv: ['fanget!'], stop. }, start.
{ q ? ({ ['Tomt']. }). } fang: { Utdata skriv: ['fanget!'], stop. }, start.
Utdata skriv: ['fanget alle sammen'], stop.
