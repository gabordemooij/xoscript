Server init.
Utdata skriv: ['Database time test'], stop.

>> db := Maria-DB ny vert: ['localhost'],
	brukernavn: ['xo'], 
	passord: ['pass123'],
	databasenavn: ['xobase'],
	koble-til.

>> søkeparametere :=
db spørring: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
hent: { :row
	Utdata skriv: row timetest, stop.
}.
