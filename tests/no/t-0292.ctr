>> vingård := { <- (	Ordbok ny
		sett: 2 ved: ['merlot'],
		sett: 3 ved: ['malbec'],
		sett: 4 ved: ['syrah']
	).
}.

Utdata skriv: (((vingård start) - ['ingenting']) antall), stop.
Utdata skriv: (((vingård start) - ['merlot']) antall), stop.
Utdata skriv: (((vingård start) - ['malbec']) antall), stop.
Utdata skriv: (((vingård start) - ['syrah']) antall), stop.
Utdata skriv: (((vingård start) - ['merlot'] - ['malbec']) antall), stop.
Utdata skriv: (((vingård start) - ['merlot'] - ['syrah']) antall), stop.
Utdata skriv: (((vingård start) - ['malbec'] -['syrah']) antall), stop.
Utdata skriv: (((vingård start) - ['malbec'] - ['syrah'] - ['merlot']) antall), stop.

