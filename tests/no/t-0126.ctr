#Linux
>> Slurp := Objekt ny.

Slurp ved: ['ny'] gjør: {
	egen str := [''].
}.

Slurp ved: ['nieuw'] gjør: {
	egen str := [''].
}.

Slurp ved: ['svar:'] gjør: { :blah
		egen str legg-til-sist: blah.
}.

Slurp ved: ['svar:og:'] gjør: { :blah :blahah
		egen str legg-til-sist: (blah fra: 0 lengde: (blah lengde - 1)).
		egen str legg-til-sist: [' '].
		egen str legg-til-sist: blahah.
}.

Slurp ved: ['skaff'] gjør: {
	>> buffer := egen str.
	egen str := ['']. <- buffer.
}.


Utdata skriv: (Program system: (Slurp ny echo: ['Hei, jeg kan skrive til konsollen med et flytende API!'], skaff)).


{ Fil ny: ['/tmp/from.txt'], slett. } fang: { ['Tomt']. }, start.
{ Fil ny: ['/tmp/to.txt'], slett. } fang: { ['Tomt']. }, start.


Fil ny: ['/tmp/to.txt'], finnes falsk: {
	Utdata skriv: ['Confirmed. Target file does not exist.\
'].
}.
Fil ny: ['/tmp/from.txt'], finnes falsk: {
	Utdata skriv: ['Confirmed. Source file does not exist.\
'].
}.



Program system: (Slurp ny touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], skaff).



Program system: (Slurp ny cp: ['/tmp/from.txt /tmp/to.txt'], skaff).

Fil ny: ['/tmp/to.txt'], finnes sann: {
	Utdata skriv: ['Confirmed. Target file has been created by shell.\
'].
}.


Utdata skriv: ['Innholdet i filen er:'] + (Fil ny: ['/tmp/to.txt'], les), stop.
