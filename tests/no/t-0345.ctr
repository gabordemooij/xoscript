# test fang-alt-metoder
>> x13 := Objekt ny.
x13 ved: ['a'] gjør: { :a Utdata skriv: 0, stop. }.
x13 ved: ['a:'] gjør: { :a Utdata skriv: a, stop. <- 5. }.
x13 ved: ['a:b:'] gjør: { :a :b Utdata skriv: (a + b), stop. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
