


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program minnehåndtering: 0.
>> palette := Ingenting.
>> colors := Ingenting.

{
palette := Ordbok ny.
palette 
	sett: ['#F00'] ved: ['red'],
	sett: ['#0F0'] ved: ['green'],
	sett: ['#00F'] ved: ['blue'].
Utdata skriv: ['number of RGB codes in palette: '] + ( palette antall ), stop.
Utdata skriv: ['RGB code of green is: '] + ( palette ? ['green'] ), stop.
colors := [''].
( palette hver: { :navn :code
		colors := colors + ( navn + [':'] + code ).
} ).
Utdata skriv: ['All colors in palette: '] + colors, stop.
} start.
Program rydd-opp.
usedMemory1 := (Program minne ? 0).

{
palette := Ordbok ny.
palette 
	sett: ['#F00'] ved: ['red'],
	sett: ['#0F0'] ved: ['green'],
	sett: ['#00F'] ved: ['blue'].
Utdata skriv: ['number of RGB codes in palette: '] + ( palette antall ), stop.
Utdata skriv: ['RGB code of green is: '] + ( palette ? ['green'] ), stop.
colors := [''].
( palette hver: { :navn :code
		colors := colors + ( navn + [':'] + code ).
} ).
Utdata skriv: ['All colors in palette: '] + colors, stop.
} start.
Program rydd-opp.
usedMemory2 := (Program minne ? 0).

{
palette := Ordbok ny.
palette 
	sett: ['#F00'] ved: ['red'],
	sett: ['#0F0'] ved: ['green'],
	sett: ['#00F'] ved: ['blue'].
Utdata skriv: ['number of RGB codes in palette: '] + ( palette antall ), stop.
Utdata skriv: ['RGB code of green is: '] + ( palette ? ['green'] ), stop.
colors := [''].
( palette hver: { :navn :code
		colors := colors + ( navn + [':'] + code ).
} ).
Utdata skriv: ['All colors in palette: '] + colors, stop.
} start.
Program rydd-opp.
usedMemory3 := (Program minne ? 0).



( usedMemory1 = usedMemory2 og: usedMemory1 = usedMemory3, og: usedMemory2 = usedMemory3 ) sann: {
	Utdata skriv: ['No memory leaks here'].
}, falsk: {
	Utdata skriv: ['Leaking memory...'].
}.
