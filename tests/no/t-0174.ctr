


>> bruktMinne1 := 0.
>> bruktMinne2 := 0.
>> bruktMinne3 := 0.
>> bruktMinne4 := 0.

Program minnehåndtering: 0.
>> palett := Ingenting.
>> farger := Ingenting.

{
palett := Ordbok ny.
palett 
	sett: ['#F00'] ved: ['rød'],
	sett: ['#0F0'] ved: ['grønn'],
	sett: ['#00F'] ved: ['blå'].
Utdata skriv: ['antall RGB-koder i paletten: '] + ( palett antall ), stop.
Utdata skriv: ['RGB-koden for grønn er: '] + ( palett ? ['grønn'] ), stop.
farger := [''].
( palett hver: { :navn :code
		farger := farger + ( navn + [':'] + code ).
} ).
Utdata skriv: ['Alle farger i paletten: '] + farger, stop.
} start.
Program rydd-opp.
bruktMinne1 := (Program minne ? 0).

{
palett := Ordbok ny.
palett 
	sett: ['#F00'] ved: ['rød'],
	sett: ['#0F0'] ved: ['grønn'],
	sett: ['#00F'] ved: ['blå'].
Utdata skriv: ['antall RGB-koder i paletten: '] + ( palett antall ), stop.
Utdata skriv: ['RGB-koden for grønn er: '] + ( palett ? ['grønn'] ), stop.
farger := [''].
( palett hver: { :navn :code
		farger := farger + ( navn + [':'] + code ).
} ).
Utdata skriv: ['Alle farger i paletten: '] + farger, stop.
} start.
Program rydd-opp.
bruktMinne2 := (Program minne ? 0).

{
palett := Ordbok ny.
palett 
	sett: ['#F00'] ved: ['rød'],
	sett: ['#0F0'] ved: ['grønn'],
	sett: ['#00F'] ved: ['blå'].
Utdata skriv: ['antall RGB-koder i paletten: '] + ( palett antall ), stop.
Utdata skriv: ['RGB-koden for grønn er: '] + ( palett ? ['grønn'] ), stop.
farger := [''].
( palett hver: { :navn :code
		farger := farger + ( navn + [':'] + code ).
} ).
Utdata skriv: ['Alle farger i paletten: '] + farger, stop.
} start.
Program rydd-opp.
bruktMinne3 := (Program minne ? 0).



( bruktMinne1 = bruktMinne2 og: bruktMinne1 = bruktMinne3, og: bruktMinne2 = bruktMinne3 ) sann: {
	Utdata skriv: ['Ingen minnelekkasjer her'].
}, falsk: {
	Utdata skriv: ['Lekker minne...'].
}.
