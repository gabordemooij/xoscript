# bruk av FFI med Server-tillegget

# koble til libc (plattformavhengig)
>> biblnavn := Program innstilling: ['FFITESTLIB'].

# koble stdio-funksjoner fra C for avanserte filoperasjoner
Server koble: ( Liste ny ;
 biblnavn ; ['fopen'] ;
 ( Liste ny ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
koble: ( Liste ny ;
 Ingenting ; # betyr samme bibliotek
 ['fread'] ;
 ( Liste ny ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Ingenting ; # betyr samme objekt (dvs. Stream)
 ['fread']
),
koble: (
 Liste ny ;
 Ingenting ; # betyr samme bibliotek
 ['fwrite'] ;
 ( Liste ny ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Ingenting ; # betyr samme bibliotek
 ['fwrite']
),
koble: (
 Liste ny ;
 Ingenting ; # betyr samme bibliotek
 ['rewind'] ;
 ( Liste ny ; ['pointer'] ) ;
 ['int'] ;
 Ingenting ; # betyr samme bibliotek
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> sti := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# åpne en fil med fopen(path, mode)
>> fd := Stream path: sti mode: mode.

# skriv bytes fra bufferen tegnstreng til filen
>> bytes-skrevet := Stream beskjed: ['fwrite'] argumenter: (Liste ny ; str ; 1 ; 6 ; fd ).
Utdata skriv: bytes-skrevet, stop.

# spol filpekeren tilbake
Stream rewind: fd.

# alloker en buffer
>> buf := Blob ny: 20.

# les fra filen
>> bytes-lest := Stream beskjed: ['fread'] argumenter: (Liste ny ; buf ; 1 ; 6 ; fd ).
Utdata skriv: bytes-lest, stop.
Utdata skriv: buf, stop.

# frigjør minne
str  frigjør.
sti frigjør.
mode frigjør.
buf  frigjør.


