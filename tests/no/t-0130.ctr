# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Program innstilling: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server koble: ( Liste ny ;
 libname ; ['fopen'] ;
 ( Liste ny ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
koble: ( Liste ny ;
 Ingenting ; # means same lib
 ['fread'] ;
 ( Liste ny ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Ingenting ; # means same object (i.e. Stream)
 ['fread']
),
koble: (
 Liste ny ;
 Ingenting ; # means same lib
 ['fwrite'] ;
 ( Liste ny ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Ingenting ; # means same lib
 ['fwrite']
),
koble: (
 Liste ny ;
 Ingenting ; # means same lib
 ['rewind'] ;
 ( Liste ny ; ['pointer'] ) ;
 ['int'] ;
 Ingenting ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> sti := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: sti mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream beskjed: ['fwrite'] argumenter: (Liste ny ; str ; 1 ; 6 ; fd ).
Utdata skriv: bytes-written, stop.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob ny: 20.

# read from file
>> bytes-read := Stream beskjed: ['fread'] argumenter: (Liste ny ; buf ; 1 ; 6 ; fd ).
Utdata skriv: bytes-read, stop.
Utdata skriv: buf, stop.

# free memory
str  frigjør.
sti frigjør.
mode frigjør.
buf  frigjør.


