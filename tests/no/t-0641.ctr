# Test utf8-rensing
Server init.

>> utf8tilfeller := Ordbok ny
	# Bare ASCII
	sett: ( Liste ny ; 65 ; 65 ; 65 ; 65 ; 0 ) ved: ['AAAA'],
	# gyldig 2-byte-sekvens
	sett: ( Liste ny ; 194 ; 162 ; 0 ) ved: ['¢'],
	# Gyldig 3-byte UTF-8
    sett: ( Liste ny ; 226 ; 130 ; 172 ; 0 ) ved: ['€'],
	# Gyldig 4-byte UTF-8
    sett: ( Liste ny ; 240 ; 144 ; 141 ; 136 ; 0 ) ved: ['𐍈'],
	# Ugyldig fortsettelsesbyte i sekvensen E2 28 AC -> start 3b-sekv + 28 feil fortsettelse + AC fortsettelsesbyte, men hører til samme feil
    sett: ( Liste ny ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) ved: ['A?A'],
	# Overlang koding av ASCII 'A' (skal bli ?),
    sett: ( Liste ny ; 65 ; 193 ; 129 ; 0 ) ved: ['A?'],
	# Ugyldig første byte (0xFF)
    sett: ( Liste ny ; 255 ; 0 ) ved: ['?'],
	# Ufullstendig flerbytesekvens på slutten
    sett: ( Liste ny ; 66 ; 226 ; 0 ) ved: ['B?'],
    # Tom tekst
    #put: ( List new ) at: [''],
	# Flere blandede sekvenser
    sett: ( Liste ny ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) ved: ['A€?𐍈B'].
	 
utf8tilfeller hver: { :key :value
	>> blob := Blob ny: value antall, bytes: value.
	>> str := blob tekst.
	(str = key) sann: {
		Utdata skriv: ['OK'], stop.
	}, ellers: {
		Utdata skriv: ['UTF8-rensing mislyktes på: '] + key + [' fikk: '] + str, stop.
	}.
	blob frigjør.
}.
