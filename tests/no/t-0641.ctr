# Test utf8 sanitizer
Server init.

>> utf8cases := Ordbok ny
	# ASCII only
	sett: ( Liste ny ; 65 ; 65 ; 65 ; 65 ; 0 ) ved: ['AAAA'],
	# valid 2 byte sequence
	sett: ( Liste ny ; 194 ; 162 ; 0 ) ved: ['¢'],
	# Valid 3-byte UTF-8
    sett: ( Liste ny ; 226 ; 130 ; 172 ; 0 ) ved: ['€'],
	# Valid 4-byte UTF-8
    sett: ( Liste ny ; 240 ; 144 ; 141 ; 136 ; 0 ) ved: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    sett: ( Liste ny ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) ved: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    sett: ( Liste ny ; 65 ; 193 ; 129 ; 0 ) ved: ['A?'],
	# Invalid first byte (0xFF)
    sett: ( Liste ny ; 255 ; 0 ) ved: ['?'],
	# Incomplete multi-byte sequence at end
    sett: ( Liste ny ; 66 ; 226 ; 0 ) ved: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    sett: ( Liste ny ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) ved: ['A€?𐍈B'].
	 
utf8cases hver: { :key :value
	>> blob := Blob ny: value antall, bytes: value.
	>> str := blob tekst.
	(str = key) sann: {
		Utdata skriv: ['OK'], stop.
	}, ellers: {
		Utdata skriv: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, stop.
	}.
	blob frigjør.
}.
