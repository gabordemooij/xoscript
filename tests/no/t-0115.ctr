{
	denne-oppgaven feil: ['Ikke feil.'].
	ukjent gjørNoe.
} fang: {
	Utdata skriv: ['Fanget!'].
}, start.

{
	denne-oppgaven feil: ['Ikke feil.'].
	egen ukjent gjørNoe.
} fang: {
	Utdata skriv: ['Fanget!'].
}, start.

{
	denne-oppgaven feil: ['Ikke feil.'].
	ukjent := 122.
} fang: {
	Utdata skriv: ['Fanget!'].
}, start.


{
	denne-oppgaven feil: ['Ikke feil.'].
	Sann avbryt.
	Utdata skriv: ['FEIL'].
} fang: {
	Utdata skriv: ['Fanget!'].
}, start.

{
	{
		denne-oppgaven feil: ['Ikke feil.'].
		Sann avbryt.
		Utdata skriv: ['FEIL'].
	} fang: { :x
		(x = ['Ikke feil.']) sann: { denne-oppgaven feil: ['Nøstet fanget!']. }.
	}, start.
} fang: { :e
	Utdata skriv: e.
}, start.
