{
	denne-oppgaven feil: ['Dont fail.'].
	unknown doSomething.
} fang: {
	Utdata skriv: ['Caught!'].
}, start.

{
	denne-oppgaven feil: ['Dont fail.'].
	egen unknown doSomething.
} fang: {
	Utdata skriv: ['Caught!'].
}, start.

{
	denne-oppgaven feil: ['Dont fail.'].
	unknown := 122.
} fang: {
	Utdata skriv: ['Caught!'].
}, start.


{
	denne-oppgaven feil: ['Dont fail.'].
	Sann avbryt.
	Utdata skriv: ['FAIL'].
} fang: {
	Utdata skriv: ['Caught!'].
}, start.

{
	{
		denne-oppgaven feil: ['Dont fail.'].
		Sann avbryt.
		Utdata skriv: ['FAIL'].
	} fang: { :x
		(x = ['Dont fail.']) sann: { denne-oppgaven feil: ['Nested Caught!']. }.
	}, start.
} fang: { :e
	Utdata skriv: e.
}, start.
