Utdata skriv: ['Test object'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gjør: { :fmt
	egen fmt := fmt. 
}.

a ved: ['item'] gjør: { <- egen fmt.
}.

a item: ( Format ny: ['|%s|'] ).

Utdata skriv: a item, stop.

>> old-fmt-address := a item prototype minneadresse.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== RELOADING SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototype minneadresse = old-fmt-address) sann: {
	Utdata skriv: ['Object link re-attached.'], stop.
}.

Utdata skriv: ( b item bruk: ['hello'] ), stop.
