Utdata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gjør: { :fmt
	egen fmt := fmt. 
}.

a ved: ['vare'] gjør: {
	<- egen fmt.
}.

a item: ( Format ny: ['|%s|'] ).

Utdata skriv: a vare, stop.

>> gammel-fmt-adresse := a vare prototype minneadresse.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== LASTER INN SNAP PÅ NYTT:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b vare prototype minneadresse = gammel-fmt-adresse) sann: {
	Utdata skriv: ['Objektlenke koblet til igjen.'], stop.
}.

Utdata skriv: ( b vare bruk: ['hello'] ), stop.
