
Tall lær: ['plus:'] betyr: ['+'].
Tall ved: ['+'] gjør: { :x
	>> kurs := 1.
	>> valuta := x betegnelse.
	(valuta = ['euros']) sann: {
		kurs := 2.
	}. <- (selv plus: (x × kurs)).
}.
>> dollars := 3.
>> euros := 2.
dollars kvalifiser: ['dollars'].
euros kvalifiser: ['euros'].
>> penger := dollars + euros.
Utdata skriv: penger, stop.
