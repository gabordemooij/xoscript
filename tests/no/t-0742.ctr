Utdata skriv: ['Test object'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gjør: { :hexhelper
	egen hexhelper := hexhelper. 
}.

a ved: ['item'] gjør: { <- egen hexhelper.
}.

a item: Hx ny.

>> old-hexhelper-address := a item prototype minneadresse.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== RELOADING SNAP:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototype minneadresse = old-hexhelper-address) sann: {
	Utdata skriv: ['Object link re-attached.'], stop.
}.
