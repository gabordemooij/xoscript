Utdata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gjør: { :hexhjelper
	egen hexhjelper := hexhjelper. 
}.

a ved: ['vare'] gjør: {
	<- egen hexhjelper.
}.

a item: Hx ny.

>> gammel-hexhjelper-adresse := a vare prototype minneadresse.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== LASTER INN SNAP PÅ NYTT:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b vare prototype minneadresse = gammel-hexhjelper-adresse) sann: {
	Utdata skriv: ['Objektlenke koblet til igjen.'], stop.
}.
