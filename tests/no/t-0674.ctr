# lykkelig sti
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> sti := ['/tmp/dat.csv'].
>> csv := Fil ny: sti.
csv skriv: s.

# godtar CRLF LF CR, varierende radlengde
csv skilletegn: [';'] anførselstegn: ['"'] linjer: { :line
	Program rydd-opp.
	Utdata skriv: line, stop.
	Program rydd-opp.
}.

# ulikt antall linjer
s legg-til-sist: ['\njustone'].
csv skriv: s.
{
	csv skilletegn: [';'] anførselstegn: ['"'] linjer: { :line
		Utdata skriv: line, stop.
	}.
} fang: { :e 
	Utdata skriv: e, stop.
}, start.

# ugyldig format
s := ['"he"llo";world'].
csv skriv: s.
{
	csv skilletegn: [';'] anførselstegn: ['"'] linjer: { :line
		Utdata skriv: line, stop.
	}.
} fang: { :e 
	Utdata skriv: e, stop.
}, start.
