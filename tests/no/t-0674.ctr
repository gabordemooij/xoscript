# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> sti := ['/tmp/dat.csv'].
>> csv := Fil ny: sti.
csv skriv: s.

# accepts CRLF LF CR, varying row length
csv skilletegn: [';'] anførselstegn: ['"'] linjer: { :line
	Program rydd-opp.
	Utdata skriv: line, stop.
	Program rydd-opp.
}.

# unequal lines
s legg-til-sist: ['\njustone'].
csv skriv: s.
{
	csv skilletegn: [';'] anførselstegn: ['"'] linjer: { :line
		Utdata skriv: line, stop.
	}.
} fang: { :e 
	Utdata skriv: e, stop.
}, start.

# invalid format
s := ['"he"llo";world'].
csv skriv: s.
{
	csv skilletegn: [';'] anførselstegn: ['"'] linjer: { :line
		Utdata skriv: line, stop.
	}.
} fang: { :e 
	Utdata skriv: e, stop.
}, start.
