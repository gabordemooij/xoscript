Tekst ved: ['html'] gjør: { <- (
		selv
		erstatt: ['&'] med: ['&amp;'],
		erstatt: ['<'] med: ['&lt;'],
		erstatt: ['>'] med: ['&gt;'],
		erstatt: ['"'] med: ['&quot;']
	).
}.

>> list := Liste ny.

['Verbatim Syntax'] tegn hver: { :tall :bokstav
	list ; ((['<li>#Number:Letter</li>']) Number: (tall), Letter: bokstav).
}.

Utdata list.





>> malen := ['
<html>
<body>
<p>Hello this is a test!</p>
<p>The string \‘Verbatim Syntax\’ has: 15 code points...</p>
<ul>
[list]
</ul>
</body> 
</html>
'] [list]: (list slå-sammen: ['↵']).

Utdata skriv: malen.

