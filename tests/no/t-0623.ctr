

>> g  := Server ny.
>> v  := Hvelv ny.
>> ok := 0.

>> hemmeligheter := Liste ny ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> passordene := hemmeligheter kopier.
passordene hver: { :i :p
	hemmeligheter hver: { :n :s
		{
			>> kryptert := v krypter: s nøkkel: p.
			>> dekryptert := v dekrypter: kryptert nøkkel: p.
			(dekryptert = s) sann: {
				ok legg-til: 1.
			}, ellers: {
				Utdata skriv: ['kryptering/dekryptering mislyktes: '], stop.
				Utdata skriv: s, stop.
				Utdata skriv: ['kryptert: '] + kryptert, stop.
				Utdata skriv: ['dekryptert: '] + kryptert, stop.
				Program slutt.
			}.
		} fang: { :feilen
			(s = [''] eller: p = ['']) sann: {
				ok legg-til: 1.
			}, ellers: {
				Utdata skriv: feilen, stop.
				Program slutt.
			}.
		}, start.
	}.
}.

Utdata skriv: ( ok + [' hvelvkrypteringer testet.'] ), stop.