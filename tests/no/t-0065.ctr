Tall ved: ['factorial'] gjør: {
	>> total := 1.
	{ :index total multipliser-med: (selv - (index)). } × selv. <- total.
}.
>> Printer := Objekt ny.
Printer ved: ['print:and:'] gjør: { :x :y
	Utdata skriv: ['a='] + x + [', b='] + y, stop.
}.
>> a := 4.5. >> b := a rund-ned.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a rund-opp.
Printer print: a and: b.
a := 4.5. b := a rund-ned.
Printer print: a and: b.
a := 4.5. b := a avrund.
Printer print: a and: b.
a := 4.2. b := a avrund.
Printer print: a and: b.

Utdata skriv: (9 modulo: 5), stop.
Utdata skriv: -666 absolutt, stop.
Utdata skriv: 49 kvadratrot, stop.
Utdata skriv: (2 opphøyd: 3), stop.
>> l := (Liste ← 9 ; 6).
Utdata skriv: l minimum.

