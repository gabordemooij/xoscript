Tall ved: ['fakultet'] gjør: {
	>> total := 1.
	{ :indeks total multipliser-med: (selv - (indeks)). } × selv. <- total.
}.
>> Skriver := Objekt ny.
Skriver ved: ['skrivUt:og:'] gjør: { :x :y
	Utdata skriv: ['a='] + x + [', b='] + y, stop.
}.
>> a := 4.5. >> b := a rund-ned.
Skriver skrivUt: a og: b.
a := 4. b := a fakultet.
Skriver skrivUt: a og: b.
a := 4.5. b := a rund-opp.
Skriver skrivUt: a og: b.
a := 4.5. b := a rund-ned.
Skriver skrivUt: a og: b.
a := 4.5. b := a avrund.
Skriver skrivUt: a og: b.
a := 4.2. b := a avrund.
Skriver skrivUt: a og: b.

Utdata skriv: (9 modulo: 5), stop.
Utdata skriv: -666 absolutt, stop.
Utdata skriv: 49 kvadratrot, stop.
Utdata skriv: (2 opphøyd: 3), stop.
>> l := (Liste ← 9 ; 6).
Utdata skriv: l minimum.

