Utdata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 

a ved: ['item:'] gjør: { :num
	egen num := num. 
}.

a ved: ['vare'] gjør: {
	<- egen num.
}.

a item: 123.

Utdata skriv: a vare, stop.

>> gammel-num-adresse := a vare prototype minneadresse.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== LASTER INN SNAP PÅ NYTT:'], stop.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b vare prototype minneadresse = gammel-num-adresse) sann: {
	Utdata skriv: ['Objektlenke koblet til igjen.'], stop.
}.

Utdata skriv: b vare, stop.
