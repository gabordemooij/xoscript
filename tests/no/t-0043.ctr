>> gjentaker := Objekt ny.
gjentaker ved: ['svar:'] gjør: { :hva
	Utdata skriv: hva + [' '].
}.
gjentaker ved: ['svar:og:'] gjør: { :hva :say
	Utdata skriv: hva, skriv: say + [' '].
}.
gjentaker ved: ['svar:og:og:'] gjør: { :hva :say :mer
	Utdata skriv: hva, skriv: say, skriv: mer.
}.
gjentaker gjenta.
gjentaker everything: ['Jeg sier.'].
gjentaker and: ['I '] everything: ['gjør.'].
