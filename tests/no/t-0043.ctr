>> repeater := Objekt ny.
repeater ved: ['svar:'] gjør: { :what
	Utdata skriv: what + [' '].
}.
repeater ved: ['svar:og:'] gjør: { :what :say
	Utdata skriv: what, skriv: say + [' '].
}.
repeater ved: ['svar:og:og:'] gjør: { :what :say :more
	Utdata skriv: what, skriv: say, skriv: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
