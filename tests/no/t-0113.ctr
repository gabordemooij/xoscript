Utdata skriv: ['Fortsett for-løkke, Nei - før 6 og oppover.'], stop.
{ :i
	Utdata skriv: (i + 1), stop.
	((i + 1) > 4) fortsett.
	Utdata skriv: ['-'].
} × 10.

>> x := 0.
>> xErMindreEnn10 := { <- ( x < 10 ). }.
Utdata stop.
Utdata skriv: ['Fortsett while-true, Nei --> før 5 og oppover.'], stop.
{
	Utdata skriv: ['iteration #'] + x, stop.
	x legg-til: 1.
	((x < 5) ikke) fortsett.
	Utdata skriv: ['-->'].
} mens: xErMindreEnn10.
Utdata stop.
Utdata skriv: ['Fortsett while-false, Nei - bare før 3.'], stop.
{
	Utdata skriv: ['iteration #'] + x, stop.
	x trekk-fra: 1.
	(x = 3) fortsett.
	Utdata skriv: ['-'].
} mens: { <- ( x > 0). }.

Utdata stop.
Utdata skriv: ['Fortsett times-løkke, Nei ||| før 3.'], stop.
{ :i
	Utdata skriv: ['iteration #'] + i, stop.
	(i = 2) fortsett.
	Utdata skriv: ['|||'].
} × 5.

Utdata stop.

{ Sann fortsett. Utdata skriv: ['ikke skriv dette!'], stop. } start.

{ Sann fortsett. Utdata skriv: ['ikke skriv dette!'], stop. } fang: { Utdata skriv: ['Ikke fang dette!']. }, start.

Utdata skriv: ['Test Liste each-løkke: 0, ... ,2'], stop.
(Liste ← 1 ; 2 ; 3) avbild: { :i
	(i = 1) fortsett.
	Utdata skriv: ['iteration #'] + (i - 0), stop.
}.

Utdata skriv: ['Test Ordbok each-løkke: bare c'], stop.
>> m := Ordbok ny.
m sett: ['first'] ved: ['a'], sett: ['second'] ved: ['b'], sett: ['tredje'] ved: ['c'].
m hver: { :k :v
	(k ≠ ['c']) fortsett.
	Utdata skriv: ['iteration'] + k + v, stop.
}.

