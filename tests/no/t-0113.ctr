Utdata skriv: ['Continue for-loop, No - before 6 and up.'], stop.
{ :i
	Utdata skriv: (i + 1), stop.
	((i + 1) > 4) fortsett.
	Utdata skriv: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Utdata stop.
Utdata skriv: ['Continue while-true, No --> before 5 and up.'], stop.
{
	Utdata skriv: ['iteration #'] + x, stop.
	x legg-til: 1.
	((x < 5) ikke) fortsett.
	Utdata skriv: ['-->'].
} mens: xIsLessThan10.
Utdata stop.
Utdata skriv: ['Continue while-false, No - before 3 only.'], stop.
{
	Utdata skriv: ['iteration #'] + x, stop.
	x trekk-fra: 1.
	(x = 3) fortsett.
	Utdata skriv: ['-'].
} mens: { <- ( x > 0). }.

Utdata stop.
Utdata skriv: ['Continue times-loop, No ||| before 3.'], stop.
{ :i
	Utdata skriv: ['iteration #'] + i, stop.
	(i = 2) fortsett.
	Utdata skriv: ['|||'].
} × 5.

Utdata stop.

{ Sann fortsett. Utdata skriv: ['dont write this!'], stop. } start.

{ Sann fortsett. Utdata skriv: ['dont write this!'], stop. } fang: { Utdata skriv: ['Dont catch this!']. }, start.

Utdata skriv: ['Test Array each-loop: 0, ... ,2'], stop.
(Liste ← 1 ; 2 ; 3) avbild: { :i
	(i = 1) fortsett.
	Utdata skriv: ['iteration #'] + (i - 0), stop.
}.

Utdata skriv: ['Test Map each-loop: c only'], stop.
>> m := Ordbok ny.
m sett: ['first'] ved: ['a'], sett: ['second'] ved: ['b'], sett: ['third'] ved: ['c'].
m hver: { :k :v
	(k ≠ ['c']) fortsett.
	Utdata skriv: ['iteration'] + k + v, stop.
}.

