Liste ved: ['sum'] gjør: {
	>> total := 0.
	selv hver: { :index :element
		total legg-til: element.
	}. <- total.
}.

>> a := Sann.



a ved: ['tekst'] gjør: {
	>> answer := Ingenting.
	( selv = Sann ) sann: {
		answer := ['Yep'].
	}, ellers: {
		answer := ['Nope'].
	}. <- answer.
}.

a ved: ['tall'] gjør: {
	>> answer := Ingenting.
	( selv = Sann ) sann: {
		answer := 10.
	}, ellers: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b ved: ['tekst'] gjør: { <- ['Devil'].
}.

b ved: ['boolsk'] gjør: { <- Falsk.
}.


Utdata skriv: a, stop.  
Utdata skriv: (90 + a), stop. 
Utdata skriv: b, stop. 
Utdata skriv: (Sann og: b), stop.

a := Liste ← ['hello'] ; ['world'] ; Sann ; Ingenting ; 666. 
a := a + ( Liste ← 1 ).
Utdata skriv: a, stop.
Utdata skriv: ((Ordbok ny) sett: Ingenting ved: Ingenting), stop.
Utdata skriv: a sum, stop. 


{
	a ved: ['tekst'] gjør: { <- Ingenting. }.
	a := [''] + a.
} fang: { :error
	Utdata skriv: ['Error noted: '] + error, stop.
}, start.



{
	a ved: ['tall'] gjør: { <- Ingenting. }.
	a := 3 × a.
} fang: { :error
	Utdata skriv: ['Error noted: '] + error, stop.
}, start.


{
	a ved: ['boolsk'] gjør: { <- Ingenting. }.
	a := Sann og: a. 
} fang: { :error
	Utdata skriv: ['Error noted: '] + error, stop.
}, start.





{
	a ved: ['tekst'] gjør: { <- Falsk. }.
	a := [''] + a.
} fang: { :error
	Utdata skriv: ['Error noted: '] + error, stop.
}, start.



{
	a ved: ['tall'] gjør: { <- Sann. }.
	a := 3 × a.
} fang: { :error
	Utdata skriv: ['Error noted: '] + error, stop.
}, start.


