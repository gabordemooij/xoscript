# en gruppe som ikke er del av treffet, skal ikke krasje og skal beholde gruppenumrene
Server init.
>> vis := { :mønsteret :subject
	>> p := Mønster ny: mønsteret.
	p treff: subject gjør: { :m :g
		Utdata skriv: g antall, skriv: [' '], skriv: (g slå-sammen: ['|']), stop.
		<- m.
	}.
}.
vis bruk: ['(a)|(b)'] og: ['b'].
vis bruk: ['(a)|(b)'] og: ['a'].
vis bruk: ['(x)?y'] og: ['y'].
vis bruk: ['(x)?(y)(z)?'] og: ['xy'].
