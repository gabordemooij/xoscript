# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Mønster ny: pattern.
	p treff: subject gjør: { :m :g
		Utdata skriv: g antall, skriv: [' '], skriv: (g slå-sammen: ['|']), stop. <- m.
	}.
}.
show bruk: ['(a)|(b)'] og: ['b'].
show bruk: ['(a)|(b)'] og: ['a'].
show bruk: ['(x)?y'] og: ['y'].
show bruk: ['(x)?(y)(z)?'] og: ['xy'].
