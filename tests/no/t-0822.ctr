# færre parametere enn plassholdere skal gi en feil, ikke lese forbi bindingene
Server init.

>> db := Maria-DB ny vert: ['localhost'],
	brukernavn: ['xo'],
	passord: ['pass123'],
	databasenavn: ['xobase'],
	koble-til.

>> søkeparametere := db spørring: ['SELECT ? AS a, ? AS b, ? AS c'].
søkeparametere parametere: (Liste ny ; ['1']).
{ søkeparametere hent: { :rad Utdata skriv: rad, stop. }. } fang: { :e Utdata skriv: e, stop. }, start.

>> søkeparametere := db spørring: ['SELECT ? AS a'].
{ søkeparametere hent: { :rad Utdata skriv: rad, stop. }. } fang: { :e Utdata skriv: e, stop. }, start.

# riktig antall virker fortsatt, flere parametere ignoreres som før
>> søkeparametere := db spørring: ['SELECT ? AS a, ? AS b'].
søkeparametere parametere: (Liste ny ; ['1'] ; ['2']).
søkeparametere hent: { :rad Utdata skriv: (rad ved: ['a']), skriv: (rad ved: ['b']), stop. }.
søkeparametere parametere: (Liste ny ; ['1'] ; ['2'] ; ['3']).
søkeparametere hent: { :rad Utdata skriv: (rad ved: ['a']), skriv: (rad ved: ['b']), stop. }.
