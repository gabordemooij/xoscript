# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := Maria-DB ny vert: ['localhost'],
	brukernavn: ['xo'],
	passord: ['pass123'],
	databasenavn: ['xobase'],
	koble-til.

>> søkeparametere := db spørring: ['SELECT ? AS a, ? AS b, ? AS c'].
søkeparametere parametere: (Liste ny ; ['1']).
{ søkeparametere hent: { :row Utdata skriv: row, stop. }. } fang: { :e Utdata skriv: e, stop. }, start.

>> søkeparametere := db spørring: ['SELECT ? AS a'].
{ søkeparametere hent: { :row Utdata skriv: row, stop. }. } fang: { :e Utdata skriv: e, stop. }, start.

# the right number still works, more parameters are ignored as before
>> søkeparametere := db spørring: ['SELECT ? AS a, ? AS b'].
søkeparametere parametere: (Liste ny ; ['1'] ; ['2']).
søkeparametere hent: { :row Utdata skriv: (row ved: ['a']), skriv: (row ved: ['b']), stop. }.
søkeparametere parametere: (Liste ny ; ['1'] ; ['2'] ; ['3']).
søkeparametere hent: { :row Utdata skriv: (row ved: ['a']), skriv: (row ved: ['b']), stop. }.
