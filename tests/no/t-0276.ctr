>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objekt ny.
⚄ ved: ['drawFrom:length:'] gjør: { :pool :antall
	
	>> result := [''].
	
	{
		>> index := Tall random % (pool lengde).
		result legg-til-sist: ( pool tegn: (index + 1) ).
		
	} × antall. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? lengde.
Utdata skriv: (['x↵'] x random lengde).
Utdata skriv: (['y↵'] y ?? lengde).

