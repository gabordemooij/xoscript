>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objekt ny.
⚄ ved: ['trekkFra:lengde:'] gjør: { :utvalg :antall
	
	>> resultat := [''].
	
	{
		>> indeks := Tall tilfeldig % (utvalg lengde).
		resultat legg-til-sist: ( utvalg tegn: (indeks + 1) ).
		
	} × antall. <- resultat.
}.

>> tilfeldig := ⚄ trekkFra: ?? lengde: ?? lengde.
Utdata skriv: (['x↵'] x tilfeldig lengde).
Utdata skriv: (['y↵'] y ?? lengde).

