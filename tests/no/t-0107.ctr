
Utdata skriv: ['Avbryt for-løkke, 0-4.'], stop.
{ :i
	Utdata skriv: ['iteration #'] + i, stop.
	(i = 4) avbryt.
} × 10.

>> x := 0.
>> xErMindreEnn10 := { <- ( x < 10 ). }.

Utdata skriv: ['Avbryt while-true-løkke, 0-4.'], stop.
{
	Utdata skriv: ['iteration #'] + x, stop.
	x legg-til: 1.
	((x < 5) ikke) avbryt.
} mens: xErMindreEnn10.

Utdata skriv: ['Avbryt while-false-løkke, 5,4.'], stop.
{
	Utdata skriv: ['iteration #'] + x, stop.
	x trekk-fra: 1.
	(x = 3) avbryt.
} mens: { <- (x > 0). }.

Utdata skriv: ['Avbryt times-løkke, 1-4.'], stop.
{ :i
	Utdata skriv: ['iteration #'] + i, stop.
	(i = 4) avbryt.
} × 5.

Utdata skriv: ['Avbryt blokk, ikke skriv ut linjen.'], stop.
{ Sann avbryt. Utdata skriv: ['ikke skriv dette!'], stop. } start.

Utdata skriv: ['Avbryt blokk, ikke utløs catch...'], stop.
{ Sann avbryt. Utdata skriv: ['ikke skriv dette!'], stop. } fang: { Utdata skriv: ['Ikke fang dette!']. }, start.

Utdata skriv: ['Test Liste each-løkke: 0,1'], stop.
(Liste ← 1 ; 2 ; 3) avbild: { :i
	Utdata skriv: ['iteration #'] + i, stop.
	(i = 1) avbryt.
}.

Utdata skriv: ['Test Ordbok each-løkke: bare c'], stop.
>> m := Ordbok ny.
m sett: ['first'] ved: ['a'], sett: ['second'] ved: ['b'], sett: ['tredje'] ved: ['c'].
m hver: { :k :v
	Utdata skriv: ['iteration'] + v + k, stop.
	Sann avbryt.
}.

