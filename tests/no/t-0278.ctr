>> To-Do := Objekt ny.

To-Do ved: ['ny'] gjør: {
	egen list := Liste ny.
}.

To-Do ved: ['nieuw'] gjør: {
	egen list := Liste ny.
}.

To-Do ved: ['+'] gjør: { :task
	egen list legg-til-sist: task.
}.

To-Do ved: ['number of tasks?'] gjør: { <-  egen list antall.
}.

>> todos := 
	To-Do ny 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Utdata skriv: ['You have $ tasks to do'] $ todos number of tasks?.
