>> Gjøremål := Objekt ny.

Gjøremål ved: ['ny'] gjør: {
	egen list := Liste ny.
}.

Gjøremål ved: ['nieuw'] gjør: {
	egen list := Liste ny.
}.

Gjøremål ved: ['+'] gjør: { :oppgave
	egen list legg-til-sist: oppgave.
}.

Gjøremål ved: ['number of tasks?'] gjør: { <-  egen list antall.
}.

>> gjøremålene := 
	Gjøremål ny 
	+ ['lage middag'] 
	+ ['rydde rommet'].
	
Utdata skriv: ['You have $ tasks to do'] $ gjøremålene number of tasks?.
