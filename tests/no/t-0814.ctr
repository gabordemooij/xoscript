# format for øktens informasjonskapsel, json-innholdstype, bare webprotokoller, svg vises inline
Server initialiser.
Program benytt: ['../../../src/xo/no/webtools.xo'].

>> Juks-Forespørsel := Objekt ny.
Juks-Forespørsel ved: ['value:'] gjør: { :verdi
	egen verdi := verdi.
}.
Juks-Forespørsel ved: ['cookie:'] gjør: { :navn
	<- egen verdi.
}.

>> Test-Økt := Midlertidig-fil-økt ny.
Test-Økt ved: ['last-inn'] gjør: {
	<- Ordbok ny.
}.
Test-Økt ved: ['øktens-id'] gjør: {
	<- egen id.
}.

>> informasjonskapsler := Liste ny
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

informasjonskapsler hver: { :i :informasjonskapsel
	>> forespørsel := Juks-Forespørsel ny.
	forespørsel value: informasjonskapsel.
	>> behandler := Test-Økt ny.
	>> web := Webdokument ny.
	web forespørsel: forespørsel.
	web øktbehandler: behandler.
	web start-økt.
	Utdata skriv: ( behandler øktens-id = informasjonskapsel ), stop.
}.

>> web := Webdokument ny.
web json: (Ordbok ny sett: ['b'] ved: ['a']).
Utdata skriv: ['\n'], stop.

{ Nettverk get: ['file:///etc/hostname']. } fang: { :e
	Utdata skriv: e, stop.
}, start.

>> svg := Fil ny: ['/tmp/test0814.svg'].
svg skriv: ['<svg xmlns="x"></svg>'].
Utdata stop.
Server videresend: ['test0814.svg'] prefiks: ['/tmp/'].
svg slett.
