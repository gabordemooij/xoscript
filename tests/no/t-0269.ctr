#Linux

(Fil ny: ['/tmp/testje']) finnes falsk: {
	Program system: ['mkdir /tmp/testje'].	
}.

(Fil ny: ['/tmp/testje/file1']) finnes falsk: {
	Program system: ['touch /tmp/testje/file1'].	
}.

(Fil ny: ['/tmp/testje/folder1']) finnes falsk: {
	Program system: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Fil liste: ['/tmp/testje'].

>> q := Liste ny.

l hver: { :k :v v hver: { :x :y q legg-til-sist: y. }. }.

>> s := q tekst.

(s inneholder: ['file1']) sann:   { Utdata skriv: ['OK'], stop. }.
(s inneholder: ['file2']) sann:   { Utdata skriv: ['XX'], stop. }.
(s inneholder: ['folder1']) sann: { Utdata skriv: ['OK'], stop. }.
