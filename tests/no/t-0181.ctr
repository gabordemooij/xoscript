

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program minnehåndtering: 0.

>> txt := ['World Salad'].
Utdata skriv: ['this text contains: '] + ( ( txt del: [' '] ) antall ) + [' words.'], stop.
txt := txt fra: 6 lengde: 4.
Utdata skriv: txt, stop.

Program rydd-opp.

usedMemory1 := (Program minne ? 0).


txt := ['World Salad'].
Utdata skriv: ['this text contains: '] + ( ( txt del: [' '] ) antall ) + [' words.'], stop.
txt := txt fra: 6 lengde: 4.
Utdata skriv: txt, stop.

Program rydd-opp.
usedMemory2 := (Program minne ? 0).


txt := ['World Salad'].
Utdata skriv: ['this text contains: '] + ( ( txt del: [' '] ) antall ) + [' words.'], stop.
txt := txt fra: 6 lengde: 4.
Utdata skriv: txt, stop.

Program rydd-opp.
usedMemory3 := (Program minne ? 0).



( usedMemory1 = usedMemory2 og: usedMemory1 = usedMemory3, og: usedMemory2 = usedMemory3 ) sann: {
	Utdata skriv: ['No memory leaks here'].
}, falsk: {
	Utdata skriv: ['Leaking memory...'].
}.
