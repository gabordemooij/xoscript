
>> Mål := Objekt ny.
Mål ved: ['is:'] gjør: { :tall
	tall ved: ['+'] gjør: { :tall
		>> enhet := tall betegnelse.
		>> faktor := 1.
		
		enhet
		tilfelle: ['inch'] gjør: { faktor := 0.0833. }.

		<- selv + (tall * faktor).
	}.
	<- tall.
}.

# Dette størrelsestallet kan brukes slik:

>> planke := Mål is: 6 foot.
>> kant := Mål is: 50 inch.

# Dette vises som: 10.165
Utdata skriv: planke + kant, stop.
