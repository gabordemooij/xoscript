
>> Size := Objekt ny.
Size ved: ['is:'] gjør: { :tall
	tall ved: ['+'] gjør: { :tall
		>> unit := tall betegnelse.
		>> factor := 1.
		
		unit
		tilfelle: ['inch'] gjør: { factor := 0.0833. }. <- selv + (tall * factor).
	}. <- tall.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Utdata skriv: plank + edge, stop.
