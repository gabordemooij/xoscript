>> str := ['write:'].
Utdata beskjed: ['skriv:'] argumenter: (Liste ← ['Hello World']), stop. 

Tall ved: ['isbetween:and:'] gjør: { :a :b <- ((selv ≥ a) og: (selv ≤ b)).
}.

str := ['isbetween:and:'].
Utdata skriv: (3 beskjed: str argumenter: (Liste ← 2 ; 8)), stop.
Utdata skriv: (3 beskjed: str argumenter: (Liste ← 1 ; 2)), stop.


>> CoffeeMachine := Objekt ny.
CoffeeMachine ved: ['makeCoffeeWithSugar:milk:'] gjør: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Liste ← 4 ; 2.
Utdata skriv: ( CoffeeMachine beskjed: order argumenter: coffeeConfiguration ), stop.
