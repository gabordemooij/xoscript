>> str := ['write:'].
Utdata beskjed: ['skriv:'] argumenter: (Liste ← ['Hello World']), stop. 

Tall ved: ['isbetween:and:'] gjør: { :a :b <- ((selv ≥ a) og: (selv ≤ b)).
}.

str := ['isbetween:and:'].
Utdata skriv: (3 beskjed: str argumenter: (Liste ← 2 ; 8)), stop.
Utdata skriv: (3 beskjed: str argumenter: (Liste ← 1 ; 2)), stop.


>> Kaffemaskin := Objekt ny.
Kaffemaskin ved: ['makeCoffeeWithSugar:milk:'] gjør: { :sugar :milk <- ( ['Vær så god... kaffe med '] + 
			sugar +
			[' skjeer sukker og '] +
			milk +
			[' dråper melk.']
	).
}.

>> bestilling := ['makeCoffeeWithSugar:milk:'].
>> kaffeKonfigurasjon := Liste ← 4 ; 2.
Utdata skriv: ( Kaffemaskin beskjed: bestilling argumenter: kaffeKonfigurasjon ), stop.
