Utdata skriv: ['Testobjekt'], stop.
>> a := Objekt ny. 
a ved: ['item:'] gjør: { :lst
	egen lst := lst. 
}.
a ved: ['vare'] gjør: {
	<- egen lst.
}.
a item: (
	Liste ny ; 1 ; (
		Liste ny ; ['a'] ; (
			Liste ny ; ( Moment ny: 1 )
		) ; ( Int64 fra-tekst: ['321'] )
	)
).
Utdata skriv: a vare, stop.
>> gammel-lst-adresse := a vare prototype minneadresse.
a save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== LASTER INN SNAP PÅ NYTT:'], stop.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b vare prototype minneadresse = gammel-lst-adresse) sann: {
	Utdata skriv: ['Objektlenke koblet til igjen.'], stop.
}.
Utdata skriv: ( b vare ), stop.
