>> Animal := Objekt ny.
Animal ved: ['make'] gjør: {
	>> animal := Objekt ny.
	animal ved: ['makeSound'] gjør: {
		Utdata skriv: egen sound.
	}. <- animal.
}.
>> Cat := Objekt ny.
Cat ved: ['make'] gjør: {
	>> cat := Animal make.
	cat ved: ['init'] gjør: {
		egen sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
