Program minnehåndtering: 4.

>> Dobler := Objekt ny.
>> Multiplikator := Objekt ny.
Dobler ved: ['doble:og:'] gjør: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplikator ved: ['gang:og:'] gjør: { :x :y <- (x × y).
}.

Utdata skriv: (
	Dobler doble:
		(Dobler doble: 
			(Multiplikator gang: 2 og: 3)
		og:
			(Multiplikator gang: 3 og: 4)
		)
	og:
		(Dobler doble: 
			(Multiplikator gang: 2 og: 3)
		og:
			(Multiplikator gang: 3 og: 4)
		)
), stop.
