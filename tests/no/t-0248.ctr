

Tekst ved: ['evaluer'] gjør: {
	>> code := Fil ny: ['/tmp/eval.ctr'].
	code skriv: selv tekst + ['.'].
	Program benytt: ['/tmp/eval.ctr'].
}.

>> a := (Liste ← (
	(Ordbok ny)
		sett: ['domene'] ved: ['mywebsite.com'],
		sett: (Liste ←
			((Ordbok ny)
				sett: ['hjem'] ved: ['title'],
				sett: ['<html></html>'] ved: ['body'],
				sett: ['2017-01-01'] ved: ['opprettet']
			) ;
			((Ordbok ny)
				sett: ['omoss(c)'] ved: ['title'],
				sett: ['<credits>Forfatter AS</credits>'] ved: ['body']
			)
		) ved: ['sider']
	)
) tekst.

Utdata skriv: a type, stop.
Utdata skriv: a, stop.

>> b := Ingenting.
(['b := '] + a) evaluer.
Utdata skriv: b ? 0 ? ['sider'] ? 1 ? ['body'], stop.

>> c := b ? 0.
>> d := c tekst.
Utdata skriv: d type, stop.

>> e := Ingenting.
(['e := '] + d) evaluer.
Utdata skriv: e ? ['sider'] ? 0, stop.
