


>> Kaffemaskin := Objekt ny.
Kaffemaskin ved: ['order:'] gjør: { :id
	>> coffee := ['Americano'].
	( id = 1 ) sann: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) sann: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) sann: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> EnkelKaffemaskin := Objekt ny.
EnkelKaffemaskin ved: ['bestilling'] gjør: { <- ['Svart']. }.
>> rødKopp := Kaffemaskin order: 1.
Utdata skriv: rødKopp, stop.
rødKopp := ['Te']. 
>> grønnKopp := Kaffemaskin order: 0.
Utdata skriv: grønnKopp, stop.
>> gulKopp := Kaffemaskin order: 1.
Utdata skriv: gulKopp, stop.
>> blåKopp := Kaffemaskin order: 0.
Utdata skriv: blåKopp, stop.
>> plastKopp := EnkelKaffemaskin bestilling.
plastKopp := ['Limonade']. 
>> svartKopp := EnkelKaffemaskin bestilling.
Utdata skriv: svartKopp, stop.
svartKopp legg-til-sist: [' neeei.... øl. '].
>> oransjeKopp := EnkelKaffemaskin bestilling.
Utdata skriv: oransjeKopp, stop.
