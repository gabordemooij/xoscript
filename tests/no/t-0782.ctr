Utdata skriv: ['Test object'], stop.
>> cmd := Kommando ny.
Utdata skriv: cmd ls /tmp, stop.
>> old-cmd-address := cmd prototype minneadresse.
cmd save-as: ['/tmp/a.bin'].
Utdata skriv: ['========== RELOADING SNAP:'], stop.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b prototype minneadresse = old-cmd-address) sann: {
	Utdata skriv: ['Object link re-attached.'], stop.
}.
Utdata skriv: b ls, stop.


