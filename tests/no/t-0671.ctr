# offentlig nøkkel (for å sikre API-er osv.)
Server init.

# generer nøkler
>> nøkler := Hvelv generer-nøkler.

# privat (hemmelig) nøkkel
>> sk := nøkler første.

# offentlig nøkkel
>> pk := nøkler siste.

# signer en melding
>> sig := Hvelv signer: ['abc'] med: sk.

# kontroller melding (ok)
Utdata skriv: ( 
	Hvelv
		kontroller: ['abc'] 
		signatur: sig 
		med: pk 
), stop.

# kontroller melding (feiler)
Utdata skriv: ( 
	Hvelv 
		kontroller: ['abd'] 
		signatur: sig 
		med: pk 
), stop.