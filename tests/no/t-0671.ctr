# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Hvelv generer-nøkler.

# private (secret) key
>> sk := keys første.

# public key
>> pk := keys siste.

# sign a message
>> sig := Hvelv signer: ['abc'] med: sk.

# check message (ok)
Utdata skriv: ( 
	Hvelv
		kontroller: ['abc'] 
		signatur: sig 
		med: pk 
), stop.

# check message (fail)
Utdata skriv: ( 
	Hvelv 
		kontroller: ['abd'] 
		signatur: sig 
		med: pk 
), stop.