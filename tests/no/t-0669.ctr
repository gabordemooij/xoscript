# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Hvelv 
	passord-hash: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Hvelv 
	passord-hash: hash bekreft: a1.
	# fail 
>> b := Hvelv
	passord-hash: hash bekreft: a2.
	# ok!

Utdata skriv: a, stop.
Utdata skriv: b, stop.

