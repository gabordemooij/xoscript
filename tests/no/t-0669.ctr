# Hashing av passord
Server init.

# Brukeren angir et passord
>> kode := ['pass123'].

# Du lagrer det slik
>> hashverdi := Hvelv 
	passord-hash: kode.

# Deretter logger brukeren inn
# Forsøk 1
>> a1 := ['abcd123'].
# Forsøk 2
>> a2 := ['pass123'].

# Bekreft
>> a := Hvelv 
	passord-hash: hashverdi bekreft: a1.
	# feiler 
>> b := Hvelv
	passord-hash: hashverdi bekreft: a2.
	# ok!

Utdata skriv: a, stop.
Utdata skriv: b, stop.

