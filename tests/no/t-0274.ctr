

Liste ved: ['column:'] gjør: { :kolonne
	>> resultat := Liste ny.
	selv hver: { :indeks :rad
		rad hver: { :indeks :celle
			(indeks = kolonne) sann: { resultat legg-til-sist: celle. }.
		}.
	}. <- resultat.
}.


>> a := Liste ←
	(Liste ← 1 ; 2 ; 3) ;
	(Liste ← 4 ; 5 ; 6) ;
	(Liste ← 7 ; 8 ; 9).

>> b := a column: 1.
Utdata skriv: b, stop.

b := a column: 20.
Utdata skriv: b, stop.

b := a column: -100.
Utdata skriv: b, stop.
