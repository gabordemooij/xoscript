Utdata skriv: ['1,2,3,4,5,6,7,8,9,A,'], stop.
>> Scope := Objekt ny.
Scope ved: ['initialize:'] gjør: { :x egen property := x. }.
Scope ved: ['confirm'] gjør: { Utdata skriv: [',']. }.
Scope ved: ['test'] gjør: {
	Utdata skriv: egen property.
	selv confirm.
	( 1 = 1 ) sann: { Utdata skriv: egen property. selv confirm. }.
	( 1 = 0 ) falsk: { Utdata skriv: egen property. selv confirm. }.
	>> y := 2. { Utdata skriv: egen property. selv confirm. } mens: { y trekk-fra: 1. <- (y > 0). }.
	{ Utdata skriv: egen property. selv confirm. } × 1.
	(Liste ← 1) hver: {  Utdata skriv: egen property. selv confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Ordbok ny one: ['item']) hver: { Utdata skriv: egen property. selv confirm. }.
	{ 1 ÷ 0. } fang: { Utdata skriv: egen property. selv confirm. }, start.
	Utdata stop.
}.
>> scope1 := Scope ny.
scope1 initialize: ['X'].
scope1 test.
>> function := { 
	egen property := ['Y'].
	Utdata skriv: egen property.
	selv confirm.
	( 1 = 1 ) sann: { Utdata skriv: egen property. selv confirm. }.
	( 1 = 0 ) falsk: { Utdata skriv: egen property. selv confirm. }.
	>> y := 2. { Utdata skriv: egen property. selv confirm. } mens: { y trekk-fra: 1. <- (y > 0). }.
	{ Utdata skriv: egen property. selv confirm. } × 1.
	(Liste ← 1) hver: {  Utdata skriv: egen property. selv confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Ordbok ny one: ['item']) hver: { Utdata skriv: egen property. selv confirm. }.
	{ 1 ÷ 0. } fang: { Utdata skriv: egen property. selv confirm. }, start.
	Utdata stop.
}.
function ved: ['confirm'] gjør: { Utdata skriv: [',']. }.
function bruk: 1 og: 2.
