>> a := 3.
>> b := a kopier.
a trekk-fra: 1.
Utdata skriv: [' a = '] + a.
Utdata skriv: [' b = '] + b.
a := 3.
b := a + 4.
Utdata skriv: [' a = '] + a.
Utdata skriv: [' b = '] + b.
>> x := 3.
>> y := x kopier.
x legg-til: 10.
y trekk-fra: 1.
Utdata skriv: [' x = '] + x.
Utdata skriv: [' y = '] + y.
>> q := Objekt ny.
q ved: ['setProperty:'] gjør: { :x
	egen prop := x.
}.
q ved: ['getProperty'] gjør: { <- egen prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Utdata skriv: [' p = '] + (p getProperty).
