>> q := Lis ← 1 ; 2 ; 3.
{ q ? ['1']. } trape: { Sòti ekri: ['caught!'], nouvo-liy. }, lanse.
{ q ? Vre. } trape: { Sòti ekri: ['caught!'], nouvo-liy. }, lanse.
{ q ? Fo. } trape: { Sòti ekri: ['caught!'], nouvo-liy. }, lanse.
{ q ? Anyen. } trape: { Sòti ekri: ['caught!'], nouvo-liy. }, lanse.
{ q ? (Lis nouvo). } trape: { Sòti ekri: ['caught!'], nouvo-liy. }, lanse.
{ q ? (Objè nouvo). } trape: { Sòti ekri: ['caught!'], nouvo-liy. }, lanse.
{ q ? ({ ['Empty']. }). } trape: { Sòti ekri: ['caught!'], nouvo-liy. }, lanse.
Sòti ekri: ['caught them all'], nouvo-liy.
