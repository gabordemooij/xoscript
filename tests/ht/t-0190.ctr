#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Pwogram jesyon-memwa: 0.

{
Moman tan.
Moman tann: 1.
Sòti ekri: Pwogram kantite-agiman, nouvo-liy.
Pwogram agiman: 0.
Nimewo random.
Sòti ekri: (Pwogram sistèm: ['echo 'Hello'']).
} lanse.

Pwogram netwaye.
usedMemory1 := (Pwogram memwa ? 0).

{
Moman tan.
Moman tann: 1.
Sòti ekri: Pwogram kantite-agiman, nouvo-liy.
Pwogram agiman: 0.
Nimewo random.
Sòti ekri: (Pwogram sistèm: ['echo 'Hello'']).
} lanse.

Pwogram netwaye.
usedMemory2 := (Pwogram memwa ? 0).

{
Moman tan.
Moman tann: 1.
Sòti ekri: Pwogram kantite-agiman, nouvo-liy.
Pwogram agiman: 0.
Nimewo random.
Sòti ekri: (Pwogram sistèm: ['echo 'Hello'']).
} lanse.

Pwogram netwaye.
usedMemory3 := (Pwogram memwa ? 0).



( usedMemory1 = usedMemory2 ak: usedMemory1 = usedMemory3, ak: usedMemory2 = usedMemory3 ) vre: {
	Sòti ekri: ['No memory leaks here'].
}, fo: {
	Sòti ekri: ['Leaking memory...'].
}.
