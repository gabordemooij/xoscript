
>> dictionary := (
	Diksyonè nouvo
		mete: ['b'] nan: ['a'],
		mete: ['a'] nan: ['b'],
		mete: ['z'] nan: ['x'],
		mete: ['hello'] nan: ['hallo'],
		mete: ['human'] nan: ['human']
).

>> comparisons := Lis nouvo.
dictionary chak: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a konpare: b)
	).
}.

comparisons triye: { :a :b <- ( a konpare: b ). }.
Sòti ekri: ( comparisons kole-ansanm: ['↵'] ), nouvo-liy.
comparisons kole-ansanm: ['↵'].
