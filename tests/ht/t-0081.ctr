>> map1 := Diksyonè nouvo.
>> key1 := Lis nouvo.
>> key2 := Lis nouvo.

map1
	mete: ['hello'] nan: key1,
	mete: ['world'] nan: key2.


Sòti
	ekri: ['Map #1 contains: '] + (map1 nan: key1),
	ekri: [' and '] + (map1 nan: key2), nouvo-liy.

>> KeyeableArray := Lis nouvo.
KeyeableArray lè: ['toString'] fè: { <- (tèt-li konte) toString.
}.

>> map2 := Diksyonè nouvo.
key1 := KeyeableArray nouvo.
key2 := KeyeableArray nouvo.

key1 ajoute-nan-fen: 1.

map2
	mete: ['hello'] nan: key1,
	mete: ['world'] nan: key2.

Sòti
	ekri: ['Map #2 contains: '] + (map2 nan: key1),
	ekri: [' and '] + (map2 nan: key2), nouvo-liy.
