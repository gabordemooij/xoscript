

Tèks lè: ['evaluate'] fè: {
	>> kòd := Fichye nouvo: ['/tmp/eval.ctr'].
	kòd ekri: tèt-li tèks + ['.'].
	Pwogram itilize: ['/tmp/eval.ctr'].
}.

>> a := (Lis ← (
	(Diksyonè nouvo)
		mete: ['domain'] nan: ['mywebsite.com'],
		mete: (Lis ←
			((Diksyonè nouvo)
				mete: ['home'] nan: ['title'],
				mete: ['<html></html>'] nan: ['body'],
				mete: ['2017-01-01'] nan: ['created']
			) ;
			((Diksyonè nouvo)
				mete: ['aboutus(c)'] nan: ['title'],
				mete: ['<credits>Author Inc.</credits>'] nan: ['body']
			)
		) nan: ['pages']
	)
) tèks.

Sòti ekri: a kalite, nouvo-liy.
Sòti ekri: a, nouvo-liy.

>> b := Anyen.
(['b := '] + a) evaluate.
Sòti ekri: b ? 0 ? ['pages'] ? 1 ? ['body'], nouvo-liy.

>> c := b ? 0.
>> d := c tèks.
Sòti ekri: d kalite, nouvo-liy.

>> e := Anyen.
(['e := '] + d) evaluate.
Sòti ekri: e ? ['pages'] ? 0, nouvo-liy.
