Server init.

Sòti ekri: (
	Modèl nouvo: ['^\\w+$'],
	koresponn: ['test@example.com'] 
), nouvo-liy. # 0 match, fails on @ and .

Sòti ekri: (
	Modèl nouvo: ['^[^@]+@[^\.]+\.\\w+$'],
	koresponn: ['test@example.com'] 
), nouvo-liy. # 1 match

Sòti ekri: (
	Modèl nouvo: ['[^@]+@[^\.]+\.\\w+'],
	koresponn: ['test@example.com'] 
), nouvo-liy. # 1 match

Sòti ekri: (
	Modèl nouvo: ['([^@]+)@([^\.]+)\.\\w+'],
	koresponn: ['test@example.com'] 
), nouvo-liy. # 1 match, groups dont matter

Sòti ekri: (
	Modèl nouvo: ['[a-z]'],
	koresponn: ['test@example.com'] 
), nouvo-liy. # 14 matches

Sòti ekri: (
	Modèl nouvo: ['.*'],
	koresponn: ['test@example.com'] 
), nouvo-liy. # 1 match (all)

Sòti ekri: (
	Modèl nouvo: ['(.*)'],
	koresponn: ['test@example.com'] 
), nouvo-liy. # 1 match (all)

Sòti ekri: (
	Modèl nouvo: ['\\s*[^@]+@[^\.]+\.\\w+'],
	koresponn: ['test@example.com'] 
), nouvo-liy. # 1 match, prefix space optional, gets ignored