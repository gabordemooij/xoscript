# a value ending in the first part of an opening quote must survive serialization
>> valè-yo := Lis nouvo
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

valè-yo chak: { :i :value
	>> d := Diksyonè nouvo.
	d mete: value nan: ['k'].
	d mete: ['second'] nan: ['j'].
	>> r := d kòd objè.
	Sòti ekri: r konte, nouvo-liy.
	Sòti ekri: ( (r nan: ['k']) = value ), nouvo-liy.
}.
