# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Pwogram shell-escape: ['abc'].
Sòti ekri: c, nouvo-liy.
Sòti ekri: ( Pwogram sistèm: ['echo '] + c ), nouvo-liy.

c := Pwogram shell-escape: ['a'b'c'].
Sòti ekri: c, nouvo-liy.
Sòti ekri: ( Pwogram sistèm: ['echo '] + c ), nouvo-liy.

c := Pwogram shell-escape: ['a\'c'].
Sòti ekri: c, nouvo-liy.
Sòti ekri: ( Pwogram sistèm: ['echo '] + c ), nouvo-liy.