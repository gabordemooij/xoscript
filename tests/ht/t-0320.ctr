


>> CoffeeMachine := Objè nouvo.
CoffeeMachine lè: ['order:'] fè: { :id
	>> coffee := ['Americano'].
	( id = 1 ) vre: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) vre: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) vre: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Objè nouvo.
SimpleCoffeeMachine lè: ['order'] fè: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Sòti ekri: redCup, nouvo-liy.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Sòti ekri: greenCup, nouvo-liy.
>> yellowCup := CoffeeMachine order: 1.
Sòti ekri: yellowCup, nouvo-liy.
>> blueCup := CoffeeMachine order: 0.
Sòti ekri: blueCup, nouvo-liy.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Sòti ekri: blackCup, nouvo-liy.
blackCup ajoute-nan-fen: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Sòti ekri: orangeCup, nouvo-liy.
