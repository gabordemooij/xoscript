

# create a 64-bit integer for exact calculations
>> a := Int64 apati-tèks: ['123'].

# to string
Sòti ekri: a, nouvo-liy.

# divide
Sòti ekri: a / (Int64 apati-tèks: ['3']), nouvo-liy.

# multiply
Sòti ekri: a * (Int64 apati-tèks: ['2']), nouvo-liy.

# add
Sòti ekri: a + (Int64 apati-tèks: ['1']), nouvo-liy.

# subtract
Sòti ekri: a - (Int64 apati-tèks: ['2']), nouvo-liy.

# compare
Sòti ekri: ( a =   (Int64 apati-tèks: ['123'])), nouvo-liy.
Sòti ekri: ( a !=: (Int64 apati-tèks: ['124'])), nouvo-liy.
Sòti ekri: ( a <   (Int64 apati-tèks: ['124'])), nouvo-liy.
Sòti ekri: ( a >   (Int64 apati-tèks: ['122'])), nouvo-liy.
Sòti ekri: ( a >=: (Int64 apati-tèks: ['123'])), nouvo-liy.
Sòti ekri: ( a <=: (Int64 apati-tèks: ['123'])), nouvo-liy.





	