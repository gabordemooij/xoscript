['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Sòti ekri: (x + y), nouvo-liy.

>> x := 10040.07.
>> y := 10305.60.

Sòti ekri: (x + y), nouvo-liy.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Sòti ekri: (x + y + z), nouvo-liy.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Sòti ekri: (x + y + z), nouvo-liy.

>> q := 0.1.2.

Sòti ekri: (q), nouvo-liy.

>> q := 012.

Sòti ekri: (q), nouvo-liy.
