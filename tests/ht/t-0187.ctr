Nimewo lè: ['factorial'] fè: {
	>> total := 1.
	{ :index total miltipliye-pa: (tèt-li - index). } × tèt-li. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Pwogram jesyon-memwa: 0.

{
2 exponent factorial.
Sòti ekri: (11 rès: 3), nouvo-liy.
Sòti ekri: (3.4 awondi), nouvo-liy.
Sòti ekri: (7.1 awondi-anwo), nouvo-liy.
Sòti ekri: (7.9 awondi-anba), nouvo-liy.
}
lanse.

Pwogram netwaye.

usedMemory1 := (Pwogram memwa ? 0).

{
2 exponent factorial.
Sòti ekri: (11 rès: 3), nouvo-liy.
Sòti ekri: (3.4 awondi), nouvo-liy.
Sòti ekri: (7.1 awondi-anwo), nouvo-liy.
Sòti ekri: (7.9 awondi-anba), nouvo-liy.
}
lanse.

Pwogram netwaye.
usedMemory2 := (Pwogram memwa ? 0).


{
2 exponent factorial.
Sòti ekri: (11 rès: 3), nouvo-liy.
Sòti ekri: (3.4 awondi), nouvo-liy.
Sòti ekri: (7.1 awondi-anwo), nouvo-liy.
Sòti ekri: (7.9 awondi-anba), nouvo-liy.
} lanse.

Pwogram netwaye.
usedMemory3 := (Pwogram memwa ? 0).



( usedMemory1 = usedMemory2 ak: usedMemory1 = usedMemory3, ak: usedMemory2 = usedMemory3 ) vre: {
	Sòti ekri: ['No memory leaks here'].
}, fo: {
	Sòti ekri: ['Leaking memory...'].
}.
