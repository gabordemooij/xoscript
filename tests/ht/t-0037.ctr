>> a := 3.
>> b := a kopye.
a soustrè: 1.
Sòti ekri: [' a = '] + a.
Sòti ekri: [' b = '] + b.
a := 3.
b := a + 4.
Sòti ekri: [' a = '] + a.
Sòti ekri: [' b = '] + b.
>> x := 3.
>> y := x kopye.
x ajoute: 10.
y soustrè: 1.
Sòti ekri: [' x = '] + x.
Sòti ekri: [' y = '] + y.
>> q := Objè nouvo.
q lè: ['setProperty:'] fè: { :x
	pwòp prop := x.
}.
q lè: ['getProperty'] fè: { <- pwòp prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Sòti ekri: [' p = '] + (p getProperty).
