# catch-all test (practical)
>> HTML := Tèks nouvo.
HTML lè: ['encode:'] fè: { :tekst
	tèt-li ajoute-nan-fen: (tekst
	ranplase: ['&'] ak: ['&amp;'], 
	ranplase: ['<'] ak: ['&lt;'],
	ranplase: ['>'] ak: ['&gt;'],
	ranplase: ['"'] ak: ['&quot;']).
}.
>> blog := HTML nouvo.
blog ajoute-nan-fen: ['<h1>'],
     encode: ['Koffie & Thee'],
     ajoute-nan-fen: ['</h1>'].
Sòti ekri: blog, nouvo-liy.


>> Roman := Nimewo nouvo.
Roman lè: ['stringy'] fè: {
	>> a := [''].
	{ a ajoute-nan-fen: ['I']. } × tèt-li. <- a.
}.

>> x := Roman nouvo.
x ajoute: 3.
Sòti ekri: x stringy, nouvo-liy.

>> Quantum := Boulyen nouvo.
Quantum lè: ['true?'] fè: { <- ['maybe True']. }.
Sòti ekri: (Quantum nouvo true?), nouvo-liy.

>> Nihil := Anyen nouvo.
Nihil lè: ['tèks'] fè: { <- ['Nihil']. }.
Sòti ekri: (Nihil nouvo), nouvo-liy.
