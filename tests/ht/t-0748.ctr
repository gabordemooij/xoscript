Sòti ekri: ['Test object'], nouvo-liy.
>> a := Objè nouvo. 

a lè: ['item:'] fè: { :boulyen
	pwòp boulyen := boulyen. 
}.

a lè: ['item'] fè: { <- pwòp boulyen.
}.

a item: Vre.

Sòti ekri: a item, nouvo-liy.

>> old-bool-address := a item pwototip adrès-memwa.
a save-as: ['/tmp/a.bin'].
Sòti ekri: ['========== RELOADING SNAP:'], nouvo-liy.

>> b := Objè load-from: ['/tmp/a.bin'].

(b item pwototip adrès-memwa = old-bool-address) vre: {
	Sòti ekri: ['Object link re-attached.'], nouvo-liy.
}.

Sòti ekri: b item, nouvo-liy.
