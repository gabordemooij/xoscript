>> Slurp := Objè nouvo.

Slurp lè: ['nouvo'] fè: {
	pwòp str := [''].
}.

Slurp lè: ['reponn:'] fè: { :blah
		(pwòp str = ['']) vre: {
			pwòp str ajoute-nan-fen: blah.
		}, sinon: {
			pwòp str ajoute-nan-fen: [' '].
			pwòp str ajoute-nan-fen: blah.
		}.
}.

Slurp lè: ['reponn:ak:'] fè: { :blah :blahah
		(blah longè > 1) vre: {
			pwòp str ajoute-nan-fen: (blah soti-nan: 0 longè: (blah longè - 1)).
		}, sinon: {
			pwòp str ajoute-nan-fen: blah.
		}.
		pwòp str ajoute-nan-fen: [' '].
		pwòp str ajoute-nan-fen: blahah.
}.

Slurp lè: ['obtain'] fè: {
	>> buffer := pwòp str.
	pwòp str := ['']. <- buffer.
}.


>> x := Slurp nouvo.
x + 3.
Sòti ekri: (x obtain), nouvo-liy.
x echo: ['Hello world'].
Sòti ekri: (x obtain), nouvo-liy.
x tellme: 123 and: 987.
Sòti ekri: (x obtain), nouvo-liy.
