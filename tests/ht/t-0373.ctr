# compliance test

# use international numbers

Sòti ekri: ['1000 -> '].
Sòti ekri: 1000, nouvo-liy. #1000

Sòti ekri: ['1.5 -> '].
Sòti ekri: 1.5, nouvo-liy.  #1.5

Sòti ekri: ['1001.5 -> '].
Sòti ekri: 1.5 + 1000, nouvo-liy. #1001.5

# use 0-indexed arrays
>> x := Lis nouvo ; 1 ; 2 ; 3.
>> y := Lis nouvo ; ['a'] ; ['b'] ; ['c'].

Sòti ekri: ['1 -> '].
Sòti ekri: x ? 0, nouvo-liy. #1

Sòti ekri: ['1 -> '].
Sòti ekri: (x nan: 0), nouvo-liy. #1

Sòti ekri: ['1 -> '].
Sòti ekri: x premye, nouvo-liy. #1

Sòti ekri: ['3 -> '].
Sòti ekri: x dènye, nouvo-liy. #3

Sòti ekri: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Sòti ekri: (x dapre: y), nouvo-liy.

Sòti ekri: ['1 -> '].
Sòti ekri: (x soti-nan: 0 longè: 1) premye, nouvo-liy. #1

Sòti ekri: ['0 -> '].
Sòti ekri: (x jwenn: 1), nouvo-liy. #0

x mete: 9 nan: 0.

Sòti ekri: ['9 -> '].
Sòti ekri: (x nan: 0), nouvo-liy. #9

x ajoute-nan-kòmansman: 8.
Sòti ekri: ['8 -> '].
Sòti ekri: (x nan: 0), nouvo-liy. #9


x ajoute-nan-fen: 10.
Sòti ekri: ['10 -> '].
Sòti ekri: (x nan: 4), nouvo-liy. #10








