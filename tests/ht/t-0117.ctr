>> t := Vre.
(t = Vre) vre: { Sòti ekri: ['T']. }.
(t = Fo) vre: { Sòti ekri: ['F']. }.
Sòti ekri: ['|'].
>> t := Fo.
(t = Vre) vre: { Sòti ekri: ['T']. }.
(t = Fo) vre: { Sòti ekri: ['F']. }.
Sòti ekri: ['|'].
>> f := Vre.
(t = Vre ak: f = Fo) vre: { Sòti ekri: ['T']. }.
(t = Fo ak: f = Vre) vre: { Sòti ekri: ['F']. }.
Sòti ekri: ['|'].
>> n := Anyen.
(n Anyen?) vre: { Sòti ekri: ['T']. }.
(n Anyen?) fo: { Sòti ekri: ['F']. }.
Sòti ekri: ['|'].
(f Boolean?) vre: { Sòti ekri: ['T']. }.
(f Boolean?) fo: { Sòti ekri: ['F']. }.



