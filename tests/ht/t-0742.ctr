Sòti ekri: ['Test object'], nouvo-liy.
>> a := Objè nouvo. 

a lè: ['item:'] fè: { :hexhelper
	pwòp hexhelper := hexhelper. 
}.

a lè: ['item'] fè: { <- pwòp hexhelper.
}.

a item: Hx nouvo.

>> old-hexhelper-address := a item pwototip adrès-memwa.
a save-as: ['/tmp/a.bin'].
Sòti ekri: ['========== RELOADING SNAP:'], nouvo-liy.

>> b := Objè load-from: ['/tmp/a.bin'].

(b item pwototip adrès-memwa = old-hexhelper-address) vre: {
	Sòti ekri: ['Object link re-attached.'], nouvo-liy.
}.
