# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Kòfrefò 
	rache-modpas: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Kòfrefò 
	rache-modpas: hash verifye: a1.
	# fail 
>> b := Kòfrefò
	rache-modpas: hash verifye: a2.
	# ok!

Sòti ekri: a, nouvo-liy.
Sòti ekri: b, nouvo-liy.

