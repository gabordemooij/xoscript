Server init.

>> DB := Maria-DB nouvo lame: ['localhost'],
	non-itilizatè: ['xo'],
	modpas: ['pass123'],
	non-baz: ['xobase'],
	konekte.

{
	DB rekèt:
	['DROP TABLE movies'],
	egzekite.
} trape: { Anyen. }, lanse.

DB rekèt:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
egzekite.

DB rekèt: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
paramèt-yo: ( Lis nouvo ; ['Halloween'] ),
egzekite.

DB rekèt: ['SELECT * FROM movies'],
chache: { :movie
	Sòti ekri: movie title, nouvo-liy.
}.

