
Tèks lè: ['evaluate'] fè: {
	>> kòd := Fichye nouvo: ['/tmp/eval.ctr'].
	kòd ekri: (tèt-li tèks + ['.']).
	Pwogram itilize: ['/tmp/eval.ctr'].
}.

>> map :=
	(Diksyonè nouvo)
	mete: ['Hi There'] nan: ['two'],
	mete: (Lis ← ['hello'] ; ['world'] ; (Lis ← 1 ; 2; 9) ; Fo) nan: ['one'],
	mete: ( (Diksyonè nouvo) mete: ['wrrld'] nan: ['misspelled'] ) nan: ['three'],
	mete: (Lis ← ((Diksyonè nouvo) mete: ['treasure'] nan: ['hidden']) ; 2) nan: ['four']. 
>> str := map tèks.
>> map2 := Anyen.
(['map2 := '] + str ) evaluate.
Sòti ekri: map2 ? ['one'] ? 0.
Sòti ekri: map2 ? ['one'] ? 1.
Sòti ekri: map2 ? ['four'] ? 0 ? ['hidden'].
Sòti ekri: map2 ? ['one'] ? 2 ? 2.
