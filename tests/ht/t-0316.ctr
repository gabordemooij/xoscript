>> Grandfather := Objè nouvo.
Grandfather lè: ['greet'] fè: {
	Sòti ekri: ['Ave!'], nouvo-liy.
}.
>> Father := Grandfather nouvo.
Father lè: ['greet'] fè: {
	Sòti ekri: ['Hello'], nouvo-liy.
	tèt-li greet.
}.
>> Son := Father nouvo.
Son lè: ['greet'] fè: {
	Sòti ekri: ['Hi'], nouvo-liy.
	tèt-li greet.
}.

Son greet.

>> Roundabout := Objè nouvo.
Roundabout lè: ['circle:'] fè: { :x
	Sòti ekri: x, nouvo-liy.
	(x < 3) vre: { tèt-li rekisif circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) vre: { Sòti ekri: x, nouvo-liy. x ajoute: 1.  increment lanse. }. }.
increment lanse.