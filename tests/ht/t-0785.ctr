Sòti ekri: ['Test object'], nouvo-liy.
>> a := Objè nouvo. 

a lè: ['item:'] fè: { :moment
	pwòp moment := moment. 
}.

a lè: ['item'] fè: { <- pwòp moment.
}.

>> today := Lis nouvo ; ( Moman nouvo zòn: ['CEST'], ane: 2026, mwa: 7 ).
a item: today.
Sòti ekri: a item ? 0, nouvo-liy.
a save-as: ['/tmp/a.bin'].
