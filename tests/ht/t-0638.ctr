
Server init.
>> rq := Demann-HTTP nouvo.
Sòti ekri: ['HTTP-GET d[]=']  + ( rq get-lis: ['d[]'] ), nouvo-liy. # GET
Sòti ekri: ['HTTP-GET f[]=']  + ( rq get-lis: ['f[]'] ), nouvo-liy. # GET
Sòti ekri: ['HTTP-POST e[]='] + ( rq post-lis: ['e[]'] ), nouvo-liy. # GET
Sòti ekri: ['HTTP-POST c=']   + ( rq post: ['c'] ), nouvo-liy. # GET
Sòti ekri: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), nouvo-liy. # GET
