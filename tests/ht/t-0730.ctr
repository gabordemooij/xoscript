Sòti ekri: ['Test object'], nouvo-liy.
>> a := Objè nouvo. 

a lè: ['item:'] fè: { :moment
	pwòp moment := moment. 
}.

a lè: ['item'] fè: { <- pwòp moment.
}.

>> today := Moman nouvo zòn: ['CEST'], ane: 2026, mwa: 7.
a item: today.
Sòti ekri: a item, nouvo-liy.
a save-as: ['/tmp/a.bin'].
Sòti ekri: ['========== RELOADING SNAP:'], nouvo-liy.
>> b := Objè load-from: ['/tmp/a.bin'].
Sòti ekri: b item, nouvo-liy.
