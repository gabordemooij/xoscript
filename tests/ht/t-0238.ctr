Tèks lè: ['evaluate'] fè: {
	>> kòd := Fichye nouvo: ['/tmp/eval.ctr'].
	kòd ekri: (tèt-li tèks + ['.']).
	Pwogram itilize: ['/tmp/eval.ctr'].
}.

>> a := Lis ← 1 ; 2 ; 3.
>> b := (a tèks).

Sòti ekri: b, nouvo-liy. 
(['b := '] + b) evaluate.

Sòti ekri: b ? 2, nouvo-liy. 

Sòti ekri: (( Lis ← 1 ; 2 ; 3 )), nouvo-liy. 

Sòti ekri: ((Diksyonè nouvo) mete: 1 nan: 2), nouvo-liy. 

>> x := ( (Lis ← 1 ; ( Lis ← 9 ) ; Vre ) ) tèks.
Sòti ekri: x, nouvo-liy. 
(['x := '] + x) evaluate.

Sòti ekri: x ? 1 ? 0, nouvo-liy. 

>> y := (Diksyonè nouvo) mete: (Lis ← 1) nan: (Lis ← 2).
Sòti ekri: y, nouvo-liy. 

(['y := '] + y) tèks evaluate.

Sòti ekri: (y nan: (Lis ← 2) tèks ), nouvo-liy.

Sòti ekri: (Lis nouvo), nouvo-liy. 
Sòti ekri: (Diksyonè nouvo), nouvo-liy. 
