

>> Matryoshka := Objè nouvo.
Matryoshka lè: ['double:'] fè: { :secret
	pwòp secret := secret × 2.
}.
Matryoshka lè: ['nouvo:'] fè: { :secret
	>> answer := Anyen.
	>> t := (secret > 255).
	Sòti ekri: (secret + [' | '] + t), nouvo-liy.
	t vre: {
		answer := secret.
	}, sinon: {
		answer := Matryoshka rekisif nouvo: (tèt-li double: secret).
	}. <- answer.
}.

>> x := Matryoshka nouvo: 2.
