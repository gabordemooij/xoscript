60 × {
	>> x := (Nimewo random % 6) + 1.
	(x ≤ 6) fo: { Sòti ekri: ['FAIL']. }.
	(x ≥0) fo: { Sòti ekri: ['FAIL']. }.
	x := (Nimewo random % 3) + 1.
	(x < 3) fo: { Sòti ekri: ['FAIL']. }.
	(x>-1) fo: { Sòti ekri: ['FAIL']. }.
	x := ((Boulyen flip) nimewo).
	(x = 0 oswa: x = 1) fo: { Sòti ekri: ['FAIL']. }.
	x := ((Vre flip) nimewo).
	(x = 0 oswa: x = 1) fo: { Sòti ekri: ['FAIL']. }.
	x := (Boulyen flip swa: ['HEAD'] oswa: ['TAIL']).
	((x = ['HEAD']) oswa: (x = ['TAIL'])) fo: { Sòti ekri: ['FAIL']. }.
}.
Sòti ekri: ['DONE'].

