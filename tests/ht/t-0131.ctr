
>> a := Lis ← (Lis ← 100 ; 200 ; 300) ; (Lis ← 9 ; 8 ; 7).
Sòti ekri: ['at 0,1 :'].
Sòti ekri: a ? 0 ? 1, nouvo-liy. 
Sòti ekri: ['at 1,2 :'].
Sòti ekri: a ? 1 ? 2, nouvo-liy. 
>> menu := Diksyonè nouvo.
menu mete: (Lis ← ['pizza'] ; ['spaghetti']) nan: ['Italian Cuisine'].
menu mete: (Lis ← ['bifteki'] ; ['suflaki']) nan: ['Greek Cuisine'].
Sòti ekri: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), nouvo-liy. 
Sòti ekri: ['but not on the same plate.'], nouvo-liy.
