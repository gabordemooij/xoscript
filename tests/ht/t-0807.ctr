# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB nouvo lame: ['localhost'],
	non-itilizatè: ['xo'],
	modpas: ['pass123'],
	non-baz: ['xobase'],
	konekte.

>> paramèt-rechèch := db rekèt: ['SELECT %% FROM'].
{ paramèt-rechèch egzekite. } trape: { :e
	Sòti ekri: ( e gen-ladan: ['%%'] ), nouvo-liy.
}, lanse.
