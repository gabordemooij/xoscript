>> Greeter := Objè nouvo.
Greeter lè: ['make'] fè: {
	>> gr := Objè nouvo.
	gr lè: ['setName:'] fè: { :aname
		pwòp non := aname.
	}.
	gr lè: ['greet'] fè: {
		Sòti ekri: pwòp non.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a nouvo.
c setName: ['THREE'].
c greet.
>> d := a nouvo.
d setName: ['FOUR'].
d greet.
c greet.
