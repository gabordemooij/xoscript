Sòti ekri: ['Test object'], nouvo-liy.
>> a := Objè nouvo. 
a lè: ['item:'] fè: { :lst
	pwòp lst := lst. 
}.
a lè: ['item'] fè: { <- pwòp lst.
}.
a item: (
	Lis nouvo ; 1 ; (
		Lis nouvo ; ['a'] ; (
			Lis nouvo ; ( Moman nouvo: 1 )
		) ; ( Int64 apati-tèks: ['321'] )
	)
).
Sòti ekri: a item, nouvo-liy.
>> old-lst-address := a item pwototip adrès-memwa.
a save-as: ['/tmp/a.bin'].
Sòti ekri: ['========== RELOADING SNAP:'], nouvo-liy.
>> b := Objè load-from: ['/tmp/a.bin'].
(b item pwototip adrès-memwa = old-lst-address) vre: {
	Sòti ekri: ['Object link re-attached.'], nouvo-liy.
}.
Sòti ekri: ( b item ), nouvo-liy.
