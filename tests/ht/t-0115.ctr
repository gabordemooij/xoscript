{
	travay-sa-a erè: ['Dont fail.'].
	unknown doSomething.
} trape: {
	Sòti ekri: ['Caught!'].
}, lanse.

{
	travay-sa-a erè: ['Dont fail.'].
	pwòp unknown doSomething.
} trape: {
	Sòti ekri: ['Caught!'].
}, lanse.

{
	travay-sa-a erè: ['Dont fail.'].
	unknown := 122.
} trape: {
	Sòti ekri: ['Caught!'].
}, lanse.


{
	travay-sa-a erè: ['Dont fail.'].
	Vre kanpe-bouk.
	Sòti ekri: ['FAIL'].
} trape: {
	Sòti ekri: ['Caught!'].
}, lanse.

{
	{
		travay-sa-a erè: ['Dont fail.'].
		Vre kanpe-bouk.
		Sòti ekri: ['FAIL'].
	} trape: { :x
		(x = ['Dont fail.']) vre: { travay-sa-a erè: ['Nested Caught!']. }.
	}, lanse.
} trape: { :e
	Sòti ekri: e.
}, lanse.
