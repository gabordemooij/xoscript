>> To-Do := Objè nouvo.

To-Do lè: ['nouvo'] fè: {
	pwòp list := Lis nouvo.
}.

To-Do lè: ['nieuw'] fè: {
	pwòp list := Lis nouvo.
}.

To-Do lè: ['+'] fè: { :task
	pwòp list ajoute-nan-fen: task.
}.

To-Do lè: ['number of tasks?'] fè: { <-  pwòp list konte.
}.

>> todos := 
	To-Do nouvo 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Sòti ekri: ['You have $ tasks to do'] $ todos number of tasks?.
