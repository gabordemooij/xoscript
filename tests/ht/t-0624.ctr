# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := Objè nouvo.

Log lè: ['say:'] fè: { :str
	Sòti ekri: str, nouvo-liy.
}.

>> Item := Objè nouvo.

Item lè: ['nouvo:'] fè: { :id <- tèt-li nouvo id: id.
}.

Item lè: ['id:'] fè: { :id
	pwòp id := id.
}.

Item lè: ['id'] fè: { <- pwòp id. }.


Item lè: ['tèks'] fè: {
	>> str := ['Item#~no'].
	str ~no: pwòp id. <- str.
}.


>> Print := Objè nouvo.

Print lè: ['items'] fè: { 
	
	pwòp item := Item nouvo: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: pwòp item
	).
	
	
}.

Print items.