#Linux
>> Slurp := Objè nouvo.

Slurp lè: ['nouvo'] fè: {
	pwòp str := [''].
}.

Slurp lè: ['nieuw'] fè: {
	pwòp str := [''].
}.

Slurp lè: ['reponn:'] fè: { :blah
		pwòp str ajoute-nan-fen: blah.
}.

Slurp lè: ['reponn:ak:'] fè: { :blah :blahah
		pwòp str ajoute-nan-fen: (blah soti-nan: 0 longè: (blah longè - 1)).
		pwòp str ajoute-nan-fen: [' '].
		pwòp str ajoute-nan-fen: blahah.
}.

Slurp lè: ['obtain'] fè: {
	>> buffer := pwòp str.
	pwòp str := ['']. <- buffer.
}.


Sòti ekri: (Pwogram sistèm: (Slurp nouvo echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Fichye nouvo: ['/tmp/from.txt'], efase. } trape: { ['Empty']. }, lanse.
{ Fichye nouvo: ['/tmp/to.txt'], efase. } trape: { ['Empty']. }, lanse.


Fichye nouvo: ['/tmp/to.txt'], egziste fo: {
	Sòti ekri: ['Confirmed. Target file does not exist.\
'].
}.
Fichye nouvo: ['/tmp/from.txt'], egziste fo: {
	Sòti ekri: ['Confirmed. Source file does not exist.\
'].
}.



Pwogram sistèm: (Slurp nouvo touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Pwogram sistèm: (Slurp nouvo cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Fichye nouvo: ['/tmp/to.txt'], egziste vre: {
	Sòti ekri: ['Confirmed. Target file has been created by shell.\
'].
}.


Sòti ekri: ['Contents of file is:'] + (Fichye nouvo: ['/tmp/to.txt'], li-done), nouvo-liy.
