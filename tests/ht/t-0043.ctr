>> repeater := Objè nouvo.
repeater lè: ['reponn:'] fè: { :what
	Sòti ekri: what + [' '].
}.
repeater lè: ['reponn:ak:'] fè: { :what :say
	Sòti ekri: what, ekri: say + [' '].
}.
repeater lè: ['reponn:ak:ak:'] fè: { :what :say :more
	Sòti ekri: what, ekri: say, ekri: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
