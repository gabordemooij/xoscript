Sòti ekri: ['Test object'], nouvo-liy.
>> a := Objè nouvo. 

a lè: ['item:'] fè: { :num
	pwòp num := num. 
}.

a lè: ['item'] fè: { <- pwòp num.
}.

a item: 123.

Sòti ekri: a item, nouvo-liy.

>> old-num-address := a item pwototip adrès-memwa.
a save-as: ['/tmp/a.bin'].
Sòti ekri: ['========== RELOADING SNAP:'], nouvo-liy.

>> b := Objè load-from: ['/tmp/a.bin'].

(b item pwototip adrès-memwa = old-num-address) vre: {
	Sòti ekri: ['Object link re-attached.'], nouvo-liy.
}.

Sòti ekri: b item, nouvo-liy.
