>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objè nouvo.
⚄ lè: ['drawFrom:length:'] fè: { :pool :konte
	
	>> result := [''].
	
	{
		>> index := Nimewo random % (pool longè).
		result ajoute-nan-fen: ( pool karaktè: (index + 1) ).
		
	} × konte. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? longè.
Sòti ekri: (['x↵'] x random longè).
Sòti ekri: (['y↵'] y ?? longè).

