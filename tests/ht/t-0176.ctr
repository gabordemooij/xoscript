

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Pwogram jesyon-memwa: 0.

>> txt := ['Word Salad'].
Sòti ekri: ['Text Length: '] + txt longè, nouvo-liy.
Sòti ekri: ['Character at 2:'] + ( txt karaktè: 2 ), nouvo-liy.
Sòti ekri: (( txt jwenn: ['S'] ) - 0), nouvo-liy.

Pwogram netwaye.

usedMemory1 := (Pwogram memwa ? 0).


txt := ['Word Salad'].
Sòti ekri: ['Text Length: '] + txt longè, nouvo-liy.
Sòti ekri: ['Character at 2:'] + ( txt karaktè: 2 ), nouvo-liy.
Sòti ekri: (( txt jwenn: ['S'] ) - 0), nouvo-liy.

Pwogram netwaye.
usedMemory2 := (Pwogram memwa ? 0).


txt := ['Word Salad'].
Sòti ekri: ['Text Length: '] + txt longè, nouvo-liy.
Sòti ekri: ['Character at 2:'] + ( txt karaktè: 2 ), nouvo-liy.
Sòti ekri: (( txt jwenn: ['S'] ) - 0), nouvo-liy.

Pwogram netwaye.
usedMemory3 := (Pwogram memwa ? 0).



( usedMemory1 = usedMemory2 ak: usedMemory1 = usedMemory3, ak: usedMemory2 = usedMemory3 ) vre: {
	Sòti ekri: ['No memory leaks here'].
}, fo: {
	Sòti ekri: ['Leaking memory...'].
}.
