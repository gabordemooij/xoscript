# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Modèl nouvo: pattern.
	p koresponn: subject fè: { :m :g
		Sòti ekri: g konte, ekri: [' '], ekri: (g kole-ansanm: ['|']), nouvo-liy. <- m.
	}.
}.
show aplike: ['(a)|(b)'] ak: ['b'].
show aplike: ['(a)|(b)'] ak: ['a'].
show aplike: ['(x)?y'] ak: ['y'].
show aplike: ['(x)?(y)(z)?'] ak: ['xy'].
