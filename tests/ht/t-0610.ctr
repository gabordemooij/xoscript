
>> Rectangle := Objè nouvo.

Rectangle lè: ['area'] fè: { <- pwòp longè * pwòp width.
}.

Rectangle lè: ['length:'] fè: { :longè
	pwòp longè := longè.
}.

Rectangle lè: ['width:'] fè: { :width
	pwòp width := width.
}.

Rectangle lè: ['nouvo'] fè: {
	# this will not result into an infinite loop
	>> rectangle := tèt-li nouvo.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle nouvo.
Sòti ekri: a area, nouvo-liy. #0

>> b := Rectangle nouvo length: 2, width: 3.
Sòti ekri: b area, nouvo-liy. #6

