>> x := [' hallo '].

>> y := x majiskil.
Sòti ekri: x, nouvo-liy.
Sòti ekri: (x menm: y), nouvo-liy.

>> y := x miniskil.
Sòti ekri: x, nouvo-liy.
Sòti ekri: (x menm: y), nouvo-liy.

>> y := x taye-espas.
Sòti ekri: x, nouvo-liy.
Sòti ekri: (x menm: y), nouvo-liy.

>> y := x sote: 1.
Sòti ekri: x, nouvo-liy.
Sòti ekri: (x menm: y), nouvo-liy.

>> y := x soti-nan: 1 longè: 2.
