Lis lè: ['sum'] fè: {
	>> total := 0.
	tèt-li chak: { :index :element
		total ajoute: element.
	}. <- total.
}.

>> a := Vre.



a lè: ['tèks'] fè: {
	>> answer := Anyen.
	( tèt-li = Vre ) vre: {
		answer := ['Yep'].
	}, sinon: {
		answer := ['Nope'].
	}. <- answer.
}.

a lè: ['nimewo'] fè: {
	>> answer := Anyen.
	( tèt-li = Vre ) vre: {
		answer := 10.
	}, sinon: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b lè: ['tèks'] fè: { <- ['Devil'].
}.

b lè: ['boulyen'] fè: { <- Fo.
}.


Sòti ekri: a, nouvo-liy.  
Sòti ekri: (90 + a), nouvo-liy. 
Sòti ekri: b, nouvo-liy. 
Sòti ekri: (Vre ak: b), nouvo-liy.

a := Lis ← ['hello'] ; ['world'] ; Vre ; Anyen ; 666. 
a := a + ( Lis ← 1 ).
Sòti ekri: a, nouvo-liy.
Sòti ekri: ((Diksyonè nouvo) mete: Anyen nan: Anyen), nouvo-liy.
Sòti ekri: a sum, nouvo-liy. 


{
	a lè: ['tèks'] fè: { <- Anyen. }.
	a := [''] + a.
} trape: { :error
	Sòti ekri: ['Error noted: '] + error, nouvo-liy.
}, lanse.



{
	a lè: ['nimewo'] fè: { <- Anyen. }.
	a := 3 × a.
} trape: { :error
	Sòti ekri: ['Error noted: '] + error, nouvo-liy.
}, lanse.


{
	a lè: ['boulyen'] fè: { <- Anyen. }.
	a := Vre ak: a. 
} trape: { :error
	Sòti ekri: ['Error noted: '] + error, nouvo-liy.
}, lanse.





