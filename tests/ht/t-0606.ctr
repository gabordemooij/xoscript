>> Point := Objè nouvo.
Point lè: ['x-coordinate:'] fè: { :x pwòp x := x. }.
Point lè: ['y-coordinate:'] fè: { :y pwòp y := y. }.
Point lè: ['x-coordinate']  fè: { <- pwòp x kopye. }.
Point lè: ['y-coordinate']  fè: { <- pwòp y kopye. }.

Point lè: ['='] fè: { :other <- ( pwòp x = other x-coordinate
		 ak: pwòp y = other y-coordinate ).
}.

>> pier := Point nouvo x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point nouvo x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point nouvo x-coordinate: 5, y-coordinate: 6.

Sòti ekri: pier = town-hall, nouvo-liy.
Sòti ekri: pier = restaurant, nouvo-liy.
