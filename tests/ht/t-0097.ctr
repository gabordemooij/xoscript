
Tèks lè: ['html'] fè: { <- (
		tèt-li
		ranplase: ['&'] ak: ['&amp;'],
		ranplase: ['<'] ak: ['&lt;'],
		ranplase: ['>'] ak: ['&gt;'],
		ranplase: ['"'] ak: ['&quot;']
	).
}.

>> HtmlBrush := Objè nouvo.

HtmlBrush lè: ['reponn:'] fè: { :tag
	Sòti ekri: (['<tag>↵'] tag: tag ).
}.

HtmlBrush lè: ['reponn:ak:'] fè: { :tag :content
	tag := ( tag soti-nan: 0 longè: (tag longè - 1) ).
	Sòti ekri: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush lè: ['content:'] fè: { :text
	Sòti ekri: text html, nouvo-liy.
}.

HtmlBrush lè: ['attr:value:'] fè: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush nouvo.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
