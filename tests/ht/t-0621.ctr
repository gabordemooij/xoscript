>> phrases := Lis nouvo
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases chak: { :_ :phrase 
	>> e := Server base64-kode: phrase.
	>> d := Server base64-dekode: e.
	Sòti ekri: (
		message kopye ~encoded: e, ~decoded: d
	), nouvo-liy.
}.
