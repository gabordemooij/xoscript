Server init.
>> fmt := Fòma nouvo: ['%#3x'].

>> blob := Blob nouvo: 4.
blob bytes: ( 
	Lis nouvo ; 0 ; 1 ; 2 ; 3
).

>> file := Fichye nouvo: ['/tmp/blob'].
file blob: blob.
blob libere.

>> li-done := file blob.
li-done 
soti-nan: 0 
longè: 4, 
fè chak: { :i :b 
	Sòti
	ekri: (fmt aplike-antye: b),
	nouvo-liy.
}.
li-done libere.
