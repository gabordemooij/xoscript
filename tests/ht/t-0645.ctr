Server init.
Sòti ekri: ['Database date test'], nouvo-liy.

>> db := Maria-DB nouvo lame: ['localhost'],
	non-itilizatè: ['xo'], 
	modpas: ['pass123'],
	non-baz: ['xobase'],
	konekte.

>> paramèt-rechèch :=
db rekèt: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
chache: { :row
	Sòti ekri: row datetest, nouvo-liy.
}.
