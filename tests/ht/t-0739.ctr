Sòti ekri: ['Test object'], nouvo-liy.
>> a := Objè nouvo. 

a lè: ['item:'] fè: { :binhelper
	pwòp binhelper := binhelper. 
}.

a lè: ['item'] fè: { <- pwòp binhelper.
}.

a item: Bin nouvo.

>> old-binhelper-address := a item pwototip adrès-memwa.
a save-as: ['/tmp/a.bin'].
Sòti ekri: ['========== RELOADING SNAP:'], nouvo-liy.

>> b := Objè load-from: ['/tmp/a.bin'].

(b item pwototip adrès-memwa = old-binhelper-address) vre: {
	Sòti ekri: ['Object link re-attached.'], nouvo-liy.
}.


