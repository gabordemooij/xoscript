Nimewo lè: ['factorial'] fè: {
	>> total := 1.
	{ :index total miltipliye-pa: (tèt-li - (index)). } × tèt-li. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Sòti ekri: a.
>> b := 2 + 3 factorial.
Sòti ekri: b.
>> c := 3 factorial + 2.
Sòti ekri: c.
>> d := 2 + (3 factorial).
Sòti ekri: d.
Sòti ekri: 2 + 3 factorial + 1.
