Sòti ekri: ['Test object'], nouvo-liy.
>> a := Objè nouvo. 

a lè: ['item:'] fè: { :file
	pwòp file := file. 
}.

a lè: ['item'] fè: { <- pwòp file.
}.

>> f := Fichye nouvo: ['/tmp/aaa.txt'].
a item: f.
Sòti ekri: a item, nouvo-liy.
a save-as: ['/tmp/a.bin'].
Sòti ekri: ['========== RELOADING SNAP:'], nouvo-liy.
>> b := Objè load-from: ['/tmp/a.bin'].
Sòti ekri: b item, nouvo-liy.
