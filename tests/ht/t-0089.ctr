>> randomizer := { :a :b
	>> minimòm := ( a < b ) swa: a oswa: b.
	>> maksimòm := ( a > b ) swa: a oswa: b.
	>> x := Anyen.
	{
		x := Nimewo ant: a ak: b.
		((x < minimòm) oswa: (x > maksimòm)) vre: { 
			Sòti ekri: (['Invalid value!']).
			Pwogram fen.
		}.
	} 
	× 100. <- x.
}.
randomizer aplike: 0 ak: 0.
randomizer aplike: 1 ak: 0.
randomizer aplike: 1 ak: 1.
randomizer aplike: 0 ak: 1.
randomizer aplike: -1 ak: 0.
randomizer aplike: -1 ak: -1.
randomizer aplike: 0 ak: -1.
randomizer aplike: 100 ak: 200.
randomizer aplike: 999999999999998 ak: 999999999999999.
