Sòti ekri: ['Test object'], nouvo-liy.
>> a := Objè nouvo. 

a lè: ['item:'] fè: { :out
	pwòp out := out. 
}.

a lè: ['item'] fè: { <- pwòp out.
}.

a lè: ['greet'] fè: {
	Sòti ekri: ['hi from original out!'], nouvo-liy.
}.

a item: Sòti.

Sòti ekri: a item, nouvo-liy.

>> old-out-address := a item pwototip adrès-memwa.
a save-as: ['/tmp/a.bin'].
Sòti ekri: ['========== RELOADING SNAP:'], nouvo-liy.

>> b := Objè load-from: ['/tmp/a.bin'].

(b item pwototip adrès-memwa = old-out-address) vre: {
	Sòti ekri: ['Object link re-attached.'], nouvo-liy.
}.

b item ekri: ['hello from loaded out!'], nouvo-liy.
b greet.
