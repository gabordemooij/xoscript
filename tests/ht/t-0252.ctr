#Linux
>> clock := Moman nouvo.
clock zòn: ['UTC-1'].
clock ane: 1981, mwa: 1, jou: 5,
      lè: 13, minit: 15, segonn: 13.

Sòti ekri: clock, nouvo-liy.
clock zòn: ['UTC+0'].

Sòti ekri: (
	(clock ane senp) + ['-'] + (clock mwa) + ['-'] + (clock jou) + [' '] +
	(clock lè) + [':'] + (clock minit) + [':'] + (clock segonn) + [' '] +
	['W'] + (clock semèn) + (clock zòn)
), nouvo-liy.


clock zòn: ['UTC-1'].
Sòti ekri: (
	(clock ane senp) + ['-'] + (clock mwa) + ['-'] + (clock jou) + [' '] +
	(clock lè) + [':'] + (clock minit) + [':'] + (clock segonn) + [' '] +
	['W'] + (clock semèn) + (clock zòn)
), nouvo-liy.
