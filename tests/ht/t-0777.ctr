#OBSD
>> dirname := [''].
{ dirname ajoute-nan-fen: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Pwogram sistèm: command.
Pwogram chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename ajoute-nan-fen: ['YYYYYYYY']. } * 20.
Fichye nouvo: filename, ekri: ['sometext'].
{ Fichye lis: ['/tmp/'] + dirname. } * 1000.
Sòti ekri: ['no crash'], nouvo-liy.

