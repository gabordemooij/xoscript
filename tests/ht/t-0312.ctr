>> Slurp := Objè nouvo.
Slurp lè: ['nouvo'] fè: {
	pwòp str := [''].
}.
Slurp aprann: ['nieuw'] vle-di: ['nouvo'].
Slurp lè: ['reponn:'] fè: { :blah
		(pwòp str ≠ ['']) vre: {
			pwòp str ajoute-nan-fen: [' '].
		}.
		pwòp str ajoute-nan-fen: blah.
}.
Slurp lè: ['reponn:ak:'] fè: { :blah :blahah
		(pwòp str ≠ ['']) vre: {
			pwòp str ajoute-nan-fen: [' '].
		}.
		(blah longè > 1) vre: {
			pwòp str ajoute-nan-fen: (blah soti-nan: 0 longè: (blah longè - 1)).
		}, sinon: {
			pwòp str ajoute-nan-fen: blah.
		}.
		pwòp str ajoute-nan-fen: [' '].
		pwòp str ajoute-nan-fen: blahah.
}.
Slurp lè: ['obtain'] fè: {
	>> buffer := pwòp str.
	pwòp str := ['']. <- buffer.
}.


>> paramèt-rechèch := Slurp nouvo
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

Sòti ekri: paramèt-rechèch obtain, nouvo-liy.
