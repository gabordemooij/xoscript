>> x := Objè nouvo.
>> y := Objè nouvo.
>> z := x.
Sòti ekri: (x = z), nouvo-liy.
Sòti ekri: (x = y), nouvo-liy.
Sòti ekri: (x ≠ y), nouvo-liy.
Sòti ekri: (x ≠ z), nouvo-liy.
>> m := Moman nouvo ane: 2070, mwa: 11.
>> n := m kopye.
Sòti ekri: (m = n), nouvo-liy.
Sòti ekri: (m ≠ n), nouvo-liy.
Sòti ekri: (m menm: m), nouvo-liy.
Sòti ekri: (m menm: n), nouvo-liy.
n mwa: 12.
Sòti ekri: (m ≠ n), nouvo-liy.
Sòti ekri: (m = n), nouvo-liy.


