


Pwogram jesyon-memwa: 0.

>> x := 0.
>> y := ['Hello'].
>> q := { ['Empty']. }.
>> p := Vre.
>> a := Lis ← 1 ; 2 ; 3 ; 4.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Pwogram netwaye.
usedMemory1 := (Pwogram memwa ? 0).




x := 1.
y := ['Hello'].
q := { ['Empty']. }.
p := Vre.
a := Lis ← 1 ; 2 ; 3 ; 5.

Pwogram netwaye.
usedMemory2 := (Pwogram memwa ? 0).




x := 2.
y := ['Hello'].
q := { ['Empty']. }.
p := Vre.
a := Lis ← 1 ; 2 ; 3 ; 4.

Pwogram netwaye.
usedMemory3 := (Pwogram memwa ? 0).




x := 3.
y := ['Hello'].
q := { ['Empty']. }.
p := Vre.
a := Lis ← 1 ; 2 ; 3 ; 5.


Pwogram netwaye.
usedMemory4 := (Pwogram memwa ? 0).





x := 4.
y := ['Hello'].
q := { ['Empty']. }.
p := Vre.
a := Lis ← 1 ; 2 ; 3 ; 4.

Pwogram netwaye.
>> usedMemory5 := (Pwogram memwa ? 0).




(usedMemory1 = usedMemory2 = usedMemory3 = usedMemory4 = usedMemory5) vre: {
	Sòti ekri: ['Memory usage remains stable.'], nouvo-liy.
}, sinon: {
	Sòti ekri: ['Used memory not stable.'], nouvo-liy.
	Sòti ekri: usedMemory1, nouvo-liy.
	Sòti ekri: usedMemory2, nouvo-liy.
	Sòti ekri: usedMemory3, nouvo-liy.
	Sòti ekri: usedMemory4, nouvo-liy.
	Sòti ekri: usedMemory5, nouvo-liy.
}.
