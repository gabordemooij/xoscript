Server init.

>> DB := Maria-DB nouvo lame: ['localhost'],
	non-itilizatè: ['xo'],
	modpas: ['pass123'],
	non-baz: ['xobase'],
	konekte.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> paramèt-rechèch := Maria-Rekèt nouvo: SQL.

# set database
paramèt-rechèch baz-done: DB.

paramèt-rechèch chache: { :row
	Sòti ekri: row world, nouvo-liy.
}.
