# backslashes must survive code serialization, strings must not end early
>> valè-yo := Lis nouvo
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

valè-yo chak: { :i :value
	>> d := Diksyonè nouvo.
	d mete: value nan: ['k'].
	>> r := d kòd objè.
	Sòti ekri: r konte, nouvo-liy.
	Sòti ekri: ( (r nan: ['k']) = value ), nouvo-liy.
}.
