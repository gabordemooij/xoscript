>> Greeter := Objè nouvo.
Greeter lè: ['make'] fè: {
	>> greeter := Objè nouvo.
	greeter lè: ['name:'] fè: { :non
		Sòti ekri: ['setting a name'].
		pwòp myName := non.
	}.
	greeter lè: ['greet'] fè: {
		Sòti ekri: ['Hello'].
		Sòti ekri: pwòp myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
