


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Pwogram jesyon-memwa: 0.
>> palette := Anyen.
>> colors := Anyen.

{
palette := Diksyonè nouvo.
palette 
	mete: ['#F00'] nan: ['red'],
	mete: ['#0F0'] nan: ['green'],
	mete: ['#00F'] nan: ['blue'].
Sòti ekri: ['number of RGB codes in palette: '] + ( palette konte ), nouvo-liy.
Sòti ekri: ['RGB code of green is: '] + ( palette ? ['green'] ), nouvo-liy.
colors := [''].
( palette chak: { :non :kòd
		colors := colors + ( non + [':'] + kòd ).
} ).
Sòti ekri: ['All colors in palette: '] + colors, nouvo-liy.
} lanse.
Pwogram netwaye.
usedMemory1 := (Pwogram memwa ? 0).

{
palette := Diksyonè nouvo.
palette 
	mete: ['#F00'] nan: ['red'],
	mete: ['#0F0'] nan: ['green'],
	mete: ['#00F'] nan: ['blue'].
Sòti ekri: ['number of RGB codes in palette: '] + ( palette konte ), nouvo-liy.
Sòti ekri: ['RGB code of green is: '] + ( palette ? ['green'] ), nouvo-liy.
colors := [''].
( palette chak: { :non :kòd
		colors := colors + ( non + [':'] + kòd ).
} ).
Sòti ekri: ['All colors in palette: '] + colors, nouvo-liy.
} lanse.
Pwogram netwaye.
usedMemory2 := (Pwogram memwa ? 0).

{
palette := Diksyonè nouvo.
palette 
	mete: ['#F00'] nan: ['red'],
	mete: ['#0F0'] nan: ['green'],
	mete: ['#00F'] nan: ['blue'].
Sòti ekri: ['number of RGB codes in palette: '] + ( palette konte ), nouvo-liy.
Sòti ekri: ['RGB code of green is: '] + ( palette ? ['green'] ), nouvo-liy.
colors := [''].
( palette chak: { :non :kòd
		colors := colors + ( non + [':'] + kòd ).
} ).
Sòti ekri: ['All colors in palette: '] + colors, nouvo-liy.
} lanse.
Pwogram netwaye.
usedMemory3 := (Pwogram memwa ? 0).



( usedMemory1 = usedMemory2 ak: usedMemory1 = usedMemory3, ak: usedMemory2 = usedMemory3 ) vre: {
	Sòti ekri: ['No memory leaks here'].
}, fo: {
	Sòti ekri: ['Leaking memory...'].
}.
