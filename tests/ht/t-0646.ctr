Server init.
Sòti ekri: ['Database datetime test'], nouvo-liy.

>> db := Maria-DB nouvo lame: ['localhost'],
	non-itilizatè: ['xo'], 
	modpas: ['pass123'],
	non-baz: ['xobase'],
	konekte.

>> paramèt-rechèch :=
db rekèt: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
chache: { :row
	Sòti ekri: row datetimetest, nouvo-liy.
}.
