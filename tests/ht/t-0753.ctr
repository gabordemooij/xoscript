Sòti ekri: ['Test object'], nouvo-liy.
>> a := Objè nouvo. 

a lè: ['item:'] fè: { :fmt
	pwòp fmt := fmt. 
}.

a lè: ['item'] fè: { <- pwòp fmt.
}.

a item: ( Fòma nouvo: ['|%s|'] ).

Sòti ekri: a item, nouvo-liy.

>> old-fmt-address := a item pwototip adrès-memwa.
a save-as: ['/tmp/a.bin'].
Sòti ekri: ['========== RELOADING SNAP:'], nouvo-liy.

>> b := Objè load-from: ['/tmp/a.bin'].

(b item pwototip adrès-memwa = old-fmt-address) vre: {
	Sòti ekri: ['Object link re-attached.'], nouvo-liy.
}.

Sòti ekri: ( b item aplike: ['hello'] ), nouvo-liy.
