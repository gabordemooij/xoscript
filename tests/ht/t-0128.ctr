
Lis lè: ['sum'] fè: {
	>> total := 0.
	tèt-li chak: { :index :element
		total ajoute: element.
	}. <- total.
}.

>> a := Lis ← 9 ; 8 ; 7.
Sòti ekri: (a sum), nouvo-liy. 
>> a := Lis ← 1 ; 9.
Sòti ekri: (a sum), nouvo-liy. 
>> a := Lis ← ['o'] ; 2.
Sòti ekri: (a sum), nouvo-liy. 
Sòti ekri: (Lis nouvo sum), nouvo-liy. 
