Tèks lè: ['html'] fè: { <- (
		tèt-li
		ranplase: ['&'] ak: ['&amp;'],
		ranplase: ['<'] ak: ['&lt;'],
		ranplase: ['>'] ak: ['&gt;'],
		ranplase: ['''] ak: ['&apos;'],
		ranplase: ['"'] ak: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Pwogram jesyon-memwa: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Sòti ekri: txt kopye html, nouvo-liy.
Sòti ekri: txt kopye miniskil, nouvo-liy.
Sòti ekri: txt kopye majiskil, nouvo-liy.
} lanse.

Pwogram netwaye.

usedMemory1 := (Pwogram memwa ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Sòti ekri: txt kopye html, nouvo-liy.
Sòti ekri: txt kopye miniskil, nouvo-liy.
Sòti ekri: txt kopye majiskil, nouvo-liy.
} lanse.

Pwogram netwaye.
usedMemory2 := (Pwogram memwa ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Sòti ekri: txt kopye html, nouvo-liy.
Sòti ekri: txt kopye miniskil, nouvo-liy.
Sòti ekri: txt kopye majiskil, nouvo-liy.
} lanse.

Pwogram netwaye.
usedMemory3 := (Pwogram memwa ? 0).



( usedMemory1 = usedMemory2 ak: usedMemory1 = usedMemory3, ak: usedMemory2 = usedMemory3 ) vre: {
	Sòti ekri: ['No memory leaks here'].
}, fo: {
	Sòti ekri: ['Leaking memory...'].
}.
