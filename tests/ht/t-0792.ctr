Server init.

>> DB := Maria-DB nouvo lame: ['localhost'],
	non-itilizatè: ['xo'],
	modpas: ['pass123'],
	non-baz: ['xobase'],
	konekte.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB rekèt: SQL.

# now you don't have to set DB
query2 chache: { :row
	Sòti ekri: row world, nouvo-liy.
}.
