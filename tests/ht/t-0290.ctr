# test list operations


>> cakes := Lis ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes ranplase: 1 longè: 2 ak: ( Lis ← ['cinnamon'] ; ['pineapple'] ).
Sòti ekri: (buy kole-ansanm: [',']), nouvo-liy.


>> buy := cakes ranplase: 1 longè: 12 ak: ( Lis ← ['cinnamon'] ; ['pineapple'] ).
Sòti ekri: (buy kole-ansanm: [',']), nouvo-liy.


>> buy := cakes ranplase: 2 longè: 10 ak: ( Lis nouvo ).
Sòti ekri: (buy kole-ansanm: [',']), nouvo-liy.


>> buy := cakes ranplase: 0 longè: 1 ak: ( Lis nouvo ).
Sòti ekri: (buy kole-ansanm: [',']), nouvo-liy.


>> buy := cakes ranplase: ['0'] longè: ['1'] ak: ['x'].
Sòti ekri: (buy kole-ansanm: [',']), nouvo-liy.
