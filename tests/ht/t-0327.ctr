

Lis lè: ['fixture:'] fè: { :f
	pwòp fixture := f.
}.

Lis lè: ['konte'] fè: { <- pwòp fixture.
}.

Lis lè: ['aantal'] fè: { <- pwòp fixture.
}.


>> x := Anyen.
{

	x := ['hello'] 
	ranplase:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] karaktè: 2)
			)
		)
	ak: (
		(['...hal'] + ['lo']) 
			majiskil 
			lowecase 
			majiskil 
			sote: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Lis ← 0 ; 1 ; 4; 9 ; (Lis ← 0 ; 3; 1) ; 4
							) avan-dènye
						) ? 1
					) + 
					((Lis ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					konte
				)
			)
	).

} × 10.
Sòti ekri: x, nouvo-liy.

