Sòti ekri: ['Test object'], nouvo-liy.
>> greeter := Objè nouvo.
greeter lè: ['name:'] fè: { :non
	pwòp xname := non. 
}.
greeter lè: ['greet'] fè: {
	Sòti ekri: ['Hello '] + pwòp xname, nouvo-liy.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Sòti ekri: ['========== RELOADING SNAP:'], nouvo-liy.
>> b := Objè load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
