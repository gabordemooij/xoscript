>> libname := Pwogram paramèt: ['FFITESTLIB'].
Server konekte-ak: (
 Lis nouvo ;
 libname ;
 ['putchar'] ;
 ( Lis nouvo ; ['char'] ) ;
 ['void'] ;
 ['Print'] ;
 ['char:']
).
Print char: (x soti-nan: 0 longè: 1), nouvo-liy.
x libere.

