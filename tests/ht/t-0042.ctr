>> items := Diksyonè nouvo.
items mete: ['black'] nan: ['coffee'], mete: ['earl grey'] nan: ['tea'].
Sòti ekri: (items nan: ['coffee']), ekri: (items nan: ['tea']).
Sòti ekri: ['there are'] + items konte + [' items in the array.'].
items mete: ['capuccino'] nan: ['coffee'].
Sòti ekri: ['Now my coffee is.. '] + (items nan: ['coffee']).
items mete: ['aaa'] nan: ['1'].
items mete: ['bbb'] nan: ['2'].
Sòti ekri: (items nan: ['a']).
