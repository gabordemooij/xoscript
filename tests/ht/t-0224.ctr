
>> countries := Lis nouvo
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Lis nouvo
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods dapre: countries, chak: { :key :value
	counter ajoute: 1.
}.

Sòti ekri: (['we serve counter dishes'] counter: counter), nouvo-liy.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] karaktè triye: { :v
	counter ajoute: 0.
}.

Sòti ekri: (['we sort counter dishes'] counter: counter), nouvo-liy.


>> counter := 0.
{
	{
		counter ajoute: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Sòti ekri: (['we calculate counter numbers.'] counter: counter), nouvo-liy.

