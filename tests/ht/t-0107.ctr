
Sòti ekri: ['Break for-loop, 0-4.'], nouvo-liy.
{ :i
	Sòti ekri: ['iteration #'] + i, nouvo-liy.
	(i = 4) kanpe-bouk.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Sòti ekri: ['Break while-true loop, 0-4.'], nouvo-liy.
{
	Sòti ekri: ['iteration #'] + x, nouvo-liy.
	x ajoute: 1.
	((x < 5) pa) kanpe-bouk.
} pandan-ke: xIsLessThan10.

Sòti ekri: ['Break while-false loop, 5,4.'], nouvo-liy.
{
	Sòti ekri: ['iteration #'] + x, nouvo-liy.
	x soustrè: 1.
	(x = 3) kanpe-bouk.
} pandan-ke: { <- (x > 0). }.

Sòti ekri: ['Break times loop, 1-4.'], nouvo-liy.
{ :i
	Sòti ekri: ['iteration #'] + i, nouvo-liy.
	(i = 4) kanpe-bouk.
} × 5.

Sòti ekri: ['Break block, dont print line.'], nouvo-liy.
{ Vre kanpe-bouk. Sòti ekri: ['dont write this!'], nouvo-liy. } lanse.

Sòti ekri: ['Break block, dont fire catch...'], nouvo-liy.
{ Vre kanpe-bouk. Sòti ekri: ['dont write this!'], nouvo-liy. } trape: { Sòti ekri: ['Dont catch this!']. }, lanse.

Sòti ekri: ['Test Array each-loop: 0,1'], nouvo-liy.
(Lis ← 1 ; 2 ; 3) transfòme: { :i
	Sòti ekri: ['iteration #'] + i, nouvo-liy.
	(i = 1) kanpe-bouk.
}.

Sòti ekri: ['Test Map each-loop: c only'], nouvo-liy.
>> m := Diksyonè nouvo.
m mete: ['first'] nan: ['a'], mete: ['second'] nan: ['b'], mete: ['third'] nan: ['c'].
m chak: { :k :v
	Sòti ekri: ['iteration'] + v + k, nouvo-liy.
	Vre kanpe-bouk.
}.

