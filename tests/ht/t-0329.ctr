Sòti ekri: ((Lis nouvo
	lè: ['plaque:'] fè: { :x pwòp o := x. },
	lè: ['plaque']  fè: { <- pwòp o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Lis ← 1)
	~ (Lis ← 1 ; 2)
	~ (Lis ← 1 ; 2 ; 3)
	~ (Lis ← 1 ; 2 ; 3 ; 4)
	~ (Lis ← 1 ; 2 ; 3 ; 4 ; 5)
) chak: { :i :el
	{ Sòti ekri: travay-sa-a. } × el konte.
	Sòti nouvo-liy.
}) plaque, nouvo-liy.


