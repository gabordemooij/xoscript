Server init.
>> f := Fòma nouvo: ['%d'].
>> a := Blob nouvo: 4.
a bytes: ( Lis nouvo ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob nouvo: 4.
b bytes: ( Lis nouvo ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a soti-nan: 0 longè: 3, chak: { :i :byte
	Sòti ekri: ( f aplike-antye: byte ), nouvo-liy.
}.
a ^ b.
a soti-nan: 0 longè: 3, chak: { :i :byte
	Sòti ekri: ( f aplike-antye: byte ), nouvo-liy.
}.
a ^ b.
a soti-nan: 0 longè: 3, chak: { :i :byte
	Sòti ekri: ( f aplike-antye: byte ), nouvo-liy.
}.
a libere.
b libere.

{ a ^ Objè. } trape: { :e Sòti ekri: e, nouvo-liy. }, lanse.
