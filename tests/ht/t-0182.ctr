

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Pwogram jesyon-memwa: 0.

>> txt := ['1.6'].
>> n := txt nimewo.
>> t := txt boulyen.
Sòti ekri: n, nouvo-liy.
Sòti ekri: t, nouvo-liy.
Sòti ekri: n kalite, nouvo-liy.
Sòti ekri: t kalite, nouvo-liy.

Pwogram netwaye.

usedMemory1 := (Pwogram memwa ? 0).


txt := ['1.6'].
n := txt nimewo.
t := txt boulyen.
Sòti ekri: n, nouvo-liy.
Sòti ekri: t, nouvo-liy.
Sòti ekri: n kalite, nouvo-liy.
Sòti ekri: t kalite, nouvo-liy.

Pwogram netwaye.
usedMemory2 := (Pwogram memwa ? 0).


txt := ['1.6'].
n := txt nimewo.
t := txt boulyen.
Sòti ekri: n, nouvo-liy.
Sòti ekri: t, nouvo-liy.
Sòti ekri: n kalite, nouvo-liy.
Sòti ekri: t kalite, nouvo-liy.

Pwogram netwaye.
usedMemory3 := (Pwogram memwa ? 0).



( usedMemory1 = usedMemory2 ak: usedMemory1 = usedMemory3, ak: usedMemory2 = usedMemory3 ) vre: {
	Sòti ekri: ['No memory leaks here'].
}, fo: {
	Sòti ekri: ['Leaking memory...'].
}.
