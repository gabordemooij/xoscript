



>> CoffeeGrounds := Objè nouvo.
CoffeeGrounds lè: ['extract'] fè: { <- ['coffee']. }.

>> CoffeeMachine := Objè nouvo.
CoffeeMachine lè: ['init'] fè: {
	pwòp coffeegrounds := CoffeeGrounds nouvo.
}.
CoffeeMachine lè: ['nouvo'] fè: { <- CoffeeMachine `new init.
}.

CoffeeMachine lè: ['makeTea'] fè: { <- (pwòp tealeaves extract). }.
CoffeeMachine lè: ['makeCoffee'] fè: { <- (pwòp coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine nouvo.

Sòti ekri:
	coffeeDream 
	makeCoffee.

Sòti ekri:
	coffeeDream 
	makeTea.
