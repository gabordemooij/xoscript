

Lis lè: ['column:'] fè: { :column
	>> result := Lis nouvo.
	tèt-li chak: { :index :row
		row chak: { :index :cell
			(index = column) vre: { result ajoute-nan-fen: cell. }.
		}.
	}. <- result.
}.


>> a := Lis ←
	(Lis ← 1 ; 2 ; 3) ;
	(Lis ← 4 ; 5 ; 6) ;
	(Lis ← 7 ; 8 ; 9).

>> b := a column: 1.
Sòti ekri: b, nouvo-liy.

b := a column: 20.
Sòti ekri: b, nouvo-liy.

b := a column: -100.
Sòti ekri: b, nouvo-liy.
