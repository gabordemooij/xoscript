>> str := ['write:'].
Sòti mesaj: ['ekri:'] agiman: (Lis ← ['Hello World']), nouvo-liy. 

Nimewo lè: ['isbetween:and:'] fè: { :a :b <- ((tèt-li ≥ a) ak: (tèt-li ≤ b)).
}.

str := ['isbetween:and:'].
Sòti ekri: (3 mesaj: str agiman: (Lis ← 2 ; 8)), nouvo-liy.
Sòti ekri: (3 mesaj: str agiman: (Lis ← 1 ; 2)), nouvo-liy.


>> CoffeeMachine := Objè nouvo.
CoffeeMachine lè: ['makeCoffeeWithSugar:milk:'] fè: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Lis ← 4 ; 2.
Sòti ekri: ( CoffeeMachine mesaj: order agiman: coffeeConfiguration ), nouvo-liy.
