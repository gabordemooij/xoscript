Boulyen lè: ['xor:'] fè: { :a :b <- ((a ak: b pa) oswa: (a pa ak: b)).
}.

>> o := Objè nouvo.
o lè: ['hello'] fè: { ['Empty']. }.
{ o lè: 2 fè: 3.} trape: { :e Sòti ekri: e, nouvo-liy. }, lanse.
{ o lè: ['tès'] fè: 3.} trape: { :e Sòti ekri: e, nouvo-liy. }, lanse.
{ o lè: ['hello'] fè: { ['Empty']. }.} trape: { :e Sòti ekri: e, nouvo-liy. }, lanse. 
{ >> z := 4 ÷ 0. } trape: { :e Sòti ekri: e, nouvo-liy. }, lanse. 
{ (Vre ak: Anyen) vre: { Sòti ekri: ['X'].}. } trape: { :e Sòti ekri: e, nouvo-liy. }, lanse. 
{ ([''] xor: 0) vre: { Sòti ekri: ['X'].}. } trape: { :e Sòti ekri: e, nouvo-liy. }, lanse. 
{ (1 < ['2']) vre: { Sòti ekri: ['OK']. }. } trape: { :e Sòti ekri: e, nouvo-liy. }, lanse. 
{ (1 < ['2.0']) vre: { Sòti ekri: ['OK']. }. } trape: { :e Sòti ekri: e, nouvo-liy. }, lanse. 
{ (1 < ['x2.0']) vre: { Sòti ekri: ['NO!']. }. } trape: { :e Sòti ekri: e, nouvo-liy. }, lanse. 
{ Sòti ekri: (['hello OK there'] soti-nan: ['6'] longè: ['2']). } lanse. 
