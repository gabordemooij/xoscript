
Pwogram jesyon-memwa: 4.

>> Animal := Objè nouvo.
Animal lè: ['make'] fè: {
	>> animal := Objè nouvo.
	animal lè: ['makeSound'] fè: {
		Sòti ekri: pwòp sound.
	}. <- animal.
}.
>> Cat := Objè nouvo.
Cat lè: ['make'] fè: {
	>> cat := Animal make.
	cat lè: ['init'] fè: {
		pwòp sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
