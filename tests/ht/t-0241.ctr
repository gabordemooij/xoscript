

Tèks lè: ['evaluate'] fè: {
	>> kòd := Fichye nouvo: ['/tmp/eval.ctr'].
	kòd ekri: (tèt-li tèks + ['.']).
	Pwogram itilize: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Lis ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q tèks.
Sòti ekri: x, nouvo-liy.
>> y := Anyen.
(['y := '] + x ) evaluate.
Sòti ekri: y ? 0, nouvo-liy.

q := Diksyonè mete: ['\[''] nan: ['\['quote\']'].
x := q tèks.
Sòti ekri: x, nouvo-liy.
y := Anyen.
(['y := '] + x ) evaluate.

>> q := (Diksyonè nouvo) mete:['\[''] nan:['\['quote\[''].
Sòti ekri: y ? ['\['quote\']'], nouvo-liy.
