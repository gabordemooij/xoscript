# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob nouvo: 8, bytes: (
	Lis nouvo ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Sòti ekri: ( utf16 dekode: ['utf16le'] ), nouvo-liy.

utf16 libere.
>> utf32 := Blob nouvo: 13, bytes: (
	Lis nouvo ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Sòti ekri: ( utf32 dekode: ['utf32be'] ), nouvo-liy.
utf32 libere.