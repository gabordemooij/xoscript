>> t := Anyen.

# you can control the time zone for
# parsing like this:
Moman zòn: ['CET'].
t := Moman apati: ['1981-02-03 04:05:06'].
Sòti ekri: t, nouvo-liy.

# now using CEST time zone:
Moman zòn: ['CEST'].
t := Moman apati: ['1981-02-03 04:05:06'].
Sòti ekri: t, nouvo-liy.

# error if string cannot be parsed
{ Moman apati: ['1900']. } trape: { Anyen. }, lanse.
