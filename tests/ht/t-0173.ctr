

Lis lè: ['sum'] fè: {
	>> total := 0.
	tèt-li chak: { :index :element
		total ajoute: element.
	}. <- total.
}.

Lis lè: ['product'] fè: {
	>> total := 1.
	tèt-li chak: { :index :element
		total miltipliye-pa: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Pwogram jesyon-memwa: 0.

{

>> a := Lis ← ['hello'] ; ['world'] ; Vre ; Anyen ; 666.
a := a + ( Lis ← 1 ).
Sòti ekri: ( ['sum: '] + ( a sum ) ), nouvo-liy.
Sòti ekri: ( ['min: '] + ( a minimòm ) ), nouvo-liy.
Sòti ekri: ( ['max: '] + ( a maksimòm ) ), nouvo-liy.
Sòti ekri: ( ['3rd: '] + ( a ? 2 ) ), nouvo-liy.
Sòti ekri: ( ['prd: '] + ( a product ) ), nouvo-liy.
a triye: { :a :b <- (b - a). }.
a chak: { :i :e Sòti ekri: ( i - 0 ), nouvo-liy. }.

} lanse.

Pwogram netwaye.
usedMemory1 := (Pwogram memwa ? 0).


{

>> a := Lis ← ['hello'] ; ['world'] ; Vre ; Anyen ; 666.
a := a + ( Lis ← 1 ).
Sòti ekri: ( ['sum: '] + ( a sum ) ), nouvo-liy.
Sòti ekri: ( ['min: '] + ( a minimòm ) ), nouvo-liy.
Sòti ekri: ( ['max: '] + ( a maksimòm ) ), nouvo-liy.
Sòti ekri: ( ['3rd: '] + ( a ? 2 ) ), nouvo-liy.
Sòti ekri: ( ['prd: '] + ( a product ) ), nouvo-liy.
a triye: { :a :b <- (b - a). }.
a chak: { :i :e Sòti ekri: ( i - 0 ), nouvo-liy. }.

} lanse.



Pwogram netwaye.
usedMemory2 := (Pwogram memwa ? 0).


{

>> a := Lis ← ['hello'] ; ['world'] ; Vre ; Anyen ; 666.
a := a + ( Lis ← 1 ).
Sòti ekri: ( ['sum: '] + ( a sum ) ), nouvo-liy.
Sòti ekri: ( ['min: '] + ( a minimòm ) ), nouvo-liy.
Sòti ekri: ( ['max: '] + ( a maksimòm ) ), nouvo-liy.
Sòti ekri: ( ['3rd: '] + ( a ? 2 ) ), nouvo-liy.
Sòti ekri: ( ['prd: '] + ( a product ) ), nouvo-liy.
a triye: { :a :b <- (b - a). }.
a chak: { :i :e Sòti ekri: ( i - 0 ), nouvo-liy. }.

} lanse.



Pwogram netwaye.
usedMemory3 := (Pwogram memwa ? 0).

( usedMemory1 = usedMemory2 ak: usedMemory1 = usedMemory3, ak: usedMemory2 = usedMemory3 ) vre: {
	Sòti ekri: ['No memory leaks here'].
}, fo: {
	Sòti ekri: ['Leaking memory...'].
}.
