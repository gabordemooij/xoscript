Pwogram jesyon-memwa: 4.

>> Doubler := Objè nouvo.
>> Multiplier := Objè nouvo.
Doubler lè: ['double:and:'] fè: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier lè: ['multiply:and:'] fè: { :x :y <- (x × y).
}.

Sòti ekri: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), nouvo-liy.
