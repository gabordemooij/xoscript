>> z := Objè nouvo.
z lè: ['value:'] fè: { :v
	pwòp value := v. <- tèt-li.
}.
z lè: ['value'] fè: { <- pwòp value. }.
(z setValue: 1) value: 2.
Sòti ekri: z value.
>> x := z.
Sòti ekri: x value.
z := Anyen.
Sòti ekri: z value.
Sòti ekri: x value.
Sòti ekri: ['hello'].
Sòti ekri: 3 + 2.
Sòti ekri: (3 > 2).
