>> items := Diksyonè nouvo.
items mete: ['green'] nan: ['color-1'].
items mete: ['orange'] nan: ['color-2'].
items mete: ['red'] nan: ['color-3'].
>> i := 0.
>> s := [''].
items chak: { :key :color
	Sòti ekri: ['color #'] + i + [' is: '] + color + [' '].
	i ajoute: 1.
}.
Sòti ekri: i + [' colors!'].
