Pwogram jesyon-memwa: 0.
Lis lè: ['sum'] fè: {
	>> total := 0.
	tèt-li chak: { :index :element
		total ajoute: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Fichye nouvo: ['/tmp/test.txt'].
f ekri: ['Lorem Ipsum'].
f fèmen.
  

f := Fichye nouvo: ['/tmp/test.txt'].
>> text := f li-done.
f fèmen.



Pwogram netwaye.
usedMemory1 := (Pwogram memwa ? 1).



f := Fichye nouvo: ['/tmp/test.txt'].
text := f li-done.
f fèmen.

Pwogram netwaye.
usedMemory2 := (Pwogram memwa ? 1).


f := Fichye nouvo: ['/tmp/test.txt'].
text := f li-done.
f fèmen.

Pwogram netwaye.
usedMemory3 := (Pwogram memwa ? 1).



( usedMemory1 = usedMemory2 ak: usedMemory1 = usedMemory3, ak: usedMemory2 = usedMemory3 ) vre: {
	Sòti ekri: ['No memory leaks here'].
}, fo: {
	Sòti ekri: ['Leaking memory...'].
}.
