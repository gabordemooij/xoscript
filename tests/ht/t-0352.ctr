Nimewo lè: ['roman'] fè: {
	>> nimewo := tèt-li kopye.
	>> roman := [''].
	{
		{
			(nimewo ≥ 1000) vre: {
				roman ajoute-nan-fen: ['Ⅿ'].
				nimewo soustrè: 1000.
			}, kanpe-bouk.
		
			(nimewo ≥ 500) vre: {
				roman ajoute-nan-fen: ['Ⅾ'].
				nimewo soustrè: 500.
			}, kanpe-bouk.
		
			(nimewo ≥ 100) vre: {
				roman ajoute-nan-fen: ['Ⅽ'].
				nimewo soustrè: 100.
			}, kanpe-bouk.
		
			(nimewo ≥ 50) vre: {
				roman ajoute-nan-fen: ['Ⅼ'].
				nimewo soustrè: 50.
			}, kanpe-bouk.
		
			(nimewo ≥ 50) vre: {
				roman ajoute-nan-fen: ['Ⅼ'].
				nimewo soustrè: 50.
			}, kanpe-bouk.
		
			(nimewo ≥ 10) vre: {
				roman ajoute-nan-fen: ['Ⅹ'].
				nimewo soustrè: 10.
			}, kanpe-bouk.
			
			(nimewo ≥ 9) vre: {
				roman ajoute-nan-fen: ['Ⅸ'].
				nimewo soustrè: 9.
			}, kanpe-bouk.
			
			(nimewo ≥ 5) vre: {
				roman ajoute-nan-fen: ['Ⅴ'].
				nimewo soustrè: 5.
			}, kanpe-bouk.
			
			(nimewo ≥ 4) vre: {
				roman ajoute-nan-fen: ['Ⅳ'].
				nimewo soustrè: 4.
			}, kanpe-bouk.
			
			(nimewo ≥ 1) vre: {
				roman ajoute-nan-fen: ['Ⅰ'].
				nimewo soustrè: 1.
			}, kanpe-bouk.
		} pwosedi.
	} pandan-ke: { <- nimewo > 0. }. <- roman.
}.

Sòti ekri: 1 roman, nouvo-liy.
Sòti ekri: 2 roman, nouvo-liy.
Sòti ekri: 4 roman, nouvo-liy.
Sòti ekri: 8 roman, nouvo-liy.
Sòti ekri: 16 roman, nouvo-liy.
Sòti ekri: 32 roman, nouvo-liy.
Sòti ekri: 64 roman, nouvo-liy.
Sòti ekri: 128 roman, nouvo-liy.
Sòti ekri: 256 roman, nouvo-liy.
Sòti ekri: 1024 roman, nouvo-liy.
