


>> wine := Objè nouvo.


wine lè: ['toString'] fè: { <- ['merlot'].
}.

wine lè: ['naarTekst'] fè: { <- ['merlot'].
}.


wine lè: ['='] fè: { :other wine <- ( tèt-li toString = other wine ).
}.

wine lè: ['=='] fè: { :other wine <- ( tèt-li toString = other wine ).
}.



wine
	ka: ['cabernet'] fè: { Sòti ekri: ['it's a Cabernet!']. },
	ka: ['syrah']    fè: { Sòti ekri: ['it's a Syrah!'].    },
	ka: ['merlot']   fè: { Sòti ekri: ['it's a Merlot!'].   },
	ka: ['malbec']   fè: { Sòti ekri: ['it's a Malbec!'].   }.

Sòti nouvo-liy.
