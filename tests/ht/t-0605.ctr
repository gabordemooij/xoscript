>> invoice := Objè nouvo.
invoice lè: ['lanse'] fè: {
        pwòp nimewo := 0.
}.

invoice lè: ['nimewo'] fè: {
        pwòp nimewo ajoute: 1. <- pwòp nimewo kopye.
}.

>> year-invoice := invoice nouvo.
year-invoice lè: ['start:'] fè: { :ane
	pwòp nimewo := ane.
}.

year-invoice start: 202000.
Sòti ekri: year-invoice nimewo, nouvo-liy.
Sòti ekri: year-invoice nimewo, nouvo-liy.
