
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> kòd := {
	>> o := (
		Diksyonè nouvo
		aa: (Lis ← 1 ; 2),
		bb: (Lis ← 3 ; 4)
	).
	>> s := o tèks.
	>> o2 := s objè.
	(s  kalite = Tèks kalite) vre: { Sòti ekri: ['OK1'], nouvo-liy. }.
	(o2 kalite = Diksyonè kalite) vre: { Sòti ekri: ['OK2'], nouvo-liy. }.
}.

Pwogram jesyon-memwa: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Pwogram netwaye.
usedMemory1 := (Pwogram memwa ? 1).
kòd lanse.
Pwogram netwaye.
usedMemory2 := (Pwogram memwa ? 1).
kòd lanse.
Pwogram netwaye.
usedMemory3 := (Pwogram memwa ? 1).
kòd lanse.
Pwogram netwaye.
usedMemory4 := (Pwogram memwa ? 1).

(usedMemory2 = usedMemory3 = usedMemory4) vre: { Sòti ekri: ['OK3'], nouvo-liy. }.
 
