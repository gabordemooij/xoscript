#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Modèl nouvo: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern koresponn: subject fè: { :m :x
	Sòti ekri: m, nouvo-liy.
	Sòti ekri: x, nouvo-liy. <- ['XXX'].
}.
Sòti ekri: result, nouvo-liy.