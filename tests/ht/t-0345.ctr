# test catch-all methods
>> x13 := Objè nouvo.
x13 lè: ['a'] fè: { :a Sòti ekri: 0, nouvo-liy. }.
x13 lè: ['a:'] fè: { :a Sòti ekri: a, nouvo-liy. <- 5. }.
x13 lè: ['a:b:'] fè: { :a :b Sòti ekri: (a + b), nouvo-liy. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
