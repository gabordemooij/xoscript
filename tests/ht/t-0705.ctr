

>> obj := Objè nouvo.

obj lè: ['greet'] fè: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj lè: ['task'] fè: {
	pwòp property := 123.
	{
		# try binds self/own to object instead of block
		Sòti ekri: tèt-li greet.
		Sòti ekri: pwòp property.
		1 / 0.
	} trape: {
		Sòti ekri: tèt-li greet.
		Sòti ekri: pwòp property.
		Sòti ekri: ['ok'].
	}, eseye.
}.

obj task.