>> a := Lis ← Objè ; Vre ; Fo ; Boulyen ; 1 ; Nimewo ; ['Str'] ; Tèks ; { ['Empty']. }.
Sòti ekri: (a konte), nouvo-liy.
{ :i
	Sòti ekri: 
	['a '] + 
	((a ? i) kalite) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Anyen?) swa: [''] oswa: ['NOT']) + 
	[' Nil.'],
	nouvo-liy.
} × (a konte).
Sòti ekri: ['but.. Nil is.. '] + ((Anyen Anyen?) swa: ['certainly NIL!'] oswa: ['not NIL??']), nouvo-liy.