# test buffers PKI/Sign 
Server init.

>> long := ( Lis nouvo ranpli: 1000 ak: ['a'] ) kole-ansanm: [''].

# sign a message
Sòti ekri: ( 
	Kòfrefò siyen: ['abc'] ak: long
), nouvo-liy.

Sòti ekri: ( 
	Kòfrefò
		tcheke: ['abc'] 
		siyati: long 
		ak: long
), nouvo-liy.

Sòti ekri: (
	Kòfrefò rache-modpas: long verifye: long
), nouvo-liy.
