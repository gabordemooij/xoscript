Sòti ekri: ['Continue for-loop, No - before 6 and up.'], nouvo-liy.
{ :i
	Sòti ekri: (i + 1), nouvo-liy.
	((i + 1) > 4) kontinye.
	Sòti ekri: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Sòti nouvo-liy.
Sòti ekri: ['Continue while-true, No --> before 5 and up.'], nouvo-liy.
{
	Sòti ekri: ['iteration #'] + x, nouvo-liy.
	x ajoute: 1.
	((x < 5) pa) kontinye.
	Sòti ekri: ['-->'].
} pandan-ke: xIsLessThan10.
Sòti nouvo-liy.
Sòti ekri: ['Continue while-false, No - before 3 only.'], nouvo-liy.
{
	Sòti ekri: ['iteration #'] + x, nouvo-liy.
	x soustrè: 1.
	(x = 3) kontinye.
	Sòti ekri: ['-'].
} pandan-ke: { <- ( x > 0). }.

Sòti nouvo-liy.
Sòti ekri: ['Continue times-loop, No ||| before 3.'], nouvo-liy.
{ :i
	Sòti ekri: ['iteration #'] + i, nouvo-liy.
	(i = 2) kontinye.
	Sòti ekri: ['|||'].
} × 5.

Sòti nouvo-liy.

{ Vre kontinye. Sòti ekri: ['dont write this!'], nouvo-liy. } lanse.

{ Vre kontinye. Sòti ekri: ['dont write this!'], nouvo-liy. } trape: { Sòti ekri: ['Dont catch this!']. }, lanse.

Sòti ekri: ['Test Array each-loop: 0, ... ,2'], nouvo-liy.
(Lis ← 1 ; 2 ; 3) transfòme: { :i
	(i = 1) kontinye.
	Sòti ekri: ['iteration #'] + (i - 0), nouvo-liy.
}.

Sòti ekri: ['Test Map each-loop: c only'], nouvo-liy.
>> m := Diksyonè nouvo.
m mete: ['first'] nan: ['a'], mete: ['second'] nan: ['b'], mete: ['third'] nan: ['c'].
m chak: { :k :v
	(k ≠ ['c']) kontinye.
	Sòti ekri: ['iteration'] + k + v, nouvo-liy.
}.

