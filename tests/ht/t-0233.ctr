
>> Slurp := Objè nouvo.

Slurp lè: ['nouvo'] fè: {
	pwòp str := [''].
}.

Slurp lè: ['reponn:'] fè: { :blah
		(pwòp str = ['']) vre: {
			pwòp str ajoute-nan-fen: blah.
		}, sinon: {
			pwòp str ajoute-nan-fen: [' '].
			pwòp str ajoute-nan-fen: blah.
		}.
}.

Slurp lè: ['reponn:ak:'] fè: { :blah :blahah
		(blah longè > 1) vre: {
			pwòp str ajoute-nan-fen: (blah soti-nan: 0 longè: (blah longè - 1)).
		}, sinon: {
			pwòp str ajoute-nan-fen: blah.
		}.
		pwòp str ajoute-nan-fen: [' '].
		pwòp str ajoute-nan-fen: blahah.
}.

Slurp lè: ['obtain'] fè: {
	>> buffer := pwòp str.
	pwòp str := ['']. <- buffer.
}.

Sòti ekri: ( Pwogram sistèm: ( Slurp nouvo echo hello world obtain ) ).
