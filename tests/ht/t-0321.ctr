# test qualifiers

Pwogram netwaye.

>> Fruit := Objè nouvo.
Fruit lè: ['nouvo'] fè: {
	>> f := tèt-li nouvo.
	f apples: 0. <- f.
}.
Fruit lè: ['apples:'] fè: { :a pwòp apples := a. }.
Fruit lè: ['apples'] fè: { <- pwòp apples. }.
Fruit lè: ['+'] fè: { :f
	>> n := Fruit nouvo.
	n apples: (f apples + pwòp apples). <- n.
}.
Nimewo lè: ['apples'] fè: { <- ((Fruit nouvo) apples: tèt-li).
}.

Fruit lè: ['tèks'] fè: { <- pwòp apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Sòti ekri: q, nouvo-liy.




q := 3 apples + 4 apples.
Sòti ekri: q, nouvo-liy.



q := 3 apples + 4 apples.
Sòti ekri: q, nouvo-liy.


