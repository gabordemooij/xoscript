

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Pwogram jesyon-memwa: 0.

Nimewo lè: ['addNum:'] fè: { :x
	tèt-li ajoute: x.
}.

Nimewo lè: ['subtractNum:'] fè: { :x
	tèt-li soustrè: x.
}.

Nimewo lè: ['multiplyBy:'] fè: { :x
	tèt-li miltipliye-pa: x.
}.

Nimewo lè: ['divideBy:'] fè: { :x
	tèt-li divize-pa: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 pisans: 8).  
a := a + (2 pisans: -1). 
a := a + (49 rasin-kare).   
a addNum: ((Lis ← 0 ; 1) maksimòm).          
a addNum: ((Lis ← 2 ; 3) minimòm).
Sòti ekri: a.

Pwogram netwaye.

usedMemory1 := (Pwogram memwa ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 pisans: 8).  
a := a + (2 pisans: -1). 
a := a + (49 rasin-kare).   
a addNum: ((Lis ← 0 ; 1) maksimòm).          
a addNum: ((Lis ← 2 ; 3) minimòm).
Sòti ekri: a.

Pwogram netwaye.
usedMemory2 := (Pwogram memwa ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 pisans: 8).  
a := a + (2 pisans: -1). 
a := a + (49 rasin-kare).   
a addNum: ((Lis ← 0 ; 1) maksimòm).          
a addNum: ((Lis ← 2 ; 3) minimòm).
Sòti ekri: a.

Pwogram netwaye.
usedMemory3 := (Pwogram memwa ? 0).



( usedMemory1 = usedMemory2 ak: usedMemory1 = usedMemory3, ak: usedMemory2 = usedMemory3 ) vre: {
	Sòti ekri: ['No memory leaks here'].
}, fo: {
	Sòti ekri: ['Leaking memory...'].
}.
