# test qualifiers

>> $ := Objè nouvo.

$ lè: ['reponn:'] fè: { :x
	
	>> operation := x karaktè: 0.
	>> valuta := x karaktè: 1.
	>> money := x sote: 2.
	
	>> amount := 0.

	( operation = ['+'] ) vre: {
		( valuta = ['£'] ) vre: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Sòti ekri: x, nouvo-liy.


>> Fruit := Objè nouvo.

Fruit lè: ['nouvo'] fè: {
	>> f := tèt-li nouvo.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit lè: ['apples:'] fè: { :a pwòp apples := a. }.
Fruit lè: ['oranges:'] fè: { :p pwòp oranges := p. }.
Fruit lè: ['apples'] fè: { <- pwòp apples. }.
Fruit lè: ['oranges'] fè: { <- pwòp oranges. }.

Fruit lè: ['+'] fè: { :f
	
	>> n := Fruit nouvo.
	f ajoute: 1.
	
	n apples: (f apples + pwòp apples).
	n oranges:  (f oranges  + pwòp oranges). <- n.
}.

Fruit lè: ['tèks'] fè: { <- ( pwòp apples tèks + [' apples and '] + pwòp oranges + [' oranges'] ).
}.

Nimewo lè: ['apples'] fè: { <- ((Fruit nouvo) apples: tèt-li).
}.

Nimewo lè: ['apple'] fè: { <- ((Fruit nouvo) apples: tèt-li).
}.

Nimewo lè: ['oranges'] fè: { <- ((Fruit nouvo) oranges: tèt-li).
}.




Sòti ekri: (1 apple + 3 oranges + 4 apples), nouvo-liy.


Tèks lè: ['twice'] fè: { <- ((tèt-li tèks) + (tèt-li tèks)).
}.



Sòti ekri: ['❤❤❤'] twice.



