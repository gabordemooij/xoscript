Sòti ekri: ['Test object'], nouvo-liy.
>> a := Objè nouvo. 
a lè: ['item:'] fè: { :int64
	pwòp int64 := int64. 
}.
a lè: ['item'] fè: { <- pwòp int64.
}.
a item: ( Int64 apati-tèks: ['9999'] ).
Sòti ekri: a item, nouvo-liy.
>> old-int64-address := a item pwototip adrès-memwa.
a save-as: ['/tmp/a.bin'].
Sòti ekri: ['========== RELOADING SNAP:'], nouvo-liy.
>> b := Objè load-from: ['/tmp/a.bin'].
(b item pwototip adrès-memwa = old-int64-address) vre: {
	Sòti ekri: ['Object link re-attached.'], nouvo-liy.
}.
Sòti ekri: ( b item ), nouvo-liy.
