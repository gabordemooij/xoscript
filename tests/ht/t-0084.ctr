>> makeAdder := { :x
	>> f := { :y <- (pwòp x + y). } fikse: ['x'] valè: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i pwòp q mete: (pwòp f aplike: (pwòp q ? i)) nan: i. } 
	fikse: ['q'] valè: array,
	fikse: ['f'] valè: func.
	{ :i mapping aplike: i. } × (array konte).
}.

>> a := Lis ← 1; 2; 3.
mapper aplike: a ak: (makeAdder aplike: 100).
Sòti ekri: (a pozisyon: 0), nouvo-liy.
Sòti ekri: (a ? 1), nouvo-liy.
Sòti ekri: (a ? 2), nouvo-liy.
