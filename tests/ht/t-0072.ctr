>> echo := Objè nouvo.
echo lè: ['reponn:'] fè: { :sound
	{ Sòti ekri: sound. } × 2.
}.
echo ho!. 


echo := Objè nouvo.
echo lè: ['reponn:ak:'] fè: { :sound :x
	{ Sòti ekri: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := Objè nouvo.
echo lè: ['reponn:ak:ak:'] fè: { :operation :sound :x
	{ Sòti ekri: sound. } × x.
}.
echo shout: ['la'] times: 4. 


