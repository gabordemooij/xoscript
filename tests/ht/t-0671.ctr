# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Kòfrefò kreye-kle.

# private (secret) key
>> sk := keys premye.

# public key
>> pk := keys dènye.

# sign a message
>> sig := Kòfrefò siyen: ['abc'] ak: sk.

# check message (ok)
Sòti ekri: ( 
	Kòfrefò
		tcheke: ['abc'] 
		siyati: sig 
		ak: pk 
), nouvo-liy.

# check message (fail)
Sòti ekri: ( 
	Kòfrefò 
		tcheke: ['abd'] 
		siyati: sig 
		ak: pk 
), nouvo-liy.