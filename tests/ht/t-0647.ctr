Server init.
Sòti ekri: ['Database time test'], nouvo-liy.

>> db := Maria-DB nouvo lame: ['localhost'],
	non-itilizatè: ['xo'], 
	modpas: ['pass123'],
	non-baz: ['xobase'],
	konekte.

>> paramèt-rechèch :=
db rekèt: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
chache: { :row
	Sòti ekri: row timetest, nouvo-liy.
}.
