#Linux
>> OS := Pwogram sistèm: (Kòmand uname -s), taye-espas.

>> Slurp := Objè nouvo.
Slurp lè: ['nouvo'] fè: {
	pwòp str := [''].
}.
Slurp lè: ['reponn:'] fè: { :blah
		(pwòp str ≠ ['']) vre: {
			pwòp str ajoute-nan-fen: [' '].
		}.
		pwòp str ajoute-nan-fen: blah.
}.
Slurp lè: ['reponn:ak:'] fè: { :blah :blahah
		(pwòp str ≠ ['']) vre: {
			pwòp str ajoute-nan-fen: [' '].
		}.
		(blah longè > 1) vre: {
			pwòp str ajoute-nan-fen: (blah soti-nan: 0 longè: (blah longè - 1)).
		}, sinon: {
			pwòp str ajoute-nan-fen: blah.
		}.
		pwòp str ajoute-nan-fen: [' '].
		pwòp str ajoute-nan-fen: blahah.
}.
Slurp lè: ['obtain'] fè: {
	>> buffer := pwòp str.
	pwòp str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text ajoute-nan-fen: ['hello'].
} × 1000.


Sòti ekri: (
	Pwogram sistèm: (
		Slurp nouvo
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

