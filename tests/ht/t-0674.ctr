# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> chemen-fichye := ['/tmp/dat.csv'].
>> csv := Fichye nouvo: chemen-fichye.
csv ekri: s.

# accepts CRLF LF CR, varying row length
csv separatè: [';'] gimè: ['"'] liy-yo: { :line
	Pwogram netwaye.
	Sòti ekri: line, nouvo-liy.
	Pwogram netwaye.
}.

# unequal lines
s ajoute-nan-fen: ['\njustone'].
csv ekri: s.
{
	csv separatè: [';'] gimè: ['"'] liy-yo: { :line
		Sòti ekri: line, nouvo-liy.
	}.
} trape: { :e 
	Sòti ekri: e, nouvo-liy.
}, lanse.

# invalid format
s := ['"he"llo";world'].
csv ekri: s.
{
	csv separatè: [';'] gimè: ['"'] liy-yo: { :line
		Sòti ekri: line, nouvo-liy.
	}.
} trape: { :e 
	Sòti ekri: e, nouvo-liy.
}, lanse.
