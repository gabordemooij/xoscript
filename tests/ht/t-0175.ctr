

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> x := 100.

Pwogram jesyon-memwa: 0.

{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt ajoute-nan-fen: ['!!'].
Sòti ekri: txt.
} lanse.

Pwogram netwaye.

usedMemory1 := (Pwogram memwa ? 0).


{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt ajoute-nan-fen: ['!!'].
Sòti ekri: txt.
} lanse.

Pwogram netwaye.
usedMemory2 := (Pwogram memwa ? 0).


{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt ajoute-nan-fen: ['!!'].
Sòti ekri: txt.
} lanse.

Pwogram netwaye.
usedMemory3 := (Pwogram memwa ? 0).



( usedMemory1 = usedMemory2 ak: usedMemory1 = usedMemory3, ak: usedMemory2 = usedMemory3 ) vre: {
	Sòti ekri: ['No memory leaks here'].
}, fo: {
	Sòti ekri: ['Leaking memory...'].
}.
