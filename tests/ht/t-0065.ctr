Nimewo lè: ['factorial'] fè: {
	>> total := 1.
	{ :index total miltipliye-pa: (tèt-li - (index)). } × tèt-li. <- total.
}.
>> Printer := Objè nouvo.
Printer lè: ['print:and:'] fè: { :x :y
	Sòti ekri: ['a='] + x + [', b='] + y, nouvo-liy.
}.
>> a := 4.5. >> b := a awondi-anba.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a awondi-anwo.
Printer print: a and: b.
a := 4.5. b := a awondi-anba.
Printer print: a and: b.
a := 4.5. b := a awondi.
Printer print: a and: b.
a := 4.2. b := a awondi.
Printer print: a and: b.

