Sòti ekri: ['1,2,3,4,5,6,7,8,9,A,'], nouvo-liy.
>> Scope := Objè nouvo.
Scope lè: ['initialize:'] fè: { :x pwòp property := x. }.
Scope lè: ['confirm'] fè: { Sòti ekri: [',']. }.
Scope lè: ['tès'] fè: {
	Sòti ekri: pwòp property.
	tèt-li confirm.
	( 1 = 1 ) vre: { Sòti ekri: pwòp property. tèt-li confirm. }.
	( 1 = 0 ) fo: { Sòti ekri: pwòp property. tèt-li confirm. }.
	>> y := 2. { Sòti ekri: pwòp property. tèt-li confirm. } pandan-ke: { y soustrè: 1. <- (y > 0). }.
	{ Sòti ekri: pwòp property. tèt-li confirm. } × 1.
	(Lis ← 1) chak: {  Sòti ekri: pwòp property. tèt-li confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Diksyonè nouvo one: ['item']) chak: { Sòti ekri: pwòp property. tèt-li confirm. }.
	{ 1 ÷ 0. } trape: { Sòti ekri: pwòp property. tèt-li confirm. }, lanse.
	Sòti nouvo-liy.
}.
>> scope1 := Scope nouvo.
scope1 initialize: ['X'].
scope1 tès.
>> function := { 
	pwòp property := ['Y'].
	Sòti ekri: pwòp property.
	tèt-li confirm.
	( 1 = 1 ) vre: { Sòti ekri: pwòp property. tèt-li confirm. }.
	( 1 = 0 ) fo: { Sòti ekri: pwòp property. tèt-li confirm. }.
	>> y := 2. { Sòti ekri: pwòp property. tèt-li confirm. } pandan-ke: { y soustrè: 1. <- (y > 0). }.
	{ Sòti ekri: pwòp property. tèt-li confirm. } × 1.
	(Lis ← 1) chak: {  Sòti ekri: pwòp property. tèt-li confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Diksyonè nouvo one: ['item']) chak: { Sòti ekri: pwòp property. tèt-li confirm. }.
	{ 1 ÷ 0. } trape: { Sòti ekri: pwòp property. tèt-li confirm. }, lanse.
	Sòti nouvo-liy.
}.
function lè: ['confirm'] fè: { Sòti ekri: [',']. }.
function aplike: 1 ak: 2.
