# recursive interpolation not allowed

Sòti ekri: 
['recursive string interolation enabled: '] + (
	Pwogram fonksyonalite: 
	['RECURSIVE_STRINTPOL']
), nouvo-liy.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Sòti ekri: a, nouvo-liy.


Pwogram fonksyonalite: ['RECURSIVE_STRINTPOL'] aktive: Vre.

Sòti ekri: 
['recursive string interpolation enabled: '] + (
	Pwogram fonksyonalite: 
	['RECURSIVE_STRINTPOL']
), nouvo-liy.

>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Sòti ekri: a, nouvo-liy.

Pwogram fonksyonalite: ['RECURSIVE_STRINTPOL'] aktive: Fo.

Sòti ekri: 
['recursive string interpolation enabled: '] + (
	Pwogram fonksyonalite: 
	['RECURSIVE_STRINTPOL']
), nouvo-liy.

>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Sòti ekri: a, nouvo-liy.
