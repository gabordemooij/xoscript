Sòti ekri: ['Test object'], nouvo-liy.
>> l := Lis nouvo ; 1 ; ( Lis nouvo ; (Moman nouvo: 1) ; (Int64 apati-tèks: ['321']) ; (Lis nouvo ; 3)).
Sòti ekri: l, nouvo-liy.
>> old-lst-address := l pwototip adrès-memwa.
l save-as: ['/tmp/a.bin'].
Sòti ekri: ['========== RELOADING SNAP:'], nouvo-liy.
>> b := Objè load-from: ['/tmp/a.bin'].
(b pwototip adrès-memwa = old-lst-address) vre: {
	Sòti ekri: ['Object link re-attached.'], nouvo-liy.
}.
Sòti ekri: b, nouvo-liy.
