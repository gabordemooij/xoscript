Sòti ekri: ['Test object'], nouvo-liy.
>> a := Objè nouvo. 

a lè: ['item:'] fè: { :octhelper
	pwòp octhelper := octhelper. 
}.

a lè: ['item'] fè: { <- pwòp octhelper.
}.

a item: Oct nouvo.

>> old-octhelper-address := a item pwototip adrès-memwa.
a save-as: ['/tmp/a.bin'].
Sòti ekri: ['========== RELOADING SNAP:'], nouvo-liy.

>> b := Objè load-from: ['/tmp/a.bin'].

(b item pwototip adrès-memwa = old-octhelper-address) vre: {
	Sòti ekri: ['Object link re-attached.'], nouvo-liy.
}.
