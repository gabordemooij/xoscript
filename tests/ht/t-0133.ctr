


>> Deck := Lis nouvo.
Deck lè: ['print'] fè: {
        >> len := tèt-li konte - 1.
        { :i
                >> len2 := tèt-li konte - 1.
                Sòti ekri: ['len: '].
                Sòti ekri: len, nouvo-liy.
                Sòti ekri: ['len2: '].
                Sòti ekri: len2, nouvo-liy.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
