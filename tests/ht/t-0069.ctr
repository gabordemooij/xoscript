

Tèks lè: ['html'] fè: { <- (
		tèt-li
		ranplase: ['&'] ak: ['&amp;'],
		ranplase: ['<'] ak: ['&lt;'],
		ranplase: ['>'] ak: ['&gt;'],
		ranplase: ['"'] ak: ['&quot;']
	).
}.


Sòti ekri: ([' left trimmed '] taye-espas) + [' '] + ( ['and right trimmed'] taye-espas) + ['!'], nouvo-liy.
Sòti ekri: ['<html>"html & entities"</html>'] html.
