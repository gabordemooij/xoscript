#Linux
>> OS := Pwogram paramèt: ['OS'].

>> clock := Moman nouvo.
	
(OS = ['Haiku']) vre: {
	clock zòn: ['CET'],
	ane: 2017, mwa: 7, jou: 13,
	lè: 18, minit: 0, segonn: 0.
}, sinon: {
	clock zòn: ['Europe/Amsterdam'],
	ane: 2017, mwa: 7, jou: 13,
	lè: 18, minit: 0, segonn: 0.
}.

clock lè: ['tell'] fè: {
	Sòti ekri: tèt-li, nouvo-liy.
}.


clock ajoute: 2    lè, tell.
clock ajoute: 1    lè, tell.
clock ajoute: 19 minit, tell.
clock ajoute: 1  minit, tell.
clock ajoute: 1  minit, tell.
clock ajoute: 19 segonn, tell.
clock ajoute: 1  segonn, tell.
clock ajoute: 1  segonn, tell.
clock ajoute: 2    ane, tell.
clock ajoute: 1    ane, tell.

(OS = ['Haiku']) vre: {
clock ajoute: 5   mwa.
clock zòn: ['CEST'], tell.
}, sinon: {
	clock ajoute: 5   mwa, tell.
}.

clock ajoute: 1   mwa, tell.
clock ajoute: 19    jou, tell.
clock ajoute: 1    lè, tell.
clock ajoute: 120  yard, tell.
