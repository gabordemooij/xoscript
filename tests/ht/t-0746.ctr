Sòti ekri: ['Test object'], nouvo-liy.
>> a := Objè nouvo. 

a lè: ['item:'] fè: { :dict
	pwòp dict := dict. 
}.

a lè: ['item'] fè: { <- pwòp dict.
}.

a item: (
Diksyonè nouvo
	hello: ['world'],
	world: (Diksyonè nouvo mete: ['a'] nan: ['b'])).

Sòti ekri: a item, nouvo-liy.

>> old-dict-address := a item pwototip adrès-memwa.
a save-as: ['/tmp/a.bin'].
Sòti ekri: ['========== RELOADING SNAP:'], nouvo-liy.

>> b := Objè load-from: ['/tmp/a.bin'].

(b item pwototip adrès-memwa = old-dict-address) vre: {
	Sòti ekri: ['Object link re-attached.'], nouvo-liy.
}.

Sòti ekri: b item, nouvo-liy.
