#Linux

(Fichye nouvo: ['/tmp/testje']) egziste fo: {
	Pwogram sistèm: ['mkdir /tmp/testje'].	
}.

(Fichye nouvo: ['/tmp/testje/file1']) egziste fo: {
	Pwogram sistèm: ['touch /tmp/testje/file1'].	
}.

(Fichye nouvo: ['/tmp/testje/folder1']) egziste fo: {
	Pwogram sistèm: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Fichye lis: ['/tmp/testje'].

>> q := Lis nouvo.

l chak: { :k :v v chak: { :x :y q ajoute-nan-fen: y. }. }.

>> s := q tèks.

(s gen-ladan: ['file1']) vre:   { Sòti ekri: ['OK'], nouvo-liy. }.
(s gen-ladan: ['file2']) vre:   { Sòti ekri: ['XX'], nouvo-liy. }.
(s gen-ladan: ['folder1']) vre: { Sòti ekri: ['OK'], nouvo-liy. }.
