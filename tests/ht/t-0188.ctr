

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Pwogram jesyon-memwa: 0.

{ :i Sòti ekri: i. } × 4.
Sòti nouvo-liy.
{ :i Sòti ekri: (4 - i). } × 4.
Sòti nouvo-liy.
( 1 > 2 ) fo: { Sòti ekri: ['BLOCK 1'], nouvo-liy. }.
( 2 > 1 ) vre:  { Sòti ekri: ['BLOCK 2'], nouvo-liy. }.

>> i := 0.
{ Sòti ekri: i. i ajoute: 1. } pandan-ke: { <- ( i < 3). }.
Sòti nouvo-liy.

i := 3.
{ Sòti ekri: i. i := i - 1. } pandan-ke: { <- ( i > 0). }.
Sòti nouvo-liy.


Pwogram netwaye.

usedMemory1 := (Pwogram memwa ? 0).


{ :i  Sòti ekri: i. } × 4.
Sòti nouvo-liy.
{ :i  Sòti ekri: (4 - i). } × 4.
Sòti nouvo-liy.
( 1 > 2 ) fo: { Sòti ekri: ['BLOCK 1'], nouvo-liy. }.
( 2 > 1 ) vre:  { Sòti ekri: ['BLOCK 2'], nouvo-liy. }.

>> i := 0.
{ Sòti ekri: i. i ajoute: 1. } pandan-ke: { <- ( i < 3). }.
Sòti nouvo-liy.

i := 3.
{ Sòti ekri: i. i := i - 1. } pandan-ke: { <- ( i > 0). }.
Sòti nouvo-liy.



Pwogram netwaye.
usedMemory2 := (Pwogram memwa ? 0).


{ :i Sòti ekri: i. } × 4.
Sòti nouvo-liy.
{ :i Sòti ekri: (4 - i). } × 4.
Sòti nouvo-liy.
( 1 > 2 ) fo: { Sòti ekri: ['BLOCK 1'], nouvo-liy. }.
( 2 > 1 ) vre:  { Sòti ekri: ['BLOCK 2'], nouvo-liy. }.

>> i := 0.
{ Sòti ekri: i. i ajoute: 1. } pandan-ke: { <- ( i < 3). }.
Sòti nouvo-liy.

i := 3.
{ Sòti ekri: i. i := i - 1. } pandan-ke: { <- ( i > 0). }.
Sòti nouvo-liy.

Pwogram netwaye.
usedMemory3 := (Pwogram memwa ? 0).



( usedMemory1 = usedMemory2 ak: usedMemory1 = usedMemory3, ak: usedMemory2 = usedMemory3 ) vre: {
	Sòti ekri: ['No memory leaks here'].
}, fo: {
	Sòti ekri: ['Leaking memory...'].
}.
