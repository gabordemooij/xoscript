>> phrases := Siyahı yeni
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases hər: { :_ :phrase 
	>> e := Server base64-kodla: phrase.
	>> d := Server base64-dekodla: e.
	Çıxış yaz: (
		message surət ~encoded: e, ~decoded: d
	), yeni-sətir.
}.
