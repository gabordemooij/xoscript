

Mətn olanda: ['evaluate'] et: {
	>> kod := Fayl yeni: ['/tmp/eval.ctr'].
	kod yaz: (özü mətn + ['.']).
	Proqram istifadə-et: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Siyahı ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q mətn.
Çıxış yaz: x, yeni-sətir.
>> y := Heç.
(['y := '] + x ) evaluate.
Çıxış yaz: y ? 0, yeni-sətir.

q := Lüğət qoy: ['\[''] yerə: ['\['quote\']'].
x := q mətn.
Çıxış yaz: x, yeni-sətir.
y := Heç.
(['y := '] + x ) evaluate.

>> q := (Lüğət yeni) qoy:['\[''] yerə:['\['quote\[''].
Çıxış yaz: y ? ['\['quote\']'], yeni-sətir.
