>> makeAdder := { :x
	>> f := { :y <- (öz x + y). } təyin-et: ['x'] dəyər: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i öz q qoy: (öz f tətbiq-et: (öz q ? i)) yerə: i. } 
	təyin-et: ['q'] dəyər: array,
	təyin-et: ['f'] dəyər: func.
	{ :i mapping tətbiq-et: i. } × (array say).
}.

>> a := Siyahı ← 1; 2; 3.
mapper tətbiq-et: a və: (makeAdder tətbiq-et: 100).
Çıxış yaz: (a mövqe: 0), yeni-sətir.
Çıxış yaz: (a ? 1), yeni-sətir.
Çıxış yaz: (a ? 2), yeni-sətir.
