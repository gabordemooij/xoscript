#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Şablon yeni: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern uyğunluq: subject et: { :m :x
	Çıxış yaz: m, yeni-sətir.
	Çıxış yaz: x, yeni-sətir. <- ['XXX'].
}.
Çıxış yaz: result, yeni-sətir.