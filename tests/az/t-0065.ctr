Ədəd olanda: ['factorial'] et: {
	>> total := 1.
	{ :index total vur: (özü - (index)). } × özü. <- total.
}.
>> Printer := Obyekt yeni.
Printer olanda: ['print:and:'] et: { :x :y
	Çıxış yaz: ['a='] + x + [', b='] + y, yeni-sətir.
}.
>> a := 4.5. >> b := a aşağı-yuvarlaqlaşdır.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a yuxarı-yuvarlaqlaşdır.
Printer print: a and: b.
a := 4.5. b := a aşağı-yuvarlaqlaşdır.
Printer print: a and: b.
a := 4.5. b := a yuvarlaqlaşdır.
Printer print: a and: b.
a := 4.2. b := a yuvarlaqlaşdır.
Printer print: a and: b.

Çıxış yaz: (9 qalıq: 5), yeni-sətir.
Çıxış yaz: -666 mütləq-qiymət, yeni-sətir.
Çıxış yaz: 49 kvadrat-kök, yeni-sətir.
Çıxış yaz: (2 qüvvət: 3), yeni-sətir.
>> l := (Siyahı ← 9 ; 6).
Çıxış yaz: l minimum.

