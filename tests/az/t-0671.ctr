# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Seyf açar-yarat.

# private (secret) key
>> sk := keys birinci.

# public key
>> pk := keys sonuncu.

# sign a message
>> sig := Seyf imzala: ['abc'] açar: sk.

# check message (ok)
Çıxış yaz: ( 
	Seyf
		yoxla: ['abc'] 
		imza: sig 
		açar: pk 
), yeni-sətir.

# check message (fail)
Çıxış yaz: ( 
	Seyf 
		yoxla: ['abd'] 
		imza: sig 
		açar: pk 
), yeni-sətir.