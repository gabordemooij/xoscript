# test buffers PKI/Sign 
Server init.

>> long := ( Siyahı yeni doldur: 1000 ilə: ['a'] ) birləşdir: [''].

# sign a message
Çıxış yaz: ( 
	Seyf imzala: ['abc'] açar: long
), yeni-sətir.

Çıxış yaz: ( 
	Seyf
		yoxla: ['abc'] 
		imza: long 
		açar: long
), yeni-sətir.

Çıxış yaz: (
	Seyf parol-heşi: long yoxla: long
), yeni-sətir.
