Çıxış yaz: ['Test object'], yeni-sətir.
>> a := Obyekt yeni. 

a olanda: ['item:'] et: { :hexhelper
	öz hexhelper := hexhelper. 
}.

a olanda: ['item'] et: { <- öz hexhelper.
}.

a item: Hx yeni.

>> old-hexhelper-address := a item prototip yaddaş-ünvanı.
a save-as: ['/tmp/a.bin'].
Çıxış yaz: ['========== RELOADING SNAP:'], yeni-sətir.

>> b := Obyekt load-from: ['/tmp/a.bin'].

(b item prototip yaddaş-ünvanı = old-hexhelper-address) doğru: {
	Çıxış yaz: ['Object link re-attached.'], yeni-sətir.
}.
