>> Animal := Obyekt yeni.
Animal olanda: ['make'] et: {
	>> animal := Obyekt yeni.
	animal olanda: ['makeSound'] et: {
		Çıxış yaz: öz sound.
	}. <- animal.
}.
>> Cat := Obyekt yeni.
Cat olanda: ['make'] et: {
	>> cat := Animal make.
	cat olanda: ['init'] et: {
		öz sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
