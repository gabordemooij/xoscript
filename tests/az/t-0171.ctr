

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Proqram yaddaş-idarəsi: 0.

>> a := Siyahı ← ['hello'] ; ['world'] ; Doğru ; Heç ; 666.
a et sonuncunu-götür birincini-götür əvvələ-əlavə-et: ['hi'], sona-əlavə-et: 999, hazır.
Çıxış yaz: ( a birləşdir: [','] ), yeni-sətir.

Proqram təmizlə.
usedMemory1 := (Proqram yaddaş ? 0).


a := Siyahı ← ['hello'] ; ['world'] ; Doğru ; Heç ; 666.
a sonuncunu-götür. a birincini-götür. a əvvələ-əlavə-et: ['hi'], sona-əlavə-et: 999.
Çıxış yaz: ( a birləşdir: [','] ), yeni-sətir.


Proqram təmizlə.
usedMemory2 := (Proqram yaddaş ? 0).


a := Siyahı ← ['hello'] ; ['world'] ; Doğru ; Heç ; 666.
a et sonuncunu-götür birincini-götür əvvələ-əlavə-et: ['hi'], sona-əlavə-et: 999, hazır.
Çıxış yaz: ( a birləşdir: [','] ), yeni-sətir.


Proqram təmizlə.
usedMemory3 := (Proqram yaddaş ? 0).



( usedMemory1 = usedMemory2 və: usedMemory1 = usedMemory3, və: usedMemory2 = usedMemory3 ) doğru: {
	Çıxış yaz: ['No memory leaks here'].
}, yalan: {
	Çıxış yaz: ['Leaking memory...'].
}.
