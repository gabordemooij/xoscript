Proqram yaddaş-idarəsi: 0.
Siyahı olanda: ['sum'] et: {
	>> total := 0.
	özü hər: { :index :element
		total əlavə-et: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Fayl yeni: ['/tmp/test.txt'].
f yaz: ['Lorem Ipsum'].
f bağla-əlaqəni.
  

f := Fayl yeni: ['/tmp/test.txt'].
>> text := f oxu.
f bağla-əlaqəni.



Proqram təmizlə.
usedMemory1 := (Proqram yaddaş ? 1).



f := Fayl yeni: ['/tmp/test.txt'].
text := f oxu.
f bağla-əlaqəni.

Proqram təmizlə.
usedMemory2 := (Proqram yaddaş ? 1).


f := Fayl yeni: ['/tmp/test.txt'].
text := f oxu.
f bağla-əlaqəni.

Proqram təmizlə.
usedMemory3 := (Proqram yaddaş ? 1).



( usedMemory1 = usedMemory2 və: usedMemory1 = usedMemory3, və: usedMemory2 = usedMemory3 ) doğru: {
	Çıxış yaz: ['No memory leaks here'].
}, yalan: {
	Çıxış yaz: ['Leaking memory...'].
}.
