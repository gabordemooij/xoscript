


>> wine := Obyekt yeni.


wine olanda: ['toString'] et: { <- ['merlot'].
}.

wine olanda: ['naarTekst'] et: { <- ['merlot'].
}.


wine olanda: ['='] et: { :other wine <- ( özü toString = other wine ).
}.

wine olanda: ['=='] et: { :other wine <- ( özü toString = other wine ).
}.



wine
	hal: ['cabernet'] et: { Çıxış yaz: ['it's a Cabernet!']. },
	hal: ['syrah']    et: { Çıxış yaz: ['it's a Syrah!'].    },
	hal: ['merlot']   et: { Çıxış yaz: ['it's a Merlot!'].   },
	hal: ['malbec']   et: { Çıxış yaz: ['it's a Malbec!'].   }.

Çıxış yeni-sətir.
