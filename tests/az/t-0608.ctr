
>> Size := Obyekt yeni.
Size olanda: ['is:'] et: { :ədəd
	ədəd olanda: ['+'] et: { :ədəd
		>> unit := ədəd təyinedici.
		>> factor := 1.
		
		unit
		hal: ['inch'] et: { factor := 0.0833. }. <- özü + (ədəd * factor).
	}. <- ədəd.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Çıxış yaz: plank + edge, yeni-sətir.
