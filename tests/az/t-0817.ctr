# a value ending in the first part of an opening quote must survive serialization
>> dəyərlər := Siyahı yeni
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

dəyərlər hər: { :i :value
	>> d := Lüğət yeni.
	d qoy: value yerə: ['k'].
	d qoy: ['second'] yerə: ['j'].
	>> r := d kod obyekt.
	Çıxış yaz: r say, yeni-sətir.
	Çıxış yaz: ( (r yerdə: ['k']) = value ), yeni-sətir.
}.
