Server init.
Çıxış yaz: ['Database time test'], yeni-sətir.

>> db := Maria-DB yeni host: ['localhost'],
	istifadəçi: ['xo'], 
	parol: ['pass123'],
	baza-adı: ['xobase'],
	qoşul.

>> axtarış-parametrləri :=
db sorğu: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
gətir: { :row
	Çıxış yaz: row timetest, yeni-sətir.
}.
