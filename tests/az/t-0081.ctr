>> map1 := Lüğət yeni.
>> key1 := Siyahı yeni.
>> key2 := Siyahı yeni.

map1
	qoy: ['hello'] yerə: key1,
	qoy: ['world'] yerə: key2.


Çıxış
	yaz: ['Map #1 contains: '] + (map1 yerdə: key1),
	yaz: [' and '] + (map1 yerdə: key2), yeni-sətir.

>> KeyeableArray := Siyahı yeni.
KeyeableArray olanda: ['toString'] et: { <- (özü say) toString.
}.

>> map2 := Lüğət yeni.
key1 := KeyeableArray yeni.
key2 := KeyeableArray yeni.

key1 sona-əlavə-et: 1.

map2
	qoy: ['hello'] yerə: key1,
	qoy: ['world'] yerə: key2.

Çıxış
	yaz: ['Map #2 contains: '] + (map2 yerdə: key1),
	yaz: [' and '] + (map2 yerdə: key2), yeni-sətir.
