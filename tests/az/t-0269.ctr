#Linux

(Fayl yeni: ['/tmp/testje']) mövcuddur yalan: {
	Proqram sistem: ['mkdir /tmp/testje'].	
}.

(Fayl yeni: ['/tmp/testje/file1']) mövcuddur yalan: {
	Proqram sistem: ['touch /tmp/testje/file1'].	
}.

(Fayl yeni: ['/tmp/testje/folder1']) mövcuddur yalan: {
	Proqram sistem: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Fayl siyahı: ['/tmp/testje'].

>> q := Siyahı yeni.

l hər: { :k :v v hər: { :x :y q sona-əlavə-et: y. }. }.

>> s := q mətn.

(s ehtiva-edir: ['file1']) doğru:   { Çıxış yaz: ['OK'], yeni-sətir. }.
(s ehtiva-edir: ['file2']) doğru:   { Çıxış yaz: ['XX'], yeni-sətir. }.
(s ehtiva-edir: ['folder1']) doğru: { Çıxış yaz: ['OK'], yeni-sətir. }.
