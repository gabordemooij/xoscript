>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Obyekt yeni.
⚄ olanda: ['drawFrom:length:'] et: { :pool :say
	
	>> result := [''].
	
	{
		>> index := Ədəd random % (pool uzunluq).
		result sona-əlavə-et: ( pool simvol: (index + 1) ).
		
	} × say. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? uzunluq.
Çıxış yaz: (['x↵'] x random uzunluq).
Çıxış yaz: (['y↵'] y ?? uzunluq).

