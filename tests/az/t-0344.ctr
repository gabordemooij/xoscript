# catch-all test (practical)
>> HTML := Mətn yeni.
HTML olanda: ['encode:'] et: { :tekst
	özü sona-əlavə-et: (tekst
	əvəzlə: ['&'] ilə: ['&amp;'], 
	əvəzlə: ['<'] ilə: ['&lt;'],
	əvəzlə: ['>'] ilə: ['&gt;'],
	əvəzlə: ['"'] ilə: ['&quot;']).
}.
>> blog := HTML yeni.
blog sona-əlavə-et: ['<h1>'],
     encode: ['Koffie & Thee'],
     sona-əlavə-et: ['</h1>'].
Çıxış yaz: blog, yeni-sətir.


>> Roman := Ədəd yeni.
Roman olanda: ['stringy'] et: {
	>> a := [''].
	{ a sona-əlavə-et: ['I']. } × özü. <- a.
}.

>> x := Roman yeni.
x əlavə-et: 3.
Çıxış yaz: x stringy, yeni-sətir.

>> Quantum := Məntiqi yeni.
Quantum olanda: ['true?'] et: { <- ['maybe True']. }.
Çıxış yaz: (Quantum yeni true?), yeni-sətir.

>> Nihil := Heç yeni.
Nihil olanda: ['mətn'] et: { <- ['Nihil']. }.
Çıxış yaz: (Nihil yeni), yeni-sətir.
