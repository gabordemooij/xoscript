>> randomizer := { :a :b
	>> minimum := ( a < b ) ya: a ya: b.
	>> maksimum := ( a > b ) ya: a ya: b.
	>> x := Heç.
	{
		x := Ədəd arasında: a və: b.
		((x < minimum) və-ya: (x > maksimum)) doğru: { 
			Çıxış yaz: (['Invalid value!']).
			Proqram son.
		}.
	} 
	× 100. <- x.
}.
