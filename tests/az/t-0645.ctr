Server init.
Çıxış yaz: ['Database date test'], yeni-sətir.

>> db := Maria-DB yeni host: ['localhost'],
	istifadəçi: ['xo'], 
	parol: ['pass123'],
	baza-adı: ['xobase'],
	qoşul.

>> axtarış-parametrləri :=
db sorğu: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
gətir: { :row
	Çıxış yaz: row datetest, yeni-sətir.
}.
