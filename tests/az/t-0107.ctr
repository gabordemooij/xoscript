
Çıxış yaz: ['Break for-loop, 0-4.'], yeni-sətir.
{ :i
	Çıxış yaz: ['iteration #'] + i, yeni-sətir.
	(i = 4) kəs.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Çıxış yaz: ['Break while-true loop, 0-4.'], yeni-sətir.
{
	Çıxış yaz: ['iteration #'] + x, yeni-sətir.
	x əlavə-et: 1.
	((x < 5) deyil) kəs.
} nə-qədər-ki: xIsLessThan10.

Çıxış yaz: ['Break while-false loop, 5,4.'], yeni-sətir.
{
	Çıxış yaz: ['iteration #'] + x, yeni-sətir.
	x çıxart: 1.
	(x = 3) kəs.
} nə-qədər-ki: { <- (x > 0). }.

Çıxış yaz: ['Break times loop, 1-4.'], yeni-sətir.
{ :i
	Çıxış yaz: ['iteration #'] + i, yeni-sətir.
	(i = 4) kəs.
} × 5.

Çıxış yaz: ['Break block, dont print line.'], yeni-sətir.
{ Doğru kəs. Çıxış yaz: ['dont write this!'], yeni-sətir. } başlat.

Çıxış yaz: ['Break block, dont fire catch...'], yeni-sətir.
{ Doğru kəs. Çıxış yaz: ['dont write this!'], yeni-sətir. } tut: { Çıxış yaz: ['Dont catch this!']. }, başlat.

Çıxış yaz: ['Test Array each-loop: 0,1'], yeni-sətir.
(Siyahı ← 1 ; 2 ; 3) çevir: { :i
	Çıxış yaz: ['iteration #'] + i, yeni-sətir.
	(i = 1) kəs.
}.

Çıxış yaz: ['Test Map each-loop: c only'], yeni-sətir.
>> m := Lüğət yeni.
m qoy: ['first'] yerə: ['a'], qoy: ['second'] yerə: ['b'], qoy: ['third'] yerə: ['c'].
m hər: { :k :v
	Çıxış yaz: ['iteration'] + v + k, yeni-sətir.
	Doğru kəs.
}.

