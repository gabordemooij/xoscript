>> Point := Obyekt yeni.
Point olanda: ['x-coordinate:'] et: { :x öz x := x. }.
Point olanda: ['y-coordinate:'] et: { :y öz y := y. }.
Point olanda: ['x-coordinate']  et: { <- öz x surət. }.
Point olanda: ['y-coordinate']  et: { <- öz y surət. }.

Point olanda: ['='] et: { :other <- ( öz x = other x-coordinate
		 və: öz y = other y-coordinate ).
}.

>> pier := Point yeni x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point yeni x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point yeni x-coordinate: 5, y-coordinate: 6.

Çıxış yaz: pier = town-hall, yeni-sətir.
Çıxış yaz: pier = restaurant, yeni-sətir.
