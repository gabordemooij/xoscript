# backslashes must survive code serialization, strings must not end early
>> dəyərlər := Siyahı yeni
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

dəyərlər hər: { :i :value
	>> d := Lüğət yeni.
	d qoy: value yerə: ['k'].
	>> r := d kod obyekt.
	Çıxış yaz: r say, yeni-sətir.
	Çıxış yaz: ( (r yerdə: ['k']) = value ), yeni-sətir.
}.
