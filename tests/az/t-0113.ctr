Çıxış yaz: ['Continue for-loop, No - before 6 and up.'], yeni-sətir.
{ :i
	Çıxış yaz: (i + 1), yeni-sətir.
	((i + 1) > 4) davam-et.
	Çıxış yaz: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Çıxış yeni-sətir.
Çıxış yaz: ['Continue while-true, No --> before 5 and up.'], yeni-sətir.
{
	Çıxış yaz: ['iteration #'] + x, yeni-sətir.
	x əlavə-et: 1.
	((x < 5) deyil) davam-et.
	Çıxış yaz: ['-->'].
} nə-qədər-ki: xIsLessThan10.
Çıxış yeni-sətir.
Çıxış yaz: ['Continue while-false, No - before 3 only.'], yeni-sətir.
{
	Çıxış yaz: ['iteration #'] + x, yeni-sətir.
	x çıxart: 1.
	(x = 3) davam-et.
	Çıxış yaz: ['-'].
} nə-qədər-ki: { <- ( x > 0). }.

Çıxış yeni-sətir.
Çıxış yaz: ['Continue times-loop, No ||| before 3.'], yeni-sətir.
{ :i
	Çıxış yaz: ['iteration #'] + i, yeni-sətir.
	(i = 2) davam-et.
	Çıxış yaz: ['|||'].
} × 5.

Çıxış yeni-sətir.

{ Doğru davam-et. Çıxış yaz: ['dont write this!'], yeni-sətir. } başlat.

{ Doğru davam-et. Çıxış yaz: ['dont write this!'], yeni-sətir. } tut: { Çıxış yaz: ['Dont catch this!']. }, başlat.

Çıxış yaz: ['Test Array each-loop: 0, ... ,2'], yeni-sətir.
(Siyahı ← 1 ; 2 ; 3) çevir: { :i
	(i = 1) davam-et.
	Çıxış yaz: ['iteration #'] + (i - 0), yeni-sətir.
}.

Çıxış yaz: ['Test Map each-loop: c only'], yeni-sətir.
>> m := Lüğət yeni.
m qoy: ['first'] yerə: ['a'], qoy: ['second'] yerə: ['b'], qoy: ['third'] yerə: ['c'].
m hər: { :k :v
	(k ≠ ['c']) davam-et.
	Çıxış yaz: ['iteration'] + k + v, yeni-sətir.
}.

