#Linux
>> clock := An yeni.
clock zona: ['UTC-1'].
clock il: 1981, ay: 1, gün: 5,
      saat: 13, dəqiqə: 15, saniyə: 13.

Çıxış yaz: clock, yeni-sətir.
clock zona: ['UTC+0'].

Çıxış yaz: (
	(clock il sadə) + ['-'] + (clock ay) + ['-'] + (clock gün) + [' '] +
	(clock saat) + [':'] + (clock dəqiqə) + [':'] + (clock saniyə) + [' '] +
	['W'] + (clock həftə) + (clock zona)
), yeni-sətir.


clock zona: ['UTC-1'].
Çıxış yaz: (
	(clock il sadə) + ['-'] + (clock ay) + ['-'] + (clock gün) + [' '] +
	(clock saat) + [':'] + (clock dəqiqə) + [':'] + (clock saniyə) + [' '] +
	['W'] + (clock həftə) + (clock zona)
), yeni-sətir.
