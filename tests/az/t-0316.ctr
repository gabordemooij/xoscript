>> Grandfather := Obyekt yeni.
Grandfather olanda: ['greet'] et: {
	Çıxış yaz: ['Ave!'], yeni-sətir.
}.
>> Father := Grandfather yeni.
Father olanda: ['greet'] et: {
	Çıxış yaz: ['Hello'], yeni-sətir.
	özü greet.
}.
>> Son := Father yeni.
Son olanda: ['greet'] et: {
	Çıxış yaz: ['Hi'], yeni-sətir.
	özü greet.
}.

Son greet.

>> Roundabout := Obyekt yeni.
Roundabout olanda: ['circle:'] et: { :x
	Çıxış yaz: x, yeni-sətir.
	(x < 3) doğru: { özü rekursiv circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) doğru: { Çıxış yaz: x, yeni-sətir. x əlavə-et: 1.  increment başlat. }. }.
increment başlat.