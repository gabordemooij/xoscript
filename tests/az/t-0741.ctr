Çıxış yaz: ['Test object'], yeni-sətir.
>> a := Obyekt yeni. 

a olanda: ['item:'] et: { :octhelper
	öz octhelper := octhelper. 
}.

a olanda: ['item'] et: { <- öz octhelper.
}.

a item: Oct yeni.

>> old-octhelper-address := a item prototip yaddaş-ünvanı.
a save-as: ['/tmp/a.bin'].
Çıxış yaz: ['========== RELOADING SNAP:'], yeni-sətir.

>> b := Obyekt load-from: ['/tmp/a.bin'].

(b item prototip yaddaş-ünvanı = old-octhelper-address) doğru: {
	Çıxış yaz: ['Object link re-attached.'], yeni-sətir.
}.
