>> str := ['write:'].
Çıxış mesaj: ['yaz:'] arqumentlər: (Siyahı ← ['Hello World']), yeni-sətir. 

Ədəd olanda: ['isbetween:and:'] et: { :a :b <- ((özü ≥ a) və: (özü ≤ b)).
}.

str := ['isbetween:and:'].
Çıxış yaz: (3 mesaj: str arqumentlər: (Siyahı ← 2 ; 8)), yeni-sətir.
Çıxış yaz: (3 mesaj: str arqumentlər: (Siyahı ← 1 ; 2)), yeni-sətir.


>> CoffeeMachine := Obyekt yeni.
CoffeeMachine olanda: ['makeCoffeeWithSugar:milk:'] et: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Siyahı ← 4 ; 2.
Çıxış yaz: ( CoffeeMachine mesaj: order arqumentlər: coffeeConfiguration ), yeni-sətir.
