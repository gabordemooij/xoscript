Ədəd olanda: ['roman'] et: {
	>> ədəd := özü surət.
	>> roman := [''].
	{
		{
			(ədəd ≥ 1000) doğru: {
				roman sona-əlavə-et: ['Ⅿ'].
				ədəd çıxart: 1000.
			}, kəs.
		
			(ədəd ≥ 500) doğru: {
				roman sona-əlavə-et: ['Ⅾ'].
				ədəd çıxart: 500.
			}, kəs.
		
			(ədəd ≥ 100) doğru: {
				roman sona-əlavə-et: ['Ⅽ'].
				ədəd çıxart: 100.
			}, kəs.
		
			(ədəd ≥ 50) doğru: {
				roman sona-əlavə-et: ['Ⅼ'].
				ədəd çıxart: 50.
			}, kəs.
		
			(ədəd ≥ 50) doğru: {
				roman sona-əlavə-et: ['Ⅼ'].
				ədəd çıxart: 50.
			}, kəs.
		
			(ədəd ≥ 10) doğru: {
				roman sona-əlavə-et: ['Ⅹ'].
				ədəd çıxart: 10.
			}, kəs.
			
			(ədəd ≥ 9) doğru: {
				roman sona-əlavə-et: ['Ⅸ'].
				ədəd çıxart: 9.
			}, kəs.
			
			(ədəd ≥ 5) doğru: {
				roman sona-əlavə-et: ['Ⅴ'].
				ədəd çıxart: 5.
			}, kəs.
			
			(ədəd ≥ 4) doğru: {
				roman sona-əlavə-et: ['Ⅳ'].
				ədəd çıxart: 4.
			}, kəs.
			
			(ədəd ≥ 1) doğru: {
				roman sona-əlavə-et: ['Ⅰ'].
				ədəd çıxart: 1.
			}, kəs.
		} prosedur.
	} nə-qədər-ki: { <- ədəd > 0. }. <- roman.
}.

Çıxış yaz: 1 roman, yeni-sətir.
Çıxış yaz: 2 roman, yeni-sətir.
Çıxış yaz: 4 roman, yeni-sətir.
Çıxış yaz: 8 roman, yeni-sətir.
Çıxış yaz: 16 roman, yeni-sətir.
Çıxış yaz: 32 roman, yeni-sətir.
Çıxış yaz: 64 roman, yeni-sətir.
Çıxış yaz: 128 roman, yeni-sətir.
Çıxış yaz: 256 roman, yeni-sətir.
Çıxış yaz: 1024 roman, yeni-sətir.
