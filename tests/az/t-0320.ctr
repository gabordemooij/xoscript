


>> CoffeeMachine := Obyekt yeni.
CoffeeMachine olanda: ['order:'] et: { :id
	>> coffee := ['Americano'].
	( id = 1 ) doğru: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) doğru: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) doğru: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Obyekt yeni.
SimpleCoffeeMachine olanda: ['order'] et: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Çıxış yaz: redCup, yeni-sətir.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Çıxış yaz: greenCup, yeni-sətir.
>> yellowCup := CoffeeMachine order: 1.
Çıxış yaz: yellowCup, yeni-sətir.
>> blueCup := CoffeeMachine order: 0.
Çıxış yaz: blueCup, yeni-sətir.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Çıxış yaz: blackCup, yeni-sətir.
blackCup sona-əlavə-et: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Çıxış yaz: orangeCup, yeni-sətir.
