#Linux
>> OS := Proqram parametr: ['OS'].

>> clock := An yeni.
	
(OS = ['Haiku']) doğru: {
	clock zona: ['CET'],
	il: 2017, ay: 7, gün: 13,
	saat: 18, dəqiqə: 0, saniyə: 0.
}, əks-halda: {
	clock zona: ['Europe/Amsterdam'],
	il: 2017, ay: 7, gün: 13,
	saat: 18, dəqiqə: 0, saniyə: 0.
}.

clock olanda: ['tell'] et: {
	Çıxış yaz: özü, yeni-sətir.
}.


clock əlavə-et: 2    saat, tell.
clock əlavə-et: 1    saat, tell.
clock əlavə-et: 19 dəqiqə, tell.
clock əlavə-et: 1  dəqiqə, tell.
clock əlavə-et: 1  dəqiqə, tell.
clock əlavə-et: 19 saniyə, tell.
clock əlavə-et: 1  saniyə, tell.
clock əlavə-et: 1  saniyə, tell.
clock əlavə-et: 2    il, tell.
clock əlavə-et: 1    il, tell.

(OS = ['Haiku']) doğru: {
clock əlavə-et: 5   ay.
clock zona: ['CEST'], tell.
}, əks-halda: {
	clock əlavə-et: 5   ay, tell.
}.

clock əlavə-et: 1   ay, tell.
clock əlavə-et: 19    gün, tell.
clock əlavə-et: 1    saat, tell.
clock əlavə-et: 120  yard, tell.
