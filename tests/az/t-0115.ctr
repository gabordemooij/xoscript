{
	bu-tapşırıq səhv: ['Dont fail.'].
	unknown doSomething.
} tut: {
	Çıxış yaz: ['Caught!'].
}, başlat.

{
	bu-tapşırıq səhv: ['Dont fail.'].
	öz unknown doSomething.
} tut: {
	Çıxış yaz: ['Caught!'].
}, başlat.

{
	bu-tapşırıq səhv: ['Dont fail.'].
	unknown := 122.
} tut: {
	Çıxış yaz: ['Caught!'].
}, başlat.


{
	bu-tapşırıq səhv: ['Dont fail.'].
	Doğru kəs.
	Çıxış yaz: ['FAIL'].
} tut: {
	Çıxış yaz: ['Caught!'].
}, başlat.

{
	{
		bu-tapşırıq səhv: ['Dont fail.'].
		Doğru kəs.
		Çıxış yaz: ['FAIL'].
	} tut: { :x
		(x = ['Dont fail.']) doğru: { bu-tapşırıq səhv: ['Nested Caught!']. }.
	}, başlat.
} tut: { :e
	Çıxış yaz: e.
}, başlat.
