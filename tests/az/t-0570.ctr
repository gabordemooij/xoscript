#Linux

 >> t := An yeni.
 
t zona: ['Europe/Amsterdam'].
t il: 2020, ay: 8, gün: 2, saat: 21, dəqiqə: 2, saniyə: 1.

>> a := t saat.
>> ams := t zona.

t zona: ['US/Hawaii'].
>> b := t saat.
>> hw := t zona.

Çıxış
yaz: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		ya: ['later'] ya: ['earlier']
	)
),
yeni-sətir.
 