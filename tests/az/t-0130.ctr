# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Proqram parametr: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server bağla: ( Siyahı yeni ;
 libname ; ['fopen'] ;
 ( Siyahı yeni ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
bağla: ( Siyahı yeni ;
 Heç ; # means same lib
 ['fread'] ;
 ( Siyahı yeni ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Heç ; # means same object (i.e. Stream)
 ['fread']
),
bağla: (
 Siyahı yeni ;
 Heç ; # means same lib
 ['fwrite'] ;
 ( Siyahı yeni ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Heç ; # means same lib
 ['fwrite']
),
bağla: (
 Siyahı yeni ;
 Heç ; # means same lib
 ['rewind'] ;
 ( Siyahı yeni ; ['pointer'] ) ;
 ['int'] ;
 Heç ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> yol := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: yol mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream mesaj: ['fwrite'] arqumentlər: (Siyahı yeni ; str ; 1 ; 6 ; fd ).
Çıxış yaz: bytes-written, yeni-sətir.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob yeni: 20.

# read from file
>> bytes-read := Stream mesaj: ['fread'] arqumentlər: (Siyahı yeni ; buf ; 1 ; 6 ; fd ).
Çıxış yaz: bytes-read, yeni-sətir.
Çıxış yaz: buf, yeni-sətir.

# free memory
str  azad-et.
yol azad-et.
mode azad-et.
buf  azad-et.


