60 × {
	>> x := (Ədəd random % 6) + 1.
	(x ≤ 6) yalan: { Çıxış yaz: ['FAIL']. }.
	(x ≥0) yalan: { Çıxış yaz: ['FAIL']. }.
	x := (Ədəd random % 3) + 1.
	(x < 3) yalan: { Çıxış yaz: ['FAIL']. }.
	(x>-1) yalan: { Çıxış yaz: ['FAIL']. }.
	x := ((Məntiqi flip) ədəd).
	(x = 0 və-ya: x = 1) yalan: { Çıxış yaz: ['FAIL']. }.
	x := ((Doğru flip) ədəd).
	(x = 0 və-ya: x = 1) yalan: { Çıxış yaz: ['FAIL']. }.
	x := (Məntiqi flip ya: ['HEAD'] ya: ['TAIL']).
	((x = ['HEAD']) və-ya: (x = ['TAIL'])) yalan: { Çıxış yaz: ['FAIL']. }.
}.
Çıxış yaz: ['DONE'].

