Ədəd olanda: ['factorial'] et: {
	>> total := 1.
	{ :index total vur: (özü - index). } × özü. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Proqram yaddaş-idarəsi: 0.

{
2 exponent factorial.
Çıxış yaz: (11 qalıq: 3), yeni-sətir.
Çıxış yaz: (3.4 yuvarlaqlaşdır), yeni-sətir.
Çıxış yaz: (7.1 yuxarı-yuvarlaqlaşdır), yeni-sətir.
Çıxış yaz: (7.9 aşağı-yuvarlaqlaşdır), yeni-sətir.
}
başlat.

Proqram təmizlə.

usedMemory1 := (Proqram yaddaş ? 0).

{
2 exponent factorial.
Çıxış yaz: (11 qalıq: 3), yeni-sətir.
Çıxış yaz: (3.4 yuvarlaqlaşdır), yeni-sətir.
Çıxış yaz: (7.1 yuxarı-yuvarlaqlaşdır), yeni-sətir.
Çıxış yaz: (7.9 aşağı-yuvarlaqlaşdır), yeni-sətir.
}
başlat.

Proqram təmizlə.
usedMemory2 := (Proqram yaddaş ? 0).


{
2 exponent factorial.
Çıxış yaz: (11 qalıq: 3), yeni-sətir.
Çıxış yaz: (3.4 yuvarlaqlaşdır), yeni-sətir.
Çıxış yaz: (7.1 yuxarı-yuvarlaqlaşdır), yeni-sətir.
Çıxış yaz: (7.9 aşağı-yuvarlaqlaşdır), yeni-sətir.
} başlat.

Proqram təmizlə.
usedMemory3 := (Proqram yaddaş ? 0).



( usedMemory1 = usedMemory2 və: usedMemory1 = usedMemory3, və: usedMemory2 = usedMemory3 ) doğru: {
	Çıxış yaz: ['No memory leaks here'].
}, yalan: {
	Çıxış yaz: ['Leaking memory...'].
}.
