

Siyahı olanda: ['fixture:'] et: { :f
	öz fixture := f.
}.

Siyahı olanda: ['say'] et: { <- öz fixture.
}.

Siyahı olanda: ['aantal'] et: { <- öz fixture.
}.


>> x := Heç.
{

	x := ['hello'] 
	əvəzlə:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] simvol: 2)
			)
		)
	ilə: (
		(['...hal'] + ['lo']) 
			böyük-hərf 
			lowecase 
			böyük-hərf 
			sürüşmə: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Siyahı ← 0 ; 1 ; 4; 9 ; (Siyahı ← 0 ; 3; 1) ; 4
							) sondan-əvvəlki
						) ? 1
					) + 
					((Siyahı ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					say
				)
			)
	).

} × 10.
Çıxış yaz: x, yeni-sətir.

