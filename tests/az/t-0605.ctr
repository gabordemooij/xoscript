>> invoice := Obyekt yeni.
invoice olanda: ['başlat'] et: {
        öz ədəd := 0.
}.

invoice olanda: ['ədəd'] et: {
        öz ədəd əlavə-et: 1. <- öz ədəd surət.
}.

>> year-invoice := invoice yeni.
year-invoice olanda: ['start:'] et: { :il
	öz ədəd := il.
}.

year-invoice start: 202000.
Çıxış yaz: year-invoice ədəd, yeni-sətir.
Çıxış yaz: year-invoice ədəd, yeni-sətir.
