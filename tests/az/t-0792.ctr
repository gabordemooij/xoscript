Server init.

>> DB := Maria-DB yeni host: ['localhost'],
	istifadəçi: ['xo'],
	parol: ['pass123'],
	baza-adı: ['xobase'],
	qoşul.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB sorğu: SQL.

# now you don't have to set DB
query2 gətir: { :row
	Çıxış yaz: row world, yeni-sətir.
}.
