#Linux
>> OS := Proqram sistem: (Əmr uname -s), kəsib-düzəlt.

>> Slurp := Obyekt yeni.
Slurp olanda: ['yeni'] et: {
	öz str := [''].
}.
Slurp olanda: ['cavab-ver:'] et: { :blah
		(öz str ≠ ['']) doğru: {
			öz str sona-əlavə-et: [' '].
		}.
		öz str sona-əlavə-et: blah.
}.
Slurp olanda: ['cavab-ver:və:'] et: { :blah :blahah
		(öz str ≠ ['']) doğru: {
			öz str sona-əlavə-et: [' '].
		}.
		(blah uzunluq > 1) doğru: {
			öz str sona-əlavə-et: (blah başlanğıc: 0 uzunluq: (blah uzunluq - 1)).
		}, əks-halda: {
			öz str sona-əlavə-et: blah.
		}.
		öz str sona-əlavə-et: [' '].
		öz str sona-əlavə-et: blahah.
}.
Slurp olanda: ['obtain'] et: {
	>> buffer := öz str.
	öz str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text sona-əlavə-et: ['hello'].
} × 1000.


Çıxış yaz: (
	Proqram sistem: (
		Slurp yeni
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

