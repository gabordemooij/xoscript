# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB yeni host: ['localhost'],
	istifadəçi: ['xo'],
	parol: ['pass123'],
	baza-adı: ['xobase'],
	qoşul.

>> axtarış-parametrləri := db sorğu: ['SELECT %% FROM'].
{ axtarış-parametrləri icra-et. } tut: { :e
	Çıxış yaz: ( e ehtiva-edir: ['%%'] ), yeni-sətir.
}, başlat.
