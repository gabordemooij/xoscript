Server init.

>> DB := Maria-DB yeni host: ['localhost'],
	istifadəçi: ['xo'],
	parol: ['pass123'],
	baza-adı: ['xobase'],
	qoşul.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> axtarış-parametrləri := Maria-Sorğu yeni: SQL.

# set database
axtarış-parametrləri verilənlər-bazası: DB.

axtarış-parametrləri gətir: { :row
	Çıxış yaz: row world, yeni-sətir.
}.
