

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Proqram yaddaş-idarəsi: 0.

>> txt := ['Word Salad'].
Çıxış yaz: ['Text Length: '] + txt uzunluq, yeni-sətir.
Çıxış yaz: ['Character at 2:'] + ( txt simvol: 2 ), yeni-sətir.
Çıxış yaz: (( txt tap: ['S'] ) - 0), yeni-sətir.

Proqram təmizlə.

usedMemory1 := (Proqram yaddaş ? 0).


txt := ['Word Salad'].
Çıxış yaz: ['Text Length: '] + txt uzunluq, yeni-sətir.
Çıxış yaz: ['Character at 2:'] + ( txt simvol: 2 ), yeni-sətir.
Çıxış yaz: (( txt tap: ['S'] ) - 0), yeni-sətir.

Proqram təmizlə.
usedMemory2 := (Proqram yaddaş ? 0).


txt := ['Word Salad'].
Çıxış yaz: ['Text Length: '] + txt uzunluq, yeni-sətir.
Çıxış yaz: ['Character at 2:'] + ( txt simvol: 2 ), yeni-sətir.
Çıxış yaz: (( txt tap: ['S'] ) - 0), yeni-sətir.

Proqram təmizlə.
usedMemory3 := (Proqram yaddaş ? 0).



( usedMemory1 = usedMemory2 və: usedMemory1 = usedMemory3, və: usedMemory2 = usedMemory3 ) doğru: {
	Çıxış yaz: ['No memory leaks here'].
}, yalan: {
	Çıxış yaz: ['Leaking memory...'].
}.
