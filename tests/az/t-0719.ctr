Server init.
>> fmt := Format yeni: ['%#3x'].

>> blob := Blob yeni: 4.
blob bytes: ( 
	Siyahı yeni ; 0 ; 1 ; 2 ; 3
).

>> file := Fayl yeni: ['/tmp/blob'].
file blob: blob.
blob azad-et.

>> oxu := file blob.
oxu 
başlanğıc: 0 
uzunluq: 4, 
et hər: { :i :b 
	Çıxış
	yaz: (fmt tətbiq-et-tam: b),
	yeni-sətir.
}.
oxu azad-et.
