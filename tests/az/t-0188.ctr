

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Proqram yaddaş-idarəsi: 0.

{ :i Çıxış yaz: i. } × 4.
Çıxış yeni-sətir.
{ :i Çıxış yaz: (4 - i). } × 4.
Çıxış yeni-sətir.
( 1 > 2 ) yalan: { Çıxış yaz: ['BLOCK 1'], yeni-sətir. }.
( 2 > 1 ) doğru:  { Çıxış yaz: ['BLOCK 2'], yeni-sətir. }.

>> i := 0.
{ Çıxış yaz: i. i əlavə-et: 1. } nə-qədər-ki: { <- ( i < 3). }.
Çıxış yeni-sətir.

i := 3.
{ Çıxış yaz: i. i := i - 1. } nə-qədər-ki: { <- ( i > 0). }.
Çıxış yeni-sətir.


Proqram təmizlə.

usedMemory1 := (Proqram yaddaş ? 0).


{ :i  Çıxış yaz: i. } × 4.
Çıxış yeni-sətir.
{ :i  Çıxış yaz: (4 - i). } × 4.
Çıxış yeni-sətir.
( 1 > 2 ) yalan: { Çıxış yaz: ['BLOCK 1'], yeni-sətir. }.
( 2 > 1 ) doğru:  { Çıxış yaz: ['BLOCK 2'], yeni-sətir. }.

>> i := 0.
{ Çıxış yaz: i. i əlavə-et: 1. } nə-qədər-ki: { <- ( i < 3). }.
Çıxış yeni-sətir.

i := 3.
{ Çıxış yaz: i. i := i - 1. } nə-qədər-ki: { <- ( i > 0). }.
Çıxış yeni-sətir.



Proqram təmizlə.
usedMemory2 := (Proqram yaddaş ? 0).


{ :i Çıxış yaz: i. } × 4.
Çıxış yeni-sətir.
{ :i Çıxış yaz: (4 - i). } × 4.
Çıxış yeni-sətir.
( 1 > 2 ) yalan: { Çıxış yaz: ['BLOCK 1'], yeni-sətir. }.
( 2 > 1 ) doğru:  { Çıxış yaz: ['BLOCK 2'], yeni-sətir. }.

>> i := 0.
{ Çıxış yaz: i. i əlavə-et: 1. } nə-qədər-ki: { <- ( i < 3). }.
Çıxış yeni-sətir.

i := 3.
{ Çıxış yaz: i. i := i - 1. } nə-qədər-ki: { <- ( i > 0). }.
Çıxış yeni-sətir.

Proqram təmizlə.
usedMemory3 := (Proqram yaddaş ? 0).



( usedMemory1 = usedMemory2 və: usedMemory1 = usedMemory3, və: usedMemory2 = usedMemory3 ) doğru: {
	Çıxış yaz: ['No memory leaks here'].
}, yalan: {
	Çıxış yaz: ['Leaking memory...'].
}.
