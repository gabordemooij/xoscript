Çıxış yaz: ['Test object'], yeni-sətir.
>> a := Obyekt yeni. 

a olanda: ['item:'] et: { :out
	öz out := out. 
}.

a olanda: ['item'] et: { <- öz out.
}.

a olanda: ['greet'] et: {
	Çıxış yaz: ['hi from original out!'], yeni-sətir.
}.

a item: Çıxış.

Çıxış yaz: a item, yeni-sətir.

>> old-out-address := a item prototip yaddaş-ünvanı.
a save-as: ['/tmp/a.bin'].
Çıxış yaz: ['========== RELOADING SNAP:'], yeni-sətir.

>> b := Obyekt load-from: ['/tmp/a.bin'].

(b item prototip yaddaş-ünvanı = old-out-address) doğru: {
	Çıxış yaz: ['Object link re-attached.'], yeni-sətir.
}.

b item yaz: ['hello from loaded out!'], yeni-sətir.
b greet.
