Mətn olanda: ['html'] et: { <- (
		özü
		əvəzlə: ['&'] ilə: ['&amp;'],
		əvəzlə: ['<'] ilə: ['&lt;'],
		əvəzlə: ['>'] ilə: ['&gt;'],
		əvəzlə: ['''] ilə: ['&apos;'],
		əvəzlə: ['"'] ilə: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Proqram yaddaş-idarəsi: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Çıxış yaz: txt surət html, yeni-sətir.
Çıxış yaz: txt surət kiçik-hərf, yeni-sətir.
Çıxış yaz: txt surət böyük-hərf, yeni-sətir.
} başlat.

Proqram təmizlə.

usedMemory1 := (Proqram yaddaş ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Çıxış yaz: txt surət html, yeni-sətir.
Çıxış yaz: txt surət kiçik-hərf, yeni-sətir.
Çıxış yaz: txt surət böyük-hərf, yeni-sətir.
} başlat.

Proqram təmizlə.
usedMemory2 := (Proqram yaddaş ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Çıxış yaz: txt surət html, yeni-sətir.
Çıxış yaz: txt surət kiçik-hərf, yeni-sətir.
Çıxış yaz: txt surət böyük-hərf, yeni-sətir.
} başlat.

Proqram təmizlə.
usedMemory3 := (Proqram yaddaş ? 0).



( usedMemory1 = usedMemory2 və: usedMemory1 = usedMemory3, və: usedMemory2 = usedMemory3 ) doğru: {
	Çıxış yaz: ['No memory leaks here'].
}, yalan: {
	Çıxış yaz: ['Leaking memory...'].
}.
