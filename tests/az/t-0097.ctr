
Mətn olanda: ['html'] et: { <- (
		özü
		əvəzlə: ['&'] ilə: ['&amp;'],
		əvəzlə: ['<'] ilə: ['&lt;'],
		əvəzlə: ['>'] ilə: ['&gt;'],
		əvəzlə: ['"'] ilə: ['&quot;']
	).
}.

>> HtmlBrush := Obyekt yeni.

HtmlBrush olanda: ['cavab-ver:'] et: { :tag
	Çıxış yaz: (['<tag>↵'] tag: tag ).
}.

HtmlBrush olanda: ['cavab-ver:və:'] et: { :tag :content
	tag := ( tag başlanğıc: 0 uzunluq: (tag uzunluq - 1) ).
	Çıxış yaz: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush olanda: ['content:'] et: { :text
	Çıxış yaz: text html, yeni-sətir.
}.

HtmlBrush olanda: ['attr:value:'] et: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush yeni.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
