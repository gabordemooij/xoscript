>> a := 3.
>> b := a surət.
a çıxart: 1.
Çıxış yaz: [' a = '] + a.
Çıxış yaz: [' b = '] + b.
a := 3.
b := a + 4.
Çıxış yaz: [' a = '] + a.
Çıxış yaz: [' b = '] + b.
>> x := 3.
>> y := x surət.
x əlavə-et: 10.
y çıxart: 1.
Çıxış yaz: [' x = '] + x.
Çıxış yaz: [' y = '] + y.
>> q := Obyekt yeni.
q olanda: ['setProperty:'] et: { :x
	öz prop := x.
}.
q olanda: ['getProperty'] et: { <- öz prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Çıxış yaz: [' p = '] + (p getProperty).
