

Siyahı olanda: ['sum'] et: {
	>> total := 0.
	özü hər: { :index :element
		total əlavə-et: element.
	}. <- total.
}.

Siyahı olanda: ['product'] et: {
	>> total := 1.
	özü hər: { :index :element
		total vur: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Proqram yaddaş-idarəsi: 0.

{

>> a := Siyahı ← ['hello'] ; ['world'] ; Doğru ; Heç ; 666.
a := a + ( Siyahı ← 1 ).
Çıxış yaz: ( ['sum: '] + ( a sum ) ), yeni-sətir.
Çıxış yaz: ( ['min: '] + ( a minimum ) ), yeni-sətir.
Çıxış yaz: ( ['max: '] + ( a maksimum ) ), yeni-sətir.
Çıxış yaz: ( ['3rd: '] + ( a ? 2 ) ), yeni-sətir.
Çıxış yaz: ( ['prd: '] + ( a product ) ), yeni-sətir.
a çeşidlə: { :a :b <- (b - a). }.
a hər: { :i :e Çıxış yaz: ( i - 0 ), yeni-sətir. }.

} başlat.

Proqram təmizlə.
usedMemory1 := (Proqram yaddaş ? 0).


{

>> a := Siyahı ← ['hello'] ; ['world'] ; Doğru ; Heç ; 666.
a := a + ( Siyahı ← 1 ).
Çıxış yaz: ( ['sum: '] + ( a sum ) ), yeni-sətir.
Çıxış yaz: ( ['min: '] + ( a minimum ) ), yeni-sətir.
Çıxış yaz: ( ['max: '] + ( a maksimum ) ), yeni-sətir.
Çıxış yaz: ( ['3rd: '] + ( a ? 2 ) ), yeni-sətir.
Çıxış yaz: ( ['prd: '] + ( a product ) ), yeni-sətir.
a çeşidlə: { :a :b <- (b - a). }.
a hər: { :i :e Çıxış yaz: ( i - 0 ), yeni-sətir. }.

} başlat.



Proqram təmizlə.
usedMemory2 := (Proqram yaddaş ? 0).


{

>> a := Siyahı ← ['hello'] ; ['world'] ; Doğru ; Heç ; 666.
a := a + ( Siyahı ← 1 ).
Çıxış yaz: ( ['sum: '] + ( a sum ) ), yeni-sətir.
Çıxış yaz: ( ['min: '] + ( a minimum ) ), yeni-sətir.
Çıxış yaz: ( ['max: '] + ( a maksimum ) ), yeni-sətir.
Çıxış yaz: ( ['3rd: '] + ( a ? 2 ) ), yeni-sətir.
Çıxış yaz: ( ['prd: '] + ( a product ) ), yeni-sətir.
a çeşidlə: { :a :b <- (b - a). }.
a hər: { :i :e Çıxış yaz: ( i - 0 ), yeni-sətir. }.

} başlat.



Proqram təmizlə.
usedMemory3 := (Proqram yaddaş ? 0).

( usedMemory1 = usedMemory2 və: usedMemory1 = usedMemory3, və: usedMemory2 = usedMemory3 ) doğru: {
	Çıxış yaz: ['No memory leaks here'].
}, yalan: {
	Çıxış yaz: ['Leaking memory...'].
}.
