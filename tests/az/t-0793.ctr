Server init.

>> DB := Maria-DB yeni host: ['localhost'],
	istifadəçi: ['xo'],
	parol: ['pass123'],
	baza-adı: ['xobase'],
	qoşul.

{
	DB sorğu:
	['DROP TABLE movies'],
	icra-et.
} tut: { Heç. }, başlat.

DB sorğu:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
icra-et.

DB sorğu: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parametrlər: ( Siyahı yeni ; ['Halloween'] ),
icra-et.

DB sorğu: ['SELECT * FROM movies'],
gətir: { :movie
	Çıxış yaz: movie title, yeni-sətir.
}.

