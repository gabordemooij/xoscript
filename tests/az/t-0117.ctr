>> t := Doğru.
(t = Doğru) doğru: { Çıxış yaz: ['T']. }.
(t = Yalan) doğru: { Çıxış yaz: ['F']. }.
Çıxış yaz: ['|'].
>> t := Yalan.
(t = Doğru) doğru: { Çıxış yaz: ['T']. }.
(t = Yalan) doğru: { Çıxış yaz: ['F']. }.
Çıxış yaz: ['|'].
>> f := Doğru.
(t = Doğru və: f = Yalan) doğru: { Çıxış yaz: ['T']. }.
(t = Yalan və: f = Doğru) doğru: { Çıxış yaz: ['F']. }.
Çıxış yaz: ['|'].
>> n := Heç.
(n Heç?) doğru: { Çıxış yaz: ['T']. }.
(n Heç?) yalan: { Çıxış yaz: ['F']. }.
Çıxış yaz: ['|'].
(f Boolean?) doğru: { Çıxış yaz: ['T']. }.
(f Boolean?) yalan: { Çıxış yaz: ['F']. }.



