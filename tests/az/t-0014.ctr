>> Greeter := Obyekt yeni.
Greeter olanda: ['make'] et: {
	>> gr := Obyekt yeni.
	gr olanda: ['setName:'] et: { :aname
		öz ad := aname.
	}.
	gr olanda: ['greet'] et: {
		Çıxış yaz: öz ad.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a yeni.
c setName: ['THREE'].
c greet.
>> d := a yeni.
d setName: ['FOUR'].
d greet.
c greet.
