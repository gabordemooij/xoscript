Proqram yaddaş-idarəsi: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } tut: {
		oops əlavə-et: 1.
	}, başlat.
} × 1000.

{
	Çıxış yaz: ['hi there!'].
	bu-tapşırıq səhv: ['oops'].
	Çıxış yaz: ['hi there!'].
	{ Çıxış yaz: ['dont print this']. } başlat.
} tut: { :e 
	Çıxış yaz: ['got ya!']. 
	Çıxış yaz: e.
}, başlat.
