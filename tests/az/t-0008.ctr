>> Greeter := Obyekt yeni.
Greeter olanda: ['make'] et: {
	>> greeter := Obyekt yeni.
	greeter olanda: ['name:'] et: { :ad
		Çıxış yaz: ['setting a name'].
		öz myName := ad.
	}.
	greeter olanda: ['greet'] et: {
		Çıxış yaz: ['Hello'].
		Çıxış yaz: öz myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
