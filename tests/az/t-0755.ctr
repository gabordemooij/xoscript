Çıxış yaz: ['Test object'], yeni-sətir.
>> greeter := Obyekt yeni.
greeter olanda: ['name:'] et: { :ad
	öz xname := ad. 
}.
greeter olanda: ['greet'] et: {
	Çıxış yaz: ['Hello '] + öz xname, yeni-sətir.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Çıxış yaz: ['========== RELOADING SNAP:'], yeni-sətir.
>> b := Obyekt load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
