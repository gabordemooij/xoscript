# test url parsing

Server init.
>> url := URL mənbə: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Çıxış yaz: ['scheme = '] + url sxem, yeni-sətir.
Çıxış yaz: ['host = '] + url host, yeni-sətir.
Çıxış yaz: ['port = '] + url port, yeni-sətir.
Çıxış yaz: ['path = '] + url yol, yeni-sətir.
Çıxış yaz: ['query = '] + url axtarış-parametrləri, yeni-sətir.
Çıxış yaz: ['fragment = '] + url fraqment, yeni-sətir.
