
Mətn olanda: ['evaluate'] et: {
	>> kod := Fayl yeni: ['/tmp/eval.ctr'].
	kod yaz: (özü mətn + ['.']).
	Proqram istifadə-et: ['/tmp/eval.ctr'].
}.

>> map :=
	(Lüğət yeni)
	qoy: ['Hi There'] yerə: ['two'],
	qoy: (Siyahı ← ['hello'] ; ['world'] ; (Siyahı ← 1 ; 2; 9) ; Yalan) yerə: ['one'],
	qoy: ( (Lüğət yeni) qoy: ['wrrld'] yerə: ['misspelled'] ) yerə: ['three'],
	qoy: (Siyahı ← ((Lüğət yeni) qoy: ['treasure'] yerə: ['hidden']) ; 2) yerə: ['four']. 
>> str := map mətn.
>> map2 := Heç.
(['map2 := '] + str ) evaluate.
Çıxış yaz: map2 ? ['one'] ? 0.
Çıxış yaz: map2 ? ['one'] ? 1.
Çıxış yaz: map2 ? ['four'] ? 0 ? ['hidden'].
Çıxış yaz: map2 ? ['one'] ? 2 ? 2.
