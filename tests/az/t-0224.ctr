
>> countries := Siyahı yeni
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Siyahı yeni
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods görə: countries, hər: { :key :value
	counter əlavə-et: 1.
}.

Çıxış yaz: (['we serve counter dishes'] counter: counter), yeni-sətir.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] simvollar çeşidlə: { :v
	counter əlavə-et: 0.
}.

Çıxış yaz: (['we sort counter dishes'] counter: counter), yeni-sətir.


>> counter := 0.
{
	{
		counter əlavə-et: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Çıxış yaz: (['we calculate counter numbers.'] counter: counter), yeni-sətir.

