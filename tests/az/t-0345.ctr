# test catch-all methods
>> x13 := Obyekt yeni.
x13 olanda: ['a'] et: { :a Çıxış yaz: 0, yeni-sətir. }.
x13 olanda: ['a:'] et: { :a Çıxış yaz: a, yeni-sətir. <- 5. }.
x13 olanda: ['a:b:'] et: { :a :b Çıxış yaz: (a + b), yeni-sətir. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
