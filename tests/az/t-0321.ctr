# test qualifiers

Proqram təmizlə.

>> Fruit := Obyekt yeni.
Fruit olanda: ['yeni'] et: {
	>> f := özü yeni.
	f apples: 0. <- f.
}.
Fruit olanda: ['apples:'] et: { :a öz apples := a. }.
Fruit olanda: ['apples'] et: { <- öz apples. }.
Fruit olanda: ['+'] et: { :f
	>> n := Fruit yeni.
	n apples: (f apples + öz apples). <- n.
}.
Ədəd olanda: ['apples'] et: { <- ((Fruit yeni) apples: özü).
}.

Fruit olanda: ['mətn'] et: { <- öz apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Çıxış yaz: q, yeni-sətir.




q := 3 apples + 4 apples.
Çıxış yaz: q, yeni-sətir.



q := 3 apples + 4 apples.
Çıxış yaz: q, yeni-sətir.


