
>> dictionary := (
	Lüğət yeni
		qoy: ['b'] yerə: ['a'],
		qoy: ['a'] yerə: ['b'],
		qoy: ['z'] yerə: ['x'],
		qoy: ['hello'] yerə: ['hallo'],
		qoy: ['human'] yerə: ['human']
).

>> comparisons := Siyahı yeni.
dictionary hər: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a müqayisə-et: b)
	).
}.

comparisons çeşidlə: { :a :b <- ( a müqayisə-et: b ). }.
Çıxış yaz: ( comparisons birləşdir: ['↵'] ), yeni-sətir.
comparisons birləşdir: ['↵'].
