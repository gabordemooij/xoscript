#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Proqram yaddaş-idarəsi: 0.

{
An vaxt.
An gözlə: 1.
Çıxış yaz: Proqram arqumentlər, yeni-sətir.
Proqram arqument: 0.
Ədəd random.
Çıxış yaz: (Proqram sistem: ['echo 'Hello'']).
} başlat.

Proqram təmizlə.
usedMemory1 := (Proqram yaddaş ? 0).

{
An vaxt.
An gözlə: 1.
Çıxış yaz: Proqram arqumentlər, yeni-sətir.
Proqram arqument: 0.
Ədəd random.
Çıxış yaz: (Proqram sistem: ['echo 'Hello'']).
} başlat.

Proqram təmizlə.
usedMemory2 := (Proqram yaddaş ? 0).

{
An vaxt.
An gözlə: 1.
Çıxış yaz: Proqram arqumentlər, yeni-sətir.
Proqram arqument: 0.
Ədəd random.
Çıxış yaz: (Proqram sistem: ['echo 'Hello'']).
} başlat.

Proqram təmizlə.
usedMemory3 := (Proqram yaddaş ? 0).



( usedMemory1 = usedMemory2 və: usedMemory1 = usedMemory3, və: usedMemory2 = usedMemory3 ) doğru: {
	Çıxış yaz: ['No memory leaks here'].
}, yalan: {
	Çıxış yaz: ['Leaking memory...'].
}.
