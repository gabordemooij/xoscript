

Siyahı olanda: ['column:'] et: { :column
	>> result := Siyahı yeni.
	özü hər: { :index :row
		row hər: { :index :cell
			(index = column) doğru: { result sona-əlavə-et: cell. }.
		}.
	}. <- result.
}.


>> a := Siyahı ←
	(Siyahı ← 1 ; 2 ; 3) ;
	(Siyahı ← 4 ; 5 ; 6) ;
	(Siyahı ← 7 ; 8 ; 9).

>> b := a column: 1.
Çıxış yaz: b, yeni-sətir.

b := a column: 20.
Çıxış yaz: b, yeni-sətir.

b := a column: -100.
Çıxış yaz: b, yeni-sətir.
