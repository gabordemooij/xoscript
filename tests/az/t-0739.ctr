Çıxış yaz: ['Test object'], yeni-sətir.
>> a := Obyekt yeni. 

a olanda: ['item:'] et: { :binhelper
	öz binhelper := binhelper. 
}.

a olanda: ['item'] et: { <- öz binhelper.
}.

a item: Bin yeni.

>> old-binhelper-address := a item prototip yaddaş-ünvanı.
a save-as: ['/tmp/a.bin'].
Çıxış yaz: ['========== RELOADING SNAP:'], yeni-sətir.

>> b := Obyekt load-from: ['/tmp/a.bin'].

(b item prototip yaddaş-ünvanı = old-binhelper-address) doğru: {
	Çıxış yaz: ['Object link re-attached.'], yeni-sətir.
}.


