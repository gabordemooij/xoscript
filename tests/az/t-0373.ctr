# compliance test

# use international numbers

Çıxış yaz: ['1000 -> '].
Çıxış yaz: 1000, yeni-sətir. #1000

Çıxış yaz: ['1.5 -> '].
Çıxış yaz: 1.5, yeni-sətir.  #1.5

Çıxış yaz: ['1001.5 -> '].
Çıxış yaz: 1.5 + 1000, yeni-sətir. #1001.5

# use 0-indexed arrays
>> x := Siyahı yeni ; 1 ; 2 ; 3.
>> y := Siyahı yeni ; ['a'] ; ['b'] ; ['c'].

Çıxış yaz: ['1 -> '].
Çıxış yaz: x ? 0, yeni-sətir. #1

Çıxış yaz: ['1 -> '].
Çıxış yaz: (x yerdə: 0), yeni-sətir. #1

Çıxış yaz: ['1 -> '].
Çıxış yaz: x birinci, yeni-sətir. #1

Çıxış yaz: ['3 -> '].
Çıxış yaz: x sonuncu, yeni-sətir. #3

Çıxış yaz: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Çıxış yaz: (x görə: y), yeni-sətir.

Çıxış yaz: ['1 -> '].
Çıxış yaz: (x başlanğıc: 0 uzunluq: 1) birinci, yeni-sətir. #1

Çıxış yaz: ['0 -> '].
Çıxış yaz: (x tap: 1), yeni-sətir. #0

x qoy: 9 yerə: 0.

Çıxış yaz: ['9 -> '].
Çıxış yaz: (x yerdə: 0), yeni-sətir. #9

x əvvələ-əlavə-et: 8.
Çıxış yaz: ['8 -> '].
Çıxış yaz: (x yerdə: 0), yeni-sətir. #9


x sona-əlavə-et: 10.
Çıxış yaz: ['10 -> '].
Çıxış yaz: (x yerdə: 4), yeni-sətir. #10








