# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Şablon yeni: pattern.
	p uyğunluq: subject et: { :m :g
		Çıxış yaz: g say, yaz: [' '], yaz: (g birləşdir: ['|']), yeni-sətir. <- m.
	}.
}.
show tətbiq-et: ['(a)|(b)'] və: ['b'].
show tətbiq-et: ['(a)|(b)'] və: ['a'].
show tətbiq-et: ['(x)?y'] və: ['y'].
show tətbiq-et: ['(x)?(y)(z)?'] və: ['xy'].
