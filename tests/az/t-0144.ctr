



>> CoffeeGrounds := Obyekt yeni.
CoffeeGrounds olanda: ['extract'] et: { <- ['coffee']. }.

>> CoffeeMachine := Obyekt yeni.
CoffeeMachine olanda: ['init'] et: {
	öz coffeegrounds := CoffeeGrounds yeni.
}.
CoffeeMachine olanda: ['yeni'] et: { <- CoffeeMachine `new init.
}.

CoffeeMachine olanda: ['makeTea'] et: { <- (öz tealeaves extract). }.
CoffeeMachine olanda: ['makeCoffee'] et: { <- (öz coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine yeni.

Çıxış yaz:
	coffeeDream 
	makeCoffee.

Çıxış yaz:
	coffeeDream 
	makeTea.
