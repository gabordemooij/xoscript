Məntiqi olanda: ['xor:'] et: { :a :b <- ((a və: b deyil) və-ya: (a deyil və: b)).
}.

>> o := Obyekt yeni.
o olanda: ['hello'] et: { ['Empty']. }.
{ o olanda: 2 et: 3.} tut: { :e Çıxış yaz: e, yeni-sətir. }, başlat.
{ o olanda: ['sınaq'] et: 3.} tut: { :e Çıxış yaz: e, yeni-sətir. }, başlat.
{ o olanda: ['hello'] et: { ['Empty']. }.} tut: { :e Çıxış yaz: e, yeni-sətir. }, başlat. 
{ >> z := 4 ÷ 0. } tut: { :e Çıxış yaz: e, yeni-sətir. }, başlat. 
{ (Doğru və: Heç) doğru: { Çıxış yaz: ['X'].}. } tut: { :e Çıxış yaz: e, yeni-sətir. }, başlat. 
{ ([''] xor: 0) doğru: { Çıxış yaz: ['X'].}. } tut: { :e Çıxış yaz: e, yeni-sətir. }, başlat. 
{ (1 < ['2']) doğru: { Çıxış yaz: ['OK']. }. } tut: { :e Çıxış yaz: e, yeni-sətir. }, başlat. 
{ (1 < ['2.0']) doğru: { Çıxış yaz: ['OK']. }. } tut: { :e Çıxış yaz: e, yeni-sətir. }, başlat. 
{ (1 < ['x2.0']) doğru: { Çıxış yaz: ['NO!']. }. } tut: { :e Çıxış yaz: e, yeni-sətir. }, başlat. 
{ Çıxış yaz: (['hello OK there'] başlanğıc: ['6'] uzunluq: ['2']). } başlat. 
