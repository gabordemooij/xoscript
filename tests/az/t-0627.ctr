

# create a 64-bit integer for exact calculations
>> a := Int64 mətndən: ['123'].

# to string
Çıxış yaz: a, yeni-sətir.

# divide
Çıxış yaz: a / (Int64 mətndən: ['3']), yeni-sətir.

# multiply
Çıxış yaz: a * (Int64 mətndən: ['2']), yeni-sətir.

# add
Çıxış yaz: a + (Int64 mətndən: ['1']), yeni-sətir.

# subtract
Çıxış yaz: a - (Int64 mətndən: ['2']), yeni-sətir.

# compare
Çıxış yaz: ( a =   (Int64 mətndən: ['123'])), yeni-sətir.
Çıxış yaz: ( a !=: (Int64 mətndən: ['124'])), yeni-sətir.
Çıxış yaz: ( a <   (Int64 mətndən: ['124'])), yeni-sətir.
Çıxış yaz: ( a >   (Int64 mətndən: ['122'])), yeni-sətir.
Çıxış yaz: ( a >=: (Int64 mətndən: ['123'])), yeni-sətir.
Çıxış yaz: ( a <=: (Int64 mətndən: ['123'])), yeni-sətir.





	