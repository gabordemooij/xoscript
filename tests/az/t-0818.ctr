# edge cases from a request must give an error or a result, not a crash
Server init.

Çıxış yaz: ['<'] + (['abc'] başlanğıc: 0 uzunluq: 0, böyük-hərf) + ['>'], yeni-sətir.
Çıxış yaz: ['<'] + (['abc'] başlanğıc: 0 uzunluq: 0, kiçik-hərf) + ['>'], yeni-sətir.
Çıxış yaz: ['<'] + (['abc'] sürüşmə: 3, böyük-hərf) + ['>'], yeni-sətir.
Çıxış yaz: [''] böyük-hərf bytes, yeni-sətir.
Çıxış yaz: ['aB'] böyük-hərf, yeni-sətir.
Çıxış yaz: ['aB'] kiçik-hərf, yeni-sətir.

Çıxış yaz: (An yeni: 0) il, yeni-sətir.
{ An yeni: ['9e300'] ədəd. } tut: { :e Çıxış yaz: e, yeni-sətir. }, başlat.
{ An yeni: ['-9e300'] ədəd. } tut: { :e Çıxış yaz: e, yeni-sətir. }, başlat.
{ An yeni: ['nan'] ədəd. } tut: { :e Çıxış yaz: e, yeni-sətir. }, başlat.
{ An yeni: 9000000000000000000. } tut: { :e Çıxış yaz: e, yeni-sətir. }, başlat.
