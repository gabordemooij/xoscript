Ədəd olanda: ['factorial'] et: {
	>> total := 1.
	{ :index total vur: (özü - (index)). } × özü. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Çıxış yaz: a.
>> b := 2 + 3 factorial.
Çıxış yaz: b.
>> c := 3 factorial + 2.
Çıxış yaz: c.
>> d := 2 + (3 factorial).
Çıxış yaz: d.
Çıxış yaz: 2 + 3 factorial + 1.
