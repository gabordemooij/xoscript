Server init.

# write a test file
>> f := Fayl yeni: ['/tmp/test.gif'].
f yaz: ['GIF87a01234567810'].

# serve the file
Server ötür: ['test.gif'] prefiks: ['/tmp/'].

Çıxış yeni-sətir.

Çıxış yaz: ['Outside container (security):'], yeni-sətir.
{ Server ötür: ['../passwd'] prefiks: ['/tmp/']. }
tut: { :e Çıxış yaz: e, yeni-sətir. },
başlat.

Çıxış yaz: ['Invalid prefix:'], yeni-sətir.
{ Server ötür: ['test.gif'] prefiks: ['z:\\']. }
tut: { :e Çıxış yaz: e, yeni-sətir. },
başlat.

Çıxış yaz: ['Non-existant file:'], yeni-sətir.
{ Server ötür: ['xxx.xxx'] prefiks: ['/tmp/']. }
tut: { :e Çıxış yaz: e, yeni-sətir. },
başlat.
