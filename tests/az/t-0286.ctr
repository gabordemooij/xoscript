['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Çıxış yaz: (x + y), yeni-sətir.

>> x := 10040.07.
>> y := 10305.60.

Çıxış yaz: (x + y), yeni-sətir.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Çıxış yaz: (x + y + z), yeni-sətir.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Çıxış yaz: (x + y + z), yeni-sətir.

>> q := 0.1.2.

Çıxış yaz: (q), yeni-sətir.

>> q := 012.

Çıxış yaz: (q), yeni-sətir.
