# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Seyf 
	parol-heşi: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Seyf 
	parol-heşi: hash yoxla: a1.
	# fail 
>> b := Seyf
	parol-heşi: hash yoxla: a2.
	# ok!

Çıxış yaz: a, yeni-sətir.
Çıxış yaz: b, yeni-sətir.

