>> To-Do := Obyekt yeni.

To-Do olanda: ['yeni'] et: {
	öz list := Siyahı yeni.
}.

To-Do olanda: ['nieuw'] et: {
	öz list := Siyahı yeni.
}.

To-Do olanda: ['+'] et: { :task
	öz list sona-əlavə-et: task.
}.

To-Do olanda: ['number of tasks?'] et: { <-  öz list say.
}.

>> todos := 
	To-Do yeni 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Çıxış yaz: ['You have $ tasks to do'] $ todos number of tasks?.
