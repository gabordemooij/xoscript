Server init.
>> f := Format yeni: ['%d'].
>> a := Blob yeni: 4.
a bytes: ( Siyahı yeni ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob yeni: 4.
b bytes: ( Siyahı yeni ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a başlanğıc: 0 uzunluq: 3, hər: { :i :byte
	Çıxış yaz: ( f tətbiq-et-tam: byte ), yeni-sətir.
}.
a ^ b.
a başlanğıc: 0 uzunluq: 3, hər: { :i :byte
	Çıxış yaz: ( f tətbiq-et-tam: byte ), yeni-sətir.
}.
a ^ b.
a başlanğıc: 0 uzunluq: 3, hər: { :i :byte
	Çıxış yaz: ( f tətbiq-et-tam: byte ), yeni-sətir.
}.
a azad-et.
b azad-et.

{ a ^ Obyekt. } tut: { :e Çıxış yaz: e, yeni-sətir. }, başlat.
