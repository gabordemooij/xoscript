
>> Rectangle := Obyekt yeni.

Rectangle olanda: ['area'] et: { <- öz uzunluq * öz width.
}.

Rectangle olanda: ['length:'] et: { :uzunluq
	öz uzunluq := uzunluq.
}.

Rectangle olanda: ['width:'] et: { :width
	öz width := width.
}.

Rectangle olanda: ['yeni'] et: {
	# this will not result into an infinite loop
	>> rectangle := özü yeni.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle yeni.
Çıxış yaz: a area, yeni-sətir. #0

>> b := Rectangle yeni length: 2, width: 3.
Çıxış yaz: b area, yeni-sətir. #6

