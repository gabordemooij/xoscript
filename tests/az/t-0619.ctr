>> HTML := Obyekt yeni.
HTML olanda: ['cavab-ver:'] et: { :tag 
	Çıxış yaz: (['<tag>'] tag: tag), yeni-sətir.
}.
HTML olanda: ['cavab-ver:və:'] et: { :tag :html 
	Çıxış yaz: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), yeni-sətir.
}.
>> html := HTML yeni.
html body h1: ['header'].

