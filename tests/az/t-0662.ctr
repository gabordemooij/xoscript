>> t := Heç.

# you can control the time zone for
# parsing like this:
An zona: ['CET'].
t := An mənbə: ['1981-02-03 04:05:06'].
Çıxış yaz: t, yeni-sətir.

# now using CEST time zone:
An zona: ['CEST'].
t := An mənbə: ['1981-02-03 04:05:06'].
Çıxış yaz: t, yeni-sətir.

# error if string cannot be parsed
{ An mənbə: ['1900']. } tut: { Heç. }, başlat.
