# a quote that never closes must give an error, not an endless loop
>> yol := ['/tmp/test0821.csv'].
>> file := Fayl yeni: yol.

file yaz: ['a,b\n"1,2\n'].
{
	file ayırıcı: [','] dırnaq: ['"'] sətirlər: { :line
		Çıxış yaz: line, yeni-sətir.
	}.
} tut: { :e Çıxış yaz: e, yeni-sətir. }, başlat.

# a closed quote still works
file yaz: ['a,b\n"1,2",3'].
file ayırıcı: [','] dırnaq: ['"'] sətirlər: { :line
	Çıxış yaz: line, yeni-sətir.
}.
file sil.
