


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Proqram yaddaş-idarəsi: 0.
>> palette := Heç.
>> colors := Heç.

{
palette := Lüğət yeni.
palette 
	qoy: ['#F00'] yerə: ['red'],
	qoy: ['#0F0'] yerə: ['green'],
	qoy: ['#00F'] yerə: ['blue'].
Çıxış yaz: ['number of RGB codes in palette: '] + ( palette say ), yeni-sətir.
Çıxış yaz: ['RGB code of green is: '] + ( palette ? ['green'] ), yeni-sətir.
colors := [''].
( palette hər: { :ad :kod
		colors := colors + ( ad + [':'] + kod ).
} ).
Çıxış yaz: ['All colors in palette: '] + colors, yeni-sətir.
} başlat.
Proqram təmizlə.
usedMemory1 := (Proqram yaddaş ? 0).

{
palette := Lüğət yeni.
palette 
	qoy: ['#F00'] yerə: ['red'],
	qoy: ['#0F0'] yerə: ['green'],
	qoy: ['#00F'] yerə: ['blue'].
Çıxış yaz: ['number of RGB codes in palette: '] + ( palette say ), yeni-sətir.
Çıxış yaz: ['RGB code of green is: '] + ( palette ? ['green'] ), yeni-sətir.
colors := [''].
( palette hər: { :ad :kod
		colors := colors + ( ad + [':'] + kod ).
} ).
Çıxış yaz: ['All colors in palette: '] + colors, yeni-sətir.
} başlat.
Proqram təmizlə.
usedMemory2 := (Proqram yaddaş ? 0).

{
palette := Lüğət yeni.
palette 
	qoy: ['#F00'] yerə: ['red'],
	qoy: ['#0F0'] yerə: ['green'],
	qoy: ['#00F'] yerə: ['blue'].
Çıxış yaz: ['number of RGB codes in palette: '] + ( palette say ), yeni-sətir.
Çıxış yaz: ['RGB code of green is: '] + ( palette ? ['green'] ), yeni-sətir.
colors := [''].
( palette hər: { :ad :kod
		colors := colors + ( ad + [':'] + kod ).
} ).
Çıxış yaz: ['All colors in palette: '] + colors, yeni-sətir.
} başlat.
Proqram təmizlə.
usedMemory3 := (Proqram yaddaş ? 0).



( usedMemory1 = usedMemory2 və: usedMemory1 = usedMemory3, və: usedMemory2 = usedMemory3 ) doğru: {
	Çıxış yaz: ['No memory leaks here'].
}, yalan: {
	Çıxış yaz: ['Leaking memory...'].
}.
