Çıxış yaz: ['Test object'], yeni-sətir.
>> a := Obyekt yeni. 
a olanda: ['item:'] et: { :lst
	öz lst := lst. 
}.
a olanda: ['item'] et: { <- öz lst.
}.
a item: (
	Siyahı yeni ; 1 ; (
		Siyahı yeni ; ['a'] ; (
			Siyahı yeni ; ( An yeni: 1 )
		) ; ( Int64 mətndən: ['321'] )
	)
).
Çıxış yaz: a item, yeni-sətir.
>> old-lst-address := a item prototip yaddaş-ünvanı.
a save-as: ['/tmp/a.bin'].
Çıxış yaz: ['========== RELOADING SNAP:'], yeni-sətir.
>> b := Obyekt load-from: ['/tmp/a.bin'].
(b item prototip yaddaş-ünvanı = old-lst-address) doğru: {
	Çıxış yaz: ['Object link re-attached.'], yeni-sətir.
}.
Çıxış yaz: ( b item ), yeni-sətir.
