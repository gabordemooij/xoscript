

>> Matryoshka := Obyekt yeni.
Matryoshka olanda: ['double:'] et: { :secret
	öz secret := secret × 2.
}.
Matryoshka olanda: ['yeni:'] et: { :secret
	>> answer := Heç.
	>> t := (secret > 255).
	Çıxış yaz: (secret + [' | '] + t), yeni-sətir.
	t doğru: {
		answer := secret.
	}, əks-halda: {
		answer := Matryoshka rekursiv yeni: (özü double: secret).
	}. <- answer.
}.

>> x := Matryoshka yeni: 2.
