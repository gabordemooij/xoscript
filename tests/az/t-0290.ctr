# test list operations


>> cakes := Siyahı ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes əvəzlə: 1 uzunluq: 2 ilə: ( Siyahı ← ['cinnamon'] ; ['pineapple'] ).
Çıxış yaz: (buy birləşdir: [',']), yeni-sətir.


>> buy := cakes əvəzlə: 1 uzunluq: 12 ilə: ( Siyahı ← ['cinnamon'] ; ['pineapple'] ).
Çıxış yaz: (buy birləşdir: [',']), yeni-sətir.


>> buy := cakes əvəzlə: 2 uzunluq: 10 ilə: ( Siyahı yeni ).
Çıxış yaz: (buy birləşdir: [',']), yeni-sətir.


>> buy := cakes əvəzlə: 0 uzunluq: 1 ilə: ( Siyahı yeni ).
Çıxış yaz: (buy birləşdir: [',']), yeni-sətir.


>> buy := cakes əvəzlə: ['0'] uzunluq: ['1'] ilə: ['x'].
Çıxış yaz: (buy birləşdir: [',']), yeni-sətir.
