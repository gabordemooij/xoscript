>> z := Obyekt yeni.
z olanda: ['value:'] et: { :v
	öz value := v. <- özü.
}.
z olanda: ['value'] et: { <- öz value. }.
(z setValue: 1) value: 2.
Çıxış yaz: z value.
>> x := z.
Çıxış yaz: x value.
z := Heç.
Çıxış yaz: z value.
Çıxış yaz: x value.
Çıxış yaz: ['hello'].
Çıxış yaz: 3 + 2.
Çıxış yaz: (3 > 2).
