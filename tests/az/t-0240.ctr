# test qualifiers

>> $ := Obyekt yeni.

$ olanda: ['cavab-ver:'] et: { :x
	
	>> operation := x simvol: 0.
	>> valuta := x simvol: 1.
	>> money := x sürüşmə: 2.
	
	>> amount := 0.

	( operation = ['+'] ) doğru: {
		( valuta = ['£'] ) doğru: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Çıxış yaz: x, yeni-sətir.


>> Fruit := Obyekt yeni.

Fruit olanda: ['yeni'] et: {
	>> f := özü yeni.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit olanda: ['apples:'] et: { :a öz apples := a. }.
Fruit olanda: ['oranges:'] et: { :p öz oranges := p. }.
Fruit olanda: ['apples'] et: { <- öz apples. }.
Fruit olanda: ['oranges'] et: { <- öz oranges. }.

Fruit olanda: ['+'] et: { :f
	
	>> n := Fruit yeni.
	f əlavə-et: 1.
	
	n apples: (f apples + öz apples).
	n oranges:  (f oranges  + öz oranges). <- n.
}.

Fruit olanda: ['mətn'] et: { <- ( öz apples mətn + [' apples and '] + öz oranges + [' oranges'] ).
}.

Ədəd olanda: ['apples'] et: { <- ((Fruit yeni) apples: özü).
}.

Ədəd olanda: ['apple'] et: { <- ((Fruit yeni) apples: özü).
}.

Ədəd olanda: ['oranges'] et: { <- ((Fruit yeni) oranges: özü).
}.




Çıxış yaz: (1 apple + 3 oranges + 4 apples), yeni-sətir.


Mətn olanda: ['twice'] et: { <- ((özü mətn) + (özü mətn)).
}.



Çıxış yaz: ['❤❤❤'] twice.



