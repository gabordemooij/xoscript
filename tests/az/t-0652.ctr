# test number -> string -> number
{

	>> x := Ədəd arasında: 0 və: 1000000.
	>> d := Ədəd arasında: 1 və: 7.
	>> e := 10 qüvvət: d.

	x böl-ədədə: e.
	>> y := x mətn ədəd.

	(x = y) yalan: {
		Çıxış yaz: x, yeni-sətir.
		Çıxış yaz: y, yeni-sətir.
		Proqram son.
	}.

} * 1000.
Çıxış yaz: ['OK'], yeni-sətir.