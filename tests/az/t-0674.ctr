# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> yol := ['/tmp/dat.csv'].
>> csv := Fayl yeni: yol.
csv yaz: s.

# accepts CRLF LF CR, varying row length
csv ayırıcı: [';'] dırnaq: ['"'] sətirlər: { :line
	Proqram təmizlə.
	Çıxış yaz: line, yeni-sətir.
	Proqram təmizlə.
}.

# unequal lines
s sona-əlavə-et: ['\njustone'].
csv yaz: s.
{
	csv ayırıcı: [';'] dırnaq: ['"'] sətirlər: { :line
		Çıxış yaz: line, yeni-sətir.
	}.
} tut: { :e 
	Çıxış yaz: e, yeni-sətir.
}, başlat.

# invalid format
s := ['"he"llo";world'].
csv yaz: s.
{
	csv ayırıcı: [';'] dırnaq: ['"'] sətirlər: { :line
		Çıxış yaz: line, yeni-sətir.
	}.
} tut: { :e 
	Çıxış yaz: e, yeni-sətir.
}, başlat.
