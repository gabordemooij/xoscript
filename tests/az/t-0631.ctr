#ffi test


Server init.

Proqram yaddaş-idarəsi: 4.

# for this test you need set a path to libc (puts)
>> libname := Proqram parametr: ['FFITESTLIB'].



Server bağla: (
 Siyahı yeni ;
 libname ;
 ['puts'] ;
 ( Siyahı yeni ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s azad-et.

# test with struct

>> a := Blob yeni: 8.
a bytes: (
	Siyahı <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Siyahı <<: ['int'], ; ['int']).

Server bağla: (
	Siyahı <<: ['@structtest'], ;
	['@structtest'] ;
	(Siyahı <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Çıxış yaz: ['Sum test:'] + (ffitest ffisum: a), yeni-sətir.

struct struct-azad-et.
struct azad-et.
a azad-et.
