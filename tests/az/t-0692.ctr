Server init.

Çıxış yaz: (
	Şablon yeni: ['^\\w+$'],
	uyğunluq: ['test@example.com'] 
), yeni-sətir. # 0 match, fails on @ and .

Çıxış yaz: (
	Şablon yeni: ['^[^@]+@[^\.]+\.\\w+$'],
	uyğunluq: ['test@example.com'] 
), yeni-sətir. # 1 match

Çıxış yaz: (
	Şablon yeni: ['[^@]+@[^\.]+\.\\w+'],
	uyğunluq: ['test@example.com'] 
), yeni-sətir. # 1 match

Çıxış yaz: (
	Şablon yeni: ['([^@]+)@([^\.]+)\.\\w+'],
	uyğunluq: ['test@example.com'] 
), yeni-sətir. # 1 match, groups dont matter

Çıxış yaz: (
	Şablon yeni: ['[a-z]'],
	uyğunluq: ['test@example.com'] 
), yeni-sətir. # 14 matches

Çıxış yaz: (
	Şablon yeni: ['.*'],
	uyğunluq: ['test@example.com'] 
), yeni-sətir. # 1 match (all)

Çıxış yaz: (
	Şablon yeni: ['(.*)'],
	uyğunluq: ['test@example.com'] 
), yeni-sətir. # 1 match (all)

Çıxış yaz: (
	Şablon yeni: ['\\s*[^@]+@[^\.]+\.\\w+'],
	uyğunluq: ['test@example.com'] 
), yeni-sətir. # 1 match, prefix space optional, gets ignored