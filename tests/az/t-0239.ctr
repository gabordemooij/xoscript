Siyahı olanda: ['sum'] et: {
	>> total := 0.
	özü hər: { :index :element
		total əlavə-et: element.
	}. <- total.
}.

>> a := Doğru.



a olanda: ['mətn'] et: {
	>> answer := Heç.
	( özü = Doğru ) doğru: {
		answer := ['Yep'].
	}, əks-halda: {
		answer := ['Nope'].
	}. <- answer.
}.

a olanda: ['ədəd'] et: {
	>> answer := Heç.
	( özü = Doğru ) doğru: {
		answer := 10.
	}, əks-halda: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b olanda: ['mətn'] et: { <- ['Devil'].
}.

b olanda: ['məntiqi'] et: { <- Yalan.
}.


Çıxış yaz: a, yeni-sətir.  
Çıxış yaz: (90 + a), yeni-sətir. 
Çıxış yaz: b, yeni-sətir. 
Çıxış yaz: (Doğru və: b), yeni-sətir.

a := Siyahı ← ['hello'] ; ['world'] ; Doğru ; Heç ; 666. 
a := a + ( Siyahı ← 1 ).
Çıxış yaz: a, yeni-sətir.
Çıxış yaz: ((Lüğət yeni) qoy: Heç yerə: Heç), yeni-sətir.
Çıxış yaz: a sum, yeni-sətir. 


{
	a olanda: ['mətn'] et: { <- Heç. }.
	a := [''] + a.
} tut: { :error
	Çıxış yaz: ['Error noted: '] + error, yeni-sətir.
}, başlat.



