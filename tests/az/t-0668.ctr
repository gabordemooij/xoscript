# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob yeni: 8, bytes: (
	Siyahı yeni ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Çıxış yaz: ( utf16 dekodla: ['utf16le'] ), yeni-sətir.

utf16 azad-et.
>> utf32 := Blob yeni: 13, bytes: (
	Siyahı yeni ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Çıxış yaz: ( utf32 dekodla: ['utf32be'] ), yeni-sətir.
utf32 azad-et.