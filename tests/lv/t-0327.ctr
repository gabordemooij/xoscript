

Saraksts kad: ['fixture:'] darīt: { :f
	savs fixture := f.
}.

Saraksts kad: ['skaits'] darīt: { <- savs fixture.
}.

Saraksts kad: ['aantal'] darīt: { <- savs fixture.
}.


>> x := Nekas.
{

	x := ['hello'] 
	aizstāt:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] rakstzīme: 2)
			)
		)
	ar: (
		(['...hal'] + ['lo']) 
			lielie-burti 
			lowecase 
			lielie-burti 
			nobīde: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Saraksts ← 0 ; 1 ; 4; 9 ; (Saraksts ← 0 ; 3; 1) ; 4
							) priekšpēdējais
						) ? 1
					) + 
					((Saraksts ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					skaits
				)
			)
	).

} × 10.
Izvade rakstīt: x, jauna-rinda.

