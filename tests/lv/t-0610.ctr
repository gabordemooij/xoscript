
>> Rectangle := Objekts jauns.

Rectangle kad: ['area'] darīt: { <- savs garums * savs width.
}.

Rectangle kad: ['length:'] darīt: { :garums
	savs garums := garums.
}.

Rectangle kad: ['width:'] darīt: { :width
	savs width := width.
}.

Rectangle kad: ['jauns'] darīt: {
	# this will not result into an infinite loop
	>> rectangle := pats jauns.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle jauns.
Izvade rakstīt: a area, jauna-rinda. #0

>> b := Rectangle jauns length: 2, width: 3.
Izvade rakstīt: b area, jauna-rinda. #6

