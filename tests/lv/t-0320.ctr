


>> CoffeeMachine := Objekts jauns.
CoffeeMachine kad: ['order:'] darīt: { :id
	>> coffee := ['Americano'].
	( id = 1 ) patiess: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) patiess: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) patiess: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Objekts jauns.
SimpleCoffeeMachine kad: ['order'] darīt: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Izvade rakstīt: redCup, jauna-rinda.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Izvade rakstīt: greenCup, jauna-rinda.
>> yellowCup := CoffeeMachine order: 1.
Izvade rakstīt: yellowCup, jauna-rinda.
>> blueCup := CoffeeMachine order: 0.
Izvade rakstīt: blueCup, jauna-rinda.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Izvade rakstīt: blackCup, jauna-rinda.
blackCup pievienot-beigās: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Izvade rakstīt: orangeCup, jauna-rinda.
