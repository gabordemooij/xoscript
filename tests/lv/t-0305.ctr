
Skaitlis iemācīties: ['plus:'] nozīmē: ['+'].
Skaitlis kad: ['+'] darīt: { :x
	>> rate := 1.
	>> currency := x apzīmējums.
	(currency = ['euros']) patiess: {
		rate := 2.
	}. <- (pats plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars apzīmēt: ['dollars'].
euros apzīmēt: ['euros'].
>> money := dollars + euros.
Izvade rakstīt: money, jauna-rinda.
