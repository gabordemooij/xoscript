# compliance test

# use international numbers

Izvade rakstīt: ['1000 -> '].
Izvade rakstīt: 1000, jauna-rinda. #1000

Izvade rakstīt: ['1.5 -> '].
Izvade rakstīt: 1.5, jauna-rinda.  #1.5

Izvade rakstīt: ['1001.5 -> '].
Izvade rakstīt: 1.5 + 1000, jauna-rinda. #1001.5

# use 0-indexed arrays
>> x := Saraksts jauns ; 1 ; 2 ; 3.
>> y := Saraksts jauns ; ['a'] ; ['b'] ; ['c'].

Izvade rakstīt: ['1 -> '].
Izvade rakstīt: x ? 0, jauna-rinda. #1

Izvade rakstīt: ['1 -> '].
Izvade rakstīt: (x pie: 0), jauna-rinda. #1

Izvade rakstīt: ['1 -> '].
Izvade rakstīt: x pirmais, jauna-rinda. #1

Izvade rakstīt: ['3 -> '].
Izvade rakstīt: x pēdējais, jauna-rinda. #3

Izvade rakstīt: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Izvade rakstīt: (x pēc: y), jauna-rinda.

Izvade rakstīt: ['1 -> '].
Izvade rakstīt: (x no: 0 garums: 1) pirmais, jauna-rinda. #1

Izvade rakstīt: ['0 -> '].
Izvade rakstīt: (x atrast: 1), jauna-rinda. #0

x ielikt: 9 pie: 0.

Izvade rakstīt: ['9 -> '].
Izvade rakstīt: (x pie: 0), jauna-rinda. #9

x pievienot-sākumā: 8.
Izvade rakstīt: ['8 -> '].
Izvade rakstīt: (x pie: 0), jauna-rinda. #9


x pievienot-beigās: 10.
Izvade rakstīt: ['10 -> '].
Izvade rakstīt: (x pie: 4), jauna-rinda. #10








