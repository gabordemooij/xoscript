#Linux

 >> t := Brīdis jauns.
 
t zona: ['Europe/Amsterdam'].
t gads: 2020, mēnesis: 8, diena: 2, stunda: 21, minūte: 2, sekunde: 1.

>> a := t stunda.
>> ams := t zona.

t zona: ['US/Hawaii'].
>> b := t stunda.
>> hw := t zona.

Izvade
rakstīt: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		vai: ['later'] vai: ['earlier']
	)
),
jauna-rinda.
 