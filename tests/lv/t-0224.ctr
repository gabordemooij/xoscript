
>> countries := Saraksts jauns
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Saraksts jauns
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods pēc: countries, katrs: { :key :value
	counter pieskaitīt: 1.
}.

Izvade rakstīt: (['we serve counter dishes'] counter: counter), jauna-rinda.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] rakstzīmes kārtot: { :v
	counter pieskaitīt: 0.
}.

Izvade rakstīt: (['we sort counter dishes'] counter: counter), jauna-rinda.


>> counter := 0.
{
	{
		counter pieskaitīt: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Izvade rakstīt: (['we calculate counter numbers.'] counter: counter), jauna-rinda.

