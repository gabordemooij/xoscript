


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programma atmiņas-pārvaldība: 0.
>> palette := Nekas.
>> colors := Nekas.

{
palette := Vārdnīca jauns.
palette 
	ielikt: ['#F00'] pie: ['red'],
	ielikt: ['#0F0'] pie: ['green'],
	ielikt: ['#00F'] pie: ['blue'].
Izvade rakstīt: ['number of RGB codes in palette: '] + ( palette skaits ), jauna-rinda.
Izvade rakstīt: ['RGB code of green is: '] + ( palette ? ['green'] ), jauna-rinda.
colors := [''].
( palette katrs: { :nosaukums :kods
		colors := colors + ( nosaukums + [':'] + kods ).
} ).
Izvade rakstīt: ['All colors in palette: '] + colors, jauna-rinda.
} palaist.
Programma satīrīt.
usedMemory1 := (Programma atmiņa ? 0).

{
palette := Vārdnīca jauns.
palette 
	ielikt: ['#F00'] pie: ['red'],
	ielikt: ['#0F0'] pie: ['green'],
	ielikt: ['#00F'] pie: ['blue'].
Izvade rakstīt: ['number of RGB codes in palette: '] + ( palette skaits ), jauna-rinda.
Izvade rakstīt: ['RGB code of green is: '] + ( palette ? ['green'] ), jauna-rinda.
colors := [''].
( palette katrs: { :nosaukums :kods
		colors := colors + ( nosaukums + [':'] + kods ).
} ).
Izvade rakstīt: ['All colors in palette: '] + colors, jauna-rinda.
} palaist.
Programma satīrīt.
usedMemory2 := (Programma atmiņa ? 0).

{
palette := Vārdnīca jauns.
palette 
	ielikt: ['#F00'] pie: ['red'],
	ielikt: ['#0F0'] pie: ['green'],
	ielikt: ['#00F'] pie: ['blue'].
Izvade rakstīt: ['number of RGB codes in palette: '] + ( palette skaits ), jauna-rinda.
Izvade rakstīt: ['RGB code of green is: '] + ( palette ? ['green'] ), jauna-rinda.
colors := [''].
( palette katrs: { :nosaukums :kods
		colors := colors + ( nosaukums + [':'] + kods ).
} ).
Izvade rakstīt: ['All colors in palette: '] + colors, jauna-rinda.
} palaist.
Programma satīrīt.
usedMemory3 := (Programma atmiņa ? 0).



( usedMemory1 = usedMemory2 un: usedMemory1 = usedMemory3, un: usedMemory2 = usedMemory3 ) patiess: {
	Izvade rakstīt: ['No memory leaks here'].
}, aplams: {
	Izvade rakstīt: ['Leaking memory...'].
}.
