Izvade rakstīt: ['Test object'], jauna-rinda.
>> a := Objekts jauns. 

a kad: ['item:'] darīt: { :out
	savs out := out. 
}.

a kad: ['item'] darīt: { <- savs out.
}.

a kad: ['greet'] darīt: {
	Izvade rakstīt: ['hi from original out!'], jauna-rinda.
}.

a item: Izvade.

Izvade rakstīt: a item, jauna-rinda.

>> old-out-address := a item prototips atmiņas-adrese.
a save-as: ['/tmp/a.bin'].
Izvade rakstīt: ['========== RELOADING SNAP:'], jauna-rinda.

>> b := Objekts load-from: ['/tmp/a.bin'].

(b item prototips atmiņas-adrese = old-out-address) patiess: {
	Izvade rakstīt: ['Object link re-attached.'], jauna-rinda.
}.

b item rakstīt: ['hello from loaded out!'], jauna-rinda.
b greet.
