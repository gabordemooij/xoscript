#OBSD
>> dirname := [''].
{ dirname pievienot-beigās: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Programma sistēma: command.
Programma chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename pievienot-beigās: ['YYYYYYYY']. } * 20.
Fails jauns: filename, rakstīt: ['sometext'].
{ Fails saraksts: ['/tmp/'] + dirname. } * 1000.
Izvade rakstīt: ['no crash'], jauna-rinda.

