



>> CoffeeGrounds := Objekts jauns.
CoffeeGrounds kad: ['extract'] darīt: { <- ['coffee']. }.

>> CoffeeMachine := Objekts jauns.
CoffeeMachine kad: ['init'] darīt: {
	savs coffeegrounds := CoffeeGrounds jauns.
}.
CoffeeMachine kad: ['jauns'] darīt: { <- CoffeeMachine `new init.
}.

CoffeeMachine kad: ['makeTea'] darīt: { <- (savs tealeaves extract). }.
CoffeeMachine kad: ['makeCoffee'] darīt: { <- (savs coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine jauns.

Izvade rakstīt:
	coffeeDream 
	makeCoffee.

Izvade rakstīt:
	coffeeDream 
	makeTea.
