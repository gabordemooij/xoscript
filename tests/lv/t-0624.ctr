# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := Objekts jauns.

Log kad: ['say:'] darīt: { :str
	Izvade rakstīt: str, jauna-rinda.
}.

>> Item := Objekts jauns.

Item kad: ['jauns:'] darīt: { :id <- pats jauns id: id.
}.

Item kad: ['id:'] darīt: { :id
	savs id := id.
}.

Item kad: ['id'] darīt: { <- savs id. }.


Item kad: ['teksts'] darīt: {
	>> str := ['Item#~no'].
	str ~no: savs id. <- str.
}.


>> Print := Objekts jauns.

Print kad: ['items'] darīt: { 
	
	savs item := Item jauns: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: savs item
	).
	
	
}.

Print items.