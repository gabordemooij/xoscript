# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Seifs ģenerēt-atslēgas.

# private (secret) key
>> sk := keys pirmais.

# public key
>> pk := keys pēdējais.

# sign a message
>> sig := Seifs parakstīt: ['abc'] ar: sk.

# check message (ok)
Izvade rakstīt: ( 
	Seifs
		pārbaudīt: ['abc'] 
		paraksts: sig 
		ar: pk 
), jauna-rinda.

# check message (fail)
Izvade rakstīt: ( 
	Seifs 
		pārbaudīt: ['abd'] 
		paraksts: sig 
		ar: pk 
), jauna-rinda.