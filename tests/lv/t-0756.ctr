Izvade rakstīt: ['Test object'], jauna-rinda.
>> greeter := Objekts jauns.
greeter kad: ['name:'] darīt: { :nosaukums
	savs xname := nosaukums. 
}.
greeter kad: ['greet'] darīt: {
	Izvade rakstīt: ['Hello '] + savs xname, jauna-rinda.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Izvade rakstīt: ['========== RELOADING SNAP:'], jauna-rinda.
>> b := Objekts load-from: ['/tmp/a.bin'].
>> c := Objekts load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
