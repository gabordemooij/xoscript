

Teksts kad: ['html'] darīt: { <- (
		pats
		aizstāt: ['&'] ar: ['&amp;'],
		aizstāt: ['<'] ar: ['&lt;'],
		aizstāt: ['>'] ar: ['&gt;'],
		aizstāt: ['"'] ar: ['&quot;']
	).
}.


Izvade rakstīt: ([' left trimmed '] apgriezt) + [' '] + ( ['and right trimmed'] apgriezt) + ['!'], jauna-rinda.
Izvade rakstīt: ['<html>"html & entities"</html>'] html.
