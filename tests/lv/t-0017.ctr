Skaitlis kad: ['factorial'] darīt: {
	>> total := 1.
	{ :index total reizināt-ar: (pats - (index)). } × pats. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Izvade rakstīt: a.
>> b := 2 + 3 factorial.
Izvade rakstīt: b.
>> c := 3 factorial + 2.
Izvade rakstīt: c.
>> d := 2 + (3 factorial).
Izvade rakstīt: d.
Izvade rakstīt: 2 + 3 factorial + 1.
