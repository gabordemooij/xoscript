>> makeAdder := { :x
	>> f := { :y <- (savs x + y). } iestatīt: ['x'] vērtība: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i savs q ielikt: (savs f lietot: (savs q ? i)) pie: i. } 
	iestatīt: ['q'] vērtība: array,
	iestatīt: ['f'] vērtība: func.
	{ :i mapping lietot: i. } × (array skaits).
}.

>> a := Saraksts ← 1; 2; 3.
mapper lietot: a un: (makeAdder lietot: 100).
Izvade rakstīt: (a pozīcija: 0), jauna-rinda.
Izvade rakstīt: (a ? 1), jauna-rinda.
Izvade rakstīt: (a ? 2), jauna-rinda.
