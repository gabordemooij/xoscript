['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Izvade rakstīt: (x + y), jauna-rinda.

>> x := 10040.07.
>> y := 10305.60.

Izvade rakstīt: (x + y), jauna-rinda.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Izvade rakstīt: (x + y + z), jauna-rinda.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Izvade rakstīt: (x + y + z), jauna-rinda.

>> q := 0.1.2.

Izvade rakstīt: (q), jauna-rinda.

>> q := 012.

Izvade rakstīt: (q), jauna-rinda.
