Teksts kad: ['evaluate'] darīt: {
	>> kods := Fails jauns: ['/tmp/eval.ctr'].
	kods rakstīt: (pats teksts + ['.']).
	Programma izmantot: ['/tmp/eval.ctr'].
}.

>> a := Saraksts ← 1 ; 2 ; 3.
>> b := (a teksts).

Izvade rakstīt: b, jauna-rinda. 
(['b := '] + b) evaluate.

Izvade rakstīt: b ? 2, jauna-rinda. 

Izvade rakstīt: (( Saraksts ← 1 ; 2 ; 3 )), jauna-rinda. 

Izvade rakstīt: ((Vārdnīca jauns) ielikt: 1 pie: 2), jauna-rinda. 

>> x := ( (Saraksts ← 1 ; ( Saraksts ← 9 ) ; Patiess ) ) teksts.
Izvade rakstīt: x, jauna-rinda. 
(['x := '] + x) evaluate.

Izvade rakstīt: x ? 1 ? 0, jauna-rinda. 

>> y := (Vārdnīca jauns) ielikt: (Saraksts ← 1) pie: (Saraksts ← 2).
Izvade rakstīt: y, jauna-rinda. 

(['y := '] + y) teksts evaluate.

Izvade rakstīt: (y pie: (Saraksts ← 2) teksts ), jauna-rinda.

Izvade rakstīt: (Saraksts jauns), jauna-rinda. 
Izvade rakstīt: (Vārdnīca jauns), jauna-rinda. 
