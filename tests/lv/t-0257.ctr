
>> Greeter := Objekts jauns.
Greeter kad: ['jauns'] darīt: {
	savs nosaukums := ['?'].
}.
Greeter kad: ['name:'] darīt: { :nosaukums
	savs nosaukums := nosaukums.
}.
Greeter kad: ['greet'] darīt: {
	Izvade rakstīt: (['hello[you]'] [you]: savs nosaukums).
}.
>> friend := Greeter jauns.
friend name: ['1'].
friend greet.
