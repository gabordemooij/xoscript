
>> a := Saraksts ← (Saraksts ← 100 ; 200 ; 300) ; (Saraksts ← 9 ; 8 ; 7).
Izvade rakstīt: ['at 0,1 :'].
Izvade rakstīt: a ? 0 ? 1, jauna-rinda. 
Izvade rakstīt: ['at 1,2 :'].
Izvade rakstīt: a ? 1 ? 2, jauna-rinda. 
>> menu := Vārdnīca jauns.
menu ielikt: (Saraksts ← ['pizza'] ; ['spaghetti']) pie: ['Italian Cuisine'].
menu ielikt: (Saraksts ← ['bifteki'] ; ['suflaki']) pie: ['Greek Cuisine'].
Izvade rakstīt: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), jauna-rinda. 
Izvade rakstīt: ['but not on the same plate.'], jauna-rinda.
