Programma atmiņas-pārvaldība: 4.

>> Doubler := Objekts jauns.
>> Multiplier := Objekts jauns.
Doubler kad: ['double:and:'] darīt: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier kad: ['multiply:and:'] darīt: { :x :y <- (x × y).
}.

Izvade rakstīt: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), jauna-rinda.
