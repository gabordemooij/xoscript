# Test utf8 sanitizer
Server init.

>> utf8cases := Vārdnīca jauns
	# ASCII only
	ielikt: ( Saraksts jauns ; 65 ; 65 ; 65 ; 65 ; 0 ) pie: ['AAAA'],
	# valid 2 byte sequence
	ielikt: ( Saraksts jauns ; 194 ; 162 ; 0 ) pie: ['¢'],
	# Valid 3-byte UTF-8
    ielikt: ( Saraksts jauns ; 226 ; 130 ; 172 ; 0 ) pie: ['€'],
	# Valid 4-byte UTF-8
    ielikt: ( Saraksts jauns ; 240 ; 144 ; 141 ; 136 ; 0 ) pie: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    ielikt: ( Saraksts jauns ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) pie: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    ielikt: ( Saraksts jauns ; 65 ; 193 ; 129 ; 0 ) pie: ['A?'],
	# Invalid first byte (0xFF)
    ielikt: ( Saraksts jauns ; 255 ; 0 ) pie: ['?'],
	# Incomplete multi-byte sequence at end
    ielikt: ( Saraksts jauns ; 66 ; 226 ; 0 ) pie: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    ielikt: ( Saraksts jauns ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) pie: ['A€?𐍈B'].
	 
utf8cases katrs: { :key :value
	>> blob := Blob jauns: value skaits, bytes: value.
	>> str := blob teksts.
	(str = key) patiess: {
		Izvade rakstīt: ['OK'], jauna-rinda.
	}, citādi: {
		Izvade rakstīt: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, jauna-rinda.
	}.
	blob atbrīvot.
}.
