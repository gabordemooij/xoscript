# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Programma shell-escape: ['abc'].
Izvade rakstīt: c, jauna-rinda.
Izvade rakstīt: ( Programma sistēma: ['echo '] + c ), jauna-rinda.

c := Programma shell-escape: ['a'b'c'].
Izvade rakstīt: c, jauna-rinda.
Izvade rakstīt: ( Programma sistēma: ['echo '] + c ), jauna-rinda.

c := Programma shell-escape: ['a\'c'].
Izvade rakstīt: c, jauna-rinda.
Izvade rakstīt: ( Programma sistēma: ['echo '] + c ), jauna-rinda.