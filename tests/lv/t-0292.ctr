>> winery := { <- (	Vārdnīca jauns
		ielikt: 2 pie: ['merlot'],
		ielikt: 3 pie: ['malbec'],
		ielikt: 4 pie: ['syrah']
	).
}.

Izvade rakstīt: (((winery palaist) - ['nothing']) skaits), jauna-rinda.
Izvade rakstīt: (((winery palaist) - ['merlot']) skaits), jauna-rinda.
Izvade rakstīt: (((winery palaist) - ['malbec']) skaits), jauna-rinda.
Izvade rakstīt: (((winery palaist) - ['syrah']) skaits), jauna-rinda.
Izvade rakstīt: (((winery palaist) - ['merlot'] - ['malbec']) skaits), jauna-rinda.
Izvade rakstīt: (((winery palaist) - ['merlot'] - ['syrah']) skaits), jauna-rinda.
Izvade rakstīt: (((winery palaist) - ['malbec'] -['syrah']) skaits), jauna-rinda.
Izvade rakstīt: (((winery palaist) - ['malbec'] - ['syrah'] - ['merlot']) skaits), jauna-rinda.

