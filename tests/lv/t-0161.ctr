Programma atmiņas-pārvaldība: 0.
Saraksts kad: ['sum'] darīt: {
	>> total := 0.
	pats katrs: { :index :element
		total pieskaitīt: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Fails jauns: ['/tmp/test.txt'].
f rakstīt: ['Lorem Ipsum'].
f aizvērt.
  

f := Fails jauns: ['/tmp/test.txt'].
>> text := f lasīt.
f aizvērt.



Programma satīrīt.
usedMemory1 := (Programma atmiņa ? 1).



f := Fails jauns: ['/tmp/test.txt'].
text := f lasīt.
f aizvērt.

Programma satīrīt.
usedMemory2 := (Programma atmiņa ? 1).


f := Fails jauns: ['/tmp/test.txt'].
text := f lasīt.
f aizvērt.

Programma satīrīt.
usedMemory3 := (Programma atmiņa ? 1).



( usedMemory1 = usedMemory2 un: usedMemory1 = usedMemory3, un: usedMemory2 = usedMemory3 ) patiess: {
	Izvade rakstīt: ['No memory leaks here'].
}, aplams: {
	Izvade rakstīt: ['Leaking memory...'].
}.
