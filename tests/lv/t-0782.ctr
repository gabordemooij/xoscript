Izvade rakstīt: ['Test object'], jauna-rinda.
>> cmd := Komanda jauns.
Izvade rakstīt: cmd ls /tmp, jauna-rinda.
>> old-cmd-address := cmd prototips atmiņas-adrese.
cmd save-as: ['/tmp/a.bin'].
Izvade rakstīt: ['========== RELOADING SNAP:'], jauna-rinda.
>> b := Objekts load-from: ['/tmp/a.bin'].
(b prototips atmiņas-adrese = old-cmd-address) patiess: {
	Izvade rakstīt: ['Object link re-attached.'], jauna-rinda.
}.
Izvade rakstīt: b ls, jauna-rinda.


