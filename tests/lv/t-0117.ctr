>> t := Patiess.
(t = Patiess) patiess: { Izvade rakstīt: ['T']. }.
(t = Aplams) patiess: { Izvade rakstīt: ['F']. }.
Izvade rakstīt: ['|'].
>> t := Aplams.
(t = Patiess) patiess: { Izvade rakstīt: ['T']. }.
(t = Aplams) patiess: { Izvade rakstīt: ['F']. }.
Izvade rakstīt: ['|'].
>> f := Patiess.
(t = Patiess un: f = Aplams) patiess: { Izvade rakstīt: ['T']. }.
(t = Aplams un: f = Patiess) patiess: { Izvade rakstīt: ['F']. }.
Izvade rakstīt: ['|'].
>> n := Nekas.
(n Nekas?) patiess: { Izvade rakstīt: ['T']. }.
(n Nekas?) aplams: { Izvade rakstīt: ['F']. }.
Izvade rakstīt: ['|'].
(f Boolean?) patiess: { Izvade rakstīt: ['T']. }.
(f Boolean?) aplams: { Izvade rakstīt: ['F']. }.



