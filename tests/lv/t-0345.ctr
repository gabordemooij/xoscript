# test catch-all methods
>> x13 := Objekts jauns.
x13 kad: ['a'] darīt: { :a Izvade rakstīt: 0, jauna-rinda. }.
x13 kad: ['a:'] darīt: { :a Izvade rakstīt: a, jauna-rinda. <- 5. }.
x13 kad: ['a:b:'] darīt: { :a :b Izvade rakstīt: (a + b), jauna-rinda. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
