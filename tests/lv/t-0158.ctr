>> x := [' hallo '].

>> y := x lielie-burti.
Izvade rakstīt: x, jauna-rinda.
Izvade rakstīt: (x vienāds: y), jauna-rinda.

>> y := x mazie-burti.
Izvade rakstīt: x, jauna-rinda.
Izvade rakstīt: (x vienāds: y), jauna-rinda.

>> y := x apgriezt.
Izvade rakstīt: x, jauna-rinda.
Izvade rakstīt: (x vienāds: y), jauna-rinda.

>> y := x nobīde: 1.
Izvade rakstīt: x, jauna-rinda.
Izvade rakstīt: (x vienāds: y), jauna-rinda.

>> y := x no: 1 garums: 2.
Izvade rakstīt: x, jauna-rinda.
Izvade rakstīt: (x vienāds: y), jauna-rinda.