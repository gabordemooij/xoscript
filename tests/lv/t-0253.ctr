#Linux
>> OS := Programma iestatījums: ['OS'].

>> clock := Brīdis jauns.
	
(OS = ['Haiku']) patiess: {
	clock zona: ['CET'],
	gads: 2017, mēnesis: 7, diena: 13,
	stunda: 18, minūte: 0, sekunde: 0.
}, citādi: {
	clock zona: ['Europe/Amsterdam'],
	gads: 2017, mēnesis: 7, diena: 13,
	stunda: 18, minūte: 0, sekunde: 0.
}.

clock kad: ['tell'] darīt: {
	Izvade rakstīt: pats, jauna-rinda.
}.


clock pieskaitīt: 2    stunda, tell.
clock pieskaitīt: 1    stunda, tell.
clock pieskaitīt: 19 minūte, tell.
clock pieskaitīt: 1  minūte, tell.
clock pieskaitīt: 1  minūte, tell.
clock pieskaitīt: 19 sekunde, tell.
clock pieskaitīt: 1  sekunde, tell.
clock pieskaitīt: 1  sekunde, tell.
clock pieskaitīt: 2    gads, tell.
clock pieskaitīt: 1    gads, tell.

(OS = ['Haiku']) patiess: {
clock pieskaitīt: 5   mēnesis.
clock zona: ['CEST'], tell.
}, citādi: {
	clock pieskaitīt: 5   mēnesis, tell.
}.

clock pieskaitīt: 1   mēnesis, tell.
clock pieskaitīt: 19    diena, tell.
clock pieskaitīt: 1    stunda, tell.
clock pieskaitīt: 120  yard, tell.
