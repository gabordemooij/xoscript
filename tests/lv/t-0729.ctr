Server init.
>> a := Blob jauns: 4.
a bytes: ( Saraksts jauns ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob jauns: 4.
b bytes: ( Saraksts jauns ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a ^ b.
{
	a ^ ( Fails jauns: ['noblob???'] ).
} tvert: { :e Izvade rakstīt: e, jauna-rinda. }, palaist.
a atbrīvot.
b atbrīvot.
