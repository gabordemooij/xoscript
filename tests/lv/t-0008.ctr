>> Greeter := Objekts jauns.
Greeter kad: ['make'] darīt: {
	>> greeter := Objekts jauns.
	greeter kad: ['name:'] darīt: { :nosaukums
		Izvade rakstīt: ['setting a name'].
		savs myName := nosaukums.
	}.
	greeter kad: ['greet'] darīt: {
		Izvade rakstīt: ['Hello'].
		Izvade rakstīt: savs myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
