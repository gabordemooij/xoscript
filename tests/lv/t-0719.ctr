Server init.
>> fmt := Formāts jauns: ['%#3x'].

>> blob := Blob jauns: 4.
blob bytes: ( 
	Saraksts jauns ; 0 ; 1 ; 2 ; 3
).

>> file := Fails jauns: ['/tmp/blob'].
file blob: blob.
blob atbrīvot.

>> lasīt := file blob.
lasīt 
no: 0 
garums: 4, 
darīt katrs: { :i :b 
	Izvade
	rakstīt: (fmt lietot-veselam: b),
	jauna-rinda.
}.
lasīt atbrīvot.
