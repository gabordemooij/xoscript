Izvade rakstīt: ['Test object'], jauna-rinda.
>> a := Objekts jauns. 

a kad: ['item:'] darīt: { :fmt
	savs fmt := fmt. 
}.

a kad: ['item'] darīt: { <- savs fmt.
}.

a item: ( Formāts jauns: ['|%s|'] ).

Izvade rakstīt: a item, jauna-rinda.

>> old-fmt-address := a item prototips atmiņas-adrese.
a save-as: ['/tmp/a.bin'].
Izvade rakstīt: ['========== RELOADING SNAP:'], jauna-rinda.

>> b := Objekts load-from: ['/tmp/a.bin'].

(b item prototips atmiņas-adrese = old-fmt-address) patiess: {
	Izvade rakstīt: ['Object link re-attached.'], jauna-rinda.
}.

Izvade rakstīt: ( b item lietot: ['hello'] ), jauna-rinda.
