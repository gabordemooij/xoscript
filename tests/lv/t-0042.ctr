>> items := Vārdnīca jauns.
items ielikt: ['black'] pie: ['coffee'], ielikt: ['earl grey'] pie: ['tea'].
Izvade rakstīt: (items pie: ['coffee']), rakstīt: (items pie: ['tea']).
Izvade rakstīt: ['there are'] + items skaits + [' items in the array.'].
items ielikt: ['capuccino'] pie: ['coffee'].
Izvade rakstīt: ['Now my coffee is.. '] + (items pie: ['coffee']).
items ielikt: ['aaa'] pie: ['1'].
items ielikt: ['bbb'] pie: ['2'].
Izvade rakstīt: (items pie: ['a']).
