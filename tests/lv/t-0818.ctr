# edge cases from a request must give an error or a result, not a crash
Server init.

Izvade rakstīt: ['<'] + (['abc'] no: 0 garums: 0, lielie-burti) + ['>'], jauna-rinda.
Izvade rakstīt: ['<'] + (['abc'] no: 0 garums: 0, mazie-burti) + ['>'], jauna-rinda.
Izvade rakstīt: ['<'] + (['abc'] nobīde: 3, lielie-burti) + ['>'], jauna-rinda.
Izvade rakstīt: [''] lielie-burti bytes, jauna-rinda.
Izvade rakstīt: ['aB'] lielie-burti, jauna-rinda.
Izvade rakstīt: ['aB'] mazie-burti, jauna-rinda.

Izvade rakstīt: (Brīdis jauns: 0) gads, jauna-rinda.
{ Brīdis jauns: ['9e300'] skaitlis. } tvert: { :e Izvade rakstīt: e, jauna-rinda. }, palaist.
{ Brīdis jauns: ['-9e300'] skaitlis. } tvert: { :e Izvade rakstīt: e, jauna-rinda. }, palaist.
{ Brīdis jauns: ['nan'] skaitlis. } tvert: { :e Izvade rakstīt: e, jauna-rinda. }, palaist.
{ Brīdis jauns: 9000000000000000000. } tvert: { :e Izvade rakstīt: e, jauna-rinda. }, palaist.
