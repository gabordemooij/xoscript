# test buffers PKI/Sign 
Server init.

>> long := ( Saraksts jauns piepildīt: 1000 ar: ['a'] ) apvienot: [''].

# sign a message
Izvade rakstīt: ( 
	Seifs parakstīt: ['abc'] ar: long
), jauna-rinda.

Izvade rakstīt: ( 
	Seifs
		pārbaudīt: ['abc'] 
		paraksts: long 
		ar: long
), jauna-rinda.

Izvade rakstīt: (
	Seifs paroles-jaucējvērtība: long pārbaudīt: long
), jauna-rinda.
