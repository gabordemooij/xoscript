>> Point := Objekts jauns.
Point kad: ['x-coordinate:'] darīt: { :x savs x := x. }.
Point kad: ['y-coordinate:'] darīt: { :y savs y := y. }.
Point kad: ['x-coordinate']  darīt: { <- savs x kopēt. }.
Point kad: ['y-coordinate']  darīt: { <- savs y kopēt. }.

Point kad: ['='] darīt: { :other <- ( savs x = other x-coordinate
		 un: savs y = other y-coordinate ).
}.

>> pier := Point jauns x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point jauns x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point jauns x-coordinate: 5, y-coordinate: 6.

Izvade rakstīt: pier = town-hall, jauna-rinda.
Izvade rakstīt: pier = restaurant, jauna-rinda.
