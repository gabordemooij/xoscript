>> map1 := Vārdnīca jauns.
>> key1 := Saraksts jauns.
>> key2 := Saraksts jauns.

map1
	ielikt: ['hello'] pie: key1,
	ielikt: ['world'] pie: key2.


Izvade
	rakstīt: ['Map #1 contains: '] + (map1 pie: key1),
	rakstīt: [' and '] + (map1 pie: key2), jauna-rinda.

>> KeyeableArray := Saraksts jauns.
KeyeableArray kad: ['toString'] darīt: { <- (pats skaits) toString.
}.

>> map2 := Vārdnīca jauns.
key1 := KeyeableArray jauns.
key2 := KeyeableArray jauns.

key1 pievienot-beigās: 1.

map2
	ielikt: ['hello'] pie: key1,
	ielikt: ['world'] pie: key2.

Izvade
	rakstīt: ['Map #2 contains: '] + (map2 pie: key1),
	rakstīt: [' and '] + (map2 pie: key2), jauna-rinda.
