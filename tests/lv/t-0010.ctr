>> Animal := Objekts jauns.
Animal kad: ['make'] darīt: {
	>> animal := Objekts jauns.
	animal kad: ['makeSound'] darīt: {
		Izvade rakstīt: savs sound.
	}. <- animal.
}.
>> Cat := Objekts jauns.
Cat kad: ['make'] darīt: {
	>> cat := Animal make.
	cat kad: ['init'] darīt: {
		savs sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
