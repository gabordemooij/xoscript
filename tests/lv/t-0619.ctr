>> HTML := Objekts jauns.
HTML kad: ['atbildēt:'] darīt: { :tag 
	Izvade rakstīt: (['<tag>'] tag: tag), jauna-rinda.
}.
HTML kad: ['atbildēt:un:'] darīt: { :tag :html 
	Izvade rakstīt: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), jauna-rinda.
}.
>> html := HTML jauns.
html body h1: ['header'].

