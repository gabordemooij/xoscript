Izvade rakstīt: ['Test object'], jauna-rinda.
>> a := Objekts jauns. 

a kad: ['item:'] darīt: { :num
	savs num := num. 
}.

a kad: ['item'] darīt: { <- savs num.
}.

a item: 123.

Izvade rakstīt: a item, jauna-rinda.

>> old-num-address := a item prototips atmiņas-adrese.
a save-as: ['/tmp/a.bin'].
Izvade rakstīt: ['========== RELOADING SNAP:'], jauna-rinda.

>> b := Objekts load-from: ['/tmp/a.bin'].

(b item prototips atmiņas-adrese = old-num-address) patiess: {
	Izvade rakstīt: ['Object link re-attached.'], jauna-rinda.
}.

Izvade rakstīt: b item, jauna-rinda.
