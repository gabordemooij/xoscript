
{ :i
	Izvade rakstīt: ['This is step #'] + ( ( i ) + 1 ), jauna-rinda.
} × 6.

{ :i
	Izvade rakstīt: ['This is step #'] + ( 3 - ( i ) ), jauna-rinda.
} × 6.

{ :i
	Izvade rakstīt: ['NEVER!'], jauna-rinda.
} × 0.



{ :i
	Izvade rakstīt: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), jauna-rinda.
} × 11.
