Izvade rakstīt: ['1,2,3,4,5,6,7,8,9,A,'], jauna-rinda.
>> Scope := Objekts jauns.
Scope kad: ['initialize:'] darīt: { :x savs property := x. }.
Scope kad: ['confirm'] darīt: { Izvade rakstīt: [',']. }.
Scope kad: ['tests'] darīt: {
	Izvade rakstīt: savs property.
	pats confirm.
	( 1 = 1 ) patiess: { Izvade rakstīt: savs property. pats confirm. }.
	( 1 = 0 ) aplams: { Izvade rakstīt: savs property. pats confirm. }.
	>> y := 2. { Izvade rakstīt: savs property. pats confirm. } kamēr: { y atņemt: 1. <- (y > 0). }.
	{ Izvade rakstīt: savs property. pats confirm. } × 1.
	(Saraksts ← 1) katrs: {  Izvade rakstīt: savs property. pats confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Vārdnīca jauns one: ['item']) katrs: { Izvade rakstīt: savs property. pats confirm. }.
	{ 1 ÷ 0. } tvert: { Izvade rakstīt: savs property. pats confirm. }, palaist.
	Izvade jauna-rinda.
}.
>> scope1 := Scope jauns.
scope1 initialize: ['X'].
scope1 tests.
>> function := { 
	savs property := ['Y'].
	Izvade rakstīt: savs property.
	pats confirm.
	( 1 = 1 ) patiess: { Izvade rakstīt: savs property. pats confirm. }.
	( 1 = 0 ) aplams: { Izvade rakstīt: savs property. pats confirm. }.
	>> y := 2. { Izvade rakstīt: savs property. pats confirm. } kamēr: { y atņemt: 1. <- (y > 0). }.
	{ Izvade rakstīt: savs property. pats confirm. } × 1.
	(Saraksts ← 1) katrs: {  Izvade rakstīt: savs property. pats confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Vārdnīca jauns one: ['item']) katrs: { Izvade rakstīt: savs property. pats confirm. }.
	{ 1 ÷ 0. } tvert: { Izvade rakstīt: savs property. pats confirm. }, palaist.
	Izvade jauna-rinda.
}.
function kad: ['confirm'] darīt: { Izvade rakstīt: [',']. }.
function lietot: 1 un: 2.
