>> Grandfather := Objekts jauns.
Grandfather kad: ['greet'] darīt: {
	Izvade rakstīt: ['Ave!'], jauna-rinda.
}.
>> Father := Grandfather jauns.
Father kad: ['greet'] darīt: {
	Izvade rakstīt: ['Hello'], jauna-rinda.
	pats greet.
}.
>> Son := Father jauns.
Son kad: ['greet'] darīt: {
	Izvade rakstīt: ['Hi'], jauna-rinda.
	pats greet.
}.

Son greet.

>> Roundabout := Objekts jauns.
Roundabout kad: ['circle:'] darīt: { :x
	Izvade rakstīt: x, jauna-rinda.
	(x < 3) patiess: { pats rekursīvs circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) patiess: { Izvade rakstīt: x, jauna-rinda. x pieskaitīt: 1.  increment palaist. }. }.
increment palaist.