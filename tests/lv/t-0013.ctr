
>> Animal := Objekts jauns.
Animal kad: ['jauns'] darīt: { <- pats jauns init.
}.

Animal kad: ['init'] darīt: {
	savs sound := ['?'].
	savs legs := 4.
}.

>> Dog := Animal jauns.
Dog kad: ['init'] darīt: {
	pats init.
	savs sound := ['barks'].
}.

Animal kad: ['teksts'] darīt: { <- savs legs teksts + savs sound.
}.

>> poodle := Dog jauns.
Izvade rakstīt: poodle, jauna-rinda.

