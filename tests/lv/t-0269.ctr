#Linux

(Fails jauns: ['/tmp/testje']) pastāv aplams: {
	Programma sistēma: ['mkdir /tmp/testje'].	
}.

(Fails jauns: ['/tmp/testje/file1']) pastāv aplams: {
	Programma sistēma: ['touch /tmp/testje/file1'].	
}.

(Fails jauns: ['/tmp/testje/folder1']) pastāv aplams: {
	Programma sistēma: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Fails saraksts: ['/tmp/testje'].

>> q := Saraksts jauns.

l katrs: { :k :v v katrs: { :x :y q pievienot-beigās: y. }. }.

>> s := q teksts.

(s satur: ['file1']) patiess:   { Izvade rakstīt: ['OK'], jauna-rinda. }.
(s satur: ['file2']) patiess:   { Izvade rakstīt: ['XX'], jauna-rinda. }.
(s satur: ['folder1']) patiess: { Izvade rakstīt: ['OK'], jauna-rinda. }.
