#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Šablons jauns: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern atbilstība: subject darīt: { :m :x
	Izvade rakstīt: m, jauna-rinda.
	Izvade rakstīt: x, jauna-rinda. <- ['XXX'].
}.
Izvade rakstīt: result, jauna-rinda.