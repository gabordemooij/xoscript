
Server init.
>> rq := HTTP-Pieprasījums jauns.
Izvade rakstīt: ['HTTP-GET d[]=']  + ( rq get-saraksts: ['d[]'] ), jauna-rinda. # GET
Izvade rakstīt: ['HTTP-GET f[]=']  + ( rq get-saraksts: ['f[]'] ), jauna-rinda. # GET
Izvade rakstīt: ['HTTP-POST e[]='] + ( rq post-saraksts: ['e[]'] ), jauna-rinda. # GET
Izvade rakstīt: ['HTTP-POST c=']   + ( rq post: ['c'] ), jauna-rinda. # GET
Izvade rakstīt: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), jauna-rinda. # GET
