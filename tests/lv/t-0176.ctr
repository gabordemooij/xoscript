

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programma atmiņas-pārvaldība: 0.

>> txt := ['Word Salad'].
Izvade rakstīt: ['Text Length: '] + txt garums, jauna-rinda.
Izvade rakstīt: ['Character at 2:'] + ( txt rakstzīme: 2 ), jauna-rinda.
Izvade rakstīt: (( txt atrast: ['S'] ) - 0), jauna-rinda.

Programma satīrīt.

usedMemory1 := (Programma atmiņa ? 0).


