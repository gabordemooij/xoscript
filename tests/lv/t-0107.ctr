
Izvade rakstīt: ['Break for-loop, 0-4.'], jauna-rinda.
{ :i
	Izvade rakstīt: ['iteration #'] + i, jauna-rinda.
	(i = 4) pārtraukt.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Izvade rakstīt: ['Break while-true loop, 0-4.'], jauna-rinda.
{
	Izvade rakstīt: ['iteration #'] + x, jauna-rinda.
	x pieskaitīt: 1.
	((x < 5) ne) pārtraukt.
} kamēr: xIsLessThan10.

Izvade rakstīt: ['Break while-false loop, 5,4.'], jauna-rinda.
{
	Izvade rakstīt: ['iteration #'] + x, jauna-rinda.
	x atņemt: 1.
	(x = 3) pārtraukt.
} kamēr: { <- (x > 0). }.

Izvade rakstīt: ['Break times loop, 1-4.'], jauna-rinda.
{ :i
	Izvade rakstīt: ['iteration #'] + i, jauna-rinda.
	(i = 4) pārtraukt.
} × 5.

Izvade rakstīt: ['Break block, dont print line.'], jauna-rinda.
{ Patiess pārtraukt. Izvade rakstīt: ['dont write this!'], jauna-rinda. } palaist.

Izvade rakstīt: ['Break block, dont fire catch...'], jauna-rinda.
{ Patiess pārtraukt. Izvade rakstīt: ['dont write this!'], jauna-rinda. } tvert: { Izvade rakstīt: ['Dont catch this!']. }, palaist.

Izvade rakstīt: ['Test Array each-loop: 0,1'], jauna-rinda.
(Saraksts ← 1 ; 2 ; 3) attēlot: { :i
	Izvade rakstīt: ['iteration #'] + i, jauna-rinda.
	(i = 1) pārtraukt.
}.

Izvade rakstīt: ['Test Map each-loop: c only'], jauna-rinda.
>> m := Vārdnīca jauns.
m ielikt: ['first'] pie: ['a'], ielikt: ['second'] pie: ['b'], ielikt: ['third'] pie: ['c'].
m katrs: { :k :v
	Izvade rakstīt: ['iteration'] + v + k, jauna-rinda.
	Patiess pārtraukt.
}.

