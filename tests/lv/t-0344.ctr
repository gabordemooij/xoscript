# catch-all test (practical)
>> HTML := Teksts jauns.
HTML kad: ['encode:'] darīt: { :tekst
	pats pievienot-beigās: (tekst
	aizstāt: ['&'] ar: ['&amp;'], 
	aizstāt: ['<'] ar: ['&lt;'],
	aizstāt: ['>'] ar: ['&gt;'],
	aizstāt: ['"'] ar: ['&quot;']).
}.
>> blog := HTML jauns.
blog pievienot-beigās: ['<h1>'],
     encode: ['Koffie & Thee'],
     pievienot-beigās: ['</h1>'].
Izvade rakstīt: blog, jauna-rinda.


>> Roman := Skaitlis jauns.
Roman kad: ['stringy'] darīt: {
	>> a := [''].
	{ a pievienot-beigās: ['I']. } × pats. <- a.
}.

>> x := Roman jauns.
x pieskaitīt: 3.
Izvade rakstīt: x stringy, jauna-rinda.

>> Quantum := Loģiskais jauns.
Quantum kad: ['true?'] darīt: { <- ['maybe True']. }.
Izvade rakstīt: (Quantum jauns true?), jauna-rinda.

>> Nihil := Nekas jauns.
Nihil kad: ['teksts'] darīt: { <- ['Nihil']. }.
Izvade rakstīt: (Nihil jauns), jauna-rinda.
