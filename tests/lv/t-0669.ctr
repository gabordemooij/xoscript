# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Seifs 
	paroles-jaucējvērtība: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Seifs 
	paroles-jaucējvērtība: hash pārbaudīt: a1.
	# fail 
>> b := Seifs
	paroles-jaucējvērtība: hash pārbaudīt: a2.
	# ok!

Izvade rakstīt: a, jauna-rinda.
Izvade rakstīt: b, jauna-rinda.

