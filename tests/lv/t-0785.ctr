Izvade rakstīt: ['Test object'], jauna-rinda.
>> a := Objekts jauns. 

a kad: ['item:'] darīt: { :moment
	savs moment := moment. 
}.

a kad: ['item'] darīt: { <- savs moment.
}.

>> today := Saraksts jauns ; ( Brīdis jauns zona: ['CEST'], gads: 2026, mēnesis: 7 ).
a item: today.
Izvade rakstīt: a item ? 0, jauna-rinda.
a save-as: ['/tmp/a.bin'].
