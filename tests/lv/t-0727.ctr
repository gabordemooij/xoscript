Server init.
>> f := Formāts jauns: ['%d'].
>> a := Blob jauns: 4.
a bytes: ( Saraksts jauns ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob jauns: 4.
b bytes: ( Saraksts jauns ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a no: 0 garums: 3, katrs: { :i :byte
	Izvade rakstīt: ( f lietot-veselam: byte ), jauna-rinda.
}.
a ^ b.
a no: 0 garums: 3, katrs: { :i :byte
	Izvade rakstīt: ( f lietot-veselam: byte ), jauna-rinda.
}.
a ^ b.
a no: 0 garums: 3, katrs: { :i :byte
	Izvade rakstīt: ( f lietot-veselam: byte ), jauna-rinda.
}.
a atbrīvot.
b atbrīvot.

{ a ^ Objekts. } tvert: { :e Izvade rakstīt: e, jauna-rinda. }, palaist.
