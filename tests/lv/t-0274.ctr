

Saraksts kad: ['column:'] darīt: { :column
	>> result := Saraksts jauns.
	pats katrs: { :index :row
		row katrs: { :index :cell
			(index = column) patiess: { result pievienot-beigās: cell. }.
		}.
	}. <- result.
}.


>> a := Saraksts ←
	(Saraksts ← 1 ; 2 ; 3) ;
	(Saraksts ← 4 ; 5 ; 6) ;
	(Saraksts ← 7 ; 8 ; 9).

>> b := a column: 1.
Izvade rakstīt: b, jauna-rinda.

b := a column: 20.
Izvade rakstīt: b, jauna-rinda.

b := a column: -100.
Izvade rakstīt: b, jauna-rinda.
