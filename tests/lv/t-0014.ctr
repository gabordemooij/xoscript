>> Greeter := Objekts jauns.
Greeter kad: ['make'] darīt: {
	>> gr := Objekts jauns.
	gr kad: ['setName:'] darīt: { :aname
		savs nosaukums := aname.
	}.
	gr kad: ['greet'] darīt: {
		Izvade rakstīt: savs nosaukums.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a jauns.
c setName: ['THREE'].
c greet.
>> d := a jauns.
d setName: ['FOUR'].
d greet.
c greet.
