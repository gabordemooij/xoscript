Server init.

Izvade rakstīt: (
	Šablons jauns: ['^\\w+$'],
	atbilstība: ['test@example.com'] 
), jauna-rinda. # 0 match, fails on @ and .

Izvade rakstīt: (
	Šablons jauns: ['^[^@]+@[^\.]+\.\\w+$'],
	atbilstība: ['test@example.com'] 
), jauna-rinda. # 1 match

Izvade rakstīt: (
	Šablons jauns: ['[^@]+@[^\.]+\.\\w+'],
	atbilstība: ['test@example.com'] 
), jauna-rinda. # 1 match

Izvade rakstīt: (
	Šablons jauns: ['([^@]+)@([^\.]+)\.\\w+'],
	atbilstība: ['test@example.com'] 
), jauna-rinda. # 1 match, groups dont matter

Izvade rakstīt: (
	Šablons jauns: ['[a-z]'],
	atbilstība: ['test@example.com'] 
), jauna-rinda. # 14 matches

Izvade rakstīt: (
	Šablons jauns: ['.*'],
	atbilstība: ['test@example.com'] 
), jauna-rinda. # 1 match (all)

Izvade rakstīt: (
	Šablons jauns: ['(.*)'],
	atbilstība: ['test@example.com'] 
), jauna-rinda. # 1 match (all)

Izvade rakstīt: (
	Šablons jauns: ['\\s*[^@]+@[^\.]+\.\\w+'],
	atbilstība: ['test@example.com'] 
), jauna-rinda. # 1 match, prefix space optional, gets ignored