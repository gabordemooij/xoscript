
Saraksts kad: ['sum'] darīt: {
	>> total := 0.
	pats katrs: { :index :element
		total pieskaitīt: element.
	}. <- total.
}.

>> a := Saraksts ← 9 ; 8 ; 7.
Izvade rakstīt: (a sum), jauna-rinda. 
>> a := Saraksts ← 1 ; 9.
Izvade rakstīt: (a sum), jauna-rinda. 
>> a := Saraksts ← ['o'] ; 2.
Izvade rakstīt: (a sum), jauna-rinda. 
Izvade rakstīt: (Saraksts jauns sum), jauna-rinda. 
