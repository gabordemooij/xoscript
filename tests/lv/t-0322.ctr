

>> Matryoshka := Objekts jauns.
Matryoshka kad: ['double:'] darīt: { :secret
	savs secret := secret × 2.
}.
Matryoshka kad: ['jauns:'] darīt: { :secret
	>> answer := Nekas.
	>> t := (secret > 255).
	Izvade rakstīt: (secret + [' | '] + t), jauna-rinda.
	t patiess: {
		answer := secret.
	}, citādi: {
		answer := Matryoshka rekursīvs jauns: (pats double: secret).
	}. <- answer.
}.

>> x := Matryoshka jauns: 2.
