# recursive interpolation not allowed

Izvade rakstīt: 
['recursive string interolation enabled: '] + (
	Programma iespēja: 
	['RECURSIVE_STRINTPOL']
), jauna-rinda.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Izvade rakstīt: a, jauna-rinda.


Programma iespēja: ['RECURSIVE_STRINTPOL'] ieslēgt: Patiess.

Izvade rakstīt: 
['recursive string interpolation enabled: '] + (
	Programma iespēja: 
	['RECURSIVE_STRINTPOL']
), jauna-rinda.

>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Izvade rakstīt: a, jauna-rinda.

Programma iespēja: ['RECURSIVE_STRINTPOL'] ieslēgt: Aplams.

