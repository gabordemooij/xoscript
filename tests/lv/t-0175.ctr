

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> x := 100.

Programma atmiņas-pārvaldība: 0.

{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt pievienot-beigās: ['!!'].
Izvade rakstīt: txt.
} palaist.

Programma satīrīt.

usedMemory1 := (Programma atmiņa ? 0).


{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt pievienot-beigās: ['!!'].
Izvade rakstīt: txt.
} palaist.

Programma satīrīt.
usedMemory2 := (Programma atmiņa ? 0).


{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt pievienot-beigās: ['!!'].
Izvade rakstīt: txt.
