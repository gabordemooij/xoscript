
>> dictionary := (
	Vārdnīca jauns
		ielikt: ['b'] pie: ['a'],
		ielikt: ['a'] pie: ['b'],
		ielikt: ['z'] pie: ['x'],
		ielikt: ['hello'] pie: ['hallo'],
		ielikt: ['human'] pie: ['human']
).

>> comparisons := Saraksts jauns.
dictionary katrs: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a salīdzināt: b)
	).
}.

comparisons kārtot: { :a :b <- ( a salīdzināt: b ). }.
Izvade rakstīt: ( comparisons apvienot: ['↵'] ), jauna-rinda.
comparisons apvienot: ['↵'].
