Izvade rakstīt: ((Saraksts jauns
	kad: ['plaque:'] darīt: { :x savs o := x. },
	kad: ['plaque']  darīt: { <- savs o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Saraksts ← 1)
	~ (Saraksts ← 1 ; 2)
	~ (Saraksts ← 1 ; 2 ; 3)
	~ (Saraksts ← 1 ; 2 ; 3 ; 4)
	~ (Saraksts ← 1 ; 2 ; 3 ; 4 ; 5)
) katrs: { :i :el
	{ Izvade rakstīt: šis-uzdevums. } × el skaits.
	Izvade jauna-rinda.
}) plaque, jauna-rinda.


