>> invoice := Objekts jauns.
invoice kad: ['palaist'] darīt: {
        savs skaitlis := 0.
}.

invoice kad: ['skaitlis'] darīt: {
        savs skaitlis pieskaitīt: 1. <- savs skaitlis kopēt.
}.

>> year-invoice := invoice jauns.
year-invoice kad: ['start:'] darīt: { :gads
	savs skaitlis := gads.
}.

year-invoice start: 202000.
Izvade rakstīt: year-invoice skaitlis, jauna-rinda.
Izvade rakstīt: year-invoice skaitlis, jauna-rinda.
