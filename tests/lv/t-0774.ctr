Izvade rakstīt: ['Test object'], jauna-rinda.
>> a := Objekts jauns. 
a kad: ['item:'] darīt: { :lst
	savs lst := lst. 
}.
a kad: ['item'] darīt: { <- savs lst.
}.
a item: (
	Saraksts jauns ; 1 ; (
		Saraksts jauns ; ['a'] ; (
			Saraksts jauns ; ( Brīdis jauns: 1 )
		) ; ( Int64 no-teksta: ['321'] )
	)
).
Izvade rakstīt: a item, jauna-rinda.
>> old-lst-address := a item prototips atmiņas-adrese.
a save-as: ['/tmp/a.bin'].
Izvade rakstīt: ['========== RELOADING SNAP:'], jauna-rinda.
>> b := Objekts load-from: ['/tmp/a.bin'].
(b item prototips atmiņas-adrese = old-lst-address) patiess: {
	Izvade rakstīt: ['Object link re-attached.'], jauna-rinda.
}.
Izvade rakstīt: ( b item ), jauna-rinda.
