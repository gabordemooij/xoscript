Izvade rakstīt: ['Test object'], jauna-rinda.
>> a := Objekts jauns. 
a kad: ['item:'] darīt: { :int64
	savs int64 := int64. 
}.
a kad: ['item'] darīt: { <- savs int64.
}.
a item: ( Int64 no-teksta: ['9999'] ).
Izvade rakstīt: a item, jauna-rinda.
>> old-int64-address := a item prototips atmiņas-adrese.
a save-as: ['/tmp/a.bin'].
Izvade rakstīt: ['========== RELOADING SNAP:'], jauna-rinda.
>> b := Objekts load-from: ['/tmp/a.bin'].
(b item prototips atmiņas-adrese = old-int64-address) patiess: {
	Izvade rakstīt: ['Object link re-attached.'], jauna-rinda.
}.
Izvade rakstīt: ( b item ), jauna-rinda.
