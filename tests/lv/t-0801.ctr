Server init.

>> db := Maria-DB jauns resursdators: ['localhost'],
	lietotājs: ['xo'],
	parole: ['pass123'],
	datubāzes-nosaukums: ['xobase'],
	savienot.

>> del := db vaicājums: ['DELETE FROM book WHERE id > 0'].
{  del izpildīt. db apstiprināt. } tvert: { :e db atcelt.  }, palaist.

>> skaits := db vaicājums: ['SELECT COUNT(*) AS num FROM book'].
skaits iegūt: { :row Izvade rakstīt: row num, jauna-rinda. }.
