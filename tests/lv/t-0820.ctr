# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Šablons jauns: pattern.
	p atbilstība: subject darīt: { :m :g
		Izvade rakstīt: g skaits, rakstīt: [' '], rakstīt: (g apvienot: ['|']), jauna-rinda. <- m.
	}.
}.
show lietot: ['(a)|(b)'] un: ['b'].
show lietot: ['(a)|(b)'] un: ['a'].
show lietot: ['(x)?y'] un: ['y'].
show lietot: ['(x)?(y)(z)?'] un: ['xy'].
