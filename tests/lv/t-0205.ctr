>> str := ['write:'].
Izvade ziņojums: ['rakstīt:'] argumenti: (Saraksts ← ['Hello World']), jauna-rinda. 

Skaitlis kad: ['isbetween:and:'] darīt: { :a :b <- ((pats ≥ a) un: (pats ≤ b)).
}.

str := ['isbetween:and:'].
Izvade rakstīt: (3 ziņojums: str argumenti: (Saraksts ← 2 ; 8)), jauna-rinda.
Izvade rakstīt: (3 ziņojums: str argumenti: (Saraksts ← 1 ; 2)), jauna-rinda.


>> CoffeeMachine := Objekts jauns.
CoffeeMachine kad: ['makeCoffeeWithSugar:milk:'] darīt: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Saraksts ← 4 ; 2.
Izvade rakstīt: ( CoffeeMachine ziņojums: order argumenti: coffeeConfiguration ), jauna-rinda.
