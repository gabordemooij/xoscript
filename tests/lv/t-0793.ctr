Server init.

>> DB := Maria-DB jauns resursdators: ['localhost'],
	lietotājs: ['xo'],
	parole: ['pass123'],
	datubāzes-nosaukums: ['xobase'],
	savienot.

{
	DB vaicājums:
	['DROP TABLE movies'],
	izpildīt.
} tvert: { Nekas. }, palaist.

DB vaicājums:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
izpildīt.

DB vaicājums: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parametri: ( Saraksts jauns ; ['Halloween'] ),
izpildīt.

DB vaicājums: ['SELECT * FROM movies'],
iegūt: { :movie
	Izvade rakstīt: movie title, jauna-rinda.
}.

