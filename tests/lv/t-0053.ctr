60 × {
	>> x := (Skaitlis random % 6) + 1.
	(x ≤ 6) aplams: { Izvade rakstīt: ['FAIL']. }.
	(x ≥0) aplams: { Izvade rakstīt: ['FAIL']. }.
	x := (Skaitlis random % 3) + 1.
	(x < 3) aplams: { Izvade rakstīt: ['FAIL']. }.
	(x>-1) aplams: { Izvade rakstīt: ['FAIL']. }.
	x := ((Loģiskais flip) skaitlis).
	(x = 0 vai: x = 1) aplams: { Izvade rakstīt: ['FAIL']. }.
	x := ((Patiess flip) skaitlis).
	(x = 0 vai: x = 1) aplams: { Izvade rakstīt: ['FAIL']. }.
	x := (Loģiskais flip vai: ['HEAD'] vai: ['TAIL']).
	((x = ['HEAD']) vai: (x = ['TAIL'])) aplams: { Izvade rakstīt: ['FAIL']. }.
}.
Izvade rakstīt: ['DONE'].

