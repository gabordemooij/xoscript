# test Program version

# this feature is disabled by default
Izvade rakstīt: (
	Programma iespēja: 
	['RECURSIVE_STRINTPOL']
), jauna-rinda.


# but if we set the time back
>> today := Brīdis 
zona: ['CEST'],
avots: ['2026-02-15 10:00:00'].
Programma versija: today.

# it will be enabled like it used to be (from now on)
Izvade rakstīt: (
	Programma iespēja: 
	['RECURSIVE_STRINTPOL']
), jauna-rinda.