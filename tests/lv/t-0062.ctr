Loģiskais kad: ['xor:'] darīt: { :a :b <- ((a un: b ne) vai: (a ne un: b)).
}.

>> o := Objekts jauns.
o kad: ['hello'] darīt: { ['Empty']. }.
{ o kad: 2 darīt: 3.} tvert: { :e Izvade rakstīt: e, jauna-rinda. }, palaist.
