

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programma atmiņas-pārvaldība: 0.

Skaitlis kad: ['addNum:'] darīt: { :x
	pats pieskaitīt: x.
}.

Skaitlis kad: ['subtractNum:'] darīt: { :x
	pats atņemt: x.
}.

Skaitlis kad: ['multiplyBy:'] darīt: { :x
	pats reizināt-ar: x.
}.

Skaitlis kad: ['divideBy:'] darīt: { :x
	pats dalīt-ar: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 pakāpe: 8).  
a := a + (2 pakāpe: -1). 
a := a + (49 kvadrātsakne).   
a addNum: ((Saraksts ← 0 ; 1) maksimums).          
a addNum: ((Saraksts ← 2 ; 3) minimums).
Izvade rakstīt: a.

Programma satīrīt.

usedMemory1 := (Programma atmiņa ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 pakāpe: 8).  
a := a + (2 pakāpe: -1). 
a := a + (49 kvadrātsakne).   
a addNum: ((Saraksts ← 0 ; 1) maksimums).          
a addNum: ((Saraksts ← 2 ; 3) minimums).
Izvade rakstīt: a.

Programma satīrīt.
usedMemory2 := (Programma atmiņa ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 pakāpe: 8).  
a := a + (2 pakāpe: -1). 
a := a + (49 kvadrātsakne).   
a addNum: ((Saraksts ← 0 ; 1) maksimums).          
a addNum: ((Saraksts ← 2 ; 3) minimums).
Izvade rakstīt: a.

Programma satīrīt.
usedMemory3 := (Programma atmiņa ? 0).



( usedMemory1 = usedMemory2 un: usedMemory1 = usedMemory3, un: usedMemory2 = usedMemory3 ) patiess: {
	Izvade rakstīt: ['No memory leaks here'].
}, aplams: {
	Izvade rakstīt: ['Leaking memory...'].
}.
