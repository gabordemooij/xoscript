Server init.

>> DB := Maria-DB jauns resursdators: ['localhost'],
	lietotājs: ['xo'],
	parole: ['pass123'],
	datubāzes-nosaukums: ['xobase'],
	savienot.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB vaicājums: SQL.

# now you don't have to set DB
query2 iegūt: { :row
	Izvade rakstīt: row world, jauna-rinda.
}.
