Saraksts kad: ['sum'] darīt: {
	>> total := 0.
	pats katrs: { :index :element
		total pieskaitīt: element.
	}. <- total.
}.

>> a := Patiess.



a kad: ['teksts'] darīt: {
	>> answer := Nekas.
	( pats = Patiess ) patiess: {
		answer := ['Yep'].
	}, citādi: {
		answer := ['Nope'].
	}. <- answer.
}.

a kad: ['skaitlis'] darīt: {
	>> answer := Nekas.
	( pats = Patiess ) patiess: {
		answer := 10.
	}, citādi: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b kad: ['teksts'] darīt: { <- ['Devil'].
}.

b kad: ['loģiskais'] darīt: { <- Aplams.
}.


Izvade rakstīt: a, jauna-rinda.  
Izvade rakstīt: (90 + a), jauna-rinda. 
Izvade rakstīt: b, jauna-rinda. 
Izvade rakstīt: (Patiess un: b), jauna-rinda.

a := Saraksts ← ['hello'] ; ['world'] ; Patiess ; Nekas ; 666. 
a := a + ( Saraksts ← 1 ).
Izvade rakstīt: a, jauna-rinda.
Izvade rakstīt: ((Vārdnīca jauns) ielikt: Nekas pie: Nekas), jauna-rinda.
Izvade rakstīt: a sum, jauna-rinda. 


{
	a kad: ['teksts'] darīt: { <- Nekas. }.
	a := [''] + a.
} tvert: { :error
	Izvade rakstīt: ['Error noted: '] + error, jauna-rinda.
}, palaist.



{
	a kad: ['skaitlis'] darīt: { <- Nekas. }.
	a := 3 × a.
} tvert: { :error
	Izvade rakstīt: ['Error noted: '] + error, jauna-rinda.
}, palaist.


{
	a kad: ['loģiskais'] darīt: { <- Nekas. }.
	a := Patiess un: a. 
} tvert: { :error
	Izvade rakstīt: ['Error noted: '] + error, jauna-rinda.
}, palaist.





{
	a kad: ['teksts'] darīt: { <- Aplams. }.
	a := [''] + a.
} tvert: { :error
	Izvade rakstīt: ['Error noted: '] + error, jauna-rinda.
}, palaist.



{
	a kad: ['skaitlis'] darīt: { <- Patiess. }.
	a := 3 × a.
} tvert: { :error
	Izvade rakstīt: ['Error noted: '] + error, jauna-rinda.
}, palaist.


{
	a kad: ['boolean'] darīt: { <- 1. }.
	a := Patiess un: a.
} tvert: { :error
	Izvade rakstīt: ['Error noted: '] + error, jauna-rinda.
}, palaist.





