

Teksts kad: ['evaluate'] darīt: {
	>> kods := Fails jauns: ['/tmp/eval.ctr'].
	kods rakstīt: (pats teksts + ['.']).
	Programma izmantot: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Saraksts ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q teksts.
Izvade rakstīt: x, jauna-rinda.
>> y := Nekas.
(['y := '] + x ) evaluate.
Izvade rakstīt: y ? 0, jauna-rinda.

q := Vārdnīca ielikt: ['\[''] pie: ['\['quote\']'].
x := q teksts.
Izvade rakstīt: x, jauna-rinda.
y := Nekas.
(['y := '] + x ) evaluate.

>> q := (Vārdnīca jauns) ielikt:['\[''] pie:['\['quote\[''].
Izvade rakstīt: y ? ['\['quote\']'], jauna-rinda.
