Izvade rakstīt: ['Test object'], jauna-rinda.
>> a := Objekts jauns. 

a kad: ['item:'] darīt: { :octhelper
	savs octhelper := octhelper. 
}.

a kad: ['item'] darīt: { <- savs octhelper.
}.

a item: Oct jauns.

>> old-octhelper-address := a item prototips atmiņas-adrese.
a save-as: ['/tmp/a.bin'].
Izvade rakstīt: ['========== RELOADING SNAP:'], jauna-rinda.

>> b := Objekts load-from: ['/tmp/a.bin'].

(b item prototips atmiņas-adrese = old-octhelper-address) patiess: {
	Izvade rakstīt: ['Object link re-attached.'], jauna-rinda.
}.
