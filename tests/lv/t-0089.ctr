>> randomizer := { :a :b
	>> minimums := ( a < b ) vai: a vai: b.
	>> maksimums := ( a > b ) vai: a vai: b.
	>> x := Nekas.
	{
		x := Skaitlis starp: a un: b.
		((x < minimums) vai: (x > maksimums)) patiess: { 
			Izvade rakstīt: (['Invalid value!']).
			Programma beigas.
		}.
	} 
	× 100. <- x.
}.
randomizer lietot: 0 un: 0.
randomizer lietot: 1 un: 0.
