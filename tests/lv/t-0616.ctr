Saraksts kad: ['kopēt'] darīt: {
	>> kopēt := Saraksts jauns.
	pats katrs: { :skaitlis :section
		kopēt pievienot-beigās: section rekursīvs kopēt.
	}. <- kopēt.
}.

>> sheep := Saraksts jauns ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep kopēt.
clones katrs: { :skaitlis :sheep
	sheep pievienot-beigās: ['2'].
}.

Izvade rakstīt: sheep, jauna-rinda.
Izvade rakstīt: clones, jauna-rinda.
