>> a := 3.
>> b := a kopēt.
a atņemt: 1.
Izvade rakstīt: [' a = '] + a.
Izvade rakstīt: [' b = '] + b.
a := 3.
b := a + 4.
Izvade rakstīt: [' a = '] + a.
Izvade rakstīt: [' b = '] + b.
>> x := 3.
>> y := x kopēt.
x pieskaitīt: 10.
y atņemt: 1.
Izvade rakstīt: [' x = '] + x.
Izvade rakstīt: [' y = '] + y.
>> q := Objekts jauns.
q kad: ['setProperty:'] darīt: { :x
	savs prop := x.
}.
q kad: ['getProperty'] darīt: { <- savs prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Izvade rakstīt: [' p = '] + (p getProperty).
