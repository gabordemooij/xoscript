#Linux
>> OS := Programma sistēma: (Komanda uname -s), apgriezt.

>> Slurp := Objekts jauns.
Slurp kad: ['jauns'] darīt: {
	savs str := [''].
}.
Slurp kad: ['atbildēt:'] darīt: { :blah
		(savs str ≠ ['']) patiess: {
			savs str pievienot-beigās: [' '].
		}.
		savs str pievienot-beigās: blah.
}.
Slurp kad: ['atbildēt:un:'] darīt: { :blah :blahah
		(savs str ≠ ['']) patiess: {
			savs str pievienot-beigās: [' '].
		}.
		(blah garums > 1) patiess: {
			savs str pievienot-beigās: (blah no: 0 garums: (blah garums - 1)).
		}, citādi: {
			savs str pievienot-beigās: blah.
		}.
		savs str pievienot-beigās: [' '].
		savs str pievienot-beigās: blahah.
}.
Slurp kad: ['obtain'] darīt: {
	>> buffer := savs str.
	savs str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text pievienot-beigās: ['hello'].
} × 1000.


Izvade rakstīt: (
	Programma sistēma: (
		Slurp jauns
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

