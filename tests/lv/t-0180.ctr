Teksts kad: ['html'] darīt: { <- (
		pats
		aizstāt: ['&'] ar: ['&amp;'],
		aizstāt: ['<'] ar: ['&lt;'],
		aizstāt: ['>'] ar: ['&gt;'],
		aizstāt: ['''] ar: ['&apos;'],
		aizstāt: ['"'] ar: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programma atmiņas-pārvaldība: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Izvade rakstīt: txt kopēt html, jauna-rinda.
Izvade rakstīt: txt kopēt mazie-burti, jauna-rinda.
Izvade rakstīt: txt kopēt lielie-burti, jauna-rinda.
} palaist.

Programma satīrīt.

usedMemory1 := (Programma atmiņa ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Izvade rakstīt: txt kopēt html, jauna-rinda.
Izvade rakstīt: txt kopēt mazie-burti, jauna-rinda.
Izvade rakstīt: txt kopēt lielie-burti, jauna-rinda.
} palaist.

Programma satīrīt.
usedMemory2 := (Programma atmiņa ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Izvade rakstīt: txt kopēt html, jauna-rinda.
Izvade rakstīt: txt kopēt mazie-burti, jauna-rinda.
Izvade rakstīt: txt kopēt lielie-burti, jauna-rinda.
} palaist.

Programma satīrīt.
usedMemory3 := (Programma atmiņa ? 0).



( usedMemory1 = usedMemory2 un: usedMemory1 = usedMemory3, un: usedMemory2 = usedMemory3 ) patiess: {
	Izvade rakstīt: ['No memory leaks here'].
}, aplams: {
	Izvade rakstīt: ['Leaking memory...'].
}.
