Server init.

>> DB := Maria-DB jauns resursdators: ['localhost'],
	lietotājs: ['xo'],
	parole: ['pass123'],
	datubāzes-nosaukums: ['xobase'],
	savienot.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> meklēšanas-parametri := Maria-Vaicājums jauns: SQL.

# set database
meklēšanas-parametri datubāze: DB.

meklēšanas-parametri iegūt: { :row
	Izvade rakstīt: row world, jauna-rinda.
}.
