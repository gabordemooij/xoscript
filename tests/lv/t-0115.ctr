{
	šis-uzdevums kļūda: ['Dont fail.'].
	unknown doSomething.
} tvert: {
	Izvade rakstīt: ['Caught!'].
}, palaist.

{
	šis-uzdevums kļūda: ['Dont fail.'].
	savs unknown doSomething.
} tvert: {
	Izvade rakstīt: ['Caught!'].
}, palaist.

{
	šis-uzdevums kļūda: ['Dont fail.'].
	unknown := 122.
} tvert: {
	Izvade rakstīt: ['Caught!'].
}, palaist.


{
	šis-uzdevums kļūda: ['Dont fail.'].
	Patiess pārtraukt.
	Izvade rakstīt: ['FAIL'].
} tvert: {
	Izvade rakstīt: ['Caught!'].
}, palaist.

{
	{
		šis-uzdevums kļūda: ['Dont fail.'].
		Patiess pārtraukt.
		Izvade rakstīt: ['FAIL'].
	} tvert: { :x
		(x = ['Dont fail.']) patiess: { šis-uzdevums kļūda: ['Nested Caught!']. }.
	}, palaist.
} tvert: { :e
	Izvade rakstīt: e.
}, palaist.
