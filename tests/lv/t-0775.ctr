Izvade rakstīt: ['Test object'], jauna-rinda.
>> l := Saraksts jauns ; 1 ; ( Saraksts jauns ; (Brīdis jauns: 1) ; (Int64 no-teksta: ['321']) ; (Saraksts jauns ; 3)).
Izvade rakstīt: l, jauna-rinda.
>> old-lst-address := l prototips atmiņas-adrese.
l save-as: ['/tmp/a.bin'].
Izvade rakstīt: ['========== RELOADING SNAP:'], jauna-rinda.
>> b := Objekts load-from: ['/tmp/a.bin'].
(b prototips atmiņas-adrese = old-lst-address) patiess: {
	Izvade rakstīt: ['Object link re-attached.'], jauna-rinda.
}.
Izvade rakstīt: b, jauna-rinda.
