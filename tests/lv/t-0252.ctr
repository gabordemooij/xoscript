#Linux
>> clock := Brīdis jauns.
clock zona: ['UTC-1'].
clock gads: 1981, mēnesis: 1, diena: 5,
      stunda: 13, minūte: 15, sekunde: 13.

Izvade rakstīt: clock, jauna-rinda.
clock zona: ['UTC+0'].

Izvade rakstīt: (
	(clock gads vienkāršs) + ['-'] + (clock mēnesis) + ['-'] + (clock diena) + [' '] +
	(clock stunda) + [':'] + (clock minūte) + [':'] + (clock sekunde) + [' '] +
	['W'] + (clock nedēļa) + (clock zona)
), jauna-rinda.


clock zona: ['UTC-1'].
Izvade rakstīt: (
	(clock gads vienkāršs) + ['-'] + (clock mēnesis) + ['-'] + (clock diena) + [' '] +
	(clock stunda) + [':'] + (clock minūte) + [':'] + (clock sekunde) + [' '] +
	['W'] + (clock nedēļa) + (clock zona)
), jauna-rinda.
