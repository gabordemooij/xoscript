Server init.
>> a := Blob jauns: 4.
a bytes: ( Saraksts jauns ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob jauns: 4.
b bytes: ( Saraksts jauns ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
# inherited blob does not get the buffer, so it's useless
# it will pass ctr_accept() but since buffer ptr == null, it will retur
>> c := a jauns.
{ 
>> n := a ^ c.
Izvade rakstīt: ['xorred:'], jauna-rinda. 
Izvade rakstīt: n, jauna-rinda. 
} tvert: { :e Izvade rakstīt: e, jauna-rinda. }, palaist.
a atbrīvot.
b atbrīvot.
