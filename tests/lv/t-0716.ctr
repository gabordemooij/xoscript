Izvade rakstīt: ['Test object'], jauna-rinda.
>> a := Objekts jauns. 

a kad: ['state:'] darīt: { :list
	savs list := list. 
}.

a kad: ['state'] darīt: {
	Izvade rakstīt: savs list, jauna-rinda.
}.

a state: ( Saraksts jauns ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
