Skaitlis kad: ['factorial'] darīt: {
	>> total := 1.
	{ :index total reizināt-ar: (pats - (index)). } × pats. <- total.
}.
>> Printer := Objekts jauns.
Printer kad: ['print:and:'] darīt: { :x :y
	Izvade rakstīt: ['a='] + x + [', b='] + y, jauna-rinda.
}.
>> a := 4.5. >> b := a noapaļot-uz-leju.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a noapaļot-uz-augšu.
Printer print: a and: b.
a := 4.5. b := a noapaļot-uz-leju.
Printer print: a and: b.
a := 4.5. b := a noapaļot.
Printer print: a and: b.
a := 4.2. b := a noapaļot.
Printer print: a and: b.

Izvade rakstīt: (9 atlikums: 5), jauna-rinda.
Izvade rakstīt: -666 absolūtā-vērtība, jauna-rinda.
Izvade rakstīt: 49 kvadrātsakne, jauna-rinda.
Izvade rakstīt: (2 pakāpe: 3), jauna-rinda.
>> l := (Saraksts ← 9 ; 6).
Izvade rakstīt: l minimums.

