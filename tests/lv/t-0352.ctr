Skaitlis kad: ['roman'] darīt: {
	>> skaitlis := pats kopēt.
	>> roman := [''].
	{
		{
			(skaitlis ≥ 1000) patiess: {
				roman pievienot-beigās: ['Ⅿ'].
				skaitlis atņemt: 1000.
			}, pārtraukt.
		
			(skaitlis ≥ 500) patiess: {
				roman pievienot-beigās: ['Ⅾ'].
				skaitlis atņemt: 500.
			}, pārtraukt.
		
			(skaitlis ≥ 100) patiess: {
				roman pievienot-beigās: ['Ⅽ'].
				skaitlis atņemt: 100.
			}, pārtraukt.
		
			(skaitlis ≥ 50) patiess: {
				roman pievienot-beigās: ['Ⅼ'].
				skaitlis atņemt: 50.
			}, pārtraukt.
		
			(skaitlis ≥ 50) patiess: {
				roman pievienot-beigās: ['Ⅼ'].
				skaitlis atņemt: 50.
			}, pārtraukt.
		
			(skaitlis ≥ 10) patiess: {
				roman pievienot-beigās: ['Ⅹ'].
				skaitlis atņemt: 10.
			}, pārtraukt.
			
			(skaitlis ≥ 9) patiess: {
				roman pievienot-beigās: ['Ⅸ'].
				skaitlis atņemt: 9.
			}, pārtraukt.
			
			(skaitlis ≥ 5) patiess: {
				roman pievienot-beigās: ['Ⅴ'].
				skaitlis atņemt: 5.
			}, pārtraukt.
			
			(skaitlis ≥ 4) patiess: {
				roman pievienot-beigās: ['Ⅳ'].
				skaitlis atņemt: 4.
			}, pārtraukt.
			
			(skaitlis ≥ 1) patiess: {
				roman pievienot-beigās: ['Ⅰ'].
				skaitlis atņemt: 1.
			}, pārtraukt.
		} procedūra.
	} kamēr: { <- skaitlis > 0. }. <- roman.
}.

Izvade rakstīt: 1 roman, jauna-rinda.
Izvade rakstīt: 2 roman, jauna-rinda.
Izvade rakstīt: 4 roman, jauna-rinda.
Izvade rakstīt: 8 roman, jauna-rinda.
Izvade rakstīt: 16 roman, jauna-rinda.
Izvade rakstīt: 32 roman, jauna-rinda.
Izvade rakstīt: 64 roman, jauna-rinda.
Izvade rakstīt: 128 roman, jauna-rinda.
Izvade rakstīt: 256 roman, jauna-rinda.
Izvade rakstīt: 1024 roman, jauna-rinda.
