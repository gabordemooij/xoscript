Izvade rakstīt: ['Test object'], jauna-rinda.
>> a := Objekts jauns. 

a kad: ['item:'] darīt: { :dict
	savs dict := dict. 
}.

a kad: ['item'] darīt: { <- savs dict.
}.

a item: (
Vārdnīca jauns
	hello: ['world'],
	world: (Vārdnīca jauns ielikt: ['a'] pie: ['b'])).

Izvade rakstīt: a item, jauna-rinda.

>> old-dict-address := a item prototips atmiņas-adrese.
a save-as: ['/tmp/a.bin'].
Izvade rakstīt: ['========== RELOADING SNAP:'], jauna-rinda.

>> b := Objekts load-from: ['/tmp/a.bin'].

(b item prototips atmiņas-adrese = old-dict-address) patiess: {
	Izvade rakstīt: ['Object link re-attached.'], jauna-rinda.
}.

Izvade rakstīt: b item, jauna-rinda.
