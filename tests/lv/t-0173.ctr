

Saraksts kad: ['sum'] darīt: {
	>> total := 0.
	pats katrs: { :index :element
		total pieskaitīt: element.
	}. <- total.
}.

Saraksts kad: ['product'] darīt: {
	>> total := 1.
	pats katrs: { :index :element
		total reizināt-ar: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programma atmiņas-pārvaldība: 0.

{

>> a := Saraksts ← ['hello'] ; ['world'] ; Patiess ; Nekas ; 666.
a := a + ( Saraksts ← 1 ).
Izvade rakstīt: ( ['sum: '] + ( a sum ) ), jauna-rinda.
Izvade rakstīt: ( ['min: '] + ( a minimums ) ), jauna-rinda.
Izvade rakstīt: ( ['max: '] + ( a maksimums ) ), jauna-rinda.
Izvade rakstīt: ( ['3rd: '] + ( a ? 2 ) ), jauna-rinda.
Izvade rakstīt: ( ['prd: '] + ( a product ) ), jauna-rinda.
a kārtot: { :a :b <- (b - a). }.
a katrs: { :i :e Izvade rakstīt: ( i - 0 ), jauna-rinda. }.

} palaist.

Programma satīrīt.
usedMemory1 := (Programma atmiņa ? 0).


{

>> a := Saraksts ← ['hello'] ; ['world'] ; Patiess ; Nekas ; 666.
a := a + ( Saraksts ← 1 ).
Izvade rakstīt: ( ['sum: '] + ( a sum ) ), jauna-rinda.
Izvade rakstīt: ( ['min: '] + ( a minimums ) ), jauna-rinda.
Izvade rakstīt: ( ['max: '] + ( a maksimums ) ), jauna-rinda.
Izvade rakstīt: ( ['3rd: '] + ( a ? 2 ) ), jauna-rinda.
Izvade rakstīt: ( ['prd: '] + ( a product ) ), jauna-rinda.
a kārtot: { :a :b <- (b - a). }.
a katrs: { :i :e Izvade rakstīt: ( i - 0 ), jauna-rinda. }.

} palaist.



Programma satīrīt.
usedMemory2 := (Programma atmiņa ? 0).


{

>> a := Saraksts ← ['hello'] ; ['world'] ; Patiess ; Nekas ; 666.
a := a + ( Saraksts ← 1 ).
Izvade rakstīt: ( ['sum: '] + ( a sum ) ), jauna-rinda.
Izvade rakstīt: ( ['min: '] + ( a minimums ) ), jauna-rinda.
Izvade rakstīt: ( ['max: '] + ( a maksimums ) ), jauna-rinda.
Izvade rakstīt: ( ['3rd: '] + ( a ? 2 ) ), jauna-rinda.
Izvade rakstīt: ( ['prd: '] + ( a product ) ), jauna-rinda.
a kārtot: { :a :b <- (b - a). }.
a katrs: { :i :e Izvade rakstīt: ( i - 0 ), jauna-rinda. }.

} palaist.



Programma satīrīt.
usedMemory3 := (Programma atmiņa ? 0).

( usedMemory1 = usedMemory2 un: usedMemory1 = usedMemory3, un: usedMemory2 = usedMemory3 ) patiess: {
	Izvade rakstīt: ['No memory leaks here'].
}, aplams: {
	Izvade rakstīt: ['Leaking memory...'].
}.
