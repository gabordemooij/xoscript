Izvade rakstīt: ['Test object'], jauna-rinda.
>> a := Objekts jauns. 

a kad: ['item:'] darīt: { :loģiskais
	savs loģiskais := loģiskais. 
}.

a kad: ['item'] darīt: { <- savs loģiskais.
}.

a item: Aplams.

Izvade rakstīt: a item, jauna-rinda.

>> old-bool-address := a item prototips atmiņas-adrese.
a save-as: ['/tmp/a.bin'].
Izvade rakstīt: ['========== RELOADING SNAP:'], jauna-rinda.

>> b := Objekts load-from: ['/tmp/a.bin'].

(b item prototips atmiņas-adrese = old-bool-address) patiess: {
	Izvade rakstīt: ['Object link re-attached.'], jauna-rinda.
}.

Izvade rakstīt: b item, jauna-rinda.
