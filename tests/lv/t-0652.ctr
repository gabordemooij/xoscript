# test number -> string -> number
{

	>> x := Skaitlis starp: 0 un: 1000000.
	>> d := Skaitlis starp: 1 un: 7.
	>> e := 10 pakāpe: d.

	x dalīt-ar: e.
	>> y := x teksts skaitlis.

	(x = y) aplams: {
		Izvade rakstīt: x, jauna-rinda.
		Izvade rakstīt: y, jauna-rinda.
		Programma beigas.
	}.

} * 1000.
Izvade rakstīt: ['OK'], jauna-rinda.