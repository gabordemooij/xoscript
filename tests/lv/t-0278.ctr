>> To-Do := Objekts jauns.

To-Do kad: ['jauns'] darīt: {
	savs list := Saraksts jauns.
}.

To-Do kad: ['nieuw'] darīt: {
	savs list := Saraksts jauns.
}.

To-Do kad: ['+'] darīt: { :task
	savs list pievienot-beigās: task.
}.

To-Do kad: ['number of tasks?'] darīt: { <-  savs list skaits.
}.

>> todos := 
	To-Do jauns 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Izvade rakstīt: ['You have $ tasks to do'] $ todos number of tasks?.
