Skaitlis kad: ['factorial'] darīt: {
	>> total := 1.
	{ :index total reizināt-ar: (pats - index). } × pats. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programma atmiņas-pārvaldība: 0.

{
2 exponent factorial.
Izvade rakstīt: (11 atlikums: 3), jauna-rinda.
Izvade rakstīt: (3.4 noapaļot), jauna-rinda.
Izvade rakstīt: (7.1 noapaļot-uz-augšu), jauna-rinda.
Izvade rakstīt: (7.9 noapaļot-uz-leju), jauna-rinda.
}
palaist.

Programma satīrīt.

usedMemory1 := (Programma atmiņa ? 0).

{
2 exponent factorial.
Izvade rakstīt: (11 atlikums: 3), jauna-rinda.
Izvade rakstīt: (3.4 noapaļot), jauna-rinda.
