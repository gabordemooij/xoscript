Izvade rakstīt: (7.9 noapaļot-uz-leju), jauna-rinda.
}
palaist.

Programma satīrīt.
usedMemory2 := (Programma atmiņa ? 0).


{
2 exponent factorial.
Izvade rakstīt: (11 atlikums: 3), jauna-rinda.
Izvade rakstīt: (3.4 noapaļot), jauna-rinda.
Izvade rakstīt: (7.1 noapaļot-uz-augšu), jauna-rinda.
Izvade rakstīt: (7.9 noapaļot-uz-leju), jauna-rinda.
} palaist.

Programma satīrīt.
usedMemory3 := (Programma atmiņa ? 0).



( usedMemory1 = usedMemory2 un: usedMemory1 = usedMemory3, un: usedMemory2 = usedMemory3 ) patiess: {
	Izvade rakstīt: ['No memory leaks here'].
}, aplams: {
	Izvade rakstīt: ['Leaking memory...'].
}.
