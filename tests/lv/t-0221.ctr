>> x := Objekts jauns.
>> y := Objekts jauns.
>> z := x.
Izvade rakstīt: (x = z), jauna-rinda.
Izvade rakstīt: (x = y), jauna-rinda.
Izvade rakstīt: (x ≠ y), jauna-rinda.
Izvade rakstīt: (x ≠ z), jauna-rinda.
>> m := Brīdis jauns gads: 2070, mēnesis: 11.
>> n := m kopēt.
Izvade rakstīt: (m = n), jauna-rinda.
Izvade rakstīt: (m ≠ n), jauna-rinda.
Izvade rakstīt: (m vienāds: m), jauna-rinda.
Izvade rakstīt: (m vienāds: n), jauna-rinda.
n mēnesis: 12.
Izvade rakstīt: (m ≠ n), jauna-rinda.
Izvade rakstīt: (m = n), jauna-rinda.


