# test qualifiers

Programma satīrīt.

>> Fruit := Objekts jauns.
Fruit kad: ['jauns'] darīt: {
	>> f := pats jauns.
	f apples: 0. <- f.
}.
Fruit kad: ['apples:'] darīt: { :a savs apples := a. }.
Fruit kad: ['apples'] darīt: { <- savs apples. }.
Fruit kad: ['+'] darīt: { :f
	>> n := Fruit jauns.
	n apples: (f apples + savs apples). <- n.
}.
Skaitlis kad: ['apples'] darīt: { <- ((Fruit jauns) apples: pats).
}.

Fruit kad: ['teksts'] darīt: { <- savs apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Izvade rakstīt: q, jauna-rinda.




q := 3 apples + 4 apples.
Izvade rakstīt: q, jauna-rinda.



