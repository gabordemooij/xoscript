Server init.
Izvade rakstīt: ['Database date test'], jauna-rinda.

>> db := Maria-DB jauns resursdators: ['localhost'],
	lietotājs: ['xo'], 
	parole: ['pass123'],
	datubāzes-nosaukums: ['xobase'],
	savienot.

>> meklēšanas-parametri :=
db vaicājums: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
iegūt: { :row
	Izvade rakstīt: row datetest, jauna-rinda.
}.
