>> echo := Objekts jauns.
echo kad: ['atbildēt:'] darīt: { :sound
	{ Izvade rakstīt: sound. } × 2.
}.
echo ho!. 


echo := Objekts jauns.
echo kad: ['atbildēt:un:'] darīt: { :sound :x
	{ Izvade rakstīt: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := Objekts jauns.
echo kad: ['atbildēt:un:un:'] darīt: { :operation :sound :x
	{ Izvade rakstīt: sound. } × x.
}.
echo shout: ['la'] times: 4. 


