>> Slurp := Objekts jauns.
Slurp kad: ['jauns'] darīt: {
	savs str := [''].
}.
Slurp iemācīties: ['nieuw'] nozīmē: ['jauns'].
Slurp kad: ['atbildēt:'] darīt: { :blah
		(savs str ≠ ['']) patiess: {
			savs str pievienot-beigās: [' '].
		}.
		savs str pievienot-beigās: blah.
}.
Slurp kad: ['atbildēt:un:'] darīt: { :blah :blahah
		(savs str ≠ ['']) patiess: {
			savs str pievienot-beigās: [' '].
		}.
		(blah garums > 1) patiess: {
			savs str pievienot-beigās: (blah no: 0 garums: (blah garums - 1)).
		}, citādi: {
			savs str pievienot-beigās: blah.
		}.
		savs str pievienot-beigās: [' '].
		savs str pievienot-beigās: blahah.
}.
Slurp kad: ['obtain'] darīt: {
	>> buffer := savs str.
	savs str := ['']. <- buffer.
}.


>> meklēšanas-parametri := Slurp jauns
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

Izvade rakstīt: meklēšanas-parametri obtain, jauna-rinda.
