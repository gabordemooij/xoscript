
>> animal := Objekts jauns. 
 
 animal kad: ['name:'] darīt: { :n
savs nosaukums := n.
}. 


animal name: ['Diva']. 
 
animal kad: ['nosaukums'] darīt: { <- nosaukums.
}.

>> cat := animal jauns.
 
 cat name: ['Diva']. 
 
 cat kad: ['nosaukums'] darīt: { <- ['your royal highness ']
+ (pats nosaukums).
}.

Izvade rakstīt: cat nosaukums.
