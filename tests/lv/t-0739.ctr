Izvade rakstīt: ['Test object'], jauna-rinda.
>> a := Objekts jauns. 

a kad: ['item:'] darīt: { :binhelper
	savs binhelper := binhelper. 
}.

a kad: ['item'] darīt: { <- savs binhelper.
}.

a item: Bin jauns.

>> old-binhelper-address := a item prototips atmiņas-adrese.
a save-as: ['/tmp/a.bin'].
Izvade rakstīt: ['========== RELOADING SNAP:'], jauna-rinda.

>> b := Objekts load-from: ['/tmp/a.bin'].

(b item prototips atmiņas-adrese = old-binhelper-address) patiess: {
	Izvade rakstīt: ['Object link re-attached.'], jauna-rinda.
}.


