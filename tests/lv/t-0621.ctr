>> phrases := Saraksts jauns
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases katrs: { :_ :phrase 
	>> e := Server base64-kodēt: phrase.
	>> d := Server base64-dekodēt: e.
	Izvade rakstīt: (
		message kopēt ~encoded: e, ~decoded: d
	), jauna-rinda.
}.
