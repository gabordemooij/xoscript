Izvade rakstīt: ['Test object'], jauna-rinda.
>> a := Objekts jauns. 

a kad: ['item:'] darīt: { :hexhelper
	savs hexhelper := hexhelper. 
}.

a kad: ['item'] darīt: { <- savs hexhelper.
}.

a item: Hx jauns.

>> old-hexhelper-address := a item prototips atmiņas-adrese.
a save-as: ['/tmp/a.bin'].
Izvade rakstīt: ['========== RELOADING SNAP:'], jauna-rinda.

>> b := Objekts load-from: ['/tmp/a.bin'].

(b item prototips atmiņas-adrese = old-hexhelper-address) patiess: {
	Izvade rakstīt: ['Object link re-attached.'], jauna-rinda.
}.
