>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objekts jauns.
⚄ kad: ['drawFrom:length:'] darīt: { :pool :skaits
	
	>> result := [''].
	
	{
		>> index := Skaitlis random % (pool garums).
		result pievienot-beigās: ( pool rakstzīme: (index + 1) ).
		
	} × skaits. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? garums.
Izvade rakstīt: (['x↵'] x random garums).
Izvade rakstīt: (['y↵'] y ?? garums).

