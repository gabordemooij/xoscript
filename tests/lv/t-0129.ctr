
Saraksts kad: ['product'] darīt: {
	>> total := 1.
	pats katrs: { :index :element
		total reizināt-ar: element.
	}. <- total.
}.

>> a := Saraksts ← 1 ; 2 ; 3.
Izvade rakstīt: a product, jauna-rinda.
Izvade rakstīt: (Saraksts ← 2 ; 4 ; 8) product, jauna-rinda. 
Izvade rakstīt: (Saraksts ← -2 ; 10) product, jauna-rinda. 
Izvade rakstīt: (Saraksts ← 0.5 ; -2) product, jauna-rinda. 
