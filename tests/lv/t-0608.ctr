
>> Size := Objekts jauns.
Size kad: ['is:'] darīt: { :skaitlis
	skaitlis kad: ['+'] darīt: { :skaitlis
		>> unit := skaitlis apzīmējums.
		>> factor := 1.
		
		unit
		gadījums: ['inch'] darīt: { factor := 0.0833. }. <- pats + (skaitlis * factor).
	}. <- skaitlis.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Izvade rakstīt: plank + edge, jauna-rinda.
