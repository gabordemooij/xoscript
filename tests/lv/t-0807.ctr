# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB jauns resursdators: ['localhost'],
	lietotājs: ['xo'],
	parole: ['pass123'],
	datubāzes-nosaukums: ['xobase'],
	savienot.

>> meklēšanas-parametri := db vaicājums: ['SELECT %% FROM'].
{ meklēšanas-parametri izpildīt. } tvert: { :e
	Izvade rakstīt: ( e satur: ['%%'] ), jauna-rinda.
}, palaist.
