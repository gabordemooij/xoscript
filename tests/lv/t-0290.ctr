# test list operations


>> cakes := Saraksts ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes aizstāt: 1 garums: 2 ar: ( Saraksts ← ['cinnamon'] ; ['pineapple'] ).
Izvade rakstīt: (buy apvienot: [',']), jauna-rinda.


>> buy := cakes aizstāt: 1 garums: 12 ar: ( Saraksts ← ['cinnamon'] ; ['pineapple'] ).
Izvade rakstīt: (buy apvienot: [',']), jauna-rinda.


>> buy := cakes aizstāt: 2 garums: 10 ar: ( Saraksts jauns ).
Izvade rakstīt: (buy apvienot: [',']), jauna-rinda.


>> buy := cakes aizstāt: 0 garums: 1 ar: ( Saraksts jauns ).
Izvade rakstīt: (buy apvienot: [',']), jauna-rinda.


>> buy := cakes aizstāt: ['0'] garums: ['1'] ar: ['x'].
Izvade rakstīt: (buy apvienot: [',']), jauna-rinda.
