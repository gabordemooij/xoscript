

# create a 64-bit integer for exact calculations
>> a := Int64 no-teksta: ['123'].

# to string
Izvade rakstīt: a, jauna-rinda.

# divide
Izvade rakstīt: a / (Int64 no-teksta: ['3']), jauna-rinda.

# multiply
Izvade rakstīt: a * (Int64 no-teksta: ['2']), jauna-rinda.

# add
Izvade rakstīt: a + (Int64 no-teksta: ['1']), jauna-rinda.

# subtract
Izvade rakstīt: a - (Int64 no-teksta: ['2']), jauna-rinda.

# compare
Izvade rakstīt: ( a =   (Int64 no-teksta: ['123'])), jauna-rinda.
Izvade rakstīt: ( a !=: (Int64 no-teksta: ['124'])), jauna-rinda.
Izvade rakstīt: ( a <   (Int64 no-teksta: ['124'])), jauna-rinda.
Izvade rakstīt: ( a >   (Int64 no-teksta: ['122'])), jauna-rinda.
Izvade rakstīt: ( a >=: (Int64 no-teksta: ['123'])), jauna-rinda.
Izvade rakstīt: ( a <=: (Int64 no-teksta: ['123'])), jauna-rinda.





	