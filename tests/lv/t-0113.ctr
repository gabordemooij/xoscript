Izvade rakstīt: ['Continue for-loop, No - before 6 and up.'], jauna-rinda.
{ :i
	Izvade rakstīt: (i + 1), jauna-rinda.
	((i + 1) > 4) turpināt.
	Izvade rakstīt: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Izvade jauna-rinda.
Izvade rakstīt: ['Continue while-true, No --> before 5 and up.'], jauna-rinda.
{
	Izvade rakstīt: ['iteration #'] + x, jauna-rinda.
	x pieskaitīt: 1.
	((x < 5) ne) turpināt.
	Izvade rakstīt: ['-->'].
} kamēr: xIsLessThan10.
Izvade jauna-rinda.
Izvade rakstīt: ['Continue while-false, No - before 3 only.'], jauna-rinda.
{
	Izvade rakstīt: ['iteration #'] + x, jauna-rinda.
	x atņemt: 1.
	(x = 3) turpināt.
	Izvade rakstīt: ['-'].
} kamēr: { <- ( x > 0). }.

Izvade jauna-rinda.
Izvade rakstīt: ['Continue times-loop, No ||| before 3.'], jauna-rinda.
{ :i
	Izvade rakstīt: ['iteration #'] + i, jauna-rinda.
	(i = 2) turpināt.
	Izvade rakstīt: ['|||'].
} × 5.

Izvade jauna-rinda.

{ Patiess turpināt. Izvade rakstīt: ['dont write this!'], jauna-rinda. } palaist.

{ Patiess turpināt. Izvade rakstīt: ['dont write this!'], jauna-rinda. } tvert: { Izvade rakstīt: ['Dont catch this!']. }, palaist.

Izvade rakstīt: ['Test Array each-loop: 0, ... ,2'], jauna-rinda.
(Saraksts ← 1 ; 2 ; 3) attēlot: { :i
	(i = 1) turpināt.
	Izvade rakstīt: ['iteration #'] + (i - 0), jauna-rinda.
}.

Izvade rakstīt: ['Test Map each-loop: c only'], jauna-rinda.
>> m := Vārdnīca jauns.
m ielikt: ['first'] pie: ['a'], ielikt: ['second'] pie: ['b'], ielikt: ['third'] pie: ['c'].
m katrs: { :k :v
	(k ≠ ['c']) turpināt.
	Izvade rakstīt: ['iteration'] + k + v, jauna-rinda.
}.

