>> t := Nekas.

# you can control the time zone for
# parsing like this:
Brīdis zona: ['CET'].
t := Brīdis avots: ['1981-02-03 04:05:06'].
Izvade rakstīt: t, jauna-rinda.

# now using CEST time zone:
Brīdis zona: ['CEST'].
t := Brīdis avots: ['1981-02-03 04:05:06'].
Izvade rakstīt: t, jauna-rinda.

# error if string cannot be parsed
{ Brīdis avots: ['1900']. } tvert: { Nekas. }, palaist.
