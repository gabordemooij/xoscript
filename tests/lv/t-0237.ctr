
Teksts kad: ['evaluate'] darīt: {
	>> kods := Fails jauns: ['/tmp/eval.ctr'].
	kods rakstīt: (pats teksts + ['.']).
	Programma izmantot: ['/tmp/eval.ctr'].
}.

>> map :=
	(Vārdnīca jauns)
	ielikt: ['Hi There'] pie: ['two'],
	ielikt: (Saraksts ← ['hello'] ; ['world'] ; (Saraksts ← 1 ; 2; 9) ; Aplams) pie: ['one'],
	ielikt: ( (Vārdnīca jauns) ielikt: ['wrrld'] pie: ['misspelled'] ) pie: ['three'],
	ielikt: (Saraksts ← ((Vārdnīca jauns) ielikt: ['treasure'] pie: ['hidden']) ; 2) pie: ['four']. 
>> str := map teksts.
>> map2 := Nekas.
(['map2 := '] + str ) evaluate.
Izvade rakstīt: map2 ? ['one'] ? 0.
Izvade rakstīt: map2 ? ['one'] ? 1.
Izvade rakstīt: map2 ? ['four'] ? 0 ? ['hidden'].
Izvade rakstīt: map2 ? ['one'] ? 2 ? 2.
