


>> Deck := Saraksts jauns.
Deck kad: ['print'] darīt: {
        >> len := pats skaits - 1.
        { :i
                >> len2 := pats skaits - 1.
                Izvade rakstīt: ['len: '].
                Izvade rakstīt: len, jauna-rinda.
                Izvade rakstīt: ['len2: '].
                Izvade rakstīt: len2, jauna-rinda.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
