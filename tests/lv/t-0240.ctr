# test qualifiers

>> $ := Objekts jauns.

$ kad: ['atbildēt:'] darīt: { :x
	
	>> operation := x rakstzīme: 0.
	>> valuta := x rakstzīme: 1.
	>> money := x nobīde: 2.
	
	>> amount := 0.

	( operation = ['+'] ) patiess: {
		( valuta = ['£'] ) patiess: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Izvade rakstīt: x, jauna-rinda.


>> Fruit := Objekts jauns.

Fruit kad: ['jauns'] darīt: {
	>> f := pats jauns.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit kad: ['apples:'] darīt: { :a savs apples := a. }.
Fruit kad: ['oranges:'] darīt: { :p savs oranges := p. }.
Fruit kad: ['apples'] darīt: { <- savs apples. }.
Fruit kad: ['oranges'] darīt: { <- savs oranges. }.

Fruit kad: ['+'] darīt: { :f
	
	>> n := Fruit jauns.
	f pieskaitīt: 1.
	
	n apples: (f apples + savs apples).
	n oranges:  (f oranges  + savs oranges). <- n.
}.

Fruit kad: ['teksts'] darīt: { <- ( savs apples teksts + [' apples and '] + savs oranges + [' oranges'] ).
}.

Skaitlis kad: ['apples'] darīt: { <- ((Fruit jauns) apples: pats).
}.

Skaitlis kad: ['apple'] darīt: { <- ((Fruit jauns) apples: pats).
}.

Skaitlis kad: ['oranges'] darīt: { <- ((Fruit jauns) oranges: pats).
}.




Izvade rakstīt: (1 apple + 3 oranges + 4 apples), jauna-rinda.


Teksts kad: ['twice'] darīt: { <- ((pats teksts) + (pats teksts)).
}.



Izvade rakstīt: ['❤❤❤'] twice.



