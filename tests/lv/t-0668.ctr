# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob jauns: 8, bytes: (
	Saraksts jauns ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Izvade rakstīt: ( utf16 dekodēt: ['utf16le'] ), jauna-rinda.

utf16 atbrīvot.
>> utf32 := Blob jauns: 13, bytes: (
	Saraksts jauns ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Izvade rakstīt: ( utf32 dekodēt: ['utf32be'] ), jauna-rinda.
utf32 atbrīvot.