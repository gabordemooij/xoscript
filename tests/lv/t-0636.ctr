# test url parsing

Server init.
>> url := URL avots: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Izvade rakstīt: ['scheme = '] + url shēma, jauna-rinda.
Izvade rakstīt: ['host = '] + url resursdators, jauna-rinda.
Izvade rakstīt: ['port = '] + url ports, jauna-rinda.
Izvade rakstīt: ['path = '] + url ceļš, jauna-rinda.
Izvade rakstīt: ['query = '] + url meklēšanas-parametri, jauna-rinda.
Izvade rakstīt: ['fragment = '] + url fragments, jauna-rinda.
