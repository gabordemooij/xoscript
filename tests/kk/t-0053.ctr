60 × {
	>> x := (Сан random % 6) + 1.
	(x ≤ 6) жалған-болса: { Шығыс жазу: ['FAIL']. }.
	(x ≥0) жалған-болса: { Шығыс жазу: ['FAIL']. }.
	x := (Сан random % 3) + 1.
	(x < 3) жалған-болса: { Шығыс жазу: ['FAIL']. }.
	(x>-1) жалған-болса: { Шығыс жазу: ['FAIL']. }.
	x := ((Логикалық flip) сан).
	(x = 0 немесе: x = 1) жалған-болса: { Шығыс жазу: ['FAIL']. }.
	x := ((Ақиқат flip) сан).
	(x = 0 немесе: x = 1) жалған-болса: { Шығыс жазу: ['FAIL']. }.
	x := (Логикалық flip бұл: ['HEAD'] не-ол: ['TAIL']).
	((x = ['HEAD']) немесе: (x = ['TAIL'])) жалған-болса: { Шығыс жазу: ['FAIL']. }.
}.
Шығыс жазу: ['DONE'].

