Шығыс жазу: ['Continue for-loop, No - before 6 and up.'], жаңа-жол.
{ :i
	Шығыс жазу: (i + 1), жаңа-жол.
	((i + 1) > 4) жалғастыру.
	Шығыс жазу: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Шығыс жаңа-жол.
Шығыс жазу: ['Continue while-true, No --> before 5 and up.'], жаңа-жол.
{
	Шығыс жазу: ['iteration #'] + x, жаңа-жол.
	x қосу: 1.
	((x < 5) теріс) жалғастыру.
	Шығыс жазу: ['-->'].
} әзірше: xIsLessThan10.
Шығыс жаңа-жол.
Шығыс жазу: ['Continue while-false, No - before 3 only.'], жаңа-жол.
{
	Шығыс жазу: ['iteration #'] + x, жаңа-жол.
	x азайту: 1.
	(x = 3) жалғастыру.
	Шығыс жазу: ['-'].
} әзірше: { <- ( x > 0). }.

Шығыс жаңа-жол.
Шығыс жазу: ['Continue times-loop, No ||| before 3.'], жаңа-жол.
{ :i
	Шығыс жазу: ['iteration #'] + i, жаңа-жол.
	(i = 2) жалғастыру.
	Шығыс жазу: ['|||'].
} × 5.

Шығыс жаңа-жол.

{ Ақиқат жалғастыру. Шығыс жазу: ['dont write this!'], жаңа-жол. } іске-қосу.

{ Ақиқат жалғастыру. Шығыс жазу: ['dont write this!'], жаңа-жол. } ұстау: { Шығыс жазу: ['Dont catch this!']. }, іске-қосу.

Шығыс жазу: ['Test Array each-loop: 0, ... ,2'], жаңа-жол.
(Тізім ← 1 ; 2 ; 3) түрлендіру: { :i
	(i = 1) жалғастыру.
	Шығыс жазу: ['iteration #'] + (i - 0), жаңа-жол.
}.

Шығыс жазу: ['Test Map each-loop: c only'], жаңа-жол.
>> m := Сөздік жаңа.
m қою: ['first'] кілт: ['a'], қою: ['second'] кілт: ['b'], қою: ['third'] кілт: ['c'].
m әрбір: { :k :v
	(k ≠ ['c']) жалғастыру.
	Шығыс жазу: ['iteration'] + k + v, жаңа-жол.
}.

