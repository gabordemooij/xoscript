

>> obj := Нысан жаңа.

obj келгенде: ['greet'] орында: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj келгенде: ['task'] орында: {
	өзінің property := 123.
	{
		# try binds self/own to object instead of block
		Шығыс жазу: өзі greet.
		Шығыс жазу: өзінің property.
		1 / 0.
	} ұстау: {
		Шығыс жазу: өзі greet.
		Шығыс жазу: өзінің property.
		Шығыс жазу: ['ok'].
	}, байқап-көру.
}.

obj task.