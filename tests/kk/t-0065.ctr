Сан келгенде: ['factorial'] орында: {
	>> total := 1.
	{ :index total көбейту: (өзі - (index)). } × өзі. <- total.
}.
>> Printer := Нысан жаңа.
Printer келгенде: ['print:and:'] орында: { :x :y
	Шығыс жазу: ['a='] + x + [', b='] + y, жаңа-жол.
}.
>> a := 4.5. >> b := a төмен-дөңгелектеу.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a жоғары-дөңгелектеу.
Printer print: a and: b.
a := 4.5. b := a төмен-дөңгелектеу.
Printer print: a and: b.
a := 4.5. b := a дөңгелектеу.
Printer print: a and: b.
a := 4.2. b := a дөңгелектеу.
Printer print: a and: b.

Шығыс жазу: (9 қалдық: 5), жаңа-жол.
Шығыс жазу: -666 абсолют-мән, жаңа-жол.
Шығыс жазу: 49 квадрат-түбір, жаңа-жол.
Шығыс жазу: (2 дәреже: 3), жаңа-жол.
>> l := (Тізім ← 9 ; 6).
Шығыс жазу: l ең-кіші.

