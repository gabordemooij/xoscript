

Тізім келгенде: ['sum'] орында: {
	>> total := 0.
	өзі әрбір: { :index :element
		total қосу: element.
	}. <- total.
}.

Тізім келгенде: ['product'] орында: {
	>> total := 1.
	өзі әрбір: { :index :element
		total көбейту: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Бағдарлама жадты-басқару: 0.

{

>> a := Тізім ← ['hello'] ; ['world'] ; Ақиқат ; Бос ; 666.
a := a + ( Тізім ← 1 ).
Шығыс жазу: ( ['sum: '] + ( a sum ) ), жаңа-жол.
Шығыс жазу: ( ['min: '] + ( a ең-кіші ) ), жаңа-жол.
Шығыс жазу: ( ['max: '] + ( a ең-үлкен ) ), жаңа-жол.
Шығыс жазу: ( ['3rd: '] + ( a ? 2 ) ), жаңа-жол.
Шығыс жазу: ( ['prd: '] + ( a product ) ), жаңа-жол.
a сұрыптау: { :a :b <- (b - a). }.
a әрбір: { :i :e Шығыс жазу: ( i - 0 ), жаңа-жол. }.

} іске-қосу.

Бағдарлама тазалау.
usedMemory1 := (Бағдарлама жад ? 0).


{

>> a := Тізім ← ['hello'] ; ['world'] ; Ақиқат ; Бос ; 666.
a := a + ( Тізім ← 1 ).
Шығыс жазу: ( ['sum: '] + ( a sum ) ), жаңа-жол.
Шығыс жазу: ( ['min: '] + ( a ең-кіші ) ), жаңа-жол.
Шығыс жазу: ( ['max: '] + ( a ең-үлкен ) ), жаңа-жол.
Шығыс жазу: ( ['3rd: '] + ( a ? 2 ) ), жаңа-жол.
Шығыс жазу: ( ['prd: '] + ( a product ) ), жаңа-жол.
a сұрыптау: { :a :b <- (b - a). }.
a әрбір: { :i :e Шығыс жазу: ( i - 0 ), жаңа-жол. }.

} іске-қосу.



Бағдарлама тазалау.
usedMemory2 := (Бағдарлама жад ? 0).


{

>> a := Тізім ← ['hello'] ; ['world'] ; Ақиқат ; Бос ; 666.
a := a + ( Тізім ← 1 ).
Шығыс жазу: ( ['sum: '] + ( a sum ) ), жаңа-жол.
Шығыс жазу: ( ['min: '] + ( a ең-кіші ) ), жаңа-жол.
Шығыс жазу: ( ['max: '] + ( a ең-үлкен ) ), жаңа-жол.
Шығыс жазу: ( ['3rd: '] + ( a ? 2 ) ), жаңа-жол.
Шығыс жазу: ( ['prd: '] + ( a product ) ), жаңа-жол.
a сұрыптау: { :a :b <- (b - a). }.
a әрбір: { :i :e Шығыс жазу: ( i - 0 ), жаңа-жол. }.

} іске-қосу.



Бағдарлама тазалау.
usedMemory3 := (Бағдарлама жад ? 0).

( usedMemory1 = usedMemory2 және: usedMemory1 = usedMemory3, және: usedMemory2 = usedMemory3 ) ақиқат-болса: {
	Шығыс жазу: ['No memory leaks here'].
}, жалған-болса: {
	Шығыс жазу: ['Leaking memory...'].
}.
