#ffi test


Server init.

Бағдарлама жадты-басқару: 4.

# for this test you need set a path to libc (puts)
>> libname := Бағдарлама баптау: ['FFITESTLIB'].



Server байланыстыру: (
 Тізім жаңа ;
 libname ;
 ['puts'] ;
 ( Тізім жаңа ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s босату.

# test with struct

>> a := Blob жаңа: 8.
a bytes: (
	Тізім <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Тізім <<: ['int'], ; ['int']).

Server байланыстыру: (
	Тізім <<: ['@structtest'], ;
	['@structtest'] ;
	(Тізім <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Шығыс жазу: ['Sum test:'] + (ffitest ffisum: a), жаңа-жол.

struct struct-босату.
struct босату.
a босату.
