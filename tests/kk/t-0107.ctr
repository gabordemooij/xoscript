
Шығыс жазу: ['Break for-loop, 0-4.'], жаңа-жол.
{ :i
	Шығыс жазу: ['iteration #'] + i, жаңа-жол.
	(i = 4) үзу.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Шығыс жазу: ['Break while-true loop, 0-4.'], жаңа-жол.
{
	Шығыс жазу: ['iteration #'] + x, жаңа-жол.
	x қосу: 1.
	((x < 5) теріс) үзу.
} әзірше: xIsLessThan10.

Шығыс жазу: ['Break while-false loop, 5,4.'], жаңа-жол.
{
	Шығыс жазу: ['iteration #'] + x, жаңа-жол.
	x азайту: 1.
	(x = 3) үзу.
} әзірше: { <- (x > 0). }.

Шығыс жазу: ['Break times loop, 1-4.'], жаңа-жол.
{ :i
	Шығыс жазу: ['iteration #'] + i, жаңа-жол.
	(i = 4) үзу.
} × 5.

Шығыс жазу: ['Break block, dont print line.'], жаңа-жол.
{ Ақиқат үзу. Шығыс жазу: ['dont write this!'], жаңа-жол. } іске-қосу.

Шығыс жазу: ['Break block, dont fire catch...'], жаңа-жол.
{ Ақиқат үзу. Шығыс жазу: ['dont write this!'], жаңа-жол. } ұстау: { Шығыс жазу: ['Dont catch this!']. }, іске-қосу.

Шығыс жазу: ['Test Array each-loop: 0,1'], жаңа-жол.
(Тізім ← 1 ; 2 ; 3) түрлендіру: { :i
	Шығыс жазу: ['iteration #'] + i, жаңа-жол.
	(i = 1) үзу.
}.

Шығыс жазу: ['Test Map each-loop: c only'], жаңа-жол.
>> m := Сөздік жаңа.
m қою: ['first'] кілт: ['a'], қою: ['second'] кілт: ['b'], қою: ['third'] кілт: ['c'].
m әрбір: { :k :v
	Шығыс жазу: ['iteration'] + v + k, жаңа-жол.
	Ақиқат үзу.
}.

