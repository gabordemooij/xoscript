Server init.
Шығыс жазу: ['Database time test'], жаңа-жол.

>> db := Maria-DB жаңа хост: ['localhost'],
	пайдаланушы-аты: ['xo'], 
	құпиясөз: ['pass123'],
	дерекқор-атауы: ['xobase'],
	қосылу.

>> іздеу-параметрлері :=
db сұрау: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
алу: { :row
	Шығыс жазу: row timetest, жаңа-жол.
}.
