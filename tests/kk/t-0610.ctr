
>> Rectangle := Нысан жаңа.

Rectangle келгенде: ['area'] орында: { <- өзінің ұзындық * өзінің width.
}.

Rectangle келгенде: ['length:'] орында: { :ұзындық
	өзінің ұзындық := ұзындық.
}.

Rectangle келгенде: ['width:'] орында: { :width
	өзінің width := width.
}.

Rectangle келгенде: ['жаңа'] орында: {
	# this will not result into an infinite loop
	>> rectangle := өзі жаңа.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle жаңа.
Шығыс жазу: a area, жаңа-жол. #0

>> b := Rectangle жаңа length: 2, width: 3.
Шығыс жазу: b area, жаңа-жол. #6

