# compliance test

# use international numbers

Шығыс жазу: ['1000 -> '].
Шығыс жазу: 1000, жаңа-жол. #1000

Шығыс жазу: ['1.5 -> '].
Шығыс жазу: 1.5, жаңа-жол.  #1.5

Шығыс жазу: ['1001.5 -> '].
Шығыс жазу: 1.5 + 1000, жаңа-жол. #1001.5

# use 0-indexed arrays
>> x := Тізім жаңа ; 1 ; 2 ; 3.
>> y := Тізім жаңа ; ['a'] ; ['b'] ; ['c'].

Шығыс жазу: ['1 -> '].
Шығыс жазу: x ? 0, жаңа-жол. #1

Шығыс жазу: ['1 -> '].
Шығыс жазу: (x орнында: 0), жаңа-жол. #1

Шығыс жазу: ['1 -> '].
Шығыс жазу: x бірінші, жаңа-жол. #1

Шығыс жазу: ['3 -> '].
Шығыс жазу: x соңғы, жаңа-жол. #3

Шығыс жазу: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Шығыс жазу: (x бойынша: y), жаңа-жол.

Шығыс жазу: ['1 -> '].
Шығыс жазу: (x бастап: 0 ұзындық: 1) бірінші, жаңа-жол. #1

Шығыс жазу: ['0 -> '].
Шығыс жазу: (x табу: 1), жаңа-жол. #0

x қою: 9 кілт: 0.

Шығыс жазу: ['9 -> '].
Шығыс жазу: (x орнында: 0), жаңа-жол. #9

x басына-қосу: 8.
Шығыс жазу: ['8 -> '].
Шығыс жазу: (x орнында: 0), жаңа-жол. #9


x соңына-қосу: 10.
Шығыс жазу: ['10 -> '].
Шығыс жазу: (x орнында: 4), жаңа-жол. #10








