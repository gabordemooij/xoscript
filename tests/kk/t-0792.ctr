Server init.

>> DB := Maria-DB жаңа хост: ['localhost'],
	пайдаланушы-аты: ['xo'],
	құпиясөз: ['pass123'],
	дерекқор-атауы: ['xobase'],
	қосылу.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB сұрау: SQL.

# now you don't have to set DB
query2 алу: { :row
	Шығыс жазу: row world, жаңа-жол.
}.
