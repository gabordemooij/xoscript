# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Сейф 
	құпиясөз-хэші: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Сейф 
	құпиясөз-хэші: hash тексеру: a1.
	# fail 
>> b := Сейф
	құпиясөз-хэші: hash тексеру: a2.
	# ok!

Шығыс жазу: a, жаңа-жол.
Шығыс жазу: b, жаңа-жол.

