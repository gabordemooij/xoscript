#Linux
>> OS := Бағдарлама баптау: ['OS'].

>> clock := Сәт жаңа.
	
(OS = ['Haiku']) ақиқат-болса: {
	clock уақыт-белдеуі: ['CET'],
	жыл: 2017, ай: 7, күн: 13,
	сағат: 18, минут: 0, секунд: 0.
}, әйтпесе: {
	clock уақыт-белдеуі: ['Europe/Amsterdam'],
	жыл: 2017, ай: 7, күн: 13,
	сағат: 18, минут: 0, секунд: 0.
}.

clock келгенде: ['tell'] орында: {
	Шығыс жазу: өзі, жаңа-жол.
}.


clock қосу: 2    сағат, tell.
clock қосу: 1    сағат, tell.
clock қосу: 19 минут, tell.
clock қосу: 1  минут, tell.
clock қосу: 1  минут, tell.
clock қосу: 19 секунд, tell.
clock қосу: 1  секунд, tell.
clock қосу: 1  секунд, tell.
clock қосу: 2    жыл, tell.
clock қосу: 1    жыл, tell.

(OS = ['Haiku']) ақиқат-болса: {
clock қосу: 5   ай.
clock уақыт-белдеуі: ['CEST'], tell.
}, әйтпесе: {
	clock қосу: 5   ай, tell.
}.

clock қосу: 1   ай, tell.
clock қосу: 19    күн, tell.
clock қосу: 1    сағат, tell.
clock қосу: 120  yard, tell.
