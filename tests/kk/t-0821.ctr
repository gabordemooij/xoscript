# a quote that never closes must give an error, not an endless loop
>> жол := ['/tmp/test0821.csv'].
>> file := Файл жаңа: жол.

file жазу: ['a,b\n"1,2\n'].
{
	file бөлгіш: [','] тырнақша: ['"'] жолдар: { :line
		Шығыс жазу: line, жаңа-жол.
	}.
} ұстау: { :e Шығыс жазу: e, жаңа-жол. }, іске-қосу.

# a closed quote still works
file жазу: ['a,b\n"1,2",3'].
file бөлгіш: [','] тырнақша: ['"'] жолдар: { :line
	Шығыс жазу: line, жаңа-жол.
}.
file жою.
