
>> Size := Нысан жаңа.
Size келгенде: ['is:'] орында: { :сан
	сан келгенде: ['+'] орында: { :сан
		>> unit := сан өлшем-бірлігі.
		>> factor := 1.
		
		unit
		жағдай: ['inch'] орында: { factor := 0.0833. }. <- өзі + (сан * factor).
	}. <- сан.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Шығыс жазу: plank + edge, жаңа-жол.
