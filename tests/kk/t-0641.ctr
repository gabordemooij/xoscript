# Test utf8 sanitizer
Server init.

>> utf8cases := Сөздік жаңа
	# ASCII only
	қою: ( Тізім жаңа ; 65 ; 65 ; 65 ; 65 ; 0 ) кілт: ['AAAA'],
	# valid 2 byte sequence
	қою: ( Тізім жаңа ; 194 ; 162 ; 0 ) кілт: ['¢'],
	# Valid 3-byte UTF-8
    қою: ( Тізім жаңа ; 226 ; 130 ; 172 ; 0 ) кілт: ['€'],
	# Valid 4-byte UTF-8
    қою: ( Тізім жаңа ; 240 ; 144 ; 141 ; 136 ; 0 ) кілт: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    қою: ( Тізім жаңа ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) кілт: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    қою: ( Тізім жаңа ; 65 ; 193 ; 129 ; 0 ) кілт: ['A?'],
	# Invalid first byte (0xFF)
    қою: ( Тізім жаңа ; 255 ; 0 ) кілт: ['?'],
	# Incomplete multi-byte sequence at end
    қою: ( Тізім жаңа ; 66 ; 226 ; 0 ) кілт: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    қою: ( Тізім жаңа ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) кілт: ['A€?𐍈B'].
	 
utf8cases әрбір: { :key :value
	>> blob := Blob жаңа: value саны, bytes: value.
	>> str := blob мәтін.
	(str = key) ақиқат-болса: {
		Шығыс жазу: ['OK'], жаңа-жол.
	}, әйтпесе: {
		Шығыс жазу: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, жаңа-жол.
	}.
	blob босату.
}.
