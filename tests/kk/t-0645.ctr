Server init.
Шығыс жазу: ['Database date test'], жаңа-жол.

>> db := Maria-DB жаңа хост: ['localhost'],
	пайдаланушы-аты: ['xo'], 
	құпиясөз: ['pass123'],
	дерекқор-атауы: ['xobase'],
	қосылу.

>> іздеу-параметрлері :=
db сұрау: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
алу: { :row
	Шығыс жазу: row datetest, жаңа-жол.
}.
