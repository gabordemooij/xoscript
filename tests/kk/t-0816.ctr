# a format must fit the type of the value, the type can come from a client
>> байқап-көру := { :format :value
	{ Шығыс жазу: ( (Пішім жаңа: format) қолдану: value ), жаңа-жол. } ұстау: { :e Шығыс жазу: e, жаңа-жол. }, іске-қосу.
}.
>> try-int := { :format :value
	{ Шығыс жазу: ( (Пішім жаңа: format) қолдану-бүтін: value ), жаңа-жол. } ұстау: { :e Шығыс жазу: e, жаңа-жол. }, іске-қосу.
}.

# fits
байқап-көру қолдану: ['|%s|'] және: ['text'].
байқап-көру қолдану: ['%06.2f'] және: 5.5.
байқап-көру қолдану: ['100%% %s'] және: ['sure'].
try-int қолдану: ['%03d'] және: 7.
try-int қолдану: ['%x'] және: 255.
байқап-көру қолдану: ['%d'] және: (Int64 жаңа мәтіннен: ['12']).
байқап-көру қолдану: ['%lld'] және: (Int64 жаңа мәтіннен: ['12']).
байқап-көру қолдану: ['%.1lf'] және: 5.5.
try-int қолдану: ['%hd'] және: 7.

# does not fit
байқап-көру қолдану: ['%s'] және: 12345.
байқап-көру қолдану: ['%d'] және: 12345.
байқап-көру қолдану: ['%f'] және: ['text'].
try-int қолдану: ['%d'] және: ['text'].
try-int қолдану: ['%s'] және: 5.
байқап-көру қолдану: ['%s %s'] және: ['text'].
байқап-көру қолдану: ['%n'] және: ['text'].
байқап-көру қолдану: ['%*s'] және: ['text'].
байқап-көру қолдану: ['%'] және: ['text'].

# length modifier does not fit
байқап-көру қолдану: ['%ls'] және: ['text'].
байқап-көру қолдану: ['%Lf'] және: 5.5.
try-int қолдану: ['%ld'] және: 7.
try-int қолдану: ['%lld'] және: 7.
байқап-көру қолдану: ['%Ld'] және: (Int64 жаңа мәтіннен: ['12']).

# a width that does not fit printf must give an error, not a crash
байқап-көру қолдану: ['%99999999999s'] және: ['text'].
