Server init.
{ >> x := JSON нысан: ['{}']. 	Шығыс жазу: x, жаңа-жол. } ұстау: { :e	Шығыс жазу: e, жаңа-жол. }, іске-қосу.
{ >> x := JSON нысан: ['""']. 	Шығыс жазу: x, жаңа-жол. } ұстау: { :e	Шығыс жазу: e, жаңа-жол. }, іске-қосу.
{ >> x := JSON нысан: ['']. 	Шығыс жазу: x, жаңа-жол. } ұстау: { :e	Шығыс жазу: e, жаңа-жол. }, іске-қосу.
{ >> x := JSON нысан: ['"']. 	Шығыс жазу: x, жаңа-жол. } ұстау: { :e	Шығыс жазу: e, жаңа-жол. }, іске-қосу.
{ >> x := JSON нысан: ['\’']. 	Шығыс жазу: x, жаңа-жол. } ұстау: { :e	Шығыс жазу: e, жаңа-жол. }, іске-қосу.
{ >> x := JSON нысан: ['\‘\’']. 	Шығыс жазу: x, жаңа-жол. } ұстау: { :e	Шығыс жазу: e, жаңа-жол. }, іске-қосу.
{ >> x := JSON нысан: ['0']. 	Шығыс жазу: x, жаңа-жол. } ұстау: { :e	Шығыс жазу: e, жаңа-жол. }, іске-қосу.
{ >> x := JSON нысан: ['"x"']. 	Шығыс жазу: x, жаңа-жол. } ұстау: { :e	Шығыс жазу: e, жаңа-жол. }, іске-қосу.
{ >> x := JSON нысан: ['[]']. 	Шығыс жазу: x, жаңа-жол. } ұстау: { :e	Шығыс жазу: e, жаңа-жол. }, іске-қосу.
