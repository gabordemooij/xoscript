Шығыс жазу: ['Test object'], жаңа-жол.
>> a := Нысан жаңа. 

a келгенде: ['item:'] орында: { :num
	өзінің num := num. 
}.

a келгенде: ['item'] орында: { <- өзінің num.
}.

a item: 123.

Шығыс жазу: a item, жаңа-жол.

>> old-num-address := a item прототип жад-мекенжайы.
a save-as: ['/tmp/a.bin'].
Шығыс жазу: ['========== RELOADING SNAP:'], жаңа-жол.

>> b := Нысан load-from: ['/tmp/a.bin'].

(b item прототип жад-мекенжайы = old-num-address) ақиқат-болса: {
	Шығыс жазу: ['Object link re-attached.'], жаңа-жол.
}.

Шығыс жазу: b item, жаңа-жол.
