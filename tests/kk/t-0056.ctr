>> z := Нысан жаңа.
z келгенде: ['value:'] орында: { :v
	өзінің value := v. <- өзі.
}.
z келгенде: ['value'] орында: { <- өзінің value. }.
(z setValue: 1) value: 2.
Шығыс жазу: z value.
>> x := z.
Шығыс жазу: x value.
z := Бос.
Шығыс жазу: z value.
Шығыс жазу: x value.
Шығыс жазу: ['hello'].
Шығыс жазу: 3 + 2.
Шығыс жазу: (3 > 2).
