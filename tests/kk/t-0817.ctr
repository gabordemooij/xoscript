# a value ending in the first part of an opening quote must survive serialization
>> мәндер := Тізім жаңа
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

мәндер әрбір: { :i :value
	>> d := Сөздік жаңа.
	d қою: value кілт: ['k'].
	d қою: ['second'] кілт: ['j'].
	>> r := d код нысан.
	Шығыс жазу: r саны, жаңа-жол.
	Шығыс жазу: ( (r орнында: ['k']) = value ), жаңа-жол.
}.
