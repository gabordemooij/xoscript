

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Бағдарлама жадты-басқару: 0.

{ :i Шығыс жазу: i. } × 4.
Шығыс жаңа-жол.
{ :i Шығыс жазу: (4 - i). } × 4.
Шығыс жаңа-жол.
( 1 > 2 ) жалған-болса: { Шығыс жазу: ['BLOCK 1'], жаңа-жол. }.
( 2 > 1 ) ақиқат-болса:  { Шығыс жазу: ['BLOCK 2'], жаңа-жол. }.

>> i := 0.
{ Шығыс жазу: i. i қосу: 1. } әзірше: { <- ( i < 3). }.
Шығыс жаңа-жол.

i := 3.
{ Шығыс жазу: i. i := i - 1. } әзірше: { <- ( i > 0). }.
Шығыс жаңа-жол.


Бағдарлама тазалау.

usedMemory1 := (Бағдарлама жад ? 0).


{ :i  Шығыс жазу: i. } × 4.
Шығыс жаңа-жол.
{ :i  Шығыс жазу: (4 - i). } × 4.
Шығыс жаңа-жол.
( 1 > 2 ) жалған-болса: { Шығыс жазу: ['BLOCK 1'], жаңа-жол. }.
( 2 > 1 ) ақиқат-болса:  { Шығыс жазу: ['BLOCK 2'], жаңа-жол. }.

>> i := 0.
{ Шығыс жазу: i. i қосу: 1. } әзірше: { <- ( i < 3). }.
Шығыс жаңа-жол.

i := 3.
{ Шығыс жазу: i. i := i - 1. } әзірше: { <- ( i > 0). }.
Шығыс жаңа-жол.



Бағдарлама тазалау.
usedMemory2 := (Бағдарлама жад ? 0).


{ :i Шығыс жазу: i. } × 4.
Шығыс жаңа-жол.
{ :i Шығыс жазу: (4 - i). } × 4.
Шығыс жаңа-жол.
( 1 > 2 ) жалған-болса: { Шығыс жазу: ['BLOCK 1'], жаңа-жол. }.
( 2 > 1 ) ақиқат-болса:  { Шығыс жазу: ['BLOCK 2'], жаңа-жол. }.

>> i := 0.
{ Шығыс жазу: i. i қосу: 1. } әзірше: { <- ( i < 3). }.
Шығыс жаңа-жол.

i := 3.
{ Шығыс жазу: i. i := i - 1. } әзірше: { <- ( i > 0). }.
Шығыс жаңа-жол.

Бағдарлама тазалау.
usedMemory3 := (Бағдарлама жад ? 0).



( usedMemory1 = usedMemory2 және: usedMemory1 = usedMemory3, және: usedMemory2 = usedMemory3 ) ақиқат-болса: {
	Шығыс жазу: ['No memory leaks here'].
}, жалған-болса: {
	Шығыс жазу: ['Leaking memory...'].
}.
