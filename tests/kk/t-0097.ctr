
Мәтін келгенде: ['html'] орында: { <- (
		өзі
		ауыстыру: ['&'] мынаған: ['&amp;'],
		ауыстыру: ['<'] мынаған: ['&lt;'],
		ауыстыру: ['>'] мынаған: ['&gt;'],
		ауыстыру: ['"'] мынаған: ['&quot;']
	).
}.

>> HtmlBrush := Нысан жаңа.

HtmlBrush келгенде: ['жауап:'] орында: { :tag
	Шығыс жазу: (['<tag>↵'] tag: tag ).
}.

HtmlBrush келгенде: ['жауап:және:'] орында: { :tag :content
	tag := ( tag бастап: 0 ұзындық: (tag ұзындық - 1) ).
	Шығыс жазу: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush келгенде: ['content:'] орында: { :text
	Шығыс жазу: text html, жаңа-жол.
}.

HtmlBrush келгенде: ['attr:value:'] орында: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush жаңа.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
