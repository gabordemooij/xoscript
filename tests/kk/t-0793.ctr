Server init.

>> DB := Maria-DB жаңа хост: ['localhost'],
	пайдаланушы-аты: ['xo'],
	құпиясөз: ['pass123'],
	дерекқор-атауы: ['xobase'],
	қосылу.

{
	DB сұрау:
	['DROP TABLE movies'],
	орындау.
} ұстау: { Бос. }, іске-қосу.

DB сұрау:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
орындау.

DB сұрау: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
параметрлер: ( Тізім жаңа ; ['Halloween'] ),
орындау.

DB сұрау: ['SELECT * FROM movies'],
алу: { :movie
	Шығыс жазу: movie title, жаңа-жол.
}.

