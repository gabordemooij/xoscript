Тізім келгенде: ['sum'] орында: {
	>> total := 0.
	өзі әрбір: { :index :element
		total қосу: element.
	}. <- total.
}.

>> a := Ақиқат.



a келгенде: ['мәтін'] орында: {
	>> answer := Бос.
	( өзі = Ақиқат ) ақиқат-болса: {
		answer := ['Yep'].
	}, әйтпесе: {
		answer := ['Nope'].
	}. <- answer.
}.

a келгенде: ['сан'] орында: {
	>> answer := Бос.
	( өзі = Ақиқат ) ақиқат-болса: {
		answer := 10.
	}, әйтпесе: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b келгенде: ['мәтін'] орында: { <- ['Devil'].
}.

b келгенде: ['логикалық'] орында: { <- Жалған.
}.


Шығыс жазу: a, жаңа-жол.  
Шығыс жазу: (90 + a), жаңа-жол. 
Шығыс жазу: b, жаңа-жол. 
Шығыс жазу: (Ақиқат және: b), жаңа-жол.

a := Тізім ← ['hello'] ; ['world'] ; Ақиқат ; Бос ; 666. 
a := a + ( Тізім ← 1 ).
Шығыс жазу: a, жаңа-жол.
Шығыс жазу: ((Сөздік жаңа) қою: Бос кілт: Бос), жаңа-жол.
Шығыс жазу: a sum, жаңа-жол. 


{
	a келгенде: ['мәтін'] орында: { <- Бос. }.
	a := [''] + a.
} ұстау: { :error
	Шығыс жазу: ['Error noted: '] + error, жаңа-жол.
}, іске-қосу.



{
	a келгенде: ['сан'] орында: { <- Бос. }.
	a := 3 × a.
} ұстау: { :error
	Шығыс жазу: ['Error noted: '] + error, жаңа-жол.
}, іске-қосу.


{
	a келгенде: ['логикалық'] орында: { <- Бос. }.
	a := Ақиқат және: a. 
} ұстау: { :error
	Шығыс жазу: ['Error noted: '] + error, жаңа-жол.
}, іске-қосу.





