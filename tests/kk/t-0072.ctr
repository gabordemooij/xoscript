>> echo := Нысан жаңа.
echo келгенде: ['жауап:'] орында: { :sound
	{ Шығыс жазу: sound. } × 2.
}.
echo ho!. 


echo := Нысан жаңа.
echo келгенде: ['жауап:және:'] орында: { :sound :x
	{ Шығыс жазу: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := Нысан жаңа.
echo келгенде: ['жауап:және:және:'] орында: { :operation :sound :x
	{ Шығыс жазу: sound. } × x.
}.
echo shout: ['la'] times: 4. 


