>> invoice := Нысан жаңа.
invoice келгенде: ['іске-қосу'] орында: {
        өзінің сан := 0.
}.

invoice келгенде: ['сан'] орында: {
        өзінің сан қосу: 1. <- өзінің сан көшіру.
}.

>> year-invoice := invoice жаңа.
year-invoice келгенде: ['start:'] орында: { :жыл
	өзінің сан := жыл.
}.

year-invoice start: 202000.
Шығыс жазу: year-invoice сан, жаңа-жол.
Шығыс жазу: year-invoice сан, жаңа-жол.
