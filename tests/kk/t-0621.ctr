>> phrases := Тізім жаңа
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases әрбір: { :_ :phrase 
	>> e := Server base64-кодтау: phrase.
	>> d := Server base64-декодтау: e.
	Шығыс жазу: (
		message көшіру ~encoded: e, ~decoded: d
	), жаңа-жол.
}.
