Сан келгенде: ['factorial'] орында: {
	>> total := 1.
	{ :index total көбейту: (өзі - (index)). } × өзі. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Шығыс жазу: a.
>> b := 2 + 3 factorial.
Шығыс жазу: b.
>> c := 3 factorial + 2.
Шығыс жазу: c.
>> d := 2 + (3 factorial).
Шығыс жазу: d.
Шығыс жазу: 2 + 3 factorial + 1.
