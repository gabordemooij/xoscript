>> numbers := ['1,2,3'] бөлу: [','].
Шығыс жазу: ['I got: '] + numbers саны + [' numbers.'],жаңа-жол.
{ :i Шығыс жазу: ['number #'] + i + [':'] + (numbers орын: i), жаңа-жол.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages бөлу: [' Or '].
Шығыс жазу: ['We serve'], жаңа-жол.
{ :i Шығыс жазу: ['->'] + (beverages орын: i), жаңа-жол. } × (beverages саны).
Шығыс жазу: (beverages біріктіру: [',']), жаңа-жол.
Шығыс жазу: (numbers біріктіру: ['||']).
