

>> Matryoshka := Нысан жаңа.
Matryoshka келгенде: ['double:'] орында: { :secret
	өзінің secret := secret × 2.
}.
Matryoshka келгенде: ['жаңа:'] орында: { :secret
	>> answer := Бос.
	>> t := (secret > 255).
	Шығыс жазу: (secret + [' | '] + t), жаңа-жол.
	t ақиқат-болса: {
		answer := secret.
	}, әйтпесе: {
		answer := Matryoshka рекурсивті жаңа: (өзі double: secret).
	}. <- answer.
}.

>> x := Matryoshka жаңа: 2.
