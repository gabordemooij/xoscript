
>> countries := Тізім жаңа
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Тізім жаңа
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods бойынша: countries, әрбір: { :key :value
	counter қосу: 1.
}.

Шығыс жазу: (['we serve counter dishes'] counter: counter), жаңа-жол.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] таңбалар сұрыптау: { :v
	counter қосу: 0.
}.

Шығыс жазу: (['we sort counter dishes'] counter: counter), жаңа-жол.


>> counter := 0.
{
	{
		counter қосу: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Шығыс жазу: (['we calculate counter numbers.'] counter: counter), жаңа-жол.

