>> Greeter := Нысан жаңа.
Greeter келгенде: ['make'] орында: {
	>> greeter := Нысан жаңа.
	greeter келгенде: ['name:'] орында: { :атау
		Шығыс жазу: ['setting a name'].
		өзінің myName := атау.
	}.
	greeter келгенде: ['greet'] орында: {
		Шығыс жазу: ['Hello'].
		Шығыс жазу: өзінің myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
