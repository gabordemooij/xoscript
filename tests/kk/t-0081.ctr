>> map1 := Сөздік жаңа.
>> key1 := Тізім жаңа.
>> key2 := Тізім жаңа.

map1
	қою: ['hello'] кілт: key1,
	қою: ['world'] кілт: key2.


Шығыс
	жазу: ['Map #1 contains: '] + (map1 орнында: key1),
	жазу: [' and '] + (map1 орнында: key2), жаңа-жол.

>> KeyeableArray := Тізім жаңа.
KeyeableArray келгенде: ['toString'] орында: { <- (өзі саны) toString.
}.

>> map2 := Сөздік жаңа.
key1 := KeyeableArray жаңа.
key2 := KeyeableArray жаңа.

key1 соңына-қосу: 1.

map2
	қою: ['hello'] кілт: key1,
	қою: ['world'] кілт: key2.

Шығыс
	жазу: ['Map #2 contains: '] + (map2 орнында: key1),
	жазу: [' and '] + (map2 орнында: key2), жаңа-жол.
