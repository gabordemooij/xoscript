


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Бағдарлама жадты-басқару: 0.
>> palette := Бос.
>> colors := Бос.

{
palette := Сөздік жаңа.
palette 
	қою: ['#F00'] кілт: ['red'],
	қою: ['#0F0'] кілт: ['green'],
	қою: ['#00F'] кілт: ['blue'].
Шығыс жазу: ['number of RGB codes in palette: '] + ( palette саны ), жаңа-жол.
Шығыс жазу: ['RGB code of green is: '] + ( palette ? ['green'] ), жаңа-жол.
colors := [''].
( palette әрбір: { :атау :код
		colors := colors + ( атау + [':'] + код ).
} ).
Шығыс жазу: ['All colors in palette: '] + colors, жаңа-жол.
} іске-қосу.
Бағдарлама тазалау.
usedMemory1 := (Бағдарлама жад ? 0).

