{
	осы-тапсырма қате: ['Dont fail.'].
	unknown doSomething.
} ұстау: {
	Шығыс жазу: ['Caught!'].
}, іске-қосу.

{
	осы-тапсырма қате: ['Dont fail.'].
	өзінің unknown doSomething.
} ұстау: {
	Шығыс жазу: ['Caught!'].
}, іске-қосу.

{
	осы-тапсырма қате: ['Dont fail.'].
	unknown := 122.
} ұстау: {
	Шығыс жазу: ['Caught!'].
}, іске-қосу.


{
	осы-тапсырма қате: ['Dont fail.'].
	Ақиқат үзу.
	Шығыс жазу: ['FAIL'].
} ұстау: {
	Шығыс жазу: ['Caught!'].
}, іске-қосу.

{
	{
		осы-тапсырма қате: ['Dont fail.'].
		Ақиқат үзу.
		Шығыс жазу: ['FAIL'].
	} ұстау: { :x
		(x = ['Dont fail.']) ақиқат-болса: { осы-тапсырма қате: ['Nested Caught!']. }.
	}, іске-қосу.
} ұстау: { :e
	Шығыс жазу: e.
}, іске-қосу.
