>> str := ['write:'].
Шығыс хабар: ['жазу:'] аргументтер: (Тізім ← ['Hello World']), жаңа-жол. 

Сан келгенде: ['isbetween:and:'] орында: { :a :b <- ((өзі ≥ a) және: (өзі ≤ b)).
}.

str := ['isbetween:and:'].
Шығыс жазу: (3 хабар: str аргументтер: (Тізім ← 2 ; 8)), жаңа-жол.
Шығыс жазу: (3 хабар: str аргументтер: (Тізім ← 1 ; 2)), жаңа-жол.


>> CoffeeMachine := Нысан жаңа.
CoffeeMachine келгенде: ['makeCoffeeWithSugar:milk:'] орында: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Тізім ← 4 ; 2.
Шығыс жазу: ( CoffeeMachine хабар: order аргументтер: coffeeConfiguration ), жаңа-жол.
