#Linux

(Файл жаңа: ['/tmp/testje']) бар жалған-болса: {
	Бағдарлама жүйе: ['mkdir /tmp/testje'].	
}.

(Файл жаңа: ['/tmp/testje/file1']) бар жалған-болса: {
	Бағдарлама жүйе: ['touch /tmp/testje/file1'].	
}.

(Файл жаңа: ['/tmp/testje/folder1']) бар жалған-болса: {
	Бағдарлама жүйе: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Файл тізім: ['/tmp/testje'].

>> q := Тізім жаңа.

l әрбір: { :k :v v әрбір: { :x :y q соңына-қосу: y. }. }.

>> s := q мәтін.

(s қамтиды: ['file1']) ақиқат-болса:   { Шығыс жазу: ['OK'], жаңа-жол. }.
(s қамтиды: ['file2']) ақиқат-болса:   { Шығыс жазу: ['XX'], жаңа-жол. }.
(s қамтиды: ['folder1']) ақиқат-болса: { Шығыс жазу: ['OK'], жаңа-жол. }.
