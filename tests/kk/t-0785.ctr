Шығыс жазу: ['Test object'], жаңа-жол.
>> a := Нысан жаңа. 

a келгенде: ['item:'] орында: { :moment
	өзінің moment := moment. 
}.

a келгенде: ['item'] орында: { <- өзінің moment.
}.

>> today := Тізім жаңа ; ( Сәт жаңа уақыт-белдеуі: ['CEST'], жыл: 2026, ай: 7 ).
a item: today.
Шығыс жазу: a item ? 0, жаңа-жол.
a save-as: ['/tmp/a.bin'].
