Server init.

Шығыс жазу: (
	Үлгі жаңа: ['^\\w+$'],
	сәйкестік: ['test@example.com'] 
), жаңа-жол. # 0 match, fails on @ and .

Шығыс жазу: (
	Үлгі жаңа: ['^[^@]+@[^\.]+\.\\w+$'],
	сәйкестік: ['test@example.com'] 
), жаңа-жол. # 1 match

Шығыс жазу: (
	Үлгі жаңа: ['[^@]+@[^\.]+\.\\w+'],
	сәйкестік: ['test@example.com'] 
), жаңа-жол. # 1 match

Шығыс жазу: (
	Үлгі жаңа: ['([^@]+)@([^\.]+)\.\\w+'],
	сәйкестік: ['test@example.com'] 
), жаңа-жол. # 1 match, groups dont matter

Шығыс жазу: (
	Үлгі жаңа: ['[a-z]'],
	сәйкестік: ['test@example.com'] 
), жаңа-жол. # 14 matches

Шығыс жазу: (
	Үлгі жаңа: ['.*'],
	сәйкестік: ['test@example.com'] 
), жаңа-жол. # 1 match (all)

Шығыс жазу: (
	Үлгі жаңа: ['(.*)'],
	сәйкестік: ['test@example.com'] 
), жаңа-жол. # 1 match (all)

Шығыс жазу: (
	Үлгі жаңа: ['\\s*[^@]+@[^\.]+\.\\w+'],
	сәйкестік: ['test@example.com'] 
), жаңа-жол. # 1 match, prefix space optional, gets ignored