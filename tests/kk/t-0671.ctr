# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Сейф кілттер-жасау.

# private (secret) key
>> sk := keys бірінші.

# public key
>> pk := keys соңғы.

# sign a message
>> sig := Сейф қол-қою: ['abc'] кілтпен: sk.

# check message (ok)
Шығыс жазу: ( 
	Сейф
		тексеру: ['abc'] 
		қолтаңба: sig 
		кілтпен: pk 
), жаңа-жол.

# check message (fail)
Шығыс жазу: ( 
	Сейф 
		тексеру: ['abd'] 
		қолтаңба: sig 
		кілтпен: pk 
), жаңа-жол.