>> Greeter := Нысан жаңа.
Greeter келгенде: ['make'] орында: {
	>> gr := Нысан жаңа.
	gr келгенде: ['setName:'] орында: { :aname
		өзінің атау := aname.
	}.
	gr келгенде: ['greet'] орында: {
		Шығыс жазу: өзінің атау.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a жаңа.
c setName: ['THREE'].
c greet.
>> d := a жаңа.
d setName: ['FOUR'].
d greet.
c greet.
