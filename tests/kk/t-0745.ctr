Шығыс жазу: ['Test object'], жаңа-жол.
>> a := Нысан жаңа. 

a келгенде: ['item:'] орында: { :dict
	өзінің dict := dict. 
}.

a келгенде: ['item'] орында: { <- өзінің dict.
}.

a item: (
Сөздік жаңа
	hello: ['world']).

>> old-dict-address := a item прототип жад-мекенжайы.
a save-as: ['/tmp/a.bin'].
Шығыс жазу: ['========== RELOADING SNAP:'], жаңа-жол.

>> b := Нысан load-from: ['/tmp/a.bin'].

(b item прототип жад-мекенжайы = old-dict-address) ақиқат-болса: {
	Шығыс жазу: ['Object link re-attached.'], жаңа-жол.
}.

Шығыс жазу: b item, жаңа-жол.
