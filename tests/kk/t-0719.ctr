Server init.
>> fmt := Пішім жаңа: ['%#3x'].

>> blob := Blob жаңа: 4.
blob bytes: ( 
	Тізім жаңа ; 0 ; 1 ; 2 ; 3
).

>> file := Файл жаңа: ['/tmp/blob'].
file blob: blob.
blob босату.

>> оқу := file blob.
оқу 
бастап: 0 
ұзындық: 4, 
тізбек-басы әрбір: { :i :b 
	Шығыс
	жазу: (fmt қолдану-бүтін: b),
	жаңа-жол.
}.
оқу босату.
