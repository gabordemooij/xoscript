Server init.

>> db := Maria-DB жаңа хост: ['localhost'],
	пайдаланушы-аты: ['xo'],
	құпиясөз: ['pass123'],
	дерекқор-атауы: ['xobase'],
	қосылу.

>> del := db сұрау: ['DELETE FROM book WHERE id > 0'].
{  del орындау. db бекіту. } ұстау: { :e db кері-қайтару.  }, іске-қосу.

>> саны := db сұрау: ['SELECT COUNT(*) AS num FROM book'].
саны алу: { :row Шығыс жазу: row num, жаңа-жол. }.
