# test list operations


>> cakes := Тізім ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes ауыстыру: 1 ұзындық: 2 мынаған: ( Тізім ← ['cinnamon'] ; ['pineapple'] ).
Шығыс жазу: (buy біріктіру: [',']), жаңа-жол.


>> buy := cakes ауыстыру: 1 ұзындық: 12 мынаған: ( Тізім ← ['cinnamon'] ; ['pineapple'] ).
Шығыс жазу: (buy біріктіру: [',']), жаңа-жол.


