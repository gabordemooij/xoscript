Шығыс жазу: ['Test object'], жаңа-жол.
>> a := Нысан жаңа. 

a келгенде: ['state:'] орында: { :list
	өзінің list := list. 
}.

a келгенде: ['state'] орында: {
	Шығыс жазу: өзінің list, жаңа-жол.
}.

a state: ( Тізім жаңа ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
Шығыс жазу: ['========== RELOADING SNAP:'], жаңа-жол.
>> b := Нысан load-from: ['/tmp/a.bin'].
b state.