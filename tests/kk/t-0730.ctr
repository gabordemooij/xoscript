Шығыс жазу: ['Test object'], жаңа-жол.
>> a := Нысан жаңа. 

a келгенде: ['item:'] орында: { :moment
	өзінің moment := moment. 
}.

a келгенде: ['item'] орында: { <- өзінің moment.
}.

>> today := Сәт жаңа уақыт-белдеуі: ['CEST'], жыл: 2026, ай: 7.
a item: today.
Шығыс жазу: a item, жаңа-жол.
a save-as: ['/tmp/a.bin'].
Шығыс жазу: ['========== RELOADING SNAP:'], жаңа-жол.
>> b := Нысан load-from: ['/tmp/a.bin'].
Шығыс жазу: b item, жаңа-жол.
