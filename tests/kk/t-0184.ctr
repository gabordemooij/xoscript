

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Бағдарлама жадты-басқару: 0.

Сан келгенде: ['addNum:'] орында: { :x
	өзі қосу: x.
}.

Сан келгенде: ['subtractNum:'] орында: { :x
	өзі азайту: x.
}.

Сан келгенде: ['multiplyBy:'] орында: { :x
	өзі көбейту: x.
}.

Сан келгенде: ['divideBy:'] орында: { :x
	өзі бөлу-санға: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 дәреже: 8).  
a := a + (2 дәреже: -1). 
a := a + (49 квадрат-түбір).   
a addNum: ((Тізім ← 0 ; 1) ең-үлкен).          
a addNum: ((Тізім ← 2 ; 3) ең-кіші).
Шығыс жазу: a.

Бағдарлама тазалау.

usedMemory1 := (Бағдарлама жад ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 дәреже: 8).  
a := a + (2 дәреже: -1). 
a := a + (49 квадрат-түбір).   
a addNum: ((Тізім ← 0 ; 1) ең-үлкен).          
a addNum: ((Тізім ← 2 ; 3) ең-кіші).
Шығыс жазу: a.

Бағдарлама тазалау.
usedMemory2 := (Бағдарлама жад ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 дәреже: 8).  
a := a + (2 дәреже: -1). 
a := a + (49 квадрат-түбір).   
a addNum: ((Тізім ← 0 ; 1) ең-үлкен).          
a addNum: ((Тізім ← 2 ; 3) ең-кіші).
Шығыс жазу: a.

Бағдарлама тазалау.
usedMemory3 := (Бағдарлама жад ? 0).



( usedMemory1 = usedMemory2 және: usedMemory1 = usedMemory3, және: usedMemory2 = usedMemory3 ) ақиқат-болса: {
	Шығыс жазу: ['No memory leaks here'].
}, жалған-болса: {
	Шығыс жазу: ['Leaking memory...'].
}.
