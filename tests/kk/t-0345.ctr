# test catch-all methods
>> x13 := Нысан жаңа.
x13 келгенде: ['a'] орында: { :a Шығыс жазу: 0, жаңа-жол. }.
x13 келгенде: ['a:'] орында: { :a Шығыс жазу: a, жаңа-жол. <- 5. }.
x13 келгенде: ['a:b:'] орында: { :a :b Шығыс жазу: (a + b), жаңа-жол. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
