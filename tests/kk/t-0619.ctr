>> HTML := Нысан жаңа.
HTML келгенде: ['жауап:'] орында: { :tag 
	Шығыс жазу: (['<tag>'] tag: tag), жаңа-жол.
}.
HTML келгенде: ['жауап:және:'] орында: { :tag :html 
	Шығыс жазу: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), жаңа-жол.
}.
>> html := HTML жаңа.
html body h1: ['header'].

