


>> CoffeeMachine := Нысан жаңа.
CoffeeMachine келгенде: ['order:'] орында: { :id
	>> coffee := ['Americano'].
	( id = 1 ) ақиқат-болса: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) ақиқат-болса: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) ақиқат-болса: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Нысан жаңа.
SimpleCoffeeMachine келгенде: ['order'] орында: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Шығыс жазу: redCup, жаңа-жол.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Шығыс жазу: greenCup, жаңа-жол.
>> yellowCup := CoffeeMachine order: 1.
Шығыс жазу: yellowCup, жаңа-жол.
>> blueCup := CoffeeMachine order: 0.
Шығыс жазу: blueCup, жаңа-жол.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Шығыс жазу: blackCup, жаңа-жол.
blackCup соңына-қосу: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Шығыс жазу: orangeCup, жаңа-жол.
