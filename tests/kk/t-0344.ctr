# catch-all test (practical)
>> HTML := Мәтін жаңа.
HTML келгенде: ['encode:'] орында: { :tekst
	өзі соңына-қосу: (tekst
	ауыстыру: ['&'] мынаған: ['&amp;'], 
	ауыстыру: ['<'] мынаған: ['&lt;'],
	ауыстыру: ['>'] мынаған: ['&gt;'],
	ауыстыру: ['"'] мынаған: ['&quot;']).
}.
>> blog := HTML жаңа.
blog соңына-қосу: ['<h1>'],
     encode: ['Koffie & Thee'],
     соңына-қосу: ['</h1>'].
Шығыс жазу: blog, жаңа-жол.


>> Roman := Сан жаңа.
Roman келгенде: ['stringy'] орында: {
	>> a := [''].
	{ a соңына-қосу: ['I']. } × өзі. <- a.
}.

>> x := Roman жаңа.
x қосу: 3.
Шығыс жазу: x stringy, жаңа-жол.

>> Quantum := Логикалық жаңа.
Quantum келгенде: ['true?'] орында: { <- ['maybe True']. }.
Шығыс жазу: (Quantum жаңа true?), жаңа-жол.

>> Nihil := Бос жаңа.
Nihil келгенде: ['мәтін'] орында: { <- ['Nihil']. }.
Шығыс жазу: (Nihil жаңа), жаңа-жол.
