#Linux

 >> t := Сәт жаңа.
 
t уақыт-белдеуі: ['Europe/Amsterdam'].
t жыл: 2020, ай: 8, күн: 2, сағат: 21, минут: 2, секунд: 1.

>> a := t сағат.
>> ams := t уақыт-белдеуі.

t уақыт-белдеуі: ['US/Hawaii'].
>> b := t сағат.
>> hw := t уақыт-белдеуі.

Шығыс
жазу: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		бұл: ['later'] не-ол: ['earlier']
	)
),
жаңа-жол.
 