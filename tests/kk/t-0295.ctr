
>> dictionary := (
	Сөздік жаңа
		қою: ['b'] кілт: ['a'],
		қою: ['a'] кілт: ['b'],
		қою: ['z'] кілт: ['x'],
		қою: ['hello'] кілт: ['hallo'],
		қою: ['human'] кілт: ['human']
).

>> comparisons := Тізім жаңа.
dictionary әрбір: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a салыстыру: b)
	).
}.

comparisons сұрыптау: { :a :b <- ( a салыстыру: b ). }.
Шығыс жазу: ( comparisons біріктіру: ['↵'] ), жаңа-жол.
comparisons біріктіру: ['↵'].
