

Мәтін келгенде: ['evaluate'] орында: {
	>> код := Файл жаңа: ['/tmp/eval.ctr'].
	код жазу: (өзі мәтін + ['.']).
	Бағдарлама пайдалану: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Тізім ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q мәтін.
Шығыс жазу: x, жаңа-жол.
>> y := Бос.
(['y := '] + x ) evaluate.
Шығыс жазу: y ? 0, жаңа-жол.

q := Сөздік қою: ['\[''] кілт: ['\['quote\']'].
x := q мәтін.
Шығыс жазу: x, жаңа-жол.
y := Бос.
(['y := '] + x ) evaluate.

>> q := (Сөздік жаңа) қою:['\[''] кілт:['\['quote\[''].
Шығыс жазу: y ? ['\['quote\']'], жаңа-жол.
