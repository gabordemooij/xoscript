>> Grandfather := Нысан жаңа.
Grandfather келгенде: ['greet'] орында: {
	Шығыс жазу: ['Ave!'], жаңа-жол.
}.
>> Father := Grandfather жаңа.
Father келгенде: ['greet'] орында: {
	Шығыс жазу: ['Hello'], жаңа-жол.
	өзі greet.
}.
>> Son := Father жаңа.
Son келгенде: ['greet'] орында: {
	Шығыс жазу: ['Hi'], жаңа-жол.
	өзі greet.
}.

Son greet.

>> Roundabout := Нысан жаңа.
Roundabout келгенде: ['circle:'] орында: { :x
	Шығыс жазу: x, жаңа-жол.
	(x < 3) ақиқат-болса: { өзі рекурсивті circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) ақиқат-болса: { Шығыс жазу: x, жаңа-жол. x қосу: 1.  increment іске-қосу. }. }.
increment іске-қосу.