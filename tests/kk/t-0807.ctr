# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB жаңа хост: ['localhost'],
	пайдаланушы-аты: ['xo'],
	құпиясөз: ['pass123'],
	дерекқор-атауы: ['xobase'],
	қосылу.

>> іздеу-параметрлері := db сұрау: ['SELECT %% FROM'].
{ іздеу-параметрлері орындау. } ұстау: { :e
	Шығыс жазу: ( e қамтиды: ['%%'] ), жаңа-жол.
}, іске-қосу.
