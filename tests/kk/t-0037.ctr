>> a := 3.
>> b := a көшіру.
a азайту: 1.
Шығыс жазу: [' a = '] + a.
Шығыс жазу: [' b = '] + b.
a := 3.
b := a + 4.
Шығыс жазу: [' a = '] + a.
Шығыс жазу: [' b = '] + b.
>> x := 3.
>> y := x көшіру.
x қосу: 10.
y азайту: 1.
Шығыс жазу: [' x = '] + x.
Шығыс жазу: [' y = '] + y.
>> q := Нысан жаңа.
q келгенде: ['setProperty:'] орында: { :x
	өзінің prop := x.
}.
q келгенде: ['getProperty'] орында: { <- өзінің prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Шығыс жазу: [' p = '] + (p getProperty).
