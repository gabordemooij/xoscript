#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Үлгі жаңа: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern сәйкестік: subject орында: { :m :x
	Шығыс жазу: m, жаңа-жол.
	Шығыс жазу: x, жаңа-жол. <- ['XXX'].
}.
Шығыс жазу: result, жаңа-жол.