
Server init.
Шығыс жазу: ['Database test'], жаңа-жол.

>> db := Maria-DB жаңа хост: ['localhost'],
	пайдаланушы-аты: ['xo'], 
	құпиясөз: ['pass123'],
	дерекқор-атауы: ['xobase'],
	қосылу.

>> іздеу-параметрлері :=
db сұрау: ['SELECT UNHEX('CAFE') AS blobby'],
алу: { :row
	Шығыс жазу: ( row blobby бастап: 0 ұзындық: 2 ), жаңа-жол.
	row blobby босату.
}.
