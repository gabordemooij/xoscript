>> makeAdder := { :x
	>> f := { :y <- (өзінің x + y). } орнату: ['x'] мән: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i өзінің q қою: (өзінің f қолдану: (өзінің q ? i)) кілт: i. } 
	орнату: ['q'] мән: array,
	орнату: ['f'] мән: func.
	{ :i mapping қолдану: i. } × (array саны).
}.

>> a := Тізім ← 1; 2; 3.
mapper қолдану: a және: (makeAdder қолдану: 100).
Шығыс жазу: (a орын: 0), жаңа-жол.
Шығыс жазу: (a ? 1), жаңа-жол.
Шығыс жазу: (a ? 2), жаңа-жол.
