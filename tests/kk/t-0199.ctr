
Бағдарлама жадты-басқару: 4.

>> Animal := Нысан жаңа.
Animal келгенде: ['make'] орында: {
	>> animal := Нысан жаңа.
	animal келгенде: ['makeSound'] орында: {
		Шығыс жазу: өзінің sound.
	}. <- animal.
}.
>> Cat := Нысан жаңа.
Cat келгенде: ['make'] орында: {
	>> cat := Animal make.
	cat келгенде: ['init'] орында: {
		өзінің sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
