Бағдарлама жадты-басқару: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } ұстау: {
		oops қосу: 1.
	}, іске-қосу.
} × 1000.

{
	Шығыс жазу: ['hi there!'].
	осы-тапсырма қате: ['oops'].
	Шығыс жазу: ['hi there!'].
	{ Шығыс жазу: ['dont print this']. } іске-қосу.
} ұстау: { :e 
	Шығыс жазу: ['got ya!']. 
	Шығыс жазу: e.
}, іске-қосу.
