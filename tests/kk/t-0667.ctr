# test Program version

# this feature is disabled by default
Шығыс жазу: (
	Бағдарлама мүмкіндік: 
	['RECURSIVE_STRINTPOL']
), жаңа-жол.


# but if we set the time back
>> today := Сәт 
уақыт-белдеуі: ['CEST'],
көзі: ['2026-02-15 10:00:00'].
Бағдарлама нұсқа: today.

# it will be enabled like it used to be (from now on)
Шығыс жазу: (
	Бағдарлама мүмкіндік: 
	['RECURSIVE_STRINTPOL']
), жаңа-жол.