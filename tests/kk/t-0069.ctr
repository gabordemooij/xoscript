

Мәтін келгенде: ['html'] орында: { <- (
		өзі
		ауыстыру: ['&'] мынаған: ['&amp;'],
		ауыстыру: ['<'] мынаған: ['&lt;'],
		ауыстыру: ['>'] мынаған: ['&gt;'],
		ауыстыру: ['"'] мынаған: ['&quot;']
	).
}.


Шығыс жазу: ([' left trimmed '] қию) + [' '] + ( ['and right trimmed'] қию) + ['!'], жаңа-жол.
Шығыс жазу: ['<html>"html & entities"</html>'] html.
