>> items := Сөздік жаңа.
items қою: ['black'] кілт: ['coffee'], қою: ['earl grey'] кілт: ['tea'].
Шығыс жазу: (items орнында: ['coffee']), жазу: (items орнында: ['tea']).
Шығыс жазу: ['there are'] + items саны + [' items in the array.'].
items қою: ['capuccino'] кілт: ['coffee'].
Шығыс жазу: ['Now my coffee is.. '] + (items орнында: ['coffee']).
items қою: ['aaa'] кілт: ['1'].
items қою: ['bbb'] кілт: ['2'].
Шығыс жазу: (items орнында: ['a']).
