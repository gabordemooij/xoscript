# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> жол := ['/tmp/dat.csv'].
>> csv := Файл жаңа: жол.
csv жазу: s.

# accepts CRLF LF CR, varying row length
csv бөлгіш: [';'] тырнақша: ['"'] жолдар: { :line
	Бағдарлама тазалау.
	Шығыс жазу: line, жаңа-жол.
	Бағдарлама тазалау.
}.

# unequal lines
s соңына-қосу: ['\njustone'].
csv жазу: s.
{
	csv бөлгіш: [';'] тырнақша: ['"'] жолдар: { :line
		Шығыс жазу: line, жаңа-жол.
	}.
} ұстау: { :e 
	Шығыс жазу: e, жаңа-жол.
}, іске-қосу.

# invalid format
s := ['"he"llo";world'].
csv жазу: s.
{
	csv бөлгіш: [';'] тырнақша: ['"'] жолдар: { :line
		Шығыс жазу: line, жаңа-жол.
	}.
} ұстау: { :e 
	Шығыс жазу: e, жаңа-жол.
}, іске-қосу.
