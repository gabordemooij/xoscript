# test buffers PKI/Sign 
Server init.

>> long := ( Тізім жаңа толтыру: 1000 мәнмен: ['a'] ) біріктіру: [''].

# sign a message
Шығыс жазу: ( 
	Сейф қол-қою: ['abc'] кілтпен: long
), жаңа-жол.

Шығыс жазу: ( 
	Сейф
		тексеру: ['abc'] 
		қолтаңба: long 
		кілтпен: long
), жаңа-жол.

Шығыс жазу: (
	Сейф құпиясөз-хэші: long тексеру: long
), жаңа-жол.
