Шығыс жазу: ['1,2,3,4,5,6,7,8,9,A,'], жаңа-жол.
>> Scope := Нысан жаңа.
Scope келгенде: ['initialize:'] орында: { :x өзінің property := x. }.
Scope келгенде: ['confirm'] орында: { Шығыс жазу: [',']. }.
Scope келгенде: ['сынақ'] орында: {
	Шығыс жазу: өзінің property.
	өзі confirm.
	( 1 = 1 ) ақиқат-болса: { Шығыс жазу: өзінің property. өзі confirm. }.
	( 1 = 0 ) жалған-болса: { Шығыс жазу: өзінің property. өзі confirm. }.
	>> y := 2. { Шығыс жазу: өзінің property. өзі confirm. } әзірше: { y азайту: 1. <- (y > 0). }.
	{ Шығыс жазу: өзінің property. өзі confirm. } × 1.
	(Тізім ← 1) әрбір: {  Шығыс жазу: өзінің property. өзі confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Сөздік жаңа one: ['item']) әрбір: { Шығыс жазу: өзінің property. өзі confirm. }.
	{ 1 ÷ 0. } ұстау: { Шығыс жазу: өзінің property. өзі confirm. }, іске-қосу.
	Шығыс жаңа-жол.
}.
>> scope1 := Scope жаңа.
scope1 initialize: ['X'].
scope1 сынақ.
>> function := { 
	өзінің property := ['Y'].
	Шығыс жазу: өзінің property.
	өзі confirm.
	( 1 = 1 ) ақиқат-болса: { Шығыс жазу: өзінің property. өзі confirm. }.
	( 1 = 0 ) жалған-болса: { Шығыс жазу: өзінің property. өзі confirm. }.
	>> y := 2. { Шығыс жазу: өзінің property. өзі confirm. } әзірше: { y азайту: 1. <- (y > 0). }.
	{ Шығыс жазу: өзінің property. өзі confirm. } × 1.
	(Тізім ← 1) әрбір: {  Шығыс жазу: өзінің property. өзі confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Сөздік жаңа one: ['item']) әрбір: { Шығыс жазу: өзінің property. өзі confirm. }.
	{ 1 ÷ 0. } ұстау: { Шығыс жазу: өзінің property. өзі confirm. }, іске-қосу.
	Шығыс жаңа-жол.
}.
function келгенде: ['confirm'] орында: { Шығыс жазу: [',']. }.
function қолдану: 1 және: 2.
