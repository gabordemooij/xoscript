# backslashes must survive code serialization, strings must not end early
>> мәндер := Тізім жаңа
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

мәндер әрбір: { :i :value
	>> d := Сөздік жаңа.
	d қою: value кілт: ['k'].
	>> r := d код нысан.
	Шығыс жазу: r саны, жаңа-жол.
	Шығыс жазу: ( (r орнында: ['k']) = value ), жаңа-жол.
}.
