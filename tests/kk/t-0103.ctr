>> a := Тізім ← Нысан ; Ақиқат ; Жалған ; Логикалық ; 1 ; Сан ; ['Str'] ; Мәтін ; { ['Empty']. }.
Шығыс жазу: (a саны), жаңа-жол.
{ :i
	Шығыс жазу: 
	['a '] + 
	((a ? i) түр) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Бос?) бұл: [''] не-ол: ['NOT']) + 
	[' Nil.'],
	жаңа-жол.
} × (a саны).
Шығыс жазу: ['but.. Nil is.. '] + ((Бос Бос?) бұл: ['certainly NIL!'] не-ол: ['not NIL??']), жаңа-жол.