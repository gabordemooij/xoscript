

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Бағдарлама жадты-басқару: 0.

>> f := Файл жаңа: ['/tmp/citrine_test_file.txt'].
f exists: { f жою. }.
f жазу: ['hello world'].
>> q := f өлшем.
Шығыс жазу: q, жаңа-жол.

f := Файл жаңа: ['/tmp/citrine_test_file.txt'].
q := f өлшем.
Шығыс жазу: q, жаңа-жол.

Бағдарлама тазалау.
usedMemory1 := (Бағдарлама жад ? 0).


f := Файл жаңа: ['/tmp/citrine_test_file.txt'].
q := f өлшем.
Шығыс жазу: q, жаңа-жол.

Бағдарлама тазалау.
usedMemory2 := (Бағдарлама жад ? 0).


f := Файл жаңа: ['/tmp/citrine_test_file.txt'].
q := f өлшем.
Шығыс жазу: q, жаңа-жол.

Бағдарлама тазалау.
usedMemory3 := (Бағдарлама жад ? 0).



( usedMemory1 = usedMemory2 және: usedMemory1 = usedMemory3, және: usedMemory2 = usedMemory3 ) ақиқат-болса: {
	Шығыс жазу: ['No memory leaks here'].
}, жалған-болса: {
	Шығыс жазу: ['Leaking memory...'].
}.
