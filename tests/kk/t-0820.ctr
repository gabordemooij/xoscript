# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Үлгі жаңа: pattern.
	p сәйкестік: subject орында: { :m :g
		Шығыс жазу: g саны, жазу: [' '], жазу: (g біріктіру: ['|']), жаңа-жол. <- m.
	}.
}.
show қолдану: ['(a)|(b)'] және: ['b'].
show қолдану: ['(a)|(b)'] және: ['a'].
show қолдану: ['(x)?y'] және: ['y'].
show қолдану: ['(x)?(y)(z)?'] және: ['xy'].
