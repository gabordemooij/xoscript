Шығыс жазу: ['Test object'], жаңа-жол.
>> a := Нысан жаңа. 
a келгенде: ['item:'] орында: { :lst
	өзінің lst := lst. 
}.
a келгенде: ['item'] орында: { <- өзінің lst.
}.
a item: (
	Тізім жаңа ; 1 ; (
		Тізім жаңа ; ['a'] ; (
			Тізім жаңа ; ( Сәт жаңа: 1 )
		) ; ( Int64 мәтіннен: ['321'] )
	)
).
Шығыс жазу: a item, жаңа-жол.
>> old-lst-address := a item прототип жад-мекенжайы.
a save-as: ['/tmp/a.bin'].
Шығыс жазу: ['========== RELOADING SNAP:'], жаңа-жол.
>> b := Нысан load-from: ['/tmp/a.bin'].
(b item прототип жад-мекенжайы = old-lst-address) ақиқат-болса: {
	Шығыс жазу: ['Object link re-attached.'], жаңа-жол.
}.
Шығыс жазу: ( b item ), жаңа-жол.
