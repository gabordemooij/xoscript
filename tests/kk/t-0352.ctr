Сан келгенде: ['roman'] орында: {
	>> сан := өзі көшіру.
	>> roman := [''].
	{
		{
			(сан ≥ 1000) ақиқат-болса: {
				roman соңына-қосу: ['Ⅿ'].
				сан азайту: 1000.
			}, үзу.
		
			(сан ≥ 500) ақиқат-болса: {
				roman соңына-қосу: ['Ⅾ'].
				сан азайту: 500.
			}, үзу.
		
			(сан ≥ 100) ақиқат-болса: {
				roman соңына-қосу: ['Ⅽ'].
				сан азайту: 100.
			}, үзу.
		
			(сан ≥ 50) ақиқат-болса: {
				roman соңына-қосу: ['Ⅼ'].
				сан азайту: 50.
			}, үзу.
		
			(сан ≥ 50) ақиқат-болса: {
				roman соңына-қосу: ['Ⅼ'].
				сан азайту: 50.
			}, үзу.
		
			(сан ≥ 10) ақиқат-болса: {
				roman соңына-қосу: ['Ⅹ'].
				сан азайту: 10.
			}, үзу.
			
			(сан ≥ 9) ақиқат-болса: {
				roman соңына-қосу: ['Ⅸ'].
				сан азайту: 9.
			}, үзу.
			
			(сан ≥ 5) ақиқат-болса: {
				roman соңына-қосу: ['Ⅴ'].
				сан азайту: 5.
			}, үзу.
			
			(сан ≥ 4) ақиқат-болса: {
				roman соңына-қосу: ['Ⅳ'].
				сан азайту: 4.
			}, үзу.
			
			(сан ≥ 1) ақиқат-болса: {
				roman соңына-қосу: ['Ⅰ'].
				сан азайту: 1.
			}, үзу.
		} процедура.
	} әзірше: { <- сан > 0. }. <- roman.
}.

Шығыс жазу: 1 roman, жаңа-жол.
Шығыс жазу: 2 roman, жаңа-жол.
Шығыс жазу: 4 roman, жаңа-жол.
Шығыс жазу: 8 roman, жаңа-жол.
Шығыс жазу: 16 roman, жаңа-жол.
Шығыс жазу: 32 roman, жаңа-жол.
Шығыс жазу: 64 roman, жаңа-жол.
Шығыс жазу: 128 roman, жаңа-жол.
Шығыс жазу: 256 roman, жаңа-жол.
Шығыс жазу: 1024 roman, жаңа-жол.
