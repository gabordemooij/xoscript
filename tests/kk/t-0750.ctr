Шығыс жазу: ['Test object'], жаңа-жол.
>> a := Нысан жаңа. 

a келгенде: ['item:'] орында: { :nil
	өзінің nil := nil. 
}.

a келгенде: ['item'] орында: { <- өзінің nil.
}.

a item: Бос.

Шығыс жазу: a item, жаңа-жол.

>> old-nil-address := a item прототип жад-мекенжайы.
a save-as: ['/tmp/a.bin'].
Шығыс жазу: ['========== RELOADING SNAP:'], жаңа-жол.

>> b := Нысан load-from: ['/tmp/a.bin'].

(b item прототип жад-мекенжайы = old-nil-address) ақиқат-болса: {
	Шығыс жазу: ['Object link re-attached.'], жаңа-жол.
}.

Шығыс жазу: b item, жаңа-жол.
