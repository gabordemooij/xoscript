# test number -> string -> number
{

	>> x := Сан арасында: 0 мен: 1000000.
	>> d := Сан арасында: 1 мен: 7.
	>> e := 10 дәреже: d.

	x бөлу-санға: e.
	>> y := x мәтін сан.

	(x = y) жалған-болса: {
		Шығыс жазу: x, жаңа-жол.
		Шығыс жазу: y, жаңа-жол.
		Бағдарлама аяқтау.
	}.

} * 1000.
Шығыс жазу: ['OK'], жаңа-жол.