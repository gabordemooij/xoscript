Бағдарлама жадты-басқару: 0.
Тізім келгенде: ['sum'] орында: {
	>> total := 0.
	өзі әрбір: { :index :element
		total қосу: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Файл жаңа: ['/tmp/test.txt'].
f жазу: ['Lorem Ipsum'].
f жабу.
  

f := Файл жаңа: ['/tmp/test.txt'].
>> text := f оқу.
f жабу.



Бағдарлама тазалау.
usedMemory1 := (Бағдарлама жад ? 1).



f := Файл жаңа: ['/tmp/test.txt'].
text := f оқу.
f жабу.

Бағдарлама тазалау.
usedMemory2 := (Бағдарлама жад ? 1).


f := Файл жаңа: ['/tmp/test.txt'].
text := f оқу.
f жабу.

Бағдарлама тазалау.
usedMemory3 := (Бағдарлама жад ? 1).



( usedMemory1 = usedMemory2 және: usedMemory1 = usedMemory3, және: usedMemory2 = usedMemory3 ) ақиқат-болса: {
	Шығыс жазу: ['No memory leaks here'].
}, жалған-болса: {
	Шығыс жазу: ['Leaking memory...'].
}.
