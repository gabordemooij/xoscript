>> To-Do := Нысан жаңа.

To-Do келгенде: ['жаңа'] орында: {
	өзінің list := Тізім жаңа.
}.

To-Do келгенде: ['nieuw'] орында: {
	өзінің list := Тізім жаңа.
}.

To-Do келгенде: ['+'] орында: { :task
	өзінің list соңына-қосу: task.
}.

To-Do келгенде: ['number of tasks?'] орында: { <-  өзінің list саны.
}.

>> todos := 
	To-Do жаңа 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Шығыс жазу: ['You have $ tasks to do'] $ todos number of tasks?.
