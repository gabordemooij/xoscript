Шығыс жазу: ['Test object'], жаңа-жол.
>> greeter := Нысан жаңа.
greeter келгенде: ['name:'] орында: { :атау
	өзінің xname := атау. 
}.
greeter келгенде: ['greet'] орында: {
	Шығыс жазу: ['Hello '] + өзінің xname, жаңа-жол.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Шығыс жазу: ['========== RELOADING SNAP:'], жаңа-жол.
>> b := Нысан load-from: ['/tmp/a.bin'].
>> c := Нысан load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
