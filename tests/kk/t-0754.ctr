Шығыс жазу: ['Test object'], жаңа-жол.
>> a := Нысан жаңа. 

a келгенде: ['item:'] орында: { :out
	өзінің out := out. 
}.

a келгенде: ['item'] орында: { <- өзінің out.
}.

a келгенде: ['greet'] орында: {
	Шығыс жазу: ['hi from original out!'], жаңа-жол.
}.

a item: Шығыс.

Шығыс жазу: a item, жаңа-жол.

>> old-out-address := a item прототип жад-мекенжайы.
a save-as: ['/tmp/a.bin'].
Шығыс жазу: ['========== RELOADING SNAP:'], жаңа-жол.

>> b := Нысан load-from: ['/tmp/a.bin'].

(b item прототип жад-мекенжайы = old-out-address) ақиқат-болса: {
	Шығыс жазу: ['Object link re-attached.'], жаңа-жол.
}.

b item жазу: ['hello from loaded out!'], жаңа-жол.
b greet.
