Сан келгенде: ['factorial'] орында: {
	>> total := 1.
	{ :index total көбейту: (өзі - index). } × өзі. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Бағдарлама жадты-басқару: 0.

{
2 exponent factorial.
Шығыс жазу: (11 қалдық: 3), жаңа-жол.
Шығыс жазу: (3.4 дөңгелектеу), жаңа-жол.
Шығыс жазу: (7.1 жоғары-дөңгелектеу), жаңа-жол.
Шығыс жазу: (7.9 төмен-дөңгелектеу), жаңа-жол.
}
іске-қосу.

Бағдарлама тазалау.

usedMemory1 := (Бағдарлама жад ? 0).

{
2 exponent factorial.
Шығыс жазу: (11 қалдық: 3), жаңа-жол.
Шығыс жазу: (3.4 дөңгелектеу), жаңа-жол.
Шығыс жазу: (7.1 жоғары-дөңгелектеу), жаңа-жол.
Шығыс жазу: (7.9 төмен-дөңгелектеу), жаңа-жол.
}
іске-қосу.

Бағдарлама тазалау.
usedMemory2 := (Бағдарлама жад ? 0).


{
2 exponent factorial.
Шығыс жазу: (11 қалдық: 3), жаңа-жол.
Шығыс жазу: (3.4 дөңгелектеу), жаңа-жол.
Шығыс жазу: (7.1 жоғары-дөңгелектеу), жаңа-жол.
Шығыс жазу: (7.9 төмен-дөңгелектеу), жаңа-жол.
} іске-қосу.

Бағдарлама тазалау.
usedMemory3 := (Бағдарлама жад ? 0).



( usedMemory1 = usedMemory2 және: usedMemory1 = usedMemory3, және: usedMemory2 = usedMemory3 ) ақиқат-болса: {
	Шығыс жазу: ['No memory leaks here'].
}, жалған-болса: {
	Шығыс жазу: ['Leaking memory...'].
}.
