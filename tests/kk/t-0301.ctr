


>> wine := Нысан жаңа.


wine келгенде: ['toString'] орында: { <- ['merlot'].
}.

wine келгенде: ['naarTekst'] орында: { <- ['merlot'].
}.


wine келгенде: ['='] орында: { :other wine <- ( өзі toString = other wine ).
}.

wine келгенде: ['=='] орында: { :other wine <- ( өзі toString = other wine ).
}.



wine
	жағдай: ['cabernet'] орында: { Шығыс жазу: ['it's a Cabernet!']. },
	жағдай: ['syrah']    орында: { Шығыс жазу: ['it's a Syrah!'].    },
	жағдай: ['merlot']   орында: { Шығыс жазу: ['it's a Merlot!'].   },
	жағдай: ['malbec']   орында: { Шығыс жазу: ['it's a Malbec!'].   }.

Шығыс жаңа-жол.
