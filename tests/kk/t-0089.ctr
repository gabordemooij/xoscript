>> randomizer := { :a :b
	>> ең-кіші := ( a < b ) бұл: a не-ол: b.
	>> ең-үлкен := ( a > b ) бұл: a не-ол: b.
	>> x := Бос.
	{
		x := Сан арасында: a мен: b.
		((x < ең-кіші) немесе: (x > ең-үлкен)) ақиқат-болса: { 
			Шығыс жазу: (['Invalid value!']).
			Бағдарлама аяқтау.
		}.
	} 
	× 100. <- x.
}.
randomizer қолдану: 0 және: 0.
