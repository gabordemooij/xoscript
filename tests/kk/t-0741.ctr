Шығыс жазу: ['Test object'], жаңа-жол.
>> a := Нысан жаңа. 

a келгенде: ['item:'] орында: { :octhelper
	өзінің octhelper := octhelper. 
}.

a келгенде: ['item'] орында: { <- өзінің octhelper.
}.

a item: Oct жаңа.

>> old-octhelper-address := a item прототип жад-мекенжайы.
a save-as: ['/tmp/a.bin'].
Шығыс жазу: ['========== RELOADING SNAP:'], жаңа-жол.

>> b := Нысан load-from: ['/tmp/a.bin'].

(b item прототип жад-мекенжайы = old-octhelper-address) ақиқат-болса: {
	Шығыс жазу: ['Object link re-attached.'], жаңа-жол.
}.
