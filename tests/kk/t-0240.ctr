# test qualifiers

>> $ := Нысан жаңа.

$ келгенде: ['жауап:'] орында: { :x
	
	>> operation := x таңба: 0.
	>> valuta := x таңба: 1.
	>> money := x ығысу: 2.
	
	>> amount := 0.

	( operation = ['+'] ) ақиқат-болса: {
		( valuta = ['£'] ) ақиқат-болса: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Шығыс жазу: x, жаңа-жол.


>> Fruit := Нысан жаңа.

Fruit келгенде: ['жаңа'] орында: {
	>> f := өзі жаңа.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit келгенде: ['apples:'] орында: { :a өзінің apples := a. }.
Fruit келгенде: ['oranges:'] орында: { :p өзінің oranges := p. }.
Fruit келгенде: ['apples'] орында: { <- өзінің apples. }.
Fruit келгенде: ['oranges'] орында: { <- өзінің oranges. }.

Fruit келгенде: ['+'] орында: { :f
	
	>> n := Fruit жаңа.
	f қосу: 1.
	
	n apples: (f apples + өзінің apples).
	n oranges:  (f oranges  + өзінің oranges). <- n.
}.

Fruit келгенде: ['мәтін'] орында: { <- ( өзінің apples мәтін + [' apples and '] + өзінің oranges + [' oranges'] ).
}.

Сан келгенде: ['apples'] орында: { <- ((Fruit жаңа) apples: өзі).
}.

Сан келгенде: ['apple'] орында: { <- ((Fruit жаңа) apples: өзі).
}.

Сан келгенде: ['oranges'] орында: { <- ((Fruit жаңа) oranges: өзі).
}.




Шығыс жазу: (1 apple + 3 oranges + 4 apples), жаңа-жол.


Мәтін келгенде: ['twice'] орында: { <- ((өзі мәтін) + (өзі мәтін)).
}.



Шығыс жазу: ['❤❤❤'] twice.



