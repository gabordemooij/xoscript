Server init.

>> DB := Maria-DB жаңа хост: ['localhost'],
	пайдаланушы-аты: ['xo'],
	құпиясөз: ['pass123'],
	дерекқор-атауы: ['xobase'],
	қосылу.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> іздеу-параметрлері := Maria-Сұрау жаңа: SQL.

# set database
іздеу-параметрлері дерекқор: DB.

іздеу-параметрлері алу: { :row
	Шығыс жазу: row world, жаңа-жол.
}.
