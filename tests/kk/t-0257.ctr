
>> Greeter := Нысан жаңа.
Greeter келгенде: ['жаңа'] орында: {
	өзінің атау := ['?'].
}.
Greeter келгенде: ['name:'] орында: { :атау
	өзінің атау := атау.
}.
Greeter келгенде: ['greet'] орында: {
	Шығыс жазу: (['hello[you]'] [you]: өзінің атау).
}.
>> friend := Greeter жаңа.
friend name: ['1'].
friend greet.
