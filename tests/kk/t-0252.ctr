#Linux
>> clock := Сәт жаңа.
clock уақыт-белдеуі: ['UTC-1'].
clock жыл: 1981, ай: 1, күн: 5,
      сағат: 13, минут: 15, секунд: 13.

Шығыс жазу: clock, жаңа-жол.
clock уақыт-белдеуі: ['UTC+0'].

Шығыс жазу: (
	(clock жыл қарапайым) + ['-'] + (clock ай) + ['-'] + (clock күн) + [' '] +
	(clock сағат) + [':'] + (clock минут) + [':'] + (clock секунд) + [' '] +
	['W'] + (clock апта) + (clock уақыт-белдеуі)
), жаңа-жол.


clock уақыт-белдеуі: ['UTC-1'].
Шығыс жазу: (
	(clock жыл қарапайым) + ['-'] + (clock ай) + ['-'] + (clock күн) + [' '] +
	(clock сағат) + [':'] + (clock минут) + [':'] + (clock секунд) + [' '] +
	['W'] + (clock апта) + (clock уақыт-белдеуі)
), жаңа-жол.
