Шығыс жазу: ['Test object'], жаңа-жол.
>> a := Нысан жаңа. 

a келгенде: ['item:'] орында: { :binhelper
	өзінің binhelper := binhelper. 
}.

a келгенде: ['item'] орында: { <- өзінің binhelper.
}.

a item: Bin жаңа.

>> old-binhelper-address := a item прототип жад-мекенжайы.
a save-as: ['/tmp/a.bin'].
Шығыс жазу: ['========== RELOADING SNAP:'], жаңа-жол.

>> b := Нысан load-from: ['/tmp/a.bin'].

(b item прототип жад-мекенжайы = old-binhelper-address) ақиқат-болса: {
	Шығыс жазу: ['Object link re-attached.'], жаңа-жол.
}.


