

Тізім келгенде: ['fixture:'] орында: { :f
	өзінің fixture := f.
}.

Тізім келгенде: ['саны'] орында: { <- өзінің fixture.
}.

Тізім келгенде: ['aantal'] орында: { <- өзінің fixture.
}.


>> x := Бос.
{

	x := ['hello'] 
	ауыстыру:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] таңба: 2)
			)
		)
	мынаған: (
		(['...hal'] + ['lo']) 
			бас-әріптер 
			lowecase 
			бас-әріптер 
			ығысу: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Тізім ← 0 ; 1 ; 4; 9 ; (Тізім ← 0 ; 3; 1) ; 4
							) соңғының-алдындағы
						) ? 1
					) + 
					((Тізім ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					саны
				)
			)
	).

} × 10.
Шығыс жазу: x, жаңа-жол.

