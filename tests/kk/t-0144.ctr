



>> CoffeeGrounds := Нысан жаңа.
CoffeeGrounds келгенде: ['extract'] орында: { <- ['coffee']. }.

>> CoffeeMachine := Нысан жаңа.
CoffeeMachine келгенде: ['init'] орында: {
	өзінің coffeegrounds := CoffeeGrounds жаңа.
}.
CoffeeMachine келгенде: ['жаңа'] орында: { <- CoffeeMachine `new init.
}.

CoffeeMachine келгенде: ['makeTea'] орында: { <- (өзінің tealeaves extract). }.
CoffeeMachine келгенде: ['makeCoffee'] орында: { <- (өзінің coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine жаңа.

Шығыс жазу:
	coffeeDream 
	makeCoffee.

Шығыс жазу:
	coffeeDream 
	makeTea.
