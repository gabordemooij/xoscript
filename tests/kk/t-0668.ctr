# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob жаңа: 8, bytes: (
	Тізім жаңа ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Шығыс жазу: ( utf16 декодтау: ['utf16le'] ), жаңа-жол.

utf16 босату.
>> utf32 := Blob жаңа: 13, bytes: (
	Тізім жаңа ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Шығыс жазу: ( utf32 декодтау: ['utf32be'] ), жаңа-жол.
utf32 босату.