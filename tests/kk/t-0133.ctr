


>> Deck := Тізім жаңа.
Deck келгенде: ['print'] орында: {
        >> len := өзі саны - 1.
        { :i
                >> len2 := өзі саны - 1.
                Шығыс жазу: ['len: '].
                Шығыс жазу: len, жаңа-жол.
                Шығыс жазу: ['len2: '].
                Шығыс жазу: len2, жаңа-жол.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
