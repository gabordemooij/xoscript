#Linux
>> Slurp := Нысан жаңа.

Slurp келгенде: ['жаңа'] орында: {
	өзінің str := [''].
}.

Slurp келгенде: ['nieuw'] орында: {
	өзінің str := [''].
}.

Slurp келгенде: ['жауап:'] орында: { :blah
		өзінің str соңына-қосу: blah.
}.

Slurp келгенде: ['жауап:және:'] орында: { :blah :blahah
		өзінің str соңына-қосу: (blah бастап: 0 ұзындық: (blah ұзындық - 1)).
		өзінің str соңына-қосу: [' '].
		өзінің str соңына-қосу: blahah.
}.

Slurp келгенде: ['obtain'] орында: {
	>> buffer := өзінің str.
	өзінің str := ['']. <- buffer.
}.


Шығыс жазу: (Бағдарлама жүйе: (Slurp жаңа echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Файл жаңа: ['/tmp/from.txt'], жою. } ұстау: { ['Empty']. }, іске-қосу.
{ Файл жаңа: ['/tmp/to.txt'], жою. } ұстау: { ['Empty']. }, іске-қосу.


Файл жаңа: ['/tmp/to.txt'], бар жалған-болса: {
	Шығыс жазу: ['Confirmed. Target file does not exist.\
'].
}.
Файл жаңа: ['/tmp/from.txt'], бар жалған-болса: {
	Шығыс жазу: ['Confirmed. Source file does not exist.\
'].
}.



Бағдарлама жүйе: (Slurp жаңа touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Бағдарлама жүйе: (Slurp жаңа cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Файл жаңа: ['/tmp/to.txt'], бар ақиқат-болса: {
	Шығыс жазу: ['Confirmed. Target file has been created by shell.\
'].
}.


Шығыс жазу: ['Contents of file is:'] + (Файл жаңа: ['/tmp/to.txt'], оқу), жаңа-жол.
