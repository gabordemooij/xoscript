#OBSD
>> dirname := [''].
{ dirname соңына-қосу: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Бағдарлама жүйе: command.
Бағдарлама chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename соңына-қосу: ['YYYYYYYY']. } * 20.
Файл жаңа: filename, жазу: ['sometext'].
{ Файл тізім: ['/tmp/'] + dirname. } * 1000.
Шығыс жазу: ['no crash'], жаңа-жол.

