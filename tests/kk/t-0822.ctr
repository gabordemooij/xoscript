# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := Maria-DB жаңа хост: ['localhost'],
	пайдаланушы-аты: ['xo'],
	құпиясөз: ['pass123'],
	дерекқор-атауы: ['xobase'],
	қосылу.

>> іздеу-параметрлері := db сұрау: ['SELECT ? AS a, ? AS b, ? AS c'].
іздеу-параметрлері параметрлер: (Тізім жаңа ; ['1']).
{ іздеу-параметрлері алу: { :row Шығыс жазу: row, жаңа-жол. }. } ұстау: { :e Шығыс жазу: e, жаңа-жол. }, іске-қосу.

>> іздеу-параметрлері := db сұрау: ['SELECT ? AS a'].
{ іздеу-параметрлері алу: { :row Шығыс жазу: row, жаңа-жол. }. } ұстау: { :e Шығыс жазу: e, жаңа-жол. }, іске-қосу.

# the right number still works, more parameters are ignored as before
>> іздеу-параметрлері := db сұрау: ['SELECT ? AS a, ? AS b'].
іздеу-параметрлері параметрлер: (Тізім жаңа ; ['1'] ; ['2']).
іздеу-параметрлері алу: { :row Шығыс жазу: (row орнында: ['a']), жазу: (row орнында: ['b']), жаңа-жол. }.
іздеу-параметрлері параметрлер: (Тізім жаңа ; ['1'] ; ['2'] ; ['3']).
іздеу-параметрлері алу: { :row Шығыс жазу: (row орнында: ['a']), жазу: (row орнында: ['b']), жаңа-жол. }.
