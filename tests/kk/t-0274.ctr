

Тізім келгенде: ['column:'] орында: { :column
	>> result := Тізім жаңа.
	өзі әрбір: { :index :row
		row әрбір: { :index :cell
			(index = column) ақиқат-болса: { result соңына-қосу: cell. }.
		}.
	}. <- result.
}.


>> a := Тізім ←
	(Тізім ← 1 ; 2 ; 3) ;
	(Тізім ← 4 ; 5 ; 6) ;
	(Тізім ← 7 ; 8 ; 9).

>> b := a column: 1.
Шығыс жазу: b, жаңа-жол.

b := a column: 20.
Шығыс жазу: b, жаңа-жол.

b := a column: -100.
Шығыс жазу: b, жаңа-жол.
