>> t := Бос.

# you can control the time zone for
# parsing like this:
Сәт уақыт-белдеуі: ['CET'].
t := Сәт көзі: ['1981-02-03 04:05:06'].
Шығыс жазу: t, жаңа-жол.

# now using CEST time zone:
Сәт уақыт-белдеуі: ['CEST'].
t := Сәт көзі: ['1981-02-03 04:05:06'].
Шығыс жазу: t, жаңа-жол.

# error if string cannot be parsed
{ Сәт көзі: ['1900']. } ұстау: { Бос. }, іске-қосу.
