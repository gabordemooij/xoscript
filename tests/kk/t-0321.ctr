# test qualifiers

Бағдарлама тазалау.

>> Fruit := Нысан жаңа.
Fruit келгенде: ['жаңа'] орында: {
	>> f := өзі жаңа.
	f apples: 0. <- f.
}.
Fruit келгенде: ['apples:'] орында: { :a өзінің apples := a. }.
Fruit келгенде: ['apples'] орында: { <- өзінің apples. }.
Fruit келгенде: ['+'] орында: { :f
	>> n := Fruit жаңа.
	n apples: (f apples + өзінің apples). <- n.
}.
Сан келгенде: ['apples'] орында: { <- ((Fruit жаңа) apples: өзі).
}.

Fruit келгенде: ['мәтін'] орында: { <- өзінің apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Шығыс жазу: q, жаңа-жол.




q := 3 apples + 4 apples.
Шығыс жазу: q, жаңа-жол.



q := 3 apples + 4 apples.
Шығыс жазу: q, жаңа-жол.


