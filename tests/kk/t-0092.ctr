
>> g := ['global'].
{ >> g := ['local']. Шығыс жазу: g, жаңа-жол. } іске-қосу. 
Шығыс жазу: g, жаңа-жол. 
>> message := ['Bye'].
>> Secret := Нысан жаңа.
Secret келгенде: ['сынақ'] орында: {
	>> message := ['Hello'].
	өзінің message := ['World'].
	Шығыс жазу: message + [' '] + өзінің message, жаңа-жол.
}.
Secret сынақ.
Шығыс жазу: message.
