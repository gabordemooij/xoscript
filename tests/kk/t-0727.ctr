Server init.
>> f := Пішім жаңа: ['%d'].
>> a := Blob жаңа: 4.
a bytes: ( Тізім жаңа ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob жаңа: 4.
b bytes: ( Тізім жаңа ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a бастап: 0 ұзындық: 3, әрбір: { :i :byte
	Шығыс жазу: ( f қолдану-бүтін: byte ), жаңа-жол.
}.
a ^ b.
a бастап: 0 ұзындық: 3, әрбір: { :i :byte
	Шығыс жазу: ( f қолдану-бүтін: byte ), жаңа-жол.
}.
a ^ b.
a бастап: 0 ұзындық: 3, әрбір: { :i :byte
	Шығыс жазу: ( f қолдану-бүтін: byte ), жаңа-жол.
}.
a босату.
b босату.

{ a ^ Нысан. } ұстау: { :e Шығыс жазу: e, жаңа-жол. }, іске-қосу.
