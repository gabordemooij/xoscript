Шығыс жазу: ['Test object'], жаңа-жол.
>> a := Нысан жаңа. 

a келгенде: ['item:'] орында: { :fmt
	өзінің fmt := fmt. 
}.

a келгенде: ['item'] орында: { <- өзінің fmt.
}.

a item: ( Пішім жаңа: ['|%s|'] ).

Шығыс жазу: a item, жаңа-жол.

>> old-fmt-address := a item прототип жад-мекенжайы.
a save-as: ['/tmp/a.bin'].
Шығыс жазу: ['========== RELOADING SNAP:'], жаңа-жол.

>> b := Нысан load-from: ['/tmp/a.bin'].

(b item прототип жад-мекенжайы = old-fmt-address) ақиқат-болса: {
	Шығыс жазу: ['Object link re-attached.'], жаңа-жол.
}.

Шығыс жазу: ( b item қолдану: ['hello'] ), жаңа-жол.
