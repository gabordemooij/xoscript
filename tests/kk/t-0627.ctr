

# create a 64-bit integer for exact calculations
>> a := Int64 мәтіннен: ['123'].

# to string
Шығыс жазу: a, жаңа-жол.

# divide
Шығыс жазу: a / (Int64 мәтіннен: ['3']), жаңа-жол.

# multiply
Шығыс жазу: a * (Int64 мәтіннен: ['2']), жаңа-жол.

# add
Шығыс жазу: a + (Int64 мәтіннен: ['1']), жаңа-жол.

# subtract
Шығыс жазу: a - (Int64 мәтіннен: ['2']), жаңа-жол.

# compare
Шығыс жазу: ( a =   (Int64 мәтіннен: ['123'])), жаңа-жол.
Шығыс жазу: ( a !=: (Int64 мәтіннен: ['124'])), жаңа-жол.
Шығыс жазу: ( a <   (Int64 мәтіннен: ['124'])), жаңа-жол.
Шығыс жазу: ( a >   (Int64 мәтіннен: ['122'])), жаңа-жол.
Шығыс жазу: ( a >=: (Int64 мәтіннен: ['123'])), жаңа-жол.
Шығыс жазу: ( a <=: (Int64 мәтіннен: ['123'])), жаңа-жол.





	