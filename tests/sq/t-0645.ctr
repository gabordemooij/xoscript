Server init.
Dalje shkruaj: ['Database date test'], rresht-ri.

>> db := Maria-DB ri pritës: ['localhost'],
	përdorues: ['xo'], 
	fjalëkalim: ['pass123'],
	emër-baze: ['xobase'],
	lidhu.

>> parametra-kërkimi :=
db pyetësor: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
merr: { :row
	Dalje shkruaj: row datetest, rresht-ri.
}.
