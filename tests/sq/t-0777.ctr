#OBSD
>> dirname := [''].
{ dirname shto-në-fund: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Program sistem: command.
Program chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename shto-në-fund: ['YYYYYYYY']. } * 20.
Skedar ri: filename, shkruaj: ['sometext'].
{ Skedar listë: ['/tmp/'] + dirname. } * 1000.
Dalje shkruaj: ['no crash'], rresht-ri.

