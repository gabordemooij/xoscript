

Listë kur: ['fixture:'] bëj: { :f
	vetjak fixture := f.
}.

Listë kur: ['numëro'] bëj: { <- vetjak fixture.
}.

Listë kur: ['aantal'] bëj: { <- vetjak fixture.
}.


>> x := Asgjë.
{

	x := ['hello'] 
	zëvendëso:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] shkronjë: 2)
			)
		)
	me: (
		(['...hal'] + ['lo']) 
			shkronja-mëdha 
			lowecase 
			shkronja-mëdha 
			zhvendosje: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Listë ← 0 ; 1 ; 4; 9 ; (Listë ← 0 ; 3; 1) ; 4
							) parafundit
						) ? 1
					) + 
					((Listë ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					numëro
				)
			)
	).

} × 10.
Dalje shkruaj: x, rresht-ri.

