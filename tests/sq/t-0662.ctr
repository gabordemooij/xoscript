>> t := Asgjë.

# you can control the time zone for
# parsing like this:
Moment zonë: ['CET'].
t := Moment prej: ['1981-02-03 04:05:06'].
Dalje shkruaj: t, rresht-ri.

# now using CEST time zone:
Moment zonë: ['CEST'].
t := Moment prej: ['1981-02-03 04:05:06'].
Dalje shkruaj: t, rresht-ri.

# error if string cannot be parsed
{ Moment prej: ['1900']. } kap: { Asgjë. }, nis.
