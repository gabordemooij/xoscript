>> map1 := Fjalor ri.
>> key1 := Listë ri.
>> key2 := Listë ri.

map1
	vendos: ['hello'] në: key1,
	vendos: ['world'] në: key2.


Dalje
	shkruaj: ['Map #1 contains: '] + (map1 në: key1),
	shkruaj: [' and '] + (map1 në: key2), rresht-ri.

>> KeyeableArray := Listë ri.
KeyeableArray kur: ['toString'] bëj: { <- (vetja numëro) toString.
}.

>> map2 := Fjalor ri.
key1 := KeyeableArray ri.
key2 := KeyeableArray ri.

key1 shto-në-fund: 1.

map2
	vendos: ['hello'] në: key1,
	vendos: ['world'] në: key2.

Dalje
	shkruaj: ['Map #2 contains: '] + (map2 në: key1),
	shkruaj: [' and '] + (map2 në: key2), rresht-ri.
