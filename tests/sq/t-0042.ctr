>> items := Fjalor ri.
items vendos: ['black'] në: ['coffee'], vendos: ['earl grey'] në: ['tea'].
Dalje shkruaj: (items në: ['coffee']), shkruaj: (items në: ['tea']).
Dalje shkruaj: ['there are'] + items numëro + [' items in the array.'].
items vendos: ['capuccino'] në: ['coffee'].
Dalje shkruaj: ['Now my coffee is.. '] + (items në: ['coffee']).
items vendos: ['aaa'] në: ['1'].
items vendos: ['bbb'] në: ['2'].
Dalje shkruaj: (items në: ['a']).
