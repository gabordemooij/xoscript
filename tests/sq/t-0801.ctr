Server init.

>> db := Maria-DB ri pritës: ['localhost'],
	përdorues: ['xo'],
	fjalëkalim: ['pass123'],
	emër-baze: ['xobase'],
	lidhu.

>> del := db pyetësor: ['DELETE FROM book WHERE id > 0'].
{  del ekzekuto. db konfirmo. } kap: { :e db zhbëj.  }, nis.

>> numëro := db pyetësor: ['SELECT COUNT(*) AS num FROM book'].
numëro merr: { :row Dalje shkruaj: row num, rresht-ri. }.
