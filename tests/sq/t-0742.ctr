Dalje shkruaj: ['Test object'], rresht-ri.
>> a := Objekt ri. 

a kur: ['item:'] bëj: { :hexhelper
	vetjak hexhelper := hexhelper. 
}.

a kur: ['item'] bëj: { <- vetjak hexhelper.
}.

a item: Hx ri.

>> old-hexhelper-address := a item prototip adresë-kujtese.
a save-as: ['/tmp/a.bin'].
Dalje shkruaj: ['========== RELOADING SNAP:'], rresht-ri.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototip adresë-kujtese = old-hexhelper-address) vërtetë: {
	Dalje shkruaj: ['Object link re-attached.'], rresht-ri.
}.
