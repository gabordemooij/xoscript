
Tekst kur: ['html'] bëj: { <- (
		vetja
		zëvendëso: ['&'] me: ['&amp;'],
		zëvendëso: ['<'] me: ['&lt;'],
		zëvendëso: ['>'] me: ['&gt;'],
		zëvendëso: ['"'] me: ['&quot;']
	).
}.

>> HtmlBrush := Objekt ri.

HtmlBrush kur: ['përgjigju:'] bëj: { :tag
	Dalje shkruaj: (['<tag>↵'] tag: tag ).
}.

HtmlBrush kur: ['përgjigju:dhe:'] bëj: { :tag :content
	tag := ( tag nga: 0 gjatësi: (tag gjatësi - 1) ).
	Dalje shkruaj: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush kur: ['content:'] bëj: { :text
	Dalje shkruaj: text html, rresht-ri.
}.

HtmlBrush kur: ['attr:value:'] bëj: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush ri.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
