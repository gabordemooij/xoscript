>> z := Objekt ri.
z kur: ['value:'] bëj: { :v
	vetjak value := v. <- vetja.
}.
z kur: ['value'] bëj: { <- vetjak value. }.
(z setValue: 1) value: 2.
Dalje shkruaj: z value.
>> x := z.
Dalje shkruaj: x value.
z := Asgjë.
Dalje shkruaj: z value.
Dalje shkruaj: x value.
Dalje shkruaj: ['hello'].
Dalje shkruaj: 3 + 2.
Dalje shkruaj: (3 > 2).
