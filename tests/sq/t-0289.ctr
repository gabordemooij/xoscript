#Linux
>> OS := Program sistem: (Komandë uname -s), shkurto.

>> Slurp := Objekt ri.
Slurp kur: ['ri'] bëj: {
	vetjak str := [''].
}.
Slurp kur: ['përgjigju:'] bëj: { :blah
		(vetjak str ≠ ['']) vërtetë: {
			vetjak str shto-në-fund: [' '].
		}.
		vetjak str shto-në-fund: blah.
}.
Slurp kur: ['përgjigju:dhe:'] bëj: { :blah :blahah
		(vetjak str ≠ ['']) vërtetë: {
			vetjak str shto-në-fund: [' '].
		}.
		(blah gjatësi > 1) vërtetë: {
			vetjak str shto-në-fund: (blah nga: 0 gjatësi: (blah gjatësi - 1)).
		}, përndryshe: {
			vetjak str shto-në-fund: blah.
		}.
		vetjak str shto-në-fund: [' '].
		vetjak str shto-në-fund: blahah.
}.
Slurp kur: ['obtain'] bëj: {
	>> buffer := vetjak str.
	vetjak str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text shto-në-fund: ['hello'].
} × 1000.


Dalje shkruaj: (
	Program sistem: (
		Slurp ri
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

