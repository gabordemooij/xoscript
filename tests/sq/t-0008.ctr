>> Greeter := Objekt ri.
Greeter kur: ['make'] bëj: {
	>> greeter := Objekt ri.
	greeter kur: ['name:'] bëj: { :emër
		Dalje shkruaj: ['setting a name'].
		vetjak myName := emër.
	}.
	greeter kur: ['greet'] bëj: {
		Dalje shkruaj: ['Hello'].
		Dalje shkruaj: vetjak myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
