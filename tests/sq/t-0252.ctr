#Linux
>> clock := Moment ri.
clock zonë: ['UTC-1'].
clock vit: 1981, muaj: 1, ditë: 5,
      orë: 13, minutë: 15, sekondë: 13.

Dalje shkruaj: clock, rresht-ri.
clock zonë: ['UTC+0'].

Dalje shkruaj: (
	(clock vit thjeshtë) + ['-'] + (clock muaj) + ['-'] + (clock ditë) + [' '] +
	(clock orë) + [':'] + (clock minutë) + [':'] + (clock sekondë) + [' '] +
	['W'] + (clock javë) + (clock zonë)
), rresht-ri.


clock zonë: ['UTC-1'].
Dalje shkruaj: (
	(clock vit thjeshtë) + ['-'] + (clock muaj) + ['-'] + (clock ditë) + [' '] +
	(clock orë) + [':'] + (clock minutë) + [':'] + (clock sekondë) + [' '] +
	['W'] + (clock javë) + (clock zonë)
), rresht-ri.
