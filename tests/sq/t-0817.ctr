# a value ending in the first part of an opening quote must survive serialization
>> vlera := Listë ri
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

vlera secili: { :i :value
	>> d := Fjalor ri.
	d vendos: value në: ['k'].
	d vendos: ['second'] në: ['j'].
	>> r := d kod objekt.
	Dalje shkruaj: r numëro, rresht-ri.
	Dalje shkruaj: ( (r në: ['k']) = value ), rresht-ri.
}.
