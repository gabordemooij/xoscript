Numër kur: ['factorial'] bëj: {
	>> total := 1.
	{ :index total shumëzo-me: (vetja - (index)). } × vetja. <- total.
}.
>> Printer := Objekt ri.
Printer kur: ['print:and:'] bëj: { :x :y
	Dalje shkruaj: ['a='] + x + [', b='] + y, rresht-ri.
}.
>> a := 4.5. >> b := a rrumbullakos-poshtë.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a rrumbullakos-lart.
Printer print: a and: b.
a := 4.5. b := a rrumbullakos-poshtë.
Printer print: a and: b.
a := 4.5. b := a rrumbullakos.
Printer print: a and: b.
a := 4.2. b := a rrumbullakos.
Printer print: a and: b.

