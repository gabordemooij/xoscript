# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Model ri: pattern.
	p përputhje: subject bëj: { :m :g
		Dalje shkruaj: g numëro, shkruaj: [' '], shkruaj: (g bashko: ['|']), rresht-ri. <- m.
	}.
}.
show zbato: ['(a)|(b)'] dhe: ['b'].
show zbato: ['(a)|(b)'] dhe: ['a'].
show zbato: ['(x)?y'] dhe: ['y'].
show zbato: ['(x)?(y)(z)?'] dhe: ['xy'].
