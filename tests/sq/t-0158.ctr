>> x := [' hallo '].

>> y := x shkronja-mëdha.
Dalje shkruaj: x, rresht-ri.
Dalje shkruaj: (x baras: y), rresht-ri.

>> y := x shkronja-vogla.
Dalje shkruaj: x, rresht-ri.
Dalje shkruaj: (x baras: y), rresht-ri.

>> y := x shkurto.
Dalje shkruaj: x, rresht-ri.
Dalje shkruaj: (x baras: y), rresht-ri.

>> y := x zhvendosje: 1.
Dalje shkruaj: x, rresht-ri.
Dalje shkruaj: (x baras: y), rresht-ri.

>> y := x nga: 1 gjatësi: 2.
Dalje shkruaj: x, rresht-ri.
Dalje shkruaj: (x baras: y), rresht-ri.