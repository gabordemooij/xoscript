Dalje shkruaj: ['Test object'], rresht-ri.
>> p := Shteg /tmp.
Dalje shkruaj: p, rresht-ri.
>> old-p-address := p prototip adresë-kujtese.
p save-as: ['/tmp/a.bin'].
Dalje shkruaj: ['========== RELOADING SNAP:'], rresht-ri.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b prototip adresë-kujtese = old-p-address) vërtetë: {
	Dalje shkruaj: ['Object link re-attached.'], rresht-ri.
}.
Dalje shkruaj: b, rresht-ri.
