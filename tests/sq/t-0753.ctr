Dalje shkruaj: ['Test object'], rresht-ri.
>> a := Objekt ri. 

a kur: ['item:'] bëj: { :fmt
	vetjak fmt := fmt. 
}.

a kur: ['item'] bëj: { <- vetjak fmt.
}.

a item: ( Format ri: ['|%s|'] ).

Dalje shkruaj: a item, rresht-ri.

>> old-fmt-address := a item prototip adresë-kujtese.
a save-as: ['/tmp/a.bin'].
Dalje shkruaj: ['========== RELOADING SNAP:'], rresht-ri.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototip adresë-kujtese = old-fmt-address) vërtetë: {
	Dalje shkruaj: ['Object link re-attached.'], rresht-ri.
}.

Dalje shkruaj: ( b item zbato: ['hello'] ), rresht-ri.
