Listë kur: ['sum'] bëj: {
	>> total := 0.
	vetja secili: { :index :element
		total shto: element.
	}. <- total.
}.

>> a := Vërtetë.



a kur: ['tekst'] bëj: {
	>> answer := Asgjë.
	( vetja = Vërtetë ) vërtetë: {
		answer := ['Yep'].
	}, përndryshe: {
		answer := ['Nope'].
	}. <- answer.
}.

a kur: ['numër'] bëj: {
	>> answer := Asgjë.
	( vetja = Vërtetë ) vërtetë: {
		answer := 10.
	}, përndryshe: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b kur: ['tekst'] bëj: { <- ['Devil'].
}.

b kur: ['logjik'] bëj: { <- Rreme.
}.


Dalje shkruaj: a, rresht-ri.  
Dalje shkruaj: (90 + a), rresht-ri. 
Dalje shkruaj: b, rresht-ri. 
Dalje shkruaj: (Vërtetë dhe: b), rresht-ri.

a := Listë ← ['hello'] ; ['world'] ; Vërtetë ; Asgjë ; 666. 
a := a + ( Listë ← 1 ).
Dalje shkruaj: a, rresht-ri.
Dalje shkruaj: ((Fjalor ri) vendos: Asgjë në: Asgjë), rresht-ri.
Dalje shkruaj: a sum, rresht-ri. 


{
	a kur: ['tekst'] bëj: { <- Asgjë. }.
	a := [''] + a.
} kap: { :error
	Dalje shkruaj: ['Error noted: '] + error, rresht-ri.
}, nis.



{
	a kur: ['numër'] bëj: { <- Asgjë. }.
	a := 3 × a.
} kap: { :error
	Dalje shkruaj: ['Error noted: '] + error, rresht-ri.
}, nis.


{
	a kur: ['logjik'] bëj: { <- Asgjë. }.
	a := Vërtetë dhe: a. 
} kap: { :error
	Dalje shkruaj: ['Error noted: '] + error, rresht-ri.
}, nis.





{
	a kur: ['tekst'] bëj: { <- Rreme. }.
	a := [''] + a.
} kap: { :error
	Dalje shkruaj: ['Error noted: '] + error, rresht-ri.
}, nis.



{
	a kur: ['numër'] bëj: { <- Vërtetë. }.
	a := 3 × a.
} kap: { :error
	Dalje shkruaj: ['Error noted: '] + error, rresht-ri.
}, nis.


{
	a kur: ['boolean'] bëj: { <- 1. }.
	a := Vërtetë dhe: a.
} kap: { :error
	Dalje shkruaj: ['Error noted: '] + error, rresht-ri.
}, nis.





