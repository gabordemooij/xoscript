


>> wine := Objekt ri.


wine kur: ['toString'] bëj: { <- ['merlot'].
}.

wine kur: ['naarTekst'] bëj: { <- ['merlot'].
}.


wine kur: ['='] bëj: { :other wine <- ( vetja toString = other wine ).
}.

wine kur: ['=='] bëj: { :other wine <- ( vetja toString = other wine ).
}.



wine
	rast: ['cabernet'] bëj: { Dalje shkruaj: ['it's a Cabernet!']. },
	rast: ['syrah']    bëj: { Dalje shkruaj: ['it's a Syrah!'].    },
	rast: ['merlot']   bëj: { Dalje shkruaj: ['it's a Merlot!'].   },
	rast: ['malbec']   bëj: { Dalje shkruaj: ['it's a Malbec!'].   }.

Dalje rresht-ri.
