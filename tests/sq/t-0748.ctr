Dalje shkruaj: ['Test object'], rresht-ri.
>> a := Objekt ri. 

a kur: ['item:'] bëj: { :logjik
	vetjak logjik := logjik. 
}.

a kur: ['item'] bëj: { <- vetjak logjik.
}.

a item: Vërtetë.

Dalje shkruaj: a item, rresht-ri.

>> old-bool-address := a item prototip adresë-kujtese.
a save-as: ['/tmp/a.bin'].
Dalje shkruaj: ['========== RELOADING SNAP:'], rresht-ri.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototip adresë-kujtese = old-bool-address) vërtetë: {
	Dalje shkruaj: ['Object link re-attached.'], rresht-ri.
}.

Dalje shkruaj: b item, rresht-ri.
