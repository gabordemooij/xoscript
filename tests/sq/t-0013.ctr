
>> Animal := Objekt ri.
Animal kur: ['ri'] bëj: { <- vetja ri init.
}.

Animal kur: ['init'] bëj: {
	vetjak sound := ['?'].
	vetjak legs := 4.
}.

>> Dog := Animal ri.
Dog kur: ['init'] bëj: {
	vetja init.
	vetjak sound := ['barks'].
}.

Animal kur: ['tekst'] bëj: { <- vetjak legs tekst + vetjak sound.
}.

>> poodle := Dog ri.
Dalje shkruaj: poodle, rresht-ri.

