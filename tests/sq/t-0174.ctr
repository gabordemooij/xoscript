


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program menaxhim-kujtese: 0.
>> palette := Asgjë.
>> colors := Asgjë.

{
palette := Fjalor ri.
palette 
	vendos: ['#F00'] në: ['red'],
	vendos: ['#0F0'] në: ['green'],
	vendos: ['#00F'] në: ['blue'].
Dalje shkruaj: ['number of RGB codes in palette: '] + ( palette numëro ), rresht-ri.
Dalje shkruaj: ['RGB code of green is: '] + ( palette ? ['green'] ), rresht-ri.
colors := [''].
( palette secili: { :emër :kod
		colors := colors + ( emër + [':'] + kod ).
} ).
Dalje shkruaj: ['All colors in palette: '] + colors, rresht-ri.
} nis.
Program pastro.
usedMemory1 := (Program kujtesë ? 0).

{
palette := Fjalor ri.
palette 
	vendos: ['#F00'] në: ['red'],
	vendos: ['#0F0'] në: ['green'],
	vendos: ['#00F'] në: ['blue'].
Dalje shkruaj: ['number of RGB codes in palette: '] + ( palette numëro ), rresht-ri.
Dalje shkruaj: ['RGB code of green is: '] + ( palette ? ['green'] ), rresht-ri.
colors := [''].
( palette secili: { :emër :kod
		colors := colors + ( emër + [':'] + kod ).
} ).
Dalje shkruaj: ['All colors in palette: '] + colors, rresht-ri.
} nis.
Program pastro.
usedMemory2 := (Program kujtesë ? 0).

{
palette := Fjalor ri.
palette 
	vendos: ['#F00'] në: ['red'],
	vendos: ['#0F0'] në: ['green'],
	vendos: ['#00F'] në: ['blue'].
Dalje shkruaj: ['number of RGB codes in palette: '] + ( palette numëro ), rresht-ri.
Dalje shkruaj: ['RGB code of green is: '] + ( palette ? ['green'] ), rresht-ri.
colors := [''].
( palette secili: { :emër :kod
		colors := colors + ( emër + [':'] + kod ).
} ).
Dalje shkruaj: ['All colors in palette: '] + colors, rresht-ri.
} nis.
Program pastro.
usedMemory3 := (Program kujtesë ? 0).



( usedMemory1 = usedMemory2 dhe: usedMemory1 = usedMemory3, dhe: usedMemory2 = usedMemory3 ) vërtetë: {
	Dalje shkruaj: ['No memory leaks here'].
}, rreme: {
	Dalje shkruaj: ['Leaking memory...'].
}.
