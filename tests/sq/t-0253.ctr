#Linux
>> OS := Program cilësim: ['OS'].

>> clock := Moment ri.
	
(OS = ['Haiku']) vërtetë: {
	clock zonë: ['CET'],
	vit: 2017, muaj: 7, ditë: 13,
	orë: 18, minutë: 0, sekondë: 0.
}, përndryshe: {
	clock zonë: ['Europe/Amsterdam'],
	vit: 2017, muaj: 7, ditë: 13,
	orë: 18, minutë: 0, sekondë: 0.
}.

clock kur: ['tell'] bëj: {
	Dalje shkruaj: vetja, rresht-ri.
}.


clock shto: 2    orë, tell.
clock shto: 1    orë, tell.
clock shto: 19 minutë, tell.
clock shto: 1  minutë, tell.
clock shto: 1  minutë, tell.
clock shto: 19 sekondë, tell.
clock shto: 1  sekondë, tell.
clock shto: 1  sekondë, tell.
clock shto: 2    vit, tell.
clock shto: 1    vit, tell.

(OS = ['Haiku']) vërtetë: {
clock shto: 5   muaj.
clock zonë: ['CEST'], tell.
}, përndryshe: {
	clock shto: 5   muaj, tell.
}.

clock shto: 1   muaj, tell.
clock shto: 19    ditë, tell.
clock shto: 1    orë, tell.
clock shto: 120  yard, tell.
