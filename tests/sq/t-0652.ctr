# test number -> string -> number
{

	>> x := Numër midis: 0 dhe: 1000000.
	>> d := Numër midis: 1 dhe: 7.
	>> e := 10 fuqi: d.

	x pjesëto-me: e.
	>> y := x tekst numër.

	(x = y) rreme: {
		Dalje shkruaj: x, rresht-ri.
		Dalje shkruaj: y, rresht-ri.
		Program fund.
	}.

} * 1000.
Dalje shkruaj: ['OK'], rresht-ri.