Dalje shkruaj: ['Test object'], rresht-ri.
>> a := Objekt ri. 

a kur: ['item:'] bëj: { :octhelper
	vetjak octhelper := octhelper. 
}.

a kur: ['item'] bëj: { <- vetjak octhelper.
}.

a item: Oct ri.

>> old-octhelper-address := a item prototip adresë-kujtese.
a save-as: ['/tmp/a.bin'].
Dalje shkruaj: ['========== RELOADING SNAP:'], rresht-ri.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototip adresë-kujtese = old-octhelper-address) vërtetë: {
	Dalje shkruaj: ['Object link re-attached.'], rresht-ri.
}.
