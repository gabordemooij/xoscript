Server init.

>> DB := Maria-DB ri pritës: ['localhost'],
	përdorues: ['xo'],
	fjalëkalim: ['pass123'],
	emër-baze: ['xobase'],
	lidhu.

{
	DB pyetësor:
	['DROP TABLE movies'],
	ekzekuto.
} kap: { Asgjë. }, nis.

DB pyetësor:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
ekzekuto.

DB pyetësor: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parametra: ( Listë ri ; ['Halloween'] ),
ekzekuto.

DB pyetësor: ['SELECT * FROM movies'],
merr: { :movie
	Dalje shkruaj: movie title, rresht-ri.
}.

