

>> obj := Objekt ri.

obj kur: ['greet'] bëj: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj kur: ['task'] bëj: {
	vetjak property := 123.
	{
		# try binds self/own to object instead of block
		Dalje shkruaj: vetja greet.
		Dalje shkruaj: vetjak property.
		1 / 0.
	} kap: {
		Dalje shkruaj: vetja greet.
		Dalje shkruaj: vetjak property.
		Dalje shkruaj: ['ok'].
	}, provo.
}.

obj task.