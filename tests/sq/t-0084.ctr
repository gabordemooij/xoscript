>> makeAdder := { :x
	>> f := { :y <- (vetjak x + y). } cakto: ['x'] vlerë: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i vetjak q vendos: (vetjak f zbato: (vetjak q ? i)) në: i. } 
	cakto: ['q'] vlerë: array,
	cakto: ['f'] vlerë: func.
	{ :i mapping zbato: i. } × (array numëro).
}.

>> a := Listë ← 1; 2; 3.
mapper zbato: a dhe: (makeAdder zbato: 100).
Dalje shkruaj: (a pozicion: 0), rresht-ri.
Dalje shkruaj: (a ? 1), rresht-ri.
Dalje shkruaj: (a ? 2), rresht-ri.
