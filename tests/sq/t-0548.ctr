Server init.

>> x := Blob ri: 65 lloj: ['char'].
# for this test you need set a path to libc (puts)
>> libname := Program cilësim: ['FFITESTLIB'].
Server lidh: (
 Listë ri ;
 libname ;
 ['putchar'] ;
 ( Listë ri ; ['char'] ) ;
 ['void'] ;
 ['Print'] ;
 ['char:']
).
Print char: (x nga: 0 gjatësi: 1), rresht-ri.
x liro.

