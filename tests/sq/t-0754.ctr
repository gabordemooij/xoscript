Dalje shkruaj: ['Test object'], rresht-ri.
>> a := Objekt ri. 

a kur: ['item:'] bëj: { :out
	vetjak out := out. 
}.

a kur: ['item'] bëj: { <- vetjak out.
}.

a kur: ['greet'] bëj: {
	Dalje shkruaj: ['hi from original out!'], rresht-ri.
}.

a item: Dalje.

Dalje shkruaj: a item, rresht-ri.

>> old-out-address := a item prototip adresë-kujtese.
a save-as: ['/tmp/a.bin'].
Dalje shkruaj: ['========== RELOADING SNAP:'], rresht-ri.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototip adresë-kujtese = old-out-address) vërtetë: {
	Dalje shkruaj: ['Object link re-attached.'], rresht-ri.
}.

b item shkruaj: ['hello from loaded out!'], rresht-ri.
b greet.
