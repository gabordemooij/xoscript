# test buffers PKI/Sign 
Server init.

>> long := ( Listë ri mbush: 1000 me: ['a'] ) bashko: [''].

# sign a message
Dalje shkruaj: ( 
	Kasafortë nënshkruaj: ['abc'] me: long
), rresht-ri.

Dalje shkruaj: ( 
	Kasafortë
		kontrollo: ['abc'] 
		nënshkrim: long 
		me: long
), rresht-ri.

Dalje shkruaj: (
	Kasafortë hash-fjalëkalimi: long verifiko: long
), rresht-ri.
