Dalje shkruaj: ['1,2,3,4,5,6,7,8,9,A,'], rresht-ri.
>> Scope := Objekt ri.
Scope kur: ['initialize:'] bëj: { :x vetjak property := x. }.
Scope kur: ['confirm'] bëj: { Dalje shkruaj: [',']. }.
Scope kur: ['provë'] bëj: {
	Dalje shkruaj: vetjak property.
	vetja confirm.
	( 1 = 1 ) vërtetë: { Dalje shkruaj: vetjak property. vetja confirm. }.
	( 1 = 0 ) rreme: { Dalje shkruaj: vetjak property. vetja confirm. }.
	>> y := 2. { Dalje shkruaj: vetjak property. vetja confirm. } derisa: { y zbres: 1. <- (y > 0). }.
	{ Dalje shkruaj: vetjak property. vetja confirm. } × 1.
	(Listë ← 1) secili: {  Dalje shkruaj: vetjak property. vetja confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Fjalor ri one: ['item']) secili: { Dalje shkruaj: vetjak property. vetja confirm. }.
	{ 1 ÷ 0. } kap: { Dalje shkruaj: vetjak property. vetja confirm. }, nis.
	Dalje rresht-ri.
}.
>> scope1 := Scope ri.
scope1 initialize: ['X'].
scope1 provë.
>> function := { 
	vetjak property := ['Y'].
	Dalje shkruaj: vetjak property.
	vetja confirm.
	( 1 = 1 ) vërtetë: { Dalje shkruaj: vetjak property. vetja confirm. }.
	( 1 = 0 ) rreme: { Dalje shkruaj: vetjak property. vetja confirm. }.
	>> y := 2. { Dalje shkruaj: vetjak property. vetja confirm. } derisa: { y zbres: 1. <- (y > 0). }.
	{ Dalje shkruaj: vetjak property. vetja confirm. } × 1.
	(Listë ← 1) secili: {  Dalje shkruaj: vetjak property. vetja confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Fjalor ri one: ['item']) secili: { Dalje shkruaj: vetjak property. vetja confirm. }.
	{ 1 ÷ 0. } kap: { Dalje shkruaj: vetjak property. vetja confirm. }, nis.
	Dalje rresht-ri.
}.
function kur: ['confirm'] bëj: { Dalje shkruaj: [',']. }.
function zbato: 1 dhe: 2.
