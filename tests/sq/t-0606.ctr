>> Point := Objekt ri.
Point kur: ['x-coordinate:'] bëj: { :x vetjak x := x. }.
Point kur: ['y-coordinate:'] bëj: { :y vetjak y := y. }.
Point kur: ['x-coordinate']  bëj: { <- vetjak x kopjo. }.
Point kur: ['y-coordinate']  bëj: { <- vetjak y kopjo. }.

Point kur: ['='] bëj: { :other <- ( vetjak x = other x-coordinate
		 dhe: vetjak y = other y-coordinate ).
}.

>> pier := Point ri x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point ri x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point ri x-coordinate: 5, y-coordinate: 6.

Dalje shkruaj: pier = town-hall, rresht-ri.
Dalje shkruaj: pier = restaurant, rresht-ri.
