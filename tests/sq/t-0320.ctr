


>> CoffeeMachine := Objekt ri.
CoffeeMachine kur: ['order:'] bëj: { :id
	>> coffee := ['Americano'].
	( id = 1 ) vërtetë: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) vërtetë: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) vërtetë: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Objekt ri.
SimpleCoffeeMachine kur: ['order'] bëj: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Dalje shkruaj: redCup, rresht-ri.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Dalje shkruaj: greenCup, rresht-ri.
>> yellowCup := CoffeeMachine order: 1.
Dalje shkruaj: yellowCup, rresht-ri.
>> blueCup := CoffeeMachine order: 0.
Dalje shkruaj: blueCup, rresht-ri.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Dalje shkruaj: blackCup, rresht-ri.
blackCup shto-në-fund: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Dalje shkruaj: orangeCup, rresht-ri.
