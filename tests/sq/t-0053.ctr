60 × {
	>> x := (Numër random % 6) + 1.
	(x ≤ 6) rreme: { Dalje shkruaj: ['FAIL']. }.
	(x ≥0) rreme: { Dalje shkruaj: ['FAIL']. }.
	x := (Numër random % 3) + 1.
	(x < 3) rreme: { Dalje shkruaj: ['FAIL']. }.
	(x>-1) rreme: { Dalje shkruaj: ['FAIL']. }.
	x := ((Logjik flip) numër).
	(x = 0 ose: x = 1) rreme: { Dalje shkruaj: ['FAIL']. }.
	x := ((Vërtetë flip) numër).
	(x = 0 ose: x = 1) rreme: { Dalje shkruaj: ['FAIL']. }.
	x := (Logjik flip ose: ['HEAD'] ose: ['TAIL']).
	((x = ['HEAD']) ose: (x = ['TAIL'])) rreme: { Dalje shkruaj: ['FAIL']. }.
}.
Dalje shkruaj: ['DONE'].

