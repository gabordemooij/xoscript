Numër kur: ['factorial'] bëj: {
	>> total := 1.
	{ :index total shumëzo-me: (vetja - index). } × vetja. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program menaxhim-kujtese: 0.

{
2 exponent factorial.
