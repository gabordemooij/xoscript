#ffi test


Server init.

Program menaxhim-kujtese: 4.

# for this test you need set a path to libc (puts)
>> libname := Program cilësim: ['FFITESTLIB'].



Server lidh: (
 Listë ri ;
 libname ;
 ['puts'] ;
 ( Listë ri ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s liro.

# test with struct

>> a := Blob ri: 8.
a bytes: (
	Listë <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Listë <<: ['int'], ; ['int']).

Server lidh: (
	Listë <<: ['@structtest'], ;
	['@structtest'] ;
	(Listë <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Dalje shkruaj: ['Sum test:'] + (ffitest ffisum: a), rresht-ri.

struct liro-struct.
struct liro.
a liro.
