
Server init.
Dalje shkruaj: ['Database test'], rresht-ri.

>> db := Maria-DB ri pritës: ['localhost'],
	përdorues: ['xo'], 
	fjalëkalim: ['pass123'],
	emër-baze: ['xobase'],
	lidhu.

>> parametra-kërkimi :=
db pyetësor: ['SELECT REPEAT('Blah',1000) AS blah'], 
merr: { :row 
	Dalje shkruaj: row blah gjatësi, rresht-ri.
}.
