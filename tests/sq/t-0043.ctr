>> repeater := Objekt ri.
repeater kur: ['përgjigju:'] bëj: { :what
	Dalje shkruaj: what + [' '].
}.
repeater kur: ['përgjigju:dhe:'] bëj: { :what :say
	Dalje shkruaj: what, shkruaj: say + [' '].
}.
repeater kur: ['përgjigju:dhe:dhe:'] bëj: { :what :say :more
	Dalje shkruaj: what, shkruaj: say, shkruaj: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
