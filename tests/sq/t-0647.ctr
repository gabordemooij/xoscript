Server init.
Dalje shkruaj: ['Database time test'], rresht-ri.

>> db := Maria-DB ri pritës: ['localhost'],
	përdorues: ['xo'], 
	fjalëkalim: ['pass123'],
	emër-baze: ['xobase'],
	lidhu.

>> parametra-kërkimi :=
db pyetësor: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
merr: { :row
	Dalje shkruaj: row timetest, rresht-ri.
}.
