>> t := Vërtetë.
(t = Vërtetë) vërtetë: { Dalje shkruaj: ['T']. }.
(t = Rreme) vërtetë: { Dalje shkruaj: ['F']. }.
Dalje shkruaj: ['|'].
>> t := Rreme.
(t = Vërtetë) vërtetë: { Dalje shkruaj: ['T']. }.
(t = Rreme) vërtetë: { Dalje shkruaj: ['F']. }.
Dalje shkruaj: ['|'].
>> f := Vërtetë.
(t = Vërtetë dhe: f = Rreme) vërtetë: { Dalje shkruaj: ['T']. }.
(t = Rreme dhe: f = Vërtetë) vërtetë: { Dalje shkruaj: ['F']. }.
Dalje shkruaj: ['|'].
>> n := Asgjë.
(n Asgjë?) vërtetë: { Dalje shkruaj: ['T']. }.
(n Asgjë?) rreme: { Dalje shkruaj: ['F']. }.
Dalje shkruaj: ['|'].
(f Boolean?) vërtetë: { Dalje shkruaj: ['T']. }.
(f Boolean?) rreme: { Dalje shkruaj: ['F']. }.



