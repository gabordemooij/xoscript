
>> Rectangle := Objekt ri.

Rectangle kur: ['area'] bëj: { <- vetjak gjatësi * vetjak width.
}.

Rectangle kur: ['length:'] bëj: { :gjatësi
	vetjak gjatësi := gjatësi.
}.

Rectangle kur: ['width:'] bëj: { :width
	vetjak width := width.
}.

Rectangle kur: ['ri'] bëj: {
	# this will not result into an infinite loop
	>> rectangle := vetja ri.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle ri.
Dalje shkruaj: a area, rresht-ri. #0

>> b := Rectangle ri length: 2, width: 3.
Dalje shkruaj: b area, rresht-ri. #6

