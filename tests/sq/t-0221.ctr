>> x := Objekt ri.
>> y := Objekt ri.
>> z := x.
Dalje shkruaj: (x = z), rresht-ri.
Dalje shkruaj: (x = y), rresht-ri.
Dalje shkruaj: (x ≠ y), rresht-ri.
Dalje shkruaj: (x ≠ z), rresht-ri.
>> m := Moment ri vit: 2070, muaj: 11.
>> n := m kopjo.
Dalje shkruaj: (m = n), rresht-ri.
Dalje shkruaj: (m ≠ n), rresht-ri.
Dalje shkruaj: (m baras: m), rresht-ri.
Dalje shkruaj: (m baras: n), rresht-ri.
n muaj: 12.
Dalje shkruaj: (m ≠ n), rresht-ri.
Dalje shkruaj: (m = n), rresht-ri.


