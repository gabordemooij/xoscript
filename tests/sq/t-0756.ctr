Dalje shkruaj: ['Test object'], rresht-ri.
>> greeter := Objekt ri.
greeter kur: ['name:'] bëj: { :emër
	vetjak xname := emër. 
}.
greeter kur: ['greet'] bëj: {
	Dalje shkruaj: ['Hello '] + vetjak xname, rresht-ri.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Dalje shkruaj: ['========== RELOADING SNAP:'], rresht-ri.
>> b := Objekt load-from: ['/tmp/a.bin'].
>> c := Objekt load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
