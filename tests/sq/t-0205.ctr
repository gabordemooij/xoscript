>> str := ['write:'].
Dalje mesazh: ['shkruaj:'] argumente: (Listë ← ['Hello World']), rresht-ri. 

Numër kur: ['isbetween:and:'] bëj: { :a :b <- ((vetja ≥ a) dhe: (vetja ≤ b)).
}.

str := ['isbetween:and:'].
Dalje shkruaj: (3 mesazh: str argumente: (Listë ← 2 ; 8)), rresht-ri.
Dalje shkruaj: (3 mesazh: str argumente: (Listë ← 1 ; 2)), rresht-ri.


>> CoffeeMachine := Objekt ri.
CoffeeMachine kur: ['makeCoffeeWithSugar:milk:'] bëj: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Listë ← 4 ; 2.
Dalje shkruaj: ( CoffeeMachine mesazh: order argumente: coffeeConfiguration ), rresht-ri.
