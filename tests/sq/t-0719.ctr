Server init.
>> fmt := Format ri: ['%#3x'].

>> blob := Blob ri: 4.
blob bytes: ( 
	Listë ri ; 0 ; 1 ; 2 ; 3
).

>> file := Skedar ri: ['/tmp/blob'].
file blob: blob.
blob liro.

>> lexo := file blob.
lexo 
nga: 0 
gjatësi: 4, 
bëj secili: { :i :b 
	Dalje
	shkruaj: (fmt zbato-plotë: b),
	rresht-ri.
}.
lexo liro.
