# test list operations


>> cakes := Listë ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes zëvendëso: 1 gjatësi: 2 me: ( Listë ← ['cinnamon'] ; ['pineapple'] ).
Dalje shkruaj: (buy bashko: [',']), rresht-ri.


>> buy := cakes zëvendëso: 1 gjatësi: 12 me: ( Listë ← ['cinnamon'] ; ['pineapple'] ).
Dalje shkruaj: (buy bashko: [',']), rresht-ri.


>> buy := cakes zëvendëso: 2 gjatësi: 10 me: ( Listë ri ).
Dalje shkruaj: (buy bashko: [',']), rresht-ri.


>> buy := cakes zëvendëso: 0 gjatësi: 1 me: ( Listë ri ).
Dalje shkruaj: (buy bashko: [',']), rresht-ri.


>> buy := cakes zëvendëso: ['0'] gjatësi: ['1'] me: ['x'].
Dalje shkruaj: (buy bashko: [',']), rresht-ri.
