Listë kur: ['kopjo'] bëj: {
	>> kopjo := Listë ri.
	vetja secili: { :numër :section
		kopjo shto-në-fund: section rekursiv kopjo.
	}. <- kopjo.
}.

>> sheep := Listë ri ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep kopjo.
clones secili: { :numër :sheep
	sheep shto-në-fund: ['2'].
}.

Dalje shkruaj: sheep, rresht-ri.
Dalje shkruaj: clones, rresht-ri.
