>> a := 3.
>> b := a kopjo.
a zbres: 1.
Dalje shkruaj: [' a = '] + a.
Dalje shkruaj: [' b = '] + b.
a := 3.
b := a + 4.
Dalje shkruaj: [' a = '] + a.
Dalje shkruaj: [' b = '] + b.
>> x := 3.
>> y := x kopjo.
x shto: 10.
y zbres: 1.
Dalje shkruaj: [' x = '] + x.
Dalje shkruaj: [' y = '] + y.
>> q := Objekt ri.
q kur: ['setProperty:'] bëj: { :x
	vetjak prop := x.
}.
q kur: ['getProperty'] bëj: { <- vetjak prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Dalje shkruaj: [' p = '] + (p getProperty).
