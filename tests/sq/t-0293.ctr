
>> city := Listë ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Listë ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature sipas: city.
>> cities := weather hyrjet rendit: { :a :b <- (a krahaso: b). }.
>> temperatures := weather vlera rendit: { :a :b <- (a krahaso: b) negativ?. }.

Dalje shkruaj: (cities bashko: [',']), rresht-ri.
Dalje shkruaj: (temperatures bashko: [',']), rresht-ri.
