
Tekst kur: ['evaluate'] bëj: {
	>> kod := Skedar ri: ['/tmp/eval.ctr'].
	kod shkruaj: (vetja tekst + ['.']).
	Program përdor: ['/tmp/eval.ctr'].
}.

>> map :=
	(Fjalor ri)
	vendos: ['Hi There'] në: ['two'],
	vendos: (Listë ← ['hello'] ; ['world'] ; (Listë ← 1 ; 2; 9) ; Rreme) në: ['one'],
	vendos: ( (Fjalor ri) vendos: ['wrrld'] në: ['misspelled'] ) në: ['three'],
	vendos: (Listë ← ((Fjalor ri) vendos: ['treasure'] në: ['hidden']) ; 2) në: ['four']. 
>> str := map tekst.
>> map2 := Asgjë.
(['map2 := '] + str ) evaluate.
Dalje shkruaj: map2 ? ['one'] ? 0.
Dalje shkruaj: map2 ? ['one'] ? 1.
Dalje shkruaj: map2 ? ['four'] ? 0 ? ['hidden'].
Dalje shkruaj: map2 ? ['one'] ? 2 ? 2.
