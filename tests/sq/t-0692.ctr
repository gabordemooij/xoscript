Server init.

Dalje shkruaj: (
	Model ri: ['^\\w+$'],
	përputhje: ['test@example.com'] 
), rresht-ri. # 0 match, fails on @ and .

Dalje shkruaj: (
	Model ri: ['^[^@]+@[^\.]+\.\\w+$'],
	përputhje: ['test@example.com'] 
), rresht-ri. # 1 match

Dalje shkruaj: (
	Model ri: ['[^@]+@[^\.]+\.\\w+'],
	përputhje: ['test@example.com'] 
), rresht-ri. # 1 match

Dalje shkruaj: (
	Model ri: ['([^@]+)@([^\.]+)\.\\w+'],
	përputhje: ['test@example.com'] 
), rresht-ri. # 1 match, groups dont matter

Dalje shkruaj: (
	Model ri: ['[a-z]'],
	përputhje: ['test@example.com'] 
), rresht-ri. # 14 matches

Dalje shkruaj: (
	Model ri: ['.*'],
	përputhje: ['test@example.com'] 
), rresht-ri. # 1 match (all)

Dalje shkruaj: (
	Model ri: ['(.*)'],
	përputhje: ['test@example.com'] 
), rresht-ri. # 1 match (all)

Dalje shkruaj: (
	Model ri: ['\\s*[^@]+@[^\.]+\.\\w+'],
	përputhje: ['test@example.com'] 
), rresht-ri. # 1 match, prefix space optional, gets ignored