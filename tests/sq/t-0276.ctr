>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objekt ri.
⚄ kur: ['drawFrom:length:'] bëj: { :pool :numëro
	
	>> result := [''].
	
	{
		>> index := Numër random % (pool gjatësi).
		result shto-në-fund: ( pool shkronjë: (index + 1) ).
		
	} × numëro. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? gjatësi.
Dalje shkruaj: (['x↵'] x random gjatësi).
Dalje shkruaj: (['y↵'] y ?? gjatësi).

