
>> countries := Listë ri
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Listë ri
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods sipas: countries, secili: { :key :value
	counter shto: 1.
}.

Dalje shkruaj: (['we serve counter dishes'] counter: counter), rresht-ri.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] shkronja rendit: { :v
	counter shto: 0.
}.

Dalje shkruaj: (['we sort counter dishes'] counter: counter), rresht-ri.


>> counter := 0.
{
	{
		counter shto: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Dalje shkruaj: (['we calculate counter numbers.'] counter: counter), rresht-ri.

