Server init.
>> f := Format ri: ['%d'].
>> a := Blob ri: 4.
a bytes: ( Listë ri ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob ri: 4.
b bytes: ( Listë ri ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a nga: 0 gjatësi: 3, secili: { :i :byte
	Dalje shkruaj: ( f zbato-plotë: byte ), rresht-ri.
}.
a ^ b.
a nga: 0 gjatësi: 3, secili: { :i :byte
	Dalje shkruaj: ( f zbato-plotë: byte ), rresht-ri.
}.
a ^ b.
a nga: 0 gjatësi: 3, secili: { :i :byte
	Dalje shkruaj: ( f zbato-plotë: byte ), rresht-ri.
}.
a liro.
b liro.

{ a ^ Objekt. } kap: { :e Dalje shkruaj: e, rresht-ri. }, nis.
