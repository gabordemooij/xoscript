{
	kjo-detyrë gabim: ['Dont fail.'].
	unknown doSomething.
} kap: {
	Dalje shkruaj: ['Caught!'].
}, nis.

{
	kjo-detyrë gabim: ['Dont fail.'].
	vetjak unknown doSomething.
} kap: {
	Dalje shkruaj: ['Caught!'].
}, nis.

{
	kjo-detyrë gabim: ['Dont fail.'].
	unknown := 122.
} kap: {
	Dalje shkruaj: ['Caught!'].
}, nis.


{
	kjo-detyrë gabim: ['Dont fail.'].
	Vërtetë ndërprit.
	Dalje shkruaj: ['FAIL'].
} kap: {
	Dalje shkruaj: ['Caught!'].
}, nis.

{
	{
		kjo-detyrë gabim: ['Dont fail.'].
		Vërtetë ndërprit.
		Dalje shkruaj: ['FAIL'].
	} kap: { :x
		(x = ['Dont fail.']) vërtetë: { kjo-detyrë gabim: ['Nested Caught!']. }.
	}, nis.
} kap: { :e
	Dalje shkruaj: e.
}, nis.
