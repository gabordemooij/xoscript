>> Animal := Objekt ri.
Animal kur: ['make'] bëj: {
	>> animal := Objekt ri.
	animal kur: ['makeSound'] bëj: {
		Dalje shkruaj: vetjak sound.
	}. <- animal.
}.
>> Cat := Objekt ri.
Cat kur: ['make'] bëj: {
	>> cat := Animal make.
	cat kur: ['init'] bëj: {
		vetjak sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
