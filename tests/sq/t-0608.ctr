
>> Size := Objekt ri.
Size kur: ['is:'] bëj: { :numër
	numër kur: ['+'] bëj: { :numër
		>> unit := numër cilësor.
		>> factor := 1.
		
		unit
		rast: ['inch'] bëj: { factor := 0.0833. }. <- vetja + (numër * factor).
	}. <- numër.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Dalje shkruaj: plank + edge, rresht-ri.
