Dalje shkruaj: ['Test object'], rresht-ri.
>> a := Objekt ri. 

a kur: ['item:'] bëj: { :moment
	vetjak moment := moment. 
}.

a kur: ['item'] bëj: { <- vetjak moment.
}.

>> today := Listë ri ; ( Moment ri zonë: ['CEST'], vit: 2026, muaj: 7 ).
a item: today.
Dalje shkruaj: a item ? 0, rresht-ri.
a save-as: ['/tmp/a.bin'].
