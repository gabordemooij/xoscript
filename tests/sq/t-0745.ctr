Dalje shkruaj: ['Test object'], rresht-ri.
>> a := Objekt ri. 

a kur: ['item:'] bëj: { :dict
	vetjak dict := dict. 
}.

a kur: ['item'] bëj: { <- vetjak dict.
}.

a item: (
Fjalor ri
	hello: ['world']).

>> old-dict-address := a item prototip adresë-kujtese.
a save-as: ['/tmp/a.bin'].
Dalje shkruaj: ['========== RELOADING SNAP:'], rresht-ri.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototip adresë-kujtese = old-dict-address) vërtetë: {
	Dalje shkruaj: ['Object link re-attached.'], rresht-ri.
}.

Dalje shkruaj: b item, rresht-ri.
