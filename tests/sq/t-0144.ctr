



>> CoffeeGrounds := Objekt ri.
CoffeeGrounds kur: ['extract'] bëj: { <- ['coffee']. }.

>> CoffeeMachine := Objekt ri.
CoffeeMachine kur: ['init'] bëj: {
	vetjak coffeegrounds := CoffeeGrounds ri.
}.
CoffeeMachine kur: ['ri'] bëj: { <- CoffeeMachine `new init.
}.

CoffeeMachine kur: ['makeTea'] bëj: { <- (vetjak tealeaves extract). }.
CoffeeMachine kur: ['makeCoffee'] bëj: { <- (vetjak coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine ri.

Dalje shkruaj:
	coffeeDream 
	makeCoffee.

Dalje shkruaj:
	coffeeDream 
	makeTea.
