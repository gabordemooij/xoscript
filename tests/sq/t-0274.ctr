

Listë kur: ['column:'] bëj: { :column
	>> result := Listë ri.
	vetja secili: { :index :row
		row secili: { :index :cell
			(index = column) vërtetë: { result shto-në-fund: cell. }.
		}.
	}. <- result.
}.


>> a := Listë ←
	(Listë ← 1 ; 2 ; 3) ;
	(Listë ← 4 ; 5 ; 6) ;
	(Listë ← 7 ; 8 ; 9).

>> b := a column: 1.
Dalje shkruaj: b, rresht-ri.

b := a column: 20.
Dalje shkruaj: b, rresht-ri.

b := a column: -100.
Dalje shkruaj: b, rresht-ri.
