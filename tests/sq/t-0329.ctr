Dalje shkruaj: ((Listë ri
	kur: ['plaque:'] bëj: { :x vetjak o := x. },
	kur: ['plaque']  bëj: { <- vetjak o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Listë ← 1)
	~ (Listë ← 1 ; 2)
	~ (Listë ← 1 ; 2 ; 3)
	~ (Listë ← 1 ; 2 ; 3 ; 4)
	~ (Listë ← 1 ; 2 ; 3 ; 4 ; 5)
) secili: { :i :el
	{ Dalje shkruaj: kjo-detyrë. } × el numëro.
	Dalje rresht-ri.
}) plaque, rresht-ri.


