>> randomizer := { :a :b
	>> minimum := ( a < b ) ose: a ose: b.
	>> maksimum := ( a > b ) ose: a ose: b.
	>> x := Asgjë.
	{
		x := Numër midis: a dhe: b.
		((x < minimum) ose: (x > maksimum)) vërtetë: { 
			Dalje shkruaj: (['Invalid value!']).
			Program fund.
		}.
	} 
	× 100. <- x.
}.
randomizer zbato: 0 dhe: 0.
randomizer zbato: 1 dhe: 0.
