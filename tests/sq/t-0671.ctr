# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Kasafortë gjenero-çelësa.

# private (secret) key
>> sk := keys parë.

# public key
>> pk := keys fundit.

# sign a message
>> sig := Kasafortë nënshkruaj: ['abc'] me: sk.

# check message (ok)
Dalje shkruaj: ( 
	Kasafortë
		kontrollo: ['abc'] 
		nënshkrim: sig 
		me: pk 
), rresht-ri.

# check message (fail)
Dalje shkruaj: ( 
	Kasafortë 
		kontrollo: ['abd'] 
		nënshkrim: sig 
		me: pk 
), rresht-ri.