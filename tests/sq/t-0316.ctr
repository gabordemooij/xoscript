>> Grandfather := Objekt ri.
Grandfather kur: ['greet'] bëj: {
	Dalje shkruaj: ['Ave!'], rresht-ri.
}.
>> Father := Grandfather ri.
Father kur: ['greet'] bëj: {
	Dalje shkruaj: ['Hello'], rresht-ri.
	vetja greet.
}.
>> Son := Father ri.
Son kur: ['greet'] bëj: {
	Dalje shkruaj: ['Hi'], rresht-ri.
	vetja greet.
}.

Son greet.

>> Roundabout := Objekt ri.
Roundabout kur: ['circle:'] bëj: { :x
	Dalje shkruaj: x, rresht-ri.
	(x < 3) vërtetë: { vetja rekursiv circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) vërtetë: { Dalje shkruaj: x, rresht-ri. x shto: 1.  increment nis. }. }.
increment nis.