# compliance test

# use international numbers

Dalje shkruaj: ['1000 -> '].
Dalje shkruaj: 1000, rresht-ri. #1000

Dalje shkruaj: ['1.5 -> '].
Dalje shkruaj: 1.5, rresht-ri.  #1.5

Dalje shkruaj: ['1001.5 -> '].
Dalje shkruaj: 1.5 + 1000, rresht-ri. #1001.5

# use 0-indexed arrays
>> x := Listë ri ; 1 ; 2 ; 3.
>> y := Listë ri ; ['a'] ; ['b'] ; ['c'].

Dalje shkruaj: ['1 -> '].
Dalje shkruaj: x ? 0, rresht-ri. #1

Dalje shkruaj: ['1 -> '].
Dalje shkruaj: (x në: 0), rresht-ri. #1

Dalje shkruaj: ['1 -> '].
Dalje shkruaj: x parë, rresht-ri. #1

Dalje shkruaj: ['3 -> '].
Dalje shkruaj: x fundit, rresht-ri. #3

Dalje shkruaj: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Dalje shkruaj: (x sipas: y), rresht-ri.

Dalje shkruaj: ['1 -> '].
Dalje shkruaj: (x nga: 0 gjatësi: 1) parë, rresht-ri. #1

Dalje shkruaj: ['0 -> '].
Dalje shkruaj: (x gjej: 1), rresht-ri. #0

x vendos: 9 në: 0.

Dalje shkruaj: ['9 -> '].
Dalje shkruaj: (x në: 0), rresht-ri. #9

x shto-në-fillim: 8.
Dalje shkruaj: ['8 -> '].
Dalje shkruaj: (x në: 0), rresht-ri. #9


x shto-në-fund: 10.
Dalje shkruaj: ['10 -> '].
Dalje shkruaj: (x në: 4), rresht-ri. #10








