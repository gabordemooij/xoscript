# catch-all test (practical)
>> HTML := Tekst ri.
HTML kur: ['encode:'] bëj: { :tekst
	vetja shto-në-fund: (tekst
	zëvendëso: ['&'] me: ['&amp;'], 
	zëvendëso: ['<'] me: ['&lt;'],
	zëvendëso: ['>'] me: ['&gt;'],
	zëvendëso: ['"'] me: ['&quot;']).
}.
>> blog := HTML ri.
blog shto-në-fund: ['<h1>'],
     encode: ['Koffie & Thee'],
     shto-në-fund: ['</h1>'].
Dalje shkruaj: blog, rresht-ri.


>> Roman := Numër ri.
Roman kur: ['stringy'] bëj: {
	>> a := [''].
	{ a shto-në-fund: ['I']. } × vetja. <- a.
}.

>> x := Roman ri.
x shto: 3.
Dalje shkruaj: x stringy, rresht-ri.

>> Quantum := Logjik ri.
Quantum kur: ['true?'] bëj: { <- ['maybe True']. }.
Dalje shkruaj: (Quantum ri true?), rresht-ri.

>> Nihil := Asgjë ri.
Nihil kur: ['tekst'] bëj: { <- ['Nihil']. }.
Dalje shkruaj: (Nihil ri), rresht-ri.
