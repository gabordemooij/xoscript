
Server init.
Dalje shkruaj: ['Database test'], rresht-ri.

>> db := Maria-DB ri pritës: ['localhost'],
	përdorues: ['xo'], 
	fjalëkalim: ['pass123'],
	emër-baze: ['xobase'],
	lidhu.

>> parametra-kërkimi :=
db pyetësor: ['SELECT UNHEX('CAFE') AS blobby'],
merr: { :row
	Dalje shkruaj: ( row blobby nga: 0 gjatësi: 2 ), rresht-ri.
	row blobby liro.
}.
