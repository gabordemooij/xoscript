Dalje shkruaj: ['Test object'], rresht-ri.
>> a := Objekt ri. 
a kur: ['item:'] bëj: { :lst
	vetjak lst := lst. 
}.
a kur: ['item'] bëj: { <- vetjak lst.
}.
a item: (
	Listë ri ; 1 ; (
		Listë ri ; ['a'] ; (
			Listë ri ; ( Moment ri: 1 )
		) ; ( Int64 prej-teksti: ['321'] )
	)
).
Dalje shkruaj: a item, rresht-ri.
>> old-lst-address := a item prototip adresë-kujtese.
a save-as: ['/tmp/a.bin'].
Dalje shkruaj: ['========== RELOADING SNAP:'], rresht-ri.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b item prototip adresë-kujtese = old-lst-address) vërtetë: {
	Dalje shkruaj: ['Object link re-attached.'], rresht-ri.
}.
Dalje shkruaj: ( b item ), rresht-ri.
