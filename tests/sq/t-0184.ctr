

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program menaxhim-kujtese: 0.

Numër kur: ['addNum:'] bëj: { :x
	vetja shto: x.
}.

Numër kur: ['subtractNum:'] bëj: { :x
	vetja zbres: x.
}.

Numër kur: ['multiplyBy:'] bëj: { :x
	vetja shumëzo-me: x.
}.

Numër kur: ['divideBy:'] bëj: { :x
	vetja pjesëto-me: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 fuqi: 8).  
a := a + (2 fuqi: -1). 
a := a + (49 rrënjë-katrore).   
a addNum: ((Listë ← 0 ; 1) maksimum).          
a addNum: ((Listë ← 2 ; 3) minimum).
Dalje shkruaj: a.

Program pastro.

usedMemory1 := (Program kujtesë ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
