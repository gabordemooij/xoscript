Server init.
Dalje shkruaj: ['Database datetime test'], rresht-ri.

>> db := Maria-DB ri pritës: ['localhost'],
	përdorues: ['xo'], 
	fjalëkalim: ['pass123'],
	emër-baze: ['xobase'],
	lidhu.

>> parametra-kërkimi :=
db pyetësor: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
merr: { :row
	Dalje shkruaj: row datetimetest, rresht-ri.
}.
