Dalje shkruaj: ['Test object'], rresht-ri.
>> a := Objekt ri. 

a kur: ['item:'] bëj: { :num
	vetjak num := num. 
}.

a kur: ['item'] bëj: { <- vetjak num.
}.

a item: 123.

Dalje shkruaj: a item, rresht-ri.

>> old-num-address := a item prototip adresë-kujtese.
a save-as: ['/tmp/a.bin'].
Dalje shkruaj: ['========== RELOADING SNAP:'], rresht-ri.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototip adresë-kujtese = old-num-address) vërtetë: {
	Dalje shkruaj: ['Object link re-attached.'], rresht-ri.
}.

Dalje shkruaj: b item, rresht-ri.
