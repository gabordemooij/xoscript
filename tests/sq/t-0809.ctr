# backslashes must survive code serialization, strings must not end early
>> vlera := Listë ri
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

vlera secili: { :i :value
	>> d := Fjalor ri.
	d vendos: value në: ['k'].
	>> r := d kod objekt.
	Dalje shkruaj: r numëro, rresht-ri.
	Dalje shkruaj: ( (r në: ['k']) = value ), rresht-ri.
}.
