#Linux

(Skedar ri: ['/tmp/testje']) ekziston rreme: {
	Program sistem: ['mkdir /tmp/testje'].	
}.

(Skedar ri: ['/tmp/testje/file1']) ekziston rreme: {
	Program sistem: ['touch /tmp/testje/file1'].	
}.

(Skedar ri: ['/tmp/testje/folder1']) ekziston rreme: {
	Program sistem: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Skedar listë: ['/tmp/testje'].

>> q := Listë ri.

l secili: { :k :v v secili: { :x :y q shto-në-fund: y. }. }.

>> s := q tekst.

(s përmban: ['file1']) vërtetë:   { Dalje shkruaj: ['OK'], rresht-ri. }.
(s përmban: ['file2']) vërtetë:   { Dalje shkruaj: ['XX'], rresht-ri. }.
(s përmban: ['folder1']) vërtetë: { Dalje shkruaj: ['OK'], rresht-ri. }.
