# test qualifiers

>> $ := Objekt ri.

$ kur: ['përgjigju:'] bëj: { :x
	
	>> operation := x shkronjë: 0.
	>> valuta := x shkronjë: 1.
	>> money := x zhvendosje: 2.
	
	>> amount := 0.

	( operation = ['+'] ) vërtetë: {
		( valuta = ['£'] ) vërtetë: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Dalje shkruaj: x, rresht-ri.


>> Fruit := Objekt ri.

Fruit kur: ['ri'] bëj: {
	>> f := vetja ri.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit kur: ['apples:'] bëj: { :a vetjak apples := a. }.
Fruit kur: ['oranges:'] bëj: { :p vetjak oranges := p. }.
Fruit kur: ['apples'] bëj: { <- vetjak apples. }.
Fruit kur: ['oranges'] bëj: { <- vetjak oranges. }.

Fruit kur: ['+'] bëj: { :f
	
	>> n := Fruit ri.
	f shto: 1.
	
	n apples: (f apples + vetjak apples).
	n oranges:  (f oranges  + vetjak oranges). <- n.
}.

Fruit kur: ['tekst'] bëj: { <- ( vetjak apples tekst + [' apples and '] + vetjak oranges + [' oranges'] ).
}.

Numër kur: ['apples'] bëj: { <- ((Fruit ri) apples: vetja).
}.

Numër kur: ['apple'] bëj: { <- ((Fruit ri) apples: vetja).
}.

Numër kur: ['oranges'] bëj: { <- ((Fruit ri) oranges: vetja).
}.




Dalje shkruaj: (1 apple + 3 oranges + 4 apples), rresht-ri.


Tekst kur: ['twice'] bëj: { <- ((vetja tekst) + (vetja tekst)).
}.



Dalje shkruaj: ['❤❤❤'] twice.



