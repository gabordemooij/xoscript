Numër kur: ['roman'] bëj: {
	>> numër := vetja kopjo.
	>> roman := [''].
	{
		{
			(numër ≥ 1000) vërtetë: {
				roman shto-në-fund: ['Ⅿ'].
				numër zbres: 1000.
			}, ndërprit.
		
			(numër ≥ 500) vërtetë: {
				roman shto-në-fund: ['Ⅾ'].
				numër zbres: 500.
			}, ndërprit.
		
			(numër ≥ 100) vërtetë: {
				roman shto-në-fund: ['Ⅽ'].
				numër zbres: 100.
			}, ndërprit.
		
			(numër ≥ 50) vërtetë: {
				roman shto-në-fund: ['Ⅼ'].
				numër zbres: 50.
			}, ndërprit.
		
			(numër ≥ 50) vërtetë: {
				roman shto-në-fund: ['Ⅼ'].
				numër zbres: 50.
			}, ndërprit.
		
			(numër ≥ 10) vërtetë: {
				roman shto-në-fund: ['Ⅹ'].
				numër zbres: 10.
			}, ndërprit.
			
			(numër ≥ 9) vërtetë: {
				roman shto-në-fund: ['Ⅸ'].
				numër zbres: 9.
			}, ndërprit.
			
			(numër ≥ 5) vërtetë: {
				roman shto-në-fund: ['Ⅴ'].
				numër zbres: 5.
			}, ndërprit.
			
			(numër ≥ 4) vërtetë: {
				roman shto-në-fund: ['Ⅳ'].
				numër zbres: 4.
			}, ndërprit.
			
			(numër ≥ 1) vërtetë: {
				roman shto-në-fund: ['Ⅰ'].
				numër zbres: 1.
			}, ndërprit.
		} procedurë.
	} derisa: { <- numër > 0. }. <- roman.
}.

Dalje shkruaj: 1 roman, rresht-ri.
Dalje shkruaj: 2 roman, rresht-ri.
Dalje shkruaj: 4 roman, rresht-ri.
Dalje shkruaj: 8 roman, rresht-ri.
Dalje shkruaj: 16 roman, rresht-ri.
Dalje shkruaj: 32 roman, rresht-ri.
Dalje shkruaj: 64 roman, rresht-ri.
Dalje shkruaj: 128 roman, rresht-ri.
Dalje shkruaj: 256 roman, rresht-ri.
Dalje shkruaj: 1024 roman, rresht-ri.
