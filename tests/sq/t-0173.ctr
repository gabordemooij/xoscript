

Listë kur: ['sum'] bëj: {
	>> total := 0.
	vetja secili: { :index :element
		total shto: element.
	}. <- total.
}.

Listë kur: ['product'] bëj: {
	>> total := 1.
	vetja secili: { :index :element
		total shumëzo-me: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program menaxhim-kujtese: 0.

{

>> a := Listë ← ['hello'] ; ['world'] ; Vërtetë ; Asgjë ; 666.
a := a + ( Listë ← 1 ).
Dalje shkruaj: ( ['sum: '] + ( a sum ) ), rresht-ri.
Dalje shkruaj: ( ['min: '] + ( a minimum ) ), rresht-ri.
Dalje shkruaj: ( ['max: '] + ( a maksimum ) ), rresht-ri.
Dalje shkruaj: ( ['3rd: '] + ( a ? 2 ) ), rresht-ri.
Dalje shkruaj: ( ['prd: '] + ( a product ) ), rresht-ri.
a rendit: { :a :b <- (b - a). }.
a secili: { :i :e Dalje shkruaj: ( i - 0 ), rresht-ri. }.

} nis.

