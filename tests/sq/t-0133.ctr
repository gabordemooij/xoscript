


>> Deck := Listë ri.
Deck kur: ['print'] bëj: {
        >> len := vetja numëro - 1.
        { :i
                >> len2 := vetja numëro - 1.
                Dalje shkruaj: ['len: '].
                Dalje shkruaj: len, rresht-ri.
                Dalje shkruaj: ['len2: '].
                Dalje shkruaj: len2, rresht-ri.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
