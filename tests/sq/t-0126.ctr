#Linux
>> Slurp := Objekt ri.

Slurp kur: ['ri'] bëj: {
	vetjak str := [''].
}.

Slurp kur: ['nieuw'] bëj: {
	vetjak str := [''].
}.

Slurp kur: ['përgjigju:'] bëj: { :blah
		vetjak str shto-në-fund: blah.
}.

Slurp kur: ['përgjigju:dhe:'] bëj: { :blah :blahah
		vetjak str shto-në-fund: (blah nga: 0 gjatësi: (blah gjatësi - 1)).
		vetjak str shto-në-fund: [' '].
		vetjak str shto-në-fund: blahah.
}.

Slurp kur: ['obtain'] bëj: {
	>> buffer := vetjak str.
	vetjak str := ['']. <- buffer.
}.


Dalje shkruaj: (Program sistem: (Slurp ri echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Skedar ri: ['/tmp/from.txt'], fshi. } kap: { ['Empty']. }, nis.
{ Skedar ri: ['/tmp/to.txt'], fshi. } kap: { ['Empty']. }, nis.


Skedar ri: ['/tmp/to.txt'], ekziston rreme: {
	Dalje shkruaj: ['Confirmed. Target file does not exist.\
'].
}.
Skedar ri: ['/tmp/from.txt'], ekziston rreme: {
	Dalje shkruaj: ['Confirmed. Source file does not exist.\
'].
}.



Program sistem: (Slurp ri touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Program sistem: (Slurp ri cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Skedar ri: ['/tmp/to.txt'], ekziston vërtetë: {
	Dalje shkruaj: ['Confirmed. Target file has been created by shell.\
'].
}.


Dalje shkruaj: ['Contents of file is:'] + (Skedar ri: ['/tmp/to.txt'], lexo), rresht-ri.
