
Server init.
>> rq := HTTP-Kërkesë ri.
Dalje shkruaj: ['HTTP-GET d[]=']  + ( rq get-listë: ['d[]'] ), rresht-ri. # GET
Dalje shkruaj: ['HTTP-GET f[]=']  + ( rq get-listë: ['f[]'] ), rresht-ri. # GET
Dalje shkruaj: ['HTTP-POST e[]='] + ( rq post-listë: ['e[]'] ), rresht-ri. # GET
Dalje shkruaj: ['HTTP-POST c=']   + ( rq post: ['c'] ), rresht-ri. # GET
Dalje shkruaj: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), rresht-ri. # GET
