
>> a := Listë ← (Listë ← 100 ; 200 ; 300) ; (Listë ← 9 ; 8 ; 7).
Dalje shkruaj: ['at 0,1 :'].
Dalje shkruaj: a ? 0 ? 1, rresht-ri. 
Dalje shkruaj: ['at 1,2 :'].
Dalje shkruaj: a ? 1 ? 2, rresht-ri. 
>> menu := Fjalor ri.
menu vendos: (Listë ← ['pizza'] ; ['spaghetti']) në: ['Italian Cuisine'].
menu vendos: (Listë ← ['bifteki'] ; ['suflaki']) në: ['Greek Cuisine'].
Dalje shkruaj: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), rresht-ri. 
Dalje shkruaj: ['but not on the same plate.'], rresht-ri.
