>> invoice := Objekt ri.
invoice kur: ['nis'] bëj: {
        vetjak numër := 0.
}.

invoice kur: ['numër'] bëj: {
        vetjak numër shto: 1. <- vetjak numër kopjo.
}.

>> year-invoice := invoice ri.
year-invoice kur: ['start:'] bëj: { :vit
	vetjak numër := vit.
}.

year-invoice start: 202000.
Dalje shkruaj: year-invoice numër, rresht-ri.
Dalje shkruaj: year-invoice numër, rresht-ri.
