Server init.

>> DB := Maria-DB ri pritës: ['localhost'],
	përdorues: ['xo'],
	fjalëkalim: ['pass123'],
	emër-baze: ['xobase'],
	lidhu.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> parametra-kërkimi := Maria-Pyetësor ri: SQL.

# set database
parametra-kërkimi bazë-të-dhënash: DB.

parametra-kërkimi merr: { :row
	Dalje shkruaj: row world, rresht-ri.
}.
