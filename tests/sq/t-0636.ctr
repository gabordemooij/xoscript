# test url parsing

Server init.
>> url := URL prej: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Dalje shkruaj: ['scheme = '] + url skemë, rresht-ri.
Dalje shkruaj: ['host = '] + url pritës, rresht-ri.
Dalje shkruaj: ['port = '] + url portë, rresht-ri.
Dalje shkruaj: ['path = '] + url shteg, rresht-ri.
Dalje shkruaj: ['query = '] + url parametra-kërkimi, rresht-ri.
Dalje shkruaj: ['fragment = '] + url fragment, rresht-ri.
