>> winery := { <- (	Fjalor ri
		vendos: 2 në: ['merlot'],
		vendos: 3 në: ['malbec'],
		vendos: 4 në: ['syrah']
	).
}.

Dalje shkruaj: (((winery nis) - ['nothing']) numëro), rresht-ri.
Dalje shkruaj: (((winery nis) - ['merlot']) numëro), rresht-ri.
Dalje shkruaj: (((winery nis) - ['malbec']) numëro), rresht-ri.
Dalje shkruaj: (((winery nis) - ['syrah']) numëro), rresht-ri.
Dalje shkruaj: (((winery nis) - ['merlot'] - ['malbec']) numëro), rresht-ri.
Dalje shkruaj: (((winery nis) - ['merlot'] - ['syrah']) numëro), rresht-ri.
Dalje shkruaj: (((winery nis) - ['malbec'] -['syrah']) numëro), rresht-ri.
Dalje shkruaj: (((winery nis) - ['malbec'] - ['syrah'] - ['merlot']) numëro), rresht-ri.

