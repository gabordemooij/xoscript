

>> Matryoshka := Objekt ri.
Matryoshka kur: ['double:'] bëj: { :secret
	vetjak secret := secret × 2.
}.
Matryoshka kur: ['ri:'] bëj: { :secret
	>> answer := Asgjë.
	>> t := (secret > 255).
	Dalje shkruaj: (secret + [' | '] + t), rresht-ri.
	t vërtetë: {
		answer := secret.
	}, përndryshe: {
		answer := Matryoshka rekursiv ri: (vetja double: secret).
	}. <- answer.
}.

>> x := Matryoshka ri: 2.
