>> HTML := Objekt ri.
HTML kur: ['përgjigju:'] bëj: { :tag 
	Dalje shkruaj: (['<tag>'] tag: tag), rresht-ri.
}.
HTML kur: ['përgjigju:dhe:'] bëj: { :tag :html 
	Dalje shkruaj: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), rresht-ri.
}.
>> html := HTML ri.
html body h1: ['header'].

