# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob ri: 8, bytes: (
	Listë ri ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Dalje shkruaj: ( utf16 dekodo: ['utf16le'] ), rresht-ri.

utf16 liro.
>> utf32 := Blob ri: 13, bytes: (
	Listë ri ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Dalje shkruaj: ( utf32 dekodo: ['utf32be'] ), rresht-ri.
utf32 liro.