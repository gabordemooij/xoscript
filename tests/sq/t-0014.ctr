>> Greeter := Objekt ri.
Greeter kur: ['make'] bëj: {
	>> gr := Objekt ri.
	gr kur: ['setName:'] bëj: { :aname
		vetjak emër := aname.
	}.
	gr kur: ['greet'] bëj: {
		Dalje shkruaj: vetjak emër.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a ri.
c setName: ['THREE'].
c greet.
>> d := a ri.
d setName: ['FOUR'].
d greet.
c greet.
