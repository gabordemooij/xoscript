

# create a 64-bit integer for exact calculations
>> a := Int64 prej-teksti: ['123'].

# to string
Dalje shkruaj: a, rresht-ri.

# divide
Dalje shkruaj: a / (Int64 prej-teksti: ['3']), rresht-ri.

# multiply
Dalje shkruaj: a * (Int64 prej-teksti: ['2']), rresht-ri.

# add
Dalje shkruaj: a + (Int64 prej-teksti: ['1']), rresht-ri.

# subtract
Dalje shkruaj: a - (Int64 prej-teksti: ['2']), rresht-ri.

# compare
Dalje shkruaj: ( a =   (Int64 prej-teksti: ['123'])), rresht-ri.
Dalje shkruaj: ( a !=: (Int64 prej-teksti: ['124'])), rresht-ri.
Dalje shkruaj: ( a <   (Int64 prej-teksti: ['124'])), rresht-ri.
Dalje shkruaj: ( a >   (Int64 prej-teksti: ['122'])), rresht-ri.
Dalje shkruaj: ( a >=: (Int64 prej-teksti: ['123'])), rresht-ri.
Dalje shkruaj: ( a <=: (Int64 prej-teksti: ['123'])), rresht-ri.





	