
Listë kur: ['sum'] bëj: {
	>> total := 0.
	vetja secili: { :index :element
		total shto: element.
	}. <- total.
}.

>> a := Listë ← 9 ; 8 ; 7.
Dalje shkruaj: (a sum), rresht-ri. 
>> a := Listë ← 1 ; 9.
Dalje shkruaj: (a sum), rresht-ri. 
>> a := Listë ← ['o'] ; 2.
Dalje shkruaj: (a sum), rresht-ri. 
Dalje shkruaj: (Listë ri sum), rresht-ri. 
