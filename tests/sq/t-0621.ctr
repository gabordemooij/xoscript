>> phrases := Listë ri
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases secili: { :_ :phrase 
	>> e := Server base64-kodo: phrase.
	>> d := Server base64-dekodo: e.
	Dalje shkruaj: (
		message kopjo ~encoded: e, ~decoded: d
	), rresht-ri.
}.
