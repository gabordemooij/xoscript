

Tekst kur: ['evaluate'] bëj: {
	>> kod := Skedar ri: ['/tmp/eval.ctr'].
	kod shkruaj: vetja tekst + ['.'].
	Program përdor: ['/tmp/eval.ctr'].
}.

>> a := (Listë ← (
	(Fjalor ri)
		vendos: ['domain'] në: ['mywebsite.com'],
		vendos: (Listë ←
			((Fjalor ri)
				vendos: ['home'] në: ['title'],
				vendos: ['<html></html>'] në: ['body'],
				vendos: ['2017-01-01'] në: ['created']
			) ;
			((Fjalor ri)
				vendos: ['aboutus(c)'] në: ['title'],
				vendos: ['<credits>Author Inc.</credits>'] në: ['body']
			)
		) në: ['pages']
	)
) tekst.

Dalje shkruaj: a lloj, rresht-ri.
Dalje shkruaj: a, rresht-ri.

>> b := Asgjë.
(['b := '] + a) evaluate.
Dalje shkruaj: b ? 0 ? ['pages'] ? 1 ? ['body'], rresht-ri.

>> c := b ? 0.
>> d := c tekst.
Dalje shkruaj: d lloj, rresht-ri.

>> e := Asgjë.
(['e := '] + d) evaluate.
Dalje shkruaj: e ? ['pages'] ? 0, rresht-ri.
