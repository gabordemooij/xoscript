Tekst kur: ['evaluate'] bëj: {
	>> kod := Skedar ri: ['/tmp/eval.ctr'].
	kod shkruaj: (vetja tekst + ['.']).
	Program përdor: ['/tmp/eval.ctr'].
}.

>> a := Listë ← 1 ; 2 ; 3.
>> b := (a tekst).

Dalje shkruaj: b, rresht-ri. 
(['b := '] + b) evaluate.

Dalje shkruaj: b ? 2, rresht-ri. 

Dalje shkruaj: (( Listë ← 1 ; 2 ; 3 )), rresht-ri. 

Dalje shkruaj: ((Fjalor ri) vendos: 1 në: 2), rresht-ri. 

>> x := ( (Listë ← 1 ; ( Listë ← 9 ) ; Vërtetë ) ) tekst.
Dalje shkruaj: x, rresht-ri. 
(['x := '] + x) evaluate.

Dalje shkruaj: x ? 1 ? 0, rresht-ri. 

>> y := (Fjalor ri) vendos: (Listë ← 1) në: (Listë ← 2).
Dalje shkruaj: y, rresht-ri. 

(['y := '] + y) tekst evaluate.

Dalje shkruaj: (y në: (Listë ← 2) tekst ), rresht-ri.

Dalje shkruaj: (Listë ri), rresht-ri. 
Dalje shkruaj: (Fjalor ri), rresht-ri. 
