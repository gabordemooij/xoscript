Dalje shkruaj: ['Continue for-loop, No - before 6 and up.'], rresht-ri.
{ :i
	Dalje shkruaj: (i + 1), rresht-ri.
	((i + 1) > 4) vazhdo.
	Dalje shkruaj: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Dalje rresht-ri.
Dalje shkruaj: ['Continue while-true, No --> before 5 and up.'], rresht-ri.
{
	Dalje shkruaj: ['iteration #'] + x, rresht-ri.
	x shto: 1.
	((x < 5) jo) vazhdo.
	Dalje shkruaj: ['-->'].
} derisa: xIsLessThan10.
Dalje rresht-ri.
Dalje shkruaj: ['Continue while-false, No - before 3 only.'], rresht-ri.
{
	Dalje shkruaj: ['iteration #'] + x, rresht-ri.
	x zbres: 1.
	(x = 3) vazhdo.
	Dalje shkruaj: ['-'].
} derisa: { <- ( x > 0). }.

Dalje rresht-ri.
Dalje shkruaj: ['Continue times-loop, No ||| before 3.'], rresht-ri.
{ :i
	Dalje shkruaj: ['iteration #'] + i, rresht-ri.
	(i = 2) vazhdo.
	Dalje shkruaj: ['|||'].
} × 5.

Dalje rresht-ri.

{ Vërtetë vazhdo. Dalje shkruaj: ['dont write this!'], rresht-ri. } nis.

{ Vërtetë vazhdo. Dalje shkruaj: ['dont write this!'], rresht-ri. } kap: { Dalje shkruaj: ['Dont catch this!']. }, nis.

Dalje shkruaj: ['Test Array each-loop: 0, ... ,2'], rresht-ri.
(Listë ← 1 ; 2 ; 3) përshtat: { :i
	(i = 1) vazhdo.
	Dalje shkruaj: ['iteration #'] + (i - 0), rresht-ri.
}.

Dalje shkruaj: ['Test Map each-loop: c only'], rresht-ri.
>> m := Fjalor ri.
m vendos: ['first'] në: ['a'], vendos: ['second'] në: ['b'], vendos: ['third'] në: ['c'].
m secili: { :k :v
	(k ≠ ['c']) vazhdo.
	Dalje shkruaj: ['iteration'] + k + v, rresht-ri.
}.

