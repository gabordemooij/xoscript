['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Dalje shkruaj: (x + y), rresht-ri.

>> x := 10040.07.
>> y := 10305.60.

Dalje shkruaj: (x + y), rresht-ri.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Dalje shkruaj: (x + y + z), rresht-ri.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Dalje shkruaj: (x + y + z), rresht-ri.

>> q := 0.1.2.

Dalje shkruaj: (q), rresht-ri.

>> q := 012.

Dalje shkruaj: (q), rresht-ri.
