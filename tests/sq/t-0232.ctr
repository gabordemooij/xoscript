>> Slurp := Objekt ri.

Slurp kur: ['ri'] bëj: {
	vetjak str := [''].
}.

Slurp kur: ['përgjigju:'] bëj: { :blah
		(vetjak str = ['']) vërtetë: {
			vetjak str shto-në-fund: blah.
		}, përndryshe: {
			vetjak str shto-në-fund: [' '].
			vetjak str shto-në-fund: blah.
		}.
}.

Slurp kur: ['përgjigju:dhe:'] bëj: { :blah :blahah
		(blah gjatësi > 1) vërtetë: {
			vetjak str shto-në-fund: (blah nga: 0 gjatësi: (blah gjatësi - 1)).
		}, përndryshe: {
			vetjak str shto-në-fund: blah.
		}.
		vetjak str shto-në-fund: [' '].
		vetjak str shto-në-fund: blahah.
}.

Slurp kur: ['obtain'] bëj: {
	>> buffer := vetjak str.
	vetjak str := ['']. <- buffer.
}.


>> x := Slurp ri.
x + 3.
Dalje shkruaj: (x obtain), rresht-ri.
x echo: ['Hello world'].
Dalje shkruaj: (x obtain), rresht-ri.
x tellme: 123 and: 987.
Dalje shkruaj: (x obtain), rresht-ri.
