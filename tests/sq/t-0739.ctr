Dalje shkruaj: ['Test object'], rresht-ri.
>> a := Objekt ri. 

a kur: ['item:'] bëj: { :binhelper
	vetjak binhelper := binhelper. 
}.

a kur: ['item'] bëj: { <- vetjak binhelper.
}.

a item: Bin ri.

>> old-binhelper-address := a item prototip adresë-kujtese.
a save-as: ['/tmp/a.bin'].
Dalje shkruaj: ['========== RELOADING SNAP:'], rresht-ri.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototip adresë-kujtese = old-binhelper-address) vërtetë: {
	Dalje shkruaj: ['Object link re-attached.'], rresht-ri.
}.


