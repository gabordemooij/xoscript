# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB ri pritës: ['localhost'],
	përdorues: ['xo'],
	fjalëkalim: ['pass123'],
	emër-baze: ['xobase'],
	lidhu.

>> parametra-kërkimi := db pyetësor: ['SELECT %% FROM'].
{ parametra-kërkimi ekzekuto. } kap: { :e
	Dalje shkruaj: ( e përmban: ['%%'] ), rresht-ri.
}, nis.
