Server init.

>> DB := Maria-DB ri pritës: ['localhost'],
	përdorues: ['xo'],
	fjalëkalim: ['pass123'],
	emër-baze: ['xobase'],
	lidhu.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB pyetësor: SQL.

# now you don't have to set DB
query2 merr: { :row
	Dalje shkruaj: row world, rresht-ri.
}.
