Dalje shkruaj: ['Test object'], rresht-ri.
>> a := Objekt ri. 
a kur: ['item:'] bëj: { :int64
	vetjak int64 := int64. 
}.
a kur: ['item'] bëj: { <- vetjak int64.
}.
a item: ( Int64 prej-teksti: ['9999'] ).
Dalje shkruaj: a item, rresht-ri.
>> old-int64-address := a item prototip adresë-kujtese.
a save-as: ['/tmp/a.bin'].
Dalje shkruaj: ['========== RELOADING SNAP:'], rresht-ri.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b item prototip adresë-kujtese = old-int64-address) vërtetë: {
	Dalje shkruaj: ['Object link re-attached.'], rresht-ri.
}.
Dalje shkruaj: ( b item ), rresht-ri.
