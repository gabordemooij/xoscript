# test catch-all methods
>> x13 := Objekt ri.
x13 kur: ['a'] bëj: { :a Dalje shkruaj: 0, rresht-ri. }.
x13 kur: ['a:'] bëj: { :a Dalje shkruaj: a, rresht-ri. <- 5. }.
x13 kur: ['a:b:'] bëj: { :a :b Dalje shkruaj: (a + b), rresht-ri. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
