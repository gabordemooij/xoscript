# test qualifiers

Program pastro.

>> Fruit := Objekt ri.
Fruit kur: ['ri'] bëj: {
	>> f := vetja ri.
	f apples: 0. <- f.
}.
Fruit kur: ['apples:'] bëj: { :a vetjak apples := a. }.
Fruit kur: ['apples'] bëj: { <- vetjak apples. }.
Fruit kur: ['+'] bëj: { :f
	>> n := Fruit ri.
	n apples: (f apples + vetjak apples). <- n.
}.
Numër kur: ['apples'] bëj: { <- ((Fruit ri) apples: vetja).
}.

Fruit kur: ['tekst'] bëj: { <- vetjak apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Dalje shkruaj: q, rresht-ri.




q := 3 apples + 4 apples.
Dalje shkruaj: q, rresht-ri.



q := 3 apples + 4 apples.
Dalje shkruaj: q, rresht-ri.


