Program menaxhim-kujtese: 4.

>> Doubler := Objekt ri.
>> Multiplier := Objekt ri.
Doubler kur: ['double:and:'] bëj: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier kur: ['multiply:and:'] bëj: { :x :y <- (x × y).
}.

Dalje shkruaj: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), rresht-ri.
