
>> dictionary := (
	Fjalor ri
		vendos: ['b'] në: ['a'],
		vendos: ['a'] në: ['b'],
		vendos: ['z'] në: ['x'],
		vendos: ['hello'] në: ['hallo'],
		vendos: ['human'] në: ['human']
).

>> comparisons := Listë ri.
dictionary secili: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a krahaso: b)
	).
}.

comparisons rendit: { :a :b <- ( a krahaso: b ). }.
Dalje shkruaj: ( comparisons bashko: ['↵'] ), rresht-ri.
comparisons bashko: ['↵'].
