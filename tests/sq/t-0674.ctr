# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> shteg := ['/tmp/dat.csv'].
>> csv := Skedar ri: shteg.
csv shkruaj: s.

# accepts CRLF LF CR, varying row length
csv ndarës: [';'] thonjëz: ['"'] rreshta: { :line
	Program pastro.
	Dalje shkruaj: line, rresht-ri.
	Program pastro.
}.

# unequal lines
s shto-në-fund: ['\njustone'].
csv shkruaj: s.
{
	csv ndarës: [';'] thonjëz: ['"'] rreshta: { :line
		Dalje shkruaj: line, rresht-ri.
	}.
} kap: { :e 
	Dalje shkruaj: e, rresht-ri.
}, nis.

# invalid format
s := ['"he"llo";world'].
csv shkruaj: s.
{
	csv ndarës: [';'] thonjëz: ['"'] rreshta: { :line
		Dalje shkruaj: line, rresht-ri.
	}.
} kap: { :e 
	Dalje shkruaj: e, rresht-ri.
}, nis.
