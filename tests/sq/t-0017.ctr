Numër kur: ['factorial'] bëj: {
	>> total := 1.
	{ :index total shumëzo-me: (vetja - (index)). } × vetja. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Dalje shkruaj: a.
>> b := 2 + 3 factorial.
Dalje shkruaj: b.
>> c := 3 factorial + 2.
Dalje shkruaj: c.
>> d := 2 + (3 factorial).
Dalje shkruaj: d.
Dalje shkruaj: 2 + 3 factorial + 1.
