Tekst kur: ['html'] bëj: { <- (
		vetja
		zëvendëso: ['&'] me: ['&amp;'],
		zëvendëso: ['<'] me: ['&lt;'],
		zëvendëso: ['>'] me: ['&gt;'],
		zëvendëso: ['''] me: ['&apos;'],
		zëvendëso: ['"'] me: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program menaxhim-kujtese: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Dalje shkruaj: txt kopjo html, rresht-ri.
Dalje shkruaj: txt kopjo shkronja-vogla, rresht-ri.
Dalje shkruaj: txt kopjo shkronja-mëdha, rresht-ri.
} nis.

Program pastro.

usedMemory1 := (Program kujtesë ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Dalje shkruaj: txt kopjo html, rresht-ri.
Dalje shkruaj: txt kopjo shkronja-vogla, rresht-ri.
Dalje shkruaj: txt kopjo shkronja-mëdha, rresht-ri.
} nis.

Program pastro.
usedMemory2 := (Program kujtesë ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Dalje shkruaj: txt kopjo html, rresht-ri.
Dalje shkruaj: txt kopjo shkronja-vogla, rresht-ri.
Dalje shkruaj: txt kopjo shkronja-mëdha, rresht-ri.
} nis.

Program pastro.
usedMemory3 := (Program kujtesë ? 0).



( usedMemory1 = usedMemory2 dhe: usedMemory1 = usedMemory3, dhe: usedMemory2 = usedMemory3 ) vërtetë: {
	Dalje shkruaj: ['No memory leaks here'].
}, rreme: {
	Dalje shkruaj: ['Leaking memory...'].
}.
