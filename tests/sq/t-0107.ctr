
Dalje shkruaj: ['Break for-loop, 0-4.'], rresht-ri.
{ :i
	Dalje shkruaj: ['iteration #'] + i, rresht-ri.
	(i = 4) ndërprit.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Dalje shkruaj: ['Break while-true loop, 0-4.'], rresht-ri.
{
	Dalje shkruaj: ['iteration #'] + x, rresht-ri.
	x shto: 1.
	((x < 5) jo) ndërprit.
} derisa: xIsLessThan10.

Dalje shkruaj: ['Break while-false loop, 5,4.'], rresht-ri.
{
	Dalje shkruaj: ['iteration #'] + x, rresht-ri.
	x zbres: 1.
	(x = 3) ndërprit.
} derisa: { <- (x > 0). }.

Dalje shkruaj: ['Break times loop, 1-4.'], rresht-ri.
{ :i
	Dalje shkruaj: ['iteration #'] + i, rresht-ri.
	(i = 4) ndërprit.
} × 5.

Dalje shkruaj: ['Break block, dont print line.'], rresht-ri.
{ Vërtetë ndërprit. Dalje shkruaj: ['dont write this!'], rresht-ri. } nis.

Dalje shkruaj: ['Break block, dont fire catch...'], rresht-ri.
{ Vërtetë ndërprit. Dalje shkruaj: ['dont write this!'], rresht-ri. } kap: { Dalje shkruaj: ['Dont catch this!']. }, nis.

Dalje shkruaj: ['Test Array each-loop: 0,1'], rresht-ri.
(Listë ← 1 ; 2 ; 3) përshtat: { :i
	Dalje shkruaj: ['iteration #'] + i, rresht-ri.
	(i = 1) ndërprit.
}.

Dalje shkruaj: ['Test Map each-loop: c only'], rresht-ri.
>> m := Fjalor ri.
m vendos: ['first'] në: ['a'], vendos: ['second'] në: ['b'], vendos: ['third'] në: ['c'].
m secili: { :k :v
	Dalje shkruaj: ['iteration'] + v + k, rresht-ri.
	Vërtetë ndërprit.
}.

