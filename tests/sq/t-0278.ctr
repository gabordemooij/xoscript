>> To-Do := Objekt ri.

To-Do kur: ['ri'] bëj: {
	vetjak list := Listë ri.
}.

To-Do kur: ['nieuw'] bëj: {
	vetjak list := Listë ri.
}.

To-Do kur: ['+'] bëj: { :task
	vetjak list shto-në-fund: task.
}.

To-Do kur: ['number of tasks?'] bëj: { <-  vetjak list numëro.
}.

>> todos := 
	To-Do ri 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Dalje shkruaj: ['You have $ tasks to do'] $ todos number of tasks?.
