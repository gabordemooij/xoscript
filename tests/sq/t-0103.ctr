>> a := Listë ← Objekt ; Vërtetë ; Rreme ; Logjik ; 1 ; Numër ; ['Str'] ; Tekst ; { ['Empty']. }.
Dalje shkruaj: (a numëro), rresht-ri.
{ :i
	Dalje shkruaj: 
	['a '] + 
	((a ? i) lloj) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Asgjë?) ose: [''] ose: ['NOT']) + 
	[' Nil.'],
	rresht-ri.
} × (a numëro).
Dalje shkruaj: ['but.. Nil is.. '] + ((Asgjë Asgjë?) ose: ['certainly NIL!'] ose: ['not NIL??']), rresht-ri.