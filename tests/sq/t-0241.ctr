

Tekst kur: ['evaluate'] bëj: {
	>> kod := Skedar ri: ['/tmp/eval.ctr'].
	kod shkruaj: (vetja tekst + ['.']).
	Program përdor: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Listë ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q tekst.
Dalje shkruaj: x, rresht-ri.
>> y := Asgjë.
(['y := '] + x ) evaluate.
Dalje shkruaj: y ? 0, rresht-ri.

q := Fjalor vendos: ['\[''] në: ['\['quote\']'].
x := q tekst.
Dalje shkruaj: x, rresht-ri.
y := Asgjë.
(['y := '] + x ) evaluate.

>> q := (Fjalor ri) vendos:['\[''] në:['\['quote\[''].
Dalje shkruaj: y ? ['\['quote\']'], rresht-ri.
