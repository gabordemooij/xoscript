#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Model ri: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern përputhje: subject bëj: { :m :x
	Dalje shkruaj: m, rresht-ri.
	Dalje shkruaj: x, rresht-ri. <- ['XXX'].
}.
Dalje shkruaj: result, rresht-ri.