برنامج إدارة-الذاكرة: 0.
قائمة عند: ⌝'sum'⌜ نفذ: ⎬
	>> total := 0.
	ذات لكل: ⎬ :index :element
		total أضف: element.
	⎨. <- total.
⎨.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := ملف جديد: ⌝'/tmp/test.txt'⌜.
f اكتب: ⌝'Lorem Ipsum'⌜.
f أغلق.
  

f := ملف جديد: ⌝'/tmp/test.txt'⌜.
>> text := f اقرأ.
f أغلق.



برنامج نظف.
usedMemory1 := ﴿برنامج ذاكرة ? 1﴾.



f := ملف جديد: ⌝'/tmp/test.txt'⌜.
text := f اقرأ.
f أغلق.

برنامج نظف.
usedMemory2 := ﴿برنامج ذاكرة ? 1﴾.


f := ملف جديد: ⌝'/tmp/test.txt'⌜.
text := f اقرأ.
