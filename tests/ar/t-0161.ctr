برنامج إدارة-الذاكرة: 0.
قائمة عند: ⌝'مجموع'⌜ نفذ: ⎬
	>> المجموع := 0.
	ذات لكل: ⎬ :فهرس :عنصر
		المجموع أضف: عنصر.
	⎨. <- المجموع.
⎨.

>> ذاكرة-مستخدمة1 := 0.
>> ذاكرة-مستخدمة2 := 0.
>> ذاكرة-مستخدمة3 := 0.
>> ذاكرة-مستخدمة4 := 0.



>> f := ملف جديد: ⌝'/tmp/test.txt'⌜.
f اكتب: ⌝'Lorem Ipsum'⌜.
f أغلق.
  

f := ملف جديد: ⌝'/tmp/test.txt'⌜.
>> النص := f اقرأ.
f أغلق.



برنامج نظف.
ذاكرة-مستخدمة1 := ﴿برنامج ذاكرة ? 1﴾.



f := ملف جديد: ⌝'/tmp/test.txt'⌜.
النص := f اقرأ.
f أغلق.

برنامج نظف.
ذاكرة-مستخدمة2 := ﴿برنامج ذاكرة ? 1﴾.


f := ملف جديد: ⌝'/tmp/test.txt'⌜.
النص := f اقرأ.
f أغلق.

برنامج نظف.
ذاكرة-مستخدمة3 := ﴿برنامج ذاكرة ? 1﴾.



﴿ ذاكرة-مستخدمة1 = ذاكرة-مستخدمة2 و: ذاكرة-مستخدمة1 = ذاكرة-مستخدمة3, و: ذاكرة-مستخدمة2 = ذاكرة-مستخدمة3 ﴾ إذا-صحيح: ⎬
	مخرج اكتب: ⌝'لا تسرب للذاكرة هنا'⌜.
⎨, إذا-خطأ: ⎬
	مخرج اكتب: ⌝'تسرب في الذاكرة...'⌜.
⎨.
