قائمة عند: ⌝'انسخ'⌜ نفذ: ⎬
	>> انسخ := قائمة جديد.
	ذات لكل: ⎬ :كعدد :section
		انسخ ألحق: section تكراري انسخ.
	⎨. <- انسخ.
⎨.

>> sheep := قائمة جديد ; ⌝'Dolly'⌜ ; ⌝'Shaun'⌜. 
>> clones := sheep انسخ.
clones لكل: ⎬ :كعدد :sheep
	sheep ألحق: ⌝'2'⌜.
⎨.

مخرج اكتب: sheep, سطر-جديد.
مخرج اكتب: clones, سطر-جديد.
