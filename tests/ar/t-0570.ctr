#Linux

 >> t := لحظة جديد.
 
t منطقة-زمنية: ⌝'Europe/Amsterdam'⌜.
t سنة: 2020, شهر: 8, يوم: 2, ساعة: 21, دقيقة: 2, ثانية: 1.

>> a := t ساعة.
>> ams := t منطقة-زمنية.

t منطقة-زمنية: ⌝'US/Hawaii'⌜.
>> b := t ساعة.
>> hw := t منطقة-زمنية.

مخرج
اكتب: ﴿
	⌝'It's diff in zone2 than in zone1'⌜
	zone1: ams,
	zone2: hw,
	diff: ﴿
		﴿b > a﴾
		إما: ⌝'أكثر تأخرا'⌜ وإما: ⌝'أكثر تبكيرا'⌜
	﴾
﴾,
سطر-جديد.
 