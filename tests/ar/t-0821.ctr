# a quote that never closes must give an error, not an endless loop
>> مسار-الملف := ⌝'/tmp/test0821.csv'⌜.
>> file := ملف جديد: مسار-الملف.

file اكتب: ⌝'a,b\n"1,2\n'⌜.
⎬
	file فاصل: ⌝','⌜ اقتباس: ⌝'"'⌜ أسطر: ⎬ :line
		مخرج اكتب: line, سطر-جديد.
	⎨.
⎨ التقط: ⎬ :e مخرج اكتب: e, سطر-جديد. ⎨, شغل.

# a closed quote still works
file اكتب: ⌝'a,b\n"1,2",3'⌜.
file فاصل: ⌝','⌜ اقتباس: ⌝'"'⌜ أسطر: ⎬ :line
	مخرج اكتب: line, سطر-جديد.
⎨.
file احذف.
