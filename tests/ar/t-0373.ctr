# use 0-indexed arrays
>> x := قائمة جديد ; 1 ; 2 ; 3.
>> y := قائمة جديد ; ⌝'a'⌜ ; ⌝'b'⌜ ; ⌝'c'⌜.

مخرج اكتب: ⌝'1 -> '⌜.
مخرج اكتب: x ? 0, سطر-جديد. #1

مخرج اكتب: ⌝'1 -> '⌜.
مخرج اكتب: ﴿x في: 0﴾, سطر-جديد. #1

مخرج اكتب: ⌝'1 -> '⌜.
مخرج اكتب: x الأول, سطر-جديد. #1

مخرج اكتب: ⌝'3 -> '⌜.
مخرج اكتب: x الأخير, سطر-جديد. #3

مخرج اكتب: ⌝'(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '⌜.
مخرج اكتب: ﴿x حسب: y﴾, سطر-جديد.

مخرج اكتب: ⌝'1 -> '⌜.
مخرج اكتب: ﴿x بداية: 0 طول: 1﴾ الأول, سطر-جديد. #1

مخرج اكتب: ⌝'0 -> '⌜.
مخرج اكتب: ﴿x ابحث: 1﴾, سطر-جديد. #0

x ضع: 9 عند: 0.

مخرج اكتب: ⌝'9 -> '⌜.
مخرج اكتب: ﴿x في: 0﴾, سطر-جديد. #9

x أضف-للبداية: 8.
مخرج اكتب: ⌝'8 -> '⌜.
مخرج اكتب: ﴿x في: 0﴾, سطر-جديد. #9


x ألحق: 10.
