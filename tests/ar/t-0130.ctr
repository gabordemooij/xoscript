# استخدام FFI مع إضافة Server

# الاتصال بـ libc (يعتمد على المنصة)
>> اسم-المكتبة := برنامج إعداد: ⌝'FFITESTLIB'⌜.

# ربط دوال stdio من C لعمليات ملفات متقدمة
Server اربط: ﴿ قائمة جديد ;
 اسم-المكتبة ; ⌝'fopen'⌜ ;
 ﴿ قائمة جديد ; ⌝'pointer'⌜ ; ⌝'pointer'⌜﴾ ;
 ⌝'pointer'⌜ ;
 ⌝'Stream'⌜ ;
 ⌝'path:mode:'⌜
﴾,
اربط: ﴿ قائمة جديد ;
 لاشيء ; # تعني المكتبة نفسها
 ⌝'fread'⌜ ;
 ﴿ قائمة جديد ; ⌝'pointer'⌜ ; ⌝'int'⌜ ; ⌝'int'⌜ ; ⌝'pointer'⌜ ﴾ ;
 ⌝'int'⌜ ;
 لاشيء ; # تعني الكائن نفسه (أي تيار)
 ⌝'fread'⌜
﴾,
اربط: ﴿
 قائمة جديد ;
 لاشيء ; # تعني المكتبة نفسها
 ⌝'fwrite'⌜ ;
 ﴿ قائمة جديد ; ⌝'pointer'⌜ ; ⌝'int'⌜ ; ⌝'int'⌜ ; ⌝'pointer'⌜ ﴾ ;
 ⌝'int'⌜ ;
 لاشيء ; # تعني المكتبة نفسها
 ⌝'fwrite'⌜
﴾,
اربط: ﴿
 قائمة جديد ;
 لاشيء ; # تعني المكتبة نفسها
 ⌝'rewind'⌜ ;
 ﴿ قائمة جديد ; ⌝'pointer'⌜ ﴾ ;
 ⌝'int'⌜ ;
 لاشيء ; # تعني المكتبة نفسها
 ⌝'rewind:'⌜
﴾.

>> str  := Blob utf8: ⌝'abc123'⌜.
>> مسار-الملف := Blob utf8: ⌝'/tmp/bla.txt'⌜.
>> mode := Blob utf8: ⌝'w+'⌜.

# فتح ملف باستخدام fopen(path, mode)
>> واصف-ملف := Stream path: مسار-الملف mode: mode.

# كتابة البايتات من المخزن سلسلة-نصية إلى الملف
>> بايتات-مكتوبة := Stream رسالة: ⌝'fwrite'⌜ معطيات: ﴿قائمة جديد ; str ; 1 ; 6 ; واصف-ملف ﴾.
مخرج اكتب: بايتات-مكتوبة, سطر-جديد.

# إرجاع مؤشر الملف إلى البداية
Stream rewind: واصف-ملف.

# حجز مخزن
>> مخزن := Blob جديد: 20.

# القراءة من الملف
>> بايتات-مقروءة := Stream رسالة: ⌝'fread'⌜ معطيات: ﴿قائمة جديد ; مخزن ; 1 ; 6 ; واصف-ملف ﴾.
مخرج اكتب: بايتات-مقروءة, سطر-جديد.
مخرج اكتب: مخزن, سطر-جديد.

# تحرير الذاكرة
str  حرر.
مسار-الملف حرر.
mode حرر.
مخزن  حرر.


