مخرج اكتب: ⌝'Continue for-loop, No - before 6 and up.'⌜, سطر-جديد.
⎬ :i
	مخرج اكتب: ﴿i + 1﴾, سطر-جديد.
	﴿﴿i + 1﴾ > 4﴾ تابع.
	مخرج اكتب: ⌝'-'⌜.
⎨ × 10.

>> x := 0.
>> xIsLessThan10 := ⎬ <- ﴿ x < 10 ﴾. ⎨.
مخرج سطر-جديد.
مخرج اكتب: ⌝'Continue while-true, No --> before 5 and up.'⌜, سطر-جديد.
⎬
	مخرج اكتب: ⌝'iteration #'⌜ + x, سطر-جديد.
	x أضف: 1.
	﴿﴿x < 5﴾ نفي﴾ تابع.
	مخرج اكتب: ⌝'-->'⌜.
⎨ طالما: xIsLessThan10.
مخرج سطر-جديد.
مخرج اكتب: ⌝'Continue while-false, No - before 3 only.'⌜, سطر-جديد.
⎬
	مخرج اكتب: ⌝'iteration #'⌜ + x, سطر-جديد.
	x اطرح: 1.
	﴿x = 3﴾ تابع.
	مخرج اكتب: ⌝'-'⌜.
⎨ طالما: ⎬ <- ﴿ x > 0﴾. ⎨.

مخرج سطر-جديد.
مخرج اكتب: ⌝'Continue times-loop, No ||| before 3.'⌜, سطر-جديد.
⎬ :i
	مخرج اكتب: ⌝'iteration #'⌜ + i, سطر-جديد.
	﴿i = 2﴾ تابع.
	مخرج اكتب: ⌝'|||'⌜.
⎨ × 5.

مخرج سطر-جديد.

⎬ صحيح تابع. مخرج اكتب: ⌝'dont write this!'⌜, سطر-جديد. ⎨ شغل.

⎬ صحيح تابع. مخرج اكتب: ⌝'dont write this!'⌜, سطر-جديد. ⎨ التقط: ⎬ مخرج اكتب: ⌝'Dont catch this!'⌜. ⎨, شغل.

مخرج اكتب: ⌝'Test Array each-loop: 0, ... ,2'⌜, سطر-جديد.
﴿قائمة ← 1 ; 2 ; 3﴾ حول: ⎬ :i
	﴿i = 1﴾ تابع.
	مخرج اكتب: ⌝'iteration #'⌜ + ﴿i - 0﴾, سطر-جديد.
⎨.

مخرج اكتب: ⌝'Test Map each-loop: c only'⌜, سطر-جديد.
>> m := قاموس جديد.
m ضع: ⌝'first'⌜ عند: ⌝'a'⌜, ضع: ⌝'second'⌜ عند: ⌝'b'⌜, ضع: ⌝'third'⌜ عند: ⌝'c'⌜.
m لكل: ⎬ :k :v
	﴿k ≠ ⌝'c'⌜﴾ تابع.
	مخرج اكتب: ⌝'iteration'⌜ + k + v, سطر-جديد.
⎨.

