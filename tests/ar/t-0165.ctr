

>> ذاكرة-مستخدمة1 := 0.
>> ذاكرة-مستخدمة2 := 0.
>> ذاكرة-مستخدمة3 := 0.
>> ذاكرة-مستخدمة4 := 0.

برنامج إدارة-الذاكرة: 0.

>> f := ملف جديد: ⌝'/tmp/citrine_test_file.txt'⌜.
f exists: ⎬ f احذف. ⎨.
f اكتب: ⌝'سلام '⌜.
f ألحق: ⌝'world'⌜.
>> q := f اقرأ.
مخرج اكتب: q, سطر-جديد.

برنامج نظف.
ذاكرة-مستخدمة1 := ﴿برنامج ذاكرة ? 0﴾.

>> f := ملف جديد: ⌝'/tmp/citrine_test_file.txt'⌜.
f exists: ⎬ f احذف. ⎨.
f اكتب: ⌝'سلام '⌜.
f ألحق: ⌝'world'⌜.
>> q := f اقرأ.
مخرج اكتب: q, سطر-جديد.
برنامج نظف.
ذاكرة-مستخدمة2 := ﴿برنامج ذاكرة ? 0﴾.


>> f := ملف جديد: ⌝'/tmp/citrine_test_file.txt'⌜.
f exists: ⎬ f احذف. ⎨.
f اكتب: ⌝'سلام '⌜.
f ألحق: ⌝'world'⌜.
>> q := f اقرأ.
مخرج اكتب: q, سطر-جديد.
برنامج نظف.
ذاكرة-مستخدمة3 := ﴿برنامج ذاكرة ? 0﴾.



﴿ ذاكرة-مستخدمة1 = ذاكرة-مستخدمة2 و: ذاكرة-مستخدمة1 = ذاكرة-مستخدمة3, و: ذاكرة-مستخدمة2 = ذاكرة-مستخدمة3 ﴾ إذا-صحيح: ⎬
	مخرج اكتب: ⌝'لا تسرب للذاكرة هنا'⌜.
⎨, إذا-خطأ: ⎬
	مخرج اكتب: ⌝'تسرب في الذاكرة...'⌜.
⎨.
