>> Animal := كائن جديد.
Animal عند: ⌝'make'⌜ نفذ: ⎬
	>> animal := كائن جديد.
	animal عند: ⌝'makeSound'⌜ نفذ: ⎬
		مخرج اكتب: خاص sound.
	⎨. <- animal.
⎨.
>> Cat := كائن جديد.
Cat عند: ⌝'make'⌜ نفذ: ⎬
	>> cat := Animal make.
	cat عند: ⌝'init'⌜ نفذ: ⎬
		خاص sound := ⌝'meow!'⌜.
	⎨.
	cat init. <- cat.
⎨.
>> tom := Cat make.
tom makeSound.
