Server init.

>> قاعدة-البيانات := Maria-DB جديد مضيف: ⌝'localhost'⌜,
	اسم-المستخدم: ⌝'xo'⌜,
	كلمة-السر: ⌝'pass123'⌜,
	اسم-القاعدة: ⌝'xobase'⌜,
	اتصل.
	
>> SQL := ⌝'SELECT "hello" AS "world" '⌜.

# إنشاء الاستعلام يدويا
>> معاملات-البحث := استعلام-Maria جديد: SQL.

# ضبط قاعدة البيانات
معاملات-البحث قاعدة-بيانات: قاعدة-البيانات.

معاملات-البحث اجلب: ⎬ :صف
	مخرج اكتب: صف world, سطر-جديد.
⎨.
