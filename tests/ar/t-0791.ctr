Server init.

>> DB := Maria-DB جديد مضيف: ⌝'localhost'⌜,
	اسم-المستخدم: ⌝'xo'⌜,
	كلمة-السر: ⌝'pass123'⌜,
	اسم-القاعدة: ⌝'xobase'⌜,
	اتصل.
	
>> SQL := ⌝'SELECT "hello" AS "world" '⌜.

# manually create query
>> معاملات-البحث := استعلام-Maria جديد: SQL.

# set database
معاملات-البحث قاعدة-بيانات: DB.

معاملات-البحث اجلب: ⎬ :row
	مخرج اكتب: row world, سطر-جديد.
⎨.
