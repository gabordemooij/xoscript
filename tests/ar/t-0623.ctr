

>> g  := Server جديد.
>> v  := خزنة جديد.
>> حسنا := 0.

>> أسرار := قائمة جديد ; 
	 ⌝'aaa'⌜ ;
	 ⌝''⌜ ; 
	 ⌝'AB'⌜ ;
	 ⌝'abcdefghijklmnopqrstuvwxyz0123456789'⌜ ; 
	 ⌝'!@--+467hdHJKJs__=3hjsakd'⌜ ;
	 ⌝'spaces and	tabs'⌜ ;
	 ⌝'漢字'⌜ ;
	 ⌝'==[abc]=='⌜.
	
>> كلمات-سر := أسرار انسخ.
كلمات-سر لكل: ⎬ :i :p
	أسرار لكل: ⎬ :n :s
		⎬
			>> مشفر := v شفر: s مفتاح: p.
			>> مفكوك-التشفير := v فك-التشفير: مشفر مفتاح: p.
			﴿مفكوك-التشفير = s﴾ إذا-صحيح: ⎬
				حسنا أضف: 1.
			⎨, وإلا: ⎬
				مخرج اكتب: ⌝'فشل التشفير/فك التشفير: '⌜, سطر-جديد.
				مخرج اكتب: s, سطر-جديد.
				مخرج اكتب: ⌝'مشفر: '⌜ + مشفر, سطر-جديد.
				مخرج اكتب: ⌝'مفكوك: '⌜ + مشفر, سطر-جديد.
				برنامج أنه.
			⎨.
		⎨ التقط: ⎬ :خطأ-ما
			﴿s = ⌝''⌜ أو: p = ⌝''⌜﴾ إذا-صحيح: ⎬
				حسنا أضف: 1.
			⎨, وإلا: ⎬
				مخرج اكتب: خطأ-ما, سطر-جديد.
				برنامج أنه.
			⎨.
		⎨, شغل.
	⎨.
⎨.

مخرج اكتب: ﴿ حسنا + ⌝' عمليات تشفير خزنة تم اختبارها.'⌜ ﴾, سطر-جديد.