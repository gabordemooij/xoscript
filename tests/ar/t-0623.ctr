

>> g := Server جديد.
>> v := خزنة جديد.
>> ok := 0.

>> secrets := قائمة جديد ; 
	 ⌝'aaa'⌜ ;
	 ⌝''⌜ ; 
	 ⌝'AB'⌜ ;
	 ⌝'abcdefghijklmnopqrstuvwxyz0123456789'⌜ ; 
	 ⌝'!@--+467hdHJKJs__=3hjsakd'⌜ ;
	 ⌝'spaces and	tabs'⌜ ;
	 ⌝'漢字'⌜ ;
	 ⌝'==[abc]=='⌜.
	
>> passwords := secrets انسخ.
passwords لكل: ⎬ :i :p
	secrets لكل: ⎬ :n :s
		⎬
			>> encrypted := v شفر: s مفتاح: p.
			>> decrypted := v فك-التشفير: encrypted مفتاح: p.
			﴿decrypted = s﴾ إذا-صحيح: ⎬
				ok أضف: 1.
			⎨, وإلا: ⎬
				مخرج اكتب: ⌝'failed encrypting/decrypting: '⌜, سطر-جديد.
				مخرج اكتب: s, سطر-جديد.
				مخرج اكتب: ⌝'encrypted: '⌜ + encrypted, سطر-جديد.
				مخرج اكتب: ⌝'decrypted: '⌜ + encrypted, سطر-جديد.
				برنامج أنه.
			⎨.
		⎨ التقط: ⎬ :err
			﴿s = ⌝''⌜ أو: p = ⌝''⌜﴾ إذا-صحيح: ⎬
				ok أضف: 1.
			⎨, وإلا: ⎬
				مخرج اكتب: err, سطر-جديد.
				برنامج أنه.
			⎨.
		⎨, شغل.
	⎨.
⎨.

مخرج اكتب: ﴿ ok + ⌝' vault encryptions tested.'⌜ ﴾, سطر-جديد.