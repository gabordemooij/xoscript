نص عند: ⌝'html'⌜ نفذ: ⎬ <- ﴿
		ذات
		استبدل: ⌝'&'⌜ ببديل: ⌝'&amp;'⌜,
		استبدل: ⌝'<'⌜ ببديل: ⌝'&lt;'⌜,
		استبدل: ⌝'>'⌜ ببديل: ⌝'&gt;'⌜,
		استبدل: ⌝'''⌜ ببديل: ⌝'&apos;'⌜,
		استبدل: ⌝'"'⌜ ببديل: ⌝'&quot;'⌜
	﴾.
⎨.

>> ذاكرة-مستخدمة1 := 0.
>> ذاكرة-مستخدمة2 := 0.
>> ذاكرة-مستخدمة3 := 0.
>> ذاكرة-مستخدمة4 := 0.

برنامج إدارة-الذاكرة: 0.

⎬
>> txt := ⌝'<h1>"Hell'o & Goodbye"</h1>'⌜.
مخرج اكتب: txt انسخ html, سطر-جديد.
مخرج اكتب: txt انسخ حروف-صغيرة, سطر-جديد.
مخرج اكتب: txt انسخ حروف-كبيرة, سطر-جديد.
⎨ شغل.

برنامج نظف.

ذاكرة-مستخدمة1 := ﴿برنامج ذاكرة ? 0﴾.


⎬
>> txt := ⌝'<h1>"Hell'o & Goodbye"</h1>'⌜.
مخرج اكتب: txt انسخ html, سطر-جديد.
مخرج اكتب: txt انسخ حروف-صغيرة, سطر-جديد.
مخرج اكتب: txt انسخ حروف-كبيرة, سطر-جديد.
⎨ شغل.

برنامج نظف.
ذاكرة-مستخدمة2 := ﴿برنامج ذاكرة ? 0﴾.


⎬
>> txt := ⌝'<h1>"Hell'o & Goodbye"</h1>'⌜.
مخرج اكتب: txt انسخ html, سطر-جديد.
مخرج اكتب: txt انسخ حروف-صغيرة, سطر-جديد.
مخرج اكتب: txt انسخ حروف-كبيرة, سطر-جديد.
⎨ شغل.

برنامج نظف.
ذاكرة-مستخدمة3 := ﴿برنامج ذاكرة ? 0﴾.



﴿ ذاكرة-مستخدمة1 = ذاكرة-مستخدمة2 و: ذاكرة-مستخدمة1 = ذاكرة-مستخدمة3, و: ذاكرة-مستخدمة2 = ذاكرة-مستخدمة3 ﴾ إذا-صحيح: ⎬
	مخرج اكتب: ⌝'لا تسرب للذاكرة هنا'⌜.
⎨, إذا-خطأ: ⎬
	مخرج اكتب: ⌝'تسرب في الذاكرة...'⌜.
⎨.
