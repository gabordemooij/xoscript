نص عند: ⌝'html'⌜ نفذ: ⎬ <- ﴿
		ذات
		استبدل: ⌝'&'⌜ ببديل: ⌝'&amp;'⌜,
		استبدل: ⌝'<'⌜ ببديل: ⌝'&lt;'⌜,
		استبدل: ⌝'>'⌜ ببديل: ⌝'&gt;'⌜,
		استبدل: ⌝'''⌜ ببديل: ⌝'&apos;'⌜,
		استبدل: ⌝'"'⌜ ببديل: ⌝'&quot;'⌜
	﴾.
⎨.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

برنامج إدارة-الذاكرة: 0.

⎬
>> txt := ⌝'<h1>"Hell'o & Goodbye"</h1>'⌜.
مخرج اكتب: txt انسخ html, سطر-جديد.
مخرج اكتب: txt انسخ حروف-صغيرة, سطر-جديد.
مخرج اكتب: txt انسخ حروف-كبيرة, سطر-جديد.
⎨ شغل.

برنامج نظف.

usedMemory1 := ﴿برنامج ذاكرة ? 0﴾.


⎬
>> txt := ⌝'<h1>"Hell'o & Goodbye"</h1>'⌜.
مخرج اكتب: txt انسخ html, سطر-جديد.
مخرج اكتب: txt انسخ حروف-صغيرة, سطر-جديد.
مخرج اكتب: txt انسخ حروف-كبيرة, سطر-جديد.
⎨ شغل.

برنامج نظف.
usedMemory2 := ﴿برنامج ذاكرة ? 0﴾.


⎬
>> txt := ⌝'<h1>"Hell'o & Goodbye"</h1>'⌜.
مخرج اكتب: txt انسخ html, سطر-جديد.
مخرج اكتب: txt انسخ حروف-صغيرة, سطر-جديد.
مخرج اكتب: txt انسخ حروف-كبيرة, سطر-جديد.
