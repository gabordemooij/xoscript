# database test
# see example server.xo for required config

Server init.
مخرج اكتب: ⌝'Database test'⌜, سطر-جديد.

>> db := Maria-DB جديد مضيف: ⌝'localhost'⌜,
	اسم-المستخدم: ⌝'xo'⌜, كلمة-السر: ⌝'pass123'⌜, اسم-القاعدة: ⌝'xobase'⌜, اتصل.

مخرج اكتب: ⌝'Can we connect? '⌜ + db متصل?, سطر-جديد.

>> معاملات-البحث := db استعلام: ⌝'
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'⌜, معاملات: ﴿ قائمة جديد ; ⌝'abc'⌜ ; 12.35 ; 6 ﴾. # parameterized queries

⎬  معاملات-البحث نفذ. db ثبت. ⎨ التقط: ⎬ :e db تراجع.  ⎨, شغل.

مخرج اكتب: ⌝'Can we insert? '⌜ + ﴿ معاملات-البحث insert-id > 0 ﴾, سطر-جديد.

>> Obj := كائن جديد.
Obj عند: ⌝'retrieve-rows'⌜ نفذ: ⎬
	خاص عدد-العناصر := 0.
	>> معاملات-البحث :=
	db استعلام: ⌝'SELECT * FROM book order by id desc limit 2'⌜, 
	اجلب: ⎬ :row 
		خاص عدد-العناصر أضف: 1.
		صحيح اخرج.
	⎨. <- خاص عدد-العناصر انسخ.
⎨.

مخرج اكتب: ⌝'Can we query? '⌜ + ﴿ Obj retrieve-rows > 0 ﴾, سطر-جديد.
