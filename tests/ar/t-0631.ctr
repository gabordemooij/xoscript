#اختبار ffi


Server init.

برنامج إدارة-الذاكرة: 4.

# لهذا الاختبار يجب ضبط مسار إلى libc (puts)
>> اسم-المكتبة := برنامج إعداد: ⌝'FFITESTLIB'⌜.



Server اربط: ﴿
 قائمة جديد ;
 اسم-المكتبة ;
 ⌝'puts'⌜ ;
 ﴿ قائمة جديد ; ⌝'pointer'⌜ ﴾ ;
 ⌝'void'⌜ ;
 ⌝'Puts'⌜ ;
 ⌝'str:'⌜
﴾.

>> s := Blob utf8: ⌝'Hello from FFI!\n'⌜.

Puts str: s.
s حرر.

# اختبار باستخدام struct

>> a := Blob جديد: 8.
a بايتات: ﴿
	قائمة <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
﴾.

>> بنية := Blob struct: ﴿قائمة <<: ⌝'int'⌜, ; ⌝'int'⌜﴾.

Server اربط: ﴿
	قائمة <<: ⌝'@structtest'⌜, ;
	⌝'@structtest'⌜ ;
	﴿قائمة <<: بنية﴾ ; 
	⌝'int'⌜ ;	
	⌝'ffitest'⌜ ;
	⌝'ffisum:'⌜
﴾.
	
مخرج اكتب: ⌝'اختبار المجموع:'⌜ + ﴿ffitest ffisum: a﴾, سطر-جديد.

بنية حرر-struct.
بنية حرر.
a حرر.
