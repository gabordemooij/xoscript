>> randomizer := ⎬ :a :b
	>> الأصغر := ﴿ a < b ﴾ إما: a وإما: b.
	>> الأكبر := ﴿ a > b ﴾ إما: a وإما: b.
	>> x := لاشيء.
	⎬
		x := عدد بين: a وبين: b.
		﴿﴿x < الأصغر﴾ أو: ﴿x > الأكبر﴾﴾ إذا-صحيح: ⎬ 
			مخرج اكتب: ﴿⌝'Invalid value!'⌜﴾.
			برنامج أنه.
		⎨.
	⎨ 
	× 100. <- x.
⎨.
randomizer طبق: 0 و: 0.
