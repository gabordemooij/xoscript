# الصيغة يجب أن تلائم نوع القيمة، والنوع قد يأتي من العميل
>> جرب := ⎬ :صيغة :value
	⎬ مخرج اكتب: ﴿ ﴿تنسيق جديد: صيغة﴾ طبق: value ﴾, سطر-جديد. ⎨ التقط: ⎬ :e مخرج اكتب: e, سطر-جديد. ⎨, شغل.
⎨.
>> جرب-صحيح := ⎬ :صيغة :value
	⎬ مخرج اكتب: ﴿ ﴿تنسيق جديد: صيغة﴾ طبق-صحيح: value ﴾, سطر-جديد. ⎨ التقط: ⎬ :e مخرج اكتب: e, سطر-جديد. ⎨, شغل.
⎨.

# تلائم
جرب طبق: ⌝'|%s|'⌜ و: ⌝'text'⌜.
جرب طبق: ⌝'%06.2f'⌜ و: 5.5.
جرب طبق: ⌝'100%% %s'⌜ و: ⌝'بالتأكيد'⌜.
جرب-صحيح طبق: ⌝'%03d'⌜ و: 7.
جرب-صحيح طبق: ⌝'%x'⌜ و: 255.
جرب طبق: ⌝'%d'⌜ و: ﴿Int64 جديد من-نص: ⌝'12'⌜﴾.
جرب طبق: ⌝'%lld'⌜ و: ﴿Int64 جديد من-نص: ⌝'12'⌜﴾.
جرب طبق: ⌝'%.1lf'⌜ و: 5.5.
جرب-صحيح طبق: ⌝'%hd'⌜ و: 7.

# لا تلائم
جرب طبق: ⌝'%s'⌜ و: 12345.
جرب طبق: ⌝'%d'⌜ و: 12345.
جرب طبق: ⌝'%f'⌜ و: ⌝'text'⌜.
جرب-صحيح طبق: ⌝'%d'⌜ و: ⌝'text'⌜.
جرب-صحيح طبق: ⌝'%s'⌜ و: 5.
جرب طبق: ⌝'%s %s'⌜ و: ⌝'text'⌜.
جرب طبق: ⌝'%n'⌜ و: ⌝'text'⌜.
جرب طبق: ⌝'%*s'⌜ و: ⌝'text'⌜.
جرب طبق: ⌝'%'⌜ و: ⌝'text'⌜.

# معدّل الطول لا يلائم
جرب طبق: ⌝'%ls'⌜ و: ⌝'text'⌜.
جرب طبق: ⌝'%Lf'⌜ و: 5.5.
جرب-صحيح طبق: ⌝'%ld'⌜ و: 7.
جرب-صحيح طبق: ⌝'%lld'⌜ و: 7.
جرب طبق: ⌝'%Ld'⌜ و: ﴿Int64 جديد من-نص: ⌝'12'⌜﴾.

# عرض لا يلائم printf يجب أن يعطي خطأ، لا انهيارا
جرب طبق: ⌝'%99999999999s'⌜ و: ⌝'text'⌜.
