# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := ⎬ :pattern :subject
	>> p := نمط جديد: pattern.
	p طابق: subject نفذ: ⎬ :m :g
		مخرج اكتب: g عدد-العناصر, اكتب: ⌝' '⌜, اكتب: ﴿g ادمج: ⌝'|'⌜﴾, سطر-جديد. <- m.
	⎨.
⎨.
show طبق: ⌝'(a)|(b)'⌜ و: ⌝'b'⌜.
show طبق: ⌝'(a)|(b)'⌜ و: ⌝'a'⌜.
show طبق: ⌝'(x)?y'⌜ و: ⌝'y'⌜.
show طبق: ⌝'(x)?(y)(z)?'⌜ و: ⌝'xy'⌜.
