>> map1 := قاموس جديد.
>> key1 := قائمة جديد.
>> key2 := قائمة جديد.

map1
	ضع: ⌝'hello'⌜ عند: key1,
	ضع: ⌝'world'⌜ عند: key2.


مخرج
	اكتب: ⌝'Map #1 contains: '⌜ + ﴿map1 في: key1﴾,
	اكتب: ⌝' and '⌜ + ﴿map1 في: key2﴾, سطر-جديد.

>> KeyeableArray := قائمة جديد.
KeyeableArray عند: ⌝'toString'⌜ نفذ: ⎬ <- ﴿ذات عدد-العناصر﴾ toString.
⎨.

>> map2 := قاموس جديد.
key1 := KeyeableArray جديد.
key2 := KeyeableArray جديد.

key1 ألحق: 1.

map2
	ضع: ⌝'hello'⌜ عند: key1,
	ضع: ⌝'world'⌜ عند: key2.

مخرج
	اكتب: ⌝'Map #2 contains: '⌜ + ﴿map2 في: key1﴾,
	اكتب: ⌝' and '⌜ + ﴿map2 في: key2﴾, سطر-جديد.
