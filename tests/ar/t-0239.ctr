قائمة عند: ⌝'مجموع'⌜ نفذ: ⎬
	>> المجموع := 0.
	ذات لكل: ⎬ :فهرس :عنصر
		المجموع أضف: عنصر.
	⎨. <- المجموع.
⎨.

>> a := صحيح.



a عند: ⌝'كنص'⌜ نفذ: ⎬
	>> جواب := لاشيء.
	﴿ ذات = صحيح ﴾ إذا-صحيح: ⎬
		جواب := ⌝'أيوه'⌜.
	⎨, وإلا: ⎬
		جواب := ⌝'مستحيل'⌜.
	⎨. <- جواب.
⎨.

a عند: ⌝'كعدد'⌜ نفذ: ⎬
	>> جواب := لاشيء.
	﴿ ذات = صحيح ﴾ إذا-صحيح: ⎬
		جواب := 10.
	⎨, وإلا: ⎬
		جواب := 20.
	⎨. <- جواب.
⎨.

>> b := 666.

b عند: ⌝'كنص'⌜ نفذ: ⎬ <- ⌝'الشيطان'⌜.
⎨.

b عند: ⌝'كمنطقي'⌜ نفذ: ⎬ <- خطأ.
⎨.


مخرج اكتب: a, سطر-جديد.  
مخرج اكتب: ﴿90 + a﴾, سطر-جديد. 
مخرج اكتب: b, سطر-جديد. 
مخرج اكتب: ﴿صحيح و: b﴾, سطر-جديد.

a := قائمة ← ⌝'hello'⌜ ; ⌝'world'⌜ ; صحيح ; لاشيء ; 666. 
a := a + ﴿ قائمة ← 1 ﴾.
مخرج اكتب: a, سطر-جديد.
مخرج اكتب: ﴿﴿قاموس جديد﴾ ضع: لاشيء عند: لاشيء﴾, سطر-جديد.
مخرج اكتب: a مجموع, سطر-جديد. 


⎬
	a عند: ⌝'كنص'⌜ نفذ: ⎬ <- لاشيء. ⎨.
	a := ⌝''⌜ + a.
⎨ التقط: ⎬ :الخطأ
	مخرج اكتب: ⌝'تم تسجيل الخطأ: '⌜ + الخطأ, سطر-جديد.
⎨, شغل.



⎬
	a عند: ⌝'كعدد'⌜ نفذ: ⎬ <- لاشيء. ⎨.
	a := 3 × a.
⎨ التقط: ⎬ :الخطأ
	مخرج اكتب: ⌝'تم تسجيل الخطأ: '⌜ + الخطأ, سطر-جديد.
⎨, شغل.


⎬
