قائمة عند: ⌝'sum'⌜ نفذ: ⎬
	>> total := 0.
	ذات لكل: ⎬ :index :element
		total أضف: element.
	⎨. <- total.
⎨.

>> a := صحيح.



a عند: ⌝'كنص'⌜ نفذ: ⎬
	>> answer := لاشيء.
	﴿ ذات = صحيح ﴾ إذا-صحيح: ⎬
		answer := ⌝'Yep'⌜.
	⎨, وإلا: ⎬
		answer := ⌝'Nope'⌜.
	⎨. <- answer.
⎨.

a عند: ⌝'كعدد'⌜ نفذ: ⎬
	>> answer := لاشيء.
	﴿ ذات = صحيح ﴾ إذا-صحيح: ⎬
		answer := 10.
	⎨, وإلا: ⎬
		answer := 20.
	⎨. <- answer.
⎨.

>> b := 666.

b عند: ⌝'كنص'⌜ نفذ: ⎬ <- ⌝'Devil'⌜.
⎨.

b عند: ⌝'كمنطقي'⌜ نفذ: ⎬ <- خطأ.
⎨.


مخرج اكتب: a, سطر-جديد.  
مخرج اكتب: ﴿90 + a﴾, سطر-جديد. 
مخرج اكتب: b, سطر-جديد. 
مخرج اكتب: ﴿صحيح و: b﴾, سطر-جديد.

a := قائمة ← ⌝'hello'⌜ ; ⌝'world'⌜ ; صحيح ; لاشيء ; 666. 
a := a + ﴿ قائمة ← 1 ﴾.
مخرج اكتب: a, سطر-جديد.
مخرج اكتب: ﴿﴿قاموس جديد﴾ ضع: لاشيء عند: لاشيء﴾, سطر-جديد.
مخرج اكتب: a sum, سطر-جديد. 


⎬
	a عند: ⌝'كنص'⌜ نفذ: ⎬ <- لاشيء. ⎨.
	a := ⌝''⌜ + a.
⎨ التقط: ⎬ :error
	مخرج اكتب: ⌝'Error noted: '⌜ + error, سطر-جديد.
⎨, شغل.



⎬
