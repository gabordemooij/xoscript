# هذا الاختبار يتحقق من أن string_fill_in لا يفقد خانته (بجمع المهملات) في الوضع 4
# المرجع في world.c
>> صنف-سجل := كائن جديد.

صنف-سجل عند: ⌝'say:'⌜ نفذ: ⎬ :str
	مخرج اكتب: str, سطر-جديد.
⎨.

>> صنف-بند := كائن جديد.

صنف-بند عند: ⌝'جديد:'⌜ نفذ: ⎬ :id
	<- ذات جديد id: id.
⎨.

صنف-بند عند: ⌝'id:'⌜ نفذ: ⎬ :id
	خاص id := id.
⎨.

صنف-بند عند: ⌝'id'⌜ نفذ: ⎬ <- خاص id. ⎨.


صنف-بند عند: ⌝'كنص'⌜ نفذ: ⎬
	>> str := ⌝'Item#~no'⌜.
	str ~no: خاص id.
	<- str.
⎨.


>> Print := كائن جديد.

Print عند: ⌝'items'⌜ نفذ: ⎬ 
	
	خاص بند := صنف-بند جديد: 1.
	
	# إما خطأ تجزئة أو سلسلة-نصية خاطئة هنا
	صنف-سجل say: ﴿
		⌝'~item printed.'⌜ ~item: خاص بند
	﴾.
	
	
⎨.

Print items.