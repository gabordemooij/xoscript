# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := كائن جديد.

Log عند: ⌝'say:'⌜ نفذ: ⎬ :str
	مخرج اكتب: str, سطر-جديد.
⎨.

>> Item := كائن جديد.

Item عند: ⌝'جديد:'⌜ نفذ: ⎬ :id <- ذات جديد id: id.
⎨.

Item عند: ⌝'id:'⌜ نفذ: ⎬ :id
	خاص id := id.
⎨.

Item عند: ⌝'id'⌜ نفذ: ⎬ <- خاص id. ⎨.


Item عند: ⌝'كنص'⌜ نفذ: ⎬
	>> str := ⌝'Item#~no'⌜.
	str ~no: خاص id. <- str.
⎨.


>> Print := كائن جديد.

Print عند: ⌝'items'⌜ نفذ: ⎬ 
	
	خاص item := Item جديد: 1.
	
	# either segfault or wrong str here
	Log say: ﴿
		⌝'~item printed.'⌜ ~item: خاص item
	﴾.
	
	
⎨.

Print items.