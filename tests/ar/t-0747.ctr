مخرج اكتب: ⌝'كائن اختبار'⌜, سطر-جديد.
>> a := كائن جديد. 

a عند: ⌝'item:'⌜ نفذ: ⎬ :num
	خاص num := num. 
⎨.

a عند: ⌝'بند'⌜ نفذ: ⎬
	<- خاص num.
⎨.

a item: 123.

مخرج اكتب: a بند, سطر-جديد.

>> عنوان-رقم-قديم := a بند نموذج-أولي عنوان-الذاكرة.
a save-as: ⌝'/tmp/a.bin'⌜.
مخرج اكتب: ⌝'========== إعادة تحميل اللقطة:'⌜, سطر-جديد.

>> b := كائن load-from: ⌝'/tmp/a.bin'⌜.

﴿b بند نموذج-أولي عنوان-الذاكرة = عنوان-رقم-قديم﴾ إذا-صحيح: ⎬
	مخرج اكتب: ⌝'تمت إعادة ربط الكائن.'⌜, سطر-جديد.
⎨.

مخرج اكتب: b بند, سطر-جديد.
