# اختبار منقي utf8
Server init.

>> حالات-utf8 := قاموس جديد
	# ASCII فقط
	ضع: ﴿ قائمة جديد ; 65 ; 65 ; 65 ; 65 ; 0 ﴾ عند: ⌝'AAAA'⌜,
	# تسلسل صالح من 2 بايت
	ضع: ﴿ قائمة جديد ; 194 ; 162 ; 0 ﴾ عند: ⌝'¢'⌜,
	# UTF-8 صالح من 3 بايتات
    ضع: ﴿ قائمة جديد ; 226 ; 130 ; 172 ; 0 ﴾ عند: ⌝'€'⌜,
	# UTF-8 صالح من 4 بايتات
    ضع: ﴿ قائمة جديد ; 240 ; 144 ; 141 ; 136 ; 0 ﴾ عند: ⌝'𐍈'⌜,
	# بايت استمرار غير صالح في التسلسل E2 28 AC -> بداية تسلسل 3b + 28 استمرار خاطئ + AC بايت استمرار، لكنه ينتمي إلى نفس الخطأ
    ضع: ﴿ قائمة جديد ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ﴾ عند: ⌝'A?A'⌜,
	# ترميز مطول لحرف ASCII 'A' (يجب أن يصبح ?)،
    ضع: ﴿ قائمة جديد ; 65 ; 193 ; 129 ; 0 ﴾ عند: ⌝'A?'⌜,
	# بايت أول غير صالح (0xFF)
    ضع: ﴿ قائمة جديد ; 255 ; 0 ﴾ عند: ⌝'?'⌜,
	# تسلسل متعدد البايتات غير مكتمل في النهاية
    ضع: ﴿ قائمة جديد ; 66 ; 226 ; 0 ﴾ عند: ⌝'B?'⌜,
    # نص فارغ
    #put: ( List new ) at: [''],
	# تسلسلات مختلطة متعددة
    ضع: ﴿ قائمة جديد ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ﴾ عند: ⌝'A€?𐍈B'⌜.
	 
حالات-utf8 لكل: ⎬ :key :value
	>> blob := Blob جديد: value عدد-العناصر, بايتات: value.
	>> str := blob كنص.
	﴿str = key﴾ إذا-صحيح: ⎬
		مخرج اكتب: ⌝'OK'⌜, سطر-جديد.
	⎨, وإلا: ⎬
		مخرج اكتب: ⌝'فشل منقح UTF8 في: '⌜ + key + ⌝' النتيجة: '⌜ + str, سطر-جديد.
	⎨.
	blob حرر.
⎨.
