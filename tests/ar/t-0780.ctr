Server init.

# مرمز JSON يدعم UTF-8 فقط، بلا أزواج بديلة

>> معاجم := قائمة جديد ;
	# {"key":"normal"} ASCII عادي
	﴿ قاموس جديد ضع: ⌝'عادي'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"hello world"} حرف مسافة
	﴿ قاموس جديد ضع: ⌝'hello world'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"quote: \""} علامة اقتباس مزدوجة
	﴿ قاموس جديد ضع: ⌝'"'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"backslash: \\"} شرطة مائلة عكسية
	﴿ قاموس جديد ضع: ⌝'backslash: \\'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"slash: /"} شرطة مائلة
	﴿ قاموس جديد ضع: ⌝'شرطة مائلة: /'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"backspace: \b"} مسافة للخلف
	﴿ قاموس جديد ضع: ⌝'backspace: \b'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"formfeed: \f"} هروب تغذية الصفحة
	﴿ قاموس جديد ضع: ⌝'formfeed: \f'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"newline: \n"} سطر جديد
	﴿ قاموس جديد ضع: ⌝'newline: \n'⌜ عند: ⌝'key'⌜ ﴾ ;
	﴿ قاموس جديد ضع: ⌝'newline: ↵'⌜ عند: ⌝'key'⌜ ﴾ ;
	﴿ قاموس جديد ضع: ⌝'newline: 
	'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"carriage return: \r"} إرجاع العربة
	﴿ قاموس جديد ضع: ⌝'carriage return: \r'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"tab: \t"} مسافة جدولة
	﴿ قاموس جديد ضع: ⌝'tab \t'⌜ عند: ⌝'key'⌜ ﴾ ;
	﴿ قاموس جديد ضع: ⌝'tab ⇿'⌜ عند: ⌝'key'⌜ ﴾ ;
	﴿ قاموس جديد ضع: ⌝'جدولة  '⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u0000"} NUL
	﴿ قاموس جديد ضع: ⌝'NUL \u0000'⌜ عند: ⌝'key'⌜ ﴾ ;
	﴿ قاموس جديد ضع: ⌝'NUL \0'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u0001"} حرف تحكم 0x01
	﴿ قاموس جديد ضع: ⌝'control: \u0001'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u001F"} حرف تحكم 0x1F
	﴿ قاموس جديد ضع: ⌝'control: \u001F'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: é"} UTF-8، حرف من 2 بايت
	﴿ قاموس جديد ضع: ⌝'يونيكود: é'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: €"} UTF-8، حرف من 3 بايتات
	﴿ قاموس جديد ضع: ⌝'يونيكود: €'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 日本語"} عدة حروف UTF-8 من 3 بايتات
	﴿ قاموس جديد ضع: ⌝'يونيكود: 日本語'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 😀"} UTF-8، حرف من 4 بايتات
	﴿ قاموس جديد ضع: ⌝'يونيكود: 😀'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 🧑‍💻"} رمز تعبيري + رابط بعرض صفري
	﴿ قاموس جديد ضع: ⌝'يونيكود: 🧑‍💻'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"combining: é"} علامة تشكيل مركبة
	﴿ قاموس جديد ضع: ⌝'combining: e\u0301'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: é"} هروب Unicode في BMP
	﴿ قاموس جديد ضع: ⌝'escaped unicode: \u00e9'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: €"} هروب Unicode في BMP
	﴿ قاموس جديد ضع: ⌝'escaped unicode: \u20ac'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: 😀"} زوج بديل UTF-16
	﴿ قاموس جديد ضع: ⌝'escaped unicode: \ud83d\ude00'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":""} قيمة فارغة
	﴿ قاموس جديد ضع: ⌝''⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"@ < > & = % + ? #"} حروف ASCII خاصة
	﴿ قاموس جديد ضع: ⌝'@ < > & = % + ? #'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"single quote: '"} علامة اقتباس مفردة
	﴿ قاموس جديد ضع: ⌝'''⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"multiple: \" \\ \n \r \t"} عدة رموز هروب JSON
	﴿ قاموس جديد ضع: ⌝'multiple: \" \\ \n \r \t'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} نص ASCII أطول
	﴿ قاموس جديد ضع: ⌝'aaaaaaaaaaaaaaaaaaaaaaaaaa'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":" value"} مسافة بادئة
	﴿ قاموس جديد ضع: ⌝' value'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"value "} مسافة لاحقة
	﴿ قاموس جديد ضع: ⌝'value '⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":" \t\n\r "} مسافات بيضاء
	﴿ قاموس جديد ضع: ⌝' \t\n\r '⌜ عند: ⌝'key'⌜ ﴾
	.

معاجم لكل: ⎬ :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: ﴿قاموس جديد ضع: d key عند: ⌝'key'⌜﴾.
	>> b := JSON jsonify: ﴿قاموس جديد ضع: ⌝'value'⌜ عند: d key﴾.
	>> e := JSON كائن: a.
	>> f := JSON كائن: b.
	﴿﴿e key = d key و: ﴿f ? d key = ⌝'value'⌜﴾﴾ أو: ﴿e key = ⌝'NUL ?'⌜﴾﴾ إذا-صحيح: ⎬
		مخرج اكتب: ⌝'OK'⌜, سطر-جديد.
	⎨, وإلا: ⎬
		مخرج اكتب: ⌝'تعذر الترميز/فك الترميز بشكل صحيح: '⌜ + d + j, سطر-جديد.
		برنامج أنه.
	⎨.
⎨.
