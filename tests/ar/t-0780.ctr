Server init.

# JSON encoder only supports UTF-8, no surrogate pairs

>> dicts := قائمة جديد ;
	# {"key":"normal"} normal ASCII
	﴿ قاموس جديد ضع: ⌝'normal'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"hello world"} space character
	﴿ قاموس جديد ضع: ⌝'hello world'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"quote: \""} double quote
	﴿ قاموس جديد ضع: ⌝'"'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"backslash: \\"} backslash
	﴿ قاموس جديد ضع: ⌝'backslash: \\'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"slash: /"} slash
	﴿ قاموس جديد ضع: ⌝'slash: /'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"backspace: \b"} backspace
	﴿ قاموس جديد ضع: ⌝'backspace: \b'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"formfeed: \f"} form-feed escape
	﴿ قاموس جديد ضع: ⌝'formfeed: \f'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"newline: \n"} newline
	﴿ قاموس جديد ضع: ⌝'newline: \n'⌜ عند: ⌝'key'⌜ ﴾ ;
	﴿ قاموس جديد ضع: ⌝'newline: ↵'⌜ عند: ⌝'key'⌜ ﴾ ;
	﴿ قاموس جديد ضع: ⌝'newline: 
	'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"carriage return: \r"} carriage-return
	﴿ قاموس جديد ضع: ⌝'carriage return: \r'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"tab: \t"} tab
	﴿ قاموس جديد ضع: ⌝'tab \t'⌜ عند: ⌝'key'⌜ ﴾ ;
	﴿ قاموس جديد ضع: ⌝'tab ⇿'⌜ عند: ⌝'key'⌜ ﴾ ;
	﴿ قاموس جديد ضع: ⌝'tab  '⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u0000"} NUL
	﴿ قاموس جديد ضع: ⌝'NUL \u0000'⌜ عند: ⌝'key'⌜ ﴾ ;
	﴿ قاموس جديد ضع: ⌝'NUL \0'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u0001"} control character 0x01
	﴿ قاموس جديد ضع: ⌝'control: \u0001'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u001F"} control character 0x1F
	﴿ قاموس جديد ضع: ⌝'control: \u001F'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: é"} UTF-8, 2-byte char
	﴿ قاموس جديد ضع: ⌝'unicode: é'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: €"} UTF-8, 3-byte char
	﴿ قاموس جديد ضع: ⌝'unicode: €'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 日本語"} multiple 3-byte UTF-8 chars
	﴿ قاموس جديد ضع: ⌝'unicode: 日本語'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 😀"} UTF-8, 4-byte char
	﴿ قاموس جديد ضع: ⌝'unicode: 😀'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	﴿ قاموس جديد ضع: ⌝'unicode: 🧑‍💻'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"combining: e\u0301"} combining accent
	﴿ قاموس جديد ضع: ⌝'combining: e\u0301'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: \u00e9"} Unicode escape BMP
	﴿ قاموس جديد ضع: ⌝'escaped unicode: \u00e9'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: \u20ac"} Unicode escape BMP
	﴿ قاموس جديد ضع: ⌝'escaped unicode: \u20ac'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: \ud83d\ude00"} UTF-16 surrogate pair
	﴿ قاموس جديد ضع: ⌝'escaped unicode: \ud83d\ude00'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":""} empty value
	﴿ قاموس جديد ضع: ⌝''⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"@ < > & = % + ? #"} special ASCII chars
	﴿ قاموس جديد ضع: ⌝'@ < > & = % + ? #'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"single quote: '"} single quote
	﴿ قاموس جديد ضع: ⌝'''⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"multiple: \" \\ \n \r \t"} multiple JSON escapes
	﴿ قاموس جديد ضع: ⌝'multiple: \" \\ \n \r \t'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} longer ASCII-string
	﴿ قاموس جديد ضع: ⌝'aaaaaaaaaaaaaaaaaaaaaaaaaa'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":" value"} leading space
	﴿ قاموس جديد ضع: ⌝' value'⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":"value "} trailing space
	﴿ قاموس جديد ضع: ⌝'value '⌜ عند: ⌝'key'⌜ ﴾ ;
	# {"key":" \t\n\r "} whitespace
	﴿ قاموس جديد ضع: ⌝' \t\n\r '⌜ عند: ⌝'key'⌜ ﴾.

dicts لكل: ⎬ :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: ﴿قاموس جديد ضع: d key عند: ⌝'key'⌜﴾.
	>> b := JSON jsonify: ﴿قاموس جديد ضع: ⌝'value'⌜ عند: d key﴾.
	>> e := JSON كائن: a.
	>> f := JSON كائن: b.
	﴿﴿e key = d key و: ﴿f ? d key = ⌝'value'⌜﴾﴾ أو: ﴿e key = ⌝'NUL ?'⌜﴾﴾ إذا-صحيح: ⎬
		مخرج اكتب: ⌝'OK'⌜, سطر-جديد.
	⎨, وإلا: ⎬
		مخرج اكتب: ⌝'Unable to properly encode/decode: '⌜ + d + j, سطر-جديد.
		برنامج أنه.
	⎨.
⎨.
