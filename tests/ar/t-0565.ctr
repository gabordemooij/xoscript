Server init.

>> message := ⌝'this is a string to be encrypted!'⌜.
>> key := ⌝'secret123!'⌜.
>> vault := خزنة جديد: ⌝'myvault'⌜.

>> encrypted := vault شفر: message مفتاح: key.
>> decrypted := vault فك-التشفير: encrypted مفتاح: key.

مخرج 
اكتب: ⌝'Message:'⌜, سطر-جديد
اكتب: message, سطر-جديد
اكتب: ⌝'Decrypted:'⌜, سطر-جديد
اكتب: decrypted, سطر-جديد.
