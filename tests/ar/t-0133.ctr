


>> Deck := قائمة جديد.
Deck عند: ⌝'print'⌜ نفذ: ⎬
        >> len := ذات عدد-العناصر - 1.
        ⎬ :i
                >> len2 := ذات عدد-العناصر - 1.
                مخرج اكتب: ⌝'len: '⌜.
                مخرج اكتب: len, سطر-جديد.
                مخرج اكتب: ⌝'len2: '⌜.
                مخرج اكتب: len2, سطر-جديد.
        ⎨ × len.
⎨.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
