


>> رزمة-أوراق := قائمة جديد.
رزمة-أوراق عند: ⌝'اطبع'⌜ نفذ: ⎬
        >> len := ذات عدد-العناصر - 1.
        ⎬ :i
                >> طول2 := ذات عدد-العناصر - 1.
                مخرج اكتب: ⌝'الطول: '⌜.
                مخرج اكتب: len, سطر-جديد.
                مخرج اكتب: ⌝'الطول2: '⌜.
                مخرج اكتب: طول2, سطر-جديد.
        ⎨ × len.
⎨.

>> d := رزمة-أوراق ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d اطبع.
