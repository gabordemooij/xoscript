>> echo := كائن جديد.
echo عند: ⌝'استجب:'⌜ نفذ: ⎬ :sound
	⎬ مخرج اكتب: sound. ⎨ × 2.
⎨.
echo ho!. 


echo := كائن جديد.
echo عند: ⌝'استجب:و:'⌜ نفذ: ⎬ :sound :x
	⎬ مخرج اكتب: sound. ⎨ × x.
⎨.
echo o 5. 
echo wooo: 3. 


echo := كائن جديد.
echo عند: ⌝'استجب:و:و:'⌜ نفذ: ⎬ :operation :sound :x
	⎬ مخرج اكتب: sound. ⎨ × x.
⎨.
echo shout: ⌝'la'⌜ times: 4. 


