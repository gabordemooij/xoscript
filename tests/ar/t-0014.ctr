>> Greeter := كائن جديد.
Greeter عند: ⌝'make'⌜ نفذ: ⎬
	>> gr := كائن جديد.
	gr عند: ⌝'setName:'⌜ نفذ: ⎬ :aname
		خاص اسم := aname.
	⎨.
	gr عند: ⌝'greet'⌜ نفذ: ⎬
		مخرج اكتب: خاص اسم.
	⎨. <- gr.
⎨.
>> a := Greeter make.
>> b := Greeter make.
a setName: ⌝'ONE'⌜.
b setName: ⌝'TWO'⌜.
a greet.
b greet.
>> c := a جديد.
c setName: ⌝'THREE'⌜.
c greet.
>> d := a جديد.
d setName: ⌝'FOUR'⌜.
d greet.
c greet.
