# happy flow
>> s := ⌝'hello;"""world"""\n"of";"c\ns\nv"'⌜.
>> مسار-الملف := ⌝'/tmp/dat.csv'⌜.
>> csv := ملف جديد: مسار-الملف.
csv اكتب: s.

# accepts CRLF LF CR, varying row length
csv فاصل: ⌝';'⌜ اقتباس: ⌝'"'⌜ أسطر: ⎬ :line
	برنامج نظف.
	مخرج اكتب: line, سطر-جديد.
	برنامج نظف.
⎨.

# unequal lines
s ألحق: ⌝'\njustone'⌜.
csv اكتب: s.
⎬
	csv فاصل: ⌝';'⌜ اقتباس: ⌝'"'⌜ أسطر: ⎬ :line
		مخرج اكتب: line, سطر-جديد.
	⎨.
⎨ التقط: ⎬ :e 
	مخرج اكتب: e, سطر-جديد.
⎨, شغل.

# invalid format
s := ⌝'"he"llo";world'⌜.
csv اكتب: s.
⎬
	csv فاصل: ⌝';'⌜ اقتباس: ⌝'"'⌜ أسطر: ⎬ :line
		مخرج اكتب: line, سطر-جديد.
	⎨.
⎨ التقط: ⎬ :e 
	مخرج اكتب: e, سطر-جديد.
⎨, شغل.
