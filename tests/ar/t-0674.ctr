# المسار السليم
>> s := ⌝'hello;"""world"""\n"of";"c\ns\nv"'⌜.
>> مسار-الملف := ⌝'/tmp/dat.csv'⌜.
>> csv := ملف جديد: مسار-الملف.
csv اكتب: s.

# يقبل CRLF LF CR، وأطوال صفوف متفاوتة
csv فاصل: ⌝';'⌜ اقتباس: ⌝'"'⌜ أسطر: ⎬ :line
	برنامج نظف.
	مخرج اكتب: line, سطر-جديد.
	برنامج نظف.
⎨.

# أسطر غير متساوية
s ألحق: ⌝'\njustone'⌜.
csv اكتب: s.
⎬
	csv فاصل: ⌝';'⌜ اقتباس: ⌝'"'⌜ أسطر: ⎬ :line
		مخرج اكتب: line, سطر-جديد.
	⎨.
⎨ التقط: ⎬ :e 
	مخرج اكتب: e, سطر-جديد.
⎨, شغل.

# تنسيق غير صالح
s := ⌝'"he"llo";world'⌜.
csv اكتب: s.
⎬
	csv فاصل: ⌝';'⌜ اقتباس: ⌝'"'⌜ أسطر: ⎬ :line
		مخرج اكتب: line, سطر-جديد.
	⎨.
⎨ التقط: ⎬ :e 
	مخرج اكتب: e, سطر-جديد.
⎨, شغل.
