# اختبار تحليل عناوين url

Server init.
>> url := URL من: ⌝'https://xoscript.com:1234/a/b/c?test=1#hello'⌜.

مخرج اكتب: ⌝'المخطط = '⌜ + url مخطط, سطر-جديد.
مخرج اكتب: ⌝'المضيف = '⌜ + url مضيف, سطر-جديد.
مخرج اكتب: ⌝'المنفذ = '⌜ + url منفذ, سطر-جديد.
مخرج اكتب: ⌝'المسار = '⌜ + url مسار-الملف, سطر-جديد.
مخرج اكتب: ⌝'الاستعلام = '⌜ + url معاملات-البحث, سطر-جديد.
مخرج اكتب: ⌝'الجزء = '⌜ + url جزء, سطر-جديد.
