>> phrases := قائمة جديد
	~ ⌝'abcd'⌜
	~ ⌝'hello world'⌜
	~ ⌝''⌜
	~ ⌝'@.,;"'⌜
	~ ⌝'this is a much much longer string to be encoded!'⌜.

>> message := ⌝'Phrase: ~decoded base64: ~encoded'⌜.
	
phrases لكل: ⎬ :_ :phrase 
	>> e := Server base64-ترميز: phrase.
	>> d := Server base64-فك-ترميز: e.
	مخرج اكتب: ﴿
		message انسخ ~encoded: e, ~decoded: d
	﴾, سطر-جديد.
⎨.
