>> عبارات := قائمة جديد
	~ ⌝'abcd'⌜
	~ ⌝'hello world'⌜
	~ ⌝''⌜
	~ ⌝'@.,;"'⌜
	~ ⌝'this is a much much longer string to be encoded!'⌜.

>> الرسالة := ⌝'Phrase: ~decoded base64: ~encoded'⌜.
	
عبارات لكل: ⎬ :_ :عبارة 
	>> e := Server base64-ترميز: عبارة.
	>> d := Server base64-فك-ترميز: e.
	مخرج اكتب: ﴿
		الرسالة انسخ ~encoded: e, ~decoded: d
	﴾, سطر-جديد.
⎨.
