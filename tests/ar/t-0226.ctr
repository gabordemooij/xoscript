# اختبار متغيرات ASCII

# الأعداد

مخرج اكتب: ﴿2 !=: 3﴾, سطر-جديد.
مخرج اكتب: ﴿2 <=: 2﴾, سطر-جديد.
مخرج اكتب: ﴿2 >=: 2﴾, سطر-جديد.

# النصوص

مخرج اكتب: ﴿⌝'b'⌜ >=: ⌝'a'⌜﴾, سطر-جديد.
مخرج اكتب: ﴿⌝'b'⌜ !=: ⌝'a'⌜﴾, سطر-جديد.
مخرج اكتب: ﴿⌝'b'⌜ <=: ⌝'c'⌜﴾, سطر-جديد.

# القيم المنطقية

مخرج اكتب: ﴿صحيح !=: خطأ﴾, سطر-جديد.

# الكائنات

مخرج اكتب: ﴿كائن جديد !=: كائن جديد﴾, سطر-جديد.

# رمز القائمة بـ ASCII <-:

مخرج اكتب: ﴿قائمة <<: 1, ; 2 ; 3﴾ عدد-العناصر = 3, سطر-جديد.

