

قائمة عند: ⌝'column:'⌜ نفذ: ⎬ :column
	>> result := قائمة جديد.
	ذات لكل: ⎬ :index :row
		row لكل: ⎬ :index :cell
			﴿index = column﴾ إذا-صحيح: ⎬ result ألحق: cell. ⎨.
		⎨.
	⎨. <- result.
⎨.


>> a := قائمة ←
	﴿قائمة ← 1 ; 2 ; 3﴾ ;
	﴿قائمة ← 4 ; 5 ; 6﴾ ;
	﴿قائمة ← 7 ; 8 ; 9﴾.

>> b := a column: 1.
مخرج اكتب: b, سطر-جديد.

b := a column: 20.
مخرج اكتب: b, سطر-جديد.

b := a column: -100.
مخرج اكتب: b, سطر-جديد.
