

>> ذاكرة-مستخدمة1 := 0.
>> ذاكرة-مستخدمة2 := 0.
>> ذاكرة-مستخدمة3 := 0.
>> ذاكرة-مستخدمة4 := 0.

برنامج إدارة-الذاكرة: 0.

عدد عند: ⌝'addNum:'⌜ نفذ: ⎬ :x
	ذات أضف: x.
⎨.

عدد عند: ⌝'subtractNum:'⌜ نفذ: ⎬ :x
	ذات اطرح: x.
⎨.

عدد عند: ⌝'multiplyBy:'⌜ نفذ: ⎬ :x
	ذات اضرب-في: x.
⎨.

عدد عند: ⌝'divideBy:'⌜ نفذ: ⎬ :x
	ذات اقسم-على: x.
⎨.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + ﴿2 أس: 8﴾.  
a := a + ﴿2 أس: -1﴾. 
a := a + ﴿49 جذر-تربيعي﴾.   
a addNum: ﴿﴿قائمة ← 0 ; 1﴾ الأكبر﴾.          
a addNum: ﴿﴿قائمة ← 2 ; 3﴾ الأصغر﴾.
مخرج اكتب: a.

برنامج نظف.

ذاكرة-مستخدمة1 := ﴿برنامج ذاكرة ? 0﴾.


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + ﴿2 أس: 8﴾.  
a := a + ﴿2 أس: -1﴾. 
a := a + ﴿49 جذر-تربيعي﴾.   
a addNum: ﴿﴿قائمة ← 0 ; 1﴾ الأكبر﴾.          
a addNum: ﴿﴿قائمة ← 2 ; 3﴾ الأصغر﴾.
مخرج اكتب: a.

برنامج نظف.
ذاكرة-مستخدمة2 := ﴿برنامج ذاكرة ? 0﴾.


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + ﴿2 أس: 8﴾.  
a := a + ﴿2 أس: -1﴾. 
a := a + ﴿49 جذر-تربيعي﴾.   
a addNum: ﴿﴿قائمة ← 0 ; 1﴾ الأكبر﴾.          
a addNum: ﴿﴿قائمة ← 2 ; 3﴾ الأصغر﴾.
مخرج اكتب: a.

برنامج نظف.
ذاكرة-مستخدمة3 := ﴿برنامج ذاكرة ? 0﴾.



﴿ ذاكرة-مستخدمة1 = ذاكرة-مستخدمة2 و: ذاكرة-مستخدمة1 = ذاكرة-مستخدمة3, و: ذاكرة-مستخدمة2 = ذاكرة-مستخدمة3 ﴾ إذا-صحيح: ⎬
	مخرج اكتب: ⌝'لا تسرب للذاكرة هنا'⌜.
⎨, إذا-خطأ: ⎬
	مخرج اكتب: ⌝'تسرب في الذاكرة...'⌜.
⎨.
