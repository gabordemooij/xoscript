# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := خزنة ولد-مفاتيح.

# private (secret) key
>> sk := keys الأول.

# public key
>> pk := keys الأخير.

# sign a message
>> sig := خزنة وقع: ⌝'abc'⌜ بمفتاح: sk.

# check message (ok)
مخرج اكتب: ﴿ 
	خزنة
		افحص: ⌝'abc'⌜ 
		توقيع: sig 
		بمفتاح: pk 
﴾, سطر-جديد.

# check message (fail)
مخرج اكتب: ﴿ 
	خزنة 
		افحص: ⌝'abd'⌜ 
		توقيع: sig 
		بمفتاح: pk 
﴾, سطر-جديد.