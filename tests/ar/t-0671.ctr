# مفتاح عام (لتأمين واجهات API وغيرها)
Server init.

# ولد مفاتيح
>> المفاتيح := خزنة ولد-مفاتيح.

# مفتاح خاص (سري)
>> مفتاح-خاص := المفاتيح الأول.

# مفتاح عام
>> مفتاح-عام := المفاتيح الأخير.

# توقيع رسالة
>> توقيع := خزنة وقع: ⌝'abc'⌜ بمفتاح: مفتاح-خاص.

# فحص الرسالة (ناجح)
مخرج اكتب: ﴿ 
	خزنة
		افحص: ⌝'abc'⌜ 
		توقيع: توقيع 
		بمفتاح: مفتاح-عام 
﴾, سطر-جديد.

# فحص الرسالة (فاشل)
مخرج اكتب: ﴿ 
	خزنة 
		افحص: ⌝'abd'⌜ 
		توقيع: توقيع 
		بمفتاح: مفتاح-عام 
﴾, سطر-جديد.