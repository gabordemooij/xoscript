
>> Rectangle := كائن جديد.

Rectangle عند: ⌝'area'⌜ نفذ: ⎬ <- خاص طول * خاص width.
⎨.

Rectangle عند: ⌝'length:'⌜ نفذ: ⎬ :طول
	خاص طول := طول.
⎨.

Rectangle عند: ⌝'width:'⌜ نفذ: ⎬ :width
	خاص width := width.
⎨.

Rectangle عند: ⌝'جديد'⌜ نفذ: ⎬
	# this will not result into an infinite loop
	>> rectangle := ذات جديد.
	rectangle length: 0, width: 0. <- rectangle.
⎨.

>> a := Rectangle جديد.
مخرج اكتب: a area, سطر-جديد. #0

>> b := Rectangle جديد length: 2, width: 3.
مخرج اكتب: b area, سطر-جديد. #6

