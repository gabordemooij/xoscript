
>> صنف-مستطيل := كائن جديد.

صنف-مستطيل عند: ⌝'مساحة'⌜ نفذ: ⎬
	<- خاص طول * خاص عرض.
⎨.

صنف-مستطيل عند: ⌝'length:'⌜ نفذ: ⎬ :طول
	خاص طول := طول.
⎨.

صنف-مستطيل عند: ⌝'width:'⌜ نفذ: ⎬ :عرض
	خاص عرض := عرض.
⎨.

صنف-مستطيل عند: ⌝'جديد'⌜ نفذ: ⎬
	# هذا لن يؤدي إلى حلقة لا نهائية
	>> مستطيل := ذات جديد.
	مستطيل length: 0, width: 0.
	<- مستطيل.
⎨.

>> a := صنف-مستطيل جديد.
مخرج اكتب: a مساحة, سطر-جديد. #0

>> b := صنف-مستطيل جديد length: 2, width: 3.
مخرج اكتب: b مساحة, سطر-جديد. #6

