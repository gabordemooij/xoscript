# Password hashing
Server init.

# User sets a password
>> passw := ⌝'pass123'⌜.

# You store it like this
>> hash := خزنة 
	تجزئة-كلمة-السر: passw.

# Then, user logs in
# Attempt 1
>> a1 := ⌝'abcd123'⌜.
# Attempt 2
>> a2 := ⌝'pass123'⌜.

# Verify
>> a := خزنة 
	تجزئة-كلمة-السر: hash تحقق: a1.
	# fail 
>> b := خزنة
	تجزئة-كلمة-السر: hash تحقق: a2.
	# ok!

مخرج اكتب: a, سطر-جديد.
مخرج اكتب: b, سطر-جديد.

