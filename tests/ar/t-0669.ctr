# تجزئة كلمة المرور
Server init.

# المستخدم يضبط كلمة مرور
>> كلمة-مرور := ⌝'pass123'⌜.

# تخزنها هكذا
>> بصمة := خزنة 
	تجزئة-كلمة-السر: كلمة-مرور.

# ثم يسجل المستخدم الدخول
# المحاولة 1
>> a1 := ⌝'abcd123'⌜.
# المحاولة 2
>> a2 := ⌝'pass123'⌜.

# تحقق
>> a := خزنة 
	تجزئة-كلمة-السر: بصمة تحقق: a1.
	# فشل 
>> b := خزنة
	تجزئة-كلمة-السر: بصمة تحقق: a2.
	# حسنا!

مخرج اكتب: a, سطر-جديد.
مخرج اكتب: b, سطر-جديد.

