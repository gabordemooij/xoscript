# اختبار تحويلات الأنواع / التحويلات / الربط
برنامج إدارة-الذاكرة: 4.
Server init.

>> عداد := 0.
>> قاعدة := Maria-DB جديد مضيف: ⌝'localhost'⌜,
	اسم-المستخدم: ⌝'xo'⌜, كلمة-السر: ⌝'pass123'⌜, اسم-القاعدة: ⌝'xobase'⌜, اتصل.

>> تنسيق-برقمين := تنسيق جديد: ⌝'%02d'⌜.

# تاريخ ووقت
⎬
	>> سنة     := عدد بين: 1995 وبين: 2050, كنص.
	>> شهر    := تنسيق-برقمين طبق-صحيح: ﴿عدد بين: 1 وبين: 12﴾, كنص.
	>> يوم      := تنسيق-برقمين طبق-صحيح: ﴿عدد بين: 1 وبين: 28﴾, كنص.
	>> ساعة     := تنسيق-برقمين طبق-صحيح: ﴿عدد بين: 1 وبين: 23﴾, كنص.
	>> دقيقة   := تنسيق-برقمين طبق-صحيح: ﴿عدد بين: 1 وبين: 59﴾, كنص.
	>> ثانية   := تنسيق-برقمين طبق-صحيح: ﴿عدد بين: 1 وبين: 59﴾, كنص.
	>> datetime := ⌝'YYYY-MM-DD HH:II:SS'⌜.	
	datetime
		YYYY: سنة,
		MM: شهر,
		DD: يوم,
		HH: ساعة,
		II: دقيقة,
		SS: ثانية.
	>> معاملات-البحث :=
	قاعدة استعلام: ﴿⌝'
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'⌜ <datetime>: datetime﴾,
	اجلب: ⎬ :صف
		﴿صف mydatetime = datetime﴾ إذا-خطأ: ⎬
			هذه-المهمة خطأ-مخرج: ﴿
				⌝'المتوقع: <expected> لكن الناتج: <observation>'⌜
				<expected>: datetime,
				<observation>: صف mydatetime
			﴾.
		⎨.
	
	⎨.
	عداد أضف: 1.
⎨ * 100.

# تاريخ
⎬
	>> سنة     := عدد بين: 1995 وبين: 2050, كنص.
	>> شهر    := تنسيق-برقمين طبق-صحيح: ﴿عدد بين: 1 وبين: 12﴾, كنص.
	>> يوم      := تنسيق-برقمين طبق-صحيح: ﴿عدد بين: 1 وبين: 28﴾, كنص.
	>> date     := ⌝'YYYY-MM-DD'⌜.
	date
		YYYY: سنة,
		MM: شهر,
		DD: يوم.
	>> معاملات-البحث :=
	قاعدة استعلام: ﴿⌝'
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'⌜ <date>: date﴾,
	اجلب: ⎬ :صف
		﴿صف mydate = date﴾ إذا-خطأ: ⎬
			هذه-المهمة خطأ-مخرج: ﴿
				⌝'المتوقع: <expected> لكن الناتج: <observation>'⌜
				<expected>: date,
				<observation>: صف mydate
			﴾.
		⎨.
	⎨.
	عداد أضف: 1.
⎨ * 100.


# وقت
⎬
	>> ساعة     := تنسيق-برقمين طبق-صحيح: ﴿عدد بين: 1 وبين: 23﴾, كنص.
	>> دقيقة   := تنسيق-برقمين طبق-صحيح: ﴿عدد بين: 1 وبين: 59﴾, كنص.
	>> ثانية   := تنسيق-برقمين طبق-صحيح: ﴿عدد بين: 1 وبين: 59﴾, كنص.
	>> وقت := ⌝'HH:II:SS'⌜.
	وقت
		HH: ساعة,
		II: دقيقة,
		SS: ثانية.
	>> معاملات-البحث :=
	قاعدة استعلام: ﴿⌝'
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'⌜ <time>: وقت﴾,
	اجلب: ⎬ :صف
		﴿صف mytime = وقت﴾ إذا-خطأ: ⎬
			هذه-المهمة خطأ-مخرج: ﴿
				⌝'المتوقع: <expected> لكن الناتج: <observation>'⌜
				<expected>: datetime,
				<observation>: صف mytime
			﴾.
		⎨.
	⎨.
	عداد أضف: 1.
⎨ * 100.


# نصوص (varchar/text)
>> str1 := قائمة جديد املأ: 100000 بقيمة: ⌝'x'⌜, ادمج: ⌝''⌜.
⎬
	>> str2 := خزنة رمز-مميز: 40.
	>> معاملات-البحث :=
	قاعدة استعلام: ﴿⌝'
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'⌜ 
	<str1>: str1,
	<str2>: str2
	﴾,
	اجلب: ⎬ :صف
		﴿صف str1 = str1 و: صف str2 = str2﴾ إذا-خطأ: ⎬
			هذه-المهمة خطأ-مخرج: ﴿
				⌝'المتوقع: <expected> لكن الناتج: <observation>'⌜
				<expected>: datetime,
				<observation>: صف mytime
			﴾.
		⎨.
	⎨.
	عداد أضف: 1.
⎨ * 100.


# الأعداد
⎬
	>> n1  := عدد بين: 1 وبين: 99999.
	>> n2  := n1 / 1000.
	>> big := ﴿
		﴿ Int64 من-نص: ⌝'9223372036854775807'⌜ ﴾ -
		﴿ Int64 من-نص: ⌝'99999'⌜ ﴾ +
		﴿ Int64 من-نص: n1 كنص ﴾
	﴾.
	>> معاملات-البحث :=
	قاعدة استعلام: ﴿⌝'
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	'⌜
	<n1>: n1,
	<n2>: n2,
	<big>: big
	﴾,
	اجلب: ⎬ :صف
		﴿صف n1 = n1﴾ إذا-خطأ: ⎬
			هذه-المهمة خطأ-مخرج: ﴿
				⌝'المتوقع: <expected> لكن الناتج: <observation>'⌜
				<expected>: n1,
				<observation>: صف n1
			﴾.
		⎨.
		﴿صف n2 = n2﴾ إذا-خطأ: ⎬
			هذه-المهمة خطأ-مخرج: ﴿
				⌝'المتوقع: <expected> لكن الناتج: <observation>'⌜
				<expected>: n1,
				<observation>: صف n2
			﴾.
		⎨.
		﴿صف n3 = n2 تقريب﴾ إذا-خطأ: ⎬
			هذه-المهمة خطأ-مخرج: ﴿
				⌝'المتوقع: <expected> لكن الناتج: <observation>'⌜
				<expected>: n1,
				<observation>: صف n3
			﴾.
		⎨.
		﴿صف big = big﴾ إذا-خطأ: ⎬
			هذه-المهمة خطأ-مخرج: ﴿
				⌝'المتوقع: <expected> لكن الناتج: <observation>'⌜
				<expected>: big,
				<observation>: صف big
			﴾.
		⎨.
		
	⎨.
	عداد أضف: 1.
⎨ * 100.


مخرج اكتب: ﴿
	⌝'OK, <counter> fuzzy casts/conversions tested.'⌜
	<counter>: عداد
﴾, سطر-جديد.