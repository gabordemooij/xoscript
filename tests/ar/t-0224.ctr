
>> بلدان := قائمة جديد
	~ ⌝'سويسرا'⌜
	~ ⌝'إيطاليا'⌜
	~ ⌝'ألمانيا'⌜.

>> أطعمة := قائمة جديد
	~ ⌝'روستي'⌜
	~ ⌝'إسباغيتي'⌜
	~ ⌝'مخلل الملفوف'⌜.


>> عداد := 0.
أطعمة حسب: بلدان, لكل: ⎬ :key :value
	عداد أضف: 1.
⎨.

مخرج اكتب: ﴿⌝'we serve counter dishes'⌜ counter: عداد﴾, سطر-جديد.

>> عداد := 42.
⌝'TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'⌜ حروف رتب: ⎬ :v
	عداد أضف: 0.
⎨.

مخرج اكتب: ﴿⌝'we sort counter dishes'⌜ counter: عداد﴾, سطر-جديد.


>> عداد := 0.
⎬
	⎬
		عداد أضف: 1.
	⎨ × ﴿3 + 1 + 1 × 0.5﴾.
⎨ × 100.


مخرج اكتب: ﴿⌝'we calculate counter numbers.'⌜ counter: عداد﴾, سطر-جديد.

