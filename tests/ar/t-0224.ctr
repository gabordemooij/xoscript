
>> countries := قائمة جديد
	~ ⌝'Switzerland'⌜
	~ ⌝'Italy'⌜
	~ ⌝'Germany'⌜.

>> foods := قائمة جديد
	~ ⌝'Rösti'⌜
	~ ⌝'Spaghetti'⌜
	~ ⌝'Sauerkraut'⌜.


>> counter := 0.
foods حسب: countries, لكل: ⎬ :key :value
	counter أضف: 1.
⎨.

مخرج اكتب: ﴿⌝'we serve counter dishes'⌜ counter: counter﴾, سطر-جديد.

>> counter := 42.
⌝'TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'⌜ حروف رتب: ⎬ :v
	counter أضف: 0.
⎨.

مخرج اكتب: ﴿⌝'we sort counter dishes'⌜ counter: counter﴾, سطر-جديد.


>> counter := 0.
⎬
	⎬
		counter أضف: 1.
	⎨ × ﴿3 + 1 + 1 × 0.5﴾.
⎨ × 100.


مخرج اكتب: ﴿⌝'we calculate counter numbers.'⌜ counter: counter﴾, سطر-جديد.

