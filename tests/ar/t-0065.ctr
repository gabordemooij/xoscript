عدد عند: ⌝'factorial'⌜ نفذ: ⎬
	>> total := 1.
	⎬ :index total اضرب-في: ﴿ذات - ﴿index﴾﴾. ⎨ × ذات. <- total.
⎨.
>> Printer := كائن جديد.
Printer عند: ⌝'print:and:'⌜ نفذ: ⎬ :x :y
	مخرج اكتب: ⌝'a='⌜ + x + ⌝', b='⌜ + y, سطر-جديد.
⎨.
>> a := 4.5. >> b := a تقريب-للأدنى.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a تقريب-للأعلى.
Printer print: a and: b.
a := 4.5. b := a تقريب-للأدنى.
Printer print: a and: b.
a := 4.5. b := a تقريب.
Printer print: a and: b.
a := 4.2. b := a تقريب.
Printer print: a and: b.

مخرج اكتب: ﴿9 باقي-القسمة: 5﴾, سطر-جديد.
مخرج اكتب: -666 مطلق, سطر-جديد.
مخرج اكتب: 49 جذر-تربيعي, سطر-جديد.
مخرج اكتب: ﴿2 أس: 3﴾, سطر-جديد.
>> l := ﴿قائمة ← 9 ; 6﴾.
مخرج اكتب: l الأصغر.

