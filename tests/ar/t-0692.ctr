Server init.

مخرج اكتب: ﴿
	نمط جديد: ⌝'^\\w+$'⌜,
	طابق: ⌝'test@example.com'⌜ 
﴾, سطر-جديد. # 0 تطابق، يفشل عند @ و .

مخرج اكتب: ﴿
	نمط جديد: ⌝'^[^@]+@[^\.]+\.\\w+$'⌜,
	طابق: ⌝'test@example.com'⌜ 
﴾, سطر-جديد. # 1 تطابق

مخرج اكتب: ﴿
	نمط جديد: ⌝'[^@]+@[^\.]+\.\\w+'⌜,
	طابق: ⌝'test@example.com'⌜ 
﴾, سطر-جديد. # 1 تطابق

مخرج اكتب: ﴿
	نمط جديد: ⌝'([^@]+)@([^\.]+)\.\\w+'⌜,
	طابق: ⌝'test@example.com'⌜ 
﴾, سطر-جديد. # 1 تطابق، المجموعات لا تهم

مخرج اكتب: ﴿
	نمط جديد: ⌝'[a-z]'⌜,
	طابق: ⌝'test@example.com'⌜ 
﴾, سطر-جديد. # 14 تطابقا

مخرج اكتب: ﴿
	نمط جديد: ⌝'.*'⌜,
	طابق: ⌝'test@example.com'⌜ 
﴾, سطر-جديد. # 1 تطابق (الكل)

مخرج اكتب: ﴿
	نمط جديد: ⌝'(.*)'⌜,
	طابق: ⌝'test@example.com'⌜ 
﴾, سطر-جديد. # 1 تطابق (الكل)

مخرج اكتب: ﴿
	نمط جديد: ⌝'\\s*[^@]+@[^\.]+\.\\w+'⌜,
	طابق: ⌝'test@example.com'⌜ 
﴾, سطر-جديد. # 1 تطابق، المسافة البادئة اختيارية ويتم تجاهلها