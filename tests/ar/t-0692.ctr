Server init.

مخرج اكتب: ﴿
	نمط جديد: ⌝'^\\w+$'⌜,
	طابق: ⌝'test@example.com'⌜ 
﴾, سطر-جديد. # 0 match, fails on @ and .

مخرج اكتب: ﴿
	نمط جديد: ⌝'^[^@]+@[^\.]+\.\\w+$'⌜,
	طابق: ⌝'test@example.com'⌜ 
﴾, سطر-جديد. # 1 match

مخرج اكتب: ﴿
	نمط جديد: ⌝'[^@]+@[^\.]+\.\\w+'⌜,
	طابق: ⌝'test@example.com'⌜ 
﴾, سطر-جديد. # 1 match

مخرج اكتب: ﴿
	نمط جديد: ⌝'([^@]+)@([^\.]+)\.\\w+'⌜,
	طابق: ⌝'test@example.com'⌜ 
﴾, سطر-جديد. # 1 match, groups dont matter

مخرج اكتب: ﴿
	نمط جديد: ⌝'[a-z]'⌜,
	طابق: ⌝'test@example.com'⌜ 
﴾, سطر-جديد. # 14 matches

مخرج اكتب: ﴿
	نمط جديد: ⌝'.*'⌜,
	طابق: ⌝'test@example.com'⌜ 
﴾, سطر-جديد. # 1 match (all)

مخرج اكتب: ﴿
	نمط جديد: ⌝'(.*)'⌜,
	طابق: ⌝'test@example.com'⌜ 
﴾, سطر-جديد. # 1 match (all)

مخرج اكتب: ﴿
	نمط جديد: ⌝'\\s*[^@]+@[^\.]+\.\\w+'⌜,
	طابق: ⌝'test@example.com'⌜ 
﴾, سطر-جديد. # 1 match, prefix space optional, gets ignored