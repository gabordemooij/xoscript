Server init.
>> fmt := تنسيق جديد: ⌝'%#3x'⌜.

>> blob := Blob جديد: 4.
blob بايتات: ﴿ 
	قائمة جديد ; 0 ; 1 ; 2 ; 3
﴾.

>> file := ملف جديد: ⌝'/tmp/blob'⌜.
file blob: blob.
blob حرر.

>> اقرأ := file blob.
اقرأ 
بداية: 0 
طول: 4, 
ابدأ-التتابع لكل: ⎬ :i :b 
	مخرج
	اكتب: ﴿fmt طبق-صحيح: b﴾,
	سطر-جديد.
⎨.
اقرأ حرر.
