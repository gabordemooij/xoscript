#regex test
Server init.
>> subject := ⌝'<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'⌜.
>> pattern := نمط جديد: ⌝'href="([^"]+)" target="([^"]+)"'⌜.
>> result := pattern طابق: subject نفذ: ⎬ :m :x
	مخرج اكتب: m, سطر-جديد.
	مخرج اكتب: x, سطر-جديد. <- ⌝'XXX'⌜.
⎨.
مخرج اكتب: result, سطر-جديد.