Server init.

>> قاعدة-البيانات := Maria-DB جديد مضيف: ⌝'localhost'⌜,
	اسم-المستخدم: ⌝'xo'⌜,
	كلمة-السر: ⌝'pass123'⌜,
	اسم-القاعدة: ⌝'xobase'⌜,
	اتصل.
	
>> SQL := ⌝'SELECT "hello" AS "world" '⌜.

# طريقة أسرع، احصل على الاستعلام من قاعدة-البيانات:
>> استعلام2 := قاعدة-البيانات استعلام: SQL.

# الآن لست بحاجة إلى ضبط قاعدة-البيانات
استعلام2 اجلب: ⎬ :صف
	مخرج اكتب: صف world, سطر-جديد.
⎨.
