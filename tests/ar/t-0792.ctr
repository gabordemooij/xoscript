Server init.

>> DB := Maria-DB جديد مضيف: ⌝'localhost'⌜,
	اسم-المستخدم: ⌝'xo'⌜,
	كلمة-السر: ⌝'pass123'⌜,
	اسم-القاعدة: ⌝'xobase'⌜,
	اتصل.
	
>> SQL := ⌝'SELECT "hello" AS "world" '⌜.

# a quicker way, get query from DB:
>> query2 := DB استعلام: SQL.

# now you don't have to set DB
query2 اجلب: ⎬ :row
	مخرج اكتب: row world, سطر-جديد.
⎨.
