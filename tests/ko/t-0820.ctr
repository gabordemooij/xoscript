# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := 패턴 새로: pattern.
	p 일치: subject 실행: { :m :g
		출력 쓰기: g 개수, 쓰기: [' '], 쓰기: (g 합치기: ['|']), 줄바꿈. <- m.
	}.
}.
show 적용: ['(a)|(b)'] 그리고: ['b'].
show 적용: ['(a)|(b)'] 그리고: ['a'].
show 적용: ['(x)?y'] 그리고: ['y'].
show 적용: ['(x)?(y)(z)?'] 그리고: ['xy'].
