# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := 금고 키생성.

# private (secret) key
>> sk := keys 첫번째.

# public key
>> pk := keys 마지막.

# sign a message
>> sig := 금고 서명: ['abc'] 키로: sk.

# check message (ok)
출력 쓰기: ( 
	금고
		확인: ['abc'] 
		서명: sig 
		키로: pk 
), 줄바꿈.

# check message (fail)
출력 쓰기: ( 
	금고 
		확인: ['abd'] 
		서명: sig 
		키로: pk 
), 줄바꿈.