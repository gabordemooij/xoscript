# a value ending in the first part of an opening quote must survive serialization
>> 값들 := 리스트 새로
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

값들 각각: { :i :value
	>> d := 사전 새로.
	d 넣기: value 위치: ['k'].
	d 넣기: ['second'] 위치: ['j'].
	>> r := d 코드 객체로.
	출력 쓰기: r 개수, 줄바꿈.
	출력 쓰기: ( (r 위치에서: ['k']) = value ), 줄바꿈.
}.
