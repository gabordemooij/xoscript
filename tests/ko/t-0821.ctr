# a quote that never closes must give an error, not an endless loop
>> 파일경로 := ['/tmp/test0821.csv'].
>> file := 파일 새로: 파일경로.

file 쓰기: ['a,b\n"1,2\n'].
{
	file 구분자: [','] 따옴표: ['"'] 줄마다: { :line
		출력 쓰기: line, 줄바꿈.
	}.
} 예외시: { :e 출력 쓰기: e, 줄바꿈. }, 시작.

# a closed quote still works
file 쓰기: ['a,b\n"1,2",3'].
file 구분자: [','] 따옴표: ['"'] 줄마다: { :line
	출력 쓰기: line, 줄바꿈.
}.
file 삭제.
