>> 인사기 := 객체 새로.
인사기 받으면: ['만들기'] 실행: {
	>> 인사객체 := 객체 새로.
	인사객체 받으면: ['setName:'] 실행: { :새이름
		자기 이름 := 새이름.
	}.
	인사객체 받으면: ['인사하기'] 실행: {
		출력 쓰기: 자기 이름.
	}. <- 인사객체.
}.
>> a := 인사기 만들기.
>> b := 인사기 만들기.
a setName: ['ONE'].
b setName: ['둘'].
a 인사하기.
b 인사하기.
>> c := a 새로.
c setName: ['셋'].
c 인사하기.
>> d := a 새로.
d setName: ['FOUR'].
d 인사하기.
c 인사하기.
