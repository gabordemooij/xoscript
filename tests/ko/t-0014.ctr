>> Greeter := 객체 새로.
Greeter 받으면: ['make'] 실행: {
	>> gr := 객체 새로.
	gr 받으면: ['setName:'] 실행: { :aname
		자기 이름 := aname.
	}.
	gr 받으면: ['greet'] 실행: {
		출력 쓰기: 자기 이름.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a 새로.
c setName: ['THREE'].
c greet.
>> d := a 새로.
d setName: ['FOUR'].
d greet.
c greet.
