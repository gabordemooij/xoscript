>> Greeter := 객체 새로.
Greeter 받으면: ['make'] 실행: {
	>> greeter := 객체 새로.
	greeter 받으면: ['name:'] 실행: { :이름
		출력 쓰기: ['setting a name'].
		자기 myName := 이름.
	}.
	greeter 받으면: ['greet'] 실행: {
		출력 쓰기: ['Hello'].
		출력 쓰기: 자기 myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
