#Linux

 >> t := 시점 새로.
 
t 시간대: ['Europe/Amsterdam'].
t 연도: 2020, 월값: 8, 일값: 2, 시간: 21, 분값: 2, 초값: 1.

>> a := t 시간.
>> ams := t 시간대.

t 시간대: ['US/Hawaii'].
>> b := t 시간.
>> hw := t 시간대.

출력
쓰기: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		둘중하나: ['더 늦음'] 또는: ['더 이름']
	)
),
줄바꿈.
 