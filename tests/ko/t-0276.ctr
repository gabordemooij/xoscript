>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := 객체 새로.
⚄ 받으면: ['drawFrom:length:'] 실행: { :pool :개수
	
	>> result := [''].
	
	{
		>> index := 숫자 random % (pool 길이).
		result 뒤에추가: ( pool 문자: (index + 1) ).
		
	} × 개수. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? 길이.
출력 쓰기: (['x↵'] x random 길이).
출력 쓰기: (['y↵'] y ?? 길이).

