Server init.

# JSON 인코더는 UTF-8만 지원, 서로게이트 쌍은 지원 안 함

>> 사전들 := 리스트 새로 ;
	# {"key":"normal"} 일반 ASCII
	( 사전 새로 넣기: ['normal'] 위치: ['key'] ) ;
	# {"key":"hello world"} 공백 문자
	( 사전 새로 넣기: ['hello world'] 위치: ['key'] ) ;
	# {"key":"quote: \""} 큰따옴표
	( 사전 새로 넣기: ['"'] 위치: ['key'] ) ;
	# {"key":"backslash: \\"} 백슬래시
	( 사전 새로 넣기: ['backslash: \\'] 위치: ['key'] ) ;
	# {"key":"slash: /"} 슬래시
	( 사전 새로 넣기: ['슬래시: /'] 위치: ['key'] ) ;
	# {"key":"backspace: \b"} 백스페이스
	( 사전 새로 넣기: ['backspace: \b'] 위치: ['key'] ) ;
	# {"key":"formfeed: \f"} 폼피드 이스케이프
	( 사전 새로 넣기: ['formfeed: \f'] 위치: ['key'] ) ;
	# {"key":"newline: \n"} 줄바꿈
	( 사전 새로 넣기: ['newline: \n'] 위치: ['key'] ) ;
	( 사전 새로 넣기: ['newline: ↵'] 위치: ['key'] ) ;
	( 사전 새로 넣기: ['newline: 
	'] 위치: ['key'] ) ;
	# {"key":"carriage return: \r"} 캐리지 리턴
	( 사전 새로 넣기: ['carriage return: \r'] 위치: ['key'] ) ;
	# {"key":"tab: \t"} 탭
	( 사전 새로 넣기: ['tab \t'] 위치: ['key'] ) ;
	( 사전 새로 넣기: ['tab ⇿'] 위치: ['key'] ) ;
	( 사전 새로 넣기: ['탭  '] 위치: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( 사전 새로 넣기: ['NUL \u0000'] 위치: ['key'] ) ;
	( 사전 새로 넣기: ['NUL \0'] 위치: ['key'] ) ;
	# {"key":"control: \u0001"} 제어 문자 0x01
	( 사전 새로 넣기: ['control: \u0001'] 위치: ['key'] ) ;
	# {"key":"control: \u001F"} 제어 문자 0x1F
	( 사전 새로 넣기: ['control: \u001F'] 위치: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2바이트 문자
	( 사전 새로 넣기: ['유니코드: é'] 위치: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3바이트 문자
	( 사전 새로 넣기: ['유니코드: €'] 위치: ['key'] ) ;
	# {"key":"unicode: 日本語"} 여러 개의 3바이트 UTF-8 문자
	( 사전 새로 넣기: ['유니코드: 日本語'] 위치: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4바이트 문자
	( 사전 새로 넣기: ['유니코드: 😀'] 위치: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} 이모지 + 제로 폭 결합자
	( 사전 새로 넣기: ['유니코드: 🧑‍💻'] 위치: ['key'] ) ;
	# {"key":"combining: é"} 결합 악센트
	( 사전 새로 넣기: ['combining: e\u0301'] 위치: ['key'] ) ;
	# {"key":"escaped unicode: é"} 유니코드 이스케이프 BMP
	( 사전 새로 넣기: ['escaped unicode: \u00e9'] 위치: ['key'] ) ;
	# {"key":"escaped unicode: €"} 유니코드 이스케이프 BMP
	( 사전 새로 넣기: ['escaped unicode: \u20ac'] 위치: ['key'] ) ;
	# {"key":"escaped unicode: 😀"} UTF-16 서로게이트 쌍
	( 사전 새로 넣기: ['escaped unicode: \ud83d\ude00'] 위치: ['key'] ) ;
	# {"key":""} 빈 값
	( 사전 새로 넣기: [''] 위치: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} 특수 ASCII 문자
	( 사전 새로 넣기: ['@ < > & = % + ? #'] 위치: ['key'] ) ;
	# {"key":"single quote: '"} 작은따옴표
	( 사전 새로 넣기: ['''] 위치: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} 여러 JSON 이스케이프
	( 사전 새로 넣기: ['multiple: \" \\ \n \r \t'] 위치: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} 더 긴 ASCII 문자열
	( 사전 새로 넣기: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] 위치: ['key'] ) ;
	# {"key":" value"} 앞 공백
	( 사전 새로 넣기: [' 값'] 위치: ['key'] ) ;
	# {"key":"value "} 뒤 공백
	( 사전 새로 넣기: ['값 '] 위치: ['key'] ) ;
	# {"key":" \t\n\r "} 공백 문자들
	( 사전 새로 넣기: [' \t\n\r '] 위치: ['key'] )
	.

사전들 각각: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (사전 새로 넣기: d key 위치: ['key']).
	>> b := JSON jsonify: (사전 새로 넣기: ['value'] 위치: d key).
	>> e := JSON 객체: a.
	>> f := JSON 객체: b.
	((e key = d key 그리고: (f ? d key = ['value'])) 또는: (e key = ['NUL ?'])) 참이면: {
		출력 쓰기: ['OK'], 줄바꿈.
	}, 아니면: {
		출력 쓰기: ['제대로 인코딩/디코딩할 수 없음: '] + d + j, 줄바꿈.
		프로그램 종료.
	}.
}.
