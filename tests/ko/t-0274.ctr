

리스트 받으면: ['column:'] 실행: { :column
	>> result := 리스트 새로.
	자신 각각: { :index :row
		row 각각: { :index :cell
			(index = column) 참이면: { result 뒤에추가: cell. }.
		}.
	}. <- result.
}.


>> a := 리스트 ←
	(리스트 ← 1 ; 2 ; 3) ;
	(리스트 ← 4 ; 5 ; 6) ;
	(리스트 ← 7 ; 8 ; 9).

>> b := a column: 1.
출력 쓰기: b, 줄바꿈.

b := a column: 20.
출력 쓰기: b, 줄바꿈.

b := a column: -100.
출력 쓰기: b, 줄바꿈.
