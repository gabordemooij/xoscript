
>> dictionary := (
	사전 새로
		넣기: ['b'] 위치: ['a'],
		넣기: ['a'] 위치: ['b'],
		넣기: ['z'] 위치: ['x'],
		넣기: ['hello'] 위치: ['hallo'],
		넣기: ['human'] 위치: ['human']
).

>> comparisons := 리스트 새로.
dictionary 각각: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a 비교: b)
	).
}.

comparisons 정렬: { :a :b <- ( a 비교: b ). }.
출력 쓰기: ( comparisons 합치기: ['↵'] ), 줄바꿈.
comparisons 합치기: ['↵'].
