문자열 받으면: ['html'] 실행: { <- (
		자신
		바꾸기: ['&'] 새값: ['&amp;'],
		바꾸기: ['<'] 새값: ['&lt;'],
		바꾸기: ['>'] 새값: ['&gt;'],
		바꾸기: ['''] 새값: ['&apos;'],
		바꾸기: ['"'] 새값: ['&quot;']
	).
}.

>> usedMemory1 := 0.
