60 × {
	>> x := (숫자 random % 6) + 1.
	(x ≤ 6) 거짓이면: { 출력 쓰기: ['FAIL']. }.
	(x ≥0) 거짓이면: { 출력 쓰기: ['FAIL']. }.
	x := (숫자 random % 3) + 1.
	(x < 3) 거짓이면: { 출력 쓰기: ['FAIL']. }.
	(x>-1) 거짓이면: { 출력 쓰기: ['FAIL']. }.
	x := ((불리언 flip) 숫자로).
	(x = 0 또는: x = 1) 거짓이면: { 출력 쓰기: ['FAIL']. }.
	x := ((참 flip) 숫자로).
	(x = 0 또는: x = 1) 거짓이면: { 출력 쓰기: ['FAIL']. }.
	x := (불리언 flip 둘중하나: ['HEAD'] 또는: ['TAIL']).
	((x = ['HEAD']) 또는: (x = ['TAIL'])) 거짓이면: { 출력 쓰기: ['FAIL']. }.
}.
출력 쓰기: ['DONE'].

