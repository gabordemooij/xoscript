>> x := 없음.
{

	x := ['hello'] 
	바꾸기:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] 문자: 2)
			)
		)
	새값: (
		(['...hal'] + ['lo']) 
			대문자 
			lowecase 
			대문자 
			오프셋: -1 + ( 
				11 - 12 + (
					(
						(
							(
								리스트 ← 0 ; 1 ; 4; 9 ; (리스트 ← 0 ; 3; 1) ; 4
							) 끝에서두번째
						) ? 1
					) + 
					((리스트 ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
