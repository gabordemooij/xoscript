리스트 받으면: ['sum'] 실행: {
	>> 합계 := 0.
	자신 각각: { :인덱스 :요소
		합계 더하기: 요소.
	}. <- 합계.
}.

>> a := 참.



a 받으면: ['문자열로'] 실행: {
	>> 답 := 없음.
	( 자신 = 참 ) 참이면: {
		답 := ['응'].
	}, 아니면: {
		답 := ['아니'].
	}. <- 답.
}.

a 받으면: ['숫자로'] 실행: {
	>> 답 := 없음.
	( 자신 = 참 ) 참이면: {
		답 := 10.
	}, 아니면: {
		답 := 20.
	}. <- 답.
}.

>> b := 666.

b 받으면: ['문자열로'] 실행: { <- ['악마'].
}.

b 받으면: ['불리언으로'] 실행: { <- 거짓.
}.


출력 쓰기: a, 줄바꿈.  
출력 쓰기: (90 + a), 줄바꿈. 
출력 쓰기: b, 줄바꿈. 
출력 쓰기: (참 그리고: b), 줄바꿈.

a := 리스트 ← ['hello'] ; ['world'] ; 참 ; 없음 ; 666. 
a := a + ( 리스트 ← 1 ).
출력 쓰기: a, 줄바꿈.
