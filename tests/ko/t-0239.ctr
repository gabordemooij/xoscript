리스트 받으면: ['sum'] 실행: {
	>> total := 0.
	자신 각각: { :index :element
		total 더하기: element.
	}. <- total.
}.

>> a := 참.



a 받으면: ['문자열로'] 실행: {
	>> answer := 없음.
	( 자신 = 참 ) 참이면: {
		answer := ['Yep'].
	}, 아니면: {
		answer := ['Nope'].
	}. <- answer.
}.

a 받으면: ['숫자로'] 실행: {
	>> answer := 없음.
	( 자신 = 참 ) 참이면: {
		answer := 10.
	}, 아니면: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b 받으면: ['문자열로'] 실행: { <- ['Devil'].
}.

b 받으면: ['불리언으로'] 실행: { <- 거짓.
}.


출력 쓰기: a, 줄바꿈.  
출력 쓰기: (90 + a), 줄바꿈. 
출력 쓰기: b, 줄바꿈. 
출력 쓰기: (참 그리고: b), 줄바꿈.

a := 리스트 ← ['hello'] ; ['world'] ; 참 ; 없음 ; 666. 
a := a + ( 리스트 ← 1 ).
