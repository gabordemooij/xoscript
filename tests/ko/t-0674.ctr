# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> 파일경로 := ['/tmp/dat.csv'].
>> csv := 파일 새로: 파일경로.
csv 쓰기: s.

# accepts CRLF LF CR, varying row length
csv 구분자: [';'] 따옴표: ['"'] 줄마다: { :line
	프로그램 정리.
	출력 쓰기: line, 줄바꿈.
	프로그램 정리.
}.

# unequal lines
s 뒤에추가: ['\njustone'].
csv 쓰기: s.
{
	csv 구분자: [';'] 따옴표: ['"'] 줄마다: { :line
		출력 쓰기: line, 줄바꿈.
	}.
} 예외시: { :e 
	출력 쓰기: e, 줄바꿈.
}, 시작.

# invalid format
s := ['"he"llo";world'].
csv 쓰기: s.
{
	csv 구분자: [';'] 따옴표: ['"'] 줄마다: { :line
		출력 쓰기: line, 줄바꿈.
	}.
} 예외시: { :e 
	출력 쓰기: e, 줄바꿈.
}, 시작.
