Server init.

>> DB := Maria-DB 새로 호스트: ['localhost'],
	사용자이름: ['xo'],
	비밀번호: ['pass123'],
	데이터베이스이름: ['xobase'],
	접속.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB 쿼리: SQL.

# now you don't have to set DB
query2 가져오기: { :row
	출력 쓰기: row world, 줄바꿈.
}.
