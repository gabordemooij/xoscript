
문자열 받으면: ['html'] 실행: { <- (
		자신
		바꾸기: ['&'] 새값: ['&amp;'],
		바꾸기: ['<'] 새값: ['&lt;'],
		바꾸기: ['>'] 새값: ['&gt;'],
		바꾸기: ['"'] 새값: ['&quot;']
	).
}.

>> Html붓 := 객체 새로.

Html붓 받으면: ['응답:'] 실행: { :tag
	출력 쓰기: (['<tag>↵'] tag: tag ).
}.

Html붓 받으면: ['응답:그리고:'] 실행: { :tag :content
	tag := ( tag 시작: 0 길이: (tag 길이 - 1) ).
	출력 쓰기: (['<tag content>↵'] tag: tag, content: content).
}.

Html붓 받으면: ['content:'] 실행: { :글
	출력 쓰기: 글 html, 줄바꿈.
}.

Html붓 받으면: ['attr:값:'] 실행: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := Html붓 새로.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] 값: ['bold']),
		/span
	/body
/html.
		
