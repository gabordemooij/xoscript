>> Animal := 객체 새로.
Animal 받으면: ['make'] 실행: {
	>> animal := 객체 새로.
	animal 받으면: ['makeSound'] 실행: {
		출력 쓰기: 자기 sound.
	}. <- animal.
}.
>> Cat := 객체 새로.
Cat 받으면: ['make'] 실행: {
	>> cat := Animal make.
	cat 받으면: ['init'] 실행: {
		자기 sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
