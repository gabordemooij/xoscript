>> a := 3.
>> b := a 복사.
a 빼기: 1.
출력 쓰기: [' a = '] + a.
출력 쓰기: [' b = '] + b.
a := 3.
b := a + 4.
출력 쓰기: [' a = '] + a.
출력 쓰기: [' b = '] + b.
>> x := 3.
>> y := x 복사.
x 더하기: 10.
y 빼기: 1.
출력 쓰기: [' x = '] + x.
출력 쓰기: [' y = '] + y.
>> q := 객체 새로.
q 받으면: ['setProperty:'] 실행: { :x
	자기 prop := x.
}.
q 받으면: ['getProperty'] 실행: { <- 자기 prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
출력 쓰기: [' p = '] + (p getProperty).
