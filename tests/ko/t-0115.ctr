{
	이작업 오류: ['Dont fail.'].
	unknown doSomething.
} 예외시: {
	출력 쓰기: ['Caught!'].
}, 시작.

{
	이작업 오류: ['Dont fail.'].
	자기 unknown doSomething.
} 예외시: {
	출력 쓰기: ['Caught!'].
}, 시작.

{
	이작업 오류: ['Dont fail.'].
	unknown := 122.
} 예외시: {
	출력 쓰기: ['Caught!'].
}, 시작.


{
	이작업 오류: ['Dont fail.'].
	참 중단.
	출력 쓰기: ['FAIL'].
} 예외시: {
	출력 쓰기: ['Caught!'].
}, 시작.

{
	{
		이작업 오류: ['Dont fail.'].
		참 중단.
		출력 쓰기: ['FAIL'].
	} 예외시: { :x
		(x = ['Dont fail.']) 참이면: { 이작업 오류: ['Nested Caught!']. }.
	}, 시작.
} 예외시: { :e
	출력 쓰기: e.
}, 시작.
