	미지 := 122.
} 예외시: {
	출력 쓰기: ['잡았다!'].
}, 시작.


{
	이작업 오류: ['실패하지 마.'].
	참 중단.
	출력 쓰기: ['실패'].
} 예외시: {
	출력 쓰기: ['잡았다!'].
}, 시작.

{
	{
		이작업 오류: ['실패하지 마.'].
		참 중단.
		출력 쓰기: ['실패'].
	} 예외시: { :x
		(x = ['실패하지 마.']) 참이면: { 이작업 오류: ['중첩해서 잡았다!']. }.
	}, 시작.
} 예외시: { :e
	출력 쓰기: e.
}, 시작.
