

>> Matryoshka := 객체 새로.
Matryoshka 받으면: ['double:'] 실행: { :secret
	자기 secret := secret × 2.
}.
Matryoshka 받으면: ['새로:'] 실행: { :secret
	>> answer := 없음.
	>> t := (secret > 255).
	출력 쓰기: (secret + [' | '] + t), 줄바꿈.
	t 참이면: {
		answer := secret.
	}, 아니면: {
		answer := Matryoshka 재귀 새로: (자신 double: secret).
	}. <- answer.
}.

>> x := Matryoshka 새로: 2.
