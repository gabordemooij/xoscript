

리스트 받으면: ['sum'] 실행: {
	>> 합계 := 0.
	자신 각각: { :인덱스 :요소
		합계 더하기: 요소.
	}. <- 합계.
}.

리스트 받으면: ['product'] 실행: {
	>> 합계 := 1.
	자신 각각: { :인덱스 :요소
		합계 곱하기: 요소.
	}. <- 합계.
}.

>> 사용메모리1 := 0.
>> 사용메모리2 := 0.
>> 사용메모리3 := 0.
>> 사용메모리4 := 0.

프로그램 메모리관리: 0.

{

>> a := 리스트 ← ['hello'] ; ['world'] ; 참 ; 없음 ; 666.
a := a + ( 리스트 ← 1 ).
출력 쓰기: ( ['합: '] + ( a sum ) ), 줄바꿈.
출력 쓰기: ( ['최소: '] + ( a 최솟값 ) ), 줄바꿈.
출력 쓰기: ( ['최대: '] + ( a 최댓값 ) ), 줄바꿈.
출력 쓰기: ( ['셋째: '] + ( a ? 2 ) ), 줄바꿈.
출력 쓰기: ( ['곱: '] + ( a product ) ), 줄바꿈.
a 정렬: { :a :b <- (b - a). }.
a 각각: { :i :e 출력 쓰기: ( i - 0 ), 줄바꿈. }.

} 시작.

프로그램 정리.
사용메모리1 := (프로그램 메모리 ? 0).


{

>> a := 리스트 ← ['hello'] ; ['world'] ; 참 ; 없음 ; 666.
a := a + ( 리스트 ← 1 ).
출력 쓰기: ( ['합: '] + ( a sum ) ), 줄바꿈.
출력 쓰기: ( ['최소: '] + ( a 최솟값 ) ), 줄바꿈.
출력 쓰기: ( ['최대: '] + ( a 최댓값 ) ), 줄바꿈.
출력 쓰기: ( ['셋째: '] + ( a ? 2 ) ), 줄바꿈.
출력 쓰기: ( ['곱: '] + ( a product ) ), 줄바꿈.
a 정렬: { :a :b <- (b - a). }.
a 각각: { :i :e 출력 쓰기: ( i - 0 ), 줄바꿈. }.

} 시작.



프로그램 정리.
사용메모리2 := (프로그램 메모리 ? 0).


{

>> a := 리스트 ← ['hello'] ; ['world'] ; 참 ; 없음 ; 666.
a := a + ( 리스트 ← 1 ).
출력 쓰기: ( ['합: '] + ( a sum ) ), 줄바꿈.
출력 쓰기: ( ['최소: '] + ( a 최솟값 ) ), 줄바꿈.
출력 쓰기: ( ['최대: '] + ( a 최댓값 ) ), 줄바꿈.
출력 쓰기: ( ['셋째: '] + ( a ? 2 ) ), 줄바꿈.
출력 쓰기: ( ['곱: '] + ( a product ) ), 줄바꿈.
a 정렬: { :a :b <- (b - a). }.
a 각각: { :i :e 출력 쓰기: ( i - 0 ), 줄바꿈. }.

} 시작.



프로그램 정리.
사용메모리3 := (프로그램 메모리 ? 0).

( 사용메모리1 = 사용메모리2 그리고: 사용메모리1 = 사용메모리3, 그리고: 사용메모리2 = 사용메모리3 ) 참이면: {
	출력 쓰기: ['여기엔 메모리 누수 없음'].
}, 거짓이면: {
	출력 쓰기: ['메모리 누수 중...'].
}.
