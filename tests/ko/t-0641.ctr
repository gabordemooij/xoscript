# utf8 정화기 테스트
Server init.

>> utf8사례 := 사전 새로
	# ASCII만
	넣기: ( 리스트 새로 ; 65 ; 65 ; 65 ; 65 ; 0 ) 위치: ['AAAA'],
	# 유효한 2바이트 시퀀스
	넣기: ( 리스트 새로 ; 194 ; 162 ; 0 ) 위치: ['¢'],
	# 유효한 3바이트 UTF-8
    넣기: ( 리스트 새로 ; 226 ; 130 ; 172 ; 0 ) 위치: ['€'],
	# 유효한 4바이트 UTF-8
    넣기: ( 리스트 새로 ; 240 ; 144 ; 141 ; 136 ; 0 ) 위치: ['𐍈'],
	# 시퀀스 E2 28 AC의 잘못된 연속 바이트 -> 3b 시퀀스 시작 + 28 잘못된 cnt + AC cnt 바이트, 하지만 같은 오류에 속함
    넣기: ( 리스트 새로 ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) 위치: ['A?A'],
	# ASCII 'A'의 과잉 길이 인코딩 (?가 되어야 함),
    넣기: ( 리스트 새로 ; 65 ; 193 ; 129 ; 0 ) 위치: ['A?'],
	# 잘못된 첫 바이트 (0xFF)
    넣기: ( 리스트 새로 ; 255 ; 0 ) 위치: ['?'],
	# 끝에 있는 불완전한 멀티바이트 시퀀스
    넣기: ( 리스트 새로 ; 66 ; 226 ; 0 ) 위치: ['B?'],
    # 빈 문자열
    #put: ( List new ) at: [''],
	# 여러 혼합 시퀀스
    넣기: ( 리스트 새로 ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) 위치: ['A€?𐍈B'].
	 
utf8사례 각각: { :key :value
	>> blob := Blob 새로: value 개수, bytes: value.
	>> str := blob 문자열로.
	(str = key) 참이면: {
		출력 쓰기: ['OK'], 줄바꿈.
	}, 아니면: {
		출력 쓰기: ['UTF8 정제 실패: '] + key + [' 결과: '] + str, 줄바꿈.
	}.
	blob 해제.
}.
