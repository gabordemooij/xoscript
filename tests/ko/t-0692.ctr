Server init.

출력 쓰기: (
	패턴 새로: ['^\\w+$'],
	일치: ['test@example.com'] 
), 줄바꿈. # 0 match, fails on @ and .

출력 쓰기: (
	패턴 새로: ['^[^@]+@[^\.]+\.\\w+$'],
	일치: ['test@example.com'] 
), 줄바꿈. # 1 match

출력 쓰기: (
	패턴 새로: ['[^@]+@[^\.]+\.\\w+'],
	일치: ['test@example.com'] 
), 줄바꿈. # 1 match

출력 쓰기: (
	패턴 새로: ['([^@]+)@([^\.]+)\.\\w+'],
	일치: ['test@example.com'] 
), 줄바꿈. # 1 match, groups dont matter

출력 쓰기: (
	패턴 새로: ['[a-z]'],
	일치: ['test@example.com'] 
), 줄바꿈. # 14 matches

출력 쓰기: (
	패턴 새로: ['.*'],
	일치: ['test@example.com'] 
), 줄바꿈. # 1 match (all)

출력 쓰기: (
	패턴 새로: ['(.*)'],
	일치: ['test@example.com'] 
), 줄바꿈. # 1 match (all)

출력 쓰기: (
	패턴 새로: ['\\s*[^@]+@[^\.]+\.\\w+'],
	일치: ['test@example.com'] 
), 줄바꿈. # 1 match, prefix space optional, gets ignored