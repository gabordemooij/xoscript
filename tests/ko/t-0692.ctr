Server init.

출력 쓰기: (
	패턴 새로: ['^\\w+$'],
	일치: ['test@example.com'] 
), 줄바꿈. # 일치 0개, @와 .에서 실패

출력 쓰기: (
	패턴 새로: ['^[^@]+@[^\.]+\.\\w+$'],
	일치: ['test@example.com'] 
), 줄바꿈. # 일치 1개

출력 쓰기: (
	패턴 새로: ['[^@]+@[^\.]+\.\\w+'],
	일치: ['test@example.com'] 
), 줄바꿈. # 일치 1개

출력 쓰기: (
	패턴 새로: ['([^@]+)@([^\.]+)\.\\w+'],
	일치: ['test@example.com'] 
), 줄바꿈. # 일치 1개, 그룹은 상관없음

출력 쓰기: (
	패턴 새로: ['[a-z]'],
	일치: ['test@example.com'] 
), 줄바꿈. # 일치 14개

출력 쓰기: (
	패턴 새로: ['.*'],
	일치: ['test@example.com'] 
), 줄바꿈. # 일치 1개 (전체)

출력 쓰기: (
	패턴 새로: ['(.*)'],
	일치: ['test@example.com'] 
), 줄바꿈. # 일치 1개 (전체)

출력 쓰기: (
	패턴 새로: ['\\s*[^@]+@[^\.]+\.\\w+'],
	일치: ['test@example.com'] 
), 줄바꿈. # 일치 1개, 앞 공백은 선택이며 무시됨