>> phrases := 리스트 새로
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases 각각: { :_ :phrase 
	>> e := Server base64-인코딩: phrase.
	>> d := Server base64-디코딩: e.
	출력 쓰기: (
		message 복사 ~encoded: e, ~decoded: d
	), 줄바꿈.
}.
