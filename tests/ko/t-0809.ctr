# backslashes must survive code serialization, strings must not end early
>> 값들 := 리스트 새로
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

값들 각각: { :i :value
	>> d := 사전 새로.
	d 넣기: value 위치: ['k'].
	>> r := d 코드 객체로.
	출력 쓰기: r 개수, 줄바꿈.
	출력 쓰기: ( (r 위치에서: ['k']) = value ), 줄바꿈.
}.
