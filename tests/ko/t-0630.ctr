#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := 패턴 새로: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern 일치: subject 실행: { :m :x
	출력 쓰기: m, 줄바꿈.
	출력 쓰기: x, 줄바꿈. <- ['XXX'].
}.
출력 쓰기: result, 줄바꿈.