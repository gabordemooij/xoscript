# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := 객체 새로.

Log 받으면: ['say:'] 실행: { :str
	출력 쓰기: str, 줄바꿈.
}.

>> Item := 객체 새로.

Item 받으면: ['새로:'] 실행: { :id <- 자신 새로 id: id.
}.

Item 받으면: ['id:'] 실행: { :id
	자기 id := id.
}.

Item 받으면: ['id'] 실행: { <- 자기 id. }.


Item 받으면: ['문자열로'] 실행: {
	>> str := ['Item#~no'].
	str ~no: 자기 id. <- str.
}.


>> Print := 객체 새로.

Print 받으면: ['items'] 실행: { 
	
	자기 item := Item 새로: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: 자기 item
	).
	
	
}.

Print items.