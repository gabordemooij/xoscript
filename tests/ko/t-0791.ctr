Server init.

>> DB := Maria-DB 새로 호스트: ['localhost'],
	사용자이름: ['xo'],
	비밀번호: ['pass123'],
	데이터베이스이름: ['xobase'],
	접속.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> 검색매개변수 := Maria-쿼리 새로: SQL.

# set database
검색매개변수 데이터베이스: DB.

검색매개변수 가져오기: { :row
	출력 쓰기: row world, 줄바꿈.
}.
