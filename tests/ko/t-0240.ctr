# test qualifiers

>> $ := 객체 새로.

$ 받으면: ['응답:'] 실행: { :x
	
	>> operation := x 문자: 0.
	>> valuta := x 문자: 1.
	>> money := x 오프셋: 2.
	
	>> amount := 0.

	( operation = ['+'] ) 참이면: {
		( valuta = ['£'] ) 참이면: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

출력 쓰기: x, 줄바꿈.


>> Fruit := 객체 새로.

Fruit 받으면: ['새로'] 실행: {
	>> f := 자신 새로.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit 받으면: ['apples:'] 실행: { :a 자기 apples := a. }.
Fruit 받으면: ['oranges:'] 실행: { :p 자기 oranges := p. }.
Fruit 받으면: ['apples'] 실행: { <- 자기 apples. }.
Fruit 받으면: ['oranges'] 실행: { <- 자기 oranges. }.

Fruit 받으면: ['+'] 실행: { :f
	
	>> n := Fruit 새로.
	f 더하기: 1.
	
	n apples: (f apples + 자기 apples).
	n oranges:  (f oranges  + 자기 oranges). <- n.
}.

Fruit 받으면: ['문자열로'] 실행: { <- ( 자기 apples 문자열로 + [' apples and '] + 자기 oranges + [' oranges'] ).
}.

숫자 받으면: ['apples'] 실행: { <- ((Fruit 새로) apples: 자신).
}.

숫자 받으면: ['apple'] 실행: { <- ((Fruit 새로) apples: 자신).
}.

숫자 받으면: ['oranges'] 실행: { <- ((Fruit 새로) oranges: 자신).
}.




출력 쓰기: (1 apple + 3 oranges + 4 apples), 줄바꿈.


문자열 받으면: ['twice'] 실행: { <- ((자신 문자열로) + (자신 문자열로)).
}.



출력 쓰기: ['❤❤❤'] twice.



