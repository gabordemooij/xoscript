# 단위 테스트

>> $ := 객체 새로.

$ 받으면: ['응답:'] 실행: { :x
	
	>> 연산 := x 문자: 0.
	>> 통화기호 := x 문자: 1.
	>> 돈 := x 오프셋: 2.
	
	>> 금액 := 0.

	( 연산 = ['+'] ) 참이면: {
		( 통화기호 = ['£'] ) 참이면: { 금액 := 1.28 × 돈. }.
	}. <- 금액.
}.



>> x := $ +£20.

출력 쓰기: x, 줄바꿈.


>> 과일 := 객체 새로.

과일 받으면: ['새로'] 실행: {
	>> f := 자신 새로.
	f apples: 0.
	f oranges: 0. <- f.
}.

과일 받으면: ['apples:'] 실행: { :a 자기 사과 := a. }.
과일 받으면: ['oranges:'] 실행: { :p 자기 오렌지 := p. }.
과일 받으면: ['사과'] 실행: { <- 자기 사과. }.
과일 받으면: ['오렌지'] 실행: { <- 자기 오렌지. }.

과일 받으면: ['+'] 실행: { :f
	
	>> n := 과일 새로.
	f 더하기: 1.
	
	n apples: (f 사과 + 자기 사과).
	n oranges:  (f 오렌지  + 자기 오렌지). <- n.
}.

과일 받으면: ['문자열로'] 실행: { <- ( 자기 사과 문자열로 + [' 개의 사과와 '] + 자기 오렌지 + [' 개의 오렌지'] ).
}.

숫자 받으면: ['사과'] 실행: { <- ((과일 새로) apples: 자신).
}.

숫자 받으면: ['apple'] 실행: { <- ((과일 새로) apples: 자신).
}.

숫자 받으면: ['오렌지'] 실행: { <- ((과일 새로) oranges: 자신).
}.




출력 쓰기: (1 apple + 3 오렌지 + 4 사과), 줄바꿈.


문자열 받으면: ['두번'] 실행: { <- ((자신 문자열로) + (자신 문자열로)).
}.



출력 쓰기: ['❤❤❤'] 두번.



