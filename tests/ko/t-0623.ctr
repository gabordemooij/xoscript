

>> g  := Server 새로.
>> v  := 금고 새로.
>> ok := 0.

>> 비밀들 := 리스트 새로 ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> 비밀번호들 := 비밀들 복사.
비밀번호들 각각: { :i :p
	비밀들 각각: { :n :s
		{
			>> 암호문 := v 암호화: s 키: p.
			>> 복호문 := v 복호화: 암호문 키: p.
			(복호문 = s) 참이면: {
				ok 더하기: 1.
			}, 아니면: {
				출력 쓰기: ['암호화/복호화 실패: '], 줄바꿈.
				출력 쓰기: s, 줄바꿈.
				출력 쓰기: ['암호화됨: '] + 암호문, 줄바꿈.
				출력 쓰기: ['복호화됨: '] + 암호문, 줄바꿈.
				프로그램 종료.
			}.
		} 예외시: { :에러
			(s = [''] 또는: p = ['']) 참이면: {
				ok 더하기: 1.
			}, 아니면: {
				출력 쓰기: 에러, 줄바꿈.
				프로그램 종료.
			}.
		}, 시작.
	}.
}.

출력 쓰기: ( ok + [' 건의 금고 암호화를 테스트함.'] ), 줄바꿈.