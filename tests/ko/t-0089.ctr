>> 무작위기 := { :a :b
	>> 최솟값 := ( a < b ) 둘중하나: a 또는: b.
	>> 최댓값 := ( a > b ) 둘중하나: a 또는: b.
	>> x := 없음.
	{
		x := 숫자 사이: a 와: b.
		((x < 최솟값) 또는: (x > 최댓값)) 참이면: { 
			출력 쓰기: (['잘못된 값!']).
			프로그램 종료.
		}.
	} 
	× 100. <- x.
}.
