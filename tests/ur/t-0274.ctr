

لسٹ جب: ⌝'column:'⌜ کرو: ⎬ :column
	>> result := لسٹ نیا.
	خود ہر-ایک: ⎬ :index :row
		row ہر-ایک: ⎬ :index :cell
			﴿index = column﴾ اگر-سچ: ⎬ result آخر-میں-جوڑو: cell. ⎨.
		⎨.
	⎨. <- result.
⎨.


>> a := لسٹ ←
	﴿لسٹ ← 1 ; 2 ; 3﴾ ;
	﴿لسٹ ← 4 ; 5 ; 6﴾ ;
	﴿لسٹ ← 7 ; 8 ; 9﴾.

>> b := a column: 1.
آؤٹ-پٹ لکھو: b, نئی-سطر.

b := a column: 20.
آؤٹ-پٹ لکھو: b, نئی-سطر.

b := a column: -100.
آؤٹ-پٹ لکھو: b, نئی-سطر.
