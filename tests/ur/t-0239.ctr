لسٹ جب: ⌝'sum'⌜ کرو: ⎬
	>> total := 0.
	خود ہر-ایک: ⎬ :index :element
		total جمع: element.
	⎨. <- total.
⎨.

>> a := سچ.



a جب: ⌝'بطور-متن'⌜ کرو: ⎬
	>> answer := خالی.
	﴿ خود = سچ ﴾ اگر-سچ: ⎬
		answer := ⌝'Yep'⌜.
	⎨, ورنہ: ⎬
		answer := ⌝'Nope'⌜.
	⎨. <- answer.
⎨.

a جب: ⌝'بطور-عدد'⌜ کرو: ⎬
	>> answer := خالی.
	﴿ خود = سچ ﴾ اگر-سچ: ⎬
		answer := 10.
	⎨, ورنہ: ⎬
		answer := 20.
	⎨. <- answer.
⎨.

>> b := 666.

b جب: ⌝'بطور-متن'⌜ کرو: ⎬ <- ⌝'Devil'⌜.
⎨.

b جب: ⌝'بطور-بولین'⌜ کرو: ⎬ <- جھوٹ.
⎨.


آؤٹ-پٹ لکھو: a, نئی-سطر.  
آؤٹ-پٹ لکھو: ﴿90 + a﴾, نئی-سطر. 
آؤٹ-پٹ لکھو: b, نئی-سطر. 
آؤٹ-پٹ لکھو: ﴿سچ اور: b﴾, نئی-سطر.

a := لسٹ ← ⌝'hello'⌜ ; ⌝'world'⌜ ; سچ ; خالی ; 666. 
a := a + ﴿ لسٹ ← 1 ﴾.
آؤٹ-پٹ لکھو: a, نئی-سطر.
آؤٹ-پٹ لکھو: ﴿﴿لغت نیا﴾ رکھو: خالی کلید: خالی﴾, نئی-سطر.
آؤٹ-پٹ لکھو: a sum, نئی-سطر. 


⎬
	a جب: ⌝'بطور-متن'⌜ کرو: ⎬ <- خالی. ⎨.
	a := ⌝''⌜ + a.
⎨ پکڑو: ⎬ :error
	آؤٹ-پٹ لکھو: ⌝'Error noted: '⌜ + error, نئی-سطر.
⎨, چلاؤ.



⎬
	a جب: ⌝'بطور-عدد'⌜ کرو: ⎬ <- خالی. ⎨.
	a := 3 × a.
⎨ پکڑو: ⎬ :error
	آؤٹ-پٹ لکھو: ⌝'Error noted: '⌜ + error, نئی-سطر.
⎨, چلاؤ.


⎬
	a جب: ⌝'بطور-بولین'⌜ کرو: ⎬ <- خالی. ⎨.
	a := سچ اور: a. 
⎨ پکڑو: ⎬ :error
	آؤٹ-پٹ لکھو: ⌝'Error noted: '⌜ + error, نئی-سطر.
⎨, چلاؤ.





