#Linux

 >> t := لمحہ نیا.
 
t ٹائم-زون: ⌝'Europe/Amsterdam'⌜.
t سال: 2020, مہینہ: 8, دن: 2, گھنٹہ: 21, منٹ: 2, سیکنڈ: 1.

>> a := t گھنٹہ.
>> ams := t ٹائم-زون.

t ٹائم-زون: ⌝'US/Hawaii'⌜.
>> b := t گھنٹہ.
>> hw := t ٹائم-زون.

آؤٹ-پٹ
لکھو: ﴿
	⌝'It's diff in zone2 than in zone1'⌜
	zone1: ams,
	zone2: hw,
	diff: ﴿
		﴿b > a﴾
		یہ: ⌝'later'⌜ ورنہ-وہ: ⌝'earlier'⌜
	﴾
﴾,
نئی-سطر.
 