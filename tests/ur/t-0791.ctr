Server init.

>> DB := Maria-DB نیا میزبان: ⌝'localhost'⌜,
	صارف-نام: ⌝'xo'⌜,
	پاسورڈ: ⌝'pass123'⌜,
	ڈیٹابیس-نام: ⌝'xobase'⌜,
	جڑو.
	
>> SQL := ⌝'SELECT "hello" AS "world" '⌜.

# manually create query
>> تلاش-پیرامیٹر := استفسار-Maria نیا: SQL.

# set database
تلاش-پیرامیٹر ڈیٹابیس: DB.

تلاش-پیرامیٹر حاصل: ⎬ :row
	آؤٹ-پٹ لکھو: row world, نئی-سطر.
⎨.
