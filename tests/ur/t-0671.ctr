# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := تجوری کلیدیں-بناؤ.

# private (secret) key
>> sk := keys پہلا.

# public key
>> pk := keys آخری.

# sign a message
>> sig := تجوری دستخط: ⌝'abc'⌜ کلید-سے: sk.

# check message (ok)
آؤٹ-پٹ لکھو: ﴿ 
	تجوری
		جانچو: ⌝'abc'⌜ 
		دستخط: sig 
		کلید-سے: pk 
﴾, نئی-سطر.

# check message (fail)
آؤٹ-پٹ لکھو: ﴿ 
	تجوری 
		جانچو: ⌝'abd'⌜ 
		دستخط: sig 
		کلید-سے: pk 
﴾, نئی-سطر.