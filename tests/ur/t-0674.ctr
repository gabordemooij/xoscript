# happy flow
>> s := ⌝'hello;"""world"""\n"of";"c\ns\nv"'⌜.
>> فائل-راستہ := ⌝'/tmp/dat.csv'⌜.
>> csv := فائل نیا: فائل-راستہ.
csv لکھو: s.

# accepts CRLF LF CR, varying row length
csv حد-بندی: ⌝';'⌜ واوین: ⌝'"'⌜ سطریں: ⎬ :line
	پروگرام صفائی.
	آؤٹ-پٹ لکھو: line, نئی-سطر.
	پروگرام صفائی.
⎨.

# unequal lines
s آخر-میں-جوڑو: ⌝'\njustone'⌜.
csv لکھو: s.
⎬
	csv حد-بندی: ⌝';'⌜ واوین: ⌝'"'⌜ سطریں: ⎬ :line
		آؤٹ-پٹ لکھو: line, نئی-سطر.
	⎨.
⎨ پکڑو: ⎬ :e 
	آؤٹ-پٹ لکھو: e, نئی-سطر.
⎨, چلاؤ.

# invalid format
s := ⌝'"he"llo";world'⌜.
csv لکھو: s.
⎬
	csv حد-بندی: ⌝';'⌜ واوین: ⌝'"'⌜ سطریں: ⎬ :line
		آؤٹ-پٹ لکھو: line, نئی-سطر.
	⎨.
⎨ پکڑو: ⎬ :e 
	آؤٹ-پٹ لکھو: e, نئی-سطر.
⎨, چلاؤ.
