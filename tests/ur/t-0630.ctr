#regex test
Server init.
>> subject := ⌝'<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'⌜.
>> pattern := نمونہ نیا: ⌝'href="([^"]+)" target="([^"]+)"'⌜.
>> result := pattern مطابقت: subject کرو: ⎬ :m :x
	آؤٹ-پٹ لکھو: m, نئی-سطر.
	آؤٹ-پٹ لکھو: x, نئی-سطر. <- ⌝'XXX'⌜.
⎨.
آؤٹ-پٹ لکھو: result, نئی-سطر.