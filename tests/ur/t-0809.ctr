# backslashes must survive code serialization, strings must not end early
>> قدریں := لسٹ نیا
	; ⌝'C:\\new'⌜
	; ⌝'ends with backslash \\'⌜
	; ⌝'\\\\'⌜
	; ⌝'x\\\'] at: 9, put: 1 at: 2).'⌜.

قدریں ہر-ایک: ⎬ :i :value
	>> d := لغت نیا.
	d رکھو: value کلید: ⌝'k'⌜.
	>> r := d کوڈ بطور-آبجیکٹ.
	آؤٹ-پٹ لکھو: r تعداد, نئی-سطر.
	آؤٹ-پٹ لکھو: ﴿ ﴿r پر: ⌝'k'⌜﴾ = value ﴾, نئی-سطر.
⎨.
