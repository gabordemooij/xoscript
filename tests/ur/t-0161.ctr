پروگرام میموری-انتظام: 0.
لسٹ جب: ⌝'sum'⌜ کرو: ⎬
	>> total := 0.
	خود ہر-ایک: ⎬ :index :element
		total جمع: element.
	⎨. <- total.
⎨.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := فائل نیا: ⌝'/tmp/test.txt'⌜.
f لکھو: ⌝'Lorem Ipsum'⌜.
f بند-کرو.
  

f := فائل نیا: ⌝'/tmp/test.txt'⌜.
>> text := f پڑھو.
f بند-کرو.



پروگرام صفائی.
usedMemory1 := ﴿پروگرام میموری ? 1﴾.



f := فائل نیا: ⌝'/tmp/test.txt'⌜.
text := f پڑھو.
f بند-کرو.

پروگرام صفائی.
usedMemory2 := ﴿پروگرام میموری ? 1﴾.


