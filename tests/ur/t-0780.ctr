Server init.

# JSON encoder only supports UTF-8, no surrogate pairs

>> dicts := لسٹ نیا ;
	# {"key":"normal"} normal ASCII
	﴿ لغت نیا رکھو: ⌝'normal'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"hello world"} space character
	﴿ لغت نیا رکھو: ⌝'hello world'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"quote: \""} double quote
	﴿ لغت نیا رکھو: ⌝'"'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"backslash: \\"} backslash
	﴿ لغت نیا رکھو: ⌝'backslash: \\'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"slash: /"} slash
	﴿ لغت نیا رکھو: ⌝'slash: /'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"backspace: \b"} backspace
	﴿ لغت نیا رکھو: ⌝'backspace: \b'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"formfeed: \f"} form-feed escape
	﴿ لغت نیا رکھو: ⌝'formfeed: \f'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"newline: \n"} newline
	﴿ لغت نیا رکھو: ⌝'newline: \n'⌜ کلید: ⌝'key'⌜ ﴾ ;
	﴿ لغت نیا رکھو: ⌝'newline: ↵'⌜ کلید: ⌝'key'⌜ ﴾ ;
	﴿ لغت نیا رکھو: ⌝'newline: 
	'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"carriage return: \r"} carriage-return
	﴿ لغت نیا رکھو: ⌝'carriage return: \r'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"tab: \t"} tab
	﴿ لغت نیا رکھو: ⌝'tab \t'⌜ کلید: ⌝'key'⌜ ﴾ ;
	﴿ لغت نیا رکھو: ⌝'tab ⇿'⌜ کلید: ⌝'key'⌜ ﴾ ;
	﴿ لغت نیا رکھو: ⌝'tab  '⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u0000"} NUL
	﴿ لغت نیا رکھو: ⌝'NUL \u0000'⌜ کلید: ⌝'key'⌜ ﴾ ;
	﴿ لغت نیا رکھو: ⌝'NUL \0'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u0001"} control character 0x01
	﴿ لغت نیا رکھو: ⌝'control: \u0001'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u001F"} control character 0x1F
	﴿ لغت نیا رکھو: ⌝'control: \u001F'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: é"} UTF-8, 2-byte char
	﴿ لغت نیا رکھو: ⌝'unicode: é'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: €"} UTF-8, 3-byte char
	﴿ لغت نیا رکھو: ⌝'unicode: €'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 日本語"} multiple 3-byte UTF-8 chars
	﴿ لغت نیا رکھو: ⌝'unicode: 日本語'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 😀"} UTF-8, 4-byte char
	﴿ لغت نیا رکھو: ⌝'unicode: 😀'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	﴿ لغت نیا رکھو: ⌝'unicode: 🧑‍💻'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"combining: e\u0301"} combining accent
	﴿ لغت نیا رکھو: ⌝'combining: e\u0301'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: \u00e9"} Unicode escape BMP
	﴿ لغت نیا رکھو: ⌝'escaped unicode: \u00e9'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: \u20ac"} Unicode escape BMP
	﴿ لغت نیا رکھو: ⌝'escaped unicode: \u20ac'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: \ud83d\ude00"} UTF-16 surrogate pair
	﴿ لغت نیا رکھو: ⌝'escaped unicode: \ud83d\ude00'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":""} empty value
	﴿ لغت نیا رکھو: ⌝''⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"@ < > & = % + ? #"} special ASCII chars
	﴿ لغت نیا رکھو: ⌝'@ < > & = % + ? #'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"single quote: '"} single quote
	﴿ لغت نیا رکھو: ⌝'''⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"multiple: \" \\ \n \r \t"} multiple JSON escapes
	﴿ لغت نیا رکھو: ⌝'multiple: \" \\ \n \r \t'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} longer ASCII-string
	﴿ لغت نیا رکھو: ⌝'aaaaaaaaaaaaaaaaaaaaaaaaaa'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":" value"} leading space
	﴿ لغت نیا رکھو: ⌝' value'⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":"value "} trailing space
	﴿ لغت نیا رکھو: ⌝'value '⌜ کلید: ⌝'key'⌜ ﴾ ;
	# {"key":" \t\n\r "} whitespace
	﴿ لغت نیا رکھو: ⌝' \t\n\r '⌜ کلید: ⌝'key'⌜ ﴾.

dicts ہر-ایک: ⎬ :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: ﴿لغت نیا رکھو: d key کلید: ⌝'key'⌜﴾.
	>> b := JSON jsonify: ﴿لغت نیا رکھو: ⌝'value'⌜ کلید: d key﴾.
	>> e := JSON آبجیکٹ: a.
	>> f := JSON آبجیکٹ: b.
	﴿﴿e key = d key اور: ﴿f ? d key = ⌝'value'⌜﴾﴾ یا: ﴿e key = ⌝'NUL ?'⌜﴾﴾ اگر-سچ: ⎬
		آؤٹ-پٹ لکھو: ⌝'OK'⌜, نئی-سطر.
	⎨, ورنہ: ⎬
		آؤٹ-پٹ لکھو: ⌝'Unable to properly encode/decode: '⌜ + d + j, نئی-سطر.
		پروگرام ختم.
	⎨.
⎨.
