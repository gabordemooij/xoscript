# Password hashing
Server init.

# User sets a password
>> passw := ⌝'pass123'⌜.

# You store it like this
>> hash := تجوری 
	پاسورڈ-ہیش: passw.

# Then, user logs in
# Attempt 1
>> a1 := ⌝'abcd123'⌜.
# Attempt 2
>> a2 := ⌝'pass123'⌜.

# Verify
>> a := تجوری 
	پاسورڈ-ہیش: hash تصدیق: a1.
	# fail 
>> b := تجوری
	پاسورڈ-ہیش: hash تصدیق: a2.
	# ok!

آؤٹ-پٹ لکھو: a, نئی-سطر.
آؤٹ-پٹ لکھو: b, نئی-سطر.

