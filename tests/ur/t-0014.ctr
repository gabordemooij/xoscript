>> Greeter := آبجیکٹ نیا.
Greeter جب: ⌝'make'⌜ کرو: ⎬
	>> gr := آبجیکٹ نیا.
	gr جب: ⌝'setName:'⌜ کرو: ⎬ :aname
		اپنا نام := aname.
	⎨.
	gr جب: ⌝'greet'⌜ کرو: ⎬
		آؤٹ-پٹ لکھو: اپنا نام.
	⎨. <- gr.
⎨.
>> a := Greeter make.
>> b := Greeter make.
a setName: ⌝'ONE'⌜.
b setName: ⌝'TWO'⌜.
a greet.
b greet.
>> c := a نیا.
c setName: ⌝'THREE'⌜.
c greet.
>> d := a نیا.
d setName: ⌝'FOUR'⌜.
d greet.
c greet.
