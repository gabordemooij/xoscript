>> echo := آبجیکٹ نیا.
echo جب: ⌝'جواب:'⌜ کرو: ⎬ :sound
	⎬ آؤٹ-پٹ لکھو: sound. ⎨ × 2.
⎨.
echo ho!. 


echo := آبجیکٹ نیا.
echo جب: ⌝'جواب:اور:'⌜ کرو: ⎬ :sound :x
	⎬ آؤٹ-پٹ لکھو: sound. ⎨ × x.
⎨.
echo o 5. 
echo wooo: 3. 


echo := آبجیکٹ نیا.
echo جب: ⌝'جواب:اور:اور:'⌜ کرو: ⎬ :operation :sound :x
	⎬ آؤٹ-پٹ لکھو: sound. ⎨ × x.
⎨.
echo shout: ⌝'la'⌜ times: 4. 


