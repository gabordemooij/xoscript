>> randomizer := ⎬ :a :b
	>> کم-از-کم := ﴿ a < b ﴾ یہ: a ورنہ-وہ: b.
	>> زیادہ-سے-زیادہ := ﴿ a > b ﴾ یہ: a ورنہ-وہ: b.
	>> x := خالی.
	⎬
		x := عدد درمیان: a اور: b.
		﴿﴿x < کم-از-کم﴾ یا: ﴿x > زیادہ-سے-زیادہ﴾﴾ اگر-سچ: ⎬ 
			آؤٹ-پٹ لکھو: ﴿⌝'Invalid value!'⌜﴾.
			پروگرام ختم.
		⎨.
	⎨ 
	× 100. <- x.
⎨.
randomizer لاگو: 0 اور: 0.
