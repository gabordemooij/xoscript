>> phrases := لسٹ نیا
	~ ⌝'abcd'⌜
	~ ⌝'hello world'⌜
	~ ⌝''⌜
	~ ⌝'@.,;"'⌜
	~ ⌝'this is a much much longer string to be encoded!'⌜.

>> message := ⌝'Phrase: ~decoded base64: ~encoded'⌜.
	
phrases ہر-ایک: ⎬ :_ :phrase 
	>> e := Server base64-انکوڈ: phrase.
	>> d := Server base64-ڈیکوڈ: e.
	آؤٹ-پٹ لکھو: ﴿
		message نقل ~encoded: e, ~decoded: d
	﴾, نئی-سطر.
⎨.
