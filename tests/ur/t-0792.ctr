Server init.

>> DB := Maria-DB نیا میزبان: ⌝'localhost'⌜,
	صارف-نام: ⌝'xo'⌜,
	پاسورڈ: ⌝'pass123'⌜,
	ڈیٹابیس-نام: ⌝'xobase'⌜,
	جڑو.
	
>> SQL := ⌝'SELECT "hello" AS "world" '⌜.

# a quicker way, get query from DB:
>> query2 := DB استفسار: SQL.

# now you don't have to set DB
query2 حاصل: ⎬ :row
	آؤٹ-پٹ لکھو: row world, نئی-سطر.
⎨.
