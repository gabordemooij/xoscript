

>> g := Server نیا.
>> v := تجوری نیا.
>> ok := 0.

>> secrets := لسٹ نیا ; 
	 ⌝'aaa'⌜ ;
	 ⌝''⌜ ; 
	 ⌝'AB'⌜ ;
	 ⌝'abcdefghijklmnopqrstuvwxyz0123456789'⌜ ; 
	 ⌝'!@--+467hdHJKJs__=3hjsakd'⌜ ;
	 ⌝'spaces and	tabs'⌜ ;
	 ⌝'漢字'⌜ ;
	 ⌝'==[abc]=='⌜.
	
>> passwords := secrets نقل.
passwords ہر-ایک: ⎬ :i :p
	secrets ہر-ایک: ⎬ :n :s
		⎬
			>> encrypted := v خفیہ-کرو: s کلید: p.
			>> decrypted := v خفیہ-کھولو: encrypted کلید: p.
			﴿decrypted = s﴾ اگر-سچ: ⎬
				ok جمع: 1.
			⎨, ورنہ: ⎬
				آؤٹ-پٹ لکھو: ⌝'failed encrypting/decrypting: '⌜, نئی-سطر.
				آؤٹ-پٹ لکھو: s, نئی-سطر.
				آؤٹ-پٹ لکھو: ⌝'encrypted: '⌜ + encrypted, نئی-سطر.
				آؤٹ-پٹ لکھو: ⌝'decrypted: '⌜ + encrypted, نئی-سطر.
				پروگرام ختم.
			⎨.
		⎨ پکڑو: ⎬ :err
			﴿s = ⌝''⌜ یا: p = ⌝''⌜﴾ اگر-سچ: ⎬
				ok جمع: 1.
			⎨, ورنہ: ⎬
				آؤٹ-پٹ لکھو: err, نئی-سطر.
				پروگرام ختم.
			⎨.
		⎨, چلاؤ.
	⎨.
⎨.

آؤٹ-پٹ لکھو: ﴿ ok + ⌝' vault encryptions tested.'⌜ ﴾, نئی-سطر.