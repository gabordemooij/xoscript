#Linux
>> clock := لمحہ نیا.
clock ٹائم-زون: ⌝'UTC-1'⌜.
clock سال: 1981, مہینہ: 1, دن: 5,
      گھنٹہ: 13, منٹ: 15, سیکنڈ: 13.

آؤٹ-پٹ لکھو: clock, نئی-سطر.
clock ٹائم-زون: ⌝'UTC+0'⌜.

آؤٹ-پٹ لکھو: ﴿
	﴿clock سال سادہ﴾ + ⌝'-'⌜ + ﴿clock مہینہ﴾ + ⌝'-'⌜ + ﴿clock دن﴾ + ⌝' '⌜ +
	﴿clock گھنٹہ﴾ + ⌝':'⌜ + ﴿clock منٹ﴾ + ⌝':'⌜ + ﴿clock سیکنڈ﴾ + ⌝' '⌜ +
	⌝'W'⌜ + ﴿clock ہفتہ﴾ + ﴿clock ٹائم-زون﴾
﴾, نئی-سطر.


clock ٹائم-زون: ⌝'UTC-1'⌜.
آؤٹ-پٹ لکھو: ﴿
	﴿clock سال سادہ﴾ + ⌝'-'⌜ + ﴿clock مہینہ﴾ + ⌝'-'⌜ + ﴿clock دن﴾ + ⌝' '⌜ +
	﴿clock گھنٹہ﴾ + ⌝':'⌜ + ﴿clock منٹ﴾ + ⌝':'⌜ + ﴿clock سیکنڈ﴾ + ⌝' '⌜ +
	⌝'W'⌜ + ﴿clock ہفتہ﴾ + ﴿clock ٹائم-زون﴾
﴾, نئی-سطر.
