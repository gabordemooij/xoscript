Çıktı yaz: ['Test object'], yeni-satır.
>> p := Yol /tmp.
Çıktı yaz: p, yeni-satır.
>> old-p-address := p prototip bellek-adresi.
p save-as: ['/tmp/a.bin'].
Çıktı yaz: ['========== RELOADING SNAP:'], yeni-satır.
>> b := Nesne load-from: ['/tmp/a.bin'].
(b prototip bellek-adresi = old-p-address) doğru: {
	Çıktı yaz: ['Object link re-attached.'], yeni-satır.
}.
Çıktı yaz: b, yeni-satır.
