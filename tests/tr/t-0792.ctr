Server init.

>> DB := Maria-DB yeni sunucu-adı: ['localhost'],
	kullanıcı: ['xo'],
	parola: ['pass123'],
	veritabanı-adı: ['xobase'],
	bağlan.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB sorgu: SQL.

# now you don't have to set DB
query2 getir: { :row
	Çıktı yaz: row world, yeni-satır.
}.
