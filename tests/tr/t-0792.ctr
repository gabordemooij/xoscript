Server init.

>> DB := Maria-DB yeni sunucu-adı: ['localhost'],
	kullanıcı: ['xo'],
	parola: ['pass123'],
	veritabanı-adı: ['xobase'],
	bağlan.
	
>> SQL := ['SELECT "hello" AS "world" '].

# daha hızlı bir yol, sorguyu DB'den al:
>> sorgu2 := DB sorgu: SQL.

# artık DB ayarlamanız gerekmez
sorgu2 getir: { :kayıt
	Çıktı yaz: kayıt world, yeni-satır.
}.
