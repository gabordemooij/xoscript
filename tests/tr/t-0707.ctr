# tür dönüşümlerini / çevirmeleri / bağlamaları sına
Program bellek-yönetimi: 4.
Server init.

>> sayaç := 0.
>> vt := Maria-DB yeni sunucu-adı: ['localhost'],
	kullanıcı: ['xo'], parola: ['pass123'], veritabanı-adı: ['xobase'], bağlan.

>> İkiHaneliBiçim := Biçim yeni: ['%02d'].

# Tarih-saat
{
	>> yıl     := Sayı arasında: 1995 ve: 2050, metin.
	>> ay    := İkiHaneliBiçim uygula-tamsayı: (Sayı arasında: 1 ve: 12), metin.
	>> gün      := İkiHaneliBiçim uygula-tamsayı: (Sayı arasında: 1 ve: 28), metin.
	>> saat     := İkiHaneliBiçim uygula-tamsayı: (Sayı arasında: 1 ve: 23), metin.
	>> dakika   := İkiHaneliBiçim uygula-tamsayı: (Sayı arasında: 1 ve: 59), metin.
	>> saniye   := İkiHaneliBiçim uygula-tamsayı: (Sayı arasında: 1 ve: 59), metin.
	>> tarihSaat := ['YYYY-MM-DD HH:II:SS'].	
	tarihSaat
		YYYY: yıl,
		MM: ay,
		DD: gün,
		HH: saat,
		II: dakika,
		SS: saniye.
	>> arama-parametreleri :=
	vt sorgu: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: tarihSaat),
	getir: { :kayıt
		(kayıt mydatetime = tarihSaat) yanlış: {
			bu-görev hata: (
				['Beklenen: <expected> ama alınan: <observation>']
				<expected>: tarihSaat,
				<observation>: kayıt mydatetime
			).
		}.
	
	}.
	sayaç ekle: 1.
} * 100.

# Tarih
{
	>> yıl     := Sayı arasında: 1995 ve: 2050, metin.
	>> ay    := İkiHaneliBiçim uygula-tamsayı: (Sayı arasında: 1 ve: 12), metin.
	>> gün      := İkiHaneliBiçim uygula-tamsayı: (Sayı arasında: 1 ve: 28), metin.
	>> tarih     := ['YYYY-MM-DD'].
	tarih
		YYYY: yıl,
		MM: ay,
		DD: gün.
	>> arama-parametreleri :=
	vt sorgu: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: tarih),
	getir: { :kayıt
		(kayıt mydate = tarih) yanlış: {
			bu-görev hata: (
				['Beklenen: <expected> ama alınan: <observation>']
				<expected>: tarih,
				<observation>: kayıt mydate
			).
		}.
	}.
	sayaç ekle: 1.
} * 100.


# Saat
{
	>> saat     := İkiHaneliBiçim uygula-tamsayı: (Sayı arasında: 1 ve: 23), metin.
	>> dakika   := İkiHaneliBiçim uygula-tamsayı: (Sayı arasında: 1 ve: 59), metin.
	>> saniye   := İkiHaneliBiçim uygula-tamsayı: (Sayı arasında: 1 ve: 59), metin.
	>> zaman := ['HH:II:SS'].
	zaman
		HH: saat,
		II: dakika,
		SS: saniye.
	>> arama-parametreleri :=
	vt sorgu: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: zaman),
	getir: { :kayıt
		(kayıt mytime = zaman) yanlış: {
			bu-görev hata: (
				['Beklenen: <expected> ama alınan: <observation>']
				<expected>: tarihSaat,
				<observation>: kayıt mytime
			).
		}.
	}.
	sayaç ekle: 1.
} * 100.


# Metinler (varchar/text)
>> str1 := Liste yeni doldur: 100000 değer: ['x'], birleştir: [''].
{
	>> str2 := Kasa jeton: 40.
	>> arama-parametreleri :=
	vt sorgu: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	getir: { :kayıt
		(kayıt str1 = str1 ve: kayıt str2 = str2) yanlış: {
			bu-görev hata: (
				['Beklenen: <expected> ama alınan: <observation>']
				<expected>: tarihSaat,
				<observation>: kayıt mytime
			).
		}.
	}.
	sayaç ekle: 1.
} * 100.


# Sayılar
{
	>> n1  := Sayı arasında: 1 ve: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 metinden: ['9223372036854775807'] ) -
		( Int64 metinden: ['99999'] ) +
		( Int64 metinden: n1 metin )
	).
	>> arama-parametreleri :=
	vt sorgu: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	getir: { :kayıt
		(kayıt n1 = n1) yanlış: {
			bu-görev hata: (
				['Beklenen: <expected> ama alınan: <observation>']
				<expected>: n1,
				<observation>: kayıt n1
			).
		}.
		(kayıt n2 = n2) yanlış: {
			bu-görev hata: (
				['Beklenen: <expected> ama alınan: <observation>']
				<expected>: n1,
				<observation>: kayıt n2
			).
		}.
		(kayıt n3 = n2 yuvarla) yanlış: {
			bu-görev hata: (
				['Beklenen: <expected> ama alınan: <observation>']
				<expected>: n1,
				<observation>: kayıt n3
			).
		}.
		(kayıt big = big) yanlış: {
			bu-görev hata: (
				['Beklenen: <expected> ama alınan: <observation>']
				<expected>: big,
				<observation>: kayıt big
			).
		}.
		
	}.
	sayaç ekle: 1.
} * 100.


Çıktı yaz: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: sayaç
), yeni-satır.