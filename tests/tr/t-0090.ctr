Çıktı yaz: ['1,2,3,4,5,6,7,8,9,A,'], yeni-satır.
>> Kapsam := Nesne yeni.
Kapsam olunca: ['initialize:'] yap: { :x öz özellik := x. }.
Kapsam olunca: ['teyitEt'] yap: { Çıktı yaz: [',']. }.
Kapsam olunca: ['sınama'] yap: {
	Çıktı yaz: öz özellik.
	kendi teyitEt.
	( 1 = 1 ) doğru: { Çıktı yaz: öz özellik. kendi teyitEt. }.
	( 1 = 0 ) yanlış: { Çıktı yaz: öz özellik. kendi teyitEt. }.
	>> y := 2. { Çıktı yaz: öz özellik. kendi teyitEt. } sürece: { y çıkar: 1. <- (y > 0). }.
	{ Çıktı yaz: öz özellik. kendi teyitEt. } × 1.
	(Liste ← 1) her: {  Çıktı yaz: öz özellik. kendi teyitEt. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo kendi sıralamasını gerçekleştir, platforma göre yineleme sayısı farklı olduğu için bu test başarısız oluyor
	(Sözlük yeni one: ['item']) her: { Çıktı yaz: öz özellik. kendi teyitEt. }.
	{ 1 ÷ 0. } yakala: { Çıktı yaz: öz özellik. kendi teyitEt. }, başlat.
	Çıktı yeni-satır.
}.
>> kapsam1 := Kapsam yeni.
kapsam1 initialize: ['X'].
kapsam1 sınama.
>> işlev := { 
	öz özellik := ['Y'].
	Çıktı yaz: öz özellik.
	kendi teyitEt.
	( 1 = 1 ) doğru: { Çıktı yaz: öz özellik. kendi teyitEt. }.
	( 1 = 0 ) yanlış: { Çıktı yaz: öz özellik. kendi teyitEt. }.
	>> y := 2. { Çıktı yaz: öz özellik. kendi teyitEt. } sürece: { y çıkar: 1. <- (y > 0). }.
	{ Çıktı yaz: öz özellik. kendi teyitEt. } × 1.
	(Liste ← 1) her: {  Çıktı yaz: öz özellik. kendi teyitEt. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Sözlük yeni one: ['item']) her: { Çıktı yaz: öz özellik. kendi teyitEt. }.
	{ 1 ÷ 0. } yakala: { Çıktı yaz: öz özellik. kendi teyitEt. }, başlat.
	Çıktı yeni-satır.
}.
işlev olunca: ['teyitEt'] yap: { Çıktı yaz: [',']. }.
işlev uygula: 1 ve: 2.
