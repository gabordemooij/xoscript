Çıktı yaz: ['Test nesnesi'], yeni-satır.
>> a := Nesne yeni. 

a olunca: ['item:'] yap: { :hexhelper
	öz hexhelper := hexhelper. 
}.

a olunca: ['öğe'] yap: {
	<- öz hexhelper.
}.

a item: Hx yeni.

>> eski-hexhelper-adresi := a öğe prototip bellek-adresi.
a save-as: ['/tmp/a.bin'].
Çıktı yaz: ['========== SNAP YENİDEN YÜKLENİYOR:'], yeni-satır.

>> b := Nesne load-from: ['/tmp/a.bin'].

(b öğe prototip bellek-adresi = eski-hexhelper-adresi) doğru: {
	Çıktı yaz: ['Nesne bağlantısı yeniden bağlandı.'], yeni-satır.
}.
