Çıktı yaz: ['Test object'], yeni-satır.
>> a := Nesne yeni. 

a olunca: ['item:'] yap: { :hexhelper
	öz hexhelper := hexhelper. 
}.

a olunca: ['item'] yap: { <- öz hexhelper.
}.

a item: Hx yeni.

>> old-hexhelper-address := a item prototip bellek-adresi.
a save-as: ['/tmp/a.bin'].
Çıktı yaz: ['========== RELOADING SNAP:'], yeni-satır.

>> b := Nesne load-from: ['/tmp/a.bin'].

(b item prototip bellek-adresi = old-hexhelper-address) doğru: {
	Çıktı yaz: ['Object link re-attached.'], yeni-satır.
}.
