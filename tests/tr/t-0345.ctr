# yakala-hepsi yöntemlerini sına
>> x13 := Nesne yeni.
x13 olunca: ['a'] yap: { :a Çıktı yaz: 0, yeni-satır. }.
x13 olunca: ['a:'] yap: { :a Çıktı yaz: a, yeni-satır. <- 5. }.
x13 olunca: ['a:b:'] yap: { :a :b Çıktı yaz: (a + b), yeni-satır. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
