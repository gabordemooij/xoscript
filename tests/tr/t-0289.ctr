#Linux
>> OS := Program sistem: (Komut uname -s), kırp.

>> Slurp := Nesne yeni.
Slurp olunca: ['yeni'] yap: {
	öz str := [''].
}.
Slurp olunca: ['yanıtla:'] yap: { :blah
		(öz str ≠ ['']) doğru: {
			öz str sona-ekle: [' '].
		}.
		öz str sona-ekle: blah.
}.
Slurp olunca: ['yanıtla:ve:'] yap: { :blah :blahah
		(öz str ≠ ['']) doğru: {
			öz str sona-ekle: [' '].
		}.
		(blah uzunluk > 1) doğru: {
			öz str sona-ekle: (blah başlangıç: 0 uzunluk: (blah uzunluk - 1)).
		}, yoksa: {
			öz str sona-ekle: blah.
		}.
		öz str sona-ekle: [' '].
		öz str sona-ekle: blahah.
}.
Slurp olunca: ['obtain'] yap: {
	>> buffer := öz str.
	öz str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text sona-ekle: ['hello'].
} × 1000.


Çıktı yaz: (
	Program sistem: (
		Slurp yeni
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

