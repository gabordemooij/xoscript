#Linux

(Dosya yeni: ['/tmp/testje']) var yanlış: {
	Program sistem: ['mkdir /tmp/testje'].	
}.

(Dosya yeni: ['/tmp/testje/file1']) var yanlış: {
	Program sistem: ['touch /tmp/testje/file1'].	
}.

(Dosya yeni: ['/tmp/testje/folder1']) var yanlış: {
	Program sistem: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Dosya liste: ['/tmp/testje'].

>> q := Liste yeni.

l her: { :k :v v her: { :x :y q sona-ekle: y. }. }.

>> s := q metin.

(s kapsar: ['file1']) doğru:   { Çıktı yaz: ['OK'], yeni-satır. }.
(s kapsar: ['file2']) doğru:   { Çıktı yaz: ['XX'], yeni-satır. }.
(s kapsar: ['folder1']) doğru: { Çıktı yaz: ['OK'], yeni-satır. }.
