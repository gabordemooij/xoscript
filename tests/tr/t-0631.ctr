#ffi sınaması


Server init.

Program bellek-yönetimi: 4.

# bu sınama için libc'ye (puts) bir yol ayarlamanız gerekir
>> kütüphaneAdı := Program ayar: ['FFITESTLIB'].



Server bağla: (
 Liste yeni ;
 kütüphaneAdı ;
 ['puts'] ;
 ( Liste yeni ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s serbest-bırak.

# struct ile sınama

>> a := Blob yeni: 8.
a bytes: (
	Liste <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Liste <<: ['int'], ; ['int']).

Server bağla: (
	Liste <<: ['@structtest'], ;
	['@structtest'] ;
	(Liste <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Çıktı yaz: ['Toplam testi:'] + (ffitest ffisum: a), yeni-satır.

struct struct-serbest-bırak.
struct serbest-bırak.
a serbest-bırak.
