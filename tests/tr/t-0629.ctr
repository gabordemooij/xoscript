# database test
# see example server.xo for required config

Server init.
Çıktı yaz: ['Database test'], yeni-satır.

>> db := Maria-DB yeni sunucu-adı: ['localhost'],
	kullanıcı: ['xo'], parola: ['pass123'], veritabanı-adı: ['xobase'], bağlan.

Çıktı yaz: ['Can we connect? '] + db bağlı?, yeni-satır.

>> arama-parametreleri := db sorgu: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parametreler: ( Liste yeni ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  arama-parametreleri yürüt. db onayla. } yakala: { :e db geri-al.  }, başlat.

Çıktı yaz: ['Can we insert? '] + ( arama-parametreleri insert-id > 0 ), yeni-satır.

>> Obj := Nesne yeni.
Obj olunca: ['retrieve-rows'] yap: {
	öz adet := 0.
	>> arama-parametreleri :=
	db sorgu: ['SELECT * FROM book order by id desc limit 2'], 
	getir: { :row 
		öz adet ekle: 1.
		Doğru kır.
	}. <- öz adet kopyala.
}.

Çıktı yaz: ['Can we query? '] + ( Obj retrieve-rows > 0 ), yeni-satır.
