>> t := Hiç.

# you can control the time zone for
# parsing like this:
An dilim: ['CET'].
t := An kaynak: ['1981-02-03 04:05:06'].
Çıktı yaz: t, yeni-satır.

# now using CEST time zone:
An dilim: ['CEST'].
t := An kaynak: ['1981-02-03 04:05:06'].
Çıktı yaz: t, yeni-satır.

# error if string cannot be parsed
{ An kaynak: ['1900']. } yakala: { Hiç. }, başlat.
