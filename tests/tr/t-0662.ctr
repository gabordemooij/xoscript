>> t := Hiç.

# ayrıştırma için saat dilimini
# şöyle denetleyebilirsiniz:
An dilim: ['CET'].
t := An kaynak: ['1981-02-03 04:05:06'].
Çıktı yaz: t, yeni-satır.

# şimdi CEST saat dilimini kullanarak:
An dilim: ['CEST'].
t := An kaynak: ['1981-02-03 04:05:06'].
Çıktı yaz: t, yeni-satır.

# metin ayrıştırılamazsa hata
{ An kaynak: ['1900']. } yakala: { Hiç. }, başlat.
