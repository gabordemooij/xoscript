
>> a := Liste ← (Liste ← 100 ; 200 ; 300) ; (Liste ← 9 ; 8 ; 7).
Çıktı yaz: ['at 0,1 :'].
Çıktı yaz: a ? 0 ? 1, yeni-satır. 
Çıktı yaz: ['at 1,2 :'].
Çıktı yaz: a ? 1 ? 2, yeni-satır. 
>> menu := Sözlük yeni.
menu koy: (Liste ← ['pizza'] ; ['spaghetti']) konum: ['Italian Cuisine'].
menu koy: (Liste ← ['bifteki'] ; ['suflaki']) konum: ['Greek Cuisine'].
Çıktı yaz: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), yeni-satır. 
Çıktı yaz: ['but not on the same plate.'], yeni-satır.
