# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Kasa anahtar-üret.

# private (secret) key
>> sk := keys ilk.

# public key
>> pk := keys sonuncu.

# sign a message
>> sig := Kasa imzala: ['abc'] anahtar: sk.

# check message (ok)
Çıktı yaz: ( 
	Kasa
		denetle: ['abc'] 
		imza: sig 
		anahtar: pk 
), yeni-satır.

# check message (fail)
Çıktı yaz: ( 
	Kasa 
		denetle: ['abd'] 
		imza: sig 
		anahtar: pk 
), yeni-satır.