# açık anahtar (API'leri vb. güvenceye almak için)
Server init.

# anahtarlar üret
>> anahtarlar := Kasa anahtar-üret.

# özel (gizli) anahtar
>> sk := anahtarlar ilk.

# açık anahtar
>> pk := anahtarlar sonuncu.

# bir iletiyi imzala
>> imza := Kasa imzala: ['abc'] anahtar: sk.

# iletiyi denetle (tamam)
Çıktı yaz: ( 
	Kasa
		denetle: ['abc'] 
		imza: imza 
		anahtar: pk 
), yeni-satır.

# iletiyi denetle (başarısız)
Çıktı yaz: ( 
	Kasa 
		denetle: ['abd'] 
		imza: imza 
		anahtar: pk 
), yeni-satır.