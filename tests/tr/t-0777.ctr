#OBSD
>> dirname := [''].
{ dirname sona-ekle: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Program sistem: command.
Program chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename sona-ekle: ['YYYYYYYY']. } * 20.
Dosya yeni: filename, yaz: ['sometext'].
{ Dosya liste: ['/tmp/'] + dirname. } * 1000.
Çıktı yaz: ['no crash'], yeni-satır.

