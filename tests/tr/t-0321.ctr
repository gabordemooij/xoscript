# test qualifiers

Program temizle.

>> Fruit := Nesne yeni.
Fruit olunca: ['yeni'] yap: {
	>> f := kendi yeni.
	f apples: 0. <- f.
}.
Fruit olunca: ['apples:'] yap: { :a öz apples := a. }.
Fruit olunca: ['apples'] yap: { <- öz apples. }.
Fruit olunca: ['+'] yap: { :f
	>> n := Fruit yeni.
	n apples: (f apples + öz apples). <- n.
}.
Sayı olunca: ['apples'] yap: { <- ((Fruit yeni) apples: kendi).
}.

Fruit olunca: ['metin'] yap: { <- öz apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Çıktı yaz: q, yeni-satır.




q := 3 apples + 4 apples.
Çıktı yaz: q, yeni-satır.



q := 3 apples + 4 apples.
Çıktı yaz: q, yeni-satır.


