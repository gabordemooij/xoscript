# niteleyicileri sına

Program temizle.

>> Meyve := Nesne yeni.
Meyve olunca: ['yeni'] yap: {
	>> f := kendi yeni.
	f apples: 0. <- f.
}.
Meyve olunca: ['apples:'] yap: { :a öz elmalar := a. }.
Meyve olunca: ['elmalar'] yap: { <- öz elmalar. }.
Meyve olunca: ['+'] yap: { :f
	>> n := Meyve yeni.
	n apples: (f elmalar + öz elmalar). <- n.
}.
Sayı olunca: ['elmalar'] yap: { <- ((Meyve yeni) apples: kendi).
}.

Meyve olunca: ['metin'] yap: { <- öz elmalar + [' elma '].
}.

>> q := 3 elmalar + 4 elmalar.
Çıktı yaz: q, yeni-satır.




q := 3 elmalar + 4 elmalar.
Çıktı yaz: q, yeni-satır.



q := 3 elmalar + 4 elmalar.
Çıktı yaz: q, yeni-satır.


