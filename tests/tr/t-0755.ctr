Çıktı yaz: ['Test nesnesi'], yeni-satır.
>> selamlayıcı := Nesne yeni.
selamlayıcı olunca: ['name:'] yap: { :ad
	öz xname := ad. 
}.
selamlayıcı olunca: ['selamla'] yap: {
	Çıktı yaz: ['Merhaba '] + öz xname, yeni-satır.
}.
selamlayıcı name: ['Sherlock'].
selamlayıcı save-as: ['/tmp/a.bin'].
Çıktı yaz: ['========== SNAP YENİDEN YÜKLENİYOR:'], yeni-satır.
>> b := Nesne load-from: ['/tmp/a.bin'].
b selamla.
b name: ['Watson'], selamla.
