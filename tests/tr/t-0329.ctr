Çıktı yaz: ((Liste yeni
	olunca: ['plaque:'] yap: { :x öz o := x. },
	olunca: ['plaque']  yap: { <- öz o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Liste ← 1)
	~ (Liste ← 1 ; 2)
	~ (Liste ← 1 ; 2 ; 3)
	~ (Liste ← 1 ; 2 ; 3 ; 4)
	~ (Liste ← 1 ; 2 ; 3 ; 4 ; 5)
) her: { :i :el
	{ Çıktı yaz: bu-görev. } × el adet.
	Çıktı yeni-satır.
}) plaque, yeni-satır.


