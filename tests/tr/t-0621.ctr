>> ifadeler := Liste yeni
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> mesaj := ['Phrase: ~decoded base64: ~encoded'].
	
ifadeler her: { :_ :ifade 
	>> e := Server base64-kodla: ifade.
	>> d := Server base64-kod-çöz: e.
	Çıktı yaz: (
		mesaj kopyala ~encoded: e, ~decoded: d
	), yeni-satır.
}.
