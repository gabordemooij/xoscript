>> phrases := Liste yeni
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases her: { :_ :phrase 
	>> e := Server base64-kodla: phrase.
	>> d := Server base64-kod-çöz: e.
	Çıktı yaz: (
		message kopyala ~encoded: e, ~decoded: d
	), yeni-satır.
}.
