>> Dede := Nesne yeni.
Dede olunca: ['selamla'] yap: {
	Çıktı yaz: ['Ave!'], yeni-satır.
}.
>> Baba := Dede yeni.
Baba olunca: ['selamla'] yap: {
	Çıktı yaz: ['Hello'], yeni-satır.
	kendi selamla.
}.
>> Oğul := Baba yeni.
Oğul olunca: ['selamla'] yap: {
	Çıktı yaz: ['Hi'], yeni-satır.
	kendi selamla.
}.

Oğul selamla.

>> Kavşak := Nesne yeni.
Kavşak olunca: ['circle:'] yap: { :x
	Çıktı yaz: x, yeni-satır.
	(x < 3) doğru: { kendi yinelemeli circle: x + 1. }.
}.

Kavşak circle: 1.

>> x := 1.
>> arttır := { (x ≤ 3) doğru: { Çıktı yaz: x, yeni-satır. x ekle: 1.  arttır başlat. }. }.
arttır başlat.