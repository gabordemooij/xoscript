>> Grandfather := Nesne yeni.
Grandfather olunca: ['greet'] yap: {
	Çıktı yaz: ['Ave!'], yeni-satır.
}.
>> Father := Grandfather yeni.
Father olunca: ['greet'] yap: {
	Çıktı yaz: ['Hello'], yeni-satır.
	kendi greet.
}.
>> Son := Father yeni.
Son olunca: ['greet'] yap: {
	Çıktı yaz: ['Hi'], yeni-satır.
	kendi greet.
}.

Son greet.

>> Roundabout := Nesne yeni.
Roundabout olunca: ['circle:'] yap: { :x
	Çıktı yaz: x, yeni-satır.
	(x < 3) doğru: { kendi yinelemeli circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) doğru: { Çıktı yaz: x, yeni-satır. x ekle: 1.  increment başlat. }. }.
increment başlat.