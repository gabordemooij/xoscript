# bir istekten gelen uç durumlar çökme değil hata ya da sonuç vermeli
Server init.

Çıktı yaz: ['<'] + (['abc'] başlangıç: 0 uzunluk: 0, büyük-harf) + ['>'], yeni-satır.
Çıktı yaz: ['<'] + (['abc'] başlangıç: 0 uzunluk: 0, küçük-harf) + ['>'], yeni-satır.
Çıktı yaz: ['<'] + (['abc'] kaydır: 3, büyük-harf) + ['>'], yeni-satır.
Çıktı yaz: [''] büyük-harf bytes, yeni-satır.
Çıktı yaz: ['aB'] büyük-harf, yeni-satır.
Çıktı yaz: ['aB'] küçük-harf, yeni-satır.

Çıktı yaz: (An yeni: 0) yıl, yeni-satır.
{ An yeni: ['9e300'] sayı. } yakala: { :e Çıktı yaz: e, yeni-satır. }, başlat.
{ An yeni: ['-9e300'] sayı. } yakala: { :e Çıktı yaz: e, yeni-satır. }, başlat.
{ An yeni: ['nan'] sayı. } yakala: { :e Çıktı yaz: e, yeni-satır. }, başlat.
{ An yeni: 9000000000000000000. } yakala: { :e Çıktı yaz: e, yeni-satır. }, başlat.
