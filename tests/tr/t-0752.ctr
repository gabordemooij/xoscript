Çıktı yaz: ['Test object'], yeni-satır.
>> a := Nesne yeni. 

a olunca: ['item:'] yap: { :mantıksal
	öz mantıksal := mantıksal. 
}.

a olunca: ['item'] yap: { <- öz mantıksal.
}.

a item: Mantıksal.

Çıktı yaz: a item, yeni-satır.

>> old-bool-address := a item prototip bellek-adresi.
a save-as: ['/tmp/a.bin'].
Çıktı yaz: ['========== RELOADING SNAP:'], yeni-satır.

>> b := Nesne load-from: ['/tmp/a.bin'].

(b item prototip bellek-adresi = old-bool-address) doğru: {
	Çıktı yaz: ['Object link re-attached.'], yeni-satır.
}.

Çıktı yaz: b item, yeni-satır.
