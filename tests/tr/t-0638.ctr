
Server init.
>> ist := HTTP-İstek yeni.
Çıktı yaz: ['HTTP-GET d[]=']  + ( ist get-liste: ['d[]'] ), yeni-satır. # GET
Çıktı yaz: ['HTTP-GET f[]=']  + ( ist get-liste: ['f[]'] ), yeni-satır. # GET
Çıktı yaz: ['HTTP-POST e[]='] + ( ist post-liste: ['e[]'] ), yeni-satır. # GET
Çıktı yaz: ['HTTP-POST c=']   + ( ist post: ['c'] ), yeni-satır. # GET
Çıktı yaz: ['HTTP-POST xx=']  + ( ist post: ['xx'] ), yeni-satır. # GET
