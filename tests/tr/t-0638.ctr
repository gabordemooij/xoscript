
Server init.
>> rq := HTTP-İstek yeni.
Çıktı yaz: ['HTTP-GET d[]=']  + ( rq get-liste: ['d[]'] ), yeni-satır. # GET
Çıktı yaz: ['HTTP-GET f[]=']  + ( rq get-liste: ['f[]'] ), yeni-satır. # GET
Çıktı yaz: ['HTTP-POST e[]='] + ( rq post-liste: ['e[]'] ), yeni-satır. # GET
Çıktı yaz: ['HTTP-POST c=']   + ( rq post: ['c'] ), yeni-satır. # GET
Çıktı yaz: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), yeni-satır. # GET
