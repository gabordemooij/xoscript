Server init.

# write a test file
>> f := Dosya yeni: ['/tmp/test.gif'].
f yaz: ['GIF87a01234567810'].

# serve the file
Server aktar: ['test.gif'] önek: ['/tmp/'].

Çıktı yeni-satır.

Çıktı yaz: ['Outside container (security):'], yeni-satır.
{ Server aktar: ['../passwd'] önek: ['/tmp/']. }
yakala: { :e Çıktı yaz: e, yeni-satır. },
başlat.

Çıktı yaz: ['Invalid prefix:'], yeni-satır.
{ Server aktar: ['test.gif'] önek: ['z:\\']. }
yakala: { :e Çıktı yaz: e, yeni-satır. },
başlat.

Çıktı yaz: ['Non-existant file:'], yeni-satır.
{ Server aktar: ['xxx.xxx'] önek: ['/tmp/']. }
yakala: { :e Çıktı yaz: e, yeni-satır. },
başlat.
