Server init.

# bir sınama dosyası yaz
>> f := Dosya yeni: ['/tmp/test.gif'].
f yaz: ['GIF87a01234567810'].

# dosyayı sun
Server aktar: ['test.gif'] önek: ['/tmp/'].

Çıktı yeni-satır.

Çıktı yaz: ['Kapsayıcı dışında (güvenlik):'], yeni-satır.
{ Server aktar: ['../passwd'] önek: ['/tmp/']. }
yakala: { :e Çıktı yaz: e, yeni-satır. },
başlat.

Çıktı yaz: ['Geçersiz önek:'], yeni-satır.
{ Server aktar: ['test.gif'] önek: ['z:\\']. }
yakala: { :e Çıktı yaz: e, yeni-satır. },
başlat.

Çıktı yaz: ['Var olmayan dosya:'], yeni-satır.
{ Server aktar: ['xxx.xxx'] önek: ['/tmp/']. }
yakala: { :e Çıktı yaz: e, yeni-satır. },
başlat.
