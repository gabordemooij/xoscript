>> z := Nesne yeni.
z olunca: ['value:'] yap: { :v
	öz value := v. <- kendi.
}.
z olunca: ['value'] yap: { <- öz value. }.
(z setValue: 1) value: 2.
Çıktı yaz: z value.
>> x := z.
Çıktı yaz: x value.
z := Hiç.
Çıktı yaz: z value.
Çıktı yaz: x value.
Çıktı yaz: ['hello'].
Çıktı yaz: 3 + 2.
Çıktı yaz: (3 > 2).
