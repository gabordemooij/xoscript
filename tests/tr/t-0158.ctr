>> x := [' hallo '].

>> y := x büyük-harf.
Çıktı yaz: x, yeni-satır.
Çıktı yaz: (x eşit: y), yeni-satır.

>> y := x küçük-harf.
Çıktı yaz: x, yeni-satır.
Çıktı yaz: (x eşit: y), yeni-satır.

>> y := x kırp.
Çıktı yaz: x, yeni-satır.
Çıktı yaz: (x eşit: y), yeni-satır.

>> y := x kaydır: 1.
Çıktı yaz: x, yeni-satır.
Çıktı yaz: (x eşit: y), yeni-satır.

>> y := x başlangıç: 1 uzunluk: 2.
Çıktı yaz: x, yeni-satır.
Çıktı yaz: (x eşit: y), yeni-satır.