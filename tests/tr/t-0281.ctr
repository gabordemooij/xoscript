>> q := Liste ← 1 ; 2 ; 3.
{ q ? ['1']. } yakala: { Çıktı yaz: ['caught!'], yeni-satır. }, başlat.
{ q ? Doğru. } yakala: { Çıktı yaz: ['caught!'], yeni-satır. }, başlat.
{ q ? Yanlış. } yakala: { Çıktı yaz: ['caught!'], yeni-satır. }, başlat.
{ q ? Hiç. } yakala: { Çıktı yaz: ['caught!'], yeni-satır. }, başlat.
{ q ? (Liste yeni). } yakala: { Çıktı yaz: ['caught!'], yeni-satır. }, başlat.
{ q ? (Nesne yeni). } yakala: { Çıktı yaz: ['caught!'], yeni-satır. }, başlat.
{ q ? ({ ['Empty']. }). } yakala: { Çıktı yaz: ['caught!'], yeni-satır. }, başlat.
Çıktı yaz: ['caught them all'], yeni-satır.
