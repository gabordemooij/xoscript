>> q := Liste ← 1 ; 2 ; 3.
{ q ? ['1']. } yakala: { Çıktı yaz: ['yakalandı!'], yeni-satır. }, başlat.
{ q ? Doğru. } yakala: { Çıktı yaz: ['yakalandı!'], yeni-satır. }, başlat.
{ q ? Yanlış. } yakala: { Çıktı yaz: ['yakalandı!'], yeni-satır. }, başlat.
{ q ? Hiç. } yakala: { Çıktı yaz: ['yakalandı!'], yeni-satır. }, başlat.
{ q ? (Liste yeni). } yakala: { Çıktı yaz: ['yakalandı!'], yeni-satır. }, başlat.
{ q ? (Nesne yeni). } yakala: { Çıktı yaz: ['yakalandı!'], yeni-satır. }, başlat.
{ q ? ({ ['Boş']. }). } yakala: { Çıktı yaz: ['yakalandı!'], yeni-satır. }, başlat.
