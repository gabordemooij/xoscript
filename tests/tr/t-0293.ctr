
>> şehir := Liste ← ['Londra'] ; ['Paris'] ; ['Berlin'].
>> sıcaklık := Liste ← ['15'] ; ['16'] ; ['15'].
>> havaDurumu := sıcaklık göre: şehir.
>> şehirler := havaDurumu girdiler sırala: { :a :b <- (a karşılaştır: b). }.
>> sıcaklıklar := havaDurumu değerler sırala: { :a :b <- (a karşılaştır: b) negatif?. }.

Çıktı yaz: (şehirler birleştir: [',']), yeni-satır.
Çıktı yaz: (sıcaklıklar birleştir: [',']), yeni-satır.
