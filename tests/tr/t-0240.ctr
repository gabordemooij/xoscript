# test qualifiers

>> $ := Nesne yeni.

$ olunca: ['yanıtla:'] yap: { :x
	
	>> operation := x karakter: 0.
	>> valuta := x karakter: 1.
	>> money := x kaydır: 2.
	
	>> amount := 0.

	( operation = ['+'] ) doğru: {
		( valuta = ['£'] ) doğru: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Çıktı yaz: x, yeni-satır.


>> Fruit := Nesne yeni.

Fruit olunca: ['yeni'] yap: {
	>> f := kendi yeni.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit olunca: ['apples:'] yap: { :a öz apples := a. }.
Fruit olunca: ['oranges:'] yap: { :p öz oranges := p. }.
Fruit olunca: ['apples'] yap: { <- öz apples. }.
Fruit olunca: ['oranges'] yap: { <- öz oranges. }.

Fruit olunca: ['+'] yap: { :f
	
	>> n := Fruit yeni.
	f ekle: 1.
	
	n apples: (f apples + öz apples).
	n oranges:  (f oranges  + öz oranges). <- n.
}.

Fruit olunca: ['metin'] yap: { <- ( öz apples metin + [' apples and '] + öz oranges + [' oranges'] ).
}.

Sayı olunca: ['apples'] yap: { <- ((Fruit yeni) apples: kendi).
}.

Sayı olunca: ['apple'] yap: { <- ((Fruit yeni) apples: kendi).
}.

Sayı olunca: ['oranges'] yap: { <- ((Fruit yeni) oranges: kendi).
}.




Çıktı yaz: (1 apple + 3 oranges + 4 apples), yeni-satır.


Metin olunca: ['twice'] yap: { <- ((kendi metin) + (kendi metin)).
}.



Çıktı yaz: ['❤❤❤'] twice.



