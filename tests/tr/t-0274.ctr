

Liste olunca: ['column:'] yap: { :column
	>> result := Liste yeni.
	kendi her: { :index :row
		row her: { :index :cell
			(index = column) doğru: { result sona-ekle: cell. }.
		}.
	}. <- result.
}.


>> a := Liste ←
	(Liste ← 1 ; 2 ; 3) ;
	(Liste ← 4 ; 5 ; 6) ;
	(Liste ← 7 ; 8 ; 9).

>> b := a column: 1.
Çıktı yaz: b, yeni-satır.

b := a column: 20.
Çıktı yaz: b, yeni-satır.

b := a column: -100.
Çıktı yaz: b, yeni-satır.
