

Liste olunca: ['column:'] yap: { :sütun
	>> sonuç := Liste yeni.
	kendi her: { :indeks :kayıt
		kayıt her: { :indeks :hücre
			(indeks = sütun) doğru: { sonuç sona-ekle: hücre. }.
		}.
	}. <- sonuç.
}.


>> a := Liste ←
	(Liste ← 1 ; 2 ; 3) ;
	(Liste ← 4 ; 5 ; 6) ;
	(Liste ← 7 ; 8 ; 9).

>> b := a column: 1.
Çıktı yaz: b, yeni-satır.

b := a column: 20.
Çıktı yaz: b, yeni-satır.

b := a column: -100.
Çıktı yaz: b, yeni-satır.
