# veritabanı sınaması
# gerekli yapılandırma için server.xo örneğine bakın

Server init.
Çıktı yaz: ['Veritabanı testi'], yeni-satır.

>> vt := Maria-DB yeni sunucu-adı: ['localhost'],
	kullanıcı: ['xo'], parola: ['pass123'], veritabanı-adı: ['xobase'], bağlan.

Çıktı yaz: ['Bağlanabilir miyiz? '] + vt bağlı?, yeni-satır.

>> arama-parametreleri := vt sorgu: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parametreler: ( Liste yeni ; ['abc'] ; 12.35 ; 6 ). # parametreli sorgular

{  arama-parametreleri yürüt. vt onayla. } yakala: { :e vt geri-al.  }, başlat.

Çıktı yaz: ['Ekleyebilir miyiz? '] + ( arama-parametreleri insert-id > 0 ), yeni-satır.

>> x := 0.
>> arama-parametreleri :=
vt sorgu: ['SELECT * FROM book order by id desc limit 2'], 
getir: { :kayıt 
	x ekle: 1.
	Doğru kır. # temizlemeli, 'Commands out of sync' olmamalı
}.

>> arama-parametreleri :=
vt sorgu: ['SELECT * FROM book order by id desc limit 2'], 
getir: { :kayıt
	x ekle: 1.
	Doğru kır.
}.

(x > 0) doğru: {
	Çıktı yaz: ['Bir getirmenin ortasında kırabilir miyiz? '].
}.

Çıktı yaz: Doğru, yeni-satır.