

>> Matryoshka := Nesne yeni.
Matryoshka olunca: ['double:'] yap: { :secret
	öz secret := secret × 2.
}.
Matryoshka olunca: ['yeni:'] yap: { :secret
	>> answer := Hiç.
	>> t := (secret > 255).
	Çıktı yaz: (secret + [' | '] + t), yeni-satır.
	t doğru: {
		answer := secret.
	}, yoksa: {
		answer := Matryoshka yinelemeli yeni: (kendi double: secret).
	}. <- answer.
}.

>> x := Matryoshka yeni: 2.
