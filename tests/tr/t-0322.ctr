

>> Matruşka := Nesne yeni.
Matruşka olunca: ['double:'] yap: { :sır
	öz sır := sır × 2.
}.
Matruşka olunca: ['yeni:'] yap: { :sır
	>> cevap := Hiç.
	>> t := (sır > 255).
	Çıktı yaz: (sır + [' | '] + t), yeni-satır.
	t doğru: {
		cevap := sır.
	}, yoksa: {
		cevap := Matruşka yinelemeli yeni: (kendi double: sır).
	}. <- cevap.
}.

>> x := Matruşka yeni: 2.
