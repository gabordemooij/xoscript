>> items := Sözlük yeni.
items koy: ['sade'] konum: ['coffee'], koy: ['earl grey'] konum: ['çay'].
Çıktı yaz: (items konum: ['coffee']), yaz: (items konum: ['çay']).
Çıktı yaz: ['dizide'] + items adet + [' öğe var.'].
items koy: ['kapuçino'] konum: ['coffee'].
Çıktı yaz: ['Şimdi kahvem.. '] + (items konum: ['coffee']).
items koy: ['aaa'] konum: ['1'].
items koy: ['bbb'] konum: ['2'].
Çıktı yaz: (items konum: ['a']).
