>> items := Sözlük yeni.
items koy: ['black'] konum: ['coffee'], koy: ['earl grey'] konum: ['tea'].
Çıktı yaz: (items konum: ['coffee']), yaz: (items konum: ['tea']).
Çıktı yaz: ['there are'] + items adet + [' items in the array.'].
items koy: ['capuccino'] konum: ['coffee'].
Çıktı yaz: ['Now my coffee is.. '] + (items konum: ['coffee']).
items koy: ['aaa'] konum: ['1'].
items koy: ['bbb'] konum: ['2'].
Çıktı yaz: (items konum: ['a']).
