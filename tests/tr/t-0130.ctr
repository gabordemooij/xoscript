# Server eklentisiyle FFI kullanımı

# libc'ye bağlan (platforma özgü)
>> kütüphaneAdı := Program ayar: ['FFITESTLIB'].

# gelişmiş dosya işlemleri için C'deki stdio fonksiyonlarını bağla
Server bağla: ( Liste yeni ;
 kütüphaneAdı ; ['fopen'] ;
 ( Liste yeni ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
bağla: ( Liste yeni ;
 Hiç ; # aynı kütüphane anlamına gelir
 ['fread'] ;
 ( Liste yeni ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Hiç ; # aynı nesne anlamına gelir (yani Akış)
 ['fread']
),
bağla: (
 Liste yeni ;
 Hiç ; # aynı kütüphane anlamına gelir
 ['fwrite'] ;
 ( Liste yeni ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Hiç ; # aynı kütüphane anlamına gelir
 ['fwrite']
),
bağla: (
 Liste yeni ;
 Hiç ; # aynı kütüphane anlamına gelir
 ['rewind'] ;
 ( Liste yeni ; ['pointer'] ) ;
 ['int'] ;
 Hiç ; # aynı kütüphane anlamına gelir
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> yol := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# fopen(path, mode) ile bir dosya aç
>> fd := Stream path: yol mode: mode.

# tampondaki str baytlarını dosyaya yaz
>> yazılan-baytlar := Stream ileti: ['fwrite'] argümanlar: (Liste yeni ; str ; 1 ; 6 ; fd ).
Çıktı yaz: yazılan-baytlar, yeni-satır.

# dosya işaretçisini başa sar
Stream rewind: fd.

# bir tampon ayır
>> buf := Blob yeni: 20.

# dosyadan oku
>> okunan-baytlar := Stream ileti: ['fread'] argümanlar: (Liste yeni ; buf ; 1 ; 6 ; fd ).
Çıktı yaz: okunan-baytlar, yeni-satır.
Çıktı yaz: buf, yeni-satır.

# belleği serbest bırak
str  serbest-bırak.
yol serbest-bırak.
mode serbest-bırak.
buf  serbest-bırak.


