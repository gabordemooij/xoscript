# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Program ayar: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server bağla: ( Liste yeni ;
 libname ; ['fopen'] ;
 ( Liste yeni ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
bağla: ( Liste yeni ;
 Hiç ; # means same lib
 ['fread'] ;
 ( Liste yeni ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Hiç ; # means same object (i.e. Stream)
 ['fread']
),
bağla: (
 Liste yeni ;
 Hiç ; # means same lib
 ['fwrite'] ;
 ( Liste yeni ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Hiç ; # means same lib
 ['fwrite']
),
bağla: (
 Liste yeni ;
 Hiç ; # means same lib
 ['rewind'] ;
 ( Liste yeni ; ['pointer'] ) ;
 ['int'] ;
 Hiç ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> yol := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: yol mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream ileti: ['fwrite'] argümanlar: (Liste yeni ; str ; 1 ; 6 ; fd ).
Çıktı yaz: bytes-written, yeni-satır.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob yeni: 20.

# read from file
>> bytes-read := Stream ileti: ['fread'] argümanlar: (Liste yeni ; buf ; 1 ; 6 ; fd ).
Çıktı yaz: bytes-read, yeni-satır.
Çıktı yaz: buf, yeni-satır.

# free memory
str  serbest-bırak.
yol serbest-bırak.
mode serbest-bırak.
buf  serbest-bırak.


