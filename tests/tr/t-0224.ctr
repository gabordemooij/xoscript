
>> countries := Liste yeni
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Liste yeni
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods göre: countries, her: { :key :value
	counter ekle: 1.
}.

Çıktı yaz: (['we serve counter dishes'] counter: counter), yeni-satır.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] karakterler sırala: { :v
	counter ekle: 0.
}.

Çıktı yaz: (['we sort counter dishes'] counter: counter), yeni-satır.


>> counter := 0.
{
	{
		counter ekle: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Çıktı yaz: (['we calculate counter numbers.'] counter: counter), yeni-satır.

