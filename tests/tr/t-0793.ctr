Server init.

>> DB := Maria-DB yeni sunucu-adı: ['localhost'],
	kullanıcı: ['xo'],
	parola: ['pass123'],
	veritabanı-adı: ['xobase'],
	bağlan.

{
	DB sorgu:
	['DROP TABLE movies'],
	yürüt.
} yakala: { Hiç. }, başlat.

DB sorgu:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
yürüt.

DB sorgu: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parametreler: ( Liste yeni ; ['Halloween'] ),
yürüt.

DB sorgu: ['SELECT * FROM movies'],
getir: { :film
	Çıktı yaz: film title, yeni-satır.
}.

