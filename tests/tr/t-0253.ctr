#Linux
>> OS := Program ayar: ['OS'].

>> duvarSaati := An yeni.
	
(OS = ['Haiku']) doğru: {
	duvarSaati dilim: ['CET'],
	yıl: 2017, ay: 7, gün: 13,
	saat: 18, dakika: 0, saniye: 0.
}, yoksa: {
	duvarSaati dilim: ['Europe/Amsterdam'],
	yıl: 2017, ay: 7, gün: 13,
	saat: 18, dakika: 0, saniye: 0.
}.

duvarSaati olunca: ['anlat'] yap: {
	Çıktı yaz: kendi, yeni-satır.
}.


duvarSaati ekle: 2    saat, anlat.
duvarSaati ekle: 1    saat, anlat.
duvarSaati ekle: 19 dakika, anlat.
duvarSaati ekle: 1  dakika, anlat.
duvarSaati ekle: 1  dakika, anlat.
duvarSaati ekle: 19 saniye, anlat.
duvarSaati ekle: 1  saniye, anlat.
duvarSaati ekle: 1  saniye, anlat.
duvarSaati ekle: 2    yıl, anlat.
duvarSaati ekle: 1    yıl, anlat.

(OS = ['Haiku']) doğru: {
duvarSaati ekle: 5   ay.
duvarSaati dilim: ['CEST'], anlat.
}, yoksa: {
	duvarSaati ekle: 5   ay, anlat.
}.

duvarSaati ekle: 1   ay, anlat.
duvarSaati ekle: 19    gün, anlat.
duvarSaati ekle: 1    saat, anlat.
duvarSaati ekle: 120  yarda, anlat.
