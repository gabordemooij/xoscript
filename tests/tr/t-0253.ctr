#Linux
>> OS := Program ayar: ['OS'].

>> clock := An yeni.
	
(OS = ['Haiku']) doğru: {
	clock dilim: ['CET'],
	yıl: 2017, ay: 7, gün: 13,
	saat: 18, dakika: 0, saniye: 0.
}, yoksa: {
	clock dilim: ['Europe/Amsterdam'],
	yıl: 2017, ay: 7, gün: 13,
	saat: 18, dakika: 0, saniye: 0.
}.

clock olunca: ['tell'] yap: {
	Çıktı yaz: kendi, yeni-satır.
}.


clock ekle: 2    saat, tell.
clock ekle: 1    saat, tell.
clock ekle: 19 dakika, tell.
clock ekle: 1  dakika, tell.
clock ekle: 1  dakika, tell.
clock ekle: 19 saniye, tell.
clock ekle: 1  saniye, tell.
clock ekle: 1  saniye, tell.
clock ekle: 2    yıl, tell.
clock ekle: 1    yıl, tell.

(OS = ['Haiku']) doğru: {
clock ekle: 5   ay.
clock dilim: ['CEST'], tell.
}, yoksa: {
	clock ekle: 5   ay, tell.
}.

clock ekle: 1   ay, tell.
clock ekle: 19    gün, tell.
clock ekle: 1    saat, tell.
clock ekle: 120  yard, tell.
