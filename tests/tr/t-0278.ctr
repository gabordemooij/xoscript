>> To-Do := Nesne yeni.

To-Do olunca: ['yeni'] yap: {
	öz list := Liste yeni.
}.

To-Do olunca: ['nieuw'] yap: {
	öz list := Liste yeni.
}.

To-Do olunca: ['+'] yap: { :task
	öz list sona-ekle: task.
}.

To-Do olunca: ['number of tasks?'] yap: { <-  öz list adet.
}.

>> todos := 
	To-Do yeni 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Çıktı yaz: ['You have $ tasks to do'] $ todos number of tasks?.
