>> Yapılacaklar := Nesne yeni.

Yapılacaklar olunca: ['yeni'] yap: {
	öz list := Liste yeni.
}.

Yapılacaklar olunca: ['nieuw'] yap: {
	öz list := Liste yeni.
}.

Yapılacaklar olunca: ['+'] yap: { :görev
	öz list sona-ekle: görev.
}.

Yapılacaklar olunca: ['number of tasks?'] yap: { <-  öz list adet.
}.

>> yapılacaklar := 
	Yapılacaklar yeni 
	+ ['akşam yemeği pişir'] 
	+ ['odayı temizle'].
	
Çıktı yaz: ['You have $ tasks to do'] $ yapılacaklar number of tasks?.
