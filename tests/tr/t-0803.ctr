#...
>> del := conn1 sorgu: ['DELETE FROM book WHERE id > 0'].
{  del yürüt. conn1 onayla. } yakala: { :e conn1 geri-al.  }, başlat.

>> insert := conn1 sorgu: ['INSERT INTO book (id) VALUES(null)'].
insert yürüt.

>> adet := conn1 sorgu: ['SELECT COUNT(*) AS num FROM book'].
adet getir: { :row Çıktı yaz: row num, yeni-satır. }.

# does not show up
