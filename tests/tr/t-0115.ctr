{
	bu-görev hata: ['Dont fail.'].
	unknown doSomething.
} yakala: {
	Çıktı yaz: ['Caught!'].
}, başlat.

{
	bu-görev hata: ['Dont fail.'].
	öz unknown doSomething.
} yakala: {
	Çıktı yaz: ['Caught!'].
}, başlat.

{
	bu-görev hata: ['Dont fail.'].
	unknown := 122.
} yakala: {
	Çıktı yaz: ['Caught!'].
}, başlat.


{
	bu-görev hata: ['Dont fail.'].
	Doğru kır.
	Çıktı yaz: ['FAIL'].
} yakala: {
	Çıktı yaz: ['Caught!'].
}, başlat.

{
	{
		bu-görev hata: ['Dont fail.'].
		Doğru kır.
		Çıktı yaz: ['FAIL'].
	} yakala: { :x
		(x = ['Dont fail.']) doğru: { bu-görev hata: ['Nested Caught!']. }.
	}, başlat.
} yakala: { :e
	Çıktı yaz: e.
}, başlat.
