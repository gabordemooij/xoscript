{
	bu-görev hata: ['Başarısız olma.'].
	Doğru kır.
	Çıktı yaz: ['BAŞARISIZ'].
} yakala: {
	Çıktı yaz: ['Yakalandı!'].
}, başlat.

{
	{
		bu-görev hata: ['Başarısız olma.'].
		Doğru kır.
		Çıktı yaz: ['BAŞARISIZ'].
	} yakala: { :x
		(x = ['Başarısız olma.']) doğru: { bu-görev hata: ['İç içe Yakalandı!']. }.
	}, başlat.
} yakala: { :e
	Çıktı yaz: e.
}, başlat.
