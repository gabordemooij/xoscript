	bilinmeyen birŞeyYap.
} yakala: {
	Çıktı yaz: ['Yakalandı!'].
}, başlat.

{
	bu-görev hata: ['Başarısız olma.'].
	öz bilinmeyen birŞeyYap.
} yakala: {
	Çıktı yaz: ['Yakalandı!'].
