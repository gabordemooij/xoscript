>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Nesne yeni.
⚄ olunca: ['drawFrom:length:'] yap: { :pool :adet
	
	>> result := [''].
	
	{
		>> index := Sayı random % (pool uzunluk).
		result sona-ekle: ( pool karakter: (index + 1) ).
		
	} × adet. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? uzunluk.
Çıktı yaz: (['x↵'] x random uzunluk).
Çıktı yaz: (['y↵'] y ?? uzunluk).

