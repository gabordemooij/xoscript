

>> g  := Server yeni.
>> v  := Kasa yeni.
>> ok := 0.

>> sırlar := Liste yeni ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> parolalar := sırlar kopyala.
parolalar her: { :i :p
	sırlar her: { :n :s
		{
			>> şifreli := v şifrele: s anahtar: p.
			>> çözülmüş := v şifre-çöz: şifreli anahtar: p.
			(çözülmüş = s) doğru: {
				ok ekle: 1.
			}, yoksa: {
				Çıktı yaz: ['şifreleme/çözme başarısız: '], yeni-satır.
				Çıktı yaz: s, yeni-satır.
				Çıktı yaz: ['şifreli: '] + şifreli, yeni-satır.
				Çıktı yaz: ['çözülmüş: '] + şifreli, yeni-satır.
				Program bitir.
			}.
		} yakala: { :err
			(s = [''] veya: p = ['']) doğru: {
				ok ekle: 1.
			}, yoksa: {
				Çıktı yaz: err, yeni-satır.
				Program bitir.
			}.
		}, başlat.
	}.
}.

Çıktı yaz: ( ok + [' kasa şifrelemesi test edildi.'] ), yeni-satır.