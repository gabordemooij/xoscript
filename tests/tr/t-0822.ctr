# yer tutuculardan az parametre bağlamaların ötesini okumamalı, hata vermeli
Server init.

>> vt := Maria-DB yeni sunucu-adı: ['localhost'],
	kullanıcı: ['xo'],
	parola: ['pass123'],
	veritabanı-adı: ['xobase'],
	bağlan.

>> arama-parametreleri := vt sorgu: ['SELECT ? AS a, ? AS b, ? AS c'].
arama-parametreleri parametreler: (Liste yeni ; ['1']).
{ arama-parametreleri getir: { :kayıt Çıktı yaz: kayıt, yeni-satır. }. } yakala: { :e Çıktı yaz: e, yeni-satır. }, başlat.

>> arama-parametreleri := vt sorgu: ['SELECT ? AS a'].
{ arama-parametreleri getir: { :kayıt Çıktı yaz: kayıt, yeni-satır. }. } yakala: { :e Çıktı yaz: e, yeni-satır. }, başlat.

# doğru sayı hâlâ çalışır, fazla parametreler eskisi gibi yok sayılır
>> arama-parametreleri := vt sorgu: ['SELECT ? AS a, ? AS b'].
arama-parametreleri parametreler: (Liste yeni ; ['1'] ; ['2']).
arama-parametreleri getir: { :kayıt Çıktı yaz: (kayıt konum: ['a']), yaz: (kayıt konum: ['b']), yeni-satır. }.
arama-parametreleri parametreler: (Liste yeni ; ['1'] ; ['2'] ; ['3']).
arama-parametreleri getir: { :kayıt Çıktı yaz: (kayıt konum: ['a']), yaz: (kayıt konum: ['b']), yeni-satır. }.
