


>> Deck := Liste yeni.
Deck olunca: ['print'] yap: {
        >> len := kendi adet - 1.
        { :i
                >> len2 := kendi adet - 1.
                Çıktı yaz: ['len: '].
                Çıktı yaz: len, yeni-satır.
                Çıktı yaz: ['len2: '].
                Çıktı yaz: len2, yeni-satır.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
