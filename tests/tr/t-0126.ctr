#Linux
>> Slurp := Nesne yeni.

Slurp olunca: ['yeni'] yap: {
	öz str := [''].
}.

Slurp olunca: ['nieuw'] yap: {
	öz str := [''].
}.

Slurp olunca: ['yanıtla:'] yap: { :blah
		öz str sona-ekle: blah.
}.

Slurp olunca: ['yanıtla:ve:'] yap: { :blah :blahah
		öz str sona-ekle: (blah başlangıç: 0 uzunluk: (blah uzunluk - 1)).
		öz str sona-ekle: [' '].
		öz str sona-ekle: blahah.
}.

Slurp olunca: ['edin'] yap: {
	>> tampon := öz str.
	öz str := ['']. <- tampon.
}.


Çıktı yaz: (Program sistem: (Slurp yeni echo: ['Merhaba, akıcı API ile konsola yazabilirim!'], edin)).


{ Dosya yeni: ['/tmp/from.txt'], sil. } yakala: { ['Boş']. }, başlat.
{ Dosya yeni: ['/tmp/to.txt'], sil. } yakala: { ['Boş']. }, başlat.


Dosya yeni: ['/tmp/to.txt'], var yanlış: {
	Çıktı yaz: ['Confirmed. Target file does not exist.\
'].
}.
Dosya yeni: ['/tmp/from.txt'], var yanlış: {
	Çıktı yaz: ['Confirmed. Source file does not exist.\
'].
}.



Program sistem: (Slurp yeni touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], edin).



Program sistem: (Slurp yeni cp: ['/tmp/from.txt /tmp/to.txt'], edin).

Dosya yeni: ['/tmp/to.txt'], var doğru: {
	Çıktı yaz: ['Confirmed. Target file has been created by shell.\
'].
}.


Çıktı yaz: ['Dosyanın içeriği:'] + (Dosya yeni: ['/tmp/to.txt'], oku), yeni-satır.
