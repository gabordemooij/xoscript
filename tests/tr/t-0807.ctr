# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB yeni sunucu-adı: ['localhost'],
	kullanıcı: ['xo'],
	parola: ['pass123'],
	veritabanı-adı: ['xobase'],
	bağlan.

>> arama-parametreleri := db sorgu: ['SELECT %% FROM'].
{ arama-parametreleri yürüt. } yakala: { :e
	Çıktı yaz: ( e kapsar: ['%%'] ), yeni-satır.
}, başlat.
