Liste olunca: ['toplamı'] yap: {
	>> toplam := 0.
	kendi her: { :indeks :eleman
		toplam ekle: eleman.
	}. <- toplam.
}.

>> a := Doğru.



a olunca: ['metin'] yap: {
	>> cevap := Hiç.
	( kendi = Doğru ) doğru: {
		cevap := ['Hıhı'].
	}, yoksa: {
		cevap := ['Yok'].
	}. <- cevap.
}.

a olunca: ['sayı'] yap: {
	>> cevap := Hiç.
	( kendi = Doğru ) doğru: {
		cevap := 10.
	}, yoksa: {
		cevap := 20.
	}. <- cevap.
}.

>> b := 666.

b olunca: ['metin'] yap: { <- ['Şeytan'].
}.

b olunca: ['mantıksal'] yap: { <- Yanlış.
}.


Çıktı yaz: a, yeni-satır.  
Çıktı yaz: (90 + a), yeni-satır. 
Çıktı yaz: b, yeni-satır. 
Çıktı yaz: (Doğru ve: b), yeni-satır.

a := Liste ← ['hello'] ; ['world'] ; Doğru ; Hiç ; 666. 
a := a + ( Liste ← 1 ).
Çıktı yaz: a, yeni-satır.
Çıktı yaz: ((Sözlük yeni) koy: Hiç konum: Hiç), yeni-satır.
Çıktı yaz: a toplamı, yeni-satır. 


{
	a olunca: ['metin'] yap: { <- Hiç. }.
	a := [''] + a.
} yakala: { :hata
	Çıktı yaz: ['Hata kaydedildi: '] + hata, yeni-satır.
}, başlat.



{
	a olunca: ['sayı'] yap: { <- Hiç. }.
	a := 3 × a.
} yakala: { :hata
	Çıktı yaz: ['Hata kaydedildi: '] + hata, yeni-satır.
}, başlat.


{
	a olunca: ['mantıksal'] yap: { <- Hiç. }.
	a := Doğru ve: a. 
} yakala: { :hata
	Çıktı yaz: ['Hata kaydedildi: '] + hata, yeni-satır.
}, başlat.





