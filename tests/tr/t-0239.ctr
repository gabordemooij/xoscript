Liste olunca: ['sum'] yap: {
	>> total := 0.
	kendi her: { :index :element
		total ekle: element.
	}. <- total.
}.

>> a := Doğru.



a olunca: ['metin'] yap: {
	>> answer := Hiç.
	( kendi = Doğru ) doğru: {
		answer := ['Yep'].
	}, yoksa: {
		answer := ['Nope'].
	}. <- answer.
}.

a olunca: ['sayı'] yap: {
	>> answer := Hiç.
	( kendi = Doğru ) doğru: {
		answer := 10.
	}, yoksa: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b olunca: ['metin'] yap: { <- ['Devil'].
}.

b olunca: ['mantıksal'] yap: { <- Yanlış.
}.


Çıktı yaz: a, yeni-satır.  
Çıktı yaz: (90 + a), yeni-satır. 
Çıktı yaz: b, yeni-satır. 
Çıktı yaz: (Doğru ve: b), yeni-satır.

a := Liste ← ['hello'] ; ['world'] ; Doğru ; Hiç ; 666. 
a := a + ( Liste ← 1 ).
Çıktı yaz: a, yeni-satır.
Çıktı yaz: ((Sözlük yeni) koy: Hiç konum: Hiç), yeni-satır.
Çıktı yaz: a sum, yeni-satır. 


{
	a olunca: ['metin'] yap: { <- Hiç. }.
	a := [''] + a.
} yakala: { :error
	Çıktı yaz: ['Error noted: '] + error, yeni-satır.
}, başlat.



