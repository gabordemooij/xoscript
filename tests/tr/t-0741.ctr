Çıktı yaz: ['Test nesnesi'], yeni-satır.
>> a := Nesne yeni. 

a olunca: ['item:'] yap: { :octhelper
	öz octhelper := octhelper. 
}.

a olunca: ['öğe'] yap: {
	<- öz octhelper.
}.

a item: Oct yeni.

>> eski-octhelper-adresi := a öğe prototip bellek-adresi.
a save-as: ['/tmp/a.bin'].
Çıktı yaz: ['========== SNAP YENİDEN YÜKLENİYOR:'], yeni-satır.

>> b := Nesne load-from: ['/tmp/a.bin'].

(b öğe prototip bellek-adresi = eski-octhelper-adresi) doğru: {
	Çıktı yaz: ['Nesne bağlantısı yeniden bağlandı.'], yeni-satır.
}.
