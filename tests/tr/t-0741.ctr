Çıktı yaz: ['Test object'], yeni-satır.
>> a := Nesne yeni. 

a olunca: ['item:'] yap: { :octhelper
	öz octhelper := octhelper. 
}.

a olunca: ['item'] yap: { <- öz octhelper.
}.

a item: Oct yeni.

>> old-octhelper-address := a item prototip bellek-adresi.
a save-as: ['/tmp/a.bin'].
Çıktı yaz: ['========== RELOADING SNAP:'], yeni-satır.

>> b := Nesne load-from: ['/tmp/a.bin'].

(b item prototip bellek-adresi = old-octhelper-address) doğru: {
	Çıktı yaz: ['Object link re-attached.'], yeni-satır.
}.
