
Çıktı yaz: ['For döngüsünü kır, 0-4.'], yeni-satır.
{ :i
	Çıktı yaz: ['iteration #'] + i, yeni-satır.
	(i = 4) kır.
} × 10.

>> x := 0.
>> x10danKüçük := { <- ( x < 10 ). }.

Çıktı yaz: ['Doğru-sürece döngüsünü kır, 0-4.'], yeni-satır.
{
	Çıktı yaz: ['iteration #'] + x, yeni-satır.
	x ekle: 1.
	((x < 5) değil) kır.
} sürece: x10danKüçük.

Çıktı yaz: ['Yanlış-sürece döngüsünü kır, 5,4.'], yeni-satır.
{
	Çıktı yaz: ['iteration #'] + x, yeni-satır.
	x çıkar: 1.
	(x = 3) kır.
} sürece: { <- (x > 0). }.

Çıktı yaz: ['Kez döngüsünü kır, 1-4.'], yeni-satır.
{ :i
	Çıktı yaz: ['iteration #'] + i, yeni-satır.
	(i = 4) kır.
} × 5.

Çıktı yaz: ['Bloğu kır, satırı yazdırma.'], yeni-satır.
{ Doğru kır. Çıktı yaz: ['bunu yazma!'], yeni-satır. } başlat.

Çıktı yaz: ['Bloğu kır, yakalamayı tetikleme...'], yeni-satır.
{ Doğru kır. Çıktı yaz: ['bunu yazma!'], yeni-satır. } yakala: { Çıktı yaz: ['Bunu yakalama!']. }, başlat.

Çıktı yaz: ['Liste her-döngüsü testi: 0,1'], yeni-satır.
(Liste ← 1 ; 2 ; 3) dönüştür: { :i
	Çıktı yaz: ['iteration #'] + i, yeni-satır.
	(i = 1) kır.
}.

Çıktı yaz: ['Sözlük her-döngüsü testi: yalnızca c'], yeni-satır.
>> m := Sözlük yeni.
m koy: ['first'] konum: ['a'], koy: ['second'] konum: ['b'], koy: ['üçüncü'] konum: ['c'].
m her: { :k :v
	Çıktı yaz: ['iteration'] + v + k, yeni-satır.
	Doğru kır.
}.

