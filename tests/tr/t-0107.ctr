
Çıktı yaz: ['Break for-loop, 0-4.'], yeni-satır.
{ :i
	Çıktı yaz: ['iteration #'] + i, yeni-satır.
	(i = 4) kır.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Çıktı yaz: ['Break while-true loop, 0-4.'], yeni-satır.
{
	Çıktı yaz: ['iteration #'] + x, yeni-satır.
	x ekle: 1.
	((x < 5) değil) kır.
} sürece: xIsLessThan10.

Çıktı yaz: ['Break while-false loop, 5,4.'], yeni-satır.
{
	Çıktı yaz: ['iteration #'] + x, yeni-satır.
	x çıkar: 1.
	(x = 3) kır.
} sürece: { <- (x > 0). }.

Çıktı yaz: ['Break times loop, 1-4.'], yeni-satır.
{ :i
	Çıktı yaz: ['iteration #'] + i, yeni-satır.
	(i = 4) kır.
} × 5.

Çıktı yaz: ['Break block, dont print line.'], yeni-satır.
{ Doğru kır. Çıktı yaz: ['dont write this!'], yeni-satır. } başlat.

Çıktı yaz: ['Break block, dont fire catch...'], yeni-satır.
{ Doğru kır. Çıktı yaz: ['dont write this!'], yeni-satır. } yakala: { Çıktı yaz: ['Dont catch this!']. }, başlat.

Çıktı yaz: ['Test Array each-loop: 0,1'], yeni-satır.
(Liste ← 1 ; 2 ; 3) dönüştür: { :i
	Çıktı yaz: ['iteration #'] + i, yeni-satır.
	(i = 1) kır.
}.

Çıktı yaz: ['Test Map each-loop: c only'], yeni-satır.
>> m := Sözlük yeni.
m koy: ['first'] konum: ['a'], koy: ['second'] konum: ['b'], koy: ['third'] konum: ['c'].
m her: { :k :v
	Çıktı yaz: ['iteration'] + v + k, yeni-satır.
	Doğru kır.
}.

