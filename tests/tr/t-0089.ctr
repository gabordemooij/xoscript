>> randomizer := { :a :b
	>> minimum := ( a < b ) ya: a veya: b.
	>> maksimum := ( a > b ) ya: a veya: b.
	>> x := Hiç.
	{
		x := Sayı arasında: a ve: b.
		((x < minimum) veya: (x > maksimum)) doğru: { 
			Çıktı yaz: (['Invalid value!']).
			Program bitir.
		}.
	} 
	× 100. <- x.
}.
randomizer uygula: 0 ve: 0.
