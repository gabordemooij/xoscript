>> rastgeleleştirici := { :a :b
	>> minimum := ( a < b ) ya: a veya: b.
	>> maksimum := ( a > b ) ya: a veya: b.
	>> x := Hiç.
	{
		x := Sayı arasında: a ve: b.
		((x < minimum) veya: (x > maksimum)) doğru: { 
			Çıktı yaz: (['Geçersiz değer!']).
			Program bitir.
		}.
	} 
	× 100. <- x.
}.
rastgeleleştirici uygula: 0 ve: 0.
rastgeleleştirici uygula: 1 ve: 0.
