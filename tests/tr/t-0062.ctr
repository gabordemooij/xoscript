Mantıksal olunca: ['xor:'] yap: { :a :b <- ((a ve: b değil) veya: (a değil ve: b)).
}.

>> o := Nesne yeni.
o olunca: ['hello'] yap: { ['Boş']. }.
{ o olunca: 2 yap: 3.} yakala: { :e Çıktı yaz: e, yeni-satır. }, başlat.
{ o olunca: ['sınama'] yap: 3.} yakala: { :e Çıktı yaz: e, yeni-satır. }, başlat.
{ o olunca: ['hello'] yap: { ['Boş']. }.} yakala: { :e Çıktı yaz: e, yeni-satır. }, başlat. 
{ >> z := 4 ÷ 0. } yakala: { :e Çıktı yaz: e, yeni-satır. }, başlat. 
{ (Doğru ve: Hiç) doğru: { Çıktı yaz: ['X'].}. } yakala: { :e Çıktı yaz: e, yeni-satır. }, başlat. 
{ ([''] xor: 0) doğru: { Çıktı yaz: ['X'].}. } yakala: { :e Çıktı yaz: e, yeni-satır. }, başlat. 
{ (1 < ['2']) doğru: { Çıktı yaz: ['OK']. }. } yakala: { :e Çıktı yaz: e, yeni-satır. }, başlat. 
{ (1 < ['2.0']) doğru: { Çıktı yaz: ['OK']. }. } yakala: { :e Çıktı yaz: e, yeni-satır. }, başlat. 
{ (1 < ['x2.0']) doğru: { Çıktı yaz: ['HAYIR!']. }. } yakala: { :e Çıktı yaz: e, yeni-satır. }, başlat. 
{ Çıktı yaz: (['selam OK orada'] başlangıç: ['6'] uzunluk: ['2']). } başlat. 
