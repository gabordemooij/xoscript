

>> obj := Nesne yeni.

obj olunca: ['greet'] yap: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj olunca: ['task'] yap: {
	öz property := 123.
	{
		# try binds self/own to object instead of block
		Çıktı yaz: kendi greet.
		Çıktı yaz: öz property.
		1 / 0.
	} yakala: {
		Çıktı yaz: kendi greet.
		Çıktı yaz: öz property.
		Çıktı yaz: ['ok'].
	}, dene.
}.

obj task.