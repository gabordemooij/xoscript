

>> obj := Nesne yeni.

obj olunca: ['selamla'] yap: {
	<- ['selam'].
}.

# hi123hi123ok çıktılamalı
obj olunca: ['görev'] yap: {
	öz özellik := 123.
	{
		# dene, kendi/öz'ü blok yerine nesneye bağlar
		Çıktı yaz: kendi selamla.
		Çıktı yaz: öz özellik.
		1 / 0.
	} yakala: {
		Çıktı yaz: kendi selamla.
		Çıktı yaz: öz özellik.
		Çıktı yaz: ['ok'].
	}, dene.
}.

obj görev.