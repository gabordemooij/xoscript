# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Desen yeni: pattern.
	p eşleş: subject yap: { :m :g
		Çıktı yaz: g adet, yaz: [' '], yaz: (g birleştir: ['|']), yeni-satır. <- m.
	}.
}.
show uygula: ['(a)|(b)'] ve: ['b'].
show uygula: ['(a)|(b)'] ve: ['a'].
show uygula: ['(x)?y'] ve: ['y'].
show uygula: ['(x)?(y)(z)?'] ve: ['xy'].
