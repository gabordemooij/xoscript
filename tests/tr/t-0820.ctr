# eşleşmenin parçası olmayan bir grup çökmemeli ve grup numaralarını korumalı
Server init.
>> göster := { :örüntü :subject
	>> p := Desen yeni: örüntü.
	p eşleş: subject yap: { :m :g
		Çıktı yaz: g adet, yaz: [' '], yaz: (g birleştir: ['|']), yeni-satır.
		<- m.
	}.
}.
göster uygula: ['(a)|(b)'] ve: ['b'].
göster uygula: ['(a)|(b)'] ve: ['a'].
göster uygula: ['(x)?y'] ve: ['y'].
göster uygula: ['(x)?(y)(z)?'] ve: ['xy'].
