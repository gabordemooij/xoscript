# a value ending in the first part of an opening quote must survive serialization
>> değerler := Liste yeni
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

değerler her: { :i :value
	>> d := Sözlük yeni.
	d koy: value konum: ['k'].
	d koy: ['second'] konum: ['j'].
	>> r := d kod nesne.
	Çıktı yaz: r adet, yeni-satır.
	Çıktı yaz: ( (r konum: ['k']) = value ), yeni-satır.
}.
