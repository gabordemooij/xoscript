#Linux
>> clock := An yeni.
clock dilim: ['UTC-1'].
clock yıl: 1981, ay: 1, gün: 5,
      saat: 13, dakika: 15, saniye: 13.

Çıktı yaz: clock, yeni-satır.
clock dilim: ['UTC+0'].

Çıktı yaz: (
	(clock yıl yalın) + ['-'] + (clock ay) + ['-'] + (clock gün) + [' '] +
	(clock saat) + [':'] + (clock dakika) + [':'] + (clock saniye) + [' '] +
	['W'] + (clock hafta) + (clock dilim)
), yeni-satır.


clock dilim: ['UTC-1'].
Çıktı yaz: (
	(clock yıl yalın) + ['-'] + (clock ay) + ['-'] + (clock gün) + [' '] +
	(clock saat) + [':'] + (clock dakika) + [':'] + (clock saniye) + [' '] +
	['W'] + (clock hafta) + (clock dilim)
), yeni-satır.
