#Linux
>> duvarSaati := An yeni.
duvarSaati dilim: ['UTC-1'].
duvarSaati yıl: 1981, ay: 1, gün: 5,
      saat: 13, dakika: 15, saniye: 13.

Çıktı yaz: duvarSaati, yeni-satır.
duvarSaati dilim: ['UTC+0'].

Çıktı yaz: (
	(duvarSaati yıl yalın) + ['-'] + (duvarSaati ay) + ['-'] + (duvarSaati gün) + [' '] +
	(duvarSaati saat) + [':'] + (duvarSaati dakika) + [':'] + (duvarSaati saniye) + [' '] +
	['W'] + (duvarSaati hafta) + (duvarSaati dilim)
), yeni-satır.


duvarSaati dilim: ['UTC-1'].
Çıktı yaz: (
	(duvarSaati yıl yalın) + ['-'] + (duvarSaati ay) + ['-'] + (duvarSaati gün) + [' '] +
	(duvarSaati saat) + [':'] + (duvarSaati dakika) + [':'] + (duvarSaati saniye) + [' '] +
	['W'] + (duvarSaati hafta) + (duvarSaati dilim)
), yeni-satır.
