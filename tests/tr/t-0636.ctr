# url ayrıştırmayı sına

Server init.
>> url := URL kaynak: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Çıktı yaz: ['şema = '] + url şema, yeni-satır.
Çıktı yaz: ['ana makine = '] + url sunucu-adı, yeni-satır.
Çıktı yaz: ['port = '] + url kapı, yeni-satır.
Çıktı yaz: ['yol = '] + url yol, yeni-satır.
Çıktı yaz: ['sorgu = '] + url arama-parametreleri, yeni-satır.
Çıktı yaz: ['parça = '] + url parça, yeni-satır.
