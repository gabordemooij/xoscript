# test url parsing

Server init.
>> url := URL kaynak: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Çıktı yaz: ['scheme = '] + url şema, yeni-satır.
Çıktı yaz: ['host = '] + url sunucu-adı, yeni-satır.
Çıktı yaz: ['port = '] + url kapı, yeni-satır.
Çıktı yaz: ['path = '] + url yol, yeni-satır.
Çıktı yaz: ['query = '] + url arama-parametreleri, yeni-satır.
Çıktı yaz: ['fragment = '] + url parça, yeni-satır.
