Server init.

# JSON kodlayıcı yalnızca UTF-8'i destekler, vekil çiftler yok

>> sözlükler := Liste yeni ;
	# {"key":"normal"} normal ASCII
	( Sözlük yeni koy: ['normal'] konum: ['key'] ) ;
	# {"key":"hello world"} boşluk karakteri
	( Sözlük yeni koy: ['hello world'] konum: ['key'] ) ;
	# {"key":"quote: \""} çift tırnak
	( Sözlük yeni koy: ['"'] konum: ['key'] ) ;
	# {"key":"backslash: \\"} ters eğik çizgi
	( Sözlük yeni koy: ['backslash: \\'] konum: ['key'] ) ;
	# {"key":"slash: /"} eğik çizgi
	( Sözlük yeni koy: ['eğik çizgi: /'] konum: ['key'] ) ;
	# {"key":"backspace: \b"} geri silme
	( Sözlük yeni koy: ['backspace: \b'] konum: ['key'] ) ;
	# {"key":"formfeed: \f"} sayfa besleme kaçışı
	( Sözlük yeni koy: ['formfeed: \f'] konum: ['key'] ) ;
	# {"key":"newline: \n"} yeni satır
	( Sözlük yeni koy: ['newline: \n'] konum: ['key'] ) ;
	( Sözlük yeni koy: ['newline: ↵'] konum: ['key'] ) ;
	( Sözlük yeni koy: ['newline: 
	'] konum: ['key'] ) ;
	# {"key":"carriage return: \r"} satır başı
	( Sözlük yeni koy: ['carriage return: \r'] konum: ['key'] ) ;
	# {"key":"tab: \t"} sekme
	( Sözlük yeni koy: ['tab \t'] konum: ['key'] ) ;
	( Sözlük yeni koy: ['tab ⇿'] konum: ['key'] ) ;
	( Sözlük yeni koy: ['sekme  '] konum: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( Sözlük yeni koy: ['NUL \u0000'] konum: ['key'] ) ;
	( Sözlük yeni koy: ['NUL \0'] konum: ['key'] ) ;
	# {"key":"control: \u0001"} denetim karakteri 0x01
	( Sözlük yeni koy: ['control: \u0001'] konum: ['key'] ) ;
	# {"key":"control: \u001F"} denetim karakteri 0x1F
	( Sözlük yeni koy: ['control: \u001F'] konum: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2 baytlık karakter
	( Sözlük yeni koy: ['unikod: é'] konum: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3 baytlık karakter
	( Sözlük yeni koy: ['unikod: €'] konum: ['key'] ) ;
	# {"key":"unicode: 日本語"} birden çok 3 baytlık UTF-8 karakteri
	( Sözlük yeni koy: ['unikod: 日本語'] konum: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4 baytlık karakter
	( Sözlük yeni koy: ['unikod: 😀'] konum: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + sıfır genişlikli birleştirici
	( Sözlük yeni koy: ['unikod: 🧑‍💻'] konum: ['key'] ) ;
	# {"key":"combining: é"} birleşen aksan
	( Sözlük yeni koy: ['combining: e\u0301'] konum: ['key'] ) ;
	# {"key":"escaped unicode: é"} Unicode kaçışı BMP
	( Sözlük yeni koy: ['escaped unicode: \u00e9'] konum: ['key'] ) ;
	# {"key":"escaped unicode: €"} Unicode kaçışı BMP
	( Sözlük yeni koy: ['escaped unicode: \u20ac'] konum: ['key'] ) ;
	# {"key":"escaped unicode: 😀"} UTF-16 vekil çifti
	( Sözlük yeni koy: ['escaped unicode: \ud83d\ude00'] konum: ['key'] ) ;
	# {"key":""} boş değer
	( Sözlük yeni koy: [''] konum: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} özel ASCII karakterleri
	( Sözlük yeni koy: ['@ < > & = % + ? #'] konum: ['key'] ) ;
	# {"key":"single quote: '"} tek tırnak
	( Sözlük yeni koy: ['''] konum: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} birden çok JSON kaçışı
	( Sözlük yeni koy: ['multiple: \" \\ \n \r \t'] konum: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} daha uzun ASCII metni
	( Sözlük yeni koy: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] konum: ['key'] ) ;
	# {"key":" value"} öndeki boşluk
	( Sözlük yeni koy: [' değer'] konum: ['key'] ) ;
	# {"key":"value "} sondaki boşluk
	( Sözlük yeni koy: ['değer '] konum: ['key'] ) ;
	# {"key":" \t\n\r "} boşluk karakterleri
	( Sözlük yeni koy: [' \t\n\r '] konum: ['key'] )
	.

sözlükler her: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (Sözlük yeni koy: d key konum: ['key']).
	>> b := JSON jsonify: (Sözlük yeni koy: ['value'] konum: d key).
	>> e := JSON nesne: a.
	>> f := JSON nesne: b.
	((e key = d key ve: (f ? d key = ['value'])) veya: (e key = ['NUL ?'])) doğru: {
		Çıktı yaz: ['OK'], yeni-satır.
	}, yoksa: {
		Çıktı yaz: ['Düzgün kodlanamadı/çözülemedi: '] + d + j, yeni-satır.
		Program bitir.
	}.
}.
