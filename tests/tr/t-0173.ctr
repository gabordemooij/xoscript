

Liste olunca: ['sum'] yap: {
	>> total := 0.
	kendi her: { :index :element
		total ekle: element.
	}. <- total.
}.

Liste olunca: ['product'] yap: {
	>> total := 1.
	kendi her: { :index :element
		total çarp: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program bellek-yönetimi: 0.

{

>> a := Liste ← ['hello'] ; ['world'] ; Doğru ; Hiç ; 666.
a := a + ( Liste ← 1 ).
Çıktı yaz: ( ['sum: '] + ( a sum ) ), yeni-satır.
Çıktı yaz: ( ['min: '] + ( a minimum ) ), yeni-satır.
Çıktı yaz: ( ['max: '] + ( a maksimum ) ), yeni-satır.
Çıktı yaz: ( ['3rd: '] + ( a ? 2 ) ), yeni-satır.
Çıktı yaz: ( ['prd: '] + ( a product ) ), yeni-satır.
a sırala: { :a :b <- (b - a). }.
a her: { :i :e Çıktı yaz: ( i - 0 ), yeni-satır. }.

} başlat.

Program temizle.
usedMemory1 := (Program bellek ? 0).


{

>> a := Liste ← ['hello'] ; ['world'] ; Doğru ; Hiç ; 666.
a := a + ( Liste ← 1 ).
Çıktı yaz: ( ['sum: '] + ( a sum ) ), yeni-satır.
Çıktı yaz: ( ['min: '] + ( a minimum ) ), yeni-satır.
Çıktı yaz: ( ['max: '] + ( a maksimum ) ), yeni-satır.
Çıktı yaz: ( ['3rd: '] + ( a ? 2 ) ), yeni-satır.
Çıktı yaz: ( ['prd: '] + ( a product ) ), yeni-satır.
a sırala: { :a :b <- (b - a). }.
a her: { :i :e Çıktı yaz: ( i - 0 ), yeni-satır. }.

} başlat.



Program temizle.
usedMemory2 := (Program bellek ? 0).


{

>> a := Liste ← ['hello'] ; ['world'] ; Doğru ; Hiç ; 666.
a := a + ( Liste ← 1 ).
Çıktı yaz: ( ['sum: '] + ( a sum ) ), yeni-satır.
Çıktı yaz: ( ['min: '] + ( a minimum ) ), yeni-satır.
Çıktı yaz: ( ['max: '] + ( a maksimum ) ), yeni-satır.
Çıktı yaz: ( ['3rd: '] + ( a ? 2 ) ), yeni-satır.
Çıktı yaz: ( ['prd: '] + ( a product ) ), yeni-satır.
a sırala: { :a :b <- (b - a). }.
a her: { :i :e Çıktı yaz: ( i - 0 ), yeni-satır. }.

} başlat.



Program temizle.
usedMemory3 := (Program bellek ? 0).

( usedMemory1 = usedMemory2 ve: usedMemory1 = usedMemory3, ve: usedMemory2 = usedMemory3 ) doğru: {
	Çıktı yaz: ['No memory leaks here'].
}, yanlış: {
	Çıktı yaz: ['Leaking memory...'].
}.
