

Liste olunca: ['toplamı'] yap: {
	>> toplam := 0.
	kendi her: { :indeks :eleman
		toplam ekle: eleman.
	}. <- toplam.
}.

Liste olunca: ['çarpım'] yap: {
	>> toplam := 1.
	kendi her: { :indeks :eleman
		toplam çarp: eleman.
	}. <- toplam.
}.

>> kullanılanBellek1 := 0.
>> kullanılanBellek2 := 0.
>> kullanılanBellek3 := 0.
>> kullanılanBellek4 := 0.

Program bellek-yönetimi: 0.

{

>> a := Liste ← ['hello'] ; ['world'] ; Doğru ; Hiç ; 666.
a := a + ( Liste ← 1 ).
Çıktı yaz: ( ['toplam: '] + ( a toplamı ) ), yeni-satır.
Çıktı yaz: ( ['en az: '] + ( a minimum ) ), yeni-satır.
Çıktı yaz: ( ['en çok: '] + ( a maksimum ) ), yeni-satır.
Çıktı yaz: ( ['3.: '] + ( a ? 2 ) ), yeni-satır.
Çıktı yaz: ( ['çarpım: '] + ( a çarpım ) ), yeni-satır.
a sırala: { :a :b <- (b - a). }.
a her: { :i :e Çıktı yaz: ( i - 0 ), yeni-satır. }.

} başlat.

Program temizle.
kullanılanBellek1 := (Program bellek ? 0).


