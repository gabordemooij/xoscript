# yakala-hepsi sınaması (pratik)
>> HTML := Metin yeni.
HTML olunca: ['encode:'] yap: { :tekst
	kendi sona-ekle: (tekst
	değiştir: ['&'] yenisi: ['&amp;'], 
	değiştir: ['<'] yenisi: ['&lt;'],
	değiştir: ['>'] yenisi: ['&gt;'],
	değiştir: ['"'] yenisi: ['&quot;']).
}.
>> blog := HTML yeni.
blog sona-ekle: ['<h1>'],
     encode: ['Koffie & Thee'],
     sona-ekle: ['</h1>'].
Çıktı yaz: blog, yeni-satır.


>> Romen := Sayı yeni.
Romen olunca: ['metinsi'] yap: {
	>> a := [''].
	{ a sona-ekle: ['I']. } × kendi. <- a.
}.

>> x := Romen yeni.
x ekle: 3.
Çıktı yaz: x metinsi, yeni-satır.

>> Kuantum := Mantıksal yeni.
Kuantum olunca: ['true?'] yap: { <- ['belki Doğru']. }.
Çıktı yaz: (Kuantum yeni true?), yeni-satır.

>> Nihil := Hiç yeni.
Nihil olunca: ['metin'] yap: { <- ['Nihil']. }.
Çıktı yaz: (Nihil yeni), yeni-satır.
