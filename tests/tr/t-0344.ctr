# catch-all test (practical)
>> HTML := Metin yeni.
HTML olunca: ['encode:'] yap: { :tekst
	kendi sona-ekle: (tekst
	değiştir: ['&'] yenisi: ['&amp;'], 
	değiştir: ['<'] yenisi: ['&lt;'],
	değiştir: ['>'] yenisi: ['&gt;'],
	değiştir: ['"'] yenisi: ['&quot;']).
}.
>> blog := HTML yeni.
blog sona-ekle: ['<h1>'],
     encode: ['Koffie & Thee'],
     sona-ekle: ['</h1>'].
Çıktı yaz: blog, yeni-satır.


>> Roman := Sayı yeni.
Roman olunca: ['stringy'] yap: {
	>> a := [''].
	{ a sona-ekle: ['I']. } × kendi. <- a.
}.

>> x := Roman yeni.
x ekle: 3.
Çıktı yaz: x stringy, yeni-satır.

>> Quantum := Mantıksal yeni.
Quantum olunca: ['true?'] yap: { <- ['maybe True']. }.
Çıktı yaz: (Quantum yeni true?), yeni-satır.

>> Nihil := Hiç yeni.
Nihil olunca: ['metin'] yap: { <- ['Nihil']. }.
Çıktı yaz: (Nihil yeni), yeni-satır.
