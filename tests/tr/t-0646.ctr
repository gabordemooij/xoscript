Server init.
Çıktı yaz: ['Database datetime test'], yeni-satır.

>> db := Maria-DB yeni sunucu-adı: ['localhost'],
	kullanıcı: ['xo'], 
	parola: ['pass123'],
	veritabanı-adı: ['xobase'],
	bağlan.

>> arama-parametreleri :=
db sorgu: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
getir: { :row
	Çıktı yaz: row datetimetest, yeni-satır.
}.
