Server init.
Çıktı yaz: ['Veritabanı tarih-saat testi'], yeni-satır.

>> vt := Maria-DB yeni sunucu-adı: ['localhost'],
	kullanıcı: ['xo'], 
	parola: ['pass123'],
	veritabanı-adı: ['xobase'],
	bağlan.

>> arama-parametreleri :=
vt sorgu: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
getir: { :kayıt
	Çıktı yaz: kayıt datetimetest, yeni-satır.
}.
