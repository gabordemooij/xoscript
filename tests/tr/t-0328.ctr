Program bellek-yönetimi: 4.

>> Doubler := Nesne yeni.
>> Multiplier := Nesne yeni.
Doubler olunca: ['double:and:'] yap: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier olunca: ['multiply:and:'] yap: { :x :y <- (x × y).
}.

Çıktı yaz: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), yeni-satır.
