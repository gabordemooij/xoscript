Server init.
>> fmt := Biçim yeni: ['%#3x'].

>> blob := Blob yeni: 4.
blob bytes: ( 
	Liste yeni ; 0 ; 1 ; 2 ; 3
).

>> file := Dosya yeni: ['/tmp/blob'].
file blob: blob.
blob serbest-bırak.

>> oku := file blob.
oku 
başlangıç: 0 
uzunluk: 4, 
yap her: { :i :b 
	Çıktı
	yaz: (fmt uygula-tamsayı: b),
	yeni-satır.
}.
oku serbest-bırak.
