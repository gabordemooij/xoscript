Sayı olunca: ['factorial'] yap: {
	>> total := 1.
	{ :index total çarp: (kendi - (index)). } × kendi. <- total.
}.
>> Printer := Nesne yeni.
Printer olunca: ['print:and:'] yap: { :x :y
	Çıktı yaz: ['a='] + x + [', b='] + y, yeni-satır.
}.
>> a := 4.5. >> b := a aşağı-yuvarla.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a yukarı-yuvarla.
Printer print: a and: b.
a := 4.5. b := a aşağı-yuvarla.
Printer print: a and: b.
a := 4.5. b := a yuvarla.
Printer print: a and: b.
a := 4.2. b := a yuvarla.
Printer print: a and: b.

