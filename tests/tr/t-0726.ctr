# test buffers PKI/Sign 
Server init.

>> long := ( Liste yeni doldur: 1000 değer: ['a'] ) birleştir: [''].

# sign a message
Çıktı yaz: ( 
	Kasa imzala: ['abc'] anahtar: long
), yeni-satır.

Çıktı yaz: ( 
	Kasa
		denetle: ['abc'] 
		imza: long 
		anahtar: long
), yeni-satır.

Çıktı yaz: (
	Kasa parola-özeti: long doğrula: long
), yeni-satır.
