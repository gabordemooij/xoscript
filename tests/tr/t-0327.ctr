

Liste olunca: ['fixture:'] yap: { :f
	öz fixture := f.
}.

Liste olunca: ['adet'] yap: { <- öz fixture.
}.

Liste olunca: ['aantal'] yap: { <- öz fixture.
}.


>> x := Hiç.
{

	x := ['hello'] 
	değiştir:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] karakter: 2)
			)
		)
	yenisi: (
		(['...hal'] + ['lo']) 
			büyük-harf 
			lowecase 
			büyük-harf 
			kaydır: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Liste ← 0 ; 1 ; 4; 9 ; (Liste ← 0 ; 3; 1) ; 4
							) sondan-ikinci
						) ? 1
					) + 
					((Liste ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					adet
				)
			)
	).

} × 10.
Çıktı yaz: x, yeni-satır.

