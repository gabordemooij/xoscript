


>> CoffeeMachine := Nesne yeni.
CoffeeMachine olunca: ['order:'] yap: { :id
	>> coffee := ['Americano'].
	( id = 1 ) doğru: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) doğru: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) doğru: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Nesne yeni.
SimpleCoffeeMachine olunca: ['order'] yap: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Çıktı yaz: redCup, yeni-satır.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Çıktı yaz: greenCup, yeni-satır.
>> yellowCup := CoffeeMachine order: 1.
Çıktı yaz: yellowCup, yeni-satır.
>> blueCup := CoffeeMachine order: 0.
Çıktı yaz: blueCup, yeni-satır.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Çıktı yaz: blackCup, yeni-satır.
blackCup sona-ekle: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Çıktı yaz: orangeCup, yeni-satır.
