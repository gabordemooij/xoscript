>> tekrarlayıcı := Nesne yeni.
tekrarlayıcı olunca: ['yanıtla:'] yap: { :ne
	Çıktı yaz: ne + [' '].
}.
tekrarlayıcı olunca: ['yanıtla:ve:'] yap: { :ne :say
	Çıktı yaz: ne, yaz: say + [' '].
}.
tekrarlayıcı olunca: ['yanıtla:ve:ve:'] yap: { :ne :say :dahası
	Çıktı yaz: ne, yaz: say, yaz: dahası.
}.
tekrarlayıcı tekrarla.
tekrarlayıcı everything: ['Ben derim.'].
tekrarlayıcı and: ['I '] everything: ['yaparım.'].
