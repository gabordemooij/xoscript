>> repeater := Nesne yeni.
repeater olunca: ['yanıtla:'] yap: { :what
	Çıktı yaz: what + [' '].
}.
repeater olunca: ['yanıtla:ve:'] yap: { :what :say
	Çıktı yaz: what, yaz: say + [' '].
}.
repeater olunca: ['yanıtla:ve:ve:'] yap: { :what :say :more
	Çıktı yaz: what, yaz: say, yaz: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
