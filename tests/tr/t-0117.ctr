>> t := Doğru.
(t = Doğru) doğru: { Çıktı yaz: ['T']. }.
(t = Yanlış) doğru: { Çıktı yaz: ['F']. }.
Çıktı yaz: ['|'].
>> t := Yanlış.
(t = Doğru) doğru: { Çıktı yaz: ['T']. }.
(t = Yanlış) doğru: { Çıktı yaz: ['F']. }.
Çıktı yaz: ['|'].
>> f := Doğru.
(t = Doğru ve: f = Yanlış) doğru: { Çıktı yaz: ['T']. }.
(t = Yanlış ve: f = Doğru) doğru: { Çıktı yaz: ['F']. }.
Çıktı yaz: ['|'].
>> n := Hiç.
(n Hiç?) doğru: { Çıktı yaz: ['T']. }.
(n Hiç?) yanlış: { Çıktı yaz: ['F']. }.
Çıktı yaz: ['|'].
(f Boolean?) doğru: { Çıktı yaz: ['T']. }.
(f Boolean?) yanlış: { Çıktı yaz: ['F']. }.



