

# create a 64-bit integer for exact calculations
>> a := Int64 metinden: ['123'].

# to string
Çıktı yaz: a, yeni-satır.

# divide
Çıktı yaz: a / (Int64 metinden: ['3']), yeni-satır.

# multiply
Çıktı yaz: a * (Int64 metinden: ['2']), yeni-satır.

# add
Çıktı yaz: a + (Int64 metinden: ['1']), yeni-satır.

# subtract
Çıktı yaz: a - (Int64 metinden: ['2']), yeni-satır.

# compare
Çıktı yaz: ( a =   (Int64 metinden: ['123'])), yeni-satır.
Çıktı yaz: ( a !=: (Int64 metinden: ['124'])), yeni-satır.
Çıktı yaz: ( a <   (Int64 metinden: ['124'])), yeni-satır.
Çıktı yaz: ( a >   (Int64 metinden: ['122'])), yeni-satır.
Çıktı yaz: ( a >=: (Int64 metinden: ['123'])), yeni-satır.
Çıktı yaz: ( a <=: (Int64 metinden: ['123'])), yeni-satır.





	