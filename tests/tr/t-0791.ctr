Server init.

>> DB := Maria-DB yeni sunucu-adı: ['localhost'],
	kullanıcı: ['xo'],
	parola: ['pass123'],
	veritabanı-adı: ['xobase'],
	bağlan.
	
>> SQL := ['SELECT "hello" AS "world" '].

# sorguyu elle oluştur
>> arama-parametreleri := Maria-Sorgu yeni: SQL.

# veritabanını ayarla
arama-parametreleri veritabanı: DB.

arama-parametreleri getir: { :kayıt
	Çıktı yaz: kayıt world, yeni-satır.
}.
