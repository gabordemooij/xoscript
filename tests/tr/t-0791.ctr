Server init.

>> DB := Maria-DB yeni sunucu-adı: ['localhost'],
	kullanıcı: ['xo'],
	parola: ['pass123'],
	veritabanı-adı: ['xobase'],
	bağlan.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> arama-parametreleri := Maria-Sorgu yeni: SQL.

# set database
arama-parametreleri veritabanı: DB.

arama-parametreleri getir: { :row
	Çıktı yaz: row world, yeni-satır.
}.
