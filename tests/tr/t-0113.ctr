Çıktı yaz: ['Continue for-loop, No - before 6 and up.'], yeni-satır.
{ :i
	Çıktı yaz: (i + 1), yeni-satır.
	((i + 1) > 4) devam-et.
	Çıktı yaz: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Çıktı yeni-satır.
Çıktı yaz: ['Continue while-true, No --> before 5 and up.'], yeni-satır.
{
	Çıktı yaz: ['iteration #'] + x, yeni-satır.
	x ekle: 1.
	((x < 5) değil) devam-et.
	Çıktı yaz: ['-->'].
} sürece: xIsLessThan10.
Çıktı yeni-satır.
Çıktı yaz: ['Continue while-false, No - before 3 only.'], yeni-satır.
{
	Çıktı yaz: ['iteration #'] + x, yeni-satır.
	x çıkar: 1.
	(x = 3) devam-et.
	Çıktı yaz: ['-'].
} sürece: { <- ( x > 0). }.

Çıktı yeni-satır.
Çıktı yaz: ['Continue times-loop, No ||| before 3.'], yeni-satır.
{ :i
	Çıktı yaz: ['iteration #'] + i, yeni-satır.
	(i = 2) devam-et.
	Çıktı yaz: ['|||'].
} × 5.

Çıktı yeni-satır.

{ Doğru devam-et. Çıktı yaz: ['dont write this!'], yeni-satır. } başlat.

{ Doğru devam-et. Çıktı yaz: ['dont write this!'], yeni-satır. } yakala: { Çıktı yaz: ['Dont catch this!']. }, başlat.

Çıktı yaz: ['Test Array each-loop: 0, ... ,2'], yeni-satır.
(Liste ← 1 ; 2 ; 3) dönüştür: { :i
	(i = 1) devam-et.
	Çıktı yaz: ['iteration #'] + (i - 0), yeni-satır.
}.

Çıktı yaz: ['Test Map each-loop: c only'], yeni-satır.
>> m := Sözlük yeni.
m koy: ['first'] konum: ['a'], koy: ['second'] konum: ['b'], koy: ['third'] konum: ['c'].
m her: { :k :v
	(k ≠ ['c']) devam-et.
	Çıktı yaz: ['iteration'] + k + v, yeni-satır.
}.

