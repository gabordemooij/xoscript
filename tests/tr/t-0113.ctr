Çıktı yaz: ['For döngüsüne devam, Hayır - 6 ve üstünden önce.'], yeni-satır.
{ :i
	Çıktı yaz: (i + 1), yeni-satır.
	((i + 1) > 4) devam-et.
	Çıktı yaz: ['-'].
} × 10.

>> x := 0.
>> x10danKüçük := { <- ( x < 10 ). }.
Çıktı yeni-satır.
Çıktı yaz: ['Doğru-sürece devam, Hayır --> 5 ve üstünden önce.'], yeni-satır.
{
	Çıktı yaz: ['iteration #'] + x, yeni-satır.
	x ekle: 1.
	((x < 5) değil) devam-et.
	Çıktı yaz: ['-->'].
} sürece: x10danKüçük.
Çıktı yeni-satır.
Çıktı yaz: ['Yanlış-sürece devam, Hayır - yalnızca 3'ten önce.'], yeni-satır.
{
	Çıktı yaz: ['iteration #'] + x, yeni-satır.
	x çıkar: 1.
	(x = 3) devam-et.
	Çıktı yaz: ['-'].
} sürece: { <- ( x > 0). }.

Çıktı yeni-satır.
Çıktı yaz: ['Kez döngüsüne devam, Hayır ||| 3'ten önce.'], yeni-satır.
{ :i
	Çıktı yaz: ['iteration #'] + i, yeni-satır.
	(i = 2) devam-et.
	Çıktı yaz: ['|||'].
} × 5.

Çıktı yeni-satır.

{ Doğru devam-et. Çıktı yaz: ['bunu yazma!'], yeni-satır. } başlat.

{ Doğru devam-et. Çıktı yaz: ['bunu yazma!'], yeni-satır. } yakala: { Çıktı yaz: ['Bunu yakalama!']. }, başlat.

Çıktı yaz: ['Liste her-döngüsü testi: 0, ... ,2'], yeni-satır.
(Liste ← 1 ; 2 ; 3) dönüştür: { :i
	(i = 1) devam-et.
	Çıktı yaz: ['iteration #'] + (i - 0), yeni-satır.
}.

Çıktı yaz: ['Sözlük her-döngüsü testi: yalnızca c'], yeni-satır.
>> m := Sözlük yeni.
m koy: ['first'] konum: ['a'], koy: ['second'] konum: ['b'], koy: ['üçüncü'] konum: ['c'].
m her: { :k :v
	(k ≠ ['c']) devam-et.
	Çıktı yaz: ['iteration'] + k + v, yeni-satır.
}.

