# test number -> string -> number
{

	>> x := Sayı arasında: 0 ve: 1000000.
	>> d := Sayı arasında: 1 ve: 7.
	>> e := 10 üs: d.

	x böl-sayıya: e.
	>> y := x metin sayı.

	(x = y) yanlış: {
		Çıktı yaz: x, yeni-satır.
		Çıktı yaz: y, yeni-satır.
		Program bitir.
	}.

} * 1000.
Çıktı yaz: ['OK'], yeni-satır.