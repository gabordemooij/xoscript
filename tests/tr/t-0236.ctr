>> Slurp := Nesne yeni.
Slurp olunca: ['yeni'] yap: {
	öz str := [''].
}.


Slurp olunca: ['yanıtla:'] yap: { :blah
		(öz str ≠ ['']) doğru: {
			öz str sona-ekle: [' '].
		}.
		öz str sona-ekle: blah.
}.
Slurp olunca: ['yanıtla:ve:'] yap: { :blah :blahah
		(öz str ≠ ['']) doğru: {
			öz str sona-ekle: [' '].
		}.
		(blah uzunluk > 1) doğru: {
			öz str sona-ekle: (blah başlangıç: 0 uzunluk: (blah uzunluk - 1)).
		}, yoksa: {
			öz str sona-ekle: blah.
		}.
		öz str sona-ekle: [' '].
		öz str sona-ekle: blahah.
}.
Slurp olunca: ['edin'] yap: {
	>> tampon := öz str.
	öz str := ['']. <- tampon.
}.

>> arama-parametreleri := Slurp yeni.
arama-parametreleri select: ['*'], from kullanıcılar where: ['id = 2'].
Çıktı yaz: (arama-parametreleri edin), yeni-satır.
