# çok uzun çözülen kasa anahtarları ve imzalar yığını taşırmamalı
Server init.

>> anahtarlar := Kasa anahtar-üret.
>> sk := anahtarlar ilk.
>> pk := anahtarlar sonuncu.
>> imza := Kasa imzala: ['abc'] anahtar: sk.

# dolgusuz 88 karakter 66 bayta çözülür
>> uzun := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# dolgusuz 44 karakter 33 bayta çözülür
>> kısa := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Kasa imzala: ['abc'] anahtar: uzun. } yakala: { :e
	Çıktı yaz: e, yeni-satır.
}, başlat.

{ Kasa denetle: ['abc'] imza: uzun anahtar: pk. } yakala: { :e
	Çıktı yaz: e, yeni-satır.
}, başlat.

{ Kasa denetle: ['abc'] imza: imza anahtar: kısa. } yakala: { :e
	Çıktı yaz: e, yeni-satır.
}, başlat.
