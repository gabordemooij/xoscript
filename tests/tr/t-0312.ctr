>> Slurp := Nesne yeni.
Slurp olunca: ['yeni'] yap: {
	öz str := [''].
}.
Slurp öğren: ['nieuw'] anlamı: ['yeni'].
Slurp olunca: ['yanıtla:'] yap: { :blah
		(öz str ≠ ['']) doğru: {
			öz str sona-ekle: [' '].
		}.
		öz str sona-ekle: blah.
}.
Slurp olunca: ['yanıtla:ve:'] yap: { :blah :blahah
		(öz str ≠ ['']) doğru: {
			öz str sona-ekle: [' '].
		}.
		(blah uzunluk > 1) doğru: {
			öz str sona-ekle: (blah başlangıç: 0 uzunluk: (blah uzunluk - 1)).
		}, yoksa: {
			öz str sona-ekle: blah.
		}.
		öz str sona-ekle: [' '].
		öz str sona-ekle: blahah.
}.
Slurp olunca: ['obtain'] yap: {
	>> buffer := öz str.
	öz str := ['']. <- buffer.
}.


>> arama-parametreleri := Slurp yeni
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

Çıktı yaz: arama-parametreleri obtain, yeni-satır.
