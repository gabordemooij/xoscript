Metin olunca: ['html'] yap: { <- (
		kendi
		değiştir: ['&'] yenisi: ['&amp;'],
		değiştir: ['<'] yenisi: ['&lt;'],
		değiştir: ['>'] yenisi: ['&gt;'],
		değiştir: ['''] yenisi: ['&apos;'],
		değiştir: ['"'] yenisi: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program bellek-yönetimi: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Çıktı yaz: txt kopyala html, yeni-satır.
Çıktı yaz: txt kopyala küçük-harf, yeni-satır.
Çıktı yaz: txt kopyala büyük-harf, yeni-satır.
} başlat.

Program temizle.

usedMemory1 := (Program bellek ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Çıktı yaz: txt kopyala html, yeni-satır.
Çıktı yaz: txt kopyala küçük-harf, yeni-satır.
Çıktı yaz: txt kopyala büyük-harf, yeni-satır.
} başlat.

Program temizle.
usedMemory2 := (Program bellek ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Çıktı yaz: txt kopyala html, yeni-satır.
Çıktı yaz: txt kopyala küçük-harf, yeni-satır.
Çıktı yaz: txt kopyala büyük-harf, yeni-satır.
} başlat.

Program temizle.
usedMemory3 := (Program bellek ? 0).



( usedMemory1 = usedMemory2 ve: usedMemory1 = usedMemory3, ve: usedMemory2 = usedMemory3 ) doğru: {
	Çıktı yaz: ['No memory leaks here'].
}, yanlış: {
	Çıktı yaz: ['Leaking memory...'].
}.
