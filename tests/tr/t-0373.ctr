# compliance test

# use international numbers

Çıktı yaz: ['1000 -> '].
Çıktı yaz: 1000, yeni-satır. #1000

Çıktı yaz: ['1.5 -> '].
Çıktı yaz: 1.5, yeni-satır.  #1.5

Çıktı yaz: ['1001.5 -> '].
Çıktı yaz: 1.5 + 1000, yeni-satır. #1001.5

# use 0-indexed arrays
>> x := Liste yeni ; 1 ; 2 ; 3.
>> y := Liste yeni ; ['a'] ; ['b'] ; ['c'].

Çıktı yaz: ['1 -> '].
Çıktı yaz: x ? 0, yeni-satır. #1

Çıktı yaz: ['1 -> '].
Çıktı yaz: (x konum: 0), yeni-satır. #1

Çıktı yaz: ['1 -> '].
Çıktı yaz: x ilk, yeni-satır. #1

Çıktı yaz: ['3 -> '].
Çıktı yaz: x sonuncu, yeni-satır. #3

Çıktı yaz: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Çıktı yaz: (x göre: y), yeni-satır.

Çıktı yaz: ['1 -> '].
Çıktı yaz: (x başlangıç: 0 uzunluk: 1) ilk, yeni-satır. #1

Çıktı yaz: ['0 -> '].
Çıktı yaz: (x bul: 1), yeni-satır. #0

x koy: 9 konum: 0.

Çıktı yaz: ['9 -> '].
Çıktı yaz: (x konum: 0), yeni-satır. #9

x başa-ekle: 8.
Çıktı yaz: ['8 -> '].
Çıktı yaz: (x konum: 0), yeni-satır. #9


x sona-ekle: 10.
Çıktı yaz: ['10 -> '].
Çıktı yaz: (x konum: 4), yeni-satır. #10








