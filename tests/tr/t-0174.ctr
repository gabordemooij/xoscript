


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program bellek-yönetimi: 0.
>> palette := Hiç.
>> colors := Hiç.

{
palette := Sözlük yeni.
palette 
	koy: ['#F00'] konum: ['red'],
	koy: ['#0F0'] konum: ['green'],
	koy: ['#00F'] konum: ['blue'].
Çıktı yaz: ['number of RGB codes in palette: '] + ( palette adet ), yeni-satır.
Çıktı yaz: ['RGB code of green is: '] + ( palette ? ['green'] ), yeni-satır.
colors := [''].
( palette her: { :ad :kod
		colors := colors + ( ad + [':'] + kod ).
} ).
Çıktı yaz: ['All colors in palette: '] + colors, yeni-satır.
} başlat.
Program temizle.
usedMemory1 := (Program bellek ? 0).

