


>> kullanılanBellek1 := 0.
>> kullanılanBellek2 := 0.
>> kullanılanBellek3 := 0.
>> kullanılanBellek4 := 0.

Program bellek-yönetimi: 0.
>> palet := Hiç.
>> renkler := Hiç.

{
palet := Sözlük yeni.
palet 
	koy: ['#F00'] konum: ['kırmızı'],
	koy: ['#0F0'] konum: ['yeşil'],
	koy: ['#00F'] konum: ['mavi'].
Çıktı yaz: ['paletteki RGB kodu sayısı: '] + ( palet adet ), yeni-satır.
Çıktı yaz: ['yeşilin RGB kodu: '] + ( palet ? ['yeşil'] ), yeni-satır.
renkler := [''].
( palet her: { :ad :kod
		renkler := renkler + ( ad + [':'] + kod ).
} ).
Çıktı yaz: ['Paletteki tüm renkler: '] + renkler, yeni-satır.
} başlat.
Program temizle.
kullanılanBellek1 := (Program bellek ? 0).

