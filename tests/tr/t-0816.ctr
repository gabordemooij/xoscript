# bir biçim değerin türüne uymalı, tür bir istemciden gelebilir
>> dene := { :biçimlendirme :value
	{ Çıktı yaz: ( (Biçim yeni: biçimlendirme) uygula: value ), yeni-satır. } yakala: { :e Çıktı yaz: e, yeni-satır. }, başlat.
}.
>> dene-tamsayı := { :biçimlendirme :value
	{ Çıktı yaz: ( (Biçim yeni: biçimlendirme) uygula-tamsayı: value ), yeni-satır. } yakala: { :e Çıktı yaz: e, yeni-satır. }, başlat.
}.

# uyar
dene uygula: ['|%s|'] ve: ['text'].
dene uygula: ['%06.2f'] ve: 5.5.
dene uygula: ['100%% %s'] ve: ['tabii'].
dene-tamsayı uygula: ['%03d'] ve: 7.
dene-tamsayı uygula: ['%x'] ve: 255.
dene uygula: ['%d'] ve: (Int64 yeni metinden: ['12']).
dene uygula: ['%lld'] ve: (Int64 yeni metinden: ['12']).
dene uygula: ['%.1lf'] ve: 5.5.
dene-tamsayı uygula: ['%hd'] ve: 7.

# uymaz
dene uygula: ['%s'] ve: 12345.
dene uygula: ['%d'] ve: 12345.
dene uygula: ['%f'] ve: ['text'].
dene-tamsayı uygula: ['%d'] ve: ['text'].
dene-tamsayı uygula: ['%s'] ve: 5.
dene uygula: ['%s %s'] ve: ['text'].
dene uygula: ['%n'] ve: ['text'].
dene uygula: ['%*s'] ve: ['text'].
dene uygula: ['%'] ve: ['text'].

# uzunluk değiştiricisi uymaz
dene uygula: ['%ls'] ve: ['text'].
dene uygula: ['%Lf'] ve: 5.5.
dene-tamsayı uygula: ['%ld'] ve: 7.
dene-tamsayı uygula: ['%lld'] ve: 7.
dene uygula: ['%Ld'] ve: (Int64 yeni metinden: ['12']).

# printf'e uymayan bir genişlik çökme değil hata vermeli
dene uygula: ['%99999999999s'] ve: ['text'].
