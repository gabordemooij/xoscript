Sayı olunca: ['faktöriyel'] yap: {
	>> toplam := 1.
	{ :indeks toplam çarp: (kendi - indeks). } × kendi. <- toplam.
}.

>> kullanılanBellek1 := 0.
>> kullanılanBellek2 := 0.
>> kullanılanBellek3 := 0.
>> kullanılanBellek4 := 0.

Program bellek-yönetimi: 0.

{
2 üstel faktöriyel.
Çıktı yaz: (11 kalan: 3), yeni-satır.
Çıktı yaz: (3.4 yuvarla), yeni-satır.
Çıktı yaz: (7.1 yukarı-yuvarla), yeni-satır.
Çıktı yaz: (7.9 aşağı-yuvarla), yeni-satır.
}
başlat.

Program temizle.

kullanılanBellek1 := (Program bellek ? 0).

{
2 üstel faktöriyel.
Çıktı yaz: (11 kalan: 3), yeni-satır.
Çıktı yaz: (3.4 yuvarla), yeni-satır.
Çıktı yaz: (7.1 yukarı-yuvarla), yeni-satır.
Çıktı yaz: (7.9 aşağı-yuvarla), yeni-satır.
}
başlat.

Program temizle.
kullanılanBellek2 := (Program bellek ? 0).


{
2 üstel faktöriyel.
Çıktı yaz: (11 kalan: 3), yeni-satır.
Çıktı yaz: (3.4 yuvarla), yeni-satır.
Çıktı yaz: (7.1 yukarı-yuvarla), yeni-satır.
Çıktı yaz: (7.9 aşağı-yuvarla), yeni-satır.
} başlat.

Program temizle.
kullanılanBellek3 := (Program bellek ? 0).



( kullanılanBellek1 = kullanılanBellek2 ve: kullanılanBellek1 = kullanılanBellek3, ve: kullanılanBellek2 = kullanılanBellek3 ) doğru: {
	Çıktı yaz: ['Burada bellek sızıntısı yok'].
}, yanlış: {
	Çıktı yaz: ['Bellek sızıyor...'].
}.
