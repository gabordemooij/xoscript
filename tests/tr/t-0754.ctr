Çıktı yaz: ['Test object'], yeni-satır.
>> a := Nesne yeni. 

a olunca: ['item:'] yap: { :out
	öz out := out. 
}.

a olunca: ['item'] yap: { <- öz out.
}.

a olunca: ['greet'] yap: {
	Çıktı yaz: ['hi from original out!'], yeni-satır.
}.

a item: Çıktı.

Çıktı yaz: a item, yeni-satır.

>> old-out-address := a item prototip bellek-adresi.
a save-as: ['/tmp/a.bin'].
Çıktı yaz: ['========== RELOADING SNAP:'], yeni-satır.

>> b := Nesne load-from: ['/tmp/a.bin'].

(b item prototip bellek-adresi = old-out-address) doğru: {
	Çıktı yaz: ['Object link re-attached.'], yeni-satır.
}.

b item yaz: ['hello from loaded out!'], yeni-satır.
b greet.
