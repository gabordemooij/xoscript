Çıktı yaz: ['Test nesnesi'], yeni-satır.
>> a := Nesne yeni. 

a olunca: ['item:'] yap: { :out
	öz out := out. 
}.

a olunca: ['öğe'] yap: {
	<- öz out.
}.

a olunca: ['selamla'] yap: {
	Çıktı yaz: ['orijinal çıktıdan selam!'], yeni-satır.
}.

a item: Çıktı.

Çıktı yaz: a öğe, yeni-satır.

>> eski-out-adresi := a öğe prototip bellek-adresi.
a save-as: ['/tmp/a.bin'].
Çıktı yaz: ['========== SNAP YENİDEN YÜKLENİYOR:'], yeni-satır.

>> b := Nesne load-from: ['/tmp/a.bin'].

(b öğe prototip bellek-adresi = eski-out-adresi) doğru: {
	Çıktı yaz: ['Nesne bağlantısı yeniden bağlandı.'], yeni-satır.
}.

b öğe yaz: ['yüklenen çıktıdan merhaba!'], yeni-satır.
b selamla.
