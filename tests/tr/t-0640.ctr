
Server init.
Çıktı yaz: ['Database test'], yeni-satır.

>> db := Maria-DB yeni sunucu-adı: ['localhost'],
	kullanıcı: ['xo'], 
	parola: ['pass123'],
	veritabanı-adı: ['xobase'],
	bağlan.

>> arama-parametreleri :=
db sorgu: ['SELECT UNHEX('CAFE') AS blobby'],
getir: { :row
	Çıktı yaz: ( row blobby başlangıç: 0 uzunluk: 2 ), yeni-satır.
	row blobby serbest-bırak.
}.
