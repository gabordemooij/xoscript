['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Çıktı yaz: (x + y), yeni-satır.

>> x := 10040.07.
>> y := 10305.60.

Çıktı yaz: (x + y), yeni-satır.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Çıktı yaz: (x + y + z), yeni-satır.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Çıktı yaz: (x + y + z), yeni-satır.

>> q := 0.1.2.

Çıktı yaz: (q), yeni-satır.

>> q := 012.

Çıktı yaz: (q), yeni-satır.
