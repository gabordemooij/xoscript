Çıktı yaz: ['Test object'], yeni-satır.
>> a := Nesne yeni. 

a olunca: ['item:'] yap: { :binhelper
	öz binhelper := binhelper. 
}.

a olunca: ['item'] yap: { <- öz binhelper.
}.

a item: Bin yeni.

>> old-binhelper-address := a item prototip bellek-adresi.
a save-as: ['/tmp/a.bin'].
Çıktı yaz: ['========== RELOADING SNAP:'], yeni-satır.

>> b := Nesne load-from: ['/tmp/a.bin'].

(b item prototip bellek-adresi = old-binhelper-address) doğru: {
	Çıktı yaz: ['Object link re-attached.'], yeni-satır.
}.


