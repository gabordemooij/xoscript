Çıktı yaz: ['Test nesnesi'], yeni-satır.
>> a := Nesne yeni. 

a olunca: ['item:'] yap: { :binhelper
	öz binhelper := binhelper. 
}.

a olunca: ['öğe'] yap: {
	<- öz binhelper.
}.

a item: Bin yeni.

>> eski-binhelper-adresi := a öğe prototip bellek-adresi.
a save-as: ['/tmp/a.bin'].
Çıktı yaz: ['========== SNAP YENİDEN YÜKLENİYOR:'], yeni-satır.

>> b := Nesne load-from: ['/tmp/a.bin'].

(b öğe prototip bellek-adresi = eski-binhelper-adresi) doğru: {
	Çıktı yaz: ['Nesne bağlantısı yeniden bağlandı.'], yeni-satır.
}.


