>> Nokta := Nesne yeni.
Nokta olunca: ['x-coordinate:'] yap: { :x öz x := x. }.
Nokta olunca: ['y-coordinate:'] yap: { :y öz y := y. }.
Nokta olunca: ['x-koordinatı']  yap: { <- öz x kopyala. }.
Nokta olunca: ['y-koordinatı']  yap: { <- öz y kopyala. }.

Nokta olunca: ['='] yap: { :diğeri
	<- ( öz x = diğeri x-koordinatı
		 ve: öz y = diğeri y-koordinatı ).
}.

>> iskele := Nokta yeni x-coordinate: 5, y-coordinate: 6.
>> belediye-binası := Nokta yeni x-coordinate: 7, y-coordinate: 1.
>> lokanta := Nokta yeni x-coordinate: 5, y-coordinate: 6.

Çıktı yaz: iskele = belediye-binası, yeni-satır.
Çıktı yaz: iskele = lokanta, yeni-satır.
