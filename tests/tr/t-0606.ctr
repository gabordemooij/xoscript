>> Point := Nesne yeni.
Point olunca: ['x-coordinate:'] yap: { :x öz x := x. }.
Point olunca: ['y-coordinate:'] yap: { :y öz y := y. }.
Point olunca: ['x-coordinate']  yap: { <- öz x kopyala. }.
Point olunca: ['y-coordinate']  yap: { <- öz y kopyala. }.

Point olunca: ['='] yap: { :other <- ( öz x = other x-coordinate
		 ve: öz y = other y-coordinate ).
}.

>> pier := Point yeni x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point yeni x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point yeni x-coordinate: 5, y-coordinate: 6.

Çıktı yaz: pier = town-hall, yeni-satır.
Çıktı yaz: pier = restaurant, yeni-satır.
