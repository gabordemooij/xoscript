# utf16le/be veya utf32le/be'den utf8'e kod çöz
Server init.
>> utf16 := Blob yeni: 8, bytes: (
	Liste yeni ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Çıktı yaz: ( utf16 kod-çöz: ['utf16le'] ), yeni-satır.

utf16 serbest-bırak.
>> utf32 := Blob yeni: 13, bytes: (
	Liste yeni ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Çıktı yaz: ( utf32 kod-çöz: ['utf32be'] ), yeni-satır.
utf32 serbest-bırak.