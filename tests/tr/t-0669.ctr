# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Kasa 
	parola-özeti: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Kasa 
	parola-özeti: hash doğrula: a1.
	# fail 
>> b := Kasa
	parola-özeti: hash doğrula: a2.
	# ok!

Çıktı yaz: a, yeni-satır.
Çıktı yaz: b, yeni-satır.

