>> Selamlayıcı := Nesne yeni.
Selamlayıcı olunca: ['yarat'] yap: {
	>> selamlayıcı := Nesne yeni.
	selamlayıcı olunca: ['name:'] yap: { :ad
		Çıktı yaz: ['bir isim ayarlanıyor'].
		öz adım := ad.
	}.
	selamlayıcı olunca: ['selamVer'] yap: {
		Çıktı yaz: ['Hello'].
		Çıktı yaz: öz adım.
	}.
	selamlayıcı olunca: ['selamla'] yap: {
		kendi selamVer.
	}. <- selamlayıcı.
}.
>> selamlayıcı := Selamlayıcı yarat.
selamlayıcı name: ['güneş ışığı!'].
selamlayıcı selamla.
