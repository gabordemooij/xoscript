>> Greeter := Nesne yeni.
Greeter olunca: ['make'] yap: {
	>> greeter := Nesne yeni.
	greeter olunca: ['name:'] yap: { :ad
		Çıktı yaz: ['setting a name'].
		öz myName := ad.
	}.
	greeter olunca: ['performGreeting'] yap: {
		Çıktı yaz: ['Hello'].
		Çıktı yaz: öz myName.
	}.
	greeter olunca: ['greet'] yap: {
		kendi performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
