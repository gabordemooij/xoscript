Server init.
>> f := Biçim yeni: ['%d'].
>> a := Blob yeni: 4.
a bytes: ( Liste yeni ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob yeni: 4.
b bytes: ( Liste yeni ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a başlangıç: 0 uzunluk: 3, her: { :i :byte
	Çıktı yaz: ( f uygula-tamsayı: byte ) , yeni-satır.
}.
a ^ b.
a başlangıç: 0 uzunluk: 3, her: { :i :byte
	Çıktı yaz: ( f uygula-tamsayı: byte ) , yeni-satır.
}.
a ^ b.
a başlangıç: 0 uzunluk: 3, her: { :i :byte
	Çıktı yaz: ( f uygula-tamsayı: byte ) , yeni-satır.
}.
a serbest-bırak.
b serbest-bırak.

{ a ^ Nesne. } yakala: { :e Çıktı yaz: e, yeni-satır. }, başlat.
