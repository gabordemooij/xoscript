
>> dictionary := (
	Sözlük yeni
		koy: ['b'] konum: ['a'],
		koy: ['a'] konum: ['b'],
		koy: ['z'] konum: ['x'],
		koy: ['hello'] konum: ['hallo'],
		koy: ['human'] konum: ['human']
).

>> comparisons := Liste yeni.
dictionary her: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a karşılaştır: b)
	).
}.

comparisons sırala: { :a :b <- ( a karşılaştır: b ). }.
Çıktı yaz: ( comparisons birleştir: ['↵'] ), yeni-satır.
comparisons birleştir: ['↵'].
