
>> sözlük := (
	Sözlük yeni
		koy: ['b'] konum: ['a'],
		koy: ['a'] konum: ['b'],
		koy: ['z'] konum: ['x'],
		koy: ['hello'] konum: ['hallo'],
		koy: ['insan'] konum: ['insan']
).

>> karşılaştırmalar := Liste yeni.
sözlük her: { :a :b
	karşılaştırmalar ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a karşılaştır: b)
	).
}.

karşılaştırmalar sırala: { :a :b <- ( a karşılaştır: b ). }.
Çıktı yaz: ( karşılaştırmalar birleştir: ['↵'] ), yeni-satır.
karşılaştırmalar birleştir: ['↵'].
