
Metin olunca: ['html'] yap: { <- (
		kendi
		değiştir: ['&'] yenisi: ['&amp;'],
		değiştir: ['<'] yenisi: ['&lt;'],
		değiştir: ['>'] yenisi: ['&gt;'],
		değiştir: ['"'] yenisi: ['&quot;']
	).
}.

>> HtmlFırçası := Nesne yeni.

HtmlFırçası olunca: ['yanıtla:'] yap: { :etiket
	Çıktı yaz: (['<tag>↵'] tag: etiket ).
}.

HtmlFırçası olunca: ['yanıtla:ve:'] yap: { :etiket :content
	etiket := ( etiket başlangıç: 0 uzunluk: (etiket uzunluk - 1) ).
	Çıktı yaz: (['<tag content>↵'] tag: etiket, content: content).
}.

HtmlFırçası olunca: ['content:'] yap: { :yazı
	Çıktı yaz: yazı html, yeni-satır.
}.

HtmlFırçası olunca: ['öznitelik:değer:'] yap: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlFırçası yeni.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h öznitelik: ['class'] değer: ['bold']),
		/span
	/body
/html.
		
