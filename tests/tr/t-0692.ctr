Server init.

Çıktı yaz: (
	Desen yeni: ['^\\w+$'],
	eşleş: ['test@example.com'] 
), yeni-satır. # 0 match, fails on @ and .

Çıktı yaz: (
	Desen yeni: ['^[^@]+@[^\.]+\.\\w+$'],
	eşleş: ['test@example.com'] 
), yeni-satır. # 1 match

Çıktı yaz: (
	Desen yeni: ['[^@]+@[^\.]+\.\\w+'],
	eşleş: ['test@example.com'] 
), yeni-satır. # 1 match

Çıktı yaz: (
	Desen yeni: ['([^@]+)@([^\.]+)\.\\w+'],
	eşleş: ['test@example.com'] 
), yeni-satır. # 1 match, groups dont matter

Çıktı yaz: (
	Desen yeni: ['[a-z]'],
	eşleş: ['test@example.com'] 
), yeni-satır. # 14 matches

Çıktı yaz: (
	Desen yeni: ['.*'],
	eşleş: ['test@example.com'] 
), yeni-satır. # 1 match (all)

Çıktı yaz: (
	Desen yeni: ['(.*)'],
	eşleş: ['test@example.com'] 
), yeni-satır. # 1 match (all)

Çıktı yaz: (
	Desen yeni: ['\\s*[^@]+@[^\.]+\.\\w+'],
	eşleş: ['test@example.com'] 
), yeni-satır. # 1 match, prefix space optional, gets ignored