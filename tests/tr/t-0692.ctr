Server init.

Çıktı yaz: (
	Desen yeni: ['^\\w+$'],
	eşleş: ['test@example.com'] 
), yeni-satır. # 0 eşleşme, @ ve . üzerinde başarısız

Çıktı yaz: (
	Desen yeni: ['^[^@]+@[^\.]+\.\\w+$'],
	eşleş: ['test@example.com'] 
), yeni-satır. # 1 eşleşme

Çıktı yaz: (
	Desen yeni: ['[^@]+@[^\.]+\.\\w+'],
	eşleş: ['test@example.com'] 
), yeni-satır. # 1 eşleşme

Çıktı yaz: (
	Desen yeni: ['([^@]+)@([^\.]+)\.\\w+'],
	eşleş: ['test@example.com'] 
), yeni-satır. # 1 eşleşme, gruplar önemli değil

Çıktı yaz: (
	Desen yeni: ['[a-z]'],
	eşleş: ['test@example.com'] 
), yeni-satır. # 14 eşleşme

Çıktı yaz: (
	Desen yeni: ['.*'],
	eşleş: ['test@example.com'] 
), yeni-satır. # 1 eşleşme (tümü)

Çıktı yaz: (
	Desen yeni: ['(.*)'],
	eşleş: ['test@example.com'] 
), yeni-satır. # 1 eşleşme (tümü)

Çıktı yaz: (
	Desen yeni: ['\\s*[^@]+@[^\.]+\.\\w+'],
	eşleş: ['test@example.com'] 
), yeni-satır. # 1 eşleşme, öndeki boşluk isteğe bağlı, yok sayılır