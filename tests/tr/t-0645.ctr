Server init.
Çıktı yaz: ['Database date test'], yeni-satır.

>> db := Maria-DB yeni sunucu-adı: ['localhost'],
	kullanıcı: ['xo'], 
	parola: ['pass123'],
	veritabanı-adı: ['xobase'],
	bağlan.

>> arama-parametreleri :=
db sorgu: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
getir: { :row
	Çıktı yaz: row datetest, yeni-satır.
}.
