Server init.
Çıktı yaz: ['Veritabanı tarih testi'], yeni-satır.

>> vt := Maria-DB yeni sunucu-adı: ['localhost'],
	kullanıcı: ['xo'], 
	parola: ['pass123'],
	veritabanı-adı: ['xobase'],
	bağlan.

>> arama-parametreleri :=
vt sorgu: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
getir: { :kayıt
	Çıktı yaz: kayıt datetest, yeni-satır.
}.
