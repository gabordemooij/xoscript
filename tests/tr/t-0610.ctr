
>> Rectangle := Nesne yeni.

Rectangle olunca: ['area'] yap: { <- öz uzunluk * öz width.
}.

Rectangle olunca: ['length:'] yap: { :uzunluk
	öz uzunluk := uzunluk.
}.

Rectangle olunca: ['width:'] yap: { :width
	öz width := width.
}.

Rectangle olunca: ['yeni'] yap: {
	# this will not result into an infinite loop
	>> rectangle := kendi yeni.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle yeni.
Çıktı yaz: a area, yeni-satır. #0

>> b := Rectangle yeni length: 2, width: 3.
Çıktı yaz: b area, yeni-satır. #6

