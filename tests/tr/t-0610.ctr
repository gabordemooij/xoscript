
>> Dikdörtgen := Nesne yeni.

Dikdörtgen olunca: ['alan'] yap: {
	<- öz uzunluk * öz genişlik.
}.

Dikdörtgen olunca: ['length:'] yap: { :uzunluk
	öz uzunluk := uzunluk.
}.

Dikdörtgen olunca: ['width:'] yap: { :genişlik
	öz genişlik := genişlik.
}.

Dikdörtgen olunca: ['yeni'] yap: {
	# bu sonsuz bir döngüye yol açmaz
	>> dikdörtgen := kendi yeni.
	dikdörtgen length: 0, width: 0.
	<- dikdörtgen.
}.

>> a := Dikdörtgen yeni.
Çıktı yaz: a alan, yeni-satır. #0

>> b := Dikdörtgen yeni length: 2, width: 3.
Çıktı yaz: b alan, yeni-satır. #6

