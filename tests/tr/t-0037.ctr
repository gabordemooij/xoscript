>> a := 3.
>> b := a kopyala.
a çıkar: 1.
Çıktı yaz: [' a = '] + a.
Çıktı yaz: [' b = '] + b.
a := 3.
b := a + 4.
Çıktı yaz: [' a = '] + a.
Çıktı yaz: [' b = '] + b.
>> x := 3.
>> y := x kopyala.
x ekle: 10.
y çıkar: 1.
Çıktı yaz: [' x = '] + x.
Çıktı yaz: [' y = '] + y.
>> q := Nesne yeni.
q olunca: ['setProperty:'] yap: { :x
	öz özl := x.
}.
q olunca: ['özelliğiAl'] yap: { <- öz özl.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Çıktı yaz: [' p = '] + (p özelliğiAl).
