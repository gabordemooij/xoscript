# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> yol := ['/tmp/dat.csv'].
>> csv := Dosya yeni: yol.
csv yaz: s.

# accepts CRLF LF CR, varying row length
csv ayırıcı: [';'] tırnak: ['"'] satırlar: { :line
	Program temizle.
	Çıktı yaz: line, yeni-satır.
	Program temizle.
}.

# unequal lines
s sona-ekle: ['\njustone'].
csv yaz: s.
{
	csv ayırıcı: [';'] tırnak: ['"'] satırlar: { :line
		Çıktı yaz: line, yeni-satır.
	}.
} yakala: { :e 
	Çıktı yaz: e, yeni-satır.
}, başlat.

# invalid format
s := ['"he"llo";world'].
csv yaz: s.
{
	csv ayırıcı: [';'] tırnak: ['"'] satırlar: { :line
		Çıktı yaz: line, yeni-satır.
	}.
} yakala: { :e 
	Çıktı yaz: e, yeni-satır.
}, başlat.
