# olağan akış
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> yol := ['/tmp/dat.csv'].
>> csv := Dosya yeni: yol.
csv yaz: s.

# CRLF LF CR kabul eder, değişen satır uzunluğu
csv ayırıcı: [';'] tırnak: ['"'] satırlar: { :line
	Program temizle.
	Çıktı yaz: line, yeni-satır.
	Program temizle.
}.

# eşit olmayan satırlar
s sona-ekle: ['\njustone'].
csv yaz: s.
{
	csv ayırıcı: [';'] tırnak: ['"'] satırlar: { :line
		Çıktı yaz: line, yeni-satır.
	}.
} yakala: { :e 
	Çıktı yaz: e, yeni-satır.
}, başlat.

# geçersiz biçim
s := ['"he"llo";world'].
csv yaz: s.
{
	csv ayırıcı: [';'] tırnak: ['"'] satırlar: { :line
		Çıktı yaz: line, yeni-satır.
	}.
} yakala: { :e 
	Çıktı yaz: e, yeni-satır.
}, başlat.
