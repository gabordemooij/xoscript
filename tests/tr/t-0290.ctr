# liste işlemlerini sına


>> pastalar := Liste ←
	['apple'] ;
	['böğürtlen'] ;
	['çikolata'] ;
	['peynir'].


>> satınAl := pastalar değiştir: 1 uzunluk: 2 yenisi: ( Liste ← ['tarçın'] ; ['ananas'] ).
Çıktı yaz: (satınAl birleştir: [',']), yeni-satır.


>> satınAl := pastalar değiştir: 1 uzunluk: 12 yenisi: ( Liste ← ['tarçın'] ; ['ananas'] ).
Çıktı yaz: (satınAl birleştir: [',']), yeni-satır.


>> satınAl := pastalar değiştir: 2 uzunluk: 10 yenisi: ( Liste yeni ).
Çıktı yaz: (satınAl birleştir: [',']), yeni-satır.


>> satınAl := pastalar değiştir: 0 uzunluk: 1 yenisi: ( Liste yeni ).
Çıktı yaz: (satınAl birleştir: [',']), yeni-satır.


>> satınAl := pastalar değiştir: ['0'] uzunluk: ['1'] yenisi: ['x'].
Çıktı yaz: (satınAl birleştir: [',']), yeni-satır.
