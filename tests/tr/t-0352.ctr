Sayı olunca: ['roman'] yap: {
	>> sayı := kendi kopyala.
	>> roman := [''].
	{
		{
			(sayı ≥ 1000) doğru: {
				roman sona-ekle: ['Ⅿ'].
				sayı çıkar: 1000.
			}, kır.
		
			(sayı ≥ 500) doğru: {
				roman sona-ekle: ['Ⅾ'].
				sayı çıkar: 500.
			}, kır.
		
			(sayı ≥ 100) doğru: {
				roman sona-ekle: ['Ⅽ'].
				sayı çıkar: 100.
			}, kır.
		
			(sayı ≥ 50) doğru: {
				roman sona-ekle: ['Ⅼ'].
				sayı çıkar: 50.
			}, kır.
		
			(sayı ≥ 50) doğru: {
				roman sona-ekle: ['Ⅼ'].
				sayı çıkar: 50.
			}, kır.
		
			(sayı ≥ 10) doğru: {
				roman sona-ekle: ['Ⅹ'].
				sayı çıkar: 10.
			}, kır.
			
			(sayı ≥ 9) doğru: {
				roman sona-ekle: ['Ⅸ'].
				sayı çıkar: 9.
			}, kır.
			
			(sayı ≥ 5) doğru: {
				roman sona-ekle: ['Ⅴ'].
				sayı çıkar: 5.
			}, kır.
			
			(sayı ≥ 4) doğru: {
				roman sona-ekle: ['Ⅳ'].
				sayı çıkar: 4.
			}, kır.
			
			(sayı ≥ 1) doğru: {
				roman sona-ekle: ['Ⅰ'].
				sayı çıkar: 1.
			}, kır.
		} prosedür.
	} sürece: { <- sayı > 0. }. <- roman.
}.

Çıktı yaz: 1 roman, yeni-satır.
Çıktı yaz: 2 roman, yeni-satır.
Çıktı yaz: 4 roman, yeni-satır.
Çıktı yaz: 8 roman, yeni-satır.
Çıktı yaz: 16 roman, yeni-satır.
Çıktı yaz: 32 roman, yeni-satır.
Çıktı yaz: 64 roman, yeni-satır.
Çıktı yaz: 128 roman, yeni-satır.
Çıktı yaz: 256 roman, yeni-satır.
Çıktı yaz: 1024 roman, yeni-satır.
