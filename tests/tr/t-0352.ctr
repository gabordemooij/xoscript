Sayı olunca: ['romen'] yap: {
	>> sayı := kendi kopyala.
	>> romen := [''].
	{
		{
			(sayı ≥ 1000) doğru: {
				romen sona-ekle: ['Ⅿ'].
				sayı çıkar: 1000.
			}, kır.
		
			(sayı ≥ 500) doğru: {
				romen sona-ekle: ['Ⅾ'].
				sayı çıkar: 500.
			}, kır.
		
			(sayı ≥ 100) doğru: {
				romen sona-ekle: ['Ⅽ'].
				sayı çıkar: 100.
			}, kır.
		
			(sayı ≥ 50) doğru: {
				romen sona-ekle: ['Ⅼ'].
				sayı çıkar: 50.
			}, kır.
		
			(sayı ≥ 50) doğru: {
				romen sona-ekle: ['Ⅼ'].
				sayı çıkar: 50.
			}, kır.
		
			(sayı ≥ 10) doğru: {
				romen sona-ekle: ['Ⅹ'].
				sayı çıkar: 10.
			}, kır.
			
			(sayı ≥ 9) doğru: {
				romen sona-ekle: ['Ⅸ'].
				sayı çıkar: 9.
			}, kır.
			
			(sayı ≥ 5) doğru: {
				romen sona-ekle: ['Ⅴ'].
				sayı çıkar: 5.
			}, kır.
			
			(sayı ≥ 4) doğru: {
				romen sona-ekle: ['Ⅳ'].
				sayı çıkar: 4.
			}, kır.
			
			(sayı ≥ 1) doğru: {
				romen sona-ekle: ['Ⅰ'].
				sayı çıkar: 1.
			}, kır.
		} prosedür.
	} sürece: { <- sayı > 0. }. <- romen.
}.

Çıktı yaz: 1 romen, yeni-satır.
Çıktı yaz: 2 romen, yeni-satır.
Çıktı yaz: 4 romen, yeni-satır.
Çıktı yaz: 8 romen, yeni-satır.
Çıktı yaz: 16 romen, yeni-satır.
Çıktı yaz: 32 romen, yeni-satır.
Çıktı yaz: 64 romen, yeni-satır.
Çıktı yaz: 128 romen, yeni-satır.
Çıktı yaz: 256 romen, yeni-satır.
Çıktı yaz: 1024 romen, yeni-satır.
