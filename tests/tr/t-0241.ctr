

Metin olunca: ['evaluate'] yap: {
	>> kod := Dosya yeni: ['/tmp/eval.ctr'].
	kod yaz: (kendi metin + ['.']).
	Program kullan: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Liste ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q metin.
Çıktı yaz: x, yeni-satır.
>> y := Hiç.
(['y := '] + x ) evaluate.
Çıktı yaz: y ? 0, yeni-satır.

q := Sözlük koy: ['\[''] konum: ['\['quote\']'].
x := q metin.
Çıktı yaz: x, yeni-satır.
y := Hiç.
(['y := '] + x ) evaluate.

>> q := (Sözlük yeni) koy:['\[''] konum:['\['quote\[''].
Çıktı yaz: y ? ['\['quote\']'], yeni-satır.
