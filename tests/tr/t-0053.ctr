60 × {
	>> x := (Sayı rasgele % 6) + 1.
	(x ≤ 6) yanlış: { Çıktı yaz: ['BAŞARISIZ']. }.
	(x ≥0) yanlış: { Çıktı yaz: ['BAŞARISIZ']. }.
	x := (Sayı rasgele % 3) + 1.
	(x < 3) yanlış: { Çıktı yaz: ['BAŞARISIZ']. }.
	(x>-1) yanlış: { Çıktı yaz: ['BAŞARISIZ']. }.
	x := ((Mantıksal yazıTura) sayı).
	(x = 0 veya: x = 1) yanlış: { Çıktı yaz: ['BAŞARISIZ']. }.
	x := ((Doğru yazıTura) sayı).
	(x = 0 veya: x = 1) yanlış: { Çıktı yaz: ['BAŞARISIZ']. }.
	x := (Mantıksal yazıTura ya: ['YAZI'] veya: ['TURA']).
	((x = ['YAZI']) veya: (x = ['TURA'])) yanlış: { Çıktı yaz: ['BAŞARISIZ']. }.
}.
Çıktı yaz: ['BİTTİ'].

