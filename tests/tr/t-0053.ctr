60 × {
	>> x := (Sayı random % 6) + 1.
	(x ≤ 6) yanlış: { Çıktı yaz: ['FAIL']. }.
	(x ≥0) yanlış: { Çıktı yaz: ['FAIL']. }.
	x := (Sayı random % 3) + 1.
	(x < 3) yanlış: { Çıktı yaz: ['FAIL']. }.
	(x>-1) yanlış: { Çıktı yaz: ['FAIL']. }.
	x := ((Mantıksal flip) sayı).
	(x = 0 veya: x = 1) yanlış: { Çıktı yaz: ['FAIL']. }.
	x := ((Doğru flip) sayı).
	(x = 0 veya: x = 1) yanlış: { Çıktı yaz: ['FAIL']. }.
	x := (Mantıksal flip ya: ['HEAD'] veya: ['TAIL']).
	((x = ['HEAD']) veya: (x = ['TAIL'])) yanlış: { Çıktı yaz: ['FAIL']. }.
}.
Çıktı yaz: ['DONE'].

