
Metin olunca: ['değerlendir'] yap: {
	>> kod := Dosya yeni: ['/tmp/eval.ctr'].
	kod yaz: (kendi metin + ['.']).
	Program kullan: ['/tmp/eval.ctr'].
}.

>> map :=
	(Sözlük yeni)
	koy: ['Selam Millet'] konum: ['two'],
	koy: (Liste ← ['hello'] ; ['world'] ; (Liste ← 1 ; 2; 9) ; Yanlış) konum: ['bir'],
	koy: ( (Sözlük yeni) koy: ['dnya'] konum: ['yanlış yazılmış'] ) konum: ['three'],
	koy: (Liste ← ((Sözlük yeni) koy: ['hazine'] konum: ['gizli']) ; 2) konum: ['dört']. 
>> str := map metin.
>> map2 := Hiç.
(['map2 := '] + str ) değerlendir.
Çıktı yaz: map2 ? ['bir'] ? 0.
Çıktı yaz: map2 ? ['bir'] ? 1.
Çıktı yaz: map2 ? ['dört'] ? 0 ? ['gizli'].
Çıktı yaz: map2 ? ['bir'] ? 2 ? 2.
