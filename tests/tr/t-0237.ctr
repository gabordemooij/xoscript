
Metin olunca: ['evaluate'] yap: {
	>> kod := Dosya yeni: ['/tmp/eval.ctr'].
	kod yaz: (kendi metin + ['.']).
	Program kullan: ['/tmp/eval.ctr'].
}.

>> map :=
	(Sözlük yeni)
	koy: ['Hi There'] konum: ['two'],
	koy: (Liste ← ['hello'] ; ['world'] ; (Liste ← 1 ; 2; 9) ; Yanlış) konum: ['one'],
	koy: ( (Sözlük yeni) koy: ['wrrld'] konum: ['misspelled'] ) konum: ['three'],
	koy: (Liste ← ((Sözlük yeni) koy: ['treasure'] konum: ['hidden']) ; 2) konum: ['four']. 
>> str := map metin.
>> map2 := Hiç.
(['map2 := '] + str ) evaluate.
Çıktı yaz: map2 ? ['one'] ? 0.
Çıktı yaz: map2 ? ['one'] ? 1.
Çıktı yaz: map2 ? ['four'] ? 0 ? ['hidden'].
Çıktı yaz: map2 ? ['one'] ? 2 ? 2.
