# Bu sınama, string_fill_in'in mod 4'te yuvasını kaybetmediğini (gc'lenmediğini) denetler
# world.c içinde başvuru
>> Günlük := Nesne yeni.

Günlük olunca: ['say:'] yap: { :str
	Çıktı yaz: str, yeni-satır.
}.

>> Öğe := Nesne yeni.

Öğe olunca: ['yeni:'] yap: { :id
	<- kendi yeni id: id.
}.

Öğe olunca: ['id:'] yap: { :id
	öz id := id.
}.

Öğe olunca: ['id'] yap: { <- öz id. }.


Öğe olunca: ['metin'] yap: {
	>> str := ['Item#~no'].
	str ~no: öz id.
	<- str.
}.


>> Print := Nesne yeni.

Print olunca: ['items'] yap: { 
	
	öz öğe := Öğe yeni: 1.
	
	# burada ya segfault ya da yanlış str olur
	Günlük say: (
		['~item printed.'] ~item: öz öğe
	).
	
	
}.

Print items.