Sayı olunca: ['faktöriyel'] yap: {
	>> toplam := 1.
	{ :indeks toplam çarp: (kendi - (indeks)). } × kendi. <- toplam.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Çıktı yaz: a.
>> b := 2 + 3 faktöriyel.
Çıktı yaz: b.
>> c := 3 faktöriyel + 2.
Çıktı yaz: c.
>> d := 2 + (3 faktöriyel).
Çıktı yaz: d.
Çıktı yaz: 2 + 3 faktöriyel + 1.
