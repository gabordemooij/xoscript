Sayı olunca: ['factorial'] yap: {
	>> total := 1.
	{ :index total çarp: (kendi - (index)). } × kendi. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Çıktı yaz: a.
>> b := 2 + 3 factorial.
Çıktı yaz: b.
>> c := 3 factorial + 2.
Çıktı yaz: c.
>> d := 2 + (3 factorial).
Çıktı yaz: d.
Çıktı yaz: 2 + 3 factorial + 1.
