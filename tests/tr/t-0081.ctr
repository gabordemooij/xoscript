>> map1 := Sözlük yeni.
>> key1 := Liste yeni.
>> key2 := Liste yeni.

map1
	koy: ['hello'] konum: key1,
	koy: ['world'] konum: key2.


Çıktı
	yaz: ['Map #1 contains: '] + (map1 konum: key1),
	yaz: [' and '] + (map1 konum: key2), yeni-satır.

>> KeyeableArray := Liste yeni.
KeyeableArray olunca: ['toString'] yap: { <- (kendi adet) toString.
}.

>> map2 := Sözlük yeni.
key1 := KeyeableArray yeni.
key2 := KeyeableArray yeni.

key1 sona-ekle: 1.

map2
	koy: ['hello'] konum: key1,
	koy: ['world'] konum: key2.

Çıktı
	yaz: ['Map #2 contains: '] + (map2 konum: key1),
	yaz: [' and '] + (map2 konum: key2), yeni-satır.
