>> harita1 := Sözlük yeni.
>> anahtar1 := Liste yeni.
>> anahtar2 := Liste yeni.

harita1
	koy: ['hello'] konum: anahtar1,
	koy: ['world'] konum: anahtar2.


Çıktı
	yaz: ['Map #1 contains: '] + (harita1 konum: anahtar1),
	yaz: [' ve '] + (harita1 konum: anahtar2), yeni-satır.

>> AnahtarlıDizi := Liste yeni.
AnahtarlıDizi olunca: ['metneÇevir'] yap: { <- (kendi adet) metneÇevir.
}.

>> map2 := Sözlük yeni.
anahtar1 := AnahtarlıDizi yeni.
anahtar2 := AnahtarlıDizi yeni.

anahtar1 sona-ekle: 1.

map2
	koy: ['hello'] konum: anahtar1,
	koy: ['world'] konum: anahtar2.

Çıktı
	yaz: ['Map #2 contains: '] + (map2 konum: anahtar1),
	yaz: [' ve '] + (map2 konum: anahtar2), yeni-satır.
