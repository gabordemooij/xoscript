>> HTML := Nesne yeni.
HTML olunca: ['yanıtla:'] yap: { :tag 
	Çıktı yaz: (['<tag>'] tag: tag), yeni-satır.
}.
HTML olunca: ['yanıtla:ve:'] yap: { :tag :html 
	Çıktı yaz: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), yeni-satır.
}.
>> html := HTML yeni.
html body h1: ['header'].

