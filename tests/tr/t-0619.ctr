>> HTML := Nesne yeni.
HTML olunca: ['yanıtla:'] yap: { :etiket 
	Çıktı yaz: (['<tag>'] tag: etiket), yeni-satır.
}.
HTML olunca: ['yanıtla:ve:'] yap: { :etiket :html 
	Çıktı yaz: (
		['<tag>innerHTML</tag>']
		tag: etiket - [':'],
		innerHTML: html
	), yeni-satır.
}.
>> html := HTML yeni.
html body h1: ['header'].

