# oturum çerezi biçimi, json içerik türü, yalnızca web protokolleri, svg satır içinde gösterilir
Server hazırla.
Program kullan: ['../../../src/xo/tr/webtools.xo'].

>> Sahte-İstek := Nesne yeni.
Sahte-İstek olunca: ['value:'] yap: { :değer
	öz değer := değer.
}.
Sahte-İstek olunca: ['cookie:'] yap: { :ad
	<- öz değer.
}.

>> Sınama-Oturumu := Geçici-dosya-oturumu yeni.
Sınama-Oturumu olunca: ['yükle'] yap: {
	<- Sözlük yeni.
}.
Sınama-Oturumu olunca: ['oturum-no'] yap: {
	<- öz id.
}.

>> çerezler := Liste yeni
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

çerezler her: { :i :çerez
	>> istek := Sahte-İstek yeni.
	istek value: çerez.
	>> yönetici := Sınama-Oturumu yeni.
	>> belge := Web-Belgesi yeni.
	belge istek: istek.
	belge oturum-yöneticisi: yönetici.
	belge oturumu-başlat.
	Çıktı yaz: ( yönetici oturum-no = çerez ), yeni-satır.
}.

>> belge := Web-Belgesi yeni.
belge json: (Sözlük yeni koy: ['b'] konum: ['a']).
Çıktı yaz: ['\n'], yeni-satır.

{ Ağ get: ['file:///etc/hostname']. } yakala: { :e
	Çıktı yaz: e, yeni-satır.
}, başlat.

>> svg := Dosya yeni: ['/tmp/test0814.svg'].
svg yaz: ['<svg xmlns="x"></svg>'].
Çıktı yeni-satır.
Server aktar: ['test0814.svg'] önek: ['/tmp/'].
svg sil.
