>> Greeter := Nesne yeni.
Greeter olunca: ['make'] yap: {
	>> gr := Nesne yeni.
	gr olunca: ['setName:'] yap: { :aname
		öz ad := aname.
	}.
	gr olunca: ['greet'] yap: {
		Çıktı yaz: öz ad.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a yeni.
c setName: ['THREE'].
c greet.
>> d := a yeni.
d setName: ['FOUR'].
d greet.
c greet.
