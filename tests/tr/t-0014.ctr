>> Selamlayıcı := Nesne yeni.
Selamlayıcı olunca: ['yarat'] yap: {
	>> gr := Nesne yeni.
	gr olunca: ['setName:'] yap: { :birAd
		öz ad := birAd.
	}.
	gr olunca: ['selamla'] yap: {
		Çıktı yaz: öz ad.
	}. <- gr.
}.
>> a := Selamlayıcı yarat.
>> b := Selamlayıcı yarat.
a setName: ['BİR'].
b setName: ['İKİ'].
a selamla.
b selamla.
>> c := a yeni.
c setName: ['ÜÇ'].
c selamla.
>> d := a yeni.
d setName: ['DÖRT'].
d selamla.
c selamla.
