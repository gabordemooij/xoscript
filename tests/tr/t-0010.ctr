>> Hayvan := Nesne yeni.
Hayvan olunca: ['yarat'] yap: {
	>> hayvan := Nesne yeni.
	hayvan olunca: ['sesÇıkar'] yap: {
		Çıktı yaz: öz ses.
	}. <- hayvan.
}.
>> Kedi := Nesne yeni.
Kedi olunca: ['yarat'] yap: {
	>> kedi := Hayvan yarat.
	kedi olunca: ['init'] yap: {
		öz ses := ['meow!'].
	}.
	kedi init. <- kedi.
}.
>> tom := Kedi yarat.
tom sesÇıkar.
