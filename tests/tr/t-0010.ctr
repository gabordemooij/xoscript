>> Animal := Nesne yeni.
Animal olunca: ['make'] yap: {
	>> animal := Nesne yeni.
	animal olunca: ['makeSound'] yap: {
		Çıktı yaz: öz sound.
	}. <- animal.
}.
>> Cat := Nesne yeni.
Cat olunca: ['make'] yap: {
	>> cat := Animal make.
	cat olunca: ['init'] yap: {
		öz sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
