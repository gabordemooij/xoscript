#Linux

 >> t := An yeni.
 
t dilim: ['Europe/Amsterdam'].
t yıl: 2020, ay: 8, gün: 2, saat: 21, dakika: 2, saniye: 1.

>> a := t saat.
>> ams := t dilim.

t dilim: ['US/Hawaii'].
>> b := t saat.
>> hw := t dilim.

Çıktı
yaz: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		ya: ['daha geç'] veya: ['daha erken']
	)
),
yeni-satır.
 