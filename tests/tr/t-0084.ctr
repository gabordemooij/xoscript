>> makeAdder := { :x
	>> f := { :y <- (öz x + y). } ayarla: ['x'] değer: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i öz q koy: (öz f uygula: (öz q ? i)) konum: i. } 
	ayarla: ['q'] değer: array,
	ayarla: ['f'] değer: func.
	{ :i mapping uygula: i. } × (array adet).
}.

>> a := Liste ← 1; 2; 3.
mapper uygula: a ve: (makeAdder uygula: 100).
Çıktı yaz: (a sıra: 0), yeni-satır.
Çıktı yaz: (a ? 1), yeni-satır.
Çıktı yaz: (a ? 2), yeni-satır.
