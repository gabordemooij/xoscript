>> toplayıcıYap := { :x
	>> f := { :y <- (öz x + y). } ayarla: ['x'] değer: x. <- f.
}.
>> eşleyici := { :dizi :fonk
	>> eşleştirme := { :i öz q koy: (öz f uygula: (öz q ? i)) konum: i. } 
	ayarla: ['q'] değer: dizi,
	ayarla: ['f'] değer: fonk.
	{ :i eşleştirme uygula: i. } × (dizi adet).
}.

>> a := Liste ← 1; 2; 3.
eşleyici uygula: a ve: (toplayıcıYap uygula: 100).
Çıktı yaz: (a sıra: 0), yeni-satır.
Çıktı yaz: (a ? 1), yeni-satır.
Çıktı yaz: (a ? 2), yeni-satır.
