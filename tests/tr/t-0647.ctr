Server init.
Çıktı yaz: ['Database time test'], yeni-satır.

>> db := Maria-DB yeni sunucu-adı: ['localhost'],
	kullanıcı: ['xo'], 
	parola: ['pass123'],
	veritabanı-adı: ['xobase'],
	bağlan.

>> arama-parametreleri :=
db sorgu: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
getir: { :row
	Çıktı yaz: row timetest, yeni-satır.
}.
