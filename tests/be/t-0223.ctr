>> x := Момант новы.
x зона: ['CEST'],
год:2017,
месяц:01,
дзень:10,
гадзіна: 10,
хвіліна: 0,
секунда: 0.

Вывад пісаць: x, новы-радок.

Вывад пісаць: x час, новы-радок.

x дадаць: 1 секунда.
x дадаць: 2 хвіліна.
x дадаць: 3 гадзіна.
x дадаць: 4 дзень.
x дадаць: 1 месяц.
x дадаць: 6 год.

Вывад пісаць: x, новы-радок.

x адняць: 1 секунда.
x адняць: 2 хвіліна.
x адняць: 3 гадзіна.
x адняць: 4 дзень.
x адняць: 1 месяц.
x адняць: 6 год.

Вывад пісаць: x, новы-радок.

>> y := x капіяваць.
>> z := x.

Вывад пісаць: y, новы-радок.
Вывад пісаць: z, новы-радок.
Вывад пісаць: (x зона = y зона), новы-радок.
Вывад пісаць: (x час = y час), новы-радок.
Вывад пісаць: (x = z), новы-радок.
Вывад пісаць: x дзень-года, новы-радок.
Вывад пісаць: x дзень-тыдня, новы-радок.
Вывад пісаць: x тыдзень, новы-радок.
