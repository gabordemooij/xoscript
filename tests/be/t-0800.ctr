Server init.

>> db := Maria-DB новы хост: ['localhost'],
	карыстальнік: ['xo'],
	пароль: ['pass123'],
	назва-базы: ['xobase'],
	падключыць.

>> параметры-пошуку := db запыт: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], параметры: ( Спіс новы ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  параметры-пошуку выканаць. db пацвердзіць. } перахапіць: { :e db адкаціць.  }, запусціць.

Вывад пісаць: ['Can we insert? '] + ( параметры-пошуку insert-id > 0 ), новы-радок.
