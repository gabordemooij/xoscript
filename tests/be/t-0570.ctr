#Linux

 >> t := Момант новы.
 
t зона: ['Europe/Amsterdam'].
t год: 2020, месяц: 8, дзень: 2, гадзіна: 21, хвіліна: 2, секунда: 1.

>> a := t гадзіна.
>> ams := t зона.

t зона: ['US/Hawaii'].
>> b := t гадзіна.
>> hw := t зона.

Вывад
пісаць: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		альбо: ['later'] альбо: ['earlier']
	)
),
новы-радок.
 