>> HTML := Абʼект новы.
HTML пры: ['адказаць:'] выканаць: { :tag 
	Вывад пісаць: (['<tag>'] tag: tag), новы-радок.
}.
HTML пры: ['адказаць:і:'] выканаць: { :tag :html 
	Вывад пісаць: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), новы-радок.
}.
>> html := HTML новы.
html body h1: ['header'].

