>> items := Слоўнік новы.
items пакласці: ['black'] на: ['coffee'], пакласці: ['earl grey'] на: ['tea'].
Вывад пісаць: (items на: ['coffee']), пісаць: (items на: ['tea']).
Вывад пісаць: ['there are'] + items колькасць + [' items in the array.'].
items пакласці: ['capuccino'] на: ['coffee'].
Вывад пісаць: ['Now my coffee is.. '] + (items на: ['coffee']).
items пакласці: ['aaa'] на: ['1'].
items пакласці: ['bbb'] на: ['2'].
Вывад пісаць: (items на: ['a']).
