# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Сховішча згенераваць-ключы.

# private (secret) key
>> sk := keys першы.

# public key
>> pk := keys апошні.

# sign a message
>> sig := Сховішча падпісаць: ['abc'] ключом: sk.

# check message (ok)
Вывад пісаць: ( 
	Сховішча
		праверыць: ['abc'] 
		подпіс: sig 
		ключом: pk 
), новы-радок.

# check message (fail)
Вывад пісаць: ( 
	Сховішча 
		праверыць: ['abd'] 
		подпіс: sig 
		ключом: pk 
), новы-радок.