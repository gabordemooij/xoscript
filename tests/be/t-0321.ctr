# test qualifiers

Праграма прыбраць.

>> Fruit := Абʼект новы.
Fruit пры: ['новы'] выканаць: {
	>> f := сам новы.
	f apples: 0. <- f.
}.
Fruit пры: ['apples:'] выканаць: { :a свой apples := a. }.
Fruit пры: ['apples'] выканаць: { <- свой apples. }.
Fruit пры: ['+'] выканаць: { :f
	>> n := Fruit новы.
	n apples: (f apples + свой apples). <- n.
}.
Лік пры: ['apples'] выканаць: { <- ((Fruit новы) apples: сам).
}.

Fruit пры: ['тэкст'] выканаць: { <- свой apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Вывад пісаць: q, новы-радок.




q := 3 apples + 4 apples.
Вывад пісаць: q, новы-радок.



q := 3 apples + 4 apples.
Вывад пісаць: q, новы-радок.


