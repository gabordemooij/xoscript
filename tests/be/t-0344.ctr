# catch-all test (practical)
>> HTML := Тэкст новы.
HTML пры: ['encode:'] выканаць: { :tekst
	сам дадаць-у-канец: (tekst
	замяніць: ['&'] на: ['&amp;'], 
	замяніць: ['<'] на: ['&lt;'],
	замяніць: ['>'] на: ['&gt;'],
	замяніць: ['"'] на: ['&quot;']).
}.
>> blog := HTML новы.
blog дадаць-у-канец: ['<h1>'],
     encode: ['Koffie & Thee'],
     дадаць-у-канец: ['</h1>'].
Вывад пісаць: blog, новы-радок.


>> Roman := Лік новы.
Roman пры: ['stringy'] выканаць: {
	>> a := [''].
	{ a дадаць-у-канец: ['I']. } × сам. <- a.
}.

>> x := Roman новы.
x дадаць: 3.
Вывад пісаць: x stringy, новы-радок.

>> Quantum := Лагічны новы.
Quantum пры: ['true?'] выканаць: { <- ['maybe True']. }.
Вывад пісаць: (Quantum новы true?), новы-радок.

>> Nihil := Нішто новы.
Nihil пры: ['тэкст'] выканаць: { <- ['Nihil']. }.
Вывад пісаць: (Nihil новы), новы-радок.
