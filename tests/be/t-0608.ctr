
>> Size := Абʼект новы.
Size пры: ['is:'] выканаць: { :лік
	лік пры: ['+'] выканаць: { :лік
		>> unit := лік азначэнне.
		>> factor := 1.
		
		unit
		выпадак: ['inch'] выканаць: { factor := 0.0833. }. <- сам + (лік * factor).
	}. <- лік.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Вывад пісаць: plank + edge, новы-радок.
