# test buffers PKI/Sign 
Server init.

>> long := ( Спіс новы запоўніць: 1000 чым: ['a'] ) злучыць: [''].

# sign a message
Вывад пісаць: ( 
	Сховішча падпісаць: ['abc'] ключом: long
), новы-радок.

Вывад пісаць: ( 
	Сховішча
		праверыць: ['abc'] 
		подпіс: long 
		ключом: long
), новы-радок.

Вывад пісаць: (
	Сховішча хэш-пароля: long праверыць: long
), новы-радок.
