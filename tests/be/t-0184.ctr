

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Праграма кіраванне-памяццю: 0.

Лік пры: ['addNum:'] выканаць: { :x
	сам дадаць: x.
}.

Лік пры: ['subtractNum:'] выканаць: { :x
	сам адняць: x.
}.

Лік пры: ['multiplyBy:'] выканаць: { :x
	сам памножыць-на: x.
}.

Лік пры: ['divideBy:'] выканаць: { :x
	сам падзяліць-на: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 ступень: 8).  
a := a + (2 ступень: -1). 
a := a + (49 квадратны-корань).   
a addNum: ((Спіс ← 0 ; 1) максімум).          
a addNum: ((Спіс ← 2 ; 3) мінімум).
Вывад пісаць: a.

Праграма прыбраць.

usedMemory1 := (Праграма памяць ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 ступень: 8).  
a := a + (2 ступень: -1). 
a := a + (49 квадратны-корань).   
a addNum: ((Спіс ← 0 ; 1) максімум).          
a addNum: ((Спіс ← 2 ; 3) мінімум).
Вывад пісаць: a.

Праграма прыбраць.
usedMemory2 := (Праграма памяць ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 ступень: 8).  
a := a + (2 ступень: -1). 
a := a + (49 квадратны-корань).   
a addNum: ((Спіс ← 0 ; 1) максімум).          
a addNum: ((Спіс ← 2 ; 3) мінімум).
Вывад пісаць: a.

Праграма прыбраць.
usedMemory3 := (Праграма памяць ? 0).



( usedMemory1 = usedMemory2 і: usedMemory1 = usedMemory3, і: usedMemory2 = usedMemory3 ) праўда: {
	Вывад пісаць: ['No memory leaks here'].
}, хлусня: {
	Вывад пісаць: ['Leaking memory...'].
}.
