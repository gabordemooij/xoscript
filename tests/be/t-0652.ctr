# test number -> string -> number
{

	>> x := Лік паміж: 0 і: 1000000.
	>> d := Лік паміж: 1 і: 7.
	>> e := 10 ступень: d.

	x падзяліць-на: e.
	>> y := x тэкст лік.

	(x = y) хлусня: {
		Вывад пісаць: x, новы-радок.
		Вывад пісаць: y, новы-радок.
		Праграма канец.
	}.

} * 1000.
Вывад пісаць: ['OK'], новы-радок.