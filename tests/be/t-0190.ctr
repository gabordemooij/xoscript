#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Праграма кіраванне-памяццю: 0.

{
Момант час.
Момант чакаць: 1.
Вывад пісаць: Праграма аргументы, новы-радок.
Праграма аргумент: 0.
Лік random.
Вывад пісаць: (Праграма сістэма: ['echo 'Hello'']).
} запусціць.

Праграма прыбраць.
usedMemory1 := (Праграма памяць ? 0).

{
Момант час.
Момант чакаць: 1.
Вывад пісаць: Праграма аргументы, новы-радок.
Праграма аргумент: 0.
Лік random.
Вывад пісаць: (Праграма сістэма: ['echo 'Hello'']).
} запусціць.

Праграма прыбраць.
usedMemory2 := (Праграма памяць ? 0).

{
Момант час.
Момант чакаць: 1.
Вывад пісаць: Праграма аргументы, новы-радок.
Праграма аргумент: 0.
Лік random.
Вывад пісаць: (Праграма сістэма: ['echo 'Hello'']).
} запусціць.

Праграма прыбраць.
usedMemory3 := (Праграма памяць ? 0).



( usedMemory1 = usedMemory2 і: usedMemory1 = usedMemory3, і: usedMemory2 = usedMemory3 ) праўда: {
	Вывад пісаць: ['No memory leaks here'].
}, хлусня: {
	Вывад пісаць: ['Leaking memory...'].
}.
