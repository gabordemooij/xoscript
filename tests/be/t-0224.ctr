
>> countries := Спіс новы
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Спіс новы
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods паводле: countries, кожны: { :key :value
	counter дадаць: 1.
}.

Вывад пісаць: (['we serve counter dishes'] counter: counter), новы-радок.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] сімвалы сартаваць: { :v
	counter дадаць: 0.
}.

Вывад пісаць: (['we sort counter dishes'] counter: counter), новы-радок.


>> counter := 0.
{
	{
		counter дадаць: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Вывад пісаць: (['we calculate counter numbers.'] counter: counter), новы-радок.

