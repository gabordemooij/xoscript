

Спіс пры: ['fixture:'] выканаць: { :f
	свой fixture := f.
}.

Спіс пры: ['колькасць'] выканаць: { <- свой fixture.
}.

Спіс пры: ['aantal'] выканаць: { <- свой fixture.
}.


>> x := Нішто.
{

	x := ['hello'] 
	замяніць:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] сімвал: 2)
			)
		)
	на: (
		(['...hal'] + ['lo']) 
			вялікія-літары 
			lowecase 
			вялікія-літары 
			зрушэнне: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Спіс ← 0 ; 1 ; 4; 9 ; (Спіс ← 0 ; 3; 1) ; 4
							) перадапошні
						) ? 1
					) + 
					((Спіс ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					колькасць
				)
			)
	).

} × 10.
Вывад пісаць: x, новы-радок.

