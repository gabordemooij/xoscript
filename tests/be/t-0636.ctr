# test url parsing

Server init.
>> url := URL з: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Вывад пісаць: ['scheme = '] + url схема, новы-радок.
Вывад пісаць: ['host = '] + url хост, новы-радок.
Вывад пісаць: ['port = '] + url порт, новы-радок.
Вывад пісаць: ['path = '] + url шлях, новы-радок.
Вывад пісаць: ['query = '] + url параметры-пошуку, новы-радок.
Вывад пісаць: ['fragment = '] + url фрагмент, новы-радок.
