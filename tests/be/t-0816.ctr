# a format must fit the type of the value, the type can come from a client
>> паспрабаваць := { :format :value
	{ Вывад пісаць: ( (Фармат новы: format) прымяніць: value ), новы-радок. } перахапіць: { :e Вывад пісаць: e, новы-радок. }, запусціць.
}.
>> try-int := { :format :value
	{ Вывад пісаць: ( (Фармат новы: format) прымяніць-цэлы: value ), новы-радок. } перахапіць: { :e Вывад пісаць: e, новы-радок. }, запусціць.
}.

# fits
паспрабаваць прымяніць: ['|%s|'] і: ['text'].
паспрабаваць прымяніць: ['%06.2f'] і: 5.5.
паспрабаваць прымяніць: ['100%% %s'] і: ['sure'].
try-int прымяніць: ['%03d'] і: 7.
try-int прымяніць: ['%x'] і: 255.
паспрабаваць прымяніць: ['%d'] і: (Int64 новы з-тэксту: ['12']).
паспрабаваць прымяніць: ['%lld'] і: (Int64 новы з-тэксту: ['12']).
паспрабаваць прымяніць: ['%.1lf'] і: 5.5.
try-int прымяніць: ['%hd'] і: 7.

# does not fit
паспрабаваць прымяніць: ['%s'] і: 12345.
паспрабаваць прымяніць: ['%d'] і: 12345.
паспрабаваць прымяніць: ['%f'] і: ['text'].
try-int прымяніць: ['%d'] і: ['text'].
try-int прымяніць: ['%s'] і: 5.
паспрабаваць прымяніць: ['%s %s'] і: ['text'].
паспрабаваць прымяніць: ['%n'] і: ['text'].
паспрабаваць прымяніць: ['%*s'] і: ['text'].
паспрабаваць прымяніць: ['%'] і: ['text'].

# length modifier does not fit
паспрабаваць прымяніць: ['%ls'] і: ['text'].
паспрабаваць прымяніць: ['%Lf'] і: 5.5.
try-int прымяніць: ['%ld'] і: 7.
try-int прымяніць: ['%lld'] і: 7.
паспрабаваць прымяніць: ['%Ld'] і: (Int64 новы з-тэксту: ['12']).

# a width that does not fit printf must give an error, not a crash
паспрабаваць прымяніць: ['%99999999999s'] і: ['text'].
