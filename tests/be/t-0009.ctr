>> Greeter := Абʼект новы.
Greeter пры: ['make'] выканаць: {
	>> greeter := Абʼект новы.
	greeter пры: ['name:'] выканаць: { :імя
		Вывад пісаць: ['setting a name'].
		свой myName := імя.
	}.
	greeter пры: ['performGreeting'] выканаць: {
		Вывад пісаць: ['Hello'].
		Вывад пісаць: свой myName.
	}.
	greeter пры: ['greet'] выканаць: {
		сам performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
