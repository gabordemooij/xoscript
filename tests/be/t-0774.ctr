Вывад пісаць: ['Test object'], новы-радок.
>> a := Абʼект новы. 
a пры: ['item:'] выканаць: { :lst
	свой lst := lst. 
}.
a пры: ['item'] выканаць: { <- свой lst.
}.
a item: (
	Спіс новы ; 1 ; (
		Спіс новы ; ['a'] ; (
			Спіс новы ; ( Момант новы: 1 )
		) ; ( Int64 з-тэксту: ['321'] )
	)
).
Вывад пісаць: a item, новы-радок.
>> old-lst-address := a item прататып адрас-памяці.
a save-as: ['/tmp/a.bin'].
Вывад пісаць: ['========== RELOADING SNAP:'], новы-радок.
>> b := Абʼект load-from: ['/tmp/a.bin'].
(b item прататып адрас-памяці = old-lst-address) праўда: {
	Вывад пісаць: ['Object link re-attached.'], новы-радок.
}.
Вывад пісаць: ( b item ), новы-радок.
