

>> obj := Абʼект новы.

obj пры: ['greet'] выканаць: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj пры: ['task'] выканаць: {
	свой property := 123.
	{
		# try binds self/own to object instead of block
		Вывад пісаць: сам greet.
		Вывад пісаць: свой property.
