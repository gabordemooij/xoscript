>> t := Праўда.
(t = Праўда) праўда: { Вывад пісаць: ['T']. }.
(t = Хлусня) праўда: { Вывад пісаць: ['F']. }.
Вывад пісаць: ['|'].
>> t := Хлусня.
(t = Праўда) праўда: { Вывад пісаць: ['T']. }.
(t = Хлусня) праўда: { Вывад пісаць: ['F']. }.
Вывад пісаць: ['|'].
>> f := Праўда.
(t = Праўда і: f = Хлусня) праўда: { Вывад пісаць: ['T']. }.
(t = Хлусня і: f = Праўда) праўда: { Вывад пісаць: ['F']. }.
Вывад пісаць: ['|'].
>> n := Нішто.
(n Нішто?) праўда: { Вывад пісаць: ['T']. }.
(n Нішто?) хлусня: { Вывад пісаць: ['F']. }.
Вывад пісаць: ['|'].
(f Boolean?) праўда: { Вывад пісаць: ['T']. }.
(f Boolean?) хлусня: { Вывад пісаць: ['F']. }.



