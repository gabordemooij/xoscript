#Linux

(Файл новы: ['/tmp/testje']) існуе хлусня: {
	Праграма сістэма: ['mkdir /tmp/testje'].	
}.

(Файл новы: ['/tmp/testje/file1']) існуе хлусня: {
	Праграма сістэма: ['touch /tmp/testje/file1'].	
}.

(Файл новы: ['/tmp/testje/folder1']) існуе хлусня: {
	Праграма сістэма: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Файл спіс: ['/tmp/testje'].

>> q := Спіс новы.

l кожны: { :k :v v кожны: { :x :y q дадаць-у-канец: y. }. }.

>> s := q тэкст.

(s змяшчае: ['file1']) праўда:   { Вывад пісаць: ['OK'], новы-радок. }.
(s змяшчае: ['file2']) праўда:   { Вывад пісаць: ['XX'], новы-радок. }.
(s змяшчае: ['folder1']) праўда: { Вывад пісаць: ['OK'], новы-радок. }.
