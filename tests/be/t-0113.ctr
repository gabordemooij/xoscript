Вывад пісаць: ['Continue for-loop, No - before 6 and up.'], новы-радок.
{ :i
	Вывад пісаць: (i + 1), новы-радок.
	((i + 1) > 4) працягваць.
	Вывад пісаць: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Вывад новы-радок.
Вывад пісаць: ['Continue while-true, No --> before 5 and up.'], новы-радок.
{
	Вывад пісаць: ['iteration #'] + x, новы-радок.
	x дадаць: 1.
	((x < 5) не) працягваць.
	Вывад пісаць: ['-->'].
} пакуль: xIsLessThan10.
Вывад новы-радок.
Вывад пісаць: ['Continue while-false, No - before 3 only.'], новы-радок.
{
	Вывад пісаць: ['iteration #'] + x, новы-радок.
	x адняць: 1.
	(x = 3) працягваць.
	Вывад пісаць: ['-'].
} пакуль: { <- ( x > 0). }.

Вывад новы-радок.
Вывад пісаць: ['Continue times-loop, No ||| before 3.'], новы-радок.
{ :i
	Вывад пісаць: ['iteration #'] + i, новы-радок.
	(i = 2) працягваць.
	Вывад пісаць: ['|||'].
} × 5.

Вывад новы-радок.

{ Праўда працягваць. Вывад пісаць: ['dont write this!'], новы-радок. } запусціць.

{ Праўда працягваць. Вывад пісаць: ['dont write this!'], новы-радок. } перахапіць: { Вывад пісаць: ['Dont catch this!']. }, запусціць.

Вывад пісаць: ['Test Array each-loop: 0, ... ,2'], новы-радок.
(Спіс ← 1 ; 2 ; 3) пераўтварыць: { :i
	(i = 1) працягваць.
	Вывад пісаць: ['iteration #'] + (i - 0), новы-радок.
}.

Вывад пісаць: ['Test Map each-loop: c only'], новы-радок.
>> m := Слоўнік новы.
m пакласці: ['first'] на: ['a'], пакласці: ['second'] на: ['b'], пакласці: ['third'] на: ['c'].
m кожны: { :k :v
	(k ≠ ['c']) працягваць.
	Вывад пісаць: ['iteration'] + k + v, новы-радок.
}.

