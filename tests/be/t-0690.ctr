# database test
# see example server.xo for required config

Server init.
Вывад пісаць: ['Database test'], новы-радок.

>> db := Maria-DB новы хост: ['localhost'],
	карыстальнік: ['xo'], пароль: ['pass123'], назва-базы: ['xobase'], падключыць.

Вывад пісаць: ['Can we connect? '] + db падключана?, новы-радок.

>> параметры-пошуку := db запыт: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], параметры: ( Спіс новы ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  параметры-пошуку выканаць. db пацвердзіць. } перахапіць: { :e db адкаціць.  }, запусціць.

Вывад пісаць: ['Can we insert? '] + ( параметры-пошуку insert-id > 0 ), новы-радок.

>> x := 0.
>> параметры-пошуку :=
db запыт: ['SELECT * FROM book order by id desc limit 2'], 
атрымаць: { :row 
	x дадаць: 1.
	Праўда перапыніць. # must clean up, no 'Commands out of sync'
}.

>> параметры-пошуку :=
db запыт: ['SELECT * FROM book order by id desc limit 2'], 
атрымаць: { :row
	x дадаць: 1.
	Праўда перапыніць.
}.

(x > 0) праўда: {
	Вывад пісаць: ['Can we break in the middle of a fetch? '].
}.

Вывад пісаць: Праўда, новы-радок.