


>> Deck := Спіс новы.
Deck пры: ['print'] выканаць: {
        >> len := сам колькасць - 1.
        { :i
                >> len2 := сам колькасць - 1.
                Вывад пісаць: ['len: '].
                Вывад пісаць: len, новы-радок.
                Вывад пісаць: ['len2: '].
                Вывад пісаць: len2, новы-радок.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
