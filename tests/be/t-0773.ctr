Вывад пісаць: ['Test object'], новы-радок.
>> a := Абʼект новы. 
a пры: ['item:'] выканаць: { :int64
	свой int64 := int64. 
}.
a пры: ['item'] выканаць: { <- свой int64.
}.
a item: ( Int64 з-тэксту: ['9999'] ).
Вывад пісаць: a item, новы-радок.
>> old-int64-address := a item прататып адрас-памяці.
a save-as: ['/tmp/a.bin'].
Вывад пісаць: ['========== RELOADING SNAP:'], новы-радок.
>> b := Абʼект load-from: ['/tmp/a.bin'].
(b item прататып адрас-памяці = old-int64-address) праўда: {
	Вывад пісаць: ['Object link re-attached.'], новы-радок.
}.
Вывад пісаць: ( b item ), новы-радок.
