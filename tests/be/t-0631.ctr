#ffi test


Server init.

Праграма кіраванне-памяццю: 4.

# for this test you need set a path to libc (puts)
>> libname := Праграма налада: ['FFITESTLIB'].



Server звязаць: (
 Спіс новы ;
 libname ;
 ['puts'] ;
 ( Спіс новы ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s вызваліць.

# test with struct

>> a := Blob новы: 8.
a bytes: (
	Спіс <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Спіс <<: ['int'], ; ['int']).

Server звязаць: (
	Спіс <<: ['@structtest'], ;
	['@structtest'] ;
	(Спіс <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Вывад пісаць: ['Sum test:'] + (ffitest ffisum: a), новы-радок.

struct вызваліць-struct.
struct вызваліць.
a вызваліць.
