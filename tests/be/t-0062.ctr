Лагічны пры: ['xor:'] выканаць: { :a :b <- ((a і: b не) альбо: (a не і: b)).
}.

>> o := Абʼект новы.
o пры: ['hello'] выканаць: { ['Empty']. }.
{ o пры: 2 выканаць: 3.} перахапіць: { :e Вывад пісаць: e, новы-радок. }, запусціць.
{ o пры: ['тэст'] выканаць: 3.} перахапіць: { :e Вывад пісаць: e, новы-радок. }, запусціць.
{ o пры: ['hello'] выканаць: { ['Empty']. }.} перахапіць: { :e Вывад пісаць: e, новы-радок. }, запусціць. 
{ >> z := 4 ÷ 0. } перахапіць: { :e Вывад пісаць: e, новы-радок. }, запусціць. 
{ (Праўда і: Нішто) праўда: { Вывад пісаць: ['X'].}. } перахапіць: { :e Вывад пісаць: e, новы-радок. }, запусціць. 
{ ([''] xor: 0) праўда: { Вывад пісаць: ['X'].}. } перахапіць: { :e Вывад пісаць: e, новы-радок. }, запусціць. 
{ (1 < ['2']) праўда: { Вывад пісаць: ['OK']. }. } перахапіць: { :e Вывад пісаць: e, новы-радок. }, запусціць. 
{ (1 < ['2.0']) праўда: { Вывад пісаць: ['OK']. }. } перахапіць: { :e Вывад пісаць: e, новы-радок. }, запусціць. 
{ (1 < ['x2.0']) праўда: { Вывад пісаць: ['NO!']. }. } перахапіць: { :e Вывад пісаць: e, новы-радок. }, запусціць. 
{ Вывад пісаць: (['hello OK there'] ад: ['6'] даўжыня: ['2']). } запусціць. 
