# a value ending in the first part of an opening quote must survive serialization
>> значэнні := Спіс новы
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

значэнні кожны: { :i :value
	>> d := Слоўнік новы.
	d пакласці: value на: ['k'].
	d пакласці: ['second'] на: ['j'].
	>> r := d код абʼект.
	Вывад пісаць: r колькасць, новы-радок.
	Вывад пісаць: ( (r на: ['k']) = value ), новы-радок.
}.
