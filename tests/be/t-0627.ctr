

# create a 64-bit integer for exact calculations
>> a := Int64 з-тэксту: ['123'].

# to string
Вывад пісаць: a, новы-радок.

# divide
Вывад пісаць: a / (Int64 з-тэксту: ['3']), новы-радок.

# multiply
Вывад пісаць: a * (Int64 з-тэксту: ['2']), новы-радок.

# add
Вывад пісаць: a + (Int64 з-тэксту: ['1']), новы-радок.

# subtract
Вывад пісаць: a - (Int64 з-тэксту: ['2']), новы-радок.

# compare
Вывад пісаць: ( a =   (Int64 з-тэксту: ['123'])), новы-радок.
Вывад пісаць: ( a !=: (Int64 з-тэксту: ['124'])), новы-радок.
Вывад пісаць: ( a <   (Int64 з-тэксту: ['124'])), новы-радок.
Вывад пісаць: ( a >   (Int64 з-тэксту: ['122'])), новы-радок.
Вывад пісаць: ( a >=: (Int64 з-тэксту: ['123'])), новы-радок.
Вывад пісаць: ( a <=: (Int64 з-тэксту: ['123'])), новы-радок.





	