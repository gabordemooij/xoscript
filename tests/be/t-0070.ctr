>> numbers := ['1,2,3'] падзяліць: [','].
Вывад пісаць: ['I got: '] + numbers колькасць + [' numbers.'],новы-радок.
{ :i Вывад пісаць: ['number #'] + i + [':'] + (numbers пазіцыя: i), новы-радок.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages падзяліць: [' Or '].
Вывад пісаць: ['We serve'], новы-радок.
{ :i Вывад пісаць: ['->'] + (beverages пазіцыя: i), новы-радок. } × (beverages колькасць).
Вывад пісаць: (beverages злучыць: [',']), новы-радок.
Вывад пісаць: (numbers злучыць: ['||']).
