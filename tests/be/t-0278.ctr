>> To-Do := Абʼект новы.

To-Do пры: ['новы'] выканаць: {
	свой list := Спіс новы.
}.

To-Do пры: ['nieuw'] выканаць: {
	свой list := Спіс новы.
}.

To-Do пры: ['+'] выканаць: { :task
	свой list дадаць-у-канец: task.
}.

To-Do пры: ['number of tasks?'] выканаць: { <-  свой list колькасць.
}.

>> todos := 
	To-Do новы 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Вывад пісаць: ['You have $ tasks to do'] $ todos number of tasks?.
