>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Абʼект новы.
⚄ пры: ['drawFrom:length:'] выканаць: { :pool :колькасць
	
	>> result := [''].
	
	{
		>> index := Лік random % (pool даўжыня).
		result дадаць-у-канец: ( pool сімвал: (index + 1) ).
		
	} × колькасць. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? даўжыня.
Вывад пісаць: (['x↵'] x random даўжыня).
Вывад пісаць: (['y↵'] y ?? даўжыня).

