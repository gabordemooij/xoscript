>> map1 := Слоўнік новы.
>> key1 := Спіс новы.
>> key2 := Спіс новы.

map1
	пакласці: ['hello'] на: key1,
	пакласці: ['world'] на: key2.


Вывад
	пісаць: ['Map #1 contains: '] + (map1 на: key1),
	пісаць: [' and '] + (map1 на: key2), новы-радок.

>> KeyeableArray := Спіс новы.
KeyeableArray пры: ['toString'] выканаць: { <- (сам колькасць) toString.
}.

>> map2 := Слоўнік новы.
key1 := KeyeableArray новы.
key2 := KeyeableArray новы.

key1 дадаць-у-канец: 1.

map2
	пакласці: ['hello'] на: key1,
	пакласці: ['world'] на: key2.

Вывад
	пісаць: ['Map #2 contains: '] + (map2 на: key1),
	пісаць: [' and '] + (map2 на: key2), новы-радок.
