>> phrases := Спіс новы
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases кожны: { :_ :phrase 
	>> e := Server base64-кадаваць: phrase.
	>> d := Server base64-дэкадаваць: e.
	Вывад пісаць: (
		message капіяваць ~encoded: e, ~decoded: d
	), новы-радок.
}.
