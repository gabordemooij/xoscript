


>> CoffeeMachine := Абʼект новы.
CoffeeMachine пры: ['order:'] выканаць: { :id
	>> coffee := ['Americano'].
	( id = 1 ) праўда: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) праўда: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) праўда: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Абʼект новы.
SimpleCoffeeMachine пры: ['order'] выканаць: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Вывад пісаць: redCup, новы-радок.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Вывад пісаць: greenCup, новы-радок.
>> yellowCup := CoffeeMachine order: 1.
Вывад пісаць: yellowCup, новы-радок.
>> blueCup := CoffeeMachine order: 0.
Вывад пісаць: blueCup, новы-радок.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Вывад пісаць: blackCup, новы-радок.
blackCup дадаць-у-канец: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Вывад пісаць: orangeCup, новы-радок.
