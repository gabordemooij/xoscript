Лік пры: ['roman'] выканаць: {
	>> лік := сам капіяваць.
	>> roman := [''].
	{
		{
			(лік ≥ 1000) праўда: {
				roman дадаць-у-канец: ['Ⅿ'].
				лік адняць: 1000.
			}, перапыніць.
		
			(лік ≥ 500) праўда: {
				roman дадаць-у-канец: ['Ⅾ'].
				лік адняць: 500.
			}, перапыніць.
		
			(лік ≥ 100) праўда: {
				roman дадаць-у-канец: ['Ⅽ'].
				лік адняць: 100.
			}, перапыніць.
		
			(лік ≥ 50) праўда: {
				roman дадаць-у-канец: ['Ⅼ'].
				лік адняць: 50.
			}, перапыніць.
		
			(лік ≥ 50) праўда: {
				roman дадаць-у-канец: ['Ⅼ'].
				лік адняць: 50.
			}, перапыніць.
		
			(лік ≥ 10) праўда: {
				roman дадаць-у-канец: ['Ⅹ'].
				лік адняць: 10.
			}, перапыніць.
			
			(лік ≥ 9) праўда: {
				roman дадаць-у-канец: ['Ⅸ'].
				лік адняць: 9.
			}, перапыніць.
			
			(лік ≥ 5) праўда: {
				roman дадаць-у-канец: ['Ⅴ'].
				лік адняць: 5.
			}, перапыніць.
			
			(лік ≥ 4) праўда: {
				roman дадаць-у-канец: ['Ⅳ'].
				лік адняць: 4.
			}, перапыніць.
			
			(лік ≥ 1) праўда: {
				roman дадаць-у-канец: ['Ⅰ'].
				лік адняць: 1.
			}, перапыніць.
		} працэдура.
	} пакуль: { <- лік > 0. }. <- roman.
}.

Вывад пісаць: 1 roman, новы-радок.
