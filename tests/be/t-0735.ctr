Server init.
>> a := Blob новы: 4.
a bytes: ( Спіс новы ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob новы: 4.
b bytes: ( Спіс новы ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
# inherited blob does not get the buffer, so it's useless
# it will pass ctr_accept() but since buffer ptr == null, it will retur
>> c := a новы.
{ 
>> n := a ^ c.
Вывад пісаць: ['xorred:'], новы-радок. 
Вывад пісаць: n, новы-радок. 
} перахапіць: { :e Вывад пісаць: e, новы-радок. }, запусціць.
a вызваліць.
b вызваліць.
