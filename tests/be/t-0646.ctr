Server init.
Вывад пісаць: ['Database datetime test'], новы-радок.

>> db := Maria-DB новы хост: ['localhost'],
	карыстальнік: ['xo'], 
	пароль: ['pass123'],
	назва-базы: ['xobase'],
	падключыць.

>> параметры-пошуку :=
db запыт: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
атрымаць: { :row
	Вывад пісаць: row datetimetest, новы-радок.
}.
