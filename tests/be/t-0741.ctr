Вывад пісаць: ['Test object'], новы-радок.
>> a := Абʼект новы. 

a пры: ['item:'] выканаць: { :octhelper
	свой octhelper := octhelper. 
}.

a пры: ['item'] выканаць: { <- свой octhelper.
}.

a item: Oct новы.

>> old-octhelper-address := a item прататып адрас-памяці.
a save-as: ['/tmp/a.bin'].
Вывад пісаць: ['========== RELOADING SNAP:'], новы-радок.

>> b := Абʼект load-from: ['/tmp/a.bin'].

(b item прататып адрас-памяці = old-octhelper-address) праўда: {
	Вывад пісаць: ['Object link re-attached.'], новы-радок.
}.
