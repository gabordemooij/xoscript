Спіс пры: ['sum'] выканаць: {
	>> total := 0.
	сам кожны: { :index :element
		total дадаць: element.
	}. <- total.
}.

>> a := Праўда.



a пры: ['тэкст'] выканаць: {
	>> answer := Нішто.
	( сам = Праўда ) праўда: {
		answer := ['Yep'].
	}, інакш: {
		answer := ['Nope'].
	}. <- answer.
}.

a пры: ['лік'] выканаць: {
	>> answer := Нішто.
	( сам = Праўда ) праўда: {
		answer := 10.
	}, інакш: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b пры: ['тэкст'] выканаць: { <- ['Devil'].
}.

b пры: ['лагічны'] выканаць: { <- Хлусня.
}.


Вывад пісаць: a, новы-радок.  
Вывад пісаць: (90 + a), новы-радок. 
Вывад пісаць: b, новы-радок. 
Вывад пісаць: (Праўда і: b), новы-радок.

a := Спіс ← ['hello'] ; ['world'] ; Праўда ; Нішто ; 666. 
a := a + ( Спіс ← 1 ).
Вывад пісаць: a, новы-радок.
Вывад пісаць: ((Слоўнік новы) пакласці: Нішто на: Нішто), новы-радок.
Вывад пісаць: a sum, новы-радок. 


{
	a пры: ['тэкст'] выканаць: { <- Нішто. }.
	a := [''] + a.
} перахапіць: { :error
	Вывад пісаць: ['Error noted: '] + error, новы-радок.
}, запусціць.



