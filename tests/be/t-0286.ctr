['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Вывад пісаць: (x + y), новы-радок.

>> x := 10040.07.
>> y := 10305.60.

Вывад пісаць: (x + y), новы-радок.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Вывад пісаць: (x + y + z), новы-радок.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Вывад пісаць: (x + y + z), новы-радок.

>> q := 0.1.2.

Вывад пісаць: (q), новы-радок.

>> q := 012.

Вывад пісаць: (q), новы-радок.
