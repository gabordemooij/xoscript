# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Шаблон новы: pattern.
	p супадзенне: subject выканаць: { :m :g
		Вывад пісаць: g колькасць, пісаць: [' '], пісаць: (g злучыць: ['|']), новы-радок. <- m.
	}.
}.
show прымяніць: ['(a)|(b)'] і: ['b'].
show прымяніць: ['(a)|(b)'] і: ['a'].
show прымяніць: ['(x)?y'] і: ['y'].
show прымяніць: ['(x)?(y)(z)?'] і: ['xy'].
