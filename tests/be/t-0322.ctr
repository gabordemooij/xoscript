

>> Matryoshka := Абʼект новы.
Matryoshka пры: ['double:'] выканаць: { :secret
	свой secret := secret × 2.
}.
Matryoshka пры: ['новы:'] выканаць: { :secret
	>> answer := Нішто.
	>> t := (secret > 255).
	Вывад пісаць: (secret + [' | '] + t), новы-радок.
	t праўда: {
		answer := secret.
	}, інакш: {
		answer := Matryoshka рэкурсіўны новы: (сам double: secret).
	}. <- answer.
}.

>> x := Matryoshka новы: 2.
