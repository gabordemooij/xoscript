Лік пры: ['factorial'] выканаць: {
	>> total := 1.
	{ :index total памножыць-на: (сам - index). } × сам. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Праграма кіраванне-памяццю: 0.

{
2 exponent factorial.
Вывад пісаць: (11 модуль: 3), новы-радок.
Вывад пісаць: (3.4 акругліць), новы-радок.
Вывад пісаць: (7.1 акругліць-уверх), новы-радок.
Вывад пісаць: (7.9 акругліць-уніз), новы-радок.
}
запусціць.

Праграма прыбраць.

usedMemory1 := (Праграма памяць ? 0).

{
2 exponent factorial.
Вывад пісаць: (11 модуль: 3), новы-радок.
Вывад пісаць: (3.4 акругліць), новы-радок.
Вывад пісаць: (7.1 акругліць-уверх), новы-радок.
Вывад пісаць: (7.9 акругліць-уніз), новы-радок.
}
запусціць.

Праграма прыбраць.
usedMemory2 := (Праграма памяць ? 0).


{
2 exponent factorial.
Вывад пісаць: (11 модуль: 3), новы-радок.
Вывад пісаць: (3.4 акругліць), новы-радок.
Вывад пісаць: (7.1 акругліць-уверх), новы-радок.
Вывад пісаць: (7.9 акругліць-уніз), новы-радок.
} запусціць.

Праграма прыбраць.
usedMemory3 := (Праграма памяць ? 0).



( usedMemory1 = usedMemory2 і: usedMemory1 = usedMemory3, і: usedMemory2 = usedMemory3 ) праўда: {
	Вывад пісаць: ['No memory leaks here'].
}, хлусня: {
	Вывад пісаць: ['Leaking memory...'].
}.
