60 × {
	>> x := (Лік random % 6) + 1.
	(x ≤ 6) хлусня: { Вывад пісаць: ['FAIL']. }.
	(x ≥0) хлусня: { Вывад пісаць: ['FAIL']. }.
	x := (Лік random % 3) + 1.
	(x < 3) хлусня: { Вывад пісаць: ['FAIL']. }.
	(x>-1) хлусня: { Вывад пісаць: ['FAIL']. }.
	x := ((Лагічны flip) лік).
	(x = 0 альбо: x = 1) хлусня: { Вывад пісаць: ['FAIL']. }.
	x := ((Праўда flip) лік).
	(x = 0 альбо: x = 1) хлусня: { Вывад пісаць: ['FAIL']. }.
	x := (Лагічны flip альбо: ['HEAD'] альбо: ['TAIL']).
	((x = ['HEAD']) альбо: (x = ['TAIL'])) хлусня: { Вывад пісаць: ['FAIL']. }.
}.
Вывад пісаць: ['DONE'].

