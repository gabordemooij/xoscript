#OBSD
>> dirname := [''].
{ dirname дадаць-у-канец: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Праграма сістэма: command.
Праграма chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename дадаць-у-канец: ['YYYYYYYY']. } * 20.
Файл новы: filename, пісаць: ['sometext'].
{ Файл спіс: ['/tmp/'] + dirname. } * 1000.
Вывад пісаць: ['no crash'], новы-радок.

