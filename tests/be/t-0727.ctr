Server init.
>> f := Фармат новы: ['%d'].
>> a := Blob новы: 4.
a bytes: ( Спіс новы ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob новы: 4.
b bytes: ( Спіс новы ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a ад: 0 даўжыня: 3, кожны: { :i :byte
	Вывад пісаць: ( f прымяніць-цэлы: byte ), новы-радок.
}.
a ^ b.
a ад: 0 даўжыня: 3, кожны: { :i :byte
	Вывад пісаць: ( f прымяніць-цэлы: byte ), новы-радок.
}.
a ^ b.
a ад: 0 даўжыня: 3, кожны: { :i :byte
	Вывад пісаць: ( f прымяніць-цэлы: byte ), новы-радок.
}.
a вызваліць.
b вызваліць.

{ a ^ Абʼект. } перахапіць: { :e Вывад пісаць: e, новы-радок. }, запусціць.
