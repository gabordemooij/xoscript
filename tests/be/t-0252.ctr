#Linux
>> clock := Момант новы.
clock зона: ['UTC-1'].
clock год: 1981, месяц: 1, дзень: 5,
      гадзіна: 13, хвіліна: 15, секунда: 13.

Вывад пісаць: clock, новы-радок.
clock зона: ['UTC+0'].

Вывад пісаць: (
	(clock год просты) + ['-'] + (clock месяц) + ['-'] + (clock дзень) + [' '] +
	(clock гадзіна) + [':'] + (clock хвіліна) + [':'] + (clock секунда) + [' '] +
	['W'] + (clock тыдзень) + (clock зона)
), новы-радок.


clock зона: ['UTC-1'].
Вывад пісаць: (
	(clock год просты) + ['-'] + (clock месяц) + ['-'] + (clock дзень) + [' '] +
	(clock гадзіна) + [':'] + (clock хвіліна) + [':'] + (clock секунда) + [' '] +
	['W'] + (clock тыдзень) + (clock зона)
), новы-радок.
