#Linux
>> Slurp := Абʼект новы.

Slurp пры: ['новы'] выканаць: {
	свой str := [''].
}.

Slurp пры: ['nieuw'] выканаць: {
	свой str := [''].
}.

Slurp пры: ['адказаць:'] выканаць: { :blah
		свой str дадаць-у-канец: blah.
}.

Slurp пры: ['адказаць:і:'] выканаць: { :blah :blahah
		свой str дадаць-у-канец: (blah ад: 0 даўжыня: (blah даўжыня - 1)).
		свой str дадаць-у-канец: [' '].
		свой str дадаць-у-канец: blahah.
}.

Slurp пры: ['obtain'] выканаць: {
	>> buffer := свой str.
	свой str := ['']. <- buffer.
}.


Вывад пісаць: (Праграма сістэма: (Slurp новы echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Файл новы: ['/tmp/from.txt'], выдаліць. } перахапіць: { ['Empty']. }, запусціць.
{ Файл новы: ['/tmp/to.txt'], выдаліць. } перахапіць: { ['Empty']. }, запусціць.


Файл новы: ['/tmp/to.txt'], існуе хлусня: {
	Вывад пісаць: ['Confirmed. Target file does not exist.\
'].
}.
Файл новы: ['/tmp/from.txt'], існуе хлусня: {
	Вывад пісаць: ['Confirmed. Source file does not exist.\
'].
}.



Праграма сістэма: (Slurp новы touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Праграма сістэма: (Slurp новы cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Файл новы: ['/tmp/to.txt'], існуе праўда: {
	Вывад пісаць: ['Confirmed. Target file has been created by shell.\
'].
}.


Вывад пісаць: ['Contents of file is:'] + (Файл новы: ['/tmp/to.txt'], чытаць), новы-радок.
