Праграма кіраванне-памяццю: 4.

>> Doubler := Абʼект новы.
>> Multiplier := Абʼект новы.
Doubler пры: ['double:and:'] выканаць: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier пры: ['multiply:and:'] выканаць: { :x :y <- (x × y).
}.

Вывад пісаць: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), новы-радок.
