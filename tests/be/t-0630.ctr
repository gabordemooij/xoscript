#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Шаблон новы: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern супадзенне: subject выканаць: { :m :x
	Вывад пісаць: m, новы-радок.
	Вывад пісаць: x, новы-радок. <- ['XXX'].
}.
Вывад пісаць: result, новы-радок.