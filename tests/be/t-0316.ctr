>> Grandfather := Абʼект новы.
Grandfather пры: ['greet'] выканаць: {
	Вывад пісаць: ['Ave!'], новы-радок.
}.
>> Father := Grandfather новы.
Father пры: ['greet'] выканаць: {
	Вывад пісаць: ['Hello'], новы-радок.
	сам greet.
}.
>> Son := Father новы.
Son пры: ['greet'] выканаць: {
	Вывад пісаць: ['Hi'], новы-радок.
	сам greet.
}.

Son greet.

>> Roundabout := Абʼект новы.
Roundabout пры: ['circle:'] выканаць: { :x
	Вывад пісаць: x, новы-радок.
	(x < 3) праўда: { сам рэкурсіўны circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) праўда: { Вывад пісаць: x, новы-радок. x дадаць: 1.  increment запусціць. }. }.
increment запусціць.