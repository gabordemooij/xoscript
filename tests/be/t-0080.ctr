{
	>> a := Спіс новы.
	a дадаць-у-канец: 1.
	a дадаць-у-канец: 2.
	Вывад пісаць: (a злучыць: [',']), новы-радок.
	a пакласці: 3 на: 2.
	Вывад пісаць: (a злучыць: [',']), новы-радок.
	a пакласці: 4 на: 10.
	Вывад пісаць: (a злучыць: [',']), новы-радок.
	a выняць-першы.
	a выняць-першы.
	a выняць-першы.
	Вывад пісаць: (a злучыць: [',']), новы-радок.
	a пакласці: 9 на: 0.
	Вывад пісаць: (a злучыць: [',']), новы-радок.
