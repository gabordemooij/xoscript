Тэкст пры: ['html'] выканаць: { <- (
		сам
		замяніць: ['&'] на: ['&amp;'],
		замяніць: ['<'] на: ['&lt;'],
		замяніць: ['>'] на: ['&gt;'],
		замяніць: ['''] на: ['&apos;'],
		замяніць: ['"'] на: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Праграма кіраванне-памяццю: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Вывад пісаць: txt капіяваць html, новы-радок.
Вывад пісаць: txt капіяваць малыя-літары, новы-радок.
Вывад пісаць: txt капіяваць вялікія-літары, новы-радок.
} запусціць.

Праграма прыбраць.

usedMemory1 := (Праграма памяць ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Вывад пісаць: txt капіяваць html, новы-радок.
Вывад пісаць: txt капіяваць малыя-літары, новы-радок.
Вывад пісаць: txt капіяваць вялікія-літары, новы-радок.
} запусціць.

Праграма прыбраць.
usedMemory2 := (Праграма памяць ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Вывад пісаць: txt капіяваць html, новы-радок.
Вывад пісаць: txt капіяваць малыя-літары, новы-радок.
Вывад пісаць: txt капіяваць вялікія-літары, новы-радок.
} запусціць.

Праграма прыбраць.
usedMemory3 := (Праграма памяць ? 0).



( usedMemory1 = usedMemory2 і: usedMemory1 = usedMemory3, і: usedMemory2 = usedMemory3 ) праўда: {
	Вывад пісаць: ['No memory leaks here'].
}, хлусня: {
	Вывад пісаць: ['Leaking memory...'].
}.
