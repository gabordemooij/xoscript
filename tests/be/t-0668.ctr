# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob новы: 8, bytes: (
	Спіс новы ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Вывад пісаць: ( utf16 дэкадаваць: ['utf16le'] ), новы-радок.

utf16 вызваліць.
>> utf32 := Blob новы: 13, bytes: (
	Спіс новы ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Вывад пісаць: ( utf32 дэкадаваць: ['utf32be'] ), новы-радок.
utf32 вызваліць.