Вывад пісаць: ['Test object'], новы-радок.
>> a := Абʼект новы. 

a пры: ['item:'] выканаць: { :fmt
	свой fmt := fmt. 
}.

a пры: ['item'] выканаць: { <- свой fmt.
}.

a item: ( Фармат новы: ['|%s|'] ).

Вывад пісаць: a item, новы-радок.

>> old-fmt-address := a item прататып адрас-памяці.
a save-as: ['/tmp/a.bin'].
Вывад пісаць: ['========== RELOADING SNAP:'], новы-радок.

>> b := Абʼект load-from: ['/tmp/a.bin'].

(b item прататып адрас-памяці = old-fmt-address) праўда: {
	Вывад пісаць: ['Object link re-attached.'], новы-радок.
}.

Вывад пісаць: ( b item прымяніць: ['hello'] ), новы-радок.
