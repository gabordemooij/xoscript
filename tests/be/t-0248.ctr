

Тэкст пры: ['evaluate'] выканаць: {
	>> код := Файл новы: ['/tmp/eval.ctr'].
	код пісаць: сам тэкст + ['.'].
	Праграма выкарыстаць: ['/tmp/eval.ctr'].
}.

>> a := (Спіс ← (
	(Слоўнік новы)
		пакласці: ['domain'] на: ['mywebsite.com'],
		пакласці: (Спіс ←
			((Слоўнік новы)
				пакласці: ['home'] на: ['title'],
				пакласці: ['<html></html>'] на: ['body'],
				пакласці: ['2017-01-01'] на: ['created']
			) ;
			((Слоўнік новы)
				пакласці: ['aboutus(c)'] на: ['title'],
				пакласці: ['<credits>Author Inc.</credits>'] на: ['body']
			)
		) на: ['pages']
	)
) тэкст.

Вывад пісаць: a тып, новы-радок.
Вывад пісаць: a, новы-радок.

>> b := Нішто.
(['b := '] + a) evaluate.
Вывад пісаць: b ? 0 ? ['pages'] ? 1 ? ['body'], новы-радок.

>> c := b ? 0.
>> d := c тэкст.
Вывад пісаць: d тып, новы-радок.

>> e := Нішто.
(['e := '] + d) evaluate.
Вывад пісаць: e ? ['pages'] ? 0, новы-радок.
