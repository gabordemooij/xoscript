Server init.

>> db := Maria-DB новы хост: ['localhost'],
	карыстальнік: ['xo'],
	пароль: ['pass123'],
	назва-базы: ['xobase'],
	падключыць.

>> del := db запыт: ['DELETE FROM book WHERE id > 0'].
{  del выканаць. db пацвердзіць. } перахапіць: { :e db адкаціць.  }, запусціць.

>> колькасць := db запыт: ['SELECT COUNT(*) AS num FROM book'].
колькасць атрымаць: { :row Вывад пісаць: row num, новы-радок. }.
