>> randomizer := { :a :b
	>> мінімум := ( a < b ) альбо: a альбо: b.
	>> максімум := ( a > b ) альбо: a альбо: b.
	>> x := Нішто.
	{
		x := Лік паміж: a і: b.
		((x < мінімум) альбо: (x > максімум)) праўда: { 
			Вывад пісаць: (['Invalid value!']).
			Праграма канец.
		}.
	} 
	× 100. <- x.
}.
