# compliance test

# use international numbers

Вывад пісаць: ['1000 -> '].
Вывад пісаць: 1000, новы-радок. #1000

Вывад пісаць: ['1.5 -> '].
Вывад пісаць: 1.5, новы-радок.  #1.5

Вывад пісаць: ['1001.5 -> '].
Вывад пісаць: 1.5 + 1000, новы-радок. #1001.5

# use 0-indexed arrays
>> x := Спіс новы ; 1 ; 2 ; 3.
>> y := Спіс новы ; ['a'] ; ['b'] ; ['c'].

Вывад пісаць: ['1 -> '].
Вывад пісаць: x ? 0, новы-радок. #1

Вывад пісаць: ['1 -> '].
Вывад пісаць: (x на: 0), новы-радок. #1

Вывад пісаць: ['1 -> '].
Вывад пісаць: x першы, новы-радок. #1

Вывад пісаць: ['3 -> '].
Вывад пісаць: x апошні, новы-радок. #3

Вывад пісаць: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Вывад пісаць: (x паводле: y), новы-радок.

Вывад пісаць: ['1 -> '].
Вывад пісаць: (x ад: 0 даўжыня: 1) першы, новы-радок. #1

Вывад пісаць: ['0 -> '].
Вывад пісаць: (x знайсці: 1), новы-радок. #0

x пакласці: 9 на: 0.

Вывад пісаць: ['9 -> '].
Вывад пісаць: (x на: 0), новы-радок. #9

x дадаць-у-пачатак: 8.
Вывад пісаць: ['8 -> '].
Вывад пісаць: (x на: 0), новы-радок. #9


x дадаць-у-канец: 10.
Вывад пісаць: ['10 -> '].
Вывад пісаць: (x на: 4), новы-радок. #10








