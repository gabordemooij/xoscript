>> z := Абʼект новы.
z пры: ['value:'] выканаць: { :v
	свой value := v. <- сам.
}.
z пры: ['value'] выканаць: { <- свой value. }.
(z setValue: 1) value: 2.
Вывад пісаць: z value.
>> x := z.
Вывад пісаць: x value.
z := Нішто.
Вывад пісаць: z value.
Вывад пісаць: x value.
Вывад пісаць: ['hello'].
Вывад пісаць: 3 + 2.
