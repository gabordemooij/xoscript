
Тэкст пры: ['html'] выканаць: { <- (
		сам
		замяніць: ['&'] на: ['&amp;'],
		замяніць: ['<'] на: ['&lt;'],
		замяніць: ['>'] на: ['&gt;'],
		замяніць: ['"'] на: ['&quot;']
	).
}.

>> HtmlBrush := Абʼект новы.

HtmlBrush пры: ['адказаць:'] выканаць: { :tag
	Вывад пісаць: (['<tag>↵'] tag: tag ).
}.

HtmlBrush пры: ['адказаць:і:'] выканаць: { :tag :content
	tag := ( tag ад: 0 даўжыня: (tag даўжыня - 1) ).
	Вывад пісаць: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush пры: ['content:'] выканаць: { :text
	Вывад пісаць: text html, новы-радок.
}.

HtmlBrush пры: ['attr:value:'] выканаць: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush новы.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
