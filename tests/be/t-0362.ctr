Вывад пісаць: (['a:b:'] - [':']), новы-радок.
Вывад пісаць: (['Lorem Ipsum'] - ['Ipsum']), новы-радок.
Вывад пісаць: (['a.................b.......................c...........'] - ['.']), новы-радок.
Вывад пісаць: (['a--b--c---d'] - ['--']), новы-радок.
Вывад пісаць: (['-'] - ['--']), новы-радок.
Вывад пісаць: ([''] - ['--']), новы-радок.
Вывад пісаць: (['--'] - ['']), новы-радок.
Вывад пісаць: ([''] - ['']), новы-радок.
>> x := ['xx'].
>> y := x - ['x'].
Вывад пісаць: x, новы-радок.
Вывад пісаць: y, новы-радок.
>> x := ['a,bb,c'].
>> y := x замяніць: [''] на: ['xx'].
Вывад пісаць: ((x роўна: y) альбо: ['OK'] альбо: ['BUG! Did return a copy by accident!']), новы-радок.