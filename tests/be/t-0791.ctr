Server init.

>> DB := Maria-DB новы хост: ['localhost'],
	карыстальнік: ['xo'],
	пароль: ['pass123'],
	назва-базы: ['xobase'],
	падключыць.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> параметры-пошуку := Maria-Запыт новы: SQL.

# set database
параметры-пошуку база-даных: DB.

параметры-пошуку атрымаць: { :row
	Вывад пісаць: row world, новы-радок.
}.
