>> makeAdder := { :x
	>> f := { :y <- (свой x + y). } задаць: ['x'] значэнне: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i свой q пакласці: (свой f прымяніць: (свой q ? i)) на: i. } 
	задаць: ['q'] значэнне: array,
	задаць: ['f'] значэнне: func.
	{ :i mapping прымяніць: i. } × (array колькасць).
}.

>> a := Спіс ← 1; 2; 3.
mapper прымяніць: a і: (makeAdder прымяніць: 100).
Вывад пісаць: (a пазіцыя: 0), новы-радок.
Вывад пісаць: (a ? 1), новы-радок.
Вывад пісаць: (a ? 2), новы-радок.
