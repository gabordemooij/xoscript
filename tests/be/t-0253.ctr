#Linux
>> OS := Праграма налада: ['OS'].

>> clock := Момант новы.
	
(OS = ['Haiku']) праўда: {
	clock зона: ['CET'],
	год: 2017, месяц: 7, дзень: 13,
	гадзіна: 18, хвіліна: 0, секунда: 0.
}, інакш: {
	clock зона: ['Europe/Amsterdam'],
	год: 2017, месяц: 7, дзень: 13,
	гадзіна: 18, хвіліна: 0, секунда: 0.
}.

clock пры: ['tell'] выканаць: {
	Вывад пісаць: сам, новы-радок.
}.


clock дадаць: 2    гадзіна, tell.
clock дадаць: 1    гадзіна, tell.
clock дадаць: 19 хвіліна, tell.
clock дадаць: 1  хвіліна, tell.
clock дадаць: 1  хвіліна, tell.
clock дадаць: 19 секунда, tell.
clock дадаць: 1  секунда, tell.
clock дадаць: 1  секунда, tell.
clock дадаць: 2    год, tell.
clock дадаць: 1    год, tell.

(OS = ['Haiku']) праўда: {
clock дадаць: 5   месяц.
clock зона: ['CEST'], tell.
}, інакш: {
	clock дадаць: 5   месяц, tell.
}.

clock дадаць: 1   месяц, tell.
clock дадаць: 19    дзень, tell.
clock дадаць: 1    гадзіна, tell.
clock дадаць: 120  yard, tell.
