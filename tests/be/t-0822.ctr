# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := Maria-DB новы хост: ['localhost'],
	карыстальнік: ['xo'],
	пароль: ['pass123'],
	назва-базы: ['xobase'],
	падключыць.

>> параметры-пошуку := db запыт: ['SELECT ? AS a, ? AS b, ? AS c'].
параметры-пошуку параметры: (Спіс новы ; ['1']).
{ параметры-пошуку атрымаць: { :row Вывад пісаць: row, новы-радок. }. } перахапіць: { :e Вывад пісаць: e, новы-радок. }, запусціць.

>> параметры-пошуку := db запыт: ['SELECT ? AS a'].
{ параметры-пошуку атрымаць: { :row Вывад пісаць: row, новы-радок. }. } перахапіць: { :e Вывад пісаць: e, новы-радок. }, запусціць.

# the right number still works, more parameters are ignored as before
>> параметры-пошуку := db запыт: ['SELECT ? AS a, ? AS b'].
параметры-пошуку параметры: (Спіс новы ; ['1'] ; ['2']).
параметры-пошуку атрымаць: { :row Вывад пісаць: (row на: ['a']), пісаць: (row на: ['b']), новы-радок. }.
параметры-пошуку параметры: (Спіс новы ; ['1'] ; ['2'] ; ['3']).
параметры-пошуку атрымаць: { :row Вывад пісаць: (row на: ['a']), пісаць: (row на: ['b']), новы-радок. }.
