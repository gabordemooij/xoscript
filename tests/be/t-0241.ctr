

Тэкст пры: ['evaluate'] выканаць: {
	>> код := Файл новы: ['/tmp/eval.ctr'].
	код пісаць: (сам тэкст + ['.']).
	Праграма выкарыстаць: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Спіс ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q тэкст.
Вывад пісаць: x, новы-радок.
>> y := Нішто.
(['y := '] + x ) evaluate.
Вывад пісаць: y ? 0, новы-радок.

q := Слоўнік пакласці: ['\[''] на: ['\['quote\']'].
x := q тэкст.
Вывад пісаць: x, новы-радок.
y := Нішто.
(['y := '] + x ) evaluate.

>> q := (Слоўнік новы) пакласці:['\[''] на:['\['quote\[''].
Вывад пісаць: y ? ['\['quote\']'], новы-радок.
