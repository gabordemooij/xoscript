# backslashes must survive code serialization, strings must not end early
>> значэнні := Спіс новы
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

значэнні кожны: { :i :value
	>> d := Слоўнік новы.
	d пакласці: value на: ['k'].
	>> r := d код абʼект.
	Вывад пісаць: r колькасць, новы-радок.
	Вывад пісаць: ( (r на: ['k']) = value ), новы-радок.
}.
