

Тэкст пры: ['html'] выканаць: { <- (
		сам
		замяніць: ['&'] на: ['&amp;'],
		замяніць: ['<'] на: ['&lt;'],
		замяніць: ['>'] на: ['&gt;'],
		замяніць: ['"'] на: ['&quot;']
	).
}.


Вывад пісаць: ([' left trimmed '] абрэзаць) + [' '] + ( ['and right trimmed'] абрэзаць) + ['!'], новы-радок.
Вывад пісаць: ['<html>"html & entities"</html>'] html.
