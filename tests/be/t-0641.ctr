# Test utf8 sanitizer
Server init.

>> utf8cases := Слоўнік новы
	# ASCII only
	пакласці: ( Спіс новы ; 65 ; 65 ; 65 ; 65 ; 0 ) на: ['AAAA'],
	# valid 2 byte sequence
	пакласці: ( Спіс новы ; 194 ; 162 ; 0 ) на: ['¢'],
	# Valid 3-byte UTF-8
    пакласці: ( Спіс новы ; 226 ; 130 ; 172 ; 0 ) на: ['€'],
	# Valid 4-byte UTF-8
    пакласці: ( Спіс новы ; 240 ; 144 ; 141 ; 136 ; 0 ) на: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    пакласці: ( Спіс новы ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) на: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    пакласці: ( Спіс новы ; 65 ; 193 ; 129 ; 0 ) на: ['A?'],
	# Invalid first byte (0xFF)
    пакласці: ( Спіс новы ; 255 ; 0 ) на: ['?'],
	# Incomplete multi-byte sequence at end
    пакласці: ( Спіс новы ; 66 ; 226 ; 0 ) на: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    пакласці: ( Спіс новы ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) на: ['A€?𐍈B'].
	 
utf8cases кожны: { :key :value
	>> blob := Blob новы: value колькасць, bytes: value.
	>> str := blob тэкст.
	(str = key) праўда: {
		Вывад пісаць: ['OK'], новы-радок.
	}, інакш: {
		Вывад пісаць: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, новы-радок.
	}.
	blob вызваліць.
}.
