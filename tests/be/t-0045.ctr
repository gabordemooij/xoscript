Праграма кіраванне-памяццю: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } перахапіць: {
		oops дадаць: 1.
	}, запусціць.
} × 1000.

{
	Вывад пісаць: ['hi there!'].
	гэта-задача памылка: ['oops'].
	Вывад пісаць: ['hi there!'].
	{ Вывад пісаць: ['dont print this']. } запусціць.
} перахапіць: { :e 
	Вывад пісаць: ['got ya!']. 
	Вывад пісаць: e.
}, запусціць.
