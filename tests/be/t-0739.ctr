Вывад пісаць: ['Test object'], новы-радок.
>> a := Абʼект новы. 

a пры: ['item:'] выканаць: { :binhelper
	свой binhelper := binhelper. 
}.

a пры: ['item'] выканаць: { <- свой binhelper.
}.

a item: Bin новы.

>> old-binhelper-address := a item прататып адрас-памяці.
a save-as: ['/tmp/a.bin'].
Вывад пісаць: ['========== RELOADING SNAP:'], новы-радок.

>> b := Абʼект load-from: ['/tmp/a.bin'].

(b item прататып адрас-памяці = old-binhelper-address) праўда: {
	Вывад пісаць: ['Object link re-attached.'], новы-радок.
}.


