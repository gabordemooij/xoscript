# test qualifiers

>> $ := Абʼект новы.

$ пры: ['адказаць:'] выканаць: { :x
	
	>> operation := x сімвал: 0.
	>> valuta := x сімвал: 1.
	>> money := x зрушэнне: 2.
	
	>> amount := 0.

	( operation = ['+'] ) праўда: {
		( valuta = ['£'] ) праўда: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Вывад пісаць: x, новы-радок.


>> Fruit := Абʼект новы.

Fruit пры: ['новы'] выканаць: {
	>> f := сам новы.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit пры: ['apples:'] выканаць: { :a свой apples := a. }.
Fruit пры: ['oranges:'] выканаць: { :p свой oranges := p. }.
Fruit пры: ['apples'] выканаць: { <- свой apples. }.
Fruit пры: ['oranges'] выканаць: { <- свой oranges. }.

Fruit пры: ['+'] выканаць: { :f
	
	>> n := Fruit новы.
	f дадаць: 1.
	
	n apples: (f apples + свой apples).
	n oranges:  (f oranges  + свой oranges). <- n.
}.

Fruit пры: ['тэкст'] выканаць: { <- ( свой apples тэкст + [' apples and '] + свой oranges + [' oranges'] ).
}.

Лік пры: ['apples'] выканаць: { <- ((Fruit новы) apples: сам).
}.

Лік пры: ['apple'] выканаць: { <- ((Fruit новы) apples: сам).
}.

Лік пры: ['oranges'] выканаць: { <- ((Fruit новы) oranges: сам).
}.




Вывад пісаць: (1 apple + 3 oranges + 4 apples), новы-радок.


Тэкст пры: ['twice'] выканаць: { <- ((сам тэкст) + (сам тэкст)).
}.



Вывад пісаць: ['❤❤❤'] twice.



