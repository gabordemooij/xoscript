
>> dictionary := (
	Слоўнік новы
		пакласці: ['b'] на: ['a'],
		пакласці: ['a'] на: ['b'],
		пакласці: ['z'] на: ['x'],
		пакласці: ['hello'] на: ['hallo'],
		пакласці: ['human'] на: ['human']
).

>> comparisons := Спіс новы.
dictionary кожны: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a параўнаць: b)
	).
}.

comparisons сартаваць: { :a :b <- ( a параўнаць: b ). }.
Вывад пісаць: ( comparisons злучыць: ['↵'] ), новы-радок.
comparisons злучыць: ['↵'].
