{
	гэта-задача памылка: ['Dont fail.'].
	unknown doSomething.
} перахапіць: {
	Вывад пісаць: ['Caught!'].
}, запусціць.

{
	гэта-задача памылка: ['Dont fail.'].
	свой unknown doSomething.
} перахапіць: {
	Вывад пісаць: ['Caught!'].
}, запусціць.

{
	гэта-задача памылка: ['Dont fail.'].
	unknown := 122.
} перахапіць: {
	Вывад пісаць: ['Caught!'].
}, запусціць.


{
	гэта-задача памылка: ['Dont fail.'].
	Праўда перапыніць.
	Вывад пісаць: ['FAIL'].
} перахапіць: {
	Вывад пісаць: ['Caught!'].
}, запусціць.

{
	{
		гэта-задача памылка: ['Dont fail.'].
		Праўда перапыніць.
		Вывад пісаць: ['FAIL'].
	} перахапіць: { :x
		(x = ['Dont fail.']) праўда: { гэта-задача памылка: ['Nested Caught!']. }.
	}, запусціць.
} перахапіць: { :e
	Вывад пісаць: e.
}, запусціць.
