Лік пры: ['factorial'] выканаць: {
	>> total := 1.
	{ :index total памножыць-на: (сам - (index)). } × сам. <- total.
}.
>> Printer := Абʼект новы.
Printer пры: ['print:and:'] выканаць: { :x :y
	Вывад пісаць: ['a='] + x + [', b='] + y, новы-радок.
}.
>> a := 4.5. >> b := a акругліць-уніз.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a акругліць-уверх.
Printer print: a and: b.
a := 4.5. b := a акругліць-уніз.
Printer print: a and: b.
a := 4.5. b := a акругліць.
Printer print: a and: b.
a := 4.2. b := a акругліць.
Printer print: a and: b.

