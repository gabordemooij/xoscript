>> q := Спіс ← 1 ; 2 ; 3.
{ q ? ['1']. } перахапіць: { Вывад пісаць: ['caught!'], новы-радок. }, запусціць.
{ q ? Праўда. } перахапіць: { Вывад пісаць: ['caught!'], новы-радок. }, запусціць.
{ q ? Хлусня. } перахапіць: { Вывад пісаць: ['caught!'], новы-радок. }, запусціць.
{ q ? Нішто. } перахапіць: { Вывад пісаць: ['caught!'], новы-радок. }, запусціць.
{ q ? (Спіс новы). } перахапіць: { Вывад пісаць: ['caught!'], новы-радок. }, запусціць.
{ q ? (Абʼект новы). } перахапіць: { Вывад пісаць: ['caught!'], новы-радок. }, запусціць.
{ q ? ({ ['Empty']. }). } перахапіць: { Вывад пісаць: ['caught!'], новы-радок. }, запусціць.
Вывад пісаць: ['caught them all'], новы-радок.
