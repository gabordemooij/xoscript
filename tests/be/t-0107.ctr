
Вывад пісаць: ['Break for-loop, 0-4.'], новы-радок.
{ :i
	Вывад пісаць: ['iteration #'] + i, новы-радок.
	(i = 4) перапыніць.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Вывад пісаць: ['Break while-true loop, 0-4.'], новы-радок.
{
	Вывад пісаць: ['iteration #'] + x, новы-радок.
	x дадаць: 1.
	((x < 5) не) перапыніць.
} пакуль: xIsLessThan10.

Вывад пісаць: ['Break while-false loop, 5,4.'], новы-радок.
{
	Вывад пісаць: ['iteration #'] + x, новы-радок.
	x адняць: 1.
	(x = 3) перапыніць.
} пакуль: { <- (x > 0). }.

Вывад пісаць: ['Break times loop, 1-4.'], новы-радок.
{ :i
	Вывад пісаць: ['iteration #'] + i, новы-радок.
	(i = 4) перапыніць.
} × 5.

Вывад пісаць: ['Break block, dont print line.'], новы-радок.
{ Праўда перапыніць. Вывад пісаць: ['dont write this!'], новы-радок. } запусціць.

Вывад пісаць: ['Break block, dont fire catch...'], новы-радок.
{ Праўда перапыніць. Вывад пісаць: ['dont write this!'], новы-радок. } перахапіць: { Вывад пісаць: ['Dont catch this!']. }, запусціць.

Вывад пісаць: ['Test Array each-loop: 0,1'], новы-радок.
(Спіс ← 1 ; 2 ; 3) пераўтварыць: { :i
	Вывад пісаць: ['iteration #'] + i, новы-радок.
	(i = 1) перапыніць.
}.

Вывад пісаць: ['Test Map each-loop: c only'], новы-радок.
>> m := Слоўнік новы.
m пакласці: ['first'] на: ['a'], пакласці: ['second'] на: ['b'], пакласці: ['third'] на: ['c'].
m кожны: { :k :v
	Вывад пісаць: ['iteration'] + v + k, новы-радок.
	Праўда перапыніць.
}.

