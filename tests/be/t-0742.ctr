Вывад пісаць: ['Test object'], новы-радок.
>> a := Абʼект новы. 

a пры: ['item:'] выканаць: { :hexhelper
	свой hexhelper := hexhelper. 
}.

a пры: ['item'] выканаць: { <- свой hexhelper.
}.

a item: Hx новы.

>> old-hexhelper-address := a item прататып адрас-памяці.
a save-as: ['/tmp/a.bin'].
Вывад пісаць: ['========== RELOADING SNAP:'], новы-радок.

>> b := Абʼект load-from: ['/tmp/a.bin'].

(b item прататып адрас-памяці = old-hexhelper-address) праўда: {
	Вывад пісаць: ['Object link re-attached.'], новы-радок.
}.
