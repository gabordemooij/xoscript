# test catch-all methods
>> x13 := Абʼект новы.
x13 пры: ['a'] выканаць: { :a Вывад пісаць: 0, новы-радок. }.
x13 пры: ['a:'] выканаць: { :a Вывад пісаць: a, новы-радок. <- 5. }.
x13 пры: ['a:b:'] выканаць: { :a :b Вывад пісаць: (a + b), новы-радок. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
