Server init.

>> DB := Maria-DB новы хост: ['localhost'],
	карыстальнік: ['xo'],
	пароль: ['pass123'],
	назва-базы: ['xobase'],
	падключыць.

{
	DB запыт:
	['DROP TABLE movies'],
	выканаць.
} перахапіць: { Нішто. }, запусціць.

DB запыт:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
выканаць.

DB запыт: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
параметры: ( Спіс новы ; ['Halloween'] ),
выканаць.

DB запыт: ['SELECT * FROM movies'],
атрымаць: { :movie
	Вывад пісаць: movie title, новы-радок.
}.

