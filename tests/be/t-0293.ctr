
>> city := Спіс ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Спіс ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature паводле: city.
>> cities := weather запісы сартаваць: { :a :b <- (a параўнаць: b). }.
>> temperatures := weather значэнні сартаваць: { :a :b <- (a параўнаць: b) адмоўны?. }.

Вывад пісаць: (cities злучыць: [',']), новы-радок.
Вывад пісаць: (temperatures злучыць: [',']), новы-радок.
