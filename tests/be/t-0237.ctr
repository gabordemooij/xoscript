
Тэкст пры: ['evaluate'] выканаць: {
	>> код := Файл новы: ['/tmp/eval.ctr'].
	код пісаць: (сам тэкст + ['.']).
	Праграма выкарыстаць: ['/tmp/eval.ctr'].
}.

>> map :=
	(Слоўнік новы)
	пакласці: ['Hi There'] на: ['two'],
	пакласці: (Спіс ← ['hello'] ; ['world'] ; (Спіс ← 1 ; 2; 9) ; Хлусня) на: ['one'],
	пакласці: ( (Слоўнік новы) пакласці: ['wrrld'] на: ['misspelled'] ) на: ['three'],
	пакласці: (Спіс ← ((Слоўнік новы) пакласці: ['treasure'] на: ['hidden']) ; 2) на: ['four']. 
>> str := map тэкст.
>> map2 := Нішто.
(['map2 := '] + str ) evaluate.
Вывад пісаць: map2 ? ['one'] ? 0.
Вывад пісаць: map2 ? ['one'] ? 1.
Вывад пісаць: map2 ? ['four'] ? 0 ? ['hidden'].
Вывад пісаць: map2 ? ['one'] ? 2 ? 2.
