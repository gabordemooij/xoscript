>> V := Абʼект.
V пры: ['тэкст'] выканаць: {
	Вывад пісаць: ['cast'], новы-радок. <- ['abc'].
}.

Вывад пісаць: ( Праграма налада: ['abc'] ), новы-радок.

# params should not get gc'ed
Праграма налада: ([''] + V новы) значэнне: ([''] + V новы).

Вывад пісаць: ( Праграма налада: ['abc'] ), новы-радок.
