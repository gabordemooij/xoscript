Server init.
>> fmt := Фармат новы: ['%#3x'].

>> blob := Blob новы: 4.
blob bytes: ( 
	Спіс новы ; 0 ; 1 ; 2 ; 3
).

>> file := Файл новы: ['/tmp/blob'].
file blob: blob.
blob вызваліць.

>> чытаць := file blob.
чытаць 
ад: 0 
даўжыня: 4, 
рабіць кожны: { :i :b 
	Вывад
	пісаць: (fmt прымяніць-цэлы: b),
	новы-радок.
}.
чытаць вызваліць.
