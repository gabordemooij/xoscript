Вывад пісаць: ['Test object'], новы-радок.
>> greeter := Абʼект новы.
greeter пры: ['name:'] выканаць: { :імя
	свой xname := імя. 
}.
greeter пры: ['greet'] выканаць: {
	Вывад пісаць: ['Hello '] + свой xname, новы-радок.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Вывад пісаць: ['========== RELOADING SNAP:'], новы-радок.
>> b := Абʼект load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
