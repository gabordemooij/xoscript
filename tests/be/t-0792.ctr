Server init.

>> DB := Maria-DB новы хост: ['localhost'],
	карыстальнік: ['xo'],
	пароль: ['pass123'],
	назва-базы: ['xobase'],
	падключыць.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB запыт: SQL.

# now you don't have to set DB
query2 атрымаць: { :row
	Вывад пісаць: row world, новы-радок.
}.
