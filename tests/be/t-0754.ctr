Вывад пісаць: ['Test object'], новы-радок.
>> a := Абʼект новы. 

a пры: ['item:'] выканаць: { :out
	свой out := out. 
}.

a пры: ['item'] выканаць: { <- свой out.
}.

a пры: ['greet'] выканаць: {
	Вывад пісаць: ['hi from original out!'], новы-радок.
}.

a item: Вывад.

Вывад пісаць: a item, новы-радок.

>> old-out-address := a item прататып адрас-памяці.
a save-as: ['/tmp/a.bin'].
Вывад пісаць: ['========== RELOADING SNAP:'], новы-радок.

>> b := Абʼект load-from: ['/tmp/a.bin'].

(b item прататып адрас-памяці = old-out-address) праўда: {
	Вывад пісаць: ['Object link re-attached.'], новы-радок.
}.

b item пісаць: ['hello from loaded out!'], новы-радок.
b greet.
