# test list operations


>> cakes := Спіс ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes замяніць: 1 даўжыня: 2 на: ( Спіс ← ['cinnamon'] ; ['pineapple'] ).
Вывад пісаць: (buy злучыць: [',']), новы-радок.


>> buy := cakes замяніць: 1 даўжыня: 12 на: ( Спіс ← ['cinnamon'] ; ['pineapple'] ).
Вывад пісаць: (buy злучыць: [',']), новы-радок.


>> buy := cakes замяніць: 2 даўжыня: 10 на: ( Спіс новы ).
Вывад пісаць: (buy злучыць: [',']), новы-радок.


>> buy := cakes замяніць: 0 даўжыня: 1 на: ( Спіс новы ).
Вывад пісаць: (buy злучыць: [',']), новы-радок.


>> buy := cakes замяніць: ['0'] даўжыня: ['1'] на: ['x'].
Вывад пісаць: (buy злучыць: [',']), новы-радок.
