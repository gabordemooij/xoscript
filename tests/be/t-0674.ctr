# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> шлях := ['/tmp/dat.csv'].
>> csv := Файл новы: шлях.
csv пісаць: s.

# accepts CRLF LF CR, varying row length
csv раздзяляльнік: [';'] двукоссе: ['"'] радкі: { :line
	Праграма прыбраць.
	Вывад пісаць: line, новы-радок.
	Праграма прыбраць.
}.

# unequal lines
s дадаць-у-канец: ['\njustone'].
csv пісаць: s.
{
	csv раздзяляльнік: [';'] двукоссе: ['"'] радкі: { :line
		Вывад пісаць: line, новы-радок.
	}.
} перахапіць: { :e 
	Вывад пісаць: e, новы-радок.
}, запусціць.

# invalid format
s := ['"he"llo";world'].
csv пісаць: s.
{
	csv раздзяляльнік: [';'] двукоссе: ['"'] радкі: { :line
		Вывад пісаць: line, новы-радок.
	}.
} перахапіць: { :e 
	Вывад пісаць: e, новы-радок.
}, запусціць.
