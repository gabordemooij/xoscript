>> a := Спіс ← Абʼект ; Праўда ; Хлусня ; Лагічны ; 1 ; Лік ; ['Str'] ; Тэкст ; { ['Empty']. }.
Вывад пісаць: (a колькасць), новы-радок.
{ :i
	Вывад пісаць: 
	['a '] + 
	((a ? i) тып) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Нішто?) альбо: [''] альбо: ['NOT']) + 
	[' Nil.'],
	новы-радок.
} × (a колькасць).
Вывад пісаць: ['but.. Nil is.. '] + ((Нішто Нішто?) альбо: ['certainly NIL!'] альбо: ['not NIL??']), новы-радок.