Server init.

Вывад пісаць: (
	Шаблон новы: ['^\\w+$'],
	супадзенне: ['test@example.com'] 
), новы-радок. # 0 match, fails on @ and .

Вывад пісаць: (
	Шаблон новы: ['^[^@]+@[^\.]+\.\\w+$'],
	супадзенне: ['test@example.com'] 
), новы-радок. # 1 match

Вывад пісаць: (
	Шаблон новы: ['[^@]+@[^\.]+\.\\w+'],
	супадзенне: ['test@example.com'] 
), новы-радок. # 1 match

Вывад пісаць: (
	Шаблон новы: ['([^@]+)@([^\.]+)\.\\w+'],
	супадзенне: ['test@example.com'] 
), новы-радок. # 1 match, groups dont matter

Вывад пісаць: (
	Шаблон новы: ['[a-z]'],
	супадзенне: ['test@example.com'] 
), новы-радок. # 14 matches

Вывад пісаць: (
	Шаблон новы: ['.*'],
	супадзенне: ['test@example.com'] 
), новы-радок. # 1 match (all)

Вывад пісаць: (
	Шаблон новы: ['(.*)'],
	супадзенне: ['test@example.com'] 
), новы-радок. # 1 match (all)

Вывад пісаць: (
	Шаблон новы: ['\\s*[^@]+@[^\.]+\.\\w+'],
	супадзенне: ['test@example.com'] 
), новы-радок. # 1 match, prefix space optional, gets ignored