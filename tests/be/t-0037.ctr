>> a := 3.
>> b := a капіяваць.
a адняць: 1.
Вывад пісаць: [' a = '] + a.
Вывад пісаць: [' b = '] + b.
a := 3.
b := a + 4.
Вывад пісаць: [' a = '] + a.
Вывад пісаць: [' b = '] + b.
>> x := 3.
>> y := x капіяваць.
x дадаць: 10.
y адняць: 1.
Вывад пісаць: [' x = '] + x.
Вывад пісаць: [' y = '] + y.
>> q := Абʼект новы.
q пры: ['setProperty:'] выканаць: { :x
	свой prop := x.
}.
q пры: ['getProperty'] выканаць: { <- свой prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Вывад пісаць: [' p = '] + (p getProperty).
