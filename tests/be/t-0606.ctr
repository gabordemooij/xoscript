>> Point := Абʼект новы.
Point пры: ['x-coordinate:'] выканаць: { :x свой x := x. }.
Point пры: ['y-coordinate:'] выканаць: { :y свой y := y. }.
Point пры: ['x-coordinate']  выканаць: { <- свой x капіяваць. }.
Point пры: ['y-coordinate']  выканаць: { <- свой y капіяваць. }.

Point пры: ['='] выканаць: { :other <- ( свой x = other x-coordinate
		 і: свой y = other y-coordinate ).
}.

>> pier := Point новы x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point новы x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point новы x-coordinate: 5, y-coordinate: 6.

Вывад пісаць: pier = town-hall, новы-радок.
Вывад пісаць: pier = restaurant, новы-радок.
