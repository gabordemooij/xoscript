>> Animal := Абʼект новы.
Animal пры: ['make'] выканаць: {
	>> animal := Абʼект новы.
	animal пры: ['makeSound'] выканаць: {
		Вывад пісаць: свой sound.
	}. <- animal.
}.
>> Cat := Абʼект новы.
Cat пры: ['make'] выканаць: {
	>> cat := Animal make.
	cat пры: ['init'] выканаць: {
		свой sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
