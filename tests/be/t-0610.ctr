
>> Rectangle := Абʼект новы.

Rectangle пры: ['area'] выканаць: { <- свой даўжыня * свой width.
}.

Rectangle пры: ['length:'] выканаць: { :даўжыня
	свой даўжыня := даўжыня.
}.

Rectangle пры: ['width:'] выканаць: { :width
	свой width := width.
}.

Rectangle пры: ['новы'] выканаць: {
	# this will not result into an infinite loop
	>> rectangle := сам новы.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle новы.
Вывад пісаць: a area, новы-радок. #0

>> b := Rectangle новы length: 2, width: 3.
Вывад пісаць: b area, новы-радок. #6

