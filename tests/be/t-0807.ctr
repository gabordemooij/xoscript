# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB новы хост: ['localhost'],
	карыстальнік: ['xo'],
	пароль: ['pass123'],
	назва-базы: ['xobase'],
	падключыць.

>> параметры-пошуку := db запыт: ['SELECT %% FROM'].
{ параметры-пошуку выканаць. } перахапіць: { :e
	Вывад пісаць: ( e змяшчае: ['%%'] ), новы-радок.
}, запусціць.
