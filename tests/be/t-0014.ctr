>> Greeter := Абʼект новы.
Greeter пры: ['make'] выканаць: {
	>> gr := Абʼект новы.
	gr пры: ['setName:'] выканаць: { :aname
		свой імя := aname.
	}.
	gr пры: ['greet'] выканаць: {
		Вывад пісаць: свой імя.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a новы.
c setName: ['THREE'].
c greet.
>> d := a новы.
d setName: ['FOUR'].
d greet.
c greet.
