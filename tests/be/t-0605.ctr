>> invoice := Абʼект новы.
invoice пры: ['запусціць'] выканаць: {
        свой лік := 0.
}.

invoice пры: ['лік'] выканаць: {
        свой лік дадаць: 1. <- свой лік капіяваць.
}.

>> year-invoice := invoice новы.
year-invoice пры: ['start:'] выканаць: { :год
	свой лік := год.
}.

year-invoice start: 202000.
Вывад пісаць: year-invoice лік, новы-радок.
Вывад пісаць: year-invoice лік, новы-радок.
