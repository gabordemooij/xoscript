


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Праграма кіраванне-памяццю: 0.
>> palette := Нішто.
>> colors := Нішто.

{
palette := Слоўнік новы.
palette 
	пакласці: ['#F00'] на: ['red'],
	пакласці: ['#0F0'] на: ['green'],
	пакласці: ['#00F'] на: ['blue'].
Вывад пісаць: ['number of RGB codes in palette: '] + ( palette колькасць ), новы-радок.
Вывад пісаць: ['RGB code of green is: '] + ( palette ? ['green'] ), новы-радок.
colors := [''].
( palette кожны: { :імя :код
		colors := colors + ( імя + [':'] + код ).
} ).
Вывад пісаць: ['All colors in palette: '] + colors, новы-радок.
} запусціць.
Праграма прыбраць.
usedMemory1 := (Праграма памяць ? 0).

