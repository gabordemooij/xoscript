( 2 > 1 ) праўда:  { Вывад пісаць: ['BLOCK 2'], новы-радок. }.

>> i := 0.
{ Вывад пісаць: i. i дадаць: 1. } пакуль: { <- ( i < 3). }.
Вывад новы-радок.

i := 3.
{ Вывад пісаць: i. i := i - 1. } пакуль: { <- ( i > 0). }.
Вывад новы-радок.



Праграма прыбраць.
usedMemory2 := (Праграма памяць ? 0).


{ :i Вывад пісаць: i. } × 4.
Вывад новы-радок.
{ :i Вывад пісаць: (4 - i). } × 4.
Вывад новы-радок.
( 1 > 2 ) хлусня: { Вывад пісаць: ['BLOCK 1'], новы-радок. }.
( 2 > 1 ) праўда:  { Вывад пісаць: ['BLOCK 2'], новы-радок. }.

>> i := 0.
{ Вывад пісаць: i. i дадаць: 1. } пакуль: { <- ( i < 3). }.
Вывад новы-радок.

i := 3.
{ Вывад пісаць: i. i := i - 1. } пакуль: { <- ( i > 0). }.
Вывад новы-радок.

Праграма прыбраць.
usedMemory3 := (Праграма памяць ? 0).



( usedMemory1 = usedMemory2 і: usedMemory1 = usedMemory3, і: usedMemory2 = usedMemory3 ) праўда: {
	Вывад пісаць: ['No memory leaks here'].
}, хлусня: {
	Вывад пісаць: ['Leaking memory...'].
}.
