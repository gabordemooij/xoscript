Вывад пісаць: ['Test object'], новы-радок.
>> a := Абʼект новы. 

a пры: ['item:'] выканаць: { :лагічны
	свой лагічны := лагічны. 
}.

a пры: ['item'] выканаць: { <- свой лагічны.
}.

a item: Лагічны.

Вывад пісаць: a item, новы-радок.

>> old-bool-address := a item прататып адрас-памяці.
a save-as: ['/tmp/a.bin'].
Вывад пісаць: ['========== RELOADING SNAP:'], новы-радок.

>> b := Абʼект load-from: ['/tmp/a.bin'].

(b item прататып адрас-памяці = old-bool-address) праўда: {
	Вывад пісаць: ['Object link re-attached.'], новы-радок.
}.

Вывад пісаць: b item, новы-радок.
