# vault keys and signatures that decode too long must not overflow the stack
Server init.

>> keys := Сховішча згенераваць-ключы.
>> sk := keys першы.
>> pk := keys апошні.
>> sig := Сховішча падпісаць: ['abc'] ключом: sk.

# 88 characters without padding decode to 66 bytes
>> long := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 characters without padding decode to 33 bytes
>> short := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Сховішча падпісаць: ['abc'] ключом: long. } перахапіць: { :e
	Вывад пісаць: e, новы-радок.
}, запусціць.

{ Сховішча праверыць: ['abc'] подпіс: long ключом: pk. } перахапіць: { :e
	Вывад пісаць: e, новы-радок.
}, запусціць.

{ Сховішча праверыць: ['abc'] подпіс: sig ключом: short. } перахапіць: { :e
	Вывад пісаць: e, новы-радок.
}, запусціць.
