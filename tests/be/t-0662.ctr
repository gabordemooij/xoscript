>> t := Нішто.

# you can control the time zone for
# parsing like this:
Момант зона: ['CET'].
t := Момант з: ['1981-02-03 04:05:06'].
Вывад пісаць: t, новы-радок.

# now using CEST time zone:
Момант зона: ['CEST'].
t := Момант з: ['1981-02-03 04:05:06'].
Вывад пісаць: t, новы-радок.

# error if string cannot be parsed
{ Момант з: ['1900']. } перахапіць: { Нішто. }, запусціць.
