
Server init.
>> rq := HTTP-Запыт новы.
Вывад пісаць: ['HTTP-GET d[]=']  + ( rq get-спіс: ['d[]'] ), новы-радок. # GET
Вывад пісаць: ['HTTP-GET f[]=']  + ( rq get-спіс: ['f[]'] ), новы-радок. # GET
Вывад пісаць: ['HTTP-POST e[]='] + ( rq post-спіс: ['e[]'] ), новы-радок. # GET
Вывад пісаць: ['HTTP-POST c=']   + ( rq post: ['c'] ), новы-радок. # GET
Вывад пісаць: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), новы-радок. # GET
