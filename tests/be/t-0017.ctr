Лік пры: ['factorial'] выканаць: {
	>> total := 1.
	{ :index total памножыць-на: (сам - (index)). } × сам. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Вывад пісаць: a.
>> b := 2 + 3 factorial.
Вывад пісаць: b.
>> c := 3 factorial + 2.
Вывад пісаць: c.
>> d := 2 + (3 factorial).
Вывад пісаць: d.
Вывад пісаць: 2 + 3 factorial + 1.
