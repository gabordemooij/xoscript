>> x := [' hallo '].

>> y := x вялікія-літары.
Вывад пісаць: x, новы-радок.
Вывад пісаць: (x роўна: y), новы-радок.

>> y := x малыя-літары.
Вывад пісаць: x, новы-радок.
Вывад пісаць: (x роўна: y), новы-радок.

>> y := x абрэзаць.
Вывад пісаць: x, новы-радок.
Вывад пісаць: (x роўна: y), новы-радок.

>> y := x зрушэнне: 1.
Вывад пісаць: x, новы-радок.
Вывад пісаць: (x роўна: y), новы-радок.

>> y := x ад: 1 даўжыня: 2.
Вывад пісаць: x, новы-радок.
Вывад пісаць: (x роўна: y), новы-радок.