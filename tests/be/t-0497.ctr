Server init.

# write a test file
>> f := Файл новы: ['/tmp/test.gif'].
f пісаць: ['GIF87a01234567810'].

# serve the file
Server перадаць: ['test.gif'] прэфікс: ['/tmp/'].

Вывад новы-радок.

Вывад пісаць: ['Outside container (security):'], новы-радок.
{ Server перадаць: ['../passwd'] прэфікс: ['/tmp/']. }
перахапіць: { :e Вывад пісаць: e, новы-радок. },
запусціць.

Вывад пісаць: ['Invalid prefix:'], новы-радок.
{ Server перадаць: ['test.gif'] прэфікс: ['z:\\']. }
перахапіць: { :e Вывад пісаць: e, новы-радок. },
запусціць.

Вывад пісаць: ['Non-existant file:'], новы-радок.
{ Server перадаць: ['xxx.xxx'] прэфікс: ['/tmp/']. }
перахапіць: { :e Вывад пісаць: e, новы-радок. },
запусціць.
