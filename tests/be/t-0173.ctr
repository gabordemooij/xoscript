

Спіс пры: ['sum'] выканаць: {
	>> total := 0.
	сам кожны: { :index :element
		total дадаць: element.
	}. <- total.
}.

Спіс пры: ['product'] выканаць: {
	>> total := 1.
	сам кожны: { :index :element
		total памножыць-на: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Праграма кіраванне-памяццю: 0.

{

>> a := Спіс ← ['hello'] ; ['world'] ; Праўда ; Нішто ; 666.
a := a + ( Спіс ← 1 ).
Вывад пісаць: ( ['sum: '] + ( a sum ) ), новы-радок.
Вывад пісаць: ( ['min: '] + ( a мінімум ) ), новы-радок.
Вывад пісаць: ( ['max: '] + ( a максімум ) ), новы-радок.
Вывад пісаць: ( ['3rd: '] + ( a ? 2 ) ), новы-радок.
Вывад пісаць: ( ['prd: '] + ( a product ) ), новы-радок.
a сартаваць: { :a :b <- (b - a). }.
a кожны: { :i :e Вывад пісаць: ( i - 0 ), новы-радок. }.

} запусціць.

Праграма прыбраць.
usedMemory1 := (Праграма памяць ? 0).


{

>> a := Спіс ← ['hello'] ; ['world'] ; Праўда ; Нішто ; 666.
a := a + ( Спіс ← 1 ).
Вывад пісаць: ( ['sum: '] + ( a sum ) ), новы-радок.
Вывад пісаць: ( ['min: '] + ( a мінімум ) ), новы-радок.
Вывад пісаць: ( ['max: '] + ( a максімум ) ), новы-радок.
Вывад пісаць: ( ['3rd: '] + ( a ? 2 ) ), новы-радок.
Вывад пісаць: ( ['prd: '] + ( a product ) ), новы-радок.
a сартаваць: { :a :b <- (b - a). }.
a кожны: { :i :e Вывад пісаць: ( i - 0 ), новы-радок. }.

} запусціць.



