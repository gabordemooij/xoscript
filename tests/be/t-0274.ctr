

Спіс пры: ['column:'] выканаць: { :column
	>> result := Спіс новы.
	сам кожны: { :index :row
		row кожны: { :index :cell
			(index = column) праўда: { result дадаць-у-канец: cell. }.
		}.
	}. <- result.
}.


>> a := Спіс ←
	(Спіс ← 1 ; 2 ; 3) ;
	(Спіс ← 4 ; 5 ; 6) ;
	(Спіс ← 7 ; 8 ; 9).

>> b := a column: 1.
Вывад пісаць: b, новы-радок.

b := a column: 20.
Вывад пісаць: b, новы-радок.

b := a column: -100.
Вывад пісаць: b, новы-радок.
