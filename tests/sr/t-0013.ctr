
>> Животиња := Објекат нови.
Животиња на: ['нови'] уради: {
	<- себе нови init.
}.

Животиња на: ['init'] уради: {
	свој звук := ['?'].
	свој ноге  := 4.
}.

>> Пас := Животиња нови.
Пас на: ['init'] уради: {
	себе init.
	свој звук := ['лаје'].
}.

Животиња на: ['текст'] уради: {
	<- свој ноге текст + свој звук.
}.

>> пудла := Пас нови.
Излаз пиши: пудла, нови-ред.

