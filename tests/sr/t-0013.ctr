
>> Animal := Објекат нови.
Animal на: ['нови'] уради: { <- себе нови init.
}.

Animal на: ['init'] уради: {
	свој sound := ['?'].
	свој legs := 4.
}.

>> Dog := Animal нови.
Dog на: ['init'] уради: {
	себе init.
	свој sound := ['barks'].
}.

Animal на: ['текст'] уради: { <- свој legs текст + свој sound.
}.

>> poodle := Dog нови.
Излаз пиши: poodle, нови-ред.

