Листа на: ['sum'] уради: {
	>> total := 0.
	себе сваки: { :index :element
		total додај: element.
	}. <- total.
}.

>> a := Тачно.



a на: ['текст'] уради: {
	>> answer := Ништа.
	( себе = Тачно ) тачно: {
		answer := ['Yep'].
	}, иначе: {
		answer := ['Nope'].
	}. <- answer.
}.

a на: ['број'] уради: {
	>> answer := Ништа.
	( себе = Тачно ) тачно: {
		answer := 10.
	}, иначе: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b на: ['текст'] уради: { <- ['Devil'].
}.

b на: ['логички'] уради: { <- Нетачно.
}.


Излаз пиши: a, нови-ред.  
Излаз пиши: (90 + a), нови-ред. 
Излаз пиши: b, нови-ред. 
Излаз пиши: (Тачно и: b), нови-ред.

a := Листа ← ['hello'] ; ['world'] ; Тачно ; Ништа ; 666. 
a := a + ( Листа ← 1 ).
Излаз пиши: a, нови-ред.
Излаз пиши: ((Речник нови) стави: Ништа на: Ништа), нови-ред.
Излаз пиши: a sum, нови-ред. 


{
	a на: ['текст'] уради: { <- Ништа. }.
	a := [''] + a.
} ухвати: { :error
	Излаз пиши: ['Error noted: '] + error, нови-ред.
}, покрени.



