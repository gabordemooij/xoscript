Листа на: ['збир'] уради: {
	>> укупно := 0.
	себе сваки: { :индекс :елемент
		укупно додај: елемент.
	}. <- укупно.
}.

>> a := Тачно.



a на: ['текст'] уради: {
	>> решење := Ништа.
	( себе = Тачно ) тачно: {
		решење := ['Аха'].
	}, иначе: {
		решење := ['Ма јок'].
	}. <- решење.
}.

a на: ['број'] уради: {
	>> решење := Ништа.
	( себе = Тачно ) тачно: {
		решење := 10.
	}, иначе: {
		решење := 20.
	}. <- решење.
}.

>> b := 666.

b на: ['текст'] уради: { <- ['Ђаво'].
}.

b на: ['логички'] уради: { <- Нетачно.
}.


Излаз пиши: a, нови-ред.  
Излаз пиши: (90 + a), нови-ред. 
Излаз пиши: b, нови-ред. 
Излаз пиши: (Тачно и: b), нови-ред.

a := Листа ← ['hello'] ; ['world'] ; Тачно ; Ништа ; 666. 
a := a + ( Листа ← 1 ).
Излаз пиши: a, нови-ред.
Излаз пиши: ((Речник нови) стави: Ништа на: Ништа), нови-ред.
Излаз пиши: a збир, нови-ред. 


{
	a на: ['текст'] уради: { <- Ништа. }.
	a := [''] + a.
} ухвати: { :грешка
	Излаз пиши: ['Грешка забележена: '] + грешка, нови-ред.
}, покрени.



