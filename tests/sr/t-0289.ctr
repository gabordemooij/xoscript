#Linux
>> OS := Програм систем: (Наредба uname -s), скрати.

>> Slurp := Објекат нови.
Slurp на: ['нови'] уради: {
	свој str := [''].
}.
Slurp на: ['одговори:'] уради: { :blah
		(свој str ≠ ['']) тачно: {
			свој str додај-на-крај: [' '].
		}.
		свој str додај-на-крај: blah.
}.
Slurp на: ['одговори:и:'] уради: { :blah :blahah
		(свој str ≠ ['']) тачно: {
			свој str додај-на-крај: [' '].
		}.
		(blah дужина > 1) тачно: {
			свој str додај-на-крај: (blah од: 0 дужина: (blah дужина - 1)).
		}, иначе: {
			свој str додај-на-крај: blah.
		}.
		свој str додај-на-крај: [' '].
		свој str додај-на-крај: blahah.
}.
Slurp на: ['obtain'] уради: {
	>> buffer := свој str.
	свој str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text додај-на-крај: ['hello'].
} × 1000.


Излаз пиши: (
	Програм систем: (
		Slurp нови
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

