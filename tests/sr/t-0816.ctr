# a format must fit the type of the value, the type can come from a client
>> покушај := { :format :value
	{ Излаз пиши: ( (Формат нови: format) примени: value ), нови-ред. } ухвати: { :e Излаз пиши: e, нови-ред. }, покрени.
}.
>> try-int := { :format :value
	{ Излаз пиши: ( (Формат нови: format) примени-цео: value ), нови-ред. } ухвати: { :e Излаз пиши: e, нови-ред. }, покрени.
}.

# fits
покушај примени: ['|%s|'] и: ['text'].
покушај примени: ['%06.2f'] и: 5.5.
покушај примени: ['100%% %s'] и: ['sure'].
try-int примени: ['%03d'] и: 7.
try-int примени: ['%x'] и: 255.
покушај примени: ['%d'] и: (Int64 нови из-текста: ['12']).
покушај примени: ['%lld'] и: (Int64 нови из-текста: ['12']).
покушај примени: ['%.1lf'] и: 5.5.
try-int примени: ['%hd'] и: 7.

# does not fit
покушај примени: ['%s'] и: 12345.
покушај примени: ['%d'] и: 12345.
покушај примени: ['%f'] и: ['text'].
try-int примени: ['%d'] и: ['text'].
try-int примени: ['%s'] и: 5.
покушај примени: ['%s %s'] и: ['text'].
покушај примени: ['%n'] и: ['text'].
покушај примени: ['%*s'] и: ['text'].
покушај примени: ['%'] и: ['text'].

# length modifier does not fit
покушај примени: ['%ls'] и: ['text'].
покушај примени: ['%Lf'] и: 5.5.
try-int примени: ['%ld'] и: 7.
try-int примени: ['%lld'] и: 7.
покушај примени: ['%Ld'] и: (Int64 нови из-текста: ['12']).

# a width that does not fit printf must give an error, not a crash
покушај примени: ['%99999999999s'] и: ['text'].
