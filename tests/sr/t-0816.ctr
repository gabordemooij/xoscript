# формат мора одговарати типу вредности, тип може доћи од клијента
>> покушај := { :облик :value
	{ Излаз пиши: ( (Формат нови: облик) примени: value ), нови-ред. } ухвати: { :e Излаз пиши: e, нови-ред. }, покрени.
}.
>> пробај-цео := { :облик :value
	{ Излаз пиши: ( (Формат нови: облик) примени-цео: value ), нови-ред. } ухвати: { :e Излаз пиши: e, нови-ред. }, покрени.
}.

# одговара
покушај примени: ['|%s|'] и: ['text'].
покушај примени: ['%06.2f'] и: 5.5.
покушај примени: ['100%% %s'] и: ['наравно'].
пробај-цео примени: ['%03d'] и: 7.
пробај-цео примени: ['%x'] и: 255.
покушај примени: ['%d'] и: (Int64 нови из-текста: ['12']).
покушај примени: ['%lld'] и: (Int64 нови из-текста: ['12']).
покушај примени: ['%.1lf'] и: 5.5.
пробај-цео примени: ['%hd'] и: 7.

# не одговара
покушај примени: ['%s'] и: 12345.
покушај примени: ['%d'] и: 12345.
покушај примени: ['%f'] и: ['text'].
пробај-цео примени: ['%d'] и: ['text'].
пробај-цео примени: ['%s'] и: 5.
покушај примени: ['%s %s'] и: ['text'].
покушај примени: ['%n'] и: ['text'].
покушај примени: ['%*s'] и: ['text'].
покушај примени: ['%'] и: ['text'].

# модификатор дужине не одговара
покушај примени: ['%ls'] и: ['text'].
покушај примени: ['%Lf'] и: 5.5.
пробај-цео примени: ['%ld'] и: 7.
пробај-цео примени: ['%lld'] и: 7.
покушај примени: ['%Ld'] и: (Int64 нови из-текста: ['12']).

# ширина која не одговара printf-у мора дати грешку, а не пад
покушај примени: ['%99999999999s'] и: ['text'].
