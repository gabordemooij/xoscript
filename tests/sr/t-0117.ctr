>> t := Тачно.
(t = Тачно) тачно: { Излаз пиши: ['T']. }.
(t = Нетачно) тачно: { Излаз пиши: ['F']. }.
Излаз пиши: ['|'].
>> t := Нетачно.
(t = Тачно) тачно: { Излаз пиши: ['T']. }.
(t = Нетачно) тачно: { Излаз пиши: ['F']. }.
Излаз пиши: ['|'].
>> f := Тачно.
(t = Тачно и: f = Нетачно) тачно: { Излаз пиши: ['T']. }.
(t = Нетачно и: f = Тачно) тачно: { Излаз пиши: ['F']. }.
Излаз пиши: ['|'].
>> n := Ништа.
(n Ништа?) тачно: { Излаз пиши: ['T']. }.
(n Ништа?) нетачно: { Излаз пиши: ['F']. }.
Излаз пиши: ['|'].
(f Boolean?) тачно: { Излаз пиши: ['T']. }.
(f Boolean?) нетачно: { Излаз пиши: ['F']. }.



