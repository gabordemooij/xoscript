#OBSD
>> dirname := [''].
{ dirname додај-на-крај: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Програм систем: command.
Програм chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename додај-на-крај: ['YYYYYYYY']. } * 20.
Датотека нови: filename, пиши: ['sometext'].
{ Датотека листа: ['/tmp/'] + dirname. } * 1000.
Излаз пиши: ['no crash'], нови-ред.

