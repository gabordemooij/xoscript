#OBSD
>> имедир := [''].
{ имедир додај-на-крај: ['X/']. } * (1024 / 2 - 4).
>> команда := ['mkdir -p /tmp/'] + имедир.
Програм систем: команда.
Програм chdir: ['/tmp/'] + имедир.
>> имедатотеке := [''].
{ имедатотеке додај-на-крај: ['YYYYYYYY']. } * 20.
Датотека нови: имедатотеке, пиши: ['некитекст'].
{ Датотека листа: ['/tmp/'] + имедир. } * 1000.
Излаз пиши: ['нема рушења'], нови-ред.

