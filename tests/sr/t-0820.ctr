# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Образац нови: pattern.
	p подударање: subject уради: { :m :g
		Излаз пиши: g број-елемената, пиши: [' '], пиши: (g споји: ['|']), нови-ред. <- m.
	}.
}.
show примени: ['(a)|(b)'] и: ['b'].
show примени: ['(a)|(b)'] и: ['a'].
show примени: ['(x)?y'] и: ['y'].
show примени: ['(x)?(y)(z)?'] и: ['xy'].
