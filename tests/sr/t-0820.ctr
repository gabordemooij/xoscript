# група која није део подударања не сме да изазове пад и мора задржати бројеве група
Server init.
>> прикажи := { :узорак :subject
	>> p := Образац нови: узорак.
	p подударање: subject уради: { :m :g
		Излаз пиши: g број-елемената, пиши: [' '], пиши: (g споји: ['|']), нови-ред.
		<- m.
	}.
}.
прикажи примени: ['(a)|(b)'] и: ['b'].
прикажи примени: ['(a)|(b)'] и: ['a'].
прикажи примени: ['(x)?y'] и: ['y'].
прикажи примени: ['(x)?(y)(z)?'] и: ['xy'].
