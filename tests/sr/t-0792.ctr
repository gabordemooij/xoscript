Server init.

>> DB := Maria-DB нови домаћин: ['localhost'],
	корисник: ['xo'],
	лозинка: ['pass123'],
	назив-базе: ['xobase'],
	повежи-се.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB упит: SQL.

# now you don't have to set DB
query2 преузми: { :row
	Излаз пиши: row world, нови-ред.
}.
