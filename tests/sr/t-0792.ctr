Server init.

>> БП := Maria-DB нови домаћин: ['localhost'],
	корисник: ['xo'],
	лозинка: ['pass123'],
	назив-базе: ['xobase'],
	повежи-се.
	
>> SQL := ['SELECT "hello" AS "world" '].

# бржи начин, упит добијамо из БП:
>> упит2 := БП упит: SQL.

# сада не морате да постављате БП
упит2 преузми: { :врста
	Излаз пиши: врста world, нови-ред.
}.
