>> фактура := Објекат нови.
фактура на: ['покрени'] уради: {
        свој број := 0.
}.

фактура на: ['број'] уради: {
        свој број додај: 1.
        <- свој број копирај.
}.

>> годишња-фактура := фактура нови.
годишња-фактура на: ['start:'] уради: { :година
	свој број := година.
}.

годишња-фактура start: 202000.
Излаз пиши: годишња-фактура број, нови-ред.
Излаз пиши: годишња-фактура број, нови-ред.
