>> invoice := Објекат нови.
invoice на: ['покрени'] уради: {
        свој број := 0.
}.

invoice на: ['број'] уради: {
        свој број додај: 1. <- свој број копирај.
}.

>> year-invoice := invoice нови.
year-invoice на: ['start:'] уради: { :година
	свој број := година.
}.

year-invoice start: 202000.
Излаз пиши: year-invoice број, нови-ред.
Излаз пиши: year-invoice број, нови-ред.
