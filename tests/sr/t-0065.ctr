Број на: ['factorial'] уради: {
	>> total := 1.
	{ :index total помножи-са: (себе - (index)). } × себе. <- total.
}.
>> Printer := Објекат нови.
Printer на: ['print:and:'] уради: { :x :y
	Излаз пиши: ['a='] + x + [', b='] + y, нови-ред.
}.
>> a := 4.5. >> b := a заокружи-надоле.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a заокружи-нагоре.
Printer print: a and: b.
a := 4.5. b := a заокружи-надоле.
Printer print: a and: b.
a := 4.5. b := a заокружи.
Printer print: a and: b.
a := 4.2. b := a заокружи.
Printer print: a and: b.

