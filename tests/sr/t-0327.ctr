

Листа на: ['fixture:'] уради: { :f
	свој fixture := f.
}.

Листа на: ['број-елемената'] уради: { <- свој fixture.
}.

Листа на: ['aantal'] уради: { <- свој fixture.
}.


>> x := Ништа.
{

	x := ['hello'] 
	замени:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] знак: 2)
			)
		)
	са: (
		(['...hal'] + ['lo']) 
			велика-слова 
			lowecase 
			велика-слова 
			помак: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Листа ← 0 ; 1 ; 4; 9 ; (Листа ← 0 ; 3; 1) ; 4
							) претпоследњи
						) ? 1
					) + 
					((Листа ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					број-елемената
				)
			)
	).

} × 10.
Излаз пиши: x, нови-ред.

