# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Програм подешавање: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server повежи: ( Листа нови ;
 libname ; ['fopen'] ;
 ( Листа нови ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
повежи: ( Листа нови ;
 Ништа ; # means same lib
 ['fread'] ;
 ( Листа нови ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Ништа ; # means same object (i.e. Stream)
 ['fread']
),
повежи: (
 Листа нови ;
 Ништа ; # means same lib
 ['fwrite'] ;
 ( Листа нови ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Ништа ; # means same lib
 ['fwrite']
),
повежи: (
 Листа нови ;
 Ништа ; # means same lib
 ['rewind'] ;
 ( Листа нови ; ['pointer'] ) ;
 ['int'] ;
 Ништа ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> путања := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: путања mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream порука: ['fwrite'] аргументи: (Листа нови ; str ; 1 ; 6 ; fd ).
Излаз пиши: bytes-written, нови-ред.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob нови: 20.

# read from file
>> bytes-read := Stream порука: ['fread'] аргументи: (Листа нови ; buf ; 1 ; 6 ; fd ).
Излаз пиши: bytes-read, нови-ред.
Излаз пиши: buf, нови-ред.

# free memory
str  ослободи.
путања ослободи.
mode ослободи.
buf  ослободи.


