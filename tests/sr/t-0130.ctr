# коришћење FFI са додатком Server

# повезивање са libc (зависи од платформе)
>> имебибл := Програм подешавање: ['FFITESTLIB'].

# повезивање stdio функција из C-а за напредне операције над датотекама
Server повежи: ( Листа нови ;
 имебибл ; ['fopen'] ;
 ( Листа нови ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
повежи: ( Листа нови ;
 Ништа ; # значи иста библиотека
 ['fread'] ;
 ( Листа нови ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Ништа ; # значи исти објекат (тј. Ток)
 ['fread']
),
повежи: (
 Листа нови ;
 Ништа ; # значи иста библиотека
 ['fwrite'] ;
 ( Листа нови ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Ништа ; # значи иста библиотека
 ['fwrite']
),
повежи: (
 Листа нови ;
 Ништа ; # значи иста библиотека
 ['rewind'] ;
 ( Листа нови ; ['pointer'] ) ;
 ['int'] ;
 Ништа ; # значи иста библиотека
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> путања := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# отварање датотеке помоћу fopen(path, mode)
>> fd := Stream path: путања mode: mode.

# уписивање бајтова из бафера str у датотеку
>> записано-бајтова := Stream порука: ['fwrite'] аргументи: (Листа нови ; str ; 1 ; 6 ; fd ).
Излаз пиши: записано-бајтова, нови-ред.

# враћање показивача датотеке на почетак
Stream rewind: fd.

# алоцирање бафера
>> баф := Blob нови: 20.

# читање из датотеке
>> прочитано-бајтова := Stream порука: ['fread'] аргументи: (Листа нови ; баф ; 1 ; 6 ; fd ).
Излаз пиши: прочитано-бајтова, нови-ред.
Излаз пиши: баф, нови-ред.

# ослобађање меморије
str  ослободи.
путања ослободи.
mode ослободи.
баф  ослободи.


