#Linux
>> Сркач := Објекат нови.

Сркач на: ['нови'] уради: {
	свој str := [''].
}.

Сркач на: ['nieuw'] уради: {
	свој str := [''].
}.

Сркач на: ['одговори:'] уради: { :blah
		свој str додај-на-крај: blah.
}.

Сркач на: ['одговори:и:'] уради: { :blah :blahah
		свој str додај-на-крај: (blah од: 0 дужина: (blah дужина - 1)).
		свој str додај-на-крај: [' '].
		свој str додај-на-крај: blahah.
}.

Сркач на: ['прибави'] уради: {
	>> бафер := свој str.
	свој str := ['']. <- бафер.
}.


Излаз пиши: (Програм систем: (Сркач нови echo: ['Здраво, могу да пишем на конзолу помоћу флуидног API-ја!'], прибави)).


{ Датотека нови: ['/tmp/from.txt'], избриши. } ухвати: { ['Празно']. }, покрени.
{ Датотека нови: ['/tmp/to.txt'], избриши. } ухвати: { ['Празно']. }, покрени.


Датотека нови: ['/tmp/to.txt'], постоји нетачно: {
	Излаз пиши: ['Confirmed. Target file does not exist.\
'].
}.
Датотека нови: ['/tmp/from.txt'], постоји нетачно: {
	Излаз пиши: ['Confirmed. Source file does not exist.\
'].
}.



Програм систем: (Сркач нови touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], прибави).



Програм систем: (Сркач нови cp: ['/tmp/from.txt /tmp/to.txt'], прибави).

Датотека нови: ['/tmp/to.txt'], постоји тачно: {
	Излаз пиши: ['Confirmed. Target file has been created by shell.\
'].
}.


Излаз пиши: ['Садржај датотеке је:'] + (Датотека нови: ['/tmp/to.txt'], читај), нови-ред.
