#Linux

 >> t := Тренутак нови.
 
t зона: ['Europe/Amsterdam'].
t година: 2020, месец: 8, дан: 2, сат: 21, минут: 2, секунда: 1.

>> a := t сат.
>> ams := t зона.

t зона: ['US/Hawaii'].
>> b := t сат.
>> hw := t зона.

Излаз
пиши: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		или: ['later'] или: ['earlier']
	)
),
нови-ред.
 