# тест бафера PKI/потписа 
Server init.

>> дуг := ( Листа нови попуни: 1000 са: ['a'] ) споји: [''].

# потписивање поруке
Излаз пиши: ( 
	Сеф потпиши: ['abc'] кључем: дуг
), нови-ред.

Излаз пиши: ( 
	Сеф
		провери: ['abc'] 
		потпис: дуг 
		кључем: дуг
), нови-ред.

Излаз пиши: (
	Сеф хеш-лозинке: дуг провери: дуг
), нови-ред.
