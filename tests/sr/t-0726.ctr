# test buffers PKI/Sign 
Server init.

>> long := ( Листа нови попуни: 1000 са: ['a'] ) споји: [''].

# sign a message
Излаз пиши: ( 
	Сеф потпиши: ['abc'] кључем: long
), нови-ред.

Излаз пиши: ( 
	Сеф
		провери: ['abc'] 
		потпис: long 
		кључем: long
), нови-ред.

Излаз пиши: (
	Сеф хеш-лозинке: long провери: long
), нови-ред.
