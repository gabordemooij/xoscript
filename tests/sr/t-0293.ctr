
>> city := Листа ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Листа ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature према: city.
>> cities := weather уноси сортирај: { :a :b <- (a упореди: b). }.
>> temperatures := weather вредности сортирај: { :a :b <- (a упореди: b) негативан?. }.

Излаз пиши: (cities споји: [',']), нови-ред.
Излаз пиши: (temperatures споји: [',']), нови-ред.
