
>> град := Листа ← ['London'] ; ['Париз'] ; ['Berlin'].
>> температура := Листа ← ['15'] ; ['16'] ; ['15'].
>> прогноза := температура према: град.
>> градови := прогноза уноси сортирај: { :a :b <- (a упореди: b). }.
>> температуре := прогноза вредности сортирај: { :a :b <- (a упореди: b) негативан?. }.

Излаз пиши: (градови споји: [',']), нови-ред.
Излаз пиши: (температуре споји: [',']), нови-ред.
