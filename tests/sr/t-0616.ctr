Листа на: ['копирај'] уради: {
	>> копирај := Листа нови.
	себе сваки: { :број :section
		копирај додај-на-крај: section рекурзивно копирај.
	}. <- копирај.
}.

>> sheep := Листа нови ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep копирај.
clones сваки: { :број :sheep
	sheep додај-на-крај: ['2'].
}.

Излаз пиши: sheep, нови-ред.
Излаз пиши: clones, нови-ред.
