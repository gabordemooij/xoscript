Листа на: ['копирај'] уради: {
	>> копирај := Листа нови.
	себе сваки: { :број :одељак
		копирај додај-на-крај: одељак рекурзивно копирај.
	}.
	<- копирај.
}.

>> овца := Листа нови ; ['Dolly'] ; ['Shaun']. 
>> клонови := овца копирај.
клонови сваки: { :број :овца
	овца додај-на-крај: ['2'].
}.

Излаз пиши: овца, нови-ред.
Излаз пиши: клонови, нови-ред.
