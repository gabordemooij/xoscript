
Текст на: ['evaluate'] уради: {
	>> код := Датотека нови: ['/tmp/eval.ctr'].
	код пиши: (себе текст + ['.']).
	Програм користи: ['/tmp/eval.ctr'].
}.

>> map :=
	(Речник нови)
	стави: ['Hi There'] на: ['two'],
	стави: (Листа ← ['hello'] ; ['world'] ; (Листа ← 1 ; 2; 9) ; Нетачно) на: ['one'],
	стави: ( (Речник нови) стави: ['wrrld'] на: ['misspelled'] ) на: ['three'],
	стави: (Листа ← ((Речник нови) стави: ['treasure'] на: ['hidden']) ; 2) на: ['four']. 
>> str := map текст.
>> map2 := Ништа.
(['map2 := '] + str ) evaluate.
Излаз пиши: map2 ? ['one'] ? 0.
Излаз пиши: map2 ? ['one'] ? 1.
Излаз пиши: map2 ? ['four'] ? 0 ? ['hidden'].
Излаз пиши: map2 ? ['one'] ? 2 ? 2.
