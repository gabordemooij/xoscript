
Текст на: ['израчунај'] уради: {
	>> код := Датотека нови: ['/tmp/eval.ctr'].
	код пиши: (себе текст + ['.']).
	Програм користи: ['/tmp/eval.ctr'].
}.

>> map :=
	(Речник нови)
	стави: ['Ћао Свима'] на: ['two'],
	стави: (Листа ← ['hello'] ; ['world'] ; (Листа ← 1 ; 2; 9) ; Нетачно) на: ['један'],
	стави: ( (Речник нови) стави: ['свеет'] на: ['погрешно написано'] ) на: ['three'],
	стави: (Листа ← ((Речник нови) стави: ['благо'] на: ['скривено']) ; 2) на: ['четири']. 
>> str := map текст.
>> map2 := Ништа.
(['map2 := '] + str ) израчунај.
Излаз пиши: map2 ? ['један'] ? 0.
Излаз пиши: map2 ? ['један'] ? 1.
Излаз пиши: map2 ? ['четири'] ? 0 ? ['скривено'].
Излаз пиши: map2 ? ['један'] ? 2 ? 2.
