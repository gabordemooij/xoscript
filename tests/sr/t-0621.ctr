>> фразе := Листа нови
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> порука := ['Phrase: ~decoded base64: ~encoded'].
	
фразе сваки: { :_ :фраза 
	>> e := Server base64-кодирај: фраза.
	>> d := Server base64-декодирај: e.
	Излаз пиши: (
		порука копирај ~encoded: e, ~decoded: d
	), нови-ред.
}.
