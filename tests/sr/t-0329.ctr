Излаз пиши: ((Листа нови
	на: ['plaque:'] уради: { :x свој o := x. },
	на: ['плакета']  уради: { <- свој o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Листа ← 1)
	~ (Листа ← 1 ; 2)
	~ (Листа ← 1 ; 2 ; 3)
	~ (Листа ← 1 ; 2 ; 3 ; 4)
	~ (Листа ← 1 ; 2 ; 3 ; 4 ; 5)
) сваки: { :i :ел
	{ Излаз пиши: овај-задатак. } × ел број-елемената.
	Излаз нови-ред.
}) плакета, нови-ред.


