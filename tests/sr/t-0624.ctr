# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := Објекат нови.

Log на: ['say:'] уради: { :str
	Излаз пиши: str, нови-ред.
}.

>> Item := Објекат нови.

Item на: ['нови:'] уради: { :id <- себе нови id: id.
}.

Item на: ['id:'] уради: { :id
	свој id := id.
}.

Item на: ['id'] уради: { <- свој id. }.


Item на: ['текст'] уради: {
	>> str := ['Item#~no'].
	str ~no: свој id. <- str.
}.


>> Print := Објекат нови.

Print на: ['items'] уради: { 
	
	свој item := Item нови: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: свој item
	).
	
	
}.

Print items.