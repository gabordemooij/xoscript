# Овај тест проверава да string_fill_in не губи свој утор (gc'ed) у режиму 4
# референца у world.c
>> Дневник := Објекат нови.

Дневник на: ['say:'] уради: { :str
	Излаз пиши: str, нови-ред.
}.

>> Ставка := Објекат нови.

Ставка на: ['нови:'] уради: { :id
	<- себе нови id: id.
}.

Ставка на: ['id:'] уради: { :id
	свој id := id.
}.

Ставка на: ['id'] уради: { <- свој id. }.


Ставка на: ['текст'] уради: {
	>> str := ['Item#~no'].
	str ~no: свој id.
	<- str.
}.


>> Print := Објекат нови.

Print на: ['items'] уради: { 
	
	свој ставка := Ставка нови: 1.
	
	# овде или segfault или погрешан str
	Дневник say: (
		['~item printed.'] ~item: свој ставка
	).
	
	
}.

Print items.