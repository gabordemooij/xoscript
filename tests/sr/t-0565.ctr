Server init.

>> порука := ['ово је текст који треба шифровати!'].
>> key := ['тајна123!'].
>> трезор := Сеф нови: ['мојтрезор'].

>> шифровано := трезор шифруј: порука кључ: key.
>> дешифровано := трезор дешифруј: шифровано кључ: key.

Излаз 
пиши: ['Message:'], нови-ред
пиши: порука, нови-ред
пиши: ['Decrypted:'], нови-ред
пиши: дешифровано, нови-ред.
