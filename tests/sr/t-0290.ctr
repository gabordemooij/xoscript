# test list operations


>> cakes := Листа ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes замени: 1 дужина: 2 са: ( Листа ← ['cinnamon'] ; ['pineapple'] ).
Излаз пиши: (buy споји: [',']), нови-ред.


>> buy := cakes замени: 1 дужина: 12 са: ( Листа ← ['cinnamon'] ; ['pineapple'] ).
Излаз пиши: (buy споји: [',']), нови-ред.


>> buy := cakes замени: 2 дужина: 10 са: ( Листа нови ).
Излаз пиши: (buy споји: [',']), нови-ред.


>> buy := cakes замени: 0 дужина: 1 са: ( Листа нови ).
Излаз пиши: (buy споји: [',']), нови-ред.


>> buy := cakes замени: ['0'] дужина: ['1'] са: ['x'].
Излаз пиши: (buy споји: [',']), нови-ред.
