# тест операција над листама


>> колачи := Листа ←
	['apple'] ;
	['бобица'] ;
	['чоко'] ;
	['сир'].


>> купи := колачи замени: 1 дужина: 2 са: ( Листа ← ['цимет'] ; ['ананас'] ).
Излаз пиши: (купи споји: [',']), нови-ред.


>> купи := колачи замени: 1 дужина: 12 са: ( Листа ← ['цимет'] ; ['ананас'] ).
Излаз пиши: (купи споји: [',']), нови-ред.


>> купи := колачи замени: 2 дужина: 10 са: ( Листа нови ).
Излаз пиши: (купи споји: [',']), нови-ред.


>> купи := колачи замени: 0 дужина: 1 са: ( Листа нови ).
Излаз пиши: (купи споји: [',']), нови-ред.


>> купи := колачи замени: ['0'] дужина: ['1'] са: ['x'].
Излаз пиши: (купи споји: [',']), нови-ред.
