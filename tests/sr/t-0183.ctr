

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програм управљање-меморијом: 0.

>> o := Објекат нови.
>> o2 := Објекат нови.
Излаз пиши: o Ништа?, нови-ред.
Излаз пиши: o тип, нови-ред.
Излаз пиши: ( o једнако: o ), нови-ред.
Излаз пиши: ( o једнако: o2 ), нови-ред.
Излаз пиши: o ја-сам, нови-ред.
Излаз пиши: ( o ради готово ), нови-ред.

Програм очисти.

usedMemory1 := (Програм меморија ? 0).


o := Објекат нови.
o2 := Објекат нови.
Излаз пиши: o Ништа?, нови-ред.
Излаз пиши: o тип, нови-ред.
Излаз пиши: ( o једнако: o ), нови-ред.
Излаз пиши: ( o једнако: o2 ), нови-ред.
Излаз пиши: o ја-сам, нови-ред.
Излаз пиши: ( o ради готово ), нови-ред.

Програм очисти.
usedMemory2 := (Програм меморија ? 0).


o := Објекат нови.
o2 := Објекат нови.
Излаз пиши: o Ништа?, нови-ред.
Излаз пиши: o тип, нови-ред.
Излаз пиши: ( o једнако: o ), нови-ред.
Излаз пиши: ( o једнако: o2 ), нови-ред.
Излаз пиши: o ја-сам, нови-ред.
Излаз пиши: ( o ради готово ), нови-ред.

Програм очисти.
usedMemory3 := (Програм меморија ? 0).



( usedMemory1 = usedMemory2 и: usedMemory1 = usedMemory3, и: usedMemory2 = usedMemory3 ) тачно: {
	Излаз пиши: ['No memory leaks here'].
}, нетачно: {
	Излаз пиши: ['Leaking memory...'].
}.
