
>> a := Листа ← (Листа ← 100 ; 200 ; 300) ; (Листа ← 9 ; 8 ; 7).
Излаз пиши: ['на 0,1 :'].
Излаз пиши: a ? 0 ? 1, нови-ред. 
Излаз пиши: ['на 1,2 :'].
Излаз пиши: a ? 1 ? 2, нови-ред. 
>> мени := Речник нови.
мени стави: (Листа ← ['пица'] ; ['шпагети']) на: ['Италијанска кухиња'].
мени стави: (Листа ← ['bifteki'] ; ['suflaki']) на: ['Грчка кухиња'].
Излаз пиши: ['Волим '] + (мени ? ['Грчка кухиња'] ? 0) + [' и '] + (мени ? ['Италијанска кухиња'] ? 1), нови-ред. 
Излаз пиши: ['али не на истом тањиру.'], нови-ред.
