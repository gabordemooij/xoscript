
>> a := Листа ← (Листа ← 100 ; 200 ; 300) ; (Листа ← 9 ; 8 ; 7).
Излаз пиши: ['at 0,1 :'].
Излаз пиши: a ? 0 ? 1, нови-ред. 
Излаз пиши: ['at 1,2 :'].
Излаз пиши: a ? 1 ? 2, нови-ред. 
>> menu := Речник нови.
menu стави: (Листа ← ['pizza'] ; ['spaghetti']) на: ['Italian Cuisine'].
menu стави: (Листа ← ['bifteki'] ; ['suflaki']) на: ['Greek Cuisine'].
Излаз пиши: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), нови-ред. 
Излаз пиши: ['but not on the same plate.'], нови-ред.
