

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програм управљање-меморијом: 0.

>> f := Датотека нови: ['/tmp/citrine_test_file.txt'].
f exists: { f избриши. }.
f пиши: ['hello'].
f := Датотека нови: ['/tmp/citrine_test_file.txt'].
f додај-на-крај: ['hello'].

Програм очисти.
usedMemory1 := (Програм меморија ? 0).


f := Датотека нови: ['/tmp/citrine_test_file.txt'].
f додај-на-крај: ['hello'].
Програм очисти.
usedMemory2 := (Програм меморија ? 0).


f := Датотека нови: ['/tmp/citrine_test_file.txt'].
f додај-на-крај: ['hello'].
Програм очисти.
usedMemory3 := (Програм меморија ? 0).



( usedMemory1 = usedMemory2 и: usedMemory1 = usedMemory3, и: usedMemory2 = usedMemory3 ) тачно: {
	Излаз пиши: ['No memory leaks here'].
}, нетачно: {
	Излаз пиши: ['Leaking memory...'].
}.
