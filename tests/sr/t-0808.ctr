# кључеви и потписи сефа који се декодирају предуго не смеју да прекораче стек
Server init.

>> кључеви := Сеф генериши-кључеве.
>> sk := кључеви први.
>> pk := кључеви последњи.
>> потп := Сеф потпиши: ['abc'] кључем: sk.

# 88 знакова без допуне декодира се у 66 бајтова
>> дуг := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 знака без допуне декодира се у 33 бајта
>> кратко := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Сеф потпиши: ['abc'] кључем: дуг. } ухвати: { :e
	Излаз пиши: e, нови-ред.
}, покрени.

{ Сеф провери: ['abc'] потпис: дуг кључем: pk. } ухвати: { :e
	Излаз пиши: e, нови-ред.
}, покрени.

{ Сеф провери: ['abc'] потпис: потп кључем: кратко. } ухвати: { :e
	Излаз пиши: e, нови-ред.
}, покрени.
