

Текст на: ['html'] уради: { <- (
		себе
		замени: ['&'] са: ['&amp;'],
		замени: ['<'] са: ['&lt;'],
		замени: ['>'] са: ['&gt;'],
		замени: ['"'] са: ['&quot;']
	).
}.


Излаз пиши: ([' лево скраћено '] скрати) + [' '] + ( ['и десно скраћено'] скрати) + ['!'], нови-ред.
Излаз пиши: ['<html>"html & entities"</html>'] html.
