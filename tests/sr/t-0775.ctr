Излаз пиши: ['Test object'], нови-ред.
>> l := Листа нови ; 1 ; ( Листа нови ; (Тренутак нови: 1) ; (Int64 из-текста: ['321']) ; (Листа нови ; 3)).
Излаз пиши: l, нови-ред.
>> old-lst-address := l прототип меморијска-адреса.
l save-as: ['/tmp/a.bin'].
Излаз пиши: ['========== RELOADING SNAP:'], нови-ред.
>> b := Објекат load-from: ['/tmp/a.bin'].
(b прототип меморијска-адреса = old-lst-address) тачно: {
	Излаз пиши: ['Object link re-attached.'], нови-ред.
}.
Излаз пиши: b, нови-ред.
