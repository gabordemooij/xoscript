Излаз пиши: ['Тест објекат'], нови-ред.
>> l := Листа нови ; 1 ; ( Листа нови ; (Тренутак нови: 1) ; (Int64 из-текста: ['321']) ; (Листа нови ; 3)).
Излаз пиши: l, нови-ред.
>> стара-лст-адреса := l прототип меморијска-адреса.
l save-as: ['/tmp/a.bin'].
Излаз пиши: ['========== ПОНОВНО УЧИТАВАЊЕ СНИМКА:'], нови-ред.
>> b := Објекат load-from: ['/tmp/a.bin'].
(b прототип меморијска-адреса = стара-лст-адреса) тачно: {
	Излаз пиши: ['Веза објекта поново прикачена.'], нови-ред.
}.
Излаз пиши: b, нови-ред.
