
>> земље := Листа нови
	~ ['Швајцарска']
	~ ['Италија']
	~ ['Немачка'].

>> јела := Листа нови
	~ ['Rösti']
	~ ['Шпагети']
	~ ['Кисели купус'].


>> бројач := 0.
јела према: земље, сваки: { :key :value
	бројач додај: 1.
}.

Излаз пиши: (['we serve counter dishes'] counter: бројач), нови-ред.

>> бројач := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] знакови сортирај: { :v
	бројач додај: 0.
}.

Излаз пиши: (['we sort counter dishes'] counter: бројач), нови-ред.


>> бројач := 0.
{
	{
		бројач додај: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Излаз пиши: (['we calculate counter numbers.'] counter: бројач), нови-ред.

