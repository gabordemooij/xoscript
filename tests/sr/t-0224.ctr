
>> countries := Листа нови
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Листа нови
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods према: countries, сваки: { :key :value
	counter додај: 1.
}.

Излаз пиши: (['we serve counter dishes'] counter: counter), нови-ред.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] знакови сортирај: { :v
	counter додај: 0.
}.

Излаз пиши: (['we sort counter dishes'] counter: counter), нови-ред.


>> counter := 0.
{
	{
		counter додај: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Излаз пиши: (['we calculate counter numbers.'] counter: counter), нови-ред.

