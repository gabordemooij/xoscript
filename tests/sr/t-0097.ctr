
Текст на: ['html'] уради: { <- (
		себе
		замени: ['&'] са: ['&amp;'],
		замени: ['<'] са: ['&lt;'],
		замени: ['>'] са: ['&gt;'],
		замени: ['"'] са: ['&quot;']
	).
}.

>> HtmlЧетка := Објекат нови.

HtmlЧетка на: ['одговори:'] уради: { :таг
	Излаз пиши: (['<tag>↵'] tag: таг ).
}.

HtmlЧетка на: ['одговори:и:'] уради: { :таг :content
	таг := ( таг од: 0 дужина: (таг дужина - 1) ).
	Излаз пиши: (['<tag content>↵'] tag: таг, content: content).
}.

HtmlЧетка на: ['content:'] уради: { :натпис
	Излаз пиши: натпис html, нови-ред.
}.

HtmlЧетка на: ['атр:вредност:'] уради: { :атр :value <- ['attr="value"'] attr: атр, value: value.
}.

>> h := HtmlЧетка нови.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h атр: ['class'] вредност: ['bold']),
		/span
	/body
/html.
		
