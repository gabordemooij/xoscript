>> a := 3.
>> b := a копирај.
a одузми: 1.
Излаз пиши: [' a = '] + a.
Излаз пиши: [' b = '] + b.
a := 3.
b := a + 4.
Излаз пиши: [' a = '] + a.
Излаз пиши: [' b = '] + b.
>> x := 3.
>> y := x копирај.
x додај: 10.
y одузми: 1.
Излаз пиши: [' x = '] + x.
Излаз пиши: [' y = '] + y.
>> q := Објекат нови.
q на: ['setProperty:'] уради: { :x
	свој особ := x.
}.
q на: ['дајОсобину'] уради: { <- свој особ.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Излаз пиши: [' p = '] + (p дајОсобину).
