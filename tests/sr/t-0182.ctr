

>> коришћенаМеморија1 := 0.
>> коришћенаМеморија2 := 0.
>> коришћенаМеморија3 := 0.
>> коришћенаМеморија4 := 0.

Програм управљање-меморијом: 0.

>> txt := ['1.6'].
>> n := txt број.
>> t := txt логички.
Излаз пиши: n, нови-ред.
Излаз пиши: t, нови-ред.
Излаз пиши: n тип, нови-ред.
Излаз пиши: t тип, нови-ред.

Програм очисти.

коришћенаМеморија1 := (Програм меморија ? 0).


txt := ['1.6'].
n := txt број.
t := txt логички.
Излаз пиши: n, нови-ред.
Излаз пиши: t, нови-ред.
Излаз пиши: n тип, нови-ред.
Излаз пиши: t тип, нови-ред.

Програм очисти.
коришћенаМеморија2 := (Програм меморија ? 0).


txt := ['1.6'].
n := txt број.
t := txt логички.
Излаз пиши: n, нови-ред.
Излаз пиши: t, нови-ред.
Излаз пиши: n тип, нови-ред.
Излаз пиши: t тип, нови-ред.

Програм очисти.
коришћенаМеморија3 := (Програм меморија ? 0).



( коришћенаМеморија1 = коришћенаМеморија2 и: коришћенаМеморија1 = коришћенаМеморија3, и: коришћенаМеморија2 = коришћенаМеморија3 ) тачно: {
	Излаз пиши: ['Овде нема цурења меморије'].
}, нетачно: {
	Излаз пиши: ['Меморија цури...'].
}.
