

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програм управљање-меморијом: 0.

>> txt := ['1.6'].
>> n := txt број.
>> t := txt логички.
Излаз пиши: n, нови-ред.
Излаз пиши: t, нови-ред.
Излаз пиши: n тип, нови-ред.
Излаз пиши: t тип, нови-ред.

Програм очисти.

usedMemory1 := (Програм меморија ? 0).


txt := ['1.6'].
n := txt број.
t := txt логички.
Излаз пиши: n, нови-ред.
Излаз пиши: t, нови-ред.
Излаз пиши: n тип, нови-ред.
Излаз пиши: t тип, нови-ред.

Програм очисти.
usedMemory2 := (Програм меморија ? 0).


txt := ['1.6'].
n := txt број.
t := txt логички.
Излаз пиши: n, нови-ред.
