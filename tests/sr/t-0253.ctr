#Linux
>> OS := Програм подешавање: ['OS'].

>> часовник := Тренутак нови.
	
(OS = ['Haiku']) тачно: {
	часовник зона: ['CET'],
	година: 2017, месец: 7, дан: 13,
	сат: 18, минут: 0, секунда: 0.
}, иначе: {
	часовник зона: ['Europe/Amsterdam'],
	година: 2017, месец: 7, дан: 13,
	сат: 18, минут: 0, секунда: 0.
}.

часовник на: ['кажи'] уради: {
	Излаз пиши: себе, нови-ред.
}.


часовник додај: 2    сат, кажи.
часовник додај: 1    сат, кажи.
часовник додај: 19 минут, кажи.
часовник додај: 1  минут, кажи.
часовник додај: 1  минут, кажи.
часовник додај: 19 секунда, кажи.
часовник додај: 1  секунда, кажи.
часовник додај: 1  секунда, кажи.
часовник додај: 2    година, кажи.
часовник додај: 1    година, кажи.

(OS = ['Haiku']) тачно: {
часовник додај: 5   месец.
часовник зона: ['CEST'], кажи.
}, иначе: {
	часовник додај: 5   месец, кажи.
}.

часовник додај: 1   месец, кажи.
