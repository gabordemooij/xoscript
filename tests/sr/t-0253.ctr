#Linux
>> OS := Програм подешавање: ['OS'].

>> clock := Тренутак нови.
	
(OS = ['Haiku']) тачно: {
	clock зона: ['CET'],
	година: 2017, месец: 7, дан: 13,
	сат: 18, минут: 0, секунда: 0.
}, иначе: {
	clock зона: ['Europe/Amsterdam'],
	година: 2017, месец: 7, дан: 13,
	сат: 18, минут: 0, секунда: 0.
}.

clock на: ['tell'] уради: {
	Излаз пиши: себе, нови-ред.
}.


clock додај: 2    сат, tell.
clock додај: 1    сат, tell.
clock додај: 19 минут, tell.
clock додај: 1  минут, tell.
clock додај: 1  минут, tell.
clock додај: 19 секунда, tell.
clock додај: 1  секунда, tell.
clock додај: 1  секунда, tell.
clock додај: 2    година, tell.
clock додај: 1    година, tell.

(OS = ['Haiku']) тачно: {
clock додај: 5   месец.
clock зона: ['CEST'], tell.
}, иначе: {
	clock додај: 5   месец, tell.
}.

clock додај: 1   месец, tell.
clock додај: 19    дан, tell.
clock додај: 1    сат, tell.
clock додај: 120  yard, tell.
