>> HTML := Објекат нови.
HTML на: ['одговори:'] уради: { :таг 
	Излаз пиши: (['<tag>'] tag: таг), нови-ред.
}.
HTML на: ['одговори:и:'] уради: { :таг :html 
	Излаз пиши: (
		['<tag>innerHTML</tag>']
		tag: таг - [':'],
		innerHTML: html
	), нови-ред.
}.
>> html := HTML нови.
html body h1: ['header'].

