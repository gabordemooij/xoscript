>> HTML := Објекат нови.
HTML на: ['одговори:'] уради: { :tag 
	Излаз пиши: (['<tag>'] tag: tag), нови-ред.
}.
HTML на: ['одговори:и:'] уради: { :tag :html 
	Излаз пиши: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), нови-ред.
}.
>> html := HTML нови.
html body h1: ['header'].

