# јавни кључ (за заштиту API-ја итд.)
Server init.

# генерисање кључева
>> кључеви := Сеф генериши-кључеве.

# приватни (тајни) кључ
>> sk := кључеви први.

# јавни кључ
>> pk := кључеви последњи.

# потписивање поруке
>> потп := Сеф потпиши: ['abc'] кључем: sk.

# провера поруке (ок)
Излаз пиши: ( 
	Сеф
		провери: ['abc'] 
		потпис: потп 
		кључем: pk 
), нови-ред.

# провера поруке (неуспех)
Излаз пиши: ( 
	Сеф 
		провери: ['abd'] 
		потпис: потп 
		кључем: pk 
), нови-ред.