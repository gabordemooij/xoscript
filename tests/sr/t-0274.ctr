

Листа на: ['column:'] уради: { :колона
	>> резултат := Листа нови.
	себе сваки: { :индекс :врста
		врста сваки: { :индекс :ћелија
			(индекс = колона) тачно: { резултат додај-на-крај: ћелија. }.
		}.
	}. <- резултат.
}.


>> a := Листа ←
	(Листа ← 1 ; 2 ; 3) ;
	(Листа ← 4 ; 5 ; 6) ;
	(Листа ← 7 ; 8 ; 9).

>> b := a column: 1.
Излаз пиши: b, нови-ред.

b := a column: 20.
Излаз пиши: b, нови-ред.

b := a column: -100.
Излаз пиши: b, нови-ред.
