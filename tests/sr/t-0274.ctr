

Листа на: ['column:'] уради: { :column
	>> result := Листа нови.
	себе сваки: { :index :row
		row сваки: { :index :cell
			(index = column) тачно: { result додај-на-крај: cell. }.
		}.
	}. <- result.
}.


>> a := Листа ←
	(Листа ← 1 ; 2 ; 3) ;
	(Листа ← 4 ; 5 ; 6) ;
	(Листа ← 7 ; 8 ; 9).

>> b := a column: 1.
Излаз пиши: b, нови-ред.

b := a column: 20.
Излаз пиши: b, нови-ред.

b := a column: -100.
Излаз пиши: b, нови-ред.
