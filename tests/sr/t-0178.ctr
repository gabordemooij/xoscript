

>> коришћенаМеморија1 := 0.
>> коришћенаМеморија2 := 0.
>> коришћенаМеморија3 := 0.
>> коришћенаМеморија4 := 0.

Програм управљање-меморијом: 0.

>> txt := ['Word Salad'].
Излаз пиши: ['последњи индекс од ord = '] + (( txt последњи: ['ord'] ) - 0), нови-ред.
Излаз пиши: ['индекс од ord = '] + (( txt пронађи: ['ord'] ) - 0), нови-ред.
Излаз пиши: ['индекс од ad = '] + (( txt пронађи: ['ad'] ) - 0), нови-ред.
Излаз пиши: ['последњи индекс од W = '] + (( txt последњи: ['W'] ) - 0), нови-ред.
Излаз пиши: ['последњи индекс од d = '] + (( txt последњи: ['d'] ) - 0), нови-ред.
Излаз пиши: ['ткст једнако Word Salad = '] + ( txt = ['Word Salad'] ), нови-ред.
Излаз пиши: ['ткст једнако Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), нови-ред.
Излаз пиши: ['ткст није једнако Word Salad = '] + ( txt ≠ ['Word Salad'] ), нови-ред.
Излаз пиши: ['ткст није једнако Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), нови-ред.

Програм очисти.

