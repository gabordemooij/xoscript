
>> Мера := Објекат нови.
Мера на: ['is:'] уради: { :број
	број на: ['+'] уради: { :број
		>> јединица := број одредница.
		>> фактор := 1.
		
		јединица
		случај: ['inch'] уради: { фактор := 0.0833. }.

		<- себе + (број * фактор).
	}.
	<- број.
}.

# Овај број величине може се користити овако:

>> даска := Мера is: 6 стопа.
>> ивица := Мера is: 50 inch.

# Ово ће се приказати као: 10.165
Излаз пиши: даска + ивица, нови-ред.
