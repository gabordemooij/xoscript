
>> Size := Објекат нови.
Size на: ['is:'] уради: { :број
	број на: ['+'] уради: { :број
		>> unit := број одредница.
		>> factor := 1.
		
		unit
		случај: ['inch'] уради: { factor := 0.0833. }. <- себе + (број * factor).
	}. <- број.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Излаз пиши: plank + edge, нови-ред.
