Излаз пиши: ['Тест објекат'], нови-ред.
>> a := Објекат нови. 

a на: ['item:'] уради: { :фмт
	свој фмт := фмт. 
}.

a на: ['ставка'] уради: {
	<- свој фмт.
}.

a item: ( Формат нови: ['|%s|'] ).

Излаз пиши: a ставка, нови-ред.

>> стара-фмт-адреса := a ставка прототип меморијска-адреса.
a save-as: ['/tmp/a.bin'].
Излаз пиши: ['========== ПОНОВНО УЧИТАВАЊЕ СНИМКА:'], нови-ред.

>> b := Објекат load-from: ['/tmp/a.bin'].

(b ставка прототип меморијска-адреса = стара-фмт-адреса) тачно: {
	Излаз пиши: ['Веза објекта поново прикачена.'], нови-ред.
}.

Излаз пиши: ( b ставка примени: ['hello'] ), нови-ред.
