Излаз пиши: ['Test object'], нови-ред.
>> a := Објекат нови. 

a на: ['item:'] уради: { :fmt
	свој fmt := fmt. 
}.

a на: ['item'] уради: { <- свој fmt.
}.

a item: ( Формат нови: ['|%s|'] ).

Излаз пиши: a item, нови-ред.

>> old-fmt-address := a item прототип меморијска-адреса.
a save-as: ['/tmp/a.bin'].
Излаз пиши: ['========== RELOADING SNAP:'], нови-ред.

>> b := Објекат load-from: ['/tmp/a.bin'].

(b item прототип меморијска-адреса = old-fmt-address) тачно: {
	Излаз пиши: ['Object link re-attached.'], нови-ред.
}.

Излаз пиши: ( b item примени: ['hello'] ), нови-ред.
