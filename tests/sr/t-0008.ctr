>> Greeter := Објекат нови.
Greeter на: ['make'] уради: {
	>> greeter := Објекат нови.
	greeter на: ['name:'] уради: { :назив
		Излаз пиши: ['setting a name'].
		свој myName := назив.
	}.
	greeter на: ['greet'] уради: {
		Излаз пиши: ['Hello'].
		Излаз пиши: свој myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
