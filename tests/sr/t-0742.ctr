Излаз пиши: ['Test object'], нови-ред.
>> a := Објекат нови. 

a на: ['item:'] уради: { :hexhelper
	свој hexhelper := hexhelper. 
}.

a на: ['item'] уради: { <- свој hexhelper.
}.

a item: Hx нови.

>> old-hexhelper-address := a item прототип меморијска-адреса.
a save-as: ['/tmp/a.bin'].
Излаз пиши: ['========== RELOADING SNAP:'], нови-ред.

>> b := Објекат load-from: ['/tmp/a.bin'].

(b item прототип меморијска-адреса = old-hexhelper-address) тачно: {
	Излаз пиши: ['Object link re-attached.'], нови-ред.
}.
