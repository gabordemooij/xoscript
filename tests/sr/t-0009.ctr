>> Поздрављач := Објекат нови.
Поздрављач на: ['направи'] уради: {
	>> поздрављач := Објекат нови.
	поздрављач на: ['name:'] уради: { :назив
		Излаз пиши: ['постављање имена'].
		свој мојеИме := назив.
	}.
	поздрављач на: ['изведиПоздрав'] уради: {
		Излаз пиши: ['Hello'].
		Излаз пиши: свој мојеИме.
	}.
	поздрављач на: ['поздрави'] уради: {
		себе изведиПоздрав.
	}. <- поздрављач.
}.
>> поздрављач := Поздрављач направи.
поздрављач name: ['сунце!'].
поздрављач поздрави.
