>> repeater := Објекат нови.
repeater на: ['одговори:'] уради: { :what
	Излаз пиши: what + [' '].
}.
repeater на: ['одговори:и:'] уради: { :what :say
	Излаз пиши: what, пиши: say + [' '].
}.
repeater на: ['одговори:и:и:'] уради: { :what :say :more
	Излаз пиши: what, пиши: say, пиши: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
