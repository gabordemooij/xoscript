>> понављач := Објекат нови.
понављач на: ['одговори:'] уради: { :шта
	Излаз пиши: шта + [' '].
}.
понављач на: ['одговори:и:'] уради: { :шта :say
	Излаз пиши: шта, пиши: say + [' '].
}.
понављач на: ['одговори:и:и:'] уради: { :шта :say :још
	Излаз пиши: шта, пиши: say, пиши: још.
}.
понављач понови.
понављач everything: ['Ја кажем.'].
понављач and: ['I '] everything: ['радим.'].
