Излаз пиши: ['Тест објекат'], нови-ред.
>> a := Објекат нови. 

a на: ['item:'] уради: { :бинпомоћник
	свој бинпомоћник := бинпомоћник. 
}.

a на: ['ставка'] уради: {
	<- свој бинпомоћник.
}.

a item: Bin нови.

>> стара-бинпомоћник-адреса := a ставка прототип меморијска-адреса.
a save-as: ['/tmp/a.bin'].
Излаз пиши: ['========== ПОНОВНО УЧИТАВАЊЕ СНИМКА:'], нови-ред.

>> b := Објекат load-from: ['/tmp/a.bin'].

(b ставка прототип меморијска-адреса = стара-бинпомоћник-адреса) тачно: {
	Излаз пиши: ['Веза објекта поново прикачена.'], нови-ред.
}.


