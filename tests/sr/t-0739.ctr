Излаз пиши: ['Test object'], нови-ред.
>> a := Објекат нови. 

a на: ['item:'] уради: { :binhelper
	свој binhelper := binhelper. 
}.

a на: ['item'] уради: { <- свој binhelper.
}.

a item: Bin нови.

>> old-binhelper-address := a item прототип меморијска-адреса.
a save-as: ['/tmp/a.bin'].
Излаз пиши: ['========== RELOADING SNAP:'], нови-ред.

>> b := Објекат load-from: ['/tmp/a.bin'].

(b item прототип меморијска-адреса = old-binhelper-address) тачно: {
	Излаз пиши: ['Object link re-attached.'], нови-ред.
}.


