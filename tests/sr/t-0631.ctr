#ffi test


Server init.

Програм управљање-меморијом: 4.

# for this test you need set a path to libc (puts)
>> libname := Програм подешавање: ['FFITESTLIB'].



Server повежи: (
 Листа нови ;
 libname ;
 ['puts'] ;
 ( Листа нови ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s ослободи.

# test with struct

>> a := Blob нови: 8.
a bytes: (
	Листа <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Листа <<: ['int'], ; ['int']).

Server повежи: (
	Листа <<: ['@structtest'], ;
	['@structtest'] ;
	(Листа <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Излаз пиши: ['Sum test:'] + (ffitest ffisum: a), нови-ред.

struct ослободи-struct.
struct ослободи.
a ослободи.
