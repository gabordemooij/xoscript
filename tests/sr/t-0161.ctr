Програм управљање-меморијом: 0.
Листа на: ['sum'] уради: {
	>> total := 0.
	себе сваки: { :index :element
		total додај: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Датотека нови: ['/tmp/test.txt'].
f пиши: ['Lorem Ipsum'].
f затвори.
  

f := Датотека нови: ['/tmp/test.txt'].
>> text := f читај.
f затвори.



Програм очисти.
usedMemory1 := (Програм меморија ? 1).



f := Датотека нови: ['/tmp/test.txt'].
text := f читај.
f затвори.

Програм очисти.
usedMemory2 := (Програм меморија ? 1).


f := Датотека нови: ['/tmp/test.txt'].
text := f читај.
f затвори.

Програм очисти.
usedMemory3 := (Програм меморија ? 1).



( usedMemory1 = usedMemory2 и: usedMemory1 = usedMemory3, и: usedMemory2 = usedMemory3 ) тачно: {
	Излаз пиши: ['No memory leaks here'].
}, нетачно: {
	Излаз пиши: ['Leaking memory...'].
}.
