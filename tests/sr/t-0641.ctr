# Тест utf8 чистача
Server init.

>> utf8случајеви := Речник нови
	# Само ASCII
	стави: ( Листа нови ; 65 ; 65 ; 65 ; 65 ; 0 ) на: ['AAAA'],
	# исправна секвенца од 2 бајта
	стави: ( Листа нови ; 194 ; 162 ; 0 ) на: ['¢'],
	# Исправан 3-бајтни UTF-8
    стави: ( Листа нови ; 226 ; 130 ; 172 ; 0 ) на: ['€'],
	# Исправан 4-бајтни UTF-8
    стави: ( Листа нови ; 240 ; 144 ; 141 ; 136 ; 0 ) на: ['𐍈'],
	# Неисправан наставни бајт у секвенци E2 28 AC -> почетак 3b секвенце + 28 погрешан наставни + AC наставни бајт, али припада истој грешци
    стави: ( Листа нови ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) на: ['A?A'],
	# Предугачко кодирање ASCII 'A' (треба да постане ?),
    стави: ( Листа нови ; 65 ; 193 ; 129 ; 0 ) на: ['A?'],
	# Неисправан први бајт (0xFF)
    стави: ( Листа нови ; 255 ; 0 ) на: ['?'],
	# Непотпуна вишебајтна секвенца на крају
    стави: ( Листа нови ; 66 ; 226 ; 0 ) на: ['B?'],
    # Празан текст
    #put: ( List new ) at: [''],
	# Више мешаних секвенци
    стави: ( Листа нови ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) на: ['A€?𐍈B'].
	 
utf8случајеви сваки: { :key :value
	>> blob := Blob нови: value број-елемената, bytes: value.
	>> str := blob текст.
	(str = key) тачно: {
		Излаз пиши: ['OK'], нови-ред.
	}, иначе: {
		Излаз пиши: ['UTF8 чистач није успео на: '] + key + [' добијено: '] + str, нови-ред.
	}.
	blob ослободи.
}.
