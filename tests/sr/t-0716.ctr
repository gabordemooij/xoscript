Излаз пиши: ['Тест објекат'], нови-ред.
>> a := Објекат нови. 

a на: ['state:'] уради: { :list
	свој list := list. 
}.

a на: ['стање'] уради: {
	Излаз пиши: свој list, нови-ред.
}.

a state: ( Листа нови ; ['ставкалисте'] ; ['ставка2'] ).
a стање.

a save-as: ['/tmp/a.bin'].
Излаз пиши: ['========== ПОНОВНО УЧИТАВАЊЕ СНИМКА:'], нови-ред.
>> b := Објекат load-from: ['/tmp/a.bin'].
b стање.