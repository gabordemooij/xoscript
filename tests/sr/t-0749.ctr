Излаз пиши: ['Тест објекат'], нови-ред.
>> a := Објекат нови. 

a на: ['item:'] уради: { :логички
	свој логички := логички. 
}.

a на: ['ставка'] уради: {
	<- свој логички.
}.

a item: Нетачно.

Излаз пиши: a ставка, нови-ред.

>> стара-лог-адреса := a ставка прототип меморијска-адреса.
a save-as: ['/tmp/a.bin'].
Излаз пиши: ['========== ПОНОВНО УЧИТАВАЊЕ СНИМКА:'], нови-ред.

>> b := Објекат load-from: ['/tmp/a.bin'].

(b ставка прототип меморијска-адреса = стара-лог-адреса) тачно: {
	Излаз пиши: ['Веза објекта поново прикачена.'], нови-ред.
}.

Излаз пиши: b ставка, нови-ред.
