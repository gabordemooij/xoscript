['Хиљаде и децимале'].

>> x := 100000000.5.
>> y := 100000000.5.

Излаз пиши: (x + y), нови-ред.

>> x := 10040.07.
>> y := 10305.60.

Излаз пиши: (x + y), нови-ред.

['Децимално'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Излаз пиши: (x + y + z), нови-ред.

['Чудно али исправно'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Излаз пиши: (x + y + z), нови-ред.

>> q := 0.1.2.

Излаз пиши: (q), нови-ред.

>> q := 012.

Излаз пиши: (q), нови-ред.
