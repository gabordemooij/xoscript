Излаз пиши: ['Тест објекат'], нови-ред.
>> поздрављач := Објекат нови.
поздрављач на: ['name:'] уради: { :назив
	свој xиме := назив. 
}.
поздрављач на: ['поздрави'] уради: {
	Излаз пиши: ['Здраво '] + свој xиме, нови-ред.
}.
поздрављач name: ['Sherlock'].
поздрављач save-as: ['/tmp/a.bin'].
Излаз пиши: ['========== ПОНОВНО УЧИТАВАЊЕ СНИМКА:'], нови-ред.
>> b := Објекат load-from: ['/tmp/a.bin'].
b поздрави.
b name: ['Watson'], поздрави.
