#Linux
>> часовник := Тренутак нови.
часовник зона: ['UTC-1'].
часовник година: 1981, месец: 1, дан: 5,
      сат: 13, минут: 15, секунда: 13.

Излаз пиши: часовник, нови-ред.
часовник зона: ['UTC+0'].

Излаз пиши: (
	(часовник година обичан) + ['-'] + (часовник месец) + ['-'] + (часовник дан) + [' '] +
	(часовник сат) + [':'] + (часовник минут) + [':'] + (часовник секунда) + [' '] +
	['W'] + (часовник недеља) + (часовник зона)
), нови-ред.


часовник зона: ['UTC-1'].
Излаз пиши: (
	(часовник година обичан) + ['-'] + (часовник месец) + ['-'] + (часовник дан) + [' '] +
	(часовник сат) + [':'] + (часовник минут) + [':'] + (часовник секунда) + [' '] +
	['W'] + (часовник недеља) + (часовник зона)
), нови-ред.
