#Linux
>> clock := Тренутак нови.
clock зона: ['UTC-1'].
clock година: 1981, месец: 1, дан: 5,
      сат: 13, минут: 15, секунда: 13.

Излаз пиши: clock, нови-ред.
clock зона: ['UTC+0'].

Излаз пиши: (
	(clock година обичан) + ['-'] + (clock месец) + ['-'] + (clock дан) + [' '] +
	(clock сат) + [':'] + (clock минут) + [':'] + (clock секунда) + [' '] +
	['W'] + (clock недеља) + (clock зона)
), нови-ред.


clock зона: ['UTC-1'].
Излаз пиши: (
	(clock година обичан) + ['-'] + (clock месец) + ['-'] + (clock дан) + [' '] +
	(clock сат) + [':'] + (clock минут) + [':'] + (clock секунда) + [' '] +
	['W'] + (clock недеља) + (clock зона)
), нови-ред.
