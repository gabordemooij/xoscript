Излаз пиши: (
	Програм могућност: 
	['RECURSIVE_STRINTPOL']
), нови-ред.


# али ако вратимо време уназад
>> данас := Тренутак 
зона: ['CEST'],
из: ['2026-02-15 10:00:00'].
Програм верзија: данас.

# биће укључена као раније (од сада па надаље)
Излаз пиши: (
	Програм могућност: 
	['RECURSIVE_STRINTPOL']
), нови-ред.