# test qualifiers

Програм очисти.

>> Fruit := Објекат нови.
Fruit на: ['нови'] уради: {
	>> f := себе нови.
	f apples: 0. <- f.
}.
Fruit на: ['apples:'] уради: { :a свој apples := a. }.
Fruit на: ['apples'] уради: { <- свој apples. }.
Fruit на: ['+'] уради: { :f
	>> n := Fruit нови.
	n apples: (f apples + свој apples). <- n.
}.
Број на: ['apples'] уради: { <- ((Fruit нови) apples: себе).
}.

Fruit на: ['текст'] уради: { <- свој apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Излаз пиши: q, нови-ред.




q := 3 apples + 4 apples.
Излаз пиши: q, нови-ред.



q := 3 apples + 4 apples.
Излаз пиши: q, нови-ред.


