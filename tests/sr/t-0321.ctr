# тест одредница

Програм очисти.

>> Воће := Објекат нови.
Воће на: ['нови'] уради: {
	>> f := себе нови.
	f apples: 0. <- f.
}.
Воће на: ['apples:'] уради: { :a свој јабуке := a. }.
Воће на: ['јабуке'] уради: { <- свој јабуке. }.
Воће на: ['+'] уради: { :f
	>> n := Воће нови.
	n apples: (f јабуке + свој јабуке). <- n.
}.
Број на: ['јабуке'] уради: { <- ((Воће нови) apples: себе).
}.

Воће на: ['текст'] уради: { <- свој јабуке + [' јабука '].
}.

>> q := 3 јабуке + 4 јабуке.
Излаз пиши: q, нови-ред.




q := 3 јабуке + 4 јабуке.
Излаз пиши: q, нови-ред.



q := 3 јабуке + 4 јабуке.
Излаз пиши: q, нови-ред.


