

Листа на: ['sum'] уради: {
	>> total := 0.
	себе сваки: { :index :element
		total додај: element.
	}. <- total.
}.

Листа на: ['product'] уради: {
	>> total := 1.
	себе сваки: { :index :element
		total помножи-са: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програм управљање-меморијом: 0.

{

>> a := Листа ← ['hello'] ; ['world'] ; Тачно ; Ништа ; 666.
a := a + ( Листа ← 1 ).
Излаз пиши: ( ['sum: '] + ( a sum ) ), нови-ред.
Излаз пиши: ( ['min: '] + ( a минимум ) ), нови-ред.
Излаз пиши: ( ['max: '] + ( a максимум ) ), нови-ред.
Излаз пиши: ( ['3rd: '] + ( a ? 2 ) ), нови-ред.
Излаз пиши: ( ['prd: '] + ( a product ) ), нови-ред.
a сортирај: { :a :b <- (b - a). }.
a сваки: { :i :e Излаз пиши: ( i - 0 ), нови-ред. }.

} покрени.

Програм очисти.
usedMemory1 := (Програм меморија ? 0).


{

>> a := Листа ← ['hello'] ; ['world'] ; Тачно ; Ништа ; 666.
a := a + ( Листа ← 1 ).
Излаз пиши: ( ['sum: '] + ( a sum ) ), нови-ред.
Излаз пиши: ( ['min: '] + ( a минимум ) ), нови-ред.
Излаз пиши: ( ['max: '] + ( a максимум ) ), нови-ред.
Излаз пиши: ( ['3rd: '] + ( a ? 2 ) ), нови-ред.
Излаз пиши: ( ['prd: '] + ( a product ) ), нови-ред.
a сортирај: { :a :b <- (b - a). }.
a сваки: { :i :e Излаз пиши: ( i - 0 ), нови-ред. }.

} покрени.



Програм очисти.
usedMemory2 := (Програм меморија ? 0).


{

>> a := Листа ← ['hello'] ; ['world'] ; Тачно ; Ништа ; 666.
a := a + ( Листа ← 1 ).
Излаз пиши: ( ['sum: '] + ( a sum ) ), нови-ред.
Излаз пиши: ( ['min: '] + ( a минимум ) ), нови-ред.
Излаз пиши: ( ['max: '] + ( a максимум ) ), нови-ред.
Излаз пиши: ( ['3rd: '] + ( a ? 2 ) ), нови-ред.
Излаз пиши: ( ['prd: '] + ( a product ) ), нови-ред.
a сортирај: { :a :b <- (b - a). }.
a сваки: { :i :e Излаз пиши: ( i - 0 ), нови-ред. }.

} покрени.



Програм очисти.
usedMemory3 := (Програм меморија ? 0).

( usedMemory1 = usedMemory2 и: usedMemory1 = usedMemory3, и: usedMemory2 = usedMemory3 ) тачно: {
	Излаз пиши: ['No memory leaks here'].
}, нетачно: {
	Излаз пиши: ['Leaking memory...'].
}.
