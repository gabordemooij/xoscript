

Листа на: ['збир'] уради: {
	>> укупно := 0.
	себе сваки: { :индекс :елемент
		укупно додај: елемент.
	}. <- укупно.
}.

Листа на: ['производ'] уради: {
	>> укупно := 1.
	себе сваки: { :индекс :елемент
		укупно помножи-са: елемент.
	}. <- укупно.
}.

>> коришћенаМеморија1 := 0.
>> коришћенаМеморија2 := 0.
>> коришћенаМеморија3 := 0.
>> коришћенаМеморија4 := 0.

Програм управљање-меморијом: 0.

{

>> a := Листа ← ['hello'] ; ['world'] ; Тачно ; Ништа ; 666.
a := a + ( Листа ← 1 ).
Излаз пиши: ( ['збир: '] + ( a збир ) ), нови-ред.
Излаз пиши: ( ['мин: '] + ( a минимум ) ), нови-ред.
Излаз пиши: ( ['макс: '] + ( a максимум ) ), нови-ред.
Излаз пиши: ( ['3.: '] + ( a ? 2 ) ), нови-ред.
Излаз пиши: ( ['произв: '] + ( a производ ) ), нови-ред.
a сортирај: { :a :b <- (b - a). }.
a сваки: { :i :e Излаз пиши: ( i - 0 ), нови-ред. }.

} покрени.

Програм очисти.
коришћенаМеморија1 := (Програм меморија ? 0).


{

>> a := Листа ← ['hello'] ; ['world'] ; Тачно ; Ништа ; 666.
a := a + ( Листа ← 1 ).
Излаз пиши: ( ['збир: '] + ( a збир ) ), нови-ред.
Излаз пиши: ( ['мин: '] + ( a минимум ) ), нови-ред.
Излаз пиши: ( ['макс: '] + ( a максимум ) ), нови-ред.
Излаз пиши: ( ['3.: '] + ( a ? 2 ) ), нови-ред.
Излаз пиши: ( ['произв: '] + ( a производ ) ), нови-ред.
a сортирај: { :a :b <- (b - a). }.
a сваки: { :i :e Излаз пиши: ( i - 0 ), нови-ред. }.

} покрени.



Програм очисти.
коришћенаМеморија2 := (Програм меморија ? 0).


{

>> a := Листа ← ['hello'] ; ['world'] ; Тачно ; Ништа ; 666.
a := a + ( Листа ← 1 ).
Излаз пиши: ( ['збир: '] + ( a збир ) ), нови-ред.
Излаз пиши: ( ['мин: '] + ( a минимум ) ), нови-ред.
Излаз пиши: ( ['макс: '] + ( a максимум ) ), нови-ред.
Излаз пиши: ( ['3.: '] + ( a ? 2 ) ), нови-ред.
Излаз пиши: ( ['произв: '] + ( a производ ) ), нови-ред.
a сортирај: { :a :b <- (b - a). }.
a сваки: { :i :e Излаз пиши: ( i - 0 ), нови-ред. }.

} покрени.



Програм очисти.
коришћенаМеморија3 := (Програм меморија ? 0).

( коришћенаМеморија1 = коришћенаМеморија2 и: коришћенаМеморија1 = коришћенаМеморија3, и: коришћенаМеморија2 = коришћенаМеморија3 ) тачно: {
	Излаз пиши: ['Овде нема цурења меморије'].
}, нетачно: {
	Излаз пиши: ['Меморија цури...'].
}.
