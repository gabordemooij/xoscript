

>> об := Објекат нови.

об на: ['поздрави'] уради: {
	<- ['ћао'].
}.

# треба да испише hi123hi123ok
об на: ['задатак'] уради: {
	свој особина := 123.
	{
		# try везује self/own за објекат уместо за блок
		Излаз пиши: себе поздрави.
		Излаз пиши: свој особина.
		1 / 0.
	} ухвати: {
		Излаз пиши: себе поздрави.
		Излаз пиши: свој особина.
		Излаз пиши: ['ok'].
	}, покушај.
}.

об задатак.