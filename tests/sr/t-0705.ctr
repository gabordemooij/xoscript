

>> obj := Објекат нови.

obj на: ['greet'] уради: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj на: ['task'] уради: {
	свој property := 123.
	{
		# try binds self/own to object instead of block
		Излаз пиши: себе greet.
		Излаз пиши: свој property.
		1 / 0.
	} ухвати: {
		Излаз пиши: себе greet.
		Излаз пиши: свој property.
		Излаз пиши: ['ok'].
	}, покушај.
}.

obj task.