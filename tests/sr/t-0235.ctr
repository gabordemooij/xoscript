>> Сркач := Објекат нови.
Сркач на: ['нови'] уради: {
	свој str := [''].
}.

Сркач на: ['одговори:'] уради: { :blah
		(свој str ≠ ['']) тачно: {
			свој str додај-на-крај: [' '].
		}.
		свој str додај-на-крај: blah.
}.
Сркач на: ['одговори:и:'] уради: { :blah :blahah
		(свој str ≠ ['']) тачно: {
			свој str додај-на-крај: [' '].
		}.
		(blah дужина > 1) тачно: {
			свој str додај-на-крај: (blah од: 0 дужина: (blah дужина - 1)).
		}, иначе: {
			свој str додај-на-крај: blah.
		}.
		свој str додај-на-крај: [' '].
		свој str додај-на-крај: blahah.
}.
Сркач на: ['прибави'] уради: {
	>> бафер := свој str.
	свој str := ['']. <- бафер.
}.

>> s := Сркач нови.
s hello: ['world'].
Излаз пиши: ( s прибави ), нови-ред.
