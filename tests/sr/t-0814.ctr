# session cookie format, json content type, web protocols only, svg shown inline
Server иницијализуј.
Програм користи: ['../../../src/xo/sr/webtools.xo'].

>> Fake-Request := Објекат нови.
Fake-Request на: ['value:'] уради: { :вредност
	свој вредност := вредност.
}.
Fake-Request на: ['cookie:'] уради: { :назив <- свој вредност.
}.

>> Test-Session := Сесија-привремена-датотека нови.
Test-Session на: ['учитај'] уради: { <- Речник нови.
}.
Test-Session на: ['session-id'] уради: { <- свој id.
}.

>> cookies := Листа нови
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

cookies сваки: { :i :cookie
	>> захтев := Fake-Request нови.
	захтев value: cookie.
	>> управљач := Test-Session нови.
	>> web := Веб-документ нови.
	web захтев: захтев.
	web управљач-сесија: управљач.
	web покрени-сесију.
	Излаз пиши: ( управљач session-id = cookie ), нови-ред.
}.

>> web := Веб-документ нови.
web json: (Речник нови стави: ['b'] на: ['a']).
Излаз пиши: ['\n'], нови-ред.

{ Мрежа get: ['file:///etc/hostname']. } ухвати: { :e
	Излаз пиши: e, нови-ред.
}, покрени.

>> svg := Датотека нови: ['/tmp/test0814.svg'].
svg пиши: ['<svg xmlns="x"></svg>'].
Излаз нови-ред.
Server проследи: ['test0814.svg'] префикс: ['/tmp/'].
svg избриши.
