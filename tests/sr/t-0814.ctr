# формат колачића сесије, json тип садржаја, само веб протоколи, svg приказан у линији
Server иницијализуј.
Програм користи: ['../../../src/xo/sr/webtools.xo'].

>> Лажни-Захтев := Објекат нови.
Лажни-Захтев на: ['value:'] уради: { :вредност
	свој вредност := вредност.
}.
Лажни-Захтев на: ['cookie:'] уради: { :назив
	<- свој вредност.
}.

>> Тест-Сесија := Сесија-привремена-датотека нови.
Тест-Сесија на: ['учитај'] уради: {
	<- Речник нови.
}.
Тест-Сесија на: ['идентификатор-сесије'] уради: {
	<- свој id.
}.

>> колачићи := Листа нови
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

колачићи сваки: { :i :колачић
	>> захтев := Лажни-Захтев нови.
	захтев value: колачић.
	>> управљач := Тест-Сесија нови.
	>> веб := Веб-документ нови.
	веб захтев: захтев.
	веб управљач-сесија: управљач.
	веб покрени-сесију.
	Излаз пиши: ( управљач идентификатор-сесије = колачић ), нови-ред.
}.

>> веб := Веб-документ нови.
веб json: (Речник нови стави: ['b'] на: ['a']).
Излаз пиши: ['\n'], нови-ред.

{ Мрежа get: ['file:///etc/hostname']. } ухвати: { :e
	Излаз пиши: e, нови-ред.
}, покрени.

>> svg := Датотека нови: ['/tmp/test0814.svg'].
svg пиши: ['<svg xmlns="x"></svg>'].
Излаз нови-ред.
Server проследи: ['test0814.svg'] префикс: ['/tmp/'].
svg избриши.
