


>> Шпил := Листа нови.
Шпил на: ['штампај'] уради: {
        >> len := себе број-елемената - 1.
        { :i
                >> дуж2 := себе број-елемената - 1.
                Излаз пиши: ['дуж: '].
                Излаз пиши: len, нови-ред.
                Излаз пиши: ['дуж2: '].
                Излаз пиши: дуж2, нови-ред.
        } × len.
}.

>> d := Шпил ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d штампај.
