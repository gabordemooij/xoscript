


>> Deck := Листа нови.
Deck на: ['print'] уради: {
        >> len := себе број-елемената - 1.
        { :i
                >> len2 := себе број-елемената - 1.
                Излаз пиши: ['len: '].
                Излаз пиши: len, нови-ред.
                Излаз пиши: ['len2: '].
                Излаз пиши: len2, нови-ред.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
