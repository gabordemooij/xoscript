Server init.

# JSON кодер подржава само UTF-8, без сурогатних парова

>> речници := Листа нови ;
	# {"key":"normal"} обичан ASCII
	( Речник нови стави: ['нормално'] на: ['key'] ) ;
	# {"key":"hello world"} знак размака
	( Речник нови стави: ['hello world'] на: ['key'] ) ;
	# {"key":"quote: \""} двоструки наводник
	( Речник нови стави: ['"'] на: ['key'] ) ;
	# {"key":"backslash: \\"} обрнута коса црта
	( Речник нови стави: ['backslash: \\'] на: ['key'] ) ;
	# {"key":"slash: /"} коса црта
	( Речник нови стави: ['коса црта: /'] на: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( Речник нови стави: ['backspace: \b'] на: ['key'] ) ;
	# {"key":"formfeed: \f"} form-feed излазна секвенца
	( Речник нови стави: ['formfeed: \f'] на: ['key'] ) ;
	# {"key":"newline: \n"} нови ред
	( Речник нови стави: ['newline: \n'] на: ['key'] ) ;
	( Речник нови стави: ['newline: ↵'] на: ['key'] ) ;
	( Речник нови стави: ['newline: 
	'] на: ['key'] ) ;
	# {"key":"carriage return: \r"} carriage-return
	( Речник нови стави: ['carriage return: \r'] на: ['key'] ) ;
	# {"key":"tab: \t"} табулатор
	( Речник нови стави: ['tab \t'] на: ['key'] ) ;
	( Речник нови стави: ['tab ⇿'] на: ['key'] ) ;
	( Речник нови стави: ['таб  '] на: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( Речник нови стави: ['NUL \u0000'] на: ['key'] ) ;
	( Речник нови стави: ['NUL \0'] на: ['key'] ) ;
	# {"key":"control: \u0001"} контролни знак 0x01
	( Речник нови стави: ['control: \u0001'] на: ['key'] ) ;
	# {"key":"control: \u001F"} контролни знак 0x1F
	( Речник нови стави: ['control: \u001F'] на: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-бајтни знак
	( Речник нови стави: ['unicode: é'] на: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-бајтни знак
	( Речник нови стави: ['unicode: €'] на: ['key'] ) ;
	# {"key":"unicode: 日本語"} више 3-бајтних UTF-8 знакова
	( Речник нови стави: ['unicode: 日本語'] на: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-бајтни знак
	( Речник нови стави: ['unicode: 😀'] на: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} емоџи + спајач нулте ширине
	( Речник нови стави: ['unicode: 🧑‍💻'] на: ['key'] ) ;
	# {"key":"combining: é"} комбинујући акценат
	( Речник нови стави: ['combining: e\u0301'] на: ['key'] ) ;
	# {"key":"escaped unicode: é"} Unicode излазна секвенца BMP
	( Речник нови стави: ['escaped unicode: \u00e9'] на: ['key'] ) ;
	# {"key":"escaped unicode: €"} Unicode излазна секвенца BMP
	( Речник нови стави: ['escaped unicode: \u20ac'] на: ['key'] ) ;
	# {"key":"escaped unicode: 😀"} UTF-16 сурогатни пар
	( Речник нови стави: ['escaped unicode: \ud83d\ude00'] на: ['key'] ) ;
	# {"key":""} празна вредност
	( Речник нови стави: [''] на: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} посебни ASCII знакови
	( Речник нови стави: ['@ < > & = % + ? #'] на: ['key'] ) ;
	# {"key":"single quote: '"} једноструки наводник
	( Речник нови стави: ['''] на: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} више JSON излазних секвенци
	( Речник нови стави: ['multiple: \" \\ \n \r \t'] на: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} дужи ASCII текст
	( Речник нови стави: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] на: ['key'] ) ;
	# {"key":" value"} размак на почетку
	( Речник нови стави: [' вредност'] на: ['key'] ) ;
	# {"key":"value "} размак на крају
	( Речник нови стави: ['вредност '] на: ['key'] ) ;
	# {"key":" \t\n\r "} празни знакови
	( Речник нови стави: [' \t\n\r '] на: ['key'] )
	.

речници сваки: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (Речник нови стави: d key на: ['key']).
	>> b := JSON jsonify: (Речник нови стави: ['value'] на: d key).
	>> e := JSON објекат: a.
	>> f := JSON објекат: b.
	((e key = d key и: (f ? d key = ['value'])) или: (e key = ['NUL ?'])) тачно: {
		Излаз пиши: ['OK'], нови-ред.
	}, иначе: {
		Излаз пиши: ['Није могуће исправно кодирати/декодирати: '] + d + j, нови-ред.
		Програм крај.
	}.
}.
