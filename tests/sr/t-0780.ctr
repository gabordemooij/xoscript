Server init.

# JSON encoder only supports UTF-8, no surrogate pairs

>> dicts := Листа нови ;
	# {"key":"normal"} normal ASCII
	( Речник нови стави: ['normal'] на: ['key'] ) ;
	# {"key":"hello world"} space character
	( Речник нови стави: ['hello world'] на: ['key'] ) ;
	# {"key":"quote: \""} double quote
	( Речник нови стави: ['"'] на: ['key'] ) ;
	# {"key":"backslash: \\"} backslash
	( Речник нови стави: ['backslash: \\'] на: ['key'] ) ;
	# {"key":"slash: /"} slash
	( Речник нови стави: ['slash: /'] на: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( Речник нови стави: ['backspace: \b'] на: ['key'] ) ;
	# {"key":"formfeed: \f"} form-feed escape
	( Речник нови стави: ['formfeed: \f'] на: ['key'] ) ;
	# {"key":"newline: \n"} newline
	( Речник нови стави: ['newline: \n'] на: ['key'] ) ;
	( Речник нови стави: ['newline: ↵'] на: ['key'] ) ;
	( Речник нови стави: ['newline: 
	'] на: ['key'] ) ;
	# {"key":"carriage return: \r"} carriage-return
	( Речник нови стави: ['carriage return: \r'] на: ['key'] ) ;
	# {"key":"tab: \t"} tab
	( Речник нови стави: ['tab \t'] на: ['key'] ) ;
	( Речник нови стави: ['tab ⇿'] на: ['key'] ) ;
	( Речник нови стави: ['tab  '] на: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( Речник нови стави: ['NUL \u0000'] на: ['key'] ) ;
	( Речник нови стави: ['NUL \0'] на: ['key'] ) ;
	# {"key":"control: \u0001"} control character 0x01
	( Речник нови стави: ['control: \u0001'] на: ['key'] ) ;
	# {"key":"control: \u001F"} control character 0x1F
	( Речник нови стави: ['control: \u001F'] на: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-byte char
	( Речник нови стави: ['unicode: é'] на: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-byte char
	( Речник нови стави: ['unicode: €'] на: ['key'] ) ;
	# {"key":"unicode: 日本語"} multiple 3-byte UTF-8 chars
	( Речник нови стави: ['unicode: 日本語'] на: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-byte char
	( Речник нови стави: ['unicode: 😀'] на: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	( Речник нови стави: ['unicode: 🧑‍💻'] на: ['key'] ) ;
	# {"key":"combining: e\u0301"} combining accent
	( Речник нови стави: ['combining: e\u0301'] на: ['key'] ) ;
	# {"key":"escaped unicode: \u00e9"} Unicode escape BMP
	( Речник нови стави: ['escaped unicode: \u00e9'] на: ['key'] ) ;
	# {"key":"escaped unicode: \u20ac"} Unicode escape BMP
	( Речник нови стави: ['escaped unicode: \u20ac'] на: ['key'] ) ;
	# {"key":"escaped unicode: \ud83d\ude00"} UTF-16 surrogate pair
	( Речник нови стави: ['escaped unicode: \ud83d\ude00'] на: ['key'] ) ;
	# {"key":""} empty value
	( Речник нови стави: [''] на: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} special ASCII chars
	( Речник нови стави: ['@ < > & = % + ? #'] на: ['key'] ) ;
	# {"key":"single quote: '"} single quote
	( Речник нови стави: ['''] на: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} multiple JSON escapes
	( Речник нови стави: ['multiple: \" \\ \n \r \t'] на: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} longer ASCII-string
	( Речник нови стави: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] на: ['key'] ) ;
	# {"key":" value"} leading space
	( Речник нови стави: [' value'] на: ['key'] ) ;
	# {"key":"value "} trailing space
	( Речник нови стави: ['value '] на: ['key'] ) ;
	# {"key":" \t\n\r "} whitespace
	( Речник нови стави: [' \t\n\r '] на: ['key'] ).

dicts сваки: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (Речник нови стави: d key на: ['key']).
	>> b := JSON jsonify: (Речник нови стави: ['value'] на: d key).
	>> e := JSON објекат: a.
	>> f := JSON објекат: b.
	((e key = d key и: (f ? d key = ['value'])) или: (e key = ['NUL ?'])) тачно: {
		Излаз пиши: ['OK'], нови-ред.
	}, иначе: {
		Излаз пиши: ['Unable to properly encode/decode: '] + d + j, нови-ред.
		Програм крај.
	}.
}.
