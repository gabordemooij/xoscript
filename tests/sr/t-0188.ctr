

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програм управљање-меморијом: 0.

{ :i Излаз пиши: i. } × 4.
Излаз нови-ред.
{ :i Излаз пиши: (4 - i). } × 4.
Излаз нови-ред.
( 1 > 2 ) нетачно: { Излаз пиши: ['BLOCK 1'], нови-ред. }.
( 2 > 1 ) тачно:  { Излаз пиши: ['BLOCK 2'], нови-ред. }.

>> i := 0.
{ Излаз пиши: i. i додај: 1. } док: { <- ( i < 3). }.
Излаз нови-ред.

i := 3.
{ Излаз пиши: i. i := i - 1. } док: { <- ( i > 0). }.
Излаз нови-ред.


Програм очисти.

usedMemory1 := (Програм меморија ? 0).


{ :i  Излаз пиши: i. } × 4.
Излаз нови-ред.
{ :i  Излаз пиши: (4 - i). } × 4.
Излаз нови-ред.
( 1 > 2 ) нетачно: { Излаз пиши: ['BLOCK 1'], нови-ред. }.
( 2 > 1 ) тачно:  { Излаз пиши: ['BLOCK 2'], нови-ред. }.

>> i := 0.
{ Излаз пиши: i. i додај: 1. } док: { <- ( i < 3). }.
Излаз нови-ред.

i := 3.
{ Излаз пиши: i. i := i - 1. } док: { <- ( i > 0). }.
Излаз нови-ред.



Програм очисти.
usedMemory2 := (Програм меморија ? 0).


{ :i Излаз пиши: i. } × 4.
Излаз нови-ред.
{ :i Излаз пиши: (4 - i). } × 4.
Излаз нови-ред.
( 1 > 2 ) нетачно: { Излаз пиши: ['BLOCK 1'], нови-ред. }.
( 2 > 1 ) тачно:  { Излаз пиши: ['BLOCK 2'], нови-ред. }.

>> i := 0.
{ Излаз пиши: i. i додај: 1. } док: { <- ( i < 3). }.
Излаз нови-ред.

i := 3.
{ Излаз пиши: i. i := i - 1. } док: { <- ( i > 0). }.
Излаз нови-ред.

Програм очисти.
usedMemory3 := (Програм меморија ? 0).



( usedMemory1 = usedMemory2 и: usedMemory1 = usedMemory3, и: usedMemory2 = usedMemory3 ) тачно: {
	Излаз пиши: ['No memory leaks here'].
}, нетачно: {
	Излаз пиши: ['Leaking memory...'].
}.
