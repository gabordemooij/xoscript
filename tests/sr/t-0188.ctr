

>> коришћенаМеморија1 := 0.
>> коришћенаМеморија2 := 0.
>> коришћенаМеморија3 := 0.
>> коришћенаМеморија4 := 0.

Програм управљање-меморијом: 0.

{ :i Излаз пиши: i. } × 4.
Излаз нови-ред.
{ :i Излаз пиши: (4 - i). } × 4.
Излаз нови-ред.
( 1 > 2 ) нетачно: { Излаз пиши: ['БЛОК 1'], нови-ред. }.
( 2 > 1 ) тачно:  { Излаз пиши: ['БЛОК 2'], нови-ред. }.

>> i := 0.
{ Излаз пиши: i. i додај: 1. } док: { <- ( i < 3). }.
Излаз нови-ред.

i := 3.
{ Излаз пиши: i. i := i - 1. } док: { <- ( i > 0). }.
Излаз нови-ред.


Програм очисти.

коришћенаМеморија1 := (Програм меморија ? 0).


{ :i  Излаз пиши: i. } × 4.
Излаз нови-ред.
{ :i  Излаз пиши: (4 - i). } × 4.
Излаз нови-ред.
( 1 > 2 ) нетачно: { Излаз пиши: ['БЛОК 1'], нови-ред. }.
( 2 > 1 ) тачно:  { Излаз пиши: ['БЛОК 2'], нови-ред. }.

>> i := 0.
{ Излаз пиши: i. i додај: 1. } док: { <- ( i < 3). }.
Излаз нови-ред.

i := 3.
{ Излаз пиши: i. i := i - 1. } док: { <- ( i > 0). }.
Излаз нови-ред.



Програм очисти.
коришћенаМеморија2 := (Програм меморија ? 0).


{ :i Излаз пиши: i. } × 4.
Излаз нови-ред.
{ :i Излаз пиши: (4 - i). } × 4.
Излаз нови-ред.
( 1 > 2 ) нетачно: { Излаз пиши: ['БЛОК 1'], нови-ред. }.
( 2 > 1 ) тачно:  { Излаз пиши: ['БЛОК 2'], нови-ред. }.

>> i := 0.
{ Излаз пиши: i. i додај: 1. } док: { <- ( i < 3). }.
Излаз нови-ред.

i := 3.
{ Излаз пиши: i. i := i - 1. } док: { <- ( i > 0). }.
Излаз нови-ред.

Програм очисти.
коришћенаМеморија3 := (Програм меморија ? 0).



( коришћенаМеморија1 = коришћенаМеморија2 и: коришћенаМеморија1 = коришћенаМеморија3, и: коришћенаМеморија2 = коришћенаМеморија3 ) тачно: {
	Излаз пиши: ['Овде нема цурења меморије'].
}, нетачно: {
	Излаз пиши: ['Меморија цури...'].
}.
