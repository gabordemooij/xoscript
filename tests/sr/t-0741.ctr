Излаз пиши: ['Test object'], нови-ред.
>> a := Објекат нови. 

a на: ['item:'] уради: { :octhelper
	свој octhelper := octhelper. 
}.

a на: ['item'] уради: { <- свој octhelper.
}.

a item: Oct нови.

>> old-octhelper-address := a item прототип меморијска-адреса.
a save-as: ['/tmp/a.bin'].
Излаз пиши: ['========== RELOADING SNAP:'], нови-ред.

>> b := Објекат load-from: ['/tmp/a.bin'].

(b item прототип меморијска-адреса = old-octhelper-address) тачно: {
	Излаз пиши: ['Object link re-attached.'], нови-ред.
}.
