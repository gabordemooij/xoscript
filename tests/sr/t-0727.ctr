Server init.
>> f := Формат нови: ['%d'].
>> a := Blob нови: 4.
a bytes: ( Листа нови ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob нови: 4.
b bytes: ( Листа нови ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a од: 0 дужина: 3, сваки: { :i :byte
	Излаз пиши: ( f примени-цео: byte ), нови-ред.
}.
a ^ b.
a од: 0 дужина: 3, сваки: { :i :byte
	Излаз пиши: ( f примени-цео: byte ), нови-ред.
}.
a ^ b.
a од: 0 дужина: 3, сваки: { :i :byte
	Излаз пиши: ( f примени-цео: byte ), нови-ред.
}.
a ослободи.
b ослободи.

{ a ^ Објекат. } ухвати: { :e Излаз пиши: e, нови-ред. }, покрени.
