Server init.

>> db := Maria-DB нови домаћин: ['localhost'],
	корисник: ['xo'],
	лозинка: ['pass123'],
	назив-базе: ['xobase'],
	повежи-се.

>> del := db упит: ['DELETE FROM book WHERE id > 0'].
{  del изврши. db потврди. } ухвати: { :e db поништи.  }, покрени.

>> број-елемената := db упит: ['SELECT COUNT(*) AS num FROM book'].
број-елемената преузми: { :row Излаз пиши: row num, нови-ред. }.
