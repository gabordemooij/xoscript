Server init.

>> бп := Maria-DB нови домаћин: ['localhost'],
	корисник: ['xo'],
	лозинка: ['pass123'],
	назив-базе: ['xobase'],
	повежи-се.

>> брис := бп упит: ['DELETE FROM book WHERE id > 0'].
{  брис изврши. бп потврди. } ухвати: { :e бп поништи.  }, покрени.

>> број-елемената := бп упит: ['SELECT COUNT(*) AS num FROM book'].
број-елемената преузми: { :врста Излаз пиши: врста num, нови-ред. }.
