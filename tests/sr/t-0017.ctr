Број на: ['факторијел'] уради: {
	>> укупно := 1.
	{ :индекс укупно помножи-са: (себе - (индекс)). } × себе. <- укупно.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Излаз пиши: a.
>> b := 2 + 3 факторијел.
Излаз пиши: b.
>> c := 3 факторијел + 2.
Излаз пиши: c.
>> d := 2 + (3 факторијел).
Излаз пиши: d.
Излаз пиши: 2 + 3 факторијел + 1.
