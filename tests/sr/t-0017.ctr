Број на: ['factorial'] уради: {
	>> total := 1.
	{ :index total помножи-са: (себе - (index)). } × себе. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Излаз пиши: a.
>> b := 2 + 3 factorial.
Излаз пиши: b.
>> c := 3 factorial + 2.
Излаз пиши: c.
>> d := 2 + (3 factorial).
Излаз пиши: d.
Излаз пиши: 2 + 3 factorial + 1.
