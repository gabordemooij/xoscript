>> x := Објекат нови.
>> y := Објекат нови.
>> z := x.
Излаз пиши: (x = z), нови-ред.
Излаз пиши: (x = y), нови-ред.
Излаз пиши: (x ≠ y), нови-ред.
Излаз пиши: (x ≠ z), нови-ред.
>> m := Тренутак нови година: 2070, месец: 11.
>> n := m копирај.
Излаз пиши: (m = n), нови-ред.
Излаз пиши: (m ≠ n), нови-ред.
Излаз пиши: (m једнако: m), нови-ред.
Излаз пиши: (m једнако: n), нови-ред.
n месец: 12.
Излаз пиши: (m ≠ n), нови-ред.
Излаз пиши: (m = n), нови-ред.


