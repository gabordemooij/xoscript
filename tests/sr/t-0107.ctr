
Излаз пиши: ['Прекид петље за, 0-4.'], нови-ред.
{ :i
	Излаз пиши: ['iteration #'] + i, нови-ред.
	(i = 4) прекини.
} × 10.

>> x := 0.
>> xМањиОд10 := { <- ( x < 10 ). }.

Излаз пиши: ['Прекид петље док-тачно, 0-4.'], нови-ред.
{
	Излаз пиши: ['iteration #'] + x, нови-ред.
	x додај: 1.
	((x < 5) не) прекини.
} док: xМањиОд10.

Излаз пиши: ['Прекид петље док-нетачно, 5,4.'], нови-ред.
{
	Излаз пиши: ['iteration #'] + x, нови-ред.
	x одузми: 1.
	(x = 3) прекини.
} док: { <- (x > 0). }.

Излаз пиши: ['Прекид петље пута, 1-4.'], нови-ред.
{ :i
	Излаз пиши: ['iteration #'] + i, нови-ред.
	(i = 4) прекини.
} × 5.

Излаз пиши: ['Прекид блока, не исписуј ред.'], нови-ред.
{ Тачно прекини. Излаз пиши: ['не пиши ово!'], нови-ред. } покрени.

Излаз пиши: ['Прекид блока, не покрећи хватање...'], нови-ред.
{ Тачно прекини. Излаз пиши: ['не пиши ово!'], нови-ред. } ухвати: { Излаз пиши: ['Не хватај ово!']. }, покрени.

Излаз пиши: ['Тест петље сваки за низ: 0,1'], нови-ред.
(Листа ← 1 ; 2 ; 3) пресликај: { :i
	Излаз пиши: ['iteration #'] + i, нови-ред.
	(i = 1) прекини.
}.

Излаз пиши: ['Тест петље сваки за мапу: само c'], нови-ред.
>> m := Речник нови.
m стави: ['first'] на: ['a'], стави: ['second'] на: ['b'], стави: ['трећи'] на: ['c'].
m сваки: { :k :v
	Излаз пиши: ['iteration'] + v + k, нови-ред.
	Тачно прекини.
}.

