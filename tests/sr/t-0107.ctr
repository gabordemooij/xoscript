
Излаз пиши: ['Break for-loop, 0-4.'], нови-ред.
{ :i
	Излаз пиши: ['iteration #'] + i, нови-ред.
	(i = 4) прекини.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Излаз пиши: ['Break while-true loop, 0-4.'], нови-ред.
{
	Излаз пиши: ['iteration #'] + x, нови-ред.
	x додај: 1.
	((x < 5) не) прекини.
} док: xIsLessThan10.

Излаз пиши: ['Break while-false loop, 5,4.'], нови-ред.
{
	Излаз пиши: ['iteration #'] + x, нови-ред.
	x одузми: 1.
	(x = 3) прекини.
} док: { <- (x > 0). }.

Излаз пиши: ['Break times loop, 1-4.'], нови-ред.
{ :i
	Излаз пиши: ['iteration #'] + i, нови-ред.
	(i = 4) прекини.
} × 5.

Излаз пиши: ['Break block, dont print line.'], нови-ред.
{ Тачно прекини. Излаз пиши: ['dont write this!'], нови-ред. } покрени.

Излаз пиши: ['Break block, dont fire catch...'], нови-ред.
{ Тачно прекини. Излаз пиши: ['dont write this!'], нови-ред. } ухвати: { Излаз пиши: ['Dont catch this!']. }, покрени.

Излаз пиши: ['Test Array each-loop: 0,1'], нови-ред.
(Листа ← 1 ; 2 ; 3) пресликај: { :i
	Излаз пиши: ['iteration #'] + i, нови-ред.
	(i = 1) прекини.
}.

Излаз пиши: ['Test Map each-loop: c only'], нови-ред.
>> m := Речник нови.
m стави: ['first'] на: ['a'], стави: ['second'] на: ['b'], стави: ['third'] на: ['c'].
m сваки: { :k :v
	Излаз пиши: ['iteration'] + v + k, нови-ред.
	Тачно прекини.
}.

