

>> коришћенаМеморија1 := 0.
>> коришћенаМеморија2 := 0.
>> коришћенаМеморија3 := 0.
>> коришћенаМеморија4 := 0.

Програм управљање-меморијом: 0.

Број на: ['addNum:'] уради: { :x
	себе додај: x.
}.

Број на: ['subtractNum:'] уради: { :x
	себе одузми: x.
}.

Број на: ['multiplyBy:'] уради: { :x
	себе помножи-са: x.
}.

Број на: ['divideBy:'] уради: { :x
	себе подели-са: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 степен: 8).  
a := a + (2 степен: -1). 
a := a + (49 квадратни-корен).   
a addNum: ((Листа ← 0 ; 1) максимум).          
a addNum: ((Листа ← 2 ; 3) минимум).
Излаз пиши: a.

Програм очисти.

коришћенаМеморија1 := (Програм меморија ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 степен: 8).  
a := a + (2 степен: -1). 
a := a + (49 квадратни-корен).   
a addNum: ((Листа ← 0 ; 1) максимум).          
a addNum: ((Листа ← 2 ; 3) минимум).
Излаз пиши: a.

Програм очисти.
коришћенаМеморија2 := (Програм меморија ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 степен: 8).  
a := a + (2 степен: -1). 
a := a + (49 квадратни-корен).   
a addNum: ((Листа ← 0 ; 1) максимум).          
a addNum: ((Листа ← 2 ; 3) минимум).
Излаз пиши: a.

Програм очисти.
коришћенаМеморија3 := (Програм меморија ? 0).



( коришћенаМеморија1 = коришћенаМеморија2 и: коришћенаМеморија1 = коришћенаМеморија3, и: коришћенаМеморија2 = коришћенаМеморија3 ) тачно: {
	Излаз пиши: ['Овде нема цурења меморије'].
}, нетачно: {
	Излаз пиши: ['Меморија цури...'].
}.
