

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програм управљање-меморијом: 0.

Број на: ['addNum:'] уради: { :x
	себе додај: x.
}.

Број на: ['subtractNum:'] уради: { :x
	себе одузми: x.
}.

Број на: ['multiplyBy:'] уради: { :x
	себе помножи-са: x.
}.

Број на: ['divideBy:'] уради: { :x
	себе подели-са: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 степен: 8).  
a := a + (2 степен: -1). 
a := a + (49 квадратни-корен).   
a addNum: ((Листа ← 0 ; 1) максимум).          
a addNum: ((Листа ← 2 ; 3) минимум).
Излаз пиши: a.

Програм очисти.

usedMemory1 := (Програм меморија ? 0).


a := 1.
