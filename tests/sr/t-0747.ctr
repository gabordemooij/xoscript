Излаз пиши: ['Test object'], нови-ред.
>> a := Објекат нови. 

a на: ['item:'] уради: { :num
	свој num := num. 
}.

a на: ['item'] уради: { <- свој num.
}.

a item: 123.

Излаз пиши: a item, нови-ред.

>> old-num-address := a item прототип меморијска-адреса.
a save-as: ['/tmp/a.bin'].
Излаз пиши: ['========== RELOADING SNAP:'], нови-ред.

>> b := Објекат load-from: ['/tmp/a.bin'].

(b item прототип меморијска-адреса = old-num-address) тачно: {
	Излаз пиши: ['Object link re-attached.'], нови-ред.
}.

Излаз пиши: b item, нови-ред.
