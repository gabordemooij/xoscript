Излаз пиши: ['Тест објекат'], нови-ред.
>> a := Објекат нови. 

a на: ['item:'] уради: { :num
	свој num := num. 
}.

a на: ['ставка'] уради: {
	<- свој num.
}.

a item: 123.

Излаз пиши: a ставка, нови-ред.

>> стара-бр-адреса := a ставка прототип меморијска-адреса.
a save-as: ['/tmp/a.bin'].
Излаз пиши: ['========== ПОНОВНО УЧИТАВАЊЕ СНИМКА:'], нови-ред.

>> b := Објекат load-from: ['/tmp/a.bin'].

(b ставка прототип меморијска-адреса = стара-бр-адреса) тачно: {
	Излаз пиши: ['Веза објекта поново прикачена.'], нови-ред.
}.

Излаз пиши: b ставка, нови-ред.
