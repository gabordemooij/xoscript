# тест базе података
# погледајте пример server.xo за потребну конфигурацију

Server init.
Излаз пиши: ['Тест базе података'], нови-ред.

>> бп := Maria-DB нови домаћин: ['localhost'],
	корисник: ['xo'], лозинка: ['pass123'], назив-базе: ['xobase'], повежи-се.

Излаз пиши: ['Можемо ли да се повежемо? '] + бп повезано?, нови-ред.

>> параметри-претраге := бп упит: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], параметри: ( Листа нови ; ['abc'] ; 12.35 ; 6 ). # параметризовани упити

{  параметри-претраге изврши. бп потврди. } ухвати: { :e бп поништи.  }, покрени.

Излаз пиши: ['Можемо ли да убацимо? '] + ( параметри-претраге insert-id > 0 ), нови-ред.

>> Об := Објекат нови.
Об на: ['дохвати-редове'] уради: {
	свој број-елемената := 0.
	>> параметри-претраге :=
	бп упит: ['SELECT * FROM book order by id desc limit 2'], 
	преузми: { :врста 
		свој број-елемената додај: 1.
		Тачно прекини.
	}. # дохватање редова
	<- свој број-елемената копирај.
}.

Излаз пиши: ['Можемо ли да извршимо упит? '] + ( Об дохвати-редове > 0 ), нови-ред.
