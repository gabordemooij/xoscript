>> str := ['write:'].
Излаз порука: ['пиши:'] аргументи: (Листа ← ['Hello World']), нови-ред. 

Број на: ['isbetween:and:'] уради: { :a :b <- ((себе ≥ a) и: (себе ≤ b)).
}.

str := ['isbetween:and:'].
Излаз пиши: (3 порука: str аргументи: (Листа ← 2 ; 8)), нови-ред.
Излаз пиши: (3 порука: str аргументи: (Листа ← 1 ; 2)), нови-ред.


>> CoffeeMachine := Објекат нови.
CoffeeMachine на: ['makeCoffeeWithSugar:milk:'] уради: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Листа ← 4 ; 2.
Излаз пиши: ( CoffeeMachine порука: order аргументи: coffeeConfiguration ), нови-ред.
