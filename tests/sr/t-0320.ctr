


>> CoffeeMachine := Објекат нови.
CoffeeMachine на: ['order:'] уради: { :id
	>> coffee := ['Americano'].
	( id = 1 ) тачно: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) тачно: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) тачно: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Објекат нови.
SimpleCoffeeMachine на: ['order'] уради: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Излаз пиши: redCup, нови-ред.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Излаз пиши: greenCup, нови-ред.
>> yellowCup := CoffeeMachine order: 1.
Излаз пиши: yellowCup, нови-ред.
>> blueCup := CoffeeMachine order: 0.
Излаз пиши: blueCup, нови-ред.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Излаз пиши: blackCup, нови-ред.
blackCup додај-на-крај: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Излаз пиши: orangeCup, нови-ред.
