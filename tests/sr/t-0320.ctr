


>> АпаратЗаКафу := Објекат нови.
АпаратЗаКафу на: ['order:'] уради: { :id
	>> coffee := ['Americano'].
	( id = 1 ) тачно: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) тачно: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) тачно: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> ЈедноставниАпаратЗаКафу := Објекат нови.
ЈедноставниАпаратЗаКафу на: ['поруџбина'] уради: { <- ['Црна']. }.
>> црвенаШоља := АпаратЗаКафу order: 1.
Излаз пиши: црвенаШоља, нови-ред.
црвенаШоља := ['Чај']. 
>> зеленаШоља := АпаратЗаКафу order: 0.
Излаз пиши: зеленаШоља, нови-ред.
>> жутаШоља := АпаратЗаКафу order: 1.
Излаз пиши: жутаШоља, нови-ред.
>> плаваШоља := АпаратЗаКафу order: 0.
Излаз пиши: плаваШоља, нови-ред.
>> пластичнаШоља := ЈедноставниАпаратЗаКафу поруџбина.
пластичнаШоља := ['Лимунада']. 
>> црнаШоља := ЈедноставниАпаратЗаКафу поруџбина.
Излаз пиши: црнаШоља, нови-ред.
црнаШоља додај-на-крај: [' неее.... пиво. '].
>> наранџастаШоља := ЈедноставниАпаратЗаКафу поруџбина.
Излаз пиши: наранџастаШоља, нови-ред.
