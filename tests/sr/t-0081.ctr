>> мапа1 := Речник нови.
>> кључ1 := Листа нови.
>> кључ2 := Листа нови.

мапа1
	стави: ['hello'] на: кључ1,
	стави: ['world'] на: кључ2.


Излаз
	пиши: ['Map #1 contains: '] + (мапа1 на: кључ1),
	пиши: [' и '] + (мапа1 на: кључ2), нови-ред.

>> НизСаКључевима := Листа нови.
НизСаКључевима на: ['уТекст'] уради: { <- (себе број-елемената) уТекст.
}.

>> map2 := Речник нови.
кључ1 := НизСаКључевима нови.
кључ2 := НизСаКључевима нови.

кључ1 додај-на-крај: 1.

map2
	стави: ['hello'] на: кључ1,
	стави: ['world'] на: кључ2.

Излаз
	пиши: ['Map #2 contains: '] + (map2 на: кључ1),
	пиши: [' и '] + (map2 на: кључ2), нови-ред.
