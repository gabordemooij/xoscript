>> map1 := Речник нови.
>> key1 := Листа нови.
>> key2 := Листа нови.

map1
	стави: ['hello'] на: key1,
	стави: ['world'] на: key2.


Излаз
	пиши: ['Map #1 contains: '] + (map1 на: key1),
	пиши: [' and '] + (map1 на: key2), нови-ред.

>> KeyeableArray := Листа нови.
KeyeableArray на: ['toString'] уради: { <- (себе број-елемената) toString.
}.

>> map2 := Речник нови.
key1 := KeyeableArray нови.
key2 := KeyeableArray нови.

key1 додај-на-крај: 1.

map2
	стави: ['hello'] на: key1,
	стави: ['world'] на: key2.

Излаз
	пиши: ['Map #2 contains: '] + (map2 на: key1),
	пиши: [' and '] + (map2 на: key2), нови-ред.
