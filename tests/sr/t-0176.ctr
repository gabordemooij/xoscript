

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програм управљање-меморијом: 0.

>> txt := ['Word Salad'].
Излаз пиши: ['Text Length: '] + txt дужина, нови-ред.
Излаз пиши: ['Character at 2:'] + ( txt знак: 2 ), нови-ред.
Излаз пиши: (( txt пронађи: ['S'] ) - 0), нови-ред.

Програм очисти.

usedMemory1 := (Програм меморија ? 0).


txt := ['Word Salad'].
Излаз пиши: ['Text Length: '] + txt дужина, нови-ред.
Излаз пиши: ['Character at 2:'] + ( txt знак: 2 ), нови-ред.
Излаз пиши: (( txt пронађи: ['S'] ) - 0), нови-ред.

Програм очисти.
usedMemory2 := (Програм меморија ? 0).


txt := ['Word Salad'].
Излаз пиши: ['Text Length: '] + txt дужина, нови-ред.
Излаз пиши: ['Character at 2:'] + ( txt знак: 2 ), нови-ред.
Излаз пиши: (( txt пронађи: ['S'] ) - 0), нови-ред.

Програм очисти.
usedMemory3 := (Програм меморија ? 0).



( usedMemory1 = usedMemory2 и: usedMemory1 = usedMemory3, и: usedMemory2 = usedMemory3 ) тачно: {
	Излаз пиши: ['No memory leaks here'].
}, нетачно: {
	Излаз пиши: ['Leaking memory...'].
}.
