

Текст на: ['израчунај'] уради: {
	>> код := Датотека нови: ['/tmp/eval.ctr'].
	код пиши: (себе текст + ['.']).
	Програм користи: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Листа ← (['Наводници '] + Q + [' су зли?']) ; 1.
>> x := q текст.
Излаз пиши: x, нови-ред.
>> y := Ништа.
(['y := '] + x ) израчунај.
Излаз пиши: y ? 0, нови-ред.

q := Речник стави: ['\[''] на: ['\['quote\']'].
x := q текст.
Излаз пиши: x, нови-ред.
y := Ништа.
(['y := '] + x ) израчунај.

>> q := (Речник нови) стави:['\[''] на:['\['quote\[''].
Излаз пиши: y ? ['\['quote\']'], нови-ред.
