Server init.

# write a test file
>> f := Датотека нови: ['/tmp/test.gif'].
f пиши: ['GIF87a01234567810'].

# serve the file
Server проследи: ['test.gif'] префикс: ['/tmp/'].

Излаз нови-ред.

Излаз пиши: ['Outside container (security):'], нови-ред.
{ Server проследи: ['../passwd'] префикс: ['/tmp/']. }
ухвати: { :e Излаз пиши: e, нови-ред. },
покрени.

Излаз пиши: ['Invalid prefix:'], нови-ред.
{ Server проследи: ['test.gif'] префикс: ['z:\\']. }
ухвати: { :e Излаз пиши: e, нови-ред. },
покрени.

Излаз пиши: ['Non-existant file:'], нови-ред.
{ Server проследи: ['xxx.xxx'] префикс: ['/tmp/']. }
ухвати: { :e Излаз пиши: e, нови-ред. },
покрени.
