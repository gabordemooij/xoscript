Излаз пиши: ['Test object'], нови-ред.
>> cmd := Наредба нови.
Излаз пиши: cmd ls /tmp, нови-ред.
>> old-cmd-address := cmd прототип меморијска-адреса.
cmd save-as: ['/tmp/a.bin'].
Излаз пиши: ['========== RELOADING SNAP:'], нови-ред.
>> b := Објекат load-from: ['/tmp/a.bin'].
(b прототип меморијска-адреса = old-cmd-address) тачно: {
	Излаз пиши: ['Object link re-attached.'], нови-ред.
}.
Излаз пиши: b ls, нови-ред.


