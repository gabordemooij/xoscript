Излаз пиши: ['Test object'], нови-ред.
>> a := Објекат нови. 

a на: ['item:'] уради: { :moment
	свој moment := moment. 
}.

a на: ['item'] уради: { <- свој moment.
}.

>> today := Тренутак нови зона: ['CEST'], година: 2026, месец: 7.
a item: today.
Излаз пиши: a item, нови-ред.
a save-as: ['/tmp/a.bin'].
Излаз пиши: ['========== RELOADING SNAP:'], нови-ред.
>> b := Објекат load-from: ['/tmp/a.bin'].
Излаз пиши: b item, нови-ред.
