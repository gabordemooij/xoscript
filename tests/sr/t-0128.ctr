
Листа на: ['sum'] уради: {
	>> total := 0.
	себе сваки: { :index :element
		total додај: element.
	}. <- total.
}.

>> a := Листа ← 9 ; 8 ; 7.
Излаз пиши: (a sum), нови-ред. 
>> a := Листа ← 1 ; 9.
Излаз пиши: (a sum), нови-ред. 
>> a := Листа ← ['o'] ; 2.
Излаз пиши: (a sum), нови-ред. 
Излаз пиши: (Листа нови sum), нови-ред. 
