
Листа на: ['збир'] уради: {
	>> укупно := 0.
	себе сваки: { :индекс :елемент
		укупно додај: елемент.
	}. <- укупно.
}.

>> a := Листа ← 9 ; 8 ; 7.
Излаз пиши: (a збир), нови-ред. 
>> a := Листа ← 1 ; 9.
Излаз пиши: (a збир), нови-ред. 
>> a := Листа ← ['o'] ; 2.
Излаз пиши: (a збир), нови-ред. 
Излаз пиши: (Листа нови збир), нови-ред. 
