Излаз пиши: ['Test object'], нови-ред.
>> a := Објекат нови. 

a на: ['item:'] уради: { :логички
	свој логички := логички. 
}.

a на: ['item'] уради: { <- свој логички.
}.

a item: Логички.

Излаз пиши: a item, нови-ред.

>> old-bool-address := a item прототип меморијска-адреса.
a save-as: ['/tmp/a.bin'].
Излаз пиши: ['========== RELOADING SNAP:'], нови-ред.

>> b := Објекат load-from: ['/tmp/a.bin'].

(b item прототип меморијска-адреса = old-bool-address) тачно: {
	Излаз пиши: ['Object link re-attached.'], нови-ред.
}.

Излаз пиши: b item, нови-ред.
