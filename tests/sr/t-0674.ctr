# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> путања := ['/tmp/dat.csv'].
>> csv := Датотека нови: путања.
csv пиши: s.

# accepts CRLF LF CR, varying row length
csv раздвајач: [';'] наводник: ['"'] редови: { :line
	Програм очисти.
	Излаз пиши: line, нови-ред.
	Програм очисти.
}.

# unequal lines
s додај-на-крај: ['\njustone'].
csv пиши: s.
{
	csv раздвајач: [';'] наводник: ['"'] редови: { :line
		Излаз пиши: line, нови-ред.
	}.
} ухвати: { :e 
	Излаз пиши: e, нови-ред.
}, покрени.

# invalid format
s := ['"he"llo";world'].
csv пиши: s.
{
	csv раздвајач: [';'] наводник: ['"'] редови: { :line
		Излаз пиши: line, нови-ред.
	}.
} ухвати: { :e 
	Излаз пиши: e, нови-ред.
}, покрени.
