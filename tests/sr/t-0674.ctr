# срећан ток
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> путања := ['/tmp/dat.csv'].
>> csv := Датотека нови: путања.
csv пиши: s.

# прихвата CRLF LF CR, различите дужине редова
csv раздвајач: [';'] наводник: ['"'] редови: { :line
	Програм очисти.
	Излаз пиши: line, нови-ред.
	Програм очисти.
}.

# неједнаки редови
s додај-на-крај: ['\njustone'].
csv пиши: s.
{
	csv раздвајач: [';'] наводник: ['"'] редови: { :line
		Излаз пиши: line, нови-ред.
	}.
} ухвати: { :e 
	Излаз пиши: e, нови-ред.
}, покрени.

# неисправан формат
s := ['"he"llo";world'].
csv пиши: s.
{
	csv раздвајач: [';'] наводник: ['"'] редови: { :line
		Излаз пиши: line, нови-ред.
	}.
} ухвати: { :e 
	Излаз пиши: e, нови-ред.
}, покрени.
