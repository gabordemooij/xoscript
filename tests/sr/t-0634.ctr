# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Програм shell-escape: ['abc'].
Излаз пиши: c, нови-ред.
Излаз пиши: ( Програм систем: ['echo '] + c ), нови-ред.

c := Програм shell-escape: ['a'b'c'].
Излаз пиши: c, нови-ред.
Излаз пиши: ( Програм систем: ['echo '] + c ), нови-ред.

c := Програм shell-escape: ['a\'c'].
Излаз пиши: c, нови-ред.
Излаз пиши: ( Програм систем: ['echo '] + c ), нови-ред.