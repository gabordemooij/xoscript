>> За-Урадити := Објекат нови.

За-Урадити на: ['нови'] уради: {
	свој list := Листа нови.
}.

За-Урадити на: ['nieuw'] уради: {
	свој list := Листа нови.
}.

За-Урадити на: ['+'] уради: { :задатак
	свој list додај-на-крај: задатак.
}.

За-Урадити на: ['number of tasks?'] уради: { <-  свој list број-елемената.
}.

>> задаци := 
	За-Урадити нови 
	+ ['скухај вечеру'] 
	+ ['поспреми собу'].
	
Излаз пиши: ['You have $ tasks to do'] $ задаци number of tasks?.
