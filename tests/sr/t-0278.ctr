>> To-Do := Објекат нови.

To-Do на: ['нови'] уради: {
	свој list := Листа нови.
}.

To-Do на: ['nieuw'] уради: {
	свој list := Листа нови.
}.

To-Do на: ['+'] уради: { :task
	свој list додај-на-крај: task.
}.

To-Do на: ['number of tasks?'] уради: { <-  свој list број-елемената.
}.

>> todos := 
	To-Do нови 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Излаз пиши: ['You have $ tasks to do'] $ todos number of tasks?.
