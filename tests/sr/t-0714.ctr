>> a := Објекат нови. 
a на: ['поздрави'] уради: { Излаз пиши: ['добродошли!'], нови-ред. }.
a на: ['поздрави2'] уради: { Излаз пиши: ['добродошли2!'], нови-ред. }.
a save-as: ['/tmp/a.bin'].

Излаз пиши: ['========== ПОНОВНО УЧИТАВАЊЕ СНИМКА:'], нови-ред.
>> b := Објекат load-from: ['/tmp/a.bin'].
b поздрави2.