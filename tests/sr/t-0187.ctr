Број на: ['factorial'] уради: {
	>> total := 1.
	{ :index total помножи-са: (себе - index). } × себе. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програм управљање-меморијом: 0.

{
2 exponent factorial.
Излаз пиши: (11 модуло: 3), нови-ред.
Излаз пиши: (3.4 заокружи), нови-ред.
Излаз пиши: (7.1 заокружи-нагоре), нови-ред.
Излаз пиши: (7.9 заокружи-надоле), нови-ред.
}
покрени.

Програм очисти.

usedMemory1 := (Програм меморија ? 0).

{
2 exponent factorial.
Излаз пиши: (11 модуло: 3), нови-ред.
Излаз пиши: (3.4 заокружи), нови-ред.
Излаз пиши: (7.1 заокружи-нагоре), нови-ред.
Излаз пиши: (7.9 заокружи-надоле), нови-ред.
}
покрени.

Програм очисти.
usedMemory2 := (Програм меморија ? 0).


{
2 exponent factorial.
Излаз пиши: (11 модуло: 3), нови-ред.
Излаз пиши: (3.4 заокружи), нови-ред.
Излаз пиши: (7.1 заокружи-нагоре), нови-ред.
Излаз пиши: (7.9 заокружи-надоле), нови-ред.
} покрени.

Програм очисти.
usedMemory3 := (Програм меморија ? 0).



( usedMemory1 = usedMemory2 и: usedMemory1 = usedMemory3, и: usedMemory2 = usedMemory3 ) тачно: {
	Излаз пиши: ['No memory leaks here'].
}, нетачно: {
	Излаз пиши: ['Leaking memory...'].
}.
