Број на: ['факторијел'] уради: {
	>> укупно := 1.
	{ :индекс укупно помножи-са: (себе - индекс). } × себе. <- укупно.
}.

>> коришћенаМеморија1 := 0.
>> коришћенаМеморија2 := 0.
>> коришћенаМеморија3 := 0.
>> коришћенаМеморија4 := 0.

Програм управљање-меморијом: 0.

{
2 експонент факторијел.
Излаз пиши: (11 модуло: 3), нови-ред.
Излаз пиши: (3.4 заокружи), нови-ред.
Излаз пиши: (7.1 заокружи-нагоре), нови-ред.
Излаз пиши: (7.9 заокружи-надоле), нови-ред.
}
покрени.

Програм очисти.

коришћенаМеморија1 := (Програм меморија ? 0).

{
