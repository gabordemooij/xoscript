Текст на: ['израчунај'] уради: {
	>> код := Датотека нови: ['/tmp/eval.ctr'].
	код пиши: (себе текст + ['.']).
	Програм користи: ['/tmp/eval.ctr'].
}.

>> a := Листа ← 1 ; 2 ; 3.
>> b := (a текст).

Излаз пиши: b, нови-ред. 
(['b := '] + b) израчунај.

Излаз пиши: b ? 2, нови-ред. 

Излаз пиши: (( Листа ← 1 ; 2 ; 3 )), нови-ред. 

Излаз пиши: ((Речник нови) стави: 1 на: 2), нови-ред. 

>> x := ( (Листа ← 1 ; ( Листа ← 9 ) ; Тачно ) ) текст.
Излаз пиши: x, нови-ред. 
(['x := '] + x) израчунај.

Излаз пиши: x ? 1 ? 0, нови-ред. 

>> y := (Речник нови) стави: (Листа ← 1) на: (Листа ← 2).
Излаз пиши: y, нови-ред. 

(['y := '] + y) текст израчунај.

Излаз пиши: (y на: (Листа ← 2) текст ), нови-ред.

Излаз пиши: (Листа нови), нови-ред. 
Излаз пиши: (Речник нови), нови-ред. 
