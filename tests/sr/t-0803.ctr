Server init.

>> conn1 := Maria-DB нови домаћин: ['localhost'],
	корисник: ['xo'],
	лозинка: ['pass123'],
	назив-базе: ['xobase'],
	повежи-се.

>> conn2 := Maria-DB нови домаћин: ['localhost'],
	корисник: ['xo'],
	лозинка: ['pass123'],
	назив-базе: ['xobase'],
	повежи-се.
#...
>> del := conn1 упит: ['DELETE FROM book WHERE id > 0'].
{  del изврши. conn1 потврди. } ухвати: { :e conn1 поништи.  }, покрени.

>> insert := conn1 упит: ['INSERT INTO book (id) VALUES(null)'].
insert изврши.

>> број-елемената := conn1 упит: ['SELECT COUNT(*) AS num FROM book'].
број-елемената преузми: { :row Излаз пиши: row num, нови-ред. }.

# does not show up
# insert not committed on connection 1
>> број-елемената := conn2 упит: ['SELECT COUNT(*) AS num FROM book'].
број-елемената преузми: { :row Излаз пиши: row num, нови-ред. }.
