Server init.

>> веза1 := Maria-DB нови домаћин: ['localhost'],
	корисник: ['xo'],
	лозинка: ['pass123'],
	назив-базе: ['xobase'],
	повежи-се.

>> веза2 := Maria-DB нови домаћин: ['localhost'],
	корисник: ['xo'],
	лозинка: ['pass123'],
	назив-базе: ['xobase'],
	повежи-се.
#...
>> брис := веза1 упит: ['DELETE FROM book WHERE id > 0'].
{  брис изврши. веза1 потврди. } ухвати: { :e веза1 поништи.  }, покрени.

>> уметање := веза1 упит: ['INSERT INTO book (id) VALUES(null)'].
уметање изврши.

>> број-елемената := веза1 упит: ['SELECT COUNT(*) AS num FROM book'].
број-елемената преузми: { :врста Излаз пиши: врста num, нови-ред. }.

# не појављује се
# уметање није потврђено на вези 1
>> број-елемената := веза2 упит: ['SELECT COUNT(*) AS num FROM book'].
број-елемената преузми: { :врста Излаз пиши: врста num, нови-ред. }.
