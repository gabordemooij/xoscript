Програм управљање-меморијом: 4.

>> упс := 0.
{
	{ 3 ÷ 0. } ухвати: {
		упс додај: 1.
	}, покрени.
} × 1000.

{
	Излаз пиши: ['ћао свима!'].
	овај-задатак грешка: ['oops'].
	Излаз пиши: ['ћао свима!'].
	{ Излаз пиши: ['не исписуј ово']. } покрени.
} ухвати: { :e 
	Излаз пиши: ['ухваћен!']. 
	Излаз пиши: e.
}, покрени.
