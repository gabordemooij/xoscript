Програм управљање-меморијом: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } ухвати: {
		oops додај: 1.
	}, покрени.
} × 1000.

{
	Излаз пиши: ['hi there!'].
	овај-задатак грешка: ['oops'].
	Излаз пиши: ['hi there!'].
	{ Излаз пиши: ['dont print this']. } покрени.
} ухвати: { :e 
	Излаз пиши: ['got ya!']. 
	Излаз пиши: e.
}, покрени.
