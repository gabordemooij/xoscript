>> Поздрављач := Објекат нови.
Поздрављач на: ['направи'] уради: {
	>> пз := Објекат нови.
	пз на: ['setName:'] уради: { :некоИме
		свој назив := некоИме.
	}.
	пз на: ['поздрави'] уради: {
		Излаз пиши: свој назив.
	}. <- пз.
}.
>> a := Поздрављач направи.
>> b := Поздрављач направи.
a setName: ['ЈЕДАН'].
b setName: ['ДВА'].
a поздрави.
b поздрави.
>> c := a нови.
c setName: ['ТРИ'].
c поздрави.
>> d := a нови.
d setName: ['ЧЕТИРИ'].
d поздрави.
c поздрави.
