>> Greeter := Објекат нови.
Greeter на: ['make'] уради: {
	>> gr := Објекат нови.
	gr на: ['setName:'] уради: { :aname
		свој назив := aname.
	}.
	gr на: ['greet'] уради: {
		Излаз пиши: свој назив.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a нови.
c setName: ['THREE'].
c greet.
>> d := a нови.
d setName: ['FOUR'].
d greet.
c greet.
