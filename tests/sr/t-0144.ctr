



>> CoffeeGrounds := Објекат нови.
CoffeeGrounds на: ['extract'] уради: { <- ['coffee']. }.

>> CoffeeMachine := Објекат нови.
CoffeeMachine на: ['init'] уради: {
	свој coffeegrounds := CoffeeGrounds нови.
}.
CoffeeMachine на: ['нови'] уради: { <- CoffeeMachine `new init.
}.

CoffeeMachine на: ['makeTea'] уради: { <- (свој tealeaves extract). }.
CoffeeMachine на: ['makeCoffee'] уради: { <- (свој coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine нови.

Излаз пиши:
	coffeeDream 
	makeCoffee.

Излаз пиши:
	coffeeDream 
	makeTea.
