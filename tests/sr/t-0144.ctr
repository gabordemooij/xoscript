



>> МлевенаКафа := Објекат нови.
МлевенаКафа на: ['извуци'] уради: { <- ['coffee']. }.

>> АпаратЗаКафу := Објекат нови.
АпаратЗаКафу на: ['init'] уради: {
	свој млевенакафа := МлевенаКафа нови.
}.
АпаратЗаКафу на: ['нови'] уради: { <- АпаратЗаКафу `new init.
}.

АпаратЗаКафу на: ['скувајЧај'] уради: { <- (свој листићичаја извуци). }.
АпаратЗаКафу на: ['скувајКафу'] уради: { <- (свој млевенакафа извуци). }.

>> кафаИзСнова := АпаратЗаКафу нови.

Излаз пиши:
	кафаИзСнова 
	скувајКафу.

Излаз пиши:
	кафаИзСнова 
	скувајЧај.
