Server init.
Излаз пиши: ['Database time test'], нови-ред.

>> db := Maria-DB нови домаћин: ['localhost'],
	корисник: ['xo'], 
	лозинка: ['pass123'],
	назив-базе: ['xobase'],
	повежи-се.

>> параметри-претраге :=
db упит: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
преузми: { :row
	Излаз пиши: row timetest, нови-ред.
}.
