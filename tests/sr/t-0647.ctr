Server init.
Излаз пиши: ['Тест времена у бази података'], нови-ред.

>> бп := Maria-DB нови домаћин: ['localhost'],
	корисник: ['xo'], 
	лозинка: ['pass123'],
	назив-базе: ['xobase'],
	повежи-се.

>> параметри-претраге :=
бп упит: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
преузми: { :врста
	Излаз пиши: врста timetest, нови-ред.
}.
