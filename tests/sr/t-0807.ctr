# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB нови домаћин: ['localhost'],
	корисник: ['xo'],
	лозинка: ['pass123'],
	назив-базе: ['xobase'],
	повежи-се.

>> параметри-претраге := db упит: ['SELECT %% FROM'].
{ параметри-претраге изврши. } ухвати: { :e
	Излаз пиши: ( e садржи: ['%%'] ), нови-ред.
}, покрени.
