# поруке о грешкама базе података не смеју се третирати као форматни низови
Server init.

>> бп := Maria-DB нови домаћин: ['localhost'],
	корисник: ['xo'],
	лозинка: ['pass123'],
	назив-базе: ['xobase'],
	повежи-се.

>> параметри-претраге := бп упит: ['SELECT %% FROM'].
{ параметри-претраге изврши. } ухвати: { :e
	Излаз пиши: ( e садржи: ['%%'] ), нови-ред.
}, покрени.
