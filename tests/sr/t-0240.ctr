# test qualifiers

>> $ := Објекат нови.

$ на: ['одговори:'] уради: { :x
	
	>> operation := x знак: 0.
	>> valuta := x знак: 1.
	>> money := x помак: 2.
	
	>> amount := 0.

	( operation = ['+'] ) тачно: {
		( valuta = ['£'] ) тачно: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Излаз пиши: x, нови-ред.


>> Fruit := Објекат нови.

Fruit на: ['нови'] уради: {
	>> f := себе нови.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit на: ['apples:'] уради: { :a свој apples := a. }.
Fruit на: ['oranges:'] уради: { :p свој oranges := p. }.
Fruit на: ['apples'] уради: { <- свој apples. }.
Fruit на: ['oranges'] уради: { <- свој oranges. }.

Fruit на: ['+'] уради: { :f
	
	>> n := Fruit нови.
	f додај: 1.
	
	n apples: (f apples + свој apples).
	n oranges:  (f oranges  + свој oranges). <- n.
}.

Fruit на: ['текст'] уради: { <- ( свој apples текст + [' apples and '] + свој oranges + [' oranges'] ).
}.

Број на: ['apples'] уради: { <- ((Fruit нови) apples: себе).
}.

Број на: ['apple'] уради: { <- ((Fruit нови) apples: себе).
}.

Број на: ['oranges'] уради: { <- ((Fruit нови) oranges: себе).
}.




Излаз пиши: (1 apple + 3 oranges + 4 apples), нови-ред.


Текст на: ['twice'] уради: { <- ((себе текст) + (себе текст)).
}.



Излаз пиши: ['❤❤❤'] twice.



