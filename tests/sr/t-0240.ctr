# тест одредница

>> $ := Објекат нови.

$ на: ['одговори:'] уради: { :x
	
	>> операција := x знак: 0.
	>> валута := x знак: 1.
	>> новац := x помак: 2.
	
	>> износ := 0.

	( операција = ['+'] ) тачно: {
		( валута = ['£'] ) тачно: { износ := 1.28 × новац. }.
	}. <- износ.
}.



>> x := $ +£20.

Излаз пиши: x, нови-ред.


>> Воће := Објекат нови.

Воће на: ['нови'] уради: {
	>> f := себе нови.
	f apples: 0.
	f oranges: 0. <- f.
}.

Воће на: ['apples:'] уради: { :a свој јабуке := a. }.
Воће на: ['oranges:'] уради: { :p свој поморанџе := p. }.
Воће на: ['јабуке'] уради: { <- свој јабуке. }.
Воће на: ['поморанџе'] уради: { <- свој поморанџе. }.

Воће на: ['+'] уради: { :f
	
	>> n := Воће нови.
	f додај: 1.
	
	n apples: (f јабуке + свој јабуке).
	n oranges:  (f поморанџе  + свој поморанџе). <- n.
}.

Воће на: ['текст'] уради: { <- ( свој јабуке текст + [' јабука и '] + свој поморанџе + [' поморанџи'] ).
}.

Број на: ['јабуке'] уради: { <- ((Воће нови) apples: себе).
}.

Број на: ['apple'] уради: { <- ((Воће нови) apples: себе).
}.

Број на: ['поморанџе'] уради: { <- ((Воће нови) oranges: себе).
}.




Излаз пиши: (1 apple + 3 поморанџе + 4 јабуке), нови-ред.


Текст на: ['двапут'] уради: { <- ((себе текст) + (себе текст)).
}.



Излаз пиши: ['❤❤❤'] двапут.



