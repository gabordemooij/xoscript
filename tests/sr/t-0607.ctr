>> Комбинација := Листа нови.

Комбинација на: ['додај-на-крај:'] уради: { :ел
	себе 
	пронађи: ел, Ништа? тачно: { себе додај-на-крај: ел. }.
}.

>> нијансе := Комбинација нови.
нијансе
	додај-на-крај: ['црвена'],
	додај-на-крај: ['зелена'],
	додај-на-крај: ['плава'],
	додај-на-крај: ['црвена'].

Излаз пиши: нијансе, нови-ред.
