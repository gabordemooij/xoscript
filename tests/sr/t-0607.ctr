>> Combination := Листа нови.

Combination на: ['додај-на-крај:'] уради: { :el
	себе 
	пронађи: el, Ништа? тачно: { себе додај-на-крај: el. }.
}.

>> colours := Combination нови.
colours
	додај-на-крај: ['red'],
	додај-на-крај: ['green'],
	додај-на-крај: ['blue'],
	додај-на-крај: ['red'].

Излаз пиши: colours, нови-ред.
