Server init.
Излаз пиши: ['Database date test'], нови-ред.

>> db := Maria-DB нови домаћин: ['localhost'],
	корисник: ['xo'], 
	лозинка: ['pass123'],
	назив-базе: ['xobase'],
	повежи-се.

>> параметри-претраге :=
db упит: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
преузми: { :row
	Излаз пиши: row datetest, нови-ред.
}.
