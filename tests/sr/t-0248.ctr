

Текст на: ['израчунај'] уради: {
	>> код := Датотека нови: ['/tmp/eval.ctr'].
	код пиши: себе текст + ['.'].
	Програм користи: ['/tmp/eval.ctr'].
}.

>> a := (Листа ← (
	(Речник нови)
		стави: ['domain'] на: ['mywebsite.com'],
		стави: (Листа ←
			((Речник нови)
				стави: ['home'] на: ['title'],
				стави: ['<html></html>'] на: ['body'],
				стави: ['2017-01-01'] на: ['created']
			) ;
			((Речник нови)
				стави: ['aboutus(c)'] на: ['title'],
				стави: ['<credits>Author Inc.</credits>'] на: ['body']
			)
		) на: ['pages']
	)
) текст.

Излаз пиши: a тип, нови-ред.
Излаз пиши: a, нови-ред.

>> b := Ништа.
(['b := '] + a) израчунај.
Излаз пиши: b ? 0 ? ['pages'] ? 1 ? ['body'], нови-ред.

>> c := b ? 0.
>> d := c текст.
Излаз пиши: d тип, нови-ред.

>> e := Ништа.
(['e := '] + d) израчунај.
Излаз пиши: e ? ['pages'] ? 0, нови-ред.
