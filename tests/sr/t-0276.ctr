>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Објекат нови.
⚄ на: ['drawFrom:length:'] уради: { :pool :број-елемената
	
	>> result := [''].
	
	{
		>> index := Број random % (pool дужина).
		result додај-на-крај: ( pool знак: (index + 1) ).
		
	} × број-елемената. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? дужина.
Излаз пиши: (['x↵'] x random дужина).
Излаз пиши: (['y↵'] y ?? дужина).

