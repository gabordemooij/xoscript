>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Објекат нови.
⚄ на: ['извуциИз:дужине:'] уради: { :скуп :број-елемената
	
	>> резултат := [''].
	
	{
		>> индекс := Број случајан % (скуп дужина).
		резултат додај-на-крај: ( скуп знак: (индекс + 1) ).
		
	} × број-елемената. <- резултат.
}.

>> случајан := ⚄ извуциИз: ?? дужине: ?? дужина.
Излаз пиши: (['x↵'] x случајан дужина).
Излаз пиши: (['y↵'] y ?? дужина).

