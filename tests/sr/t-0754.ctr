Излаз пиши: ['Test object'], нови-ред.
>> a := Објекат нови. 

a на: ['item:'] уради: { :out
	свој out := out. 
}.

a на: ['item'] уради: { <- свој out.
}.

a на: ['greet'] уради: {
	Излаз пиши: ['hi from original out!'], нови-ред.
}.

a item: Излаз.

Излаз пиши: a item, нови-ред.

>> old-out-address := a item прототип меморијска-адреса.
a save-as: ['/tmp/a.bin'].
Излаз пиши: ['========== RELOADING SNAP:'], нови-ред.

>> b := Објекат load-from: ['/tmp/a.bin'].

(b item прототип меморијска-адреса = old-out-address) тачно: {
	Излаз пиши: ['Object link re-attached.'], нови-ред.
}.

b item пиши: ['hello from loaded out!'], нови-ред.
b greet.
