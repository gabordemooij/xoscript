Излаз пиши: ['Тест објекат'], нови-ред.
>> a := Објекат нови. 

a на: ['item:'] уради: { :изл
	свој изл := изл. 
}.

a на: ['ставка'] уради: {
	<- свој изл.
}.

a на: ['поздрави'] уради: {
	Излаз пиши: ['ћао од оригиналног излаза!'], нови-ред.
}.

a item: Излаз.

Излаз пиши: a ставка, нови-ред.

>> стара-изл-адреса := a ставка прототип меморијска-адреса.
a save-as: ['/tmp/a.bin'].
Излаз пиши: ['========== ПОНОВНО УЧИТАВАЊЕ СНИМКА:'], нови-ред.

>> b := Објекат load-from: ['/tmp/a.bin'].

(b ставка прототип меморијска-адреса = стара-изл-адреса) тачно: {
	Излаз пиши: ['Веза објекта поново прикачена.'], нови-ред.
}.

b ставка пиши: ['здраво од учитаног излаза!'], нови-ред.
b поздрави.
