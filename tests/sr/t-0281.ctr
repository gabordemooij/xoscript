>> q := Листа ← 1 ; 2 ; 3.
{ q ? ['1']. } ухвати: { Излаз пиши: ['caught!'], нови-ред. }, покрени.
{ q ? Тачно. } ухвати: { Излаз пиши: ['caught!'], нови-ред. }, покрени.
{ q ? Нетачно. } ухвати: { Излаз пиши: ['caught!'], нови-ред. }, покрени.
{ q ? Ништа. } ухвати: { Излаз пиши: ['caught!'], нови-ред. }, покрени.
{ q ? (Листа нови). } ухвати: { Излаз пиши: ['caught!'], нови-ред. }, покрени.
{ q ? (Објекат нови). } ухвати: { Излаз пиши: ['caught!'], нови-ред. }, покрени.
{ q ? ({ ['Empty']. }). } ухвати: { Излаз пиши: ['caught!'], нови-ред. }, покрени.
Излаз пиши: ['caught them all'], нови-ред.
