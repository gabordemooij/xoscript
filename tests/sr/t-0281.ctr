>> q := Листа ← 1 ; 2 ; 3.
{ q ? ['1']. } ухвати: { Излаз пиши: ['ухваћено!'], нови-ред. }, покрени.
{ q ? Тачно. } ухвати: { Излаз пиши: ['ухваћено!'], нови-ред. }, покрени.
{ q ? Нетачно. } ухвати: { Излаз пиши: ['ухваћено!'], нови-ред. }, покрени.
{ q ? Ништа. } ухвати: { Излаз пиши: ['ухваћено!'], нови-ред. }, покрени.
{ q ? (Листа нови). } ухвати: { Излаз пиши: ['ухваћено!'], нови-ред. }, покрени.
{ q ? (Објекат нови). } ухвати: { Излаз пиши: ['ухваћено!'], нови-ред. }, покрени.
{ q ? ({ ['Празно']. }). } ухвати: { Излаз пиши: ['ухваћено!'], нови-ред. }, покрени.
Излаз пиши: ['све ухваћено'], нови-ред.
