


>> вино := Објекат нови.


вино на: ['уТекст'] уради: { <- ['merlot'].
}.

вино на: ['naarTekst'] уради: { <- ['merlot'].
}.


вино на: ['='] уради: { :other wine <- ( себе уТекст = other wine ).
}.

вино на: ['=='] уради: { :other wine <- ( себе уТекст = other wine ).
}.



вино
	случај: ['cabernet'] уради: { Излаз пиши: ['то је Cabernet!']. },
	случај: ['syrah']    уради: { Излаз пиши: ['то је Syrah!'].    },
	случај: ['merlot']   уради: { Излаз пиши: ['то је Merlot!'].   },
	случај: ['malbec']   уради: { Излаз пиши: ['то је Malbec!'].   }.

Излаз нови-ред.
