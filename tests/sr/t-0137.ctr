>> коришћенаМеморија5 := (Програм меморија ? 0).




(коришћенаМеморија1 = коришћенаМеморија2 = коришћенаМеморија3 = коришћенаМеморија4 = коришћенаМеморија5) тачно: {
	Излаз пиши: ['Употреба меморије остаје стабилна.'], нови-ред.
}, иначе: {
	Излаз пиши: ['Коришћена меморија није стабилна.'], нови-ред.
	Излаз пиши: коришћенаМеморија1, нови-ред.
	Излаз пиши: коришћенаМеморија2, нови-ред.
	Излаз пиши: коришћенаМеморија3, нови-ред.
	Излаз пиши: коришћенаМеморија4, нови-ред.
	Излаз пиши: коришћенаМеморија5, нови-ред.
}.
