# catch-all test (practical)
>> HTML := Текст нови.
HTML на: ['encode:'] уради: { :tekst
	себе додај-на-крај: (tekst
	замени: ['&'] са: ['&amp;'], 
	замени: ['<'] са: ['&lt;'],
	замени: ['>'] са: ['&gt;'],
	замени: ['"'] са: ['&quot;']).
}.
>> blog := HTML нови.
blog додај-на-крај: ['<h1>'],
     encode: ['Koffie & Thee'],
     додај-на-крај: ['</h1>'].
Излаз пиши: blog, нови-ред.


>> Roman := Број нови.
Roman на: ['stringy'] уради: {
	>> a := [''].
	{ a додај-на-крај: ['I']. } × себе. <- a.
}.

>> x := Roman нови.
x додај: 3.
Излаз пиши: x stringy, нови-ред.

>> Quantum := Логички нови.
Quantum на: ['true?'] уради: { <- ['maybe True']. }.
Излаз пиши: (Quantum нови true?), нови-ред.

>> Nihil := Ништа нови.
Nihil на: ['текст'] уради: { <- ['Nihil']. }.
Излаз пиши: (Nihil нови), нови-ред.
