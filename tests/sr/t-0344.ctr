# тест хватања свих порука (практичан)
>> HTML := Текст нови.
HTML на: ['encode:'] уради: { :улазниТекст
	себе додај-на-крај: (улазниТекст
	замени: ['&'] са: ['&amp;'], 
	замени: ['<'] са: ['&lt;'],
	замени: ['>'] са: ['&gt;'],
	замени: ['"'] са: ['&quot;']).
}.
>> блог := HTML нови.
блог додај-на-крај: ['<h1>'],
     encode: ['Koffie & Thee'],
     додај-на-крај: ['</h1>'].
Излаз пиши: блог, нови-ред.


>> Римски := Број нови.
Римски на: ['текстуално'] уради: {
	>> a := [''].
	{ a додај-на-крај: ['I']. } × себе. <- a.
}.

>> x := Римски нови.
x додај: 3.
Излаз пиши: x текстуално, нови-ред.

>> Квант := Логички нови.
Квант на: ['true?'] уради: { <- ['можда Тачно']. }.
Излаз пиши: (Квант нови true?), нови-ред.

>> Nihil := Ништа нови.
Nihil на: ['текст'] уради: { <- ['Nihil']. }.
Излаз пиши: (Nihil нови), нови-ред.
