# compliance test

# use international numbers

Излаз пиши: ['1000 -> '].
Излаз пиши: 1000, нови-ред. #1000

Излаз пиши: ['1.5 -> '].
Излаз пиши: 1.5, нови-ред.  #1.5

Излаз пиши: ['1001.5 -> '].
Излаз пиши: 1.5 + 1000, нови-ред. #1001.5

# use 0-indexed arrays
>> x := Листа нови ; 1 ; 2 ; 3.
>> y := Листа нови ; ['a'] ; ['b'] ; ['c'].

Излаз пиши: ['1 -> '].
Излаз пиши: x ? 0, нови-ред. #1

Излаз пиши: ['1 -> '].
Излаз пиши: (x на: 0), нови-ред. #1

Излаз пиши: ['1 -> '].
Излаз пиши: x први, нови-ред. #1

Излаз пиши: ['3 -> '].
Излаз пиши: x последњи, нови-ред. #3

Излаз пиши: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Излаз пиши: (x према: y), нови-ред.

Излаз пиши: ['1 -> '].
Излаз пиши: (x од: 0 дужина: 1) први, нови-ред. #1

Излаз пиши: ['0 -> '].
Излаз пиши: (x пронађи: 1), нови-ред. #0

x стави: 9 на: 0.

Излаз пиши: ['9 -> '].
Излаз пиши: (x на: 0), нови-ред. #9

x додај-на-почетак: 8.
Излаз пиши: ['8 -> '].
Излаз пиши: (x на: 0), нови-ред. #9


x додај-на-крај: 10.
Излаз пиши: ['10 -> '].
Излаз пиши: (x на: 4), нови-ред. #10








