

>> Матрјошка := Објекат нови.
Матрјошка на: ['double:'] уради: { :тајна
	свој тајна := тајна × 2.
}.
Матрјошка на: ['нови:'] уради: { :тајна
	>> решење := Ништа.
	>> t := (тајна > 255).
	Излаз пиши: (тајна + [' | '] + t), нови-ред.
	t тачно: {
		решење := тајна.
	}, иначе: {
		решење := Матрјошка рекурзивно нови: (себе double: тајна).
	}. <- решење.
}.

>> x := Матрјошка нови: 2.
