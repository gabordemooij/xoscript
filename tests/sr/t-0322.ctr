

>> Matryoshka := Објекат нови.
Matryoshka на: ['double:'] уради: { :secret
	свој secret := secret × 2.
}.
Matryoshka на: ['нови:'] уради: { :secret
	>> answer := Ништа.
	>> t := (secret > 255).
	Излаз пиши: (secret + [' | '] + t), нови-ред.
	t тачно: {
		answer := secret.
	}, иначе: {
		answer := Matryoshka рекурзивно нови: (себе double: secret).
	}. <- answer.
}.

>> x := Matryoshka нови: 2.
