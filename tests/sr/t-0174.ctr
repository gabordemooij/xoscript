


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програм управљање-меморијом: 0.
>> palette := Ништа.
>> colors := Ништа.

{
palette := Речник нови.
palette 
	стави: ['#F00'] на: ['red'],
	стави: ['#0F0'] на: ['green'],
	стави: ['#00F'] на: ['blue'].
Излаз пиши: ['number of RGB codes in palette: '] + ( palette број-елемената ), нови-ред.
Излаз пиши: ['RGB code of green is: '] + ( palette ? ['green'] ), нови-ред.
colors := [''].
( palette сваки: { :назив :код
		colors := colors + ( назив + [':'] + код ).
} ).
Излаз пиши: ['All colors in palette: '] + colors, нови-ред.
} покрени.
Програм очисти.
usedMemory1 := (Програм меморија ? 0).

