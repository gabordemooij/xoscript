


>> коришћенаМеморија1 := 0.
>> коришћенаМеморија2 := 0.
>> коришћенаМеморија3 := 0.
>> коришћенаМеморија4 := 0.

Програм управљање-меморијом: 0.
>> палета := Ништа.
>> боје := Ништа.

{
палета := Речник нови.
палета 
	стави: ['#F00'] на: ['црвена'],
	стави: ['#0F0'] на: ['зелена'],
	стави: ['#00F'] на: ['плава'].
Излаз пиши: ['број RGB кодова у палети: '] + ( палета број-елемената ), нови-ред.
Излаз пиши: ['RGB код зелене је: '] + ( палета ? ['зелена'] ), нови-ред.
боје := [''].
( палета сваки: { :назив :код
		боје := боје + ( назив + [':'] + код ).
} ).
Излаз пиши: ['Све боје у палети: '] + боје, нови-ред.
} покрени.
Програм очисти.
коришћенаМеморија1 := (Програм меморија ? 0).

{
палета := Речник нови.
палета 
	стави: ['#F00'] на: ['црвена'],
	стави: ['#0F0'] на: ['зелена'],
	стави: ['#00F'] на: ['плава'].
Излаз пиши: ['број RGB кодова у палети: '] + ( палета број-елемената ), нови-ред.
Излаз пиши: ['RGB код зелене је: '] + ( палета ? ['зелена'] ), нови-ред.
боје := [''].
( палета сваки: { :назив :код
		боје := боје + ( назив + [':'] + код ).
} ).
Излаз пиши: ['Све боје у палети: '] + боје, нови-ред.
} покрени.
Програм очисти.
коришћенаМеморија2 := (Програм меморија ? 0).

{
палета := Речник нови.
палета 
	стави: ['#F00'] на: ['црвена'],
	стави: ['#0F0'] на: ['зелена'],
	стави: ['#00F'] на: ['плава'].
Излаз пиши: ['број RGB кодова у палети: '] + ( палета број-елемената ), нови-ред.
Излаз пиши: ['RGB код зелене је: '] + ( палета ? ['зелена'] ), нови-ред.
боје := [''].
( палета сваки: { :назив :код
		боје := боје + ( назив + [':'] + код ).
} ).
Излаз пиши: ['Све боје у палети: '] + боје, нови-ред.
} покрени.
Програм очисти.
коришћенаМеморија3 := (Програм меморија ? 0).



( коришћенаМеморија1 = коришћенаМеморија2 и: коришћенаМеморија1 = коришћенаМеморија3, и: коришћенаМеморија2 = коришћенаМеморија3 ) тачно: {
	Излаз пиши: ['Овде нема цурења меморије'].
}, нетачно: {
	Излаз пиши: ['Меморија цури...'].
}.
