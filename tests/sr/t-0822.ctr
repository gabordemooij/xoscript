# мање параметара од чувара места мора дати грешку, а не читање после повезаних вредности
Server init.

>> бп := Maria-DB нови домаћин: ['localhost'],
	корисник: ['xo'],
	лозинка: ['pass123'],
	назив-базе: ['xobase'],
	повежи-се.

>> параметри-претраге := бп упит: ['SELECT ? AS a, ? AS b, ? AS c'].
параметри-претраге параметри: (Листа нови ; ['1']).
{ параметри-претраге преузми: { :врста Излаз пиши: врста, нови-ред. }. } ухвати: { :e Излаз пиши: e, нови-ред. }, покрени.

>> параметри-претраге := бп упит: ['SELECT ? AS a'].
{ параметри-претраге преузми: { :врста Излаз пиши: врста, нови-ред. }. } ухвати: { :e Излаз пиши: e, нови-ред. }, покрени.

# прави број и даље ради, вишак параметара се занемарује као и раније
>> параметри-претраге := бп упит: ['SELECT ? AS a, ? AS b'].
параметри-претраге параметри: (Листа нови ; ['1'] ; ['2']).
параметри-претраге преузми: { :врста Излаз пиши: (врста на: ['a']), пиши: (врста на: ['b']), нови-ред. }.
параметри-претраге параметри: (Листа нови ; ['1'] ; ['2'] ; ['3']).
параметри-претраге преузми: { :врста Излаз пиши: (врста на: ['a']), пиши: (врста на: ['b']), нови-ред. }.
