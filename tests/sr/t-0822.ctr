# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := Maria-DB нови домаћин: ['localhost'],
	корисник: ['xo'],
	лозинка: ['pass123'],
	назив-базе: ['xobase'],
	повежи-се.

>> параметри-претраге := db упит: ['SELECT ? AS a, ? AS b, ? AS c'].
параметри-претраге параметри: (Листа нови ; ['1']).
{ параметри-претраге преузми: { :row Излаз пиши: row, нови-ред. }. } ухвати: { :e Излаз пиши: e, нови-ред. }, покрени.

>> параметри-претраге := db упит: ['SELECT ? AS a'].
{ параметри-претраге преузми: { :row Излаз пиши: row, нови-ред. }. } ухвати: { :e Излаз пиши: e, нови-ред. }, покрени.

# the right number still works, more parameters are ignored as before
>> параметри-претраге := db упит: ['SELECT ? AS a, ? AS b'].
параметри-претраге параметри: (Листа нови ; ['1'] ; ['2']).
параметри-претраге преузми: { :row Излаз пиши: (row на: ['a']), пиши: (row на: ['b']), нови-ред. }.
параметри-претраге параметри: (Листа нови ; ['1'] ; ['2'] ; ['3']).
параметри-претраге преузми: { :row Излаз пиши: (row на: ['a']), пиши: (row на: ['b']), нови-ред. }.
