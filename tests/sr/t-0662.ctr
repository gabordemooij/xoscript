>> t := Ништа.

# можете одредити временску зону за
# овакво парсирање:
Тренутак зона: ['CET'].
t := Тренутак из: ['1981-02-03 04:05:06'].
Излаз пиши: t, нови-ред.

# сада користимо временску зону CEST:
Тренутак зона: ['CEST'].
t := Тренутак из: ['1981-02-03 04:05:06'].
Излаз пиши: t, нови-ред.

# грешка ако се текст не може парсирати
{ Тренутак из: ['1900']. } ухвати: { Ништа. }, покрени.
