>> t := Ништа.

# you can control the time zone for
# parsing like this:
Тренутак зона: ['CET'].
t := Тренутак из: ['1981-02-03 04:05:06'].
Излаз пиши: t, нови-ред.

# now using CEST time zone:
Тренутак зона: ['CEST'].
t := Тренутак из: ['1981-02-03 04:05:06'].
Излаз пиши: t, нови-ред.

# error if string cannot be parsed
{ Тренутак из: ['1900']. } ухвати: { Ништа. }, покрени.
