Server init.

>> БП := Maria-DB нови домаћин: ['localhost'],
	корисник: ['xo'],
	лозинка: ['pass123'],
	назив-базе: ['xobase'],
	повежи-се.

{
	БП упит:
	['DROP TABLE movies'],
	изврши.
} ухвати: { Ништа. }, покрени.

БП упит:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
изврши.

БП упит: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
параметри: ( Листа нови ; ['Ноћ вештица'] ),
изврши.

БП упит: ['SELECT * FROM movies'],
преузми: { :филм
