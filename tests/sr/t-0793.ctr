Server init.

>> DB := Maria-DB нови домаћин: ['localhost'],
	корисник: ['xo'],
	лозинка: ['pass123'],
	назив-базе: ['xobase'],
	повежи-се.

{
	DB упит:
	['DROP TABLE movies'],
	изврши.
} ухвати: { Ништа. }, покрени.

DB упит:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
изврши.

DB упит: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
параметри: ( Листа нови ; ['Halloween'] ),
изврши.

DB упит: ['SELECT * FROM movies'],
преузми: { :movie
	Излаз пиши: movie title, нови-ред.
}.

