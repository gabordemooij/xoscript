Server init.

>> DB := Maria-DB нови домаћин: ['localhost'],
	корисник: ['xo'],
	лозинка: ['pass123'],
	назив-базе: ['xobase'],
	повежи-се.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> параметри-претраге := Maria-Упит нови: SQL.

# set database
параметри-претраге база-података: DB.

параметри-претраге преузми: { :row
	Излаз пиши: row world, нови-ред.
}.
