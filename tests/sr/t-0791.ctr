Server init.

>> БП := Maria-DB нови домаћин: ['localhost'],
	корисник: ['xo'],
	лозинка: ['pass123'],
	назив-базе: ['xobase'],
	повежи-се.
	
>> SQL := ['SELECT "hello" AS "world" '].

# ручно прављење упита
>> параметри-претраге := Maria-Упит нови: SQL.

# постављање базе података
параметри-претраге база-података: БП.

параметри-претраге преузми: { :врста
	Излаз пиши: врста world, нови-ред.
}.
