
>> dictionary := (
	Речник нови
		стави: ['b'] на: ['a'],
		стави: ['a'] на: ['b'],
		стави: ['z'] на: ['x'],
		стави: ['hello'] на: ['hallo'],
		стави: ['human'] на: ['human']
).

>> comparisons := Листа нови.
dictionary сваки: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a упореди: b)
	).
}.

comparisons сортирај: { :a :b <- ( a упореди: b ). }.
Излаз пиши: ( comparisons споји: ['↵'] ), нови-ред.
comparisons споји: ['↵'].
