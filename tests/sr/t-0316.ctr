>> Деда := Објекат нови.
Деда на: ['поздрави'] уради: {
	Излаз пиши: ['Ave!'], нови-ред.
}.
>> Отац := Деда нови.
Отац на: ['поздрави'] уради: {
	Излаз пиши: ['Hello'], нови-ред.
	себе поздрави.
}.
>> Син := Отац нови.
Син на: ['поздрави'] уради: {
	Излаз пиши: ['Ћао'], нови-ред.
	себе поздрави.
}.

Син поздрави.

>> КружниТок := Објекат нови.
КружниТок на: ['circle:'] уради: { :x
	Излаз пиши: x, нови-ред.
	(x < 3) тачно: { себе рекурзивно circle: x + 1. }.
}.

КружниТок circle: 1.

>> x := 1.
>> увећај := { (x ≤ 3) тачно: { Излаз пиши: x, нови-ред. x додај: 1.  увећај покрени. }. }.
увећај покрени.