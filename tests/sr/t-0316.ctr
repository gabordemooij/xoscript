>> Grandfather := Објекат нови.
Grandfather на: ['greet'] уради: {
	Излаз пиши: ['Ave!'], нови-ред.
}.
>> Father := Grandfather нови.
Father на: ['greet'] уради: {
	Излаз пиши: ['Hello'], нови-ред.
	себе greet.
}.
>> Son := Father нови.
Son на: ['greet'] уради: {
	Излаз пиши: ['Hi'], нови-ред.
	себе greet.
}.

Son greet.

>> Roundabout := Објекат нови.
Roundabout на: ['circle:'] уради: { :x
	Излаз пиши: x, нови-ред.
	(x < 3) тачно: { себе рекурзивно circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) тачно: { Излаз пиши: x, нови-ред. x додај: 1.  increment покрени. }. }.
increment покрени.