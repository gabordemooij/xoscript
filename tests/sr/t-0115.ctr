{
	овај-задатак грешка: ['Dont fail.'].
	unknown doSomething.
} ухвати: {
	Излаз пиши: ['Caught!'].
}, покрени.

{
	овај-задатак грешка: ['Dont fail.'].
	свој unknown doSomething.
} ухвати: {
	Излаз пиши: ['Caught!'].
}, покрени.

{
	овај-задатак грешка: ['Dont fail.'].
	unknown := 122.
} ухвати: {
	Излаз пиши: ['Caught!'].
}, покрени.


{
	овај-задатак грешка: ['Dont fail.'].
	Тачно прекини.
	Излаз пиши: ['FAIL'].
} ухвати: {
	Излаз пиши: ['Caught!'].
}, покрени.

{
	{
		овај-задатак грешка: ['Dont fail.'].
		Тачно прекини.
		Излаз пиши: ['FAIL'].
	} ухвати: { :x
		(x = ['Dont fail.']) тачно: { овај-задатак грешка: ['Nested Caught!']. }.
	}, покрени.
} ухвати: { :e
	Излаз пиши: e.
}, покрени.
