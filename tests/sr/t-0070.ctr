>> бројеви := ['1,2,3'] подели: [','].
Излаз пиши: ['Добио сам: '] + бројеви број-елемената + [' бројева.'],нови-ред.
{ :i Излаз пиши: ['number #'] + i + [':'] + (бројеви позиција: i), нови-ред.} × 3.
>> пића := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
пића := пића подели: [' Or '].
Излаз пиши: ['Служимо'], нови-ред.
{ :i Излаз пиши: ['->'] + (пића позиција: i), нови-ред. } × (пића број-елемената).
Излаз пиши: (пића споји: [',']), нови-ред.
Излаз пиши: (бројеви споји: ['||']).
