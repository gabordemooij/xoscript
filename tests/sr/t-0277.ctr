

>> Мачка := Објекат нови.

Мачка на: ['нови'] уради: {
	свој звук := ['meow!'].
}.

Мачка на: ['nieuw'] уради: {
	свој звук := ['meow!'].
}.

Мачка на: ['направиЗвук'] уради: { <- свој звук.
}.

Мачка на: ['поздрави'] уради: { <- себе направиЗвук.
}.

>> мачка := Мачка нови.
Излаз пиши: мачка поздрави.
