
Server init.
>> rq := HTTP-Захтев нови.
Излаз пиши: ['HTTP-GET d[]=']  + ( rq get-листа: ['d[]'] ), нови-ред. # GET
Излаз пиши: ['HTTP-GET f[]=']  + ( rq get-листа: ['f[]'] ), нови-ред. # GET
Излаз пиши: ['HTTP-POST e[]='] + ( rq post-листа: ['e[]'] ), нови-ред. # GET
Излаз пиши: ['HTTP-POST c=']   + ( rq post: ['c'] ), нови-ред. # GET
Излаз пиши: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), нови-ред. # GET
