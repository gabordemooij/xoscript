
Server init.
>> зхт := HTTP-Захтев нови.
Излаз пиши: ['HTTP-GET d[]=']  + ( зхт get-листа: ['d[]'] ), нови-ред. # GET
Излаз пиши: ['HTTP-GET f[]=']  + ( зхт get-листа: ['f[]'] ), нови-ред. # GET
Излаз пиши: ['HTTP-POST e[]='] + ( зхт post-листа: ['e[]'] ), нови-ред. # GET
Излаз пиши: ['HTTP-POST c=']   + ( зхт post: ['c'] ), нови-ред. # GET
Излаз пиши: ['HTTP-POST xx=']  + ( зхт post: ['xx'] ), нови-ред. # GET
