Програм управљање-меморијом: 4.

>> Doubler := Објекат нови.
>> Multiplier := Објекат нови.
Doubler на: ['double:and:'] уради: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier на: ['multiply:and:'] уради: { :x :y <- (x × y).
}.

Излаз пиши: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), нови-ред.
