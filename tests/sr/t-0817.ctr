# вредност која се завршава првим делом отварајућег наводника мора преживети серијализацију
>> вредности := Листа нови
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

вредности сваки: { :i :value
	>> d := Речник нови.
	d стави: value на: ['k'].
	d стави: ['second'] на: ['j'].
	>> r := d код објекат.
	Излаз пиши: r број-елемената, нови-ред.
	Излаз пиши: ( (r на: ['k']) = value ), нови-ред.
}.
