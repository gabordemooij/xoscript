Излаз пиши: ['Test object'], нови-ред.
>> a := Објекат нови. 
a на: ['item:'] уради: { :lst
	свој lst := lst. 
}.
a на: ['item'] уради: { <- свој lst.
}.
a item: (
	Листа нови ; 1 ; (
		Листа нови ; ['a'] ; (
			Листа нови ; ( Тренутак нови: 1 )
		) ; ( Int64 из-текста: ['321'] )
	)
).
Излаз пиши: a item, нови-ред.
>> old-lst-address := a item прототип меморијска-адреса.
a save-as: ['/tmp/a.bin'].
Излаз пиши: ['========== RELOADING SNAP:'], нови-ред.
>> b := Објекат load-from: ['/tmp/a.bin'].
(b item прототип меморијска-адреса = old-lst-address) тачно: {
	Излаз пиши: ['Object link re-attached.'], нови-ред.
}.
Излаз пиши: ( b item ), нови-ред.
