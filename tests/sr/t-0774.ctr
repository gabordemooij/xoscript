Излаз пиши: ['Тест објекат'], нови-ред.
>> a := Објекат нови. 
a на: ['item:'] уради: { :лст
	свој лст := лст. 
}.
a на: ['ставка'] уради: {
	<- свој лст.
}.
a item: (
	Листа нови ; 1 ; (
		Листа нови ; ['a'] ; (
			Листа нови ; ( Тренутак нови: 1 )
		) ; ( Int64 из-текста: ['321'] )
	)
).
Излаз пиши: a ставка, нови-ред.
>> стара-лст-адреса := a ставка прототип меморијска-адреса.
a save-as: ['/tmp/a.bin'].
Излаз пиши: ['========== ПОНОВНО УЧИТАВАЊЕ СНИМКА:'], нови-ред.
>> b := Објекат load-from: ['/tmp/a.bin'].
(b ставка прототип меморијска-адреса = стара-лст-адреса) тачно: {
	Излаз пиши: ['Веза објекта поново прикачена.'], нови-ред.
}.
Излаз пиши: ( b ставка ), нови-ред.
