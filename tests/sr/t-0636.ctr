# тест парсирања url-а

Server init.
>> url := URL из: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Излаз пиши: ['scheme = '] + url шема, нови-ред.
Излаз пиши: ['host = '] + url домаћин, нови-ред.
Излаз пиши: ['port = '] + url порт, нови-ред.
Излаз пиши: ['path = '] + url путања, нови-ред.
Излаз пиши: ['query = '] + url параметри-претраге, нови-ред.
Излаз пиши: ['fragment = '] + url фрагмент, нови-ред.
