>> a := Листа ← Објекат ; Тачно ; Нетачно ; Логички ; 1 ; Број ; ['Тек'] ; Текст ; { ['Празно']. }.
Излаз пиши: (a број-елемената), нови-ред.
{ :i
	Излаз пиши: 
	['a '] + 
	((a ? i) тип) +
	([' \‘this\’ '] this: (a ? i))  +
	[' је '] +
	(((a ? i) Ништа?) или: [''] или: ['НИЈЕ']) + 
	[' Ништа.'],
	нови-ред.
} × (a број-елемената).
Излаз пиши: ['али.. Ништа је.. '] + ((Ништа Ништа?) или: ['сигурно НИШТА!'] или: ['није НИШТА??']), нови-ред.