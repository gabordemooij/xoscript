>> a := Листа ← Објекат ; Тачно ; Нетачно ; Логички ; 1 ; Број ; ['Str'] ; Текст ; { ['Empty']. }.
Излаз пиши: (a број-елемената), нови-ред.
{ :i
	Излаз пиши: 
	['a '] + 
	((a ? i) тип) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Ништа?) или: [''] или: ['NOT']) + 
	[' Nil.'],
	нови-ред.
} × (a број-елемената).
Излаз пиши: ['but.. Nil is.. '] + ((Ништа Ништа?) или: ['certainly NIL!'] или: ['not NIL??']), нови-ред.