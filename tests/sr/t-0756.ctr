Излаз пиши: ['Test object'], нови-ред.
>> greeter := Објекат нови.
greeter на: ['name:'] уради: { :назив
	свој xname := назив. 
}.
greeter на: ['greet'] уради: {
	Излаз пиши: ['Hello '] + свој xname, нови-ред.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Излаз пиши: ['========== RELOADING SNAP:'], нови-ред.
>> b := Објекат load-from: ['/tmp/a.bin'].
>> c := Објекат load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
