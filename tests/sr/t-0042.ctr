>> items := Речник нови.
items стави: ['црна'] на: ['coffee'], стави: ['earl grey'] на: ['чај'].
Излаз пиши: (items на: ['coffee']), пиши: (items на: ['чај']).
Излаз пиши: ['има'] + items број-елемената + [' ставки у низу.'].
items стави: ['капућино'] на: ['coffee'].
Излаз пиши: ['Сада је моја кафа.. '] + (items на: ['coffee']).
items стави: ['aaa'] на: ['1'].
items стави: ['bbb'] на: ['2'].
Излаз пиши: (items на: ['a']).
