>> items := Речник нови.
items стави: ['black'] на: ['coffee'], стави: ['earl grey'] на: ['tea'].
Излаз пиши: (items на: ['coffee']), пиши: (items на: ['tea']).
Излаз пиши: ['there are'] + items број-елемената + [' items in the array.'].
items стави: ['capuccino'] на: ['coffee'].
Излаз пиши: ['Now my coffee is.. '] + (items на: ['coffee']).
items стави: ['aaa'] на: ['1'].
items стави: ['bbb'] на: ['2'].
Излаз пиши: (items на: ['a']).
