
>> Поздрављач := Објекат нови.
Поздрављач на: ['нови'] уради: {
	свој назив := ['?'].
}.
Поздрављач на: ['name:'] уради: { :назив
	свој назив := назив.
}.
Поздрављач на: ['поздрави'] уради: {
	Излаз пиши: (['hello[you]'] [you]: свој назив).
}.
>> пријатељ := Поздрављач нови.
пријатељ name: ['1'].
пријатељ поздрави.
