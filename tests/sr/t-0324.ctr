>> Animal := Објекат нови.
>> Factory := Објекат нови.

Animal на: ['нови'] уради: {
	>> animal := себе нови.
	animal sound: ['?']. <- animal.
}.

Animal на: ['sound:'] уради: { :s
	свој sound := s.
}.

Animal на: ['sound'] уради: { <- свој sound.
}.

>> Dog := Објекат нови.
>> Cat := Објекат нови.

Dog на: ['нови'] уради: { <- Animal нови sound: ['woof!'].
}.

Cat на: ['нови'] уради: { <- Animal нови sound: ['meow!'].
}.

Излаз пиши: Dog нови sound, нови-ред.
Излаз пиши: Cat нови sound, нови-ред.

Factory на: ['mix:and:'] уради: { :beast1 :beast2 <- Animal нови sound: (
		( beast1 sound од: 0 дужина: 2 ) +
		( beast2 sound од: 2 дужина: 5 )
	).
}.

Излаз пиши: (Factory mix: Dog нови and: Cat нови) sound, нови-ред.
