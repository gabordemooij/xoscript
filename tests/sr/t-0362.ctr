Излаз пиши: (['a:b:'] - [':']), нови-ред.
Излаз пиши: (['Lorem Ipsum'] - ['Ipsum']), нови-ред.
Излаз пиши: (['a.................b.......................c...........'] - ['.']), нови-ред.
Излаз пиши: (['a--b--c---d'] - ['--']), нови-ред.
Излаз пиши: (['-'] - ['--']), нови-ред.
Излаз пиши: ([''] - ['--']), нови-ред.
Излаз пиши: (['--'] - ['']), нови-ред.
Излаз пиши: ([''] - ['']), нови-ред.
>> x := ['xx'].
>> y := x - ['x'].
Излаз пиши: x, нови-ред.
Излаз пиши: y, нови-ред.
>> x := ['a,bb,c'].
>> y := x замени: [''] са: ['xx'].
Излаз пиши: ((x једнако: y) или: ['OK'] или: ['ГРЕШКА! Случајно је враћена копија!']), нови-ред.