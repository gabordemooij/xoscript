>> z := Објекат нови.
z на: ['value:'] уради: { :v
	свој value := v. <- себе.
}.
z на: ['value'] уради: { <- свој value. }.
(z setValue: 1) value: 2.
Излаз пиши: z value.
>> x := z.
Излаз пиши: x value.
z := Ништа.
Излаз пиши: z value.
Излаз пиши: x value.
Излаз пиши: ['hello'].
Излаз пиши: 3 + 2.
Излаз пиши: (3 > 2).
