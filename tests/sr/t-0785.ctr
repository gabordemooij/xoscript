Излаз пиши: ['Тест објекат'], нови-ред.
>> a := Објекат нови. 

a на: ['item:'] уради: { :трен
	свој трен := трен. 
}.

a на: ['ставка'] уради: {
	<- свој трен.
}.

>> данас := Листа нови ; ( Тренутак нови зона: ['CEST'], година: 2026, месец: 7 ).
a item: данас.
Излаз пиши: a ставка ? 0, нови-ред.
a save-as: ['/tmp/a.bin'].
