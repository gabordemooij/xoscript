Текст на: ['html'] уради: { <- (
		себе
		замени: ['&'] са: ['&amp;'],
		замени: ['<'] са: ['&lt;'],
		замени: ['>'] са: ['&gt;'],
		замени: ['"'] са: ['&quot;']
	).
}.

>> list := Листа нови.

['Verbatim Syntax'] знакови сваки: { :број :слово
	list ; ((['<li>#Number:Letter</li>']) Number: (број), Letter: слово).
}.

Излаз list.





>> предложак := ['
<html>
<body>
<p>Hello this is a test!</p>
<p>The string \‘Verbatim Syntax\’ has: 15 code points...</p>
<ul>
[list]
</ul>
</body> 
</html>
'] [list]: (list споји: ['↵']).

Излаз пиши: предложак.

