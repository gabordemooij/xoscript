Излаз пиши: ['1,2,3,4,5,6,7,8,9,A,'], нови-ред.
>> Опсег := Објекат нови.
Опсег на: ['initialize:'] уради: { :x свој особина := x. }.
Опсег на: ['одобри'] уради: { Излаз пиши: [',']. }.
Опсег на: ['тест'] уради: {
	Излаз пиши: свој особина.
	себе одобри.
	( 1 = 1 ) тачно: { Излаз пиши: свој особина. себе одобри. }.
	( 1 = 0 ) нетачно: { Излаз пиши: свој особина. себе одобри. }.
	>> y := 2. { Излаз пиши: свој особина. себе одобри. } док: { y одузми: 1. <- (y > 0). }.
	{ Излаз пиши: свој особина. себе одобри. } × 1.
	(Листа ← 1) сваки: {  Излаз пиши: свој особина. себе одобри. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo имплементирати сопствено сортирање, овај тест не пролази због различитог броја итерација по платформи
	(Речник нови one: ['item']) сваки: { Излаз пиши: свој особина. себе одобри. }.
	{ 1 ÷ 0. } ухвати: { Излаз пиши: свој особина. себе одобри. }, покрени.
	Излаз нови-ред.
}.
>> опсег1 := Опсег нови.
опсег1 initialize: ['X'].
опсег1 тест.
>> функција := { 
	свој особина := ['Y'].
	Излаз пиши: свој особина.
	себе одобри.
	( 1 = 1 ) тачно: { Излаз пиши: свој особина. себе одобри. }.
	( 1 = 0 ) нетачно: { Излаз пиши: свој особина. себе одобри. }.
	>> y := 2. { Излаз пиши: свој особина. себе одобри. } док: { y одузми: 1. <- (y > 0). }.
	{ Излаз пиши: свој особина. себе одобри. } × 1.
	(Листа ← 1) сваки: {  Излаз пиши: свој особина. себе одобри. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Речник нови one: ['item']) сваки: { Излаз пиши: свој особина. себе одобри. }.
	{ 1 ÷ 0. } ухвати: { Излаз пиши: свој особина. себе одобри. }, покрени.
	Излаз нови-ред.
}.
функција на: ['одобри'] уради: { Излаз пиши: [',']. }.
функција примени: 1 и: 2.
