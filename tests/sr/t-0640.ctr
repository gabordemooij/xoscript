
Server init.
Излаз пиши: ['Тест базе података'], нови-ред.

>> бп := Maria-DB нови домаћин: ['localhost'],
	корисник: ['xo'], 
	лозинка: ['pass123'],
	назив-базе: ['xobase'],
	повежи-се.

>> параметри-претраге :=
бп упит: ['SELECT UNHEX('CAFE') AS blobby'],
преузми: { :врста
	Излаз пиши: ( врста blobby од: 0 дужина: 2 ), нови-ред.
	врста blobby ослободи.
}.
