#Linux

(Датотека нови: ['/tmp/testje']) постоји нетачно: {
	Програм систем: ['mkdir /tmp/testje'].	
}.

(Датотека нови: ['/tmp/testje/file1']) постоји нетачно: {
	Програм систем: ['touch /tmp/testje/file1'].	
}.

(Датотека нови: ['/tmp/testje/folder1']) постоји нетачно: {
	Програм систем: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Датотека листа: ['/tmp/testje'].

>> q := Листа нови.

l сваки: { :k :v v сваки: { :x :y q додај-на-крај: y. }. }.

>> s := q текст.

(s садржи: ['file1']) тачно:   { Излаз пиши: ['OK'], нови-ред. }.
(s садржи: ['file2']) тачно:   { Излаз пиши: ['XX'], нови-ред. }.
(s садржи: ['folder1']) тачно: { Излаз пиши: ['OK'], нови-ред. }.
