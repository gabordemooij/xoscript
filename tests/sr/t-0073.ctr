
>> плава := ['плава'].
>> боје := Листа ← ['yellow']; ['зелена']; плава ; ['црвена']; ['наранџаста']; ['љубичаста']; ['роза'].
>> палета := боје од: 2 дужина: 3.
Излаз пиши: (палета споји: [',']), нови-ред. 
плава := ['цијан'].
Излаз пиши: плава, нови-ред. 
боје стави: ['црна'] на: 2. 
Излаз пиши: (боје споји: [',']), нови-ред. 
Излаз пиши: (палета споји: [',']), нови-ред. 
