>> Slurp := Објекат нови.
Slurp на: ['нови'] уради: {
	свој str := [''].
}.
Slurp научити: ['nieuw'] значи: ['нови'].
Slurp на: ['одговори:'] уради: { :blah
		(свој str ≠ ['']) тачно: {
			свој str додај-на-крај: [' '].
		}.
		свој str додај-на-крај: blah.
}.
Slurp на: ['одговори:и:'] уради: { :blah :blahah
		(свој str ≠ ['']) тачно: {
			свој str додај-на-крај: [' '].
		}.
		(blah дужина > 1) тачно: {
			свој str додај-на-крај: (blah од: 0 дужина: (blah дужина - 1)).
		}, иначе: {
			свој str додај-на-крај: blah.
		}.
		свој str додај-на-крај: [' '].
		свој str додај-на-крај: blahah.
}.
Slurp на: ['obtain'] уради: {
	>> buffer := свој str.
	свој str := ['']. <- buffer.
}.


>> параметри-претраге := Slurp нови
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

Излаз пиши: параметри-претраге obtain, нови-ред.
