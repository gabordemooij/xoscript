

>> g := Server нови.
>> v := Сеф нови.
>> ok := 0.

>> secrets := Листа нови ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> passwords := secrets копирај.
passwords сваки: { :i :p
	secrets сваки: { :n :s
		{
			>> encrypted := v шифруј: s кључ: p.
			>> decrypted := v дешифруј: encrypted кључ: p.
			(decrypted = s) тачно: {
				ok додај: 1.
			}, иначе: {
				Излаз пиши: ['failed encrypting/decrypting: '], нови-ред.
				Излаз пиши: s, нови-ред.
				Излаз пиши: ['encrypted: '] + encrypted, нови-ред.
				Излаз пиши: ['decrypted: '] + encrypted, нови-ред.
				Програм крај.
			}.
		} ухвати: { :err
			(s = [''] или: p = ['']) тачно: {
				ok додај: 1.
			}, иначе: {
				Излаз пиши: err, нови-ред.
				Програм крај.
			}.
		}, покрени.
	}.
}.

Излаз пиши: ( ok + [' vault encryptions tested.'] ), нови-ред.