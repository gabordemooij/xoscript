

>> g  := Server нови.
>> v  := Сеф нови.
>> ок := 0.

>> тајне := Листа нови ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> лозинке := тајне копирај.
лозинке сваки: { :i :p
	тајне сваки: { :n :s
		{
			>> шифровано := v шифруј: s кључ: p.
			>> дешифровано := v дешифруј: шифровано кључ: p.
			(дешифровано = s) тачно: {
				ок додај: 1.
			}, иначе: {
				Излаз пиши: ['шифровање/дешифровање није успело: '], нови-ред.
				Излаз пиши: s, нови-ред.
				Излаз пиши: ['шифровано: '] + шифровано, нови-ред.
				Излаз пиши: ['дешифровано: '] + шифровано, нови-ред.
				Програм крај.
			}.
		} ухвати: { :грш
			(s = [''] или: p = ['']) тачно: {
				ок додај: 1.
			}, иначе: {
				Излаз пиши: грш, нови-ред.
				Програм крај.
			}.
		}, покрени.
	}.
}.

Излаз пиши: ( ок + [' шифровања трезором тестирана.'] ), нови-ред.