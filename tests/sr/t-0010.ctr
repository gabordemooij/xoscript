>> Animal := Објекат нови.
Animal на: ['make'] уради: {
	>> animal := Објекат нови.
	animal на: ['makeSound'] уради: {
		Излаз пиши: свој sound.
	}. <- animal.
}.
>> Cat := Објекат нови.
Cat на: ['make'] уради: {
	>> cat := Animal make.
	cat на: ['init'] уради: {
		свој sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
