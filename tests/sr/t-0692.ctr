Server init.

Излаз пиши: (
	Образац нови: ['^\\w+$'],
	подударање: ['test@example.com'] 
), нови-ред. # 0 подударања, не успева на @ и .

Излаз пиши: (
	Образац нови: ['^[^@]+@[^\.]+\.\\w+$'],
	подударање: ['test@example.com'] 
), нови-ред. # 1 подударање

Излаз пиши: (
	Образац нови: ['[^@]+@[^\.]+\.\\w+'],
	подударање: ['test@example.com'] 
), нови-ред. # 1 подударање

Излаз пиши: (
	Образац нови: ['([^@]+)@([^\.]+)\.\\w+'],
	подударање: ['test@example.com'] 
), нови-ред. # 1 подударање, групе нису битне

Излаз пиши: (
	Образац нови: ['[a-z]'],
	подударање: ['test@example.com'] 
), нови-ред. # 14 подударања

Излаз пиши: (
	Образац нови: ['.*'],
	подударање: ['test@example.com'] 
), нови-ред. # 1 подударање (све)

Излаз пиши: (
	Образац нови: ['(.*)'],
	подударање: ['test@example.com'] 
), нови-ред. # 1 подударање (све)

Излаз пиши: (
	Образац нови: ['\\s*[^@]+@[^\.]+\.\\w+'],
	подударање: ['test@example.com'] 
), нови-ред. # 1 подударање, размак као префикс је опционалан, занемарује се