Server init.

Излаз пиши: (
	Образац нови: ['^\\w+$'],
	подударање: ['test@example.com'] 
), нови-ред. # 0 match, fails on @ and .

Излаз пиши: (
	Образац нови: ['^[^@]+@[^\.]+\.\\w+$'],
	подударање: ['test@example.com'] 
), нови-ред. # 1 match

Излаз пиши: (
	Образац нови: ['[^@]+@[^\.]+\.\\w+'],
	подударање: ['test@example.com'] 
), нови-ред. # 1 match

Излаз пиши: (
	Образац нови: ['([^@]+)@([^\.]+)\.\\w+'],
	подударање: ['test@example.com'] 
), нови-ред. # 1 match, groups dont matter

Излаз пиши: (
	Образац нови: ['[a-z]'],
	подударање: ['test@example.com'] 
), нови-ред. # 14 matches

Излаз пиши: (
	Образац нови: ['.*'],
	подударање: ['test@example.com'] 
), нови-ред. # 1 match (all)

Излаз пиши: (
	Образац нови: ['(.*)'],
	подударање: ['test@example.com'] 
), нови-ред. # 1 match (all)

Излаз пиши: (
	Образац нови: ['\\s*[^@]+@[^\.]+\.\\w+'],
	подударање: ['test@example.com'] 
), нови-ред. # 1 match, prefix space optional, gets ignored