
Програм управљање-меморијом: 4.

>> Животиња := Објекат нови.
Животиња на: ['направи'] уради: {
	>> животиња := Објекат нови.
	животиња на: ['направиЗвук'] уради: {
		Излаз пиши: свој звук.
	}. <- животиња.
}.
>> Мачка := Објекат нови.
Мачка на: ['направи'] уради: {
	>> мачка := Животиња направи.
	мачка на: ['init'] уради: {
		свој звук := ['meow!'].
	}.
	мачка init. <- мачка.
}.
>> tom := Мачка направи.
tom направиЗвук.
