
>> животиња := Објекат нови. 
 
 животиња на: ['name:'] уради: { :n
свој назив := n.
}. 


животиња name: ['Diva']. 
 
животиња на: ['назив'] уради: { <- назив.
}.

>> мачка := животиња нови.
 
 мачка name: ['Diva']. 
 
 мачка на: ['назив'] уради: { <- ['ваше краљевско височанство ']
+ (себе назив).
}.

Излаз пиши: мачка назив.
