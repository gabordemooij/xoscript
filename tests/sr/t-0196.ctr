
>> animal := Објекат нови. 
 
 animal на: ['name:'] уради: { :n
свој назив := n.
}. 


animal name: ['Diva']. 
 
animal на: ['назив'] уради: { <- назив.
}.

>> cat := animal нови.
 
 cat name: ['Diva']. 
 
 cat на: ['назив'] уради: { <- ['your royal highness ']
+ (себе назив).
}.

Излаз пиши: cat назив.
