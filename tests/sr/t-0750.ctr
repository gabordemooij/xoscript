Излаз пиши: ['Test object'], нови-ред.
>> a := Објекат нови. 

a на: ['item:'] уради: { :nil
	свој nil := nil. 
}.

a на: ['item'] уради: { <- свој nil.
}.

a item: Ништа.

Излаз пиши: a item, нови-ред.

>> old-nil-address := a item прототип меморијска-адреса.
a save-as: ['/tmp/a.bin'].
Излаз пиши: ['========== RELOADING SNAP:'], нови-ред.

>> b := Објекат load-from: ['/tmp/a.bin'].

(b item прототип меморијска-адреса = old-nil-address) тачно: {
	Излаз пиши: ['Object link re-attached.'], нови-ред.
}.

Излаз пиши: b item, нови-ред.
