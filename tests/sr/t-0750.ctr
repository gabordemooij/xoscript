Излаз пиши: ['Тест објекат'], нови-ред.
>> a := Објекат нови. 

a на: ['item:'] уради: { :нил
	свој нил := нил. 
}.

a на: ['ставка'] уради: {
	<- свој нил.
}.

a item: Ништа.

Излаз пиши: a ставка, нови-ред.

>> стара-нил-адреса := a ставка прототип меморијска-адреса.
a save-as: ['/tmp/a.bin'].
Излаз пиши: ['========== ПОНОВНО УЧИТАВАЊЕ СНИМКА:'], нови-ред.

>> b := Објекат load-from: ['/tmp/a.bin'].

(b ставка прототип меморијска-адреса = стара-нил-адреса) тачно: {
	Излаз пиши: ['Веза објекта поново прикачена.'], нови-ред.
}.

Излаз пиши: b ставка, нови-ред.
