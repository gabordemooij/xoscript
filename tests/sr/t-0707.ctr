# тест претварања типова / конверзија / повезивања
Програм управљање-меморијом: 4.
Server init.

>> бројач := 0.
>> бп := Maria-DB нови домаћин: ['localhost'],
	корисник: ['xo'], лозинка: ['pass123'], назив-базе: ['xobase'], повежи-се.

>> ДвоцифрениФормат := Формат нови: ['%02d'].

# Датум и време
{
	>> година     := Број између: 1995 и: 2050, текст.
	>> месец    := ДвоцифрениФормат примени-цео: (Број између: 1 и: 12), текст.
	>> дан      := ДвоцифрениФормат примени-цео: (Број између: 1 и: 28), текст.
	>> сат     := ДвоцифрениФормат примени-цео: (Број између: 1 и: 23), текст.
	>> минут   := ДвоцифрениФормат примени-цео: (Број између: 1 и: 59), текст.
	>> секунда   := ДвоцифрениФормат примени-цео: (Број између: 1 и: 59), текст.
	>> датумвреме := ['YYYY-MM-DD HH:II:SS'].	
	датумвреме
		YYYY: година,
		MM: месец,
		DD: дан,
		HH: сат,
		II: минут,
		SS: секунда.
	>> параметри-претраге :=
	бп упит: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: датумвреме),
	преузми: { :врста
		(врста mydatetime = датумвреме) нетачно: {
			овај-задатак грешка: (
				['Очекивано: <expected>, а добијено: <observation>']
				<expected>: датумвреме,
				<observation>: врста mydatetime
			).
		}.
	
	}.
	бројач додај: 1.
} * 100.

# Датум
{
	>> година     := Број између: 1995 и: 2050, текст.
	>> месец    := ДвоцифрениФормат примени-цео: (Број између: 1 и: 12), текст.
	>> дан      := ДвоцифрениФормат примени-цео: (Број између: 1 и: 28), текст.
	>> датум     := ['YYYY-MM-DD'].
	датум
		YYYY: година,
		MM: месец,
		DD: дан.
	>> параметри-претраге :=
	бп упит: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: датум),
	преузми: { :врста
		(врста mydate = датум) нетачно: {
			овај-задатак грешка: (
				['Очекивано: <expected>, а добијено: <observation>']
				<expected>: датум,
				<observation>: врста mydate
			).
		}.
	}.
	бројач додај: 1.
} * 100.


# Време
{
	>> сат     := ДвоцифрениФормат примени-цео: (Број између: 1 и: 23), текст.
	>> минут   := ДвоцифрениФормат примени-цео: (Број између: 1 и: 59), текст.
	>> секунда   := ДвоцифрениФормат примени-цео: (Број између: 1 и: 59), текст.
	>> време := ['HH:II:SS'].
	време
		HH: сат,
		II: минут,
		SS: секунда.
	>> параметри-претраге :=
	бп упит: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: време),
	преузми: { :врста
		(врста mytime = време) нетачно: {
			овај-задатак грешка: (
				['Очекивано: <expected>, а добијено: <observation>']
				<expected>: датумвреме,
				<observation>: врста mytime
			).
		}.
	}.
	бројач додај: 1.
} * 100.


# Текстови (varchar/text)
>> str1 := Листа нови попуни: 100000 са: ['x'], споји: [''].
{
	>> str2 := Сеф токен: 40.
	>> параметри-претраге :=
	бп упит: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	преузми: { :врста
		(врста str1 = str1 и: врста str2 = str2) нетачно: {
			овај-задатак грешка: (
				['Очекивано: <expected>, а добијено: <observation>']
				<expected>: датумвреме,
				<observation>: врста mytime
			).
		}.
	}.
	бројач додај: 1.
} * 100.


# Бројеви
{
	>> n1  := Број између: 1 и: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 из-текста: ['9223372036854775807'] ) -
		( Int64 из-текста: ['99999'] ) +
		( Int64 из-текста: n1 текст )
	).
	>> параметри-претраге :=
	бп упит: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	преузми: { :врста
		(врста n1 = n1) нетачно: {
			овај-задатак грешка: (
				['Очекивано: <expected>, а добијено: <observation>']
				<expected>: n1,
				<observation>: врста n1
			).
		}.
		(врста n2 = n2) нетачно: {
			овај-задатак грешка: (
				['Очекивано: <expected>, а добијено: <observation>']
				<expected>: n1,
				<observation>: врста n2
			).
		}.
		(врста n3 = n2 заокружи) нетачно: {
			овај-задатак грешка: (
				['Очекивано: <expected>, а добијено: <observation>']
				<expected>: n1,
				<observation>: врста n3
			).
		}.
		(врста big = big) нетачно: {
			овај-задатак грешка: (
				['Очекивано: <expected>, а добијено: <observation>']
				<expected>: big,
				<observation>: врста big
			).
		}.
		
	}.
	бројач додај: 1.
} * 100.


Излаз пиши: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: бројач
), нови-ред.