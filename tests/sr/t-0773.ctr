Излаз пиши: ['Test object'], нови-ред.
>> a := Објекат нови. 
a на: ['item:'] уради: { :int64
	свој int64 := int64. 
}.
a на: ['item'] уради: { <- свој int64.
}.
a item: ( Int64 из-текста: ['9999'] ).
Излаз пиши: a item, нови-ред.
>> old-int64-address := a item прототип меморијска-адреса.
a save-as: ['/tmp/a.bin'].
Излаз пиши: ['========== RELOADING SNAP:'], нови-ред.
>> b := Објекат load-from: ['/tmp/a.bin'].
(b item прототип меморијска-адреса = old-int64-address) тачно: {
	Излаз пиши: ['Object link re-attached.'], нови-ред.
}.
Излаз пиши: ( b item ), нови-ред.
