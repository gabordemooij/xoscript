Излаз пиши: ['Тест објекат'], нови-ред.
>> a := Објекат нови. 
a на: ['item:'] уради: { :int64
	свој int64 := int64. 
}.
a на: ['ставка'] уради: {
	<- свој int64.
}.
a item: ( Int64 из-текста: ['9999'] ).
Излаз пиши: a ставка, нови-ред.
>> стара-int64-адреса := a ставка прототип меморијска-адреса.
a save-as: ['/tmp/a.bin'].
Излаз пиши: ['========== ПОНОВНО УЧИТАВАЊЕ СНИМКА:'], нови-ред.
>> b := Објекат load-from: ['/tmp/a.bin'].
(b ставка прототип меморијска-адреса = стара-int64-адреса) тачно: {
	Излаз пиши: ['Веза објекта поново прикачена.'], нови-ред.
}.
Излаз пиши: ( b ставка ), нови-ред.
