# декодирање из utf16le/be или utf32le/be у utf8
Server init.
>> utf16 := Blob нови: 8, bytes: (
	Листа нови ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Излаз пиши: ( utf16 декодирај: ['utf16le'] ), нови-ред.

utf16 ослободи.
>> utf32 := Blob нови: 13, bytes: (
	Листа нови ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Излаз пиши: ( utf32 декодирај: ['utf32be'] ), нови-ред.
utf32 ослободи.