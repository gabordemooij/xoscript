Излаз пиши: ['Тест објекат'], нови-ред.
>> a := Објекат нови. 

a на: ['item:'] уради: { :рчн
	свој рчн := рчн. 
}.

a на: ['ставка'] уради: {
	<- свој рчн.
}.

a item: (
Речник нови
	hello: ['world']).

>> стара-рчн-адреса := a ставка прототип меморијска-адреса.
a save-as: ['/tmp/a.bin'].
Излаз пиши: ['========== ПОНОВНО УЧИТАВАЊЕ СНИМКА:'], нови-ред.

>> b := Објекат load-from: ['/tmp/a.bin'].

(b ставка прототип меморијска-адреса = стара-рчн-адреса) тачно: {
	Излаз пиши: ['Веза објекта поново прикачена.'], нови-ред.
}.

Излаз пиши: b ставка, нови-ред.
