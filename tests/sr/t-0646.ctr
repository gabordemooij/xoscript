Server init.
Излаз пиши: ['Тест датума и времена у бази података'], нови-ред.

>> бп := Maria-DB нови домаћин: ['localhost'],
	корисник: ['xo'], 
	лозинка: ['pass123'],
	назив-базе: ['xobase'],
	повежи-се.

>> параметри-претраге :=
бп упит: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
преузми: { :врста
	Излаз пиши: врста datetimetest, нови-ред.
}.
