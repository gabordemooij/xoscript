Server init.
Излаз пиши: ['Database datetime test'], нови-ред.

>> db := Maria-DB нови домаћин: ['localhost'],
	корисник: ['xo'], 
	лозинка: ['pass123'],
	назив-базе: ['xobase'],
	повежи-се.

>> параметри-претраге :=
db упит: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
преузми: { :row
	Излаз пиши: row datetimetest, нови-ред.
}.
