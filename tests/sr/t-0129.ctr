
Листа на: ['product'] уради: {
	>> total := 1.
	себе сваки: { :index :element
		total помножи-са: element.
	}. <- total.
}.

>> a := Листа ← 1 ; 2 ; 3.
Излаз пиши: a product, нови-ред.
Излаз пиши: (Листа ← 2 ; 4 ; 8) product, нови-ред. 
Излаз пиши: (Листа ← -2 ; 10) product, нови-ред. 
Излаз пиши: (Листа ← 0.5 ; -2) product, нови-ред. 
