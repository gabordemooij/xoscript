>> V := Објекат.
V на: ['текст'] уради: {
	Излаз пиши: ['cast'], нови-ред.
	<- ['abc'].
}.

Излаз пиши: ( Програм подешавање: ['abc'] ), нови-ред.

# params не би требало да буду сакупљени од стране gc-а
Програм подешавање: ([''] + V нови) вредност: ([''] + V нови).

Излаз пиши: ( Програм подешавање: ['abc'] ), нови-ред.
