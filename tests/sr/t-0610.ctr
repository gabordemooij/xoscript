
>> Правоугаоник := Објекат нови.

Правоугаоник на: ['површина'] уради: {
	<- свој дужина * свој ширина.
}.

Правоугаоник на: ['length:'] уради: { :дужина
	свој дужина := дужина.
}.

Правоугаоник на: ['width:'] уради: { :ширина
	свој ширина := ширина.
}.

Правоугаоник на: ['нови'] уради: {
	# ово неће довести до бесконачне петље
	>> правоугаоник := себе нови.
	правоугаоник length: 0, width: 0.
	<- правоугаоник.
}.

>> a := Правоугаоник нови.
Излаз пиши: a површина, нови-ред. #0

>> b := Правоугаоник нови length: 2, width: 3.
Излаз пиши: b површина, нови-ред. #6

