
>> Rectangle := Објекат нови.

Rectangle на: ['area'] уради: { <- свој дужина * свој width.
}.

Rectangle на: ['length:'] уради: { :дужина
	свој дужина := дужина.
}.

Rectangle на: ['width:'] уради: { :width
	свој width := width.
}.

Rectangle на: ['нови'] уради: {
	# this will not result into an infinite loop
	>> rectangle := себе нови.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle нови.
Излаз пиши: a area, нови-ред. #0

>> b := Rectangle нови length: 2, width: 3.
Излаз пиши: b area, нови-ред. #6

