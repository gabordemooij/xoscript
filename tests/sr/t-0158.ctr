>> x := [' hallo '].

>> y := x велика-слова.
Излаз пиши: x, нови-ред.
Излаз пиши: (x једнако: y), нови-ред.

>> y := x мала-слова.
Излаз пиши: x, нови-ред.
Излаз пиши: (x једнако: y), нови-ред.

>> y := x скрати.
Излаз пиши: x, нови-ред.
Излаз пиши: (x једнако: y), нови-ред.

>> y := x помак: 1.
Излаз пиши: x, нови-ред.
Излаз пиши: (x једнако: y), нови-ред.

>> y := x од: 1 дужина: 2.
Излаз пиши: x, нови-ред.
Излаз пиши: (x једнако: y), нови-ред.