>> randomizer := { :a :b
	>> минимум := ( a < b ) или: a или: b.
	>> максимум := ( a > b ) или: a или: b.
	>> x := Ништа.
	{
		x := Број између: a и: b.
		((x < минимум) или: (x > максимум)) тачно: { 
			Излаз пиши: (['Invalid value!']).
			Програм крај.
		}.
	} 
	× 100. <- x.
}.
