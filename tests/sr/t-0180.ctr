Текст на: ['html'] уради: { <- (
		себе
		замени: ['&'] са: ['&amp;'],
		замени: ['<'] са: ['&lt;'],
		замени: ['>'] са: ['&gt;'],
		замени: ['''] са: ['&apos;'],
		замени: ['"'] са: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програм управљање-меморијом: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Излаз пиши: txt копирај html, нови-ред.
Излаз пиши: txt копирај мала-слова, нови-ред.
Излаз пиши: txt копирај велика-слова, нови-ред.
} покрени.

Програм очисти.

usedMemory1 := (Програм меморија ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Излаз пиши: txt копирај html, нови-ред.
Излаз пиши: txt копирај мала-слова, нови-ред.
Излаз пиши: txt копирај велика-слова, нови-ред.
} покрени.

Програм очисти.
usedMemory2 := (Програм меморија ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Излаз пиши: txt копирај html, нови-ред.
Излаз пиши: txt копирај мала-слова, нови-ред.
Излаз пиши: txt копирај велика-слова, нови-ред.
} покрени.

Програм очисти.
usedMemory3 := (Програм меморија ? 0).



( usedMemory1 = usedMemory2 и: usedMemory1 = usedMemory3, и: usedMemory2 = usedMemory3 ) тачно: {
	Излаз пиши: ['No memory leaks here'].
}, нетачно: {
	Излаз пиши: ['Leaking memory...'].
}.
