# тест метода за хватање свих порука
>> x13 := Објекат нови.
x13 на: ['a'] уради: { :a Излаз пиши: 0, нови-ред. }.
x13 на: ['a:'] уради: { :a Излаз пиши: a, нови-ред. <- 5. }.
x13 на: ['a:b:'] уради: { :a :b Излаз пиши: (a + b), нови-ред. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
