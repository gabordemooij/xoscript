

Програм очисти.


>> Veggy := Објекат нови.
Veggy на: ['нови'] уради: {
	>> v := себе нови.
	v init. <- v.
}.

Veggy на: ['init'] уради: { свој veggies := 0. }.

Veggy на: ['carrots:'] уради: { :a свој veggies := a. <- Ништа. }.
Veggy на: ['carrots'] уради: { <- свој veggies. }.
Veggy на: ['+'] уради: { :f
	>> n := Veggy нови.
	n carrots: (f carrots + свој veggies). <- n.
}.

Veggy на: ['текст'] уради: { <- свој veggies текст.
}.

Број на: ['carrots'] уради: {
	>> x := Veggy нови.
	x carrots: себе. <- x.
}.

Број на: ['add:and:'] уради: { :a :b <- (a + b).
}.

>> q := 0 add: (3 carrots + 2 carrots) and: 4 carrots.
Излаз пиши: q, нови-ред.
