Излаз пиши: ['Настави петљу за, Не - пре 6 и више.'], нови-ред.
{ :i
	Излаз пиши: (i + 1), нови-ред.
	((i + 1) > 4) настави.
	Излаз пиши: ['-'].
} × 10.

>> x := 0.
>> xМањиОд10 := { <- ( x < 10 ). }.
Излаз нови-ред.
Излаз пиши: ['Настави док-тачно, Не --> пре 5 и више.'], нови-ред.
{
	Излаз пиши: ['iteration #'] + x, нови-ред.
	x додај: 1.
	((x < 5) не) настави.
	Излаз пиши: ['-->'].
} док: xМањиОд10.
Излаз нови-ред.
Излаз пиши: ['Настави док-нетачно, Не - само пре 3.'], нови-ред.
{
	Излаз пиши: ['iteration #'] + x, нови-ред.
	x одузми: 1.
	(x = 3) настави.
	Излаз пиши: ['-'].
} док: { <- ( x > 0). }.

Излаз нови-ред.
Излаз пиши: ['Настави петљу пута, Не ||| пре 3.'], нови-ред.
{ :i
	Излаз пиши: ['iteration #'] + i, нови-ред.
	(i = 2) настави.
	Излаз пиши: ['|||'].
} × 5.

Излаз нови-ред.

{ Тачно настави. Излаз пиши: ['не пиши ово!'], нови-ред. } покрени.

{ Тачно настави. Излаз пиши: ['не пиши ово!'], нови-ред. } ухвати: { Излаз пиши: ['Не хватај ово!']. }, покрени.

Излаз пиши: ['Тест петље сваки за низ: 0, ... ,2'], нови-ред.
(Листа ← 1 ; 2 ; 3) пресликај: { :i
	(i = 1) настави.
	Излаз пиши: ['iteration #'] + (i - 0), нови-ред.
}.

Излаз пиши: ['Тест петље сваки за мапу: само c'], нови-ред.
>> m := Речник нови.
m стави: ['first'] на: ['a'], стави: ['second'] на: ['b'], стави: ['трећи'] на: ['c'].
m сваки: { :k :v
	(k ≠ ['c']) настави.
	Излаз пиши: ['iteration'] + k + v, нови-ред.
}.

