Излаз пиши: ['Continue for-loop, No - before 6 and up.'], нови-ред.
{ :i
	Излаз пиши: (i + 1), нови-ред.
	((i + 1) > 4) настави.
	Излаз пиши: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Излаз нови-ред.
Излаз пиши: ['Continue while-true, No --> before 5 and up.'], нови-ред.
{
	Излаз пиши: ['iteration #'] + x, нови-ред.
	x додај: 1.
	((x < 5) не) настави.
	Излаз пиши: ['-->'].
} док: xIsLessThan10.
Излаз нови-ред.
Излаз пиши: ['Continue while-false, No - before 3 only.'], нови-ред.
{
	Излаз пиши: ['iteration #'] + x, нови-ред.
	x одузми: 1.
	(x = 3) настави.
	Излаз пиши: ['-'].
} док: { <- ( x > 0). }.

Излаз нови-ред.
Излаз пиши: ['Continue times-loop, No ||| before 3.'], нови-ред.
{ :i
	Излаз пиши: ['iteration #'] + i, нови-ред.
	(i = 2) настави.
	Излаз пиши: ['|||'].
} × 5.

Излаз нови-ред.

{ Тачно настави. Излаз пиши: ['dont write this!'], нови-ред. } покрени.

{ Тачно настави. Излаз пиши: ['dont write this!'], нови-ред. } ухвати: { Излаз пиши: ['Dont catch this!']. }, покрени.

Излаз пиши: ['Test Array each-loop: 0, ... ,2'], нови-ред.
(Листа ← 1 ; 2 ; 3) пресликај: { :i
	(i = 1) настави.
	Излаз пиши: ['iteration #'] + (i - 0), нови-ред.
}.

Излаз пиши: ['Test Map each-loop: c only'], нови-ред.
>> m := Речник нови.
m стави: ['first'] на: ['a'], стави: ['second'] на: ['b'], стави: ['third'] на: ['c'].
m сваки: { :k :v
	(k ≠ ['c']) настави.
	Излаз пиши: ['iteration'] + k + v, нови-ред.
}.

