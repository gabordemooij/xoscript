# Хеширање лозинке
Server init.

# Корисник поставља лозинку
>> лоз := ['pass123'].

# Чувате је овако
>> отисак := Сеф 
	хеш-лозинке: лоз.

# Затим се корисник пријављује
# Покушај 1
>> a1 := ['abcd123'].
# Покушај 2
>> a2 := ['pass123'].

# Провера
>> a := Сеф 
	хеш-лозинке: отисак провери: a1.
	# неуспех 
>> b := Сеф
	хеш-лозинке: отисак провери: a2.
	# ок!

Излаз пиши: a, нови-ред.
Излаз пиши: b, нови-ред.

