# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Сеф 
	хеш-лозинке: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Сеф 
	хеш-лозинке: hash провери: a1.
	# fail 
>> b := Сеф
	хеш-лозинке: hash провери: a2.
	# ok!

Излаз пиши: a, нови-ред.
Излаз пиши: b, нови-ред.

