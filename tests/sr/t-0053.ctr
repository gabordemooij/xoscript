60 × {
	>> x := (Број случајан % 6) + 1.
	(x ≤ 6) нетачно: { Излаз пиши: ['НЕУСПЕХ']. }.
	(x ≥0) нетачно: { Излаз пиши: ['НЕУСПЕХ']. }.
	x := (Број случајан % 3) + 1.
	(x < 3) нетачно: { Излаз пиши: ['НЕУСПЕХ']. }.
	(x>-1) нетачно: { Излаз пиши: ['НЕУСПЕХ']. }.
	x := ((Логички баци) број).
	(x = 0 или: x = 1) нетачно: { Излаз пиши: ['НЕУСПЕХ']. }.
	x := ((Тачно баци) број).
	(x = 0 или: x = 1) нетачно: { Излаз пиши: ['НЕУСПЕХ']. }.
	x := (Логички баци или: ['ГЛАВА'] или: ['ПИСМО']).
	((x = ['ГЛАВА']) или: (x = ['ПИСМО'])) нетачно: { Излаз пиши: ['НЕУСПЕХ']. }.
}.
Излаз пиши: ['ГОТОВО'].

