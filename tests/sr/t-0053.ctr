60 × {
	>> x := (Број random % 6) + 1.
	(x ≤ 6) нетачно: { Излаз пиши: ['FAIL']. }.
	(x ≥0) нетачно: { Излаз пиши: ['FAIL']. }.
	x := (Број random % 3) + 1.
	(x < 3) нетачно: { Излаз пиши: ['FAIL']. }.
	(x>-1) нетачно: { Излаз пиши: ['FAIL']. }.
	x := ((Логички flip) број).
	(x = 0 или: x = 1) нетачно: { Излаз пиши: ['FAIL']. }.
	x := ((Тачно flip) број).
	(x = 0 или: x = 1) нетачно: { Излаз пиши: ['FAIL']. }.
	x := (Логички flip или: ['HEAD'] или: ['TAIL']).
	((x = ['HEAD']) или: (x = ['TAIL'])) нетачно: { Излаз пиши: ['FAIL']. }.
}.
Излаз пиши: ['DONE'].

