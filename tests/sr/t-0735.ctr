Server init.
>> a := Blob нови: 4.
a bytes: ( Листа нови ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob нови: 4.
b bytes: ( Листа нови ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
# наслеђени blob не добија бафер, па је бескористан
# проћи ће ctr_accept(), али пошто је buffer ptr == null, врати
>> c := a нови.
{ 
>> n := a ^ c.
Излаз пиши: ['xorred:'], нови-ред. 
Излаз пиши: n, нови-ред. 
} ухвати: { :e Излаз пиши: e, нови-ред. }, покрени.
a ослободи.
b ослободи.
