{
	>> a := Листа нови.
	a додај-на-крај: 1.
	a додај-на-крај: 2.
	Излаз пиши: (a споји: [',']), нови-ред.
	a стави: 3 на: 2.
	Излаз пиши: (a споји: [',']), нови-ред.
	a стави: 4 на: 10.
	Излаз пиши: (a споји: [',']), нови-ред.
	a извади-први.
	a извади-први.
	a извади-први.
	Излаз пиши: (a споји: [',']), нови-ред.
	a стави: 9 на: 0.
	Излаз пиши: (a споји: [',']), нови-ред.
	a стави: 6 на: -1.
} ухвати: { :e
	Излаз пиши: ['Uncatched error has occurred.↵'] + e, нови-ред.
}, покрени.


