Логички на: ['xor:'] уради: { :a :b <- ((a и: b не) или: (a не и: b)).
}.

>> o := Објекат нови.
o на: ['hello'] уради: { ['Empty']. }.
{ o на: 2 уради: 3.} ухвати: { :e Излаз пиши: e, нови-ред. }, покрени.
{ o на: ['тест'] уради: 3.} ухвати: { :e Излаз пиши: e, нови-ред. }, покрени.
{ o на: ['hello'] уради: { ['Empty']. }.} ухвати: { :e Излаз пиши: e, нови-ред. }, покрени. 
{ >> z := 4 ÷ 0. } ухвати: { :e Излаз пиши: e, нови-ред. }, покрени. 
{ (Тачно и: Ништа) тачно: { Излаз пиши: ['X'].}. } ухвати: { :e Излаз пиши: e, нови-ред. }, покрени. 
{ ([''] xor: 0) тачно: { Излаз пиши: ['X'].}. } ухвати: { :e Излаз пиши: e, нови-ред. }, покрени. 
{ (1 < ['2']) тачно: { Излаз пиши: ['OK']. }. } ухвати: { :e Излаз пиши: e, нови-ред. }, покрени. 
{ (1 < ['2.0']) тачно: { Излаз пиши: ['OK']. }. } ухвати: { :e Излаз пиши: e, нови-ред. }, покрени. 
{ (1 < ['x2.0']) тачно: { Излаз пиши: ['NO!']. }. } ухвати: { :e Излаз пиши: e, нови-ред. }, покрени. 
{ Излаз пиши: (['hello OK there'] од: ['6'] дужина: ['2']). } покрени. 
