>> Point := Објекат нови.
Point на: ['x-coordinate:'] уради: { :x свој x := x. }.
Point на: ['y-coordinate:'] уради: { :y свој y := y. }.
Point на: ['x-coordinate']  уради: { <- свој x копирај. }.
Point на: ['y-coordinate']  уради: { <- свој y копирај. }.

Point на: ['='] уради: { :other <- ( свој x = other x-coordinate
		 и: свој y = other y-coordinate ).
}.

>> pier := Point нови x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point нови x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point нови x-coordinate: 5, y-coordinate: 6.

Излаз пиши: pier = town-hall, нови-ред.
Излаз пиши: pier = restaurant, нови-ред.
