>> Тачка := Објекат нови.
Тачка на: ['x-coordinate:'] уради: { :x свој x := x. }.
Тачка на: ['y-coordinate:'] уради: { :y свој y := y. }.
Тачка на: ['x-координата']  уради: { <- свој x копирај. }.
Тачка на: ['y-координата']  уради: { <- свој y копирај. }.

Тачка на: ['='] уради: { :друга
	<- ( свој x = друга x-координата
		 и: свој y = друга y-координата ).
}.

>> пристаниште := Тачка нови x-coordinate: 5, y-coordinate: 6.
>> градска-кућа := Тачка нови x-coordinate: 7, y-coordinate: 1.
>> ресторан := Тачка нови x-coordinate: 5, y-coordinate: 6.

Излаз пиши: пристаниште = градска-кућа, нови-ред.
Излаз пиши: пристаниште = ресторан, нови-ред.
