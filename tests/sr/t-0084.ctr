>> makeAdder := { :x
	>> f := { :y <- (свој x + y). } постави: ['x'] вредност: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i свој q стави: (свој f примени: (свој q ? i)) на: i. } 
	постави: ['q'] вредност: array,
	постави: ['f'] вредност: func.
	{ :i mapping примени: i. } × (array број-елемената).
}.

>> a := Листа ← 1; 2; 3.
mapper примени: a и: (makeAdder примени: 100).
Излаз пиши: (a позиција: 0), нови-ред.
Излаз пиши: (a ? 1), нови-ред.
Излаз пиши: (a ? 2), нови-ред.
