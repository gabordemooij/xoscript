>> направиСабирач := { :x
	>> f := { :y <- (свој x + y). } постави: ['x'] вредност: x. <- f.
}.
>> пресликавач := { :поље :функ
	>> пресликавање := { :i свој q стави: (свој f примени: (свој q ? i)) на: i. } 
	постави: ['q'] вредност: поље,
	постави: ['f'] вредност: функ.
	{ :i пресликавање примени: i. } × (поље број-елемената).
}.

>> a := Листа ← 1; 2; 3.
пресликавач примени: a и: (направиСабирач примени: 100).
Излаз пиши: (a позиција: 0), нови-ред.
Излаз пиши: (a ? 1), нови-ред.
Излаз пиши: (a ? 2), нови-ред.
