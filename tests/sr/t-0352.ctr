Број на: ['римски'] уради: {
	>> број := себе копирај.
	>> римски := [''].
	{
		{
			(број ≥ 1000) тачно: {
				римски додај-на-крај: ['Ⅿ'].
				број одузми: 1000.
			}, прекини.
		
			(број ≥ 500) тачно: {
				римски додај-на-крај: ['Ⅾ'].
				број одузми: 500.
			}, прекини.
		
			(број ≥ 100) тачно: {
				римски додај-на-крај: ['Ⅽ'].
				број одузми: 100.
			}, прекини.
		
			(број ≥ 50) тачно: {
				римски додај-на-крај: ['Ⅼ'].
				број одузми: 50.
			}, прекини.
		
			(број ≥ 50) тачно: {
				римски додај-на-крај: ['Ⅼ'].
				број одузми: 50.
			}, прекини.
		
			(број ≥ 10) тачно: {
				римски додај-на-крај: ['Ⅹ'].
				број одузми: 10.
			}, прекини.
			
			(број ≥ 9) тачно: {
				римски додај-на-крај: ['Ⅸ'].
				број одузми: 9.
			}, прекини.
			
			(број ≥ 5) тачно: {
				римски додај-на-крај: ['Ⅴ'].
				број одузми: 5.
			}, прекини.
			
			(број ≥ 4) тачно: {
				римски додај-на-крај: ['Ⅳ'].
				број одузми: 4.
			}, прекини.
			
			(број ≥ 1) тачно: {
				римски додај-на-крај: ['Ⅰ'].
				број одузми: 1.
			}, прекини.
		} процедура.
	} док: { <- број > 0. }. <- римски.
}.

Излаз пиши: 1 римски, нови-ред.
