Број на: ['roman'] уради: {
	>> број := себе копирај.
	>> roman := [''].
	{
		{
			(број ≥ 1000) тачно: {
				roman додај-на-крај: ['Ⅿ'].
				број одузми: 1000.
			}, прекини.
		
			(број ≥ 500) тачно: {
				roman додај-на-крај: ['Ⅾ'].
				број одузми: 500.
			}, прекини.
		
			(број ≥ 100) тачно: {
				roman додај-на-крај: ['Ⅽ'].
				број одузми: 100.
			}, прекини.
		
			(број ≥ 50) тачно: {
				roman додај-на-крај: ['Ⅼ'].
				број одузми: 50.
			}, прекини.
		
			(број ≥ 50) тачно: {
				roman додај-на-крај: ['Ⅼ'].
				број одузми: 50.
			}, прекини.
		
			(број ≥ 10) тачно: {
				roman додај-на-крај: ['Ⅹ'].
				број одузми: 10.
			}, прекини.
			
			(број ≥ 9) тачно: {
				roman додај-на-крај: ['Ⅸ'].
				број одузми: 9.
			}, прекини.
			
			(број ≥ 5) тачно: {
				roman додај-на-крај: ['Ⅴ'].
				број одузми: 5.
			}, прекини.
			
			(број ≥ 4) тачно: {
				roman додај-на-крај: ['Ⅳ'].
				број одузми: 4.
			}, прекини.
			
			(број ≥ 1) тачно: {
				roman додај-на-крај: ['Ⅰ'].
				број одузми: 1.
			}, прекини.
		} процедура.
	} док: { <- број > 0. }. <- roman.
}.

Излаз пиши: 1 roman, нови-ред.
Излаз пиши: 2 roman, нови-ред.
Излаз пиши: 4 roman, нови-ред.
Излаз пиши: 8 roman, нови-ред.
Излаз пиши: 16 roman, нови-ред.
Излаз пиши: 32 roman, нови-ред.
Излаз пиши: 64 roman, нови-ред.
Излаз пиши: 128 roman, нови-ред.
Излаз пиши: 256 roman, нови-ред.
Излаз пиши: 1024 roman, нови-ред.
