#regex тест
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> узорак := Образац нови: ['href="([^"]+)" target="([^"]+)"'].
>> резултат  := узорак подударање: subject уради: { :m :x
	Излаз пиши: m, нови-ред.
	Излаз пиши: x, нови-ред.
	<- ['XXX'].
}.
Излаз пиши: резултат, нови-ред.