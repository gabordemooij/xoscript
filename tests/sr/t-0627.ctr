

# прављење 64-битног целог броја за тачна израчунавања
>> a := Int64 из-текста: ['123'].

# у текст
Излаз пиши: a, нови-ред.

# дељење
Излаз пиши: a / (Int64 из-текста: ['3']), нови-ред.

# множење
Излаз пиши: a * (Int64 из-текста: ['2']), нови-ред.

# сабирање
Излаз пиши: a + (Int64 из-текста: ['1']), нови-ред.

# одузимање
Излаз пиши: a - (Int64 из-текста: ['2']), нови-ред.

# поређење
Излаз пиши: ( a =   (Int64 из-текста: ['123'])), нови-ред.
Излаз пиши: ( a !=: (Int64 из-текста: ['124'])), нови-ред.
Излаз пиши: ( a <   (Int64 из-текста: ['124'])), нови-ред.
Излаз пиши: ( a >   (Int64 из-текста: ['122'])), нови-ред.
Излаз пиши: ( a >=: (Int64 из-текста: ['123'])), нови-ред.
Излаз пиши: ( a <=: (Int64 из-текста: ['123'])), нови-ред.





	