Излез напиши: ['Test object'], нов-ред.
>> greeter := Објект нов.
greeter при: ['name:'] направи: { :име
	свој xname := име. 
}.
greeter при: ['greet'] направи: {
	Излез напиши: ['Hello '] + свој xname, нов-ред.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Излез напиши: ['========== RELOADING SNAP:'], нов-ред.
>> b := Објект load-from: ['/tmp/a.bin'].
>> c := Објект load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
