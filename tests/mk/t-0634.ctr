# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Програма shell-escape: ['abc'].
Излез напиши: c, нов-ред.
Излез напиши: ( Програма систем: ['echo '] + c ), нов-ред.

c := Програма shell-escape: ['a'b'c'].
Излез напиши: c, нов-ред.
Излез напиши: ( Програма систем: ['echo '] + c ), нов-ред.

c := Програма shell-escape: ['a\'c'].
Излез напиши: c, нов-ред.
Излез напиши: ( Програма систем: ['echo '] + c ), нов-ред.