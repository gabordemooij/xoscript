

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програма управување-со-меморија: 0.

Број при: ['addNum:'] направи: { :x
	себе додај: x.
}.

Број при: ['subtractNum:'] направи: { :x
	себе одземи: x.
}.

Број при: ['multiplyBy:'] направи: { :x
	себе помножи-со: x.
}.

Број при: ['divideBy:'] направи: { :x
	себе подели-со: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 степен: 8).  
a := a + (2 степен: -1). 
a := a + (49 квадратен-корен).   
a addNum: ((Листа ← 0 ; 1) максимум).          
a addNum: ((Листа ← 2 ; 3) минимум).
Излез напиши: a.

Програма исчисти.

usedMemory1 := (Програма меморија ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 степен: 8).  
a := a + (2 степен: -1). 
a := a + (49 квадратен-корен).   
a addNum: ((Листа ← 0 ; 1) максимум).          
a addNum: ((Листа ← 2 ; 3) минимум).
Излез напиши: a.

Програма исчисти.
usedMemory2 := (Програма меморија ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 степен: 8).  
a := a + (2 степен: -1). 
a := a + (49 квадратен-корен).   
a addNum: ((Листа ← 0 ; 1) максимум).          
a addNum: ((Листа ← 2 ; 3) минимум).
Излез напиши: a.

Програма исчисти.
usedMemory3 := (Програма меморија ? 0).



( usedMemory1 = usedMemory2 и: usedMemory1 = usedMemory3, и: usedMemory2 = usedMemory3 ) точно: {
	Излез напиши: ['No memory leaks here'].
}, неточно: {
	Излез напиши: ['Leaking memory...'].
}.
