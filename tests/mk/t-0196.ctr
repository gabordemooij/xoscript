
>> animal := Објект нов. 
 
 animal при: ['name:'] направи: { :n
свој име := n.
}. 


animal name: ['Diva']. 
 
animal при: ['име'] направи: { <- име.
}.

>> cat := animal нов.
 
 cat name: ['Diva']. 
 
 cat при: ['име'] направи: { <- ['your royal highness ']
+ (себе име).
}.

Излез напиши: cat име.
