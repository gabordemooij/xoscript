


>> CoffeeMachine := Објект нов.
CoffeeMachine при: ['order:'] направи: { :id
	>> coffee := ['Americano'].
	( id = 1 ) точно: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) точно: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) точно: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Објект нов.
SimpleCoffeeMachine при: ['order'] направи: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Излез напиши: redCup, нов-ред.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Излез напиши: greenCup, нов-ред.
>> yellowCup := CoffeeMachine order: 1.
Излез напиши: yellowCup, нов-ред.
>> blueCup := CoffeeMachine order: 0.
Излез напиши: blueCup, нов-ред.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Излез напиши: blackCup, нов-ред.
blackCup додај-на-крај: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Излез напиши: orangeCup, нов-ред.
