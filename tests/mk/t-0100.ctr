Текст при: ['html'] направи: { <- (
		себе
		замени: ['&'] со: ['&amp;'],
		замени: ['<'] со: ['&lt;'],
		замени: ['>'] со: ['&gt;'],
		замени: ['"'] со: ['&quot;']
	).
}.

>> list := Листа нов.

['Verbatim Syntax'] знаци секој: { :број :letter
	list ; ((['<li>#Number:Letter</li>']) Number: (број), Letter: letter).
}.

Излез list.





>> template := ['
<html>
<body>
<p>Hello this is a test!</p>
<p>The string \‘Verbatim Syntax\’ has: 15 code points...</p>
