>> items := Речник нов.
items стави: ['black'] на: ['coffee'], стави: ['earl grey'] на: ['tea'].
Излез напиши: (items на: ['coffee']), напиши: (items на: ['tea']).
Излез напиши: ['there are'] + items број-на-елементи + [' items in the array.'].
items стави: ['capuccino'] на: ['coffee'].
Излез напиши: ['Now my coffee is.. '] + (items на: ['coffee']).
items стави: ['aaa'] на: ['1'].
items стави: ['bbb'] на: ['2'].
Излез напиши: (items на: ['a']).
