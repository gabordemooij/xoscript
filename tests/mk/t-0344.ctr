# catch-all test (practical)
>> HTML := Текст нов.
HTML при: ['encode:'] направи: { :tekst
	себе додај-на-крај: (tekst
	замени: ['&'] со: ['&amp;'], 
	замени: ['<'] со: ['&lt;'],
	замени: ['>'] со: ['&gt;'],
	замени: ['"'] со: ['&quot;']).
}.
>> blog := HTML нов.
blog додај-на-крај: ['<h1>'],
     encode: ['Koffie & Thee'],
     додај-на-крај: ['</h1>'].
Излез напиши: blog, нов-ред.


>> Roman := Број нов.
Roman при: ['stringy'] направи: {
	>> a := [''].
	{ a додај-на-крај: ['I']. } × себе. <- a.
}.

>> x := Roman нов.
x додај: 3.
Излез напиши: x stringy, нов-ред.

>> Quantum := Логички нов.
Quantum при: ['true?'] направи: { <- ['maybe True']. }.
Излез напиши: (Quantum нов true?), нов-ред.

>> Nihil := Ништо нов.
Nihil при: ['текст'] направи: { <- ['Nihil']. }.
Излез напиши: (Nihil нов), нов-ред.
