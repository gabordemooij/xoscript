Излез напиши: ['Test object'], нов-ред.
>> a := Објект нов. 

a при: ['item:'] направи: { :binhelper
	свој binhelper := binhelper. 
}.

a при: ['item'] направи: { <- свој binhelper.
}.

a item: Bin нов.

>> old-binhelper-address := a item прототип мемориска-адреса.
a save-as: ['/tmp/a.bin'].
Излез напиши: ['========== RELOADING SNAP:'], нов-ред.

>> b := Објект load-from: ['/tmp/a.bin'].

(b item прототип мемориска-адреса = old-binhelper-address) точно: {
	Излез напиши: ['Object link re-attached.'], нов-ред.
}.


