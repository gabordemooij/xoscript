

Текст при: ['evaluate'] направи: {
	>> код := Датотека нов: ['/tmp/eval.ctr'].
	код напиши: себе текст + ['.'].
	Програма користи: ['/tmp/eval.ctr'].
}.

>> a := (Листа ← (
	(Речник нов)
		стави: ['domain'] на: ['mywebsite.com'],
		стави: (Листа ←
			((Речник нов)
				стави: ['home'] на: ['title'],
				стави: ['<html></html>'] на: ['body'],
				стави: ['2017-01-01'] на: ['created']
			) ;
			((Речник нов)
				стави: ['aboutus(c)'] на: ['title'],
				стави: ['<credits>Author Inc.</credits>'] на: ['body']
			)
		) на: ['pages']
	)
) текст.

Излез напиши: a тип, нов-ред.
Излез напиши: a, нов-ред.

>> b := Ништо.
(['b := '] + a) evaluate.
Излез напиши: b ? 0 ? ['pages'] ? 1 ? ['body'], нов-ред.

>> c := b ? 0.
>> d := c текст.
Излез напиши: d тип, нов-ред.

>> e := Ништо.
(['e := '] + d) evaluate.
Излез напиши: e ? ['pages'] ? 0, нов-ред.
