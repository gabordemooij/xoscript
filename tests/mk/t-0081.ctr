>> map1 := Речник нов.
>> key1 := Листа нов.
>> key2 := Листа нов.

map1
	стави: ['hello'] на: key1,
	стави: ['world'] на: key2.


Излез
	напиши: ['Map #1 contains: '] + (map1 на: key1),
	напиши: [' and '] + (map1 на: key2), нов-ред.

>> KeyeableArray := Листа нов.
KeyeableArray при: ['toString'] направи: { <- (себе број-на-елементи) toString.
}.

>> map2 := Речник нов.
key1 := KeyeableArray нов.
key2 := KeyeableArray нов.

key1 додај-на-крај: 1.

map2
	стави: ['hello'] на: key1,
	стави: ['world'] на: key2.

Излез
	напиши: ['Map #2 contains: '] + (map2 на: key1),
	напиши: [' and '] + (map2 на: key2), нов-ред.
