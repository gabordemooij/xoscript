>> Point := Објект нов.
Point при: ['x-coordinate:'] направи: { :x свој x := x. }.
Point при: ['y-coordinate:'] направи: { :y свој y := y. }.
Point при: ['x-coordinate']  направи: { <- свој x копирај. }.
Point при: ['y-coordinate']  направи: { <- свој y копирај. }.

Point при: ['='] направи: { :other <- ( свој x = other x-coordinate
		 и: свој y = other y-coordinate ).
}.

>> pier := Point нов x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point нов x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point нов x-coordinate: 5, y-coordinate: 6.

Излез напиши: pier = town-hall, нов-ред.
Излез напиши: pier = restaurant, нов-ред.
