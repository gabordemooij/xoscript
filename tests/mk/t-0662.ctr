>> t := Ништо.

# you can control the time zone for
# parsing like this:
Момент зона: ['CET'].
t := Момент извор: ['1981-02-03 04:05:06'].
Излез напиши: t, нов-ред.

# now using CEST time zone:
Момент зона: ['CEST'].
t := Момент извор: ['1981-02-03 04:05:06'].
Излез напиши: t, нов-ред.

# error if string cannot be parsed
{ Момент извор: ['1900']. } фати: { Ништо. }, стартувај.
