>> a := Листа ← Објект ; Точно ; Неточно ; Логички ; 1 ; Број ; ['Str'] ; Текст ; { ['Empty']. }.
Излез напиши: (a број-на-елементи), нов-ред.
{ :i
	Излез напиши: 
	['a '] + 
	((a ? i) тип) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Ништо?) или: [''] или: ['NOT']) + 
	[' Nil.'],
	нов-ред.
} × (a број-на-елементи).
Излез напиши: ['but.. Nil is.. '] + ((Ништо Ништо?) или: ['certainly NIL!'] или: ['not NIL??']), нов-ред.