Број при: ['factorial'] направи: {
	>> total := 1.
	{ :index total помножи-со: (себе - (index)). } × себе. <- total.
}.
>> Printer := Објект нов.
Printer при: ['print:and:'] направи: { :x :y
	Излез напиши: ['a='] + x + [', b='] + y, нов-ред.
}.
>> a := 4.5. >> b := a заокружи-надолу.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a заокружи-нагоре.
Printer print: a and: b.
a := 4.5. b := a заокружи-надолу.
Printer print: a and: b.
a := 4.5. b := a заокружи.
Printer print: a and: b.
a := 4.2. b := a заокружи.
Printer print: a and: b.

