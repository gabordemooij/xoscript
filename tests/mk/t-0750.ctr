Излез напиши: ['Test object'], нов-ред.
>> a := Објект нов. 

a при: ['item:'] направи: { :nil
	свој nil := nil. 
}.

a при: ['item'] направи: { <- свој nil.
}.

a item: Ништо.

Излез напиши: a item, нов-ред.

>> old-nil-address := a item прототип мемориска-адреса.
a save-as: ['/tmp/a.bin'].
Излез напиши: ['========== RELOADING SNAP:'], нов-ред.

>> b := Објект load-from: ['/tmp/a.bin'].

(b item прототип мемориска-адреса = old-nil-address) точно: {
	Излез напиши: ['Object link re-attached.'], нов-ред.
}.

Излез напиши: b item, нов-ред.
