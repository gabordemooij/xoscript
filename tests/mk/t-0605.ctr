>> invoice := Објект нов.
invoice при: ['стартувај'] направи: {
        свој број := 0.
}.

invoice при: ['број'] направи: {
        свој број додај: 1. <- свој број копирај.
}.

>> year-invoice := invoice нов.
year-invoice при: ['start:'] направи: { :година
	свој број := година.
}.

year-invoice start: 202000.
Излез напиши: year-invoice број, нов-ред.
Излез напиши: year-invoice број, нов-ред.
