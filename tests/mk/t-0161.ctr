Програма управување-со-меморија: 0.
Листа при: ['sum'] направи: {
	>> total := 0.
	себе секој: { :index :element
		total додај: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Датотека нов: ['/tmp/test.txt'].
f напиши: ['Lorem Ipsum'].
f затвори.
  

f := Датотека нов: ['/tmp/test.txt'].
>> text := f читај.
f затвори.



Програма исчисти.
usedMemory1 := (Програма меморија ? 1).



f := Датотека нов: ['/tmp/test.txt'].
text := f читај.
f затвори.

Програма исчисти.
usedMemory2 := (Програма меморија ? 1).


f := Датотека нов: ['/tmp/test.txt'].
text := f читај.
f затвори.

Програма исчисти.
usedMemory3 := (Програма меморија ? 1).



( usedMemory1 = usedMemory2 и: usedMemory1 = usedMemory3, и: usedMemory2 = usedMemory3 ) точно: {
	Излез напиши: ['No memory leaks here'].
}, неточно: {
	Излез напиши: ['Leaking memory...'].
}.
