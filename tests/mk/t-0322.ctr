

>> Matryoshka := Објект нов.
Matryoshka при: ['double:'] направи: { :secret
	свој secret := secret × 2.
}.
Matryoshka при: ['нов:'] направи: { :secret
	>> answer := Ништо.
	>> t := (secret > 255).
	Излез напиши: (secret + [' | '] + t), нов-ред.
	t точно: {
		answer := secret.
	}, инаку: {
		answer := Matryoshka рекурзивен нов: (себе double: secret).
	}. <- answer.
}.

>> x := Matryoshka нов: 2.
