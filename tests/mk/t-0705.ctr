

>> obj := Објект нов.

obj при: ['greet'] направи: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj при: ['task'] направи: {
	свој property := 123.
	{
		# try binds self/own to object instead of block
		Излез напиши: себе greet.
		Излез напиши: свој property.
		1 / 0.
	} фати: {
		Излез напиши: себе greet.
		Излез напиши: свој property.
		Излез напиши: ['ok'].
	}, обиди-се.
}.

obj task.