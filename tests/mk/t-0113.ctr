Излез напиши: ['Continue for-loop, No - before 6 and up.'], нов-ред.
{ :i
	Излез напиши: (i + 1), нов-ред.
	((i + 1) > 4) продолжи.
	Излез напиши: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Излез нов-ред.
Излез напиши: ['Continue while-true, No --> before 5 and up.'], нов-ред.
{
	Излез напиши: ['iteration #'] + x, нов-ред.
	x додај: 1.
	((x < 5) не) продолжи.
	Излез напиши: ['-->'].
} додека: xIsLessThan10.
Излез нов-ред.
Излез напиши: ['Continue while-false, No - before 3 only.'], нов-ред.
{
	Излез напиши: ['iteration #'] + x, нов-ред.
	x одземи: 1.
	(x = 3) продолжи.
	Излез напиши: ['-'].
} додека: { <- ( x > 0). }.

Излез нов-ред.
Излез напиши: ['Continue times-loop, No ||| before 3.'], нов-ред.
{ :i
	Излез напиши: ['iteration #'] + i, нов-ред.
	(i = 2) продолжи.
	Излез напиши: ['|||'].
} × 5.

Излез нов-ред.

{ Точно продолжи. Излез напиши: ['dont write this!'], нов-ред. } стартувај.

{ Точно продолжи. Излез напиши: ['dont write this!'], нов-ред. } фати: { Излез напиши: ['Dont catch this!']. }, стартувај.

Излез напиши: ['Test Array each-loop: 0, ... ,2'], нов-ред.
(Листа ← 1 ; 2 ; 3) пресликај: { :i
	(i = 1) продолжи.
	Излез напиши: ['iteration #'] + (i - 0), нов-ред.
}.

Излез напиши: ['Test Map each-loop: c only'], нов-ред.
>> m := Речник нов.
m стави: ['first'] на: ['a'], стави: ['second'] на: ['b'], стави: ['third'] на: ['c'].
m секој: { :k :v
	(k ≠ ['c']) продолжи.
	Излез напиши: ['iteration'] + k + v, нов-ред.
}.

