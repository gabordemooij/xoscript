>> a := 3.
>> b := a копирај.
a одземи: 1.
Излез напиши: [' a = '] + a.
Излез напиши: [' b = '] + b.
a := 3.
b := a + 4.
Излез напиши: [' a = '] + a.
Излез напиши: [' b = '] + b.
>> x := 3.
>> y := x копирај.
x додај: 10.
y одземи: 1.
Излез напиши: [' x = '] + x.
Излез напиши: [' y = '] + y.
>> q := Објект нов.
q при: ['setProperty:'] направи: { :x
	свој prop := x.
}.
q при: ['getProperty'] направи: { <- свој prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Излез напиши: [' p = '] + (p getProperty).
