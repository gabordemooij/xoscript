# test Program version

# this feature is disabled by default
Излез напиши: (
	Програма можност: 
	['RECURSIVE_STRINTPOL']
), нов-ред.


# but if we set the time back
>> today := Момент 
зона: ['CEST'],
извор: ['2026-02-15 10:00:00'].
Програма верзија: today.

# it will be enabled like it used to be (from now on)
Излез напиши: (
	Програма можност: 
	['RECURSIVE_STRINTPOL']
), нов-ред.