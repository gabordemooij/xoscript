
>> a := Листа ← (Листа ← 100 ; 200 ; 300) ; (Листа ← 9 ; 8 ; 7).
Излез напиши: ['at 0,1 :'].
Излез напиши: a ? 0 ? 1, нов-ред. 
Излез напиши: ['at 1,2 :'].
Излез напиши: a ? 1 ? 2, нов-ред. 
>> menu := Речник нов.
menu стави: (Листа ← ['pizza'] ; ['spaghetti']) на: ['Italian Cuisine'].
menu стави: (Листа ← ['bifteki'] ; ['suflaki']) на: ['Greek Cuisine'].
Излез напиши: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), нов-ред. 
Излез напиши: ['but not on the same plate.'], нов-ред.
