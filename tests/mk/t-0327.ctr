

Листа при: ['fixture:'] направи: { :f
	свој fixture := f.
}.

Листа при: ['број-на-елементи'] направи: { <- свој fixture.
}.

Листа при: ['aantal'] направи: { <- свој fixture.
}.


>> x := Ништо.
{

	x := ['hello'] 
	замени:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] знак: 2)
			)
		)
	со: (
		(['...hal'] + ['lo']) 
			големи-букви 
			lowecase 
			големи-букви 
			поместување: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Листа ← 0 ; 1 ; 4; 9 ; (Листа ← 0 ; 3; 1) ; 4
							) претпоследен
						) ? 1
					) + 
					((Листа ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					број-на-елементи
				)
			)
	).

} × 10.
Излез напиши: x, нов-ред.

