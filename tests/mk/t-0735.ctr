Server init.
>> a := Blob нов: 4.
a bytes: ( Листа нов ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob нов: 4.
b bytes: ( Листа нов ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
# inherited blob does not get the buffer, so it's useless
# it will pass ctr_accept() but since buffer ptr == null, it will retur
>> c := a нов.
{ 
>> n := a ^ c.
Излез напиши: ['xorred:'], нов-ред. 
Излез напиши: n, нов-ред. 
} фати: { :e Излез напиши: e, нов-ред. }, стартувај.
a ослободи.
b ослободи.
