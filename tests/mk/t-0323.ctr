

Програма исчисти.


>> Veggy := Објект нов.
Veggy при: ['нов'] направи: {
	>> v := себе нов.
	v init. <- v.
}.

Veggy при: ['init'] направи: { свој veggies := 0. }.

Veggy при: ['carrots:'] направи: { :a свој veggies := a. <- Ништо. }.
Veggy при: ['carrots'] направи: { <- свој veggies. }.
Veggy при: ['+'] направи: { :f
	>> n := Veggy нов.
	n carrots: (f carrots + свој veggies). <- n.
}.

Veggy при: ['текст'] направи: { <- свој veggies текст.
}.

Број при: ['carrots'] направи: {
	>> x := Veggy нов.
	x carrots: себе. <- x.
}.

Број при: ['add:and:'] направи: { :a :b <- (a + b).
}.

>> q := 0 add: (3 carrots + 2 carrots) and: 4 carrots.
Излез напиши: q, нов-ред.
