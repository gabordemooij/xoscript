Текст при: ['evaluate'] направи: {
	>> код := Датотека нов: ['/tmp/eval.ctr'].
	код напиши: (себе текст + ['.']).
	Програма користи: ['/tmp/eval.ctr'].
}.

>> a := Листа ← 1 ; 2 ; 3.
>> b := (a текст).

Излез напиши: b, нов-ред. 
(['b := '] + b) evaluate.

Излез напиши: b ? 2, нов-ред. 

Излез напиши: (( Листа ← 1 ; 2 ; 3 )), нов-ред. 

Излез напиши: ((Речник нов) стави: 1 на: 2), нов-ред. 

>> x := ( (Листа ← 1 ; ( Листа ← 9 ) ; Точно ) ) текст.
Излез напиши: x, нов-ред. 
(['x := '] + x) evaluate.

Излез напиши: x ? 1 ? 0, нов-ред. 

>> y := (Речник нов) стави: (Листа ← 1) на: (Листа ← 2).
Излез напиши: y, нов-ред. 

(['y := '] + y) текст evaluate.

Излез напиши: (y на: (Листа ← 2) текст ), нов-ред.

Излез напиши: (Листа нов), нов-ред. 
Излез напиши: (Речник нов), нов-ред. 
