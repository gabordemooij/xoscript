>> t := Точно.
(t = Точно) точно: { Излез напиши: ['T']. }.
(t = Неточно) точно: { Излез напиши: ['F']. }.
Излез напиши: ['|'].
>> t := Неточно.
(t = Точно) точно: { Излез напиши: ['T']. }.
(t = Неточно) точно: { Излез напиши: ['F']. }.
Излез напиши: ['|'].
>> f := Точно.
(t = Точно и: f = Неточно) точно: { Излез напиши: ['T']. }.
(t = Неточно и: f = Точно) точно: { Излез напиши: ['F']. }.
Излез напиши: ['|'].
>> n := Ништо.
(n Ништо?) точно: { Излез напиши: ['T']. }.
(n Ништо?) неточно: { Излез напиши: ['F']. }.
Излез напиши: ['|'].
(f Boolean?) точно: { Излез напиши: ['T']. }.
(f Boolean?) неточно: { Излез напиши: ['F']. }.



