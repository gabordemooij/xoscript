
Листа при: ['sum'] направи: {
	>> total := 0.
	себе секој: { :index :element
		total додај: element.
	}. <- total.
}.

>> a := Листа ← 9 ; 8 ; 7.
Излез напиши: (a sum), нов-ред. 
>> a := Листа ← 1 ; 9.
Излез напиши: (a sum), нов-ред. 
>> a := Листа ← ['o'] ; 2.
Излез напиши: (a sum), нов-ред. 
Излез напиши: (Листа нов sum), нов-ред. 
