#ffi test


Server init.

Програма управување-со-меморија: 4.

# for this test you need set a path to libc (puts)
>> libname := Програма поставка: ['FFITESTLIB'].



Server поврзи: (
 Листа нов ;
 libname ;
 ['puts'] ;
 ( Листа нов ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s ослободи.

# test with struct

>> a := Blob нов: 8.
a bytes: (
	Листа <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Листа <<: ['int'], ; ['int']).

Server поврзи: (
	Листа <<: ['@structtest'], ;
	['@structtest'] ;
	(Листа <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Излез напиши: ['Sum test:'] + (ffitest ffisum: a), нов-ред.

struct ослободи-struct.
struct ослободи.
a ослободи.
