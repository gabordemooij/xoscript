Излез напиши: ['Test object'], нов-ред.
>> a := Објект нов. 

a при: ['item:'] направи: { :moment
	свој moment := moment. 
}.

a при: ['item'] направи: { <- свој moment.
}.

>> today := Момент нов зона: ['CEST'], година: 2026, месец: 7.
a item: today.
Излез напиши: a item, нов-ред.
a save-as: ['/tmp/a.bin'].
Излез напиши: ['========== RELOADING SNAP:'], нов-ред.
>> b := Објект load-from: ['/tmp/a.bin'].
Излез напиши: b item, нов-ред.
