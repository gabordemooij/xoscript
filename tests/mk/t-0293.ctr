
>> city := Листа ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Листа ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature според: city.
>> cities := weather записи сортирај: { :a :b <- (a спореди: b). }.
>> temperatures := weather вредности сортирај: { :a :b <- (a спореди: b) негативен?. }.

Излез напиши: (cities спои: [',']), нов-ред.
Излез напиши: (temperatures спои: [',']), нов-ред.
