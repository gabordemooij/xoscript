
>> Rectangle := Објект нов.

Rectangle при: ['area'] направи: { <- свој должина * свој width.
}.

Rectangle при: ['length:'] направи: { :должина
	свој должина := должина.
}.

Rectangle при: ['width:'] направи: { :width
	свој width := width.
}.

Rectangle при: ['нов'] направи: {
	# this will not result into an infinite loop
	>> rectangle := себе нов.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle нов.
Излез напиши: a area, нов-ред. #0

>> b := Rectangle нов length: 2, width: 3.
Излез напиши: b area, нов-ред. #6

