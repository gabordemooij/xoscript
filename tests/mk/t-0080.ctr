{
	>> a := Листа нов.
	a додај-на-крај: 1.
	a додај-на-крај: 2.
	Излез напиши: (a спои: [',']), нов-ред.
	a стави: 3 на: 2.
	Излез напиши: (a спои: [',']), нов-ред.
	a стави: 4 на: 10.
	Излез напиши: (a спои: [',']), нов-ред.
	a извади-прв.
	a извади-прв.
	a извади-прв.
	Излез напиши: (a спои: [',']), нов-ред.
	a стави: 9 на: 0.
	Излез напиши: (a спои: [',']), нов-ред.
	a стави: 6 на: -1.
} фати: { :e
