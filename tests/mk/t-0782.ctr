Излез напиши: ['Test object'], нов-ред.
>> cmd := Наредба нов.
Излез напиши: cmd ls /tmp, нов-ред.
>> old-cmd-address := cmd прототип мемориска-адреса.
cmd save-as: ['/tmp/a.bin'].
Излез напиши: ['========== RELOADING SNAP:'], нов-ред.
>> b := Објект load-from: ['/tmp/a.bin'].
(b прототип мемориска-адреса = old-cmd-address) точно: {
	Излез напиши: ['Object link re-attached.'], нов-ред.
}.
Излез напиши: b ls, нов-ред.


