>> Grandfather := Објект нов.
Grandfather при: ['greet'] направи: {
	Излез напиши: ['Ave!'], нов-ред.
}.
>> Father := Grandfather нов.
Father при: ['greet'] направи: {
	Излез напиши: ['Hello'], нов-ред.
	себе greet.
}.
>> Son := Father нов.
Son при: ['greet'] направи: {
	Излез напиши: ['Hi'], нов-ред.
	себе greet.
}.

Son greet.

>> Roundabout := Објект нов.
Roundabout при: ['circle:'] направи: { :x
	Излез напиши: x, нов-ред.
	(x < 3) точно: { себе рекурзивен circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) точно: { Излез напиши: x, нов-ред. x додај: 1.  increment стартувај. }. }.
increment стартувај.