

Листа при: ['sum'] направи: {
	>> total := 0.
	себе секој: { :index :element
		total додај: element.
	}. <- total.
}.

Листа при: ['product'] направи: {
	>> total := 1.
	себе секој: { :index :element
		total помножи-со: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програма управување-со-меморија: 0.

{

>> a := Листа ← ['hello'] ; ['world'] ; Точно ; Ништо ; 666.
a := a + ( Листа ← 1 ).
Излез напиши: ( ['sum: '] + ( a sum ) ), нов-ред.
Излез напиши: ( ['min: '] + ( a минимум ) ), нов-ред.
Излез напиши: ( ['max: '] + ( a максимум ) ), нов-ред.
Излез напиши: ( ['3rd: '] + ( a ? 2 ) ), нов-ред.
Излез напиши: ( ['prd: '] + ( a product ) ), нов-ред.
a сортирај: { :a :b <- (b - a). }.
a секој: { :i :e Излез напиши: ( i - 0 ), нов-ред. }.

} стартувај.

Програма исчисти.
usedMemory1 := (Програма меморија ? 0).


{

>> a := Листа ← ['hello'] ; ['world'] ; Точно ; Ништо ; 666.
a := a + ( Листа ← 1 ).
Излез напиши: ( ['sum: '] + ( a sum ) ), нов-ред.
Излез напиши: ( ['min: '] + ( a минимум ) ), нов-ред.
Излез напиши: ( ['max: '] + ( a максимум ) ), нов-ред.
Излез напиши: ( ['3rd: '] + ( a ? 2 ) ), нов-ред.
Излез напиши: ( ['prd: '] + ( a product ) ), нов-ред.
a сортирај: { :a :b <- (b - a). }.
a секој: { :i :e Излез напиши: ( i - 0 ), нов-ред. }.

} стартувај.



Програма исчисти.
usedMemory2 := (Програма меморија ? 0).


{

>> a := Листа ← ['hello'] ; ['world'] ; Точно ; Ништо ; 666.
a := a + ( Листа ← 1 ).
Излез напиши: ( ['sum: '] + ( a sum ) ), нов-ред.
Излез напиши: ( ['min: '] + ( a минимум ) ), нов-ред.
Излез напиши: ( ['max: '] + ( a максимум ) ), нов-ред.
Излез напиши: ( ['3rd: '] + ( a ? 2 ) ), нов-ред.
Излез напиши: ( ['prd: '] + ( a product ) ), нов-ред.
