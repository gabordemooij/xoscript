

Листа при: ['column:'] направи: { :column
	>> result := Листа нов.
	себе секој: { :index :row
		row секој: { :index :cell
			(index = column) точно: { result додај-на-крај: cell. }.
		}.
	}. <- result.
}.


>> a := Листа ←
	(Листа ← 1 ; 2 ; 3) ;
	(Листа ← 4 ; 5 ; 6) ;
	(Листа ← 7 ; 8 ; 9).

>> b := a column: 1.
Излез напиши: b, нов-ред.

b := a column: 20.
Излез напиши: b, нов-ред.

b := a column: -100.
Излез напиши: b, нов-ред.
