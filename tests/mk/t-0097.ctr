
Текст при: ['html'] направи: { <- (
		себе
		замени: ['&'] со: ['&amp;'],
		замени: ['<'] со: ['&lt;'],
		замени: ['>'] со: ['&gt;'],
		замени: ['"'] со: ['&quot;']
	).
}.

>> HtmlBrush := Објект нов.

HtmlBrush при: ['одговори:'] направи: { :tag
	Излез напиши: (['<tag>↵'] tag: tag ).
}.

HtmlBrush при: ['одговори:и:'] направи: { :tag :content
	tag := ( tag од: 0 должина: (tag должина - 1) ).
	Излез напиши: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush при: ['content:'] направи: { :text
	Излез напиши: text html, нов-ред.
}.

HtmlBrush при: ['attr:value:'] направи: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush нов.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
