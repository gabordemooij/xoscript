# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob нов: 8, bytes: (
	Листа нов ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Излез напиши: ( utf16 декодирај: ['utf16le'] ), нов-ред.

utf16 ослободи.
>> utf32 := Blob нов: 13, bytes: (
	Листа нов ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Излез напиши: ( utf32 декодирај: ['utf32be'] ), нов-ред.
utf32 ослободи.