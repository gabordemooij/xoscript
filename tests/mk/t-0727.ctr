Server init.
>> f := Формат нов: ['%d'].
>> a := Blob нов: 4.
a bytes: ( Листа нов ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob нов: 4.
b bytes: ( Листа нов ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a од: 0 должина: 3, секој: { :i :byte
	Излез напиши: ( f примени-цел: byte ), нов-ред.
}.
a ^ b.
a од: 0 должина: 3, секој: { :i :byte
	Излез напиши: ( f примени-цел: byte ), нов-ред.
}.
a ^ b.
a од: 0 должина: 3, секој: { :i :byte
	Излез напиши: ( f примени-цел: byte ), нов-ред.
}.
a ослободи.
b ослободи.

{ a ^ Објект. } фати: { :e Излез напиши: e, нов-ред. }, стартувај.
