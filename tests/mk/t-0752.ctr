Излез напиши: ['Test object'], нов-ред.
>> a := Објект нов. 

a при: ['item:'] направи: { :логички
	свој логички := логички. 
}.

a при: ['item'] направи: { <- свој логички.
}.

a item: Логички.

Излез напиши: a item, нов-ред.

>> old-bool-address := a item прототип мемориска-адреса.
a save-as: ['/tmp/a.bin'].
Излез напиши: ['========== RELOADING SNAP:'], нов-ред.

>> b := Објект load-from: ['/tmp/a.bin'].

(b item прототип мемориска-адреса = old-bool-address) точно: {
	Излез напиши: ['Object link re-attached.'], нов-ред.
}.

Излез напиши: b item, нов-ред.
