#OBSD
>> dirname := [''].
{ dirname додај-на-крај: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Програма систем: command.
Програма chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename додај-на-крај: ['YYYYYYYY']. } * 20.
Датотека нов: filename, напиши: ['sometext'].
{ Датотека листа: ['/tmp/'] + dirname. } * 1000.
Излез напиши: ['no crash'], нов-ред.

