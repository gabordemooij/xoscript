# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := Maria-DB нов домаќин: ['localhost'],
	корисник: ['xo'],
	лозинка: ['pass123'],
	име-на-база: ['xobase'],
	поврзи-се.

>> параметри-за-пребарување := db барање: ['SELECT ? AS a, ? AS b, ? AS c'].
параметри-за-пребарување параметри: (Листа нов ; ['1']).
{ параметри-за-пребарување преземи: { :row Излез напиши: row, нов-ред. }. } фати: { :e Излез напиши: e, нов-ред. }, стартувај.

>> параметри-за-пребарување := db барање: ['SELECT ? AS a'].
{ параметри-за-пребарување преземи: { :row Излез напиши: row, нов-ред. }. } фати: { :e Излез напиши: e, нов-ред. }, стартувај.

# the right number still works, more parameters are ignored as before
>> параметри-за-пребарување := db барање: ['SELECT ? AS a, ? AS b'].
параметри-за-пребарување параметри: (Листа нов ; ['1'] ; ['2']).
параметри-за-пребарување преземи: { :row Излез напиши: (row на: ['a']), напиши: (row на: ['b']), нов-ред. }.
параметри-за-пребарување параметри: (Листа нов ; ['1'] ; ['2'] ; ['3']).
параметри-за-пребарување преземи: { :row Излез напиши: (row на: ['a']), напиши: (row на: ['b']), нов-ред. }.
