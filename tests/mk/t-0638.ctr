
Server init.
>> rq := HTTP-Барање нов.
Излез напиши: ['HTTP-GET d[]=']  + ( rq get-листа: ['d[]'] ), нов-ред. # GET
Излез напиши: ['HTTP-GET f[]=']  + ( rq get-листа: ['f[]'] ), нов-ред. # GET
Излез напиши: ['HTTP-POST e[]='] + ( rq post-листа: ['e[]'] ), нов-ред. # GET
Излез напиши: ['HTTP-POST c=']   + ( rq post: ['c'] ), нов-ред. # GET
Излез напиши: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), нов-ред. # GET
