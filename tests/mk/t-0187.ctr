Број при: ['factorial'] направи: {
	>> total := 1.
	{ :index total помножи-со: (себе - index). } × себе. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програма управување-со-меморија: 0.

{
2 exponent factorial.
Излез напиши: (11 модуло: 3), нов-ред.
Излез напиши: (3.4 заокружи), нов-ред.
Излез напиши: (7.1 заокружи-нагоре), нов-ред.
Излез напиши: (7.9 заокружи-надолу), нов-ред.
}
стартувај.

Програма исчисти.

usedMemory1 := (Програма меморија ? 0).

{
2 exponent factorial.
Излез напиши: (11 модуло: 3), нов-ред.
Излез напиши: (3.4 заокружи), нов-ред.
Излез напиши: (7.1 заокружи-нагоре), нов-ред.
Излез напиши: (7.9 заокружи-надолу), нов-ред.
}
стартувај.

Програма исчисти.
usedMemory2 := (Програма меморија ? 0).


{
2 exponent factorial.
Излез напиши: (11 модуло: 3), нов-ред.
Излез напиши: (3.4 заокружи), нов-ред.
Излез напиши: (7.1 заокружи-нагоре), нов-ред.
Излез напиши: (7.9 заокружи-надолу), нов-ред.
} стартувај.

Програма исчисти.
usedMemory3 := (Програма меморија ? 0).



( usedMemory1 = usedMemory2 и: usedMemory1 = usedMemory3, и: usedMemory2 = usedMemory3 ) точно: {
	Излез напиши: ['No memory leaks here'].
}, неточно: {
	Излез напиши: ['Leaking memory...'].
}.
