
>> dictionary := (
	Речник нов
		стави: ['b'] на: ['a'],
		стави: ['a'] на: ['b'],
		стави: ['z'] на: ['x'],
		стави: ['hello'] на: ['hallo'],
		стави: ['human'] на: ['human']
).

>> comparisons := Листа нов.
dictionary секој: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a спореди: b)
	).
}.

comparisons сортирај: { :a :b <- ( a спореди: b ). }.
Излез напиши: ( comparisons спои: ['↵'] ), нов-ред.
comparisons спои: ['↵'].
