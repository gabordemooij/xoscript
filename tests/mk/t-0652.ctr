# test number -> string -> number
{

	>> x := Број помеѓу: 0 и: 1000000.
	>> d := Број помеѓу: 1 и: 7.
	>> e := 10 степен: d.

	x подели-со: e.
	>> y := x текст број.

	(x = y) неточно: {
		Излез напиши: x, нов-ред.
		Излез напиши: y, нов-ред.
		Програма крај.
	}.

} * 1000.
Излез напиши: ['OK'], нов-ред.