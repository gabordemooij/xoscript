# test qualifiers

Програма исчисти.

>> Fruit := Објект нов.
Fruit при: ['нов'] направи: {
	>> f := себе нов.
	f apples: 0. <- f.
}.
Fruit при: ['apples:'] направи: { :a свој apples := a. }.
Fruit при: ['apples'] направи: { <- свој apples. }.
Fruit при: ['+'] направи: { :f
	>> n := Fruit нов.
	n apples: (f apples + свој apples). <- n.
}.
Број при: ['apples'] направи: { <- ((Fruit нов) apples: себе).
}.

Fruit при: ['текст'] направи: { <- свој apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Излез напиши: q, нов-ред.




q := 3 apples + 4 apples.
Излез напиши: q, нов-ред.



q := 3 apples + 4 apples.
Излез напиши: q, нов-ред.


