

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програма управување-со-меморија: 0.

>> a := Листа ← ['hello'] ; ['world'] ; Точно ; Ништо ; 666.
a прави извади-последен извади-прв додај-на-почеток: ['hi'], додај-на-крај: 999, готово.
Излез напиши: ( a спои: [','] ), нов-ред.

Програма исчисти.
usedMemory1 := (Програма меморија ? 0).


a := Листа ← ['hello'] ; ['world'] ; Точно ; Ништо ; 666.
a извади-последен. a извади-прв. a додај-на-почеток: ['hi'], додај-на-крај: 999.
Излез напиши: ( a спои: [','] ), нов-ред.


Програма исчисти.
usedMemory2 := (Програма меморија ? 0).


a := Листа ← ['hello'] ; ['world'] ; Точно ; Ништо ; 666.
a прави извади-последен извади-прв додај-на-почеток: ['hi'], додај-на-крај: 999, готово.
Излез напиши: ( a спои: [','] ), нов-ред.


Програма исчисти.
usedMemory3 := (Програма меморија ? 0).



( usedMemory1 = usedMemory2 и: usedMemory1 = usedMemory3, и: usedMemory2 = usedMemory3 ) точно: {
	Излез напиши: ['No memory leaks here'].
}, неточно: {
	Излез напиши: ['Leaking memory...'].
}.
