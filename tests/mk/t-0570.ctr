#Linux

 >> t := Момент нов.
 
t зона: ['Europe/Amsterdam'].
t година: 2020, месец: 8, ден: 2, час: 21, минута: 2, секунда: 1.

>> a := t час.
>> ams := t зона.

t зона: ['US/Hawaii'].
>> b := t час.
>> hw := t зона.

Излез
напиши: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		или: ['later'] или: ['earlier']
	)
),
нов-ред.
 