# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Сеф генерирај-клучеви.

# private (secret) key
>> sk := keys прв.

# public key
>> pk := keys последен.

# sign a message
>> sig := Сеф потпиши: ['abc'] со: sk.

# check message (ok)
Излез напиши: ( 
	Сеф
		провери: ['abc'] 
		потпис: sig 
		со: pk 
), нов-ред.

# check message (fail)
Излез напиши: ( 
	Сеф 
		провери: ['abd'] 
		потпис: sig 
		со: pk 
), нов-ред.