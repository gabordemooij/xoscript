Излез напиши: ['Test object'], нов-ред.
>> a := Објект нов. 

a при: ['item:'] направи: { :moment
	свој moment := moment. 
}.

a при: ['item'] направи: { <- свој moment.
}.

>> today := Листа нов ; ( Момент нов зона: ['CEST'], година: 2026, месец: 7 ).
a item: today.
Излез напиши: a item ? 0, нов-ред.
a save-as: ['/tmp/a.bin'].
