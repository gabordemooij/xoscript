# test url parsing

Server init.
>> url := URL извор: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Излез напиши: ['scheme = '] + url шема, нов-ред.
Излез напиши: ['host = '] + url домаќин, нов-ред.
Излез напиши: ['port = '] + url порта, нов-ред.
Излез напиши: ['path = '] + url патека, нов-ред.
Излез напиши: ['query = '] + url параметри-за-пребарување, нов-ред.
Излез напиши: ['fragment = '] + url фрагмент, нов-ред.
