#Linux
>> clock := Момент нов.
clock зона: ['UTC-1'].
clock година: 1981, месец: 1, ден: 5,
      час: 13, минута: 15, секунда: 13.

Излез напиши: clock, нов-ред.
clock зона: ['UTC+0'].

Излез напиши: (
	(clock година обичен) + ['-'] + (clock месец) + ['-'] + (clock ден) + [' '] +
	(clock час) + [':'] + (clock минута) + [':'] + (clock секунда) + [' '] +
	['W'] + (clock недела) + (clock зона)
), нов-ред.


clock зона: ['UTC-1'].
Излез напиши: (
	(clock година обичен) + ['-'] + (clock месец) + ['-'] + (clock ден) + [' '] +
	(clock час) + [':'] + (clock минута) + [':'] + (clock секунда) + [' '] +
	['W'] + (clock недела) + (clock зона)
), нов-ред.
