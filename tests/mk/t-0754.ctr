Излез напиши: ['Test object'], нов-ред.
>> a := Објект нов. 

a при: ['item:'] направи: { :out
	свој out := out. 
}.

a при: ['item'] направи: { <- свој out.
}.

a при: ['greet'] направи: {
	Излез напиши: ['hi from original out!'], нов-ред.
}.

a item: Излез.

Излез напиши: a item, нов-ред.

>> old-out-address := a item прототип мемориска-адреса.
a save-as: ['/tmp/a.bin'].
Излез напиши: ['========== RELOADING SNAP:'], нов-ред.

>> b := Објект load-from: ['/tmp/a.bin'].

(b item прототип мемориска-адреса = old-out-address) точно: {
	Излез напиши: ['Object link re-attached.'], нов-ред.
}.

b item напиши: ['hello from loaded out!'], нов-ред.
b greet.
