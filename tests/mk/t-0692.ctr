Server init.

Излез напиши: (
	Шаблон нов: ['^\\w+$'],
	совпаѓање: ['test@example.com'] 
), нов-ред. # 0 match, fails on @ and .

Излез напиши: (
	Шаблон нов: ['^[^@]+@[^\.]+\.\\w+$'],
	совпаѓање: ['test@example.com'] 
), нов-ред. # 1 match

Излез напиши: (
	Шаблон нов: ['[^@]+@[^\.]+\.\\w+'],
	совпаѓање: ['test@example.com'] 
), нов-ред. # 1 match

Излез напиши: (
	Шаблон нов: ['([^@]+)@([^\.]+)\.\\w+'],
	совпаѓање: ['test@example.com'] 
), нов-ред. # 1 match, groups dont matter

Излез напиши: (
	Шаблон нов: ['[a-z]'],
	совпаѓање: ['test@example.com'] 
), нов-ред. # 14 matches

Излез напиши: (
	Шаблон нов: ['.*'],
	совпаѓање: ['test@example.com'] 
), нов-ред. # 1 match (all)

Излез напиши: (
	Шаблон нов: ['(.*)'],
	совпаѓање: ['test@example.com'] 
), нов-ред. # 1 match (all)

Излез напиши: (
	Шаблон нов: ['\\s*[^@]+@[^\.]+\.\\w+'],
	совпаѓање: ['test@example.com'] 
), нов-ред. # 1 match, prefix space optional, gets ignored