# backslashes must survive code serialization, strings must not end early
>> вредности := Листа нов
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

вредности секој: { :i :value
	>> d := Речник нов.
	d стави: value на: ['k'].
	>> r := d код објект.
	Излез напиши: r број-на-елементи, нов-ред.
	Излез напиши: ( (r на: ['k']) = value ), нов-ред.
}.
