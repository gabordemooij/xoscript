>> Greeter := Објект нов.
Greeter при: ['make'] направи: {
	>> gr := Објект нов.
	gr при: ['setName:'] направи: { :aname
		свој име := aname.
	}.
	gr при: ['greet'] направи: {
		Излез напиши: свој име.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a нов.
c setName: ['THREE'].
c greet.
>> d := a нов.
d setName: ['FOUR'].
d greet.
c greet.
