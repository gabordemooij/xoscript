# test qualifiers

>> $ := Објект нов.

$ при: ['одговори:'] направи: { :x
	
	>> operation := x знак: 0.
	>> valuta := x знак: 1.
	>> money := x поместување: 2.
	
	>> amount := 0.

	( operation = ['+'] ) точно: {
		( valuta = ['£'] ) точно: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Излез напиши: x, нов-ред.


>> Fruit := Објект нов.

Fruit при: ['нов'] направи: {
	>> f := себе нов.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit при: ['apples:'] направи: { :a свој apples := a. }.
Fruit при: ['oranges:'] направи: { :p свој oranges := p. }.
Fruit при: ['apples'] направи: { <- свој apples. }.
Fruit при: ['oranges'] направи: { <- свој oranges. }.

Fruit при: ['+'] направи: { :f
	
	>> n := Fruit нов.
	f додај: 1.
	
	n apples: (f apples + свој apples).
	n oranges:  (f oranges  + свој oranges). <- n.
}.

Fruit при: ['текст'] направи: { <- ( свој apples текст + [' apples and '] + свој oranges + [' oranges'] ).
}.

Број при: ['apples'] направи: { <- ((Fruit нов) apples: себе).
}.

Број при: ['apple'] направи: { <- ((Fruit нов) apples: себе).
}.

Број при: ['oranges'] направи: { <- ((Fruit нов) oranges: себе).
}.




Излез напиши: (1 apple + 3 oranges + 4 apples), нов-ред.


Текст при: ['twice'] направи: { <- ((себе текст) + (себе текст)).
}.



Излез напиши: ['❤❤❤'] twice.



