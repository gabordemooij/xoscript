# test buffers PKI/Sign 
Server init.

>> long := ( Листа нов пополни: 1000 со: ['a'] ) спои: [''].

# sign a message
Излез напиши: ( 
	Сеф потпиши: ['abc'] со: long
), нов-ред.

Излез напиши: ( 
	Сеф
		провери: ['abc'] 
		потпис: long 
		со: long
), нов-ред.

Излез напиши: (
	Сеф хеш-на-лозинка: long провери: long
), нов-ред.
