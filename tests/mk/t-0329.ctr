Излез напиши: ((Листа нов
	при: ['plaque:'] направи: { :x свој o := x. },
	при: ['plaque']  направи: { <- свој o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Листа ← 1)
	~ (Листа ← 1 ; 2)
	~ (Листа ← 1 ; 2 ; 3)
	~ (Листа ← 1 ; 2 ; 3 ; 4)
	~ (Листа ← 1 ; 2 ; 3 ; 4 ; 5)
) секој: { :i :el
	{ Излез напиши: оваа-задача. } × el број-на-елементи.
