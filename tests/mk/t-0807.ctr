# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB нов домаќин: ['localhost'],
	корисник: ['xo'],
	лозинка: ['pass123'],
	име-на-база: ['xobase'],
	поврзи-се.

>> параметри-за-пребарување := db барање: ['SELECT %% FROM'].
{ параметри-за-пребарување изврши. } фати: { :e
	Излез напиши: ( e содржи: ['%%'] ), нов-ред.
}, стартувај.
