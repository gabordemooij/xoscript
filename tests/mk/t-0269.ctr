#Linux

(Датотека нов: ['/tmp/testje']) постои неточно: {
	Програма систем: ['mkdir /tmp/testje'].	
}.

(Датотека нов: ['/tmp/testje/file1']) постои неточно: {
	Програма систем: ['touch /tmp/testje/file1'].	
}.

(Датотека нов: ['/tmp/testje/folder1']) постои неточно: {
	Програма систем: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Датотека листа: ['/tmp/testje'].

>> q := Листа нов.

l секој: { :k :v v секој: { :x :y q додај-на-крај: y. }. }.

>> s := q текст.

(s содржи: ['file1']) точно:   { Излез напиши: ['OK'], нов-ред. }.
(s содржи: ['file2']) точно:   { Излез напиши: ['XX'], нов-ред. }.
(s содржи: ['folder1']) точно: { Излез напиши: ['OK'], нов-ред. }.
