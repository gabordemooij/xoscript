


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програма управување-со-меморија: 0.
>> palette := Ништо.
>> colors := Ништо.

{
palette := Речник нов.
palette 
	стави: ['#F00'] на: ['red'],
	стави: ['#0F0'] на: ['green'],
	стави: ['#00F'] на: ['blue'].
Излез напиши: ['number of RGB codes in palette: '] + ( palette број-на-елементи ), нов-ред.
Излез напиши: ['RGB code of green is: '] + ( palette ? ['green'] ), нов-ред.
colors := [''].
( palette секој: { :име :код
		colors := colors + ( име + [':'] + код ).
} ).
Излез напиши: ['All colors in palette: '] + colors, нов-ред.
} стартувај.
Програма исчисти.
usedMemory1 := (Програма меморија ? 0).

{
palette := Речник нов.
palette 
	стави: ['#F00'] на: ['red'],
	стави: ['#0F0'] на: ['green'],
	стави: ['#00F'] на: ['blue'].
