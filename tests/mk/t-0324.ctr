>> Animal := Објект нов.
>> Factory := Објект нов.

Animal при: ['нов'] направи: {
	>> animal := себе нов.
	animal sound: ['?']. <- animal.
}.

Animal при: ['sound:'] направи: { :s
	свој sound := s.
}.

Animal при: ['sound'] направи: { <- свој sound.
}.

>> Dog := Објект нов.
>> Cat := Објект нов.

Dog при: ['нов'] направи: { <- Animal нов sound: ['woof!'].
}.

Cat при: ['нов'] направи: { <- Animal нов sound: ['meow!'].
}.

Излез напиши: Dog нов sound, нов-ред.
Излез напиши: Cat нов sound, нов-ред.

Factory при: ['mix:and:'] направи: { :beast1 :beast2 <- Animal нов sound: (
		( beast1 sound од: 0 должина: 2 ) +
		( beast2 sound од: 2 должина: 5 )
	).
}.

Излез напиши: (Factory mix: Dog нов and: Cat нов) sound, нов-ред.
