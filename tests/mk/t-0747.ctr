Излез напиши: ['Test object'], нов-ред.
>> a := Објект нов. 

a при: ['item:'] направи: { :num
	свој num := num. 
}.

a при: ['item'] направи: { <- свој num.
}.

a item: 123.

Излез напиши: a item, нов-ред.

>> old-num-address := a item прототип мемориска-адреса.
a save-as: ['/tmp/a.bin'].
Излез напиши: ['========== RELOADING SNAP:'], нов-ред.

>> b := Објект load-from: ['/tmp/a.bin'].

(b item прототип мемориска-адреса = old-num-address) точно: {
	Излез напиши: ['Object link re-attached.'], нов-ред.
}.

Излез напиши: b item, нов-ред.
