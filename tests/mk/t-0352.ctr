Број при: ['roman'] направи: {
	>> број := себе копирај.
	>> roman := [''].
	{
		{
			(број ≥ 1000) точно: {
				roman додај-на-крај: ['Ⅿ'].
				број одземи: 1000.
			}, прекини.
		
			(број ≥ 500) точно: {
				roman додај-на-крај: ['Ⅾ'].
				број одземи: 500.
			}, прекини.
		
			(број ≥ 100) точно: {
				roman додај-на-крај: ['Ⅽ'].
				број одземи: 100.
			}, прекини.
		
			(број ≥ 50) точно: {
				roman додај-на-крај: ['Ⅼ'].
				број одземи: 50.
			}, прекини.
		
			(број ≥ 50) точно: {
				roman додај-на-крај: ['Ⅼ'].
				број одземи: 50.
			}, прекини.
		
			(број ≥ 10) точно: {
				roman додај-на-крај: ['Ⅹ'].
				број одземи: 10.
			}, прекини.
			
			(број ≥ 9) точно: {
				roman додај-на-крај: ['Ⅸ'].
				број одземи: 9.
			}, прекини.
			
			(број ≥ 5) точно: {
				roman додај-на-крај: ['Ⅴ'].
				број одземи: 5.
			}, прекини.
			
			(број ≥ 4) точно: {
				roman додај-на-крај: ['Ⅳ'].
				број одземи: 4.
			}, прекини.
			
			(број ≥ 1) точно: {
				roman додај-на-крај: ['Ⅰ'].
				број одземи: 1.
			}, прекини.
		} процедура.
	} додека: { <- број > 0. }. <- roman.
}.

