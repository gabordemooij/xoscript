Излез напиши: ['Test object'], нов-ред.
>> p := Патека /tmp.
Излез напиши: p, нов-ред.
>> old-p-address := p прототип мемориска-адреса.
p save-as: ['/tmp/a.bin'].
Излез напиши: ['========== RELOADING SNAP:'], нов-ред.
>> b := Објект load-from: ['/tmp/a.bin'].
(b прототип мемориска-адреса = old-p-address) точно: {
	Излез напиши: ['Object link re-attached.'], нов-ред.
}.
Излез напиши: b, нов-ред.
