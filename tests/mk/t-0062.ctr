Логички при: ['xor:'] направи: { :a :b <- ((a и: b не) или: (a не и: b)).
}.

>> o := Објект нов.
o при: ['hello'] направи: { ['Empty']. }.
{ o при: 2 направи: 3.} фати: { :e Излез напиши: e, нов-ред. }, стартувај.
{ o при: ['тест'] направи: 3.} фати: { :e Излез напиши: e, нов-ред. }, стартувај.
{ o при: ['hello'] направи: { ['Empty']. }.} фати: { :e Излез напиши: e, нов-ред. }, стартувај. 
{ >> z := 4 ÷ 0. } фати: { :e Излез напиши: e, нов-ред. }, стартувај. 
{ (Точно и: Ништо) точно: { Излез напиши: ['X'].}. } фати: { :e Излез напиши: e, нов-ред. }, стартувај. 
{ ([''] xor: 0) точно: { Излез напиши: ['X'].}. } фати: { :e Излез напиши: e, нов-ред. }, стартувај. 
{ (1 < ['2']) точно: { Излез напиши: ['OK']. }. } фати: { :e Излез напиши: e, нов-ред. }, стартувај. 
{ (1 < ['2.0']) точно: { Излез напиши: ['OK']. }. } фати: { :e Излез напиши: e, нов-ред. }, стартувај. 
{ (1 < ['x2.0']) точно: { Излез напиши: ['NO!']. }. } фати: { :e Излез напиши: e, нов-ред. }, стартувај. 
{ Излез напиши: (['hello OK there'] од: ['6'] должина: ['2']). } стартувај. 
