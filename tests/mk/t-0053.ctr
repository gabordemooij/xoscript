60 × {
	>> x := (Број random % 6) + 1.
	(x ≤ 6) неточно: { Излез напиши: ['FAIL']. }.
	(x ≥0) неточно: { Излез напиши: ['FAIL']. }.
	x := (Број random % 3) + 1.
	(x < 3) неточно: { Излез напиши: ['FAIL']. }.
	(x>-1) неточно: { Излез напиши: ['FAIL']. }.
	x := ((Логички flip) број).
	(x = 0 или: x = 1) неточно: { Излез напиши: ['FAIL']. }.
	x := ((Точно flip) број).
	(x = 0 или: x = 1) неточно: { Излез напиши: ['FAIL']. }.
	x := (Логички flip или: ['HEAD'] или: ['TAIL']).
	((x = ['HEAD']) или: (x = ['TAIL'])) неточно: { Излез напиши: ['FAIL']. }.
}.
Излез напиши: ['DONE'].

