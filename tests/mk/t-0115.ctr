{
	оваа-задача грешка: ['Dont fail.'].
	unknown doSomething.
} фати: {
	Излез напиши: ['Caught!'].
}, стартувај.

{
	оваа-задача грешка: ['Dont fail.'].
	свој unknown doSomething.
} фати: {
	Излез напиши: ['Caught!'].
}, стартувај.

{
	оваа-задача грешка: ['Dont fail.'].
	unknown := 122.
} фати: {
	Излез напиши: ['Caught!'].
}, стартувај.


{
	оваа-задача грешка: ['Dont fail.'].
	Точно прекини.
	Излез напиши: ['FAIL'].
} фати: {
	Излез напиши: ['Caught!'].
}, стартувај.

{
	{
		оваа-задача грешка: ['Dont fail.'].
		Точно прекини.
		Излез напиши: ['FAIL'].
	} фати: { :x
		(x = ['Dont fail.']) точно: { оваа-задача грешка: ['Nested Caught!']. }.
	}, стартувај.
} фати: { :e
	Излез напиши: e.
}, стартувај.
