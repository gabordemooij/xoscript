

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програма управување-со-меморија: 0.

>> o := Објект нов.
>> o2 := Објект нов.
Излез напиши: o Ништо?, нов-ред.
Излез напиши: o тип, нов-ред.
Излез напиши: ( o еднакво: o ), нов-ред.
Излез напиши: ( o еднакво: o2 ), нов-ред.
Излез напиши: o јас-самиот, нов-ред.
Излез напиши: ( o прави готово ), нов-ред.

Програма исчисти.

usedMemory1 := (Програма меморија ? 0).


o := Објект нов.
o2 := Објект нов.
Излез напиши: o Ништо?, нов-ред.
Излез напиши: o тип, нов-ред.
Излез напиши: ( o еднакво: o ), нов-ред.
Излез напиши: ( o еднакво: o2 ), нов-ред.
Излез напиши: o јас-самиот, нов-ред.
Излез напиши: ( o прави готово ), нов-ред.

Програма исчисти.
usedMemory2 := (Програма меморија ? 0).


o := Објект нов.
o2 := Објект нов.
Излез напиши: o Ништо?, нов-ред.
Излез напиши: o тип, нов-ред.
Излез напиши: ( o еднакво: o ), нов-ред.
Излез напиши: ( o еднакво: o2 ), нов-ред.
Излез напиши: o јас-самиот, нов-ред.
Излез напиши: ( o прави готово ), нов-ред.

Програма исчисти.
usedMemory3 := (Програма меморија ? 0).



( usedMemory1 = usedMemory2 и: usedMemory1 = usedMemory3, и: usedMemory2 = usedMemory3 ) точно: {
	Излез напиши: ['No memory leaks here'].
}, неточно: {
	Излез напиши: ['Leaking memory...'].
}.
