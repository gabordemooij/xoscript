Програма управување-со-меморија: 4.

>> Doubler := Објект нов.
>> Multiplier := Објект нов.
Doubler при: ['double:and:'] направи: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier при: ['multiply:and:'] направи: { :x :y <- (x × y).
}.

Излез напиши: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), нов-ред.
