Server init.

>> db := Maria-DB нов домаќин: ['localhost'],
	корисник: ['xo'],
	лозинка: ['pass123'],
	име-на-база: ['xobase'],
	поврзи-се.

>> del := db барање: ['DELETE FROM book WHERE id > 0'].
{  del изврши. db потврди. } фати: { :e db поништи.  }, стартувај.

>> број-на-елементи := db барање: ['SELECT COUNT(*) AS num FROM book'].
број-на-елементи преземи: { :row Излез напиши: row num, нов-ред. }.
