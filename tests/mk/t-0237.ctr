
Текст при: ['evaluate'] направи: {
	>> код := Датотека нов: ['/tmp/eval.ctr'].
	код напиши: (себе текст + ['.']).
	Програма користи: ['/tmp/eval.ctr'].
}.

>> map :=
	(Речник нов)
	стави: ['Hi There'] на: ['two'],
	стави: (Листа ← ['hello'] ; ['world'] ; (Листа ← 1 ; 2; 9) ; Неточно) на: ['one'],
	стави: ( (Речник нов) стави: ['wrrld'] на: ['misspelled'] ) на: ['three'],
	стави: (Листа ← ((Речник нов) стави: ['treasure'] на: ['hidden']) ; 2) на: ['four']. 
>> str := map текст.
>> map2 := Ништо.
(['map2 := '] + str ) evaluate.
Излез напиши: map2 ? ['one'] ? 0.
Излез напиши: map2 ? ['one'] ? 1.
Излез напиши: map2 ? ['four'] ? 0 ? ['hidden'].
Излез напиши: map2 ? ['one'] ? 2 ? 2.
