# test list operations


>> cakes := Листа ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes замени: 1 должина: 2 со: ( Листа ← ['cinnamon'] ; ['pineapple'] ).
Излез напиши: (buy спои: [',']), нов-ред.


>> buy := cakes замени: 1 должина: 12 со: ( Листа ← ['cinnamon'] ; ['pineapple'] ).
Излез напиши: (buy спои: [',']), нов-ред.


>> buy := cakes замени: 2 должина: 10 со: ( Листа нов ).
Излез напиши: (buy спои: [',']), нов-ред.


>> buy := cakes замени: 0 должина: 1 со: ( Листа нов ).
Излез напиши: (buy спои: [',']), нов-ред.


>> buy := cakes замени: ['0'] должина: ['1'] со: ['x'].
Излез напиши: (buy спои: [',']), нов-ред.
