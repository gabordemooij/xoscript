
>> countries := Листа нов
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Листа нов
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods според: countries, секој: { :key :value
	counter додај: 1.
}.

Излез напиши: (['we serve counter dishes'] counter: counter), нов-ред.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] знаци сортирај: { :v
	counter додај: 0.
}.

Излез напиши: (['we sort counter dishes'] counter: counter), нов-ред.


>> counter := 0.
{
	{
		counter додај: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Излез напиши: (['we calculate counter numbers.'] counter: counter), нов-ред.

