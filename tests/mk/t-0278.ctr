>> To-Do := Објект нов.

To-Do при: ['нов'] направи: {
	свој list := Листа нов.
}.

To-Do при: ['nieuw'] направи: {
	свој list := Листа нов.
}.

To-Do при: ['+'] направи: { :task
	свој list додај-на-крај: task.
}.

To-Do при: ['number of tasks?'] направи: { <-  свој list број-на-елементи.
}.

>> todos := 
	To-Do нов 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Излез напиши: ['You have $ tasks to do'] $ todos number of tasks?.
