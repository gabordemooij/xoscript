>> HTML := Објект нов.
HTML при: ['одговори:'] направи: { :tag 
	Излез напиши: (['<tag>'] tag: tag), нов-ред.
}.
HTML при: ['одговори:и:'] направи: { :tag :html 
	Излез напиши: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), нов-ред.
}.
>> html := HTML нов.
html body h1: ['header'].

