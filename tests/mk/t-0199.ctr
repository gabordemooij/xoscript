
Програма управување-со-меморија: 4.

>> Animal := Објект нов.
Animal при: ['make'] направи: {
	>> animal := Објект нов.
	animal при: ['makeSound'] направи: {
		Излез напиши: свој sound.
	}. <- animal.
}.
>> Cat := Објект нов.
Cat при: ['make'] направи: {
	>> cat := Animal make.
	cat при: ['init'] направи: {
		свој sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
