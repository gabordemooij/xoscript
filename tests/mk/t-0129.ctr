
Листа при: ['product'] направи: {
	>> total := 1.
	себе секој: { :index :element
		total помножи-со: element.
	}. <- total.
}.

>> a := Листа ← 1 ; 2 ; 3.
Излез напиши: a product, нов-ред.
Излез напиши: (Листа ← 2 ; 4 ; 8) product, нов-ред. 
Излез напиши: (Листа ← -2 ; 10) product, нов-ред. 
Излез напиши: (Листа ← 0.5 ; -2) product, нов-ред. 
