Server init.

# write a test file
>> f := Датотека нов: ['/tmp/test.gif'].
f напиши: ['GIF87a01234567810'].

# serve the file
Server проследи: ['test.gif'] префикс: ['/tmp/'].

Излез нов-ред.

Излез напиши: ['Outside container (security):'], нов-ред.
{ Server проследи: ['../passwd'] префикс: ['/tmp/']. }
фати: { :e Излез напиши: e, нов-ред. },
стартувај.

Излез напиши: ['Invalid prefix:'], нов-ред.
{ Server проследи: ['test.gif'] префикс: ['z:\\']. }
фати: { :e Излез напиши: e, нов-ред. },
стартувај.

Излез напиши: ['Non-existant file:'], нов-ред.
{ Server проследи: ['xxx.xxx'] префикс: ['/tmp/']. }
фати: { :e Излез напиши: e, нов-ред. },
стартувај.
