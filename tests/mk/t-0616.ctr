Листа при: ['копирај'] направи: {
	>> копирај := Листа нов.
	себе секој: { :број :section
		копирај додај-на-крај: section рекурзивен копирај.
	}. <- копирај.
}.

>> sheep := Листа нов ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep копирај.
clones секој: { :број :sheep
	sheep додај-на-крај: ['2'].
}.

Излез напиши: sheep, нов-ред.
Излез напиши: clones, нов-ред.
