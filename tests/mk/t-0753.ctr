Излез напиши: ['Test object'], нов-ред.
>> a := Објект нов. 

a при: ['item:'] направи: { :fmt
	свој fmt := fmt. 
}.

a при: ['item'] направи: { <- свој fmt.
}.

a item: ( Формат нов: ['|%s|'] ).

Излез напиши: a item, нов-ред.

>> old-fmt-address := a item прототип мемориска-адреса.
a save-as: ['/tmp/a.bin'].
Излез напиши: ['========== RELOADING SNAP:'], нов-ред.

>> b := Објект load-from: ['/tmp/a.bin'].

(b item прототип мемориска-адреса = old-fmt-address) точно: {
	Излез напиши: ['Object link re-attached.'], нов-ред.
}.

Излез напиши: ( b item примени: ['hello'] ), нов-ред.
