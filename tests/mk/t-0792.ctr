Server init.

>> DB := Maria-DB нов домаќин: ['localhost'],
	корисник: ['xo'],
	лозинка: ['pass123'],
	име-на-база: ['xobase'],
	поврзи-се.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB барање: SQL.

# now you don't have to set DB
query2 преземи: { :row
	Излез напиши: row world, нов-ред.
}.
