# a value ending in the first part of an opening quote must survive serialization
>> вредности := Листа нов
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

вредности секој: { :i :value
	>> d := Речник нов.
	d стави: value на: ['k'].
	d стави: ['second'] на: ['j'].
	>> r := d код објект.
	Излез напиши: r број-на-елементи, нов-ред.
	Излез напиши: ( (r на: ['k']) = value ), нов-ред.
}.
