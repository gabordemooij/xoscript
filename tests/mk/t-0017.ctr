Број при: ['factorial'] направи: {
	>> total := 1.
	{ :index total помножи-со: (себе - (index)). } × себе. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Излез напиши: a.
>> b := 2 + 3 factorial.
Излез напиши: b.
>> c := 3 factorial + 2.
Излез напиши: c.
>> d := 2 + (3 factorial).
Излез напиши: d.
Излез напиши: 2 + 3 factorial + 1.
