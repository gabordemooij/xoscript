# compliance test

# use international numbers

Излез напиши: ['1000 -> '].
Излез напиши: 1000, нов-ред. #1000

Излез напиши: ['1.5 -> '].
Излез напиши: 1.5, нов-ред.  #1.5

Излез напиши: ['1001.5 -> '].
Излез напиши: 1.5 + 1000, нов-ред. #1001.5

# use 0-indexed arrays
>> x := Листа нов ; 1 ; 2 ; 3.
>> y := Листа нов ; ['a'] ; ['b'] ; ['c'].

Излез напиши: ['1 -> '].
Излез напиши: x ? 0, нов-ред. #1

Излез напиши: ['1 -> '].
Излез напиши: (x на: 0), нов-ред. #1

Излез напиши: ['1 -> '].
Излез напиши: x прв, нов-ред. #1

Излез напиши: ['3 -> '].
Излез напиши: x последен, нов-ред. #3

Излез напиши: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Излез напиши: (x според: y), нов-ред.

Излез напиши: ['1 -> '].
Излез напиши: (x од: 0 должина: 1) прв, нов-ред. #1

Излез напиши: ['0 -> '].
Излез напиши: (x најди: 1), нов-ред. #0

x стави: 9 на: 0.

Излез напиши: ['9 -> '].
Излез напиши: (x на: 0), нов-ред. #9

x додај-на-почеток: 8.
Излез напиши: ['8 -> '].
Излез напиши: (x на: 0), нов-ред. #9


x додај-на-крај: 10.
Излез напиши: ['10 -> '].
Излез напиши: (x на: 4), нов-ред. #10








