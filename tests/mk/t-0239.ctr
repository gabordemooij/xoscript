Листа при: ['sum'] направи: {
	>> total := 0.
	себе секој: { :index :element
		total додај: element.
	}. <- total.
}.

>> a := Точно.



a при: ['текст'] направи: {
	>> answer := Ништо.
	( себе = Точно ) точно: {
		answer := ['Yep'].
	}, инаку: {
		answer := ['Nope'].
	}. <- answer.
}.

a при: ['број'] направи: {
	>> answer := Ништо.
	( себе = Точно ) точно: {
		answer := 10.
	}, инаку: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b при: ['текст'] направи: { <- ['Devil'].
}.

b при: ['логички'] направи: { <- Неточно.
}.


Излез напиши: a, нов-ред.  
Излез напиши: (90 + a), нов-ред. 
Излез напиши: b, нов-ред. 
Излез напиши: (Точно и: b), нов-ред.

a := Листа ← ['hello'] ; ['world'] ; Точно ; Ништо ; 666. 
a := a + ( Листа ← 1 ).
Излез напиши: a, нов-ред.
Излез напиши: ((Речник нов) стави: Ништо на: Ништо), нов-ред.
Излез напиши: a sum, нов-ред. 


{
	a при: ['текст'] направи: { <- Ништо. }.
	a := [''] + a.
} фати: { :error
	Излез напиши: ['Error noted: '] + error, нов-ред.
}, стартувај.



{
	a при: ['број'] направи: { <- Ништо. }.
	a := 3 × a.
} фати: { :error
	Излез напиши: ['Error noted: '] + error, нов-ред.
}, стартувај.


{
	a при: ['логички'] направи: { <- Ништо. }.
	a := Точно и: a. 
} фати: { :error
	Излез напиши: ['Error noted: '] + error, нов-ред.
}, стартувај.





