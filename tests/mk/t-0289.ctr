#Linux
>> OS := Програма систем: (Наредба uname -s), скрати.

>> Slurp := Објект нов.
Slurp при: ['нов'] направи: {
	свој str := [''].
}.
Slurp при: ['одговори:'] направи: { :blah
		(свој str ≠ ['']) точно: {
			свој str додај-на-крај: [' '].
		}.
		свој str додај-на-крај: blah.
}.
Slurp при: ['одговори:и:'] направи: { :blah :blahah
		(свој str ≠ ['']) точно: {
			свој str додај-на-крај: [' '].
		}.
		(blah должина > 1) точно: {
			свој str додај-на-крај: (blah од: 0 должина: (blah должина - 1)).
		}, инаку: {
			свој str додај-на-крај: blah.
		}.
		свој str додај-на-крај: [' '].
		свој str додај-на-крај: blahah.
}.
Slurp при: ['obtain'] направи: {
	>> buffer := свој str.
	свој str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text додај-на-крај: ['hello'].
} × 1000.


Излез напиши: (
	Програма систем: (
		Slurp нов
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

