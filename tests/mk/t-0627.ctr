

# create a 64-bit integer for exact calculations
>> a := Int64 од-текст: ['123'].

# to string
Излез напиши: a, нов-ред.

# divide
Излез напиши: a / (Int64 од-текст: ['3']), нов-ред.

# multiply
Излез напиши: a * (Int64 од-текст: ['2']), нов-ред.

# add
Излез напиши: a + (Int64 од-текст: ['1']), нов-ред.

# subtract
Излез напиши: a - (Int64 од-текст: ['2']), нов-ред.

# compare
Излез напиши: ( a =   (Int64 од-текст: ['123'])), нов-ред.
Излез напиши: ( a !=: (Int64 од-текст: ['124'])), нов-ред.
Излез напиши: ( a <   (Int64 од-текст: ['124'])), нов-ред.
Излез напиши: ( a >   (Int64 од-текст: ['122'])), нов-ред.
Излез напиши: ( a >=: (Int64 од-текст: ['123'])), нов-ред.
Излез напиши: ( a <=: (Int64 од-текст: ['123'])), нов-ред.





	