Текст при: ['html'] направи: { <- (
		себе
		замени: ['&'] со: ['&amp;'],
		замени: ['<'] со: ['&lt;'],
		замени: ['>'] со: ['&gt;'],
		замени: ['''] со: ['&apos;'],
		замени: ['"'] со: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програма управување-со-меморија: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Излез напиши: txt копирај html, нов-ред.
Излез напиши: txt копирај мали-букви, нов-ред.
Излез напиши: txt копирај големи-букви, нов-ред.
} стартувај.

Програма исчисти.

usedMemory1 := (Програма меморија ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Излез напиши: txt копирај html, нов-ред.
Излез напиши: txt копирај мали-букви, нов-ред.
Излез напиши: txt копирај големи-букви, нов-ред.
} стартувај.

Програма исчисти.
usedMemory2 := (Програма меморија ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Излез напиши: txt копирај html, нов-ред.
Излез напиши: txt копирај мали-букви, нов-ред.
Излез напиши: txt копирај големи-букви, нов-ред.
} стартувај.

Програма исчисти.
usedMemory3 := (Програма меморија ? 0).



( usedMemory1 = usedMemory2 и: usedMemory1 = usedMemory3, и: usedMemory2 = usedMemory3 ) точно: {
	Излез напиши: ['No memory leaks here'].
}, неточно: {
	Излез напиши: ['Leaking memory...'].
}.
