Server init.

>> DB := Maria-DB нов домаќин: ['localhost'],
	корисник: ['xo'],
	лозинка: ['pass123'],
	име-на-база: ['xobase'],
	поврзи-се.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> параметри-за-пребарување := Maria-Барање нов: SQL.

# set database
параметри-за-пребарување база-на-податоци: DB.

параметри-за-пребарување преземи: { :row
	Излез напиши: row world, нов-ред.
}.
