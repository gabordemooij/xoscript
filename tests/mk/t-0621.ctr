>> phrases := Листа нов
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases секој: { :_ :phrase 
	>> e := Server base64-кодирај: phrase.
	>> d := Server base64-декодирај: e.
	Излез напиши: (
		message копирај ~encoded: e, ~decoded: d
	), нов-ред.
}.
