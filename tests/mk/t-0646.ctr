Server init.
Излез напиши: ['Database datetime test'], нов-ред.

>> db := Maria-DB нов домаќин: ['localhost'],
	корисник: ['xo'], 
	лозинка: ['pass123'],
	име-на-база: ['xobase'],
	поврзи-се.

>> параметри-за-пребарување :=
db барање: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
преземи: { :row
	Излез напиши: row datetimetest, нов-ред.
}.
