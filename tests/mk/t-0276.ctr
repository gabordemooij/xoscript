>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Објект нов.
⚄ при: ['drawFrom:length:'] направи: { :pool :број-на-елементи
	
	>> result := [''].
	
	{
		>> index := Број random % (pool должина).
		result додај-на-крај: ( pool знак: (index + 1) ).
		
	} × број-на-елементи. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? должина.
Излез напиши: (['x↵'] x random должина).
Излез напиши: (['y↵'] y ?? должина).

