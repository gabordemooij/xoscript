

Текст при: ['evaluate'] направи: {
	>> код := Датотека нов: ['/tmp/eval.ctr'].
	код напиши: (себе текст + ['.']).
	Програма користи: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Листа ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q текст.
Излез напиши: x, нов-ред.
>> y := Ништо.
(['y := '] + x ) evaluate.
Излез напиши: y ? 0, нов-ред.

q := Речник стави: ['\[''] на: ['\['quote\']'].
x := q текст.
Излез напиши: x, нов-ред.
y := Ништо.
(['y := '] + x ) evaluate.

>> q := (Речник нов) стави:['\[''] на:['\['quote\[''].
Излез напиши: y ? ['\['quote\']'], нов-ред.
