Излез напиши: ['Test object'], нов-ред.
>> a := Објект нов. 
a при: ['item:'] направи: { :int64
	свој int64 := int64. 
}.
a при: ['item'] направи: { <- свој int64.
}.
a item: ( Int64 од-текст: ['9999'] ).
Излез напиши: a item, нов-ред.
>> old-int64-address := a item прототип мемориска-адреса.
a save-as: ['/tmp/a.bin'].
Излез напиши: ['========== RELOADING SNAP:'], нов-ред.
>> b := Објект load-from: ['/tmp/a.bin'].
(b item прототип мемориска-адреса = old-int64-address) точно: {
	Излез напиши: ['Object link re-attached.'], нов-ред.
}.
Излез напиши: ( b item ), нов-ред.
