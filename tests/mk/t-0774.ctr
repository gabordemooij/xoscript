Излез напиши: ['Test object'], нов-ред.
>> a := Објект нов. 
a при: ['item:'] направи: { :lst
	свој lst := lst. 
}.
a при: ['item'] направи: { <- свој lst.
}.
a item: (
	Листа нов ; 1 ; (
		Листа нов ; ['a'] ; (
			Листа нов ; ( Момент нов: 1 )
		) ; ( Int64 од-текст: ['321'] )
	)
).
Излез напиши: a item, нов-ред.
>> old-lst-address := a item прототип мемориска-адреса.
a save-as: ['/tmp/a.bin'].
Излез напиши: ['========== RELOADING SNAP:'], нов-ред.
>> b := Објект load-from: ['/tmp/a.bin'].
(b item прототип мемориска-адреса = old-lst-address) точно: {
	Излез напиши: ['Object link re-attached.'], нов-ред.
}.
Излез напиши: ( b item ), нов-ред.
