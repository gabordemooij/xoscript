# a format must fit the type of the value, the type can come from a client
>> обиди-се := { :format :value
	{ Излез напиши: ( (Формат нов: format) примени: value ), нов-ред. } фати: { :e Излез напиши: e, нов-ред. }, стартувај.
}.
>> try-int := { :format :value
	{ Излез напиши: ( (Формат нов: format) примени-цел: value ), нов-ред. } фати: { :e Излез напиши: e, нов-ред. }, стартувај.
}.

# fits
обиди-се примени: ['|%s|'] и: ['text'].
обиди-се примени: ['%06.2f'] и: 5.5.
обиди-се примени: ['100%% %s'] и: ['sure'].
try-int примени: ['%03d'] и: 7.
try-int примени: ['%x'] и: 255.
обиди-се примени: ['%d'] и: (Int64 нов од-текст: ['12']).
обиди-се примени: ['%lld'] и: (Int64 нов од-текст: ['12']).
обиди-се примени: ['%.1lf'] и: 5.5.
try-int примени: ['%hd'] и: 7.

# does not fit
обиди-се примени: ['%s'] и: 12345.
обиди-се примени: ['%d'] и: 12345.
обиди-се примени: ['%f'] и: ['text'].
try-int примени: ['%d'] и: ['text'].
try-int примени: ['%s'] и: 5.
обиди-се примени: ['%s %s'] и: ['text'].
обиди-се примени: ['%n'] и: ['text'].
обиди-се примени: ['%*s'] и: ['text'].
обиди-се примени: ['%'] и: ['text'].

# length modifier does not fit
обиди-се примени: ['%ls'] и: ['text'].
обиди-се примени: ['%Lf'] и: 5.5.
try-int примени: ['%ld'] и: 7.
try-int примени: ['%lld'] и: 7.
обиди-се примени: ['%Ld'] и: (Int64 нов од-текст: ['12']).

# a width that does not fit printf must give an error, not a crash
обиди-се примени: ['%99999999999s'] и: ['text'].
