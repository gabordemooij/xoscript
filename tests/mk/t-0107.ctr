
Излез напиши: ['Break for-loop, 0-4.'], нов-ред.
{ :i
	Излез напиши: ['iteration #'] + i, нов-ред.
	(i = 4) прекини.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Излез напиши: ['Break while-true loop, 0-4.'], нов-ред.
{
	Излез напиши: ['iteration #'] + x, нов-ред.
	x додај: 1.
	((x < 5) не) прекини.
} додека: xIsLessThan10.

Излез напиши: ['Break while-false loop, 5,4.'], нов-ред.
{
	Излез напиши: ['iteration #'] + x, нов-ред.
	x одземи: 1.
	(x = 3) прекини.
} додека: { <- (x > 0). }.

Излез напиши: ['Break times loop, 1-4.'], нов-ред.
{ :i
	Излез напиши: ['iteration #'] + i, нов-ред.
	(i = 4) прекини.
} × 5.

Излез напиши: ['Break block, dont print line.'], нов-ред.
{ Точно прекини. Излез напиши: ['dont write this!'], нов-ред. } стартувај.

Излез напиши: ['Break block, dont fire catch...'], нов-ред.
{ Точно прекини. Излез напиши: ['dont write this!'], нов-ред. } фати: { Излез напиши: ['Dont catch this!']. }, стартувај.

Излез напиши: ['Test Array each-loop: 0,1'], нов-ред.
(Листа ← 1 ; 2 ; 3) пресликај: { :i
	Излез напиши: ['iteration #'] + i, нов-ред.
	(i = 1) прекини.
}.

Излез напиши: ['Test Map each-loop: c only'], нов-ред.
>> m := Речник нов.
m стави: ['first'] на: ['a'], стави: ['second'] на: ['b'], стави: ['third'] на: ['c'].
m секој: { :k :v
	Излез напиши: ['iteration'] + v + k, нов-ред.
	Точно прекини.
}.

