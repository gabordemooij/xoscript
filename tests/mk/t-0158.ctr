>> x := [' hallo '].

>> y := x големи-букви.
Излез напиши: x, нов-ред.
Излез напиши: (x еднакво: y), нов-ред.

>> y := x мали-букви.
Излез напиши: x, нов-ред.
Излез напиши: (x еднакво: y), нов-ред.

>> y := x скрати.
Излез напиши: x, нов-ред.
Излез напиши: (x еднакво: y), нов-ред.

>> y := x поместување: 1.
Излез напиши: x, нов-ред.
Излез напиши: (x еднакво: y), нов-ред.

>> y := x од: 1 должина: 2.
Излез напиши: x, нов-ред.
Излез напиши: (x еднакво: y), нов-ред.