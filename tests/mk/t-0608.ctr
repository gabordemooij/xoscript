
>> Size := Објект нов.
Size при: ['is:'] направи: { :број
	број при: ['+'] направи: { :број
		>> unit := број определба.
		>> factor := 1.
		
		unit
		случај: ['inch'] направи: { factor := 0.0833. }. <- себе + (број * factor).
	}. <- број.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Излез напиши: plank + edge, нов-ред.
