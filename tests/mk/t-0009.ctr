>> Greeter := Објект нов.
Greeter при: ['make'] направи: {
	>> greeter := Објект нов.
	greeter при: ['name:'] направи: { :име
		Излез напиши: ['setting a name'].
		свој myName := име.
	}.
	greeter при: ['performGreeting'] направи: {
		Излез напиши: ['Hello'].
		Излез напиши: свој myName.
	}.
	greeter при: ['greet'] направи: {
		себе performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
