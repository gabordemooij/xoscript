



>> CoffeeGrounds := Објект нов.
CoffeeGrounds при: ['extract'] направи: { <- ['coffee']. }.

>> CoffeeMachine := Објект нов.
CoffeeMachine при: ['init'] направи: {
	свој coffeegrounds := CoffeeGrounds нов.
}.
CoffeeMachine при: ['нов'] направи: { <- CoffeeMachine `new init.
}.

CoffeeMachine при: ['makeTea'] направи: { <- (свој tealeaves extract). }.
CoffeeMachine при: ['makeCoffee'] направи: { <- (свој coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine нов.

Излез напиши:
	coffeeDream 
	makeCoffee.

Излез напиши:
	coffeeDream 
	makeTea.
