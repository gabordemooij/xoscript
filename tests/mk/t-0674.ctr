# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> патека := ['/tmp/dat.csv'].
>> csv := Датотека нов: патека.
csv напиши: s.

# accepts CRLF LF CR, varying row length
csv разделувач: [';'] наводник: ['"'] редови: { :line
	Програма исчисти.
	Излез напиши: line, нов-ред.
	Програма исчисти.
}.

# unequal lines
s додај-на-крај: ['\njustone'].
csv напиши: s.
{
	csv разделувач: [';'] наводник: ['"'] редови: { :line
		Излез напиши: line, нов-ред.
	}.
} фати: { :e 
	Излез напиши: e, нов-ред.
}, стартувај.

# invalid format
s := ['"he"llo";world'].
csv напиши: s.
{
	csv разделувач: [';'] наводник: ['"'] редови: { :line
		Излез напиши: line, нов-ред.
	}.
} фати: { :e 
	Излез напиши: e, нов-ред.
}, стартувај.
