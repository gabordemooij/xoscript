#Linux
>> OS := Програма поставка: ['OS'].

>> clock := Момент нов.
	
(OS = ['Haiku']) точно: {
	clock зона: ['CET'],
	година: 2017, месец: 7, ден: 13,
	час: 18, минута: 0, секунда: 0.
}, инаку: {
	clock зона: ['Europe/Amsterdam'],
	година: 2017, месец: 7, ден: 13,
	час: 18, минута: 0, секунда: 0.
}.

clock при: ['tell'] направи: {
	Излез напиши: себе, нов-ред.
}.


clock додај: 2    час, tell.
clock додај: 1    час, tell.
clock додај: 19 минута, tell.
clock додај: 1  минута, tell.
clock додај: 1  минута, tell.
clock додај: 19 секунда, tell.
clock додај: 1  секунда, tell.
clock додај: 1  секунда, tell.
clock додај: 2    година, tell.
clock додај: 1    година, tell.

(OS = ['Haiku']) точно: {
clock додај: 5   месец.
clock зона: ['CEST'], tell.
}, инаку: {
	clock додај: 5   месец, tell.
}.

clock додај: 1   месец, tell.
clock додај: 19    ден, tell.
clock додај: 1    час, tell.
clock додај: 120  yard, tell.
