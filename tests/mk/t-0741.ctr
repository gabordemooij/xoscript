Излез напиши: ['Test object'], нов-ред.
>> a := Објект нов. 

a при: ['item:'] направи: { :octhelper
	свој octhelper := octhelper. 
}.

a при: ['item'] направи: { <- свој octhelper.
}.

a item: Oct нов.

>> old-octhelper-address := a item прототип мемориска-адреса.
a save-as: ['/tmp/a.bin'].
Излез напиши: ['========== RELOADING SNAP:'], нов-ред.

>> b := Објект load-from: ['/tmp/a.bin'].

(b item прототип мемориска-адреса = old-octhelper-address) точно: {
	Излез напиши: ['Object link re-attached.'], нов-ред.
}.
