# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Сеф 
	хеш-на-лозинка: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Сеф 
	хеш-на-лозинка: hash провери: a1.
	# fail 
>> b := Сеф
	хеш-на-лозинка: hash провери: a2.
	# ok!

Излез напиши: a, нов-ред.
Излез напиши: b, нов-ред.

