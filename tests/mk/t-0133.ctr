


>> Deck := Листа нов.
Deck при: ['print'] направи: {
        >> len := себе број-на-елементи - 1.
        { :i
                >> len2 := себе број-на-елементи - 1.
                Излез напиши: ['len: '].
                Излез напиши: len, нов-ред.
                Излез напиши: ['len2: '].
                Излез напиши: len2, нов-ред.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
