>> z := Објект нов.
z при: ['value:'] направи: { :v
	свој value := v. <- себе.
}.
z при: ['value'] направи: { <- свој value. }.
(z setValue: 1) value: 2.
Излез напиши: z value.
>> x := z.
Излез напиши: x value.
z := Ништо.
Излез напиши: z value.
Излез напиши: x value.
Излез напиши: ['hello'].
Излез напиши: 3 + 2.
Излез напиши: (3 > 2).
