Server init.
>> f := Формат нов: ['%d'].
>> a := Blob нов: 4.
a bytes: ( Списък нов ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob нов: 4.
b bytes: ( Списък нов ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a от: 0 дължина: 3, всеки: { :i :byte
	Изход пиши: ( f приложи-цяло: byte ) , нов-ред.
}.
a ^ b.
a от: 0 дължина: 3, всеки: { :i :byte
	Изход пиши: ( f приложи-цяло: byte ) , нов-ред.
}.
a ^ b.
a от: 0 дължина: 3, всеки: { :i :byte
	Изход пиши: ( f приложи-цяло: byte ) , нов-ред.
}.
a освободи.
b освободи.

{ a ^ Обект. } прихвани: { :e Изход пиши: e, нов-ред. }, стартирай.
