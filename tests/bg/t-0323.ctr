

Програма почисти.


>> Veggy := Обект нов.
Veggy при: ['нов'] изпълни: {
	>> v := себе нов.
	v init. <- v.
}.

Veggy при: ['init'] изпълни: { свой veggies := 0. }.

Veggy при: ['carrots:'] изпълни: { :a свой veggies := a. <- Нищо. }.
Veggy при: ['carrots'] изпълни: { <- свой veggies. }.
Veggy при: ['+'] изпълни: { :f
	>> n := Veggy нов.
	n carrots: (f carrots + свой veggies). <- n.
}.

Veggy при: ['текст'] изпълни: { <- свой veggies текст.
}.

Число при: ['carrots'] изпълни: {
	>> x := Veggy нов.
	x carrots: себе. <- x.
}.

Число при: ['add:and:'] изпълни: { :a :b <- (a + b).
}.

>> q := 0 add: (3 carrots + 2 carrots) and: 4 carrots.
Изход пиши: q, нов-ред.
