

Програма почисти.


>> Зеленчук := Обект нов.
Зеленчук при: ['нов'] изпълни: {
	>> v := себе нов.
	v init. <- v.
}.

Зеленчук при: ['init'] изпълни: { свой зеленчуци := 0. }.

Зеленчук при: ['carrots:'] изпълни: { :a свой зеленчуци := a. <- Нищо. }.
Зеленчук при: ['моркови'] изпълни: { <- свой зеленчуци. }.
Зеленчук при: ['+'] изпълни: { :f
	>> n := Зеленчук нов.
	n carrots: (f моркови + свой зеленчуци). <- n.
}.

Зеленчук при: ['текст'] изпълни: { <- свой зеленчуци текст.
}.

Число при: ['моркови'] изпълни: {
	>> x := Зеленчук нов.
	x carrots: себе. <- x.
}.

Число при: ['събери:и:'] изпълни: { :a :b <- (a + b).
}.

>> q := 0 събери: (3 моркови + 2 моркови) и: 4 моркови.
Изход пиши: q, нов-ред.
