# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := Обект нов.

Log при: ['say:'] изпълни: { :str
	Изход пиши: str, нов-ред.
}.

>> Item := Обект нов.

Item при: ['нов:'] изпълни: { :id <- себе нов id: id.
}.

Item при: ['id:'] изпълни: { :id
	свой id := id.
}.

Item при: ['id'] изпълни: { <- свой id. }.


Item при: ['текст'] изпълни: {
	>> str := ['Item#~no'].
	str ~no: свой id. <- str.
}.


>> Print := Обект нов.

Print при: ['items'] изпълни: { 
	
	свой item := Item нов: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: свой item
	).
	
	
}.

Print items.