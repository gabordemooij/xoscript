# Този тест проверява дали string_fill_in не губи своето място (почистено от GC) в режим 4
# справка в world.c
>> Дневник := Обект нов.

Дневник при: ['say:'] изпълни: { :str
	Изход пиши: str, нов-ред.
}.

>> Предмет := Обект нов.

Предмет при: ['нов:'] изпълни: { :id
	<- себе нов id: id.
}.

Предмет при: ['id:'] изпълни: { :id
	свой id := id.
}.

Предмет при: ['id'] изпълни: { <- свой id. }.


Предмет при: ['текст'] изпълни: {
	>> str := ['Item#~no'].
	str ~no: свой id.
	<- str.
}.


>> Print := Обект нов.

Print при: ['items'] изпълни: { 
	
	свой предмет := Предмет нов: 1.
	
	# или segfault, или грешен низ тук
	Дневник say: (
		['~item printed.'] ~item: свой предмет
	).
	
	
}.

Print items.