# тест на преобразувания на типове / конверсии / свързвания
Програма управление-на-паметта: 4.
Server init.

>> брояч := 0.
>> бд := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'], парола: ['pass123'], име-на-база: ['xobase'], свържи-се.

>> Двуцифрен-формат := Формат нов: ['%02d'].

# Дата и час
{
	>> година     := Число между: 1995 и: 2050, текст.
	>> месец    := Двуцифрен-формат приложи-цяло: (Число между: 1 и: 12), текст.
	>> ден      := Двуцифрен-формат приложи-цяло: (Число между: 1 и: 28), текст.
	>> час     := Двуцифрен-формат приложи-цяло: (Число между: 1 и: 23), текст.
	>> минута   := Двуцифрен-формат приложи-цяло: (Число между: 1 и: 59), текст.
	>> секунда   := Двуцифрен-формат приложи-цяло: (Число между: 1 и: 59), текст.
	>> дата-час := ['YYYY-MM-DD HH:II:SS'].	
	дата-час
		YYYY: година,
		MM: месец,
		DD: ден,
		HH: час,
		II: минута,
		SS: секунда.
	>> параметри-за-търсене :=
	бд заявка: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: дата-час),
	извлечи: { :редица
		(редица mydatetime = дата-час) невярно: {
			тази-задача грешка: (
				['Очаквано: <expected>, получено: <observation>']
				<expected>: дата-час,
				<observation>: редица mydatetime
			).
		}.
	
	}.
	брояч добави: 1.
} * 100.

# Дата
{
	>> година     := Число между: 1995 и: 2050, текст.
	>> месец    := Двуцифрен-формат приложи-цяло: (Число между: 1 и: 12), текст.
	>> ден      := Двуцифрен-формат приложи-цяло: (Число между: 1 и: 28), текст.
	>> дата     := ['YYYY-MM-DD'].
	дата
		YYYY: година,
		MM: месец,
		DD: ден.
	>> параметри-за-търсене :=
	бд заявка: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: дата),
	извлечи: { :редица
		(редица mydate = дата) невярно: {
			тази-задача грешка: (
				['Очаквано: <expected>, получено: <observation>']
				<expected>: дата,
				<observation>: редица mydate
			).
		}.
	}.
	брояч добави: 1.
} * 100.


# Час
{
	>> час     := Двуцифрен-формат приложи-цяло: (Число между: 1 и: 23), текст.
	>> минута   := Двуцифрен-формат приложи-цяло: (Число между: 1 и: 59), текст.
	>> секунда   := Двуцифрен-формат приложи-цяло: (Число между: 1 и: 59), текст.
	>> време := ['HH:II:SS'].
	време
		HH: час,
		II: минута,
		SS: секунда.
	>> параметри-за-търсене :=
	бд заявка: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: време),
	извлечи: { :редица
		(редица mytime = време) невярно: {
			тази-задача грешка: (
				['Очаквано: <expected>, получено: <observation>']
				<expected>: дата-час,
				<observation>: редица mytime
			).
		}.
	}.
	брояч добави: 1.
} * 100.


# Текстове (varchar/text)
>> str1 := Списък нов запълни: 100000 с: ['x'], съедини: [''].
{
	>> str2 := Трезор токен: 40.
	>> параметри-за-търсене :=
	бд заявка: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	извлечи: { :редица
		(редица str1 = str1 и: редица str2 = str2) невярно: {
			тази-задача грешка: (
				['Очаквано: <expected>, получено: <observation>']
				<expected>: дата-час,
				<observation>: редица mytime
			).
		}.
	}.
	брояч добави: 1.
} * 100.


# Числа
{
	>> n1  := Число между: 1 и: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 от-текст: ['9223372036854775807'] ) -
		( Int64 от-текст: ['99999'] ) +
		( Int64 от-текст: n1 текст )
	).
	>> параметри-за-търсене :=
	бд заявка: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	извлечи: { :редица
		(редица n1 = n1) невярно: {
			тази-задача грешка: (
				['Очаквано: <expected>, получено: <observation>']
				<expected>: n1,
				<observation>: редица n1
			).
		}.
		(редица n2 = n2) невярно: {
			тази-задача грешка: (
				['Очаквано: <expected>, получено: <observation>']
				<expected>: n1,
				<observation>: редица n2
			).
		}.
		(редица n3 = n2 закръгли) невярно: {
			тази-задача грешка: (
				['Очаквано: <expected>, получено: <observation>']
				<expected>: n1,
				<observation>: редица n3
			).
		}.
		(редица big = big) невярно: {
			тази-задача грешка: (
				['Очаквано: <expected>, получено: <observation>']
				<expected>: big,
				<observation>: редица big
			).
		}.
		
	}.
	брояч добави: 1.
} * 100.


Изход пиши: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: брояч
), нов-ред.