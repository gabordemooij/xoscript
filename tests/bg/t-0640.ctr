
Server init.
Изход пиши: ['Тест на базата данни'], нов-ред.

>> бд := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'], 
	парола: ['pass123'],
	име-на-база: ['xobase'],
	свържи-се.

>> параметри-за-търсене :=
бд заявка: ['SELECT UNHEX('CAFE') AS blobby'],
извлечи: { :редица
	Изход пиши: ( редица blobby от: 0 дължина: 2 ), нов-ред.
	редица blobby освободи.
}.
