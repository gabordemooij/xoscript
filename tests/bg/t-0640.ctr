
Server init.
Изход пиши: ['Database test'], нов-ред.

>> db := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'], 
	парола: ['pass123'],
	име-на-база: ['xobase'],
	свържи-се.

>> параметри-за-търсене :=
db заявка: ['SELECT UNHEX('CAFE') AS blobby'],
извлечи: { :row
	Изход пиши: ( row blobby от: 0 дължина: 2 ), нов-ред.
	row blobby освободи.
}.
