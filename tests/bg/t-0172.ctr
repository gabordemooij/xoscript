

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програма управление-на-паметта: 0.

>> a := Списък ← ['hello'] ; ['world'] ; Вярно ; Нищо ; 666.
>> b := a от: 2 дължина: 2.
Изход пиши: ( b съедини: ['|'] ), пиши: b брой.

Програма почисти.
usedMemory1 := (Програма памет ? 0).


a := Списък ← ['hello'] ; ['world'] ; Вярно ; Нищо ; 666.
b := a от: 2 дължина: 2.
Изход пиши: ( b съедини: ['|'] ), пиши: b брой.


Програма почисти.
usedMemory2 := (Програма памет ? 0).


a := Списък ← ['hello'] ; ['world'] ; Вярно ; Нищо ; 666.
b := a от: 2 дължина: 2.
Изход пиши: ( b съедини: ['|'] ), пиши: b брой.


Програма почисти.
usedMemory3 := (Програма памет ? 0).



( usedMemory1 = usedMemory2 и: usedMemory1 = usedMemory3, и: usedMemory2 = usedMemory3 ) вярно: {
	Изход пиши: ['No memory leaks here'].
}, невярно: {
	Изход пиши: ['Leaking memory...'].
}.
