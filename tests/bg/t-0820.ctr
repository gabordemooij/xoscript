# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Шаблон нов: pattern.
	p съвпадение: subject изпълни: { :m :g
		Изход пиши: g брой, пиши: [' '], пиши: (g съедини: ['|']), нов-ред. <- m.
	}.
}.
show приложи: ['(a)|(b)'] и: ['b'].
show приложи: ['(a)|(b)'] и: ['a'].
show приложи: ['(x)?y'] и: ['y'].
show приложи: ['(x)?(y)(z)?'] и: ['xy'].
