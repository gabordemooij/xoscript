# група, която не е част от съвпадението, не трябва да предизвиква срив и трябва да запази номерата на групите
Server init.
>> покажи := { :рег-израз :subject
	>> p := Шаблон нов: рег-израз.
	p съвпадение: subject изпълни: { :m :g
		Изход пиши: g брой, пиши: [' '], пиши: (g съедини: ['|']), нов-ред.
		<- m.
	}.
}.
покажи приложи: ['(a)|(b)'] и: ['b'].
покажи приложи: ['(a)|(b)'] и: ['a'].
покажи приложи: ['(x)?y'] и: ['y'].
покажи приложи: ['(x)?(y)(z)?'] и: ['xy'].
