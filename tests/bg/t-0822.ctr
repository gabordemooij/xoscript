# по-малко параметри от местата за тях трябва да дадат грешка, а не четене след свързванията
Server init.

>> бд := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'],
	парола: ['pass123'],
	име-на-база: ['xobase'],
	свържи-се.

>> параметри-за-търсене := бд заявка: ['SELECT ? AS a, ? AS b, ? AS c'].
параметри-за-търсене параметри: (Списък нов ; ['1']).
{ параметри-за-търсене извлечи: { :редица Изход пиши: редица, нов-ред. }. } прихвани: { :e Изход пиши: e, нов-ред. }, стартирай.

>> параметри-за-търсене := бд заявка: ['SELECT ? AS a'].
{ параметри-за-търсене извлечи: { :редица Изход пиши: редица, нов-ред. }. } прихвани: { :e Изход пиши: e, нов-ред. }, стартирай.

# правилният брой все още работи, повече параметри се пренебрегват както преди
>> параметри-за-търсене := бд заявка: ['SELECT ? AS a, ? AS b'].
параметри-за-търсене параметри: (Списък нов ; ['1'] ; ['2']).
параметри-за-търсене извлечи: { :редица Изход пиши: (редица на: ['a']), пиши: (редица на: ['b']), нов-ред. }.
параметри-за-търсене параметри: (Списък нов ; ['1'] ; ['2'] ; ['3']).
параметри-за-търсене извлечи: { :редица Изход пиши: (редица на: ['a']), пиши: (редица на: ['b']), нов-ред. }.
