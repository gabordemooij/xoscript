# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'],
	парола: ['pass123'],
	име-на-база: ['xobase'],
	свържи-се.

>> параметри-за-търсене := db заявка: ['SELECT ? AS a, ? AS b, ? AS c'].
параметри-за-търсене параметри: (Списък нов ; ['1']).
{ параметри-за-търсене извлечи: { :row Изход пиши: row, нов-ред. }. } прихвани: { :e Изход пиши: e, нов-ред. }, стартирай.

>> параметри-за-търсене := db заявка: ['SELECT ? AS a'].
{ параметри-за-търсене извлечи: { :row Изход пиши: row, нов-ред. }. } прихвани: { :e Изход пиши: e, нов-ред. }, стартирай.

# the right number still works, more parameters are ignored as before
>> параметри-за-търсене := db заявка: ['SELECT ? AS a, ? AS b'].
параметри-за-търсене параметри: (Списък нов ; ['1'] ; ['2']).
параметри-за-търсене извлечи: { :row Изход пиши: (row на: ['a']), пиши: (row на: ['b']), нов-ред. }.
параметри-за-търсене параметри: (Списък нов ; ['1'] ; ['2'] ; ['3']).
параметри-за-търсене извлечи: { :row Изход пиши: (row на: ['a']), пиши: (row на: ['b']), нов-ред. }.
