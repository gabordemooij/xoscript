>> q := Списък ← 1 ; 2 ; 3.
{ q ? ['1']. } прихвани: { Изход пиши: ['хванато!'], нов-ред. }, стартирай.
{ q ? Вярно. } прихвани: { Изход пиши: ['хванато!'], нов-ред. }, стартирай.
{ q ? Невярно. } прихвани: { Изход пиши: ['хванато!'], нов-ред. }, стартирай.
{ q ? Нищо. } прихвани: { Изход пиши: ['хванато!'], нов-ред. }, стартирай.
{ q ? (Списък нов). } прихвани: { Изход пиши: ['хванато!'], нов-ред. }, стартирай.
{ q ? (Обект нов). } прихвани: { Изход пиши: ['хванато!'], нов-ред. }, стартирай.
{ q ? ({ ['Празно']. }). } прихвани: { Изход пиши: ['хванато!'], нов-ред. }, стартирай.
Изход пиши: ['хванах ги всички'], нов-ред.
