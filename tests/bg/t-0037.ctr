>> a := 3.
>> b := a копирай.
a извади: 1.
Изход пиши: [' a = '] + a.
Изход пиши: [' b = '] + b.
a := 3.
b := a + 4.
Изход пиши: [' a = '] + a.
Изход пиши: [' b = '] + b.
>> x := 3.
>> y := x копирай.
x добави: 10.
y извади: 1.
Изход пиши: [' x = '] + x.
Изход пиши: [' y = '] + y.
>> q := Обект нов.
q при: ['setProperty:'] изпълни: { :x
	свой св := x.
}.
q при: ['вземи-свойство'] изпълни: { <- свой св.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Изход пиши: [' p = '] + (p вземи-свойство).
