>> Гълтач := Обект нов.
Гълтач при: ['нов'] изпълни: {
	свой str := [''].
}.
Гълтач научи: ['nieuw'] означава: ['нов'].
Гълтач при: ['отговори:'] изпълни: { :blah
		(свой str ≠ ['']) вярно: {
			свой str добави-в-края: [' '].
		}.
		свой str добави-в-края: blah.
}.
Гълтач при: ['отговори:и:'] изпълни: { :blah :blahah
		(свой str ≠ ['']) вярно: {
			свой str добави-в-края: [' '].
		}.
		(blah дължина > 1) вярно: {
			свой str добави-в-края: (blah от: 0 дължина: (blah дължина - 1)).
		}, иначе: {
			свой str добави-в-края: blah.
		}.
		свой str добави-в-края: [' '].
		свой str добави-в-края: blahah.
}.
Гълтач при: ['получи'] изпълни: {
	>> буфер := свой str.
	свой str := ['']. <- буфер.
}.


>> параметри-за-търсене := Гълтач нов
	select: ['*'],
	from
		users 
	къде 
		user_id=: 1.

Изход пиши: параметри-за-търсене получи, нов-ред.
