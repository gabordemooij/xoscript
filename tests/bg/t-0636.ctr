# test url parsing

Server init.
>> url := URL от: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Изход пиши: ['scheme = '] + url схема, нов-ред.
Изход пиши: ['host = '] + url хост, нов-ред.
Изход пиши: ['port = '] + url порт, нов-ред.
Изход пиши: ['path = '] + url път, нов-ред.
Изход пиши: ['query = '] + url параметри-за-търсене, нов-ред.
Изход пиши: ['fragment = '] + url фрагмент, нов-ред.
