# тест на разбор на URL

Server init.
>> url := URL от: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Изход пиши: ['схема = '] + url схема, нов-ред.
Изход пиши: ['хост = '] + url хост, нов-ред.
Изход пиши: ['порт = '] + url порт, нов-ред.
Изход пиши: ['път = '] + url път, нов-ред.
Изход пиши: ['заявка = '] + url параметри-за-търсене, нов-ред.
Изход пиши: ['фрагмент = '] + url фрагмент, нов-ред.
