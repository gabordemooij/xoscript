>> makeAdder := { :x
	>> f := { :y <- (свой x + y). } задай: ['x'] стойност: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i свой q постави: (свой f приложи: (свой q ? i)) на: i. } 
	задай: ['q'] стойност: array,
	задай: ['f'] стойност: func.
	{ :i mapping приложи: i. } × (array брой).
}.

>> a := Списък ← 1; 2; 3.
mapper приложи: a и: (makeAdder приложи: 100).
Изход пиши: (a позиция: 0), нов-ред.
Изход пиши: (a ? 1), нов-ред.
Изход пиши: (a ? 2), нов-ред.
