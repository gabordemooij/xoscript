>> създай-събирач := { :x
	>> f := { :y <- (свой x + y). } задай: ['x'] стойност: x. <- f.
}.
>> преобразувател := { :масив :фн
	>> изобразяване := { :i свой q постави: (свой f приложи: (свой q ? i)) на: i. } 
	задай: ['q'] стойност: масив,
	задай: ['f'] стойност: фн.
	{ :i изобразяване приложи: i. } × (масив брой).
}.

>> a := Списък ← 1; 2; 3.
преобразувател приложи: a и: (създай-събирач приложи: 100).
Изход пиши: (a позиция: 0), нов-ред.
Изход пиши: (a ? 1), нов-ред.
Изход пиши: (a ? 2), нов-ред.
