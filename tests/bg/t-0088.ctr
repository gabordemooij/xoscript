
>> смехът-на-дядо-коледа := ['ho'].
>> смях := [''].
{ смях := смях + смехът-на-дядо-коледа. } × 3.
Изход пиши: смях, нов-ред.

>> заключено := Невярно.
>> сигурност := Вярно.
сигурност вярно: { заключено := Вярно. }.
Изход пиши: заключено, нов-ред.

>> n := 7.
(Вярно) вярно: { n := 9. }.
Изход пиши: n.
