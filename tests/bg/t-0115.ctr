{
	тази-задача грешка: ['Не се проваляй.'].
	неизвестен направи-нещо.
} прихвани: {
	Изход пиши: ['Хванато!'].
}, стартирай.

{
	тази-задача грешка: ['Не се проваляй.'].
	свой неизвестен направи-нещо.
} прихвани: {
	Изход пиши: ['Хванато!'].
}, стартирай.

{
	тази-задача грешка: ['Не се проваляй.'].
	неизвестен := 122.
} прихвани: {
	Изход пиши: ['Хванато!'].
}, стартирай.


{
	тази-задача грешка: ['Не се проваляй.'].
	Вярно прекъсни.
	Изход пиши: ['ПРОВАЛ'].
} прихвани: {
	Изход пиши: ['Хванато!'].
}, стартирай.

{
	{
		тази-задача грешка: ['Не се проваляй.'].
		Вярно прекъсни.
		Изход пиши: ['ПРОВАЛ'].
	} прихвани: { :x
		(x = ['Не се проваляй.']) вярно: { тази-задача грешка: ['Вложено хванато!']. }.
	}, стартирай.
} прихвани: { :e
	Изход пиши: e.
}, стартирай.
