{
	тази-задача грешка: ['Dont fail.'].
	unknown doSomething.
} прихвани: {
	Изход пиши: ['Caught!'].
}, стартирай.

{
	тази-задача грешка: ['Dont fail.'].
	свой unknown doSomething.
} прихвани: {
	Изход пиши: ['Caught!'].
}, стартирай.

{
	тази-задача грешка: ['Dont fail.'].
	unknown := 122.
} прихвани: {
	Изход пиши: ['Caught!'].
}, стартирай.


{
	тази-задача грешка: ['Dont fail.'].
	Вярно прекъсни.
	Изход пиши: ['FAIL'].
} прихвани: {
	Изход пиши: ['Caught!'].
}, стартирай.

{
	{
		тази-задача грешка: ['Dont fail.'].
		Вярно прекъсни.
		Изход пиши: ['FAIL'].
	} прихвани: { :x
		(x = ['Dont fail.']) вярно: { тази-задача грешка: ['Nested Caught!']. }.
	}, стартирай.
} прихвани: { :e
	Изход пиши: e.
}, стартирай.
