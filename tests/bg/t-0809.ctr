# backslashes must survive code serialization, strings must not end early
>> стойности := Списък нов
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

стойности всеки: { :i :value
	>> d := Речник нов.
	d постави: value на: ['k'].
	>> r := d код обект.
	Изход пиши: r брой, нов-ред.
	Изход пиши: ( (r на: ['k']) = value ), нов-ред.
}.
