# тест на операции със списъци


>> торти := Списък ←
	['apple'] ;
	['боровинка'] ;
	['шоколад'] ;
	['сирене'].


>> купи := торти замени: 1 дължина: 2 с: ( Списък ← ['канела'] ; ['ананас'] ).
Изход пиши: (купи съедини: [',']), нов-ред.


>> купи := торти замени: 1 дължина: 12 с: ( Списък ← ['канела'] ; ['ананас'] ).
Изход пиши: (купи съедини: [',']), нов-ред.


>> купи := торти замени: 2 дължина: 10 с: ( Списък нов ).
Изход пиши: (купи съедини: [',']), нов-ред.


>> купи := торти замени: 0 дължина: 1 с: ( Списък нов ).
Изход пиши: (купи съедини: [',']), нов-ред.


>> купи := торти замени: ['0'] дължина: ['1'] с: ['x'].
Изход пиши: (купи съедини: [',']), нов-ред.
