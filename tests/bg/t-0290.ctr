# test list operations


>> cakes := Списък ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes замени: 1 дължина: 2 с: ( Списък ← ['cinnamon'] ; ['pineapple'] ).
Изход пиши: (buy съедини: [',']), нов-ред.


>> buy := cakes замени: 1 дължина: 12 с: ( Списък ← ['cinnamon'] ; ['pineapple'] ).
Изход пиши: (buy съедини: [',']), нов-ред.


>> buy := cakes замени: 2 дължина: 10 с: ( Списък нов ).
Изход пиши: (buy съедини: [',']), нов-ред.


>> buy := cakes замени: 0 дължина: 1 с: ( Списък нов ).
Изход пиши: (buy съедини: [',']), нов-ред.


>> buy := cakes замени: ['0'] дължина: ['1'] с: ['x'].
Изход пиши: (buy съедини: [',']), нов-ред.
