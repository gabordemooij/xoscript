# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Трезор 
	хеш-на-парола: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Трезор 
	хеш-на-парола: hash провери: a1.
	# fail 
>> b := Трезор
	хеш-на-парола: hash провери: a2.
	# ok!

Изход пиши: a, нов-ред.
Изход пиши: b, нов-ред.

