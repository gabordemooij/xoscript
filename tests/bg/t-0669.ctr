# Хеширане на пароли
Server init.

# Потребителят задава парола
>> пар := ['pass123'].

# Съхранявате я така
>> хеширане := Трезор 
	хеш-на-парола: пар.

# След това потребителят влиза
# Опит 1
>> a1 := ['abcd123'].
# Опит 2
>> a2 := ['pass123'].

# Проверка
>> a := Трезор 
	хеш-на-парола: хеширане провери: a1.
	# неуспех 
>> b := Трезор
	хеш-на-парола: хеширане провери: a2.
	# добре!

Изход пиши: a, нов-ред.
Изход пиши: b, нов-ред.

