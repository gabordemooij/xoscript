# ключове и подписи на трезора, които се декодират твърде дълги, не трябва да препълват стека
Server init.

>> ключове := Трезор генерирай-ключове.
>> тк := ключове първи.
>> пк := ключове последен.
>> подп := Трезор подпиши: ['abc'] с: тк.

# 88 знака без padding се декодират до 66 байта
>> дълъг := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 знака без padding се декодират до 33 байта
>> кратък := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Трезор подпиши: ['abc'] с: дълъг. } прихвани: { :e
	Изход пиши: e, нов-ред.
}, стартирай.

{ Трезор провери: ['abc'] подпис: дълъг с: пк. } прихвани: { :e
	Изход пиши: e, нов-ред.
}, стартирай.

{ Трезор провери: ['abc'] подпис: подп с: кратък. } прихвани: { :e
	Изход пиши: e, нов-ред.
}, стартирай.
