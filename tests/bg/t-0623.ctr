

>> g  := Server нов.
>> v  := Трезор нов.
>> добре := 0.

>> тайни := Списък нов ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> пароли := тайни копирай.
пароли всеки: { :i :p
	тайни всеки: { :n :s
		{
			>> шифровано := v шифровай: s ключ: p.
			>> дешифровано := v дешифровай: шифровано ключ: p.
			(дешифровано = s) вярно: {
				добре добави: 1.
			}, иначе: {
				Изход пиши: ['неуспешно шифроване/дешифроване: '], нов-ред.
				Изход пиши: s, нов-ред.
				Изход пиши: ['шифровано: '] + шифровано, нов-ред.
				Изход пиши: ['дешифровано: '] + шифровано, нов-ред.
				Програма край.
			}.
		} прихвани: { :грш
			(s = [''] или: p = ['']) вярно: {
				добре добави: 1.
			}, иначе: {
				Изход пиши: грш, нов-ред.
				Програма край.
			}.
		}, стартирай.
	}.
}.

Изход пиши: ( добре + [' шифровки със сейф са тествани.'] ), нов-ред.