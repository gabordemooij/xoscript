>> карта1 := Речник нов.
>> ключ1 := Списък нов.
>> ключ2 := Списък нов.

карта1
	постави: ['hello'] на: ключ1,
	постави: ['world'] на: ключ2.


Изход
	пиши: ['Map #1 contains: '] + (карта1 на: ключ1),
	пиши: [' и '] + (карта1 на: ключ2), нов-ред.

>> Масив-с-ключове := Списък нов.
Масив-с-ключове при: ['към-текст'] изпълни: { <- (себе брой) към-текст.
}.

>> map2 := Речник нов.
ключ1 := Масив-с-ключове нов.
ключ2 := Масив-с-ключове нов.

ключ1 добави-в-края: 1.

map2
	постави: ['hello'] на: ключ1,
	постави: ['world'] на: ключ2.

Изход
	пиши: ['Map #2 contains: '] + (map2 на: ключ1),
	пиши: [' и '] + (map2 на: ключ2), нов-ред.
