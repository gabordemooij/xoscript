>> map1 := Речник нов.
>> key1 := Списък нов.
>> key2 := Списък нов.

map1
	постави: ['hello'] на: key1,
	постави: ['world'] на: key2.


Изход
	пиши: ['Map #1 contains: '] + (map1 на: key1),
	пиши: [' and '] + (map1 на: key2), нов-ред.

>> KeyeableArray := Списък нов.
KeyeableArray при: ['toString'] изпълни: { <- (себе брой) toString.
}.

>> map2 := Речник нов.
key1 := KeyeableArray нов.
key2 := KeyeableArray нов.

key1 добави-в-края: 1.

map2
	постави: ['hello'] на: key1,
	постави: ['world'] на: key2.

Изход
	пиши: ['Map #2 contains: '] + (map2 на: key1),
	пиши: [' and '] + (map2 на: key2), нов-ред.
