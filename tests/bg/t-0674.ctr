# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> път := ['/tmp/dat.csv'].
>> csv := Файл нов: път.
csv пиши: s.

# accepts CRLF LF CR, varying row length
csv разделител: [';'] кавичка: ['"'] редове: { :line
	Програма почисти.
	Изход пиши: line, нов-ред.
	Програма почисти.
}.

# unequal lines
s добави-в-края: ['\njustone'].
csv пиши: s.
{
	csv разделител: [';'] кавичка: ['"'] редове: { :line
		Изход пиши: line, нов-ред.
	}.
} прихвани: { :e 
	Изход пиши: e, нов-ред.
}, стартирай.

# invalid format
s := ['"he"llo";world'].
csv пиши: s.
{
	csv разделител: [';'] кавичка: ['"'] редове: { :line
		Изход пиши: line, нов-ред.
	}.
} прихвани: { :e 
	Изход пиши: e, нов-ред.
}, стартирай.
