# нормален случай
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> път := ['/tmp/dat.csv'].
>> csv := Файл нов: път.
csv пиши: s.

# приема CRLF LF CR, различна дължина на редовете
csv разделител: [';'] кавичка: ['"'] редове: { :line
	Програма почисти.
	Изход пиши: line, нов-ред.
	Програма почисти.
}.

# неравни редове
s добави-в-края: ['\njustone'].
csv пиши: s.
{
	csv разделител: [';'] кавичка: ['"'] редове: { :line
		Изход пиши: line, нов-ред.
	}.
} прихвани: { :e 
	Изход пиши: e, нов-ред.
}, стартирай.

# невалиден формат
s := ['"he"llo";world'].
csv пиши: s.
{
	csv разделител: [';'] кавичка: ['"'] редове: { :line
		Изход пиши: line, нов-ред.
	}.
} прихвани: { :e 
	Изход пиши: e, нов-ред.
}, стартирай.
