# test qualifiers

>> $ := Обект нов.

$ при: ['отговори:'] изпълни: { :x
	
	>> operation := x знак: 0.
	>> valuta := x знак: 1.
	>> money := x изместване: 2.
	
	>> amount := 0.

	( operation = ['+'] ) вярно: {
		( valuta = ['£'] ) вярно: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Изход пиши: x, нов-ред.


>> Fruit := Обект нов.

Fruit при: ['нов'] изпълни: {
	>> f := себе нов.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit при: ['apples:'] изпълни: { :a свой apples := a. }.
Fruit при: ['oranges:'] изпълни: { :p свой oranges := p. }.
Fruit при: ['apples'] изпълни: { <- свой apples. }.
Fruit при: ['oranges'] изпълни: { <- свой oranges. }.

Fruit при: ['+'] изпълни: { :f
	
	>> n := Fruit нов.
	f добави: 1.
	
	n apples: (f apples + свой apples).
	n oranges:  (f oranges  + свой oranges). <- n.
}.

Fruit при: ['текст'] изпълни: { <- ( свой apples текст + [' apples and '] + свой oranges + [' oranges'] ).
}.

Число при: ['apples'] изпълни: { <- ((Fruit нов) apples: себе).
}.

Число при: ['apple'] изпълни: { <- ((Fruit нов) apples: себе).
}.

Число при: ['oranges'] изпълни: { <- ((Fruit нов) oranges: себе).
}.




Изход пиши: (1 apple + 3 oranges + 4 apples), нов-ред.


Текст при: ['twice'] изпълни: { <- ((себе текст) + (себе текст)).
}.



Изход пиши: ['❤❤❤'] twice.



