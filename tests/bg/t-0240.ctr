# тест на определения

>> $ := Обект нов.

$ при: ['отговори:'] изпълни: { :x
	
	>> операция := x знак: 0.
	>> валута := x знак: 1.
	>> пари := x изместване: 2.
	
	>> количество := 0.

	( операция = ['+'] ) вярно: {
		( валута = ['£'] ) вярно: { количество := 1.28 × пари. }.
	}. <- количество.
}.



>> x := $ +£20.

Изход пиши: x, нов-ред.


>> Плод := Обект нов.

Плод при: ['нов'] изпълни: {
	>> f := себе нов.
	f apples: 0.
	f oranges: 0. <- f.
}.

Плод при: ['apples:'] изпълни: { :a свой ябълки := a. }.
Плод при: ['oranges:'] изпълни: { :p свой портокали := p. }.
Плод при: ['ябълки'] изпълни: { <- свой ябълки. }.
Плод при: ['портокали'] изпълни: { <- свой портокали. }.

Плод при: ['+'] изпълни: { :f
	
	>> n := Плод нов.
	f добави: 1.
	
	n apples: (f ябълки + свой ябълки).
	n oranges:  (f портокали  + свой портокали). <- n.
}.

Плод при: ['текст'] изпълни: { <- ( свой ябълки текст + [' ябълки и '] + свой портокали + [' портокала'] ).
}.

Число при: ['ябълки'] изпълни: { <- ((Плод нов) apples: себе).
}.

Число при: ['apple'] изпълни: { <- ((Плод нов) apples: себе).
}.

Число при: ['портокали'] изпълни: { <- ((Плод нов) oranges: себе).
}.




Изход пиши: (1 apple + 3 портокали + 4 ябълки), нов-ред.


Текст при: ['два-пъти'] изпълни: { <- ((себе текст) + (себе текст)).
}.



Изход пиши: ['❤❤❤'] два-пъти.



