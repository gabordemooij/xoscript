>> Point := Обект нов.
Point при: ['x-coordinate:'] изпълни: { :x свой x := x. }.
Point при: ['y-coordinate:'] изпълни: { :y свой y := y. }.
Point при: ['x-coordinate']  изпълни: { <- свой x копирай. }.
Point при: ['y-coordinate']  изпълни: { <- свой y копирай. }.

Point при: ['='] изпълни: { :other <- ( свой x = other x-coordinate
		 и: свой y = other y-coordinate ).
}.

>> pier := Point нов x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point нов x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point нов x-coordinate: 5, y-coordinate: 6.

Изход пиши: pier = town-hall, нов-ред.
Изход пиши: pier = restaurant, нов-ред.
