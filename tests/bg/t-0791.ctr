Server init.

>> БД := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'],
	парола: ['pass123'],
	име-на-база: ['xobase'],
	свържи-се.
	
>> SQL := ['SELECT "hello" AS "world" '].

# ръчно създаване на заявка
>> параметри-за-търсене := Maria-Заявка нов: SQL.

# задаване на базата данни
параметри-за-търсене база-данни: БД.

параметри-за-търсене извлечи: { :редица
	Изход пиши: редица world, нов-ред.
}.
