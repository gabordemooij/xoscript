Server init.

>> DB := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'],
	парола: ['pass123'],
	име-на-база: ['xobase'],
	свържи-се.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> параметри-за-търсене := Maria-Заявка нов: SQL.

# set database
параметри-за-търсене база-данни: DB.

параметри-за-търсене извлечи: { :row
	Изход пиши: row world, нов-ред.
}.
