Изход пиши: ['Test object'], нов-ред.
>> a := Обект нов. 

a при: ['item:'] изпълни: { :логически
	свой логически := логически. 
}.

a при: ['item'] изпълни: { <- свой логически.
}.

a item: Невярно.

Изход пиши: a item, нов-ред.

>> old-bool-address := a item прототип адрес-в-паметта.
a save-as: ['/tmp/a.bin'].
Изход пиши: ['========== RELOADING SNAP:'], нов-ред.

>> b := Обект load-from: ['/tmp/a.bin'].

(b item прототип адрес-в-паметта = old-bool-address) вярно: {
	Изход пиши: ['Object link re-attached.'], нов-ред.
}.

Изход пиши: b item, нов-ред.
