# Test utf8 sanitizer
Server init.

>> utf8cases := Речник нов
	# ASCII only
	постави: ( Списък нов ; 65 ; 65 ; 65 ; 65 ; 0 ) на: ['AAAA'],
	# valid 2 byte sequence
	постави: ( Списък нов ; 194 ; 162 ; 0 ) на: ['¢'],
	# Valid 3-byte UTF-8
    постави: ( Списък нов ; 226 ; 130 ; 172 ; 0 ) на: ['€'],
	# Valid 4-byte UTF-8
    постави: ( Списък нов ; 240 ; 144 ; 141 ; 136 ; 0 ) на: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    постави: ( Списък нов ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) на: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    постави: ( Списък нов ; 65 ; 193 ; 129 ; 0 ) на: ['A?'],
	# Invalid first byte (0xFF)
    постави: ( Списък нов ; 255 ; 0 ) на: ['?'],
	# Incomplete multi-byte sequence at end
    постави: ( Списък нов ; 66 ; 226 ; 0 ) на: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    постави: ( Списък нов ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) на: ['A€?𐍈B'].
	 
utf8cases всеки: { :key :value
	>> blob := Blob нов: value брой, bytes: value.
	>> str := blob текст.
	(str = key) вярно: {
		Изход пиши: ['OK'], нов-ред.
	}, иначе: {
		Изход пиши: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, нов-ред.
	}.
	blob освободи.
}.
