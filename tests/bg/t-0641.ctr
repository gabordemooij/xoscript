# Тест на utf8 почистване
Server init.

>> utf8-случаи := Речник нов
	# Само ASCII
	постави: ( Списък нов ; 65 ; 65 ; 65 ; 65 ; 0 ) на: ['AAAA'],
	# валидна 2-байтова последователност
	постави: ( Списък нов ; 194 ; 162 ; 0 ) на: ['¢'],
	# Валиден 3-байтов UTF-8
    постави: ( Списък нов ; 226 ; 130 ; 172 ; 0 ) на: ['€'],
	# Валиден 4-байтов UTF-8
    постави: ( Списък нов ; 240 ; 144 ; 141 ; 136 ; 0 ) на: ['𐍈'],
	# Невалиден байт за продължение в последователността E2 28 AC -> начало на 3b посл. + 28 грешен байт + AC байт за продължение, но принадлежат към една и съща грешка
    постави: ( Списък нов ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) на: ['A?A'],
	# Свръхдълго кодиране на ASCII 'A' (трябва да стане ?),
    постави: ( Списък нов ; 65 ; 193 ; 129 ; 0 ) на: ['A?'],
	# Невалиден първи байт (0xFF)
    постави: ( Списък нов ; 255 ; 0 ) на: ['?'],
	# Непълна многобайтова последователност в края
    постави: ( Списък нов ; 66 ; 226 ; 0 ) на: ['B?'],
    # Празен текст
    #put: ( List new ) at: [''],
	# Няколко смесени последователности
    постави: ( Списък нов ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) на: ['A€?𐍈B'].
	 
utf8-случаи всеки: { :key :value
	>> blob := Blob нов: value брой, bytes: value.
	>> str := blob текст.
	(str = key) вярно: {
		Изход пиши: ['OK'], нов-ред.
	}, иначе: {
		Изход пиши: ['UTF8 почистването не успя за: '] + key + [' получено: '] + str, нов-ред.
	}.
	blob освободи.
}.
