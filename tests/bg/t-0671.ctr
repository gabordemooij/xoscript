# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Трезор генерирай-ключове.

# private (secret) key
>> sk := keys първи.

# public key
>> pk := keys последен.

# sign a message
>> sig := Трезор подпиши: ['abc'] с: sk.

# check message (ok)
Изход пиши: ( 
	Трезор
		провери: ['abc'] 
		подпис: sig 
		с: pk 
), нов-ред.

# check message (fail)
Изход пиши: ( 
	Трезор 
		провери: ['abd'] 
		подпис: sig 
		с: pk 
), нов-ред.