# публичен ключ (за защита на API и др.)
Server init.

# генериране на ключове
>> ключове := Трезор генерирай-ключове.

# частен (таен) ключ
>> тк := ключове първи.

# публичен ключ
>> пк := ключове последен.

# подписване на съобщение
>> подп := Трезор подпиши: ['abc'] с: тк.

# проверка на съобщението (добре)
Изход пиши: ( 
	Трезор
		провери: ['abc'] 
		подпис: подп 
		с: пк 
), нов-ред.

# проверка на съобщението (неуспех)
Изход пиши: ( 
	Трезор 
		провери: ['abd'] 
		подпис: подп 
		с: пк 
), нов-ред.