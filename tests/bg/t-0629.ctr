# тест на базата данни
# вижте примера server.xo за нужната конфигурация

Server init.
Изход пиши: ['Тест на базата данни'], нов-ред.

>> бд := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'], парола: ['pass123'], име-на-база: ['xobase'], свържи-се.

Изход пиши: ['Можем ли да се свържем? '] + бд свързан?, нов-ред.

>> параметри-за-търсене := бд заявка: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], параметри: ( Списък нов ; ['abc'] ; 12.35 ; 6 ). # параметризирани заявки

{  параметри-за-търсене изпълни. бд потвърди. } прихвани: { :e бд отмени.  }, стартирай.

Изход пиши: ['Можем ли да вмъкнем? '] + ( параметри-за-търсене insert-id > 0 ), нов-ред.

>> Обк := Обект нов.
Обк при: ['извлечи-редове'] изпълни: {
	свой брой := 0.
	>> параметри-за-търсене :=
	бд заявка: ['SELECT * FROM book order by id desc limit 2'], 
	извлечи: { :редица 
		свой брой добави: 1.
		Вярно прекъсни.
	}. # извличане на редове
	<- свой брой копирай.
}.

Изход пиши: ['Можем ли да направим заявка? '] + ( Обк извлечи-редове > 0 ), нов-ред.
