Число при: ['факториел'] изпълни: {
	>> общо := 1.
	{ :индекс общо умножи-по: (себе - (индекс)). } × себе. <- общо.
}.
>> Принтер := Обект нов.
Принтер при: ['печатай:и:'] изпълни: { :x :y
	Изход пиши: ['a='] + x + [', b='] + y, нов-ред.
}.
>> a := 4.5. >> b := a закръгли-надолу.
Принтер печатай: a и: b.
a := 4. b := a факториел.
Принтер печатай: a и: b.
a := 4.5. b := a закръгли-нагоре.
Принтер печатай: a и: b.
