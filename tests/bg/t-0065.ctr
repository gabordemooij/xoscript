Число при: ['factorial'] изпълни: {
	>> total := 1.
	{ :index total умножи-по: (себе - (index)). } × себе. <- total.
}.
>> Printer := Обект нов.
Printer при: ['print:and:'] изпълни: { :x :y
	Изход пиши: ['a='] + x + [', b='] + y, нов-ред.
}.
>> a := 4.5. >> b := a закръгли-надолу.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
