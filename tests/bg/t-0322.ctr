

>> Матрьошка := Обект нов.
Матрьошка при: ['double:'] изпълни: { :тайна
	свой тайна := тайна × 2.
}.
Матрьошка при: ['нов:'] изпълни: { :тайна
	>> отговорът := Нищо.
	>> t := (тайна > 255).
	Изход пиши: (тайна + [' | '] + t), нов-ред.
	t вярно: {
		отговорът := тайна.
	}, иначе: {
		отговорът := Матрьошка рекурсивен нов: (себе double: тайна).
	}. <- отговорът.
}.

>> x := Матрьошка нов: 2.
