

>> Matryoshka := Обект нов.
Matryoshka при: ['double:'] изпълни: { :secret
	свой secret := secret × 2.
}.
Matryoshka при: ['нов:'] изпълни: { :secret
	>> answer := Нищо.
	>> t := (secret > 255).
	Изход пиши: (secret + [' | '] + t), нов-ред.
	t вярно: {
		answer := secret.
	}, иначе: {
		answer := Matryoshka рекурсивен нов: (себе double: secret).
	}. <- answer.
}.

>> x := Matryoshka нов: 2.
