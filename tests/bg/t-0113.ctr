Изход пиши: ['Продължаване на for-цикъл, Не - преди 6 и нагоре.'], нов-ред.
{ :i
	Изход пиши: (i + 1), нов-ред.
	((i + 1) > 4) продължи.
	Изход пиши: ['-'].
} × 10.

>> x := 0.
>> x-по-малко-от-10 := { <- ( x < 10 ). }.
Изход нов-ред.
Изход пиши: ['Продължаване на while-true, Не --> преди 5 и нагоре.'], нов-ред.
{
	Изход пиши: ['iteration #'] + x, нов-ред.
	x добави: 1.
	((x < 5) не) продължи.
	Изход пиши: ['-->'].
} докато: x-по-малко-от-10.
Изход нов-ред.
Изход пиши: ['Продължаване на while-false, Не - само преди 3.'], нов-ред.
{
	Изход пиши: ['iteration #'] + x, нов-ред.
	x извади: 1.
	(x = 3) продължи.
	Изход пиши: ['-'].
} докато: { <- ( x > 0). }.

Изход нов-ред.
Изход пиши: ['Продължаване на times-цикъл, Не ||| преди 3.'], нов-ред.
{ :i
	Изход пиши: ['iteration #'] + i, нов-ред.
	(i = 2) продължи.
	Изход пиши: ['|||'].
} × 5.

Изход нов-ред.

{ Вярно продължи. Изход пиши: ['не пиши това!'], нов-ред. } стартирай.

{ Вярно продължи. Изход пиши: ['не пиши това!'], нов-ред. } прихвани: { Изход пиши: ['Не улавяй това!']. }, стартирай.

Изход пиши: ['Тест на each-цикъл за Масив: 0, ... ,2'], нов-ред.
(Списък ← 1 ; 2 ; 3) преобразувай: { :i
	(i = 1) продължи.
	Изход пиши: ['iteration #'] + (i - 0), нов-ред.
}.

Изход пиши: ['Тест на each-цикъл за Карта: само c'], нов-ред.
>> m := Речник нов.
m постави: ['first'] на: ['a'], постави: ['second'] на: ['b'], постави: ['трети'] на: ['c'].
m всеки: { :k :v
	(k ≠ ['c']) продължи.
	Изход пиши: ['iteration'] + k + v, нов-ред.
}.

