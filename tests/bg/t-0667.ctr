# тест на Програма версия

# тази функционалност е изключена по подразбиране
Изход пиши: (
	Програма функционалност: 
	['RECURSIVE_STRINTPOL']
), нов-ред.


# но ако върнем времето назад
>> днес := Момент 
зона: ['CEST'],
от: ['2026-02-15 10:00:00'].
Програма версия: днес.

# тя ще бъде включена, както беше преди (отсега нататък)
Изход пиши: (
	Програма функционалност: 
	['RECURSIVE_STRINTPOL']
), нов-ред.