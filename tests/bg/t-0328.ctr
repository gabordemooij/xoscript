Програма управление-на-паметта: 4.

>> Doubler := Обект нов.
>> Multiplier := Обект нов.
Doubler при: ['double:and:'] изпълни: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier при: ['multiply:and:'] изпълни: { :x :y <- (x × y).
}.

Изход пиши: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), нов-ред.
