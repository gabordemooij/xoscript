Програма управление-на-паметта: 4.

>> Удвоител := Обект нов.
>> Умножител := Обект нов.
Удвоител при: ['удвои:и:'] изпълни: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Умножител при: ['умножи:и:'] изпълни: { :x :y <- (x × y).
}.

Изход пиши: (
	Удвоител удвои:
		(Удвоител удвои: 
			(Умножител умножи: 2 и: 3)
		и:
			(Умножител умножи: 3 и: 4)
		)
	и:
		(Удвоител удвои: 
			(Умножител умножи: 2 и: 3)
		и:
			(Умножител умножи: 3 и: 4)
		)
), нов-ред.
