

>> използвана-памет1 := 0.
>> използвана-памет2 := 0.
>> използвана-памет3 := 0.
>> използвана-памет4 := 0.

Програма управление-на-паметта: 0.

>> o := Обект нов.
>> o2 := Обект нов.
Изход пиши: o Нищо?, нов-ред.
Изход пиши: o тип, нов-ред.
Изход пиши: ( o равно: o ), нов-ред.
Изход пиши: ( o равно: o2 ), нов-ред.
Изход пиши: o аз-самият, нов-ред.
Изход пиши: ( o прави готово ), нов-ред.

Програма почисти.

използвана-памет1 := (Програма памет ? 0).


o := Обект нов.
o2 := Обект нов.
Изход пиши: o Нищо?, нов-ред.
Изход пиши: o тип, нов-ред.
Изход пиши: ( o равно: o ), нов-ред.
Изход пиши: ( o равно: o2 ), нов-ред.
Изход пиши: o аз-самият, нов-ред.
Изход пиши: ( o прави готово ), нов-ред.

Програма почисти.
използвана-памет2 := (Програма памет ? 0).


o := Обект нов.
o2 := Обект нов.
Изход пиши: o Нищо?, нов-ред.
Изход пиши: o тип, нов-ред.
Изход пиши: ( o равно: o ), нов-ред.
Изход пиши: ( o равно: o2 ), нов-ред.
Изход пиши: o аз-самият, нов-ред.
Изход пиши: ( o прави готово ), нов-ред.

Програма почисти.
използвана-памет3 := (Програма памет ? 0).



( използвана-памет1 = използвана-памет2 и: използвана-памет1 = използвана-памет3, и: използвана-памет2 = използвана-памет3 ) вярно: {
	Изход пиши: ['Тук няма изтичане на памет'].
}, невярно: {
	Изход пиши: ['Изтича памет...'].
}.
