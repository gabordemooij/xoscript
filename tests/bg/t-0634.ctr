# Програма shell-escape създава каноничен posix shell синтаксис
# съвместим с: bash/dash, zsh, ksh

>> c := Програма shell-escape: ['abc'].
Изход пиши: c, нов-ред.
Изход пиши: ( Програма система: ['echo '] + c ), нов-ред.

c := Програма shell-escape: ['a'b'c'].
Изход пиши: c, нов-ред.
Изход пиши: ( Програма система: ['echo '] + c ), нов-ред.

c := Програма shell-escape: ['a\'c'].
Изход пиши: c, нов-ред.
Изход пиши: ( Програма система: ['echo '] + c ), нов-ред.