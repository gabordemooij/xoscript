


>> Deck := Списък нов.
Deck при: ['print'] изпълни: {
        >> len := себе брой - 1.
        { :i
                >> len2 := себе брой - 1.
                Изход пиши: ['len: '].
                Изход пиши: len, нов-ред.
                Изход пиши: ['len2: '].
                Изход пиши: len2, нов-ред.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
