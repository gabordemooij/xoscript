
>> dictionary := (
	Речник нов
		постави: ['b'] на: ['a'],
		постави: ['a'] на: ['b'],
		постави: ['z'] на: ['x'],
		постави: ['hello'] на: ['hallo'],
		постави: ['human'] на: ['human']
).

>> comparisons := Списък нов.
dictionary всеки: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a сравни: b)
	).
}.

comparisons сортирай: { :a :b <- ( a сравни: b ). }.
Изход пиши: ( comparisons съедини: ['↵'] ), нов-ред.
comparisons съедини: ['↵'].
