
>> тълковник := (
	Речник нов
		постави: ['b'] на: ['a'],
		постави: ['a'] на: ['b'],
		постави: ['z'] на: ['x'],
		постави: ['hello'] на: ['hallo'],
		постави: ['human'] на: ['human']
).

>> сравнения := Списък нов.
тълковник всеки: { :a :b
	сравнения ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a сравни: b)
	).
}.

сравнения сортирай: { :a :b <- ( a сравни: b ). }.
Изход пиши: ( сравнения съедини: ['↵'] ), нов-ред.
сравнения съедини: ['↵'].
