Списък при: ['копирай'] изпълни: {
	>> копирай := Списък нов.
	себе всеки: { :число :раздел
		копирай добави-в-края: раздел рекурсивен копирай.
	}.
	<- копирай.
}.

>> овца := Списък нов ; ['Dolly'] ; ['Shaun']. 
>> клонинги := овца копирай.
клонинги всеки: { :число :овца
	овца добави-в-края: ['2'].
}.

Изход пиши: овца, нов-ред.
Изход пиши: клонинги, нов-ред.
