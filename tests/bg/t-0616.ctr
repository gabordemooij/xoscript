Списък при: ['копирай'] изпълни: {
	>> копирай := Списък нов.
	себе всеки: { :число :section
		копирай добави-в-края: section рекурсивен копирай.
	}. <- копирай.
}.

>> sheep := Списък нов ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep копирай.
clones всеки: { :число :sheep
	sheep добави-в-края: ['2'].
}.

Изход пиши: sheep, нов-ред.
Изход пиши: clones, нов-ред.
