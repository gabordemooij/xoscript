Server init.

# запис на тестов файл
>> f := Файл нов: ['/tmp/test.gif'].
f пиши: ['GIF87a01234567810'].

# изпращане на файла
Server предай: ['test.gif'] префикс: ['/tmp/'].

Изход нов-ред.

Изход пиши: ['Извън контейнера (сигурност):'], нов-ред.
{ Server предай: ['../passwd'] префикс: ['/tmp/']. }
прихвани: { :e Изход пиши: e, нов-ред. },
стартирай.

Изход пиши: ['Невалиден префикс:'], нов-ред.
{ Server предай: ['test.gif'] префикс: ['z:\\']. }
прихвани: { :e Изход пиши: e, нов-ред. },
стартирай.

Изход пиши: ['Несъществуващ файл:'], нов-ред.
{ Server предай: ['xxx.xxx'] префикс: ['/tmp/']. }
прихвани: { :e Изход пиши: e, нов-ред. },
стартирай.
