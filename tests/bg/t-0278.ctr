>> За-правене := Обект нов.

За-правене при: ['нов'] изпълни: {
	свой list := Списък нов.
}.

За-правене при: ['nieuw'] изпълни: {
	свой list := Списък нов.
}.

За-правене при: ['+'] изпълни: { :задача
	свой list добави-в-края: задача.
}.

За-правене при: ['number of tasks?'] изпълни: { <-  свой list брой.
}.

>> задачи := 
	За-правене нов 
	+ ['сготви вечеря'] 
	+ ['почисти стаята'].
	
Изход пиши: ['You have $ tasks to do'] $ задачи number of tasks?.
