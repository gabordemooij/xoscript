>> To-Do := Обект нов.

To-Do при: ['нов'] изпълни: {
	свой list := Списък нов.
}.

To-Do при: ['nieuw'] изпълни: {
	свой list := Списък нов.
}.

To-Do при: ['+'] изпълни: { :task
	свой list добави-в-края: task.
}.

To-Do при: ['number of tasks?'] изпълни: { <-  свой list брой.
}.

>> todos := 
	To-Do нов 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Изход пиши: ['You have $ tasks to do'] $ todos number of tasks?.
