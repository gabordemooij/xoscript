
Изход пиши: ['Прекъсване на for-цикъл, 0-4.'], нов-ред.
{ :i
	Изход пиши: ['iteration #'] + i, нов-ред.
	(i = 4) прекъсни.
} × 10.

>> x := 0.
>> x-по-малко-от-10 := { <- ( x < 10 ). }.

Изход пиши: ['Прекъсване на while-true цикъл, 0-4.'], нов-ред.
{
	Изход пиши: ['iteration #'] + x, нов-ред.
	x добави: 1.
	((x < 5) не) прекъсни.
} докато: x-по-малко-от-10.

Изход пиши: ['Прекъсване на while-false цикъл, 5,4.'], нов-ред.
{
	Изход пиши: ['iteration #'] + x, нов-ред.
	x извади: 1.
	(x = 3) прекъсни.
} докато: { <- (x > 0). }.

Изход пиши: ['Прекъсване на times цикъл, 1-4.'], нов-ред.
{ :i
	Изход пиши: ['iteration #'] + i, нов-ред.
	(i = 4) прекъсни.
} × 5.

Изход пиши: ['Прекъсване на блок, не печатай реда.'], нов-ред.
{ Вярно прекъсни. Изход пиши: ['не пиши това!'], нов-ред. } стартирай.

Изход пиши: ['Прекъсване на блок, не задействай catch...'], нов-ред.
{ Вярно прекъсни. Изход пиши: ['не пиши това!'], нов-ред. } прихвани: { Изход пиши: ['Не улавяй това!']. }, стартирай.

Изход пиши: ['Тест на each-цикъл за Масив: 0,1'], нов-ред.
(Списък ← 1 ; 2 ; 3) преобразувай: { :i
	Изход пиши: ['iteration #'] + i, нов-ред.
	(i = 1) прекъсни.
}.

Изход пиши: ['Тест на each-цикъл за Карта: само c'], нов-ред.
>> m := Речник нов.
m постави: ['first'] на: ['a'], постави: ['second'] на: ['b'], постави: ['трети'] на: ['c'].
m всеки: { :k :v
	Изход пиши: ['iteration'] + v + k, нов-ред.
	Вярно прекъсни.
}.

