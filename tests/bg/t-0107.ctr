
Изход пиши: ['Break for-loop, 0-4.'], нов-ред.
{ :i
	Изход пиши: ['iteration #'] + i, нов-ред.
	(i = 4) прекъсни.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Изход пиши: ['Break while-true loop, 0-4.'], нов-ред.
{
	Изход пиши: ['iteration #'] + x, нов-ред.
	x добави: 1.
	((x < 5) не) прекъсни.
} докато: xIsLessThan10.

Изход пиши: ['Break while-false loop, 5,4.'], нов-ред.
{
	Изход пиши: ['iteration #'] + x, нов-ред.
	x извади: 1.
	(x = 3) прекъсни.
} докато: { <- (x > 0). }.

Изход пиши: ['Break times loop, 1-4.'], нов-ред.
{ :i
	Изход пиши: ['iteration #'] + i, нов-ред.
	(i = 4) прекъсни.
} × 5.

Изход пиши: ['Break block, dont print line.'], нов-ред.
{ Вярно прекъсни. Изход пиши: ['dont write this!'], нов-ред. } стартирай.

Изход пиши: ['Break block, dont fire catch...'], нов-ред.
{ Вярно прекъсни. Изход пиши: ['dont write this!'], нов-ред. } прихвани: { Изход пиши: ['Dont catch this!']. }, стартирай.

Изход пиши: ['Test Array each-loop: 0,1'], нов-ред.
(Списък ← 1 ; 2 ; 3) преобразувай: { :i
	Изход пиши: ['iteration #'] + i, нов-ред.
	(i = 1) прекъсни.
}.

Изход пиши: ['Test Map each-loop: c only'], нов-ред.
>> m := Речник нов.
m постави: ['first'] на: ['a'], постави: ['second'] на: ['b'], постави: ['third'] на: ['c'].
m всеки: { :k :v
	Изход пиши: ['iteration'] + v + k, нов-ред.
	Вярно прекъсни.
}.

