
Текст при: ['html'] изпълни: { <- (
		себе
		замени: ['&'] с: ['&amp;'],
		замени: ['<'] с: ['&lt;'],
		замени: ['>'] с: ['&gt;'],
		замени: ['"'] с: ['&quot;']
	).
}.

>> HtmlBrush := Обект нов.

HtmlBrush при: ['отговори:'] изпълни: { :tag
	Изход пиши: (['<tag>↵'] tag: tag ).
}.

HtmlBrush при: ['отговори:и:'] изпълни: { :tag :content
	tag := ( tag от: 0 дължина: (tag дължина - 1) ).
	Изход пиши: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush при: ['content:'] изпълни: { :text
	Изход пиши: text html, нов-ред.
}.

HtmlBrush при: ['attr:value:'] изпълни: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush нов.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
