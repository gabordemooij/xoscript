
Текст при: ['html'] изпълни: { <- (
		себе
		замени: ['&'] с: ['&amp;'],
		замени: ['<'] с: ['&lt;'],
		замени: ['>'] с: ['&gt;'],
		замени: ['"'] с: ['&quot;']
	).
}.

>> HTML-четка := Обект нов.

HTML-четка при: ['отговори:'] изпълни: { :таг
	Изход пиши: (['<tag>↵'] tag: таг ).
}.

HTML-четка при: ['отговори:и:'] изпълни: { :таг :content
	таг := ( таг от: 0 дължина: (таг дължина - 1) ).
	Изход пиши: (['<tag content>↵'] tag: таг, content: content).
}.

HTML-четка при: ['content:'] изпълни: { :надпис
	Изход пиши: надпис html, нов-ред.
}.

HTML-четка при: ['атр:стойност:'] изпълни: { :атр :value <- ['attr="value"'] attr: атр, value: value.
}.

>> h := HTML-четка нов.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h атр: ['class'] стойност: ['bold']),
		/span
	/body
/html.
		
