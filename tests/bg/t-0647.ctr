Server init.
Изход пиши: ['Тест на час в базата данни'], нов-ред.

>> бд := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'], 
	парола: ['pass123'],
	име-на-база: ['xobase'],
	свържи-се.

>> параметри-за-търсене :=
бд заявка: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
извлечи: { :редица
	Изход пиши: редица timetest, нов-ред.
}.
