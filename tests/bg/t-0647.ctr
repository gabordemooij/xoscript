Server init.
Изход пиши: ['Database time test'], нов-ред.

>> db := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'], 
	парола: ['pass123'],
	име-на-база: ['xobase'],
	свържи-се.

>> параметри-за-търсене :=
db заявка: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
извлечи: { :row
	Изход пиши: row timetest, нов-ред.
}.
