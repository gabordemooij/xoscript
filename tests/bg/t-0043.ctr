>> повторител := Обект нов.
повторител при: ['отговори:'] изпълни: { :какво
	Изход пиши: какво + [' '].
}.
повторител при: ['отговори:и:'] изпълни: { :какво :say
	Изход пиши: какво, пиши: say + [' '].
}.
повторител при: ['отговори:и:и:'] изпълни: { :какво :say :още
	Изход пиши: какво, пиши: say, пиши: още.
}.
повторител повтори.
повторител everything: ['Аз казвам.'].
повторител and: ['I '] everything: ['правя.'].
