>> repeater := Обект нов.
repeater при: ['отговори:'] изпълни: { :what
	Изход пиши: what + [' '].
}.
repeater при: ['отговори:и:'] изпълни: { :what :say
	Изход пиши: what, пиши: say + [' '].
}.
repeater при: ['отговори:и:и:'] изпълни: { :what :say :more
	Изход пиши: what, пиши: say, пиши: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
