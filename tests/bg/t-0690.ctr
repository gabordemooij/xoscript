# database test
# see example server.xo for required config

Server init.
Изход пиши: ['Database test'], нов-ред.

>> db := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'], парола: ['pass123'], име-на-база: ['xobase'], свържи-се.

Изход пиши: ['Can we connect? '] + db свързан?, нов-ред.

>> параметри-за-търсене := db заявка: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], параметри: ( Списък нов ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  параметри-за-търсене изпълни. db потвърди. } прихвани: { :e db отмени.  }, стартирай.

Изход пиши: ['Can we insert? '] + ( параметри-за-търсене insert-id > 0 ), нов-ред.

>> x := 0.
>> параметри-за-търсене :=
db заявка: ['SELECT * FROM book order by id desc limit 2'], 
извлечи: { :row 
	x добави: 1.
	Вярно прекъсни. # must clean up, no 'Commands out of sync'
}.

>> параметри-за-търсене :=
db заявка: ['SELECT * FROM book order by id desc limit 2'], 
извлечи: { :row
	x добави: 1.
	Вярно прекъсни.
}.

(x > 0) вярно: {
	Изход пиши: ['Can we break in the middle of a fetch? '].
}.

Изход пиши: Вярно, нов-ред.