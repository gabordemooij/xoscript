Изход пиши: ['Test object'], нов-ред.
>> p := Път /tmp.
Изход пиши: p, нов-ред.
>> old-p-address := p прототип адрес-в-паметта.
p save-as: ['/tmp/a.bin'].
Изход пиши: ['========== RELOADING SNAP:'], нов-ред.
>> b := Обект load-from: ['/tmp/a.bin'].
(b прототип адрес-в-паметта = old-p-address) вярно: {
	Изход пиши: ['Object link re-attached.'], нов-ред.
}.
Изход пиши: b, нов-ред.
