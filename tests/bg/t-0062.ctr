Логически при: ['xor:'] изпълни: { :a :b <- ((a и: b не) или: (a не и: b)).
}.

>> o := Обект нов.
o при: ['hello'] изпълни: { ['Празно']. }.
{ o при: 2 изпълни: 3.} прихвани: { :e Изход пиши: e, нов-ред. }, стартирай.
{ o при: ['тест'] изпълни: 3.} прихвани: { :e Изход пиши: e, нов-ред. }, стартирай.
{ o при: ['hello'] изпълни: { ['Празно']. }.} прихвани: { :e Изход пиши: e, нов-ред. }, стартирай. 
{ >> z := 4 ÷ 0. } прихвани: { :e Изход пиши: e, нов-ред. }, стартирай. 
{ (Вярно и: Нищо) вярно: { Изход пиши: ['X'].}. } прихвани: { :e Изход пиши: e, нов-ред. }, стартирай. 
{ ([''] xor: 0) вярно: { Изход пиши: ['X'].}. } прихвани: { :e Изход пиши: e, нов-ред. }, стартирай. 
{ (1 < ['2']) вярно: { Изход пиши: ['OK']. }. } прихвани: { :e Изход пиши: e, нов-ред. }, стартирай. 
{ (1 < ['2.0']) вярно: { Изход пиши: ['OK']. }. } прихвани: { :e Изход пиши: e, нов-ред. }, стартирай. 
{ (1 < ['x2.0']) вярно: { Изход пиши: ['НЕ!']. }. } прихвани: { :e Изход пиши: e, нов-ред. }, стартирай. 
{ Изход пиши: (['ей ти OK там'] от: ['6'] дължина: ['2']). } стартирай. 
