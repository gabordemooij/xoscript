>> фрази := Списък нов
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> послание := ['Phrase: ~decoded base64: ~encoded'].
	
фрази всеки: { :_ :фраза 
	>> e := Server base64-кодирай: фраза.
	>> d := Server base64-декодирай: e.
	Изход пиши: (
		послание копирай ~encoded: e, ~decoded: d
	), нов-ред.
}.
