>> phrases := Списък нов
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases всеки: { :_ :phrase 
	>> e := Server base64-кодирай: phrase.
	>> d := Server base64-декодирай: e.
	Изход пиши: (
		message копирай ~encoded: e, ~decoded: d
	), нов-ред.
}.
