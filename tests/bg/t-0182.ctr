

>> използвана-памет1 := 0.
>> използвана-памет2 := 0.
>> използвана-памет3 := 0.
>> използвана-памет4 := 0.

Програма управление-на-паметта: 0.

>> txt := ['1.6'].
>> n := txt число.
>> t := txt логически.
Изход пиши: n, нов-ред.
Изход пиши: t, нов-ред.
Изход пиши: n тип, нов-ред.
Изход пиши: t тип, нов-ред.

Програма почисти.

използвана-памет1 := (Програма памет ? 0).


txt := ['1.6'].
n := txt число.
t := txt логически.
Изход пиши: n, нов-ред.
Изход пиши: t, нов-ред.
Изход пиши: n тип, нов-ред.
Изход пиши: t тип, нов-ред.

Програма почисти.
използвана-памет2 := (Програма памет ? 0).


txt := ['1.6'].
n := txt число.
t := txt логически.
Изход пиши: n, нов-ред.
Изход пиши: t, нов-ред.
Изход пиши: n тип, нов-ред.
Изход пиши: t тип, нов-ред.

Програма почисти.
използвана-памет3 := (Програма памет ? 0).



( използвана-памет1 = използвана-памет2 и: използвана-памет1 = използвана-памет3, и: използвана-памет2 = използвана-памет3 ) вярно: {
	Изход пиши: ['Тук няма изтичане на памет'].
}, невярно: {
	Изход пиши: ['Изтича памет...'].
}.
