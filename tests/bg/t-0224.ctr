
>> държави := Списък нов
	~ ['Швейцария']
	~ ['Италия']
	~ ['Германия'].

>> храни := Списък нов
	~ ['Рьощи']
	~ ['Спагети']
	~ ['Кисело зеле'].


>> брояч := 0.
храни според: държави, всеки: { :key :value
	брояч добави: 1.
}.

Изход пиши: (['we serve counter dishes'] counter: брояч), нов-ред.

>> брояч := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] знаци сортирай: { :v
	брояч добави: 0.
}.

Изход пиши: (['we sort counter dishes'] counter: брояч), нов-ред.


>> брояч := 0.
{
	{
		брояч добави: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Изход пиши: (['we calculate counter numbers.'] counter: брояч), нов-ред.

