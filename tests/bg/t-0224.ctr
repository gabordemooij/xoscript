
>> countries := Списък нов
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Списък нов
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods според: countries, всеки: { :key :value
	counter добави: 1.
}.

Изход пиши: (['we serve counter dishes'] counter: counter), нов-ред.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] знаци сортирай: { :v
	counter добави: 0.
}.

Изход пиши: (['we sort counter dishes'] counter: counter), нов-ред.


>> counter := 0.
{
	{
		counter добави: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Изход пиши: (['we calculate counter numbers.'] counter: counter), нов-ред.

