
Текст при: ['изчисли'] изпълни: {
	>> код := Файл нов: ['/tmp/eval.ctr'].
	код пиши: (себе текст + ['.']).
	Програма използвай: ['/tmp/eval.ctr'].
}.

>> map :=
	(Речник нов)
	постави: ['Здравейте там'] на: ['two'],
	постави: (Списък ← ['hello'] ; ['world'] ; (Списък ← 1 ; 2; 9) ; Невярно) на: ['едно'],
	постави: ( (Речник нов) постави: ['сввят'] на: ['грешно-написано'] ) на: ['three'],
	постави: (Списък ← ((Речник нов) постави: ['съкровище'] на: ['скрито']) ; 2) на: ['четири']. 
>> str := map текст.
>> map2 := Нищо.
(['map2 := '] + str ) изчисли.
Изход пиши: map2 ? ['едно'] ? 0.
Изход пиши: map2 ? ['едно'] ? 1.
Изход пиши: map2 ? ['четири'] ? 0 ? ['скрито'].
Изход пиши: map2 ? ['едно'] ? 2 ? 2.
