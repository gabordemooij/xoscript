
Текст при: ['evaluate'] изпълни: {
	>> код := Файл нов: ['/tmp/eval.ctr'].
	код пиши: (себе текст + ['.']).
	Програма използвай: ['/tmp/eval.ctr'].
}.

>> map :=
	(Речник нов)
	постави: ['Hi There'] на: ['two'],
	постави: (Списък ← ['hello'] ; ['world'] ; (Списък ← 1 ; 2; 9) ; Невярно) на: ['one'],
	постави: ( (Речник нов) постави: ['wrrld'] на: ['misspelled'] ) на: ['three'],
	постави: (Списък ← ((Речник нов) постави: ['treasure'] на: ['hidden']) ; 2) на: ['four']. 
>> str := map текст.
>> map2 := Нищо.
(['map2 := '] + str ) evaluate.
Изход пиши: map2 ? ['one'] ? 0.
Изход пиши: map2 ? ['one'] ? 1.
Изход пиши: map2 ? ['four'] ? 0 ? ['hidden'].
Изход пиши: map2 ? ['one'] ? 2 ? 2.
