>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Обект нов.
⚄ при: ['drawFrom:length:'] изпълни: { :pool :брой
	
	>> result := [''].
	
	{
		>> index := Число random % (pool дължина).
		result добави-в-края: ( pool знак: (index + 1) ).
		
	} × брой. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? дължина.
Изход пиши: (['x↵'] x random дължина).
Изход пиши: (['y↵'] y ?? дължина).

