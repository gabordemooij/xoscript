>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Обект нов.
⚄ при: ['изтегли-от:дължина:'] изпълни: { :набор :брой
	
	>> резултат := [''].
	
	{
		>> индекс := Число random % (набор дължина).
		резултат добави-в-края: ( набор знак: (индекс + 1) ).
		
	} × брой. <- резултат.
}.

>> random := ⚄ изтегли-от: ?? дължина: ?? дължина.
Изход пиши: (['x↵'] x random дължина).
Изход пиши: (['y↵'] y ?? дължина).

