# test buffers PKI/Sign 
Server init.

>> long := ( Списък нов запълни: 1000 с: ['a'] ) съедини: [''].

# sign a message
Изход пиши: ( 
	Трезор подпиши: ['abc'] с: long
), нов-ред.

Изход пиши: ( 
	Трезор
		провери: ['abc'] 
		подпис: long 
		с: long
), нов-ред.

Изход пиши: (
	Трезор хеш-на-парола: long провери: long
), нов-ред.
