# тест на буфери PKI/Sign 
Server init.

>> дълъг := ( Списък нов запълни: 1000 с: ['a'] ) съедини: [''].

# подписване на съобщение
Изход пиши: ( 
	Трезор подпиши: ['abc'] с: дълъг
), нов-ред.

Изход пиши: ( 
	Трезор
		провери: ['abc'] 
		подпис: дълъг 
		с: дълъг
), нов-ред.

Изход пиши: (
	Трезор хеш-на-парола: дълъг провери: дълъг
), нов-ред.
