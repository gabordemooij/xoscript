Изход пиши: ['Test object'], нов-ред.
>> a := Обект нов. 

a при: ['item:'] изпълни: { :octhelper
	свой octhelper := octhelper. 
}.

a при: ['item'] изпълни: { <- свой octhelper.
}.

a item: Oct нов.

>> old-octhelper-address := a item прототип адрес-в-паметта.
a save-as: ['/tmp/a.bin'].
Изход пиши: ['========== RELOADING SNAP:'], нов-ред.

>> b := Обект load-from: ['/tmp/a.bin'].

(b item прототип адрес-в-паметта = old-octhelper-address) вярно: {
	Изход пиши: ['Object link re-attached.'], нов-ред.
}.
