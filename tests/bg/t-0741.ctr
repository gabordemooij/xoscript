Изход пиши: ['Тестов обект'], нов-ред.
>> a := Обект нов. 

a при: ['item:'] изпълни: { :окт-помощник
	свой окт-помощник := окт-помощник. 
}.

a при: ['предмет'] изпълни: {
	<- свой окт-помощник.
}.

a item: Oct нов.

>> стар-адрес-окт-помощник := a предмет прототип адрес-в-паметта.
a save-as: ['/tmp/a.bin'].
Изход пиши: ['========== ПРЕЗАРЕЖДАНЕ НА SNAP:'], нов-ред.

>> b := Обект load-from: ['/tmp/a.bin'].

(b предмет прототип адрес-в-паметта = стар-адрес-окт-помощник) вярно: {
	Изход пиши: ['Връзката на обекта е закачена отново.'], нов-ред.
}.
