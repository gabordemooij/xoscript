#OBSD
>> dirname := [''].
{ dirname добави-в-края: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Програма система: command.
Програма chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename добави-в-края: ['YYYYYYYY']. } * 20.
Файл нов: filename, пиши: ['sometext'].
{ Файл списък: ['/tmp/'] + dirname. } * 1000.
Изход пиши: ['no crash'], нов-ред.

