Изход пиши: ['Test object'], нов-ред.
>> a := Обект нов. 

a при: ['item:'] изпълни: { :moment
	свой moment := moment. 
}.

a при: ['item'] изпълни: { <- свой moment.
}.

>> today := Момент нов зона: ['CEST'], година: 2026, месец: 7.
a item: today.
Изход пиши: a item, нов-ред.
a save-as: ['/tmp/a.bin'].
Изход пиши: ['========== RELOADING SNAP:'], нов-ред.
>> b := Обект load-from: ['/tmp/a.bin'].
Изход пиши: b item, нов-ред.
