Server init.

Изход пиши: (
	Шаблон нов: ['^\\w+$'],
	съвпадение: ['test@example.com'] 
), нов-ред. # 0 съвпадения, проваля се при @ и .

Изход пиши: (
	Шаблон нов: ['^[^@]+@[^\.]+\.\\w+$'],
	съвпадение: ['test@example.com'] 
), нов-ред. # 1 съвпадение

Изход пиши: (
	Шаблон нов: ['[^@]+@[^\.]+\.\\w+'],
	съвпадение: ['test@example.com'] 
), нов-ред. # 1 съвпадение

Изход пиши: (
	Шаблон нов: ['([^@]+)@([^\.]+)\.\\w+'],
	съвпадение: ['test@example.com'] 
), нов-ред. # 1 съвпадение, групите нямат значение

Изход пиши: (
	Шаблон нов: ['[a-z]'],
	съвпадение: ['test@example.com'] 
), нов-ред. # 14 съвпадения

Изход пиши: (
	Шаблон нов: ['.*'],
	съвпадение: ['test@example.com'] 
), нов-ред. # 1 съвпадение (всичко)

Изход пиши: (
	Шаблон нов: ['(.*)'],
	съвпадение: ['test@example.com'] 
), нов-ред. # 1 съвпадение (всичко)

Изход пиши: (
	Шаблон нов: ['\\s*[^@]+@[^\.]+\.\\w+'],
	съвпадение: ['test@example.com'] 
), нов-ред. # 1 съвпадение, интервалът отпред е по избор и се пренебрегва