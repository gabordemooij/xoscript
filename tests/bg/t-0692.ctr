Server init.

Изход пиши: (
	Шаблон нов: ['^\\w+$'],
	съвпадение: ['test@example.com'] 
), нов-ред. # 0 match, fails on @ and .

Изход пиши: (
	Шаблон нов: ['^[^@]+@[^\.]+\.\\w+$'],
	съвпадение: ['test@example.com'] 
), нов-ред. # 1 match

Изход пиши: (
	Шаблон нов: ['[^@]+@[^\.]+\.\\w+'],
	съвпадение: ['test@example.com'] 
), нов-ред. # 1 match

Изход пиши: (
	Шаблон нов: ['([^@]+)@([^\.]+)\.\\w+'],
	съвпадение: ['test@example.com'] 
), нов-ред. # 1 match, groups dont matter

Изход пиши: (
	Шаблон нов: ['[a-z]'],
	съвпадение: ['test@example.com'] 
), нов-ред. # 14 matches

Изход пиши: (
	Шаблон нов: ['.*'],
	съвпадение: ['test@example.com'] 
), нов-ред. # 1 match (all)

Изход пиши: (
	Шаблон нов: ['(.*)'],
	съвпадение: ['test@example.com'] 
), нов-ред. # 1 match (all)

Изход пиши: (
	Шаблон нов: ['\\s*[^@]+@[^\.]+\.\\w+'],
	съвпадение: ['test@example.com'] 
), нов-ред. # 1 match, prefix space optional, gets ignored