Изход пиши: ['Test object'], нов-ред.
>> a := Обект нов. 
a при: ['item:'] изпълни: { :lst
	свой lst := lst. 
}.
a при: ['item'] изпълни: { <- свой lst.
}.
a item: (
	Списък нов ; 1 ; (
		Списък нов ; ['a'] ; (
			Списък нов ; ( Момент нов: 1 )
		) ; ( Int64 от-текст: ['321'] )
	)
).
Изход пиши: a item, нов-ред.
>> old-lst-address := a item прототип адрес-в-паметта.
a save-as: ['/tmp/a.bin'].
Изход пиши: ['========== RELOADING SNAP:'], нов-ред.
>> b := Обект load-from: ['/tmp/a.bin'].
(b item прототип адрес-в-паметта = old-lst-address) вярно: {
	Изход пиши: ['Object link re-attached.'], нов-ред.
}.
Изход пиши: ( b item ), нов-ред.
