# тест на методи, прихващащи всичко
>> x13 := Обект нов.
x13 при: ['a'] изпълни: { :a Изход пиши: 0, нов-ред. }.
x13 при: ['a:'] изпълни: { :a Изход пиши: a, нов-ред. <- 5. }.
x13 при: ['a:b:'] изпълни: { :a :b Изход пиши: (a + b), нов-ред. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
