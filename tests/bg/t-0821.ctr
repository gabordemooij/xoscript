# a quote that never closes must give an error, not an endless loop
>> път := ['/tmp/test0821.csv'].
>> file := Файл нов: път.

file пиши: ['a,b\n"1,2\n'].
{
	file разделител: [','] кавичка: ['"'] редове: { :line
		Изход пиши: line, нов-ред.
	}.
} прихвани: { :e Изход пиши: e, нов-ред. }, стартирай.

# a closed quote still works
file пиши: ['a,b\n"1,2",3'].
file разделител: [','] кавичка: ['"'] редове: { :line
	Изход пиши: line, нов-ред.
}.
file изтрий.
