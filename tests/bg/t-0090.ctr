Изход пиши: ['1,2,3,4,5,6,7,8,9,A,'], нов-ред.
>> Scope := Обект нов.
Scope при: ['initialize:'] изпълни: { :x свой property := x. }.
Scope при: ['confirm'] изпълни: { Изход пиши: [',']. }.
Scope при: ['тест'] изпълни: {
	Изход пиши: свой property.
	себе confirm.
	( 1 = 1 ) вярно: { Изход пиши: свой property. себе confirm. }.
	( 1 = 0 ) невярно: { Изход пиши: свой property. себе confirm. }.
	>> y := 2. { Изход пиши: свой property. себе confirm. } докато: { y извади: 1. <- (y > 0). }.
	{ Изход пиши: свой property. себе confirm. } × 1.
	(Списък ← 1) всеки: {  Изход пиши: свой property. себе confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Речник нов one: ['item']) всеки: { Изход пиши: свой property. себе confirm. }.
	{ 1 ÷ 0. } прихвани: { Изход пиши: свой property. себе confirm. }, стартирай.
	Изход нов-ред.
}.
>> scope1 := Scope нов.
scope1 initialize: ['X'].
scope1 тест.
>> function := { 
	свой property := ['Y'].
	Изход пиши: свой property.
	себе confirm.
	( 1 = 1 ) вярно: { Изход пиши: свой property. себе confirm. }.
	( 1 = 0 ) невярно: { Изход пиши: свой property. себе confirm. }.
	>> y := 2. { Изход пиши: свой property. себе confirm. } докато: { y извади: 1. <- (y > 0). }.
	{ Изход пиши: свой property. себе confirm. } × 1.
	(Списък ← 1) всеки: {  Изход пиши: свой property. себе confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Речник нов one: ['item']) всеки: { Изход пиши: свой property. себе confirm. }.
	{ 1 ÷ 0. } прихвани: { Изход пиши: свой property. себе confirm. }, стартирай.
	Изход нов-ред.
}.
