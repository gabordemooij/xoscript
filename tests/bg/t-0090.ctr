Изход пиши: ['1,2,3,4,5,6,7,8,9,A,'], нов-ред.
>> Обхват := Обект нов.
Обхват при: ['initialize:'] изпълни: { :x свой свойство := x. }.
Обхват при: ['потвърждавай'] изпълни: { Изход пиши: [',']. }.
Обхват при: ['тест'] изпълни: {
	Изход пиши: свой свойство.
	себе потвърждавай.
	( 1 = 1 ) вярно: { Изход пиши: свой свойство. себе потвърждавай. }.
	( 1 = 0 ) невярно: { Изход пиши: свой свойство. себе потвърждавай. }.
	>> y := 2. { Изход пиши: свой свойство. себе потвърждавай. } докато: { y извади: 1. <- (y > 0). }.
	{ Изход пиши: свой свойство. себе потвърждавай. } × 1.
	(Списък ← 1) всеки: {  Изход пиши: свой свойство. себе потвърждавай. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo собствено сортиране, този тест се проваля заради различния брой итерации на различните платформи
	(Речник нов one: ['item']) всеки: { Изход пиши: свой свойство. себе потвърждавай. }.
	{ 1 ÷ 0. } прихвани: { Изход пиши: свой свойство. себе потвърждавай. }, стартирай.
	Изход нов-ред.
}.
>> обхват1 := Обхват нов.
обхват1 initialize: ['X'].
обхват1 тест.
>> моя-функция := { 
	свой свойство := ['Y'].
	Изход пиши: свой свойство.
	себе потвърждавай.
	( 1 = 1 ) вярно: { Изход пиши: свой свойство. себе потвърждавай. }.
	( 1 = 0 ) невярно: { Изход пиши: свой свойство. себе потвърждавай. }.
	>> y := 2. { Изход пиши: свой свойство. себе потвърждавай. } докато: { y извади: 1. <- (y > 0). }.
	{ Изход пиши: свой свойство. себе потвърждавай. } × 1.
	(Списък ← 1) всеки: {  Изход пиши: свой свойство. себе потвърждавай. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Речник нов one: ['item']) всеки: { Изход пиши: свой свойство. себе потвърждавай. }.
	{ 1 ÷ 0. } прихвани: { Изход пиши: свой свойство. себе потвърждавай. }, стартирай.
	Изход нов-ред.
}.
моя-функция при: ['потвърждавай'] изпълни: { Изход пиши: [',']. }.
моя-функция приложи: 1 и: 2.
