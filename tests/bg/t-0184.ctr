

>> използвана-памет1 := 0.
>> използвана-памет2 := 0.
>> използвана-памет3 := 0.
>> използвана-памет4 := 0.

Програма управление-на-паметта: 0.

Число при: ['addNum:'] изпълни: { :x
	себе добави: x.
}.

Число при: ['subtractNum:'] изпълни: { :x
	себе извади: x.
}.

Число при: ['multiplyBy:'] изпълни: { :x
	себе умножи-по: x.
}.

Число при: ['divideBy:'] изпълни: { :x
	себе раздели-на: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 степен: 8).  
a := a + (2 степен: -1). 
a := a + (49 квадратен-корен).   
a addNum: ((Списък ← 0 ; 1) максимум).          
a addNum: ((Списък ← 2 ; 3) минимум).
Изход пиши: a.

Програма почисти.

използвана-памет1 := (Програма памет ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 степен: 8).  
a := a + (2 степен: -1). 
a := a + (49 квадратен-корен).   
a addNum: ((Списък ← 0 ; 1) максимум).          
a addNum: ((Списък ← 2 ; 3) минимум).
Изход пиши: a.

Програма почисти.
използвана-памет2 := (Програма памет ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 степен: 8).  
a := a + (2 степен: -1). 
a := a + (49 квадратен-корен).   
a addNum: ((Списък ← 0 ; 1) максимум).          
a addNum: ((Списък ← 2 ; 3) минимум).
Изход пиши: a.

Програма почисти.
използвана-памет3 := (Програма памет ? 0).



( използвана-памет1 = използвана-памет2 и: използвана-памет1 = използвана-памет3, и: използвана-памет2 = използвана-памет3 ) вярно: {
	Изход пиши: ['Тук няма изтичане на памет'].
}, невярно: {
