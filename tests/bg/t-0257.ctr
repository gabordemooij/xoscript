
>> Поздравител := Обект нов.
Поздравител при: ['нов'] изпълни: {
	свой име := ['?'].
}.
Поздравител при: ['name:'] изпълни: { :име
	свой име := име.
}.
Поздравител при: ['поздрави'] изпълни: {
	Изход пиши: (['hello[you]'] [you]: свой име).
}.
>> приятел := Поздравител нов.
приятел name: ['1'].
приятел поздрави.
