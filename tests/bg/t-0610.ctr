
>> Rectangle := Обект нов.

Rectangle при: ['area'] изпълни: { <- свой дължина * свой width.
}.

Rectangle при: ['length:'] изпълни: { :дължина
	свой дължина := дължина.
}.

Rectangle при: ['width:'] изпълни: { :width
	свой width := width.
}.

Rectangle при: ['нов'] изпълни: {
	# this will not result into an infinite loop
	>> rectangle := себе нов.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle нов.
Изход пиши: a area, нов-ред. #0

>> b := Rectangle нов length: 2, width: 3.
Изход пиши: b area, нов-ред. #6

