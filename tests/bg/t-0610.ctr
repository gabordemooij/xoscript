
>> Правоъгълник := Обект нов.

Правоъгълник при: ['площ'] изпълни: {
	<- свой дължина * свой ширина.
}.

Правоъгълник при: ['length:'] изпълни: { :дължина
	свой дължина := дължина.
}.

Правоъгълник при: ['width:'] изпълни: { :ширина
	свой ширина := ширина.
}.

Правоъгълник при: ['нов'] изпълни: {
	# това няма да доведе до безкраен цикъл
	>> правоъгълник := себе нов.
	правоъгълник length: 0, width: 0.
	<- правоъгълник.
}.

>> a := Правоъгълник нов.
Изход пиши: a площ, нов-ред. #0

>> b := Правоъгълник нов length: 2, width: 3.
Изход пиши: b площ, нов-ред. #6

