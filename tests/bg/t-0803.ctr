#...
>> изтр := връзка1 заявка: ['DELETE FROM book WHERE id > 0'].
{  изтр изпълни. връзка1 потвърди. } прихвани: { :e връзка1 отмени.  }, стартирай.

>> вмъкване := връзка1 заявка: ['INSERT INTO book (id) VALUES(null)'].
вмъкване изпълни.

>> брой := връзка1 заявка: ['SELECT COUNT(*) AS num FROM book'].
брой извлечи: { :редица Изход пиши: редица num, нов-ред. }.

# не се показва
# вмъкването не е потвърдено във връзка 1
>> брой := връзка2 заявка: ['SELECT COUNT(*) AS num FROM book'].
брой извлечи: { :редица Изход пиши: редица num, нов-ред. }.
