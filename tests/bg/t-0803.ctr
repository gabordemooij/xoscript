>> del := conn1 заявка: ['DELETE FROM book WHERE id > 0'].
{  del изпълни. conn1 потвърди. } прихвани: { :e conn1 отмени.  }, стартирай.

>> insert := conn1 заявка: ['INSERT INTO book (id) VALUES(null)'].
insert изпълни.

>> брой := conn1 заявка: ['SELECT COUNT(*) AS num FROM book'].
брой извлечи: { :row Изход пиши: row num, нов-ред. }.

# does not show up
