Server init.

>> връзка1 := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'],
	парола: ['pass123'],
	име-на-база: ['xobase'],
	свържи-се.

>> връзка2 := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'],
	парола: ['pass123'],
	име-на-база: ['xobase'],
