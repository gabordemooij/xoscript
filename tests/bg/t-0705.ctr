

>> obj := Обект нов.

obj при: ['greet'] изпълни: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj при: ['task'] изпълни: {
	свой property := 123.
	{
		# try binds self/own to object instead of block
		Изход пиши: себе greet.
		Изход пиши: свой property.
		1 / 0.
	} прихвани: {
		Изход пиши: себе greet.
		Изход пиши: свой property.
		Изход пиши: ['ok'].
	}, опитай.
}.

obj task.