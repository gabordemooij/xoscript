

>> обк := Обект нов.

обк при: ['поздрави'] изпълни: {
	<- ['здрасти'].
}.

# трябва да изведе hi123hi123ok
обк при: ['задача'] изпълни: {
	свой свойство := 123.
	{
		# опитай свързва себе/свой с обекта вместо с блока
		Изход пиши: себе поздрави.
		Изход пиши: свой свойство.
		1 / 0.
	} прихвани: {
		Изход пиши: себе поздрави.
		Изход пиши: свой свойство.
		Изход пиши: ['ok'].
	}, опитай.
}.

обк задача.