>> Поздравител := Обект нов.
Поздравител при: ['създай'] изпълни: {
	>> поздравител := Обект нов.
	поздравител при: ['name:'] изпълни: { :име
		Изход пиши: ['задаване на име'].
		свой мое-име := име.
	}.
	поздравител при: ['поздрави'] изпълни: {
		Изход пиши: ['Hello'].
		Изход пиши: свой мое-име.
	}. <- поздравител.
}.
>> поздравител := Поздравител създай.
поздравител name: ['слънчице!'].
поздравител поздрави.
