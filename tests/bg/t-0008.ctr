>> Greeter := Обект нов.
Greeter при: ['make'] изпълни: {
	>> greeter := Обект нов.
	greeter при: ['name:'] изпълни: { :име
		Изход пиши: ['setting a name'].
		свой myName := име.
	}.
	greeter при: ['greet'] изпълни: {
		Изход пиши: ['Hello'].
		Изход пиши: свой myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
