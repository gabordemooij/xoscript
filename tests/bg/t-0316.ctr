>> Дядо := Обект нов.
Дядо при: ['поздрави'] изпълни: {
	Изход пиши: ['Аве!'], нов-ред.
}.
>> Баща := Дядо нов.
Баща при: ['поздрави'] изпълни: {
	Изход пиши: ['Hello'], нов-ред.
	себе поздрави.
}.
>> Син := Баща нов.
Син при: ['поздрави'] изпълни: {
	Изход пиши: ['Здрасти'], нов-ред.
	себе поздрави.
}.

Син поздрави.

>> Кръгово := Обект нов.
Кръгово при: ['circle:'] изпълни: { :x
	Изход пиши: x, нов-ред.
	(x < 3) вярно: { себе рекурсивен circle: x + 1. }.
}.

Кръгово circle: 1.

>> x := 1.
>> увеличи := { (x ≤ 3) вярно: { Изход пиши: x, нов-ред. x добави: 1.  увеличи стартирай. }. }.
увеличи стартирай.