>> Grandfather := Обект нов.
Grandfather при: ['greet'] изпълни: {
	Изход пиши: ['Ave!'], нов-ред.
}.
>> Father := Grandfather нов.
Father при: ['greet'] изпълни: {
	Изход пиши: ['Hello'], нов-ред.
	себе greet.
}.
>> Son := Father нов.
Son при: ['greet'] изпълни: {
	Изход пиши: ['Hi'], нов-ред.
	себе greet.
}.

Son greet.

>> Roundabout := Обект нов.
Roundabout при: ['circle:'] изпълни: { :x
	Изход пиши: x, нов-ред.
	(x < 3) вярно: { себе рекурсивен circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) вярно: { Изход пиши: x, нов-ред. x добави: 1.  increment стартирай. }. }.
increment стартирай.