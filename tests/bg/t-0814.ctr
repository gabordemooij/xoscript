# формат на бисквитката за сесия, тип съдържание json, само уеб протоколи, svg се показва вградено
Server инициализирай.
Програма използвай: ['../../../src/xo/bg/webtools.xo'].

>> Фалшива-заявка := Обект нов.
Фалшива-заявка при: ['value:'] изпълни: { :стойност
	свой стойност := стойност.
}.
Фалшива-заявка при: ['cookie:'] изпълни: { :име
	<- свой стойност.
}.

>> Тестова-сесия := Сесия-временен-файл нов.
Тестова-сесия при: ['зареди'] изпълни: {
	<- Речник нов.
}.
Тестова-сесия при: ['ид-на-сесия'] изпълни: {
	<- свой id.
}.

>> бисквитки := Списък нов
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

бисквитки всеки: { :i :бисквитка
	>> http-заявка := Фалшива-заявка нов.
	http-заявка value: бисквитка.
	>> управител := Тестова-сесия нов.
	>> уеб := Уеб-документ нов.
	уеб http-заявка: http-заявка.
	уеб управител-сесии: управител.
	уеб започни-сесия.
	Изход пиши: ( управител ид-на-сесия = бисквитка ), нов-ред.
}.

>> уеб := Уеб-документ нов.
уеб json: (Речник нов постави: ['b'] на: ['a']).
Изход пиши: ['\n'], нов-ред.

{ Мрежа get: ['file:///etc/hostname']. } прихвани: { :e
	Изход пиши: e, нов-ред.
}, стартирай.

>> svg := Файл нов: ['/tmp/test0814.svg'].
svg пиши: ['<svg xmlns="x"></svg>'].
Изход нов-ред.
Server предай: ['test0814.svg'] префикс: ['/tmp/'].
svg изтрий.
