Изход пиши: ['Test object'], нов-ред.
>> a := Обект нов. 

a при: ['item:'] изпълни: { :hexhelper
	свой hexhelper := hexhelper. 
}.

a при: ['item'] изпълни: { <- свой hexhelper.
}.

a item: Hx нов.

>> old-hexhelper-address := a item прототип адрес-в-паметта.
a save-as: ['/tmp/a.bin'].
Изход пиши: ['========== RELOADING SNAP:'], нов-ред.

>> b := Обект load-from: ['/tmp/a.bin'].

(b item прототип адрес-в-паметта = old-hexhelper-address) вярно: {
	Изход пиши: ['Object link re-attached.'], нов-ред.
}.
