Изход пиши: ['Тестов обект'], нов-ред.
>> a := Обект нов. 

a при: ['item:'] изпълни: { :хекс-помощник
	свой хекс-помощник := хекс-помощник. 
}.

a при: ['предмет'] изпълни: {
	<- свой хекс-помощник.
}.

a item: Hx нов.

>> стар-адрес-хекс-помощник := a предмет прототип адрес-в-паметта.
a save-as: ['/tmp/a.bin'].
Изход пиши: ['========== ПРЕЗАРЕЖДАНЕ НА SNAP:'], нов-ред.

>> b := Обект load-from: ['/tmp/a.bin'].

(b предмет прототип адрес-в-паметта = стар-адрес-хекс-помощник) вярно: {
	Изход пиши: ['Връзката на обекта е закачена отново.'], нов-ред.
}.
