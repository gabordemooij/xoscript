# test qualifiers

Програма почисти.

>> Fruit := Обект нов.
Fruit при: ['нов'] изпълни: {
	>> f := себе нов.
	f apples: 0. <- f.
}.
Fruit при: ['apples:'] изпълни: { :a свой apples := a. }.
Fruit при: ['apples'] изпълни: { <- свой apples. }.
Fruit при: ['+'] изпълни: { :f
	>> n := Fruit нов.
	n apples: (f apples + свой apples). <- n.
}.
Число при: ['apples'] изпълни: { <- ((Fruit нов) apples: себе).
}.

Fruit при: ['текст'] изпълни: { <- свой apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Изход пиши: q, нов-ред.




q := 3 apples + 4 apples.
Изход пиши: q, нов-ред.



q := 3 apples + 4 apples.
Изход пиши: q, нов-ред.


