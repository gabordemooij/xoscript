# тест на определения

Програма почисти.

>> Плод := Обект нов.
Плод при: ['нов'] изпълни: {
	>> f := себе нов.
	f apples: 0. <- f.
}.
Плод при: ['apples:'] изпълни: { :a свой ябълки := a. }.
Плод при: ['ябълки'] изпълни: { <- свой ябълки. }.
Плод при: ['+'] изпълни: { :f
	>> n := Плод нов.
	n apples: (f ябълки + свой ябълки). <- n.
}.
Число при: ['ябълки'] изпълни: { <- ((Плод нов) apples: себе).
}.

Плод при: ['текст'] изпълни: { <- свой ябълки + [' ябълки '].
}.

>> q := 3 ябълки + 4 ябълки.
Изход пиши: q, нов-ред.




q := 3 ябълки + 4 ябълки.
Изход пиши: q, нов-ред.



q := 3 ябълки + 4 ябълки.
Изход пиши: q, нов-ред.


