Програма управление-на-паметта: 0.
Списък при: ['сума'] изпълни: {
	>> общо := 0.
	себе всеки: { :индекс :член
		общо добави: член.
	}. <- общо.
}.

>> използвана-памет1 := 0.
>> използвана-памет2 := 0.
>> използвана-памет3 := 0.
>> използвана-памет4 := 0.



>> f := Файл нов: ['/tmp/test.txt'].
f пиши: ['Lorem Ipsum'].
f затвори.
  

f := Файл нов: ['/tmp/test.txt'].
>> надпис := f чети.
f затвори.



Програма почисти.
използвана-памет1 := (Програма памет ? 1).



f := Файл нов: ['/tmp/test.txt'].
надпис := f чети.
f затвори.

Програма почисти.
използвана-памет2 := (Програма памет ? 1).


f := Файл нов: ['/tmp/test.txt'].
надпис := f чети.
f затвори.

Програма почисти.
използвана-памет3 := (Програма памет ? 1).



( използвана-памет1 = използвана-памет2 и: използвана-памет1 = използвана-памет3, и: използвана-памет2 = използвана-памет3 ) вярно: {
	Изход пиши: ['Тук няма изтичане на памет'].
}, невярно: {
	Изход пиши: ['Изтича памет...'].
}.
