>> items := Речник нов.
items постави: ['black'] на: ['coffee'], постави: ['earl grey'] на: ['tea'].
Изход пиши: (items на: ['coffee']), пиши: (items на: ['tea']).
Изход пиши: ['there are'] + items брой + [' items in the array.'].
items постави: ['capuccino'] на: ['coffee'].
Изход пиши: ['Now my coffee is.. '] + (items на: ['coffee']).
items постави: ['aaa'] на: ['1'].
items постави: ['bbb'] на: ['2'].
Изход пиши: (items на: ['a']).
