

Текст при: ['изчисли'] изпълни: {
	>> код := Файл нов: ['/tmp/eval.ctr'].
	код пиши: себе текст + ['.'].
	Програма използвай: ['/tmp/eval.ctr'].
}.

>> a := (Списък ← (
	(Речник нов)
		постави: ['domain'] на: ['mywebsite.com'],
		постави: (Списък ←
			((Речник нов)
				постави: ['начало'] на: ['title'],
				постави: ['<html></html>'] на: ['body'],
				постави: ['2017-01-01'] на: ['създадено']
			) ;
			((Речник нов)
				постави: ['aboutus(c)'] на: ['title'],
				постави: ['<credits>Author Inc.</credits>'] на: ['body']
			)
		) на: ['страници']
	)
) текст.

Изход пиши: a тип, нов-ред.
Изход пиши: a, нов-ред.

>> b := Нищо.
(['b := '] + a) изчисли.
Изход пиши: b ? 0 ? ['страници'] ? 1 ? ['body'], нов-ред.

>> c := b ? 0.
>> d := c текст.
Изход пиши: d тип, нов-ред.

>> e := Нищо.
(['e := '] + d) изчисли.
Изход пиши: e ? ['страници'] ? 0, нов-ред.
