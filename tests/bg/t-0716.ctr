Изход пиши: ['Тестов обект'], нов-ред.
>> a := Обект нов. 

a при: ['state:'] изпълни: { :list
	свой list := list. 
}.

a при: ['състояние'] изпълни: {
	Изход пиши: свой list, нов-ред.
}.

a state: ( Списък нов ; ['елемент-от-списък'] ; ['предмет2'] ).
a състояние.

a save-as: ['/tmp/a.bin'].
Изход пиши: ['========== ПРЕЗАРЕЖДАНЕ НА SNAP:'], нов-ред.
>> b := Обект load-from: ['/tmp/a.bin'].
b състояние.