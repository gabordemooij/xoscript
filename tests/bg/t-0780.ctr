Server init.

# JSON енкодерът поддържа само UTF-8, без surrogate двойки

>> речници := Списък нов ;
	# {"key":"normal"} нормален ASCII
	( Речник нов постави: ['нормално'] на: ['key'] ) ;
	# {"key":"hello world"} знак интервал
	( Речник нов постави: ['hello world'] на: ['key'] ) ;
	# {"key":"quote: \""} двойна кавичка
	( Речник нов постави: ['"'] на: ['key'] ) ;
	# {"key":"backslash: \\"} обратна наклонена черта
	( Речник нов постави: ['backslash: \\'] на: ['key'] ) ;
	# {"key":"slash: /"} наклонена черта
	( Речник нов постави: ['наклонена черта: /'] на: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( Речник нов постави: ['backspace: \b'] на: ['key'] ) ;
	# {"key":"formfeed: \f"} escape за form-feed
	( Речник нов постави: ['formfeed: \f'] на: ['key'] ) ;
	# {"key":"newline: \n"} нов ред
	( Речник нов постави: ['newline: \n'] на: ['key'] ) ;
	( Речник нов постави: ['newline: ↵'] на: ['key'] ) ;
	( Речник нов постави: ['newline: 
	'] на: ['key'] ) ;
	# {"key":"carriage return: \r"} връщане на каретката
	( Речник нов постави: ['carriage return: \r'] на: ['key'] ) ;
	# {"key":"tab: \t"} табулация
	( Речник нов постави: ['tab \t'] на: ['key'] ) ;
	( Речник нов постави: ['tab ⇿'] на: ['key'] ) ;
	( Речник нов постави: ['табулация  '] на: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( Речник нов постави: ['NUL \u0000'] на: ['key'] ) ;
	( Речник нов постави: ['NUL \0'] на: ['key'] ) ;
	# {"key":"control: \u0001"} управляващ знак 0x01
	( Речник нов постави: ['control: \u0001'] на: ['key'] ) ;
	# {"key":"control: \u001F"} управляващ знак 0x1F
	( Речник нов постави: ['control: \u001F'] на: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-байтов знак
	( Речник нов постави: ['уникод: é'] на: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-байтов знак
	( Речник нов постави: ['уникод: €'] на: ['key'] ) ;
	# {"key":"unicode: 日本語"} няколко 3-байтови UTF-8 знака
	( Речник нов постави: ['уникод: 日本語'] на: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-байтов знак
	( Речник нов постави: ['уникод: 😀'] на: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} емоджи + zero-width joiner
	( Речник нов постави: ['уникод: 🧑‍💻'] на: ['key'] ) ;
	# {"key":"combining: é"} комбиниращ диакритик
	( Речник нов постави: ['combining: e\u0301'] на: ['key'] ) ;
	# {"key":"escaped unicode: é"} Unicode escape BMP
	( Речник нов постави: ['escaped unicode: \u00e9'] на: ['key'] ) ;
	# {"key":"escaped unicode: €"} Unicode escape BMP
	( Речник нов постави: ['escaped unicode: \u20ac'] на: ['key'] ) ;
	# {"key":"escaped unicode: 😀"} UTF-16 surrogate двойка
	( Речник нов постави: ['escaped unicode: \ud83d\ude00'] на: ['key'] ) ;
	# {"key":""} празна стойност
	( Речник нов постави: [''] на: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} специални ASCII знаци
	( Речник нов постави: ['@ < > & = % + ? #'] на: ['key'] ) ;
	# {"key":"single quote: '"} единична кавичка
	( Речник нов постави: ['''] на: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} няколко JSON escape последователности
	( Речник нов постави: ['multiple: \" \\ \n \r \t'] на: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} по-дълъг ASCII текст
	( Речник нов постави: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] на: ['key'] ) ;
	# {"key":" value"} интервал в началото
	( Речник нов постави: [' стойност'] на: ['key'] ) ;
	# {"key":"value "} интервал в края
	( Речник нов постави: ['стойност '] на: ['key'] ) ;
	# {"key":" \t\n\r "} празни знаци
	( Речник нов постави: [' \t\n\r '] на: ['key'] )
	.

речници всеки: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (Речник нов постави: d key на: ['key']).
	>> b := JSON jsonify: (Речник нов постави: ['value'] на: d key).
	>> e := JSON обект: a.
	>> f := JSON обект: b.
	((e key = d key и: (f ? d key = ['value'])) или: (e key = ['NUL ?'])) вярно: {
		Изход пиши: ['OK'], нов-ред.
	}, иначе: {
		Изход пиши: ['Не може да се кодира/декодира правилно: '] + d + j, нов-ред.
		Програма край.
	}.
}.
