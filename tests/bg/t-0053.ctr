60 × {
	>> x := (Число random % 6) + 1.
	(x ≤ 6) невярно: { Изход пиши: ['FAIL']. }.
	(x ≥0) невярно: { Изход пиши: ['FAIL']. }.
	x := (Число random % 3) + 1.
	(x < 3) невярно: { Изход пиши: ['FAIL']. }.
	(x>-1) невярно: { Изход пиши: ['FAIL']. }.
	x := ((Логически flip) число).
	(x = 0 или: x = 1) невярно: { Изход пиши: ['FAIL']. }.
	x := ((Вярно flip) число).
	(x = 0 или: x = 1) невярно: { Изход пиши: ['FAIL']. }.
	x := (Логически flip или: ['HEAD'] или: ['TAIL']).
	((x = ['HEAD']) или: (x = ['TAIL'])) невярно: { Изход пиши: ['FAIL']. }.
}.
Изход пиши: ['DONE'].

