60 × {
	>> x := (Число random % 6) + 1.
	(x ≤ 6) невярно: { Изход пиши: ['ПРОВАЛ']. }.
	(x ≥0) невярно: { Изход пиши: ['ПРОВАЛ']. }.
	x := (Число random % 3) + 1.
	(x < 3) невярно: { Изход пиши: ['ПРОВАЛ']. }.
	(x>-1) невярно: { Изход пиши: ['ПРОВАЛ']. }.
	x := ((Логически flip) число).
	(x = 0 или: x = 1) невярно: { Изход пиши: ['ПРОВАЛ']. }.
	x := ((Вярно flip) число).
	(x = 0 или: x = 1) невярно: { Изход пиши: ['ПРОВАЛ']. }.
	x := (Логически flip или: ['ЕЗИ'] или: ['ТУРА']).
	((x = ['ЕЗИ']) или: (x = ['ТУРА'])) невярно: { Изход пиши: ['ПРОВАЛ']. }.
}.
Изход пиши: ['ГОТОВО'].

