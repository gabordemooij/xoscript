Изход пиши: ['Тестов обект'], нов-ред.
>> a := Обект нов. 

a при: ['item:'] изпълни: { :изх
	свой изх := изх. 
}.

a при: ['предмет'] изпълни: {
	<- свой изх.
}.

a при: ['поздрави'] изпълни: {
	Изход пиши: ['здрасти от оригиналния изход!'], нов-ред.
}.

a item: Изход.

Изход пиши: a предмет, нов-ред.

>> стар-адрес-изх := a предмет прототип адрес-в-паметта.
a save-as: ['/tmp/a.bin'].
Изход пиши: ['========== ПРЕЗАРЕЖДАНЕ НА SNAP:'], нов-ред.

>> b := Обект load-from: ['/tmp/a.bin'].

(b предмет прототип адрес-в-паметта = стар-адрес-изх) вярно: {
	Изход пиши: ['Връзката на обекта е закачена отново.'], нов-ред.
}.

b предмет пиши: ['здравей от заредения изход!'], нов-ред.
b поздрави.
