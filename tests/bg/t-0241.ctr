

Текст при: ['evaluate'] изпълни: {
	>> код := Файл нов: ['/tmp/eval.ctr'].
	код пиши: (себе текст + ['.']).
	Програма използвай: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Списък ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q текст.
Изход пиши: x, нов-ред.
>> y := Нищо.
(['y := '] + x ) evaluate.
Изход пиши: y ? 0, нов-ред.

q := Речник постави: ['\[''] на: ['\['quote\']'].
x := q текст.
Изход пиши: x, нов-ред.
y := Нищо.
(['y := '] + x ) evaluate.

>> q := (Речник нов) постави:['\[''] на:['\['quote\[''].
Изход пиши: y ? ['\['quote\']'], нов-ред.
