# използване на FFI с плъгина Server

# свързване с libc (зависи от платформата)
>> име-библ := Програма настройка: ['FFITESTLIB'].

# свързване на stdio функции от C за разширени файлови операции
Server свържи: ( Списък нов ;
 име-библ ; ['fopen'] ;
 ( Списък нов ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
свържи: ( Списък нов ;
 Нищо ; # означава същата библиотека
 ['fread'] ;
 ( Списък нов ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Нищо ; # означава същия обект (т.е. Поток)
 ['fread']
),
свържи: (
 Списък нов ;
 Нищо ; # означава същата библиотека
 ['fwrite'] ;
 ( Списък нов ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Нищо ; # означава същата библиотека
 ['fwrite']
),
свържи: (
 Списък нов ;
 Нищо ; # означава същата библиотека
 ['rewind'] ;
 ( Списък нов ; ['pointer'] ) ;
 ['int'] ;
 Нищо ; # означава същата библиотека
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> път := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# отваряне на файл с fopen(path, mode)
>> фд := Stream path: път mode: mode.

# запис на байтове от буфера низ във файла
>> записани-байтове := Stream съобщение: ['fwrite'] аргументи: (Списък нов ; str ; 1 ; 6 ; фд ).
Изход пиши: записани-байтове, нов-ред.

# връщане на файловия указател в началото
Stream rewind: фд.

# заделяне на буфер
>> буф := Blob нов: 20.

# четене от файла
>> прочетени-байтове := Stream съобщение: ['fread'] аргументи: (Списък нов ; буф ; 1 ; 6 ; фд ).
Изход пиши: прочетени-байтове, нов-ред.
Изход пиши: буф, нов-ред.

# освобождаване на паметта
str  освободи.
път освободи.
mode освободи.
буф  освободи.


