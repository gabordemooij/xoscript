# стойност, завършваща с първата част на отваряща кавичка, трябва да оцелее при сериализация
>> стойности := Списък нов
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

стойности всеки: { :i :value
	>> d := Речник нов.
	d постави: value на: ['k'].
	d постави: ['second'] на: ['j'].
	>> r := d код обект.
	Изход пиши: r брой, нов-ред.
	Изход пиши: ( (r на: ['k']) = value ), нов-ред.
}.
