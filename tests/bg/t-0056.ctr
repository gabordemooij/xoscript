>> z := Обект нов.
z при: ['value:'] изпълни: { :v
	свой value := v. <- себе.
}.
z при: ['value'] изпълни: { <- свой value. }.
(z setValue: 1) value: 2.
Изход пиши: z value.
>> x := z.
Изход пиши: x value.
z := Нищо.
Изход пиши: z value.
Изход пиши: x value.
Изход пиши: ['hello'].
Изход пиши: 3 + 2.
Изход пиши: (3 > 2).
