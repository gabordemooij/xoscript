>> винарна := { <- (	Речник нов
		постави: 2 на: ['merlot'],
		постави: 3 на: ['malbec'],
		постави: 4 на: ['syrah']
	).
}.

Изход пиши: (((винарна стартирай) - ['нищо']) брой), нов-ред.
