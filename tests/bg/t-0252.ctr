#Linux
>> clock := Момент нов.
clock зона: ['UTC-1'].
clock година: 1981, месец: 1, ден: 5,
      час: 13, минута: 15, секунда: 13.

Изход пиши: clock, нов-ред.
clock зона: ['UTC+0'].

Изход пиши: (
	(clock година обикновен) + ['-'] + (clock месец) + ['-'] + (clock ден) + [' '] +
	(clock час) + [':'] + (clock минута) + [':'] + (clock секунда) + [' '] +
	['W'] + (clock седмица) + (clock зона)
), нов-ред.


clock зона: ['UTC-1'].
Изход пиши: (
	(clock година обикновен) + ['-'] + (clock месец) + ['-'] + (clock ден) + [' '] +
	(clock час) + [':'] + (clock минута) + [':'] + (clock секунда) + [' '] +
	['W'] + (clock седмица) + (clock зона)
), нов-ред.
