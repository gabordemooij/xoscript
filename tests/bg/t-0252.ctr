#Linux
>> часовник := Момент нов.
часовник зона: ['UTC-1'].
часовник година: 1981, месец: 1, ден: 5,
      час: 13, минута: 15, секунда: 13.

Изход пиши: часовник, нов-ред.
часовник зона: ['UTC+0'].

Изход пиши: (
	(часовник година обикновен) + ['-'] + (часовник месец) + ['-'] + (часовник ден) + [' '] +
	(часовник час) + [':'] + (часовник минута) + [':'] + (часовник секунда) + [' '] +
	['W'] + (часовник седмица) + (часовник зона)
), нов-ред.


часовник зона: ['UTC-1'].
Изход пиши: (
	(часовник година обикновен) + ['-'] + (часовник месец) + ['-'] + (часовник ден) + [' '] +
	(часовник час) + [':'] + (часовник минута) + [':'] + (часовник секунда) + [' '] +
	['W'] + (часовник седмица) + (часовник зона)
), нов-ред.
