Програма управление-на-паметта: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } прихвани: {
		oops добави: 1.
	}, стартирай.
} × 1000.

{
	Изход пиши: ['hi there!'].
	тази-задача грешка: ['oops'].
	Изход пиши: ['hi there!'].
	{ Изход пиши: ['dont print this']. } стартирай.
} прихвани: { :e 
	Изход пиши: ['got ya!']. 
	Изход пиши: e.
}, стартирай.
