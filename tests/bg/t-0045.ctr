Програма управление-на-паметта: 4.

>> опа := 0.
{
	{ 3 ÷ 0. } прихвани: {
		опа добави: 1.
	}, стартирай.
} × 1000.

{
	Изход пиши: ['здравейте там!'].
	тази-задача грешка: ['oops'].
	Изход пиши: ['здравейте там!'].
	{ Изход пиши: ['не печатай това']. } стартирай.
} прихвани: { :e 
	Изход пиши: ['хванах те!']. 
	Изход пиши: e.
}, стартирай.
