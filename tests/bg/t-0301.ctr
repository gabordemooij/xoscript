


>> вино := Обект нов.


вино при: ['към-текст'] изпълни: { <- ['merlot'].
}.

вино при: ['naarTekst'] изпълни: { <- ['merlot'].
}.


вино при: ['='] изпълни: { :other wine <- ( себе към-текст = other wine ).
}.

вино при: ['=='] изпълни: { :other wine <- ( себе към-текст = other wine ).
}.



вино
	случай: ['cabernet'] изпълни: { Изход пиши: ['това е Каберне!']. },
	случай: ['syrah']    изпълни: { Изход пиши: ['това е Сира!'].    },
	случай: ['merlot']   изпълни: { Изход пиши: ['това е Мерло!'].   },
	случай: ['malbec']   изпълни: { Изход пиши: ['това е Малбек!'].   }.

Изход нов-ред.
