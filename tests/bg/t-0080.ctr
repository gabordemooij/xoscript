{
	>> a := Списък нов.
	a добави-в-края: 1.
	a добави-в-края: 2.
	Изход пиши: (a съедини: [',']), нов-ред.
	a постави: 3 на: 2.
	Изход пиши: (a съедини: [',']), нов-ред.
	a постави: 4 на: 10.
	Изход пиши: (a съедини: [',']), нов-ред.
	a извади-първия.
	a извади-първия.
	a извади-първия.
	Изход пиши: (a съедини: [',']), нов-ред.
	a постави: 9 на: 0.
	Изход пиши: (a съедини: [',']), нов-ред.
	a постави: 6 на: -1.
} прихвани: { :e
	Изход пиши: ['Uncatched error has occurred.↵'] + e, нов-ред.
}, стартирай.


