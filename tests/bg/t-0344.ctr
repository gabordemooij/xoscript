# тест на прихващане на всичко (практически)
>> HTML := Текст нов.
HTML при: ['encode:'] изпълни: { :текстче
	себе добави-в-края: (текстче
	замени: ['&'] с: ['&amp;'], 
	замени: ['<'] с: ['&lt;'],
	замени: ['>'] с: ['&gt;'],
	замени: ['"'] с: ['&quot;']).
}.
>> блог := HTML нов.
блог добави-в-края: ['<h1>'],
     encode: ['Koffie & Thee'],
     добави-в-края: ['</h1>'].
Изход пиши: блог, нов-ред.


>> Римско := Число нов.
Римско при: ['като-текст'] изпълни: {
	>> a := [''].
	{ a добави-в-края: ['I']. } × себе. <- a.
}.

>> x := Римско нов.
x добави: 3.
Изход пиши: x като-текст, нов-ред.

>> Квант := Логически нов.
Квант при: ['true?'] изпълни: { <- ['може би Вярно']. }.
Изход пиши: (Квант нов true?), нов-ред.

>> Nihil := Нищо нов.
Nihil при: ['текст'] изпълни: { <- ['Nihil']. }.
Изход пиши: (Nihil нов), нов-ред.
