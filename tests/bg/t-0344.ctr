# catch-all test (practical)
>> HTML := Текст нов.
HTML при: ['encode:'] изпълни: { :tekst
	себе добави-в-края: (tekst
	замени: ['&'] с: ['&amp;'], 
	замени: ['<'] с: ['&lt;'],
	замени: ['>'] с: ['&gt;'],
	замени: ['"'] с: ['&quot;']).
}.
>> blog := HTML нов.
blog добави-в-края: ['<h1>'],
     encode: ['Koffie & Thee'],
     добави-в-края: ['</h1>'].
Изход пиши: blog, нов-ред.


>> Roman := Число нов.
Roman при: ['stringy'] изпълни: {
	>> a := [''].
	{ a добави-в-края: ['I']. } × себе. <- a.
}.

>> x := Roman нов.
x добави: 3.
Изход пиши: x stringy, нов-ред.

>> Quantum := Логически нов.
Quantum при: ['true?'] изпълни: { <- ['maybe True']. }.
Изход пиши: (Quantum нов true?), нов-ред.

>> Nihil := Нищо нов.
Nihil при: ['текст'] изпълни: { <- ['Nihil']. }.
Изход пиши: (Nihil нов), нов-ред.
