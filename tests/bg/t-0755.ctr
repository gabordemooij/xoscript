Изход пиши: ['Test object'], нов-ред.
>> greeter := Обект нов.
greeter при: ['name:'] изпълни: { :име
	свой xname := име. 
}.
greeter при: ['greet'] изпълни: {
	Изход пиши: ['Hello '] + свой xname, нов-ред.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Изход пиши: ['========== RELOADING SNAP:'], нов-ред.
>> b := Обект load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
