Изход пиши: ['Test object'], нов-ред.
>> a := Обект нов. 

a при: ['item:'] изпълни: { :fmt
	свой fmt := fmt. 
}.

a при: ['item'] изпълни: { <- свой fmt.
}.

a item: ( Формат нов: ['|%s|'] ).

Изход пиши: a item, нов-ред.

>> old-fmt-address := a item прототип адрес-в-паметта.
a save-as: ['/tmp/a.bin'].
Изход пиши: ['========== RELOADING SNAP:'], нов-ред.

>> b := Обект load-from: ['/tmp/a.bin'].

(b item прототип адрес-в-паметта = old-fmt-address) вярно: {
	Изход пиши: ['Object link re-attached.'], нов-ред.
}.

Изход пиши: ( b item приложи: ['hello'] ), нов-ред.
