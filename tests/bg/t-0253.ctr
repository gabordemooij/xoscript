#Linux
>> OS := Програма настройка: ['OS'].

>> часовник := Момент нов.
	
(OS = ['Haiku']) вярно: {
	часовник зона: ['CET'],
	година: 2017, месец: 7, ден: 13,
	час: 18, минута: 0, секунда: 0.
}, иначе: {
	часовник зона: ['Europe/Amsterdam'],
	година: 2017, месец: 7, ден: 13,
	час: 18, минута: 0, секунда: 0.
}.

часовник при: ['кажи-часа'] изпълни: {
	Изход пиши: себе, нов-ред.
}.


часовник добави: 2    час, кажи-часа.
часовник добави: 1    час, кажи-часа.
часовник добави: 19 минута, кажи-часа.
часовник добави: 1  минута, кажи-часа.
часовник добави: 1  минута, кажи-часа.
часовник добави: 19 секунда, кажи-часа.
часовник добави: 1  секунда, кажи-часа.
часовник добави: 1  секунда, кажи-часа.
часовник добави: 2    година, кажи-часа.
часовник добави: 1    година, кажи-часа.

(OS = ['Haiku']) вярно: {
часовник добави: 5   месец.
часовник зона: ['CEST'], кажи-часа.
}, иначе: {
	часовник добави: 5   месец, кажи-часа.
}.

часовник добави: 1   месец, кажи-часа.
часовник добави: 19    ден, кажи-часа.
