#Linux
>> OS := Програма настройка: ['OS'].

>> clock := Момент нов.
	
(OS = ['Haiku']) вярно: {
	clock зона: ['CET'],
	година: 2017, месец: 7, ден: 13,
	час: 18, минута: 0, секунда: 0.
}, иначе: {
	clock зона: ['Europe/Amsterdam'],
	година: 2017, месец: 7, ден: 13,
	час: 18, минута: 0, секунда: 0.
}.

clock при: ['tell'] изпълни: {
	Изход пиши: себе, нов-ред.
}.


clock добави: 2    час, tell.
clock добави: 1    час, tell.
clock добави: 19 минута, tell.
clock добави: 1  минута, tell.
clock добави: 1  минута, tell.
clock добави: 19 секунда, tell.
clock добави: 1  секунда, tell.
clock добави: 1  секунда, tell.
clock добави: 2    година, tell.
clock добави: 1    година, tell.

(OS = ['Haiku']) вярно: {
clock добави: 5   месец.
clock зона: ['CEST'], tell.
}, иначе: {
	clock добави: 5   месец, tell.
}.

clock добави: 1   месец, tell.
clock добави: 19    ден, tell.
clock добави: 1    час, tell.
clock добави: 120  yard, tell.
