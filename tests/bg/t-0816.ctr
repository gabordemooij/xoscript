# форматът трябва да отговаря на типа на стойността, типът може да идва от клиент
>> опитай := { :форматът :value
	{ Изход пиши: ( (Формат нов: форматът) приложи: value ), нов-ред. } прихвани: { :e Изход пиши: e, нов-ред. }, стартирай.
}.
>> опитай-цяло := { :форматът :value
	{ Изход пиши: ( (Формат нов: форматът) приложи-цяло: value ), нов-ред. } прихвани: { :e Изход пиши: e, нов-ред. }, стартирай.
}.

# пасва
опитай приложи: ['|%s|'] и: ['text'].
опитай приложи: ['%06.2f'] и: 5.5.
опитай приложи: ['100%% %s'] и: ['сигурно'].
опитай-цяло приложи: ['%03d'] и: 7.
опитай-цяло приложи: ['%x'] и: 255.
опитай приложи: ['%d'] и: (Int64 нов от-текст: ['12']).
опитай приложи: ['%lld'] и: (Int64 нов от-текст: ['12']).
опитай приложи: ['%.1lf'] и: 5.5.
опитай-цяло приложи: ['%hd'] и: 7.

# не пасва
опитай приложи: ['%s'] и: 12345.
опитай приложи: ['%d'] и: 12345.
опитай приложи: ['%f'] и: ['text'].
опитай-цяло приложи: ['%d'] и: ['text'].
опитай-цяло приложи: ['%s'] и: 5.
опитай приложи: ['%s %s'] и: ['text'].
опитай приложи: ['%n'] и: ['text'].
опитай приложи: ['%*s'] и: ['text'].
опитай приложи: ['%'] и: ['text'].

# модификаторът на дължина не пасва
опитай приложи: ['%ls'] и: ['text'].
опитай приложи: ['%Lf'] и: 5.5.
опитай-цяло приложи: ['%ld'] и: 7.
опитай-цяло приложи: ['%lld'] и: 7.
опитай приложи: ['%Ld'] и: (Int64 нов от-текст: ['12']).

# ширина, която не пасва на printf, трябва да даде грешка, а не срив
опитай приложи: ['%99999999999s'] и: ['text'].
