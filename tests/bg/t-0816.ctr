# a format must fit the type of the value, the type can come from a client
>> опитай := { :format :value
	{ Изход пиши: ( (Формат нов: format) приложи: value ), нов-ред. } прихвани: { :e Изход пиши: e, нов-ред. }, стартирай.
}.
>> try-int := { :format :value
	{ Изход пиши: ( (Формат нов: format) приложи-цяло: value ), нов-ред. } прихвани: { :e Изход пиши: e, нов-ред. }, стартирай.
}.

# fits
опитай приложи: ['|%s|'] и: ['text'].
опитай приложи: ['%06.2f'] и: 5.5.
опитай приложи: ['100%% %s'] и: ['sure'].
try-int приложи: ['%03d'] и: 7.
try-int приложи: ['%x'] и: 255.
опитай приложи: ['%d'] и: (Int64 нов от-текст: ['12']).
опитай приложи: ['%lld'] и: (Int64 нов от-текст: ['12']).
опитай приложи: ['%.1lf'] и: 5.5.
try-int приложи: ['%hd'] и: 7.

# does not fit
опитай приложи: ['%s'] и: 12345.
опитай приложи: ['%d'] и: 12345.
опитай приложи: ['%f'] и: ['text'].
try-int приложи: ['%d'] и: ['text'].
try-int приложи: ['%s'] и: 5.
опитай приложи: ['%s %s'] и: ['text'].
опитай приложи: ['%n'] и: ['text'].
опитай приложи: ['%*s'] и: ['text'].
опитай приложи: ['%'] и: ['text'].

# length modifier does not fit
опитай приложи: ['%ls'] и: ['text'].
опитай приложи: ['%Lf'] и: 5.5.
try-int приложи: ['%ld'] и: 7.
try-int приложи: ['%lld'] и: 7.
опитай приложи: ['%Ld'] и: (Int64 нов от-текст: ['12']).

# a width that does not fit printf must give an error, not a crash
опитай приложи: ['%99999999999s'] и: ['text'].
