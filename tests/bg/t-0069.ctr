

Текст при: ['html'] изпълни: { <- (
		себе
		замени: ['&'] с: ['&amp;'],
		замени: ['<'] с: ['&lt;'],
		замени: ['>'] с: ['&gt;'],
		замени: ['"'] с: ['&quot;']
	).
}.


Изход пиши: ([' подрязано отляво '] изрежи) + [' '] + ( ['и подрязано отдясно'] изрежи) + ['!'], нов-ред.
Изход пиши: ['<html>"html & entities"</html>'] html.
