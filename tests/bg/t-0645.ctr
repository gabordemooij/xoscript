Server init.
Изход пиши: ['Database date test'], нов-ред.

>> db := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'], 
	парола: ['pass123'],
	име-на-база: ['xobase'],
	свържи-се.

>> параметри-за-търсене :=
db заявка: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
извлечи: { :row
	Изход пиши: row datetest, нов-ред.
}.
