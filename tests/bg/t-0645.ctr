Server init.
Изход пиши: ['Тест на дата в базата данни'], нов-ред.

>> бд := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'], 
	парола: ['pass123'],
	име-на-база: ['xobase'],
	свържи-се.

>> параметри-за-търсене :=
бд заявка: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
извлечи: { :редица
	Изход пиши: редица datetest, нов-ред.
}.
