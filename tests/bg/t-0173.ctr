

Списък при: ['sum'] изпълни: {
	>> total := 0.
	себе всеки: { :index :element
		total добави: element.
	}. <- total.
}.

Списък при: ['product'] изпълни: {
	>> total := 1.
	себе всеки: { :index :element
		total умножи-по: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програма управление-на-паметта: 0.

{

>> a := Списък ← ['hello'] ; ['world'] ; Вярно ; Нищо ; 666.
a := a + ( Списък ← 1 ).
Изход пиши: ( ['sum: '] + ( a sum ) ), нов-ред.
Изход пиши: ( ['min: '] + ( a минимум ) ), нов-ред.
Изход пиши: ( ['max: '] + ( a максимум ) ), нов-ред.
Изход пиши: ( ['3rd: '] + ( a ? 2 ) ), нов-ред.
Изход пиши: ( ['prd: '] + ( a product ) ), нов-ред.
a сортирай: { :a :b <- (b - a). }.
a всеки: { :i :e Изход пиши: ( i - 0 ), нов-ред. }.

} стартирай.

Програма почисти.
usedMemory1 := (Програма памет ? 0).


{

>> a := Списък ← ['hello'] ; ['world'] ; Вярно ; Нищо ; 666.
a := a + ( Списък ← 1 ).
Изход пиши: ( ['sum: '] + ( a sum ) ), нов-ред.
Изход пиши: ( ['min: '] + ( a минимум ) ), нов-ред.
Изход пиши: ( ['max: '] + ( a максимум ) ), нов-ред.
Изход пиши: ( ['3rd: '] + ( a ? 2 ) ), нов-ред.
Изход пиши: ( ['prd: '] + ( a product ) ), нов-ред.
a сортирай: { :a :b <- (b - a). }.
a всеки: { :i :e Изход пиши: ( i - 0 ), нов-ред. }.

} стартирай.



Програма почисти.
usedMemory2 := (Програма памет ? 0).


{

>> a := Списък ← ['hello'] ; ['world'] ; Вярно ; Нищо ; 666.
a := a + ( Списък ← 1 ).
Изход пиши: ( ['sum: '] + ( a sum ) ), нов-ред.
Изход пиши: ( ['min: '] + ( a минимум ) ), нов-ред.
Изход пиши: ( ['max: '] + ( a максимум ) ), нов-ред.
Изход пиши: ( ['3rd: '] + ( a ? 2 ) ), нов-ред.
Изход пиши: ( ['prd: '] + ( a product ) ), нов-ред.
a сортирай: { :a :b <- (b - a). }.
a всеки: { :i :e Изход пиши: ( i - 0 ), нов-ред. }.

} стартирай.



Програма почисти.
usedMemory3 := (Програма памет ? 0).

( usedMemory1 = usedMemory2 и: usedMemory1 = usedMemory3, и: usedMemory2 = usedMemory3 ) вярно: {
	Изход пиши: ['No memory leaks here'].
}, невярно: {
	Изход пиши: ['Leaking memory...'].
}.
