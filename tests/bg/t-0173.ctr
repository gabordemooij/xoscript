

Списък при: ['сума'] изпълни: {
	>> общо := 0.
	себе всеки: { :индекс :член
		общо добави: член.
	}. <- общо.
}.

Списък при: ['произведение'] изпълни: {
	>> общо := 1.
	себе всеки: { :индекс :член
		общо умножи-по: член.
	}. <- общо.
}.

>> използвана-памет1 := 0.
>> използвана-памет2 := 0.
>> използвана-памет3 := 0.
>> използвана-памет4 := 0.

Програма управление-на-паметта: 0.

{

>> a := Списък ← ['hello'] ; ['world'] ; Вярно ; Нищо ; 666.
a := a + ( Списък ← 1 ).
Изход пиши: ( ['сума: '] + ( a сума ) ), нов-ред.
Изход пиши: ( ['мин: '] + ( a минимум ) ), нов-ред.
Изход пиши: ( ['макс: '] + ( a максимум ) ), нов-ред.
Изход пиши: ( ['3-ти: '] + ( a ? 2 ) ), нов-ред.
Изход пиши: ( ['прзв: '] + ( a произведение ) ), нов-ред.
a сортирай: { :a :b <- (b - a). }.
a всеки: { :i :e Изход пиши: ( i - 0 ), нов-ред. }.

} стартирай.

Програма почисти.
използвана-памет1 := (Програма памет ? 0).


{

>> a := Списък ← ['hello'] ; ['world'] ; Вярно ; Нищо ; 666.
a := a + ( Списък ← 1 ).
Изход пиши: ( ['сума: '] + ( a сума ) ), нов-ред.
Изход пиши: ( ['мин: '] + ( a минимум ) ), нов-ред.
Изход пиши: ( ['макс: '] + ( a максимум ) ), нов-ред.
Изход пиши: ( ['3-ти: '] + ( a ? 2 ) ), нов-ред.
Изход пиши: ( ['прзв: '] + ( a произведение ) ), нов-ред.
a сортирай: { :a :b <- (b - a). }.
a всеки: { :i :e Изход пиши: ( i - 0 ), нов-ред. }.

} стартирай.



Програма почисти.
използвана-памет2 := (Програма памет ? 0).


{

>> a := Списък ← ['hello'] ; ['world'] ; Вярно ; Нищо ; 666.
a := a + ( Списък ← 1 ).
Изход пиши: ( ['сума: '] + ( a сума ) ), нов-ред.
Изход пиши: ( ['мин: '] + ( a минимум ) ), нов-ред.
Изход пиши: ( ['макс: '] + ( a максимум ) ), нов-ред.
Изход пиши: ( ['3-ти: '] + ( a ? 2 ) ), нов-ред.
Изход пиши: ( ['прзв: '] + ( a произведение ) ), нов-ред.
a сортирай: { :a :b <- (b - a). }.
a всеки: { :i :e Изход пиши: ( i - 0 ), нов-ред. }.

} стартирай.



Програма почисти.
използвана-памет3 := (Програма памет ? 0).

( използвана-памет1 = използвана-памет2 и: използвана-памет1 = използвана-памет3, и: използвана-памет2 = използвана-памет3 ) вярно: {
	Изход пиши: ['Тук няма изтичане на памет'].
}, невярно: {
	Изход пиши: ['Изтича памет...'].
}.
