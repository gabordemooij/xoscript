Изход пиши: ['Test object'], нов-ред.
>> a := Обект нов. 

a при: ['item:'] изпълни: { :binhelper
	свой binhelper := binhelper. 
}.

a при: ['item'] изпълни: { <- свой binhelper.
}.

a item: Bin нов.

>> old-binhelper-address := a item прототип адрес-в-паметта.
a save-as: ['/tmp/a.bin'].
Изход пиши: ['========== RELOADING SNAP:'], нов-ред.

>> b := Обект load-from: ['/tmp/a.bin'].

(b item прототип адрес-в-паметта = old-binhelper-address) вярно: {
	Изход пиши: ['Object link re-attached.'], нов-ред.
}.


