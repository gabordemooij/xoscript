Изход пиши: ['Тестов обект'], нов-ред.
>> a := Обект нов. 

a при: ['item:'] изпълни: { :бин-помощник
	свой бин-помощник := бин-помощник. 
}.

a при: ['предмет'] изпълни: {
	<- свой бин-помощник.
}.

a item: Bin нов.

>> стар-адрес-бин-помощник := a предмет прототип адрес-в-паметта.
a save-as: ['/tmp/a.bin'].
Изход пиши: ['========== ПРЕЗАРЕЖДАНЕ НА SNAP:'], нов-ред.

>> b := Обект load-from: ['/tmp/a.bin'].

(b предмет прототип адрес-в-паметта = стар-адрес-бин-помощник) вярно: {
	Изход пиши: ['Връзката на обекта е закачена отново.'], нов-ред.
}.


