#ffi test


Server init.

Програма управление-на-паметта: 4.

# for this test you need set a path to libc (puts)
>> libname := Програма настройка: ['FFITESTLIB'].



Server свържи: (
 Списък нов ;
 libname ;
 ['puts'] ;
 ( Списък нов ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s освободи.

# test with struct

>> a := Blob нов: 8.
a bytes: (
	Списък <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Списък <<: ['int'], ; ['int']).

Server свържи: (
	Списък <<: ['@structtest'], ;
	['@structtest'] ;
	(Списък <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Изход пиши: ['Sum test:'] + (ffitest ffisum: a), нов-ред.

struct освободи-struct.
struct освободи.
a освободи.
