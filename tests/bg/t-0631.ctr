#ffi тест


Server init.

Програма управление-на-паметта: 4.

# за този тест трябва да зададете път до libc (puts)
>> име-библ := Програма настройка: ['FFITESTLIB'].



Server свържи: (
 Списък нов ;
 име-библ ;
 ['puts'] ;
 ( Списък нов ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s освободи.

# тест със struct

>> a := Blob нов: 8.
a bytes: (
	Списък <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> структура := Blob struct: (Списък <<: ['int'], ; ['int']).

Server свържи: (
	Списък <<: ['@structtest'], ;
	['@structtest'] ;
	(Списък <<: структура) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Изход пиши: ['Тест за сума:'] + (ffitest ffisum: a), нов-ред.

структура освободи-struct.
структура освободи.
a освободи.
