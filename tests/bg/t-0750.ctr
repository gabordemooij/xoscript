Изход пиши: ['Test object'], нов-ред.
>> a := Обект нов. 

a при: ['item:'] изпълни: { :nil
	свой nil := nil. 
}.

a при: ['item'] изпълни: { <- свой nil.
}.

a item: Нищо.

Изход пиши: a item, нов-ред.

>> old-nil-address := a item прототип адрес-в-паметта.
a save-as: ['/tmp/a.bin'].
Изход пиши: ['========== RELOADING SNAP:'], нов-ред.

>> b := Обект load-from: ['/tmp/a.bin'].

(b item прототип адрес-в-паметта = old-nil-address) вярно: {
	Изход пиши: ['Object link re-attached.'], нов-ред.
}.

Изход пиши: b item, нов-ред.
