>> invoice := Обект нов.
invoice при: ['стартирай'] изпълни: {
        свой число := 0.
}.

invoice при: ['число'] изпълни: {
        свой число добави: 1. <- свой число копирай.
}.

>> year-invoice := invoice нов.
year-invoice при: ['start:'] изпълни: { :година
	свой число := година.
}.

year-invoice start: 202000.
Изход пиши: year-invoice число, нов-ред.
Изход пиши: year-invoice число, нов-ред.
