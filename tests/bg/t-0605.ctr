>> фактура := Обект нов.
фактура при: ['стартирай'] изпълни: {
        свой число := 0.
}.

фактура при: ['число'] изпълни: {
        свой число добави: 1.
        <- свой число копирай.
}.

>> годишна-фактура := фактура нов.
годишна-фактура при: ['start:'] изпълни: { :година
	свой число := година.
}.

годишна-фактура start: 202000.
Изход пиши: годишна-фактура число, нов-ред.
Изход пиши: годишна-фактура число, нов-ред.
