Текст при: ['html'] изпълни: { <- (
		себе
		замени: ['&'] с: ['&amp;'],
		замени: ['<'] с: ['&lt;'],
		замени: ['>'] с: ['&gt;'],
		замени: ['''] с: ['&apos;'],
		замени: ['"'] с: ['&quot;']
	).
}.

>> използвана-памет1 := 0.
>> използвана-памет2 := 0.
>> използвана-памет3 := 0.
>> използвана-памет4 := 0.

Програма управление-на-паметта: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Изход пиши: txt копирай html, нов-ред.
Изход пиши: txt копирай малки-букви, нов-ред.
Изход пиши: txt копирай главни-букви, нов-ред.
} стартирай.

Програма почисти.

използвана-памет1 := (Програма памет ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Изход пиши: txt копирай html, нов-ред.
Изход пиши: txt копирай малки-букви, нов-ред.
Изход пиши: txt копирай главни-букви, нов-ред.
} стартирай.

Програма почисти.
използвана-памет2 := (Програма памет ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Изход пиши: txt копирай html, нов-ред.
Изход пиши: txt копирай малки-букви, нов-ред.
Изход пиши: txt копирай главни-букви, нов-ред.
} стартирай.

Програма почисти.
използвана-памет3 := (Програма памет ? 0).



( използвана-памет1 = използвана-памет2 и: използвана-памет1 = използвана-памет3, и: използвана-памет2 = използвана-памет3 ) вярно: {
	Изход пиши: ['Тук няма изтичане на памет'].
}, невярно: {
	Изход пиши: ['Изтича памет...'].
}.
