Текст при: ['html'] изпълни: { <- (
		себе
		замени: ['&'] с: ['&amp;'],
		замени: ['<'] с: ['&lt;'],
		замени: ['>'] с: ['&gt;'],
		замени: ['''] с: ['&apos;'],
		замени: ['"'] с: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програма управление-на-паметта: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Изход пиши: txt копирай html, нов-ред.
Изход пиши: txt копирай малки-букви, нов-ред.
Изход пиши: txt копирай главни-букви, нов-ред.
} стартирай.

Програма почисти.

usedMemory1 := (Програма памет ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Изход пиши: txt копирай html, нов-ред.
Изход пиши: txt копирай малки-букви, нов-ред.
Изход пиши: txt копирай главни-букви, нов-ред.
} стартирай.

Програма почисти.
usedMemory2 := (Програма памет ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Изход пиши: txt копирай html, нов-ред.
Изход пиши: txt копирай малки-букви, нов-ред.
Изход пиши: txt копирай главни-букви, нов-ред.
} стартирай.

Програма почисти.
usedMemory3 := (Програма памет ? 0).



( usedMemory1 = usedMemory2 и: usedMemory1 = usedMemory3, и: usedMemory2 = usedMemory3 ) вярно: {
	Изход пиши: ['No memory leaks here'].
}, невярно: {
	Изход пиши: ['Leaking memory...'].
}.
