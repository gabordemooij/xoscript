#тест на регулярни изрази, с положително look around
Server init.
>> subject := ['bacabcca'].
>> рег-израз := Шаблон нов: ['(\\w{2})(?=ca)'].
>> резултат  := рег-израз съвпадение: subject изпълни: { :m :x
	Изход пиши: m, нов-ред.
	Изход пиши: x, нов-ред.
	<- ['XXX'].
}.
Изход пиши: резултат, нов-ред.
