Server init.

>> бд := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'],
	парола: ['pass123'],
	име-на-база: ['xobase'],
	свържи-се.

>> изтр := бд заявка: ['DELETE FROM book WHERE id > 0'].
{  изтр изпълни. бд потвърди. } прихвани: { :e бд отмени.  }, стартирай.

>> брой := бд заявка: ['SELECT COUNT(*) AS num FROM book'].
брой извлечи: { :редица Изход пиши: редица num, нов-ред. }.
