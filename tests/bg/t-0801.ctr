Server init.

>> db := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'],
	парола: ['pass123'],
	име-на-база: ['xobase'],
	свържи-се.

>> del := db заявка: ['DELETE FROM book WHERE id > 0'].
{  del изпълни. db потвърди. } прихвани: { :e db отмени.  }, стартирай.

>> брой := db заявка: ['SELECT COUNT(*) AS num FROM book'].
брой извлечи: { :row Изход пиши: row num, нов-ред. }.
