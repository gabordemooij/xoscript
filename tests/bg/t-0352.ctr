Число при: ['roman'] изпълни: {
	>> число := себе копирай.
	>> roman := [''].
	{
		{
			(число ≥ 1000) вярно: {
				roman добави-в-края: ['Ⅿ'].
				число извади: 1000.
			}, прекъсни.
		
			(число ≥ 500) вярно: {
				roman добави-в-края: ['Ⅾ'].
				число извади: 500.
			}, прекъсни.
		
			(число ≥ 100) вярно: {
				roman добави-в-края: ['Ⅽ'].
				число извади: 100.
			}, прекъсни.
		
			(число ≥ 50) вярно: {
				roman добави-в-края: ['Ⅼ'].
				число извади: 50.
			}, прекъсни.
		
			(число ≥ 50) вярно: {
				roman добави-в-края: ['Ⅼ'].
				число извади: 50.
			}, прекъсни.
		
			(число ≥ 10) вярно: {
				roman добави-в-края: ['Ⅹ'].
				число извади: 10.
			}, прекъсни.
			
			(число ≥ 9) вярно: {
				roman добави-в-края: ['Ⅸ'].
				число извади: 9.
			}, прекъсни.
			
			(число ≥ 5) вярно: {
				roman добави-в-края: ['Ⅴ'].
				число извади: 5.
			}, прекъсни.
			
			(число ≥ 4) вярно: {
				roman добави-в-края: ['Ⅳ'].
				число извади: 4.
			}, прекъсни.
			
			(число ≥ 1) вярно: {
				roman добави-в-края: ['Ⅰ'].
				число извади: 1.
			}, прекъсни.
		} процедура.
	} докато: { <- число > 0. }. <- roman.
}.

Изход пиши: 1 roman, нов-ред.
Изход пиши: 2 roman, нов-ред.
Изход пиши: 4 roman, нов-ред.
Изход пиши: 8 roman, нов-ред.
Изход пиши: 16 roman, нов-ред.
