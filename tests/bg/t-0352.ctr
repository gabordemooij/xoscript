Число при: ['римско'] изпълни: {
	>> число := себе копирай.
	>> римско := [''].
	{
		{
			(число ≥ 1000) вярно: {
				римско добави-в-края: ['Ⅿ'].
				число извади: 1000.
			}, прекъсни.
		
			(число ≥ 500) вярно: {
				римско добави-в-края: ['Ⅾ'].
				число извади: 500.
			}, прекъсни.
		
			(число ≥ 100) вярно: {
				римско добави-в-края: ['Ⅽ'].
				число извади: 100.
			}, прекъсни.
		
			(число ≥ 50) вярно: {
				римско добави-в-края: ['Ⅼ'].
				число извади: 50.
			}, прекъсни.
		
			(число ≥ 50) вярно: {
				римско добави-в-края: ['Ⅼ'].
				число извади: 50.
			}, прекъсни.
		
			(число ≥ 10) вярно: {
				римско добави-в-края: ['Ⅹ'].
				число извади: 10.
			}, прекъсни.
			
			(число ≥ 9) вярно: {
				римско добави-в-края: ['Ⅸ'].
				число извади: 9.
			}, прекъсни.
			
			(число ≥ 5) вярно: {
				римско добави-в-края: ['Ⅴ'].
				число извади: 5.
			}, прекъсни.
			
			(число ≥ 4) вярно: {
				римско добави-в-края: ['Ⅳ'].
				число извади: 4.
			}, прекъсни.
			
			(число ≥ 1) вярно: {
				римско добави-в-края: ['Ⅰ'].
				число извади: 1.
			}, прекъсни.
		} процедура.
	} докато: { <- число > 0. }. <- римско.
}.

Изход пиши: 1 римско, нов-ред.
Изход пиши: 2 римско, нов-ред.
