


>> използвана-памет1 := 0.
>> използвана-памет2 := 0.
>> използвана-памет3 := 0.
>> използвана-памет4 := 0.

Програма управление-на-паметта: 0.
>> палитра := Нищо.
>> цветове := Нищо.

{
палитра := Речник нов.
палитра 
	постави: ['#F00'] на: ['червено'],
	постави: ['#0F0'] на: ['зелено'],
	постави: ['#00F'] на: ['синьо'].
Изход пиши: ['брой RGB кодове в палитрата: '] + ( палитра брой ), нов-ред.
Изход пиши: ['RGB кодът на зеленото е: '] + ( палитра ? ['зелено'] ), нов-ред.
цветове := [''].
( палитра всеки: { :име :код
		цветове := цветове + ( име + [':'] + код ).
} ).
Изход пиши: ['Всички цветове в палитрата: '] + цветове, нов-ред.
} стартирай.
Програма почисти.
използвана-памет1 := (Програма памет ? 0).

{
палитра := Речник нов.
палитра 
	постави: ['#F00'] на: ['червено'],
	постави: ['#0F0'] на: ['зелено'],
	постави: ['#00F'] на: ['синьо'].
Изход пиши: ['брой RGB кодове в палитрата: '] + ( палитра брой ), нов-ред.
Изход пиши: ['RGB кодът на зеленото е: '] + ( палитра ? ['зелено'] ), нов-ред.
цветове := [''].
( палитра всеки: { :име :код
		цветове := цветове + ( име + [':'] + код ).
} ).
Изход пиши: ['Всички цветове в палитрата: '] + цветове, нов-ред.
} стартирай.
Програма почисти.
използвана-памет2 := (Програма памет ? 0).

{
палитра := Речник нов.
палитра 
	постави: ['#F00'] на: ['червено'],
	постави: ['#0F0'] на: ['зелено'],
	постави: ['#00F'] на: ['синьо'].
Изход пиши: ['брой RGB кодове в палитрата: '] + ( палитра брой ), нов-ред.
Изход пиши: ['RGB кодът на зеленото е: '] + ( палитра ? ['зелено'] ), нов-ред.
цветове := [''].
( палитра всеки: { :име :код
		цветове := цветове + ( име + [':'] + код ).
} ).
Изход пиши: ['Всички цветове в палитрата: '] + цветове, нов-ред.
} стартирай.
Програма почисти.
използвана-памет3 := (Програма памет ? 0).



( използвана-памет1 = използвана-памет2 и: използвана-памет1 = използвана-памет3, и: използвана-памет2 = използвана-памет3 ) вярно: {
	Изход пиши: ['Тук няма изтичане на памет'].
}, невярно: {
	Изход пиши: ['Изтича памет...'].
}.
