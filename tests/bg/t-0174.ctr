


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програма управление-на-паметта: 0.
>> palette := Нищо.
>> colors := Нищо.

{
palette := Речник нов.
palette 
	постави: ['#F00'] на: ['red'],
	постави: ['#0F0'] на: ['green'],
	постави: ['#00F'] на: ['blue'].
Изход пиши: ['number of RGB codes in palette: '] + ( palette брой ), нов-ред.
Изход пиши: ['RGB code of green is: '] + ( palette ? ['green'] ), нов-ред.
colors := [''].
( palette всеки: { :име :код
		colors := colors + ( име + [':'] + код ).
} ).
Изход пиши: ['All colors in palette: '] + colors, нов-ред.
} стартирай.
Програма почисти.
usedMemory1 := (Програма памет ? 0).

