# съобщенията за грешки от базата данни не трябва да се третират като форматиращи низове
Server init.

>> бд := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'],
	парола: ['pass123'],
	име-на-база: ['xobase'],
	свържи-се.

>> параметри-за-търсене := бд заявка: ['SELECT %% FROM'].
{ параметри-за-търсене изпълни. } прихвани: { :e
	Изход пиши: ( e съдържа: ['%%'] ), нов-ред.
}, стартирай.
