# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'],
	парола: ['pass123'],
	име-на-база: ['xobase'],
	свържи-се.

>> параметри-за-търсене := db заявка: ['SELECT %% FROM'].
{ параметри-за-търсене изпълни. } прихвани: { :e
	Изход пиши: ( e съдържа: ['%%'] ), нов-ред.
}, стартирай.
