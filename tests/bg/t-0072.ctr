>> echo := Обект нов.
echo при: ['отговори:'] изпълни: { :sound
	{ Изход пиши: sound. } × 2.
}.
echo ho!. 


echo := Обект нов.
echo при: ['отговори:и:'] изпълни: { :sound :x
	{ Изход пиши: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := Обект нов.
echo при: ['отговори:и:и:'] изпълни: { :operation :sound :x
	{ Изход пиши: sound. } × x.
}.
echo shout: ['la'] times: 4. 


