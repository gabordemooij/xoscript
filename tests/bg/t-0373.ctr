# тест за съответствие

# използвай международни числа

Изход пиши: ['1000 -> '].
Изход пиши: 1000, нов-ред. #1000

Изход пиши: ['1.5 -> '].
Изход пиши: 1.5, нов-ред.  #1.5

Изход пиши: ['1001.5 -> '].
Изход пиши: 1.5 + 1000, нов-ред. #1001.5

# използвай масиви с индекс от 0
>> x := Списък нов ; 1 ; 2 ; 3.
>> y := Списък нов ; ['a'] ; ['b'] ; ['c'].

Изход пиши: ['1 -> '].
Изход пиши: x ? 0, нов-ред. #1

Изход пиши: ['1 -> '].
Изход пиши: (x на: 0), нов-ред. #1

Изход пиши: ['1 -> '].
Изход пиши: x първи, нов-ред. #1

Изход пиши: ['3 -> '].
Изход пиши: x последен, нов-ред. #3

Изход пиши: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Изход пиши: (x според: y), нов-ред.

Изход пиши: ['1 -> '].
Изход пиши: (x от: 0 дължина: 1) първи, нов-ред. #1

Изход пиши: ['0 -> '].
Изход пиши: (x намери: 1), нов-ред. #0

x постави: 9 на: 0.

Изход пиши: ['9 -> '].
Изход пиши: (x на: 0), нов-ред. #9

x добави-в-началото: 8.
Изход пиши: ['8 -> '].
Изход пиши: (x на: 0), нов-ред. #9


x добави-в-края: 10.
Изход пиши: ['10 -> '].
Изход пиши: (x на: 4), нов-ред. #10








