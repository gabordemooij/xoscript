>> a := ['hello'].
>> b := ['hello'].
>> z := a.
>> c := Нищо.
>> q := Обект нов.
>> p := q.
(a равно: a) вярно: { Изход пиши: ['Y1']. }.
(a равно: b) вярно: { Изход пиши: ['Y2']. }.
