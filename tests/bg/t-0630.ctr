#тест на регулярни изрази
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> рег-израз := Шаблон нов: ['href="([^"]+)" target="([^"]+)"'].
>> резултат  := рег-израз съвпадение: subject изпълни: { :m :x
	Изход пиши: m, нов-ред.
	Изход пиши: x, нов-ред.
	<- ['XXX'].
}.
Изход пиши: резултат, нов-ред.