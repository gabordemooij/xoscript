Изход пиши: ((Списък нов
	при: ['plaque:'] изпълни: { :x свой o := x. },
	при: ['табела']  изпълни: { <- свой o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Списък ← 1)
	~ (Списък ← 1 ; 2)
	~ (Списък ← 1 ; 2 ; 3)
	~ (Списък ← 1 ; 2 ; 3 ; 4)
	~ (Списък ← 1 ; 2 ; 3 ; 4 ; 5)
) всеки: { :i :ел
	{ Изход пиши: тази-задача. } × ел брой.
	Изход нов-ред.
}) табела, нов-ред.


