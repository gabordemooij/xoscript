# публичен ключ (за защита на API и др.)
Server init.

# генериране на ключове
>> ключове := Трезор генерирай-ключове.

# частен (таен) ключ
>> тк := ключове първи.

# публичен ключ
>> пк := ключове последен.

# подписване на съобщение
>> подп := Трезор подпиши: ['abc'] с: тк.

Изход пиши: подп дължина, нов-ред.