
>> Size := Обект нов.
Size при: ['is:'] изпълни: { :число
	число при: ['+'] изпълни: { :число
		>> unit := число определение.
		>> factor := 1.
		
		unit
		случай: ['inch'] изпълни: { factor := 0.0833. }. <- себе + (число * factor).
	}. <- число.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Изход пиши: plank + edge, нов-ред.
