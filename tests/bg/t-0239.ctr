Списък при: ['сума'] изпълни: {
	>> общо := 0.
	себе всеки: { :индекс :член
		общо добави: член.
	}. <- общо.
}.

>> a := Вярно.



a при: ['текст'] изпълни: {
	>> отговорът := Нищо.
	( себе = Вярно ) вярно: {
		отговорът := ['Аха'].
	}, иначе: {
		отговорът := ['Не-е'].
	}. <- отговорът.
}.

a при: ['число'] изпълни: {
	>> отговорът := Нищо.
	( себе = Вярно ) вярно: {
		отговорът := 10.
	}, иначе: {
		отговорът := 20.
	}. <- отговорът.
}.

>> b := 666.

b при: ['текст'] изпълни: { <- ['Дявол'].
}.

b при: ['логически'] изпълни: { <- Невярно.
}.


Изход пиши: a, нов-ред.  
Изход пиши: (90 + a), нов-ред. 
Изход пиши: b, нов-ред. 
Изход пиши: (Вярно и: b), нов-ред.

a := Списък ← ['hello'] ; ['world'] ; Вярно ; Нищо ; 666. 
a := a + ( Списък ← 1 ).
Изход пиши: a, нов-ред.
Изход пиши: ((Речник нов) постави: Нищо на: Нищо), нов-ред.
Изход пиши: a сума, нов-ред. 


{
	a при: ['текст'] изпълни: { <- Нищо. }.
	a := [''] + a.
} прихвани: { :грешката
	Изход пиши: ['Отбелязана грешка: '] + грешката, нов-ред.
}, стартирай.



