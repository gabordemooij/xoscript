Списък при: ['sum'] изпълни: {
	>> total := 0.
	себе всеки: { :index :element
		total добави: element.
	}. <- total.
}.

>> a := Вярно.



a при: ['текст'] изпълни: {
	>> answer := Нищо.
	( себе = Вярно ) вярно: {
		answer := ['Yep'].
	}, иначе: {
		answer := ['Nope'].
	}. <- answer.
}.

a при: ['число'] изпълни: {
	>> answer := Нищо.
	( себе = Вярно ) вярно: {
		answer := 10.
	}, иначе: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b при: ['текст'] изпълни: { <- ['Devil'].
}.

b при: ['логически'] изпълни: { <- Невярно.
}.


Изход пиши: a, нов-ред.  
Изход пиши: (90 + a), нов-ред. 
Изход пиши: b, нов-ред. 
Изход пиши: (Вярно и: b), нов-ред.

a := Списък ← ['hello'] ; ['world'] ; Вярно ; Нищо ; 666. 
a := a + ( Списък ← 1 ).
Изход пиши: a, нов-ред.
Изход пиши: ((Речник нов) постави: Нищо на: Нищо), нов-ред.
Изход пиши: a sum, нов-ред. 


{
	a при: ['текст'] изпълни: { <- Нищо. }.
	a := [''] + a.
} прихвани: { :error
	Изход пиши: ['Error noted: '] + error, нов-ред.
}, стартирай.



{
	a при: ['число'] изпълни: { <- Нищо. }.
	a := 3 × a.
} прихвани: { :error
	Изход пиши: ['Error noted: '] + error, нов-ред.
}, стартирай.


{
	a при: ['логически'] изпълни: { <- Нищо. }.
	a := Вярно и: a. 
} прихвани: { :error
	Изход пиши: ['Error noted: '] + error, нов-ред.
}, стартирай.





