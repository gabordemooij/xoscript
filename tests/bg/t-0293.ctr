
>> city := Списък ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Списък ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature според: city.
>> cities := weather записи сортирай: { :a :b <- (a сравни: b). }.
>> temperatures := weather стойности сортирай: { :a :b <- (a сравни: b) отрицателно?. }.

Изход пиши: (cities съедини: [',']), нов-ред.
Изход пиши: (temperatures съедини: [',']), нов-ред.
