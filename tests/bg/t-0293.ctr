
>> град := Списък ← ['Лондон'] ; ['Париж'] ; ['Берлин'].
>> температура := Списък ← ['15'] ; ['16'] ; ['15'].
>> прогноза := температура според: град.
>> градове := прогноза записи сортирай: { :a :b <- (a сравни: b). }.
>> температури := прогноза стойности сортирай: { :a :b <- (a сравни: b) отрицателно?. }.

Изход пиши: (градове съедини: [',']), нов-ред.
Изход пиши: (температури съедини: [',']), нов-ред.
