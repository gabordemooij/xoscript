Изход пиши: ['Test object'], нов-ред.
>> a := Обект нов. 

a при: ['item:'] изпълни: { :num
	свой num := num. 
}.

a при: ['item'] изпълни: { <- свой num.
}.

a item: 123.

Изход пиши: a item, нов-ред.

>> old-num-address := a item прототип адрес-в-паметта.
a save-as: ['/tmp/a.bin'].
Изход пиши: ['========== RELOADING SNAP:'], нов-ред.

>> b := Обект load-from: ['/tmp/a.bin'].

(b item прототип адрес-в-паметта = old-num-address) вярно: {
	Изход пиши: ['Object link re-attached.'], нов-ред.
}.

Изход пиши: b item, нов-ред.
