Изход пиши: ['Тестов обект'], нов-ред.
>> поздравител := Обект нов.
поздравител при: ['name:'] изпълни: { :име
	свой x-име := име. 
}.
поздравител при: ['поздрави'] изпълни: {
	Изход пиши: ['Здравей, '] + свой x-име, нов-ред.
}.
поздравител name: ['Sherlock'].
поздравител save-as: ['/tmp/a.bin'].
поздравител save-as: ['/tmp/b.bin'].
Изход пиши: ['========== ПРЕЗАРЕЖДАНЕ НА SNAP:'], нов-ред.
>> b := Обект load-from: ['/tmp/a.bin'].
>> c := Обект load-from: ['/tmp/b.bin'].
b поздрави.
b name: ['Watson'], поздрави.
c name: ['Moriarty'], поздрави.
