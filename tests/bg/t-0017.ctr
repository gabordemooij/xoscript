Число при: ['факториел'] изпълни: {
	>> общо := 1.
	{ :индекс общо умножи-по: (себе - (индекс)). } × себе. <- общо.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Изход пиши: a.
>> b := 2 + 3 факториел.
Изход пиши: b.
>> c := 3 факториел + 2.
Изход пиши: c.
>> d := 2 + (3 факториел).
Изход пиши: d.
Изход пиши: 2 + 3 факториел + 1.
