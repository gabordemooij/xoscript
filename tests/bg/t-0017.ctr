Число при: ['factorial'] изпълни: {
	>> total := 1.
	{ :index total умножи-по: (себе - (index)). } × себе. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Изход пиши: a.
>> b := 2 + 3 factorial.
Изход пиши: b.
>> c := 3 factorial + 2.
Изход пиши: c.
>> d := 2 + (3 factorial).
Изход пиши: d.
Изход пиши: 2 + 3 factorial + 1.
