>> V := Обект.
V при: ['текст'] изпълни: {
	Изход пиши: ['преобразуване'], нов-ред.
	<- ['abc'].
}.

Изход пиши: ( Програма настройка: ['abc'] ), нов-ред.

# params не трябва да бъдат почиствани от GC
Програма настройка: ([''] + V нов) стойност: ([''] + V нов).

Изход пиши: ( Програма настройка: ['abc'] ), нов-ред.
