



>> Кафе-утайка := Обект нов.
Кафе-утайка при: ['екстрахирай'] изпълни: { <- ['coffee']. }.

>> Кафемашина := Обект нов.
Кафемашина при: ['init'] изпълни: {
	свой кафе-утайка := Кафе-утайка нов.
}.
Кафемашина при: ['нов'] изпълни: { <- Кафемашина `new init.
}.

Кафемашина при: ['направи-чай'] изпълни: { <- (свой чаени-листа екстрахирай). }.
Кафемашина при: ['направи-кафе'] изпълни: { <- (свой кафе-утайка екстрахирай). }.

>> кафе-мечта := Кафемашина нов.

Изход пиши:
	кафе-мечта 
	направи-кафе.

Изход пиши:
	кафе-мечта 
	направи-чай.
