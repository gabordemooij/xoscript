



>> CoffeeGrounds := Обект нов.
CoffeeGrounds при: ['extract'] изпълни: { <- ['coffee']. }.

>> CoffeeMachine := Обект нов.
CoffeeMachine при: ['init'] изпълни: {
	свой coffeegrounds := CoffeeGrounds нов.
}.
CoffeeMachine при: ['нов'] изпълни: { <- CoffeeMachine `new init.
}.

CoffeeMachine при: ['makeTea'] изпълни: { <- (свой tealeaves extract). }.
CoffeeMachine при: ['makeCoffee'] изпълни: { <- (свой coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine нов.

Изход пиши:
	coffeeDream 
	makeCoffee.

Изход пиши:
	coffeeDream 
	makeTea.
