#Linux
>> Гълтач := Обект нов.

Гълтач при: ['нов'] изпълни: {
	свой str := [''].
}.

Гълтач при: ['nieuw'] изпълни: {
	свой str := [''].
}.

Гълтач при: ['отговори:'] изпълни: { :blah
		свой str добави-в-края: blah.
}.

Гълтач при: ['отговори:и:'] изпълни: { :blah :blahah
		свой str добави-в-края: (blah от: 0 дължина: (blah дължина - 1)).
		свой str добави-в-края: [' '].
		свой str добави-в-края: blahah.
}.

Гълтач при: ['получи'] изпълни: {
	>> буфер := свой str.
	свой str := ['']. <- буфер.
}.


Изход пиши: (Програма система: (Гълтач нов echo: ['Здравей, мога да пиша в конзолата с плавен API!'], получи)).


{ Файл нов: ['/tmp/from.txt'], изтрий. } прихвани: { ['Празно']. }, стартирай.
{ Файл нов: ['/tmp/to.txt'], изтрий. } прихвани: { ['Празно']. }, стартирай.


Файл нов: ['/tmp/to.txt'], съществува невярно: {
	Изход пиши: ['Confirmed. Target file does not exist.\
'].
}.
Файл нов: ['/tmp/from.txt'], съществува невярно: {
	Изход пиши: ['Confirmed. Source file does not exist.\
'].
}.



Програма система: (Гълтач нов touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], получи).



Програма система: (Гълтач нов cp: ['/tmp/from.txt /tmp/to.txt'], получи).

Файл нов: ['/tmp/to.txt'], съществува вярно: {
	Изход пиши: ['Confirmed. Target file has been created by shell.\
'].
}.


Изход пиши: ['Съдържанието на файла е:'] + (Файл нов: ['/tmp/to.txt'], чети), нов-ред.
