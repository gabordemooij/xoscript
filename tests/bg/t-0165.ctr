

>> използвана-памет1 := 0.
>> използвана-памет2 := 0.
>> използвана-памет3 := 0.
>> използвана-памет4 := 0.

Програма управление-на-паметта: 0.

>> f := Файл нов: ['/tmp/citrine_test_file.txt'].
f exists: { f изтрий. }.
f пиши: ['здравей '].
f добави-в-края: ['world'].
>> q := f чети.
Изход пиши: q, нов-ред.

Програма почисти.
използвана-памет1 := (Програма памет ? 0).

>> f := Файл нов: ['/tmp/citrine_test_file.txt'].
f exists: { f изтрий. }.
f пиши: ['здравей '].
f добави-в-края: ['world'].
>> q := f чети.
Изход пиши: q, нов-ред.
Програма почисти.
използвана-памет2 := (Програма памет ? 0).


>> f := Файл нов: ['/tmp/citrine_test_file.txt'].
f exists: { f изтрий. }.
f пиши: ['здравей '].
f добави-в-края: ['world'].
>> q := f чети.
Изход пиши: q, нов-ред.
Програма почисти.
използвана-памет3 := (Програма памет ? 0).



( използвана-памет1 = използвана-памет2 и: използвана-памет1 = използвана-памет3, и: използвана-памет2 = използвана-памет3 ) вярно: {
	Изход пиши: ['Тук няма изтичане на памет'].
}, невярно: {
	Изход пиши: ['Изтича памет...'].
}.
