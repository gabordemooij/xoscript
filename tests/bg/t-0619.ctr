>> HTML := Обект нов.
HTML при: ['отговори:'] изпълни: { :tag 
	Изход пиши: (['<tag>'] tag: tag), нов-ред.
}.
HTML при: ['отговори:и:'] изпълни: { :tag :html 
	Изход пиши: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), нов-ред.
}.
>> html := HTML нов.
html body h1: ['header'].

