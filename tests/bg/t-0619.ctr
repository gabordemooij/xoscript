>> HTML := Обект нов.
HTML при: ['отговори:'] изпълни: { :таг 
	Изход пиши: (['<tag>'] tag: таг), нов-ред.
}.
HTML при: ['отговори:и:'] изпълни: { :таг :html 
	Изход пиши: (
		['<tag>innerHTML</tag>']
		tag: таг - [':'],
		innerHTML: html
	), нов-ред.
}.
>> html := HTML нов.
html body h1: ['header'].

