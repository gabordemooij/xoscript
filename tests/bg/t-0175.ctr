>> използвана-памет3 := 0.
>> използвана-памет4 := 0.

>> x := 100.

Програма управление-на-паметта: 0.

{
>> txt := ['здравей '] + ['world'].
txt := txt + [' - можем ли да ползваме текстове.. '].
txt := txt + ['без да изтекат '] + x + [' байта ?'].
txt добави-в-края: ['!!'].
Изход пиши: txt.
} стартирай.

Програма почисти.

използвана-памет1 := (Програма памет ? 0).


