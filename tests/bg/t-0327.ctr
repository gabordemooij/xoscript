

Списък при: ['fixture:'] изпълни: { :f
	свой fixture := f.
}.

Списък при: ['брой'] изпълни: { <- свой fixture.
}.

Списък при: ['aantal'] изпълни: { <- свой fixture.
}.


>> x := Нищо.
{

	x := ['hello'] 
	замени:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] знак: 2)
			)
		)
	с: (
		(['...hal'] + ['lo']) 
			главни-букви 
			lowecase 
			главни-букви 
			изместване: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Списък ← 0 ; 1 ; 4; 9 ; (Списък ← 0 ; 3; 1) ; 4
							) предпоследен
						) ? 1
					) + 
					((Списък ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					брой
				)
			)
	).

} × 10.
Изход пиши: x, нов-ред.

