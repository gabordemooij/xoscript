

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програма управление-на-паметта: 0.

>> a := Списък ← ['hello'] ; ['world'] ; Вярно ; Нищо ; 666.
a прави извади-последния извади-първия добави-в-началото: ['hi'], добави-в-края: 999, готово.
Изход пиши: ( a съедини: [','] ), нов-ред.

Програма почисти.
usedMemory1 := (Програма памет ? 0).


a := Списък ← ['hello'] ; ['world'] ; Вярно ; Нищо ; 666.
a извади-последния. a извади-първия. a добави-в-началото: ['hi'], добави-в-края: 999.
Изход пиши: ( a съедини: [','] ), нов-ред.


Програма почисти.
usedMemory2 := (Програма памет ? 0).


a := Списък ← ['hello'] ; ['world'] ; Вярно ; Нищо ; 666.
a прави извади-последния извади-първия добави-в-началото: ['hi'], добави-в-края: 999, готово.
Изход пиши: ( a съедини: [','] ), нов-ред.


Програма почисти.
usedMemory3 := (Програма памет ? 0).



( usedMemory1 = usedMemory2 и: usedMemory1 = usedMemory3, и: usedMemory2 = usedMemory3 ) вярно: {
	Изход пиши: ['No memory leaks here'].
}, невярно: {
	Изход пиши: ['Leaking memory...'].
}.
