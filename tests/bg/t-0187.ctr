Число при: ['factorial'] изпълни: {
	>> total := 1.
	{ :index total умножи-по: (себе - index). } × себе. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програма управление-на-паметта: 0.

{
2 exponent factorial.
Изход пиши: (11 по-модул: 3), нов-ред.
Изход пиши: (3.4 закръгли), нов-ред.
Изход пиши: (7.1 закръгли-нагоре), нов-ред.
Изход пиши: (7.9 закръгли-надолу), нов-ред.
}
стартирай.

Програма почисти.

usedMemory1 := (Програма памет ? 0).

{
2 exponent factorial.
Изход пиши: (11 по-модул: 3), нов-ред.
Изход пиши: (3.4 закръгли), нов-ред.
Изход пиши: (7.1 закръгли-нагоре), нов-ред.
Изход пиши: (7.9 закръгли-надолу), нов-ред.
}
стартирай.

Програма почисти.
usedMemory2 := (Програма памет ? 0).


{
2 exponent factorial.
