Число при: ['факториел'] изпълни: {
	>> общо := 1.
	{ :индекс общо умножи-по: (себе - индекс). } × себе. <- общо.
}.

>> използвана-памет1 := 0.
>> използвана-памет2 := 0.
>> използвана-памет3 := 0.
>> използвана-памет4 := 0.

Програма управление-на-паметта: 0.

{
2 показател факториел.
Изход пиши: (11 по-модул: 3), нов-ред.
Изход пиши: (3.4 закръгли), нов-ред.
Изход пиши: (7.1 закръгли-нагоре), нов-ред.
Изход пиши: (7.9 закръгли-надолу), нов-ред.
}
стартирай.

Програма почисти.

използвана-памет1 := (Програма памет ? 0).

{
2 показател факториел.
Изход пиши: (11 по-модул: 3), нов-ред.
Изход пиши: (3.4 закръгли), нов-ред.
Изход пиши: (7.1 закръгли-нагоре), нов-ред.
Изход пиши: (7.9 закръгли-надолу), нов-ред.
}
стартирай.

Програма почисти.
използвана-памет2 := (Програма памет ? 0).


{
2 показател факториел.
Изход пиши: (11 по-модул: 3), нов-ред.
Изход пиши: (3.4 закръгли), нов-ред.
Изход пиши: (7.1 закръгли-нагоре), нов-ред.
Изход пиши: (7.9 закръгли-надолу), нов-ред.
} стартирай.

Програма почисти.
използвана-памет3 := (Програма памет ? 0).



( използвана-памет1 = използвана-памет2 и: използвана-памет1 = използвана-памет3, и: използвана-памет2 = използвана-памет3 ) вярно: {
	Изход пиши: ['Тук няма изтичане на памет'].
}, невярно: {
	Изход пиши: ['Изтича памет...'].
}.
