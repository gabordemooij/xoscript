

Списък при: ['column:'] изпълни: { :колона
	>> резултат := Списък нов.
	себе всеки: { :индекс :редица
		редица всеки: { :индекс :клетка
			(индекс = колона) вярно: { резултат добави-в-края: клетка. }.
		}.
	}. <- резултат.
}.


>> a := Списък ←
	(Списък ← 1 ; 2 ; 3) ;
	(Списък ← 4 ; 5 ; 6) ;
	(Списък ← 7 ; 8 ; 9).

>> b := a column: 1.
Изход пиши: b, нов-ред.

b := a column: 20.
Изход пиши: b, нов-ред.

b := a column: -100.
Изход пиши: b, нов-ред.
