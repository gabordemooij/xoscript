

Списък при: ['column:'] изпълни: { :column
	>> result := Списък нов.
	себе всеки: { :index :row
		row всеки: { :index :cell
			(index = column) вярно: { result добави-в-края: cell. }.
		}.
	}. <- result.
}.


>> a := Списък ←
	(Списък ← 1 ; 2 ; 3) ;
	(Списък ← 4 ; 5 ; 6) ;
	(Списък ← 7 ; 8 ; 9).

>> b := a column: 1.
Изход пиши: b, нов-ред.

b := a column: 20.
Изход пиши: b, нов-ред.

b := a column: -100.
Изход пиши: b, нов-ред.
