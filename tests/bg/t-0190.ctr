#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Програма управление-на-паметта: 0.

{
Момент време.
Момент изчакай: 1.
Изход пиши: Програма аргументи, нов-ред.
Програма аргумент: 0.
Число random.
Изход пиши: (Програма система: ['echo 'Hello'']).
} стартирай.

Програма почисти.
usedMemory1 := (Програма памет ? 0).

{
Момент време.
Момент изчакай: 1.
Изход пиши: Програма аргументи, нов-ред.
Програма аргумент: 0.
Число random.
Изход пиши: (Програма система: ['echo 'Hello'']).
} стартирай.

Програма почисти.
usedMemory2 := (Програма памет ? 0).

{
Момент време.
Момент изчакай: 1.
Изход пиши: Програма аргументи, нов-ред.
Програма аргумент: 0.
Число random.
Изход пиши: (Програма система: ['echo 'Hello'']).
} стартирай.

Програма почисти.
usedMemory3 := (Програма памет ? 0).



( usedMemory1 = usedMemory2 и: usedMemory1 = usedMemory3, и: usedMemory2 = usedMemory3 ) вярно: {
	Изход пиши: ['No memory leaks here'].
}, невярно: {
	Изход пиши: ['Leaking memory...'].
}.
