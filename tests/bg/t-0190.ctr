#Linux
>> използвана-памет1 := 0.
>> използвана-памет2 := 0.
>> използвана-памет3 := 0.
>> използвана-памет4 := 0.

Програма управление-на-паметта: 0.

{
Момент време.
Момент изчакай: 1.
Изход пиши: Програма аргументи, нов-ред.
Програма аргумент: 0.
Число random.
Изход пиши: (Програма система: ['echo 'Hello'']).
} стартирай.

Програма почисти.
използвана-памет1 := (Програма памет ? 0).

{
Момент време.
Момент изчакай: 1.
Изход пиши: Програма аргументи, нов-ред.
Програма аргумент: 0.
Число random.
Изход пиши: (Програма система: ['echo 'Hello'']).
} стартирай.

Програма почисти.
използвана-памет2 := (Програма памет ? 0).

{
Момент време.
Момент изчакай: 1.
Изход пиши: Програма аргументи, нов-ред.
Програма аргумент: 0.
Число random.
Изход пиши: (Програма система: ['echo 'Hello'']).
} стартирай.

Програма почисти.
използвана-памет3 := (Програма памет ? 0).



( използвана-памет1 = използвана-памет2 и: използвана-памет1 = използвана-памет3, и: използвана-памет2 = използвана-памет3 ) вярно: {
	Изход пиши: ['Тук няма изтичане на памет'].
}, невярно: {
	Изход пиши: ['Изтича памет...'].
}.
