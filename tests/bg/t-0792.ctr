Server init.

>> DB := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'],
	парола: ['pass123'],
	име-на-база: ['xobase'],
	свържи-се.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB заявка: SQL.

# now you don't have to set DB
query2 извлечи: { :row
	Изход пиши: row world, нов-ред.
}.
