Server init.

>> БД := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'],
	парола: ['pass123'],
	име-на-база: ['xobase'],
	свържи-се.
	
>> SQL := ['SELECT "hello" AS "world" '].

# по-бърз начин, вземете заявката от БД:
>> заявка2 := БД заявка: SQL.

# сега не е нужно да задавате БД
заявка2 извлечи: { :редица
	Изход пиши: редица world, нов-ред.
}.
