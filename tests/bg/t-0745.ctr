Изход пиши: ['Test object'], нов-ред.
>> a := Обект нов. 

a при: ['item:'] изпълни: { :dict
	свой dict := dict. 
}.

a при: ['item'] изпълни: { <- свой dict.
}.

a item: (
Речник нов
	hello: ['world']).

>> old-dict-address := a item прототип адрес-в-паметта.
a save-as: ['/tmp/a.bin'].
Изход пиши: ['========== RELOADING SNAP:'], нов-ред.

>> b := Обект load-from: ['/tmp/a.bin'].

(b item прототип адрес-в-паметта = old-dict-address) вярно: {
	Изход пиши: ['Object link re-attached.'], нов-ред.
}.

Изход пиши: b item, нов-ред.
