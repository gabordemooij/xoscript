>> t := Вярно.
(t = Вярно) вярно: { Изход пиши: ['T']. }.
(t = Невярно) вярно: { Изход пиши: ['F']. }.
Изход пиши: ['|'].
>> t := Невярно.
(t = Вярно) вярно: { Изход пиши: ['T']. }.
(t = Невярно) вярно: { Изход пиши: ['F']. }.
Изход пиши: ['|'].
>> f := Вярно.
(t = Вярно и: f = Невярно) вярно: { Изход пиши: ['T']. }.
(t = Невярно и: f = Вярно) вярно: { Изход пиши: ['F']. }.
Изход пиши: ['|'].
>> n := Нищо.
(n Нищо?) вярно: { Изход пиши: ['T']. }.
(n Нищо?) невярно: { Изход пиши: ['F']. }.
Изход пиши: ['|'].
(f Boolean?) вярно: { Изход пиши: ['T']. }.
(f Boolean?) невярно: { Изход пиши: ['F']. }.



