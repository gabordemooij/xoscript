Server init.
>> fmt := Формат нов: ['%#3x'].

>> blob := Blob нов: 4.
blob bytes: ( 
	Списък нов ; 0 ; 1 ; 2 ; 3
).

>> file := Файл нов: ['/tmp/blob'].
file blob: blob.
blob освободи.

>> чети := file blob.
чети 
от: 0 
дължина: 4, 
прави всеки: { :i :b 
	Изход
	пиши: (fmt приложи-цяло: b),
	нов-ред.
}.
чети освободи.
