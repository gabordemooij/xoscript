Изход пиши: ['Test object'], нов-ред.
>> a := Обект нов. 

a при: ['item:'] изпълни: { :file
	свой file := file. 
}.

a при: ['item'] изпълни: { <- свой file.
}.

>> f := Файл нов: ['/tmp/aaa.txt'].
a item: f.
Изход пиши: a item, нов-ред.
a save-as: ['/tmp/a.bin'].
Изход пиши: ['========== RELOADING SNAP:'], нов-ред.
>> b := Обект load-from: ['/tmp/a.bin'].
Изход пиши: b item, нов-ред.
