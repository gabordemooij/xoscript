>> Комбинация := Списък нов.

Комбинация при: ['добави-в-края:'] изпълни: { :ел
	себе 
	намери: ел, Нищо? вярно: { себе добави-в-края: ел. }.
}.

>> багри := Комбинация нов.
багри
	добави-в-края: ['червено'],
	добави-в-края: ['зелено'],
	добави-в-края: ['синьо'],
	добави-в-края: ['червено'].

Изход пиши: багри, нов-ред.
