>> Combination := Списък нов.

Combination при: ['добави-в-края:'] изпълни: { :el
	себе 
	намери: el, Нищо? вярно: { себе добави-в-края: el. }.
}.

>> colours := Combination нов.
colours
	добави-в-края: ['red'],
	добави-в-края: ['green'],
	добави-в-края: ['blue'],
	добави-в-края: ['red'].

Изход пиши: colours, нов-ред.
