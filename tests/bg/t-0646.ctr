Server init.
Изход пиши: ['Database datetime test'], нов-ред.

>> db := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'], 
	парола: ['pass123'],
	име-на-база: ['xobase'],
	свържи-се.

>> параметри-за-търсене :=
db заявка: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
извлечи: { :row
	Изход пиши: row datetimetest, нов-ред.
}.
