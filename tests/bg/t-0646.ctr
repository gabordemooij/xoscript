Server init.
Изход пиши: ['Тест на дата и час в базата данни'], нов-ред.

>> бд := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'], 
	парола: ['pass123'],
	име-на-база: ['xobase'],
	свържи-се.

>> параметри-за-търсене :=
бд заявка: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
извлечи: { :редица
	Изход пиши: редица datetimetest, нов-ред.
}.
