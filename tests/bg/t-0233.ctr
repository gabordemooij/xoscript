
>> Slurp := Обект нов.

Slurp при: ['нов'] изпълни: {
	свой str := [''].
}.

Slurp при: ['отговори:'] изпълни: { :blah
		(свой str = ['']) вярно: {
			свой str добави-в-края: blah.
		}, иначе: {
			свой str добави-в-края: [' '].
			свой str добави-в-края: blah.
		}.
}.

Slurp при: ['отговори:и:'] изпълни: { :blah :blahah
		(blah дължина > 1) вярно: {
			свой str добави-в-края: (blah от: 0 дължина: (blah дължина - 1)).
		}, иначе: {
			свой str добави-в-края: blah.
		}.
		свой str добави-в-края: [' '].
		свой str добави-в-края: blahah.
}.

Slurp при: ['obtain'] изпълни: {
	>> buffer := свой str.
	свой str := ['']. <- buffer.
}.

Изход пиши: ( Програма система: ( Slurp нов echo hello world obtain ) ).
