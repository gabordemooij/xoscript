
Server init.
Изход пиши: ['Database test'], нов-ред.

>> db := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'], 
	парола: ['pass123'],
	име-на-база: ['xobase'],
	свържи-се.

>> параметри-за-търсене :=
db заявка: ['SELECT REPEAT('Blah',1000) AS blah'], 
извлечи: { :row 
	Изход пиши: row blah дължина, нов-ред.
}.
