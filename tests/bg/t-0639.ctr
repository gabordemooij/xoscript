
Server init.
Изход пиши: ['Тест на базата данни'], нов-ред.

>> бд := Maria-DB нов хост: ['localhost'],
	потребител: ['xo'], 
	парола: ['pass123'],
	име-на-база: ['xobase'],
	свържи-се.

>> параметри-за-търсене :=
бд заявка: ['SELECT REPEAT('Blah',1000) AS blah'], 
извлечи: { :редица 
	Изход пиши: редица blah дължина, нов-ред.
}.
