

# create a 64-bit integer for exact calculations
>> a := Int64 от-текст: ['123'].

# to string
Изход пиши: a, нов-ред.

# divide
Изход пиши: a / (Int64 от-текст: ['3']), нов-ред.

# multiply
Изход пиши: a * (Int64 от-текст: ['2']), нов-ред.

# add
Изход пиши: a + (Int64 от-текст: ['1']), нов-ред.

# subtract
Изход пиши: a - (Int64 от-текст: ['2']), нов-ред.

# compare
Изход пиши: ( a =   (Int64 от-текст: ['123'])), нов-ред.
Изход пиши: ( a !=: (Int64 от-текст: ['124'])), нов-ред.
Изход пиши: ( a <   (Int64 от-текст: ['124'])), нов-ред.
Изход пиши: ( a >   (Int64 от-текст: ['122'])), нов-ред.
Изход пиши: ( a >=: (Int64 от-текст: ['123'])), нов-ред.
Изход пиши: ( a <=: (Int64 от-текст: ['123'])), нов-ред.





	