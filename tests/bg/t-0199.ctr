
Програма управление-на-паметта: 4.

>> Animal := Обект нов.
Animal при: ['make'] изпълни: {
	>> animal := Обект нов.
	animal при: ['makeSound'] изпълни: {
		Изход пиши: свой sound.
	}. <- animal.
}.
>> Cat := Обект нов.
Cat при: ['make'] изпълни: {
	>> cat := Animal make.
	cat при: ['init'] изпълни: {
		свой sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
