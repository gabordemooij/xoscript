
Програма управление-на-паметта: 4.

>> Животно := Обект нов.
Животно при: ['създай'] изпълни: {
	>> животно := Обект нов.
	животно при: ['издай-звук'] изпълни: {
		Изход пиши: свой звук.
	}. <- животно.
}.
>> Котка := Обект нов.
Котка при: ['създай'] изпълни: {
	>> котка := Животно създай.
	котка при: ['init'] изпълни: {
		свой звук := ['meow!'].
	}.
	котка init. <- котка.
}.
>> tom := Котка създай.
tom издай-звук.
