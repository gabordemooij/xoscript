
>> Животно := Обект нов.
Животно при: ['нов'] изпълни: {
	<- себе нов init.
}.

Животно при: ['init'] изпълни: {
	свой звук := ['?'].
	свой крака  := 4.
}.

>> Куче := Животно нов.
Куче при: ['init'] изпълни: {
	себе init.
	свой звук := ['лае'].
}.

Животно при: ['текст'] изпълни: {
	<- свой крака текст + свой звук.
}.

>> пудел := Куче нов.
Изход пиши: пудел, нов-ред.

