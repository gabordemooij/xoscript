Изход пиши: ['Test object'], нов-ред.
>> a := Обект нов. 
a при: ['item:'] изпълни: { :int64
	свой int64 := int64. 
}.
a при: ['item'] изпълни: { <- свой int64.
}.
a item: ( Int64 от-текст: ['9999'] ).
Изход пиши: a item, нов-ред.
>> old-int64-address := a item прототип адрес-в-паметта.
a save-as: ['/tmp/a.bin'].
Изход пиши: ['========== RELOADING SNAP:'], нов-ред.
>> b := Обект load-from: ['/tmp/a.bin'].
(b item прототип адрес-в-паметта = old-int64-address) вярно: {
	Изход пиши: ['Object link re-attached.'], нов-ред.
}.
Изход пиши: ( b item ), нов-ред.
