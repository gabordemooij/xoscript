
Server init.
>> заяв := HTTP-Заявка нов.
Изход пиши: ['HTTP-GET d[]=']  + ( заяв get-списък: ['d[]'] ), нов-ред. # GET
Изход пиши: ['HTTP-GET f[]=']  + ( заяв get-списък: ['f[]'] ), нов-ред. # GET
Изход пиши: ['HTTP-POST e[]='] + ( заяв post-списък: ['e[]'] ), нов-ред. # GET
Изход пиши: ['HTTP-POST c=']   + ( заяв post: ['c'] ), нов-ред. # GET
Изход пиши: ['HTTP-POST xx=']  + ( заяв post: ['xx'] ), нов-ред. # GET
