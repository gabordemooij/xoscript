>> Greeter := Обект нов.
Greeter при: ['make'] изпълни: {
	>> gr := Обект нов.
	gr при: ['setName:'] изпълни: { :aname
		свой име := aname.
	}.
	gr при: ['greet'] изпълни: {
		Изход пиши: свой име.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a нов.
c setName: ['THREE'].
c greet.
>> d := a нов.
d setName: ['FOUR'].
d greet.
c greet.
