>> Поздравител := Обект нов.
Поздравител при: ['създай'] изпълни: {
	>> пз := Обект нов.
	пз при: ['setName:'] изпълни: { :ново-име
		свой име := ново-име.
	}.
	пз при: ['поздрави'] изпълни: {
		Изход пиши: свой име.
	}. <- пз.
}.
>> a := Поздравител създай.
>> b := Поздравител създай.
a setName: ['ЕДНО'].
b setName: ['ДВЕ'].
a поздрави.
b поздрави.
>> c := a нов.
c setName: ['ТРИ'].
c поздрави.
>> d := a нов.
d setName: ['ЧЕТИРИ'].
d поздрави.
c поздрави.
