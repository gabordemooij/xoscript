>> случаен-избор := { :a :b
	>> минимум := ( a < b ) или: a или: b.
	>> максимум := ( a > b ) или: a или: b.
	>> x := Нищо.
	{
		x := Число между: a и: b.
		((x < минимум) или: (x > максимум)) вярно: { 
			Изход пиши: (['Невалидна стойност!']).
			Програма край.
		}.
	} 
	× 100. <- x.
}.
