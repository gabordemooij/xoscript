#Linux

(Файл нов: ['/tmp/testje']) съществува невярно: {
	Програма система: ['mkdir /tmp/testje'].	
}.

(Файл нов: ['/tmp/testje/file1']) съществува невярно: {
	Програма система: ['touch /tmp/testje/file1'].	
}.

(Файл нов: ['/tmp/testje/folder1']) съществува невярно: {
	Програма система: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Файл списък: ['/tmp/testje'].

>> q := Списък нов.

l всеки: { :k :v v всеки: { :x :y q добави-в-края: y. }. }.

>> s := q текст.

(s съдържа: ['file1']) вярно:   { Изход пиши: ['OK'], нов-ред. }.
(s съдържа: ['file2']) вярно:   { Изход пиши: ['XX'], нов-ред. }.
(s съдържа: ['folder1']) вярно: { Изход пиши: ['OK'], нов-ред. }.
