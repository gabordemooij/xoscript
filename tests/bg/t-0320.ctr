


>> Кафемашина := Обект нов.
Кафемашина при: ['order:'] изпълни: { :id
	>> coffee := ['Американо'].
	( id = 1 ) вярно: {
		coffee := ['Капучино'].
	}.
	( id = 2 ) вярно: {
		coffee := ['Еспресо'].
	}.
	( id = 3 ) вярно: {
		coffee := ['Лате'].
	}. <- coffee.
}.
>> Проста-кафемашина := Обект нов.
Проста-кафемашина при: ['поръчка'] изпълни: { <- ['Черно']. }.
>> червена-чаша := Кафемашина order: 1.
Изход пиши: червена-чаша, нов-ред.
червена-чаша := ['Чай']. 
