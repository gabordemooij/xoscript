


>> CoffeeMachine := Обект нов.
CoffeeMachine при: ['order:'] изпълни: { :id
	>> coffee := ['Americano'].
	( id = 1 ) вярно: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) вярно: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) вярно: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Обект нов.
SimpleCoffeeMachine при: ['order'] изпълни: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Изход пиши: redCup, нов-ред.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Изход пиши: greenCup, нов-ред.
>> yellowCup := CoffeeMachine order: 1.
Изход пиши: yellowCup, нов-ред.
>> blueCup := CoffeeMachine order: 0.
Изход пиши: blueCup, нов-ред.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Изход пиши: blackCup, нов-ред.
blackCup добави-в-края: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Изход пиши: orangeCup, нов-ред.
