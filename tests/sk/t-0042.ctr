>> items := Slovník nový.
items umiestniť: ['čierna'] na: ['coffee'], umiestniť: ['earl grey'] na: ['čaj'].
Výstup písať: (items na: ['coffee']), písať: (items na: ['čaj']).
Výstup písať: ['pole obsahuje'] + items počet + [' položiek.'].
items umiestniť: ['kapučíno'] na: ['coffee'].
Výstup písať: ['Teraz je moja káva.. '] + (items na: ['coffee']).
items umiestniť: ['aaa'] na: ['1'].
items umiestniť: ['bbb'] na: ['2'].
Výstup písať: (items na: ['a']).
