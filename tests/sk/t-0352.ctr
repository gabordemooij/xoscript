Číslo pri: ['rímsky'] urobiť: {
	>> číslo := seba kopírovať.
	>> rímsky := [''].
	{
		{
			(číslo ≥ 1000) pravda: {
				rímsky pripojiť: ['Ⅿ'].
				číslo odčítať: 1000.
			}, prerušiť.
		
			(číslo ≥ 500) pravda: {
				rímsky pripojiť: ['Ⅾ'].
				číslo odčítať: 500.
			}, prerušiť.
		
			(číslo ≥ 100) pravda: {
				rímsky pripojiť: ['Ⅽ'].
				číslo odčítať: 100.
			}, prerušiť.
		
			(číslo ≥ 50) pravda: {
				rímsky pripojiť: ['Ⅼ'].
				číslo odčítať: 50.
			}, prerušiť.
		
			(číslo ≥ 50) pravda: {
				rímsky pripojiť: ['Ⅼ'].
				číslo odčítať: 50.
			}, prerušiť.
		
			(číslo ≥ 10) pravda: {
				rímsky pripojiť: ['Ⅹ'].
				číslo odčítať: 10.
			}, prerušiť.
			
			(číslo ≥ 9) pravda: {
				rímsky pripojiť: ['Ⅸ'].
				číslo odčítať: 9.
			}, prerušiť.
			
			(číslo ≥ 5) pravda: {
				rímsky pripojiť: ['Ⅴ'].
				číslo odčítať: 5.
			}, prerušiť.
			
			(číslo ≥ 4) pravda: {
				rímsky pripojiť: ['Ⅳ'].
				číslo odčítať: 4.
			}, prerušiť.
			
			(číslo ≥ 1) pravda: {
				rímsky pripojiť: ['Ⅰ'].
				číslo odčítať: 1.
			}, prerušiť.
		} procedúra.
	} kým: { <- číslo > 0. }. <- rímsky.
}.

Výstup písať: 1 rímsky, nový-riadok.
Výstup písať: 2 rímsky, nový-riadok.
Výstup písať: 4 rímsky, nový-riadok.
Výstup písať: 8 rímsky, nový-riadok.
Výstup písať: 16 rímsky, nový-riadok.
Výstup písať: 32 rímsky, nový-riadok.
Výstup písať: 64 rímsky, nový-riadok.
Výstup písať: 128 rímsky, nový-riadok.
Výstup písať: 256 rímsky, nový-riadok.
Výstup písať: 1024 rímsky, nový-riadok.
