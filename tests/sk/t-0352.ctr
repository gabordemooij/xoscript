Číslo pri: ['roman'] urobiť: {
	>> číslo := seba kopírovať.
	>> roman := [''].
	{
		{
			(číslo ≥ 1000) pravda: {
				roman pripojiť: ['Ⅿ'].
				číslo odčítať: 1000.
			}, prerušiť.
		
			(číslo ≥ 500) pravda: {
				roman pripojiť: ['Ⅾ'].
				číslo odčítať: 500.
			}, prerušiť.
		
			(číslo ≥ 100) pravda: {
				roman pripojiť: ['Ⅽ'].
				číslo odčítať: 100.
			}, prerušiť.
		
			(číslo ≥ 50) pravda: {
				roman pripojiť: ['Ⅼ'].
				číslo odčítať: 50.
			}, prerušiť.
		
			(číslo ≥ 50) pravda: {
				roman pripojiť: ['Ⅼ'].
				číslo odčítať: 50.
			}, prerušiť.
		
			(číslo ≥ 10) pravda: {
				roman pripojiť: ['Ⅹ'].
				číslo odčítať: 10.
			}, prerušiť.
			
			(číslo ≥ 9) pravda: {
				roman pripojiť: ['Ⅸ'].
				číslo odčítať: 9.
			}, prerušiť.
			
			(číslo ≥ 5) pravda: {
				roman pripojiť: ['Ⅴ'].
				číslo odčítať: 5.
			}, prerušiť.
			
			(číslo ≥ 4) pravda: {
				roman pripojiť: ['Ⅳ'].
				číslo odčítať: 4.
			}, prerušiť.
			
			(číslo ≥ 1) pravda: {
				roman pripojiť: ['Ⅰ'].
				číslo odčítať: 1.
			}, prerušiť.
		} procedúra.
	} kým: { <- číslo > 0. }. <- roman.
}.

Výstup písať: 1 roman, nový-riadok.
Výstup písať: 2 roman, nový-riadok.
Výstup písať: 4 roman, nový-riadok.
Výstup písať: 8 roman, nový-riadok.
Výstup písať: 16 roman, nový-riadok.
Výstup písať: 32 roman, nový-riadok.
Výstup písať: 64 roman, nový-riadok.
Výstup písať: 128 roman, nový-riadok.
Výstup písať: 256 roman, nový-riadok.
Výstup písať: 1024 roman, nový-riadok.
