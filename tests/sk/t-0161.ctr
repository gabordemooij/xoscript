Program správa-pamäte: 0.
Zoznam pri: ['súčet'] urobiť: {
	>> celkom := 0.
	seba každý: { :index :prvok
		celkom pridať: prvok.
	}. <- celkom.
}.

>> použitá-pamäť1 := 0.
>> použitá-pamäť2 := 0.
>> použitá-pamäť3 := 0.
>> použitá-pamäť4 := 0.



>> f := Súbor nový: ['/tmp/test.txt'].
f písať: ['Lorem Ipsum'].
f zavrieť.
  

f := Súbor nový: ['/tmp/test.txt'].
>> znenie := f čítať.
f zavrieť.



Program upratať.
použitá-pamäť1 := (Program pamäť ? 1).



f := Súbor nový: ['/tmp/test.txt'].
znenie := f čítať.
f zavrieť.

Program upratať.
použitá-pamäť2 := (Program pamäť ? 1).


f := Súbor nový: ['/tmp/test.txt'].
znenie := f čítať.
f zavrieť.

Program upratať.
použitá-pamäť3 := (Program pamäť ? 1).



( použitá-pamäť1 = použitá-pamäť2 a: použitá-pamäť1 = použitá-pamäť3, a: použitá-pamäť2 = použitá-pamäť3 ) pravda: {
	Výstup písať: ['Žiadne úniky pamäte'].
}, nepravda: {
	Výstup písať: ['Uniká pamäť...'].
}.
