>> phrases := Zoznam nový
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases každý: { :_ :phrase 
	>> e := Server base64-kódovať: phrase.
	>> d := Server base64-dekódovať: e.
	Výstup písať: (
		message kopírovať ~encoded: e, ~decoded: d
	), nový-riadok.
}.
