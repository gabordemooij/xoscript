>> vety := Zoznam nový
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> odkaz := ['Phrase: ~decoded base64: ~encoded'].
	
vety každý: { :_ :veta 
	>> e := Server base64-kódovať: veta.
	>> d := Server base64-dekódovať: e.
	Výstup písať: (
		odkaz kopírovať ~encoded: e, ~decoded: d
	), nový-riadok.
}.
