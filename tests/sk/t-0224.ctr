
>> countries := Zoznam nový
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Zoznam nový
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods podľa: countries, každý: { :key :value
	counter pridať: 1.
}.

Výstup písať: (['we serve counter dishes'] counter: counter), nový-riadok.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] znaky zoradiť: { :v
	counter pridať: 0.
}.

Výstup písať: (['we sort counter dishes'] counter: counter), nový-riadok.


>> counter := 0.
{
	{
		counter pridať: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Výstup písať: (['we calculate counter numbers.'] counter: counter), nový-riadok.

