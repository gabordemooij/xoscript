

>> Matryoshka := Objekt nový.
Matryoshka pri: ['double:'] urobiť: { :secret
	vlastný secret := secret × 2.
}.
Matryoshka pri: ['nový:'] urobiť: { :secret
	>> answer := Nič.
	>> t := (secret > 255).
	Výstup písať: (secret + [' | '] + t), nový-riadok.
	t pravda: {
		answer := secret.
	}, inak: {
		answer := Matryoshka rekurzívny nový: (seba double: secret).
	}. <- answer.
}.

>> x := Matryoshka nový: 2.
