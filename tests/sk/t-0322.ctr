

>> Matrioška := Objekt nový.
Matrioška pri: ['double:'] urobiť: { :tajomstvo
	vlastný tajomstvo := tajomstvo × 2.
}.
Matrioška pri: ['nový:'] urobiť: { :tajomstvo
	>> odpoveď := Nič.
	>> t := (tajomstvo > 255).
	Výstup písať: (tajomstvo + [' | '] + t), nový-riadok.
	t pravda: {
		odpoveď := tajomstvo.
	}, inak: {
		odpoveď := Matrioška rekurzívny nový: (seba double: tajomstvo).
	}. <- odpoveď.
}.

>> x := Matrioška nový: 2.
