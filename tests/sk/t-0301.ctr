


>> wine := Objekt nový.


wine pri: ['toString'] urobiť: { <- ['merlot'].
}.

wine pri: ['naarTekst'] urobiť: { <- ['merlot'].
}.


wine pri: ['='] urobiť: { :other wine <- ( seba toString = other wine ).
}.

wine pri: ['=='] urobiť: { :other wine <- ( seba toString = other wine ).
}.



wine
	prípad: ['cabernet'] urobiť: { Výstup písať: ['it's a Cabernet!']. },
	prípad: ['syrah']    urobiť: { Výstup písať: ['it's a Syrah!'].    },
	prípad: ['merlot']   urobiť: { Výstup písať: ['it's a Merlot!'].   },
	prípad: ['malbec']   urobiť: { Výstup písať: ['it's a Malbec!'].   }.

