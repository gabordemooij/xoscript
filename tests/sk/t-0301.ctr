


>> víno := Objekt nový.


víno pri: ['na-reťazec'] urobiť: { <- ['merlot'].
}.

víno pri: ['naarTekst'] urobiť: { <- ['merlot'].
}.


víno pri: ['='] urobiť: { :other wine <- ( seba na-reťazec = other wine ).
}.

víno pri: ['=='] urobiť: { :other wine <- ( seba na-reťazec = other wine ).
}.



víno
	prípad: ['cabernet'] urobiť: { Výstup písať: ['je to Cabernet!']. },
	prípad: ['syrah']    urobiť: { Výstup písať: ['je to Syrah!'].    },
	prípad: ['merlot']   urobiť: { Výstup písať: ['je to Merlot!'].   },
	prípad: ['malbec']   urobiť: { Výstup písať: ['je to Malbec!'].   }.

