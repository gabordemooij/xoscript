Server init.

>> DB := Maria-DB nový hostiteľ: ['localhost'],
	používateľ: ['xo'],
	heslo: ['pass123'],
	názov-databázy: ['xobase'],
	pripojiť-sa.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB dopyt: SQL.

# now you don't have to set DB
query2 načítať: { :row
	Výstup písať: row world, nový-riadok.
}.
