Server init.

>> DB := Maria-DB nový hostiteľ: ['localhost'],
	používateľ: ['xo'],
	heslo: ['pass123'],
	názov-databázy: ['xobase'],
	pripojiť-sa.
	
>> SQL := ['SELECT "hello" AS "world" '].

# rýchlejší spôsob, získať dopyt z DB:
>> dopyt2 := DB dopyt: SQL.

# teraz nemusíte nastavovať DB
dopyt2 načítať: { :rad
	Výstup písať: rad world, nový-riadok.
}.
