>> winery := { <- (	Slovník nový
		umiestniť: 2 na: ['merlot'],
		umiestniť: 3 na: ['malbec'],
		umiestniť: 4 na: ['syrah']
	).
}.

Výstup písať: (((winery spustiť) - ['nothing']) počet), nový-riadok.
Výstup písať: (((winery spustiť) - ['merlot']) počet), nový-riadok.
Výstup písať: (((winery spustiť) - ['malbec']) počet), nový-riadok.
Výstup písať: (((winery spustiť) - ['syrah']) počet), nový-riadok.
Výstup písať: (((winery spustiť) - ['merlot'] - ['malbec']) počet), nový-riadok.
Výstup písať: (((winery spustiť) - ['merlot'] - ['syrah']) počet), nový-riadok.
Výstup písať: (((winery spustiť) - ['malbec'] -['syrah']) počet), nový-riadok.
Výstup písať: (((winery spustiť) - ['malbec'] - ['syrah'] - ['merlot']) počet), nový-riadok.

