# test buffers PKI/Sign 
Server init.

>> long := ( Zoznam nový naplniť: 1000 čím: ['a'] ) spojiť: [''].

# sign a message
Výstup písať: ( 
	Trezor podpísať: ['abc'] kľúčom: long
), nový-riadok.

Výstup písať: ( 
	Trezor
		overiť: ['abc'] 
		podpis: long 
		kľúčom: long
), nový-riadok.

Výstup písať: (
	Trezor heš-hesla: long overiť: long
), nový-riadok.
