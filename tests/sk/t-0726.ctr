# test bufferov PKI/podpis 
Server init.

>> dlhý := ( Zoznam nový naplniť: 1000 čím: ['a'] ) spojiť: [''].

# podpísanie správy
Výstup písať: ( 
	Trezor podpísať: ['abc'] kľúčom: dlhý
), nový-riadok.

Výstup písať: ( 
	Trezor
		overiť: ['abc'] 
		podpis: dlhý 
		kľúčom: dlhý
), nový-riadok.

Výstup písať: (
	Trezor heš-hesla: dlhý overiť: dlhý
), nový-riadok.
