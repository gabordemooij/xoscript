#Linux

(Súbor nový: ['/tmp/testje']) existuje nepravda: {
	Program systém: ['mkdir /tmp/testje'].	
}.

(Súbor nový: ['/tmp/testje/file1']) existuje nepravda: {
	Program systém: ['touch /tmp/testje/file1'].	
}.

(Súbor nový: ['/tmp/testje/folder1']) existuje nepravda: {
	Program systém: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Súbor zoznam: ['/tmp/testje'].

>> q := Zoznam nový.

l každý: { :k :v v každý: { :x :y q pripojiť: y. }. }.

>> s := q text.

(s obsahuje: ['file1']) pravda:   { Výstup písať: ['OK'], nový-riadok. }.
(s obsahuje: ['file2']) pravda:   { Výstup písať: ['XX'], nový-riadok. }.
(s obsahuje: ['folder1']) pravda: { Výstup písať: ['OK'], nový-riadok. }.
