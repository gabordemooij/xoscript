
Zoznam pri: ['súčet'] urobiť: {
	>> celkom := 0.
	seba každý: { :index :prvok
		celkom pridať: prvok.
	}. <- celkom.
}.

>> a := Zoznam ← 9 ; 8 ; 7.
Výstup písať: (a súčet), nový-riadok. 
>> a := Zoznam ← 1 ; 9.
Výstup písať: (a súčet), nový-riadok. 
>> a := Zoznam ← ['o'] ; 2.
Výstup písať: (a súčet), nový-riadok. 
Výstup písať: (Zoznam nový súčet), nový-riadok. 
