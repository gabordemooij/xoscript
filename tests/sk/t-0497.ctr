Server init.

# write a test file
>> f := Súbor nový: ['/tmp/test.gif'].
f písať: ['GIF87a01234567810'].

# serve the file
Server odovzdať: ['test.gif'] prefix: ['/tmp/'].

Výstup nový-riadok.

Výstup písať: ['Outside container (security):'], nový-riadok.
{ Server odovzdať: ['../passwd'] prefix: ['/tmp/']. }
zachytiť: { :e Výstup písať: e, nový-riadok. },
spustiť.

Výstup písať: ['Invalid prefix:'], nový-riadok.
{ Server odovzdať: ['test.gif'] prefix: ['z:\\']. }
zachytiť: { :e Výstup písať: e, nový-riadok. },
spustiť.

Výstup písať: ['Non-existant file:'], nový-riadok.
{ Server odovzdať: ['xxx.xxx'] prefix: ['/tmp/']. }
zachytiť: { :e Výstup písať: e, nový-riadok. },
spustiť.
