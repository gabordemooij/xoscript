Server init.

# zápis testovacieho súboru
>> f := Súbor nový: ['/tmp/test.gif'].
f písať: ['GIF87a01234567810'].

# odoslanie súboru
Server odovzdať: ['test.gif'] prefix: ['/tmp/'].

Výstup nový-riadok.

Výstup písať: ['Mimo kontajnera (bezpečnosť):'], nový-riadok.
{ Server odovzdať: ['../passwd'] prefix: ['/tmp/']. }
zachytiť: { :e Výstup písať: e, nový-riadok. },
spustiť.

Výstup písať: ['Neplatný prefix:'], nový-riadok.
{ Server odovzdať: ['test.gif'] prefix: ['z:\\']. }
zachytiť: { :e Výstup písať: e, nový-riadok. },
spustiť.

Výstup písať: ['Neexistujúci súbor:'], nový-riadok.
{ Server odovzdať: ['xxx.xxx'] prefix: ['/tmp/']. }
zachytiť: { :e Výstup písať: e, nový-riadok. },
spustiť.
