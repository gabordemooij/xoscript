>> makeAdder := { :x
	>> f := { :y <- (vlastný x + y). } nastaviť: ['x'] hodnota: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i vlastný q umiestniť: (vlastný f aplikovať: (vlastný q ? i)) na: i. } 
	nastaviť: ['q'] hodnota: array,
	nastaviť: ['f'] hodnota: func.
	{ :i mapping aplikovať: i. } × (array počet).
}.

>> a := Zoznam ← 1; 2; 3.
mapper aplikovať: a a: (makeAdder aplikovať: 100).
Výstup písať: (a pozícia: 0), nový-riadok.
Výstup písať: (a ? 1), nový-riadok.
Výstup písať: (a ? 2), nový-riadok.
