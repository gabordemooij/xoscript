>> vytvoriť-sčítačku := { :x
	>> f := { :y <- (vlastný x + y). } nastaviť: ['x'] hodnota: x. <- f.
}.
>> mapovač := { :pole :fcia
	>> mapovacia-funkcia := { :i vlastný q umiestniť: (vlastný f aplikovať: (vlastný q ? i)) na: i. } 
	nastaviť: ['q'] hodnota: pole,
	nastaviť: ['f'] hodnota: fcia.
	{ :i mapovacia-funkcia aplikovať: i. } × (pole počet).
}.

>> a := Zoznam ← 1; 2; 3.
mapovač aplikovať: a a: (vytvoriť-sčítačku aplikovať: 100).
Výstup písať: (a pozícia: 0), nový-riadok.
Výstup písať: (a ? 1), nový-riadok.
Výstup písať: (a ? 2), nový-riadok.
