

Text pri: ['evaluate'] urobiť: {
	>> kód := Súbor nový: ['/tmp/eval.ctr'].
	kód písať: seba text + ['.'].
	Program použiť: ['/tmp/eval.ctr'].
}.

>> a := (Zoznam ← (
	(Slovník nový)
		umiestniť: ['domain'] na: ['mywebsite.com'],
		umiestniť: (Zoznam ←
			((Slovník nový)
				umiestniť: ['home'] na: ['title'],
				umiestniť: ['<html></html>'] na: ['body'],
				umiestniť: ['2017-01-01'] na: ['created']
			) ;
			((Slovník nový)
				umiestniť: ['aboutus(c)'] na: ['title'],
				umiestniť: ['<credits>Author Inc.</credits>'] na: ['body']
			)
		) na: ['pages']
	)
) text.

Výstup písať: a typ, nový-riadok.
Výstup písať: a, nový-riadok.

>> b := Nič.
(['b := '] + a) evaluate.
Výstup písať: b ? 0 ? ['pages'] ? 1 ? ['body'], nový-riadok.

>> c := b ? 0.
>> d := c text.
Výstup písať: d typ, nový-riadok.

>> e := Nič.
(['e := '] + d) evaluate.
Výstup písať: e ? ['pages'] ? 0, nový-riadok.
