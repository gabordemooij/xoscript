(usedMemory1 = usedMemory2 = usedMemory3 = usedMemory4 = usedMemory5) pravda: {
	Výstup písať: ['Memory usage remains stable.'], nový-riadok.
}, inak: {
	Výstup písať: ['Used memory not stable.'], nový-riadok.
	Výstup písať: usedMemory1, nový-riadok.
	Výstup písať: usedMemory2, nový-riadok.
	Výstup písať: usedMemory3, nový-riadok.
