# test jednotiek

>> $ := Objekt nový.

$ pri: ['odpovedať:'] urobiť: { :x
	
	>> operácia := x znak: 0.
	>> valuta := x znak: 1.
	>> peniaze := x posun: 2.
	
	>> suma := 0.

	( operácia = ['+'] ) pravda: {
		( valuta = ['£'] ) pravda: { suma := 1.28 × peniaze. }.
	}. <- suma.
}.



>> x := $ +£20.

Výstup písať: x, nový-riadok.


>> Ovocie := Objekt nový.

Ovocie pri: ['nový'] urobiť: {
	>> f := seba nový.
	f apples: 0.
	f oranges: 0. <- f.
}.

Ovocie pri: ['apples:'] urobiť: { :a vlastný jablká := a. }.
Ovocie pri: ['oranges:'] urobiť: { :p vlastný pomaranče := p. }.
Ovocie pri: ['jablká'] urobiť: { <- vlastný jablká. }.
Ovocie pri: ['pomaranče'] urobiť: { <- vlastný pomaranče. }.

Ovocie pri: ['+'] urobiť: { :f
	
	>> n := Ovocie nový.
	f pridať: 1.
	
	n apples: (f jablká + vlastný jablká).
	n oranges:  (f pomaranče  + vlastný pomaranče). <- n.
}.

Ovocie pri: ['text'] urobiť: { <- ( vlastný jablká text + [' jabĺk a '] + vlastný pomaranče + [' pomarančov'] ).
}.

Číslo pri: ['jablká'] urobiť: { <- ((Ovocie nový) apples: seba).
}.

Číslo pri: ['apple'] urobiť: { <- ((Ovocie nový) apples: seba).
}.

Číslo pri: ['pomaranče'] urobiť: { <- ((Ovocie nový) oranges: seba).
}.




Výstup písať: (1 apple + 3 pomaranče + 4 jablká), nový-riadok.


Text pri: ['dvakrát'] urobiť: { <- ((seba text) + (seba text)).
}.



Výstup písať: ['❤❤❤'] dvakrát.



