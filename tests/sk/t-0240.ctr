# test qualifiers

>> $ := Objekt nový.

$ pri: ['odpovedať:'] urobiť: { :x
	
	>> operation := x znak: 0.
	>> valuta := x znak: 1.
	>> money := x posun: 2.
	
	>> amount := 0.

	( operation = ['+'] ) pravda: {
		( valuta = ['£'] ) pravda: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Výstup písať: x, nový-riadok.


>> Fruit := Objekt nový.

Fruit pri: ['nový'] urobiť: {
	>> f := seba nový.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit pri: ['apples:'] urobiť: { :a vlastný apples := a. }.
Fruit pri: ['oranges:'] urobiť: { :p vlastný oranges := p. }.
Fruit pri: ['apples'] urobiť: { <- vlastný apples. }.
Fruit pri: ['oranges'] urobiť: { <- vlastný oranges. }.

Fruit pri: ['+'] urobiť: { :f
	
	>> n := Fruit nový.
	f pridať: 1.
	
	n apples: (f apples + vlastný apples).
	n oranges:  (f oranges  + vlastný oranges). <- n.
}.

Fruit pri: ['text'] urobiť: { <- ( vlastný apples text + [' apples and '] + vlastný oranges + [' oranges'] ).
}.

Číslo pri: ['apples'] urobiť: { <- ((Fruit nový) apples: seba).
}.

Číslo pri: ['apple'] urobiť: { <- ((Fruit nový) apples: seba).
}.

Číslo pri: ['oranges'] urobiť: { <- ((Fruit nový) oranges: seba).
}.




Výstup písať: (1 apple + 3 oranges + 4 apples), nový-riadok.


Text pri: ['twice'] urobiť: { <- ((seba text) + (seba text)).
}.



Výstup písať: ['❤❤❤'] twice.



