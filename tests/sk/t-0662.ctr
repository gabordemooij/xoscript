>> t := Nič.

# you can control the time zone for
# parsing like this:
Okamih pásmo: ['CET'].
t := Okamih z: ['1981-02-03 04:05:06'].
Výstup písať: t, nový-riadok.

# now using CEST time zone:
Okamih pásmo: ['CEST'].
t := Okamih z: ['1981-02-03 04:05:06'].
Výstup písať: t, nový-riadok.

# error if string cannot be parsed
{ Okamih z: ['1900']. } zachytiť: { Nič. }, spustiť.
