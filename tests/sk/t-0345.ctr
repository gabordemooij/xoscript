# test metód zachytávajúcich všetko
>> x13 := Objekt nový.
x13 pri: ['a'] urobiť: { :a Výstup písať: 0, nový-riadok. }.
x13 pri: ['a:'] urobiť: { :a Výstup písať: a, nový-riadok. <- 5. }.
x13 pri: ['a:b:'] urobiť: { :a :b Výstup písať: (a + b), nový-riadok. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
