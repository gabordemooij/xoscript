
Server init.
>> pož := HTTP-Požiadavka nový.
Výstup písať: ['HTTP-GET d[]=']  + ( pož get-zoznam: ['d[]'] ), nový-riadok. # GET
Výstup písať: ['HTTP-GET f[]=']  + ( pož get-zoznam: ['f[]'] ), nový-riadok. # GET
Výstup písať: ['HTTP-POST e[]='] + ( pož post-zoznam: ['e[]'] ), nový-riadok. # GET
Výstup písať: ['HTTP-POST c=']   + ( pož post: ['c'] ), nový-riadok. # GET
Výstup písať: ['HTTP-POST xx=']  + ( pož post: ['xx'] ), nový-riadok. # GET
