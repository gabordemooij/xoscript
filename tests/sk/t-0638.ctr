
Server init.
>> rq := HTTP-Požiadavka nový.
Výstup písať: ['HTTP-GET d[]=']  + ( rq get-zoznam: ['d[]'] ), nový-riadok. # GET
Výstup písať: ['HTTP-GET f[]=']  + ( rq get-zoznam: ['f[]'] ), nový-riadok. # GET
Výstup písať: ['HTTP-POST e[]='] + ( rq post-zoznam: ['e[]'] ), nový-riadok. # GET
Výstup písať: ['HTTP-POST c=']   + ( rq post: ['c'] ), nový-riadok. # GET
Výstup písať: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), nový-riadok. # GET
