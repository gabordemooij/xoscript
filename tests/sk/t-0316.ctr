>> Grandfather := Objekt nový.
Grandfather pri: ['greet'] urobiť: {
	Výstup písať: ['Ave!'], nový-riadok.
}.
>> Father := Grandfather nový.
Father pri: ['greet'] urobiť: {
	Výstup písať: ['Hello'], nový-riadok.
	seba greet.
}.
>> Son := Father nový.
Son pri: ['greet'] urobiť: {
	Výstup písať: ['Hi'], nový-riadok.
	seba greet.
}.

Son greet.

>> Roundabout := Objekt nový.
Roundabout pri: ['circle:'] urobiť: { :x
	Výstup písať: x, nový-riadok.
	(x < 3) pravda: { seba rekurzívny circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) pravda: { Výstup písať: x, nový-riadok. x pridať: 1.  increment spustiť. }. }.
increment spustiť.