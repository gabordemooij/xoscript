Výstup písať: ['Test object'], nový-riadok.
>> a := Objekt nový. 

a pri: ['item:'] urobiť: { :logický
	vlastný logický := logický. 
}.

a pri: ['item'] urobiť: { <- vlastný logický.
}.

a item: Pravda.

Výstup písať: a item, nový-riadok.

>> old-bool-address := a item prototyp adresa-pamäte.
a save-as: ['/tmp/a.bin'].
Výstup písať: ['========== RELOADING SNAP:'], nový-riadok.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp adresa-pamäte = old-bool-address) pravda: {
	Výstup písať: ['Object link re-attached.'], nový-riadok.
}.

Výstup písať: b item, nový-riadok.
