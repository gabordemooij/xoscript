Server init.

>> DB := Maria-DB nový hostiteľ: ['localhost'],
	používateľ: ['xo'],
	heslo: ['pass123'],
	názov-databázy: ['xobase'],
	pripojiť-sa.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manuálne vytvorenie dopytu
>> parametre-hľadania := Maria-Dopyt nový: SQL.

# nastavenie databázy
parametre-hľadania databáza: DB.

parametre-hľadania načítať: { :rad
	Výstup písať: rad world, nový-riadok.
}.
