# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB nový hostiteľ: ['localhost'],
	používateľ: ['xo'],
	heslo: ['pass123'],
	názov-databázy: ['xobase'],
	pripojiť-sa.

>> parametre-hľadania := db dopyt: ['SELECT %% FROM'].
{ parametre-hľadania vykonať. } zachytiť: { :e
	Výstup písať: ( e obsahuje: ['%%'] ), nový-riadok.
}, spustiť.
