
Text pri: ['vyhodnotiť'] urobiť: {
	>> kód := Súbor nový: ['/tmp/eval.ctr'].
	kód písať: (seba text + ['.']).
	Program použiť: ['/tmp/eval.ctr'].
}.

>> map :=
	(Slovník nový)
	umiestniť: ['Ahojte'] na: ['two'],
	umiestniť: (Zoznam ← ['hello'] ; ['world'] ; (Zoznam ← 1 ; 2; 9) ; Nepravda) na: ['jeden'],
	umiestniť: ( (Slovník nový) umiestniť: ['svt'] na: ['preklep'] ) na: ['three'],
	umiestniť: (Zoznam ← ((Slovník nový) umiestniť: ['poklad'] na: ['skrytý']) ; 2) na: ['štyri']. 
>> str := map text.
>> map2 := Nič.
(['map2 := '] + str ) vyhodnotiť.
Výstup písať: map2 ? ['jeden'] ? 0.
Výstup písať: map2 ? ['jeden'] ? 1.
Výstup písať: map2 ? ['štyri'] ? 0 ? ['skrytý'].
Výstup písať: map2 ? ['jeden'] ? 2 ? 2.
