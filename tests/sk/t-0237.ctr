
Text pri: ['evaluate'] urobiť: {
	>> kód := Súbor nový: ['/tmp/eval.ctr'].
	kód písať: (seba text + ['.']).
	Program použiť: ['/tmp/eval.ctr'].
}.

>> map :=
	(Slovník nový)
	umiestniť: ['Hi There'] na: ['two'],
	umiestniť: (Zoznam ← ['hello'] ; ['world'] ; (Zoznam ← 1 ; 2; 9) ; Nepravda) na: ['one'],
	umiestniť: ( (Slovník nový) umiestniť: ['wrrld'] na: ['misspelled'] ) na: ['three'],
	umiestniť: (Zoznam ← ((Slovník nový) umiestniť: ['treasure'] na: ['hidden']) ; 2) na: ['four']. 
>> str := map text.
>> map2 := Nič.
(['map2 := '] + str ) evaluate.
Výstup písať: map2 ? ['one'] ? 0.
Výstup písať: map2 ? ['one'] ? 1.
Výstup písať: map2 ? ['four'] ? 0 ? ['hidden'].
Výstup písať: map2 ? ['one'] ? 2 ? 2.
