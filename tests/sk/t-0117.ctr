>> t := Pravda.
(t = Pravda) pravda: { Výstup písať: ['T']. }.
(t = Nepravda) pravda: { Výstup písať: ['F']. }.
Výstup písať: ['|'].
>> t := Nepravda.
(t = Pravda) pravda: { Výstup písať: ['T']. }.
(t = Nepravda) pravda: { Výstup písať: ['F']. }.
Výstup písať: ['|'].
>> f := Pravda.
(t = Pravda a: f = Nepravda) pravda: { Výstup písať: ['T']. }.
(t = Nepravda a: f = Pravda) pravda: { Výstup písať: ['F']. }.
Výstup písať: ['|'].
>> n := Nič.
(n Nič?) pravda: { Výstup písať: ['T']. }.
(n Nič?) nepravda: { Výstup písať: ['F']. }.
Výstup písať: ['|'].
(f Boolean?) pravda: { Výstup písať: ['T']. }.
(f Boolean?) nepravda: { Výstup písať: ['F']. }.



