

Zoznam pri: ['sum'] urobiť: {
	>> total := 0.
	seba každý: { :index :element
		total pridať: element.
	}. <- total.
}.

Zoznam pri: ['product'] urobiť: {
	>> total := 1.
	seba každý: { :index :element
		total vynásobiť: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program správa-pamäte: 0.

{

>> a := Zoznam ← ['hello'] ; ['world'] ; Pravda ; Nič ; 666.
a := a + ( Zoznam ← 1 ).
Výstup písať: ( ['sum: '] + ( a sum ) ), nový-riadok.
Výstup písať: ( ['min: '] + ( a minimum ) ), nový-riadok.
Výstup písať: ( ['max: '] + ( a maximum ) ), nový-riadok.
Výstup písať: ( ['3rd: '] + ( a ? 2 ) ), nový-riadok.
Výstup písať: ( ['prd: '] + ( a product ) ), nový-riadok.
a zoradiť: { :a :b <- (b - a). }.
a každý: { :i :e Výstup písať: ( i - 0 ), nový-riadok. }.

} spustiť.

Program upratať.
usedMemory1 := (Program pamäť ? 0).


{

>> a := Zoznam ← ['hello'] ; ['world'] ; Pravda ; Nič ; 666.
a := a + ( Zoznam ← 1 ).
Výstup písať: ( ['sum: '] + ( a sum ) ), nový-riadok.
Výstup písať: ( ['min: '] + ( a minimum ) ), nový-riadok.
Výstup písať: ( ['max: '] + ( a maximum ) ), nový-riadok.
Výstup písať: ( ['3rd: '] + ( a ? 2 ) ), nový-riadok.
Výstup písať: ( ['prd: '] + ( a product ) ), nový-riadok.
a zoradiť: { :a :b <- (b - a). }.
a každý: { :i :e Výstup písať: ( i - 0 ), nový-riadok. }.

} spustiť.



Program upratať.
usedMemory2 := (Program pamäť ? 0).


{

>> a := Zoznam ← ['hello'] ; ['world'] ; Pravda ; Nič ; 666.
a := a + ( Zoznam ← 1 ).
Výstup písať: ( ['sum: '] + ( a sum ) ), nový-riadok.
Výstup písať: ( ['min: '] + ( a minimum ) ), nový-riadok.
Výstup písať: ( ['max: '] + ( a maximum ) ), nový-riadok.
Výstup písať: ( ['3rd: '] + ( a ? 2 ) ), nový-riadok.
Výstup písať: ( ['prd: '] + ( a product ) ), nový-riadok.
a zoradiť: { :a :b <- (b - a). }.
a každý: { :i :e Výstup písať: ( i - 0 ), nový-riadok. }.

} spustiť.



Program upratať.
usedMemory3 := (Program pamäť ? 0).

( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) pravda: {
	Výstup písať: ['No memory leaks here'].
}, nepravda: {
	Výstup písať: ['Leaking memory...'].
}.
