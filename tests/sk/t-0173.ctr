

Zoznam pri: ['súčet'] urobiť: {
	>> celkom := 0.
	seba každý: { :index :prvok
		celkom pridať: prvok.
	}. <- celkom.
}.

Zoznam pri: ['súčin'] urobiť: {
	>> celkom := 1.
	seba každý: { :index :prvok
		celkom vynásobiť: prvok.
	}. <- celkom.
}.

>> použitá-pamäť1 := 0.
>> použitá-pamäť2 := 0.
>> použitá-pamäť3 := 0.
>> použitá-pamäť4 := 0.

Program správa-pamäte: 0.

{

>> a := Zoznam ← ['hello'] ; ['world'] ; Pravda ; Nič ; 666.
a := a + ( Zoznam ← 1 ).
Výstup písať: ( ['súčet: '] + ( a súčet ) ), nový-riadok.
Výstup písať: ( ['min: '] + ( a minimum ) ), nový-riadok.
Výstup písať: ( ['max: '] + ( a maximum ) ), nový-riadok.
Výstup písať: ( ['3.: '] + ( a ? 2 ) ), nový-riadok.
Výstup písať: ( ['súčin: '] + ( a súčin ) ), nový-riadok.
a zoradiť: { :a :b <- (b - a). }.
a každý: { :i :e Výstup písať: ( i - 0 ), nový-riadok. }.

} spustiť.

Program upratať.
použitá-pamäť1 := (Program pamäť ? 0).


{

>> a := Zoznam ← ['hello'] ; ['world'] ; Pravda ; Nič ; 666.
a := a + ( Zoznam ← 1 ).
Výstup písať: ( ['súčet: '] + ( a súčet ) ), nový-riadok.
Výstup písať: ( ['min: '] + ( a minimum ) ), nový-riadok.
Výstup písať: ( ['max: '] + ( a maximum ) ), nový-riadok.
Výstup písať: ( ['3.: '] + ( a ? 2 ) ), nový-riadok.
Výstup písať: ( ['súčin: '] + ( a súčin ) ), nový-riadok.
a zoradiť: { :a :b <- (b - a). }.
a každý: { :i :e Výstup písať: ( i - 0 ), nový-riadok. }.

} spustiť.



Program upratať.
použitá-pamäť2 := (Program pamäť ? 0).


{

>> a := Zoznam ← ['hello'] ; ['world'] ; Pravda ; Nič ; 666.
a := a + ( Zoznam ← 1 ).
Výstup písať: ( ['súčet: '] + ( a súčet ) ), nový-riadok.
Výstup písať: ( ['min: '] + ( a minimum ) ), nový-riadok.
Výstup písať: ( ['max: '] + ( a maximum ) ), nový-riadok.
Výstup písať: ( ['3.: '] + ( a ? 2 ) ), nový-riadok.
