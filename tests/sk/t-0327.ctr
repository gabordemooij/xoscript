

Zoznam pri: ['fixture:'] urobiť: { :f
	vlastný fixture := f.
}.

Zoznam pri: ['počet'] urobiť: { <- vlastný fixture.
}.

Zoznam pri: ['aantal'] urobiť: { <- vlastný fixture.
}.


>> x := Nič.
{

	x := ['hello'] 
	nahradiť:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] znak: 2)
			)
		)
	za: (
		(['...hal'] + ['lo']) 
			veľké-písmená 
			lowecase 
			veľké-písmená 
			posun: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Zoznam ← 0 ; 1 ; 4; 9 ; (Zoznam ← 0 ; 3; 1) ; 4
							) predposledný
						) ? 1
					) + 
					((Zoznam ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					počet
				)
			)
	).

} × 10.
Výstup písať: x, nový-riadok.

