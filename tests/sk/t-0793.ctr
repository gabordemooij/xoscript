Server init.

>> DB := Maria-DB nový hostiteľ: ['localhost'],
	používateľ: ['xo'],
	heslo: ['pass123'],
	názov-databázy: ['xobase'],
	pripojiť-sa.

{
	DB dopyt:
	['DROP TABLE movies'],
	vykonať.
} zachytiť: { Nič. }, spustiť.

DB dopyt:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
vykonať.

DB dopyt: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parametre: ( Zoznam nový ; ['Halloween'] ),
vykonať.

DB dopyt: ['SELECT * FROM movies'],
načítať: { :film
	Výstup písať: film title, nový-riadok.
}.

