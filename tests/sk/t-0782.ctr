Výstup písať: ['Test object'], nový-riadok.
>> cmd := Príkaz nový.
Výstup písať: cmd ls /tmp, nový-riadok.
>> old-cmd-address := cmd prototyp adresa-pamäte.
cmd save-as: ['/tmp/a.bin'].
Výstup písať: ['========== RELOADING SNAP:'], nový-riadok.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b prototyp adresa-pamäte = old-cmd-address) pravda: {
	Výstup písať: ['Object link re-attached.'], nový-riadok.
}.
Výstup písať: b ls, nový-riadok.


