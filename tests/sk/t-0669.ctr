# Hešovanie hesiel
Server init.

# Používateľ si nastaví heslo
>> hsl := ['pass123'].

# Uložíte ho takto
>> odtlačok := Trezor 
	heš-hesla: hsl.

# Potom sa používateľ prihlási
# Pokus 1
>> a1 := ['abcd123'].
# Pokus 2
>> a2 := ['pass123'].

# Overenie
>> a := Trezor 
	heš-hesla: odtlačok overiť: a1.
	# neúspech 
>> b := Trezor
	heš-hesla: odtlačok overiť: a2.
	# ok!

Výstup písať: a, nový-riadok.
Výstup písať: b, nový-riadok.

