# formát cookie relácie, typ obsahu json, iba webové protokoly, svg zobrazené inline
Server inicializovať.
Program použiť: ['../../../src/xo/sk/webtools.xo'].

>> Falošná-požiadavka := Objekt nový.
Falošná-požiadavka pri: ['value:'] urobiť: { :hodnota
	vlastný hodnota := hodnota.
}.
Falošná-požiadavka pri: ['cookie:'] urobiť: { :názov
	<- vlastný hodnota.
}.

>> Testovacia-relácia := Relácia-dočasný-súbor nový.
Testovacia-relácia pri: ['načítať'] urobiť: {
	<- Slovník nový.
}.
Testovacia-relácia pri: ['identifikátor-relácie'] urobiť: {
	<- vlastný id.
}.

>> cookies := Zoznam nový
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

cookies každý: { :i :cookie
	>> požiadavka := Falošná-požiadavka nový.
	požiadavka value: cookie.
	>> správca := Testovacia-relácia nový.
	>> web := Webový-dokument nový.
	web požiadavka: požiadavka.
	web správca-relácií: správca.
	web začať-reláciu.
	Výstup písať: ( správca identifikátor-relácie = cookie ), nový-riadok.
}.

>> web := Webový-dokument nový.
web json: (Slovník nový umiestniť: ['b'] na: ['a']).
Výstup písať: ['\n'], nový-riadok.

{ Sieť get: ['file:///etc/hostname']. } zachytiť: { :e
	Výstup písať: e, nový-riadok.
}, spustiť.

>> svg := Súbor nový: ['/tmp/test0814.svg'].
svg písať: ['<svg xmlns="x"></svg>'].
Výstup nový-riadok.
Server odovzdať: ['test0814.svg'] prefix: ['/tmp/'].
svg vymazať.
