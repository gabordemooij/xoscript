
Text pri: ['html'] urobiť: { <- (
		seba
		nahradiť: ['&'] za: ['&amp;'],
		nahradiť: ['<'] za: ['&lt;'],
		nahradiť: ['>'] za: ['&gt;'],
		nahradiť: ['"'] za: ['&quot;']
	).
}.

>> HtmlŠtetec := Objekt nový.

HtmlŠtetec pri: ['odpovedať:'] urobiť: { :tag
	Výstup písať: (['<tag>↵'] tag: tag ).
}.

HtmlŠtetec pri: ['odpovedať:a:'] urobiť: { :tag :content
	tag := ( tag od: 0 dĺžka: (tag dĺžka - 1) ).
	Výstup písať: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlŠtetec pri: ['content:'] urobiť: { :znenie
	Výstup písať: znenie html, nový-riadok.
}.

HtmlŠtetec pri: ['atr:hodnota:'] urobiť: { :atr :value <- ['attr="value"'] attr: atr, value: value.
}.

>> h := HtmlŠtetec nový.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h atr: ['class'] hodnota: ['bold']),
		/span
	/body
/html.
		
