>> x := Objekt nový.
>> y := Objekt nový.
>> z := x.
Výstup písať: (x = z), nový-riadok.
Výstup písať: (x = y), nový-riadok.
Výstup písať: (x ≠ y), nový-riadok.
Výstup písať: (x ≠ z), nový-riadok.
>> m := Okamih nový rok: 2070, mesiac: 11.
>> n := m kopírovať.
Výstup písať: (m = n), nový-riadok.
Výstup písať: (m ≠ n), nový-riadok.
Výstup písať: (m rovná-sa: m), nový-riadok.
Výstup písať: (m rovná-sa: n), nový-riadok.
n mesiac: 12.
Výstup písať: (m ≠ n), nový-riadok.
Výstup písať: (m = n), nový-riadok.


