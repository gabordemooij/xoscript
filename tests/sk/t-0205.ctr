>> str := ['write:'].
Výstup správa: ['písať:'] argumenty: (Zoznam ← ['Hello World']), nový-riadok. 

Číslo pri: ['isbetween:and:'] urobiť: { :a :b <- ((seba ≥ a) a: (seba ≤ b)).
}.

str := ['isbetween:and:'].
Výstup písať: (3 správa: str argumenty: (Zoznam ← 2 ; 8)), nový-riadok.
Výstup písať: (3 správa: str argumenty: (Zoznam ← 1 ; 2)), nový-riadok.


>> Kávovar := Objekt nový.
Kávovar pri: ['makeCoffeeWithSugar:milk:'] urobiť: { :sugar :milk <- ( ['Nech sa páči... káva s '] + 
			sugar +
			[' lyžičkami cukru a '] +
			milk +
			[' kvapkami mlieka.']
	).
}.

>> objednávka := ['makeCoffeeWithSugar:milk:'].
>> nastavenie-kávy := Zoznam ← 4 ; 2.
Výstup písať: ( Kávovar správa: objednávka argumenty: nastavenie-kávy ), nový-riadok.
