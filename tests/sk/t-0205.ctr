>> str := ['write:'].
Výstup správa: ['písať:'] argumenty: (Zoznam ← ['Hello World']), nový-riadok. 

Číslo pri: ['isbetween:and:'] urobiť: { :a :b <- ((seba ≥ a) a: (seba ≤ b)).
}.

str := ['isbetween:and:'].
Výstup písať: (3 správa: str argumenty: (Zoznam ← 2 ; 8)), nový-riadok.
Výstup písať: (3 správa: str argumenty: (Zoznam ← 1 ; 2)), nový-riadok.


>> CoffeeMachine := Objekt nový.
CoffeeMachine pri: ['makeCoffeeWithSugar:milk:'] urobiť: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Zoznam ← 4 ; 2.
Výstup písať: ( CoffeeMachine správa: order argumenty: coffeeConfiguration ), nový-riadok.
