
>> a := Zoznam ← (Zoznam ← 100 ; 200 ; 300) ; (Zoznam ← 9 ; 8 ; 7).
Výstup písať: ['at 0,1 :'].
Výstup písať: a ? 0 ? 1, nový-riadok. 
Výstup písať: ['at 1,2 :'].
Výstup písať: a ? 1 ? 2, nový-riadok. 
>> menu := Slovník nový.
menu umiestniť: (Zoznam ← ['pizza'] ; ['spaghetti']) na: ['Italian Cuisine'].
menu umiestniť: (Zoznam ← ['bifteki'] ; ['suflaki']) na: ['Greek Cuisine'].
Výstup písať: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), nový-riadok. 
Výstup písať: ['but not on the same plate.'], nový-riadok.
