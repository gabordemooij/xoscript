# test url parsing

Server init.
>> url := URL z: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Výstup písať: ['scheme = '] + url schéma, nový-riadok.
Výstup písať: ['host = '] + url hostiteľ, nový-riadok.
Výstup písať: ['port = '] + url port, nový-riadok.
Výstup písať: ['path = '] + url cesta, nový-riadok.
Výstup písať: ['query = '] + url parametre-hľadania, nový-riadok.
Výstup písať: ['fragment = '] + url fragment, nový-riadok.
