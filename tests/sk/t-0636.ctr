# test parsovania url

Server init.
>> url := URL z: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Výstup písať: ['schéma = '] + url schéma, nový-riadok.
Výstup písať: ['hostiteľ = '] + url hostiteľ, nový-riadok.
Výstup písať: ['port = '] + url port, nový-riadok.
Výstup písať: ['cesta = '] + url cesta, nový-riadok.
Výstup písať: ['dopyt = '] + url parametre-hľadania, nový-riadok.
Výstup písať: ['fragment = '] + url fragment, nový-riadok.
