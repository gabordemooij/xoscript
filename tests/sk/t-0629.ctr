# test databázy
# potrebnú konfiguráciu nájdete v príklade server.xo

Server init.
Výstup písať: ['Test databázy'], nový-riadok.

>> db := Maria-DB nový hostiteľ: ['localhost'],
	používateľ: ['xo'], heslo: ['pass123'], názov-databázy: ['xobase'], pripojiť-sa.

Výstup písať: ['Dá sa pripojiť? '] + db pripojené?, nový-riadok.

>> parametre-hľadania := db dopyt: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parametre: ( Zoznam nový ; ['abc'] ; 12.35 ; 6 ). # parametrizované dopyty

{  parametre-hľadania vykonať. db potvrdiť. } zachytiť: { :e db vrátiť-späť.  }, spustiť.

Výstup písať: ['Dá sa vkladať? '] + ( parametre-hľadania insert-id > 0 ), nový-riadok.

>> Obj := Objekt nový.
Obj pri: ['načítať-riadky'] urobiť: {
	vlastný počet := 0.
	>> parametre-hľadania :=
	db dopyt: ['SELECT * FROM book order by id desc limit 2'], 
	načítať: { :rad 
		vlastný počet pridať: 1.
		Pravda prerušiť.
	}. # načítanie riadkov
	<- vlastný počet kopírovať.
}.

Výstup písať: ['Dá sa dopytovať? '] + ( Obj načítať-riadky > 0 ), nový-riadok.
