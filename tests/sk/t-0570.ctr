#Linux

 >> t := Okamih nový.
 
t pásmo: ['Europe/Amsterdam'].
t rok: 2020, mesiac: 8, deň: 2, hodina: 21, minúta: 2, sekunda: 1.

>> a := t hodina.
>> ams := t pásmo.

t pásmo: ['US/Hawaii'].
>> b := t hodina.
>> hw := t pásmo.

Výstup
písať: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		buď: ['later'] alebo: ['earlier']
	)
),
nový-riadok.
 