Server init.
Výstup písať: ['Test dátumu v databáze'], nový-riadok.

>> db := Maria-DB nový hostiteľ: ['localhost'],
	používateľ: ['xo'], 
	heslo: ['pass123'],
	názov-databázy: ['xobase'],
	pripojiť-sa.

>> parametre-hľadania :=
db dopyt: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
načítať: { :rad
	Výstup písať: rad datetest, nový-riadok.
}.
