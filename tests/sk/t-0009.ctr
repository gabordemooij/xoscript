>> Pozdravovač := Objekt nový.
Pozdravovač pri: ['vyrobiť'] urobiť: {
	>> pozdravovač := Objekt nový.
	pozdravovač pri: ['name:'] urobiť: { :názov
		Výstup písať: ['nastavujem meno'].
		vlastný moje-meno := názov.
	}.
	pozdravovač pri: ['vykonať-pozdrav'] urobiť: {
		Výstup písať: ['Hello'].
		Výstup písať: vlastný moje-meno.
	}.
	pozdravovač pri: ['pozdraviť'] urobiť: {
		seba vykonať-pozdrav.
	}. <- pozdravovač.
}.
>> pozdravovač := Pozdravovač vyrobiť.
pozdravovač name: ['slniečko!'].
pozdravovač pozdraviť.
