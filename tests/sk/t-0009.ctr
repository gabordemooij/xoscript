>> Greeter := Objekt nový.
Greeter pri: ['make'] urobiť: {
	>> greeter := Objekt nový.
	greeter pri: ['name:'] urobiť: { :názov
		Výstup písať: ['setting a name'].
		vlastný myName := názov.
	}.
	greeter pri: ['performGreeting'] urobiť: {
		Výstup písať: ['Hello'].
		Výstup písať: vlastný myName.
	}.
	greeter pri: ['greet'] urobiť: {
		seba performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
