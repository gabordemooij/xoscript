# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> cesta := ['/tmp/dat.csv'].
>> csv := Súbor nový: cesta.
csv písať: s.

# accepts CRLF LF CR, varying row length
csv oddeľovač: [';'] úvodzovka: ['"'] riadky: { :line
	Program upratať.
	Výstup písať: line, nový-riadok.
	Program upratať.
}.

# unequal lines
s pripojiť: ['\njustone'].
csv písať: s.
{
	csv oddeľovač: [';'] úvodzovka: ['"'] riadky: { :line
		Výstup písať: line, nový-riadok.
	}.
} zachytiť: { :e 
	Výstup písať: e, nový-riadok.
}, spustiť.

# invalid format
s := ['"he"llo";world'].
csv písať: s.
{
	csv oddeľovač: [';'] úvodzovka: ['"'] riadky: { :line
		Výstup písať: line, nový-riadok.
	}.
} zachytiť: { :e 
	Výstup písať: e, nový-riadok.
}, spustiť.
