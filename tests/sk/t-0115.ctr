{
	táto-úloha chyba: ['Nezlyhaj.'].
	neznámy urob-niečo.
} zachytiť: {
	Výstup písať: ['Chytené!'].
}, spustiť.

{
	táto-úloha chyba: ['Nezlyhaj.'].
	vlastný neznámy urob-niečo.
} zachytiť: {
	Výstup písať: ['Chytené!'].
}, spustiť.

{
	táto-úloha chyba: ['Nezlyhaj.'].
	neznámy := 122.
} zachytiť: {
	Výstup písať: ['Chytené!'].
}, spustiť.


{
	táto-úloha chyba: ['Nezlyhaj.'].
	Pravda prerušiť.
	Výstup písať: ['CHYBA'].
} zachytiť: {
	Výstup písať: ['Chytené!'].
}, spustiť.

{
	{
		táto-úloha chyba: ['Nezlyhaj.'].
		Pravda prerušiť.
		Výstup písať: ['CHYBA'].
	} zachytiť: { :x
		(x = ['Nezlyhaj.']) pravda: { táto-úloha chyba: ['Vnorene chytené!']. }.
	}, spustiť.
} zachytiť: { :e
	Výstup písať: e.
}, spustiť.
