{
	táto-úloha chyba: ['Dont fail.'].
	unknown doSomething.
} zachytiť: {
	Výstup písať: ['Caught!'].
}, spustiť.

{
	táto-úloha chyba: ['Dont fail.'].
	vlastný unknown doSomething.
} zachytiť: {
	Výstup písať: ['Caught!'].
}, spustiť.

{
	táto-úloha chyba: ['Dont fail.'].
	unknown := 122.
} zachytiť: {
	Výstup písať: ['Caught!'].
}, spustiť.


{
	táto-úloha chyba: ['Dont fail.'].
	Pravda prerušiť.
	Výstup písať: ['FAIL'].
} zachytiť: {
	Výstup písať: ['Caught!'].
}, spustiť.

{
	{
		táto-úloha chyba: ['Dont fail.'].
		Pravda prerušiť.
		Výstup písať: ['FAIL'].
	} zachytiť: { :x
		(x = ['Dont fail.']) pravda: { táto-úloha chyba: ['Nested Caught!']. }.
	}, spustiť.
} zachytiť: { :e
	Výstup písať: e.
}, spustiť.
