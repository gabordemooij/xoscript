Výstup písať: ['Test object'], nový-riadok.
>> a := Objekt nový. 

a pri: ['item:'] urobiť: { :dict
	vlastný dict := dict. 
}.

a pri: ['item'] urobiť: { <- vlastný dict.
}.

a item: (
Slovník nový
	hello: ['world'],
	world: (Slovník nový umiestniť: ['a'] na: ['b'])).

Výstup písať: a item, nový-riadok.

>> old-dict-address := a item prototyp adresa-pamäte.
a save-as: ['/tmp/a.bin'].
Výstup písať: ['========== RELOADING SNAP:'], nový-riadok.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp adresa-pamäte = old-dict-address) pravda: {
	Výstup písať: ['Object link re-attached.'], nový-riadok.
}.

Výstup písať: b item, nový-riadok.
