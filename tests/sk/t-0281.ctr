>> q := Zoznam ← 1 ; 2 ; 3.
{ q ? ['1']. } zachytiť: { Výstup písať: ['chytené!'], nový-riadok. }, spustiť.
{ q ? Pravda. } zachytiť: { Výstup písať: ['chytené!'], nový-riadok. }, spustiť.
{ q ? Nepravda. } zachytiť: { Výstup písať: ['chytené!'], nový-riadok. }, spustiť.
{ q ? Nič. } zachytiť: { Výstup písať: ['chytené!'], nový-riadok. }, spustiť.
{ q ? (Zoznam nový). } zachytiť: { Výstup písať: ['chytené!'], nový-riadok. }, spustiť.
{ q ? (Objekt nový). } zachytiť: { Výstup písať: ['chytené!'], nový-riadok. }, spustiť.
{ q ? ({ ['Prázdne']. }). } zachytiť: { Výstup písať: ['chytené!'], nový-riadok. }, spustiť.
Výstup písať: ['všetky chytené'], nový-riadok.
