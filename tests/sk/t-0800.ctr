Server init.

>> db := Maria-DB nový hostiteľ: ['localhost'],
	používateľ: ['xo'],
	heslo: ['pass123'],
	názov-databázy: ['xobase'],
	pripojiť-sa.

>> parametre-hľadania := db dopyt: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parametre: ( Zoznam nový ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  parametre-hľadania vykonať. db potvrdiť. } zachytiť: { :e db vrátiť-späť.  }, spustiť.

Výstup písať: ['Can we insert? '] + ( parametre-hľadania insert-id > 0 ), nový-riadok.
