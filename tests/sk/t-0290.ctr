# test list operations


>> cakes := Zoznam ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes nahradiť: 1 dĺžka: 2 za: ( Zoznam ← ['cinnamon'] ; ['pineapple'] ).
Výstup písať: (buy spojiť: [',']), nový-riadok.


>> buy := cakes nahradiť: 1 dĺžka: 12 za: ( Zoznam ← ['cinnamon'] ; ['pineapple'] ).
Výstup písať: (buy spojiť: [',']), nový-riadok.


>> buy := cakes nahradiť: 2 dĺžka: 10 za: ( Zoznam nový ).
Výstup písať: (buy spojiť: [',']), nový-riadok.


>> buy := cakes nahradiť: 0 dĺžka: 1 za: ( Zoznam nový ).
Výstup písať: (buy spojiť: [',']), nový-riadok.


>> buy := cakes nahradiť: ['0'] dĺžka: ['1'] za: ['x'].
Výstup písať: (buy spojiť: [',']), nový-riadok.
