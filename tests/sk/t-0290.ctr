# test operácií so zoznamom


>> koláče := Zoznam ←
	['apple'] ;
	['bobuľa'] ;
	['čoko'] ;
	['syr'].


>> kúpiť := koláče nahradiť: 1 dĺžka: 2 za: ( Zoznam ← ['škorica'] ; ['ananás'] ).
Výstup písať: (kúpiť spojiť: [',']), nový-riadok.


>> kúpiť := koláče nahradiť: 1 dĺžka: 12 za: ( Zoznam ← ['škorica'] ; ['ananás'] ).
Výstup písať: (kúpiť spojiť: [',']), nový-riadok.


>> kúpiť := koláče nahradiť: 2 dĺžka: 10 za: ( Zoznam nový ).
Výstup písať: (kúpiť spojiť: [',']), nový-riadok.


>> kúpiť := koláče nahradiť: 0 dĺžka: 1 za: ( Zoznam nový ).
Výstup písať: (kúpiť spojiť: [',']), nový-riadok.


>> kúpiť := koláče nahradiť: ['0'] dĺžka: ['1'] za: ['x'].
Výstup písať: (kúpiť spojiť: [',']), nový-riadok.
