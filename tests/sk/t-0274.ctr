

Zoznam pri: ['column:'] urobiť: { :stĺpec
	>> výsledok := Zoznam nový.
	seba každý: { :index :rad
		rad každý: { :index :bunka
			(index = stĺpec) pravda: { výsledok pripojiť: bunka. }.
		}.
	}. <- výsledok.
}.


>> a := Zoznam ←
	(Zoznam ← 1 ; 2 ; 3) ;
	(Zoznam ← 4 ; 5 ; 6) ;
	(Zoznam ← 7 ; 8 ; 9).

>> b := a column: 1.
Výstup písať: b, nový-riadok.

b := a column: 20.
Výstup písať: b, nový-riadok.

b := a column: -100.
Výstup písať: b, nový-riadok.
