

Zoznam pri: ['column:'] urobiť: { :column
	>> result := Zoznam nový.
	seba každý: { :index :row
		row každý: { :index :cell
			(index = column) pravda: { result pripojiť: cell. }.
		}.
	}. <- result.
}.


>> a := Zoznam ←
	(Zoznam ← 1 ; 2 ; 3) ;
	(Zoznam ← 4 ; 5 ; 6) ;
	(Zoznam ← 7 ; 8 ; 9).

>> b := a column: 1.
Výstup písať: b, nový-riadok.

b := a column: 20.
Výstup písať: b, nový-riadok.

b := a column: -100.
Výstup písať: b, nový-riadok.
