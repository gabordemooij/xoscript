


>> Deck := Zoznam nový.
Deck pri: ['print'] urobiť: {
        >> len := seba počet - 1.
        { :i
                >> len2 := seba počet - 1.
                Výstup písať: ['len: '].
                Výstup písať: len, nový-riadok.
                Výstup písať: ['len2: '].
                Výstup písať: len2, nový-riadok.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
