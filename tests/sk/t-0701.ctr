# verejný kľúč (na zabezpečenie API atď.)
Server init.

# vygenerovanie kľúčov
>> kľúče := Trezor vygenerovať-kľúče.

# súkromný (tajný) kľúč
>> sk := kľúče prvý.

# verejný kľúč
>> pk := kľúče posledný.

# podpísanie správy
>> sig := Trezor podpísať: ['abc'] kľúčom: sk.

Výstup písať: sig dĺžka, nový-riadok.