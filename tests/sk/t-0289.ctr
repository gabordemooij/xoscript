#Linux
>> OS := Program systém: (Príkaz uname -s), orezať.

>> Hltač := Objekt nový.
Hltač pri: ['nový'] urobiť: {
	vlastný str := [''].
}.
Hltač pri: ['odpovedať:'] urobiť: { :blah
		(vlastný str ≠ ['']) pravda: {
			vlastný str pripojiť: [' '].
		}.
		vlastný str pripojiť: blah.
}.
Hltač pri: ['odpovedať:a:'] urobiť: { :blah :blahah
		(vlastný str ≠ ['']) pravda: {
			vlastný str pripojiť: [' '].
		}.
		(blah dĺžka > 1) pravda: {
			vlastný str pripojiť: (blah od: 0 dĺžka: (blah dĺžka - 1)).
		}, inak: {
			vlastný str pripojiť: blah.
		}.
		vlastný str pripojiť: [' '].
		vlastný str pripojiť: blahah.
}.
Hltač pri: ['obdržať'] urobiť: {
	>> buffer := vlastný str.
	vlastný str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text pripojiť: ['hello'].
} × 1000.


Výstup písať: (
	Program systém: (
		Hltač nový
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obdržať
).

