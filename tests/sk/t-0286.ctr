['Tisíce a desatinné miesta'].

>> x := 100000000.5.
>> y := 100000000.5.

Výstup písať: (x + y), nový-riadok.

>> x := 10040.07.
>> y := 10305.60.

Výstup písať: (x + y), nový-riadok.

['Desatinné'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Výstup písať: (x + y + z), nový-riadok.

['Divné, ale platné'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Výstup písať: (x + y + z), nový-riadok.

>> q := 0.1.2.

Výstup písať: (q), nový-riadok.

>> q := 012.

Výstup písať: (q), nový-riadok.
