

Text pri: ['evaluate'] urobiť: {
	>> kód := Súbor nový: ['/tmp/eval.ctr'].
	kód písať: (seba text + ['.']).
	Program použiť: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Zoznam ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q text.
Výstup písať: x, nový-riadok.
>> y := Nič.
(['y := '] + x ) evaluate.
Výstup písať: y ? 0, nový-riadok.

q := Slovník umiestniť: ['\[''] na: ['\['quote\']'].
x := q text.
Výstup písať: x, nový-riadok.
y := Nič.
(['y := '] + x ) evaluate.

>> q := (Slovník nový) umiestniť:['\[''] na:['\['quote\[''].
Výstup písať: y ? ['\['quote\']'], nový-riadok.
