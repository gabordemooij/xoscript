#ffi test


Server init.

Program správa-pamäte: 4.

# for this test you need set a path to libc (puts)
>> libname := Program nastavenie: ['FFITESTLIB'].



Server prepojiť: (
 Zoznam nový ;
 libname ;
 ['puts'] ;
 ( Zoznam nový ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s uvoľniť.

# test with struct

>> a := Blob nový: 8.
a bytes: (
	Zoznam <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Zoznam <<: ['int'], ; ['int']).

Server prepojiť: (
	Zoznam <<: ['@structtest'], ;
	['@structtest'] ;
	(Zoznam <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Výstup písať: ['Sum test:'] + (ffitest ffisum: a), nový-riadok.

struct uvoľniť-struct.
struct uvoľniť.
a uvoľniť.
