# formát musí zodpovedať typu hodnoty, typ môže prísť od klienta
>> skúsiť := { :formátovanie :value
	{ Výstup písať: ( (Formát nový: formátovanie) aplikovať: value ), nový-riadok. } zachytiť: { :e Výstup písať: e, nový-riadok. }, spustiť.
}.
>> skúsiť-celé := { :formátovanie :value
	{ Výstup písať: ( (Formát nový: formátovanie) aplikovať-celé: value ), nový-riadok. } zachytiť: { :e Výstup písať: e, nový-riadok. }, spustiť.
}.

# sedí
skúsiť aplikovať: ['|%s|'] a: ['text'].
skúsiť aplikovať: ['%06.2f'] a: 5.5.
skúsiť aplikovať: ['100%% %s'] a: ['iste'].
skúsiť-celé aplikovať: ['%03d'] a: 7.
skúsiť-celé aplikovať: ['%x'] a: 255.
skúsiť aplikovať: ['%d'] a: (Int64 nový z-textu: ['12']).
skúsiť aplikovať: ['%lld'] a: (Int64 nový z-textu: ['12']).
skúsiť aplikovať: ['%.1lf'] a: 5.5.
skúsiť-celé aplikovať: ['%hd'] a: 7.

# nesedí
skúsiť aplikovať: ['%s'] a: 12345.
skúsiť aplikovať: ['%d'] a: 12345.
skúsiť aplikovať: ['%f'] a: ['text'].
skúsiť-celé aplikovať: ['%d'] a: ['text'].
skúsiť-celé aplikovať: ['%s'] a: 5.
skúsiť aplikovať: ['%s %s'] a: ['text'].
skúsiť aplikovať: ['%n'] a: ['text'].
skúsiť aplikovať: ['%*s'] a: ['text'].
skúsiť aplikovať: ['%'] a: ['text'].

# modifikátor dĺžky nesedí
skúsiť aplikovať: ['%ls'] a: ['text'].
skúsiť aplikovať: ['%Lf'] a: 5.5.
skúsiť-celé aplikovať: ['%ld'] a: 7.
skúsiť-celé aplikovať: ['%lld'] a: 7.
skúsiť aplikovať: ['%Ld'] a: (Int64 nový z-textu: ['12']).

# šírka, ktorá nesedí pre printf, musí dať chybu, nie pád
skúsiť aplikovať: ['%99999999999s'] a: ['text'].
