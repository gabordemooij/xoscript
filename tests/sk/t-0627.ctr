

# create a 64-bit integer for exact calculations
>> a := Int64 z-textu: ['123'].

# to string
Výstup písať: a, nový-riadok.

# divide
Výstup písať: a / (Int64 z-textu: ['3']), nový-riadok.

# multiply
Výstup písať: a * (Int64 z-textu: ['2']), nový-riadok.

# add
Výstup písať: a + (Int64 z-textu: ['1']), nový-riadok.

# subtract
Výstup písať: a - (Int64 z-textu: ['2']), nový-riadok.

# compare
Výstup písať: ( a =   (Int64 z-textu: ['123'])), nový-riadok.
Výstup písať: ( a !=: (Int64 z-textu: ['124'])), nový-riadok.
Výstup písať: ( a <   (Int64 z-textu: ['124'])), nový-riadok.
Výstup písať: ( a >   (Int64 z-textu: ['122'])), nový-riadok.
Výstup písať: ( a >=: (Int64 z-textu: ['123'])), nový-riadok.
Výstup písať: ( a <=: (Int64 z-textu: ['123'])), nový-riadok.





	