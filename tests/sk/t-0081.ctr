>> map1 := Slovník nový.
>> key1 := Zoznam nový.
>> key2 := Zoznam nový.

map1
	umiestniť: ['hello'] na: key1,
	umiestniť: ['world'] na: key2.


Výstup
	písať: ['Map #1 contains: '] + (map1 na: key1),
	písať: [' and '] + (map1 na: key2), nový-riadok.

>> KeyeableArray := Zoznam nový.
KeyeableArray pri: ['toString'] urobiť: { <- (seba počet) toString.
}.

>> map2 := Slovník nový.
key1 := KeyeableArray nový.
key2 := KeyeableArray nový.

key1 pripojiť: 1.

map2
	umiestniť: ['hello'] na: key1,
	umiestniť: ['world'] na: key2.

Výstup
	písať: ['Map #2 contains: '] + (map2 na: key1),
	písať: [' and '] + (map2 na: key2), nový-riadok.
