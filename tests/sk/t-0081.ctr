>> mapa1 := Slovník nový.
>> kľúč1 := Zoznam nový.
>> kľúč2 := Zoznam nový.

mapa1
	umiestniť: ['hello'] na: kľúč1,
	umiestniť: ['world'] na: kľúč2.


Výstup
	písať: ['Map #1 contains: '] + (mapa1 na: kľúč1),
	písať: [' a '] + (mapa1 na: kľúč2), nový-riadok.

>> KľúčovateľnéPole := Zoznam nový.
KľúčovateľnéPole pri: ['na-reťazec'] urobiť: { <- (seba počet) na-reťazec.
}.

>> map2 := Slovník nový.
kľúč1 := KľúčovateľnéPole nový.
kľúč2 := KľúčovateľnéPole nový.

kľúč1 pripojiť: 1.

map2
	umiestniť: ['hello'] na: kľúč1,
	umiestniť: ['world'] na: kľúč2.

Výstup
	písať: ['Map #2 contains: '] + (map2 na: kľúč1),
	písať: [' a '] + (map2 na: kľúč2), nový-riadok.
