Číslo pri: ['factorial'] urobiť: {
	>> total := 1.
	{ :index total vynásobiť: (seba - (index)). } × seba. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Výstup písať: a.
>> b := 2 + 3 factorial.
Výstup písať: b.
>> c := 3 factorial + 2.
Výstup písať: c.
>> d := 2 + (3 factorial).
Výstup písať: d.
Výstup písať: 2 + 3 factorial + 1.
