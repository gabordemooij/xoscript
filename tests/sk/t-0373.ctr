# test zhody

# použiť medzinárodné čísla

Výstup písať: ['1000 -> '].
Výstup písať: 1000, nový-riadok. #1000

Výstup písať: ['1.5 -> '].
Výstup písať: 1.5, nový-riadok.  #1.5

Výstup písať: ['1001.5 -> '].
Výstup písať: 1.5 + 1000, nový-riadok. #1001.5

# použiť polia indexované od 0
>> x := Zoznam nový ; 1 ; 2 ; 3.
>> y := Zoznam nový ; ['a'] ; ['b'] ; ['c'].

Výstup písať: ['1 -> '].
Výstup písať: x ? 0, nový-riadok. #1

Výstup písať: ['1 -> '].
Výstup písať: (x na: 0), nový-riadok. #1

Výstup písať: ['1 -> '].
Výstup písať: x prvý, nový-riadok. #1

Výstup písať: ['3 -> '].
Výstup písať: x posledný, nový-riadok. #3

Výstup písať: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Výstup písať: (x podľa: y), nový-riadok.

Výstup písať: ['1 -> '].
Výstup písať: (x od: 0 dĺžka: 1) prvý, nový-riadok. #1

Výstup písať: ['0 -> '].
Výstup písať: (x nájsť: 1), nový-riadok. #0

x umiestniť: 9 na: 0.

Výstup písať: ['9 -> '].
Výstup písať: (x na: 0), nový-riadok. #9

x predradiť: 8.
Výstup písať: ['8 -> '].
Výstup písať: (x na: 0), nový-riadok. #9


x pripojiť: 10.
Výstup písať: ['10 -> '].
Výstup písať: (x na: 4), nový-riadok. #10








