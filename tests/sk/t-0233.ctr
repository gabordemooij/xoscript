
>> Hltač := Objekt nový.

Hltač pri: ['nový'] urobiť: {
	vlastný str := [''].
}.

Hltač pri: ['odpovedať:'] urobiť: { :blah
		(vlastný str = ['']) pravda: {
			vlastný str pripojiť: blah.
		}, inak: {
			vlastný str pripojiť: [' '].
			vlastný str pripojiť: blah.
		}.
}.

Hltač pri: ['odpovedať:a:'] urobiť: { :blah :blahah
		(blah dĺžka > 1) pravda: {
			vlastný str pripojiť: (blah od: 0 dĺžka: (blah dĺžka - 1)).
		}, inak: {
			vlastný str pripojiť: blah.
		}.
		vlastný str pripojiť: [' '].
		vlastný str pripojiť: blahah.
}.

Hltač pri: ['obdržať'] urobiť: {
	>> buffer := vlastný str.
	vlastný str := ['']. <- buffer.
}.

Výstup písať: ( Program systém: ( Hltač nový echo hello world obdržať ) ).
