# Test variantov ASCII

# Čísla

Výstup písať: (2 !=: 3), nový-riadok.
Výstup písať: (2 <=: 2), nový-riadok.
Výstup písať: (2 >=: 2), nový-riadok.

# Texty

Výstup písať: (['b'] >=: ['a']), nový-riadok.
Výstup písať: (['b'] !=: ['a']), nový-riadok.
Výstup písať: (['b'] <=: ['c']), nový-riadok.

# Logické hodnoty

Výstup písať: (Pravda !=: Nepravda), nový-riadok.

# Objekty

Výstup písať: (Objekt nový !=: Objekt nový), nový-riadok.

# ASCII symbol zoznamu <-:

Výstup písať: (Zoznam <<: 1, ; 2 ; 3) počet = 3, nový-riadok.

