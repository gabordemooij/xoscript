# hodnota končiaca prvou časťou otváracej úvodzovky musí prežiť serializáciu
>> hodnoty := Zoznam nový
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

hodnoty každý: { :i :value
	>> d := Slovník nový.
	d umiestniť: value na: ['k'].
	d umiestniť: ['second'] na: ['j'].
	>> r := d kód objekt.
	Výstup písať: r počet, nový-riadok.
	Výstup písať: ( (r na: ['k']) = value ), nový-riadok.
}.
