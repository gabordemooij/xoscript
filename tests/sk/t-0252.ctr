#Linux
>> clock := Okamih nový.
clock pásmo: ['UTC-1'].
clock rok: 1981, mesiac: 1, deň: 5,
      hodina: 13, minúta: 15, sekunda: 13.

Výstup písať: clock, nový-riadok.
clock pásmo: ['UTC+0'].

Výstup písať: (
	(clock rok surový) + ['-'] + (clock mesiac) + ['-'] + (clock deň) + [' '] +
	(clock hodina) + [':'] + (clock minúta) + [':'] + (clock sekunda) + [' '] +
	['W'] + (clock týždeň) + (clock pásmo)
), nový-riadok.


clock pásmo: ['UTC-1'].
Výstup písať: (
	(clock rok surový) + ['-'] + (clock mesiac) + ['-'] + (clock deň) + [' '] +
	(clock hodina) + [':'] + (clock minúta) + [':'] + (clock sekunda) + [' '] +
	['W'] + (clock týždeň) + (clock pásmo)
), nový-riadok.
