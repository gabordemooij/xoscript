#Linux
>> hodiny := Okamih nový.
hodiny pásmo: ['UTC-1'].
hodiny rok: 1981, mesiac: 1, deň: 5,
      hodina: 13, minúta: 15, sekunda: 13.

Výstup písať: hodiny, nový-riadok.
hodiny pásmo: ['UTC+0'].

Výstup písať: (
	(hodiny rok surový) + ['-'] + (hodiny mesiac) + ['-'] + (hodiny deň) + [' '] +
	(hodiny hodina) + [':'] + (hodiny minúta) + [':'] + (hodiny sekunda) + [' '] +
	['W'] + (hodiny týždeň) + (hodiny pásmo)
), nový-riadok.


