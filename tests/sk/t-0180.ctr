Text pri: ['html'] urobiť: { <- (
		seba
		nahradiť: ['&'] za: ['&amp;'],
		nahradiť: ['<'] za: ['&lt;'],
		nahradiť: ['>'] za: ['&gt;'],
		nahradiť: ['''] za: ['&apos;'],
		nahradiť: ['"'] za: ['&quot;']
	).
}.

>> použitá-pamäť1 := 0.
>> použitá-pamäť2 := 0.
>> použitá-pamäť3 := 0.
>> použitá-pamäť4 := 0.

Program správa-pamäte: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Výstup písať: txt kopírovať html, nový-riadok.
Výstup písať: txt kopírovať malé-písmená, nový-riadok.
Výstup písať: txt kopírovať veľké-písmená, nový-riadok.
} spustiť.

Program upratať.

použitá-pamäť1 := (Program pamäť ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Výstup písať: txt kopírovať html, nový-riadok.
Výstup písať: txt kopírovať malé-písmená, nový-riadok.
Výstup písať: txt kopírovať veľké-písmená, nový-riadok.
} spustiť.

Program upratať.
použitá-pamäť2 := (Program pamäť ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Výstup písať: txt kopírovať html, nový-riadok.
Výstup písať: txt kopírovať malé-písmená, nový-riadok.
Výstup písať: txt kopírovať veľké-písmená, nový-riadok.
} spustiť.

Program upratať.
použitá-pamäť3 := (Program pamäť ? 0).



( použitá-pamäť1 = použitá-pamäť2 a: použitá-pamäť1 = použitá-pamäť3, a: použitá-pamäť2 = použitá-pamäť3 ) pravda: {
	Výstup písať: ['Žiadne úniky pamäte'].
}, nepravda: {
	Výstup písať: ['Uniká pamäť...'].
}.
