Text pri: ['html'] urobiť: { <- (
		seba
		nahradiť: ['&'] za: ['&amp;'],
		nahradiť: ['<'] za: ['&lt;'],
		nahradiť: ['>'] za: ['&gt;'],
		nahradiť: ['''] za: ['&apos;'],
		nahradiť: ['"'] za: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program správa-pamäte: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Výstup písať: txt kopírovať html, nový-riadok.
Výstup písať: txt kopírovať malé-písmená, nový-riadok.
Výstup písať: txt kopírovať veľké-písmená, nový-riadok.
} spustiť.

Program upratať.

usedMemory1 := (Program pamäť ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Výstup písať: txt kopírovať html, nový-riadok.
Výstup písať: txt kopírovať malé-písmená, nový-riadok.
Výstup písať: txt kopírovať veľké-písmená, nový-riadok.
} spustiť.

Program upratať.
usedMemory2 := (Program pamäť ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Výstup písať: txt kopírovať html, nový-riadok.
Výstup písať: txt kopírovať malé-písmená, nový-riadok.
Výstup písať: txt kopírovať veľké-písmená, nový-riadok.
} spustiť.

Program upratať.
usedMemory3 := (Program pamäť ? 0).



( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) pravda: {
	Výstup písať: ['No memory leaks here'].
}, nepravda: {
	Výstup písať: ['Leaking memory...'].
}.
