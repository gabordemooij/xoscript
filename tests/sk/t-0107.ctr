
Výstup písať: ['Break for-loop, 0-4.'], nový-riadok.
{ :i
	Výstup písať: ['iteration #'] + i, nový-riadok.
	(i = 4) prerušiť.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Výstup písať: ['Break while-true loop, 0-4.'], nový-riadok.
{
	Výstup písať: ['iteration #'] + x, nový-riadok.
	x pridať: 1.
	((x < 5) nie) prerušiť.
} kým: xIsLessThan10.

Výstup písať: ['Break while-false loop, 5,4.'], nový-riadok.
{
	Výstup písať: ['iteration #'] + x, nový-riadok.
	x odčítať: 1.
	(x = 3) prerušiť.
} kým: { <- (x > 0). }.

Výstup písať: ['Break times loop, 1-4.'], nový-riadok.
{ :i
	Výstup písať: ['iteration #'] + i, nový-riadok.
	(i = 4) prerušiť.
} × 5.

Výstup písať: ['Break block, dont print line.'], nový-riadok.
{ Pravda prerušiť. Výstup písať: ['dont write this!'], nový-riadok. } spustiť.

Výstup písať: ['Break block, dont fire catch...'], nový-riadok.
{ Pravda prerušiť. Výstup písať: ['dont write this!'], nový-riadok. } zachytiť: { Výstup písať: ['Dont catch this!']. }, spustiť.

Výstup písať: ['Test Array each-loop: 0,1'], nový-riadok.
(Zoznam ← 1 ; 2 ; 3) zobraziť: { :i
	Výstup písať: ['iteration #'] + i, nový-riadok.
	(i = 1) prerušiť.
}.

Výstup písať: ['Test Map each-loop: c only'], nový-riadok.
>> m := Slovník nový.
m umiestniť: ['first'] na: ['a'], umiestniť: ['second'] na: ['b'], umiestniť: ['third'] na: ['c'].
m každý: { :k :v
	Výstup písať: ['iteration'] + v + k, nový-riadok.
	Pravda prerušiť.
}.

