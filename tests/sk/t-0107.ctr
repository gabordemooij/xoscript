
Výstup písať: ['Prerušenie slučky for, 0-4.'], nový-riadok.
{ :i
	Výstup písať: ['iteration #'] + i, nový-riadok.
	(i = 4) prerušiť.
} × 10.

>> x := 0.
>> x-je-menšie-ako-10 := { <- ( x < 10 ). }.

Výstup písať: ['Prerušenie slučky while-true, 0-4.'], nový-riadok.
{
	Výstup písať: ['iteration #'] + x, nový-riadok.
	x pridať: 1.
	((x < 5) nie) prerušiť.
} kým: x-je-menšie-ako-10.

Výstup písať: ['Prerušenie slučky while-false, 5,4.'], nový-riadok.
{
	Výstup písať: ['iteration #'] + x, nový-riadok.
	x odčítať: 1.
	(x = 3) prerušiť.
} kým: { <- (x > 0). }.

Výstup písať: ['Prerušenie slučky times, 1-4.'], nový-riadok.
{ :i
	Výstup písať: ['iteration #'] + i, nový-riadok.
	(i = 4) prerušiť.
} × 5.

Výstup písať: ['Prerušenie bloku, riadok netlač.'], nový-riadok.
{ Pravda prerušiť. Výstup písať: ['toto nepíš!'], nový-riadok. } spustiť.

Výstup písať: ['Prerušenie bloku, nespúšťaj catch...'], nový-riadok.
{ Pravda prerušiť. Výstup písať: ['toto nepíš!'], nový-riadok. } zachytiť: { Výstup písať: ['Toto nechytaj!']. }, spustiť.

Výstup písať: ['Test slučky each poľa: 0,1'], nový-riadok.
(Zoznam ← 1 ; 2 ; 3) zobraziť: { :i
	Výstup písať: ['iteration #'] + i, nový-riadok.
	(i = 1) prerušiť.
}.

Výstup písať: ['Test slučky each mapy: iba c'], nový-riadok.
>> m := Slovník nový.
m umiestniť: ['first'] na: ['a'], umiestniť: ['second'] na: ['b'], umiestniť: ['tretí'] na: ['c'].
m každý: { :k :v
	Výstup písať: ['iteration'] + v + k, nový-riadok.
	Pravda prerušiť.
}.

