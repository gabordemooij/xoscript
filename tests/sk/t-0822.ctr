# menej parametrov ako zástupných znakov musí dať chybu, nie čítať za väzbami
Server init.

>> db := Maria-DB nový hostiteľ: ['localhost'],
	používateľ: ['xo'],
	heslo: ['pass123'],
	názov-databázy: ['xobase'],
	pripojiť-sa.

>> parametre-hľadania := db dopyt: ['SELECT ? AS a, ? AS b, ? AS c'].
parametre-hľadania parametre: (Zoznam nový ; ['1']).
{ parametre-hľadania načítať: { :rad Výstup písať: rad, nový-riadok. }. } zachytiť: { :e Výstup písať: e, nový-riadok. }, spustiť.

>> parametre-hľadania := db dopyt: ['SELECT ? AS a'].
{ parametre-hľadania načítať: { :rad Výstup písať: rad, nový-riadok. }. } zachytiť: { :e Výstup písať: e, nový-riadok. }, spustiť.

# správny počet stále funguje, ďalšie parametre sa ignorujú ako predtým
>> parametre-hľadania := db dopyt: ['SELECT ? AS a, ? AS b'].
parametre-hľadania parametre: (Zoznam nový ; ['1'] ; ['2']).
parametre-hľadania načítať: { :rad Výstup písať: (rad na: ['a']), písať: (rad na: ['b']), nový-riadok. }.
parametre-hľadania parametre: (Zoznam nový ; ['1'] ; ['2'] ; ['3']).
parametre-hľadania načítať: { :rad Výstup písať: (rad na: ['a']), písať: (rad na: ['b']), nový-riadok. }.
