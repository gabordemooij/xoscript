Server init.

>> db := Maria-DB nový hostiteľ: ['localhost'],
	používateľ: ['xo'],
	heslo: ['pass123'],
	názov-databázy: ['xobase'],
	pripojiť-sa.

>> zmaž := db dopyt: ['DELETE FROM book WHERE id > 0'].
{  zmaž vykonať. db potvrdiť. } zachytiť: { :e db vrátiť-späť.  }, spustiť.

>> počet := db dopyt: ['SELECT COUNT(*) AS num FROM book'].
počet načítať: { :rad Výstup písať: rad num, nový-riadok. }.
