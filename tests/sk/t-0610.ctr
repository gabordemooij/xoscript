
>> Obdĺžnik := Objekt nový.

Obdĺžnik pri: ['rozloha'] urobiť: {
	<- vlastný dĺžka * vlastný šírka.
}.

Obdĺžnik pri: ['length:'] urobiť: { :dĺžka
	vlastný dĺžka := dĺžka.
}.

Obdĺžnik pri: ['width:'] urobiť: { :šírka
	vlastný šírka := šírka.
}.

Obdĺžnik pri: ['nový'] urobiť: {
	# to nespôsobí nekonečný cyklus
	>> obdĺžnik := seba nový.
	obdĺžnik length: 0, width: 0.
	<- obdĺžnik.
}.

>> a := Obdĺžnik nový.
Výstup písať: a rozloha, nový-riadok. #0

>> b := Obdĺžnik nový length: 2, width: 3.
Výstup písať: b rozloha, nový-riadok. #6

