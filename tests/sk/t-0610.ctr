
>> Rectangle := Objekt nový.

Rectangle pri: ['area'] urobiť: { <- vlastný dĺžka * vlastný width.
}.

Rectangle pri: ['length:'] urobiť: { :dĺžka
	vlastný dĺžka := dĺžka.
}.

Rectangle pri: ['width:'] urobiť: { :width
	vlastný width := width.
}.

Rectangle pri: ['nový'] urobiť: {
	# this will not result into an infinite loop
	>> rectangle := seba nový.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle nový.
Výstup písať: a area, nový-riadok. #0

>> b := Rectangle nový length: 2, width: 3.
Výstup písať: b area, nový-riadok. #6

