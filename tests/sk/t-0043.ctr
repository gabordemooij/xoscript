>> opakovač := Objekt nový.
opakovač pri: ['odpovedať:'] urobiť: { :čo
	Výstup písať: čo + [' '].
}.
opakovač pri: ['odpovedať:a:'] urobiť: { :čo :say
	Výstup písať: čo, písať: say + [' '].
}.
opakovač pri: ['odpovedať:a:a:'] urobiť: { :čo :say :viac
	Výstup písať: čo, písať: say, písať: viac.
}.
opakovač opakovať.
opakovač everything: ['Hovorím.'].
opakovač and: ['I '] everything: ['robím.'].
