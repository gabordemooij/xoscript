Server init.

Výstup písať: (
	Vzor nový: ['^\\w+$'],
	zhoda: ['test@example.com'] 
), nový-riadok. # 0 zhôd, zlyhá na @ a .

Výstup písať: (
	Vzor nový: ['^[^@]+@[^\.]+\.\\w+$'],
	zhoda: ['test@example.com'] 
), nový-riadok. # 1 zhoda

Výstup písať: (
	Vzor nový: ['[^@]+@[^\.]+\.\\w+'],
	zhoda: ['test@example.com'] 
), nový-riadok. # 1 zhoda

Výstup písať: (
	Vzor nový: ['([^@]+)@([^\.]+)\.\\w+'],
	zhoda: ['test@example.com'] 
), nový-riadok. # 1 zhoda, na skupinách nezáleží

Výstup písať: (
	Vzor nový: ['[a-z]'],
	zhoda: ['test@example.com'] 
), nový-riadok. # 14 zhôd

Výstup písať: (
	Vzor nový: ['.*'],
	zhoda: ['test@example.com'] 
), nový-riadok. # 1 zhoda (všetko)

Výstup písať: (
	Vzor nový: ['(.*)'],
	zhoda: ['test@example.com'] 
), nový-riadok. # 1 zhoda (všetko)

Výstup písať: (
	Vzor nový: ['\\s*[^@]+@[^\.]+\.\\w+'],
	zhoda: ['test@example.com'] 
), nový-riadok. # 1 zhoda, medzera na začiatku je voliteľná, ignoruje sa