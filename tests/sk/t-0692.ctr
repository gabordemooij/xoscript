Server init.

Výstup písať: (
	Vzor nový: ['^\\w+$'],
	zhoda: ['test@example.com'] 
), nový-riadok. # 0 match, fails on @ and .

Výstup písať: (
	Vzor nový: ['^[^@]+@[^\.]+\.\\w+$'],
	zhoda: ['test@example.com'] 
), nový-riadok. # 1 match

Výstup písať: (
	Vzor nový: ['[^@]+@[^\.]+\.\\w+'],
	zhoda: ['test@example.com'] 
), nový-riadok. # 1 match

Výstup písať: (
	Vzor nový: ['([^@]+)@([^\.]+)\.\\w+'],
	zhoda: ['test@example.com'] 
), nový-riadok. # 1 match, groups dont matter

Výstup písať: (
	Vzor nový: ['[a-z]'],
	zhoda: ['test@example.com'] 
), nový-riadok. # 14 matches

Výstup písať: (
	Vzor nový: ['.*'],
	zhoda: ['test@example.com'] 
), nový-riadok. # 1 match (all)

Výstup písať: (
	Vzor nový: ['(.*)'],
	zhoda: ['test@example.com'] 
), nový-riadok. # 1 match (all)

Výstup písať: (
	Vzor nový: ['\\s*[^@]+@[^\.]+\.\\w+'],
	zhoda: ['test@example.com'] 
), nový-riadok. # 1 match, prefix space optional, gets ignored