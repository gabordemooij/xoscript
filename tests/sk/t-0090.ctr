Výstup písať: ['1,2,3,4,5,6,7,8,9,A,'], nový-riadok.
>> Rozsah := Objekt nový.
Rozsah pri: ['initialize:'] urobiť: { :x vlastný vlastnosť := x. }.
Rozsah pri: ['schváliť'] urobiť: { Výstup písať: [',']. }.
Rozsah pri: ['test'] urobiť: {
	Výstup písať: vlastný vlastnosť.
	seba schváliť.
	( 1 = 1 ) pravda: { Výstup písať: vlastný vlastnosť. seba schváliť. }.
	( 1 = 0 ) nepravda: { Výstup písať: vlastný vlastnosť. seba schváliť. }.
	>> y := 2. { Výstup písať: vlastný vlastnosť. seba schváliť. } kým: { y odčítať: 1. <- (y > 0). }.
	{ Výstup písať: vlastný vlastnosť. seba schváliť. } × 1.
	(Zoznam ← 1) každý: {  Výstup písať: vlastný vlastnosť. seba schváliť. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Slovník nový one: ['item']) každý: { Výstup písať: vlastný vlastnosť. seba schváliť. }.
	{ 1 ÷ 0. } zachytiť: { Výstup písať: vlastný vlastnosť. seba schváliť. }, spustiť.
	Výstup nový-riadok.
}.
>> rozsah1 := Rozsah nový.
rozsah1 initialize: ['X'].
rozsah1 test.
>> podprogram := { 
	vlastný vlastnosť := ['Y'].
	Výstup písať: vlastný vlastnosť.
	seba schváliť.
	( 1 = 1 ) pravda: { Výstup písať: vlastný vlastnosť. seba schváliť. }.
	( 1 = 0 ) nepravda: { Výstup písať: vlastný vlastnosť. seba schváliť. }.
	>> y := 2. { Výstup písať: vlastný vlastnosť. seba schváliť. } kým: { y odčítať: 1. <- (y > 0). }.
	{ Výstup písať: vlastný vlastnosť. seba schváliť. } × 1.
	(Zoznam ← 1) každý: {  Výstup písať: vlastný vlastnosť. seba schváliť. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Slovník nový one: ['item']) každý: { Výstup písať: vlastný vlastnosť. seba schváliť. }.
	{ 1 ÷ 0. } zachytiť: { Výstup písať: vlastný vlastnosť. seba schváliť. }, spustiť.
	Výstup nový-riadok.
}.
podprogram pri: ['schváliť'] urobiť: { Výstup písať: [',']. }.
podprogram aplikovať: 1 a: 2.
