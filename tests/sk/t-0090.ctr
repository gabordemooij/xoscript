>> Scope := Objekt nový.
Scope pri: ['initialize:'] urobiť: { :x vlastný property := x. }.
Scope pri: ['confirm'] urobiť: { Výstup písať: [',']. }.
Scope pri: ['test'] urobiť: {
	Výstup písať: vlastný property.
	seba confirm.
	( 1 = 1 ) pravda: { Výstup písať: vlastný property. seba confirm. }.
	( 1 = 0 ) nepravda: { Výstup písať: vlastný property. seba confirm. }.
	>> y := 2. { Výstup písať: vlastný property. seba confirm. } kým: { y odčítať: 1. <- (y > 0). }.
	{ Výstup písať: vlastný property. seba confirm. } × 1.
	(Zoznam ← 1) každý: {  Výstup písať: vlastný property. seba confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Slovník nový one: ['item']) každý: { Výstup písať: vlastný property. seba confirm. }.
	{ 1 ÷ 0. } zachytiť: { Výstup písať: vlastný property. seba confirm. }, spustiť.
	Výstup nový-riadok.
}.
>> scope1 := Scope nový.
scope1 initialize: ['X'].
scope1 test.
