Výstup písať: ['Test object'], nový-riadok.
>> a := Objekt nový. 

a pri: ['item:'] urobiť: { :octhelper
	vlastný octhelper := octhelper. 
}.

a pri: ['item'] urobiť: { <- vlastný octhelper.
}.

a item: Oct nový.

>> old-octhelper-address := a item prototyp adresa-pamäte.
a save-as: ['/tmp/a.bin'].
Výstup písať: ['========== RELOADING SNAP:'], nový-riadok.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp adresa-pamäte = old-octhelper-address) pravda: {
	Výstup písať: ['Object link re-attached.'], nový-riadok.
}.
