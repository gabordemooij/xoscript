Výstup písať: ['Testovací objekt'], nový-riadok.
>> a := Objekt nový. 

a pri: ['item:'] urobiť: { :oct-pomocník
	vlastný oct-pomocník := oct-pomocník. 
}.

a pri: ['položka'] urobiť: {
	<- vlastný oct-pomocník.
}.

a item: Oct nový.

>> stará-adresa-oct-pomocníka := a položka prototyp adresa-pamäte.
a save-as: ['/tmp/a.bin'].
Výstup písať: ['========== OPÄTOVNÉ NAČÍTANIE SNÍMKY:'], nový-riadok.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b položka prototyp adresa-pamäte = stará-adresa-oct-pomocníka) pravda: {
	Výstup písať: ['Odkaz na objekt znovu pripojený.'], nový-riadok.
}.
