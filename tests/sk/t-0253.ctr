#Linux
>> OS := Program nastavenie: ['OS'].

>> clock := Okamih nový.
	
(OS = ['Haiku']) pravda: {
	clock pásmo: ['CET'],
	rok: 2017, mesiac: 7, deň: 13,
	hodina: 18, minúta: 0, sekunda: 0.
}, inak: {
	clock pásmo: ['Europe/Amsterdam'],
	rok: 2017, mesiac: 7, deň: 13,
	hodina: 18, minúta: 0, sekunda: 0.
}.

clock pri: ['tell'] urobiť: {
	Výstup písať: seba, nový-riadok.
}.


clock pridať: 2    hodina, tell.
clock pridať: 1    hodina, tell.
clock pridať: 19 minúta, tell.
clock pridať: 1  minúta, tell.
clock pridať: 1  minúta, tell.
clock pridať: 19 sekunda, tell.
clock pridať: 1  sekunda, tell.
clock pridať: 1  sekunda, tell.
clock pridať: 2    rok, tell.
clock pridať: 1    rok, tell.

(OS = ['Haiku']) pravda: {
clock pridať: 5   mesiac.
clock pásmo: ['CEST'], tell.
}, inak: {
	clock pridať: 5   mesiac, tell.
}.

clock pridať: 1   mesiac, tell.
clock pridať: 19    deň, tell.
clock pridať: 1    hodina, tell.
clock pridať: 120  yard, tell.
