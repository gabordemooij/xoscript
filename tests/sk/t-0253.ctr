#Linux
>> OS := Program nastavenie: ['OS'].

>> hodiny := Okamih nový.
	
(OS = ['Haiku']) pravda: {
	hodiny pásmo: ['CET'],
	rok: 2017, mesiac: 7, deň: 13,
	hodina: 18, minúta: 0, sekunda: 0.
}, inak: {
	hodiny pásmo: ['Europe/Amsterdam'],
	rok: 2017, mesiac: 7, deň: 13,
	hodina: 18, minúta: 0, sekunda: 0.
}.

hodiny pri: ['oznámiť'] urobiť: {
	Výstup písať: seba, nový-riadok.
}.


hodiny pridať: 2    hodina, oznámiť.
hodiny pridať: 1    hodina, oznámiť.
hodiny pridať: 19 minúta, oznámiť.
hodiny pridať: 1  minúta, oznámiť.
hodiny pridať: 1  minúta, oznámiť.
hodiny pridať: 19 sekunda, oznámiť.
hodiny pridať: 1  sekunda, oznámiť.
hodiny pridať: 1  sekunda, oznámiť.
hodiny pridať: 2    rok, oznámiť.
hodiny pridať: 1    rok, oznámiť.

(OS = ['Haiku']) pravda: {
hodiny pridať: 5   mesiac.
hodiny pásmo: ['CEST'], oznámiť.
}, inak: {
	hodiny pridať: 5   mesiac, oznámiť.
}.

hodiny pridať: 1   mesiac, oznámiť.
hodiny pridať: 19    deň, oznámiť.
hodiny pridať: 1    hodina, oznámiť.
hodiny pridať: 120  yard, oznámiť.
