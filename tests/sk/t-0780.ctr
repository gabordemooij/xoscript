Server init.

# kodér JSON podporuje iba UTF-8, žiadne náhradné páry (surrogate pairs)

>> slovníky := Zoznam nový ;
	# {"key":"normal"} bežné ASCII
	( Slovník nový umiestniť: ['normálne'] na: ['key'] ) ;
	# {"key":"hello world"} znak medzery
	( Slovník nový umiestniť: ['hello world'] na: ['key'] ) ;
	# {"key":"quote: \""} dvojitá úvodzovka
	( Slovník nový umiestniť: ['"'] na: ['key'] ) ;
	# {"key":"backslash: \\"} spätná lomka
	( Slovník nový umiestniť: ['backslash: \\'] na: ['key'] ) ;
	# {"key":"slash: /"} lomka
	( Slovník nový umiestniť: ['lomka: /'] na: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( Slovník nový umiestniť: ['backspace: \b'] na: ['key'] ) ;
	# {"key":"formfeed: \f"} escape posunu strany (form-feed)
	( Slovník nový umiestniť: ['formfeed: \f'] na: ['key'] ) ;
	# {"key":"newline: \n"} nový riadok
	( Slovník nový umiestniť: ['newline: \n'] na: ['key'] ) ;
	( Slovník nový umiestniť: ['newline: ↵'] na: ['key'] ) ;
	( Slovník nový umiestniť: ['newline: 
	'] na: ['key'] ) ;
	# {"key":"carriage return: \r"} návrat vozíka
	( Slovník nový umiestniť: ['carriage return: \r'] na: ['key'] ) ;
	# {"key":"tab: \t"} tabulátor
	( Slovník nový umiestniť: ['tab \t'] na: ['key'] ) ;
	( Slovník nový umiestniť: ['tab ⇿'] na: ['key'] ) ;
	( Slovník nový umiestniť: ['tabulátor  '] na: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( Slovník nový umiestniť: ['NUL \u0000'] na: ['key'] ) ;
	( Slovník nový umiestniť: ['NUL \0'] na: ['key'] ) ;
	# {"key":"control: \u0001"} riadiaci znak 0x01
	( Slovník nový umiestniť: ['control: \u0001'] na: ['key'] ) ;
	# {"key":"control: \u001F"} riadiaci znak 0x1F
	( Slovník nový umiestniť: ['control: \u001F'] na: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-bajtový znak
	( Slovník nový umiestniť: ['unicode: é'] na: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-bajtový znak
	( Slovník nový umiestniť: ['unicode: €'] na: ['key'] ) ;
	# {"key":"unicode: 日本語"} viac 3-bajtových znakov UTF-8
	( Slovník nový umiestniť: ['unicode: 日本語'] na: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-bajtový znak
	( Slovník nový umiestniť: ['unicode: 😀'] na: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + spojovač nulovej šírky
	( Slovník nový umiestniť: ['unicode: 🧑‍💻'] na: ['key'] ) ;
	# {"key":"combining: é"} kombinovaný diakritický znak
	( Slovník nový umiestniť: ['combining: e\u0301'] na: ['key'] ) ;
	# {"key":"escaped unicode: é"} escape Unicode BMP
	( Slovník nový umiestniť: ['escaped unicode: \u00e9'] na: ['key'] ) ;
	# {"key":"escaped unicode: €"} escape Unicode BMP
	( Slovník nový umiestniť: ['escaped unicode: \u20ac'] na: ['key'] ) ;
	# {"key":"escaped unicode: 😀"} náhradný pár UTF-16
	( Slovník nový umiestniť: ['escaped unicode: \ud83d\ude00'] na: ['key'] ) ;
	# {"key":""} prázdna hodnota
	( Slovník nový umiestniť: [''] na: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} špeciálne znaky ASCII
	( Slovník nový umiestniť: ['@ < > & = % + ? #'] na: ['key'] ) ;
	# {"key":"single quote: '"} jednoduchá úvodzovka
	( Slovník nový umiestniť: ['''] na: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} viacero escape sekvencií JSON
	( Slovník nový umiestniť: ['multiple: \" \\ \n \r \t'] na: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} dlhší ASCII reťazec
	( Slovník nový umiestniť: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] na: ['key'] ) ;
	# {"key":" value"} medzera na začiatku
	( Slovník nový umiestniť: [' hodnota'] na: ['key'] ) ;
	# {"key":"value "} medzera na konci
	( Slovník nový umiestniť: ['hodnota '] na: ['key'] ) ;
	# {"key":" \t\n\r "} biele znaky
	( Slovník nový umiestniť: [' \t\n\r '] na: ['key'] )
	.

slovníky každý: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (Slovník nový umiestniť: d key na: ['key']).
	>> b := JSON jsonify: (Slovník nový umiestniť: ['value'] na: d key).
	>> e := JSON objekt: a.
	>> f := JSON objekt: b.
	((e key = d key a: (f ? d key = ['value'])) alebo: (e key = ['NUL ?'])) pravda: {
		Výstup písať: ['OK'], nový-riadok.
	}, inak: {
		Výstup písať: ['Nedá sa správne kódovať/dekódovať: '] + d + j, nový-riadok.
		Program koniec.
	}.
}.
