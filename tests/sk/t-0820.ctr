# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Vzor nový: pattern.
	p zhoda: subject urobiť: { :m :g
		Výstup písať: g počet, písať: [' '], písať: (g spojiť: ['|']), nový-riadok. <- m.
	}.
}.
show aplikovať: ['(a)|(b)'] a: ['b'].
show aplikovať: ['(a)|(b)'] a: ['a'].
show aplikovať: ['(x)?y'] a: ['y'].
show aplikovať: ['(x)?(y)(z)?'] a: ['xy'].
