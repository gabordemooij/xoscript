# skupina, ktorá nie je súčasťou zhody, nesmie spôsobiť pád a musí zachovať čísla skupín
Server init.
>> ukázať := { :vzorka :subject
	>> p := Vzor nový: vzorka.
	p zhoda: subject urobiť: { :m :g
		Výstup písať: g počet, písať: [' '], písať: (g spojiť: ['|']), nový-riadok.
		<- m.
	}.
}.
ukázať aplikovať: ['(a)|(b)'] a: ['b'].
ukázať aplikovať: ['(a)|(b)'] a: ['a'].
ukázať aplikovať: ['(x)?y'] a: ['y'].
ukázať aplikovať: ['(x)?(y)(z)?'] a: ['xy'].
