>> randomizer := { :a :b
	>> minimum := ( a < b ) buď: a alebo: b.
	>> maximum := ( a > b ) buď: a alebo: b.
	>> x := Nič.
	{
		x := Číslo medzi: a a: b.
		((x < minimum) alebo: (x > maximum)) pravda: { 
			Výstup písať: (['Invalid value!']).
			Program koniec.
		}.
	} 
	× 100. <- x.
}.
randomizer aplikovať: 0 a: 0.
randomizer aplikovať: 1 a: 0.
