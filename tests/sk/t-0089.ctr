>> generátor-náhody := { :a :b
	>> minimum := ( a < b ) buď: a alebo: b.
	>> maximum := ( a > b ) buď: a alebo: b.
	>> x := Nič.
	{
		x := Číslo medzi: a a: b.
		((x < minimum) alebo: (x > maximum)) pravda: { 
			Výstup písať: (['Neplatná hodnota!']).
			Program koniec.
		}.
	} 
	× 100. <- x.
}.
generátor-náhody aplikovať: 0 a: 0.
generátor-náhody aplikovať: 1 a: 0.
generátor-náhody aplikovať: 1 a: 1.
generátor-náhody aplikovať: 0 a: 1.
generátor-náhody aplikovať: -1 a: 0.
