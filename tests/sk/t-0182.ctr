

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program správa-pamäte: 0.

>> txt := ['1.6'].
>> n := txt číslo.
>> t := txt logický.
Výstup písať: n, nový-riadok.
Výstup písať: t, nový-riadok.
Výstup písať: n typ, nový-riadok.
Výstup písať: t typ, nový-riadok.

Program upratať.

usedMemory1 := (Program pamäť ? 0).


txt := ['1.6'].
n := txt číslo.
t := txt logický.
Výstup písať: n, nový-riadok.
Výstup písať: t, nový-riadok.
Výstup písať: n typ, nový-riadok.
Výstup písať: t typ, nový-riadok.

Program upratať.
usedMemory2 := (Program pamäť ? 0).


txt := ['1.6'].
n := txt číslo.
t := txt logický.
Výstup písať: n, nový-riadok.
Výstup písať: t, nový-riadok.
