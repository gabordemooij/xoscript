Výstup písať: ['Test object'], nový-riadok.
>> greeter := Objekt nový.
greeter pri: ['name:'] urobiť: { :názov
	vlastný xname := názov. 
}.
greeter pri: ['greet'] urobiť: {
	Výstup písať: ['Hello '] + vlastný xname, nový-riadok.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Výstup písať: ['========== RELOADING SNAP:'], nový-riadok.
>> b := Objekt load-from: ['/tmp/a.bin'].
>> c := Objekt load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
