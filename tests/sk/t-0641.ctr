# Test čistenia utf8
Server init.

>> utf8-prípady := Slovník nový
	# iba ASCII
	umiestniť: ( Zoznam nový ; 65 ; 65 ; 65 ; 65 ; 0 ) na: ['AAAA'],
	# platná 2-bajtová sekvencia
	umiestniť: ( Zoznam nový ; 194 ; 162 ; 0 ) na: ['¢'],
	# Platné 3-bajtové UTF-8
    umiestniť: ( Zoznam nový ; 226 ; 130 ; 172 ; 0 ) na: ['€'],
	# Platné 4-bajtové UTF-8
    umiestniť: ( Zoznam nový ; 240 ; 144 ; 141 ; 136 ; 0 ) na: ['𐍈'],
	# Neplatný pokračovací bajt v sekvencii E2 28 AC -> začiatok 3b sekv. + 28 chybný pokr. + AC pokr. bajt, ale patrí k tej istej chybe
    umiestniť: ( Zoznam nový ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) na: ['A?A'],
	# Príliš dlhé kódovanie ASCII 'A' (má sa zmeniť na ?),
    umiestniť: ( Zoznam nový ; 65 ; 193 ; 129 ; 0 ) na: ['A?'],
	# Neplatný prvý bajt (0xFF)
    umiestniť: ( Zoznam nový ; 255 ; 0 ) na: ['?'],
	# Neúplná viacbajtová sekvencia na konci
    umiestniť: ( Zoznam nový ; 66 ; 226 ; 0 ) na: ['B?'],
    # Prázdny text
    #put: ( List new ) at: [''],
	# Viacero zmiešaných sekvencií
    umiestniť: ( Zoznam nový ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) na: ['A€?𐍈B'].
	 
utf8-prípady každý: { :key :value
	>> blob := Blob nový: value počet, bytes: value.
	>> str := blob text.
	(str = key) pravda: {
		Výstup písať: ['OK'], nový-riadok.
	}, inak: {
		Výstup písať: ['Sanitizér UTF8 zlyhal na: '] + key + [' výsledok: '] + str, nový-riadok.
	}.
	blob uvoľniť.
}.
