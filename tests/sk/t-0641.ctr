# Test utf8 sanitizer
Server init.

>> utf8cases := Slovník nový
	# ASCII only
	umiestniť: ( Zoznam nový ; 65 ; 65 ; 65 ; 65 ; 0 ) na: ['AAAA'],
	# valid 2 byte sequence
	umiestniť: ( Zoznam nový ; 194 ; 162 ; 0 ) na: ['¢'],
	# Valid 3-byte UTF-8
    umiestniť: ( Zoznam nový ; 226 ; 130 ; 172 ; 0 ) na: ['€'],
	# Valid 4-byte UTF-8
    umiestniť: ( Zoznam nový ; 240 ; 144 ; 141 ; 136 ; 0 ) na: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    umiestniť: ( Zoznam nový ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) na: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    umiestniť: ( Zoznam nový ; 65 ; 193 ; 129 ; 0 ) na: ['A?'],
	# Invalid first byte (0xFF)
    umiestniť: ( Zoznam nový ; 255 ; 0 ) na: ['?'],
	# Incomplete multi-byte sequence at end
    umiestniť: ( Zoznam nový ; 66 ; 226 ; 0 ) na: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    umiestniť: ( Zoznam nový ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) na: ['A€?𐍈B'].
	 
utf8cases každý: { :key :value
	>> blob := Blob nový: value počet, bytes: value.
	>> str := blob text.
	(str = key) pravda: {
		Výstup písať: ['OK'], nový-riadok.
	}, inak: {
		Výstup písať: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, nový-riadok.
	}.
	blob uvoľniť.
}.
