>> Point := Objekt nový.
Point pri: ['x-coordinate:'] urobiť: { :x vlastný x := x. }.
Point pri: ['y-coordinate:'] urobiť: { :y vlastný y := y. }.
Point pri: ['x-coordinate']  urobiť: { <- vlastný x kopírovať. }.
Point pri: ['y-coordinate']  urobiť: { <- vlastný y kopírovať. }.

Point pri: ['='] urobiť: { :other <- ( vlastný x = other x-coordinate
		 a: vlastný y = other y-coordinate ).
}.

>> pier := Point nový x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point nový x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point nový x-coordinate: 5, y-coordinate: 6.

Výstup písať: pier = town-hall, nový-riadok.
Výstup písať: pier = restaurant, nový-riadok.
