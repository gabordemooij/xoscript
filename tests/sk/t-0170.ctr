

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program správa-pamäte: 0.

>> a := Zoznam nový.
>> b := Zoznam ← 1 ; 2.

Program upratať.
usedMemory1 := (Program pamäť ? 0).


a := Zoznam nový.
b := Zoznam ← 1 ; 2.

Program upratať.
usedMemory2 := (Program pamäť ? 0).


a := Zoznam nový.
b := Zoznam ← 1 ; 2.

Program upratať.
usedMemory3 := (Program pamäť ? 0).



( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) pravda: {
	Výstup písať: ['No memory leaks here'].
}, nepravda: {
	Výstup písať: ['Leaking memory...'].
}.
