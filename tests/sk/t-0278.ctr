>> To-Do := Objekt nový.

To-Do pri: ['nový'] urobiť: {
	vlastný list := Zoznam nový.
}.

To-Do pri: ['nieuw'] urobiť: {
	vlastný list := Zoznam nový.
}.

To-Do pri: ['+'] urobiť: { :task
	vlastný list pripojiť: task.
}.

To-Do pri: ['number of tasks?'] urobiť: { <-  vlastný list počet.
}.

>> todos := 
	To-Do nový 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Výstup písať: ['You have $ tasks to do'] $ todos number of tasks?.
