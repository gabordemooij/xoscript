>> Úlohovník := Objekt nový.

Úlohovník pri: ['nový'] urobiť: {
	vlastný list := Zoznam nový.
}.

Úlohovník pri: ['nieuw'] urobiť: {
	vlastný list := Zoznam nový.
}.

Úlohovník pri: ['+'] urobiť: { :úloha
	vlastný list pripojiť: úloha.
}.

Úlohovník pri: ['number of tasks?'] urobiť: { <-  vlastný list počet.
}.

>> úlohy := 
	Úlohovník nový 
	+ ['uvariť večeru'] 
	+ ['upratať izbu'].
	
Výstup písať: ['You have $ tasks to do'] $ úlohy number of tasks?.
