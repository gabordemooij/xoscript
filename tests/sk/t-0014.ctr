>> Pozdravovač := Objekt nový.
Pozdravovač pri: ['vyrobiť'] urobiť: {
	>> pz := Objekt nový.
	pz pri: ['setName:'] urobiť: { :meno
		vlastný názov := meno.
	}.
	pz pri: ['pozdraviť'] urobiť: {
		Výstup písať: vlastný názov.
	}. <- pz.
}.
>> a := Pozdravovač vyrobiť.
>> b := Pozdravovač vyrobiť.
a setName: ['JEDEN'].
b setName: ['DVA'].
a pozdraviť.
b pozdraviť.
>> c := a nový.
c setName: ['TRI'].
c pozdraviť.
>> d := a nový.
d setName: ['ŠTYRI'].
d pozdraviť.
c pozdraviť.
