>> Greeter := Objekt nový.
Greeter pri: ['make'] urobiť: {
	>> gr := Objekt nový.
	gr pri: ['setName:'] urobiť: { :aname
		vlastný názov := aname.
	}.
	gr pri: ['greet'] urobiť: {
		Výstup písať: vlastný názov.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a nový.
c setName: ['THREE'].
c greet.
>> d := a nový.
d setName: ['FOUR'].
d greet.
c greet.
