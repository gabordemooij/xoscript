>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objekt nový.
⚄ pri: ['drawFrom:length:'] urobiť: { :pool :počet
	
	>> result := [''].
	
	{
		>> index := Číslo random % (pool dĺžka).
		result pripojiť: ( pool znak: (index + 1) ).
		
	} × počet. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? dĺžka.
Výstup písať: (['x↵'] x random dĺžka).
Výstup písať: (['y↵'] y ?? dĺžka).

