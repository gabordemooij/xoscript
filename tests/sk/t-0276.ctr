>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objekt nový.
⚄ pri: ['vytiahnuť-z:dĺžka:'] urobiť: { :zásoba :počet
	
	>> výsledok := [''].
	
	{
		>> index := Číslo náhodný % (zásoba dĺžka).
		výsledok pripojiť: ( zásoba znak: (index + 1) ).
		
	} × počet. <- výsledok.
}.

>> náhodný := ⚄ vytiahnuť-z: ?? dĺžka: ?? dĺžka.
Výstup písať: (['x↵'] x náhodný dĺžka).
Výstup písať: (['y↵'] y ?? dĺžka).

