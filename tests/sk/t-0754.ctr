Výstup písať: ['Test object'], nový-riadok.
>> a := Objekt nový. 

a pri: ['item:'] urobiť: { :out
	vlastný out := out. 
}.

a pri: ['item'] urobiť: { <- vlastný out.
}.

a pri: ['greet'] urobiť: {
	Výstup písať: ['hi from original out!'], nový-riadok.
}.

a item: Výstup.

Výstup písať: a item, nový-riadok.

>> old-out-address := a item prototyp adresa-pamäte.
a save-as: ['/tmp/a.bin'].
Výstup písať: ['========== RELOADING SNAP:'], nový-riadok.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp adresa-pamäte = old-out-address) pravda: {
	Výstup písať: ['Object link re-attached.'], nový-riadok.
}.

b item písať: ['hello from loaded out!'], nový-riadok.
b greet.
