# catch-all test (practical)
>> HTML := Text nový.
HTML pri: ['encode:'] urobiť: { :tekst
	seba pripojiť: (tekst
	nahradiť: ['&'] za: ['&amp;'], 
	nahradiť: ['<'] za: ['&lt;'],
	nahradiť: ['>'] za: ['&gt;'],
	nahradiť: ['"'] za: ['&quot;']).
}.
>> blog := HTML nový.
blog pripojiť: ['<h1>'],
     encode: ['Koffie & Thee'],
     pripojiť: ['</h1>'].
Výstup písať: blog, nový-riadok.


>> Roman := Číslo nový.
Roman pri: ['stringy'] urobiť: {
	>> a := [''].
	{ a pripojiť: ['I']. } × seba. <- a.
}.

>> x := Roman nový.
x pridať: 3.
Výstup písať: x stringy, nový-riadok.

>> Quantum := Logický nový.
Quantum pri: ['true?'] urobiť: { <- ['maybe True']. }.
Výstup písať: (Quantum nový true?), nový-riadok.

>> Nihil := Nič nový.
Nihil pri: ['text'] urobiť: { <- ['Nihil']. }.
Výstup písať: (Nihil nový), nový-riadok.
