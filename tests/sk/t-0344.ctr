# test zachytávania všetkého (prakticky)
>> HTML := Text nový.
HTML pri: ['encode:'] urobiť: { :tekst
	seba pripojiť: (tekst
	nahradiť: ['&'] za: ['&amp;'], 
	nahradiť: ['<'] za: ['&lt;'],
	nahradiť: ['>'] za: ['&gt;'],
	nahradiť: ['"'] za: ['&quot;']).
}.
>> blog := HTML nový.
blog pripojiť: ['<h1>'],
     encode: ['Koffie & Thee'],
     pripojiť: ['</h1>'].
Výstup písať: blog, nový-riadok.


>> Rímske := Číslo nový.
Rímske pri: ['reťazcovito'] urobiť: {
	>> a := [''].
	{ a pripojiť: ['I']. } × seba. <- a.
}.

>> x := Rímske nový.
x pridať: 3.
Výstup písať: x reťazcovito, nový-riadok.

>> Kvantum := Logický nový.
Kvantum pri: ['true?'] urobiť: { <- ['možno Pravda']. }.
Výstup písať: (Kvantum nový true?), nový-riadok.

>> Nihil := Nič nový.
Nihil pri: ['text'] urobiť: { <- ['Nihil']. }.
Výstup písať: (Nihil nový), nový-riadok.
