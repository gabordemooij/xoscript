# Tento test overuje, či string_fill_in v režime 4 nestratí svoj slot (gc'ed)
# odkaz vo world.c
>> Záznamník := Objekt nový.

Záznamník pri: ['say:'] urobiť: { :str
	Výstup písať: str, nový-riadok.
}.

>> Položka := Objekt nový.

Položka pri: ['nový:'] urobiť: { :id
	<- seba nový id: id.
}.

Položka pri: ['id:'] urobiť: { :id
	vlastný id := id.
}.

Položka pri: ['id'] urobiť: { <- vlastný id. }.


Položka pri: ['text'] urobiť: {
	>> str := ['Item#~no'].
	str ~no: vlastný id.
	<- str.
}.


>> Print := Objekt nový.

Print pri: ['items'] urobiť: { 
	
	vlastný položka := Položka nový: 1.
	
	# tu buď segfault, alebo chybný reťazec
	Záznamník say: (
		['~item printed.'] ~item: vlastný položka
	).
	
	
}.

Print items.