Zoznam pri: ['sum'] urobiť: {
	>> total := 0.
	seba každý: { :index :element
		total pridať: element.
	}. <- total.
}.

>> a := Pravda.



a pri: ['text'] urobiť: {
	>> answer := Nič.
	( seba = Pravda ) pravda: {
		answer := ['Yep'].
	}, inak: {
		answer := ['Nope'].
	}. <- answer.
}.

a pri: ['číslo'] urobiť: {
	>> answer := Nič.
	( seba = Pravda ) pravda: {
		answer := 10.
	}, inak: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b pri: ['text'] urobiť: { <- ['Devil'].
}.

b pri: ['logický'] urobiť: { <- Nepravda.
}.


Výstup písať: a, nový-riadok.  
Výstup písať: (90 + a), nový-riadok. 
Výstup písať: b, nový-riadok. 
Výstup písať: (Pravda a: b), nový-riadok.

a := Zoznam ← ['hello'] ; ['world'] ; Pravda ; Nič ; 666. 
a := a + ( Zoznam ← 1 ).
Výstup písať: a, nový-riadok.
Výstup písať: ((Slovník nový) umiestniť: Nič na: Nič), nový-riadok.
Výstup písať: a sum, nový-riadok. 


{
	a pri: ['text'] urobiť: { <- Nič. }.
	a := [''] + a.
} zachytiť: { :error
	Výstup písať: ['Error noted: '] + error, nový-riadok.
}, spustiť.



{
	a pri: ['číslo'] urobiť: { <- Nič. }.
	a := 3 × a.
} zachytiť: { :error
	Výstup písať: ['Error noted: '] + error, nový-riadok.
}, spustiť.


{
	a pri: ['logický'] urobiť: { <- Nič. }.
	a := Pravda a: a. 
} zachytiť: { :error
	Výstup písať: ['Error noted: '] + error, nový-riadok.
}, spustiť.





