Zoznam pri: ['súčet'] urobiť: {
	>> celkom := 0.
	seba každý: { :index :prvok
		celkom pridať: prvok.
	}. <- celkom.
}.

>> a := Pravda.



a pri: ['text'] urobiť: {
	>> odpoveď := Nič.
	( seba = Pravda ) pravda: {
		odpoveď := ['Jasné'].
	}, inak: {
		odpoveď := ['Kdeže'].
	}. <- odpoveď.
}.

a pri: ['číslo'] urobiť: {
	>> odpoveď := Nič.
	( seba = Pravda ) pravda: {
		odpoveď := 10.
	}, inak: {
		odpoveď := 20.
	}. <- odpoveď.
}.

>> b := 666.

b pri: ['text'] urobiť: { <- ['Diabol'].
}.

b pri: ['logický'] urobiť: { <- Nepravda.
}.


Výstup písať: a, nový-riadok.  
Výstup písať: (90 + a), nový-riadok. 
Výstup písať: b, nový-riadok. 
Výstup písať: (Pravda a: b), nový-riadok.

a := Zoznam ← ['hello'] ; ['world'] ; Pravda ; Nič ; 666. 
a := a + ( Zoznam ← 1 ).
Výstup písať: a, nový-riadok.
Výstup písať: ((Slovník nový) umiestniť: Nič na: Nič), nový-riadok.
Výstup písať: a súčet, nový-riadok. 


{
	a pri: ['text'] urobiť: { <- Nič. }.
	a := [''] + a.
} zachytiť: { :výnimka
	Výstup písať: ['Zaznamenaná chyba: '] + výnimka, nový-riadok.
}, spustiť.



