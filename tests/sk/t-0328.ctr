Program správa-pamäte: 4.

>> Doubler := Objekt nový.
>> Multiplier := Objekt nový.
Doubler pri: ['double:and:'] urobiť: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier pri: ['multiply:and:'] urobiť: { :x :y <- (x × y).
}.

Výstup písať: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), nový-riadok.
