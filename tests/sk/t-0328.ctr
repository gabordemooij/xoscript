Program správa-pamäte: 4.

>> Zdvojovač := Objekt nový.
>> Násobiteľ := Objekt nový.
Zdvojovač pri: ['zdvojnásobiť:a:'] urobiť: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Násobiteľ pri: ['násobiť:a:'] urobiť: { :x :y <- (x × y).
}.

Výstup písať: (
	Zdvojovač zdvojnásobiť:
		(Zdvojovač zdvojnásobiť: 
			(Násobiteľ násobiť: 2 a: 3)
		a:
			(Násobiteľ násobiť: 3 a: 4)
		)
	a:
		(Zdvojovač zdvojnásobiť: 
			(Násobiteľ násobiť: 2 a: 3)
		a:
			(Násobiteľ násobiť: 3 a: 4)
		)
), nový-riadok.
