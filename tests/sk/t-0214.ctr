

# odkaz vo world.c

>> použitá-pamäť1 := 0.
>> použitá-pamäť2 := 0.
>> použitá-pamäť3 := 0.
>> použitá-pamäť4 := 0.
>> kód := {
	>> a := Slovník nový.
	>> b := Slovník nový.
	a prepojiť: b.
	b prepojiť: a.
}.
Program správa-pamäte: 0.
Program upratať.
použitá-pamäť1 := (Program pamäť ? 0).
kód spustiť.
Program upratať.
použitá-pamäť2 := (Program pamäť ? 0).
kód spustiť.
Program upratať.
použitá-pamäť3 := (Program pamäť ? 0).
( použitá-pamäť1 = použitá-pamäť2 a: použitá-pamäť1 = použitá-pamäť3, a: použitá-pamäť2 = použitá-pamäť3 ) pravda: {
	Výstup písať: ['Žiadne úniky pamäte'].
}, nepravda: {
	Výstup písať: ['Uniká pamäť...'].
}.
