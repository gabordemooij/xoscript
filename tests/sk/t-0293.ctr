
>> mesto := Zoznam ← ['Londýn'] ; ['Paríž'] ; ['Berlín'].
>> teplota := Zoznam ← ['15'] ; ['16'] ; ['15'].
>> počasie := teplota podľa: mesto.
>> mestá := počasie záznamy zoradiť: { :a :b <- (a porovnať: b). }.
>> teploty := počasie hodnoty zoradiť: { :a :b <- (a porovnať: b) záporné?. }.

Výstup písať: (mestá spojiť: [',']), nový-riadok.
Výstup písať: (teploty spojiť: [',']), nový-riadok.
