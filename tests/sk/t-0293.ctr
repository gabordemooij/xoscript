
>> city := Zoznam ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Zoznam ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature podľa: city.
>> cities := weather záznamy zoradiť: { :a :b <- (a porovnať: b). }.
>> temperatures := weather hodnoty zoradiť: { :a :b <- (a porovnať: b) záporné?. }.

Výstup písať: (cities spojiť: [',']), nový-riadok.
Výstup písať: (temperatures spojiť: [',']), nový-riadok.
