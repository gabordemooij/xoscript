


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program správa-pamäte: 0.
>> palette := Nič.
>> colors := Nič.

{
palette := Slovník nový.
palette 
	umiestniť: ['#F00'] na: ['red'],
	umiestniť: ['#0F0'] na: ['green'],
	umiestniť: ['#00F'] na: ['blue'].
Výstup písať: ['number of RGB codes in palette: '] + ( palette počet ), nový-riadok.
Výstup písať: ['RGB code of green is: '] + ( palette ? ['green'] ), nový-riadok.
colors := [''].
( palette každý: { :názov :kód
		colors := colors + ( názov + [':'] + kód ).
} ).
Výstup písať: ['All colors in palette: '] + colors, nový-riadok.
} spustiť.
Program upratať.
usedMemory1 := (Program pamäť ? 0).

