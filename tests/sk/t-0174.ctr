( použitá-pamäť1 = použitá-pamäť2 a: použitá-pamäť1 = použitá-pamäť3, a: použitá-pamäť2 = použitá-pamäť3 ) pravda: {
	Výstup písať: ['Žiadne úniky pamäte'].
}, nepravda: {
	Výstup písať: ['Uniká pamäť...'].
}.
