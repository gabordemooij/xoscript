


>> použitá-pamäť1 := 0.
>> použitá-pamäť2 := 0.
>> použitá-pamäť3 := 0.
>> použitá-pamäť4 := 0.

Program správa-pamäte: 0.
>> paleta := Nič.
>> farby := Nič.

{
paleta := Slovník nový.
paleta 
	umiestniť: ['#F00'] na: ['červená'],
	umiestniť: ['#0F0'] na: ['zelená'],
	umiestniť: ['#00F'] na: ['modrá'].
Výstup písať: ['počet RGB kódov v palete: '] + ( paleta počet ), nový-riadok.
Výstup písať: ['RGB kód zelenej je: '] + ( paleta ? ['zelená'] ), nový-riadok.
farby := [''].
( paleta každý: { :názov :kód
		farby := farby + ( názov + [':'] + kód ).
} ).
Výstup písať: ['Všetky farby v palete: '] + farby, nový-riadok.
} spustiť.
Program upratať.
použitá-pamäť1 := (Program pamäť ? 0).

