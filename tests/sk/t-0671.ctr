# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Trezor vygenerovať-kľúče.

# private (secret) key
>> sk := keys prvý.

# public key
>> pk := keys posledný.

# sign a message
>> sig := Trezor podpísať: ['abc'] kľúčom: sk.

# check message (ok)
Výstup písať: ( 
	Trezor
		overiť: ['abc'] 
		podpis: sig 
		kľúčom: pk 
), nový-riadok.

# check message (fail)
Výstup písať: ( 
	Trezor 
		overiť: ['abd'] 
		podpis: sig 
		kľúčom: pk 
), nový-riadok.