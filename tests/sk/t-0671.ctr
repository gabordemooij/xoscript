# verejný kľúč (na zabezpečenie API atď.)
Server init.

# vygenerovanie kľúčov
>> kľúče := Trezor vygenerovať-kľúče.

# súkromný (tajný) kľúč
>> sk := kľúče prvý.

# verejný kľúč
>> pk := kľúče posledný.

# podpísanie správy
>> sig := Trezor podpísať: ['abc'] kľúčom: sk.

# kontrola správy (ok)
Výstup písať: ( 
	Trezor
		overiť: ['abc'] 
		podpis: sig 
		kľúčom: pk 
), nový-riadok.

# kontrola správy (neúspech)
Výstup písať: ( 
	Trezor 
		overiť: ['abd'] 
		podpis: sig 
		kľúčom: pk 
), nový-riadok.