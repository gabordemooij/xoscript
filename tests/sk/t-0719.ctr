Server init.
>> fmt := Formát nový: ['%#3x'].

>> blob := Blob nový: 4.
blob bytes: ( 
	Zoznam nový ; 0 ; 1 ; 2 ; 3
).

>> file := Súbor nový: ['/tmp/blob'].
file blob: blob.
blob uvoľniť.

>> čítať := file blob.
čítať 
od: 0 
dĺžka: 4, 
robiť každý: { :i :b 
	Výstup
	písať: (fmt aplikovať-celé: b),
	nový-riadok.
}.
čítať uvoľniť.
