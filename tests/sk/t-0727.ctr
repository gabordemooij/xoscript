Server init.
>> f := Formát nový: ['%d'].
>> a := Blob nový: 4.
a bytes: ( Zoznam nový ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob nový: 4.
b bytes: ( Zoznam nový ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a od: 0 dĺžka: 3, každý: { :i :byte
	Výstup písať: ( f aplikovať-celé: byte ) , nový-riadok.
}.
a ^ b.
a od: 0 dĺžka: 3, každý: { :i :byte
	Výstup písať: ( f aplikovať-celé: byte ) , nový-riadok.
}.
a ^ b.
a od: 0 dĺžka: 3, každý: { :i :byte
	Výstup písať: ( f aplikovať-celé: byte ) , nový-riadok.
}.
a uvoľniť.
b uvoľniť.

{ a ^ Objekt. } zachytiť: { :e Výstup písať: e, nový-riadok. }, spustiť.
