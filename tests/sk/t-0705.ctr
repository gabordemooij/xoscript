

>> obj := Objekt nový.

obj pri: ['greet'] urobiť: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj pri: ['task'] urobiť: {
	vlastný property := 123.
	{
		# try binds self/own to object instead of block
		Výstup písať: seba greet.
		Výstup písať: vlastný property.
		1 / 0.
	} zachytiť: {
		Výstup písať: seba greet.
		Výstup písať: vlastný property.
		Výstup písať: ['ok'].
	}, skúsiť.
}.

obj task.