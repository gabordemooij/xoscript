

>> obj := Objekt nový.

obj pri: ['pozdraviť'] urobiť: {
	<- ['ahoj'].
}.

# musí vypísať hi123hi123ok
obj pri: ['úloha'] urobiť: {
	vlastný vlastnosť := 123.
	{
		# skúsiť viaže seba/vlastný na objekt namiesto bloku
		Výstup písať: seba pozdraviť.
		Výstup písať: vlastný vlastnosť.
		1 / 0.
	} zachytiť: {
		Výstup písať: seba pozdraviť.
		Výstup písať: vlastný vlastnosť.
		Výstup písať: ['ok'].
	}, skúsiť.
}.

obj úloha.