>> Hltač := Objekt nový.
Hltač pri: ['nový'] urobiť: {
	vlastný str := [''].
}.
Hltač naučiť: ['nieuw'] znamená: ['nový'].
Hltač pri: ['odpovedať:'] urobiť: { :blah
		(vlastný str ≠ ['']) pravda: {
			vlastný str pripojiť: [' '].
		}.
		vlastný str pripojiť: blah.
}.
Hltač pri: ['odpovedať:a:'] urobiť: { :blah :blahah
		(vlastný str ≠ ['']) pravda: {
			vlastný str pripojiť: [' '].
		}.
		(blah dĺžka > 1) pravda: {
			vlastný str pripojiť: (blah od: 0 dĺžka: (blah dĺžka - 1)).
		}, inak: {
			vlastný str pripojiť: blah.
		}.
		vlastný str pripojiť: [' '].
		vlastný str pripojiť: blahah.
}.
Hltač pri: ['obdržať'] urobiť: {
	>> buffer := vlastný str.
	vlastný str := ['']. <- buffer.
}.


>> parametre-hľadania := Hltač nový
	select: ['*'],
	from
		používatelia 
	where 
		user_id=: 1.

Výstup písať: parametre-hľadania obdržať, nový-riadok.
