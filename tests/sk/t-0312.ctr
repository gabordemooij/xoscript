>> Slurp := Objekt nový.
Slurp pri: ['nový'] urobiť: {
	vlastný str := [''].
}.
Slurp naučiť: ['nieuw'] znamená: ['nový'].
Slurp pri: ['odpovedať:'] urobiť: { :blah
		(vlastný str ≠ ['']) pravda: {
			vlastný str pripojiť: [' '].
		}.
		vlastný str pripojiť: blah.
}.
Slurp pri: ['odpovedať:a:'] urobiť: { :blah :blahah
		(vlastný str ≠ ['']) pravda: {
			vlastný str pripojiť: [' '].
		}.
		(blah dĺžka > 1) pravda: {
			vlastný str pripojiť: (blah od: 0 dĺžka: (blah dĺžka - 1)).
		}, inak: {
			vlastný str pripojiť: blah.
		}.
		vlastný str pripojiť: [' '].
		vlastný str pripojiť: blahah.
}.
Slurp pri: ['obtain'] urobiť: {
	>> buffer := vlastný str.
	vlastný str := ['']. <- buffer.
}.


>> parametre-hľadania := Slurp nový
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

Výstup písať: parametre-hľadania obtain, nový-riadok.
