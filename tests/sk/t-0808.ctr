# kľúče a podpisy trezoru, ktoré sa dekódujú príliš dlhé, nesmú pretiecť zásobník
Server init.

>> kľúče := Trezor vygenerovať-kľúče.
>> sk := kľúče prvý.
>> pk := kľúče posledný.
>> sig := Trezor podpísať: ['abc'] kľúčom: sk.

# 88 znakov bez výplne sa dekóduje na 66 bajtov
>> dlhý := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 znakov bez výplne sa dekóduje na 33 bajtov
>> krátky := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Trezor podpísať: ['abc'] kľúčom: dlhý. } zachytiť: { :e
	Výstup písať: e, nový-riadok.
}, spustiť.

{ Trezor overiť: ['abc'] podpis: dlhý kľúčom: pk. } zachytiť: { :e
	Výstup písať: e, nový-riadok.
}, spustiť.

{ Trezor overiť: ['abc'] podpis: sig kľúčom: krátky. } zachytiť: { :e
	Výstup písať: e, nový-riadok.
}, spustiť.
