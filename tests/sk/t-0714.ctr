>> a := Objekt nový. 
a pri: ['greet'] urobiť: { Výstup písať: ['welcome!'], nový-riadok. }.
a pri: ['greet2'] urobiť: { Výstup písať: ['welcome2!'], nový-riadok. }.
a save-as: ['/tmp/a.bin'].

Výstup písať: ['========== RELOADING SNAP:'], nový-riadok.
>> b := Objekt load-from: ['/tmp/a.bin'].
b greet2.