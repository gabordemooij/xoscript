# test qualifiers

Program upratať.

>> Fruit := Objekt nový.
Fruit pri: ['nový'] urobiť: {
	>> f := seba nový.
	f apples: 0. <- f.
}.
Fruit pri: ['apples:'] urobiť: { :a vlastný apples := a. }.
Fruit pri: ['apples'] urobiť: { <- vlastný apples. }.
Fruit pri: ['+'] urobiť: { :f
	>> n := Fruit nový.
	n apples: (f apples + vlastný apples). <- n.
}.
Číslo pri: ['apples'] urobiť: { <- ((Fruit nový) apples: seba).
}.

Fruit pri: ['text'] urobiť: { <- vlastný apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Výstup písať: q, nový-riadok.




q := 3 apples + 4 apples.
Výstup písať: q, nový-riadok.



q := 3 apples + 4 apples.
Výstup písať: q, nový-riadok.


