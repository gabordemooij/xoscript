# test jednotiek

Program upratať.

>> Ovocie := Objekt nový.
Ovocie pri: ['nový'] urobiť: {
	>> f := seba nový.
	f apples: 0. <- f.
}.
Ovocie pri: ['apples:'] urobiť: { :a vlastný jablká := a. }.
Ovocie pri: ['jablká'] urobiť: { <- vlastný jablká. }.
Ovocie pri: ['+'] urobiť: { :f
	>> n := Ovocie nový.
	n apples: (f jablká + vlastný jablká). <- n.
}.
Číslo pri: ['jablká'] urobiť: { <- ((Ovocie nový) apples: seba).
}.

Ovocie pri: ['text'] urobiť: { <- vlastný jablká + [' jabĺk '].
}.

>> q := 3 jablká + 4 jablká.
Výstup písať: q, nový-riadok.




q := 3 jablká + 4 jablká.
Výstup písať: q, nový-riadok.



q := 3 jablká + 4 jablká.
Výstup písať: q, nový-riadok.


