Server init.

>> conn1 := Maria-DB nový hostiteľ: ['localhost'],
	používateľ: ['xo'],
	heslo: ['pass123'],
	názov-databázy: ['xobase'],
	pripojiť-sa.

>> conn2 := Maria-DB nový hostiteľ: ['localhost'],
	používateľ: ['xo'],
	heslo: ['pass123'],
	názov-databázy: ['xobase'],
	pripojiť-sa.
#...
>> del := conn1 dopyt: ['DELETE FROM book WHERE id > 0'].
{  del vykonať. conn1 potvrdiť. } zachytiť: { :e conn1 vrátiť-späť.  }, spustiť.

>> insert := conn1 dopyt: ['INSERT INTO book (id) VALUES(null)'].
insert vykonať.

>> počet := conn1 dopyt: ['SELECT COUNT(*) AS num FROM book'].
počet načítať: { :row Výstup písať: row num, nový-riadok. }.

# does not show up
# insert not committed on connection 1
>> počet := conn2 dopyt: ['SELECT COUNT(*) AS num FROM book'].
počet načítať: { :row Výstup písať: row num, nový-riadok. }.
