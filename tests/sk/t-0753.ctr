Výstup písať: ['Test object'], nový-riadok.
>> a := Objekt nový. 

a pri: ['item:'] urobiť: { :fmt
	vlastný fmt := fmt. 
}.

a pri: ['item'] urobiť: { <- vlastný fmt.
}.

a item: ( Formát nový: ['|%s|'] ).

Výstup písať: a item, nový-riadok.

>> old-fmt-address := a item prototyp adresa-pamäte.
a save-as: ['/tmp/a.bin'].
Výstup písať: ['========== RELOADING SNAP:'], nový-riadok.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp adresa-pamäte = old-fmt-address) pravda: {
	Výstup písať: ['Object link re-attached.'], nový-riadok.
}.

Výstup písať: ( b item aplikovať: ['hello'] ), nový-riadok.
