>> z := Objekt nový.
z pri: ['value:'] urobiť: { :v
	vlastný value := v. <- seba.
}.
z pri: ['value'] urobiť: { <- vlastný value. }.
(z setValue: 1) value: 2.
Výstup písať: z value.
>> x := z.
Výstup písať: x value.
z := Nič.
Výstup písať: z value.
Výstup písať: x value.
Výstup písať: ['hello'].
Výstup písať: 3 + 2.
Výstup písať: (3 > 2).
