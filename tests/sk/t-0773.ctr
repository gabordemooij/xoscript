Výstup písať: ['Test object'], nový-riadok.
>> a := Objekt nový. 
a pri: ['item:'] urobiť: { :int64
	vlastný int64 := int64. 
}.
a pri: ['item'] urobiť: { <- vlastný int64.
}.
a item: ( Int64 z-textu: ['9999'] ).
Výstup písať: a item, nový-riadok.
>> old-int64-address := a item prototyp adresa-pamäte.
a save-as: ['/tmp/a.bin'].
Výstup písať: ['========== RELOADING SNAP:'], nový-riadok.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b item prototyp adresa-pamäte = old-int64-address) pravda: {
	Výstup písať: ['Object link re-attached.'], nový-riadok.
}.
Výstup písať: ( b item ), nový-riadok.
