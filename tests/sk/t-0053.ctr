60 × {
	>> x := (Číslo náhodný % 6) + 1.
	(x ≤ 6) nepravda: { Výstup písať: ['CHYBA']. }.
	(x ≥0) nepravda: { Výstup písať: ['CHYBA']. }.
	x := (Číslo náhodný % 3) + 1.
	(x < 3) nepravda: { Výstup písať: ['CHYBA']. }.
	(x>-1) nepravda: { Výstup písať: ['CHYBA']. }.
	x := ((Logický hodiť-mincou) číslo).
	(x = 0 alebo: x = 1) nepravda: { Výstup písať: ['CHYBA']. }.
	x := ((Pravda hodiť-mincou) číslo).
	(x = 0 alebo: x = 1) nepravda: { Výstup písať: ['CHYBA']. }.
	x := (Logický hodiť-mincou buď: ['HLAVA'] alebo: ['ZNAK']).
	((x = ['HLAVA']) alebo: (x = ['ZNAK'])) nepravda: { Výstup písať: ['CHYBA']. }.
}.
Výstup písať: ['HOTOVO'].

