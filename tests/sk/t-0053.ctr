60 × {
	>> x := (Číslo random % 6) + 1.
	(x ≤ 6) nepravda: { Výstup písať: ['FAIL']. }.
	(x ≥0) nepravda: { Výstup písať: ['FAIL']. }.
	x := (Číslo random % 3) + 1.
	(x < 3) nepravda: { Výstup písať: ['FAIL']. }.
	(x>-1) nepravda: { Výstup písať: ['FAIL']. }.
	x := ((Logický flip) číslo).
	(x = 0 alebo: x = 1) nepravda: { Výstup písať: ['FAIL']. }.
	x := ((Pravda flip) číslo).
	(x = 0 alebo: x = 1) nepravda: { Výstup písať: ['FAIL']. }.
	x := (Logický flip buď: ['HEAD'] alebo: ['TAIL']).
	((x = ['HEAD']) alebo: (x = ['TAIL'])) nepravda: { Výstup písať: ['FAIL']. }.
}.
Výstup písať: ['DONE'].

