Výstup písať: ['Pokračovanie slučky for, Nie - pred 6 a vyššie.'], nový-riadok.
{ :i
	Výstup písať: (i + 1), nový-riadok.
	((i + 1) > 4) pokračovať.
	Výstup písať: ['-'].
} × 10.

>> x := 0.
>> x-je-menšie-ako-10 := { <- ( x < 10 ). }.
Výstup nový-riadok.
Výstup písať: ['Pokračovanie while-true, Nie --> pred 5 a vyššie.'], nový-riadok.
{
	Výstup písať: ['iteration #'] + x, nový-riadok.
	x pridať: 1.
	((x < 5) nie) pokračovať.
	Výstup písať: ['-->'].
} kým: x-je-menšie-ako-10.
Výstup nový-riadok.
Výstup písať: ['Pokračovanie while-false, Nie - iba pred 3.'], nový-riadok.
{
	Výstup písať: ['iteration #'] + x, nový-riadok.
	x odčítať: 1.
	(x = 3) pokračovať.
	Výstup písať: ['-'].
} kým: { <- ( x > 0). }.

Výstup nový-riadok.
Výstup písať: ['Pokračovanie slučky times, Nie ||| pred 3.'], nový-riadok.
{ :i
	Výstup písať: ['iteration #'] + i, nový-riadok.
	(i = 2) pokračovať.
	Výstup písať: ['|||'].
} × 5.

Výstup nový-riadok.

{ Pravda pokračovať. Výstup písať: ['toto nepíš!'], nový-riadok. } spustiť.

{ Pravda pokračovať. Výstup písať: ['toto nepíš!'], nový-riadok. } zachytiť: { Výstup písať: ['Toto nechytaj!']. }, spustiť.

Výstup písať: ['Test slučky each poľa: 0, ... ,2'], nový-riadok.
(Zoznam ← 1 ; 2 ; 3) zobraziť: { :i
	(i = 1) pokračovať.
	Výstup písať: ['iteration #'] + (i - 0), nový-riadok.
}.

Výstup písať: ['Test slučky each mapy: iba c'], nový-riadok.
>> m := Slovník nový.
m umiestniť: ['first'] na: ['a'], umiestniť: ['second'] na: ['b'], umiestniť: ['tretí'] na: ['c'].
m každý: { :k :v
	(k ≠ ['c']) pokračovať.
	Výstup písať: ['iteration'] + k + v, nový-riadok.
}.

