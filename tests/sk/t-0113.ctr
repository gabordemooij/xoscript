Výstup písať: ['Continue for-loop, No - before 6 and up.'], nový-riadok.
{ :i
	Výstup písať: (i + 1), nový-riadok.
	((i + 1) > 4) pokračovať.
	Výstup písať: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Výstup nový-riadok.
Výstup písať: ['Continue while-true, No --> before 5 and up.'], nový-riadok.
{
	Výstup písať: ['iteration #'] + x, nový-riadok.
	x pridať: 1.
	((x < 5) nie) pokračovať.
	Výstup písať: ['-->'].
} kým: xIsLessThan10.
Výstup nový-riadok.
Výstup písať: ['Continue while-false, No - before 3 only.'], nový-riadok.
{
	Výstup písať: ['iteration #'] + x, nový-riadok.
	x odčítať: 1.
	(x = 3) pokračovať.
	Výstup písať: ['-'].
} kým: { <- ( x > 0). }.

Výstup nový-riadok.
Výstup písať: ['Continue times-loop, No ||| before 3.'], nový-riadok.
{ :i
	Výstup písať: ['iteration #'] + i, nový-riadok.
	(i = 2) pokračovať.
	Výstup písať: ['|||'].
} × 5.

Výstup nový-riadok.

{ Pravda pokračovať. Výstup písať: ['dont write this!'], nový-riadok. } spustiť.

{ Pravda pokračovať. Výstup písať: ['dont write this!'], nový-riadok. } zachytiť: { Výstup písať: ['Dont catch this!']. }, spustiť.

Výstup písať: ['Test Array each-loop: 0, ... ,2'], nový-riadok.
(Zoznam ← 1 ; 2 ; 3) zobraziť: { :i
	(i = 1) pokračovať.
	Výstup písať: ['iteration #'] + (i - 0), nový-riadok.
}.

Výstup písať: ['Test Map each-loop: c only'], nový-riadok.
>> m := Slovník nový.
m umiestniť: ['first'] na: ['a'], umiestniť: ['second'] na: ['b'], umiestniť: ['third'] na: ['c'].
m každý: { :k :v
	(k ≠ ['c']) pokračovať.
	Výstup písať: ['iteration'] + k + v, nový-riadok.
}.

