
>> Size := Objekt nový.
Size pri: ['is:'] urobiť: { :číslo
	číslo pri: ['+'] urobiť: { :číslo
		>> unit := číslo jednotka.
		>> factor := 1.
		
		unit
		prípad: ['inch'] urobiť: { factor := 0.0833. }. <- seba + (číslo * factor).
	}. <- číslo.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Výstup písať: plank + edge, nový-riadok.
