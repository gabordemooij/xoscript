
>> použitá-pamäť1 := 0.
>> použitá-pamäť2 := 0.
>> použitá-pamäť3 := 0.
>> použitá-pamäť4 := 0.

>> kód := {
	>> o := (
		Slovník nový
		aa: (Zoznam ← 1 ; 2),
		bb: (Zoznam ← 3 ; 4)
	).
	>> s := o text.
	>> o2 := s objekt.
	(s  typ = Text typ) pravda: { Výstup písať: ['OK1'], nový-riadok. }.
	(o2 typ = Slovník typ) pravda: { Výstup písať: ['OK2'], nový-riadok. }.
}.

Program správa-pamäte: 0.
['Pamäť 1 bude iná, lebo sledované bloky sa pridávajú hromadne.'].
Program upratať.
použitá-pamäť1 := (Program pamäť ? 1).
kód spustiť.
Program upratať.
použitá-pamäť2 := (Program pamäť ? 1).
kód spustiť.
Program upratať.
použitá-pamäť3 := (Program pamäť ? 1).
kód spustiť.
Program upratať.
použitá-pamäť4 := (Program pamäť ? 1).

(použitá-pamäť2 = použitá-pamäť3 = použitá-pamäť4) pravda: { Výstup písať: ['OK3'], nový-riadok. }.
 
