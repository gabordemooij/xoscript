
Program správa-pamäte: 4.

>> Animal := Objekt nový.
Animal pri: ['make'] urobiť: {
	>> animal := Objekt nový.
	animal pri: ['makeSound'] urobiť: {
		Výstup písať: vlastný sound.
	}. <- animal.
}.
>> Cat := Objekt nový.
Cat pri: ['make'] urobiť: {
	>> cat := Animal make.
	cat pri: ['init'] urobiť: {
		vlastný sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
