

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program správa-pamäte: 0.

Číslo pri: ['addNum:'] urobiť: { :x
	seba pridať: x.
}.

Číslo pri: ['subtractNum:'] urobiť: { :x
	seba odčítať: x.
}.

Číslo pri: ['multiplyBy:'] urobiť: { :x
	seba vynásobiť: x.
}.

Číslo pri: ['divideBy:'] urobiť: { :x
	seba vydeliť: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 umocniť-na: 8).  
a := a + (2 umocniť-na: -1). 
a := a + (49 odmocnina).   
a addNum: ((Zoznam ← 0 ; 1) maximum).          
a addNum: ((Zoznam ← 2 ; 3) minimum).
Výstup písať: a.

Program upratať.

usedMemory1 := (Program pamäť ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 umocniť-na: 8).  
a := a + (2 umocniť-na: -1). 
a := a + (49 odmocnina).   
a addNum: ((Zoznam ← 0 ; 1) maximum).          
a addNum: ((Zoznam ← 2 ; 3) minimum).
Výstup písať: a.

Program upratať.
usedMemory2 := (Program pamäť ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 umocniť-na: 8).  
a := a + (2 umocniť-na: -1). 
a := a + (49 odmocnina).   
a addNum: ((Zoznam ← 0 ; 1) maximum).          
a addNum: ((Zoznam ← 2 ; 3) minimum).
Výstup písať: a.

Program upratať.
usedMemory3 := (Program pamäť ? 0).



( usedMemory1 = usedMemory2 a: usedMemory1 = usedMemory3, a: usedMemory2 = usedMemory3 ) pravda: {
	Výstup písať: ['No memory leaks here'].
}, nepravda: {
	Výstup písať: ['Leaking memory...'].
}.
