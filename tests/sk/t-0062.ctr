Logický pri: ['xor:'] urobiť: { :a :b <- ((a a: b nie) alebo: (a nie a: b)).
}.

>> o := Objekt nový.
o pri: ['hello'] urobiť: { ['Empty']. }.
{ o pri: 2 urobiť: 3.} zachytiť: { :e Výstup písať: e, nový-riadok. }, spustiť.
{ o pri: ['test'] urobiť: 3.} zachytiť: { :e Výstup písať: e, nový-riadok. }, spustiť.
{ o pri: ['hello'] urobiť: { ['Empty']. }.} zachytiť: { :e Výstup písať: e, nový-riadok. }, spustiť. 
{ >> z := 4 ÷ 0. } zachytiť: { :e Výstup písať: e, nový-riadok. }, spustiť. 
{ (Pravda a: Nič) pravda: { Výstup písať: ['X'].}. } zachytiť: { :e Výstup písať: e, nový-riadok. }, spustiť. 
{ ([''] xor: 0) pravda: { Výstup písať: ['X'].}. } zachytiť: { :e Výstup písať: e, nový-riadok. }, spustiť. 
{ (1 < ['2']) pravda: { Výstup písať: ['OK']. }. } zachytiť: { :e Výstup písať: e, nový-riadok. }, spustiť. 
{ (1 < ['2.0']) pravda: { Výstup písať: ['OK']. }. } zachytiť: { :e Výstup písať: e, nový-riadok. }, spustiť. 
{ (1 < ['x2.0']) pravda: { Výstup písať: ['NO!']. }. } zachytiť: { :e Výstup písať: e, nový-riadok. }, spustiť. 
{ Výstup písať: (['hello OK there'] od: ['6'] dĺžka: ['2']). } spustiť. 
