Výstup písať: ['Test object'], nový-riadok.
>> a := Objekt nový. 
a pri: ['item:'] urobiť: { :lst
	vlastný lst := lst. 
}.
a pri: ['item'] urobiť: { <- vlastný lst.
}.
a item: (
	Zoznam nový ; 1 ; (
		Zoznam nový ; ['a'] ; (
			Zoznam nový ; ( Okamih nový: 1 )
		) ; ( Int64 z-textu: ['321'] )
	)
).
Výstup písať: a item, nový-riadok.
>> old-lst-address := a item prototyp adresa-pamäte.
a save-as: ['/tmp/a.bin'].
Výstup písať: ['========== RELOADING SNAP:'], nový-riadok.
>> b := Objekt load-from: ['/tmp/a.bin'].
(b item prototyp adresa-pamäte = old-lst-address) pravda: {
	Výstup písať: ['Object link re-attached.'], nový-riadok.
}.
Výstup písať: ( b item ), nový-riadok.
