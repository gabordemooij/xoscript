# použitie FFI s pluginom Server

# pripojenie k libc (závisí od platformy)
>> názov-knižnice := Program nastavenie: ['FFITESTLIB'].

# prepojenie funkcií stdio z C pre pokročilé operácie so súbormi
Server prepojiť: ( Zoznam nový ;
 názov-knižnice ; ['fopen'] ;
 ( Zoznam nový ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
prepojiť: ( Zoznam nový ;
 Nič ; # znamená tú istú knižnicu
 ['fread'] ;
 ( Zoznam nový ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nič ; # znamená ten istý objekt (t. j. Stream)
 ['fread']
),
prepojiť: (
 Zoznam nový ;
 Nič ; # znamená tú istú knižnicu
 ['fwrite'] ;
 ( Zoznam nový ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nič ; # znamená tú istú knižnicu
 ['fwrite']
),
prepojiť: (
 Zoznam nový ;
 Nič ; # znamená tú istú knižnicu
 ['rewind'] ;
 ( Zoznam nový ; ['pointer'] ) ;
 ['int'] ;
 Nič ; # znamená tú istú knižnicu
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> cesta := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# otvorenie súboru pomocou fopen(path, mode)
>> fd := Stream path: cesta mode: mode.

# zápis bajtov z bufferu reťazec do súboru
>> zapísané-bajty := Stream správa: ['fwrite'] argumenty: (Zoznam nový ; str ; 1 ; 6 ; fd ).
Výstup písať: zapísané-bajty, nový-riadok.

# pretočenie ukazovateľa súboru na začiatok
Stream rewind: fd.

# alokácia bufferu
>> buf := Blob nový: 20.

# čítanie zo súboru
>> prečítané-bajty := Stream správa: ['fread'] argumenty: (Zoznam nový ; buf ; 1 ; 6 ; fd ).
Výstup písať: prečítané-bajty, nový-riadok.
Výstup písať: buf, nový-riadok.

# uvoľnenie pamäte
str  uvoľniť.
cesta uvoľniť.
mode uvoľniť.
buf  uvoľniť.


