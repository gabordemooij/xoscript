Výstup písať: ['Testovací objekt'], nový-riadok.
>> a := Objekt nový. 

a pri: ['item:'] urobiť: { :hex-pomocník
	vlastný hex-pomocník := hex-pomocník. 
}.

a pri: ['položka'] urobiť: {
	<- vlastný hex-pomocník.
}.

a item: Hx nový.

>> stará-adresa-hex-pomocníka := a položka prototyp adresa-pamäte.
a save-as: ['/tmp/a.bin'].
Výstup písať: ['========== OPÄTOVNÉ NAČÍTANIE SNÍMKY:'], nový-riadok.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b položka prototyp adresa-pamäte = stará-adresa-hex-pomocníka) pravda: {
	Výstup písať: ['Odkaz na objekt znovu pripojený.'], nový-riadok.
}.
