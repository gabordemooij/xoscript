Výstup písať: ['Test object'], nový-riadok.
>> a := Objekt nový. 

a pri: ['item:'] urobiť: { :hexhelper
	vlastný hexhelper := hexhelper. 
}.

a pri: ['item'] urobiť: { <- vlastný hexhelper.
}.

a item: Hx nový.

>> old-hexhelper-address := a item prototyp adresa-pamäte.
a save-as: ['/tmp/a.bin'].
Výstup písať: ['========== RELOADING SNAP:'], nový-riadok.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp adresa-pamäte = old-hexhelper-address) pravda: {
	Výstup písať: ['Object link re-attached.'], nový-riadok.
}.
