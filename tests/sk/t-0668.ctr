# dekódovanie z utf16le/be alebo utf32le/be do utf8
Server init.
>> utf16 := Blob nový: 8, bytes: (
	Zoznam nový ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Výstup písať: ( utf16 dekódovať: ['utf16le'] ), nový-riadok.

utf16 uvoľniť.
>> utf32 := Blob nový: 13, bytes: (
	Zoznam nový ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Výstup písať: ( utf32 dekódovať: ['utf32be'] ), nový-riadok.
utf32 uvoľniť.