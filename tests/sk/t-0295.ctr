
>> dictionary := (
	Slovník nový
		umiestniť: ['b'] na: ['a'],
		umiestniť: ['a'] na: ['b'],
		umiestniť: ['z'] na: ['x'],
		umiestniť: ['hello'] na: ['hallo'],
		umiestniť: ['human'] na: ['human']
).

>> comparisons := Zoznam nový.
dictionary každý: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a porovnať: b)
	).
}.

comparisons zoradiť: { :a :b <- ( a porovnať: b ). }.
Výstup písať: ( comparisons spojiť: ['↵'] ), nový-riadok.
comparisons spojiť: ['↵'].
