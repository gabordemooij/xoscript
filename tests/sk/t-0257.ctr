
>> Greeter := Objekt nový.
Greeter pri: ['nový'] urobiť: {
	vlastný názov := ['?'].
}.
Greeter pri: ['name:'] urobiť: { :názov
	vlastný názov := názov.
}.
Greeter pri: ['greet'] urobiť: {
	Výstup písať: (['hello[you]'] [you]: vlastný názov).
}.
>> friend := Greeter nový.
friend name: ['1'].
friend greet.
