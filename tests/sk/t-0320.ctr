


>> CoffeeMachine := Objekt nový.
CoffeeMachine pri: ['order:'] urobiť: { :id
	>> coffee := ['Americano'].
	( id = 1 ) pravda: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) pravda: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) pravda: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Objekt nový.
SimpleCoffeeMachine pri: ['order'] urobiť: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Výstup písať: redCup, nový-riadok.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Výstup písať: greenCup, nový-riadok.
>> yellowCup := CoffeeMachine order: 1.
Výstup písať: yellowCup, nový-riadok.
>> blueCup := CoffeeMachine order: 0.
Výstup písať: blueCup, nový-riadok.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Výstup písať: blackCup, nový-riadok.
blackCup pripojiť: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Výstup písať: orangeCup, nový-riadok.
