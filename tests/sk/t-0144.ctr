



>> CoffeeGrounds := Objekt nový.
CoffeeGrounds pri: ['extract'] urobiť: { <- ['coffee']. }.

>> CoffeeMachine := Objekt nový.
CoffeeMachine pri: ['init'] urobiť: {
	vlastný coffeegrounds := CoffeeGrounds nový.
}.
CoffeeMachine pri: ['nový'] urobiť: { <- CoffeeMachine `new init.
}.

CoffeeMachine pri: ['makeTea'] urobiť: { <- (vlastný tealeaves extract). }.
CoffeeMachine pri: ['makeCoffee'] urobiť: { <- (vlastný coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine nový.

Výstup písať:
	coffeeDream 
	makeCoffee.

Výstup písať:
	coffeeDream 
	makeTea.
