# úvodzovka, ktorá sa nikdy neuzavrie, musí dať chybu, nie nekonečný cyklus
>> cesta := ['/tmp/test0821.csv'].
>> file := Súbor nový: cesta.

file písať: ['a,b\n"1,2\n'].
{
	file oddeľovač: [','] úvodzovka: ['"'] riadky: { :line
		Výstup písať: line, nový-riadok.
	}.
} zachytiť: { :e Výstup písať: e, nový-riadok. }, spustiť.

# uzavretá úvodzovka stále funguje
file písať: ['a,b\n"1,2",3'].
file oddeľovač: [','] úvodzovka: ['"'] riadky: { :line
	Výstup písať: line, nový-riadok.
}.
file vymazať.
