

>> použitá-pamäť1 := 0.
>> použitá-pamäť2 := 0.
>> použitá-pamäť3 := 0.
>> použitá-pamäť4 := 0.

Program správa-pamäte: 0.

>> txt := ['Word Salad'].
Výstup písať: ['posledný index lov = '] + (( txt posledný: ['ord'] ) - 0), nový-riadok.
Výstup písať: ['index lov = '] + (( txt nájsť: ['ord'] ) - 0), nový-riadok.
Výstup písať: ['index át = '] + (( txt nájsť: ['ad'] ) - 0), nový-riadok.
Výstup písať: ['posledný index W = '] + (( txt posledný: ['W'] ) - 0), nový-riadok.
Výstup písať: ['posledný index d = '] + (( txt posledný: ['d'] ) - 0), nový-riadok.
Výstup písať: ['txt sa rovná Slovný šalát = '] + ( txt = ['Word Salad'] ), nový-riadok.
Výstup písať: ['txt sa rovná Caesarov šalát = '] + ( txt = ['Caesarov šalát'] ), nový-riadok.
Výstup písať: ['txt sa nerovná Slovný šalát = '] + ( txt ≠ ['Word Salad'] ), nový-riadok.
Výstup písať: ['txt sa nerovná Caesarov šalát = '] + ( txt ≠ ['Caesarov šalát'] ), nový-riadok.

