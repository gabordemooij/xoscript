# test pretypovaní / prevodov / väzieb
Program správa-pamäte: 4.
Server init.

>> počítadlo := 0.
>> db := Maria-DB nový hostiteľ: ['localhost'],
	používateľ: ['xo'], heslo: ['pass123'], názov-databázy: ['xobase'], pripojiť-sa.

>> DvojcifernýFormát := Formát nový: ['%02d'].

# Dátum a čas
{
	>> rok     := Číslo medzi: 1995 a: 2050, text.
	>> mesiac    := DvojcifernýFormát aplikovať-celé: (Číslo medzi: 1 a: 12), text.
	>> deň      := DvojcifernýFormát aplikovať-celé: (Číslo medzi: 1 a: 28), text.
	>> hodina     := DvojcifernýFormát aplikovať-celé: (Číslo medzi: 1 a: 23), text.
	>> minúta   := DvojcifernýFormát aplikovať-celé: (Číslo medzi: 1 a: 59), text.
	>> sekunda   := DvojcifernýFormát aplikovať-celé: (Číslo medzi: 1 a: 59), text.
	>> dátum-čas := ['YYYY-MM-DD HH:II:SS'].	
	dátum-čas
		YYYY: rok,
		MM: mesiac,
		DD: deň,
		HH: hodina,
		II: minúta,
		SS: sekunda.
	>> parametre-hľadania :=
	db dopyt: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: dátum-čas),
	načítať: { :rad
		(rad mydatetime = dátum-čas) nepravda: {
			táto-úloha chyba: (
				['Očakávané: <expected>, ale získané: <observation>']
				<expected>: dátum-čas,
				<observation>: rad mydatetime
			).
		}.
	
	}.
	počítadlo pridať: 1.
} * 100.

# Dátum
{
	>> rok     := Číslo medzi: 1995 a: 2050, text.
	>> mesiac    := DvojcifernýFormát aplikovať-celé: (Číslo medzi: 1 a: 12), text.
	>> deň      := DvojcifernýFormát aplikovať-celé: (Číslo medzi: 1 a: 28), text.
	>> dátum     := ['YYYY-MM-DD'].
	dátum
		YYYY: rok,
		MM: mesiac,
		DD: deň.
	>> parametre-hľadania :=
	db dopyt: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: dátum),
	načítať: { :rad
		(rad mydate = dátum) nepravda: {
			táto-úloha chyba: (
				['Očakávané: <expected>, ale získané: <observation>']
				<expected>: dátum,
				<observation>: rad mydate
			).
		}.
	}.
	počítadlo pridať: 1.
} * 100.


# Čas
{
	>> hodina     := DvojcifernýFormát aplikovať-celé: (Číslo medzi: 1 a: 23), text.
	>> minúta   := DvojcifernýFormát aplikovať-celé: (Číslo medzi: 1 a: 59), text.
	>> sekunda   := DvojcifernýFormát aplikovať-celé: (Číslo medzi: 1 a: 59), text.
	>> čas := ['HH:II:SS'].
	čas
		HH: hodina,
		II: minúta,
		SS: sekunda.
	>> parametre-hľadania :=
	db dopyt: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: čas),
	načítať: { :rad
		(rad mytime = čas) nepravda: {
			táto-úloha chyba: (
				['Očakávané: <expected>, ale získané: <observation>']
				<expected>: dátum-čas,
				<observation>: rad mytime
			).
		}.
	}.
	počítadlo pridať: 1.
} * 100.


# Texty (varchar/text)
>> str1 := Zoznam nový naplniť: 100000 čím: ['x'], spojiť: [''].
{
	>> str2 := Trezor token: 40.
	>> parametre-hľadania :=
	db dopyt: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	načítať: { :rad
		(rad str1 = str1 a: rad str2 = str2) nepravda: {
			táto-úloha chyba: (
				['Očakávané: <expected>, ale získané: <observation>']
				<expected>: dátum-čas,
				<observation>: rad mytime
			).
		}.
	}.
	počítadlo pridať: 1.
} * 100.


# Čísla
{
	>> n1  := Číslo medzi: 1 a: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 z-textu: ['9223372036854775807'] ) -
		( Int64 z-textu: ['99999'] ) +
		( Int64 z-textu: n1 text )
	).
	>> parametre-hľadania :=
	db dopyt: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	načítať: { :rad
		(rad n1 = n1) nepravda: {
			táto-úloha chyba: (
				['Očakávané: <expected>, ale získané: <observation>']
				<expected>: n1,
				<observation>: rad n1
			).
		}.
		(rad n2 = n2) nepravda: {
			táto-úloha chyba: (
				['Očakávané: <expected>, ale získané: <observation>']
				<expected>: n1,
				<observation>: rad n2
			).
		}.
		(rad n3 = n2 zaokrúhliť) nepravda: {
			táto-úloha chyba: (
				['Očakávané: <expected>, ale získané: <observation>']
				<expected>: n1,
				<observation>: rad n3
			).
		}.
		(rad big = big) nepravda: {
			táto-úloha chyba: (
				['Očakávané: <expected>, ale získané: <observation>']
				<expected>: big,
				<observation>: rad big
			).
		}.
		
	}.
	počítadlo pridať: 1.
} * 100.


Výstup písať: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: počítadlo
), nový-riadok.