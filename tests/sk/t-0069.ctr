

Text pri: ['html'] urobiť: { <- (
		seba
		nahradiť: ['&'] za: ['&amp;'],
		nahradiť: ['<'] za: ['&lt;'],
		nahradiť: ['>'] za: ['&gt;'],
		nahradiť: ['"'] za: ['&quot;']
	).
}.


Výstup písať: ([' zľava orezané '] orezať) + [' '] + ( ['a sprava orezané'] orezať) + ['!'], nový-riadok.
Výstup písať: ['<html>"html & entities"</html>'] html.
