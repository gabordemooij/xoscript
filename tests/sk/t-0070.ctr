>> numbers := ['1,2,3'] rozdeliť: [','].
Výstup písať: ['I got: '] + numbers počet + [' numbers.'],nový-riadok.
{ :i Výstup písať: ['number #'] + i + [':'] + (numbers pozícia: i), nový-riadok.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages rozdeliť: [' Or '].
Výstup písať: ['We serve'], nový-riadok.
{ :i Výstup písať: ['->'] + (beverages pozícia: i), nový-riadok. } × (beverages počet).
Výstup písať: (beverages spojiť: [',']), nový-riadok.
Výstup písať: (numbers spojiť: ['||']).
