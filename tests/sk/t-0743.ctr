>> V := Objekt.
V pri: ['text'] urobiť: {
	Výstup písať: ['pretypovanie'], nový-riadok.
	<- ['abc'].
}.

Výstup písať: ( Program nastavenie: ['abc'] ), nový-riadok.

# parametre nesmie GC uvoľniť
Program nastavenie: ([''] + V nový) hodnota: ([''] + V nový).

