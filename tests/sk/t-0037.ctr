>> a := 3.
>> b := a kopírovať.
a odčítať: 1.
Výstup písať: [' a = '] + a.
Výstup písať: [' b = '] + b.
a := 3.
b := a + 4.
Výstup písať: [' a = '] + a.
Výstup písať: [' b = '] + b.
>> x := 3.
>> y := x kopírovať.
x pridať: 10.
y odčítať: 1.
Výstup písať: [' x = '] + x.
Výstup písať: [' y = '] + y.
>> q := Objekt nový.
q pri: ['setProperty:'] urobiť: { :x
	vlastný vlast := x.
}.
q pri: ['získať-vlastnosť'] urobiť: { <- vlastný vlast.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Výstup písať: [' p = '] + (p získať-vlastnosť).
