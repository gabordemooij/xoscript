Zoznam pri: ['kopírovať'] urobiť: {
	>> kopírovať := Zoznam nový.
	seba každý: { :číslo :oddiel
		kopírovať pripojiť: oddiel rekurzívny kopírovať.
	}.
	<- kopírovať.
}.

>> ovca := Zoznam nový ; ['Dolly'] ; ['Shaun']. 
>> klony := ovca kopírovať.
klony každý: { :číslo :ovca
	ovca pripojiť: ['2'].
}.

Výstup písať: ovca, nový-riadok.
Výstup písať: klony, nový-riadok.
