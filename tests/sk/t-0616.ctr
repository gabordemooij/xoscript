Zoznam pri: ['kopírovať'] urobiť: {
	>> kopírovať := Zoznam nový.
	seba každý: { :číslo :section
		kopírovať pripojiť: section rekurzívny kopírovať.
	}. <- kopírovať.
}.

>> sheep := Zoznam nový ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep kopírovať.
clones každý: { :číslo :sheep
	sheep pripojiť: ['2'].
}.

Výstup písať: sheep, nový-riadok.
Výstup písať: clones, nový-riadok.
