>> HTML := Objekt nový.
HTML pri: ['odpovedať:'] urobiť: { :tag 
	Výstup písať: (['<tag>'] tag: tag), nový-riadok.
}.
HTML pri: ['odpovedať:a:'] urobiť: { :tag :html 
	Výstup písať: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), nový-riadok.
}.
>> html := HTML nový.
html body h1: ['header'].

