Výstup písať: ['Test object'], nový-riadok.
>> a := Objekt nový. 

a pri: ['item:'] urobiť: { :binhelper
	vlastný binhelper := binhelper. 
}.

a pri: ['item'] urobiť: { <- vlastný binhelper.
}.

a item: Bin nový.

>> old-binhelper-address := a item prototyp adresa-pamäte.
a save-as: ['/tmp/a.bin'].
Výstup písať: ['========== RELOADING SNAP:'], nový-riadok.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b item prototyp adresa-pamäte = old-binhelper-address) pravda: {
	Výstup písať: ['Object link re-attached.'], nový-riadok.
}.


