Výstup písať: ['Testovací objekt'], nový-riadok.
>> a := Objekt nový. 

a pri: ['item:'] urobiť: { :bin-pomocník
	vlastný bin-pomocník := bin-pomocník. 
}.

a pri: ['položka'] urobiť: {
	<- vlastný bin-pomocník.
}.

a item: Bin nový.

>> stará-adresa-bin-pomocníka := a položka prototyp adresa-pamäte.
a save-as: ['/tmp/a.bin'].
Výstup písať: ['========== OPÄTOVNÉ NAČÍTANIE SNÍMKY:'], nový-riadok.

>> b := Objekt load-from: ['/tmp/a.bin'].

(b položka prototyp adresa-pamäte = stará-adresa-bin-pomocníka) pravda: {
	Výstup písať: ['Odkaz na objekt znovu pripojený.'], nový-riadok.
}.


