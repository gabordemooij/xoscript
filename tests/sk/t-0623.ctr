

>> g  := Server nový.
>> v  := Trezor nový.
>> ok := 0.

>> tajnosti := Zoznam nový ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> heslá := tajnosti kopírovať.
heslá každý: { :i :p
	tajnosti každý: { :n :s
		{
			>> zašifrované := v šifrovať: s kľúč: p.
			>> dešifrované := v dešifrovať: zašifrované kľúč: p.
			(dešifrované = s) pravda: {
				ok pridať: 1.
			}, inak: {
				Výstup písať: ['šifrovanie/dešifrovanie zlyhalo: '], nový-riadok.
				Výstup písať: s, nový-riadok.
				Výstup písať: ['zašifrované: '] + zašifrované, nový-riadok.
				Výstup písať: ['dešifrované: '] + zašifrované, nový-riadok.
				Program koniec.
			}.
		} zachytiť: { :chyb
			(s = [''] alebo: p = ['']) pravda: {
				ok pridať: 1.
			}, inak: {
				Výstup písať: chyb, nový-riadok.
				Program koniec.
			}.
		}, spustiť.
	}.
}.

Výstup písať: ( ok + [' šifrovaní trezoru otestovaných.'] ), nový-riadok.