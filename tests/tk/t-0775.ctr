Çykyş ýaz: ['Test object'], täze-setir.
>> l := Sanaw täze ; 1 ; ( Sanaw täze ; (Pursat täze: 1) ; (Int64 tekstden: ['321']) ; (Sanaw täze ; 3)).
Çykyş ýaz: l, täze-setir.
>> old-lst-address := l prototip ýat-salgysy.
l save-as: ['/tmp/a.bin'].
Çykyş ýaz: ['========== RELOADING SNAP:'], täze-setir.
>> b := Obýekt load-from: ['/tmp/a.bin'].
(b prototip ýat-salgysy = old-lst-address) dogry: {
	Çykyş ýaz: ['Object link re-attached.'], täze-setir.
}.
Çykyş ýaz: b, täze-setir.
