>> Greeter := Obýekt täze.
Greeter gelende: ['make'] et: {
	>> greeter := Obýekt täze.
	greeter gelende: ['name:'] et: { :at
		Çykyş ýaz: ['setting a name'].
		öz myName := at.
	}.
	greeter gelende: ['performGreeting'] et: {
		Çykyş ýaz: ['Hello'].
		Çykyş ýaz: öz myName.
	}.
	greeter gelende: ['greet'] et: {
		özi performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
