# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Seýf açar-döret.

# private (secret) key
>> sk := keys birinji.

# public key
>> pk := keys soňky.

# sign a message
>> sig := Seýf gol-çek: ['abc'] açar-bilen: sk.

# check message (ok)
Çykyş ýaz: ( 
	Seýf
		barla: ['abc'] 
		gol: sig 
		açar-bilen: pk 
), täze-setir.

# check message (fail)
Çykyş ýaz: ( 
	Seýf 
		barla: ['abd'] 
		gol: sig 
		açar-bilen: pk 
), täze-setir.