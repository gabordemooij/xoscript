

>> Matryoshka := Obýekt täze.
Matryoshka gelende: ['double:'] et: { :secret
	öz secret := secret × 2.
}.
Matryoshka gelende: ['täze:'] et: { :secret
	>> answer := Boş.
	>> t := (secret > 255).
	Çykyş ýaz: (secret + [' | '] + t), täze-setir.
	t dogry: {
		answer := secret.
	}, ýogsa: {
		answer := Matryoshka rekursiw täze: (özi double: secret).
	}. <- answer.
}.

>> x := Matryoshka täze: 2.
