#Linux
>> clock := Pursat täze.
clock zona: ['UTC-1'].
clock ýyl: 1981, aý: 1, gün: 5,
      sagat: 13, minut: 15, sekunt: 13.

Çykyş ýaz: clock, täze-setir.
clock zona: ['UTC+0'].

Çykyş ýaz: (
	(clock ýyl ýönekeý) + ['-'] + (clock aý) + ['-'] + (clock gün) + [' '] +
	(clock sagat) + [':'] + (clock minut) + [':'] + (clock sekunt) + [' '] +
	['W'] + (clock hepde) + (clock zona)
), täze-setir.


clock zona: ['UTC-1'].
Çykyş ýaz: (
	(clock ýyl ýönekeý) + ['-'] + (clock aý) + ['-'] + (clock gün) + [' '] +
	(clock sagat) + [':'] + (clock minut) + [':'] + (clock sekunt) + [' '] +
	['W'] + (clock hepde) + (clock zona)
), täze-setir.
