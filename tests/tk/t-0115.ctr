{
	şu-wezipe ýalňyşlyk: ['Dont fail.'].
	unknown doSomething.
} tut: {
	Çykyş ýaz: ['Caught!'].
}, işlet.

{
	şu-wezipe ýalňyşlyk: ['Dont fail.'].
	öz unknown doSomething.
} tut: {
	Çykyş ýaz: ['Caught!'].
}, işlet.

{
	şu-wezipe ýalňyşlyk: ['Dont fail.'].
	unknown := 122.
} tut: {
	Çykyş ýaz: ['Caught!'].
}, işlet.


{
	şu-wezipe ýalňyşlyk: ['Dont fail.'].
	Dogry kes.
	Çykyş ýaz: ['FAIL'].
} tut: {
	Çykyş ýaz: ['Caught!'].
}, işlet.

{
	{
		şu-wezipe ýalňyşlyk: ['Dont fail.'].
		Dogry kes.
		Çykyş ýaz: ['FAIL'].
	} tut: { :x
		(x = ['Dont fail.']) dogry: { şu-wezipe ýalňyşlyk: ['Nested Caught!']. }.
	}, işlet.
} tut: { :e
	Çykyş ýaz: e.
}, işlet.
