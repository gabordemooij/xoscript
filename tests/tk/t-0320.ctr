


>> CoffeeMachine := Obýekt täze.
CoffeeMachine gelende: ['order:'] et: { :id
	>> coffee := ['Americano'].
	( id = 1 ) dogry: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) dogry: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) dogry: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Obýekt täze.
SimpleCoffeeMachine gelende: ['order'] et: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Çykyş ýaz: redCup, täze-setir.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Çykyş ýaz: greenCup, täze-setir.
>> yellowCup := CoffeeMachine order: 1.
Çykyş ýaz: yellowCup, täze-setir.
>> blueCup := CoffeeMachine order: 0.
Çykyş ýaz: blueCup, täze-setir.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Çykyş ýaz: blackCup, täze-setir.
blackCup soňuna-goş: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Çykyş ýaz: orangeCup, täze-setir.
