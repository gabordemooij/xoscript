# test list operations


>> cakes := Sanaw ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes çalyş: 1 uzynlyk: 2 bilen: ( Sanaw ← ['cinnamon'] ; ['pineapple'] ).
Çykyş ýaz: (buy birleşdir: [',']), täze-setir.


>> buy := cakes çalyş: 1 uzynlyk: 12 bilen: ( Sanaw ← ['cinnamon'] ; ['pineapple'] ).
Çykyş ýaz: (buy birleşdir: [',']), täze-setir.


>> buy := cakes çalyş: 2 uzynlyk: 10 bilen: ( Sanaw täze ).
Çykyş ýaz: (buy birleşdir: [',']), täze-setir.


>> buy := cakes çalyş: 0 uzynlyk: 1 bilen: ( Sanaw täze ).
Çykyş ýaz: (buy birleşdir: [',']), täze-setir.


>> buy := cakes çalyş: ['0'] uzynlyk: ['1'] bilen: ['x'].
Çykyş ýaz: (buy birleşdir: [',']), täze-setir.
