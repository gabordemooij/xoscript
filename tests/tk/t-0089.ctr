>> randomizer := { :a :b
	>> iň-kiçi := ( a < b ) ýa: a ýa-da: b.
	>> iň-uly := ( a > b ) ýa: a ýa-da: b.
	>> x := Boş.
	{
		x := San arasynda: a we: b.
		((x < iň-kiçi) ýa-da: (x > iň-uly)) dogry: { 
			Çykyş ýaz: (['Invalid value!']).
			Programma tamamla.
		}.
	} 
	× 100. <- x.
}.
