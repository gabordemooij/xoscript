

Tekst gelende: ['html'] et: { <- (
		özi
		çalyş: ['&'] bilen: ['&amp;'],
		çalyş: ['<'] bilen: ['&lt;'],
		çalyş: ['>'] bilen: ['&gt;'],
		çalyş: ['"'] bilen: ['&quot;']
	).
}.


Çykyş ýaz: ([' left trimmed '] gyrk) + [' '] + ( ['and right trimmed'] gyrk) + ['!'], täze-setir.
Çykyş ýaz: ['<html>"html & entities"</html>'] html.
