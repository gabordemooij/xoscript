>> To-Do := Obýekt täze.

To-Do gelende: ['täze'] et: {
	öz list := Sanaw täze.
}.

To-Do gelende: ['nieuw'] et: {
	öz list := Sanaw täze.
}.

To-Do gelende: ['+'] et: { :task
	öz list soňuna-goş: task.
}.

To-Do gelende: ['number of tasks?'] et: { <-  öz list sany.
}.

>> todos := 
	To-Do täze 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Çykyş ýaz: ['You have $ tasks to do'] $ todos number of tasks?.
