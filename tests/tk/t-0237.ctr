
Tekst gelende: ['evaluate'] et: {
	>> kod := Faýl täze: ['/tmp/eval.ctr'].
	kod ýaz: (özi tekst + ['.']).
	Programma peýdalan: ['/tmp/eval.ctr'].
}.

>> map :=
	(Sözlük täze)
	goý: ['Hi There'] açar: ['two'],
	goý: (Sanaw ← ['hello'] ; ['world'] ; (Sanaw ← 1 ; 2; 9) ; Ýalňyş) açar: ['one'],
	goý: ( (Sözlük täze) goý: ['wrrld'] açar: ['misspelled'] ) açar: ['three'],
	goý: (Sanaw ← ((Sözlük täze) goý: ['treasure'] açar: ['hidden']) ; 2) açar: ['four']. 
>> str := map tekst.
>> map2 := Boş.
(['map2 := '] + str ) evaluate.
Çykyş ýaz: map2 ? ['one'] ? 0.
Çykyş ýaz: map2 ? ['one'] ? 1.
Çykyş ýaz: map2 ? ['four'] ? 0 ? ['hidden'].
Çykyş ýaz: map2 ? ['one'] ? 2 ? 2.
