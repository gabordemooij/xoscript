Çykyş ýaz: ['Test object'], täze-setir.
>> cmd := Buýruk täze.
Çykyş ýaz: cmd ls /tmp, täze-setir.
>> old-cmd-address := cmd prototip ýat-salgysy.
cmd save-as: ['/tmp/a.bin'].
Çykyş ýaz: ['========== RELOADING SNAP:'], täze-setir.
>> b := Obýekt load-from: ['/tmp/a.bin'].
(b prototip ýat-salgysy = old-cmd-address) dogry: {
	Çykyş ýaz: ['Object link re-attached.'], täze-setir.
}.
Çykyş ýaz: b ls, täze-setir.


