>> Slurp := Obýekt täze.
Slurp gelende: ['täze'] et: {
	öz str := [''].
}.


Slurp gelende: ['jogap-ber:'] et: { :blah
		(öz str ≠ ['']) dogry: {
			öz str soňuna-goş: [' '].
		}.
		öz str soňuna-goş: blah.
}.
Slurp gelende: ['jogap-ber:we:'] et: { :blah :blahah
		(öz str ≠ ['']) dogry: {
			öz str soňuna-goş: [' '].
		}.
		(blah uzynlyk > 1) dogry: {
			öz str soňuna-goş: (blah başlap: 0 uzynlyk: (blah uzynlyk - 1)).
		}, ýogsa: {
			öz str soňuna-goş: blah.
		}.
		öz str soňuna-goş: [' '].
		öz str soňuna-goş: blahah.
}.
Slurp gelende: ['obtain'] et: {
	>> buffer := öz str.
	öz str := ['']. <- buffer.
}.

>> gözleg-parametrleri := Slurp täze.
gözleg-parametrleri select: ['*'], from users where: ['id = 2'].
Çykyş ýaz: (gözleg-parametrleri obtain), täze-setir.
