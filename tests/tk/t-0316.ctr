>> Grandfather := Obýekt täze.
Grandfather gelende: ['greet'] et: {
	Çykyş ýaz: ['Ave!'], täze-setir.
}.
>> Father := Grandfather täze.
Father gelende: ['greet'] et: {
	Çykyş ýaz: ['Hello'], täze-setir.
	özi greet.
}.
>> Son := Father täze.
Son gelende: ['greet'] et: {
	Çykyş ýaz: ['Hi'], täze-setir.
	özi greet.
}.

Son greet.

>> Roundabout := Obýekt täze.
Roundabout gelende: ['circle:'] et: { :x
	Çykyş ýaz: x, täze-setir.
	(x < 3) dogry: { özi rekursiw circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) dogry: { Çykyş ýaz: x, täze-setir. x goş: 1.  increment işlet. }. }.
increment işlet.