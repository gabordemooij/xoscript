Çykyş ýaz: ['Test object'], täze-setir.
>> a := Obýekt täze. 

a gelende: ['item:'] et: { :octhelper
	öz octhelper := octhelper. 
}.

a gelende: ['item'] et: { <- öz octhelper.
}.

a item: Oct täze.

>> old-octhelper-address := a item prototip ýat-salgysy.
a save-as: ['/tmp/a.bin'].
Çykyş ýaz: ['========== RELOADING SNAP:'], täze-setir.

>> b := Obýekt load-from: ['/tmp/a.bin'].

(b item prototip ýat-salgysy = old-octhelper-address) dogry: {
	Çykyş ýaz: ['Object link re-attached.'], täze-setir.
}.
