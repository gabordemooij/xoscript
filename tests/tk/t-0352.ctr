San gelende: ['roman'] et: {
	>> san := özi göçür.
	>> roman := [''].
	{
		{
			(san ≥ 1000) dogry: {
				roman soňuna-goş: ['Ⅿ'].
				san aýyr: 1000.
			}, kes.
		
			(san ≥ 500) dogry: {
				roman soňuna-goş: ['Ⅾ'].
				san aýyr: 500.
			}, kes.
		
			(san ≥ 100) dogry: {
				roman soňuna-goş: ['Ⅽ'].
				san aýyr: 100.
			}, kes.
		
			(san ≥ 50) dogry: {
				roman soňuna-goş: ['Ⅼ'].
				san aýyr: 50.
			}, kes.
		
			(san ≥ 50) dogry: {
				roman soňuna-goş: ['Ⅼ'].
				san aýyr: 50.
			}, kes.
		
			(san ≥ 10) dogry: {
				roman soňuna-goş: ['Ⅹ'].
				san aýyr: 10.
			}, kes.
			
			(san ≥ 9) dogry: {
				roman soňuna-goş: ['Ⅸ'].
				san aýyr: 9.
			}, kes.
			
			(san ≥ 5) dogry: {
				roman soňuna-goş: ['Ⅴ'].
				san aýyr: 5.
			}, kes.
			
			(san ≥ 4) dogry: {
				roman soňuna-goş: ['Ⅳ'].
				san aýyr: 4.
			}, kes.
			
			(san ≥ 1) dogry: {
				roman soňuna-goş: ['Ⅰ'].
				san aýyr: 1.
			}, kes.
		} prosedura.
	} dowamynda: { <- san > 0. }. <- roman.
}.

Çykyş ýaz: 1 roman, täze-setir.
Çykyş ýaz: 2 roman, täze-setir.
Çykyş ýaz: 4 roman, täze-setir.
Çykyş ýaz: 8 roman, täze-setir.
Çykyş ýaz: 16 roman, täze-setir.
Çykyş ýaz: 32 roman, täze-setir.
Çykyş ýaz: 64 roman, täze-setir.
Çykyş ýaz: 128 roman, täze-setir.
Çykyş ýaz: 256 roman, täze-setir.
Çykyş ýaz: 1024 roman, täze-setir.
