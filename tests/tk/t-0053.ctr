60 × {
	>> x := (San random % 6) + 1.
	(x ≤ 6) ýalňyş: { Çykyş ýaz: ['FAIL']. }.
	(x ≥0) ýalňyş: { Çykyş ýaz: ['FAIL']. }.
	x := (San random % 3) + 1.
	(x < 3) ýalňyş: { Çykyş ýaz: ['FAIL']. }.
	(x>-1) ýalňyş: { Çykyş ýaz: ['FAIL']. }.
	x := ((Logiki flip) san).
	(x = 0 ýa-da: x = 1) ýalňyş: { Çykyş ýaz: ['FAIL']. }.
	x := ((Dogry flip) san).
	(x = 0 ýa-da: x = 1) ýalňyş: { Çykyş ýaz: ['FAIL']. }.
	x := (Logiki flip ýa: ['HEAD'] ýa-da: ['TAIL']).
	((x = ['HEAD']) ýa-da: (x = ['TAIL'])) ýalňyş: { Çykyş ýaz: ['FAIL']. }.
}.
Çykyş ýaz: ['DONE'].

