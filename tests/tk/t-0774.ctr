Çykyş ýaz: ['Test object'], täze-setir.
>> a := Obýekt täze. 
a gelende: ['item:'] et: { :lst
	öz lst := lst. 
}.
a gelende: ['item'] et: { <- öz lst.
}.
a item: (
	Sanaw täze ; 1 ; (
		Sanaw täze ; ['a'] ; (
			Sanaw täze ; ( Pursat täze: 1 )
		) ; ( Int64 tekstden: ['321'] )
	)
).
Çykyş ýaz: a item, täze-setir.
>> old-lst-address := a item prototip ýat-salgysy.
a save-as: ['/tmp/a.bin'].
Çykyş ýaz: ['========== RELOADING SNAP:'], täze-setir.
>> b := Obýekt load-from: ['/tmp/a.bin'].
(b item prototip ýat-salgysy = old-lst-address) dogry: {
	Çykyş ýaz: ['Object link re-attached.'], täze-setir.
}.
Çykyş ýaz: ( b item ), täze-setir.
