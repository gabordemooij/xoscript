>> makeAdder := { :x
	>> f := { :y <- (öz x + y). } belle: ['x'] baha: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i öz q goý: (öz f ulan: (öz q ? i)) açar: i. } 
	belle: ['q'] baha: array,
	belle: ['f'] baha: func.
	{ :i mapping ulan: i. } × (array sany).
}.

>> a := Sanaw ← 1; 2; 3.
mapper ulan: a we: (makeAdder ulan: 100).
Çykyş ýaz: (a orun: 0), täze-setir.
Çykyş ýaz: (a ? 1), täze-setir.
Çykyş ýaz: (a ? 2), täze-setir.
