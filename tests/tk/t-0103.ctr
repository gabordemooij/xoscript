>> a := Sanaw ← Obýekt ; Dogry ; Ýalňyş ; Logiki ; 1 ; San ; ['Str'] ; Tekst ; { ['Empty']. }.
Çykyş ýaz: (a sany), täze-setir.
{ :i
	Çykyş ýaz: 
	['a '] + 
	((a ? i) görnüş) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Boş?) ýa: [''] ýa-da: ['NOT']) + 
	[' Nil.'],
	täze-setir.
} × (a sany).
Çykyş ýaz: ['but.. Nil is.. '] + ((Boş Boş?) ýa: ['certainly NIL!'] ýa-da: ['not NIL??']), täze-setir.