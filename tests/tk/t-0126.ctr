#Linux
>> Slurp := Obýekt täze.

Slurp gelende: ['täze'] et: {
	öz str := [''].
}.

Slurp gelende: ['nieuw'] et: {
	öz str := [''].
}.

Slurp gelende: ['jogap-ber:'] et: { :blah
		öz str soňuna-goş: blah.
}.

Slurp gelende: ['jogap-ber:we:'] et: { :blah :blahah
		öz str soňuna-goş: (blah başlap: 0 uzynlyk: (blah uzynlyk - 1)).
		öz str soňuna-goş: [' '].
		öz str soňuna-goş: blahah.
}.

Slurp gelende: ['obtain'] et: {
	>> buffer := öz str.
	öz str := ['']. <- buffer.
}.


Çykyş ýaz: (Programma ulgam: (Slurp täze echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Faýl täze: ['/tmp/from.txt'], poz. } tut: { ['Empty']. }, işlet.
{ Faýl täze: ['/tmp/to.txt'], poz. } tut: { ['Empty']. }, işlet.


Faýl täze: ['/tmp/to.txt'], bar ýalňyş: {
	Çykyş ýaz: ['Confirmed. Target file does not exist.\
'].
}.
Faýl täze: ['/tmp/from.txt'], bar ýalňyş: {
	Çykyş ýaz: ['Confirmed. Source file does not exist.\
'].
}.



Programma ulgam: (Slurp täze touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Programma ulgam: (Slurp täze cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Faýl täze: ['/tmp/to.txt'], bar dogry: {
	Çykyş ýaz: ['Confirmed. Target file has been created by shell.\
'].
}.


Çykyş ýaz: ['Contents of file is:'] + (Faýl täze: ['/tmp/to.txt'], oka), täze-setir.
