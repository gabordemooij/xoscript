

Tekst gelende: ['evaluate'] et: {
	>> kod := Faýl täze: ['/tmp/eval.ctr'].
	kod ýaz: (özi tekst + ['.']).
	Programma peýdalan: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Sanaw ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q tekst.
Çykyş ýaz: x, täze-setir.
>> y := Boş.
(['y := '] + x ) evaluate.
Çykyş ýaz: y ? 0, täze-setir.

q := Sözlük goý: ['\[''] açar: ['\['quote\']'].
x := q tekst.
Çykyş ýaz: x, täze-setir.
y := Boş.
(['y := '] + x ) evaluate.

>> q := (Sözlük täze) goý:['\[''] açar:['\['quote\[''].
Çykyş ýaz: y ? ['\['quote\']'], täze-setir.
