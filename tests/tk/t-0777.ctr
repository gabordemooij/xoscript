#OBSD
>> dirname := [''].
{ dirname soňuna-goş: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Programma ulgam: command.
Programma chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename soňuna-goş: ['YYYYYYYY']. } * 20.
Faýl täze: filename, ýaz: ['sometext'].
{ Faýl sanaw: ['/tmp/'] + dirname. } * 1000.
Çykyş ýaz: ['no crash'], täze-setir.

