
Tekst gelende: ['html'] et: { <- (
		özi
		çalyş: ['&'] bilen: ['&amp;'],
		çalyş: ['<'] bilen: ['&lt;'],
		çalyş: ['>'] bilen: ['&gt;'],
		çalyş: ['"'] bilen: ['&quot;']
	).
}.

>> HtmlBrush := Obýekt täze.

HtmlBrush gelende: ['jogap-ber:'] et: { :tag
	Çykyş ýaz: (['<tag>↵'] tag: tag ).
}.

HtmlBrush gelende: ['jogap-ber:we:'] et: { :tag :content
	tag := ( tag başlap: 0 uzynlyk: (tag uzynlyk - 1) ).
	Çykyş ýaz: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush gelende: ['content:'] et: { :text
	Çykyş ýaz: text html, täze-setir.
}.

HtmlBrush gelende: ['attr:value:'] et: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush täze.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
