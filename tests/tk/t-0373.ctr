# compliance test

# use international numbers

Çykyş ýaz: ['1000 -> '].
Çykyş ýaz: 1000, täze-setir. #1000

Çykyş ýaz: ['1.5 -> '].
Çykyş ýaz: 1.5, täze-setir.  #1.5

Çykyş ýaz: ['1001.5 -> '].
Çykyş ýaz: 1.5 + 1000, täze-setir. #1001.5

# use 0-indexed arrays
>> x := Sanaw täze ; 1 ; 2 ; 3.
>> y := Sanaw täze ; ['a'] ; ['b'] ; ['c'].

Çykyş ýaz: ['1 -> '].
Çykyş ýaz: x ? 0, täze-setir. #1

Çykyş ýaz: ['1 -> '].
Çykyş ýaz: (x ýerinde: 0), täze-setir. #1

Çykyş ýaz: ['1 -> '].
Çykyş ýaz: x birinji, täze-setir. #1

Çykyş ýaz: ['3 -> '].
Çykyş ýaz: x soňky, täze-setir. #3

Çykyş ýaz: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Çykyş ýaz: (x boýunça: y), täze-setir.

Çykyş ýaz: ['1 -> '].
Çykyş ýaz: (x başlap: 0 uzynlyk: 1) birinji, täze-setir. #1

Çykyş ýaz: ['0 -> '].
Çykyş ýaz: (x tap: 1), täze-setir. #0

x goý: 9 açar: 0.

Çykyş ýaz: ['9 -> '].
Çykyş ýaz: (x ýerinde: 0), täze-setir. #9

x başyna-goş: 8.
Çykyş ýaz: ['8 -> '].
Çykyş ýaz: (x ýerinde: 0), täze-setir. #9


x soňuna-goş: 10.
Çykyş ýaz: ['10 -> '].
