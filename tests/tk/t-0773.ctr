Çykyş ýaz: ['Test object'], täze-setir.
>> a := Obýekt täze. 
a gelende: ['item:'] et: { :int64
	öz int64 := int64. 
}.
a gelende: ['item'] et: { <- öz int64.
}.
a item: ( Int64 tekstden: ['9999'] ).
Çykyş ýaz: a item, täze-setir.
>> old-int64-address := a item prototip ýat-salgysy.
a save-as: ['/tmp/a.bin'].
Çykyş ýaz: ['========== RELOADING SNAP:'], täze-setir.
>> b := Obýekt load-from: ['/tmp/a.bin'].
(b item prototip ýat-salgysy = old-int64-address) dogry: {
	Çykyş ýaz: ['Object link re-attached.'], täze-setir.
}.
Çykyş ýaz: ( b item ), täze-setir.
