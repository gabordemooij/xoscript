>> map1 := Sözlük täze.
>> key1 := Sanaw täze.
>> key2 := Sanaw täze.

map1
	goý: ['hello'] açar: key1,
	goý: ['world'] açar: key2.


Çykyş
	ýaz: ['Map #1 contains: '] + (map1 ýerinde: key1),
	ýaz: [' and '] + (map1 ýerinde: key2), täze-setir.

>> KeyeableArray := Sanaw täze.
KeyeableArray gelende: ['toString'] et: { <- (özi sany) toString.
}.

>> map2 := Sözlük täze.
key1 := KeyeableArray täze.
key2 := KeyeableArray täze.

key1 soňuna-goş: 1.

map2
	goý: ['hello'] açar: key1,
	goý: ['world'] açar: key2.

Çykyş
	ýaz: ['Map #2 contains: '] + (map2 ýerinde: key1),
	ýaz: [' and '] + (map2 ýerinde: key2), täze-setir.
