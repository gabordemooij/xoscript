>> str := ['write:'].
Çykyş habar: ['ýaz:'] argumentler: (Sanaw ← ['Hello World']), täze-setir. 

San gelende: ['isbetween:and:'] et: { :a :b <- ((özi ≥ a) we: (özi ≤ b)).
}.

str := ['isbetween:and:'].
Çykyş ýaz: (3 habar: str argumentler: (Sanaw ← 2 ; 8)), täze-setir.
Çykyş ýaz: (3 habar: str argumentler: (Sanaw ← 1 ; 2)), täze-setir.


>> CoffeeMachine := Obýekt täze.
CoffeeMachine gelende: ['makeCoffeeWithSugar:milk:'] et: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Sanaw ← 4 ; 2.
Çykyş ýaz: ( CoffeeMachine habar: order argumentler: coffeeConfiguration ), täze-setir.
