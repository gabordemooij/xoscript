Server init.

>> DB := Maria-DB täze host: ['localhost'],
	ulanyjy-ady: ['xo'],
	parol: ['pass123'],
	binýat-ady: ['xobase'],
	birikdir.
	
>> SQL := ['SELECT "hello" AS "world" '].

