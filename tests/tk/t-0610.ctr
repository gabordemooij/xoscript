
>> Rectangle := Obýekt täze.

Rectangle gelende: ['area'] et: { <- öz uzynlyk * öz width.
}.

Rectangle gelende: ['length:'] et: { :uzynlyk
	öz uzynlyk := uzynlyk.
}.

Rectangle gelende: ['width:'] et: { :width
	öz width := width.
}.

Rectangle gelende: ['täze'] et: {
	# this will not result into an infinite loop
	>> rectangle := özi täze.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle täze.
Çykyş ýaz: a area, täze-setir. #0

>> b := Rectangle täze length: 2, width: 3.
Çykyş ýaz: b area, täze-setir. #6

