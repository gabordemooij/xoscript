

Sanaw gelende: ['sum'] et: {
	>> total := 0.
	özi her: { :index :element
		total goş: element.
	}. <- total.
}.

Sanaw gelende: ['product'] et: {
	>> total := 1.
	özi her: { :index :element
		total köpelt: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programma ýat-dolandyryş: 0.

{

>> a := Sanaw ← ['hello'] ; ['world'] ; Dogry ; Boş ; 666.
a := a + ( Sanaw ← 1 ).
Çykyş ýaz: ( ['sum: '] + ( a sum ) ), täze-setir.
Çykyş ýaz: ( ['min: '] + ( a iň-kiçi ) ), täze-setir.
Çykyş ýaz: ( ['max: '] + ( a iň-uly ) ), täze-setir.
Çykyş ýaz: ( ['3rd: '] + ( a ? 2 ) ), täze-setir.
Çykyş ýaz: ( ['prd: '] + ( a product ) ), täze-setir.
a tertiple: { :a :b <- (b - a). }.
a her: { :i :e Çykyş ýaz: ( i - 0 ), täze-setir. }.

} işlet.

Programma arassala.
usedMemory1 := (Programma ýat ? 0).


