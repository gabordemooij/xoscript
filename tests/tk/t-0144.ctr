



>> CoffeeGrounds := Obýekt täze.
CoffeeGrounds gelende: ['extract'] et: { <- ['coffee']. }.

>> CoffeeMachine := Obýekt täze.
CoffeeMachine gelende: ['init'] et: {
	öz coffeegrounds := CoffeeGrounds täze.
}.
CoffeeMachine gelende: ['täze'] et: { <- CoffeeMachine `new init.
}.

CoffeeMachine gelende: ['makeTea'] et: { <- (öz tealeaves extract). }.
CoffeeMachine gelende: ['makeCoffee'] et: { <- (öz coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine täze.

Çykyş ýaz:
	coffeeDream 
	makeCoffee.

Çykyş ýaz:
	coffeeDream 
	makeTea.
