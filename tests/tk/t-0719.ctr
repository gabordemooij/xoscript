Server init.
>> fmt := Format täze: ['%#3x'].

>> blob := Blob täze: 4.
blob bytes: ( 
	Sanaw täze ; 0 ; 1 ; 2 ; 3
).

>> file := Faýl täze: ['/tmp/blob'].
file blob: blob.
blob boşat.

>> oka := file blob.
oka 
başlap: 0 
uzynlyk: 4, 
et her: { :i :b 
	Çykyş
	ýaz: (fmt ulan-bitin: b),
	täze-setir.
}.
oka boşat.
