San gelende: ['factorial'] et: {
	>> total := 1.
	{ :index total köpelt: (özi - (index)). } × özi. <- total.
}.
>> Printer := Obýekt täze.
Printer gelende: ['print:and:'] et: { :x :y
	Çykyş ýaz: ['a='] + x + [', b='] + y, täze-setir.
}.
>> a := 4.5. >> b := a aşak-tegelekle.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a ýokary-tegelekle.
Printer print: a and: b.
a := 4.5. b := a aşak-tegelekle.
Printer print: a and: b.
a := 4.5. b := a tegelekle.
Printer print: a and: b.
a := 4.2. b := a tegelekle.
Printer print: a and: b.

Çykyş ýaz: (9 galyndy: 5), täze-setir.
Çykyş ýaz: -666 absolýut-baha, täze-setir.
Çykyş ýaz: 49 kwadrat-kök, täze-setir.
Çykyş ýaz: (2 dereje: 3), täze-setir.
>> l := (Sanaw ← 9 ; 6).
Çykyş ýaz: l iň-kiçi.

