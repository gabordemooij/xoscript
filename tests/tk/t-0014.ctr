>> Greeter := Obýekt täze.
Greeter gelende: ['make'] et: {
	>> gr := Obýekt täze.
	gr gelende: ['setName:'] et: { :aname
		öz at := aname.
	}.
	gr gelende: ['greet'] et: {
		Çykyş ýaz: öz at.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a täze.
c setName: ['THREE'].
c greet.
>> d := a täze.
d setName: ['FOUR'].
d greet.
c greet.
