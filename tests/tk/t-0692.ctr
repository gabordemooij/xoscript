Server init.

Çykyş ýaz: (
	Nusga täze: ['^\\w+$'],
	gabat-gelme: ['test@example.com'] 
), täze-setir. # 0 match, fails on @ and .

Çykyş ýaz: (
	Nusga täze: ['^[^@]+@[^\.]+\.\\w+$'],
	gabat-gelme: ['test@example.com'] 
), täze-setir. # 1 match

Çykyş ýaz: (
	Nusga täze: ['[^@]+@[^\.]+\.\\w+'],
	gabat-gelme: ['test@example.com'] 
), täze-setir. # 1 match

Çykyş ýaz: (
	Nusga täze: ['([^@]+)@([^\.]+)\.\\w+'],
	gabat-gelme: ['test@example.com'] 
), täze-setir. # 1 match, groups dont matter

Çykyş ýaz: (
	Nusga täze: ['[a-z]'],
	gabat-gelme: ['test@example.com'] 
), täze-setir. # 14 matches

Çykyş ýaz: (
	Nusga täze: ['.*'],
	gabat-gelme: ['test@example.com'] 
), täze-setir. # 1 match (all)

Çykyş ýaz: (
	Nusga täze: ['(.*)'],
	gabat-gelme: ['test@example.com'] 
), täze-setir. # 1 match (all)

Çykyş ýaz: (
	Nusga täze: ['\\s*[^@]+@[^\.]+\.\\w+'],
	gabat-gelme: ['test@example.com'] 
), täze-setir. # 1 match, prefix space optional, gets ignored