


>> Deck := Sanaw täze.
Deck gelende: ['print'] et: {
        >> len := özi sany - 1.
        { :i
                >> len2 := özi sany - 1.
                Çykyş ýaz: ['len: '].
                Çykyş ýaz: len, täze-setir.
                Çykyş ýaz: ['len2: '].
                Çykyş ýaz: len2, täze-setir.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
