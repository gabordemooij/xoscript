Çykyş ýaz: ['Test object'], täze-setir.
>> a := Obýekt täze. 

a gelende: ['item:'] et: { :out
	öz out := out. 
}.

a gelende: ['item'] et: { <- öz out.
}.

a gelende: ['greet'] et: {
	Çykyş ýaz: ['hi from original out!'], täze-setir.
}.

a item: Çykyş.

Çykyş ýaz: a item, täze-setir.

>> old-out-address := a item prototip ýat-salgysy.
a save-as: ['/tmp/a.bin'].
Çykyş ýaz: ['========== RELOADING SNAP:'], täze-setir.

>> b := Obýekt load-from: ['/tmp/a.bin'].

(b item prototip ýat-salgysy = old-out-address) dogry: {
	Çykyş ýaz: ['Object link re-attached.'], täze-setir.
}.

b item ýaz: ['hello from loaded out!'], täze-setir.
b greet.
