# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Seýf 
	parol-heşi: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Seýf 
	parol-heşi: hash barla: a1.
	# fail 
>> b := Seýf
	parol-heşi: hash barla: a2.
	# ok!

Çykyş ýaz: a, täze-setir.
Çykyş ýaz: b, täze-setir.

