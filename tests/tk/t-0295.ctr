
>> dictionary := (
	Sözlük täze
		goý: ['b'] açar: ['a'],
		goý: ['a'] açar: ['b'],
		goý: ['z'] açar: ['x'],
		goý: ['hello'] açar: ['hallo'],
		goý: ['human'] açar: ['human']
).

>> comparisons := Sanaw täze.
dictionary her: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a deňeşdir: b)
	).
}.

comparisons tertiple: { :a :b <- ( a deňeşdir: b ). }.
Çykyş ýaz: ( comparisons birleşdir: ['↵'] ), täze-setir.
comparisons birleşdir: ['↵'].
