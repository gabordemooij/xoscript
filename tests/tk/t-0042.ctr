>> items := Sözlük täze.
items goý: ['black'] açar: ['coffee'], goý: ['earl grey'] açar: ['tea'].
Çykyş ýaz: (items ýerinde: ['coffee']), ýaz: (items ýerinde: ['tea']).
Çykyş ýaz: ['there are'] + items sany + [' items in the array.'].
items goý: ['capuccino'] açar: ['coffee'].
Çykyş ýaz: ['Now my coffee is.. '] + (items ýerinde: ['coffee']).
items goý: ['aaa'] açar: ['1'].
items goý: ['bbb'] açar: ['2'].
Çykyş ýaz: (items ýerinde: ['a']).
