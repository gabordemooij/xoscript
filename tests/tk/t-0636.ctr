# test url parsing

Server init.
>> url := URL çeşme: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Çykyş ýaz: ['scheme = '] + url shema, täze-setir.
Çykyş ýaz: ['host = '] + url host, täze-setir.
Çykyş ýaz: ['port = '] + url port, täze-setir.
Çykyş ýaz: ['path = '] + url ýol, täze-setir.
Çykyş ýaz: ['query = '] + url gözleg-parametrleri, täze-setir.
Çykyş ýaz: ['fragment = '] + url bölek, täze-setir.
