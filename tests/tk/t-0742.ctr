Çykyş ýaz: ['Test object'], täze-setir.
>> a := Obýekt täze. 

a gelende: ['item:'] et: { :hexhelper
	öz hexhelper := hexhelper. 
}.

a gelende: ['item'] et: { <- öz hexhelper.
}.

a item: Hx täze.

>> old-hexhelper-address := a item prototip ýat-salgysy.
a save-as: ['/tmp/a.bin'].
Çykyş ýaz: ['========== RELOADING SNAP:'], täze-setir.

>> b := Obýekt load-from: ['/tmp/a.bin'].

(b item prototip ýat-salgysy = old-hexhelper-address) dogry: {
	Çykyş ýaz: ['Object link re-attached.'], täze-setir.
}.
