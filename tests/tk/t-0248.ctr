

Tekst gelende: ['evaluate'] et: {
	>> kod := Faýl täze: ['/tmp/eval.ctr'].
	kod ýaz: özi tekst + ['.'].
	Programma peýdalan: ['/tmp/eval.ctr'].
}.

>> a := (Sanaw ← (
	(Sözlük täze)
		goý: ['domain'] açar: ['mywebsite.com'],
		goý: (Sanaw ←
			((Sözlük täze)
				goý: ['home'] açar: ['title'],
				goý: ['<html></html>'] açar: ['body'],
				goý: ['2017-01-01'] açar: ['created']
			) ;
			((Sözlük täze)
				goý: ['aboutus(c)'] açar: ['title'],
				goý: ['<credits>Author Inc.</credits>'] açar: ['body']
			)
		) açar: ['pages']
	)
) tekst.

Çykyş ýaz: a görnüş, täze-setir.
Çykyş ýaz: a, täze-setir.

>> b := Boş.
(['b := '] + a) evaluate.
Çykyş ýaz: b ? 0 ? ['pages'] ? 1 ? ['body'], täze-setir.

>> c := b ? 0.
>> d := c tekst.
Çykyş ýaz: d görnüş, täze-setir.

>> e := Boş.
(['e := '] + d) evaluate.
Çykyş ýaz: e ? ['pages'] ? 0, täze-setir.
