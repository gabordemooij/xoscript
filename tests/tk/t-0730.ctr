Çykyş ýaz: ['Test object'], täze-setir.
>> a := Obýekt täze. 

a gelende: ['item:'] et: { :moment
	öz moment := moment. 
}.

a gelende: ['item'] et: { <- öz moment.
}.

>> today := Pursat täze zona: ['CEST'], ýyl: 2026, aý: 7.
a item: today.
Çykyş ýaz: a item, täze-setir.
a save-as: ['/tmp/a.bin'].
Çykyş ýaz: ['========== RELOADING SNAP:'], täze-setir.
>> b := Obýekt load-from: ['/tmp/a.bin'].
Çykyş ýaz: b item, täze-setir.
