Çykyş ýaz: ['Test object'], täze-setir.
>> greeter := Obýekt täze.
greeter gelende: ['name:'] et: { :at
	öz xname := at. 
}.
greeter gelende: ['greet'] et: {
	Çykyş ýaz: ['Hello '] + öz xname, täze-setir.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Çykyş ýaz: ['========== RELOADING SNAP:'], täze-setir.
>> b := Obýekt load-from: ['/tmp/a.bin'].
>> c := Obýekt load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
