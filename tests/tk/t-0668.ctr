# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob täze: 8, bytes: (
	Sanaw täze ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Çykyş ýaz: ( utf16 kody-aç: ['utf16le'] ), täze-setir.

utf16 boşat.
>> utf32 := Blob täze: 13, bytes: (
	Sanaw täze ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Çykyş ýaz: ( utf32 kody-aç: ['utf32be'] ), täze-setir.
utf32 boşat.