Çykyş ýaz: ['Continue for-loop, No - before 6 and up.'], täze-setir.
{ :i
	Çykyş ýaz: (i + 1), täze-setir.
	((i + 1) > 4) dowam-et.
	Çykyş ýaz: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Çykyş täze-setir.
Çykyş ýaz: ['Continue while-true, No --> before 5 and up.'], täze-setir.
{
	Çykyş ýaz: ['iteration #'] + x, täze-setir.
	x goş: 1.
	((x < 5) däl) dowam-et.
	Çykyş ýaz: ['-->'].
} dowamynda: xIsLessThan10.
Çykyş täze-setir.
Çykyş ýaz: ['Continue while-false, No - before 3 only.'], täze-setir.
{
	Çykyş ýaz: ['iteration #'] + x, täze-setir.
	x aýyr: 1.
	(x = 3) dowam-et.
	Çykyş ýaz: ['-'].
} dowamynda: { <- ( x > 0). }.

Çykyş täze-setir.
Çykyş ýaz: ['Continue times-loop, No ||| before 3.'], täze-setir.
{ :i
	Çykyş ýaz: ['iteration #'] + i, täze-setir.
	(i = 2) dowam-et.
	Çykyş ýaz: ['|||'].
} × 5.

Çykyş täze-setir.

{ Dogry dowam-et. Çykyş ýaz: ['dont write this!'], täze-setir. } işlet.

{ Dogry dowam-et. Çykyş ýaz: ['dont write this!'], täze-setir. } tut: { Çykyş ýaz: ['Dont catch this!']. }, işlet.

Çykyş ýaz: ['Test Array each-loop: 0, ... ,2'], täze-setir.
(Sanaw ← 1 ; 2 ; 3) öwür: { :i
	(i = 1) dowam-et.
	Çykyş ýaz: ['iteration #'] + (i - 0), täze-setir.
}.

Çykyş ýaz: ['Test Map each-loop: c only'], täze-setir.
>> m := Sözlük täze.
m goý: ['first'] açar: ['a'], goý: ['second'] açar: ['b'], goý: ['third'] açar: ['c'].
m her: { :k :v
	(k ≠ ['c']) dowam-et.
	Çykyş ýaz: ['iteration'] + k + v, täze-setir.
}.

