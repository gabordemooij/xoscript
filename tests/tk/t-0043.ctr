>> repeater := Obýekt täze.
repeater gelende: ['jogap-ber:'] et: { :what
	Çykyş ýaz: what + [' '].
}.
repeater gelende: ['jogap-ber:we:'] et: { :what :say
	Çykyş ýaz: what, ýaz: say + [' '].
}.
repeater gelende: ['jogap-ber:we:we:'] et: { :what :say :more
	Çykyş ýaz: what, ýaz: say, ýaz: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
