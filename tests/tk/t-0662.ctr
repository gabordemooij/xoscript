>> t := Boş.

# you can control the time zone for
# parsing like this:
Pursat zona: ['CET'].
t := Pursat çeşme: ['1981-02-03 04:05:06'].
Çykyş ýaz: t, täze-setir.

# now using CEST time zone:
Pursat zona: ['CEST'].
t := Pursat çeşme: ['1981-02-03 04:05:06'].
Çykyş ýaz: t, täze-setir.

# error if string cannot be parsed
{ Pursat çeşme: ['1900']. } tut: { Boş. }, işlet.
