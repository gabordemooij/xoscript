Sanaw gelende: ['sum'] et: {
	>> total := 0.
	özi her: { :index :element
		total goş: element.
	}. <- total.
}.

>> a := Dogry.



a gelende: ['tekst'] et: {
	>> answer := Boş.
	( özi = Dogry ) dogry: {
		answer := ['Yep'].
	}, ýogsa: {
		answer := ['Nope'].
	}. <- answer.
}.

a gelende: ['san'] et: {
	>> answer := Boş.
	( özi = Dogry ) dogry: {
		answer := 10.
	}, ýogsa: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b gelende: ['tekst'] et: { <- ['Devil'].
}.

b gelende: ['logiki'] et: { <- Ýalňyş.
}.


Çykyş ýaz: a, täze-setir.  
Çykyş ýaz: (90 + a), täze-setir. 
Çykyş ýaz: b, täze-setir. 
Çykyş ýaz: (Dogry we: b), täze-setir.

a := Sanaw ← ['hello'] ; ['world'] ; Dogry ; Boş ; 666. 
a := a + ( Sanaw ← 1 ).
Çykyş ýaz: a, täze-setir.
Çykyş ýaz: ((Sözlük täze) goý: Boş açar: Boş), täze-setir.
Çykyş ýaz: a sum, täze-setir. 


{
	a gelende: ['tekst'] et: { <- Boş. }.
	a := [''] + a.
} tut: { :error
	Çykyş ýaz: ['Error noted: '] + error, täze-setir.
}, işlet.



