# test number -> string -> number
{

	>> x := San arasynda: 0 we: 1000000.
	>> d := San arasynda: 1 we: 7.
	>> e := 10 dereje: d.

	x böl-sana: e.
	>> y := x tekst san.

	(x = y) ýalňyş: {
		Çykyş ýaz: x, täze-setir.
		Çykyş ýaz: y, täze-setir.
		Programma tamamla.
	}.

} * 1000.
Çykyş ýaz: ['OK'], täze-setir.