# test catch-all methods
>> x13 := Obýekt täze.
x13 gelende: ['a'] et: { :a Çykyş ýaz: 0, täze-setir. }.
x13 gelende: ['a:'] et: { :a Çykyş ýaz: a, täze-setir. <- 5. }.
x13 gelende: ['a:b:'] et: { :a :b Çykyş ýaz: (a + b), täze-setir. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
