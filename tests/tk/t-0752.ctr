Çykyş ýaz: ['Test object'], täze-setir.
>> a := Obýekt täze. 

a gelende: ['item:'] et: { :logiki
	öz logiki := logiki. 
}.

a gelende: ['item'] et: { <- öz logiki.
}.

a item: Logiki.

Çykyş ýaz: a item, täze-setir.

>> old-bool-address := a item prototip ýat-salgysy.
a save-as: ['/tmp/a.bin'].
Çykyş ýaz: ['========== RELOADING SNAP:'], täze-setir.

>> b := Obýekt load-from: ['/tmp/a.bin'].

(b item prototip ýat-salgysy = old-bool-address) dogry: {
	Çykyş ýaz: ['Object link re-attached.'], täze-setir.
}.

Çykyş ýaz: b item, täze-setir.
