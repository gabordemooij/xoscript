# backslashes must survive code serialization, strings must not end early
>> bahalar := Sanaw täze
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

bahalar her: { :i :value
	>> d := Sözlük täze.
	d goý: value açar: ['k'].
	>> r := d kod obýekt.
	Çykyş ýaz: r sany, täze-setir.
	Çykyş ýaz: ( (r ýerinde: ['k']) = value ), täze-setir.
}.
