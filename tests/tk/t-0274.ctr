

Sanaw gelende: ['column:'] et: { :column
	>> result := Sanaw täze.
	özi her: { :index :row
		row her: { :index :cell
			(index = column) dogry: { result soňuna-goş: cell. }.
		}.
	}. <- result.
}.


>> a := Sanaw ←
	(Sanaw ← 1 ; 2 ; 3) ;
	(Sanaw ← 4 ; 5 ; 6) ;
	(Sanaw ← 7 ; 8 ; 9).

>> b := a column: 1.
Çykyş ýaz: b, täze-setir.

b := a column: 20.
Çykyş ýaz: b, täze-setir.

b := a column: -100.
Çykyş ýaz: b, täze-setir.
