Server init.

# write a test file
>> f := Faýl täze: ['/tmp/test.gif'].
f ýaz: ['GIF87a01234567810'].

# serve the file
Server geçir: ['test.gif'] prefiks: ['/tmp/'].

Çykyş täze-setir.

Çykyş ýaz: ['Outside container (security):'], täze-setir.
{ Server geçir: ['../passwd'] prefiks: ['/tmp/']. }
tut: { :e Çykyş ýaz: e, täze-setir. },
işlet.

Çykyş ýaz: ['Invalid prefix:'], täze-setir.
{ Server geçir: ['test.gif'] prefiks: ['z:\\']. }
tut: { :e Çykyş ýaz: e, täze-setir. },
işlet.

Çykyş ýaz: ['Non-existant file:'], täze-setir.
{ Server geçir: ['xxx.xxx'] prefiks: ['/tmp/']. }
tut: { :e Çykyş ýaz: e, täze-setir. },
işlet.
