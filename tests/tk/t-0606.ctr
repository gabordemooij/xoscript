>> Point := Obýekt täze.
Point gelende: ['x-coordinate:'] et: { :x öz x := x. }.
Point gelende: ['y-coordinate:'] et: { :y öz y := y. }.
Point gelende: ['x-coordinate']  et: { <- öz x göçür. }.
Point gelende: ['y-coordinate']  et: { <- öz y göçür. }.

Point gelende: ['='] et: { :other <- ( öz x = other x-coordinate
		 we: öz y = other y-coordinate ).
}.

>> pier := Point täze x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point täze x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point täze x-coordinate: 5, y-coordinate: 6.

Çykyş ýaz: pier = town-hall, täze-setir.
Çykyş ýaz: pier = restaurant, täze-setir.
