
Çykyş ýaz: ['Break for-loop, 0-4.'], täze-setir.
{ :i
	Çykyş ýaz: ['iteration #'] + i, täze-setir.
	(i = 4) kes.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Çykyş ýaz: ['Break while-true loop, 0-4.'], täze-setir.
{
	Çykyş ýaz: ['iteration #'] + x, täze-setir.
	x goş: 1.
	((x < 5) däl) kes.
} dowamynda: xIsLessThan10.

Çykyş ýaz: ['Break while-false loop, 5,4.'], täze-setir.
{
	Çykyş ýaz: ['iteration #'] + x, täze-setir.
	x aýyr: 1.
	(x = 3) kes.
} dowamynda: { <- (x > 0). }.

Çykyş ýaz: ['Break times loop, 1-4.'], täze-setir.
{ :i
	Çykyş ýaz: ['iteration #'] + i, täze-setir.
	(i = 4) kes.
} × 5.

Çykyş ýaz: ['Break block, dont print line.'], täze-setir.
{ Dogry kes. Çykyş ýaz: ['dont write this!'], täze-setir. } işlet.

Çykyş ýaz: ['Break block, dont fire catch...'], täze-setir.
{ Dogry kes. Çykyş ýaz: ['dont write this!'], täze-setir. } tut: { Çykyş ýaz: ['Dont catch this!']. }, işlet.

Çykyş ýaz: ['Test Array each-loop: 0,1'], täze-setir.
(Sanaw ← 1 ; 2 ; 3) öwür: { :i
	Çykyş ýaz: ['iteration #'] + i, täze-setir.
	(i = 1) kes.
}.

Çykyş ýaz: ['Test Map each-loop: c only'], täze-setir.
>> m := Sözlük täze.
m goý: ['first'] açar: ['a'], goý: ['second'] açar: ['b'], goý: ['third'] açar: ['c'].
m her: { :k :v
	Çykyş ýaz: ['iteration'] + v + k, täze-setir.
	Dogry kes.
}.

