>> Animal := Obýekt täze.
Animal gelende: ['make'] et: {
	>> animal := Obýekt täze.
	animal gelende: ['makeSound'] et: {
		Çykyş ýaz: öz sound.
	}. <- animal.
}.
>> Cat := Obýekt täze.
Cat gelende: ['make'] et: {
	>> cat := Animal make.
	cat gelende: ['init'] et: {
		öz sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
