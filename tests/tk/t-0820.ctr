# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Nusga täze: pattern.
	p gabat-gelme: subject et: { :m :g
		Çykyş ýaz: g sany, ýaz: [' '], ýaz: (g birleşdir: ['|']), täze-setir. <- m.
	}.
}.
show ulan: ['(a)|(b)'] we: ['b'].
show ulan: ['(a)|(b)'] we: ['a'].
show ulan: ['(x)?y'] we: ['y'].
show ulan: ['(x)?(y)(z)?'] we: ['xy'].
