
Server init.
>> rq := HTTP-Haýyş täze.
Çykyş ýaz: ['HTTP-GET d[]=']  + ( rq get-sanaw: ['d[]'] ), täze-setir. # GET
Çykyş ýaz: ['HTTP-GET f[]=']  + ( rq get-sanaw: ['f[]'] ), täze-setir. # GET
Çykyş ýaz: ['HTTP-POST e[]='] + ( rq post-sanaw: ['e[]'] ), täze-setir. # GET
Çykyş ýaz: ['HTTP-POST c=']   + ( rq post: ['c'] ), täze-setir. # GET
Çykyş ýaz: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), täze-setir. # GET
