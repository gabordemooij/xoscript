Çykyş ýaz: ['Test object'], täze-setir.
>> a := Obýekt täze. 

a gelende: ['item:'] et: { :fmt
	öz fmt := fmt. 
}.

a gelende: ['item'] et: { <- öz fmt.
}.

a item: ( Format täze: ['|%s|'] ).

Çykyş ýaz: a item, täze-setir.

>> old-fmt-address := a item prototip ýat-salgysy.
a save-as: ['/tmp/a.bin'].
Çykyş ýaz: ['========== RELOADING SNAP:'], täze-setir.

>> b := Obýekt load-from: ['/tmp/a.bin'].

(b item prototip ýat-salgysy = old-fmt-address) dogry: {
	Çykyş ýaz: ['Object link re-attached.'], täze-setir.
}.

Çykyş ýaz: ( b item ulan: ['hello'] ), täze-setir.
