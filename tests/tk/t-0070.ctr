>> numbers := ['1,2,3'] böl: [','].
Çykyş ýaz: ['I got: '] + numbers sany + [' numbers.'],täze-setir.
{ :i Çykyş ýaz: ['number #'] + i + [':'] + (numbers orun: i), täze-setir.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages böl: [' Or '].
Çykyş ýaz: ['We serve'], täze-setir.
{ :i Çykyş ýaz: ['->'] + (beverages orun: i), täze-setir. } × (beverages sany).
Çykyş ýaz: (beverages birleşdir: [',']), täze-setir.
Çykyş ýaz: (numbers birleşdir: ['||']).
