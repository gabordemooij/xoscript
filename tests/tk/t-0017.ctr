San gelende: ['factorial'] et: {
	>> total := 1.
	{ :index total köpelt: (özi - (index)). } × özi. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Çykyş ýaz: a.
>> b := 2 + 3 factorial.
Çykyş ýaz: b.
>> c := 3 factorial + 2.
Çykyş ýaz: c.
>> d := 2 + (3 factorial).
Çykyş ýaz: d.
Çykyş ýaz: 2 + 3 factorial + 1.
