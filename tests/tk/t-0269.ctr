#Linux

(Faýl täze: ['/tmp/testje']) bar ýalňyş: {
	Programma ulgam: ['mkdir /tmp/testje'].	
}.

(Faýl täze: ['/tmp/testje/file1']) bar ýalňyş: {
	Programma ulgam: ['touch /tmp/testje/file1'].	
}.

(Faýl täze: ['/tmp/testje/folder1']) bar ýalňyş: {
	Programma ulgam: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Faýl sanaw: ['/tmp/testje'].

>> q := Sanaw täze.

l her: { :k :v v her: { :x :y q soňuna-goş: y. }. }.

>> s := q tekst.

(s öz-içine-alýar: ['file1']) dogry:   { Çykyş ýaz: ['OK'], täze-setir. }.
(s öz-içine-alýar: ['file2']) dogry:   { Çykyş ýaz: ['XX'], täze-setir. }.
(s öz-içine-alýar: ['folder1']) dogry: { Çykyş ýaz: ['OK'], täze-setir. }.
