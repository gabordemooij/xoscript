#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Nusga täze: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern gabat-gelme: subject et: { :m :x
	Çykyş ýaz: m, täze-setir.
	Çykyş ýaz: x, täze-setir. <- ['XXX'].
}.
Çykyş ýaz: result, täze-setir.