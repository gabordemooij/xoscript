# catch-all test (practical)
>> HTML := Tekst täze.
HTML gelende: ['encode:'] et: { :tekst
	özi soňuna-goş: (tekst
	çalyş: ['&'] bilen: ['&amp;'], 
	çalyş: ['<'] bilen: ['&lt;'],
	çalyş: ['>'] bilen: ['&gt;'],
	çalyş: ['"'] bilen: ['&quot;']).
}.
>> blog := HTML täze.
blog soňuna-goş: ['<h1>'],
     encode: ['Koffie & Thee'],
     soňuna-goş: ['</h1>'].
Çykyş ýaz: blog, täze-setir.


>> Roman := San täze.
Roman gelende: ['stringy'] et: {
	>> a := [''].
	{ a soňuna-goş: ['I']. } × özi. <- a.
}.

>> x := Roman täze.
x goş: 3.
Çykyş ýaz: x stringy, täze-setir.

>> Quantum := Logiki täze.
Quantum gelende: ['true?'] et: { <- ['maybe True']. }.
Çykyş ýaz: (Quantum täze true?), täze-setir.

>> Nihil := Boş täze.
Nihil gelende: ['tekst'] et: { <- ['Nihil']. }.
Çykyş ýaz: (Nihil täze), täze-setir.
