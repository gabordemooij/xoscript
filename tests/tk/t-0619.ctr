>> HTML := Obýekt täze.
HTML gelende: ['jogap-ber:'] et: { :tag 
	Çykyş ýaz: (['<tag>'] tag: tag), täze-setir.
}.
HTML gelende: ['jogap-ber:we:'] et: { :tag :html 
	Çykyş ýaz: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), täze-setir.
}.
>> html := HTML täze.
html body h1: ['header'].

