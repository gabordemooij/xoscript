Logiki gelende: ['xor:'] et: { :a :b <- ((a we: b däl) ýa-da: (a däl we: b)).
}.

>> o := Obýekt täze.
o gelende: ['hello'] et: { ['Empty']. }.
{ o gelende: 2 et: 3.} tut: { :e Çykyş ýaz: e, täze-setir. }, işlet.
{ o gelende: ['synag'] et: 3.} tut: { :e Çykyş ýaz: e, täze-setir. }, işlet.
{ o gelende: ['hello'] et: { ['Empty']. }.} tut: { :e Çykyş ýaz: e, täze-setir. }, işlet. 
{ >> z := 4 ÷ 0. } tut: { :e Çykyş ýaz: e, täze-setir. }, işlet. 
{ (Dogry we: Boş) dogry: { Çykyş ýaz: ['X'].}. } tut: { :e Çykyş ýaz: e, täze-setir. }, işlet. 
{ ([''] xor: 0) dogry: { Çykyş ýaz: ['X'].}. } tut: { :e Çykyş ýaz: e, täze-setir. }, işlet. 
{ (1 < ['2']) dogry: { Çykyş ýaz: ['OK']. }. } tut: { :e Çykyş ýaz: e, täze-setir. }, işlet. 
{ (1 < ['2.0']) dogry: { Çykyş ýaz: ['OK']. }. } tut: { :e Çykyş ýaz: e, täze-setir. }, işlet. 
{ (1 < ['x2.0']) dogry: { Çykyş ýaz: ['NO!']. }. } tut: { :e Çykyş ýaz: e, täze-setir. }, işlet. 
{ Çykyş ýaz: (['hello OK there'] başlap: ['6'] uzynlyk: ['2']). } işlet. 
