# a value ending in the first part of an opening quote must survive serialization
>> bahalar := Sanaw täze
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

bahalar her: { :i :value
	>> d := Sözlük täze.
	d goý: value açar: ['k'].
	d goý: ['second'] açar: ['j'].
	>> r := d kod obýekt.
	Çykyş ýaz: r sany, täze-setir.
	Çykyş ýaz: ( (r ýerinde: ['k']) = value ), täze-setir.
}.
