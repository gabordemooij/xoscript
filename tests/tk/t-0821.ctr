# a quote that never closes must give an error, not an endless loop
>> ýol := ['/tmp/test0821.csv'].
>> file := Faýl täze: ýol.

file ýaz: ['a,b\n"1,2\n'].
{
	file bölüji: [','] goşa-dyrnak: ['"'] setirler: { :line
		Çykyş ýaz: line, täze-setir.
	}.
} tut: { :e Çykyş ýaz: e, täze-setir. }, işlet.

# a closed quote still works
file ýaz: ['a,b\n"1,2",3'].
file bölüji: [','] goşa-dyrnak: ['"'] setirler: { :line
	Çykyş ýaz: line, täze-setir.
}.
file poz.
