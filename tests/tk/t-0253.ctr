#Linux
>> OS := Programma sazlama: ['OS'].

>> clock := Pursat täze.
	
(OS = ['Haiku']) dogry: {
	clock zona: ['CET'],
	ýyl: 2017, aý: 7, gün: 13,
	sagat: 18, minut: 0, sekunt: 0.
}, ýogsa: {
	clock zona: ['Europe/Amsterdam'],
	ýyl: 2017, aý: 7, gün: 13,
	sagat: 18, minut: 0, sekunt: 0.
}.

clock gelende: ['tell'] et: {
	Çykyş ýaz: özi, täze-setir.
}.


clock goş: 2    sagat, tell.
clock goş: 1    sagat, tell.
clock goş: 19 minut, tell.
clock goş: 1  minut, tell.
clock goş: 1  minut, tell.
clock goş: 19 sekunt, tell.
clock goş: 1  sekunt, tell.
clock goş: 1  sekunt, tell.
clock goş: 2    ýyl, tell.
clock goş: 1    ýyl, tell.

(OS = ['Haiku']) dogry: {
clock goş: 5   aý.
clock zona: ['CEST'], tell.
}, ýogsa: {
	clock goş: 5   aý, tell.
}.

