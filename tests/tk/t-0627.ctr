

# create a 64-bit integer for exact calculations
>> a := Int64 tekstden: ['123'].

# to string
Çykyş ýaz: a, täze-setir.

# divide
Çykyş ýaz: a / (Int64 tekstden: ['3']), täze-setir.

# multiply
Çykyş ýaz: a * (Int64 tekstden: ['2']), täze-setir.

# add
Çykyş ýaz: a + (Int64 tekstden: ['1']), täze-setir.

# subtract
Çykyş ýaz: a - (Int64 tekstden: ['2']), täze-setir.

# compare
Çykyş ýaz: ( a =   (Int64 tekstden: ['123'])), täze-setir.
Çykyş ýaz: ( a !=: (Int64 tekstden: ['124'])), täze-setir.
Çykyş ýaz: ( a <   (Int64 tekstden: ['124'])), täze-setir.
Çykyş ýaz: ( a >   (Int64 tekstden: ['122'])), täze-setir.
Çykyş ýaz: ( a >=: (Int64 tekstden: ['123'])), täze-setir.
Çykyş ýaz: ( a <=: (Int64 tekstden: ['123'])), täze-setir.





	