>> a := 3.
>> b := a göçür.
a aýyr: 1.
Çykyş ýaz: [' a = '] + a.
Çykyş ýaz: [' b = '] + b.
a := 3.
b := a + 4.
Çykyş ýaz: [' a = '] + a.
Çykyş ýaz: [' b = '] + b.
>> x := 3.
>> y := x göçür.
x goş: 10.
y aýyr: 1.
Çykyş ýaz: [' x = '] + x.
Çykyş ýaz: [' y = '] + y.
>> q := Obýekt täze.
q gelende: ['setProperty:'] et: { :x
	öz prop := x.
}.
q gelende: ['getProperty'] et: { <- öz prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Çykyş ýaz: [' p = '] + (p getProperty).
