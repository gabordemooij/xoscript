Server init.
>> f := Format täze: ['%d'].
>> a := Blob täze: 4.
a bytes: ( Sanaw täze ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob täze: 4.
b bytes: ( Sanaw täze ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a başlap: 0 uzynlyk: 3, her: { :i :byte
	Çykyş ýaz: ( f ulan-bitin: byte ), täze-setir.
}.
a ^ b.
a başlap: 0 uzynlyk: 3, her: { :i :byte
	Çykyş ýaz: ( f ulan-bitin: byte ), täze-setir.
}.
a ^ b.
a başlap: 0 uzynlyk: 3, her: { :i :byte
	Çykyş ýaz: ( f ulan-bitin: byte ), täze-setir.
}.
a boşat.
b boşat.

{ a ^ Obýekt. } tut: { :e Çykyş ýaz: e, täze-setir. }, işlet.
