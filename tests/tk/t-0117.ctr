>> t := Dogry.
(t = Dogry) dogry: { Çykyş ýaz: ['T']. }.
(t = Ýalňyş) dogry: { Çykyş ýaz: ['F']. }.
Çykyş ýaz: ['|'].
>> t := Ýalňyş.
(t = Dogry) dogry: { Çykyş ýaz: ['T']. }.
(t = Ýalňyş) dogry: { Çykyş ýaz: ['F']. }.
Çykyş ýaz: ['|'].
>> f := Dogry.
(t = Dogry we: f = Ýalňyş) dogry: { Çykyş ýaz: ['T']. }.
(t = Ýalňyş we: f = Dogry) dogry: { Çykyş ýaz: ['F']. }.
Çykyş ýaz: ['|'].
>> n := Boş.
(n Boş?) dogry: { Çykyş ýaz: ['T']. }.
(n Boş?) ýalňyş: { Çykyş ýaz: ['F']. }.
Çykyş ýaz: ['|'].
(f Boolean?) dogry: { Çykyş ýaz: ['T']. }.
(f Boolean?) ýalňyş: { Çykyş ýaz: ['F']. }.



