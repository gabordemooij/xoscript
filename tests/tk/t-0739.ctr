Çykyş ýaz: ['Test object'], täze-setir.
>> a := Obýekt täze. 

a gelende: ['item:'] et: { :binhelper
	öz binhelper := binhelper. 
}.

a gelende: ['item'] et: { <- öz binhelper.
}.

a item: Bin täze.

>> old-binhelper-address := a item prototip ýat-salgysy.
a save-as: ['/tmp/a.bin'].
Çykyş ýaz: ['========== RELOADING SNAP:'], täze-setir.

>> b := Obýekt load-from: ['/tmp/a.bin'].

(b item prototip ýat-salgysy = old-binhelper-address) dogry: {
	Çykyş ýaz: ['Object link re-attached.'], täze-setir.
}.


