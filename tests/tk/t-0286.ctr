['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Çykyş ýaz: (x + y), täze-setir.

>> x := 10040.07.
>> y := 10305.60.

Çykyş ýaz: (x + y), täze-setir.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Çykyş ýaz: (x + y + z), täze-setir.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Çykyş ýaz: (x + y + z), täze-setir.

>> q := 0.1.2.

Çykyş ýaz: (q), täze-setir.

>> q := 012.

Çykyş ýaz: (q), täze-setir.
