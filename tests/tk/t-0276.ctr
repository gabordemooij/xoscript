>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Obýekt täze.
⚄ gelende: ['drawFrom:length:'] et: { :pool :sany
	
	>> result := [''].
	
	{
		>> index := San random % (pool uzynlyk).
		result soňuna-goş: ( pool nyşan: (index + 1) ).
		
	} × sany. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? uzynlyk.
Çykyş ýaz: (['x↵'] x random uzynlyk).
Çykyş ýaz: (['y↵'] y ?? uzynlyk).

