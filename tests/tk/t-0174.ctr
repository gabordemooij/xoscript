


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programma ýat-dolandyryş: 0.
>> palette := Boş.
>> colors := Boş.

{
palette := Sözlük täze.
palette 
	goý: ['#F00'] açar: ['red'],
	goý: ['#0F0'] açar: ['green'],
	goý: ['#00F'] açar: ['blue'].
Çykyş ýaz: ['number of RGB codes in palette: '] + ( palette sany ), täze-setir.
Çykyş ýaz: ['RGB code of green is: '] + ( palette ? ['green'] ), täze-setir.
colors := [''].
( palette her: { :at :kod
		colors := colors + ( at + [':'] + kod ).
} ).
Çykyş ýaz: ['All colors in palette: '] + colors, täze-setir.
} işlet.
Programma arassala.
usedMemory1 := (Programma ýat ? 0).

