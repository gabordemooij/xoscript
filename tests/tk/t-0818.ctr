# edge cases from a request must give an error or a result, not a crash
Server init.

Çykyş ýaz: ['<'] + (['abc'] başlap: 0 uzynlyk: 0, baş-harplar) + ['>'], täze-setir.
Çykyş ýaz: ['<'] + (['abc'] başlap: 0 uzynlyk: 0, kiçi-harplar) + ['>'], täze-setir.
Çykyş ýaz: ['<'] + (['abc'] süýşür: 3, baş-harplar) + ['>'], täze-setir.
Çykyş ýaz: [''] baş-harplar bytes, täze-setir.
Çykyş ýaz: ['aB'] baş-harplar, täze-setir.
Çykyş ýaz: ['aB'] kiçi-harplar, täze-setir.

Çykyş ýaz: (Pursat täze: 0) ýyl, täze-setir.
{ Pursat täze: ['9e300'] san. } tut: { :e Çykyş ýaz: e, täze-setir. }, işlet.
{ Pursat täze: ['-9e300'] san. } tut: { :e Çykyş ýaz: e, täze-setir. }, işlet.
{ Pursat täze: ['nan'] san. } tut: { :e Çykyş ýaz: e, täze-setir. }, işlet.
{ Pursat täze: 9000000000000000000. } tut: { :e Çykyş ýaz: e, täze-setir. }, işlet.
