
Sanaw gelende: ['sum'] et: {
	>> total := 0.
	özi her: { :index :element
		total goş: element.
	}. <- total.
}.

>> a := Sanaw ← 9 ; 8 ; 7.
Çykyş ýaz: (a sum), täze-setir. 
>> a := Sanaw ← 1 ; 9.
Çykyş ýaz: (a sum), täze-setir. 
>> a := Sanaw ← ['o'] ; 2.
Çykyş ýaz: (a sum), täze-setir. 
Çykyş ýaz: (Sanaw täze sum), täze-setir. 
