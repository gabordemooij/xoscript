# test buffers PKI/Sign 
Server init.

>> long := ( Sanaw täze doldur: 1000 bilen: ['a'] ) birleşdir: [''].

# sign a message
Çykyş ýaz: ( 
	Seýf gol-çek: ['abc'] açar-bilen: long
), täze-setir.

Çykyş ýaz: ( 
	Seýf
		barla: ['abc'] 
		gol: long 
		açar-bilen: long
), täze-setir.

Çykyş ýaz: (
	Seýf parol-heşi: long barla: long
), täze-setir.
