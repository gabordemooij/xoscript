Tekst gelende: ['html'] et: { <- (
		özi
		çalyş: ['&'] bilen: ['&amp;'],
		çalyş: ['<'] bilen: ['&lt;'],
		çalyş: ['>'] bilen: ['&gt;'],
		çalyş: ['''] bilen: ['&apos;'],
		çalyş: ['"'] bilen: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programma ýat-dolandyryş: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Çykyş ýaz: txt göçür html, täze-setir.
Çykyş ýaz: txt göçür kiçi-harplar, täze-setir.
Çykyş ýaz: txt göçür baş-harplar, täze-setir.
} işlet.

Programma arassala.

usedMemory1 := (Programma ýat ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Çykyş ýaz: txt göçür html, täze-setir.
Çykyş ýaz: txt göçür kiçi-harplar, täze-setir.
