usedMemory3 := (Programma ýat ? 0).



( usedMemory1 = usedMemory2 we: usedMemory1 = usedMemory3, we: usedMemory2 = usedMemory3 ) dogry: {
	Çykyş ýaz: ['No memory leaks here'].
}, ýalňyş: {
