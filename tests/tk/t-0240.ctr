# test qualifiers

>> $ := Obýekt täze.

$ gelende: ['jogap-ber:'] et: { :x
	
	>> operation := x nyşan: 0.
	>> valuta := x nyşan: 1.
	>> money := x süýşür: 2.
	
	>> amount := 0.

	( operation = ['+'] ) dogry: {
		( valuta = ['£'] ) dogry: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Çykyş ýaz: x, täze-setir.


>> Fruit := Obýekt täze.

Fruit gelende: ['täze'] et: {
	>> f := özi täze.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit gelende: ['apples:'] et: { :a öz apples := a. }.
Fruit gelende: ['oranges:'] et: { :p öz oranges := p. }.
Fruit gelende: ['apples'] et: { <- öz apples. }.
Fruit gelende: ['oranges'] et: { <- öz oranges. }.

Fruit gelende: ['+'] et: { :f
	
	>> n := Fruit täze.
	f goş: 1.
	
	n apples: (f apples + öz apples).
	n oranges:  (f oranges  + öz oranges). <- n.
}.

Fruit gelende: ['tekst'] et: { <- ( öz apples tekst + [' apples and '] + öz oranges + [' oranges'] ).
}.

San gelende: ['apples'] et: { <- ((Fruit täze) apples: özi).
}.

San gelende: ['apple'] et: { <- ((Fruit täze) apples: özi).
}.

San gelende: ['oranges'] et: { <- ((Fruit täze) oranges: özi).
}.




Çykyş ýaz: (1 apple + 3 oranges + 4 apples), täze-setir.


Tekst gelende: ['twice'] et: { <- ((özi tekst) + (özi tekst)).
}.



Çykyş ýaz: ['❤❤❤'] twice.



