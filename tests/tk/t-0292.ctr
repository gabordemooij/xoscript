>> winery := { <- (	Sözlük täze
		goý: 2 açar: ['merlot'],
		goý: 3 açar: ['malbec'],
		goý: 4 açar: ['syrah']
	).
}.

Çykyş ýaz: (((winery işlet) - ['nothing']) sany), täze-setir.
Çykyş ýaz: (((winery işlet) - ['merlot']) sany), täze-setir.
Çykyş ýaz: (((winery işlet) - ['malbec']) sany), täze-setir.
Çykyş ýaz: (((winery işlet) - ['syrah']) sany), täze-setir.
