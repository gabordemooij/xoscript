# test qualifiers

>> $ := Réad nua.

$ ar: ['freagair:'] déan: { :x
	
	>> operation := x carachtar: 0.
	>> valuta := x carachtar: 1.
	>> money := x fritháireamh: 2.
	
	>> amount := 0.

	( operation = ['+'] ) fíor: {
		( valuta = ['£'] ) fíor: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Aschur scríobh: x, líne-nua.


>> Fruit := Réad nua.

Fruit ar: ['nua'] déan: {
	>> f := féin nua.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit ar: ['apples:'] déan: { :a dílis apples := a. }.
Fruit ar: ['oranges:'] déan: { :p dílis oranges := p. }.
Fruit ar: ['apples'] déan: { <- dílis apples. }.
Fruit ar: ['oranges'] déan: { <- dílis oranges. }.

Fruit ar: ['+'] déan: { :f
	
	>> n := Fruit nua.
	f suimigh: 1.
	
	n apples: (f apples + dílis apples).
	n oranges:  (f oranges  + dílis oranges). <- n.
}.

Fruit ar: ['teaghrán'] déan: { <- ( dílis apples teaghrán + [' apples and '] + dílis oranges + [' oranges'] ).
}.

Uimhir ar: ['apples'] déan: { <- ((Fruit nua) apples: féin).
}.

Uimhir ar: ['apple'] déan: { <- ((Fruit nua) apples: féin).
}.

Uimhir ar: ['oranges'] déan: { <- ((Fruit nua) oranges: féin).
}.




Aschur scríobh: (1 apple + 3 oranges + 4 apples), líne-nua.


Teaghrán ar: ['twice'] déan: { <- ((féin teaghrán) + (féin teaghrán)).
}.



Aschur scríobh: ['❤❤❤'] twice.



