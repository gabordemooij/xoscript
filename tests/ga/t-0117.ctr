>> t := Fíor.
(t = Fíor) fíor: { Aschur scríobh: ['T']. }.
(t = Bréagach) fíor: { Aschur scríobh: ['F']. }.
Aschur scríobh: ['|'].
>> t := Bréagach.
(t = Fíor) fíor: { Aschur scríobh: ['T']. }.
(t = Bréagach) fíor: { Aschur scríobh: ['F']. }.
Aschur scríobh: ['|'].
>> f := Fíor.
(t = Fíor agus: f = Bréagach) fíor: { Aschur scríobh: ['T']. }.
(t = Bréagach agus: f = Fíor) fíor: { Aschur scríobh: ['F']. }.
Aschur scríobh: ['|'].
>> n := Neamhní.
(n Neamhní?) fíor: { Aschur scríobh: ['T']. }.
(n Neamhní?) bréagach: { Aschur scríobh: ['F']. }.
Aschur scríobh: ['|'].
(f Boolean?) fíor: { Aschur scríobh: ['T']. }.
(f Boolean?) bréagach: { Aschur scríobh: ['F']. }.



