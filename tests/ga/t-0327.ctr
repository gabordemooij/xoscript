

Liosta ar: ['fixture:'] déan: { :f
	dílis fixture := f.
}.

Liosta ar: ['comhair'] déan: { <- dílis fixture.
}.

Liosta ar: ['aantal'] déan: { <- dílis fixture.
}.


>> x := Neamhní.
{

	x := ['hello'] 
	ionadaigh:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] carachtar: 2)
			)
		)
	le: (
		(['...hal'] + ['lo']) 
			cás-uachtair 
			lowecase 
			cás-uachtair 
			fritháireamh: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Liosta ← 0 ; 1 ; 4; 9 ; (Liosta ← 0 ; 3; 1) ; 4
							) leathdheireanach
						) ? 1
					) + 
					((Liosta ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					comhair
				)
			)
	).

} × 10.
Aschur scríobh: x, líne-nua.

