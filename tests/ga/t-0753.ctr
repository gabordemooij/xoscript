Aschur scríobh: ['Test object'], líne-nua.
>> a := Réad nua. 

a ar: ['item:'] déan: { :fmt
	dílis fmt := fmt. 
}.

a ar: ['item'] déan: { <- dílis fmt.
}.

a item: ( Formáid nua: ['|%s|'] ).

Aschur scríobh: a item, líne-nua.

>> old-fmt-address := a item fréamhshamhail seoladh-cuimhne.
a save-as: ['/tmp/a.bin'].
Aschur scríobh: ['========== RELOADING SNAP:'], líne-nua.

>> b := Réad load-from: ['/tmp/a.bin'].

(b item fréamhshamhail seoladh-cuimhne = old-fmt-address) fíor: {
	Aschur scríobh: ['Object link re-attached.'], líne-nua.
}.

Aschur scríobh: ( b item feidhmigh: ['hello'] ), líne-nua.
