>> x := Réad nua.
>> y := Réad nua.
>> z := x.
Aschur scríobh: (x = z), líne-nua.
Aschur scríobh: (x = y), líne-nua.
Aschur scríobh: (x ≠ y), líne-nua.
Aschur scríobh: (x ≠ z), líne-nua.
>> m := Tráth nua bliain: 2070, mí: 11.
>> n := m cóipeáil.
Aschur scríobh: (m = n), líne-nua.
Aschur scríobh: (m ≠ n), líne-nua.
Aschur scríobh: (m cothrom-le: m), líne-nua.
Aschur scríobh: (m cothrom-le: n), líne-nua.
n mí: 12.
Aschur scríobh: (m ≠ n), líne-nua.
Aschur scríobh: (m = n), líne-nua.


