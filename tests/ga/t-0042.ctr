>> items := Foclóir nua.
items cuir: ['black'] ag: ['coffee'], cuir: ['earl grey'] ag: ['tea'].
Aschur scríobh: (items ag: ['coffee']), scríobh: (items ag: ['tea']).
Aschur scríobh: ['there are'] + items comhair + [' items in the array.'].
items cuir: ['capuccino'] ag: ['coffee'].
Aschur scríobh: ['Now my coffee is.. '] + (items ag: ['coffee']).
items cuir: ['aaa'] ag: ['1'].
items cuir: ['bbb'] ag: ['2'].
Aschur scríobh: (items ag: ['a']).
