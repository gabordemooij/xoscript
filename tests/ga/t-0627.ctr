

# create a 64-bit integer for exact calculations
>> a := Int64 as-teaghrán: ['123'].

# to string
Aschur scríobh: a, líne-nua.

# divide
Aschur scríobh: a / (Int64 as-teaghrán: ['3']), líne-nua.

# multiply
Aschur scríobh: a * (Int64 as-teaghrán: ['2']), líne-nua.

# add
Aschur scríobh: a + (Int64 as-teaghrán: ['1']), líne-nua.

# subtract
Aschur scríobh: a - (Int64 as-teaghrán: ['2']), líne-nua.

# compare
Aschur scríobh: ( a =   (Int64 as-teaghrán: ['123'])), líne-nua.
Aschur scríobh: ( a !=: (Int64 as-teaghrán: ['124'])), líne-nua.
Aschur scríobh: ( a <   (Int64 as-teaghrán: ['124'])), líne-nua.
Aschur scríobh: ( a >   (Int64 as-teaghrán: ['122'])), líne-nua.
Aschur scríobh: ( a >=: (Int64 as-teaghrán: ['123'])), líne-nua.
Aschur scríobh: ( a <=: (Int64 as-teaghrán: ['123'])), líne-nua.





	