>> numbers := ['1,2,3'] scoilt: [','].
Aschur scríobh: ['I got: '] + numbers comhair + [' numbers.'],líne-nua.
{ :i Aschur scríobh: ['number #'] + i + [':'] + (numbers ionad: i), líne-nua.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages scoilt: [' Or '].
Aschur scríobh: ['We serve'], líne-nua.
{ :i Aschur scríobh: ['->'] + (beverages ionad: i), líne-nua. } × (beverages comhair).
Aschur scríobh: (beverages ceangail: [',']), líne-nua.
Aschur scríobh: (numbers ceangail: ['||']).
