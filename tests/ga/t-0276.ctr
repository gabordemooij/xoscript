>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Réad nua.
⚄ ar: ['drawFrom:length:'] déan: { :pool :comhair
	
	>> result := [''].
	
	{
		>> index := Uimhir random % (pool fad).
		result iarcheangail: ( pool carachtar: (index + 1) ).
		
	} × comhair. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? fad.
Aschur scríobh: (['x↵'] x random fad).
Aschur scríobh: (['y↵'] y ?? fad).

