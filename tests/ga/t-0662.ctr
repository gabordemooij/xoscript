>> t := Neamhní.

# you can control the time zone for
# parsing like this:
Tráth crios: ['CET'].
t := Tráth as: ['1981-02-03 04:05:06'].
Aschur scríobh: t, líne-nua.

# now using CEST time zone:
Tráth crios: ['CEST'].
t := Tráth as: ['1981-02-03 04:05:06'].
Aschur scríobh: t, líne-nua.

# error if string cannot be parsed
{ Tráth as: ['1900']. } gabh: { Neamhní. }, tosaigh.
