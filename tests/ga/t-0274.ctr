

Liosta ar: ['column:'] déan: { :column
	>> result := Liosta nua.
	féin gach: { :index :row
		row gach: { :index :cell
			(index = column) fíor: { result iarcheangail: cell. }.
		}.
	}. <- result.
}.


>> a := Liosta ←
	(Liosta ← 1 ; 2 ; 3) ;
	(Liosta ← 4 ; 5 ; 6) ;
	(Liosta ← 7 ; 8 ; 9).

>> b := a column: 1.
Aschur scríobh: b, líne-nua.

b := a column: 20.
Aschur scríobh: b, líne-nua.

b := a column: -100.
Aschur scríobh: b, líne-nua.
