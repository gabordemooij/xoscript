Uimhir ar: ['factorial'] déan: {
	>> total := 1.
	{ :index total iolraigh-faoi: (féin - (index)). } × féin. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Aschur scríobh: a.
>> b := 2 + 3 factorial.
Aschur scríobh: b.
>> c := 3 factorial + 2.
Aschur scríobh: c.
>> d := 2 + (3 factorial).
Aschur scríobh: d.
Aschur scríobh: 2 + 3 factorial + 1.
