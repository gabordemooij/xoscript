# test Program version

# this feature is disabled by default
Aschur scríobh: (
	Ríomhchlár gné: 
	['RECURSIVE_STRINTPOL']
), líne-nua.


# but if we set the time back
>> today := Tráth 
crios: ['CEST'],
as: ['2026-02-15 10:00:00'].
Ríomhchlár leagan: today.

# it will be enabled like it used to be (from now on)
Aschur scríobh: (
	Ríomhchlár gné: 
	['RECURSIVE_STRINTPOL']
), líne-nua.