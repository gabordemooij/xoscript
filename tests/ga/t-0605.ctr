>> invoice := Réad nua.
invoice ar: ['tosaigh'] déan: {
        dílis uimhir := 0.
}.

invoice ar: ['uimhir'] déan: {
        dílis uimhir suimigh: 1. <- dílis uimhir cóipeáil.
}.

>> year-invoice := invoice nua.
year-invoice ar: ['start:'] déan: { :bliain
	dílis uimhir := bliain.
}.

year-invoice start: 202000.
Aschur scríobh: year-invoice uimhir, líne-nua.
Aschur scríobh: year-invoice uimhir, líne-nua.
