



>> CoffeeGrounds := Réad nua.
CoffeeGrounds ar: ['extract'] déan: { <- ['coffee']. }.

>> CoffeeMachine := Réad nua.
CoffeeMachine ar: ['init'] déan: {
	dílis coffeegrounds := CoffeeGrounds nua.
}.
CoffeeMachine ar: ['nua'] déan: { <- CoffeeMachine `new init.
}.

CoffeeMachine ar: ['makeTea'] déan: { <- (dílis tealeaves extract). }.
CoffeeMachine ar: ['makeCoffee'] déan: { <- (dílis coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine nua.

Aschur scríobh:
	coffeeDream 
	makeCoffee.

Aschur scríobh:
	coffeeDream 
	makeTea.
