

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Ríomhchlár bainistíocht-cuimhne: 0.

Uimhir ar: ['addNum:'] déan: { :x
	féin suimigh: x.
}.

Uimhir ar: ['subtractNum:'] déan: { :x
	féin dealaigh: x.
}.

Uimhir ar: ['multiplyBy:'] déan: { :x
	féin iolraigh-faoi: x.
}.

Uimhir ar: ['divideBy:'] déan: { :x
	féin roinn-le: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 cumhacht: 8).  
a := a + (2 cumhacht: -1). 
a := a + (49 fréamh-chearnach).   
a addNum: ((Liosta ← 0 ; 1) uasmhéid).          
a addNum: ((Liosta ← 2 ; 3) íosmhéid).
Aschur scríobh: a.

Ríomhchlár glan-suas.

usedMemory1 := (Ríomhchlár cuimhne ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 cumhacht: 8).  
a := a + (2 cumhacht: -1). 
a := a + (49 fréamh-chearnach).   
a addNum: ((Liosta ← 0 ; 1) uasmhéid).          
a addNum: ((Liosta ← 2 ; 3) íosmhéid).
Aschur scríobh: a.

Ríomhchlár glan-suas.
usedMemory2 := (Ríomhchlár cuimhne ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 cumhacht: 8).  
a := a + (2 cumhacht: -1). 
a := a + (49 fréamh-chearnach).   
a addNum: ((Liosta ← 0 ; 1) uasmhéid).          
a addNum: ((Liosta ← 2 ; 3) íosmhéid).
Aschur scríobh: a.

Ríomhchlár glan-suas.
usedMemory3 := (Ríomhchlár cuimhne ? 0).



( usedMemory1 = usedMemory2 agus: usedMemory1 = usedMemory3, agus: usedMemory2 = usedMemory3 ) fíor: {
	Aschur scríobh: ['No memory leaks here'].
}, bréagach: {
	Aschur scríobh: ['Leaking memory...'].
}.
