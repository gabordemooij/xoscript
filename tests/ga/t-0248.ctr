

Teaghrán ar: ['evaluate'] déan: {
	>> cód := Comhad nua: ['/tmp/eval.ctr'].
	cód scríobh: féin teaghrán + ['.'].
	Ríomhchlár úsáid: ['/tmp/eval.ctr'].
}.

>> a := (Liosta ← (
	(Foclóir nua)
		cuir: ['domain'] ag: ['mywebsite.com'],
		cuir: (Liosta ←
			((Foclóir nua)
				cuir: ['home'] ag: ['title'],
				cuir: ['<html></html>'] ag: ['body'],
				cuir: ['2017-01-01'] ag: ['created']
			) ;
			((Foclóir nua)
				cuir: ['aboutus(c)'] ag: ['title'],
				cuir: ['<credits>Author Inc.</credits>'] ag: ['body']
			)
		) ag: ['pages']
	)
) teaghrán.

Aschur scríobh: a cineál, líne-nua.
Aschur scríobh: a, líne-nua.

>> b := Neamhní.
(['b := '] + a) evaluate.
Aschur scríobh: b ? 0 ? ['pages'] ? 1 ? ['body'], líne-nua.

>> c := b ? 0.
>> d := c teaghrán.
Aschur scríobh: d cineál, líne-nua.

>> e := Neamhní.
(['e := '] + d) evaluate.
Aschur scríobh: e ? ['pages'] ? 0, líne-nua.
