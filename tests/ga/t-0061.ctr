>> a := ['hello'].
>> b := ['hello'].
>> z := a.
>> c := Neamhní.
>> q := Réad nua.
>> p := q.
(a cothrom-le: a) fíor: { Aschur scríobh: ['Y1']. }.
(a cothrom-le: b) fíor: { Aschur scríobh: ['Y2']. }.
(a cothrom-le: c) fíor: { Aschur scríobh: ['Y3']. }.
(a cothrom-le: z) fíor: { Aschur scríobh: ['Y4']. }.
(z cothrom-le: a) fíor: { Aschur scríobh: ['Y5']. }.
(q cothrom-le: q) fíor: { Aschur scríobh: ['Y6']. }.
(p cothrom-le: q) fíor: { Aschur scríobh: ['Y7']. }.
(p cothrom-le: a) fíor: { Aschur scríobh: ['Y8']. }.
(p cothrom-le: Neamhní) fíor: { Aschur scríobh: ['Y9']. }.
