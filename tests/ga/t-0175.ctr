

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> x := 100.

Ríomhchlár bainistíocht-cuimhne: 0.

{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt iarcheangail: ['!!'].
Aschur scríobh: txt.
} tosaigh.

Ríomhchlár glan-suas.

usedMemory1 := (Ríomhchlár cuimhne ? 0).


{
>> txt := ['hello '] + ['world'].
