Aschur scríobh: ['Test object'], líne-nua.
>> a := Réad nua. 

a ar: ['item:'] déan: { :octhelper
	dílis octhelper := octhelper. 
}.

a ar: ['item'] déan: { <- dílis octhelper.
}.

a item: Oct nua.

>> old-octhelper-address := a item fréamhshamhail seoladh-cuimhne.
a save-as: ['/tmp/a.bin'].
Aschur scríobh: ['========== RELOADING SNAP:'], líne-nua.

>> b := Réad load-from: ['/tmp/a.bin'].

(b item fréamhshamhail seoladh-cuimhne = old-octhelper-address) fíor: {
	Aschur scríobh: ['Object link re-attached.'], líne-nua.
}.
