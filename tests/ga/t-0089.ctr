>> randomizer := { :a :b
	>> íosmhéid := ( a < b ) ceachtar: a nó: b.
	>> uasmhéid := ( a > b ) ceachtar: a nó: b.
	>> x := Neamhní.
	{
		x := Uimhir idir: a agus: b.
		((x < íosmhéid) nó: (x > uasmhéid)) fíor: { 
			Aschur scríobh: (['Invalid value!']).
			Ríomhchlár deireadh.
		}.
	} 
	× 100. <- x.
}.
randomizer feidhmigh: 0 agus: 0.
randomizer feidhmigh: 1 agus: 0.
randomizer feidhmigh: 1 agus: 1.
randomizer feidhmigh: 0 agus: 1.
randomizer feidhmigh: -1 agus: 0.
randomizer feidhmigh: -1 agus: -1.
randomizer feidhmigh: 0 agus: -1.
randomizer feidhmigh: 100 agus: 200.
randomizer feidhmigh: 999999999999998 agus: 999999999999999.
randomizer feidhmigh: 999999999999999 agus: 999999999999998.
randomizer feidhmigh: 999999999999999 agus: 999999999999999.
randomizer feidhmigh: -999999999999998 agus: -999999999999999.
randomizer feidhmigh: -999999999999999 agus: -999999999999998.
randomizer feidhmigh: -999999999999999 agus: -999999999999999.
randomizer feidhmigh: 999999999999998 agus: -999999999999999.
randomizer feidhmigh: 999999999999999 agus: -999999999999998.
randomizer feidhmigh: 999999999999999 agus: -999999999999999.
randomizer feidhmigh: -999999999999998 agus: 999999999999999.
randomizer feidhmigh: -999999999999999 agus: 999999999999998.
randomizer feidhmigh: -999999999999999 agus: 999999999999999.
Aschur scríobh: ['OK'].


