Aschur scríobh: ['Test object'], líne-nua.
>> a := Réad nua. 

a ar: ['item:'] déan: { :moment
	dílis moment := moment. 
}.

a ar: ['item'] déan: { <- dílis moment.
}.

>> today := Liosta nua ; ( Tráth nua crios: ['CEST'], bliain: 2026, mí: 7 ).
a item: today.
Aschur scríobh: a item ? 0, líne-nua.
a save-as: ['/tmp/a.bin'].
