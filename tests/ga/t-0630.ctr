#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Patrún nua: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern meaitseáil: subject déan: { :m :x
	Aschur scríobh: m, líne-nua.
	Aschur scríobh: x, líne-nua. <- ['XXX'].
}.
Aschur scríobh: result, líne-nua.