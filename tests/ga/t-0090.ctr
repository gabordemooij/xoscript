Aschur scríobh: ['1,2,3,4,5,6,7,8,9,A,'], líne-nua.
>> Scope := Réad nua.
Scope ar: ['initialize:'] déan: { :x dílis property := x. }.
Scope ar: ['confirm'] déan: { Aschur scríobh: [',']. }.
Scope ar: ['tástáil'] déan: {
	Aschur scríobh: dílis property.
	féin confirm.
	( 1 = 1 ) fíor: { Aschur scríobh: dílis property. féin confirm. }.
	( 1 = 0 ) bréagach: { Aschur scríobh: dílis property. féin confirm. }.
	>> y := 2. { Aschur scríobh: dílis property. féin confirm. } fad-is: { y dealaigh: 1. <- (y > 0). }.
	{ Aschur scríobh: dílis property. féin confirm. } × 1.
	(Liosta ← 1) gach: {  Aschur scríobh: dílis property. féin confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Foclóir nua one: ['item']) gach: { Aschur scríobh: dílis property. féin confirm. }.
	{ 1 ÷ 0. } gabh: { Aschur scríobh: dílis property. féin confirm. }, tosaigh.
	Aschur líne-nua.
}.
>> scope1 := Scope nua.
scope1 initialize: ['X'].
scope1 tástáil.
>> function := { 
	dílis property := ['Y'].
	Aschur scríobh: dílis property.
	féin confirm.
	( 1 = 1 ) fíor: { Aschur scríobh: dílis property. féin confirm. }.
	( 1 = 0 ) bréagach: { Aschur scríobh: dílis property. féin confirm. }.
	>> y := 2. { Aschur scríobh: dílis property. féin confirm. } fad-is: { y dealaigh: 1. <- (y > 0). }.
	{ Aschur scríobh: dílis property. féin confirm. } × 1.
	(Liosta ← 1) gach: {  Aschur scríobh: dílis property. féin confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Foclóir nua one: ['item']) gach: { Aschur scríobh: dílis property. féin confirm. }.
	{ 1 ÷ 0. } gabh: { Aschur scríobh: dílis property. féin confirm. }, tosaigh.
	Aschur líne-nua.
}.
function ar: ['confirm'] déan: { Aschur scríobh: [',']. }.
function feidhmigh: 1 agus: 2.
