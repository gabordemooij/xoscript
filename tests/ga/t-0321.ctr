# test qualifiers

Ríomhchlár glan-suas.

>> Fruit := Réad nua.
Fruit ar: ['nua'] déan: {
	>> f := féin nua.
	f apples: 0. <- f.
}.
Fruit ar: ['apples:'] déan: { :a dílis apples := a. }.
Fruit ar: ['apples'] déan: { <- dílis apples. }.
Fruit ar: ['+'] déan: { :f
	>> n := Fruit nua.
	n apples: (f apples + dílis apples). <- n.
}.
Uimhir ar: ['apples'] déan: { <- ((Fruit nua) apples: féin).
}.

Fruit ar: ['teaghrán'] déan: { <- dílis apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Aschur scríobh: q, líne-nua.




q := 3 apples + 4 apples.
Aschur scríobh: q, líne-nua.



q := 3 apples + 4 apples.
Aschur scríobh: q, líne-nua.


