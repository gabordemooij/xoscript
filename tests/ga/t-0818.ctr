# edge cases from a request must give an error or a result, not a crash
Server init.

Aschur scríobh: ['<'] + (['abc'] ó: 0 fad: 0, cás-uachtair) + ['>'], líne-nua.
Aschur scríobh: ['<'] + (['abc'] ó: 0 fad: 0, cás-íochtair) + ['>'], líne-nua.
Aschur scríobh: ['<'] + (['abc'] fritháireamh: 3, cás-uachtair) + ['>'], líne-nua.
Aschur scríobh: [''] cás-uachtair bytes, líne-nua.
Aschur scríobh: ['aB'] cás-uachtair, líne-nua.
Aschur scríobh: ['aB'] cás-íochtair, líne-nua.

Aschur scríobh: (Tráth nua: 0) bliain, líne-nua.
{ Tráth nua: ['9e300'] uimhir. } gabh: { :e Aschur scríobh: e, líne-nua. }, tosaigh.
{ Tráth nua: ['-9e300'] uimhir. } gabh: { :e Aschur scríobh: e, líne-nua. }, tosaigh.
{ Tráth nua: ['nan'] uimhir. } gabh: { :e Aschur scríobh: e, líne-nua. }, tosaigh.
{ Tráth nua: 9000000000000000000. } gabh: { :e Aschur scríobh: e, líne-nua. }, tosaigh.
