
Server init.
>> rq := HTTP-Iarratas nua.
Aschur scríobh: ['HTTP-GET d[]=']  + ( rq get-liosta: ['d[]'] ), líne-nua. # GET
Aschur scríobh: ['HTTP-GET f[]=']  + ( rq get-liosta: ['f[]'] ), líne-nua. # GET
Aschur scríobh: ['HTTP-POST e[]='] + ( rq post-liosta: ['e[]'] ), líne-nua. # GET
Aschur scríobh: ['HTTP-POST c=']   + ( rq post: ['c'] ), líne-nua. # GET
Aschur scríobh: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), líne-nua. # GET
