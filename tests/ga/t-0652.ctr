# test number -> string -> number
{

	>> x := Uimhir idir: 0 agus: 1000000.
	>> d := Uimhir idir: 1 agus: 7.
	>> e := 10 cumhacht: d.

	x roinn-le: e.
	>> y := x teaghrán uimhir.

	(x = y) bréagach: {
		Aschur scríobh: x, líne-nua.
		Aschur scríobh: y, líne-nua.
		Ríomhchlár deireadh.
	}.

} * 1000.
Aschur scríobh: ['OK'], líne-nua.