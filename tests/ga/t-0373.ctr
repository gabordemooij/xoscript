# compliance test

# use international numbers

Aschur scríobh: ['1000 -> '].
Aschur scríobh: 1000, líne-nua. #1000

Aschur scríobh: ['1.5 -> '].
Aschur scríobh: 1.5, líne-nua.  #1.5

Aschur scríobh: ['1001.5 -> '].
Aschur scríobh: 1.5 + 1000, líne-nua. #1001.5

# use 0-indexed arrays
>> x := Liosta nua ; 1 ; 2 ; 3.
>> y := Liosta nua ; ['a'] ; ['b'] ; ['c'].

Aschur scríobh: ['1 -> '].
Aschur scríobh: x ? 0, líne-nua. #1

Aschur scríobh: ['1 -> '].
Aschur scríobh: (x ag: 0), líne-nua. #1

Aschur scríobh: ['1 -> '].
Aschur scríobh: x céad, líne-nua. #1

Aschur scríobh: ['3 -> '].
Aschur scríobh: x deireanach, líne-nua. #3

Aschur scríobh: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Aschur scríobh: (x le: y), líne-nua.

Aschur scríobh: ['1 -> '].
Aschur scríobh: (x ó: 0 fad: 1) céad, líne-nua. #1

Aschur scríobh: ['0 -> '].
Aschur scríobh: (x faigh: 1), líne-nua. #0

x cuir: 9 ag: 0.

Aschur scríobh: ['9 -> '].
Aschur scríobh: (x ag: 0), líne-nua. #9

x réamhcheangail: 8.
Aschur scríobh: ['8 -> '].
Aschur scríobh: (x ag: 0), líne-nua. #9


x iarcheangail: 10.
Aschur scríobh: ['10 -> '].
Aschur scríobh: (x ag: 4), líne-nua. #10








