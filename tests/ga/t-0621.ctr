>> phrases := Liosta nua
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases gach: { :_ :phrase 
	>> e := Server base64-ionchódaigh: phrase.
	>> d := Server base64-díchódaigh: e.
	Aschur scríobh: (
		message cóipeáil ~encoded: e, ~decoded: d
	), líne-nua.
}.
