

Teaghrán ar: ['evaluate'] déan: {
	>> cód := Comhad nua: ['/tmp/eval.ctr'].
	cód scríobh: (féin teaghrán + ['.']).
	Ríomhchlár úsáid: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Liosta ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q teaghrán.
Aschur scríobh: x, líne-nua.
>> y := Neamhní.
(['y := '] + x ) evaluate.
Aschur scríobh: y ? 0, líne-nua.

q := Foclóir cuir: ['\[''] ag: ['\['quote\']'].
x := q teaghrán.
Aschur scríobh: x, líne-nua.
y := Neamhní.
(['y := '] + x ) evaluate.

>> q := (Foclóir nua) cuir:['\[''] ag:['\['quote\[''].
Aschur scríobh: y ? ['\['quote\']'], líne-nua.
