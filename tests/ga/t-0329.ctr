Aschur scríobh: ((Liosta nua
	ar: ['plaque:'] déan: { :x dílis o := x. },
	ar: ['plaque']  déan: { <- dílis o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Liosta ← 1)
	~ (Liosta ← 1 ; 2)
	~ (Liosta ← 1 ; 2 ; 3)
	~ (Liosta ← 1 ; 2 ; 3 ; 4)
	~ (Liosta ← 1 ; 2 ; 3 ; 4 ; 5)
) gach: { :i :el
	{ Aschur scríobh: an-tasc-seo. } × el comhair.
	Aschur líne-nua.
}) plaque, líne-nua.


