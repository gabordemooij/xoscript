['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Aschur scríobh: (x + y), líne-nua.

>> x := 10040.07.
>> y := 10305.60.

Aschur scríobh: (x + y), líne-nua.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Aschur scríobh: (x + y + z), líne-nua.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Aschur scríobh: (x + y + z), líne-nua.

>> q := 0.1.2.

Aschur scríobh: (q), líne-nua.

>> q := 012.

Aschur scríobh: (q), líne-nua.
