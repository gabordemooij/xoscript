Server init.
>> fmt := Formáid nua: ['%#3x'].

>> blob := Blob nua: 4.
blob bytes: ( 
	Liosta nua ; 0 ; 1 ; 2 ; 3
).

>> file := Comhad nua: ['/tmp/blob'].
file blob: blob.
blob saor.

>> léigh := file blob.
léigh 
ó: 0 
fad: 4, 
déan gach: { :i :b 
	Aschur
	scríobh: (fmt feidhmigh-slánuimhir: b),
	líne-nua.
}.
léigh saor.
