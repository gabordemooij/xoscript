>> HTML := Réad nua.
HTML ar: ['freagair:'] déan: { :tag 
	Aschur scríobh: (['<tag>'] tag: tag), líne-nua.
}.
HTML ar: ['freagair:agus:'] déan: { :tag :html 
	Aschur scríobh: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), líne-nua.
}.
>> html := HTML nua.
html body h1: ['header'].

