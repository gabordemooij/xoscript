>> repeater := Réad nua.
repeater ar: ['freagair:'] déan: { :what
	Aschur scríobh: what + [' '].
}.
repeater ar: ['freagair:agus:'] déan: { :what :say
	Aschur scríobh: what, scríobh: say + [' '].
}.
repeater ar: ['freagair:agus:agus:'] déan: { :what :say :more
	Aschur scríobh: what, scríobh: say, scríobh: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
