

Liosta ar: ['sum'] déan: {
	>> total := 0.
	féin gach: { :index :element
		total suimigh: element.
	}. <- total.
}.

Liosta ar: ['product'] déan: {
	>> total := 1.
	féin gach: { :index :element
		total iolraigh-faoi: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Ríomhchlár bainistíocht-cuimhne: 0.

{

>> a := Liosta ← ['hello'] ; ['world'] ; Fíor ; Neamhní ; 666.
a := a + ( Liosta ← 1 ).
Aschur scríobh: ( ['sum: '] + ( a sum ) ), líne-nua.
Aschur scríobh: ( ['min: '] + ( a íosmhéid ) ), líne-nua.
Aschur scríobh: ( ['max: '] + ( a uasmhéid ) ), líne-nua.
Aschur scríobh: ( ['3rd: '] + ( a ? 2 ) ), líne-nua.
Aschur scríobh: ( ['prd: '] + ( a product ) ), líne-nua.
a sórtáil: { :a :b <- (b - a). }.
a gach: { :i :e Aschur scríobh: ( i - 0 ), líne-nua. }.

} tosaigh.

Ríomhchlár glan-suas.
usedMemory1 := (Ríomhchlár cuimhne ? 0).


{

>> a := Liosta ← ['hello'] ; ['world'] ; Fíor ; Neamhní ; 666.
a := a + ( Liosta ← 1 ).
Aschur scríobh: ( ['sum: '] + ( a sum ) ), líne-nua.
Aschur scríobh: ( ['min: '] + ( a íosmhéid ) ), líne-nua.
Aschur scríobh: ( ['max: '] + ( a uasmhéid ) ), líne-nua.
Aschur scríobh: ( ['3rd: '] + ( a ? 2 ) ), líne-nua.
Aschur scríobh: ( ['prd: '] + ( a product ) ), líne-nua.
a sórtáil: { :a :b <- (b - a). }.
a gach: { :i :e Aschur scríobh: ( i - 0 ), líne-nua. }.

} tosaigh.



Ríomhchlár glan-suas.
usedMemory2 := (Ríomhchlár cuimhne ? 0).


{

>> a := Liosta ← ['hello'] ; ['world'] ; Fíor ; Neamhní ; 666.
a := a + ( Liosta ← 1 ).
Aschur scríobh: ( ['sum: '] + ( a sum ) ), líne-nua.
Aschur scríobh: ( ['min: '] + ( a íosmhéid ) ), líne-nua.
Aschur scríobh: ( ['max: '] + ( a uasmhéid ) ), líne-nua.
Aschur scríobh: ( ['3rd: '] + ( a ? 2 ) ), líne-nua.
Aschur scríobh: ( ['prd: '] + ( a product ) ), líne-nua.
a sórtáil: { :a :b <- (b - a). }.
a gach: { :i :e Aschur scríobh: ( i - 0 ), líne-nua. }.

} tosaigh.



Ríomhchlár glan-suas.
usedMemory3 := (Ríomhchlár cuimhne ? 0).

( usedMemory1 = usedMemory2 agus: usedMemory1 = usedMemory3, agus: usedMemory2 = usedMemory3 ) fíor: {
	Aschur scríobh: ['No memory leaks here'].
}, bréagach: {
	Aschur scríobh: ['Leaking memory...'].
}.
