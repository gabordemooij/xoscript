


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Ríomhchlár bainistíocht-cuimhne: 0.
>> palette := Neamhní.
>> colors := Neamhní.

{
palette := Foclóir nua.
palette 
	cuir: ['#F00'] ag: ['red'],
	cuir: ['#0F0'] ag: ['green'],
	cuir: ['#00F'] ag: ['blue'].
Aschur scríobh: ['number of RGB codes in palette: '] + ( palette comhair ), líne-nua.
Aschur scríobh: ['RGB code of green is: '] + ( palette ? ['green'] ), líne-nua.
colors := [''].
( palette gach: { :ainm :cód
		colors := colors + ( ainm + [':'] + cód ).
} ).
Aschur scríobh: ['All colors in palette: '] + colors, líne-nua.
} tosaigh.
Ríomhchlár glan-suas.
usedMemory1 := (Ríomhchlár cuimhne ? 0).

{
palette := Foclóir nua.
palette 
	cuir: ['#F00'] ag: ['red'],
	cuir: ['#0F0'] ag: ['green'],
	cuir: ['#00F'] ag: ['blue'].
Aschur scríobh: ['number of RGB codes in palette: '] + ( palette comhair ), líne-nua.
Aschur scríobh: ['RGB code of green is: '] + ( palette ? ['green'] ), líne-nua.
colors := [''].
( palette gach: { :ainm :cód
		colors := colors + ( ainm + [':'] + cód ).
} ).
Aschur scríobh: ['All colors in palette: '] + colors, líne-nua.
} tosaigh.
Ríomhchlár glan-suas.
usedMemory2 := (Ríomhchlár cuimhne ? 0).

{
palette := Foclóir nua.
palette 
	cuir: ['#F00'] ag: ['red'],
	cuir: ['#0F0'] ag: ['green'],
	cuir: ['#00F'] ag: ['blue'].
Aschur scríobh: ['number of RGB codes in palette: '] + ( palette comhair ), líne-nua.
Aschur scríobh: ['RGB code of green is: '] + ( palette ? ['green'] ), líne-nua.
colors := [''].
( palette gach: { :ainm :cód
		colors := colors + ( ainm + [':'] + cód ).
} ).
Aschur scríobh: ['All colors in palette: '] + colors, líne-nua.
} tosaigh.
Ríomhchlár glan-suas.
usedMemory3 := (Ríomhchlár cuimhne ? 0).



( usedMemory1 = usedMemory2 agus: usedMemory1 = usedMemory3, agus: usedMemory2 = usedMemory3 ) fíor: {
	Aschur scríobh: ['No memory leaks here'].
}, bréagach: {
	Aschur scríobh: ['Leaking memory...'].
}.
