Server init.
Aschur scríobh: ['Database time test'], líne-nua.

>> db := Maria-DB nua óstach: ['localhost'],
	ainm-úsáideora: ['xo'], 
	pasfhocal: ['pass123'],
	ainm-bunachair: ['xobase'],
	ceangail.

>> paraiméadair-chuardaigh :=
db iarratas: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
faigh-sonraí: { :row
	Aschur scríobh: row timetest, líne-nua.
}.
