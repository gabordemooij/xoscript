
Teaghrán ar: ['evaluate'] déan: {
	>> cód := Comhad nua: ['/tmp/eval.ctr'].
	cód scríobh: (féin teaghrán + ['.']).
	Ríomhchlár úsáid: ['/tmp/eval.ctr'].
}.

>> map :=
	(Foclóir nua)
	cuir: ['Hi There'] ag: ['two'],
	cuir: (Liosta ← ['hello'] ; ['world'] ; (Liosta ← 1 ; 2; 9) ; Bréagach) ag: ['one'],
	cuir: ( (Foclóir nua) cuir: ['wrrld'] ag: ['misspelled'] ) ag: ['three'],
	cuir: (Liosta ← ((Foclóir nua) cuir: ['treasure'] ag: ['hidden']) ; 2) ag: ['four']. 
>> str := map teaghrán.
>> map2 := Neamhní.
(['map2 := '] + str ) evaluate.
Aschur scríobh: map2 ? ['one'] ? 0.
Aschur scríobh: map2 ? ['one'] ? 1.
Aschur scríobh: map2 ? ['four'] ? 0 ? ['hidden'].
Aschur scríobh: map2 ? ['one'] ? 2 ? 2.
