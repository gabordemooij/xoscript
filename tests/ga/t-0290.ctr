# test list operations


>> cakes := Liosta ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes ionadaigh: 1 fad: 2 le: ( Liosta ← ['cinnamon'] ; ['pineapple'] ).
Aschur scríobh: (buy ceangail: [',']), líne-nua.


>> buy := cakes ionadaigh: 1 fad: 12 le: ( Liosta ← ['cinnamon'] ; ['pineapple'] ).
Aschur scríobh: (buy ceangail: [',']), líne-nua.


>> buy := cakes ionadaigh: 2 fad: 10 le: ( Liosta nua ).
Aschur scríobh: (buy ceangail: [',']), líne-nua.


>> buy := cakes ionadaigh: 0 fad: 1 le: ( Liosta nua ).
Aschur scríobh: (buy ceangail: [',']), líne-nua.


>> buy := cakes ionadaigh: ['0'] fad: ['1'] le: ['x'].
Aschur scríobh: (buy ceangail: [',']), líne-nua.
