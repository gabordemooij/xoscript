Server init.

>> db := Maria-DB nua óstach: ['localhost'],
	ainm-úsáideora: ['xo'],
	pasfhocal: ['pass123'],
	ainm-bunachair: ['xobase'],
	ceangail.

>> del := db iarratas: ['DELETE FROM book WHERE id > 0'].
{  del rith-ordú. db deimhnigh. } gabh: { :e db cealaigh.  }, tosaigh.

>> comhair := db iarratas: ['SELECT COUNT(*) AS num FROM book'].
comhair faigh-sonraí: { :row Aschur scríobh: row num, líne-nua. }.
