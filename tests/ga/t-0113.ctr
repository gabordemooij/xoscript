Aschur scríobh: ['Continue for-loop, No - before 6 and up.'], líne-nua.
{ :i
	Aschur scríobh: (i + 1), líne-nua.
	((i + 1) > 4) lean.
	Aschur scríobh: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Aschur líne-nua.
Aschur scríobh: ['Continue while-true, No --> before 5 and up.'], líne-nua.
{
	Aschur scríobh: ['iteration #'] + x, líne-nua.
	x suimigh: 1.
	((x < 5) ní) lean.
	Aschur scríobh: ['-->'].
} fad-is: xIsLessThan10.
Aschur líne-nua.
Aschur scríobh: ['Continue while-false, No - before 3 only.'], líne-nua.
{
	Aschur scríobh: ['iteration #'] + x, líne-nua.
	x dealaigh: 1.
	(x = 3) lean.
	Aschur scríobh: ['-'].
} fad-is: { <- ( x > 0). }.

Aschur líne-nua.
Aschur scríobh: ['Continue times-loop, No ||| before 3.'], líne-nua.
{ :i
	Aschur scríobh: ['iteration #'] + i, líne-nua.
	(i = 2) lean.
	Aschur scríobh: ['|||'].
} × 5.

Aschur líne-nua.

{ Fíor lean. Aschur scríobh: ['dont write this!'], líne-nua. } tosaigh.

{ Fíor lean. Aschur scríobh: ['dont write this!'], líne-nua. } gabh: { Aschur scríobh: ['Dont catch this!']. }, tosaigh.

Aschur scríobh: ['Test Array each-loop: 0, ... ,2'], líne-nua.
(Liosta ← 1 ; 2 ; 3) mapáil: { :i
	(i = 1) lean.
	Aschur scríobh: ['iteration #'] + (i - 0), líne-nua.
}.

Aschur scríobh: ['Test Map each-loop: c only'], líne-nua.
>> m := Foclóir nua.
m cuir: ['first'] ag: ['a'], cuir: ['second'] ag: ['b'], cuir: ['third'] ag: ['c'].
m gach: { :k :v
	(k ≠ ['c']) lean.
	Aschur scríobh: ['iteration'] + k + v, líne-nua.
}.

