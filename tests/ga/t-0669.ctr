# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Taisceadán 
	hais-pasfhocail: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Taisceadán 
	hais-pasfhocail: hash fíoraigh: a1.
	# fail 
>> b := Taisceadán
	hais-pasfhocail: hash fíoraigh: a2.
	# ok!

Aschur scríobh: a, líne-nua.
Aschur scríobh: b, líne-nua.

