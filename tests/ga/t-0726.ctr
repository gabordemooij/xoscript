# test buffers PKI/Sign 
Server init.

>> long := ( Liosta nua líon: 1000 le: ['a'] ) ceangail: [''].

# sign a message
Aschur scríobh: ( 
	Taisceadán sínigh: ['abc'] le: long
), líne-nua.

Aschur scríobh: ( 
	Taisceadán
		seiceáil: ['abc'] 
		síniú: long 
		le: long
), líne-nua.

Aschur scríobh: (
	Taisceadán hais-pasfhocail: long fíoraigh: long
), líne-nua.
