Aschur scríobh: ['Test object'], líne-nua.
>> a := Réad nua. 

a ar: ['state:'] déan: { :list
	dílis list := list. 
}.

a ar: ['state'] déan: {
	Aschur scríobh: dílis list, líne-nua.
}.

a state: ( Liosta nua ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
Aschur scríobh: ['========== RELOADING SNAP:'], líne-nua.
>> b := Réad load-from: ['/tmp/a.bin'].
b state.