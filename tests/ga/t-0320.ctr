


>> CoffeeMachine := Réad nua.
CoffeeMachine ar: ['order:'] déan: { :id
	>> coffee := ['Americano'].
	( id = 1 ) fíor: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) fíor: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) fíor: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Réad nua.
SimpleCoffeeMachine ar: ['order'] déan: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Aschur scríobh: redCup, líne-nua.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Aschur scríobh: greenCup, líne-nua.
>> yellowCup := CoffeeMachine order: 1.
Aschur scríobh: yellowCup, líne-nua.
>> blueCup := CoffeeMachine order: 0.
Aschur scríobh: blueCup, líne-nua.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Aschur scríobh: blackCup, líne-nua.
blackCup iarcheangail: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Aschur scríobh: orangeCup, líne-nua.
