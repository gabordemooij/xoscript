Uimhir ar: ['factorial'] déan: {
	>> total := 1.
	{ :index total iolraigh-faoi: (féin - (index)). } × féin. <- total.
}.
>> Printer := Réad nua.
Printer ar: ['print:and:'] déan: { :x :y
	Aschur scríobh: ['a='] + x + [', b='] + y, líne-nua.
}.
>> a := 4.5. >> b := a slánaigh-síos.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a slánaigh-suas.
Printer print: a and: b.
a := 4.5. b := a slánaigh-síos.
Printer print: a and: b.
a := 4.5. b := a slánaigh.
Printer print: a and: b.
a := 4.2. b := a slánaigh.
Printer print: a and: b.

Aschur scríobh: (9 modal: 5), líne-nua.
Aschur scríobh: -666 dearbhluach, líne-nua.
Aschur scríobh: 49 fréamh-chearnach, líne-nua.
Aschur scríobh: (2 cumhacht: 3), líne-nua.
>> l := (Liosta ← 9 ; 6).
Aschur scríobh: l íosmhéid.

