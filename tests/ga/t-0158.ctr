>> x := [' hallo '].

>> y := x cás-uachtair.
Aschur scríobh: x, líne-nua.
Aschur scríobh: (x cothrom-le: y), líne-nua.

>> y := x cás-íochtair.
Aschur scríobh: x, líne-nua.
Aschur scríobh: (x cothrom-le: y), líne-nua.

>> y := x bearr.
Aschur scríobh: x, líne-nua.
Aschur scríobh: (x cothrom-le: y), líne-nua.

>> y := x fritháireamh: 1.
Aschur scríobh: x, líne-nua.
Aschur scríobh: (x cothrom-le: y), líne-nua.

>> y := x ó: 1 fad: 2.
Aschur scríobh: x, líne-nua.
Aschur scríobh: (x cothrom-le: y), líne-nua.