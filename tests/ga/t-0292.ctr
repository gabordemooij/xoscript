>> winery := { <- (	Foclóir nua
		cuir: 2 ag: ['merlot'],
		cuir: 3 ag: ['malbec'],
		cuir: 4 ag: ['syrah']
	).
}.

Aschur scríobh: (((winery tosaigh) - ['nothing']) comhair), líne-nua.
Aschur scríobh: (((winery tosaigh) - ['merlot']) comhair), líne-nua.
Aschur scríobh: (((winery tosaigh) - ['malbec']) comhair), líne-nua.
Aschur scríobh: (((winery tosaigh) - ['syrah']) comhair), líne-nua.
Aschur scríobh: (((winery tosaigh) - ['merlot'] - ['malbec']) comhair), líne-nua.
Aschur scríobh: (((winery tosaigh) - ['merlot'] - ['syrah']) comhair), líne-nua.
Aschur scríobh: (((winery tosaigh) - ['malbec'] -['syrah']) comhair), líne-nua.
Aschur scríobh: (((winery tosaigh) - ['malbec'] - ['syrah'] - ['merlot']) comhair), líne-nua.

