# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob nua: 8, bytes: (
	Liosta nua ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Aschur scríobh: ( utf16 díchódaigh: ['utf16le'] ), líne-nua.

utf16 saor.
>> utf32 := Blob nua: 13, bytes: (
	Liosta nua ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Aschur scríobh: ( utf32 díchódaigh: ['utf32be'] ), líne-nua.
utf32 saor.