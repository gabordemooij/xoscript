>> echo := Réad nua.
echo ar: ['freagair:'] déan: { :sound
	{ Aschur scríobh: sound. } × 2.
}.
echo ho!. 


echo := Réad nua.
echo ar: ['freagair:agus:'] déan: { :sound :x
	{ Aschur scríobh: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := Réad nua.
echo ar: ['freagair:agus:agus:'] déan: { :operation :sound :x
	{ Aschur scríobh: sound. } × x.
}.
echo shout: ['la'] times: 4. 


