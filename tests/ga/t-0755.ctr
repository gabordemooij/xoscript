Aschur scríobh: ['Test object'], líne-nua.
>> greeter := Réad nua.
greeter ar: ['name:'] déan: { :ainm
	dílis xname := ainm. 
}.
greeter ar: ['greet'] déan: {
	Aschur scríobh: ['Hello '] + dílis xname, líne-nua.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Aschur scríobh: ['========== RELOADING SNAP:'], líne-nua.
>> b := Réad load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
