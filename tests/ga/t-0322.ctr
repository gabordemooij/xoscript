

>> Matryoshka := Réad nua.
Matryoshka ar: ['double:'] déan: { :secret
	dílis secret := secret × 2.
}.
Matryoshka ar: ['nua:'] déan: { :secret
	>> answer := Neamhní.
	>> t := (secret > 255).
	Aschur scríobh: (secret + [' | '] + t), líne-nua.
	t fíor: {
		answer := secret.
	}, eile: {
		answer := Matryoshka athchúrsach nua: (féin double: secret).
	}. <- answer.
}.

>> x := Matryoshka nua: 2.
