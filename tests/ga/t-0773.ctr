Aschur scríobh: ['Test object'], líne-nua.
>> a := Réad nua. 
a ar: ['item:'] déan: { :int64
	dílis int64 := int64. 
}.
a ar: ['item'] déan: { <- dílis int64.
}.
a item: ( Int64 as-teaghrán: ['9999'] ).
Aschur scríobh: a item, líne-nua.
>> old-int64-address := a item fréamhshamhail seoladh-cuimhne.
a save-as: ['/tmp/a.bin'].
Aschur scríobh: ['========== RELOADING SNAP:'], líne-nua.
>> b := Réad load-from: ['/tmp/a.bin'].
(b item fréamhshamhail seoladh-cuimhne = old-int64-address) fíor: {
	Aschur scríobh: ['Object link re-attached.'], líne-nua.
}.
Aschur scríobh: ( b item ), líne-nua.
