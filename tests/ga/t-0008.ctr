>> Greeter := Réad nua.
Greeter ar: ['make'] déan: {
	>> greeter := Réad nua.
	greeter ar: ['name:'] déan: { :ainm
		Aschur scríobh: ['setting a name'].
		dílis myName := ainm.
	}.
	greeter ar: ['greet'] déan: {
		Aschur scríobh: ['Hello'].
		Aschur scríobh: dílis myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
