# catch-all test (practical)
>> HTML := Teaghrán nua.
HTML ar: ['encode:'] déan: { :tekst
	féin iarcheangail: (tekst
	ionadaigh: ['&'] le: ['&amp;'], 
	ionadaigh: ['<'] le: ['&lt;'],
	ionadaigh: ['>'] le: ['&gt;'],
	ionadaigh: ['"'] le: ['&quot;']).
}.
>> blog := HTML nua.
blog iarcheangail: ['<h1>'],
     encode: ['Koffie & Thee'],
     iarcheangail: ['</h1>'].
Aschur scríobh: blog, líne-nua.


>> Roman := Uimhir nua.
Roman ar: ['stringy'] déan: {
	>> a := [''].
	{ a iarcheangail: ['I']. } × féin. <- a.
}.

>> x := Roman nua.
x suimigh: 3.
Aschur scríobh: x stringy, líne-nua.

>> Quantum := Boole nua.
Quantum ar: ['true?'] déan: { <- ['maybe True']. }.
Aschur scríobh: (Quantum nua true?), líne-nua.

>> Nihil := Neamhní nua.
Nihil ar: ['teaghrán'] déan: { <- ['Nihil']. }.
Aschur scríobh: (Nihil nua), líne-nua.
