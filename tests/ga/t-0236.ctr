>> Slurp := Réad nua.
Slurp ar: ['nua'] déan: {
	dílis str := [''].
}.


Slurp ar: ['freagair:'] déan: { :blah
		(dílis str ≠ ['']) fíor: {
			dílis str iarcheangail: [' '].
		}.
		dílis str iarcheangail: blah.
}.
Slurp ar: ['freagair:agus:'] déan: { :blah :blahah
		(dílis str ≠ ['']) fíor: {
			dílis str iarcheangail: [' '].
		}.
		(blah fad > 1) fíor: {
			dílis str iarcheangail: (blah ó: 0 fad: (blah fad - 1)).
		}, eile: {
			dílis str iarcheangail: blah.
		}.
		dílis str iarcheangail: [' '].
		dílis str iarcheangail: blahah.
}.
Slurp ar: ['obtain'] déan: {
	>> buffer := dílis str.
	dílis str := ['']. <- buffer.
}.

>> paraiméadair-chuardaigh := Slurp nua.
paraiméadair-chuardaigh select: ['*'], from users where: ['id = 2'].
Aschur scríobh: (paraiméadair-chuardaigh obtain), líne-nua.
