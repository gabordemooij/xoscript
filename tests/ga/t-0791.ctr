Server init.

>> DB := Maria-DB nua óstach: ['localhost'],
	ainm-úsáideora: ['xo'],
	pasfhocal: ['pass123'],
	ainm-bunachair: ['xobase'],
	ceangail.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> paraiméadair-chuardaigh := Maria-Iarratas nua: SQL.

# set database
paraiméadair-chuardaigh bunachar-sonraí: DB.

paraiméadair-chuardaigh faigh-sonraí: { :row
	Aschur scríobh: row world, líne-nua.
}.
