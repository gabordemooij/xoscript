>> makeAdder := { :x
	>> f := { :y <- (dílis x + y). } socraigh: ['x'] luach: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i dílis q cuir: (dílis f feidhmigh: (dílis q ? i)) ag: i. } 
	socraigh: ['q'] luach: array,
	socraigh: ['f'] luach: func.
	{ :i mapping feidhmigh: i. } × (array comhair).
}.

>> a := Liosta ← 1; 2; 3.
mapper feidhmigh: a agus: (makeAdder feidhmigh: 100).
Aschur scríobh: (a ionad: 0), líne-nua.
Aschur scríobh: (a ? 1), líne-nua.
Aschur scríobh: (a ? 2), líne-nua.
