# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Patrún nua: pattern.
	p meaitseáil: subject déan: { :m :g
		Aschur scríobh: g comhair, scríobh: [' '], scríobh: (g ceangail: ['|']), líne-nua. <- m.
	}.
}.
show feidhmigh: ['(a)|(b)'] agus: ['b'].
show feidhmigh: ['(a)|(b)'] agus: ['a'].
show feidhmigh: ['(x)?y'] agus: ['y'].
show feidhmigh: ['(x)?(y)(z)?'] agus: ['xy'].
