# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Ríomhchlár shell-escape: ['abc'].
Aschur scríobh: c, líne-nua.
Aschur scríobh: ( Ríomhchlár córas: ['echo '] + c ), líne-nua.

c := Ríomhchlár shell-escape: ['a'b'c'].
Aschur scríobh: c, líne-nua.
Aschur scríobh: ( Ríomhchlár córas: ['echo '] + c ), líne-nua.

c := Ríomhchlár shell-escape: ['a\'c'].
Aschur scríobh: c, líne-nua.
Aschur scríobh: ( Ríomhchlár córas: ['echo '] + c ), líne-nua.