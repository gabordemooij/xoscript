Uimhir ar: ['factorial'] déan: {
	>> total := 1.
	{ :index total iolraigh-faoi: (féin - index). } × féin. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Ríomhchlár bainistíocht-cuimhne: 0.

{
2 exponent factorial.
Aschur scríobh: (11 modal: 3), líne-nua.
Aschur scríobh: (3.4 slánaigh), líne-nua.
Aschur scríobh: (7.1 slánaigh-suas), líne-nua.
Aschur scríobh: (7.9 slánaigh-síos), líne-nua.
}
tosaigh.

Ríomhchlár glan-suas.

usedMemory1 := (Ríomhchlár cuimhne ? 0).

{
2 exponent factorial.
Aschur scríobh: (11 modal: 3), líne-nua.
Aschur scríobh: (3.4 slánaigh), líne-nua.
Aschur scríobh: (7.1 slánaigh-suas), líne-nua.
Aschur scríobh: (7.9 slánaigh-síos), líne-nua.
}
tosaigh.

Ríomhchlár glan-suas.
usedMemory2 := (Ríomhchlár cuimhne ? 0).


{
2 exponent factorial.
Aschur scríobh: (11 modal: 3), líne-nua.
Aschur scríobh: (3.4 slánaigh), líne-nua.
Aschur scríobh: (7.1 slánaigh-suas), líne-nua.
Aschur scríobh: (7.9 slánaigh-síos), líne-nua.
} tosaigh.

Ríomhchlár glan-suas.
usedMemory3 := (Ríomhchlár cuimhne ? 0).



( usedMemory1 = usedMemory2 agus: usedMemory1 = usedMemory3, agus: usedMemory2 = usedMemory3 ) fíor: {
	Aschur scríobh: ['No memory leaks here'].
}, bréagach: {
	Aschur scríobh: ['Leaking memory...'].
}.
