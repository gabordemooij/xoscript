#Linux
>> clock := Tráth nua.
clock crios: ['UTC-1'].
clock bliain: 1981, mí: 1, lá: 5,
      uair: 13, nóiméad: 15, soicind: 13.

Aschur scríobh: clock, líne-nua.
clock crios: ['UTC+0'].

Aschur scríobh: (
	(clock bliain lom) + ['-'] + (clock mí) + ['-'] + (clock lá) + [' '] +
	(clock uair) + [':'] + (clock nóiméad) + [':'] + (clock soicind) + [' '] +
	['W'] + (clock seachtain) + (clock crios)
), líne-nua.


clock crios: ['UTC-1'].
Aschur scríobh: (
	(clock bliain lom) + ['-'] + (clock mí) + ['-'] + (clock lá) + [' '] +
	(clock uair) + [':'] + (clock nóiméad) + [':'] + (clock soicind) + [' '] +
	['W'] + (clock seachtain) + (clock crios)
), líne-nua.
