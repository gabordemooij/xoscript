


>> wine := Réad nua.


wine ar: ['toString'] déan: { <- ['merlot'].
}.

wine ar: ['naarTekst'] déan: { <- ['merlot'].
}.


wine ar: ['='] déan: { :other wine <- ( féin toString = other wine ).
}.

wine ar: ['=='] déan: { :other wine <- ( féin toString = other wine ).
}.



wine
	cás: ['cabernet'] déan: { Aschur scríobh: ['it's a Cabernet!']. },
	cás: ['syrah']    déan: { Aschur scríobh: ['it's a Syrah!'].    },
	cás: ['merlot']   déan: { Aschur scríobh: ['it's a Merlot!'].   },
	cás: ['malbec']   déan: { Aschur scríobh: ['it's a Malbec!'].   }.

Aschur líne-nua.
