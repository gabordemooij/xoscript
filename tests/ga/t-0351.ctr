
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> cód := {
	>> o := (
		Foclóir nua
		aa: (Liosta ← 1 ; 2),
		bb: (Liosta ← 3 ; 4)
	).
	>> s := o teaghrán.
	>> o2 := s réad.
	(s  cineál = Teaghrán cineál) fíor: { Aschur scríobh: ['OK1'], líne-nua. }.
	(o2 cineál = Foclóir cineál) fíor: { Aschur scríobh: ['OK2'], líne-nua. }.
}.

Ríomhchlár bainistíocht-cuimhne: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Ríomhchlár glan-suas.
usedMemory1 := (Ríomhchlár cuimhne ? 1).
cód tosaigh.
Ríomhchlár glan-suas.
usedMemory2 := (Ríomhchlár cuimhne ? 1).
cód tosaigh.
Ríomhchlár glan-suas.
usedMemory3 := (Ríomhchlár cuimhne ? 1).
cód tosaigh.
Ríomhchlár glan-suas.
usedMemory4 := (Ríomhchlár cuimhne ? 1).

(usedMemory2 = usedMemory3 = usedMemory4) fíor: { Aschur scríobh: ['OK3'], líne-nua. }.
 
