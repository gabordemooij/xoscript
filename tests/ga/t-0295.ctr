
>> dictionary := (
	Foclóir nua
		cuir: ['b'] ag: ['a'],
		cuir: ['a'] ag: ['b'],
		cuir: ['z'] ag: ['x'],
		cuir: ['hello'] ag: ['hallo'],
		cuir: ['human'] ag: ['human']
).

>> comparisons := Liosta nua.
dictionary gach: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a cuir-i-gcomparáid: b)
	).
}.

comparisons sórtáil: { :a :b <- ( a cuir-i-gcomparáid: b ). }.
Aschur scríobh: ( comparisons ceangail: ['↵'] ), líne-nua.
comparisons ceangail: ['↵'].
