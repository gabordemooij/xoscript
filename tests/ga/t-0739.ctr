Aschur scríobh: ['Test object'], líne-nua.
>> a := Réad nua. 

a ar: ['item:'] déan: { :binhelper
	dílis binhelper := binhelper. 
}.

a ar: ['item'] déan: { <- dílis binhelper.
}.

a item: Bin nua.

>> old-binhelper-address := a item fréamhshamhail seoladh-cuimhne.
a save-as: ['/tmp/a.bin'].
Aschur scríobh: ['========== RELOADING SNAP:'], líne-nua.

>> b := Réad load-from: ['/tmp/a.bin'].

(b item fréamhshamhail seoladh-cuimhne = old-binhelper-address) fíor: {
	Aschur scríobh: ['Object link re-attached.'], líne-nua.
}.


