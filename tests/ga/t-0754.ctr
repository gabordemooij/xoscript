Aschur scríobh: ['Test object'], líne-nua.
>> a := Réad nua. 

a ar: ['item:'] déan: { :out
	dílis out := out. 
}.

a ar: ['item'] déan: { <- dílis out.
}.

a ar: ['greet'] déan: {
	Aschur scríobh: ['hi from original out!'], líne-nua.
}.

a item: Aschur.

Aschur scríobh: a item, líne-nua.

>> old-out-address := a item fréamhshamhail seoladh-cuimhne.
a save-as: ['/tmp/a.bin'].
Aschur scríobh: ['========== RELOADING SNAP:'], líne-nua.

>> b := Réad load-from: ['/tmp/a.bin'].

(b item fréamhshamhail seoladh-cuimhne = old-out-address) fíor: {
	Aschur scríobh: ['Object link re-attached.'], líne-nua.
}.

b item scríobh: ['hello from loaded out!'], líne-nua.
b greet.
