>> Grandfather := Réad nua.
Grandfather ar: ['greet'] déan: {
	Aschur scríobh: ['Ave!'], líne-nua.
}.
>> Father := Grandfather nua.
Father ar: ['greet'] déan: {
	Aschur scríobh: ['Hello'], líne-nua.
	féin greet.
}.
>> Son := Father nua.
Son ar: ['greet'] déan: {
	Aschur scríobh: ['Hi'], líne-nua.
	féin greet.
}.

Son greet.

>> Roundabout := Réad nua.
Roundabout ar: ['circle:'] déan: { :x
	Aschur scríobh: x, líne-nua.
	(x < 3) fíor: { féin athchúrsach circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) fíor: { Aschur scríobh: x, líne-nua. x suimigh: 1.  increment tosaigh. }. }.
increment tosaigh.