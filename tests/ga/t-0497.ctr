Server init.

# write a test file
>> f := Comhad nua: ['/tmp/test.gif'].
f scríobh: ['GIF87a01234567810'].

# serve the file
Server seol-ar-aghaidh: ['test.gif'] réimír: ['/tmp/'].

Aschur líne-nua.

Aschur scríobh: ['Outside container (security):'], líne-nua.
{ Server seol-ar-aghaidh: ['../passwd'] réimír: ['/tmp/']. }
gabh: { :e Aschur scríobh: e, líne-nua. },
tosaigh.

Aschur scríobh: ['Invalid prefix:'], líne-nua.
{ Server seol-ar-aghaidh: ['test.gif'] réimír: ['z:\\']. }
gabh: { :e Aschur scríobh: e, líne-nua. },
tosaigh.

Aschur scríobh: ['Non-existant file:'], líne-nua.
{ Server seol-ar-aghaidh: ['xxx.xxx'] réimír: ['/tmp/']. }
gabh: { :e Aschur scríobh: e, líne-nua. },
tosaigh.
