>> a := Liosta ← Réad ; Fíor ; Bréagach ; Boole ; 1 ; Uimhir ; ['Str'] ; Teaghrán ; { ['Empty']. }.
Aschur scríobh: (a comhair), líne-nua.
{ :i
	Aschur scríobh: 
	['a '] + 
	((a ? i) cineál) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Neamhní?) ceachtar: [''] nó: ['NOT']) + 
	[' Nil.'],
	líne-nua.
} × (a comhair).
Aschur scríobh: ['but.. Nil is.. '] + ((Neamhní Neamhní?) ceachtar: ['certainly NIL!'] nó: ['not NIL??']), líne-nua.