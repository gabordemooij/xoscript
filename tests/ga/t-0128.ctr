
Liosta ar: ['sum'] déan: {
	>> total := 0.
	féin gach: { :index :element
		total suimigh: element.
	}. <- total.
}.

>> a := Liosta ← 9 ; 8 ; 7.
Aschur scríobh: (a sum), líne-nua. 
>> a := Liosta ← 1 ; 9.
Aschur scríobh: (a sum), líne-nua. 
>> a := Liosta ← ['o'] ; 2.
Aschur scríobh: (a sum), líne-nua. 
Aschur scríobh: (Liosta nua sum), líne-nua. 
