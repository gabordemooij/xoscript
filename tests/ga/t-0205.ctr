>> str := ['write:'].
Aschur teachtaireacht: ['scríobh:'] argóintí: (Liosta ← ['Hello World']), líne-nua. 

Uimhir ar: ['isbetween:and:'] déan: { :a :b <- ((féin ≥ a) agus: (féin ≤ b)).
}.

str := ['isbetween:and:'].
Aschur scríobh: (3 teachtaireacht: str argóintí: (Liosta ← 2 ; 8)), líne-nua.
Aschur scríobh: (3 teachtaireacht: str argóintí: (Liosta ← 1 ; 2)), líne-nua.


>> CoffeeMachine := Réad nua.
CoffeeMachine ar: ['makeCoffeeWithSugar:milk:'] déan: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Liosta ← 4 ; 2.
Aschur scríobh: ( CoffeeMachine teachtaireacht: order argóintí: coffeeConfiguration ), líne-nua.
