(usedMemory1 = usedMemory2 = usedMemory3 = usedMemory4 = usedMemory5) fíor: {
	Aschur scríobh: ['Memory usage remains stable.'], líne-nua.
}, eile: {
	Aschur scríobh: ['Used memory not stable.'], líne-nua.
	Aschur scríobh: usedMemory1, líne-nua.
	Aschur scríobh: usedMemory2, líne-nua.
