Aschur scríobh: ['Test object'], líne-nua.
>> a := Réad nua. 

a ar: ['item:'] déan: { :boole
	dílis boole := boole. 
}.

a ar: ['item'] déan: { <- dílis boole.
}.

a item: Fíor.

Aschur scríobh: a item, líne-nua.

>> old-bool-address := a item fréamhshamhail seoladh-cuimhne.
a save-as: ['/tmp/a.bin'].
Aschur scríobh: ['========== RELOADING SNAP:'], líne-nua.

>> b := Réad load-from: ['/tmp/a.bin'].

(b item fréamhshamhail seoladh-cuimhne = old-bool-address) fíor: {
	Aschur scríobh: ['Object link re-attached.'], líne-nua.
}.

Aschur scríobh: b item, líne-nua.
