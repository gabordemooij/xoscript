

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Ríomhchlár bainistíocht-cuimhne: 0.

>> a := Liosta nua.
>> b := Liosta ← 1 ; 2.

Ríomhchlár glan-suas.
usedMemory1 := (Ríomhchlár cuimhne ? 0).


a := Liosta nua.
b := Liosta ← 1 ; 2.

Ríomhchlár glan-suas.
usedMemory2 := (Ríomhchlár cuimhne ? 0).


a := Liosta nua.
b := Liosta ← 1 ; 2.

