# fewer parameters than placeholders must give an error, not read past the bindings
Server init.

>> db := Maria-DB nua óstach: ['localhost'],
	ainm-úsáideora: ['xo'],
	pasfhocal: ['pass123'],
	ainm-bunachair: ['xobase'],
	ceangail.

>> paraiméadair-chuardaigh := db iarratas: ['SELECT ? AS a, ? AS b, ? AS c'].
paraiméadair-chuardaigh paraiméadair: (Liosta nua ; ['1']).
{ paraiméadair-chuardaigh faigh-sonraí: { :row Aschur scríobh: row, líne-nua. }. } gabh: { :e Aschur scríobh: e, líne-nua. }, tosaigh.

>> paraiméadair-chuardaigh := db iarratas: ['SELECT ? AS a'].
{ paraiméadair-chuardaigh faigh-sonraí: { :row Aschur scríobh: row, líne-nua. }. } gabh: { :e Aschur scríobh: e, líne-nua. }, tosaigh.

# the right number still works, more parameters are ignored as before
>> paraiméadair-chuardaigh := db iarratas: ['SELECT ? AS a, ? AS b'].
paraiméadair-chuardaigh paraiméadair: (Liosta nua ; ['1'] ; ['2']).
paraiméadair-chuardaigh faigh-sonraí: { :row Aschur scríobh: (row ag: ['a']), scríobh: (row ag: ['b']), líne-nua. }.
paraiméadair-chuardaigh paraiméadair: (Liosta nua ; ['1'] ; ['2'] ; ['3']).
paraiméadair-chuardaigh faigh-sonraí: { :row Aschur scríobh: (row ag: ['a']), scríobh: (row ag: ['b']), líne-nua. }.
