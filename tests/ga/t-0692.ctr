Server init.

Aschur scríobh: (
	Patrún nua: ['^\\w+$'],
	meaitseáil: ['test@example.com'] 
), líne-nua. # 0 match, fails on @ and .

Aschur scríobh: (
	Patrún nua: ['^[^@]+@[^\.]+\.\\w+$'],
	meaitseáil: ['test@example.com'] 
), líne-nua. # 1 match

Aschur scríobh: (
	Patrún nua: ['[^@]+@[^\.]+\.\\w+'],
	meaitseáil: ['test@example.com'] 
), líne-nua. # 1 match

Aschur scríobh: (
	Patrún nua: ['([^@]+)@([^\.]+)\.\\w+'],
	meaitseáil: ['test@example.com'] 
), líne-nua. # 1 match, groups dont matter

Aschur scríobh: (
	Patrún nua: ['[a-z]'],
	meaitseáil: ['test@example.com'] 
), líne-nua. # 14 matches

Aschur scríobh: (
	Patrún nua: ['.*'],
	meaitseáil: ['test@example.com'] 
), líne-nua. # 1 match (all)

Aschur scríobh: (
	Patrún nua: ['(.*)'],
	meaitseáil: ['test@example.com'] 
), líne-nua. # 1 match (all)

Aschur scríobh: (
	Patrún nua: ['\\s*[^@]+@[^\.]+\.\\w+'],
	meaitseáil: ['test@example.com'] 
), líne-nua. # 1 match, prefix space optional, gets ignored