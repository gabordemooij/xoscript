Uimhir ar: ['roman'] déan: {
	>> uimhir := féin cóipeáil.
	>> roman := [''].
	{
		{
			(uimhir ≥ 1000) fíor: {
				roman iarcheangail: ['Ⅿ'].
				uimhir dealaigh: 1000.
			}, bris.
		
			(uimhir ≥ 500) fíor: {
				roman iarcheangail: ['Ⅾ'].
				uimhir dealaigh: 500.
			}, bris.
		
			(uimhir ≥ 100) fíor: {
				roman iarcheangail: ['Ⅽ'].
				uimhir dealaigh: 100.
			}, bris.
		
			(uimhir ≥ 50) fíor: {
				roman iarcheangail: ['Ⅼ'].
				uimhir dealaigh: 50.
			}, bris.
		
			(uimhir ≥ 50) fíor: {
				roman iarcheangail: ['Ⅼ'].
				uimhir dealaigh: 50.
			}, bris.
		
			(uimhir ≥ 10) fíor: {
				roman iarcheangail: ['Ⅹ'].
				uimhir dealaigh: 10.
			}, bris.
			
			(uimhir ≥ 9) fíor: {
				roman iarcheangail: ['Ⅸ'].
				uimhir dealaigh: 9.
			}, bris.
			
			(uimhir ≥ 5) fíor: {
				roman iarcheangail: ['Ⅴ'].
				uimhir dealaigh: 5.
			}, bris.
			
			(uimhir ≥ 4) fíor: {
				roman iarcheangail: ['Ⅳ'].
				uimhir dealaigh: 4.
			}, bris.
			
			(uimhir ≥ 1) fíor: {
				roman iarcheangail: ['Ⅰ'].
				uimhir dealaigh: 1.
			}, bris.
		} nós-imeachta.
	} fad-is: { <- uimhir > 0. }. <- roman.
}.

Aschur scríobh: 1 roman, líne-nua.
Aschur scríobh: 2 roman, líne-nua.
Aschur scríobh: 4 roman, líne-nua.
Aschur scríobh: 8 roman, líne-nua.
Aschur scríobh: 16 roman, líne-nua.
Aschur scríobh: 32 roman, líne-nua.
Aschur scríobh: 64 roman, líne-nua.
Aschur scríobh: 128 roman, líne-nua.
Aschur scríobh: 256 roman, líne-nua.
Aschur scríobh: 1024 roman, líne-nua.
