#OBSD
>> dirname := [''].
{ dirname iarcheangail: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Ríomhchlár córas: command.
Ríomhchlár chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename iarcheangail: ['YYYYYYYY']. } * 20.
Comhad nua: filename, scríobh: ['sometext'].
{ Comhad liosta: ['/tmp/'] + dirname. } * 1000.
Aschur scríobh: ['no crash'], líne-nua.

