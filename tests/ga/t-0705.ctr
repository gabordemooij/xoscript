

>> obj := Réad nua.

obj ar: ['greet'] déan: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj ar: ['task'] déan: {
	dílis property := 123.
	{
		# try binds self/own to object instead of block
		Aschur scríobh: féin greet.
		Aschur scríobh: dílis property.
		1 / 0.
	} gabh: {
		Aschur scríobh: féin greet.
		Aschur scríobh: dílis property.
		Aschur scríobh: ['ok'].
	}, triail.
}.

obj task.