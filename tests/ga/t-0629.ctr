# database test
# see example server.xo for required config

Server init.
Aschur scríobh: ['Database test'], líne-nua.

>> db := Maria-DB nua óstach: ['localhost'],
	ainm-úsáideora: ['xo'], pasfhocal: ['pass123'], ainm-bunachair: ['xobase'], ceangail.

Aschur scríobh: ['Can we connect? '] + db ceangailte?, líne-nua.

>> paraiméadair-chuardaigh := db iarratas: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], paraiméadair: ( Liosta nua ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  paraiméadair-chuardaigh rith-ordú. db deimhnigh. } gabh: { :e db cealaigh.  }, tosaigh.

Aschur scríobh: ['Can we insert? '] + ( paraiméadair-chuardaigh insert-id > 0 ), líne-nua.

>> Obj := Réad nua.
Obj ar: ['retrieve-rows'] déan: {
	dílis comhair := 0.
	>> paraiméadair-chuardaigh :=
	db iarratas: ['SELECT * FROM book order by id desc limit 2'], 
	faigh-sonraí: { :row 
		dílis comhair suimigh: 1.
		Fíor bris.
	}. <- dílis comhair cóipeáil.
}.

Aschur scríobh: ['Can we query? '] + ( Obj retrieve-rows > 0 ), líne-nua.
