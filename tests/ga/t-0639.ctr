
Server init.
Aschur scríobh: ['Database test'], líne-nua.

>> db := Maria-DB nua óstach: ['localhost'],
	ainm-úsáideora: ['xo'], 
	pasfhocal: ['pass123'],
	ainm-bunachair: ['xobase'],
	ceangail.

>> paraiméadair-chuardaigh :=
db iarratas: ['SELECT REPEAT('Blah',1000) AS blah'], 
faigh-sonraí: { :row 
	Aschur scríobh: row blah fad, líne-nua.
}.
