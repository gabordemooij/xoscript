Liosta ar: ['sum'] déan: {
	>> total := 0.
	féin gach: { :index :element
		total suimigh: element.
	}. <- total.
}.

>> a := Fíor.



a ar: ['teaghrán'] déan: {
	>> answer := Neamhní.
	( féin = Fíor ) fíor: {
		answer := ['Yep'].
	}, eile: {
		answer := ['Nope'].
	}. <- answer.
}.

a ar: ['uimhir'] déan: {
	>> answer := Neamhní.
	( féin = Fíor ) fíor: {
		answer := 10.
	}, eile: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b ar: ['teaghrán'] déan: { <- ['Devil'].
}.

b ar: ['boole'] déan: { <- Bréagach.
}.


Aschur scríobh: a, líne-nua.  
Aschur scríobh: (90 + a), líne-nua. 
Aschur scríobh: b, líne-nua. 
Aschur scríobh: (Fíor agus: b), líne-nua.

a := Liosta ← ['hello'] ; ['world'] ; Fíor ; Neamhní ; 666. 
a := a + ( Liosta ← 1 ).
Aschur scríobh: a, líne-nua.
Aschur scríobh: ((Foclóir nua) cuir: Neamhní ag: Neamhní), líne-nua.
Aschur scríobh: a sum, líne-nua. 


{
	a ar: ['teaghrán'] déan: { <- Neamhní. }.
	a := [''] + a.
} gabh: { :error
	Aschur scríobh: ['Error noted: '] + error, líne-nua.
}, tosaigh.



{
	a ar: ['uimhir'] déan: { <- Neamhní. }.
	a := 3 × a.
} gabh: { :error
	Aschur scríobh: ['Error noted: '] + error, líne-nua.
}, tosaigh.


{
	a ar: ['boole'] déan: { <- Neamhní. }.
	a := Fíor agus: a. 
} gabh: { :error
	Aschur scríobh: ['Error noted: '] + error, líne-nua.
}, tosaigh.





{
	a ar: ['teaghrán'] déan: { <- Bréagach. }.
	a := [''] + a.
} gabh: { :error
	Aschur scríobh: ['Error noted: '] + error, líne-nua.
}, tosaigh.



{
	a ar: ['uimhir'] déan: { <- Fíor. }.
	a := 3 × a.
} gabh: { :error
	Aschur scríobh: ['Error noted: '] + error, líne-nua.
}, tosaigh.


{
	a ar: ['boolean'] déan: { <- 1. }.
	a := Fíor agus: a.
} gabh: { :error
	Aschur scríobh: ['Error noted: '] + error, líne-nua.
}, tosaigh.





