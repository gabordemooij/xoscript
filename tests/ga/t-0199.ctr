
Ríomhchlár bainistíocht-cuimhne: 4.

>> Animal := Réad nua.
Animal ar: ['make'] déan: {
	>> animal := Réad nua.
	animal ar: ['makeSound'] déan: {
		Aschur scríobh: dílis sound.
	}. <- animal.
}.
>> Cat := Réad nua.
Cat ar: ['make'] déan: {
	>> cat := Animal make.
	cat ar: ['init'] déan: {
		dílis sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
