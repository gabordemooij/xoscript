Ríomhchlár bainistíocht-cuimhne: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } gabh: {
		oops suimigh: 1.
	}, tosaigh.
} × 1000.

{
	Aschur scríobh: ['hi there!'].
	an-tasc-seo earráid: ['oops'].
	Aschur scríobh: ['hi there!'].
	{ Aschur scríobh: ['dont print this']. } tosaigh.
} gabh: { :e 
	Aschur scríobh: ['got ya!']. 
	Aschur scríobh: e.
}, tosaigh.
