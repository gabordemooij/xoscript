# a value ending in the first part of an opening quote must survive serialization
>> luachanna := Liosta nua
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

luachanna gach: { :i :value
	>> d := Foclóir nua.
	d cuir: value ag: ['k'].
	d cuir: ['second'] ag: ['j'].
	>> r := d cód réad.
	Aschur scríobh: r comhair, líne-nua.
	Aschur scríobh: ( (r ag: ['k']) = value ), líne-nua.
}.
