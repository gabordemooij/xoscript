

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Ríomhchlár bainistíocht-cuimhne: 0.

>> txt := ['World Salad'].
Aschur scríobh: ['this text contains: '] + ( ( txt scoilt: [' '] ) comhair ) + [' words.'], líne-nua.
txt := txt ó: 6 fad: 4.
Aschur scríobh: txt, líne-nua.

Ríomhchlár glan-suas.

usedMemory1 := (Ríomhchlár cuimhne ? 0).


txt := ['World Salad'].
Aschur scríobh: ['this text contains: '] + ( ( txt scoilt: [' '] ) comhair ) + [' words.'], líne-nua.
txt := txt ó: 6 fad: 4.
