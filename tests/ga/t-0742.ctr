Aschur scríobh: ['Test object'], líne-nua.
>> a := Réad nua. 

a ar: ['item:'] déan: { :hexhelper
	dílis hexhelper := hexhelper. 
}.

a ar: ['item'] déan: { <- dílis hexhelper.
}.

a item: Hx nua.

>> old-hexhelper-address := a item fréamhshamhail seoladh-cuimhne.
a save-as: ['/tmp/a.bin'].
Aschur scríobh: ['========== RELOADING SNAP:'], líne-nua.

>> b := Réad load-from: ['/tmp/a.bin'].

(b item fréamhshamhail seoladh-cuimhne = old-hexhelper-address) fíor: {
	Aschur scríobh: ['Object link re-attached.'], líne-nua.
}.
