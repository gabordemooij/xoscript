#Linux
>> OS := Ríomhchlár socrú: ['OS'].

>> clock := Tráth nua.
	
(OS = ['Haiku']) fíor: {
	clock crios: ['CET'],
	bliain: 2017, mí: 7, lá: 13,
	uair: 18, nóiméad: 0, soicind: 0.
}, eile: {
	clock crios: ['Europe/Amsterdam'],
	bliain: 2017, mí: 7, lá: 13,
	uair: 18, nóiméad: 0, soicind: 0.
}.

clock ar: ['tell'] déan: {
	Aschur scríobh: féin, líne-nua.
}.


clock suimigh: 2    uair, tell.
clock suimigh: 1    uair, tell.
clock suimigh: 19 nóiméad, tell.
clock suimigh: 1  nóiméad, tell.
clock suimigh: 1  nóiméad, tell.
clock suimigh: 19 soicind, tell.
clock suimigh: 1  soicind, tell.
clock suimigh: 1  soicind, tell.
clock suimigh: 2    bliain, tell.
clock suimigh: 1    bliain, tell.

(OS = ['Haiku']) fíor: {
clock suimigh: 5   mí.
clock crios: ['CEST'], tell.
}, eile: {
	clock suimigh: 5   mí, tell.
}.

clock suimigh: 1   mí, tell.
clock suimigh: 19    lá, tell.
clock suimigh: 1    uair, tell.
clock suimigh: 120  yard, tell.
