>> Point := Réad nua.
Point ar: ['x-coordinate:'] déan: { :x dílis x := x. }.
Point ar: ['y-coordinate:'] déan: { :y dílis y := y. }.
Point ar: ['x-coordinate']  déan: { <- dílis x cóipeáil. }.
Point ar: ['y-coordinate']  déan: { <- dílis y cóipeáil. }.

Point ar: ['='] déan: { :other <- ( dílis x = other x-coordinate
		 agus: dílis y = other y-coordinate ).
}.

>> pier := Point nua x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point nua x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point nua x-coordinate: 5, y-coordinate: 6.

Aschur scríobh: pier = town-hall, líne-nua.
Aschur scríobh: pier = restaurant, líne-nua.
