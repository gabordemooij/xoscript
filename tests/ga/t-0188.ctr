

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Ríomhchlár bainistíocht-cuimhne: 0.

{ :i Aschur scríobh: i. } × 4.
Aschur líne-nua.
{ :i Aschur scríobh: (4 - i). } × 4.
Aschur líne-nua.
( 1 > 2 ) bréagach: { Aschur scríobh: ['BLOCK 1'], líne-nua. }.
( 2 > 1 ) fíor:  { Aschur scríobh: ['BLOCK 2'], líne-nua. }.

>> i := 0.
{ Aschur scríobh: i. i suimigh: 1. } fad-is: { <- ( i < 3). }.
Aschur líne-nua.

i := 3.
{ Aschur scríobh: i. i := i - 1. } fad-is: { <- ( i > 0). }.
Aschur líne-nua.


Ríomhchlár glan-suas.

usedMemory1 := (Ríomhchlár cuimhne ? 0).


{ :i  Aschur scríobh: i. } × 4.
Aschur líne-nua.
{ :i  Aschur scríobh: (4 - i). } × 4.
Aschur líne-nua.
( 1 > 2 ) bréagach: { Aschur scríobh: ['BLOCK 1'], líne-nua. }.
( 2 > 1 ) fíor:  { Aschur scríobh: ['BLOCK 2'], líne-nua. }.

>> i := 0.
{ Aschur scríobh: i. i suimigh: 1. } fad-is: { <- ( i < 3). }.
Aschur líne-nua.

i := 3.
{ Aschur scríobh: i. i := i - 1. } fad-is: { <- ( i > 0). }.
Aschur líne-nua.



Ríomhchlár glan-suas.
usedMemory2 := (Ríomhchlár cuimhne ? 0).


{ :i Aschur scríobh: i. } × 4.
Aschur líne-nua.
{ :i Aschur scríobh: (4 - i). } × 4.
Aschur líne-nua.
( 1 > 2 ) bréagach: { Aschur scríobh: ['BLOCK 1'], líne-nua. }.
( 2 > 1 ) fíor:  { Aschur scríobh: ['BLOCK 2'], líne-nua. }.

>> i := 0.
{ Aschur scríobh: i. i suimigh: 1. } fad-is: { <- ( i < 3). }.
Aschur líne-nua.

i := 3.
{ Aschur scríobh: i. i := i - 1. } fad-is: { <- ( i > 0). }.
Aschur líne-nua.

Ríomhchlár glan-suas.
usedMemory3 := (Ríomhchlár cuimhne ? 0).



( usedMemory1 = usedMemory2 agus: usedMemory1 = usedMemory3, agus: usedMemory2 = usedMemory3 ) fíor: {
	Aschur scríobh: ['No memory leaks here'].
}, bréagach: {
	Aschur scríobh: ['Leaking memory...'].
}.
