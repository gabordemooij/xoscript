>> usedMemory3 := (Ríomhchlár cuimhne ? 0).




x := 3.
y := ['Hello'].
q := { ['']. }.
p := Fíor.
a := Liosta ← 1 ; 2 ; 3 ; 5.
c := Réad nua.
c ar: ['greet:'] déan: { Aschur scríobh: ['greet!']. }.
c := Réad nua.
c ar: ['greet:'] déan: { Aschur scríobh: ['a different greet!'], líne-nua. }.


Ríomhchlár glan-suas.
>> usedMemory4 := (Ríomhchlár cuimhne ? 0).





x := 4.
y := ['Hello'].
q := { ['']. }.
p := Fíor.
