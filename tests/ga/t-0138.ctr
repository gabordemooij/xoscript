

Ríomhchlár bainistíocht-cuimhne: 1.

>> x := 0.
>> y := ['Hello'].
>> q := { ['']. }.
>> p := Fíor.
>> a := Liosta ← 1 ; 2 ; 3 ; 4.
>> c := Réad nua.
c ar: ['greet:'] déan: { Aschur scríobh: ['greet!']. }.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.
>> usedMemory5 := 0.

Ríomhchlár glan-suas.
>> usedMemory1 := (Ríomhchlár cuimhne ? 0).




x := 1.
y := ['Hello'].
q := { ['']. }.
p := Fíor.
a := Liosta ← 1 ; 2 ; 3 ; 5.
c := Réad nua.
c ar: ['greet:'] déan: { Aschur scríobh: ['greet!']. }.


Ríomhchlár glan-suas.
>> usedMemory2 := (Ríomhchlár cuimhne ? 0).




x := 2.
y := ['Hello'].
q := { ['']. }.
p := Fíor.
a := Liosta ← 1 ; 2 ; 3 ; 4.
c := Réad nua.
c ar: ['greet:'] déan: { Aschur scríobh: ['greet!']. }.

