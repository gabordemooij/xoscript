Server init.
Aschur scríobh: ['Database date test'], líne-nua.

>> db := Maria-DB nua óstach: ['localhost'],
	ainm-úsáideora: ['xo'], 
	pasfhocal: ['pass123'],
	ainm-bunachair: ['xobase'],
	ceangail.

>> paraiméadair-chuardaigh :=
db iarratas: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
faigh-sonraí: { :row
	Aschur scríobh: row datetest, líne-nua.
}.
