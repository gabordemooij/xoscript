Aschur scríobh: ['Test object'], líne-nua.
>> l := Liosta nua ; 1 ; ( Liosta nua ; (Tráth nua: 1) ; (Int64 as-teaghrán: ['321']) ; (Liosta nua ; 3)).
Aschur scríobh: l, líne-nua.
>> old-lst-address := l fréamhshamhail seoladh-cuimhne.
l save-as: ['/tmp/a.bin'].
Aschur scríobh: ['========== RELOADING SNAP:'], líne-nua.
>> b := Réad load-from: ['/tmp/a.bin'].
(b fréamhshamhail seoladh-cuimhne = old-lst-address) fíor: {
	Aschur scríobh: ['Object link re-attached.'], líne-nua.
}.
Aschur scríobh: b, líne-nua.
