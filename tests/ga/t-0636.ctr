# test url parsing

Server init.
>> url := URL as: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Aschur scríobh: ['scheme = '] + url scéim, líne-nua.
Aschur scríobh: ['host = '] + url óstach, líne-nua.
Aschur scríobh: ['port = '] + url port, líne-nua.
Aschur scríobh: ['path = '] + url conair, líne-nua.
Aschur scríobh: ['query = '] + url paraiméadair-chuardaigh, líne-nua.
Aschur scríobh: ['fragment = '] + url blúire, líne-nua.
