

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Ríomhchlár bainistíocht-cuimhne: 0.

>> txt := ['1.6'].
>> n := txt uimhir.
>> t := txt boole.
Aschur scríobh: n, líne-nua.
Aschur scríobh: t, líne-nua.
Aschur scríobh: n cineál, líne-nua.
Aschur scríobh: t cineál, líne-nua.

Ríomhchlár glan-suas.

usedMemory1 := (Ríomhchlár cuimhne ? 0).


txt := ['1.6'].
n := txt uimhir.
t := txt boole.
Aschur scríobh: n, líne-nua.
Aschur scríobh: t, líne-nua.
Aschur scríobh: n cineál, líne-nua.
Aschur scríobh: t cineál, líne-nua.

Ríomhchlár glan-suas.
usedMemory2 := (Ríomhchlár cuimhne ? 0).


txt := ['1.6'].
n := txt uimhir.
t := txt boole.
Aschur scríobh: n, líne-nua.
Aschur scríobh: t, líne-nua.
Aschur scríobh: n cineál, líne-nua.
Aschur scríobh: t cineál, líne-nua.

Ríomhchlár glan-suas.
usedMemory3 := (Ríomhchlár cuimhne ? 0).



( usedMemory1 = usedMemory2 agus: usedMemory1 = usedMemory3, agus: usedMemory2 = usedMemory3 ) fíor: {
	Aschur scríobh: ['No memory leaks here'].
}, bréagach: {
	Aschur scríobh: ['Leaking memory...'].
}.
