#ffi test


Server init.

Ríomhchlár bainistíocht-cuimhne: 4.

# for this test you need set a path to libc (puts)
>> libname := Ríomhchlár socrú: ['FFITESTLIB'].



Server nasc: (
 Liosta nua ;
 libname ;
 ['puts'] ;
 ( Liosta nua ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s saor.

# test with struct

>> a := Blob nua: 8.
a bytes: (
	Liosta <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Liosta <<: ['int'], ; ['int']).

Server nasc: (
	Liosta <<: ['@structtest'], ;
	['@structtest'] ;
	(Liosta <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Aschur scríobh: ['Sum test:'] + (ffitest ffisum: a), líne-nua.

struct saor-struct.
struct saor.
a saor.
