#Linux

(Comhad nua: ['/tmp/testje']) ann bréagach: {
	Ríomhchlár córas: ['mkdir /tmp/testje'].	
}.

(Comhad nua: ['/tmp/testje/file1']) ann bréagach: {
	Ríomhchlár córas: ['touch /tmp/testje/file1'].	
}.

(Comhad nua: ['/tmp/testje/folder1']) ann bréagach: {
	Ríomhchlár córas: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Comhad liosta: ['/tmp/testje'].

>> q := Liosta nua.

l gach: { :k :v v gach: { :x :y q iarcheangail: y. }. }.

>> s := q teaghrán.

(s cuimsíonn: ['file1']) fíor:   { Aschur scríobh: ['OK'], líne-nua. }.
(s cuimsíonn: ['file2']) fíor:   { Aschur scríobh: ['XX'], líne-nua. }.
(s cuimsíonn: ['folder1']) fíor: { Aschur scríobh: ['OK'], líne-nua. }.
