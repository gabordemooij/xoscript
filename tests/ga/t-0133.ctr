


>> Deck := Liosta nua.
Deck ar: ['print'] déan: {
        >> len := féin comhair - 1.
        { :i
                >> len2 := féin comhair - 1.
                Aschur scríobh: ['len: '].
                Aschur scríobh: len, líne-nua.
                Aschur scríobh: ['len2: '].
                Aschur scríobh: len2, líne-nua.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
