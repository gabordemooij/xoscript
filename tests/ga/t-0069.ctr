

Teaghrán ar: ['html'] déan: { <- (
		féin
		ionadaigh: ['&'] le: ['&amp;'],
		ionadaigh: ['<'] le: ['&lt;'],
		ionadaigh: ['>'] le: ['&gt;'],
		ionadaigh: ['"'] le: ['&quot;']
	).
}.


Aschur scríobh: ([' left trimmed '] bearr) + [' '] + ( ['and right trimmed'] bearr) + ['!'], líne-nua.
Aschur scríobh: ['<html>"html & entities"</html>'] html.
