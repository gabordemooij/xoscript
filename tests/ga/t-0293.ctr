
>> city := Liosta ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Liosta ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature le: city.
>> cities := weather iontrálacha sórtáil: { :a :b <- (a cuir-i-gcomparáid: b). }.
>> temperatures := weather luachanna sórtáil: { :a :b <- (a cuir-i-gcomparáid: b) diúltach?. }.

Aschur scríobh: (cities ceangail: [',']), líne-nua.
Aschur scríobh: (temperatures ceangail: [',']), líne-nua.
