Teaghrán ar: ['evaluate'] déan: {
	>> cód := Comhad nua: ['/tmp/eval.ctr'].
	cód scríobh: (féin teaghrán + ['.']).
	Ríomhchlár úsáid: ['/tmp/eval.ctr'].
}.

>> a := Liosta ← 1 ; 2 ; 3.
>> b := (a teaghrán).

Aschur scríobh: b, líne-nua. 
(['b := '] + b) evaluate.

Aschur scríobh: b ? 2, líne-nua. 

Aschur scríobh: (( Liosta ← 1 ; 2 ; 3 )), líne-nua. 

Aschur scríobh: ((Foclóir nua) cuir: 1 ag: 2), líne-nua. 

>> x := ( (Liosta ← 1 ; ( Liosta ← 9 ) ; Fíor ) ) teaghrán.
Aschur scríobh: x, líne-nua. 
(['x := '] + x) evaluate.

Aschur scríobh: x ? 1 ? 0, líne-nua. 

>> y := (Foclóir nua) cuir: (Liosta ← 1) ag: (Liosta ← 2).
Aschur scríobh: y, líne-nua. 

(['y := '] + y) teaghrán evaluate.

Aschur scríobh: (y ag: (Liosta ← 2) teaghrán ), líne-nua.

Aschur scríobh: (Liosta nua), líne-nua. 
Aschur scríobh: (Foclóir nua), líne-nua. 
