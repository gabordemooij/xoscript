Aschur scríobh: ['Test object'], líne-nua.
>> a := Réad nua. 

a ar: ['item:'] déan: { :dict
	dílis dict := dict. 
}.

a ar: ['item'] déan: { <- dílis dict.
}.

a item: (
Foclóir nua
	hello: ['world'],
	world: (Foclóir nua cuir: ['a'] ag: ['b'])).

Aschur scríobh: a item, líne-nua.

>> old-dict-address := a item fréamhshamhail seoladh-cuimhne.
a save-as: ['/tmp/a.bin'].
Aschur scríobh: ['========== RELOADING SNAP:'], líne-nua.

>> b := Réad load-from: ['/tmp/a.bin'].

(b item fréamhshamhail seoladh-cuimhne = old-dict-address) fíor: {
	Aschur scríobh: ['Object link re-attached.'], líne-nua.
}.

Aschur scríobh: b item, líne-nua.
