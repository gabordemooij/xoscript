# test catch-all methods
>> x13 := Réad nua.
x13 ar: ['a'] déan: { :a Aschur scríobh: 0, líne-nua. }.
x13 ar: ['a:'] déan: { :a Aschur scríobh: a, líne-nua. <- 5. }.
x13 ar: ['a:b:'] déan: { :a :b Aschur scríobh: (a + b), líne-nua. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
