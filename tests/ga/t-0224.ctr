
>> countries := Liosta nua
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Liosta nua
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods le: countries, gach: { :key :value
	counter suimigh: 1.
}.

Aschur scríobh: (['we serve counter dishes'] counter: counter), líne-nua.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] carachtair sórtáil: { :v
	counter suimigh: 0.
}.

Aschur scríobh: (['we sort counter dishes'] counter: counter), líne-nua.


>> counter := 0.
{
	{
		counter suimigh: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Aschur scríobh: (['we calculate counter numbers.'] counter: counter), líne-nua.

