Server init.
>> f := Formáid nua: ['%d'].
>> a := Blob nua: 4.
a bytes: ( Liosta nua ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob nua: 4.
b bytes: ( Liosta nua ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a ó: 0 fad: 3, gach: { :i :byte
	Aschur scríobh: ( f feidhmigh-slánuimhir: byte ), líne-nua.
}.
a ^ b.
a ó: 0 fad: 3, gach: { :i :byte
	Aschur scríobh: ( f feidhmigh-slánuimhir: byte ), líne-nua.
}.
a ^ b.
a ó: 0 fad: 3, gach: { :i :byte
	Aschur scríobh: ( f feidhmigh-slánuimhir: byte ), líne-nua.
}.
a saor.
b saor.

{ a ^ Réad. } gabh: { :e Aschur scríobh: e, líne-nua. }, tosaigh.
