

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Ríomhchlár bainistíocht-cuimhne: 0.

Aschur scríobh: (6 < 5), líne-nua.
Aschur scríobh: (2 > 1), líne-nua.
Aschur scríobh: (2 ≤ 1), líne-nua.
Aschur scríobh: (9 ≥ 1), líne-nua.
Aschur scríobh: (2 corr?), líne-nua.
Aschur scríobh: (4 réidh?), líne-nua.
Aschur scríobh: (-1 dearfach?), líne-nua.
Aschur scríobh: (-2 diúltach?), líne-nua.
Aschur scríobh: ((3 ≥ 4) & (3 ≤ 5)), líne-nua.
Aschur scríobh: (3 = 3), líne-nua.
Aschur scríobh: (3 ≠ 3), líne-nua.
Aschur scríobh: 1 boole, líne-nua.

Ríomhchlár glan-suas.

usedMemory1 := (Ríomhchlár cuimhne ? 0).


