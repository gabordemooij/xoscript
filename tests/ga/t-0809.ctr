# backslashes must survive code serialization, strings must not end early
>> luachanna := Liosta nua
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

luachanna gach: { :i :value
	>> d := Foclóir nua.
	d cuir: value ag: ['k'].
	>> r := d cód réad.
	Aschur scríobh: r comhair, líne-nua.
	Aschur scríobh: ( (r ag: ['k']) = value ), líne-nua.
}.
