Aschur scríobh: ['Test object'], líne-nua.
>> a := Réad nua. 
a ar: ['item:'] déan: { :lst
	dílis lst := lst. 
}.
a ar: ['item'] déan: { <- dílis lst.
}.
a item: (
	Liosta nua ; 1 ; (
		Liosta nua ; ['a'] ; (
			Liosta nua ; ( Tráth nua: 1 )
		) ; ( Int64 as-teaghrán: ['321'] )
	)
).
Aschur scríobh: a item, líne-nua.
>> old-lst-address := a item fréamhshamhail seoladh-cuimhne.
a save-as: ['/tmp/a.bin'].
Aschur scríobh: ['========== RELOADING SNAP:'], líne-nua.
>> b := Réad load-from: ['/tmp/a.bin'].
(b item fréamhshamhail seoladh-cuimhne = old-lst-address) fíor: {
	Aschur scríobh: ['Object link re-attached.'], líne-nua.
}.
Aschur scríobh: ( b item ), líne-nua.
