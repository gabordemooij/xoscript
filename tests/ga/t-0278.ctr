>> To-Do := Réad nua.

To-Do ar: ['nua'] déan: {
	dílis list := Liosta nua.
}.

To-Do ar: ['nieuw'] déan: {
	dílis list := Liosta nua.
}.

To-Do ar: ['+'] déan: { :task
	dílis list iarcheangail: task.
}.

To-Do ar: ['number of tasks?'] déan: { <-  dílis list comhair.
}.

>> todos := 
	To-Do nua 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Aschur scríobh: ['You have $ tasks to do'] $ todos number of tasks?.
