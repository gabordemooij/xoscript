
Uimhir foghlaim: ['plus:'] ciallaíonn: ['+'].
Uimhir ar: ['+'] déan: { :x
	>> rate := 1.
	>> currency := x cáilitheoir.
	(currency = ['euros']) fíor: {
		rate := 2.
	}. <- (féin plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars cáiligh: ['dollars'].
euros cáiligh: ['euros'].
>> money := dollars + euros.
Aschur scríobh: money, líne-nua.
