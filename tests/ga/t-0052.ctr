>> items := Foclóir nua.
items cuir: ['green'] ag: ['color-1'].
items cuir: ['orange'] ag: ['color-2'].
items cuir: ['red'] ag: ['color-3'].
>> i := 0.
>> s := [''].
items gach: { :key :color
	Aschur scríobh: ['color #'] + i + [' is: '] + color + [' '].
	i suimigh: 1.
}.
Aschur scríobh: i + [' colors!'].
