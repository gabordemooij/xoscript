Server init.
Aschur scríobh: ['Database datetime test'], líne-nua.

>> db := Maria-DB nua óstach: ['localhost'],
	ainm-úsáideora: ['xo'], 
	pasfhocal: ['pass123'],
	ainm-bunachair: ['xobase'],
	ceangail.

>> paraiméadair-chuardaigh :=
db iarratas: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
faigh-sonraí: { :row
	Aschur scríobh: row datetimetest, líne-nua.
}.
