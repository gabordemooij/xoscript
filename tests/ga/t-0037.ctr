>> a := 3.
>> b := a cóipeáil.
a dealaigh: 1.
Aschur scríobh: [' a = '] + a.
Aschur scríobh: [' b = '] + b.
a := 3.
b := a + 4.
Aschur scríobh: [' a = '] + a.
Aschur scríobh: [' b = '] + b.
>> x := 3.
>> y := x cóipeáil.
x suimigh: 10.
y dealaigh: 1.
Aschur scríobh: [' x = '] + x.
Aschur scríobh: [' y = '] + y.
>> q := Réad nua.
q ar: ['setProperty:'] déan: { :x
	dílis prop := x.
}.
q ar: ['getProperty'] déan: { <- dílis prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Aschur scríobh: [' p = '] + (p getProperty).
