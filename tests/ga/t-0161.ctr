Ríomhchlár bainistíocht-cuimhne: 0.
Liosta ar: ['sum'] déan: {
	>> total := 0.
	féin gach: { :index :element
		total suimigh: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Comhad nua: ['/tmp/test.txt'].
f scríobh: ['Lorem Ipsum'].
f dún.
  

f := Comhad nua: ['/tmp/test.txt'].
>> text := f léigh.
f dún.



Ríomhchlár glan-suas.
usedMemory1 := (Ríomhchlár cuimhne ? 1).



f := Comhad nua: ['/tmp/test.txt'].
text := f léigh.
f dún.

Ríomhchlár glan-suas.
usedMemory2 := (Ríomhchlár cuimhne ? 1).


f := Comhad nua: ['/tmp/test.txt'].
text := f léigh.
f dún.

Ríomhchlár glan-suas.
usedMemory3 := (Ríomhchlár cuimhne ? 1).



( usedMemory1 = usedMemory2 agus: usedMemory1 = usedMemory3, agus: usedMemory2 = usedMemory3 ) fíor: {
	Aschur scríobh: ['No memory leaks here'].
}, bréagach: {
	Aschur scríobh: ['Leaking memory...'].
}.
