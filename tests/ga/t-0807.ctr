# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB nua óstach: ['localhost'],
	ainm-úsáideora: ['xo'],
	pasfhocal: ['pass123'],
	ainm-bunachair: ['xobase'],
	ceangail.

>> paraiméadair-chuardaigh := db iarratas: ['SELECT %% FROM'].
{ paraiméadair-chuardaigh rith-ordú. } gabh: { :e
	Aschur scríobh: ( e cuimsíonn: ['%%'] ), líne-nua.
}, tosaigh.
