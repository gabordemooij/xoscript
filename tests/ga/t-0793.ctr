Server init.

>> DB := Maria-DB nua óstach: ['localhost'],
	ainm-úsáideora: ['xo'],
	pasfhocal: ['pass123'],
	ainm-bunachair: ['xobase'],
	ceangail.

{
	DB iarratas:
	['DROP TABLE movies'],
	rith-ordú.
} gabh: { Neamhní. }, tosaigh.

DB iarratas:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
rith-ordú.

DB iarratas: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
paraiméadair: ( Liosta nua ; ['Halloween'] ),
rith-ordú.

DB iarratas: ['SELECT * FROM movies'],
faigh-sonraí: { :movie
	Aschur scríobh: movie title, líne-nua.
}.

