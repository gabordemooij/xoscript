# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Taisceadán gin-eochracha.

# private (secret) key
>> sk := keys céad.

# public key
>> pk := keys deireanach.

# sign a message
>> sig := Taisceadán sínigh: ['abc'] le: sk.

# check message (ok)
Aschur scríobh: ( 
	Taisceadán
		seiceáil: ['abc'] 
		síniú: sig 
		le: pk 
), líne-nua.

# check message (fail)
Aschur scríobh: ( 
	Taisceadán 
		seiceáil: ['abd'] 
		síniú: sig 
		le: pk 
), líne-nua.