>> z := Réad nua.
z ar: ['value:'] déan: { :v
	dílis value := v. <- féin.
}.
z ar: ['value'] déan: { <- dílis value. }.
(z setValue: 1) value: 2.
Aschur scríobh: z value.
>> x := z.
Aschur scríobh: x value.
z := Neamhní.
Aschur scríobh: z value.
Aschur scríobh: x value.
Aschur scríobh: ['hello'].
Aschur scríobh: 3 + 2.
Aschur scríobh: (3 > 2).
