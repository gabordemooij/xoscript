#Linux

 >> t := Tráth nua.
 
t crios: ['Europe/Amsterdam'].
t bliain: 2020, mí: 8, lá: 2, uair: 21, nóiméad: 2, soicind: 1.

>> a := t uair.
>> ams := t crios.

t crios: ['US/Hawaii'].
>> b := t uair.
>> hw := t crios.

Aschur
scríobh: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		ceachtar: ['later'] nó: ['earlier']
	)
),
líne-nua.
 