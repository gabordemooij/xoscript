Aschur scríobh: ['Test object'], líne-nua.
>> a := Réad nua. 

a ar: ['item:'] déan: { :nil
	dílis nil := nil. 
}.

a ar: ['item'] déan: { <- dílis nil.
}.

a item: Neamhní.

Aschur scríobh: a item, líne-nua.

>> old-nil-address := a item fréamhshamhail seoladh-cuimhne.
a save-as: ['/tmp/a.bin'].
Aschur scríobh: ['========== RELOADING SNAP:'], líne-nua.

>> b := Réad load-from: ['/tmp/a.bin'].

(b item fréamhshamhail seoladh-cuimhne = old-nil-address) fíor: {
	Aschur scríobh: ['Object link re-attached.'], líne-nua.
}.

Aschur scríobh: b item, líne-nua.
