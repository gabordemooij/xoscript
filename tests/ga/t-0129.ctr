
Liosta ar: ['product'] déan: {
	>> total := 1.
	féin gach: { :index :element
		total iolraigh-faoi: element.
	}. <- total.
}.

>> a := Liosta ← 1 ; 2 ; 3.
Aschur scríobh: a product, líne-nua.
Aschur scríobh: (Liosta ← 2 ; 4 ; 8) product, líne-nua. 
Aschur scríobh: (Liosta ← -2 ; 10) product, líne-nua. 
Aschur scríobh: (Liosta ← 0.5 ; -2) product, líne-nua. 
