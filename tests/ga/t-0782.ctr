Aschur scríobh: ['Test object'], líne-nua.
>> cmd := Ordú nua.
Aschur scríobh: cmd ls /tmp, líne-nua.
>> old-cmd-address := cmd fréamhshamhail seoladh-cuimhne.
cmd save-as: ['/tmp/a.bin'].
Aschur scríobh: ['========== RELOADING SNAP:'], líne-nua.
>> b := Réad load-from: ['/tmp/a.bin'].
(b fréamhshamhail seoladh-cuimhne = old-cmd-address) fíor: {
	Aschur scríobh: ['Object link re-attached.'], líne-nua.
}.
Aschur scríobh: b ls, líne-nua.


