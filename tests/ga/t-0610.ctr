
>> Rectangle := Réad nua.

Rectangle ar: ['area'] déan: { <- dílis fad * dílis width.
}.

Rectangle ar: ['length:'] déan: { :fad
	dílis fad := fad.
}.

Rectangle ar: ['width:'] déan: { :width
	dílis width := width.
}.

Rectangle ar: ['nua'] déan: {
	# this will not result into an infinite loop
	>> rectangle := féin nua.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle nua.
Aschur scríobh: a area, líne-nua. #0

>> b := Rectangle nua length: 2, width: 3.
Aschur scríobh: b area, líne-nua. #6

