
Server init.
Aschur scríobh: ['Database test'], líne-nua.

>> db := Maria-DB nua óstach: ['localhost'],
	ainm-úsáideora: ['xo'], 
	pasfhocal: ['pass123'],
	ainm-bunachair: ['xobase'],
	ceangail.

>> paraiméadair-chuardaigh :=
db iarratas: ['SELECT UNHEX('CAFE') AS blobby'],
faigh-sonraí: { :row
	Aschur scríobh: ( row blobby ó: 0 fad: 2 ), líne-nua.
	row blobby saor.
}.
