{
	an-tasc-seo earráid: ['Dont fail.'].
	unknown doSomething.
} gabh: {
	Aschur scríobh: ['Caught!'].
}, tosaigh.

{
	an-tasc-seo earráid: ['Dont fail.'].
	dílis unknown doSomething.
} gabh: {
	Aschur scríobh: ['Caught!'].
}, tosaigh.

{
	an-tasc-seo earráid: ['Dont fail.'].
	unknown := 122.
} gabh: {
	Aschur scríobh: ['Caught!'].
}, tosaigh.


{
	an-tasc-seo earráid: ['Dont fail.'].
	Fíor bris.
	Aschur scríobh: ['FAIL'].
} gabh: {
	Aschur scríobh: ['Caught!'].
}, tosaigh.

{
	{
		an-tasc-seo earráid: ['Dont fail.'].
		Fíor bris.
		Aschur scríobh: ['FAIL'].
	} gabh: { :x
		(x = ['Dont fail.']) fíor: { an-tasc-seo earráid: ['Nested Caught!']. }.
	}, tosaigh.
} gabh: { :e
	Aschur scríobh: e.
}, tosaigh.
