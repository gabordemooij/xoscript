Server init.

>> DB := Maria-DB nua óstach: ['localhost'],
	ainm-úsáideora: ['xo'],
	pasfhocal: ['pass123'],
	ainm-bunachair: ['xobase'],
	ceangail.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB iarratas: SQL.

# now you don't have to set DB
query2 faigh-sonraí: { :row
	Aschur scríobh: row world, líne-nua.
}.
