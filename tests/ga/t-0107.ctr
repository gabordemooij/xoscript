
Aschur scríobh: ['Break for-loop, 0-4.'], líne-nua.
{ :i
	Aschur scríobh: ['iteration #'] + i, líne-nua.
	(i = 4) bris.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Aschur scríobh: ['Break while-true loop, 0-4.'], líne-nua.
{
	Aschur scríobh: ['iteration #'] + x, líne-nua.
	x suimigh: 1.
	((x < 5) ní) bris.
} fad-is: xIsLessThan10.

Aschur scríobh: ['Break while-false loop, 5,4.'], líne-nua.
{
	Aschur scríobh: ['iteration #'] + x, líne-nua.
	x dealaigh: 1.
	(x = 3) bris.
} fad-is: { <- (x > 0). }.

Aschur scríobh: ['Break times loop, 1-4.'], líne-nua.
{ :i
	Aschur scríobh: ['iteration #'] + i, líne-nua.
	(i = 4) bris.
} × 5.

Aschur scríobh: ['Break block, dont print line.'], líne-nua.
{ Fíor bris. Aschur scríobh: ['dont write this!'], líne-nua. } tosaigh.

Aschur scríobh: ['Break block, dont fire catch...'], líne-nua.
{ Fíor bris. Aschur scríobh: ['dont write this!'], líne-nua. } gabh: { Aschur scríobh: ['Dont catch this!']. }, tosaigh.

Aschur scríobh: ['Test Array each-loop: 0,1'], líne-nua.
(Liosta ← 1 ; 2 ; 3) mapáil: { :i
	Aschur scríobh: ['iteration #'] + i, líne-nua.
	(i = 1) bris.
}.

Aschur scríobh: ['Test Map each-loop: c only'], líne-nua.
>> m := Foclóir nua.
m cuir: ['first'] ag: ['a'], cuir: ['second'] ag: ['b'], cuir: ['third'] ag: ['c'].
m gach: { :k :v
	Aschur scríobh: ['iteration'] + v + k, líne-nua.
	Fíor bris.
}.

