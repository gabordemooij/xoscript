Teaghrán ar: ['html'] déan: { <- (
		féin
		ionadaigh: ['&'] le: ['&amp;'],
		ionadaigh: ['<'] le: ['&lt;'],
		ionadaigh: ['>'] le: ['&gt;'],
		ionadaigh: ['''] le: ['&apos;'],
		ionadaigh: ['"'] le: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Ríomhchlár bainistíocht-cuimhne: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Aschur scríobh: txt cóipeáil html, líne-nua.
Aschur scríobh: txt cóipeáil cás-íochtair, líne-nua.
Aschur scríobh: txt cóipeáil cás-uachtair, líne-nua.
} tosaigh.

Ríomhchlár glan-suas.

usedMemory1 := (Ríomhchlár cuimhne ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Aschur scríobh: txt cóipeáil html, líne-nua.
Aschur scríobh: txt cóipeáil cás-íochtair, líne-nua.
Aschur scríobh: txt cóipeáil cás-uachtair, líne-nua.
} tosaigh.

Ríomhchlár glan-suas.
usedMemory2 := (Ríomhchlár cuimhne ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Aschur scríobh: txt cóipeáil html, líne-nua.
Aschur scríobh: txt cóipeáil cás-íochtair, líne-nua.
Aschur scríobh: txt cóipeáil cás-uachtair, líne-nua.
} tosaigh.

Ríomhchlár glan-suas.
usedMemory3 := (Ríomhchlár cuimhne ? 0).



( usedMemory1 = usedMemory2 agus: usedMemory1 = usedMemory3, agus: usedMemory2 = usedMemory3 ) fíor: {
	Aschur scríobh: ['No memory leaks here'].
}, bréagach: {
	Aschur scríobh: ['Leaking memory...'].
}.
