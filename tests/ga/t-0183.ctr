

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Ríomhchlár bainistíocht-cuimhne: 0.

>> o := Réad nua.
>> o2 := Réad nua.
Aschur scríobh: o Neamhní?, líne-nua.
Aschur scríobh: o cineál, líne-nua.
Aschur scríobh: ( o cothrom-le: o ), líne-nua.
Aschur scríobh: ( o cothrom-le: o2 ), líne-nua.
Aschur scríobh: o mé-féin, líne-nua.
Aschur scríobh: ( o déan déanta ), líne-nua.

Ríomhchlár glan-suas.

usedMemory1 := (Ríomhchlár cuimhne ? 0).


o := Réad nua.
o2 := Réad nua.
Aschur scríobh: o Neamhní?, líne-nua.
Aschur scríobh: o cineál, líne-nua.
Aschur scríobh: ( o cothrom-le: o ), líne-nua.
Aschur scríobh: ( o cothrom-le: o2 ), líne-nua.
Aschur scríobh: o mé-féin, líne-nua.
Aschur scríobh: ( o déan déanta ), líne-nua.

Ríomhchlár glan-suas.
usedMemory2 := (Ríomhchlár cuimhne ? 0).


o := Réad nua.
o2 := Réad nua.
Aschur scríobh: o Neamhní?, líne-nua.
Aschur scríobh: o cineál, líne-nua.
Aschur scríobh: ( o cothrom-le: o ), líne-nua.
Aschur scríobh: ( o cothrom-le: o2 ), líne-nua.
