
>> a := Liosta ← (Liosta ← 100 ; 200 ; 300) ; (Liosta ← 9 ; 8 ; 7).
Aschur scríobh: ['at 0,1 :'].
Aschur scríobh: a ? 0 ? 1, líne-nua. 
Aschur scríobh: ['at 1,2 :'].
Aschur scríobh: a ? 1 ? 2, líne-nua. 
>> menu := Foclóir nua.
menu cuir: (Liosta ← ['pizza'] ; ['spaghetti']) ag: ['Italian Cuisine'].
menu cuir: (Liosta ← ['bifteki'] ; ['suflaki']) ag: ['Greek Cuisine'].
Aschur scríobh: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), líne-nua. 
Aschur scríobh: ['but not on the same plate.'], líne-nua.
