Boole ar: ['xor:'] déan: { :a :b <- ((a agus: b ní) nó: (a ní agus: b)).
}.

>> o := Réad nua.
o ar: ['hello'] déan: { ['Empty']. }.
{ o ar: 2 déan: 3.} gabh: { :e Aschur scríobh: e, líne-nua. }, tosaigh.
{ o ar: ['tástáil'] déan: 3.} gabh: { :e Aschur scríobh: e, líne-nua. }, tosaigh.
{ o ar: ['hello'] déan: { ['Empty']. }.} gabh: { :e Aschur scríobh: e, líne-nua. }, tosaigh. 
{ >> z := 4 ÷ 0. } gabh: { :e Aschur scríobh: e, líne-nua. }, tosaigh. 
{ (Fíor agus: Neamhní) fíor: { Aschur scríobh: ['X'].}. } gabh: { :e Aschur scríobh: e, líne-nua. }, tosaigh. 
{ ([''] xor: 0) fíor: { Aschur scríobh: ['X'].}. } gabh: { :e Aschur scríobh: e, líne-nua. }, tosaigh. 
{ (1 < ['2']) fíor: { Aschur scríobh: ['OK']. }. } gabh: { :e Aschur scríobh: e, líne-nua. }, tosaigh. 
{ (1 < ['2.0']) fíor: { Aschur scríobh: ['OK']. }. } gabh: { :e Aschur scríobh: e, líne-nua. }, tosaigh. 
{ (1 < ['x2.0']) fíor: { Aschur scríobh: ['NO!']. }. } gabh: { :e Aschur scríobh: e, líne-nua. }, tosaigh. 
{ Aschur scríobh: (['hello OK there'] ó: ['6'] fad: ['2']). } tosaigh. 
