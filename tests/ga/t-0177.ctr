

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Ríomhchlár bainistíocht-cuimhne: 0.

>> txt := [' Word Salad '].
txt := txt ionadaigh: ['Word'] le: ['Ceasar'].
txt := txt bearr.
Aschur scríobh: txt, líne-nua.

Ríomhchlár glan-suas.

usedMemory1 := (Ríomhchlár cuimhne ? 0).


txt := [' Word Salad '].
txt := txt ionadaigh: ['Word'] le: ['Ceasar'].
txt := txt bearr.
Aschur scríobh: txt, líne-nua.

Ríomhchlár glan-suas.
usedMemory2 := (Ríomhchlár cuimhne ? 0).


txt := [' Word Salad '].
txt := txt ionadaigh: ['Word'] le: ['Ceasar'].
txt := txt bearr.
