>> Greeter := Réad nua.
Greeter ar: ['make'] déan: {
	>> gr := Réad nua.
	gr ar: ['setName:'] déan: { :aname
		dílis ainm := aname.
	}.
	gr ar: ['greet'] déan: {
		Aschur scríobh: dílis ainm.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a nua.
c setName: ['THREE'].
c greet.
>> d := a nua.
d setName: ['FOUR'].
d greet.
c greet.
