>> map1 := Foclóir nua.
>> key1 := Liosta nua.
>> key2 := Liosta nua.

map1
	cuir: ['hello'] ag: key1,
	cuir: ['world'] ag: key2.


Aschur
	scríobh: ['Map #1 contains: '] + (map1 ag: key1),
	scríobh: [' and '] + (map1 ag: key2), líne-nua.

>> KeyeableArray := Liosta nua.
KeyeableArray ar: ['toString'] déan: { <- (féin comhair) toString.
}.

>> map2 := Foclóir nua.
key1 := KeyeableArray nua.
key2 := KeyeableArray nua.

key1 iarcheangail: 1.

map2
	cuir: ['hello'] ag: key1,
	cuir: ['world'] ag: key2.

Aschur
	scríobh: ['Map #2 contains: '] + (map2 ag: key1),
	scríobh: [' and '] + (map2 ag: key2), líne-nua.
