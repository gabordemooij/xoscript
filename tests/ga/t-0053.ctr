60 × {
	>> x := (Uimhir random % 6) + 1.
	(x ≤ 6) bréagach: { Aschur scríobh: ['FAIL']. }.
	(x ≥0) bréagach: { Aschur scríobh: ['FAIL']. }.
	x := (Uimhir random % 3) + 1.
	(x < 3) bréagach: { Aschur scríobh: ['FAIL']. }.
	(x>-1) bréagach: { Aschur scríobh: ['FAIL']. }.
	x := ((Boole flip) uimhir).
	(x = 0 nó: x = 1) bréagach: { Aschur scríobh: ['FAIL']. }.
	x := ((Fíor flip) uimhir).
	(x = 0 nó: x = 1) bréagach: { Aschur scríobh: ['FAIL']. }.
	x := (Boole flip ceachtar: ['HEAD'] nó: ['TAIL']).
	((x = ['HEAD']) nó: (x = ['TAIL'])) bréagach: { Aschur scríobh: ['FAIL']. }.
}.
Aschur scríobh: ['DONE'].

