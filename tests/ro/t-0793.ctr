Server init.

>> DB := Maria-DB nou gazdă: ['localhost'],
	utilizator: ['xo'],
	parolă: ['pass123'],
	nume-bază: ['xobase'],
	conectează.

{
	DB interogare:
	['DROP TABLE movies'],
	execută-interogare.
} prinde: { Nimic. }, pornește.

DB interogare:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
execută-interogare.

DB interogare: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
parametri: ( Listă nou ; ['Halloween'] ),
execută-interogare.

DB interogare: ['SELECT * FROM movies'],
preia: { :movie
	Ieșire scrie: movie title, rând-nou.
}.

