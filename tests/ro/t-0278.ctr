>> De-Făcut := Obiect nou.

De-Făcut la: ['nou'] execută: {
	propriu list := Listă nou.
}.

De-Făcut la: ['nieuw'] execută: {
	propriu list := Listă nou.
}.

De-Făcut la: ['+'] execută: { :sarcină
	propriu list adaugă-la-sfârșit: sarcină.
}.

De-Făcut la: ['number of tasks?'] execută: { <-  propriu list numără.
}.

>> sarcini := 
	De-Făcut nou 
	+ ['gătește cina'] 
	+ ['curăță camera'].
	
Ieșire scrie: ['You have $ tasks to do'] $ sarcini number of tasks?.
