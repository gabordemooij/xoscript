>> To-Do := Obiect nou.

To-Do la: ['nou'] execută: {
	propriu list := Listă nou.
}.

To-Do la: ['nieuw'] execută: {
	propriu list := Listă nou.
}.

To-Do la: ['+'] execută: { :task
	propriu list adaugă-la-sfârșit: task.
}.

To-Do la: ['number of tasks?'] execută: { <-  propriu list numără.
}.

>> todos := 
	To-Do nou 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Ieșire scrie: ['You have $ tasks to do'] $ todos number of tasks?.
