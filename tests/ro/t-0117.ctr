>> t := Adevărat.
(t = Adevărat) adevărat: { Ieșire scrie: ['T']. }.
(t = Fals) adevărat: { Ieșire scrie: ['F']. }.
Ieșire scrie: ['|'].
>> t := Fals.
(t = Adevărat) adevărat: { Ieșire scrie: ['T']. }.
(t = Fals) adevărat: { Ieșire scrie: ['F']. }.
Ieșire scrie: ['|'].
>> f := Adevărat.
(t = Adevărat și: f = Fals) adevărat: { Ieșire scrie: ['T']. }.
(t = Fals și: f = Adevărat) adevărat: { Ieșire scrie: ['F']. }.
Ieșire scrie: ['|'].
>> n := Nimic.
(n Nimic?) adevărat: { Ieșire scrie: ['T']. }.
(n Nimic?) fals: { Ieșire scrie: ['F']. }.
Ieșire scrie: ['|'].
(f Boolean?) adevărat: { Ieșire scrie: ['T']. }.
(f Boolean?) fals: { Ieșire scrie: ['F']. }.



