
>> memorieFolosită1 := 0.
>> memorieFolosită2 := 0.
>> memorieFolosită3 := 0.
>> memorieFolosită4 := 0.
>> cod := {
	>> a := Listă nou.
	>> b := Listă nou.
	a adaugă-la-sfârșit: b.
	b adaugă-la-sfârșit: a.
}.
Program gestiune-memorie: 0.
Program curăță.
memorieFolosită1 := (Program memorie ? 0).
cod pornește.
Program curăță.
memorieFolosită2 := (Program memorie ? 0).
cod pornește.
Program curăță.
memorieFolosită3 := (Program memorie ? 0).
( memorieFolosită1 = memorieFolosită2 și: memorieFolosită1 = memorieFolosită3, și: memorieFolosită2 = memorieFolosită3 ) adevărat: {
	Ieșire scrie: ['Fără scurgeri de memorie aici'].
}, fals: {
	Ieșire scrie: ['Se scurge memorie...'].
}.
