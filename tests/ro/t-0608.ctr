
>> Mărime := Obiect nou.
Mărime la: ['is:'] execută: { :număr
	număr la: ['+'] execută: { :număr
		>> unitate := număr calificativ.
		>> factor := 1.
		
		unitate
		caz: ['inch'] fă: { factor := 0.0833. }.

		<- sine + (număr * factor).
	}.
	<- număr.
}.

# Acest număr de mărime poate fi folosit astfel:

>> scândură := Mărime is: 6 picior.
>> margine := Mărime is: 50 inch.

# Se va afișa ca: 10.165
Ieșire scrie: scândură + margine, rând-nou.
