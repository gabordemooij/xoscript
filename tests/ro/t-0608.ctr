
>> Size := Obiect nou.
Size la: ['is:'] execută: { :număr
	număr la: ['+'] execută: { :număr
		>> unit := număr calificativ.
		>> factor := 1.
		
		unit
		caz: ['inch'] fă: { factor := 0.0833. }. <- sine + (număr * factor).
	}. <- număr.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Ieșire scrie: plank + edge, rând-nou.
