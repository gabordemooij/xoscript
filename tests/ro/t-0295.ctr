
>> dictionary := (
	Dicționar nou
		pune: ['b'] la: ['a'],
		pune: ['a'] la: ['b'],
		pune: ['z'] la: ['x'],
		pune: ['hello'] la: ['hallo'],
		pune: ['human'] la: ['human']
).

>> comparisons := Listă nou.
dictionary fiecare: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a compară: b)
	).
}.

comparisons sortează: { :a :b <- ( a compară: b ). }.
Ieșire scrie: ( comparisons unește: ['↵'] ), rând-nou.
comparisons unește: ['↵'].
