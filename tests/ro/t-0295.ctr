
>> vocabular := (
	Dicționar nou
		pune: ['b'] la: ['a'],
		pune: ['a'] la: ['b'],
		pune: ['z'] la: ['x'],
		pune: ['hello'] la: ['hallo'],
		pune: ['om'] la: ['om']
).

>> comparații := Listă nou.
vocabular fiecare: { :a :b
	comparații ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a compară: b)
	).
}.

comparații sortează: { :a :b <- ( a compară: b ). }.
Ieșire scrie: ( comparații unește: ['↵'] ), rând-nou.
comparații unește: ['↵'].
