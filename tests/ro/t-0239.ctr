Listă la: ['sum'] execută: {
	>> total := 0.
	sine fiecare: { :index :element
		total adaugă: element.
	}. <- total.
}.

>> a := Adevărat.



a la: ['text'] execută: {
	>> answer := Nimic.
	( sine = Adevărat ) adevărat: {
		answer := ['Yep'].
	}, altfel: {
		answer := ['Nope'].
	}. <- answer.
}.

a la: ['număr'] execută: {
	>> answer := Nimic.
	( sine = Adevărat ) adevărat: {
		answer := 10.
	}, altfel: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b la: ['text'] execută: { <- ['Devil'].
}.

b la: ['boolean'] execută: { <- Fals.
}.


Ieșire scrie: a, rând-nou.  
Ieșire scrie: (90 + a), rând-nou. 
Ieșire scrie: b, rând-nou. 
Ieșire scrie: (Adevărat și: b), rând-nou.

a := Listă ← ['hello'] ; ['world'] ; Adevărat ; Nimic ; 666. 
a := a + ( Listă ← 1 ).
Ieșire scrie: a, rând-nou.
Ieșire scrie: ((Dicționar nou) pune: Nimic la: Nimic), rând-nou.
Ieșire scrie: a sum, rând-nou. 


{
	a la: ['text'] execută: { <- Nimic. }.
	a := [''] + a.
} prinde: { :error
	Ieșire scrie: ['Error noted: '] + error, rând-nou.
}, pornește.



{
	a la: ['număr'] execută: { <- Nimic. }.
	a := 3 × a.
} prinde: { :error
	Ieșire scrie: ['Error noted: '] + error, rând-nou.
}, pornește.


{
	a la: ['boolean'] execută: { <- Nimic. }.
	a := Adevărat și: a. 
} prinde: { :error
	Ieșire scrie: ['Error noted: '] + error, rând-nou.
}, pornește.





