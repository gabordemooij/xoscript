Listă la: ['sumă'] execută: {
	>> total := 0.
	sine fiecare: { :indice :element
		total adaugă: element.
	}. <- total.
}.

>> a := Adevărat.



a la: ['text'] execută: {
	>> răspunsul := Nimic.
	( sine = Adevărat ) adevărat: {
		răspunsul := ['Mda'].
	}, altfel: {
		răspunsul := ['Ba nu'].
	}. <- răspunsul.
}.

a la: ['număr'] execută: {
	>> răspunsul := Nimic.
	( sine = Adevărat ) adevărat: {
		răspunsul := 10.
	}, altfel: {
		răspunsul := 20.
	}. <- răspunsul.
}.

>> b := 666.

b la: ['text'] execută: { <- ['Diavol'].
}.

b la: ['boolean'] execută: { <- Fals.
}.


Ieșire scrie: a, rând-nou.  
Ieșire scrie: (90 + a), rând-nou. 
Ieșire scrie: b, rând-nou. 
Ieșire scrie: (Adevărat și: b), rând-nou.

a := Listă ← ['hello'] ; ['world'] ; Adevărat ; Nimic ; 666. 
a := a + ( Listă ← 1 ).
Ieșire scrie: a, rând-nou.
Ieșire scrie: ((Dicționar nou) pune: Nimic la: Nimic), rând-nou.
Ieșire scrie: a sumă, rând-nou. 


{
	a la: ['text'] execută: { <- Nimic. }.
	a := [''] + a.
} prinde: { :eroarea
	Ieșire scrie: ['Eroare notată: '] + eroarea, rând-nou.
}, pornește.



{
	a la: ['număr'] execută: { <- Nimic. }.
	a := 3 × a.
} prinde: { :eroarea
	Ieșire scrie: ['Eroare notată: '] + eroarea, rând-nou.
}, pornește.


{
	a la: ['boolean'] execută: { <- Nimic. }.
	a := Adevărat și: a. 
} prinde: { :eroarea
	Ieșire scrie: ['Eroare notată: '] + eroarea, rând-nou.
}, pornește.





