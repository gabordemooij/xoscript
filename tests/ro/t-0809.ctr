# backslash-urile trebuie să supraviețuiască serializării codului, textele nu trebuie să se termine prea devreme
>> valori := Listă nou
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

valori fiecare: { :i :value
	>> d := Dicționar nou.
	d pune: value la: ['k'].
	>> r := d cod obiect.
	Ieșire scrie: r numără, rând-nou.
	Ieșire scrie: ( (r la: ['k']) = value ), rând-nou.
}.
