

>> memorieFolosită1 := 0.
>> memorieFolosită2 := 0.
>> memorieFolosită3 := 0.
>> memorieFolosită4 := 0.

Program gestiune-memorie: 0.

>> a := Listă ← ['hello'] ; ['world'] ; Adevărat ; Nimic ; 666.
a fă scoate-ultimul scoate-primul adaugă-la-început: ['salut'], adaugă-la-sfârșit: 999, gata.
Ieșire scrie: ( a unește: [','] ), rând-nou.

Program curăță.
memorieFolosită1 := (Program memorie ? 0).


a := Listă ← ['hello'] ; ['world'] ; Adevărat ; Nimic ; 666.
a scoate-ultimul. a scoate-primul. a adaugă-la-început: ['salut'], adaugă-la-sfârșit: 999.
Ieșire scrie: ( a unește: [','] ), rând-nou.


Program curăță.
memorieFolosită2 := (Program memorie ? 0).


a := Listă ← ['hello'] ; ['world'] ; Adevărat ; Nimic ; 666.
a fă scoate-ultimul scoate-primul adaugă-la-început: ['salut'], adaugă-la-sfârșit: 999, gata.
Ieșire scrie: ( a unește: [','] ), rând-nou.


Program curăță.
memorieFolosită3 := (Program memorie ? 0).



( memorieFolosită1 = memorieFolosită2 și: memorieFolosită1 = memorieFolosită3, și: memorieFolosită2 = memorieFolosită3 ) adevărat: {
	Ieșire scrie: ['Fără scurgeri de memorie aici'].
}, fals: {
	Ieșire scrie: ['Se scurge memorie...'].
}.
