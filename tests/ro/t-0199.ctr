
Program gestiune-memorie: 4.

>> Animal := Obiect nou.
Animal la: ['make'] execută: {
	>> animal := Obiect nou.
	animal la: ['makeSound'] execută: {
		Ieșire scrie: propriu sound.
	}. <- animal.
}.
>> Cat := Obiect nou.
Cat la: ['make'] execută: {
	>> cat := Animal make.
	cat la: ['init'] execută: {
		propriu sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
