>> fraze := Listă nou
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> mesajul := ['Phrase: ~decoded base64: ~encoded'].
	
fraze fiecare: { :_ :frază 
	>> e := Server base64-codifică: frază.
	>> d := Server base64-decodifică: e.
	Ieșire scrie: (
		mesajul copiază ~encoded: e, ~decoded: d
	), rând-nou.
}.
