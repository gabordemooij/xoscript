
>> memorieFolosită1 := 0.
>> memorieFolosită2 := 0.
>> memorieFolosită3 := 0.
>> memorieFolosită4 := 0.

>> cod := {
	>> o := (
		Dicționar nou
		aa: (Listă ← 1 ; 2),
		bb: (Listă ← 3 ; 4)
	).
	>> s := o text.
	>> o2 := s obiect.
	(s  tip = Text tip) adevărat: { Ieșire scrie: ['OK1'], rând-nou. }.
	(o2 tip = Dicționar tip) adevărat: { Ieșire scrie: ['OK2'], rând-nou. }.
}.

Program gestiune-memorie: 0.
['Memoria 1 va fi diferită, blocurile urmărite se adaugă în bloc.'].
Program curăță.
memorieFolosită1 := (Program memorie ? 1).
cod pornește.
Program curăță.
memorieFolosită2 := (Program memorie ? 1).
cod pornește.
Program curăță.
memorieFolosită3 := (Program memorie ? 1).
cod pornește.
Program curăță.
memorieFolosită4 := (Program memorie ? 1).

(memorieFolosită2 = memorieFolosită3 = memorieFolosită4) adevărat: { Ieșire scrie: ['OK3'], rând-nou. }.
 
