Text la: ['html'] execută: { <- (
		sine
		înlocuiește: ['&'] cu: ['&amp;'],
		înlocuiește: ['<'] cu: ['&lt;'],
		înlocuiește: ['>'] cu: ['&gt;'],
		înlocuiește: ['''] cu: ['&apos;'],
		înlocuiește: ['"'] cu: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Program gestiune-memorie: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Ieșire scrie: txt copiază html, rând-nou.
Ieșire scrie: txt copiază minuscule, rând-nou.
Ieșire scrie: txt copiază majuscule, rând-nou.
} pornește.

Program curăță.

usedMemory1 := (Program memorie ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Ieșire scrie: txt copiază html, rând-nou.
Ieșire scrie: txt copiază minuscule, rând-nou.
Ieșire scrie: txt copiază majuscule, rând-nou.
} pornește.

Program curăță.
usedMemory2 := (Program memorie ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Ieșire scrie: txt copiază html, rând-nou.
Ieșire scrie: txt copiază minuscule, rând-nou.
Ieșire scrie: txt copiază majuscule, rând-nou.
} pornește.

Program curăță.
usedMemory3 := (Program memorie ? 0).



( usedMemory1 = usedMemory2 și: usedMemory1 = usedMemory3, și: usedMemory2 = usedMemory3 ) adevărat: {
	Ieșire scrie: ['No memory leaks here'].
}, fals: {
	Ieșire scrie: ['Leaking memory...'].
}.
