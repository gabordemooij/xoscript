# test calificative

>> $ := Obiect nou.

$ la: ['răspunde:'] execută: { :x
	
	>> operație := x caracter: 0.
	>> valută := x caracter: 1.
	>> bani := x decalaj: 2.
	
	>> cuantum := 0.

	( operație = ['+'] ) adevărat: {
		( valută = ['£'] ) adevărat: { cuantum := 1.28 × bani. }.
	}. <- cuantum.
}.



>> x := $ +£20.

Ieșire scrie: x, rând-nou.


>> Fruct := Obiect nou.

Fruct la: ['nou'] execută: {
	>> f := sine nou.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruct la: ['apples:'] execută: { :a propriu mere := a. }.
Fruct la: ['oranges:'] execută: { :p propriu portocale := p. }.
Fruct la: ['mere'] execută: { <- propriu mere. }.
Fruct la: ['portocale'] execută: { <- propriu portocale. }.

Fruct la: ['+'] execută: { :f
	
	>> n := Fruct nou.
	f adaugă: 1.
	
	n apples: (f mere + propriu mere).
	n oranges:  (f portocale  + propriu portocale). <- n.
}.

Fruct la: ['text'] execută: { <- ( propriu mere text + [' mere și '] + propriu portocale + [' portocale'] ).
}.

Număr la: ['mere'] execută: { <- ((Fruct nou) apples: sine).
}.

Număr la: ['apple'] execută: { <- ((Fruct nou) apples: sine).
}.

Număr la: ['portocale'] execută: { <- ((Fruct nou) oranges: sine).
}.




Ieșire scrie: (1 apple + 3 portocale + 4 mere), rând-nou.


Text la: ['deDouăOri'] execută: { <- ((sine text) + (sine text)).
}.



Ieșire scrie: ['❤❤❤'] deDouăOri.



