# test qualifiers

>> $ := Obiect nou.

$ la: ['răspunde:'] execută: { :x
	
	>> operation := x caracter: 0.
	>> valuta := x caracter: 1.
	>> money := x decalaj: 2.
	
	>> amount := 0.

	( operation = ['+'] ) adevărat: {
		( valuta = ['£'] ) adevărat: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Ieșire scrie: x, rând-nou.


>> Fruit := Obiect nou.

Fruit la: ['nou'] execută: {
	>> f := sine nou.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit la: ['apples:'] execută: { :a propriu apples := a. }.
Fruit la: ['oranges:'] execută: { :p propriu oranges := p. }.
Fruit la: ['apples'] execută: { <- propriu apples. }.
Fruit la: ['oranges'] execută: { <- propriu oranges. }.

Fruit la: ['+'] execută: { :f
	
	>> n := Fruit nou.
	f adaugă: 1.
	
	n apples: (f apples + propriu apples).
	n oranges:  (f oranges  + propriu oranges). <- n.
}.

Fruit la: ['text'] execută: { <- ( propriu apples text + [' apples and '] + propriu oranges + [' oranges'] ).
}.

Număr la: ['apples'] execută: { <- ((Fruit nou) apples: sine).
}.

Număr la: ['apple'] execută: { <- ((Fruit nou) apples: sine).
}.

Număr la: ['oranges'] execută: { <- ((Fruit nou) oranges: sine).
}.




Ieșire scrie: (1 apple + 3 oranges + 4 apples), rând-nou.


Text la: ['twice'] execută: { <- ((sine text) + (sine text)).
}.



Ieșire scrie: ['❤❤❤'] twice.



