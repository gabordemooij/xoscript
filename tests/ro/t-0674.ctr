# flux normal
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> cale := ['/tmp/dat.csv'].
>> csv := Fișier nou: cale.
csv scrie: s.

# acceptă CRLF LF CR, lungime variabilă a rândurilor
csv delimitator: [';'] ghilimele: ['"'] linii: { :line
	Program curăță.
	Ieșire scrie: line, rând-nou.
	Program curăță.
}.

# rânduri inegale
s adaugă-la-sfârșit: ['\njustone'].
csv scrie: s.
{
	csv delimitator: [';'] ghilimele: ['"'] linii: { :line
		Ieșire scrie: line, rând-nou.
	}.
} prinde: { :e 
	Ieșire scrie: e, rând-nou.
}, pornește.

# format invalid
s := ['"he"llo";world'].
csv scrie: s.
{
	csv delimitator: [';'] ghilimele: ['"'] linii: { :line
		Ieșire scrie: line, rând-nou.
	}.
} prinde: { :e 
	Ieșire scrie: e, rând-nou.
}, pornește.
