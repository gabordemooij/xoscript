>> a := Obiect nou. 
a la: ['salută'] execută: { Ieșire scrie: ['bun venit!'], rând-nou. }.
a la: ['salută2'] execută: { Ieșire scrie: ['bun venit2!'], rând-nou. }.
a save-as: ['/tmp/a.bin'].

