Ieșire scrie: ['Obiect de test'], rând-nou.
>> a := Obiect nou. 

a la: ['item:'] execută: { :dicț
	propriu dicț := dicț. 
}.

a la: ['articol'] execută: {
	<- propriu dicț.
}.

a item: (
Dicționar nou
	hello: ['world']).

>> adresă-veche-dicț := a articol prototip adresă-memorie.
a save-as: ['/tmp/a.bin'].
