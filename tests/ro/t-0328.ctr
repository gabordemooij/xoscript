Program gestiune-memorie: 4.

>> Dublor := Obiect nou.
>> Multiplicator := Obiect nou.
Dublor la: ['dublează:și:'] execută: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplicator la: ['înmulțește:și:'] execută: { :x :y <- (x × y).
}.

Ieșire scrie: (
	Dublor dublează:
		(Dublor dublează: 
			(Multiplicator înmulțește: 2 și: 3)
		și:
			(Multiplicator înmulțește: 3 și: 4)
		)
	și:
		(Dublor dublează: 
			(Multiplicator înmulțește: 2 și: 3)
		și:
			(Multiplicator înmulțește: 3 și: 4)
		)
), rând-nou.
