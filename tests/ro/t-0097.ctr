
Text la: ['html'] execută: { <- (
		sine
		înlocuiește: ['&'] cu: ['&amp;'],
		înlocuiește: ['<'] cu: ['&lt;'],
		înlocuiește: ['>'] cu: ['&gt;'],
		înlocuiește: ['"'] cu: ['&quot;']
	).
}.

>> PensulăHtml := Obiect nou.

PensulăHtml la: ['răspunde:'] execută: { :etichetă
	Ieșire scrie: (['<tag>↵'] tag: etichetă ).
}.

PensulăHtml la: ['răspunde:și:'] execută: { :etichetă :content
	etichetă := ( etichetă de-la: 0 lungime: (etichetă lungime - 1) ).
	Ieșire scrie: (['<tag content>↵'] tag: etichetă, content: content).
}.

PensulăHtml la: ['content:'] execută: { :textul
	Ieșire scrie: textul html, rând-nou.
}.

PensulăHtml la: ['atr:valoare:'] execută: { :atr :value <- ['attr="value"'] attr: atr, value: value.
}.

>> h := PensulăHtml nou.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h atr: ['class'] valoare: ['bold']),
		/span
	/body
/html.
		
