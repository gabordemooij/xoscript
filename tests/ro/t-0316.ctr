>> Grandfather := Obiect nou.
Grandfather la: ['greet'] execută: {
	Ieșire scrie: ['Ave!'], rând-nou.
}.
>> Father := Grandfather nou.
Father la: ['greet'] execută: {
	Ieșire scrie: ['Hello'], rând-nou.
	sine greet.
}.
>> Son := Father nou.
Son la: ['greet'] execută: {
	Ieșire scrie: ['Hi'], rând-nou.
	sine greet.
}.

Son greet.

>> Roundabout := Obiect nou.
Roundabout la: ['circle:'] execută: { :x
	Ieșire scrie: x, rând-nou.
	(x < 3) adevărat: { sine recursiv circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) adevărat: { Ieșire scrie: x, rând-nou. x adaugă: 1.  increment pornește. }. }.
increment pornește.