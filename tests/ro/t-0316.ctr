>> Bunic := Obiect nou.
Bunic la: ['salută'] execută: {
	Ieșire scrie: ['Ave!'], rând-nou.
}.
>> Tată := Bunic nou.
Tată la: ['salută'] execută: {
	Ieșire scrie: ['Hello'], rând-nou.
	sine salută.
}.
>> Fiu := Tată nou.
Fiu la: ['salută'] execută: {
	Ieșire scrie: ['Bună'], rând-nou.
	sine salută.
}.

Fiu salută.

>> SensGiratoriu := Obiect nou.
SensGiratoriu la: ['circle:'] execută: { :x
	Ieșire scrie: x, rând-nou.
	(x < 3) adevărat: { sine recursiv circle: x + 1. }.
}.

SensGiratoriu circle: 1.

>> x := 1.
>> incrementează := { (x ≤ 3) adevărat: { Ieșire scrie: x, rând-nou. x adaugă: 1.  incrementează pornește. }. }.
incrementează pornește.