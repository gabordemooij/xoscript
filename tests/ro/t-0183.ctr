

>> memorieFolosită1 := 0.
>> memorieFolosită2 := 0.
>> memorieFolosită3 := 0.
>> memorieFolosită4 := 0.

Program gestiune-memorie: 0.

>> o := Obiect nou.
>> o2 := Obiect nou.
Ieșire scrie: o Nimic?, rând-nou.
Ieșire scrie: o tip, rând-nou.
Ieșire scrie: ( o egal-cu: o ), rând-nou.
Ieșire scrie: ( o egal-cu: o2 ), rând-nou.
Ieșire scrie: o eu-însumi, rând-nou.
Ieșire scrie: ( o fă gata ), rând-nou.

Program curăță.

memorieFolosită1 := (Program memorie ? 0).


o := Obiect nou.
o2 := Obiect nou.
Ieșire scrie: o Nimic?, rând-nou.
Ieșire scrie: o tip, rând-nou.
Ieșire scrie: ( o egal-cu: o ), rând-nou.
Ieșire scrie: ( o egal-cu: o2 ), rând-nou.
