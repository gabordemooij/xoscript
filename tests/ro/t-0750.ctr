Ieșire scrie: ['Test object'], rând-nou.
>> a := Obiect nou. 

a la: ['item:'] execută: { :nil
	propriu nil := nil. 
}.

a la: ['item'] execută: { <- propriu nil.
}.

a item: Nimic.

Ieșire scrie: a item, rând-nou.

>> old-nil-address := a item prototip adresă-memorie.
a save-as: ['/tmp/a.bin'].
Ieșire scrie: ['========== RELOADING SNAP:'], rând-nou.

>> b := Obiect load-from: ['/tmp/a.bin'].

(b item prototip adresă-memorie = old-nil-address) adevărat: {
	Ieșire scrie: ['Object link re-attached.'], rând-nou.
}.

Ieșire scrie: b item, rând-nou.
