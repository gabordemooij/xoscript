>> factură := Obiect nou.
factură la: ['pornește'] execută: {
        propriu număr := 0.
}.

factură la: ['număr'] execută: {
        propriu număr adaugă: 1.
        <- propriu număr copiază.
}.

>> factură-anuală := factură nou.
factură-anuală la: ['start:'] execută: { :an
	propriu număr := an.
}.

factură-anuală start: 202000.
Ieșire scrie: factură-anuală număr, rând-nou.
Ieșire scrie: factură-anuală număr, rând-nou.
