>> invoice := Obiect nou.
invoice la: ['pornește'] execută: {
        propriu număr := 0.
}.

invoice la: ['număr'] execută: {
        propriu număr adaugă: 1. <- propriu număr copiază.
}.

>> year-invoice := invoice nou.
year-invoice la: ['start:'] execută: { :an
	propriu număr := an.
}.

year-invoice start: 202000.
Ieșire scrie: year-invoice număr, rând-nou.
Ieșire scrie: year-invoice număr, rând-nou.
