# test list operations


>> cakes := Listă ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes înlocuiește: 1 lungime: 2 cu: ( Listă ← ['cinnamon'] ; ['pineapple'] ).
Ieșire scrie: (buy unește: [',']), rând-nou.


>> buy := cakes înlocuiește: 1 lungime: 12 cu: ( Listă ← ['cinnamon'] ; ['pineapple'] ).
Ieșire scrie: (buy unește: [',']), rând-nou.


>> buy := cakes înlocuiește: 2 lungime: 10 cu: ( Listă nou ).
Ieșire scrie: (buy unește: [',']), rând-nou.


>> buy := cakes înlocuiește: 0 lungime: 1 cu: ( Listă nou ).
Ieșire scrie: (buy unește: [',']), rând-nou.


>> buy := cakes înlocuiește: ['0'] lungime: ['1'] cu: ['x'].
Ieșire scrie: (buy unește: [',']), rând-nou.
