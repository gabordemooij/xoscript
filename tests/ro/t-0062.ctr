Boolean la: ['xor:'] execută: { :a :b <- ((a și: b nu) sau: (a nu și: b)).
}.

>> o := Obiect nou.
o la: ['hello'] execută: { ['Gol']. }.
{ o la: 2 execută: 3.} prinde: { :e Ieșire scrie: e, rând-nou. }, pornește.
{ o la: ['test'] execută: 3.} prinde: { :e Ieșire scrie: e, rând-nou. }, pornește.
{ o la: ['hello'] execută: { ['Gol']. }.} prinde: { :e Ieșire scrie: e, rând-nou. }, pornește. 
{ >> z := 4 ÷ 0. } prinde: { :e Ieșire scrie: e, rând-nou. }, pornește. 
{ (Adevărat și: Nimic) adevărat: { Ieșire scrie: ['X'].}. } prinde: { :e Ieșire scrie: e, rând-nou. }, pornește. 
{ ([''] xor: 0) adevărat: { Ieșire scrie: ['X'].}. } prinde: { :e Ieșire scrie: e, rând-nou. }, pornește. 
{ (1 < ['2']) adevărat: { Ieșire scrie: ['OK']. }. } prinde: { :e Ieșire scrie: e, rând-nou. }, pornește. 
{ (1 < ['2.0']) adevărat: { Ieșire scrie: ['OK']. }. } prinde: { :e Ieșire scrie: e, rând-nou. }, pornește. 
{ (1 < ['x2.0']) adevărat: { Ieșire scrie: ['NU!']. }. } prinde: { :e Ieșire scrie: e, rând-nou. }, pornește. 
{ Ieșire scrie: (['salut OK acolo'] de-la: ['6'] lungime: ['2']). } pornește. 
