Ieșire scrie: ['Continue for-loop, No - before 6 and up.'], rând-nou.
{ :i
	Ieșire scrie: (i + 1), rând-nou.
	((i + 1) > 4) continuă.
	Ieșire scrie: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Ieșire rând-nou.
Ieșire scrie: ['Continue while-true, No --> before 5 and up.'], rând-nou.
{
	Ieșire scrie: ['iteration #'] + x, rând-nou.
	x adaugă: 1.
	((x < 5) nu) continuă.
	Ieșire scrie: ['-->'].
} cât-timp: xIsLessThan10.
Ieșire rând-nou.
Ieșire scrie: ['Continue while-false, No - before 3 only.'], rând-nou.
{
	Ieșire scrie: ['iteration #'] + x, rând-nou.
	x scade: 1.
	(x = 3) continuă.
	Ieșire scrie: ['-'].
} cât-timp: { <- ( x > 0). }.

Ieșire rând-nou.
Ieșire scrie: ['Continue times-loop, No ||| before 3.'], rând-nou.
{ :i
	Ieșire scrie: ['iteration #'] + i, rând-nou.
	(i = 2) continuă.
	Ieșire scrie: ['|||'].
} × 5.

Ieșire rând-nou.

{ Adevărat continuă. Ieșire scrie: ['dont write this!'], rând-nou. } pornește.

{ Adevărat continuă. Ieșire scrie: ['dont write this!'], rând-nou. } prinde: { Ieșire scrie: ['Dont catch this!']. }, pornește.

Ieșire scrie: ['Test Array each-loop: 0, ... ,2'], rând-nou.
(Listă ← 1 ; 2 ; 3) transformă: { :i
	(i = 1) continuă.
	Ieșire scrie: ['iteration #'] + (i - 0), rând-nou.
}.

Ieșire scrie: ['Test Map each-loop: c only'], rând-nou.
>> m := Dicționar nou.
m pune: ['first'] la: ['a'], pune: ['second'] la: ['b'], pune: ['third'] la: ['c'].
m fiecare: { :k :v
	(k ≠ ['c']) continuă.
	Ieșire scrie: ['iteration'] + k + v, rând-nou.
}.

