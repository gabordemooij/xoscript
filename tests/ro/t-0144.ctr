



>> CoffeeGrounds := Obiect nou.
CoffeeGrounds la: ['extract'] execută: { <- ['coffee']. }.

>> CoffeeMachine := Obiect nou.
CoffeeMachine la: ['init'] execută: {
	propriu coffeegrounds := CoffeeGrounds nou.
}.
CoffeeMachine la: ['nou'] execută: { <- CoffeeMachine `new init.
}.

CoffeeMachine la: ['makeTea'] execută: { <- (propriu tealeaves extract). }.
CoffeeMachine la: ['makeCoffee'] execută: { <- (propriu coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine nou.

Ieșire scrie:
	coffeeDream 
	makeCoffee.

Ieșire scrie:
	coffeeDream 
	makeTea.
