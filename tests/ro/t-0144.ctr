



>> ZațDeCafea := Obiect nou.
ZațDeCafea la: ['extrage'] execută: { <- ['coffee']. }.

>> AparatDeCafea := Obiect nou.
AparatDeCafea la: ['init'] execută: {
	propriu zațdecafea := ZațDeCafea nou.
}.
AparatDeCafea la: ['nou'] execută: { <- AparatDeCafea `new init.
}.

AparatDeCafea la: ['făCeai'] execută: { <- (propriu frunzedeceai extrage). }.
AparatDeCafea la: ['făCafea'] execută: { <- (propriu zațdecafea extrage). }.

>> visDeCafea := AparatDeCafea nou.

Ieșire scrie:
	visDeCafea 
	făCafea.

Ieșire scrie:
	visDeCafea 
	făCeai.
