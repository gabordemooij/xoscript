# test type casts / conversions / bindings
Program gestiune-memorie: 4.
Server init.

>> counter := 0.
>> db := Maria-DB nou gazdă: ['localhost'],
	utilizator: ['xo'], parolă: ['pass123'], nume-bază: ['xobase'], conectează.

>> TwoDigitFormat := Format nou: ['%02d'].

# Datetime
{
	>> an := Număr între: 1995 și: 2050, text.
	>> lună := TwoDigitFormat aplică-întreg: (Număr între: 1 și: 12), text.
	>> zi := TwoDigitFormat aplică-întreg: (Număr între: 1 și: 28), text.
	>> oră := TwoDigitFormat aplică-întreg: (Număr între: 1 și: 23), text.
	>> minut := TwoDigitFormat aplică-întreg: (Număr între: 1 și: 59), text.
	>> secundă := TwoDigitFormat aplică-întreg: (Număr între: 1 și: 59), text.
	>> datetime := ['YYYY-MM-DD HH:II:SS'].	
	datetime
		YYYY: an,
		MM: lună,
		DD: zi,
		HH: oră,
		II: minut,
		SS: secundă.
	>> parametri-căutare :=
	db interogare: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: datetime),
	preia: { :row
		(row mydatetime = datetime) fals: {
			această-sarcină eroare: (
				['Expected: <expected> but got: <observation>']
				<expected>: datetime,
				<observation>: row mydatetime
			).
		}.
	
	}.
	counter adaugă: 1.
} * 100.

# Date
{
	>> an := Număr între: 1995 și: 2050, text.
	>> lună := TwoDigitFormat aplică-întreg: (Număr între: 1 și: 12), text.
	>> zi := TwoDigitFormat aplică-întreg: (Număr între: 1 și: 28), text.
	>> date := ['YYYY-MM-DD'].
	date
		YYYY: an,
		MM: lună,
		DD: zi.
	>> parametri-căutare :=
	db interogare: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: date),
	preia: { :row
		(row mydate = date) fals: {
			această-sarcină eroare: (
				['Expected: <expected> but got: <observation>']
				<expected>: date,
				<observation>: row mydate
			).
		}.
	}.
	counter adaugă: 1.
} * 100.


# Time
{
	>> oră := TwoDigitFormat aplică-întreg: (Număr între: 1 și: 23), text.
	>> minut := TwoDigitFormat aplică-întreg: (Număr între: 1 și: 59), text.
	>> secundă := TwoDigitFormat aplică-întreg: (Număr între: 1 și: 59), text.
	>> timp := ['HH:II:SS'].
	timp
		HH: oră,
		II: minut,
		SS: secundă.
	>> parametri-căutare :=
	db interogare: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: timp),
	preia: { :row
		(row mytime = timp) fals: {
			această-sarcină eroare: (
				['Expected: <expected> but got: <observation>']
				<expected>: datetime,
				<observation>: row mytime
			).
		}.
	}.
	counter adaugă: 1.
} * 100.


# Strings (varchar/text)
>> str1 := Listă nou umple: 100000 cu: ['x'], unește: [''].
{
	>> str2 := Seif jeton: 40.
	>> parametri-căutare :=
	db interogare: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	preia: { :row
		(row str1 = str1 și: row str2 = str2) fals: {
			această-sarcină eroare: (
				['Expected: <expected> but got: <observation>']
				<expected>: datetime,
				<observation>: row mytime
			).
		}.
	}.
	counter adaugă: 1.
} * 100.


# Numbers
{
	>> n1 := Număr între: 1 și: 99999.
	>> n2 := n1 / 1000.
	>> big := (
		( Int64 din-text: ['9223372036854775807'] ) -
		( Int64 din-text: ['99999'] ) +
		( Int64 din-text: n1 text )
	).
	>> parametri-căutare :=
	db interogare: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	preia: { :row
		(row n1 = n1) fals: {
			această-sarcină eroare: (
				['Expected: <expected> but got: <observation>']
				<expected>: n1,
				<observation>: row n1
			).
		}.
		(row n2 = n2) fals: {
			această-sarcină eroare: (
				['Expected: <expected> but got: <observation>']
				<expected>: n1,
				<observation>: row n2
			).
		}.
		(row n3 = n2 rotunjește) fals: {
			această-sarcină eroare: (
				['Expected: <expected> but got: <observation>']
				<expected>: n1,
				<observation>: row n3
			).
		}.
		(row big = big) fals: {
			această-sarcină eroare: (
				['Expected: <expected> but got: <observation>']
				<expected>: big,
				<observation>: row big
			).
		}.
		
	}.
	counter adaugă: 1.
} * 100.


Ieșire scrie: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: counter
), rând-nou.