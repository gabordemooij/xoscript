Program curăță.
memorieFolosită3 := (Program memorie ? 0).

( memorieFolosită1 = memorieFolosită2 și: memorieFolosită1 = memorieFolosită3, și: memorieFolosită2 = memorieFolosită3 ) adevărat: {
	Ieșire scrie: ['Fără scurgeri de memorie aici'].
}, fals: {
	Ieșire scrie: ['Se scurge memorie...'].
}.
