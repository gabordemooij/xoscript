

Listă la: ['sumă'] execută: {
	>> total := 0.
	sine fiecare: { :indice :element
		total adaugă: element.
	}. <- total.
}.

Listă la: ['produs'] execută: {
	>> total := 1.
	sine fiecare: { :indice :element
		total înmulțește-cu: element.
	}. <- total.
}.

>> memorieFolosită1 := 0.
>> memorieFolosită2 := 0.
>> memorieFolosită3 := 0.
>> memorieFolosită4 := 0.

Program gestiune-memorie: 0.

{

>> a := Listă ← ['hello'] ; ['world'] ; Adevărat ; Nimic ; 666.
a := a + ( Listă ← 1 ).
Ieșire scrie: ( ['sumă: '] + ( a sumă ) ), rând-nou.
Ieșire scrie: ( ['min: '] + ( a minim ) ), rând-nou.
Ieșire scrie: ( ['max: '] + ( a maxim ) ), rând-nou.
Ieșire scrie: ( ['al 3-lea: '] + ( a ? 2 ) ), rând-nou.
Ieșire scrie: ( ['prod: '] + ( a produs ) ), rând-nou.
a sortează: { :a :b <- (b - a). }.
a fiecare: { :i :e Ieșire scrie: ( i - 0 ), rând-nou. }.

} pornește.

Program curăță.
memorieFolosită1 := (Program memorie ? 0).


{

>> a := Listă ← ['hello'] ; ['world'] ; Adevărat ; Nimic ; 666.
a := a + ( Listă ← 1 ).
Ieșire scrie: ( ['sumă: '] + ( a sumă ) ), rând-nou.
Ieșire scrie: ( ['min: '] + ( a minim ) ), rând-nou.
Ieșire scrie: ( ['max: '] + ( a maxim ) ), rând-nou.
Ieșire scrie: ( ['al 3-lea: '] + ( a ? 2 ) ), rând-nou.
Ieșire scrie: ( ['prod: '] + ( a produs ) ), rând-nou.
a sortează: { :a :b <- (b - a). }.
a fiecare: { :i :e Ieșire scrie: ( i - 0 ), rând-nou. }.

} pornește.



