>> Point := Obiect nou.
Point la: ['x-coordinate:'] execută: { :x propriu x := x. }.
Point la: ['y-coordinate:'] execută: { :y propriu y := y. }.
Point la: ['x-coordinate']  execută: { <- propriu x copiază. }.
Point la: ['y-coordinate']  execută: { <- propriu y copiază. }.

Point la: ['='] execută: { :other <- ( propriu x = other x-coordinate
		 și: propriu y = other y-coordinate ).
}.

>> pier := Point nou x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point nou x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point nou x-coordinate: 5, y-coordinate: 6.

Ieșire scrie: pier = town-hall, rând-nou.
Ieșire scrie: pier = restaurant, rând-nou.
