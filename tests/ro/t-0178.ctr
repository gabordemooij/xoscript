

>> memorieFolosită1 := 0.
>> memorieFolosită2 := 0.
>> memorieFolosită3 := 0.
>> memorieFolosită4 := 0.

Program gestiune-memorie: 0.

>> txt := ['Word Salad'].
Ieșire scrie: ['ultimul indice al lui ord = '] + (( txt ultimul: ['ord'] ) - 0), rând-nou.
Ieșire scrie: ['indicele lui ord = '] + (( txt caută: ['ord'] ) - 0), rând-nou.
Ieșire scrie: ['indicele lui ad = '] + (( txt caută: ['ad'] ) - 0), rând-nou.
Ieșire scrie: ['ultimul indice al lui W = '] + (( txt ultimul: ['W'] ) - 0), rând-nou.
Ieșire scrie: ['ultimul indice al lui d = '] + (( txt ultimul: ['d'] ) - 0), rând-nou.
Ieșire scrie: ['txt este egal cu Word Salad = '] + ( txt = ['Word Salad'] ), rând-nou.
Ieșire scrie: ['txt este egal cu Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), rând-nou.
Ieșire scrie: ['txt nu este egal cu Word Salad = '] + ( txt ≠ ['Word Salad'] ), rând-nou.
Ieșire scrie: ['txt nu este egal cu Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), rând-nou.

