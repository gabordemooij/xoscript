# a value ending in the first part of an opening quote must survive serialization
>> valori := Listă nou
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

valori fiecare: { :i :value
	>> d := Dicționar nou.
	d pune: value la: ['k'].
	d pune: ['second'] la: ['j'].
	>> r := d cod obiect.
	Ieșire scrie: r numără, rând-nou.
	Ieșire scrie: ( (r la: ['k']) = value ), rând-nou.
}.
