Server init.
>> f := Format nou: ['%d'].
>> a := Blob nou: 4.
a bytes: ( Listă nou ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob nou: 4.
b bytes: ( Listă nou ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a de-la: 0 lungime: 3, fiecare: { :i :byte
	Ieșire scrie: ( f aplică-întreg: byte ), rând-nou.
}.
a ^ b.
a de-la: 0 lungime: 3, fiecare: { :i :byte
	Ieșire scrie: ( f aplică-întreg: byte ), rând-nou.
}.
a ^ b.
a de-la: 0 lungime: 3, fiecare: { :i :byte
	Ieșire scrie: ( f aplică-întreg: byte ), rând-nou.
}.
a eliberează.
b eliberează.

{ a ^ Obiect. } prinde: { :e Ieșire scrie: e, rând-nou. }, pornește.
