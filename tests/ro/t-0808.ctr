# cheile și semnăturile din seif care se decodifică prea lungi nu trebuie să depășească stiva
Server init.

>> chei := Seif generează-chei.
>> cs := chei primul.
>> cp := chei ultimul.
>> semn := Seif semnează: ['abc'] cu: cs.

# 88 de caractere fără padding se decodifică în 66 de octeți
>> lung := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 de caractere fără padding se decodifică în 33 de octeți
>> scurt := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Seif semnează: ['abc'] cu: lung. } prinde: { :e
	Ieșire scrie: e, rând-nou.
}, pornește.

{ Seif verifică: ['abc'] semnătură: lung cu: cp. } prinde: { :e
	Ieșire scrie: e, rând-nou.
}, pornește.

{ Seif verifică: ['abc'] semnătură: semn cu: scurt. } prinde: { :e
	Ieșire scrie: e, rând-nou.
}, pornește.
