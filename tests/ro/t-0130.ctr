# utilizarea FFI cu pluginul Server

# conectare la libc (specific platformei)
>> numeBibliotecă := Program setare: ['FFITESTLIB'].

# legăm funcții stdio din C pentru operații avansate cu fișiere
Server leagă: ( Listă nou ;
 numeBibliotecă ; ['fopen'] ;
 ( Listă nou ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
leagă: ( Listă nou ;
 Nimic ; # înseamnă aceeași bibliotecă
 ['fread'] ;
 ( Listă nou ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nimic ; # înseamnă același obiect (adică Flux)
 ['fread']
),
leagă: (
 Listă nou ;
 Nimic ; # înseamnă aceeași bibliotecă
 ['fwrite'] ;
 ( Listă nou ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nimic ; # înseamnă aceeași bibliotecă
 ['fwrite']
),
leagă: (
 Listă nou ;
 Nimic ; # înseamnă aceeași bibliotecă
 ['rewind'] ;
 ( Listă nou ; ['pointer'] ) ;
 ['int'] ;
 Nimic ; # înseamnă aceeași bibliotecă
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> cale := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# deschidem un fișier cu fopen(path, mode)
>> fd := Stream path: cale mode: mode.

# scriem octeții din tamponul șir în fișier
>> octeți-scriși := Stream mesaj: ['fwrite'] argumente: (Listă nou ; str ; 1 ; 6 ; fd ).
Ieșire scrie: octeți-scriși, rând-nou.

# readucem indicatorul fișierului la început
Stream rewind: fd.

# alocăm un tampon
>> tamp := Blob nou: 20.

# citim din fișier
>> octeți-citiți := Stream mesaj: ['fread'] argumente: (Listă nou ; tamp ; 1 ; 6 ; fd ).
Ieșire scrie: octeți-citiți, rând-nou.
Ieșire scrie: tamp, rând-nou.

# eliberăm memoria
str  eliberează.
cale eliberează.
mode eliberează.
tamp  eliberează.


