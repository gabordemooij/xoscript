# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Program setare: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server leagă: ( Listă nou ;
 libname ; ['fopen'] ;
 ( Listă nou ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
leagă: ( Listă nou ;
 Nimic ; # means same lib
 ['fread'] ;
 ( Listă nou ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nimic ; # means same object (i.e. Stream)
 ['fread']
),
leagă: (
 Listă nou ;
 Nimic ; # means same lib
 ['fwrite'] ;
 ( Listă nou ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Nimic ; # means same lib
 ['fwrite']
),
leagă: (
 Listă nou ;
 Nimic ; # means same lib
 ['rewind'] ;
 ( Listă nou ; ['pointer'] ) ;
 ['int'] ;
 Nimic ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> cale := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: cale mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream mesaj: ['fwrite'] argumente: (Listă nou ; str ; 1 ; 6 ; fd ).
Ieșire scrie: bytes-written, rând-nou.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob nou: 20.

# read from file
>> bytes-read := Stream mesaj: ['fread'] argumente: (Listă nou ; buf ; 1 ; 6 ; fd ).
Ieșire scrie: bytes-read, rând-nou.
Ieșire scrie: buf, rând-nou.

# free memory
str  eliberează.
cale eliberează.
mode eliberează.
buf  eliberează.


