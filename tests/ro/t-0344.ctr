# test catch-all (practic)
>> HTML := Text nou.
HTML la: ['encode:'] execută: { :tekst
	sine adaugă-la-sfârșit: (tekst
	înlocuiește: ['&'] cu: ['&amp;'], 
	înlocuiește: ['<'] cu: ['&lt;'],
	înlocuiește: ['>'] cu: ['&gt;'],
	înlocuiește: ['"'] cu: ['&quot;']).
}.
>> blog := HTML nou.
blog adaugă-la-sfârșit: ['<h1>'],
     encode: ['Koffie & Thee'],
     adaugă-la-sfârșit: ['</h1>'].
Ieșire scrie: blog, rând-nou.


>> Roman := Număr nou.
Roman la: ['textual'] execută: {
	>> a := [''].
	{ a adaugă-la-sfârșit: ['I']. } × sine. <- a.
}.

>> x := Roman nou.
x adaugă: 3.
Ieșire scrie: x textual, rând-nou.

>> Cuantic := Boolean nou.
Cuantic la: ['true?'] execută: { <- ['poate Adevărat']. }.
Ieșire scrie: (Cuantic nou true?), rând-nou.

>> Nihil := Nimic nou.
Nihil la: ['text'] execută: { <- ['Nihil']. }.
Ieșire scrie: (Nihil nou), rând-nou.
