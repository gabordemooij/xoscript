Număr la: ['factorial'] execută: {
	>> total := 1.
	{ :index total înmulțește-cu: (sine - (index)). } × sine. <- total.
}.
>> Printer := Obiect nou.
Printer la: ['print:and:'] execută: { :x :y
	Ieșire scrie: ['a='] + x + [', b='] + y, rând-nou.
}.
>> a := 4.5. >> b := a rotunjește-în-jos.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a rotunjește-în-sus.
Printer print: a and: b.
a := 4.5. b := a rotunjește-în-jos.
Printer print: a and: b.
a := 4.5. b := a rotunjește.
Printer print: a and: b.
a := 4.2. b := a rotunjește.
Printer print: a and: b.

Ieșire scrie: (9 modulo: 5), rând-nou.
Ieșire scrie: -666 absolut, rând-nou.
Ieșire scrie: 49 radical, rând-nou.
Ieșire scrie: (2 la-puterea: 3), rând-nou.
>> l := (Listă ← 9 ; 6).
Ieșire scrie: l minim.

