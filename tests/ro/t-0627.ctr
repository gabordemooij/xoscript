

# create a 64-bit integer for exact calculations
>> a := Int64 din-text: ['123'].

# to string
Ieșire scrie: a, rând-nou.

# divide
Ieșire scrie: a / (Int64 din-text: ['3']), rând-nou.

# multiply
Ieșire scrie: a * (Int64 din-text: ['2']), rând-nou.

# add
Ieșire scrie: a + (Int64 din-text: ['1']), rând-nou.

# subtract
Ieșire scrie: a - (Int64 din-text: ['2']), rând-nou.

# compare
Ieșire scrie: ( a =   (Int64 din-text: ['123'])), rând-nou.
Ieșire scrie: ( a !=: (Int64 din-text: ['124'])), rând-nou.
Ieșire scrie: ( a <   (Int64 din-text: ['124'])), rând-nou.
Ieșire scrie: ( a >   (Int64 din-text: ['122'])), rând-nou.
Ieșire scrie: ( a >=: (Int64 din-text: ['123'])), rând-nou.
Ieșire scrie: ( a <=: (Int64 din-text: ['123'])), rând-nou.





	