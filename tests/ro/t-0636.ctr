# test analiză url

Server init.
>> url := URL din: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Ieșire scrie: ['schemă = '] + url schemă, rând-nou.
Ieșire scrie: ['gazdă = '] + url gazdă, rând-nou.
Ieșire scrie: ['port = '] + url port, rând-nou.
Ieșire scrie: ['cale = '] + url cale, rând-nou.
Ieșire scrie: ['interogare = '] + url parametri-căutare, rând-nou.
Ieșire scrie: ['fragment = '] + url fragment, rând-nou.
