

>> ob := Obiect nou.

ob la: ['salută'] execută: {
	<- ['salut'].
}.

# trebuie să afișeze hi123hi123ok
ob la: ['sarcină'] execută: {
	propriu proprietate := 123.
	{
		# încearcă leagă sine/propriu de obiect în loc de bloc
		Ieșire scrie: sine salută.
		Ieșire scrie: propriu proprietate.
		1 / 0.
	} prinde: {
		Ieșire scrie: sine salută.
		Ieșire scrie: propriu proprietate.
		Ieșire scrie: ['ok'].
	}, încearcă.
}.

ob sarcină.