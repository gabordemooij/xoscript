
Server init.
>> cer := Cerere-HTTP nou.
Ieșire scrie: ['HTTP-GET d[]=']  + ( cer get-listă: ['d[]'] ), rând-nou. # GET
Ieșire scrie: ['HTTP-GET f[]=']  + ( cer get-listă: ['f[]'] ), rând-nou. # GET
Ieșire scrie: ['HTTP-POST e[]='] + ( cer post-listă: ['e[]'] ), rând-nou. # GET
Ieșire scrie: ['HTTP-POST c=']   + ( cer post: ['c'] ), rând-nou. # GET
Ieșire scrie: ['HTTP-POST xx=']  + ( cer post: ['xx'] ), rând-nou. # GET
