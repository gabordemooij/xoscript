
Server init.
>> rq := Cerere-HTTP nou.
Ieșire scrie: ['HTTP-GET d[]=']  + ( rq get-listă: ['d[]'] ), rând-nou. # GET
Ieșire scrie: ['HTTP-GET f[]=']  + ( rq get-listă: ['f[]'] ), rând-nou. # GET
Ieșire scrie: ['HTTP-POST e[]='] + ( rq post-listă: ['e[]'] ), rând-nou. # GET
Ieșire scrie: ['HTTP-POST c=']   + ( rq post: ['c'] ), rând-nou. # GET
Ieșire scrie: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), rând-nou. # GET
