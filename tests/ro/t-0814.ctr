# session cookie format, json content type, web protocols only, svg shown inline
Server inițializează.
Program folosește: ['../../../src/xo/ro/webtools.xo'].

>> Fake-Request := Obiect nou.
Fake-Request la: ['value:'] execută: { :valoare
	propriu valoare := valoare.
}.
Fake-Request la: ['cookie:'] execută: { :nume <- propriu valoare.
}.

>> Test-Session := Sesiune-fișier-temporar nou.
Test-Session la: ['încarcă'] execută: { <- Dicționar nou.
}.
Test-Session la: ['session-id'] execută: { <- propriu id.
}.

>> cookies := Listă nou
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

cookies fiecare: { :i :cookie
	>> cerere := Fake-Request nou.
	cerere value: cookie.
	>> manager := Test-Session nou.
	>> web := Document-Web nou.
	web cerere: cerere.
	web manager-sesiune: manager.
	web pornește-sesiune.
	Ieșire scrie: ( manager session-id = cookie ), rând-nou.
}.

>> web := Document-Web nou.
web json: (Dicționar nou pune: ['b'] la: ['a']).
Ieșire scrie: ['\n'], rând-nou.

{ Rețea get: ['file:///etc/hostname']. } prinde: { :e
	Ieșire scrie: e, rând-nou.
}, pornește.

>> svg := Fișier nou: ['/tmp/test0814.svg'].
svg scrie: ['<svg xmlns="x"></svg>'].
Ieșire rând-nou.
Server transmite: ['test0814.svg'] prefix: ['/tmp/'].
svg șterge.
