Ieșire scrie: ['Test object'], rând-nou.
>> a := Obiect nou. 

a la: ['item:'] execută: { :binhelper
	propriu binhelper := binhelper. 
}.

a la: ['item'] execută: { <- propriu binhelper.
}.

a item: Bin nou.

>> old-binhelper-address := a item prototip adresă-memorie.
a save-as: ['/tmp/a.bin'].
Ieșire scrie: ['========== RELOADING SNAP:'], rând-nou.

>> b := Obiect load-from: ['/tmp/a.bin'].

(b item prototip adresă-memorie = old-binhelper-address) adevărat: {
	Ieșire scrie: ['Object link re-attached.'], rând-nou.
}.


