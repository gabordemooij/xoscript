
Server init.
Ieșire scrie: ['Test bază de date'], rând-nou.

>> bd := Maria-DB nou gazdă: ['localhost'],
	utilizator: ['xo'], 
	parolă: ['pass123'],
	nume-bază: ['xobase'],
	conectează.

>> parametri-căutare :=
bd interogare: ['SELECT UNHEX('CAFE') AS blobby'],
preia: { :rând
	Ieșire scrie: ( rând blobby de-la: 0 lungime: 2 ), rând-nou.
	rând blobby eliberează.
}.
