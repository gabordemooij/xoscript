['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Ieșire scrie: (x + y), rând-nou.

>> x := 10040.07.
>> y := 10305.60.

Ieșire scrie: (x + y), rând-nou.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Ieșire scrie: (x + y + z), rând-nou.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Ieșire scrie: (x + y + z), rând-nou.

>> q := 0.1.2.

Ieșire scrie: (q), rând-nou.

>> q := 012.

Ieșire scrie: (q), rând-nou.
