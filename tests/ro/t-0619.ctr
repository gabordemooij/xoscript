>> HTML := Obiect nou.
HTML la: ['răspunde:'] execută: { :etichetă 
	Ieșire scrie: (['<tag>'] tag: etichetă), rând-nou.
}.
HTML la: ['răspunde:și:'] execută: { :etichetă :html 
	Ieșire scrie: (
		['<tag>innerHTML</tag>']
		tag: etichetă - [':'],
		innerHTML: html
	), rând-nou.
}.
>> html := HTML nou.
html body h1: ['header'].

