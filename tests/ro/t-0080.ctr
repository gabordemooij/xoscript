{
	>> a := Listă nou.
	a adaugă-la-sfârșit: 1.
	a adaugă-la-sfârșit: 2.
	Ieșire scrie: (a unește: [',']), rând-nou.
	a pune: 3 la: 2.
	Ieșire scrie: (a unește: [',']), rând-nou.
	a pune: 4 la: 10.
	Ieșire scrie: (a unește: [',']), rând-nou.
	a scoate-primul.
	a scoate-primul.
	a scoate-primul.
	Ieșire scrie: (a unește: [',']), rând-nou.
	a pune: 9 la: 0.
	Ieșire scrie: (a unește: [',']), rând-nou.
	a pune: 6 la: -1.
} prinde: { :e
	Ieșire scrie: ['Uncatched error has occurred.↵'] + e, rând-nou.
}, pornește.


