
Listă la: ['sumă'] execută: {
	>> total := 0.
	sine fiecare: { :indice :element
		total adaugă: element.
	}. <- total.
}.

>> a := Listă ← 9 ; 8 ; 7.
Ieșire scrie: (a sumă), rând-nou. 
>> a := Listă ← 1 ; 9.
Ieșire scrie: (a sumă), rând-nou. 
>> a := Listă ← ['o'] ; 2.
Ieșire scrie: (a sumă), rând-nou. 
Ieșire scrie: (Listă nou sumă), rând-nou. 
