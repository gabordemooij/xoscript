>> items := Dicționar nou.
items pune: ['verde'] la: ['culoare-1'].
items pune: ['portocaliu'] la: ['culoare-2'].
items pune: ['roșu'] la: ['culoare-3'].
>> i := 0.
>> s := [''].
items fiecare: { :key :culoare
	Ieșire scrie: ['color #'] + i + [' este: '] + culoare + [' '].
	i adaugă: 1.
}.
Ieșire scrie: i + [' culori!'].
