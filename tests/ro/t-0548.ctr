Server init.

>> x := Blob nou: 65 tip: ['char'].
# pentru acest test trebuie setată o cale către libc (puts)
>> numeBibliotecă := Program setare: ['FFITESTLIB'].
Server leagă: (
 Listă nou ;
 numeBibliotecă ;
 ['putchar'] ;
 ( Listă nou ; ['char'] ) ;
 ['void'] ;
 ['Print'] ;
 ['char:']
).
Print char: (x de-la: 0 lungime: 1), rând-nou.
x eliberează.

