Ieșire scrie: ['Test object'], rând-nou.
>> greeter := Obiect nou.
greeter la: ['name:'] execută: { :nume
	propriu xname := nume. 
}.
greeter la: ['greet'] execută: {
	Ieșire scrie: ['Hello '] + propriu xname, rând-nou.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Ieșire scrie: ['========== RELOADING SNAP:'], rând-nou.
>> b := Obiect load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
