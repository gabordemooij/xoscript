Ieșire scrie: ['Obiect de test'], rând-nou.
>> salutator := Obiect nou.
salutator la: ['name:'] execută: { :nume
	propriu xnume := nume. 
}.
salutator la: ['salută'] execută: {
	Ieșire scrie: ['Salut '] + propriu xnume, rând-nou.
}.
salutator name: ['Sherlock'].
salutator save-as: ['/tmp/a.bin'].
Ieșire scrie: ['========== REÎNCĂRCARE SNAP:'], rând-nou.
>> b := Obiect load-from: ['/tmp/a.bin'].
b salută.
b name: ['Watson'], salută.
