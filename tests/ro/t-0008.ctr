>> Salutator := Obiect nou.
Salutator la: ['creează'] execută: {
	>> salutator := Obiect nou.
	salutator la: ['name:'] execută: { :nume
		Ieșire scrie: ['setez un nume'].
		propriu numeleMeu := nume.
	}.
	salutator la: ['salută'] execută: {
		Ieșire scrie: ['Hello'].
		Ieșire scrie: propriu numeleMeu.
	}. <- salutator.
}.
>> salutator := Salutator creează.
salutator name: ['soare!'].
salutator salută.
