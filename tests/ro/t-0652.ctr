# test număr -> text -> număr
{

	>> x := Număr între: 0 și: 1000000.
	>> d := Număr între: 1 și: 7.
	>> e := 10 la-puterea: d.

	x împarte-la: e.
	>> y := x text număr.

	(x = y) fals: {
		Ieșire scrie: x, rând-nou.
		Ieșire scrie: y, rând-nou.
		Program sfârșit.
	}.

} * 1000.
Ieșire scrie: ['OK'], rând-nou.