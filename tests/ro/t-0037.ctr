>> a := 3.
>> b := a copiază.
a scade: 1.
Ieșire scrie: [' a = '] + a.
Ieșire scrie: [' b = '] + b.
a := 3.
b := a + 4.
Ieșire scrie: [' a = '] + a.
Ieșire scrie: [' b = '] + b.
>> x := 3.
>> y := x copiază.
x adaugă: 10.
y scade: 1.
Ieșire scrie: [' x = '] + x.
Ieșire scrie: [' y = '] + y.
>> q := Obiect nou.
q la: ['setProperty:'] execută: { :x
	propriu prop := x.
}.
q la: ['getProperty'] execută: { <- propriu prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Ieșire scrie: [' p = '] + (p getProperty).
