Ieșire scrie: ['Test object'], rând-nou.
>> a := Obiect nou. 

a la: ['item:'] execută: { :hexhelper
	propriu hexhelper := hexhelper. 
}.

a la: ['item'] execută: { <- propriu hexhelper.
}.

a item: Hx nou.

>> old-hexhelper-address := a item prototip adresă-memorie.
a save-as: ['/tmp/a.bin'].
Ieșire scrie: ['========== RELOADING SNAP:'], rând-nou.

>> b := Obiect load-from: ['/tmp/a.bin'].

(b item prototip adresă-memorie = old-hexhelper-address) adevărat: {
	Ieșire scrie: ['Object link re-attached.'], rând-nou.
}.
