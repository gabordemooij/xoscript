60 × {
	>> x := (Număr aleator % 6) + 1.
	(x ≤ 6) fals: { Ieșire scrie: ['EȘEC']. }.
	(x ≥0) fals: { Ieșire scrie: ['EȘEC']. }.
	x := (Număr aleator % 3) + 1.
	(x < 3) fals: { Ieșire scrie: ['EȘEC']. }.
	(x>-1) fals: { Ieșire scrie: ['EȘEC']. }.
	x := ((Boolean întoarce) număr).
	(x = 0 sau: x = 1) fals: { Ieșire scrie: ['EȘEC']. }.
	x := ((Adevărat întoarce) număr).
	(x = 0 sau: x = 1) fals: { Ieșire scrie: ['EȘEC']. }.
	x := (Boolean întoarce sau: ['CAP'] sau: ['PAJURĂ']).
	((x = ['CAP']) sau: (x = ['PAJURĂ'])) fals: { Ieșire scrie: ['EȘEC']. }.
}.
Ieșire scrie: ['GATA'].

