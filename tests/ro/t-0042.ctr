>> items := Dicționar nou.
items pune: ['black'] la: ['coffee'], pune: ['earl grey'] la: ['tea'].
Ieșire scrie: (items la: ['coffee']), scrie: (items la: ['tea']).
Ieșire scrie: ['there are'] + items numără + [' items in the array.'].
items pune: ['capuccino'] la: ['coffee'].
Ieșire scrie: ['Now my coffee is.. '] + (items la: ['coffee']).
items pune: ['aaa'] la: ['1'].
items pune: ['bbb'] la: ['2'].
Ieșire scrie: (items la: ['a']).
