>> items := Dicționar nou.
items pune: ['neagră'] la: ['coffee'], pune: ['earl grey'] la: ['ceai'].
Ieșire scrie: (items la: ['coffee']), scrie: (items la: ['ceai']).
Ieșire scrie: ['sunt'] + items numără + [' elemente în tablou.'].
items pune: ['capucino'] la: ['coffee'].
Ieșire scrie: ['Acum cafeaua mea este.. '] + (items la: ['coffee']).
items pune: ['aaa'] la: ['1'].
items pune: ['bbb'] la: ['2'].
Ieșire scrie: (items la: ['a']).
