#Linux
>> clock := Moment nou.
clock zonă: ['UTC-1'].
clock an: 1981, lună: 1, zi: 5,
      oră: 13, minut: 15, secundă: 13.

Ieșire scrie: clock, rând-nou.
clock zonă: ['UTC+0'].

Ieșire scrie: (
	(clock an simplu) + ['-'] + (clock lună) + ['-'] + (clock zi) + [' '] +
	(clock oră) + [':'] + (clock minut) + [':'] + (clock secundă) + [' '] +
	['W'] + (clock săptămână) + (clock zonă)
), rând-nou.


clock zonă: ['UTC-1'].
Ieșire scrie: (
	(clock an simplu) + ['-'] + (clock lună) + ['-'] + (clock zi) + [' '] +
	(clock oră) + [':'] + (clock minut) + [':'] + (clock secundă) + [' '] +
	['W'] + (clock săptămână) + (clock zonă)
), rând-nou.
