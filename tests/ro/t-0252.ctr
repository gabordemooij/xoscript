#Linux
>> ceas := Moment nou.
ceas zonă: ['UTC-1'].
ceas an: 1981, lună: 1, zi: 5,
      oră: 13, minut: 15, secundă: 13.

Ieșire scrie: ceas, rând-nou.
ceas zonă: ['UTC+0'].

Ieșire scrie: (
	(ceas an simplu) + ['-'] + (ceas lună) + ['-'] + (ceas zi) + [' '] +
	(ceas oră) + [':'] + (ceas minut) + [':'] + (ceas secundă) + [' '] +
	['W'] + (ceas săptămână) + (ceas zonă)
), rând-nou.


ceas zonă: ['UTC-1'].
Ieșire scrie: (
	(ceas an simplu) + ['-'] + (ceas lună) + ['-'] + (ceas zi) + [' '] +
	(ceas oră) + [':'] + (ceas minut) + [':'] + (ceas secundă) + [' '] +
	['W'] + (ceas săptămână) + (ceas zonă)
), rând-nou.
