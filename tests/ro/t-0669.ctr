# Rezumatul parolelor
Server init.

# Utilizatorul setează o parolă
>> par := ['pass123'].

# O stocați astfel
>> rezumatul := Seif 
	rezumat-parolă: par.

# Apoi utilizatorul se autentifică
# Încercarea 1
>> a1 := ['abcd123'].
# Încercarea 2
>> a2 := ['pass123'].

# Verificare
>> a := Seif 
	rezumat-parolă: rezumatul verifică: a1.
	# eșec 
>> b := Seif
	rezumat-parolă: rezumatul verifică: a2.
	# ok!

Ieșire scrie: a, rând-nou.
Ieșire scrie: b, rând-nou.

