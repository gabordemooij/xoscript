Ieșire scrie: ['Obiect de test'], rând-nou.
>> a := Obiect nou. 

a la: ['item:'] execută: { :ieș
	propriu ieș := ieș. 
}.

a la: ['articol'] execută: {
	<- propriu ieș.
}.

a la: ['salută'] execută: {
	Ieșire scrie: ['salut de la ieșirea originală!'], rând-nou.
}.

a item: Ieșire.

Ieșire scrie: a articol, rând-nou.

>> adresă-veche-ieș := a articol prototip adresă-memorie.
a save-as: ['/tmp/a.bin'].
Ieșire scrie: ['========== REÎNCĂRCARE SNAP:'], rând-nou.

>> b := Obiect load-from: ['/tmp/a.bin'].

(b articol prototip adresă-memorie = adresă-veche-ieș) adevărat: {
	Ieșire scrie: ['Legătura obiectului a fost reatașată.'], rând-nou.
}.

b articol scrie: ['salutare de la ieșirea încărcată!'], rând-nou.
b salută.
