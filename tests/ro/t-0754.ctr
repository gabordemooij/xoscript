Ieșire scrie: ['Test object'], rând-nou.
>> a := Obiect nou. 

a la: ['item:'] execută: { :out
	propriu out := out. 
}.

a la: ['item'] execută: { <- propriu out.
}.

a la: ['greet'] execută: {
	Ieșire scrie: ['hi from original out!'], rând-nou.
}.

a item: Ieșire.

Ieșire scrie: a item, rând-nou.

>> old-out-address := a item prototip adresă-memorie.
a save-as: ['/tmp/a.bin'].
Ieșire scrie: ['========== RELOADING SNAP:'], rând-nou.

>> b := Obiect load-from: ['/tmp/a.bin'].

(b item prototip adresă-memorie = old-out-address) adevărat: {
	Ieșire scrie: ['Object link re-attached.'], rând-nou.
}.

b item scrie: ['hello from loaded out!'], rând-nou.
b greet.
