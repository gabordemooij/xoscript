# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob nou: 8, bytes: (
	Listă nou ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Ieșire scrie: ( utf16 decodifică: ['utf16le'] ), rând-nou.

utf16 eliberează.
>> utf32 := Blob nou: 13, bytes: (
	Listă nou ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Ieșire scrie: ( utf32 decodifică: ['utf32be'] ), rând-nou.
utf32 eliberează.