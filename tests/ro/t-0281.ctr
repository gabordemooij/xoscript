>> q := Listă ← 1 ; 2 ; 3.
{ q ? ['1']. } prinde: { Ieșire scrie: ['caught!'], rând-nou. }, pornește.
{ q ? Adevărat. } prinde: { Ieșire scrie: ['caught!'], rând-nou. }, pornește.
{ q ? Fals. } prinde: { Ieșire scrie: ['caught!'], rând-nou. }, pornește.
{ q ? Nimic. } prinde: { Ieșire scrie: ['caught!'], rând-nou. }, pornește.
{ q ? (Listă nou). } prinde: { Ieșire scrie: ['caught!'], rând-nou. }, pornește.
{ q ? (Obiect nou). } prinde: { Ieșire scrie: ['caught!'], rând-nou. }, pornește.
{ q ? ({ ['Empty']. }). } prinde: { Ieșire scrie: ['caught!'], rând-nou. }, pornește.
Ieșire scrie: ['caught them all'], rând-nou.
