Ieșire scrie: ['Obiect de test'], rând-nou.
>> a := Obiect nou. 

a la: ['state:'] execută: { :list
	propriu list := list. 
}.

a la: ['stare'] execută: {
	Ieșire scrie: propriu list, rând-nou.
}.

a state: ( Listă nou ; ['elementlistă'] ; ['element2'] ).
a stare.

a save-as: ['/tmp/a.bin'].
Ieșire scrie: ['========== REÎNCĂRCARE SNAP:'], rând-nou.
>> b := Obiect load-from: ['/tmp/a.bin'].
b stare.