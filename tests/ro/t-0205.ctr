>> str := ['write:'].
Ieșire mesaj: ['scrie:'] argumente: (Listă ← ['Hello World']), rând-nou. 

Număr la: ['isbetween:and:'] execută: { :a :b <- ((sine ≥ a) și: (sine ≤ b)).
}.

str := ['isbetween:and:'].
Ieșire scrie: (3 mesaj: str argumente: (Listă ← 2 ; 8)), rând-nou.
Ieșire scrie: (3 mesaj: str argumente: (Listă ← 1 ; 2)), rând-nou.


>> AparatDeCafea := Obiect nou.
AparatDeCafea la: ['makeCoffeeWithSugar:milk:'] execută: { :sugar :milk <- ( ['Poftim... cafea cu '] + 
			sugar +
			[' lingurițe de zahăr și '] +
			milk +
			[' picături de lapte.']
	).
}.

>> comanda := ['makeCoffeeWithSugar:milk:'].
>> configurațieCafea := Listă ← 4 ; 2.
Ieșire scrie: ( AparatDeCafea mesaj: comanda argumente: configurațieCafea ), rând-nou.
