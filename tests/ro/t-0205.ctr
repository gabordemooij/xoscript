>> str := ['write:'].
Ieșire mesaj: ['scrie:'] argumente: (Listă ← ['Hello World']), rând-nou. 

Număr la: ['isbetween:and:'] execută: { :a :b <- ((sine ≥ a) și: (sine ≤ b)).
}.

str := ['isbetween:and:'].
Ieșire scrie: (3 mesaj: str argumente: (Listă ← 2 ; 8)), rând-nou.
Ieșire scrie: (3 mesaj: str argumente: (Listă ← 1 ; 2)), rând-nou.


>> CoffeeMachine := Obiect nou.
CoffeeMachine la: ['makeCoffeeWithSugar:milk:'] execută: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Listă ← 4 ; 2.
Ieșire scrie: ( CoffeeMachine mesaj: order argumente: coffeeConfiguration ), rând-nou.
