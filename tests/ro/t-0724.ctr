Ieșire scrie: ['Test object'], rând-nou.
>> a := Obiect nou. 

a la: ['item:'] execută: { :file
	propriu file := file. 
}.

a la: ['item'] execută: { <- propriu file.
}.

>> f := Fișier nou: ['/tmp/aaa.txt'].
a item: f.
Ieșire scrie: a item, rând-nou.
a save-as: ['/tmp/a.bin'].
Ieșire scrie: ['========== RELOADING SNAP:'], rând-nou.
>> b := Obiect load-from: ['/tmp/a.bin'].
Ieșire scrie: b item, rând-nou.
