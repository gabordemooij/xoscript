Ieșire scrie: ['Test object'], rând-nou.
>> cmd := Comandă nou.
Ieșire scrie: cmd ls /tmp, rând-nou.
>> old-cmd-address := cmd prototip adresă-memorie.
cmd save-as: ['/tmp/a.bin'].
Ieșire scrie: ['========== RELOADING SNAP:'], rând-nou.
>> b := Obiect load-from: ['/tmp/a.bin'].
(b prototip adresă-memorie = old-cmd-address) adevărat: {
	Ieșire scrie: ['Object link re-attached.'], rând-nou.
}.
Ieșire scrie: b ls, rând-nou.


