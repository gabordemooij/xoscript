# test bază de date
# vezi exemplul server.xo pentru configurația necesară

Server init.
Ieșire scrie: ['Test bază de date'], rând-nou.

>> bd := Maria-DB nou gazdă: ['localhost'],
	utilizator: ['xo'], parolă: ['pass123'], nume-bază: ['xobase'], conectează.

Ieșire scrie: ['Ne putem conecta? '] + bd conectat?, rând-nou.

>> parametri-căutare := bd interogare: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], parametri: ( Listă nou ; ['abc'] ; 12.35 ; 6 ). # interogări parametrizate

{  parametri-căutare execută-interogare. bd confirmă. } prinde: { :e bd anulează.  }, pornește.

Ieșire scrie: ['Putem insera? '] + ( parametri-căutare insert-id > 0 ), rând-nou.

>> Obj := Obiect nou.
Obj la: ['obține-rânduri'] execută: {
	propriu numără := 0.
	>> parametri-căutare :=
	bd interogare: ['SELECT * FROM book order by id desc limit 2'], 
	preia: { :rând 
		propriu numără adaugă: 1.
		Adevărat întrerupe.
	}. # preluarea rândurilor
	<- propriu numără copiază.
}.

Ieșire scrie: ['Putem interoga? '] + ( Obj obține-rânduri > 0 ), rând-nou.
