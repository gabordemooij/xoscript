


>> Pachet := Listă nou.
Pachet la: ['tipărește'] execută: {
        >> len := sine numără - 1.
        { :i
                >> lung2 := sine numără - 1.
                Ieșire scrie: ['lung: '].
                Ieșire scrie: len, rând-nou.
                Ieșire scrie: ['lung2: '].
                Ieșire scrie: lung2, rând-nou.
        } × len.
}.

>> d := Pachet ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d tipărește.
