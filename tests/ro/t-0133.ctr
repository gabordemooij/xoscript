


>> Deck := Listă nou.
Deck la: ['print'] execută: {
        >> len := sine numără - 1.
        { :i
                >> len2 := sine numără - 1.
                Ieșire scrie: ['len: '].
                Ieșire scrie: len, rând-nou.
                Ieșire scrie: ['len2: '].
                Ieșire scrie: len2, rând-nou.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
