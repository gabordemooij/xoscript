Server init.

Ieșire scrie: (
	Șablon nou: ['^\\w+$'],
	potrivire: ['test@example.com'] 
), rând-nou. # 0 potriviri, eșuează la @ și .

Ieșire scrie: (
	Șablon nou: ['^[^@]+@[^\.]+\.\\w+$'],
	potrivire: ['test@example.com'] 
), rând-nou. # 1 potrivire

Ieșire scrie: (
	Șablon nou: ['[^@]+@[^\.]+\.\\w+'],
	potrivire: ['test@example.com'] 
), rând-nou. # 1 potrivire

Ieșire scrie: (
	Șablon nou: ['([^@]+)@([^\.]+)\.\\w+'],
	potrivire: ['test@example.com'] 
), rând-nou. # 1 potrivire, grupurile nu contează

Ieșire scrie: (
	Șablon nou: ['[a-z]'],
	potrivire: ['test@example.com'] 
), rând-nou. # 14 potriviri

Ieșire scrie: (
	Șablon nou: ['.*'],
	potrivire: ['test@example.com'] 
), rând-nou. # 1 potrivire (tot)

Ieșire scrie: (
	Șablon nou: ['(.*)'],
	potrivire: ['test@example.com'] 
), rând-nou. # 1 potrivire (tot)

Ieșire scrie: (
	Șablon nou: ['\\s*[^@]+@[^\.]+\.\\w+'],
	potrivire: ['test@example.com'] 
), rând-nou. # 1 potrivire, spațiul din față este opțional și este ignorat