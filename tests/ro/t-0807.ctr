# mesajele de eroare ale bazei de date nu trebuie tratate ca șiruri de format
Server init.

>> bd := Maria-DB nou gazdă: ['localhost'],
	utilizator: ['xo'],
	parolă: ['pass123'],
	nume-bază: ['xobase'],
	conectează.

>> parametri-căutare := bd interogare: ['SELECT %% FROM'].
{ parametri-căutare execută-interogare. } prinde: { :e
	Ieșire scrie: ( e conține: ['%%'] ), rând-nou.
}, pornește.
