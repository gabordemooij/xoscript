# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB nou gazdă: ['localhost'],
	utilizator: ['xo'],
	parolă: ['pass123'],
	nume-bază: ['xobase'],
	conectează.

>> parametri-căutare := db interogare: ['SELECT %% FROM'].
{ parametri-căutare execută-interogare. } prinde: { :e
	Ieșire scrie: ( e conține: ['%%'] ), rând-nou.
}, pornește.
