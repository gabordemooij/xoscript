#test ffi


Server init.

Program gestiune-memorie: 4.

# pentru acest test trebuie setată o cale către libc (puts)
>> numeBibliotecă := Program setare: ['FFITESTLIB'].



Server leagă: (
 Listă nou ;
 numeBibliotecă ;
 ['puts'] ;
 ( Listă nou ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s eliberează.

# test cu struct

>> a := Blob nou: 8.
a bytes: (
	Listă <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Listă <<: ['int'], ; ['int']).

Server leagă: (
	Listă <<: ['@structtest'], ;
	['@structtest'] ;
	(Listă <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Ieșire scrie: ['Test sumă:'] + (ffitest ffisum: a), rând-nou.

struct eliberează-struct.
struct eliberează.
a eliberează.
