>> echo := Obiect nou.
echo la: ['răspunde:'] execută: { :sound
	{ Ieșire scrie: sound. } × 2.
}.
echo ho!. 


echo := Obiect nou.
echo la: ['răspunde:și:'] execută: { :sound :x
	{ Ieșire scrie: sound. } × x.
}.
echo o 5. 
echo wooo: 3. 


echo := Obiect nou.
echo la: ['răspunde:și:și:'] execută: { :operation :sound :x
	{ Ieșire scrie: sound. } × x.
}.
echo shout: ['la'] times: 4. 


