
Text la: ['evaluează'] execută: {
	>> cod := Fișier nou: ['/tmp/eval.ctr'].
	cod scrie: (sine text + ['.']).
	Program folosește: ['/tmp/eval.ctr'].
}.

>> map :=
	(Dicționar nou)
	pune: ['Bună Ziua'] la: ['two'],
	pune: (Listă ← ['hello'] ; ['world'] ; (Listă ← 1 ; 2; 9) ; Fals) la: ['unu'],
	pune: ( (Dicționar nou) pune: ['lme'] la: ['scris-greșit'] ) la: ['three'],
	pune: (Listă ← ((Dicționar nou) pune: ['comoară'] la: ['ascuns']) ; 2) la: ['patru']. 
>> str := map text.
>> map2 := Nimic.
(['map2 := '] + str ) evaluează.
Ieșire scrie: map2 ? ['unu'] ? 0.
Ieșire scrie: map2 ? ['unu'] ? 1.
Ieșire scrie: map2 ? ['patru'] ? 0 ? ['ascuns'].
Ieșire scrie: map2 ? ['unu'] ? 2 ? 2.
