

>> memorieFolosită1 := 0.
>> memorieFolosită2 := 0.
>> memorieFolosită3 := 0.
>> memorieFolosită4 := 0.

>> x := 100.

Program gestiune-memorie: 0.

{
>> txt := ['salut '] + ['world'].
txt := txt + [' - putem folosi texte.. '].
txt := txt + ['fără să pierdem '] + x + ['-uri de octeți ?'].
txt adaugă-la-sfârșit: ['!!'].
Ieșire scrie: txt.
} pornește.

Program curăță.

memorieFolosită1 := (Program memorie ? 0).


{
>> txt := ['salut '] + ['world'].
txt := txt + [' - putem folosi texte.. '].
txt := txt + ['fără să pierdem '] + x + ['-uri de octeți ?'].
txt adaugă-la-sfârșit: ['!!'].
Ieșire scrie: txt.
} pornește.

Program curăță.
memorieFolosită2 := (Program memorie ? 0).


{
>> txt := ['salut '] + ['world'].
txt := txt + [' - putem folosi texte.. '].
txt := txt + ['fără să pierdem '] + x + ['-uri de octeți ?'].
txt adaugă-la-sfârșit: ['!!'].
