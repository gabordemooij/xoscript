Server init.

>> bd := Maria-DB nou gazdă: ['localhost'],
	utilizator: ['xo'],
	parolă: ['pass123'],
	nume-bază: ['xobase'],
	conectează.

>> ștergere := bd interogare: ['DELETE FROM book WHERE id > 0'].
{  ștergere execută-interogare. bd confirmă. } prinde: { :e bd anulează.  }, pornește.

>> numără := bd interogare: ['SELECT COUNT(*) AS num FROM book'].
numără preia: { :rând Ieșire scrie: rând num, rând-nou. }.
