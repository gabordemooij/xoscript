>> t := Nimic.

# you can control the time zone for
# parsing like this:
Moment zonă: ['CET'].
t := Moment din: ['1981-02-03 04:05:06'].
Ieșire scrie: t, rând-nou.

# now using CEST time zone:
Moment zonă: ['CEST'].
t := Moment din: ['1981-02-03 04:05:06'].
Ieșire scrie: t, rând-nou.

# error if string cannot be parsed
{ Moment din: ['1900']. } prinde: { Nimic. }, pornește.
