Ieșire scrie: ['Test object'], rând-nou.
>> a := Obiect nou. 
a la: ['item:'] execută: { :lst
	propriu lst := lst. 
}.
a la: ['item'] execută: { <- propriu lst.
}.
a item: (
	Listă nou ; 1 ; (
		Listă nou ; ['a'] ; (
			Listă nou ; ( Moment nou: 1 )
		) ; ( Int64 din-text: ['321'] )
	)
).
Ieșire scrie: a item, rând-nou.
>> old-lst-address := a item prototip adresă-memorie.
a save-as: ['/tmp/a.bin'].
Ieșire scrie: ['========== RELOADING SNAP:'], rând-nou.
>> b := Obiect load-from: ['/tmp/a.bin'].
(b item prototip adresă-memorie = old-lst-address) adevărat: {
	Ieșire scrie: ['Object link re-attached.'], rând-nou.
}.
Ieșire scrie: ( b item ), rând-nou.
