Ieșire scrie: ['1,2,3,4,5,6,7,8,9,A,'], rând-nou.
>> Domeniu := Obiect nou.
Domeniu la: ['initialize:'] execută: { :x propriu proprietate := x. }.
Domeniu la: ['aprobă'] execută: { Ieșire scrie: [',']. }.
Domeniu la: ['test'] execută: {
	Ieșire scrie: propriu proprietate.
	sine aprobă.
	( 1 = 1 ) adevărat: { Ieșire scrie: propriu proprietate. sine aprobă. }.
	( 1 = 0 ) fals: { Ieșire scrie: propriu proprietate. sine aprobă. }.
	>> y := 2. { Ieșire scrie: propriu proprietate. sine aprobă. } cât-timp: { y scade: 1. <- (y > 0). }.
	{ Ieșire scrie: propriu proprietate. sine aprobă. } × 1.
	(Listă ← 1) fiecare: {  Ieșire scrie: propriu proprietate. sine aprobă. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo de implementat sortare proprie, testul eșuează deoarece numărul de iterații diferă de la o platformă la alta
	(Dicționar nou one: ['item']) fiecare: { Ieșire scrie: propriu proprietate. sine aprobă. }.
	{ 1 ÷ 0. } prinde: { Ieșire scrie: propriu proprietate. sine aprobă. }, pornește.
	Ieșire rând-nou.
}.
>> domeniu1 := Domeniu nou.
domeniu1 initialize: ['X'].
domeniu1 test.
>> funcția := { 
	propriu proprietate := ['Y'].
	Ieșire scrie: propriu proprietate.
	sine aprobă.
	( 1 = 1 ) adevărat: { Ieșire scrie: propriu proprietate. sine aprobă. }.
	( 1 = 0 ) fals: { Ieșire scrie: propriu proprietate. sine aprobă. }.
	>> y := 2. { Ieșire scrie: propriu proprietate. sine aprobă. } cât-timp: { y scade: 1. <- (y > 0). }.
	{ Ieșire scrie: propriu proprietate. sine aprobă. } × 1.
	(Listă ← 1) fiecare: {  Ieșire scrie: propriu proprietate. sine aprobă. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Dicționar nou one: ['item']) fiecare: { Ieșire scrie: propriu proprietate. sine aprobă. }.
	{ 1 ÷ 0. } prinde: { Ieșire scrie: propriu proprietate. sine aprobă. }, pornește.
	Ieșire rând-nou.
}.
funcția la: ['aprobă'] execută: { Ieșire scrie: [',']. }.
funcția aplică: 1 și: 2.
