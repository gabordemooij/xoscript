Ieșire scrie: ['1,2,3,4,5,6,7,8,9,A,'], rând-nou.
>> Scope := Obiect nou.
Scope la: ['initialize:'] execută: { :x propriu property := x. }.
Scope la: ['confirm'] execută: { Ieșire scrie: [',']. }.
Scope la: ['test'] execută: {
	Ieșire scrie: propriu property.
	sine confirm.
	( 1 = 1 ) adevărat: { Ieșire scrie: propriu property. sine confirm. }.
	( 1 = 0 ) fals: { Ieșire scrie: propriu property. sine confirm. }.
	>> y := 2. { Ieșire scrie: propriu property. sine confirm. } cât-timp: { y scade: 1. <- (y > 0). }.
	{ Ieșire scrie: propriu property. sine confirm. } × 1.
	(Listă ← 1) fiecare: {  Ieșire scrie: propriu property. sine confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Dicționar nou one: ['item']) fiecare: { Ieșire scrie: propriu property. sine confirm. }.
	{ 1 ÷ 0. } prinde: { Ieșire scrie: propriu property. sine confirm. }, pornește.
	Ieșire rând-nou.
}.
>> scope1 := Scope nou.
scope1 initialize: ['X'].
scope1 test.
