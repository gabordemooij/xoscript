>> V := Obiect.
V la: ['text'] execută: {
	Ieșire scrie: ['cast'], rând-nou.
	<- ['abc'].
}.

Ieșire scrie: ( Program setare: ['abc'] ), rând-nou.

# parametrii nu ar trebui să fie colectați de gc
Program setare: ([''] + V nou) valoare: ([''] + V nou).

Ieșire scrie: ( Program setare: ['abc'] ), rând-nou.
