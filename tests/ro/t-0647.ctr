Server init.
Ieșire scrie: ['Test oră în baza de date'], rând-nou.

>> bd := Maria-DB nou gazdă: ['localhost'],
	utilizator: ['xo'], 
	parolă: ['pass123'],
	nume-bază: ['xobase'],
	conectează.

>> parametri-căutare :=
bd interogare: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
preia: { :rând
	Ieșire scrie: rând timetest, rând-nou.
}.
