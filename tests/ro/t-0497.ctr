Server init.

# scriem un fișier de test
>> f := Fișier nou: ['/tmp/test.gif'].
f scrie: ['GIF87a01234567810'].

# servim fișierul
Server transmite: ['test.gif'] prefix: ['/tmp/'].

Ieșire rând-nou.

Ieșire scrie: ['În afara containerului (securitate):'], rând-nou.
{ Server transmite: ['../passwd'] prefix: ['/tmp/']. }
prinde: { :e Ieșire scrie: e, rând-nou. },
pornește.

Ieșire scrie: ['Prefix nevalid:'], rând-nou.
{ Server transmite: ['test.gif'] prefix: ['z:\\']. }
prinde: { :e Ieșire scrie: e, rând-nou. },
pornește.

Ieșire scrie: ['Fișier inexistent:'], rând-nou.
{ Server transmite: ['xxx.xxx'] prefix: ['/tmp/']. }
prinde: { :e Ieșire scrie: e, rând-nou. },
pornește.
