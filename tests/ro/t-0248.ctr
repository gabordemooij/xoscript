

Text la: ['evaluează'] execută: {
	>> cod := Fișier nou: ['/tmp/eval.ctr'].
	cod scrie: sine text + ['.'].
	Program folosește: ['/tmp/eval.ctr'].
}.

>> a := (Listă ← (
	(Dicționar nou)
		pune: ['domeniu'] la: ['mywebsite.com'],
		pune: (Listă ←
			((Dicționar nou)
				pune: ['acasă'] la: ['title'],
				pune: ['<html></html>'] la: ['body'],
				pune: ['2017-01-01'] la: ['creat']
			) ;
			((Dicționar nou)
				pune: ['desprenoi(c)'] la: ['title'],
				pune: ['<credits>Author Inc.</credits>'] la: ['body']
			)
		) la: ['pagini']
	)
) text.

Ieșire scrie: a tip, rând-nou.
Ieșire scrie: a, rând-nou.

>> b := Nimic.
(['b := '] + a) evaluează.
Ieșire scrie: b ? 0 ? ['pagini'] ? 1 ? ['body'], rând-nou.

>> c := b ? 0.
>> d := c text.
Ieșire scrie: d tip, rând-nou.

>> e := Nimic.
(['e := '] + d) evaluează.
Ieșire scrie: e ? ['pagini'] ? 0, rând-nou.
