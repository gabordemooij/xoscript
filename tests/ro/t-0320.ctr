


>> CoffeeMachine := Obiect nou.
CoffeeMachine la: ['order:'] execută: { :id
	>> coffee := ['Americano'].
	( id = 1 ) adevărat: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) adevărat: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) adevărat: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Obiect nou.
SimpleCoffeeMachine la: ['order'] execută: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Ieșire scrie: redCup, rând-nou.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Ieșire scrie: greenCup, rând-nou.
>> yellowCup := CoffeeMachine order: 1.
Ieșire scrie: yellowCup, rând-nou.
>> blueCup := CoffeeMachine order: 0.
Ieșire scrie: blueCup, rând-nou.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Ieșire scrie: blackCup, rând-nou.
blackCup adaugă-la-sfârșit: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Ieșire scrie: orangeCup, rând-nou.
