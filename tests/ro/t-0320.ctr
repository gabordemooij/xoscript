


>> AparatDeCafea := Obiect nou.
AparatDeCafea la: ['order:'] execută: { :id
	>> coffee := ['Americano'].
	( id = 1 ) adevărat: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) adevărat: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) adevărat: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> AparatSimpluDeCafea := Obiect nou.
AparatSimpluDeCafea la: ['comanda'] execută: { <- ['Neagră']. }.
>> canaRoșie := AparatDeCafea order: 1.
Ieșire scrie: canaRoșie, rând-nou.
canaRoșie := ['Ceai']. 
>> canaVerde := AparatDeCafea order: 0.
Ieșire scrie: canaVerde, rând-nou.
>> canaGalbenă := AparatDeCafea order: 1.
Ieșire scrie: canaGalbenă, rând-nou.
>> canaAlbastră := AparatDeCafea order: 0.
Ieșire scrie: canaAlbastră, rând-nou.
>> canaDePlastic := AparatSimpluDeCafea comanda.
canaDePlastic := ['Limonadă']. 
>> canaNeagră := AparatSimpluDeCafea comanda.
Ieșire scrie: canaNeagră, rând-nou.
canaNeagră adaugă-la-sfârșit: [' nuuu.... bere. '].
>> canaPortocalie := AparatSimpluDeCafea comanda.
Ieșire scrie: canaPortocalie, rând-nou.
