

>> Matryoshka := Obiect nou.
Matryoshka la: ['double:'] execută: { :secret
	propriu secret := secret × 2.
}.
Matryoshka la: ['nou:'] execută: { :secret
	>> answer := Nimic.
	>> t := (secret > 255).
	Ieșire scrie: (secret + [' | '] + t), rând-nou.
	t adevărat: {
		answer := secret.
	}, altfel: {
		answer := Matryoshka recursiv nou: (sine double: secret).
	}. <- answer.
}.

>> x := Matryoshka nou: 2.
