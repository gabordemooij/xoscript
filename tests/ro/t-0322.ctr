

>> Matrioșka := Obiect nou.
Matrioșka la: ['double:'] execută: { :secret
	propriu secret := secret × 2.
}.
Matrioșka la: ['nou:'] execută: { :secret
	>> răspunsul := Nimic.
	>> t := (secret > 255).
	Ieșire scrie: (secret + [' | '] + t), rând-nou.
	t adevărat: {
		răspunsul := secret.
	}, altfel: {
		răspunsul := Matrioșka recursiv nou: (sine double: secret).
	}. <- răspunsul.
}.

>> x := Matrioșka nou: 2.
