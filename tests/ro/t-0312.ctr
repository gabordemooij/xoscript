>> Sorbitor := Obiect nou.
Sorbitor la: ['nou'] execută: {
	propriu str := [''].
}.
Sorbitor învață: ['nieuw'] înseamnă: ['nou'].
Sorbitor la: ['răspunde:'] execută: { :blah
		(propriu str ≠ ['']) adevărat: {
			propriu str adaugă-la-sfârșit: [' '].
		}.
		propriu str adaugă-la-sfârșit: blah.
}.
Sorbitor la: ['răspunde:și:'] execută: { :blah :blahah
		(propriu str ≠ ['']) adevărat: {
			propriu str adaugă-la-sfârșit: [' '].
		}.
		(blah lungime > 1) adevărat: {
			propriu str adaugă-la-sfârșit: (blah de-la: 0 lungime: (blah lungime - 1)).
		}, altfel: {
			propriu str adaugă-la-sfârșit: blah.
		}.
		propriu str adaugă-la-sfârșit: [' '].
		propriu str adaugă-la-sfârșit: blahah.
}.
Sorbitor la: ['obține'] execută: {
	>> tampon := propriu str.
	propriu str := ['']. <- tampon.
}.


>> parametri-căutare := Sorbitor nou
	select: ['*'],
	from
		utilizatori 
	where 
		user_id=: 1.

Ieșire scrie: parametri-căutare obține, rând-nou.
