Server init.

>> con1 := Maria-DB nou gazdă: ['localhost'],
	utilizator: ['xo'],
	parolă: ['pass123'],
	nume-bază: ['xobase'],
	conectează.

>> con2 := Maria-DB nou gazdă: ['localhost'],
	utilizator: ['xo'],
	parolă: ['pass123'],
	nume-bază: ['xobase'],
	conectează.
#...
>> ștergere := con1 interogare: ['DELETE FROM book WHERE id > 0'].
{  ștergere execută-interogare. con1 confirmă. } prinde: { :e con1 anulează.  }, pornește.

>> inserare := con1 interogare: ['INSERT INTO book (id) VALUES(null)'].
inserare execută-interogare.

>> numără := con1 interogare: ['SELECT COUNT(*) AS num FROM book'].
numără preia: { :rând Ieșire scrie: rând num, rând-nou. }.

# nu apare
# inserarea nu este confirmată pe conexiunea 1
>> numără := con2 interogare: ['SELECT COUNT(*) AS num FROM book'].
numără preia: { :rând Ieșire scrie: rând num, rând-nou. }.
