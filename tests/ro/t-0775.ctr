Ieșire scrie: ['Obiect de test'], rând-nou.
>> l := Listă nou ; 1 ; ( Listă nou ; (Moment nou: 1) ; (Int64 din-text: ['321']) ; (Listă nou ; 3)).
Ieșire scrie: l, rând-nou.
>> adresă-veche-lst := l prototip adresă-memorie.
l save-as: ['/tmp/a.bin'].
Ieșire scrie: ['========== REÎNCĂRCARE SNAP:'], rând-nou.
>> b := Obiect load-from: ['/tmp/a.bin'].
(b prototip adresă-memorie = adresă-veche-lst) adevărat: {
	Ieșire scrie: ['Legătura obiectului a fost reatașată.'], rând-nou.
}.
