# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Șablon nou: pattern.
	p potrivire: subject fă: { :m :g
		Ieșire scrie: g numără, scrie: [' '], scrie: (g unește: ['|']), rând-nou. <- m.
	}.
}.
show aplică: ['(a)|(b)'] și: ['b'].
show aplică: ['(a)|(b)'] și: ['a'].
show aplică: ['(x)?y'] și: ['y'].
show aplică: ['(x)?(y)(z)?'] și: ['xy'].
