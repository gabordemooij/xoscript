Server init.

>> BD := Maria-DB nou gazdă: ['localhost'],
	utilizator: ['xo'],
	parolă: ['pass123'],
	nume-bază: ['xobase'],
	conectează.
	
>> SQL := ['SELECT "hello" AS "world" '].

# o cale mai rapidă, obținem interogarea din BD:
>> interogare2 := BD interogare: SQL.

# acum nu mai trebuie să setați BD
interogare2 preia: { :rând
	Ieșire scrie: rând world, rând-nou.
}.
