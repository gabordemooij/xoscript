Server init.

>> DB := Maria-DB nou gazdă: ['localhost'],
	utilizator: ['xo'],
	parolă: ['pass123'],
	nume-bază: ['xobase'],
	conectează.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB interogare: SQL.

# now you don't have to set DB
query2 preia: { :row
	Ieșire scrie: row world, rând-nou.
}.
