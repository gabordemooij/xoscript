# compliance test

# use international numbers

Ieșire scrie: ['1000 -> '].
Ieșire scrie: 1000, rând-nou. #1000

Ieșire scrie: ['1.5 -> '].
Ieșire scrie: 1.5, rând-nou.  #1.5

Ieșire scrie: ['1001.5 -> '].
Ieșire scrie: 1.5 + 1000, rând-nou. #1001.5

# use 0-indexed arrays
>> x := Listă nou ; 1 ; 2 ; 3.
>> y := Listă nou ; ['a'] ; ['b'] ; ['c'].

Ieșire scrie: ['1 -> '].
Ieșire scrie: x ? 0, rând-nou. #1

Ieșire scrie: ['1 -> '].
Ieșire scrie: (x la: 0), rând-nou. #1

Ieșire scrie: ['1 -> '].
Ieșire scrie: x primul, rând-nou. #1

Ieșire scrie: ['3 -> '].
Ieșire scrie: x ultimul, rând-nou. #3

Ieșire scrie: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Ieșire scrie: (x după: y), rând-nou.

Ieșire scrie: ['1 -> '].
Ieșire scrie: (x de-la: 0 lungime: 1) primul, rând-nou. #1

Ieșire scrie: ['0 -> '].
Ieșire scrie: (x caută: 1), rând-nou. #0

x pune: 9 la: 0.

Ieșire scrie: ['9 -> '].
Ieșire scrie: (x la: 0), rând-nou. #9

x adaugă-la-început: 8.
Ieșire scrie: ['8 -> '].
Ieșire scrie: (x la: 0), rând-nou. #9


x adaugă-la-sfârșit: 10.
Ieșire scrie: ['10 -> '].
Ieșire scrie: (x la: 4), rând-nou. #10








