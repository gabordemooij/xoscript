# Test pentru curățarea utf8
Server init.

>> cazuriutf8 := Dicționar nou
	# doar ASCII
	pune: ( Listă nou ; 65 ; 65 ; 65 ; 65 ; 0 ) la: ['AAAA'],
	# secvență validă de 2 octeți
	pune: ( Listă nou ; 194 ; 162 ; 0 ) la: ['¢'],
	# UTF-8 valid de 3 octeți
    pune: ( Listă nou ; 226 ; 130 ; 172 ; 0 ) la: ['€'],
	# UTF-8 valid de 4 octeți
    pune: ( Listă nou ; 240 ; 144 ; 141 ; 136 ; 0 ) la: ['𐍈'],
	# Octet de continuare invalid în secvența E2 28 AC -> început secv. 3o + 28 cont. greșit + AC octet cont., dar aparține aceleiași erori
    pune: ( Listă nou ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) la: ['A?A'],
	# Codificare supralungă a lui ASCII 'A' (ar trebui să devină ?),
    pune: ( Listă nou ; 65 ; 193 ; 129 ; 0 ) la: ['A?'],
	# Primul octet invalid (0xFF)
    pune: ( Listă nou ; 255 ; 0 ) la: ['?'],
	# Secvență multi-octet incompletă la sfârșit
    pune: ( Listă nou ; 66 ; 226 ; 0 ) la: ['B?'],
    # Text gol
    #put: ( List new ) at: [''],
	# Mai multe secvențe amestecate
    pune: ( Listă nou ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) la: ['A€?𐍈B'].
	 
cazuriutf8 fiecare: { :key :value
	>> blob := Blob nou: value numără, bytes: value.
	>> str := blob text.
	(str = key) adevărat: {
		Ieșire scrie: ['OK'], rând-nou.
	}, altfel: {
		Ieșire scrie: ['Curățarea UTF8 a eșuat pe: '] + key + [' primit: '] + str, rând-nou.
	}.
	blob eliberează.
}.
