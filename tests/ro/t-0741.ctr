Ieșire scrie: ['Obiect de test'], rând-nou.
>> a := Obiect nou. 

a la: ['item:'] execută: { :ajutoroct
	propriu ajutoroct := ajutoroct. 
}.

a la: ['articol'] execută: {
	<- propriu ajutoroct.
}.

a item: Oct nou.

>> adresă-veche-ajutoroct := a articol prototip adresă-memorie.
a save-as: ['/tmp/a.bin'].
Ieșire scrie: ['========== REÎNCĂRCARE SNAP:'], rând-nou.

>> b := Obiect load-from: ['/tmp/a.bin'].

(b articol prototip adresă-memorie = adresă-veche-ajutoroct) adevărat: {
	Ieșire scrie: ['Legătura obiectului a fost reatașată.'], rând-nou.
}.
