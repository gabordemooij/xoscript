Ieșire scrie: ['Test object'], rând-nou.
>> a := Obiect nou. 

a la: ['item:'] execută: { :octhelper
	propriu octhelper := octhelper. 
}.

a la: ['item'] execută: { <- propriu octhelper.
}.

a item: Oct nou.

>> old-octhelper-address := a item prototip adresă-memorie.
a save-as: ['/tmp/a.bin'].
Ieșire scrie: ['========== RELOADING SNAP:'], rând-nou.

>> b := Obiect load-from: ['/tmp/a.bin'].

(b item prototip adresă-memorie = old-octhelper-address) adevărat: {
	Ieșire scrie: ['Object link re-attached.'], rând-nou.
}.
