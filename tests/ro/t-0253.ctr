#Linux
>> OS := Program setare: ['OS'].

>> clock := Moment nou.
	
(OS = ['Haiku']) adevărat: {
	clock zonă: ['CET'],
	an: 2017, lună: 7, zi: 13,
	oră: 18, minut: 0, secundă: 0.
}, altfel: {
	clock zonă: ['Europe/Amsterdam'],
	an: 2017, lună: 7, zi: 13,
	oră: 18, minut: 0, secundă: 0.
}.

clock la: ['tell'] execută: {
	Ieșire scrie: sine, rând-nou.
}.


clock adaugă: 2    oră, tell.
clock adaugă: 1    oră, tell.
clock adaugă: 19 minut, tell.
clock adaugă: 1  minut, tell.
clock adaugă: 1  minut, tell.
clock adaugă: 19 secundă, tell.
clock adaugă: 1  secundă, tell.
clock adaugă: 1  secundă, tell.
clock adaugă: 2    an, tell.
clock adaugă: 1    an, tell.

(OS = ['Haiku']) adevărat: {
clock adaugă: 5   lună.
clock zonă: ['CEST'], tell.
}, altfel: {
	clock adaugă: 5   lună, tell.
}.

clock adaugă: 1   lună, tell.
clock adaugă: 19    zi, tell.
clock adaugă: 1    oră, tell.
clock adaugă: 120  yard, tell.
