#Linux
>> OS := Program setare: ['OS'].

>> ceas := Moment nou.
	
(OS = ['Haiku']) adevărat: {
	ceas zonă: ['CET'],
	an: 2017, lună: 7, zi: 13,
	oră: 18, minut: 0, secundă: 0.
}, altfel: {
	ceas zonă: ['Europe/Amsterdam'],
	an: 2017, lună: 7, zi: 13,
	oră: 18, minut: 0, secundă: 0.
}.

ceas la: ['anunță'] execută: {
	Ieșire scrie: sine, rând-nou.
}.


ceas adaugă: 2    oră, anunță.
ceas adaugă: 1    oră, anunță.
ceas adaugă: 19 minut, anunță.
ceas adaugă: 1  minut, anunță.
ceas adaugă: 1  minut, anunță.
ceas adaugă: 19 secundă, anunță.
ceas adaugă: 1  secundă, anunță.
ceas adaugă: 1  secundă, anunță.
ceas adaugă: 2    an, anunță.
ceas adaugă: 1    an, anunță.

(OS = ['Haiku']) adevărat: {
ceas adaugă: 5   lună.
ceas zonă: ['CEST'], anunță.
}, altfel: {
	ceas adaugă: 5   lună, anunță.
}.

ceas adaugă: 1   lună, anunță.
ceas adaugă: 19    zi, anunță.
ceas adaugă: 1    oră, anunță.
ceas adaugă: 120  iarzi, anunță.
