>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Obiect nou.
⚄ la: ['drawFrom:length:'] execută: { :pool :numără
	
	>> result := [''].
	
	{
		>> index := Număr random % (pool lungime).
		result adaugă-la-sfârșit: ( pool caracter: (index + 1) ).
		
	} × numără. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? lungime.
Ieșire scrie: (['x↵'] x random lungime).
Ieșire scrie: (['y↵'] y ?? lungime).

