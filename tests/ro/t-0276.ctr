>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Obiect nou.
⚄ la: ['extrageDin:lungime:'] execută: { :urnă :numără
	
	>> rezultat := [''].
	
	{
		>> indice := Număr aleator % (urnă lungime).
		rezultat adaugă-la-sfârșit: ( urnă caracter: (indice + 1) ).
		
	} × numără. <- rezultat.
}.

>> aleator := ⚄ extrageDin: ?? lungime: ?? lungime.
Ieșire scrie: (['x↵'] x aleator lungime).
Ieșire scrie: (['y↵'] y ?? lungime).

