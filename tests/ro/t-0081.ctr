>> harta1 := Dicționar nou.
>> cheie1 := Listă nou.
>> cheie2 := Listă nou.

harta1
	pune: ['hello'] la: cheie1,
	pune: ['world'] la: cheie2.


Ieșire
	scrie: ['Map #1 contains: '] + (harta1 la: cheie1),
	scrie: [' și '] + (harta1 la: cheie2), rând-nou.

>> TablouCuChei := Listă nou.
TablouCuChei la: ['caText'] execută: { <- (sine numără) caText.
}.

>> map2 := Dicționar nou.
cheie1 := TablouCuChei nou.
cheie2 := TablouCuChei nou.

cheie1 adaugă-la-sfârșit: 1.

map2
	pune: ['hello'] la: cheie1,
	pune: ['world'] la: cheie2.

Ieșire
	scrie: ['Map #2 contains: '] + (map2 la: cheie1),
	scrie: [' și '] + (map2 la: cheie2), rând-nou.
