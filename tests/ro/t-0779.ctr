Ieșire scrie: ['Obiect de test'], rând-nou.
>> p := Cale /tmp.
Ieșire scrie: p, rând-nou.
>> adresă-veche-p := p prototip adresă-memorie.
p save-as: ['/tmp/a.bin'].
Ieșire scrie: ['========== REÎNCĂRCARE SNAP:'], rând-nou.
>> b := Obiect load-from: ['/tmp/a.bin'].
(b prototip adresă-memorie = adresă-veche-p) adevărat: {
	Ieșire scrie: ['Legătura obiectului a fost reatașată.'], rând-nou.
}.
Ieșire scrie: b, rând-nou.
