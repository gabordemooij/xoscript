Ieșire scrie: ['Test object'], rând-nou.
>> p := Cale /tmp.
Ieșire scrie: p, rând-nou.
>> old-p-address := p prototip adresă-memorie.
p save-as: ['/tmp/a.bin'].
Ieșire scrie: ['========== RELOADING SNAP:'], rând-nou.
>> b := Obiect load-from: ['/tmp/a.bin'].
(b prototip adresă-memorie = old-p-address) adevărat: {
	Ieșire scrie: ['Object link re-attached.'], rând-nou.
}.
Ieșire scrie: b, rând-nou.
