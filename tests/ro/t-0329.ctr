Ieșire scrie: ((Listă nou
	la: ['plaque:'] execută: { :x propriu o := x. },
	la: ['placă']  execută: { <- propriu o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Listă ← 1)
	~ (Listă ← 1 ; 2)
	~ (Listă ← 1 ; 2 ; 3)
	~ (Listă ← 1 ; 2 ; 3 ; 4)
	~ (Listă ← 1 ; 2 ; 3 ; 4 ; 5)
) fiecare: { :i :el
	{ Ieșire scrie: această-sarcină. } × el numără.
	Ieșire rând-nou.
}) placă, rând-nou.


