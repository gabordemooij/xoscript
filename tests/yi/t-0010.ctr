>> Animal := אָביעקט ניי.
Animal ווען: ⌝'make'⌜ טו: ⎬
	>> animal := אָביעקט ניי.
	animal ווען: ⌝'makeSound'⌜ טו: ⎬
		אויסגאָב שרײַב: אייגן sound.
	⎨. <- animal.
⎨.
>> Cat := אָביעקט ניי.
Cat ווען: ⌝'make'⌜ טו: ⎬
	>> cat := Animal make.
	cat ווען: ⌝'init'⌜ טו: ⎬
		אייגן sound := ⌝'meow!'⌜.
	⎨.
	cat init. <- cat.
⎨.
>> tom := Cat make.
tom makeSound.
