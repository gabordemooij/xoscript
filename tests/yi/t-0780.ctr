Server init.

# JSON encoder only supports UTF-8, no surrogate pairs

>> dicts := ליסטע ניי ;
	# {"key":"normal"} normal ASCII
	﴿ ווערטערבוך ניי לייג: ⌝'normal'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"hello world"} space character
	﴿ ווערטערבוך ניי לייג: ⌝'hello world'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"quote: \""} double quote
	﴿ ווערטערבוך ניי לייג: ⌝'"'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"backslash: \\"} backslash
	﴿ ווערטערבוך ניי לייג: ⌝'backslash: \\'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"slash: /"} slash
	﴿ ווערטערבוך ניי לייג: ⌝'slash: /'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"backspace: \b"} backspace
	﴿ ווערטערבוך ניי לייג: ⌝'backspace: \b'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"formfeed: \f"} form-feed escape
	﴿ ווערטערבוך ניי לייג: ⌝'formfeed: \f'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"newline: \n"} newline
	﴿ ווערטערבוך ניי לייג: ⌝'newline: \n'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	﴿ ווערטערבוך ניי לייג: ⌝'newline: ↵'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	﴿ ווערטערבוך ניי לייג: ⌝'newline: 
	'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"carriage return: \r"} carriage-return
	﴿ ווערטערבוך ניי לייג: ⌝'carriage return: \r'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"tab: \t"} tab
	﴿ ווערטערבוך ניי לייג: ⌝'tab \t'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	﴿ ווערטערבוך ניי לייג: ⌝'tab ⇿'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	﴿ ווערטערבוך ניי לייג: ⌝'tab  '⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u0000"} NUL
	﴿ ווערטערבוך ניי לייג: ⌝'NUL \u0000'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	﴿ ווערטערבוך ניי לייג: ⌝'NUL \0'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u0001"} control character 0x01
	﴿ ווערטערבוך ניי לייג: ⌝'control: \u0001'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"control: \u001F"} control character 0x1F
	﴿ ווערטערבוך ניי לייג: ⌝'control: \u001F'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: é"} UTF-8, 2-byte char
	﴿ ווערטערבוך ניי לייג: ⌝'unicode: é'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: €"} UTF-8, 3-byte char
	﴿ ווערטערבוך ניי לייג: ⌝'unicode: €'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 日本語"} multiple 3-byte UTF-8 chars
	﴿ ווערטערבוך ניי לייג: ⌝'unicode: 日本語'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 😀"} UTF-8, 4-byte char
	﴿ ווערטערבוך ניי לייג: ⌝'unicode: 😀'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	﴿ ווערטערבוך ניי לייג: ⌝'unicode: 🧑‍💻'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"combining: e\u0301"} combining accent
	﴿ ווערטערבוך ניי לייג: ⌝'combining: e\u0301'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: \u00e9"} Unicode escape BMP
	﴿ ווערטערבוך ניי לייג: ⌝'escaped unicode: \u00e9'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: \u20ac"} Unicode escape BMP
	﴿ ווערטערבוך ניי לייג: ⌝'escaped unicode: \u20ac'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"escaped unicode: \ud83d\ude00"} UTF-16 surrogate pair
	﴿ ווערטערבוך ניי לייג: ⌝'escaped unicode: \ud83d\ude00'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":""} empty value
	﴿ ווערטערבוך ניי לייג: ⌝''⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"@ < > & = % + ? #"} special ASCII chars
	﴿ ווערטערבוך ניי לייג: ⌝'@ < > & = % + ? #'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"single quote: '"} single quote
	﴿ ווערטערבוך ניי לייג: ⌝'''⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"multiple: \" \\ \n \r \t"} multiple JSON escapes
	﴿ ווערטערבוך ניי לייג: ⌝'multiple: \" \\ \n \r \t'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} longer ASCII-string
	﴿ ווערטערבוך ניי לייג: ⌝'aaaaaaaaaaaaaaaaaaaaaaaaaa'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":" value"} leading space
	﴿ ווערטערבוך ניי לייג: ⌝' value'⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":"value "} trailing space
	﴿ ווערטערבוך ניי לייג: ⌝'value '⌜ שליסל: ⌝'key'⌜ ﴾ ;
	# {"key":" \t\n\r "} whitespace
	﴿ ווערטערבוך ניי לייג: ⌝' \t\n\r '⌜ שליסל: ⌝'key'⌜ ﴾.

dicts יעדער: ⎬ :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: ﴿ווערטערבוך ניי לייג: d key שליסל: ⌝'key'⌜﴾.
	>> b := JSON jsonify: ﴿ווערטערבוך ניי לייג: ⌝'value'⌜ שליסל: d key﴾.
	>> e := JSON אָביעקט: a.
	>> f := JSON אָביעקט: b.
	﴿﴿e key = d key און: ﴿f ? d key = ⌝'value'⌜﴾﴾ אָדער: ﴿e key = ⌝'NUL ?'⌜﴾﴾ אויב-אמת: ⎬
		אויסגאָב שרײַב: ⌝'OK'⌜, נײַע-שורה.
	⎨, אַנדערש: ⎬
		אויסגאָב שרײַב: ⌝'Unable to properly encode/decode: '⌜ + d + j, נײַע-שורה.
		פּראָגראַם ענדיק.
	⎨.
⎨.
