# Test utf8 sanitizer
Server init.

>> utf8cases := ווערטערבוך ניי
	# ASCII only
	לייג: ﴿ ליסטע ניי ; 65 ; 65 ; 65 ; 65 ; 0 ﴾ שליסל: ⌝'AAAA'⌜,
	# valid 2 byte sequence
	לייג: ﴿ ליסטע ניי ; 194 ; 162 ; 0 ﴾ שליסל: ⌝'¢'⌜,
	# Valid 3-byte UTF-8
    לייג: ﴿ ליסטע ניי ; 226 ; 130 ; 172 ; 0 ﴾ שליסל: ⌝'€'⌜,
	# Valid 4-byte UTF-8
    לייג: ﴿ ליסטע ניי ; 240 ; 144 ; 141 ; 136 ; 0 ﴾ שליסל: ⌝'𐍈'⌜,
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    לייג: ﴿ ליסטע ניי ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ﴾ שליסל: ⌝'A?A'⌜,
	# Overlong encoding of ASCII 'A' (should become ?),
    לייג: ﴿ ליסטע ניי ; 65 ; 193 ; 129 ; 0 ﴾ שליסל: ⌝'A?'⌜,
	# Invalid first byte (0xFF)
    לייג: ﴿ ליסטע ניי ; 255 ; 0 ﴾ שליסל: ⌝'?'⌜,
	# Incomplete multi-byte sequence at end
    לייג: ﴿ ליסטע ניי ; 66 ; 226 ; 0 ﴾ שליסל: ⌝'B?'⌜,
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    לייג: ﴿ ליסטע ניי ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ﴾ שליסל: ⌝'A€?𐍈B'⌜.
	 
utf8cases יעדער: ⎬ :key :value
	>> blob := Blob ניי: value צאָל-עלעמענטן, בייטן: value.
	>> str := blob צו-טעקסט.
	﴿str = key﴾ אויב-אמת: ⎬
		אויסגאָב שרײַב: ⌝'OK'⌜, נײַע-שורה.
	⎨, אַנדערש: ⎬
		אויסגאָב שרײַב: ⌝'UTF8 sanitizer failed on: '⌜ + key + ⌝' got: '⌜ + str, נײַע-שורה.
	⎨.
	blob באַפֿרײַ.
⎨.
