# happy flow
>> s := ⌝'hello;"""world"""\n"of";"c\ns\nv"'⌜.
>> טעקע-וועג := ⌝'/tmp/dat.csv'⌜.
>> csv := טעקע ניי: טעקע-וועג.
csv שרײַב: s.

# accepts CRLF LF CR, varying row length
csv אָפּטיילער: ⌝';'⌜ גענדזנפֿיסל: ⌝'"'⌜ שורות: ⎬ :line
	פּראָגראַם רוים-אויף.
	אויסגאָב שרײַב: line, נײַע-שורה.
	פּראָגראַם רוים-אויף.
⎨.

# unequal lines
s לייג-צו-סוף: ⌝'\njustone'⌜.
csv שרײַב: s.
⎬
	csv אָפּטיילער: ⌝';'⌜ גענדזנפֿיסל: ⌝'"'⌜ שורות: ⎬ :line
		אויסגאָב שרײַב: line, נײַע-שורה.
	⎨.
⎨ כאַפּ: ⎬ :e 
	אויסגאָב שרײַב: e, נײַע-שורה.
⎨, לאָז-לויפֿן.

# invalid format
s := ⌝'"he"llo";world'⌜.
csv שרײַב: s.
⎬
	csv אָפּטיילער: ⌝';'⌜ גענדזנפֿיסל: ⌝'"'⌜ שורות: ⎬ :line
		אויסגאָב שרײַב: line, נײַע-שורה.
	⎨.
⎨ כאַפּ: ⎬ :e 
	אויסגאָב שרײַב: e, נײַע-שורה.
⎨, לאָז-לויפֿן.
