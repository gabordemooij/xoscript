# Password hashing
Server init.

# User sets a password
>> passw := ⌝'pass123'⌜.

# You store it like this
>> hash := סייף 
	פּאַראָל-העש: passw.

# Then, user logs in
# Attempt 1
>> a1 := ⌝'abcd123'⌜.
# Attempt 2
>> a2 := ⌝'pass123'⌜.

# Verify
>> a := סייף 
	פּאַראָל-העש: hash באַשטעטיק: a1.
	# fail 
>> b := סייף
	פּאַראָל-העש: hash באַשטעטיק: a2.
	# ok!

אויסגאָב שרײַב: a, נײַע-שורה.
אויסגאָב שרײַב: b, נײַע-שורה.

