# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := סייף שאַף-שליסלען.

# private (secret) key
>> sk := keys ערשטער.

# public key
>> pk := keys לעצטער.

# sign a message
>> sig := סייף חתמע: ⌝'abc'⌜ מיט: sk.

# check message (ok)
אויסגאָב שרײַב: ﴿ 
	סייף
		קאָנטראָליר: ⌝'abc'⌜ 
		חתימה: sig 
		מיט: pk 
﴾, נײַע-שורה.

# check message (fail)
אויסגאָב שרײַב: ﴿ 
	סייף 
		קאָנטראָליר: ⌝'abd'⌜ 
		חתימה: sig 
		מיט: pk 
﴾, נײַע-שורה.