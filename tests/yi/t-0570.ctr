#Linux

 >> t := מאָמענט ניי.
 
t צײַט-זאָנע: ⌝'Europe/Amsterdam'⌜.
t יאָר: 2020, חודש: 8, טאָג: 2, שעה: 21, מינוט: 2, סעקונדע: 1.

>> a := t שעה.
>> ams := t צײַט-זאָנע.

t צײַט-זאָנע: ⌝'US/Hawaii'⌜.
>> b := t שעה.
>> hw := t צײַט-זאָנע.

אויסגאָב
שרײַב: ﴿
	⌝'It's diff in zone2 than in zone1'⌜
	zone1: ams,
	zone2: hw,
	diff: ﴿
		﴿b > a﴾
		דאָס: ⌝'later'⌜ אָדער-יענץ: ⌝'earlier'⌜
	﴾
﴾,
נײַע-שורה.
 