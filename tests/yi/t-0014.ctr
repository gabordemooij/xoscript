>> Greeter := אָביעקט ניי.
Greeter ווען: ⌝'make'⌜ טו: ⎬
	>> gr := אָביעקט ניי.
	gr ווען: ⌝'setName:'⌜ טו: ⎬ :aname
		אייגן נאָמען := aname.
	⎨.
	gr ווען: ⌝'greet'⌜ טו: ⎬
		אויסגאָב שרײַב: אייגן נאָמען.
	⎨. <- gr.
⎨.
>> a := Greeter make.
>> b := Greeter make.
a setName: ⌝'ONE'⌜.
b setName: ⌝'TWO'⌜.
a greet.
b greet.
>> c := a ניי.
c setName: ⌝'THREE'⌜.
c greet.
>> d := a ניי.
d setName: ⌝'FOUR'⌜.
d greet.
c greet.
