

>> g := Server ניי.
>> v := סייף ניי.
>> ok := 0.

>> secrets := ליסטע ניי ; 
	 ⌝'aaa'⌜ ;
	 ⌝''⌜ ; 
	 ⌝'AB'⌜ ;
	 ⌝'abcdefghijklmnopqrstuvwxyz0123456789'⌜ ; 
	 ⌝'!@--+467hdHJKJs__=3hjsakd'⌜ ;
	 ⌝'spaces and	tabs'⌜ ;
	 ⌝'漢字'⌜ ;
	 ⌝'==[abc]=='⌜.
	
>> passwords := secrets קאָפּיר.
passwords יעדער: ⎬ :i :p
	secrets יעדער: ⎬ :n :s
		⎬
			>> encrypted := v פֿאַרשליסל: s שליסל: p.
			>> decrypted := v אַנטשליסל: encrypted שליסל: p.
			﴿decrypted = s﴾ אויב-אמת: ⎬
				ok רעכן-צו: 1.
			⎨, אַנדערש: ⎬
				אויסגאָב שרײַב: ⌝'failed encrypting/decrypting: '⌜, נײַע-שורה.
				אויסגאָב שרײַב: s, נײַע-שורה.
				אויסגאָב שרײַב: ⌝'encrypted: '⌜ + encrypted, נײַע-שורה.
				אויסגאָב שרײַב: ⌝'decrypted: '⌜ + encrypted, נײַע-שורה.
				פּראָגראַם ענדיק.
			⎨.
		⎨ כאַפּ: ⎬ :err
			﴿s = ⌝''⌜ אָדער: p = ⌝''⌜﴾ אויב-אמת: ⎬
				ok רעכן-צו: 1.
			⎨, אַנדערש: ⎬
				אויסגאָב שרײַב: err, נײַע-שורה.
				פּראָגראַם ענדיק.
			⎨.
		⎨, לאָז-לויפֿן.
	⎨.
⎨.

אויסגאָב שרײַב: ﴿ ok + ⌝' vault encryptions tested.'⌜ ﴾, נײַע-שורה.