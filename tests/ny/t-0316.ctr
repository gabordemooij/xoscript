>> Grandfather := Chinthu chatsopano.
Grandfather chikafika: ['greet'] chitani: {
	Zotuluka lembani: ['Ave!'], mzere-watsopano.
}.
>> Father := Grandfather chatsopano.
Father chikafika: ['greet'] chitani: {
	Zotuluka lembani: ['Hello'], mzere-watsopano.
	wekha greet.
}.
>> Son := Father chatsopano.
Son chikafika: ['greet'] chitani: {
	Zotuluka lembani: ['Hi'], mzere-watsopano.
	wekha greet.
}.

Son greet.

>> Roundabout := Chinthu chatsopano.
Roundabout chikafika: ['circle:'] chitani: { :x
	Zotuluka lembani: x, mzere-watsopano.
	(x < 3) zoona: { wekha kudziyitana circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) zoona: { Zotuluka lembani: x, mzere-watsopano. x onjezani: 1.  increment yamba. }. }.
increment yamba.