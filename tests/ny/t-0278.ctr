>> To-Do := Chinthu chatsopano.

To-Do chikafika: ['chatsopano'] chitani: {
	zake list := Mndandanda chatsopano.
}.

To-Do chikafika: ['nieuw'] chitani: {
	zake list := Mndandanda chatsopano.
}.

To-Do chikafika: ['+'] chitani: { :task
	zake list onjeza-kumapeto: task.
}.

To-Do chikafika: ['number of tasks?'] chitani: { <-  zake list chiwerengero-cha-zinthu.
}.

>> todos := 
	To-Do chatsopano 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Zotuluka lembani: ['You have $ tasks to do'] $ todos number of tasks?.
