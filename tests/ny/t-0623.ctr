

>> g := Server chatsopano.
>> v := Nkhokwe-yotetezedwa chatsopano.
>> ok := 0.

>> secrets := Mndandanda chatsopano ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> passwords := secrets koperani.
passwords chilichonse: { :i :p
	secrets chilichonse: { :n :s
		{
			>> encrypted := v bisa: s kiyi: p.
			>> decrypted := v vumbulutsa: encrypted kiyi: p.
			(decrypted = s) zoona: {
				ok onjezani: 1.
			}, ngati-ayi: {
				Zotuluka lembani: ['failed encrypting/decrypting: '], mzere-watsopano.
				Zotuluka lembani: s, mzere-watsopano.
				Zotuluka lembani: ['encrypted: '] + encrypted, mzere-watsopano.
				Zotuluka lembani: ['decrypted: '] + encrypted, mzere-watsopano.
				Pulogalamu tsiriza.
			}.
		} gwira: { :err
			(s = [''] kapena: p = ['']) zoona: {
				ok onjezani: 1.
			}, ngati-ayi: {
				Zotuluka lembani: err, mzere-watsopano.
				Pulogalamu tsiriza.
			}.
		}, yamba.
	}.
}.

Zotuluka lembani: ( ok + [' vault encryptions tested.'] ), mzere-watsopano.