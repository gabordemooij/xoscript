>> t := Zoona.
(t = Zoona) zoona: { Zotuluka lembani: ['T']. }.
(t = Zabodza) zoona: { Zotuluka lembani: ['F']. }.
Zotuluka lembani: ['|'].
>> t := Zabodza.
(t = Zoona) zoona: { Zotuluka lembani: ['T']. }.
(t = Zabodza) zoona: { Zotuluka lembani: ['F']. }.
Zotuluka lembani: ['|'].
>> f := Zoona.
(t = Zoona ndi: f = Zabodza) zoona: { Zotuluka lembani: ['T']. }.
(t = Zabodza ndi: f = Zoona) zoona: { Zotuluka lembani: ['F']. }.
Zotuluka lembani: ['|'].
>> n := Palibe.
(n Palibe?) zoona: { Zotuluka lembani: ['T']. }.
(n Palibe?) zabodza: { Zotuluka lembani: ['F']. }.
Zotuluka lembani: ['|'].
(f Boolean?) zoona: { Zotuluka lembani: ['T']. }.
(f Boolean?) zabodza: { Zotuluka lembani: ['F']. }.



