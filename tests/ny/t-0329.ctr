Zotuluka lembani: ((Mndandanda chatsopano
	chikafika: ['plaque:'] chitani: { :x zake o := x. },
	chikafika: ['plaque']  chitani: { <- zake o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Mndandanda ← 1)
	~ (Mndandanda ← 1 ; 2)
	~ (Mndandanda ← 1 ; 2 ; 3)
	~ (Mndandanda ← 1 ; 2 ; 3 ; 4)
	~ (Mndandanda ← 1 ; 2 ; 3 ; 4 ; 5)
) chilichonse: { :i :el
	{ Zotuluka lembani: ntchito-iyi. } × el chiwerengero-cha-zinthu.
	Zotuluka mzere-watsopano.
}) plaque, mzere-watsopano.


