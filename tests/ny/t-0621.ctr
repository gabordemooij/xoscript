>> phrases := Mndandanda chatsopano
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases chilichonse: { :_ :phrase 
	>> e := Server base64-ika-khodi: phrase.
	>> d := Server base64-chotsa-khodi: e.
	Zotuluka lembani: (
		message koperani ~encoded: e, ~decoded: d
	), mzere-watsopano.
}.
