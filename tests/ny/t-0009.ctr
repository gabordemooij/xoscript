>> Greeter := Chinthu chatsopano.
Greeter chikafika: ['make'] chitani: {
	>> greeter := Chinthu chatsopano.
	greeter chikafika: ['name:'] chitani: { :dzina
		Zotuluka lembani: ['setting a name'].
		zake myName := dzina.
	}.
	greeter chikafika: ['performGreeting'] chitani: {
		Zotuluka lembani: ['Hello'].
		Zotuluka lembani: zake myName.
	}.
	greeter chikafika: ['greet'] chitani: {
		wekha performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
