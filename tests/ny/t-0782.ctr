Zotuluka lembani: ['Test object'], mzere-watsopano.
>> cmd := Lamulo chatsopano.
Zotuluka lembani: cmd ls /tmp, mzere-watsopano.
>> old-cmd-address := cmd chitsanzo-choyamba adilesi-ya-kukumbukira.
cmd save-as: ['/tmp/a.bin'].
Zotuluka lembani: ['========== RELOADING SNAP:'], mzere-watsopano.
>> b := Chinthu load-from: ['/tmp/a.bin'].
(b chitsanzo-choyamba adilesi-ya-kukumbukira = old-cmd-address) zoona: {
	Zotuluka lembani: ['Object link re-attached.'], mzere-watsopano.
}.
Zotuluka lembani: b ls, mzere-watsopano.


