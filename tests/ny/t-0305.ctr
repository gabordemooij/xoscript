
Nambala phunzira: ['plus:'] tanthauzo: ['+'].
Nambala chikafika: ['+'] chitani: { :x
	>> rate := 1.
	>> currency := x muyeso-wa-nambala.
	(currency = ['euros']) zoona: {
		rate := 2.
	}. <- (wekha plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars muyeso: ['dollars'].
euros muyeso: ['euros'].
>> money := dollars + euros.
Zotuluka lembani: money, mzere-watsopano.
