Server init.

>> db := Maria-DB chatsopano wolandira: ['localhost'],
	dzina-la-wogwiritsa: ['xo'],
	mawu-achinsinsi: ['pass123'],
	dzina-la-nkhokwe-ya-deta: ['xobase'],
	lumikizana.

>> del := db funso: ['DELETE FROM book WHERE id > 0'].
{  del chita-lamulo. db tsimikizira. } gwira: { :e db bwezera-mmbuyo.  }, yamba.

>> chiwerengero-cha-zinthu := db funso: ['SELECT COUNT(*) AS num FROM book'].
chiwerengero-cha-zinthu tenga: { :row Zotuluka lembani: row num, mzere-watsopano. }.
