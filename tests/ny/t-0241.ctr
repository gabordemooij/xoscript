

Malemba chikafika: ['evaluate'] chitani: {
	>> khodi := Fayilo chatsopano: ['/tmp/eval.ctr'].
	khodi lembani: (wekha malemba-a-mawu + ['.']).
	Pulogalamu gwiritsa-chida: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Mndandanda ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q malemba-a-mawu.
Zotuluka lembani: x, mzere-watsopano.
>> y := Palibe.
(['y := '] + x ) evaluate.
Zotuluka lembani: y ? 0, mzere-watsopano.

q := Mtanthauziramawu ikani: ['\[''] pa: ['\['quote\']'].
x := q malemba-a-mawu.
Zotuluka lembani: x, mzere-watsopano.
y := Palibe.
(['y := '] + x ) evaluate.

>> q := (Mtanthauziramawu chatsopano) ikani:['\[''] pa:['\['quote\[''].
Zotuluka lembani: y ? ['\['quote\']'], mzere-watsopano.
