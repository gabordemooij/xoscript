>> a := 3.
>> b := a koperani.
a chotsa: 1.
Zotuluka lembani: [' a = '] + a.
Zotuluka lembani: [' b = '] + b.
a := 3.
b := a + 4.
Zotuluka lembani: [' a = '] + a.
Zotuluka lembani: [' b = '] + b.
>> x := 3.
>> y := x koperani.
x onjezani: 10.
y chotsa: 1.
Zotuluka lembani: [' x = '] + x.
Zotuluka lembani: [' y = '] + y.
>> q := Chinthu chatsopano.
q chikafika: ['setProperty:'] chitani: { :x
	zake prop := x.
}.
q chikafika: ['getProperty'] chitani: { <- zake prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Zotuluka lembani: [' p = '] + (p getProperty).
