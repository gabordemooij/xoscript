
>> a := Mndandanda ← (Mndandanda ← 100 ; 200 ; 300) ; (Mndandanda ← 9 ; 8 ; 7).
Zotuluka lembani: ['at 0,1 :'].
Zotuluka lembani: a ? 0 ? 1, mzere-watsopano. 
Zotuluka lembani: ['at 1,2 :'].
Zotuluka lembani: a ? 1 ? 2, mzere-watsopano. 
>> menu := Mtanthauziramawu chatsopano.
menu ikani: (Mndandanda ← ['pizza'] ; ['spaghetti']) pa: ['Italian Cuisine'].
menu ikani: (Mndandanda ← ['bifteki'] ; ['suflaki']) pa: ['Greek Cuisine'].
Zotuluka lembani: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), mzere-watsopano. 
Zotuluka lembani: ['but not on the same plate.'], mzere-watsopano.
