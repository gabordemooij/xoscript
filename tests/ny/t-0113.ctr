Zotuluka lembani: ['Continue for-loop, No - before 6 and up.'], mzere-watsopano.
{ :i
	Zotuluka lembani: (i + 1), mzere-watsopano.
	((i + 1) > 4) pitilizani.
	Zotuluka lembani: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Zotuluka mzere-watsopano.
Zotuluka lembani: ['Continue while-true, No --> before 5 and up.'], mzere-watsopano.
{
	Zotuluka lembani: ['iteration #'] + x, mzere-watsopano.
	x onjezani: 1.
	((x < 5) ayi) pitilizani.
	Zotuluka lembani: ['-->'].
} bola-ngati: xIsLessThan10.
Zotuluka mzere-watsopano.
Zotuluka lembani: ['Continue while-false, No - before 3 only.'], mzere-watsopano.
{
	Zotuluka lembani: ['iteration #'] + x, mzere-watsopano.
	x chotsa: 1.
	(x = 3) pitilizani.
	Zotuluka lembani: ['-'].
} bola-ngati: { <- ( x > 0). }.

Zotuluka mzere-watsopano.
Zotuluka lembani: ['Continue times-loop, No ||| before 3.'], mzere-watsopano.
{ :i
	Zotuluka lembani: ['iteration #'] + i, mzere-watsopano.
	(i = 2) pitilizani.
	Zotuluka lembani: ['|||'].
} × 5.

Zotuluka mzere-watsopano.

{ Zoona pitilizani. Zotuluka lembani: ['dont write this!'], mzere-watsopano. } yamba.

{ Zoona pitilizani. Zotuluka lembani: ['dont write this!'], mzere-watsopano. } gwira: { Zotuluka lembani: ['Dont catch this!']. }, yamba.

Zotuluka lembani: ['Test Array each-loop: 0, ... ,2'], mzere-watsopano.
(Mndandanda ← 1 ; 2 ; 3) sintha-chilichonse: { :i
	(i = 1) pitilizani.
	Zotuluka lembani: ['iteration #'] + (i - 0), mzere-watsopano.
}.

Zotuluka lembani: ['Test Map each-loop: c only'], mzere-watsopano.
>> m := Mtanthauziramawu chatsopano.
m ikani: ['first'] pa: ['a'], ikani: ['second'] pa: ['b'], ikani: ['third'] pa: ['c'].
m chilichonse: { :k :v
	(k ≠ ['c']) pitilizani.
	Zotuluka lembani: ['iteration'] + k + v, mzere-watsopano.
}.

