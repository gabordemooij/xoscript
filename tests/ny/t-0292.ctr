>> winery := { <- (	Mtanthauziramawu chatsopano
		ikani: 2 pa: ['merlot'],
		ikani: 3 pa: ['malbec'],
		ikani: 4 pa: ['syrah']
	).
}.

Zotuluka lembani: (((winery yamba) - ['nothing']) chiwerengero-cha-zinthu), mzere-watsopano.
Zotuluka lembani: (((winery yamba) - ['merlot']) chiwerengero-cha-zinthu), mzere-watsopano.
Zotuluka lembani: (((winery yamba) - ['malbec']) chiwerengero-cha-zinthu), mzere-watsopano.
Zotuluka lembani: (((winery yamba) - ['syrah']) chiwerengero-cha-zinthu), mzere-watsopano.
Zotuluka lembani: (((winery yamba) - ['merlot'] - ['malbec']) chiwerengero-cha-zinthu), mzere-watsopano.
Zotuluka lembani: (((winery yamba) - ['merlot'] - ['syrah']) chiwerengero-cha-zinthu), mzere-watsopano.
Zotuluka lembani: (((winery yamba) - ['malbec'] -['syrah']) chiwerengero-cha-zinthu), mzere-watsopano.
Zotuluka lembani: (((winery yamba) - ['malbec'] - ['syrah'] - ['merlot']) chiwerengero-cha-zinthu), mzere-watsopano.

