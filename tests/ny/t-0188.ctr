

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Pulogalamu kasamalidwe-ka-kukumbukira: 0.

{ :i Zotuluka lembani: i. } × 4.
Zotuluka mzere-watsopano.
{ :i Zotuluka lembani: (4 - i). } × 4.
Zotuluka mzere-watsopano.
( 1 > 2 ) zabodza: { Zotuluka lembani: ['BLOCK 1'], mzere-watsopano. }.
( 2 > 1 ) zoona:  { Zotuluka lembani: ['BLOCK 2'], mzere-watsopano. }.

>> i := 0.
{ Zotuluka lembani: i. i onjezani: 1. } bola-ngati: { <- ( i < 3). }.
Zotuluka mzere-watsopano.

i := 3.
{ Zotuluka lembani: i. i := i - 1. } bola-ngati: { <- ( i > 0). }.
Zotuluka mzere-watsopano.


Pulogalamu yeretsa.

usedMemory1 := (Pulogalamu kukumbukira ? 0).


{ :i  Zotuluka lembani: i. } × 4.
Zotuluka mzere-watsopano.
{ :i  Zotuluka lembani: (4 - i). } × 4.
Zotuluka mzere-watsopano.
( 1 > 2 ) zabodza: { Zotuluka lembani: ['BLOCK 1'], mzere-watsopano. }.
( 2 > 1 ) zoona:  { Zotuluka lembani: ['BLOCK 2'], mzere-watsopano. }.

>> i := 0.
{ Zotuluka lembani: i. i onjezani: 1. } bola-ngati: { <- ( i < 3). }.
Zotuluka mzere-watsopano.

i := 3.
{ Zotuluka lembani: i. i := i - 1. } bola-ngati: { <- ( i > 0). }.
Zotuluka mzere-watsopano.



Pulogalamu yeretsa.
usedMemory2 := (Pulogalamu kukumbukira ? 0).


{ :i Zotuluka lembani: i. } × 4.
Zotuluka mzere-watsopano.
{ :i Zotuluka lembani: (4 - i). } × 4.
Zotuluka mzere-watsopano.
( 1 > 2 ) zabodza: { Zotuluka lembani: ['BLOCK 1'], mzere-watsopano. }.
( 2 > 1 ) zoona:  { Zotuluka lembani: ['BLOCK 2'], mzere-watsopano. }.

>> i := 0.
{ Zotuluka lembani: i. i onjezani: 1. } bola-ngati: { <- ( i < 3). }.
Zotuluka mzere-watsopano.

i := 3.
{ Zotuluka lembani: i. i := i - 1. } bola-ngati: { <- ( i > 0). }.
Zotuluka mzere-watsopano.

Pulogalamu yeretsa.
usedMemory3 := (Pulogalamu kukumbukira ? 0).



( usedMemory1 = usedMemory2 ndi: usedMemory1 = usedMemory3, ndi: usedMemory2 = usedMemory3 ) zoona: {
	Zotuluka lembani: ['No memory leaks here'].
}, zabodza: {
	Zotuluka lembani: ['Leaking memory...'].
}.
