


>> CoffeeMachine := Chinthu chatsopano.
CoffeeMachine chikafika: ['order:'] chitani: { :id
	>> coffee := ['Americano'].
	( id = 1 ) zoona: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) zoona: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) zoona: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Chinthu chatsopano.
SimpleCoffeeMachine chikafika: ['order'] chitani: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Zotuluka lembani: redCup, mzere-watsopano.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Zotuluka lembani: greenCup, mzere-watsopano.
>> yellowCup := CoffeeMachine order: 1.
Zotuluka lembani: yellowCup, mzere-watsopano.
>> blueCup := CoffeeMachine order: 0.
Zotuluka lembani: blueCup, mzere-watsopano.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Zotuluka lembani: blackCup, mzere-watsopano.
blackCup onjeza-kumapeto: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Zotuluka lembani: orangeCup, mzere-watsopano.
