# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB chatsopano wolandira: ['localhost'],
	dzina-la-wogwiritsa: ['xo'],
	mawu-achinsinsi: ['pass123'],
	dzina-la-nkhokwe-ya-deta: ['xobase'],
	lumikizana.

>> zofufuzira := db funso: ['SELECT %% FROM'].
{ zofufuzira chita-lamulo. } gwira: { :e
	Zotuluka lembani: ( e muli: ['%%'] ), mzere-watsopano.
}, yamba.
