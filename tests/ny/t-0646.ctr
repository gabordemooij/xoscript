Server init.
Zotuluka lembani: ['Database datetime test'], mzere-watsopano.

>> db := Maria-DB chatsopano wolandira: ['localhost'],
	dzina-la-wogwiritsa: ['xo'], 
	mawu-achinsinsi: ['pass123'],
	dzina-la-nkhokwe-ya-deta: ['xobase'],
	lumikizana.

>> zofufuzira :=
db funso: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
tenga: { :row
	Zotuluka lembani: row datetimetest, mzere-watsopano.
}.
