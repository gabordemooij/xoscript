

>> Matryoshka := Chinthu chatsopano.
Matryoshka chikafika: ['double:'] chitani: { :secret
	zake secret := secret × 2.
}.
Matryoshka chikafika: ['chatsopano:'] chitani: { :secret
	>> answer := Palibe.
	>> t := (secret > 255).
	Zotuluka lembani: (secret + [' | '] + t), mzere-watsopano.
	t zoona: {
		answer := secret.
	}, ngati-ayi: {
		answer := Matryoshka kudziyitana chatsopano: (wekha double: secret).
	}. <- answer.
}.

>> x := Matryoshka chatsopano: 2.
