Malemba chikafika: ['evaluate'] chitani: {
	>> khodi := Fayilo chatsopano: ['/tmp/eval.ctr'].
	khodi lembani: (wekha malemba-a-mawu + ['.']).
	Pulogalamu gwiritsa-chida: ['/tmp/eval.ctr'].
}.

>> a := Mndandanda ← 1 ; 2 ; 3.
>> b := (a malemba-a-mawu).

Zotuluka lembani: b, mzere-watsopano. 
(['b := '] + b) evaluate.

Zotuluka lembani: b ? 2, mzere-watsopano. 

Zotuluka lembani: (( Mndandanda ← 1 ; 2 ; 3 )), mzere-watsopano. 

Zotuluka lembani: ((Mtanthauziramawu chatsopano) ikani: 1 pa: 2), mzere-watsopano. 

>> x := ( (Mndandanda ← 1 ; ( Mndandanda ← 9 ) ; Zoona ) ) malemba-a-mawu.
Zotuluka lembani: x, mzere-watsopano. 
(['x := '] + x) evaluate.

Zotuluka lembani: x ? 1 ? 0, mzere-watsopano. 

>> y := (Mtanthauziramawu chatsopano) ikani: (Mndandanda ← 1) pa: (Mndandanda ← 2).
Zotuluka lembani: y, mzere-watsopano. 

(['y := '] + y) malemba-a-mawu evaluate.

Zotuluka lembani: (y pamalo: (Mndandanda ← 2) malemba-a-mawu ), mzere-watsopano.

Zotuluka lembani: (Mndandanda chatsopano), mzere-watsopano. 
Zotuluka lembani: (Mtanthauziramawu chatsopano), mzere-watsopano. 
