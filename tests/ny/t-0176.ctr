

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Pulogalamu kasamalidwe-ka-kukumbukira: 0.

>> txt := ['Word Salad'].
Zotuluka lembani: ['Text Length: '] + txt kutalika, mzere-watsopano.
Zotuluka lembani: ['Character at 2:'] + ( txt chilembo: 2 ), mzere-watsopano.
Zotuluka lembani: (( txt pezani: ['S'] ) - 0), mzere-watsopano.

Pulogalamu yeretsa.

usedMemory1 := (Pulogalamu kukumbukira ? 0).


txt := ['Word Salad'].
Zotuluka lembani: ['Text Length: '] + txt kutalika, mzere-watsopano.
Zotuluka lembani: ['Character at 2:'] + ( txt chilembo: 2 ), mzere-watsopano.
Zotuluka lembani: (( txt pezani: ['S'] ) - 0), mzere-watsopano.

Pulogalamu yeretsa.
usedMemory2 := (Pulogalamu kukumbukira ? 0).


txt := ['Word Salad'].
Zotuluka lembani: ['Text Length: '] + txt kutalika, mzere-watsopano.
Zotuluka lembani: ['Character at 2:'] + ( txt chilembo: 2 ), mzere-watsopano.
Zotuluka lembani: (( txt pezani: ['S'] ) - 0), mzere-watsopano.

Pulogalamu yeretsa.
usedMemory3 := (Pulogalamu kukumbukira ? 0).



( usedMemory1 = usedMemory2 ndi: usedMemory1 = usedMemory3, ndi: usedMemory2 = usedMemory3 ) zoona: {
	Zotuluka lembani: ['No memory leaks here'].
}, zabodza: {
	Zotuluka lembani: ['Leaking memory...'].
}.
