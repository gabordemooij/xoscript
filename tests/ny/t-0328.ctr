Pulogalamu kasamalidwe-ka-kukumbukira: 4.

>> Doubler := Chinthu chatsopano.
>> Multiplier := Chinthu chatsopano.
Doubler chikafika: ['double:and:'] chitani: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier chikafika: ['multiply:and:'] chitani: { :x :y <- (x × y).
}.

Zotuluka lembani: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), mzere-watsopano.
