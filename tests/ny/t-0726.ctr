# test buffers PKI/Sign 
Server init.

>> long := ( Mndandanda chatsopano dzaza: 1000 ndi: ['a'] ) lumikiza: [''].

# sign a message
Zotuluka lembani: ( 
	Nkhokwe-yotetezedwa saina: ['abc'] ndi: long
), mzere-watsopano.

Zotuluka lembani: ( 
	Nkhokwe-yotetezedwa
		onani: ['abc'] 
		siginecha: long 
		ndi: long
), mzere-watsopano.

Zotuluka lembani: (
	Nkhokwe-yotetezedwa hash-ya-mawu-achinsinsi: long tsimikizira: long
), mzere-watsopano.
