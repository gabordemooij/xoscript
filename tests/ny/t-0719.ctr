Server init.
>> fmt := Kapangidwe chatsopano: ['%#3x'].

>> blob := Blob chatsopano: 4.
blob bytes: ( 
	Mndandanda chatsopano ; 0 ; 1 ; 2 ; 3
).

>> file := Fayilo chatsopano: ['/tmp/blob'].
file blob: blob.
blob masula.

>> werengani := file blob.
werengani 
kuchokera: 0 
kutalika: 4, 
chitani chilichonse: { :i :b 
	Zotuluka
	lembani: (fmt gwiritsa-pa-nambala-yonse: b),
	mzere-watsopano.
}.
werengani masula.
