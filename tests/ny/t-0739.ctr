Zotuluka lembani: ['Test object'], mzere-watsopano.
>> a := Chinthu chatsopano. 

a chikafika: ['item:'] chitani: { :binhelper
	zake binhelper := binhelper. 
}.

a chikafika: ['item'] chitani: { <- zake binhelper.
}.

a item: Bin chatsopano.

>> old-binhelper-address := a item chitsanzo-choyamba adilesi-ya-kukumbukira.
a save-as: ['/tmp/a.bin'].
Zotuluka lembani: ['========== RELOADING SNAP:'], mzere-watsopano.

>> b := Chinthu load-from: ['/tmp/a.bin'].

(b item chitsanzo-choyamba adilesi-ya-kukumbukira = old-binhelper-address) zoona: {
	Zotuluka lembani: ['Object link re-attached.'], mzere-watsopano.
}.


