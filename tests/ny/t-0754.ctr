Zotuluka lembani: ['Test object'], mzere-watsopano.
>> a := Chinthu chatsopano. 

a chikafika: ['item:'] chitani: { :out
	zake out := out. 
}.

a chikafika: ['item'] chitani: { <- zake out.
}.

a chikafika: ['greet'] chitani: {
	Zotuluka lembani: ['hi from original out!'], mzere-watsopano.
}.

a item: Zotuluka.

Zotuluka lembani: a item, mzere-watsopano.

>> old-out-address := a item chitsanzo-choyamba adilesi-ya-kukumbukira.
a save-as: ['/tmp/a.bin'].
Zotuluka lembani: ['========== RELOADING SNAP:'], mzere-watsopano.

>> b := Chinthu load-from: ['/tmp/a.bin'].

(b item chitsanzo-choyamba adilesi-ya-kukumbukira = old-out-address) zoona: {
	Zotuluka lembani: ['Object link re-attached.'], mzere-watsopano.
}.

b item lembani: ['hello from loaded out!'], mzere-watsopano.
b greet.
