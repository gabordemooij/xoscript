

>> obj := Chinthu chatsopano.

obj chikafika: ['greet'] chitani: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj chikafika: ['task'] chitani: {
	zake property := 123.
	{
		# try binds self/own to object instead of block
		Zotuluka lembani: wekha greet.
		Zotuluka lembani: zake property.
		1 / 0.
	} gwira: {
		Zotuluka lembani: wekha greet.
		Zotuluka lembani: zake property.
		Zotuluka lembani: ['ok'].
	}, yesa.
}.

obj task.