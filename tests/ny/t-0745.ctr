Zotuluka lembani: ['Test object'], mzere-watsopano.
>> a := Chinthu chatsopano. 

a chikafika: ['item:'] chitani: { :dict
	zake dict := dict. 
}.

a chikafika: ['item'] chitani: { <- zake dict.
}.

a item: (
Mtanthauziramawu chatsopano
	hello: ['world']).

>> old-dict-address := a item chitsanzo-choyamba adilesi-ya-kukumbukira.
a save-as: ['/tmp/a.bin'].
Zotuluka lembani: ['========== RELOADING SNAP:'], mzere-watsopano.

>> b := Chinthu load-from: ['/tmp/a.bin'].

(b item chitsanzo-choyamba adilesi-ya-kukumbukira = old-dict-address) zoona: {
	Zotuluka lembani: ['Object link re-attached.'], mzere-watsopano.
}.

Zotuluka lembani: b item, mzere-watsopano.
