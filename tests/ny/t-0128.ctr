
Mndandanda chikafika: ['sum'] chitani: {
	>> total := 0.
	wekha chilichonse: { :index :element
		total onjezani: element.
	}. <- total.
}.

>> a := Mndandanda ← 9 ; 8 ; 7.
Zotuluka lembani: (a sum), mzere-watsopano. 
>> a := Mndandanda ← 1 ; 9.
Zotuluka lembani: (a sum), mzere-watsopano. 
>> a := Mndandanda ← ['o'] ; 2.
Zotuluka lembani: (a sum), mzere-watsopano. 
Zotuluka lembani: (Mndandanda chatsopano sum), mzere-watsopano. 
