Server init.

Zotuluka lembani: (
	Chitsanzo-chofufuzira chatsopano: ['^\\w+$'],
	kufanana: ['test@example.com'] 
), mzere-watsopano. # 0 match, fails on @ and .

Zotuluka lembani: (
	Chitsanzo-chofufuzira chatsopano: ['^[^@]+@[^\.]+\.\\w+$'],
	kufanana: ['test@example.com'] 
), mzere-watsopano. # 1 match

Zotuluka lembani: (
	Chitsanzo-chofufuzira chatsopano: ['[^@]+@[^\.]+\.\\w+'],
	kufanana: ['test@example.com'] 
), mzere-watsopano. # 1 match

Zotuluka lembani: (
	Chitsanzo-chofufuzira chatsopano: ['([^@]+)@([^\.]+)\.\\w+'],
	kufanana: ['test@example.com'] 
), mzere-watsopano. # 1 match, groups dont matter

Zotuluka lembani: (
	Chitsanzo-chofufuzira chatsopano: ['[a-z]'],
	kufanana: ['test@example.com'] 
), mzere-watsopano. # 14 matches

Zotuluka lembani: (
	Chitsanzo-chofufuzira chatsopano: ['.*'],
	kufanana: ['test@example.com'] 
), mzere-watsopano. # 1 match (all)

Zotuluka lembani: (
	Chitsanzo-chofufuzira chatsopano: ['(.*)'],
	kufanana: ['test@example.com'] 
), mzere-watsopano. # 1 match (all)

Zotuluka lembani: (
	Chitsanzo-chofufuzira chatsopano: ['\\s*[^@]+@[^\.]+\.\\w+'],
	kufanana: ['test@example.com'] 
), mzere-watsopano. # 1 match, prefix space optional, gets ignored