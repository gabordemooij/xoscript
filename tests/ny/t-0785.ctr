Zotuluka lembani: ['Test object'], mzere-watsopano.
>> a := Chinthu chatsopano. 

a chikafika: ['item:'] chitani: { :moment
	zake moment := moment. 
}.

a chikafika: ['item'] chitani: { <- zake moment.
}.

>> today := Mndandanda chatsopano ; ( Nthawi-yeniyeni chatsopano chigawo-cha-nthawi: ['CEST'], chaka: 2026, mwezi: 7 ).
a item: today.
Zotuluka lembani: a item ? 0, mzere-watsopano.
a save-as: ['/tmp/a.bin'].
