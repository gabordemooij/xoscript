#OBSD
>> dirname := [''].
{ dirname onjeza-kumapeto: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Pulogalamu dongosolo-la-makina: command.
Pulogalamu chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename onjeza-kumapeto: ['YYYYYYYY']. } * 20.
Fayilo chatsopano: filename, lembani: ['sometext'].
{ Fayilo mndandanda: ['/tmp/'] + dirname. } * 1000.
Zotuluka lembani: ['no crash'], mzere-watsopano.

