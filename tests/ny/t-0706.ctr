# can we override Int64?
Int64 chikafika: ['typ'] chitani: { <- ['i64']. }.
>> c := (Int64 kuchokera-ku-malemba: ['1']) + (Int64 kuchokera-ku-malemba: ['2']).
Zotuluka lembani: c typ, mzere-watsopano.
# does + still create a stringable int64?
>> x := c malemba-a-mawu.
Zotuluka lembani: x, mzere-watsopano.
