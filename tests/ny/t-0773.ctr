Zotuluka lembani: ['Test object'], mzere-watsopano.
>> a := Chinthu chatsopano. 
a chikafika: ['item:'] chitani: { :int64
	zake int64 := int64. 
}.
a chikafika: ['item'] chitani: { <- zake int64.
}.
a item: ( Int64 kuchokera-ku-malemba: ['9999'] ).
Zotuluka lembani: a item, mzere-watsopano.
>> old-int64-address := a item chitsanzo-choyamba adilesi-ya-kukumbukira.
a save-as: ['/tmp/a.bin'].
Zotuluka lembani: ['========== RELOADING SNAP:'], mzere-watsopano.
>> b := Chinthu load-from: ['/tmp/a.bin'].
(b item chitsanzo-choyamba adilesi-ya-kukumbukira = old-int64-address) zoona: {
	Zotuluka lembani: ['Object link re-attached.'], mzere-watsopano.
}.
Zotuluka lembani: ( b item ), mzere-watsopano.
