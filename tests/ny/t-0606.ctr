>> Point := Chinthu chatsopano.
Point chikafika: ['x-coordinate:'] chitani: { :x zake x := x. }.
Point chikafika: ['y-coordinate:'] chitani: { :y zake y := y. }.
Point chikafika: ['x-coordinate']  chitani: { <- zake x koperani. }.
Point chikafika: ['y-coordinate']  chitani: { <- zake y koperani. }.

Point chikafika: ['='] chitani: { :other <- ( zake x = other x-coordinate
		 ndi: zake y = other y-coordinate ).
}.

>> pier := Point chatsopano x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point chatsopano x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point chatsopano x-coordinate: 5, y-coordinate: 6.

Zotuluka lembani: pier = town-hall, mzere-watsopano.
Zotuluka lembani: pier = restaurant, mzere-watsopano.
