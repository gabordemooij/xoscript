#Linux

 >> t := Nthawi-yeniyeni chatsopano.
 
t chigawo-cha-nthawi: ['Europe/Amsterdam'].
t chaka: 2020, mwezi: 8, tsiku: 2, ola: 21, miniti: 2, sekondi: 1.

>> a := t ola.
>> ams := t chigawo-cha-nthawi.

t chigawo-cha-nthawi: ['US/Hawaii'].
>> b := t ola.
>> hw := t chigawo-cha-nthawi.

Zotuluka
lembani: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		ichi: ['later'] kapena-icho: ['earlier']
	)
),
mzere-watsopano.
 