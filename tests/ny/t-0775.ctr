Zotuluka lembani: ['Test object'], mzere-watsopano.
>> l := Mndandanda chatsopano ; 1 ; ( Mndandanda chatsopano ; (Nthawi-yeniyeni chatsopano: 1) ; (Int64 kuchokera-ku-malemba: ['321']) ; (Mndandanda chatsopano ; 3)).
Zotuluka lembani: l, mzere-watsopano.
>> old-lst-address := l chitsanzo-choyamba adilesi-ya-kukumbukira.
l save-as: ['/tmp/a.bin'].
Zotuluka lembani: ['========== RELOADING SNAP:'], mzere-watsopano.
>> b := Chinthu load-from: ['/tmp/a.bin'].
(b chitsanzo-choyamba adilesi-ya-kukumbukira = old-lst-address) zoona: {
	Zotuluka lembani: ['Object link re-attached.'], mzere-watsopano.
}.
Zotuluka lembani: b, mzere-watsopano.
