

# create a 64-bit integer for exact calculations
>> a := Int64 kuchokera-ku-malemba: ['123'].

# to string
Zotuluka lembani: a, mzere-watsopano.

# divide
Zotuluka lembani: a / (Int64 kuchokera-ku-malemba: ['3']), mzere-watsopano.

# multiply
Zotuluka lembani: a * (Int64 kuchokera-ku-malemba: ['2']), mzere-watsopano.

# add
Zotuluka lembani: a + (Int64 kuchokera-ku-malemba: ['1']), mzere-watsopano.

# subtract
Zotuluka lembani: a - (Int64 kuchokera-ku-malemba: ['2']), mzere-watsopano.

# compare
Zotuluka lembani: ( a =   (Int64 kuchokera-ku-malemba: ['123'])), mzere-watsopano.
Zotuluka lembani: ( a !=: (Int64 kuchokera-ku-malemba: ['124'])), mzere-watsopano.
Zotuluka lembani: ( a <   (Int64 kuchokera-ku-malemba: ['124'])), mzere-watsopano.
Zotuluka lembani: ( a >   (Int64 kuchokera-ku-malemba: ['122'])), mzere-watsopano.
Zotuluka lembani: ( a >=: (Int64 kuchokera-ku-malemba: ['123'])), mzere-watsopano.
Zotuluka lembani: ( a <=: (Int64 kuchokera-ku-malemba: ['123'])), mzere-watsopano.





	