>> t := Palibe.

# you can control the time zone for
# parsing like this:
Nthawi-yeniyeni chigawo-cha-nthawi: ['CET'].
t := Nthawi-yeniyeni gwero: ['1981-02-03 04:05:06'].
Zotuluka lembani: t, mzere-watsopano.

# now using CEST time zone:
Nthawi-yeniyeni chigawo-cha-nthawi: ['CEST'].
t := Nthawi-yeniyeni gwero: ['1981-02-03 04:05:06'].
Zotuluka lembani: t, mzere-watsopano.

# error if string cannot be parsed
{ Nthawi-yeniyeni gwero: ['1900']. } gwira: { Palibe. }, yamba.
