
Server init.
>> rq := Pempho-HTTP chatsopano.
Zotuluka lembani: ['HTTP-GET d[]=']  + ( rq get-mndandanda: ['d[]'] ), mzere-watsopano. # GET
Zotuluka lembani: ['HTTP-GET f[]=']  + ( rq get-mndandanda: ['f[]'] ), mzere-watsopano. # GET
Zotuluka lembani: ['HTTP-POST e[]='] + ( rq post-mndandanda: ['e[]'] ), mzere-watsopano. # GET
Zotuluka lembani: ['HTTP-POST c=']   + ( rq post: ['c'] ), mzere-watsopano. # GET
Zotuluka lembani: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), mzere-watsopano. # GET
