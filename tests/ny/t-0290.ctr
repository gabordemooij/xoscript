# test list operations


>> cakes := Mndandanda ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes sinthani: 1 kutalika: 2 ndi: ( Mndandanda ← ['cinnamon'] ; ['pineapple'] ).
Zotuluka lembani: (buy lumikiza: [',']), mzere-watsopano.


>> buy := cakes sinthani: 1 kutalika: 12 ndi: ( Mndandanda ← ['cinnamon'] ; ['pineapple'] ).
Zotuluka lembani: (buy lumikiza: [',']), mzere-watsopano.


>> buy := cakes sinthani: 2 kutalika: 10 ndi: ( Mndandanda chatsopano ).
Zotuluka lembani: (buy lumikiza: [',']), mzere-watsopano.


>> buy := cakes sinthani: 0 kutalika: 1 ndi: ( Mndandanda chatsopano ).
Zotuluka lembani: (buy lumikiza: [',']), mzere-watsopano.


>> buy := cakes sinthani: ['0'] kutalika: ['1'] ndi: ['x'].
Zotuluka lembani: (buy lumikiza: [',']), mzere-watsopano.
