#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Chitsanzo-chofufuzira chatsopano: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern kufanana: subject chitani: { :m :x
	Zotuluka lembani: m, mzere-watsopano.
	Zotuluka lembani: x, mzere-watsopano. <- ['XXX'].
}.
Zotuluka lembani: result, mzere-watsopano.