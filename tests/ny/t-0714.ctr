>> a := Chinthu chatsopano. 
a chikafika: ['greet'] chitani: { Zotuluka lembani: ['welcome!'], mzere-watsopano. }.
a chikafika: ['greet2'] chitani: { Zotuluka lembani: ['welcome2!'], mzere-watsopano. }.
a save-as: ['/tmp/a.bin'].

Zotuluka lembani: ['========== RELOADING SNAP:'], mzere-watsopano.
>> b := Chinthu load-from: ['/tmp/a.bin'].
b greet2.