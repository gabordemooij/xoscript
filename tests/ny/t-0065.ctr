Nambala chikafika: ['factorial'] chitani: {
	>> total := 1.
	{ :index total chulukitsani-ndi: (wekha - (index)). } × wekha. <- total.
}.
>> Printer := Chinthu chatsopano.
Printer chikafika: ['print:and:'] chitani: { :x :y
	Zotuluka lembani: ['a='] + x + [', b='] + y, mzere-watsopano.
}.
>> a := 4.5. >> b := a tsitsa-nambala.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a kweza-nambala.
Printer print: a and: b.
a := 4.5. b := a tsitsa-nambala.
Printer print: a and: b.
a := 4.5. b := a yandikitsa-nambala.
Printer print: a and: b.
a := 4.2. b := a yandikitsa-nambala.
Printer print: a and: b.

Zotuluka lembani: (9 chotsala: 5), mzere-watsopano.
Zotuluka lembani: -666 mtengo-weniweni, mzere-watsopano.
Zotuluka lembani: 49 muzu-wa-sikweya, mzere-watsopano.
Zotuluka lembani: (2 mphamvu-ya-nambala: 3), mzere-watsopano.
>> l := (Mndandanda ← 9 ; 6).
Zotuluka lembani: l chochepa-kwambiri.

