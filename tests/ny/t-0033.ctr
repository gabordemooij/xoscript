>> x := Chinthu chatsopano.
x chikafika: ['set:'] chitani: { :v zake val := v. }.
x chikafika: ['get'] chitani: { <- zake val. }.
>> a := Chinthu chatsopano.
a chikafika: ['init'] chitani: {
	>> y := x chatsopano.
	y set: 123.
	>> q := x chatsopano.
	q set: 666.
	Zotuluka lembani: (y get), lembani: (q get).
}.
a init.
