Zotuluka lembani: ['Test object'], mzere-watsopano.
>> a := Chinthu chatsopano. 

a chikafika: ['item:'] chitani: { :fmt
	zake fmt := fmt. 
}.

a chikafika: ['item'] chitani: { <- zake fmt.
}.

a item: ( Kapangidwe chatsopano: ['|%s|'] ).

Zotuluka lembani: a item, mzere-watsopano.

>> old-fmt-address := a item chitsanzo-choyamba adilesi-ya-kukumbukira.
a save-as: ['/tmp/a.bin'].
Zotuluka lembani: ['========== RELOADING SNAP:'], mzere-watsopano.

>> b := Chinthu load-from: ['/tmp/a.bin'].

(b item chitsanzo-choyamba adilesi-ya-kukumbukira = old-fmt-address) zoona: {
	Zotuluka lembani: ['Object link re-attached.'], mzere-watsopano.
}.

Zotuluka lembani: ( b item gwiritsa-pa: ['hello'] ), mzere-watsopano.
