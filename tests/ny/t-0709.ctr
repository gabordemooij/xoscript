# Can we use UTF8 in regex?
Server init.
>> p := Chitsanzo-chofufuzira chatsopano: ['\\w'].
Zotuluka lembani: ( p kufanana: ['x'] ), mzere-watsopano.
Zotuluka lembani: ( p kufanana: ['é'] ), mzere-watsopano.
>> p := Chitsanzo-chofufuzira chatsopano: ['(*UTF)(*UCP)\\w'].
Zotuluka lembani: ( p kufanana: ['é'] ), mzere-watsopano.
# should give 101