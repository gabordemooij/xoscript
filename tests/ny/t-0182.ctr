

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Pulogalamu kasamalidwe-ka-kukumbukira: 0.

>> txt := ['1.6'].
>> n := txt nambala.
>> t := txt buliyani.
Zotuluka lembani: n, mzere-watsopano.
Zotuluka lembani: t, mzere-watsopano.
Zotuluka lembani: n mtundu, mzere-watsopano.
Zotuluka lembani: t mtundu, mzere-watsopano.

Pulogalamu yeretsa.

usedMemory1 := (Pulogalamu kukumbukira ? 0).


