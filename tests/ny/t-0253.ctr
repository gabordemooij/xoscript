#Linux
>> OS := Pulogalamu kakhazikitsidwe: ['OS'].

>> clock := Nthawi-yeniyeni chatsopano.
	
(OS = ['Haiku']) zoona: {
	clock chigawo-cha-nthawi: ['CET'],
	chaka: 2017, mwezi: 7, tsiku: 13,
	ola: 18, miniti: 0, sekondi: 0.
}, ngati-ayi: {
	clock chigawo-cha-nthawi: ['Europe/Amsterdam'],
	chaka: 2017, mwezi: 7, tsiku: 13,
	ola: 18, miniti: 0, sekondi: 0.
}.

clock chikafika: ['tell'] chitani: {
	Zotuluka lembani: wekha, mzere-watsopano.
}.


clock onjezani: 2    ola, tell.
clock onjezani: 1    ola, tell.
clock onjezani: 19 miniti, tell.
clock onjezani: 1  miniti, tell.
clock onjezani: 1  miniti, tell.
clock onjezani: 19 sekondi, tell.
clock onjezani: 1  sekondi, tell.
clock onjezani: 1  sekondi, tell.
clock onjezani: 2    chaka, tell.
clock onjezani: 1    chaka, tell.

(OS = ['Haiku']) zoona: {
clock onjezani: 5   mwezi.
clock chigawo-cha-nthawi: ['CEST'], tell.
}, ngati-ayi: {
	clock onjezani: 5   mwezi, tell.
}.

clock onjezani: 1   mwezi, tell.
clock onjezani: 19    tsiku, tell.
clock onjezani: 1    ola, tell.
clock onjezani: 120  yard, tell.
