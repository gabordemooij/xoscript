# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> njira-ya-fayilo := ['/tmp/dat.csv'].
>> csv := Fayilo chatsopano: njira-ya-fayilo.
csv lembani: s.

# accepts CRLF LF CR, varying row length
csv cholekanitsa: [';'] chizindikiro-cha-mawu: ['"'] mizere: { :line
	Pulogalamu yeretsa.
	Zotuluka lembani: line, mzere-watsopano.
	Pulogalamu yeretsa.
}.

# unequal lines
s onjeza-kumapeto: ['\njustone'].
csv lembani: s.
{
	csv cholekanitsa: [';'] chizindikiro-cha-mawu: ['"'] mizere: { :line
		Zotuluka lembani: line, mzere-watsopano.
	}.
} gwira: { :e 
	Zotuluka lembani: e, mzere-watsopano.
}, yamba.

# invalid format
s := ['"he"llo";world'].
csv lembani: s.
{
	csv cholekanitsa: [';'] chizindikiro-cha-mawu: ['"'] mizere: { :line
		Zotuluka lembani: line, mzere-watsopano.
	}.
} gwira: { :e 
	Zotuluka lembani: e, mzere-watsopano.
}, yamba.
