Server init.

# create blob with 3 bytes
>> blob := Blob chatsopano: 3.
blob bytes: (Mndandanda chatsopano ; 1 ; 2 ; 3 ).

Zotuluka lembani: (
	blob kuchokera: 0 kutalika: 3
), mzere-watsopano.

# now wipe
blob fufuta-zamkati.
Zotuluka lembani: (
	blob kuchokera: 0 kutalika: 3
), mzere-watsopano.

blob masula.