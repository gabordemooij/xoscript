Malemba chikafika: ['html'] chitani: { <- (
		wekha
		sinthani: ['&'] ndi: ['&amp;'],
		sinthani: ['<'] ndi: ['&lt;'],
		sinthani: ['>'] ndi: ['&gt;'],
		sinthani: ['''] ndi: ['&apos;'],
		sinthani: ['"'] ndi: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Pulogalamu kasamalidwe-ka-kukumbukira: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Zotuluka lembani: txt koperani html, mzere-watsopano.
Zotuluka lembani: txt koperani zilembo-zazingono, mzere-watsopano.
Zotuluka lembani: txt koperani zilembo-zazikulu, mzere-watsopano.
} yamba.

Pulogalamu yeretsa.

usedMemory1 := (Pulogalamu kukumbukira ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Zotuluka lembani: txt koperani html, mzere-watsopano.
Zotuluka lembani: txt koperani zilembo-zazingono, mzere-watsopano.
Zotuluka lembani: txt koperani zilembo-zazikulu, mzere-watsopano.
} yamba.

Pulogalamu yeretsa.
usedMemory2 := (Pulogalamu kukumbukira ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Zotuluka lembani: txt koperani html, mzere-watsopano.
Zotuluka lembani: txt koperani zilembo-zazingono, mzere-watsopano.
Zotuluka lembani: txt koperani zilembo-zazikulu, mzere-watsopano.
} yamba.

Pulogalamu yeretsa.
usedMemory3 := (Pulogalamu kukumbukira ? 0).



( usedMemory1 = usedMemory2 ndi: usedMemory1 = usedMemory3, ndi: usedMemory2 = usedMemory3 ) zoona: {
	Zotuluka lembani: ['No memory leaks here'].
}, zabodza: {
	Zotuluka lembani: ['Leaking memory...'].
}.
