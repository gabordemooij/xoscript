#Linux

(Fayilo chatsopano: ['/tmp/testje']) lilipo zabodza: {
	Pulogalamu dongosolo-la-makina: ['mkdir /tmp/testje'].	
}.

(Fayilo chatsopano: ['/tmp/testje/file1']) lilipo zabodza: {
	Pulogalamu dongosolo-la-makina: ['touch /tmp/testje/file1'].	
}.

(Fayilo chatsopano: ['/tmp/testje/folder1']) lilipo zabodza: {
	Pulogalamu dongosolo-la-makina: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Fayilo mndandanda: ['/tmp/testje'].

>> q := Mndandanda chatsopano.

l chilichonse: { :k :v v chilichonse: { :x :y q onjeza-kumapeto: y. }. }.

>> s := q malemba-a-mawu.

(s muli: ['file1']) zoona:   { Zotuluka lembani: ['OK'], mzere-watsopano. }.
(s muli: ['file2']) zoona:   { Zotuluka lembani: ['XX'], mzere-watsopano. }.
(s muli: ['folder1']) zoona: { Zotuluka lembani: ['OK'], mzere-watsopano. }.
