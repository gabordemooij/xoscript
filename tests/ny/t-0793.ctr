Server init.

>> DB := Maria-DB chatsopano wolandira: ['localhost'],
	dzina-la-wogwiritsa: ['xo'],
	mawu-achinsinsi: ['pass123'],
	dzina-la-nkhokwe-ya-deta: ['xobase'],
	lumikizana.

{
	DB funso:
	['DROP TABLE movies'],
	chita-lamulo.
} gwira: { Palibe. }, yamba.

DB funso:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
chita-lamulo.

DB funso: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
zolowetsa-za-funso: ( Mndandanda chatsopano ; ['Halloween'] ),
chita-lamulo.

DB funso: ['SELECT * FROM movies'],
tenga: { :movie
	Zotuluka lembani: movie title, mzere-watsopano.
}.

