>> makeAdder := { :x
	>> f := { :y <- (zake x + y). } khazikitsa: ['x'] mtengo: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i zake q ikani: (zake f gwiritsa-pa: (zake q ? i)) pa: i. } 
	khazikitsa: ['q'] mtengo: array,
	khazikitsa: ['f'] mtengo: func.
	{ :i mapping gwiritsa-pa: i. } × (array chiwerengero-cha-zinthu).
}.

>> a := Mndandanda ← 1; 2; 3.
mapper gwiritsa-pa: a ndi: (makeAdder gwiritsa-pa: 100).
Zotuluka lembani: (a malo: 0), mzere-watsopano.
Zotuluka lembani: (a ? 1), mzere-watsopano.
Zotuluka lembani: (a ? 2), mzere-watsopano.
