
>> Rectangle := Chinthu chatsopano.

Rectangle chikafika: ['area'] chitani: { <- zake kutalika * zake width.
}.

Rectangle chikafika: ['length:'] chitani: { :kutalika
	zake kutalika := kutalika.
}.

Rectangle chikafika: ['width:'] chitani: { :width
	zake width := width.
}.

Rectangle chikafika: ['chatsopano'] chitani: {
	# this will not result into an infinite loop
	>> rectangle := wekha chatsopano.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle chatsopano.
Zotuluka lembani: a area, mzere-watsopano. #0

>> b := Rectangle chatsopano length: 2, width: 3.
Zotuluka lembani: b area, mzere-watsopano. #6

