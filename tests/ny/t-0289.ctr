#Linux
>> OS := Pulogalamu dongosolo-la-makina: (Lamulo uname -s), dula-mipata.

>> Slurp := Chinthu chatsopano.
Slurp chikafika: ['chatsopano'] chitani: {
	zake str := [''].
}.
Slurp chikafika: ['yankha:'] chitani: { :blah
		(zake str ≠ ['']) zoona: {
			zake str onjeza-kumapeto: [' '].
		}.
		zake str onjeza-kumapeto: blah.
}.
Slurp chikafika: ['yankha:ndi:'] chitani: { :blah :blahah
		(zake str ≠ ['']) zoona: {
			zake str onjeza-kumapeto: [' '].
		}.
		(blah kutalika > 1) zoona: {
			zake str onjeza-kumapeto: (blah kuchokera: 0 kutalika: (blah kutalika - 1)).
		}, ngati-ayi: {
			zake str onjeza-kumapeto: blah.
		}.
		zake str onjeza-kumapeto: [' '].
		zake str onjeza-kumapeto: blahah.
}.
Slurp chikafika: ['obtain'] chitani: {
	>> buffer := zake str.
	zake str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text onjeza-kumapeto: ['hello'].
} × 1000.


Zotuluka lembani: (
	Pulogalamu dongosolo-la-makina: (
		Slurp chatsopano
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

