>> z := Chinthu chatsopano.
z chikafika: ['value:'] chitani: { :v
	zake value := v. <- wekha.
}.
z chikafika: ['value'] chitani: { <- zake value. }.
(z setValue: 1) value: 2.
Zotuluka lembani: z value.
>> x := z.
Zotuluka lembani: x value.
z := Palibe.
Zotuluka lembani: z value.
Zotuluka lembani: x value.
Zotuluka lembani: ['hello'].
Zotuluka lembani: 3 + 2.
Zotuluka lembani: (3 > 2).
