>> q := Mndandanda ← 1 ; 2 ; 3.
{ q ? ['1']. } gwira: { Zotuluka lembani: ['caught!'], mzere-watsopano. }, yamba.
{ q ? Zoona. } gwira: { Zotuluka lembani: ['caught!'], mzere-watsopano. }, yamba.
{ q ? Zabodza. } gwira: { Zotuluka lembani: ['caught!'], mzere-watsopano. }, yamba.
{ q ? Palibe. } gwira: { Zotuluka lembani: ['caught!'], mzere-watsopano. }, yamba.
{ q ? (Mndandanda chatsopano). } gwira: { Zotuluka lembani: ['caught!'], mzere-watsopano. }, yamba.
{ q ? (Chinthu chatsopano). } gwira: { Zotuluka lembani: ['caught!'], mzere-watsopano. }, yamba.
{ q ? ({ ['Empty']. }). } gwira: { Zotuluka lembani: ['caught!'], mzere-watsopano. }, yamba.
Zotuluka lembani: ['caught them all'], mzere-watsopano.
