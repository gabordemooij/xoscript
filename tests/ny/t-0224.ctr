
>> countries := Mndandanda chatsopano
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Mndandanda chatsopano
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods malinga-ndi: countries, chilichonse: { :key :value
	counter onjezani: 1.
}.

Zotuluka lembani: (['we serve counter dishes'] counter: counter), mzere-watsopano.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] zilembo sanja: { :v
	counter onjezani: 0.
}.

Zotuluka lembani: (['we sort counter dishes'] counter: counter), mzere-watsopano.


>> counter := 0.
{
	{
		counter onjezani: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Zotuluka lembani: (['we calculate counter numbers.'] counter: counter), mzere-watsopano.

