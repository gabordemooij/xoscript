{
	ntchito-iyi cholakwika: ['Dont fail.'].
	unknown doSomething.
} gwira: {
	Zotuluka lembani: ['Caught!'].
}, yamba.

{
	ntchito-iyi cholakwika: ['Dont fail.'].
	zake unknown doSomething.
} gwira: {
	Zotuluka lembani: ['Caught!'].
}, yamba.

{
	ntchito-iyi cholakwika: ['Dont fail.'].
	unknown := 122.
} gwira: {
	Zotuluka lembani: ['Caught!'].
}, yamba.


{
	ntchito-iyi cholakwika: ['Dont fail.'].
	Zoona dula.
	Zotuluka lembani: ['FAIL'].
} gwira: {
	Zotuluka lembani: ['Caught!'].
}, yamba.

{
	{
		ntchito-iyi cholakwika: ['Dont fail.'].
		Zoona dula.
		Zotuluka lembani: ['FAIL'].
	} gwira: { :x
		(x = ['Dont fail.']) zoona: { ntchito-iyi cholakwika: ['Nested Caught!']. }.
	}, yamba.
} gwira: { :e
	Zotuluka lembani: e.
}, yamba.
