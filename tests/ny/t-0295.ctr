
>> dictionary := (
	Mtanthauziramawu chatsopano
		ikani: ['b'] pa: ['a'],
		ikani: ['a'] pa: ['b'],
		ikani: ['z'] pa: ['x'],
		ikani: ['hello'] pa: ['hallo'],
		ikani: ['human'] pa: ['human']
).

>> comparisons := Mndandanda chatsopano.
dictionary chilichonse: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a fanizira: b)
	).
}.

comparisons sanja: { :a :b <- ( a fanizira: b ). }.
Zotuluka lembani: ( comparisons lumikiza: ['↵'] ), mzere-watsopano.
comparisons lumikiza: ['↵'].
