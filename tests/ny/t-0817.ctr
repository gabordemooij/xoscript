# a value ending in the first part of an opening quote must survive serialization
>> mitengo := Mndandanda chatsopano
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

mitengo chilichonse: { :i :value
	>> d := Mtanthauziramawu chatsopano.
	d ikani: value pa: ['k'].
	d ikani: ['second'] pa: ['j'].
	>> r := d khodi chinthu.
	Zotuluka lembani: r chiwerengero-cha-zinthu, mzere-watsopano.
	Zotuluka lembani: ( (r pamalo: ['k']) = value ), mzere-watsopano.
}.
