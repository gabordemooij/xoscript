Server init.
>> blob := Blob chatsopano: 4.
blob bytes: ( 
	Mndandanda chatsopano ; 0 ; 1 ; 2 ; 3
).
>> b64 := blob base64-ika-khodi.
Zotuluka lembani: b64, mzere-watsopano.
blob masula.
>> blob2 := Blob base64-chotsa-khodi: b64.
Zotuluka lembani: ( blob2 kuchokera: 0 kutalika: 4 ), mzere-watsopano.
blob2 masula.
