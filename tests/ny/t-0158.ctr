>> x := [' hallo '].

>> y := x zilembo-zazikulu.
Zotuluka lembani: x, mzere-watsopano.
Zotuluka lembani: (x chimodzimodzi: y), mzere-watsopano.

>> y := x zilembo-zazingono.
Zotuluka lembani: x, mzere-watsopano.
Zotuluka lembani: (x chimodzimodzi: y), mzere-watsopano.

>> y := x dula-mipata.
Zotuluka lembani: x, mzere-watsopano.
Zotuluka lembani: (x chimodzimodzi: y), mzere-watsopano.

>> y := x lumpha: 1.
Zotuluka lembani: x, mzere-watsopano.
Zotuluka lembani: (x chimodzimodzi: y), mzere-watsopano.

>> y := x kuchokera: 1 kutalika: 2.
