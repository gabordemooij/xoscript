# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Pulogalamu shell-escape: ['abc'].
Zotuluka lembani: c, mzere-watsopano.
Zotuluka lembani: ( Pulogalamu dongosolo-la-makina: ['echo '] + c ), mzere-watsopano.

c := Pulogalamu shell-escape: ['a'b'c'].
Zotuluka lembani: c, mzere-watsopano.
Zotuluka lembani: ( Pulogalamu dongosolo-la-makina: ['echo '] + c ), mzere-watsopano.

c := Pulogalamu shell-escape: ['a\'c'].
Zotuluka lembani: c, mzere-watsopano.
Zotuluka lembani: ( Pulogalamu dongosolo-la-makina: ['echo '] + c ), mzere-watsopano.