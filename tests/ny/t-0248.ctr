

Malemba chikafika: ['evaluate'] chitani: {
	>> khodi := Fayilo chatsopano: ['/tmp/eval.ctr'].
	khodi lembani: wekha malemba-a-mawu + ['.'].
	Pulogalamu gwiritsa-chida: ['/tmp/eval.ctr'].
}.

>> a := (Mndandanda ← (
	(Mtanthauziramawu chatsopano)
		ikani: ['domain'] pa: ['mywebsite.com'],
		ikani: (Mndandanda ←
			((Mtanthauziramawu chatsopano)
				ikani: ['home'] pa: ['title'],
				ikani: ['<html></html>'] pa: ['body'],
				ikani: ['2017-01-01'] pa: ['created']
			) ;
			((Mtanthauziramawu chatsopano)
				ikani: ['aboutus(c)'] pa: ['title'],
				ikani: ['<credits>Author Inc.</credits>'] pa: ['body']
			)
		) pa: ['pages']
	)
) malemba-a-mawu.

Zotuluka lembani: a mtundu, mzere-watsopano.
Zotuluka lembani: a, mzere-watsopano.

>> b := Palibe.
(['b := '] + a) evaluate.
Zotuluka lembani: b ? 0 ? ['pages'] ? 1 ? ['body'], mzere-watsopano.

>> c := b ? 0.
>> d := c malemba-a-mawu.
Zotuluka lembani: d mtundu, mzere-watsopano.

>> e := Palibe.
(['e := '] + d) evaluate.
Zotuluka lembani: e ? ['pages'] ? 0, mzere-watsopano.
