Server init.
>> f := Kapangidwe chatsopano: ['%d'].
>> a := Blob chatsopano: 4.
a bytes: ( Mndandanda chatsopano ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob chatsopano: 4.
b bytes: ( Mndandanda chatsopano ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a kuchokera: 0 kutalika: 3, chilichonse: { :i :byte
	Zotuluka lembani: ( f gwiritsa-pa-nambala-yonse: byte ), mzere-watsopano.
}.
a ^ b.
a kuchokera: 0 kutalika: 3, chilichonse: { :i :byte
	Zotuluka lembani: ( f gwiritsa-pa-nambala-yonse: byte ), mzere-watsopano.
}.
a ^ b.
a kuchokera: 0 kutalika: 3, chilichonse: { :i :byte
	Zotuluka lembani: ( f gwiritsa-pa-nambala-yonse: byte ), mzere-watsopano.
}.
a masula.
b masula.

{ a ^ Chinthu. } gwira: { :e Zotuluka lembani: e, mzere-watsopano. }, yamba.
