
{ :i
	Zotuluka lembani: ['This is step #'] + ( ( i ) + 1 ), mzere-watsopano.
} × 6.

{ :i
	Zotuluka lembani: ['This is step #'] + ( 3 - ( i ) ), mzere-watsopano.
} × 6.

{ :i
	Zotuluka lembani: ['NEVER!'], mzere-watsopano.
} × 0.



{ :i
	Zotuluka lembani: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), mzere-watsopano.
} × 11.
