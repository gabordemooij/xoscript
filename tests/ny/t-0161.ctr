Pulogalamu kasamalidwe-ka-kukumbukira: 0.
Mndandanda chikafika: ['sum'] chitani: {
	>> total := 0.
	wekha chilichonse: { :index :element
		total onjezani: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Fayilo chatsopano: ['/tmp/test.txt'].
f lembani: ['Lorem Ipsum'].
f tseka.
  

f := Fayilo chatsopano: ['/tmp/test.txt'].
>> text := f werengani.
f tseka.



Pulogalamu yeretsa.
usedMemory1 := (Pulogalamu kukumbukira ? 1).



f := Fayilo chatsopano: ['/tmp/test.txt'].
text := f werengani.
f tseka.

Pulogalamu yeretsa.
usedMemory2 := (Pulogalamu kukumbukira ? 1).


f := Fayilo chatsopano: ['/tmp/test.txt'].
text := f werengani.
f tseka.

Pulogalamu yeretsa.
usedMemory3 := (Pulogalamu kukumbukira ? 1).



( usedMemory1 = usedMemory2 ndi: usedMemory1 = usedMemory3, ndi: usedMemory2 = usedMemory3 ) zoona: {
	Zotuluka lembani: ['No memory leaks here'].
}, zabodza: {
	Zotuluka lembani: ['Leaking memory...'].
}.
