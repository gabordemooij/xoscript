Mndandanda chikafika: ['sum'] chitani: {
	>> total := 0.
	wekha chilichonse: { :index :element
		total onjezani: element.
	}. <- total.
}.

>> a := Zoona.



a chikafika: ['malemba-a-mawu'] chitani: {
	>> answer := Palibe.
	( wekha = Zoona ) zoona: {
		answer := ['Yep'].
	}, ngati-ayi: {
		answer := ['Nope'].
	}. <- answer.
}.

a chikafika: ['nambala'] chitani: {
	>> answer := Palibe.
	( wekha = Zoona ) zoona: {
		answer := 10.
	}, ngati-ayi: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b chikafika: ['malemba-a-mawu'] chitani: { <- ['Devil'].
}.

b chikafika: ['buliyani'] chitani: { <- Zabodza.
}.


Zotuluka lembani: a, mzere-watsopano.  
Zotuluka lembani: (90 + a), mzere-watsopano. 
Zotuluka lembani: b, mzere-watsopano. 
Zotuluka lembani: (Zoona ndi: b), mzere-watsopano.

a := Mndandanda ← ['hello'] ; ['world'] ; Zoona ; Palibe ; 666. 
a := a + ( Mndandanda ← 1 ).
Zotuluka lembani: a, mzere-watsopano.
Zotuluka lembani: ((Mtanthauziramawu chatsopano) ikani: Palibe pa: Palibe), mzere-watsopano.
Zotuluka lembani: a sum, mzere-watsopano. 


{
	a chikafika: ['malemba-a-mawu'] chitani: { <- Palibe. }.
	a := [''] + a.
} gwira: { :error
	Zotuluka lembani: ['Error noted: '] + error, mzere-watsopano.
}, yamba.



{
	a chikafika: ['nambala'] chitani: { <- Palibe. }.
	a := 3 × a.
} gwira: { :error
	Zotuluka lembani: ['Error noted: '] + error, mzere-watsopano.
}, yamba.


{
	a chikafika: ['buliyani'] chitani: { <- Palibe. }.
	a := Zoona ndi: a. 
} gwira: { :error
	Zotuluka lembani: ['Error noted: '] + error, mzere-watsopano.
}, yamba.





