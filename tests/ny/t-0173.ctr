

Mndandanda chikafika: ['sum'] chitani: {
	>> total := 0.
	wekha chilichonse: { :index :element
		total onjezani: element.
	}. <- total.
}.

Mndandanda chikafika: ['product'] chitani: {
	>> total := 1.
	wekha chilichonse: { :index :element
		total chulukitsani-ndi: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Pulogalamu kasamalidwe-ka-kukumbukira: 0.

{

>> a := Mndandanda ← ['hello'] ; ['world'] ; Zoona ; Palibe ; 666.
a := a + ( Mndandanda ← 1 ).
Zotuluka lembani: ( ['sum: '] + ( a sum ) ), mzere-watsopano.
Zotuluka lembani: ( ['min: '] + ( a chochepa-kwambiri ) ), mzere-watsopano.
Zotuluka lembani: ( ['max: '] + ( a chachikulu-kwambiri ) ), mzere-watsopano.
Zotuluka lembani: ( ['3rd: '] + ( a ? 2 ) ), mzere-watsopano.
Zotuluka lembani: ( ['prd: '] + ( a product ) ), mzere-watsopano.
a sanja: { :a :b <- (b - a). }.
a chilichonse: { :i :e Zotuluka lembani: ( i - 0 ), mzere-watsopano. }.

} yamba.

Pulogalamu yeretsa.
usedMemory1 := (Pulogalamu kukumbukira ? 0).


{

>> a := Mndandanda ← ['hello'] ; ['world'] ; Zoona ; Palibe ; 666.
a := a + ( Mndandanda ← 1 ).
Zotuluka lembani: ( ['sum: '] + ( a sum ) ), mzere-watsopano.
Zotuluka lembani: ( ['min: '] + ( a chochepa-kwambiri ) ), mzere-watsopano.
Zotuluka lembani: ( ['max: '] + ( a chachikulu-kwambiri ) ), mzere-watsopano.
Zotuluka lembani: ( ['3rd: '] + ( a ? 2 ) ), mzere-watsopano.
Zotuluka lembani: ( ['prd: '] + ( a product ) ), mzere-watsopano.
a sanja: { :a :b <- (b - a). }.
a chilichonse: { :i :e Zotuluka lembani: ( i - 0 ), mzere-watsopano. }.

} yamba.



Pulogalamu yeretsa.
usedMemory2 := (Pulogalamu kukumbukira ? 0).


{

>> a := Mndandanda ← ['hello'] ; ['world'] ; Zoona ; Palibe ; 666.
a := a + ( Mndandanda ← 1 ).
Zotuluka lembani: ( ['sum: '] + ( a sum ) ), mzere-watsopano.
Zotuluka lembani: ( ['min: '] + ( a chochepa-kwambiri ) ), mzere-watsopano.
Zotuluka lembani: ( ['max: '] + ( a chachikulu-kwambiri ) ), mzere-watsopano.
Zotuluka lembani: ( ['3rd: '] + ( a ? 2 ) ), mzere-watsopano.
Zotuluka lembani: ( ['prd: '] + ( a product ) ), mzere-watsopano.
a sanja: { :a :b <- (b - a). }.
a chilichonse: { :i :e Zotuluka lembani: ( i - 0 ), mzere-watsopano. }.

} yamba.



Pulogalamu yeretsa.
usedMemory3 := (Pulogalamu kukumbukira ? 0).

( usedMemory1 = usedMemory2 ndi: usedMemory1 = usedMemory3, ndi: usedMemory2 = usedMemory3 ) zoona: {
	Zotuluka lembani: ['No memory leaks here'].
}, zabodza: {
	Zotuluka lembani: ['Leaking memory...'].
}.
