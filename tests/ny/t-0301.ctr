


>> wine := Chinthu chatsopano.


wine chikafika: ['toString'] chitani: { <- ['merlot'].
}.

wine chikafika: ['naarTekst'] chitani: { <- ['merlot'].
}.


wine chikafika: ['='] chitani: { :other wine <- ( wekha toString = other wine ).
}.

wine chikafika: ['=='] chitani: { :other wine <- ( wekha toString = other wine ).
}.



wine
	ngati-zili-choncho: ['cabernet'] chitani: { Zotuluka lembani: ['it's a Cabernet!']. },
	ngati-zili-choncho: ['syrah']    chitani: { Zotuluka lembani: ['it's a Syrah!'].    },
	ngati-zili-choncho: ['merlot']   chitani: { Zotuluka lembani: ['it's a Merlot!'].   },
	ngati-zili-choncho: ['malbec']   chitani: { Zotuluka lembani: ['it's a Malbec!'].   }.

Zotuluka mzere-watsopano.
