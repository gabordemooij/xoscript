
>> city := Mndandanda ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Mndandanda ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature malinga-ndi: city.
>> cities := weather makiyi sanja: { :a :b <- (a fanizira: b). }.
>> temperatures := weather mitengo sanja: { :a :b <- (a fanizira: b) pansi-pa-ziro?. }.

Zotuluka lembani: (cities lumikiza: [',']), mzere-watsopano.
Zotuluka lembani: (temperatures lumikiza: [',']), mzere-watsopano.
