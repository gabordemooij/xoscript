# Test ASCII variants

# Numbers

Zotuluka lembani: (2 !=: 3), mzere-watsopano.
Zotuluka lembani: (2 <=: 2), mzere-watsopano.
Zotuluka lembani: (2 >=: 2), mzere-watsopano.

# Strings

Zotuluka lembani: (['b'] >=: ['a']), mzere-watsopano.
Zotuluka lembani: (['b'] !=: ['a']), mzere-watsopano.
Zotuluka lembani: (['b'] <=: ['c']), mzere-watsopano.

# Bools

Zotuluka lembani: (Zoona !=: Zabodza), mzere-watsopano.

# Objects

Zotuluka lembani: (Chinthu chatsopano !=: Chinthu chatsopano), mzere-watsopano.

# ASCII list symbol <-:

Zotuluka lembani: (Mndandanda <<: 1, ; 2 ; 3) chiwerengero-cha-zinthu = 3, mzere-watsopano.

