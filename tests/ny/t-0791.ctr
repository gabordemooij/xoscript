Server init.

>> DB := Maria-DB chatsopano wolandira: ['localhost'],
	dzina-la-wogwiritsa: ['xo'],
	mawu-achinsinsi: ['pass123'],
	dzina-la-nkhokwe-ya-deta: ['xobase'],
	lumikizana.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> zofufuzira := Funso-Maria chatsopano: SQL.

# set database
zofufuzira nkhokwe-ya-deta: DB.

zofufuzira tenga: { :row
	Zotuluka lembani: row world, mzere-watsopano.
}.
