Zotuluka lembani: ['Test object'], mzere-watsopano.
>> a := Chinthu chatsopano. 

a chikafika: ['state:'] chitani: { :list
	zake list := list. 
}.

a chikafika: ['state'] chitani: {
	Zotuluka lembani: zake list, mzere-watsopano.
}.

a state: ( Mndandanda chatsopano ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
Zotuluka lembani: ['========== RELOADING SNAP:'], mzere-watsopano.
>> b := Chinthu load-from: ['/tmp/a.bin'].
b state.