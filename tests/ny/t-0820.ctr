# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Chitsanzo-chofufuzira chatsopano: pattern.
	p kufanana: subject chitani: { :m :g
		Zotuluka lembani: g chiwerengero-cha-zinthu, lembani: [' '], lembani: (g lumikiza: ['|']), mzere-watsopano. <- m.
	}.
}.
show gwiritsa-pa: ['(a)|(b)'] ndi: ['b'].
show gwiritsa-pa: ['(a)|(b)'] ndi: ['a'].
show gwiritsa-pa: ['(x)?y'] ndi: ['y'].
show gwiritsa-pa: ['(x)?(y)(z)?'] ndi: ['xy'].
