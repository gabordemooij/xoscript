>> numbers := ['1,2,3'] gawa: [','].
Zotuluka lembani: ['I got: '] + numbers chiwerengero-cha-zinthu + [' numbers.'],mzere-watsopano.
{ :i Zotuluka lembani: ['number #'] + i + [':'] + (numbers malo: i), mzere-watsopano.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages gawa: [' Or '].
Zotuluka lembani: ['We serve'], mzere-watsopano.
{ :i Zotuluka lembani: ['->'] + (beverages malo: i), mzere-watsopano. } × (beverages chiwerengero-cha-zinthu).
Zotuluka lembani: (beverages lumikiza: [',']), mzere-watsopano.
Zotuluka lembani: (numbers lumikiza: ['||']).
