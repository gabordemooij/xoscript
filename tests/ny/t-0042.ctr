>> items := Mtanthauziramawu chatsopano.
items ikani: ['black'] pa: ['coffee'], ikani: ['earl grey'] pa: ['tea'].
Zotuluka lembani: (items pamalo: ['coffee']), lembani: (items pamalo: ['tea']).
Zotuluka lembani: ['there are'] + items chiwerengero-cha-zinthu + [' items in the array.'].
items ikani: ['capuccino'] pa: ['coffee'].
Zotuluka lembani: ['Now my coffee is.. '] + (items pamalo: ['coffee']).
items ikani: ['aaa'] pa: ['1'].
items ikani: ['bbb'] pa: ['2'].
Zotuluka lembani: (items pamalo: ['a']).
