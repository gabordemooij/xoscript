
>> Size := Chinthu chatsopano.
Size chikafika: ['is:'] chitani: { :nambala
	nambala chikafika: ['+'] chitani: { :nambala
		>> unit := nambala muyeso-wa-nambala.
		>> factor := 1.
		
		unit
		ngati-zili-choncho: ['inch'] chitani: { factor := 0.0833. }. <- wekha + (nambala * factor).
	}. <- nambala.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Zotuluka lembani: plank + edge, mzere-watsopano.
