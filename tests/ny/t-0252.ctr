#Linux
>> clock := Nthawi-yeniyeni chatsopano.
clock chigawo-cha-nthawi: ['UTC-1'].
clock chaka: 1981, mwezi: 1, tsiku: 5,
      ola: 13, miniti: 15, sekondi: 13.

Zotuluka lembani: clock, mzere-watsopano.
clock chigawo-cha-nthawi: ['UTC+0'].

Zotuluka lembani: (
	(clock chaka wamba) + ['-'] + (clock mwezi) + ['-'] + (clock tsiku) + [' '] +
	(clock ola) + [':'] + (clock miniti) + [':'] + (clock sekondi) + [' '] +
	['W'] + (clock sabata) + (clock chigawo-cha-nthawi)
), mzere-watsopano.


clock chigawo-cha-nthawi: ['UTC-1'].
Zotuluka lembani: (
	(clock chaka wamba) + ['-'] + (clock mwezi) + ['-'] + (clock tsiku) + [' '] +
	(clock ola) + [':'] + (clock miniti) + [':'] + (clock sekondi) + [' '] +
	['W'] + (clock sabata) + (clock chigawo-cha-nthawi)
), mzere-watsopano.
