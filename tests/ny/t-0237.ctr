
Malemba chikafika: ['evaluate'] chitani: {
	>> khodi := Fayilo chatsopano: ['/tmp/eval.ctr'].
	khodi lembani: (wekha malemba-a-mawu + ['.']).
	Pulogalamu gwiritsa-chida: ['/tmp/eval.ctr'].
}.

>> map :=
	(Mtanthauziramawu chatsopano)
	ikani: ['Hi There'] pa: ['two'],
	ikani: (Mndandanda ← ['hello'] ; ['world'] ; (Mndandanda ← 1 ; 2; 9) ; Zabodza) pa: ['one'],
	ikani: ( (Mtanthauziramawu chatsopano) ikani: ['wrrld'] pa: ['misspelled'] ) pa: ['three'],
	ikani: (Mndandanda ← ((Mtanthauziramawu chatsopano) ikani: ['treasure'] pa: ['hidden']) ; 2) pa: ['four']. 
>> str := map malemba-a-mawu.
>> map2 := Palibe.
(['map2 := '] + str ) evaluate.
Zotuluka lembani: map2 ? ['one'] ? 0.
Zotuluka lembani: map2 ? ['one'] ? 1.
Zotuluka lembani: map2 ? ['four'] ? 0 ? ['hidden'].
Zotuluka lembani: map2 ? ['one'] ? 2 ? 2.
