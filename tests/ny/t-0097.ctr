
Malemba chikafika: ['html'] chitani: { <- (
		wekha
		sinthani: ['&'] ndi: ['&amp;'],
		sinthani: ['<'] ndi: ['&lt;'],
		sinthani: ['>'] ndi: ['&gt;'],
		sinthani: ['"'] ndi: ['&quot;']
	).
}.

>> HtmlBrush := Chinthu chatsopano.

HtmlBrush chikafika: ['yankha:'] chitani: { :tag
	Zotuluka lembani: (['<tag>↵'] tag: tag ).
}.

HtmlBrush chikafika: ['yankha:ndi:'] chitani: { :tag :content
	tag := ( tag kuchokera: 0 kutalika: (tag kutalika - 1) ).
	Zotuluka lembani: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush chikafika: ['content:'] chitani: { :text
	Zotuluka lembani: text html, mzere-watsopano.
}.

HtmlBrush chikafika: ['attr:value:'] chitani: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush chatsopano.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
