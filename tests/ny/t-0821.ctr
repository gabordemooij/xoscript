# a quote that never closes must give an error, not an endless loop
>> njira-ya-fayilo := ['/tmp/test0821.csv'].
>> file := Fayilo chatsopano: njira-ya-fayilo.

file lembani: ['a,b\n"1,2\n'].
{
	file cholekanitsa: [','] chizindikiro-cha-mawu: ['"'] mizere: { :line
		Zotuluka lembani: line, mzere-watsopano.
	}.
} gwira: { :e Zotuluka lembani: e, mzere-watsopano. }, yamba.

# a closed quote still works
file lembani: ['a,b\n"1,2",3'].
file cholekanitsa: [','] chizindikiro-cha-mawu: ['"'] mizere: { :line
	Zotuluka lembani: line, mzere-watsopano.
}.
file chotsani.
