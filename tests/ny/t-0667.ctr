# test Program version

# this feature is disabled by default
Zotuluka lembani: (
	Pulogalamu mbali: 
	['RECURSIVE_STRINTPOL']
), mzere-watsopano.


# but if we set the time back
>> today := Nthawi-yeniyeni 
chigawo-cha-nthawi: ['CEST'],
gwero: ['2026-02-15 10:00:00'].
Pulogalamu mtundu-wotulutsidwa: today.

# it will be enabled like it used to be (from now on)
Zotuluka lembani: (
	Pulogalamu mbali: 
	['RECURSIVE_STRINTPOL']
), mzere-watsopano.