Zotuluka lembani: ['1,2,3,4,5,6,7,8,9,A,'], mzere-watsopano.
>> Scope := Chinthu chatsopano.
Scope chikafika: ['initialize:'] chitani: { :x zake property := x. }.
Scope chikafika: ['confirm'] chitani: { Zotuluka lembani: [',']. }.
Scope chikafika: ['mayeso'] chitani: {
	Zotuluka lembani: zake property.
	wekha confirm.
	( 1 = 1 ) zoona: { Zotuluka lembani: zake property. wekha confirm. }.
	( 1 = 0 ) zabodza: { Zotuluka lembani: zake property. wekha confirm. }.
	>> y := 2. { Zotuluka lembani: zake property. wekha confirm. } bola-ngati: { y chotsa: 1. <- (y > 0). }.
	{ Zotuluka lembani: zake property. wekha confirm. } × 1.
	(Mndandanda ← 1) chilichonse: {  Zotuluka lembani: zake property. wekha confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Mtanthauziramawu chatsopano one: ['item']) chilichonse: { Zotuluka lembani: zake property. wekha confirm. }.
	{ 1 ÷ 0. } gwira: { Zotuluka lembani: zake property. wekha confirm. }, yamba.
	Zotuluka mzere-watsopano.
}.
>> scope1 := Scope chatsopano.
scope1 initialize: ['X'].
scope1 mayeso.
>> function := { 
	zake property := ['Y'].
	Zotuluka lembani: zake property.
	wekha confirm.
	( 1 = 1 ) zoona: { Zotuluka lembani: zake property. wekha confirm. }.
	( 1 = 0 ) zabodza: { Zotuluka lembani: zake property. wekha confirm. }.
	>> y := 2. { Zotuluka lembani: zake property. wekha confirm. } bola-ngati: { y chotsa: 1. <- (y > 0). }.
	{ Zotuluka lembani: zake property. wekha confirm. } × 1.
	(Mndandanda ← 1) chilichonse: {  Zotuluka lembani: zake property. wekha confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Mtanthauziramawu chatsopano one: ['item']) chilichonse: { Zotuluka lembani: zake property. wekha confirm. }.
	{ 1 ÷ 0. } gwira: { Zotuluka lembani: zake property. wekha confirm. }, yamba.
	Zotuluka mzere-watsopano.
}.
function chikafika: ['confirm'] chitani: { Zotuluka lembani: [',']. }.
function gwiritsa-pa: 1 ndi: 2.
