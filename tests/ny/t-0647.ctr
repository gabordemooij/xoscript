Server init.
Zotuluka lembani: ['Database time test'], mzere-watsopano.

>> db := Maria-DB chatsopano wolandira: ['localhost'],
	dzina-la-wogwiritsa: ['xo'], 
	mawu-achinsinsi: ['pass123'],
	dzina-la-nkhokwe-ya-deta: ['xobase'],
	lumikizana.

>> zofufuzira :=
db funso: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
tenga: { :row
	Zotuluka lembani: row timetest, mzere-watsopano.
}.
