>> usedMemory3 := (Pulogalamu kukumbukira ? 0).




x := 3.
y := ['Hello'].
q := { ['']. }.
p := Zoona.
a := Mndandanda ← 1 ; 2 ; 3 ; 5.
c := Chinthu chatsopano.
c chikafika: ['greet:'] chitani: { Zotuluka lembani: ['greet!']. }.
c := Chinthu chatsopano.
c chikafika: ['greet:'] chitani: { Zotuluka lembani: ['a different greet!'], mzere-watsopano. }.


Pulogalamu yeretsa.
>> usedMemory4 := (Pulogalamu kukumbukira ? 0).





x := 4.
y := ['Hello'].
q := { ['']. }.
p := Zoona.
