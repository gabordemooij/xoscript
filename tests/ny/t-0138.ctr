c := Chinthu chatsopano.
c chikafika: ['greet:'] chitani: { Zotuluka lembani: ['greet!']. }.


Pulogalamu yeretsa.
>> usedMemory5 := (Pulogalamu kukumbukira ? 0).




(usedMemory1 = usedMemory2 = usedMemory3 = usedMemory4 = usedMemory5) zoona: { 
	Zotuluka lembani: ['Memory usage remains stable.'], mzere-watsopano.
}, ngati-ayi: {
	Zotuluka lembani: ['Used memory not stable.'], mzere-watsopano.
}.
