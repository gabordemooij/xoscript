>> Greeter := Chinthu chatsopano.
Greeter chikafika: ['make'] chitani: {
	>> gr := Chinthu chatsopano.
	gr chikafika: ['setName:'] chitani: { :aname
		zake dzina := aname.
	}.
	gr chikafika: ['greet'] chitani: {
		Zotuluka lembani: zake dzina.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a chatsopano.
c setName: ['THREE'].
c greet.
>> d := a chatsopano.
d setName: ['FOUR'].
d greet.
c greet.
