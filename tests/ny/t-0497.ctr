Server init.

# write a test file
>> f := Fayilo chatsopano: ['/tmp/test.gif'].
f lembani: ['GIF87a01234567810'].

# serve the file
Server pititsa: ['test.gif'] choyambirira: ['/tmp/'].

Zotuluka mzere-watsopano.

Zotuluka lembani: ['Outside container (security):'], mzere-watsopano.
{ Server pititsa: ['../passwd'] choyambirira: ['/tmp/']. }
gwira: { :e Zotuluka lembani: e, mzere-watsopano. },
yamba.

Zotuluka lembani: ['Invalid prefix:'], mzere-watsopano.
{ Server pititsa: ['test.gif'] choyambirira: ['z:\\']. }
gwira: { :e Zotuluka lembani: e, mzere-watsopano. },
yamba.

Zotuluka lembani: ['Non-existant file:'], mzere-watsopano.
{ Server pititsa: ['xxx.xxx'] choyambirira: ['/tmp/']. }
gwira: { :e Zotuluka lembani: e, mzere-watsopano. },
yamba.
