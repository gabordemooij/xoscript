['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Zotuluka lembani: (x + y), mzere-watsopano.

>> x := 10040.07.
>> y := 10305.60.

Zotuluka lembani: (x + y), mzere-watsopano.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Zotuluka lembani: (x + y + z), mzere-watsopano.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Zotuluka lembani: (x + y + z), mzere-watsopano.

>> q := 0.1.2.

Zotuluka lembani: (q), mzere-watsopano.

>> q := 012.

Zotuluka lembani: (q), mzere-watsopano.
