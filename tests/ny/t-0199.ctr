
Pulogalamu kasamalidwe-ka-kukumbukira: 4.

>> Animal := Chinthu chatsopano.
Animal chikafika: ['make'] chitani: {
	>> animal := Chinthu chatsopano.
	animal chikafika: ['makeSound'] chitani: {
		Zotuluka lembani: zake sound.
	}. <- animal.
}.
>> Cat := Chinthu chatsopano.
Cat chikafika: ['make'] chitani: {
	>> cat := Animal make.
	cat chikafika: ['init'] chitani: {
		zake sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
