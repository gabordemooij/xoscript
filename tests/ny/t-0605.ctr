>> invoice := Chinthu chatsopano.
invoice chikafika: ['yamba'] chitani: {
        zake nambala := 0.
}.

invoice chikafika: ['nambala'] chitani: {
        zake nambala onjezani: 1. <- zake nambala koperani.
}.

>> year-invoice := invoice chatsopano.
year-invoice chikafika: ['start:'] chitani: { :chaka
	zake nambala := chaka.
}.

year-invoice start: 202000.
Zotuluka lembani: year-invoice nambala, mzere-watsopano.
Zotuluka lembani: year-invoice nambala, mzere-watsopano.
