#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Pulogalamu kasamalidwe-ka-kukumbukira: 0.

{
Nthawi-yeniyeni nthawi.
Nthawi-yeniyeni dikira: 1.
Zotuluka lembani: Pulogalamu chiwerengero-cha-zolowetsa, mzere-watsopano.
Pulogalamu cholowetsa: 0.
Nambala random.
Zotuluka lembani: (Pulogalamu dongosolo-la-makina: ['echo 'Hello'']).
} yamba.

Pulogalamu yeretsa.
usedMemory1 := (Pulogalamu kukumbukira ? 0).

{
Nthawi-yeniyeni nthawi.
Nthawi-yeniyeni dikira: 1.
Zotuluka lembani: Pulogalamu chiwerengero-cha-zolowetsa, mzere-watsopano.
Pulogalamu cholowetsa: 0.
Nambala random.
Zotuluka lembani: (Pulogalamu dongosolo-la-makina: ['echo 'Hello'']).
} yamba.

Pulogalamu yeretsa.
usedMemory2 := (Pulogalamu kukumbukira ? 0).

{
Nthawi-yeniyeni nthawi.
Nthawi-yeniyeni dikira: 1.
Zotuluka lembani: Pulogalamu chiwerengero-cha-zolowetsa, mzere-watsopano.
Pulogalamu cholowetsa: 0.
Nambala random.
Zotuluka lembani: (Pulogalamu dongosolo-la-makina: ['echo 'Hello'']).
} yamba.

Pulogalamu yeretsa.
usedMemory3 := (Pulogalamu kukumbukira ? 0).



( usedMemory1 = usedMemory2 ndi: usedMemory1 = usedMemory3, ndi: usedMemory2 = usedMemory3 ) zoona: {
	Zotuluka lembani: ['No memory leaks here'].
}, zabodza: {
	Zotuluka lembani: ['Leaking memory...'].
}.
