



>> CoffeeGrounds := Chinthu chatsopano.
CoffeeGrounds chikafika: ['extract'] chitani: { <- ['coffee']. }.

>> CoffeeMachine := Chinthu chatsopano.
CoffeeMachine chikafika: ['init'] chitani: {
	zake coffeegrounds := CoffeeGrounds chatsopano.
}.
CoffeeMachine chikafika: ['chatsopano'] chitani: { <- CoffeeMachine `new init.
}.

CoffeeMachine chikafika: ['makeTea'] chitani: { <- (zake tealeaves extract). }.
CoffeeMachine chikafika: ['makeCoffee'] chitani: { <- (zake coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine chatsopano.

Zotuluka lembani:
	coffeeDream 
	makeCoffee.

Zotuluka lembani:
	coffeeDream 
	makeTea.
