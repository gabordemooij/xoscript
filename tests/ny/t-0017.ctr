Nambala chikafika: ['factorial'] chitani: {
	>> total := 1.
	{ :index total chulukitsani-ndi: (wekha - (index)). } × wekha. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Zotuluka lembani: a.
>> b := 2 + 3 factorial.
Zotuluka lembani: b.
>> c := 3 factorial + 2.
Zotuluka lembani: c.
>> d := 2 + (3 factorial).
Zotuluka lembani: d.
Zotuluka lembani: 2 + 3 factorial + 1.
