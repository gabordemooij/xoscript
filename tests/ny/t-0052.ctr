>> items := Mtanthauziramawu chatsopano.
items ikani: ['green'] pa: ['color-1'].
items ikani: ['orange'] pa: ['color-2'].
items ikani: ['red'] pa: ['color-3'].
>> i := 0.
>> s := [''].
items chilichonse: { :key :color
	Zotuluka lembani: ['color #'] + i + [' is: '] + color + [' '].
	i onjezani: 1.
}.
Zotuluka lembani: i + [' colors!'].
