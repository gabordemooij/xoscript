# catch-all test (practical)
>> HTML := Malemba chatsopano.
HTML chikafika: ['encode:'] chitani: { :tekst
	wekha onjeza-kumapeto: (tekst
	sinthani: ['&'] ndi: ['&amp;'], 
	sinthani: ['<'] ndi: ['&lt;'],
	sinthani: ['>'] ndi: ['&gt;'],
	sinthani: ['"'] ndi: ['&quot;']).
}.
>> blog := HTML chatsopano.
blog onjeza-kumapeto: ['<h1>'],
     encode: ['Koffie & Thee'],
     onjeza-kumapeto: ['</h1>'].
Zotuluka lembani: blog, mzere-watsopano.


>> Roman := Nambala chatsopano.
Roman chikafika: ['stringy'] chitani: {
	>> a := [''].
	{ a onjeza-kumapeto: ['I']. } × wekha. <- a.
}.

>> x := Roman chatsopano.
x onjezani: 3.
Zotuluka lembani: x stringy, mzere-watsopano.

>> Quantum := Buliyani chatsopano.
Quantum chikafika: ['true?'] chitani: { <- ['maybe True']. }.
Zotuluka lembani: (Quantum chatsopano true?), mzere-watsopano.

>> Nihil := Palibe chatsopano.
Nihil chikafika: ['malemba-a-mawu'] chitani: { <- ['Nihil']. }.
Zotuluka lembani: (Nihil chatsopano), mzere-watsopano.
