


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Pulogalamu kasamalidwe-ka-kukumbukira: 0.
>> palette := Palibe.
>> colors := Palibe.

{
palette := Mtanthauziramawu chatsopano.
palette 
	ikani: ['#F00'] pa: ['red'],
	ikani: ['#0F0'] pa: ['green'],
	ikani: ['#00F'] pa: ['blue'].
Zotuluka lembani: ['number of RGB codes in palette: '] + ( palette chiwerengero-cha-zinthu ), mzere-watsopano.
Zotuluka lembani: ['RGB code of green is: '] + ( palette ? ['green'] ), mzere-watsopano.
colors := [''].
( palette chilichonse: { :dzina :khodi
		colors := colors + ( dzina + [':'] + khodi ).
} ).
Zotuluka lembani: ['All colors in palette: '] + colors, mzere-watsopano.
} yamba.
Pulogalamu yeretsa.
usedMemory1 := (Pulogalamu kukumbukira ? 0).

{
palette := Mtanthauziramawu chatsopano.
palette 
	ikani: ['#F00'] pa: ['red'],
	ikani: ['#0F0'] pa: ['green'],
	ikani: ['#00F'] pa: ['blue'].
Zotuluka lembani: ['number of RGB codes in palette: '] + ( palette chiwerengero-cha-zinthu ), mzere-watsopano.
Zotuluka lembani: ['RGB code of green is: '] + ( palette ? ['green'] ), mzere-watsopano.
colors := [''].
( palette chilichonse: { :dzina :khodi
		colors := colors + ( dzina + [':'] + khodi ).
} ).
Zotuluka lembani: ['All colors in palette: '] + colors, mzere-watsopano.
} yamba.
Pulogalamu yeretsa.
usedMemory2 := (Pulogalamu kukumbukira ? 0).

