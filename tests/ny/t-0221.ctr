>> x := Chinthu chatsopano.
>> y := Chinthu chatsopano.
>> z := x.
Zotuluka lembani: (x = z), mzere-watsopano.
Zotuluka lembani: (x = y), mzere-watsopano.
Zotuluka lembani: (x ≠ y), mzere-watsopano.
Zotuluka lembani: (x ≠ z), mzere-watsopano.
>> m := Nthawi-yeniyeni chatsopano chaka: 2070, mwezi: 11.
>> n := m koperani.
Zotuluka lembani: (m = n), mzere-watsopano.
Zotuluka lembani: (m ≠ n), mzere-watsopano.
Zotuluka lembani: (m chimodzimodzi: m), mzere-watsopano.
Zotuluka lembani: (m chimodzimodzi: n), mzere-watsopano.
n mwezi: 12.
Zotuluka lembani: (m ≠ n), mzere-watsopano.
Zotuluka lembani: (m = n), mzere-watsopano.


