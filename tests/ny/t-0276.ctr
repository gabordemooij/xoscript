>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Chinthu chatsopano.
⚄ chikafika: ['drawFrom:length:'] chitani: { :pool :chiwerengero-cha-zinthu
	
	>> result := [''].
	
	{
		>> index := Nambala random % (pool kutalika).
		result onjeza-kumapeto: ( pool chilembo: (index + 1) ).
		
	} × chiwerengero-cha-zinthu. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? kutalika.
Zotuluka lembani: (['x↵'] x random kutalika).
Zotuluka lembani: (['y↵'] y ?? kutalika).

