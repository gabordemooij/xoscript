

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Pulogalamu kasamalidwe-ka-kukumbukira: 0.

>> txt := ['Word Salad'].
Zotuluka lembani: ['last index of ord = '] + (( txt malo-omaliza: ['ord'] ) - 0), mzere-watsopano.
Zotuluka lembani: ['index of ord = '] + (( txt pezani: ['ord'] ) - 0), mzere-watsopano.
Zotuluka lembani: ['index of ad = '] + (( txt pezani: ['ad'] ) - 0), mzere-watsopano.
Zotuluka lembani: ['last index of W = '] + (( txt malo-omaliza: ['W'] ) - 0), mzere-watsopano.
Zotuluka lembani: ['last index of d = '] + (( txt malo-omaliza: ['d'] ) - 0), mzere-watsopano.
Zotuluka lembani: ['txt equals Word Salad = '] + ( txt = ['Word Salad'] ), mzere-watsopano.
Zotuluka lembani: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), mzere-watsopano.
Zotuluka lembani: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), mzere-watsopano.
Zotuluka lembani: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), mzere-watsopano.

Pulogalamu yeretsa.

