Server init.
Zotuluka lembani: ['Database date test'], mzere-watsopano.

>> db := Maria-DB chatsopano wolandira: ['localhost'],
	dzina-la-wogwiritsa: ['xo'], 
	mawu-achinsinsi: ['pass123'],
	dzina-la-nkhokwe-ya-deta: ['xobase'],
	lumikizana.

>> zofufuzira :=
db funso: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
tenga: { :row
	Zotuluka lembani: row datetest, mzere-watsopano.
}.
