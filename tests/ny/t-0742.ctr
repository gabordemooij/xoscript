Zotuluka lembani: ['Test object'], mzere-watsopano.
>> a := Chinthu chatsopano. 

a chikafika: ['item:'] chitani: { :hexhelper
	zake hexhelper := hexhelper. 
}.

a chikafika: ['item'] chitani: { <- zake hexhelper.
}.

a item: Hx chatsopano.

>> old-hexhelper-address := a item chitsanzo-choyamba adilesi-ya-kukumbukira.
a save-as: ['/tmp/a.bin'].
Zotuluka lembani: ['========== RELOADING SNAP:'], mzere-watsopano.

>> b := Chinthu load-from: ['/tmp/a.bin'].

(b item chitsanzo-choyamba adilesi-ya-kukumbukira = old-hexhelper-address) zoona: {
	Zotuluka lembani: ['Object link re-attached.'], mzere-watsopano.
}.
