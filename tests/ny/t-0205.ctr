>> str := ['write:'].
Zotuluka uthenga: ['lembani:'] zolowetsa: (Mndandanda ← ['Hello World']), mzere-watsopano. 

Nambala chikafika: ['isbetween:and:'] chitani: { :a :b <- ((wekha ≥ a) ndi: (wekha ≤ b)).
}.

str := ['isbetween:and:'].
Zotuluka lembani: (3 uthenga: str zolowetsa: (Mndandanda ← 2 ; 8)), mzere-watsopano.
Zotuluka lembani: (3 uthenga: str zolowetsa: (Mndandanda ← 1 ; 2)), mzere-watsopano.


>> CoffeeMachine := Chinthu chatsopano.
CoffeeMachine chikafika: ['makeCoffeeWithSugar:milk:'] chitani: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Mndandanda ← 4 ; 2.
Zotuluka lembani: ( CoffeeMachine uthenga: order zolowetsa: coffeeConfiguration ), mzere-watsopano.
