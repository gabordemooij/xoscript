
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> khodi := {
	>> o := (
		Mtanthauziramawu chatsopano
		aa: (Mndandanda ← 1 ; 2),
		bb: (Mndandanda ← 3 ; 4)
	).
	>> s := o malemba-a-mawu.
	>> o2 := s chinthu.
	(s  mtundu = Malemba mtundu) zoona: { Zotuluka lembani: ['OK1'], mzere-watsopano. }.
	(o2 mtundu = Mtanthauziramawu mtundu) zoona: { Zotuluka lembani: ['OK2'], mzere-watsopano. }.
}.

Pulogalamu kasamalidwe-ka-kukumbukira: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Pulogalamu yeretsa.
usedMemory1 := (Pulogalamu kukumbukira ? 1).
khodi yamba.
Pulogalamu yeretsa.
usedMemory2 := (Pulogalamu kukumbukira ? 1).
khodi yamba.
Pulogalamu yeretsa.
usedMemory3 := (Pulogalamu kukumbukira ? 1).
khodi yamba.
Pulogalamu yeretsa.
usedMemory4 := (Pulogalamu kukumbukira ? 1).

(usedMemory2 = usedMemory3 = usedMemory4) zoona: { Zotuluka lembani: ['OK3'], mzere-watsopano. }.
 
