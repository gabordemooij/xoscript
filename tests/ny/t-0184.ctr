

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Pulogalamu kasamalidwe-ka-kukumbukira: 0.

Nambala chikafika: ['addNum:'] chitani: { :x
	wekha onjezani: x.
}.

Nambala chikafika: ['subtractNum:'] chitani: { :x
	wekha chotsa: x.
}.

Nambala chikafika: ['multiplyBy:'] chitani: { :x
	wekha chulukitsani-ndi: x.
}.

Nambala chikafika: ['divideBy:'] chitani: { :x
	wekha gawani-ndi: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 mphamvu-ya-nambala: 8).  
a := a + (2 mphamvu-ya-nambala: -1). 
a := a + (49 muzu-wa-sikweya).   
a addNum: ((Mndandanda ← 0 ; 1) chachikulu-kwambiri).          
a addNum: ((Mndandanda ← 2 ; 3) chochepa-kwambiri).
Zotuluka lembani: a.

Pulogalamu yeretsa.

usedMemory1 := (Pulogalamu kukumbukira ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 mphamvu-ya-nambala: 8).  
a := a + (2 mphamvu-ya-nambala: -1). 
a := a + (49 muzu-wa-sikweya).   
a addNum: ((Mndandanda ← 0 ; 1) chachikulu-kwambiri).          
a addNum: ((Mndandanda ← 2 ; 3) chochepa-kwambiri).
Zotuluka lembani: a.

Pulogalamu yeretsa.
usedMemory2 := (Pulogalamu kukumbukira ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 mphamvu-ya-nambala: 8).  
a := a + (2 mphamvu-ya-nambala: -1). 
a := a + (49 muzu-wa-sikweya).   
a addNum: ((Mndandanda ← 0 ; 1) chachikulu-kwambiri).          
a addNum: ((Mndandanda ← 2 ; 3) chochepa-kwambiri).
Zotuluka lembani: a.

Pulogalamu yeretsa.
usedMemory3 := (Pulogalamu kukumbukira ? 0).



( usedMemory1 = usedMemory2 ndi: usedMemory1 = usedMemory3, ndi: usedMemory2 = usedMemory3 ) zoona: {
	Zotuluka lembani: ['No memory leaks here'].
}, zabodza: {
	Zotuluka lembani: ['Leaking memory...'].
}.
