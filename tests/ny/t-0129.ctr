
Mndandanda chikafika: ['product'] chitani: {
	>> total := 1.
	wekha chilichonse: { :index :element
		total chulukitsani-ndi: element.
	}. <- total.
}.

>> a := Mndandanda ← 1 ; 2 ; 3.
Zotuluka lembani: a product, mzere-watsopano.
Zotuluka lembani: (Mndandanda ← 2 ; 4 ; 8) product, mzere-watsopano. 
Zotuluka lembani: (Mndandanda ← -2 ; 10) product, mzere-watsopano. 
Zotuluka lembani: (Mndandanda ← 0.5 ; -2) product, mzere-watsopano. 
