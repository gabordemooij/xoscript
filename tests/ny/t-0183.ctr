

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Pulogalamu kasamalidwe-ka-kukumbukira: 0.

>> o := Chinthu chatsopano.
>> o2 := Chinthu chatsopano.
Zotuluka lembani: o Palibe?, mzere-watsopano.
Zotuluka lembani: o mtundu, mzere-watsopano.
Zotuluka lembani: ( o chimodzimodzi: o ), mzere-watsopano.
Zotuluka lembani: ( o chimodzimodzi: o2 ), mzere-watsopano.
Zotuluka lembani: o ine-ndekha, mzere-watsopano.
Zotuluka lembani: ( o chitani zatheka ), mzere-watsopano.

Pulogalamu yeretsa.

usedMemory1 := (Pulogalamu kukumbukira ? 0).


o := Chinthu chatsopano.
o2 := Chinthu chatsopano.
Zotuluka lembani: o Palibe?, mzere-watsopano.
Zotuluka lembani: o mtundu, mzere-watsopano.
