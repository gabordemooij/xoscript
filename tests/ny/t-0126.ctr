#Linux
>> Slurp := Chinthu chatsopano.

Slurp chikafika: ['chatsopano'] chitani: {
	zake str := [''].
}.

Slurp chikafika: ['nieuw'] chitani: {
	zake str := [''].
}.

Slurp chikafika: ['yankha:'] chitani: { :blah
		zake str onjeza-kumapeto: blah.
}.

Slurp chikafika: ['yankha:ndi:'] chitani: { :blah :blahah
		zake str onjeza-kumapeto: (blah kuchokera: 0 kutalika: (blah kutalika - 1)).
		zake str onjeza-kumapeto: [' '].
		zake str onjeza-kumapeto: blahah.
}.

Slurp chikafika: ['obtain'] chitani: {
	>> buffer := zake str.
	zake str := ['']. <- buffer.
}.


Zotuluka lembani: (Pulogalamu dongosolo-la-makina: (Slurp chatsopano echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Fayilo chatsopano: ['/tmp/from.txt'], chotsani. } gwira: { ['Empty']. }, yamba.
{ Fayilo chatsopano: ['/tmp/to.txt'], chotsani. } gwira: { ['Empty']. }, yamba.


Fayilo chatsopano: ['/tmp/to.txt'], lilipo zabodza: {
	Zotuluka lembani: ['Confirmed. Target file does not exist.\
'].
}.
Fayilo chatsopano: ['/tmp/from.txt'], lilipo zabodza: {
	Zotuluka lembani: ['Confirmed. Source file does not exist.\
'].
}.



Pulogalamu dongosolo-la-makina: (Slurp chatsopano touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Pulogalamu dongosolo-la-makina: (Slurp chatsopano cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Fayilo chatsopano: ['/tmp/to.txt'], lilipo zoona: {
	Zotuluka lembani: ['Confirmed. Target file has been created by shell.\
'].
}.


Zotuluka lembani: ['Contents of file is:'] + (Fayilo chatsopano: ['/tmp/to.txt'], werengani), mzere-watsopano.
