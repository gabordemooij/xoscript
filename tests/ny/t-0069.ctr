

Malemba chikafika: ['html'] chitani: { <- (
		wekha
		sinthani: ['&'] ndi: ['&amp;'],
		sinthani: ['<'] ndi: ['&lt;'],
		sinthani: ['>'] ndi: ['&gt;'],
		sinthani: ['"'] ndi: ['&quot;']
	).
}.


Zotuluka lembani: ([' left trimmed '] dula-mipata) + [' '] + ( ['and right trimmed'] dula-mipata) + ['!'], mzere-watsopano.
Zotuluka lembani: ['<html>"html & entities"</html>'] html.
