>> a := ['hello world'].
>> b := [''].
a zilembo chilichonse: { :i :x
	
	x
	ngati-zili-choncho: ['e'] chitani: { x := ['*']. },
	ngati-zili-choncho: ['r'] chitani: { x := ['*']. },
	ngati-zili-choncho: ['l'] chitani: { x := ['*']. }.
	
	b onjeza-kumapeto: x.
	
}.
Zotuluka lembani: b, mzere-watsopano.


