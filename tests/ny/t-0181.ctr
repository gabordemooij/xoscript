

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Pulogalamu kasamalidwe-ka-kukumbukira: 0.

>> txt := ['World Salad'].
Zotuluka lembani: ['this text contains: '] + ( ( txt gawa: [' '] ) chiwerengero-cha-zinthu ) + [' words.'], mzere-watsopano.
txt := txt kuchokera: 6 kutalika: 4.
Zotuluka lembani: txt, mzere-watsopano.

Pulogalamu yeretsa.

usedMemory1 := (Pulogalamu kukumbukira ? 0).


