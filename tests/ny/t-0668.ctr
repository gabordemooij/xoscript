# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob chatsopano: 8, bytes: (
	Mndandanda chatsopano ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Zotuluka lembani: ( utf16 chotsa-khodi: ['utf16le'] ), mzere-watsopano.

utf16 masula.
>> utf32 := Blob chatsopano: 13, bytes: (
	Mndandanda chatsopano ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Zotuluka lembani: ( utf32 chotsa-khodi: ['utf32be'] ), mzere-watsopano.
utf32 masula.