Server init.

>> x := Blob chatsopano: 65 mtundu: ['char'].
# for this test you need set a path to libc (puts)
>> libname := Pulogalamu kakhazikitsidwe: ['FFITESTLIB'].
Server lumikizana-ndi: (
 Mndandanda chatsopano ;
 libname ;
 ['putchar'] ;
 ( Mndandanda chatsopano ; ['char'] ) ;
 ['void'] ;
 ['Print'] ;
 ['char:']
).
Print char: (x kuchokera: 0 kutalika: 1), mzere-watsopano.
x masula.

