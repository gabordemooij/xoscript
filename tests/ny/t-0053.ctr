60 × {
	>> x := (Nambala random % 6) + 1.
	(x ≤ 6) zabodza: { Zotuluka lembani: ['FAIL']. }.
	(x ≥0) zabodza: { Zotuluka lembani: ['FAIL']. }.
	x := (Nambala random % 3) + 1.
	(x < 3) zabodza: { Zotuluka lembani: ['FAIL']. }.
	(x>-1) zabodza: { Zotuluka lembani: ['FAIL']. }.
	x := ((Buliyani flip) nambala).
	(x = 0 kapena: x = 1) zabodza: { Zotuluka lembani: ['FAIL']. }.
	x := ((Zoona flip) nambala).
	(x = 0 kapena: x = 1) zabodza: { Zotuluka lembani: ['FAIL']. }.
	x := (Buliyani flip ichi: ['HEAD'] kapena-icho: ['TAIL']).
	((x = ['HEAD']) kapena: (x = ['TAIL'])) zabodza: { Zotuluka lembani: ['FAIL']. }.
}.
Zotuluka lembani: ['DONE'].

