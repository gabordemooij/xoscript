
Zotuluka lembani: ['Break for-loop, 0-4.'], mzere-watsopano.
{ :i
	Zotuluka lembani: ['iteration #'] + i, mzere-watsopano.
	(i = 4) dula.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Zotuluka lembani: ['Break while-true loop, 0-4.'], mzere-watsopano.
{
	Zotuluka lembani: ['iteration #'] + x, mzere-watsopano.
	x onjezani: 1.
	((x < 5) ayi) dula.
} bola-ngati: xIsLessThan10.

Zotuluka lembani: ['Break while-false loop, 5,4.'], mzere-watsopano.
{
	Zotuluka lembani: ['iteration #'] + x, mzere-watsopano.
	x chotsa: 1.
	(x = 3) dula.
} bola-ngati: { <- (x > 0). }.

Zotuluka lembani: ['Break times loop, 1-4.'], mzere-watsopano.
{ :i
	Zotuluka lembani: ['iteration #'] + i, mzere-watsopano.
	(i = 4) dula.
} × 5.

Zotuluka lembani: ['Break block, dont print line.'], mzere-watsopano.
{ Zoona dula. Zotuluka lembani: ['dont write this!'], mzere-watsopano. } yamba.

Zotuluka lembani: ['Break block, dont fire catch...'], mzere-watsopano.
{ Zoona dula. Zotuluka lembani: ['dont write this!'], mzere-watsopano. } gwira: { Zotuluka lembani: ['Dont catch this!']. }, yamba.

Zotuluka lembani: ['Test Array each-loop: 0,1'], mzere-watsopano.
(Mndandanda ← 1 ; 2 ; 3) sintha-chilichonse: { :i
	Zotuluka lembani: ['iteration #'] + i, mzere-watsopano.
	(i = 1) dula.
}.

Zotuluka lembani: ['Test Map each-loop: c only'], mzere-watsopano.
>> m := Mtanthauziramawu chatsopano.
m ikani: ['first'] pa: ['a'], ikani: ['second'] pa: ['b'], ikani: ['third'] pa: ['c'].
m chilichonse: { :k :v
	Zotuluka lembani: ['iteration'] + v + k, mzere-watsopano.
	Zoona dula.
}.

