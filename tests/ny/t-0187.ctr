Nambala chikafika: ['factorial'] chitani: {
	>> total := 1.
	{ :index total chulukitsani-ndi: (wekha - index). } × wekha. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Pulogalamu kasamalidwe-ka-kukumbukira: 0.

{
2 exponent factorial.
Zotuluka lembani: (11 chotsala: 3), mzere-watsopano.
Zotuluka lembani: (3.4 yandikitsa-nambala), mzere-watsopano.
Zotuluka lembani: (7.1 kweza-nambala), mzere-watsopano.
Zotuluka lembani: (7.9 tsitsa-nambala), mzere-watsopano.
}
yamba.

Pulogalamu yeretsa.

usedMemory1 := (Pulogalamu kukumbukira ? 0).

{
2 exponent factorial.
Zotuluka lembani: (11 chotsala: 3), mzere-watsopano.
Zotuluka lembani: (3.4 yandikitsa-nambala), mzere-watsopano.
Zotuluka lembani: (7.1 kweza-nambala), mzere-watsopano.
Zotuluka lembani: (7.9 tsitsa-nambala), mzere-watsopano.
}
yamba.

Pulogalamu yeretsa.
usedMemory2 := (Pulogalamu kukumbukira ? 0).


{
2 exponent factorial.
Zotuluka lembani: (11 chotsala: 3), mzere-watsopano.
Zotuluka lembani: (3.4 yandikitsa-nambala), mzere-watsopano.
Zotuluka lembani: (7.1 kweza-nambala), mzere-watsopano.
Zotuluka lembani: (7.9 tsitsa-nambala), mzere-watsopano.
} yamba.

Pulogalamu yeretsa.
usedMemory3 := (Pulogalamu kukumbukira ? 0).



( usedMemory1 = usedMemory2 ndi: usedMemory1 = usedMemory3, ndi: usedMemory2 = usedMemory3 ) zoona: {
	Zotuluka lembani: ['No memory leaks here'].
}, zabodza: {
	Zotuluka lembani: ['Leaking memory...'].
}.
