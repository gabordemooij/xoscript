# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Nkhokwe-yotetezedwa 
	hash-ya-mawu-achinsinsi: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Nkhokwe-yotetezedwa 
	hash-ya-mawu-achinsinsi: hash tsimikizira: a1.
	# fail 
>> b := Nkhokwe-yotetezedwa
	hash-ya-mawu-achinsinsi: hash tsimikizira: a2.
	# ok!

Zotuluka lembani: a, mzere-watsopano.
Zotuluka lembani: b, mzere-watsopano.

