Mndandanda chikafika: ['koperani'] chitani: {
	>> koperani := Mndandanda chatsopano.
	wekha chilichonse: { :nambala :section
		koperani onjeza-kumapeto: section kudziyitana koperani.
	}. <- koperani.
}.

>> sheep := Mndandanda chatsopano ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep koperani.
clones chilichonse: { :nambala :sheep
	sheep onjeza-kumapeto: ['2'].
}.

Zotuluka lembani: sheep, mzere-watsopano.
Zotuluka lembani: clones, mzere-watsopano.
