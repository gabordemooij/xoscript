>> map1 := Mtanthauziramawu chatsopano.
>> key1 := Mndandanda chatsopano.
>> key2 := Mndandanda chatsopano.

map1
	ikani: ['hello'] pa: key1,
	ikani: ['world'] pa: key2.


Zotuluka
	lembani: ['Map #1 contains: '] + (map1 pamalo: key1),
	lembani: [' and '] + (map1 pamalo: key2), mzere-watsopano.

>> KeyeableArray := Mndandanda chatsopano.
KeyeableArray chikafika: ['toString'] chitani: { <- (wekha chiwerengero-cha-zinthu) toString.
}.

>> map2 := Mtanthauziramawu chatsopano.
key1 := KeyeableArray chatsopano.
key2 := KeyeableArray chatsopano.

key1 onjeza-kumapeto: 1.

map2
	ikani: ['hello'] pa: key1,
	ikani: ['world'] pa: key2.

Zotuluka
	lembani: ['Map #2 contains: '] + (map2 pamalo: key1),
	lembani: [' and '] + (map2 pamalo: key2), mzere-watsopano.
