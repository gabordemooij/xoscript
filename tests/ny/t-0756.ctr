Zotuluka lembani: ['Test object'], mzere-watsopano.
>> greeter := Chinthu chatsopano.
greeter chikafika: ['name:'] chitani: { :dzina
	zake xname := dzina. 
}.
greeter chikafika: ['greet'] chitani: {
	Zotuluka lembani: ['Hello '] + zake xname, mzere-watsopano.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Zotuluka lembani: ['========== RELOADING SNAP:'], mzere-watsopano.
>> b := Chinthu load-from: ['/tmp/a.bin'].
>> c := Chinthu load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
