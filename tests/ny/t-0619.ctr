>> HTML := Chinthu chatsopano.
HTML chikafika: ['yankha:'] chitani: { :tag 
	Zotuluka lembani: (['<tag>'] tag: tag), mzere-watsopano.
}.
HTML chikafika: ['yankha:ndi:'] chitani: { :tag :html 
	Zotuluka lembani: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), mzere-watsopano.
}.
>> html := HTML chatsopano.
html body h1: ['header'].

