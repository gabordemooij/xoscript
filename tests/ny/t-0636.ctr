# test url parsing

Server init.
>> url := URL gwero: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Zotuluka lembani: ['scheme = '] + url ndondomeko-ya-adilesi, mzere-watsopano.
Zotuluka lembani: ['host = '] + url wolandira, mzere-watsopano.
Zotuluka lembani: ['port = '] + url doko, mzere-watsopano.
Zotuluka lembani: ['path = '] + url njira-ya-fayilo, mzere-watsopano.
Zotuluka lembani: ['query = '] + url zofufuzira, mzere-watsopano.
Zotuluka lembani: ['fragment = '] + url chidutswa, mzere-watsopano.
