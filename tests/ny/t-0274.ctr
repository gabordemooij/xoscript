

Mndandanda chikafika: ['column:'] chitani: { :column
	>> result := Mndandanda chatsopano.
	wekha chilichonse: { :index :row
		row chilichonse: { :index :cell
			(index = column) zoona: { result onjeza-kumapeto: cell. }.
		}.
	}. <- result.
}.


>> a := Mndandanda ←
	(Mndandanda ← 1 ; 2 ; 3) ;
	(Mndandanda ← 4 ; 5 ; 6) ;
	(Mndandanda ← 7 ; 8 ; 9).

>> b := a column: 1.
Zotuluka lembani: b, mzere-watsopano.

b := a column: 20.
Zotuluka lembani: b, mzere-watsopano.

b := a column: -100.
Zotuluka lembani: b, mzere-watsopano.
