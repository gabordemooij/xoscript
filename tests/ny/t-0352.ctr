Nambala chikafika: ['roman'] chitani: {
	>> nambala := wekha koperani.
	>> roman := [''].
	{
		{
			(nambala ≥ 1000) zoona: {
				roman onjeza-kumapeto: ['Ⅿ'].
				nambala chotsa: 1000.
			}, dula.
		
			(nambala ≥ 500) zoona: {
				roman onjeza-kumapeto: ['Ⅾ'].
				nambala chotsa: 500.
			}, dula.
		
			(nambala ≥ 100) zoona: {
				roman onjeza-kumapeto: ['Ⅽ'].
				nambala chotsa: 100.
			}, dula.
		
			(nambala ≥ 50) zoona: {
				roman onjeza-kumapeto: ['Ⅼ'].
				nambala chotsa: 50.
			}, dula.
		
			(nambala ≥ 50) zoona: {
				roman onjeza-kumapeto: ['Ⅼ'].
				nambala chotsa: 50.
			}, dula.
		
			(nambala ≥ 10) zoona: {
				roman onjeza-kumapeto: ['Ⅹ'].
				nambala chotsa: 10.
			}, dula.
			
			(nambala ≥ 9) zoona: {
				roman onjeza-kumapeto: ['Ⅸ'].
				nambala chotsa: 9.
			}, dula.
			
			(nambala ≥ 5) zoona: {
				roman onjeza-kumapeto: ['Ⅴ'].
				nambala chotsa: 5.
			}, dula.
			
			(nambala ≥ 4) zoona: {
				roman onjeza-kumapeto: ['Ⅳ'].
				nambala chotsa: 4.
			}, dula.
			
			(nambala ≥ 1) zoona: {
				roman onjeza-kumapeto: ['Ⅰ'].
				nambala chotsa: 1.
			}, dula.
		} machitidwe.
	} bola-ngati: { <- nambala > 0. }. <- roman.
}.

Zotuluka lembani: 1 roman, mzere-watsopano.
Zotuluka lembani: 2 roman, mzere-watsopano.
Zotuluka lembani: 4 roman, mzere-watsopano.
Zotuluka lembani: 8 roman, mzere-watsopano.
Zotuluka lembani: 16 roman, mzere-watsopano.
Zotuluka lembani: 32 roman, mzere-watsopano.
Zotuluka lembani: 64 roman, mzere-watsopano.
Zotuluka lembani: 128 roman, mzere-watsopano.
Zotuluka lembani: 256 roman, mzere-watsopano.
Zotuluka lembani: 1024 roman, mzere-watsopano.
