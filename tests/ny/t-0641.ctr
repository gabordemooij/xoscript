# Test utf8 sanitizer
Server init.

>> utf8cases := Mtanthauziramawu chatsopano
	# ASCII only
	ikani: ( Mndandanda chatsopano ; 65 ; 65 ; 65 ; 65 ; 0 ) pa: ['AAAA'],
	# valid 2 byte sequence
	ikani: ( Mndandanda chatsopano ; 194 ; 162 ; 0 ) pa: ['¢'],
	# Valid 3-byte UTF-8
    ikani: ( Mndandanda chatsopano ; 226 ; 130 ; 172 ; 0 ) pa: ['€'],
	# Valid 4-byte UTF-8
    ikani: ( Mndandanda chatsopano ; 240 ; 144 ; 141 ; 136 ; 0 ) pa: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    ikani: ( Mndandanda chatsopano ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) pa: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    ikani: ( Mndandanda chatsopano ; 65 ; 193 ; 129 ; 0 ) pa: ['A?'],
	# Invalid first byte (0xFF)
    ikani: ( Mndandanda chatsopano ; 255 ; 0 ) pa: ['?'],
	# Incomplete multi-byte sequence at end
    ikani: ( Mndandanda chatsopano ; 66 ; 226 ; 0 ) pa: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    ikani: ( Mndandanda chatsopano ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) pa: ['A€?𐍈B'].
	 
utf8cases chilichonse: { :key :value
	>> blob := Blob chatsopano: value chiwerengero-cha-zinthu, bytes: value.
	>> str := blob malemba-a-mawu.
	(str = key) zoona: {
		Zotuluka lembani: ['OK'], mzere-watsopano.
	}, ngati-ayi: {
		Zotuluka lembani: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, mzere-watsopano.
	}.
	blob masula.
}.
