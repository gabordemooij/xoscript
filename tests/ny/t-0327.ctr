

Mndandanda chikafika: ['fixture:'] chitani: { :f
	zake fixture := f.
}.

Mndandanda chikafika: ['chiwerengero-cha-zinthu'] chitani: { <- zake fixture.
}.

Mndandanda chikafika: ['aantal'] chitani: { <- zake fixture.
}.


>> x := Palibe.
{

	x := ['hello'] 
	sinthani:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] chilembo: 2)
			)
		)
	ndi: (
		(['...hal'] + ['lo']) 
			zilembo-zazikulu 
			lowecase 
			zilembo-zazikulu 
			lumpha: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Mndandanda ← 0 ; 1 ; 4; 9 ; (Mndandanda ← 0 ; 3; 1) ; 4
							) chisanafike-chomaliza
						) ? 1
					) + 
					((Mndandanda ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					chiwerengero-cha-zinthu
				)
			)
	).

} × 10.
Zotuluka lembani: x, mzere-watsopano.

