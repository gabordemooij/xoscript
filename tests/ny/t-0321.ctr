# test qualifiers

Pulogalamu yeretsa.

>> Fruit := Chinthu chatsopano.
Fruit chikafika: ['chatsopano'] chitani: {
	>> f := wekha chatsopano.
	f apples: 0. <- f.
}.
Fruit chikafika: ['apples:'] chitani: { :a zake apples := a. }.
Fruit chikafika: ['apples'] chitani: { <- zake apples. }.
Fruit chikafika: ['+'] chitani: { :f
	>> n := Fruit chatsopano.
	n apples: (f apples + zake apples). <- n.
}.
Nambala chikafika: ['apples'] chitani: { <- ((Fruit chatsopano) apples: wekha).
}.

Fruit chikafika: ['malemba-a-mawu'] chitani: { <- zake apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Zotuluka lembani: q, mzere-watsopano.




q := 3 apples + 4 apples.
Zotuluka lembani: q, mzere-watsopano.



q := 3 apples + 4 apples.
Zotuluka lembani: q, mzere-watsopano.


