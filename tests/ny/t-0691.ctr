Server init.

# returning non-str from match/do should be ok
>> subject := ['abc'].
>> pattern := Chitsanzo-chofufuzira chatsopano: ['([ac])'].
>> result := pattern kufanana: subject chitani: { :m :x
	Zotuluka lembani: m, mzere-watsopano.
	Zotuluka lembani: x, mzere-watsopano. <- Palibe.
}.
Zotuluka lembani: result, mzere-watsopano.