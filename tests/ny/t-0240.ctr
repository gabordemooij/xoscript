# test qualifiers

>> $ := Chinthu chatsopano.

$ chikafika: ['yankha:'] chitani: { :x
	
	>> operation := x chilembo: 0.
	>> valuta := x chilembo: 1.
	>> money := x lumpha: 2.
	
	>> amount := 0.

	( operation = ['+'] ) zoona: {
		( valuta = ['£'] ) zoona: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Zotuluka lembani: x, mzere-watsopano.


>> Fruit := Chinthu chatsopano.

Fruit chikafika: ['chatsopano'] chitani: {
	>> f := wekha chatsopano.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit chikafika: ['apples:'] chitani: { :a zake apples := a. }.
Fruit chikafika: ['oranges:'] chitani: { :p zake oranges := p. }.
Fruit chikafika: ['apples'] chitani: { <- zake apples. }.
Fruit chikafika: ['oranges'] chitani: { <- zake oranges. }.

Fruit chikafika: ['+'] chitani: { :f
	
	>> n := Fruit chatsopano.
	f onjezani: 1.
	
	n apples: (f apples + zake apples).
	n oranges:  (f oranges  + zake oranges). <- n.
}.

Fruit chikafika: ['malemba-a-mawu'] chitani: { <- ( zake apples malemba-a-mawu + [' apples and '] + zake oranges + [' oranges'] ).
}.

Nambala chikafika: ['apples'] chitani: { <- ((Fruit chatsopano) apples: wekha).
}.

Nambala chikafika: ['apple'] chitani: { <- ((Fruit chatsopano) apples: wekha).
}.

Nambala chikafika: ['oranges'] chitani: { <- ((Fruit chatsopano) oranges: wekha).
}.




Zotuluka lembani: (1 apple + 3 oranges + 4 apples), mzere-watsopano.


Malemba chikafika: ['twice'] chitani: { <- ((wekha malemba-a-mawu) + (wekha malemba-a-mawu)).
}.



Zotuluka lembani: ['❤❤❤'] twice.



