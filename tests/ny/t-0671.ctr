# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Nkhokwe-yotetezedwa panga-makiyi.

# private (secret) key
>> sk := keys choyamba.

# public key
>> pk := keys chomaliza.

# sign a message
>> sig := Nkhokwe-yotetezedwa saina: ['abc'] ndi: sk.

# check message (ok)
Zotuluka lembani: ( 
	Nkhokwe-yotetezedwa
		onani: ['abc'] 
		siginecha: sig 
		ndi: pk 
), mzere-watsopano.

# check message (fail)
Zotuluka lembani: ( 
	Nkhokwe-yotetezedwa 
		onani: ['abd'] 
		siginecha: sig 
		ndi: pk 
), mzere-watsopano.