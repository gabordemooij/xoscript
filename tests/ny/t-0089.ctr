>> randomizer := { :a :b
	>> chochepa-kwambiri := ( a < b ) ichi: a kapena-icho: b.
	>> chachikulu-kwambiri := ( a > b ) ichi: a kapena-icho: b.
	>> x := Palibe.
	{
		x := Nambala pakati: a ndi: b.
		((x < chochepa-kwambiri) kapena: (x > chachikulu-kwambiri)) zoona: { 
			Zotuluka lembani: (['Invalid value!']).
			Pulogalamu tsiriza.
		}.
	} 
	× 100. <- x.
}.
randomizer gwiritsa-pa: 0 ndi: 0.
randomizer gwiritsa-pa: 1 ndi: 0.
