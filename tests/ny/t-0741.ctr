Zotuluka lembani: ['Test object'], mzere-watsopano.
>> a := Chinthu chatsopano. 

a chikafika: ['item:'] chitani: { :octhelper
	zake octhelper := octhelper. 
}.

a chikafika: ['item'] chitani: { <- zake octhelper.
}.

a item: Oct chatsopano.

>> old-octhelper-address := a item chitsanzo-choyamba adilesi-ya-kukumbukira.
a save-as: ['/tmp/a.bin'].
Zotuluka lembani: ['========== RELOADING SNAP:'], mzere-watsopano.

>> b := Chinthu load-from: ['/tmp/a.bin'].

(b item chitsanzo-choyamba adilesi-ya-kukumbukira = old-octhelper-address) zoona: {
	Zotuluka lembani: ['Object link re-attached.'], mzere-watsopano.
}.
