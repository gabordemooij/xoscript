Buliyani chikafika: ['xor:'] chitani: { :a :b <- ((a ndi: b ayi) kapena: (a ayi ndi: b)).
}.

>> o := Chinthu chatsopano.
o chikafika: ['hello'] chitani: { ['Empty']. }.
{ o chikafika: 2 chitani: 3.} gwira: { :e Zotuluka lembani: e, mzere-watsopano. }, yamba.
{ o chikafika: ['mayeso'] chitani: 3.} gwira: { :e Zotuluka lembani: e, mzere-watsopano. }, yamba.
{ o chikafika: ['hello'] chitani: { ['Empty']. }.} gwira: { :e Zotuluka lembani: e, mzere-watsopano. }, yamba. 
{ >> z := 4 ÷ 0. } gwira: { :e Zotuluka lembani: e, mzere-watsopano. }, yamba. 
{ (Zoona ndi: Palibe) zoona: { Zotuluka lembani: ['X'].}. } gwira: { :e Zotuluka lembani: e, mzere-watsopano. }, yamba. 
{ ([''] xor: 0) zoona: { Zotuluka lembani: ['X'].}. } gwira: { :e Zotuluka lembani: e, mzere-watsopano. }, yamba. 
{ (1 < ['2']) zoona: { Zotuluka lembani: ['OK']. }. } gwira: { :e Zotuluka lembani: e, mzere-watsopano. }, yamba. 
{ (1 < ['2.0']) zoona: { Zotuluka lembani: ['OK']. }. } gwira: { :e Zotuluka lembani: e, mzere-watsopano. }, yamba. 
{ (1 < ['x2.0']) zoona: { Zotuluka lembani: ['NO!']. }. } gwira: { :e Zotuluka lembani: e, mzere-watsopano. }, yamba. 
{ Zotuluka lembani: (['hello OK there'] kuchokera: ['6'] kutalika: ['2']). } yamba. 
