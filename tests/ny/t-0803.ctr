>> del := conn1 funso: ['DELETE FROM book WHERE id > 0'].
{  del chita-lamulo. conn1 tsimikizira. } gwira: { :e conn1 bwezera-mmbuyo.  }, yamba.

>> insert := conn1 funso: ['INSERT INTO book (id) VALUES(null)'].
insert chita-lamulo.

>> chiwerengero-cha-zinthu := conn1 funso: ['SELECT COUNT(*) AS num FROM book'].
chiwerengero-cha-zinthu tenga: { :row Zotuluka lembani: row num, mzere-watsopano. }.

# does not show up
