

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Pulogalamu kasamalidwe-ka-kukumbukira: 0.

>> txt := ['Word Salad'].
Zotuluka lembani: ( txt koperani kuchokera: 5 kutalika: 5 ).
Zotuluka lembani: ( txt koperani lumpha: 5, dula-mipata ), mzere-watsopano.

Pulogalamu yeretsa.

usedMemory1 := (Pulogalamu kukumbukira ? 0).


