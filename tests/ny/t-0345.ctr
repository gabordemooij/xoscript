# test catch-all methods
>> x13 := Chinthu chatsopano.
x13 chikafika: ['a'] chitani: { :a Zotuluka lembani: 0, mzere-watsopano. }.
x13 chikafika: ['a:'] chitani: { :a Zotuluka lembani: a, mzere-watsopano. <- 5. }.
x13 chikafika: ['a:b:'] chitani: { :a :b Zotuluka lembani: (a + b), mzere-watsopano. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
