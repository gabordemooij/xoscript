# compliance test

# use international numbers

Zotuluka lembani: ['1000 -> '].
Zotuluka lembani: 1000, mzere-watsopano. #1000

Zotuluka lembani: ['1.5 -> '].
Zotuluka lembani: 1.5, mzere-watsopano.  #1.5

Zotuluka lembani: ['1001.5 -> '].
Zotuluka lembani: 1.5 + 1000, mzere-watsopano. #1001.5

# use 0-indexed arrays
>> x := Mndandanda chatsopano ; 1 ; 2 ; 3.
>> y := Mndandanda chatsopano ; ['a'] ; ['b'] ; ['c'].

Zotuluka lembani: ['1 -> '].
Zotuluka lembani: x ? 0, mzere-watsopano. #1

Zotuluka lembani: ['1 -> '].
Zotuluka lembani: (x pamalo: 0), mzere-watsopano. #1

Zotuluka lembani: ['1 -> '].
Zotuluka lembani: x choyamba, mzere-watsopano. #1

Zotuluka lembani: ['3 -> '].
Zotuluka lembani: x chomaliza, mzere-watsopano. #3

Zotuluka lembani: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Zotuluka lembani: (x malinga-ndi: y), mzere-watsopano.

Zotuluka lembani: ['1 -> '].
Zotuluka lembani: (x kuchokera: 0 kutalika: 1) choyamba, mzere-watsopano. #1

Zotuluka lembani: ['0 -> '].
Zotuluka lembani: (x pezani: 1), mzere-watsopano. #0

x ikani: 9 pa: 0.

Zotuluka lembani: ['9 -> '].
Zotuluka lembani: (x pamalo: 0), mzere-watsopano. #9

x onjeza-koyambirira: 8.
Zotuluka lembani: ['8 -> '].
Zotuluka lembani: (x pamalo: 0), mzere-watsopano. #9


x onjeza-kumapeto: 10.
Zotuluka lembani: ['10 -> '].
Zotuluka lembani: (x pamalo: 4), mzere-watsopano. #10








