# test number -> string -> number
{

	>> x := Nambala pakati: 0 ndi: 1000000.
	>> d := Nambala pakati: 1 ndi: 7.
	>> e := 10 mphamvu-ya-nambala: d.

	x gawani-ndi: e.
	>> y := x malemba-a-mawu nambala.

	(x = y) zabodza: {
		Zotuluka lembani: x, mzere-watsopano.
		Zotuluka lembani: y, mzere-watsopano.
		Pulogalamu tsiriza.
	}.

} * 1000.
Zotuluka lembani: ['OK'], mzere-watsopano.