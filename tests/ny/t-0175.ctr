

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> x := 100.

Pulogalamu kasamalidwe-ka-kukumbukira: 0.

{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt onjeza-kumapeto: ['!!'].
Zotuluka lembani: txt.
} yamba.

Pulogalamu yeretsa.

usedMemory1 := (Pulogalamu kukumbukira ? 0).


{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt onjeza-kumapeto: ['!!'].
Zotuluka lembani: txt.
} yamba.

Pulogalamu yeretsa.
usedMemory2 := (Pulogalamu kukumbukira ? 0).


{
>> txt := ['hello '] + ['world'].
