Zotuluka lembani: ['Test object'], mzere-watsopano.
>> a := Chinthu chatsopano. 
a chikafika: ['item:'] chitani: { :lst
	zake lst := lst. 
}.
a chikafika: ['item'] chitani: { <- zake lst.
}.
a item: (
	Mndandanda chatsopano ; 1 ; (
		Mndandanda chatsopano ; ['a'] ; (
			Mndandanda chatsopano ; ( Nthawi-yeniyeni chatsopano: 1 )
		) ; ( Int64 kuchokera-ku-malemba: ['321'] )
	)
).
Zotuluka lembani: a item, mzere-watsopano.
>> old-lst-address := a item chitsanzo-choyamba adilesi-ya-kukumbukira.
a save-as: ['/tmp/a.bin'].
Zotuluka lembani: ['========== RELOADING SNAP:'], mzere-watsopano.
>> b := Chinthu load-from: ['/tmp/a.bin'].
(b item chitsanzo-choyamba adilesi-ya-kukumbukira = old-lst-address) zoona: {
	Zotuluka lembani: ['Object link re-attached.'], mzere-watsopano.
}.
Zotuluka lembani: ( b item ), mzere-watsopano.
