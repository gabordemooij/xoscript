
Server init.
Zotuluka lembani: ['Database test'], mzere-watsopano.

>> db := Maria-DB chatsopano wolandira: ['localhost'],
	dzina-la-wogwiritsa: ['xo'], 
	mawu-achinsinsi: ['pass123'],
	dzina-la-nkhokwe-ya-deta: ['xobase'],
	lumikizana.

>> zofufuzira :=
db funso: ['SELECT REPEAT('Blah',1000) AS blah'], 
tenga: { :row 
	Zotuluka lembani: row blah kutalika, mzere-watsopano.
}.
