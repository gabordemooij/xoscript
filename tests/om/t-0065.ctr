Lakkoofsa irratti: ['factorial'] godhi: {
	>> total := 1.
	{ :index total baayisi-tiin: (ofii - (index)). } × ofii. <- total.
}.
>> Printer := Wanta haaraa.
Printer irratti: ['print:and:'] godhi: { :x :y
	Baʼii barreessi: ['a='] + x + [', b='] + y, dhaabi.
}.
>> a := 4.5. >> b := a gadi.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a oli.
Printer print: a and: b.
a := 4.5. b := a gadi.
Printer print: a and: b.
a := 4.5. b := a naanna.
Printer print: a and: b.
a := 4.2. b := a naanna.
Printer print: a and: b.

Baʼii barreessi: (9 haftuu: 5), dhaabi.
Baʼii barreessi: -666 mutlaka, dhaabi.
Baʼii barreessi: 49 hirkoo-iskeeri, dhaabi.
Baʼii barreessi: (2 humna: 3), dhaabi.
>> l := (Tarree-wantootaa ← 9 ; 6).
Baʼii barreessi: l xiqqaa.

