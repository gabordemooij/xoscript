# session cookie format, json content type, web protocols only, svg shown inline
Server qopheessi.
Sagantaa fayyadami: ['../../../src/xo/om/webtools.xo'].

>> Fake-Request := Wanta haaraa.
Fake-Request irratti: ['value:'] godhi: { :gatii
	koo gatii := gatii.
}.
Fake-Request irratti: ['cookie:'] godhi: { :maqaa <- koo gatii.
}.

>> Test-Session := Marii-faayilii-yeroo haaraa.
Test-Session irratti: ['galchi'] godhi: { <- Galmee-jechootaa haaraa.
}.
Test-Session irratti: ['session-id'] godhi: { <- koo id.
}.

>> cookies := Tarree-wantootaa haaraa
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

cookies hundaaf: { :i :cookie
	>> gaaffii-http := Fake-Request haaraa.
	gaaffii-http value: cookie.
	>> bulchaa := Test-Session haaraa.
	>> web := Sanada-Weebii haaraa.
	web gaaffii-http: gaaffii-http.
	web bulchaa-marii: bulchaa.
	web marii-jalqabi.
	Baʼii barreessi: ( bulchaa session-id = cookie ), dhaabi.
}.

>> web := Sanada-Weebii haaraa.
web json: (Galmee-jechootaa haaraa kaaʼi: ['b'] itti: ['a']).
Baʼii barreessi: ['\n'], dhaabi.

{ Neetworkii get: ['file:///etc/hostname']. } qabi: { :e
	Baʼii barreessi: e, dhaabi.
}, fiigi.

>> svg := Faayila haaraa: ['/tmp/test0814.svg'].
svg barreessi: ['<svg xmlns="x"></svg>'].
Baʼii dhaabi.
Server dabarsi: ['test0814.svg'] durduubee: ['/tmp/'].
svg haqi.
