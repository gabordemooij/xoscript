
>> a := Tarree-wantootaa ← (Tarree-wantootaa ← 100 ; 200 ; 300) ; (Tarree-wantootaa ← 9 ; 8 ; 7).
Baʼii barreessi: ['at 0,1 :'].
Baʼii barreessi: a ? 0 ? 1, dhaabi. 
Baʼii barreessi: ['at 1,2 :'].
Baʼii barreessi: a ? 1 ? 2, dhaabi. 
>> menu := Galmee-jechootaa haaraa.
menu kaaʼi: (Tarree-wantootaa ← ['pizza'] ; ['spaghetti']) itti: ['Italian Cuisine'].
menu kaaʼi: (Tarree-wantootaa ← ['bifteki'] ; ['suflaki']) itti: ['Greek Cuisine'].
Baʼii barreessi: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), dhaabi. 
Baʼii barreessi: ['but not on the same plate.'], dhaabi.
