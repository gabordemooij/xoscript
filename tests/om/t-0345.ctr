# test catch-all methods
>> x13 := Wanta haaraa.
x13 irratti: ['a'] godhi: { :a Baʼii barreessi: 0, dhaabi. }.
x13 irratti: ['a:'] godhi: { :a Baʼii barreessi: a, dhaabi. <- 5. }.
x13 irratti: ['a:b:'] godhi: { :a :b Baʼii barreessi: (a + b), dhaabi. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
