

>> obj := Wanta haaraa.

obj irratti: ['greet'] godhi: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj irratti: ['task'] godhi: {
	koo property := 123.
	{
		# try binds self/own to object instead of block
