# test url parsing

Server init.
>> url := URL maddaa: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Baʼii barreessi: ['scheme = '] + url karoora-teessoo, dhaabi.
Baʼii barreessi: ['host = '] + url keessummeessaa, dhaabi.
Baʼii barreessi: ['port = '] + url balbala, dhaabi.
Baʼii barreessi: ['path = '] + url karaa, dhaabi.
Baʼii barreessi: ['query = '] + url ulaagaalee-barbaacha, dhaabi.
Baʼii barreessi: ['fragment = '] + url cittuu, dhaabi.
