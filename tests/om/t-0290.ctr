# test list operations


>> cakes := Tarree-wantootaa ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes bakkabuusi: 1 dheerina: 2 tiin: ( Tarree-wantootaa ← ['cinnamon'] ; ['pineapple'] ).
Baʼii barreessi: (buy waliingalchi: [',']), dhaabi.


>> buy := cakes bakkabuusi: 1 dheerina: 12 tiin: ( Tarree-wantootaa ← ['cinnamon'] ; ['pineapple'] ).
Baʼii barreessi: (buy waliingalchi: [',']), dhaabi.


>> buy := cakes bakkabuusi: 2 dheerina: 10 tiin: ( Tarree-wantootaa haaraa ).
Baʼii barreessi: (buy waliingalchi: [',']), dhaabi.


>> buy := cakes bakkabuusi: 0 dheerina: 1 tiin: ( Tarree-wantootaa haaraa ).
Baʼii barreessi: (buy waliingalchi: [',']), dhaabi.


>> buy := cakes bakkabuusi: ['0'] dheerina: ['1'] tiin: ['x'].
Baʼii barreessi: (buy waliingalchi: [',']), dhaabi.
