>> Greeter := Wanta haaraa.
Greeter irratti: ['make'] godhi: {
	>> gr := Wanta haaraa.
	gr irratti: ['setName:'] godhi: { :aname
		koo maqaa := aname.
	}.
	gr irratti: ['greet'] godhi: {
		Baʼii barreessi: koo maqaa.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a haaraa.
c setName: ['THREE'].
c greet.
>> d := a haaraa.
d setName: ['FOUR'].
d greet.
c greet.
