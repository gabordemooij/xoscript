Server init.
Baʼii barreessi: ['Database time test'], dhaabi.

>> db := Maria-DB haaraa keessummeessaa: ['localhost'],
	maqaa-fayyadamaa: ['xo'], 
	jecha-icciitii: ['pass123'],
	maqaa-kuusaa-deetaa: ['xobase'],
	walqunnami.

>> ulaagaalee-barbaacha :=
db iyyaafannoo: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
fidi: { :row
	Baʼii barreessi: row timetest, dhaabi.
}.
