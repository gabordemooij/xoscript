Server init.

>> db := Maria-DB haaraa keessummeessaa: ['localhost'],
	maqaa-fayyadamaa: ['xo'],
	jecha-icciitii: ['pass123'],
	maqaa-kuusaa-deetaa: ['xobase'],
	walqunnami.

>> del := db iyyaafannoo: ['DELETE FROM book WHERE id > 0'].
{  del hojiirra-oolchi. db mirkaneessi. } qabi: { :e db duubatti-deebisi.  }, fiigi.

>> lakkaaʼi := db iyyaafannoo: ['SELECT COUNT(*) AS num FROM book'].
lakkaaʼi fidi: { :row Baʼii barreessi: row num, dhaabi. }.
