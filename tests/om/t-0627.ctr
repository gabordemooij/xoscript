

# create a 64-bit integer for exact calculations
>> a := Int64 barreeffama-irraa: ['123'].

# to string
Baʼii barreessi: a, dhaabi.

# divide
Baʼii barreessi: a / (Int64 barreeffama-irraa: ['3']), dhaabi.

# multiply
Baʼii barreessi: a * (Int64 barreeffama-irraa: ['2']), dhaabi.

# add
Baʼii barreessi: a + (Int64 barreeffama-irraa: ['1']), dhaabi.

# subtract
Baʼii barreessi: a - (Int64 barreeffama-irraa: ['2']), dhaabi.

# compare
Baʼii barreessi: ( a =   (Int64 barreeffama-irraa: ['123'])), dhaabi.
Baʼii barreessi: ( a !=: (Int64 barreeffama-irraa: ['124'])), dhaabi.
Baʼii barreessi: ( a <   (Int64 barreeffama-irraa: ['124'])), dhaabi.
Baʼii barreessi: ( a >   (Int64 barreeffama-irraa: ['122'])), dhaabi.
Baʼii barreessi: ( a >=: (Int64 barreeffama-irraa: ['123'])), dhaabi.
Baʼii barreessi: ( a <=: (Int64 barreeffama-irraa: ['123'])), dhaabi.





	