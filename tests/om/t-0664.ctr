# recursive interpolation not allowed

Baʼii barreessi: 
['recursive string interolation enabled: '] + (
	Sagantaa amala: 
	['RECURSIVE_STRINTPOL']
), dhaabi.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Baʼii barreessi: a, dhaabi.


Sagantaa amala: ['RECURSIVE_STRINTPOL'] dandeessisi: Dhugaa.

