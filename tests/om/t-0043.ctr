>> repeater := Wanta haaraa.
repeater irratti: ['deebii-kenni:'] godhi: { :what
	Baʼii barreessi: what + [' '].
}.
repeater irratti: ['deebii-kenni:fi:'] godhi: { :what :say
	Baʼii barreessi: what, barreessi: say + [' '].
}.
repeater irratti: ['deebii-kenni:fi:fi:'] godhi: { :what :say :more
	Baʼii barreessi: what, barreessi: say, barreessi: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
