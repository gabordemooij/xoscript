Server init.
Baʼii barreessi: ['Database datetime test'], dhaabi.

>> db := Maria-DB haaraa keessummeessaa: ['localhost'],
	maqaa-fayyadamaa: ['xo'], 
	jecha-icciitii: ['pass123'],
	maqaa-kuusaa-deetaa: ['xobase'],
	walqunnami.

>> ulaagaalee-barbaacha :=
db iyyaafannoo: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
fidi: { :row
	Baʼii barreessi: row datetimetest, dhaabi.
}.
