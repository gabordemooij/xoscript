


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Sagantaa qulqullina: 0.
>> palette := Homaa.
>> colors := Homaa.

{
palette := Galmee-jechootaa haaraa.
palette 
	kaaʼi: ['#F00'] itti: ['red'],
	kaaʼi: ['#0F0'] itti: ['green'],
	kaaʼi: ['#00F'] itti: ['blue'].
Baʼii barreessi: ['number of RGB codes in palette: '] + ( palette lakkaaʼi ), dhaabi.
Baʼii barreessi: ['RGB code of green is: '] + ( palette ? ['green'] ), dhaabi.
colors := [''].
( palette hundaaf: { :maqaa :koodii
		colors := colors + ( maqaa + [':'] + koodii ).
} ).
Baʼii barreessi: ['All colors in palette: '] + colors, dhaabi.
} fiigi.
Sagantaa qulqulleessi-memoorii.
usedMemory1 := (Sagantaa memoorii ? 0).

{
palette := Galmee-jechootaa haaraa.
palette 
	kaaʼi: ['#F00'] itti: ['red'],
	kaaʼi: ['#0F0'] itti: ['green'],
	kaaʼi: ['#00F'] itti: ['blue'].
Baʼii barreessi: ['number of RGB codes in palette: '] + ( palette lakkaaʼi ), dhaabi.
Baʼii barreessi: ['RGB code of green is: '] + ( palette ? ['green'] ), dhaabi.
colors := [''].
( palette hundaaf: { :maqaa :koodii
		colors := colors + ( maqaa + [':'] + koodii ).
} ).
Baʼii barreessi: ['All colors in palette: '] + colors, dhaabi.
} fiigi.
Sagantaa qulqulleessi-memoorii.
usedMemory2 := (Sagantaa memoorii ? 0).

{
palette := Galmee-jechootaa haaraa.
palette 
	kaaʼi: ['#F00'] itti: ['red'],
	kaaʼi: ['#0F0'] itti: ['green'],
	kaaʼi: ['#00F'] itti: ['blue'].
Baʼii barreessi: ['number of RGB codes in palette: '] + ( palette lakkaaʼi ), dhaabi.
Baʼii barreessi: ['RGB code of green is: '] + ( palette ? ['green'] ), dhaabi.
colors := [''].
( palette hundaaf: { :maqaa :koodii
		colors := colors + ( maqaa + [':'] + koodii ).
} ).
Baʼii barreessi: ['All colors in palette: '] + colors, dhaabi.
} fiigi.
Sagantaa qulqulleessi-memoorii.
usedMemory3 := (Sagantaa memoorii ? 0).



( usedMemory1 = usedMemory2 fi: usedMemory1 = usedMemory3, fi: usedMemory2 = usedMemory3 ) yoodhugaa: {
	Baʼii barreessi: ['No memory leaks here'].
}, yoosoba: {
	Baʼii barreessi: ['Leaking memory...'].
}.
