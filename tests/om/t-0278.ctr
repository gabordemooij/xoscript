>> To-Do := Wanta haaraa.

To-Do irratti: ['haaraa'] godhi: {
	koo list := Tarree-wantootaa haaraa.
}.

To-Do irratti: ['nieuw'] godhi: {
	koo list := Tarree-wantootaa haaraa.
}.

To-Do irratti: ['+'] godhi: { :task
	koo list dabaliboodatti: task.
}.

To-Do irratti: ['number of tasks?'] godhi: { <-  koo list lakkaaʼi.
}.

>> todos := 
	To-Do haaraa 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Baʼii barreessi: ['You have $ tasks to do'] $ todos number of tasks?.
