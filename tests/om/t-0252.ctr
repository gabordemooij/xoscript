#Linux
>> clock := Yeroo haaraa.
clock naannoo: ['UTC-1'].
clock bara: 1981, jiʼa: 1, guyyaa: 5,
      saʼaatii: 13, daqiiqaa: 15, sekoondii: 13.

Baʼii barreessi: clock, dhaabi.
clock naannoo: ['UTC+0'].

Baʼii barreessi: (
	(clock bara dheedhii) + ['-'] + (clock jiʼa) + ['-'] + (clock guyyaa) + [' '] +
	(clock saʼaatii) + [':'] + (clock daqiiqaa) + [':'] + (clock sekoondii) + [' '] +
	['W'] + (clock torbee) + (clock naannoo)
), dhaabi.


clock naannoo: ['UTC-1'].
Baʼii barreessi: (
	(clock bara dheedhii) + ['-'] + (clock jiʼa) + ['-'] + (clock guyyaa) + [' '] +
	(clock saʼaatii) + [':'] + (clock daqiiqaa) + [':'] + (clock sekoondii) + [' '] +
	['W'] + (clock torbee) + (clock naannoo)
), dhaabi.
