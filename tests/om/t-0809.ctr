# backslashes must survive code serialization, strings must not end early
>> gattiiwwan := Tarree-wantootaa haaraa
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

gattiiwwan hundaaf: { :i :value
	>> d := Galmee-jechootaa haaraa.
	d kaaʼi: value itti: ['k'].
	>> r := d koodii gara-wantaatti.
	Baʼii barreessi: r lakkaaʼi, dhaabi.
	Baʼii barreessi: ( (r bakka: ['k']) = value ), dhaabi.
}.
