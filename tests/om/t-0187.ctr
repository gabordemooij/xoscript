Lakkoofsa irratti: ['factorial'] godhi: {
	>> total := 1.
	{ :index total baayisi-tiin: (ofii - index). } × ofii. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Sagantaa qulqullina: 0.

{
2 exponent factorial.
Baʼii barreessi: (11 haftuu: 3), dhaabi.
Baʼii barreessi: (3.4 naanna), dhaabi.
Baʼii barreessi: (7.1 oli), dhaabi.
Baʼii barreessi: (7.9 gadi), dhaabi.
}
fiigi.

Sagantaa qulqulleessi-memoorii.

usedMemory1 := (Sagantaa memoorii ? 0).

{
2 exponent factorial.
Baʼii barreessi: (11 haftuu: 3), dhaabi.
Baʼii barreessi: (3.4 naanna), dhaabi.
Baʼii barreessi: (7.1 oli), dhaabi.
Baʼii barreessi: (7.9 gadi), dhaabi.
}
fiigi.

Sagantaa qulqulleessi-memoorii.
usedMemory2 := (Sagantaa memoorii ? 0).


{
2 exponent factorial.
Baʼii barreessi: (11 haftuu: 3), dhaabi.
Baʼii barreessi: (3.4 naanna), dhaabi.
Baʼii barreessi: (7.1 oli), dhaabi.
Baʼii barreessi: (7.9 gadi), dhaabi.
} fiigi.

Sagantaa qulqulleessi-memoorii.
usedMemory3 := (Sagantaa memoorii ? 0).



( usedMemory1 = usedMemory2 fi: usedMemory1 = usedMemory3, fi: usedMemory2 = usedMemory3 ) yoodhugaa: {
	Baʼii barreessi: ['No memory leaks here'].
}, yoosoba: {
	Baʼii barreessi: ['Leaking memory...'].
}.
