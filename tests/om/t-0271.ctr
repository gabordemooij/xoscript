
Sagantaa qulqullina: 1.
Sagantaa memoorii: 16000000.
>> tokens := ['{}↲.:,x() '].
{ :i
	>> koodii := [''].
	>> x := Lakkoofsa gidduu: 1 fi: 10.
	{
		>> y := Lakkoofsa gidduu: 1 fi: (tokens dheerina).
		koodii dabaliboodatti: (tokens qubee: y).
	} × x.
	{ Dalagaa haaraa: koodii. } qabi: { ['Empty']. }, fiigi.

} × 10000.
Baʼii barreessi: ['OK'], dhaabi.
