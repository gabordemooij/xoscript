60 × {
	>> x := (Lakkoofsa random % 6) + 1.
	(x ≤ 6) yoosoba: { Baʼii barreessi: ['FAIL']. }.
	(x ≥0) yoosoba: { Baʼii barreessi: ['FAIL']. }.
	x := (Lakkoofsa random % 3) + 1.
	(x < 3) yoosoba: { Baʼii barreessi: ['FAIL']. }.
	(x>-1) yoosoba: { Baʼii barreessi: ['FAIL']. }.
	x := ((Buuliyaanii flip) gara-lakkoofsaatti).
	(x = 0 ykn: x = 1) yoosoba: { Baʼii barreessi: ['FAIL']. }.
	x := ((Dhugaa flip) gara-lakkoofsaatti).
	(x = 0 ykn: x = 1) yoosoba: { Baʼii barreessi: ['FAIL']. }.
	x := (Buuliyaanii flip tokkoykn: ['HEAD'] ykn: ['TAIL']).
	((x = ['HEAD']) ykn: (x = ['TAIL'])) yoosoba: { Baʼii barreessi: ['FAIL']. }.
}.
Baʼii barreessi: ['DONE'].

