>> str := ['write:'].
Baʼii ergaa: ['barreessi:'] falmee: (Tarree-wantootaa ← ['Hello World']), dhaabi. 

Lakkoofsa irratti: ['isbetween:and:'] godhi: { :a :b <- ((ofii ≥ a) fi: (ofii ≤ b)).
}.

str := ['isbetween:and:'].
Baʼii barreessi: (3 ergaa: str falmee: (Tarree-wantootaa ← 2 ; 8)), dhaabi.
Baʼii barreessi: (3 ergaa: str falmee: (Tarree-wantootaa ← 1 ; 2)), dhaabi.


>> CoffeeMachine := Wanta haaraa.
CoffeeMachine irratti: ['makeCoffeeWithSugar:milk:'] godhi: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Tarree-wantootaa ← 4 ; 2.
Baʼii barreessi: ( CoffeeMachine ergaa: order falmee: coffeeConfiguration ), dhaabi.
