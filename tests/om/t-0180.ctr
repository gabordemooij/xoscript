Barreeffama irratti: ['html'] godhi: { <- (
		ofii
		bakka-buusi: ['&'] tiin: ['&amp;'],
		bakka-buusi: ['<'] tiin: ['&lt;'],
		bakka-buusi: ['>'] tiin: ['&gt;'],
		bakka-buusi: ['''] tiin: ['&apos;'],
		bakka-buusi: ['"'] tiin: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Sagantaa qulqullina: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Baʼii barreessi: txt kopii html, dhaabi.
Baʼii barreessi: txt kopii ascii-xiqqaa, dhaabi.
Baʼii barreessi: txt kopii ascii-guddaa, dhaabi.
} fiigi.

Sagantaa qulqulleessi-memoorii.

usedMemory1 := (Sagantaa memoorii ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Baʼii barreessi: txt kopii html, dhaabi.
Baʼii barreessi: txt kopii ascii-xiqqaa, dhaabi.
Baʼii barreessi: txt kopii ascii-guddaa, dhaabi.
} fiigi.

Sagantaa qulqulleessi-memoorii.
usedMemory2 := (Sagantaa memoorii ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Baʼii barreessi: txt kopii html, dhaabi.
Baʼii barreessi: txt kopii ascii-xiqqaa, dhaabi.
Baʼii barreessi: txt kopii ascii-guddaa, dhaabi.
} fiigi.

Sagantaa qulqulleessi-memoorii.
usedMemory3 := (Sagantaa memoorii ? 0).



( usedMemory1 = usedMemory2 fi: usedMemory1 = usedMemory3, fi: usedMemory2 = usedMemory3 ) yoodhugaa: {
	Baʼii barreessi: ['No memory leaks here'].
}, yoosoba: {
	Baʼii barreessi: ['Leaking memory...'].
}.
