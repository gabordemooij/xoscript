Baʼii barreessi: ['Test object'], dhaabi.
>> a := Wanta haaraa. 

a irratti: ['item:'] godhi: { :moment
	koo moment := moment. 
}.

a irratti: ['item'] godhi: { <- koo moment.
}.

>> today := Yeroo haaraa naannoo: ['CEST'], bara: 2026, jiʼa: 7.
a item: today.
Baʼii barreessi: a item, dhaabi.
a save-as: ['/tmp/a.bin'].
Baʼii barreessi: ['========== RELOADING SNAP:'], dhaabi.
>> b := Wanta load-from: ['/tmp/a.bin'].
Baʼii barreessi: b item, dhaabi.
