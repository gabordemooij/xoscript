>> Combination := Tarree-wantootaa haaraa.

Combination irratti: ['dabaliboodatti:'] godhi: { :el
	ofii 
	argadhu: el, Homaa? yoodhugaa: { ofii dabaliboodatti: el. }.
}.

>> colours := Combination haaraa.
colours
	dabaliboodatti: ['red'],
	dabaliboodatti: ['green'],
	dabaliboodatti: ['blue'],
	dabaliboodatti: ['red'].

Baʼii barreessi: colours, dhaabi.
