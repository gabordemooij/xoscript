

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Sagantaa qulqullina: 0.

Lakkoofsa irratti: ['addNum:'] godhi: { :x
	ofii idaʼi: x.
}.

Lakkoofsa irratti: ['subtractNum:'] godhi: { :x
	ofii hiri: x.
}.

Lakkoofsa irratti: ['multiplyBy:'] godhi: { :x
	ofii baayisi-tiin: x.
}.

Lakkoofsa irratti: ['divideBy:'] godhi: { :x
	ofii hiri-tiin: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 humna: 8).  
a := a + (2 humna: -1). 
a := a + (49 hirkoo-iskeeri).   
a addNum: ((Tarree-wantootaa ← 0 ; 1) guddaa).          
a addNum: ((Tarree-wantootaa ← 2 ; 3) xiqqaa).
Baʼii barreessi: a.

Sagantaa qulqulleessi-memoorii.

usedMemory1 := (Sagantaa memoorii ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 humna: 8).  
a := a + (2 humna: -1). 
a := a + (49 hirkoo-iskeeri).   
a addNum: ((Tarree-wantootaa ← 0 ; 1) guddaa).          
a addNum: ((Tarree-wantootaa ← 2 ; 3) xiqqaa).
Baʼii barreessi: a.

Sagantaa qulqulleessi-memoorii.
usedMemory2 := (Sagantaa memoorii ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 humna: 8).  
a := a + (2 humna: -1). 
a := a + (49 hirkoo-iskeeri).   
a addNum: ((Tarree-wantootaa ← 0 ; 1) guddaa).          
a addNum: ((Tarree-wantootaa ← 2 ; 3) xiqqaa).
Baʼii barreessi: a.

Sagantaa qulqulleessi-memoorii.
usedMemory3 := (Sagantaa memoorii ? 0).



( usedMemory1 = usedMemory2 fi: usedMemory1 = usedMemory3, fi: usedMemory2 = usedMemory3 ) yoodhugaa: {
	Baʼii barreessi: ['No memory leaks here'].
}, yoosoba: {
	Baʼii barreessi: ['Leaking memory...'].
}.
