# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB haaraa keessummeessaa: ['localhost'],
	maqaa-fayyadamaa: ['xo'],
	jecha-icciitii: ['pass123'],
	maqaa-kuusaa-deetaa: ['xobase'],
	walqunnami.

>> ulaagaalee-barbaacha := db iyyaafannoo: ['SELECT %% FROM'].
{ ulaagaalee-barbaacha hojiirra-oolchi. } qabi: { :e
	Baʼii barreessi: ( e hammataa: ['%%'] ), dhaabi.
}, fiigi.
