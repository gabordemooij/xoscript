>> numbers := ['1,2,3'] addaan-bahi: [','].
Baʼii barreessi: ['I got: '] + numbers lakkaaʼi + [' numbers.'],dhaabi.
{ :i Baʼii barreessi: ['number #'] + i + [':'] + (numbers iddoo: i), dhaabi.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages addaan-bahi: [' Or '].
Baʼii barreessi: ['We serve'], dhaabi.
{ :i Baʼii barreessi: ['->'] + (beverages iddoo: i), dhaabi. } × (beverages lakkaaʼi).
Baʼii barreessi: (beverages waliingalchi: [',']), dhaabi.
Baʼii barreessi: (numbers waliingalchi: ['||']).
