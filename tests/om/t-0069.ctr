

Barreeffama irratti: ['html'] godhi: { <- (
		ofii
		bakka-buusi: ['&'] tiin: ['&amp;'],
		bakka-buusi: ['<'] tiin: ['&lt;'],
		bakka-buusi: ['>'] tiin: ['&gt;'],
		bakka-buusi: ['"'] tiin: ['&quot;']
	).
}.


Baʼii barreessi: ([' left trimmed '] halaga-naannawa-balleessi) + [' '] + ( ['and right trimmed'] halaga-naannawa-balleessi) + ['!'], dhaabi.
Baʼii barreessi: ['<html>"html & entities"</html>'] html.
