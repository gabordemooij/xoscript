>> Grandfather := Wanta haaraa.
Grandfather irratti: ['greet'] godhi: {
	Baʼii barreessi: ['Ave!'], dhaabi.
}.
>> Father := Grandfather haaraa.
Father irratti: ['greet'] godhi: {
	Baʼii barreessi: ['Hello'], dhaabi.
	ofii greet.
}.
>> Son := Father haaraa.
Son irratti: ['greet'] godhi: {
	Baʼii barreessi: ['Hi'], dhaabi.
	ofii greet.
}.

Son greet.

>> Roundabout := Wanta haaraa.
Roundabout irratti: ['circle:'] godhi: { :x
	Baʼii barreessi: x, dhaabi.
	(x < 3) yoodhugaa: { ofii irradeebiʼee circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) yoodhugaa: { Baʼii barreessi: x, dhaabi. x idaʼi: 1.  increment fiigi. }. }.
increment fiigi.