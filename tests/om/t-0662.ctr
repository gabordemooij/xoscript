>> t := Homaa.

# you can control the time zone for
# parsing like this:
Yeroo naannoo: ['CET'].
t := Yeroo maddaa: ['1981-02-03 04:05:06'].
Baʼii barreessi: t, dhaabi.

# now using CEST time zone:
Yeroo naannoo: ['CEST'].
t := Yeroo maddaa: ['1981-02-03 04:05:06'].
Baʼii barreessi: t, dhaabi.

# error if string cannot be parsed
{ Yeroo maddaa: ['1900']. } qabi: { Homaa. }, fiigi.
