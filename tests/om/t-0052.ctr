>> items := Galmee-jechootaa haaraa.
items kaaʼi: ['green'] itti: ['color-1'].
items kaaʼi: ['orange'] itti: ['color-2'].
items kaaʼi: ['red'] itti: ['color-3'].
>> i := 0.
>> s := [''].
items hundaaf: { :key :color
	Baʼii barreessi: ['color #'] + i + [' is: '] + color + [' '].
	i idaʼi: 1.
}.
Baʼii barreessi: i + [' colors!'].
