# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Kuusaa-nageenyaa furtuu-uumi.

# private (secret) key
>> sk := keys jalqabaa.

# public key
>> pk := keys dhumaa.

# sign a message
>> sig := Kuusaa-nageenyaa mallatteessi: ['abc'] furtuun: sk.

# check message (ok)
Baʼii barreessi: ( 
	Kuusaa-nageenyaa
		sakattaʼi: ['abc'] 
		mallattoo: sig 
		furtuun: pk 
), dhaabi.

# check message (fail)
Baʼii barreessi: ( 
	Kuusaa-nageenyaa 
		sakattaʼi: ['abd'] 
		mallattoo: sig 
		furtuun: pk 
), dhaabi.