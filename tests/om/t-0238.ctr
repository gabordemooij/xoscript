Barreeffama irratti: ['evaluate'] godhi: {
	>> koodii := Faayila haaraa: ['/tmp/eval.ctr'].
	koodii barreessi: (ofii gara-barreeffamaatti + ['.']).
	Sagantaa fayyadami: ['/tmp/eval.ctr'].
}.

>> a := Tarree-wantootaa ← 1 ; 2 ; 3.
>> b := (a gara-barreeffamaatti).

Baʼii barreessi: b, dhaabi. 
(['b := '] + b) evaluate.

Baʼii barreessi: b ? 2, dhaabi. 

Baʼii barreessi: (( Tarree-wantootaa ← 1 ; 2 ; 3 )), dhaabi. 

Baʼii barreessi: ((Galmee-jechootaa haaraa) kaaʼi: 1 itti: 2), dhaabi. 

>> x := ( (Tarree-wantootaa ← 1 ; ( Tarree-wantootaa ← 9 ) ; Dhugaa ) ) gara-barreeffamaatti.
Baʼii barreessi: x, dhaabi. 
(['x := '] + x) evaluate.

Baʼii barreessi: x ? 1 ? 0, dhaabi. 

>> y := (Galmee-jechootaa haaraa) kaaʼi: (Tarree-wantootaa ← 1) itti: (Tarree-wantootaa ← 2).
Baʼii barreessi: y, dhaabi. 

(['y := '] + y) gara-barreeffamaatti evaluate.

Baʼii barreessi: (y bakka: (Tarree-wantootaa ← 2) gara-barreeffamaatti ), dhaabi.

Baʼii barreessi: (Tarree-wantootaa haaraa), dhaabi. 
Baʼii barreessi: (Galmee-jechootaa haaraa), dhaabi. 
