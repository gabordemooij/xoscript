Baʼii barreessi: ['Test object'], dhaabi.
>> cmd := Ajaja haaraa.
Baʼii barreessi: cmd ls /tmp, dhaabi.
>> old-cmd-address := cmd fakkeenya-jalqabaa teessoo-memoorii.
cmd save-as: ['/tmp/a.bin'].
Baʼii barreessi: ['========== RELOADING SNAP:'], dhaabi.
>> b := Wanta load-from: ['/tmp/a.bin'].
(b fakkeenya-jalqabaa teessoo-memoorii = old-cmd-address) yoodhugaa: {
	Baʼii barreessi: ['Object link re-attached.'], dhaabi.
}.
Baʼii barreessi: b ls, dhaabi.


