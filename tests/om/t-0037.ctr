>> a := 3.
>> b := a kopii.
a hiri: 1.
Baʼii barreessi: [' a = '] + a.
Baʼii barreessi: [' b = '] + b.
a := 3.
b := a + 4.
Baʼii barreessi: [' a = '] + a.
Baʼii barreessi: [' b = '] + b.
>> x := 3.
>> y := x kopii.
x idaʼi: 10.
y hiri: 1.
Baʼii barreessi: [' x = '] + x.
Baʼii barreessi: [' y = '] + y.
>> q := Wanta haaraa.
q irratti: ['setProperty:'] godhi: { :x
	koo prop := x.
}.
q irratti: ['getProperty'] godhi: { <- koo prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Baʼii barreessi: [' p = '] + (p getProperty).
