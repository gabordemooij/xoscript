Baʼii barreessi: ['Test object'], dhaabi.
>> a := Wanta haaraa. 
a irratti: ['item:'] godhi: { :lst
	koo lst := lst. 
}.
a irratti: ['item'] godhi: { <- koo lst.
}.
a item: (
	Tarree-wantootaa haaraa ; 1 ; (
		Tarree-wantootaa haaraa ; ['a'] ; (
			Tarree-wantootaa haaraa ; ( Yeroo haaraa: 1 )
		) ; ( Int64 barreeffama-irraa: ['321'] )
	)
).
Baʼii barreessi: a item, dhaabi.
>> old-lst-address := a item fakkeenya-jalqabaa teessoo-memoorii.
a save-as: ['/tmp/a.bin'].
Baʼii barreessi: ['========== RELOADING SNAP:'], dhaabi.
>> b := Wanta load-from: ['/tmp/a.bin'].
(b item fakkeenya-jalqabaa teessoo-memoorii = old-lst-address) yoodhugaa: {
	Baʼii barreessi: ['Object link re-attached.'], dhaabi.
}.
Baʼii barreessi: ( b item ), dhaabi.
