>> t := Dhugaa.
(t = Dhugaa) yoodhugaa: { Baʼii barreessi: ['T']. }.
(t = Soba) yoodhugaa: { Baʼii barreessi: ['F']. }.
Baʼii barreessi: ['|'].
>> t := Soba.
(t = Dhugaa) yoodhugaa: { Baʼii barreessi: ['T']. }.
(t = Soba) yoodhugaa: { Baʼii barreessi: ['F']. }.
Baʼii barreessi: ['|'].
>> f := Dhugaa.
(t = Dhugaa fi: f = Soba) yoodhugaa: { Baʼii barreessi: ['T']. }.
(t = Soba fi: f = Dhugaa) yoodhugaa: { Baʼii barreessi: ['F']. }.
Baʼii barreessi: ['|'].
>> n := Homaa.
(n Homaa?) yoodhugaa: { Baʼii barreessi: ['T']. }.
(n Homaa?) yoosoba: { Baʼii barreessi: ['F']. }.
Baʼii barreessi: ['|'].
(f Boolean?) yoodhugaa: { Baʼii barreessi: ['T']. }.
(f Boolean?) yoosoba: { Baʼii barreessi: ['F']. }.



