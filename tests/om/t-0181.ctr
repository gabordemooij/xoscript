

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Sagantaa qulqullina: 0.

>> txt := ['World Salad'].
Baʼii barreessi: ['this text contains: '] + ( ( txt addaan-bahi: [' '] ) lakkaaʼi ) + [' words.'], dhaabi.
txt := txt irraa: 6 dheerina: 4.
Baʼii barreessi: txt, dhaabi.

Sagantaa qulqulleessi-memoorii.

usedMemory1 := (Sagantaa memoorii ? 0).


txt := ['World Salad'].
Baʼii barreessi: ['this text contains: '] + ( ( txt addaan-bahi: [' '] ) lakkaaʼi ) + [' words.'], dhaabi.
txt := txt irraa: 6 dheerina: 4.
