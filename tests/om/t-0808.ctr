# vault keys and signatures that decode too long must not overflow the stack
Server init.

>> keys := Kuusaa-nageenyaa furtuu-uumi.
>> sk := keys jalqabaa.
>> pk := keys dhumaa.
>> sig := Kuusaa-nageenyaa mallatteessi: ['abc'] furtuun: sk.

# 88 characters without padding decode to 66 bytes
>> long := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 characters without padding decode to 33 bytes
>> short := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Kuusaa-nageenyaa mallatteessi: ['abc'] furtuun: long. } qabi: { :e
	Baʼii barreessi: e, dhaabi.
}, fiigi.

{ Kuusaa-nageenyaa sakattaʼi: ['abc'] mallattoo: long furtuun: pk. } qabi: { :e
	Baʼii barreessi: e, dhaabi.
}, fiigi.

{ Kuusaa-nageenyaa sakattaʼi: ['abc'] mallattoo: sig furtuun: short. } qabi: { :e
	Baʼii barreessi: e, dhaabi.
}, fiigi.
