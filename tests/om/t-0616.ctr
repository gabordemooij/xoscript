Tarree-wantootaa irratti: ['kopii'] godhi: {
	>> kopii := Tarree-wantootaa haaraa.
	ofii hundaaf: { :gara-lakkoofsaatti :section
		kopii dabaliboodatti: section irradeebiʼee kopii.
	}. <- kopii.
}.

>> sheep := Tarree-wantootaa haaraa ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep kopii.
clones hundaaf: { :gara-lakkoofsaatti :sheep
	sheep dabaliboodatti: ['2'].
}.

Baʼii barreessi: sheep, dhaabi.
Baʼii barreessi: clones, dhaabi.
