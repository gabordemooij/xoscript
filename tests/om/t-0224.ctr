
>> countries := Tarree-wantootaa haaraa
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Tarree-wantootaa haaraa
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods tiin: countries, hundaaf: { :key :value
	counter idaʼi: 1.
}.

Baʼii barreessi: (['we serve counter dishes'] counter: counter), dhaabi.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] qubeewwan tarreessi: { :v
	counter idaʼi: 0.
}.

Baʼii barreessi: (['we sort counter dishes'] counter: counter), dhaabi.


>> counter := 0.
{
	{
		counter idaʼi: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Baʼii barreessi: (['we calculate counter numbers.'] counter: counter), dhaabi.

