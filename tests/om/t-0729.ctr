Server init.
>> a := Blob haaraa: 4.
a bytes: ( Tarree-wantootaa haaraa ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob haaraa: 4.
b bytes: ( Tarree-wantootaa haaraa ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a ^ b.
{
	a ^ ( Faayila haaraa: ['noblob???'] ).
} qabi: { :e Baʼii barreessi: e, dhaabi. }, fiigi.
a gadi-lakkisi.
b gadi-lakkisi.
