>> HTML := Wanta haaraa.
HTML irratti: ['deebii-kenni:'] godhi: { :tag 
	Baʼii barreessi: (['<tag>'] tag: tag), dhaabi.
}.
HTML irratti: ['deebii-kenni:fi:'] godhi: { :tag :html 
	Baʼii barreessi: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), dhaabi.
}.
>> html := HTML haaraa.
html body h1: ['header'].

