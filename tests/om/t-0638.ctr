
Server init.
>> rq := Gaaffii-HTTP haaraa.
Baʼii barreessi: ['HTTP-GET d[]=']  + ( rq get-tarree: ['d[]'] ), dhaabi. # GET
Baʼii barreessi: ['HTTP-GET f[]=']  + ( rq get-tarree: ['f[]'] ), dhaabi. # GET
Baʼii barreessi: ['HTTP-POST e[]='] + ( rq post-tarree: ['e[]'] ), dhaabi. # GET
Baʼii barreessi: ['HTTP-POST c=']   + ( rq post: ['c'] ), dhaabi. # GET
Baʼii barreessi: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), dhaabi. # GET
