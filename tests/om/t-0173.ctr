

Tarree-wantootaa irratti: ['sum'] godhi: {
	>> total := 0.
	ofii hundaaf: { :index :element
		total idaʼi: element.
	}. <- total.
}.

Tarree-wantootaa irratti: ['product'] godhi: {
	>> total := 1.
	ofii hundaaf: { :index :element
		total baayisi-tiin: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Sagantaa qulqullina: 0.

{

>> a := Tarree-wantootaa ← ['hello'] ; ['world'] ; Dhugaa ; Homaa ; 666.
a := a + ( Tarree-wantootaa ← 1 ).
Baʼii barreessi: ( ['sum: '] + ( a sum ) ), dhaabi.
Baʼii barreessi: ( ['min: '] + ( a xiqqaa ) ), dhaabi.
Baʼii barreessi: ( ['max: '] + ( a guddaa ) ), dhaabi.
Baʼii barreessi: ( ['3rd: '] + ( a ? 2 ) ), dhaabi.
Baʼii barreessi: ( ['prd: '] + ( a product ) ), dhaabi.
a tarreessi: { :a :b <- (b - a). }.
a hundaaf: { :i :e Baʼii barreessi: ( i - 0 ), dhaabi. }.

} fiigi.

Sagantaa qulqulleessi-memoorii.
usedMemory1 := (Sagantaa memoorii ? 0).


{

>> a := Tarree-wantootaa ← ['hello'] ; ['world'] ; Dhugaa ; Homaa ; 666.
a := a + ( Tarree-wantootaa ← 1 ).
Baʼii barreessi: ( ['sum: '] + ( a sum ) ), dhaabi.
Baʼii barreessi: ( ['min: '] + ( a xiqqaa ) ), dhaabi.
Baʼii barreessi: ( ['max: '] + ( a guddaa ) ), dhaabi.
Baʼii barreessi: ( ['3rd: '] + ( a ? 2 ) ), dhaabi.
Baʼii barreessi: ( ['prd: '] + ( a product ) ), dhaabi.
a tarreessi: { :a :b <- (b - a). }.
a hundaaf: { :i :e Baʼii barreessi: ( i - 0 ), dhaabi. }.

} fiigi.



Sagantaa qulqulleessi-memoorii.
usedMemory2 := (Sagantaa memoorii ? 0).


{

>> a := Tarree-wantootaa ← ['hello'] ; ['world'] ; Dhugaa ; Homaa ; 666.
a := a + ( Tarree-wantootaa ← 1 ).
Baʼii barreessi: ( ['sum: '] + ( a sum ) ), dhaabi.
Baʼii barreessi: ( ['min: '] + ( a xiqqaa ) ), dhaabi.
Baʼii barreessi: ( ['max: '] + ( a guddaa ) ), dhaabi.
Baʼii barreessi: ( ['3rd: '] + ( a ? 2 ) ), dhaabi.
Baʼii barreessi: ( ['prd: '] + ( a product ) ), dhaabi.
a tarreessi: { :a :b <- (b - a). }.
a hundaaf: { :i :e Baʼii barreessi: ( i - 0 ), dhaabi. }.

} fiigi.



Sagantaa qulqulleessi-memoorii.
usedMemory3 := (Sagantaa memoorii ? 0).

( usedMemory1 = usedMemory2 fi: usedMemory1 = usedMemory3, fi: usedMemory2 = usedMemory3 ) yoodhugaa: {
	Baʼii barreessi: ['No memory leaks here'].
}, yoosoba: {
	Baʼii barreessi: ['Leaking memory...'].
}.
