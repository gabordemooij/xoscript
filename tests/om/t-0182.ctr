

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Sagantaa qulqullina: 0.

>> txt := ['1.6'].
>> n := txt gara-lakkoofsaatti.
>> t := txt buuliyaanii.
Baʼii barreessi: n, dhaabi.
Baʼii barreessi: t, dhaabi.
Baʼii barreessi: n gosa, dhaabi.
Baʼii barreessi: t gosa, dhaabi.

Sagantaa qulqulleessi-memoorii.

usedMemory1 := (Sagantaa memoorii ? 0).


