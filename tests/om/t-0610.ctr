
>> Rectangle := Wanta haaraa.

Rectangle irratti: ['area'] godhi: { <- koo dheerina * koo width.
}.

Rectangle irratti: ['length:'] godhi: { :dheerina
	koo dheerina := dheerina.
}.

Rectangle irratti: ['width:'] godhi: { :width
	koo width := width.
}.

Rectangle irratti: ['haaraa'] godhi: {
	# this will not result into an infinite loop
	>> rectangle := ofii haaraa.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle haaraa.
Baʼii barreessi: a area, dhaabi. #0

>> b := Rectangle haaraa length: 2, width: 3.
Baʼii barreessi: b area, dhaabi. #6

