#Linux

(Faayila haaraa: ['/tmp/testje']) jira yoosoba: {
	Sagantaa shelli: ['mkdir /tmp/testje'].	
}.

(Faayila haaraa: ['/tmp/testje/file1']) jira yoosoba: {
	Sagantaa shelli: ['touch /tmp/testje/file1'].	
}.

(Faayila haaraa: ['/tmp/testje/folder1']) jira yoosoba: {
	Sagantaa shelli: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Faayila tarree: ['/tmp/testje'].

>> q := Tarree-wantootaa haaraa.

l hundaaf: { :k :v v hundaaf: { :x :y q dabaliboodatti: y. }. }.

>> s := q gara-barreeffamaatti.

(s hammataa: ['file1']) yoodhugaa:   { Baʼii barreessi: ['OK'], dhaabi. }.
(s hammataa: ['file2']) yoodhugaa:   { Baʼii barreessi: ['XX'], dhaabi. }.
(s hammataa: ['folder1']) yoodhugaa: { Baʼii barreessi: ['OK'], dhaabi. }.
