>> Point := Wanta haaraa.
Point irratti: ['x-coordinate:'] godhi: { :x koo x := x. }.
Point irratti: ['y-coordinate:'] godhi: { :y koo y := y. }.
Point irratti: ['x-coordinate']  godhi: { <- koo x kopii. }.
Point irratti: ['y-coordinate']  godhi: { <- koo y kopii. }.

Point irratti: ['='] godhi: { :other <- ( koo x = other x-coordinate
		 fi: koo y = other y-coordinate ).
}.

>> pier := Point haaraa x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point haaraa x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point haaraa x-coordinate: 5, y-coordinate: 6.

Baʼii barreessi: pier = town-hall, dhaabi.
Baʼii barreessi: pier = restaurant, dhaabi.
