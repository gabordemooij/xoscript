# compliance test

# use international numbers

Baʼii barreessi: ['1000 -> '].
Baʼii barreessi: 1000, dhaabi. #1000

Baʼii barreessi: ['1.5 -> '].
Baʼii barreessi: 1.5, dhaabi.  #1.5

Baʼii barreessi: ['1001.5 -> '].
Baʼii barreessi: 1.5 + 1000, dhaabi. #1001.5

# use 0-indexed arrays
>> x := Tarree-wantootaa haaraa ; 1 ; 2 ; 3.
>> y := Tarree-wantootaa haaraa ; ['a'] ; ['b'] ; ['c'].

Baʼii barreessi: ['1 -> '].
Baʼii barreessi: x ? 0, dhaabi. #1

Baʼii barreessi: ['1 -> '].
Baʼii barreessi: (x bakka: 0), dhaabi. #1

Baʼii barreessi: ['1 -> '].
Baʼii barreessi: x jalqabaa, dhaabi. #1

Baʼii barreessi: ['3 -> '].
Baʼii barreessi: x dhumaa, dhaabi. #3

Baʼii barreessi: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Baʼii barreessi: (x tiin: y), dhaabi.

Baʼii barreessi: ['1 -> '].
Baʼii barreessi: (x irraa: 0 dheerina: 1) jalqabaa, dhaabi. #1

Baʼii barreessi: ['0 -> '].
Baʼii barreessi: (x argadhu: 1), dhaabi. #0

x kaaʼi: 9 itti: 0.

Baʼii barreessi: ['9 -> '].
Baʼii barreessi: (x bakka: 0), dhaabi. #9

x dabaliduratti: 8.
Baʼii barreessi: ['8 -> '].
Baʼii barreessi: (x bakka: 0), dhaabi. #9


x dabaliboodatti: 10.
Baʼii barreessi: ['10 -> '].
Baʼii barreessi: (x bakka: 4), dhaabi. #10








