
Baʼii barreessi: ['Break for-loop, 0-4.'], dhaabi.
{ :i
	Baʼii barreessi: ['iteration #'] + i, dhaabi.
	(i = 4) adda-kuti.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Baʼii barreessi: ['Break while-true loop, 0-4.'], dhaabi.
{
	Baʼii barreessi: ['iteration #'] + x, dhaabi.
	x idaʼi: 1.
	((x < 5) miti) adda-kuti.
} yemmuuhangafa: xIsLessThan10.

Baʼii barreessi: ['Break while-false loop, 5,4.'], dhaabi.
{
	Baʼii barreessi: ['iteration #'] + x, dhaabi.
	x hiri: 1.
	(x = 3) adda-kuti.
} yemmuuhangafa: { <- (x > 0). }.

Baʼii barreessi: ['Break times loop, 1-4.'], dhaabi.
{ :i
	Baʼii barreessi: ['iteration #'] + i, dhaabi.
	(i = 4) adda-kuti.
} × 5.

Baʼii barreessi: ['Break block, dont print line.'], dhaabi.
{ Dhugaa adda-kuti. Baʼii barreessi: ['dont write this!'], dhaabi. } fiigi.

Baʼii barreessi: ['Break block, dont fire catch...'], dhaabi.
{ Dhugaa adda-kuti. Baʼii barreessi: ['dont write this!'], dhaabi. } qabi: { Baʼii barreessi: ['Dont catch this!']. }, fiigi.

Baʼii barreessi: ['Test Array each-loop: 0,1'], dhaabi.
(Tarree-wantootaa ← 1 ; 2 ; 3) maapin: { :i
	Baʼii barreessi: ['iteration #'] + i, dhaabi.
	(i = 1) adda-kuti.
}.

Baʼii barreessi: ['Test Map each-loop: c only'], dhaabi.
>> m := Galmee-jechootaa haaraa.
m kaaʼi: ['first'] itti: ['a'], kaaʼi: ['second'] itti: ['b'], kaaʼi: ['third'] itti: ['c'].
m hundaaf: { :k :v
	Baʼii barreessi: ['iteration'] + v + k, dhaabi.
	Dhugaa adda-kuti.
}.

