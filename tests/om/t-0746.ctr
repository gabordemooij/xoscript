Baʼii barreessi: ['Test object'], dhaabi.
>> a := Wanta haaraa. 

a irratti: ['item:'] godhi: { :dict
	koo dict := dict. 
}.

a irratti: ['item'] godhi: { <- koo dict.
}.

a item: (
Galmee-jechootaa haaraa
	hello: ['world'],
	world: (Galmee-jechootaa haaraa kaaʼi: ['a'] itti: ['b'])).

Baʼii barreessi: a item, dhaabi.

>> old-dict-address := a item fakkeenya-jalqabaa teessoo-memoorii.
a save-as: ['/tmp/a.bin'].
Baʼii barreessi: ['========== RELOADING SNAP:'], dhaabi.

>> b := Wanta load-from: ['/tmp/a.bin'].

(b item fakkeenya-jalqabaa teessoo-memoorii = old-dict-address) yoodhugaa: {
	Baʼii barreessi: ['Object link re-attached.'], dhaabi.
}.

Baʼii barreessi: b item, dhaabi.
