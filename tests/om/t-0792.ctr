Server init.

>> DB := Maria-DB haaraa keessummeessaa: ['localhost'],
	maqaa-fayyadamaa: ['xo'],
	jecha-icciitii: ['pass123'],
	maqaa-kuusaa-deetaa: ['xobase'],
	walqunnami.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB iyyaafannoo: SQL.

# now you don't have to set DB
query2 fidi: { :row
	Baʼii barreessi: row world, dhaabi.
}.
