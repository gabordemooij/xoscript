Lakkoofsa irratti: ['factorial'] godhi: {
	>> total := 1.
	{ :index total baayisi-tiin: (ofii - (index)). } × ofii. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Baʼii barreessi: a.
>> b := 2 + 3 factorial.
Baʼii barreessi: b.
>> c := 3 factorial + 2.
Baʼii barreessi: c.
>> d := 2 + (3 factorial).
Baʼii barreessi: d.
Baʼii barreessi: 2 + 3 factorial + 1.
