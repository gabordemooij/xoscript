>> phrases := Tarree-wantootaa haaraa
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases hundaaf: { :_ :phrase 
	>> e := Server base64-koodessi: phrase.
	>> d := Server base64-koodii-hiiki: e.
	Baʼii barreessi: (
		message kopii ~encoded: e, ~decoded: d
	), dhaabi.
}.
