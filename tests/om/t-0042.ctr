>> items := Galmee-jechootaa haaraa.
items kaaʼi: ['black'] itti: ['coffee'], kaaʼi: ['earl grey'] itti: ['tea'].
Baʼii barreessi: (items bakka: ['coffee']), barreessi: (items bakka: ['tea']).
Baʼii barreessi: ['there are'] + items lakkaaʼi + [' items in the array.'].
items kaaʼi: ['capuccino'] itti: ['coffee'].
Baʼii barreessi: ['Now my coffee is.. '] + (items bakka: ['coffee']).
items kaaʼi: ['aaa'] itti: ['1'].
items kaaʼi: ['bbb'] itti: ['2'].
Baʼii barreessi: (items bakka: ['a']).
