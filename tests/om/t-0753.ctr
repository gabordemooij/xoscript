Baʼii barreessi: ['Test object'], dhaabi.
>> a := Wanta haaraa. 

a irratti: ['item:'] godhi: { :fmt
	koo fmt := fmt. 
}.

a irratti: ['item'] godhi: { <- koo fmt.
}.

a item: ( Bifa haaraa: ['|%s|'] ).

Baʼii barreessi: a item, dhaabi.

>> old-fmt-address := a item fakkeenya-jalqabaa teessoo-memoorii.
a save-as: ['/tmp/a.bin'].
Baʼii barreessi: ['========== RELOADING SNAP:'], dhaabi.

>> b := Wanta load-from: ['/tmp/a.bin'].

(b item fakkeenya-jalqabaa teessoo-memoorii = old-fmt-address) yoodhugaa: {
	Baʼii barreessi: ['Object link re-attached.'], dhaabi.
}.

Baʼii barreessi: ( b item raawwadhu: ['hello'] ), dhaabi.
