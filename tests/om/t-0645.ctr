Server init.
Baʼii barreessi: ['Database date test'], dhaabi.

>> db := Maria-DB haaraa keessummeessaa: ['localhost'],
	maqaa-fayyadamaa: ['xo'], 
	jecha-icciitii: ['pass123'],
	maqaa-kuusaa-deetaa: ['xobase'],
	walqunnami.

>> ulaagaalee-barbaacha :=
db iyyaafannoo: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
fidi: { :row
	Baʼii barreessi: row datetest, dhaabi.
}.
