{
	hojii-kana dogoggora: ['Dont fail.'].
	unknown doSomething.
} qabi: {
	Baʼii barreessi: ['Caught!'].
}, fiigi.

{
	hojii-kana dogoggora: ['Dont fail.'].
	koo unknown doSomething.
} qabi: {
	Baʼii barreessi: ['Caught!'].
}, fiigi.

{
	hojii-kana dogoggora: ['Dont fail.'].
	unknown := 122.
} qabi: {
	Baʼii barreessi: ['Caught!'].
}, fiigi.


{
	hojii-kana dogoggora: ['Dont fail.'].
	Dhugaa adda-kuti.
	Baʼii barreessi: ['FAIL'].
} qabi: {
	Baʼii barreessi: ['Caught!'].
}, fiigi.

{
	{
		hojii-kana dogoggora: ['Dont fail.'].
		Dhugaa adda-kuti.
		Baʼii barreessi: ['FAIL'].
	} qabi: { :x
		(x = ['Dont fail.']) yoodhugaa: { hojii-kana dogoggora: ['Nested Caught!']. }.
	}, fiigi.
} qabi: { :e
	Baʼii barreessi: e.
}, fiigi.
