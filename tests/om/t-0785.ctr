Baʼii barreessi: ['Test object'], dhaabi.
>> a := Wanta haaraa. 

a irratti: ['item:'] godhi: { :moment
	koo moment := moment. 
}.

a irratti: ['item'] godhi: { <- koo moment.
}.

>> today := Tarree-wantootaa haaraa ; ( Yeroo haaraa naannoo: ['CEST'], bara: 2026, jiʼa: 7 ).
a item: today.
Baʼii barreessi: a item ? 0, dhaabi.
a save-as: ['/tmp/a.bin'].
