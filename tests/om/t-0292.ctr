>> winery := { <- (	Galmee-jechootaa haaraa
		kaaʼi: 2 itti: ['merlot'],
		kaaʼi: 3 itti: ['malbec'],
		kaaʼi: 4 itti: ['syrah']
	).
}.

Baʼii barreessi: (((winery fiigi) - ['nothing']) lakkaaʼi), dhaabi.
Baʼii barreessi: (((winery fiigi) - ['merlot']) lakkaaʼi), dhaabi.
Baʼii barreessi: (((winery fiigi) - ['malbec']) lakkaaʼi), dhaabi.
Baʼii barreessi: (((winery fiigi) - ['syrah']) lakkaaʼi), dhaabi.
Baʼii barreessi: (((winery fiigi) - ['merlot'] - ['malbec']) lakkaaʼi), dhaabi.
Baʼii barreessi: (((winery fiigi) - ['merlot'] - ['syrah']) lakkaaʼi), dhaabi.
Baʼii barreessi: (((winery fiigi) - ['malbec'] -['syrah']) lakkaaʼi), dhaabi.
Baʼii barreessi: (((winery fiigi) - ['malbec'] - ['syrah'] - ['merlot']) lakkaaʼi), dhaabi.

