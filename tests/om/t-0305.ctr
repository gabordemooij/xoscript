
Lakkoofsa baradhu: ['plus:'] malii: ['+'].
Lakkoofsa irratti: ['+'] godhi: { :x
	>> rate := 1.
	>> currency := x ibsaa.
	(currency = ['euros']) yoodhugaa: {
		rate := 2.
	}. <- (ofii plus: (x × rate)).
}.
>> dollars := 3.
>> euros := 2.
dollars ibsaa: ['dollars'].
euros ibsaa: ['euros'].
>> money := dollars + euros.
Baʼii barreessi: money, dhaabi.
