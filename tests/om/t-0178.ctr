

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Sagantaa qulqullina: 0.

>> txt := ['Word Salad'].
Baʼii barreessi: ['last index of ord = '] + (( txt dhumaa: ['ord'] ) - 0), dhaabi.
Baʼii barreessi: ['index of ord = '] + (( txt argadhu: ['ord'] ) - 0), dhaabi.
Baʼii barreessi: ['index of ad = '] + (( txt argadhu: ['ad'] ) - 0), dhaabi.
Baʼii barreessi: ['last index of W = '] + (( txt dhumaa: ['W'] ) - 0), dhaabi.
Baʼii barreessi: ['last index of d = '] + (( txt dhumaa: ['d'] ) - 0), dhaabi.
Baʼii barreessi: ['txt equals Word Salad = '] + ( txt = ['Word Salad'] ), dhaabi.
Baʼii barreessi: ['txt equals Ceasar Salad = '] + ( txt = ['Ceasar Salad'] ), dhaabi.
Baʼii barreessi: ['txt does not equal Word Salad = '] + ( txt ≠ ['Word Salad'] ), dhaabi.
Baʼii barreessi: ['txt does not equal Ceasar Salad = '] + ( txt ≠ ['Ceasar Salad'] ), dhaabi.

