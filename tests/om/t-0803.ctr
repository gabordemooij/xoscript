#...
>> del := conn1 iyyaafannoo: ['DELETE FROM book WHERE id > 0'].
{  del hojiirra-oolchi. conn1 mirkaneessi. } qabi: { :e conn1 duubatti-deebisi.  }, fiigi.

>> insert := conn1 iyyaafannoo: ['INSERT INTO book (id) VALUES(null)'].
insert hojiirra-oolchi.

>> lakkaaʼi := conn1 iyyaafannoo: ['SELECT COUNT(*) AS num FROM book'].
lakkaaʼi fidi: { :row Baʼii barreessi: row num, dhaabi. }.

# does not show up
# insert not committed on connection 1
>> lakkaaʼi := conn2 iyyaafannoo: ['SELECT COUNT(*) AS num FROM book'].
lakkaaʼi fidi: { :row Baʼii barreessi: row num, dhaabi. }.
