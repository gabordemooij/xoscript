Baʼii barreessi: ['Test object'], dhaabi.
>> a := Wanta haaraa. 

a irratti: ['item:'] godhi: { :octhelper
	koo octhelper := octhelper. 
}.

a irratti: ['item'] godhi: { <- koo octhelper.
}.

a item: Oct haaraa.

>> old-octhelper-address := a item fakkeenya-jalqabaa teessoo-memoorii.
a save-as: ['/tmp/a.bin'].
Baʼii barreessi: ['========== RELOADING SNAP:'], dhaabi.

>> b := Wanta load-from: ['/tmp/a.bin'].

(b item fakkeenya-jalqabaa teessoo-memoorii = old-octhelper-address) yoodhugaa: {
	Baʼii barreessi: ['Object link re-attached.'], dhaabi.
}.
