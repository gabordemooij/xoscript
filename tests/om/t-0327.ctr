

Tarree-wantootaa irratti: ['fixture:'] godhi: { :f
	koo fixture := f.
}.

Tarree-wantootaa irratti: ['lakkaaʼi'] godhi: { <- koo fixture.
}.

Tarree-wantootaa irratti: ['aantal'] godhi: { <- koo fixture.
}.


>> x := Homaa.
{

	x := ['hello'] 
	bakka-buusi:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] qubee: 2)
			)
		)
	tiin: (
		(['...hal'] + ['lo']) 
			ascii-guddaa 
			lowecase 
			ascii-guddaa 
			darbi: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Tarree-wantootaa ← 0 ; 1 ; 4; 9 ; (Tarree-wantootaa ← 0 ; 3; 1) ; 4
							) dhumaa-lammata
						) ? 1
					) + 
					((Tarree-wantootaa ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					lakkaaʼi
				)
			)
	).

} × 10.
Baʼii barreessi: x, dhaabi.

