
Barreeffama irratti: ['evaluate'] godhi: {
	>> koodii := Faayila haaraa: ['/tmp/eval.ctr'].
	koodii barreessi: (ofii gara-barreeffamaatti + ['.']).
	Sagantaa fayyadami: ['/tmp/eval.ctr'].
}.

>> map :=
	(Galmee-jechootaa haaraa)
	kaaʼi: ['Hi There'] itti: ['two'],
	kaaʼi: (Tarree-wantootaa ← ['hello'] ; ['world'] ; (Tarree-wantootaa ← 1 ; 2; 9) ; Soba) itti: ['one'],
	kaaʼi: ( (Galmee-jechootaa haaraa) kaaʼi: ['wrrld'] itti: ['misspelled'] ) itti: ['three'],
	kaaʼi: (Tarree-wantootaa ← ((Galmee-jechootaa haaraa) kaaʼi: ['treasure'] itti: ['hidden']) ; 2) itti: ['four']. 
>> str := map gara-barreeffamaatti.
>> map2 := Homaa.
(['map2 := '] + str ) evaluate.
Baʼii barreessi: map2 ? ['one'] ? 0.
Baʼii barreessi: map2 ? ['one'] ? 1.
Baʼii barreessi: map2 ? ['four'] ? 0 ? ['hidden'].
Baʼii barreessi: map2 ? ['one'] ? 2 ? 2.
