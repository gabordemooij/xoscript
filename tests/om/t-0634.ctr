# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Sagantaa shell-escape: ['abc'].
Baʼii barreessi: c, dhaabi.
Baʼii barreessi: ( Sagantaa shelli: ['echo '] + c ), dhaabi.

c := Sagantaa shell-escape: ['a'b'c'].
Baʼii barreessi: c, dhaabi.
Baʼii barreessi: ( Sagantaa shelli: ['echo '] + c ), dhaabi.

c := Sagantaa shell-escape: ['a\'c'].
Baʼii barreessi: c, dhaabi.
Baʼii barreessi: ( Sagantaa shelli: ['echo '] + c ), dhaabi.