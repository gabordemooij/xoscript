
Tarree-wantootaa irratti: ['product'] godhi: {
	>> total := 1.
	ofii hundaaf: { :index :element
		total baayisi-tiin: element.
	}. <- total.
}.

>> a := Tarree-wantootaa ← 1 ; 2 ; 3.
Baʼii barreessi: a product, dhaabi.
Baʼii barreessi: (Tarree-wantootaa ← 2 ; 4 ; 8) product, dhaabi. 
Baʼii barreessi: (Tarree-wantootaa ← -2 ; 10) product, dhaabi. 
Baʼii barreessi: (Tarree-wantootaa ← 0.5 ; -2) product, dhaabi. 
