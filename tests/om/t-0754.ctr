Baʼii barreessi: ['Test object'], dhaabi.
>> a := Wanta haaraa. 

a irratti: ['item:'] godhi: { :out
	koo out := out. 
}.

a irratti: ['item'] godhi: { <- koo out.
}.

a irratti: ['greet'] godhi: {
	Baʼii barreessi: ['hi from original out!'], dhaabi.
}.

a item: Baʼii.

Baʼii barreessi: a item, dhaabi.

>> old-out-address := a item fakkeenya-jalqabaa teessoo-memoorii.
a save-as: ['/tmp/a.bin'].
Baʼii barreessi: ['========== RELOADING SNAP:'], dhaabi.

>> b := Wanta load-from: ['/tmp/a.bin'].

(b item fakkeenya-jalqabaa teessoo-memoorii = old-out-address) yoodhugaa: {
	Baʼii barreessi: ['Object link re-attached.'], dhaabi.
}.

b item barreessi: ['hello from loaded out!'], dhaabi.
b greet.
