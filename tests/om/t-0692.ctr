Server init.

Baʼii barreessi: (
	Akkaataa haaraa: ['^\\w+$'],
	walsimannaa: ['test@example.com'] 
), dhaabi. # 0 match, fails on @ and .

Baʼii barreessi: (
	Akkaataa haaraa: ['^[^@]+@[^\.]+\.\\w+$'],
	walsimannaa: ['test@example.com'] 
), dhaabi. # 1 match

Baʼii barreessi: (
	Akkaataa haaraa: ['[^@]+@[^\.]+\.\\w+'],
	walsimannaa: ['test@example.com'] 
), dhaabi. # 1 match

Baʼii barreessi: (
	Akkaataa haaraa: ['([^@]+)@([^\.]+)\.\\w+'],
	walsimannaa: ['test@example.com'] 
), dhaabi. # 1 match, groups dont matter

Baʼii barreessi: (
	Akkaataa haaraa: ['[a-z]'],
	walsimannaa: ['test@example.com'] 
), dhaabi. # 14 matches

Baʼii barreessi: (
	Akkaataa haaraa: ['.*'],
	walsimannaa: ['test@example.com'] 
), dhaabi. # 1 match (all)

Baʼii barreessi: (
	Akkaataa haaraa: ['(.*)'],
	walsimannaa: ['test@example.com'] 
), dhaabi. # 1 match (all)

Baʼii barreessi: (
	Akkaataa haaraa: ['\\s*[^@]+@[^\.]+\.\\w+'],
	walsimannaa: ['test@example.com'] 
), dhaabi. # 1 match, prefix space optional, gets ignored