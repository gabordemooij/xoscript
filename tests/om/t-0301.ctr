


>> wine := Wanta haaraa.


wine irratti: ['toString'] godhi: { <- ['merlot'].
}.

wine irratti: ['naarTekst'] godhi: { <- ['merlot'].
}.


wine irratti: ['='] godhi: { :other wine <- ( ofii toString = other wine ).
}.

wine irratti: ['=='] godhi: { :other wine <- ( ofii toString = other wine ).
}.



wine
	haala: ['cabernet'] godhi: { Baʼii barreessi: ['it's a Cabernet!']. },
	haala: ['syrah']    godhi: { Baʼii barreessi: ['it's a Syrah!'].    },
	haala: ['merlot']   godhi: { Baʼii barreessi: ['it's a Merlot!'].   },
	haala: ['malbec']   godhi: { Baʼii barreessi: ['it's a Malbec!'].   }.

Baʼii dhaabi.
