
>> Animal := Wanta haaraa.
Animal irratti: ['haaraa'] godhi: { <- ofii haaraa init.
}.

Animal irratti: ['init'] godhi: {
	koo sound := ['?'].
	koo legs := 4.
}.

>> Dog := Animal haaraa.
Dog irratti: ['init'] godhi: {
	ofii init.
	koo sound := ['barks'].
}.

Animal irratti: ['gara-barreeffamaatti'] godhi: { <- koo legs gara-barreeffamaatti + koo sound.
}.

>> poodle := Dog haaraa.
Baʼii barreessi: poodle, dhaabi.

