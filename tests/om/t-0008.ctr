>> Greeter := Wanta haaraa.
Greeter irratti: ['make'] godhi: {
	>> greeter := Wanta haaraa.
	greeter irratti: ['name:'] godhi: { :maqaa
		Baʼii barreessi: ['setting a name'].
		koo myName := maqaa.
	}.
	greeter irratti: ['greet'] godhi: {
		Baʼii barreessi: ['Hello'].
		Baʼii barreessi: koo myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
