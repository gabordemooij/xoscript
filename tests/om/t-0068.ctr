>> w := ['A_bottle_of_Whisky and a rare steak.'].
Baʼii barreessi: ['=== Basic test, grab the bottle! ==='], dhaabi.
Baʼii barreessi: ['>']+(w kopii irraa:2 dheerina: 6), dhaabi.
Baʼii barreessi: ['>']+(w kopii irraa:8 dheerina: -6), dhaabi.
Baʼii barreessi: ['>']+(w kopii irraa:2 dheerina: 6), dhaabi.
Baʼii barreessi: ['>']+(w kopii irraa:8 dheerina: -6), dhaabi.
Baʼii barreessi: ['=== Take a single char ==='], dhaabi.
Baʼii barreessi: ['>']+(w kopii irraa:7 dheerina: 1), dhaabi.
Baʼii barreessi: ['>']+(w kopii irraa:7 dheerina: 1), dhaabi.
Baʼii barreessi: ['=== The 0 case, empty string ==='], dhaabi.
Baʼii barreessi: ['>']+(w kopii irraa:7 dheerina: 0), dhaabi.
Baʼii barreessi: ['>']+(w kopii irraa:7 dheerina: 0), dhaabi.
Baʼii barreessi: ['=== Edge case, first character only ==='], dhaabi.
Baʼii barreessi: ['>']+(w kopii irraa:0 dheerina: 1), dhaabi.
Baʼii barreessi: ['>']+(w kopii irraa:0 dheerina: 1), dhaabi.
Baʼii barreessi: ['>']+(w kopii irraa:1 dheerina: -1), dhaabi.
Baʼii barreessi: ['>']+(w kopii irraa:1 dheerina: -1), dhaabi.
Baʼii barreessi: ['=== Edge case, last character only ==='], dhaabi.
Baʼii barreessi: ['>']+(w kopii irraa:35 dheerina: 1), dhaabi.
Baʼii barreessi: ['>']+(w kopii irraa:35 dheerina: 1), dhaabi.
Baʼii barreessi: ['>']+(w kopii irraa:36 dheerina: -1), dhaabi.
Baʼii barreessi: ['>']+(w kopii irraa:36 dheerina: -1), dhaabi.
Baʼii barreessi: ['=== Out of bounds, empty string ==='], dhaabi.
Baʼii barreessi: ['>']+(w kopii irraa:36 dheerina: 37), dhaabi.
Baʼii barreessi: ['>']+(w kopii irraa:36 dheerina: 47), dhaabi.
Baʼii barreessi: ['>']+(w kopii irraa:-1 dheerina: -2), dhaabi.
Baʼii barreessi: ['>']+(w kopii irraa:-2 dheerina: -1), dhaabi.
Baʼii barreessi: ['=== Part out of bounds, full string ==='], dhaabi.
Baʼii barreessi: ['>']+(w kopii irraa:-20 dheerina: 90), dhaabi.
Baʼii barreessi: ['>']+(w kopii irraa:90 dheerina: -20), dhaabi.
Baʼii barreessi: ['>']+(w kopii irraa:-20 dheerina: 90), dhaabi.
Baʼii barreessi: ['>']+(w kopii irraa:90 dheerina: -120), dhaabi.
