Sagantaa qulqullina: 4.

>> oops := 0.
{
	{ 3 ÷ 0. } qabi: {
		oops idaʼi: 1.
	}, fiigi.
} × 1000.

{
	Baʼii barreessi: ['hi there!'].
	hojii-kana dogoggora: ['oops'].
	Baʼii barreessi: ['hi there!'].
	{ Baʼii barreessi: ['dont print this']. } fiigi.
} qabi: { :e 
	Baʼii barreessi: ['got ya!']. 
	Baʼii barreessi: e.
}, fiigi.
