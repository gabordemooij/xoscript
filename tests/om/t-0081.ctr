>> map1 := Galmee-jechootaa haaraa.
>> key1 := Tarree-wantootaa haaraa.
>> key2 := Tarree-wantootaa haaraa.

map1
	kaaʼi: ['hello'] itti: key1,
	kaaʼi: ['world'] itti: key2.


Baʼii
	barreessi: ['Map #1 contains: '] + (map1 bakka: key1),
	barreessi: [' and '] + (map1 bakka: key2), dhaabi.

>> KeyeableArray := Tarree-wantootaa haaraa.
KeyeableArray irratti: ['toString'] godhi: { <- (ofii lakkaaʼi) toString.
}.

>> map2 := Galmee-jechootaa haaraa.
key1 := KeyeableArray haaraa.
key2 := KeyeableArray haaraa.

key1 dabaliboodatti: 1.

map2
	kaaʼi: ['hello'] itti: key1,
	kaaʼi: ['world'] itti: key2.

Baʼii
	barreessi: ['Map #2 contains: '] + (map2 bakka: key1),
	barreessi: [' and '] + (map2 bakka: key2), dhaabi.
