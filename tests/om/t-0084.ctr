>> makeAdder := { :x
	>> f := { :y <- (koo x + y). } kaaʼi: ['x'] gatii: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i koo q kaaʼi: (koo f raawwadhu: (koo q ? i)) itti: i. } 
	kaaʼi: ['q'] gatii: array,
	kaaʼi: ['f'] gatii: func.
	{ :i mapping raawwadhu: i. } × (array lakkaaʼi).
}.

>> a := Tarree-wantootaa ← 1; 2; 3.
mapper raawwadhu: a fi: (makeAdder raawwadhu: 100).
Baʼii barreessi: (a iddoo: 0), dhaabi.
Baʼii barreessi: (a ? 1), dhaabi.
Baʼii barreessi: (a ? 2), dhaabi.
