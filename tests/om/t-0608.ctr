
>> Size := Wanta haaraa.
Size irratti: ['is:'] godhi: { :gara-lakkoofsaatti
	gara-lakkoofsaatti irratti: ['+'] godhi: { :gara-lakkoofsaatti
		>> unit := gara-lakkoofsaatti ibsaa.
		>> factor := 1.
		
		unit
		haala: ['inch'] godhi: { factor := 0.0833. }. <- ofii + (gara-lakkoofsaatti * factor).
	}. <- gara-lakkoofsaatti.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Baʼii barreessi: plank + edge, dhaabi.
