Baʼii barreessi: ['Test object'], dhaabi.
>> a := Wanta haaraa. 
a irratti: ['item:'] godhi: { :int64
	koo int64 := int64. 
}.
a irratti: ['item'] godhi: { <- koo int64.
}.
a item: ( Int64 barreeffama-irraa: ['9999'] ).
Baʼii barreessi: a item, dhaabi.
>> old-int64-address := a item fakkeenya-jalqabaa teessoo-memoorii.
a save-as: ['/tmp/a.bin'].
Baʼii barreessi: ['========== RELOADING SNAP:'], dhaabi.
>> b := Wanta load-from: ['/tmp/a.bin'].
(b item fakkeenya-jalqabaa teessoo-memoorii = old-int64-address) yoodhugaa: {
	Baʼii barreessi: ['Object link re-attached.'], dhaabi.
}.
Baʼii barreessi: ( b item ), dhaabi.
