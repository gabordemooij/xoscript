#OBSD
>> dirname := [''].
{ dirname dabaliboodatti: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Sagantaa shelli: command.
Sagantaa chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename dabaliboodatti: ['YYYYYYYY']. } * 20.
Faayila haaraa: filename, barreessi: ['sometext'].
{ Faayila tarree: ['/tmp/'] + dirname. } * 1000.
Baʼii barreessi: ['no crash'], dhaabi.

