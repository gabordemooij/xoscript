# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Akkaataa haaraa: pattern.
	p walsimannaa: subject godhi: { :m :g
		Baʼii barreessi: g lakkaaʼi, barreessi: [' '], barreessi: (g waliingalchi: ['|']), dhaabi. <- m.
	}.
}.
show raawwadhu: ['(a)|(b)'] fi: ['b'].
show raawwadhu: ['(a)|(b)'] fi: ['a'].
show raawwadhu: ['(x)?y'] fi: ['y'].
show raawwadhu: ['(x)?(y)(z)?'] fi: ['xy'].
