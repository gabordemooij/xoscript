


>> CoffeeMachine := Wanta haaraa.
CoffeeMachine irratti: ['order:'] godhi: { :id
	>> coffee := ['Americano'].
	( id = 1 ) yoodhugaa: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) yoodhugaa: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) yoodhugaa: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Wanta haaraa.
SimpleCoffeeMachine irratti: ['order'] godhi: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Baʼii barreessi: redCup, dhaabi.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Baʼii barreessi: greenCup, dhaabi.
>> yellowCup := CoffeeMachine order: 1.
Baʼii barreessi: yellowCup, dhaabi.
>> blueCup := CoffeeMachine order: 0.
Baʼii barreessi: blueCup, dhaabi.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Baʼii barreessi: blackCup, dhaabi.
blackCup dabaliboodatti: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Baʼii barreessi: orangeCup, dhaabi.
