Baʼii barreessi: ['Continue for-loop, No - before 6 and up.'], dhaabi.
{ :i
	Baʼii barreessi: (i + 1), dhaabi.
	((i + 1) > 4) itti-fufi.
	Baʼii barreessi: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Baʼii dhaabi.
Baʼii barreessi: ['Continue while-true, No --> before 5 and up.'], dhaabi.
{
	Baʼii barreessi: ['iteration #'] + x, dhaabi.
	x idaʼi: 1.
	((x < 5) miti) itti-fufi.
	Baʼii barreessi: ['-->'].
} yemmuuhangafa: xIsLessThan10.
Baʼii dhaabi.
Baʼii barreessi: ['Continue while-false, No - before 3 only.'], dhaabi.
{
	Baʼii barreessi: ['iteration #'] + x, dhaabi.
	x hiri: 1.
	(x = 3) itti-fufi.
	Baʼii barreessi: ['-'].
} yemmuuhangafa: { <- ( x > 0). }.

Baʼii dhaabi.
Baʼii barreessi: ['Continue times-loop, No ||| before 3.'], dhaabi.
{ :i
	Baʼii barreessi: ['iteration #'] + i, dhaabi.
	(i = 2) itti-fufi.
	Baʼii barreessi: ['|||'].
} × 5.

Baʼii dhaabi.

{ Dhugaa itti-fufi. Baʼii barreessi: ['dont write this!'], dhaabi. } fiigi.

{ Dhugaa itti-fufi. Baʼii barreessi: ['dont write this!'], dhaabi. } qabi: { Baʼii barreessi: ['Dont catch this!']. }, fiigi.

Baʼii barreessi: ['Test Array each-loop: 0, ... ,2'], dhaabi.
(Tarree-wantootaa ← 1 ; 2 ; 3) maapin: { :i
	(i = 1) itti-fufi.
	Baʼii barreessi: ['iteration #'] + (i - 0), dhaabi.
}.

Baʼii barreessi: ['Test Map each-loop: c only'], dhaabi.
>> m := Galmee-jechootaa haaraa.
m kaaʼi: ['first'] itti: ['a'], kaaʼi: ['second'] itti: ['b'], kaaʼi: ['third'] itti: ['c'].
m hundaaf: { :k :v
	(k ≠ ['c']) itti-fufi.
	Baʼii barreessi: ['iteration'] + k + v, dhaabi.
}.

