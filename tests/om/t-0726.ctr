# test buffers PKI/Sign 
Server init.

>> long := ( Tarree-wantootaa haaraa guuti: 1000 tiin: ['a'] ) waliingalchi: [''].

# sign a message
Baʼii barreessi: ( 
	Kuusaa-nageenyaa mallatteessi: ['abc'] furtuun: long
), dhaabi.

Baʼii barreessi: ( 
	Kuusaa-nageenyaa
		sakattaʼi: ['abc'] 
		mallattoo: long 
		furtuun: long
), dhaabi.

Baʼii barreessi: (
	Kuusaa-nageenyaa haashii-jecha-icciitii: long mirkaneessi: long
), dhaabi.
