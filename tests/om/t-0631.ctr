#ffi test


Server init.

Sagantaa qulqullina: 4.

# for this test you need set a path to libc (puts)
>> libname := Sagantaa qindaaʼina: ['FFITESTLIB'].



Server walqabsiisi: (
 Tarree-wantootaa haaraa ;
 libname ;
 ['puts'] ;
 ( Tarree-wantootaa haaraa ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s gadi-lakkisi.

# test with struct

>> a := Blob haaraa: 8.
a bytes: (
	Tarree-wantootaa <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Tarree-wantootaa <<: ['int'], ; ['int']).

Server walqabsiisi: (
	Tarree-wantootaa <<: ['@structtest'], ;
	['@structtest'] ;
	(Tarree-wantootaa <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Baʼii barreessi: ['Sum test:'] + (ffitest ffisum: a), dhaabi.

struct gadi-lakkisi-struct.
struct gadi-lakkisi.
a gadi-lakkisi.
