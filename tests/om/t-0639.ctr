
Server init.
Baʼii barreessi: ['Database test'], dhaabi.

>> db := Maria-DB haaraa keessummeessaa: ['localhost'],
	maqaa-fayyadamaa: ['xo'], 
	jecha-icciitii: ['pass123'],
	maqaa-kuusaa-deetaa: ['xobase'],
	walqunnami.

>> ulaagaalee-barbaacha :=
db iyyaafannoo: ['SELECT REPEAT('Blah',1000) AS blah'], 
fidi: { :row 
	Baʼii barreessi: row blah dheerina, dhaabi.
}.
