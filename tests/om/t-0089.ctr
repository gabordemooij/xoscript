>> randomizer := { :a :b
	>> xiqqaa := ( a < b ) tokkoykn: a ykn: b.
	>> guddaa := ( a > b ) tokkoykn: a ykn: b.
	>> x := Homaa.
	{
		x := Lakkoofsa gidduu: a fi: b.
		((x < xiqqaa) ykn: (x > guddaa)) yoodhugaa: { 
			Baʼii barreessi: (['Invalid value!']).
			Sagantaa dhuma.
		}.
	} 
	× 100. <- x.
}.
randomizer raawwadhu: 0 fi: 0.
randomizer raawwadhu: 1 fi: 0.
randomizer raawwadhu: 1 fi: 1.
randomizer raawwadhu: 0 fi: 1.
randomizer raawwadhu: -1 fi: 0.
randomizer raawwadhu: -1 fi: -1.
randomizer raawwadhu: 0 fi: -1.
randomizer raawwadhu: 100 fi: 200.
randomizer raawwadhu: 999999999999998 fi: 999999999999999.
randomizer raawwadhu: 999999999999999 fi: 999999999999998.
randomizer raawwadhu: 999999999999999 fi: 999999999999999.
randomizer raawwadhu: -999999999999998 fi: -999999999999999.
randomizer raawwadhu: -999999999999999 fi: -999999999999998.
randomizer raawwadhu: -999999999999999 fi: -999999999999999.
randomizer raawwadhu: 999999999999998 fi: -999999999999999.
randomizer raawwadhu: 999999999999999 fi: -999999999999998.
randomizer raawwadhu: 999999999999999 fi: -999999999999999.
randomizer raawwadhu: -999999999999998 fi: 999999999999999.
randomizer raawwadhu: -999999999999999 fi: 999999999999998.
randomizer raawwadhu: -999999999999999 fi: 999999999999999.
