#Linux
>> OS := Sagantaa shelli: (Ajaja uname -s), halaga-naannawa-balleessi.

>> Slurp := Wanta haaraa.
Slurp irratti: ['haaraa'] godhi: {
	koo str := [''].
}.
Slurp irratti: ['deebii-kenni:'] godhi: { :blah
		(koo str ≠ ['']) yoodhugaa: {
			koo str dabaliboodatti: [' '].
		}.
		koo str dabaliboodatti: blah.
}.
Slurp irratti: ['deebii-kenni:fi:'] godhi: { :blah :blahah
		(koo str ≠ ['']) yoodhugaa: {
			koo str dabaliboodatti: [' '].
		}.
		(blah dheerina > 1) yoodhugaa: {
			koo str dabaliboodatti: (blah irraa: 0 dheerina: (blah dheerina - 1)).
		}, yoobaate: {
			koo str dabaliboodatti: blah.
		}.
		koo str dabaliboodatti: [' '].
		koo str dabaliboodatti: blahah.
}.
Slurp irratti: ['obtain'] godhi: {
	>> buffer := koo str.
	koo str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text dabaliboodatti: ['hello'].
} × 1000.


Baʼii barreessi: (
	Sagantaa shelli: (
		Slurp haaraa
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

