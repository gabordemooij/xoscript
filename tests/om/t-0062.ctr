Buuliyaanii irratti: ['xor:'] godhi: { :a :b <- ((a fi: b miti) ykn: (a miti fi: b)).
}.

>> o := Wanta haaraa.
o irratti: ['hello'] godhi: { ['Empty']. }.
{ o irratti: 2 godhi: 3.} qabi: { :e Baʼii barreessi: e, dhaabi. }, fiigi.
{ o irratti: ['qormaata'] godhi: 3.} qabi: { :e Baʼii barreessi: e, dhaabi. }, fiigi.
{ o irratti: ['hello'] godhi: { ['Empty']. }.} qabi: { :e Baʼii barreessi: e, dhaabi. }, fiigi. 
{ >> z := 4 ÷ 0. } qabi: { :e Baʼii barreessi: e, dhaabi. }, fiigi. 
{ (Dhugaa fi: Homaa) yoodhugaa: { Baʼii barreessi: ['X'].}. } qabi: { :e Baʼii barreessi: e, dhaabi. }, fiigi. 
{ ([''] xor: 0) yoodhugaa: { Baʼii barreessi: ['X'].}. } qabi: { :e Baʼii barreessi: e, dhaabi. }, fiigi. 
{ (1 < ['2']) yoodhugaa: { Baʼii barreessi: ['OK']. }. } qabi: { :e Baʼii barreessi: e, dhaabi. }, fiigi. 
{ (1 < ['2.0']) yoodhugaa: { Baʼii barreessi: ['OK']. }. } qabi: { :e Baʼii barreessi: e, dhaabi. }, fiigi. 
{ (1 < ['x2.0']) yoodhugaa: { Baʼii barreessi: ['NO!']. }. } qabi: { :e Baʼii barreessi: e, dhaabi. }, fiigi. 
{ Baʼii barreessi: (['hello OK there'] irraa: ['6'] dheerina: ['2']). } fiigi. 
