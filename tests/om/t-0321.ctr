# test qualifiers

Sagantaa qulqulleessi-memoorii.

>> Fruit := Wanta haaraa.
Fruit irratti: ['haaraa'] godhi: {
	>> f := ofii haaraa.
	f apples: 0. <- f.
}.
Fruit irratti: ['apples:'] godhi: { :a koo apples := a. }.
Fruit irratti: ['apples'] godhi: { <- koo apples. }.
Fruit irratti: ['+'] godhi: { :f
	>> n := Fruit haaraa.
	n apples: (f apples + koo apples). <- n.
}.
Lakkoofsa irratti: ['apples'] godhi: { <- ((Fruit haaraa) apples: ofii).
}.

Fruit irratti: ['gara-barreeffamaatti'] godhi: { <- koo apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Baʼii barreessi: q, dhaabi.




q := 3 apples + 4 apples.
Baʼii barreessi: q, dhaabi.



q := 3 apples + 4 apples.
Baʼii barreessi: q, dhaabi.


