Server init.

>> DB := Maria-DB haaraa keessummeessaa: ['localhost'],
	maqaa-fayyadamaa: ['xo'],
	jecha-icciitii: ['pass123'],
	maqaa-kuusaa-deetaa: ['xobase'],
	walqunnami.

{
	DB iyyaafannoo:
	['DROP TABLE movies'],
	hojiirra-oolchi.
} qabi: { Homaa. }, fiigi.

DB iyyaafannoo:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
hojiirra-oolchi.

DB iyyaafannoo: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
ulaagaalee: ( Tarree-wantootaa haaraa ; ['Halloween'] ),
hojiirra-oolchi.

DB iyyaafannoo: ['SELECT * FROM movies'],
fidi: { :movie
	Baʼii barreessi: movie title, dhaabi.
}.

