Sagantaa qulqullina: 4.

>> Doubler := Wanta haaraa.
>> Multiplier := Wanta haaraa.
Doubler irratti: ['double:and:'] godhi: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier irratti: ['multiply:and:'] godhi: { :x :y <- (x × y).
}.

Baʼii barreessi: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), dhaabi.
