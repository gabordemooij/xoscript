Baʼii barreessi: ['Test object'], dhaabi.
>> a := Wanta haaraa. 

a irratti: ['item:'] godhi: { :binhelper
	koo binhelper := binhelper. 
}.

a irratti: ['item'] godhi: { <- koo binhelper.
}.

a item: Bin haaraa.

>> old-binhelper-address := a item fakkeenya-jalqabaa teessoo-memoorii.
a save-as: ['/tmp/a.bin'].
Baʼii barreessi: ['========== RELOADING SNAP:'], dhaabi.

>> b := Wanta load-from: ['/tmp/a.bin'].

(b item fakkeenya-jalqabaa teessoo-memoorii = old-binhelper-address) yoodhugaa: {
	Baʼii barreessi: ['Object link re-attached.'], dhaabi.
}.


