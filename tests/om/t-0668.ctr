# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob haaraa: 8, bytes: (
	Tarree-wantootaa haaraa ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Baʼii barreessi: ( utf16 koodii-hiiki: ['utf16le'] ), dhaabi.

utf16 gadi-lakkisi.
>> utf32 := Blob haaraa: 13, bytes: (
	Tarree-wantootaa haaraa ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Baʼii barreessi: ( utf32 koodii-hiiki: ['utf32be'] ), dhaabi.
utf32 gadi-lakkisi.