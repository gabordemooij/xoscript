

Tarree-wantootaa irratti: ['column:'] godhi: { :column
	>> result := Tarree-wantootaa haaraa.
	ofii hundaaf: { :index :row
		row hundaaf: { :index :cell
			(index = column) yoodhugaa: { result dabaliboodatti: cell. }.
		}.
	}. <- result.
}.


>> a := Tarree-wantootaa ←
	(Tarree-wantootaa ← 1 ; 2 ; 3) ;
	(Tarree-wantootaa ← 4 ; 5 ; 6) ;
	(Tarree-wantootaa ← 7 ; 8 ; 9).

>> b := a column: 1.
Baʼii barreessi: b, dhaabi.

b := a column: 20.
Baʼii barreessi: b, dhaabi.

b := a column: -100.
Baʼii barreessi: b, dhaabi.
