
>> dictionary := (
	Galmee-jechootaa haaraa
		kaaʼi: ['b'] itti: ['a'],
		kaaʼi: ['a'] itti: ['b'],
		kaaʼi: ['z'] itti: ['x'],
		kaaʼi: ['hello'] itti: ['hallo'],
		kaaʼi: ['human'] itti: ['human']
).

>> comparisons := Tarree-wantootaa haaraa.
dictionary hundaaf: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a walbira-qabi: b)
	).
}.

comparisons tarreessi: { :a :b <- ( a walbira-qabi: b ). }.
Baʼii barreessi: ( comparisons waliingalchi: ['↵'] ), dhaabi.
comparisons waliingalchi: ['↵'].
