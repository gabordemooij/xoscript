Tarree-wantootaa irratti: ['sum'] godhi: {
	>> total := 0.
	ofii hundaaf: { :index :element
		total idaʼi: element.
	}. <- total.
}.

>> a := Dhugaa.



a irratti: ['gara-barreeffamaatti'] godhi: {
	>> answer := Homaa.
	( ofii = Dhugaa ) yoodhugaa: {
		answer := ['Yep'].
	}, yoobaate: {
		answer := ['Nope'].
	}. <- answer.
}.

a irratti: ['gara-lakkoofsaatti'] godhi: {
	>> answer := Homaa.
	( ofii = Dhugaa ) yoodhugaa: {
		answer := 10.
	}, yoobaate: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b irratti: ['gara-barreeffamaatti'] godhi: { <- ['Devil'].
}.

b irratti: ['buuliyaanii'] godhi: { <- Soba.
}.


Baʼii barreessi: a, dhaabi.  
Baʼii barreessi: (90 + a), dhaabi. 
Baʼii barreessi: b, dhaabi. 
Baʼii barreessi: (Dhugaa fi: b), dhaabi.

a := Tarree-wantootaa ← ['hello'] ; ['world'] ; Dhugaa ; Homaa ; 666. 
a := a + ( Tarree-wantootaa ← 1 ).
Baʼii barreessi: a, dhaabi.
Baʼii barreessi: ((Galmee-jechootaa haaraa) kaaʼi: Homaa itti: Homaa), dhaabi.
Baʼii barreessi: a sum, dhaabi. 


{
	a irratti: ['gara-barreeffamaatti'] godhi: { <- Homaa. }.
	a := [''] + a.
} qabi: { :error
	Baʼii barreessi: ['Error noted: '] + error, dhaabi.
}, fiigi.



{
	a irratti: ['gara-lakkoofsaatti'] godhi: { <- Homaa. }.
	a := 3 × a.
} qabi: { :error
	Baʼii barreessi: ['Error noted: '] + error, dhaabi.
}, fiigi.


{
	a irratti: ['buuliyaanii'] godhi: { <- Homaa. }.
	a := Dhugaa fi: a. 
} qabi: { :error
	Baʼii barreessi: ['Error noted: '] + error, dhaabi.
}, fiigi.





{
	a irratti: ['gara-barreeffamaatti'] godhi: { <- Soba. }.
	a := [''] + a.
} qabi: { :error
	Baʼii barreessi: ['Error noted: '] + error, dhaabi.
}, fiigi.



{
	a irratti: ['gara-lakkoofsaatti'] godhi: { <- Dhugaa. }.
	a := 3 × a.
} qabi: { :error
	Baʼii barreessi: ['Error noted: '] + error, dhaabi.
}, fiigi.


{
	a irratti: ['boolean'] godhi: { <- 1. }.
	a := Dhugaa fi: a.
} qabi: { :error
	Baʼii barreessi: ['Error noted: '] + error, dhaabi.
}, fiigi.





