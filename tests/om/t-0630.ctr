#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Akkaataa haaraa: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern walsimannaa: subject godhi: { :m :x
	Baʼii barreessi: m, dhaabi.
	Baʼii barreessi: x, dhaabi. <- ['XXX'].
}.
Baʼii barreessi: result, dhaabi.