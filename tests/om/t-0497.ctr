Server init.

# write a test file
>> f := Faayila haaraa: ['/tmp/test.gif'].
f barreessi: ['GIF87a01234567810'].

# serve the file
Server dabarsi: ['test.gif'] durduubee: ['/tmp/'].

Baʼii dhaabi.

Baʼii barreessi: ['Outside container (security):'], dhaabi.
{ Server dabarsi: ['../passwd'] durduubee: ['/tmp/']. }
qabi: { :e Baʼii barreessi: e, dhaabi. },
fiigi.

Baʼii barreessi: ['Invalid prefix:'], dhaabi.
{ Server dabarsi: ['test.gif'] durduubee: ['z:\\']. }
qabi: { :e Baʼii barreessi: e, dhaabi. },
fiigi.

Baʼii barreessi: ['Non-existant file:'], dhaabi.
{ Server dabarsi: ['xxx.xxx'] durduubee: ['/tmp/']. }
qabi: { :e Baʼii barreessi: e, dhaabi. },
fiigi.
