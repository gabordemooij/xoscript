
>> animal := Wanta haaraa. 
 
 animal irratti: ['name:'] godhi: { :n
koo maqaa := n.
}. 


animal name: ['Diva']. 
 
animal irratti: ['maqaa'] godhi: { <- maqaa.
}.

>> cat := animal haaraa.
 
 cat name: ['Diva']. 
 
 cat irratti: ['maqaa'] godhi: { <- ['your royal highness ']
+ (ofii maqaa).
}.

Baʼii barreessi: cat maqaa.
