#Linux
>> OS := Sagantaa qindaaʼina: ['OS'].

>> clock := Yeroo haaraa.
	
(OS = ['Haiku']) yoodhugaa: {
	clock naannoo: ['CET'],
	bara: 2017, jiʼa: 7, guyyaa: 13,
	saʼaatii: 18, daqiiqaa: 0, sekoondii: 0.
}, yoobaate: {
	clock naannoo: ['Europe/Amsterdam'],
	bara: 2017, jiʼa: 7, guyyaa: 13,
	saʼaatii: 18, daqiiqaa: 0, sekoondii: 0.
}.

clock irratti: ['tell'] godhi: {
	Baʼii barreessi: ofii, dhaabi.
}.


clock idaʼi: 2    saʼaatii, tell.
clock idaʼi: 1    saʼaatii, tell.
clock idaʼi: 19 daqiiqaa, tell.
clock idaʼi: 1  daqiiqaa, tell.
clock idaʼi: 1  daqiiqaa, tell.
clock idaʼi: 19 sekoondii, tell.
clock idaʼi: 1  sekoondii, tell.
clock idaʼi: 1  sekoondii, tell.
clock idaʼi: 2    bara, tell.
clock idaʼi: 1    bara, tell.

(OS = ['Haiku']) yoodhugaa: {
clock idaʼi: 5   jiʼa.
clock naannoo: ['CEST'], tell.
}, yoobaate: {
	clock idaʼi: 5   jiʼa, tell.
}.

clock idaʼi: 1   jiʼa, tell.
clock idaʼi: 19    guyyaa, tell.
clock idaʼi: 1    saʼaatii, tell.
clock idaʼi: 120  yard, tell.
