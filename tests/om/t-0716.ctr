Baʼii barreessi: ['Test object'], dhaabi.
>> a := Wanta haaraa. 

a irratti: ['state:'] godhi: { :list
	koo list := list. 
}.

a irratti: ['state'] godhi: {
	Baʼii barreessi: koo list, dhaabi.
}.

a state: ( Tarree-wantootaa haaraa ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
