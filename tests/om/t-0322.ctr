

>> Matryoshka := Wanta haaraa.
Matryoshka irratti: ['double:'] godhi: { :secret
	koo secret := secret × 2.
}.
Matryoshka irratti: ['haaraa:'] godhi: { :secret
	>> answer := Homaa.
	>> t := (secret > 255).
	Baʼii barreessi: (secret + [' | '] + t), dhaabi.
	t yoodhugaa: {
		answer := secret.
	}, yoobaate: {
		answer := Matryoshka irradeebiʼee haaraa: (ofii double: secret).
	}. <- answer.
}.

>> x := Matryoshka haaraa: 2.
