
Server init.
Baʼii barreessi: ['Database test'], dhaabi.

>> db := Maria-DB haaraa keessummeessaa: ['localhost'],
	maqaa-fayyadamaa: ['xo'], 
	jecha-icciitii: ['pass123'],
	maqaa-kuusaa-deetaa: ['xobase'],
	walqunnami.

>> ulaagaalee-barbaacha :=
db iyyaafannoo: ['SELECT UNHEX('CAFE') AS blobby'],
fidi: { :row
	Baʼii barreessi: ( row blobby irraa: 0 dheerina: 2 ), dhaabi.
	row blobby gadi-lakkisi.
}.
