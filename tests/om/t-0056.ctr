>> z := Wanta haaraa.
z irratti: ['value:'] godhi: { :v
	koo value := v. <- ofii.
}.
z irratti: ['value'] godhi: { <- koo value. }.
(z setValue: 1) value: 2.
Baʼii barreessi: z value.
>> x := z.
Baʼii barreessi: x value.
z := Homaa.
Baʼii barreessi: z value.
Baʼii barreessi: x value.
Baʼii barreessi: ['hello'].
Baʼii barreessi: 3 + 2.
Baʼii barreessi: (3 > 2).
