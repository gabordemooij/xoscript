Server init.
>> f := Bifa haaraa: ['%d'].
>> a := Blob haaraa: 4.
a bytes: ( Tarree-wantootaa haaraa ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob haaraa: 4.
b bytes: ( Tarree-wantootaa haaraa ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a irraa: 0 dheerina: 3, hundaaf: { :i :byte
	Baʼii barreessi: ( f raawwadhu-lakkoofsa-guutuu: byte ), dhaabi.
}.
a ^ b.
a irraa: 0 dheerina: 3, hundaaf: { :i :byte
	Baʼii barreessi: ( f raawwadhu-lakkoofsa-guutuu: byte ), dhaabi.
}.
a ^ b.
a irraa: 0 dheerina: 3, hundaaf: { :i :byte
	Baʼii barreessi: ( f raawwadhu-lakkoofsa-guutuu: byte ), dhaabi.
}.
a gadi-lakkisi.
b gadi-lakkisi.

{ a ^ Wanta. } qabi: { :e Baʼii barreessi: e, dhaabi. }, fiigi.
