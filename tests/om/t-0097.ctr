
Barreeffama irratti: ['html'] godhi: { <- (
		ofii
		bakka-buusi: ['&'] tiin: ['&amp;'],
		bakka-buusi: ['<'] tiin: ['&lt;'],
		bakka-buusi: ['>'] tiin: ['&gt;'],
		bakka-buusi: ['"'] tiin: ['&quot;']
	).
}.

>> HtmlBrush := Wanta haaraa.

HtmlBrush irratti: ['deebii-kenni:'] godhi: { :tag
	Baʼii barreessi: (['<tag>↵'] tag: tag ).
}.

HtmlBrush irratti: ['deebii-kenni:fi:'] godhi: { :tag :content
	tag := ( tag irraa: 0 dheerina: (tag dheerina - 1) ).
	Baʼii barreessi: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush irratti: ['content:'] godhi: { :text
	Baʼii barreessi: text html, dhaabi.
}.

HtmlBrush irratti: ['attr:value:'] godhi: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush haaraa.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
