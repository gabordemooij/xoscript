# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> karaa := ['/tmp/dat.csv'].
>> csv := Faayila haaraa: karaa.
csv barreessi: s.

# accepts CRLF LF CR, varying row length
csv addaan-baasaa: [';'] mallattoo-waraabbii: ['"'] sararoota: { :line
	Sagantaa qulqulleessi-memoorii.
	Baʼii barreessi: line, dhaabi.
	Sagantaa qulqulleessi-memoorii.
}.

# unequal lines
s dabaliboodatti: ['\njustone'].
csv barreessi: s.
{
	csv addaan-baasaa: [';'] mallattoo-waraabbii: ['"'] sararoota: { :line
		Baʼii barreessi: line, dhaabi.
	}.
} qabi: { :e 
	Baʼii barreessi: e, dhaabi.
}, fiigi.

# invalid format
s := ['"he"llo";world'].
csv barreessi: s.
{
	csv addaan-baasaa: [';'] mallattoo-waraabbii: ['"'] sararoota: { :line
		Baʼii barreessi: line, dhaabi.
	}.
} qabi: { :e 
	Baʼii barreessi: e, dhaabi.
}, fiigi.
