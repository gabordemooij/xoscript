

Barreeffama irratti: ['evaluate'] godhi: {
	>> koodii := Faayila haaraa: ['/tmp/eval.ctr'].
	koodii barreessi: (ofii gara-barreeffamaatti + ['.']).
	Sagantaa fayyadami: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Tarree-wantootaa ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q gara-barreeffamaatti.
Baʼii barreessi: x, dhaabi.
>> y := Homaa.
(['y := '] + x ) evaluate.
Baʼii barreessi: y ? 0, dhaabi.

q := Galmee-jechootaa kaaʼi: ['\[''] itti: ['\['quote\']'].
x := q gara-barreeffamaatti.
Baʼii barreessi: x, dhaabi.
y := Homaa.
(['y := '] + x ) evaluate.

>> q := (Galmee-jechootaa haaraa) kaaʼi:['\[''] itti:['\['quote\[''].
Baʼii barreessi: y ? ['\['quote\']'], dhaabi.
