

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> x := 100.

Sagantaa qulqullina: 0.

{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt dabaliboodatti: ['!!'].
Baʼii barreessi: txt.
} fiigi.

Sagantaa qulqulleessi-memoorii.

usedMemory1 := (Sagantaa memoorii ? 0).


{
>> txt := ['hello '] + ['world'].
