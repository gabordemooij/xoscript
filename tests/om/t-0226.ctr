# Test ASCII variants

# Numbers

Baʼii barreessi: (2 !=: 3), dhaabi.
Baʼii barreessi: (2 <=: 2), dhaabi.
Baʼii barreessi: (2 >=: 2), dhaabi.

# Strings

Baʼii barreessi: (['b'] >=: ['a']), dhaabi.
Baʼii barreessi: (['b'] !=: ['a']), dhaabi.
Baʼii barreessi: (['b'] <=: ['c']), dhaabi.

# Bools

Baʼii barreessi: (Dhugaa !=: Soba), dhaabi.

# Objects

Baʼii barreessi: (Wanta haaraa !=: Wanta haaraa), dhaabi.

# ASCII list symbol <-:

Baʼii barreessi: (Tarree-wantootaa <<: 1, ; 2 ; 3) lakkaaʼi = 3, dhaabi.

