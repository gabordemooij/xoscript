



>> CoffeeGrounds := Wanta haaraa.
CoffeeGrounds irratti: ['extract'] godhi: { <- ['coffee']. }.

>> CoffeeMachine := Wanta haaraa.
CoffeeMachine irratti: ['init'] godhi: {
	koo coffeegrounds := CoffeeGrounds haaraa.
}.
CoffeeMachine irratti: ['haaraa'] godhi: { <- CoffeeMachine `new init.
}.

CoffeeMachine irratti: ['makeTea'] godhi: { <- (koo tealeaves extract). }.
CoffeeMachine irratti: ['makeCoffee'] godhi: { <- (koo coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine haaraa.

Baʼii barreessi:
	coffeeDream 
	makeCoffee.

Baʼii barreessi:
	coffeeDream 
	makeTea.
