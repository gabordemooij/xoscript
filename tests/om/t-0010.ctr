>> Animal := Wanta haaraa.
Animal irratti: ['make'] godhi: {
	>> animal := Wanta haaraa.
	animal irratti: ['makeSound'] godhi: {
		Baʼii barreessi: koo sound.
	}. <- animal.
}.
>> Cat := Wanta haaraa.
Cat irratti: ['make'] godhi: {
	>> cat := Animal make.
	cat irratti: ['init'] godhi: {
		koo sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
