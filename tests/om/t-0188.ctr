

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Sagantaa qulqullina: 0.

{ :i Baʼii barreessi: i. } × 4.
Baʼii dhaabi.
{ :i Baʼii barreessi: (4 - i). } × 4.
Baʼii dhaabi.
( 1 > 2 ) yoosoba: { Baʼii barreessi: ['BLOCK 1'], dhaabi. }.
( 2 > 1 ) yoodhugaa:  { Baʼii barreessi: ['BLOCK 2'], dhaabi. }.

>> i := 0.
{ Baʼii barreessi: i. i idaʼi: 1. } yemmuuhangafa: { <- ( i < 3). }.
Baʼii dhaabi.

i := 3.
{ Baʼii barreessi: i. i := i - 1. } yemmuuhangafa: { <- ( i > 0). }.
Baʼii dhaabi.


Sagantaa qulqulleessi-memoorii.

usedMemory1 := (Sagantaa memoorii ? 0).


{ :i  Baʼii barreessi: i. } × 4.
Baʼii dhaabi.
{ :i  Baʼii barreessi: (4 - i). } × 4.
Baʼii dhaabi.
( 1 > 2 ) yoosoba: { Baʼii barreessi: ['BLOCK 1'], dhaabi. }.
( 2 > 1 ) yoodhugaa:  { Baʼii barreessi: ['BLOCK 2'], dhaabi. }.

>> i := 0.
{ Baʼii barreessi: i. i idaʼi: 1. } yemmuuhangafa: { <- ( i < 3). }.
Baʼii dhaabi.

i := 3.
{ Baʼii barreessi: i. i := i - 1. } yemmuuhangafa: { <- ( i > 0). }.
Baʼii dhaabi.



Sagantaa qulqulleessi-memoorii.
usedMemory2 := (Sagantaa memoorii ? 0).


{ :i Baʼii barreessi: i. } × 4.
Baʼii dhaabi.
{ :i Baʼii barreessi: (4 - i). } × 4.
Baʼii dhaabi.
( 1 > 2 ) yoosoba: { Baʼii barreessi: ['BLOCK 1'], dhaabi. }.
( 2 > 1 ) yoodhugaa:  { Baʼii barreessi: ['BLOCK 2'], dhaabi. }.

>> i := 0.
{ Baʼii barreessi: i. i idaʼi: 1. } yemmuuhangafa: { <- ( i < 3). }.
Baʼii dhaabi.

i := 3.
{ Baʼii barreessi: i. i := i - 1. } yemmuuhangafa: { <- ( i > 0). }.
Baʼii dhaabi.

Sagantaa qulqulleessi-memoorii.
usedMemory3 := (Sagantaa memoorii ? 0).



( usedMemory1 = usedMemory2 fi: usedMemory1 = usedMemory3, fi: usedMemory2 = usedMemory3 ) yoodhugaa: {
	Baʼii barreessi: ['No memory leaks here'].
}, yoosoba: {
	Baʼii barreessi: ['Leaking memory...'].
}.
