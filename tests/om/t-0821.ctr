# a quote that never closes must give an error, not an endless loop
>> karaa := ['/tmp/test0821.csv'].
>> file := Faayila haaraa: karaa.

file barreessi: ['a,b\n"1,2\n'].
{
	file addaan-baasaa: [','] mallattoo-waraabbii: ['"'] sararoota: { :line
		Baʼii barreessi: line, dhaabi.
	}.
} qabi: { :e Baʼii barreessi: e, dhaabi. }, fiigi.

# a closed quote still works
file barreessi: ['a,b\n"1,2",3'].
file addaan-baasaa: [','] mallattoo-waraabbii: ['"'] sararoota: { :line
	Baʼii barreessi: line, dhaabi.
}.
file haqi.
