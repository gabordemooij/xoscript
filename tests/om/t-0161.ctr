Sagantaa qulqullina: 0.
Tarree-wantootaa irratti: ['sum'] godhi: {
	>> total := 0.
	ofii hundaaf: { :index :element
		total idaʼi: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Faayila haaraa: ['/tmp/test.txt'].
f barreessi: ['Lorem Ipsum'].
f cufi-walqunnamtii.
  

f := Faayila haaraa: ['/tmp/test.txt'].
>> text := f dubbisi.
f cufi-walqunnamtii.



Sagantaa qulqulleessi-memoorii.
usedMemory1 := (Sagantaa memoorii ? 1).



f := Faayila haaraa: ['/tmp/test.txt'].
text := f dubbisi.
f cufi-walqunnamtii.

Sagantaa qulqulleessi-memoorii.
usedMemory2 := (Sagantaa memoorii ? 1).


f := Faayila haaraa: ['/tmp/test.txt'].
text := f dubbisi.
f cufi-walqunnamtii.

Sagantaa qulqulleessi-memoorii.
usedMemory3 := (Sagantaa memoorii ? 1).



( usedMemory1 = usedMemory2 fi: usedMemory1 = usedMemory3, fi: usedMemory2 = usedMemory3 ) yoodhugaa: {
	Baʼii barreessi: ['No memory leaks here'].
}, yoosoba: {
	Baʼii barreessi: ['Leaking memory...'].
}.
