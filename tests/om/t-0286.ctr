['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Baʼii barreessi: (x + y), dhaabi.

>> x := 10040.07.
>> y := 10305.60.

Baʼii barreessi: (x + y), dhaabi.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Baʼii barreessi: (x + y + z), dhaabi.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Baʼii barreessi: (x + y + z), dhaabi.

>> q := 0.1.2.

Baʼii barreessi: (q), dhaabi.

>> q := 012.

Baʼii barreessi: (q), dhaabi.
