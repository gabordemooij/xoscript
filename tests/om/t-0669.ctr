# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Kuusaa-nageenyaa 
	haashii-jecha-icciitii: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Kuusaa-nageenyaa 
	haashii-jecha-icciitii: hash mirkaneessi: a1.
	# fail 
>> b := Kuusaa-nageenyaa
	haashii-jecha-icciitii: hash mirkaneessi: a2.
	# ok!

Baʼii barreessi: a, dhaabi.
Baʼii barreessi: b, dhaabi.

