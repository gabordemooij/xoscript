
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> koodii := {
	>> o := (
		Galmee-jechootaa haaraa
		aa: (Tarree-wantootaa ← 1 ; 2),
		bb: (Tarree-wantootaa ← 3 ; 4)
	).
	>> s := o gara-barreeffamaatti.
	>> o2 := s gara-wantaatti.
	(s  gosa = Barreeffama gosa) yoodhugaa: { Baʼii barreessi: ['OK1'], dhaabi. }.
	(o2 gosa = Galmee-jechootaa gosa) yoodhugaa: { Baʼii barreessi: ['OK2'], dhaabi. }.
}.

Sagantaa qulqullina: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Sagantaa qulqulleessi-memoorii.
usedMemory1 := (Sagantaa memoorii ? 1).
koodii fiigi.
Sagantaa qulqulleessi-memoorii.
usedMemory2 := (Sagantaa memoorii ? 1).
koodii fiigi.
Sagantaa qulqulleessi-memoorii.
usedMemory3 := (Sagantaa memoorii ? 1).
koodii fiigi.
Sagantaa qulqulleessi-memoorii.
usedMemory4 := (Sagantaa memoorii ? 1).

(usedMemory2 = usedMemory3 = usedMemory4) yoodhugaa: { Baʼii barreessi: ['OK3'], dhaabi. }.
 
