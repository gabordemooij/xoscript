>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Wanta haaraa.
⚄ irratti: ['drawFrom:length:'] godhi: { :pool :lakkaaʼi
	
	>> result := [''].
	
	{
		>> index := Lakkoofsa random % (pool dheerina).
		result dabaliboodatti: ( pool qubee: (index + 1) ).
		
	} × lakkaaʼi. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? dheerina.
Baʼii barreessi: (['x↵'] x random dheerina).
Baʼii barreessi: (['y↵'] y ?? dheerina).

