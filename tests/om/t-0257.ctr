
>> Greeter := Wanta haaraa.
Greeter irratti: ['haaraa'] godhi: {
	koo maqaa := ['?'].
}.
Greeter irratti: ['name:'] godhi: { :maqaa
	koo maqaa := maqaa.
}.
Greeter irratti: ['greet'] godhi: {
	Baʼii barreessi: (['hello[you]'] [you]: koo maqaa).
}.
>> friend := Greeter haaraa.
friend name: ['1'].
friend greet.
