
Tarree-wantootaa irratti: ['sum'] godhi: {
	>> total := 0.
	ofii hundaaf: { :index :element
		total idaʼi: element.
	}. <- total.
}.

>> a := Tarree-wantootaa ← 9 ; 8 ; 7.
Baʼii barreessi: (a sum), dhaabi. 
>> a := Tarree-wantootaa ← 1 ; 9.
Baʼii barreessi: (a sum), dhaabi. 
>> a := Tarree-wantootaa ← ['o'] ; 2.
Baʼii barreessi: (a sum), dhaabi. 
Baʼii barreessi: (Tarree-wantootaa haaraa sum), dhaabi. 
