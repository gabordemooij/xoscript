# test number -> string -> number
{

	>> x := Lakkoofsa gidduu: 0 fi: 1000000.
	>> d := Lakkoofsa gidduu: 1 fi: 7.
	>> e := 10 humna: d.

	x hiri-tiin: e.
	>> y := x gara-barreeffamaatti gara-lakkoofsaatti.

	(x = y) yoosoba: {
		Baʼii barreessi: x, dhaabi.
		Baʼii barreessi: y, dhaabi.
		Sagantaa dhuma.
	}.

} * 1000.
Baʼii barreessi: ['OK'], dhaabi.