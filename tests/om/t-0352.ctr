Lakkoofsa irratti: ['roman'] godhi: {
	>> gara-lakkoofsaatti := ofii kopii.
	>> roman := [''].
	{
		{
			(gara-lakkoofsaatti ≥ 1000) yoodhugaa: {
				roman dabaliboodatti: ['Ⅿ'].
				gara-lakkoofsaatti hiri: 1000.
			}, adda-kuti.
		
			(gara-lakkoofsaatti ≥ 500) yoodhugaa: {
				roman dabaliboodatti: ['Ⅾ'].
				gara-lakkoofsaatti hiri: 500.
			}, adda-kuti.
		
			(gara-lakkoofsaatti ≥ 100) yoodhugaa: {
				roman dabaliboodatti: ['Ⅽ'].
				gara-lakkoofsaatti hiri: 100.
			}, adda-kuti.
		
			(gara-lakkoofsaatti ≥ 50) yoodhugaa: {
				roman dabaliboodatti: ['Ⅼ'].
				gara-lakkoofsaatti hiri: 50.
			}, adda-kuti.
		
			(gara-lakkoofsaatti ≥ 50) yoodhugaa: {
				roman dabaliboodatti: ['Ⅼ'].
				gara-lakkoofsaatti hiri: 50.
			}, adda-kuti.
		
			(gara-lakkoofsaatti ≥ 10) yoodhugaa: {
				roman dabaliboodatti: ['Ⅹ'].
				gara-lakkoofsaatti hiri: 10.
			}, adda-kuti.
			
			(gara-lakkoofsaatti ≥ 9) yoodhugaa: {
				roman dabaliboodatti: ['Ⅸ'].
				gara-lakkoofsaatti hiri: 9.
			}, adda-kuti.
			
			(gara-lakkoofsaatti ≥ 5) yoodhugaa: {
				roman dabaliboodatti: ['Ⅴ'].
				gara-lakkoofsaatti hiri: 5.
			}, adda-kuti.
			
			(gara-lakkoofsaatti ≥ 4) yoodhugaa: {
				roman dabaliboodatti: ['Ⅳ'].
				gara-lakkoofsaatti hiri: 4.
			}, adda-kuti.
			
			(gara-lakkoofsaatti ≥ 1) yoodhugaa: {
				roman dabaliboodatti: ['Ⅰ'].
				gara-lakkoofsaatti hiri: 1.
			}, adda-kuti.
		} tartiiba.
	} yemmuuhangafa: { <- gara-lakkoofsaatti > 0. }. <- roman.
}.

Baʼii barreessi: 1 roman, dhaabi.
Baʼii barreessi: 2 roman, dhaabi.
Baʼii barreessi: 4 roman, dhaabi.
Baʼii barreessi: 8 roman, dhaabi.
Baʼii barreessi: 16 roman, dhaabi.
Baʼii barreessi: 32 roman, dhaabi.
Baʼii barreessi: 64 roman, dhaabi.
Baʼii barreessi: 128 roman, dhaabi.
Baʼii barreessi: 256 roman, dhaabi.
Baʼii barreessi: 1024 roman, dhaabi.
