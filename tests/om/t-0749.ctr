Baʼii barreessi: ['Test object'], dhaabi.
>> a := Wanta haaraa. 

a irratti: ['item:'] godhi: { :buuliyaanii
	koo buuliyaanii := buuliyaanii. 
}.

a irratti: ['item'] godhi: { <- koo buuliyaanii.
}.

a item: Soba.

Baʼii barreessi: a item, dhaabi.

>> old-bool-address := a item fakkeenya-jalqabaa teessoo-memoorii.
a save-as: ['/tmp/a.bin'].
Baʼii barreessi: ['========== RELOADING SNAP:'], dhaabi.

>> b := Wanta load-from: ['/tmp/a.bin'].

(b item fakkeenya-jalqabaa teessoo-memoorii = old-bool-address) yoodhugaa: {
	Baʼii barreessi: ['Object link re-attached.'], dhaabi.
}.

Baʼii barreessi: b item, dhaabi.
