

Barreeffama irratti: ['evaluate'] godhi: {
	>> koodii := Faayila haaraa: ['/tmp/eval.ctr'].
	koodii barreessi: ofii gara-barreeffamaatti + ['.'].
	Sagantaa fayyadami: ['/tmp/eval.ctr'].
}.

>> a := (Tarree-wantootaa ← (
	(Galmee-jechootaa haaraa)
		kaaʼi: ['domain'] itti: ['mywebsite.com'],
		kaaʼi: (Tarree-wantootaa ←
			((Galmee-jechootaa haaraa)
				kaaʼi: ['home'] itti: ['title'],
				kaaʼi: ['<html></html>'] itti: ['body'],
				kaaʼi: ['2017-01-01'] itti: ['created']
			) ;
			((Galmee-jechootaa haaraa)
				kaaʼi: ['aboutus(c)'] itti: ['title'],
				kaaʼi: ['<credits>Author Inc.</credits>'] itti: ['body']
			)
		) itti: ['pages']
	)
) gara-barreeffamaatti.

Baʼii barreessi: a gosa, dhaabi.
Baʼii barreessi: a, dhaabi.

>> b := Homaa.
(['b := '] + a) evaluate.
Baʼii barreessi: b ? 0 ? ['pages'] ? 1 ? ['body'], dhaabi.

>> c := b ? 0.
>> d := c gara-barreeffamaatti.
Baʼii barreessi: d gosa, dhaabi.

>> e := Homaa.
(['e := '] + d) evaluate.
Baʼii barreessi: e ? ['pages'] ? 0, dhaabi.
