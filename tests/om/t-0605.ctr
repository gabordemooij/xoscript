>> invoice := Wanta haaraa.
invoice irratti: ['fiigi'] godhi: {
        koo gara-lakkoofsaatti := 0.
}.

invoice irratti: ['gara-lakkoofsaatti'] godhi: {
        koo gara-lakkoofsaatti idaʼi: 1. <- koo gara-lakkoofsaatti kopii.
}.

>> year-invoice := invoice haaraa.
year-invoice irratti: ['start:'] godhi: { :bara
	koo gara-lakkoofsaatti := bara.
}.

year-invoice start: 202000.
Baʼii barreessi: year-invoice gara-lakkoofsaatti, dhaabi.
Baʼii barreessi: year-invoice gara-lakkoofsaatti, dhaabi.
