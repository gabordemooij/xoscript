Baʼii barreessi: ['1,2,3,4,5,6,7,8,9,A,'], dhaabi.
>> Scope := Wanta haaraa.
Scope irratti: ['initialize:'] godhi: { :x koo property := x. }.
Scope irratti: ['confirm'] godhi: { Baʼii barreessi: [',']. }.
Scope irratti: ['qormaata'] godhi: {
	Baʼii barreessi: koo property.
	ofii confirm.
	( 1 = 1 ) yoodhugaa: { Baʼii barreessi: koo property. ofii confirm. }.
	( 1 = 0 ) yoosoba: { Baʼii barreessi: koo property. ofii confirm. }.
	>> y := 2. { Baʼii barreessi: koo property. ofii confirm. } yemmuuhangafa: { y hiri: 1. <- (y > 0). }.
	{ Baʼii barreessi: koo property. ofii confirm. } × 1.
	(Tarree-wantootaa ← 1) hundaaf: {  Baʼii barreessi: koo property. ofii confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Galmee-jechootaa haaraa one: ['item']) hundaaf: { Baʼii barreessi: koo property. ofii confirm. }.
	{ 1 ÷ 0. } qabi: { Baʼii barreessi: koo property. ofii confirm. }, fiigi.
	Baʼii dhaabi.
}.
>> scope1 := Scope haaraa.
scope1 initialize: ['X'].
scope1 qormaata.
>> function := { 
	koo property := ['Y'].
	Baʼii barreessi: koo property.
	ofii confirm.
	( 1 = 1 ) yoodhugaa: { Baʼii barreessi: koo property. ofii confirm. }.
	( 1 = 0 ) yoosoba: { Baʼii barreessi: koo property. ofii confirm. }.
	>> y := 2. { Baʼii barreessi: koo property. ofii confirm. } yemmuuhangafa: { y hiri: 1. <- (y > 0). }.
	{ Baʼii barreessi: koo property. ofii confirm. } × 1.
	(Tarree-wantootaa ← 1) hundaaf: {  Baʼii barreessi: koo property. ofii confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Galmee-jechootaa haaraa one: ['item']) hundaaf: { Baʼii barreessi: koo property. ofii confirm. }.
	{ 1 ÷ 0. } qabi: { Baʼii barreessi: koo property. ofii confirm. }, fiigi.
	Baʼii dhaabi.
}.
function irratti: ['confirm'] godhi: { Baʼii barreessi: [',']. }.
function raawwadhu: 1 fi: 2.
