#Linux

 >> t := Yeroo haaraa.
 
t naannoo: ['Europe/Amsterdam'].
t bara: 2020, jiʼa: 8, guyyaa: 2, saʼaatii: 21, daqiiqaa: 2, sekoondii: 1.

>> a := t saʼaatii.
>> ams := t naannoo.

t naannoo: ['US/Hawaii'].
>> b := t saʼaatii.
>> hw := t naannoo.

Baʼii
barreessi: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		tokkoykn: ['later'] ykn: ['earlier']
	)
),
dhaabi.
 