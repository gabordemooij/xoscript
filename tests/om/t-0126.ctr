#Linux
>> Slurp := Wanta haaraa.

Slurp irratti: ['haaraa'] godhi: {
	koo str := [''].
}.

Slurp irratti: ['nieuw'] godhi: {
	koo str := [''].
}.

Slurp irratti: ['deebii-kenni:'] godhi: { :blah
		koo str dabaliboodatti: blah.
}.

Slurp irratti: ['deebii-kenni:fi:'] godhi: { :blah :blahah
		koo str dabaliboodatti: (blah irraa: 0 dheerina: (blah dheerina - 1)).
		koo str dabaliboodatti: [' '].
		koo str dabaliboodatti: blahah.
}.

Slurp irratti: ['obtain'] godhi: {
	>> buffer := koo str.
	koo str := ['']. <- buffer.
}.


Baʼii barreessi: (Sagantaa shelli: (Slurp haaraa echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Faayila haaraa: ['/tmp/from.txt'], haqi. } qabi: { ['Empty']. }, fiigi.
{ Faayila haaraa: ['/tmp/to.txt'], haqi. } qabi: { ['Empty']. }, fiigi.


Faayila haaraa: ['/tmp/to.txt'], jira yoosoba: {
	Baʼii barreessi: ['Confirmed. Target file does not exist.\
'].
}.
Faayila haaraa: ['/tmp/from.txt'], jira yoosoba: {
	Baʼii barreessi: ['Confirmed. Source file does not exist.\
'].
}.



Sagantaa shelli: (Slurp haaraa touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Sagantaa shelli: (Slurp haaraa cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Faayila haaraa: ['/tmp/to.txt'], jira yoodhugaa: {
	Baʼii barreessi: ['Confirmed. Target file has been created by shell.\
'].
}.


Baʼii barreessi: ['Contents of file is:'] + (Faayila haaraa: ['/tmp/to.txt'], dubbisi), dhaabi.
