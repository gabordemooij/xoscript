

>> g := Server haaraa.
>> v := Kuusaa-nageenyaa haaraa.
>> ok := 0.

>> secrets := Tarree-wantootaa haaraa ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> passwords := secrets kopii.
passwords hundaaf: { :i :p
	secrets hundaaf: { :n :s
		{
			>> encrypted := v iccitiisi: s furtuu: p.
			>> decrypted := v icciitii-hiiki: encrypted furtuu: p.
			(decrypted = s) yoodhugaa: {
				ok idaʼi: 1.
			}, yoobaate: {
				Baʼii barreessi: ['failed encrypting/decrypting: '], dhaabi.
				Baʼii barreessi: s, dhaabi.
				Baʼii barreessi: ['encrypted: '] + encrypted, dhaabi.
				Baʼii barreessi: ['decrypted: '] + encrypted, dhaabi.
				Sagantaa dhuma.
			}.
		} qabi: { :err
			(s = [''] ykn: p = ['']) yoodhugaa: {
				ok idaʼi: 1.
			}, yoobaate: {
				Baʼii barreessi: err, dhaabi.
				Sagantaa dhuma.
			}.
		}, fiigi.
	}.
}.

Baʼii barreessi: ( ok + [' vault encryptions tested.'] ), dhaabi.