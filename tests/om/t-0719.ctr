Server init.
>> fmt := Bifa haaraa: ['%#3x'].

>> blob := Blob haaraa: 4.
blob bytes: ( 
	Tarree-wantootaa haaraa ; 0 ; 1 ; 2 ; 3
).

>> file := Faayila haaraa: ['/tmp/blob'].
file blob: blob.
blob gadi-lakkisi.

>> dubbisi := file blob.
dubbisi 
irraa: 0 
dheerina: 4, 
godhi hundaaf: { :i :b 
	Baʼii
	barreessi: (fmt raawwadhu-lakkoofsa-guutuu: b),
	dhaabi.
}.
dubbisi gadi-lakkisi.
