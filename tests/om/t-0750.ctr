Baʼii barreessi: ['Test object'], dhaabi.
>> a := Wanta haaraa. 

a irratti: ['item:'] godhi: { :nil
	koo nil := nil. 
}.

a irratti: ['item'] godhi: { <- koo nil.
}.

a item: Homaa.

Baʼii barreessi: a item, dhaabi.

>> old-nil-address := a item fakkeenya-jalqabaa teessoo-memoorii.
a save-as: ['/tmp/a.bin'].
Baʼii barreessi: ['========== RELOADING SNAP:'], dhaabi.

>> b := Wanta load-from: ['/tmp/a.bin'].

(b item fakkeenya-jalqabaa teessoo-memoorii = old-nil-address) yoodhugaa: {
	Baʼii barreessi: ['Object link re-attached.'], dhaabi.
}.

Baʼii barreessi: b item, dhaabi.
