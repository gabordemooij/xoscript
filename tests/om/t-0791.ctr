Server init.

>> DB := Maria-DB haaraa keessummeessaa: ['localhost'],
	maqaa-fayyadamaa: ['xo'],
	jecha-icciitii: ['pass123'],
	maqaa-kuusaa-deetaa: ['xobase'],
	walqunnami.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> ulaagaalee-barbaacha := Iyyaafannoo-Maria haaraa: SQL.

# set database
ulaagaalee-barbaacha kuusaa-deetaa: DB.

ulaagaalee-barbaacha fidi: { :row
	Baʼii barreessi: row world, dhaabi.
}.
