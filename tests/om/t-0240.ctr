# test qualifiers

>> $ := Wanta haaraa.

$ irratti: ['deebii-kenni:'] godhi: { :x
	
	>> operation := x qubee: 0.
	>> valuta := x qubee: 1.
	>> money := x darbi: 2.
	
	>> amount := 0.

	( operation = ['+'] ) yoodhugaa: {
		( valuta = ['£'] ) yoodhugaa: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Baʼii barreessi: x, dhaabi.


>> Fruit := Wanta haaraa.

Fruit irratti: ['haaraa'] godhi: {
	>> f := ofii haaraa.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit irratti: ['apples:'] godhi: { :a koo apples := a. }.
Fruit irratti: ['oranges:'] godhi: { :p koo oranges := p. }.
Fruit irratti: ['apples'] godhi: { <- koo apples. }.
Fruit irratti: ['oranges'] godhi: { <- koo oranges. }.

Fruit irratti: ['+'] godhi: { :f
	
	>> n := Fruit haaraa.
	f idaʼi: 1.
	
	n apples: (f apples + koo apples).
	n oranges:  (f oranges  + koo oranges). <- n.
}.

Fruit irratti: ['gara-barreeffamaatti'] godhi: { <- ( koo apples gara-barreeffamaatti + [' apples and '] + koo oranges + [' oranges'] ).
}.

Lakkoofsa irratti: ['apples'] godhi: { <- ((Fruit haaraa) apples: ofii).
}.

Lakkoofsa irratti: ['apple'] godhi: { <- ((Fruit haaraa) apples: ofii).
}.

Lakkoofsa irratti: ['oranges'] godhi: { <- ((Fruit haaraa) oranges: ofii).
}.




Baʼii barreessi: (1 apple + 3 oranges + 4 apples), dhaabi.


Barreeffama irratti: ['twice'] godhi: { <- ((ofii gara-barreeffamaatti) + (ofii gara-barreeffamaatti)).
}.



Baʼii barreessi: ['❤❤❤'] twice.



