


>> Deck := Tarree-wantootaa haaraa.
Deck irratti: ['print'] godhi: {
        >> len := ofii lakkaaʼi - 1.
        { :i
                >> len2 := ofii lakkaaʼi - 1.
                Baʼii barreessi: ['len: '].
                Baʼii barreessi: len, dhaabi.
                Baʼii barreessi: ['len2: '].
                Baʼii barreessi: len2, dhaabi.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
