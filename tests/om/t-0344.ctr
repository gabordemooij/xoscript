# catch-all test (practical)
>> HTML := Barreeffama haaraa.
HTML irratti: ['encode:'] godhi: { :tekst
	ofii dabaliboodatti: (tekst
	bakka-buusi: ['&'] tiin: ['&amp;'], 
	bakka-buusi: ['<'] tiin: ['&lt;'],
	bakka-buusi: ['>'] tiin: ['&gt;'],
	bakka-buusi: ['"'] tiin: ['&quot;']).
}.
>> blog := HTML haaraa.
blog dabaliboodatti: ['<h1>'],
     encode: ['Koffie & Thee'],
     dabaliboodatti: ['</h1>'].
Baʼii barreessi: blog, dhaabi.


>> Roman := Lakkoofsa haaraa.
Roman irratti: ['stringy'] godhi: {
	>> a := [''].
	{ a dabaliboodatti: ['I']. } × ofii. <- a.
}.

>> x := Roman haaraa.
x idaʼi: 3.
Baʼii barreessi: x stringy, dhaabi.

>> Quantum := Buuliyaanii haaraa.
Quantum irratti: ['true?'] godhi: { <- ['maybe True']. }.
Baʼii barreessi: (Quantum haaraa true?), dhaabi.

>> Nihil := Homaa haaraa.
Nihil irratti: ['gara-barreeffamaatti'] godhi: { <- ['Nihil']. }.
Baʼii barreessi: (Nihil haaraa), dhaabi.
