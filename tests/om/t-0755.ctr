Baʼii barreessi: ['Test object'], dhaabi.
>> greeter := Wanta haaraa.
greeter irratti: ['name:'] godhi: { :maqaa
	koo xname := maqaa. 
}.
greeter irratti: ['greet'] godhi: {
	Baʼii barreessi: ['Hello '] + koo xname, dhaabi.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Baʼii barreessi: ['========== RELOADING SNAP:'], dhaabi.
>> b := Wanta load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
