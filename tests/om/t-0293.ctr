
>> city := Tarree-wantootaa ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Tarree-wantootaa ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature tiin: city.
>> cities := weather seensawwan tarreessi: { :a :b <- (a walbira-qabi: b). }.
>> temperatures := weather gattiiwwan tarreessi: { :a :b <- (a walbira-qabi: b) negaatiiva?. }.

Baʼii barreessi: (cities waliingalchi: [',']), dhaabi.
Baʼii barreessi: (temperatures waliingalchi: [',']), dhaabi.
