#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Sagantaa qulqullina: 0.

{
Yeroo yeroo.
Yeroo eegi: 1.
Baʼii barreessi: Sagantaa falmee-lakkoofsa, dhaabi.
Sagantaa falmee: 0.
Lakkoofsa random.
Baʼii barreessi: (Sagantaa shelli: ['echo 'Hello'']).
} fiigi.

Sagantaa qulqulleessi-memoorii.
usedMemory1 := (Sagantaa memoorii ? 0).

{
Yeroo yeroo.
Yeroo eegi: 1.
Baʼii barreessi: Sagantaa falmee-lakkoofsa, dhaabi.
Sagantaa falmee: 0.
Lakkoofsa random.
Baʼii barreessi: (Sagantaa shelli: ['echo 'Hello'']).
} fiigi.

Sagantaa qulqulleessi-memoorii.
usedMemory2 := (Sagantaa memoorii ? 0).

{
Yeroo yeroo.
Yeroo eegi: 1.
Baʼii barreessi: Sagantaa falmee-lakkoofsa, dhaabi.
Sagantaa falmee: 0.
Lakkoofsa random.
Baʼii barreessi: (Sagantaa shelli: ['echo 'Hello'']).
} fiigi.

Sagantaa qulqulleessi-memoorii.
usedMemory3 := (Sagantaa memoorii ? 0).



( usedMemory1 = usedMemory2 fi: usedMemory1 = usedMemory3, fi: usedMemory2 = usedMemory3 ) yoodhugaa: {
	Baʼii barreessi: ['No memory leaks here'].
}, yoosoba: {
	Baʼii barreessi: ['Leaking memory...'].
}.
