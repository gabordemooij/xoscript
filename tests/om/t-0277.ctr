

>> Cat := Wanta haaraa.

Cat irratti: ['haaraa'] godhi: {
	koo sound := ['meow!'].
}.

Cat irratti: ['nieuw'] godhi: {
	koo sound := ['meow!'].
}.

Cat irratti: ['makeSound'] godhi: { <- koo sound.
}.

Cat irratti: ['greet'] godhi: { <- ofii makeSound.
}.

>> cat := Cat haaraa.
Baʼii barreessi: cat greet.
