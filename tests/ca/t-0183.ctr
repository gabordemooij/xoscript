

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa gestió-memòria: 0.

>> o := Objecte nou.
>> o2 := Objecte nou.
Sortida escriu: o Res?, salt-de-línia.
Sortida escriu: o tipus, salt-de-línia.
Sortida escriu: ( o igual-a: o ), salt-de-línia.
Sortida escriu: ( o igual-a: o2 ), salt-de-línia.
Sortida escriu: o jo-mateix, salt-de-línia.
Sortida escriu: ( o fes fet ), salt-de-línia.

Programa neteja.

usedMemory1 := (Programa memòria ? 0).


o := Objecte nou.
o2 := Objecte nou.
Sortida escriu: o Res?, salt-de-línia.
Sortida escriu: o tipus, salt-de-línia.
Sortida escriu: ( o igual-a: o ), salt-de-línia.
Sortida escriu: ( o igual-a: o2 ), salt-de-línia.
Sortida escriu: o jo-mateix, salt-de-línia.
Sortida escriu: ( o fes fet ), salt-de-línia.

Programa neteja.
usedMemory2 := (Programa memòria ? 0).


o := Objecte nou.
o2 := Objecte nou.
Sortida escriu: o Res?, salt-de-línia.
Sortida escriu: o tipus, salt-de-línia.
Sortida escriu: ( o igual-a: o ), salt-de-línia.
Sortida escriu: ( o igual-a: o2 ), salt-de-línia.
Sortida escriu: o jo-mateix, salt-de-línia.
Sortida escriu: ( o fes fet ), salt-de-línia.

Programa neteja.
usedMemory3 := (Programa memòria ? 0).



( usedMemory1 = usedMemory2 i: usedMemory1 = usedMemory3, i: usedMemory2 = usedMemory3 ) cert: {
	Sortida escriu: ['No memory leaks here'].
}, fals: {
	Sortida escriu: ['Leaking memory...'].
}.
