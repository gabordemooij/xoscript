

>> memòriaUsada1 := 0.
>> memòriaUsada2 := 0.
>> memòriaUsada3 := 0.
>> memòriaUsada4 := 0.

Programa gestió-memòria: 0.

>> o := Objecte nou.
>> o2 := Objecte nou.
Sortida escriu: o Res?, salt-de-línia.
Sortida escriu: o tipus, salt-de-línia.
Sortida escriu: ( o igual-a: o ), salt-de-línia.
Sortida escriu: ( o igual-a: o2 ), salt-de-línia.
Sortida escriu: o jo-mateix, salt-de-línia.
Sortida escriu: ( o fes fet ), salt-de-línia.

Programa neteja.

memòriaUsada1 := (Programa memòria ? 0).


o := Objecte nou.
o2 := Objecte nou.
Sortida escriu: o Res?, salt-de-línia.
Sortida escriu: o tipus, salt-de-línia.
Sortida escriu: ( o igual-a: o ), salt-de-línia.
Sortida escriu: ( o igual-a: o2 ), salt-de-línia.
Sortida escriu: o jo-mateix, salt-de-línia.
Sortida escriu: ( o fes fet ), salt-de-línia.

Programa neteja.
memòriaUsada2 := (Programa memòria ? 0).


o := Objecte nou.
o2 := Objecte nou.
Sortida escriu: o Res?, salt-de-línia.
Sortida escriu: o tipus, salt-de-línia.
Sortida escriu: ( o igual-a: o ), salt-de-línia.
Sortida escriu: ( o igual-a: o2 ), salt-de-línia.
Sortida escriu: o jo-mateix, salt-de-línia.
Sortida escriu: ( o fes fet ), salt-de-línia.

Programa neteja.
memòriaUsada3 := (Programa memòria ? 0).



( memòriaUsada1 = memòriaUsada2 i: memòriaUsada1 = memòriaUsada3, i: memòriaUsada2 = memòriaUsada3 ) cert: {
	Sortida escriu: ['Aquí no hi ha fuites de memòria'].
}, fals: {
	Sortida escriu: ['Perdent memòria...'].
}.
