Sortida escriu: ['Objecte de prova'], salt-de-línia.
>> a := Objecte nou. 

a en: ['item:'] fes: { :dicc
	propi dicc := dicc. 
}.

a en: ['article'] fes: {
	<- propi dicc.
}.

a item: (
Diccionari nou
	hello: ['world'],
	world: (Diccionari nou posa: ['a'] a: ['b'])).

Sortida escriu: a article, salt-de-línia.

>> adreça-antiga-dicc := a article prototip adreça-de-memòria.
a save-as: ['/tmp/a.bin'].
Sortida escriu: ['========== RECARREGANT INSTANTÀNIA:'], salt-de-línia.

>> b := Objecte load-from: ['/tmp/a.bin'].

(b article prototip adreça-de-memòria = adreça-antiga-dicc) cert: {
	Sortida escriu: ['Enllaç d'objecte reconnectat.'], salt-de-línia.
}.

Sortida escriu: b article, salt-de-línia.
