Número en: ['factorial'] fes: {
	>> total := 1.
	{ :index total multiplica-per: (jo - (index)). } × jo. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Sortida escriu: a.
>> b := 2 + 3 factorial.
Sortida escriu: b.
>> c := 3 factorial + 2.
Sortida escriu: c.
>> d := 2 + (3 factorial).
Sortida escriu: d.
Sortida escriu: 2 + 3 factorial + 1.
