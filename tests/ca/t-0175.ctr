

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> x := 100.

Programa gestió-memòria: 0.

{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt afegeix-al-final: ['!!'].
Sortida escriu: txt.
} inicia.

Programa neteja.

usedMemory1 := (Programa memòria ? 0).


{
