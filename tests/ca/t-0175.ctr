

>> memòriaUsada1 := 0.
>> memòriaUsada2 := 0.
>> memòriaUsada3 := 0.
>> memòriaUsada4 := 0.

>> x := 100.

Programa gestió-memòria: 0.

{
>> txt := ['hola '] + ['world'].
txt := txt + [' - podem usar textos.. '].
txt := txt + ['sense perdre '] + x + ['s de bytes ?'].
txt afegeix-al-final: ['!!'].
Sortida escriu: txt.
} inicia.

Programa neteja.

memòriaUsada1 := (Programa memòria ? 0).


{
>> txt := ['hola '] + ['world'].
txt := txt + [' - podem usar textos.. '].
txt := txt + ['sense perdre '] + x + ['s de bytes ?'].
txt afegeix-al-final: ['!!'].
Sortida escriu: txt.
} inicia.

Programa neteja.
memòriaUsada2 := (Programa memòria ? 0).


{
>> txt := ['hola '] + ['world'].
txt := txt + [' - podem usar textos.. '].
txt := txt + ['sense perdre '] + x + ['s de bytes ?'].
txt afegeix-al-final: ['!!'].
Sortida escriu: txt.
} inicia.

Programa neteja.
memòriaUsada3 := (Programa memòria ? 0).



( memòriaUsada1 = memòriaUsada2 i: memòriaUsada1 = memòriaUsada3, i: memòriaUsada2 = memòriaUsada3 ) cert: {
	Sortida escriu: ['Aquí no hi ha fuites de memòria'].
}, fals: {
	Sortida escriu: ['Perdent memòria...'].
}.
