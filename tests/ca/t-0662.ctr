>> t := Res.

# podeu controlar la zona horària per a
# l'anàlisi així:
Moment zona: ['CET'].
t := Moment des-de: ['1981-02-03 04:05:06'].
Sortida escriu: t, salt-de-línia.

# ara amb la zona horària CEST:
Moment zona: ['CEST'].
t := Moment des-de: ['1981-02-03 04:05:06'].
Sortida escriu: t, salt-de-línia.

# error si el text no es pot analitzar
{ Moment des-de: ['1900']. } captura: { Res. }, inicia.
