>> t := Res.

# you can control the time zone for
# parsing like this:
Moment zona: ['CET'].
t := Moment des-de: ['1981-02-03 04:05:06'].
Sortida escriu: t, salt-de-línia.

# now using CEST time zone:
Moment zona: ['CEST'].
t := Moment des-de: ['1981-02-03 04:05:06'].
Sortida escriu: t, salt-de-línia.

# error if string cannot be parsed
{ Moment des-de: ['1900']. } captura: { Res. }, inicia.
