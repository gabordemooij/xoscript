Número en: ['factorial'] fes: {
	>> total := 1.
	{ :índex total multiplica-per: (jo - índex). } × jo. <- total.
}.

>> memòriaUsada1 := 0.
>> memòriaUsada2 := 0.
>> memòriaUsada3 := 0.
>> memòriaUsada4 := 0.

Programa gestió-memòria: 0.

{
2 exponent factorial.
Sortida escriu: (11 mòdul: 3), salt-de-línia.
Sortida escriu: (3.4 arrodoneix), salt-de-línia.
Sortida escriu: (7.1 arrodoneix-amunt), salt-de-línia.
Sortida escriu: (7.9 arrodoneix-avall), salt-de-línia.
}
inicia.

Programa neteja.

memòriaUsada1 := (Programa memòria ? 0).

{
2 exponent factorial.
Sortida escriu: (11 mòdul: 3), salt-de-línia.
Sortida escriu: (3.4 arrodoneix), salt-de-línia.
Sortida escriu: (7.1 arrodoneix-amunt), salt-de-línia.
Sortida escriu: (7.9 arrodoneix-avall), salt-de-línia.
}
inicia.

Programa neteja.
memòriaUsada2 := (Programa memòria ? 0).


{
2 exponent factorial.
Sortida escriu: (11 mòdul: 3), salt-de-línia.
Sortida escriu: (3.4 arrodoneix), salt-de-línia.
Sortida escriu: (7.1 arrodoneix-amunt), salt-de-línia.
Sortida escriu: (7.9 arrodoneix-avall), salt-de-línia.
} inicia.

Programa neteja.
memòriaUsada3 := (Programa memòria ? 0).



( memòriaUsada1 = memòriaUsada2 i: memòriaUsada1 = memòriaUsada3, i: memòriaUsada2 = memòriaUsada3 ) cert: {
	Sortida escriu: ['Aquí no hi ha fuites de memòria'].
}, fals: {
	Sortida escriu: ['Perdent memòria...'].
}.
