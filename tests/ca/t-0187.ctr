Número en: ['factorial'] fes: {
	>> total := 1.
	{ :index total multiplica-per: (jo - index). } × jo. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa gestió-memòria: 0.

{
2 exponent factorial.
Sortida escriu: (11 mòdul: 3), salt-de-línia.
Sortida escriu: (3.4 arrodoneix), salt-de-línia.
Sortida escriu: (7.1 arrodoneix-amunt), salt-de-línia.
Sortida escriu: (7.9 arrodoneix-avall), salt-de-línia.
}
inicia.

Programa neteja.

usedMemory1 := (Programa memòria ? 0).

{
2 exponent factorial.
Sortida escriu: (11 mòdul: 3), salt-de-línia.
Sortida escriu: (3.4 arrodoneix), salt-de-línia.
Sortida escriu: (7.1 arrodoneix-amunt), salt-de-línia.
Sortida escriu: (7.9 arrodoneix-avall), salt-de-línia.
}
inicia.

Programa neteja.
usedMemory2 := (Programa memòria ? 0).


{
2 exponent factorial.
Sortida escriu: (11 mòdul: 3), salt-de-línia.
Sortida escriu: (3.4 arrodoneix), salt-de-línia.
Sortida escriu: (7.1 arrodoneix-amunt), salt-de-línia.
Sortida escriu: (7.9 arrodoneix-avall), salt-de-línia.
} inicia.

Programa neteja.
usedMemory3 := (Programa memòria ? 0).



( usedMemory1 = usedMemory2 i: usedMemory1 = usedMemory3, i: usedMemory2 = usedMemory3 ) cert: {
	Sortida escriu: ['No memory leaks here'].
}, fals: {
	Sortida escriu: ['Leaking memory...'].
}.
