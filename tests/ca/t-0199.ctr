
Programa gestió-memòria: 4.

>> Animal := Objecte nou.
Animal en: ['fabrica'] fes: {
	>> animal := Objecte nou.
	animal en: ['fesSo'] fes: {
		Sortida escriu: propi so.
	}. <- animal.
}.
>> Gat := Objecte nou.
Gat en: ['fabrica'] fes: {
	>> gat := Animal fabrica.
	gat en: ['init'] fes: {
		propi so := ['meow!'].
	}.
	gat init. <- gat.
}.
>> tom := Gat fabrica.
tom fesSo.
