Sortida escriu: ['Test object'], salt-de-línia.
>> a := Objecte nou. 

a en: ['item:'] fes: { :nil
	propi nil := nil. 
}.

a en: ['item'] fes: { <- propi nil.
}.

a item: Res.

Sortida escriu: a item, salt-de-línia.

>> old-nil-address := a item prototip adreça-de-memòria.
a save-as: ['/tmp/a.bin'].
Sortida escriu: ['========== RELOADING SNAP:'], salt-de-línia.

>> b := Objecte load-from: ['/tmp/a.bin'].

(b item prototip adreça-de-memòria = old-nil-address) cert: {
	Sortida escriu: ['Object link re-attached.'], salt-de-línia.
}.

Sortida escriu: b item, salt-de-línia.
