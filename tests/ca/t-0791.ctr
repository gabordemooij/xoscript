Server init.

>> BD := Maria-DB nou amfitrió: ['localhost'],
	usuari: ['xo'],
	contrasenya: ['pass123'],
	nom-base: ['xobase'],
	connecta.
	
>> SQL := ['SELECT "hello" AS "world" '].

# crea la consulta manualment
>> paràmetres-de-cerca := Maria-Consulta nou: SQL.

# estableix la base de dades
paràmetres-de-cerca base-de-dades: BD.

paràmetres-de-cerca obtén: { :fila
	Sortida escriu: fila world, salt-de-línia.
}.
