Server init.

>> DB := Maria-DB nou amfitrió: ['localhost'],
	usuari: ['xo'],
	contrasenya: ['pass123'],
	nom-base: ['xobase'],
	connecta.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> paràmetres-de-cerca := Maria-Consulta nou: SQL.

# set database
paràmetres-de-cerca base-de-dades: DB.

paràmetres-de-cerca obtén: { :row
	Sortida escriu: row world, salt-de-línia.
}.
