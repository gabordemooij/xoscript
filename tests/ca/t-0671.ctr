# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Caixa-forta genera-claus.

# private (secret) key
>> sk := keys primer.

# public key
>> pk := keys últim.

# sign a message
>> sig := Caixa-forta signa: ['abc'] amb: sk.

# check message (ok)
Sortida escriu: ( 
	Caixa-forta
		comprova: ['abc'] 
		signatura: sig 
		amb: pk 
), salt-de-línia.

# check message (fail)
Sortida escriu: ( 
	Caixa-forta 
		comprova: ['abd'] 
		signatura: sig 
		amb: pk 
), salt-de-línia.