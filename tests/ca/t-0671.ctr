# clau pública (per protegir API, etc.)
Server init.

# genera les claus
>> claus := Caixa-forta genera-claus.

# clau privada (secreta)
>> sk := claus primer.

# clau pública
>> pk := claus últim.

# signa un missatge
>> sig := Caixa-forta signa: ['abc'] amb: sk.

# comprova el missatge (correcte)
Sortida escriu: ( 
	Caixa-forta
		comprova: ['abc'] 
		signatura: sig 
		amb: pk 
), salt-de-línia.

# comprova el missatge (falla)
Sortida escriu: ( 
	Caixa-forta 
		comprova: ['abd'] 
		signatura: sig 
		amb: pk 
), salt-de-línia.