Sortida escriu: ['Test object'], salt-de-línia.
>> a := Objecte nou. 

a en: ['item:'] fes: { :dict
	propi dict := dict. 
}.

a en: ['item'] fes: { <- propi dict.
}.

a item: (
Diccionari nou
	hello: ['world']).

>> old-dict-address := a item prototip adreça-de-memòria.
a save-as: ['/tmp/a.bin'].
Sortida escriu: ['========== RELOADING SNAP:'], salt-de-línia.

>> b := Objecte load-from: ['/tmp/a.bin'].

(b item prototip adreça-de-memòria = old-dict-address) cert: {
	Sortida escriu: ['Object link re-attached.'], salt-de-línia.
}.

Sortida escriu: b item, salt-de-línia.
