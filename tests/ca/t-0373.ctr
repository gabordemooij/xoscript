# prova de conformitat

# utilitza números internacionals

Sortida escriu: ['1000 -> '].
Sortida escriu: 1000, salt-de-línia. #1000

Sortida escriu: ['1.5 -> '].
Sortida escriu: 1.5, salt-de-línia.  #1.5

Sortida escriu: ['1001.5 -> '].
Sortida escriu: 1.5 + 1000, salt-de-línia. #1001.5

# utilitza vectors indexats des de 0
>> x := Llista nou ; 1 ; 2 ; 3.
>> y := Llista nou ; ['a'] ; ['b'] ; ['c'].

Sortida escriu: ['1 -> '].
Sortida escriu: x ? 0, salt-de-línia. #1

Sortida escriu: ['1 -> '].
Sortida escriu: (x a: 0), salt-de-línia. #1

Sortida escriu: ['1 -> '].
Sortida escriu: x primer, salt-de-línia. #1

Sortida escriu: ['3 -> '].
Sortida escriu: x últim, salt-de-línia. #3

Sortida escriu: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Sortida escriu: (x segons: y), salt-de-línia.

Sortida escriu: ['1 -> '].
Sortida escriu: (x de: 0 longitud: 1) primer, salt-de-línia. #1

Sortida escriu: ['0 -> '].
Sortida escriu: (x troba: 1), salt-de-línia. #0

x posa: 9 a: 0.

Sortida escriu: ['9 -> '].
Sortida escriu: (x a: 0), salt-de-línia. #9

x afegeix-al-principi: 8.
Sortida escriu: ['8 -> '].
Sortida escriu: (x a: 0), salt-de-línia. #9


x afegeix-al-final: 10.
Sortida escriu: ['10 -> '].
Sortida escriu: (x a: 4), salt-de-línia. #10








