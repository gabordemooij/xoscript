Programa gestió-memòria: 0.
Llista en: ['suma'] fes: {
	>> total := 0.
	jo cada: { :índex :element
		total suma: element.
	}. <- total.
}.

>> memòriaUsada1 := 0.
>> memòriaUsada2 := 0.
>> memòriaUsada3 := 0.
>> memòriaUsada4 := 0.



>> f := Fitxer nou: ['/tmp/test.txt'].
f escriu: ['Lorem Ipsum'].
f tanca.
  

f := Fitxer nou: ['/tmp/test.txt'].
>> elText := f llegeix.
f tanca.



Programa neteja.
memòriaUsada1 := (Programa memòria ? 1).



f := Fitxer nou: ['/tmp/test.txt'].
elText := f llegeix.
f tanca.

Programa neteja.
memòriaUsada2 := (Programa memòria ? 1).


f := Fitxer nou: ['/tmp/test.txt'].
elText := f llegeix.
f tanca.

Programa neteja.
memòriaUsada3 := (Programa memòria ? 1).



( memòriaUsada1 = memòriaUsada2 i: memòriaUsada1 = memòriaUsada3, i: memòriaUsada2 = memòriaUsada3 ) cert: {
	Sortida escriu: ['Aquí no hi ha fuites de memòria'].
}, fals: {
	Sortida escriu: ['Perdent memòria...'].
}.
