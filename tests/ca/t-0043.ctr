>> repeater := Objecte nou.
repeater en: ['respon:'] fes: { :what
	Sortida escriu: what + [' '].
}.
repeater en: ['respon:i:'] fes: { :what :say
	Sortida escriu: what, escriu: say + [' '].
}.
repeater en: ['respon:i:i:'] fes: { :what :say :more
	Sortida escriu: what, escriu: say, escriu: more.
}.
repeater repeat.
repeater everything: ['I say.'].
repeater and: ['I '] everything: ['do.'].
