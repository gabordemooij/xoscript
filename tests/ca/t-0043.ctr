>> repetidor := Objecte nou.
repetidor en: ['respon:'] fes: { :què
	Sortida escriu: què + [' '].
}.
repetidor en: ['respon:i:'] fes: { :què :say
	Sortida escriu: què, escriu: say + [' '].
}.
repetidor en: ['respon:i:i:'] fes: { :què :say :més
	Sortida escriu: què, escriu: say, escriu: més.
}.
repetidor repeteix.
repetidor everything: ['dic.'].
repetidor and: ['I '] everything: ['faig.'].
