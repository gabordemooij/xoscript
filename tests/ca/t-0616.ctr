Llista en: ['copia'] fes: {
	>> copia := Llista nou.
	jo cada: { :número :section
		copia afegeix-al-final: section recursiu copia.
	}. <- copia.
}.

>> sheep := Llista nou ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep copia.
clones cada: { :número :sheep
	sheep afegeix-al-final: ['2'].
}.

Sortida escriu: sheep, salt-de-línia.
Sortida escriu: clones, salt-de-línia.
