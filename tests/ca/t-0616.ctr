Llista en: ['copia'] fes: {
	>> copia := Llista nou.
	jo cada: { :número :secció
		copia afegeix-al-final: secció recursiu copia.
	}.
	<- copia.
}.

>> ovella := Llista nou ; ['Dolly'] ; ['Shaun']. 
>> clons := ovella copia.
clons cada: { :número :ovella
	ovella afegeix-al-final: ['2'].
}.

Sortida escriu: ovella, salt-de-línia.
Sortida escriu: clons, salt-de-línia.
