Sortida escriu: ['Objecte de prova'], salt-de-línia.
>> a := Objecte nou. 

a en: ['item:'] fes: { :fmt
	propi fmt := fmt. 
}.

a en: ['article'] fes: {
	<- propi fmt.
}.

a item: ( Format nou: ['|%s|'] ).

Sortida escriu: a article, salt-de-línia.

>> adreça-antiga-fmt := a article prototip adreça-de-memòria.
a save-as: ['/tmp/a.bin'].
Sortida escriu: ['========== RECARREGANT INSTANTÀNIA:'], salt-de-línia.

>> b := Objecte load-from: ['/tmp/a.bin'].

(b article prototip adreça-de-memòria = adreça-antiga-fmt) cert: {
	Sortida escriu: ['Enllaç d'objecte reconnectat.'], salt-de-línia.
}.

Sortida escriu: ( b article aplica: ['hello'] ), salt-de-línia.
