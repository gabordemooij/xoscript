Sortida escriu: ['Test object'], salt-de-línia.
>> a := Objecte nou. 

a en: ['item:'] fes: { :fmt
	propi fmt := fmt. 
}.

a en: ['item'] fes: { <- propi fmt.
}.

a item: ( Format nou: ['|%s|'] ).

Sortida escriu: a item, salt-de-línia.

>> old-fmt-address := a item prototip adreça-de-memòria.
a save-as: ['/tmp/a.bin'].
Sortida escriu: ['========== RELOADING SNAP:'], salt-de-línia.

>> b := Objecte load-from: ['/tmp/a.bin'].

(b item prototip adreça-de-memòria = old-fmt-address) cert: {
	Sortida escriu: ['Object link re-attached.'], salt-de-línia.
}.

Sortida escriu: ( b item aplica: ['hello'] ), salt-de-línia.
