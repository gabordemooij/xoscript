# prova de conversions de tipus / conversions / vinculacions
Programa gestió-memòria: 4.
Server init.

>> comptador := 0.
>> bd := Maria-DB nou amfitrió: ['localhost'],
	usuari: ['xo'], contrasenya: ['pass123'], nom-base: ['xobase'], connecta.

>> FormatDosDígits := Format nou: ['%02d'].

# Data i hora
{
	>> any     := Número entre: 1995 i: 2050, text.
	>> mes    := FormatDosDígits aplica-enter: (Número entre: 1 i: 12), text.
	>> dia      := FormatDosDígits aplica-enter: (Número entre: 1 i: 28), text.
	>> hora     := FormatDosDígits aplica-enter: (Número entre: 1 i: 23), text.
	>> minut   := FormatDosDígits aplica-enter: (Número entre: 1 i: 59), text.
	>> segon   := FormatDosDígits aplica-enter: (Número entre: 1 i: 59), text.
	>> datahora := ['YYYY-MM-DD HH:II:SS'].	
	datahora
		YYYY: any,
		MM: mes,
		DD: dia,
		HH: hora,
		II: minut,
		SS: segon.
	>> paràmetres-de-cerca :=
	bd consulta: (['
		SELECT 
		"extra" AS paddingA,
		CAST("<datetime>" AS DATETIME) AS mydatetime,
		"extra" AS paddingB
	'] <datetime>: datahora),
	obtén: { :fila
		(fila mydatetime = datahora) fals: {
			aquesta-tasca error: (
				['S'esperava: <expected> però s'ha obtingut: <observation>']
				<expected>: datahora,
				<observation>: fila mydatetime
			).
		}.
	
	}.
	comptador suma: 1.
} * 100.

# Data
{
	>> any     := Número entre: 1995 i: 2050, text.
	>> mes    := FormatDosDígits aplica-enter: (Número entre: 1 i: 12), text.
	>> dia      := FormatDosDígits aplica-enter: (Número entre: 1 i: 28), text.
	>> data     := ['YYYY-MM-DD'].
	data
		YYYY: any,
		MM: mes,
		DD: dia.
	>> paràmetres-de-cerca :=
	bd consulta: (['
		SELECT
		"extra" AS paddingA,
		CAST("<date>" AS DATE) AS mydate,
		"extra" AS paddingB
	'] <date>: data),
	obtén: { :fila
		(fila mydate = data) fals: {
			aquesta-tasca error: (
				['S'esperava: <expected> però s'ha obtingut: <observation>']
				<expected>: data,
				<observation>: fila mydate
			).
		}.
	}.
	comptador suma: 1.
} * 100.


# Hora
{
	>> hora     := FormatDosDígits aplica-enter: (Número entre: 1 i: 23), text.
	>> minut   := FormatDosDígits aplica-enter: (Número entre: 1 i: 59), text.
	>> segon   := FormatDosDígits aplica-enter: (Número entre: 1 i: 59), text.
	>> temps := ['HH:II:SS'].
	temps
		HH: hora,
		II: minut,
		SS: segon.
	>> paràmetres-de-cerca :=
	bd consulta: (['
		SELECT CAST("<time>" AS TIME)
		AS mytime
	'] <time>: temps),
	obtén: { :fila
		(fila mytime = temps) fals: {
			aquesta-tasca error: (
				['S'esperava: <expected> però s'ha obtingut: <observation>']
				<expected>: datahora,
				<observation>: fila mytime
			).
		}.
	}.
	comptador suma: 1.
} * 100.


# Textos (varchar/text)
>> str1 := Llista nou omple: 100000 amb: ['x'], uneix: [''].
{
	>> str2 := Caixa-forta token: 40.
	>> paràmetres-de-cerca :=
	bd consulta: (['
		SELECT
		"<str1>" AS str1,
		"<str2>" AS str2
	'] 
	<str1>: str1,
	<str2>: str2
	),
	obtén: { :fila
		(fila str1 = str1 i: fila str2 = str2) fals: {
			aquesta-tasca error: (
				['S'esperava: <expected> però s'ha obtingut: <observation>']
				<expected>: datahora,
				<observation>: fila mytime
			).
		}.
	}.
	comptador suma: 1.
} * 100.


# Números
{
	>> n1  := Número entre: 1 i: 99999.
	>> n2  := n1 / 1000.
	>> big := (
		( Int64 des-de-text: ['9223372036854775807'] ) -
		( Int64 des-de-text: ['99999'] ) +
		( Int64 des-de-text: n1 text )
	).
	>> paràmetres-de-cerca :=
	bd consulta: (['
		SELECT
		<n1> AS n1,
		<n2> AS n2,
		CAST(<n2> AS DECIMAL) AS n3,
		<big> AS big
	']
	<n1>: n1,
	<n2>: n2,
	<big>: big
	),
	obtén: { :fila
		(fila n1 = n1) fals: {
			aquesta-tasca error: (
				['S'esperava: <expected> però s'ha obtingut: <observation>']
				<expected>: n1,
				<observation>: fila n1
			).
		}.
		(fila n2 = n2) fals: {
			aquesta-tasca error: (
				['S'esperava: <expected> però s'ha obtingut: <observation>']
				<expected>: n1,
				<observation>: fila n2
			).
		}.
		(fila n3 = n2 arrodoneix) fals: {
			aquesta-tasca error: (
				['S'esperava: <expected> però s'ha obtingut: <observation>']
				<expected>: n1,
				<observation>: fila n3
			).
		}.
		(fila big = big) fals: {
			aquesta-tasca error: (
				['S'esperava: <expected> però s'ha obtingut: <observation>']
				<expected>: big,
				<observation>: fila big
			).
		}.
		
	}.
	comptador suma: 1.
} * 100.


Sortida escriu: (
	['OK, <counter> fuzzy casts/conversions tested.']
	<counter>: comptador
), salt-de-línia.