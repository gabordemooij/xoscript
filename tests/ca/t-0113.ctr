Sortida escriu: ['Continua el bucle for, No - abans de 6 i més.'], salt-de-línia.
{ :i
	Sortida escriu: (i + 1), salt-de-línia.
	((i + 1) > 4) continua.
	Sortida escriu: ['-'].
} × 10.

>> x := 0.
>> xÉsMenorQue10 := { <- ( x < 10 ). }.
Sortida salt-de-línia.
Sortida escriu: ['Continua el while-true, No --> abans de 5 i més.'], salt-de-línia.
{
	Sortida escriu: ['iteration #'] + x, salt-de-línia.
	x suma: 1.
	((x < 5) no) continua.
	Sortida escriu: ['-->'].
} mentre: xÉsMenorQue10.
Sortida salt-de-línia.
Sortida escriu: ['Continua el while-false, No - només abans de 3.'], salt-de-línia.
{
	Sortida escriu: ['iteration #'] + x, salt-de-línia.
	x resta: 1.
	(x = 3) continua.
	Sortida escriu: ['-'].
} mentre: { <- ( x > 0). }.

Sortida salt-de-línia.
Sortida escriu: ['Continua el bucle times, No ||| abans de 3.'], salt-de-línia.
{ :i
	Sortida escriu: ['iteration #'] + i, salt-de-línia.
	(i = 2) continua.
	Sortida escriu: ['|||'].
} × 5.

Sortida salt-de-línia.

{ Cert continua. Sortida escriu: ['no escriguis això!'], salt-de-línia. } inicia.

{ Cert continua. Sortida escriu: ['no escriguis això!'], salt-de-línia. } captura: { Sortida escriu: ['No capturis això!']. }, inicia.

Sortida escriu: ['Prova del bucle each de la llista: 0, ... ,2'], salt-de-línia.
(Llista ← 1 ; 2 ; 3) transforma: { :i
	(i = 1) continua.
	Sortida escriu: ['iteration #'] + (i - 0), salt-de-línia.
}.

Sortida escriu: ['Prova del bucle each del mapa: només c'], salt-de-línia.
>> m := Diccionari nou.
m posa: ['first'] a: ['a'], posa: ['second'] a: ['b'], posa: ['tercer'] a: ['c'].
m cada: { :k :v
	(k ≠ ['c']) continua.
	Sortida escriu: ['iteration'] + k + v, salt-de-línia.
}.

