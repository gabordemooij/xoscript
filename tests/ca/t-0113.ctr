Sortida escriu: ['Continue for-loop, No - before 6 and up.'], salt-de-línia.
{ :i
	Sortida escriu: (i + 1), salt-de-línia.
	((i + 1) > 4) continua.
	Sortida escriu: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Sortida salt-de-línia.
Sortida escriu: ['Continue while-true, No --> before 5 and up.'], salt-de-línia.
{
	Sortida escriu: ['iteration #'] + x, salt-de-línia.
	x suma: 1.
	((x < 5) no) continua.
	Sortida escriu: ['-->'].
} mentre: xIsLessThan10.
Sortida salt-de-línia.
Sortida escriu: ['Continue while-false, No - before 3 only.'], salt-de-línia.
{
	Sortida escriu: ['iteration #'] + x, salt-de-línia.
	x resta: 1.
	(x = 3) continua.
	Sortida escriu: ['-'].
} mentre: { <- ( x > 0). }.

Sortida salt-de-línia.
Sortida escriu: ['Continue times-loop, No ||| before 3.'], salt-de-línia.
{ :i
	Sortida escriu: ['iteration #'] + i, salt-de-línia.
	(i = 2) continua.
	Sortida escriu: ['|||'].
} × 5.

Sortida salt-de-línia.

{ Cert continua. Sortida escriu: ['dont write this!'], salt-de-línia. } inicia.

{ Cert continua. Sortida escriu: ['dont write this!'], salt-de-línia. } captura: { Sortida escriu: ['Dont catch this!']. }, inicia.

Sortida escriu: ['Test Array each-loop: 0, ... ,2'], salt-de-línia.
(Llista ← 1 ; 2 ; 3) transforma: { :i
	(i = 1) continua.
	Sortida escriu: ['iteration #'] + (i - 0), salt-de-línia.
}.

Sortida escriu: ['Test Map each-loop: c only'], salt-de-línia.
>> m := Diccionari nou.
m posa: ['first'] a: ['a'], posa: ['second'] a: ['b'], posa: ['third'] a: ['c'].
m cada: { :k :v
	(k ≠ ['c']) continua.
	Sortida escriu: ['iteration'] + k + v, salt-de-línia.
}.

