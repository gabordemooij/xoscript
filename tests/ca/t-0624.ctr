# Aquesta prova comprova que string_fill_in no perdi el seu espai (gc'ed) en el mode 4
# referència a world.c
>> Registre := Objecte nou.

Registre en: ['say:'] fes: { :str
	Sortida escriu: str, salt-de-línia.
}.

>> Article := Objecte nou.

Article en: ['nou:'] fes: { :id
	<- jo nou id: id.
}.

Article en: ['id:'] fes: { :id
	propi id := id.
}.

Article en: ['id'] fes: { <- propi id. }.


Article en: ['text'] fes: {
	>> str := ['Item#~no'].
	str ~no: propi id.
	<- str.
}.


>> Print := Objecte nou.

Print en: ['items'] fes: { 
	
	propi article := Article nou: 1.
	
	# o bé segfault o bé una cadena incorrecta aquí
	Registre say: (
		['~item printed.'] ~item: propi article
	).
	
	
}.

Print items.