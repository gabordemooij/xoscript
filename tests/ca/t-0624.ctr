# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := Objecte nou.

Log en: ['say:'] fes: { :str
	Sortida escriu: str, salt-de-línia.
}.

>> Item := Objecte nou.

Item en: ['nou:'] fes: { :id <- jo nou id: id.
}.

Item en: ['id:'] fes: { :id
	propi id := id.
}.

Item en: ['id'] fes: { <- propi id. }.


Item en: ['text'] fes: {
	>> str := ['Item#~no'].
	str ~no: propi id. <- str.
}.


>> Print := Objecte nou.

Print en: ['items'] fes: { 
	
	propi item := Item nou: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: propi item
	).
	
	
}.

Print items.