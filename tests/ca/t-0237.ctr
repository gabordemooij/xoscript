
Text en: ['evaluate'] fes: {
	>> codi := Fitxer nou: ['/tmp/eval.ctr'].
	codi escriu: (jo text + ['.']).
	Programa utilitza: ['/tmp/eval.ctr'].
}.

>> map :=
	(Diccionari nou)
	posa: ['Hi There'] a: ['two'],
	posa: (Llista ← ['hello'] ; ['world'] ; (Llista ← 1 ; 2; 9) ; Fals) a: ['one'],
	posa: ( (Diccionari nou) posa: ['wrrld'] a: ['misspelled'] ) a: ['three'],
	posa: (Llista ← ((Diccionari nou) posa: ['treasure'] a: ['hidden']) ; 2) a: ['four']. 
>> str := map text.
>> map2 := Res.
(['map2 := '] + str ) evaluate.
Sortida escriu: map2 ? ['one'] ? 0.
Sortida escriu: map2 ? ['one'] ? 1.
Sortida escriu: map2 ? ['four'] ? 0 ? ['hidden'].
Sortida escriu: map2 ? ['one'] ? 2 ? 2.
