
Text en: ['avalua'] fes: {
	>> codi := Fitxer nou: ['/tmp/eval.ctr'].
	codi escriu: (jo text + ['.']).
	Programa utilitza: ['/tmp/eval.ctr'].
}.

>> map :=
	(Diccionari nou)
	posa: ['Hola Tothom'] a: ['two'],
	posa: (Llista ← ['hello'] ; ['world'] ; (Llista ← 1 ; 2; 9) ; Fals) a: ['u'],
	posa: ( (Diccionari nou) posa: ['wrrld'] a: ['malescrit'] ) a: ['three'],
	posa: (Llista ← ((Diccionari nou) posa: ['tresor'] a: ['amagat']) ; 2) a: ['quatre']. 
>> str := map text.
>> map2 := Res.
(['map2 := '] + str ) avalua.
Sortida escriu: map2 ? ['u'] ? 0.
Sortida escriu: map2 ? ['u'] ? 1.
Sortida escriu: map2 ? ['quatre'] ? 0 ? ['amagat'].
Sortida escriu: map2 ? ['u'] ? 2 ? 2.
