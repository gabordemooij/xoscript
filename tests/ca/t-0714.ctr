>> a := Objecte nou. 
a en: ['saluda'] fes: { Sortida escriu: ['benvingut!'], salt-de-línia. }.
a en: ['saluda2'] fes: { Sortida escriu: ['benvingut2!'], salt-de-línia. }.
a save-as: ['/tmp/a.bin'].

