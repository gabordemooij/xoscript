

>> g  := Server nou.
>> v  := Caixa-forta nou.
>> ok := 0.

>> secrets := Llista nou ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> contrasenyes := secrets copia.
contrasenyes cada: { :i :p
	secrets cada: { :n :s
		{
			>> xifrat := v xifra: s clau: p.
			>> desxifrat := v desxifra: xifrat clau: p.
			(desxifrat = s) cert: {
				ok suma: 1.
			}, si-no: {
				Sortida escriu: ['ha fallat xifrar/desxifrar: '], salt-de-línia.
				Sortida escriu: s, salt-de-línia.
				Sortida escriu: ['xifrat: '] + xifrat, salt-de-línia.
				Sortida escriu: ['desxifrat: '] + xifrat, salt-de-línia.
				Programa final.
			}.
		} captura: { :err
			(s = [''] o: p = ['']) cert: {
				ok suma: 1.
			}, si-no: {
				Sortida escriu: err, salt-de-línia.
				Programa final.
			}.
		}, inicia.
	}.
}.

Sortida escriu: ( ok + [' xifratges de caixa forta provats.'] ), salt-de-línia.