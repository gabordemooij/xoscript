# les barres inverses han de sobreviure a la serialització del codi, els textos no han d'acabar abans d'hora
>> valors := Llista nou
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

valors cada: { :i :value
	>> d := Diccionari nou.
	d posa: value a: ['k'].
	>> r := d codi objecte.
	Sortida escriu: r compta, salt-de-línia.
	Sortida escriu: ( (r a: ['k']) = value ), salt-de-línia.
}.
