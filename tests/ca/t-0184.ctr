

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa gestió-memòria: 0.

Número en: ['addNum:'] fes: { :x
	jo suma: x.
}.

Número en: ['subtractNum:'] fes: { :x
	jo resta: x.
}.

Número en: ['multiplyBy:'] fes: { :x
	jo multiplica-per: x.
}.

Número en: ['divideBy:'] fes: { :x
	jo divideix-per: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 potència: 8).  
a := a + (2 potència: -1). 
a := a + (49 arrel-quadrada).   
a addNum: ((Llista ← 0 ; 1) màxim).          
a addNum: ((Llista ← 2 ; 3) mínim).
Sortida escriu: a.

Programa neteja.

usedMemory1 := (Programa memòria ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 potència: 8).  
a := a + (2 potència: -1). 
a := a + (49 arrel-quadrada).   
a addNum: ((Llista ← 0 ; 1) màxim).          
a addNum: ((Llista ← 2 ; 3) mínim).
Sortida escriu: a.

Programa neteja.
usedMemory2 := (Programa memòria ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 potència: 8).  
a := a + (2 potència: -1). 
a := a + (49 arrel-quadrada).   
a addNum: ((Llista ← 0 ; 1) màxim).          
a addNum: ((Llista ← 2 ; 3) mínim).
Sortida escriu: a.

Programa neteja.
usedMemory3 := (Programa memòria ? 0).



( usedMemory1 = usedMemory2 i: usedMemory1 = usedMemory3, i: usedMemory2 = usedMemory3 ) cert: {
	Sortida escriu: ['No memory leaks here'].
}, fals: {
	Sortida escriu: ['Leaking memory...'].
}.
