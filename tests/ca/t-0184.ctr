

>> memòriaUsada1 := 0.
>> memòriaUsada2 := 0.
>> memòriaUsada3 := 0.
>> memòriaUsada4 := 0.

Programa gestió-memòria: 0.

Número en: ['addNum:'] fes: { :x
	jo suma: x.
}.

Número en: ['subtractNum:'] fes: { :x
	jo resta: x.
}.

Número en: ['multiplyBy:'] fes: { :x
	jo multiplica-per: x.
}.

Número en: ['divideBy:'] fes: { :x
	jo divideix-per: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 potència: 8).  
a := a + (2 potència: -1). 
a := a + (49 arrel-quadrada).   
a addNum: ((Llista ← 0 ; 1) màxim).          
a addNum: ((Llista ← 2 ; 3) mínim).
Sortida escriu: a.

Programa neteja.

memòriaUsada1 := (Programa memòria ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 potència: 8).  
a := a + (2 potència: -1). 
a := a + (49 arrel-quadrada).   
a addNum: ((Llista ← 0 ; 1) màxim).          
a addNum: ((Llista ← 2 ; 3) mínim).
Sortida escriu: a.

Programa neteja.
memòriaUsada2 := (Programa memòria ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 potència: 8).  
a := a + (2 potència: -1). 
a := a + (49 arrel-quadrada).   
a addNum: ((Llista ← 0 ; 1) màxim).          
a addNum: ((Llista ← 2 ; 3) mínim).
Sortida escriu: a.

Programa neteja.
memòriaUsada3 := (Programa memòria ? 0).



( memòriaUsada1 = memòriaUsada2 i: memòriaUsada1 = memòriaUsada3, i: memòriaUsada2 = memòriaUsada3 ) cert: {
	Sortida escriu: ['Aquí no hi ha fuites de memòria'].
}, fals: {
	Sortida escriu: ['Perdent memòria...'].
}.
