Sortida escriu: ['Objecte de prova'], salt-de-línia.
>> a := Objecte nou. 

a en: ['state:'] fes: { :list
	propi list := list. 
}.

a en: ['estat'] fes: {
	Sortida escriu: propi list, salt-de-línia.
}.

a state: ( Llista nou ; ['elementllista'] ; ['element2'] ).
a estat.

a save-as: ['/tmp/a.bin'].
Sortida escriu: ['========== RECARREGANT INSTANTÀNIA:'], salt-de-línia.
>> b := Objecte load-from: ['/tmp/a.bin'].
b estat.