
>> a := Llista ← (Llista ← 100 ; 200 ; 300) ; (Llista ← 9 ; 8 ; 7).
Sortida escriu: ['a 0,1 :'].
Sortida escriu: a ? 0 ? 1, salt-de-línia. 
Sortida escriu: ['a 1,2 :'].
Sortida escriu: a ? 1 ? 2, salt-de-línia. 
>> menú := Diccionari nou.
menú posa: (Llista ← ['pizza'] ; ['espaguetis']) a: ['Cuina italiana'].
menú posa: (Llista ← ['bifteki'] ; ['suflaki']) a: ['Cuina grega'].
Sortida escriu: ['M'encanta '] + (menú ? ['Cuina grega'] ? 0) + [' i '] + (menú ? ['Cuina italiana'] ? 1), salt-de-línia. 
Sortida escriu: ['però no al mateix plat.'], salt-de-línia.
