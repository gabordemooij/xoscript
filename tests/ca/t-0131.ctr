
>> a := Llista ← (Llista ← 100 ; 200 ; 300) ; (Llista ← 9 ; 8 ; 7).
Sortida escriu: ['at 0,1 :'].
Sortida escriu: a ? 0 ? 1, salt-de-línia. 
Sortida escriu: ['at 1,2 :'].
Sortida escriu: a ? 1 ? 2, salt-de-línia. 
>> menu := Diccionari nou.
menu posa: (Llista ← ['pizza'] ; ['spaghetti']) a: ['Italian Cuisine'].
menu posa: (Llista ← ['bifteki'] ; ['suflaki']) a: ['Greek Cuisine'].
Sortida escriu: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), salt-de-línia. 
Sortida escriu: ['but not on the same plate.'], salt-de-línia.
