


>> memòriaUsada1 := 0.
>> memòriaUsada2 := 0.
>> memòriaUsada3 := 0.
>> memòriaUsada4 := 0.

Programa gestió-memòria: 0.
>> paleta := Res.
>> colors := Res.

{
paleta := Diccionari nou.
paleta 
	posa: ['#F00'] a: ['vermell'],
	posa: ['#0F0'] a: ['verd'],
	posa: ['#00F'] a: ['blau'].
Sortida escriu: ['nombre de codis RGB a la paleta: '] + ( paleta compta ), salt-de-línia.
Sortida escriu: ['el codi RGB del verd és: '] + ( paleta ? ['verd'] ), salt-de-línia.
colors := [''].
( paleta cada: { :nom :codi
		colors := colors + ( nom + [':'] + codi ).
} ).
Sortida escriu: ['Tots els colors de la paleta: '] + colors, salt-de-línia.
} inicia.
Programa neteja.
memòriaUsada1 := (Programa memòria ? 0).

{
paleta := Diccionari nou.
paleta 
	posa: ['#F00'] a: ['vermell'],
	posa: ['#0F0'] a: ['verd'],
	posa: ['#00F'] a: ['blau'].
Sortida escriu: ['nombre de codis RGB a la paleta: '] + ( paleta compta ), salt-de-línia.
Sortida escriu: ['el codi RGB del verd és: '] + ( paleta ? ['verd'] ), salt-de-línia.
colors := [''].
( paleta cada: { :nom :codi
		colors := colors + ( nom + [':'] + codi ).
} ).
Sortida escriu: ['Tots els colors de la paleta: '] + colors, salt-de-línia.
} inicia.
Programa neteja.
memòriaUsada2 := (Programa memòria ? 0).

{
paleta := Diccionari nou.
paleta 
	posa: ['#F00'] a: ['vermell'],
	posa: ['#0F0'] a: ['verd'],
	posa: ['#00F'] a: ['blau'].
Sortida escriu: ['nombre de codis RGB a la paleta: '] + ( paleta compta ), salt-de-línia.
Sortida escriu: ['el codi RGB del verd és: '] + ( paleta ? ['verd'] ), salt-de-línia.
colors := [''].
( paleta cada: { :nom :codi
		colors := colors + ( nom + [':'] + codi ).
} ).
Sortida escriu: ['Tots els colors de la paleta: '] + colors, salt-de-línia.
} inicia.
Programa neteja.
memòriaUsada3 := (Programa memòria ? 0).



( memòriaUsada1 = memòriaUsada2 i: memòriaUsada1 = memòriaUsada3, i: memòriaUsada2 = memòriaUsada3 ) cert: {
	Sortida escriu: ['Aquí no hi ha fuites de memòria'].
}, fals: {
	Sortida escriu: ['Perdent memòria...'].
}.
