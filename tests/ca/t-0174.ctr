


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa gestió-memòria: 0.
>> palette := Res.
>> colors := Res.

{
palette := Diccionari nou.
palette 
	posa: ['#F00'] a: ['red'],
	posa: ['#0F0'] a: ['green'],
	posa: ['#00F'] a: ['blue'].
Sortida escriu: ['number of RGB codes in palette: '] + ( palette compta ), salt-de-línia.
Sortida escriu: ['RGB code of green is: '] + ( palette ? ['green'] ), salt-de-línia.
colors := [''].
( palette cada: { :nom :codi
		colors := colors + ( nom + [':'] + codi ).
} ).
Sortida escriu: ['All colors in palette: '] + colors, salt-de-línia.
} inicia.
Programa neteja.
usedMemory1 := (Programa memòria ? 0).

{
palette := Diccionari nou.
palette 
	posa: ['#F00'] a: ['red'],
	posa: ['#0F0'] a: ['green'],
	posa: ['#00F'] a: ['blue'].
Sortida escriu: ['number of RGB codes in palette: '] + ( palette compta ), salt-de-línia.
Sortida escriu: ['RGB code of green is: '] + ( palette ? ['green'] ), salt-de-línia.
colors := [''].
( palette cada: { :nom :codi
		colors := colors + ( nom + [':'] + codi ).
} ).
Sortida escriu: ['All colors in palette: '] + colors, salt-de-línia.
} inicia.
Programa neteja.
usedMemory2 := (Programa memòria ? 0).

{
palette := Diccionari nou.
palette 
	posa: ['#F00'] a: ['red'],
	posa: ['#0F0'] a: ['green'],
	posa: ['#00F'] a: ['blue'].
Sortida escriu: ['number of RGB codes in palette: '] + ( palette compta ), salt-de-línia.
Sortida escriu: ['RGB code of green is: '] + ( palette ? ['green'] ), salt-de-línia.
colors := [''].
( palette cada: { :nom :codi
		colors := colors + ( nom + [':'] + codi ).
} ).
Sortida escriu: ['All colors in palette: '] + colors, salt-de-línia.
} inicia.
Programa neteja.
usedMemory3 := (Programa memòria ? 0).



( usedMemory1 = usedMemory2 i: usedMemory1 = usedMemory3, i: usedMemory2 = usedMemory3 ) cert: {
	Sortida escriu: ['No memory leaks here'].
}, fals: {
	Sortida escriu: ['Leaking memory...'].
}.
