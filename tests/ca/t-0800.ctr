Server init.

>> db := Maria-DB nou amfitrió: ['localhost'],
	usuari: ['xo'],
	contrasenya: ['pass123'],
	nom-base: ['xobase'],
	connecta.

>> paràmetres-de-cerca := db consulta: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], paràmetres: ( Llista nou ; ['abc'] ; 12.35 ; 6 ). # parameterized queries

{  paràmetres-de-cerca executa. db confirma. } captura: { :e db desfés.  }, inicia.

Sortida escriu: ['Can we insert? '] + ( paràmetres-de-cerca insert-id > 0 ), salt-de-línia.
