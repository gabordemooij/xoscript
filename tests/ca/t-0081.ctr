>> map1 := Diccionari nou.
>> key1 := Llista nou.
>> key2 := Llista nou.

map1
	posa: ['hello'] a: key1,
	posa: ['world'] a: key2.


Sortida
	escriu: ['Map #1 contains: '] + (map1 a: key1),
	escriu: [' and '] + (map1 a: key2), salt-de-línia.

>> KeyeableArray := Llista nou.
KeyeableArray en: ['toString'] fes: { <- (jo compta) toString.
}.

>> map2 := Diccionari nou.
key1 := KeyeableArray nou.
key2 := KeyeableArray nou.

key1 afegeix-al-final: 1.

map2
	posa: ['hello'] a: key1,
	posa: ['world'] a: key2.

Sortida
	escriu: ['Map #2 contains: '] + (map2 a: key1),
	escriu: [' and '] + (map2 a: key2), salt-de-línia.
