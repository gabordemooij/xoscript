>> mapa1 := Diccionari nou.
>> clau1 := Llista nou.
>> clau2 := Llista nou.

mapa1
	posa: ['hello'] a: clau1,
	posa: ['world'] a: clau2.


Sortida
	escriu: ['Map #1 contains: '] + (mapa1 a: clau1),
	escriu: [' i '] + (mapa1 a: clau2), salt-de-línia.

>> LlistaAmbClaus := Llista nou.
LlistaAmbClaus en: ['aText'] fes: { <- (jo compta) aText.
}.

>> map2 := Diccionari nou.
clau1 := LlistaAmbClaus nou.
clau2 := LlistaAmbClaus nou.

clau1 afegeix-al-final: 1.

map2
	posa: ['hello'] a: clau1,
	posa: ['world'] a: clau2.

Sortida
	escriu: ['Map #2 contains: '] + (map2 a: clau1),
	escriu: [' i '] + (map2 a: clau2), salt-de-línia.
