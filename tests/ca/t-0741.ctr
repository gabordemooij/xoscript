Sortida escriu: ['Objecte de prova'], salt-de-línia.
>> a := Objecte nou. 

a en: ['item:'] fes: { :ajudantoct
	propi ajudantoct := ajudantoct. 
}.

a en: ['article'] fes: {
	<- propi ajudantoct.
}.

a item: Oct nou.

>> adreça-antiga-ajudantoct := a article prototip adreça-de-memòria.
a save-as: ['/tmp/a.bin'].
Sortida escriu: ['========== RECARREGANT INSTANTÀNIA:'], salt-de-línia.

>> b := Objecte load-from: ['/tmp/a.bin'].

(b article prototip adreça-de-memòria = adreça-antiga-ajudantoct) cert: {
	Sortida escriu: ['Enllaç d'objecte reconnectat.'], salt-de-línia.
}.
