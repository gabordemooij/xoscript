Sortida escriu: ['Test object'], salt-de-línia.
>> a := Objecte nou. 

a en: ['item:'] fes: { :octhelper
	propi octhelper := octhelper. 
}.

a en: ['item'] fes: { <- propi octhelper.
}.

a item: Oct nou.

>> old-octhelper-address := a item prototip adreça-de-memòria.
a save-as: ['/tmp/a.bin'].
Sortida escriu: ['========== RELOADING SNAP:'], salt-de-línia.

>> b := Objecte load-from: ['/tmp/a.bin'].

(b item prototip adreça-de-memòria = old-octhelper-address) cert: {
	Sortida escriu: ['Object link re-attached.'], salt-de-línia.
}.
