Server init.

>> db := Maria-DB nou amfitrió: ['localhost'],
	usuari: ['xo'],
	contrasenya: ['pass123'],
	nom-base: ['xobase'],
	connecta.

>> del := db consulta: ['DELETE FROM book WHERE id > 0'].
{  del executa. db confirma. } captura: { :e db desfés.  }, inicia.

>> compta := db consulta: ['SELECT COUNT(*) AS num FROM book'].
compta obtén: { :row Sortida escriu: row num, salt-de-línia. }.
