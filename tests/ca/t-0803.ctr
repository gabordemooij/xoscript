#...
>> del := conn1 consulta: ['DELETE FROM book WHERE id > 0'].
{  del executa. conn1 confirma. } captura: { :e conn1 desfés.  }, inicia.

>> insert := conn1 consulta: ['INSERT INTO book (id) VALUES(null)'].
insert executa.

>> compta := conn1 consulta: ['SELECT COUNT(*) AS num FROM book'].
compta obtén: { :row Sortida escriu: row num, salt-de-línia. }.

# does not show up
# insert not committed on connection 1
>> compta := conn2 consulta: ['SELECT COUNT(*) AS num FROM book'].
compta obtén: { :row Sortida escriu: row num, salt-de-línia. }.
