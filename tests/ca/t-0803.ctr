Server init.

>> con1 := Maria-DB nou amfitrió: ['localhost'],
	usuari: ['xo'],
	contrasenya: ['pass123'],
	nom-base: ['xobase'],
	connecta.

>> con2 := Maria-DB nou amfitrió: ['localhost'],
	usuari: ['xo'],
	contrasenya: ['pass123'],
	nom-base: ['xobase'],
	connecta.
#...
>> esb := con1 consulta: ['DELETE FROM book WHERE id > 0'].
{  esb executa. con1 confirma. } captura: { :e con1 desfés.  }, inicia.

>> inserció := con1 consulta: ['INSERT INTO book (id) VALUES(null)'].
inserció executa.

>> compta := con1 consulta: ['SELECT COUNT(*) AS num FROM book'].
compta obtén: { :fila Sortida escriu: fila num, salt-de-línia. }.

# no apareix
# inserció no confirmada a la connexió 1
>> compta := con2 consulta: ['SELECT COUNT(*) AS num FROM book'].
compta obtén: { :fila Sortida escriu: fila num, salt-de-línia. }.
