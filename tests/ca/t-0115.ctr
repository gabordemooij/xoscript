{
	aquesta-tasca error: ['Dont fail.'].
	unknown doSomething.
} captura: {
	Sortida escriu: ['Caught!'].
}, inicia.

{
	aquesta-tasca error: ['Dont fail.'].
	propi unknown doSomething.
} captura: {
	Sortida escriu: ['Caught!'].
}, inicia.

{
	aquesta-tasca error: ['Dont fail.'].
	unknown := 122.
} captura: {
	Sortida escriu: ['Caught!'].
}, inicia.


{
	aquesta-tasca error: ['Dont fail.'].
	Cert interromp.
	Sortida escriu: ['FAIL'].
} captura: {
	Sortida escriu: ['Caught!'].
}, inicia.

{
	{
		aquesta-tasca error: ['Dont fail.'].
		Cert interromp.
		Sortida escriu: ['FAIL'].
	} captura: { :x
		(x = ['Dont fail.']) cert: { aquesta-tasca error: ['Nested Caught!']. }.
	}, inicia.
} captura: { :e
	Sortida escriu: e.
}, inicia.
