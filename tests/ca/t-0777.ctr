#OBSD
>> dirname := [''].
{ dirname afegeix-al-final: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Programa sistema: command.
Programa chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename afegeix-al-final: ['YYYYYYYY']. } * 20.
Fitxer nou: filename, escriu: ['sometext'].
{ Fitxer llista: ['/tmp/'] + dirname. } * 1000.
Sortida escriu: ['no crash'], salt-de-línia.

