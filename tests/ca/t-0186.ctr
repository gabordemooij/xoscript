

>> memòriaUsada1 := 0.
>> memòriaUsada2 := 0.
>> memòriaUsada3 := 0.
>> memòriaUsada4 := 0.

Programa gestió-memòria: 0.

Sortida escriu: (6 < 5), salt-de-línia.
Sortida escriu: (2 > 1), salt-de-línia.
Sortida escriu: (2 ≤ 1), salt-de-línia.
Sortida escriu: (9 ≥ 1), salt-de-línia.
Sortida escriu: (2 senar?), salt-de-línia.
Sortida escriu: (4 parell?), salt-de-línia.
Sortida escriu: (-1 positiu?), salt-de-línia.
Sortida escriu: (-2 negatiu?), salt-de-línia.
Sortida escriu: ((3 ≥ 4) & (3 ≤ 5)), salt-de-línia.
Sortida escriu: (3 = 3), salt-de-línia.
Sortida escriu: (3 ≠ 3), salt-de-línia.
Sortida escriu: 1 booleà, salt-de-línia.

Programa neteja.

memòriaUsada1 := (Programa memòria ? 0).


Sortida escriu: (6 < 5), salt-de-línia.
Sortida escriu: (2 > 1), salt-de-línia.
Sortida escriu: (2 ≤ 1), salt-de-línia.
Sortida escriu: (9 ≥ 1), salt-de-línia.
Sortida escriu: (2 senar?), salt-de-línia.
Sortida escriu: (4 parell?), salt-de-línia.
Sortida escriu: (-1 positiu?), salt-de-línia.
Sortida escriu: (-2 negatiu?), salt-de-línia.
Sortida escriu: ((3 ≥ 4) & (3 ≤ 5)), salt-de-línia.
Sortida escriu: (3 = 3), salt-de-línia.
Sortida escriu: (3 ≠ 3), salt-de-línia.
Sortida escriu: 1 booleà, salt-de-línia.

Programa neteja.
memòriaUsada2 := (Programa memòria ? 0).


Sortida escriu: (6 < 5), salt-de-línia.
Sortida escriu: (2 > 1), salt-de-línia.
Sortida escriu: (2 ≤ 1), salt-de-línia.
Sortida escriu: (9 ≥ 1), salt-de-línia.
Sortida escriu: (2 senar?), salt-de-línia.
Sortida escriu: (4 parell?), salt-de-línia.
Sortida escriu: (-1 positiu?), salt-de-línia.
Sortida escriu: (-2 negatiu?), salt-de-línia.
Sortida escriu: ((3 ≥ 4) & (3 ≤ 5)), salt-de-línia.
Sortida escriu: (3 = 3), salt-de-línia.
Sortida escriu: (3 ≠ 3), salt-de-línia.
Sortida escriu: 1 booleà, salt-de-línia.

Programa neteja.
memòriaUsada3 := (Programa memòria ? 0).



( memòriaUsada1 = memòriaUsada2 i: memòriaUsada1 = memòriaUsada3, i: memòriaUsada2 = memòriaUsada3 ) cert: {
	Sortida escriu: ['Aquí no hi ha fuites de memòria'].
}, fals: {
	Sortida escriu: ['Perdent memòria...'].
}.
