
Server init.
>> pet := Petició-HTTP nou.
Sortida escriu: ['HTTP-GET d[]=']  + ( pet get-llista: ['d[]'] ), salt-de-línia. # GET
Sortida escriu: ['HTTP-GET f[]=']  + ( pet get-llista: ['f[]'] ), salt-de-línia. # GET
Sortida escriu: ['HTTP-POST e[]='] + ( pet post-llista: ['e[]'] ), salt-de-línia. # GET
Sortida escriu: ['HTTP-POST c=']   + ( pet post: ['c'] ), salt-de-línia. # GET
Sortida escriu: ['HTTP-POST xx=']  + ( pet post: ['xx'] ), salt-de-línia. # GET
