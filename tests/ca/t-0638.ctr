
Server init.
>> rq := Petició-HTTP nou.
Sortida escriu: ['HTTP-GET d[]=']  + ( rq get-llista: ['d[]'] ), salt-de-línia. # GET
Sortida escriu: ['HTTP-GET f[]=']  + ( rq get-llista: ['f[]'] ), salt-de-línia. # GET
Sortida escriu: ['HTTP-POST e[]='] + ( rq post-llista: ['e[]'] ), salt-de-línia. # GET
Sortida escriu: ['HTTP-POST c=']   + ( rq post: ['c'] ), salt-de-línia. # GET
Sortida escriu: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), salt-de-línia. # GET
