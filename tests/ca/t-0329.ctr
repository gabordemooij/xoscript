Sortida escriu: ((Llista nou
	en: ['plaque:'] fes: { :x propi o := x. },
	en: ['plaque']  fes: { <- propi o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Llista ← 1)
	~ (Llista ← 1 ; 2)
	~ (Llista ← 1 ; 2 ; 3)
	~ (Llista ← 1 ; 2 ; 3 ; 4)
	~ (Llista ← 1 ; 2 ; 3 ; 4 ; 5)
) cada: { :i :el
	{ Sortida escriu: aquesta-tasca. } × el compta.
	Sortida salt-de-línia.
}) plaque, salt-de-línia.


