Sortida escriu: ['Test object'], salt-de-línia.
>> a := Objecte nou. 

a en: ['item:'] fes: { :moment
	propi moment := moment. 
}.

a en: ['item'] fes: { <- propi moment.
}.

>> today := Moment nou zona: ['CEST'], any: 2026, mes: 7.
a item: today.
Sortida escriu: a item, salt-de-línia.
a save-as: ['/tmp/a.bin'].

