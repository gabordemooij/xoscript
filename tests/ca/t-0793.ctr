Server init.

>> DB := Maria-DB nou amfitrió: ['localhost'],
	usuari: ['xo'],
	contrasenya: ['pass123'],
	nom-base: ['xobase'],
	connecta.

{
	DB consulta:
	['DROP TABLE movies'],
	executa.
} captura: { Res. }, inicia.

DB consulta:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
executa.

DB consulta: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
paràmetres: ( Llista nou ; ['Halloween'] ),
executa.

DB consulta: ['SELECT * FROM movies'],
obtén: { :movie
	Sortida escriu: movie title, salt-de-línia.
}.

