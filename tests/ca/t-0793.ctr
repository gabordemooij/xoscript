Server init.

>> BD := Maria-DB nou amfitrió: ['localhost'],
	usuari: ['xo'],
	contrasenya: ['pass123'],
	nom-base: ['xobase'],
	connecta.

{
	BD consulta:
	['DROP TABLE movies'],
	executa.
} captura: { Res. }, inicia.

BD consulta:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
executa.

BD consulta: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
paràmetres: ( Llista nou ; ['Halloween'] ),
executa.

BD consulta: ['SELECT * FROM movies'],
obtén: { :film
	Sortida escriu: film title, salt-de-línia.
}.

