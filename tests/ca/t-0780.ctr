Server init.

# el codificador JSON només admet UTF-8, sense parells subrogats

>> diccs := Llista nou ;
	# {"key":"normal"} ASCII normal
	( Diccionari nou posa: ['normal'] a: ['key'] ) ;
	# {"key":"hello world"} caràcter d'espai
	( Diccionari nou posa: ['hello world'] a: ['key'] ) ;
	# {"key":"quote: \""} cometa doble
	( Diccionari nou posa: ['"'] a: ['key'] ) ;
	# {"key":"backslash: \\"} barra inversa
	( Diccionari nou posa: ['backslash: \\'] a: ['key'] ) ;
	# {"key":"slash: /"} barra
	( Diccionari nou posa: ['barra: /'] a: ['key'] ) ;
	# {"key":"backspace: \b"} retrocés
	( Diccionari nou posa: ['backspace: \b'] a: ['key'] ) ;
	# {"key":"formfeed: \f"} escapament de salt de pàgina
	( Diccionari nou posa: ['formfeed: \f'] a: ['key'] ) ;
	# {"key":"newline: \n"} salt de línia
	( Diccionari nou posa: ['newline: \n'] a: ['key'] ) ;
	( Diccionari nou posa: ['newline: ↵'] a: ['key'] ) ;
	( Diccionari nou posa: ['newline: 
	'] a: ['key'] ) ;
	# {"key":"carriage return: \r"} retorn de carro
	( Diccionari nou posa: ['carriage return: \r'] a: ['key'] ) ;
	# {"key":"tab: \t"} tabulació
	( Diccionari nou posa: ['tab \t'] a: ['key'] ) ;
	( Diccionari nou posa: ['tab ⇿'] a: ['key'] ) ;
	( Diccionari nou posa: ['tabulador  '] a: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( Diccionari nou posa: ['NUL \u0000'] a: ['key'] ) ;
	( Diccionari nou posa: ['NUL \0'] a: ['key'] ) ;
	# {"key":"control: \u0001"} caràcter de control 0x01
	( Diccionari nou posa: ['control: \u0001'] a: ['key'] ) ;
	# {"key":"control: \u001F"} caràcter de control 0x1F
	( Diccionari nou posa: ['control: \u001F'] a: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, caràcter de 2 bytes
	( Diccionari nou posa: ['unicode: é'] a: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, caràcter de 3 bytes
	( Diccionari nou posa: ['unicode: €'] a: ['key'] ) ;
	# {"key":"unicode: 日本語"} diversos caràcters UTF-8 de 3 bytes
	( Diccionari nou posa: ['unicode: 日本語'] a: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, caràcter de 4 bytes
	( Diccionari nou posa: ['unicode: 😀'] a: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + unió d'amplada zero
	( Diccionari nou posa: ['unicode: 🧑‍💻'] a: ['key'] ) ;
	# {"key":"combining: é"} accent combinant
	( Diccionari nou posa: ['combining: e\u0301'] a: ['key'] ) ;
	# {"key":"escaped unicode: é"} escapament Unicode BMP
	( Diccionari nou posa: ['escaped unicode: \u00e9'] a: ['key'] ) ;
	# {"key":"escaped unicode: €"} escapament Unicode BMP
	( Diccionari nou posa: ['escaped unicode: \u20ac'] a: ['key'] ) ;
	# {"key":"escaped unicode: 😀"} parell subrogat UTF-16
	( Diccionari nou posa: ['escaped unicode: \ud83d\ude00'] a: ['key'] ) ;
	# {"key":""} valor buit
	( Diccionari nou posa: [''] a: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} caràcters ASCII especials
	( Diccionari nou posa: ['@ < > & = % + ? #'] a: ['key'] ) ;
	# {"key":"single quote: '"} cometa simple
	( Diccionari nou posa: ['''] a: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} diversos escapaments JSON
	( Diccionari nou posa: ['multiple: \" \\ \n \r \t'] a: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} text ASCII més llarg
	( Diccionari nou posa: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] a: ['key'] ) ;
	# {"key":" value"} espai inicial
	( Diccionari nou posa: [' valor'] a: ['key'] ) ;
	# {"key":"value "} espai final
	( Diccionari nou posa: ['valor '] a: ['key'] ) ;
	# {"key":" \t\n\r "} espais en blanc
	( Diccionari nou posa: [' \t\n\r '] a: ['key'] )
	.

diccs cada: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (Diccionari nou posa: d key a: ['key']).
	>> b := JSON jsonify: (Diccionari nou posa: ['value'] a: d key).
	>> e := JSON objecte: a.
	>> f := JSON objecte: b.
	((e key = d key i: (f ? d key = ['value'])) o: (e key = ['NUL ?'])) cert: {
		Sortida escriu: ['OK'], salt-de-línia.
	}, si-no: {
		Sortida escriu: ['No es pot codificar/descodificar bé: '] + d + j, salt-de-línia.
		Programa final.
	}.
}.
