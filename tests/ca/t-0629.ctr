# prova de base de dades
# vegeu l'exemple server.xo per a la configuració necessària

Server init.
Sortida escriu: ['Prova de base de dades'], salt-de-línia.

>> bd := Maria-DB nou amfitrió: ['localhost'],
	usuari: ['xo'], contrasenya: ['pass123'], nom-base: ['xobase'], connecta.

Sortida escriu: ['Podem connectar? '] + bd connectat?, salt-de-línia.

>> paràmetres-de-cerca := bd consulta: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], paràmetres: ( Llista nou ; ['abc'] ; 12.35 ; 6 ). # consultes parametritzades

{  paràmetres-de-cerca executa. bd confirma. } captura: { :e bd desfés.  }, inicia.

Sortida escriu: ['Podem inserir? '] + ( paràmetres-de-cerca insert-id > 0 ), salt-de-línia.

>> Obj := Objecte nou.
Obj en: ['recupera-files'] fes: {
	propi compta := 0.
	>> paràmetres-de-cerca :=
	bd consulta: ['SELECT * FROM book order by id desc limit 2'], 
	obtén: { :fila 
		propi compta suma: 1.
		Cert interromp.
	}. # obtenció de files
	<- propi compta copia.
}.

Sortida escriu: ['Podem consultar? '] + ( Obj recupera-files > 0 ), salt-de-línia.
