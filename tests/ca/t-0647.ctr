Server init.
Sortida escriu: ['Prova d'hora a la base de dades'], salt-de-línia.

>> bd := Maria-DB nou amfitrió: ['localhost'],
	usuari: ['xo'], 
	contrasenya: ['pass123'],
	nom-base: ['xobase'],
	connecta.

>> paràmetres-de-cerca :=
bd consulta: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
obtén: { :fila
	Sortida escriu: fila timetest, salt-de-línia.
}.
