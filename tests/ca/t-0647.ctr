Server init.
Sortida escriu: ['Database time test'], salt-de-línia.

>> db := Maria-DB nou amfitrió: ['localhost'],
	usuari: ['xo'], 
	contrasenya: ['pass123'],
	nom-base: ['xobase'],
	connecta.

>> paràmetres-de-cerca :=
db consulta: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
obtén: { :row
	Sortida escriu: row timetest, salt-de-línia.
}.
