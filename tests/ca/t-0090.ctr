Sortida escriu: ['1,2,3,4,5,6,7,8,9,A,'], salt-de-línia.
>> Scope := Objecte nou.
Scope en: ['initialize:'] fes: { :x propi property := x. }.
Scope en: ['confirm'] fes: { Sortida escriu: [',']. }.
Scope en: ['prova'] fes: {
	Sortida escriu: propi property.
	jo confirm.
	( 1 = 1 ) cert: { Sortida escriu: propi property. jo confirm. }.
	( 1 = 0 ) fals: { Sortida escriu: propi property. jo confirm. }.
	>> y := 2. { Sortida escriu: propi property. jo confirm. } mentre: { y resta: 1. <- (y > 0). }.
	{ Sortida escriu: propi property. jo confirm. } × 1.
	(Llista ← 1) cada: {  Sortida escriu: propi property. jo confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Diccionari nou one: ['item']) cada: { Sortida escriu: propi property. jo confirm. }.
	{ 1 ÷ 0. } captura: { Sortida escriu: propi property. jo confirm. }, inicia.
	Sortida salt-de-línia.
}.
