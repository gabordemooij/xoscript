Sortida escriu: ['1,2,3,4,5,6,7,8,9,A,'], salt-de-línia.
>> Àmbit := Objecte nou.
Àmbit en: ['initialize:'] fes: { :x propi propietat := x. }.
Àmbit en: ['certifica'] fes: { Sortida escriu: [',']. }.
Àmbit en: ['prova'] fes: {
	Sortida escriu: propi propietat.
	jo certifica.
	( 1 = 1 ) cert: { Sortida escriu: propi propietat. jo certifica. }.
	( 1 = 0 ) fals: { Sortida escriu: propi propietat. jo certifica. }.
	>> y := 2. { Sortida escriu: propi propietat. jo certifica. } mentre: { y resta: 1. <- (y > 0). }.
	{ Sortida escriu: propi propietat. jo certifica. } × 1.
	(Llista ← 1) cada: {  Sortida escriu: propi propietat. jo certifica. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo implementar ordenació pròpia, aquesta prova falla perquè el nombre d'iteracions difereix per plataforma
	(Diccionari nou one: ['item']) cada: { Sortida escriu: propi propietat. jo certifica. }.
	{ 1 ÷ 0. } captura: { Sortida escriu: propi propietat. jo certifica. }, inicia.
	Sortida salt-de-línia.
}.
>> àmbit1 := Àmbit nou.
àmbit1 initialize: ['X'].
àmbit1 prova.
>> bloc := { 
	propi propietat := ['Y'].
	Sortida escriu: propi propietat.
	jo certifica.
	( 1 = 1 ) cert: { Sortida escriu: propi propietat. jo certifica. }.
	( 1 = 0 ) fals: { Sortida escriu: propi propietat. jo certifica. }.
	>> y := 2. { Sortida escriu: propi propietat. jo certifica. } mentre: { y resta: 1. <- (y > 0). }.
	{ Sortida escriu: propi propietat. jo certifica. } × 1.
	(Llista ← 1) cada: {  Sortida escriu: propi propietat. jo certifica. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Diccionari nou one: ['item']) cada: { Sortida escriu: propi propietat. jo certifica. }.
	{ 1 ÷ 0. } captura: { Sortida escriu: propi propietat. jo certifica. }, inicia.
	Sortida salt-de-línia.
}.
bloc en: ['certifica'] fes: { Sortida escriu: [',']. }.
bloc aplica: 1 i: 2.
