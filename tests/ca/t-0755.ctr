Sortida escriu: ['Objecte de prova'], salt-de-línia.
>> salutador := Objecte nou.
salutador en: ['name:'] fes: { :nom
	propi xnom := nom. 
}.
salutador en: ['saluda'] fes: {
	Sortida escriu: ['Hola '] + propi xnom, salt-de-línia.
}.
salutador name: ['Sherlock'].
salutador save-as: ['/tmp/a.bin'].
Sortida escriu: ['========== RECARREGANT INSTANTÀNIA:'], salt-de-línia.
>> b := Objecte load-from: ['/tmp/a.bin'].
b saluda.
b name: ['Watson'], saluda.
