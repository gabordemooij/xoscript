Sortida escriu: ['Test object'], salt-de-línia.
>> greeter := Objecte nou.
greeter en: ['name:'] fes: { :nom
	propi xname := nom. 
}.
greeter en: ['greet'] fes: {
	Sortida escriu: ['Hello '] + propi xname, salt-de-línia.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
Sortida escriu: ['========== RELOADING SNAP:'], salt-de-línia.
>> b := Objecte load-from: ['/tmp/a.bin'].
b greet.
b name: ['Watson'], greet.
