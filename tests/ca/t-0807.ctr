# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB nou amfitrió: ['localhost'],
	usuari: ['xo'],
	contrasenya: ['pass123'],
	nom-base: ['xobase'],
	connecta.

>> paràmetres-de-cerca := db consulta: ['SELECT %% FROM'].
{ paràmetres-de-cerca executa. } captura: { :e
	Sortida escriu: ( e conté: ['%%'] ), salt-de-línia.
}, inicia.
