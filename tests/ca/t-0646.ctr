Server init.
Sortida escriu: ['Database datetime test'], salt-de-línia.

>> db := Maria-DB nou amfitrió: ['localhost'],
	usuari: ['xo'], 
	contrasenya: ['pass123'],
	nom-base: ['xobase'],
	connecta.

>> paràmetres-de-cerca :=
db consulta: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
obtén: { :row
	Sortida escriu: row datetimetest, salt-de-línia.
}.
