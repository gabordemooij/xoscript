Server init.
Sortida escriu: ['Prova de data i hora a la base de dades'], salt-de-línia.

>> bd := Maria-DB nou amfitrió: ['localhost'],
	usuari: ['xo'], 
	contrasenya: ['pass123'],
	nom-base: ['xobase'],
	connecta.

>> paràmetres-de-cerca :=
bd consulta: ['SELECT CAST('2026-01-01 10:11:12' AS DATETIME) AS datetimetest'],
obtén: { :fila
	Sortida escriu: fila datetimetest, salt-de-línia.
}.
