# a value ending in the first part of an opening quote must survive serialization
>> valors := Llista nou
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

valors cada: { :i :value
	>> d := Diccionari nou.
	d posa: value a: ['k'].
	d posa: ['second'] a: ['j'].
	>> r := d codi objecte.
	Sortida escriu: r compta, salt-de-línia.
	Sortida escriu: ( (r a: ['k']) = value ), salt-de-línia.
}.
