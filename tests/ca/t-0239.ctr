Llista en: ['suma'] fes: {
	>> total := 0.
	jo cada: { :índex :element
		total suma: element.
	}. <- total.
}.

>> a := Cert.



a en: ['text'] fes: {
	>> contestació := Res.
	( jo = Cert ) cert: {
		contestació := ['Sip'].
	}, si-no: {
		contestació := ['Gens'].
	}. <- contestació.
}.

a en: ['número'] fes: {
	>> contestació := Res.
	( jo = Cert ) cert: {
		contestació := 10.
	}, si-no: {
		contestació := 20.
	}. <- contestació.
}.

>> b := 666.

b en: ['text'] fes: { <- ['Diable'].
}.

b en: ['booleà'] fes: { <- Fals.
}.


Sortida escriu: a, salt-de-línia.  
Sortida escriu: (90 + a), salt-de-línia. 
Sortida escriu: b, salt-de-línia. 
Sortida escriu: (Cert i: b), salt-de-línia.

a := Llista ← ['hello'] ; ['world'] ; Cert ; Res ; 666. 
a := a + ( Llista ← 1 ).
Sortida escriu: a, salt-de-línia.
Sortida escriu: ((Diccionari nou) posa: Res a: Res), salt-de-línia.
Sortida escriu: a suma, salt-de-línia. 


{
	a en: ['text'] fes: { <- Res. }.
	a := [''] + a.
} captura: { :errada
	Sortida escriu: ['Error anotat: '] + errada, salt-de-línia.
}, inicia.



{
	a en: ['número'] fes: { <- Res. }.
	a := 3 × a.
} captura: { :errada
	Sortida escriu: ['Error anotat: '] + errada, salt-de-línia.
}, inicia.


{
	a en: ['booleà'] fes: { <- Res. }.
	a := Cert i: a. 
} captura: { :errada
	Sortida escriu: ['Error anotat: '] + errada, salt-de-línia.
}, inicia.





