# flux correcte
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> camí := ['/tmp/dat.csv'].
>> csv := Fitxer nou: camí.
csv escriu: s.

# accepta CRLF LF CR, longitud de fila variable
csv delimitador: [';'] cometa: ['"'] línies: { :line
	Programa neteja.
	Sortida escriu: line, salt-de-línia.
	Programa neteja.
}.

# línies desiguals
s afegeix-al-final: ['\njustone'].
csv escriu: s.
{
	csv delimitador: [';'] cometa: ['"'] línies: { :line
		Sortida escriu: line, salt-de-línia.
	}.
} captura: { :e 
	Sortida escriu: e, salt-de-línia.
}, inicia.

# format no vàlid
s := ['"he"llo";world'].
csv escriu: s.
{
	csv delimitador: [';'] cometa: ['"'] línies: { :line
		Sortida escriu: line, salt-de-línia.
	}.
} captura: { :e 
	Sortida escriu: e, salt-de-línia.
}, inicia.
