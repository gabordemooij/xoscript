# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> camí := ['/tmp/dat.csv'].
>> csv := Fitxer nou: camí.
csv escriu: s.

# accepts CRLF LF CR, varying row length
csv delimitador: [';'] cometa: ['"'] línies: { :line
	Programa neteja.
	Sortida escriu: line, salt-de-línia.
	Programa neteja.
}.

# unequal lines
s afegeix-al-final: ['\njustone'].
csv escriu: s.
{
	csv delimitador: [';'] cometa: ['"'] línies: { :line
		Sortida escriu: line, salt-de-línia.
	}.
} captura: { :e 
	Sortida escriu: e, salt-de-línia.
}, inicia.

# invalid format
s := ['"he"llo";world'].
csv escriu: s.
{
	csv delimitador: [';'] cometa: ['"'] línies: { :line
		Sortida escriu: line, salt-de-línia.
	}.
} captura: { :e 
	Sortida escriu: e, salt-de-línia.
}, inicia.
