['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Sortida escriu: (x + y), salt-de-línia.

>> x := 10040.07.
>> y := 10305.60.

Sortida escriu: (x + y), salt-de-línia.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Sortida escriu: (x + y + z), salt-de-línia.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Sortida escriu: (x + y + z), salt-de-línia.

>> q := 0.1.2.

Sortida escriu: (q), salt-de-línia.

>> q := 012.

Sortida escriu: (q), salt-de-línia.
