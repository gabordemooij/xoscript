# les claus i signatures de Caixa-forta que es descodifiquen massa llargues no han de desbordar la pila
Server init.

>> claus := Caixa-forta genera-claus.
>> sk := claus primer.
>> pk := claus últim.
>> sig := Caixa-forta signa: ['abc'] amb: sk.

# 88 caràcters sense farciment es descodifiquen en 66 bytes
>> llarg := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 caràcters sense farciment es descodifiquen en 33 bytes
>> curt := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Caixa-forta signa: ['abc'] amb: llarg. } captura: { :e
	Sortida escriu: e, salt-de-línia.
}, inicia.

{ Caixa-forta comprova: ['abc'] signatura: llarg amb: pk. } captura: { :e
	Sortida escriu: e, salt-de-línia.
}, inicia.

{ Caixa-forta comprova: ['abc'] signatura: sig amb: curt. } captura: { :e
	Sortida escriu: e, salt-de-línia.
}, inicia.
