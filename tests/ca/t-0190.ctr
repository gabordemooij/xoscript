#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa gestió-memòria: 0.

{
Moment temps.
Moment espera: 1.
Sortida escriu: Programa arguments, salt-de-línia.
Programa argument: 0.
Número random.
Sortida escriu: (Programa sistema: ['echo 'Hello'']).
} inicia.

Programa neteja.
usedMemory1 := (Programa memòria ? 0).

{
Moment temps.
Moment espera: 1.
Sortida escriu: Programa arguments, salt-de-línia.
Programa argument: 0.
Número random.
Sortida escriu: (Programa sistema: ['echo 'Hello'']).
} inicia.

Programa neteja.
usedMemory2 := (Programa memòria ? 0).

{
Moment temps.
Moment espera: 1.
Sortida escriu: Programa arguments, salt-de-línia.
Programa argument: 0.
Número random.
Sortida escriu: (Programa sistema: ['echo 'Hello'']).
} inicia.

Programa neteja.
usedMemory3 := (Programa memòria ? 0).



( usedMemory1 = usedMemory2 i: usedMemory1 = usedMemory3, i: usedMemory2 = usedMemory3 ) cert: {
	Sortida escriu: ['No memory leaks here'].
}, fals: {
	Sortida escriu: ['Leaking memory...'].
}.
