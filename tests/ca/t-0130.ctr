# ús de FFI amb el connector Server

# connecta amb libc (depèn de la plataforma)
>> nomBiblio := Programa configuració: ['FFITESTLIB'].

# enllaça funcions stdio de C per a operacions avançades amb fitxers
Server enllaça: ( Llista nou ;
 nomBiblio ; ['fopen'] ;
 ( Llista nou ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
enllaça: ( Llista nou ;
 Res ; # vol dir la mateixa biblioteca
 ['fread'] ;
 ( Llista nou ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Res ; # vol dir el mateix objecte (és a dir, Flux)
 ['fread']
),
enllaça: (
 Llista nou ;
 Res ; # vol dir la mateixa biblioteca
 ['fwrite'] ;
 ( Llista nou ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Res ; # vol dir la mateixa biblioteca
 ['fwrite']
),
enllaça: (
 Llista nou ;
 Res ; # vol dir la mateixa biblioteca
 ['rewind'] ;
 ( Llista nou ; ['pointer'] ) ;
 ['int'] ;
 Res ; # vol dir la mateixa biblioteca
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> camí := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# obre un fitxer amb fopen(path, mode)
>> fd := Stream path: camí mode: mode.

# escriu bytes del búfer cadena al fitxer
>> bytes-escrits := Stream missatge: ['fwrite'] arguments: (Llista nou ; str ; 1 ; 6 ; fd ).
Sortida escriu: bytes-escrits, salt-de-línia.

# rebobina el punter del fitxer
Stream rewind: fd.

# reserva un búfer
>> buf := Blob nou: 20.

# llegeix del fitxer
>> bytes-llegits := Stream missatge: ['fread'] arguments: (Llista nou ; buf ; 1 ; 6 ; fd ).
Sortida escriu: bytes-llegits, salt-de-línia.
Sortida escriu: buf, salt-de-línia.

# allibera la memòria
str  allibera.
camí allibera.
mode allibera.
buf  allibera.


