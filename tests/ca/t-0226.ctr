# Prova de variants ASCII

# Números

Sortida escriu: (2 !=: 3), salt-de-línia.
Sortida escriu: (2 <=: 2), salt-de-línia.
Sortida escriu: (2 >=: 2), salt-de-línia.

# Textos

Sortida escriu: (['b'] >=: ['a']), salt-de-línia.
Sortida escriu: (['b'] !=: ['a']), salt-de-línia.
Sortida escriu: (['b'] <=: ['c']), salt-de-línia.

# Booleans

Sortida escriu: (Cert !=: Fals), salt-de-línia.

# Objectes

Sortida escriu: (Objecte nou !=: Objecte nou), salt-de-línia.

# símbol ASCII de llista <-:

Sortida escriu: (Llista <<: 1, ; 2 ; 3) compta = 3, salt-de-línia.

