>> items := Diccionari nou.
items posa: ['verd'] a: ['color-1'].
items posa: ['taronja'] a: ['color-2'].
items posa: ['vermell'] a: ['color-3'].
>> i := 0.
>> s := [''].
items cada: { :key :color
	Sortida escriu: ['color #'] + i + [' és: '] + color + [' '].
	i suma: 1.
}.
Sortida escriu: i + [' colors!'].
