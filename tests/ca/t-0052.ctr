>> items := Diccionari nou.
items posa: ['green'] a: ['color-1'].
items posa: ['orange'] a: ['color-2'].
items posa: ['red'] a: ['color-3'].
>> i := 0.
>> s := [''].
items cada: { :key :color
	Sortida escriu: ['color #'] + i + [' is: '] + color + [' '].
	i suma: 1.
}.
Sortida escriu: i + [' colors!'].
