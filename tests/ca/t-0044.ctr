>> list := Llista nou.
list ~ ['hello'].
Sortida escriu: list compta.
list afegeix-al-final: ['world'].
Sortida escriu: list compta.
Sortida escriu: list treu-últim, escriu: list compta.
list afegeix-al-final: ['there'].
Sortida escriu: list compta.
Sortida escriu: (list posició: 0), escriu: (list posició: 1).
list posa: ['nadal'] a: 1.
list posa: ['bon'] a: 0.
Sortida escriu: list compta.
Sortida escriu: (list posició: 0), escriu: (list posició: 1).
