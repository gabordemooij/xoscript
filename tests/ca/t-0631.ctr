#prova de ffi


Server init.

Programa gestió-memòria: 4.

# per a aquesta prova cal configurar un camí a libc (puts)
>> nomBiblio := Programa configuració: ['FFITESTLIB'].



Server enllaça: (
 Llista nou ;
 nomBiblio ;
 ['puts'] ;
 ( Llista nou ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s allibera.

# prova amb struct

>> a := Blob nou: 8.
a bytes: (
	Llista <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> estructura := Blob struct: (Llista <<: ['int'], ; ['int']).

Server enllaça: (
	Llista <<: ['@structtest'], ;
	['@structtest'] ;
	(Llista <<: estructura) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Sortida escriu: ['Prova de suma:'] + (ffitest ffisum: a), salt-de-línia.

estructura allibera-struct.
estructura allibera.
a allibera.
