#ffi test


Server init.

Programa gestió-memòria: 4.

# for this test you need set a path to libc (puts)
>> libname := Programa configuració: ['FFITESTLIB'].



Server enllaça: (
 Llista nou ;
 libname ;
 ['puts'] ;
 ( Llista nou ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s allibera.

# test with struct

>> a := Blob nou: 8.
a bytes: (
	Llista <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> struct := Blob struct: (Llista <<: ['int'], ; ['int']).

Server enllaça: (
	Llista <<: ['@structtest'], ;
	['@structtest'] ;
	(Llista <<: struct) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Sortida escriu: ['Sum test:'] + (ffitest ffisum: a), salt-de-línia.

struct allibera-struct.
struct allibera.
a allibera.
