

Llista en: ['column:'] fes: { :columna
	>> resultat := Llista nou.
	jo cada: { :índex :fila
		fila cada: { :índex :casella
			(índex = columna) cert: { resultat afegeix-al-final: casella. }.
		}.
	}. <- resultat.
}.


>> a := Llista ←
	(Llista ← 1 ; 2 ; 3) ;
	(Llista ← 4 ; 5 ; 6) ;
	(Llista ← 7 ; 8 ; 9).

>> b := a column: 1.
Sortida escriu: b, salt-de-línia.

b := a column: 20.
Sortida escriu: b, salt-de-línia.

b := a column: -100.
Sortida escriu: b, salt-de-línia.
