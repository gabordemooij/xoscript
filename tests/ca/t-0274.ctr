

Llista en: ['column:'] fes: { :column
	>> result := Llista nou.
	jo cada: { :index :row
		row cada: { :index :cell
			(index = column) cert: { result afegeix-al-final: cell. }.
		}.
	}. <- result.
}.


>> a := Llista ←
	(Llista ← 1 ; 2 ; 3) ;
	(Llista ← 4 ; 5 ; 6) ;
	(Llista ← 7 ; 8 ; 9).

>> b := a column: 1.
Sortida escriu: b, salt-de-línia.

b := a column: 20.
Sortida escriu: b, salt-de-línia.

b := a column: -100.
Sortida escriu: b, salt-de-línia.
