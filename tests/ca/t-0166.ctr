

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa gestió-memòria: 0.

{
>> q := ['You should be able'].
q afegeix-al-final: ([' to append something to a string']+['!']).
Sortida escriu: q.
} inicia.

Programa neteja.
usedMemory1 := (Programa memòria ? 0).


{
>> q := ['You should be able'].
q afegeix-al-final: ([' to append something to a string']+['!']).
Sortida escriu: q.
} inicia.

Programa neteja.
