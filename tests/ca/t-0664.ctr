# recursive interpolation not allowed

Sortida escriu: 
['recursive string interolation enabled: '] + (
	Programa funcionalitat: 
	['RECURSIVE_STRINTPOL']
), salt-de-línia.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Sortida escriu: a, salt-de-línia.


