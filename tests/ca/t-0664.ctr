# no es permet la interpolació recursiva

Sortida escriu: 
['interpolació recursiva de text activada: '] + (
	Programa funcionalitat: 
	['RECURSIVE_STRINTPOL']
), salt-de-línia.


>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Sortida escriu: a, salt-de-línia.


Programa funcionalitat: ['RECURSIVE_STRINTPOL'] activa: Cert.

Sortida escriu: 
['interpolació recursiva de textos activada: '] + (
	Programa funcionalitat: 
	['RECURSIVE_STRINTPOL']
), salt-de-línia.

>> a := ['hello world'].
a := a world: ['yellow'].
a := a ll: ['xxx'].

Sortida escriu: a, salt-de-línia.

Programa funcionalitat: ['RECURSIVE_STRINTPOL'] activa: Fals.

