


>> vi := Objecte nou.


vi en: ['aText'] fes: { <- ['merlot'].
}.

vi en: ['naarTekst'] fes: { <- ['merlot'].
}.


vi en: ['='] fes: { :other wine <- ( jo aText = other wine ).
}.

vi en: ['=='] fes: { :other wine <- ( jo aText = other wine ).
}.



vi
	cas: ['cabernet'] fes: { Sortida escriu: ['és un Cabernet!']. },
	cas: ['syrah']    fes: { Sortida escriu: ['és un Syrah!'].    },
	cas: ['merlot']   fes: { Sortida escriu: ['és un Merlot!'].   },
	cas: ['malbec']   fes: { Sortida escriu: ['és un Malbec!'].   }.

