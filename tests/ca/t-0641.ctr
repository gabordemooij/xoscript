# Test utf8 sanitizer
Server init.

>> utf8cases := Diccionari nou
	# ASCII only
	posa: ( Llista nou ; 65 ; 65 ; 65 ; 65 ; 0 ) a: ['AAAA'],
	# valid 2 byte sequence
	posa: ( Llista nou ; 194 ; 162 ; 0 ) a: ['¢'],
	# Valid 3-byte UTF-8
    posa: ( Llista nou ; 226 ; 130 ; 172 ; 0 ) a: ['€'],
	# Valid 4-byte UTF-8
    posa: ( Llista nou ; 240 ; 144 ; 141 ; 136 ; 0 ) a: ['𐍈'],
	# Invalid continuation byte in sequence E2 28 AC -> start 3b seq + 28 wrng cnt + AC cnt byte, but belongs to same error
    posa: ( Llista nou ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) a: ['A?A'],
	# Overlong encoding of ASCII 'A' (should become ?),
    posa: ( Llista nou ; 65 ; 193 ; 129 ; 0 ) a: ['A?'],
	# Invalid first byte (0xFF)
    posa: ( Llista nou ; 255 ; 0 ) a: ['?'],
	# Incomplete multi-byte sequence at end
    posa: ( Llista nou ; 66 ; 226 ; 0 ) a: ['B?'],
    # Empty string
    #put: ( List new ) at: [''],
	# Multiple mixed sequences
    posa: ( Llista nou ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) a: ['A€?𐍈B'].
	 
utf8cases cada: { :key :value
	>> blob := Blob nou: value compta, bytes: value.
	>> str := blob text.
	(str = key) cert: {
		Sortida escriu: ['OK'], salt-de-línia.
	}, si-no: {
		Sortida escriu: ['UTF8 sanitizer failed on: '] + key + [' got: '] + str, salt-de-línia.
	}.
	blob allibera.
}.
