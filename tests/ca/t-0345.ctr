# prova de mètodes de captura general
>> x13 := Objecte nou.
x13 en: ['a'] fes: { :a Sortida escriu: 0, salt-de-línia. }.
x13 en: ['a:'] fes: { :a Sortida escriu: a, salt-de-línia. <- 5. }.
x13 en: ['a:b:'] fes: { :a :b Sortida escriu: (a + b), salt-de-línia. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
