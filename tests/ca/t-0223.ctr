>> x := Moment nou.
x zona: ['CEST'],
any:2017,
mes:01,
dia:10,
hora: 10,
minut: 0,
segon: 0.

Sortida escriu: x, salt-de-línia.

Sortida escriu: x temps, salt-de-línia.

x suma: 1 segon.
x suma: 2 minut.
x suma: 3 hora.
x suma: 4 dia.
x suma: 1 mes.
x suma: 6 any.

Sortida escriu: x, salt-de-línia.

x resta: 1 segon.
x resta: 2 minut.
x resta: 3 hora.
x resta: 4 dia.
x resta: 1 mes.
x resta: 6 any.

Sortida escriu: x, salt-de-línia.

>> y := x copia.
>> z := x.

Sortida escriu: y, salt-de-línia.
Sortida escriu: z, salt-de-línia.
Sortida escriu: (x zona = y zona), salt-de-línia.
Sortida escriu: (x temps = y temps), salt-de-línia.
Sortida escriu: (x = z), salt-de-línia.
Sortida escriu: x dia-de-any, salt-de-línia.
Sortida escriu: x dia-de-la-setmana, salt-de-línia.
Sortida escriu: x setmana, salt-de-línia.
