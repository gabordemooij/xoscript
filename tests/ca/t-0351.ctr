
>> memòriaUsada1 := 0.
>> memòriaUsada2 := 0.
>> memòriaUsada3 := 0.
>> memòriaUsada4 := 0.

>> codi := {
	>> o := (
		Diccionari nou
		aa: (Llista ← 1 ; 2),
		bb: (Llista ← 3 ; 4)
	).
	>> s := o text.
	>> o2 := s objecte.
	(s  tipus = Text tipus) cert: { Sortida escriu: ['OK1'], salt-de-línia. }.
	(o2 tipus = Diccionari tipus) cert: { Sortida escriu: ['OK2'], salt-de-línia. }.
}.

Programa gestió-memòria: 0.
['La memòria 1 serà diferent perquè els blocs es registren en bloc.'].
Programa neteja.
memòriaUsada1 := (Programa memòria ? 1).
codi inicia.
Programa neteja.
memòriaUsada2 := (Programa memòria ? 1).
codi inicia.
Programa neteja.
memòriaUsada3 := (Programa memòria ? 1).
codi inicia.
Programa neteja.
memòriaUsada4 := (Programa memòria ? 1).

(memòriaUsada2 = memòriaUsada3 = memòriaUsada4) cert: { Sortida escriu: ['OK3'], salt-de-línia. }.
 
