Sortida escriu: ['Test object'], salt-de-línia.
>> a := Objecte nou. 

a en: ['item:'] fes: { :binhelper
	propi binhelper := binhelper. 
}.

a en: ['item'] fes: { <- propi binhelper.
}.

a item: Bin nou.

>> old-binhelper-address := a item prototip adreça-de-memòria.
a save-as: ['/tmp/a.bin'].
Sortida escriu: ['========== RELOADING SNAP:'], salt-de-línia.

>> b := Objecte load-from: ['/tmp/a.bin'].

(b item prototip adreça-de-memòria = old-binhelper-address) cert: {
	Sortida escriu: ['Object link re-attached.'], salt-de-línia.
}.


