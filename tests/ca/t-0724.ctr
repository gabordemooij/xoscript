Sortida escriu: ['Test object'], salt-de-línia.
>> a := Objecte nou. 

a en: ['item:'] fes: { :file
	propi file := file. 
}.

a en: ['item'] fes: { <- propi file.
}.

>> f := Fitxer nou: ['/tmp/aaa.txt'].
a item: f.
Sortida escriu: a item, salt-de-línia.
a save-as: ['/tmp/a.bin'].
Sortida escriu: ['========== RELOADING SNAP:'], salt-de-línia.
>> b := Objecte load-from: ['/tmp/a.bin'].
Sortida escriu: b item, salt-de-línia.
