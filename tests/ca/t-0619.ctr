>> HTML := Objecte nou.
HTML en: ['respon:'] fes: { :etiqueta 
	Sortida escriu: (['<tag>'] tag: etiqueta), salt-de-línia.
}.
HTML en: ['respon:i:'] fes: { :etiqueta :html 
	Sortida escriu: (
		['<tag>innerHTML</tag>']
		tag: etiqueta - [':'],
		innerHTML: html
	), salt-de-línia.
}.
>> html := HTML nou.
html body h1: ['header'].

