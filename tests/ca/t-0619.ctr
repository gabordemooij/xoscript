>> HTML := Objecte nou.
HTML en: ['respon:'] fes: { :tag 
	Sortida escriu: (['<tag>'] tag: tag), salt-de-línia.
}.
HTML en: ['respon:i:'] fes: { :tag :html 
	Sortida escriu: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), salt-de-línia.
}.
>> html := HTML nou.
html body h1: ['header'].

