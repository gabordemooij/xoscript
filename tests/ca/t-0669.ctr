# Resum de contrasenyes
Server init.

# L'usuari estableix una contrasenya
>> contr := ['pass123'].

# La deseu així
>> empremta := Caixa-forta 
	resum-contrasenya: contr.

# Després, l'usuari inicia sessió
# Intent 1
>> a1 := ['abcd123'].
# Intent 2
>> a2 := ['pass123'].

# Verifica
>> a := Caixa-forta 
	resum-contrasenya: empremta verifica: a1.
	# falla 
>> b := Caixa-forta
	resum-contrasenya: empremta verifica: a2.
	# correcte!

Sortida escriu: a, salt-de-línia.
Sortida escriu: b, salt-de-línia.

