# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Caixa-forta 
	resum-contrasenya: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Caixa-forta 
	resum-contrasenya: hash verifica: a1.
	# fail 
>> b := Caixa-forta
	resum-contrasenya: hash verifica: a2.
	# ok!

Sortida escriu: a, salt-de-línia.
Sortida escriu: b, salt-de-línia.

