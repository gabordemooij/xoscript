# els casos límit d'una petició han de donar un error o un resultat, no un bloqueig
Server init.

Sortida escriu: ['<'] + (['abc'] de: 0 longitud: 0, majúscules) + ['>'], salt-de-línia.
Sortida escriu: ['<'] + (['abc'] de: 0 longitud: 0, minúscules) + ['>'], salt-de-línia.
Sortida escriu: ['<'] + (['abc'] desplaçament: 3, majúscules) + ['>'], salt-de-línia.
Sortida escriu: [''] majúscules bytes, salt-de-línia.
Sortida escriu: ['aB'] majúscules, salt-de-línia.
Sortida escriu: ['aB'] minúscules, salt-de-línia.

Sortida escriu: (Moment nou: 0) any, salt-de-línia.
{ Moment nou: ['9e300'] número. } captura: { :e Sortida escriu: e, salt-de-línia. }, inicia.
{ Moment nou: ['-9e300'] número. } captura: { :e Sortida escriu: e, salt-de-línia. }, inicia.
{ Moment nou: ['nan'] número. } captura: { :e Sortida escriu: e, salt-de-línia. }, inicia.
{ Moment nou: 9000000000000000000. } captura: { :e Sortida escriu: e, salt-de-línia. }, inicia.
