
Text en: ['html'] fes: { <- (
		jo
		substitueix: ['&'] per: ['&amp;'],
		substitueix: ['<'] per: ['&lt;'],
		substitueix: ['>'] per: ['&gt;'],
		substitueix: ['"'] per: ['&quot;']
	).
}.

>> PinzellHtml := Objecte nou.

PinzellHtml en: ['respon:'] fes: { :etiqueta
	Sortida escriu: (['<tag>↵'] tag: etiqueta ).
}.

PinzellHtml en: ['respon:i:'] fes: { :etiqueta :content
	etiqueta := ( etiqueta de: 0 longitud: (etiqueta longitud - 1) ).
	Sortida escriu: (['<tag content>↵'] tag: etiqueta, content: content).
}.

PinzellHtml en: ['content:'] fes: { :elText
	Sortida escriu: elText html, salt-de-línia.
}.

PinzellHtml en: ['atr:valor:'] fes: { :atr :value <- ['attr="value"'] attr: atr, value: value.
}.

>> h := PinzellHtml nou.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h atr: ['class'] valor: ['bold']),
		/span
	/body
/html.
		
