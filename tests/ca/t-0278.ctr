>> To-Do := Objecte nou.

To-Do en: ['nou'] fes: {
	propi list := Llista nou.
}.

To-Do en: ['nieuw'] fes: {
	propi list := Llista nou.
}.

To-Do en: ['+'] fes: { :task
	propi list afegeix-al-final: task.
}.

To-Do en: ['number of tasks?'] fes: { <-  propi list compta.
}.

>> todos := 
	To-Do nou 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Sortida escriu: ['You have $ tasks to do'] $ todos number of tasks?.
