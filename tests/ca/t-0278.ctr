>> Tasques-Pendents := Objecte nou.

Tasques-Pendents en: ['nou'] fes: {
	propi list := Llista nou.
}.

Tasques-Pendents en: ['nieuw'] fes: {
	propi list := Llista nou.
}.

Tasques-Pendents en: ['+'] fes: { :tasca
	propi list afegeix-al-final: tasca.
}.

Tasques-Pendents en: ['number of tasks?'] fes: { <-  propi list compta.
}.

>> pendents := 
	Tasques-Pendents nou 
	+ ['fer el sopar'] 
	+ ['endreçar l'habitació'].
	
Sortida escriu: ['You have $ tasks to do'] $ pendents number of tasks?.
