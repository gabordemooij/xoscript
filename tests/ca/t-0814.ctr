# format de galeta de sessió, tipus de contingut json, només protocols web, svg mostrat en línia
Server inicialitzar.
Programa utilitza: ['../../../src/xo/ca/webtools.xo'].

>> Petició-Falsa := Objecte nou.
Petició-Falsa en: ['value:'] fes: { :valor
	propi valor := valor.
}.
Petició-Falsa en: ['cookie:'] fes: { :nom
	<- propi valor.
}.

>> Sessió-De-Prova := Sessió-fitxer-temporal nou.
Sessió-De-Prova en: ['carregar'] fes: {
	<- Diccionari nou.
}.
Sessió-De-Prova en: ['id-de-sessió'] fes: {
	<- propi id.
}.

>> galetes := Llista nou
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

galetes cada: { :i :galeta
	>> petició := Petició-Falsa nou.
	petició value: galeta.
	>> gestor := Sessió-De-Prova nou.
	>> web := Document-Web nou.
	web petició: petició.
	web gestor-sessió: gestor.
	web iniciar-sessió.
	Sortida escriu: ( gestor id-de-sessió = galeta ), salt-de-línia.
}.

>> web := Document-Web nou.
web json: (Diccionari nou posa: ['b'] a: ['a']).
Sortida escriu: ['\n'], salt-de-línia.

{ Xarxa get: ['file:///etc/hostname']. } captura: { :e
	Sortida escriu: e, salt-de-línia.
}, inicia.

>> svg := Fitxer nou: ['/tmp/test0814.svg'].
svg escriu: ['<svg xmlns="x"></svg>'].
Sortida salt-de-línia.
Server transmet: ['test0814.svg'] prefix: ['/tmp/'].
svg suprimeix.
