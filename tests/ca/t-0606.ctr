>> Punt := Objecte nou.
Punt en: ['x-coordinate:'] fes: { :x propi x := x. }.
Punt en: ['y-coordinate:'] fes: { :y propi y := y. }.
Punt en: ['coordenada-x']  fes: { <- propi x copia. }.
Punt en: ['coordenada-y']  fes: { <- propi y copia. }.

Punt en: ['='] fes: { :altre
	<- ( propi x = altre coordenada-x
		 i: propi y = altre coordenada-y ).
}.

>> moll := Punt nou x-coordinate: 5, y-coordinate: 6.
>> ajuntament := Punt nou x-coordinate: 7, y-coordinate: 1.
>> restaurant := Punt nou x-coordinate: 5, y-coordinate: 6.

Sortida escriu: moll = ajuntament, salt-de-línia.
Sortida escriu: moll = restaurant, salt-de-línia.
