>> Point := Objecte nou.
Point en: ['x-coordinate:'] fes: { :x propi x := x. }.
Point en: ['y-coordinate:'] fes: { :y propi y := y. }.
Point en: ['x-coordinate']  fes: { <- propi x copia. }.
Point en: ['y-coordinate']  fes: { <- propi y copia. }.

Point en: ['='] fes: { :other <- ( propi x = other x-coordinate
		 i: propi y = other y-coordinate ).
}.

>> pier := Point nou x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point nou x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point nou x-coordinate: 5, y-coordinate: 6.

Sortida escriu: pier = town-hall, salt-de-línia.
Sortida escriu: pier = restaurant, salt-de-línia.
