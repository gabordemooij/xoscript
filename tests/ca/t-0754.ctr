Sortida escriu: ['Objecte de prova'], salt-de-línia.
>> a := Objecte nou. 

a en: ['item:'] fes: { :eixida
	propi eixida := eixida. 
}.

a en: ['article'] fes: {
	<- propi eixida.
}.

a en: ['saluda'] fes: {
	Sortida escriu: ['hola des de la sortida original!'], salt-de-línia.
}.

a item: Sortida.

Sortida escriu: a article, salt-de-línia.

>> adreça-antiga-eixida := a article prototip adreça-de-memòria.
a save-as: ['/tmp/a.bin'].
Sortida escriu: ['========== RECARREGANT INSTANTÀNIA:'], salt-de-línia.

>> b := Objecte load-from: ['/tmp/a.bin'].

(b article prototip adreça-de-memòria = adreça-antiga-eixida) cert: {
	Sortida escriu: ['Enllaç d'objecte reconnectat.'], salt-de-línia.
}.

b article escriu: ['hola des de la sortida carregada!'], salt-de-línia.
b saluda.
