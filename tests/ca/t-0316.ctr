>> Grandfather := Objecte nou.
Grandfather en: ['greet'] fes: {
	Sortida escriu: ['Ave!'], salt-de-línia.
}.
>> Father := Grandfather nou.
Father en: ['greet'] fes: {
	Sortida escriu: ['Hello'], salt-de-línia.
	jo greet.
}.
>> Son := Father nou.
Son en: ['greet'] fes: {
	Sortida escriu: ['Hi'], salt-de-línia.
	jo greet.
}.

Son greet.

>> Roundabout := Objecte nou.
Roundabout en: ['circle:'] fes: { :x
	Sortida escriu: x, salt-de-línia.
	(x < 3) cert: { jo recursiu circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) cert: { Sortida escriu: x, salt-de-línia. x suma: 1.  increment inicia. }. }.
increment inicia.