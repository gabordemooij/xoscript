>> Avi := Objecte nou.
Avi en: ['saluda'] fes: {
	Sortida escriu: ['Ave!'], salt-de-línia.
}.
>> Pare := Avi nou.
Pare en: ['saluda'] fes: {
	Sortida escriu: ['Hello'], salt-de-línia.
	jo saluda.
}.
>> Fill := Pare nou.
Fill en: ['saluda'] fes: {
	Sortida escriu: ['Ei'], salt-de-línia.
	jo saluda.
}.

Fill saluda.

>> Rotonda := Objecte nou.
Rotonda en: ['circle:'] fes: { :x
	Sortida escriu: x, salt-de-línia.
	(x < 3) cert: { jo recursiu circle: x + 1. }.
}.

Rotonda circle: 1.

>> x := 1.
>> incrementa := { (x ≤ 3) cert: { Sortida escriu: x, salt-de-línia. x suma: 1.  incrementa inicia. }. }.
incrementa inicia.