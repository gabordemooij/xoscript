



>> PòsitDeCafè := Objecte nou.
PòsitDeCafè en: ['extreu'] fes: { <- ['coffee']. }.

>> MàquinaDeCafè := Objecte nou.
MàquinaDeCafè en: ['init'] fes: {
	propi pòsitdecafè := PòsitDeCafè nou.
}.
MàquinaDeCafè en: ['nou'] fes: { <- MàquinaDeCafè `new init.
}.

MàquinaDeCafè en: ['fesTe'] fes: { <- (propi fullesdete extreu). }.
MàquinaDeCafè en: ['fesCafè'] fes: { <- (propi pòsitdecafè extreu). }.

>> somniDeCafè := MàquinaDeCafè nou.

Sortida escriu:
	somniDeCafè 
	fesCafè.

Sortida escriu:
	somniDeCafè 
	fesTe.
