



>> CoffeeGrounds := Objecte nou.
CoffeeGrounds en: ['extract'] fes: { <- ['coffee']. }.

>> CoffeeMachine := Objecte nou.
CoffeeMachine en: ['init'] fes: {
	propi coffeegrounds := CoffeeGrounds nou.
}.
CoffeeMachine en: ['nou'] fes: { <- CoffeeMachine `new init.
}.

CoffeeMachine en: ['makeTea'] fes: { <- (propi tealeaves extract). }.
CoffeeMachine en: ['makeCoffee'] fes: { <- (propi coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine nou.

Sortida escriu:
	coffeeDream 
	makeCoffee.

Sortida escriu:
	coffeeDream 
	makeTea.
