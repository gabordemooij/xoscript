
>> dictionary := (
	Diccionari nou
		posa: ['b'] a: ['a'],
		posa: ['a'] a: ['b'],
		posa: ['z'] a: ['x'],
		posa: ['hello'] a: ['hallo'],
		posa: ['human'] a: ['human']
).

>> comparisons := Llista nou.
dictionary cada: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a compara: b)
	).
}.

comparisons ordena: { :a :b <- ( a compara: b ). }.
Sortida escriu: ( comparisons uneix: ['↵'] ), salt-de-línia.
comparisons uneix: ['↵'].
