
>> vocabulari := (
	Diccionari nou
		posa: ['b'] a: ['a'],
		posa: ['a'] a: ['b'],
		posa: ['z'] a: ['x'],
		posa: ['hello'] a: ['hallo'],
		posa: ['humà'] a: ['humà']
).

>> comparacions := Llista nou.
vocabulari cada: { :a :b
	comparacions ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a compara: b)
	).
}.

comparacions ordena: { :a :b <- ( a compara: b ). }.
Sortida escriu: ( comparacions uneix: ['↵'] ), salt-de-línia.
comparacions uneix: ['↵'].
