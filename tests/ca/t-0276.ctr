>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objecte nou.
⚄ en: ['treuDe:longitud:'] fes: { :reserva :compta
	
	>> resultat := [''].
	
	{
		>> índex := Número aleatori % (reserva longitud).
		resultat afegeix-al-final: ( reserva caràcter: (índex + 1) ).
		
	} × compta. <- resultat.
}.

>> aleatori := ⚄ treuDe: ?? longitud: ?? longitud.
Sortida escriu: (['x↵'] x aleatori longitud).
Sortida escriu: (['y↵'] y ?? longitud).

