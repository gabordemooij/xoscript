>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Objecte nou.
⚄ en: ['drawFrom:length:'] fes: { :pool :compta
	
	>> result := [''].
	
	{
		>> index := Número random % (pool longitud).
		result afegeix-al-final: ( pool caràcter: (index + 1) ).
		
	} × compta. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? longitud.
Sortida escriu: (['x↵'] x random longitud).
Sortida escriu: (['y↵'] y ?? longitud).

