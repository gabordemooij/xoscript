>> a := Llista ← Objecte ; Cert ; Fals ; Booleà ; 1 ; Número ; ['Str'] ; Text ; { ['Empty']. }.
Sortida escriu: (a compta), salt-de-línia.
{ :i
	Sortida escriu: 
	['a '] + 
	((a ? i) tipus) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Res?) o-bé: [''] o: ['NOT']) + 
	[' Nil.'],
	salt-de-línia.
} × (a compta).
Sortida escriu: ['but.. Nil is.. '] + ((Res Res?) o-bé: ['certainly NIL!'] o: ['not NIL??']), salt-de-línia.