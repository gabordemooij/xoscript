>> a := Llista ← Objecte ; Cert ; Fals ; Booleà ; 1 ; Número ; ['Txt'] ; Text ; { ['Buit']. }.
Sortida escriu: (a compta), salt-de-línia.
{ :i
	Sortida escriu: 
	['a '] + 
	((a ? i) tipus) +
	([' \‘this\’ '] this: (a ? i))  +
	[' és '] +
	(((a ? i) Res?) o-bé: [''] o: ['NO PAS']) + 
	[' Res.'],
	salt-de-línia.
} × (a compta).
Sortida escriu: ['però.. Res és.. '] + ((Res Res?) o-bé: ['segur que RES!'] o: ['no RES??']), salt-de-línia.