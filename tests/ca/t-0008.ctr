>> Greeter := Objecte nou.
Greeter en: ['make'] fes: {
	>> greeter := Objecte nou.
	greeter en: ['name:'] fes: { :nom
		Sortida escriu: ['setting a name'].
		propi myName := nom.
	}.
	greeter en: ['greet'] fes: {
		Sortida escriu: ['Hello'].
		Sortida escriu: propi myName.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
