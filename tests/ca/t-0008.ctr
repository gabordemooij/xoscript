>> Salutador := Objecte nou.
Salutador en: ['fabrica'] fes: {
	>> salutador := Objecte nou.
	salutador en: ['name:'] fes: { :nom
		Sortida escriu: ['posant un nom'].
		propi elMeuNom := nom.
	}.
	salutador en: ['saluda'] fes: {
		Sortida escriu: ['Hello'].
		Sortida escriu: propi elMeuNom.
	}. <- salutador.
}.
>> salutador := Salutador fabrica.
salutador name: ['raig de sol!'].
salutador saluda.
