

>> memòriaUsada1 := 0.
>> memòriaUsada2 := 0.
>> memòriaUsada3 := 0.
>> memòriaUsada4 := 0.

Programa gestió-memòria: 0.

>> txt := ['Word Salad'].
Sortida escriu: ['últim índex de ord = '] + (( txt últim: ['ord'] ) - 0), salt-de-línia.
Sortida escriu: ['índex de ord = '] + (( txt troba: ['ord'] ) - 0), salt-de-línia.
Sortida escriu: ['índex de ad = '] + (( txt troba: ['ad'] ) - 0), salt-de-línia.
Sortida escriu: ['últim índex de W = '] + (( txt últim: ['W'] ) - 0), salt-de-línia.
Sortida escriu: ['últim índex de d = '] + (( txt últim: ['d'] ) - 0), salt-de-línia.
Sortida escriu: ['txt és igual a Amanida Paraula = '] + ( txt = ['Word Salad'] ), salt-de-línia.
Sortida escriu: ['txt és igual a Amanida Cèsar = '] + ( txt = ['Amanida Cèsar'] ), salt-de-línia.
Sortida escriu: ['txt no és igual a Amanida Paraula = '] + ( txt ≠ ['Word Salad'] ), salt-de-línia.
Sortida escriu: ['txt no és igual a Amanida Cèsar = '] + ( txt ≠ ['Amanida Cèsar'] ), salt-de-línia.

Programa neteja.

memòriaUsada1 := (Programa memòria ? 0).


txt := ['Word Salad'].
Sortida escriu: ['últim índex de ord = '] + (( txt últim: ['ord'] ) - 0), salt-de-línia.
