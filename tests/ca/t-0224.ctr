
>> països := Llista nou
	~ ['Suïssa']
	~ ['Itàlia']
	~ ['Alemanya'].

>> aliments := Llista nou
	~ ['Rösti']
	~ ['Espaguetis']
	~ ['Xucrut'].


>> comptador := 0.
aliments segons: països, cada: { :key :value
	comptador suma: 1.
}.

Sortida escriu: (['we serve counter dishes'] counter: comptador), salt-de-línia.

>> comptador := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] caràcters ordena: { :v
	comptador suma: 0.
}.

Sortida escriu: (['we sort counter dishes'] counter: comptador), salt-de-línia.


>> comptador := 0.
{
	{
		comptador suma: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Sortida escriu: (['we calculate counter numbers.'] counter: comptador), salt-de-línia.

