
>> countries := Llista nou
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Llista nou
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods segons: countries, cada: { :key :value
	counter suma: 1.
}.

Sortida escriu: (['we serve counter dishes'] counter: counter), salt-de-línia.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] caràcters ordena: { :v
	counter suma: 0.
}.

Sortida escriu: (['we sort counter dishes'] counter: counter), salt-de-línia.


>> counter := 0.
{
	{
		counter suma: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Sortida escriu: (['we calculate counter numbers.'] counter: counter), salt-de-línia.

