Server init.
>> fmt := Format nou: ['%#3x'].

>> blob := Blob nou: 4.
blob bytes: ( 
	Llista nou ; 0 ; 1 ; 2 ; 3
).

>> file := Fitxer nou: ['/tmp/blob'].
file blob: blob.
blob allibera.

>> llegeix := file blob.
llegeix 
de: 0 
longitud: 4, 
fes cada: { :i :b 
	Sortida
	escriu: (fmt aplica-enter: b),
	salt-de-línia.
}.
llegeix allibera.
