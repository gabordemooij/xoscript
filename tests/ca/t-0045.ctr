Programa gestió-memòria: 4.

>> ups := 0.
{
	{ 3 ÷ 0. } captura: {
		ups suma: 1.
	}, inicia.
} × 1000.

{
	Sortida escriu: ['ei, tothom!'].
	aquesta-tasca error: ['oops'].
	Sortida escriu: ['ei, tothom!'].
	{ Sortida escriu: ['no imprimeixis això']. } inicia.
} captura: { :e 
	Sortida escriu: ['t'he enxampat!']. 
	Sortida escriu: e.
}, inicia.
