>> Animal := Objecte nou.
>> Factory := Objecte nou.

Animal en: ['nou'] fes: {
	>> animal := jo nou.
	animal sound: ['?']. <- animal.
}.

Animal en: ['sound:'] fes: { :s
	propi sound := s.
}.

Animal en: ['sound'] fes: { <- propi sound.
}.

>> Dog := Objecte nou.
>> Cat := Objecte nou.

Dog en: ['nou'] fes: { <- Animal nou sound: ['woof!'].
}.

Cat en: ['nou'] fes: { <- Animal nou sound: ['meow!'].
}.

Sortida escriu: Dog nou sound, salt-de-línia.
Sortida escriu: Cat nou sound, salt-de-línia.

Factory en: ['mix:and:'] fes: { :beast1 :beast2 <- Animal nou sound: (
		( beast1 sound de: 0 longitud: 2 ) +
		( beast2 sound de: 2 longitud: 5 )
	).
}.

Sortida escriu: (Factory mix: Dog nou and: Cat nou) sound, salt-de-línia.
