60 × {
	>> x := (Número aleatori % 6) + 1.
	(x ≤ 6) fals: { Sortida escriu: ['FALLA']. }.
	(x ≥0) fals: { Sortida escriu: ['FALLA']. }.
	x := (Número aleatori % 3) + 1.
	(x < 3) fals: { Sortida escriu: ['FALLA']. }.
	(x>-1) fals: { Sortida escriu: ['FALLA']. }.
	x := ((Booleà gira) número).
	(x = 0 o: x = 1) fals: { Sortida escriu: ['FALLA']. }.
	x := ((Cert gira) número).
	(x = 0 o: x = 1) fals: { Sortida escriu: ['FALLA']. }.
	x := (Booleà gira o-bé: ['CARA'] o: ['CREU']).
	((x = ['CARA']) o: (x = ['CREU'])) fals: { Sortida escriu: ['FALLA']. }.
}.
Sortida escriu: ['FET'].

