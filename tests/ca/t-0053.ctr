60 × {
	>> x := (Número random % 6) + 1.
	(x ≤ 6) fals: { Sortida escriu: ['FAIL']. }.
	(x ≥0) fals: { Sortida escriu: ['FAIL']. }.
	x := (Número random % 3) + 1.
	(x < 3) fals: { Sortida escriu: ['FAIL']. }.
	(x>-1) fals: { Sortida escriu: ['FAIL']. }.
	x := ((Booleà flip) número).
	(x = 0 o: x = 1) fals: { Sortida escriu: ['FAIL']. }.
	x := ((Cert flip) número).
	(x = 0 o: x = 1) fals: { Sortida escriu: ['FAIL']. }.
	x := (Booleà flip o-bé: ['HEAD'] o: ['TAIL']).
	((x = ['HEAD']) o: (x = ['TAIL'])) fals: { Sortida escriu: ['FAIL']. }.
}.
Sortida escriu: ['DONE'].

