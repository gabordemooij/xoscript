Text en: ['avalua'] fes: {
	>> codi := Fitxer nou: ['/tmp/eval.ctr'].
	codi escriu: (jo text + ['.']).
	Programa utilitza: ['/tmp/eval.ctr'].
}.

>> a := Llista ← 1 ; 2 ; 3.
>> b := (a text).

Sortida escriu: b, salt-de-línia. 
(['b := '] + b) avalua.

Sortida escriu: b ? 2, salt-de-línia. 

Sortida escriu: (( Llista ← 1 ; 2 ; 3 )), salt-de-línia. 

Sortida escriu: ((Diccionari nou) posa: 1 a: 2), salt-de-línia. 

>> x := ( (Llista ← 1 ; ( Llista ← 9 ) ; Cert ) ) text.
Sortida escriu: x, salt-de-línia. 
(['x := '] + x) avalua.

Sortida escriu: x ? 1 ? 0, salt-de-línia. 

>> y := (Diccionari nou) posa: (Llista ← 1) a: (Llista ← 2).
Sortida escriu: y, salt-de-línia. 

(['y := '] + y) text avalua.

Sortida escriu: (y a: (Llista ← 2) text ), salt-de-línia.

Sortida escriu: (Llista nou), salt-de-línia. 
Sortida escriu: (Diccionari nou), salt-de-línia. 
