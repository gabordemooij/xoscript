>> Slurp := Objecte nou.
Slurp en: ['nou'] fes: {
	propi str := [''].
}.


Slurp en: ['respon:'] fes: { :blah
		(propi str ≠ ['']) cert: {
			propi str afegeix-al-final: [' '].
		}.
		propi str afegeix-al-final: blah.
}.
Slurp en: ['respon:i:'] fes: { :blah :blahah
		(propi str ≠ ['']) cert: {
			propi str afegeix-al-final: [' '].
		}.
		(blah longitud > 1) cert: {
			propi str afegeix-al-final: (blah de: 0 longitud: (blah longitud - 1)).
		}, si-no: {
			propi str afegeix-al-final: blah.
		}.
		propi str afegeix-al-final: [' '].
		propi str afegeix-al-final: blahah.
}.
Slurp en: ['obtain'] fes: {
	>> buffer := propi str.
	propi str := ['']. <- buffer.
}.

>> paràmetres-de-cerca := Slurp nou.
paràmetres-de-cerca select: ['*'], from users where: ['id = 2'].
Sortida escriu: (paràmetres-de-cerca obtain), salt-de-línia.
