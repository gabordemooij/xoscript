# un format ha d'encaixar amb el tipus del valor; el tipus pot venir d'un client
>> intenta := { :formatació :value
	{ Sortida escriu: ( (Format nou: formatació) aplica: value ), salt-de-línia. } captura: { :e Sortida escriu: e, salt-de-línia. }, inicia.
}.
>> prova-enter := { :formatació :value
	{ Sortida escriu: ( (Format nou: formatació) aplica-enter: value ), salt-de-línia. } captura: { :e Sortida escriu: e, salt-de-línia. }, inicia.
}.

# encaixa
intenta aplica: ['|%s|'] i: ['text'].
intenta aplica: ['%06.2f'] i: 5.5.
intenta aplica: ['100%% %s'] i: ['segur'].
prova-enter aplica: ['%03d'] i: 7.
prova-enter aplica: ['%x'] i: 255.
intenta aplica: ['%d'] i: (Int64 nou des-de-text: ['12']).
intenta aplica: ['%lld'] i: (Int64 nou des-de-text: ['12']).
intenta aplica: ['%.1lf'] i: 5.5.
prova-enter aplica: ['%hd'] i: 7.

# no encaixa
intenta aplica: ['%s'] i: 12345.
intenta aplica: ['%d'] i: 12345.
intenta aplica: ['%f'] i: ['text'].
prova-enter aplica: ['%d'] i: ['text'].
prova-enter aplica: ['%s'] i: 5.
intenta aplica: ['%s %s'] i: ['text'].
intenta aplica: ['%n'] i: ['text'].
intenta aplica: ['%*s'] i: ['text'].
intenta aplica: ['%'] i: ['text'].

# el modificador de longitud no encaixa
intenta aplica: ['%ls'] i: ['text'].
intenta aplica: ['%Lf'] i: 5.5.
prova-enter aplica: ['%ld'] i: 7.
prova-enter aplica: ['%lld'] i: 7.
intenta aplica: ['%Ld'] i: (Int64 nou des-de-text: ['12']).

# una amplada que no encaixa amb printf ha de donar un error, no un bloqueig
intenta aplica: ['%99999999999s'] i: ['text'].
