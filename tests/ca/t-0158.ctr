>> x := [' hallo '].

>> y := x majúscules.
Sortida escriu: x, salt-de-línia.
Sortida escriu: (x igual-a: y), salt-de-línia.

>> y := x minúscules.
Sortida escriu: x, salt-de-línia.
Sortida escriu: (x igual-a: y), salt-de-línia.

>> y := x retalla.
Sortida escriu: x, salt-de-línia.
Sortida escriu: (x igual-a: y), salt-de-línia.

>> y := x desplaçament: 1.
Sortida escriu: x, salt-de-línia.
Sortida escriu: (x igual-a: y), salt-de-línia.

>> y := x de: 1 longitud: 2.
Sortida escriu: x, salt-de-línia.
Sortida escriu: (x igual-a: y), salt-de-línia.