

>> memòriaUsada1 := 0.
>> memòriaUsada2 := 0.
>> memòriaUsada3 := 0.
>> memòriaUsada4 := 0.

Programa gestió-memòria: 0.

>> txt := ['Word Salad'].
Sortida escriu: ['Longitud del text: '] + txt longitud, salt-de-línia.
Sortida escriu: ['Caràcter a 2:'] + ( txt caràcter: 2 ), salt-de-línia.
Sortida escriu: (( txt troba: ['S'] ) - 0), salt-de-línia.

Programa neteja.

memòriaUsada1 := (Programa memòria ? 0).


txt := ['Word Salad'].
Sortida escriu: ['Longitud del text: '] + txt longitud, salt-de-línia.
Sortida escriu: ['Caràcter a 2:'] + ( txt caràcter: 2 ), salt-de-línia.
Sortida escriu: (( txt troba: ['S'] ) - 0), salt-de-línia.

Programa neteja.
memòriaUsada2 := (Programa memòria ? 0).


txt := ['Word Salad'].
Sortida escriu: ['Longitud del text: '] + txt longitud, salt-de-línia.
Sortida escriu: ['Caràcter a 2:'] + ( txt caràcter: 2 ), salt-de-línia.
Sortida escriu: (( txt troba: ['S'] ) - 0), salt-de-línia.

Programa neteja.
memòriaUsada3 := (Programa memòria ? 0).



( memòriaUsada1 = memòriaUsada2 i: memòriaUsada1 = memòriaUsada3, i: memòriaUsada2 = memòriaUsada3 ) cert: {
	Sortida escriu: ['Aquí no hi ha fuites de memòria'].
}, fals: {
	Sortida escriu: ['Perdent memòria...'].
}.
