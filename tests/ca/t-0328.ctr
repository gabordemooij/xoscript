Programa gestió-memòria: 4.

>> Doubler := Objecte nou.
>> Multiplier := Objecte nou.
Doubler en: ['double:and:'] fes: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier en: ['multiply:and:'] fes: { :x :y <- (x × y).
}.

Sortida escriu: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), salt-de-línia.
