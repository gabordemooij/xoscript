Programa gestió-memòria: 4.

>> Duplicador := Objecte nou.
>> Multiplicador := Objecte nou.
Duplicador en: ['duplica:i:'] fes: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplicador en: ['multiplica:i:'] fes: { :x :y <- (x × y).
}.

Sortida escriu: (
	Duplicador duplica:
		(Duplicador duplica: 
			(Multiplicador multiplica: 2 i: 3)
		i:
			(Multiplicador multiplica: 3 i: 4)
		)
	i:
		(Duplicador duplica: 
			(Multiplicador multiplica: 2 i: 3)
		i:
			(Multiplicador multiplica: 3 i: 4)
		)
), salt-de-línia.
