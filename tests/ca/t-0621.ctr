>> frases := Llista nou
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> missatge := ['Phrase: ~decoded base64: ~encoded'].
	
frases cada: { :_ :frase 
	>> e := Server base64-codifica: frase.
	>> d := Server base64-descodifica: e.
	Sortida escriu: (
		missatge copia ~encoded: e, ~decoded: d
	), salt-de-línia.
}.
