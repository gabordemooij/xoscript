>> phrases := Llista nou
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases cada: { :_ :phrase 
	>> e := Server base64-codifica: phrase.
	>> d := Server base64-descodifica: e.
	Sortida escriu: (
		message copia ~encoded: e, ~decoded: d
	), salt-de-línia.
}.
