Sortida escriu: ['Objecte de prova'], salt-de-línia.
>> a := Objecte nou. 

a en: ['item:'] fes: { :ajudanthex
	propi ajudanthex := ajudanthex. 
}.

a en: ['article'] fes: {
	<- propi ajudanthex.
}.

a item: Hx nou.

>> adreça-antiga-ajudanthex := a article prototip adreça-de-memòria.
a save-as: ['/tmp/a.bin'].
Sortida escriu: ['========== RECARREGANT INSTANTÀNIA:'], salt-de-línia.

>> b := Objecte load-from: ['/tmp/a.bin'].

(b article prototip adreça-de-memòria = adreça-antiga-ajudanthex) cert: {
	Sortida escriu: ['Enllaç d'objecte reconnectat.'], salt-de-línia.
}.
