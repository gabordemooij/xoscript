Sortida escriu: ['Test object'], salt-de-línia.
>> a := Objecte nou. 

a en: ['item:'] fes: { :hexhelper
	propi hexhelper := hexhelper. 
}.

a en: ['item'] fes: { <- propi hexhelper.
}.

a item: Hx nou.

>> old-hexhelper-address := a item prototip adreça-de-memòria.
a save-as: ['/tmp/a.bin'].
Sortida escriu: ['========== RELOADING SNAP:'], salt-de-línia.

>> b := Objecte load-from: ['/tmp/a.bin'].

(b item prototip adreça-de-memòria = old-hexhelper-address) cert: {
	Sortida escriu: ['Object link re-attached.'], salt-de-línia.
}.
