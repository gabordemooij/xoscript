>> aleatoritzador := { :a :b
	>> mínim := ( a < b ) o-bé: a o: b.
	>> màxim := ( a > b ) o-bé: a o: b.
	>> x := Res.
	{
		x := Número entre: a i: b.
		((x < mínim) o: (x > màxim)) cert: { 
			Sortida escriu: (['Valor invàlid!']).
			Programa final.
		}.
	} 
	× 100. <- x.
}.
aleatoritzador aplica: 0 i: 0.
aleatoritzador aplica: 1 i: 0.
aleatoritzador aplica: 1 i: 1.
aleatoritzador aplica: 0 i: 1.
aleatoritzador aplica: -1 i: 0.
aleatoritzador aplica: -1 i: -1.
aleatoritzador aplica: 0 i: -1.
aleatoritzador aplica: 100 i: 200.
