#Linux
>> OS := Programa configuració: ['OS'].

>> clock := Moment nou.
	
(OS = ['Haiku']) cert: {
	clock zona: ['CET'],
	any: 2017, mes: 7, dia: 13,
	hora: 18, minut: 0, segon: 0.
}, si-no: {
	clock zona: ['Europe/Amsterdam'],
	any: 2017, mes: 7, dia: 13,
	hora: 18, minut: 0, segon: 0.
}.

clock en: ['tell'] fes: {
	Sortida escriu: jo, salt-de-línia.
}.


clock suma: 2    hora, tell.
clock suma: 1    hora, tell.
clock suma: 19 minut, tell.
clock suma: 1  minut, tell.
clock suma: 1  minut, tell.
clock suma: 19 segon, tell.
clock suma: 1  segon, tell.
clock suma: 1  segon, tell.
clock suma: 2    any, tell.
clock suma: 1    any, tell.

(OS = ['Haiku']) cert: {
clock suma: 5   mes.
clock zona: ['CEST'], tell.
}, si-no: {
	clock suma: 5   mes, tell.
}.

clock suma: 1   mes, tell.
clock suma: 19    dia, tell.
clock suma: 1    hora, tell.
clock suma: 120  yard, tell.
