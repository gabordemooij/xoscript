#Linux
>> SO := Programa configuració: ['SO'].

>> rellotge := Moment nou.
	
(SO = ['Haiku']) cert: {
	rellotge zona: ['CET'],
	any: 2017, mes: 7, dia: 13,
	hora: 18, minut: 0, segon: 0.
}, si-no: {
	rellotge zona: ['Europe/Amsterdam'],
	any: 2017, mes: 7, dia: 13,
	hora: 18, minut: 0, segon: 0.
}.

rellotge en: ['explica'] fes: {
	Sortida escriu: jo, salt-de-línia.
}.


rellotge suma: 2    hora, explica.
rellotge suma: 1    hora, explica.
rellotge suma: 19 minut, explica.
rellotge suma: 1  minut, explica.
rellotge suma: 1  minut, explica.
rellotge suma: 19 segon, explica.
rellotge suma: 1  segon, explica.
rellotge suma: 1  segon, explica.
rellotge suma: 2    any, explica.
rellotge suma: 1    any, explica.

(SO = ['Haiku']) cert: {
rellotge suma: 5   mes.
rellotge zona: ['CEST'], explica.
}, si-no: {
	rellotge suma: 5   mes, explica.
}.

rellotge suma: 1   mes, explica.
rellotge suma: 19    dia, explica.
rellotge suma: 1    hora, explica.
rellotge suma: 120  iarda, explica.
