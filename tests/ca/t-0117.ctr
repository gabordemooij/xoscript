>> t := Cert.
(t = Cert) cert: { Sortida escriu: ['T']. }.
(t = Fals) cert: { Sortida escriu: ['F']. }.
Sortida escriu: ['|'].
>> t := Fals.
(t = Cert) cert: { Sortida escriu: ['T']. }.
(t = Fals) cert: { Sortida escriu: ['F']. }.
Sortida escriu: ['|'].
>> f := Cert.
(t = Cert i: f = Fals) cert: { Sortida escriu: ['T']. }.
(t = Fals i: f = Cert) cert: { Sortida escriu: ['F']. }.
Sortida escriu: ['|'].
>> n := Res.
(n Res?) cert: { Sortida escriu: ['T']. }.
(n Res?) fals: { Sortida escriu: ['F']. }.
Sortida escriu: ['|'].
(f Boolean?) cert: { Sortida escriu: ['T']. }.
(f Boolean?) fals: { Sortida escriu: ['F']. }.



