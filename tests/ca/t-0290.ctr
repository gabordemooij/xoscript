# prova d'operacions amb llistes


>> pastissos := Llista ←
	['poma'] ;
	['nabiu'] ;
	['xoco'] ;
	['formatge'].


>> compra := pastissos substitueix: 1 longitud: 2 per: ( Llista ← ['canyella'] ; ['pinya'] ).
Sortida escriu: (compra uneix: [',']), salt-de-línia.


>> compra := pastissos substitueix: 1 longitud: 12 per: ( Llista ← ['canyella'] ; ['pinya'] ).
Sortida escriu: (compra uneix: [',']), salt-de-línia.


>> compra := pastissos substitueix: 2 longitud: 10 per: ( Llista nou ).
Sortida escriu: (compra uneix: [',']), salt-de-línia.


>> compra := pastissos substitueix: 0 longitud: 1 per: ( Llista nou ).
Sortida escriu: (compra uneix: [',']), salt-de-línia.


>> compra := pastissos substitueix: ['0'] longitud: ['1'] per: ['x'].
Sortida escriu: (compra uneix: [',']), salt-de-línia.
