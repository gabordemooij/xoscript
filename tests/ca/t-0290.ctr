# test list operations


>> cakes := Llista ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes substitueix: 1 longitud: 2 per: ( Llista ← ['cinnamon'] ; ['pineapple'] ).
Sortida escriu: (buy uneix: [',']), salt-de-línia.


>> buy := cakes substitueix: 1 longitud: 12 per: ( Llista ← ['cinnamon'] ; ['pineapple'] ).
Sortida escriu: (buy uneix: [',']), salt-de-línia.


>> buy := cakes substitueix: 2 longitud: 10 per: ( Llista nou ).
Sortida escriu: (buy uneix: [',']), salt-de-línia.


>> buy := cakes substitueix: 0 longitud: 1 per: ( Llista nou ).
Sortida escriu: (buy uneix: [',']), salt-de-línia.


>> buy := cakes substitueix: ['0'] longitud: ['1'] per: ['x'].
Sortida escriu: (buy uneix: [',']), salt-de-línia.
