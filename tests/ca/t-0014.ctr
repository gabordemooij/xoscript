>> Salutador := Objecte nou.
Salutador en: ['fabrica'] fes: {
	>> sl := Objecte nou.
	sl en: ['setName:'] fes: { :unNom
		propi nom := unNom.
	}.
	sl en: ['saluda'] fes: {
		Sortida escriu: propi nom.
	}. <- sl.
}.
>> a := Salutador fabrica.
>> b := Salutador fabrica.
a setName: ['U'].
b setName: ['DOS'].
a saluda.
b saluda.
>> c := a nou.
c setName: ['TRES'].
c saluda.
>> d := a nou.
d setName: ['QUATRE'].
d saluda.
c saluda.
