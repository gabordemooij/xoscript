>> Greeter := Objecte nou.
Greeter en: ['make'] fes: {
	>> gr := Objecte nou.
	gr en: ['setName:'] fes: { :aname
		propi nom := aname.
	}.
	gr en: ['greet'] fes: {
		Sortida escriu: propi nom.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a nou.
c setName: ['THREE'].
c greet.
>> d := a nou.
d setName: ['FOUR'].
d greet.
c greet.
