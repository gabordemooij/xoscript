

Llista en: ['fixture:'] fes: { :f
	propi fixture := f.
}.

Llista en: ['compta'] fes: { <- propi fixture.
}.

Llista en: ['aantal'] fes: { <- propi fixture.
}.


>> x := Res.
{

	x := ['hello'] 
	substitueix:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] caràcter: 2)
			)
		)
	per: (
		(['...hal'] + ['lo']) 
			majúscules 
			lowecase 
			majúscules 
			desplaçament: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Llista ← 0 ; 1 ; 4; 9 ; (Llista ← 0 ; 3; 1) ; 4
							) penúltim
						) ? 1
					) + 
					((Llista ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					compta
				)
			)
	).

} × 10.
Sortida escriu: x, salt-de-línia.

