Server init.

# retornar un valor que no és text des de match/do hauria de funcionar
>> subject := ['abc'].
>> model := Patró nou: ['([ac])'].
>> resultat  := model coincidència: subject fes: { :m :x
	Sortida escriu: m, salt-de-línia.
	Sortida escriu: x, salt-de-línia.
	<- Res.
}.
Sortida escriu: resultat, salt-de-línia.