# prova de búfers PKI/Sign 
Server init.

>> llarg := ( Llista nou omple: 1000 amb: ['a'] ) uneix: [''].

# signa un missatge
Sortida escriu: ( 
	Caixa-forta signa: ['abc'] amb: llarg
), salt-de-línia.

Sortida escriu: ( 
	Caixa-forta
		comprova: ['abc'] 
		signatura: llarg 
		amb: llarg
), salt-de-línia.

Sortida escriu: (
	Caixa-forta resum-contrasenya: llarg verifica: llarg
), salt-de-línia.
