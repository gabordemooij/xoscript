# test buffers PKI/Sign 
Server init.

>> long := ( Llista nou omple: 1000 amb: ['a'] ) uneix: [''].

# sign a message
Sortida escriu: ( 
	Caixa-forta signa: ['abc'] amb: long
), salt-de-línia.

Sortida escriu: ( 
	Caixa-forta
		comprova: ['abc'] 
		signatura: long 
		amb: long
), salt-de-línia.

Sortida escriu: (
	Caixa-forta resum-contrasenya: long verifica: long
), salt-de-línia.
