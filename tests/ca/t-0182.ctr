

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa gestió-memòria: 0.

>> txt := ['1.6'].
>> n := txt número.
>> t := txt booleà.
Sortida escriu: n, salt-de-línia.
Sortida escriu: t, salt-de-línia.
Sortida escriu: n tipus, salt-de-línia.
Sortida escriu: t tipus, salt-de-línia.

Programa neteja.

usedMemory1 := (Programa memòria ? 0).


txt := ['1.6'].
n := txt número.
t := txt booleà.
Sortida escriu: n, salt-de-línia.
Sortida escriu: t, salt-de-línia.
Sortida escriu: n tipus, salt-de-línia.
Sortida escriu: t tipus, salt-de-línia.

Programa neteja.
usedMemory2 := (Programa memòria ? 0).


txt := ['1.6'].
n := txt número.
t := txt booleà.
Sortida escriu: n, salt-de-línia.
Sortida escriu: t, salt-de-línia.
Sortida escriu: n tipus, salt-de-línia.
Sortida escriu: t tipus, salt-de-línia.

Programa neteja.
usedMemory3 := (Programa memòria ? 0).



( usedMemory1 = usedMemory2 i: usedMemory1 = usedMemory3, i: usedMemory2 = usedMemory3 ) cert: {
	Sortida escriu: ['No memory leaks here'].
}, fals: {
	Sortida escriu: ['Leaking memory...'].
}.
