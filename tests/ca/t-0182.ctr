

>> memòriaUsada1 := 0.
>> memòriaUsada2 := 0.
>> memòriaUsada3 := 0.
>> memòriaUsada4 := 0.

Programa gestió-memòria: 0.

>> txt := ['1.6'].
>> n := txt número.
>> t := txt booleà.
Sortida escriu: n, salt-de-línia.
Sortida escriu: t, salt-de-línia.
Sortida escriu: n tipus, salt-de-línia.
Sortida escriu: t tipus, salt-de-línia.

Programa neteja.

memòriaUsada1 := (Programa memòria ? 0).


txt := ['1.6'].
n := txt número.
t := txt booleà.
Sortida escriu: n, salt-de-línia.
Sortida escriu: t, salt-de-línia.
Sortida escriu: n tipus, salt-de-línia.
Sortida escriu: t tipus, salt-de-línia.

Programa neteja.
memòriaUsada2 := (Programa memòria ? 0).


txt := ['1.6'].
n := txt número.
t := txt booleà.
Sortida escriu: n, salt-de-línia.
Sortida escriu: t, salt-de-línia.
Sortida escriu: n tipus, salt-de-línia.
Sortida escriu: t tipus, salt-de-línia.

Programa neteja.
memòriaUsada3 := (Programa memòria ? 0).



( memòriaUsada1 = memòriaUsada2 i: memòriaUsada1 = memòriaUsada3, i: memòriaUsada2 = memòriaUsada3 ) cert: {
	Sortida escriu: ['Aquí no hi ha fuites de memòria'].
}, fals: {
	Sortida escriu: ['Perdent memòria...'].
}.
