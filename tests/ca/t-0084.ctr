>> makeAdder := { :x
	>> f := { :y <- (propi x + y). } estableix: ['x'] valor: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i propi q posa: (propi f aplica: (propi q ? i)) a: i. } 
	estableix: ['q'] valor: array,
	estableix: ['f'] valor: func.
	{ :i mapping aplica: i. } × (array compta).
}.

>> a := Llista ← 1; 2; 3.
mapper aplica: a i: (makeAdder aplica: 100).
Sortida escriu: (a posició: 0), salt-de-línia.
Sortida escriu: (a ? 1), salt-de-línia.
Sortida escriu: (a ? 2), salt-de-línia.
