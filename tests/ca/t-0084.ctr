>> creaSumador := { :x
	>> f := { :y <- (propi x + y). } estableix: ['x'] valor: x. <- f.
}.
>> aplicador := { :vector :func
	>> assignació := { :i propi q posa: (propi f aplica: (propi q ? i)) a: i. } 
	estableix: ['q'] valor: vector,
	estableix: ['f'] valor: func.
	{ :i assignació aplica: i. } × (vector compta).
}.

>> a := Llista ← 1; 2; 3.
aplicador aplica: a i: (creaSumador aplica: 100).
Sortida escriu: (a posició: 0), salt-de-línia.
Sortida escriu: (a ? 1), salt-de-línia.
Sortida escriu: (a ? 2), salt-de-línia.
