Sortida escriu: ['Objecte de prova'], salt-de-línia.
>> ord := Ordre nou.
Sortida escriu: ord ls /tmp, salt-de-línia.
>> adreça-antiga-ord := ord prototip adreça-de-memòria.
ord save-as: ['/tmp/a.bin'].
Sortida escriu: ['========== RECARREGANT INSTANTÀNIA:'], salt-de-línia.
>> b := Objecte load-from: ['/tmp/a.bin'].
(b prototip adreça-de-memòria = adreça-antiga-ord) cert: {
	Sortida escriu: ['Enllaç d'objecte reconnectat.'], salt-de-línia.
}.
Sortida escriu: b ls, salt-de-línia.


