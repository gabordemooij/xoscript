Sortida escriu: ['Test object'], salt-de-línia.
>> cmd := Ordre nou.
Sortida escriu: cmd ls /tmp, salt-de-línia.
>> old-cmd-address := cmd prototip adreça-de-memòria.
cmd save-as: ['/tmp/a.bin'].
Sortida escriu: ['========== RELOADING SNAP:'], salt-de-línia.
>> b := Objecte load-from: ['/tmp/a.bin'].
(b prototip adreça-de-memòria = old-cmd-address) cert: {
	Sortida escriu: ['Object link re-attached.'], salt-de-línia.
}.
Sortida escriu: b ls, salt-de-línia.


