# prova número -> text -> número
{

	>> x := Número entre: 0 i: 1000000.
	>> d := Número entre: 1 i: 7.
	>> e := 10 potència: d.

	x divideix-per: e.
	>> y := x text número.

	(x = y) fals: {
		Sortida escriu: x, salt-de-línia.
		Sortida escriu: y, salt-de-línia.
		Programa final.
	}.

} * 1000.
Sortida escriu: ['OK'], salt-de-línia.