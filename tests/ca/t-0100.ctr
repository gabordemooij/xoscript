Text en: ['html'] fes: { <- (
		jo
		substitueix: ['&'] per: ['&amp;'],
		substitueix: ['<'] per: ['&lt;'],
		substitueix: ['>'] per: ['&gt;'],
		substitueix: ['"'] per: ['&quot;']
	).
}.

>> list := Llista nou.

['Verbatim Syntax'] caràcters cada: { :número :lletra
	list ; ((['<li>#Number:Letter</li>']) Number: (número), Letter: lletra).
}.

Sortida list.





>> motlle := ['
<html>
<body>
<p>Hello this is a test!</p>
<p>The string \‘Verbatim Syntax\’ has: 15 code points...</p>
<ul>
[list]
</ul>
</body> 
</html>
'] [list]: (list uneix: ['↵']).

Sortida escriu: motlle.

