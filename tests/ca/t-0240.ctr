# prova de qualificadors

>> $ := Objecte nou.

$ en: ['respon:'] fes: { :x
	
	>> operació := x caràcter: 0.
	>> valuta := x caràcter: 1.
	>> diners := x desplaçament: 2.
	
	>> import := 0.

	( operació = ['+'] ) cert: {
		( valuta = ['£'] ) cert: { import := 1.28 × diners. }.
	}. <- import.
}.



>> x := $ +£20.

Sortida escriu: x, salt-de-línia.


>> Fruita := Objecte nou.

Fruita en: ['nou'] fes: {
	>> f := jo nou.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruita en: ['apples:'] fes: { :a propi pomes := a. }.
Fruita en: ['oranges:'] fes: { :p propi taronges := p. }.
Fruita en: ['pomes'] fes: { <- propi pomes. }.
Fruita en: ['taronges'] fes: { <- propi taronges. }.

Fruita en: ['+'] fes: { :f
	
	>> n := Fruita nou.
	f suma: 1.
	
	n apples: (f pomes + propi pomes).
	n oranges:  (f taronges  + propi taronges). <- n.
}.

Fruita en: ['text'] fes: { <- ( propi pomes text + [' pomes i '] + propi taronges + [' taronges'] ).
}.

Número en: ['pomes'] fes: { <- ((Fruita nou) apples: jo).
}.

Número en: ['poma'] fes: { <- ((Fruita nou) apples: jo).
}.

Número en: ['taronges'] fes: { <- ((Fruita nou) oranges: jo).
}.




Sortida escriu: (1 poma + 3 taronges + 4 pomes), salt-de-línia.


Text en: ['duesVegades'] fes: { <- ((jo text) + (jo text)).
}.



Sortida escriu: ['❤❤❤'] duesVegades.



