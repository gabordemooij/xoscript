# test qualifiers

>> $ := Objecte nou.

$ en: ['respon:'] fes: { :x
	
	>> operation := x caràcter: 0.
	>> valuta := x caràcter: 1.
	>> money := x desplaçament: 2.
	
	>> amount := 0.

	( operation = ['+'] ) cert: {
		( valuta = ['£'] ) cert: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Sortida escriu: x, salt-de-línia.


>> Fruit := Objecte nou.

Fruit en: ['nou'] fes: {
	>> f := jo nou.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit en: ['apples:'] fes: { :a propi apples := a. }.
Fruit en: ['oranges:'] fes: { :p propi oranges := p. }.
Fruit en: ['apples'] fes: { <- propi apples. }.
Fruit en: ['oranges'] fes: { <- propi oranges. }.

Fruit en: ['+'] fes: { :f
	
	>> n := Fruit nou.
	f suma: 1.
	
	n apples: (f apples + propi apples).
	n oranges:  (f oranges  + propi oranges). <- n.
}.

Fruit en: ['text'] fes: { <- ( propi apples text + [' apples and '] + propi oranges + [' oranges'] ).
}.

Número en: ['apples'] fes: { <- ((Fruit nou) apples: jo).
}.

Número en: ['apple'] fes: { <- ((Fruit nou) apples: jo).
}.

Número en: ['oranges'] fes: { <- ((Fruit nou) oranges: jo).
}.




Sortida escriu: (1 apple + 3 oranges + 4 apples), salt-de-línia.


Text en: ['twice'] fes: { <- ((jo text) + (jo text)).
}.



Sortida escriu: ['❤❤❤'] twice.



