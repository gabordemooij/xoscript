# un grup que no forma part de la coincidència no ha de bloquejar i ha de mantenir els números de grup
Server init.
>> mostra := { :model :subject
	>> p := Patró nou: model.
	p coincidència: subject fes: { :m :g
		Sortida escriu: g compta, escriu: [' '], escriu: (g uneix: ['|']), salt-de-línia.
		<- m.
	}.
}.
mostra aplica: ['(a)|(b)'] i: ['b'].
mostra aplica: ['(a)|(b)'] i: ['a'].
mostra aplica: ['(x)?y'] i: ['y'].
mostra aplica: ['(x)?(y)(z)?'] i: ['xy'].
