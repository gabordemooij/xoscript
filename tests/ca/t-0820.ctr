# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Patró nou: pattern.
	p coincidència: subject fes: { :m :g
		Sortida escriu: g compta, escriu: [' '], escriu: (g uneix: ['|']), salt-de-línia. <- m.
	}.
}.
show aplica: ['(a)|(b)'] i: ['b'].
show aplica: ['(a)|(b)'] i: ['a'].
show aplica: ['(x)?y'] i: ['y'].
show aplica: ['(x)?(y)(z)?'] i: ['xy'].
