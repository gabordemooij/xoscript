

Text en: ['avalua'] fes: {
	>> codi := Fitxer nou: ['/tmp/eval.ctr'].
	codi escriu: jo text + ['.'].
	Programa utilitza: ['/tmp/eval.ctr'].
}.

>> a := (Llista ← (
	(Diccionari nou)
		posa: ['domini'] a: ['mywebsite.com'],
		posa: (Llista ←
			((Diccionari nou)
				posa: ['inici'] a: ['title'],
				posa: ['<html></html>'] a: ['body'],
				posa: ['2017-01-01'] a: ['creat']
			) ;
			((Diccionari nou)
				posa: ['quisom(c)'] a: ['title'],
				posa: ['<credits>Author Inc.</credits>'] a: ['body']
			)
		) a: ['pàgines']
	)
) text.

Sortida escriu: a tipus, salt-de-línia.
Sortida escriu: a, salt-de-línia.

>> b := Res.
(['b := '] + a) avalua.
Sortida escriu: b ? 0 ? ['pàgines'] ? 1 ? ['body'], salt-de-línia.

>> c := b ? 0.
>> d := c text.
Sortida escriu: d tipus, salt-de-línia.

>> e := Res.
(['e := '] + d) avalua.
Sortida escriu: e ? ['pàgines'] ? 0, salt-de-línia.
