
>> botiga := (Diccionari nou
	posa: ['revista'] a: ['books'],
	posa: ['ordinador'] a: ['electrònica'],
	posa: ['pintallavis'] a: ['cosmètica']
).
Sortida escriu: (botiga té: ['ordinador']), salt-de-línia. 
Sortida escriu: (botiga té: ['botifarra']), salt-de-línia. 
Sortida escriu: (botiga té: ['ordinadors']), salt-de-línia. 
Sortida escriu: (botiga té: ['ordina']), salt-de-línia. 
Sortida escriu: (botiga té: ['2ordinador']), salt-de-línia. 
