


>> MàquinaDeCafè := Objecte nou.
MàquinaDeCafè en: ['order:'] fes: { :id
	>> coffee := ['Americano'].
	( id = 1 ) cert: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) cert: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) cert: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> MàquinaDeCafèSimple := Objecte nou.
MàquinaDeCafèSimple en: ['comanda'] fes: { <- ['Negre']. }.
>> tassaVermella := MàquinaDeCafè order: 1.
Sortida escriu: tassaVermella, salt-de-línia.
tassaVermella := ['Te']. 
>> tassaVerda := MàquinaDeCafè order: 0.
Sortida escriu: tassaVerda, salt-de-línia.
>> tassaGroga := MàquinaDeCafè order: 1.
Sortida escriu: tassaGroga, salt-de-línia.
>> tassaBlava := MàquinaDeCafè order: 0.
Sortida escriu: tassaBlava, salt-de-línia.
>> tassaDePlàstic := MàquinaDeCafèSimple comanda.
tassaDePlàstic := ['Llimonada']. 
>> tassaNegra := MàquinaDeCafèSimple comanda.
Sortida escriu: tassaNegra, salt-de-línia.
tassaNegra afegeix-al-final: [' nooo.... cervesa. '].
>> tassaTaronja := MàquinaDeCafèSimple comanda.
Sortida escriu: tassaTaronja, salt-de-línia.
