


>> CoffeeMachine := Objecte nou.
CoffeeMachine en: ['order:'] fes: { :id
	>> coffee := ['Americano'].
	( id = 1 ) cert: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) cert: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) cert: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Objecte nou.
SimpleCoffeeMachine en: ['order'] fes: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Sortida escriu: redCup, salt-de-línia.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Sortida escriu: greenCup, salt-de-línia.
>> yellowCup := CoffeeMachine order: 1.
Sortida escriu: yellowCup, salt-de-línia.
>> blueCup := CoffeeMachine order: 0.
Sortida escriu: blueCup, salt-de-línia.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Sortida escriu: blackCup, salt-de-línia.
blackCup afegeix-al-final: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Sortida escriu: orangeCup, salt-de-línia.
