#Linux

(Fitxer nou: ['/tmp/testje']) existeix fals: {
	Programa sistema: ['mkdir /tmp/testje'].	
}.

(Fitxer nou: ['/tmp/testje/file1']) existeix fals: {
	Programa sistema: ['touch /tmp/testje/file1'].	
}.

(Fitxer nou: ['/tmp/testje/folder1']) existeix fals: {
	Programa sistema: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Fitxer llista: ['/tmp/testje'].

>> q := Llista nou.

l cada: { :k :v v cada: { :x :y q afegeix-al-final: y. }. }.

>> s := q text.

(s conté: ['file1']) cert:   { Sortida escriu: ['OK'], salt-de-línia. }.
(s conté: ['file2']) cert:   { Sortida escriu: ['XX'], salt-de-línia. }.
(s conté: ['folder1']) cert: { Sortida escriu: ['OK'], salt-de-línia. }.
