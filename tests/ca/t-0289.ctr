#Linux
>> OS := Programa sistema: (Ordre uname -s), retalla.

>> Slurp := Objecte nou.
Slurp en: ['nou'] fes: {
	propi str := [''].
}.
Slurp en: ['respon:'] fes: { :blah
		(propi str ≠ ['']) cert: {
			propi str afegeix-al-final: [' '].
		}.
		propi str afegeix-al-final: blah.
}.
Slurp en: ['respon:i:'] fes: { :blah :blahah
		(propi str ≠ ['']) cert: {
			propi str afegeix-al-final: [' '].
		}.
		(blah longitud > 1) cert: {
			propi str afegeix-al-final: (blah de: 0 longitud: (blah longitud - 1)).
		}, si-no: {
			propi str afegeix-al-final: blah.
		}.
		propi str afegeix-al-final: [' '].
		propi str afegeix-al-final: blahah.
}.
Slurp en: ['obtain'] fes: {
	>> buffer := propi str.
	propi str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text afegeix-al-final: ['hello'].
} × 1000.


Sortida escriu: (
	Programa sistema: (
		Slurp nou
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

