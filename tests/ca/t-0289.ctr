#Linux
>> SO := Programa sistema: (Ordre uname -s), retalla.

>> Xarrup := Objecte nou.
Xarrup en: ['nou'] fes: {
	propi str := [''].
}.
Xarrup en: ['respon:'] fes: { :blah
		(propi str ≠ ['']) cert: {
			propi str afegeix-al-final: [' '].
		}.
		propi str afegeix-al-final: blah.
}.
Xarrup en: ['respon:i:'] fes: { :blah :blahah
		(propi str ≠ ['']) cert: {
			propi str afegeix-al-final: [' '].
		}.
		(blah longitud > 1) cert: {
			propi str afegeix-al-final: (blah de: 0 longitud: (blah longitud - 1)).
		}, si-no: {
			propi str afegeix-al-final: blah.
		}.
		propi str afegeix-al-final: [' '].
		propi str afegeix-al-final: blahah.
}.
Xarrup en: ['aconsegueix'] fes: {
	>> búfer := propi str.
	propi str := ['']. <- búfer.
}.
>> large text := [''].
{
	large text afegeix-al-final: ['hello'].
} × 1000.


Sortida escriu: (
	Programa sistema: (
		Xarrup nou
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: SO)
		) aconsegueix
).

