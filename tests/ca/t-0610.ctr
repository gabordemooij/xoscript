
>> Rectangle := Objecte nou.

Rectangle en: ['area'] fes: { <- propi longitud * propi width.
}.

Rectangle en: ['length:'] fes: { :longitud
	propi longitud := longitud.
}.

Rectangle en: ['width:'] fes: { :width
	propi width := width.
}.

Rectangle en: ['nou'] fes: {
	# this will not result into an infinite loop
	>> rectangle := jo nou.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle nou.
Sortida escriu: a area, salt-de-línia. #0

>> b := Rectangle nou length: 2, width: 3.
Sortida escriu: b area, salt-de-línia. #6

