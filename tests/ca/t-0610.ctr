
>> Rectangle := Objecte nou.

Rectangle en: ['àrea'] fes: {
	<- propi longitud * propi amplada.
}.

Rectangle en: ['length:'] fes: { :longitud
	propi longitud := longitud.
}.

Rectangle en: ['width:'] fes: { :amplada
	propi amplada := amplada.
}.

Rectangle en: ['nou'] fes: {
	# això no provocarà un bucle infinit
	>> rectangle := jo nou.
	rectangle length: 0, width: 0.
	<- rectangle.
}.

>> a := Rectangle nou.
Sortida escriu: a àrea, salt-de-línia. #0

>> b := Rectangle nou length: 2, width: 3.
Sortida escriu: b àrea, salt-de-línia. #6

