
Llista en: ['sum'] fes: {
	>> total := 0.
	jo cada: { :index :element
		total suma: element.
	}. <- total.
}.

>> a := Llista ← 9 ; 8 ; 7.
Sortida escriu: (a sum), salt-de-línia. 
>> a := Llista ← 1 ; 9.
Sortida escriu: (a sum), salt-de-línia. 
>> a := Llista ← ['o'] ; 2.
Sortida escriu: (a sum), salt-de-línia. 
Sortida escriu: (Llista nou sum), salt-de-línia. 
