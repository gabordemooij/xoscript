
Llista en: ['suma'] fes: {
	>> total := 0.
	jo cada: { :índex :element
		total suma: element.
	}. <- total.
}.

>> a := Llista ← 9 ; 8 ; 7.
Sortida escriu: (a suma), salt-de-línia. 
>> a := Llista ← 1 ; 9.
Sortida escriu: (a suma), salt-de-línia. 
>> a := Llista ← ['o'] ; 2.
Sortida escriu: (a suma), salt-de-línia. 
Sortida escriu: (Llista nou suma), salt-de-línia. 
