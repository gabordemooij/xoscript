>> Combination := Llista nou.

Combination en: ['afegeix-al-final:'] fes: { :el
	jo 
	troba: el, Res? cert: { jo afegeix-al-final: el. }.
}.

>> colours := Combination nou.
colours
	afegeix-al-final: ['red'],
	afegeix-al-final: ['green'],
	afegeix-al-final: ['blue'],
	afegeix-al-final: ['red'].

Sortida escriu: colours, salt-de-línia.
