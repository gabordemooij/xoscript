>> Combinació := Llista nou.

Combinació en: ['afegeix-al-final:'] fes: { :el
	jo 
	troba: el, Res? cert: { jo afegeix-al-final: el. }.
}.

>> colorits := Combinació nou.
colorits
	afegeix-al-final: ['vermell'],
	afegeix-al-final: ['verd'],
	afegeix-al-final: ['blau'],
	afegeix-al-final: ['vermell'].

Sortida escriu: colorits, salt-de-línia.
