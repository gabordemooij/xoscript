# catch-all test (practical)
>> HTML := Text nou.
HTML en: ['encode:'] fes: { :tekst
	jo afegeix-al-final: (tekst
	substitueix: ['&'] per: ['&amp;'], 
	substitueix: ['<'] per: ['&lt;'],
	substitueix: ['>'] per: ['&gt;'],
	substitueix: ['"'] per: ['&quot;']).
}.
>> blog := HTML nou.
blog afegeix-al-final: ['<h1>'],
     encode: ['Koffie & Thee'],
     afegeix-al-final: ['</h1>'].
Sortida escriu: blog, salt-de-línia.


>> Roman := Número nou.
Roman en: ['stringy'] fes: {
	>> a := [''].
	{ a afegeix-al-final: ['I']. } × jo. <- a.
}.

>> x := Roman nou.
x suma: 3.
Sortida escriu: x stringy, salt-de-línia.

>> Quantum := Booleà nou.
Quantum en: ['true?'] fes: { <- ['maybe True']. }.
Sortida escriu: (Quantum nou true?), salt-de-línia.

>> Nihil := Res nou.
Nihil en: ['text'] fes: { <- ['Nihil']. }.
Sortida escriu: (Nihil nou), salt-de-línia.
