# prova de captura general (pràctica)
>> HTML := Text nou.
HTML en: ['encode:'] fes: { :tekst
	jo afegeix-al-final: (tekst
	substitueix: ['&'] per: ['&amp;'], 
	substitueix: ['<'] per: ['&lt;'],
	substitueix: ['>'] per: ['&gt;'],
	substitueix: ['"'] per: ['&quot;']).
}.
>> blog := HTML nou.
blog afegeix-al-final: ['<h1>'],
     encode: ['Koffie & Thee'],
     afegeix-al-final: ['</h1>'].
Sortida escriu: blog, salt-de-línia.


>> Romà := Número nou.
Romà en: ['textual'] fes: {
	>> a := [''].
	{ a afegeix-al-final: ['I']. } × jo. <- a.
}.

>> x := Romà nou.
x suma: 3.
Sortida escriu: x textual, salt-de-línia.

>> Quàntic := Booleà nou.
Quàntic en: ['true?'] fes: { <- ['potser Cert']. }.
Sortida escriu: (Quàntic nou true?), salt-de-línia.

>> Nihil := Res nou.
Nihil en: ['text'] fes: { <- ['Nihil']. }.
Sortida escriu: (Nihil nou), salt-de-línia.
