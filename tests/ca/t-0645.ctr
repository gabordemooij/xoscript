Server init.
Sortida escriu: ['Prova de data a la base de dades'], salt-de-línia.

>> bd := Maria-DB nou amfitrió: ['localhost'],
	usuari: ['xo'], 
	contrasenya: ['pass123'],
	nom-base: ['xobase'],
	connecta.

>> paràmetres-de-cerca :=
bd consulta: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
obtén: { :fila
	Sortida escriu: fila datetest, salt-de-línia.
}.
