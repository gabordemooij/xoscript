Server init.
Sortida escriu: ['Database date test'], salt-de-línia.

>> db := Maria-DB nou amfitrió: ['localhost'],
	usuari: ['xo'], 
	contrasenya: ['pass123'],
	nom-base: ['xobase'],
	connecta.

>> paràmetres-de-cerca :=
db consulta: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
obtén: { :row
	Sortida escriu: row datetest, salt-de-línia.
}.
