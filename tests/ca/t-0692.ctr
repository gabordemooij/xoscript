Server init.

Sortida escriu: (
	Patró nou: ['^\\w+$'],
	coincidència: ['test@example.com'] 
), salt-de-línia. # 0 coincidències, falla amb @ i .

Sortida escriu: (
	Patró nou: ['^[^@]+@[^\.]+\.\\w+$'],
	coincidència: ['test@example.com'] 
), salt-de-línia. # 1 coincidència

Sortida escriu: (
	Patró nou: ['[^@]+@[^\.]+\.\\w+'],
	coincidència: ['test@example.com'] 
), salt-de-línia. # 1 coincidència

Sortida escriu: (
	Patró nou: ['([^@]+)@([^\.]+)\.\\w+'],
	coincidència: ['test@example.com'] 
), salt-de-línia. # 1 coincidència, els grups no importen

Sortida escriu: (
	Patró nou: ['[a-z]'],
	coincidència: ['test@example.com'] 
), salt-de-línia. # 14 coincidències

Sortida escriu: (
	Patró nou: ['.*'],
	coincidència: ['test@example.com'] 
), salt-de-línia. # 1 coincidència (tot)

Sortida escriu: (
	Patró nou: ['(.*)'],
	coincidència: ['test@example.com'] 
), salt-de-línia. # 1 coincidència (tot)

Sortida escriu: (
	Patró nou: ['\\s*[^@]+@[^\.]+\.\\w+'],
	coincidència: ['test@example.com'] 
), salt-de-línia. # 1 coincidència, espai de prefix opcional, s'ignora