Server init.

Sortida escriu: (
	Patró nou: ['^\\w+$'],
	coincidència: ['test@example.com'] 
), salt-de-línia. # 0 match, fails on @ and .

Sortida escriu: (
	Patró nou: ['^[^@]+@[^\.]+\.\\w+$'],
	coincidència: ['test@example.com'] 
), salt-de-línia. # 1 match

Sortida escriu: (
	Patró nou: ['[^@]+@[^\.]+\.\\w+'],
	coincidència: ['test@example.com'] 
), salt-de-línia. # 1 match

Sortida escriu: (
	Patró nou: ['([^@]+)@([^\.]+)\.\\w+'],
	coincidència: ['test@example.com'] 
), salt-de-línia. # 1 match, groups dont matter

Sortida escriu: (
	Patró nou: ['[a-z]'],
	coincidència: ['test@example.com'] 
), salt-de-línia. # 14 matches

Sortida escriu: (
	Patró nou: ['.*'],
	coincidència: ['test@example.com'] 
), salt-de-línia. # 1 match (all)

Sortida escriu: (
	Patró nou: ['(.*)'],
	coincidència: ['test@example.com'] 
), salt-de-línia. # 1 match (all)

Sortida escriu: (
	Patró nou: ['\\s*[^@]+@[^\.]+\.\\w+'],
	coincidència: ['test@example.com'] 
), salt-de-línia. # 1 match, prefix space optional, gets ignored