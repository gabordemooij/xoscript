# menys paràmetres que marcadors han de donar un error, no llegir més enllà de les vinculacions
Server init.

>> bd := Maria-DB nou amfitrió: ['localhost'],
	usuari: ['xo'],
	contrasenya: ['pass123'],
	nom-base: ['xobase'],
	connecta.

>> paràmetres-de-cerca := bd consulta: ['SELECT ? AS a, ? AS b, ? AS c'].
paràmetres-de-cerca paràmetres: (Llista nou ; ['1']).
{ paràmetres-de-cerca obtén: { :fila Sortida escriu: fila, salt-de-línia. }. } captura: { :e Sortida escriu: e, salt-de-línia. }, inicia.

>> paràmetres-de-cerca := bd consulta: ['SELECT ? AS a'].
{ paràmetres-de-cerca obtén: { :fila Sortida escriu: fila, salt-de-línia. }. } captura: { :e Sortida escriu: e, salt-de-línia. }, inicia.

# el nombre correcte encara funciona; els paràmetres de més s'ignoren com abans
>> paràmetres-de-cerca := bd consulta: ['SELECT ? AS a, ? AS b'].
paràmetres-de-cerca paràmetres: (Llista nou ; ['1'] ; ['2']).
paràmetres-de-cerca obtén: { :fila Sortida escriu: (fila a: ['a']), escriu: (fila a: ['b']), salt-de-línia. }.
paràmetres-de-cerca paràmetres: (Llista nou ; ['1'] ; ['2'] ; ['3']).
paràmetres-de-cerca obtén: { :fila Sortida escriu: (fila a: ['a']), escriu: (fila a: ['b']), salt-de-línia. }.
