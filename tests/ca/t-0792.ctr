Server init.

>> BD := Maria-DB nou amfitrió: ['localhost'],
	usuari: ['xo'],
	contrasenya: ['pass123'],
	nom-base: ['xobase'],
	connecta.
	
>> SQL := ['SELECT "hello" AS "world" '].

# una manera més ràpida, obté la consulta de la BD:
>> consulta2 := BD consulta: SQL.

# ara no cal establir la BD
consulta2 obtén: { :fila
	Sortida escriu: fila world, salt-de-línia.
}.
