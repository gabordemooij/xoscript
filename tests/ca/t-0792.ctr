Server init.

>> DB := Maria-DB nou amfitrió: ['localhost'],
	usuari: ['xo'],
	contrasenya: ['pass123'],
	nom-base: ['xobase'],
	connecta.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB consulta: SQL.

# now you don't have to set DB
query2 obtén: { :row
	Sortida escriu: row world, salt-de-línia.
}.
