

Llista en: ['sum'] fes: {
	>> total := 0.
	jo cada: { :index :element
		total suma: element.
	}. <- total.
}.

Llista en: ['product'] fes: {
	>> total := 1.
	jo cada: { :index :element
		total multiplica-per: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa gestió-memòria: 0.

{

>> a := Llista ← ['hello'] ; ['world'] ; Cert ; Res ; 666.
a := a + ( Llista ← 1 ).
Sortida escriu: ( ['sum: '] + ( a sum ) ), salt-de-línia.
Sortida escriu: ( ['min: '] + ( a mínim ) ), salt-de-línia.
Sortida escriu: ( ['max: '] + ( a màxim ) ), salt-de-línia.
Sortida escriu: ( ['3rd: '] + ( a ? 2 ) ), salt-de-línia.
Sortida escriu: ( ['prd: '] + ( a product ) ), salt-de-línia.
a ordena: { :a :b <- (b - a). }.
a cada: { :i :e Sortida escriu: ( i - 0 ), salt-de-línia. }.

} inicia.

Programa neteja.
usedMemory1 := (Programa memòria ? 0).


{

>> a := Llista ← ['hello'] ; ['world'] ; Cert ; Res ; 666.
a := a + ( Llista ← 1 ).
Sortida escriu: ( ['sum: '] + ( a sum ) ), salt-de-línia.
Sortida escriu: ( ['min: '] + ( a mínim ) ), salt-de-línia.
Sortida escriu: ( ['max: '] + ( a màxim ) ), salt-de-línia.
Sortida escriu: ( ['3rd: '] + ( a ? 2 ) ), salt-de-línia.
Sortida escriu: ( ['prd: '] + ( a product ) ), salt-de-línia.
a ordena: { :a :b <- (b - a). }.
a cada: { :i :e Sortida escriu: ( i - 0 ), salt-de-línia. }.

} inicia.



Programa neteja.
usedMemory2 := (Programa memòria ? 0).


{

>> a := Llista ← ['hello'] ; ['world'] ; Cert ; Res ; 666.
a := a + ( Llista ← 1 ).
Sortida escriu: ( ['sum: '] + ( a sum ) ), salt-de-línia.
Sortida escriu: ( ['min: '] + ( a mínim ) ), salt-de-línia.
Sortida escriu: ( ['max: '] + ( a màxim ) ), salt-de-línia.
Sortida escriu: ( ['3rd: '] + ( a ? 2 ) ), salt-de-línia.
Sortida escriu: ( ['prd: '] + ( a product ) ), salt-de-línia.
a ordena: { :a :b <- (b - a). }.
a cada: { :i :e Sortida escriu: ( i - 0 ), salt-de-línia. }.

} inicia.



Programa neteja.
usedMemory3 := (Programa memòria ? 0).

( usedMemory1 = usedMemory2 i: usedMemory1 = usedMemory3, i: usedMemory2 = usedMemory3 ) cert: {
	Sortida escriu: ['No memory leaks here'].
}, fals: {
	Sortida escriu: ['Leaking memory...'].
}.
