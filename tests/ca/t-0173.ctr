

Llista en: ['suma'] fes: {
	>> total := 0.
	jo cada: { :índex :element
		total suma: element.
	}. <- total.
}.

Llista en: ['producte'] fes: {
	>> total := 1.
	jo cada: { :índex :element
		total multiplica-per: element.
	}. <- total.
}.

>> memòriaUsada1 := 0.
>> memòriaUsada2 := 0.
>> memòriaUsada3 := 0.
>> memòriaUsada4 := 0.

Programa gestió-memòria: 0.

{

>> a := Llista ← ['hello'] ; ['world'] ; Cert ; Res ; 666.
a := a + ( Llista ← 1 ).
Sortida escriu: ( ['suma: '] + ( a suma ) ), salt-de-línia.
Sortida escriu: ( ['mín: '] + ( a mínim ) ), salt-de-línia.
Sortida escriu: ( ['màx: '] + ( a màxim ) ), salt-de-línia.
Sortida escriu: ( ['3r: '] + ( a ? 2 ) ), salt-de-línia.
Sortida escriu: ( ['prd: '] + ( a producte ) ), salt-de-línia.
a ordena: { :a :b <- (b - a). }.
a cada: { :i :e Sortida escriu: ( i - 0 ), salt-de-línia. }.

} inicia.

Programa neteja.
memòriaUsada1 := (Programa memòria ? 0).


{

>> a := Llista ← ['hello'] ; ['world'] ; Cert ; Res ; 666.
a := a + ( Llista ← 1 ).
Sortida escriu: ( ['suma: '] + ( a suma ) ), salt-de-línia.
Sortida escriu: ( ['mín: '] + ( a mínim ) ), salt-de-línia.
Sortida escriu: ( ['màx: '] + ( a màxim ) ), salt-de-línia.
Sortida escriu: ( ['3r: '] + ( a ? 2 ) ), salt-de-línia.
Sortida escriu: ( ['prd: '] + ( a producte ) ), salt-de-línia.
a ordena: { :a :b <- (b - a). }.
a cada: { :i :e Sortida escriu: ( i - 0 ), salt-de-línia. }.

} inicia.



Programa neteja.
memòriaUsada2 := (Programa memòria ? 0).


{

>> a := Llista ← ['hello'] ; ['world'] ; Cert ; Res ; 666.
a := a + ( Llista ← 1 ).
Sortida escriu: ( ['suma: '] + ( a suma ) ), salt-de-línia.
Sortida escriu: ( ['mín: '] + ( a mínim ) ), salt-de-línia.
Sortida escriu: ( ['màx: '] + ( a màxim ) ), salt-de-línia.
Sortida escriu: ( ['3r: '] + ( a ? 2 ) ), salt-de-línia.
Sortida escriu: ( ['prd: '] + ( a producte ) ), salt-de-línia.
a ordena: { :a :b <- (b - a). }.
a cada: { :i :e Sortida escriu: ( i - 0 ), salt-de-línia. }.

} inicia.



Programa neteja.
memòriaUsada3 := (Programa memòria ? 0).

( memòriaUsada1 = memòriaUsada2 i: memòriaUsada1 = memòriaUsada3, i: memòriaUsada2 = memòriaUsada3 ) cert: {
	Sortida escriu: ['Aquí no hi ha fuites de memòria'].
}, fals: {
	Sortida escriu: ['Perdent memòria...'].
}.
