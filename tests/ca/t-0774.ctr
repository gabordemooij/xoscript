Sortida escriu: ['Objecte de prova'], salt-de-línia.
>> a := Objecte nou. 
a en: ['item:'] fes: { :llst
	propi llst := llst. 
}.
a en: ['article'] fes: {
	<- propi llst.
}.
a item: (
	Llista nou ; 1 ; (
		Llista nou ; ['a'] ; (
			Llista nou ; ( Moment nou: 1 )
		) ; ( Int64 des-de-text: ['321'] )
	)
).
Sortida escriu: a article, salt-de-línia.
>> adreça-antiga-llst := a article prototip adreça-de-memòria.
a save-as: ['/tmp/a.bin'].
Sortida escriu: ['========== RECARREGANT INSTANTÀNIA:'], salt-de-línia.
>> b := Objecte load-from: ['/tmp/a.bin'].
(b article prototip adreça-de-memòria = adreça-antiga-llst) cert: {
	Sortida escriu: ['Enllaç d'objecte reconnectat.'], salt-de-línia.
}.
Sortida escriu: ( b article ), salt-de-línia.
