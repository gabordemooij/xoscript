Sortida escriu: ['Test object'], salt-de-línia.
>> a := Objecte nou. 
a en: ['item:'] fes: { :lst
	propi lst := lst. 
}.
a en: ['item'] fes: { <- propi lst.
}.
a item: (
	Llista nou ; 1 ; (
		Llista nou ; ['a'] ; (
			Llista nou ; ( Moment nou: 1 )
		) ; ( Int64 des-de-text: ['321'] )
	)
).
Sortida escriu: a item, salt-de-línia.
>> old-lst-address := a item prototip adreça-de-memòria.
a save-as: ['/tmp/a.bin'].
Sortida escriu: ['========== RELOADING SNAP:'], salt-de-línia.
>> b := Objecte load-from: ['/tmp/a.bin'].
(b item prototip adreça-de-memòria = old-lst-address) cert: {
	Sortida escriu: ['Object link re-attached.'], salt-de-línia.
}.
Sortida escriu: ( b item ), salt-de-línia.
