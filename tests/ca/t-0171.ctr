

>> memòriaUsada1 := 0.
>> memòriaUsada2 := 0.
>> memòriaUsada3 := 0.
>> memòriaUsada4 := 0.

Programa gestió-memòria: 0.

>> a := Llista ← ['hello'] ; ['world'] ; Cert ; Res ; 666.
a fes treu-últim treu-primer afegeix-al-principi: ['ei'], afegeix-al-final: 999, fet.
Sortida escriu: ( a uneix: [','] ), salt-de-línia.

Programa neteja.
memòriaUsada1 := (Programa memòria ? 0).


a := Llista ← ['hello'] ; ['world'] ; Cert ; Res ; 666.
a treu-últim. a treu-primer. a afegeix-al-principi: ['ei'], afegeix-al-final: 999.
Sortida escriu: ( a uneix: [','] ), salt-de-línia.


Programa neteja.
memòriaUsada2 := (Programa memòria ? 0).


a := Llista ← ['hello'] ; ['world'] ; Cert ; Res ; 666.
a fes treu-últim treu-primer afegeix-al-principi: ['ei'], afegeix-al-final: 999, fet.
Sortida escriu: ( a uneix: [','] ), salt-de-línia.


Programa neteja.
memòriaUsada3 := (Programa memòria ? 0).



( memòriaUsada1 = memòriaUsada2 i: memòriaUsada1 = memòriaUsada3, i: memòriaUsada2 = memòriaUsada3 ) cert: {
	Sortida escriu: ['Aquí no hi ha fuites de memòria'].
}, fals: {
	Sortida escriu: ['Perdent memòria...'].
}.
