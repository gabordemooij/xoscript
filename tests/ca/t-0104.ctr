
{ :i
	Sortida escriu: ['This is step #'] + ( ( i ) + 1 ), salt-de-línia.
} × 6.

{ :i
	Sortida escriu: ['This is step #'] + ( 3 - ( i ) ), salt-de-línia.
} × 6.

{ :i
	Sortida escriu: ['NEVER!'], salt-de-línia.
} × 0.



{ :i
	Sortida escriu: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), salt-de-línia.
} × 11.
