>> usedMemory5 := (Programa memòria ? 0).




(usedMemory1 = usedMemory2 = usedMemory3 = usedMemory4 = usedMemory5) cert: { 
	Sortida escriu: ['Memory usage remains stable.'], salt-de-línia.
}, si-no: {
	Sortida escriu: ['Used memory not stable.'], salt-de-línia.
}.
