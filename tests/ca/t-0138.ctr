

Programa gestió-memòria: 1.

>> x := 0.
>> y := ['Hello'].
>> q := { ['']. }.
>> p := Cert.
>> a := Llista ← 1 ; 2 ; 3 ; 4.
>> c := Objecte nou.
c en: ['greet:'] fes: { Sortida escriu: ['greet!']. }.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.
>> usedMemory5 := 0.

Programa neteja.
>> usedMemory1 := (Programa memòria ? 0).




x := 1.
y := ['Hello'].
q := { ['']. }.
p := Cert.
a := Llista ← 1 ; 2 ; 3 ; 5.
c := Objecte nou.
c en: ['greet:'] fes: { Sortida escriu: ['greet!']. }.


Programa neteja.
>> usedMemory2 := (Programa memòria ? 0).




