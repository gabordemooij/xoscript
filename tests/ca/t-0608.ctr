
>> Size := Objecte nou.
Size en: ['is:'] fes: { :número
	número en: ['+'] fes: { :número
		>> unit := número qualificador.
		>> factor := 1.
		
		unit
		cas: ['inch'] fes: { factor := 0.0833. }. <- jo + (número * factor).
	}. <- número.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Sortida escriu: plank + edge, salt-de-línia.
