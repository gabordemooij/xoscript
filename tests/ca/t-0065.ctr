Número en: ['factorial'] fes: {
	>> total := 1.
	{ :index total multiplica-per: (jo - (index)). } × jo. <- total.
}.
>> Printer := Objecte nou.
Printer en: ['print:and:'] fes: { :x :y
	Sortida escriu: ['a='] + x + [', b='] + y, salt-de-línia.
}.
>> a := 4.5. >> b := a arrodoneix-avall.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a arrodoneix-amunt.
Printer print: a and: b.
a := 4.5. b := a arrodoneix-avall.
Printer print: a and: b.
a := 4.5. b := a arrodoneix.
Printer print: a and: b.
a := 4.2. b := a arrodoneix.
Printer print: a and: b.

Sortida escriu: (9 mòdul: 5), salt-de-línia.
Sortida escriu: -666 absolut, salt-de-línia.
Sortida escriu: 49 arrel-quadrada, salt-de-línia.
Sortida escriu: (2 potència: 3), salt-de-línia.
>> l := (Llista ← 9 ; 6).
Sortida escriu: l mínim.

