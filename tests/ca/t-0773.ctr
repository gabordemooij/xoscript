Sortida escriu: ['Objecte de prova'], salt-de-línia.
>> a := Objecte nou. 
a en: ['item:'] fes: { :int64
	propi int64 := int64. 
}.
a en: ['article'] fes: {
	<- propi int64.
}.
a item: ( Int64 des-de-text: ['9999'] ).
Sortida escriu: a article, salt-de-línia.
>> adreça-antiga-int64 := a article prototip adreça-de-memòria.
a save-as: ['/tmp/a.bin'].
Sortida escriu: ['========== RECARREGANT INSTANTÀNIA:'], salt-de-línia.
>> b := Objecte load-from: ['/tmp/a.bin'].
(b article prototip adreça-de-memòria = adreça-antiga-int64) cert: {
	Sortida escriu: ['Enllaç d'objecte reconnectat.'], salt-de-línia.
}.
Sortida escriu: ( b article ), salt-de-línia.
