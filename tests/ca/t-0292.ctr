>> celler := { <- (	Diccionari nou
		posa: 2 a: ['merlot'],
		posa: 3 a: ['malbec'],
		posa: 4 a: ['syrah']
	).
}.

Sortida escriu: (((celler inicia) - ['res']) compta), salt-de-línia.
Sortida escriu: (((celler inicia) - ['merlot']) compta), salt-de-línia.
Sortida escriu: (((celler inicia) - ['malbec']) compta), salt-de-línia.
Sortida escriu: (((celler inicia) - ['syrah']) compta), salt-de-línia.
Sortida escriu: (((celler inicia) - ['merlot'] - ['malbec']) compta), salt-de-línia.
Sortida escriu: (((celler inicia) - ['merlot'] - ['syrah']) compta), salt-de-línia.
Sortida escriu: (((celler inicia) - ['malbec'] -['syrah']) compta), salt-de-línia.
Sortida escriu: (((celler inicia) - ['malbec'] - ['syrah'] - ['merlot']) compta), salt-de-línia.

