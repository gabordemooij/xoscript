Server init.

# escriu un fitxer de prova
>> f := Fitxer nou: ['/tmp/test.gif'].
f escriu: ['GIF87a01234567810'].

# serveix el fitxer
Server transmet: ['test.gif'] prefix: ['/tmp/'].

Sortida salt-de-línia.

Sortida escriu: ['Fora del contenidor (seguretat):'], salt-de-línia.
{ Server transmet: ['../passwd'] prefix: ['/tmp/']. }
captura: { :e Sortida escriu: e, salt-de-línia. },
inicia.

Sortida escriu: ['Prefix invàlid:'], salt-de-línia.
{ Server transmet: ['test.gif'] prefix: ['z:\\']. }
captura: { :e Sortida escriu: e, salt-de-línia. },
inicia.

Sortida escriu: ['Fitxer inexistent:'], salt-de-línia.
{ Server transmet: ['xxx.xxx'] prefix: ['/tmp/']. }
captura: { :e Sortida escriu: e, salt-de-línia. },
inicia.
