Número en: ['roman'] fes: {
	>> número := jo copia.
	>> roman := [''].
	{
		{
			(número ≥ 1000) cert: {
				roman afegeix-al-final: ['Ⅿ'].
				número resta: 1000.
			}, interromp.
		
			(número ≥ 500) cert: {
				roman afegeix-al-final: ['Ⅾ'].
				número resta: 500.
			}, interromp.
		
			(número ≥ 100) cert: {
				roman afegeix-al-final: ['Ⅽ'].
				número resta: 100.
			}, interromp.
		
			(número ≥ 50) cert: {
				roman afegeix-al-final: ['Ⅼ'].
				número resta: 50.
			}, interromp.
		
			(número ≥ 50) cert: {
				roman afegeix-al-final: ['Ⅼ'].
				número resta: 50.
			}, interromp.
		
			(número ≥ 10) cert: {
				roman afegeix-al-final: ['Ⅹ'].
				número resta: 10.
			}, interromp.
			
			(número ≥ 9) cert: {
				roman afegeix-al-final: ['Ⅸ'].
				número resta: 9.
			}, interromp.
			
			(número ≥ 5) cert: {
				roman afegeix-al-final: ['Ⅴ'].
				número resta: 5.
			}, interromp.
			
			(número ≥ 4) cert: {
				roman afegeix-al-final: ['Ⅳ'].
				número resta: 4.
			}, interromp.
			
			(número ≥ 1) cert: {
				roman afegeix-al-final: ['Ⅰ'].
				número resta: 1.
			}, interromp.
		} procediment.
	} mentre: { <- número > 0. }. <- roman.
}.

Sortida escriu: 1 roman, salt-de-línia.
Sortida escriu: 2 roman, salt-de-línia.
Sortida escriu: 4 roman, salt-de-línia.
Sortida escriu: 8 roman, salt-de-línia.
Sortida escriu: 16 roman, salt-de-línia.
Sortida escriu: 32 roman, salt-de-línia.
Sortida escriu: 64 roman, salt-de-línia.
Sortida escriu: 128 roman, salt-de-línia.
Sortida escriu: 256 roman, salt-de-línia.
Sortida escriu: 1024 roman, salt-de-línia.
