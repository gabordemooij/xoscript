Número en: ['romà'] fes: {
	>> número := jo copia.
	>> romà := [''].
	{
		{
			(número ≥ 1000) cert: {
				romà afegeix-al-final: ['Ⅿ'].
				número resta: 1000.
			}, interromp.
		
			(número ≥ 500) cert: {
				romà afegeix-al-final: ['Ⅾ'].
				número resta: 500.
			}, interromp.
		
			(número ≥ 100) cert: {
				romà afegeix-al-final: ['Ⅽ'].
				número resta: 100.
			}, interromp.
		
			(número ≥ 50) cert: {
				romà afegeix-al-final: ['Ⅼ'].
				número resta: 50.
			}, interromp.
		
			(número ≥ 50) cert: {
				romà afegeix-al-final: ['Ⅼ'].
				número resta: 50.
			}, interromp.
		
			(número ≥ 10) cert: {
				romà afegeix-al-final: ['Ⅹ'].
				número resta: 10.
			}, interromp.
			
			(número ≥ 9) cert: {
				romà afegeix-al-final: ['Ⅸ'].
				número resta: 9.
			}, interromp.
			
			(número ≥ 5) cert: {
				romà afegeix-al-final: ['Ⅴ'].
				número resta: 5.
			}, interromp.
			
			(número ≥ 4) cert: {
				romà afegeix-al-final: ['Ⅳ'].
				número resta: 4.
			}, interromp.
			
			(número ≥ 1) cert: {
				romà afegeix-al-final: ['Ⅰ'].
				número resta: 1.
			}, interromp.
		} procediment.
	} mentre: { <- número > 0. }. <- romà.
}.

Sortida escriu: 1 romà, salt-de-línia.
Sortida escriu: 2 romà, salt-de-línia.
Sortida escriu: 4 romà, salt-de-línia.
Sortida escriu: 8 romà, salt-de-línia.
Sortida escriu: 16 romà, salt-de-línia.
Sortida escriu: 32 romà, salt-de-línia.
Sortida escriu: 64 romà, salt-de-línia.
Sortida escriu: 128 romà, salt-de-línia.
Sortida escriu: 256 romà, salt-de-línia.
Sortida escriu: 1024 romà, salt-de-línia.
