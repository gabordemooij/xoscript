


>> Baralla := Llista nou.
Baralla en: ['imprimeix'] fes: {
        >> len := jo compta - 1.
        { :i
                >> long2 := jo compta - 1.
                Sortida escriu: ['long: '].
                Sortida escriu: len, salt-de-línia.
                Sortida escriu: ['long2: '].
                Sortida escriu: long2, salt-de-línia.
        } × len.
}.

>> d := Baralla ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d imprimeix.
