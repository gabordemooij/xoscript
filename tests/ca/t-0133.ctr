


>> Deck := Llista nou.
Deck en: ['print'] fes: {
        >> len := jo compta - 1.
        { :i
                >> len2 := jo compta - 1.
                Sortida escriu: ['len: '].
                Sortida escriu: len, salt-de-línia.
                Sortida escriu: ['len2: '].
                Sortida escriu: len2, salt-de-línia.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
