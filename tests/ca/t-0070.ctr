>> números := ['1,2,3'] divideix: [','].
Sortida escriu: ['Tinc: '] + números compta + [' números.'],salt-de-línia.
{ :i Sortida escriu: ['number #'] + i + [':'] + (números posició: i), salt-de-línia.} × 3.
>> begudes := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
begudes := begudes divideix: [' Or '].
Sortida escriu: ['Servim'], salt-de-línia.
{ :i Sortida escriu: ['->'] + (begudes posició: i), salt-de-línia. } × (begudes compta).
Sortida escriu: (begudes uneix: [',']), salt-de-línia.
Sortida escriu: (números uneix: ['||']).
