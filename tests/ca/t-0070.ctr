>> numbers := ['1,2,3'] divideix: [','].
Sortida escriu: ['I got: '] + numbers compta + [' numbers.'],salt-de-línia.
{ :i Sortida escriu: ['number #'] + i + [':'] + (numbers posició: i), salt-de-línia.} × 3.
>> beverages := ['Tea Or Coffee Or Milk Or Orange Juice Or Water'].
beverages := beverages divideix: [' Or '].
Sortida escriu: ['We serve'], salt-de-línia.
{ :i Sortida escriu: ['->'] + (beverages posició: i), salt-de-línia. } × (beverages compta).
Sortida escriu: (beverages uneix: [',']), salt-de-línia.
Sortida escriu: (numbers uneix: ['||']).
