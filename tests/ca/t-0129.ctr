
Llista en: ['product'] fes: {
	>> total := 1.
	jo cada: { :index :element
		total multiplica-per: element.
	}. <- total.
}.

>> a := Llista ← 1 ; 2 ; 3.
Sortida escriu: a product, salt-de-línia.
Sortida escriu: (Llista ← 2 ; 4 ; 8) product, salt-de-línia. 
Sortida escriu: (Llista ← -2 ; 10) product, salt-de-línia. 
Sortida escriu: (Llista ← 0.5 ; -2) product, salt-de-línia. 
