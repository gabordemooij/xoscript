
Llista en: ['producte'] fes: {
	>> total := 1.
	jo cada: { :índex :element
		total multiplica-per: element.
	}. <- total.
}.

>> a := Llista ← 1 ; 2 ; 3.
Sortida escriu: a producte, salt-de-línia.
Sortida escriu: (Llista ← 2 ; 4 ; 8) producte, salt-de-línia. 
Sortida escriu: (Llista ← -2 ; 10) producte, salt-de-línia. 
Sortida escriu: (Llista ← 0.5 ; -2) producte, salt-de-línia. 
