

Text en: ['html'] fes: { <- (
		jo
		substitueix: ['&'] per: ['&amp;'],
		substitueix: ['<'] per: ['&lt;'],
		substitueix: ['>'] per: ['&gt;'],
		substitueix: ['"'] per: ['&quot;']
	).
}.


Sortida escriu: ([' left trimmed '] retalla) + [' '] + ( ['and right trimmed'] retalla) + ['!'], salt-de-línia.
Sortida escriu: ['<html>"html & entities"</html>'] html.
