

>> Matryoshka := Objecte nou.
Matryoshka en: ['double:'] fes: { :secret
	propi secret := secret × 2.
}.
Matryoshka en: ['nou:'] fes: { :secret
	>> answer := Res.
	>> t := (secret > 255).
	Sortida escriu: (secret + [' | '] + t), salt-de-línia.
	t cert: {
		answer := secret.
	}, si-no: {
		answer := Matryoshka recursiu nou: (jo double: secret).
	}. <- answer.
}.

>> x := Matryoshka nou: 2.
