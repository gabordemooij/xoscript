

>> Matrioixca := Objecte nou.
Matrioixca en: ['double:'] fes: { :secret
	propi secret := secret × 2.
}.
Matrioixca en: ['nou:'] fes: { :secret
	>> contestació := Res.
	>> t := (secret > 255).
	Sortida escriu: (secret + [' | '] + t), salt-de-línia.
	t cert: {
		contestació := secret.
	}, si-no: {
		contestació := Matrioixca recursiu nou: (jo double: secret).
	}. <- contestació.
}.

>> x := Matrioixca nou: 2.
