
>> Animal := Objecte nou.
Animal en: ['nou'] fes: { <- jo nou init.
}.

Animal en: ['init'] fes: {
	propi sound := ['?'].
	propi legs := 4.
}.

>> Dog := Animal nou.
Dog en: ['init'] fes: {
	jo init.
	propi sound := ['barks'].
}.

Animal en: ['text'] fes: { <- propi legs text + propi sound.
}.

>> poodle := Dog nou.
Sortida escriu: poodle, salt-de-línia.

