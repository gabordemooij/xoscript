
>> Animal := Objecte nou.
Animal en: ['nou'] fes: {
	<- jo nou init.
}.

Animal en: ['init'] fes: {
	propi so := ['?'].
	propi potes  := 4.
}.

>> Gos := Animal nou.
Gos en: ['init'] fes: {
	jo init.
	propi so := ['borda'].
}.

Animal en: ['text'] fes: {
	<- propi potes text + propi so.
}.

>> caniche := Gos nou.
Sortida escriu: caniche, salt-de-línia.

