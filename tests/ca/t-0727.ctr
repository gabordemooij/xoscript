Server init.
>> f := Format nou: ['%d'].
>> a := Blob nou: 4.
a bytes: ( Llista nou ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob nou: 4.
b bytes: ( Llista nou ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a de: 0 longitud: 3, cada: { :i :byte
	Sortida escriu: ( f aplica-enter: byte ) , salt-de-línia.
}.
a ^ b.
a de: 0 longitud: 3, cada: { :i :byte
	Sortida escriu: ( f aplica-enter: byte ) , salt-de-línia.
}.
a ^ b.
a de: 0 longitud: 3, cada: { :i :byte
	Sortida escriu: ( f aplica-enter: byte ) , salt-de-línia.
}.
a allibera.
b allibera.

{ a ^ Objecte. } captura: { :e Sortida escriu: e, salt-de-línia. }, inicia.
