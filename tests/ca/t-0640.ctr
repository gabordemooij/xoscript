
Server init.
Sortida escriu: ['Prova de base de dades'], salt-de-línia.

>> bd := Maria-DB nou amfitrió: ['localhost'],
	usuari: ['xo'], 
	contrasenya: ['pass123'],
	nom-base: ['xobase'],
	connecta.

>> paràmetres-de-cerca :=
bd consulta: ['SELECT UNHEX('CAFE') AS blobby'],
obtén: { :fila
	Sortida escriu: ( fila blobby de: 0 longitud: 2 ), salt-de-línia.
	fila blobby allibera.
}.
