
Server init.
Sortida escriu: ['Database test'], salt-de-línia.

>> db := Maria-DB nou amfitrió: ['localhost'],
	usuari: ['xo'], 
	contrasenya: ['pass123'],
	nom-base: ['xobase'],
	connecta.

>> paràmetres-de-cerca :=
db consulta: ['SELECT UNHEX('CAFE') AS blobby'],
obtén: { :row
	Sortida escriu: ( row blobby de: 0 longitud: 2 ), salt-de-línia.
	row blobby allibera.
}.
