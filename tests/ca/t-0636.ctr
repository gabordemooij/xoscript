# prova d'anàlisi d'URL

Server init.
>> url := URL des-de: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Sortida escriu: ['esquema = '] + url esquema, salt-de-línia.
Sortida escriu: ['amfitrió = '] + url amfitrió, salt-de-línia.
Sortida escriu: ['port = '] + url port, salt-de-línia.
Sortida escriu: ['camí = '] + url camí, salt-de-línia.
Sortida escriu: ['consulta = '] + url paràmetres-de-cerca, salt-de-línia.
Sortida escriu: ['fragment = '] + url fragment, salt-de-línia.
