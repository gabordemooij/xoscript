# test url parsing

Server init.
>> url := URL des-de: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Sortida escriu: ['scheme = '] + url esquema, salt-de-línia.
Sortida escriu: ['host = '] + url amfitrió, salt-de-línia.
Sortida escriu: ['port = '] + url port, salt-de-línia.
Sortida escriu: ['path = '] + url camí, salt-de-línia.
Sortida escriu: ['query = '] + url paràmetres-de-cerca, salt-de-línia.
Sortida escriu: ['fragment = '] + url fragment, salt-de-línia.
