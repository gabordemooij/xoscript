>> items := Diccionari nou.
items posa: ['black'] a: ['coffee'], posa: ['earl grey'] a: ['tea'].
Sortida escriu: (items a: ['coffee']), escriu: (items a: ['tea']).
Sortida escriu: ['there are'] + items compta + [' items in the array.'].
items posa: ['capuccino'] a: ['coffee'].
Sortida escriu: ['Now my coffee is.. '] + (items a: ['coffee']).
items posa: ['aaa'] a: ['1'].
items posa: ['bbb'] a: ['2'].
Sortida escriu: (items a: ['a']).
