>> items := Diccionari nou.
items posa: ['negre'] a: ['coffee'], posa: ['earl grey'] a: ['te'].
Sortida escriu: (items a: ['coffee']), escriu: (items a: ['te']).
Sortida escriu: ['hi ha'] + items compta + [' elements a la llista.'].
items posa: ['capuccino'] a: ['coffee'].
Sortida escriu: ['Ara el meu cafè és.. '] + (items a: ['coffee']).
items posa: ['aaa'] a: ['1'].
items posa: ['bbb'] a: ['2'].
Sortida escriu: (items a: ['a']).
