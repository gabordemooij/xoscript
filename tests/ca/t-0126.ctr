#Linux
>> Xarrup := Objecte nou.

Xarrup en: ['nou'] fes: {
	propi str := [''].
}.

Xarrup en: ['nieuw'] fes: {
	propi str := [''].
}.

Xarrup en: ['respon:'] fes: { :blah
		propi str afegeix-al-final: blah.
}.

Xarrup en: ['respon:i:'] fes: { :blah :blahah
		propi str afegeix-al-final: (blah de: 0 longitud: (blah longitud - 1)).
		propi str afegeix-al-final: [' '].
		propi str afegeix-al-final: blahah.
}.

Xarrup en: ['aconsegueix'] fes: {
	>> búfer := propi str.
	propi str := ['']. <- búfer.
}.


Sortida escriu: (Programa sistema: (Xarrup nou echo: ['Hola, puc escriure a la consola amb una API fluida!'], aconsegueix)).


{ Fitxer nou: ['/tmp/from.txt'], suprimeix. } captura: { ['Buit']. }, inicia.
{ Fitxer nou: ['/tmp/to.txt'], suprimeix. } captura: { ['Buit']. }, inicia.


Fitxer nou: ['/tmp/to.txt'], existeix fals: {
	Sortida escriu: ['Confirmed. Target file does not exist.\
'].
}.
Fitxer nou: ['/tmp/from.txt'], existeix fals: {
	Sortida escriu: ['Confirmed. Source file does not exist.\
'].
}.



Programa sistema: (Xarrup nou touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], aconsegueix).



Programa sistema: (Xarrup nou cp: ['/tmp/from.txt /tmp/to.txt'], aconsegueix).

Fitxer nou: ['/tmp/to.txt'], existeix cert: {
	Sortida escriu: ['Confirmed. Target file has been created by shell.\
'].
}.


Sortida escriu: ['El contingut del fitxer és:'] + (Fitxer nou: ['/tmp/to.txt'], llegeix), salt-de-línia.
