{
	>> a := Llista nou.
	a afegeix-al-final: 1.
	a afegeix-al-final: 2.
	Sortida escriu: (a uneix: [',']), salt-de-línia.
	a posa: 3 a: 2.
	Sortida escriu: (a uneix: [',']), salt-de-línia.
	a posa: 4 a: 10.
	Sortida escriu: (a uneix: [',']), salt-de-línia.
	a treu-primer.
	a treu-primer.
	a treu-primer.
	Sortida escriu: (a uneix: [',']), salt-de-línia.
	a posa: 9 a: 0.
	Sortida escriu: (a uneix: [',']), salt-de-línia.
	a posa: 6 a: -1.
} captura: { :e
	Sortida escriu: ['Uncatched error has occurred.↵'] + e, salt-de-línia.
}, inicia.


