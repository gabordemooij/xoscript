

>> memòriaUsada1 := 0.
>> memòriaUsada2 := 0.
>> memòriaUsada3 := 0.
>> memòriaUsada4 := 0.

Programa gestió-memòria: 0.

{ :i Sortida escriu: i. } × 4.
Sortida salt-de-línia.
{ :i Sortida escriu: (4 - i). } × 4.
Sortida salt-de-línia.
( 1 > 2 ) fals: { Sortida escriu: ['BLOC 1'], salt-de-línia. }.
( 2 > 1 ) cert:  { Sortida escriu: ['BLOC 2'], salt-de-línia. }.

>> i := 0.
{ Sortida escriu: i. i suma: 1. } mentre: { <- ( i < 3). }.
Sortida salt-de-línia.

i := 3.
{ Sortida escriu: i. i := i - 1. } mentre: { <- ( i > 0). }.
Sortida salt-de-línia.


Programa neteja.

memòriaUsada1 := (Programa memòria ? 0).


{ :i  Sortida escriu: i. } × 4.
Sortida salt-de-línia.
{ :i  Sortida escriu: (4 - i). } × 4.
Sortida salt-de-línia.
( 1 > 2 ) fals: { Sortida escriu: ['BLOC 1'], salt-de-línia. }.
( 2 > 1 ) cert:  { Sortida escriu: ['BLOC 2'], salt-de-línia. }.

>> i := 0.
{ Sortida escriu: i. i suma: 1. } mentre: { <- ( i < 3). }.
Sortida salt-de-línia.

i := 3.
{ Sortida escriu: i. i := i - 1. } mentre: { <- ( i > 0). }.
Sortida salt-de-línia.



Programa neteja.
memòriaUsada2 := (Programa memòria ? 0).


{ :i Sortida escriu: i. } × 4.
Sortida salt-de-línia.
{ :i Sortida escriu: (4 - i). } × 4.
Sortida salt-de-línia.
( 1 > 2 ) fals: { Sortida escriu: ['BLOC 1'], salt-de-línia. }.
( 2 > 1 ) cert:  { Sortida escriu: ['BLOC 2'], salt-de-línia. }.

>> i := 0.
{ Sortida escriu: i. i suma: 1. } mentre: { <- ( i < 3). }.
Sortida salt-de-línia.

i := 3.
{ Sortida escriu: i. i := i - 1. } mentre: { <- ( i > 0). }.
Sortida salt-de-línia.

Programa neteja.
memòriaUsada3 := (Programa memòria ? 0).



( memòriaUsada1 = memòriaUsada2 i: memòriaUsada1 = memòriaUsada3, i: memòriaUsada2 = memòriaUsada3 ) cert: {
	Sortida escriu: ['Aquí no hi ha fuites de memòria'].
}, fals: {
	Sortida escriu: ['Perdent memòria...'].
}.
