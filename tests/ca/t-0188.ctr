

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa gestió-memòria: 0.

{ :i Sortida escriu: i. } × 4.
Sortida salt-de-línia.
{ :i Sortida escriu: (4 - i). } × 4.
Sortida salt-de-línia.
( 1 > 2 ) fals: { Sortida escriu: ['BLOCK 1'], salt-de-línia. }.
( 2 > 1 ) cert:  { Sortida escriu: ['BLOCK 2'], salt-de-línia. }.

>> i := 0.
{ Sortida escriu: i. i suma: 1. } mentre: { <- ( i < 3). }.
Sortida salt-de-línia.

i := 3.
{ Sortida escriu: i. i := i - 1. } mentre: { <- ( i > 0). }.
Sortida salt-de-línia.


Programa neteja.

usedMemory1 := (Programa memòria ? 0).


{ :i  Sortida escriu: i. } × 4.
Sortida salt-de-línia.
{ :i  Sortida escriu: (4 - i). } × 4.
Sortida salt-de-línia.
( 1 > 2 ) fals: { Sortida escriu: ['BLOCK 1'], salt-de-línia. }.
( 2 > 1 ) cert:  { Sortida escriu: ['BLOCK 2'], salt-de-línia. }.

>> i := 0.
{ Sortida escriu: i. i suma: 1. } mentre: { <- ( i < 3). }.
Sortida salt-de-línia.

i := 3.
{ Sortida escriu: i. i := i - 1. } mentre: { <- ( i > 0). }.
Sortida salt-de-línia.



Programa neteja.
usedMemory2 := (Programa memòria ? 0).


{ :i Sortida escriu: i. } × 4.
Sortida salt-de-línia.
{ :i Sortida escriu: (4 - i). } × 4.
Sortida salt-de-línia.
( 1 > 2 ) fals: { Sortida escriu: ['BLOCK 1'], salt-de-línia. }.
( 2 > 1 ) cert:  { Sortida escriu: ['BLOCK 2'], salt-de-línia. }.

>> i := 0.
{ Sortida escriu: i. i suma: 1. } mentre: { <- ( i < 3). }.
Sortida salt-de-línia.

i := 3.
{ Sortida escriu: i. i := i - 1. } mentre: { <- ( i > 0). }.
Sortida salt-de-línia.

Programa neteja.
usedMemory3 := (Programa memòria ? 0).



( usedMemory1 = usedMemory2 i: usedMemory1 = usedMemory3, i: usedMemory2 = usedMemory3 ) cert: {
	Sortida escriu: ['No memory leaks here'].
}, fals: {
	Sortida escriu: ['Leaking memory...'].
}.
