>> str := ['write:'].
Sortida missatge: ['escriu:'] arguments: (Llista ← ['Hello World']), salt-de-línia. 

Número en: ['isbetween:and:'] fes: { :a :b <- ((jo ≥ a) i: (jo ≤ b)).
}.

str := ['isbetween:and:'].
Sortida escriu: (3 missatge: str arguments: (Llista ← 2 ; 8)), salt-de-línia.
Sortida escriu: (3 missatge: str arguments: (Llista ← 1 ; 2)), salt-de-línia.


>> CoffeeMachine := Objecte nou.
CoffeeMachine en: ['makeCoffeeWithSugar:milk:'] fes: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Llista ← 4 ; 2.
Sortida escriu: ( CoffeeMachine missatge: order arguments: coffeeConfiguration ), salt-de-línia.
