>> str := ['write:'].
Sortida missatge: ['escriu:'] arguments: (Llista ← ['Hello World']), salt-de-línia. 

Número en: ['isbetween:and:'] fes: { :a :b <- ((jo ≥ a) i: (jo ≤ b)).
}.

str := ['isbetween:and:'].
Sortida escriu: (3 missatge: str arguments: (Llista ← 2 ; 8)), salt-de-línia.
Sortida escriu: (3 missatge: str arguments: (Llista ← 1 ; 2)), salt-de-línia.


>> MàquinaDeCafè := Objecte nou.
MàquinaDeCafè en: ['makeCoffeeWithSugar:milk:'] fes: { :sugar :milk <- ( ['Aquí el tens... cafè amb '] + 
			sugar +
			[' cullerades de sucre i '] +
			milk +
			[' gotes de llet.']
	).
}.

>> comanda := ['makeCoffeeWithSugar:milk:'].
>> configuracióCafè := Llista ← 4 ; 2.
Sortida escriu: ( MàquinaDeCafè missatge: comanda arguments: configuracióCafè ), salt-de-línia.
