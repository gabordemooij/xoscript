>> x := Objecte nou.
>> y := Objecte nou.
>> z := x.
Sortida escriu: (x = z), salt-de-línia.
Sortida escriu: (x = y), salt-de-línia.
Sortida escriu: (x ≠ y), salt-de-línia.
Sortida escriu: (x ≠ z), salt-de-línia.
>> m := Moment nou any: 2070, mes: 11.
>> n := m copia.
Sortida escriu: (m = n), salt-de-línia.
Sortida escriu: (m ≠ n), salt-de-línia.
Sortida escriu: (m igual-a: m), salt-de-línia.
Sortida escriu: (m igual-a: n), salt-de-línia.
n mes: 12.
Sortida escriu: (m ≠ n), salt-de-línia.
Sortida escriu: (m = n), salt-de-línia.


