
>> ciutat := Llista ← ['Londres'] ; ['París'] ; ['Berlín'].
>> temperatura := Llista ← ['15'] ; ['16'] ; ['15'].
>> oratge := temperatura segons: ciutat.
>> ciutats := oratge entrades ordena: { :a :b <- (a compara: b). }.
>> temperatures := oratge valors ordena: { :a :b <- (a compara: b) negatiu?. }.

Sortida escriu: (ciutats uneix: [',']), salt-de-línia.
Sortida escriu: (temperatures uneix: [',']), salt-de-línia.
