
>> city := Llista ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Llista ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature segons: city.
>> cities := weather entrades ordena: { :a :b <- (a compara: b). }.
>> temperatures := weather valors ordena: { :a :b <- (a compara: b) negatiu?. }.

Sortida escriu: (cities uneix: [',']), salt-de-línia.
Sortida escriu: (temperatures uneix: [',']), salt-de-línia.
