Booleà en: ['xor:'] fes: { :a :b <- ((a i: b no) o: (a no i: b)).
}.

>> o := Objecte nou.
o en: ['hello'] fes: { ['Buit']. }.
{ o en: 2 fes: 3.} captura: { :e Sortida escriu: e, salt-de-línia. }, inicia.
{ o en: ['prova'] fes: 3.} captura: { :e Sortida escriu: e, salt-de-línia. }, inicia.
{ o en: ['hello'] fes: { ['Buit']. }.} captura: { :e Sortida escriu: e, salt-de-línia. }, inicia. 
{ >> z := 4 ÷ 0. } captura: { :e Sortida escriu: e, salt-de-línia. }, inicia. 
{ (Cert i: Res) cert: { Sortida escriu: ['X'].}. } captura: { :e Sortida escriu: e, salt-de-línia. }, inicia. 
{ ([''] xor: 0) cert: { Sortida escriu: ['X'].}. } captura: { :e Sortida escriu: e, salt-de-línia. }, inicia. 
{ (1 < ['2']) cert: { Sortida escriu: ['OK']. }. } captura: { :e Sortida escriu: e, salt-de-línia. }, inicia. 
{ (1 < ['2.0']) cert: { Sortida escriu: ['OK']. }. } captura: { :e Sortida escriu: e, salt-de-línia. }, inicia. 
{ (1 < ['x2.0']) cert: { Sortida escriu: ['NO!']. }. } captura: { :e Sortida escriu: e, salt-de-línia. }, inicia. 
{ Sortida escriu: (['hola, OK allà'] de: ['6'] longitud: ['2']). } inicia. 
