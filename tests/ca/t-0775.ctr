Sortida escriu: ['Test object'], salt-de-línia.
>> l := Llista nou ; 1 ; ( Llista nou ; (Moment nou: 1) ; (Int64 des-de-text: ['321']) ; (Llista nou ; 3)).
Sortida escriu: l, salt-de-línia.
>> old-lst-address := l prototip adreça-de-memòria.
l save-as: ['/tmp/a.bin'].
Sortida escriu: ['========== RELOADING SNAP:'], salt-de-línia.
>> b := Objecte load-from: ['/tmp/a.bin'].
(b prototip adreça-de-memòria = old-lst-address) cert: {
	Sortida escriu: ['Object link re-attached.'], salt-de-línia.
}.
Sortida escriu: b, salt-de-línia.
