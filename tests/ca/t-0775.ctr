Sortida escriu: ['Objecte de prova'], salt-de-línia.
>> l := Llista nou ; 1 ; ( Llista nou ; (Moment nou: 1) ; (Int64 des-de-text: ['321']) ; (Llista nou ; 3)).
Sortida escriu: l, salt-de-línia.
>> adreça-antiga-llst := l prototip adreça-de-memòria.
l save-as: ['/tmp/a.bin'].
Sortida escriu: ['========== RECARREGANT INSTANTÀNIA:'], salt-de-línia.
>> b := Objecte load-from: ['/tmp/a.bin'].
(b prototip adreça-de-memòria = adreça-antiga-llst) cert: {
	Sortida escriu: ['Enllaç d'objecte reconnectat.'], salt-de-línia.
}.
Sortida escriu: b, salt-de-línia.
