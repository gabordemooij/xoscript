Text en: ['html'] fes: { <- (
		jo
		substitueix: ['&'] per: ['&amp;'],
		substitueix: ['<'] per: ['&lt;'],
		substitueix: ['>'] per: ['&gt;'],
		substitueix: ['''] per: ['&apos;'],
		substitueix: ['"'] per: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Programa gestió-memòria: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Sortida escriu: txt copia html, salt-de-línia.
Sortida escriu: txt copia minúscules, salt-de-línia.
Sortida escriu: txt copia majúscules, salt-de-línia.
} inicia.

Programa neteja.

usedMemory1 := (Programa memòria ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Sortida escriu: txt copia html, salt-de-línia.
Sortida escriu: txt copia minúscules, salt-de-línia.
Sortida escriu: txt copia majúscules, salt-de-línia.
} inicia.

Programa neteja.
usedMemory2 := (Programa memòria ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Sortida escriu: txt copia html, salt-de-línia.
Sortida escriu: txt copia minúscules, salt-de-línia.
Sortida escriu: txt copia majúscules, salt-de-línia.
} inicia.

Programa neteja.
usedMemory3 := (Programa memòria ? 0).



( usedMemory1 = usedMemory2 i: usedMemory1 = usedMemory3, i: usedMemory2 = usedMemory3 ) cert: {
	Sortida escriu: ['No memory leaks here'].
}, fals: {
	Sortida escriu: ['Leaking memory...'].
}.
