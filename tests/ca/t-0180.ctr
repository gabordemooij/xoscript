Text en: ['html'] fes: { <- (
		jo
		substitueix: ['&'] per: ['&amp;'],
		substitueix: ['<'] per: ['&lt;'],
		substitueix: ['>'] per: ['&gt;'],
		substitueix: ['''] per: ['&apos;'],
		substitueix: ['"'] per: ['&quot;']
	).
}.

>> memòriaUsada1 := 0.
>> memòriaUsada2 := 0.
>> memòriaUsada3 := 0.
>> memòriaUsada4 := 0.

Programa gestió-memòria: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Sortida escriu: txt copia html, salt-de-línia.
Sortida escriu: txt copia minúscules, salt-de-línia.
Sortida escriu: txt copia majúscules, salt-de-línia.
} inicia.

Programa neteja.

memòriaUsada1 := (Programa memòria ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Sortida escriu: txt copia html, salt-de-línia.
Sortida escriu: txt copia minúscules, salt-de-línia.
Sortida escriu: txt copia majúscules, salt-de-línia.
} inicia.

Programa neteja.
memòriaUsada2 := (Programa memòria ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Sortida escriu: txt copia html, salt-de-línia.
Sortida escriu: txt copia minúscules, salt-de-línia.
Sortida escriu: txt copia majúscules, salt-de-línia.
} inicia.

Programa neteja.
memòriaUsada3 := (Programa memòria ? 0).



( memòriaUsada1 = memòriaUsada2 i: memòriaUsada1 = memòriaUsada3, i: memòriaUsada2 = memòriaUsada3 ) cert: {
	Sortida escriu: ['Aquí no hi ha fuites de memòria'].
}, fals: {
	Sortida escriu: ['Perdent memòria...'].
}.
