>> a := 3.
>> b := a copia.
a resta: 1.
Sortida escriu: [' a = '] + a.
Sortida escriu: [' b = '] + b.
a := 3.
b := a + 4.
Sortida escriu: [' a = '] + a.
Sortida escriu: [' b = '] + b.
>> x := 3.
>> y := x copia.
x suma: 10.
y resta: 1.
Sortida escriu: [' x = '] + x.
Sortida escriu: [' y = '] + y.
>> q := Objecte nou.
q en: ['setProperty:'] fes: { :x
	propi prop := x.
}.
q en: ['getProperty'] fes: { <- propi prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Sortida escriu: [' p = '] + (p getProperty).
