#Linux

 >> t := Moment nou.
 
t zona: ['Europe/Amsterdam'].
t any: 2020, mes: 8, dia: 2, hora: 21, minut: 2, segon: 1.

>> a := t hora.
>> ams := t zona.

t zona: ['US/Hawaii'].
>> b := t hora.
>> hw := t zona.

Sortida
escriu: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		o-bé: ['més tard'] o: ['més d'hora']
	)
),
salt-de-línia.
 