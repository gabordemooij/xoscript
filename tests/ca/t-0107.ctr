
Sortida escriu: ['Break for-loop, 0-4.'], salt-de-línia.
{ :i
	Sortida escriu: ['iteration #'] + i, salt-de-línia.
	(i = 4) interromp.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Sortida escriu: ['Break while-true loop, 0-4.'], salt-de-línia.
{
	Sortida escriu: ['iteration #'] + x, salt-de-línia.
	x suma: 1.
	((x < 5) no) interromp.
} mentre: xIsLessThan10.

Sortida escriu: ['Break while-false loop, 5,4.'], salt-de-línia.
{
	Sortida escriu: ['iteration #'] + x, salt-de-línia.
	x resta: 1.
	(x = 3) interromp.
} mentre: { <- (x > 0). }.

Sortida escriu: ['Break times loop, 1-4.'], salt-de-línia.
{ :i
	Sortida escriu: ['iteration #'] + i, salt-de-línia.
	(i = 4) interromp.
} × 5.

Sortida escriu: ['Break block, dont print line.'], salt-de-línia.
{ Cert interromp. Sortida escriu: ['dont write this!'], salt-de-línia. } inicia.

Sortida escriu: ['Break block, dont fire catch...'], salt-de-línia.
{ Cert interromp. Sortida escriu: ['dont write this!'], salt-de-línia. } captura: { Sortida escriu: ['Dont catch this!']. }, inicia.

Sortida escriu: ['Test Array each-loop: 0,1'], salt-de-línia.
(Llista ← 1 ; 2 ; 3) transforma: { :i
	Sortida escriu: ['iteration #'] + i, salt-de-línia.
	(i = 1) interromp.
}.

Sortida escriu: ['Test Map each-loop: c only'], salt-de-línia.
>> m := Diccionari nou.
m posa: ['first'] a: ['a'], posa: ['second'] a: ['b'], posa: ['third'] a: ['c'].
m cada: { :k :v
	Sortida escriu: ['iteration'] + v + k, salt-de-línia.
	Cert interromp.
}.

