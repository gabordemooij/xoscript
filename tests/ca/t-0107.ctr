
Sortida escriu: ['Interromp el bucle for, 0-4.'], salt-de-línia.
{ :i
	Sortida escriu: ['iteration #'] + i, salt-de-línia.
	(i = 4) interromp.
} × 10.

>> x := 0.
>> xÉsMenorQue10 := { <- ( x < 10 ). }.

Sortida escriu: ['Interromp el bucle while-true, 0-4.'], salt-de-línia.
{
	Sortida escriu: ['iteration #'] + x, salt-de-línia.
	x suma: 1.
	((x < 5) no) interromp.
} mentre: xÉsMenorQue10.

Sortida escriu: ['Interromp el bucle while-false, 5,4.'], salt-de-línia.
{
	Sortida escriu: ['iteration #'] + x, salt-de-línia.
	x resta: 1.
	(x = 3) interromp.
} mentre: { <- (x > 0). }.

Sortida escriu: ['Interromp el bucle times, 1-4.'], salt-de-línia.
{ :i
	Sortida escriu: ['iteration #'] + i, salt-de-línia.
	(i = 4) interromp.
} × 5.

Sortida escriu: ['Interromp el bloc, no imprimeixis la línia.'], salt-de-línia.
{ Cert interromp. Sortida escriu: ['no escriguis això!'], salt-de-línia. } inicia.

Sortida escriu: ['Interromp el bloc, no activis la captura...'], salt-de-línia.
{ Cert interromp. Sortida escriu: ['no escriguis això!'], salt-de-línia. } captura: { Sortida escriu: ['No capturis això!']. }, inicia.

Sortida escriu: ['Prova del bucle each de la llista: 0,1'], salt-de-línia.
(Llista ← 1 ; 2 ; 3) transforma: { :i
	Sortida escriu: ['iteration #'] + i, salt-de-línia.
	(i = 1) interromp.
}.

Sortida escriu: ['Prova del bucle each del mapa: només c'], salt-de-línia.
>> m := Diccionari nou.
m posa: ['first'] a: ['a'], posa: ['second'] a: ['b'], posa: ['tercer'] a: ['c'].
m cada: { :k :v
	Sortida escriu: ['iteration'] + v + k, salt-de-línia.
	Cert interromp.
}.

