>> invoice := Objecte nou.
invoice en: ['inicia'] fes: {
        propi número := 0.
}.

invoice en: ['número'] fes: {
        propi número suma: 1. <- propi número copia.
}.

>> year-invoice := invoice nou.
year-invoice en: ['start:'] fes: { :any
	propi número := any.
}.

year-invoice start: 202000.
Sortida escriu: year-invoice número, salt-de-línia.
