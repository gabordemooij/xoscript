>> factura := Objecte nou.
factura en: ['inicia'] fes: {
        propi número := 0.
}.

factura en: ['número'] fes: {
        propi número suma: 1.
        <- propi número copia.
}.

>> factura-anual := factura nou.
factura-anual en: ['start:'] fes: { :any
	propi número := any.
}.

factura-anual start: 202000.
Sortida escriu: factura-anual número, salt-de-línia.
Sortida escriu: factura-anual número, salt-de-línia.
