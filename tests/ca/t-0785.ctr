Sortida escriu: ['Objecte de prova'], salt-de-línia.
>> a := Objecte nou. 

a en: ['item:'] fes: { :instant
	propi instant := instant. 
}.

a en: ['article'] fes: {
	<- propi instant.
}.

>> avui := Llista nou ; ( Moment nou zona: ['CEST'], any: 2026, mes: 7 ).
a item: avui.
Sortida escriu: a article ? 0, salt-de-línia.
a save-as: ['/tmp/a.bin'].
