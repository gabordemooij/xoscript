>> V := Objecte.
V en: ['text'] fes: {
	Sortida escriu: ['conversió'], salt-de-línia.
	<- ['abc'].
}.

Sortida escriu: ( Programa configuració: ['abc'] ), salt-de-línia.

# els paràmetres no s'haurien de recollir pel gc
Programa configuració: ([''] + V nou) valor: ([''] + V nou).

Sortida escriu: ( Programa configuració: ['abc'] ), salt-de-línia.
