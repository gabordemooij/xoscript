
Server init.
Sortida escriu: ['Prova de base de dades'], salt-de-línia.

>> bd := Maria-DB nou amfitrió: ['localhost'],
	usuari: ['xo'], 
	contrasenya: ['pass123'],
	nom-base: ['xobase'],
	connecta.

>> paràmetres-de-cerca :=
bd consulta: ['SELECT REPEAT('Blah',1000) AS blah'], 
obtén: { :fila 
	Sortida escriu: fila blah longitud, salt-de-línia.
}.
