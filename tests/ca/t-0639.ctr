
Server init.
Sortida escriu: ['Database test'], salt-de-línia.

>> db := Maria-DB nou amfitrió: ['localhost'],
	usuari: ['xo'], 
	contrasenya: ['pass123'],
	nom-base: ['xobase'],
	connecta.

>> paràmetres-de-cerca :=
db consulta: ['SELECT REPEAT('Blah',1000) AS blah'], 
obtén: { :row 
	Sortida escriu: row blah longitud, salt-de-línia.
}.
