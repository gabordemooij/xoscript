>> Animal := Objecte nou.
Animal en: ['make'] fes: {
	>> animal := Objecte nou.
	animal en: ['makeSound'] fes: {
		Sortida escriu: propi sound.
	}. <- animal.
}.
>> Cat := Objecte nou.
Cat en: ['make'] fes: {
	>> cat := Animal make.
	cat en: ['init'] fes: {
		propi sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
