

# create a 64-bit integer for exact calculations
>> a := Int64 des-de-text: ['123'].

# to string
Sortida escriu: a, salt-de-línia.

# divide
Sortida escriu: a / (Int64 des-de-text: ['3']), salt-de-línia.

# multiply
Sortida escriu: a * (Int64 des-de-text: ['2']), salt-de-línia.

# add
Sortida escriu: a + (Int64 des-de-text: ['1']), salt-de-línia.

# subtract
Sortida escriu: a - (Int64 des-de-text: ['2']), salt-de-línia.

# compare
Sortida escriu: ( a =   (Int64 des-de-text: ['123'])), salt-de-línia.
Sortida escriu: ( a !=: (Int64 des-de-text: ['124'])), salt-de-línia.
Sortida escriu: ( a <   (Int64 des-de-text: ['124'])), salt-de-línia.
Sortida escriu: ( a >   (Int64 des-de-text: ['122'])), salt-de-línia.
Sortida escriu: ( a >=: (Int64 des-de-text: ['123'])), salt-de-línia.
Sortida escriu: ( a <=: (Int64 des-de-text: ['123'])), salt-de-línia.





	