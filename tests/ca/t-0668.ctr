# descodifica d'utf16le/be o utf32le/be a utf8
Server init.
>> utf16 := Blob nou: 8, bytes: (
	Llista nou ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Sortida escriu: ( utf16 descodifica: ['utf16le'] ), salt-de-línia.

utf16 allibera.
>> utf32 := Blob nou: 13, bytes: (
	Llista nou ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Sortida escriu: ( utf32 descodifica: ['utf32be'] ), salt-de-línia.
utf32 allibera.