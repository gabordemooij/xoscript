

Text en: ['evaluate'] fes: {
	>> codi := Fitxer nou: ['/tmp/eval.ctr'].
	codi escriu: (jo text + ['.']).
	Programa utilitza: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Llista ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q text.
Sortida escriu: x, salt-de-línia.
>> y := Res.
(['y := '] + x ) evaluate.
Sortida escriu: y ? 0, salt-de-línia.

q := Diccionari posa: ['\[''] a: ['\['quote\']'].
x := q text.
Sortida escriu: x, salt-de-línia.
y := Res.
(['y := '] + x ) evaluate.

>> q := (Diccionari nou) posa:['\[''] a:['\['quote\[''].
Sortida escriu: y ? ['\['quote\']'], salt-de-línia.
