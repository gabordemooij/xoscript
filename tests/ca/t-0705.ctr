

>> obj := Objecte nou.

obj en: ['saluda'] fes: {
	<- ['ei'].
}.

# ha de mostrar hi123hi123ok
obj en: ['tasca'] fes: {
	propi propietat := 123.
	{
		# try vincula self/own a l'objecte en lloc del bloc
		Sortida escriu: jo saluda.
		Sortida escriu: propi propietat.
		1 / 0.
	} captura: {
		Sortida escriu: jo saluda.
		Sortida escriu: propi propietat.
		Sortida escriu: ['ok'].
	}, intenta.
}.

obj tasca.