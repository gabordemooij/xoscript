#Linux
>> rellotge := Moment nou.
rellotge zona: ['UTC-1'].
rellotge any: 1981, mes: 1, dia: 5,
      hora: 13, minut: 15, segon: 13.

Sortida escriu: rellotge, salt-de-línia.
rellotge zona: ['UTC+0'].

Sortida escriu: (
	(rellotge any simple) + ['-'] + (rellotge mes) + ['-'] + (rellotge dia) + [' '] +
	(rellotge hora) + [':'] + (rellotge minut) + [':'] + (rellotge segon) + [' '] +
	['W'] + (rellotge setmana) + (rellotge zona)
), salt-de-línia.


rellotge zona: ['UTC-1'].
Sortida escriu: (
	(rellotge any simple) + ['-'] + (rellotge mes) + ['-'] + (rellotge dia) + [' '] +
	(rellotge hora) + [':'] + (rellotge minut) + [':'] + (rellotge segon) + [' '] +
	['W'] + (rellotge setmana) + (rellotge zona)
), salt-de-línia.
