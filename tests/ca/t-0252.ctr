#Linux
>> clock := Moment nou.
clock zona: ['UTC-1'].
clock any: 1981, mes: 1, dia: 5,
      hora: 13, minut: 15, segon: 13.

Sortida escriu: clock, salt-de-línia.
clock zona: ['UTC+0'].

Sortida escriu: (
	(clock any simple) + ['-'] + (clock mes) + ['-'] + (clock dia) + [' '] +
	(clock hora) + [':'] + (clock minut) + [':'] + (clock segon) + [' '] +
	['W'] + (clock setmana) + (clock zona)
), salt-de-línia.


clock zona: ['UTC-1'].
Sortida escriu: (
	(clock any simple) + ['-'] + (clock mes) + ['-'] + (clock dia) + [' '] +
	(clock hora) + [':'] + (clock minut) + [':'] + (clock segon) + [' '] +
	['W'] + (clock setmana) + (clock zona)
), salt-de-línia.
