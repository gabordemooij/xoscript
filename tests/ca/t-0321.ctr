# prova de qualificadors

Programa neteja.

>> Fruita := Objecte nou.
Fruita en: ['nou'] fes: {
	>> f := jo nou.
	f apples: 0. <- f.
}.
Fruita en: ['apples:'] fes: { :a propi pomes := a. }.
Fruita en: ['pomes'] fes: { <- propi pomes. }.
Fruita en: ['+'] fes: { :f
	>> n := Fruita nou.
	n apples: (f pomes + propi pomes). <- n.
}.
Número en: ['pomes'] fes: { <- ((Fruita nou) apples: jo).
}.

Fruita en: ['text'] fes: { <- propi pomes + [' pomes '].
}.

>> q := 3 pomes + 4 pomes.
Sortida escriu: q, salt-de-línia.




q := 3 pomes + 4 pomes.
Sortida escriu: q, salt-de-línia.



q := 3 pomes + 4 pomes.
Sortida escriu: q, salt-de-línia.


