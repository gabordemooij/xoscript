# test qualifiers

Programa neteja.

>> Fruit := Objecte nou.
Fruit en: ['nou'] fes: {
	>> f := jo nou.
	f apples: 0. <- f.
}.
Fruit en: ['apples:'] fes: { :a propi apples := a. }.
Fruit en: ['apples'] fes: { <- propi apples. }.
Fruit en: ['+'] fes: { :f
	>> n := Fruit nou.
	n apples: (f apples + propi apples). <- n.
}.
Número en: ['apples'] fes: { <- ((Fruit nou) apples: jo).
}.

Fruit en: ['text'] fes: { <- propi apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Sortida escriu: q, salt-de-línia.




q := 3 apples + 4 apples.
Sortida escriu: q, salt-de-línia.



q := 3 apples + 4 apples.
Sortida escriu: q, salt-de-línia.


