# a group that is not part of the match must not crash and must keep the group numbers
Server init.
>> show := { :pattern :subject
	>> p := Mamanu fou: pattern.
	p fetaui: subject fai: { :m :g
		Tuuina-atu tusi: g aofaiga, tusi: [' '], tusi: (g tuufaatasi: ['|']), laina-fou. <- m.
	}.
}.
show faʻaaoga: ['(a)|(b)'] ma: ['b'].
show faʻaaoga: ['(a)|(b)'] ma: ['a'].
show faʻaaoga: ['(x)?y'] ma: ['y'].
show faʻaaoga: ['(x)?(y)(z)?'] ma: ['xy'].
