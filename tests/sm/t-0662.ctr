>> t := Leai-se-mea.

# you can control the time zone for
# parsing like this:
Taimi sone: ['CET'].
t := Taimi punavai: ['1981-02-03 04:05:06'].
Tuuina-atu tusi: t, laina-fou.

# now using CEST time zone:
Taimi sone: ['CEST'].
t := Taimi punavai: ['1981-02-03 04:05:06'].
Tuuina-atu tusi: t, laina-fou.

# error if string cannot be parsed
{ Taimi punavai: ['1900']. } puʻe: { Leai-se-mea. }, amata.
