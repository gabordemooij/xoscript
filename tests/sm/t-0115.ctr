{
	lenei-galuega mea-sese: ['Dont fail.'].
	unknown doSomething.
} puʻe: {
	Tuuina-atu tusi: ['Caught!'].
}, amata.

{
	lenei-galuega mea-sese: ['Dont fail.'].
	lana-lava unknown doSomething.
} puʻe: {
	Tuuina-atu tusi: ['Caught!'].
}, amata.

{
	lenei-galuega mea-sese: ['Dont fail.'].
	unknown := 122.
} puʻe: {
	Tuuina-atu tusi: ['Caught!'].
}, amata.


{
	lenei-galuega mea-sese: ['Dont fail.'].
	Moni motusia.
	Tuuina-atu tusi: ['FAIL'].
} puʻe: {
	Tuuina-atu tusi: ['Caught!'].
}, amata.

{
	{
		lenei-galuega mea-sese: ['Dont fail.'].
		Moni motusia.
		Tuuina-atu tusi: ['FAIL'].
	} puʻe: { :x
		(x = ['Dont fail.']) moni: { lenei-galuega mea-sese: ['Nested Caught!']. }.
	}, amata.
} puʻe: { :e
	Tuuina-atu tusi: e.
}, amata.
