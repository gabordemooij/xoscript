Tuuina-atu tusi: ['Test object'], laina-fou.
>> a := Mea fou. 

a pe-a-oo-mai: ['item:'] fai: { :out
	lana-lava out := out. 
}.

a pe-a-oo-mai: ['item'] fai: { <- lana-lava out.
}.

a pe-a-oo-mai: ['greet'] fai: {
	Tuuina-atu tusi: ['hi from original out!'], laina-fou.
}.

a item: Tuuina-atu.

Tuuina-atu tusi: a item, laina-fou.

>> old-out-address := a item faataitaiga-muamua tuatusi-manatua.
a save-as: ['/tmp/a.bin'].
Tuuina-atu tusi: ['========== RELOADING SNAP:'], laina-fou.

>> b := Mea load-from: ['/tmp/a.bin'].

(b item faataitaiga-muamua tuatusi-manatua = old-out-address) moni: {
	Tuuina-atu tusi: ['Object link re-attached.'], laina-fou.
}.

b item tusi: ['hello from loaded out!'], laina-fou.
b greet.
