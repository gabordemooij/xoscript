>> randomizer := { :a :b
	>> aupito-maualalo := ( a < b ) lenei: a po-o-lena: b.
	>> maualuga := ( a > b ) lenei: a po-o-lena: b.
	>> x := Leai-se-mea.
	{
		x := Numera i-le-va-o: a ma: b.
		((x < aupito-maualalo) poʻo: (x > maualuga)) moni: { 
			Tuuina-atu tusi: (['Invalid value!']).
			Polokalama iuga.
		}.
	} 
	× 100. <- x.
}.
randomizer faʻaaoga: 0 ma: 0.
randomizer faʻaaoga: 1 ma: 0.
