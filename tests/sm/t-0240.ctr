# test qualifiers

>> $ := Mea fou.

$ pe-a-oo-mai: ['tali-atu:'] fai: { :x
	
	>> operation := x mataitusi: 0.
	>> valuta := x mataitusi: 1.
	>> money := x faamisi: 2.
	
	>> amount := 0.

	( operation = ['+'] ) moni: {
		( valuta = ['£'] ) moni: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Tuuina-atu tusi: x, laina-fou.


>> Fruit := Mea fou.

Fruit pe-a-oo-mai: ['fou'] fai: {
	>> f := ia-lava fou.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit pe-a-oo-mai: ['apples:'] fai: { :a lana-lava apples := a. }.
Fruit pe-a-oo-mai: ['oranges:'] fai: { :p lana-lava oranges := p. }.
Fruit pe-a-oo-mai: ['apples'] fai: { <- lana-lava apples. }.
Fruit pe-a-oo-mai: ['oranges'] fai: { <- lana-lava oranges. }.

Fruit pe-a-oo-mai: ['+'] fai: { :f
	
	>> n := Fruit fou.
	f faʻaopoopo: 1.
	
	n apples: (f apples + lana-lava apples).
	n oranges:  (f oranges  + lana-lava oranges). <- n.
}.

Fruit pe-a-oo-mai: ['manoa'] fai: { <- ( lana-lava apples manoa + [' apples and '] + lana-lava oranges + [' oranges'] ).
}.

Numera pe-a-oo-mai: ['apples'] fai: { <- ((Fruit fou) apples: ia-lava).
}.

Numera pe-a-oo-mai: ['apple'] fai: { <- ((Fruit fou) apples: ia-lava).
}.

Numera pe-a-oo-mai: ['oranges'] fai: { <- ((Fruit fou) oranges: ia-lava).
}.




Tuuina-atu tusi: (1 apple + 3 oranges + 4 apples), laina-fou.


Manoa pe-a-oo-mai: ['twice'] fai: { <- ((ia-lava manoa) + (ia-lava manoa)).
}.



Tuuina-atu tusi: ['❤❤❤'] twice.



