

Manoa pe-a-oo-mai: ['evaluate'] fai: {
	>> faʻailoga := Faila fou: ['/tmp/eval.ctr'].
	faʻailoga tusi: ia-lava manoa + ['.'].
	Polokalama faʻaoga: ['/tmp/eval.ctr'].
}.

>> a := (Lisi ← (
	(Lomifefiloi fou)
		tuʻu: ['domain'] i: ['mywebsite.com'],
		tuʻu: (Lisi ←
			((Lomifefiloi fou)
				tuʻu: ['home'] i: ['title'],
				tuʻu: ['<html></html>'] i: ['body'],
				tuʻu: ['2017-01-01'] i: ['created']
			) ;
			((Lomifefiloi fou)
				tuʻu: ['aboutus(c)'] i: ['title'],
				tuʻu: ['<credits>Author Inc.</credits>'] i: ['body']
			)
		) i: ['pages']
	)
) manoa.

Tuuina-atu tusi: a ituaiga, laina-fou.
Tuuina-atu tusi: a, laina-fou.

>> b := Leai-se-mea.
(['b := '] + a) evaluate.
Tuuina-atu tusi: b ? 0 ? ['pages'] ? 1 ? ['body'], laina-fou.

>> c := b ? 0.
>> d := c manoa.
Tuuina-atu tusi: d ituaiga, laina-fou.

>> e := Leai-se-mea.
(['e := '] + d) evaluate.
Tuuina-atu tusi: e ? ['pages'] ? 0, laina-fou.
