
Server init.
>> rq := Talosaga-HTTP fou.
Tuuina-atu tusi: ['HTTP-GET d[]=']  + ( rq get-lisi: ['d[]'] ), laina-fou. # GET
Tuuina-atu tusi: ['HTTP-GET f[]=']  + ( rq get-lisi: ['f[]'] ), laina-fou. # GET
Tuuina-atu tusi: ['HTTP-POST e[]='] + ( rq post-lisi: ['e[]'] ), laina-fou. # GET
Tuuina-atu tusi: ['HTTP-POST c=']   + ( rq post: ['c'] ), laina-fou. # GET
Tuuina-atu tusi: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), laina-fou. # GET
