>> invoice := Mea fou.
invoice pe-a-oo-mai: ['amata'] fai: {
        lana-lava numera := 0.
}.

invoice pe-a-oo-mai: ['numera'] fai: {
        lana-lava numera faʻaopoopo: 1. <- lana-lava numera kopi-mea.
}.

>> year-invoice := invoice fou.
year-invoice pe-a-oo-mai: ['start:'] fai: { :tausaga
	lana-lava numera := tausaga.
}.

year-invoice start: 202000.
Tuuina-atu tusi: year-invoice numera, laina-fou.
Tuuina-atu tusi: year-invoice numera, laina-fou.
