>> Point := Mea fou.
Point pe-a-oo-mai: ['x-coordinate:'] fai: { :x lana-lava x := x. }.
Point pe-a-oo-mai: ['y-coordinate:'] fai: { :y lana-lava y := y. }.
Point pe-a-oo-mai: ['x-coordinate']  fai: { <- lana-lava x kopi-mea. }.
Point pe-a-oo-mai: ['y-coordinate']  fai: { <- lana-lava y kopi-mea. }.

Point pe-a-oo-mai: ['='] fai: { :other <- ( lana-lava x = other x-coordinate
		 ma: lana-lava y = other y-coordinate ).
}.

>> pier := Point fou x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point fou x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point fou x-coordinate: 5, y-coordinate: 6.

Tuuina-atu tusi: pier = town-hall, laina-fou.
Tuuina-atu tusi: pier = restaurant, laina-fou.
