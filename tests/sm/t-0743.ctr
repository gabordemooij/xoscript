>> V := Mea.
V pe-a-oo-mai: ['manoa'] fai: {
	Tuuina-atu tusi: ['cast'], laina-fou. <- ['abc'].
}.

Tuuina-atu tusi: ( Polokalama faatulagaga-masini: ['abc'] ), laina-fou.

# params should not get gc'ed
Polokalama faatulagaga-masini: ([''] + V fou) tau: ([''] + V fou).

Tuuina-atu tusi: ( Polokalama faatulagaga-masini: ['abc'] ), laina-fou.
