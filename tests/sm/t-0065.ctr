Numera pe-a-oo-mai: ['factorial'] fai: {
	>> total := 1.
	{ :index total faʻateleina-e: (ia-lava - (index)). } × ia-lava. <- total.
}.
>> Printer := Mea fou.
Printer pe-a-oo-mai: ['print:and:'] fai: { :x :y
	Tuuina-atu tusi: ['a='] + x + [', b='] + y, laina-fou.
}.
>> a := 4.5. >> b := a faʻaitiitia-numera.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a faʻasili-numera.
Printer print: a and: b.
a := 4.5. b := a faʻaitiitia-numera.
Printer print: a and: b.
a := 4.5. b := a faʻalatalata-numera.
Printer print: a and: b.
a := 4.2. b := a faʻalatalata-numera.
Printer print: a and: b.

Tuuina-atu tusi: (9 toega: 5), laina-fou.
Tuuina-atu tusi: -666 tau-atoatoa, laina-fou.
Tuuina-atu tusi: 49 aʻa-sikuea, laina-fou.
Tuuina-atu tusi: (2 mana-o-le-numera: 3), laina-fou.
>> l := (Lisi ← 9 ; 6).
Tuuina-atu tusi: l aupito-maualalo.

