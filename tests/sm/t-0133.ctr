


>> Deck := Lisi fou.
Deck pe-a-oo-mai: ['print'] fai: {
        >> len := ia-lava aofaiga - 1.
        { :i
                >> len2 := ia-lava aofaiga - 1.
                Tuuina-atu tusi: ['len: '].
                Tuuina-atu tusi: len, laina-fou.
                Tuuina-atu tusi: ['len2: '].
                Tuuina-atu tusi: len2, laina-fou.
        } × len.
}.

>> d := Deck ← 1 ; 4 ; 9 ; 16 ; 25 ; 36 ; 49 ; 64 ; 81.
d print.
