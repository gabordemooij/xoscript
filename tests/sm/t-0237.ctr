
Manoa pe-a-oo-mai: ['evaluate'] fai: {
	>> faʻailoga := Faila fou: ['/tmp/eval.ctr'].
	faʻailoga tusi: (ia-lava manoa + ['.']).
	Polokalama faʻaoga: ['/tmp/eval.ctr'].
}.

>> map :=
	(Lomifefiloi fou)
	tuʻu: ['Hi There'] i: ['two'],
	tuʻu: (Lisi ← ['hello'] ; ['world'] ; (Lisi ← 1 ; 2; 9) ; Sese) i: ['one'],
	tuʻu: ( (Lomifefiloi fou) tuʻu: ['wrrld'] i: ['misspelled'] ) i: ['three'],
	tuʻu: (Lisi ← ((Lomifefiloi fou) tuʻu: ['treasure'] i: ['hidden']) ; 2) i: ['four']. 
>> str := map manoa.
>> map2 := Leai-se-mea.
(['map2 := '] + str ) evaluate.
Tuuina-atu tusi: map2 ? ['one'] ? 0.
Tuuina-atu tusi: map2 ? ['one'] ? 1.
Tuuina-atu tusi: map2 ? ['four'] ? 0 ? ['hidden'].
Tuuina-atu tusi: map2 ? ['one'] ? 2 ? 2.
