Server init.
Tuuina-atu tusi: ['Database time test'], laina-fou.

>> db := Maria-DB fou talimalo: ['localhost'],
	igoa-tagata-faaaoga: ['xo'], 
	upu-faataga: ['pass123'],
	igoa-faaputuga-faamatalaga: ['xobase'],
	fesootai-atu.

>> mea-suesue :=
db fesili-faamatalaga: ['SELECT CAST('07:08:09' AS TIME) AS timetest'],
aumai: { :row
	Tuuina-atu tusi: row timetest, laina-fou.
}.
