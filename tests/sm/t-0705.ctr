

>> obj := Mea fou.

obj pe-a-oo-mai: ['greet'] fai: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj pe-a-oo-mai: ['task'] fai: {
	lana-lava property := 123.
	{
		# try binds self/own to object instead of block
		Tuuina-atu tusi: ia-lava greet.
		Tuuina-atu tusi: lana-lava property.
		1 / 0.
	} puʻe: {
		Tuuina-atu tusi: ia-lava greet.
		Tuuina-atu tusi: lana-lava property.
		Tuuina-atu tusi: ['ok'].
	}, taumafai.
}.

obj task.