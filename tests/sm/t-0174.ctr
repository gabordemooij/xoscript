


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Polokalama pulega-manatua: 0.
>> palette := Leai-se-mea.
>> colors := Leai-se-mea.

{
palette := Lomifefiloi fou.
palette 
	tuʻu: ['#F00'] i: ['red'],
	tuʻu: ['#0F0'] i: ['green'],
	tuʻu: ['#00F'] i: ['blue'].
Tuuina-atu tusi: ['number of RGB codes in palette: '] + ( palette aofaiga ), laina-fou.
Tuuina-atu tusi: ['RGB code of green is: '] + ( palette ? ['green'] ), laina-fou.
colors := [''].
( palette taʻitasi: { :igoa :faʻailoga
		colors := colors + ( igoa + [':'] + faʻailoga ).
} ).
Tuuina-atu tusi: ['All colors in palette: '] + colors, laina-fou.
} amata.
Polokalama faamama.
usedMemory1 := (Polokalama manatua-masini ? 0).

{
palette := Lomifefiloi fou.
palette 
	tuʻu: ['#F00'] i: ['red'],
	tuʻu: ['#0F0'] i: ['green'],
	tuʻu: ['#00F'] i: ['blue'].
Tuuina-atu tusi: ['number of RGB codes in palette: '] + ( palette aofaiga ), laina-fou.
Tuuina-atu tusi: ['RGB code of green is: '] + ( palette ? ['green'] ), laina-fou.
colors := [''].
( palette taʻitasi: { :igoa :faʻailoga
		colors := colors + ( igoa + [':'] + faʻailoga ).
} ).
Tuuina-atu tusi: ['All colors in palette: '] + colors, laina-fou.
} amata.
Polokalama faamama.
usedMemory2 := (Polokalama manatua-masini ? 0).

{
palette := Lomifefiloi fou.
palette 
	tuʻu: ['#F00'] i: ['red'],
	tuʻu: ['#0F0'] i: ['green'],
	tuʻu: ['#00F'] i: ['blue'].
Tuuina-atu tusi: ['number of RGB codes in palette: '] + ( palette aofaiga ), laina-fou.
Tuuina-atu tusi: ['RGB code of green is: '] + ( palette ? ['green'] ), laina-fou.
colors := [''].
( palette taʻitasi: { :igoa :faʻailoga
		colors := colors + ( igoa + [':'] + faʻailoga ).
} ).
Tuuina-atu tusi: ['All colors in palette: '] + colors, laina-fou.
} amata.
Polokalama faamama.
usedMemory3 := (Polokalama manatua-masini ? 0).



( usedMemory1 = usedMemory2 ma: usedMemory1 = usedMemory3, ma: usedMemory2 = usedMemory3 ) moni: {
	Tuuina-atu tusi: ['No memory leaks here'].
}, sese: {
	Tuuina-atu tusi: ['Leaking memory...'].
}.
