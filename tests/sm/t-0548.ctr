Server init.

>> x := Blob fou: 65 ituaiga: ['char'].
# for this test you need set a path to libc (puts)
>> libname := Polokalama faatulagaga-masini: ['FFITESTLIB'].
Server fesootai: (
 Lisi fou ;
 libname ;
 ['putchar'] ;
 ( Lisi fou ; ['char'] ) ;
 ['void'] ;
 ['Print'] ;
 ['char:']
).
Print char: (x amata: 0 umi: 1), laina-fou.
x faasaoloto.

