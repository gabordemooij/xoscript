>> Greeter := Mea fou.
Greeter pe-a-oo-mai: ['make'] fai: {
	>> greeter := Mea fou.
	greeter pe-a-oo-mai: ['name:'] fai: { :igoa
		Tuuina-atu tusi: ['setting a name'].
		lana-lava myName := igoa.
	}.
	greeter pe-a-oo-mai: ['performGreeting'] fai: {
		Tuuina-atu tusi: ['Hello'].
		Tuuina-atu tusi: lana-lava myName.
	}.
	greeter pe-a-oo-mai: ['greet'] fai: {
		ia-lava performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
