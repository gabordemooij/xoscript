# using FFI with the Server plugin

# connect to libc (platform specific)
>> libname := Polokalama faatulagaga-masini: ['FFITESTLIB'].

# link stdio functions from c for advances file operations
Server fesootai: ( Lisi fou ;
 libname ; ['fopen'] ;
 ( Lisi fou ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
fesootai: ( Lisi fou ;
 Leai-se-mea ; # means same lib
 ['fread'] ;
 ( Lisi fou ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Leai-se-mea ; # means same object (i.e. Stream)
 ['fread']
),
fesootai: (
 Lisi fou ;
 Leai-se-mea ; # means same lib
 ['fwrite'] ;
 ( Lisi fou ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Leai-se-mea ; # means same lib
 ['fwrite']
),
fesootai: (
 Lisi fou ;
 Leai-se-mea ; # means same lib
 ['rewind'] ;
 ( Lisi fou ; ['pointer'] ) ;
 ['int'] ;
 Leai-se-mea ; # means same lib
 ['rewind:']
).

>> str := Blob utf8: ['abc123'].
>> ala-faila := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# open a file with fopen(path, mode)
>> fd := Stream path: ala-faila mode: mode.

# write bytes from buffer str to file
>> bytes-written := Stream feʻau: ['fwrite'] mea-tuuina: (Lisi fou ; str ; 1 ; 6 ; fd ).
Tuuina-atu tusi: bytes-written, laina-fou.

# rewind file pointer
Stream rewind: fd.

# allocate a buffer
>> buf := Blob fou: 20.

# read from file
>> bytes-read := Stream feʻau: ['fread'] mea-tuuina: (Lisi fou ; buf ; 1 ; 6 ; fd ).
Tuuina-atu tusi: bytes-read, laina-fou.
Tuuina-atu tusi: buf, laina-fou.

# free memory
str  faasaoloto.
ala-faila faasaoloto.
mode faasaoloto.
buf  faasaoloto.


