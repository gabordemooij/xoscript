Numera pe-a-oo-mai: ['roman'] fai: {
	>> numera := ia-lava kopi-mea.
	>> roman := [''].
	{
		{
			(numera ≥ 1000) moni: {
				roman faaopoopo-i-le-iuga: ['Ⅿ'].
				numera toesea: 1000.
			}, motusia.
		
			(numera ≥ 500) moni: {
				roman faaopoopo-i-le-iuga: ['Ⅾ'].
				numera toesea: 500.
			}, motusia.
		
			(numera ≥ 100) moni: {
				roman faaopoopo-i-le-iuga: ['Ⅽ'].
				numera toesea: 100.
			}, motusia.
		
			(numera ≥ 50) moni: {
				roman faaopoopo-i-le-iuga: ['Ⅼ'].
				numera toesea: 50.
			}, motusia.
		
			(numera ≥ 50) moni: {
				roman faaopoopo-i-le-iuga: ['Ⅼ'].
				numera toesea: 50.
			}, motusia.
		
			(numera ≥ 10) moni: {
				roman faaopoopo-i-le-iuga: ['Ⅹ'].
				numera toesea: 10.
			}, motusia.
			
			(numera ≥ 9) moni: {
				roman faaopoopo-i-le-iuga: ['Ⅸ'].
				numera toesea: 9.
			}, motusia.
			
			(numera ≥ 5) moni: {
				roman faaopoopo-i-le-iuga: ['Ⅴ'].
				numera toesea: 5.
			}, motusia.
			
			(numera ≥ 4) moni: {
				roman faaopoopo-i-le-iuga: ['Ⅳ'].
				numera toesea: 4.
			}, motusia.
			
			(numera ≥ 1) moni: {
				roman faaopoopo-i-le-iuga: ['Ⅰ'].
				numera toesea: 1.
			}, motusia.
		} faiga.
	} ao: { <- numera > 0. }. <- roman.
}.

Tuuina-atu tusi: 1 roman, laina-fou.
Tuuina-atu tusi: 2 roman, laina-fou.
Tuuina-atu tusi: 4 roman, laina-fou.
Tuuina-atu tusi: 8 roman, laina-fou.
Tuuina-atu tusi: 16 roman, laina-fou.
Tuuina-atu tusi: 32 roman, laina-fou.
Tuuina-atu tusi: 64 roman, laina-fou.
Tuuina-atu tusi: 128 roman, laina-fou.
Tuuina-atu tusi: 256 roman, laina-fou.
Tuuina-atu tusi: 1024 roman, laina-fou.
