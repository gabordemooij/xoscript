Lisi pe-a-oo-mai: ['kopi-mea'] fai: {
	>> kopi-mea := Lisi fou.
	ia-lava taʻitasi: { :numera :section
		kopi-mea faaopoopo-i-le-iuga: section valaau-ia-lava kopi-mea.
	}. <- kopi-mea.
}.

>> sheep := Lisi fou ; ['Dolly'] ; ['Shaun']. 
>> clones := sheep kopi-mea.
clones taʻitasi: { :numera :sheep
	sheep faaopoopo-i-le-iuga: ['2'].
}.

Tuuina-atu tusi: sheep, laina-fou.
Tuuina-atu tusi: clones, laina-fou.
