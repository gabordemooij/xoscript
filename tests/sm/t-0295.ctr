
>> dictionary := (
	Lomifefiloi fou
		tuʻu: ['b'] i: ['a'],
		tuʻu: ['a'] i: ['b'],
		tuʻu: ['z'] i: ['x'],
		tuʻu: ['hello'] i: ['hallo'],
		tuʻu: ['human'] i: ['human']
).

>> comparisons := Lisi fou.
dictionary taʻitasi: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a faatusatusa: b)
	).
}.

comparisons faasologa: { :a :b <- ( a faatusatusa: b ). }.
Tuuina-atu tusi: ( comparisons tuufaatasi: ['↵'] ), laina-fou.
comparisons tuufaatasi: ['↵'].
