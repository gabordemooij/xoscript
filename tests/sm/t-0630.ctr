#regex test
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> pattern := Mamanu fou: ['href="([^"]+)" target="([^"]+)"'].
>> result := pattern fetaui: subject fai: { :m :x
	Tuuina-atu tusi: m, laina-fou.
	Tuuina-atu tusi: x, laina-fou. <- ['XXX'].
}.
Tuuina-atu tusi: result, laina-fou.