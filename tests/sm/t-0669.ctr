# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Pusa-malu 
	hash-upu-faataga: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Pusa-malu 
	hash-upu-faataga: hash faamaonia: a1.
	# fail 
>> b := Pusa-malu
	hash-upu-faataga: hash faamaonia: a2.
	# ok!

Tuuina-atu tusi: a, laina-fou.
Tuuina-atu tusi: b, laina-fou.

