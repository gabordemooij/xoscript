Server init.

Tuuina-atu tusi: (
	Mamanu fou: ['^\\w+$'],
	fetaui: ['test@example.com'] 
), laina-fou. # 0 match, fails on @ and .

Tuuina-atu tusi: (
	Mamanu fou: ['^[^@]+@[^\.]+\.\\w+$'],
	fetaui: ['test@example.com'] 
), laina-fou. # 1 match

Tuuina-atu tusi: (
	Mamanu fou: ['[^@]+@[^\.]+\.\\w+'],
	fetaui: ['test@example.com'] 
), laina-fou. # 1 match

Tuuina-atu tusi: (
	Mamanu fou: ['([^@]+)@([^\.]+)\.\\w+'],
	fetaui: ['test@example.com'] 
), laina-fou. # 1 match, groups dont matter

Tuuina-atu tusi: (
	Mamanu fou: ['[a-z]'],
	fetaui: ['test@example.com'] 
), laina-fou. # 14 matches

Tuuina-atu tusi: (
	Mamanu fou: ['.*'],
	fetaui: ['test@example.com'] 
), laina-fou. # 1 match (all)

Tuuina-atu tusi: (
	Mamanu fou: ['(.*)'],
	fetaui: ['test@example.com'] 
), laina-fou. # 1 match (all)

Tuuina-atu tusi: (
	Mamanu fou: ['\\s*[^@]+@[^\.]+\.\\w+'],
	fetaui: ['test@example.com'] 
), laina-fou. # 1 match, prefix space optional, gets ignored