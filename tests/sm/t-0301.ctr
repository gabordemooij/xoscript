


>> wine := Mea fou.


wine pe-a-oo-mai: ['toString'] fai: { <- ['merlot'].
}.

wine pe-a-oo-mai: ['naarTekst'] fai: { <- ['merlot'].
}.


wine pe-a-oo-mai: ['='] fai: { :other wine <- ( ia-lava toString = other wine ).
}.

wine pe-a-oo-mai: ['=='] fai: { :other wine <- ( ia-lava toString = other wine ).
}.



wine
	mataupu: ['cabernet'] fai: { Tuuina-atu tusi: ['it's a Cabernet!']. },
	mataupu: ['syrah']    fai: { Tuuina-atu tusi: ['it's a Syrah!'].    },
	mataupu: ['merlot']   fai: { Tuuina-atu tusi: ['it's a Merlot!'].   },
	mataupu: ['malbec']   fai: { Tuuina-atu tusi: ['it's a Malbec!'].   }.

Tuuina-atu laina-fou.
