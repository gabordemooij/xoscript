

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Polokalama pulega-manatua: 0.

{ :i Tuuina-atu tusi: i. } × 4.
Tuuina-atu laina-fou.
{ :i Tuuina-atu tusi: (4 - i). } × 4.
Tuuina-atu laina-fou.
( 1 > 2 ) sese: { Tuuina-atu tusi: ['BLOCK 1'], laina-fou. }.
( 2 > 1 ) moni:  { Tuuina-atu tusi: ['BLOCK 2'], laina-fou. }.

>> i := 0.
{ Tuuina-atu tusi: i. i faʻaopoopo: 1. } ao: { <- ( i < 3). }.
Tuuina-atu laina-fou.

i := 3.
{ Tuuina-atu tusi: i. i := i - 1. } ao: { <- ( i > 0). }.
Tuuina-atu laina-fou.


Polokalama faamama.

usedMemory1 := (Polokalama manatua-masini ? 0).


{ :i  Tuuina-atu tusi: i. } × 4.
Tuuina-atu laina-fou.
{ :i  Tuuina-atu tusi: (4 - i). } × 4.
Tuuina-atu laina-fou.
( 1 > 2 ) sese: { Tuuina-atu tusi: ['BLOCK 1'], laina-fou. }.
( 2 > 1 ) moni:  { Tuuina-atu tusi: ['BLOCK 2'], laina-fou. }.

