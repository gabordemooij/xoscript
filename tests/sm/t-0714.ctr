>> a := Mea fou. 
a pe-a-oo-mai: ['greet'] fai: { Tuuina-atu tusi: ['welcome!'], laina-fou. }.
a pe-a-oo-mai: ['greet2'] fai: { Tuuina-atu tusi: ['welcome2!'], laina-fou. }.
a save-as: ['/tmp/a.bin'].

Tuuina-atu tusi: ['========== RELOADING SNAP:'], laina-fou.
>> b := Mea load-from: ['/tmp/a.bin'].
b greet2.