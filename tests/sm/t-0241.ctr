

Manoa pe-a-oo-mai: ['evaluate'] fai: {
	>> faʻailoga := Faila fou: ['/tmp/eval.ctr'].
	faʻailoga tusi: (ia-lava manoa + ['.']).
	Polokalama faʻaoga: ['/tmp/eval.ctr'].
}.

>> Q := ['\[' \']'].

>> q := Lisi ← (['Quotes '] + Q + [' are evil?']) ; 1.
>> x := q manoa.
Tuuina-atu tusi: x, laina-fou.
>> y := Leai-se-mea.
(['y := '] + x ) evaluate.
Tuuina-atu tusi: y ? 0, laina-fou.

q := Lomifefiloi tuʻu: ['\[''] i: ['\['quote\']'].
x := q manoa.
Tuuina-atu tusi: x, laina-fou.
y := Leai-se-mea.
(['y := '] + x ) evaluate.

>> q := (Lomifefiloi fou) tuʻu:['\[''] i:['\['quote\[''].
Tuuina-atu tusi: y ? ['\['quote\']'], laina-fou.
