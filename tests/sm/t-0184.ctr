

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Polokalama pulega-manatua: 0.

Numera pe-a-oo-mai: ['addNum:'] fai: { :x
	ia-lava faʻaopoopo: x.
}.

Numera pe-a-oo-mai: ['subtractNum:'] fai: { :x
	ia-lava toesea: x.
}.

Numera pe-a-oo-mai: ['multiplyBy:'] fai: { :x
	ia-lava faʻateleina-e: x.
}.

Numera pe-a-oo-mai: ['divideBy:'] fai: { :x
	ia-lava vaevaeina-e: x.
}.


>> a := 1.
a := a + 1.
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 mana-o-le-numera: 8).  
a := a + (2 mana-o-le-numera: -1). 
a := a + (49 aʻa-sikuea).   
a addNum: ((Lisi ← 0 ; 1) maualuga).          
a addNum: ((Lisi ← 2 ; 3) aupito-maualalo).
Tuuina-atu tusi: a.

Polokalama faamama.

usedMemory1 := (Polokalama manatua-masini ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 mana-o-le-numera: 8).  
a := a + (2 mana-o-le-numera: -1). 
a := a + (49 aʻa-sikuea).   
a addNum: ((Lisi ← 0 ; 1) maualuga).          
a addNum: ((Lisi ← 2 ; 3) aupito-maualalo).
Tuuina-atu tusi: a.

Polokalama faamama.
usedMemory2 := (Polokalama manatua-masini ? 0).


a := 1.
a := a + 1.       
a addNum: 3.         
a := a - 1.       
a subtractNum: -0.5. 
a := a × 2.       
a divideBy: 3.    
a := a ÷ 0.1.     
a := a - -1.      
a multiplyBy: 0.5.
a := a + (2 mana-o-le-numera: 8).  
a := a + (2 mana-o-le-numera: -1). 
a := a + (49 aʻa-sikuea).   
a addNum: ((Lisi ← 0 ; 1) maualuga).          
a addNum: ((Lisi ← 2 ; 3) aupito-maualalo).
Tuuina-atu tusi: a.

Polokalama faamama.
usedMemory3 := (Polokalama manatua-masini ? 0).



( usedMemory1 = usedMemory2 ma: usedMemory1 = usedMemory3, ma: usedMemory2 = usedMemory3 ) moni: {
	Tuuina-atu tusi: ['No memory leaks here'].
}, sese: {
	Tuuina-atu tusi: ['Leaking memory...'].
}.
