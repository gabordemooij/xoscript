#OBSD
>> dirname := [''].
{ dirname faaopoopo-i-le-iuga: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Polokalama faiga-masini: command.
Polokalama chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename faaopoopo-i-le-iuga: ['YYYYYYYY']. } * 20.
Faila fou: filename, tusi: ['sometext'].
{ Faila lisi: ['/tmp/'] + dirname. } * 1000.
Tuuina-atu tusi: ['no crash'], laina-fou.

