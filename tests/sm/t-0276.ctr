>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Mea fou.
⚄ pe-a-oo-mai: ['drawFrom:length:'] fai: { :pool :aofaiga
	
	>> result := [''].
	
	{
		>> index := Numera random % (pool umi).
		result faaopoopo-i-le-iuga: ( pool mataitusi: (index + 1) ).
		
	} × aofaiga. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? umi.
Tuuina-atu tusi: (['x↵'] x random umi).
Tuuina-atu tusi: (['y↵'] y ?? umi).

