# happy flow
>> s := ['hello;"""world"""\n"of";"c\ns\nv"'].
>> ala-faila := ['/tmp/dat.csv'].
>> csv := Faila fou: ala-faila.
csv tusi: s.

# accepts CRLF LF CR, varying row length
csv vaeluaga: [';'] faailoga-upusii: ['"'] laina-uma: { :line
	Polokalama faamama.
	Tuuina-atu tusi: line, laina-fou.
	Polokalama faamama.
}.

# unequal lines
s faaopoopo-i-le-iuga: ['\njustone'].
csv tusi: s.
{
	csv vaeluaga: [';'] faailoga-upusii: ['"'] laina-uma: { :line
		Tuuina-atu tusi: line, laina-fou.
	}.
} puʻe: { :e 
	Tuuina-atu tusi: e, laina-fou.
}, amata.

# invalid format
s := ['"he"llo";world'].
csv tusi: s.
{
	csv vaeluaga: [';'] faailoga-upusii: ['"'] laina-uma: { :line
		Tuuina-atu tusi: line, laina-fou.
	}.
} puʻe: { :e 
	Tuuina-atu tusi: e, laina-fou.
}, amata.
