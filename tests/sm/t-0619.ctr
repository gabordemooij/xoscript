>> HTML := Mea fou.
HTML pe-a-oo-mai: ['tali-atu:'] fai: { :tag 
	Tuuina-atu tusi: (['<tag>'] tag: tag), laina-fou.
}.
HTML pe-a-oo-mai: ['tali-atu:ma:'] fai: { :tag :html 
	Tuuina-atu tusi: (
		['<tag>innerHTML</tag>']
		tag: tag - [':'],
		innerHTML: html
	), laina-fou.
}.
>> html := HTML fou.
html body h1: ['header'].

