Tuuina-atu tusi: ['Test object'], laina-fou.
>> a := Mea fou. 

a pe-a-oo-mai: ['item:'] fai: { :moment
	lana-lava moment := moment. 
}.

a pe-a-oo-mai: ['item'] fai: { <- lana-lava moment.
}.

>> today := Lisi fou ; ( Taimi fou sone: ['CEST'], tausaga: 2026, masina: 7 ).
a item: today.
Tuuina-atu tusi: a item ? 0, laina-fou.
a save-as: ['/tmp/a.bin'].
