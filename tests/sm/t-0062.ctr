Moni-pe-sese pe-a-oo-mai: ['xor:'] fai: { :a :b <- ((a ma: b faʻafeagai) poʻo: (a faʻafeagai ma: b)).
}.

>> o := Mea fou.
o pe-a-oo-mai: ['hello'] fai: { ['Empty']. }.
{ o pe-a-oo-mai: 2 fai: 3.} puʻe: { :e Tuuina-atu tusi: e, laina-fou. }, amata.
{ o pe-a-oo-mai: ['suega'] fai: 3.} puʻe: { :e Tuuina-atu tusi: e, laina-fou. }, amata.
{ o pe-a-oo-mai: ['hello'] fai: { ['Empty']. }.} puʻe: { :e Tuuina-atu tusi: e, laina-fou. }, amata. 
{ >> z := 4 ÷ 0. } puʻe: { :e Tuuina-atu tusi: e, laina-fou. }, amata. 
{ (Moni ma: Leai-se-mea) moni: { Tuuina-atu tusi: ['X'].}. } puʻe: { :e Tuuina-atu tusi: e, laina-fou. }, amata. 
{ ([''] xor: 0) moni: { Tuuina-atu tusi: ['X'].}. } puʻe: { :e Tuuina-atu tusi: e, laina-fou. }, amata. 
{ (1 < ['2']) moni: { Tuuina-atu tusi: ['OK']. }. } puʻe: { :e Tuuina-atu tusi: e, laina-fou. }, amata. 
{ (1 < ['2.0']) moni: { Tuuina-atu tusi: ['OK']. }. } puʻe: { :e Tuuina-atu tusi: e, laina-fou. }, amata. 
{ (1 < ['x2.0']) moni: { Tuuina-atu tusi: ['NO!']. }. } puʻe: { :e Tuuina-atu tusi: e, laina-fou. }, amata. 
{ Tuuina-atu tusi: (['hello OK there'] amata: ['6'] umi: ['2']). } amata. 
