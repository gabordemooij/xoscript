Tuuina-atu tusi: ['Test object'], laina-fou.
>> cmd := Poloaiga fou.
Tuuina-atu tusi: cmd ls /tmp, laina-fou.
>> old-cmd-address := cmd faataitaiga-muamua tuatusi-manatua.
cmd save-as: ['/tmp/a.bin'].
Tuuina-atu tusi: ['========== RELOADING SNAP:'], laina-fou.
>> b := Mea load-from: ['/tmp/a.bin'].
(b faataitaiga-muamua tuatusi-manatua = old-cmd-address) moni: {
	Tuuina-atu tusi: ['Object link re-attached.'], laina-fou.
}.
Tuuina-atu tusi: b ls, laina-fou.


