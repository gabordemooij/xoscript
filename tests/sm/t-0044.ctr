>> list := Lisi fou.
list ~ ['hello'].
Tuuina-atu tusi: list aofaiga.
list faaopoopo-i-le-iuga: ['world'].
Tuuina-atu tusi: list aofaiga.
Tuuina-atu tusi: list aveese-mulimuli, tusi: list aofaiga.
list faaopoopo-i-le-iuga: ['there'].
Tuuina-atu tusi: list aofaiga.
Tuuina-atu tusi: (list tulaga: 0), tusi: (list tulaga: 1).
list tuʻu: ['xmas'] i: 1.
list tuʻu: ['merry'] i: 0.
Tuuina-atu tusi: list aofaiga.
Tuuina-atu tusi: (list tulaga: 0), tusi: (list tulaga: 1).
