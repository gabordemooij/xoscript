>> items := Lomifefiloi fou.
items tuʻu: ['black'] i: ['coffee'], tuʻu: ['earl grey'] i: ['tea'].
Tuuina-atu tusi: (items i: ['coffee']), tusi: (items i: ['tea']).
Tuuina-atu tusi: ['there are'] + items aofaiga + [' items in the array.'].
items tuʻu: ['capuccino'] i: ['coffee'].
Tuuina-atu tusi: ['Now my coffee is.. '] + (items i: ['coffee']).
items tuʻu: ['aaa'] i: ['1'].
items tuʻu: ['bbb'] i: ['2'].
Tuuina-atu tusi: (items i: ['a']).
