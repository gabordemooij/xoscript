Server init.

# write a test file
>> f := Faila fou: ['/tmp/test.gif'].
f tusi: ['GIF87a01234567810'].

# serve the file
Server pasi: ['test.gif'] muamua-upu: ['/tmp/'].

Tuuina-atu laina-fou.

Tuuina-atu tusi: ['Outside container (security):'], laina-fou.
{ Server pasi: ['../passwd'] muamua-upu: ['/tmp/']. }
puʻe: { :e Tuuina-atu tusi: e, laina-fou. },
amata.

Tuuina-atu tusi: ['Invalid prefix:'], laina-fou.
{ Server pasi: ['test.gif'] muamua-upu: ['z:\\']. }
puʻe: { :e Tuuina-atu tusi: e, laina-fou. },
amata.

Tuuina-atu tusi: ['Non-existant file:'], laina-fou.
{ Server pasi: ['xxx.xxx'] muamua-upu: ['/tmp/']. }
puʻe: { :e Tuuina-atu tusi: e, laina-fou. },
amata.
