>> a := Lisi ← Mea ; Moni ; Sese ; Moni-pe-sese ; 1 ; Numera ; ['Str'] ; Manoa ; { ['Empty']. }.
Tuuina-atu tusi: (a aofaiga), laina-fou.
{ :i
	Tuuina-atu tusi: 
	['a '] + 
	((a ? i) ituaiga) +
	([' \‘this\’ '] this: (a ? i))  +
	[' is '] +
	(((a ? i) Leai-se-mea?) lenei: [''] po-o-lena: ['NOT']) + 
	[' Nil.'],
	laina-fou.
} × (a aofaiga).
Tuuina-atu tusi: ['but.. Nil is.. '] + ((Leai-se-mea Leai-se-mea?) lenei: ['certainly NIL!'] po-o-lena: ['not NIL??']), laina-fou.