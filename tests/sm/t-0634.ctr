# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Polokalama shell-escape: ['abc'].
Tuuina-atu tusi: c, laina-fou.
Tuuina-atu tusi: ( Polokalama faiga-masini: ['echo '] + c ), laina-fou.

c := Polokalama shell-escape: ['a'b'c'].
Tuuina-atu tusi: c, laina-fou.
Tuuina-atu tusi: ( Polokalama faiga-masini: ['echo '] + c ), laina-fou.

c := Polokalama shell-escape: ['a\'c'].
Tuuina-atu tusi: c, laina-fou.
Tuuina-atu tusi: ( Polokalama faiga-masini: ['echo '] + c ), laina-fou.