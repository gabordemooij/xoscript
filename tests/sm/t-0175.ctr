

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> x := 100.

Polokalama pulega-manatua: 0.

{
>> txt := ['hello '] + ['world'].
txt := txt + [' - can we use strings.. '].
txt := txt + ['without leaking '] + x + ['s of bytes ?'].
txt faaopoopo-i-le-iuga: ['!!'].
Tuuina-atu tusi: txt.
} amata.

Polokalama faamama.

usedMemory1 := (Polokalama manatua-masini ? 0).


