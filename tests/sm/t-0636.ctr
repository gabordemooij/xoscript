# test url parsing

Server init.
>> url := URL punavai: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Tuuina-atu tusi: ['scheme = '] + url fuafuaga-tuatusi, laina-fou.
Tuuina-atu tusi: ['host = '] + url talimalo, laina-fou.
Tuuina-atu tusi: ['port = '] + url uafu, laina-fou.
Tuuina-atu tusi: ['path = '] + url ala-faila, laina-fou.
Tuuina-atu tusi: ['query = '] + url mea-suesue, laina-fou.
Tuuina-atu tusi: ['fragment = '] + url fasi-vaega, laina-fou.
