Tuuina-atu tusi: ['Continue for-loop, No - before 6 and up.'], laina-fou.
{ :i
	Tuuina-atu tusi: (i + 1), laina-fou.
	((i + 1) > 4) faaauau.
	Tuuina-atu tusi: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Tuuina-atu laina-fou.
Tuuina-atu tusi: ['Continue while-true, No --> before 5 and up.'], laina-fou.
{
	Tuuina-atu tusi: ['iteration #'] + x, laina-fou.
	x faʻaopoopo: 1.
	((x < 5) faʻafeagai) faaauau.
	Tuuina-atu tusi: ['-->'].
} ao: xIsLessThan10.
Tuuina-atu laina-fou.
Tuuina-atu tusi: ['Continue while-false, No - before 3 only.'], laina-fou.
{
	Tuuina-atu tusi: ['iteration #'] + x, laina-fou.
	x toesea: 1.
	(x = 3) faaauau.
	Tuuina-atu tusi: ['-'].
} ao: { <- ( x > 0). }.

Tuuina-atu laina-fou.
Tuuina-atu tusi: ['Continue times-loop, No ||| before 3.'], laina-fou.
{ :i
	Tuuina-atu tusi: ['iteration #'] + i, laina-fou.
	(i = 2) faaauau.
	Tuuina-atu tusi: ['|||'].
} × 5.

Tuuina-atu laina-fou.

{ Moni faaauau. Tuuina-atu tusi: ['dont write this!'], laina-fou. } amata.

{ Moni faaauau. Tuuina-atu tusi: ['dont write this!'], laina-fou. } puʻe: { Tuuina-atu tusi: ['Dont catch this!']. }, amata.

Tuuina-atu tusi: ['Test Array each-loop: 0, ... ,2'], laina-fou.
(Lisi ← 1 ; 2 ; 3) sui-taʻitasi: { :i
	(i = 1) faaauau.
	Tuuina-atu tusi: ['iteration #'] + (i - 0), laina-fou.
}.

Tuuina-atu tusi: ['Test Map each-loop: c only'], laina-fou.
>> m := Lomifefiloi fou.
m tuʻu: ['first'] i: ['a'], tuʻu: ['second'] i: ['b'], tuʻu: ['third'] i: ['c'].
m taʻitasi: { :k :v
	(k ≠ ['c']) faaauau.
	Tuuina-atu tusi: ['iteration'] + k + v, laina-fou.
}.

