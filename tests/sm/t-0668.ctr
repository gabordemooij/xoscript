# decode from utf16le/be or utf32le/be to utf8
Server init.
>> utf16 := Blob fou: 8, bytes: (
	Lisi fou ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Tuuina-atu tusi: ( utf16 tatala-faʻailoga: ['utf16le'] ), laina-fou.

utf16 faasaoloto.
>> utf32 := Blob fou: 13, bytes: (
	Lisi fou ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Tuuina-atu tusi: ( utf32 tatala-faʻailoga: ['utf32be'] ), laina-fou.
utf32 faasaoloto.