>> x := [' hallo '].

>> y := x mataitusi-tetele.
Tuuina-atu tusi: x, laina-fou.
Tuuina-atu tusi: (x tutusa-lelei: y), laina-fou.

>> y := x mataitusi-laiti.
Tuuina-atu tusi: x, laina-fou.
Tuuina-atu tusi: (x tutusa-lelei: y), laina-fou.

>> y := x tipi-avanoa.
Tuuina-atu tusi: x, laina-fou.
Tuuina-atu tusi: (x tutusa-lelei: y), laina-fou.

>> y := x faamisi: 1.
Tuuina-atu tusi: x, laina-fou.
Tuuina-atu tusi: (x tutusa-lelei: y), laina-fou.

>> y := x amata: 1 umi: 2.
Tuuina-atu tusi: x, laina-fou.
Tuuina-atu tusi: (x tutusa-lelei: y), laina-fou.