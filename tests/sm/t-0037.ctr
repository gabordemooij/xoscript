>> a := 3.
>> b := a kopi-mea.
a toesea: 1.
Tuuina-atu tusi: [' a = '] + a.
Tuuina-atu tusi: [' b = '] + b.
a := 3.
b := a + 4.
Tuuina-atu tusi: [' a = '] + a.
Tuuina-atu tusi: [' b = '] + b.
>> x := 3.
>> y := x kopi-mea.
x faʻaopoopo: 10.
y toesea: 1.
Tuuina-atu tusi: [' x = '] + x.
Tuuina-atu tusi: [' y = '] + y.
>> q := Mea fou.
q pe-a-oo-mai: ['setProperty:'] fai: { :x
	lana-lava prop := x.
}.
q pe-a-oo-mai: ['getProperty'] fai: { <- lana-lava prop.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Tuuina-atu tusi: [' p = '] + (p getProperty).
