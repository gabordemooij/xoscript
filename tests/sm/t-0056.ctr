>> z := Mea fou.
z pe-a-oo-mai: ['value:'] fai: { :v
	lana-lava value := v. <- ia-lava.
}.
z pe-a-oo-mai: ['value'] fai: { <- lana-lava value. }.
(z setValue: 1) value: 2.
Tuuina-atu tusi: z value.
>> x := z.
Tuuina-atu tusi: x value.
z := Leai-se-mea.
Tuuina-atu tusi: z value.
Tuuina-atu tusi: x value.
Tuuina-atu tusi: ['hello'].
Tuuina-atu tusi: 3 + 2.
Tuuina-atu tusi: (3 > 2).
