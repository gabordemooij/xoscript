# This test checks if string_fill_in does not lose its slot (gc'ed) in mode 4
# reference in world.c
>> Log := Mea fou.

Log pe-a-oo-mai: ['say:'] fai: { :str
	Tuuina-atu tusi: str, laina-fou.
}.

>> Item := Mea fou.

Item pe-a-oo-mai: ['fou:'] fai: { :id <- ia-lava fou id: id.
}.

Item pe-a-oo-mai: ['id:'] fai: { :id
	lana-lava id := id.
}.

Item pe-a-oo-mai: ['id'] fai: { <- lana-lava id. }.


Item pe-a-oo-mai: ['manoa'] fai: {
	>> str := ['Item#~no'].
	str ~no: lana-lava id. <- str.
}.


>> Print := Mea fou.

Print pe-a-oo-mai: ['items'] fai: { 
	
	lana-lava item := Item fou: 1.
	
	# either segfault or wrong str here
	Log say: (
		['~item printed.'] ~item: lana-lava item
	).
	
	
}.

Print items.