Server init.
Tuuina-atu tusi: ['Database date test'], laina-fou.

>> db := Maria-DB fou talimalo: ['localhost'],
	igoa-tagata-faaaoga: ['xo'], 
	upu-faataga: ['pass123'],
	igoa-faaputuga-faamatalaga: ['xobase'],
	fesootai-atu.

>> mea-suesue :=
db fesili-faamatalaga: ['SELECT CAST('2026-01-01' AS DATE) AS datetest'],
aumai: { :row
	Tuuina-atu tusi: row datetest, laina-fou.
}.
