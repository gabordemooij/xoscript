# test number -> string -> number
{

	>> x := Numera i-le-va-o: 0 ma: 1000000.
	>> d := Numera i-le-va-o: 1 ma: 7.
	>> e := 10 mana-o-le-numera: d.

	x vaevaeina-e: e.
	>> y := x manoa numera.

	(x = y) sese: {
		Tuuina-atu tusi: x, laina-fou.
		Tuuina-atu tusi: y, laina-fou.
		Polokalama iuga.
	}.

} * 1000.
Tuuina-atu tusi: ['OK'], laina-fou.