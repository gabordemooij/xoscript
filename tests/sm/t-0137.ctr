(usedMemory1 = usedMemory2 = usedMemory3 = usedMemory4 = usedMemory5) moni: {
	Tuuina-atu tusi: ['Memory usage remains stable.'], laina-fou.
}, a-leai: {
	Tuuina-atu tusi: ['Used memory not stable.'], laina-fou.
