Tuuina-atu tusi: ['Test object'], laina-fou.
>> a := Mea fou. 

a pe-a-oo-mai: ['item:'] fai: { :octhelper
	lana-lava octhelper := octhelper. 
}.

a pe-a-oo-mai: ['item'] fai: { <- lana-lava octhelper.
}.

a item: Oct fou.

>> old-octhelper-address := a item faataitaiga-muamua tuatusi-manatua.
a save-as: ['/tmp/a.bin'].
Tuuina-atu tusi: ['========== RELOADING SNAP:'], laina-fou.

>> b := Mea load-from: ['/tmp/a.bin'].

(b item faataitaiga-muamua tuatusi-manatua = old-octhelper-address) moni: {
	Tuuina-atu tusi: ['Object link re-attached.'], laina-fou.
}.
