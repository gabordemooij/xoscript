>> To-Do := Mea fou.

To-Do pe-a-oo-mai: ['fou'] fai: {
	lana-lava list := Lisi fou.
}.

To-Do pe-a-oo-mai: ['nieuw'] fai: {
	lana-lava list := Lisi fou.
}.

To-Do pe-a-oo-mai: ['+'] fai: { :task
	lana-lava list faaopoopo-i-le-iuga: task.
}.

To-Do pe-a-oo-mai: ['number of tasks?'] fai: { <-  lana-lava list aofaiga.
}.

>> todos := 
	To-Do fou 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Tuuina-atu tusi: ['You have $ tasks to do'] $ todos number of tasks?.
