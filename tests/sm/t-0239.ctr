Lisi pe-a-oo-mai: ['sum'] fai: {
	>> total := 0.
	ia-lava taʻitasi: { :index :element
		total faʻaopoopo: element.
	}. <- total.
}.

>> a := Moni.



a pe-a-oo-mai: ['manoa'] fai: {
	>> answer := Leai-se-mea.
	( ia-lava = Moni ) moni: {
		answer := ['Yep'].
	}, a-leai: {
		answer := ['Nope'].
	}. <- answer.
}.

a pe-a-oo-mai: ['numera'] fai: {
	>> answer := Leai-se-mea.
	( ia-lava = Moni ) moni: {
		answer := 10.
	}, a-leai: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b pe-a-oo-mai: ['manoa'] fai: { <- ['Devil'].
}.

b pe-a-oo-mai: ['moni-pe-sese'] fai: { <- Sese.
}.


Tuuina-atu tusi: a, laina-fou.  
Tuuina-atu tusi: (90 + a), laina-fou. 
Tuuina-atu tusi: b, laina-fou. 
Tuuina-atu tusi: (Moni ma: b), laina-fou.

a := Lisi ← ['hello'] ; ['world'] ; Moni ; Leai-se-mea ; 666. 
a := a + ( Lisi ← 1 ).
Tuuina-atu tusi: a, laina-fou.
Tuuina-atu tusi: ((Lomifefiloi fou) tuʻu: Leai-se-mea i: Leai-se-mea), laina-fou.
Tuuina-atu tusi: a sum, laina-fou. 


{
	a pe-a-oo-mai: ['manoa'] fai: { <- Leai-se-mea. }.
	a := [''] + a.
} puʻe: { :error
	Tuuina-atu tusi: ['Error noted: '] + error, laina-fou.
}, amata.



{
	a pe-a-oo-mai: ['numera'] fai: { <- Leai-se-mea. }.
	a := 3 × a.
} puʻe: { :error
	Tuuina-atu tusi: ['Error noted: '] + error, laina-fou.
}, amata.


{
	a pe-a-oo-mai: ['moni-pe-sese'] fai: { <- Leai-se-mea. }.
	a := Moni ma: a. 
} puʻe: { :error
	Tuuina-atu tusi: ['Error noted: '] + error, laina-fou.
}, amata.





