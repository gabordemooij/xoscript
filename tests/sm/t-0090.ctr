Tuuina-atu tusi: ['1,2,3,4,5,6,7,8,9,A,'], laina-fou.
>> Scope := Mea fou.
Scope pe-a-oo-mai: ['initialize:'] fai: { :x lana-lava property := x. }.
Scope pe-a-oo-mai: ['confirm'] fai: { Tuuina-atu tusi: [',']. }.
Scope pe-a-oo-mai: ['suega'] fai: {
	Tuuina-atu tusi: lana-lava property.
	ia-lava confirm.
	( 1 = 1 ) moni: { Tuuina-atu tusi: lana-lava property. ia-lava confirm. }.
	( 1 = 0 ) sese: { Tuuina-atu tusi: lana-lava property. ia-lava confirm. }.
	>> y := 2. { Tuuina-atu tusi: lana-lava property. ia-lava confirm. } ao: { y toesea: 1. <- (y > 0). }.
	{ Tuuina-atu tusi: lana-lava property. ia-lava confirm. } × 1.
	(Lisi ← 1) taʻitasi: {  Tuuina-atu tusi: lana-lava property. ia-lava confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo impl own sorting, this test fails because diff. num iterations per platform
	(Lomifefiloi fou one: ['item']) taʻitasi: { Tuuina-atu tusi: lana-lava property. ia-lava confirm. }.
	{ 1 ÷ 0. } puʻe: { Tuuina-atu tusi: lana-lava property. ia-lava confirm. }, amata.
	Tuuina-atu laina-fou.
}.
>> scope1 := Scope fou.
scope1 initialize: ['X'].
scope1 suega.
>> function := { 
	lana-lava property := ['Y'].
	Tuuina-atu tusi: lana-lava property.
	ia-lava confirm.
	( 1 = 1 ) moni: { Tuuina-atu tusi: lana-lava property. ia-lava confirm. }.
	( 1 = 0 ) sese: { Tuuina-atu tusi: lana-lava property. ia-lava confirm. }.
	>> y := 2. { Tuuina-atu tusi: lana-lava property. ia-lava confirm. } ao: { y toesea: 1. <- (y > 0). }.
	{ Tuuina-atu tusi: lana-lava property. ia-lava confirm. } × 1.
	(Lisi ← 1) taʻitasi: {  Tuuina-atu tusi: lana-lava property. ia-lava confirm. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Lomifefiloi fou one: ['item']) taʻitasi: { Tuuina-atu tusi: lana-lava property. ia-lava confirm. }.
	{ 1 ÷ 0. } puʻe: { Tuuina-atu tusi: lana-lava property. ia-lava confirm. }, amata.
	Tuuina-atu laina-fou.
}.
function pe-a-oo-mai: ['confirm'] fai: { Tuuina-atu tusi: [',']. }.
function faʻaaoga: 1 ma: 2.
