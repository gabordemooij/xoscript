
Manoa pe-a-oo-mai: ['html'] fai: { <- (
		ia-lava
		sui: ['&'] i-le: ['&amp;'],
		sui: ['<'] i-le: ['&lt;'],
		sui: ['>'] i-le: ['&gt;'],
		sui: ['"'] i-le: ['&quot;']
	).
}.

>> HtmlBrush := Mea fou.

HtmlBrush pe-a-oo-mai: ['tali-atu:'] fai: { :tag
	Tuuina-atu tusi: (['<tag>↵'] tag: tag ).
}.

HtmlBrush pe-a-oo-mai: ['tali-atu:ma:'] fai: { :tag :content
	tag := ( tag amata: 0 umi: (tag umi - 1) ).
	Tuuina-atu tusi: (['<tag content>↵'] tag: tag, content: content).
}.

HtmlBrush pe-a-oo-mai: ['content:'] fai: { :text
	Tuuina-atu tusi: text html, laina-fou.
}.

HtmlBrush pe-a-oo-mai: ['attr:value:'] fai: { :attr :value <- ['attr="value"'] attr: attr, value: value.
}.

>> h := HtmlBrush fou.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h attr: ['class'] value: ['bold']),
		/span
	/body
/html.
		
