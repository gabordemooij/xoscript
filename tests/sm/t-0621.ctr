>> phrases := Lisi fou
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases taʻitasi: { :_ :phrase 
	>> e := Server base64-faʻailoga-numera: phrase.
	>> d := Server base64-tatala-faʻailoga: e.
	Tuuina-atu tusi: (
		message kopi-mea ~encoded: e, ~decoded: d
	), laina-fou.
}.
