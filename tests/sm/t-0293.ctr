
>> city := Lisi ← ['London'] ; ['Paris'] ; ['Berlin'].
>> temperature := Lisi ← ['15'] ; ['16'] ; ['15'].
>> weather := temperature e-tusa-ai: city.
>> cities := weather ki-uma faasologa: { :a :b <- (a faatusatusa: b). }.
>> temperatures := weather tau-uma faasologa: { :a :b <- (a faatusatusa: b) lalo-o-le-selo?. }.

Tuuina-atu tusi: (cities tuufaatasi: [',']), laina-fou.
Tuuina-atu tusi: (temperatures tuufaatasi: [',']), laina-fou.
