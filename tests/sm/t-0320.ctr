


>> CoffeeMachine := Mea fou.
CoffeeMachine pe-a-oo-mai: ['order:'] fai: { :id
	>> coffee := ['Americano'].
	( id = 1 ) moni: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) moni: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) moni: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Mea fou.
SimpleCoffeeMachine pe-a-oo-mai: ['order'] fai: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Tuuina-atu tusi: redCup, laina-fou.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Tuuina-atu tusi: greenCup, laina-fou.
>> yellowCup := CoffeeMachine order: 1.
Tuuina-atu tusi: yellowCup, laina-fou.
>> blueCup := CoffeeMachine order: 0.
Tuuina-atu tusi: blueCup, laina-fou.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Tuuina-atu tusi: blackCup, laina-fou.
blackCup faaopoopo-i-le-iuga: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Tuuina-atu tusi: orangeCup, laina-fou.
