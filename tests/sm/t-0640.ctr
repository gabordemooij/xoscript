
Server init.
Tuuina-atu tusi: ['Database test'], laina-fou.

>> db := Maria-DB fou talimalo: ['localhost'],
	igoa-tagata-faaaoga: ['xo'], 
	upu-faataga: ['pass123'],
	igoa-faaputuga-faamatalaga: ['xobase'],
	fesootai-atu.

>> mea-suesue :=
db fesili-faamatalaga: ['SELECT UNHEX('CAFE') AS blobby'],
aumai: { :row
	Tuuina-atu tusi: ( row blobby amata: 0 umi: 2 ), laina-fou.
	row blobby faasaoloto.
}.
