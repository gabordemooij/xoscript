# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Pusa-malu fai-ki.

# private (secret) key
>> sk := keys tulaga-tasi.

# public key
>> pk := keys mulimuli.

# sign a message
>> sig := Pusa-malu saini: ['abc'] i-le: sk.

# check message (ok)
Tuuina-atu tusi: ( 
	Pusa-malu
		siaki: ['abc'] 
		saini-lima: sig 
		i-le: pk 
), laina-fou.

# check message (fail)
Tuuina-atu tusi: ( 
	Pusa-malu 
		siaki: ['abd'] 
		saini-lima: sig 
		i-le: pk 
), laina-fou.