

Lisi pe-a-oo-mai: ['sum'] fai: {
	>> total := 0.
	ia-lava taʻitasi: { :index :element
		total faʻaopoopo: element.
	}. <- total.
}.

Lisi pe-a-oo-mai: ['product'] fai: {
	>> total := 1.
	ia-lava taʻitasi: { :index :element
		total faʻateleina-e: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Polokalama pulega-manatua: 0.

{

>> a := Lisi ← ['hello'] ; ['world'] ; Moni ; Leai-se-mea ; 666.
a := a + ( Lisi ← 1 ).
Tuuina-atu tusi: ( ['sum: '] + ( a sum ) ), laina-fou.
Tuuina-atu tusi: ( ['min: '] + ( a aupito-maualalo ) ), laina-fou.
Tuuina-atu tusi: ( ['max: '] + ( a maualuga ) ), laina-fou.
Tuuina-atu tusi: ( ['3rd: '] + ( a ? 2 ) ), laina-fou.
Tuuina-atu tusi: ( ['prd: '] + ( a product ) ), laina-fou.
a faasologa: { :a :b <- (b - a). }.
a taʻitasi: { :i :e Tuuina-atu tusi: ( i - 0 ), laina-fou. }.

} amata.

Polokalama faamama.
usedMemory1 := (Polokalama manatua-masini ? 0).


{

>> a := Lisi ← ['hello'] ; ['world'] ; Moni ; Leai-se-mea ; 666.
a := a + ( Lisi ← 1 ).
Tuuina-atu tusi: ( ['sum: '] + ( a sum ) ), laina-fou.
Tuuina-atu tusi: ( ['min: '] + ( a aupito-maualalo ) ), laina-fou.
Tuuina-atu tusi: ( ['max: '] + ( a maualuga ) ), laina-fou.
Tuuina-atu tusi: ( ['3rd: '] + ( a ? 2 ) ), laina-fou.
Tuuina-atu tusi: ( ['prd: '] + ( a product ) ), laina-fou.
a faasologa: { :a :b <- (b - a). }.
a taʻitasi: { :i :e Tuuina-atu tusi: ( i - 0 ), laina-fou. }.

} amata.



Polokalama faamama.
usedMemory2 := (Polokalama manatua-masini ? 0).


{

>> a := Lisi ← ['hello'] ; ['world'] ; Moni ; Leai-se-mea ; 666.
a := a + ( Lisi ← 1 ).
Tuuina-atu tusi: ( ['sum: '] + ( a sum ) ), laina-fou.
Tuuina-atu tusi: ( ['min: '] + ( a aupito-maualalo ) ), laina-fou.
Tuuina-atu tusi: ( ['max: '] + ( a maualuga ) ), laina-fou.
Tuuina-atu tusi: ( ['3rd: '] + ( a ? 2 ) ), laina-fou.
Tuuina-atu tusi: ( ['prd: '] + ( a product ) ), laina-fou.
a faasologa: { :a :b <- (b - a). }.
a taʻitasi: { :i :e Tuuina-atu tusi: ( i - 0 ), laina-fou. }.

} amata.



Polokalama faamama.
usedMemory3 := (Polokalama manatua-masini ? 0).

( usedMemory1 = usedMemory2 ma: usedMemory1 = usedMemory3, ma: usedMemory2 = usedMemory3 ) moni: {
	Tuuina-atu tusi: ['No memory leaks here'].
}, sese: {
	Tuuina-atu tusi: ['Leaking memory...'].
}.
