>> map1 := Lomifefiloi fou.
>> key1 := Lisi fou.
>> key2 := Lisi fou.

map1
	tuʻu: ['hello'] i: key1,
	tuʻu: ['world'] i: key2.


Tuuina-atu
	tusi: ['Map #1 contains: '] + (map1 i: key1),
	tusi: [' and '] + (map1 i: key2), laina-fou.

>> KeyeableArray := Lisi fou.
KeyeableArray pe-a-oo-mai: ['toString'] fai: { <- (ia-lava aofaiga) toString.
}.

>> map2 := Lomifefiloi fou.
key1 := KeyeableArray fou.
key2 := KeyeableArray fou.

key1 faaopoopo-i-le-iuga: 1.

map2
	tuʻu: ['hello'] i: key1,
	tuʻu: ['world'] i: key2.

Tuuina-atu
	tusi: ['Map #2 contains: '] + (map2 i: key1),
	tusi: [' and '] + (map2 i: key2), laina-fou.
