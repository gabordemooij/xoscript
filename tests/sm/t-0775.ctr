Tuuina-atu tusi: ['Test object'], laina-fou.
>> l := Lisi fou ; 1 ; ( Lisi fou ; (Taimi fou: 1) ; (Int64 mai-le-manoa: ['321']) ; (Lisi fou ; 3)).
Tuuina-atu tusi: l, laina-fou.
>> old-lst-address := l faataitaiga-muamua tuatusi-manatua.
l save-as: ['/tmp/a.bin'].
Tuuina-atu tusi: ['========== RELOADING SNAP:'], laina-fou.
>> b := Mea load-from: ['/tmp/a.bin'].
(b faataitaiga-muamua tuatusi-manatua = old-lst-address) moni: {
	Tuuina-atu tusi: ['Object link re-attached.'], laina-fou.
}.
Tuuina-atu tusi: b, laina-fou.
