Server init.

>> conn1 := Maria-DB fou talimalo: ['localhost'],
	igoa-tagata-faaaoga: ['xo'],
	upu-faataga: ['pass123'],
	igoa-faaputuga-faamatalaga: ['xobase'],
	fesootai-atu.

>> conn2 := Maria-DB fou talimalo: ['localhost'],
	igoa-tagata-faaaoga: ['xo'],
	upu-faataga: ['pass123'],
	igoa-faaputuga-faamatalaga: ['xobase'],
	fesootai-atu.
#...
>> del := conn1 fesili-faamatalaga: ['DELETE FROM book WHERE id > 0'].
{  del faatino. conn1 faamautu. } puʻe: { :e conn1 toe-foi-i-tua.  }, amata.

>> insert := conn1 fesili-faamatalaga: ['INSERT INTO book (id) VALUES(null)'].
insert faatino.

>> aofaiga := conn1 fesili-faamatalaga: ['SELECT COUNT(*) AS num FROM book'].
aofaiga aumai: { :row Tuuina-atu tusi: row num, laina-fou. }.

# does not show up
# insert not committed on connection 1
>> aofaiga := conn2 fesili-faamatalaga: ['SELECT COUNT(*) AS num FROM book'].
aofaiga aumai: { :row Tuuina-atu tusi: row num, laina-fou. }.
