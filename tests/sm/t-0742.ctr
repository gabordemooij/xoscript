Tuuina-atu tusi: ['Test object'], laina-fou.
>> a := Mea fou. 

a pe-a-oo-mai: ['item:'] fai: { :hexhelper
	lana-lava hexhelper := hexhelper. 
}.

a pe-a-oo-mai: ['item'] fai: { <- lana-lava hexhelper.
}.

a item: Hx fou.

>> old-hexhelper-address := a item faataitaiga-muamua tuatusi-manatua.
a save-as: ['/tmp/a.bin'].
Tuuina-atu tusi: ['========== RELOADING SNAP:'], laina-fou.

>> b := Mea load-from: ['/tmp/a.bin'].

(b item faataitaiga-muamua tuatusi-manatua = old-hexhelper-address) moni: {
	Tuuina-atu tusi: ['Object link re-attached.'], laina-fou.
}.
