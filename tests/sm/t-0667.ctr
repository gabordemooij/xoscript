# test Program version

# this feature is disabled by default
Tuuina-atu tusi: (
	Polokalama vaega: 
	['RECURSIVE_STRINTPOL']
), laina-fou.


# but if we set the time back
>> today := Taimi 
sone: ['CEST'],
punavai: ['2026-02-15 10:00:00'].
Polokalama lomiga: today.

# it will be enabled like it used to be (from now on)
Tuuina-atu tusi: (
	Polokalama vaega: 
	['RECURSIVE_STRINTPOL']
), laina-fou.