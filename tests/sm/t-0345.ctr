# test catch-all methods
>> x13 := Mea fou.
x13 pe-a-oo-mai: ['a'] fai: { :a Tuuina-atu tusi: 0, laina-fou. }.
x13 pe-a-oo-mai: ['a:'] fai: { :a Tuuina-atu tusi: a, laina-fou. <- 5. }.
x13 pe-a-oo-mai: ['a:b:'] fai: { :a :b Tuuina-atu tusi: (a + b), laina-fou. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
