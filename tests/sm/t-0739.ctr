Tuuina-atu tusi: ['Test object'], laina-fou.
>> a := Mea fou. 

a pe-a-oo-mai: ['item:'] fai: { :binhelper
	lana-lava binhelper := binhelper. 
}.

a pe-a-oo-mai: ['item'] fai: { <- lana-lava binhelper.
}.

a item: Bin fou.

>> old-binhelper-address := a item faataitaiga-muamua tuatusi-manatua.
a save-as: ['/tmp/a.bin'].
Tuuina-atu tusi: ['========== RELOADING SNAP:'], laina-fou.

>> b := Mea load-from: ['/tmp/a.bin'].

(b item faataitaiga-muamua tuatusi-manatua = old-binhelper-address) moni: {
	Tuuina-atu tusi: ['Object link re-attached.'], laina-fou.
}.


