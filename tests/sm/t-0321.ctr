# test qualifiers

Polokalama faamama.

>> Fruit := Mea fou.
Fruit pe-a-oo-mai: ['fou'] fai: {
	>> f := ia-lava fou.
	f apples: 0. <- f.
}.
Fruit pe-a-oo-mai: ['apples:'] fai: { :a lana-lava apples := a. }.
Fruit pe-a-oo-mai: ['apples'] fai: { <- lana-lava apples. }.
Fruit pe-a-oo-mai: ['+'] fai: { :f
	>> n := Fruit fou.
	n apples: (f apples + lana-lava apples). <- n.
}.
Numera pe-a-oo-mai: ['apples'] fai: { <- ((Fruit fou) apples: ia-lava).
}.

Fruit pe-a-oo-mai: ['manoa'] fai: { <- lana-lava apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Tuuina-atu tusi: q, laina-fou.




q := 3 apples + 4 apples.
Tuuina-atu tusi: q, laina-fou.



q := 3 apples + 4 apples.
Tuuina-atu tusi: q, laina-fou.


