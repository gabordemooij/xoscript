
>> Size := Mea fou.
Size pe-a-oo-mai: ['is:'] fai: { :numera
	numera pe-a-oo-mai: ['+'] fai: { :numera
		>> unit := numera iunite-numera.
		>> factor := 1.
		
		unit
		mataupu: ['inch'] fai: { factor := 0.0833. }. <- ia-lava + (numera * factor).
	}. <- numera.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Tuuina-atu tusi: plank + edge, laina-fou.
