#Linux
>> OS := Polokalama faatulagaga-masini: ['OS'].

>> clock := Taimi fou.
	
(OS = ['Haiku']) moni: {
	clock sone: ['CET'],
	tausaga: 2017, masina: 7, aso: 13,
	itula: 18, minute: 0, sekone: 0.
}, a-leai: {
	clock sone: ['Europe/Amsterdam'],
	tausaga: 2017, masina: 7, aso: 13,
	itula: 18, minute: 0, sekone: 0.
}.

clock pe-a-oo-mai: ['tell'] fai: {
	Tuuina-atu tusi: ia-lava, laina-fou.
}.


clock faʻaopoopo: 2    itula, tell.
clock faʻaopoopo: 1    itula, tell.
clock faʻaopoopo: 19 minute, tell.
clock faʻaopoopo: 1  minute, tell.
clock faʻaopoopo: 1  minute, tell.
clock faʻaopoopo: 19 sekone, tell.
clock faʻaopoopo: 1  sekone, tell.
clock faʻaopoopo: 1  sekone, tell.
clock faʻaopoopo: 2    tausaga, tell.
clock faʻaopoopo: 1    tausaga, tell.

(OS = ['Haiku']) moni: {
clock faʻaopoopo: 5   masina.
clock sone: ['CEST'], tell.
}, a-leai: {
	clock faʻaopoopo: 5   masina, tell.
}.

clock faʻaopoopo: 1   masina, tell.
clock faʻaopoopo: 19    aso, tell.
clock faʻaopoopo: 1    itula, tell.
clock faʻaopoopo: 120  yard, tell.
