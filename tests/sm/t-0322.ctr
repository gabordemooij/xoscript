

>> Matryoshka := Mea fou.
Matryoshka pe-a-oo-mai: ['double:'] fai: { :secret
	lana-lava secret := secret × 2.
}.
Matryoshka pe-a-oo-mai: ['fou:'] fai: { :secret
	>> answer := Leai-se-mea.
	>> t := (secret > 255).
	Tuuina-atu tusi: (secret + [' | '] + t), laina-fou.
	t moni: {
		answer := secret.
	}, a-leai: {
		answer := Matryoshka valaau-ia-lava fou: (ia-lava double: secret).
	}. <- answer.
}.

>> x := Matryoshka fou: 2.
