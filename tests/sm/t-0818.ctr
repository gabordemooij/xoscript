# edge cases from a request must give an error or a result, not a crash
Server init.

Tuuina-atu tusi: ['<'] + (['abc'] amata: 0 umi: 0, mataitusi-tetele) + ['>'], laina-fou.
Tuuina-atu tusi: ['<'] + (['abc'] amata: 0 umi: 0, mataitusi-laiti) + ['>'], laina-fou.
Tuuina-atu tusi: ['<'] + (['abc'] faamisi: 3, mataitusi-tetele) + ['>'], laina-fou.
Tuuina-atu tusi: [''] mataitusi-tetele bytes, laina-fou.
Tuuina-atu tusi: ['aB'] mataitusi-tetele, laina-fou.
Tuuina-atu tusi: ['aB'] mataitusi-laiti, laina-fou.

Tuuina-atu tusi: (Taimi fou: 0) tausaga, laina-fou.
{ Taimi fou: ['9e300'] numera. } puʻe: { :e Tuuina-atu tusi: e, laina-fou. }, amata.
{ Taimi fou: ['-9e300'] numera. } puʻe: { :e Tuuina-atu tusi: e, laina-fou. }, amata.
{ Taimi fou: ['nan'] numera. } puʻe: { :e Tuuina-atu tusi: e, laina-fou. }, amata.
{ Taimi fou: 9000000000000000000. } puʻe: { :e Tuuina-atu tusi: e, laina-fou. }, amata.
