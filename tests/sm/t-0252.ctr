#Linux
>> clock := Taimi fou.
clock sone: ['UTC-1'].
clock tausaga: 1981, masina: 1, aso: 5,
      itula: 13, minute: 15, sekone: 13.

Tuuina-atu tusi: clock, laina-fou.
clock sone: ['UTC+0'].

Tuuina-atu tusi: (
	(clock tausaga faigofie) + ['-'] + (clock masina) + ['-'] + (clock aso) + [' '] +
	(clock itula) + [':'] + (clock minute) + [':'] + (clock sekone) + [' '] +
	['W'] + (clock vaiaso) + (clock sone)
), laina-fou.


clock sone: ['UTC-1'].
