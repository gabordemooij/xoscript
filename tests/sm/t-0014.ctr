>> Greeter := Mea fou.
Greeter pe-a-oo-mai: ['make'] fai: {
	>> gr := Mea fou.
	gr pe-a-oo-mai: ['setName:'] fai: { :aname
		lana-lava igoa := aname.
	}.
	gr pe-a-oo-mai: ['greet'] fai: {
		Tuuina-atu tusi: lana-lava igoa.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a fou.
c setName: ['THREE'].
c greet.
>> d := a fou.
d setName: ['FOUR'].
d greet.
c greet.
