
>> Rectangle := Mea fou.

Rectangle pe-a-oo-mai: ['area'] fai: { <- lana-lava umi * lana-lava width.
}.

Rectangle pe-a-oo-mai: ['length:'] fai: { :umi
	lana-lava umi := umi.
}.

Rectangle pe-a-oo-mai: ['width:'] fai: { :width
	lana-lava width := width.
}.

Rectangle pe-a-oo-mai: ['fou'] fai: {
	# this will not result into an infinite loop
	>> rectangle := ia-lava fou.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle fou.
Tuuina-atu tusi: a area, laina-fou. #0

>> b := Rectangle fou length: 2, width: 3.
Tuuina-atu tusi: b area, laina-fou. #6

