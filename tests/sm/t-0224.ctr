
>> countries := Lisi fou
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Lisi fou
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods e-tusa-ai: countries, taʻitasi: { :key :value
	counter faʻaopoopo: 1.
}.

Tuuina-atu tusi: (['we serve counter dishes'] counter: counter), laina-fou.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] mataitusi-uma faasologa: { :v
	counter faʻaopoopo: 0.
}.

Tuuina-atu tusi: (['we sort counter dishes'] counter: counter), laina-fou.


>> counter := 0.
{
	{
		counter faʻaopoopo: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Tuuina-atu tusi: (['we calculate counter numbers.'] counter: counter), laina-fou.

