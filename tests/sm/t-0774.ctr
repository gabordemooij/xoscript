Tuuina-atu tusi: ['Test object'], laina-fou.
>> a := Mea fou. 
a pe-a-oo-mai: ['item:'] fai: { :lst
	lana-lava lst := lst. 
}.
a pe-a-oo-mai: ['item'] fai: { <- lana-lava lst.
}.
a item: (
	Lisi fou ; 1 ; (
		Lisi fou ; ['a'] ; (
			Lisi fou ; ( Taimi fou: 1 )
		) ; ( Int64 mai-le-manoa: ['321'] )
	)
).
Tuuina-atu tusi: a item, laina-fou.
>> old-lst-address := a item faataitaiga-muamua tuatusi-manatua.
a save-as: ['/tmp/a.bin'].
Tuuina-atu tusi: ['========== RELOADING SNAP:'], laina-fou.
>> b := Mea load-from: ['/tmp/a.bin'].
(b item faataitaiga-muamua tuatusi-manatua = old-lst-address) moni: {
	Tuuina-atu tusi: ['Object link re-attached.'], laina-fou.
}.
Tuuina-atu tusi: ( b item ), laina-fou.
