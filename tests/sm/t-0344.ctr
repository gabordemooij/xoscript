# catch-all test (practical)
>> HTML := Manoa fou.
HTML pe-a-oo-mai: ['encode:'] fai: { :tekst
	ia-lava faaopoopo-i-le-iuga: (tekst
	sui: ['&'] i-le: ['&amp;'], 
	sui: ['<'] i-le: ['&lt;'],
	sui: ['>'] i-le: ['&gt;'],
	sui: ['"'] i-le: ['&quot;']).
}.
>> blog := HTML fou.
blog faaopoopo-i-le-iuga: ['<h1>'],
     encode: ['Koffie & Thee'],
     faaopoopo-i-le-iuga: ['</h1>'].
Tuuina-atu tusi: blog, laina-fou.


>> Roman := Numera fou.
Roman pe-a-oo-mai: ['stringy'] fai: {
	>> a := [''].
	{ a faaopoopo-i-le-iuga: ['I']. } × ia-lava. <- a.
}.

>> x := Roman fou.
x faʻaopoopo: 3.
Tuuina-atu tusi: x stringy, laina-fou.

>> Quantum := Moni-pe-sese fou.
Quantum pe-a-oo-mai: ['true?'] fai: { <- ['maybe True']. }.
Tuuina-atu tusi: (Quantum fou true?), laina-fou.

>> Nihil := Leai-se-mea fou.
Nihil pe-a-oo-mai: ['manoa'] fai: { <- ['Nihil']. }.
Tuuina-atu tusi: (Nihil fou), laina-fou.
