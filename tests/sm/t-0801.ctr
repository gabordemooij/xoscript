Server init.

>> db := Maria-DB fou talimalo: ['localhost'],
	igoa-tagata-faaaoga: ['xo'],
	upu-faataga: ['pass123'],
	igoa-faaputuga-faamatalaga: ['xobase'],
	fesootai-atu.

>> del := db fesili-faamatalaga: ['DELETE FROM book WHERE id > 0'].
{  del faatino. db faamautu. } puʻe: { :e db toe-foi-i-tua.  }, amata.

>> aofaiga := db fesili-faamatalaga: ['SELECT COUNT(*) AS num FROM book'].
aofaiga aumai: { :row Tuuina-atu tusi: row num, laina-fou. }.
