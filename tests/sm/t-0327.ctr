

Lisi pe-a-oo-mai: ['fixture:'] fai: { :f
	lana-lava fixture := f.
}.

Lisi pe-a-oo-mai: ['aofaiga'] fai: { <- lana-lava fixture.
}.

Lisi pe-a-oo-mai: ['aantal'] fai: { <- lana-lava fixture.
}.


>> x := Leai-se-mea.
{

	x := ['hello'] 
	sui:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] mataitusi: 2)
			)
		)
	i-le: (
		(['...hal'] + ['lo']) 
			mataitusi-tetele 
			lowecase 
			mataitusi-tetele 
			faamisi: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Lisi ← 0 ; 1 ; 4; 9 ; (Lisi ← 0 ; 3; 1) ; 4
							) muamua-i-le-mulimuli
						) ? 1
					) + 
					((Lisi ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					aofaiga
				)
			)
	).

} × 10.
Tuuina-atu tusi: x, laina-fou.

