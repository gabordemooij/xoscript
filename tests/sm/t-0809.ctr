# backslashes must survive code serialization, strings must not end early
>> tau-uma := Lisi fou
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

tau-uma taʻitasi: { :i :value
	>> d := Lomifefiloi fou.
	d tuʻu: value i: ['k'].
	>> r := d faʻailoga mea.
	Tuuina-atu tusi: r aofaiga, laina-fou.
	Tuuina-atu tusi: ( (r i: ['k']) = value ), laina-fou.
}.
