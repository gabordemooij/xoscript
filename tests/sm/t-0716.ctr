Tuuina-atu tusi: ['Test object'], laina-fou.
>> a := Mea fou. 

a pe-a-oo-mai: ['state:'] fai: { :list
	lana-lava list := list. 
}.

a pe-a-oo-mai: ['state'] fai: {
	Tuuina-atu tusi: lana-lava list, laina-fou.
}.

a state: ( Lisi fou ; ['listitem'] ; ['item2'] ).
a state.

a save-as: ['/tmp/a.bin'].
Tuuina-atu tusi: ['========== RELOADING SNAP:'], laina-fou.
>> b := Mea load-from: ['/tmp/a.bin'].
b state.