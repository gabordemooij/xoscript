>> winery := { <- (	Lomifefiloi fou
		tuʻu: 2 i: ['merlot'],
		tuʻu: 3 i: ['malbec'],
		tuʻu: 4 i: ['syrah']
	).
}.

Tuuina-atu tusi: (((winery amata) - ['nothing']) aofaiga), laina-fou.
Tuuina-atu tusi: (((winery amata) - ['merlot']) aofaiga), laina-fou.
Tuuina-atu tusi: (((winery amata) - ['malbec']) aofaiga), laina-fou.
Tuuina-atu tusi: (((winery amata) - ['syrah']) aofaiga), laina-fou.
Tuuina-atu tusi: (((winery amata) - ['merlot'] - ['malbec']) aofaiga), laina-fou.
Tuuina-atu tusi: (((winery amata) - ['merlot'] - ['syrah']) aofaiga), laina-fou.
Tuuina-atu tusi: (((winery amata) - ['malbec'] -['syrah']) aofaiga), laina-fou.
Tuuina-atu tusi: (((winery amata) - ['malbec'] - ['syrah'] - ['merlot']) aofaiga), laina-fou.

