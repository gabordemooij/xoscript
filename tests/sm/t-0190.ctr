#Linux
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Polokalama pulega-manatua: 0.

{
Taimi taimi.
Taimi faatali: 1.
Tuuina-atu tusi: Polokalama aofaiga-mea-tuuina, laina-fou.
Polokalama mea-tuuina: 0.
Numera random.
Tuuina-atu tusi: (Polokalama faiga-masini: ['echo 'Hello'']).
} amata.

Polokalama faamama.
usedMemory1 := (Polokalama manatua-masini ? 0).

{
Taimi taimi.
Taimi faatali: 1.
Tuuina-atu tusi: Polokalama aofaiga-mea-tuuina, laina-fou.
Polokalama mea-tuuina: 0.
Numera random.
Tuuina-atu tusi: (Polokalama faiga-masini: ['echo 'Hello'']).
} amata.

Polokalama faamama.
usedMemory2 := (Polokalama manatua-masini ? 0).

{
Taimi taimi.
Taimi faatali: 1.
Tuuina-atu tusi: Polokalama aofaiga-mea-tuuina, laina-fou.
Polokalama mea-tuuina: 0.
Numera random.
Tuuina-atu tusi: (Polokalama faiga-masini: ['echo 'Hello'']).
} amata.

Polokalama faamama.
usedMemory3 := (Polokalama manatua-masini ? 0).



( usedMemory1 = usedMemory2 ma: usedMemory1 = usedMemory3, ma: usedMemory2 = usedMemory3 ) moni: {
	Tuuina-atu tusi: ['No memory leaks here'].
}, sese: {
	Tuuina-atu tusi: ['Leaking memory...'].
}.
