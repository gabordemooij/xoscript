# test buffers PKI/Sign 
Server init.

>> long := ( Lisi fou faatumu: 1000 i-le: ['a'] ) tuufaatasi: [''].

# sign a message
Tuuina-atu tusi: ( 
	Pusa-malu saini: ['abc'] i-le: long
), laina-fou.

Tuuina-atu tusi: ( 
	Pusa-malu
		siaki: ['abc'] 
		saini-lima: long 
		i-le: long
), laina-fou.

Tuuina-atu tusi: (
	Pusa-malu hash-upu-faataga: long faamaonia: long
), laina-fou.
