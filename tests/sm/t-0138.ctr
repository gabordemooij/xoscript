x := 3.
y := ['Hello'].
q := { ['']. }.
p := Moni.
a := Lisi ← 1 ; 2 ; 3 ; 5.
c := Mea fou.
c pe-a-oo-mai: ['greet:'] fai: { Tuuina-atu tusi: ['greet!']. }.
c := Mea fou.
c pe-a-oo-mai: ['greet:'] fai: { Tuuina-atu tusi: ['a different greet!'], laina-fou. }.


Polokalama faamama.
>> usedMemory4 := (Polokalama manatua-masini ? 0).





