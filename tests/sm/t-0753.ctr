Tuuina-atu tusi: ['Test object'], laina-fou.
>> a := Mea fou. 

a pe-a-oo-mai: ['item:'] fai: { :fmt
	lana-lava fmt := fmt. 
}.

a pe-a-oo-mai: ['item'] fai: { <- lana-lava fmt.
}.

a item: ( Faatulagaga fou: ['|%s|'] ).

Tuuina-atu tusi: a item, laina-fou.

>> old-fmt-address := a item faataitaiga-muamua tuatusi-manatua.
a save-as: ['/tmp/a.bin'].
Tuuina-atu tusi: ['========== RELOADING SNAP:'], laina-fou.

>> b := Mea load-from: ['/tmp/a.bin'].

(b item faataitaiga-muamua tuatusi-manatua = old-fmt-address) moni: {
	Tuuina-atu tusi: ['Object link re-attached.'], laina-fou.
}.

Tuuina-atu tusi: ( b item faʻaaoga: ['hello'] ), laina-fou.
