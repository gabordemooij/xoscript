60 × {
	>> x := (Numera random % 6) + 1.
	(x ≤ 6) sese: { Tuuina-atu tusi: ['FAIL']. }.
	(x ≥0) sese: { Tuuina-atu tusi: ['FAIL']. }.
	x := (Numera random % 3) + 1.
	(x < 3) sese: { Tuuina-atu tusi: ['FAIL']. }.
	(x>-1) sese: { Tuuina-atu tusi: ['FAIL']. }.
	x := ((Moni-pe-sese flip) numera).
	(x = 0 poʻo: x = 1) sese: { Tuuina-atu tusi: ['FAIL']. }.
	x := ((Moni flip) numera).
	(x = 0 poʻo: x = 1) sese: { Tuuina-atu tusi: ['FAIL']. }.
	x := (Moni-pe-sese flip lenei: ['HEAD'] po-o-lena: ['TAIL']).
	((x = ['HEAD']) poʻo: (x = ['TAIL'])) sese: { Tuuina-atu tusi: ['FAIL']. }.
}.
Tuuina-atu tusi: ['DONE'].

