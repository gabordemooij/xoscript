Polokalama pulega-manatua: 0.
Lisi pe-a-oo-mai: ['sum'] fai: {
	>> total := 0.
	ia-lava taʻitasi: { :index :element
		total faʻaopoopo: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Faila fou: ['/tmp/test.txt'].
f tusi: ['Lorem Ipsum'].
f tapuni.
  

f := Faila fou: ['/tmp/test.txt'].
>> text := f faitau.
f tapuni.



Polokalama faamama.
usedMemory1 := (Polokalama manatua-masini ? 1).



f := Faila fou: ['/tmp/test.txt'].
text := f faitau.
f tapuni.

Polokalama faamama.
usedMemory2 := (Polokalama manatua-masini ? 1).


f := Faila fou: ['/tmp/test.txt'].
text := f faitau.
f tapuni.

Polokalama faamama.
usedMemory3 := (Polokalama manatua-masini ? 1).



( usedMemory1 = usedMemory2 ma: usedMemory1 = usedMemory3, ma: usedMemory2 = usedMemory3 ) moni: {
	Tuuina-atu tusi: ['No memory leaks here'].
}, sese: {
	Tuuina-atu tusi: ['Leaking memory...'].
}.
