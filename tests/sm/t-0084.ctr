>> makeAdder := { :x
	>> f := { :y <- (lana-lava x + y). } seti: ['x'] tau: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i lana-lava q tuʻu: (lana-lava f faʻaaoga: (lana-lava q ? i)) i: i. } 
	seti: ['q'] tau: array,
	seti: ['f'] tau: func.
	{ :i mapping faʻaaoga: i. } × (array aofaiga).
}.

>> a := Lisi ← 1; 2; 3.
mapper faʻaaoga: a ma: (makeAdder faʻaaoga: 100).
Tuuina-atu tusi: (a tulaga: 0), laina-fou.
Tuuina-atu tusi: (a ? 1), laina-fou.
Tuuina-atu tusi: (a ? 2), laina-fou.
