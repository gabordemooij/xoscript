

# create a 64-bit integer for exact calculations
>> a := Int64 mai-le-manoa: ['123'].

# to string
Tuuina-atu tusi: a, laina-fou.

# divide
Tuuina-atu tusi: a / (Int64 mai-le-manoa: ['3']), laina-fou.

# multiply
Tuuina-atu tusi: a * (Int64 mai-le-manoa: ['2']), laina-fou.

# add
Tuuina-atu tusi: a + (Int64 mai-le-manoa: ['1']), laina-fou.

# subtract
Tuuina-atu tusi: a - (Int64 mai-le-manoa: ['2']), laina-fou.

# compare
Tuuina-atu tusi: ( a =   (Int64 mai-le-manoa: ['123'])), laina-fou.
Tuuina-atu tusi: ( a !=: (Int64 mai-le-manoa: ['124'])), laina-fou.
Tuuina-atu tusi: ( a <   (Int64 mai-le-manoa: ['124'])), laina-fou.
Tuuina-atu tusi: ( a >   (Int64 mai-le-manoa: ['122'])), laina-fou.
Tuuina-atu tusi: ( a >=: (Int64 mai-le-manoa: ['123'])), laina-fou.
Tuuina-atu tusi: ( a <=: (Int64 mai-le-manoa: ['123'])), laina-fou.





	