['Thousands and decimals'].

>> x := 100000000.5.
>> y := 100000000.5.

Tuuina-atu tusi: (x + y), laina-fou.

>> x := 10040.07.
>> y := 10305.60.

Tuuina-atu tusi: (x + y), laina-fou.

['Decimal'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Tuuina-atu tusi: (x + y + z), laina-fou.

['Weird but valid'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Tuuina-atu tusi: (x + y + z), laina-fou.

>> q := 0.1.2.

Tuuina-atu tusi: (q), laina-fou.

>> q := 012.

Tuuina-atu tusi: (q), laina-fou.
