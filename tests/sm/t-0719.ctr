Server init.
>> fmt := Faatulagaga fou: ['%#3x'].

>> blob := Blob fou: 4.
blob bytes: ( 
	Lisi fou ; 0 ; 1 ; 2 ; 3
).

>> file := Faila fou: ['/tmp/blob'].
file blob: blob.
blob faasaoloto.

>> faitau := file blob.
faitau 
amata: 0 
umi: 4, 
fai taʻitasi: { :i :b 
	Tuuina-atu
	tusi: (fmt faʻaaoga-numera-atoa: b),
	laina-fou.
}.
faitau faasaoloto.
