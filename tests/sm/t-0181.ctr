

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Polokalama pulega-manatua: 0.

>> txt := ['World Salad'].
Tuuina-atu tusi: ['this text contains: '] + ( ( txt vaevae: [' '] ) aofaiga ) + [' words.'], laina-fou.
txt := txt amata: 6 umi: 4.
Tuuina-atu tusi: txt, laina-fou.

Polokalama faamama.

usedMemory1 := (Polokalama manatua-masini ? 0).


txt := ['World Salad'].
Tuuina-atu tusi: ['this text contains: '] + ( ( txt vaevae: [' '] ) aofaiga ) + [' words.'], laina-fou.
txt := txt amata: 6 umi: 4.
Tuuina-atu tusi: txt, laina-fou.

Polokalama faamama.
usedMemory2 := (Polokalama manatua-masini ? 0).


txt := ['World Salad'].
