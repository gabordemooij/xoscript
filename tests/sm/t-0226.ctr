# Test ASCII variants

# Numbers

Tuuina-atu tusi: (2 !=: 3), laina-fou.
Tuuina-atu tusi: (2 <=: 2), laina-fou.
Tuuina-atu tusi: (2 >=: 2), laina-fou.

# Strings

Tuuina-atu tusi: (['b'] >=: ['a']), laina-fou.
Tuuina-atu tusi: (['b'] !=: ['a']), laina-fou.
Tuuina-atu tusi: (['b'] <=: ['c']), laina-fou.

# Bools

Tuuina-atu tusi: (Moni !=: Sese), laina-fou.

# Objects

Tuuina-atu tusi: (Mea fou !=: Mea fou), laina-fou.

# ASCII list symbol <-:

Tuuina-atu tusi: (Lisi <<: 1, ; 2 ; 3) aofaiga = 3, laina-fou.

