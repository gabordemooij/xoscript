Server init.
>> a := Blob fou: 4.
a bytes: ( Lisi fou ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob fou: 4.
b bytes: ( Lisi fou ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
# inherited blob does not get the buffer, so it's useless
# it will pass ctr_accept() but since buffer ptr == null, it will retur
>> c := a fou.
{ 
>> n := a ^ c.
Tuuina-atu tusi: ['xorred:'], laina-fou. 
Tuuina-atu tusi: n, laina-fou. 
} puʻe: { :e Tuuina-atu tusi: e, laina-fou. }, amata.
a faasaoloto.
b faasaoloto.
