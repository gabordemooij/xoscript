Manoa pe-a-oo-mai: ['html'] fai: { <- (
		ia-lava
		sui: ['&'] i-le: ['&amp;'],
		sui: ['<'] i-le: ['&lt;'],
		sui: ['>'] i-le: ['&gt;'],
		sui: ['''] i-le: ['&apos;'],
		sui: ['"'] i-le: ['&quot;']
	).
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Polokalama pulega-manatua: 0.

{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Tuuina-atu tusi: txt kopi-mea html, laina-fou.
Tuuina-atu tusi: txt kopi-mea mataitusi-laiti, laina-fou.
Tuuina-atu tusi: txt kopi-mea mataitusi-tetele, laina-fou.
} amata.

Polokalama faamama.

usedMemory1 := (Polokalama manatua-masini ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Tuuina-atu tusi: txt kopi-mea html, laina-fou.
Tuuina-atu tusi: txt kopi-mea mataitusi-laiti, laina-fou.
Tuuina-atu tusi: txt kopi-mea mataitusi-tetele, laina-fou.
} amata.

Polokalama faamama.
usedMemory2 := (Polokalama manatua-masini ? 0).


{
>> txt := ['<h1>"Hell'o & Goodbye"</h1>'].
Tuuina-atu tusi: txt kopi-mea html, laina-fou.
Tuuina-atu tusi: txt kopi-mea mataitusi-laiti, laina-fou.
Tuuina-atu tusi: txt kopi-mea mataitusi-tetele, laina-fou.
} amata.

Polokalama faamama.
usedMemory3 := (Polokalama manatua-masini ? 0).



( usedMemory1 = usedMemory2 ma: usedMemory1 = usedMemory3, ma: usedMemory2 = usedMemory3 ) moni: {
	Tuuina-atu tusi: ['No memory leaks here'].
}, sese: {
	Tuuina-atu tusi: ['Leaking memory...'].
}.
