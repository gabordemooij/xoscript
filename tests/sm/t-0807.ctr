# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB fou talimalo: ['localhost'],
	igoa-tagata-faaaoga: ['xo'],
	upu-faataga: ['pass123'],
	igoa-faaputuga-faamatalaga: ['xobase'],
	fesootai-atu.

>> mea-suesue := db fesili-faamatalaga: ['SELECT %% FROM'].
{ mea-suesue faatino. } puʻe: { :e
	Tuuina-atu tusi: ( e aofia-ai: ['%%'] ), laina-fou.
}, amata.
