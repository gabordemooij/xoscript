#Linux

(Faila fou: ['/tmp/testje']) o-loʻo-i-ai sese: {
	Polokalama faiga-masini: ['mkdir /tmp/testje'].	
}.

(Faila fou: ['/tmp/testje/file1']) o-loʻo-i-ai sese: {
	Polokalama faiga-masini: ['touch /tmp/testje/file1'].	
}.

(Faila fou: ['/tmp/testje/folder1']) o-loʻo-i-ai sese: {
	Polokalama faiga-masini: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Faila lisi: ['/tmp/testje'].

>> q := Lisi fou.

l taʻitasi: { :k :v v taʻitasi: { :x :y q faaopoopo-i-le-iuga: y. }. }.

>> s := q manoa.

(s aofia-ai: ['file1']) moni:   { Tuuina-atu tusi: ['OK'], laina-fou. }.
(s aofia-ai: ['file2']) moni:   { Tuuina-atu tusi: ['XX'], laina-fou. }.
(s aofia-ai: ['folder1']) moni: { Tuuina-atu tusi: ['OK'], laina-fou. }.
