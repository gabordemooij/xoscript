Tuuina-atu tusi: ['Test object'], laina-fou.
>> greeter := Mea fou.
greeter pe-a-oo-mai: ['name:'] fai: { :igoa
	lana-lava xname := igoa. 
}.
greeter pe-a-oo-mai: ['greet'] fai: {
	Tuuina-atu tusi: ['Hello '] + lana-lava xname, laina-fou.
}.
greeter name: ['Sherlock'].
greeter save-as: ['/tmp/a.bin'].
greeter save-as: ['/tmp/b.bin'].
Tuuina-atu tusi: ['========== RELOADING SNAP:'], laina-fou.
>> b := Mea load-from: ['/tmp/a.bin'].
>> c := Mea load-from: ['/tmp/b.bin'].
b greet.
b name: ['Watson'], greet.
c name: ['Moriarty'], greet.
