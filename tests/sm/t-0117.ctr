>> t := Moni.
(t = Moni) moni: { Tuuina-atu tusi: ['T']. }.
(t = Sese) moni: { Tuuina-atu tusi: ['F']. }.
Tuuina-atu tusi: ['|'].
>> t := Sese.
(t = Moni) moni: { Tuuina-atu tusi: ['T']. }.
(t = Sese) moni: { Tuuina-atu tusi: ['F']. }.
Tuuina-atu tusi: ['|'].
>> f := Moni.
(t = Moni ma: f = Sese) moni: { Tuuina-atu tusi: ['T']. }.
(t = Sese ma: f = Moni) moni: { Tuuina-atu tusi: ['F']. }.
Tuuina-atu tusi: ['|'].
>> n := Leai-se-mea.
(n Leai-se-mea?) moni: { Tuuina-atu tusi: ['T']. }.
(n Leai-se-mea?) sese: { Tuuina-atu tusi: ['F']. }.
Tuuina-atu tusi: ['|'].
(f Boolean?) moni: { Tuuina-atu tusi: ['T']. }.
(f Boolean?) sese: { Tuuina-atu tusi: ['F']. }.



