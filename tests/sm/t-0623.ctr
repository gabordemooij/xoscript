

>> g := Server fou.
>> v := Pusa-malu fou.
>> ok := 0.

>> secrets := Lisi fou ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> passwords := secrets kopi-mea.
passwords taʻitasi: { :i :p
	secrets taʻitasi: { :n :s
		{
			>> encrypted := v natia: s ki: p.
			>> decrypted := v faaali: encrypted ki: p.
			(decrypted = s) moni: {
				ok faʻaopoopo: 1.
			}, a-leai: {
				Tuuina-atu tusi: ['failed encrypting/decrypting: '], laina-fou.
				Tuuina-atu tusi: s, laina-fou.
				Tuuina-atu tusi: ['encrypted: '] + encrypted, laina-fou.
				Tuuina-atu tusi: ['decrypted: '] + encrypted, laina-fou.
				Polokalama iuga.
			}.
		} puʻe: { :err
			(s = [''] poʻo: p = ['']) moni: {
				ok faʻaopoopo: 1.
			}, a-leai: {
				Tuuina-atu tusi: err, laina-fou.
				Polokalama iuga.
			}.
		}, amata.
	}.
}.

Tuuina-atu tusi: ( ok + [' vault encryptions tested.'] ), laina-fou.