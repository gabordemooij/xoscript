Server init.
>> f := Faatulagaga fou: ['%d'].
>> a := Blob fou: 4.
a bytes: ( Lisi fou ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob fou: 4.
b bytes: ( Lisi fou ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a amata: 0 umi: 3, taʻitasi: { :i :byte
	Tuuina-atu tusi: ( f faʻaaoga-numera-atoa: byte ), laina-fou.
}.
a ^ b.
a amata: 0 umi: 3, taʻitasi: { :i :byte
	Tuuina-atu tusi: ( f faʻaaoga-numera-atoa: byte ), laina-fou.
}.
a ^ b.
a amata: 0 umi: 3, taʻitasi: { :i :byte
	Tuuina-atu tusi: ( f faʻaaoga-numera-atoa: byte ), laina-fou.
}.
a faasaoloto.
b faasaoloto.

{ a ^ Mea. } puʻe: { :e Tuuina-atu tusi: e, laina-fou. }, amata.
