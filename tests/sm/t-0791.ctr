Server init.

>> DB := Maria-DB fou talimalo: ['localhost'],
	igoa-tagata-faaaoga: ['xo'],
	upu-faataga: ['pass123'],
	igoa-faaputuga-faamatalaga: ['xobase'],
	fesootai-atu.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> mea-suesue := Fesili-Maria fou: SQL.

# set database
mea-suesue faaputuga-faamatalaga: DB.

mea-suesue aumai: { :row
	Tuuina-atu tusi: row world, laina-fou.
}.
