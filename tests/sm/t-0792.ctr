Server init.

>> DB := Maria-DB fou talimalo: ['localhost'],
	igoa-tagata-faaaoga: ['xo'],
	upu-faataga: ['pass123'],
	igoa-faaputuga-faamatalaga: ['xobase'],
	fesootai-atu.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB fesili-faamatalaga: SQL.

# now you don't have to set DB
query2 aumai: { :row
	Tuuina-atu tusi: row world, laina-fou.
}.
