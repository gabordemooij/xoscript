
>> Greeter := Mea fou.
Greeter pe-a-oo-mai: ['fou'] fai: {
	lana-lava igoa := ['?'].
}.
Greeter pe-a-oo-mai: ['name:'] fai: { :igoa
	lana-lava igoa := igoa.
}.
Greeter pe-a-oo-mai: ['greet'] fai: {
	Tuuina-atu tusi: (['hello[you]'] [you]: lana-lava igoa).
}.
>> friend := Greeter fou.
friend name: ['1'].
friend greet.
