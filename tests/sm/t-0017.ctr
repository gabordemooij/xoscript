Numera pe-a-oo-mai: ['factorial'] fai: {
	>> total := 1.
	{ :index total faʻateleina-e: (ia-lava - (index)). } × ia-lava. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Tuuina-atu tusi: a.
>> b := 2 + 3 factorial.
Tuuina-atu tusi: b.
>> c := 3 factorial + 2.
Tuuina-atu tusi: c.
>> d := 2 + (3 factorial).
Tuuina-atu tusi: d.
Tuuina-atu tusi: 2 + 3 factorial + 1.
