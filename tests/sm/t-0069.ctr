

Manoa pe-a-oo-mai: ['html'] fai: { <- (
		ia-lava
		sui: ['&'] i-le: ['&amp;'],
		sui: ['<'] i-le: ['&lt;'],
		sui: ['>'] i-le: ['&gt;'],
		sui: ['"'] i-le: ['&quot;']
	).
}.


Tuuina-atu tusi: ([' left trimmed '] tipi-avanoa) + [' '] + ( ['and right trimmed'] tipi-avanoa) + ['!'], laina-fou.
Tuuina-atu tusi: ['<html>"html & entities"</html>'] html.
