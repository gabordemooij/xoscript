

Lisi pe-a-oo-mai: ['column:'] fai: { :column
	>> result := Lisi fou.
	ia-lava taʻitasi: { :index :row
		row taʻitasi: { :index :cell
			(index = column) moni: { result faaopoopo-i-le-iuga: cell. }.
		}.
	}. <- result.
}.


>> a := Lisi ←
	(Lisi ← 1 ; 2 ; 3) ;
	(Lisi ← 4 ; 5 ; 6) ;
	(Lisi ← 7 ; 8 ; 9).

>> b := a column: 1.
Tuuina-atu tusi: b, laina-fou.

b := a column: 20.
Tuuina-atu tusi: b, laina-fou.

b := a column: -100.
Tuuina-atu tusi: b, laina-fou.
