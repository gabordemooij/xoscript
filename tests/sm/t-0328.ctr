Polokalama pulega-manatua: 4.

>> Doubler := Mea fou.
>> Multiplier := Mea fou.
Doubler pe-a-oo-mai: ['double:and:'] fai: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier pe-a-oo-mai: ['multiply:and:'] fai: { :x :y <- (x × y).
}.

Tuuina-atu tusi: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), laina-fou.
