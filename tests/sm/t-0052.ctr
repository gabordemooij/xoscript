>> items := Lomifefiloi fou.
items tuʻu: ['green'] i: ['color-1'].
items tuʻu: ['orange'] i: ['color-2'].
items tuʻu: ['red'] i: ['color-3'].
>> i := 0.
>> s := [''].
items taʻitasi: { :key :color
	Tuuina-atu tusi: ['color #'] + i + [' is: '] + color + [' '].
	i faʻaopoopo: 1.
}.
Tuuina-atu tusi: i + [' colors!'].
