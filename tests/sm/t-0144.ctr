



>> CoffeeGrounds := Mea fou.
CoffeeGrounds pe-a-oo-mai: ['extract'] fai: { <- ['coffee']. }.

>> CoffeeMachine := Mea fou.
CoffeeMachine pe-a-oo-mai: ['init'] fai: {
	lana-lava coffeegrounds := CoffeeGrounds fou.
}.
CoffeeMachine pe-a-oo-mai: ['fou'] fai: { <- CoffeeMachine `new init.
}.

CoffeeMachine pe-a-oo-mai: ['makeTea'] fai: { <- (lana-lava tealeaves extract). }.
CoffeeMachine pe-a-oo-mai: ['makeCoffee'] fai: { <- (lana-lava coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine fou.

Tuuina-atu tusi:
	coffeeDream 
	makeCoffee.

Tuuina-atu tusi:
	coffeeDream 
	makeTea.
