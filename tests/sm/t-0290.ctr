# test list operations


>> cakes := Lisi ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes sui: 1 umi: 2 i-le: ( Lisi ← ['cinnamon'] ; ['pineapple'] ).
Tuuina-atu tusi: (buy tuufaatasi: [',']), laina-fou.


>> buy := cakes sui: 1 umi: 12 i-le: ( Lisi ← ['cinnamon'] ; ['pineapple'] ).
Tuuina-atu tusi: (buy tuufaatasi: [',']), laina-fou.


>> buy := cakes sui: 2 umi: 10 i-le: ( Lisi fou ).
Tuuina-atu tusi: (buy tuufaatasi: [',']), laina-fou.


>> buy := cakes sui: 0 umi: 1 i-le: ( Lisi fou ).
Tuuina-atu tusi: (buy tuufaatasi: [',']), laina-fou.


>> buy := cakes sui: ['0'] umi: ['1'] i-le: ['x'].
Tuuina-atu tusi: (buy tuufaatasi: [',']), laina-fou.
