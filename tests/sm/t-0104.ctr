
{ :i
	Tuuina-atu tusi: ['This is step #'] + ( ( i ) + 1 ), laina-fou.
} × 6.

{ :i
	Tuuina-atu tusi: ['This is step #'] + ( 3 - ( i ) ), laina-fou.
} × 6.

{ :i
	Tuuina-atu tusi: ['NEVER!'], laina-fou.
} × 0.



{ :i
	Tuuina-atu tusi: ['This is step #'] + ( -3 + ( ( i ) ÷ 2 ) ), laina-fou.
} × 11.
