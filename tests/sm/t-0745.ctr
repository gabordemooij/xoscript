Tuuina-atu tusi: ['Test object'], laina-fou.
>> a := Mea fou. 

a pe-a-oo-mai: ['item:'] fai: { :dict
	lana-lava dict := dict. 
}.

a pe-a-oo-mai: ['item'] fai: { <- lana-lava dict.
}.

a item: (
Lomifefiloi fou
	hello: ['world']).

>> old-dict-address := a item faataitaiga-muamua tuatusi-manatua.
a save-as: ['/tmp/a.bin'].
Tuuina-atu tusi: ['========== RELOADING SNAP:'], laina-fou.

>> b := Mea load-from: ['/tmp/a.bin'].

(b item faataitaiga-muamua tuatusi-manatua = old-dict-address) moni: {
	Tuuina-atu tusi: ['Object link re-attached.'], laina-fou.
}.

Tuuina-atu tusi: b item, laina-fou.
