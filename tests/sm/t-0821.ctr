# a quote that never closes must give an error, not an endless loop
>> ala-faila := ['/tmp/test0821.csv'].
>> file := Faila fou: ala-faila.

file tusi: ['a,b\n"1,2\n'].
{
	file vaeluaga: [','] faailoga-upusii: ['"'] laina-uma: { :line
		Tuuina-atu tusi: line, laina-fou.
	}.
} puʻe: { :e Tuuina-atu tusi: e, laina-fou. }, amata.

# a closed quote still works
file tusi: ['a,b\n"1,2",3'].
file vaeluaga: [','] faailoga-upusii: ['"'] laina-uma: { :line
	Tuuina-atu tusi: line, laina-fou.
}.
file tape.
