#Linux
>> Slurp := Mea fou.

Slurp pe-a-oo-mai: ['fou'] fai: {
	lana-lava str := [''].
}.

Slurp pe-a-oo-mai: ['nieuw'] fai: {
	lana-lava str := [''].
}.

Slurp pe-a-oo-mai: ['tali-atu:'] fai: { :blah
		lana-lava str faaopoopo-i-le-iuga: blah.
}.

Slurp pe-a-oo-mai: ['tali-atu:ma:'] fai: { :blah :blahah
		lana-lava str faaopoopo-i-le-iuga: (blah amata: 0 umi: (blah umi - 1)).
		lana-lava str faaopoopo-i-le-iuga: [' '].
		lana-lava str faaopoopo-i-le-iuga: blahah.
}.

Slurp pe-a-oo-mai: ['obtain'] fai: {
	>> buffer := lana-lava str.
	lana-lava str := ['']. <- buffer.
}.


Tuuina-atu tusi: (Polokalama faiga-masini: (Slurp fou echo: ['Hello I can write to console using fluid API!'], obtain)).


{ Faila fou: ['/tmp/from.txt'], tape. } puʻe: { ['Empty']. }, amata.
{ Faila fou: ['/tmp/to.txt'], tape. } puʻe: { ['Empty']. }, amata.


Faila fou: ['/tmp/to.txt'], o-loʻo-i-ai sese: {
	Tuuina-atu tusi: ['Confirmed. Target file does not exist.\
'].
}.
Faila fou: ['/tmp/from.txt'], o-loʻo-i-ai sese: {
	Tuuina-atu tusi: ['Confirmed. Source file does not exist.\
'].
}.



Polokalama faiga-masini: (Slurp fou touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], obtain).



Polokalama faiga-masini: (Slurp fou cp: ['/tmp/from.txt /tmp/to.txt'], obtain).

Faila fou: ['/tmp/to.txt'], o-loʻo-i-ai moni: {
	Tuuina-atu tusi: ['Confirmed. Target file has been created by shell.\
'].
}.


Tuuina-atu tusi: ['Contents of file is:'] + (Faila fou: ['/tmp/to.txt'], faitau), laina-fou.
