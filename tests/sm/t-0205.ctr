>> str := ['write:'].
Tuuina-atu feʻau: ['tusi:'] mea-tuuina: (Lisi ← ['Hello World']), laina-fou. 

Numera pe-a-oo-mai: ['isbetween:and:'] fai: { :a :b <- ((ia-lava ≥ a) ma: (ia-lava ≤ b)).
}.

str := ['isbetween:and:'].
Tuuina-atu tusi: (3 feʻau: str mea-tuuina: (Lisi ← 2 ; 8)), laina-fou.
Tuuina-atu tusi: (3 feʻau: str mea-tuuina: (Lisi ← 1 ; 2)), laina-fou.


>> CoffeeMachine := Mea fou.
CoffeeMachine pe-a-oo-mai: ['makeCoffeeWithSugar:milk:'] fai: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Lisi ← 4 ; 2.
Tuuina-atu tusi: ( CoffeeMachine feʻau: order mea-tuuina: coffeeConfiguration ), laina-fou.
