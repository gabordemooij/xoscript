# a value ending in the first part of an opening quote must survive serialization
>> tau-uma := Lisi fou
	; ['abc\[']
	; ['\[']
	; ['\[\[']
	; ['x\\\[']
	; ['abc'].

tau-uma taʻitasi: { :i :value
	>> d := Lomifefiloi fou.
	d tuʻu: value i: ['k'].
	d tuʻu: ['second'] i: ['j'].
	>> r := d faʻailoga mea.
	Tuuina-atu tusi: r aofaiga, laina-fou.
	Tuuina-atu tusi: ( (r i: ['k']) = value ), laina-fou.
}.
