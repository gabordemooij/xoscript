Numera pe-a-oo-mai: ['factorial'] fai: {
	>> total := 1.
	{ :index total faʻateleina-e: (ia-lava - index). } × ia-lava. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

