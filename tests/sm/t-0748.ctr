Tuuina-atu tusi: ['Test object'], laina-fou.
>> a := Mea fou. 

a pe-a-oo-mai: ['item:'] fai: { :moni-pe-sese
	lana-lava moni-pe-sese := moni-pe-sese. 
}.

a pe-a-oo-mai: ['item'] fai: { <- lana-lava moni-pe-sese.
}.

a item: Moni.

Tuuina-atu tusi: a item, laina-fou.

>> old-bool-address := a item faataitaiga-muamua tuatusi-manatua.
a save-as: ['/tmp/a.bin'].
Tuuina-atu tusi: ['========== RELOADING SNAP:'], laina-fou.

>> b := Mea load-from: ['/tmp/a.bin'].

(b item faataitaiga-muamua tuatusi-manatua = old-bool-address) moni: {
	Tuuina-atu tusi: ['Object link re-attached.'], laina-fou.
}.

Tuuina-atu tusi: b item, laina-fou.
