# compliance test

# use international numbers

Tuuina-atu tusi: ['1000 -> '].
Tuuina-atu tusi: 1000, laina-fou. #1000

Tuuina-atu tusi: ['1.5 -> '].
Tuuina-atu tusi: 1.5, laina-fou.  #1.5

Tuuina-atu tusi: ['1001.5 -> '].
Tuuina-atu tusi: 1.5 + 1000, laina-fou. #1001.5

# use 0-indexed arrays
>> x := Lisi fou ; 1 ; 2 ; 3.
>> y := Lisi fou ; ['a'] ; ['b'] ; ['c'].

Tuuina-atu tusi: ['1 -> '].
Tuuina-atu tusi: x ? 0, laina-fou. #1

Tuuina-atu tusi: ['1 -> '].
Tuuina-atu tusi: (x i: 0), laina-fou. #1

Tuuina-atu tusi: ['1 -> '].
Tuuina-atu tusi: x tulaga-tasi, laina-fou. #1

Tuuina-atu tusi: ['3 -> '].
Tuuina-atu tusi: x mulimuli, laina-fou. #3

Tuuina-atu tusi: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Tuuina-atu tusi: (x e-tusa-ai: y), laina-fou.

Tuuina-atu tusi: ['1 -> '].
Tuuina-atu tusi: (x amata: 0 umi: 1) tulaga-tasi, laina-fou. #1

Tuuina-atu tusi: ['0 -> '].
Tuuina-atu tusi: (x saili: 1), laina-fou. #0

x tuʻu: 9 i: 0.

Tuuina-atu tusi: ['9 -> '].
Tuuina-atu tusi: (x i: 0), laina-fou. #9

x faaopoopo-i-le-amataga: 8.
Tuuina-atu tusi: ['8 -> '].
Tuuina-atu tusi: (x i: 0), laina-fou. #9


x faaopoopo-i-le-iuga: 10.
Tuuina-atu tusi: ['10 -> '].
Tuuina-atu tusi: (x i: 4), laina-fou. #10








