Tuuina-atu tusi: ['Test object'], laina-fou.
>> a := Mea fou. 

a pe-a-oo-mai: ['item:'] fai: { :num
	lana-lava num := num. 
}.

a pe-a-oo-mai: ['item'] fai: { <- lana-lava num.
}.

a item: 123.

Tuuina-atu tusi: a item, laina-fou.

>> old-num-address := a item faataitaiga-muamua tuatusi-manatua.
a save-as: ['/tmp/a.bin'].
Tuuina-atu tusi: ['========== RELOADING SNAP:'], laina-fou.

>> b := Mea load-from: ['/tmp/a.bin'].

(b item faataitaiga-muamua tuatusi-manatua = old-num-address) moni: {
	Tuuina-atu tusi: ['Object link re-attached.'], laina-fou.
}.

Tuuina-atu tusi: b item, laina-fou.
