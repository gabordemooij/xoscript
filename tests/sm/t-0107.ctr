
Tuuina-atu tusi: ['Break for-loop, 0-4.'], laina-fou.
{ :i
	Tuuina-atu tusi: ['iteration #'] + i, laina-fou.
	(i = 4) motusia.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Tuuina-atu tusi: ['Break while-true loop, 0-4.'], laina-fou.
{
	Tuuina-atu tusi: ['iteration #'] + x, laina-fou.
	x faʻaopoopo: 1.
	((x < 5) faʻafeagai) motusia.
} ao: xIsLessThan10.

Tuuina-atu tusi: ['Break while-false loop, 5,4.'], laina-fou.
{
	Tuuina-atu tusi: ['iteration #'] + x, laina-fou.
	x toesea: 1.
	(x = 3) motusia.
} ao: { <- (x > 0). }.

Tuuina-atu tusi: ['Break times loop, 1-4.'], laina-fou.
{ :i
	Tuuina-atu tusi: ['iteration #'] + i, laina-fou.
	(i = 4) motusia.
} × 5.

Tuuina-atu tusi: ['Break block, dont print line.'], laina-fou.
{ Moni motusia. Tuuina-atu tusi: ['dont write this!'], laina-fou. } amata.

Tuuina-atu tusi: ['Break block, dont fire catch...'], laina-fou.
{ Moni motusia. Tuuina-atu tusi: ['dont write this!'], laina-fou. } puʻe: { Tuuina-atu tusi: ['Dont catch this!']. }, amata.

Tuuina-atu tusi: ['Test Array each-loop: 0,1'], laina-fou.
(Lisi ← 1 ; 2 ; 3) sui-taʻitasi: { :i
	Tuuina-atu tusi: ['iteration #'] + i, laina-fou.
	(i = 1) motusia.
}.

Tuuina-atu tusi: ['Test Map each-loop: c only'], laina-fou.
>> m := Lomifefiloi fou.
m tuʻu: ['first'] i: ['a'], tuʻu: ['second'] i: ['b'], tuʻu: ['third'] i: ['c'].
m taʻitasi: { :k :v
	Tuuina-atu tusi: ['iteration'] + v + k, laina-fou.
	Moni motusia.
}.

