>> Animal := Mea fou.
Animal pe-a-oo-mai: ['make'] fai: {
	>> animal := Mea fou.
	animal pe-a-oo-mai: ['makeSound'] fai: {
		Tuuina-atu tusi: lana-lava sound.
	}. <- animal.
}.
>> Cat := Mea fou.
Cat pe-a-oo-mai: ['make'] fai: {
	>> cat := Animal make.
	cat pe-a-oo-mai: ['init'] fai: {
		lana-lava sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
