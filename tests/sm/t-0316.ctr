>> Grandfather := Mea fou.
Grandfather pe-a-oo-mai: ['greet'] fai: {
	Tuuina-atu tusi: ['Ave!'], laina-fou.
}.
>> Father := Grandfather fou.
Father pe-a-oo-mai: ['greet'] fai: {
	Tuuina-atu tusi: ['Hello'], laina-fou.
	ia-lava greet.
}.
>> Son := Father fou.
Son pe-a-oo-mai: ['greet'] fai: {
	Tuuina-atu tusi: ['Hi'], laina-fou.
	ia-lava greet.
}.

Son greet.

>> Roundabout := Mea fou.
Roundabout pe-a-oo-mai: ['circle:'] fai: { :x
	Tuuina-atu tusi: x, laina-fou.
	(x < 3) moni: { ia-lava valaau-ia-lava circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) moni: { Tuuina-atu tusi: x, laina-fou. x faʻaopoopo: 1.  increment amata. }. }.
increment amata.