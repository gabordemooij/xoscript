Server init.

# create a memory block of 10 bytes
>> manatua-masini := Blob fou: 10.

# fill it with 3 bytes
manatua-masini bytes: ( Lisi fou ; 65 ; 66 ; 67 ).

# write the bytes to StdOut as a string
Tuuina-atu tusi: manatua-masini manoa, laina-fou.

# free the memory block
manatua-masini faasaoloto.

