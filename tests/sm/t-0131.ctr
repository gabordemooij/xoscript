
>> a := Lisi ← (Lisi ← 100 ; 200 ; 300) ; (Lisi ← 9 ; 8 ; 7).
Tuuina-atu tusi: ['at 0,1 :'].
Tuuina-atu tusi: a ? 0 ? 1, laina-fou. 
Tuuina-atu tusi: ['at 1,2 :'].
Tuuina-atu tusi: a ? 1 ? 2, laina-fou. 
>> menu := Lomifefiloi fou.
menu tuʻu: (Lisi ← ['pizza'] ; ['spaghetti']) i: ['Italian Cuisine'].
menu tuʻu: (Lisi ← ['bifteki'] ; ['suflaki']) i: ['Greek Cuisine'].
Tuuina-atu tusi: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), laina-fou. 
Tuuina-atu tusi: ['but not on the same plate.'], laina-fou.
