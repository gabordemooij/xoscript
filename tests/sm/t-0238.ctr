Manoa pe-a-oo-mai: ['evaluate'] fai: {
	>> faʻailoga := Faila fou: ['/tmp/eval.ctr'].
	faʻailoga tusi: (ia-lava manoa + ['.']).
	Polokalama faʻaoga: ['/tmp/eval.ctr'].
}.

>> a := Lisi ← 1 ; 2 ; 3.
>> b := (a manoa).

Tuuina-atu tusi: b, laina-fou. 
(['b := '] + b) evaluate.

Tuuina-atu tusi: b ? 2, laina-fou. 

Tuuina-atu tusi: (( Lisi ← 1 ; 2 ; 3 )), laina-fou. 

Tuuina-atu tusi: ((Lomifefiloi fou) tuʻu: 1 i: 2), laina-fou. 

>> x := ( (Lisi ← 1 ; ( Lisi ← 9 ) ; Moni ) ) manoa.
Tuuina-atu tusi: x, laina-fou. 
(['x := '] + x) evaluate.

Tuuina-atu tusi: x ? 1 ? 0, laina-fou. 

>> y := (Lomifefiloi fou) tuʻu: (Lisi ← 1) i: (Lisi ← 2).
Tuuina-atu tusi: y, laina-fou. 

(['y := '] + y) manoa evaluate.

Tuuina-atu tusi: (y i: (Lisi ← 2) manoa ), laina-fou.

Tuuina-atu tusi: (Lisi fou), laina-fou. 
Tuuina-atu tusi: (Lomifefiloi fou), laina-fou. 
