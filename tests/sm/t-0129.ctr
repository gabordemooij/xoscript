
Lisi pe-a-oo-mai: ['product'] fai: {
	>> total := 1.
	ia-lava taʻitasi: { :index :element
		total faʻateleina-e: element.
	}. <- total.
}.

>> a := Lisi ← 1 ; 2 ; 3.
Tuuina-atu tusi: a product, laina-fou.
Tuuina-atu tusi: (Lisi ← 2 ; 4 ; 8) product, laina-fou. 
Tuuina-atu tusi: (Lisi ← -2 ; 10) product, laina-fou. 
Tuuina-atu tusi: (Lisi ← 0.5 ; -2) product, laina-fou. 
