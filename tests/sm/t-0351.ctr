
>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

>> faʻailoga := {
	>> o := (
		Lomifefiloi fou
		aa: (Lisi ← 1 ; 2),
		bb: (Lisi ← 3 ; 4)
	).
	>> s := o manoa.
	>> o2 := s mea.
	(s  ituaiga = Manoa ituaiga) moni: { Tuuina-atu tusi: ['OK1'], laina-fou. }.
	(o2 ituaiga = Lomifefiloi ituaiga) moni: { Tuuina-atu tusi: ['OK2'], laina-fou. }.
}.

Polokalama pulega-manatua: 0.
['Memory 1 will be different because tracked blocks are added in bulk.'].
Polokalama faamama.
usedMemory1 := (Polokalama manatua-masini ? 1).
faʻailoga amata.
Polokalama faamama.
usedMemory2 := (Polokalama manatua-masini ? 1).
faʻailoga amata.
Polokalama faamama.
usedMemory3 := (Polokalama manatua-masini ? 1).
faʻailoga amata.
Polokalama faamama.
usedMemory4 := (Polokalama manatua-masini ? 1).

(usedMemory2 = usedMemory3 = usedMemory4) moni: { Tuuina-atu tusi: ['OK3'], laina-fou. }.
 
