Tuuina-atu tusi: ['Test object'], laina-fou.
>> a := Mea fou. 

a pe-a-oo-mai: ['item:'] fai: { :moment
	lana-lava moment := moment. 
}.

a pe-a-oo-mai: ['item'] fai: { <- lana-lava moment.
}.

>> today := Taimi fou sone: ['CEST'], tausaga: 2026, masina: 7.
a item: today.
Tuuina-atu tusi: a item, laina-fou.
a save-as: ['/tmp/a.bin'].
Tuuina-atu tusi: ['========== RELOADING SNAP:'], laina-fou.
>> b := Mea load-from: ['/tmp/a.bin'].
Tuuina-atu tusi: b item, laina-fou.
