>> x := Đối-tượng mới.
>> y := Đối-tượng mới.
>> z := x.
Xuất ghi: (x = z), xuống-dòng.
Xuất ghi: (x = y), xuống-dòng.
Xuất ghi: (x ≠ y), xuống-dòng.
Xuất ghi: (x ≠ z), xuống-dòng.
>> m := Thời-điểm mới năm: 2070, tháng: 11.
>> n := m sao-chép.
Xuất ghi: (m = n), xuống-dòng.
Xuất ghi: (m ≠ n), xuống-dòng.
Xuất ghi: (m chính-là: m), xuống-dòng.
Xuất ghi: (m chính-là: n), xuống-dòng.
n tháng: 12.
Xuất ghi: (m ≠ n), xuống-dòng.
Xuất ghi: (m = n), xuống-dòng.


