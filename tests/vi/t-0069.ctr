

Chuỗi khi: ['html'] làm: { <- (
		bản-thân
		thay: ['&'] bằng: ['&amp;'],
		thay: ['<'] bằng: ['&lt;'],
		thay: ['>'] bằng: ['&gt;'],
		thay: ['"'] bằng: ['&quot;']
	).
}.


Xuất ghi: ([' cắt trái '] cắt-khoảng-trắng) + [' '] + ( ['và cắt phải'] cắt-khoảng-trắng) + ['!'], xuống-dòng.
Xuất ghi: ['<html>"html & entities"</html>'] html.
