

Chuỗi khi: ['html'] làm: { <- (
		bản-thân
		thay: ['&'] bằng: ['&amp;'],
		thay: ['<'] bằng: ['&lt;'],
		thay: ['>'] bằng: ['&gt;'],
		thay: ['"'] bằng: ['&quot;']
	).
}.


Xuất ghi: ([' left trimmed '] cắt-khoảng-trắng) + [' '] + ( ['and right trimmed'] cắt-khoảng-trắng) + ['!'], xuống-dòng.
Xuất ghi: ['<html>"html & entities"</html>'] html.
