# test qualifiers

>> $ := Đối-tượng mới.

$ khi: ['đáp:'] làm: { :x
	
	>> operation := x ký-tự: 0.
	>> valuta := x ký-tự: 1.
	>> money := x bỏ-qua: 2.
	
	>> amount := 0.

	( operation = ['+'] ) đúng: {
		( valuta = ['£'] ) đúng: { amount := 1.28 × money. }.
	}. <- amount.
}.



>> x := $ +£20.

Xuất ghi: x, xuống-dòng.


>> Fruit := Đối-tượng mới.

Fruit khi: ['mới'] làm: {
	>> f := bản-thân mới.
	f apples: 0.
	f oranges: 0. <- f.
}.

Fruit khi: ['apples:'] làm: { :a riêng apples := a. }.
Fruit khi: ['oranges:'] làm: { :p riêng oranges := p. }.
Fruit khi: ['apples'] làm: { <- riêng apples. }.
Fruit khi: ['oranges'] làm: { <- riêng oranges. }.

Fruit khi: ['+'] làm: { :f
	
	>> n := Fruit mới.
	f cộng: 1.
	
	n apples: (f apples + riêng apples).
	n oranges:  (f oranges  + riêng oranges). <- n.
}.

Fruit khi: ['chuỗi'] làm: { <- ( riêng apples chuỗi + [' apples and '] + riêng oranges + [' oranges'] ).
}.

Số khi: ['apples'] làm: { <- ((Fruit mới) apples: bản-thân).
}.

Số khi: ['apple'] làm: { <- ((Fruit mới) apples: bản-thân).
}.

Số khi: ['oranges'] làm: { <- ((Fruit mới) oranges: bản-thân).
}.




Xuất ghi: (1 apple + 3 oranges + 4 apples), xuống-dòng.


Chuỗi khi: ['twice'] làm: { <- ((bản-thân chuỗi) + (bản-thân chuỗi)).
}.



Xuất ghi: ['❤❤❤'] twice.



