# kiểm thử đơn vị (qualifier)

>> $ := Đối-tượng mới.

$ khi: ['đáp:'] làm: { :x
	
	>> phép-toán := x ký-tự: 0.
	>> ký-hiệu-tiền := x ký-tự: 1.
	>> tiền := x bỏ-qua: 2.
	
	>> số-lượng := 0.

	( phép-toán = ['+'] ) đúng: {
		( ký-hiệu-tiền = ['£'] ) đúng: { số-lượng := 1.28 × tiền. }.
	}. <- số-lượng.
}.



>> x := $ +£20.

Xuất ghi: x, xuống-dòng.


>> Trái-cây := Đối-tượng mới.

Trái-cây khi: ['mới'] làm: {
	>> f := bản-thân mới.
	f apples: 0.
	f oranges: 0. <- f.
}.

Trái-cây khi: ['apples:'] làm: { :a riêng táo := a. }.
Trái-cây khi: ['oranges:'] làm: { :p riêng cam := p. }.
Trái-cây khi: ['táo'] làm: { <- riêng táo. }.
Trái-cây khi: ['cam'] làm: { <- riêng cam. }.

Trái-cây khi: ['+'] làm: { :f
	
	>> n := Trái-cây mới.
	f cộng: 1.
	
	n apples: (f táo + riêng táo).
	n oranges:  (f cam  + riêng cam). <- n.
}.

Trái-cây khi: ['chuỗi'] làm: { <- ( riêng táo chuỗi + [' táo và '] + riêng cam + [' quả cam'] ).
}.

Số khi: ['táo'] làm: { <- ((Trái-cây mới) apples: bản-thân).
}.

Số khi: ['apple'] làm: { <- ((Trái-cây mới) apples: bản-thân).
}.

Số khi: ['cam'] làm: { <- ((Trái-cây mới) oranges: bản-thân).
}.




Xuất ghi: (1 apple + 3 cam + 4 táo), xuống-dòng.


Chuỗi khi: ['hai-lần'] làm: { <- ((bản-thân chuỗi) + (bản-thân chuỗi)).
}.



Xuất ghi: ['❤❤❤'] hai-lần.



