>> Người-chào := Đối-tượng mới.
Người-chào khi: ['tạo'] làm: {
	>> nc := Đối-tượng mới.
	nc khi: ['setName:'] làm: { :một-tên
		riêng tên := một-tên.
	}.
	nc khi: ['chào'] làm: {
		Xuất ghi: riêng tên.
	}. <- nc.
}.
>> a := Người-chào tạo.
>> b := Người-chào tạo.
a setName: ['MỘT'].
b setName: ['HAI'].
a chào.
b chào.
>> c := a mới.
c setName: ['BA'].
c chào.
>> d := a mới.
d setName: ['BỐN'].
d chào.
c chào.
