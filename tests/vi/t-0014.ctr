>> Greeter := Đối-tượng mới.
Greeter khi: ['make'] làm: {
	>> gr := Đối-tượng mới.
	gr khi: ['setName:'] làm: { :aname
		riêng tên := aname.
	}.
	gr khi: ['greet'] làm: {
		Xuất ghi: riêng tên.
	}. <- gr.
}.
>> a := Greeter make.
>> b := Greeter make.
a setName: ['ONE'].
b setName: ['TWO'].
a greet.
b greet.
>> c := a mới.
c setName: ['THREE'].
c greet.
>> d := a mới.
d setName: ['FOUR'].
d greet.
c greet.
