['Hàng nghìn và số thập phân'].

>> x := 100000000.5.
>> y := 100000000.5.

Xuất ghi: (x + y), xuống-dòng.

>> x := 10040.07.
>> y := 10305.60.

Xuất ghi: (x + y), xuống-dòng.

['Thập phân'].

>> x := 1.001.
>> y := 1.100.
>> z := 1.010.

Xuất ghi: (x + y + z), xuống-dòng.

['Lạ nhưng hợp lệ'].

>> x := 01.001.
>> y := 01.100.
>> z := 01.010.

Xuất ghi: (x + y + z), xuống-dòng.

>> q := 0.1.2.

Xuất ghi: (q), xuống-dòng.

>> q := 012.

Xuất ghi: (q), xuống-dòng.
