>> items := Từ-điển mới.
items đặt: ['black'] tại: ['coffee'], đặt: ['earl grey'] tại: ['tea'].
Xuất ghi: (items tại: ['coffee']), ghi: (items tại: ['tea']).
Xuất ghi: ['there are'] + items đếm + [' items in the array.'].
items đặt: ['capuccino'] tại: ['coffee'].
Xuất ghi: ['Now my coffee is.. '] + (items tại: ['coffee']).
items đặt: ['aaa'] tại: ['1'].
items đặt: ['bbb'] tại: ['2'].
Xuất ghi: (items tại: ['a']).
