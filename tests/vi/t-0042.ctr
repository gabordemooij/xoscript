>> items := Từ-điển mới.
items đặt: ['đen'] tại: ['coffee'], đặt: ['earl grey'] tại: ['trà'].
Xuất ghi: (items tại: ['coffee']), ghi: (items tại: ['trà']).
Xuất ghi: ['hiện có'] + items đếm + [' phần tử trong mảng.'].
items đặt: ['cappuccino'] tại: ['coffee'].
Xuất ghi: ['Giờ cà phê của tôi là.. '] + (items tại: ['coffee']).
items đặt: ['aaa'] tại: ['1'].
items đặt: ['bbb'] tại: ['2'].
Xuất ghi: (items tại: ['a']).
