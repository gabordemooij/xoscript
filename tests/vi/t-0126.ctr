#Linux
>> Hút := Đối-tượng mới.

Hút khi: ['mới'] làm: {
	riêng str := [''].
}.

Hút khi: ['nieuw'] làm: {
	riêng str := [''].
}.

Hút khi: ['đáp:'] làm: { :blah
		riêng str thêm-cuối: blah.
}.

Hút khi: ['đáp:và:'] làm: { :blah :blahah
		riêng str thêm-cuối: (blah từ: 0 độ-dài: (blah độ-dài - 1)).
		riêng str thêm-cuối: [' '].
		riêng str thêm-cuối: blahah.
}.

Hút khi: ['thu-về'] làm: {
	>> bộ-đệm := riêng str.
	riêng str := ['']. <- bộ-đệm.
}.


Xuất ghi: (Chương-trình hệ-thống: (Hút mới echo: ['Xin chào, tôi có thể ghi ra console bằng API fluent!'], thu-về)).


{ Tệp mới: ['/tmp/from.txt'], xóa. } bắt-lỗi: { ['Trống']. }, chạy.
{ Tệp mới: ['/tmp/to.txt'], xóa. } bắt-lỗi: { ['Trống']. }, chạy.


Tệp mới: ['/tmp/to.txt'], tồn-tại sai: {
	Xuất ghi: ['Confirmed. Target file does not exist.\
'].
}.
Tệp mới: ['/tmp/from.txt'], tồn-tại sai: {
	Xuất ghi: ['Confirmed. Source file does not exist.\
'].
}.



Chương-trình hệ-thống: (Hút mới touch: ['/tmp/from.txt ;'], echo: ['"hello world" > /tmp/from.txt'], thu-về).



Chương-trình hệ-thống: (Hút mới cp: ['/tmp/from.txt /tmp/to.txt'], thu-về).

Tệp mới: ['/tmp/to.txt'], tồn-tại đúng: {
	Xuất ghi: ['Confirmed. Target file has been created by shell.\
'].
}.


Xuất ghi: ['Nội dung tệp là:'] + (Tệp mới: ['/tmp/to.txt'], đọc), xuống-dòng.
