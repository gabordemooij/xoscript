# public key (to secure APIs etc)
Server init.

# generate keys
>> keys := Két tạo-khóa.

# private (secret) key
>> sk := keys đầu.

# public key
>> pk := keys cuối.

# sign a message
>> sig := Két ký: ['abc'] bằng: sk.

# check message (ok)
Xuất ghi: ( 
	Két
		kiểm-tra: ['abc'] 
		chữ-ký: sig 
		bằng: pk 
), xuống-dòng.

# check message (fail)
Xuất ghi: ( 
	Két 
		kiểm-tra: ['abd'] 
		chữ-ký: sig 
		bằng: pk 
), xuống-dòng.