# khóa công khai (để bảo mật API v.v.)
Server init.

# tạo khóa
>> cặp-khóa := Két tạo-khóa.

# khóa riêng (bí mật)
>> kbm := cặp-khóa đầu.

# khóa công khai
>> kcc := cặp-khóa cuối.

# ký một thông điệp
>> cks := Két ký: ['abc'] bằng: kbm.

# kiểm tra thông điệp (ok)
Xuất ghi: ( 
	Két
		kiểm-tra: ['abc'] 
		chữ-ký: cks 
		bằng: kcc 
), xuống-dòng.

# kiểm tra thông điệp (thất bại)
Xuất ghi: ( 
	Két 
		kiểm-tra: ['abd'] 
		chữ-ký: cks 
		bằng: kcc 
), xuống-dòng.