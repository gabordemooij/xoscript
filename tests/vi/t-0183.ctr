

>> bộ-nhớ-đã-dùng1 := 0.
>> bộ-nhớ-đã-dùng2 := 0.
>> bộ-nhớ-đã-dùng3 := 0.
>> bộ-nhớ-đã-dùng4 := 0.

Chương-trình quản-lý-bộ-nhớ: 0.

>> o := Đối-tượng mới.
>> o2 := Đối-tượng mới.
Xuất ghi: o Rỗng?, xuống-dòng.
Xuất ghi: o kiểu, xuống-dòng.
Xuất ghi: ( o chính-là: o ), xuống-dòng.
Xuất ghi: ( o chính-là: o2 ), xuống-dòng.
Xuất ghi: o chính-mình, xuống-dòng.
Xuất ghi: ( o làm xong ), xuống-dòng.

Chương-trình dọn-dẹp.

bộ-nhớ-đã-dùng1 := (Chương-trình bộ-nhớ ? 0).


o := Đối-tượng mới.
o2 := Đối-tượng mới.
Xuất ghi: o Rỗng?, xuống-dòng.
Xuất ghi: o kiểu, xuống-dòng.
Xuất ghi: ( o chính-là: o ), xuống-dòng.
Xuất ghi: ( o chính-là: o2 ), xuống-dòng.
Xuất ghi: o chính-mình, xuống-dòng.
Xuất ghi: ( o làm xong ), xuống-dòng.

Chương-trình dọn-dẹp.
bộ-nhớ-đã-dùng2 := (Chương-trình bộ-nhớ ? 0).


o := Đối-tượng mới.
o2 := Đối-tượng mới.
Xuất ghi: o Rỗng?, xuống-dòng.
Xuất ghi: o kiểu, xuống-dòng.
Xuất ghi: ( o chính-là: o ), xuống-dòng.
Xuất ghi: ( o chính-là: o2 ), xuống-dòng.
Xuất ghi: o chính-mình, xuống-dòng.
Xuất ghi: ( o làm xong ), xuống-dòng.

Chương-trình dọn-dẹp.
bộ-nhớ-đã-dùng3 := (Chương-trình bộ-nhớ ? 0).



( bộ-nhớ-đã-dùng1 = bộ-nhớ-đã-dùng2 và: bộ-nhớ-đã-dùng1 = bộ-nhớ-đã-dùng3, và: bộ-nhớ-đã-dùng2 = bộ-nhớ-đã-dùng3 ) đúng: {
	Xuất ghi: ['Không rò rỉ bộ nhớ ở đây'].
}, sai: {
	Xuất ghi: ['Đang rò rỉ bộ nhớ...'].
}.
