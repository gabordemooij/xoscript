>> bảng-ánh-xạ1 := Từ-điển mới.
>> khóa1 := Danh-sách mới.
>> khóa2 := Danh-sách mới.

bảng-ánh-xạ1
	đặt: ['hello'] tại: khóa1,
	đặt: ['world'] tại: khóa2.


Xuất
	ghi: ['Map #1 contains: '] + (bảng-ánh-xạ1 tại: khóa1),
	ghi: [' và '] + (bảng-ánh-xạ1 tại: khóa2), xuống-dòng.

>> Mảng-làm-khóa := Danh-sách mới.
Mảng-làm-khóa khi: ['thành-chuỗi'] làm: { <- (bản-thân đếm) thành-chuỗi.
}.

>> map2 := Từ-điển mới.
khóa1 := Mảng-làm-khóa mới.
khóa2 := Mảng-làm-khóa mới.

khóa1 thêm-cuối: 1.

map2
	đặt: ['hello'] tại: khóa1,
	đặt: ['world'] tại: khóa2.

Xuất
	ghi: ['Map #2 contains: '] + (map2 tại: khóa1),
	ghi: [' và '] + (map2 tại: khóa2), xuống-dòng.
