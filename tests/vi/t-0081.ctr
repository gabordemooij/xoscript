>> map1 := Từ-điển mới.
>> key1 := Danh-sách mới.
>> key2 := Danh-sách mới.

map1
	đặt: ['hello'] tại: key1,
	đặt: ['world'] tại: key2.


Xuất
	ghi: ['Map #1 contains: '] + (map1 tại: key1),
	ghi: [' and '] + (map1 tại: key2), xuống-dòng.

>> KeyeableArray := Danh-sách mới.
KeyeableArray khi: ['toString'] làm: { <- (bản-thân đếm) toString.
}.

>> map2 := Từ-điển mới.
key1 := KeyeableArray mới.
key2 := KeyeableArray mới.

key1 thêm-cuối: 1.

map2
	đặt: ['hello'] tại: key1,
	đặt: ['world'] tại: key2.

Xuất
	ghi: ['Map #2 contains: '] + (map2 tại: key1),
	ghi: [' and '] + (map2 tại: key2), xuống-dòng.
