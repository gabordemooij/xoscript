>> To-Do := Đối-tượng mới.

To-Do khi: ['mới'] làm: {
	riêng list := Danh-sách mới.
}.

To-Do khi: ['nieuw'] làm: {
	riêng list := Danh-sách mới.
}.

To-Do khi: ['+'] làm: { :task
	riêng list thêm-cuối: task.
}.

To-Do khi: ['number of tasks?'] làm: { <-  riêng list đếm.
}.

>> todos := 
	To-Do mới 
	+ ['cook dinner'] 
	+ ['clean room'].
	
Xuất ghi: ['You have $ tasks to do'] $ todos number of tasks?.
