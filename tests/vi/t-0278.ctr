>> Việc-cần-làm := Đối-tượng mới.

Việc-cần-làm khi: ['mới'] làm: {
	riêng list := Danh-sách mới.
}.

Việc-cần-làm khi: ['nieuw'] làm: {
	riêng list := Danh-sách mới.
}.

Việc-cần-làm khi: ['+'] làm: { :việc
	riêng list thêm-cuối: việc.
}.

Việc-cần-làm khi: ['number of tasks?'] làm: { <-  riêng list đếm.
}.

>> các-việc-cần-làm := 
	Việc-cần-làm mới 
	+ ['nấu bữa tối'] 
	+ ['dọn phòng'].
	
Xuất ghi: ['You have $ tasks to do'] $ các-việc-cần-làm number of tasks?.
