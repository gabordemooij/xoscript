Server init.

>> CSDL := Maria-DB mới máy-trạm: ['localhost'],
	tên-người-dùng: ['xo'],
	mật-khẩu: ['pass123'],
	tên-cơ-sở-dữ-liệu: ['xobase'],
	kết-nối.
	
>> SQL := ['SELECT "hello" AS "world" '].

# tự tạo truy vấn
>> tham-số-tìm-kiếm := Maria-Truy-vấn mới: SQL.

# đặt cơ sở dữ liệu
tham-số-tìm-kiếm cơ-sở-dữ-liệu: CSDL.

tham-số-tìm-kiếm lấy: { :hàng
	Xuất ghi: hàng world, xuống-dòng.
}.
