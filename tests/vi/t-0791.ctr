Server init.

>> DB := Maria-DB mới máy-trạm: ['localhost'],
	tên-người-dùng: ['xo'],
	mật-khẩu: ['pass123'],
	tên-cơ-sở-dữ-liệu: ['xobase'],
	kết-nối.
	
>> SQL := ['SELECT "hello" AS "world" '].

# manually create query
>> tham-số-tìm-kiếm := Maria-Truy-vấn mới: SQL.

# set database
tham-số-tìm-kiếm cơ-sở-dữ-liệu: DB.

tham-số-tìm-kiếm lấy: { :row
	Xuất ghi: row world, xuống-dòng.
}.
