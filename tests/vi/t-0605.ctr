>> invoice := Đối-tượng mới.
invoice khi: ['chạy'] làm: {
        riêng số := 0.
}.

invoice khi: ['số'] làm: {
        riêng số cộng: 1. <- riêng số sao-chép.
}.

>> year-invoice := invoice mới.
year-invoice khi: ['start:'] làm: { :năm
	riêng số := năm.
}.

year-invoice start: 202000.
Xuất ghi: year-invoice số, xuống-dòng.
Xuất ghi: year-invoice số, xuống-dòng.
