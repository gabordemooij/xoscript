>> hóa-đơn := Đối-tượng mới.
hóa-đơn khi: ['chạy'] làm: {
        riêng số := 0.
}.

hóa-đơn khi: ['số'] làm: {
        riêng số cộng: 1.
        <- riêng số sao-chép.
}.

>> hóa-đơn-năm := hóa-đơn mới.
hóa-đơn-năm khi: ['start:'] làm: { :năm
	riêng số := năm.
}.

hóa-đơn-năm start: 202000.
Xuất ghi: hóa-đơn-năm số, xuống-dòng.
Xuất ghi: hóa-đơn-năm số, xuống-dòng.
