
>> Size := Đối-tượng mới.
Size khi: ['is:'] làm: { :số
	số khi: ['+'] làm: { :số
		>> unit := số đơn-vị.
		>> factor := 1.
		
		unit
		trường-hợp: ['inch'] làm: { factor := 0.0833. }. <- bản-thân + (số * factor).
	}. <- số.
}.

# This size number can be used as follows:

>> plank := Size is: 6 foot.
>> edge := Size is: 50 inch.

# This will show as: 10.165
Xuất ghi: plank + edge, xuống-dòng.
