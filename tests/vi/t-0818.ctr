# edge cases from a request must give an error or a result, not a crash
Server init.

Xuất ghi: ['<'] + (['abc'] từ: 0 độ-dài: 0, chữ-hoa) + ['>'], xuống-dòng.
Xuất ghi: ['<'] + (['abc'] từ: 0 độ-dài: 0, chữ-thường) + ['>'], xuống-dòng.
Xuất ghi: ['<'] + (['abc'] bỏ-qua: 3, chữ-hoa) + ['>'], xuống-dòng.
Xuất ghi: [''] chữ-hoa bytes, xuống-dòng.
Xuất ghi: ['aB'] chữ-hoa, xuống-dòng.
Xuất ghi: ['aB'] chữ-thường, xuống-dòng.

Xuất ghi: (Thời-điểm mới: 0) năm, xuống-dòng.
{ Thời-điểm mới: ['9e300'] số. } bắt-lỗi: { :e Xuất ghi: e, xuống-dòng. }, chạy.
{ Thời-điểm mới: ['-9e300'] số. } bắt-lỗi: { :e Xuất ghi: e, xuống-dòng. }, chạy.
{ Thời-điểm mới: ['nan'] số. } bắt-lỗi: { :e Xuất ghi: e, xuống-dòng. }, chạy.
{ Thời-điểm mới: 9000000000000000000. } bắt-lỗi: { :e Xuất ghi: e, xuống-dòng. }, chạy.
