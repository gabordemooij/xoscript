Xuất ghi: ['Test object'], xuống-dòng.
>> a := Đối-tượng mới. 

a khi: ['item:'] làm: { :hexhelper
	riêng hexhelper := hexhelper. 
}.

a khi: ['item'] làm: { <- riêng hexhelper.
}.

a item: Hx mới.

>> old-hexhelper-address := a item nguyên-mẫu địa-chỉ-bộ-nhớ.
a save-as: ['/tmp/a.bin'].
Xuất ghi: ['========== RELOADING SNAP:'], xuống-dòng.

>> b := Đối-tượng load-from: ['/tmp/a.bin'].

(b item nguyên-mẫu địa-chỉ-bộ-nhớ = old-hexhelper-address) đúng: {
	Xuất ghi: ['Object link re-attached.'], xuống-dòng.
}.
