>> t := Rỗng.

# you can control the time zone for
# parsing like this:
Thời-điểm múi-giờ: ['CET'].
t := Thời-điểm từ: ['1981-02-03 04:05:06'].
Xuất ghi: t, xuống-dòng.

# now using CEST time zone:
Thời-điểm múi-giờ: ['CEST'].
t := Thời-điểm từ: ['1981-02-03 04:05:06'].
Xuất ghi: t, xuống-dòng.

# error if string cannot be parsed
{ Thời-điểm từ: ['1900']. } bắt-lỗi: { Rỗng. }, chạy.
