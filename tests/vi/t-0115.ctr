{
	tác-vụ-này lỗi: ['Dont fail.'].
	unknown doSomething.
} bắt-lỗi: {
	Xuất ghi: ['Caught!'].
}, chạy.

{
	tác-vụ-này lỗi: ['Dont fail.'].
	riêng unknown doSomething.
} bắt-lỗi: {
	Xuất ghi: ['Caught!'].
}, chạy.

{
	tác-vụ-này lỗi: ['Dont fail.'].
	unknown := 122.
} bắt-lỗi: {
	Xuất ghi: ['Caught!'].
}, chạy.


{
	tác-vụ-này lỗi: ['Dont fail.'].
	Đúng ngắt.
	Xuất ghi: ['FAIL'].
} bắt-lỗi: {
	Xuất ghi: ['Caught!'].
}, chạy.

{
	{
		tác-vụ-này lỗi: ['Dont fail.'].
		Đúng ngắt.
		Xuất ghi: ['FAIL'].
	} bắt-lỗi: { :x
		(x = ['Dont fail.']) đúng: { tác-vụ-này lỗi: ['Nested Caught!']. }.
	}, chạy.
} bắt-lỗi: { :e
	Xuất ghi: e.
}, chạy.
