Xuất ghi: ['Test object'], xuống-dòng.
>> a := Đối-tượng mới. 

a khi: ['item:'] làm: { :octhelper
	riêng octhelper := octhelper. 
}.

a khi: ['item'] làm: { <- riêng octhelper.
}.

a item: Oct mới.

>> old-octhelper-address := a item nguyên-mẫu địa-chỉ-bộ-nhớ.
a save-as: ['/tmp/a.bin'].
Xuất ghi: ['========== RELOADING SNAP:'], xuống-dòng.

>> b := Đối-tượng load-from: ['/tmp/a.bin'].

(b item nguyên-mẫu địa-chỉ-bộ-nhớ = old-octhelper-address) đúng: {
	Xuất ghi: ['Object link re-attached.'], xuống-dòng.
}.
