Xuất ghi: ['Đối tượng thử nghiệm'], xuống-dòng.
>> a := Đối-tượng mới. 

a khi: ['item:'] làm: { :trợ-giúp-bát-phân
	riêng trợ-giúp-bát-phân := trợ-giúp-bát-phân. 
}.

a khi: ['mục'] làm: {
	<- riêng trợ-giúp-bát-phân.
}.

a item: Oct mới.

>> địa-chỉ-cũ-trợ-giúp-bát-phân := a mục nguyên-mẫu địa-chỉ-bộ-nhớ.
a save-as: ['/tmp/a.bin'].
Xuất ghi: ['========== ĐANG TẢI LẠI SNAP:'], xuống-dòng.

>> b := Đối-tượng load-from: ['/tmp/a.bin'].

(b mục nguyên-mẫu địa-chỉ-bộ-nhớ = địa-chỉ-cũ-trợ-giúp-bát-phân) đúng: {
	Xuất ghi: ['Liên kết đối tượng đã được gắn lại.'], xuống-dòng.
}.
