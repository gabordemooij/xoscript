

Chuỗi khi: ['đánh-giá'] làm: {
	>> mã := Tệp mới: ['/tmp/eval.ctr'].
	mã ghi: bản-thân chuỗi + ['.'].
	Chương-trình dùng: ['/tmp/eval.ctr'].
}.

>> a := (Danh-sách ← (
	(Từ-điển mới)
		đặt: ['tên miền'] tại: ['mywebsite.com'],
		đặt: (Danh-sách ←
			((Từ-điển mới)
				đặt: ['trang chủ'] tại: ['title'],
				đặt: ['<html></html>'] tại: ['body'],
				đặt: ['2017-01-01'] tại: ['created']
			) ;
			((Từ-điển mới)
				đặt: ['giới thiệu(c)'] tại: ['title'],
				đặt: ['<credits>Tác giả Inc.</credits>'] tại: ['body']
			)
		) tại: ['pages']
	)
) chuỗi.

Xuất ghi: a kiểu, xuống-dòng.
Xuất ghi: a, xuống-dòng.

>> b := Rỗng.
(['b := '] + a) đánh-giá.
Xuất ghi: b ? 0 ? ['pages'] ? 1 ? ['body'], xuống-dòng.

>> c := b ? 0.
>> d := c chuỗi.
Xuất ghi: d kiểu, xuống-dòng.

>> e := Rỗng.
(['e := '] + d) đánh-giá.
Xuất ghi: e ? ['pages'] ? 0, xuống-dòng.
