Server init.
>> fmt := Định-dạng mới: ['%#3x'].

>> blob := Blob mới: 4.
blob bytes: ( 
	Danh-sách mới ; 0 ; 1 ; 2 ; 3
).

>> file := Tệp mới: ['/tmp/blob'].
file blob: blob.
blob giải-phóng.

>> đọc := file blob.
đọc 
từ: 0 
độ-dài: 4, 
làm mỗi: { :i :b 
	Xuất
	ghi: (fmt áp-dụng-số-nguyên: b),
	xuống-dòng.
}.
đọc giải-phóng.
