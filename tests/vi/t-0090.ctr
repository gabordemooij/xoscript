Xuất ghi: ['1,2,3,4,5,6,7,8,9,A,'], xuống-dòng.
>> Phạm-vi := Đối-tượng mới.
Phạm-vi khi: ['initialize:'] làm: { :x riêng thuộc-tính := x. }.
Phạm-vi khi: ['khẳng-định'] làm: { Xuất ghi: [',']. }.
Phạm-vi khi: ['kiểm-thử'] làm: {
	Xuất ghi: riêng thuộc-tính.
	bản-thân khẳng-định.
	( 1 = 1 ) đúng: { Xuất ghi: riêng thuộc-tính. bản-thân khẳng-định. }.
	( 1 = 0 ) sai: { Xuất ghi: riêng thuộc-tính. bản-thân khẳng-định. }.
	>> y := 2. { Xuất ghi: riêng thuộc-tính. bản-thân khẳng-định. } trong-khi: { y trừ: 1. <- (y > 0). }.
	{ Xuất ghi: riêng thuộc-tính. bản-thân khẳng-định. } × 1.
	(Danh-sách ← 1) mỗi: {  Xuất ghi: riêng thuộc-tính. bản-thân khẳng-định. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }. @todo tự cài đặt sắp xếp, kiểm thử này thất bại vì số lần lặp khác nhau tùy nền tảng
	(Từ-điển mới one: ['item']) mỗi: { Xuất ghi: riêng thuộc-tính. bản-thân khẳng-định. }.
	{ 1 ÷ 0. } bắt-lỗi: { Xuất ghi: riêng thuộc-tính. bản-thân khẳng-định. }, chạy.
	Xuất xuống-dòng.
}.
>> phạm-vi1 := Phạm-vi mới.
phạm-vi1 initialize: ['X'].
phạm-vi1 kiểm-thử.
>> hàm-thử := { 
	riêng thuộc-tính := ['Y'].
	Xuất ghi: riêng thuộc-tính.
	bản-thân khẳng-định.
	( 1 = 1 ) đúng: { Xuất ghi: riêng thuộc-tính. bản-thân khẳng-định. }.
	( 1 = 0 ) sai: { Xuất ghi: riêng thuộc-tính. bản-thân khẳng-định. }.
	>> y := 2. { Xuất ghi: riêng thuộc-tính. bản-thân khẳng-định. } trong-khi: { y trừ: 1. <- (y > 0). }.
	{ Xuất ghi: riêng thuộc-tính. bản-thân khẳng-định. } × 1.
	(Danh-sách ← 1) mỗi: {  Xuất ghi: riêng thuộc-tính. bản-thân khẳng-định. }.
	#(List ← 1 ; 2) sort: {  Out write: own property. self confirm. <- 0. }.
	(Từ-điển mới one: ['item']) mỗi: { Xuất ghi: riêng thuộc-tính. bản-thân khẳng-định. }.
	{ 1 ÷ 0. } bắt-lỗi: { Xuất ghi: riêng thuộc-tính. bản-thân khẳng-định. }, chạy.
	Xuất xuống-dòng.
}.
hàm-thử khi: ['khẳng-định'] làm: { Xuất ghi: [',']. }.
hàm-thử áp-dụng: 1 và: 2.
