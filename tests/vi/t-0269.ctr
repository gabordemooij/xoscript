#Linux

(Tệp mới: ['/tmp/testje']) tồn-tại sai: {
	Chương-trình hệ-thống: ['mkdir /tmp/testje'].	
}.

(Tệp mới: ['/tmp/testje/file1']) tồn-tại sai: {
	Chương-trình hệ-thống: ['touch /tmp/testje/file1'].	
}.

(Tệp mới: ['/tmp/testje/folder1']) tồn-tại sai: {
	Chương-trình hệ-thống: ['mkdir /tmp/testje/folder1'].	
}.

>> l := Tệp danh-sách: ['/tmp/testje'].

>> q := Danh-sách mới.

l mỗi: { :k :v v mỗi: { :x :y q thêm-cuối: y. }. }.

>> s := q chuỗi.

(s chứa: ['file1']) đúng:   { Xuất ghi: ['OK'], xuống-dòng. }.
(s chứa: ['file2']) đúng:   { Xuất ghi: ['XX'], xuống-dòng. }.
(s chứa: ['folder1']) đúng: { Xuất ghi: ['OK'], xuống-dòng. }.
