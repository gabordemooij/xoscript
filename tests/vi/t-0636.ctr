# test url parsing

Server init.
>> url := URL từ: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Xuất ghi: ['scheme = '] + url giao-thức, xuống-dòng.
Xuất ghi: ['host = '] + url máy-trạm, xuống-dòng.
Xuất ghi: ['port = '] + url cổng, xuống-dòng.
Xuất ghi: ['path = '] + url đường-dẫn, xuống-dòng.
Xuất ghi: ['query = '] + url tham-số-tìm-kiếm, xuống-dòng.
Xuất ghi: ['fragment = '] + url phân-đoạn, xuống-dòng.
