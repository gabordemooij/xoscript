# kiểm thử phân tích url

Server init.
>> url := URL từ: ['https://xoscript.com:1234/a/b/c?test=1#hello'].

Xuất ghi: ['lược đồ = '] + url giao-thức, xuống-dòng.
Xuất ghi: ['máy chủ = '] + url máy-trạm, xuống-dòng.
Xuất ghi: ['cổng = '] + url cổng, xuống-dòng.
Xuất ghi: ['đường dẫn = '] + url đường-dẫn, xuống-dòng.
Xuất ghi: ['truy vấn = '] + url tham-số-tìm-kiếm, xuống-dòng.
Xuất ghi: ['phân đoạn = '] + url phân-đoạn, xuống-dòng.
