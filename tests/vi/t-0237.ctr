
Chuỗi khi: ['evaluate'] làm: {
	>> mã := Tệp mới: ['/tmp/eval.ctr'].
	mã ghi: (bản-thân chuỗi + ['.']).
	Chương-trình dùng: ['/tmp/eval.ctr'].
}.

>> map :=
	(Từ-điển mới)
	đặt: ['Hi There'] tại: ['two'],
	đặt: (Danh-sách ← ['hello'] ; ['world'] ; (Danh-sách ← 1 ; 2; 9) ; Sai) tại: ['one'],
	đặt: ( (Từ-điển mới) đặt: ['wrrld'] tại: ['misspelled'] ) tại: ['three'],
	đặt: (Danh-sách ← ((Từ-điển mới) đặt: ['treasure'] tại: ['hidden']) ; 2) tại: ['four']. 
>> str := map chuỗi.
>> map2 := Rỗng.
(['map2 := '] + str ) evaluate.
Xuất ghi: map2 ? ['one'] ? 0.
Xuất ghi: map2 ? ['one'] ? 1.
Xuất ghi: map2 ? ['four'] ? 0 ? ['hidden'].
Xuất ghi: map2 ? ['one'] ? 2 ? 2.
