
Chuỗi khi: ['đánh-giá'] làm: {
	>> mã := Tệp mới: ['/tmp/eval.ctr'].
	mã ghi: (bản-thân chuỗi + ['.']).
	Chương-trình dùng: ['/tmp/eval.ctr'].
}.

>> map :=
	(Từ-điển mới)
	đặt: ['Chào bạn'] tại: ['two'],
	đặt: (Danh-sách ← ['hello'] ; ['world'] ; (Danh-sách ← 1 ; 2; 9) ; Sai) tại: ['một'],
	đặt: ( (Từ-điển mới) đặt: ['thế gưới'] tại: ['viết sai'] ) tại: ['three'],
	đặt: (Danh-sách ← ((Từ-điển mới) đặt: ['kho báu'] tại: ['ẩn giấu']) ; 2) tại: ['bốn']. 
>> str := map chuỗi.
>> map2 := Rỗng.
(['map2 := '] + str ) đánh-giá.
Xuất ghi: map2 ? ['một'] ? 0.
Xuất ghi: map2 ? ['một'] ? 1.
Xuất ghi: map2 ? ['bốn'] ? 0 ? ['ẩn giấu'].
Xuất ghi: map2 ? ['một'] ? 2 ? 2.
