#Linux
>> đồng-hồ := Thời-điểm mới.
đồng-hồ múi-giờ: ['UTC-1'].
đồng-hồ năm: 1981, tháng: 1, ngày: 5,
      giờ: 13, phút: 15, giây: 13.

Xuất ghi: đồng-hồ, xuống-dòng.
đồng-hồ múi-giờ: ['UTC+0'].

Xuất ghi: (
	(đồng-hồ năm thô) + ['-'] + (đồng-hồ tháng) + ['-'] + (đồng-hồ ngày) + [' '] +
	(đồng-hồ giờ) + [':'] + (đồng-hồ phút) + [':'] + (đồng-hồ giây) + [' '] +
	['W'] + (đồng-hồ tuần) + (đồng-hồ múi-giờ)
), xuống-dòng.


đồng-hồ múi-giờ: ['UTC-1'].
Xuất ghi: (
	(đồng-hồ năm thô) + ['-'] + (đồng-hồ tháng) + ['-'] + (đồng-hồ ngày) + [' '] +
	(đồng-hồ giờ) + [':'] + (đồng-hồ phút) + [':'] + (đồng-hồ giây) + [' '] +
	['W'] + (đồng-hồ tuần) + (đồng-hồ múi-giờ)
), xuống-dòng.
