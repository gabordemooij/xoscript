#Linux
>> clock := Thời-điểm mới.
clock múi-giờ: ['UTC-1'].
clock năm: 1981, tháng: 1, ngày: 5,
      giờ: 13, phút: 15, giây: 13.

Xuất ghi: clock, xuống-dòng.
clock múi-giờ: ['UTC+0'].

Xuất ghi: (
	(clock năm thô) + ['-'] + (clock tháng) + ['-'] + (clock ngày) + [' '] +
	(clock giờ) + [':'] + (clock phút) + [':'] + (clock giây) + [' '] +
	['W'] + (clock tuần) + (clock múi-giờ)
), xuống-dòng.


clock múi-giờ: ['UTC-1'].
Xuất ghi: (
	(clock năm thô) + ['-'] + (clock tháng) + ['-'] + (clock ngày) + [' '] +
	(clock giờ) + [':'] + (clock phút) + [':'] + (clock giây) + [' '] +
	['W'] + (clock tuần) + (clock múi-giờ)
), xuống-dòng.
