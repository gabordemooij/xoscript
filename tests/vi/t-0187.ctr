Số khi: ['giai-thừa'] làm: {
	>> tổng := 1.
	{ :chỉ-số tổng nhân-với: (bản-thân - chỉ-số). } × bản-thân. <- tổng.
}.

>> bộ-nhớ-đã-dùng1 := 0.
>> bộ-nhớ-đã-dùng2 := 0.
>> bộ-nhớ-đã-dùng3 := 0.
>> bộ-nhớ-đã-dùng4 := 0.

Chương-trình quản-lý-bộ-nhớ: 0.

{
2 số-mũ giai-thừa.
Xuất ghi: (11 chia-dư: 3), xuống-dòng.
Xuất ghi: (3.4 làm-tròn), xuống-dòng.
Xuất ghi: (7.1 làm-tròn-lên), xuống-dòng.
Xuất ghi: (7.9 làm-tròn-xuống), xuống-dòng.
}
chạy.

Chương-trình dọn-dẹp.

bộ-nhớ-đã-dùng1 := (Chương-trình bộ-nhớ ? 0).

{
2 số-mũ giai-thừa.
Xuất ghi: (11 chia-dư: 3), xuống-dòng.
Xuất ghi: (3.4 làm-tròn), xuống-dòng.
Xuất ghi: (7.1 làm-tròn-lên), xuống-dòng.
Xuất ghi: (7.9 làm-tròn-xuống), xuống-dòng.
}
chạy.

Chương-trình dọn-dẹp.
bộ-nhớ-đã-dùng2 := (Chương-trình bộ-nhớ ? 0).


{
2 số-mũ giai-thừa.
Xuất ghi: (11 chia-dư: 3), xuống-dòng.
Xuất ghi: (3.4 làm-tròn), xuống-dòng.
Xuất ghi: (7.1 làm-tròn-lên), xuống-dòng.
Xuất ghi: (7.9 làm-tròn-xuống), xuống-dòng.
} chạy.

Chương-trình dọn-dẹp.
bộ-nhớ-đã-dùng3 := (Chương-trình bộ-nhớ ? 0).



( bộ-nhớ-đã-dùng1 = bộ-nhớ-đã-dùng2 và: bộ-nhớ-đã-dùng1 = bộ-nhớ-đã-dùng3, và: bộ-nhớ-đã-dùng2 = bộ-nhớ-đã-dùng3 ) đúng: {
	Xuất ghi: ['Không rò rỉ bộ nhớ ở đây'].
}, sai: {
	Xuất ghi: ['Đang rò rỉ bộ nhớ...'].
}.
