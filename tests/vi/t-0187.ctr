( usedMemory1 = usedMemory2 và: usedMemory1 = usedMemory3, và: usedMemory2 = usedMemory3 ) đúng: {
	Xuất ghi: ['No memory leaks here'].
}, sai: {
	Xuất ghi: ['Leaking memory...'].
