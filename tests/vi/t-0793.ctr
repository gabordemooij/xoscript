Server init.

>> DB := Maria-DB mới máy-trạm: ['localhost'],
	tên-người-dùng: ['xo'],
	mật-khẩu: ['pass123'],
	tên-cơ-sở-dữ-liệu: ['xobase'],
	kết-nối.

{
	DB truy-vấn:
	['DROP TABLE movies'],
	thực-thi.
} bắt-lỗi: { Rỗng. }, chạy.

DB truy-vấn:
['CREATE TABLE movies (id INT PRIMARY KEY, title VARCHAR(64))'],
thực-thi.

DB truy-vấn: ['INSERT INTO movies (id,title) VALUES(1, ?)'],
tham-số: ( Danh-sách mới ; ['Halloween'] ),
thực-thi.

DB truy-vấn: ['SELECT * FROM movies'],
lấy: { :movie
	Xuất ghi: movie title, xuống-dòng.
}.

