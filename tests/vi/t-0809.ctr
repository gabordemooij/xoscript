# backslashes must survive code serialization, strings must not end early
>> các-giá-trị := Danh-sách mới
	; ['C:\\new']
	; ['ends with backslash \\']
	; ['\\\\']
	; ['x\\\'] at: 9, put: 1 at: 2).'].

các-giá-trị mỗi: { :i :value
	>> d := Từ-điển mới.
	d đặt: value tại: ['k'].
	>> r := d mã đối-tượng.
	Xuất ghi: r đếm, xuống-dòng.
	Xuất ghi: ( (r tại: ['k']) = value ), xuống-dòng.
}.
