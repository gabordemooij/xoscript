Chương-trình quản-lý-bộ-nhớ: 0.
Danh-sách khi: ['tổng-cộng'] làm: {
	>> tổng := 0.
	bản-thân mỗi: { :chỉ-số :phần-tử
		tổng cộng: phần-tử.
	}. <- tổng.
}.

>> bộ-nhớ-đã-dùng1 := 0.
>> bộ-nhớ-đã-dùng2 := 0.
>> bộ-nhớ-đã-dùng3 := 0.
>> bộ-nhớ-đã-dùng4 := 0.



>> f := Tệp mới: ['/tmp/test.txt'].
f ghi: ['Lorem Ipsum'].
f đóng.
  

f := Tệp mới: ['/tmp/test.txt'].
>> văn-bản := f đọc.
f đóng.



Chương-trình dọn-dẹp.
bộ-nhớ-đã-dùng1 := (Chương-trình bộ-nhớ ? 1).



f := Tệp mới: ['/tmp/test.txt'].
văn-bản := f đọc.
f đóng.

Chương-trình dọn-dẹp.
bộ-nhớ-đã-dùng2 := (Chương-trình bộ-nhớ ? 1).


f := Tệp mới: ['/tmp/test.txt'].
văn-bản := f đọc.
f đóng.

Chương-trình dọn-dẹp.
bộ-nhớ-đã-dùng3 := (Chương-trình bộ-nhớ ? 1).



( bộ-nhớ-đã-dùng1 = bộ-nhớ-đã-dùng2 và: bộ-nhớ-đã-dùng1 = bộ-nhớ-đã-dùng3, và: bộ-nhớ-đã-dùng2 = bộ-nhớ-đã-dùng3 ) đúng: {
	Xuất ghi: ['Không rò rỉ bộ nhớ ở đây'].
}, sai: {
	Xuất ghi: ['Đang rò rỉ bộ nhớ...'].
}.
