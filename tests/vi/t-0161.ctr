Chương-trình quản-lý-bộ-nhớ: 0.
Danh-sách khi: ['sum'] làm: {
	>> total := 0.
	bản-thân mỗi: { :index :element
		total cộng: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.



>> f := Tệp mới: ['/tmp/test.txt'].
f ghi: ['Lorem Ipsum'].
f đóng.
  

f := Tệp mới: ['/tmp/test.txt'].
>> text := f đọc.
f đóng.



Chương-trình dọn-dẹp.
usedMemory1 := (Chương-trình bộ-nhớ ? 1).



f := Tệp mới: ['/tmp/test.txt'].
text := f đọc.
f đóng.

Chương-trình dọn-dẹp.
usedMemory2 := (Chương-trình bộ-nhớ ? 1).


f := Tệp mới: ['/tmp/test.txt'].
text := f đọc.
f đóng.

Chương-trình dọn-dẹp.
usedMemory3 := (Chương-trình bộ-nhớ ? 1).



( usedMemory1 = usedMemory2 và: usedMemory1 = usedMemory3, và: usedMemory2 = usedMemory3 ) đúng: {
	Xuất ghi: ['No memory leaks here'].
}, sai: {
	Xuất ghi: ['Leaking memory...'].
}.
