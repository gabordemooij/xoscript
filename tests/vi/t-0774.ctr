Xuất ghi: ['Test object'], xuống-dòng.
>> a := Đối-tượng mới. 
a khi: ['item:'] làm: { :lst
	riêng lst := lst. 
}.
a khi: ['item'] làm: { <- riêng lst.
}.
a item: (
	Danh-sách mới ; 1 ; (
		Danh-sách mới ; ['a'] ; (
			Danh-sách mới ; ( Thời-điểm mới: 1 )
		) ; ( Int64 từ-chuỗi: ['321'] )
	)
).
Xuất ghi: a item, xuống-dòng.
>> old-lst-address := a item nguyên-mẫu địa-chỉ-bộ-nhớ.
a save-as: ['/tmp/a.bin'].
Xuất ghi: ['========== RELOADING SNAP:'], xuống-dòng.
>> b := Đối-tượng load-from: ['/tmp/a.bin'].
(b item nguyên-mẫu địa-chỉ-bộ-nhớ = old-lst-address) đúng: {
	Xuất ghi: ['Object link re-attached.'], xuống-dòng.
}.
Xuất ghi: ( b item ), xuống-dòng.
