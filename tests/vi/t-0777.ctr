#OBSD
>> dirname := [''].
{ dirname thêm-cuối: ['X/']. } * (1024 / 2 - 4).
>> command := ['mkdir -p /tmp/'] + dirname.
Chương-trình hệ-thống: command.
Chương-trình chdir: ['/tmp/'] + dirname.
>> filename := [''].
{ filename thêm-cuối: ['YYYYYYYY']. } * 20.
Tệp mới: filename, ghi: ['sometext'].
{ Tệp danh-sách: ['/tmp/'] + dirname. } * 1000.
Xuất ghi: ['no crash'], xuống-dòng.

