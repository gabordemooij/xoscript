Xuất ghi: ['Test object'], xuống-dòng.
>> a := Đối-tượng mới. 

a khi: ['item:'] làm: { :lôgic
	riêng lôgic := lôgic. 
}.

a khi: ['item'] làm: { <- riêng lôgic.
}.

a item: Sai.

Xuất ghi: a item, xuống-dòng.

>> old-bool-address := a item nguyên-mẫu địa-chỉ-bộ-nhớ.
a save-as: ['/tmp/a.bin'].
Xuất ghi: ['========== RELOADING SNAP:'], xuống-dòng.

>> b := Đối-tượng load-from: ['/tmp/a.bin'].

(b item nguyên-mẫu địa-chỉ-bộ-nhớ = old-bool-address) đúng: {
	Xuất ghi: ['Object link re-attached.'], xuống-dòng.
}.

Xuất ghi: b item, xuống-dòng.
