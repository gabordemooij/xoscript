
Danh-sách khi: ['sum'] làm: {
	>> total := 0.
	bản-thân mỗi: { :index :element
		total cộng: element.
	}. <- total.
}.

>> a := Danh-sách ← 9 ; 8 ; 7.
Xuất ghi: (a sum), xuống-dòng. 
>> a := Danh-sách ← 1 ; 9.
Xuất ghi: (a sum), xuống-dòng. 
>> a := Danh-sách ← ['o'] ; 2.
Xuất ghi: (a sum), xuống-dòng. 
Xuất ghi: (Danh-sách mới sum), xuống-dòng. 
