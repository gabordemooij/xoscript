Server init.

# JSON encoder only supports UTF-8, no surrogate pairs

>> dicts := Danh-sách mới ;
	# {"key":"normal"} normal ASCII
	( Từ-điển mới đặt: ['normal'] tại: ['key'] ) ;
	# {"key":"hello world"} space character
	( Từ-điển mới đặt: ['hello world'] tại: ['key'] ) ;
	# {"key":"quote: \""} double quote
	( Từ-điển mới đặt: ['"'] tại: ['key'] ) ;
	# {"key":"backslash: \\"} backslash
	( Từ-điển mới đặt: ['backslash: \\'] tại: ['key'] ) ;
	# {"key":"slash: /"} slash
	( Từ-điển mới đặt: ['slash: /'] tại: ['key'] ) ;
	# {"key":"backspace: \b"} backspace
	( Từ-điển mới đặt: ['backspace: \b'] tại: ['key'] ) ;
	# {"key":"formfeed: \f"} form-feed escape
	( Từ-điển mới đặt: ['formfeed: \f'] tại: ['key'] ) ;
	# {"key":"newline: \n"} newline
	( Từ-điển mới đặt: ['newline: \n'] tại: ['key'] ) ;
	( Từ-điển mới đặt: ['newline: ↵'] tại: ['key'] ) ;
	( Từ-điển mới đặt: ['newline: 
	'] tại: ['key'] ) ;
	# {"key":"carriage return: \r"} carriage-return
	( Từ-điển mới đặt: ['carriage return: \r'] tại: ['key'] ) ;
	# {"key":"tab: \t"} tab
	( Từ-điển mới đặt: ['tab \t'] tại: ['key'] ) ;
	( Từ-điển mới đặt: ['tab ⇿'] tại: ['key'] ) ;
	( Từ-điển mới đặt: ['tab  '] tại: ['key'] ) ;
	# {"key":"control: \u0000"} NUL
	( Từ-điển mới đặt: ['NUL \u0000'] tại: ['key'] ) ;
	( Từ-điển mới đặt: ['NUL \0'] tại: ['key'] ) ;
	# {"key":"control: \u0001"} control character 0x01
	( Từ-điển mới đặt: ['control: \u0001'] tại: ['key'] ) ;
	# {"key":"control: \u001F"} control character 0x1F
	( Từ-điển mới đặt: ['control: \u001F'] tại: ['key'] ) ;
	# {"key":"unicode: é"} UTF-8, 2-byte char
	( Từ-điển mới đặt: ['unicode: é'] tại: ['key'] ) ;
	# {"key":"unicode: €"} UTF-8, 3-byte char
	( Từ-điển mới đặt: ['unicode: €'] tại: ['key'] ) ;
	# {"key":"unicode: 日本語"} multiple 3-byte UTF-8 chars
	( Từ-điển mới đặt: ['unicode: 日本語'] tại: ['key'] ) ;
	# {"key":"unicode: 😀"} UTF-8, 4-byte char
	( Từ-điển mới đặt: ['unicode: 😀'] tại: ['key'] ) ;
	# {"key":"unicode: 🧑‍💻"} emoji + zero-width joiner
	( Từ-điển mới đặt: ['unicode: 🧑‍💻'] tại: ['key'] ) ;
	# {"key":"combining: e\u0301"} combining accent
	( Từ-điển mới đặt: ['combining: e\u0301'] tại: ['key'] ) ;
	# {"key":"escaped unicode: \u00e9"} Unicode escape BMP
	( Từ-điển mới đặt: ['escaped unicode: \u00e9'] tại: ['key'] ) ;
	# {"key":"escaped unicode: \u20ac"} Unicode escape BMP
	( Từ-điển mới đặt: ['escaped unicode: \u20ac'] tại: ['key'] ) ;
	# {"key":"escaped unicode: \ud83d\ude00"} UTF-16 surrogate pair
	( Từ-điển mới đặt: ['escaped unicode: \ud83d\ude00'] tại: ['key'] ) ;
	# {"key":""} empty value
	( Từ-điển mới đặt: [''] tại: ['key'] ) ;
	# {"key":"@ < > & = % + ? #"} special ASCII chars
	( Từ-điển mới đặt: ['@ < > & = % + ? #'] tại: ['key'] ) ;
	# {"key":"single quote: '"} single quote
	( Từ-điển mới đặt: ['''] tại: ['key'] ) ;
	# {"key":"multiple: \" \\ \n \r \t"} multiple JSON escapes
	( Từ-điển mới đặt: ['multiple: \" \\ \n \r \t'] tại: ['key'] ) ;
	# {"key":"aaaaaaaaaaaaaaaaaaaaaaaaaa"} longer ASCII-string
	( Từ-điển mới đặt: ['aaaaaaaaaaaaaaaaaaaaaaaaaa'] tại: ['key'] ) ;
	# {"key":" value"} leading space
	( Từ-điển mới đặt: [' value'] tại: ['key'] ) ;
	# {"key":"value "} trailing space
	( Từ-điển mới đặt: ['value '] tại: ['key'] ) ;
	# {"key":" \t\n\r "} whitespace
	( Từ-điển mới đặt: [' \t\n\r '] tại: ['key'] ).

dicts mỗi: { :_ :d
	>> j := JSON jsonify: d.
	>> a := JSON jsonify: (Từ-điển mới đặt: d key tại: ['key']).
	>> b := JSON jsonify: (Từ-điển mới đặt: ['value'] tại: d key).
	>> e := JSON đối-tượng: a.
	>> f := JSON đối-tượng: b.
	((e key = d key và: (f ? d key = ['value'])) hoặc: (e key = ['NUL ?'])) đúng: {
		Xuất ghi: ['OK'], xuống-dòng.
	}, ngược-lại: {
		Xuất ghi: ['Unable to properly encode/decode: '] + d + j, xuống-dòng.
		Chương-trình kết-thúc.
	}.
}.
