Xuất ghi: ((Danh-sách mới
	khi: ['plaque:'] làm: { :x riêng o := x. },
	khi: ['plaque']  làm: { <- riêng o. },
	plaque: ['Let\‘s build a pyramid of blocks!'],
	~ (Danh-sách ← 1)
	~ (Danh-sách ← 1 ; 2)
	~ (Danh-sách ← 1 ; 2 ; 3)
	~ (Danh-sách ← 1 ; 2 ; 3 ; 4)
	~ (Danh-sách ← 1 ; 2 ; 3 ; 4 ; 5)
) mỗi: { :i :el
	{ Xuất ghi: tác-vụ-này. } × el đếm.
	Xuất xuống-dòng.
}) plaque, xuống-dòng.


