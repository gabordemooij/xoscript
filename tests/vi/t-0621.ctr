>> phrases := Danh-sách mới
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> message := ['Phrase: ~decoded base64: ~encoded'].
	
phrases mỗi: { :_ :phrase 
	>> e := Server base64-mã-hóa: phrase.
	>> d := Server base64-giải-mã: e.
	Xuất ghi: (
		message sao-chép ~encoded: e, ~decoded: d
	), xuống-dòng.
}.
