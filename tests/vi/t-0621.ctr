>> các-cụm-từ := Danh-sách mới
	~ ['abcd']
	~ ['hello world']
	~ ['']
	~ ['@.,;"']
	~ ['this is a much much longer string to be encoded!'].

>> tin-nhắn := ['Phrase: ~decoded base64: ~encoded'].
	
các-cụm-từ mỗi: { :_ :cụm-từ 
	>> e := Server base64-mã-hóa: cụm-từ.
	>> d := Server base64-giải-mã: e.
	Xuất ghi: (
		tin-nhắn sao-chép ~encoded: e, ~decoded: d
	), xuống-dòng.
}.
