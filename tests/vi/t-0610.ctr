
>> Rectangle := Đối-tượng mới.

Rectangle khi: ['area'] làm: { <- riêng độ-dài * riêng width.
}.

Rectangle khi: ['length:'] làm: { :độ-dài
	riêng độ-dài := độ-dài.
}.

Rectangle khi: ['width:'] làm: { :width
	riêng width := width.
}.

Rectangle khi: ['mới'] làm: {
	# this will not result into an infinite loop
	>> rectangle := bản-thân mới.
	rectangle length: 0, width: 0. <- rectangle.
}.

>> a := Rectangle mới.
Xuất ghi: a area, xuống-dòng. #0

>> b := Rectangle mới length: 2, width: 3.
Xuất ghi: b area, xuống-dòng. #6

