Số khi: ['factorial'] làm: {
	>> total := 1.
	{ :index total nhân-với: (bản-thân - (index)). } × bản-thân. <- total.
}.
>> Printer := Đối-tượng mới.
Printer khi: ['print:and:'] làm: { :x :y
	Xuất ghi: ['a='] + x + [', b='] + y, xuống-dòng.
}.
>> a := 4.5. >> b := a làm-tròn-xuống.
Printer print: a and: b.
a := 4. b := a factorial.
Printer print: a and: b.
a := 4.5. b := a làm-tròn-lên.
Printer print: a and: b.
a := 4.5. b := a làm-tròn-xuống.
Printer print: a and: b.
a := 4.5. b := a làm-tròn.
Printer print: a and: b.
a := 4.2. b := a làm-tròn.
Printer print: a and: b.

Xuất ghi: (9 chia-dư: 5), xuống-dòng.
Xuất ghi: -666 trị-tuyệt-đối, xuống-dòng.
Xuất ghi: 49 căn-bậc-hai, xuống-dòng.
Xuất ghi: (2 lũy-thừa: 3), xuống-dòng.
>> l := (Danh-sách ← 9 ; 6).
Xuất ghi: l nhỏ-nhất.

