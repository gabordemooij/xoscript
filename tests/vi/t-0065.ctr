Số khi: ['giai-thừa'] làm: {
	>> tổng := 1.
	{ :chỉ-số tổng nhân-với: (bản-thân - (chỉ-số)). } × bản-thân. <- tổng.
}.
>> Máy-in := Đối-tượng mới.
Máy-in khi: ['in:và:'] làm: { :x :y
	Xuất ghi: ['a='] + x + [', b='] + y, xuống-dòng.
}.
>> a := 4.5. >> b := a làm-tròn-xuống.
Máy-in in: a và: b.
a := 4. b := a giai-thừa.
Máy-in in: a và: b.
a := 4.5. b := a làm-tròn-lên.
Máy-in in: a và: b.
a := 4.5. b := a làm-tròn-xuống.
Máy-in in: a và: b.
a := 4.5. b := a làm-tròn.
Máy-in in: a và: b.
a := 4.2. b := a làm-tròn.
Máy-in in: a và: b.

