>> Người-chào := Đối-tượng mới.
Người-chào khi: ['tạo'] làm: {
	>> người-chào := Đối-tượng mới.
	người-chào khi: ['name:'] làm: { :tên
		Xuất ghi: ['đặt một cái tên'].
		riêng tên-tôi := tên.
	}.
	người-chào khi: ['chào'] làm: {
		Xuất ghi: ['Hello'].
		Xuất ghi: riêng tên-tôi.
	}. <- người-chào.
}.
>> người-chào := Người-chào tạo.
người-chào name: ['nắng ấm!'].
người-chào chào.
