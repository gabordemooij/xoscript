Chương-trình quản-lý-bộ-nhớ: 4.

>> Doubler := Đối-tượng mới.
>> Multiplier := Đối-tượng mới.
Doubler khi: ['double:and:'] làm: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Multiplier khi: ['multiply:and:'] làm: { :x :y <- (x × y).
}.

Xuất ghi: (
	Doubler double:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
	and:
		(Doubler double: 
			(Multiplier multiply: 2 and: 3)
		and:
			(Multiplier multiply: 3 and: 4)
		)
), xuống-dòng.
