Chương-trình quản-lý-bộ-nhớ: 4.

>> Bộ-nhân-đôi := Đối-tượng mới.
>> Bộ-nhân := Đối-tượng mới.
Bộ-nhân-đôi khi: ['gấp-đôi:và:'] làm: { :x :y
	>> q := x + 1. <- ((x × 2) + (y × 2)).
}.

Bộ-nhân khi: ['nhân:và:'] làm: { :x :y <- (x × y).
}.

Xuất ghi: (
	Bộ-nhân-đôi gấp-đôi:
		(Bộ-nhân-đôi gấp-đôi: 
			(Bộ-nhân nhân: 2 và: 3)
		và:
			(Bộ-nhân nhân: 3 và: 4)
		)
	và:
		(Bộ-nhân-đôi gấp-đôi: 
			(Bộ-nhân nhân: 2 và: 3)
		và:
			(Bộ-nhân nhân: 3 và: 4)
		)
), xuống-dòng.
