# thông báo lỗi cơ sở dữ liệu không được coi là chuỗi định dạng
Server init.

>> csdl := Maria-DB mới máy-trạm: ['localhost'],
	tên-người-dùng: ['xo'],
	mật-khẩu: ['pass123'],
	tên-cơ-sở-dữ-liệu: ['xobase'],
	kết-nối.

>> tham-số-tìm-kiếm := csdl truy-vấn: ['SELECT %% FROM'].
{ tham-số-tìm-kiếm thực-thi. } bắt-lỗi: { :e
	Xuất ghi: ( e chứa: ['%%'] ), xuống-dòng.
}, chạy.
