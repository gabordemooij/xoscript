# database error messages must not be treated as format strings
Server init.

>> db := Maria-DB mới máy-trạm: ['localhost'],
	tên-người-dùng: ['xo'],
	mật-khẩu: ['pass123'],
	tên-cơ-sở-dữ-liệu: ['xobase'],
	kết-nối.

>> tham-số-tìm-kiếm := db truy-vấn: ['SELECT %% FROM'].
{ tham-số-tìm-kiếm thực-thi. } bắt-lỗi: { :e
	Xuất ghi: ( e chứa: ['%%'] ), xuống-dòng.
}, chạy.
