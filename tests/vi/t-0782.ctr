Xuất ghi: ['Test object'], xuống-dòng.
>> cmd := Lệnh mới.
Xuất ghi: cmd ls /tmp, xuống-dòng.
>> old-cmd-address := cmd nguyên-mẫu địa-chỉ-bộ-nhớ.
cmd save-as: ['/tmp/a.bin'].
Xuất ghi: ['========== RELOADING SNAP:'], xuống-dòng.
>> b := Đối-tượng load-from: ['/tmp/a.bin'].
(b nguyên-mẫu địa-chỉ-bộ-nhớ = old-cmd-address) đúng: {
	Xuất ghi: ['Object link re-attached.'], xuống-dòng.
}.
Xuất ghi: b ls, xuống-dòng.


