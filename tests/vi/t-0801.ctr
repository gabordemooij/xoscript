Server init.

>> db := Maria-DB mới máy-trạm: ['localhost'],
	tên-người-dùng: ['xo'],
	mật-khẩu: ['pass123'],
	tên-cơ-sở-dữ-liệu: ['xobase'],
	kết-nối.

>> del := db truy-vấn: ['DELETE FROM book WHERE id > 0'].
{  del thực-thi. db xác-nhận. } bắt-lỗi: { :e db hoàn-tác.  }, chạy.

>> đếm := db truy-vấn: ['SELECT COUNT(*) AS num FROM book'].
đếm lấy: { :row Xuất ghi: row num, xuống-dòng. }.
