Xuất ghi: ['Tiếp tục vòng lặp for, Không có - trước 6 trở lên.'], xuống-dòng.
{ :i
	Xuất ghi: (i + 1), xuống-dòng.
	((i + 1) > 4) tiếp-tục.
	Xuất ghi: ['-'].
} × 10.

>> x := 0.
>> x-nhỏ-hơn-10 := { <- ( x < 10 ). }.
Xuất xuống-dòng.
Xuất ghi: ['Tiếp tục while-true, Không có --> trước 5 trở lên.'], xuống-dòng.
{
	Xuất ghi: ['iteration #'] + x, xuống-dòng.
	x cộng: 1.
	((x < 5) phủ-định) tiếp-tục.
	Xuất ghi: ['-->'].
} trong-khi: x-nhỏ-hơn-10.
Xuất xuống-dòng.
Xuất ghi: ['Tiếp tục while-false, Không có - chỉ trước 3.'], xuống-dòng.
{
	Xuất ghi: ['iteration #'] + x, xuống-dòng.
	x trừ: 1.
	(x = 3) tiếp-tục.
	Xuất ghi: ['-'].
} trong-khi: { <- ( x > 0). }.

Xuất xuống-dòng.
Xuất ghi: ['Tiếp tục vòng lặp times, Không có ||| trước 3.'], xuống-dòng.
{ :i
	Xuất ghi: ['iteration #'] + i, xuống-dòng.
	(i = 2) tiếp-tục.
	Xuất ghi: ['|||'].
} × 5.

Xuất xuống-dòng.

{ Đúng tiếp-tục. Xuất ghi: ['đừng viết cái này!'], xuống-dòng. } chạy.

{ Đúng tiếp-tục. Xuất ghi: ['đừng viết cái này!'], xuống-dòng. } bắt-lỗi: { Xuất ghi: ['Đừng bắt cái này!']. }, chạy.

Xuất ghi: ['Kiểm tra vòng lặp each của Danh-sách: 0, ... ,2'], xuống-dòng.
(Danh-sách ← 1 ; 2 ; 3) ánh-xạ: { :i
	(i = 1) tiếp-tục.
	Xuất ghi: ['iteration #'] + (i - 0), xuống-dòng.
}.

Xuất ghi: ['Kiểm tra vòng lặp each của Từ-điển: chỉ c'], xuống-dòng.
>> m := Từ-điển mới.
m đặt: ['first'] tại: ['a'], đặt: ['second'] tại: ['b'], đặt: ['thứ ba'] tại: ['c'].
m mỗi: { :k :v
	(k ≠ ['c']) tiếp-tục.
	Xuất ghi: ['iteration'] + k + v, xuống-dòng.
}.

