Xuất ghi: ['Continue for-loop, No - before 6 and up.'], xuống-dòng.
{ :i
	Xuất ghi: (i + 1), xuống-dòng.
	((i + 1) > 4) tiếp-tục.
	Xuất ghi: ['-'].
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.
Xuất xuống-dòng.
Xuất ghi: ['Continue while-true, No --> before 5 and up.'], xuống-dòng.
{
	Xuất ghi: ['iteration #'] + x, xuống-dòng.
	x cộng: 1.
	((x < 5) phủ-định) tiếp-tục.
	Xuất ghi: ['-->'].
} trong-khi: xIsLessThan10.
Xuất xuống-dòng.
Xuất ghi: ['Continue while-false, No - before 3 only.'], xuống-dòng.
{
	Xuất ghi: ['iteration #'] + x, xuống-dòng.
	x trừ: 1.
	(x = 3) tiếp-tục.
	Xuất ghi: ['-'].
} trong-khi: { <- ( x > 0). }.

Xuất xuống-dòng.
Xuất ghi: ['Continue times-loop, No ||| before 3.'], xuống-dòng.
{ :i
	Xuất ghi: ['iteration #'] + i, xuống-dòng.
	(i = 2) tiếp-tục.
	Xuất ghi: ['|||'].
} × 5.

Xuất xuống-dòng.

{ Đúng tiếp-tục. Xuất ghi: ['dont write this!'], xuống-dòng. } chạy.

{ Đúng tiếp-tục. Xuất ghi: ['dont write this!'], xuống-dòng. } bắt-lỗi: { Xuất ghi: ['Dont catch this!']. }, chạy.

Xuất ghi: ['Test Array each-loop: 0, ... ,2'], xuống-dòng.
(Danh-sách ← 1 ; 2 ; 3) ánh-xạ: { :i
	(i = 1) tiếp-tục.
	Xuất ghi: ['iteration #'] + (i - 0), xuống-dòng.
}.

Xuất ghi: ['Test Map each-loop: c only'], xuống-dòng.
>> m := Từ-điển mới.
m đặt: ['first'] tại: ['a'], đặt: ['second'] tại: ['b'], đặt: ['third'] tại: ['c'].
m mỗi: { :k :v
	(k ≠ ['c']) tiếp-tục.
	Xuất ghi: ['iteration'] + k + v, xuống-dòng.
}.

