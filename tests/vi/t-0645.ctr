Server init.
Xuất ghi: ['Kiểm tra ngày trong cơ sở dữ liệu'], xuống-dòng.

>> csdl := Maria-DB mới máy-trạm: ['localhost'],
	tên-người-dùng: ['xo'], 
	mật-khẩu: ['pass123'],
	tên-cơ-sở-dữ-liệu: ['xobase'],
