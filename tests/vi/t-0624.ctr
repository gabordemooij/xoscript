# Kiểm thử này xem string_fill_in có mất khe (bị gc) ở chế độ 4 không
# tham chiếu trong world.c
>> Nhật-ký := Đối-tượng mới.

Nhật-ký khi: ['say:'] làm: { :str
	Xuất ghi: str, xuống-dòng.
}.

>> Mục := Đối-tượng mới.

Mục khi: ['mới:'] làm: { :id
	<- bản-thân mới id: id.
}.

Mục khi: ['id:'] làm: { :id
	riêng id := id.
}.

Mục khi: ['id'] làm: { <- riêng id. }.


Mục khi: ['chuỗi'] làm: {
	>> str := ['Item#~no'].
	str ~no: riêng id.
	<- str.
}.


>> Print := Đối-tượng mới.

Print khi: ['items'] làm: { 
	
	riêng mục := Mục mới: 1.
	
	# hoặc segfault hoặc chuỗi sai ở đây
	Nhật-ký say: (
		['~item printed.'] ~item: riêng mục
	).
	
	
}.

Print items.