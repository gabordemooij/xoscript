#Linux
>> OS := Chương-trình thiết-lập: ['OS'].

>> clock := Thời-điểm mới.
	
(OS = ['Haiku']) đúng: {
	clock múi-giờ: ['CET'],
	năm: 2017, tháng: 7, ngày: 13,
	giờ: 18, phút: 0, giây: 0.
}, ngược-lại: {
	clock múi-giờ: ['Europe/Amsterdam'],
	năm: 2017, tháng: 7, ngày: 13,
	giờ: 18, phút: 0, giây: 0.
}.

clock khi: ['tell'] làm: {
	Xuất ghi: bản-thân, xuống-dòng.
}.


clock cộng: 2    giờ, tell.
clock cộng: 1    giờ, tell.
clock cộng: 19 phút, tell.
clock cộng: 1  phút, tell.
clock cộng: 1  phút, tell.
clock cộng: 19 giây, tell.
clock cộng: 1  giây, tell.
clock cộng: 1  giây, tell.
clock cộng: 2    năm, tell.
clock cộng: 1    năm, tell.

(OS = ['Haiku']) đúng: {
clock cộng: 5   tháng.
clock múi-giờ: ['CEST'], tell.
}, ngược-lại: {
	clock cộng: 5   tháng, tell.
}.

clock cộng: 1   tháng, tell.
clock cộng: 19    ngày, tell.
clock cộng: 1    giờ, tell.
clock cộng: 120  yard, tell.
