#Linux
>> OS := Chương-trình thiết-lập: ['OS'].

>> đồng-hồ := Thời-điểm mới.
	
(OS = ['Haiku']) đúng: {
	đồng-hồ múi-giờ: ['CET'],
	năm: 2017, tháng: 7, ngày: 13,
	giờ: 18, phút: 0, giây: 0.
}, ngược-lại: {
	đồng-hồ múi-giờ: ['Europe/Amsterdam'],
	năm: 2017, tháng: 7, ngày: 13,
	giờ: 18, phút: 0, giây: 0.
}.

đồng-hồ khi: ['báo'] làm: {
	Xuất ghi: bản-thân, xuống-dòng.
}.


đồng-hồ cộng: 2    giờ, báo.
đồng-hồ cộng: 1    giờ, báo.
đồng-hồ cộng: 19 phút, báo.
đồng-hồ cộng: 1  phút, báo.
đồng-hồ cộng: 1  phút, báo.
đồng-hồ cộng: 19 giây, báo.
đồng-hồ cộng: 1  giây, báo.
đồng-hồ cộng: 1  giây, báo.
đồng-hồ cộng: 2    năm, báo.
đồng-hồ cộng: 1    năm, báo.

(OS = ['Haiku']) đúng: {
đồng-hồ cộng: 5   tháng.
đồng-hồ múi-giờ: ['CEST'], báo.
}, ngược-lại: {
	đồng-hồ cộng: 5   tháng, báo.
}.

đồng-hồ cộng: 1   tháng, báo.
đồng-hồ cộng: 19    ngày, báo.
đồng-hồ cộng: 1    giờ, báo.
đồng-hồ cộng: 120  yard, báo.
