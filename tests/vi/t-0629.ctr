# kiểm thử cơ sở dữ liệu
# xem ví dụ server.xo để biết cấu hình cần thiết

Server init.
Xuất ghi: ['Kiểm tra cơ sở dữ liệu'], xuống-dòng.

>> csdl := Maria-DB mới máy-trạm: ['localhost'],
	tên-người-dùng: ['xo'], mật-khẩu: ['pass123'], tên-cơ-sở-dữ-liệu: ['xobase'], kết-nối.

Xuất ghi: ['Kết nối được không? '] + csdl đã-kết-nối?, xuống-dòng.

>> tham-số-tìm-kiếm := csdl truy-vấn: ['
	INSERT INTO book (id, description, price, rating) 
	VALUES (NULL, ?, ?, ?)
'], tham-số: ( Danh-sách mới ; ['abc'] ; 12.35 ; 6 ). # truy vấn có tham số

{  tham-số-tìm-kiếm thực-thi. csdl xác-nhận. } bắt-lỗi: { :e csdl hoàn-tác.  }, chạy.

Xuất ghi: ['Chèn được không? '] + ( tham-số-tìm-kiếm insert-id > 0 ), xuống-dòng.

>> Obj := Đối-tượng mới.
Obj khi: ['lấy-các-hàng'] làm: {
	riêng đếm := 0.
	>> tham-số-tìm-kiếm :=
	csdl truy-vấn: ['SELECT * FROM book order by id desc limit 2'], 
	lấy: { :hàng 
		riêng đếm cộng: 1.
		Đúng ngắt.
	}. # lấy các hàng
	<- riêng đếm sao-chép.
}.

Xuất ghi: ['Truy vấn được không? '] + ( Obj lấy-các-hàng > 0 ), xuống-dòng.
