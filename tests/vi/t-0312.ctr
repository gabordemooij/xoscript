>> Hút := Đối-tượng mới.
Hút khi: ['mới'] làm: {
	riêng str := [''].
}.
Hút học: ['nieuw'] nghĩa-là: ['mới'].
Hút khi: ['đáp:'] làm: { :blah
		(riêng str ≠ ['']) đúng: {
			riêng str thêm-cuối: [' '].
		}.
		riêng str thêm-cuối: blah.
}.
Hút khi: ['đáp:và:'] làm: { :blah :blahah
		(riêng str ≠ ['']) đúng: {
			riêng str thêm-cuối: [' '].
		}.
		(blah độ-dài > 1) đúng: {
			riêng str thêm-cuối: (blah từ: 0 độ-dài: (blah độ-dài - 1)).
		}, ngược-lại: {
			riêng str thêm-cuối: blah.
		}.
		riêng str thêm-cuối: [' '].
		riêng str thêm-cuối: blahah.
}.
Hút khi: ['thu-về'] làm: {
	>> bộ-đệm := riêng str.
	riêng str := ['']. <- bộ-đệm.
}.


>> tham-số-tìm-kiếm := Hút mới
	select: ['*'],
	from
		những-người-dùng 
	where 
		user_id=: 1.

Xuất ghi: tham-số-tìm-kiếm thu-về, xuống-dòng.
