>> Slurp := Đối-tượng mới.
Slurp khi: ['mới'] làm: {
	riêng str := [''].
}.
Slurp học: ['nieuw'] nghĩa-là: ['mới'].
Slurp khi: ['đáp:'] làm: { :blah
		(riêng str ≠ ['']) đúng: {
			riêng str thêm-cuối: [' '].
		}.
		riêng str thêm-cuối: blah.
}.
Slurp khi: ['đáp:và:'] làm: { :blah :blahah
		(riêng str ≠ ['']) đúng: {
			riêng str thêm-cuối: [' '].
		}.
		(blah độ-dài > 1) đúng: {
			riêng str thêm-cuối: (blah từ: 0 độ-dài: (blah độ-dài - 1)).
		}, ngược-lại: {
			riêng str thêm-cuối: blah.
		}.
		riêng str thêm-cuối: [' '].
		riêng str thêm-cuối: blahah.
}.
Slurp khi: ['obtain'] làm: {
	>> buffer := riêng str.
	riêng str := ['']. <- buffer.
}.


>> tham-số-tìm-kiếm := Slurp mới
	select: ['*'],
	from
		users 
	where 
		user_id=: 1.

Xuất ghi: tham-số-tìm-kiếm obtain, xuống-dòng.
