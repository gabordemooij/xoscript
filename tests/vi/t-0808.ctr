# khóa và chữ ký của két giải mã ra quá dài không được làm tràn ngăn xếp
Server init.

>> cặp-khóa := Két tạo-khóa.
>> kbm := cặp-khóa đầu.
>> kcc := cặp-khóa cuối.
>> cks := Két ký: ['abc'] bằng: kbm.

# 88 ký tự không có đệm giải mã ra 66 byte
>> dài := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

# 44 ký tự không có đệm giải mã ra 33 byte
>> ngắn := ['AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA'].

{ Két ký: ['abc'] bằng: dài. } bắt-lỗi: { :e
	Xuất ghi: e, xuống-dòng.
}, chạy.

{ Két kiểm-tra: ['abc'] chữ-ký: dài bằng: kcc. } bắt-lỗi: { :e
	Xuất ghi: e, xuống-dòng.
}, chạy.

{ Két kiểm-tra: ['abc'] chữ-ký: cks bằng: ngắn. } bắt-lỗi: { :e
	Xuất ghi: e, xuống-dòng.
}, chạy.
