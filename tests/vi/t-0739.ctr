Xuất ghi: ['Test object'], xuống-dòng.
>> a := Đối-tượng mới. 

a khi: ['item:'] làm: { :binhelper
	riêng binhelper := binhelper. 
}.

a khi: ['item'] làm: { <- riêng binhelper.
}.

a item: Bin mới.

>> old-binhelper-address := a item nguyên-mẫu địa-chỉ-bộ-nhớ.
a save-as: ['/tmp/a.bin'].
Xuất ghi: ['========== RELOADING SNAP:'], xuống-dòng.

>> b := Đối-tượng load-from: ['/tmp/a.bin'].

(b item nguyên-mẫu địa-chỉ-bộ-nhớ = old-binhelper-address) đúng: {
	Xuất ghi: ['Object link re-attached.'], xuống-dòng.
}.


