
>> a := Danh-sách ← (Danh-sách ← 100 ; 200 ; 300) ; (Danh-sách ← 9 ; 8 ; 7).
Xuất ghi: ['at 0,1 :'].
Xuất ghi: a ? 0 ? 1, xuống-dòng. 
Xuất ghi: ['at 1,2 :'].
Xuất ghi: a ? 1 ? 2, xuống-dòng. 
>> menu := Từ-điển mới.
menu đặt: (Danh-sách ← ['pizza'] ; ['spaghetti']) tại: ['Italian Cuisine'].
menu đặt: (Danh-sách ← ['bifteki'] ; ['suflaki']) tại: ['Greek Cuisine'].
Xuất ghi: ['I love '] + (menu ? ['Greek Cuisine'] ? 0) + [' and '] + (menu ? ['Italian Cuisine'] ? 1), xuống-dòng. 
Xuất ghi: ['but not on the same plate.'], xuống-dòng.
