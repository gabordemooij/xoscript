>> z := Đối-tượng mới.
z khi: ['value:'] làm: { :v
	riêng value := v. <- bản-thân.
}.
z khi: ['value'] làm: { <- riêng value. }.
(z setValue: 1) value: 2.
Xuất ghi: z value.
>> x := z.
Xuất ghi: x value.
z := Rỗng.
Xuất ghi: z value.
Xuất ghi: x value.
Xuất ghi: ['hello'].
Xuất ghi: 3 + 2.
Xuất ghi: (3 > 2).
