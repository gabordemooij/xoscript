>> ?? := ['🦀🦁🦂🦃🦄'].

>> ⚄ := Đối-tượng mới.
⚄ khi: ['drawFrom:length:'] làm: { :pool :đếm
	
	>> result := [''].
	
	{
		>> index := Số random % (pool độ-dài).
		result thêm-cuối: ( pool ký-tự: (index + 1) ).
		
	} × đếm. <- result.
}.

>> random := ⚄ drawFrom: ?? length: ?? độ-dài.
Xuất ghi: (['x↵'] x random độ-dài).
Xuất ghi: (['y↵'] y ?? độ-dài).

