
>> g := ['toàn cục'].
{ >> g := ['cục bộ']. Xuất ghi: g, xuống-dòng. } chạy. 
Xuất ghi: g, xuống-dòng. 
>> tin-nhắn := ['Tạm biệt'].
>> Bí-mật := Đối-tượng mới.
Bí-mật khi: ['kiểm-thử'] làm: {
	>> tin-nhắn := ['Hello'].
	riêng tin-nhắn := ['World'].
	Xuất ghi: tin-nhắn + [' '] + riêng tin-nhắn, xuống-dòng.
}.
Bí-mật kiểm-thử.
Xuất ghi: tin-nhắn.
