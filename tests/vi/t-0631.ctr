#kiểm thử ffi


Server init.

Chương-trình quản-lý-bộ-nhớ: 4.

# với kiểm thử này bạn cần đặt đường dẫn tới libc (puts)
>> tên-thư-viện := Chương-trình thiết-lập: ['FFITESTLIB'].



Server liên-kết: (
 Danh-sách mới ;
 tên-thư-viện ;
 ['puts'] ;
 ( Danh-sách mới ; ['pointer'] ) ;
 ['void'] ;
 ['Puts'] ;
 ['str:']
).

>> s := Blob utf8: ['Hello from FFI!\n'].

Puts str: s.
s giải-phóng.

# kiểm thử với struct

>> a := Blob mới: 8.
a bytes: (
	Danh-sách <<: 
	2, ; 0 ; 0 ; 0 ;
    1  ; 0 ; 0 ; 0
).

>> cấu-trúc := Blob struct: (Danh-sách <<: ['int'], ; ['int']).

Server liên-kết: (
	Danh-sách <<: ['@structtest'], ;
	['@structtest'] ;
	(Danh-sách <<: cấu-trúc) ; 
	['int'] ;	
	['ffitest'] ;
	['ffisum:']
).
	
Xuất ghi: ['Kiểm tra tổng:'] + (ffitest ffisum: a), xuống-dòng.

cấu-trúc giải-phóng-struct.
cấu-trúc giải-phóng.
a giải-phóng.
