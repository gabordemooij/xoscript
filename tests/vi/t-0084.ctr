>> makeAdder := { :x
	>> f := { :y <- (riêng x + y). } đặt: ['x'] giá-trị: x. <- f.
}.
>> mapper := { :array :func
	>> mapping := { :i riêng q đặt: (riêng f áp-dụng: (riêng q ? i)) tại: i. } 
	đặt: ['q'] giá-trị: array,
	đặt: ['f'] giá-trị: func.
	{ :i mapping áp-dụng: i. } × (array đếm).
}.

>> a := Danh-sách ← 1; 2; 3.
mapper áp-dụng: a và: (makeAdder áp-dụng: 100).
Xuất ghi: (a vị-trí: 0), xuống-dòng.
Xuất ghi: (a ? 1), xuống-dòng.
Xuất ghi: (a ? 2), xuống-dòng.
