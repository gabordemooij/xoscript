>> tạo-bộ-cộng := { :x
	>> f := { :y <- (riêng x + y). } đặt: ['x'] giá-trị: x. <- f.
}.
>> bộ-ánh-xạ := { :mảng :hàm-số
	>> phép-ánh-xạ := { :i riêng q đặt: (riêng f áp-dụng: (riêng q ? i)) tại: i. } 
	đặt: ['q'] giá-trị: mảng,
	đặt: ['f'] giá-trị: hàm-số.
	{ :i phép-ánh-xạ áp-dụng: i. } × (mảng đếm).
}.

>> a := Danh-sách ← 1; 2; 3.
bộ-ánh-xạ áp-dụng: a và: (tạo-bộ-cộng áp-dụng: 100).
Xuất ghi: (a vị-trí: 0), xuống-dòng.
Xuất ghi: (a ? 1), xuống-dòng.
Xuất ghi: (a ? 2), xuống-dòng.
