# test list operations


>> cakes := Danh-sách ←
	['apple'] ;
	['berry'] ;
	['choco'] ;
	['cheese'].


>> buy := cakes thay: 1 độ-dài: 2 bằng: ( Danh-sách ← ['cinnamon'] ; ['pineapple'] ).
Xuất ghi: (buy nối: [',']), xuống-dòng.


>> buy := cakes thay: 1 độ-dài: 12 bằng: ( Danh-sách ← ['cinnamon'] ; ['pineapple'] ).
Xuất ghi: (buy nối: [',']), xuống-dòng.


>> buy := cakes thay: 2 độ-dài: 10 bằng: ( Danh-sách mới ).
Xuất ghi: (buy nối: [',']), xuống-dòng.


>> buy := cakes thay: 0 độ-dài: 1 bằng: ( Danh-sách mới ).
Xuất ghi: (buy nối: [',']), xuống-dòng.


>> buy := cakes thay: ['0'] độ-dài: ['1'] bằng: ['x'].
Xuất ghi: (buy nối: [',']), xuống-dòng.
