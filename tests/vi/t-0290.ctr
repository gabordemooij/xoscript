# kiểm thử các thao tác danh sách


>> các-loại-bánh := Danh-sách ←
	['apple'] ;
	['dâu'] ;
	['sô-cô-la'] ;
	['phô mai'].


>> mua := các-loại-bánh thay: 1 độ-dài: 2 bằng: ( Danh-sách ← ['quế'] ; ['dứa'] ).
Xuất ghi: (mua nối: [',']), xuống-dòng.


>> mua := các-loại-bánh thay: 1 độ-dài: 12 bằng: ( Danh-sách ← ['quế'] ; ['dứa'] ).
Xuất ghi: (mua nối: [',']), xuống-dòng.


>> mua := các-loại-bánh thay: 2 độ-dài: 10 bằng: ( Danh-sách mới ).
Xuất ghi: (mua nối: [',']), xuống-dòng.


>> mua := các-loại-bánh thay: 0 độ-dài: 1 bằng: ( Danh-sách mới ).
Xuất ghi: (mua nối: [',']), xuống-dòng.


>> mua := các-loại-bánh thay: ['0'] độ-dài: ['1'] bằng: ['x'].
Xuất ghi: (mua nối: [',']), xuống-dòng.
