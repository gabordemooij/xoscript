# định dạng cookie phiên, kiểu nội dung json, chỉ giao thức web, svg hiển thị trực tiếp
Server khởi-tạo.
Chương-trình dùng: ['../../../src/xo/vi/webtools.xo'].

>> Yêu-cầu-giả := Đối-tượng mới.
Yêu-cầu-giả khi: ['value:'] làm: { :giá-trị
	riêng giá-trị := giá-trị.
}.
Yêu-cầu-giả khi: ['cookie:'] làm: { :tên
	<- riêng giá-trị.
}.

>> Phiên-thử-nghiệm := Phiên-tệp-tạm mới.
Phiên-thử-nghiệm khi: ['tải'] làm: {
	<- Từ-điển mới.
}.
Phiên-thử-nghiệm khi: ['mã-số-phiên'] làm: {
	<- riêng id.
}.

>> các-cookie := Danh-sách mới
	; ['abc123']
	; ['../outside']
	; ['']
	; ['abc\n'].

các-cookie mỗi: { :i :cookie
	>> yêu-cầu-http := Yêu-cầu-giả mới.
	yêu-cầu-http value: cookie.
	>> trình-quản-lý := Phiên-thử-nghiệm mới.
	>> trang-web := Tài-liệu-Web mới.
	trang-web yêu-cầu-http: yêu-cầu-http.
	trang-web trình-quản-lý-phiên: trình-quản-lý.
	trang-web bắt-đầu-phiên.
	Xuất ghi: ( trình-quản-lý mã-số-phiên = cookie ), xuống-dòng.
}.

>> trang-web := Tài-liệu-Web mới.
trang-web json: (Từ-điển mới đặt: ['b'] tại: ['a']).
Xuất ghi: ['\n'], xuống-dòng.

{ Mạng get: ['file:///etc/hostname']. } bắt-lỗi: { :e
	Xuất ghi: e, xuống-dòng.
}, chạy.

>> svg := Tệp mới: ['/tmp/test0814.svg'].
svg ghi: ['<svg xmlns="x"></svg>'].
Xuất xuống-dòng.
Server chuyển-tiếp: ['test0814.svg'] tiền-tố: ['/tmp/'].
svg xóa.
