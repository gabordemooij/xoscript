# Kiểm thử bộ làm sạch utf8
Server init.

>> các-ca-utf8 := Từ-điển mới
	# Chỉ ASCII
	đặt: ( Danh-sách mới ; 65 ; 65 ; 65 ; 65 ; 0 ) tại: ['AAAA'],
	# chuỗi 2 byte hợp lệ
	đặt: ( Danh-sách mới ; 194 ; 162 ; 0 ) tại: ['¢'],
	# UTF-8 3 byte hợp lệ
    đặt: ( Danh-sách mới ; 226 ; 130 ; 172 ; 0 ) tại: ['€'],
	# UTF-8 4 byte hợp lệ
    đặt: ( Danh-sách mới ; 240 ; 144 ; 141 ; 136 ; 0 ) tại: ['𐍈'],
	# Byte tiếp nối không hợp lệ trong chuỗi E2 28 AC -> bắt đầu chuỗi 3b + 28 cnt sai + AC byte cnt, nhưng thuộc cùng một lỗi
    đặt: ( Danh-sách mới ; 65 ; 226 ; 40 ; 172 ; 65 ; 0 ) tại: ['A?A'],
	# Mã hóa quá dài của ASCII 'A' (phải thành ?),
    đặt: ( Danh-sách mới ; 65 ; 193 ; 129 ; 0 ) tại: ['A?'],
	# Byte đầu tiên không hợp lệ (0xFF)
    đặt: ( Danh-sách mới ; 255 ; 0 ) tại: ['?'],
	# Chuỗi nhiều byte chưa hoàn chỉnh ở cuối
    đặt: ( Danh-sách mới ; 66 ; 226 ; 0 ) tại: ['B?'],
    # Chuỗi rỗng
    #put: ( List new ) at: [''],
	# Nhiều chuỗi hỗn hợp
    đặt: ( Danh-sách mới ; 65 ; 226 ; 130 ; 172 ; 192 ; 175 ; 240 ; 144 ; 141 ; 136 ; 66 ; 0 ) tại: ['A€?𐍈B'].
	 
các-ca-utf8 mỗi: { :key :value
	>> blob := Blob mới: value đếm, bytes: value.
	>> str := blob chuỗi.
	(str = key) đúng: {
		Xuất ghi: ['OK'], xuống-dòng.
	}, ngược-lại: {
		Xuất ghi: ['Bộ làm sạch UTF8 thất bại với: '] + key + [' nhận được: '] + str, xuống-dòng.
	}.
	blob giải-phóng.
}.
