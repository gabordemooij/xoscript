# dùng FFI với plugin Server

# kết nối với libc (tùy nền tảng)
>> tên-thư-viện := Chương-trình thiết-lập: ['FFITESTLIB'].

# liên kết các hàm stdio từ C cho các thao tác tệp nâng cao
Server liên-kết: ( Danh-sách mới ;
 tên-thư-viện ; ['fopen'] ;
 ( Danh-sách mới ; ['pointer'] ; ['pointer']) ;
 ['pointer'] ;
 ['Stream'] ;
 ['path:mode:']
),
liên-kết: ( Danh-sách mới ;
 Rỗng ; # nghĩa là cùng thư viện
 ['fread'] ;
 ( Danh-sách mới ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Rỗng ; # nghĩa là cùng đối tượng (tức là Luồng)
 ['fread']
),
liên-kết: (
 Danh-sách mới ;
 Rỗng ; # nghĩa là cùng thư viện
 ['fwrite'] ;
 ( Danh-sách mới ; ['pointer'] ; ['int'] ; ['int'] ; ['pointer'] ) ;
 ['int'] ;
 Rỗng ; # nghĩa là cùng thư viện
 ['fwrite']
),
liên-kết: (
 Danh-sách mới ;
 Rỗng ; # nghĩa là cùng thư viện
 ['rewind'] ;
 ( Danh-sách mới ; ['pointer'] ) ;
 ['int'] ;
 Rỗng ; # nghĩa là cùng thư viện
 ['rewind:']
).

>> str  := Blob utf8: ['abc123'].
>> đường-dẫn := Blob utf8: ['/tmp/bla.txt'].
>> mode := Blob utf8: ['w+'].

# mở một tệp bằng fopen(path, mode)
>> fd := Stream path: đường-dẫn mode: mode.

# ghi các byte từ bộ đệm chuỗi-văn-bản vào tệp
>> số-byte-đã-ghi := Stream thông-điệp: ['fwrite'] đối-số: (Danh-sách mới ; str ; 1 ; 6 ; fd ).
Xuất ghi: số-byte-đã-ghi, xuống-dòng.

# tua lại con trỏ tệp
Stream rewind: fd.

# cấp phát một bộ đệm
>> bđ := Blob mới: 20.

# đọc từ tệp
>> số-byte-đã-đọc := Stream thông-điệp: ['fread'] đối-số: (Danh-sách mới ; bđ ; 1 ; 6 ; fd ).
Xuất ghi: số-byte-đã-đọc, xuống-dòng.
Xuất ghi: bđ, xuống-dòng.

# giải phóng bộ nhớ
str  giải-phóng.
đường-dẫn giải-phóng.
mode giải-phóng.
bđ  giải-phóng.


