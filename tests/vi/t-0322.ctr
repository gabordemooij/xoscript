

>> Matryoshka := Đối-tượng mới.
Matryoshka khi: ['double:'] làm: { :bí-mật
	riêng bí-mật := bí-mật × 2.
}.
Matryoshka khi: ['mới:'] làm: { :bí-mật
	>> câu-trả-lời := Rỗng.
	>> t := (bí-mật > 255).
	Xuất ghi: (bí-mật + [' | '] + t), xuống-dòng.
	t đúng: {
		câu-trả-lời := bí-mật.
	}, ngược-lại: {
		câu-trả-lời := Matryoshka đệ-quy mới: (bản-thân double: bí-mật).
	}. <- câu-trả-lời.
}.

>> x := Matryoshka mới: 2.
