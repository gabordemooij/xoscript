

>> Matryoshka := Đối-tượng mới.
Matryoshka khi: ['double:'] làm: { :secret
	riêng secret := secret × 2.
}.
Matryoshka khi: ['mới:'] làm: { :secret
	>> answer := Rỗng.
	>> t := (secret > 255).
	Xuất ghi: (secret + [' | '] + t), xuống-dòng.
	t đúng: {
		answer := secret.
	}, ngược-lại: {
		answer := Matryoshka đệ-quy mới: (bản-thân double: secret).
	}. <- answer.
}.

>> x := Matryoshka mới: 2.
