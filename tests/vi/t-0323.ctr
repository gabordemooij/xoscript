

Chương-trình dọn-dẹp.


>> Rau-củ := Đối-tượng mới.
Rau-củ khi: ['mới'] làm: {
	>> v := bản-thân mới.
	v init. <- v.
}.

Rau-củ khi: ['init'] làm: { riêng rau := 0. }.

Rau-củ khi: ['carrots:'] làm: { :a riêng rau := a. <- Rỗng. }.
Rau-củ khi: ['cà-rốt'] làm: { <- riêng rau. }.
Rau-củ khi: ['+'] làm: { :f
	>> n := Rau-củ mới.
	n carrots: (f cà-rốt + riêng rau). <- n.
}.

Rau-củ khi: ['chuỗi'] làm: { <- riêng rau chuỗi.
}.

Số khi: ['cà-rốt'] làm: {
	>> x := Rau-củ mới.
	x carrots: bản-thân. <- x.
}.

Số khi: ['cộng:và:'] làm: { :a :b <- (a + b).
}.

>> q := 0 cộng: (3 cà-rốt + 2 cà-rốt) và: 4 cà-rốt.
Xuất ghi: q, xuống-dòng.
