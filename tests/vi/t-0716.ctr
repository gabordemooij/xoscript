Xuất ghi: ['Đối tượng thử nghiệm'], xuống-dòng.
>> a := Đối-tượng mới. 

a khi: ['state:'] làm: { :list
	riêng list := list. 
}.

a khi: ['trạng-thái'] làm: {
	Xuất ghi: riêng list, xuống-dòng.
}.

a state: ( Danh-sách mới ; ['mục danh sách'] ; ['mục2'] ).
a trạng-thái.

a save-as: ['/tmp/a.bin'].
Xuất ghi: ['========== ĐANG TẢI LẠI SNAP:'], xuống-dòng.
>> b := Đối-tượng load-from: ['/tmp/a.bin'].
b trạng-thái.