Server init.

>> CSDL := Maria-DB mới máy-trạm: ['localhost'],
	tên-người-dùng: ['xo'],
	mật-khẩu: ['pass123'],
	tên-cơ-sở-dữ-liệu: ['xobase'],
	kết-nối.
	
>> SQL := ['SELECT "hello" AS "world" '].

# một cách nhanh hơn, lấy truy vấn từ CSDL:
>> truy-vấn2 := CSDL truy-vấn: SQL.

# giờ bạn không cần đặt CSDL nữa
truy-vấn2 lấy: { :hàng
	Xuất ghi: hàng world, xuống-dòng.
}.
