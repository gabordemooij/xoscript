Server init.

>> DB := Maria-DB mới máy-trạm: ['localhost'],
	tên-người-dùng: ['xo'],
	mật-khẩu: ['pass123'],
	tên-cơ-sở-dữ-liệu: ['xobase'],
	kết-nối.
	
>> SQL := ['SELECT "hello" AS "world" '].

# a quicker way, get query from DB:
>> query2 := DB truy-vấn: SQL.

# now you don't have to set DB
query2 lấy: { :row
	Xuất ghi: row world, xuống-dòng.
}.
