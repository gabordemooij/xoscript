
Server init.
>> yc := Yêu-cầu-HTTP mới.
Xuất ghi: ['HTTP-GET d[]=']  + ( yc get-danh-sách: ['d[]'] ), xuống-dòng. # GET
Xuất ghi: ['HTTP-GET f[]=']  + ( yc get-danh-sách: ['f[]'] ), xuống-dòng. # GET
Xuất ghi: ['HTTP-POST e[]='] + ( yc post-danh-sách: ['e[]'] ), xuống-dòng. # GET
Xuất ghi: ['HTTP-POST c=']   + ( yc post: ['c'] ), xuống-dòng. # GET
Xuất ghi: ['HTTP-POST xx=']  + ( yc post: ['xx'] ), xuống-dòng. # GET
