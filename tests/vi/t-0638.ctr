
Server init.
>> rq := Yêu-cầu-HTTP mới.
Xuất ghi: ['HTTP-GET d[]=']  + ( rq get-danh-sách: ['d[]'] ), xuống-dòng. # GET
Xuất ghi: ['HTTP-GET f[]=']  + ( rq get-danh-sách: ['f[]'] ), xuống-dòng. # GET
Xuất ghi: ['HTTP-POST e[]='] + ( rq post-danh-sách: ['e[]'] ), xuống-dòng. # GET
Xuất ghi: ['HTTP-POST c=']   + ( rq post: ['c'] ), xuống-dòng. # GET
Xuất ghi: ['HTTP-POST xx=']  + ( rq post: ['xx'] ), xuống-dòng. # GET
