

>> bộ-nhớ-đã-dùng1 := 0.
>> bộ-nhớ-đã-dùng2 := 0.
>> bộ-nhớ-đã-dùng3 := 0.
>> bộ-nhớ-đã-dùng4 := 0.

Chương-trình quản-lý-bộ-nhớ: 0.

{ :i Xuất ghi: i. } × 4.
Xuất xuống-dòng.
{ :i Xuất ghi: (4 - i). } × 4.
Xuất xuống-dòng.
( 1 > 2 ) sai: { Xuất ghi: ['KHỐI 1'], xuống-dòng. }.
( 2 > 1 ) đúng:  { Xuất ghi: ['KHỐI 2'], xuống-dòng. }.

>> i := 0.
{ Xuất ghi: i. i cộng: 1. } trong-khi: { <- ( i < 3). }.
Xuất xuống-dòng.

i := 3.
{ Xuất ghi: i. i := i - 1. } trong-khi: { <- ( i > 0). }.
Xuất xuống-dòng.


Chương-trình dọn-dẹp.

bộ-nhớ-đã-dùng1 := (Chương-trình bộ-nhớ ? 0).


{ :i  Xuất ghi: i. } × 4.
Xuất xuống-dòng.
{ :i  Xuất ghi: (4 - i). } × 4.
Xuất xuống-dòng.
( 1 > 2 ) sai: { Xuất ghi: ['KHỐI 1'], xuống-dòng. }.
( 2 > 1 ) đúng:  { Xuất ghi: ['KHỐI 2'], xuống-dòng. }.

>> i := 0.
{ Xuất ghi: i. i cộng: 1. } trong-khi: { <- ( i < 3). }.
Xuất xuống-dòng.

i := 3.
{ Xuất ghi: i. i := i - 1. } trong-khi: { <- ( i > 0). }.
Xuất xuống-dòng.



Chương-trình dọn-dẹp.
bộ-nhớ-đã-dùng2 := (Chương-trình bộ-nhớ ? 0).


{ :i Xuất ghi: i. } × 4.
Xuất xuống-dòng.
{ :i Xuất ghi: (4 - i). } × 4.
Xuất xuống-dòng.
( 1 > 2 ) sai: { Xuất ghi: ['KHỐI 1'], xuống-dòng. }.
( 2 > 1 ) đúng:  { Xuất ghi: ['KHỐI 2'], xuống-dòng. }.

>> i := 0.
{ Xuất ghi: i. i cộng: 1. } trong-khi: { <- ( i < 3). }.
Xuất xuống-dòng.

i := 3.
{ Xuất ghi: i. i := i - 1. } trong-khi: { <- ( i > 0). }.
Xuất xuống-dòng.

Chương-trình dọn-dẹp.
bộ-nhớ-đã-dùng3 := (Chương-trình bộ-nhớ ? 0).



( bộ-nhớ-đã-dùng1 = bộ-nhớ-đã-dùng2 và: bộ-nhớ-đã-dùng1 = bộ-nhớ-đã-dùng3, và: bộ-nhớ-đã-dùng2 = bộ-nhớ-đã-dùng3 ) đúng: {
	Xuất ghi: ['Không rò rỉ bộ nhớ ở đây'].
}, sai: {
	Xuất ghi: ['Đang rò rỉ bộ nhớ...'].
}.
