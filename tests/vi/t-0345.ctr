# kiểm thử các phương thức bắt-tất-cả
>> x13 := Đối-tượng mới.
x13 khi: ['a'] làm: { :a Xuất ghi: 0, xuống-dòng. }.
x13 khi: ['a:'] làm: { :a Xuất ghi: a, xuống-dòng. <- 5. }.
x13 khi: ['a:b:'] làm: { :a :b Xuất ghi: (a + b), xuống-dòng. }.
x13 a 1 + 0.
x13 a: 1.
x13 a: 1 b: 1.
x13 a: 1 + 1 b: 1.
x13 a: 1 + 1 b: 1 + 1.
x13 a: 1 + 1 + 1 b: 1 + 1.
x13 a: (x13 a: 6) b: 1 + 1.
