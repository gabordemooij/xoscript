

>> g  := Server mới.
>> v  := Két mới.
>> ok := 0.

>> các-bí-mật := Danh-sách mới ; 
	 ['aaa'] ;
	 [''] ; 
	 ['AB'] ;
	 ['abcdefghijklmnopqrstuvwxyz0123456789'] ; 
	 ['!@--+467hdHJKJs__=3hjsakd'] ;
	 ['spaces and	tabs'] ;
	 ['漢字'] ;
	 ['==[abc]=='].
	
>> các-mật-khẩu := các-bí-mật sao-chép.
các-mật-khẩu mỗi: { :i :p
	các-bí-mật mỗi: { :n :s
		{
			>> đã-mã-hóa := v mã-hóa: s khóa: p.
			>> đã-giải-mã := v giải-mã: đã-mã-hóa khóa: p.
			(đã-giải-mã = s) đúng: {
				ok cộng: 1.
			}, ngược-lại: {
				Xuất ghi: ['mã hóa/giải mã thất bại: '], xuống-dòng.
				Xuất ghi: s, xuống-dòng.
				Xuất ghi: ['đã mã hóa: '] + đã-mã-hóa, xuống-dòng.
				Xuất ghi: ['đã giải mã: '] + đã-mã-hóa, xuống-dòng.
				Chương-trình kết-thúc.
			}.
		} bắt-lỗi: { :lỗi-bắt
			(s = [''] hoặc: p = ['']) đúng: {
				ok cộng: 1.
			}, ngược-lại: {
				Xuất ghi: lỗi-bắt, xuống-dòng.
				Chương-trình kết-thúc.
			}.
		}, chạy.
	}.
}.

Xuất ghi: ( ok + [' lần mã hóa két đã kiểm tra.'] ), xuống-dòng.