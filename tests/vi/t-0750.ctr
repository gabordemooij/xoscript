Xuất ghi: ['Test object'], xuống-dòng.
>> a := Đối-tượng mới. 

a khi: ['item:'] làm: { :nil
	riêng nil := nil. 
}.

a khi: ['item'] làm: { <- riêng nil.
}.

a item: Rỗng.

Xuất ghi: a item, xuống-dòng.

>> old-nil-address := a item nguyên-mẫu địa-chỉ-bộ-nhớ.
a save-as: ['/tmp/a.bin'].
Xuất ghi: ['========== RELOADING SNAP:'], xuống-dòng.

>> b := Đối-tượng load-from: ['/tmp/a.bin'].

(b item nguyên-mẫu địa-chỉ-bộ-nhớ = old-nil-address) đúng: {
	Xuất ghi: ['Object link re-attached.'], xuống-dòng.
}.

Xuất ghi: b item, xuống-dòng.
