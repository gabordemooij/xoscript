
Chuỗi khi: ['html'] làm: { <- (
		bản-thân
		thay: ['&'] bằng: ['&amp;'],
		thay: ['<'] bằng: ['&lt;'],
		thay: ['>'] bằng: ['&gt;'],
		thay: ['"'] bằng: ['&quot;']
	).
}.

>> Cọ-Html := Đối-tượng mới.

Cọ-Html khi: ['đáp:'] làm: { :thẻ
	Xuất ghi: (['<tag>↵'] tag: thẻ ).
}.

Cọ-Html khi: ['đáp:và:'] làm: { :thẻ :content
	thẻ := ( thẻ từ: 0 độ-dài: (thẻ độ-dài - 1) ).
	Xuất ghi: (['<tag content>↵'] tag: thẻ, content: content).
}.

Cọ-Html khi: ['content:'] làm: { :văn-bản
	Xuất ghi: văn-bản html, xuống-dòng.
}.

Cọ-Html khi: ['thuộc-tính-thẻ:giá-trị:'] làm: { :thuộc-tính-thẻ :value <- ['attr="value"'] attr: thuộc-tính-thẻ, value: value.
}.

>> h := Cọ-Html mới.


h html
	body
		h1
			content: ['hello world'],
		/h1
		span:
			(h thuộc-tính-thẻ: ['class'] giá-trị: ['bold']),
		/span
	/body
/html.
		
