Server init.
>> f := Định-dạng mới: ['%d'].
>> a := Blob mới: 4.
a bytes: ( Danh-sách mới ; Bin b00000101 ; Hx x0A ; Bin b10000001 ; 0).
>> b := Blob mới: 4.
b bytes: ( Danh-sách mới ; Bin b00000110 ; Hx x0A ; Bin b10000000 ; 0).
a từ: 0 độ-dài: 3, mỗi: { :i :byte
	Xuất ghi: ( f áp-dụng-số-nguyên: byte ), xuống-dòng.
}.
a ^ b.
a từ: 0 độ-dài: 3, mỗi: { :i :byte
	Xuất ghi: ( f áp-dụng-số-nguyên: byte ), xuống-dòng.
}.
a ^ b.
a từ: 0 độ-dài: 3, mỗi: { :i :byte
	Xuất ghi: ( f áp-dụng-số-nguyên: byte ), xuống-dòng.
}.
a giải-phóng.
b giải-phóng.

{ a ^ Đối-tượng. } bắt-lỗi: { :e Xuất ghi: e, xuống-dòng. }, chạy.
