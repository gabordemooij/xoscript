


>> CoffeeMachine := Đối-tượng mới.
CoffeeMachine khi: ['order:'] làm: { :id
	>> coffee := ['Americano'].
	( id = 1 ) đúng: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) đúng: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) đúng: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> SimpleCoffeeMachine := Đối-tượng mới.
SimpleCoffeeMachine khi: ['order'] làm: { <- ['Black']. }.
>> redCup := CoffeeMachine order: 1.
Xuất ghi: redCup, xuống-dòng.
redCup := ['Tea']. 
>> greenCup := CoffeeMachine order: 0.
Xuất ghi: greenCup, xuống-dòng.
>> yellowCup := CoffeeMachine order: 1.
Xuất ghi: yellowCup, xuống-dòng.
>> blueCup := CoffeeMachine order: 0.
Xuất ghi: blueCup, xuống-dòng.
>> plasticCup := SimpleCoffeeMachine order.
plasticCup := ['Lemonade']. 
>> blackCup := SimpleCoffeeMachine order.
Xuất ghi: blackCup, xuống-dòng.
blackCup thêm-cuối: [' nooo.... beer. '].
>> orangeCup := SimpleCoffeeMachine order.
Xuất ghi: orangeCup, xuống-dòng.
