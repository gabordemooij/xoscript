


>> Máy-pha-cà-phê := Đối-tượng mới.
Máy-pha-cà-phê khi: ['order:'] làm: { :id
	>> coffee := ['Americano'].
	( id = 1 ) đúng: {
		coffee := ['Cappuccino'].
	}.
	( id = 2 ) đúng: {
		coffee := ['Espresso'].
	}.
	( id = 3 ) đúng: {
		coffee := ['Latte'].
	}. <- coffee.
}.
>> Máy-pha-cà-phê-đơn-giản := Đối-tượng mới.
Máy-pha-cà-phê-đơn-giản khi: ['gọi-món'] làm: { <- ['Đen']. }.
>> cốc-đỏ := Máy-pha-cà-phê order: 1.
Xuất ghi: cốc-đỏ, xuống-dòng.
cốc-đỏ := ['Trà']. 
>> cốc-xanh-lá := Máy-pha-cà-phê order: 0.
Xuất ghi: cốc-xanh-lá, xuống-dòng.
>> cốc-vàng := Máy-pha-cà-phê order: 1.
Xuất ghi: cốc-vàng, xuống-dòng.
>> cốc-xanh-dương := Máy-pha-cà-phê order: 0.
Xuất ghi: cốc-xanh-dương, xuống-dòng.
>> cốc-nhựa := Máy-pha-cà-phê-đơn-giản gọi-món.
cốc-nhựa := ['Nước chanh']. 
>> cốc-đen := Máy-pha-cà-phê-đơn-giản gọi-món.
Xuất ghi: cốc-đen, xuống-dòng.
cốc-đen thêm-cuối: [' khônggg.... bia. '].
>> cốc-cam := Máy-pha-cà-phê-đơn-giản gọi-món.
Xuất ghi: cốc-cam, xuống-dòng.
