

Danh-sách khi: ['fixture:'] làm: { :f
	riêng fixture := f.
}.

Danh-sách khi: ['đếm'] làm: { <- riêng fixture.
}.

Danh-sách khi: ['aantal'] làm: { <- riêng fixture.
}.


>> x := Rỗng.
{

	x := ['hello'] 
	thay:
		(['hel'] + 
			(['l<x>'] <x>:
				(['==o'] ký-tự: 2)
			)
		)
	bằng: (
		(['...hal'] + ['lo']) 
			chữ-hoa 
			lowecase 
			chữ-hoa 
			bỏ-qua: -1 + ( 
				11 - 12 + (
					(
						(
							(
								Danh-sách ← 0 ; 1 ; 4; 9 ; (Danh-sách ← 0 ; 3; 1) ; 4
							) áp-chót
						) ? 1
					) + 
					((Danh-sách ← ['X'] ; ['Y'] ; ['Z']) fixture: 2) 
					đếm
				)
			)
	).

} × 10.
Xuất ghi: x, xuống-dòng.

