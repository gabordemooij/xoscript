
>> countries := Danh-sách mới
	~ ['Switzerland']
	~ ['Italy']
	~ ['Germany'].

>> foods := Danh-sách mới
	~ ['Rösti']
	~ ['Spaghetti']
	~ ['Sauerkraut'].


>> counter := 0.
foods theo: countries, mỗi: { :key :value
	counter cộng: 1.
}.

Xuất ghi: (['we serve counter dishes'] counter: counter), xuống-dòng.

>> counter := 42.
['TrytosortthiswithoutsegfaultingButActualNumberDe✎dsOnOS'] các-ký-tự sắp-xếp: { :v
	counter cộng: 0.
}.

Xuất ghi: (['we sort counter dishes'] counter: counter), xuống-dòng.


>> counter := 0.
{
	{
		counter cộng: 1.
	} × (3 + 1 + 1 × 0.5).
} × 100.


Xuất ghi: (['we calculate counter numbers.'] counter: counter), xuống-dòng.

