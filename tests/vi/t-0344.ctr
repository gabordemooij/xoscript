# kiểm thử bắt-tất-cả (thực tế)
>> HTML := Chuỗi mới.
HTML khi: ['encode:'] làm: { :tekst
	bản-thân thêm-cuối: (tekst
	thay: ['&'] bằng: ['&amp;'], 
	thay: ['<'] bằng: ['&lt;'],
	thay: ['>'] bằng: ['&gt;'],
	thay: ['"'] bằng: ['&quot;']).
}.
>> blog := HTML mới.
blog thêm-cuối: ['<h1>'],
     encode: ['Koffie & Thee'],
     thêm-cuối: ['</h1>'].
Xuất ghi: blog, xuống-dòng.


>> La-Mã := Số mới.
La-Mã khi: ['dạng-chuỗi'] làm: {
	>> a := [''].
	{ a thêm-cuối: ['I']. } × bản-thân. <- a.
}.

>> x := La-Mã mới.
x cộng: 3.
Xuất ghi: x dạng-chuỗi, xuống-dòng.

>> Lượng-tử := Lôgic mới.
Lượng-tử khi: ['true?'] làm: { <- ['có lẽ Đúng']. }.
Xuất ghi: (Lượng-tử mới true?), xuống-dòng.

>> Nihil := Rỗng mới.
Nihil khi: ['chuỗi'] làm: { <- ['Nihil']. }.
Xuất ghi: (Nihil mới), xuống-dòng.
