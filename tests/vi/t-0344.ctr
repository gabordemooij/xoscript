# catch-all test (practical)
>> HTML := Chuỗi mới.
HTML khi: ['encode:'] làm: { :tekst
	bản-thân thêm-cuối: (tekst
	thay: ['&'] bằng: ['&amp;'], 
	thay: ['<'] bằng: ['&lt;'],
	thay: ['>'] bằng: ['&gt;'],
	thay: ['"'] bằng: ['&quot;']).
}.
>> blog := HTML mới.
blog thêm-cuối: ['<h1>'],
     encode: ['Koffie & Thee'],
     thêm-cuối: ['</h1>'].
Xuất ghi: blog, xuống-dòng.


>> Roman := Số mới.
Roman khi: ['stringy'] làm: {
	>> a := [''].
	{ a thêm-cuối: ['I']. } × bản-thân. <- a.
}.

>> x := Roman mới.
x cộng: 3.
Xuất ghi: x stringy, xuống-dòng.

>> Quantum := Lôgic mới.
Quantum khi: ['true?'] làm: { <- ['maybe True']. }.
Xuất ghi: (Quantum mới true?), xuống-dòng.

>> Nihil := Rỗng mới.
Nihil khi: ['chuỗi'] làm: { <- ['Nihil']. }.
Xuất ghi: (Nihil mới), xuống-dòng.
