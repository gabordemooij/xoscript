

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Chương-trình quản-lý-bộ-nhớ: 0.

>> a := Danh-sách ← ['hello'] ; ['world'] ; Đúng ; Rỗng ; 666.
a làm lấy-cuối lấy-đầu thêm-đầu: ['hi'], thêm-cuối: 999, xong.
Xuất ghi: ( a nối: [','] ), xuống-dòng.

Chương-trình dọn-dẹp.
usedMemory1 := (Chương-trình bộ-nhớ ? 0).


a := Danh-sách ← ['hello'] ; ['world'] ; Đúng ; Rỗng ; 666.
a lấy-cuối. a lấy-đầu. a thêm-đầu: ['hi'], thêm-cuối: 999.
Xuất ghi: ( a nối: [','] ), xuống-dòng.


Chương-trình dọn-dẹp.
usedMemory2 := (Chương-trình bộ-nhớ ? 0).


a := Danh-sách ← ['hello'] ; ['world'] ; Đúng ; Rỗng ; 666.
a làm lấy-cuối lấy-đầu thêm-đầu: ['hi'], thêm-cuối: 999, xong.
Xuất ghi: ( a nối: [','] ), xuống-dòng.


Chương-trình dọn-dẹp.
usedMemory3 := (Chương-trình bộ-nhớ ? 0).



( usedMemory1 = usedMemory2 và: usedMemory1 = usedMemory3, và: usedMemory2 = usedMemory3 ) đúng: {
	Xuất ghi: ['No memory leaks here'].
}, sai: {
	Xuất ghi: ['Leaking memory...'].
}.
