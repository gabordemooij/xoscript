
Xuất ghi: ['Break for-loop, 0-4.'], xuống-dòng.
{ :i
	Xuất ghi: ['iteration #'] + i, xuống-dòng.
	(i = 4) ngắt.
} × 10.

>> x := 0.
>> xIsLessThan10 := { <- ( x < 10 ). }.

Xuất ghi: ['Break while-true loop, 0-4.'], xuống-dòng.
{
	Xuất ghi: ['iteration #'] + x, xuống-dòng.
	x cộng: 1.
	((x < 5) phủ-định) ngắt.
} trong-khi: xIsLessThan10.

Xuất ghi: ['Break while-false loop, 5,4.'], xuống-dòng.
{
	Xuất ghi: ['iteration #'] + x, xuống-dòng.
	x trừ: 1.
	(x = 3) ngắt.
} trong-khi: { <- (x > 0). }.

Xuất ghi: ['Break times loop, 1-4.'], xuống-dòng.
{ :i
	Xuất ghi: ['iteration #'] + i, xuống-dòng.
	(i = 4) ngắt.
} × 5.

Xuất ghi: ['Break block, dont print line.'], xuống-dòng.
{ Đúng ngắt. Xuất ghi: ['dont write this!'], xuống-dòng. } chạy.

Xuất ghi: ['Break block, dont fire catch...'], xuống-dòng.
{ Đúng ngắt. Xuất ghi: ['dont write this!'], xuống-dòng. } bắt-lỗi: { Xuất ghi: ['Dont catch this!']. }, chạy.

Xuất ghi: ['Test Array each-loop: 0,1'], xuống-dòng.
(Danh-sách ← 1 ; 2 ; 3) ánh-xạ: { :i
	Xuất ghi: ['iteration #'] + i, xuống-dòng.
	(i = 1) ngắt.
}.

Xuất ghi: ['Test Map each-loop: c only'], xuống-dòng.
>> m := Từ-điển mới.
m đặt: ['first'] tại: ['a'], đặt: ['second'] tại: ['b'], đặt: ['third'] tại: ['c'].
m mỗi: { :k :v
	Xuất ghi: ['iteration'] + v + k, xuống-dòng.
	Đúng ngắt.
}.

