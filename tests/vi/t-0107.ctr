
Xuất ghi: ['Ngắt vòng lặp for, 0-4.'], xuống-dòng.
{ :i
	Xuất ghi: ['iteration #'] + i, xuống-dòng.
	(i = 4) ngắt.
} × 10.

>> x := 0.
>> x-nhỏ-hơn-10 := { <- ( x < 10 ). }.

Xuất ghi: ['Ngắt vòng lặp while-true, 0-4.'], xuống-dòng.
{
	Xuất ghi: ['iteration #'] + x, xuống-dòng.
	x cộng: 1.
	((x < 5) phủ-định) ngắt.
} trong-khi: x-nhỏ-hơn-10.

Xuất ghi: ['Ngắt vòng lặp while-false, 5,4.'], xuống-dòng.
{
	Xuất ghi: ['iteration #'] + x, xuống-dòng.
	x trừ: 1.
	(x = 3) ngắt.
} trong-khi: { <- (x > 0). }.

Xuất ghi: ['Ngắt vòng lặp times, 1-4.'], xuống-dòng.
{ :i
	Xuất ghi: ['iteration #'] + i, xuống-dòng.
	(i = 4) ngắt.
} × 5.

Xuất ghi: ['Ngắt khối, không in dòng.'], xuống-dòng.
{ Đúng ngắt. Xuất ghi: ['đừng viết cái này!'], xuống-dòng. } chạy.

Xuất ghi: ['Ngắt khối, không kích hoạt catch...'], xuống-dòng.
{ Đúng ngắt. Xuất ghi: ['đừng viết cái này!'], xuống-dòng. } bắt-lỗi: { Xuất ghi: ['Đừng bắt cái này!']. }, chạy.

Xuất ghi: ['Kiểm tra vòng lặp each của Danh-sách: 0,1'], xuống-dòng.
(Danh-sách ← 1 ; 2 ; 3) ánh-xạ: { :i
	Xuất ghi: ['iteration #'] + i, xuống-dòng.
	(i = 1) ngắt.
}.

Xuất ghi: ['Kiểm tra vòng lặp each của Từ-điển: chỉ c'], xuống-dòng.
>> m := Từ-điển mới.
m đặt: ['first'] tại: ['a'], đặt: ['second'] tại: ['b'], đặt: ['thứ ba'] tại: ['c'].
m mỗi: { :k :v
	Xuất ghi: ['iteration'] + v + k, xuống-dòng.
	Đúng ngắt.
}.

