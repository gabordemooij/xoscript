

Danh-sách khi: ['column:'] làm: { :cột
	>> đáp-số := Danh-sách mới.
	bản-thân mỗi: { :chỉ-số :hàng
		hàng mỗi: { :chỉ-số :ô
			(chỉ-số = cột) đúng: { đáp-số thêm-cuối: ô. }.
		}.
	}. <- đáp-số.
}.


>> a := Danh-sách ←
	(Danh-sách ← 1 ; 2 ; 3) ;
	(Danh-sách ← 4 ; 5 ; 6) ;
	(Danh-sách ← 7 ; 8 ; 9).

>> b := a column: 1.
Xuất ghi: b, xuống-dòng.

b := a column: 20.
Xuất ghi: b, xuống-dòng.

b := a column: -100.
Xuất ghi: b, xuống-dòng.
