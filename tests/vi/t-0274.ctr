

Danh-sách khi: ['column:'] làm: { :column
	>> result := Danh-sách mới.
	bản-thân mỗi: { :index :row
		row mỗi: { :index :cell
			(index = column) đúng: { result thêm-cuối: cell. }.
		}.
	}. <- result.
}.


>> a := Danh-sách ←
	(Danh-sách ← 1 ; 2 ; 3) ;
	(Danh-sách ← 4 ; 5 ; 6) ;
	(Danh-sách ← 7 ; 8 ; 9).

>> b := a column: 1.
Xuất ghi: b, xuống-dòng.

b := a column: 20.
Xuất ghi: b, xuống-dòng.

b := a column: -100.
Xuất ghi: b, xuống-dòng.
