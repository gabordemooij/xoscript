

# tạo một số nguyên 64-bit để tính toán chính xác
>> a := Int64 từ-chuỗi: ['123'].

# thành chuỗi
Xuất ghi: a, xuống-dòng.

# chia
Xuất ghi: a / (Int64 từ-chuỗi: ['3']), xuống-dòng.

# nhân
Xuất ghi: a * (Int64 từ-chuỗi: ['2']), xuống-dòng.

# cộng
Xuất ghi: a + (Int64 từ-chuỗi: ['1']), xuống-dòng.

# trừ
Xuất ghi: a - (Int64 từ-chuỗi: ['2']), xuống-dòng.

# so sánh
Xuất ghi: ( a =   (Int64 từ-chuỗi: ['123'])), xuống-dòng.
Xuất ghi: ( a !=: (Int64 từ-chuỗi: ['124'])), xuống-dòng.
Xuất ghi: ( a <   (Int64 từ-chuỗi: ['124'])), xuống-dòng.
Xuất ghi: ( a >   (Int64 từ-chuỗi: ['122'])), xuống-dòng.
Xuất ghi: ( a >=: (Int64 từ-chuỗi: ['123'])), xuống-dòng.
Xuất ghi: ( a <=: (Int64 từ-chuỗi: ['123'])), xuống-dòng.





	