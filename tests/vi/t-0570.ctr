#Linux

 >> t := Thời-điểm mới.
 
t múi-giờ: ['Europe/Amsterdam'].
t năm: 2020, tháng: 8, ngày: 2, giờ: 21, phút: 2, giây: 1.

>> a := t giờ.
>> ams := t múi-giờ.

t múi-giờ: ['US/Hawaii'].
>> b := t giờ.
>> hw := t múi-giờ.

Xuất
ghi: (
	['It's diff in zone2 than in zone1']
	zone1: ams,
	zone2: hw,
	diff: (
		(b > a)
		hoặc-là: ['later'] hay: ['earlier']
	)
),
xuống-dòng.
 