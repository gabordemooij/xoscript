# a quote that never closes must give an error, not an endless loop
>> đường-dẫn := ['/tmp/test0821.csv'].
>> file := Tệp mới: đường-dẫn.

file ghi: ['a,b\n"1,2\n'].
{
	file dấu-phân-cách: [','] dấu-nháy: ['"'] các-dòng: { :line
		Xuất ghi: line, xuống-dòng.
	}.
} bắt-lỗi: { :e Xuất ghi: e, xuống-dòng. }, chạy.

# a closed quote still works
file ghi: ['a,b\n"1,2",3'].
file dấu-phân-cách: [','] dấu-nháy: ['"'] các-dòng: { :line
	Xuất ghi: line, xuống-dòng.
}.
file xóa.
