>> a := 3.
>> b := a sao-chép.
a trừ: 1.
Xuất ghi: [' a = '] + a.
Xuất ghi: [' b = '] + b.
a := 3.
b := a + 4.
Xuất ghi: [' a = '] + a.
Xuất ghi: [' b = '] + b.
>> x := 3.
>> y := x sao-chép.
x cộng: 10.
y trừ: 1.
Xuất ghi: [' x = '] + x.
Xuất ghi: [' y = '] + y.
>> q := Đối-tượng mới.
q khi: ['setProperty:'] làm: { :x
	riêng tt := x.
}.
q khi: ['lấy-thuộc-tính'] làm: { <- riêng tt.
}.
q setProperty: 9.
>> p := q.
q setProperty: 6.
Xuất ghi: [' p = '] + (p lấy-thuộc-tính).
