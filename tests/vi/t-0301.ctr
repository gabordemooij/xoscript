


>> rượu-vang := Đối-tượng mới.


rượu-vang khi: ['thành-chuỗi'] làm: { <- ['merlot'].
}.

rượu-vang khi: ['naarTekst'] làm: { <- ['merlot'].
}.


rượu-vang khi: ['='] làm: { :other wine <- ( bản-thân thành-chuỗi = other wine ).
}.

rượu-vang khi: ['=='] làm: { :other wine <- ( bản-thân thành-chuỗi = other wine ).
}.



rượu-vang
	trường-hợp: ['cabernet'] làm: { Xuất ghi: ['đây là Cabernet!']. },
	trường-hợp: ['syrah']    làm: { Xuất ghi: ['đây là Syrah!'].    },
	trường-hợp: ['merlot']   làm: { Xuất ghi: ['đây là Merlot!'].   },
	trường-hợp: ['malbec']   làm: { Xuất ghi: ['đây là Malbec!'].   }.

Xuất xuống-dòng.
