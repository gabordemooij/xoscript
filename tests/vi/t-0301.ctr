


>> wine := Đối-tượng mới.


wine khi: ['toString'] làm: { <- ['merlot'].
}.

wine khi: ['naarTekst'] làm: { <- ['merlot'].
}.


wine khi: ['='] làm: { :other wine <- ( bản-thân toString = other wine ).
}.

wine khi: ['=='] làm: { :other wine <- ( bản-thân toString = other wine ).
}.



wine
	trường-hợp: ['cabernet'] làm: { Xuất ghi: ['it's a Cabernet!']. },
	trường-hợp: ['syrah']    làm: { Xuất ghi: ['it's a Syrah!'].    },
	trường-hợp: ['merlot']   làm: { Xuất ghi: ['it's a Merlot!'].   },
	trường-hợp: ['malbec']   làm: { Xuất ghi: ['it's a Malbec!'].   }.

Xuất xuống-dòng.
