>> Grandfather := Đối-tượng mới.
Grandfather khi: ['greet'] làm: {
	Xuất ghi: ['Ave!'], xuống-dòng.
}.
>> Father := Grandfather mới.
Father khi: ['greet'] làm: {
	Xuất ghi: ['Hello'], xuống-dòng.
	bản-thân greet.
}.
>> Son := Father mới.
Son khi: ['greet'] làm: {
	Xuất ghi: ['Hi'], xuống-dòng.
	bản-thân greet.
}.

Son greet.

>> Roundabout := Đối-tượng mới.
Roundabout khi: ['circle:'] làm: { :x
	Xuất ghi: x, xuống-dòng.
	(x < 3) đúng: { bản-thân đệ-quy circle: x + 1. }.
}.

Roundabout circle: 1.

>> x := 1.
>> increment := { (x ≤ 3) đúng: { Xuất ghi: x, xuống-dòng. x cộng: 1.  increment chạy. }. }.
increment chạy.