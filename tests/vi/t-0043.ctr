>> bộ-lặp := Đối-tượng mới.
bộ-lặp khi: ['đáp:'] làm: { :cái-gì
	Xuất ghi: cái-gì + [' '].
}.
bộ-lặp khi: ['đáp:và:'] làm: { :cái-gì :say
	Xuất ghi: cái-gì, ghi: say + [' '].
}.
bộ-lặp khi: ['đáp:và:và:'] làm: { :cái-gì :say :thêm
	Xuất ghi: cái-gì, ghi: say, ghi: thêm.
}.
bộ-lặp lặp-lại.
bộ-lặp everything: ['Tôi nói.'].
bộ-lặp and: ['I '] everything: ['làm.'].
