>> str := ['write:'].
Xuất thông-điệp: ['ghi:'] đối-số: (Danh-sách ← ['Hello World']), xuống-dòng. 

Số khi: ['isbetween:and:'] làm: { :a :b <- ((bản-thân ≥ a) và: (bản-thân ≤ b)).
}.

str := ['isbetween:and:'].
Xuất ghi: (3 thông-điệp: str đối-số: (Danh-sách ← 2 ; 8)), xuống-dòng.
Xuất ghi: (3 thông-điệp: str đối-số: (Danh-sách ← 1 ; 2)), xuống-dòng.


>> CoffeeMachine := Đối-tượng mới.
CoffeeMachine khi: ['makeCoffeeWithSugar:milk:'] làm: { :sugar :milk <- ( ['Here ya go... coffee with '] + 
			sugar +
			[' spoons of sugar and '] +
			milk +
			[' drops of milk.']
	).
}.

>> order := ['makeCoffeeWithSugar:milk:'].
>> coffeeConfiguration := Danh-sách ← 4 ; 2.
Xuất ghi: ( CoffeeMachine thông-điệp: order đối-số: coffeeConfiguration ), xuống-dòng.
