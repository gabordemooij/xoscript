Xuất ghi: ['Test object'], xuống-dòng.
>> a := Đối-tượng mới. 
a khi: ['item:'] làm: { :int64
	riêng int64 := int64. 
}.
a khi: ['item'] làm: { <- riêng int64.
}.
a item: ( Int64 từ-chuỗi: ['9999'] ).
Xuất ghi: a item, xuống-dòng.
>> old-int64-address := a item nguyên-mẫu địa-chỉ-bộ-nhớ.
a save-as: ['/tmp/a.bin'].
Xuất ghi: ['========== RELOADING SNAP:'], xuống-dòng.
>> b := Đối-tượng load-from: ['/tmp/a.bin'].
(b item nguyên-mẫu địa-chỉ-bộ-nhớ = old-int64-address) đúng: {
	Xuất ghi: ['Object link re-attached.'], xuống-dòng.
}.
Xuất ghi: ( b item ), xuống-dòng.
