# giải mã từ utf16le/be hoặc utf32le/be sang utf8
Server init.
>> utf16 := Blob mới: 8, bytes: (
	Danh-sách mới ; Hx x41 ; Hx x00 ; Hx x3D ; Hx xD8
	         ; Hx x0A ; Hx xDE ; Hx x42 ; Hx x00
).

Xuất ghi: ( utf16 giải-mã: ['utf16le'] ), xuống-dòng.

utf16 giải-phóng.
>> utf32 := Blob mới: 13, bytes: (
	Danh-sách mới ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x41
	         ; Hx x00 ; Hx x01 ; Hx xF6 ; Hx x0A
	         ; Hx x00 ; Hx x00 ; Hx x00 ; Hx x42
	         ; Hx x00
).

Xuất ghi: ( utf32 giải-mã: ['utf32be'] ), xuống-dòng.
utf32 giải-phóng.