# test qualifiers

Chương-trình dọn-dẹp.

>> Fruit := Đối-tượng mới.
Fruit khi: ['mới'] làm: {
	>> f := bản-thân mới.
	f apples: 0. <- f.
}.
Fruit khi: ['apples:'] làm: { :a riêng apples := a. }.
Fruit khi: ['apples'] làm: { <- riêng apples. }.
Fruit khi: ['+'] làm: { :f
	>> n := Fruit mới.
	n apples: (f apples + riêng apples). <- n.
}.
Số khi: ['apples'] làm: { <- ((Fruit mới) apples: bản-thân).
}.

Fruit khi: ['chuỗi'] làm: { <- riêng apples + [' apples '].
}.

>> q := 3 apples + 4 apples.
Xuất ghi: q, xuống-dòng.




q := 3 apples + 4 apples.
Xuất ghi: q, xuống-dòng.



q := 3 apples + 4 apples.
Xuất ghi: q, xuống-dòng.


