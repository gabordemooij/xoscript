# kiểm thử đơn vị (qualifier)

Chương-trình dọn-dẹp.

>> Trái-cây := Đối-tượng mới.
Trái-cây khi: ['mới'] làm: {
	>> f := bản-thân mới.
	f apples: 0. <- f.
}.
Trái-cây khi: ['apples:'] làm: { :a riêng táo := a. }.
Trái-cây khi: ['táo'] làm: { <- riêng táo. }.
Trái-cây khi: ['+'] làm: { :f
	>> n := Trái-cây mới.
	n apples: (f táo + riêng táo). <- n.
}.
Số khi: ['táo'] làm: { <- ((Trái-cây mới) apples: bản-thân).
}.

Trái-cây khi: ['chuỗi'] làm: { <- riêng táo + [' táo '].
}.

>> q := 3 táo + 4 táo.
Xuất ghi: q, xuống-dòng.




q := 3 táo + 4 táo.
Xuất ghi: q, xuống-dòng.



q := 3 táo + 4 táo.
Xuất ghi: q, xuống-dòng.


