

>> bộ-nhớ-đã-dùng1 := 0.
>> bộ-nhớ-đã-dùng2 := 0.
>> bộ-nhớ-đã-dùng3 := 0.
>> bộ-nhớ-đã-dùng4 := 0.

Chương-trình quản-lý-bộ-nhớ: 0.

>> txt := ['Word Salad'].
Xuất ghi: ( txt sao-chép từ: 5 độ-dài: 5 ).
Xuất ghi: ( txt sao-chép bỏ-qua: 5, cắt-khoảng-trắng ), xuống-dòng.

Chương-trình dọn-dẹp.

bộ-nhớ-đã-dùng1 := (Chương-trình bộ-nhớ ? 0).


txt := ['Word Salad'].
Xuất ghi: ( txt sao-chép từ: 5 độ-dài: 5 ).
Xuất ghi: ( txt sao-chép bỏ-qua: 5, cắt-khoảng-trắng ), xuống-dòng.

Chương-trình dọn-dẹp.
bộ-nhớ-đã-dùng2 := (Chương-trình bộ-nhớ ? 0).


txt := ['Word Salad'].
Xuất ghi: ( txt sao-chép từ: 5 độ-dài: 5 ).
Xuất ghi: ( txt sao-chép bỏ-qua: 5, cắt-khoảng-trắng ), xuống-dòng.

Chương-trình dọn-dẹp.
bộ-nhớ-đã-dùng3 := (Chương-trình bộ-nhớ ? 0).



( bộ-nhớ-đã-dùng1 = bộ-nhớ-đã-dùng2 và: bộ-nhớ-đã-dùng1 = bộ-nhớ-đã-dùng3, và: bộ-nhớ-đã-dùng2 = bộ-nhớ-đã-dùng3 ) đúng: {
	Xuất ghi: ['Không rò rỉ bộ nhớ ở đây'].
}, sai: {
	Xuất ghi: ['Đang rò rỉ bộ nhớ...'].
}.
