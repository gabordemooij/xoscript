>> Greeter := Đối-tượng mới.
Greeter khi: ['make'] làm: {
	>> greeter := Đối-tượng mới.
	greeter khi: ['name:'] làm: { :tên
		Xuất ghi: ['setting a name'].
		riêng myName := tên.
	}.
	greeter khi: ['performGreeting'] làm: {
		Xuất ghi: ['Hello'].
		Xuất ghi: riêng myName.
	}.
	greeter khi: ['greet'] làm: {
		bản-thân performGreeting.
	}. <- greeter.
}.
>> greeter := Greeter make.
greeter name: ['sunshine!'].
greeter greet.
