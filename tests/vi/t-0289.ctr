#Linux
>> OS := Chương-trình hệ-thống: (Lệnh uname -s), cắt-khoảng-trắng.

>> Slurp := Đối-tượng mới.
Slurp khi: ['mới'] làm: {
	riêng str := [''].
}.
Slurp khi: ['đáp:'] làm: { :blah
		(riêng str ≠ ['']) đúng: {
			riêng str thêm-cuối: [' '].
		}.
		riêng str thêm-cuối: blah.
}.
Slurp khi: ['đáp:và:'] làm: { :blah :blahah
		(riêng str ≠ ['']) đúng: {
			riêng str thêm-cuối: [' '].
		}.
		(blah độ-dài > 1) đúng: {
			riêng str thêm-cuối: (blah từ: 0 độ-dài: (blah độ-dài - 1)).
		}, ngược-lại: {
			riêng str thêm-cuối: blah.
		}.
		riêng str thêm-cuối: [' '].
		riêng str thêm-cuối: blahah.
}.
Slurp khi: ['obtain'] làm: {
	>> buffer := riêng str.
	riêng str := ['']. <- buffer.
}.
>> large text := [''].
{
	large text thêm-cuối: ['hello'].
} × 1000.


Xuất ghi: (
	Chương-trình hệ-thống: (
		Slurp mới
			echo: large text,
			| (['./xo ../../../tests/assets/stdin_test.ctr'] OS: OS)
		) obtain
).

