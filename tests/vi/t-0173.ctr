

Danh-sách khi: ['tổng-cộng'] làm: {
	>> tổng := 0.
	bản-thân mỗi: { :chỉ-số :phần-tử
		tổng cộng: phần-tử.
	}. <- tổng.
}.

Danh-sách khi: ['tích'] làm: {
	>> tổng := 1.
	bản-thân mỗi: { :chỉ-số :phần-tử
		tổng nhân-với: phần-tử.
	}. <- tổng.
}.

>> bộ-nhớ-đã-dùng1 := 0.
>> bộ-nhớ-đã-dùng2 := 0.
>> bộ-nhớ-đã-dùng3 := 0.
>> bộ-nhớ-đã-dùng4 := 0.

Chương-trình quản-lý-bộ-nhớ: 0.

{

>> a := Danh-sách ← ['hello'] ; ['world'] ; Đúng ; Rỗng ; 666.
a := a + ( Danh-sách ← 1 ).
Xuất ghi: ( ['tổng: '] + ( a tổng-cộng ) ), xuống-dòng.
Xuất ghi: ( ['nhỏ nhất: '] + ( a nhỏ-nhất ) ), xuống-dòng.
Xuất ghi: ( ['lớn nhất: '] + ( a lớn-nhất ) ), xuống-dòng.
Xuất ghi: ( ['thứ 3: '] + ( a ? 2 ) ), xuống-dòng.
Xuất ghi: ( ['tích: '] + ( a tích ) ), xuống-dòng.
a sắp-xếp: { :a :b <- (b - a). }.
a mỗi: { :i :e Xuất ghi: ( i - 0 ), xuống-dòng. }.

} chạy.

Chương-trình dọn-dẹp.
bộ-nhớ-đã-dùng1 := (Chương-trình bộ-nhớ ? 0).


{

>> a := Danh-sách ← ['hello'] ; ['world'] ; Đúng ; Rỗng ; 666.
a := a + ( Danh-sách ← 1 ).
Xuất ghi: ( ['tổng: '] + ( a tổng-cộng ) ), xuống-dòng.
Xuất ghi: ( ['nhỏ nhất: '] + ( a nhỏ-nhất ) ), xuống-dòng.
Xuất ghi: ( ['lớn nhất: '] + ( a lớn-nhất ) ), xuống-dòng.
Xuất ghi: ( ['thứ 3: '] + ( a ? 2 ) ), xuống-dòng.
Xuất ghi: ( ['tích: '] + ( a tích ) ), xuống-dòng.
a sắp-xếp: { :a :b <- (b - a). }.
a mỗi: { :i :e Xuất ghi: ( i - 0 ), xuống-dòng. }.

} chạy.



Chương-trình dọn-dẹp.
bộ-nhớ-đã-dùng2 := (Chương-trình bộ-nhớ ? 0).


{

>> a := Danh-sách ← ['hello'] ; ['world'] ; Đúng ; Rỗng ; 666.
a := a + ( Danh-sách ← 1 ).
Xuất ghi: ( ['tổng: '] + ( a tổng-cộng ) ), xuống-dòng.
Xuất ghi: ( ['nhỏ nhất: '] + ( a nhỏ-nhất ) ), xuống-dòng.
Xuất ghi: ( ['lớn nhất: '] + ( a lớn-nhất ) ), xuống-dòng.
Xuất ghi: ( ['thứ 3: '] + ( a ? 2 ) ), xuống-dòng.
Xuất ghi: ( ['tích: '] + ( a tích ) ), xuống-dòng.
a sắp-xếp: { :a :b <- (b - a). }.
a mỗi: { :i :e Xuất ghi: ( i - 0 ), xuống-dòng. }.

} chạy.



Chương-trình dọn-dẹp.
bộ-nhớ-đã-dùng3 := (Chương-trình bộ-nhớ ? 0).

( bộ-nhớ-đã-dùng1 = bộ-nhớ-đã-dùng2 và: bộ-nhớ-đã-dùng1 = bộ-nhớ-đã-dùng3, và: bộ-nhớ-đã-dùng2 = bộ-nhớ-đã-dùng3 ) đúng: {
	Xuất ghi: ['Không rò rỉ bộ nhớ ở đây'].
}, sai: {
	Xuất ghi: ['Đang rò rỉ bộ nhớ...'].
}.
