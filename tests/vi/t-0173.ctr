

Danh-sách khi: ['sum'] làm: {
	>> total := 0.
	bản-thân mỗi: { :index :element
		total cộng: element.
	}. <- total.
}.

Danh-sách khi: ['product'] làm: {
	>> total := 1.
	bản-thân mỗi: { :index :element
		total nhân-với: element.
	}. <- total.
}.

>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Chương-trình quản-lý-bộ-nhớ: 0.

{

>> a := Danh-sách ← ['hello'] ; ['world'] ; Đúng ; Rỗng ; 666.
a := a + ( Danh-sách ← 1 ).
Xuất ghi: ( ['sum: '] + ( a sum ) ), xuống-dòng.
Xuất ghi: ( ['min: '] + ( a nhỏ-nhất ) ), xuống-dòng.
Xuất ghi: ( ['max: '] + ( a lớn-nhất ) ), xuống-dòng.
Xuất ghi: ( ['3rd: '] + ( a ? 2 ) ), xuống-dòng.
Xuất ghi: ( ['prd: '] + ( a product ) ), xuống-dòng.
a sắp-xếp: { :a :b <- (b - a). }.
a mỗi: { :i :e Xuất ghi: ( i - 0 ), xuống-dòng. }.

} chạy.

Chương-trình dọn-dẹp.
usedMemory1 := (Chương-trình bộ-nhớ ? 0).


