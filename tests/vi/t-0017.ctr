Số khi: ['giai-thừa'] làm: {
	>> tổng := 1.
	{ :chỉ-số tổng nhân-với: (bản-thân - (chỉ-số)). } × bản-thân. <- tổng.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Xuất ghi: a.
>> b := 2 + 3 giai-thừa.
Xuất ghi: b.
>> c := 3 giai-thừa + 2.
Xuất ghi: c.
>> d := 2 + (3 giai-thừa).
Xuất ghi: d.
Xuất ghi: 2 + 3 giai-thừa + 1.
