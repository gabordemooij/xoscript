Số khi: ['factorial'] làm: {
	>> total := 1.
	{ :index total nhân-với: (bản-thân - (index)). } × bản-thân. <- total.
}.

>> a := 3 + 2 + 10 + 1 - 3.
Xuất ghi: a.
>> b := 2 + 3 factorial.
Xuất ghi: b.
>> c := 3 factorial + 2.
Xuất ghi: c.
>> d := 2 + (3 factorial).
Xuất ghi: d.
Xuất ghi: 2 + 3 factorial + 1.
