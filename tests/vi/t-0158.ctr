>> x := [' hallo '].

>> y := x chữ-hoa.
Xuất ghi: x, xuống-dòng.
Xuất ghi: (x chính-là: y), xuống-dòng.

>> y := x chữ-thường.
Xuất ghi: x, xuống-dòng.
Xuất ghi: (x chính-là: y), xuống-dòng.

>> y := x cắt-khoảng-trắng.
Xuất ghi: x, xuống-dòng.
Xuất ghi: (x chính-là: y), xuống-dòng.

>> y := x bỏ-qua: 1.
Xuất ghi: x, xuống-dòng.
Xuất ghi: (x chính-là: y), xuống-dòng.

>> y := x từ: 1 độ-dài: 2.
Xuất ghi: x, xuống-dòng.
Xuất ghi: (x chính-là: y), xuống-dòng.