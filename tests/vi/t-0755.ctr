Xuất ghi: ['Đối tượng thử nghiệm'], xuống-dòng.
>> người-chào := Đối-tượng mới.
người-chào khi: ['name:'] làm: { :tên
	riêng tên-x := tên. 
}.
người-chào khi: ['chào'] làm: {
	Xuất ghi: ['Xin chào '] + riêng tên-x, xuống-dòng.
}.
người-chào name: ['Sherlock'].
người-chào save-as: ['/tmp/a.bin'].
Xuất ghi: ['========== ĐANG TẢI LẠI SNAP:'], xuống-dòng.
>> b := Đối-tượng load-from: ['/tmp/a.bin'].
b chào.
b name: ['Watson'], chào.
