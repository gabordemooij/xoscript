>> bộ-ngẫu-nhiên := { :a :b
	>> nhỏ-nhất := ( a < b ) hoặc-là: a hay: b.
	>> lớn-nhất := ( a > b ) hoặc-là: a hay: b.
	>> x := Rỗng.
	{
		x := Số giữa: a và: b.
		((x < nhỏ-nhất) hoặc: (x > lớn-nhất)) đúng: { 
			Xuất ghi: (['Giá trị không hợp lệ!']).
			Chương-trình kết-thúc.
		}.
	} 
	× 100. <- x.
}.
bộ-ngẫu-nhiên áp-dụng: 0 và: 0.
bộ-ngẫu-nhiên áp-dụng: 1 và: 0.
