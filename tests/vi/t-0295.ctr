
>> bộ-từ-vựng := (
	Từ-điển mới
		đặt: ['b'] tại: ['a'],
		đặt: ['a'] tại: ['b'],
		đặt: ['z'] tại: ['x'],
		đặt: ['hello'] tại: ['hallo'],
		đặt: ['human'] tại: ['human']
).

>> các-phép-so-sánh := Danh-sách mới.
bộ-từ-vựng mỗi: { :a :b
	các-phép-so-sánh ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a so-sánh: b)
	).
}.

các-phép-so-sánh sắp-xếp: { :a :b <- ( a so-sánh: b ). }.
Xuất ghi: ( các-phép-so-sánh nối: ['↵'] ), xuống-dòng.
các-phép-so-sánh nối: ['↵'].
