
>> dictionary := (
	Từ-điển mới
		đặt: ['b'] tại: ['a'],
		đặt: ['a'] tại: ['b'],
		đặt: ['z'] tại: ['x'],
		đặt: ['hello'] tại: ['hallo'],
		đặt: ['human'] tại: ['human']
).

>> comparisons := Danh-sách mới.
dictionary mỗi: { :a :b
	comparisons ; (
		['a= b= | a>b a≥b a<b a≤b ab']
		a=: a,
		b=: b,
		a>b: ( a > b ),
		a≥b: ( a ≥ b ),
		a<b: ( a < b ),
		a≤b: ( a ≤ b ),
		ab:  ( a so-sánh: b)
	).
}.

comparisons sắp-xếp: { :a :b <- ( a so-sánh: b ). }.
Xuất ghi: ( comparisons nối: ['↵'] ), xuống-dòng.
comparisons nối: ['↵'].
