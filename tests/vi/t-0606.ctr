>> Point := Đối-tượng mới.
Point khi: ['x-coordinate:'] làm: { :x riêng x := x. }.
Point khi: ['y-coordinate:'] làm: { :y riêng y := y. }.
Point khi: ['x-coordinate']  làm: { <- riêng x sao-chép. }.
Point khi: ['y-coordinate']  làm: { <- riêng y sao-chép. }.

Point khi: ['='] làm: { :other <- ( riêng x = other x-coordinate
		 và: riêng y = other y-coordinate ).
}.

>> pier := Point mới x-coordinate: 5, y-coordinate: 6.
>> town-hall := Point mới x-coordinate: 7, y-coordinate: 1.
>> restaurant := Point mới x-coordinate: 5, y-coordinate: 6.

Xuất ghi: pier = town-hall, xuống-dòng.
Xuất ghi: pier = restaurant, xuống-dòng.
