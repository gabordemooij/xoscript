>> Animal := Đối-tượng mới.
>> Factory := Đối-tượng mới.

Animal khi: ['mới'] làm: {
	>> animal := bản-thân mới.
	animal sound: ['?']. <- animal.
}.

Animal khi: ['sound:'] làm: { :s
	riêng sound := s.
}.

Animal khi: ['sound'] làm: { <- riêng sound.
}.

>> Dog := Đối-tượng mới.
>> Cat := Đối-tượng mới.

Dog khi: ['mới'] làm: { <- Animal mới sound: ['woof!'].
}.

Cat khi: ['mới'] làm: { <- Animal mới sound: ['meow!'].
}.

Xuất ghi: Dog mới sound, xuống-dòng.
Xuất ghi: Cat mới sound, xuống-dòng.

Factory khi: ['mix:and:'] làm: { :beast1 :beast2 <- Animal mới sound: (
		( beast1 sound từ: 0 độ-dài: 2 ) +
		( beast2 sound từ: 2 độ-dài: 5 )
	).
}.

Xuất ghi: (Factory mix: Dog mới and: Cat mới) sound, xuống-dòng.
