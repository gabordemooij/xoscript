


>> bộ-nhớ-đã-dùng1 := 0.
>> bộ-nhớ-đã-dùng2 := 0.
>> bộ-nhớ-đã-dùng3 := 0.
>> bộ-nhớ-đã-dùng4 := 0.

Chương-trình quản-lý-bộ-nhớ: 0.
>> bảng-màu := Rỗng.
>> các-màu := Rỗng.

{
bảng-màu := Từ-điển mới.
bảng-màu 
	đặt: ['#F00'] tại: ['đỏ'],
	đặt: ['#0F0'] tại: ['xanh lá'],
	đặt: ['#00F'] tại: ['xanh-dương'].
Xuất ghi: ['số mã RGB trong bảng màu: '] + ( bảng-màu đếm ), xuống-dòng.
Xuất ghi: ['mã RGB của xanh lá là: '] + ( bảng-màu ? ['xanh lá'] ), xuống-dòng.
các-màu := [''].
( bảng-màu mỗi: { :tên :mã
		các-màu := các-màu + ( tên + [':'] + mã ).
} ).
Xuất ghi: ['Tất cả màu trong bảng màu: '] + các-màu, xuống-dòng.
} chạy.
Chương-trình dọn-dẹp.
bộ-nhớ-đã-dùng1 := (Chương-trình bộ-nhớ ? 0).

{
bảng-màu := Từ-điển mới.
bảng-màu 
	đặt: ['#F00'] tại: ['đỏ'],
	đặt: ['#0F0'] tại: ['xanh lá'],
	đặt: ['#00F'] tại: ['xanh-dương'].
Xuất ghi: ['số mã RGB trong bảng màu: '] + ( bảng-màu đếm ), xuống-dòng.
Xuất ghi: ['mã RGB của xanh lá là: '] + ( bảng-màu ? ['xanh lá'] ), xuống-dòng.
các-màu := [''].
( bảng-màu mỗi: { :tên :mã
		các-màu := các-màu + ( tên + [':'] + mã ).
} ).
Xuất ghi: ['Tất cả màu trong bảng màu: '] + các-màu, xuống-dòng.
} chạy.
Chương-trình dọn-dẹp.
bộ-nhớ-đã-dùng2 := (Chương-trình bộ-nhớ ? 0).

{
bảng-màu := Từ-điển mới.
bảng-màu 
	đặt: ['#F00'] tại: ['đỏ'],
	đặt: ['#0F0'] tại: ['xanh lá'],
	đặt: ['#00F'] tại: ['xanh-dương'].
Xuất ghi: ['số mã RGB trong bảng màu: '] + ( bảng-màu đếm ), xuống-dòng.
Xuất ghi: ['mã RGB của xanh lá là: '] + ( bảng-màu ? ['xanh lá'] ), xuống-dòng.
các-màu := [''].
( bảng-màu mỗi: { :tên :mã
		các-màu := các-màu + ( tên + [':'] + mã ).
} ).
Xuất ghi: ['Tất cả màu trong bảng màu: '] + các-màu, xuống-dòng.
} chạy.
Chương-trình dọn-dẹp.
bộ-nhớ-đã-dùng3 := (Chương-trình bộ-nhớ ? 0).



( bộ-nhớ-đã-dùng1 = bộ-nhớ-đã-dùng2 và: bộ-nhớ-đã-dùng1 = bộ-nhớ-đã-dùng3, và: bộ-nhớ-đã-dùng2 = bộ-nhớ-đã-dùng3 ) đúng: {
	Xuất ghi: ['Không rò rỉ bộ nhớ ở đây'].
}, sai: {
	Xuất ghi: ['Đang rò rỉ bộ nhớ...'].
}.
