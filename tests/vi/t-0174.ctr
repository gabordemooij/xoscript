


>> usedMemory1 := 0.
>> usedMemory2 := 0.
>> usedMemory3 := 0.
>> usedMemory4 := 0.

Chương-trình quản-lý-bộ-nhớ: 0.
>> palette := Rỗng.
>> colors := Rỗng.

{
palette := Từ-điển mới.
palette 
	đặt: ['#F00'] tại: ['red'],
	đặt: ['#0F0'] tại: ['green'],
	đặt: ['#00F'] tại: ['blue'].
Xuất ghi: ['number of RGB codes in palette: '] + ( palette đếm ), xuống-dòng.
Xuất ghi: ['RGB code of green is: '] + ( palette ? ['green'] ), xuống-dòng.
colors := [''].
( palette mỗi: { :tên :mã
		colors := colors + ( tên + [':'] + mã ).
} ).
Xuất ghi: ['All colors in palette: '] + colors, xuống-dòng.
} chạy.
Chương-trình dọn-dẹp.
usedMemory1 := (Chương-trình bộ-nhớ ? 0).

