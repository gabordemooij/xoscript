Xuất ghi: ['Test object'], xuống-dòng.
>> a := Đối-tượng mới. 

a khi: ['item:'] làm: { :fmt
	riêng fmt := fmt. 
}.

a khi: ['item'] làm: { <- riêng fmt.
}.

a item: ( Định-dạng mới: ['|%s|'] ).

Xuất ghi: a item, xuống-dòng.

>> old-fmt-address := a item nguyên-mẫu địa-chỉ-bộ-nhớ.
a save-as: ['/tmp/a.bin'].
Xuất ghi: ['========== RELOADING SNAP:'], xuống-dòng.

>> b := Đối-tượng load-from: ['/tmp/a.bin'].

(b item nguyên-mẫu địa-chỉ-bộ-nhớ = old-fmt-address) đúng: {
	Xuất ghi: ['Object link re-attached.'], xuống-dòng.
}.

Xuất ghi: ( b item áp-dụng: ['hello'] ), xuống-dòng.
