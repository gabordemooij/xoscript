Xuất ghi: ['Đối tượng thử nghiệm'], xuống-dòng.
>> a := Đối-tượng mới. 

a khi: ['item:'] làm: { :đầu-ra
	riêng đầu-ra := đầu-ra. 
}.

a khi: ['mục'] làm: {
	<- riêng đầu-ra.
}.

a khi: ['chào'] làm: {
	Xuất ghi: ['chào từ Xuất gốc!'], xuống-dòng.
}.

a item: Xuất.

Xuất ghi: a mục, xuống-dòng.

>> địa-chỉ-cũ-đầu-ra := a mục nguyên-mẫu địa-chỉ-bộ-nhớ.
a save-as: ['/tmp/a.bin'].
Xuất ghi: ['========== ĐANG TẢI LẠI SNAP:'], xuống-dòng.

>> b := Đối-tượng load-from: ['/tmp/a.bin'].

(b mục nguyên-mẫu địa-chỉ-bộ-nhớ = địa-chỉ-cũ-đầu-ra) đúng: {
	Xuất ghi: ['Liên kết đối tượng đã được gắn lại.'], xuống-dòng.
}.

b mục ghi: ['xin chào từ Xuất đã tải!'], xuống-dòng.
b chào.
