Xuất ghi: ['Test object'], xuống-dòng.
>> a := Đối-tượng mới. 

a khi: ['item:'] làm: { :out
	riêng out := out. 
}.

a khi: ['item'] làm: { <- riêng out.
}.

a khi: ['greet'] làm: {
	Xuất ghi: ['hi from original out!'], xuống-dòng.
}.

a item: Xuất.

Xuất ghi: a item, xuống-dòng.

>> old-out-address := a item nguyên-mẫu địa-chỉ-bộ-nhớ.
a save-as: ['/tmp/a.bin'].
Xuất ghi: ['========== RELOADING SNAP:'], xuống-dòng.

>> b := Đối-tượng load-from: ['/tmp/a.bin'].

(b item nguyên-mẫu địa-chỉ-bộ-nhớ = old-out-address) đúng: {
	Xuất ghi: ['Object link re-attached.'], xuống-dòng.
}.

b item ghi: ['hello from loaded out!'], xuống-dòng.
b greet.
