
>> Hút := Đối-tượng mới.

Hút khi: ['mới'] làm: {
	riêng str := [''].
}.

Hút khi: ['đáp:'] làm: { :blah
		(riêng str = ['']) đúng: {
			riêng str thêm-cuối: blah.
		}, ngược-lại: {
			riêng str thêm-cuối: [' '].
			riêng str thêm-cuối: blah.
		}.
}.

Hút khi: ['đáp:và:'] làm: { :blah :blahah
		(blah độ-dài > 1) đúng: {
			riêng str thêm-cuối: (blah từ: 0 độ-dài: (blah độ-dài - 1)).
		}, ngược-lại: {
			riêng str thêm-cuối: blah.
		}.
		riêng str thêm-cuối: [' '].
		riêng str thêm-cuối: blahah.
}.

Hút khi: ['thu-về'] làm: {
	>> bộ-đệm := riêng str.
	riêng str := ['']. <- bộ-đệm.
}.

Xuất ghi: ( Chương-trình hệ-thống: ( Hút mới echo hello world thu-về ) ).
