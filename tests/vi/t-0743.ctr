>> V := Đối-tượng.
V khi: ['chuỗi'] làm: {
	Xuất ghi: ['cast'], xuống-dòng. <- ['abc'].
}.

Xuất ghi: ( Chương-trình thiết-lập: ['abc'] ), xuống-dòng.

# params should not get gc'ed
Chương-trình thiết-lập: ([''] + V mới) giá-trị: ([''] + V mới).

Xuất ghi: ( Chương-trình thiết-lập: ['abc'] ), xuống-dòng.
