Server init.

# write a test file
>> f := Tệp mới: ['/tmp/test.gif'].
f ghi: ['GIF87a01234567810'].

# serve the file
Server chuyển-tiếp: ['test.gif'] tiền-tố: ['/tmp/'].

Xuất xuống-dòng.

Xuất ghi: ['Outside container (security):'], xuống-dòng.
{ Server chuyển-tiếp: ['../passwd'] tiền-tố: ['/tmp/']. }
bắt-lỗi: { :e Xuất ghi: e, xuống-dòng. },
chạy.

Xuất ghi: ['Invalid prefix:'], xuống-dòng.
{ Server chuyển-tiếp: ['test.gif'] tiền-tố: ['z:\\']. }
bắt-lỗi: { :e Xuất ghi: e, xuống-dòng. },
chạy.

Xuất ghi: ['Non-existant file:'], xuống-dòng.
{ Server chuyển-tiếp: ['xxx.xxx'] tiền-tố: ['/tmp/']. }
bắt-lỗi: { :e Xuất ghi: e, xuống-dòng. },
chạy.
