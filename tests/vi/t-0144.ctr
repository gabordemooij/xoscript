



>> CoffeeGrounds := Đối-tượng mới.
CoffeeGrounds khi: ['extract'] làm: { <- ['coffee']. }.

>> CoffeeMachine := Đối-tượng mới.
CoffeeMachine khi: ['init'] làm: {
	riêng coffeegrounds := CoffeeGrounds mới.
}.
CoffeeMachine khi: ['mới'] làm: { <- CoffeeMachine `new init.
}.

CoffeeMachine khi: ['makeTea'] làm: { <- (riêng tealeaves extract). }.
CoffeeMachine khi: ['makeCoffee'] làm: { <- (riêng coffeegrounds extract). }.

>> coffeeDream := CoffeeMachine mới.

Xuất ghi:
	coffeeDream 
	makeCoffee.

Xuất ghi:
	coffeeDream 
	makeTea.
