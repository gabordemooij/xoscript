Xuất ghi: ['Test object'], xuống-dòng.
>> a := Đối-tượng mới. 

a khi: ['item:'] làm: { :num
	riêng num := num. 
}.

a khi: ['item'] làm: { <- riêng num.
}.

a item: 123.

Xuất ghi: a item, xuống-dòng.

>> old-num-address := a item nguyên-mẫu địa-chỉ-bộ-nhớ.
a save-as: ['/tmp/a.bin'].
Xuất ghi: ['========== RELOADING SNAP:'], xuống-dòng.

>> b := Đối-tượng load-from: ['/tmp/a.bin'].

(b item nguyên-mẫu địa-chỉ-bộ-nhớ = old-num-address) đúng: {
	Xuất ghi: ['Object link re-attached.'], xuống-dòng.
}.

Xuất ghi: b item, xuống-dòng.
