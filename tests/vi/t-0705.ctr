

>> obj := Đối-tượng mới.

obj khi: ['chào'] làm: {
	<- ['chào-nhé'].
}.

# phải xuất ra hi123hi123ok
obj khi: ['việc'] làm: {
	riêng thuộc-tính := 123.
	{
		# try gắn self/own vào đối tượng thay vì khối lệnh
		Xuất ghi: bản-thân chào.
		Xuất ghi: riêng thuộc-tính.
		1 / 0.
	} bắt-lỗi: {
		Xuất ghi: bản-thân chào.
		Xuất ghi: riêng thuộc-tính.
		Xuất ghi: ['ok'].
	}, thử.
}.

obj việc.