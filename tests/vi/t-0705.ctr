

>> obj := Đối-tượng mới.

obj khi: ['greet'] làm: { <- ['hi'].
}.

# needs to output hi123hi123ok
obj khi: ['task'] làm: {
	riêng property := 123.
	{
		# try binds self/own to object instead of block
		Xuất ghi: bản-thân greet.
		Xuất ghi: riêng property.
		1 / 0.
	} bắt-lỗi: {
		Xuất ghi: bản-thân greet.
		Xuất ghi: riêng property.
		Xuất ghi: ['ok'].
	}, thử.
}.

obj task.