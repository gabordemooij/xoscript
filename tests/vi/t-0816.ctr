# a format must fit the type of the value, the type can come from a client
>> thử := { :format :value
	{ Xuất ghi: ( (Định-dạng mới: format) áp-dụng: value ), xuống-dòng. } bắt-lỗi: { :e Xuất ghi: e, xuống-dòng. }, chạy.
}.
>> try-int := { :format :value
	{ Xuất ghi: ( (Định-dạng mới: format) áp-dụng-số-nguyên: value ), xuống-dòng. } bắt-lỗi: { :e Xuất ghi: e, xuống-dòng. }, chạy.
}.

# fits
thử áp-dụng: ['|%s|'] và: ['text'].
thử áp-dụng: ['%06.2f'] và: 5.5.
thử áp-dụng: ['100%% %s'] và: ['sure'].
try-int áp-dụng: ['%03d'] và: 7.
try-int áp-dụng: ['%x'] và: 255.
thử áp-dụng: ['%d'] và: (Int64 mới từ-chuỗi: ['12']).
thử áp-dụng: ['%lld'] và: (Int64 mới từ-chuỗi: ['12']).
thử áp-dụng: ['%.1lf'] và: 5.5.
try-int áp-dụng: ['%hd'] và: 7.

# does not fit
thử áp-dụng: ['%s'] và: 12345.
thử áp-dụng: ['%d'] và: 12345.
thử áp-dụng: ['%f'] và: ['text'].
try-int áp-dụng: ['%d'] và: ['text'].
try-int áp-dụng: ['%s'] và: 5.
thử áp-dụng: ['%s %s'] và: ['text'].
thử áp-dụng: ['%n'] và: ['text'].
thử áp-dụng: ['%*s'] và: ['text'].
thử áp-dụng: ['%'] và: ['text'].

# length modifier does not fit
thử áp-dụng: ['%ls'] và: ['text'].
thử áp-dụng: ['%Lf'] và: 5.5.
try-int áp-dụng: ['%ld'] và: 7.
try-int áp-dụng: ['%lld'] và: 7.
thử áp-dụng: ['%Ld'] và: (Int64 mới từ-chuỗi: ['12']).

# a width that does not fit printf must give an error, not a crash
thử áp-dụng: ['%99999999999s'] và: ['text'].
