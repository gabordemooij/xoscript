Server init.

>> long := ( Danh-sách mới điền: 1000 bằng: ['a'] ) nối: [''].

# sign a message
Xuất ghi: ( 
	Két ký: ['abc'] bằng: long
), xuống-dòng.

Xuất ghi: ( 
	Két
		kiểm-tra: ['abc'] 
		chữ-ký: long 
		bằng: long
), xuống-dòng.

Xuất ghi: (
	Két băm-mật-khẩu: long xác-minh: long
), xuống-dòng.
