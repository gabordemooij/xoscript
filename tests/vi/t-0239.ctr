Danh-sách khi: ['tổng-cộng'] làm: {
	>> tổng := 0.
	bản-thân mỗi: { :chỉ-số :phần-tử
		tổng cộng: phần-tử.
	}. <- tổng.
}.

>> a := Đúng.



a khi: ['chuỗi'] làm: {
	>> câu-trả-lời := Rỗng.
	( bản-thân = Đúng ) đúng: {
		câu-trả-lời := ['Ừ'].
	}, ngược-lại: {
		câu-trả-lời := ['Không đâu'].
	}. <- câu-trả-lời.
}.

a khi: ['số'] làm: {
	>> câu-trả-lời := Rỗng.
	( bản-thân = Đúng ) đúng: {
		câu-trả-lời := 10.
	}, ngược-lại: {
		câu-trả-lời := 20.
	}. <- câu-trả-lời.
}.

>> b := 666.

b khi: ['chuỗi'] làm: { <- ['Quỷ dữ'].
}.

b khi: ['lôgic'] làm: { <- Sai.
}.


Xuất ghi: a, xuống-dòng.  
Xuất ghi: (90 + a), xuống-dòng. 
Xuất ghi: b, xuống-dòng. 
Xuất ghi: (Đúng và: b), xuống-dòng.

a := Danh-sách ← ['hello'] ; ['world'] ; Đúng ; Rỗng ; 666. 
a := a + ( Danh-sách ← 1 ).
Xuất ghi: a, xuống-dòng.
Xuất ghi: ((Từ-điển mới) đặt: Rỗng tại: Rỗng), xuống-dòng.
Xuất ghi: a tổng-cộng, xuống-dòng. 


{
	a khi: ['chuỗi'] làm: { <- Rỗng. }.
	a := [''] + a.
} bắt-lỗi: { :sự-cố
	Xuất ghi: ['Đã ghi nhận lỗi: '] + sự-cố, xuống-dòng.
}, chạy.



{
	a khi: ['số'] làm: { <- Rỗng. }.
	a := 3 × a.
} bắt-lỗi: { :sự-cố
	Xuất ghi: ['Đã ghi nhận lỗi: '] + sự-cố, xuống-dòng.
}, chạy.


