Danh-sách khi: ['sum'] làm: {
	>> total := 0.
	bản-thân mỗi: { :index :element
		total cộng: element.
	}. <- total.
}.

>> a := Đúng.



a khi: ['chuỗi'] làm: {
	>> answer := Rỗng.
	( bản-thân = Đúng ) đúng: {
		answer := ['Yep'].
	}, ngược-lại: {
		answer := ['Nope'].
	}. <- answer.
}.

a khi: ['số'] làm: {
	>> answer := Rỗng.
	( bản-thân = Đúng ) đúng: {
		answer := 10.
	}, ngược-lại: {
		answer := 20.
	}. <- answer.
}.

>> b := 666.

b khi: ['chuỗi'] làm: { <- ['Devil'].
}.

b khi: ['lôgic'] làm: { <- Sai.
}.


Xuất ghi: a, xuống-dòng.  
Xuất ghi: (90 + a), xuống-dòng. 
Xuất ghi: b, xuống-dòng. 
Xuất ghi: (Đúng và: b), xuống-dòng.

a := Danh-sách ← ['hello'] ; ['world'] ; Đúng ; Rỗng ; 666. 
a := a + ( Danh-sách ← 1 ).
Xuất ghi: a, xuống-dòng.
Xuất ghi: ((Từ-điển mới) đặt: Rỗng tại: Rỗng), xuống-dòng.
Xuất ghi: a sum, xuống-dòng. 


{
	a khi: ['chuỗi'] làm: { <- Rỗng. }.
	a := [''] + a.
} bắt-lỗi: { :error
	Xuất ghi: ['Error noted: '] + error, xuống-dòng.
}, chạy.



{
	a khi: ['số'] làm: { <- Rỗng. }.
	a := 3 × a.
} bắt-lỗi: { :error
	Xuất ghi: ['Error noted: '] + error, xuống-dòng.
}, chạy.


{
	a khi: ['lôgic'] làm: { <- Rỗng. }.
	a := Đúng và: a. 
} bắt-lỗi: { :error
	Xuất ghi: ['Error noted: '] + error, xuống-dòng.
}, chạy.





