# Program shell-escape produces canonical posix shell syntax
# compatible with: bash/dash, zsh, ksh

>> c := Chương-trình shell-escape: ['abc'].
Xuất ghi: c, xuống-dòng.
Xuất ghi: ( Chương-trình hệ-thống: ['echo '] + c ), xuống-dòng.

c := Chương-trình shell-escape: ['a'b'c'].
Xuất ghi: c, xuống-dòng.
Xuất ghi: ( Chương-trình hệ-thống: ['echo '] + c ), xuống-dòng.

c := Chương-trình shell-escape: ['a\'c'].
Xuất ghi: c, xuống-dòng.
Xuất ghi: ( Chương-trình hệ-thống: ['echo '] + c ), xuống-dòng.