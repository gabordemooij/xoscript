Server init.

Xuất ghi: (
	Mẫu mới: ['^\\w+$'],
	khớp: ['test@example.com'] 
), xuống-dòng. # 0 kết quả khớp, thất bại ở @ và .

Xuất ghi: (
	Mẫu mới: ['^[^@]+@[^\.]+\.\\w+$'],
	khớp: ['test@example.com'] 
), xuống-dòng. # 1 kết quả khớp

Xuất ghi: (
	Mẫu mới: ['[^@]+@[^\.]+\.\\w+'],
	khớp: ['test@example.com'] 
), xuống-dòng. # 1 kết quả khớp

Xuất ghi: (
	Mẫu mới: ['([^@]+)@([^\.]+)\.\\w+'],
	khớp: ['test@example.com'] 
), xuống-dòng. # 1 kết quả khớp, các nhóm không quan trọng

Xuất ghi: (
	Mẫu mới: ['[a-z]'],
	khớp: ['test@example.com'] 
), xuống-dòng. # 14 kết quả khớp

Xuất ghi: (
	Mẫu mới: ['.*'],
	khớp: ['test@example.com'] 
), xuống-dòng. # 1 kết quả khớp (tất cả)

Xuất ghi: (
	Mẫu mới: ['(.*)'],
	khớp: ['test@example.com'] 
), xuống-dòng. # 1 kết quả khớp (tất cả)

Xuất ghi: (
	Mẫu mới: ['\\s*[^@]+@[^\.]+\.\\w+'],
	khớp: ['test@example.com'] 
), xuống-dòng. # 1 kết quả khớp, khoảng trắng đầu tùy chọn, bị bỏ qua