Server init.

Xuất ghi: (
	Mẫu mới: ['^\\w+$'],
	khớp: ['test@example.com'] 
), xuống-dòng. # 0 match, fails on @ and .

Xuất ghi: (
	Mẫu mới: ['^[^@]+@[^\.]+\.\\w+$'],
	khớp: ['test@example.com'] 
), xuống-dòng. # 1 match

Xuất ghi: (
	Mẫu mới: ['[^@]+@[^\.]+\.\\w+'],
	khớp: ['test@example.com'] 
), xuống-dòng. # 1 match

Xuất ghi: (
	Mẫu mới: ['([^@]+)@([^\.]+)\.\\w+'],
	khớp: ['test@example.com'] 
), xuống-dòng. # 1 match, groups dont matter

Xuất ghi: (
	Mẫu mới: ['[a-z]'],
	khớp: ['test@example.com'] 
), xuống-dòng. # 14 matches

Xuất ghi: (
	Mẫu mới: ['.*'],
	khớp: ['test@example.com'] 
), xuống-dòng. # 1 match (all)

Xuất ghi: (
	Mẫu mới: ['(.*)'],
	khớp: ['test@example.com'] 
), xuống-dòng. # 1 match (all)

Xuất ghi: (
	Mẫu mới: ['\\s*[^@]+@[^\.]+\.\\w+'],
	khớp: ['test@example.com'] 
), xuống-dòng. # 1 match, prefix space optional, gets ignored