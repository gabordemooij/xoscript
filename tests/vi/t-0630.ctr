#kiểm thử regex
Server init.
>> subject := ['<html>
	<a href="http://link1" target="_blank">
	<a href="http://link2" target="_blank">
</html>'].
>> mẫu-regex := Mẫu mới: ['href="([^"]+)" target="([^"]+)"'].
>> đáp-số  := mẫu-regex khớp: subject làm: { :m :x
	Xuất ghi: m, xuống-dòng.
	Xuất ghi: x, xuống-dòng.
	<- ['XXX'].
}.
Xuất ghi: đáp-số, xuống-dòng.