# Băm mật khẩu
Server init.

# Người dùng đặt một mật khẩu
>> mk := ['pass123'].

# Bạn lưu nó như thế này
>> mã-băm := Két 
	băm-mật-khẩu: mk.

# Sau đó, người dùng đăng nhập
# Lần thử 1
>> a1 := ['abcd123'].
# Lần thử 2
>> a2 := ['pass123'].

# Xác minh
>> a := Két 
	băm-mật-khẩu: mã-băm xác-minh: a1.
	# thất bại 
>> b := Két
	băm-mật-khẩu: mã-băm xác-minh: a2.
	# ok!

Xuất ghi: a, xuống-dòng.
Xuất ghi: b, xuống-dòng.

