# Password hashing
Server init.

# User sets a password
>> passw := ['pass123'].

# You store it like this
>> hash := Két 
	băm-mật-khẩu: passw.

# Then, user logs in
# Attempt 1
>> a1 := ['abcd123'].
# Attempt 2
>> a2 := ['pass123'].

# Verify
>> a := Két 
	băm-mật-khẩu: hash xác-minh: a1.
	# fail 
>> b := Két
	băm-mật-khẩu: hash xác-minh: a2.
	# ok!

Xuất ghi: a, xuống-dòng.
Xuất ghi: b, xuống-dòng.

