60 × {
	>> x := (Số random % 6) + 1.
	(x ≤ 6) sai: { Xuất ghi: ['FAIL']. }.
	(x ≥0) sai: { Xuất ghi: ['FAIL']. }.
	x := (Số random % 3) + 1.
	(x < 3) sai: { Xuất ghi: ['FAIL']. }.
	(x>-1) sai: { Xuất ghi: ['FAIL']. }.
	x := ((Lôgic flip) số).
	(x = 0 hoặc: x = 1) sai: { Xuất ghi: ['FAIL']. }.
	x := ((Đúng flip) số).
	(x = 0 hoặc: x = 1) sai: { Xuất ghi: ['FAIL']. }.
	x := (Lôgic flip hoặc-là: ['HEAD'] hay: ['TAIL']).
	((x = ['HEAD']) hoặc: (x = ['TAIL'])) sai: { Xuất ghi: ['FAIL']. }.
}.
Xuất ghi: ['DONE'].

