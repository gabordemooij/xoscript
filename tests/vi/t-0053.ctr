60 × {
	>> x := (Số bất-kỳ % 6) + 1.
	(x ≤ 6) sai: { Xuất ghi: ['THẤT BẠI']. }.
	(x ≥0) sai: { Xuất ghi: ['THẤT BẠI']. }.
	x := (Số bất-kỳ % 3) + 1.
	(x < 3) sai: { Xuất ghi: ['THẤT BẠI']. }.
	(x>-1) sai: { Xuất ghi: ['THẤT BẠI']. }.
	x := ((Lôgic tung-đồng-xu) số).
	(x = 0 hoặc: x = 1) sai: { Xuất ghi: ['THẤT BẠI']. }.
	x := ((Đúng tung-đồng-xu) số).
	(x = 0 hoặc: x = 1) sai: { Xuất ghi: ['THẤT BẠI']. }.
	x := (Lôgic tung-đồng-xu hoặc-là: ['NGỬA'] hay: ['SẤP']).
	((x = ['NGỬA']) hoặc: (x = ['SẤP'])) sai: { Xuất ghi: ['THẤT BẠI']. }.
}.
Xuất ghi: ['XONG'].

