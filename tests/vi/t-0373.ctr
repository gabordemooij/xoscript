# kiểm thử tuân thủ

# dùng số quốc tế

Xuất ghi: ['1000 -> '].
Xuất ghi: 1000, xuống-dòng. #1000

Xuất ghi: ['1.5 -> '].
Xuất ghi: 1.5, xuống-dòng.  #1.5

Xuất ghi: ['1001.5 -> '].
Xuất ghi: 1.5 + 1000, xuống-dòng. #1001.5

# dùng mảng đánh chỉ số từ 0
>> x := Danh-sách mới ; 1 ; 2 ; 3.
>> y := Danh-sách mới ; ['a'] ; ['b'] ; ['c'].

Xuất ghi: ['1 -> '].
Xuất ghi: x ? 0, xuống-dòng. #1

Xuất ghi: ['1 -> '].
Xuất ghi: (x tại: 0), xuống-dòng. #1

Xuất ghi: ['1 -> '].
Xuất ghi: x đầu, xuống-dòng. #1

Xuất ghi: ['3 -> '].
Xuất ghi: x cuối, xuống-dòng. #3

Xuất ghi: ['(Dict new) put:3 at:['c'], put:2 at:['b'], put:1 at:['a'] -> '].
Xuất ghi: (x theo: y), xuống-dòng.

Xuất ghi: ['1 -> '].
Xuất ghi: (x từ: 0 độ-dài: 1) đầu, xuống-dòng. #1

Xuất ghi: ['0 -> '].
Xuất ghi: (x tìm: 1), xuống-dòng. #0

x đặt: 9 tại: 0.

Xuất ghi: ['9 -> '].
Xuất ghi: (x tại: 0), xuống-dòng. #9

x thêm-đầu: 8.
Xuất ghi: ['8 -> '].
Xuất ghi: (x tại: 0), xuống-dòng. #9


x thêm-cuối: 10.
Xuất ghi: ['10 -> '].
Xuất ghi: (x tại: 4), xuống-dòng. #10








