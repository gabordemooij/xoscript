# dấu xuống dòng trong giá trị không được tạo thêm tiêu đề
Server khởi-tạo.
Chương-trình dùng: ['../../../src/xo/vi/webtools.xo'].
Chương-trình dùng: ['../../../src/xo/vi/mailtools.xo'].

>> tiêu-đề := Tiêu-đề-HTTP mới khóa-tiêu-đề: ['Location'] giá-trị: ['/ok\r\nX-Injected: yes'].
Xuất ghi: tiêu-đề.

>> trang-web := Tài-liệu-Web mới.
trang-web đi-đến: ['/ok\r\nX-Injected: yes'].
Xuất ghi: ['\n'], xuống-dòng.

>> thư := Thư-điện-tử mới.
thư đến: (Danh-sách mới ; ['a@example.invalid\r\nX-To: yes']).
thư cc: (Danh-sách mới ; ['b@example.invalid\r\nX-Cc: yes']).
thư bcc: (Danh-sách mới ; ['c@example.invalid\r\nX-Bcc: yes']).
thư người-gửi: ['d@example.invalid\r\nX-From: yes'] tên: ['site\r\nX-Name: yes'].
thư chủ-đề: ['hello\r\nX-Subject: yes'].
thư thân-thư: ['line1\r\nline2'].
Xuất ghi: thư tạo-ra.

>> html := Thư-HTML mới.
html đến: (Danh-sách mới ; ['a@example.invalid\r\nX-To: yes']).
html người-gửi: ['d@example.invalid'] tên: ['site'].
html chủ-đề: ['hello\r\nX-Subject: yes'].
html thân-thư: ['body'].
Xuất ghi: ( html tạo-ra chứa: ['\nX-'] ), xuống-dòng.
Xuất ghi: ( html tạo-ra chứa: ['X-To: yes'] ), xuống-dòng.
