Số khi: ['roman'] làm: {
	>> số := bản-thân sao-chép.
	>> roman := [''].
	{
		{
			(số ≥ 1000) đúng: {
				roman thêm-cuối: ['Ⅿ'].
				số trừ: 1000.
			}, ngắt.
		
			(số ≥ 500) đúng: {
				roman thêm-cuối: ['Ⅾ'].
				số trừ: 500.
			}, ngắt.
		
			(số ≥ 100) đúng: {
				roman thêm-cuối: ['Ⅽ'].
				số trừ: 100.
			}, ngắt.
		
			(số ≥ 50) đúng: {
				roman thêm-cuối: ['Ⅼ'].
				số trừ: 50.
			}, ngắt.
		
			(số ≥ 50) đúng: {
				roman thêm-cuối: ['Ⅼ'].
				số trừ: 50.
			}, ngắt.
		
			(số ≥ 10) đúng: {
				roman thêm-cuối: ['Ⅹ'].
				số trừ: 10.
			}, ngắt.
			
			(số ≥ 9) đúng: {
				roman thêm-cuối: ['Ⅸ'].
				số trừ: 9.
			}, ngắt.
			
			(số ≥ 5) đúng: {
				roman thêm-cuối: ['Ⅴ'].
				số trừ: 5.
			}, ngắt.
			
			(số ≥ 4) đúng: {
				roman thêm-cuối: ['Ⅳ'].
				số trừ: 4.
			}, ngắt.
			
			(số ≥ 1) đúng: {
				roman thêm-cuối: ['Ⅰ'].
				số trừ: 1.
			}, ngắt.
		} thủ-tục.
	} trong-khi: { <- số > 0. }. <- roman.
}.

Xuất ghi: 1 roman, xuống-dòng.
Xuất ghi: 2 roman, xuống-dòng.
Xuất ghi: 4 roman, xuống-dòng.
Xuất ghi: 8 roman, xuống-dòng.
Xuất ghi: 16 roman, xuống-dòng.
Xuất ghi: 32 roman, xuống-dòng.
Xuất ghi: 64 roman, xuống-dòng.
Xuất ghi: 128 roman, xuống-dòng.
Xuất ghi: 256 roman, xuống-dòng.
Xuất ghi: 1024 roman, xuống-dòng.
