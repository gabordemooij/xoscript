Số khi: ['la-mã'] làm: {
	>> số := bản-thân sao-chép.
	>> la-mã := [''].
	{
		{
			(số ≥ 1000) đúng: {
				la-mã thêm-cuối: ['Ⅿ'].
				số trừ: 1000.
			}, ngắt.
		
			(số ≥ 500) đúng: {
				la-mã thêm-cuối: ['Ⅾ'].
				số trừ: 500.
			}, ngắt.
		
			(số ≥ 100) đúng: {
				la-mã thêm-cuối: ['Ⅽ'].
				số trừ: 100.
			}, ngắt.
		
			(số ≥ 50) đúng: {
				la-mã thêm-cuối: ['Ⅼ'].
				số trừ: 50.
			}, ngắt.
		
			(số ≥ 50) đúng: {
				la-mã thêm-cuối: ['Ⅼ'].
				số trừ: 50.
			}, ngắt.
		
			(số ≥ 10) đúng: {
				la-mã thêm-cuối: ['Ⅹ'].
				số trừ: 10.
			}, ngắt.
			
			(số ≥ 9) đúng: {
				la-mã thêm-cuối: ['Ⅸ'].
				số trừ: 9.
			}, ngắt.
			
			(số ≥ 5) đúng: {
				la-mã thêm-cuối: ['Ⅴ'].
				số trừ: 5.
			}, ngắt.
			
			(số ≥ 4) đúng: {
				la-mã thêm-cuối: ['Ⅳ'].
				số trừ: 4.
			}, ngắt.
			
			(số ≥ 1) đúng: {
				la-mã thêm-cuối: ['Ⅰ'].
				số trừ: 1.
			}, ngắt.
		} thủ-tục.
	} trong-khi: { <- số > 0. }. <- la-mã.
}.

Xuất ghi: 1 la-mã, xuống-dòng.
Xuất ghi: 2 la-mã, xuống-dòng.
Xuất ghi: 4 la-mã, xuống-dòng.
Xuất ghi: 8 la-mã, xuống-dòng.
Xuất ghi: 16 la-mã, xuống-dòng.
Xuất ghi: 32 la-mã, xuống-dòng.
Xuất ghi: 64 la-mã, xuống-dòng.
Xuất ghi: 128 la-mã, xuống-dòng.
Xuất ghi: 256 la-mã, xuống-dòng.
Xuất ghi: 1024 la-mã, xuống-dòng.
