>> Animal := Đối-tượng mới.
Animal khi: ['make'] làm: {
	>> animal := Đối-tượng mới.
	animal khi: ['makeSound'] làm: {
		Xuất ghi: riêng sound.
	}. <- animal.
}.
>> Cat := Đối-tượng mới.
Cat khi: ['make'] làm: {
	>> cat := Animal make.
	cat khi: ['init'] làm: {
		riêng sound := ['meow!'].
	}.
	cat init. <- cat.
}.
>> tom := Cat make.
tom makeSound.
