Xuất ghi: ['Test object'], xuống-dòng.
>> a := Đối-tượng mới. 

a khi: ['item:'] làm: { :moment
	riêng moment := moment. 
}.

a khi: ['item'] làm: { <- riêng moment.
}.

>> today := Thời-điểm mới múi-giờ: ['CEST'], năm: 2026, tháng: 7.
a item: today.
Xuất ghi: a item, xuống-dòng.
a save-as: ['/tmp/a.bin'].
Xuất ghi: ['========== RELOADING SNAP:'], xuống-dòng.
>> b := Đối-tượng load-from: ['/tmp/a.bin'].
Xuất ghi: b item, xuống-dòng.
