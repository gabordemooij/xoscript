Xuất ghi: ['Đối tượng thử nghiệm'], xuống-dòng.
>> a := Đối-tượng mới. 

a khi: ['item:'] làm: { :thời-khắc
	riêng thời-khắc := thời-khắc. 
}.

a khi: ['mục'] làm: {
	<- riêng thời-khắc.
}.

>> hôm-nay := Thời-điểm mới múi-giờ: ['CEST'], năm: 2026, tháng: 7.
a item: hôm-nay.
Xuất ghi: a mục, xuống-dòng.
a save-as: ['/tmp/a.bin'].
Xuất ghi: ['========== ĐANG TẢI LẠI SNAP:'], xuống-dòng.
>> b := Đối-tượng load-from: ['/tmp/a.bin'].
Xuất ghi: b mục, xuống-dòng.
