Xuất ghi: ['Đối tượng thử nghiệm'], xuống-dòng.
>> a := Đối-tượng mới. 

a khi: ['item:'] làm: { :thời-khắc
	riêng thời-khắc := thời-khắc. 
}.

a khi: ['mục'] làm: {
	<- riêng thời-khắc.
}.

>> hôm-nay := Danh-sách mới ; ( Thời-điểm mới múi-giờ: ['CEST'], năm: 2026, tháng: 7 ).
a item: hôm-nay.
Xuất ghi: a mục ? 0, xuống-dòng.
a save-as: ['/tmp/a.bin'].
